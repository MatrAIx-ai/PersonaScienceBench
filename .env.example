# Existing OpenRouter configurations
OPENROUTER_API_KEY=

# Azure v1 configurations (deployment names, not OpenRouter model IDs)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/openai/v1/
AZURE_OPENAI_DEPLOYMENT=gpt-5.6-sol
# Optional provenance only; do not use the project URL for chat completions.
AZURE_FOUNDRY_PROJECT_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/api/projects/YOUR-PROJECT
