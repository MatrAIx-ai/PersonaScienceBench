# Provider keys for the evaluation launcher. Fill only the providers you use.
# The README example uses OpenRouter for actor, researcher simulator and judge.
OPENROUTER_API_KEY=

# Optional direct OpenAI API provider.
OPENAI_API_KEY=

# Optional direct xAI API provider (Grok).
XAI_API_KEY=

# Keep real keys in .env or the process environment; never commit credentials.
