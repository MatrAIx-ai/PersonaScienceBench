* text=auto eol=lf

# Preserve exact bytes for experiment CSV manifests and archived results.
Experiment/**/*.csv -text
reports/conversion_v2/superfamily_audit/*.csv -text

# Result receipt hashes refer to exact exported bytes on every platform.
results/** -text
# CSV writers use CRLF; preserve byte hashes without treating CR as trailing space.
*.csv whitespace=cr-at-eol
# Frozen exports and vendored LaTeX sources retain their original formatting.
results/** -whitespace
paper/*.sty -whitespace
# Matplotlib SVG path serialization includes intentional trailing spaces.
*.svg -whitespace
