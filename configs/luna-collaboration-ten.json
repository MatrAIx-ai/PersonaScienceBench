{
  "schema_version": "0.1",
  "models": {
    "actor": {
      "model": "openai/gpt-6-luna",
      "reasoning_effort": "none",
      "max_tokens": 12288
    },
    "researcher": {
      "model": "openai/gpt-6-luna",
      "reasoning_effort": "none",
      "max_tokens": 2048
    },
    "judge": {
      "model": "openai/gpt-6-luna",
      "reasoning_effort": "none",
      "max_tokens": 4096,
      "unsupported_parameters": "omit_and_record"
    }
  },
  "actor_steps": 60,
  "researcher": {
    "mode": "grounded",
    "max_facts_per_reply": 1,
    "max_questions": 6
  },
  "persona": {
    "enabled": false
  },
  "dollar_cap": null,
  "pilot_cases_per_benchmark": 10,
  "notes": [
    "researcher-review-v2: inspect and propose an approach, researcher approval, execute/design, evidence review, revise or finish.",
    "Persona off; all model roles GPT-6 Luna; native graders unchanged.",
    "12 researcher requests and 60 actor calls per case. Approval and result review are required; additional revisions are optional."
  ],
  "actor_python_overrides": {
    "scienceagentbench:verified:87": "external/runtime/actor-netcdf"
  },
  "collaboration": {
    "protocol": "active_researcher",
    "max_requests": 12
  }
}
