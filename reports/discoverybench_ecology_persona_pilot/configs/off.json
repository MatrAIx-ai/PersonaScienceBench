{
  "schema_version": "0.1",
  "models": {
    "actor": {
      "provider": "azure",
      "model": "gpt-5.6-sol",
      "reasoning_effort": "none",
      "max_tokens": 12288,
      "unsupported_parameters": "reject"
    },
    "researcher": {
      "provider": "azure",
      "model": "gpt-5.6-sol",
      "reasoning_effort": "none",
      "max_tokens": 8192,
      "unsupported_parameters": "reject"
    },
    "judge": {
      "provider": "azure",
      "model": "gpt-5.6-sol",
      "reasoning_effort": "none",
      "max_tokens": 4096,
      "unsupported_parameters": "reject"
    }
  },
  "actor_steps": 60,
  "researcher": {
    "mode": "grounded",
    "max_facts_per_reply": 1,
    "max_questions": 6
  },
  "persona": {
    "enabled": false
  },
  "dollar_cap": null,
  "pilot_cases_per_benchmark": 1,
  "notes": [
    "DiscoveryBench task validation using the shared actor, researcher and native grading path.",
    "GPT-5.6 Sol with reasoning_effort=none, matching the tested Azure function-call configuration.",
    "Native judge sampling parameters are preserved; no model fallback or automatic retries."
  ],
  "collaboration": {
    "protocol": "active_researcher",
    "max_requests": 12
  }
}
