"""
asibench:astronomy.planet_activity_sep
Recover latent summary (signal_summary.csv) and predict future component-A-only
values (target_predictions.csv) from the primary channel obs_0.

Model per case (reference_epoch_day = 0.0 in input_0.json, so fitted
coefficients ARE the *_u0 basis at the reference epoch):
    obs_0(t) = offset_u0
        + a1*sin(2*pi*t/P_A) + a2*cos(2*pi*t/P_A)                   (A)
        + b1*sin(2*pi*t/P_B) + b2*cos(2*pi*t/P_B)                   (B fundamental)
        + b3*sin(4*pi*t/P_B) + b4*cos(4*pi*t/P_B)                   (B first harmonic)
        + noise(sigma=obs_0_err)

Method:
  1. Coarse 2D (P_A, P_B) grid scan with a per-pair linear least-squares solve
     for the coefficients+offset, collecting competitive basins.
  2. Nelder-Mead refinement (nonlinear in the two periods) of each basin.
  3. Semantic rule: the background is the harmonic-bearing component whose
     FUNDAMENTAL dominates (Bf >= Bh) and whose harmonic is non-negligible
     (Bh/Bf >= 0.1). This rejects (a) the harmonic-carrying relabeling with a
     near-zero fundamental, and (b) essentially harmonic-free decompositions.
     Among passing candidates the lowest reduced chi^2 wins. A is the pure
     sinusoid. Cross-case check: background fundamentals live at ~20-27 d with
     real amplitude (cases 001/002/003), consistent with the chosen case_000 fit.
  4. A presence: F-test + BIC + reduced chi2 vs reported sigma (threshold
     p<0.005 AND dchi2>20). case_002 is judged absent; its B summary uses the
     B-only fit (offset + fundamental + harmonic).
  5. Predict A-only values at input_2 target times.
"""

import json
import numpy as np
import pandas as pd
from scipy.optimize import minimize
from scipy.stats import f as f_dist

INPUT0 = "data/input_0.json"
INPUT1 = "data/input_1.csv"
INPUT2 = "data/input_2.csv"
OUT_SUMMARY = "signal_summary.csv"
OUT_TARGET = "target_predictions.csv"

with open(INPUT0, "r") as fh:
    meta = json.load(fh)
case_order = meta["case_order"]
T_REF = float(meta["reference_epoch_day"])

obs = pd.read_csv(INPUT1)
targets = pd.read_csv(INPUT2)


def design(t, PA, PB, withA=True):
    wB = 2.0 * np.pi / PB
    wA = (2.0 * np.pi / PA) if withA else 0.0
    cols = [np.ones_like(t)]
    if withA:
        cols += [np.sin(wA * t), np.cos(wA * t)]
    cols += [np.sin(wB * t), np.cos(wB * t),
             np.sin(2.0 * wB * t), np.cos(2.0 * wB * t)]
    return np.column_stack(cols)


def linfit(t, y, PA, PB, withA=True):
    X = design(t, PA, PB, withA)
    coef, res, *_ = np.linalg.lstsq(X, y, rcond=None)
    return X, coef, (res[0] if len(res) else 1e30)


def refine_basin(t, y, s0, plo=5.5, phi=64.0):
    def nll(p):
        PA, PB = float(p[0]), float(p[1])
        if not (plo <= PA <= phi and plo <= PB <= phi):
            return 1e30
        if abs(1.0 / PA - 1.0 / PB) < 0.004:
            return 1e30
        return linfit(t, y, PA, PB, True)[2]
    r = minimize(nll, s0, method="Nelder-Mead",
                 options={"xatol": 1e-7, "fatol": 1e-11, "maxiter": 15000})
    X, coef, ss = linfit(t, y, r.x[0], r.x[1], True)
    return r.x[0], r.x[1], coef, ss


def solve_obs0(t, y, sig, extra_basins):
    n = len(t)
    fa = np.linspace(1.0 / 60.0, 1.0 / 6.0, 320)
    best = (1e30, (13.0, 26.0))
    for a in fa:
        for b in fa:
            if abs(a - b) < 0.008:
                continue
            _, _, ss = linfit(t, y, 1.0 / a, 1.0 / b)
            if ss < best[0]:
                best = (ss, (1.0 / a, 1.0 / b))
    cands = []
    for s0 in [best[1]] + extra_basins:
        try:
            PA, PB, coef, ss = refine_basin(t, y, s0)
        except Exception:
            continue
        chi = np.sum(((y - design(t, PA, PB) @ coef) / sig) ** 2)
        cands.append(dict(PA=PA, PB=PB, coef=coef, ss=ss, chi=chi,
                          rms=np.sqrt(ss / n), redchi=chi / (n - 9),
                          Aamp=np.hypot(coef[1], coef[2]),
                          Bf=np.hypot(coef[3], coef[4]),
                          Bh=np.hypot(coef[5], coef[6]),
                          off=coef[0]))
    uniq = []
    for c in sorted(cands, key=lambda x: x["chi"]):
        if all(abs(c["PA"] - u["PA"]) > 0.5 or abs(c["PB"] - u["PB"]) > 0.5
               for u in uniq):
            uniq.append(c)
    return uniq


def fit_b_only(t, y, sig):
    """Optimized 4-parameter background-only fit (offset+fund+harmonic)."""
    def nll(PB):
        if not (18.0 <= PB <= 30.0):
            return 1e30
        return linfit(t, y, None, PB, withA=False)[2]
    r = minimize(nll, 26.0, method="Nelder-Mead",
                 options={"xatol": 1e-7, "fatol": 1e-11, "maxiter": 8000})
    X, coef, ss = linfit(t, y, None, r.x[0], withA=False)
    chi = np.sum(((y - X @ coef) / sig) ** 2)
    return r.x[0], coef, chi, ss


summary_rows = []
target_rows = []
diagnostics = {}

for cid in case_order:
    sub = obs[obs["case_id"] == cid].sort_values("time_day")
    t = sub["time_day"].values.astype(float)
    y = sub["obs_0"].values.astype(float)
    sig = sub["obs_0_err"].values.astype(float)
    n = len(t)

    extra = [(13.0, 26.0), (12.4, 25.8), (10.5, 20.4), (7.5, 26.0),
             (24.0, 26.4), (13.3, 52.0), (26.0, 13.0), (14.0, 26.0),
             (12.9, 51.7), (10.5, 40.0), (20.0, 10.2), (13.0, 40.0)]
    cands = solve_obs0(t, y, sig, extra)

    # semantic rule: background fundamental dominates and harmonic non-negligible
    def semantic_ok(c):
        m = max(c["Bf"], 1e-9)
        return (c["Bf"] >= c["Bh"]) and (c["Bh"] / m >= 0.1)

    chosen = next((c for c in cands if semantic_ok(c)), cands[0])
    PA, PB = chosen["PA"], chosen["PB"]
    off, a1, a2, b1, b2, b3, b4 = chosen["coef"]

    # ---- A-presence test ----
    _, coefB, ssB = linfit(t, y, None, PB, withA=False)
    chiB = np.sum(((y - design(t, None, PB, withA=False) @ coefB) / sig) ** 2)
    chiF = chosen["chi"]
    Fstat = ((chiB - chiF) / 3.0) / (chiF / max(n - 7, 1))
    pval = 1.0 - f_dist.cdf(Fstat, 3, max(n - 7, 1))
    bicB = n * np.log(chiB / n) + 4 * np.log(n)
    bicF = n * np.log(chiF / n) + 9 * np.log(n)
    present = int(pval < 0.005 and (chiB - chiF) > 20.0)

    diagnostics[cid] = dict(PA=PA, PB=PB, redchi_full=chosen["redchi"],
                            redchi_bonly=chiB / (n - 4), F=Fstat, p=pval,
                            BIC_B=bicB, BIC_F=bicF, present=present)

    if present == 1:
        PB_out, bcoef, chiBout, ssBout = PB, [off, b1, b2, b3, b4], chiF, chosen["ss"]
        a1_out, a2_out, PA_out = a1, a2, PA
    else:
        # A absent: refit B-only cleanly, force A = 0
        PB_out, bcoef, chiBout, ssBout = fit_b_only(t, y, sig)
        off, b1, b2, b3, b4 = bcoef
        PA_out, a1_out, a2_out = 0.0, 0.0, 0.0

    summary_rows.append(dict(
        case_id=cid, component_a_present=present,
        component_a_period_day=PA_out, component_a_basis1_u0=a1_out,
        component_a_basis2_u0=a2_out, component_b_period_day=PB_out,
        component_b_basis1_u0=b1, component_b_basis2_u0=b2,
        component_b_basis3_u0=b3, component_b_basis4_u0=b4,
        offset_u0=off))

    print(f"[{cid}] present={present} PA={PA_out:.4f} PB={PB_out:.4f} "
          f"redchi2(full)={chosen['redchi']:.2f} F={Fstat:.1f} p={pval:.2e}")

# ---- targets in exact input_2 row order ----
A_params = {r["case_id"]: r for r in summary_rows}
for _, row in targets.iterrows():
    cid = row["case_id"]
    tt = float(row["time_day"])
    r = A_params[cid]
    if r["component_a_present"] == 1:
        wA = 2.0 * np.pi / r["component_a_period_day"]
        aval = (r["component_a_basis1_u0"] * np.sin(wA * (tt - T_REF))
                + r["component_a_basis2_u0"] * np.cos(wA * (tt - T_REF)))
    else:
        aval = 0.0
    target_rows.append(dict(case_id=cid, time_day=tt,
                            component_a_value_u0=float(aval)))

df_summary = pd.DataFrame(summary_rows, columns=[
    "case_id", "component_a_present", "component_a_period_day",
    "component_a_basis1_u0", "component_a_basis2_u0",
    "component_b_period_day", "component_b_basis1_u0", "component_b_basis2_u0",
    "component_b_basis3_u0", "component_b_basis4_u0", "offset_u0"])
df_summary.to_csv(OUT_SUMMARY, index=False)

df_target = pd.DataFrame(target_rows, columns=[
    "case_id", "time_day", "component_a_value_u0"])
df_target.to_csv(OUT_TARGET, index=False)

print("\ndone. signal_summary rows:", len(df_summary),
      " target rows:", len(df_target))
print("\n--- signal_summary.csv ---")
print(pd.read_csv(OUT_SUMMARY).to_string(index=False))
print("\n--- target_predictions.csv (first 14 rows) ---")
print(df_target.head(14).to_string(index=False))
print("\nDiagnostics:")
for cid, d in diagnostics.items():
    print(f"  {cid}: PA={d['PA']:.4f} PB={d['PB']:.4f} redchi2_full={d['redchi_full']:.2f} "
          f"redchi2_Bonly={d['redchi_bonly']:.2f} F={d['F']:.1f} p={d['p']:.2e} "
          f"BIC_B={d['BIC_B']:.1f} BIC_F={d['BIC_F']:.1f} present={d['present']}")
