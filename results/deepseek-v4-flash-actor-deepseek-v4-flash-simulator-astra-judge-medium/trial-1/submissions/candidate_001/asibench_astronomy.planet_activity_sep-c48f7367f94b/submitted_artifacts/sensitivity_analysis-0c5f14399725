import pandas as pd, numpy as np
from scipy.optimize import minimize
from scipy.signal import lombscargle
df1 = pd.read_csv('data/input_1.csv')

def design(t0, PA, PB, withA=True):
    wB=2*np.pi/PB; wA=(2*np.pi/PA) if withA else 0.0
    cols=[np.ones(len(t0))]
    if withA: cols += [np.sin(wA*t0),np.cos(wA*t0)]
    cols += [np.sin(wB*t0),np.cos(wB*t0),np.sin(2*wB*t0),np.cos(2*wB*t0)]
    return np.column_stack(cols)
def linfit(t0,y0,PA,PB,withA=True):
    X=design(t0,PA,PB,withA); c,r,*_=np.linalg.lstsq(X,y0,rcond=None)
    return X,c,r[0]
def refine(t0,y0,s0):
    def nll(p):
        PA,PB=p
        if not (9<=PA<=32 and 20<=PB<=60) or abs(1/PA-1/PB)<0.004: return 1e30
        return linfit(t0,y0,PA,PB,True)[2]
    r=minimize(nll,s0,method='Nelder-Mead',options={'xatol':1e-7,'fatol':1e-10,'maxiter':12000})
    X,c,ss=linfit(t0,y0,r.x[0],r.x[1],True)
    return r.x[0],r.x[1],c,ss

sub=df1[df1['case_id']=='case_000'].sort_values('time_day')
t=sub['time_day'].values; y=sub['obs_0'].values; sig=sub['obs_0_err'].values; n=len(t)
t2=pd.read_csv('data/input_2.csv'); tgt=t2[t2['case_id']=='case_000']['time_day'].values

print("=== case_000 sensitivity table (obs_0) ===")
print(f"{'rep':38s} {'PA':>9s} {'PB':>9s} {'rms':>6s} {'redchi2':>8s} {'Aamp':>6s} {'Bf':>6s} {'Bh':>6s} {'lag1_ac':>7s} {'maxpg':>6s}")
for s0,lab in [((13.29,26.0),'A~13.3 / B~26  (fund+harm) [CHOSEN]'),
               ((13.25,52.0),'A~13.3 / B~52  (harmonic at 26)'),
               ((24.0,26.4),'A~24 / B~26.4'),
               ((26.0,13.24),'A~26 / B~13.2 (reversed)')]:
    PA,PB,c,ss=refine(t,y,s0)
    chi=np.sum(((y-design(t,PA,PB)@c)/sig)**2)
    res=y-design(t,PA,PB)@c
    ac=np.corrcoef(res[:-1],res[1:])[0,1]
    fr=np.linspace(1/60,1/4,8000); pr=lombscargle(t,res,2*np.pi*fr)
    print(f"{lab:38s} {PA:9.3f} {PB:9.3f} {np.sqrt(ss/n):6.3f} {chi/(n-9):8.2f} "
          f"{np.hypot(c[1],c[2]):6.2f} {np.hypot(c[3],c[4]):6.2f} {np.hypot(c[5],c[6]):6.2f} "
          f"{ac:7.3f} {pr.max():6.1f}")

# chosen rep details
PA,PB,c,ss=refine(t,y,(13.29,26.0))
res=y-design(t,PA,PB)@c
print("\nCHOSEN (A~13.3/B~26): PA=%.4f PB=%.4f redchi2=%.2f" % (PA,PB,np.sum(((y-design(t,PA,PB)@c)/sig)**2)/(n-9)))
print("  coefficients: off=%.4f A(s,c)=(%.4f,%.4f) Bf(s,c)=(%.4f,%.4f) Bh(s,c)=(%.4f,%.4f)"
      % (c[0],c[1],c[2],c[3],c[4],c[5],c[6]))
print("  residual: rms=%.3f lag1_autocorr=%.3f max periodogram power=%.1f  (no significant leftover line)" % (np.sqrt(ss/n),ac,pr.max()))
print("  A-only future predictions at case_000 target times:")
for tt,av in zip(tgt, np.array([c[1]*np.sin(2*np.pi*tt/PA)+c[2]*np.cos(2*np.pi*tt/PA) for tt in tgt])):
    print(f"    t={tt:.0f}: {av:.4f}")
