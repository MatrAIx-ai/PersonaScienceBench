{
  "preprocessing": {
    "method": "library-size normalization (counts / lib_size * median_depth) then log1p",
    "rationale": "Inspection (integer, 19% non-zero, depth spread 901..3992, 4.4x) confirms raw counts, so per-cell depth must be removed before PCA/DE/GRN. Scaling to median depth keeps expression comparable across cells; log1p stabilizes variance of sparse counts.",
    "params": {
      "target_depth": "median library size"
    }
  },
  "clustering": {
    "method": "spectral clustering (Shi-Malik) on a kNN affinity graph built from the PCA embedding",
    "rationale": "Graph partitioning is the standard single-cell paradigm (Louvain/Leiden); without those toolkits, normalized spectral clustering is the numpy/scipy equivalent. k = n_clusters is resolved from metadata (n_clusters=4), removing resolution ambiguity. k-means on PCA-normalized eigenvectors then assigns cells.",
    "params": {
      "n_clusters": 4,
      "n_pcs": 20,
      "knn_k": 15,
      "kernel": "Gaussian (sigma=median kNN distance)",
      "seed": 0
    }
  },
  "pseudotime": {
    "method": "weighted shortest-path (Dijkstra) on the same kNN graph from an extremal-cell root, normalized to [0,1]",
    "rationale": "Edge weights are Euclidean distances in PCA space, so the shortest path is a geodesic approximation along the manifold. Root = cell with maximum geodesic distance from the graph center (node minimizing total distance to all cells), a deterministic heuristic. ORIENTATION IS A CONVENTION, not biological ground truth.",
    "params": {
      "graph": "kNN k=15 (+MST if disconnected)",
      "root_rule": "farthest from geodesic center"
    }
  },
  "de_genes": {
    "method": "per-gene maximum over clusters of the one-vs-rest Welch t-statistic on log1p data",
    "rationale": "Each gene is scored by the strongest single-cluster separation from the rest (difference of means scaled by Welch variance), a standard DE statistic. All 250 gene indices are returned ranked best-first (no truncation/placeholder).",
    "params": {
      "statistic": "Welch t (equal_var=False)",
      "ranking": "descending max-over-cluster |t|"
    }
  },
  "grn": {
    "method": "standardized ridge regression between TF genes on z-scored log1p-normalized TF expression",
    "rationale": "For each target j, regress its z-scored expression on the other 19 z-scored regulator genes: grn_scores[i,j] = standardized ridge beta of regulator i for target j, giving directed i->j scores per the required convention (positive = putatively activating, negative = repressive). Self-edges excluded by construction; diagonal hard-zeroed.",
    "params": {
      "ridge_lambda": 1.0,
      "features": "z-scored log1p TF columns",
      "direction": "regulator i (predictor) -> target j (response)"
    }
  },
  "assumptions": [
    "counts are raw-like; library-size + log1p normalization is applied",
    "n_clusters=4 comes from system_info.json (metadata, not estimated)",
    "first n_tf_genes=20 columns are TF genes (from tf_gene_indices)",
    "pseudotime root/orientation is a convention (extremal-cell heuristic)",
    "n_pcs chosen by >=90% explained variance (clipped to [5,20]); knn_k=15",
    "de_genes returns the full ranked list of all gene indices",
    "GRN direction derives from the ridge-regression convention; diagonal ignored"
  ]
}