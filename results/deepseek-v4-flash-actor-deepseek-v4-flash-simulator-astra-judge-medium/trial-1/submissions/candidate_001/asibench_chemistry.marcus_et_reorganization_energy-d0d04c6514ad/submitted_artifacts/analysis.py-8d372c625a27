#!/usr/bin/env python3
"""
analysis.py - solution-phase Marcus electron-transfer response calculation.

Reads bundled inputs in data/ and writes all required outputs to results/.

Pipeline: (1) reorder each frame's coords/Hessians to ascending site_id
(site-major x/y/z -> common 21-vector order); (2) Kabsch rigid alignment,
forward = frame B in frame A, backward = frame A in frame B, signed
displacement = aligned source MINUS reference target; (3) mass-weighted
aligned/projected displacements + mass-weighted vibrational basis (15 positive
modes/frame, ascending frequency); (4) magnitude-based cross-frame mode overlap
and transported-mode profiles; (5) per-mode projection (signed modal coord,
per-mode lambda, fraction); (6) inner lambda (4-point + normal-mode), two-sphere
outer lambda, Marcus rates in log space, rate curve on the preserved grid;
(7) diagnostics + overview figure.
"""
import csv
import json
import os

import numpy as np
try:
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt
    HAS_MPL = True
except Exception:
    HAS_MPL = False
    import vizkit

DATA = "data"
OUT = "results"
os.makedirs(OUT, exist_ok=True)

# ---- 1. parse + site ordering ----------------------------------------------
site_rows = list(csv.DictReader(open(os.path.join(DATA, "site_table.csv"))))
mass = np.array([float(r["mass_amu"]) for r in site_rows], dtype=float)   # 7
n_site = len(mass)
label = {int(r["site_id"]): r["label_code"] for r in site_rows}
M = np.repeat(mass, 3)                                                      # 21

order_rows = list(csv.DictReader(open(os.path.join(DATA, "frame_site_order.csv"))))

def site_order(frame):
    d = {int(r["row_index"]): int(r["site_id"]) for r in order_rows if r["frame_id"] == frame}
    return np.array([d[i] for i in range(n_site)])

def reorder_hessian(H0, idx):
    p = np.array([3 * idx[i] + k for i in range(n_site) for k in range(3)])
    return H0[np.ix_(p, p)]

A_raw = np.load(os.path.join(DATA, "frame_a_coords.npy"))
B_raw = np.load(os.path.join(DATA, "frame_b_coords.npy"))
Ha0 = np.load(os.path.join(DATA, "frame_a_hessian.npy"))
Hb0 = np.load(os.path.join(DATA, "frame_b_hessian.npy"))
idx_a = site_order("frame_a")
idx_b = site_order("frame_b")

A = A_raw[idx_a]
B = B_raw[idx_b]
Ha = reorder_hessian(Ha0, idx_a)
Hb = reorder_hessian(Hb0, idx_b)

manifest = json.load(open(os.path.join(DATA, "system_manifest.json")))
medium = json.load(open(os.path.join(DATA, "medium_response.json")))
grid_rows = list(csv.DictReader(open(os.path.join(DATA, "driving_force_grid.csv"))))

# ---- 2. Kabsch alignment + signed displacements ----------------------------
def kabsch(P, Q):
    Pc = P - P.mean(axis=0)
    Qc = Q - Q.mean(axis=0)
    H = Pc.T @ Qc
    U, _, Vt = np.linalg.svd(H)
    sgn = np.sign(np.linalg.det(Vt.T @ U.T))
    return Vt.T @ np.diag([1.0, 1.0, sgn]) @ U.T

R_BA = kabsch(A, B)      # rotates frame B into frame A (forward)
R_AB = R_BA.T            # rotates frame A into frame B (backward)

B_in_A = (B - B.mean(axis=0)) @ R_BA.T + A.mean(axis=0)
A_in_B = (A - A.mean(axis=0)) @ R_AB.T + B.mean(axis=0)

rmsd_f = float(np.sqrt(np.mean(np.sum((B_in_A - A) ** 2, axis=1))))
rmsd_b = float(np.sqrt(np.mean(np.sum((A_in_B - B) ** 2, axis=1))))

d_f = (B_in_A - A).reshape(-1)
d_b = (A_in_B - B).reshape(-1)
d_f_mw = d_f * np.sqrt(M)
d_b_mw = d_b * np.sqrt(M)
aligned_displacement_mw = np.stack([d_f_mw, d_b_mw])                       # (2,21)

# ---- 3. vibrational basis + projected displacements ------------------------
def internal_modes(H):
    Minv = np.diag(1.0 / np.sqrt(M))
    Hmw = Minv @ ((H + H.T) / 2.0) @ Minv
    eig, vec = np.linalg.eigh(Hmw)
    nz = eig > 1e-6
    o = np.argsort(eig[nz])
    return vec[:, nz][:, o].copy(), np.sort(eig[nz]).copy()

wA, eA = internal_modes(Ha)    # (21,15) / (15,) eV/A^2/amu, ascending
wB, eB = internal_modes(Hb)
vibrational_basis_mw = np.stack([wA, wB])                                  # (2,21,15)

p_f_mw = (wA @ wA.T) @ d_f_mw    # internal part, forward (A modes)
p_b_mw = (wB @ wB.T) @ d_b_mw    # internal part, backward (B modes)
projected_displacement_mw = np.stack([p_f_mw, p_b_mw])                     # (2,21)

rigid_norm_f = float(np.linalg.norm(d_f_mw))
rigid_norm_b = float(np.linalg.norm(d_b_mw))
projected_norm_f = float(np.linalg.norm(p_f_mw))
projected_norm_b = float(np.linalg.norm(p_b_mw))

# ---- 4. cross-frame magnitudes ---------------------------------------------
def block_rotate(R):
    return np.kron(np.eye(n_site), R)

wB_in_A = block_rotate(R_BA) @ wB
wA_in_B = block_rotate(R_AB) @ wA

ov_f = np.abs(wA.T @ wB_in_A)   # ref A rows, transported B cols
ov_b = np.abs(wB.T @ wA_in_B)
mode_overlap = np.stack([ov_f, ov_b])                                      # (2,15,15)

tr_f = np.stack([np.abs(wB_in_A.T @ d_f_mw), ov_f.max(axis=0)], axis=1)
tr_b = np.stack([np.abs(wA_in_B.T @ d_b_mw), ov_b.max(axis=0)], axis=1)
transported_mode_projection = np.stack([tr_f, tr_b])                       # (2,15,2)

# ---- 5. per-mode projection (reference modes, signed) ----------------------
q_f = wA.T @ d_f_mw
q_b = wB.T @ d_b_mw
lam_i_f = 0.5 * eA * q_f ** 2
lam_i_b = 0.5 * eB * q_b ** 2
mode_projection = np.stack([
    np.stack([q_f, lam_i_f, lam_i_f / lam_i_f.sum()], axis=1),
    np.stack([q_b, lam_i_b, lam_i_b / lam_i_b.sum()], axis=1)])            # (2,15,3)

# ---- 6. reorganization energies + Marcus rates -----------------------------
lam_4pt_f = 0.5 * float(d_f @ Ha @ d_f)
lam_4pt_b = 0.5 * float(d_b @ Hb @ d_b)
lam_nm_f = float(lam_i_f.sum())
lam_nm_b = float(lam_i_b.sum())
lam_inner_eff = 0.5 * (lam_nm_f + lam_nm_b)

EC = 14.3996                                     # e^2/(4pi eps0) eV*Angstrom
pekar = 1.0 / medium["eps_fast"] - 1.0 / medium["eps_slow"]
a1, a2, Rspan = medium["shell_0_A"], medium["shell_1_A"], medium["span_A"]
lam_outer = EC * pekar * (1.0 / (2.0 * a1) + 1.0 / (2.0 * a2) - 1.0 / Rspan)
lam_total = lam_inner_eff + lam_outer

KT = medium["temp_K"] * 8.617333262e-5
HBAR = 6.582119569e-16
Vc = medium["coupling_eV"]
ln_pre = float(np.log(2.0 * np.pi / HBAR) + 2.0 * np.log(Vc)
               - 0.5 * np.log(4.0 * np.pi * lam_total * KT))

def ln_rate(dg):
    return ln_pre - (dg + lam_total) ** 2 / (4.0 * lam_total * KT)

k_self = float(np.exp(ln_rate(0.0)))
log10k_self = ln_rate(0.0) / np.log(10.0)

with open(os.path.join(OUT, "lambda_summary.csv"), "w", newline="") as fh:
    w = csv.DictWriter(fh, fieldnames=[
        "lambda_4pt_forward_eV", "lambda_4pt_backward_eV",
        "lambda_nm_forward_eV", "lambda_nm_backward_eV",
        "lambda_inner_effective_eV", "lambda_outer_eV", "lambda_total_eV",
        "k_self_exchange_s_inv"])
    w.writeheader()
    w.writerow({"lambda_4pt_forward_eV": lam_4pt_f, "lambda_4pt_backward_eV": lam_4pt_b,
                "lambda_nm_forward_eV": lam_nm_f, "lambda_nm_backward_eV": lam_nm_b,
                "lambda_inner_effective_eV": lam_inner_eff, "lambda_outer_eV": lam_outer,
                "lambda_total_eV": lam_total, "k_self_exchange_s_inv": k_self})

# ---- 7. rate curve on preserved grid ---------------------------------------
grid_ids = [int(r["grid_id"]) for r in grid_rows]
grid_axis_str = [r["axis_eV"] for r in grid_rows]
grid_axis = [float(r["axis_eV"]) for r in grid_rows]
lnk = [ln_rate(g) for g in grid_axis]
log10k = [l / np.log(10.0) for l in lnk]
k_et = [float(np.exp(l)) for l in lnk]

with open(os.path.join(OUT, "rate_curve.csv"), "w", newline="") as fh:
    w = csv.DictWriter(fh, fieldnames=["grid_id", "axis_eV", "k_et_s_inv", "log10_k_et_s_inv"])
    w.writeheader()
    for gid, axs, k, l10 in zip(grid_ids, grid_axis_str, k_et, log10k):
        w.writerow({"grid_id": gid, "axis_eV": axs, "k_et_s_inv": k, "log10_k_et_s_inv": l10})

# ---- 8. diagnostics ---------------------------------------------------------
closure_f = abs(lam_4pt_f - lam_nm_f)
closure_b = abs(lam_4pt_b - lam_nm_b)
dominant_f = int(np.argmax(lam_i_f))
dominant_b = int(np.argmax(lam_i_b))
peak_idx = int(np.argmax(lnk))
peak_grid_id = grid_ids[peak_idx]
peak_axis = grid_axis[peak_idx]
peak_k = float(np.exp(lnk[peak_idx]))

order_ax = np.argsort(np.array(grid_axis))
sorted_axes = np.array(grid_axis)[order_ax]
sorted_lnk = np.array(lnk)[order_ax]
sorted_ids = np.array(grid_ids)[order_ax]
sp = int(np.argmax(sorted_lnk))
detected = 0 < sp < len(sorted_axes) - 1
if detected:
    first_inv_id = int(sorted_ids[sp + 1])
    first_inv_ax = float(sorted_axes[sp + 1])
else:
    first_inv_id = None
    first_inv_ax = None

diagnostics = {"alignment_rmsd_forward_A": rmsd_f, "alignment_rmsd_backward_A": rmsd_b,
               "closure_error_forward_eV": closure_f, "closure_error_backward_eV": closure_b,
               "effective_inner_consistency_eV": max(closure_f, closure_b),
               "rigid_norm_forward": rigid_norm_f, "rigid_norm_backward": rigid_norm_b,
               "projected_norm_forward": projected_norm_f, "projected_norm_backward": projected_norm_b,
               "dominant_mode_forward": dominant_f, "dominant_mode_backward": dominant_b,
               "rate_peak_grid_id": peak_grid_id, "rate_peak_axis_eV": peak_axis,
               "rate_peak_s_inv": peak_k, "inverted_region_detected": detected,
               "first_inverted_grid_id": first_inv_id, "first_inverted_axis_eV": first_inv_ax}
with open(os.path.join(OUT, "diagnostics.json"), "w") as fh:
    json.dump(diagnostics, fh, indent=2)

np.save(os.path.join(OUT, "aligned_displacement_mw.npy"), aligned_displacement_mw)
np.save(os.path.join(OUT, "vibrational_basis_mw.npy"), vibrational_basis_mw)
np.save(os.path.join(OUT, "mode_overlap.npy"), mode_overlap)
np.save(os.path.join(OUT, "projected_displacement_mw.npy"), projected_displacement_mw)
np.save(os.path.join(OUT, "transported_mode_projection.npy"), transported_mode_projection)
np.save(os.path.join(OUT, "mode_projection.npy"), mode_projection)


# ---- 8b. save binary artifacts -------------------------------------------------
# ---- 9. overview figure -------------------------------------------------
if HAS_MPL:
    plt.style.use("ggplot")
    fig = plt.figure(figsize=(17, 9))
    gs = fig.add_gridspec(2, 3, hspace=0.45, wspace=0.30)

    ax = fig.add_subplot(gs[0, 0], projection="3d")
    ax.scatter(A[:, 0], A[:, 1], A[:, 2], color="tab:blue", marker="o", s=60, label="frame A")
    ax.scatter(B_in_A[:, 0], B_in_A[:, 1], B_in_A[:, 2], color="tab:red", marker="x", s=60, label="frame B in A")
    for i in range(n_site):
        ax.text(A[i, 0], A[i, 1], A[i, 2], f"{label[i]}", size=7, color="k")
    ax.set_title(f"Aligned frames (RMSD={rmsd_f:.3f} A)")
    ax.set_xlabel("x (A)"); ax.set_ylabel("y (A)"); ax.set_zlabel("z (A)")
    ax.legend(fontsize=7, loc="upper left")

    ax = fig.add_subplot(gs[0, 1])
    im = ax.imshow(ov_f, cmap="viridis", aspect="auto")
    ax.set_title("Mode overlap |(W_A)^T (W_B in A)|")
    ax.set_xlabel("source mode (B, transported)"); ax.set_ylabel("reference mode (A)")
    fig.colorbar(im, ax=ax, fraction=0.046)

    ax = fig.add_subplot(gs[0, 2])
    x = np.arange(15)
    ax.bar(x - 0.2, lam_i_f, 0.4, label="forward (A modes)", color="tab:blue")
    ax.bar(x + 0.2, lam_i_b, 0.4, label="backward (B modes)", color="tab:red")
    ax.set_title("Per-mode inner lambda (eV)")
    ax.set_xlabel("retained mode (asc. freq)"); ax.set_ylabel("lambda (eV)")
    ax.legend(fontsize=8)

    ax = fig.add_subplot(gs[1, 0])
    ps_f = np.linalg.norm(p_f_mw.reshape(7, 3), axis=1)
    ps_b = np.linalg.norm(p_b_mw.reshape(7, 3), axis=1)
    ax.bar(x - 0.2, ps_f, 0.4, label="forward", color="tab:blue")
    ax.bar(x + 0.2, ps_b, 0.4, label="backward", color="tab:red")
    ax.set_xticks(x); ax.set_xticklabels([label[i] for i in range(7)], rotation=45, fontsize=7)
    ax.set_title("Projected mw displacement per site (A*sqrt(amu))")
    ax.legend(fontsize=8)

    ax = fig.add_subplot(gs[1, 1])
    ax.plot(grid_axis, log10k, "o-", ms=4, color="tab:green")
    ax.axvline(peak_axis, color="k", ls="--", lw=1)
    ax.plot(peak_axis, log10k[peak_idx], "r*", ms=14, label=f"peak (axis={peak_axis:.3f} eV)")
    ax.set_xlabel("driving force dG (eV)"); ax.set_ylabel("log10 k_et (s^-1)")
    ax.set_title("Marcus rate curve on preserved grid")
    ax.legend(fontsize=8)

    ax = fig.add_subplot(gs[1, 2])
    xx = np.linspace(-0.15, 1.15, 300)
    ax.plot(xx, lam_total * xx ** 2, label=f"state A (lambda={lam_total:.2f} eV)")
    ax.plot(xx, lam_total * (1 - xx) ** 2, label="state B (dG=0)")
    ax.set_title("Marcus parabolas (lambda_total)")
    ax.set_xlabel("reaction coordinate"); ax.set_ylabel("energy (eV)")
    ax.legend(fontsize=7)

    fig.suptitle(f"Marcus ET reorganization - {manifest['case_id']} "
                 f"(inner={lam_inner_eff:.2f} eV, outer={lam_outer:.3f} eV)", fontsize=12)
    fig.savefig(os.path.join(OUT, "overview.png"), dpi=140, bbox_inches="tight")
    plt.close(fig)

else:
    vizkit.make_overview_vizkit(
        os.path.join(OUT, "overview.png"), A, B_in_A, [label[i] for i in range(n_site)],
        rmsd_f, ov_f, lam_i_f, lam_i_b, p_f_mw, p_b_mw, grid_axis, log10k,
        peak_axis, peak_idx, lam_total, manifest["case_id"], lam_inner_eff, lam_outer)

# ---- 10. contract self-checks ----------------------------------------------
def check(cond, msg):
    if not cond:
        raise RuntimeError("CONTRACT CHECK FAILED: " + msg)
    print("ok:", msg)

check(aligned_displacement_mw.shape == (2, 21), "aligned_displacement_mw (2,21)")
check(vibrational_basis_mw.shape == (2, 21, 15), "vibrational_basis_mw (2,21,15)")
check(mode_overlap.shape == (2, 15, 15), "mode_overlap (2,15,15)")
check(projected_displacement_mw.shape == (2, 21), "projected_displacement_mw (2,21)")
check(transported_mode_projection.shape == (2, 15, 2), "transported_mode_projection (2,15,2)")
check(mode_projection.shape == (2, 15, 3), "mode_projection (2,15,3)")

lcols = ["lambda_4pt_forward_eV", "lambda_4pt_backward_eV", "lambda_nm_forward_eV",
         "lambda_nm_backward_eV", "lambda_inner_effective_eV", "lambda_outer_eV",
         "lambda_total_eV", "k_self_exchange_s_inv"]
with open(os.path.join(OUT, "lambda_summary.csv")) as fh:
    check(csv.DictReader(fh).fieldnames == lcols, "lambda_summary columns")
with open(os.path.join(OUT, "rate_curve.csv")) as fh:
    rr = list(csv.DictReader(fh))
    check(csv.DictReader(open(os.path.join(OUT, "rate_curve.csv"))).fieldnames
          == ["grid_id", "axis_eV", "k_et_s_inv", "log10_k_et_s_inv"], "rate_curve columns")
    check(len(rr) == len(grid_rows), "rate_curve keeps all 61 rows")
    check([r["grid_id"] for r in rr] == [str(g) for g in grid_ids], "grid order/ids preserved")
    check([r["axis_eV"] for r in rr] == grid_axis_str, "axis_eV preserved verbatim")
with open(os.path.join(OUT, "diagnostics.json")) as fh:
    got = set(json.load(fh).keys())
req = {"alignment_rmsd_forward_A", "alignment_rmsd_backward_A", "closure_error_forward_eV",
       "closure_error_backward_eV", "effective_inner_consistency_eV", "rigid_norm_forward",
       "rigid_norm_backward", "projected_norm_forward", "projected_norm_backward",
       "dominant_mode_forward", "dominant_mode_backward", "rate_peak_grid_id",
       "rate_peak_axis_eV", "rate_peak_s_inv", "inverted_region_detected",
       "first_inverted_grid_id", "first_inverted_axis_eV"}
check(got == req, "diagnostics keys")
for f in ["aligned_displacement_mw.npy", "vibrational_basis_mw.npy", "mode_overlap.npy",
          "projected_displacement_mw.npy", "transported_mode_projection.npy",
          "mode_projection.npy", "overview.png"]:
    check(os.path.exists(os.path.join(OUT, f)), f"artifact exists: {f}")

check(abs(lam_4pt_f - lam_nm_f) < 1e-6, "4pt vs nm consistency (forward)")
check(abs(lam_4pt_b - lam_nm_b) < 1e-6, "4pt vs nm consistency (backward)")
check(abs(mode_projection[0, :, 1].sum() - lam_nm_f) < 1e-9, "mode_projection->lambda_nm_f")
check(abs(mode_projection[1, :, 1].sum() - lam_nm_b) < 1e-9, "mode_projection->lambda_nm_b")
check(np.allclose(transported_mode_projection[0, :, 1], ov_f.max(axis=0)), "transport col1 = overlap rowmax f")
check(np.allclose(transported_mode_projection[1, :, 1], ov_b.max(axis=0)), "transport col1 = overlap rowmax b")

print()
print(f"RMSD f/b (A): {rmsd_f:.6f} / {rmsd_b:.6f}")
print(f"lambda 4pt f/b (eV): {lam_4pt_f:.6f} / {lam_4pt_b:.6f}")
print(f"lambda nm   f/b (eV): {lam_nm_f:.6f} / {lam_nm_b:.6f}")
print(f"lambda inner eff / outer / total (eV): {lam_inner_eff:.6f} / {lam_outer:.6f} / {lam_total:.6f}")
print(f"log10 k_self (s^-1): {log10k_self:.3f}")
print(f"rigid/proj norm f: {rigid_norm_f:.4f} / {projected_norm_f:.4f}")
print(f"rigid/proj norm b: {rigid_norm_b:.4f} / {projected_norm_b:.4f}")
print(f"dominant mode f/b: {dominant_f} / {dominant_b}")
print(f"peak grid_id {peak_grid_id} axis {peak_axis:.6f} log10 {log10k[peak_idx]:.3f}")
print(f"inverted region detected: {detected}")
print("ALL CONTRACT CHECKS PASSED")
