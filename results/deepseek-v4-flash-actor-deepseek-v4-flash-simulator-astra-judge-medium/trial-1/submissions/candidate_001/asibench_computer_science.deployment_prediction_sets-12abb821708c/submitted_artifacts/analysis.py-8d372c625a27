def kmeans(X, K, iters=80, seed=SEED, restarts=25):
    rng = np.random.RandomState(seed)
    best = None
    for _ in range(restarts):
        idx = rng.choice(len(X), K, replace=False)
        cents = X[idx]
        for _ in range(iters):
            d = ((X[:, None, :] - cents[None, :, :]) ** 2).sum(-1)
            lab = d.argmin(1)
            newc = np.stack([X[lab == k].mean(0) if (lab == k).sum() > 0 else cents[k] for k in range(K)])
            cents = newc
        d = ((X[:, None, :] - cents[None, :, :]) ** 2).sum(-1)
        lab = d.argmin(1)
        inertia = ((X - cents[lab]) ** 2).sum()
        if best is None or inertia < best[0]:
            best = (inertia, lab.copy())
    return best[1]

X_all = np.vstack([cal_features[FEATURES].to_numpy(float), dep_features[FEATURES].to_numpy(float)])
Xz = (X_all - X_all.mean(0)) / (X_all.std(0) + 1e-12)
