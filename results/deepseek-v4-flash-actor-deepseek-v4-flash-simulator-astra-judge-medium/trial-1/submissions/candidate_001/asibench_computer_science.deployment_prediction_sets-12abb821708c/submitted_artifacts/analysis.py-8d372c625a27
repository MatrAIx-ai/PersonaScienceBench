# ---------------------------------------------------------------------------
# Risk-monotone greedy per-label threshold policy per group
# ---------------------------------------------------------------------------
def group_policy(g, alpha, q=(np.arange(0.02, 1.0, 0.02))):
    """Return (tau[9], book_risk, risk_with_fallback, mean_size, empty_frac, per_rec_std, n)."""
    idx = np.where(lab_cal == g)[0]
    n = len(idx)
    s = S_cal[idx]
    y = y_idx[idx]
    tau = np.zeros(9)
    cand, csizes, crisks = [], [], []
    for l in range(9):
        sv = s[:, l]
        cvals = np.unique(np.concatenate([[0.0], np.quantile(sv, q), [sv.max() + 1e-9]]))
        cand.append(cvals)
        seg_mask = [(sv >= cvals[j]) & (sv < cvals[j + 1]) for j in range(len(cvals) - 1)]
        size_cnt = np.array([m.sum() for m in seg_mask], dtype=float)
        risk_cnt = np.array([COSTS[l] * ((y == l) & m).sum() / n for m in seg_mask])
        csizes.append(np.concatenate([[0.0], np.cumsum(size_cnt)]))
        crisks.append(np.concatenate([[0.0], np.cumsum(risk_cnt)]))
    j0 = np.zeros(9, dtype=int)
    book = 0.0
    for l in range(9):                      # free (zero-risk) moves first
        cr = crisks[l]
        jbest = None
        for j in range(j0[l] + 1, len(cr)):
            if cr[j] - cr[j0[l]] <= 1e-12:
                jbest = j
        if jbest is not None:
            j0[l] = jbest
            tau[l] = cand[l][jbest]
    while True:                              # risk-monotone greedy by efficiency
        best = None
        for l in range(9):
            if j0[l] + 1 >= len(cand[l]):
                continue
            for j in range(j0[l] + 1, len(cand[l])):
                risk_m = crisks[l][j] - crisks[l][j0[l]]
                size_m = csizes[l][j] - csizes[l][j0[l]]
                if risk_m <= 1e-12 or size_m <= 0:
                    continue
                if book + risk_m <= alpha + 1e-12:
                    eff = size_m / risk_m
                    if best is None or eff > best[0]:
                        best = (eff, l, j, risk_m)
        if best is None:
            break
        eff, l, j, risk_m = best
        tau[l] = cand[l][j]
        j0[l] = j
        book += risk_m
    inc = s >= tau[None, :]
    emp = inc.sum(1) == 0
    inc_fb = inc.copy()
    for i in np.where(emp)[0]:
        inc_fb[i, int(s[i].argmax())] = True
    per_rec = COSTS[y] * (~inc_fb[np.arange(n), y])
    risk_fb = per_rec.mean()
    mean_size = inc_fb.sum(1).mean()
    return tau, book, risk_fb, mean_size, emp.mean(), per_rec.std(), n

z_uc = stats.norm.ppf(1.0 - DELTA)
print(f"[ucb] delta={DELTA} z(1-delta)={z_uc:.3f}")

tau_all = []
rows_policy = []
group_risk, group_ucb, group_size, group_empty, group_ncal, group_nlab = {}, {}, {}, {}, {}, {}
for g in range(K_GROUPS):
    tau, book, risk_fb, mean_size, empty_frac, per_rec_std, n_cal = group_policy(g, BUDGET)
    tau_all.append(tau)
    ucb = risk_fb + z_uc * per_rec_std / np.sqrt(n_cal)
    assert risk_fb <= BUDGET + 1e-9, f"group {g} risk {risk_fb:.4f} exceeds budget"
    idx = np.where(lab_cal == g)[0]
    yg = y_idx[idx]
    group_risk[g], group_ucb[g], group_size[g] = risk_fb, ucb, mean_size
    group_empty[g], group_ncal[g] = empty_frac, n_cal
    group_nlab[g] = np.bincount(yg, minlength=9)
    for l in range(9):
        rows_policy.append({
            "proxy_stratum": GROUP_IDS[g], "label": LABELS[l],
            "n_calibration": int(n_cal), "n_calibration_label": int(group_nlab[g][l]),
            "threshold": round(float(tau[l]), 6),
            "group_empirical_weighted_miss_risk": round(float(risk_fb), 6),
            "group_upper_confidence_risk": round(float(ucb), 6),
            "group_expected_set_size": round(float(mean_size), 6),
            "calibration_target_risk": BUDGET, "target_risk": TARGET_RISK,
        })
    print(f"[group {g}] ncal={n_cal} risk={risk_fb:.4f} (budget {BUDGET}) ucb={ucb:.4f} "
          f"size={mean_size:.3f} empty={empty_frac:.4f}")

def apply_thresholds(scores, group_ids, tau_all):
    inc_all = np.zeros_like(scores, dtype=bool)
    for g in range(K_GROUPS):
        m = group_ids == g
        inc_all[m] = scores[m] >= tau_all[g][None, :]
    empty = inc_all.sum(1) == 0
    inc_fb = inc_all.copy()
    for i in np.where(empty)[0]:
        inc_fb[i, int(scores[i].argmax())] = True
    return inc_fb, inc_fb.sum(1), empty

inc_dep, dep_sizes, dep_empty = apply_thresholds(S_dep, lab_dep, tau_all)
assert dep_empty.sum() == 0 and dep_sizes.min() >= 1
print(f"[deploy] mean_size={dep_sizes.mean():.3f} p90={np.percentile(dep_sizes, 90):.1f} "
