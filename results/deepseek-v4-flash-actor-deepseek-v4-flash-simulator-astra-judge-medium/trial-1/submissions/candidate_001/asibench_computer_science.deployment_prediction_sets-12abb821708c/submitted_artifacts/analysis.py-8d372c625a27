def chart_frame(c, x0, y0, W, H, xl, yl, title, gx_min, gx_max, gy_min, gy_max, xticks, yticks,
                xtickfmt=".2f", ytickfmt=".2f"):
    c.line(x0, y0, x0 + W, y0, _BLK, 1)
    c.line(x0, y0, x0, y0 - H, _BLK, 1)
    c.text(x0 + 4, 4, title, _BLK, 1)
    c.text(x0, y0 + 6, xl, _BLK, 1)
    c.text(x0 - 40, y0 - H + 4, yl, _BLK, 1)
    for f in xticks:
        gx = gx_min + (gx_max - gx_min) * f
        px = x0 + W * f
        c.line(px, y0, px, y0 + 4, _BLK, 1)
        c.text(px - 10, y0 + 5, _fmt(gx, 0) if xtickfmt == "int" else f"{gx:{xtickfmt}}", _BLK, 1)
    for f in yticks:
        gy = gy_min + (gy_max - gy_min) * f
        py = y0 - H * f
        c.line(x0 - 4, py, x0, py, _BLK, 1)
        c.text(x0 - 30, py - 3, f"{gy:{ytickfmt}}", _BLK, 1)
    return gx_min, gx_max, gy_min, gy_max

def to_px(x0, y0, W, H, gx0, gx1, gy0, gy1, gx, gy):
    return x0 + W * (gx - gx0) / (gx1 - gx0), y0 - H * (gy - gy0) / (gy1 - gy0)

