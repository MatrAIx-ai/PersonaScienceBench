class Canvas:
    def __init__(self, w, h, bg=(255,255,255)):
        self.w=w; self.h=h
        self.img=np.full((h,w,3),bg,dtype=np.uint8)
    def fill_rect(self,x0,y0,x1,y1,color):
        x0=max(0,int(x0)); y0=max(0,int(y0)); x1=min(self.w-1,int(x1)); y1=min(self.h-1,int(y1))
        if x1>=x0 and y1>=y0: self.img[y0:y1+1,x0:x1+1]=color
    def line(self,x0,y0,x1,y1,color,thick=1):
        n=max(abs(int(x1)-int(x0)),abs(int(y1)-int(y0)),1)
        for t in range(n+1):
            x=int(round(x0+(x1-x0)*t/n)); y=int(round(y0+(y1-y0)*t/n))
            for dy in range(thick):
                for dx in range(thick):
                    yy=y+dy-thick//2; xx=x+dx-thick//2
                    if 0<=yy<self.h and 0<=xx<self.w: self.img[yy,xx]=color
    def circle(self,cx,cy,color,r=3):
        for dy in range(-r,r+1):
            for dx in range(-r,r+1):
                if dx*dx+dy*dy<=r*r:
                    yy=int(cy)+dy; xx=int(cx)+dx
                    if 0<=yy<self.h and 0<=xx<self.w: self.img[yy,xx]=color
    def text(self,x,y,s,color=_BLK,scale=1):
        im=np.zeros((7*scale+2, len(s)*6*scale+1,3),dtype=np.uint8)
        for ci,ch in enumerate(s.upper()):
            gl=_FONT.get(ch,_FONT[' '])
            for r,row in enumerate(gl):
                for cn,px in enumerate(row):
                    if px=='1':
                        for dy in range(scale):
                            for dx in range(scale):
                                yy=1+r*scale+dy; xx=ci*6*scale+cn*scale+dx
                                if 0<=yy<im.shape[0] and 0<=xx<im.shape[1]: im[yy,xx]=color
        mask=im[:,:,0]>0; h,w=mask.shape
        for yy in range(h):
            for xx in range(w):
                if mask[yy,xx]:
                    X=int(x)+xx; Y=int(y)+yy
                    if 0<=X<self.w and 0<=Y<self.h: self.img[Y,X]=color
    def save(self,path): _write_png(path,self.img)

