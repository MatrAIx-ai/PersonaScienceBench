def _text_w(s):
    return len(s) * 6 - 1  # 5 px glyph + 1 px spacing


def draw_text(img, x, y, text, color, scale=1):
    h, w = img.shape[:2]
    cur = 0
    for ch in text:
        ch = ch.upper() if ch not in FONT else ch
        g = FONT.get(ch, FONT[" "])
        for r, row in enumerate(g):
            for c, px in enumerate(row):
                if px == "#":
                    ix, iy = x + c * scale, y + r * scale
                    for dy in range(scale):
                        for dx in range(scale):
                            if 0 <= iy + dy < h and 0 <= ix + dx < w:
                                img[iy + dy, ix + dx] = color
        x += 6 * scale


def draw_line(img, x0, y0, x1, y1, color, width=1):
    x0, y0, x1, y1 = int(x0), int(y0), int(x1), int(y1)
    dx, dy = abs(x1 - x0), -abs(y1 - y0)
    sx = 1 if x0 < x1 else -1
    sy = 1 if y0 < y1 else -1
    err = dx + dy
    while True:
        for dw in range(width):
            for dh in range(width):
                px, py = x0 + dw - width // 2, y0 + dh - width // 2
                if 0 <= px < img.shape[1] and 0 <= py < img.shape[0]:
                    img[py, px] = color
        if x0 == x1 and y0 == y1:
            break
        e2 = 2 * err
        if e2 >= dy:
            err += dy; x0 += sx
        if e2 <= dx:
            err += dx; y0 += sy


def _draw_vertical_text(img, x, y, text, color):
    for i, ch in enumerate(text):
        g = FONT.get(ch, FONT[" "])
        for r, row in enumerate(g):
            for c, px in enumerate(row):
                if px == "#":
                    ix, iy = x + r, y + c + i * 6
                    if 0 <= iy < img.shape[0] and 0 <= ix < img.shape[1]:
                        img[iy, ix] = color

# ----------------------------------------------------------------------------
# generic time-series panel used for the diurnal figure
# ----------------------------------------------------------------------------
def plot_series(img, ox, oy, pw, ph, times, series_list, colors, y_lim,
                y_ticks, title, ylab, xtick_vals, xtick_labels):
    t0, t1 = times[0], times[-1]
    ylo, yhi = y_lim

    def mx(v):
        return ox + pw * (v - t0) / (t1 - t0)

    def my(v):
        return oy - ph * (v - ylo) / (yhi - ylo)

    black = (0, 0, 0)
    grey = (210, 210, 210)
    # frame
    draw_line(img, ox, oy, ox + pw, oy, black)
    draw_line(img, ox, oy, ox, oy - ph, black)
    draw_line(img, ox, oy - ph, ox + pw, oy - ph, black)
    draw_line(img, ox + pw, oy, ox + pw, oy - ph, black)
    # horizontal grid + y ticks
    for v in y_ticks:
        yp = int(my(v))
        draw_line(img, ox, yp, ox + pw, yp, grey)
        draw_line(img, ox - 4, yp, ox + 2, yp, black)
        draw_text(img, ox - 30, yp - 3, f"{v:g}", black)
    # vertical grid + x ticks
    for v, lab in zip(xtick_vals, xtick_labels):
        xp = int(mx(v))
        draw_line(img, xp, oy, xp, oy + 4, black)
        draw_text(img, xp - 9, oy + 6, lab, black)
    # y-axis label (vertical)
    _draw_vertical_text(img, ox - 46, int(oy - ph / 2), ylab, black)
    draw_text(img, ox + pw // 2 - 22, oy + 22, "TIME (H)", black)
    draw_text(img, ox + pw - 6 * len(title) - 4, oy - ph - 16, title, black)
    # curves
    px = [mx(t) for t in times]
    for s, col in zip(series_list, colors):
        py = [my(v) for v in s]
        for i in range(len(px) - 1):
            draw_line(img, px[i], py[i], px[i + 1], py[i + 1], col, width=2)


def make_diurnal_png(fluxes, path):
    W, H = 1300, 900
    img = np.zeros((H, W, 3), dtype=np.uint8)
    img[:, :] = (255, 255, 255)
    t = fluxes["time_hr"].values
    as_ = fluxes["A_sun"].values
    ad = fluxes["A_shade"].values
    rs_ = fluxes["rs_sun"].values
    rd_ = fluxes["rs_shade"].values
    draw_text(img, W // 2 - 210, 16,
              "DIURNAL LEAF FLUXES (C4, BALL-BERRY COUPLED)", (0, 0, 0))
    # panel 1: assimilation
    a_max = max(as_.max(), ad.max())
    a_lim = (0, math.ceil(a_max * 1.05))
    a_ticks = [v for v in range(0, int(a_lim[1]) + 1, 10)]
    xticks = list(range(0, 121, 24))
    xlabs = [f"{v:g}" for v in xticks]
    plot_series(img, 140, 320, 1020, 200, t, [as_, ad],
                [(200, 25, 25), (25, 25, 200)], a_lim, a_ticks,
                "A", "A (UMOL M-2 S-1)", xticks, xlabs)
    # panel 2: stomatal resistance
    rs_max = max(rs_.max(), rd_.max())
    rs_lim = (0, math.ceil(rs_max * 1.05))
    step = 50 if rs_max < 1000 else 100
    rs_ticks = list(range(0, int(rs_lim[1]) + step, step))
    plot_series(img, 140, 720, 1020, 200, t, [rs_, rd_],
                [(200, 25, 25), (25, 25, 200)], rs_lim, rs_ticks,
                "RS", "RS (S M-1)", xticks, xlabs)
    # legend
    draw_line(img, 120, 360, 165, 360, (200, 25, 25), width=2)
    draw_text(img, 172, 352, "A-SUN", (200, 25, 25))
    draw_line(img, 280, 360, 325, 360, (25, 25, 200), width=2)
    draw_text(img, 332, 352, "A-SHADE", (25, 25, 200))
    draw_line(img, 120, 762, 165, 762, (200, 25, 25), width=2)
