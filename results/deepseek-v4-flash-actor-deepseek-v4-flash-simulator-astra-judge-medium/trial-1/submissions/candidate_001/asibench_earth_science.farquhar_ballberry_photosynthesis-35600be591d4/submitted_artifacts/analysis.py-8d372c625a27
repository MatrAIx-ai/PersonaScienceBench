def _parse_font(body):
    font = {}
    for line in body.strip().splitlines():
        line = line.strip()
        if not line or ":" not in line:
            continue
        ch, rows = line.split(":", 1)
        rows = rows.split()
        pad = [r[:5].ljust(5, ".") for r in rows]
        font[ch] = pad
    # ensure every needed char has 7 rows
    for ch in list("ABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-._()= "):
        if ch != " " and ch not in font:
            font[ch] = ["....."] * 7
    font[" "] = ["....."] * 7
    return font


