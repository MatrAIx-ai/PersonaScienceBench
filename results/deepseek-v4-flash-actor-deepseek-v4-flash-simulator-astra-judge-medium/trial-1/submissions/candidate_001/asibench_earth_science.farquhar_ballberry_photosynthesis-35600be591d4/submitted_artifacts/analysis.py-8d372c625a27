#!/usr/bin/env python3
"""
analysis.py - Leaf-level C4 photosynthesis / Ball-Berry coupled solve.

Reconstructs diurnal leaf fluxes (sunlit + shaded leaves) from data/leaf_params.json,
data/forcing.csv, and solves the coupled fixed-point system for the single-point
evaluation cases in data/test_cases.json.  All conventions follow the task brief:

  * C4 branch:  Wc=Vcmax_eff, Wj=alpha_q*APAR, We=4000*Vcmax_eff*Ci/p_atm,
                A = min(Wc,Wj,We) - Rd,  APAR=4.6*PAR (no absorptance factor)
  * CLM/Noah-MP Q10 response for Vcmax including high-temperature inhibition
  * Kc25=30 Pa, Ko25=30000 Pa, Q10=(2.1,1.2,2.4), Gamma_star=0.5*(Kc/Ko)*O2*0.21,
    Rd=0.015*Vcmax
  * n_factor and btran multiply photosynthetic capacity (Vcmax_eff); Ball-Berry
    intercept (b0) is NOT scaled by btran
  * leaf T = air T; surface RH  h_s = clamp(1 - vpd/esat(T), 0.25, 1.0)
  * gas-diffusion chain: cf=p_atm/(R*T), cs=ca-1.37*rb*A_mol/cf*p_atm,
    gs=m*A_mol*h_s/cs*p_atm+b0, rs=cf/gs, Ci=cs-1.65*rs*A_mol/cf*p_atm
  * night (PAR==0): A=-Rd, gs=b0 (intercept), rs=cf/b0, diffusion chain for cs/Ci
  * under light the reported variables are the common coupled fixed point, solved
    by fixed-point iteration seeded from the internal-state guess (ci_init) with a
    bisection fallback for robustness.

Outputs: results/leaf_fluxes.csv (one row per forcing row, sun+shade),
         results/case_convergence.csv (one row per test case),
         results/diurnal.png (diurnal A and rs curves; hand-rolled PNG writer as
         matplotlib is unavailable in this environment).
"""
import json
import math
import os
import struct
import zlib

import numpy as np
import pandas as pd

# ----------------------------------------------------------------------------
# constants / parameters
# ----------------------------------------------------------------------------
R = 8.314                     # J mol^-1 K^-1 (gas constant, CLM/Noah-MP inhibition)
KC25, KO25 = 30.0, 30000.0    # Pa
Q10_KC, Q10_KO, Q10_V = 2.1, 1.2, 2.4
VCQ_F = 0.015                 # Rd = Rd_fraction * Vcmax
TOL_CI = 1e-8                 # Pa convergence tolerance on internal Ci
MAX_FP = 200                  # max fixed-point iterations
HERE = os.path.dirname(os.path.abspath(__file__))
DATA = os.path.join(HERE, "data")
OUT = os.path.join(HERE, "results")

# ----------------------------------------------------------------------------
# read inputs
# ----------------------------------------------------------------------------
with open(os.path.join(DATA, "leaf_params.json")) as fh:
    PARAMS = json.load(fh)
PATHWAY = PARAMS["pathway"]
VCMAX25 = float(PARAMS["vcmax25"])
BB_M = float(PARAMS["bb_slope"])
BB_B0 = float(PARAMS["bb_intercept"])
ALPHA_Q = float(PARAMS["alpha_q"])
N_FACTOR = float(PARAMS["n_factor"])

FORC = pd.read_csv(os.path.join(DATA, "forcing.csv"))
with open(os.path.join(DATA, "test_cases.json")) as fh:
    CASES = json.load(fh)

assert PATHWAY.upper() == "C4", "This implementation follows the C4 pathway given in leaf_params.json"

# ----------------------------------------------------------------------------
# physiology helpers
# ----------------------------------------------------------------------------
def vcmax_temp(t_k: float) -> float:
    """CLM/Noah-MP Q10 response (incl. high-temperature inhibition)."""
    tc = t_k - 273.15
    tv = tc + 273.16
    num = VCMAX25 * 2.4 ** ((tc - 25.0) / 10.0)
    den = 1.0 + math.exp((-2.2e5 + 710.0 * tv) / (R * tv))
    return num / den


def esat_pa(t_k: float) -> float:
    """Saturated vapour pressure [Pa], Noah-MP / CLM Tetens form."""
    return 0.611 * math.exp(17.2693882 * (t_k - 273.16) / (t_k - 35.86)) * 1000.0


def h_surface(t_k: float, vpd_pa: float) -> float:
    """Surface relative humidity clamped to [0.25, 1.0]."""
    return max(min(1.0 - vpd_pa / esat_pa(t_k), 1.0), 0.25)


def gamma_star_pa(t_k: float, o2_pa: float) -> float:
    """CO2 compensation point Gamma* = 0.5*(Kc/Ko)*O2*0.21 (literal 0.21 factor)."""
    tc = t_k - 273.15
    kc = KC25 * Q10_KC ** ((tc - 25.0) / 10.0)
    ko = KO25 * Q10_KO ** ((tc - 25.0) / 10.0)
    return 0.5 * (kc / ko) * o2_pa * 0.21


def vcmax_eff(t_k: float, btran: float) -> float:
    """Photosynthetic capacity: Q10 response x n_factor x btran."""
    return vcmax_temp(t_k) * N_FACTOR * btran


# ----------------------------------------------------------------------------
# gas diffusion chain (Ball-Berry + aerodynamic/boundary layer)
# ----------------------------------------------------------------------------
def diffusion_chain(A, t_k, p_atm, ca, o2, vpd_pa, rb_sm, hs, forced_night=False):
    """
    Given net assimilation A [umol m^-2 s^-1] return (cs,gs,rs,ci,cf).
    At night (forced_night) the Ball-Berry intercept conductance is used
    (gs = b0; no positive Ball-Berry term from an A<0).
    """
    a_mol = A * 1e-6
    cf = p_atm / (R * t_k)
    cs = ca - 1.37 * rb_sm * a_mol / cf * p_atm
    if forced_night:
        gs = BB_B0
    else:
        gs = BB_M * a_mol * hs / cs * p_atm + BB_B0
    rs = cf / gs
    ci = cs - 1.65 * rs * a_mol / cf * p_atm
    return cs, gs, rs, ci, cf


def c4_rate(ci_pa, par, t_k, p_atm, vc):
    """C4 Farquhar net assimilation at given internal Ci."""
    rd = VCQ_F * vc
    wc = vc
    wj = ALPHA_Q * 4.6 * par
    we = 4000.0 * vc * ci_pa / p_atm
    a = min(wc, wj, we) - rd
    return a, rd


def coupled_state(ci_pa, par, t_k, p_atm, ca, o2_pa, vpd_pa, rb_sm, btran):
    """
    One evaluation of the full coupled map: given internal Ci, compute
    A, then push it through the diffusion chain to get a new (implied) Ci.
    At the fixed point ci_out == ci_in.  Returns dict of all physical quantities.
    """
    vc = vcmax_eff(t_k, btran)
    a, rd = c4_rate(ci_pa, par, t_k, p_atm, vc)
    hs = h_surface(t_k, vpd_pa)
    cs, gs, rs, ci_out, cf = diffusion_chain(a, t_k, p_atm, ca, o2_pa, vpd_pa, rb_sm, hs)
    return {
        "ci_in": ci_pa, "ci_out": ci_out, "A": a, "cs": cs, "gs": gs,
        "rs": rs, "hs": hs, "cf": cf, "vc": vc, "rd": rd, "esat": esat_pa(t_k),
    }


# ----------------------------------------------------------------------------
# solver
# ----------------------------------------------------------------------------
def night_state(t_k, p_atm, ca, o2_pa, vpd_pa, rb_sm, btran):
    """Zero-PAR branch: respiratory assimilation + intercept conductance."""
    vc = vcmax_eff(t_k, btran)
    rd = VCQ_F * vc
    a = -rd
    hs = h_surface(t_k, vpd_pa)
    cs, gs, rs, ci, cf = diffusion_chain(a, t_k, p_atm, ca, o2_pa, vpd_pa, rb_sm, hs,
                                         forced_night=True)
    return {"A": a, "cs": cs, "gs": gs, "rs": rs, "ci_out": ci, "hs": hs,
            "cf": cf, "vc": vc, "rd": rd, "esat": esat_pa(t_k), "ci_in": ci,
            "solution": "night"}


def _bisection_fallback(par, t_k, p_atm, ca, o2_pa, vpd_pa, rb_sm, btran,
                        lo=0.0, tol=TOL_CI, max_it=200):
    """Bisection on residual r(ci)=ci_out(ci)-ci over ci in [lo, ca]."""
    def resid(ci):
        return coupled_state(ci, par, t_k, p_atm, ca, o2_pa, vpd_pa, rb_sm, btran)["ci_out"] - ci
    a_lo, b_hi = lo, ca
    n = 0
    while (b_hi - a_lo) > tol and n < max_it:
        mid = 0.5 * (a_lo + b_hi)
        r = resid(mid)
        if r > 0.0:      # decreasing residual: root above mid
            a_lo = mid
        else:
            b_hi = mid
        n += 1
    ci = 0.5 * (a_lo + b_hi)
    return coupled_state(ci, par, t_k, p_atm, ca, o2_pa, vpd_pa, rb_sm, btran), n


LIGHT_THRESHOLD = 1e-6   # W m^-2; PAR below this is treated as night


def solve_leaf(par, t_k, p_atm, ca, o2_pa, vpd_pa, rb_sm, btran, ci_seed,
               tol=TOL_CI):
    """
    Solve the coupled system for one leaf at one forcing row.

    Light (par > 1e-6): fixed-point iteration  ci_{n+1} = ci_out(ci_n)  seeded at
      ci_seed (the initial internal-state guess for the evaluation cases);
      undamped first (fast), then a damped phase and finally a bisection
      fallback for safety.  The returned dict carries the number of coupled-chain
      evaluations (iterations) used.
    Night (par <= 1e-6): analytic respiratory branch (n_iterations = 0).
    """
    if par <= LIGHT_THRESHOLD:
        st = night_state(t_k, p_atm, ca, o2_pa, vpd_pa, rb_sm, btran)
        st["n_iterations"] = 0
        st["solution"] = "night"
        return st
    ci = float(ci_seed)
    # ---- Phase 1: undamped fixed-point iteration ----
    n_used = 0
    for it in range(1, MAX_FP + 1):
        st = coupled_state(ci, par, t_k, p_atm, ca, o2_pa, vpd_pa, rb_sm, btran)
        cio = st["ci_out"]
        if abs(cio - ci) <= tol:
            st["n_iterations"] = it
            st["solution"] = "fixed_point"
            return st
        if not (0.0 < cio < ca):     # iterate left the physical range
            n_used = it
            break
        ci = cio
    else:
        n_used = MAX_FP
    # ---- Phase 2: damped fixed-point iteration ----
    for k in range(1, MAX_FP + 1):
        st = coupled_state(ci, par, t_k, p_atm, ca, o2_pa, vpd_pa, rb_sm, btran)
        cio = st["ci_out"]
        if abs(cio - ci) <= tol:
            st["n_iterations"] = n_used + k
            st["solution"] = "damped_fixed_point"
            return st
        nxt = 0.5 * (ci + cio)
        nxt = max(1e-6, min(ca - 1e-6, nxt))
        ci = nxt
    # ---- Phase 3: bisection on [0, ca] ----
    st, n = _bisection_fallback(par, t_k, p_atm, ca, o2_pa, vpd_pa, rb_sm, btran)
    st["n_iterations"] = n_used + MAX_FP + n
    st["solution"] = "bisection_fallback"
    return st

# ----------------------------------------------------------------------------
# main: diurnal loop
# ----------------------------------------------------------------------------
def run_diurnal():
    recs = []
    prev_sun, prev_shd = None, None
    for _, r in FORC.iterrows():
        t_k = float(r["t_air_K"]); p_atm = float(r["p_atm_Pa"])
        ca = float(r["co2_pa"]); o2 = float(r["o2_pa"])
        vpd = float(r["vpd_Pa"]); rb = float(r["rb_sm"]); bt = float(r["btran"])
        ps, psd = float(r["par_sun_wm2"]), float(r["par_shade_wm2"])
        # warm start from the previous light row's converged Ci
        light = ps > LIGHT_THRESHOLD or psd > LIGHT_THRESHOLD
        seed_s = prev_sun if prev_sun is not None else 0.5 * ca
        seed_d = prev_shd if prev_shd is not None else 0.5 * ca
        st_s = solve_leaf(ps, t_k, p_atm, ca, o2, vpd, rb, bt, seed_s)
        st_d = solve_leaf(psd, t_k, p_atm, ca, o2, vpd, rb, bt, seed_d)
        if light:
            prev_sun, prev_shd = st_s["ci_out"], st_d["ci_out"]
        recs.append({
            "time_hr": float(r["time_hr"]),
            "A_sun": st_s["A"], "A_shade": st_d["A"],
            "rs_sun": st_s["rs"], "rs_shade": st_d["rs"],
            "ci_sun": st_s["ci_out"], "ci_shade": st_d["ci_out"],
            "gs_sun": st_s["gs"], "gs_shade": st_d["gs"],
        })
    return pd.DataFrame(recs)


# ----------------------------------------------------------------------------
# main: evaluation cases (forcing_index=12 for every case; sun leaf)
# ----------------------------------------------------------------------------
def run_cases():
    rows = []
    forcing = FORC
    for c in CASES:
        idx = int(c["forcing_index"])
        r = forcing.iloc[idx]
        t_k = float(r["t_air_K"]); p_atm = float(r["p_atm_Pa"])
        ca = float(r["co2_pa"]); o2 = float(r["o2_pa"])
        vpd = float(r["vpd_Pa"]); rb = float(r["rb_sm"]); bt = float(r["btran"])
        par = float(r["par_sun_wm2"])   # cases do not specify leaf type -> sun leaf
        ci0 = float(c["ci_init_pa"])
        st = solve_leaf(par, t_k, p_atm, ca, o2, vpd, rb, bt, ci0)
        rows.append({
            "case_id": c["case_id"],
            "ci_init_pa": ci0,
            "ci_final_pa": st["ci_out"],
            "A_final": st["A"],
            "rs_final": st["rs"],
            "n_iterations": st["n_iterations"],
        })
    return pd.DataFrame(rows)

# ----------------------------------------------------------------------------
# minimal hand-rolled PNG writer + tiny raster drawing (matplotlib unavailable)
# ----------------------------------------------------------------------------
def _png_write(path, rgb):
    h, w = rgb.shape[:2]

    def chunk(typ, data):
        out = struct.pack(">I", len(data)) + typ + data
        return out + struct.pack(">I", zlib.crc32(typ + data) & 0xFFFFFFFF)

    raw = bytearray()
    for y in range(h):
        raw.append(0)                       # filter type 0 per scanline
        raw += rgb[y, :, :].astype(np.uint8).tobytes()
    png = b"\x89PNG\r\n\x1a\n"
    png += chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0))
    png += chunk(b"IDAT", zlib.compress(bytes(raw), 9))
    png += chunk(b"IEND", b"")
    with open(path, "wb") as fh:
        fh.write(png)


