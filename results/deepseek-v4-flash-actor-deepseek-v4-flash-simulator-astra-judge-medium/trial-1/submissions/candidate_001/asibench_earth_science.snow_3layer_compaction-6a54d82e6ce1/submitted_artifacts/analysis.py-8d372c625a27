def make_figure(res, path):
    nd = 68
    days = np.arange(nd)
    st = res["state"]
    depth = st[:,:,0].sum(axis=1)
    swe   = st[:,:,2].sum(axis=1) + st[:,:,3].sum(axis=1)
    T0, T1, T2 = st[:,0,4], st[:,1,4], st[:,2,4]
    r0, r1, r2 = st[:,0,1], st[:,1,1], st[:,2,1]
    melt_c = np.cumsum(res["day_melt"])
    refr_c = np.cumsum(res["day_refr"])
    run_c  = np.cumsum(res["day_run"])
    res_c  = np.cumsum(res["residual_hour"].reshape(nd, 24).sum(axis=1))

    W, H = 1150, 900
    img = np.full((H, W, 3), 252, np.uint8)
    BLACK = np.array([20, 20, 20], np.uint8)
    GRID  = np.array([216, 216, 216], np.uint8)
    x0, x1 = 95, 1055

    put_text(img, 300, 14, "SNOWPACK DYNAMICS - FIXED 3-LAYER PROCESS MODEL (68 DAYS)", 2, BLACK)

    panels = [(80,235), (295,450), (510,665), (725,845)]
    for y0p, y1p in panels:
        _hline(img, x0, x1, y0p, BLACK, 1)
        _vline(img, x0, y0p, y1p, BLACK, 1)
        _vline(img, x1, y0p, y1p, BLACK, 1)
        _hline(img, x0, x1, y1p, BLACK, 1)

    # ---- A: snow depth + SWE ----
    y0p, y1p = panels[0]
    dlo, dhi = 1.1, 1.7
    for t in _niceticks(dlo, dhi, 5):
        yy = int(_mappy(t, dlo, dhi, y0p, y1p))
        _hline(img, x0, x1, yy, GRID, 1); _hline(img, x0, x0+4, yy, BLACK, 1)
        put_text(img, x0-48, yy-4, _fmt(t), 1, BLACK)
    slo, shi = 205, 250
    for t in _niceticks(slo, shi, 5):
        yy = int(_mappy(t, slo, shi, y0p, y1p))
        _hline(img, x1-4, x1, yy, BLACK, 1)
        put_text(img, x1+6, yy-4, _fmt(t), 1, np.array([0,140,70]))
    put_text(img, x0-6, y0p-16, "DEPTH M", 1, np.array([0,90,180]))
    put_text(img, x1+4, y0p-16, "SWE MM", 1, np.array([0,140,70]))
    _plotxy(img, days, _mappy(depth, dlo, dhi, y0p, y1p), x0, x1, y0p, y1p, 0, 67, np.array([0,90,180]), 2)
    _plotxy(img, days, _mappy(swe, slo, shi, y0p, y1p), x0, x1, y0p, y1p, 0, 67, np.array([0,140,70]), 2)
    put_text(img, x0+8, y0p+8,  "SNOW DEPTH", 1, np.array([0,90,180]))
    put_text(img, x0+8, y0p+22, "SWE", 1, np.array([0,140,70]))

    # ---- B: layer temperatures ----
    y0p, y1p = panels[1]
    tlo, thi = 255, 275
    for t in _niceticks(tlo, thi, 5):
        yy = int(_mappy(t, tlo, thi, y0p, y1p))
        _hline(img, x0, x1, yy, GRID, 1); _hline(img, x0, x0+4, yy, BLACK, 1)
        put_text(img, x0-48, yy-4, _fmt(t), 1, BLACK)
    put_text(img, x0-6, y0p-16, "TEMP K", 1, BLACK)
    _hline(img, x0, x1, int(_mappy(273.15, tlo, thi, y0p, y1p)), np.array([170,170,170]), 1)
    _plotxy(img, days, _mappy(T0, tlo, thi, y0p, y1p), x0, x1, y0p, y1p, 0, 67, np.array([200,25,25]), 2)
    _plotxy(img, days, _mappy(T1, tlo, thi, y0p, y1p), x0, x1, y0p, y1p, 0, 67, np.array([0,120,200]), 2)
    _plotxy(img, days, _mappy(T2, tlo, thi, y0p, y1p), x0, x1, y0p, y1p, 0, 67, np.array([170,100,0]), 2)
    put_text(img, x0+8, y0p+8,  "L0 TOP", 1, np.array([200,25,25]))
    put_text(img, x0+8, y0p+22, "L1 MID", 1, np.array([0,120,200]))
    put_text(img, x0+8, y0p+36, "L2 BOT", 1, np.array([170,100,0]))

    # ---- C: layer densities ----
    y0p, y1p = panels[2]
    rlo, rhi = 100, 290
    for t in _niceticks(rlo, rhi, 5):
        yy = int(_mappy(t, rlo, rhi, y0p, y1p))
        _hline(img, x0, x1, yy, GRID, 1); _hline(img, x0, x0+4, yy, BLACK, 1)
        put_text(img, x0-48, yy-4, _fmt(t), 1, BLACK)
    put_text(img, x0-6, y0p-16, "DENSITY KG/M3", 1, BLACK)
    _plotxy(img, days, _mappy(r0, rlo, rhi, y0p, y1p), x0, x1, y0p, y1p, 0, 67, np.array([180,30,180]), 2)
    _plotxy(img, days, _mappy(r1, rlo, rhi, y0p, y1p), x0, x1, y0p, y1p, 0, 67, np.array([0,120,200]), 2)
    _plotxy(img, days, _mappy(r2, rlo, rhi, y0p, y1p), x0, x1, y0p, y1p, 0, 67, np.array([220,120,0]), 2)
    put_text(img, x0+8, y0p+8,  "L0 TOP", 1, np.array([180,30,180]))
    put_text(img, x0+8, y0p+22, "L1 MID", 1, np.array([0,120,200]))
    put_text(img, x0+8, y0p+36, "L2 BOT", 1, np.array([220,120,0]))

    # ---- D: cumulative melt/refreeze/runoff + mass residual ----
    y0p, y1p = panels[3]
    mlo, mhi = 0, 220
    for t in _niceticks(mlo, mhi, 5):
        yy = int(_mappy(t, mlo, mhi, y0p, y1p))
        _hline(img, x0, x1, yy, GRID, 1); _hline(img, x0, x0+4, yy, BLACK, 1)
        put_text(img, x0-48, yy-4, _fmt(t), 1, BLACK)
    rlo2, rhi2 = -1, 1
    for t in _niceticks(rlo2, rhi2, 3):
        yy = int(_mappy(t, rlo2, rhi2, y0p, y1p))
        _hline(img, x1-4, x1, yy, BLACK, 1)
        put_text(img, x1+6, yy-4, _fmt(t), 1, np.array([120,120,120]))
    _plotxy(img, days, _mappy(melt_c, mlo, mhi, y0p, y1p), x0, x1, y0p, y1p, 0, 67, np.array([220,30,30]), 2)
    _plotxy(img, days, _mappy(refr_c, mlo, mhi, y0p, y1p), x0, x1, y0p, y1p, 0, 67, np.array([30,110,220]), 2)
    _plotxy(img, days, _mappy(run_c, mlo, mhi, y0p, y1p), x0, x1, y0p, y1p, 0, 67, np.array([20,160,20]), 2)
    _plotxy(img, days, _mappy(res_c, rlo2, rhi2, y0p, y1p), x0, x1, y0p, y1p, 0, 67, np.array([120,120,120]), 1, dashed=True)
    put_text(img, x0+8, y0p+8,  "CUM MELT (MM)", 1, np.array([220,30,30]))
    put_text(img, x0+8, y0p+22, "CUM REFREEZE", 1, np.array([30,110,220]))
    put_text(img, x0+8, y0p+36, "CUM RUNOFF", 1, np.array([20,160,20]))
    put_text(img, x0+8, y0p+50, "MASS RESIDUAL MM", 1, np.array([120,120,120]))

    # x-axis
    for t in _niceticks(0, 67, 7):
        xx = int(x0 + t / 67 * (x1 - x0))
        _vline(img, xx, 845, 849, BLACK, 1)
        put_text(img, xx - 6, 855, _fmt(t), 1, BLACK)
    put_text(img, 520, 887, "DAY", 1, BLACK)

    note = "MASS BALANCE: INIT %.1f + IN %.1f - RUNOFF %.1f = FINAL %.1f MM (HOURLY RESIDUAL < %.0e)" % (
        res["final_swe"] + res["total_run"] - res["total_in"], res["total_in"],
        res["total_run"], res["final_swe"], res["max_abs_hourly_residual"])
    put_text(img, 60, 866, note, 1, np.array([60,60,60]))

    _write_png(path, img)

# =============================================================================
def write_outputs(res):
    os.makedirs(RES, exist_ok=True)
    np.save(os.path.join(RES, "snow_state.npy"), res["state"])
    df = make_summary(res)
    df.to_csv(os.path.join(RES, "snow_summary.csv"), index=False)
    make_figure(res, os.path.join(RES, "snow_evolution.png"))
    return df

def main():
    f, _, _, _, _ = load_inputs()
    res = run_model(f)
    df = write_outputs(res)
    print("snow_state.npy    shape %s dtype %s" % (res["state"].shape, res["state"].dtype))
    print("snow_summary.csv  %d rows, columns %s" % (len(df), list(df.columns)))
    print("snow_evolution.png written")
    print("final SWE (mm)        : %.2f" % res["final_swe"])
    print("total snowfall (mm)   : %.2f" % res["total_in"])
    print("total melt (mm)       : %.2f" % res["total_melt"])
    print("total refreeze (mm)   : %.2f" % res["total_refr"])
    print("total runoff (mm)     : %.2f" % res["total_run"])
    print("end mass balance (mm) : %.3e" % res["mass_check_end"])
    print("max |hourly residual| : %.2e mm" % res["max_abs_hourly_residual"])

if __name__ == "__main__":
    main()
