def put_text(img, x, y, s, scale, color):
    """Rasterize uppercase text at (x,y) top-left, scale px per font pixel."""
    for ch in str(s).upper():
        g = _FONT.get(ch, _FONT[' '])
        for r in range(7):
            for c in range(5):
                if g[r][c] == '#':
                    for dy in range(scale):
                        for dx in range(scale):
                            px, py = x + c*scale + dx, y + r*scale + dy
                            if 0 <= px < img.shape[1] and 0 <= py < img.shape[0]:
                                img[py, px] = color
        x += 6 * scale
    return x

def _hline(img, x0, x1, y, color, lw=1):
    for dy in range(lw):
        yy = y + dy
        if 0 <= yy < img.shape[0]:
            img[yy, int(x0):int(x1)+1] = color

def _vline(img, x, y0, y1, color, lw=1):
    for dx in range(lw):
        xx = int(x) + dx
        if 0 <= xx < img.shape[1]:
            img[int(y0):int(y1)+1, xx] = color

def _mappy(v, lo, hi, y0, y1):
    return y1 - (v - lo) / (hi - lo) * (y1 - y0)

def _niceticks(lo, hi, n=5):
    span = hi - lo
    if span <= 0:
        return [lo]
    raw = span / max(n - 1, 1)
    mag = 10.0 ** np.floor(np.log10(raw))
    norm = raw / mag
    if norm < 1.5: step = 1.0 * mag
    elif norm < 3.5: step = 2.0 * mag
    elif norm < 7.5: step = 5.0 * mag
    else: step = 10.0 * mag
    out = []
    v = np.ceil(lo / step) * step
    while v <= hi + 1e-9:
        out.append(v); v += step
    return out

def _plotxy(img, xs, ys_screen, x0, x1, y0, y1, lo, hi, color, lw=2, dashed=False):
    n = len(xs)
    for i in range(n - 1):
        if dashed and i % 2:
            continue
        X0 = int(x0 + (xs[i] - lo) / (hi - lo) * (x1 - x0))
        X1 = int(x0 + (xs[i+1] - lo) / (hi - lo) * (x1 - x0))
        Y0 = int(ys_screen[i]); Y1 = int(ys_screen[i+1])
        steps = max(abs(X1 - X0), abs(Y1 - Y0), 1)
        for s in range(steps + 1):
            t = s / steps
            xx = int(X0 + (X1 - X0) * t); yy = int(Y0 + (Y1 - Y0) * t)
            for dy in range(-lw // 2, lw // 2 + 1):
                for dx in range(-lw // 2, lw // 2 + 1):
                    px, py = xx + dx, yy + dy
                    if x0 <= px <= x1 and y0 <= py <= y1:
                        img[py, px] = color

def _fmt(v):
    if abs(v) >= 100: return "%.0f" % v
    if abs(v) >= 10:  return "%.1f" % v
    return "%.2f" % v

def _write_png(path, rgb):
    H, W, _ = rgb.shape
    def chunk(typ, data):
        return struct.pack('>I', len(data)) + typ + data + \
               struct.pack('>I', zlib.crc32(typ + data) & 0xffffffff)
    raw = bytearray()
    for y in range(H):
        raw.append(0)                 # filter type 0 per scanline
        raw.extend(rgb[y,:,0].tobytes()); raw.extend(rgb[y,:,1].tobytes())
        raw.extend(rgb[y,:,2].tobytes())
    sig = b'\x89PNG\r\n\x1a\n'
    ihdr = struct.pack('>IIBBBBB', W, H, 8, 2, 0, 0, 0)
    with open(path, 'wb') as fh:
        fh.write(sig + chunk(b'IHDR', ihdr) +
                 chunk(b'IDAT', zlib.compress(bytes(raw), 9)) + chunk(b'IEND', b''))

