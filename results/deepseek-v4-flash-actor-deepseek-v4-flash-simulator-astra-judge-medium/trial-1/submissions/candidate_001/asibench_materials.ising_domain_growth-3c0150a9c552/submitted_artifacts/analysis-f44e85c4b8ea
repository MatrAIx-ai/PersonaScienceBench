    draw_text(cnv, "SNAPSHOTS: %s   LX: %s" %
              (",".join(str(int(x)) for x in usable_snaps),
               ",".join("%.2f" % x for x in collapse_lengths)), 34, 1136, 2, (0, 0, 0))

    lines = [
