def _text_width(txt, scale):
    return sum((3 + 1) for _ in txt) * scale

def draw_text(cnv, txt, x, y, scale, color):
    H, W, _ = cnv.shape
    txt = txt.upper()
    cx = x
    for ch in txt:
        g = _GLYPH.get(ch, _GLYPH[" "])
        for row_i, row in enumerate(g):
            for col_i, bit in enumerate(row):
                if bit == "1":
                    px = cx + col_i * scale
                    py = y + row_i * scale
                    for dyy in range(scale):
                        for dxx in range(scale):
                            yy, xx = py + dyy, px + dxx
                            if 0 <= yy < H and 0 <= xx < W:
                                cnv[yy, xx] = color
        cx += 4 * scale
    return int(cx)

def draw_hline(cnv, x0, x1, y, color, th=1):
    H, W, _ = cnv.shape
    for xx in range(int(x0), int(x1)):
        for d in range(th):
            yy = int(y) + d
            if 0 <= yy < H and 0 <= xx < W:
                cnv[yy, xx] = color

def draw_vline(cnv, x, y0, y1, color, th=1):
    H, W, _ = cnv.shape
    for yy in range(int(y0), int(y1)):
        for d in range(th):
            xx = int(x) + d
            if 0 <= yy < H and 0 <= xx < W:
                cnv[yy, xx] = color

def draw_plot_frame(cnv, x, y, w, h, xtitle, ytitle, title):
    black = (0, 0, 0)
    draw_hline(cnv, x, x + w, y, black, 2)
    draw_hline(cnv, x, x + w, y + h, black, 2)
    draw_vline(cnv, x, y, y + h, black, 2)
    draw_vline(cnv, x + w, y, y + h, black, 2)
    for k in range(1, 5):                 # tick marks
        tx = x + int(w * k / 5)
        draw_vline(cnv, tx, y + h, y + h + 6, black, 2)
        ty = y + int(h * k / 5)
        draw_hline(cnv, x - 6, x, ty, black, 2)
    draw_text(cnv, title, x, y - 16, 2, (0, 0, 0))
    draw_text(cnv, ytitle, x - 8, y + h + 10, 2, (0, 0, 0))
    draw_text(cnv, xtitle, x + w - _text_width(xtitle, 2), y + h + 10, 2, (0, 0, 0))

def _tval(v, log):
    return float(np.log(v)) if log else float(v)

def draw_series(cnv, x, y, w, h, xs, ys, color, logx, logy, xlim, ylim, style="p"):
    if logx: xlo, xhi = np.log(np.array(xlim, float))
    else:    xlo, xhi = float(xlim[0]), float(xlim[1])
    if logy: ylo, yhi = np.log(np.array(ylim, float))
    else:    ylo, yhi = float(ylim[0]), float(ylim[1])
    pts = []
    for a, b in zip(xs, ys):
        if a <= 0 or b <= 0:
            continue
        u = _tval(a, logx); v = _tval(b, logy)
        u = (u - xlo) / (xhi - xlo); v = (v - ylo) / (yhi - ylo)
        if 0.0 <= u <= 1.0 and 0.0 <= v <= 1.0:
            pts.append((int(x + u * w), int(y + (1 - v) * h)))
    if not pts:
        return
    if style == "l":
        for p, q in zip(pts[:-1], pts[1:]):
            draw_hline(cnv, p[0], q[0], p[1], color, 2)
    for p in pts:
        for dyy in range(3):
            for dxx in range(3):
                cnv[p[1] + dyy, p[0] + dxx] = color

def draw_image_panel(cnv, x, y, w, h, arr, title):
    draw_plot_frame(cnv, x, y, w, h, "", "", title)
    n = arr.shape[0]
    for i in range(n):
        for j in range(n):
            v = int(arr[i, j])
            col = (230, 60, 60) if v > 0 else (60, 90, 220)
            px = x + (j * w) // n
            py = y + (i * h) // n
            px2 = x + ((j + 1) * w) // n
            py2 = y + ((i + 1) * h) // n
            for yy in range(py, py2):
                for xx in range(px, px2):
                    if 0 <= yy < cnv.shape[0] and 0 <= xx < cnv.shape[1]:
                        cnv[yy, xx] = col

def _png_chunk(tag, data):
    ch = struct.pack(">I", len(data)) + tag + data
    ch += struct.pack(">I", zlib.crc32(tag + data) & 0xFFFFFFFF)
    return ch

def write_png(path, img):
    H, W, _ = img.shape
    raw = bytearray()
    for i in range(H):
        raw.append(0)                              # filter type 0 (None)
        raw.extend(img[i, :, :].tobytes())
    def chunk(tag, data):
        c = struct.pack(">I", len(data)) + tag + data
        return c + struct.pack(">I", zlib.crc32(tag + data) & 0xFFFFFFFF)
    png = (b"\x89PNG\r\n\x1a\n" +
           chunk(b"IHDR", struct.pack(">IIBBBBB", W, H, 8, 2, 0, 0, 0)) +
           chunk(b"IDAT", zlib.compress(bytes(raw), 6)) +
           chunk(b"IEND", b""))
    with open(path, "wb") as f:
        f.write(png)

def build_numpy_figure(initial, final_state, mt, seriesA, seriesB, stackC, sn,
                       tt, exponent, amplitude, fit_range, r_squared,
                       usable_snaps, x_grid, curves, mean_curve, spread,
                       collapse_quality, collapse_relative_rms_spread,
                       collapse_lengths, exponent_std_error):
    W, H = 1280, 1240
    cnv = np.full((H, W, 3), 255, dtype=np.uint8)
    black = (0, 0, 0); blue = (30, 60, 200); red = (200, 30, 30)
    green = (20, 150, 60); gray = (90, 90, 90)
    draw_text(cnv, "ISING DOMAIN-GROWTH DIAGNOSTICS  T = 2.0236 < TC  GLAUBER 2D RANDOM-SEQ",
              20, 12, 3, (0, 0, 0))
    draw_text(cnv, "Z = %.4f  SE = %.5f  A = %.4f  R2 = %.4f  COLLAPSE Q = %.3f" %
              (exponent, exponent_std_error, amplitude, r_squared,
               collapse_quality if collapse_quality is not None else 0.0),
              20, 40, 2, (0, 0, 0))
    draw_text(cnv, "FIT RANGE [%d,%d]   N_FIT = %d" %
              (int(fit_range[0]), int(fit_range[1]), int(tt.size)), 20, 60, 2, (0, 0, 0))

    draw_image_panel(cnv, 30, 90, 290, 290, initial, "A: INITIAL STATE T=0")
    draw_image_panel(cnv, 380, 90, 290, 290, final_state, "B: FINAL STATE T=%d" % int(t))

    emin, emax = float(seriesA[1].min()), float(seriesA[1].max())
    draw_plot_frame(cnv, 700, 90, 540, 130, "T (MCS)", "|M|", "C1: |M|(T)")
    draw_series(cnv, 700, 90, 540, 130, mt, seriesA[0], blue, True, False,
                [4, 13000], [0.0, 1.05], "p")
    draw_plot_frame(cnv, 700, 240, 540, 130, "T (MCS)", "E", "C2: ENERGY E(T)")
    draw_series(cnv, 700, 240, 540, 130, mt, seriesA[1], red, True, False,
