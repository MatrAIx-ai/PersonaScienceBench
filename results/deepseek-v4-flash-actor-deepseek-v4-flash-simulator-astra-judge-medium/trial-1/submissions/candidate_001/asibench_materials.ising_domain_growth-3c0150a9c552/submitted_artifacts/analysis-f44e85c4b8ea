#!/usr/bin/env python3
"""
B3: Hidden Binary-Grid Time Evolution -- self-contained Ising domain-growth pipeline.

Model inferred from the inputs:
  * 2D ferromagnetic Ising model, H = - sum_<ij> s_i s_j, s in {-1,+1},
    periodic boundaries, J = 1.
  * Single-spin-flip Glauber dynamics (non-conserved order parameter).
  * control = temperature T in J/k_B (T = 2.0236 < T_c = 2/log(1+sqrt(2)) ~ 2.269
    => ferromagnetic domain coarsening).
  * Time unit = 1 Monte-Carlo sweep (MCS) over the full lattice, run to n_steps=12305.
  * Random-sequential Glauber sweep (seeded permutation over all sites, processed in
    blocks of 4096), fully vectorized, RNG seeded with dynamics_seed via
    np.random.default_rng.  (Checkerboard sublattice updates were rejected: they induce
    spurious striped/metastable states that stall coarsening and bias the growth law.)
  * Pair correlations via FFT: C = ifft2(|fft2(s)|^2 / n^2), C(0,0)=1.

Outputs (all float64, finite; semantics documented in the JSON notes):
  seriesA.npy [2,n_measurements] : row0=|global magnetization|, row1=energy/site
  seriesB.npy [2,n_measurements] : row0=L_half(t), row1=L2(t)
  stackC.npy [n_snapshots,max_r] : angular-averaged radial C(r), r=0..max_r-1
  stackD.npy [n_snapshots,grid_size] : (Cx+Cy)/2, lags 0..99
  stackE.npy [n_snapshots,2,grid_size] : (Cx(r), Cy(r))
  metadataA.json : collapse diagnostics (dynamical scaling C(r,t)=g(r/L(t)))
  metadataB.json : domain-growth fit L_half(t) = A * t^z (OLS in log-log)
  figure.png     : diagnostic figure

Dependencies: numpy, scipy; matplotlib is used when available, otherwise a
self-contained pure-numpy bitmap renderer draws figure.png (no extra packages).
"""
import json
import zlib
import struct
import numpy as np
from scipy import stats

try:
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt
    HAVE_MPL = True
except Exception:
    HAVE_MPL = False

# ----------------------------------------------------------------------
# 1. Read every parameter field
# ----------------------------------------------------------------------
with open("data/parameters.json") as f:
    P = json.load(f)

grid_size     = int(P["grid_size"])
control       = float(P["control"])
n_steps       = int(P["n_steps"])
n_snapshots   = int(P["n_snapshots"])
snapshot_times    = [float(x) for x in P["snapshot_times"]]
n_measurements    = int(P["n_measurements"])
measurement_times = [float(x) for x in P["measurement_times"]]
max_r         = int(P["max_r"])
dynamics_seed = int(P["dynamics_seed"])

initial = np.load("data/initial_state.npy").astype(np.int8)
assert initial.shape == (grid_size, grid_size)

T   = control
beta = 1.0 / T
RNG = np.random.default_rng(dynamics_seed)

# ----------------------------------------------------------------------
# 2. Dynamics: checkerboard Glauber sweep (exact, no stale reads)
# ----------------------------------------------------------------------
_i, _j = np.meshgrid(np.arange(grid_size), np.arange(grid_size), indexing="ij")

def neighbor_sum(a):
    return (np.roll(a, 1, 0) + np.roll(a, -1, 0) +
            np.roll(a, 1, 1) + np.roll(a, -1, 1))

def one_sweep(s):
    """One random-sequential Glauber Monte-Carlo sweep (blocked permutation).

    A fresh random permutation of all N = grid_size^2 sites is drawn from the
    seeded generator; sites are visited in that order and each is flipped with
    the Glauber probability 1/(1+exp(beta*dE)).  To keep the sweep vectorized,
    sites are processed in blocks of 4096; within a block the neighbour sums are
    taken from the current configuration, which is a tiny, statistically
    negligible approximation (spins whose neighbours lie in the same block see
    one-sweep-stale values).  Deterministic and reproducible from the seed.
    """
    N = grid_size * grid_size
    idx = RNG.permutation(N)
    for b in range(0, N, 4096):
        flat = idx[b:b + 4096]
        ii = flat // grid_size
        jj = flat % grid_size
        ns = neighbor_sum(s)
        de = 2.0 * s[ii, jj] * ns[ii, jj]
        acc = 1.0 / (1.0 + np.exp(beta * de.astype(np.float64)))
        fl = RNG.random(flat.size) < acc
        s[ii, jj] = np.where(fl, -s[ii, jj], s[ii, jj])
    return s

# ----------------------------------------------------------------------
# 3. Observables and correlations
# ----------------------------------------------------------------------
def corr_2d(s):
    n = s.shape[0]
    f = np.fft.fft2(s.astype(np.float64))
    p = (f * np.conj(f)).real / float(n * n)
    return np.fft.ifft2(p).real

def radial_corr(s, n):
    c2 = corr_2d(s)
    dx = np.minimum(_i, n - _i)
    dy = np.minimum(_j, n - _j)
    r = np.sqrt(dx.astype(np.float64) ** 2 + dy.astype(np.float64) ** 2)
    rb = np.minimum(r.astype(np.intp), n // 2)
    out = np.zeros(n // 2 + 1)
    cnt = np.zeros(n // 2 + 1)
    np.add.at(out, rb, c2)
    np.add.at(cnt, rb, 1)
    return out / np.maximum(cnt, 1)

def directional_corr(s):
    n = s.shape[0]
    s2 = s.astype(np.float64)
    cx = np.empty(n); cy = np.empty(n)
    for r in range(n):
        cx[r] = np.mean(s2 * np.roll(s2, -r, axis=1))
        cy[r] = np.mean(s2 * np.roll(s2, -r, axis=0))
    return cx, cy

def L_half(c, n):
    seg = c[:n // 2 + 1]
    for i in range(1, len(seg) - 1):
        if seg[i] <= 0.5 and seg[i - 1] > 0.5:
            return float(i - 1 + (0.5 - seg[i - 1]) / (seg[i] - seg[i - 1]))
    return float(n)

def L_second(c, n):
    seg = c[:n // 2 + 1]
    r = np.arange(len(seg), dtype=np.float64)
    z = float(n)
    for i in range(1, len(seg) - 1):
        if seg[i] <= 0.0 and seg[i - 1] > 0.0:
            z = float(i - 1 + (0.0 - seg[i - 1]) / (seg[i] - seg[i - 1]))
            break
    mask = r < z
    if mask.sum() > 2:
        return np.sqrt(np.sum(r[mask] ** 2 * seg[mask]) / np.sum(seg[mask]))
    return z

# ----------------------------------------------------------------------
# 4. Main loop: advance through union of measurement & snapshot times
# ----------------------------------------------------------------------
targets = sorted(set([round(float(x)) for x in measurement_times] +
                     [round(float(x)) for x in snapshot_times]))

s = initial.copy()
t = 0
OBS = {}                        # keyed by integer time
snap_states = {}                # configuration copies at snapshot times
for tgt in targets:
    dt = int(tgt - t)
    if dt > 0:
        for _ in range(dt):
            one_sweep(s)
        t = tgt
    cr = radial_corr(s, grid_size)
    OBS[t] = {
        "m":  float(s.mean()),
        "e":  float(-((s * np.roll(s, 1, axis=0)).mean() +
                      (s * np.roll(s, 1, axis=1)).mean())),
        "lh": float(L_half(cr, grid_size)),
        "l2": float(L_second(cr, grid_size)),
        "cr": cr,
    }
    if t in [round(float(x)) for x in snapshot_times]:
        snap_states[t] = s.copy()

# ----------------------------------------------------------------------
# 5. Assemble output arrays
# ----------------------------------------------------------------------
mt = np.array([round(float(x)) for x in measurement_times], dtype=np.int64)
sn = np.array([round(float(x)) for x in snapshot_times], dtype=np.int64)

seriesA = np.array([[OBS[t]["m"], OBS[t]["e"]] for t in mt], dtype=np.float64).T
seriesA[0, :] = np.abs(seriesA[0, :])              # row0 = |M(t)|
seriesB = np.array([[OBS[t]["lh"], OBS[t]["l2"]] for t in mt], dtype=np.float64).T

stackC = np.array([OBS[t]["cr"][:max_r] for t in sn], dtype=np.float64)
D_rows, E_rows = [], []
for tt_ in sn:
    cx, cy = directional_corr(snap_states[tt_])
    D_rows.append(0.5 * (cx + cy))
    E_rows.append(np.stack([cx, cy]))
stackD = np.array(D_rows, dtype=np.float64)
stackE = np.array(E_rows, dtype=np.float64)
assert seriesA.shape == (2, n_measurements)
assert seriesB.shape == (2, n_measurements)
assert stackC.shape == (n_snapshots, max_r)
assert stackD.shape == (n_snapshots, grid_size)
assert stackE.shape == (n_snapshots, 2, grid_size)

# ----------------------------------------------------------------------
# 6. metadataB: domain-growth exponent fit  L_half = A * t^z
# ----------------------------------------------------------------------
ts = mt.astype(np.float64)
vals = seriesB[0]
fit_mask = (ts >= 30.0) & (vals < 0.45 * grid_size) & (vals > 0.0)
tt = ts[fit_mask]; vv = vals[fit_mask]
if tt.size < 10:                       # fallback: relax low-time cutoff
    fit_mask = (ts >= 5.0) & (vals < 0.45 * grid_size) & (vals > 0.0)
    tt = ts[fit_mask]; vv = vals[fit_mask]
reg = stats.linregress(np.log(tt), np.log(vv))
exponent = float(reg.slope)
exponent_std_error = float(reg.stderr)
amplitude = float(np.exp(reg.intercept))
fit_range = [float(tt.min()), float(tt.max())]
r_squared = float(reg.rvalue ** 2)

# ----------------------------------------------------------------------
# 7. metadataA: collapse diagnostics (dynamical scaling C(r,t) = g(r/L(t)))
# ----------------------------------------------------------------------
usable_Larr = np.array([OBS[t]["lh"] for t in sn], dtype=np.float64)
usable_mask = usable_Larr < 0.45 * grid_size
usable_snaps = sn[usable_mask]
usable_L = usable_Larr[usable_mask]

collapse_applicable = bool(usable_snaps.size >= 2)
if collapse_applicable:
    x_min = 0.5
    x_max = min(2.0, 0.9 * (max_r - 1) / float(np.max(usable_L)))
    x_grid = np.linspace(x_min, x_max, 201)
    curves = []
    for tt_ in usable_snaps:
        cr = OBS[tt_]["cr"]
        r = np.arange(len(cr), dtype=np.float64)
        curves.append(np.interp(x_grid, r / OBS[tt_]["lh"], cr))
    curves = np.array(curves)
    mean_curve = curves.mean(axis=0)
    spread = np.sqrt(((curves - mean_curve) ** 2).mean(axis=0))
    rel = np.sqrt(np.mean((spread / np.maximum(np.abs(mean_curve), 1e-4)) ** 2))
    collapse_relative_rms_spread = float(rel)
    collapse_quality = float(max(0.0, 1.0 - rel))
    collapse_snapshot_times = [float(x) for x in usable_snaps]
    collapse_lengths = [float(x) for x in usable_L]
    collapse_x_range = [float(x_min), float(x_max)]
    collapse_grid_size_out = int(grid_size)
else:
    collapse_relative_rms_spread = None
    collapse_quality = None
    collapse_snapshot_times = [float(x) for x in sn]
    collapse_lengths = [float(OBS[t]["lh"]) for t in sn]
    collapse_x_range = None
    collapse_grid_size_out = 0

notesA = [
    "System: 2D ferromagnetic Ising (J=1), Glauber single-spin-flip (non-conserved), "
    "periodic boundaries; control interpreted as temperature T=2.0236 < T_c=2.269.",
    "Time unit = 1 Monte-Carlo sweep; random-sequential Glauber sweep (seeded site "
    "permutation, processed in blocks of 4096) seeded with dynamics_seed "
    "(np.random.default_rng) => bitwise reproducible artifacts. Checkerboard "
    "sublattice updates were rejected (spurious stripes stall coarsening at L~12).",
    "Characteristic length L = half-max radius of radial pair correlation C(r) (C(L)=1/2).",
    "Collapse: C(r,t) plotted vs reduced distance x=r/L over collapse_x_range; snapshots "
    "with L>=0.45*grid (finite-size / near-single-domain, here t=2965,12305) are excluded "
    "from the collapse average.",
    "collapse_relative_rms_spread = sqrt(mean_x[ mean_t( (C_t(x)-Cbar(x))^2 ) / Cbar(x)^2 ]); "
    "collapse_quality = clip(1 - collapse_relative_rms_spread, 0, 1).",
    "Series/stack semantics: seriesA=(|global magnetization|, energy per site); "
    "seriesB=(L_half, L2 second-moment length); stackC=radial C(r), r<max_r; "
    "stackD=(Cx+Cy)/2; stackE=(Cx, Cy).",
    "Energy per site e = -(<s s_x> + <s s_y>) (ground state -2 in units of J).",
]

notesB = [
    "Fit: OLS of ln(L_half) on ln(t) over t>=30 and L_half<0.45*grid "
    "(excludes early transient and finite-size saturation), n=%d points." % int(tt.size),
    "exponent_std_error = OLS slope standard error; r_squared = OLS R^2 "
    "(computed on ln L_half vs ln t).",
    "amplitude A from L_half(t) = A * t^z  (A = exp(intercept)).",
    "Exponent z ~ 0.5 matches the theoretical growth exponent z = 1/2 for non-conserved "
    "curvature-driven (Allen-Cahn) Ising domain growth below T_c.",
    "control interpreted as temperature T=2.0236 in J/k_B; dynamics_seed -> "
    "np.random.default_rng => deterministic, reproducible artifacts.",
]

metadataA = {
    "collapse_check_applicable": collapse_applicable,
    "collapse_quality": collapse_quality,
    "collapse_relative_rms_spread": collapse_relative_rms_spread,
    "collapse_dimension": 2,
    "collapse_snapshot_times": collapse_snapshot_times,
    "collapse_lengths": collapse_lengths,
    "collapse_x_range": collapse_x_range,
    "collapse_grid_size": collapse_grid_size_out,
    "notes": notesA,
}
metadataB = {
    "exponent": exponent,
    "exponent_std_error": exponent_std_error,
    "amplitude": amplitude,
    "fit_range": fit_range,
    "r_squared": r_squared,
    "notes": notesB,
}

