"""Validation harness (dev only, not the submitted artifact)."""
import json, math, heapq, collections, random
import analysis

random.seed(0)

def load(name):
    return json.load(open(name))

ACTION_ORDER = analysis.ACTION_ORDER
DELTA = analysis.DELTA

# ---------------------------------------------------------------- (a) sanity
def reconstruction_stats(levels):
    bad = 0; stay_ff = stay_fb = turn_ff = turn_fb = 0; n = 0
    for lv in levels:
        G, rows, cols = lv['grid'], len(lv['grid']), len(lv['grid'][0])
        pos = list(lv['start']); prev = None
        for a in lv['solution']:
            y, x = pos
            if not (0 <= y < rows and 0 <= x < cols and G[y][x] != '#'):
                bad += 1; break
            free = set()
            for dn in ACTION_ORDER:
                dy, dx = DELTA[dn]; ny, nx = y + dy, x + dx
                if 0 <= ny < rows and 0 <= nx < cols and G[ny][nx] != '#':
                    free.add(dn)
            if prev is not None:
                ff = prev in free
                if a == prev:
                    (stay_ff if ff else stay_fb.__class__ ) # noop
                    if ff: stay_ff += 1
                    else: stay_fb += 1
                else:
                    if ff: turn_ff += 1
                    else: turn_fb += 1
            n += 1
            pos = [y + DELTA[a][0], x + DELTA[a][1]]; prev = a
    return bad, stay_ff, stay_fb, turn_ff, turn_fb, n

# ---------------------------------------------------------------- (b) imitation
def make_state_from_obs(obs, prev, history, depth):
    """Build a plausible scorer state dict from an observation and search context."""
    free = [a for a in ACTION_ORDER if (obs['mask'] >> ACTION_ORDER.index(a)) & 1]
    return dict(
        cell=obs['cell'],
        neighbors=list(obs['neighbors']),
        legal_mask=[(obs['mask'] >> i) & 1 for i in range(4)],
        legal_actions=free,
        previous_action=prev,
        history=list(history),
        history_tail=list(history[-5:]) if history else [],
        run_length_bucket=obs['run_len'],
        depth=depth, depth_mod=depth % 4, depth_phase=depth // 5,
    )

def top1_acc(policy, levels):
    ok = tot = 0
    for lv in levels:
        G, rows, cols = lv['grid'], len(lv['grid']), len(lv['grid'][0])
        pos = list(lv['start']); hist = []
        depth = 0
        for a in lv['solution']:
            y, x = pos
            nbr = []
            for dn in ACTION_ORDER:
                dy, dx = DELTA[dn]; ny, nx = y + dy, x + dx
                nbr.append(G[ny][nx] if 0 <= ny < rows and 0 <= nx < cols and G[ny][nx] != '#' else '#')
            obs = dict(cell=G[y][x], neighbors=tuple(nbr),
                       mask=analysis._mask_from_legal([dn for dn in ACTION_ORDER if nbr[ACTION_ORDER.index(dn)] != '#']),
                       run_len=1, depth=depth)
            prev = hist[-1] if hist else None
            # reconstruct run length
            obs['run_len'] = 1
            for k in range(len(hist) - 1, -1, -1):
                if hist[k] == prev:
                    obs['run_len'] += 1
                else:
                    break
            st = make_state_from_obs(obs, prev, hist, depth)
            free = [dn for dn in ACTION_ORDER if nbr[ACTION_ORDER.index(dn)] != '#']
            p = policy.action_probs(lv, st, free)
            pred = max(free, key=lambda dn: p.get(dn, 0.0))
            ok += (pred == a); tot += 1
            hist.append(a)
            pos = [y + DELTA[a][0], x + DELTA[a][1]]; depth += 1
    return ok / tot if tot else 0.0, tot

# ---------------------------------------------------------------- (c) proxy search
def neighbors_free(G, rows, cols, pos):
    y, x = pos; free = []
    for dn in ACTION_ORDER:
        dy, dx = DELTA[dn]; ny, nx = y + dy, x + dx
        if 0 <= ny < rows and 0 <= nx < cols and G[ny][nx] != '#':
            free.append(dn)
    return free

def state_at(G, pos, path):
    rows, cols = len(G), len(G[0]); y, x = pos
    nbr = []
    for dn in ACTION_ORDER:
        dy, dx = DELTA[dn]; ny, nx = y + dy, x + dx
        nbr.append(G[ny][nx] if 0 <= ny < rows and 0 <= nx < cols and G[ny][nx] != '#' else '#')
    free = [dn for dn in ACTION_ORDER if nbr[ACTION_ORDER.index(dn)] != '#']
    prev = path[-1] if path else None
    run = 1
    for k in range(len(path) - 1, -1, -1):
        if path[k] == prev: run += 1
        else: break
    return dict(cell=G[y][x], neighbors=nbr, legal_mask=[n != '#' for n in nbr],
                previous_action=prev, history=list(path), history_tail=list(path[-5:]),
                run_length_bucket=run, depth=len(path), depth_mod=len(path) % 4,
                depth_phase=len(path) // 5), free

def bestfirst(policy, lv, cap=200000):
    G, rows, cols = lv['grid'], len(lv['grid']), len(lv['grid'][0])
    start, goal = tuple(lv['start']), tuple(lv['goal'])
    heap = [(0.0, start, ())]; seen = {(start, ())}; exp = 0
    while heap:
        nlp, pos, path = heapq.heappop(heap)
        if pos == goal: return exp, path
        exp += 1
        st, free = state_at(G, pos, path)
        probs = policy.action_probs(lv, st, free)
        y, x = pos
        for a in free:
            dy, dx = DELTA[a]; np_ = (y + dy, x + dx); npath = path + (a,)
            key = (np_, npath)
            if key in seen: continue
            seen.add(key)
            p = probs.get(a, 0.0)
            if p > 0:
                heapq.heappush(heap, (nlp - math.log(p), np_, npath))
        if exp > cap: return None, path
    return None, path

def bestfirst_cellmerge(policy, lv, cap=200000):
    G, rows, cols = lv['grid'], len(lv['grid']), len(lv['grid'][0])
    start, goal = tuple(lv['start']), tuple(lv['goal'])
    best = {start: 0.0}; heap = [(0.0, start, ())]; expanded = set(); exp = 0
    while heap:
        nlp, pos, path = heapq.heappop(heap)
        if pos in expanded: continue
        expanded.add(pos); exp += 1
        if pos == goal: return exp, path
        st, free = state_at(G, pos, path)
        probs = policy.action_probs(lv, st, free)
        y, x = pos
        for a in free:
            dy, dx = DELTA[a]; np_ = (y + dy, x + dx)
            if np_ in expanded: continue
            newnlp = nlp - math.log(probs.get(a, 1e-12))
            if newnlp < best.get(np_, float('inf')):
                best[np_] = newnlp
                heapq.heappush(heap, (newnlp, np_, path + (a,)))
        if exp > cap: return None, path
    return None, path

def guided_dfs(policy, lv, cap=10 ** 7):
    G, rows, cols = lv['grid'], len(lv['grid']), len(lv['grid'][0])
    start, goal = tuple(lv['start']), tuple(lv['goal'])
    visited = {start}; stack = [(start, None)]; path = []; exp = 0
    while stack:
        pos, prev = stack[-1]
        if pos == goal: return exp, list(path)
        st, free = state_at(G, pos, path)
        probs = policy.action_probs(lv, st, free)
        best = None; bp = -1.0
        y, x = pos
        for a in free:
            dy, dx = DELTA[a]; np_ = (y + dy, x + dx)
            if np_ not in visited and probs.get(a, 0.0) > bp:
                best = (a, np_); bp = probs.get(a, 0.0)
        if best is None:
            stack.pop()
            if path: path.pop()
            continue
        a, np_ = best
        visited.add(np_); exp += 1; path.append(a); stack.append((np_, a))
        if exp > cap: return None, None
    return None, None

# ===================================================================== main
if __name__ == "__main__":
    tr = load('data/training_levels.json')
    ev = load('data/public_eval_levels.json')
    trl, evl = tr['levels'], ev['levels']
    budget = ev['budget']

    print("== (a) reconstruction sanity (ALL training) ==")
    bad, sff, sfb, tff, tfb, n = reconstruction_stats(trl)
    print("  wall collisions:", bad, " steps:", n)
    print("  stay|forward_free=%d, stay|forward_blocked=%d, turn|forward_free=%d, turn|forward_blocked=%d"
          % (sff, sfb, tff, tfb))
    print("  stay rate=%.4f" % ((sff) / (sff + tfb + tff + sfb)))

    print("\n== (b) held-out imitation (train 80% / test 20% of levels) ==")
    random.shuffle(trl)
    cut = int(0.8 * len(trl))
    tr_train, tr_test = trl[:cut], trl[cut:]
    pol = analysis.make_policy({'levels': tr_train})
    acc, tot = top1_acc(pol, tr_test)
    print("  top1 next-action accuracy on %d held-out steps: %.4f" % (tot, acc))

    # baseline: always continue previous action if legal
    def baseline_acc(levels):
        ok = tot = 0
        for lv in levels:
            G, rows, cols = lv['grid'], len(lv['grid']), len(lv['grid'][0])
            pos = list(lv['start']); prev = None
            for a in lv['solution']:
                y, x = pos
                if prev is not None and prev in [dn for dn in ACTION_ORDER if
                    0 <= y + DELTA[dn][0] < rows and 0 <= x + DELTA[dn][1] < cols and
                    G[y + DELTA[dn][0]][x + DELTA[dn][1]] != '#']:
                    pred = prev
                else:
                    pred = None
                ok += (pred == a); tot += 1
                pos = [y + DELTA[a][0], x + DELTA[a][1]]; prev = a
        return ok / tot
    print("  baseline 'stay-if-open' accuracy: %.4f" % baseline_acc(tr_test))

    print("\n== (c) proxy search on 4 public eval levels (budget=%d) ==" % budget)
    print("  model                   ", " ".join(lv['id'] for lv in evl))
    rows = []
    for name, fn in [("best-first(path-dedup)", bestfirst),
                     ("best-first(cell-merge)", bestfirst_cellmerge),
                     ("greedy position-DFS  ", guided_dfs)]:
        row = []
        for lv in evl:
            exp, path = fn(pol, lv)
            row.append("%d%s" % (exp if exp is not None else -1, " *" if (exp is not None and exp <= budget) else ""))
        print("  %-22s %s" % (name, " ".join(r.rjust(12) for r in row)))

    print("\n== (d) representative action_probs ==")
    st = dict(cell='q', neighbors=['b','c','d','e'], previous_action='U',
              history=['U','U','U'], history_tail=['U','U','U'], run_length_bucket=3,
              depth=10, depth_mod=2, depth_phase=2, legal_mask=[True]*4)
    p = pol.action_probs(evl[0], st, ['U','D','L','R'])
    print("  full state, all open, prev=U:", {k: round(v, 4) for k, v in p.items()})
