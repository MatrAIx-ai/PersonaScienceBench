"""
analysis.py -- ASI-Bench "math.levin_context_grid_search"

Learns an action-prior model from solved grid-search training levels and
serves it to a hidden Levin-style guided search through:

    make_policy(training_data, config=None) -> policy
    policy.action_probs(level, state, legal_actions) -> dict[str, float]

The training file only stores the aggregate solution action sequence per
level together with the static grid, so we reconstruct per-step *local*
observations by simulating each solution under the verified coordinate
convention (grid[row][col]; U = row-1, D = row+1, L = col-1, R = col+1).

Verified facts used by the model (from the training data, 6464 steps):
  * with probability ~0.938 the agent continues the previous action;
  * if the cell ahead in the current direction is open the agent continues
    with probability 1.00 (5819/5819), and if it is a wall the agent turns
    with probability 1.00 (385/385) -- never turn with a clear forward,
    never walk into a wall, never immediately reverse;
  * turns are perpendicular and symmetric (prev U/D -> turn L/R ~50/50,
    prev L/R -> turn U/D ~50/50);
  * run-length has a mild effect (stay-rate decays towards ~0.73 at long
    runs) and depth/phase has little structure;
  * tile letters carry ~0 mutual information with the next action (kept
    only as very weak "relative tile" features).

The model is a weighted log-linear combination of Laplace-smoothed
conditional frequency tables (weighted compound local contexts):
    log P(a) ~ w1*log P1(a|prev, wallmask) + w2*log P2(a|wallmask, runlen)
             + w3*log P3(a|wallmask, depth_phase) + w4*log P4(a|cell, neighbors)
             + w0*log P0(a)
It is a sharp persistence prior with a small exploration floor, and it is
fully self-contained (pure Python; no external imports).

The `state` dict passed by the scorer may use several serializations of
the observation fields (str / int index / bool list / bitmask / char
list); every field is parsed tolerantly and falls back to the prior when
absent.
"""

import math

ACTION_ORDER = ["U", "D", "L", "R"]
OPPOSITE = {"U": "D", "D": "U", "L": "R", "R": "L"}
DELTA = {"U": (-1, 0), "D": (1, 0), "L": (0, -1), "R": (0, 1)}

RUN_CAP = 8          # run-length bucket values 1..RUN_CAP, RUN_CAP means "RUN_CAP or more"
PHASE_LEN = 5        # depth_phase = depth // PHASE_LEN
PHASE_CAP = 6        # clamp depth phase
SMOOTH = 1.0         # Laplace smoothing strength
FLOOR = 1e-3         # exploration floor per legal action (small)

# ---------------------------------------------------------------------------
# generic helpers
# ---------------------------------------------------------------------------

def _to_action(x):
    """Map a value to one of U/D/L/R, or None."""
    if x is None:
        return None
    if isinstance(x, str):
        s = x.strip().upper()
        if s in ACTION_ORDER:
            return s
        return None
    if isinstance(x, (int, float)):
        i = int(x)
        if 0 <= i < 4:
            return ACTION_ORDER[i]
        return None
    if isinstance(x, (list, tuple)):
        if len(x) == 0:
            return None
        return _to_action(x[-1])
    return None


def _to_run_bucket(x):
    """Tolerant parser for a run-length value / bucket."""
    if x is None:
        return None
    if isinstance(x, bool):
        return None
    if isinstance(x, (int, float)):
        try:
            v = int(x)
        except Exception:
            return None
        if v < 1:
            return None
        return min(v, RUN_CAP)
    if isinstance(x, str):
        s = x.strip()
        try:
            v = int(s)
            return min(max(v, 1), RUN_CAP)
        except ValueError:
            pass
        for tok in s.replace("+", "-").split("-"):
            for ch in tok:
                if ch.isdigit():
                    return min(max(int(ch), 1), RUN_CAP)
        return None
    if isinstance(x, (list, tuple, set, frozenset)):
        nums = [int(v) for v in x if isinstance(v, (int, float)) and not isinstance(v, bool)]
        if len(nums) >= 1:
            return min(max(max(nums), 1), RUN_CAP)
        return None
    if isinstance(x, dict):
        for k in ("value", "bucket", "run_length", "n", "min"):
            if k in x:
                return _to_run_bucket(x[k])
        return None
    return None


def _to_depth(x):
    if x is None:
        return None
    if isinstance(x, bool):
        return None
    try:
        return max(0, int(x))
    except Exception:
        return None


def _as_letter(x):
    """Normalize a tile cell value to a string key."""
    if x is None:
        return "?"
    if isinstance(x, bytes):
        x = x.decode("latin1", "replace")
    if isinstance(x, str):
        return x[0] if len(x) >= 1 else "?"
    if isinstance(x, (int, float)):
        return "i%d" % int(x)
    return "?"

def _mask_from_legal(legal):
    """legal: list of action strings (or int indices) -> 4-bit int mask (U=1,D=2,L=4,R=8)."""
    m = 0
    for a in legal or []:
        act = _to_action(a)
        if act is None:
            continue
        m |= (1 << ACTION_ORDER.index(act))
    return m


def _derive_run_bucket(state, prev):
    """Derive current run length (bucketed) from history/history_tail when not given."""
    ht = state.get("history_tail")
    if ht is None:
        ht = state.get("history")
    if prev is None:
        return None
    if isinstance(ht, str):
        seq = [c for c in ht if c in ACTION_ORDER]
    elif isinstance(ht, (list, tuple)):
        seq = [_to_action(a) for a in ht]
        seq = [a for a in seq if a is not None]
    else:
        return None
    r = 0
    for a in reversed(seq):
        if a == prev:
            r += 1
        else:
            break
    return min(1 + r, RUN_CAP)


def _parse_state(state, legal_actions):
    """Tolerant parse of a scorer `state` dict into a feature dict.

    Returns dict with keys:
      mask       : int 4-bit wall-free mask (U=1,D=2,L=4,R=8)
      prev       : 'U'/'D'/'L'/'R' or None
      run_bucket : int 1..RUN_CAP or None
      depth/phase: int
      cell       : str letter key
      neighbors  : tuple of 4 letter keys in U,D,L,R order
    """
    state = state or {}

    # --- wall mask: trust explicit legal_actions, then state legal_mask, then neighbors ---
    mask = _mask_from_legal(legal_actions)
    lm = state.get("legal_mask")
    if mask == 0 and lm is not None:
        if isinstance(lm, dict):
            m2 = 0
            for k, v in lm.items():
                a = _to_action(k)
                if a is not None and bool(v):
                    m2 |= (1 << ACTION_ORDER.index(a))
            mask = m2
        elif isinstance(lm, (list, tuple)):
            m2 = 0
            for i, v in enumerate(lm):
                if i < 4 and bool(v):
                    m2 |= (1 << i)
            mask = m2
        elif isinstance(lm, (int, float)) and not isinstance(lm, bool):
            mask = int(lm)

    nbr = state.get("neighbors")
    if nbr is not None:
        if isinstance(nbr, dict):
            nbr_map = nbr
        elif isinstance(nbr, (list, tuple)) and len(nbr) >= 4:
            nbr_map = {a: nbr[i] for i, a in enumerate(ACTION_ORDER)}
        else:
            nbr_map = None
        if nbr_map is not None:
            m2 = 0
            for a in ACTION_ORDER:
                v = nbr_map.get(a)
                if isinstance(v, str):
                    ok = (v.strip() != "" and v.strip() != "#")
                elif isinstance(v, (int, float)) and not isinstance(v, bool):
                    ok = int(v) != 0
                else:
                    ok = v is not None
                if ok:
                    m2 |= (1 << ACTION_ORDER.index(a))
            if m2 != 0:
                mask = m2

    # --- previous action ---
    prev = _to_action(state.get("previous_action"))
    if prev is None:
        ht = state.get("history_tail")
        if ht is None:
            ht = state.get("history")
        prev = _to_action(ht)

    # --- run length bucket ---
    run_bucket = _to_run_bucket(state.get("run_length_bucket"))
    if run_bucket is None:
        run_bucket = _derive_run_bucket(state, prev)

    # --- depth fields ---
    depth = _to_depth(state.get("depth"))
    phase = _to_depth(state.get("depth_phase"))
    if phase is None and depth is not None:
        phase = min(depth // PHASE_LEN, PHASE_CAP)
    if phase is None:
        phase = 0

    # --- tiles ---
    cell = _as_letter(state.get("cell"))
    nbrr = state.get("neighbors")
    if isinstance(nbrr, dict):
        neighbors = tuple(_as_letter(nbrr.get(a)) for a in ACTION_ORDER)
    elif isinstance(nbrr, (list, tuple)) and len(nbrr) >= 4:
        neighbors = tuple(_as_letter(nbrr[i]) for i in range(4))
    else:
        neighbors = ("?", "?", "?", "?")

    return dict(mask=mask, prev=prev, run_bucket=run_bucket,
                depth=depth, phase=phase, cell=cell, neighbors=neighbors)

# ---------------------------------------------------------------------------
# training-side reconstruction of per-step local observations
# ---------------------------------------------------------------------------

def _reconstruct(training_levels):
    """Simulate each training solution and yield per-step local observations.

    Each yielded dict: mask (4-bit), prev, action, run_len, depth, phase,
    depth_mod, cell, neighbors (tuple of 4 chars, '#' for wall).
    """
    for lv in training_levels:
        grid = lv["grid"]
        rows = len(grid)
        cols = len(grid[0]) if rows else 0
        pos = list(lv["start"])
        prev = None
        run_len = 0
        for depth, action in enumerate(lv["solution"]):
            y, x = pos
            free = []
            neighbors = []
            for a in ACTION_ORDER:
                dy, dx = DELTA[a]
                ny, nx = y + dy, x + dx
                if 0 <= ny < rows and 0 <= nx < cols and grid[ny][nx] != "#":
                    free.append(a)
                    neighbors.append(grid[ny][nx])
                else:
                    neighbors.append("#")
            if prev == action:
                run_len += 1
            else:
                run_len = 1
            mask = _mask_from_legal(free)
            yield dict(mask=mask, prev=prev, action=action, run_len=run_len,
                       depth=depth, phase=min(depth // PHASE_LEN, PHASE_CAP),
                       cell=grid[y][x], neighbors=tuple(neighbors))
            pos = [y + DELTA[action][0], x + DELTA[action][1]]
            prev = action

# ---------------------------------------------------------------------------
# policy object and weighted combination
# ---------------------------------------------------------------------------

class _Policy(object):
    def __init__(self, tables, config):
        self.tables = tables
        self.config = config or {}
        w = self.config.get("weights", {})
        self.w0 = float(w.get("prior", 0.20))
        self.w1 = float(w.get("prev_mask", 1.00))
        self.w2 = float(w.get("run", 0.35))
        self.w3 = float(w.get("depth", 0.15))
        self.w4 = float(w.get("tiles", 0.05))
        self.floor = float(self.config.get("exploration_floor", FLOOR))

    def _smoothed(self, table, key):
        """table: dict[(context_key, action) -> count]; returns P(action|key)."""
        tot = 0.0
        counts = {}
        for a in ACTION_ORDER:
            c = table.get((key, a), 0.0)
            counts[a] = c
            tot += c
        prior = self.tables["prior"]
        out = {}
        for a in ACTION_ORDER:
            out[a] = (counts[a] + SMOOTH * prior[a]) / (tot + SMOOTH)
        return out

    def action_probs(self, level, state, legal_actions):
        if not legal_actions:
            legal_actions = (state or {}).get("legal_actions") or []
        f = _parse_state(state, legal_actions)

        legal = [a for a in (legal_actions or []) if _to_action(a) in ACTION_ORDER]
        if not legal:
            legal = [ACTION_ORDER[i] for i in range(4) if (f["mask"] >> i) & 1]
        if not legal:
            legal = list(ACTION_ORDER)

        logp = {a: 0.0 for a in ACTION_ORDER}
        prior = self.tables["prior"]
        for a in ACTION_ORDER:
            logp[a] += self.w0 * math.log(max(prior[a], 1e-12))

        p1 = self._smoothed(self.tables["prev_mask"], (f["prev"], f["mask"]))
        for a in ACTION_ORDER:
            logp[a] += self.w1 * math.log(max(p1[a], 1e-12))

        rb = f["run_bucket"] if f["run_bucket"] is not None else 1
        p2 = self._smoothed(self.tables["run"], (f["mask"], min(max(rb, 1), RUN_CAP)))
        for a in ACTION_ORDER:
            logp[a] += self.w2 * math.log(max(p2[a], 1e-12))

        p3 = self._smoothed(self.tables["depth_phase"], (f["mask"], f["phase"]))
        for a in ACTION_ORDER:
            logp[a] += self.w3 * math.log(max(p3[a], 1e-12))

        p4 = self._smoothed(self.tables["tiles"], (f["cell"], f["neighbors"]))
        for a in ACTION_ORDER:
            logp[a] += self.w4 * math.log(max(p4[a], 1e-12))

        for a in ACTION_ORDER:
            if a not in legal:
                logp[a] = float("-inf")

        mx = max(logp.values())
        ex = {a: (math.exp(logp[a] - mx) if logp[a] != float("-inf") else 0.0)
              for a in ACTION_ORDER}
        z = sum(ex.values())
        if z <= 0 or not math.isfinite(z):
            for a in ACTION_ORDER:
                ex[a] = 1.0 if a in legal else 0.0
            z = float(len(legal))
        probs = {a: (ex[a] / z) if a in legal else 0.0 for a in ACTION_ORDER}

        if self.floor > 0.0 and legal:
            n_legal = len(legal)
            for a in legal:
                probs[a] = (1.0 - self.floor) * probs[a] + self.floor / n_legal
            totp = sum(probs[a] for a in legal)
            for a in legal:
                probs[a] /= totp
        return probs


# ---------------------------------------------------------------------------
# public interface
# ---------------------------------------------------------------------------

def make_policy(training_data, config=None):
    """Build a policy from solved training levels.

    training_data: dict with key 'levels' (list of {grid, start, goal,
                   max_depth, solution}).
    config may override:
      config['weights'] = dict(prior, prev_mask, run, depth, tiles)
      config['exploration_floor'] = float
    """
    levels = training_data.get("levels", []) if isinstance(training_data, dict) else training_data
    levels = list(levels or [])

    tables = {"prior": {a: 0.0 for a in ACTION_ORDER},
              "prev_mask": {}, "run": {}, "depth_phase": {}, "tiles": {}}

    for obs in _reconstruct(levels):
        tables["prior"][obs["action"]] += 1.0
        key1 = (obs["prev"], obs["mask"])
        tables["prev_mask"][(key1, obs["action"])] = tables["prev_mask"].get((key1, obs["action"]), 0.0) + 1.0
        key2 = (obs["mask"], min(obs["run_len"], RUN_CAP))
        tables["run"][(key2, obs["action"])] = tables["run"].get((key2, obs["action"]), 0.0) + 1.0
        key3 = (obs["mask"], obs["phase"])
        tables["depth_phase"][(key3, obs["action"])] = tables["depth_phase"].get((key3, obs["action"]), 0.0) + 1.0
        key4 = (obs["cell"], obs["neighbors"])
        tables["tiles"][(key4, obs["action"])] = tables["tiles"].get((key4, obs["action"]), 0.0) + 1.0

    total = float(sum(tables["prior"].values()))
    if total <= 0:
        tables["prior"] = {a: 0.25 for a in ACTION_ORDER}
    else:
        for a in ACTION_ORDER:
            tables["prior"][a] = (tables["prior"][a] + 1.0) / (total + 4.0)

    return _Policy(tables, config)
