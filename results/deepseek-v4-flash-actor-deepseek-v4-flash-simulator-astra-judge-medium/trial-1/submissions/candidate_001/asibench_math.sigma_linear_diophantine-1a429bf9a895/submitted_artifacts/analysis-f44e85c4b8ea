"""Verification script for the sigma-linear-diophantine submission."""
import json, csv, time, random
import analysis

def ground(a, b, c, U):
    sigma = [0] * (U + 1)
    for d in range(1, U + 1):
        for q in range(d, U + 1, d):
            sigma[q] += d
    return sorted(n for n in range(1, U + 1) if a * sigma[n] == b * n + c)

def main():
    with open('data/problem_instances.json') as f:
        data = json.load(f)
    instances = data['instances']
    print(f"=== dataset: {len(instances)} instances ===")
    ok_all = True
    worst = 0.0
    for inst in instances:
        a, b, c, U = inst['a'], inst['b'], inst['c'], inst['U']
        t = time.time()
        sol = analysis.solve(a, b, c, U)
        dt = time.time() - t
        worst = max(worst, dt)
        truth = ground(a, b, c, U)
        ok = (sol == truth)
        ok_all &= ok
        print(f"  {inst['instance_id']:12s} match={ok}  #sols={len(sol)}  solve_time={dt:.4f}s")
    print(f"dataset all match: {ok_all}; worst solve_time: {worst:.4f}s")

    random.seed(7)
    fails = 0
    for _ in range(150):
        a = random.randint(1, 6); b = random.randint(0, 10)
        c = random.randint(-60, 60); U = random.randint(50, 2500)
        if analysis.solve(a, b, c, U) != ground(a, b, c, U):
            fails += 1
    print(f"150 random small cases: fails={fails}")

    for a, b, U in [(1, 2, 100000), (2, 3, 100000), (1, 3, 100000)]:
        sol = analysis.solve(a, b, 0, U)
        truth = ground(a, b, 0, U)
        print(f"c=0  a={a} b={b} U={U}: match={sol==truth} sols={sol}")
        ok_all &= (sol == truth)

    # ---- CSV validation ----
    def read_sol():
        with open('results/solutions.csv', newline='') as f:
            r = csv.reader(f); hdr = next(r)
            return hdr, [(i, int(n)) for (i, n) in r]
    def read_sum():
        with open('results/instance_summary.csv', newline='') as f:
            r = csv.reader(f); hdr = next(r)
            return hdr, [(i, int(cnt), int(lg)) for (i, cnt, lg) in r]

    h1, rows1 = read_sol()
    h2, rows2 = read_sum()
    assert h1 == ['instance_id', 'n'], h1
    assert h2 == ['instance_id', 'solution_count', 'largest_solution'], h2

    csv_ok = True
    for inst in instances:
        iid = inst['instance_id']
        a, b, c, U = inst['a'], inst['b'], inst['c'], inst['U']
        truth = ground(a, b, c, U)
        sol = [n for (i, n) in rows1 if i == iid]
        srow = [r for r in rows2 if r[0] == iid][0]
        exp = (iid, len(truth), truth[-1] if truth else 0)
        if sol != truth or tuple(srow) != exp:
            csv_ok = False
            print("CSV mismatch:", iid)
    print("CSV rows match sieve ground truth:", csv_ok, "| rows:", len(rows1), "| summaries:", len(rows2))
    print("solutions sorted:", rows1 == sorted(rows1))
    print("=== VERIFICATION COMPLETE ===")
    return ok_all and csv_ok

if __name__ == '__main__':
    main()
