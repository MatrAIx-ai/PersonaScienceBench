"""analysis.py
Self-contained solver for the problem:

    a * sigma(n) = b * n + c,   1 <= n <= U,

where sigma(n) is the sum-of-divisors function.

The solver is structure-aware: it builds the prime-power skeleton of n in
increasing prime order using the multiplicative structure of sigma/n.  At
every node the single-prime (and prime-power) completion is solved exactly
(closed form for the prime case), and only small "intermediate" primes are
enumerated (bounded by sqrt(U/m) and an S-headroom cap).  All arithmetic is
exact (fractions.Fraction / big integers), so there is no precision loss.
"""

import math
from bisect import bisect_right, bisect_left
from fractions import Fraction


# ---------------------------------------------------------------------------
# deterministic Miller-Rabin (64-bit safe) + small trial division
# ---------------------------------------------------------------------------
_MR_BASES = (2, 325, 9375, 28178, 450775, 9780504, 1795265022)


def _is_prime(n, small_primes):
    if n < 2:
        return False
    for p in small_primes:
        if p * p > n:
            break
        if n % p == 0:
            return n == p
    # remaining n is larger than any small-prime^2 tested => use Miller-Rabin
    d = n - 1
    r = 0
    while d % 2 == 0:
        d //= 2
        r += 1
    for a in _MR_BASES:
        if a % n == 0:
            continue
        x = pow(a % n, d, n)
        if x == 1 or x == n - 1:
            continue
        for _ in range(r - 1):
            x = (x * x) % n
            if x == n - 1:
                break
        else:
            return False
    return True


def _primes_upto(n):
    if n < 2:
        return []
    sieve = bytearray(b'\x01') * (n + 1)
    sieve[0:2] = b'\x00\x00'
    for i in range(2, int(n ** 0.5) + 1):
        if sieve[i]:
            start = i * i
            sieve[start::i] = b'\x00' * (((n - start) // i) + 1)
    return [i for i in range(n + 1) if sieve[i]]


def _primes_in_range(lo, hi, small_primes):
    """All primes p with lo < p <= hi (segmented sieve; memory-friendly)."""
    if hi < 2 or hi <= lo:
        return []
    lo = max(lo, 1)
    block = 1 << 20
    out = []
    for base in range(lo // block * block, hi + 1, block):
        start = max(base, 2)
        end = min(base + block - 1, hi)
        if end < start:
            continue
        seg = bytearray(b'\x01') * (end - start + 1)
        for p in small_primes:
            if p * p > end:
                break
            m0 = ((start + p - 1) // p) * p
            if m0 < p * p:
                m0 = max(p * p, m0)
            for m in range(m0, end + 1, p):
                seg[m - start] = 0
        for i in range(len(seg)):
            if seg[i]:
                v = start + i
                if v > lo:
                    out.append(v)
    return out


# ---------------------------------------------------------------------------
# main solver
# ---------------------------------------------------------------------------
def solve(a: int, b: int, c: int, U: int) -> list[int]:
    """Return sorted list of all n in [1, U] with a*sigma(n) = b*n + c."""
    if U <= 0:
        return []

    # --- degenerate / linear cases -----------------------------------------
    if a == 0:
        if b == 0:
            if c == 0:
                return list(range(1, U + 1))
            return []
        # b*n + c == 0  =>  n = -c / b  must be a positive integer
        if c % b == 0:
            n0 = -c // b
            if 1 <= n0 <= U:
                return [n0]
        return []

    if U < 1:
        return []

    # prime list only up to sqrt(U) is needed for enumeration
    small_primes = _primes_upto(int(math.isqrt(U)) + 1)

    ba = Fraction(b, a)          # target ratio b/a (exact)

    def _is_prime_mr(x):
        return _is_prime(x, small_primes)

    # prime-power completion at a node:  A*sigma(q^e) = B*q^e + c, q prime
    def _leaf(m, sm, ub, lastp):
        A = a * sm
        B = b * m
        out = []

        # identity case: every prime q in (lastp, ub] qualifies
        # (A*(q+1) == B*q + c holds for all q  <=>  A == B and A == c)
        if A == B and A == c:
            primes = _primes_in_range(lastp, ub, small_primes)
            return [m * q for q in primes]

        # e = 1  (r = q a single prime):  (A - B)*q = c - A
        den = B - A
        if den != 0:
            num = A - c
            if num % den == 0:
                q = num // den
                if q > lastp and q <= ub and _is_prime_mr(q):
                    out.append(m * q)

        # e >= 2  (r = q^e):  q <= sqrt(ub)
        lim = int(math.isqrt(ub)) + 1
        j0 = bisect_right(small_primes, lastp)
        j1 = bisect_right(small_primes, lim)
        for j in range(j0, j1):
            q = small_primes[j]
            qe = q * q
            e = 2
            while qe <= ub:
                if A * ((q * qe - 1) // (q - 1)) == B * qe + c:
                    out.append(m * qe)
                qe *= q
                e += 1
                if e > 64:
                    break
        return out

    def _rec(m, sm, lastp):
        sols = []
        A = a * sm
        B = b * m

        # r = 1 completion: n = m itself
        if A == B + c:
            sols.append(m)

        ub = U // m
        if ub < 2:
            return sols

        leaf_sols = _leaf(m, sm, ub, lastp)
        if leaf_sols is not None:
            sols.extend(leaf_sols)
            # identity case: completions are exactly the single primes, done
            if A == B and A == c:
                return sols

        # --- headroom caps for deeper (multi-prime) completions -------------
        S_m = Fraction(sm, m)
        if c > 0:
            cap = ba + Fraction(c, a * m)   # S(n) <= b/a + c/(a*m)
        else:
            cap = ba                         # S(n) <  b/a
        if S_m >= cap:
            return sols

        # the next (intermediate) prime factor q can only be:
        #   q <= sqrt(ub)   (need room for at least one further prime)
        #   S(m) * S(q) < cap   (headroom for further factors)
        lim = int(math.isqrt(ub)) + 1
        j0 = bisect_right(small_primes, lastp)
        j1 = bisect_right(small_primes, lim)
        for j in range(j0, j1):
            q = small_primes[j]
            if S_m * Fraction(q + 1, q) >= cap:
                continue
            qe = q
            for _e in range(1, 65):
                if qe > ub:
                    break
                ss = Fraction(q * qe - 1, (q - 1) * qe)
                if S_m * ss >= cap:
                    break
                cm = m * qe
                csm = sm * ((q * qe - 1) // (q - 1))
                sols.extend(_rec(cm, csm, q))
                qe *= q
        return sols

    return sorted(set(_rec(1, 1, 0)))
