"""analysis.py

Self-contained, tabular, online, model-free optimistic Q-learning agent for
hidden finite-horizon episodic MDPs (h = 1..H, rewards in [0,1]).

Design (BOOT + RET; see report):
  For every (h, s, a) we keep visit count N and the running first/second
  moments of two statistically different optimistic estimators:
    * BOOT: one-step bootstrap target  y = r + V_sel[h+1, next]  (0 if done),
            where V_sel is the current optimistic value (max_a Q[h+1]).
    * RET : bounded multi-step (episode) return  G_h = sum_{t=h..H} r_t,
            finalized at episode end (done==True or end_episode hook).
  Each estimator gets a strictly positive variance-sensitive (Bernstein-style)
  bonus, so each is individually optimistic at every N; at N == 0 the value is
  Rrem (the maximum remaining-horizon value).  The two optimistic estimates
  are blended with alpha = N/(N + tau): RET provides an honest high-variance
  optimism floor while one-step targets are still drifting (burn-in); BOOT
  takes over (alpha -> 1) once targets are tight.  Q is clipped to
  [0, Rrem], Rrem = H - h + 1.

Storage: O(H*S*A) floats (N + 4 moment accumulators per cell) plus one bounded
episode trace of length H.  No H*S*A*S tensor, no transition model, no replay,
no posterior, no case-id branching.

The agent reads only dimensions and reward_range from env_spec (never P/R,
never identifies the MDP).
"""
import numpy as np

# ---------------------------------------------------------------------------
# Calibrated constants (shared single configuration for every case/seed).
# logT scale is computed per spec from T = H*S*A*K so constants are robust to
# the bigger hidden specs.
# ---------------------------------------------------------------------------
C1 = 6.0      # Bernstein sqrt(var*logT/N) coefficient, BOOT bonus
C2 = 8.0      # range/N optimism floor coefficient, BOOT bonus
C3 = 1.0      # Bernstein sqrt(var*logT/N) coefficient, RET bonus
C4 = 10.0     # range/N optimism floor coefficient, RET bonus
TAU = 150.0   # alpha = N/(n+tau): RET trust window (burn-in length scale)


def make_agent(env_spec, seed):
    return _Agent(env_spec, seed)


class _Agent:
    def __init__(self, env_spec, seed, c1=C1, c2=C2, c3=C3, c4=C4, tau=TAU):
        self.H = int(env_spec["H"])
        self.S = int(env_spec["S"])
        self.A = int(env_spec["A"])
        self.K = int(env_spec["K"])
        self.seed = int(seed)

        # remaining-horizon value bound (max value of Q[h]) = H - h + 1
        self.rrem = np.arange(self.H, 0, -1, dtype=np.float64)  # rrem[h-1]

        # log scale, per-case from actual spec dimensions.
        self.logT = np.log(max(2, self.H * self.S * self.A * self.K))

        # scalar stats per (h, s, a): counts and first/second moments.
        self.N = np.zeros((self.H, self.S, self.A), dtype=np.float64)
        self.sb1 = np.zeros((self.H, self.S, self.A), dtype=np.float64)
        self.sb2 = np.zeros((self.H, self.S, self.A), dtype=np.float64)
        self.sm1 = np.zeros((self.H, self.S, self.A), dtype=np.float64)
        self.sm2 = np.zeros((self.H, self.S, self.A), dtype=np.float64)

        # bounded one-episode trace: (state, action, reward) per step.
        self.ts = np.zeros((self.H,), dtype=np.int64)
        self.ta = np.zeros((self.H,), dtype=np.int64)
        self.tr = np.zeros((self.H,), dtype=np.float64)
        self.tlen = 0

        self.c1 = c1
        self.c2 = c2
        self.c3 = c3
        self.c4 = c4
        self.tau = tau

    # -- episode lifecycle ---------------------------------------------------
    def start_episode(self, episode, state):
        self.tlen = 0

    def reset_episode(self, episode, state):
        self.tlen = 0

    def new_episode(self, episode, state):
        self.tlen = 0

    def end_episode(self, episode, reward):
        self._finalize_returns()

    def finish_episode(self, episode, reward):
        self._finalize_returns()

    # -- value machinery ----------------------------------------------------
    def _mean_var(self, s1, s2, n):
        """mean and variance from running first/second moments."""
        if n <= 0:
            return 0.0, 0.0
        mu = s1 / n
        varr = s2 / n - mu * mu
        if varr < 0.0:
            varr = 0.0
        return mu, varr

    def _q_cell(self, h, s, a):
        """Optimistic blended value for one (h, s, a) cell, clipped to range."""
        i = h - 1
        R = self.rrem[i]
        n = self.N[i, s, a]
        if n <= 0:
            return R  # fully optimistic: force at least one visit everywhere
        # one-step bootstrap estimator
        mb, vb = self._mean_var(self.sb1[i, s, a], self.sb2[i, s, a], n)
        vmax = 0.25 * R * R
        if vb > vmax:
            vb = vmax
        b_boot = self.c1 * np.sqrt(vb * self.logT / n) + self.c2 * R / n
        boot_opt = mb + b_boot
        # multi-step return estimator
        mr, vr = self._mean_var(self.sm1[i, s, a], self.sm2[i, s, a], n)
        if vr > vmax:
            vr = vmax
        b_ret = self.c3 * np.sqrt(vr * self.logT / n) + self.c4 * R / n
        ret_opt = mr + b_ret
        # blend (both estimates strictly optimistic => blend is optimistic)
        alpha = n / (n + self.tau)
        q = alpha * boot_opt + (1.0 - alpha) * ret_opt
        if q > R:
            q = R
        elif q < 0.0:
            q = 0.0
        return q

    def _q_h(self, h, s):
        """Vector of blended Q over actions for (h, s)."""
        i = h - 1
        R = self.rrem[i]
        out = np.empty(self.A, dtype=np.float64)
        for a in range(self.A):
            out[a] = self._q_cell(h, s, a)
        return out

    def _v_h(self, h, s):
        """Current optimistic value V_sel(h, s) = max_a Q[h, s, a]."""
        if h > self.H:
            return 0.0
        return float(np.max(self._q_h(h, s)))

    # -- interface ----------------------------------------------------------
    def act(self, h, state):
        q = self._q_h(int(h), int(state))
        return int(np.argmax(q))

    def observe(self, h, state, action, reward, next_state, done):
        h = int(h)
        state = int(state)
        action = int(action)
        i = h - 1
        R = self.rrem[i]
        # 1) one-step bootstrap update (online)
        v_next = 0.0 if done else self._v_h(h + 1, int(next_state))
        y = float(reward) + v_next
        n = self.N[i, state, action]
        self.sb1[i, state, action] += y
        self.sb2[i, state, action] += y * y
        # 2) record trace entry for the multi-step return estimator
        if self.tlen < self.H:
            self.ts[self.tlen] = state
            self.ta[self.tlen] = action
            self.tr[self.tlen] = float(reward)
            self.tlen += 1
        self.N[i, state, action] = n + 1.0
        # 3) episode end (robust: happens whether or not hooks are called)
        if done:
            self._finalize_returns()

    def _finalize_returns(self):
        """Backward accumulation of episode returns -> RET estimator."""
        if self.tlen <= 0:
            return
        g = 0.0
        for j in range(self.tlen - 1, -1, -1):
            g += self.tr[j]
            s = self.ts[j]
            a = self.ta[j]
            self.sm1[j, s, a] += g
            self.sm2[j, s, a] += g * g
        self.tlen = 0
