"""Calibration harness: replicates public_calibration_runner.run_case protocol,
imports analysis.make_agent directly, sweeps constants over the public suite."""
import json, numpy as np, itertools, time
import analysis

def run_case(case, cparams, seed):
    spec = dict(case["spec"])
    agent = analysis.make_agent(spec, seed)
    # override constants (shared config)
    for k, v in cparams.items():
        setattr(agent, k, v)
    agent.logT = np.log(max(2, agent.H * agent.S * agent.A * agent.K))
    rng = np.random.default_rng(seed + 9176)
    H, A, K = int(spec["H"]), int(spec["A"]), int(spec["K"])
    init = int(spec.get("initial_state", 0))
    P = np.asarray(spec["P"]); R = np.asarray(spec["R"])
    total = 0.0; invalid = 0; errors = 0
    for ep in range(K):
        st = init; ep_rew = 0.0
        # optional hooks
        hk = getattr(agent, "start_episode", None)
        if callable(hk): hk(ep, st)
        for hh in range(H):
            try:
                raw = agent.act(hh + 1, st)
                ok = isinstance(raw, (int, np.integer)) and not isinstance(raw, (bool, np.bool_))
                a = int(raw) if ok else 0
            except Exception:
                a = 0; errors += 1
            if a < 0 or a >= A:
                a = 0; invalid += 1
            r = float(R[hh, st, a]); probs = P[hh, st, a]
            ns = int(rng.choice(len(probs), p=probs))
            done = hh == H - 1
            agent.observe(hh + 1, st, a, r, ns, done)
            ep_rew += r; st = ns
        hk2 = getattr(agent, "end_episode", None)
        if callable(hk2): hk2(ep, ep_rew)
        total += ep_rew
    return K * float(case["optimal_start_value"]) - total, invalid, errors

def eval_config(cparams, suite, seeds, verbose=False):
    per = {}
    total = 0.0; invalid_total = 0; err_total = 0
    for case in suite["cases"]:
        cid = str(case["spec"]["case_id"])
        rs = [run_case(case, cparams, s) for s in seeds]
        regs = [r[0] for r in rs]
        inv = sum(r[1] for r in rs); errs = sum(r[2] for r in rs)
        mu = float(np.mean(regs))
        per[cid] = mu
        total += mu
        invalid_total += inv; err_total += errs
    if verbose:
        print(cparams, "=> total_mean_regret", round(total, 3),
              "| per:", {k: round(v, 3) for k, v in per.items()},
              "| invalid", invalid_total, "errors", err_total)
    return total, per, invalid_total, err_total

if __name__ == "__main__":
    suite = json.load(open("data/public_calibration_suite.json"))
