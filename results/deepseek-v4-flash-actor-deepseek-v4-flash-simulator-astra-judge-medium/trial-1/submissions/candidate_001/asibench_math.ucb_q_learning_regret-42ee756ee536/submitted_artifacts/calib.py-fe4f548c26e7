def sweep_around():
    suite = json.load(open("data/public_calibration_suite.json"))
    seeds = list(suite["eval_seeds"]) + [11, 2222, 33333, 777, 12345]
    cfgs = []
    for c1 in [2.0, 3.0, 4.0, 5.0]:
        for c2 in [4.0, 8.0, 12.0]:
            cfgs.append(dict(c1=c1, c2=c2, c3=2.0, c4=10.0, tau=100.0))
    import itertools
    best = None
    for cp in cfgs:
        total = 0.0; per = {}
        for s in seeds:
            for case in suite["cases"]:
                cid = str(case["spec"]["case_id"])
                rg, inv, err = run_case(case, cp, s)
                per.setdefault(cid, []).append(rg)
        for cid, rs in per.items():
            total += float(np.mean(rs))
        print(f"  {cp} TOTAL {total:.3f}")
        if best is None or total < best[0]:
            best = (total, cp)
    print("BEST:", best)

