def eval_multi(cparams, suite, seeds, label=""):
    regs_per_seed = {s: [] for s in seeds}
    per_lists = {}
    for s in seeds:
        for case in suite["cases"]:
            cid = str(case["spec"]["case_id"])
            rg, inv, err = run_case(case, cparams, s)
            per_lists.setdefault(cid, []).append(rg)
    total_mean = 0.0
    for cid, rs in per_lists.items():
        mu = float(np.mean(rs)); sd = float(np.std(rs))
        total_mean += mu
        print(f"  {label} | {cid:28s} mean_regret {mu:8.3f}  std {sd:8.3f}")
    print(f"  {label} | TOTAL mean regret over {len(seeds)} seeds: {total_mean:.3f}")

