"""Constraint verification for analysis.py (not the agent itself)."""
import json, numpy as np, analysis, importlib.util, math

issues = []

# 1) run a full trial on the public example MDP using the OFFICIAL runner import
def load(path, name="submission"):
    spec = importlib.util.spec_from_file_location(name, path)
    mod = importlib.util.module_from_spec(spec); spec.loader.exec_module(mod)
    return mod
mod = load("analysis.py")
print("module exposes make_agent:", callable(getattr(mod, "make_agent", None)))

example = json.load(open("data/public_example_mdp.json"))
spec = example["spec"]
agent = mod.make_agent(spec, 7)
objsize = [n for n, f in agent.__dict__.items()]
print("agent attributes:", sorted(objsize))

# 2) storage count: only O(H*S*A) arrays + O(H) trace
H,S,A,K = int(spec["H"]), int(spec["S"]), int(spec["A"]), int(spec["K"])
flat = 0; has_hsas = False
for n, v in agent.__dict__.items():
    if isinstance(v, np.ndarray):
        if v.size > 1:
            print(f"  array {n}: shape {v.shape}")
            if tuple(v.shape) == (H,S,A,S):
                has_hsas = True
            if v.shape == (H,S,A):
                flat += v.size
        else:
            print(f"  scalar {n}: {v}")
print("H*S*A =", H*S*A, "  total H*S*A floats =", flat, "  violates? ->", "YES" if has_hsas else "no H*S*A*S tensor")
if has_hsas: issues.append("H*S*A*S tensor present")

# 3) run K episodes on the example MDP, check action validity & Q range
rng = np.random.default_rng(7 + 9176)
P = np.asarray(spec["P"]); R = np.asarray(spec["R"])
invalid = 0; out_of_range = 0; nchecks = 0
for ep in range(int(spec["K"])):
    st = int(spec["initial_state"])
    if hasattr(agent, "start_episode"): agent.start_episode(ep, st)
    for hh in range(H):
        a = agent.act(hh + 1, st)
        ok_int = isinstance(a, (int, np.integer)) and not isinstance(a, (bool, np.bool_))
        if not ok_int or not (0 <= int(a) < A):
            invalid += 1
        for aa in range(A):
            q = agent._q_cell(hh + 1, st, aa)
            nchecks += 1
            if not (0.0 - 1e-9 <= q <= (H - hh) + 1.0 + 1e-9):
                out_of_range += 1
                if out_of_range <= 3: print("  OUT OF RANGE at h", hh+1, "s", st, "a", aa, "q", q, "R", (H-hh))
        r = float(R[hh, st, a]); probs = P[hh, st, a]
        ns = int(rng.choice(len(probs), p=probs)); done = (hh == H - 1)
        agent.observe(hh + 1, st, a, r, ns, done)
        st = ns
    if hasattr(agent, "end_episode"): agent.end_episode(ep, 0.0)
print(f"example MDP: invalid actions = {invalid}, Q out of range = {out_of_range}/{nchecks} checks")

# 4) no forbidden structures: look for any attribute/name suggesting transition model/replay
forbidden = ["P", "R", "transit", "count", "replay", "case", "model"]
for n in objsize:
    ln = n.lower()
    if "case" in ln or "transit" in ln or "count" in ln or "replay" in ln:
        issues.append(f"possibly off-limits attribute: {n}")
print("potential off-limits attributes:", [n for n in objsize if any(f in n.lower() for f in ["case","transit","count","replay","model"])])
# note: env_spec is not stored; only dims scalarized.

# 5) check no branching: source must not contain P/R tables or case_id usage
src = open("analysis.py").read()
bad = [tok for tok in ["case_id", "optimal_start_value", "env_spec[\"P\"]", "env_spec[\"R\"]", "spec[\"P\"]", "spec[\"R\"]", "[ \"P\" ]", "case_"] if tok in src]
print("forbidden tokens found in source:", bad if bad else "NONE")
if bad: issues.append("forbidden source tokens: %s" % bad)

print("ISSUES:", issues if issues else "NONE — all constraints satisfied")
