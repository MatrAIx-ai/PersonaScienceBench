"""Executed analysis script: reproduces the official public calibration protocol
for analysis.py (3 official seeds), compares to the provided baselines, and also
reports robustness over 12 seeds. Writes report_public.json."""
import json, math
import numpy as np
import analysis
import synth  # imports the official-protocol run_agent_eval helper

SUITE = "data/public_calibration_suite.json"
out = {}

def mean(x): return float(np.mean(x))
def sd(x): return float(np.std(x))

def main():
    suite = json.load(open(SUITE))
    seeds_official = list(suite["eval_seeds"])
    seeds_wide = seeds_official + [11, 2222, 33333, 777, 12345, 3, 7, 999, 4242]
    refs = {}
    for bl in ["plain_ucb_b", "strong_reference"]:
        refs[bl] = {cid: d["mean_regret"] for cid, d in suite["baselines"][bl]["per_case"].items()}
        refs[bl]["TOTAL_meansum"] = sum(refs[bl][k] for k in suite["baselines"][bl]["per_case"])

    res = {"constants": {"C1": analysis.C1, "C2": analysis.C2, "C3": analysis.C3,
                         "C4": analysis.C4, "TAU": analysis.TAU},
           "per_case": {}, "totals": {}, "invalid_actions": 0, "errors": 0}
    for case in suite["cases"]:
        cid = str(case["spec"]["case_id"])
        r3 = [synth.run_agent_eval(analysis.make_agent, case, s) for s in seeds_official]
        r12 = [synth.run_agent_eval(analysis.make_agent, case, s) for s in seeds_wide]
        res["per_case"][cid] = {
            "official3_mean_regret": mean(r3), "official3_std": sd(r3),
            "wide12_mean_regret": mean(r12), "wide12_std": sd(r12),
            "ucb_b_mean_regret": refs["plain_ucb_b"][cid],
            "strong_ref_mean_regret": refs["strong_reference"][cid],
        }
    res["totals"]["official3_meansum"] = sum(res["per_case"][c]["official3_mean_regret"] for c in res["per_case"])
    res["totals"]["wide12_meansum"] = sum(res["per_case"][c]["wide12_mean_regret"] for c in res["per_case"])
    res["totals"]["ucb_b_meansum"] = refs["plain_ucb_b"]["TOTAL_meansum"]
    res["totals"]["strong_ref_meansum"] = refs["strong_reference"]["TOTAL_meansum"]

    # constraint spot checks
    agent = analysis.make_agent(suite["cases"][0]["spec"], 1)
    res["constraints"] = {
        "no_H_S_A_S": all(v.shape not in [(agent.H, agent.S, agent.A, agent.S)]
                          for v in agent.__dict__.values() if isinstance(v, np.ndarray)),
        "storage_floats": sum(v.size for v in agent.__dict__.values() if isinstance(v, np.ndarray)),
    }

    with open("report_public.json", "w") as f:
        json.dump(res, f, indent=2)
    print(json.dumps(res, indent=2))

if __name__ == "__main__":
    main()
