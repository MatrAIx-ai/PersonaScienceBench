"""Synthetic hidden-like stress test: compare analysis.py agent vs a plain
Bernstein UCB-Q (UCB-B) baseline on random MDPs with hidden-family dims."""
import numpy as np, json
import analysis

def make_ucbb(env_spec, seed, c1=2.0, c2=6.0):
    class B:
        def __init__(self, spec):
            H=int(spec["H"]); S=int(spec["S"]); A=int(spec["A"]); K=int(spec["K"])
            self.H,self.S,self.A,self.K = H,S,A,K
            self.rrem = np.arange(H,0,-1,dtype=np.float64)
            self.logT = np.log(max(2,H*S*A*K))
            self.N = np.zeros((H,S,A)); self.s1=np.zeros((H,S,A)); self.s2=np.zeros((H,S,A))
        def start_episode(self, episode, state): pass
        def end_episode(self, episode, reward): pass
        def qcell(self,h,s,a):
            i=h-1; R=self.rrem[i]; n=self.N[i,s,a]
            if n<=0: return R
            mu=self.s1[i,s,a]/n; var=self.s2[i,s,a]/n-mu*mu
            if var<0: var=0.0
            if var>0.25*R*R: var=0.25*R*R
            return min(R, mu + c1*np.sqrt(var*self.logT/n) + c2*R/n)
        def act(self,h,s):
            q=[self.qcell(h,s,a) for a in range(self.A)]
            return int(np.argmax(q))
        def observe(self,h,s,a,r,ns,done):
            i=h-1
            v = 0.0 if done else max(self.qcell(h+1,ns,aa) for aa in range(self.A))
            y = float(r)+v
            self.s1[i,s,a]+=y; self.s2[i,s,a]+=y*y; self.N[i,s,a]+=1
    return B(env_spec)

def gen_mdp(S, A, H, K, seed, det_frac=0.7, reward_mode="mixed"):
    rng = np.random.default_rng(seed)
    P = np.zeros((H,S,A,S)); R = np.zeros((H,S,A))
    for h in range(H):
        for s in range(S):
            for a in range(A):
                if rng.random() < det_frac:
                    ns = rng.integers(0,S); P[h,s,a,ns]=1.0
                else:
                    w = rng.random(S)+0.3; P[h,s,a]=w/w.sum()
                if reward_mode=="late": base = 0.0 if h < H//2 else 1.0
                elif reward_mode=="early": base = 1.0 if h < H//2 else 0.0
                elif reward_mode=="sparse": base = 1.0 if h==H-1 else 0.0
                else: base = 0.5
                R[h,s,a] = base * rng.random()
                if rng.random() < 0.3: R[h,s,a] = 0.0
                R[h,s,a] = float(np.clip(R[h,s,a], 0.0, 1.0))
    R = np.round(R*100)/100.0
    spec = dict(case_id="synth", S=S, A=A, H=H, K=K, initial_state=0,
                reward_range=[0.0,1.0], P=P.tolist(), R=R.tolist())
    V = np.zeros((H+1,S))
    for h in range(H-1,-1,-1):
        Q = R[h] + np.einsum('san,n->sa', P[h], V[h+1])
        V[h] = Q.max(-1)
    return dict(spec=spec, optimal_start_value=float(V[0,0]))

def run_agent_eval(make, case, seed):
    spec = dict(case["spec"])
    agent = make(spec, seed)
    rng = np.random.default_rng(seed+9176)
    H,A,K = int(spec["H"]), int(spec["A"]), int(spec["K"])
    P=np.asarray(spec["P"]); R=np.asarray(spec["R"])
    total=0.0
    for ep in range(K):
        st=0; er=0.0
        mk=getattr(agent,"start_episode",None)
        if callable(mk): mk(ep,st)
        for hh in range(H):
            a=int(agent.act(hh+1,st))
            if a<0 or a>=A: a=0
            r=float(R[hh,st,a]); probs=P[hh,st,a]
            ns=int(rng.choice(len(probs),p=probs)); done=hh==H-1
            agent.observe(hh+1,st,a,r,ns,done)
            er+=r; st=ns
        mk2=getattr(agent,"end_episode",None)
        if callable(mk2): mk2(ep,er)
        total+=er
    return K*float(case["optimal_start_value"])-total

def _make_cfg(cparams):
    def factory(spec, seed):
        agent = analysis.make_agent(spec, seed)
        for k, v in cparams.items():
            setattr(agent, k, v)
        agent.logT = np.log(max(2, agent.H * agent.S * agent.A * agent.K))
        return agent
    return factory

def stress(flavors, n_mdps=2, seeds=(11,2222), verbose=True, cparams=None):
    factory = analysis.make_agent if cparams is None else _make_cfg(cparams)
    dims = [(7,3,14,720),(5,2,14,480),(8,3,13,630),(7,2,12,750),(7,3,16,540),(4,3,12,540)]
    row={}
    for fl in flavors:
        ours=[]; base=[]
        for (S,A,H,K) in dims:
            for m in range(n_mdps):
                case=gen_mdp(S,A,H,K, seed=1000*(m+1)+len(fl), reward_mode=fl)
                for sd in seeds:
                    ours.append(run_agent_eval(factory, case, sd))
                    base.append(run_agent_eval(make_ucbb, case, sd))
        if verbose:
            print(f"  flavor={fl:6s} ours {np.mean(ours):9.2f}  ucbb {np.mean(base):9.2f}  ratio {np.mean(ours)/np.mean(base):5.3f}  n={len(ours)}")
        row[fl]=dict(ratio=float(np.mean(ours)/np.mean(base)),
                     ours_mean=float(np.mean(ours)), base_mean=float(np.mean(base)))
    return row

if __name__=="__main__":
    print("mean regret per run, lower better; ratio<1 => our agent beats plain UCB-B")
    import sys
    mode = sys.argv[1] if len(sys.argv)>1 else "public"
    if mode == "public":
        stress(["mixed","late","early","sparse"], n_mdps=1, seeds=(11,), verbose=True)
    else:
        taus = [float(x) for x in sys.argv[2:]] or [100.0]
        for tau in taus:
            cp = dict(c1=6.0,c2=8.0,c3=1.0,c4=10.0,tau=tau)
            print("=== cparams:", cp)
            stress(["late","sparse","early"], n_mdps=1, seeds=(11,2222), cparams=cp)
