#!/usr/bin/env python3
"""
2D leapfrog vortex simulation with the Vortex Particle Flow Map (VPFM) method.

Grid: 135x135 staggered MAC grid over [0,1]^2, dx=dy=1/135.
Faces: ux (vertical-face u) is (136,135): ux[i,j] at (x=(j+1/2)dx, y=i*dx).
       uy (horizontal-face v) is (135,136): uy[i,j] at (x=j*dx, y=(i+1/2)dx).
       -> axis0 = y, axis1 = x.
Vorticity (cell centered, (135,135)): omega = dv/dx - du/dy.
Stream function:  lap psi = -omega, Dirichlet psi=0;  u = dpsi/dy, v = -dpsi/dx.

VPFM choices per the brief:
  * Quadratic B-spline N2 kernel (support |r|<=3/2) for G2P and P2G.
  * APIC P2G: particles carry (omega_p, grad_omega_p, T); gradient corrected by
    the backward flow-map gradient gradc = grad_omega_p . T; weight normalized.
  * T reinitialized to identity every step, evolved via dT/dt = -(grad u)^T . T.
  * Midpoint velocity: RK4 semi-Lagrangian half-step backward advection of grid
    vorticity, then a FRESH Dirichlet psi=0 Poisson solve (5-pt, direct splu).
  * Reinitialize particles every step (uniform 4x4 per cell), 16 particles/cell.
  * dt = min(CFL*dx/max_face_speed, remaining to next frame), landing exactly
    on all 107 frame times (dt_frame=0.1, CFL=1.8797).
Outputs:
  vorticity_frames.npy  (5,135,135) float32, frames [0,26,52,78,104]
     cell-center averaged faces + central differences + clamped OOB indices
  kinetic_energy.npy    (108,) float32, frames 0..107
     E = sum 0.5*dx^2*(ubar^2+vbar^2)
"""
import numpy as np
from scipy.sparse import coo_matrix
from scipy.sparse.linalg import splu

N = 135
DX = 1.0 / N
DT_FRAME = 0.1
N_FRAMES = 107
CFL = 1.8797
PPD = 4                      # particles per dimension per cell (16 per cell)
NP = N * N * PPD * PPD       # total particles
EPS = 1e-10

ux0 = np.load('data/initial_u_x.npy').astype(np.float64)   # (136,135)
uy0 = np.load('data/initial_u_y.npy').astype(np.float64)   # (135,136)

# ----------------------------------------------------------------------------
# Poisson: 5-point Laplacian, Dirichlet psi=0 on the boundary ring
# ----------------------------------------------------------------------------
def build_laplacian():
    n = N * N
    idx = np.arange(n).reshape(N, N)
    rows, cols, data = [], [], []
    for i in range(N):
        for j in range(N):
            r = idx[i, j]
            rows.append(r); cols.append(r); data.append(4.0)
            for di, dj in ((-1, 0), (1, 0), (0, -1), (0, 1)):
                ni, nj = i + di, j + dj
                if 0 <= ni < N and 0 <= nj < N:
                    rows.append(r); cols.append(idx[ni, nj]); data.append(-1.0)
    return coo_matrix((data, (rows, cols)), shape=(n, n)).tocsr().tocsc()

_LA = build_laplacian()
_LU = splu(_LA)                          # factored once, reused every solve

def solve_psi(omega):
    """Solve lap psi = -omega, Dirichlet psi=0 on boundary. Returns (N,N)."""
    # A@psi = 4psi - sum_neighbors = -lap*dx^2. We want lap psi = -omega
    # -> A@psi = +omega*dx^2, so u=dpsi/dy, v=-dpsi/dx give curl(u)=omega.
    return _LU.solve((omega.ravel() * DX * DX)).reshape(N, N)

# ----------------------------------------------------------------------------
# Reconstructions
# ----------------------------------------------------------------------------
def vorticity_from_faces(ux, uy):
    """Cell-centered vorticity from MAC faces, direct staggered stencil."""
    return ((uy[:, 1:] - uy[:, :-1]) - (ux[1:, :] - ux[:-1, :])) / DX

def faces_from_psi(psi):
    """MAC faces from stream function: u=dpsi/dy, v=-dpsi/dx, psi=0 boundary."""
    ux = np.zeros((N + 1, N))
    ux[1:-1, :] = (psi[1:, :] - psi[:-1, :]) / DX
    ux[0, :] = psi[0, :] / DX
    ux[-1, :] = -psi[-1, :] / DX
    uy = np.zeros((N, N + 1))
    uy[:, 1:-1] = -(psi[:, 1:] - psi[:, :-1]) / DX
    uy[:, 0] = -psi[:, 0] / DX
    uy[:, -1] = psi[:, -1] / DX
    return ux, uy

def cell_center_velocity(ux, uy):
    ubar = 0.5 * (ux[:-1, :] + ux[1:, :])
    vbar = 0.5 * (uy[:, :-1] + uy[:, 1:])
    return ubar, vbar

def compute_grads(ubar, vbar):
    """Cell-centered velocity gradient (central differences, clamped edges)."""
    dudx = np.zeros((N, N)); dudy = np.zeros((N, N))
    dvdx = np.zeros((N, N)); dvdy = np.zeros((N, N))
    dudx[:, 1:-1] = (ubar[:, 2:] - ubar[:, :-2]) / (2 * DX)
    dudx[:, 0] = (ubar[:, 1] - ubar[:, 0]) / DX
    dudx[:, -1] = (ubar[:, -1] - ubar[:, -2]) / DX
    dudy[1:-1, :] = (ubar[2:, :] - ubar[:-2, :]) / (2 * DX)
    dudy[0, :] = (ubar[1, :] - ubar[0, :]) / DX
    dudy[-1, :] = (ubar[-1, :] - ubar[-2, :]) / DX
    dvdx[:, 1:-1] = (vbar[:, 2:] - vbar[:, :-2]) / (2 * DX)
    dvdx[:, 0] = (vbar[:, 1] - vbar[:, 0]) / DX
    dvdx[:, -1] = (vbar[:, -1] - vbar[:, -2]) / DX
    dvdy[1:-1, :] = (vbar[2:, :] - vbar[:-2, :]) / (2 * DX)
    dvdy[0, :] = (vbar[1, :] - vbar[0, :]) / DX
    dvdy[-1, :] = (vbar[-1, :] - vbar[-2, :]) / DX
    return dudx, dudy, dvdx, dvdy

def interp2(field, x, y):
    """Bilinear interpolation of a (N,N) cell-centered field at points (x,y).
    Cell-center (i,j) sits at (x=(j+0.5)dx, y=(i+0.5)dx). Clamped at edges."""
    fx = np.clip(x / DX - 0.5, 0.0, N - 1 - 1e-9)
    fy = np.clip(y / DX - 0.5, 0.0, N - 1 - 1e-9)
    i0 = np.clip(np.floor(fy).astype(np.int64), 0, N - 2)
    j0 = np.clip(np.floor(fx).astype(np.int64), 0, N - 2)
    ty = fy - i0
    tx = fx - j0
    return (field[i0, j0] * (1 - ty) * (1 - tx)
            + field[i0 + 1, j0] * ty * (1 - tx)
            + field[i0, j0 + 1] * (1 - ty) * tx
            + field[i0 + 1, j0 + 1] * ty * tx)

def vel_at(ubar, vbar, x, y):
    return interp2(ubar, x, y), interp2(vbar, x, y)

# ----------------------------------------------------------------------------
# Quadratic B-spline N2 kernel (support |s| <= 1.5)
# ----------------------------------------------------------------------------
def n2(s):
    a = np.abs(s)
    w = np.zeros_like(a)
    m1 = a < 0.5
    m2 = (a >= 0.5) & (a < 1.5)
    w[m1] = 0.75 - a[m1] * a[m1]
    w[m2] = 0.5 * (1.5 - a[m2]) ** 2
    return w

def dn2(s):
    """d/ds N2(s), s = (grid-particle)/dx."""
    a = np.abs(s)
    d = np.zeros_like(a)
    m1 = a < 0.5
    m2 = (a >= 0.5) & (a < 1.5)
    d[m1] = -2.0 * s[m1]
    d[m2] = -np.sign(s[m2]) * (1.5 - a[m2])
    return d

# ----------------------------------------------------------------------------
# Particle-transfer helpers (vectorized over particles)
# ----------------------------------------------------------------------------
def _base_grid_indices():
    """Uniform 4x4 particles per cell (PPD^2 = 16 per cell)."""
    off = (np.arange(PPD) + 0.5) / PPD
    cell = np.arange(N * N)
    bi = np.repeat(cell // N, PPD * PPD)          # y cell index
    bj = np.repeat(cell % N, PPD * PPD)           # x cell index
    px = np.tile(np.repeat(off, PPD), N * N)
    py = np.tile(np.tile(off, PPD), N * N)
    Xp0 = (bj + px) * DX
    Yp0 = (bi + py) * DX
    return Xp0, Yp0

_XP0, _YP0 = _base_grid_indices()

def _grid_base(xp, yp):
    jc = np.floor(xp / DX - 0.5).astype(np.int64)
    ic = np.floor(yp / DX - 0.5).astype(np.int64)
    return jc, ic

def g2p(omega, xp, yp):
    """Gather vorticity and analytic kernel gradient at particle positions."""
    jc, ic = _grid_base(xp, yp)
    xi = xp / DX
    yi = yp / DX
    op = np.zeros_like(xp)
    gx = np.zeros_like(xp)
    gy = np.zeros_like(xp)
    for ox in range(4):
        jj = jc + (ox - 1)
        okj = (jj >= 0) & (jj < N)
        sx = jj + 0.5 - xi
        wx = np.where(okj, n2(sx), 0.0)
        dnx = dn2(sx) * okj
        for oy in range(4):
            ii = ic + (oy - 1)
            oki = (ii >= 0) & (ii < N)
            sy = ii + 0.5 - yi
            wy = np.where(oki, n2(sy), 0.0)
            dny = dn2(sy) * oki
            w = wx * wy
            # gather the field value at (ii,jj) for each particle
            gg = omega[np.clip(ii, 0, N - 1), np.clip(jj, 0, N - 1)]
            op += w * gg
            gx -= (dnx * wy) * gg / DX
            gy -= (wx * dny) * gg / DX
    return op, gx, gy

def p2g(omega, W, xp, yp, op, gxp, gyp):
    """APIC P2G with weight normalization:
       omega_g = sum_p w_p (omega_p + grad_p.(x_g - x_p)) / sum_p w_p."""
    jc, ic = _grid_base(xp, yp)
    xi = xp / DX
    yi = yp / DX
    for ox in range(4):
        jj = jc + (ox - 1)
        okj = (jj >= 0) & (jj < N)
        sx = jj + 0.5 - xi
        wx = np.where(okj, n2(sx), 0.0)
        dxc = sx * DX
        for oy in range(4):
            ii = ic + (oy - 1)
            oki = (ii >= 0) & (ii < N)
            sy = ii + 0.5 - yi
            wy = np.where(oki, n2(sy), 0.0)
            dyc = sy * DX
            w = wx * wy
            ii_c = np.clip(ii, 0, N - 1)
            jj_c = np.clip(jj, 0, N - 1)
            aff = w * (gxp * dxc + gyp * dyc)
            np.add.at(omega, (ii_c, jj_c), w * op + aff)
            np.add.at(W, (ii_c, jj_c), w)
    return omega, W

# ----------------------------------------------------------------------------
# Semi-Lagrangian backward advection (RK4) of grid vorticity by dt_half
# ----------------------------------------------------------------------------
def semi_lagrangian_back(omega, ubar, vbar, dt_half):
    """omega_mid = omega_n back-advected dt_half via RK4, velocity u_n."""
    xs, ys = np.meshgrid((np.arange(N) + 0.5) * DX, (np.arange(N) + 0.5) * DX)
    x = xs.ravel()
    y = ys.ravel()
    h = dt_half
    k1x, k1y = vel_at(ubar, vbar, x, y)
    k2x, k2y = vel_at(ubar, vbar, x - 0.5 * h * k1x, y - 0.5 * h * k1y)
    k3x, k3y = vel_at(ubar, vbar, x - 0.5 * h * k2x, y - 0.5 * h * k2y)
    k4x, k4y = vel_at(ubar, vbar, x - h * k3x, y - h * k3y)
    xf = np.clip(x - (h / 6.0) * (k1x + 2 * k2x + 2 * k3x + k4x), 0.0, 1.0)
    yf = np.clip(y - (h / 6.0) * (k1y + 2 * k2y + 2 * k3y + k4y), 0.0, 1.0)
    return interp2(omega, xf, yf).reshape(N, N)

# ----------------------------------------------------------------------------
# Particle advection (RK4) of positions and flow-map gradient T
# ----------------------------------------------------------------------------
def advance_particles(u_mid, grad_mid, xp, yp, tp, dt):
    """RK4: dx/dt = u_mid(x), dT/dt = -(grad u_mid)^T . T, T(t_n)=I."""
    ubar, vbar = u_mid
    dudx, dudy, dvdx, dvdy = grad_mid

    def M(x, y):
        g11 = interp2(dudx, x, y); g12 = interp2(dudy, x, y)
        g21 = interp2(dvdx, x, y); g22 = interp2(dvdy, x, y)
        m = np.empty(x.shape + (2, 2))
        m[..., 0, 0] = -g11
        m[..., 1, 0] = -g21
        m[..., 0, 1] = -g12
        m[..., 1, 1] = -g22
        return m

    def U(x, y):
        return vel_at(ubar, vbar, x, y)

    k1x, k1y = U(xp, yp)
    k1T = dt * np.einsum('...ij,...jk->...ik', M(xp, yp), tp)
    x1, y1 = xp + 0.5 * k1x, yp + 0.5 * k1y
    t1 = tp + 0.5 * k1T
    k2x, k2y = U(x1, y1)
    k2T = dt * np.einsum('...ij,...jk->...ik', M(x1, y1), t1)
    x2, y2 = xp + 0.5 * k2x, yp + 0.5 * k2y
    t2 = tp + 0.5 * k2T
    k3x, k3y = U(x2, y2)
    k3T = dt * np.einsum('...ij,...jk->...ik', M(x2, y2), t2)
    x3, y3 = xp + k3x, yp + k3y
    t3 = tp + k3T
    k4x, k4y = U(x3, y3)
    k4T = dt * np.einsum('...ij,...jk->...ik', M(x3, y3), t3)
    xn = xp + (k1x + 2 * k2x + 2 * k3x + k4x) / 6.0
    yn = yp + (k1y + 2 * k2y + 2 * k3y + k4y) / 6.0
    tn = tp + (k1T + 2 * k2T + 2 * k3T + k4T) / 6.0
    return np.clip(xn, 0.0, 1.0), np.clip(yn, 0.0, 1.0), tn

# ----------------------------------------------------------------------------
# One VPFM substep
# ----------------------------------------------------------------------------
def substep(ux, uy, omega, dt):
    """Advance faces + grid vorticity by dt with one VPFM step."""
    # 1. reinit particles (uniform) and T = I
    xp = _XP0.copy()
    yp = _YP0.copy()
    tp = np.tile(np.eye(2), (NP, 1, 1)).reshape(NP, 2, 2)
    # 2. G2P: sample grid vorticity and analytic gradient
    op, gx, gy = g2p(omega, xp, yp)
    # 3. midpoint velocity: RK4 SL half-step + FRESH Poisson solve
    ubar, vbar = cell_center_velocity(ux, uy)
    omega_half = semi_lagrangian_back(omega, ubar, vbar, 0.5 * dt)
    psi_half = solve_psi(omega_half)
    uxm, uym = faces_from_psi(psi_half)
    u_mid = cell_center_velocity(uxm, uym)
    grad_mid = compute_grads(u_mid[0], u_mid[1])
    # 4. advect particles + T with midpoint velocity (RK4, full dt)
    xp, yp, tp = advance_particles(u_mid, grad_mid, xp, yp, tp, dt)
    # 5. APIC P2G, gradient corrected by flow map (grad_c = grad . T)
    gradc = np.einsum('bi,bij->bj', np.stack((gx, gy), axis=1), tp)
    omega_new = np.zeros((N, N))
    W = np.zeros((N, N))
    omega_new, W = p2g(omega_new, W, xp, yp, op, gradc[:, 0], gradc[:, 1])
    valid = W > 1e-30
    omega_new = np.where(valid, omega_new / np.where(valid, W, 1.0), 0.0)
    # 6. reconstruct new faces from the new vorticity
    psi_new = solve_psi(omega_new)
    ux, uy = faces_from_psi(psi_new)
    return ux, uy, omega_new

# ----------------------------------------------------------------------------
# Diagnostics (required recipes)
# ----------------------------------------------------------------------------
def record_frame(ux, uy):
    ubar, vbar = cell_center_velocity(ux, uy)
    ke = 0.5 * DX * DX * np.sum(ubar * ubar + vbar * vbar)
    dvdx = np.zeros((N, N))
    dvdx[:, 1:-1] = (vbar[:, 2:] - vbar[:, :-2]) / (2 * DX)
    dvdx[:, 0] = (vbar[:, 1] - vbar[:, 0]) / DX
    dvdx[:, -1] = (vbar[:, -1] - vbar[:, -2]) / DX
    dudy = np.zeros((N, N))
    dudy[1:-1, :] = (ubar[2:, :] - ubar[:-2, :]) / (2 * DX)
    dudy[0, :] = (ubar[1, :] - ubar[0, :]) / DX
    dudy[-1, :] = (ubar[-1, :] - ubar[-2, :]) / DX
    return dvdx - dudy, ke

# ----------------------------------------------------------------------------
# Main loop
# ----------------------------------------------------------------------------
def main():
    ux = ux0.copy()
    uy = uy0.copy()
    omega = vorticity_from_faces(ux, uy)

    ke = np.zeros(N_FRAMES + 1)
    vort = np.zeros((5, N, N))
    vmap = {0: 0, 26: 1, 52: 2, 78: 3, 104: 4}

    o0, k0 = record_frame(ux, uy)
    ke[0] = k0
    vort[0] = o0
    print('frame   0  t=  0.000  KE=%.10f' % k0)
    # sample solver residual (Dirichlet 5-pt Poisson, direct splu)
    rng = np.random.default_rng(0)
    _om_t = rng.standard_normal((N, N))
    _psi_t = solve_psi(_om_t)
    _res = _LA @ _psi_t.ravel() - _om_t.ravel() * DX * DX
    print('Poisson residual (direct splu) max = %.3e  (requirement < 1e-10)' % np.abs(_res).max())

    t = 0.0
    nsteps = 0
    for frame in range(1, N_FRAMES + 1):
        target = frame * DT_FRAME
        while t < target - EPS:
            maxvel = max(np.abs(ux).max(), np.abs(uy).max())
            dt = min(CFL * DX / maxvel, target - t)
            ux, uy, omega = substep(ux, uy, omega, dt)
            t += dt
            nsteps += 1
        o, k = record_frame(ux, uy)
        ke[frame] = k
        if frame in vmap:
            vort[vmap[frame]] = o
        print('frame %3d  t=%7.3f  KE=%.8f  nsteps=%d' % (frame, t, k, nsteps))

    np.save('vorticity_frames.npy', vort.astype(np.float32))
    np.save('kinetic_energy.npy', ke.astype(np.float32))
    print('saved vorticity_frames.npy', vort.shape, 'dtype', vort.astype(np.float32).dtype)
    print('saved kinetic_energy.npy', ke.shape, 'dtype', ke.astype(np.float32).dtype)
    return vort, ke

if __name__ == '__main__':
    main()
