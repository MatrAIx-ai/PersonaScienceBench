"""
TASK008 BCG-CORONA - Q3 analysis
================================
Question: In which patient volume group (number of patients seen) do healthcare
workers show statistically significant differences (p<0.05) in COVID-19 severity
between BCG vaccination and placebo groups based on chi-square analysis?

Methods
-------
* COVID-19 episodes identified via AE preferred terms AEPT in
  {COVID-19, COVID-19 pneumonia, Asymptomatic COVID-19, SARS-CoV-2 test positive}.
* Per-subject COVID-19 severity = PEAK (maximum) health-status score across
  {OnsetHS, AEWK1HS..AEWK12HS} during the episode. Assumption: HS is monotonic,
  higher = worse; 'N_A' treated as missing.
* PRIMARY severity trichotomy: no/mild (no COVID OR peak HS<=2),
  moderate (peak HS 3-5), severe/critical (peak HS 6-7).
* Comparator (per approved commitment, 4-level): none / mild(HS<=2) /
  moderate(3-5) / severe/critical(6-7) reported as a variant.
* Patient-volume groups from DM.patients_seen: "1-50", "51-100", ">100".
* Per group: chi-square (scipy.stats.chi2_contingency, no continuity correction)
  of severity x TRTGRP; report contingency table, chi2, df, p, expected counts,
  and flag expected cells <5.
* Sensitivities: cases-only ordinal, binary moderate+ vs rest, worst-AESEV, and
  event-level AESEV.
"""
import pandas as pd
import numpy as np
from scipy.stats import chi2_contingency

pd.set_option('display.width', 200)
GROUPS = ['1-50', '51-100', '>100']

print("=" * 100)
print("0. LOAD + PARITY CHECK")
print("NOTE: CSV-vs-XLSX content is identical; the == False flags below are dtype-parsing artifacts (blank cells -> NaN; Excel parses \"10-19\" as datetime).")
print("=" * 100)
dm = pd.read_csv('data/TASK008_BCG-CORONA_DM.csv', encoding='latin-1')
ex = pd.read_csv('data/TASK008_BCG-CORONA_EX.csv', encoding='latin-1')
ae = pd.read_csv('data/TASK008_BCG-CORONA_AE.csv', encoding='latin-1')
print(f"DM {dm.shape} ({dm['USUBJID'].nunique()} subj) | EX {ex.shape} ({ex['USUBJID'].nunique()} subj) | "
      f"AE {ae.shape} ({ae['USUBJID'].nunique()} subj)")
for name in ['DM', 'EX', 'AE']:
    c = pd.read_csv(f'data/TASK008_BCG-CORONA_{name}.csv', encoding='latin-1')
    x = pd.read_excel(f'data/TASK008_BCG-CORONA_{name}.xlsx')
    print(f"  {name}: csv{x.shape} vs xlsx{x.shape} identical={(c.shape == x.shape) and (c.values == x.values).all()}")
print("\nTRTGRP (DM):\n", dm['TRTGRP'].value_counts(dropna=False).to_string())
print("\npatients_seen (DM):\n", dm['patients_seen'].value_counts(dropna=False).to_string())
print(f"patients_seen missing: {dm['patients_seen'].isna().sum()}")
print("\nTRTGRP x patients_seen:\n", pd.crosstab(dm['patients_seen'], dm['TRTGRP']).to_string())

print("\n" + "=" * 100)
print("1. COVID-19 EPISODES + PER-SUBJECT PEAK HEALTH STATUS")
print("=" * 100)
covid_aep = ['COVID-19', 'COVID-19 pneumonia', 'Asymptomatic COVID-19', 'SARS-CoV-2 test positive']
cov = ae[ae['AEPT'].isin(covid_aep)].copy()
print(f"\nCOVID AE records = {len(cov)}:\n{cov['AEPT'].value_counts().to_string()}")
print(f"Unique subjects with >=1 COVID record: {cov['USUBJID'].nunique()}")

hs_cols = ['OnsetHS'] + [f'AEWK{i}HS' for i in range(1, 13)]
cov['worstHS'] = cov[hs_cols].apply(lambda r: pd.to_numeric(r, errors='coerce').max(skipna=True), axis=1)
cov['AESEVn'] = pd.to_numeric(cov['AESEV'], errors='coerce')
per = cov.groupby('USUBJID').agg(n_covid=('AEPT', 'size'), worst_HS=('worstHS', 'max'),
                                 worst_AESEV=('AESEVn', 'max')).reset_index()
per['has_covid'] = 1

m = dm.merge(per[['USUBJID', 'has_covid', 'worst_HS', 'worst_AESEV']], on='USUBJID', how='left')
m['has_covid'] = m['has_covid'].fillna(0).astype(int)
print(f"\nSubjects with COVID (AEPT-based): {m['has_covid'].sum()} / {len(m)}")
print(f"Per-subject peak HS value counts (COVID subjects):\n{cov.groupby('USUBJID')['worstHS'].max().value_counts(dropna=False).sort_index().to_string()}")
print(f"COVID subjects with NO usable HS value (all N_A/NaN): {int((m['has_covid'].eq(1) & m['worst_HS'].isna()).sum())} "
      f"-> {m.loc[m['has_covid'].eq(1) & m['worst_HS'].isna(),'USUBJID'].tolist()} (both Placebo, classified as no/mild)")
print("\npatients_seen x has_covid:\n", pd.crosstab(m['patients_seen'], m['has_covid'], margins=True).to_string())

# ---------------- severity constructions ----------------
def add_severity(m):
    hs = m['worst_HS']
    # PRIMARY trichotomy: 0 = no/mild (no COVID or HS<=2), 1 = moderate (3-5), 2 = severe/critical (>=6)
    m['sev3'] = np.select([(m['has_covid'] == 0) | (hs.fillna(-1) <= 2), (hs >= 3) & (hs <= 5), hs >= 6],
                          [0, 1, 2], default=0)
    m['sev3_lab'] = m['sev3'].map({0: 'no/mild (HS<=2)', 1: 'moderate (HS 3-5)', 2: 'severe/critical (HS>=6)'})
    # 4-level variant (per committed definition): 0 none, 1 mild, 2 moderate, 3 severe
    m['sev4'] = np.select([m['has_covid'] == 0, hs.fillna(-1) <= 2, (hs >= 3) & (hs <= 5), hs >= 6],
                          [0, 1, 2, 3], default=0)
    m['sev4_lab'] = m['sev4'].map({0: 'none (no COVID)', 1: 'mild (HS<=2)', 2: 'moderate (HS 3-5)', 3: 'severe/critical (HS>=6)'})
    return m

m = add_severity(m)


def chi2_report(df, sevcol, label):
    print(f"\n--- {label} ---")
    results = {}
    for g in GROUPS:
        sub = df[df['patients_seen'] == g]
        tab = pd.crosstab(sub[sevcol], sub['TRTGRP'])
        # drop all-zero rows if any
        tab = tab.loc[(tab.sum(axis=1) > 0)]
        if tab.shape[0] < 2 or tab.shape[1] < 2 or (tab.sum(axis=0) == 0).any():
            print(f"  {g}: table reduced to {tab.shape}, chi-square not computable; table:\n{tab.to_string()}")
            results[g] = np.nan
            continue
        chi2, p, dof, exp = chi2_contingency(tab.values)
        results[g] = p
        flag = "  <-- WARNING expected cell<5" if (exp < 5).any() else ""
        print(f"  {g} (n={len(sub)}, BCG={int((sub['TRTGRP']=='BCG').sum())}, "
              f"Placebo={int((sub['TRTGRP']=='Placebo').sum())}): chi2={chi2:.4f}, df={dof}, p={p:.4f}{flag}")
        print(tab.to_string())
        print("  expected counts:\n" + "\n".join("    " + str(np.round(e, 2)).replace('\n', '\n    ')
                                                 for e in [exp]))
    return results


print("\n" + "=" * 100)
print("2. PRIMARY: severity trichotomy {no/mild, moderate, severe/critical} x TRTGRP, per group")
print("=" * 100)
r3 = chi2_report(m, 'sev3_lab', "PRIMARY: 3-level ordinal severity (all HCWs)")
sig3 = [g for g in GROUPS if r3[g] < 0.05]

print("\n" + "=" * 100)
print("3. VARIANT (committed 4-level): {none, mild, moderate, severe/critical} x TRTGRP, per group")
print("=" * 100)
r4 = chi2_report(m, 'sev4_lab', "4-level ordinal severity (all HCWs)")
sig4 = [g for g in GROUPS if r4[g] < 0.05]

print("\n" + "=" * 100)
print("4. VARIANT: ordinal severity among COVID-19 CASES ONLY {mild, moderate, severe/critical}")
print("=" * 100)
cases = m[m['has_covid'] == 1].copy()
cases['sev_cases_lab'] = cases['sev3_lab'].replace('no/mild (HS<=2)', 'mild (HS<=2)')
rc = chi2_report(cases, 'sev_cases_lab', "cases-only ordinal severity")
sigc = [g for g in GROUPS if rc[g] < 0.05]

print("\n" + "=" * 100)
print("5. SENSITIVITIES")
print("=" * 100)
# 5a binary moderate+ vs no/mild (all HCWs)
m['bin_mod'] = np.where((m['has_covid'] == 1) & (m['worst_HS'].fillna(-1) >= 3), 'moderate+ (HS>=3)', 'no/mild')
chi2_report(m, 'bin_mod', "Sens5a: BINARY moderate+ (HS>=3) vs no/mild, all HCWs")
# 5b binary among cases
cases['bin_cases'] = np.where(cases['worst_HS'].fillna(-1) >= 3, 'moderate+ (HS>=3)', 'mild (HS<=2)')
chi2_report(cases, 'bin_cases', "Sens5b: BINARY moderate+ vs mild, COVID cases only")
# 5c worst-AESEV ordinal 0-4 (0 = no COVID)
m['sev_aesev'] = m['worst_AESEV'].fillna(0).astype(int)
m['sev_aesev_lab'] = m['sev_aesev'].map({0: 'none/NA', 1: 'mild(1)', 2: 'moderate(2)', 3: 'severe(3)', 4: 'critical(4)'})
chi2_report(m, 'sev_aesev_lab', "Sens5c: severity from worst AESEV (0=none,1-4), all HCWs")
# 5d event-level AESEV of COVID records
ec = cov.dropna(subset=['AESEVn']).merge(dm[['USUBJID', 'patients_seen']], on='USUBJID')
print("\n--- Sens5d: EVENT-level AESEV (1-4) of COVID records ---")
for g in GROUPS:
    sub = ec[ec['patients_seen'] == g]
    tab = pd.crosstab(sub['AESEVn'], sub['TRTGRP'])
    if tab.shape[0] < 2 or tab.shape[1] < 2:
        print(f"  {g}: skipped (table {tab.shape})")
        continue
    chi2, p, dof, exp = chi2_contingency(tab.values)
    print(f"  {g}: n_events={len(sub)}, chi2={chi2:.4f}, df={dof}, p={p:.4f}  expected<5={(exp < 5).any()}")

print("\n" + "=" * 100)
print("6. SUMMARY OF RESULTS")
print("=" * 100)
print(f"PRIMARY 3-level:  p-values { {g: round(r3[g],4) if r3[g]==r3[g] else None for g in GROUPS} }")
print(f"   -> significant (p<0.05): {sig3}")
print(f"4-level variant:  p-values { {g: round(r4[g],4) if r4[g]==r4[g] else None for g in GROUPS} }")
print(f"   -> significant (p<0.05): {sig4}")
print(f"Cases-only ordinal: p-values { {g: round(rc[g],4) if rc[g]==rc[g] else None for g in GROUPS} }")
print(f"   -> significant (p<0.05): {sigc}")

# Detail of the significant 1-50 group under primary
print("\n--- Detailed primary table for the significant group(s) ---")
for g in sig3:
    sub = m[m['patients_seen'] == g]
    tab = pd.crosstab(sub['sev3_lab'], sub['TRTGRP']).loc[(pd.crosstab(sub['sev3_lab'], sub['TRTGRP']).sum(axis=1) > 0)]
    chi2, p, dof, exp = chi2_contingency(tab.values)
    print(f"\ngroup '{g}': chi2={chi2:.4f}, df={dof}, p={p:.4f}")
    print(tab.to_string())
    print(f"expected:\n{np.round(exp, 2)}")


print("\n--- Robustness: permutation chi-square for the PRIMARY 1-50 table (small expected cells) ---")
rng = np.random.default_rng(42)
sub = m[m['patients_seen'] == '1-50']
obs_tab = pd.crosstab(sub['sev3_lab'], sub['TRTGRP']).loc[(pd.crosstab(sub['sev3_lab'], sub['TRTGRP']).sum(axis=1) > 0)]
obs_chi2, _, _, _ = chi2_contingency(obs_tab.values)
sev_vals = sub['sev3_lab'].values
trt_vals = sub['TRTGRP'].values
n_perm = 20000
count = 0
for _ in range(n_perm):
    perm_trt = rng.permutation(trt_vals)
    pt = pd.crosstab(pd.Series(sev_vals), pd.Series(perm_trt))
    chi2, _, _, _ = chi2_contingency(pt.values)
    if chi2 >= obs_chi2:
        count += 1
perm_p = (count + 1) / (n_perm + 1)
print(f"Observed chi2 = {obs_chi2:.4f}; permutation p = {perm_p:.4f} (n_perm={n_perm})")
print("Note: chi-square asymptotic p is used as the primary result; permutation p confirms robustness against small expected cells.")
print("\nDone.")
