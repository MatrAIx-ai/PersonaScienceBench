"""
BixBench bix-14-q3: CHIP exonic non-reference variant count across 86 samples.
After filtering out reference variant calls and variants located in intronic,
intergenic, or UTR regions, count non-reference exonic variants in CHIP genes
from the 86 samples.

Counting rule (approved):
- Non-reference call = Zygosity in {Heterozygous, Homozygous Variant}
  ('Reference' and NaN/no-call rows are dropped).
- Region filter: drop SO terms that are intronic / intergenic / UTR
  (3_prime_UTR, 5_prime_UTR, 5_prime_UTR_premature_start_codon_gain).
- CHIP membership: case-insensitive join of the per-row Match gene to the
  56-gene list (files are pre-filtered, In_CHIP=True everywhere; kept for safety).
- Unit = variant-sample OCCURRENCES summed across the 86 sample files.
Sensitivity checks reported separately (do NOT merge into the primary number).
"""
import pandas as pd, glob, os, collections, json

DATA = "data"
GENE_XLSX = os.path.join(DATA, "230214_Schenz_et_al_2022_CHIP_Genes.xlsx")
VARDIR = os.path.join(DATA, "CHIP_DP10_GQ20_PASS")
TRIO_XLSX = os.path.join(DATA, "230215_Trio_Status.xlsx")

# ---- 1. CHIP gene list (56 genes) ---------------------------------------
chip_genes = pd.read_excel(GENE_XLSX, header=None)[0].astype(str).str.strip().str.upper()
chip_set = set(chip_genes)
print("CHIP gene list size:", len(chip_set))

# ---- 2. 86 sample files --------------------------------------------------
files = sorted(glob.glob(os.path.join(VARDIR, "*.xlsx")))
assert len(files) == 86, f"expected 86 files, got {len(files)}"
print("Variant files:", len(files))

# ---- 3. Trio status (documentation: 87 rows, 533 has no file) -----------
trio = pd.read_excel(TRIO_XLSX)
trio_ids = [str(x).strip() for x in trio["Sample ID"]]
print("Trio sample rows:", len(trio_ids), "| unique:", len(set(trio_ids)))

# ---- 4. Load all rows ----------------------------------------------------
rows = []
for f in files:
    sid = os.path.basename(f).replace("230209_Exome_GRCh38_CHIP_", "").replace(".xlsx", "")
    df = pd.read_excel(f, header=None, skiprows=2)
    if df.empty:
        continue
    for _, r in df.iterrows():
        rows.append({
            "sample": sid,
            "chrpos": str(r[0]) if pd.notna(r[0]) else None,
            "refalt": str(r[1]) if pd.notna(r[1]) else None,
            "zygosity": str(r[4]).strip() if pd.notna(r[4]) else None,
            "gene_names": str(r[12]).strip() if pd.notna(r[12]) else None,
            "so": str(r[13]).strip() if pd.notna(r[13]) else None,
            "in_chip": str(r[29]).strip().lower() if pd.notna(r[29]) else None,
            "match": str(r[30]).strip() if pd.notna(r[30]) else None,
        })
D = pd.DataFrame(rows)
print("Total variant rows loaded:", len(D))

# ---- 5. Diagnostics: zygosity and SO term counts (all rows) -------------
print("\n--- Zygosity (call) counts over all 57,258 rows ---")
print(D["zygosity"].value_counts(dropna=False).to_string())
print("\n--- SO term counts over all rows ---")
print(D["so"].value_counts(dropna=False).to_string())

# ---- 6. Membership filter: case-insensitive vs 56-gene list -------------
D["match_upper"] = D["match"].str.upper()
D["in_chip_list"] = D["match_upper"].isin(chip_set)
n_not_in_list = int((~D["in_chip_list"]).sum())
D_chip = D[D["in_chip_list"]]
print("\n--- CHIP membership (Match col, case-insensitive) ---")
print("rows NOT in 56-gene list:", n_not_in_list, "| kept:", len(D_chip))

# sanity: In_CHIP flag
print("In_CHIP=True rows:", int((D["in_chip"] == "true").sum()),
      "| In_CHIP values:", D["in_chip"].value_counts().to_dict())

# ---- 7. Non-reference filter ---------------------------------------------
NONREF = {"Heterozygous", "Homozygous Variant"}
D_nr = D_chip[D_chip["zygosity"].isin(NONREF)]
print("\n--- Non-reference filter (drop Reference + NaN) ---")
print("non-reference rows:", len(D_nr),
      "| reference rows:", int((D_chip["zygosity"] == "Reference").sum()),
      "| no-call/NaN rows:", int(D_chip["zygosity"].isna().sum()))

# ---- 8. Region filter ----------------------------------------------------
# Excluded under question wording: intronic, intergenic, UTR.
# Implement via exact SO terms present in these files (robust substring also checked).
EXCLUDED_SO = {
    "intron_variant", "intergenic_region", "intergenic_variant",
    "3_prime_UTR_variant", "5_prime_UTR_variant",
    "5_prime_UTR_premature_start_codon_gain_variant",
}
def is_excluded(so):
    if so is None:
        return False
    if so in EXCLUDED_SO:
        return True
    lo = so.lower()
    return ("intron" in lo) or ("intergenic" in lo) or ("utr" in lo)

D_nr["excluded"] = D_nr["so"].apply(is_excluded)
# verify substring and exact-set agree
exact_excl = D_nr["so"].isin(EXCLUDED_SO)
sub_excl = D_nr["so"].apply(lambda s: s is not None and any(k in s.lower() for k in ("intron", "intergenic", "utr")))
assert (exact_excl == sub_excl).all(), "exact and substring exclusion differ"

print("\n--- Region filter (drop intronic/intergenic/UTR) ---")
print(D_nr["so"].value_counts().to_string())
D_keep = D_nr[~D_nr["excluded"]]
print("\n--- Kept (exonic per filter) SO terms ---")
print(D_keep["so"].value_counts().to_string())

# ---- 9. PRIMARY count: occurrences across the 86 samples -----------------
primary_occurrences = len(D_keep)
print("\n=== PRIMARY ANSWER (variant-sample occurrences) ===", primary_occurrences)

# ---- 10. Sensitivity checks ----------------------------------------------
sens = {}
sens["a_excl_splice"] = len(D_keep[D_keep["so"] != "splice_region_variant"])
sens["b_excl_upstream"] = len(D_keep[D_keep["so"] != "upstream_gene_variant"])
sens["c_excl_both"] = len(D_keep[~D_keep["so"].isin({"splice_region_variant", "upstream_gene_variant"})])
# distinct positions (union of Chr:Pos|Ref/Alt across samples) among kept
D_keep["var_id"] = D_keep["chrpos"].astype(str) + "|" + D_keep["refalt"].astype(str)
sens["d_distinct_positions"] = int(D_keep["var_id"].nunique())
print("\n--- Sensitivity ---")
for k, v in sens.items():
    print(f"  {k}: {v}")

# per-sample contribution (top file contributions, for diagnostics)
per_file = D_keep.groupby("sample").size()
print("\nPer-sample kept counts: min={}, max={}, mean={:.2f}, n_with_0={}".format(
    per_file.min(), per_file.max(), per_file.mean(), int((per_file == 0).sum())))

# ---- 11. Summary JSON ----------------------------------------------------
summary = {
    "n_gene_list": len(chip_set),
    "n_files": len(files),
    "n_total_rows": len(D),
    "n_rows_not_in_gene_list": n_not_in_list,
    "n_nonreference": int(len(D_nr)),
    "n_kept_exonic_occurrences": primary_occurrences,
    "sensitivity": sens,
}
with open("summary.json", "w") as fh:
    json.dump(summary, fh, indent=2)
print("\nsummary.json written:", json.dumps(summary))
print("\nDONE")
