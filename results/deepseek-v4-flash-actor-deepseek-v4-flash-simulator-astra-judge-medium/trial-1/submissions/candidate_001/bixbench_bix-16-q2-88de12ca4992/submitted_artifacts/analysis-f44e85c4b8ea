#!/usr/bin/env python3
"""
Skewness of the gene expression (log2(TPM+1)) distribution across all cell lines.
Input : data/OmicsExpressionProteinCodingGenesTPMLogp1BatchCorrected.csv
        Values are ALREADY log2(TPM+1) and batch corrected (negatives confirm batch correction);
        no re-transform is applied.
Method: Pool all gene x cell-line values into one vector (primary) + per-gene & per-cell-line
        summary skewness (robustness). Fisher-Pearson sample skewness reported with bias-corrected G1.
"""
import json
import numpy as np
import pandas as pd
from scipy import stats
try:
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt
    HAVE_MPL = True
except Exception:
    HAVE_MPL = False
    import sys, os
    sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
    from pngwriter import render_histogram_png, render_histogram_svg

# ---------- load ----------
df = pd.read_csv("data/OmicsExpressionProteinCodingGenesTPMLogp1BatchCorrected.csv", index_col=0)

# ---------- pool all values ----------
mat = df.to_numpy(dtype=np.float64)
n_total = mat.size
n_nan = int(np.isnan(mat).sum())
v = mat[~np.isnan(mat)]
n = v.size

# ---------- headline skewness ----------
g1 = stats.skew(v, bias=True)          # Fisher-Pearson sample skewness (the headline)
G1 = stats.skew(v, bias=False)         # adjusted / bias-corrected
ex_kurt = stats.kurtosis(v, fisher=True, bias=False)

quants = [0.001, 0.01, 0.05, 0.25, 0.5, 0.75, 0.95, 0.99, 0.999]
q = {str(p): float(np.quantile(v, p)) for p in quants}

# ---------- robustness: per-gene and per-cell-line skewness ----------
# per-gene: skewness of that gene's expression across cell lines
per_gene = stats.skew(mat, axis=0, bias=True, nan_policy="omit")
per_gene = per_gene[~np.isnan(per_gene)]
# per-cell-line: skewness of that cell line's expression across genes
per_cl = stats.skew(mat, axis=1, bias=True, nan_policy="omit")
per_cl = per_cl[~np.isnan(per_cl)]

robust = {
    "per_gene_skew": {
        "n_genes": int(len(per_gene)),
        "mean": float(per_gene.mean()),
        "median": float(np.median(per_gene)),
        "pct_positive": float((per_gene > 0).mean() * 100.0),
        "min": float(per_gene.min()),
        "max": float(per_gene.max()),
    },
    "per_cell_line_skew": {
        "n_cell_lines": int(len(per_cl)),
        "mean": float(per_cl.mean()),
        "median": float(np.median(per_cl)),
        "pct_positive": float((per_cl > 0).mean() * 100.0),
        "min": float(per_cl.min()),
        "max": float(per_cl.max()),
    },
}

res = {
    "shape_n_cell_lines": int(df.shape[0]),
    "shape_n_genes": int(df.shape[1]),
    "n_pooled_values": int(n_total),
    "n_nan": n_nan,
    "already_log2tpm1_batch_corrected": True,
    "no_retransform_applied": True,
    "min": float(v.min()),
    "max": float(v.max()),
    "mean": float(v.mean()),
    "median": float(np.median(v)),
    "std_ddof1": float(v.std(ddof=1)),
    "variance_ddof1": float(v.var(ddof=1)),
    "pct_negative": float((v < 0).mean() * 100.0),
    "pct_zero": float((v == 0).mean() * 100.0),
    "skew_fisher_pearson_sample_g1": float(g1),
    "skew_bias_corrected_G1": float(G1),
    "excess_kurtosis": float(ex_kurt),
    "quantiles": q,
    "robustness": robust,
    "interpretation": (
        "The pooled gene-expression distribution across all cell lines is "
        f"right-skewed (Fisher-Pearson g1 = {g1:.4f}, bias-corrected G1 = {G1:.4f}), "
        f"with mean {v.mean():.3f} > median {np.median(v):.3f} and a long right tail "
        f"extending to {v.max():.2f}, i.e., a relatively small set of highly expressed "
        "genes in individual cell lines pulls the upper tail out, while most values are "
        "low (near-0 log2(TPM+1)) — a classic signature of heterogeneously expressed "
        "protein-coding genes on the log2(TPM+1) scale."
    ),
}

print(json.dumps(res, indent=2))

# ---------- density histogram ----------
n_bins = 200
counts, edges = np.histogram(v, bins=n_bins)
if HAVE_MPL:
    fig, ax = plt.subplots(figsize=(9, 4.5))
    ax.hist(v, bins=n_bins, color="steelblue", density=True)
    ax.set_xlabel("log2(TPM+1) expression (batch corrected)")
    ax.set_ylabel("density")
    ax.set_title(
        "Pooled gene expression across all cell lines "
        f"(n={n:,})\nFisher-Pearson skew g1 = {g1:.4f}; bias-corrected G1 = {G1:.4f}"
    )
    fig.tight_layout()
    fig.savefig("plots/expr_distribution.png", dpi=110)
else:
    render_histogram_png("plots/expr_distribution.png", counts, edges)
    render_histogram_svg(
        "plots/expr_distribution.svg", counts, edges,
        title=("Pooled gene expression across all cell lines "
               f"(n={n:,}); Fisher-Pearson skew g1 = {g1:.4f}, bias-corrected G1 = {G1:.4f}"))
    print("Saved plots/expr_distribution.png  and  plots/expr_distribution.svg (std-lib renderer)")
print("Saved plots/expr_distribution.png")

with open("results_summary.json", "w") as f:
    json.dump(res, f, indent=2)
print("Saved results_summary.json")
