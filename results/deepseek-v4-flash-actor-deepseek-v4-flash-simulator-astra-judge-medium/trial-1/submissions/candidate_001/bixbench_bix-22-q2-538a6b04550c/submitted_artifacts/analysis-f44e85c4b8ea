"""
BixBench bix-22-q2: Pearson correlation between gene length and mean expression
across CD4 immune-cell samples, for protein-coding genes.

Locked-in approach (approved):
- Expression  = raw batch-corrected read counts; per-gene arithmetic mean across
  the 151 CD4 sample columns. No log/CPM transform (literal reading of the question).
- Gene set    = all genes with gene_biotype=='protein_coding' (19,942), including
  the 1,518 with mean expression == 0 across CD4. No extra filtering.
- Length      = GeneMetaInfo.Length used as-is (bp), joined by Geneid (1:1, complete).
- CD4 samples = all 151 columns whose name ends in 'CD4' after stripping a trailing
  _N suffix; verified identical to Sample_annotated celltype=='CD4'.
"""
import re
import numpy as np
import pandas as pd
from scipy import stats

DATA = 'data'
GENE = f'{DATA}/GeneMetaInfo_Zenodo.csv'
COUNT = f'{DATA}/BatchCorrectedReadCounts_Zenodo.csv'
ANNOT = f'{DATA}/Sample_annotated_Zenodo.csv'

# 1) Gene metadata
gene = pd.read_csv(GENE)
assert list(gene.columns) == ['Unnamed: 0', 'Geneid', 'Chr', 'Length', 'gene_biotype']
assert gene['Geneid'].is_unique and len(gene) == 59453
assert gene['Length'].notna().all() and (gene['Length'] > 0).all()

# 2) CD4 sample set from annotation (authoritative)
annot = pd.read_csv(ANNOT)
cd4_annotation = set(annot.loc[annot['celltype'] == 'CD4', 'sample'])
assert len(cd4_annotation) == 151

# 3) Load the read-count matrix restricted to CD4 columns (column filter -> fast load)
def keep_col(c):
    if c == 'Unnamed: 0':
        return True
    stem = re.sub(r'_\d+$', '', c)
    return stem.endswith('CD4')

counts = pd.read_csv(COUNT, usecols=keep_col)
assert list(counts.columns)[1:] == sorted(list(counts.columns)[1:]) or True  # no order assumption

# Verify the CD4 columns selected by suffix == annotation CD4 set
suffix_cd4 = [c for c in counts.columns if c != 'Unnamed: 0']
assert set(suffix_cd4) == cd4_annotation, (set(suffix_cd4) - cd4_annotation, cd4_annotation - set(suffix_cd4))
print(f'CD4 columns used (from annotation, verified vs matrix suffix): {len(suffix_cd4)}')

# 4) Row key = Geneid
gene_ids = counts['Unnamed: 0']
assert gene_ids.is_unique and len(gene_ids) == 59453
assert set(gene_ids) == set(gene['Geneid']), 'row/annotation gene set mismatch'

# 5) Restrict to protein-coding genes; join Length
protein_coding = gene[gene['gene_biotype'] == 'protein_coding'][['Geneid', 'Length']].copy()
print(f'protein_coding genes: {len(protein_coding)}')
assert protein_coding['Geneid'].is_unique and protein_coding['Length'].notna().all() and (protein_coding['Length'] > 0).all()

mat = counts.set_index('Unnamed: 0').loc[protein_coding['Geneid']].astype(float)
assert not mat.isna().any().any(), 'unexpected NaN in CD4 expression'
assert (mat.values >= 0).all()

# 6) Per-gene arithmetic mean across the 151 CD4 columns
mean_expr = mat.mean(axis=1).rename('mean_expr')
df = protein_coding.merge(mean_expr, left_on='Geneid', right_index=True)
assert len(df) == 19942 and df['mean_expr'].notna().all()

n_zeros = int((df['mean_expr'] == 0).sum())
print(f'protein-coding genes with mean==0 across CD4 (kept): {n_zeros}')

# 7) Pearson correlation (identical to scipy or numpy)
r_np = float(np.corrcoef(df['Length'], df['mean_expr'])[0, 1])
r_scipy = float(stats.pearsonr(df['Length'], df['mean_expr']).statistic)
assert abs(r_np - r_scipy) < 1e-12
print(f'Pearson r (raw mean, all protein-coding, n={len(df)}): {r_scipy:.8f}')

# 8) Documented sensitivity side-notes (NOT the reported answer)
df_log = df.copy(); df_log['log1p'] = np.log1p(df_log['mean_expr'])
r_log = float(stats.pearsonr(df_log['Length'], df_log['log1p']).statistic)
exp = df[df['mean_expr'] > 0]
r_exp = float(stats.pearsonr(exp['Length'], exp['mean_expr']).statistic)
print(f'[side-note] r with log1p(mean): {r_log:.6f}  (raw counts remain the reported answer)')
print(f'[side-note] r excluding mean==0 genes (n={len(exp)}): {r_exp:.6f}')

result = dict(
    n_genes=int(len(df)),
    n_cd4_samples=int(len(suffix_cd4)),
    n_zero_expression_protein_coding=int(n_zeros),
    pearson_r=round(r_scipy, 6),
    method='raw batch-corrected counts, arithmetic mean across 151 CD4 columns; pearson(Length_bp, mean_expr); all protein_coding genes',
)
pd.Series(result).to_csv('result_summary.csv')
print('saved result_summary.csv')
print(result)
