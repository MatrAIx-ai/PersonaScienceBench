"""BixBench bix-22-q4: Pearson correlation between gene length and mean expression
for protein-coding genes in CD14 immune cells.

Primary: per-gene mean expression = arithmetic mean of RAW batch-corrected counts
across all 132 CD14 samples, paired with Length (bp), Pearson r via scipy.

Sensitivities (clearly labeled, not the headline):
  (a) Pearson(log2(mean+1)) vs Length
  (b) Pearson(mean of log2(count+1) across samples) vs Length
Also: n protein-coding genes with mean expression == 0 across CD14.
"""
import pandas as pd
import numpy as np
from scipy.stats import pearsonr
import json

def fmt(r, p, n):
    return f"r = {r:.6f}  (95% CI approx)  p = {p:.3e}  n = {n}  r^2 = {r*r:.6f}"

g = pd.read_csv('data/GeneMetaInfo_Zenodo.csv')
c = pd.read_csv('data/BatchCorrectedReadCounts_Zenodo.csv')
s = pd.read_csv('data/Sample_annotated_Zenodo.csv')

# --- alignment guard: verify gene ids identical in same order ---
assert (g['Geneid'].astype(str).values == c.iloc[:,0].astype(str).values).all(), "gene order mismatch"
assert g['Geneid'].notna().all() and not g['Geneid'].duplicated().any()
assert g['Length'].notna().all() and (g['Length'] > 0).all()

# --- CD14 samples from annotation, all present as count columns ---
cd14 = s.loc[s['celltype'] == 'CD14', 'sample'].tolist()
assert len(cd14) == 132 and all(x in c.columns for x in cd14)

# --- restrict to protein-coding genes ---
pc_mask = (g['gene_biotype'] == 'protein_coding').to_numpy()
print(f"protein-coding genes: {int(pc_mask.sum())}")

# --- per-gene mean expression over CD14 samples (raw counts) ---
cd14_mat = c[cd14].to_numpy(dtype=float)          # (n_genes_all, 132)
cd14_pc = cd14_mat[pc_mask, :]                     # (19942, 132)
mean_raw = cd14_pc.mean(axis=1)                    # arithmetic mean of raw counts
length = g.loc[pc_mask, 'Length'].to_numpy(float)

# --- primary: Pearson on raw means ---
r0, p0 = pearsonr(length, mean_raw)
print("\nPRIMARY (raw batch-corrected counts mean across 132 CD14 samples):")
print(" ", fmt(r0, p0, len(length)))

# --- sensitivity (a): log2(mean+1) ---
rA, pA = pearsonr(length, np.log2(mean_raw + 1.0))
print("\nSENSITIVITY (a) Pearson(log2(mean+1) vs Length):")
print(" ", fmt(rA, pA, len(length)))

# --- sensitivity (b): mean of log2(count+1) across samples ---
mean_log2 = np.log2(cd14_pc + 1.0).mean(axis=1)
rB, pB = pearsonr(length, mean_log2)
print("\nSENSITIVITY (b) Pearson(mean-of-log2(count+1) vs Length):")
print(" ", fmt(rB, pB, len(length)))

# --- zero-mean impact gauge ---
n_zero_mean = int((mean_raw == 0).sum())
print(f"\nprotein-coding genes with mean expression == 0 across CD14: {n_zero_mean} "
      f"({n_zero_mean/len(length)*100:.2f}%)")

# --- persist machine-readable results ---
out = {
    "n_protein_coding": int(len(length)),
    "n_cd14_samples": len(cd14),
    "primary_raw": {"r": round(float(r0), 6), "r2": round(float(r0*r0), 6),
                    "p": float(p0), "n": int(len(length))},
    "sensitivity_a_log2_meanp1_vs_length": {"r": round(float(rA), 6), "r2": round(float(rA*rA), 6), "p": float(pA)},
    "sensitivity_b_mean_log2p1_vs_length": {"r": round(float(rB), 6), "r2": round(float(rB*rB), 6), "p": float(pB)},
    "protein_coding_with_zero_mean_across_CD14": int(n_zero_mean),
}
with open('analysis/results.json', 'w') as f:
    json.dump(out, f, indent=2)
print("\nSaved analysis/results.json")
