"""
BixBench bix-22-q6: Pearson correlation between gene length and gene expression,
protein-coding genes only.

Data:
  - GeneMetaInfo_Zenodo.csv          (gene annotation: Geneid, Chr, Length, gene_biotype)
  - BatchCorrectedReadCounts_Zenodo.csv (genes x 723 samples, integer count-level values)
  - Sample_annotated_Zenodo.csv      (723 x 6 sample metadata)

Joined keys (verified 1:1 exact, no gaps/duplicates):
  GeneMetaInfo.Geneid <-> BatchCorrectedReadCounts index
  BatchCorrectedReadCounts columns <-> Sample_annotated.sample

Fixed definitions (per researcher approval):
  - protein-coding = gene_biotype == 'protein_coding'  (exact match; 19,942 genes)
  - per-gene expression = arithmetic mean of batch-corrected counts across all 723 samples
  - sensitivity: (i) 'contains protein_coding' 19,954-definition; (ii) median-based expression
"""
import numpy as np
import pandas as pd
from scipy import stats

# ------------------------------------------------------------------ load
gene = pd.read_csv("data/GeneMetaInfo_Zenodo.csv", index_col=0)          # Unnamed: 0
counts = pd.read_csv("data/BatchCorrectedReadCounts_Zenodo.csv", index_col=0)  # Unnamed: 0
annot = pd.read_csv("data/Sample_annotated_Zenodo.csv")

# ------------------------------------------------------------------ join checks (sanity)
assert (gene.index == gene["Geneid"]).all(), "index != Geneid"
assert (counts.index == gene.index).all(), "counts index != gene index"
assert sorted(counts.columns) == sorted(annot["sample"]), "sample ID mismatch"
assert counts.isna().sum().sum() == 0
assert (counts < 0).sum().sum() == 0
print(f"genes {counts.shape[0]}, samples {counts.shape[1]}  | joins exact, no NaN/negatives")

# ------------------------------------------------------------------ primary filter
pc = gene["gene_biotype"] == "protein_coding"
n_pc = int(pc.sum())
print(f"protein_coding (exact match) n = {n_pc}")

mean_expr = counts.loc[pc].mean(axis=1)          # mean across all 723 samples
median_expr = counts.loc[pc].median(axis=1)
length = gene.loc[pc, "Length"].astype(float)

# ------------------------------------------------------------------ (a) untransformed Pearson
r_a, p_a = stats.pearsonr(length, mean_expr)
n_a = len(length)
# Fisher z 95% CI
z = np.arctanh(r_a); se = 1/np.sqrt(n_a-3)
ci_a = (np.tanh(z-1.96*se), np.tanh(z+1.96*se))
print(f"\n(a) Pearson(Length, mean_expr) raw values: r={r_a:.6f}, p={p_a:.3e}, n={n_a}, 95%CI={tuple(round(v,4) for v in ci_a)}")

# ------------------------------------------------------------------ (b) log10(length) vs log10(mean+1)
r_b, p_b = stats.pearsonr(np.log10(length), np.log10(mean_expr + 1))
z = np.arctanh(r_b)
ci_b = (np.tanh(z-1.96*se), np.tanh(z+1.96*se))
print(f"(b) Pearson(log10 Length, log10(mean_expr+1)): r={r_b:.6f}, p={p_b:.3e}")
print(f"    r={r_b:.6f}, p={p_b:.3e}, n={len(length)}, 95%CI={tuple(round(v,4) for v in ci_b)}")

# ------------------------------------------------------------------ (c) log10(length) vs log10(median+1) sensitivity
r_c, p_c = stats.pearsonr(np.log10(length), np.log10(median_expr + 1))
print(f"(c) Pearson(log10 Length, log10(median_expr+1)): r={r_c:.6f}, p={p_c:.3e}, n={len(length)}")

# ------------------------------------------------------------------ sensitivity: 19,954 definition
pc_contains = gene["gene_biotype"].str.contains("protein_coding", na=False)
n_pcx = int(pc_contains.sum())
mean_expr_x = counts.loc[pc_contains].mean(axis=1)
length_x = gene.loc[pc_contains, "Length"].astype(float)
r_ax, _ = stats.pearsonr(length_x, mean_expr_x)
r_bx, _ = stats.pearsonr(np.log10(length_x), np.log10(mean_expr_x + 1))
print(f"\nSENSITIVITY 'contains protein_coding' n={n_pcx}: raw r={r_ax:.6f}, log-log r={r_bx:.6f}")

# ------------------------------------------------------------------ summary table
print("\n=== SUMMARY ===")
print(f"definition: exact gene_biotype=='protein_coding', n={n_pc} (19,954-def: {n_pcx})")
print(f"expression: mean batch-corrected counts over {counts.shape[1]} samples")
print(f"(a) untransformed Pearson(Length, mean_expr)             r = {r_a:.6f}")
print(f"(b) log10 Pearson(log10L, log10(mean_expr+1))           r = {r_b:.6f}")
print(f"(c) sensitivity log10 Pearson(log10L, log10(median+1))  r = {r_c:.6f}")
