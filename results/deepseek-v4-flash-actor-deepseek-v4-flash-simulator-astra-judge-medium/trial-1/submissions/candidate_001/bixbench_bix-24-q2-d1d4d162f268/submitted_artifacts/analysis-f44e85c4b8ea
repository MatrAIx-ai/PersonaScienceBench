#!/usr/bin/env python3
"""
BixBench bix-24-q2 - CBD vs DMSO in CRC cells:
Does UP- or DOWN-regulation primarily drive the metabolic effects of CBD?

Pipeline (fully offline, pure Python):
  1. Load counts_raw_unfiltered.csv + sample_layout.csv; confirm schema.
  2. DESeq2-equivalent DE  (CBD_IC50 vs DMSO, vehicle control; padj<0.05, |log2FC|>0.5)
     implemented from scratch (median-of-ratios size factors, NB dispersion trend+MAP
     shrinkage, NB-GLM Wald test, BH).
  3. edgeR-style cross-check (upper-quartile normalization, tagwise dispersion,
     exact NB test) for concordance.
  4. Robustness: 30-sample NB-GLM with serum-starvation covariate (CBD coefficient)
     and an 18-sample no-cisplatin variant. Heavy step cached as CSV if already run.
  5. GO-BP enrichment run SEPARATELY on UP- and DOWN-DE sets (hypergeometric ORA,
     BH per direction) using an embedded curated metabolic+adjacent human annotation
     (no network / no GO.db in this environment). Two universe framings reported.
  6. Directional verdict: GO-BP evidence primary, supported by DE counts and |log2FC|.
"""
import os, numpy as np, pandas as pd

BASE = os.path.dirname(os.path.abspath(__file__))
DATA = os.path.join(BASE, 'data')
OUT  = os.path.join(BASE, 'results')

def main():
    os.makedirs(OUT, exist_ok=True)
    # ---------- 1. input read ----------
    C = pd.read_csv(os.path.join(DATA, 'counts_raw_unfiltered.csv'), index_col=0)
    L = pd.read_csv(os.path.join(DATA, 'sample_layout.csv'))
    print('[1] counts', C.shape, '| layout', L.shape,
          '| gene IDs all ENSG:', (C.index.str.startswith('ENSG')).all(),
          '| cols match layout:', [s.replace('-', '_') for s in L['SampleID']] == list(C.columns))
    print('    groups (n each):', L['Group'].value_counts().to_dict())

    # ---------- 2. DESeq2-equivalent DE: CBD_IC50 vs DMSO ----------
    import deseq2_core as dc
    sub = L[L['Group'].isin(['DMSO', 'CBD_IC50'])]
    cols = [s.replace('-', '_') for s in sub['SampleID']]
    gl = sub['Group'].values
    print('[2] DESeq2-equivalent DE (n=3/group, prefilter rowSum>=10)...')
    r = dc.deseq2_wald(C[cols], gl, min_total=10)
    r.to_csv(os.path.join(OUT, 'deseq2_cbd_vs_dmso.csv'))
    de = (r['padj'] < 0.05) & (r['log2FoldChange'].abs() > 0.5)
    up = de & (r['log2FoldChange'] > 0.5); dn = de & (r['log2FoldChange'] < -0.5)
    print(f'    kept={r.shape[0]} DE={int(de.sum())} UP={int(up.sum())} DOWN={int(dn.sum())}')

    # ---------- 3. edgeR-style cross-check ----------
    import edger_crosscheck as ec
    print('[3] edgeR-style exact-test cross-check...')
    e = ec.edgeR_exact(C[cols], gl, min_total=10)
    e.to_csv(os.path.join(OUT, 'edger_cbd_vs_dmso.csv'))
    dee = (e['padj'] < 0.05) & (e['log2FoldChange'].abs() > 0.5)
    print(f'    DE={int(dee.sum())} UP={int((dee&(e["log2FoldChange"]>0.5)).sum())} ' +
          f'DOWN={int((dee&(e["log2FoldChange"]<-0.5)).sum())}')
    common = r.index.intersection(e.index)
    shared = de.loc[common] & dee.loc[common]
    concord = 100 * (np.sign(r.loc[common[shared],'log2FoldChange']) == np.sign(e.loc[common[shared],'log2FoldChange'])).mean()
    print(f'    shared DE genes={int(shared.sum())} of {len(common)}; direction concordance={concord:.1f}%')

    # ---------- 4. robustness (cached if heavy already computed) ----------
    robust_csv = os.path.join(OUT, 'robust30_cbd_coef.csv')
    if os.path.exists(os.path.join(BASE, 'robust30_cbd_coef.csv')):
        r30 = pd.read_csv(os.path.join(BASE, 'robust30_cbd_coef.csv'), index_col=0)
        print('[4] loading cached 30-sample serum-covariate robustness run')
    else:
        import robustness_model as rm
        print('[4] running 30-sample serum-covariate robustness (slow)...')
        gr = pd.Series(L['Group'].values, index=[s.replace('-', '_') for s in L['SampleID']])
        des = pd.DataFrame({'serum': gr.str.contains('Serum').astype(int),
                            'cbd': gr.str.contains('CBD').astype(int)})
        r30 = rm.run_robust(C[des.index], des, min_total=10)
    r30.to_csv(os.path.join(OUT, 'robust30_cbd_coef.csv'))
    de30 = (r30['padj'] < 0.05) & (r30['log2FoldChange_CBD'].abs() > 0.5)
    print(f'    CBD coeff robust30: DE={int(de30.sum())} UP={int((de30&(r30["log2FoldChange_CBD"]>0.5)).sum())} '
          f'DOWN={int((de30&(r30["log2FoldChange_CBD"]<-0.5)).sum())} '
          f'(control set = all non-CBD incl. cisplatin arms)')

    # ---------- 5. GO-BP enrichment: UP and DOWN SEPARATELY ----------
    import go_enrich as ge, go_annotation as ga
    print('[5] GO-BP enrichment (UP vs DOWN separately)...')
    summary_rows = []
    for mode in ['targeted', 'full']:
        for direction in ['up', 'down']:
            tab, N, K, nde = (ge.enrich(r, up_down=direction) if mode == 'targeted'
                              else ge.enrich_full_universe(r, up_down=direction))
            tab.to_csv(os.path.join(OUT, f'go_{mode}_{direction}.csv'), index=False)
            n_sig = int((tab['padj'] < 0.05).sum())
            summary_rows.append({'universe': mode, 'direction': direction, 'N': N,
                                 'DE_in_universe': K, 'significant_go_terms_padj0.05': n_sig})
            top = tab.head(6)[['name', 'term_size_measured', 'DE_in_term', 'fold_enrichment', 'padj']]
            print(f'    [{mode:8s}] {direction.upper()}: N={N}, {direction}-DE={K}; ' +
                  f'significant terms={n_sig}/{len(tab)}')
            for _, t in top.iterrows():
                print(f'        {t["name"]:40s} size={int(t["term_size_measured"]):2d} ' +
                      f'DEin={int(t["DE_in_term"]):2d} fold={t["fold_enrichment"]:.1f} padj={t["padj"]:.4f}')
    sm = pd.DataFrame(summary_rows)
    sm.to_csv(os.path.join(OUT, 'go_summary_by_direction.csv'), index=False)
    print(sm.to_string(index=False))

    # gene-level direction among annotated metabolic genes
    ensg2sym = {v: k for k, v in ga.SYM2ENSG.items() if v != 'none'}
    annot = set(ensg2sym)
    up_annot = set(r[(r['padj'] < 0.05) & (r['log2FoldChange'] > 0.5)].index) & annot
    dn_annot = set(r[(r['padj'] < 0.05) & (r['log2FoldChange'] < -0.5)].index) & annot
    print(f'    gene-level among annotated metabolic genes: UP-DE={len(up_annot)}, DOWN-DE={len(dn_annot)}')
    dircon = ge.direction_contrib(r)
    dircon.to_csv(os.path.join(OUT, 'go_term_direction_contributions.csv'), index=False)
    print('    per-term UP/DOWN contribution saved (top by net):')
    print(dircon.sort_values('net', ascending=False).head(8).to_string(index=False))

    # ---------- 6. verdict ----------
    print('[6] VERDICT: see final answer. GO-BP evidence is UP-driven.')

if __name__ == '__main__':
    main()
