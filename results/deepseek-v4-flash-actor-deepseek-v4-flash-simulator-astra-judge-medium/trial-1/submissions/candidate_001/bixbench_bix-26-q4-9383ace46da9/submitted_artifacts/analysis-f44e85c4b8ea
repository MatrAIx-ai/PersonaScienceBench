#!/usr/bin/env python3
"""
BixBench bix-26-q4 - KEGG over-representation analysis (common pathways between two media conditions).
P. aeruginosa PA14 (DESeqResults inputs). Down gene sets: log2FoldChange<=-1.5 & padj<=0.05.

Pipeline (mirrors clusterProfiler::enrichKEGG/kegg_rest):
  1) Parse the two RDS results tables (custom RDSv3 decoder; no R available).
  2) Define down-regulated gene sets per condition.
  3) Obtain KEGG pathway<->gene map for P. aeruginosa:
        - PRIMARY: live https://rest.kegg.jp/link/pathway/pau  (latest KEGG db)
        - FALLBACK: local snapshot file (kegg_pau_links.tsv / kegg_pae_links.tsv) deposited in workspace
          Format (one link per line):  pathway\gene   e.g.  pau:path:map00010\tpau:PA14_33530
  4) ORA: one-sided hypergeometric (Fisher) test per 'map'-level pathway with >= minGSSize genes
     in background; BH-adjusted p<=0.05; backgrounds = measured genes (5828) and full-organism (sensitivity).
  5) Common across media = intersection of distinct enriched KEGG pathway IDs (padj<=0.05 in BOTH).
Author: research agent. Output is honest about KEGG-data availability; no fabricated enrichment numbers.
"""
import gzip, re, struct, json, os, sys, urllib.request, socket
import numpy as np
import random
from scipy import stats

ORGS = {'pau': 'Pseudomonas aeruginosa UCBPP-PA14', 'pae': 'Pseudomonas aeruginosa PAO1'}
N_COLS = 6
COL_NAMES = ['baseMean', 'log2FoldChange', 'lfcSE', 'stat', 'pvalue', 'padj']
MIN_GS = 10            # min pathway gene-set size (clusterProfiler default)
ALPHA = 0.05           # BH-adjusted p-value cutoff
LOGFC_CUT = -1.5       # <= -1.5 downregulated
SNAP_CANDIDATES = ['data/kegg_pau_links.tsv', 'kegg_pau_links.tsv',
                   'data/kegg_pae_links.tsv', 'kegg_pae_links.tsv',
                   'data/kegg_links.tsv', 'kegg_links.tsv']

# ---------------------------------------------------------------- RDS parsing
def load_rds(path):
    with gzip.open(path, 'rb') as f:
        return f.read()

def read_deseq(path):
    raw = load_rds(path)
    n = 5828
    pat = b'\x00\x00\x00\x0e' + struct.pack('>I', n)
    starts = [m.start() for m in re.finditer(re.escape(pat), raw)]
    cols = {COL_NAMES[k]: [struct.unpack('>d', raw[p+8+8*i:p+8+8*(i+1)])[0] for i in range(n)]
            for k, p in enumerate(starts)}
    tok = b'\x00\x04\x00\x09'
    rn = []
    for m in re.finditer(re.escape(tok), raw[:starts[0]]):
        p = m.start()
        ln = int.from_bytes(raw[p+4:p+8], 'big')
        s = raw[p+8:p+8+ln]
        if s.startswith(b'PA14_'):
            rn.append(s.decode())
    assert len(rn) == n, (path, len(rn), n)
    return rn, cols

# ---------------------------------------------------------------- KEGG source
def fetch_kegg_links(org):
    """Live fetch of all pathway<->gene links for a KEGG organism (latest db)."""
    url = f'https://rest.kegg.jp/link/pathway/{org}'
    with urllib.request.urlopen(url, timeout=30) as r:
        return r.read().decode('utf-8')

def find_local_snapshot():
    for f in SNAP_CANDIDATES:
        if os.path.isfile(f):
            return f
    return None

def parse_links(text):
    """text lines: '<org>:path:mapNNNNN\t<org>:GENE' -> path:gene pairs (map-level only)."""
    pairs = []
    for line in text.strip().splitlines():
        line = line.strip()
        if not line or '\t' not in line:
            continue
        pw, g = line.split('\t', 1)
        m = re.search(r'path:(map\d{5})$', pw)
        if not m:
            continue
        gid = g.split(':', 1)[-1]
        pairs.append((m.group(1), gid))
    return pairs

def build_pathway_map(pairs):
    pmap = {}
    for pw, g in pairs:
        pmap.setdefault(pw, set()).add(g)
    return pmap

def detect_kegg_source(down_genes):
    """Try live fetch; else local snapshot. Returns (source_kind, description, pathway_map, org)."""
    for org in ['pau', 'pae']:
        try:
            text = fetch_kegg_links(org)
            pairs = parse_links(text)
            if pairs:
                pmap = build_pathway_map(pairs)
                return ('live', f'rest.kegg.jp link/pathway/{org} (latest KEGG db)', pmap, org, text)
        except Exception as e:
            sys.stderr.write(f'live fetch {org} failed: {type(e).__name__}: {e}\n')
    snap = find_local_snapshot()
    if snap:
        with open(snap) as f:
            text = f.read()
        pairs = parse_links(text)
        org = 'pau' if 'pau' in snap else ('pae' if 'pae' in snap else 'unknown')
        pmap = build_pathway_map(pairs)
        return ('snapshot', f'local file {snap}', pmap, org, text)
    return ('none', 'NO KEGG PATHWAY DATA AVAILABLE (no network, no local snapshot)', None, None, '')

# ---------------------------------------------------------------- ORA engine
def ora(gene_set, background, pw_map):
    """Hypergeometric ORA equivalent to enrichKEGG. Returns list of dicts."""
    S = set(gene_set)
    B = set(background)
    tested = 0
    results = []
    N = len(B)              # background size
    n = len(S)              # gene set size
    for pw, genes in pw_map.items():
        overlap = genes & B
        m = len(overlap)
        if m < MIN_GS:
            continue
        k = len(overlap & S)
        if k == 0:
            continue
        tested += 1
        odds, pv = stats.fisher_exact([[k, n - k], [m - k, N - m - (n - k)]], alternative='greater')
        results.append({'pathway': pw, 'BgRatio': f'{m}/{N}', 'GeneRatio': f'{k}/{n}',
                        'k': k, 'm': m, 'count': k, 'pvalue': pv, 'genes': sorted(overlap & S)})
    # BH adjustment
    results.sort(key=lambda r: r['pvalue'])
    nr = len(results)
    for i, r in enumerate(results):
        r['p.adjust'] = r['pvalue'] * nr / (i + 1)
    # enforce monotonic BH (as clusterProfiler/p.adjust does not, but standard BH caps at 1)
    for r in results:
        r['p.adjust'] = min(r['p.adjust'], 1.0)
    results.sort(key=lambda r: (r['p.adjust'], r['pathway']))
    return results

def enriched_ids(results, alpha=ALPHA):
    return [r['pathway'] for r in results if r['p.adjust'] <= alpha]

def run_analysis():
    report = {'status': 'executed', 'method': 'hypergeometric ORA (enrichKEGG-equivalent)', 'tool': 'scipy.stats.fisher_exact'}
    # 1) parse inputs
    down_sets = {}
    for fname, key in [('data/res_GluFevsGluFePlus.rds', 'GluFe'),
                       ('data/res_SuccvsGluFePlus.rds', 'Succ')]:
        rn, cols = read_deseq(fname)
        lfc, padj = cols['log2FoldChange'], cols['padj']
        down = [rn[i] for i in range(len(rn)) if lfc[i] <= LOGFC_CUT and padj[i] <= ALPHA]
        down_sets[key] = down
        report.setdefault('gene_sets', {})[key] = {'n_total': len(rn), 'n_down': len(down)}
        with open(os.path.basename(fname).replace('.rds', '_down.json'), 'w') as f:
            json.dump(down, f)
    print('Down gene sets:', {k: len(v) for k, v in down_sets.items()})

    # 2) KEGG source
    kind, desc, pw_map, org, text = detect_kegg_source(set(down_sets['GluFe']))
    report['kegg_source'] = {'kind': kind, 'description': desc, 'organism': ORGS.get(org, org)}
    print(f'KEGG source: kind={kind} desc={desc}')

    if kind == 'none':
        # 3a) VALIDATE ORA math on a LABELED synthetic snapshot (minGSSize=10 respected) so the
        #     hypergeometric/BH/intersection logic is demonstrably correct (NOT the real KEGG answer).
        random.seed(26)
        bg_genes = ['PA14_%05d' % i for i in range(1000, 2001)]        # 1001-gene synthetic background
        # pathway A: 12 members mostly in gene set -> should be strongly enriched
        pA = bg_genes[0:12]
        # pathway B: 12 members none overlapping the gene set
        pB = bg_genes[100:112]
        # pathway C: 12 members partly overlapping (3)
        pC = bg_genes[200:209] + bg_genes[0:3]
        gene_set = bg_genes[0:10]                                     # 10-gene "down set"
        synth_pairs = ([( 'map99901', g) for g in pA] +
                       [( 'map99902', g) for g in pB] +
                       [( 'map99903', g) for g in pC])
        smap = build_pathway_map(synth_pairs)
        sres = ora(gene_set, bg_genes, smap)
        report['synthetic_validation'] = {
            'note': 'SYNTHETIC SNAPSHOT (labeled, for pipeline validation only) - NOT the real KEGG answer',
            'n_background': len(bg_genes), 'n_gene_set': len(gene_set),
            'pathway_map': {k: sorted(v) for k, v in smap.items()},
            'ora_results': [{k: (v if k != 'genes' else sorted(v)) for k, v in r.items()} for r in sres]}
        print('Synthetic ORA validation (minGSSize=10):')
        for r in sres:
            print('   ', r['pathway'], 'count=', r['count'], 'm=', r['m'], 'p=', round(r['pvalue'], 6),
                  'padj=', round(r['p.adjust'], 6), 'genes=', r['genes'])
        if sres:
            top = sres[0]
            expect = 1.0 - stats.hypergeom.cdf(top['count'] - 1, len(bg_genes), top['m'], len(gene_set))
            assert abs(top['pvalue'] - expect) < 1e-12, 'hypergeometric consistency check failed'
            print('   [OK] fisher_exact p == 1 - hypergeom.cdf(k-1) for top pathway')
        # two-condition synthetic demo: common = intersection of enriched IDs (logic validation only)
        synth_pairs2 = synth_pairs + [('map99904', g) for g in bg_genes[300:312]]
        smap2 = build_pathway_map(synth_pairs2)
        gene_set2 = bg_genes[5:15] + bg_genes[300:306]       # overlaps A(5), C(2? no), D(6)
        r1 = ora(gene_set, bg_genes, smap2)                   # condition 1
        r2 = ora(gene_set2, bg_genes, smap2)                  # condition 2
        c1 = set(enriched_ids(r1)); c2 = set(enriched_ids(r2))
        report['synthetic_two_condition_demo'] = {
            'note': 'SYNTHETIC two-condition common-count demo (NOT the real KEGG answer)',
            'cond1_enriched': sorted(c1), 'cond2_enriched': sorted(c2),
            'common_ids': sorted(c1 & c2), 'common_count': len(c1 & c2)}
        print('Synthetic two-condition common-count demo:', len(c1 & c2), sorted(c1 & c2),
              '| cond1:', sorted(c1), '| cond2:', sorted(c2))
        print('\n*** KEGG PATHWAY DATA IS UNAVAILABLE IN THIS SANDBOX (no network, no offline snapshot). ***')
        print('*** Enrichment numbers are NOT computed/fabricated. Drop a KEGG links file into the ***')
        print('*** workspace (e.g. kegg_pau_links.tsv from curl https://rest.kegg.jp/link/pathway/pau) ***')
        print('*** and rerun to obtain the real, database-backed answer.                          ***')
        report['common_pathways_count'] = None
        report['common_pathway_ids'] = []
        return report

    # 3b) real ORA with the obtained KEGG map
    # background A: measured genes (all 5828) that map to >=1 KEGG pathway
    all_measured = set()
    for v in down_sets.values():
        pass
    all_measured = set(read_deseq('data/res_GluFevsGluFePlus.rds')[0])
    # full organism background = all genes appearing in the KEGG link map
    full_org_bg = set()
    for gs in pw_map.values():
        full_org_bg |= gs
    with open(f'kegg_links_{org}.txt', 'w') as f:
        f.write(text)
    report['kegg_links_saved'] = f'kegg_links_{org}.txt'
    print('Pathways in map:', len(pw_map), '| full-organism genes in map:', len(full_org_bg))

    per_cond = {}
    for key, sset in down_sets.items():
        # A) measured background
        bgA = all_measured & full_org_bg
        resA = ora(sset, list(bgA), pw_map)
        per_cond[key] = {'measured_bg': resA}
        # B) full-organism background (sensitivity)
        resB = ora(sset, list(full_org_bg), pw_map)
        per_cond[key]['full_org_bg'] = resB
        print(f'\n[{key}] n_down={len(sset)} measured_bg size={len(bgA)} full_org_bg size={len(full_org_bg)}')
        for tag, res in [('measured_bg', resA), ('full_org_bg', resB)]:
            ids = enriched_ids(res)
            print(f'   {tag}: #tested={len(res)} #significant(padj<=0.05)={len(ids)}')
    # common = intersection of enriched IDs (measured background primary)
    ids_glu = set(enriched_ids(per_cond['GluFe']['measured_bg']))
    ids_succ = set(enriched_ids(per_cond['Succ']['measured_bg']))
    common_ids = sorted(ids_glu & ids_succ)
    report['per_condition'] = {k: {
        'measured_bg_sig': enriched_ids(v['measured_bg']),
        'full_org_bg_sig': enriched_ids(v['full_org_bg'])}
        for k, v in per_cond.items()}
    report['common_pathways_count'] = len(common_ids)
    report['common_pathway_ids'] = common_ids
    report['common_pathway_measured_bg'] = common_ids
    ids_glu_f = set(enriched_ids(per_cond['GluFe']['full_org_bg']))
    ids_succ_f = set(enriched_ids(per_cond['Succ']['full_org_bg']))
    report['common_pathway_ids_full_org_bg'] = sorted(ids_glu_f & ids_succ_f)
    print('\nCOMMON pathways (measured background):', len(common_ids), common_ids)
    print('COMMON pathways (full-organism background sensitivity):', len(ids_glu_f & ids_succ_f),
          sorted(ids_glu_f & ids_succ_f))
    return report

if __name__ == '__main__':
    rep = run_analysis()
    with open('kegg_ora_report.json', 'w') as f:
        json.dump(rep, f, indent=2, default=str)
    print('\nreport written -> kegg_ora_report.json')
