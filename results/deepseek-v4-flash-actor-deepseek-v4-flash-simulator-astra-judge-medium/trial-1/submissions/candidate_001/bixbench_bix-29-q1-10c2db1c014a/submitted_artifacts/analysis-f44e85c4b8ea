#!/usr/bin/env python3
"""
TASK008 BCG-CORONA - ordinal regression of BCG vaccination on COVID-19 severity.
Question: OR of BCG vaccination on COVID-19 severity, controlling for prior
medical history count, patients interaction frequency, and their interaction.

Locked specification:
  Outcome     : COVID-19 severity, ordinal 0..4 for all 1000 patients
                (0 = no COVID AE; 1..4 = max AESEV over COVID-coded AE rows).
                43 COVID patients with all-missing AESEV are kept at level 0.
  Treatment   : BCG=1 vs Placebo=0 (reference); OR = exp(beta_BCG).
  mhcount_c   : # MHSCAT=='MEDICAL HISTORY' rows per patient, centered at mean.
  pseen_c     : patients_seen mapped to midpoints 25.5/75.5/150, centered.
  Interaction : mhcount_c * pseen_c (product of the two centered controls).
  Model       : statsmodels OrderedModel(distr='logit') = cumulative-link
                proportional-odds; BFGS.
Sensitivity  : ordinal model restricted to patients with a numeric COVID
               AESEV (levels 1-4 only).
"""
import numpy as np
import pandas as pd
from statsmodels.miscmodels.ordinal_model import OrderedModel

RNG = np.random.default_rng(0)

# ---------------- load ----------------
dm = pd.read_csv('data/TASK008_BCG-CORONA_DM.csv')
ae = pd.read_csv('data/TASK008_BCG-CORONA_AE.csv')
mh = pd.read_csv('data/TASK008_BCG-CORONA_MH.csv')
assert len(dm) == 1000 and dm['USUBJID'].is_unique

# ---------------- outcome: per-patient COVID severity ----------------
cov = ae[ae['AEPT'].str.contains('COVID', case=False, na=False)].copy()
print('COVID-coded AE rows:', len(cov))
print('Patients with any COVID AE row:', cov['USUBJID'].nunique())
max_aev = cov.groupby('USUBJID')['AESEV'].max()
num_covid_pts = max_aev.notna().sum()
covid_all_nan = max_aev.isna().sum()
print(f'COVID patients with a numeric max AESEV: {num_covid_pts} '
      f'(levels 1-4); with all-missing AESEV kept at 0: {covid_all_nan}')

sev = max_aev.reindex(dm['USUBJID']).fillna(0).astype(int)

# ---------------- covariates ----------------
mhcount = (mh[mh['MHSCAT'] == 'MEDICAL HISTORY']
             .groupby('USUBJID').size().reindex(dm['USUBJID']))
midp = {'1-50': 25.5, '51-100': 75.5, '>100': 150}
pseen  = dm['patients_seen'].map(midp)

df = pd.DataFrame({
    'USUBJID': dm['USUBJID'],
    'trtgrp': dm['TRTGRP'],
    'sev': sev.values,
    'bcg': (dm['TRTGRP'] == 'BCG').astype(int),
    'mhcount': mhcount.values,
    'pseen': pseen.values,
})
df['mhcount_c'] = df['mhcount'] - df['mhcount'].mean()
df['pseen_c']   = df['pseen'] - df['pseen'].mean()
df['mhXp']      = df['mhcount_c'] * df['pseen_c']

# ---------------- outcome-level breakdown ----------------
print('\n=== Outcome-level breakdown (all 1000 patients) ===')
brk = df.groupby(['sev', 'trtgrp']).size().unstack(fill_value=0)
print(brk)
print('Level totals:', df['sev'].value_counts().sort_index().to_dict())
print('Ordered check 0<1<2<3<4 - unique levels:', sorted(df['sev'].unique()))

# ---------------- primary model ----------------
X = df[['bcg', 'mhcount_c', 'pseen_c', 'mhXp']]
mod = OrderedModel(df['sev'], X, distr='logit')
res = mod.fit(method='bfgs', disp=True)
print('\n=== PRIMARY MODEL (n=1000, sev 0..4) ===')
print(res.summary())
beta = res.params['bcg']; se = res.bse['bcg']
ci = res.conf_int().loc['bcg']
p = res.pvalues['bcg']
print(f'\nBCG coefficient = {beta:.4f} (SE {se:.4f})')
print(f'BCG odds ratio = {np.exp(beta):.4f} '
      f'(95% CI {np.exp(ci.iloc[0]):.4f} - {np.exp(ci.iloc[1]):.4f})')
print(f'p-value = {p:.4g}')
print('Convergence flag:', res.mle_retvals.get('converged') if hasattr(res,'mle_retvals') else 'n/a')
print('mle_retvals keys:', list(res.mle_retvals.keys()) if hasattr(res,'mle_retvals') else 'n/a')
print('\nAll predictor coefficients:')
allc = pd.DataFrame({'coef': res.params, 'SE': res.bse, 'z': res.tvalues,
                     'p': res.pvalues})
print(allc.round(4).to_string())
print('\nExp(coef) for all predictors:')
print(pd.Series(np.exp(res.params), index=res.params.index).round(4).to_string())

# ---------------- sensitivity: restricted to patients with numeric severity ----------------
sub = df[df['sev'] >= 1].copy()
print(f'\n=== SENSITIVITY MODEL (n={len(sub)}, COVID patients sev 1..4) ===')
Xs = sub[['bcg', 'mhcount_c', 'pseen_c', 'mhXp']]
mods = OrderedModel(sub['sev'], Xs, distr='logit')
ress = mods.fit(method='bfgs', disp=True)
print(ress.summary())
betas = ress.params['bcg']; cis = ress.conf_int().loc['bcg']; ps = ress.pvalues['bcg']
print(f'BCG odds ratio (restricted) = {np.exp(betas):.4f} '
      f'(95% CI {np.exp(cis.iloc[0]):.4f} - {np.exp(cis.iloc[1]):.4f}), p={ps:.4g}')
print('Restricted level totals:', sub['sev'].value_counts().sort_index().to_dict())

# ---------------- sensitivity alt: interaction BCG x pseen only (for completeness, not reported) ----------------
print('\nDONE')
