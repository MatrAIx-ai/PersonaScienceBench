"""
BCG-CORONA TASK008 - Q2. Proportional-odds cumulative-logit model (statsmodels
OrderedModel, distr='logit' => proportional odds).
  outcome : per-patient max COVID-19 severity (AEHS, 0..7)
  exposure: n_ongoing = count of MHONGO=='Yes' per patient (ongoing conditions)
  controls: TRTGRP (BCG vs Placebo ref), work_hours (ref 1-40),
            patients_seen (ref 1-50), expect_interact (ref No)
  sample  : 194 patients with >=1 COVID AE episode (per-event and all-1000 as
            labelled SENSITIVITY models below)
Answer   : (exp(beta_n_ongoing)-1)*100  % increase in odds of higher severity
           per additional ongoing condition.
"""
import numpy as np, pandas as pd
from statsmodels.miscmodels.ordinal_model import OrderedModel
import statsmodels.api as sm

pd.set_option('display.width', 200)

def build(scope):
    dm = pd.read_csv('data/TASK008_BCG-CORONA_DM.csv')
    ae = pd.read_csv('data/TASK008_BCG-CORONA_AE.csv')
    mh = pd.read_csv('data/TASK008_BCG-CORONA_MH.csv')
    md = mh[mh['MHSCAT'] == 'MEDICAL HISTORY']
    n_ongoing = md.groupby('USUBJID')['MHONGO'].apply(lambda s: int((s == 'Yes').sum()))
    n_ongoing.name = 'n_ongoing'
    covid_mask = (ae['AEPT'].str.upper().str.contains('COVID', na=False)
                  & ~ae['AEPT'].str.upper().str.contains('TEST', na=False))
    covid = ae.loc[covid_mask]
    max_aehs = covid.groupby('USUBJID')['AEHS'].max(); max_aehs.name = 'max_aehs'
    base = dm[['USUBJID', 'TRTGRP', 'work_hours', 'patients_seen', 'expect_interact']].set_index('USUBJID')
    if scope == 'patient':
        d = base.join(n_ongoing).join(max_aehs)
        d = d[d['max_aehs'].notna()].copy()
        d['max_aehs'] = d['max_aehs'].astype(int)
    elif scope == 'event':
        ev = base.join(n_ongoing).join(covid[['USUBJID', 'AEHS']].set_index('USUBJID'))
        d = ev[ev['AEHS'].notna()].copy()
        d['max_aehs'] = d['AEHS'].astype(int)
    else:  # 'all1000'
        d = base.join(n_ongoing).join(max_aehs)
        d['max_aehs'] = d['max_aehs'].fillna(0).astype(int)
    d['n_ongoing'] = d['n_ongoing'].fillna(0).astype(int)
    d['is_bcg'] = (d['TRTGRP'] == 'BCG').astype(int)
    d['sei_yes'] = (d['expect_interact'] == 'Yes').astype(int)
    d['wh_41_80'] = (d['work_hours'] == '41-80').astype(int)
    d['wh_gt80']  = (d['work_hours'] == '>80').astype(int)
    d['ps_51_100'] = (d['patients_seen'] == '51-100').astype(int)
    d['ps_gt100'] = (d['patients_seen'] == '>100').astype(int)
    return d

XC = ['n_ongoing', 'is_bcg', 'wh_41_80', 'wh_gt80', 'ps_51_100', 'ps_gt100', 'sei_yes']

def fit_report(d, label, collapse=None):
    y = d['max_aehs'].astype(int)
    if collapse is not None:
        y = np.minimum(y, collapse)
    X = d[XC].astype(float)
    mod = OrderedModel(y, X, distr='logit')
    res = mod.fit(method='bfgs', disp=False, maxiter=400)
    ncat = len(np.unique(y))
    # actual cut points from transformed threshold params
    th_params = res.params[-(ncat - 1):].values
    cuts = np.concatenate((th_params[:1], np.exp(th_params[1:]))).cumsum()
    print('=== %s === n=%d | collapsed_upper=%s | categories used=%d | llf=%.4f AIC=%.2f | converged=%s' %
          (label, len(d), collapse, ncat, res.llf, res.aic, res.mle_retvals.get('converged')))
    print('outcome dist:', pd.Series(y).value_counts().sort_index().to_dict())
    ci = res.conf_int()
    for k in XC:
        b, se, p = res.params[k], res.bse[k], res.pvalues[k]
        lo, hi = ci.loc[k]
        print('  %-12s b=% .4f se=% .4f OR=% .3f 95%%CI[% .3f, % .3f] p=%.4f' % (k, b, se, np.exp(b), np.exp(lo), np.exp(hi), p))
    print('  thresholds(cut points):', np.round(cuts, 3))
    print()
    return res, y

print('# ' + '=' * 100)
d = build('patient')
print('### ANALYSIS DATASET: %d COVID patients ###' % len(d))
print('max_AEHS dist:', d['max_aehs'].value_counts().sort_index().to_dict())
print('n_ongoing dist:', d['n_ongoing'].value_counts().sort_index().to_dict())
print()

# ---- 1) MAIN 8-level model ----
res_main, y_main = fit_report(d, 'MAIN MODEL: ordered logit, max_AEHS(0-7)')

beta, se = res_main.params['n_ongoing'], res_main.bse['n_ongoing']
lo, hi = res_main.conf_int().loc['n_ongoing']
print('### ANSWER (per-patient max AEHS, 194 COVID patients, controls=TRTGRP+work_hours+patients_seen+expect_interact) ###')
print('beta=%.4f (SE=%.4f, 95%%CI [%.4f, %.4f]) | OR=%.4f | p=%.4f' % (beta, se, lo, hi, np.exp(beta), res_main.pvalues['n_ongoing']))
print('Increase in odds of HIGHER severity per additional ongoing condition = %.2f%% (95%%CI [%.2f%%, %.2f%%])' %
      ((np.exp(beta)-1)*100, (np.exp(lo)-1)*100, (np.exp(hi)-1)*100))
print()

# ---- 2) PO diagnostics: threshold-specific cumulative logits ----
print('### PO DIAGNOSTIC: binary logits at each cumulative split (>k) — same covariates ###')
yk = y_main.values
for k in sorted(np.unique(yk))[:-1]:
    binY = (yk > k).astype(int)
    if binY.sum() < 20 or (1 - binY).sum() < 20:
        print('  split >%d : skipped (n<=%d in smaller arm — too sparse for a stable binary logit)' % (k, min(binY.sum(), (1-binY).sum())))
        continue
    try:
        bm = sm.Logit(binY, d[XC].astype(float)).fit(disp=False)
        print('  >%d | n_ongoing b=% .3f | is_bcg=% .3f | wh41_80=% .3f | ps51_100=% .3f | sei_yes=% .3f | (severe n=%d)' %
              (k, bm.params['n_ongoing'], bm.params['is_bcg'], bm.params['wh_41_80'], bm.params['ps_51_100'], bm.params['sei_yes'], binY.sum()))
    except Exception as e:
        print('  split >%d : could not fit (%s)' % (k, str(e)[:60]))
print()

# ---- 3) ROBUSTNESS: collapse sparse upper categories (levels 0,1,2,3+) ----
r3, y3 = fit_report(d, 'ROBUSTNESS: collapsed outcome levels {0,1,2,3+}', collapse=3)
b3, lo3, hi3 = r3.params['n_ongoing'], r3.conf_int().loc['n_ongoing', 0], r3.conf_int().loc['n_ongoing', 1]
print('  -> collapsed-model %% increase in odds per condition = %.2f%% (CI [%.2f%%, %.2f%%])' %
      ((np.exp(b3)-1)*100, (np.exp(lo3)-1)*100, (np.exp(hi3)-1)*100))

# ---- 4) SENSITIVITY A: per-event model (221 events) ----
de = build('event')
rE, _ = fit_report(de, 'SENSITIVITY A: per-event AEHS, all COVID events')
bE, loE, hiE = rE.params['n_ongoing'], rE.conf_int().loc['n_ongoing', 0], rE.conf_int().loc['n_ongoing', 1]
print('  -> per-event %% increase = %.2f%% (CI [%.2f%%, %.2f%%])' % ((np.exp(bE)-1)*100, (np.exp(loE)-1)*100, (np.exp(hiE)-1)*100))

# ---- 5) SENSITIVITY B: all 1000 patients, non-COVID coded severity 0 ----
da = build('all1000')
rA, _ = fit_report(da, 'SENSITIVITY B: all 1000 patients, non-COVID = severity 0')
bA, loA, hiA = rA.params['n_ongoing'], rA.conf_int().loc['n_ongoing', 0], rA.conf_int().loc['n_ongoing', 1]
print('  -> all-1000 %% increase = %.2f%% (CI [%.2f%%, %.2f%%])' % ((np.exp(bA)-1)*100, (np.exp(loA)-1)*100, (np.exp(hiA)-1)*100))

print()
print('=== Reproducibility ===')
print('script: analyze_ordinal.py | inputs data/*.csv | statsmodels', sm.__version__, '| pandas', pd.__version__)
print('build(): patient|event|all1000 -> 194 obs | 221 obs | 1000 obs.')
