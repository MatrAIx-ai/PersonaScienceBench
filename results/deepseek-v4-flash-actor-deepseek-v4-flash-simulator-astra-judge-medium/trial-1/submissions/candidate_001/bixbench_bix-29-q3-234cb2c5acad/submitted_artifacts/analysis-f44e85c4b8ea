"""
TASK008 BCG-CORONA: Interaction between BCG vaccination status and prior medical
history on COVID-19 severity (ordinal / proportional-odds cumulative logit),
controlling for patient interaction frequency.

Primary model (approved):
  severity ~ C(TRTGRP) * mh_present + C(patients_seen) + C(expect_interact)
  severity = subject-level max AE severity grade over RTI events, 0 = no RTI event.
  statsmodels OrderedModel, distr='logit' (same family as MASS::polr).
  Interaction effect OR = exp(coef of BCG x MH).
"""
import numpy as np
import pandas as pd
import scipy.stats as stats
import statsmodels.api as sm
from statsmodels.miscmodels.ordinal_model import OrderedModel
from statsmodels.formula.api import logit as sm_logit

DM_F = "data/TASK008_BCG-CORONA_DM.csv"
AE_F = "data/TASK008_BCG-CORONA_AE.csv"
MH_F = "data/TASK008_BCG-CORONA_MH.csv"

# ---------------------------------------------------------------- load
dm = pd.read_csv(DM_F, dtype=str)
ae = pd.read_csv(AE_F, dtype=str)
mh = pd.read_csv(MH_F, dtype=str)
print("Loaded: DM", dm.shape, "| AE", ae.shape, "| MH", mh.shape)

# ---------------------------------------------------------------- outcomes (subject level)
ae_use = ae[ae["AECAT"].notna()].copy()            # drop 143 empty rows
ae_use["AESEVn"] = pd.to_numeric(ae_use["AESEV"], errors="coerce")
subj = dm["USUBJID"].tolist()
sev = pd.DataFrame(index=pd.Index(subj, name="USUBJID"))

# primary: max grade over RTI events; 0 = no RTI event
rti = ae_use[ae_use["AECAT"] == "RTI"].groupby("USUBJID")["AESEVn"].max()
sev["sev_rti"] = sev.index.map(lambda s: 0 if pd.isna(v := rti.get(s, np.nan)) else int(v))  # 0 (no RTI) for 471 subjects

# sensitivity: max grade over ALL non-empty AE events; 0 = no grade recorded / no events
allmx = ae_use.groupby("USUBJID")["AESEVn"].max()
sev["sev_all"] = sev.index.map(lambda s: v if pd.notna(v := allmx.get(s)) else 0)

# sensitivity: max grade over COVID-related events only; 0 = none
cov = ae_use[ae_use["AEPT"].astype(str).str.contains("COVID", na=False)].groupby("USUBJID")["AESEVn"].max()
sev["sev_cov"] = sev.index.map(lambda s: 0 if pd.isna(v := cov.get(s, np.nan)) else int(v))

# collapse grades 3+4 -> 3 ("severe") for primary RTI outcome
sev["sev_rti3"] = sev["sev_rti"].map(lambda x: min(x, 3))

# ---------------------------------------------------------------- predictors
hist = mh[mh["MHSCAT"] == "MEDICAL HISTORY"]
present_subj = set(hist.loc[hist["MHORRES"] == "2", "USUBJID"])
sev["mh_present"] = sev.index.map(lambda s: int(s in present_subj))
cnt2 = hist[hist["MHORRES"] == "2"].groupby("USUBJID").size()
sev["mh_count"] = sev.index.map(lambda s: int(cnt2.get(s, 0)))

sev["TRTGRP"]   = dm.set_index("USUBJID")["TRTGRP"].values
sev["bcg"]      = (sev["TRTGRP"] == "BCG").astype(int)
sev["patients_seen"] = dm.set_index("USUBJID")["patients_seen"].values
sev["expect_interact"] = dm.set_index("USUBJID")["expect_interact"].values
sev["ei"]       = (sev["expect_interact"] == "Yes").astype(int)

# ---------------------------------------------------------------- design helpers
def make_exog(d, cols_base, with_ps=True, with_ei=True):
    X = pd.DataFrame(index=d.index)
    for c in cols_base:
        X[c] = d[c].astype(float)
    X["inter"] = X["bcg"] * X["mh_present"]
    if with_ps:                       # reference '1-50'
        for cat in ["51-100", ">100"]:
            X[f"ps_{cat}"] = (d["patients_seen"] == cat).astype(float)
    if with_ei:
        X["ei"] = d["ei"].astype(float)
    X = X.astype(float)
    return X

PRIMARY_COLS = ["bcg", "mh_present"]   # 'inter' added by make_exog

def fit_ordered(d, ycol, X):
    mod = OrderedModel(d[ycol].astype(int), X, distr="logit")
    res = mod.fit(method="bfgs", maxiter=2000, disp=False)
    return mod, res

def tidy(res):
    coefs = res.params
    ci = res.conf_int()
    tab = pd.DataFrame({"coef": coefs, "se": res.bse,
                        "p": res.pvalues,
                        "OR": np.exp(coefs),
                        "OR_lo": np.exp(ci.iloc[:, 0]),
                        "OR_hi": np.exp(ci.iloc[:, 1])})
    return tab

def report(label, d, ycol, X):
    mod, res = fit_ordered(d, ycol, X)
    tab = tidy(res)
    # null (intercept/threshold-only) LL = sum log empirical marginal PMF
    yv = d[ycol].astype(int)
    pmf = yv.value_counts(normalize=True).reindex(range(yv.max()+1)).fillna(0.0).values
    ll0 = float((yv.map(lambda yi: np.log(pmf[int(yi)])).sum()))
    b = tab.loc["inter", ["OR", "OR_lo", "OR_hi"]]
    print("\n" + "=" * 78)
    print(f"[{label}]  y={ycol}  LL={res.llf:.4f} (null LL={ll0:.4f}, "
          f"LR={2*(res.llf-ll0):.4f}, n={int(res.nobs)})")
    print("--- coefficient table ---")
    print(tab.round(4).to_string())
    print(f"INTERACTION OR (exp(coef of BCG x MH)) = {b['OR']:.4f}  "
          f"95% CI [{b['OR_lo']:.4f}, {b['OR_hi']:.4f}]")
    return res, tab

print("\n" + "#" * 78)
print("# PRIMARY MODEL: sev_rti ~ bcg*mh_present + patients_seen + expect_interact")
print("#" * 78)
d_primary = sev.copy()
X_primary = make_exog(d_primary, PRIMARY_COLS, with_ps=True, with_ei=True)
res_primary, tab_primary = report("PRIMARY", d_primary, "sev_rti", X_primary)

# group-specific ORs for primary model (to interpret interaction)
b_bcg = res_primary.params["bcg"]; b_inter = res_primary.params["inter"]
print("\nInterpretation (primary): OR(BCG vs Placebo) among MH_absent = exp({:.4f}) = {:.4f}".format(
    b_bcg, np.exp(b_bcg)))
print("OR(BCG vs Placebo) among MH_present = exp({:.4f}) = {:.4f}".format(
    b_bcg + b_inter, np.exp(b_bcg + b_inter)))
print("=> interaction fold-change = {:.4f} (this equals exp(interaction coef))".format(np.exp(b_inter)))

# ---------------------------------------------------------------- SENSITIVITY GRID
sens = []
def add(label, d, ycol, cols, with_ps, with_ei):
    X = make_exog(d, cols, with_ps, with_ei)
    _, res = fit_ordered(d, ycol, X)
    ci = res.conf_int()
    b = res.params["inter"]
    lo, hi = np.exp(ci.loc["inter"]).tolist()
    sens.append([label, ycol,
                 "ps" if with_ps else "-",
                 "ei" if with_ei else "-",
                 res.llf, res.params["bcg"], res.params["mh_present"],
                 b, np.exp(b), lo, hi])
    return res

# severity alternatives (same primary predictors)
add("sev_all (max grade over all events)", d_primary, "sev_all", PRIMARY_COLS, True, True)
add("sev_cov (COVID-specific events only)", d_primary, "sev_cov", PRIMARY_COLS, True, True)
add("sev_rti3 (grades 3+4 collapsed)", d_primary, "sev_rti3", PRIMARY_COLS, True, True)
# MH as count (primary outcome + primary predictors)
add("MH as count (0-7)", sev.assign(mh_present=sev["mh_count"]), "sev_rti", ["bcg","mh_present"], True, True)
# control variants (primary outcome & binary MH)
add("controls: none", d_primary, "sev_rti", PRIMARY_COLS, False, False)
add("controls: patients_seen only", d_primary, "sev_rti", PRIMARY_COLS, True, False)
add("controls: expect_interact only", d_primary, "sev_rti", PRIMARY_COLS, False, True)

sens_df = pd.DataFrame(sens, columns=["model","outcome","ps","ei","LL","coef_bcg","coef_mh",
                                      "coef_inter","OR_inter","OR_lo","OR_hi"])
pd.set_option("display.width", 200)
print("\n" + "=" * 90)
print("SENSITIVITY GRID  (interaction effect OR = exp(coef_inter))")
print(sens_df.round(4).to_string(index=False))
sens_df.round(4).to_csv("sensitivity_grid.csv", index=False)

# ---------------------------------------------------------------- PROPORTIONAL ODDS CHECK
print("\n" + "=" * 78)
print("PROPORTIONAL-ODDS CHECK (Brant-style: slopes of separate binary logits per cutpoint")
print("should be EQUAL under proportional odds). Upper cutpoints (Y>=3: n=23, Y>=4: n=7)")
print("cause quasi-separation in binary fits, so the reliable comparison is cut k=1 vs k=2;")
print("a second check uses the grade-3+4-collapsed outcome (cutpoints 1,2,3).")
X = X_primary.copy()
y = d_primary["sev_rti"].astype(int)
Xc = sm.add_constant(X, has_constant="add")
names = ["bcg", "mh_present", "inter", "ps_51-100", "ps_>100", "ei"]

def brant_pair(kA, kB, yv, label):
    loA = sm.Logit((yv >= kA).astype(int), Xc).fit(disp=False)
    loB = sm.Logit((yv >= kB).astype(int), Xc).fit(disp=False)
    bA = loA.params[names]; bB = loB.params[names]
    V = loA.cov_params().loc[names, names] + loB.cov_params().loc[names, names]
    diff = bA - bB
    chi2 = float(diff @ np.linalg.solve(V, diff))
    p = 1 - stats.chi2.cdf(chi2, len(names))
    tab = pd.DataFrame({f"Y>={kA}": bA, f"Y>={kB}": bB, "diff": diff})
    print(f"\n[{label}] binary-logit slopes for cut Y>={kA} vs Y>={kB}:")
    print(tab.round(4).to_string())
    print(f"Wald chi2 (H0: equal slopes / PO) = {chi2:.2f} on {len(names)} df, p = {p:.4f}")
    return chi2, p

brant_pair(1, 2, y, "primary outcome sev_rti (grades 0-4)")
y3 = d_primary["sev_rti3"].astype(int)
brant_pair(1, 3, y3, "collapsed outcome sev_rti3 (grades 0-3)")

# ---------------------------------------------------------------- summary table for primary
# ---------------------------------------------------------------- summary table for primary
print("\n" + "#" * 78)
print("PRIMARY COEFFICIENT TABLE (full)")
print(tab_primary.round(4).to_string())
print("#" * 78)
