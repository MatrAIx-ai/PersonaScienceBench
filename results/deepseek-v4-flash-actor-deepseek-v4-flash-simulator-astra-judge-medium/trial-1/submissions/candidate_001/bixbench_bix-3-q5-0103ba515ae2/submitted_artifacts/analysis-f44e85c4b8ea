"""
BixBench bix-3-q5: which tissue comparison shows negligible effects?
Differential expression on three tissue comparisons using a per-gene two-sided
exact binomial (sign) test at the 5% threshold, pooled across all 30 samples per tissue.

Data file: data/Data_deposition_RNAseq_Paroxetine_2017.xlsx  (sheet 'NormCount')
Layout (verified): row 3 = header; c0 Index, c1 GeneID, c2-91 = 90 sample columns;
  baseline_blood = c2-31 (30), dentate_gyrus = c32-61 (30), final_blood = c62-91 (30).
  Within-tissue order is the SAME 30 animals (paired design), verified against
  Mapping_statistics' Index_DESeq ordering.
Precomputed blocks c92-187 are within-tissue RESPONSE comparisons (good/bad/control) and
are used only as validation context, not for the answer.
"""
import pandas as pd
import numpy as np
import re
from scipy.stats import binomtest, ttest_rel
from statsmodels.stats.multitest import multipletests

XLSX = 'data/Data_deposition_RNAseq_Paroxetine_2017.xlsx'

# ---- 1. Load count matrix ----
df = pd.read_excel(XLSX, sheet_name='NormCount', header=None)
hdr = df.iloc[3]                      # real header row
D = df.iloc[4:].reset_index(drop=True).apply(pd.to_numeric, errors='coerce')
D.columns = range(D.shape[1])
genes = df.iloc[4:].reset_index(drop=True)[1].astype(str)  # GeneID (raw, uncoerced)
N = D.shape[0]
print(f"[load] genes={N}, samples=90")

# sanity: sample headers
h = [str(hdr[c]) for c in range(2, 92)]
assert len(h) == 90 and len(set(h)) == 90
assert D.iloc[:, 2:92].isna().sum().sum() == 0

# ---- 2. Tissue assignment (verified column blocks) ----
tissue_cols = {
    'baseline_blood': list(range(2, 32)),   # Control10 + good10 + bad10, animals in same order
    'dentate_gyrus':  list(range(32, 62)),
    'final_blood':    list(range(62, 92)),
}
assert all(len(v) == 30 for v in tissue_cols.values())

# ---- 3. Three paired tissue comparisons ----
comparisons = {
    'Final vs Baseline Blood':        ('final_blood', 'baseline_blood'),
    'Dentate gyrus vs Baseline blood': ('dentate_gyrus', 'baseline_blood'),
    'Dentate gyrus vs Final blood':    ('dentate_gyrus', 'final_blood'),
}

def sign_test_pvalues(A, B):
    """Two-sided exact binomial (sign) test, paired per animal.
    X = # animals with A>B, Y = # with B>A, n = X+Y (ties excluded).
    p = two-sided exact binomial against p=0.5. n=0 (ties-only) -> p=1."""
    X = (A > B).sum(axis=1)
    Y = (B > A).sum(axis=1)
    n = X + Y
    p = np.ones(len(A))
    for i in range(len(A)):
        if n[i] > 0:
            p[i] = binomtest(int(X[i]), int(n[i]), 0.5).pvalue
    return p, X, Y, n

print("\n================= MAIN RESULT: per-gene exact binomial (sign) test, raw p<0.05 =================")
sign_counts = {}
for cname, (tA, tB) in comparisons.items():
    A = D[tissue_cols[tA]].values
    B = D[tissue_cols[tB]].values
    p, X, Y, n = sign_test_pvalues(A, B)
    k = int((p < 0.05).sum())
    sign_counts[cname] = k
    print(f"  {cname:<32} significant genes @ p<0.05: {k:6d}  ({k/N*100:5.2f}% of {N})")

rank = sorted(sign_counts.items(), key=lambda kv: kv[1])
print("\nRanking (fewest significant genes = NEGLIGIBLE):")
for i, (c, k) in enumerate(rank, 1):
    tag = "  <-- NEGLIGIBLE EFFECTS" if i == 1 else ""
    print(f"  {i}. {c:<32} {k:6d}{tag}")

# ---- 4. Robustness cross-checks: paired t-test on log2(x+1), raw & BH ----
print("\n================= ROBUSTNESS: paired t-test on log2(x+1) =================")
L = np.log2(D.iloc[:, 2:92].values + 1.0)
def fdr(pv):
    return multipletests(pv, method='fdr_bh')[1]
print(f"  {'comparison':<32}{'raw p<0.05':>12}{'BH padj<0.05':>14}")
tt_counts_raw = {}
tt_counts_adj = {}
for cname, (tA, tB) in comparisons.items():
    a_cols = [c - 2 for c in tissue_cols[tA]]
    b_cols = [c - 2 for c in tissue_cols[tB]]
    pv = np.zeros(N)
    for i in range(N):
        _, pv[i] = ttest_rel(L[i, a_cols], L[i, b_cols])
    pv[~np.isfinite(pv)] = 1.0
    k_raw = int((pv < 0.05).sum())
    k_adj = int((fdr(pv) < 0.05).sum())
    tt_counts_raw[cname] = k_raw
    tt_counts_adj[cname] = k_adj
    print(f"  {cname:<32}{k_raw:>12}{k_adj:>14}")
print("\nRobustness ranking (raw):", sorted(tt_counts_raw.items(), key=lambda kv: kv[1]))
print("Robustness ranking (BH): ", sorted(tt_counts_adj.items(), key=lambda kv: kv[1]))

# ---- 5. Validation context: precomputed DESeq blocks (c92-187) exist but are within-tissue
#         response comparisons; not used for the answer. ----
print("\n[note] Precomputed blocks c92-187 = within-tissue response comparisons (validation only); unused for answer.")

# ---- 6. Answer ----
answer = rank[0][0]
print("\n================= ANSWER =================")
print(f"The tissue comparison showing NEGLIGIBLE EFFECTS is: {answer}")
print(f"(fewest significant genes at per-gene binomial exact test p<0.05: {rank[0][1]} of {N})")
