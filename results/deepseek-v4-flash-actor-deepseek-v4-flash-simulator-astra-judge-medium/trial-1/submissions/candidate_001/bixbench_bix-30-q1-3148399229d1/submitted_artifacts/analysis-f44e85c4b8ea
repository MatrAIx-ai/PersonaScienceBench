#!/usr/bin/env python3
"""Analysis of PLOS ONE pone.0150501 S1: percentage of miRNAs with
significant differential expression (DM1 patients vs healthy controls)
BEFORE multiple-testing correction.

Data: data/pone.0150501.s002.xls (BIFF8/OLE2; single sheet).
  row0 : title 'Table S1. Ct values for 175 miRNAs in DM1 and healthy controls serum'
  row1 : sample headers P_1..P_10 (DM1 patients, 10) and C_11..C_20 (controls, 10)
  col A (rows 2..176): 175 miRNA identifiers
  body : raw qPCR Ct values; literal 'NAN' = undetected (~22 cells, 0.63% of 3500)

Locked method (primary):
  - groups P vs C, 10 vs 10
  - undetected 'NAN' -> Ct = 40 (qPCR detection limit)
  - per-miRNA equal-variance two-sample t-test on Ct
  - count raw (uncorrected) p < 0.05 as a percentage
Robustness variants: Welch t-test, Mann-Whitney U, complete-case/drop-NaN.
"""
import struct, csv, numpy as np, pandas as pd
from scipy import stats

XLS = 'data/pone.0150501.s002.xls'

# ---------------- Part 0: OLE2 -> BIFF8 -> cell grid parser -------------
class OLE:
    def __init__(self, path):
        d = open(path, 'rb').read()
        self.data = d
        self.sector_shift = struct.unpack_from('<H', d, 0x1E)[0]
        self.big_bs = 1 << self.sector_shift
        self.mini_shift = struct.unpack_from('<H', d, 0x20)[0]
        self.mini_bs = 1 << self.mini_shift
        self.mini_cutoff = struct.unpack_from('<I', d, 0x38)[0]
        self.first_minifat = struct.unpack_from('<I', d, 0x3C)[0]
        self.first_difat = struct.unpack_from('<I', d, 0x44)[0]
        self.first_dir = struct.unpack_from('<I', d, 0x30)[0]
        difat = list(struct.unpack_from('<109I', d, 0x4C))
        if self.first_difat != 0xFFFFFFFE:
            sec = self.first_difat
            for _ in range(struct.unpack_from('<I', d, 0x48)[0]):
                ents = struct.unpack_from('<128I', self.sector(sec))
                difat.extend(ents[:127])
                if ents[127] == 0xFFFFFFFE:
                    break
                sec = ents[127]
        self.fat = []
        for s in difat:
            if s not in (0xFFFFFFFF, 0xFFFFFFFE):
                self.fat.extend(struct.unpack_from('<%dI' % (self.big_bs // 4), self.sector(s)))
        self.minifat = []
        if self.first_minifat != 0xFFFFFFFE:
            mf = b''
            s = self.first_minifat
            while s not in (0xFFFFFFFF, 0xFFFFFFFE):
                mf += self.sector(s)
                s = self.fat[s]
            self.minifat = list(struct.unpack('<%dI' % (len(mf) // 4), mf))
        self.entries = {}
        dirbytes = b''
        sec = self.first_dir
        while sec != 0xFFFFFFFF and sec != 0xFFFFFFFE:
            dirbytes += self.sector(sec)
            sec = self.fat[sec]
        self.root = None
        for i in range(0, len(dirbytes) - 127, 128):
            e = dirbytes[i:i + 128]
            name_len = struct.unpack_from('<H', e, 64)[0]
            name = e[0:name_len - 2].decode('utf-16-le', 'ignore') if name_len > 2 else ''
            otype = e[66]
            start = struct.unpack_from('<I', e, 116)[0]
            size = struct.unpack_from('<Q', e, 120)[0]
            if otype == 5:
                self.root = (start, size)
            if name:
                self.entries[name] = (otype, start, size)
        self._mstream = b''
        if self.root:
            self._mstream = self._chain(self.root[0], self.root[1], True)

    def sector(self, n, bs=None):
        bs = bs or self.big_bs
        return self.data[512 + n * bs:512 + (n + 1) * bs]

    def _chain(self, start, size, big):
        out, sec = b'', start
        while sec not in (0xFFFFFFFF, 0xFFFFFFFE) and len(out) < size:
            if big:
                out += self.sector(sec)
                sec = self.fat[sec]
            else:
                out += self._mstream[sec * self.mini_bs:(sec + 1) * self.mini_bs]
                sec = self.minifat[sec]
        return out[:size]

    def stream(self, name):
        if name not in self.entries:
            return None
        otype, start, size = self.entries[name]
        if otype != 2:
            return None
        if size < self.mini_cutoff:
            return self._chain(start, size, False)
        return self._chain(start, size, True)

def read_biff_grid(path):
    ole = OLE(path)
    wb = ole.stream('Workbook') or ole.stream('Book')
    assert wb, 'Workbook stream not found'
    recs, pos = [], 0
    while pos + 4 <= len(wb):
        rid, rlen = struct.unpack_from('<HH', wb, pos)
        recs.append((rid, wb[pos + 4:pos + 4 + rlen]))
        pos += 4 + rlen
    # SST
    sst_parts = []
    for i, (rid, pl) in enumerate(recs):
        if rid == 0xFC:
            sst_parts.append(pl)
            j = i + 1
            while j < len(recs) and recs[j][0] == 0x3C:
                sst_parts.append(recs[j][1]); j += 1
            break
    sst = b''.join(sst_parts)
    cst_unique = struct.unpack_from('<II', sst, 0)[1]
    chunk_info, total = [], 0
    for ci, part in enumerate(sst_parts):
        if ci == 0:
            chunk_info.append((total, total + len(part), True)); total += len(part)
        else:
            comp = (part[0] & 1) == 0
            chunk_info.append((total, total + len(part), comp)); total += len(part)
    def _comp(p):
        for (cs, ce, comp) in chunk_info:
            if cs <= p < ce:
                return comp
        return None
    p = 8
    strings = []
    for _ in range(cst_unique):
        cch = struct.unpack_from('<H', sst, p)[0]; p += 2
        flags = sst[p]; p += 1
        fRich, fExt = bool(flags & 8), bool(flags & 4)
        if fRich:
            cRun = struct.unpack_from('<H', sst, p)[0]; p += 2
        if fExt:
            cbExt = struct.unpack_from('<I', sst, p)[0]; p += 4
        chars = []
        for _ in range(cch):
            if _comp(p):
                chars.append(sst[p]); p += 1
            else:
                chars.append(struct.unpack_from('<H', sst, p)[0]); p += 2
        if fRich:
            p += 4 * cRun
        if fExt:
            p += cbExt
        strings.append(''.join(chr(c) for c in chars))
    def rk2num(ri):
        if ri & 2:
            v = float(struct.unpack('<i', struct.pack('<I', ri & 0xFFFFFFFC))[0] >> 2)
        else:
            v = struct.unpack('<f', struct.pack('<I', ri & 0xFFFFFFFC))[0]
        return v / 100.0 if (ri & 1) else v
    grid, gid = {}, None
    for rid, pl in recs:
        if rid == 0x809:
            dt = struct.unpack_from('<H', pl, 2)[0]
            if dt == 0x10:
                gid = 0; grid = {}
            else:
                gid = None
        elif rid == 0x0A:
            gid = None
        elif gid is None:
            continue
        elif rid == 0xFD:
            row, col, xf, si = struct.unpack_from('<HHHI', pl, 0)
            grid[(row, col)] = ('s', strings[si])
        elif rid == 0x203:
            row, col, xf = struct.unpack_from('<HHH', pl, 0)
            grid[(row, col)] = ('n', struct.unpack_from('<d', pl, 6)[0])
        elif rid == 0x27E:
            row, col, xf, ri = struct.unpack_from('<HHHI', pl, 0)
            grid[(row, col)] = ('n', rk2num(ri))
        elif rid == 0xBD:
            row, cf, cl = struct.unpack_from('<HHH', pl, 0)
            pos2 = 6
            for c in range(cf, cl + 1):
                ri = struct.unpack_from('<I', pl, pos2 + 2)[0]
                grid[(row, c)] = ('n', rk2num(ri))
                pos2 += 6
        elif rid == 0x204:
            row, col, xf = struct.unpack_from('<HHH', pl, 0)
            cch = struct.unpack_from('<H', pl, 6)[0]
            fl = pl[8]; raw = pl[9:]
            s = (raw[:cch*2].decode('utf-16-le', 'ignore') if (fl & 1)
                 else raw[:cch].decode('latin1', 'ignore'))
            grid[(row, col)] = ('s', s)
    return grid

# ---------------- Part 1: build matrix ----------------
grid = read_biff_grid(XLS)
maxr = max(r for r, c in grid) + 1
maxc = max(c for r, c in grid) + 1
print('Sheet dims: rows =', maxr, 'cols =', maxc)
def cell(r, c):
    v = grid.get((r, c))
    return v[1] if v else None
headers = [cell(1, c) for c in range(1, maxc)]
print('Sample headers:', headers)
assert headers[:10] == ['P_%d' % i for i in range(1, 11)], headers
assert headers[10:] == ['C_%d' % i for i in range(11, 21)], headers
rows, mirnas = [], []
for r in range(2, maxr):
    mirna = cell(r, 0)
    vals_f = []
    for c in range(1, maxc):
        v = cell(r, c)
        if isinstance(v, (int, float)):
            vals_f.append(float(v))
        elif isinstance(v, str) and v.upper() == 'NAN':
            vals_f.append(np.nan)
        else:
            raise ValueError('Unexpected cell %r at row %d' % (v, r))
    mirnas.append(mirna)
    rows.append(vals_f)
df = pd.DataFrame(rows, index=mirnas, columns=headers)
Pcols, Ccols = headers[:10], headers[10:]
print('miRNA count:', df.shape[0], '| samples:', df.shape[1],
      '(', len(Pcols), 'P,', len(Ccols), 'C )')
print('Unique miRNA ids:', df.shape[0] == df.index.nunique())
n_nan = int(df[Pcols + Ccols].isna().sum().sum())
print('NAN (undetected) cells:', n_nan, 'of', df[Pcols + Ccols].size,
      '(%.2f%%)' % (100 * n_nan / df[Pcols + Ccols].size))

# ---------------- Part 2: primary + robustness tests ----------------
NAN_IMPUTE = 40.0   # qPCR detection limit
X = df.copy()
X[Pcols + Ccols] = X[Pcols + Ccols].apply(lambda s: s.fillna(NAN_IMPUTE))
P = X[Pcols].to_numpy(float)
C = X[Ccols].to_numpy(float)
res = pd.DataFrame(index=df.index)
res['mean_Ct_P'] = np.nanmean(P, axis=1)
res['mean_Ct_C'] = np.nanmean(C, axis=1)
res['nNAN_P'] = df[Pcols].isna().sum(axis=1)
res['nNAN_C'] = df[Ccols].isna().sum(axis=1)
res['p_ttest_eqvar'] = [stats.ttest_ind(P[i], C[i], equal_var=True)[1] for i in range(len(df))]
res['p_ttest_welch'] = [stats.ttest_ind(P[i], C[i], equal_var=False)[1] for i in range(len(df))]
res['p_mannwhitney'] = [stats.mannwhitneyu(P[i], C[i], alternative='two-sided')[1] for i in range(len(df))]
cc = []
for i in range(len(df)):
    a = df[Pcols].iloc[i].to_numpy(float); b = df[Ccols].iloc[i].to_numpy(float)
    ok = np.isfinite(a) & np.isfinite(b)
    cc.append(stats.ttest_ind(a[ok], b[ok], equal_var=True)[1] if ok.sum() >= 6 else np.nan)
res['p_ttest_completecase'] = cc

# ---------------- Part 3: report ----------------
def pct(ps):
    ps = np.asarray(ps, float)
    valid = ps[~np.isnan(ps)]
    return 100.0 * np.mean(valid < 0.05), int((valid < 0.05).sum()), len(valid)

print('\n==== BEFORE MULTIPLE-TESTING CORRECTION (raw p < 0.05) ====')
labels = {'p_ttest_eqvar': 'PRIMARY equal-var t-test (NAN->40)',
          'p_ttest_welch': 'Robustness Welch t-test (NAN->40)',
          'p_mannwhitney': 'Robustness Mann-Whitney U (NAN->40)',
          'p_ttest_completecase': 'Robustness complete-case t-test'}
for col in labels:
    pctv, nsig, ntot = pct(res[col])
    print('%-42s : %6.2f%%  (%d / %d)' % (labels[col], pctv, nsig, ntot))
pct_primary, n_primary, _ = pct(res['p_ttest_eqvar'])
print('\nPRIMARY ANSWER: %.2f%% of 175 miRNAs significantly differentially '
      'expressed (raw p<0.05, no correction)' % pct_primary)
res.to_csv('de_results.csv')
df.to_csv('data_parsed.csv')
print('\nWrote de_results.csv and data_parsed.csv')
print('Top 10 smallest p (primary):')
print(res.sort_values('p_ttest_eqvar')[['mean_Ct_P', 'mean_Ct_C', 'p_ttest_eqvar']].head(10).round(4).to_string())
