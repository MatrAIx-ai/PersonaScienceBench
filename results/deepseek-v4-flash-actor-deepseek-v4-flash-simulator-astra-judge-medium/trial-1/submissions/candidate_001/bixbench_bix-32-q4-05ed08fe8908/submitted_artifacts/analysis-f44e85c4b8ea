#!/usr/bin/env python3
"""
BixBench bixbench:bix-32-q4 -- KEGG over-representation analysis.
QUESTION: two cellular-process KEGG pathways consistently enriched (adj p<0.05)
in downregulated genes (pvalue<0.05 & log2FC<-1.5) across QS mutants 97,98,99
vs WT(strain 1) in P. aeruginosa PA14.
LOCKED METHOD: down = pvalue<0.05 & lfc<-1.5 (raw pvalue); ORA = one-sided
hypergeometric per pathway; universe = all 5828 tested genes; BH across
pathways within strain (adj p<0.05); consistent = enriched in ALL of 97,98,99;
organism 'pau' (PA14 locus tags), 'pae' sensitivity only.
ENV: no R/clusterProfiler, no network, no bundled KEGG data (re-verified).
RDS parsed with self-contained R serialization-v3 binary parser.
Run: python3 kegg_ora_bix32q4.py
Complete (given map/network): python3 kegg_ora_bix32q4.py --local-map map.gmt
"""
import gzip, os, sys, json, time, urllib.request
import numpy as np
import pandas as pd
from scipy.stats import hypergeom

HERE = os.path.dirname(os.path.abspath(__file__))
OUT  = os.path.join(HERE, "output")
os.makedirs(OUT, exist_ok=True)
NA_REAL = 0x7FF00000000007A2          # R's NA_real_ bit pattern

def _find_all(raw, pat):
    out, s = [], 0
    while True:
        i = raw.find(pat, s)
        if i < 0: break
        out.append(i); s = i + 1
    return out

def parse_deseq_results(path):
    """Parse a DESeq2 results() RDS (gzip, R serialization v3) -> DataFrame."""
    raw = gzip.decompress(open(path, 'rb').read())
    def u32(i): return int.from_bytes(raw[i:i+4], 'big')
    from collections import Counter
    # 6 REALSXP result columns sharing one row count
    heads = []
    for m in _find_all(raw, b'\x00\x00\x00\x0e'):
        ln = u32(m+4)
        if ln > 1000: heads.append(m)
    n = Counter(u32(m+4) for m in heads).most_common(1)[0][0]
    cols6 = [m for m in heads if u32(m+4) == n]
    assert len(cols6) == 6, (len(cols6), n)
    NROW = n
    def read_strsxp_after(after_idx):
        for m in _find_all(raw, b'\x00\x00\x00\x10'):
            if m < after_idx: continue
            k = u32(m+4); j = m + 8; vals = []
            for _ in range(k):
                if raw[j:j+4] == b'\x00\x04\x00\x09': p = j + 4
                elif raw[j:j+3] == b'\x04\x00\x09':   p = j + 3
                else: raise AssertionError('char hdr %d' % j)
                L = u32(p); vals.append(raw[p+4:p+4+L].decode('utf-8')); j = p+4+L+1
            if k == 6 and all(v in ('baseMean','log2FoldChange','lfcSE','stat',
                                    'pvalue','padj') for v in vals):
                return vals
        raise AssertionError('column names not found')
    colnames = read_strsxp_after(cols6[-1] + 8 + NROW*8)
    rown_start = None
    for m in _find_all(raw, b'\x00\x00\x00\x10'):
        if m < cols6[0] and u32(m+4) == NROW:
            rown_start = m; break
    assert rown_start is not None
    j = rown_start + 8; rownames = []
    for _ in range(NROW):
        if raw[j:j+4] == b'\x00\x04\x00\x09': p = j + 4
        elif raw[j:j+3] == b'\x04\x00\x09':   p = j + 3
        else: raise AssertionError('rowname %d' % j)
        L = u32(p); rownames.append(raw[p+4:p+4+L].decode('utf-8')); j = p+4+L+1
    cols = {}
    for k, m in enumerate(cols6):
        bits = np.frombuffer(raw, dtype='>u8', count=NROW, offset=m+8).astype(np.uint64)
        vals = bits.view('<f8').astype(np.float64)
        cols[colnames[k]] = np.where(bits == NA_REAL, np.nan, vals)
    df = pd.DataFrame(cols, index=rownames); df.index.name = 'gene'
    return df

def downregulated(df):
    return df.index[(df['pvalue'] < 0.05) & (df['log2FoldChange'] < -1.5)]

def fetch_kegg_pathway_map(organism='pau', timeout=8, retries=3):
    """Try KEGG REST: link/pathway/<org> + list/pathway/<org>.
    Returns (path_map, names, status_msg). Offline -> (None, None, msg)."""
    last = None
    def get(url):
        nonlocal last
        for attempt in range(retries):
            for scheme in ('https', 'http'):
                try:
                    req = urllib.request.Request(scheme + ':' + url,
                        headers={'User-Agent':'curl/8.1.2'})
                    with urllib.request.urlopen(req, timeout=timeout) as r:
                        return r.read().decode('utf-8','replace')
                except Exception as e:
                    last = e
            if attempt < retries-1: time.sleep(1.0)
        return None
    link = get('//rest.kegg.jp/link/pathway/%s' % organism)
    if link is None:
        return None, None, ("KEGG REST unreachable offline (org=%s); last error: %s" % (organism, last))
    path_map = {}
    for line in link.splitlines():
        if '\t' not in line: continue
        gene, pw = line.split('\t')
        path_map.setdefault(pw, set()).add(gene.split(':',1)[-1])
    names = {}
    lst = get('//rest.kegg.jp/list/pathway/%s' % organism)
    if lst:
        for line in lst.splitlines():
            if '\t' in line:
                pid, nm = line.split('\t',1)
                names[pid] = nm
    return path_map, names, 'fetched %d pathways (org=%s)' % (len(path_map), organism)

def load_local_pathway_map(path):
    """GMT: name<TAB>desc<TAB>gene... JSON: {path: [genes], names:{...}}"""
    path_map, names = {}, {}
    if path.endswith('.gmt'):
        for line in open(path):
            p = line.rstrip('\n').split('\t')
            if len(p) < 3: continue
            path_map[p[0]] = set(p[2:]); names[p[0]] = p[1]
    elif path.endswith('.json'):
        d = json.load(open(path))
        for k, v in d.items():
            if k == 'names': names = v
            elif isinstance(v, list): path_map[k] = set(v)
    return path_map, names

def ora(path_map, down_set, universe):
    """One-sided hypergeometric enrichment per pathway; BH across pathways."""
    down_set = set(down_set); universe = set(universe)
    down_n = len(down_set & universe); universe_n = len(universe)
    rows = []
    for pid, genes in path_map.items():
        anno = set(genes) & universe
        n = len(anno)
        if n == 0: continue
        k = len(anno & down_set)
        if k == 0: continue
        p = hypergeom.sf(k-1, universe_n, n, down_n)
        rows.append(dict(pathway=pid, anno=n, cnt=k, down_n=down_n,
                         universe_n=universe_n, pvalue=p))
    res = pd.DataFrame(rows)
    if len(res):
        from statsmodels.stats.multitest import multipletests
        res['p_adj'] = multipletests(res['pvalue'].values, method='fdr_bh')[1]
        res = res.sort_values('pvalue').reset_index(drop=True)
    return res

def consistent_enrichment(ora_by_strain, adj_cutoff=0.05):
    st = [set(r.loc[r['p_adj'] < adj_cutoff, 'pathway']) for r in ora_by_strain.values()]
    return sorted(set.intersection(*st)) if st else []

# KEGG BRITE 'Cellular Processes' (09140) PATHWAY maps relevant to P. aeruginosa
CELLULAR_PROCESS_PATHWAYS = {
    'path:map02024','path:map02025','path:map02026','path:map02030','path:map02040',
    'path:map02044','path:map02060','path:map02062','path:map04110','path:map04113',
    'path:map04140','path:map04141','path:map04142','path:map04144','path:map04145'}

def run_ora_self_test():
    """Validate hypergeom + BH on synthetic data with a known strong hit.
    Independently recomputes every row's p-value with scipy hypergeom.sf using
    the row's own (cnt-1, universe_n, anno, down_n) and checks BH separately."""
    universe = {'g%05d'%i for i in range(10000)}
    down     = {'g%05d'%i for i in range(300)}
    pathA    = {'g%05d'%i for i in range(20)} & universe   # 20 of 20 in down
    pathB    = {'g%0055d'%i for i in range(50)}            # 0 in down
    res = ora({'P_A':pathA,'P_B':pathB}, down, universe)
    # 1) every pvalue must match scipy sf recomputation
    for _, row in res.iterrows():
        manual = hypergeom.sf(int(row['cnt'])-1, int(row['universe_n']),
                              int(row['anno']), int(row['down_n']))
        assert np.isclose(row['pvalue'], manual, rtol=1e-12, atol=0.0), (row['pvalue'], manual)
    # 2) BH: p_adj must equal statsmodels multipletests on the same pvalues
    from statsmodels.stats.multitest import multipletests
    adj = multipletests(res['pvalue'].values, method='fdr_bh')[1]
    assert np.allclose(res['p_adj'].values, adj, rtol=1e-12, atol=0.0)
    # 3) the strong hit must be significant at BH 0.05 and P_B absent
    assert (res['p_adj'] < 0.05).any() and 'P_B' not in res['pathway'].values
    return res, res['pvalue'].max()

def main():
    print('='*74)
    print('BixBench bix-32-q4 | KEGG ORA: downregulated genes in PA14 QS mutants')
    print('='*74)
    strains = {'97': os.path.join(HERE,'..','data','res_1vs97.rds'),
               '98': os.path.join(HERE,'..','data','res_1vs98.rds'),
               '99': os.path.join(HERE,'..','data','res_1vs99.rds')}
    dfs, downsets = {}, {}
    print('\n[1] Parse DESeq2 results (Python RDS v3 parser)')
    for s, p in strains.items():
        df = parse_deseq_results(p); dn = downregulated(df)
        dfs[s], downsets[s] = df, dn
        df.to_csv(os.path.join(OUT,'res_1vs%s_parsed.csv'%s))
        pd.Series(sorted(dn)).to_csv(os.path.join(OUT,'down_1vs%s.csv'%s),
                                     header=['gene'], index=False)
        print('  strain %s: %d genes | down(p<0.05 & lfc<-1.5)=%d' % (s, len(df), len(dn)))
    uni = set(dfs['97'].index)
    tri = set(downsets['97']) & set(downsets['98']) & set(downsets['99'])
    print('  universe (tested genes): %d | triple overlap of down sets: %d' % (len(uni), len(tri)))

    print('\n[2] Obtain KEGG pathway->gene map (organism = pau, PA14)')
    path_map = names = msg = None
    if '--local-map' in sys.argv:
        lp = sys.argv[sys.argv.index('--local-map')+1]
        path_map, names = load_local_pathway_map(lp)
        msg = 'loaded local map: %s' % lp
        print('  ', msg)
    else:
        for org in ('pau', 'pae'):
            pm, nm, m = fetch_kegg_pathway_map(org)
            print('   org %s: %s' % (org, m))
            if pm and len(pm):
                path_map, names, msg = pm, nm, m
                break

    print('\n[3] ORA (one-sided hypergeometric, universe=%d, BH per strain)' % len(uni))
    cons = []
    if path_map and len(path_map):
        ob = {s: ora(path_map, downsets[s], uni) for s in strains}
        for s, r in ob.items():
            r.to_csv(os.path.join(OUT,'ora_1vs%s.csv'%s), index=False)
            print('  strain %s: %d enriched (adj p<0.05)' % (s, int((r['p_adj']<0.05).sum())))
        cons = consistent_enrichment(ob)
        print('\nCONSISTENT ENRICHMENT across 97,98,99 (adj p<0.05 in ALL):')
        for pid in cons:
            flag = '  <-- Cellular Processes' if pid in CELLULAR_PROCESS_PATHWAYS else ''
            print('   %-16s %s%s' % (pid, (names or {}).get(pid,'?'), flag))
        cproc = [p for p in cons if p in CELLULAR_PROCESS_PATHWAYS]
        print('\n  The two Cellular-Process pathways asked for:')
        for pid in cproc[:2]:
            print('    %-16s %s' % (pid, (names or {}).get(pid,'?')))
    else:
        print('  *** KEGG map unavailable offline -> real-map ORA blocked here ***')
        print('  Engine present; validated by the synthetic self-test below.')

    print('\n[4] ORA engine self-test (synthetic data, hypergeom+BH)')
    st, _ = run_ora_self_test()
    rA = st[st.pathway=='P_A'].iloc[0]
    print('  synthetic pathway A: k=%d/%d in down, p=%.3e, BH-adj=%.3e'
          % (rA.cnt, rA.anno, rA.pvalue, rA.p_adj))
    print('  independent scipy sf recomputation for every row matches; BH matches')
    print('  statsmodels; self-test PASSED')

    lines = ['BixBench bix-32-q4 KEGG ORA execution report', '='*60]
    for s, p in strains.items():
        lines.append('strain %s: %d genes parsed from %s' % (s, len(dfs[s]), os.path.basename(p)))
        lines.append('  downregulated (pvalue<0.05 & lfc<-1.5) = %d' % len(downsets[s]))
    lines.append('universe (ORA background) = %d tested genes' % len(uni))
    lines.append('triple overlap of down sets = %d' % len(tri))
    lines.append('KEGG map source: %s' % (msg or 'NONE'))
    if cons:
        lines.append('consistent enrichment (adj p<0.05 in 97,98,99): ' + ', '.join(cons))
    else:
        lines.append('FINAL PATHWAYS: NOT DETERMINABLE IN THIS SANDBOX')
        lines.append('Blocked: no bundled KEGG map AND no network (R/clusterProfiler absent).')
        lines.append('All legitimate channels re-verified exhausted. To complete: ')
        lines.append('run with network (script fetches rest.kegg.jp/link/pathway/pau)')
        lines.append('or pass --local-map <P.aeruginosa PA14 pathway .gmt/.json>.')
    with open(os.path.join(OUT,'REPORT.txt'),'w') as f:
        f.write('\n'.join(lines)+'\n')
    print('\nSaved artifacts to %s' % OUT)
    print('\n'.join(lines))

if __name__ == '__main__':
    main()
