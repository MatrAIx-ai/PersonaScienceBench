#!/usr/bin/env python3
"""
BixBench bix-33-q1: Which immune cell type has the highest number of
significantly differentially expressed genes after AAV9 mini-dystrophin
treatment?

Authoritative source: Supplemental Data File 1 PostvsPre_DEG_tables_ANNOTATED
by_cell_type.xlsx (25 worksheets, one per cell type).
Columns per sheet: gene symbol (index col), p_val, avg_log2FC, pct.1, pct.2,
                   p_val_adj.
Significance criterion: p_val_adj < 0.05 (BH-adjusted), the standard
single-cell DE threshold. Robustness checks: |avg_log2FC| > 0.25 variant,
non-immune exclusion, and raw-p alternative.
"""
import pandas as pd

XLSX = "data/Supplemental Data File 1 PostvsPre_DEG_tables_ANNOTATED by_cell_type.xlsx"

# Non-immune clusters present in the workbook (not leukocytes/immune cells)
NON_IMMUNE = {"Eryth", "Platelet", "HSPC"}

xl = pd.ExcelFile(XLSX)
print(f"# Worksheets read: {len(xl.sheet_names)}")
print(f"# Worksheets: {sorted(xl.sheet_names)}")
print()

records = []
for s in xl.sheet_names:
    df = xl.parse(s)
    gene_col = df.columns[0]           # gene symbol (originally the index col)
    padj = df["p_val_adj"]
    fc = df["avg_log2FC"]
    records.append({
        "cell_type": s,
        "n_rows": len(df),
        "dup_genes": int(df[gene_col].duplicated().sum()),
        "padj<0.05": int((padj < 0.05).sum()),
        "padj<0.05&|fc|>0.25": int(((padj < 0.05) & (fc.abs() > 0.25)).sum()),
        "up": int(((padj < 0.05) & (fc > 0)).sum()),
        "down": int(((padj < 0.05) & (fc < 0)).sum()),
        "raw_p<0.05": int((df["p_val"] < 0.05).sum()),
    })

res = pd.DataFrame(records).sort_values("padj<0.05", ascending=False).reset_index(drop=True)
print("=== Per-cell-type significant DEG counts (p_val_adj < 0.05) ===")
print(res.to_string(index=False))
print()

# Sanity: no duplicate gene symbols anywhere
assert res["dup_genes"].sum() == 0, "duplicate genes found"
print(f"Duplicate-gene symbols across all sheets: {int(res['dup_genes'].sum())} (should be 0)")

# Robustness check 1: does adding |avg_log2FC|>0.25 change any count?
delta = int((res["padj<0.05"] - res["padj<0.05&|fc|>0.25"]).abs().sum())
print(f"Delta when adding |avg_log2FC|>0.25 filter: {delta} (should be 0)")

# Robustness check 2: excluding non-immune rows (Eryth/Platelet/HSPC)
immune = res[~res["cell_type"].isin(NON_IMMUNE)]
w_all = res.iloc[0]
noni = ", ".join(f"{r['cell_type']}={int(r['padj<0.05'])}" for _, r in res[res["cell_type"].isin(NON_IMMUNE)].iterrows())
print(f"Winner among ALL cell types   : {w_all['cell_type']} ({int(w_all['padj<0.05'])} sig DEGs)")
print(f"Winner among IMMUNE  cell types: {immune.iloc[0]['cell_type']} ({int(immune.iloc[0]['padj<0.05'])} sig DEGs)")
print(f"Non-immune counts ({noni}) -> winner unchanged")
print()

# Robustness check 3: alternative (unadjusted) raw-p criterion changes winner
alt = res.sort_values("raw_p<0.05", ascending=False)
print("Under raw p<0.05 (unadjusted), top would be: "
      + ", ".join(f"{r['cell_type']}={int(r['raw_p<0.05'])}" for _, r in alt.head(3).iterrows()))
print("-> criterion is consequential; adjusted p-value (p_val_adj<0.05) is used.")
print()

print("=== Top 10 cell types by p_val_adj<0.05 DEG count ===")
print(res.head(10).to_string(index=False))

res.to_csv("results/deg_counts_per_celltype.csv", index=False)
print("\nSaved results/deg_counts_per_celltype.csv")
