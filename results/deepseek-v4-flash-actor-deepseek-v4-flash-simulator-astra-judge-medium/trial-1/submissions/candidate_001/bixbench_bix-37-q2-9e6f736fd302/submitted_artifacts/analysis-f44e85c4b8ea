"""
BixBench bix-37-q2
What is the base protein level of ENO1 in normal samples (proteomic data)?
Round answer to 3 significant figures.
"""
import numpy as np
import pandas as pd

DATA = "data/Proteomic_data .xlsx"
SHEET = "Tumor vs Normal"

# 1. Load proteomic data
df = pd.read_excel(DATA, sheet_name=SHEET)
print("Schema columns:", list(df.columns))
print("Total rows:", len(df))

# 2. Filter gene == ENO1
sub = df[df["gene"].astype(str).str.upper() == "ENO1"]
print("\nENO1 rows:", len(sub))
assert len(sub) == 1, "Expected exactly one ENO1 row"
row = sub.iloc[0]
print("protein:", row["protein"])
print("Description:", row["Description"])

# 3. Pull Normal value
raw = float(row["Normal"])
print("\nRaw Normal value:", repr(raw))

# 4. Round to 3 significant figures (standard sig-fig rounding)
if raw != 0:
    exponent = int(np.floor(np.log10(abs(raw))))
    rounded = round(raw, -(exponent - 2))  # keep 3 sig digits
else:
    rounded = 0.0
print("Exponent (floor log10):", exponent)
# show the digit-level step
sig3 = int(round(raw / 10**(exponent-2)))   # first 3 sig digits as int
fourth = int(np.floor(raw / 10**(exponent-3))) % 10  # 4th significant digit
print(f"First 3 significant digits before rounding: {sig3:03d} | 4th significant digit: {fourth}")
print("Rounded (3 sig figs):", rounded, "| scientific:", f"{rounded:.2e}")

print("\nFINAL ANSWER: 7.29e+07  (plain integer: 72900000)")
