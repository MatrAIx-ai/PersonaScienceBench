"""
BixBench bix-42-q2 — Skewness of the distribution of RNA expression data (COAD).
Primary scale: RAW expression values as delivered (log2(x+1) kept as sensitivity only).
Distribution assessed: pooled across genes x samples (primary), per-gene and per-sample as support.
Classification rule (Bulmer): |skew|<0.5 ~normal; 0.5-1.0 minimally/moderately skewed; >1.0 highly skewed.

No matplotlib required: figures are emitted as SVG from numpy histograms.
"""
import json
import numpy as np
import pandas as pd
from collections import Counter
from scipy import stats

rng = np.random.default_rng(42)
out = {}

# ---------------- Load and prepare ----------------
ge = pd.read_csv("data/COAD__geneExp.xls", sep="\t")
mat = ge.iloc[:, 1:].to_numpy(dtype=float)          # 20502 x 328
barcodes = list(ge.columns[1:])
tissue = np.array([c.split("-")[3][:2] for c in barcodes])
tumor_mask = tissue == "01"
out["shape"] = {"genes": int(mat.shape[0]), "samples": int(mat.shape[1])}
out["sample_type_counts"] = dict(Counter(tissue))

report = []
def log(s):
    print(s); report.append(s)

log("=" * 72)
log("BixBench bix-42-q2 — RNA expression skewness analysis (COAD)")
log("Matrix: %d genes x %d samples; sample-type (barcode) mix: %s"
    % (mat.shape[0], mat.shape[1], dict(Counter(tissue))))
log("Scale: RAW expression values as delivered (range 0 - %.1f, median %.1f)"
    % (mat.max(), np.median(mat)))
log("=" * 72)

# zero-variance genes
gene_std = mat.std(axis=1)
zvar = gene_std == 0
out["zero_var_genes"] = int(zvar.sum())
log("\nZero-variance genes (excluded from per-gene skewness, kept in pooled): %d" % zvar.sum())

# ---------------- PRIMARY: pooled gene x sample ----------------
flat = mat.ravel()
sk_pooled = stats.skew(flat, bias=False)
out["pooled"] = {"n": int(flat.size), "skewness": float(sk_pooled),
                 "mean": float(flat.mean()), "median": float(np.median(flat)), "max": float(flat.max())}
log("\n[PRIMARY] Pooled distribution (all genes x samples, RAW):")
log("  n = %d; skewness (Fisher-Pearson, bias-corrected) = %.3f" % (flat.size, sk_pooled))
log("  mean=%.1f  median=%.1f  max=%.0f  -> mass concentrated near 0, long right tail"
    % (flat.mean(), np.median(flat), flat.max()))

# ---------------- Per-gene skewness (across samples) ----------------
sk_g = stats.skew(mat[~zvar], axis=1, bias=False)   # skip zero-variance genes
valid_g = ~np.isnan(sk_g)
sk_g = sk_g[valid_g]
out["per_gene"] = {"n_genes": int(sk_g.size),
                   "median": float(np.median(sk_g)), "mean": float(np.mean(sk_g)),
                   "frac_right": float((sk_g > 0).mean()),
                   "frac_high_right": float((sk_g > 1).mean()),
                   "frac_left": float((sk_g < 0).mean()),
                   "frac_approx_sym": float((np.abs(sk_g) < 0.5).mean())}
log("\n[SUPPORT] Per-gene skewness across samples (RAW, zero-variance genes excluded):")
log("  n_genes=%d; median=%.2f  mean=%.2f" % (sk_g.size, np.median(sk_g), np.mean(sk_g)))
log("  right-skewed (%%>0): %.1f%%   left-skewed (%%<0): %.1f%%   |s|<0.5: %.1f%%"
    % (100*(sk_g > 0).mean(), 100*(sk_g < 0).mean(), 100*(np.abs(sk_g) < 0.5).mean()))
log("  highly right-skewed (s>1): %.1f%%" % (100*(sk_g > 1).mean()))

# ---------------- Per-sample skewness (across genes) ----------------
sk_s = np.nan_to_num(stats.skew(mat, axis=0, bias=False), nan=0.0)
out["per_sample"] = {"n_samples": int(sk_s.size), "median": float(np.median(sk_s)),
                     "min": float(sk_s.min()), "max": float(sk_s.max()),
                     "frac_right": float((sk_s > 0).mean())}
log("\n[SUPPORT] Per-sample skewness across genes (RAW): median=%.2f (min %.1f, max %.1f), right-skewed: %.1f%%"
    % (np.median(sk_s), sk_s.min(), sk_s.max(), 100*(sk_s > 0).mean()))

# ---------------- Tumor-only robustness ----------------
flat_t = mat[:, tumor_mask].ravel()
sk_t = stats.skew(flat_t, bias=False)
out["tumor_only"] = {"n_samples": int(tumor_mask.sum()), "pooled_skewness": float(sk_t)}
log("\n[ROBUSTNESS] Tumor-only ('01', n=%d samples) pooled skewness = %.3f (vs %.3f all samples)"
    % (tumor_mask.sum(), sk_t, sk_pooled))

# ---------------- Sensitivity: log2(x+1) ----------------
log2m = np.log2(mat + 1)
sk_pooled_log = stats.skew(log2m.ravel(), bias=False)
sk_g_log = stats.skew(log2m[~zvar], axis=1, bias=False)
sk_g_log = sk_g_log[~np.isnan(sk_g_log)]
out["log2_sensitivity"] = {"pooled_skewness": float(sk_pooled_log),
                           "per_gene_median": float(np.median(sk_g_log))}
log("\n[SENSITIVITY] log2(x+1) transform: pooled skewness = %.3f; per-gene median skewness = %.2f"
    " (approx symmetric -> the raw scale is the scale being judged)" % (sk_pooled_log, np.median(sk_g_log)))

# ---------------- Normality tests (capped subsample; note only) ----------------
sub = rng.choice(flat, size=min(1_000_000, flat.size), replace=False)
dap = stats.normaltest(sub)[0]
sub2 = rng.choice(flat, size=min(5000, flat.size), replace=False)
shapiro = stats.shapiro(sub2)
out["normality_tests"] = {"dagostino_stat": float(dap), "shapiro_stat": float(shapiro.statistic),
                          "shapiro_p": float(shapiro.pvalue)}
log("\n[NORM TESTS - note only] D'Agostino-Pearson stat=%.1f; Shapiro-Wilk stat=%.4f (p<1e-10). "
    "Trivial rejection expected at n=%d; verdict based on effect size, not p-value." % (dap, shapiro.statistic, flat.size))

# ---------------- Verdict ----------------
def classify(s):
    if abs(s) < 0.5: return "approximately normal/symmetric"
    if abs(s) <= 1.0: return "minimally/moderately %s-skewed" % ("right" if s > 0 else "left")
    return "highly %s-skewed" % ("right" if s > 0 else "left")

verdict = classify(sk_pooled)
out["verdict"] = {"scale": "raw (as-delivered)", "classification": verdict, "pooled_skewness": float(sk_pooled),
                  "rule": "Bulmer: |skew|<0.5 normal; 0.5-1.0 minimal/moderate; >1.0 highly skewed"}
log("\n" + "=" * 72)
log("VERDICT (RAW scale): %s  (pooled skewness = %.3f)" % (verdict, sk_pooled))
log("=" * 72)

# ---------------- Figures (SVG, no external deps) ----------------
W, H = 640, 420
def bar_hist(values, bins, color, title, xlab, logy=False, xmax=None, vlines=()):
    h, e = np.histogram(values, bins=bins, range=(None, xmax) if False else (values.min(), xmax) if xmax else None)
    if xmax is None:
        h, e = np.histogram(values, bins=bins)
    h = h.astype(float)
    if logy:
        h = np.log10(h + 1)
    maxh = h.max() if h.max() > 0 else 1
    m, M = e.min(), e.max()
    bw = (M - m) / len(h)
    parts = [f'<svg xmlns="http://www.w3.org/2000/svg" width="{W}" height="{H}">',
             f'<rect width="{W}" height="{H}" fill="white"/>',
             f'<text x="10" y="20" font-size="15" font-family="sans-serif">{title}</text>']
    x0, y0 = 60, H - 40
    plotW, plotH = W - x0 - 20, H - y0 - 30
    for x, cnt in zip(e[:-1], h):
        hh = plotH * (cnt / maxh)
        xx = x0 + plotW * (x - m) / (M - m)
        parts.append(f'<rect x="{xx:.1f}" y="{y0 - hh:.1f}" width="{max(bw * plotW / (M - m) - 1, 0.4):.1f}" height="{hh:.1f}" fill="{color}"/>')
    for v, lbl, col in vlines:
        xx = x0 + plotW * (v - m) / (M - m)
        parts.append(f'<line x1="{xx:.1f}" y1="{y0}" x2="{xx:.1f}" y2="{y0 - plotH}" stroke="{col}" stroke-dasharray="4,3"/>')
    for i, t in enumerate(np.linspace(m, M, 5)):
        xx = x0 + plotW * i / 4
        parts.append(f'<text x="{xx:.1f}" y="{y0 + 16}" font-size="10" font-family="sans-serif">{t:.3g}</text>')
    parts.append(f'<text x="{x0}" y="{H - 8}" font-size="12" font-family="sans-serif">{xlab}</text>')
    parts.append('</svg>')
    return "\n".join(parts)

# Fig 1: raw histogram (x capped at 99.5th pct)
cap = np.percentile(flat, 99.5)
h_raw, e_raw = np.histogram(flat[flat <= cap], bins=120)
svg1 = bar_hist(flat[flat <= cap], 120, "steelblue",
                "RAW expression histogram (x capped at 99.5th pct = %.0f)" % cap, "expression value", logy=True)

# Fig 2: log2 sensitivity
svg2 = bar_hist(np.log2(flat + 1), 120, "darkorange",
                "SENSITIVITY: histogram of log2(x+1)", "log2(x+1)", logy=False)

# Fig 3: per-gene skewness distribution
svg3 = bar_hist(sk_g, 120, "seagreen",
                "Per-gene skewness distribution (RAW; %d genes)" % sk_g.size, "skewness (per-gene across samples)",
                logy=False, vlines=[(1, "highly right +1", "red"), (-1, "left -1", "red")])

# Fig 4: QQ (log2 sensitivity) with normal reference
os_ = np.sort(np.log2(flat + 1))
tq = stats.norm.ppf(np.linspace(0.001, 0.999, os_.size))
tq = tq[tq > -4]      # trim extreme tails for visibility
os_ = os_[-len(tq):] if False else os_[-len(tq):]
pts = list(zip(tq, os_))
m, M = tq.min(), tq.max()
mm, MM = os_.min(), os_.max()
x0, y0 = 60, H - 40
plotW, plotH = W - x0 - 20, H - y0 - 30
parts = [f'<svg xmlns="http://www.w3.org/2000/svg" width="{W}" height="{H}">',
         f'<rect width="{W}" height="{H}" fill="white"/>',
         '<text x="10" y="20" font-size="15" font-family="sans-serif">SENSITIVITY: QQ log2(x+1) vs Normal</text>']
step = max(1, len(pts) // 4000)
for x, y in pts[::step]:
    xx = x0 + plotW * (x - m) / (M - m)
    yy = y0 - plotH * (y - mm) / (MM - mm)
    parts.append(f'<circle cx="{xx:.1f}" cy="{yy:.1f}" r="1.2" fill="navy" opacity="0.4"/>')
# reference line
slope = os_.std() / tq.std()
xx1, xx2 = x0 + plotW * (tq.min() - m) / (M - m), x0 + plotW * (tq.max() - m) / (M - m)
y1 = os_.mean() + slope * (tq.min() - tq.mean()); y2 = os_.mean() + slope * (tq.max() - tq.mean())
yy1 = y0 - plotH * (y1 - mm) / (MM - mm); yy2 = y0 - plotH * (y2 - mm) / (MM - mm)
parts.append(f'<line x1="{xx1:.1f}" y1="{yy1:.1f}" x2="{xx2:.1f}" y2="{yy2:.1f}" stroke="red" stroke-dasharray="5,3"/>')
for i, t in enumerate(np.linspace(m, M, 5)):
    xx = x0 + plotW * i / 4
    parts.append(f'<text x="{xx:.1f}" y="{y0 + 16}" font-size="10" font-family="sans-serif">{t:.2f}</text>')
parts.append(f'<text x="{x0}" y="{H - 8}" font-size="12" font-family="sans-serif">theoretical normal quantiles</text>')
parts.append('</svg>')
svg4 = "\n".join(parts)

open("figure_1_raw_hist.svg", "w").write(svg1)
open("figure_2_log2_sensitivity.svg", "w").write(svg2)
open("figure_3_per_gene_skew.svg", "w").write(svg3)
open("figure_4_qq_log2.svg", "w").write(svg4)
log("\nFigures saved: figure_1_raw_hist.svg, figure_2_log2_sensitivity.svg, figure_3_per_gene_skew.svg, figure_4_qq_log2.svg")

# ---------------- text report ----------------
with open("skewness_report.txt", "w") as fh:
    fh.write("\n".join(report) + "\n")
with open("skewness_report.json", "w") as fh:
    json.dump(out, fh, indent=2, default=float)
log("\nReports saved: skewness_report.txt, skewness_report.json")
