"""
DESeq2-style DE: CBD/cisplatin combination (grp 9) vs DMSO (grp 3), n=6.
Median-of-ratios size factors -> per-gene Cox-Reid adjusted NB dispersion MLE with
per-group mean structure + parametric trend shrinkage -> NB GLM Wald test -> BH padj.
"""
import numpy as np, pandas as pd, time
from scipy.optimize import minimize_scalar
from scipy.stats import nbinom, norm
from statsmodels.stats.multitest import multipletests

t0=time.time()
counts = pd.read_csv('data/counts_raw_unfiltered.csv', index_col=0)
DMSO=['3-1','3-2','3-3']; COMBO=['9-1','9-2','9-3']
sids=DMSO+COMBO
cols=[s.replace('-','_') for s in sids]
X=counts[cols].astype(float).values
g=np.array([0,0,0,1,1,1])

# ---- size factors (DESeq2 median-of-ratios) ----
logX=np.log(X)
loggeomeans=np.mean(logX,axis=1)
valid=np.isfinite(loggeomeans)
sf=np.median(X[valid]/np.exp(loggeomeans[valid])[:,None],axis=0)
print("size factors:",np.round(sf,4))
norm_c=X/sf[None,:]
baseMean=norm_c.mean(axis=1)
idx=np.where(baseMean>0)[0]
Y=X[idx]; N=norm_c[idx]; bm=baseMean[idx]; n_genes=len(idx)
gm0=N[:,:3].mean(axis=1); gm1=N[:,3:].mean(axis=1)
mu= np.hstack([(gm0[:,None]*sf[None,:3]),(gm1[:,None]*sf[None,3:])])  # per-group mean * size factor

def nb_ll(alpha,y,mu_vec):
    r=1.0/alpha; p=r/(r+mu_vec); return np.sum(nbinom.logpmf(y,r,p))

def cr_neg(alpha,y,mu_vec):
    if alpha<=0: return 1e15
    ll=nb_ll(alpha,y,mu_vec)
    w=mu_vec/(1.0+alpha*mu_vec)
    w0=w[:3].sum(); w1=w[3:].sum()
    H=np.array([[w0+w1,w1],[w1,w1]])
    sign,ld=np.linalg.slogdet(H)
    return -(ll-0.5*ld) if sign>0 else 1e15

alphas=np.full(n_genes,np.nan)
for i in range(n_genes):
    r=minimize_scalar(cr_neg,args=(Y[i],mu[i]),bounds=(1e-6,100),method='bounded',options={'xatol':1e-5})
    if np.isfinite(r.fun) and r.fun<1e14: alphas[i]=r.x
print(f"dispersion MLE converged: {np.isfinite(alphas).sum()}/{n_genes} t={time.time()-t0:.0f}s")
print("raw MLE dispersion quantiles:",np.round(np.quantile(alphas[np.isfinite(alphas)],[0,.25,.5,.75,1]),5))

# ---- parametric trend + MAP shrinkage ----
ok=np.isfinite(alphas)
lv=np.log(bm[ok]); la=np.log(alphas[ok])
coef=np.polyfit(lv,la,1)
trend_all=np.polyval(coef,np.log(bm))
resid=la-np.polyval(coef,lv)
prior_sd=max(np.sqrt(np.median(resid**2)),0.25)
print("trend: logdisp =",round(coef[0],3),"* logmean +",round(coef[1],3),"| prior sd:",round(prior_sd,3))

def map_neg(alpha,y,mu_vec,tv):
    if alpha<=0: return 1e15
    return -(nb_ll(alpha,y,mu_vec)+norm.logpdf(np.log(alpha),tv,prior_sd))

shrunk=np.full(n_genes,np.nan)
for i in range(n_genes):
    tv=trend_all[i]
    if ok[i]:
        r=minimize_scalar(map_neg,args=(Y[i],mu[i],tv),bounds=(1e-6,100),method='bounded',options={'xatol':1e-5})
        shrunk[i]=r.x
    else:
        shrunk[i]=np.exp(tv)
print("shrunken dispersion quantiles:",np.round(np.quantile(shrunk,[0,.25,.5,.75,1]),5),f"t={time.time()-t0:.0f}s")

# ---- Wald test via NB GLM ----
def nb_glm(y,sfv,grp,a):
    Xd=np.column_stack([np.ones(y.shape[0]),grp]); off=np.log(sfv)
    beta=np.array([np.log(y.mean()+1e-6),0.0]); Xw=None
    for _ in range(60):
        eta=Xd@beta+off; m=np.exp(eta)
        w=m/(1+a*m)
        z=eta+(y-m)/m
        Xw=Xd*np.sqrt(w)[:,None]
        bnew=np.linalg.solve(Xw.T@Xw,Xw.T@(np.sqrt(w)*z))
        if np.max(np.abs(bnew-beta))<1e-7: beta=bnew;break
        beta=bnew
    cov=np.linalg.pinv(Xw.T@Xw)
    return beta[1],np.sqrt(cov[1,1])

betas=np.zeros(n_genes); ses=np.full(n_genes,np.inf)
for i in range(n_genes):
    if Y[i][:3].sum()==0 or Y[i][3:].sum()==0:   # uninformative gene -> not testable
        continue
    try:
        betas[i],ses[i]=nb_glm(Y[i],sf,g,shrunk[i])
    except (np.linalg.LinAlgError, ValueError):
        continue
z=betas/ses; z[~np.isfinite(z)]=np.nan
pval=2*norm.sf(np.abs(z)); lfc=betas/np.log(2)

res=pd.DataFrame({'baseMean':bm,'log2FoldChange':lfc,'pvalue':pval},index=counts.index[idx])
res['padj']=multipletests(pval,method='fdr_bh')[1]
res.to_csv('analysis/deseq2_style_results.csv')
print("genes tested:",len(res),"| padj<0.05:",int((res.padj<0.05).sum()))

de=res[(res.padj<0.05)&(res.log2FoldChange.abs()>0.5)&(res.baseMean>10)]
print("DE (padj<0.05, |lfc|>0.5, baseMean>10):",len(de),"| up:",int((de.log2FoldChange>0.5).sum()),"| down:",int((de.log2FoldChange<-0.5).sum()))

mp=pd.read_csv('data/ensg_to_gene_name.tsv',sep='\t').drop_duplicates('ENSG')
de['gene_symbol']=de.index.map(mp.set_index('ENSG')['gene_name'])
mapped=de.dropna(subset=['gene_symbol'])
print("DE with symbol:",len(mapped),"| unmapped dropped:",len(de)-len(mapped))
unq=mapped['gene_symbol'].drop_duplicates()
unq.to_csv('analysis/de_symbols.txt',index=False,header=False)
de.to_csv('analysis/de_genes.csv')
print("unique DE symbols for enrichment:",len(unq))
print("\ntop 12 by padj:")
print(mapped.sort_values('padj')[['baseMean','log2FoldChange','pvalue','padj','gene_symbol']].head(12).to_string())
print(f"\nTOTAL TIME {time.time()-t0:.0f}s")
