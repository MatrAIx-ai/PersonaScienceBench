#!/usr/bin/env python3
"""
BixBench bix-46-q1:
log2 fold change (to 2 dp) for mexG expression in ΔrhlI (strain #97) vs wt (strain #1).

Pipeline:
  1. Annotation CSV  : gene symbol 'mexG' -> Locus Tag PA14_09540 (PGD1652375).
  2. data/res_1vs97.rds is a gzip-compressed R serialization-v3 DESeqResults
     (S4/DataFrame, 5828 rows x 6 cols). This script parses it with a small
     self-contained binary tokenizer (no R runtime required):
       - rownames STRSXP   : type word 00 00 00 10 + int32 length 5828,
                             each element framed 00 04 00 09 + int32 len + bytes
       - 6 REALSXP columns : type word 00 00 00 0E + int32 length 5828 + 8*n
                             double values; taken in stream order = column order.
  3. mexG row = the row whose rowname == PA14_09540; log2FoldChange rounded to 2 dp.

Sign convention (from the RDS's own column metadata):
  "log2 fold change (MLE): Strain 97 vs 1"  -> value = log2(expr_97 / expr_1);
  positive = up in ΔrhlI (#97) vs wt (#1). Reported as-is, no sign flip.
"""
import gzip
import struct

import numpy as np
import pandas as pd

RDS_PATH = "data/res_1vs97.rds"
CSV_PATH = "data/Pseudomonas_aeruginosa_UCBPP-PA14.csv"
N_ROWS = 0x16C4  # 5828
COL_NAMES = ["baseMean", "log2FoldChange", "lfcSE", "stat", "pvalue", "padj"]


def scan(needle: bytes, hay: bytes, start: int = 0):
    """all non-overlapping occurrences of needle in hay, in order."""
    out, i = [], start
    while True:
        j = hay.find(needle, i)
        if j < 0:
            return out
        out.append(j)
        i = j + 1


def parse_rds(path: str):
    data = gzip.open(path, "rb").read()
    assert data[:2] == b"X\n", "not an R serialization stream"
    assert struct.unpack(">i", data[2:6])[0] == 3, "expected serialization v3"

    # --- rownames: STRSXP with length 5828 ---
    hits = scan(b"\x00\x00\x00\x10" + struct.pack(">i", N_ROWS), data)
    assert hits, "rownames STRSXP not found"
    pos = hits[0] + 8  # skip type word + length
    rownames = []
    for _ in range(N_ROWS):
        assert data[pos:pos + 4] == b"\x00\x04\x00\x09", "bad CHARSXP frame"
        ln = struct.unpack(">i", data[pos + 4:pos + 8])[0]
        s = data[pos + 8:pos + 8 + ln]
        rownames.append(s.decode("ascii"))
        pos += 8 + ln

    # --- columns: first six REALSXP of length 5828 (stream order = col order) ---
    pat = b"\x00\x00\x00\x0e" + struct.pack(">i", N_ROWS)
    offs = scan(pat, data)
    assert len(offs) >= 6, f"found {len(offs)} full-length REALSXP columns"
    arrays = []
    for off in offs[:6]:
        vals = np.frombuffer(data[off + 8:off + 8 + 8 * N_ROWS], ">f8")
        arrays.append(vals.copy())
    return np.array(rownames), arrays


rownames, arrays = parse_rds(RDS_PATH)
tab = pd.DataFrame(
    {name: arrays[i] for i, name in enumerate(COL_NAMES)},
    index=rownames,
)

# --- annotation: mexG -> locus tag ---
ann = pd.read_csv(CSV_PATH, dtype=str)
mex = ann[ann["Gene Name"].str.strip().str.lower() == "mexg"]
assert len(mex) == 1
locus = mex.iloc[0]["Locus Tag"].strip()
print(f"[1] mexG -> Locus Tag {locus} (PGD Gene ID: {mex.iloc[0]['PGD Gene ID']})")

assert locus in tab.index and (tab.index == locus).sum() == 1
row = tab.loc[locus]
l2fc = float(row["log2FoldChange"])

# --- report ---
print(f"[2] RDS parsed: {len(tab)} rows x {len(tab.columns)} cols; "
      f"first rowname = {tab.index[0]}")
print(f"[3] {locus} (mexG) row values:")
for k in COL_NAMES:
    print(f"      {k:<15} = {row[k]:.12g}")
print(f"[4] raw (unrounded) log2FoldChange = {l2fc!r}")

# internal-consistency check across the full table
with np.errstate(invalid="ignore", divide="ignore"):
    err = float((tab["stat"] - tab["log2FoldChange"] / tab["lfcSE"]).abs().max())
assert err == 0.0, "stat != log2FC/lfcSE (alignment error)"
print(f"[5] sanity: max|stat - log2FC/lfcSE| = {err} (exact)")

answer = round(l2fc, 2)
print(f"[6] FINAL ANSWER: log2FoldChange(mexG) in ΔrhlI(#97) vs wt(#1), "
      f"rounded 2dp = {answer}")
with open("analysis/answer.txt", "w") as f:
    f.write(str(answer))
