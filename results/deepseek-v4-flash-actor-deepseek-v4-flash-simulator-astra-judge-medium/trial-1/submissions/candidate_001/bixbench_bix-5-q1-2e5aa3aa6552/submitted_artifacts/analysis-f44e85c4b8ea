#!/usr/bin/env python3
"""
bixbench:bix-5-q1 - DE (disease vs control) + GO-BP enrichment framework.
Executed deliverable. Pure Python (numpy/pandas/scipy/statsmodels); no internet, no R.
Pipeline: subset to 14 coldata samples -> collapse PAR_Y duplicates (sum) ->
median-of-ratios size factors -> NB GLM (~condition) with trend dispersion shrinkage ->
Wald test + BH -> one-sided hypergeometric ORA per GO BP term with BH FDR.
"""
import numpy as np, pandas as pd
from scipy import stats
from statsmodels.nonparametric.smoothers_lowess import lowess
from statsmodels.stats.multitest import multipletests
import os, json

np.random.seed(1)
DATA = "data/"
os.makedirs("results", exist_ok=True)

# ---------------------------------------------------------------- 1. inputs
cd = pd.read_excel(DATA + "Issy_ASXL1_fibro_coldata_gender.xlsx")
samples = cd["sample"].tolist()
cond = cd.set_index("sample")["condition"]
sex  = cd.set_index("sample")["sex"]
print("coldata samples:", len(samples), "| disease:", int((cond=="disease").sum()),
      "control:", int((cond=="control").sum()))

cnt = pd.read_csv(DATA + "Issy_ASXL1_fibro_featureCounts_GeneTable_final.txt", sep=r"\s+")
print("featureCounts raw shape:", cnt.shape)
cnt = cnt[["Geneid"] + samples]

# ---------------------------------------------------------------- 2. collapse PAR_Y duplicate gene ids (sum counts)
fc = cnt.copy()
fc["id_no_ver"] = fc["Geneid"].str.replace("_PAR_Y", "").str.split(".").str[0]
print("rows before collapse:", fc.shape[0], "| unique id_no_ver:", fc["id_no_ver"].nunique())
counts = fc.groupby("id_no_ver", sort=False)[samples].sum()
print("rows after PAR_Y collapse:", counts.shape[0],
      "(= unique gene ids; dropped", fc.shape[0] - counts.shape[0], "PAR_Y duplicate rows)")

# ---------------------------------------------------------------- 3. annotation
gen = pd.read_csv(DATA + "gencode.v31.primary_assembly.genes.csv")
gen["id_no_ver"] = gen["gene_id"].astype(str).str.split(".").str[0]
gen = gen.drop_duplicates("id_no_ver").set_index("id_no_ver")
hg = pd.read_csv(DATA + "HGNC_05-09-19.txt", sep="\t")
hg = hg[hg["Status"] == "Approved"][["Ensembl ID(supplied by Ensembl)", "Approved symbol"]].drop_duplicates()
hg["ens_no_ver"] = hg["Ensembl ID(supplied by Ensembl)"].astype(str).str.split(".").str[0]
hgsym = hg.drop_duplicates("ens_no_ver").set_index("ens_no_ver")["Approved symbol"]

expr = pd.DataFrame(index=counts.index)
expr["gene_name"] = counts.index.map(gen["gene_name"])
expr["gene_type"] = counts.index.map(gen["gene_type"])
expr["hgnc_id"]   = counts.index.map(gen["hgnc_id"])
expr["symbol"]    = expr.index.map(hgsym).where(expr.index.map(hgsym).notna(), expr["gene_name"])
print("genes annotated from gencode:", expr["gene_name"].notna().sum(), "/", expr.shape[0])
print("genes with HGNC approved symbol:", expr["symbol"].notna().sum())

# ---------------------------------------------------------------- 4. low-count filter (rowSums >= 10)
keep = counts[samples].sum(axis=1) >= 10
mat = counts[keep].astype(float)
meta = expr[keep]
print("genes passing rowSums>=10 filter:", mat.shape[0],
      "| protein_coding:", int((meta["gene_type"]=="protein_coding").sum()))

# ---------------------------------------------------------------- 5. median-of-ratios size factors (DESeq2)
C = mat.values.copy()
with np.errstate(divide="ignore", invalid="ignore"):
    logc = np.log(C)
gmeans = np.exp(np.mean(logc, axis=1))
gmeans[gmeans == 0] = np.nan
ratios = C / gmeans[:, None]
sf = np.nanmedian(ratios, axis=0)
sf = sf / np.exp(np.mean(np.log(sf)))
print("size factors:", np.round(sf, 4).tolist())
offset = np.log(sf)

# ---------------------------------------------------------------- 6. NB GLM ~ condition (IRLS) + trend dispersion shrinkage
n, p = mat.shape[1], 2
cond1 = (cond.values == "disease").astype(float)
X = np.column_stack([np.ones(n), cond1])
grp_idx = {0: np.where(cond1 == 0)[0], 1: np.where(cond1 == 1)[0]}

def nb_irls(y, X, offset, disp, iters=60, tol=1e-10, emax=30.0):
    """NB GLM (any design): eta = X beta + offset; var = mu(1 + disp*mu); IRLS, log link.
    eta is clamped to [-emax, emax] to avoid overflow; pinv for covariance."""
    p = X.shape[1]
    beta = np.linalg.lstsq(X, np.log(np.clip(y, 0.5, None)) - offset, rcond=None)[0]
    with np.errstate(over="ignore", invalid="ignore", divide="ignore"):
        for _ in range(iters):
            eta = np.clip(X @ beta + offset, -emax, emax)
            mu = np.exp(eta)
            w = mu / (1 + disp * mu)
            z = eta + (y - mu) / mu
            wm = np.sqrt(w)
            beta_new, *_ = np.linalg.lstsq(wm[:, None] * X, wm * (z - offset), rcond=None)
            if not np.all(np.isfinite(beta_new)):
                break
            if np.max(np.abs(beta_new - beta)) < tol:
                beta = beta_new
                break
            beta = beta_new
    eta = np.clip(X @ beta + offset, -emax, emax)
    mu = np.exp(eta)
    W = mu / (1 + disp * mu)
    XWX = (X * W[:, None]).T @ X
    try:
        cov = np.linalg.pinv(XWX)
    except np.linalg.LinAlgError:
        cov = np.full((p, p), np.nan)
    return beta, mu, cov

def mom_dispersion(y, mu):
    # E[pear] = sum(var/mu) = n + d*sum(mu)  =>  d = (pear - (n-p)) / sum(mu)
    df = n - p
    pear = np.sum((y - mu) ** 2 / mu)
    return max((pear - df) / max(np.sum(mu), 1e-12), 1e-8)

G = mat.shape[0]
b1 = np.zeros(G); dmom = np.zeros(G); musum = np.zeros(G)
b1p = np.zeros(G); lfcSE = np.zeros(G); pval = np.full(G, np.nan); dshrunk = np.full(G, np.nan)
mu_all = np.zeros((G, n))

for g in range(G):
    y = C[g]
    b, mu, _ = nb_irls(y, X, offset, disp=0.05)
    b1[g] = b[1]; musum[g] = mu.mean(); dmom[g] = mom_dispersion(y, mu); mu_all[g] = mu

# dispersion trend (lowess on log scale) + shrinkage toward trend
ok = np.isfinite(np.log(dmom)) & (musum > 0)
low = lowess(np.log(dmom[ok]), np.log(musum[ok]), frac=0.4, it=3, return_sorted=False)
log_dfit = np.full(G, np.nan); log_dfit[ok] = low
dcommon = np.median(dmom[ok])
dfit = np.where(np.isfinite(log_dfit), np.exp(log_dfit), dcommon)
prior_df = 30.0
log_dshrunk = ((n - p) * np.log(dmom) + prior_df * np.log(dfit)) / ((n - p) + prior_df)
dshrunk = np.clip(np.exp(log_dshrunk), 1e-8, 1e6)
from numpy import percentile as _pc
print("dispersion diagnostics: dmom median=%.4g p10=%.4g p90=%.4g | dfit median=%.4g | dshrunk median=%.4g"
      % (_pc(dmom[ok], 50), _pc(dmom[ok], 10), _pc(dmom[ok], 90),
         _pc(dfit[ok], 50), _pc(dshrunk, 50)))

# refit with shrunk dispersion -> Wald statistics
for g in range(G):
    y = C[g]
    b, mu, cov = nb_irls(y, X, offset, disp=dshrunk[g])
    b1p[g] = b[1]; mu_all[g] = mu
    if np.isfinite(cov[1, 1]) and cov[1, 1] > 0:
        se = np.sqrt(cov[1, 1])
    else:
        se = np.nan
    lfcSE[g] = se
    z = b[1] / se if np.isfinite(se) else np.nan
    pval[g] = 2 * stats.norm.sf(abs(z)) if np.isfinite(z) else 1.0
padj = multipletests(pval, method="fdr_bh")[1]

res = pd.DataFrame({
    "id": mat.index,
    "gene_name": meta["gene_name"].values,
    "symbol": meta["symbol"].values,
    "gene_type": meta["gene_type"].values,
    "baseMean": musum * sf.mean(),
    "log2FoldChange": b1p / np.log(2),
    "lfcSE": lfcSE,
    "stat": b1p / lfcSE,
    "pvalue": pval,
    "padj": padj,
    "dispersion": dshrunk,
}).sort_values("pvalue")
res.to_csv("results/deseq2_like_condition_results.csv", index=False)

sig = res[res["padj"] < 0.05]
print("\n=== DE results (design ~ condition, disease vs control) ===")
print("genes tested:", res.shape[0])
print("significant padj<0.05:", sig.shape[0],
      "| up (disease higher):", int((sig.log2FoldChange > 0).sum()),
      "| down:", int((sig.log2FoldChange < 0).sum()))
sig2 = sig[sig.log2FoldChange.abs() > 1]
print("additional filter |log2FC|>1 & padj<0.05:", sig2.shape[0],
      "| up:", int((sig2.log2FoldChange > 0).sum()), "| down:", int((sig2.log2FoldChange < 0).sum()))
print("\nTop 20 by padj:")
print(sig.sort_values("padj").head(20)
      [["symbol", "gene_name", "log2FoldChange", "pvalue", "padj"]].to_string(index=False))
print("padj describe:", {k: float(v) for k, v in res["padj"].describe().items()})

# ------------------------------------------------ 7. sensitivity: design ~ sex + condition
Xs = np.column_stack([np.ones(n),
                      (cond.values == "disease").astype(float),
                      (sex.values == "M").astype(float)])
pm = np.full(G, np.nan); b1m = np.full(G, np.nan)
for g in range(G):
    y = C[g]
    b, mu, cov = nb_irls(y, Xs, offset, disp=dshrunk[g])
    if np.isfinite(cov[1, 1]) and cov[1, 1] > 0:
        se = np.sqrt(cov[1, 1])
    else:
        se = np.nan
    b1m[g] = b[1]
    z = b[1] / se if np.isfinite(se) else np.nan
    pm[g] = 2 * stats.norm.sf(abs(z)) if np.isfinite(z) else 1.0
pjm = multipletests(pm, method="fdr_bh")[1]
sex_run = pd.DataFrame({"id": mat.index, "log2FoldChange": b1m / np.log(2),
                        "pvalue": pm, "padj": pjm})
sex_run.to_csv("results/deseq2_like_condition_sex_results.csv", index=False)
sex_sig = sex_run[sex_run["padj"] < 0.05]
both = pd.merge(res[["id", "padj"]], sex_run[["id", "padj"]], on="id",
                suffixes=("_cond", "_sex"))
print("\n=== sensitivity (design ~ sex + condition) ===")
print("significant padj<0.05:", len(sex_sig))
print("overlap of padj<0.05 sets:",
      len(set(res.loc[res.padj < 0.05, "id"]) & set(sex_run.loc[sex_run.padj < 0.05, "id"])))
print("corr(log10 padj cond vs sex):",
      round(float(np.corrcoef(np.log10(both.padj_cond + 1e-300),
                              np.log10(both.padj_sex + 1e-300))[0, 1]), 4))

# ------------------------------------------------ 8. GO BP enrichment framework (ORA)
def ora(gene_set, gene2go_bp, universe):
    """One-sided hypergeometric ORA per GO BP term + BH FDR."""
    if not gene2go_bp:
        return pd.DataFrame()
    terms = {}
    for g in universe:
        for t in gene2go_bp.get(g, []):
            terms[t] = terms.get(t, 0) + 1
    M = len(universe); fg = set(gene_set); rows = []
    for t, m in terms.items():
        x = sum(1 for g in fg if t in gene2go_bp.get(g, []))
        if x == 0 or m == 0:
            continue
        p = stats.hypergeom.sf(x - 1, M, m, len(fg))
        rows.append({"GO": t, "term_size": m, "DE_hits": x, "pvalue": p})
    out = pd.DataFrame(rows)
    if out.empty:
        return out
    out["padj"] = multipletests(out["pvalue"].values, method="fdr_bh")[1]
    return out.sort_values("padj")

gene2go_bp = {}   # NO annotated GO source available in this offline capsule -> empty
universe = set(res["id"]) | set(res["symbol"].dropna())
fg = set(sig["id"]) | set(sig["symbol"].dropna())
enr = ora(fg, gene2go_bp, universe)
print("\n=== GO BP enrichment ===")
if enr.empty:
    print("ORA could NOT be computed: no GO-BP gene-set annotation is available in the capsule"
          "(all supplied files and the filesystem were inspected; environment is offline). "
          "Enrichment step blocked at input availability, not at the test.")
else:
    print(enr.head(10).to_string(index=False))

# ------------------------------------------------ 9. summary
sig_up = sig.sort_values("log2FoldChange", ascending=False).head(10)
sig_dn = sig.sort_values("log2FoldChange").head(10)
summary = {
  "samples_used": samples,
  "n_disease": int((cond == "disease").sum()),
  "n_control": int((cond == "control").sum()),
  "genes_raw": int(cnt.shape[0]),
  "genes_collapsed": int(counts.shape[0]),
  "genes_tested": int(res.shape[0]),
  "genes_sig_padj05": int(sig.shape[0]),
  "up_down": [int((sig.log2FoldChange > 0).sum()), int((sig.log2FoldChange < 0).sum())],
  "top_de_up": sig_up[["symbol", "log2FoldChange", "padj"]].to_dict("records"),
  "top_de_down": sig_dn[["symbol", "log2FoldChange", "padj"]].to_dict("records"),
  "sex_sensitivity_sig": int(sex_sig.shape[0]),
  "go_annotation_available": bool(gene2go_bp),
  "go_note": "GO-BP enrichment not computable: no GO annotation source in offline capsule"
}
with open("results/summary.json", "w") as f:
    json.dump(summary, f, indent=2, default=str)
print("\n[done] results written to results/  (summary.json, *_results.csv)")
