"""BixBench bix-51-q1: predicted probability of achieving Efficacy PR with treatment
in patients aged 65 via logistic regression with Age as the only predictor.

Approved plan: unregularized MLE (statsmodels Logit); y = PR vs (SD+PD) since no CR
values exist; Age on original integer scale (unstandardized); all 80 core records
used; 41 trailing all-NaN formatting rows dropped; Groups ignored (perfectly
confounded with outcome) and flagged as a caveat.
"""
import json

import numpy as np
import pandas as pd
import statsmodels.api as sm

try:
    from sklearn.linear_model import LogisticRegression
    _HAS_SKLEARN = True
except ImportError:
    _HAS_SKLEARN = False

DATA_PATH = "data/data.xlsx"
results = {}

# 1. Load and clean: keep only genuine records (Sequence number present)
df = pd.read_excel(DATA_PATH, sheet_name="Sheet1")
results["raw_shape"] = list(df.shape)

core = df[df["Sequence number"].notna()].copy()
results["core_rows"] = int(len(core))
results["dropped_blank_rows"] = int(len(df) - len(core))

# Age on original scale: integer, complete in core records
core["age"] = pd.to_numeric(core["Age"], errors="coerce").astype(float)
assert core["age"].isna().sum() == 0, "Unexpected missing Age in core records"
assert bool((core["age"] == core["age"].astype(int)).all()), "Age not integer-valued"
assert core["age"].min() == 40 and core["age"].max() == 75
assert (core["age"] == 65).sum() >= 1, "No patients at age 65 in the data"

# Outcome: PR=1 vs SD/PD=0
core["y"] = (core["Efficacy"] == "PR").astype(int)
results["outcome_counts"] = core["y"].value_counts().to_dict()
results["efficacy_counts"] = core["Efficacy"].value_counts().to_dict()
assert set(core["Efficacy"].unique()) == {"PR", "SD", "PD"}, "Unexpected efficacy level"

# Groups confounding check
results["groups_x_efficacy_crosstab"] = pd.crosstab(core["Groups"], core["Efficacy"]).astype(int).to_dict()

# 2. Fit unregularized logistic regression (statsmodels Logit)
X = sm.add_constant(core["age"])
logit = sm.Logit(core["y"], X).fit(disp=False, maxiter=200)
results["statsmodels_llf"] = float(logit.llf)
params = logit.params
results["intercept"] = float(params["const"])
results["age_coef"] = float(params["age"])
results["odds_ratio_per_year"] = float(np.exp(params["age"]))
ci = logit.conf_int()
results["n_obs"] = int(logit.nobs)
results["coefficient_table"] = {
    "const": {"coef": float(params["const"]), "se": float(logit.bse["const"]),
              "p": float(logit.pvalues["const"]),
              "ci95": [float(ci.loc["const", 0]), float(ci.loc["const", 1])]},
    "age": {"coef": float(params["age"]), "se": float(logit.bse["age"]),
            "p": float(logit.pvalues["age"]),
            "ci95": [float(ci.loc["age", 0]), float(ci.loc["age", 1])]},
}

# 3. Prediction at age 65
p65_pred = float(logit.predict([1.0, 65.0])[0])
results["predicted_prob_at_65"] = p65_pred
results["predicted_prob_at_65_logit_form"] = float(params["const"] + params["age"] * 65.0)
results["manual_check"] = float(1.0 / (1.0 + np.exp(-(params["const"] + params["age"] * 65.0))))

# 4. sklearn cross-check (unregularized) if available
if _HAS_SKLEARN:
    sk = LogisticRegression(penalty=None, solver="lbfgs", max_iter=2000)
    sk.fit(core[["age"]], core["y"])
    p65_sk = float(sk.predict_proba([[65.0]])[0][1])
    results["sklearn_penalty_none_pred_at_65"] = p65_sk
    results["sklearn_intercept"] = float(sk.intercept_[0])
    results["sklearn_age_coef"] = float(sk.coef_[0][0])
    p65_sk_txt = f"{p65_sk:.6f}"
else:
    p65_sk_txt = "n/a (sklearn unavailable)"

# 5. Summary
summary = [
    f"Core records used: {len(core)} ({int(core['y'].sum())} PR, {int((core['y']==0).sum())} SD/PD); "
    f"dropped {results['dropped_blank_rows']} blank formatting rows.",
    "Outcome encoding: PR=1 vs SD/PD=0 (no CR values exist in the data).",
    f"Age: raw integer scale, range {core['age'].min()}-{core['age'].max()}, mean {core['age'].mean():.3f}, no standardization.",
    f"statsmodels Logit: logit(P) = {params['const']:.6f} + ({params['age']:.6f}) * Age",
    f"  age coef SE={logit.bse['age']:.6f}, p={logit.pvalues['age']:.6f}, OR per year={np.exp(params['age']):.4f}, "
    f"n={int(logit.nobs)}",
    f"Predicted P(PR | Age=65) = {p65_pred:.6f}  (manual: {results['manual_check']:.6f}; "
    f"sklearn penalty=None: {p65_sk_txt})",
    "Caveat: Groups is perfectly confounded with outcome (Group1=41 PR, Group2=39 SD/PD); "
    "it cannot be used as a treatment/control filter and was excluded from the model.",
]
print("\n".join(summary))

with open("results.json", "w") as fh:
    json.dump(results, fh, indent=2, default=str)
print("\nresults.json written.")
