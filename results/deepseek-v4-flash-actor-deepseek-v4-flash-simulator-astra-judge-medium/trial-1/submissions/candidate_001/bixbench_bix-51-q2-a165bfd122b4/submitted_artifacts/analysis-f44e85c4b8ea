"""bixbench:bix-51-q2 — AIC for logistic regression with BMI as sole predictor
of treatment response (efficacy PR).
Complete-case analysis on rows with non-missing Efficacy and BMI.
"""
import numpy as np
import pandas as pd
import statsmodels.api as sm
import statsmodels.formula.api as smf

# ---------- Load data ----------
df = pd.read_excel('data/data.xlsx', sheet_name='Sheet1')
print('Raw data shape:', df.shape)

# ---------- Response coding ----------
# Positive class = efficacy 'PR' (treatment response); negative = PD + SD.
cc = df[df['Efficacy'].notna() & df['BMI'].notna()].copy()
cc['response'] = (cc['Efficacy'] == 'PR').astype(int)
print('Complete-case n used:', len(cc))
print('Response counts (1=PR, 0=PD/SD):')
print(cc['response'].value_counts().to_dict())

# ---------- Fit: response ~ BMI (intercept + BMI slope, k = 2) ----------
X = sm.add_constant(cc['BMI'].values, prepend=True, has_constant='add')
y = cc['response'].values
model = sm.Logit(y, X)
res = model.fit(disp=0)

print('\n=== Model fit (statsmodels Logit) ===')
print('Converged:', res.mle_retvals is not None)
print('Sample size n:', int(res.nobs))
print('Number of parameters k (incl. intercept):', int(res.df_model) + 1)
print('\nCoefficients (b0 = intercept, b1 = BMI):')
print(pd.Series({'intercept': res.params[0], 'BMI': res.params[1]}))
print('\nStandard errors:')
print(pd.Series({'intercept': res.bse[0], 'BMI': res.bse[1]}))
print('z / p-values:')
print(pd.Series({'intercept': res.tvalues[0], 'BMI': res.tvalues[1]}))
print(pd.Series({'intercept': res.pvalues[0], 'BMI': res.pvalues[1]}))

# ---------- Log-likelihood & AIC ----------
llf = res.llf
k = int(res.df_model) + 1
aic_sm = float(res.aic)
aic_manual = -2.0 * llf + 2.0 * k

print('\nLog-likelihood (llf):', repr(llf))
print('df_model (predictor coefficients):', int(res.df_model), '-> k =', k)
print('AIC (statsmodels res.aic):', aic_sm)
print('AIC (manual -2*llf + 2*k):', aic_manual)
print('AIC match (statsmodels == manual):', np.isclose(aic_sm, aic_manual))

# ---------- Formula-based fit for reproducibility cross-check ----------
res_f = smf.logit('response ~ BMI', data=cc).fit(disp=0)
print('\nFormula API cross-check:')
print('  lm_llf =', res_f.llf, '| lm_aic =', res_f.aic, '| params=', res_f.params.values)
print('  AIC identical:', np.isclose(res_f.aic, aic_sm))

# ---------- Diagnostics ----------
print('\n=== Diagnostics ===')
print('Convergence succeeded:', res.mle_retvals.get('converged', None) if res.mle_retvals else 'n/a')
# Separation check: min/max fitted probabilities
phat = res.predict(X)
print('Predicted probabilities: min=%.4f max=%.4f (no perfect separation if strictly inside (0,1))' % (phat.min(), phat.max()))
# Standard errors relative to coefficients (separation/identifiability flag)
print('SE(intercept)=%.4f, SE(BMI)=%.4f' % (res.bse[0], res.bse[1]))
# Confusion / prediction summary
print('\nPredicted class distribution (threshold 0.5):',
      pd.Series((phat > 0.5).astype(int)).value_counts().to_dict())
print('Full-model AIC via formula API (cross-check):', res_f.aic)

# ---------- Save headline numbers ----------
out = pd.DataFrame({
    'metric': ['n', 'k', 'logLik', 'AIC', 'intercept', 'bmi_coef', 'se_intercept', 'se_bmi'],
    'value': [int(res.nobs), k, llf, aic_sm, res.params[0], res.params[1], res.bse[0], res.bse[1]]
})
out.to_csv('aic_result_bix51_q2.csv', index=False)
print('\nSaved aic_result_bix51_q2.csv')
print(out.to_string(index=False))
