#!/usr/bin/env python3
"""Combined logistic regression of treatment response (PR) on BMI + age + gender.

Public task (bixbench:bix-51-q3): In a combined logistic regression model
combining BMI, age, and gender, what is the p-value for age as a predictor of
treatment response (partial response, PR)?

Design decisions (documented):
  * Outcome: PR = 1 if Efficacy == 'PR', else 0 (PD and SD are non-responders).
  * Data: the sheet holds 80 real rows (Sequence 1-80); rows 81-120 are blank
    formatting artifacts (one stray Age=64 on the first blank row) and are dropped.
  * Predictors: BMI (continuous), Age (continuous), Gender (Female reference).
  * Groups is NOT included: it is perfectly confounded with PR (group1=all PR,
    group2=all non-PR), so adjusting for it would produce complete separation.
  * Estimator: statsmodels Logit (MLE, IRLS); Age p-value = two-sided Wald
    z-test p-value for the Age coefficient (same as R glm).
"""
import pandas as pd
import numpy as np
import statsmodels.formula.api as smf

def load_effective():
    df = pd.read_excel("data/data.xlsx", sheet_name="Sheet1")
    # Keep only real records (identified by filled Sequence number)
    d = df[df["Sequence number"].notna()].copy()
    return d

def main():
    d = load_effective()
    print("Effective rows:", len(d))
    print("Efficacy counts:", d["Efficacy"].value_counts().to_dict())

    # Outcome coding: PR = 1, all others = 0
    d["PR"] = (d["Efficacy"] == "PR").astype(int)
    # Age arrives as text in object dtype; convert to numeric (continuous)
    d["Age"] = pd.to_numeric(d["Age"], errors="coerce")

    # Combined logistic regression: PR ~ BMI + Age + Gender
    model = smf.logit("PR ~ BMI + Age + Gender", data=d)
    result = model.fit(disp=False)

    print("\nConverged:", bool(result.mle_retvals.get("converged", True)))
    print("\nSummary:\n", result.summary2().tables[1])
    print("\nAge p-value (Wald z-test):", result.pvalues["Age"])
    print(f"Age coef={result.params['Age']:.4f}  z={result.tvalues['Age']:.3f}  "
          f"p={result.pvalues['Age']:.4g}")
    return result

if __name__ == "__main__":
    main()
