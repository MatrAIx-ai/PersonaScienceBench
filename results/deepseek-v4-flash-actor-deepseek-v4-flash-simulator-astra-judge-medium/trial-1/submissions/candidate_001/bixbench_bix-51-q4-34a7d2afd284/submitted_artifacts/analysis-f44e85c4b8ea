#!/usr/bin/env python3
"""
BixBench bix-51-q4
Question: What is the change in log-odds of remission for each year increase in
patient age, when using a logistic regression model that includes age, BMI, and
gender as predictors?

Specified model (approved plan):
  - Outcome  : remission = 1 if Efficacy == 'PR' else 0  (equivalent to Groups == 1)
  - Predictors: Age (continuous, raw years),
                BMI (continuous, kg/m^2),
                Gender (Male = 1, Female = 0 reference)
  - Procedure: statsmodels Logit, formula  remission ~ Age + BMI + Gender
  - Sample   : complete-case (listwise deletion) on {remission, Age, BMI, Gender} -> n = 80
  - Reported : beta_Age (change in log-odds of remission per 1-year increase in age,
               adjusted for BMI and gender), its SE, 95% CI, p-value, and OR = exp(beta_Age).
"""

import numpy as np
import pandas as pd
import statsmodels.formula.api as smf

# ----------------------------------------------------------------------------
# 1. Load data
# ----------------------------------------------------------------------------
path = "/workspace/data/data.xlsx"
df = pd.read_excel(path, sheet_name="Sheet1")
print("Raw Sheet1 shape (data rows):", df.shape)

# ----------------------------------------------------------------------------
# 2. Build analysis frame
# ----------------------------------------------------------------------------
analysis = pd.DataFrame({
    # remission = 1 if Efficacy == 'PR' else 0 (PD/SD -> 0)
    "remission": (df["Efficacy"] == "PR").astype(int),
    # Age: coerce stray whitespace string (' ' at row 120) to NaN
    "Age": pd.to_numeric(df["Age"], errors="coerce"),
    "BMI": pd.to_numeric(df["BMI"], errors="coerce"),
    # Gender: Male = 1, Female = 0 (reference)
    "Gender_male": (df["Gender"] == "Male").astype(int),
})

print("\nBefore deletion:")
print(analysis.isna().sum().to_string())

anal = analysis.dropna().copy()          # listwise deletion -> complete cases
print("\nComplete-case n =", len(anal))

print("\nOutcome distribution (remission):")
print(anal["remission"].value_counts().sort_index().to_string())
print("Gender distribution (Male=1):")
print(anal["Gender_male"].value_counts().sort_index().to_string())

# ----------------------------------------------------------------------------
# 3. Fit the specified logistic regression
# ----------------------------------------------------------------------------
model = smf.logit("remission ~ Age + BMI + Gender_male", data=anal).fit(
    method="newton", disp=0
)

print("\n" + "=" * 70)
print("FITTED MODEL:  logit(P(remission)) = b0 + b_Age*Age + b_BMI*BMI + b_Male*Gender_male")
print("=" * 70)
print(model.summary().tables[1])

# ----------------------------------------------------------------------------
# 4. Extract the coefficient of interest: beta_Age
# ----------------------------------------------------------------------------
params = model.params
conf = model.conf_int()
pvals = model.pvalues
bse = model.bse

b_age = float(params["Age"])
se_age = float(bse["Age"])
ci_age = (float(conf.loc["Age", 0]), float(conf.loc["Age", 1]))
p_age = float(pvals["Age"])
or_age = float(np.exp(b_age))

print("\n" + "=" * 70)
print("COEFFICIENT OF INTEREST: beta_Age (change in log-odds of remission per 1-year increase in age)")
print("=" * 70)
print(f"  n (observations used)      : {int(model.nobs)}")
print(f"  beta_Age (log-odds / year) : {b_age:.6f}")
print(f"  SE(beta_Age)               : {se_age:.6f}")
print(f"  95% CI                     : [{ci_age[0]:.6f}, {ci_age[1]:.6f}]")
print(f"  p-value                    : {p_age:.6g}")
print(f"  Odds ratio exp(beta_Age)   : {or_age:.6f}")
print(f"  (change in odds per year)  : {or_age*100:.2f}%")

# Also report all coefficients for completeness
print("\nAll coefficients (log-odds scale):")
for name in ["Intercept", "Age", "BMI", "Gender_male"]:
    print(f"  {name:>12s}: {params[name]:+.6f}  (SE {bse[name]:.6f})")

# ----------------------------------------------------------------------------
# 5. Save a JSON summary for the record
# ----------------------------------------------------------------------------
import json
summary = {
    "n": int(model.nobs),
    "outcome": "remission = (Efficacy=='PR')",
    "predictors": ["Age (years)", "BMI (kg/m^2)", "Gender (Male=1, Female=0)"],
    "beta_Age_logodds_per_year": b_age,
    "SE_beta_Age": se_age,
    "CI95_low": ci_age[0],
    "CI95_high": ci_age[1],
    "p_value": p_age,
    "odds_ratio_exp_beta_Age": or_age,
    "all_coefficients": {k: float(v) for k, v in params.items()},
}
with open("/workspace/analysis_results.json", "w") as f:
    json.dump(summary, f, indent=2)
print("\nSaved /workspace/analysis_results.json")
print("DONE")
