"""
BixBench bix-51-q5 — BMI p-value in multivariate logistic regression of treatment response.
Outcome: resp = 1 if Groups==1 (responder, Efficacy=='PR'), else 0 (SD/PD).
Predictors: BMI (continuous) + Age + Family history + ECOG-PS + Child-Pugh +
            Chemotherapy experience + HBV infection + Gender. n=80 (complete case).
Primary report: Wald p for BMI coefficient; LRT p as cross-check; univariate as sensitivity.
"""
import openpyxl
import pandas as pd
import numpy as np
import statsmodels.formula.api as smf
from scipy import stats

# ---- Load data ----
wb = openpyxl.load_workbook("data/data.xlsx", data_only=True)
ws = wb["Sheet1"]
rows = []
for r in range(2, 82):  # rows 2..81 = 80 subjects
    rows.append([ws[f"{c}{r}"].value for c in "ABCDEFGHIJKL"])
df = pd.DataFrame(
    rows,
    columns=["Seq", "Groups", "Efficacy", "Age", "Family_history", "ECOG_PS",
             "Child_Pugh", "Chemo_exp", "HBV", "Gender", "BMI", "Tox"],
)
print("n subjects:", len(df))

# ---- Check no missing in A-K ----
print("Missing in A-K:", df[["Age", "Family_history", "ECOG_PS", "Child_Pugh",
                             "Chemo_exp", "HBV", "Gender", "BMI"]].isna().sum().sum())

# ---- Outcome: responder = Groups==1, verify identical to Efficacy=='PR' ----
df["resp"] = (df.Groups == 1).astype(int)
resp_from_eff = (df.Efficacy == "PR").astype(int)
print("Groups-vs-Efficacy response agreement:", (df["resp"] == resp_from_eff).all(),
      "| responders:", df["resp"].sum(), "| non-responders:", (1 - df["resp"]).sum())

# ---- Recode binary covariates ----
df["fh"] = (df.Family_history == "Yes").astype(int)
df["ecog2"] = (df.ECOG_PS == 2).astype(int)            # 1 = ECOG 2, 0 = '0-1'
df["cp_b"] = (df.Child_Pugh == "B").astype(int)
df["chemo"] = (df.Chemo_exp == "Yes").astype(int)
df["hbv"] = (df.HBV == "Yes").astype(int)
df["male"] = (df.Gender == "Male").astype(int)

# ---- Full multivariate logistic regression ----
formula = "resp ~ BMI + Age + fh + ecog2 + cp_b + chemo + hbv + male"
mfull = smf.logit(formula, data=df).fit(disp=0)
print("\n=== FULL MULTIVARIATE LOGISTIC REGRESSION ===")
print(mfull.summary2().tables[1].round(4))
print("Converged:", mfull.mle_retvals["converged"] if hasattr(mfull, "mle_retvals") else "n/a")
print("nobs used:", int(mfull.nobs))

# ---- Wald p (primary) ----
wald_p = mfull.pvalues["BMI"]
print("\nBMI Wald p-value (PRIMARY):", wald_p, "-> rounded:", round(wald_p, 2))

# ---- Likelihood-ratio p (cross-check) ----
reduced = smf.logit("resp ~ Age + fh + ecog2 + cp_b + chemo + hbv + male", data=df).fit(disp=0)
lr_stat = 2 * (mfull.llf - reduced.llf)
lrt_p = stats.chi2.sf(lr_stat, 1)
print("BMI LRT p-value (cross-check):", lrt_p, "LR stat:", lr_stat)

# ---- Univariate sensitivity ----
m_uni = smf.logit("resp ~ BMI", data=df).fit(disp=0)
print("Univariate BMI Wald p (sensitivity):", m_uni.pvalues["BMI"])

# ---- Separation-check summary ----
print("\nBMI coef:", mfull.params["BMI"], "| OR per unit:", round(np.exp(mfull.params["BMI"]), 4))
print("No separation/convergence warnings (fit completed normally).")
