"""
BixBench bix-51-q8: simple logistic regression of camrelizumab treatment response on age.

Plan (approved): one-predictor model logit(P(response)) = b0 + b_age*Age
  - N = 80 valid patient records (41 blank/junk rows excluded).
  - Response: 1 = PR (Group 1, responders, n=41) ; 0 = SD/PD (Group 2, non-responders, n=39).
  - Age: continuous whole years (per 1-year increment).
  - No covariates (question specifies a simple/single-predictor model).
"""
import numpy as np
import pandas as pd
import statsmodels.api as sm

df = pd.read_excel("data/data.xlsx", sheet_name="Sheet1")

# Keep only records with a valid Groups value (80 patients); drop 41 blank/junk rows
df = df[df["Groups"].notna()].copy()
print("Effective N:", len(df))

# Age -> numeric whole years
df["age"] = pd.to_numeric(df["Age"], errors="coerce")
print("Missing age after coercion:", df["age"].isna().sum())

# Response coding: PR = 1 (response), SD/PD = 0 (non-response)
df["response"] = (df["Efficacy"].str.strip() == "PR").astype(int)
print("Response counts:", df["response"].value_counts().to_dict())
print("Groups counts:", df["Groups"].astype(int).value_counts().to_dict())

# Means by response group
print("\nMean age by response:")
print(df.groupby("response")["age"].agg(["mean", "std", "count"]))

# Fit simple logistic regression: response ~ 1 + age
X = sm.add_constant(df["age"])
model = sm.Logit(df["response"], X).fit(disp=0)
print("\n=== Simple logistic regression: logit(P(PR)) = b0 + b_age*Age ===")
print(model.summary())

b_age = model.params["age"]
se_age = model.bse["age"]
p_age = model.pvalues["age"]
ci_age = model.conf_int().loc["age"]
print("\nAge coefficient (change in log-odds per 1-year, response=PR):")
print(f"  b_age = {b_age:.6f}")
print(f"  SE    = {se_age:.6f}")
print(f"  z     = {model.tvalues['age']:.4f}")
print(f"  p     = {p_age:.4e}")
print(f"  95% CI= ({ci_age[0]:.6f}, {ci_age[1]:.6f})")
print(f"  OR    = exp(b_age) = {np.exp(b_age):.6f}")
print(f"  OR 95% CI = ({np.exp(ci_age[0]):.6f}, {np.exp(ci_age[1]):.6f})")

# Rounded for reporting
print("\nRounded b_age (4 dp):", round(b_age, 4))
print("Rounded b_age (3 dp):", round(b_age, 3))
