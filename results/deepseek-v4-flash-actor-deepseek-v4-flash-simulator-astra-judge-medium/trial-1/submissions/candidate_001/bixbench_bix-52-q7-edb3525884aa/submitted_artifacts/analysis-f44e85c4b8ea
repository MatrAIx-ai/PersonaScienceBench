#!/usr/bin/env python3
"""
BixBench bix-52-q7 — Zebra Finch (ZF) methylation site filtering.

Question: How many sites are removed when filtering sites that do not show
>90% or <10% methylation in Zebra Finch?

Interpretation (approved): a "site" = unique Pos (CpG locus). A site "shows
>90% or <10% methylation" if ANY of its Sample rows has MethylationPercentage
> 90 or < 10 (strict inequality; exact 90/10 count as intermediate).
Removed = sites whose rows are ALL within [10, 90].
"""
import pandas as pd

INPUT = "data/ZF_AgeRelated_CpG_noMT_Final.csv"
df = pd.read_csv(INPUT)

print("== Input schema ==")
print("shape:", df.shape)
print("columns:", list(df.columns))
print("missing values:", int(df.isna().sum().sum()))
print("MethylationPercentage range: %.3f - %.3f" % (df["MethylationPercentage"].min(), df["MethylationPercentage"].max()))

# ---- per-site aggregation ----
g = df.groupby("Pos")["MethylationPercentage"]
site = pd.DataFrame({
    "min": g.min(),
    "max": g.max(),
    "n_rows": g.size(),
})
print("\n== Site-level (unique Pos) ==")
print("total unique sites:", len(site))

# Interpretation A: site 'shows' extreme if any sample >90 or any sample <10 (strict)
site["shows_extreme"] = (site["max"] > 90) | (site["min"] < 10)
kept = int(site["shows_extreme"].sum())
removed = int((~site["shows_extreme"]).sum())
total = len(site)

print("\n== Filter result (Interpretation A) ==")
print("sites showing >90% or <10% methylation (KEPT):", kept)
print("sites NOT showing >90% or <10% methylation (REMOVED):", removed)
print("total sites:", total)
assert kept + removed == total, "kept + removed must equal total"
assert removed == 849 and kept == 291, "unexpected counts for interpretation A"

# sanity cross-check
print("\n== Cross-checks ==")
print("sites with any sample >90:", int((site["max"] > 90).sum()))
print("sites with any sample <10:", int((site["min"] < 10).sum()))
print("rows with MethylationPercentage > 90:", int((df["MethylationPercentage"] > 90).sum()))
print("rows with MethylationPercentage < 10:", int((df["MethylationPercentage"] < 10).sum()))
print("rows with exact 10 or 90 (intermediate under strict rules):",
      int(((df["MethylationPercentage"] == 10) | (df["MethylationPercentage"] == 90)).sum()))

# save per-site classification as a small table
out = site.reset_index().rename(columns={"index": "Pos"})
out.to_csv("zf_site_classification.csv", index=False)
print("\nWrote zf_site_classification.csv with", len(out), "rows")

# Final answer string
print("\nANSWER: %d sites removed (kept %d, total %d)" % (removed, kept, total))
