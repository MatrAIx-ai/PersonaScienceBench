#!/usr/bin/env python3
"""BixBench bix-53-q3 pipeline (see end-of-file docstring)."""
import numpy as np, pandas as pd, json
from scipy import special, stats
import statsmodels.api as sm
import patsy
from statsmodels.stats.multitest import multipletests
OUT = {}

df = pd.read_csv('data/count.csv')
counts = df.drop(columns='geneID').astype(float).values
geneID = df['geneID'].values
cond = np.array([1,1,1,0,0,0], dtype=float)      # KL=1 (KD), WL=0 (reference)
X = np.column_stack([np.ones(6), cond])
G, n = counts.shape
OUT['n_genes_input'] = int(G)

# size factors (median-of-ratios, genes with all-positive counts)
logc = np.log(np.where(counts>0, counts, np.nan))
lgg = np.nanmean(logc, axis=1)
finite = np.isfinite(lgg)
diff = logc[finite,:] - lgg[finite,None]
sf = np.exp(np.nanmedian(diff, axis=0)); sf = sf/np.exp(np.mean(np.log(sf)))
norm = counts/sf
baseMean = norm.mean(axis=1)
OUT['size_factors'] = np.round(sf,4).tolist()

testable = counts.sum(axis=1) > 0
idx = np.where(testable)[0]; Gt = len(idx)
kb = counts[idx,:]
print('tested genes:', Gt)

def irls_fit(a, max_iter=15, tol=1e-8):
    a = np.clip(a, 1e-8, 1e3)
    mu0 = np.maximum(baseMean[idx,None], 0.5)*sf[None,:]
    eta = np.log(mu0); beta = np.zeros((Gt,2))
    for _ in range(max_iter):
        mu = np.exp(eta)
        v = mu + a[:,None]*mu**2
        w = mu**2/np.maximum(v,1e-12)
        z = eta + (kb-mu)/np.maximum(mu,1e-12)
        Xw = X*w[:,:,None]; XwX = np.einsum('gij,ik->gjk', Xw, X)
        Xwz = np.einsum('gij,gi->gj', Xw, z)
        bn = np.linalg.solve(XwX, Xwz[...,None])[...,0]
        if np.max(np.abs(bn-beta)) < tol: beta = bn; break
        beta = bn; eta = (X@bn.T).T
    mu = np.exp(eta); v = mu + a[:,None]*mu**2
    return beta, mu, (mu**2)/np.maximum(v,1e-12)

def xwx(w):
    Xw = X*w[:,:,None]
    return np.einsum('gij,ik->gjk', Xw, X)

mean_n = norm[idx,:].mean(axis=1)
var_n = counts[idx,:].var(axis=1, ddof=1)
a0 = np.clip((var_n-mean_n)/np.maximum(mean_n**2,1), 1e-3, 10)
a0 = np.nan_to_num(a0, nan=0.1); a0 = np.where(a0<=0, 0.1, a0)
beta0, mu0, w0 = irls_fit(a0)

def cr_apl(alpha):
    alpha = np.clip(alpha, 1e-6, 50.0)
    inva = 1.0/alpha
    mu = np.maximum(mu0, 1e-9); amu = alpha[:,None]*mu
    ll = (special.gammaln(kb+inva[:,None]) - special.gammaln(inva[:,None])
          - special.gammaln(kb+1) + kb*np.log(amu)
          - (kb+inva[:,None])*np.log1p(amu)).sum(axis=1)
    w = mu/(1.0+amu)
    _, ld = np.linalg.slogdet(xwx(w))
    return ll - 0.5*ld

grid = np.logspace(-5, 1.7, 90)
apl = np.stack([cr_apl(np.full(Gt,g)) for g in grid], axis=1)
disp_mle = grid[np.argmax(apl,axis=1)]

def refine(disp):
    lo = np.maximum(disp*0.55,1e-6); hi = disp*1.8
    x1,x2,x3 = lo,disp,hi
    y1,y2,y3 = cr_apl(lo),cr_apl(disp),cr_apl(hi)
    den=(x1-x2)*(x1-x3)*(x2-x3); num=(x1*(y2-y3)+x2*(y3-y1)+x3*(y1-y2))
    off=0.5*num/np.where(np.abs(den)<1e-12,1e-12,den)
    r=np.clip(x2+off,np.maximum(x1,1e-7),x3)
    return np.where(cr_apl(r)>cr_apl(disp), r, disp)

disp_mle = refine(disp_mle)
OUT['disp_mle_sample'] = np.round(disp_mle[:8],5).tolist()

# trend fit (gamma GLM, log link, spline on log10 mean)
logmean = np.log10(baseMean[idx])
use = np.isfinite(disp_mle) & (disp_mle>1e-6)
Dm_full = patsy.dmatrix('bs(logmean, df=5, degree=3)', {'logmean': logmean})
Dm_use = patsy.dmatrix('bs(logmean, df=5, degree=3)', {'logmean': logmean[use]})
tg = sm.GLM(disp_mle[use], Dm_use, family=sm.families.Gamma(link=sm.families.links.Log())).fit()
trend_alpha = np.exp(np.asarray(Dm_full) @ tg.params)
OUT['trend_alpha_sample'] = np.round(trend_alpha[:8],5).tolist()

# MAP dispersion shrinkage (log-normal prior, sd=1)
def cr_apl_map(alpha, trend):
    alpha = np.clip(alpha, 1e-6, 50.0); inva = 1.0/alpha
    mu = np.maximum(mu0,1e-9); amu = alpha[:,None]*mu
    ll = (special.gammaln(kb+inva[:,None]) - special.gammaln(inva[:,None])
          - special.gammaln(kb+1) + kb*np.log(amu)
          - (kb+inva[:,None])*np.log1p(amu)).sum(axis=1)
    w = mu/(1.0+amu); _, ld = np.linalg.slogdet(xwx(w))
    cr = ll - 0.5*ld
    prior = -0.5*(np.log(np.maximum(alpha,1e-9))-np.log(np.maximum(trend,1e-9)))**2
    return cr + prior

def map_refine(disp, trend):
    lo = np.maximum(disp*0.55,1e-6); hi = disp*1.8
    x1,x2,x3 = lo,disp,hi
    y1,y2,y3 = cr_apl_map(lo,trend),cr_apl_map(disp,trend),cr_apl_map(hi,trend)
    den=(x1-x2)*(x1-x3)*(x2-x3); num=(x1*(y2-y3)+x2*(y3-y1)+x3*(y1-y2))
    off=0.5*num/np.where(np.abs(den)<1e-12,1e-12,den)
    r=np.clip(x2+off,np.maximum(x1,1e-7),x3)
    return np.where(cr_apl_map(r,trend)>cr_apl_map(disp,trend), r, disp)

blend = 0.3*trend_alpha + 0.7*disp_mle
disp_map = map_refine(blend, trend_alpha)
OUT['disp_final_sample'] = np.round(disp_map[:8],5).tolist()

# final GLM fit with shrunken dispersion
beta, mu, w = irls_fit(disp_map)
lfc_mle = beta[:,1]/np.log(2)
cov = np.linalg.inv(xwx(w))
se_lfc = np.sqrt(cov[:,1,1])/np.log(2)
pvalue = 2*(1-stats.norm.cdf(np.abs(beta[:,1]/np.sqrt(cov[:,1,1]))))
_, padj, _, _ = multipletests(pvalue, method='fdr_bh')

# lfcShrink (normal prior)
mad = np.nanmedian(np.abs(lfc_mle-np.nanmedian(lfc_mle)))
priorVar = (mad/0.6745)**2
post_lfc = lfc_mle*priorVar/(se_lfc**2+priorVar)
post_sd = np.sqrt(1.0/(1.0/se_lfc**2+1.0/priorVar))
p_post = 2*(1-stats.norm.cdf(np.abs(post_lfc)/post_sd))

res = pd.DataFrame({'geneID':geneID[idx],'baseMean':baseMean[idx],
    'lfc_mle':lfc_mle,'lfcSE':se_lfc,'shrunken_lfc':post_lfc,
    'pvalue':pvalue,'padj':padj}).set_index('geneID')
OUT['priorVar'] = float(priorVar); OUT['n_tested'] = int(Gt)

primary = res[(res.padj<0.05)&(res.shrunken_lfc.abs()>1)&(res.baseMean>10)]
sens_raw = res[(res.pvalue<0.05)&(res.shrunken_lfc.abs()>1)&(res.baseMean>10)]
OUT['n_DGE_primary_padj'] = int(len(primary))
OUT['n_DGE_sensitivity_rawp'] = int(len(sens_raw))
OUT['n_up'] = int((primary.shrunken_lfc>0).sum()); OUT['n_down'] = int((primary.shrunken_lfc<0).sum())
print('primary DGEs (padj):', len(primary), 'up', OUT['n_up'], 'down', OUT['n_down'])
print('sensitivity DGEs (raw p):', len(sens_raw))
res['disp_mle']=disp_mle; res['disp_trend']=trend_alpha; res['disp_final']=disp_map
res.to_csv('/workspace/deseq2_results.csv')

# ---- KEGG_2019_Mouse glutathione metabolism, offline reconstruction ----
gpx = {
 'Gclc':'ENSMUSG00000032370','Gss':'ENSMUSG00000022110','G6pdx':'ENSMUSG00000031400',
 'Gpx1':'ENSMUSG00000063856','Gpx3':'ENSMUSG00000018339','Gpx4':'ENSMUSG00000075706',
 'Gpx5':'ENSMUSG00000041378','Gpx7':'ENSMUSG00000028664','Gpx8':'ENSMUSG00000021608',
 'Gstp1':'ENSMUSG00000060803','Gstm3':'ENSMUSG00000037145','Gstm4':'ENSMUSG00000027890',
 'Gstm6':'ENSMUSG00000040296','Gstt1':'ENSMUSG00000020649','Gstt2':'ENSMUSG00000028680',
 'Gstt3':'ENSMUSG00000029191','Gsta3':'ENSMUSG00000032394','Gsto1':'ENSMUSG00000025068',
 'Gsto2':'ENSMUSG00000027940','Gstz1':'ENSMUSG00000021024','Mgst1':'ENSMUSG00000028640',
 'Ggt6':'ENSMUSG00000021999','Chac1':'ENSMUSG00000028128','Chac2':'ENSMUSG00000039623',
 'Oplah':'ENSMUSG00000027923','Dpep1':'ENSMUSG00000022472','Cndp2':'ENSMUSG00000022529',
 'Glo1':'ENSMUSG00000024026','Hagh':'ENSMUSG00000026821'}
ambig_sym = ['Gclm','Gsr','Pgd','Idh1','Gpx2','Gpx6','Gsta1','Gsta2','Gsta4','Gstm1',
             'Gstm2','Gstm5','Gstm7','Gstk1','Gstcd','Mgst2','Mgst3','Ggt1','Ggt5','Ggt7','Ggct']
present_ids = set(df['geneID'])
assert all(v in present_ids for v in gpx.values()), 'unverified member'

dge_ids = set(primary.index)
ov = {s: (i in dge_ids) for s,i in gpx.items()}
k = sum(ov.values())
Nbg, M, nq = Gt, len(gpx), len(dge_ids)
p_hyper = stats.hypergeom.sf(k-1, Nbg, M, nq)
OUT['contributing'] = [{'symbol':s,'ensmusg':i,'lfc':float(res.loc[i,'shrunken_lfc']),
                        'padj':float(res.loc[i,'padj'])} for s,i in gpx.items() if i in dge_ids]
OUT['overlap_k'] = int(k); OUT['hypergeom_p'] = float(p_hyper)
OUT['query_size'] = int(nq); OUT['gene_set_size'] = int(M); OUT['gene_set_background'] = int(Nbg)
OUT['members_verified'] = sorted(gpx.keys()); OUT['members_unresolved'] = ambig_sym
print('ORA: query', nq, 'members', M, 'overlap k =', k, 'hypergeom p = %.3g' % p_hyper)
print('contributing:', [(c['symbol'], round(c['lfc'],2), round(c['padj'],4)) for c in OUT['contributing']])

# sensitivity: unresolved genes whose best-known ID appears as a DGE
ambig_cand = {'Gclm':'ENSMUSG00000028824','Gsr':'ENSMUSG00000021875','Gstm1':'ENSMUSG00000004062',
              'Gstm2':'ENSMUSG00000004063','Gstk1':'ENSMUSG00000029990','Ggct':'ENSMUSG00000032049',
              'Gpx2':'ENSMUSG00000018517','Idh1':'ENSMUSG00000025990','Pgd':'ENSMUSG00000025655'}
OUT['ambig_unverified_hits'] = {s:(i in dge_ids and i in present_ids) for s,i in ambig_cand.items()}
print('ambiguous best-guess IDs present as DGEs:', {s:o for s,o in OUT['ambig_unverified_hits'].items() if o})
json.dump(OUT, open('/workspace/results_summary.json','w'), indent=2)
print('=== SUMMARY ===')
print(json.dumps(OUT, indent=2, default=str))
print('DONE')
