#!/usr/bin/env python3
"""
BixBench bix-53-q6: UBE2M knockdown (KD) KEGG pathway enrichment
================================================================
Question: Using GSEApy with the KEGG_2019_Mouse gene set library, identify the most
significantly enriched pathway in the UBE2M knockdown model. DEGs: raw p < 0.05,
|log2FC| > 1, baseMean > 10. Apply log2 fold change shrinkage.

ENVIRONMENT FACTS (verified): NO network, no R/DESeq2/apeglm, no gseapy, no
KEGG_2019_Mouse gmt, no Ensembl<->symbol annotation anywhere on disk.
=> Everything is implemented from scratch in pure Python (numpy/scipy/statsmodels),
   with every approximation explicitly documented. The GSEA step is run against a
   clearly-labelled STAND-IN KEGG_2019_Mouse-style library (see Part 6/7).
"""
import os, re, json, warnings, time
import numpy as np
import pandas as pd
import scipy.special as ssp
import scipy.stats as st
import scipy.optimize as opt
import statsmodels.nonparametric.smoothers_lowess as lowess_mod

warnings.filterwarnings("ignore")
np.random.seed(12345)
OUT = "/workspace/outputs"
os.makedirs(OUT, exist_ok=True)

# ---------------------------------------------------------------- Part 0: data
counts = pd.read_csv("data/count.csv")
counts = counts.drop_duplicates(subset="geneID")
counts = counts.set_index("geneID")
assert all(re.match(r"^ENSMUSG\d{11}$", g) for g in counts.index)
print(f"[0] counts shape={counts.shape}  genes={counts.shape[0]}  samples={counts.shape[1]}")
print(f"[0] any NaN: {counts.isna().any().any()}   all-zero genes: {(counts.sum(axis=1)==0).sum()}")

kl = ["KL1","KL2","KL3"]; wl = ["WL1","WL2","WL3"]
C = counts.values.astype(float)
nG = C.shape[0]

# 1a median-of-ratios size factors (DESeq2)
gm = np.exp(np.mean(np.log(C), axis=1))
ratios = C[gm > 0] / gm[gm > 0, None]
sf = np.median(ratios, axis=0)
sf /= np.exp(np.mean(np.log(sf)))
print(f"[1a] size factors: {dict(zip(counts.columns, np.round(sf,4)))}")
norm = C / sf[None, :]
baseMean = norm.mean(axis=1)

mu_kl = norm[:, :3].mean(axis=1)
mu_wl = norm[:, 3:].mean(axis=1)
mu_pool = np.concatenate([np.repeat(mu_kl[:,None],3,axis=1),
                          np.repeat(mu_wl[:,None],3,axis=1)], axis=1)

# 1b Cox-Reid adjusted profile likelihood dispersion MLE (per gene)
def cr_negll(d, y, mu):
    d = np.clip(d, 1e-8, 10.0)
    ll = np.sum(ssp.gammaln(y + 1.0/d) - ssp.gammaln(1.0/d) - ssp.gammaln(y + 1.0)
                + y*np.log(d*mu) - (y + 1.0/d)*np.log1p(d*mu))
    W = mu/(1.0 + d*mu)                       # precision weights
    Wkl = W[:3].sum(); Wwl = W[3:].sum()      # det(X'WX) = Wkl*Wwl for 2-grp design
    return -(ll - 0.5*np.log(max(Wkl*Wwl, 1e-12)))

var_grp = np.concatenate([np.repeat(norm[:, :3].var(axis=1, ddof=1)[:,None],3,axis=1),
                          np.repeat(norm[:, 3:].var(axis=1, ddof=1)[:,None],3,axis=1)], axis=1)
alpha0 = np.clip(((var_grp - mu_pool) / mu_pool**2).mean(axis=1), 1e-4, 10.0)
usable = (mu_pool > 0).all(axis=1)
disp = np.full(nG, np.nan)
t0=time.time()
for i in np.where(usable)[0]:
    try:
        res = opt.minimize_scalar(lambda d: cr_negll(d, C[i], mu_pool[i]),
                                  bounds=(1e-4, 10.0), method="bounded",
                                  options={"xatol": 1e-4})
        disp[i] = res.x
    except Exception:
        disp[i] = min(max(alpha0[i], 1e-4), 10.0)
print(f"[1b] CR dispersion MLE on {np.sum(~np.isnan(disp))} genes, median={np.nanmedian(disp):.4f} "
      f"({time.time()-t0:.1f}s)")

# 1c dispersion trend (lowess) + shrinkage
ok = ~np.isnan(disp) & (baseMean > 1)
lm_ = np.log(np.clip(baseMean[ok], 1e-6, None)); ld_ = np.log(np.clip(disp[ok], 1e-6, None))
order = np.argsort(lm_)
fit_ = lowess_mod.lowess(ld_[order], lm_[order], frac=0.4, it=3, return_sorted=False)
trend_logd = np.interp(lm_, lm_[order], fit_)
sigma2_res = np.var(ld_ - trend_logd)
prior_w = 1.0/max(sigma2_res, 1e-3)
logd_shr = np.full(nG, np.nan)
logd_shr[ok] = (1.0*ld_ + prior_w*trend_logd)/(1.0 + prior_w)
lmean_all = np.log(np.clip(baseMean, 1e-6, None))
logd_shr[~ok] = np.interp(lmean_all[~ok], lm_[order], fit_)
logd_shr[np.isnan(logd_shr)] = np.log(0.1)
disp_final = np.exp(logd_shr)
print(f"[1c] shrunk dispersion median={np.median(disp_final):.4f}  prior_w={prior_w:.3f}")

# 1d Wald test: log2FC = log2(muKL/muWL), NB variance, raw p + BH padj
small = 0.5
lfc_mle = np.log2((mu_kl + small)/(mu_wl + small))
with np.errstate(divide="ignore", invalid="ignore"):
    term_kl = np.where(mu_kl > 0, (1.0 + disp_final*mu_kl)/(3.0*mu_kl), 0.0)
    term_wl = np.where(mu_wl > 0, (1.0 + disp_final*mu_wl)/(3.0*mu_wl), 0.0)
    se2 = (1.0/np.log(2)**2) * (term_kl + term_wl)
se = np.sqrt(se2)
z = np.where((se > 0) & np.isfinite(se), lfc_mle/se, np.nan)
p_val = 2.0*(1.0 - st.norm.cdf(np.abs(z)))
p_val[np.isnan(p_val)] = 1.0
# BH
n = len(p_val); order = np.argsort(p_val)
qs = np.minimum.accumulate((n/np.arange(n,0,-1))*(p_val[order][::-1]))[::-1]
padj = np.empty(n); padj[order] = np.minimum(qs, 1.0)

# --------------------------------------------------- Part 2: LFC shrinkage
# Primary: apeglm-like posterior mode under Cauchy(0,s) prior on log2 scale
fin = np.isfinite(se) & (se > 0)
med = np.nanmedian(np.abs(lfc_mle[fin & (lfc_mle != 0)]))
s_scale = max(1.5*med, 0.05)
print(f"[2] apeglm-like Cauchy prior scale s={s_scale:.4f} (1.5*median|raw LFC|)")
def cauchy_negpost(b, bhat, se_, s):
    return (b - bhat)**2/(2*se_**2) + np.log(s**2 + b**2)
lfc_shr_ape = np.zeros(nG)
t0=time.time()
for i in range(nG):
    if not fin[i]:
        continue
    b0 = float(np.clip(lfc_mle[i], -29.9, 29.9))
    res = opt.minimize_scalar(lambda b: cauchy_negpost(b, lfc_mle[i], se[i], s_scale),
                              bounds=(-30.0, 30.0), method="bounded",
                              options={"xatol": 1e-5})
    lfc_shr_ape[i] = res.x
print(f"[2] apeglm-like shrinkage done ({time.time()-t0:.1f}s), "
      f"mean|raw|={np.mean(np.abs(lfc_mle)):.3f} -> mean|shrunk|={np.mean(np.abs(lfc_shr_ape)):.3f}")
# Sensitivity: 'normal' empirical-Bayes shrinkage
tau2 = np.var(lfc_mle[fin], ddof=1); prec0 = 1.0/max(tau2, 1e-6)
lfc_shr_norm = np.where(fin, (lfc_mle/(se**2))/(1.0/(se**2) + prec0), 0.0)
print(f"[2] 'normal' EB shrinkage: mean|shrunk|={np.mean(np.abs(lfc_shr_norm)):.3f}")

res_df = pd.DataFrame({
    "geneID": counts.index, "baseMean": baseMean,
    "log2FoldChange_raw": lfc_mle, "dispersion": disp_final,
    "se": se, "pvalue_wald": p_val, "padj": padj,
    "lfcShrink_apeglm_like": lfc_shr_ape, "lfcShrink_normal_like": lfc_shr_norm,
})
res_df.to_csv(f"{OUT}/DESeq2_analog_results.csv", index=False)
print(f"[2] results saved {res_df.shape}")

# ----------------------------------------------------------- Part 3: DEG filter
# LOCKED: raw p<0.05 AND baseMean>10 AND |SHRUNKEN lfc|>1 (filter on shrunken lfc)
deg = res_df[(res_df.pvalue_wald < 0.05) & (res_df.baseMean > 10) &
             (res_df.lfcShrink_apeglm_like.abs() > 1)].copy()
deg = deg.sort_values("lfcShrink_apeglm_like", ascending=False)
print(f"[3] DEG count: {len(deg)}  (up-in-KL {int((deg.lfcShrink_apeglm_like>0).sum())}, "
      f"down {int((deg.lfcShrink_apeglm_like<0).sum())})")
deg.to_csv(f"{OUT}/DEG_list.csv", index=False)
print(deg[["geneID","baseMean","log2FoldChange_raw","pvalue_wald","padj",
           "lfcShrink_apeglm_like"]].head(8).to_string())

# --------------------------------------------------- Part 4: ranked list for GSEA
rank = deg.set_index("geneID")["lfcShrink_apeglm_like"].sort_values(ascending=False)
rank.to_csv(f"{OUT}/ranked_gene_list.txt", header=False)
print(f"[4] ranked list size={len(rank)} (top-5: {list(rank.index[:5])})")

# ============ Part 5: preranked GSEA engine (from scratch)
def gsea_es(stats, member_idx, p=1.0):
    """Weighted running-sum enrichment score (index 0 = highest rank)."""
    N = len(stats)
    if len(member_idx) == 0 or N == 0:
        return 0.0
    memb = np.zeros(N, bool); memb[list(member_idx)] = True
    nS = int(memb.sum())
    if nS == N or nS == 0:
        return 0.0
    absp = np.abs(stats) ** p
    phit = np.cumsum(absp * memb) / absp[memb].sum()
    pmiss = np.cumsum(~memb) / (N - nS)
    diff = phit - pmiss
    es_pos = diff.max(); es_neg = diff.min()
    return es_pos if es_pos >= -es_neg else es_neg

def gsea_prerank(rank_series, gmt, p=1.0, nperm=1000, seed=12345):
    """rank_series: geneID->stat DESCENDING. gmt: {name: set}. Returns df."""
    genes = np.array(rank_series.index); stats = rank_series.values.astype(float)
    N = len(genes); rng = np.random.default_rng(seed); rows = []
    for name, members in gmt.items():
        idx = np.where(np.isin(genes, list(members)))[0]
        ns = len(idx)
        obs = gsea_es(stats, idx, p)
        nulls = np.empty(nperm)
        for k in range(nperm):
            # pre-ranked GSEA null: keep the SORTED ranked vector fixed, permute only
            # which genes belong to the set (random set of the same size from R).
            ridx = rng.choice(N, size=ns, replace=False) if ns < N else np.arange(N)
            nulls[k] = gsea_es(stats, ridx, p)
        ssig = nulls[np.sign(nulls) == np.sign(obs)] if obs != 0 else nulls
        esn = np.mean(np.abs(ssig)) if len(ssig) else np.nan
        nes = obs/esn if (esn and np.isfinite(esn)) else 0.0
        pv = (np.sum(np.abs(nulls) >= abs(obs)) + 1) / (nperm + 1)
        rows.append({"pathway": name, "size": ns, "ES": obs, "NES": nes, "pval": pv})
    gdf = pd.DataFrame(rows)
    if len(gdf):
        gdf = gdf.sort_values("pval")
        n_ = len(gdf); pvs = gdf["pval"].values; o = np.argsort(pvs)
        qs = np.minimum.accumulate((n_/np.arange(n_,0,-1))*(pvs[o][::-1]))[::-1]
        q = np.empty(n_); q[o] = np.minimum(qs, 1.0); gdf["qval"] = q
    return gdf

# --- validate engine on synthetic example with known truth ---
rng_v = np.random.default_rng(7)
n_syn = 10000
syn_stats = pd.Series(rng_v.normal(0, 1, n_syn), index=[f"g{i}" for i in range(n_syn)])
syn_stats = syn_stats.sort_values(ascending=False)
planted = set(syn_stats.index[:120])
# calibration: many random 'null' sets of the same size; p-values should be ~U(0,1)
n_ctrl = 30
ctrl_pvals = []
for c in range(n_ctrl):
    ctrl = set(syn_stats.index[rng_v.choice(n_syn, 120, replace=False)])
    sg = {"CONTROL_%02d" % c: ctrl}
    r = gsea_prerank(syn_stats, sg, nperm=600, seed=100 + c)
    ctrl_pvals.append(r["pval"].iloc[0])
ctrl_pvals = np.array(ctrl_pvals)
syn_gmt = {"PLANTED_POSITIVE_SET": planted,
           "PLANTED_DOWN_SET": set(syn_stats.index[-120:])}
syn_res = gsea_prerank(syn_stats, syn_gmt, nperm=600, seed=7)
print("[5] GSEA engine validation (synthetic):")
print(syn_res.to_string(index=False))
print(f"[5] calibration: mean p of {n_ctrl} random null sets = {ctrl_pvals.mean():.3f}, "
      f"median = {np.median(ctrl_pvals):.3f}, prop<0.05 = {(ctrl_pvals<0.05).mean():.3f} "
      f"(expect ~0.05, mean ~0.5)")
assert syn_res.loc[syn_res.pathway=="PLANTED_POSITIVE_SET","pval"].iloc[0] < 0.01
assert syn_res.loc[syn_res.pathway=="PLANTED_DOWN_SET","pval"].iloc[0] < 0.01
assert abs(ctrl_pvals.mean() - 0.5) < 0.2
print("[5] engine validation PASSED (planted up/down sets recovered; null p-values calibrated)")

