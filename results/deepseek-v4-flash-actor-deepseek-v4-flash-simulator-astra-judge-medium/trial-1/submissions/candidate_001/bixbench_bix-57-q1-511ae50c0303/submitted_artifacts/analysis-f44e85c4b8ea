#!/usr/bin/env python3
"""Gap-percentage analysis for BixBench bix-57-q1.

Question: percentage of gap characters relative to total alignment positions
across all alignments after aligning with MAFFT with the 'auto' parameter.

IMPORTANT DEVIATION NOTE (transparency): MAFFT is NOT available in this
sandbox (not on PATH/filesystem; cannot be installed: no network [DNS fails],
no root/sudo, no /etc/apt sources, no Biopython/skbio, no other aligners).
The required "MAFFT --auto" alignments therefore cannot be reproduced exactly.
As explicitly approved, this uses a PURE-PYTHON FALLBACK progressive MSA
(Needleman-Wunsch global pairwise + UPGMA guide tree + profile merging),
an approximation of MAFFT --auto output.

Agreed definitions:
  - each FASTA file aligned SEPARATELY -> 10 independent alignments
  - gap character = ONLY '-'
  - total positions = sum_over_alignments(len_alignment * n_seqs)
  - gap % = (total '-') / (total positions) * 100
"""
import os, glob, shutil, subprocess, sys
AA = set("ACDEFGHIKLMNPQRSTVWY")
DATA_DIR = os.path.normpath(os.path.join(os.path.dirname(os.path.abspath(__file__)), "..", "data"))
MATCH, MISMATCH, GAP = 5.0, -4.0, -8.0

def check_mafft():
    info = {"on_path": shutil.which("mafft") is not None, "version": None}
    if info["on_path"]:
        try:
            info["version"] = subprocess.run(["mafft", "--version"],
                                             capture_output=True, text=True,
                                             timeout=30).stdout.strip()
        except Exception as e:
            info["version"] = "version unavailable: %s" % e
    return info
MAFFT = check_mafft()

def parse_fasta(path):
    seqs, header, cur = [], None, []
    for raw in open(path):
        line = raw.rstrip("\n")
        if not line.strip():
            continue
        if line.startswith(">"):
            if header is not None:
                seqs.append((header, "".join(cur)))
            header, cur = line[1:].strip(), []
        else:
            cur.append(line.strip())
    if header is not None:
        seqs.append((header, "".join(cur)))
    for _, s in seqs:
        bad = set(s.upper()) - AA
        if bad:
            sys.exit("ERROR %s: unexpected chars %s" % (path, sorted(bad)))
    return seqs

def _key(a, b):
    if a == b and a != "-":
        return MATCH
    if a == "-" or b == "-":
        return GAP
    return MISMATCH

def nw_identity(s1, s2):
    """NW global alignment -> fraction of matching columns."""
    n, m = len(s1), len(s2)
    dp = [[0.0] * (m + 1) for _ in range(n + 1)]
    tb = [[0] * (m + 1) for _ in range(n + 1)]
    for i in range(1, n + 1):
        dp[i][0], tb[i][0] = GAP * i, 2
    for j in range(1, m + 1):
        dp[0][j], tb[0][j] = GAP * j, 1
    for i in range(1, n + 1):
        a = s1[i - 1]
        for j in range(1, m + 1):
            diag = dp[i-1][j-1] + _key(a, s2[j-1])
            up   = dp[i-1][j] + GAP
            left = dp[i][j-1] + GAP
            best = max(diag, up, left)
            dp[i][j] = best
            tb[i][j] = 0 if best == diag else (2 if best == up else 1)
    i, j, matches, cols = n, m, 0, 0
    while i > 0 or j > 0:
        d = tb[i][j]
        cols += 1
        if d == 0:
            if s1[i-1] == s2[j-1]:
                matches += 1
            i -= 1; j -= 1
        elif d == 2:
            i -= 1
        else:
            j -= 1
    return matches / cols if cols else 1.0

def col_score(colA, colB):
    """mean substitution score over non-gap residue pairs; all-gap column
    gets a weak score (discourages gap-vs-gap columns)."""
    pa = [c for c in colA if c != "-"]
    pb = [c for c in colB if c != "-"]
    if not pa or not pb:
        return -1.0
    return sum(_key(a, b) for a in pa for b in pb) / (len(pa) * len(pb))

def profile_align(seqsA, seqsB):
    """Align two alignments (lists of equal-length strings)."""
    nA, nB = len(seqsA), len(seqsB)
    lenA, lenB = len(seqsA[0]), len(seqsB[0])
    colsA = [[s[k] for s in seqsA] for k in range(lenA)]
    colsB = [[s[k] for s in seqsB] for k in range(lenB)]
    dp = [[0.0] * (lenB + 1) for _ in range(lenA + 1)]
    tb = [[0] * (lenB + 1) for _ in range(lenA + 1)]
    for i in range(1, lenA + 1):
        dp[i][0], tb[i][0] = GAP * i, 2
    for j in range(1, lenB + 1):
        dp[0][j], tb[0][j] = GAP * j, 1
    for i in range(1, lenA + 1):
        ca = colsA[i-1]
        for j in range(1, lenB + 1):
            diag = dp[i-1][j-1] + col_score(ca, colsB[j-1])
            up   = dp[i-1][j] + GAP
            left = dp[i][j-1] + GAP
            best = max(diag, up, left)
            dp[i][j] = best
            tb[i][j] = 0 if best == diag else (2 if best == up else 1)
    i, j = lenA, lenB
    aOut = [[] for _ in range(nA)]
    bOut = [[] for _ in range(nB)]
    while i > 0 or j > 0:
        d = tb[i][j]
        if d == 0:
            for k in range(nA): aOut[k].append(colsA[i-1][k])
            for k in range(nB): bOut[k].append(colsB[j-1][k])
            i -= 1; j -= 1
        elif d == 2:
            for k in range(nA): aOut[k].append(colsA[i-1][k])
            for k in range(nB): bOut[k].append("-")
            i -= 1
        else:
            for k in range(nA): aOut[k].append("-")
            for k in range(nB): bOut[k].append(colsB[j-1][k])
            j -= 1
    return (["".join(reversed(s)) for s in aOut],
            ["".join(reversed(s)) for s in bOut])

def upgma(dist):
    """UPGMA clustering; returns flat leaf order (list of leaf indices)."""
    n = len(dist)
    if n == 1:
        return [0]
    d = {i: {j: dist[i][j] for j in range(n)} for i in range(n)}
    clusters = {i: [[i], 1.0] for i in range(n)}
    active = set(range(n))
    nid = n
    while len(active) > 1:
        lst = list(active)
        best = None
        for x in lst:
            for y in lst:
                if x < y and (best is None or d[x][y] < best[0]):
                    best = (d[x][y], x, y)
        _, x, y = best
        mem = clusters[x][0] + clusters[y][0]
        sz = clusters[x][1] + clusters[y][1]
        clusters[nid] = [mem, sz]
        d[nid] = {}
        for z in active:
            if z == x or z == y:
                continue
            val = (d[x][z] * clusters[x][1] + d[y][z] * clusters[y][1]) / sz
            d[nid][z] = val
            d[z][nid] = val
        active.remove(x); active.remove(y); active.add(nid)
        nid += 1
    return clusters[active.pop()][0]

def progressive_msa(seqs):
    """seqs: list of (header, sequence); returns alignment list of strings."""
    n = len(seqs)
    if n == 1:
        return [seqs[0][1]]
    dist = [[0.0] * n for _ in range(n)]
    for i in range(n):
        for j in range(i + 1, n):
            ident = nw_identity(seqs[i][1], seqs[j][1])
            dist[i][j] = dist[j][i] = 1.0 - ident
    order = upgma(dist)
    cur = [seqs[order[0]][1]]
    for idx in order[1:]:
        s = [seqs[idx][1]]
        cur, s = profile_align(cur, s)
        cur = cur + s
    return cur

def main():
    print("MAFFT availability: on_path=%s version=%s" % (MAFFT["on_path"], MAFFT["version"]))
    print("=> MAFFT --auto NOT usable; fallback pure-Python progressive MSA.\n")
    files = sorted(glob.glob(os.path.join(DATA_DIR, "*.faa")))
    total_gaps = total_pos = total_res = 0
    print("%-24s %5s %10s %8s %10s" % ("file", "seqs", "aln_len", "gaps", "positions"))
    rows = []
    for f in files:
        seqs = parse_fasta(f)
        n = len(seqs)
        aln = progressive_msa(seqs)
        L = len(aln[0])
        assert all(len(x) == L for x in aln)
        gc = sum(x.count("-") for x in aln)
        total_gaps += gc
        total_pos += L * n
        total_res += sum(len(s) for _, s in seqs)
        extra = set()
        for s in aln:
            extra |= set(c for c in s if c != "-" and c not in AA)
        rows.append((os.path.basename(f), n, L, gc))
        print("%-24s %5d %10d %8d %10d   extra_chars=%s" %
              (os.path.basename(f), n, L, gc, L * n, sorted(extra) if extra else "none"))
    print("-" * 66)
    pct = (total_gaps / total_pos) * 100.0 if total_pos else 0.0
    print("TOTAL gaps ('-'):        %d" % total_gaps)
    print("TOTAL positions:         %d" % total_pos)
    print("TOTAL non-gap residues:  %d  (sanity: gaps+residues=%d, should equal total positions=%d)"
          % (total_res, total_gaps + total_res, total_pos))
    print("GAP PERCENTAGE:          %.4f%%  (%.2f%%)" % (pct, pct))
    print("=" * 66)
    print("CAVEAT: MAFFT --auto unavailable in this sandbox; the number comes from the")
    print("pure-Python fallback progressive MSA (approximation), NOT exact MAFFT output.")

if __name__ == "__main__":
    main()
