"""
BixBench bix-7-q2 — Final analysis (executed)
Question: What is the average number of CHIP variants per sample after filtering out
intronic, intergenic, and UTR variants?

Approved filter definition:
  - Drop Zygosity ∈ {Reference, NaN} (reference genotypes are NOT variant carriers).
  - Keep Zygosity ∈ {Heterozygous, Homozygous Variant}.
  - Keep coding / splice Sequence Ontology (Combined) classes:
      synonymous_variant, missense_variant, splice_region_variant,
      inframe_insertion, inframe_deletion, frameshift_variant
  - Exclude intronic/intergenic/UTR/non-coding:
      intron_variant, 3_prime_UTR_variant, 5_prime_UTR_variant,
      5_prime_UTR_premature_start_codon_gain_variant, upstream_gene_variant,
      intergenic_variant / intergenic_region (0 found in data)
  - Count = rows per sample == distinct (Chr:Pos, Ref/Alt) sites (verified: no
    intra-sample duplicates remain after the filter).
  - Denominator = 86 samples (all have >=1 counted variant).
"""
import pandas as pd, glob, os, json, warnings
from collections import Counter
warnings.filterwarnings('ignore')

FILES = sorted(glob.glob('data/CHIP_DP10_GQ20_PASS/*.xlsx'))
KEEP  = {'synonymous_variant','missense_variant','splice_region_variant',
         'inframe_insertion','inframe_deletion','frameshift_variant'}
EXCL  = {'intron_variant','3_prime_UTR_variant','5_prime_UTR_variant',
         '5_prime_UTR_premature_start_codon_gain_variant','upstream_gene_variant',
         'intergenic_variant','intergenic_region'}
VARZY = {'Heterozygous','Homozygous Variant'}
N_SAMPLES = len(FILES)

def load(f):
    df = pd.read_excel(f, header=[0, 1])
    df.columns = [c[1] for c in df.columns]      # flatten two-level header
    return df

# ---------- 1. Structural + content scan ----------
ref_flat, so_all, zyg, intergenic_seen, multi_term = None, Counter(), Counter(), 0, 0
total_rows = 0
for f in FILES:
    df = load(f)
    if ref_flat is None:
        ref_flat = list(df.columns)
    assert list(df.columns) == ref_flat, f"header mismatch in {f}"
    total_rows += len(df)
    zval = df['Zygosity'].astype(str).fillna('NaN')
    zyg.update(zval.values)
    so_raw = df['Sequence Ontology (Combined)'].astype(str).fillna('NaN')
    so_all.update(so_raw.values)
    intergenic_seen += int(so_raw.str.contains('intergenic', case=False).sum())
    multi_term  += int(so_raw.str.contains(r'[&,;/]|\n', regex=True).sum())

# ---------- 2. Per-sample counting ----------
per, dup_full, dup_site = [], 0, 0
excluded_variant_rows = 0
for f in FILES:
    sample = os.path.basename(f).replace('230209_Exome_GRCh38_CHIP_','').replace('.xlsx','')
    df = load(f)
    v = df[df['Zygosity'].isin(VARZY) & df['Sequence Ontology (Combined)'].isin(KEEP)]
    excluded_variant_rows += int((df['Zygosity'].isin(VARZY) &
                                  ~df['Sequence Ontology (Combined)'].isin(KEEP)).sum())
    dup_full  += int(v['Chr:Pos'].astype(str).add('_').add(v['Ref/Alt'].astype(str)).duplicated().sum())
    dup_site  += int(v['Chr:Pos'].duplicated().sum())
    per.append({'sample': sample, 'count': len(v)})
per_df = pd.DataFrame(per)
mean = float(per_df['count'].mean())

# ---------- 3. Sensitivity checks ----------
def variant_count(keep):
    c = []
    for f in FILES:
        df = load(f)
        v = df[df['Zygosity'].isin(VARZY) & df['Sequence Ontology (Combined)'].isin(keep)]
        c.append(len(v))
    return float(pd.Series(c).mean())

base           = mean
no_splice      = variant_count(KEEP - {'splice_region_variant'})
keep_upstream  = variant_count(KEEP | {'upstream_gene_variant'})

report = {
  'files': N_SAMPLES, 'total_rows': total_rows,
  'structure_consistent': 'all 86 files, 33 two-level columns, identical header',
  'zygosity_counts': dict(zyg),
  'sequence_ontology_classes_all_rows': dict(so_all.most_common()),
  'intergenic_rows_found': intergenic_seen,
  'multi_term_rows_found': multi_term,
  'duplicate_(Chr:Pos,Ref/Alt)_rows_after_filter': int(dup_full),
  'duplicate_Chr:Pos_sites_after_filter': int(dup_site),
  'variant_rows_excluded_by_annotation_filter': int(excluded_variant_rows),
  'per_sample_count_mean': round(mean, 3),
  'per_sample_count_median': int(per_df['count'].median()),
  'per_sample_count_min': int(per_df['count'].min()),
  'per_sample_count_max': int(per_df['count'].max()),
  'per_sample_count_std': round(float(per_df['count'].std()), 3),
  'samples_with_zero_counted_variants': int((per_df['count']==0).sum()),
  'denominator_samples': N_SAMPLES,
  'FINAL_AVERAGE_CHIP_VARIANTS_PER_SAMPLE': round(mean, 3),
  'sensitivity': {
      'kept_splice_region_variant (approved headline)': round(base, 3),
      'exclude_splice_region_variant as well': round(no_splice, 3),
      'also_keep_upstream_gene_variant': round(keep_upstream, 3),
  }
}
print(json.dumps(report, indent=2))
print("\nPer-sample counts (sample, counted):")
print(per_df.to_string(index=False, header=False))
