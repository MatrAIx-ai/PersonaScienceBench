#!/usr/bin/env python3
"""
BixBench bix-7-q3: "How many CHIP variants remain after removing reference calls from the dataset?"

Dataset: 86 per-sample variant tables (data/CHIP_DP10_GQ20_PASS/*.xlsx).
Each file: single sheet, 2-row header (row1 = merged section titles, row2 = subheaders).
Data rows start at row 3. Key columns: col1 Chr:Pos, col2 Ref/Alt, col5 Zygosity,
col13 Gene Names, col30 In_CHIP.

Locked-in definitions:
  - "Reference call" = row with Zygosity == "Reference" (sample genotype == reference,
    sample does NOT carry the variant). Such rows are removed.
  - PRIMARY answer  = number of remaining call rows (variant-sample pairs) across all
    86 files with a real variant genotype: Zygosity in {Heterozygous, Homozygous Variant}.
  - The 1,151 None/blank-zygosity rows are non-calls (variant info present, no genotype
    block) => excluded from primary, but reported as a sensitivity: secondary total that
    retains them (they are not literally "Reference").
  - Supporting: distinct variant loci (unique Chr:Pos|Ref/Alt) among retained calls,
    per-role (Proband/Father/Mother/Child) and per-file breakdowns,
    confirmation In_CHIP == "True" on every retained row.
  - All 86 files included (incl. 380-P with 704 rows, 381-PM with 705 rows).
    Father 533 (trio 380) has no variant file and contributes nothing.
"""
import openpyxl, glob, os, re, json
import pandas as pd

VARIANT_DIR = "data/CHIP_DP10_GQ20_PASS"

# ---- Load metadata ----
genes = set(pd.read_excel("data/230214_Schenz_et_al_2022_CHIP_Genes.xlsx", header=None)[0].astype(str).str.strip())
trio = pd.read_excel("data/230215_Trio_Status.xlsx")
trio["Sample ID"] = trio["Sample ID"].astype(str).str.strip().str.replace(r"\t", "", regex=True)
status_map = dict(zip(trio["Sample ID"], trio["Status"].str.strip()))

def role_from_file(fn):
    base = os.path.basename(fn).replace("230209_Exome_GRCh38_CHIP_", "").replace(".xlsx", "")
    m = re.match(r"^(\d+)-(P\d?|P|PF|PM)$", base)
    if m:
        return {"P": "Proband", "P1": "Proband", "P2": "Proband", "PF": "Father", "PM": "Mother"}[m.group(2)]
    return status_map.get(base, "Unknown")

def sample_id_from_file(fn):
    base = os.path.basename(fn).replace("230209_Exome_GRCh38_CHIP_", "").replace(".xlsx", "")
    m = re.match(r"^(\d+)-(P\d?|P|PF|PM)$", base)
    return m.group(1) if m else base

# ---- Parse all files ----
files = sorted(glob.glob(os.path.join(VARIANT_DIR, "*.xlsx")))
records = []
for f in files:
    wb = openpyxl.load_workbook(f, data_only=True)
    ws = wb[wb.sheetnames[0]]
    sample = sample_id_from_file(f)
    role = role_from_file(f)
    for r in range(3, ws.max_row + 1):
        chrpos = ws.cell(row=r, column=1).value
        refalt = ws.cell(row=r, column=2).value
        zyg = ws.cell(row=r, column=5).value
        gene = ws.cell(row=r, column=13).value
        inchip = ws.cell(row=r, column=30).value
        vaf = ws.cell(row=r, column=10).value
        records.append({"sample": sample, "role": role, "file": os.path.basename(f),
                        "ChrPos": chrpos, "RefAlt": refalt, "Zygosity": zyg,
                        "Gene": gene, "In_CHIP": inchip, "VAF": vaf})

df = pd.DataFrame(records)
n_files = len(files)
n_rows_total = len(df)

# ---- Reference call = Zygosity == 'Reference' -> remove ----
ref_mask = df["Zygosity"].eq("Reference")
n_reference = int(ref_mask.sum())
df_no_ref = df[~ref_mask].copy()

# ---- None/blank zygosity rows (non-calls) ----
none_mask = df_no_ref["Zygosity"].isna()
n_none = int(none_mask.sum())

# ---- Primary: retained calls with real variant genotype ----
retained = df_no_ref[~none_mask].copy()  # Zygosity in {Heterozygous, Homozygous Variant}
n_strict = len(retained)
n_het = int(retained["Zygosity"].eq("Heterozygous").sum())
n_hom = int(retained["Zygosity"].eq("Homozygous Variant").sum())

# Secondary: remaining rows that are not literally 'Reference' (keeps None rows)
n_secondary = int(len(df_no_ref))

# Unique loci (Chr:Pos|Ref/Alt) among retained calls
retained["locus"] = retained["ChrPos"].astype(str) + "|" + retained["RefAlt"].astype(str)
n_unique_loci_retained = int(retained["locus"].nunique())
n_unique_loci_secondary = int(df_no_ref.assign(l=df_no_ref["ChrPos"].astype(str)+"|"+df_no_ref["RefAlt"].astype(str))["l"].nunique())

# In_CHIP check on retained rows
inchip_retained_counts = retained["In_CHIP"].astype(str).value_counts().to_dict()

# Per-role breakdown (primary)
role_counts = retained.groupby("role")["Zygosity"].value_counts().unstack(fill_value=0).reset_index()
role_total = retained.groupby("role").size().to_dict()

# Per-file breakdown (primary)
per_file = (retained.groupby(["file", "sample", "role"]).size()
            .reset_index(name="n_remaining").sort_values("n_remaining"))

# ===================== REPORT =====================
print("=" * 70)
print("BixBench bix-7-q3: CHIP variants remaining after removing reference calls")
print("=" * 70)
print(f"Files parsed: {n_files}")
print(f"Total call rows in dataset: {n_rows_total}")
print(f"  Files with 704/705 rows: 380-P (704), 381-PM (705) - included; father 533 no file (not counted)")
print(f"\nReference calls removed (Zygosity == 'Reference'): {n_reference}")
print(f"None/blank-zygosity non-calls (excluded from primary, retained in secondary): {n_none}")

print(f"\nPRIMARY ANSWER - remaining CHIP variant calls (Zygosity in "
      f"{{Heterozygous, Homozygous Variant}}): {n_strict}")
print(f"    Het: {n_het}, Hom: {n_hom}")
print(f"SECONDARY - remaining rows that are not literally 'Reference' "
      f"(includes {n_none} None rows): {n_secondary}")
print(f"UNIQUE loci (Chr:Pos|Ref/Alt) among retained calls: {n_unique_loci_retained}")
print(f"UNIQUE loci among secondary (excludes Reference only): {n_unique_loci_secondary}")
print(f"\nIn_CHIP on every retained row: {inchip_retained_counts}")

print("\nPer-role retained calls (Heterozygous/Homozygous Variant):")
print(role_counts.to_string(index=False))
print("\nPer-role totals:", dict(sorted(role_total.items())))

print("\nPer-file retained calls (min/max/median):",
      int(per_file['n_remaining'].min()), int(per_file['n_remaining'].max()),
      float(per_file['n_remaining'].median()))
print("\nPer-file table (file, sample, role, n_remaining):")
print(per_file.to_string(index=False))

# ===================== SAVE JSON =====================
out = {
    "question": "How many CHIP variants remain after removing reference calls from the dataset?",
    "definition_reference_call": "Row with Zygosity == 'Reference' (sample does not carry the variant); such rows are removed.",
    "definition_primary_answer": "Number of remaining call rows (variant-sample pairs) across all 86 files with Zygosity in {Heterozygous, Homozygous Variant}.",
    "files_parsed": n_files,
    "total_call_rows": n_rows_total,
    "reference_calls_removed": n_reference,
    "none_zygosity_non_calls": n_none,
    "heterozygous_calls": n_het,
    "homozygous_variant_calls": n_hom,
    "primary_remaining_variant_calls": n_strict,
    "secondary_remaining_rows_excluding_reference": n_secondary,
    "unique_loci_retained": n_unique_loci_retained,
    "unique_loci_secondary": n_unique_loci_secondary,
    "inchip_true_on_all_retained_rows": inchip_retained_counts,
    "per_role": {str(k): int(v) for k, v in role_total.items()},
    "per_role_zygosity": role_counts.astype(str).to_dict(orient="records"),
    "per_file": per_file.to_dict(orient="records"),
    "note_father_533": "Sample 533 (father of trio 380) is in Trio_Status but has no variant file; contributes nothing.",
    "note_704_705": "Files 380-P (704 rows) and 381-PM (705 rows) are included normally.",
}
with open("analysis/chip_variants_result.json", "w") as fh:
    json.dump(out, fh, indent=2)
print("\nSaved analysis/chip_variants_result.json")
