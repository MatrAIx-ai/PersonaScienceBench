"""bix-8-q5: Test independence between m6A methylation status and DEG status
(bladder cancer). Uses pre-existing flags, 2x2 table, Pearson chi-square with
Yates correction (primary), Fisher exact + chi-square(correction=False) sanity
checks, and an optional 3x3 secondary figure.
"""
import json
import pandas as pd
import scipy.stats as stats

# ---- 1. Load the MeRIP sheet (Date Formatting) ----
df = pd.read_excel("data/MeRIP_RNA_result.xlsx", sheet_name="Date Formatting")
print("Rows loaded:", len(df))

# ---- 2. Build binary flags from the sheet's own m6A / DEG columns ----
m6A_sig = df["m6A"].isin(["m6A Hyper", "m6A Hypo"])   # True = m6A significant
deg_sig = df["DEG"].isin(["Up", "Down"])               # True = DEG

assert df["m6A"].notna().all() and df["DEG"].notna().all()
assert m6A_sig.sum() == 680 + 511, "m6A significant count unexpected"
assert deg_sig.sum() == 548 + 415, "DEG count unexpected"

# ---- 3. 2x2 contingency table ----
table2 = pd.crosstab(m6A_sig, deg_sig).reindex(index=[True, False], columns=[True, False]).fillna(0).astype(int)
table2.index = ["m6A sig", "m6A no sig"]
table2.columns = ["DEG", "no-DEGs"]
print("\n2x2 table (primary):\n", table2)

# ---- 4. Primary: Pearson chi-square (default Yates correction) ----
chi2_corr, p_corr, dof, expected = stats.chi2_contingency(table2.values, correction=True)
print(f"\n[PRIMARY] chi2 (Yates) = {chi2_corr:.6f}, dof = {dof}, p = {p_corr:.6e}")

# ---- 5. Sanity checks ----
chi2_nocorr, p_nocorr, _, exp_nocorr = stats.chi2_contingency(table2.values, correction=False)
oddsr, p_fisher = stats.fisher_exact(table2.values, alternative="two-sided")
print(f"[CHECK] chi2 (no correction) = {chi2_nocorr:.6f}, p = {p_nocorr:.6e}")
print(f"[CHECK] Fisher two-sided oddsratio = {oddsr:.6f}, p = {p_fisher:.6e}")
print("Min expected count (2x2):", expected.min())

# ---- 6. Optional secondary: 3x3 chi-square ----
table3 = pd.crosstab(df["m6A"], df["DEG"]).reindex(
    index=["m6A Hyper", "m6A Hypo", "m6A no sig"],
    columns=["Up", "Down", "no-DEGs"]).fillna(0).astype(int)
chi2_3, p_3, dof_3, exp_3 = stats.chi2_contingency(table3.values, correction=False)
print("\n3x3 table (secondary):\n", table3)
print(f"[SECONDARY] 3x3 chi2 = {chi2_3:.6f}, dof = {dof_3}, p = {p_3:.6e}")

# ---- 7. Scientific-notation answer ----
def sci(p, sig=2):
    s = format(p, f".{sig}e")
    return s

answer = sci(p_corr)
print("\nFINAL ANSWER (chi-square p, Yates):", answer)

out = {
    "n_rows": int(len(df)),
    "table_2x2": table2.to_dict(),
    "chi2_yates": round(float(chi2_corr), 6),
    "p_yates": float(p_corr),
    "p_yates_scientific": answer,
    "dof": int(dof),
    "expected_2x2": expected.tolist(),
    "chi2_no_correction": round(float(chi2_nocorr), 6),
    "p_no_correction": float(p_nocorr),
    "fisher_oddsratio": round(float(oddsr), 6),
    "fisher_p": float(p_fisher),
    "table_3x3": table3.to_dict(),
    "chi2_3x3": round(float(chi2_3), 6),
    "p_3x3": float(p_3),
}
with open("analysis/results.json", "w") as f:
    json.dump(out, f, indent=2)
print("\nSaved analysis/results.json")
