"""
BixBench bix-9-q5: In which tissue type do bad responders show the highest number
of significantly differentially expressed (lfc>0.5 and basemean>10) genes
compared to controls?

Data: data/Data_deposition_RNAseq_Paroxetine_2017.xlsx
Sheets: 'Mapping_statistics' (sample metadata), 'NormCount' (DESeq-normalized counts
plus 9 precomputed DESeq comparison blocks).

Primary approach: use the authors' stored DESeq outputs for the bad-vs-Control
comparison in each tissue (Comparison 2/5/8 for baseline_blood/dentate_gyrus/final_blood;
stored log2FoldChange is Control-vs-bad so bad-vs-control lfc = -stored).
Threshold: lfc > 0.5 AND baseMean > 10  (literal question definition).
Cross-check: recompute baseMean/lfc from the normalized count matrix.
"""
import numpy as np
import pandas as pd

FP = "/workspace/data/Data_deposition_RNAseq_Paroxetine_2017.xlsx"

# ----------------------------------------------------------------------------
# 1. Sample metadata
# ----------------------------------------------------------------------------
ms = pd.read_excel(FP, sheet_name="Mapping_statistics")
print("[1] Mapping_statistics columns:", list(ms.columns))
print("[1] samples:", len(ms), "| Response:", ms.Response.unique().tolist(),
      "| Tissues:", ms.Tissue.unique().tolist())
print(ms.groupby(["Tissue", "Response"]).size().unstack(fill_value=0))

# ----------------------------------------------------------------------------
# 2. NormCount count matrix + derived DESeq blocks
# ----------------------------------------------------------------------------
nc = pd.read_excel(FP, sheet_name="NormCount", header=None)
colname_row = nc.iloc[3]                       # real column-name row (Excel row 4)
data = nc.iloc[4:].copy()                      # 25402 genes
data.columns = list(range(nc.shape[1]))
for j in range(2, 92):                          # sample count columns
    data[j] = pd.to_numeric(data[j], errors="coerce")

sample_codes = [str(colname_row[j]) for j in range(2, 92)]
assert len(sample_codes) == 90 and len(set(sample_codes)) == 90
assert set(sample_codes) == set(ms["Code"].astype(str))

# group -> count columns (cols 2..91)
def parse_code(s):
    if s.startswith("Control"):
        resp, rest = "Control", s[len("Control_"):]
    elif s.startswith("good_responder_"):
        resp, rest = "good_responder", s[len("good_responder_"):]
    elif s.startswith("bad_responder_"):
        resp, rest = "bad_responder", s[len("bad_responder_"):]
    if rest.startswith("baseline_blood"):
        tissue = "baseline_blood"
    elif rest.startswith("dentate_gyrus"):
        tissue = "dentate_gyrus"
    else:
        tissue = "final_blood"
    return resp, tissue

meta = {j: parse_code(sc) for j, sc in zip(range(2, 92), sample_codes)}

# ----------------------------------------------------------------------------
# 3. Primary: stored DESeq results for bad-vs-Control (Comparison 2/5/8)
# ----------------------------------------------------------------------------
# comparison block starts: baseline=107(Comp2), dentate=134(Comp5), final=161(Comp8)
comp_start = {"baseline_blood": 107, "dentate_gyrus": 134, "final_blood": 161}
# block layout: +0 baseMean, +1 baseMeanA, +2 baseMeanB, +3 foldChange,
#               +4 log2FoldChange, +5 pval, +6 padj, +7 DEG, +8 DEG
print("\n[3] PRIMARY: stored DESeq results, bad vs Control, lfc>0.5 & baseMean>10")
print("    (stored lfc is Control-vs-bad; bad-vs-control lfc = -stored lfc)")
summary = []
for tissue, start in comp_start.items():
    baseMean = pd.to_numeric(data[start], errors="coerce")
    lfc_stored = pd.to_numeric(data[start + 4], errors="coerce")
    padj = pd.to_numeric(data[start + 6], errors="coerce")
    lfc_bad = -lfc_stored                       # bad vs Control (up in bad = +)
    up = int(((lfc_bad > 0.5) & (baseMean > 10)).sum())            # literal lfc>0.5
    abs = int(((np.abs(lfc_bad) > 0.5) & (baseMean > 10)).sum())   # |lfc|>0.5
    fdr = int(((lfc_bad > 0.5) & (baseMean > 10) & (padj < 0.05)).sum())
    summary.append((tissue, up, abs, fdr))
    print(f"    {tissue:15s} lfc>0.5&bm>10: {up:5d} | |lfc|>0.5&bm>10: {abs:5d} | up+padj<0.05: {fdr:5d}")
res = pd.DataFrame(summary, columns=["tissue", "up_lfc05", "abs_lfc05", "up_fdr"])
best = res.loc[res["up_lfc05"].idxmax()]
print("\n[3] TISSUE WITH HIGHEST (primary, stored DESeq):", best["tissue"],
      "with", best["up_lfc05"], "genes (lfc>0.5 & baseMean>10)")

# ----------------------------------------------------------------------------
# 4. Cross-check: recompute baseMean & lfc from the normalized count matrix
# ----------------------------------------------------------------------------
print("\n[4] CROSS-CHECK: recomputed from normalized count matrix")
summary2 = []
for tissue in ["baseline_blood", "dentate_gyrus", "final_blood"]:
    ctrl = [j for j, (r, t) in meta.items() if r == "Control" and t == tissue]
    bad = [j for j, (r, t) in meta.items() if r == "bad_responder" and t == tissue]
    mC = data[ctrl].mean(axis=1)
    mB = data[bad].mean(axis=1)
    baseMean = data[ctrl + bad].mean(axis=1)
    lfc = np.log2((mB + 1e-6) / (mC + 1e-6))
    up = int(((lfc > 0.5) & (baseMean > 10)).sum())
    abs = int(((np.abs(lfc) > 0.5) & (baseMean > 10)).sum())
    summary2.append((tissue, up, abs))
    print(f"    {tissue:15s} lfc>0.5&bm>10: {up:5d} | |lfc|>0.5&bm>10: {abs:5d}")
res2 = pd.DataFrame(summary2, columns=["tissue", "up_lfc05", "abs_lfc05"])
best2 = res2.loc[res2["up_lfc05"].idxmax()]
print("\n[4] TISSUE WITH HIGHEST (cross-check recomputation):", best2["tissue"],
      "with", best2["up_lfc05"], "genes")

print("\nDONE")
