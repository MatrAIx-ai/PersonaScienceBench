"""
DiscoveryBench — archaeology/metadata_13
Question: In what centuries did we see the highest growth phase of the period between 2000 BCE and 1100 BCE?

Approach (approved):
- Window: CE -2000 .. -1100 (2000-1100 BCE), 901 years, fully covered by time_series_data.csv.
- Primary growth indicator: g_all_mean (mean of KDE growth rates of all archaeological data points).
- Corroborating growth indicator: pollen_grate_100 (data-provided 100-yr % change of pollen/openness).
- Capital evidence: capital.csv 100-yr binned Z-values; level evidence: kde_all_mean.
- 100-year bins on the CE axis; century-label convention stated explicitly.
"""
import pandas as pd, numpy as np, json, os

OUT = os.path.join(os.path.dirname(__file__), "..", "artifact", "growth_outputs")
os.makedirs(OUT, exist_ok=True)

# ---------- load ----------
def col_parser(s):
    return pd.to_numeric(s.astype(str).str.replace(',', '.'), errors='coerce')

ts = pd.read_csv("data/time_series_data.csv")
pol_open = pd.read_csv("data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv")
for c in ['Belau_PC1','Woserin_PC1','Belau_PC1_inter','Woserin_PC1_inter','MEAN',
          'SMOOTH_MEAN_50y','SMOOTH_MEAN_100y','SMOOTH_MEAN_150y','SMOOTH_MEAN_200y','SMOOTH_MEAN_250y']:
    pol_open[c] = col_parser(pol_open[c])
cap = pd.read_csv("data/capital.csv")
for c in cap.columns:
    if c not in ('BCE','group','color'):
        cap[c] = col_parser(cap[c])

# ---------- 1) century bins ----------
w = ts[(ts['CE']>=-2000)&(ts['CE']<=-1100)].copy()
w['bin_CE'] = (w['CE']//100)*100
bins = w.groupby('bin_CE').agg(
    g_all_mean=('g_all_mean','mean'),
    g_all_mean_sum=('g_all_mean','sum'),
    pollen_grate_100=('pollen_grate_100','mean'),
    kde_all_mean=('kde_all_mean','mean'),
    n=('CE','count'))
bins['cal_years_BCE'] = bins.index.map(lambda c: f"{int(-c)}-{int(-c-99)} BCE")  # e.g. -1500 -> 1500-1401 BCE
bins['century_label'] = bins.index.map(lambda c: f"{int(-c//100)}c BCE")          # researcher convention
bins['rank_g'] = bins['g_all_mean'].rank(ascending=False, method='min').astype(int)
bins['rank_p'] = bins['pollen_grate_100'].rank(ascending=False, method='min').astype(int)
bins = bins.sort_index()
print("\n================ CENTURY (100-yr) BIN TABLE, window 2000-1100 BCE ================")
print(bins.round(5).to_string())
bins.round(5).to_csv(os.path.join(OUT,'century_ranking.csv'))

# peak bin + local maxima (g_all_mean)
peak = bins['g_all_mean'].idxmax()
print("\nGlobal peak bin (g_all_mean):", peak, "->", bins.loc[peak,'cal_years_BCE'], "|", bins.loc[peak,'century_label'])
# local maxima: value > previous and > next
vals = bins['g_all_mean'].values; idxs = bins.index
local_max = [idxs[i] for i in range(1,len(vals)-1) if vals[i]>vals[i-1] and vals[i]>=vals[i+1]]
print("Local maxima on g_all_mean:", [f"{i} ({bins.loc[i,'century_label']}, g={bins.loc[i,'g_all_mean']:.5f})" for i in local_max])
p_peak = bins['pollen_grate_100'].idxmax()
print("Global peak bin (pollen_grate_100):", p_peak, "->", bins.loc[p_peak,'cal_years_BCE'], "|", bins.loc[p_peak,'century_label'])

# ---------- 2) phase contour: 50-yr sub-bins ----------
w['bin50'] = (w['CE']//50)*50
sub = w.groupby('bin50').agg(g=('g_all_mean','mean'), pg=('pollen_grate_100','mean'), kde=('kde_all_mean','mean'))
sub['BCE'] = -sub.index
print("\n================ 50-yr SUB-BIN PHASE CONTOUR ================")
print(sub.round(5).to_string())
sub.round(5).to_csv(os.path.join(OUT,'phase_contour_50yr.csv'))

pos_g = sub[sub['g']>0]
print("\nSustained positive g_all_mean: BCE from", pos_g['BCE'].min(), "to", pos_g['BCE'].max(),
      "(50-yr bins:", sorted(set(-pos_g.index)), ")")
argmax50 = sub['g'].idxmax()
print("50-yr peak bin:", argmax50, "-> BCE", -argmax50, "g=", round(sub.loc[argmax50,'g'],5))

# ---------- 3) corroboration: capital.csv in-window high Z ----------
capw = cap[(cap['BCE']>=1100)&(cap['BCE']<=2000)].copy()
print("\n================ capital.csv Z-values in window (100-yr bins) ================")
zc = ['ZAxtSchwert','ZDolch','Zhausgr','ZCU_AU','Zamber','ZMonument','ZHort','ZSichel','ZBeil','ZMW','ZKeform','Zkeverz']
print(capw[['BCE','group']+zc].round(2).to_string(index=False))
capw[['BCE','group']+zc].round(4).to_csv(os.path.join(OUT,'capital_window.csv'))
print("\nPer-column argmax BCE in window:")
print({c: capw.loc[capw[c].idxmax(),'BCE'] for c in zc if capw[c].notna().all()})

# kde_all_mean level trajectory at century marks
marks = pd.DataFrame({'CE':[-2000,-1900,-1800,-1700,-1600,-1500,-1400,-1300,-1200,-1100]})
mk = ts[ts['CE'].isin(marks['CE'])][['CE','kde_all_mean','g_all_mean']].set_index('CE')
mk['BCE']=-mk.index
print("\n================ level kde_all_mean at 100-yr marks ================")
print(mk.round(5).to_string())
mk.round(5).to_csv(os.path.join(OUT,'kde_level_marks.csv'))

# window coverage summary
summary = {
 'window_CE': [-2000,-1100], 'n_years_window': len(w),
 'ts_rows': len(ts), 'cap_bins_in_window': len(capw),
 'pol_rows': len(pol_open), 'pol_rows_window': len(pol_open[(pol_open['CE']>=-2000)&(pol_open['CE']<=-1100)]),
 'peak_bin_g': int(peak), 'peak_bin_pollen': int(p_peak),
 'peak_50yr_bin_g': int(argmax50),
 'sustained_positive_50yr_BCE': [int(-i) for i in pos_g.index],
}
with open(os.path.join(OUT,'summary.json'),'w') as f: json.dump(summary,f,indent=2)
print("\nsummary.json written:", summary)
print("\nDONE")
