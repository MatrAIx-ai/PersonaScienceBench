# MAIN ANALYSIS (DiscoveryBench archaeology) - PCA on forms of capital
# in hundred-year time slices (capital.csv). Sign convention: PC1 is sign-fixed
# so that positive PC1 points along the dominant amber/depot direction
# (Zamber loading > 0). Loadings are always reported.
# Locked variable->capital-form mapping (study context):
#   Symbolic = hatchet/sword, dagger, house size
#   Social   = copper/gold, amber, monument count
#   Cultural = pottery form, pottery decoration
#   Economic = depot, sickle, axe/celt, monument size
import pandas as pd, numpy as np

ZCOLS = ['ZAxtSchwert','ZDolch','Zhausgr','ZCU_AU','Zamber','ZMonument','ZHort',
         'ZSichel','ZBeil','ZMW','ZKeform','Zkeverz']
FORM_MAP = {
    'Symbolic': ['ZAxtSchwert','ZDolch','Zhausgr'],
    'Social':   ['ZCU_AU','Zamber','ZMonument'],
    'Cultural': ['ZKeform','Zkeverz'],
    'Economic': ['ZHort','ZSichel','ZBeil','ZMW'],
}
col2form = {c: k for k, v in FORM_MAP.items() for c in v}

cap = pd.read_csv('data/capital.csv', dtype=str)
X = cap[ZCOLS].apply(lambda s: pd.to_numeric(s.str.replace(',', '.', regex=False))).to_numpy(float)
BCE = pd.to_numeric(cap['BCE']).to_numpy()
GROUP = cap['group'].values
Xc = (X - X.mean(0)) / X.std(0, ddof=0)   # PCA on correlations

def pca(Xin):
    U, S, Vt = np.linalg.svd(Xin, full_matrices=False)
    return U * S, Vt.T, S**2 / np.sum(S**2)

scores, loadings, evr = pca(Xc)
flip = loadings[0, ZCOLS.index('Zamber')] < 0
if flip:
    loadings[0] = -loadings[0]
    scores[:, 0] = -scores[:, 0]
print('PC1 sign flipped so amber loading > 0:', flip)
print('Explained variance PC1..4:', np.round(evr[:4], 4), ' cum PC1-3:', np.round(np.cumsum(evr)[:3], 4))

l1 = pd.Series(loadings[0], index=ZCOLS)
ldf = pd.DataFrame({'variable': ZCOLS, 'capital_form': [col2form[c] for c in ZCOLS],
                    'loading': l1.round(3)})
print('\nPC1 LOADINGS (sorted by |loading|):')
print(ldf.reindex(ldf.loading.abs().sort_values(ascending=False).index).to_string(index=False))

print('\nPC1 mean loading by capital form:')
for form, cols in FORM_MAP.items():
    print('  %-9s mean=%+.3f max|.|=%.3f' % (form, l1[cols].mean(), l1[cols].abs().max()))

df = pd.DataFrame({'BCE': BCE, 'group': GROUP, 'PC1': np.round(scores[:, 0], 3)})
df = df.sort_values('BCE', ascending=False)
print('\nPER-SLICE PC1:')
print(df.to_string(index=False))
df.to_csv('analysis/pc1_by_slice.csv', index=False)

print('\nPHASE STATISTICS (PC1):')
for lo, hi, label in [(3400, 3000, 'Middle Neolithic'), (2900, 2300, 'Younger Neolithic')]:
    sub = df[(df.BCE <= lo) & (df.BCE >= hi)]
    t = sub.sort_values('BCE')
    print(f'{label}: n={len(t)} mean={t.PC1.mean():+.3f} sd={t.PC1.std():.3f} '
          f'min={t.PC1.min():+.3f} @{t.loc[t.PC1.idxmin(),"BCE"]}BCE '
          f'max={t.PC1.max():+.3f} @{t.loc[t.PC1.idxmax(),"BCE"]}BCE')
    print('   trajectory (BCE->PC1):', list(zip(t.BCE.tolist(), t.PC1.round(2).tolist())))

# Robustness check: PCA on 4 aggregated capital-form indices (sanity only)
Xn = (X - X.mean(0)) / X.std(0, ddof=0)
Z = pd.DataFrame(Xn, columns=ZCOLS)
forms = pd.DataFrame({f: Z[c].sum(axis=1) for f, c in FORM_MAP.items()})
form_std = (forms - forms.mean(0)) / forms.std(0, ddof=0)
s2, l2, ev2 = pca(form_std.to_numpy(float))
if l2[0, list(FORM_MAP).index('Economic')] < 0:
    l2[0] = -l2[0]; s2[:, 0] = -s2[:, 0]
print('\nROBUSTNESS - 4-form PC1 variance share: %.3f' % ev2[0])
print('4-form loadings:', {f: round(l2[0, i], 3) for i, f in enumerate(FORM_MAP)})
for lo, hi, label in [(3400, 3000, 'MN'), (2900, 2300, 'YN/SG')]:
    sub = pd.DataFrame({'BCE': BCE, 'P': s2[:, 0]})
    m = sub[(sub.BCE <= lo) & (sub.BCE >= hi)].P.mean()
    print('  4form-PC1 %-6s mean=%+.3f' % (label, m))

# Optional pollen context: correlation only (never in the PCA)
pol = pd.read_csv('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv', dtype=str)
for c in ['MEAN', 'SMOOTH_MEAN_100y']:
    pol[c] = pd.to_numeric(pol[c].str.replace(',', '.', regex=False))
pol['CE'] = pd.to_numeric(pol['CE'])
pidx = pol.set_index('CE')
dfi = df.set_index('BCE')
pv = [pidx.loc[-b, 'SMOOTH_MEAN_100y'] if -b in pidx.index else np.nan for b in dfi.index]
s = pd.DataFrame({'PC1': dfi.PC1, 'pollen100': pv}).dropna()
print('\nCONTEXT ONLY - corr(PC1, pollen SMOOTH_MEAN_100y): r=%.3f n=%d' % (
    np.corrcoef(s.PC1, s.pollen100)[0, 1], len(s)))
