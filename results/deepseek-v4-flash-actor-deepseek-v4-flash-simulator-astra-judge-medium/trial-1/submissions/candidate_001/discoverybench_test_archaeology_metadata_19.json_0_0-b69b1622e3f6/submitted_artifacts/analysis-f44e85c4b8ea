"""
DiscoveryBench: archaeology metadata_19
Question: In the PCA on the forms of capital analyzed in hundred-year time slices,
during the Younger Bronze Age (1100-500 BCE), how does the principal component value
of PC1 at the beginning of the period (1100 BCE) differ from the subsequent time
horizons between 1000 and 500 BCE?

Protocol (approved):
- PCA matrix = capital.csv 39 hundred-year slices x 12 Z-variables (Z-scores per column)
- drop group/color (flagged 'Dropped after data loading')
- PCA via SVD; PC1 oriented so that loading on CopperGold (ZCU_AU) is POSITIVE
  (higher PC1 = higher capital intensity / social complexity)
- default fit = full 39-slice series; sensitivity = YBA-only (7-slice) fit
- comparison: (a) 1100 vs each 1000-500 slice, (b) 1100 vs block mean/median,
  (c) internal trend/range of 1000-500
"""
import numpy as np
import pandas as pd

# ---------------- load capital.csv (German decimal commas) ----------------
cap = pd.read_csv("data/capital.csv", sep=",", dtype=str)
for c in cap.columns:
    if c not in ("BCE", "group", "color"):
        cap[c] = cap[c].str.replace(",", ".").astype(float)
cap["BCE"] = cap["BCE"].astype(int)
cap = cap.sort_values("BCE")  # ascending BCE (500 ... 4300)

Z_ORDER = ["ZAxtSchwert", "ZDolch", "Zhausgr", "ZCU_AU", "Zamber", "ZMonument",
           "ZHort", "ZSichel", "ZBeil", "ZMW", "ZKeform", "Zkeverz"]
CATEGORY = {
    "ZCU_AU": "social", "Zamber": "social", "ZMonument": "social",
    "ZAxtSchwert": "symbolic", "ZDolch": "symbolic", "Zhausgr": "symbolic",
    "ZKeform": "cultural", "Zkeverz": "cultural",
    "ZHort": "economic", "ZSichel": "economic", "ZBeil": "economic", "ZMW": "economic",
}
X = cap[Z_ORDER].values.astype(float)
BCE = cap["BCE"].values
later_bce = [1000, 900, 800, 700, 600, 500]

# ---------------- PCA helper (SVD, standardized; sign-oriented) ----------------
def run_pca(Xin, std=True):
    col_mean = Xin.mean(axis=0)
    col_std = Xin.std(axis=0)
    if std:
        Xc = (Xin - col_mean) / (col_std + 1e-12)
    else:
        Xc = Xin - col_mean
    U, S, Vt = np.linalg.svd(Xc, full_matrices=False)
    ev = S ** 2 / np.sum(S ** 2)
    # orient PC1: positive loading on CopperGold (index 3 = ZCU_AU)
    if Vt[0, 3] < 0:
        Vt[0] = -Vt[0]
        S[0] = -S[0]  # keep score = Xc @ v
    scores = Xc @ Vt.T
    return scores[:, 0], ev, Vt[0], col_mean, col_std

def summarize(pc1, bce, label):
    print("\n" + "=" * 70)
    print(f"PCA fit [{label}]  (PC1 oriented: +loading on CopperGold)")
    yba_mask = (bce >= 500) & (bce <= 1100)
    print("PC1 per YBA slice (BCE: PC1):")
    for b, s in zip(bce[yba_mask], pc1[yba_mask]):
        print(f"   {b:5d} BCE : {s:+.4f}")
    p1100 = pc1[bce == 1100][0]
    later = np.array([pc1[bce == b][0] for b in later_bce])
    print(f"PC1(1100 BCE) = {p1100:+.4f}")
    print("later horizons PC1:", np.array2string(later, precision=4, sign="+"))
    print("pairwise diffs (1100 - t):", np.array2string(p1100 - later, precision=4, sign="+"))
    print(f"block mean(1000-500) = {later.mean():+.4f}   median = {np.median(later):+.4f}")
    print(f"1100 - block_mean = {p1100 - later.mean():+.4f}")
    print(f"1100 - block_median = {p1100 - np.median(later):+.4f}")
    print(f"1100 > max(later)? {p1100 > later.max()}   (range of later: {later.min():+.4f} .. {later.max():+.4f})")
    # trend within 1000-500
    t = np.arange(len(later))
    slope = np.polyfit(t, later, 1)[0]
    print(f"trend within 1000-500 (per 100y, linear slope) = {slope:+.4f}")
    # all YBA slices min/max check
    yba_all = pc1[yba_mask]
    print(f"YBA min {yba_all.min():+.4f} at BCE {bce[yba_mask][np.argmin(yba_all)]}, "
          f"YBA max {yba_all.max():+.4f} at BCE {bce[yba_mask][np.argmax(yba_all)]}")
    return p1100, later

# ---------------- default: full-39-slice fit, standardized ----------------
pc1_full, ev_full, v_full, mu_f, sd_f = run_pca(X, std=True)
print("=" * 70)
print("DEFAULT fit: full 39 slices, standardized")
print("PC1 explained variance ratio = %.3f" % ev_full[0])
print("PC1 loadings (12 vars):")
for i, z in enumerate(Z_ORDER):
    print(f"   {z:12s} ({CATEGORY[z]:8s}): {v_full[i]:+.3f}")
p1100_f, later_f = summarize(pc1_full, BCE, "full 39 slices, standardized")

# ---------------- sensitivity 1: center-only ----------------
pc1_co, ev_co, v_co, _, _ = run_pca(X, std=False)
print("\n[Sensitivity] center-only (no per-column scaling): corr(PC1_full, PC1_center-only) =",
      round(np.corrcoef(pc1_full, pc1_co)[0, 1], 4))
p1100_co, later_co = summarize(pc1_co, BCE, "full 39 slices, center-only")

# ---------------- sensitivity 2: YBA-only (7-slice) fit, standardized ----------------
yba_rows = (BCE >= 500) & (BCE <= 1100)
pc1_yba, ev_yba, v_yba, _, _ = run_pca(X[yba_rows], std=True)
print("\n[Sensitivity] YBA-only 7-slice fit:")
print("PC1 explained variance (YBA-only) = %.3f" % ev_yba[0])
p1100_y, later_y = summarize(pc1_yba, BCE[yba_rows], "YBA-only 7 slices, standardized")

# ---------------- cross-check: time_series *_inter matches capital at slice years ----------------
ts = pd.read_csv("data/time_series_data.csv", index_col=0).set_index("CE")
zmap = {"ZAxtSchwert":"HatchetSword_inter","ZDolch":"Dagger_inter","Zhausgr":"HouseSize_inter",
        "ZCU_AU":"CopperGold_inter","Zamber":"Amber_inter","ZMonument":"MonumentCount_inter",
        "ZHort":"Depot_inter","ZSichel":"Sickle_inter","ZBeil":"AxesCelts_inter","ZMW":"MonumentSize_inter",
        "ZKeform":"PotteryForm_inter","Zkeverz":"PotteryDecoration_inter"}
mism = 0
for _, row in cap.iterrows():
    ce = -row["BCE"]
    if ce in ts.index:
        for zc, tcol in zmap.items():
            mism += int(abs(row[zc] - ts.loc[ce, tcol]) > 1e-6)
print("\nCross-check capital Z == time_series *_inter at slice years: mismatches =", mism)

# ---------------- compact summary table for handoff ----------------
print("\n" + "=" * 70)
print("SUMMARY TABLE (default = full-39 standardized, oriented PC1)")
rows = []
for label, pc1, bce in [("full39_std", pc1_full, BCE),
                        ("full39_center", pc1_co, BCE),
                        ("yba7_std", pc1_yba, BCE[yba_rows])]:
    d = {"label": label, "PC1_1100": pc1[bce == 1100][0]}
    for b in later_bce:
        d[f"PC1_{b}"] = pc1[bce == b][0]
    later = np.array([pc1[bce == b][0] for b in later_bce])
    d["block_mean"] = later.mean()
    d["block_median"] = np.median(later)
    d["diff_vs_mean"] = d["PC1_1100"] - later.mean()
    d["1100_is_max"] = d["PC1_1100"] > later.max()
    rows.append(d)
print(pd.DataFrame(rows).round(4).to_string(index=False))
