"""Main analysis: pooled PCA on century-slice forms-of-capital matrix.

- Century-slice matrix: 37 rows where raw capital Z-values exist (CE -4100..-500)
  x 12 capital variables. Symbolic group = {HouseSize, Dagger, HatchetSword}.
- Pooled PCA (numpy SVD) on column-standardized matrix (primary) + raw-Z covariance
  sensitivity. Reports explained variance, PC1/PC2 loadings, variable-PC correlations.
- "Distribution across PC2": PC2 loading AND across-slice projection spread (range,
  IQR, extremes, per-period density) for every variable.
- Sensitivity: include (+2 earliest capital.csv rows, BCE 4300/4200) vs exclude.
"""
import pandas as pd, numpy as np
pd.set_option('display.max_rows', 400)

raw_cols = ['HatchetSword','Dagger','HouseSize','CopperGold','Amber','MonumentCount',
            'Depot','Sickle','AxesCelts','MonumentSize','PotteryForm','PotteryDecoration']
symbolic = ['HouseSize','Dagger','HatchetSword']

# ---------------- load data ----------------
ts = pd.read_csv('data/time_series_data.csv')
M37 = ts[ts['HouseSize'].notna()][raw_cols].to_numpy(dtype=float)      # 37 x 12, CE -4100..-500
CE37 = ts[ts['HouseSize'].notna()]['CE'].to_numpy()

# capital.csv for the 39-row version and period mapping
cap = pd.read_csv('data/capital.csv')
zmap = {'ZAxtSchwert':'HatchetSword','ZDolch':'Dagger','Zhausgr':'HouseSize',
        'ZCU_AU':'CopperGold','Zamber':'Amber','ZMonument':'MonumentCount',
        'ZHort':'Depot','ZSichel':'Sickle','ZBeil':'AxesCelts','ZMW':'MonumentSize',
        'ZKeform':'PotteryForm','Zkeverz':'PotteryDecoration'}
for c in zmap:
    cap[c] = pd.to_numeric(cap[c].astype(str).str.replace(',', '.', regex=False))
cap['CE'] = -cap['BCE']
M39 = cap[list(zmap.keys())].rename(columns=zmap)[raw_cols].to_numpy(dtype=float)  # 39 x 12 (BCE 4300..500)
CE39 = cap['CE'].to_numpy()
# period per CE (from capital.csv)
per_map = dict(zip(cap['CE'], cap['group']))

def pca_standardized(X):
    """PCA on correlation matrix (column-standardized)."""
    n, p = X.shape
    Xc = X - X.mean(0)
    sd = Xc.std(0)
    Xs = Xc / sd
    U, s, Vt = np.linalg.svd(Xs, full_matrices=False)
    ev = s**2/(n-1); evr = ev/ev.sum()
    load = Vt.T                       # p x p  (unit-norm eigenvectors)
    corr = load * (s/np.sqrt(n-1))    # variable-PC correlations
    scores = U * s                    # n x p  (row scores)
    return Xs, load, corr, evr, scores, s

def pca_rawcov(X):
    """PCA on covariance (raw Z values, NOT re-standardized) - sensitivity."""
    n, p = X.shape
    Xc = X - X.mean(0)
    U, s, Vt = np.linalg.svd(Xc, full_matrices=False)
    ev = s**2/(n-1); evr = ev/ev.sum()
    return Vt.T, evr

def summarize(X, CEarr, name):
    print('='*78)
    print(name, '| shape', X.shape)
    Xs, load, corr, evr, scores, s = pca_standardized(X)
    print('Explained variance ratio PC1..PC5:', np.round(evr[:5],3),
          '| cum (2 PCs):', round(evr[:2].sum(),3))
    df = pd.DataFrame(index=raw_cols)
    df['PC1_loading'] = load[:,0]; df['PC2_loading'] = load[:,1]
    df['PC1_corr'] = corr[:,0];    df['PC2_corr'] = corr[:,1]
    df['var_across_slices(orig Z)'] = X.std(0)   # raw Z sd
    print('Loadings / correlations (correlation-matrix PCA):')
    print(df.round(3).to_string())
    # correlation matrix of the 12 variables
    C = np.corrcoef(Xs.T)
    cdf = pd.DataFrame(C, index=raw_cols, columns=raw_cols)
    print()
    print('Correlation matrix of standardized capital variables (symbolic block):')
    print(cdf.loc[raw_cols, raw_cols].round(2).to_string())
    # ---------------- slice scores & period means ----------------
    sc = pd.DataFrame(scores[:, :3], columns=['PC1','PC2','PC3'])
    sc['CE'] = CEarr
    sc['period'] = sc['CE'].map(per_map)
    print()
    print('Per-slice PC1/PC2 scores (range  all slices): PC1 %.2f..%.2f | PC2 %.2f..%.2f'
          % (sc['PC1'].min(), sc['PC1'].max(), sc['PC2'].min(), sc['PC2'].max()))
    print('Per-period mean of slice scores:')
    print(sc.groupby('period')[['PC1','PC2']].mean().round(2).to_string())
    print('PC2-score extremes (centuries, period):')
    srt = sc.sort_values('PC2')
    print('  most negative PC2:', [(int(r.CE), r.period, round(r.PC2,2)) for _,r in srt.head(4).iterrows()])
    print('  most positive PC2:', [(int(r.CE), r.period, round(r.PC2,2)) for _,r in srt.tail(4).iterrows()])
    # ---------------- per-variable PC2 projection spread ----------------
    print()
    print('Per-variable "distribution across PC2" (projection = PC2_loading * standardized value):')
    rows = []
    for j, v in enumerate(raw_cols):
        proj = load[j,1] * Xs[:,j]
        rows.append(dict(var=v, pc2_loading=load[j,1], pc2_corr=corr[j,1],
                         proj_range=proj.max()-proj.min(), proj_min=proj.min(), proj_max=proj.max(),
                         proj_IQR=np.percentile(proj,75)-np.percentile(proj,25),
                         proj_sd=proj.std(),
                         min_CE=int(CEarr[np.argmin(proj)]), max_CE=int(CEarr[np.argmax(proj)])))
    p2 = pd.DataFrame(rows).set_index('var')
    print(p2.round(3).to_string())
    # per-period mean of |PC2 projection| for the symbolic vars (density across bins)
    print()
    print('Per-period mean of |PC2 projection| for symbolic vars:')
    sym_rows = {v: {} for v in symbolic}
    for j, v in enumerate(raw_cols):
        if v in symbolic:
            proj = load[j,1] * Xs[:,j]
            for p in sc['period'].unique():
                sym_rows[v][p] = float(np.mean(np.abs(proj[sc['period']==p])))
    if sym_rows:
        print(pd.DataFrame(sym_rows).T.round(3).to_string())
    return df

# CE index arrays for the 37 and 39 versions

res37 = summarize(M37, CE37, '37-row matrix (CE -4100..-500), excluding 2 extra capital.csv rows')
print()
res39 = summarize(M39, CE39, '39-row matrix (BCE 4300..500), INCLUDING 2 extra earliest rows')

# ---------------- raw-Z covariance sensitivity (37) ----------------
print()
print('='*78)
load_r, evr_r = pca_rawcov(M37)
ldf = pd.DataFrame(load_r[:, :2], index=raw_cols, columns=['PC1_loading_rawZ','PC2_loading_rawZ'])
print('Sensitivity: raw-Z covariance PCA (no re-standardization) 37-row:')
print('  explained variance PC1..PC5:', np.round(evr_r[:5],3))
print(ldf.round(3).to_string())
print()
print('Loading shift for symbolic vars when including 2 extra rows (stdPCA loadings):')
for v in symbolic:
    print('  %-14s PC1: %s -> %s (d=%.3f) | PC2: %s -> %s (d=%.3f)' % (
        v, res37.loc[v,'PC1_loading'], res39.loc[v,'PC1_loading'], res39.loc[v,'PC1_loading']-res37.loc[v,'PC1_loading'],
        res37.loc[v,'PC2_loading'], res39.loc[v,'PC2_loading'], res39.loc[v,'PC2_loading']-res37.loc[v,'PC2_loading']))
print()
print('Per-column std (raw Z) across slices (37-row):')
print(pd.Series(M37.std(0), index=raw_cols).round(3).to_string())
