"""Full analysis: 3400-3000 BCE co-movement of monuments & axes with symbolic-capital elements.
Reports anchors (n=5) and interpolated (n=401) diagnostics side by side."""
import pandas as pd, numpy as np

TS = 'data/time_series_data.csv'
CAP = 'data/capital.csv'
POL = 'data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv'

def parse_comma_frame(path, num_cols):
    f = pd.read_csv(path)
    for c in num_cols:
        f[c] = pd.to_numeric(f[c].astype(str).str.replace(',', '.'), errors='coerce')
    return f

df = pd.read_csv(TS).sort_values('CE').reset_index(drop=True)
cap = pd.read_csv(CAP)
cap = parse_comma_frame(CAP, [c for c in cap.columns if c.startswith('Z')])
pol = parse_comma_frame(POL, ['MEAN','SMOOTH_MEAN_100y','SMOOTH_MEAN_250y',
                              'Belau_PC1','Woserin_PC1','Belau_PC1_inter','Woserin_PC1_inter',
                              'SMOOTH_MEAN_50y','SMOOTH_MEAN_150y','SMOOTH_MEAN_200y']).sort_values('CE').reset_index(drop=True)

W0, W1 = -3400, -3000
win = df[(df['CE'] >= W0) & (df['CE'] <= W1)].reset_index(drop=True)
anch = win[win['MonumentCount'].notna()].reset_index(drop=True)
pwin = pol[(pol['CE'] >= W0) & (pol['CE'] <= W1)].reset_index(drop=True)

pair_raw = {'Monument':'MonumentCount','Axes':'AxesCelts','HouseSize':'HouseSize',
            'HatchetSword':'HatchetSword','Dagger':'Dagger'}
pair_int = {'Monument':'MonumentCount_inter','Axes':'AxesCelts_inter','HouseSize':'HouseSize_inter',
            'HatchetSword':'HatchetSword_inter','Dagger':'Dagger_inter'}

print("="*78)
print("1) WINDOW RAW ANCHORS (effective sample n=5, 100-yr spacing)")
print("="*78)
print(anch[['CE','MonumentCount','AxesCelts','HouseSize','HatchetSword','Dagger']].to_string())

print("\n" + "="*78)
print("2) NET CHANGE & PEAK ALIGNMENT (anchors)")
print("="*78)
for c in ['MonumentCount','AxesCelts','HouseSize','HatchetSword','Dagger']:
    lo = anch[c].iloc[0]; hi = anch[c].iloc[-1]
    pkrow = anch.loc[anch[c].idxmax()]
    bce = int(-1*pkrow['CE'])
    gmax = "  [GLOBAL MAX of full 4100-500 BCE series]" if anch[c].max() == df[c].max() else ""
    print(f"{c:14s} {lo:+7.3f} -> {hi:+7.3f}  net={hi-lo:+7.3f}  peak={pkrow[c]:+.3f} at BCE {bce}{gmax}")

print("\nStep-to-step deltas (anchors, 4 transitions):")
d = anch[['CE','MonumentCount','AxesCelts','HouseSize','HatchetSword','Dagger']].diff()
print(d.round(3).to_string())

print("\n" + "="*78)
print("3) CORRELATIONS: anchors (n=5, Pearson/Spearman) vs interpolated (n=401)")
print("="*78)
pairs = [('Monument','Axes'),('Monument','HouseSize'),('Axes','HouseSize'),
         ('Monument','HatchetSword'),('Axes','HatchetSword'),('HouseSize','HatchetSword')]
for a,b in pairs:
    ra = anch[pair_raw[a]].corr(anch[pair_raw[b]])
    sa = anch[pair_raw[a]].corr(anch[pair_raw[b]], method='spearman')
    ri = win[pair_int[a]].corr(win[pair_int[b]])
    si = win[pair_int[a]].corr(win[pair_int[b]], method='spearman')
    print(f"{a:10s} x {b:10s} | anchor r={ra:+6.3f} rho={sa:+6.3f} | inter r={ri:+6.3f} rho={si:+6.3f}")
print("Dagger: zero variance over window -> correlation undefined on both series")

print("\n" + "="*78)
print("4) FRAGILITY: leave-one-out Pearson on the 5 anchors")
print("="*78)
for a,b in [('Monument','Axes'),('Monument','HouseSize'),('Axes','HouseSize')]:
    rs = []
    for i in range(len(anch)):
        sub = anch.drop(index=anch.index[i])
        rs.append(sub[pair_raw[a]].corr(sub[pair_raw[b]]))
    rfull = anch[pair_raw[a]].corr(anch[pair_raw[b]])
    print(f"{a} x {b}: full r={rfull:+.3f} | LOO values: " + ", ".join(f"{r:+.3f}" for r in rs))

print("\n" + "="*78)
print("5) REGRESSION SLOPE on anchors (MonumentCount/AxesCelts ~ HouseSize), n=5")
print("="*78)
for y in ['MonumentCount','AxesCelts']:
    X = anch['HouseSize'].values.astype(float); Y = anch[y].values.astype(float)
    b, a0 = np.polyfit(X, Y, 1)
    print(f"{y:14s} = {a0:+.3f} + {b:+.3f}*HouseSize   (slope {b:+.3f} per Z-unit of HouseSize)")

print("\n" + "="*78)
print("6) POLLEN / OPENNESS CONTEXT (not a primary predictor)")
print("="*78)
pj = pwin.set_index('CE')['MEAN']
m = win.set_index('CE')['MonumentCount_inter']; a_ = win.set_index('CE')['AxesCelts_inter']
h = win.set_index('CE')['HouseSize_inter']
print(f"openness MEAN: {pj.loc[-3400]:+.3f} -> {pj.loc[-3000]:+.3f}  (decline across window)")
print(f"HouseSize  vs openness: r={h.corr(pj):+.3f}   Monument vs openness: r={m.corr(pj):+.3f}   Axes vs openness: r={a_.corr(pj):+.3f}")

print("\n" + "="*78)
print("7) SCALE NOTE / VERIFICATION")
print("="*78)
mean_all = df[['MonumentCount','AxesCelts','HouseSize']].mean().round(3)
print("Full-series mean Z (MonumentCount, AxesCelts, HouseSize):", dict(mean_all))
print("Full max: AxesCelts=%.3f @ BCE %d; HouseSize=%.3f @ BCE %d" %
      (df['AxesCelts'].max(), int(-1*df.loc[df['AxesCelts'].idxmax(),'CE']),
       df['HouseSize'].max(), int(-1*df.loc[df['HouseSize'].idxmax(),'CE'])))
print("capital.csv cross-check (window anchors must be identical):")
cc = cap[(cap['BCE']>=3000)&(cap['BCE']<=3400)]
print(cc[['BCE','ZMonument','ZBeil','Zhausgr','ZAxtSchwert','ZDolch']].to_string())
