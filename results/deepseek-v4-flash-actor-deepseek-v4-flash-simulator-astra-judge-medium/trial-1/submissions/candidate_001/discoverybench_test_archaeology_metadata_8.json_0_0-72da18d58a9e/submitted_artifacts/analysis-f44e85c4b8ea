import pandas as pd, numpy as np

ts = pd.read_csv('data/time_series_data.csv')
cap = pd.read_csv('data/capital.csv')

ts['BCE'] = -ts['CE']
def millennium(BCE):
    for m in range(10, 0, -1):
        if 1000*m >= BCE >= 1000*(m-1)+1:
            return m
    return None
ts['millennium_BCE'] = ts['BCE'].apply(millennium)

print("="*72)
print("1) PER-MILLENNIUM annual interpolated amber Z (BCE standard blocks)")
g = ts.groupby('millennium_BCE')['Amber_inter'].agg(['max','mean','count'])
g.columns = ['max','mean','n_years']
print(g.to_string())
print()
print("Global max (annual Amber_inter):", ts['Amber_inter'].max())
print("Highest per-millennium MAX label:", g['max'].idxmax(), "(tied blocks if >1)")
print("Blocks attaining global max:", sorted(g.index[g['max']==g['max'].max()].tolist()))
print("Highest per-millennium MEAN:", g['mean'].idxmax(), "= %.4f" % g['mean'].max())

print()
print("="*72)
print("2) MAXIMUM PLATEAU (Amber_inter == 1.54) — full width")
mx = ts['Amber_inter'].max()
plateau = ts.loc[ts['Amber_inter']==mx, ['CE','BCE','calBP','millennium_BCE']]
print("rows at max:", len(plateau))
print("CE range:", plateau['CE'].min(), "..", plateau['CE'].max())
print("BCE range (descending):", plateau['BCE'].max(), "..", plateau['BCE'].min())
print("calBP range:", plateau['calBP'].max(), "..", plateau['calBP'].min())
print("Plateau years per millennium:")
print(plateau.groupby('millennium_BCE').size().to_string())
# also: how many plateau years strictly inside 4th millennium (BCE 4000-3001) vs other
print("Plateau years with BCE 3300..3001 (in 4th millennium):",
      ((plateau['BCE']<=3300)&(plateau['BCE']>=3001)).sum())
print("Plateau years with BCE 3000 (3rd-millennium first year):", (plateau['BCE']==3000).sum())

print()
print("="*72)
print("3) CROSS-CHECKS")
raw = ts.loc[ts['Amber'].notna(), ['CE','BCE','Amber']]
print("A) raw 37-knot Amber: max =", raw['Amber'].max(),
      "at BCE", sorted(raw.loc[raw['Amber']==raw['Amber'].max(),'BCE'].tolist(), reverse=True))
cap['Zamber_f'] = cap['Zamber'].astype(str).str.replace(',', '.').astype(float)
print("B) capital.csv Zamber (decimal-comma parsed): max =", cap['Zamber_f'].max(),
      "at BCE", sorted(cap.loc[cap['Zamber_f']==cap['Zamber_f'].max(),'BCE'].tolist(), reverse=True))
# series-level agreement on overlapping knots
ts_knots = raw.set_index('CE')['Amber']
cap_CE = -cap['BCE']
m = pd.DataFrame({'ts': ts_knots.reindex(cap_CE).values, 'cap': cap['Zamber_f'].values}, index=cap_CE).dropna()
print(f"   Overlap knots n={len(m)}; exact equal: {(m['ts']==m['cap']).sum()}; "
      f"max abs diff: {abs(m['ts']-m['cap']).max():.2e}")

print()
print("="*72)
print("4) ROBUSTNESS: rolling-mean windows (annual Amber_inter)")
for w in [100, 200]:
    s = ts['Amber_inter'].rolling(w, center=True, min_periods=1).mean()
    smax = s.max()
    run = ts.loc[np.isclose(s, smax, atol=1e-9), ['BCE']]
    print(f"   window={w}: max smoothed = {round(smax,4)}; "
          f"peak BCE {run['BCE'].max()} .. {run['BCE'].min()} (n={len(run)}); "
          f"all in 4th mill BCE? {bool((run['BCE']>=3001).all())}")
print()
print("Summary: amber Z max=1.54 plateau spans BCE 3300..3000; "
      "300 of 301 plateau years lie in 4th millennium BCE (4000-3001); "
      "4th millennium BCE has overall max 1.54 and highest mean 1.488; "
      "smoothed 100/200-yr peaks lie fully inside 4th millennium BCE.")
