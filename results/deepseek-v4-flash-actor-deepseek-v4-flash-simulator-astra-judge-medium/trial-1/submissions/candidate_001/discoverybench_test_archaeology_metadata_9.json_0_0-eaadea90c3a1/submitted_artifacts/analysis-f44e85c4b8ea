#!/usr/bin/env python3
import numpy as np
import pandas as pd
pd.set_option('display.width', 200)

def parse_decimal(s):
    return float(str(s).replace(',', '.'))

raw = pd.read_csv('data/capital.csv', dtype=str)
cap = pd.DataFrame({'BCE': raw['BCE'].astype(int), 'group': raw['group']})
cap_cols = ['ZAxtSchwert','ZDolch','Zhausgr','ZCU_AU','Zamber','ZMonument',
            'ZHort','ZSichel','ZBeil','ZMW','ZKeform','Zkeverz']
for c in cap_cols:
    cap[c] = raw[c].map(parse_decimal)
cap = cap.sort_values('BCE').reset_index(drop=True)

print('='*72)
print('PRIMARY DATA: capital.csv (raw century rows)')
print('='*72)
print(f'rows={len(cap)}  BCE {cap.BCE.min()}..{cap.BCE.max()}  step={np.unique(np.diff(cap.BCE))}')
print('NaNs:', int(cap[cap_cols].isna().sum().sum()))

print('\n-- per-component mean/std (39 centuries) --')
stats = cap[cap_cols].agg(['mean','std']).T
stats.columns = ['mean','std']
print(stats.to_string(float_format=lambda x: f'{x:.3f}'))
print('std range: %.3f .. %.3f' % (stats['std'].min(), stats['std'].max()))

SC_COLS = ['ZCU_AU','Zamber','ZMonument']
AL12_COLS = cap_cols
cap['SC'] = cap[SC_COLS].sum(axis=1)
cap['SC12'] = cap[AL12_COLS].sum(axis=1)

def century_label(bce_year):
    """Year Y BCE -> century = ceil(Y/100)th century BCE."""
    return int(np.ceil(bce_year / 100))

cap['century'] = cap['BCE'].map(century_label)

imax = cap['SC'].idxmax()
peak = cap.loc[imax]
print('\n-- Primary summed Social Capital (Cu&Au + Amber + MonCount) per century --')
print(cap[['BCE','century'] + SC_COLS + ['SC']].to_string(index=False,
      float_format=lambda x: f'{x:.3f}'))
print(f'\n==> PEAK: BCE {peak.BCE} -> {century_label(peak.BCE)}th century BCE ; SC = {peak.SC:.3f}')
print('    adjacent rows BCE %d (SC=%.3f) and BCE %d (SC=%.3f)' % (
    cap.BCE.iloc[imax-1], cap.SC.iloc[imax-1],
    cap.BCE.iloc[imax+1], cap.SC.iloc[imax+1]))
top5 = cap.nlargest(5, 'SC')[['BCE','century'] + SC_COLS + ['SC']]
print('\nTop-5 centuries by summed Social Capital:')
print(top5.to_string(index=False, float_format=lambda x: f'{x:.3f}'))

print('\n-- Component assessment at peak (BCE %d, %dth c. BCE) --' % (peak.BCE, century_label(peak.BCE)))
comp_rows = []
for c in SC_COLS:
    v_peak = cap.loc[imax, c]
    long_mean = cap[c].mean()
    prev = cap.loc[imax-1, c] if imax > 0 else np.nan
    comp_rows.append(dict(component=c, value_at_peak=v_peak, longrun_mean=long_mean,
                          value_prev_century=prev, local_change=v_peak - prev,
                          above_own_avg=(v_peak > long_mean),
                          record_high_here=(v_peak == cap[c].max())))
comp = pd.DataFrame(comp_rows)
print(comp.to_string(index=False, float_format=lambda x: f'{x:.3f}'))
print('\nincrease := above own long-run mean AND/OR positive local change:')
for _, r in comp.iterrows():
    flags = []
    if r.above_own_avg: flags.append('above own long-run mean')
    if r.local_change > 0: flags.append('rising vs prev century')
    if r.record_high_here: flags.append('AT RECORD HIGH')
    print(f'  {r.component:10s} peak={r.value_at_peak:+.3f} (mean {r.longrun_mean:+.3f}, '
          f'prev {r.value_prev_century:+.3f}, d {r.local_change:+.3f}) -> '
          + ('  '.join(flags) if flags else 'not elevated'))
print('  non-SC context at peak:')
for c in ['Zhausgr','ZHort','ZDolch','ZAxtSchwert','ZMW','Zkeverz']:
    print(f'    {c:11s} = {cap.loc[imax,c]:+.3f} (mean {cap[c].mean():+.3f})')
print('\nContributions to peak sum:')
for c in SC_COLS:
    print(f'  {c:10s}: {cap.loc[imax,c]:+.3f} / {peak.SC:.3f}')

ts = pd.read_csv('data/time_series_data.csv')
ts['BCE'] = -ts['CE']
ts['century'] = ts['BCE'].map(century_label)
ts['SC_inter'] = ts[['CopperGold_inter','Amber_inter','MonumentCount_inter']].sum(axis=1)
cent = ts.groupby('century').agg(
    CuAu=('CopperGold_inter','mean'), Amber=('Amber_inter','mean'),
    Mon=('MonumentCount_inter','mean'), SC=('SC_inter','mean'),
    n=('SC_inter','size')).reset_index()
imax_ts = cent['SC'].idxmax()
print('\n' + '='*72)
print('CROSS-CHECK: time_series *_inter, century means')
print('='*72)
print('Top-5 centuries (inter cross-check):')
print(cent.nlargest(5,'SC')[['century','CuAu','Amber','Mon','SC','n']].to_string(index=False,
      float_format=lambda x: f'{x:.3f}'))
print(f'\n==> inter-based peak: {int(cent.loc[imax_ts,"century"])}th c. BCE '
      f'(mean SC={cent.loc[imax_ts,"SC"]:.3f}, n={int(cent.loc[imax_ts,"n"])})')
best_c = int(cent.loc[imax_ts,'century'])
sub = ts[ts.century==best_c]
ib = sub['SC_inter'].idxmax()
print(f'    max summed-3 within that century at BCE {int(sub.loc[ib,"BCE"])}: '
      f'Cu&Au={sub.loc[ib,"CopperGold_inter"]:.3f} Amber={sub.loc[ib,"Amber_inter"]:.3f} '
      f'Mon={sub.loc[ib,"MonumentCount_inter"]:.3f}')

print('\n' + '='*72)
print('SENSITIVITY CHECKS')
print('='*72)
im12 = cap['SC12'].idxmax()
print(f'S1. All-12 sum: peak BCE {cap.loc[im12,"BCE"]} '
      f'({century_label(cap.loc[im12,"BCE"])}th c. BCE), SC12={cap.loc[im12,"SC12"]:.3f}')
print('    top-3 all-12:', [(int(cap.loc[i,"BCE"]), century_label(cap.loc[i,"BCE"]),
                             round(cap.loc[i,"SC12"],2)) for i in cap.nlargest(3,'SC12').index])
cap['SC_mean'] = cap[SC_COLS].mean(axis=1)
print(f'S2. 3-mean peak: BCE {cap.loc[cap.SC_mean.idxmax(),"BCE"]} '
      f'({century_label(cap.loc[cap.SC_mean.idxmax(),"BCE"])}th c. BCE), mean={cap.SC_mean.max():.3f}')

# Build hypothesis text
def flags_for(c):
    r = comp.loc[comp.component==c].iloc[0]
    parts = []
    if r.above_own_avg: parts.append('above its long-run mean')
    if r.local_change > 0: parts.append('rising vs preceding century')
    if r.record_high_here: parts.append('at its all-period record')
    return parts if parts else ['not elevated']

g = {c: flags_for(c) for c in SC_COLS}
hyp = (f'HYPOTHESIS: Summed social capital (ZCU_AU + Zamber + ZMonument) peaked in the '
       f'{century_label(peak.BCE)}th century BCE, centred on BCE {peak.BCE}-{peak.BCE-99} '
       f'(max at BCE {int(peak.BCE)}, sum={peak.SC:.2f} Z-units), with the adjacent century '
       f'(BCE {int(cap.BCE.iloc[imax-1])}/{int(cap.BCE.iloc[imax+1])}) nearly tied '
       f'({cap.SC.iloc[imax-1]:.2f}/{cap.SC.iloc[imax+1]:.2f}). Components at the peak:\n'
       f'  Copper&Gold (ZCU_AU) {cap.loc[imax,"ZCU_AU"]:+.2f}: '+' + '.join(g["ZCU_AU"])+f' (peak {int(cap.loc[cap.ZCU_AU.idxmax(),"BCE"])});\n'
       f'  MonumentCount (ZMonument) {cap.loc[imax,"ZMonument"]:+.2f}: '+' + '.join(g["ZMonument"])+f' (its max is BCE {int(cap.loc[cap.ZMonument.idxmax(),"BCE"])});\n'
       f'  Amber (Zamber) {cap.loc[imax,"Zamber"]:+.2f}: '+' + '.join(g["Zamber"])+f' (amber max is BCE {int(cap.loc[cap.Zamber.idxmax(),"BCE"])}).\n'
       f'Interpolated-1yr cross-check confirms {int(cent.loc[imax_ts,"century"])}th c. BCE. '
       f'Sensitivity all-12 sum peaks BCE {int(cap.loc[im12,"BCE"])} ({century_label(cap.loc[im12,"BCE"])}th c. BCE), '
       f'slightly later (late Bronze-Age dagger/depot/house-size surge), but the fixed 3-component '
       f'social-capital index peaks in the {century_label(peak.BCE)}th c. BCE.')
print('\n' + hyp)
cap.to_csv('social_capital_series.csv', index=False)
with open('analysis_summary.txt','w') as f:
    f.write(hyp + '\n\nPer-century primary series:\n')
    f.write(cap[['BCE','century','ZCU_AU','Zamber','ZMonument','SC','SC12']].to_string(
            index=False, float_format=lambda x: f'{x:.3f}'))
print('\nSaved: social_capital_series.csv, analysis_summary.txt')
