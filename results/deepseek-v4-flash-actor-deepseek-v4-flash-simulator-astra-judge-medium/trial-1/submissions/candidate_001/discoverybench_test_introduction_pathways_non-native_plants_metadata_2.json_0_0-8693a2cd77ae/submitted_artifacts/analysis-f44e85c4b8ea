def pgls(y):
    Vi=linv(V); XtV=X.T@Vi
    beta=lsolve(XtV@X,XtV@y)
    r=y-X@beta; sig=(r@Vi@r)/(nsp-2)
    cb=sig*linv(XtV@X); se=np.sqrt(np.diag(cb))
    tt=beta/se; pv=2*(1-stats.t.cdf(np.abs(tt[1]),nsp-2))
    Xo=X; bo=lsolve(Xo.T@Xo,Xo.T@y); ro=y-Xo@bo
    seo=np.sqrt(np.diag((ro@ro/(nsp-2))*linv(Xo.T@Xo)))
    to=bo[1]/seo[1]; pvo=2*(1-stats.t.cdf(abs(to),nsp-2))
    return beta,se,tt,pv,bo,to,pvo
