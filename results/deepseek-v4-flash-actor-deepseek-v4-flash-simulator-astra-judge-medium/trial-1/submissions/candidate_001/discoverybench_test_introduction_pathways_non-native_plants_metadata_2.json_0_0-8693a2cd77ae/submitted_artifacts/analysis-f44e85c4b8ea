def path_to_root(ni):
    # returns list of (node_id, cumulative distance from tip up to this node)
    out=[]; d=0.0; cur=ni; out.append((id(cur),d))
    while id(cur) in parent:
        cur=parent[id(cur)]; d+=cur['length'] if cur['length'] else 0.0
        out.append((id(cur),d))
    return out

def pair_pathend(ni,nj):
    pa=path_to_root(ni); pb=path_to_root(nj)
    dmap={i:d for i,d in pa}
    best=None
    for i,d in pb:
        if i in dmap:
            tot=dmap[i]+d
            if best is None or tot<best[0]: best=(tot,dmap[i],d)
    return best

