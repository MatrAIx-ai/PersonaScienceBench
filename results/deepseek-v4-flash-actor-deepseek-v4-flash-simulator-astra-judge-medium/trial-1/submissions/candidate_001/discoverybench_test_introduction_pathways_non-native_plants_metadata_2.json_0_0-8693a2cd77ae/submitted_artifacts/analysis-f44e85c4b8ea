def wilson(k, nn, z=1.96):
    if nn == 0: return (0.0, 1.0)
    p = k/nn; den = 1 + z*z/nn
    c = (p + z*z/(2*nn))/den
    h = z*np.sqrt(p*(1-p)/nn + z*z/(4*nn*nn))/den
    return (max(0.0, c-h), min(1.0, c+h))

def boot_ci(x, iters=10000, alpha=0.05):
    x = np.asarray(x, float)
    b = np.array([np.random.choice(x, len(x), replace=True).mean() for _ in range(iters)])
    return np.percentile(b, [100*alpha/2, 100*(1-alpha/2)])

