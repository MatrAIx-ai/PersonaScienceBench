def fit_adj(cols, label):
    f=("gard_present ~ "+" + ".join([c+"_z" for c in cols])+
       " + C(habitatR, Treatment(reference='%s'))"%ref)
    m=sm_glm(f,data=nz,family=Binomial()).fit()
    f_no=("gard_present ~ "+" + ".join([c+"_z" for c in cols]))
    mc=sm_glm(f_no,data=nz,family=Binomial()).fit()
    lr=2*(m.llf-mc.llf); df=m.df_model-mc.df_model
    print()
    print("%s" % label)
    print("  McFadden R2=%.3f (unadjusted %.3f)"%(1-m.llf/m.llnull, 1-logl_r2() if False else 1-logit.llf/logit.llnull))
    print("  LRT habitat effect given covariates: chi2=%.1f df=%d p=%.3g"%(lr,df,1-stats.chi2.cdf(lr,df)))
    hp=[i for i in m.pvalues.index if "habitatR" in i]
    print("  Wald p min=%.3g max=%.3g (habitat levels)"%(m.pvalues[hp].min(), m.pvalues[hp].max()))
    for c in [x+"_z" for x in cols]:
        print("    %-10s coef=%+.3f z=%+.2f p=%.3g"%(c,m.params[c],m.tvalues[c],m.pvalues[c]))
    marg={}
    for h in hab_order:
        dd=nz.copy(); dd["habitatR"]=pd.Categorical([h]*len(dd), categories=nz["habitatR"].cat.categories)
        marg[h]=m.predict(dd).mean()
    ms=pd.Series(marg).sort_values(ascending=False)
    print("  Adjusted marginal occupancy per habitat:")
    print("   ", ", ".join("%s %.2f"%(k,v) for k,v in ms.items()))
    return ms, m

