# ---------------- robust Newick tokenizer + parser -----------------
def tokenize(text):
    toks=[]; i=0; n=len(text)
    while i<n:
        c=text[i]
        if c in "(),;:":
            toks.append(c); i+=1
        elif c in " \t\n":
            i+=1
        elif c=='[':
            j=text.find(']',i); j=j if j!=-1 else n; i=j+1
        elif c.isdigit() or c=='.':
            j=i
            while j<n and (text[j].isdigit() or text[j] in '.eE+-'):
                j+=1
            try: toks.append(('num',float(text[i:j])))
            except: toks.append(('num',0.0))
            i=j
        else:
            j=i
            while j<n and text[j] not in "(),;:[ \t\n":
                j+=1
            toks.append(('name',text[i:j])); i=j
    return toks

class Parser:
    def __init__(self,toks): self.toks=toks; self.pos=0
    def peek(self): return self.toks[self.pos] if self.pos<len(self.toks) else None
    def nxt(self):
        x=self.toks[self.pos]; self.pos+=1; return x
    def subtree(self):
        node={'name':None,'children':[],'length':None}
        tk=self.peek()
        if tk=='(':
            self.nxt()
            while True:
                node['children'].append(self.subtree())
                x=self.nxt()
                if x==')': break
                # x is ','
            if isinstance(self.peek(),tuple) and self.peek()[0]=='name':
                node['name']=self.nxt()[1]
        elif isinstance(tk,tuple) and tk[0]=='name':
            node['name']=self.nxt()[1]
        if self.peek()==':':
            self.nxt()
            num=self.nxt()
            node['length']=num[1]
        return node

