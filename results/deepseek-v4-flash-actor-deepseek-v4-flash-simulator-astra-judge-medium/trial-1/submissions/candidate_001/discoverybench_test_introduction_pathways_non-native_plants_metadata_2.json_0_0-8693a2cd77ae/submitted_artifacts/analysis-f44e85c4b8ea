def moran_perm(r, lon, lat, iters=999, maxdist_km=50):
    r=np.asarray(r,float); x=np.asarray(lon,float); y=np.asarray(lat,float)
    m=len(r); W=np.zeros((m,m))
    for i in range(m):
        for j in range(i+1,m):
            d=np.hypot(x[i]-x[j],y[i]-y[j])/1000.0
            if 0<d<=maxdist_km:
                w=1.0/d; W[i,j]=W[j,i]=w
    Wn=W/W.sum(axis=1,keepdims=True)
    def calc(zz):
        z=zz-zz.mean(); den=(z**2).sum()
        if den==0: return np.nan
        return (m/Wn.sum())*(Wn*np.outer(z,z)).sum()/den
    obs=calc(r); cnt=0
    for _ in range(iters):
        if calc(np.random.permutation(r))>=obs: cnt+=1
    return obs,(cnt+1)/(iters+1)

logit = sm_glm("gard_present ~ C(habitatR, Treatment(reference='%s'))"%ref, data=n, family=Binomial()).fit()
Iu,pu = moran_perm(logit.resid_pearson, n["longitude"], n["latitude"])
print("MORAN'S I (inverse-distance 50km): unadjusted logit resid I=%.3f p=%.3f"%(Iu,pu))

