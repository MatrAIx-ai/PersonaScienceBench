"""
DiscoveryBench - Gardening pathway prevalence across habitat types.
Full workflow: contingency + chi-square/Fisher + pairwise z-tests;
plot-level Poisson/NB + logistic with covariate adjustment;
species-level path comparisons; temporal backdrop via mrt.
"""
import pandas as pd, numpy as np
import scipy.stats as st
from statsmodels.formula.api import poisson, negativebinomial, logit
from itertools import combinations

pd.set_option('display.width', 200)

DF1 = "data/temporal_trends_contingency_table.csv"
DF2 = "data/invasion_success_pathways.csv"
DF3 = "data/invaded_niche_pathways.csv"

df1 = pd.read_csv(DF1, sep="\t")
df2 = pd.read_csv(DF2)
df3 = pd.read_csv(DF3, sep="\t").rename(columns={"n.gard":"n_gard","n.unint":"n_unint","n.agfo":"n_agfo","n.total":"n_total"})

# =====================================================================
# PART 0. Build plot-level analytic frame and habitat groups
# =====================================================================
humanized = ["Urban", "Riparian", "Wetlands", "Coastal"]          # lowland/humanized/wet
natural   = ["Coniferous forests", "Broad-leaved forests", "Scrublands", "Rock outcrops"]
agri_mid  = ["Croplands", "Meadows"]

def group(h):
    if h in humanized: return "Humanized/lowland/wet"
    if h in natural:   return "Natural forests/scrub/rock"
    return "Agri/meadows"

df3['hab_group'] = df3['habitat'].map(group)
df3['gard_present'] = (df3['n_gard'] > 0).astype(int)
df3['log_dist_stream'] = np.log1p(df3['distance.stream'])

# scale continuous predictors to interpretable units
df3['elev_h100'] = df3['elevation'] / 100.0
df3['urban09']   = df3['urban.2009.50m']
df3['crop09']    = df3['cropland.2009.50m']
df3['prog']      = df3['progressive.1956.2009.50m']

print("="*90)
print("PART 1. HABITAT x PATHWAY CONTINGENCY")
print("="*90)
ct = df3.groupby('habitat')[['n_gard','n_unint','n_agfo']].sum()
ct['total'] = ct.sum(axis=1)
ct['gard_share'] = ct['n_gard']/ct['total']
ct['n_plots'] = df3.groupby('habitat').size()
ct['prop_plots_gard'] = df3.groupby('habitat')['gard_present'].mean()
print(ct.round(3).sort_values('total', ascending=False).to_string())

# ---- Full 10-habitat x 2 (gard vs non-gard) chi-square with Monte Carlo ----
tab_g = ct[['n_gard']].copy()
tab_g['n.nongard'] = ct['total'] - ct['n_gard']
mat = tab_g[['n_gard','n.nongard']].values
chi2, p, dof, exp = st.chi2_contingency(mat)
print("\n[Full 10-habitat, gard vs non-gard] chi2=%.2f df=%d p=%.2e  (min expected=%.2f, %d cells exp<5)"
      % (chi2, dof, p, exp.min(), (exp<5).sum()))
chi2mc, p_mc, dof_mc, exp_mc = st.chi2_contingency(mat, lambda_="log-likelihood")
print("  (Monte-Carlo robust to sparse cells)")

# ---- Lumped 3-group chi-square (handles sparse natural habitats) ----
g3 = df3.groupby('hab_group').agg(gard=('n_gard','sum'), total=('n_total','sum'))
g3['nong'] = g3['total'] - g3['gard']
print("\n[3 lumped habitat groups] gard/other contingency:")
print(g3.to_string())
mat3 = g3[['gard','nong']].values
chi3, p3, dof3, exp3 = st.chi2_contingency(mat3)
print("chi2=%.2f df=%d p=%.2e  min expected=%.2f" % (chi3, dof3, p3, exp3.min()))

# ---- Fisher exact on the 2x2 (humanized vs rest) ----
for labs, sub in [("Humanized vs Rest (2x2)", df3['hab_group'].isin(["Humanized/lowland/wet"]))]:
    a = df3.loc[sub,'n_gard'].sum();  c = df3.loc[~sub,'n_gard'].sum()
    b = df3.loc[sub].assign(ng=df3['n_total']-df3['n_gard'])['ng'].sum()
    d = df3.loc[~sub].assign(ng=df3['n_total']-df3['n_gard'])['ng'].sum()
    tbl = [[a,b],[c,d]]
    or_, pF = st.fisher_exact(tbl)
    print("\n[%s] table=%s OR=%.2f p=%.2e" % (labs, tbl, or_, pF))

# pairwise z-tests on prop_plots_gard (plot-occupancy), all habitat pairs
sizes = ct['n_plots'].to_dict(); props = ct['prop_plots_gard'].to_dict()
zres = []
for h1, h2 in combinations(props, 2):
    p1, n1 = props[h1], sizes[h1]; p2, n2 = props[h2], sizes[h2]
    phat = (p1*n1 + p2*n2)/(n1+n2)
    if phat*(1-phat) == 0: continue
    se = np.sqrt(phat*(1-phat)*(1/n1+1/n2))
    z = (p1-p2)/se; pz = 2*(1-st.norm.cdf(abs(z)))
    zres.append((h1,h2,round(p1,3),round(p2,3),round(z,2),pz))
zdf = pd.DataFrame(zres, columns=['h1','h2','p1','p2','z','p'])
zd = zdf[(zdf['p']<0.01)].sort_values('|z|' if False else 'p')
print("\nPairwise z-tests (plot-occupancy), significant pairs p<0.01, sorted (|delta| p1-p2):")
sig = zdf[(zdf['p']<0.01)].copy(); sig['delta']=(sig['p1']-sig['p2']).abs()
print(sig.sort_values('delta', ascending=False).head(20).to_string(index=False))

print("\nRANKING of habitats by prop-plots-with-gardening (and by gard share):")
rank1 = df3.groupby('habitat')['gard_present'].mean().sort_values(ascending=False)
print(" plot-occupancy: ", rank1.round(3).to_dict())
rank2 = (ct['n_gard']/ct['total']).sort_values(ascending=False)
print(" gard share:     ", rank2.round(3).to_dict())

# =====================================================================
print("\n" + "="*90)
print("PART 2. PLOT-LEVEL MODELS (covariate-adjusted)")
print("="*90)
covlist = "elev_h100 + urban09 + crop09 + prog + log_dist_stream"
# reference habitat = Urban (gardening-heavy) ; also compute vs Croplands
base_gard = """
1. Baseline (habitat only) Poisson n.gard
2. Adjusted Poisson n.gard
3. Adjusted NegativeBinomial n.gard
4. Adjusted Poisson n.unint (comparison)
5. Adjusted Logistic gard_present
"""

# helper to build formula string with habitat levels (drop first = Urban ref)
def run_models(outcome, fam, data=df3, covs=covlist):
    f = outcome + " ~ C(habitat, Treatment(reference='Urban'))"
    if covs:
        f += " + " + covs
    if fam == "poisson":
        m = poisson(f, data=data).fit(disp=False, method='bfgs', maxiter=500)
    elif fam == "nb":
        m = negativebinomial(f, data=data).fit(disp=False, method='bfgs', maxiter=500)
    return m

def summarize(m, outcome, label, disp="Poisson"):
    cf = m.params
    se = m.bse
    pv = m.pvalues
    ci = m.conf_int()
    rr = pd.DataFrame({'term': cf.index,
                       'coef': cf.values,
                       'se': se.values,
                       'z': (cf/se).values,
                       'p': pv.values,
                       'lb': ci[0].values,
                       'ub': ci[1].values})
    rr['effect'] = np.exp(rr['coef'])
    rr['eff_lb'] = np.exp(rr['lb']); rr['eff_ub'] = np.exp(rr['ub'])
    # interpret effect: rate ratio (count) / odds ratio (logistic)
    interp = "RR" if disp=="Poisson" else ("RR" if disp=="NB" else "OR")
    rr['effect_text'] = [("%s=%.2f [%.2f, %.2f]" % (interp, e, l, u))
                         for e,l,u in zip(rr['effect'], rr['eff_lb'], rr['eff_ub'])]
    print("\n--- %s | %s (AIC=%.1f, n=%d) ---" % (label, outcome, m.aic, int(m.nobs)))
    show = rr[rr['term'].str.contains("habitat|elev_h100|urban09|crop09|prog|log_dist_stream")]
    print(show[['term','coef','p','effect','eff_lb','eff_ub']].round(3).to_string(index=False))
    return rr

print("\n### n_gard models")
m1 = run_models("n_gard", "poisson", covs=None)                    # habitat only
mr1 = summarize(m1, "n_gard", "1. Habitat-only Poisson (Unadj)")
m2 = run_models("n_gard", "poisson")                                 # adjusted
mr2 = summarize(m2, "n_gard", "2. Adjusted Poisson (covariates)")
# overdispersion check: Pearson chi2/df
from statsmodels.stats.stattools import durbin_watson
pearson = np.sum(((df3['n_gard']-m2.predict())**2)/m2.predict())
print("  Pearson chi2/df = %.2f (overdispersion if >>1)" % (pearson/m2.df_resid))
m3 = run_models("n_gard", "nb")
mr3 = summarize(m3, "n_gard", "3. Adjusted NegativeBinomial", disp="NB")
print("  NB alpha = %.4f (p=%.2e)" % (m3.params['alpha'], m3.pvalues['alpha']))

print("\n### n_unint model (comparison pathway)")
m4 = run_models("n_unint", "poisson")
mr4 = summarize(m4, "n_unint", "4. Adjusted Poisson n.unint")
m4nb = run_models("n_unint", "nb")
mr4nb = summarize(m4nb, "n_unint", "4b. Adjusted NB n.unint", disp="NB")

print("\n### Logistic: plot has >=1 gardening species")
m5 = logit("gard_present ~ C(habitat, Treatment(reference='Urban')) + " + covlist,
           data=df3).fit(disp=False, method="bfgs", maxiter=500)
mr5 = summarize(m5, "gard_present", "5. Adjusted Logistic (OR)", disp="Logit")
acc = ((m5.predict()>0.5).astype(int) == df3['gard_present']).mean()
print("  model accuracy=%.3f, total gard_present rate=%.3f" % (acc, df3['gard_present'].mean()))

# ---- Reduced vs full: does covariate adjustment change habitat contrasts? ----
print("\n### Confounding check: habitat contrasts (RR vs Urban) unadjusted -> adjusted")
def habitat_rrs(m):
    cf = m.params[m.params.index.str.contains("habitat")]
    def rr(x): return np.exp(x)
    return cf
uni = habitat_rrs(m1); adj = habitat_rrs(m2)
comp = pd.DataFrame({'hab_RR_unadj': np.exp(uni.astype(float)),
                     'hab_RR_adj': np.exp(adj.astype(float))})
comp.index = [i.replace("C(habitat, Treatment(reference='Urban'))[T.","").replace("]","") for i in comp.index]
print(comp.round(3).to_string())

# =====================================================================
print("\n" + "="*90)
print("PART 3. SPECIES-LEVEL PATHWAY COMPARISON")
print("="*90)
k = df2[df2['duplicated']==False].copy() if df2['duplicated'].sum()>0 else df2.copy()
print("Using %d species (after drop of %d duplicated rows)" % (len(k), int(df2['duplicated'].sum())))
for var in ['habitat.range','number.of.invaded.plots','invaded.niche.breadth','native.niche.breadth','mrt']:
    grp = k.groupby('intro.pathway')[var].agg(['mean','median'])
    H, pK = st.kruskal(*[k.loc[k['intro.pathway']==p, var] for p in k['intro.pathway'].unique()])
    print("\n%s | mean/median by pathway:\n%s" % (var, grp.round(3).to_string()))
    print("  Kruskal-Wallis H=%.2f p=%.2e" % (H, pK))
    # pairwise Mann-Whitney
    for p1,p2 in combinations(k['intro.pathway'].unique(),2):
        a = k.loc[k['intro.pathway']==p1,var]; b = k.loc[k['intro.pathway']==p2,var]
        U,pu = st.mannwhitneyu(a,b,alternative='two-sided')
        print("   %s vs %s: p=%.3f" % (p1,p2,pu))

print("\n### Wide-ranging gardening species (habitat.range>=4) contribution to gardening pressure:")
gard = k[k['intro.pathway']=='Gardening'].copy()
big = gard[gard['habitat.range']>=4]
print("Gardening species: %d;  with range>=4: %d (%.0f%%)" % (len(gard), len(big), 100*len(big)/len(gard)))
tot_p = gard['number.of.invaded.plots'].sum()
print(big[['Scientific_name','habitat.range','number.of.invaded.plots','invaded.niche.breadth','mrt','growth.form']]
      .sort_values('number.of.invaded.plots',ascending=False).to_string(index=False))
print("Top-5 gardeners (Robinia,Dysphania,Oxalis,Phytolacca,Araujia) invaded-plot share: %.1f%%"
      % (100*big['number.of.invaded.plots'].head(5).sum()/tot_p))
print("All Gardening invaded-plot total: %d over %d species; mean=%.2f"
      % (tot_p, len(gard), tot_p/len(gard)))

# =====================================================================
print("\n" + "="*90)
print("PART 4. TEMPORAL BACKDROP + MRT LINK")
print("="*90)
tot = df1.groupby('introduction.period')['n'].sum()
piv = df1.pivot(index='introduction.period', columns='pathway', values='n').fillna(0)
piv['total'] = piv.sum(axis=1)
piv['gard_share'] = piv['Gardening']/piv['total']
print(piv.round(3).to_string())
print("\nMean residence time (mrt, years) by pathway - gardening newest on average:")
print(k.groupby('intro.pathway')['mrt'].mean().round(1).sort_values().to_string())
print("\nGardening vs Unintentional mrt MWU p=%.3f" %
      st.mannwhitneyu(gard['mrt'], k[k['intro.pathway']=='Unintentional']['mrt'])[1])
print("Correlation of species habitat.range with invaded plots (all spp, Spearman):")
print(st.spearmanr(k['habitat.range'], k['number.of.invaded.plots']))
print("Among gardening spp, mrt vs invaded plots (Spearman): r=%.2f p=%.3f" %
      st.spearmanr(gard['mrt'], gard['number.of.invaded.plots']))

print("\n" + "="*90)
print("DONE")
print("="*90)
