#!/usr/bin/env python3
"""Full analysis: urban land use and pathway-specific plant invasion (Catalonia/Barcelona).
Executed at plan-approval. Produces results tables under results/ and prints a summary.
"""
import pandas as pd, numpy as np, re, warnings, json, os
import statsmodels.api as sm
from statsmodels.formula.api import negativebinomial
warnings.filterwarnings('ignore')

OUT = '/workspace/results'
os.makedirs(OUT, exist_ok=True)

def load(f, sep='auto'):
    if sep=='auto':
        first = open(f).readline()
        sep = '\t' if '\t' in first else ','
    return pd.read_csv(f, sep=sep)

# ---------------- load ----------------
D = {}  # raw names
D['trend']  = load('data/temporal_trends_contingency_table.csv')
D['sp']     = load('data/invasion_success_pathways.csv')
D['plot']   = load('data/invaded_niche_pathways.csv')

d = D['plot'].copy()
d = d.rename(columns={c: re.sub(r'[^A-Za-z0-9_]','_',c) for c in d.columns})
for c in list(d.columns):
    if d[c].dtype.kind in 'fi':
        d[c+'_z'] = (d[c]-d[c].mean())/d[c].std()
d['longitude_z2']=d['longitude_z']**2
d['latitude_z2']=d['latitude_z']**2

COVS = ['elevation_z','cropland_2009_1000m_z','annual_temperature','annual_rainfall',
        'annual_radiation','distance_road','distance_stream']
COV_STR = ' + '.join(COVS)
RESPS = ['n_gard','n_unint','n_agfo','n_total']

def fit_nb(formula_str, data):
    m = negativebinomial(formula_str + f' + {COV_STR}', data).fit(disp=0)
    return m

def coef_row(m, term):
    return dict(term=term, coef=float(m.params[term]), se=float(m.bse[term]),
                p=float(m.pvalues[term]), rr=np.exp(float(m.params[term])))

# ---------------- (a) PRIMARY MODEL: urban 2009 1000m & 500m ----------------
primary_rows = []
for buf in ['500m','1000m']:
    term_u = f'urban_2009_{buf}_z'
    for resp in RESPS:
        m = fit_nb(f'{resp} ~ {term_u}', d)
        r = coef_row(m, term_u); r.update(response=resp, urban=term_u.replace('_z',''), n=len(d))
        primary_rows.append(r)
prim = pd.DataFrame(primary_rows)
prim.to_csv(f'{OUT}/primary_urban2009_models.csv', index=False)
print('=== PRIMARY MODELS: pathway count ~ urban2009<buffer> + covariates (NB2) ===')
print(prim[['response','urban','coef','se','p','rr']].to_string(index=False))
print()

# ---------------- (b) SHARE / OFFSET MODELS (composition given total richness) ----------------
di = d[d['n_total']>0].copy()
share_rows = []
for buf in ['500m','1000m']:
    term_u = f'urban_2009_{buf}_z'
    for resp in ['n_gard','n_unint','n_agfo']:
        f = f'{resp} ~ {term_u} + {COV_STR}'
        mp = sm.formula.glm(f, di, family=sm.families.Poisson(), exposure=di['n_total'].values).fit()
        share_rows.append(dict(response=resp, urban=term_u.replace('_z',''), fam='Poisson+offset(total)',
                               coef=float(mp.params[term_u]), se=float(mp.bse[term_u]), p=float(mp.pvalues[term_u])))
share = pd.DataFrame(share_rows)
share.to_csv(f'{OUT}/share_offset_models.csv', index=False)
print('=== SHARE (offset=log total, invaded plots n=%d): does urban shift composition toward a pathway? ===' % len(di))
print(share[['response','urban','coef','se','p']].to_string(index=False))
print()
# mean observed shares, high vs low urban quartile
q_hi = di[di['urban_2009_1000m'] >= di['urban_2009_1000m'].quantile(0.75)]
q_lo = di[di['urban_2009_1000m'] <= di['urban_2009_1000m'].quantile(0.25)]
def shares(df):
    t = df['n_total'].sum()
    return {r: float(df[r].sum()/t) for r in ['n_gard','n_unint','n_agfo']}
print('mean share (of invaded spp) in Q1(low urban) vs Q4(high urban), urban2009.1000m:')
print('  low :', {k: round(v,3) for k,v in shares(q_lo).items()})
print('  high:', {k: round(v,3) for k,v in shares(q_hi).items()})
print()

# ---------------- (c) HABITAT INTERACTION + spatial robustness ----------------
print('=== HABITAT SCENARIO: per-habitat urban effect (subset NB2, urban2009.1000m) ===')
hab_rows=[]
for resp in ['n_unint','n_total','n_gard']:
    for hab in sorted(d['habitat'].unique()):
        sub = d[d['habitat']==hab]
        if sub[resp].sum()==0 or sub['n_total'].sum()==0:
            hab_rows.append(dict(response=resp, habitat=hab, n=len(sub), coef=np.nan, p=np.nan, note='zero-count'))
            continue
        try:
            m = negativebinomial(f'{resp} ~ urban_2009_1000m_z + {COV_STR}', sub).fit(disp=0, maxiter=60)
            hab_rows.append(dict(response=resp, habitat=hab, n=len(sub),
                                 coef=float(m.params['urban_2009_1000m_z']), p=float(m.pvalues['urban_2009_1000m_z']), note=''))
        except Exception as e:
            try:
                mp = sm.formula.glm(f'{resp} ~ urban_2009_1000m_z + {COV_STR}', sub, family=sm.families.Poisson()).fit()
                hab_rows.append(dict(response=resp, habitat=hab, n=len(sub),
                                     coef=float(mp.params['urban_2009_1000m_z']), p=float(mp.pvalues['urban_2009_1000m_z']), note='poisson'))
            except Exception as e2:
                hab_rows.append(dict(response=resp, habitat=hab, n=len(sub), coef=np.nan, p=np.nan, note=str(e2)[:30]))
habitab=pd.DataFrame(hab_rows)
habitab.to_csv(f'{OUT}/habitat_per_subset.csv', index=False)
for resp in ['n_unint','n_gard','n_total']:
    sub=habitab[habitab.response==resp]
    print(f' {resp}: ' + '  '.join(f'{r.habitat[:6]}={r.coef:+.2f}({r.p:.2f})' for r in sub.itertuples()))
print()
print('=== Full habitat-interaction model (Poisson fallback) for n_unint ===')
mhi = sm.formula.glm(f'n_unint ~ urban_2009_1000m_z * C(habitat) + {COV_STR}', d, family=sm.families.Poisson()).fit()
print(' main urban b=%+.3f p=%.3f' % (mhi.params['urban_2009_1000m_z'], mhi.pvalues['urban_2009_1000m_z']))
for t in mhi.params.index:
    if 'urban_2009_1000m_z:C' in t:
        lab=t.replace('C(habitat)[T.','').replace(']','')
        print('   x%-20s b=%+.3f p=%.3f' % (lab, mhi.params[t], mhi.pvalues[t]))
print()

print()
print('=== Spatial robustness: add longitude+latitude (and quadratics) to n_unint primary ===')
sp_rows=[]
for extra in ['', ' + longitude_z + latitude_z', ' + longitude_z + latitude_z + longitude_z2 + latitude_z2']:
    f = f'n_unint ~ urban_2009_1000m_z + {COV_STR}{extra}'
    m = negativebinomial(f, d).fit(disp=0)
    sp_rows.append([extra or 'baseline', round(m.params['urban_2009_1000m_z'],3), round(m.pvalues['urban_2009_1000m_z'],4)])
print(pd.DataFrame(sp_rows, columns=['spatial_terms','urban_coef','p']).to_string(index=False))
print()

# ---------------- (d) 3x3 YEAR x BUFFER GRID (robustness) ----------------
grid_rows=[]
for resp in RESPS:
    for y in ['1956','1993','2009']:
        for b in ['50m','500m','1000m']:
            u=f'urban_{y}_{b}_z'
            m = negativebinomial(f'{resp} ~ {u} + {COV_STR}', d).fit(disp=0)
            grid_rows.append(dict(response=resp, year=y, buffer=b, coef=float(m.params[u]),
                                  se=float(m.bse[u]), p=float(m.pvalues[u])))
grid = pd.DataFrame(grid_rows)
grid.to_csv(f'{OUT}/grid_year_buffer.csv', index=False)
print('=== 3x3 YEAR x BUFFER GRID (NB2, covariates) — coef (p) ===')
for resp in RESPS:
    piv = grid[grid.response==resp].pivot(index='year', columns='buffer', values='coef')
    pv  = grid[grid.response==resp].pivot(index='year', columns='buffer', values='p')
    print(f' {resp}')
    for y in ['1956','1993','2009']:
        print('   '+y, '  '.join(f'{piv.loc[y,b]:+.2f}({pv.loc[y,b]:.2f})' for b in ['50m','500m','1000m']))
print()

# ---------------- (e) SPECIES-LEVEL TRAIT CHARACTERIZATION ----------------
sp = D['sp'].copy()
num = ['number.of.invaded.plots','area.of.occupancy.10km','habitat.range',
       'invaded.niche.breadth','native.niche.breadth','mrt','height']
g = sp.groupby('intro.pathway')[num].mean()
g.to_csv(f'{OUT}/species_traits_by_pathway.csv')
print('=== SPECIES-LEVEL: trait means by pathway (Kruskal-Wallis p) ===')
from scipy.stats import kruskal
print(g.round(2).to_string())
kw = {c: round(kruskal(*[sp.loc[sp['intro.pathway']==k,c] for k in sp['intro.pathway'].unique()]).pvalue,4) for c in num}
kw_df=pd.DataFrame([kw],index=['KW_p']).T; kw_df.to_csv(f'{OUT}/species_kw_test.csv')
print('KW p-values:', kw)
print()
ct = pd.concat([
    pd.crosstab(sp['intro.pathway'], sp['growth.form']).assign(var='growth.form'),
    pd.crosstab(sp['intro.pathway'], sp['vegetative']).assign(var='vegetative'),
    pd.crosstab(sp['intro.pathway'], sp['dispersal']).assign(var='dispersal'),
])
ct.to_csv(f'{OUT}/species_crosstabs_by_pathway.csv')
print('crosstabs growth.form/vegetative/dispersal saved.')

# temporal context
tr = D['trend'].pivot_table(index='introduction.period', columns='pathway', values='n')
tr['total']=tr.sum(axis=1)
share_t = (tr.div(tr['total'],axis=0)*100).round(1)
share_t.to_csv(f'{OUT}/temporal_trend_shares.csv')
print()
print('=== TEMPORAL CONTEXT: pathway share of introductions by period ===')
print(share_t.to_string())

# summary json
summary = {
 'n_plots': int(len(d)), 'n_invaded_plots': int((d['n_total']>0).sum()),
 'primary_urban2009_1000m': {r: dict(coef=float(prim[(prim.response==r)&(prim.urban=='urban_2009_1000m')].coef.iloc[0]),
                                     p=float(prim[(prim.response==r)&(prim.urban=='urban_2009_1000m')].p.iloc[0]))
                             for r in RESPS},
 'share_urban2009_1000m': {r: dict(coef=float(share[(share.response==r)&(share.urban=='urban_2009_1000m')].coef.iloc[0]),
                                   p=float(share[(share.response==r)&(share.urban=='urban_2009_1000m')].p.iloc[0]))
                           for r in ['n_gard','n_unint','n_agfo']},
 'spatial_robust_unint': sp_rows,
}
json.dump(summary, open(f'{OUT}/summary.json','w'), indent=2)
print()
print('Saved all tables to', OUT)
