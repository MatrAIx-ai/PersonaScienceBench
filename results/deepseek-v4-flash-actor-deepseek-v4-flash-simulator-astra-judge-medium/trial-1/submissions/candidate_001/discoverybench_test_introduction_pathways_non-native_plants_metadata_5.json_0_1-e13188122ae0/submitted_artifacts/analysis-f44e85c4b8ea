# -*- coding: utf-8 -*-
"""
Analysis: Which types of plant introductions were influenced by urban land use?

Plot-level (n = 632) analysis of non-native plant introductions by introduction
pathway (Gardening / Unintentional / AgriForest / All) against urban land cover
(2009) and 1956-2009 urbanization (delta) in Barcelona province, with a 50 m
local sensitivity check, zero-inflation handling, a habitat 'bad-control'
diagnostic, and temporal corroboration from the introduction trend table.

Public submission contract (DiscoveryBench): data-grounded hypothesis.
"""
import numpy as np
import pandas as pd
import scipy.stats as st
import statsmodels.api as sm
from statsmodels.discrete.count_model import ZeroInflatedNegativeBinomialP
from numpy.linalg import LinAlgError
import warnings
warnings.filterwarnings('ignore')

DATA = '../data/invaded_niche_pathways.csv'
TREND = '../data/temporal_trends_contingency_table.csv'
inp = pd.read_csv(DATA, sep='\t')
trend = pd.read_csv(TREND, sep='\t')
n = len(inp)

# ---------- derived exposure variables ----------
inp['u.1000'] = inp['urban.2009.1000m'].values
inp['d.1000'] = inp['urban.2009.1000m'] - inp['urban.1956.1000m']
inp['u.50']   = inp['urban.2009.50m'].values
inp['d.50']   = inp['urban.2009.50m'] - inp['urban.1956.50m']

outcomes = {k: inp[k].values for k in ['n.total','n.gard','n.unint','n.agfo']}
presence = {k: (v > 0).astype(int) for k, v in outcomes.items()}

COV = ['cropland.2009.1000m','elevation','distance.road','distance.stream',
       'annual.temperature','annual.rainfall','annual.radiation']

def design(u_series, d_series, mode, with_habitat=False, include_coords=False):
    """mode: 'u' only urban2009; 'd' only delta; 'both' both (collinear, joint)."""
    X = pd.DataFrame({'intercept': np.ones(n)})
    if mode in ('u','both'): X['urban2009'] = u_series.values
    if mode in ('d','both'): X['du1956_2009'] = d_series.values
    covs = list(COV)
    if include_coords: covs += ['longitude','latitude']
    for c in covs:
        v = inp[c].values.astype(float); X[c] = (v - v.mean())/v.std()
    if with_habitat:
        hab = pd.get_dummies(inp['habitat'], drop_first=True, prefix='hab').astype(float)
        X = pd.concat([X.reset_index(drop=True), hab.reset_index(drop=True)], axis=1)
    return X

def firth_logit(y, Xarr, maxiter=300, tol=1e-9):
    """Bias-reduced (penalized) logistic, robust to separation (logistf-style, Jeffreys prior)."""
    beta = np.zeros(Xarr.shape[1]); XWX_inv = None; conv = False
    for it in range(maxiter):
        lp = np.clip(Xarr @ beta, -35, 35)
        p = 1/(1+np.exp(-lp))
        W = p*(1-p)
        XWX = (Xarr.T * W) @ Xarr
        try: XWX_inv = np.linalg.inv(XWX)
        except LinAlgError: XWX_inv = np.linalg.pinv(XWX)
        Wsq = np.sqrt(W)
        H = (Xarr*Wsq[:,None]) @ XWX_inv @ (Xarr*Wsq[:,None]).T
        h = np.diag(H)
        step = XWX_inv @ (Xarr.T @ (y - p + h*(0.5 - p)))
        beta_new = beta + step
        if np.max(np.abs(step)) < tol:
            beta, conv = beta_new, True; break
        beta = beta_new
    return beta, np.sqrt(np.diag(XWX_inv)), conv, it+1

def logit_models(y, u, d, mode, label, with_habitat=False, include_coords=False):
    X = design(u, d, mode, with_habitat, include_coords)
    if with_habitat:
        b, se, conv, it = firth_logit(y, X.values.astype(float))
        out = {'method':'Firth','conv':conv,'iter':it,'n':len(y)}
    else:
        m = sm.Logit(y, X.astype(float)).fit(disp=False, maxiter=400)
        b, se = m.params.values, m.bse.values
        out = {'method':'MLE','conv':m.mle_retvals['converged'],'iter':-1,'n':len(y),'llf':m.llf,'pr2':m.prsquared}
    names = X.columns
    out['label'] = label
    for vn, vlab in [('urban2009','OR_urban2009'),('du1956_2009','OR_du')]:
        if vn in names:
            ix = list(names).index(vn)
            out[vlab]=np.exp(b[ix]); out['lo_'+vlab]=np.exp(b[ix]-1.96*se[ix]); out['hi_'+vlab]=np.exp(b[ix]+1.96*se[ix])
            out['z'+vlab[2:]]=b[ix]/se[ix]; out['p'+vlab[2:]]=2*st.norm.sf(abs(b[ix]/se[ix]))
    return out

rows = []

# =====================================================================
print('='*112)
print('SECTION 1. TEMPORAL CORROBORATION  (introduction.period x pathway, 1046 intro events)')
print('='*112)
piv = trend.pivot(index='introduction.period', columns='pathway', values='n').fillna(0)
share = piv.div(piv.sum(axis=1), axis=0)*100
print('\nPathway share (%) of introductions per period:')
print(share.round(1).to_string())
ct = pd.crosstab(trend['introduction.period'], trend['pathway'], values=trend['n'], aggfunc='sum')
chi2, pchi, dof, exp = st.chi2_contingency(ct)
resid = (ct-exp)/np.sqrt(exp)
print('\nChi-square test of pathway-period independence: chi2=%.1f, df=%d, p=%.1e' % (chi2, dof, pchi))
print('Standardized residuals (|r|>2 drives the association):')
print(resid.round(1).to_string())
print('\nReading: Gardening exploded in the 1985-2019 urbanization era (75.2% share, resid +5.0);')
print('Unintentional peaked earlier (1901-1984, resid +3.9); AgriForest collapsed (resid -5.5 in 1985-2019).')

# =====================================================================
print('\n' + '='*112)
print('SECTION 2. PRIMARY MODELS  (per-pathway presence, 1000 m, z-std covariates, habitat NOT controlled)')
print('='*112)
print('Single-exposure marginal models give clean effect sizes; both-exposure joint models also shown.')
for k in ['n.total','n.gard','n.unint','n.agfo']:
    rows.append(logit_models(presence[k], inp['u.1000'], inp['d.1000'], 'u', f'{k}_u_1000'))
    rows.append(logit_models(presence[k], inp['u.1000'], inp['d.1000'], 'd', f'{k}_d_1000'))
    rows.append(logit_models(presence[k], inp['u.1000'], inp['d.1000'], 'both', f'{k}_both_1000'))
res = pd.DataFrame(rows)
prim_1k = res[res['label'].str.endswith('_1000') & ~res['label'].str.contains('both')].set_index('label')
pu = [c for c in ['label','conv','OR_urban2009','lo_OR_urban2009','hi_OR_urban2009','p_urban2009'] if c in prim_1k.columns]
pd_ = [c for c in ['label','conv','OR_du','lo_OR_du','hi_OR_du','p_du'] if c in prim_1k.columns]
print('\nPer-pathway adjusted odds ratios (single exposure, 1000 m), urban cover 2009:')
print(prim_1k[pu].round(2).reset_index().to_string(index=False))
print('\nPer-pathway adjusted odds ratios (single exposure, 1000 m), delta urban 1956-2009:')
print(prim_1k[pd_].round(2).reset_index().to_string(index=False))
print('\nInterpretable effect size, odds ratio per +10 percentage points of urban cover (1000 m, adjusted):')
for k, tag, col in [('n.unint','urban2009','OR_urban2009'), ('n.gard','urban2009','OR_urban2009'),
                    ('n.agfo','urban2009','OR_urban2009'), ('n.unint','du','OR_du'), ('n.total','urban2009','OR_urban2009')]:
    or_ = prim_1k.loc[k+'_'+('u' if tag=='urban2009' else 'd')+'_1000', col]
    print('  %-15s %s per +0.1: OR=%.2f' % (k, 'urban' if tag=='urban2009' else 'delta', or_**0.1))

# =====================================================================
print('\n' + '='*112)
print('SECTION 3. LOCAL SENSITIVITY  (50 m buffer, single-exposure)')
print('='*112)
rows50 = []
for k in ['n.gard','n.unint','n.agfo','n.total']:
    rows50.append(logit_models(presence[k], inp['u.50'], inp['d.50'], 'u', f'{k}_u_50'))
    rows50.append(logit_models(presence[k], inp['u.50'], inp['d.50'], 'd', f'{k}_d_50'))
res50 = pd.DataFrame(rows50)
res50 = res50.sort_values('label')
cols50=['label','conv','OR_urban2009','lo_OR_urban2009','hi_OR_urban2009','p_urban2009','OR_du','lo_OR_du','hi_OR_du','p_du']
# present each exposure separately for readability
res50u = res50[res50['label'].str.contains('_u_50')]
res50d = res50[res50['label'].str.contains('_d_50')]
print('\n50 m, urban cover 2009:')
print(res50u[[c for c in cols50 if c in res50u.columns]].round(2).to_string(index=False))
print('\n50 m, delta urban 1956-2009:')
print(res50d[[c for c in cols50 if c in res50d.columns]].round(2).to_string(index=False))

# =====================================================================
print('\n' + '='*112)
print('SECTION 4. DIAGNOSTIC — HABITAT AS A BAD CONTROL (Firth, 1000 m) + within-Urban reversal')
print('='*112)
for k in ['n.total','n.gard','n.unint','n.agfo']:
    rows.append(logit_models(presence[k], inp['u.1000'], inp['d.1000'], 'u', f'{k}_u_hab', with_habitat=True))
resH = pd.DataFrame(rows[-4:])
colsH=['label','method','conv','OR_urban2009','lo_OR_urban2009','hi_OR_urban2009','p_urban2009']
print(resH[[c for c in colsH if c in resH.columns]].round(2).to_string(index=False))
print("\nAdding habitat as a covariate (the dummy Urban, itself an indicator of the urban land use being tested)")
print('absorbs the urban-cover level effect and drives OR below 1 -> classic bad-control/adjustment-on-a-')
print('proxy problem. Habitat is hence excluded from the primary model and reported only diagnostically.')
urb = inp[inp['habitat']=='Urban'].copy()
for k in ['n.unint','n.gard']:
    y = (urb[k]>0).astype(int)
    if 0 < y.sum() < len(y):
        r = st.spearmanr(urb['urban.2009.1000m'], y)
        print(f'Within Urban habitat (n={len(urb)}): presence({k}) vs urban.2009.1000m  rho={r.statistic:.3f} (p={r.pvalue:.3f})  [ceiling/saturation at high urban cover]')

# =====================================================================
print('\n' + '='*112)
print('SECTION 5. COUNT MODELS & ZERO-INFLATION  (1000 m, z-std covariates)')
print('='*112)
zero_obs = (inp['n.total']==0).mean()
print('Observed zero fraction: %.3f (%d/632)' % (zero_obs, int((inp['n.total']==0).sum())))
for k in ['n.total','n.gard','n.unint']:
    y = inp[k].values
    X = design(inp['u.1000'], inp['d.1000'], 'both')
    nb = sm.NegativeBinomial(y, X.astype(float), loglike_method='nb2').fit(disp=False, maxiter=400)
    mu = nb.predict(); alpha = nb.params['alpha']
    p0 = np.mean((alpha/(alpha+mu))**alpha)
    print(f'  {k:8s}: NB OR_urban2009={np.exp(nb.params["urban2009"]):.2f} (p={nb.pvalues["urban2009"]:.3f}), '
          f'OR_du={np.exp(nb.params["du1956_2009"]):.2f} (p={nb.pvalues["du1956_2009"]:.3f}), alpha={alpha:.2f}, '
          f'E[zero|NB]={p0:.3f} vs observed {(y==0).mean():.3f}')
print('\nCounts corroborate the presence/absence direction (esp. Unintentional); 70% zeros mean the')
print('presence/absence logistic (Sections 2-3) is the reliable primary specification.')

# =====================================================================
print('\n' + '='*112)
print('SECTION 6. CROSS-PATHWAY CONTRAST (core of the answer; single-exposure models, 1000 m)')
print('='*112)
# slope of each pathway from OR and p (two-sided z), beta=ln(OR), se=ln(OR)/z
def slope(label, tag):
    or_ = prim_1k.loc[label,'OR_'+tag]; p = prim_1k.loc[label,'p_'+tag]
    z = st.norm.isf(p/2.0)
    return np.log(or_), np.log(or_)/z

for tag, taglab, rowsub in [('urban2009','urban-cover 2009','_u_1000'), ('du','delta-urban 1956-2009','_d_1000')]:
    bu,su = slope('n.unint'+rowsub, tag); bg,sg = slope('n.gard'+rowsub, tag); ba,sa = slope('n.agfo'+rowsub, tag)
    z_ua = (bu-ba)/np.sqrt(su**2+sa**2); p_ua = 2*st.norm.sf(abs(z_ua))
    z_ga = (bg-ba)/np.sqrt(sg**2+sa**2); p_ga = 2*st.norm.sf(abs(z_ga))
    z_ug = (bu-bg)/np.sqrt(su**2+sg**2); p_ug = 2*st.norm.sf(abs(z_ug))
    print(f'\n{taglab:22s} (log-odds slope per unit of urban cover):')
    print(f'  Unintentional slope={bu:+.2f} vs AgriForest {ba:+.2f}:  diff z={z_ua:.2f}, p={p_ua:.2e}')
    print(f'  Gardening      slope={bg:+.2f} vs AgriForest {ba:+.2f}:  diff z={z_ga:.2f}, p={p_ga:.2e}')
    print(f'  Unintentional vs Gardening:                              diff z={z_ug:.2f}, p={p_ug:.2e}')
# =====================================================================
print('\n' + '='*112)
print('SECTION 7. UNIVARIATE CONTEXT (means; raw spatial signal)')
print('='*112)
for k,lab in [('n.unint','Unintentional'),('n.gard','Gardening'),('n.agfo','AgriForest'),('n.total','All pathways')]:
    y = presence[k]
    print(f'  {lab:14s} present n={y.sum():3d}:  urban2009(1000m) {inp.loc[y==1,"u.1000"].mean():.3f} vs absent {inp.loc[y==0,"u.1000"].mean():.3f} | '
      f'delta-urban {inp.loc[y==1,"d.1000"].mean():.3f} vs {inp.loc[y==0,"d.1000"].mean():.3f}')

