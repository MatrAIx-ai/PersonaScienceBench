from statsmodels.discrete.discrete_model import Logit, Poisson as Poi  # ensure

def fit_nb(y, ucol="urban.2009.500m_z", data=None, ctrl=None, allow_poisson=True):
    """Fit NegativeBinomial (fallback Poisson for ultra-sparse responses like n.agfo).
    Returns dict with urban effect extracted."""
    data = df_p if data is None else data
    if ctrl is None:
        ctrl = CTRL_HAB
    yv, X = patsy.dmatrices(f"Q('{y}') ~ Q('{ucol}')" + ctrl, data, return_type="dataframe")
    kind = "NB"
    try:
        res = NegativeBinomial(yv, X).fit(maxiter=300, disp=False)
        if np.isnan(res.params).any() or np.isnan(res.bse).any():
            raise RuntimeError("nanNB")
    except Exception:
        if allow_poisson:
            res = Poisson(yv, X).fit(maxiter=300, disp=False)
            kind = "Poisson"
        else:
            raise
    cols = list(X.columns)
    ui = next((k for k, c in enumerate(cols) if ucol in c), None)
    obs_zero = (yv.values.ravel() == 0).mean()
    # NB-implied probability of a zero (marginal): (a/(a+mu))^a
    exp_zero = np.nan
    if kind == "NB":
        mu = res.predict()
        a = float(res.params["alpha"])
        exp_zero = np.mean((a / (a + mu)) ** a)
    out = dict(kind=kind, aic=res.aic, obs_zero=obs_zero, exp_zero=exp_zero)
    if ui is not None:
        b, se = res.params.iloc[ui], res.bse.iloc[ui]
        z = b / se if (se > 0 and not np.isnan(se)) else np.nan
        p = 2 * (1 - stats.norm.cdf(abs(z))) if not np.isnan(z) else np.nan
        out.update(IRR=np.exp(b), lo=np.exp(b - 1.96 * se), hi=np.exp(b + 1.96 * se), p=p, beta=b, se=se)
    return out

def fmt(d, label):
    if "IRR" not in d or np.isnan(d.get("p", np.nan)):
        return f"[{label}] {d['kind']} AIC={d['aic']:.1f} | urban n/a"
    sig = "***" if d["p"] < 0.001 else "**" if d["p"] < 0.01 else "*" if d["p"] < 0.05 else "n.s."
    return (f"[{label}] {d['kind']} AIC={d['aic']:.1f} | urban IRR={d['IRR']:.3f} "
            f"(CI {d['lo']:.3f}-{d['hi']:.3f}) p={d['p']:.4f} {sig}")

