def kw_block(df, group):
    lines = [f"-- {group} --"]
    for m in metrics:
        groups = [g[m].values for _, g in df.groupby(group)]
        _, pkw = stats.kruskal(*groups)
        means = df.groupby(group)[m].mean().round(2)
        lines.append(f"{m}: KW p={pkw:.4f} | means={means.to_dict()}")
    return "\n".join(lines)

