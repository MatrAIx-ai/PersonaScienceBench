class Node:
    __slots__ = ("name", "length", "children", "parent")
    def __init__(self, name=None, length=0.0, parent=None):
        self.name = name; self.length = length; self.children = []; self.parent = parent

def parse_newick(s):
    s = s.strip()
    if s.endswith(";"):
        s = s[:-1].strip()
    pos = 0
    def parse(parent=None):
        nonlocal pos
        if s[pos] == "(":
            pos += 1
            node = Node(parent=parent)
            while True:
                node.children.append(parse(parent=node))
                if s[pos] == ",":
                    pos += 1
                else:
                    break
            assert s[pos] == ")"
            pos += 1
            name = ""
            while pos < len(s) and s[pos] not in ",();":
                name += s[pos]; pos += 1
            name = name.strip()
            if ":" in name:
                name, length = name.rsplit(":", 1)
                node.length = float(length)
            else:
                node.length = 0.0
            node.name = name if name else None
            return node
        else:
            name = ""
            while pos < len(s) and s[pos] not in ",():;":
                name += s[pos]; pos += 1
            name = name.strip()
            length = 0.0
            if pos < len(s) and s[pos] == ":":
                pos += 1
                ls = ""
                while pos < len(s) and s[pos] not in ",():;":
                    ls += s[pos]; pos += 1
                length = float(ls)
            return Node(name=name, length=length, parent=parent)
    return parse()

root = parse_newick(newick)
depth = {}
def set_depth(node, d):
    depth[id(node)] = d
    for c in node.children:
        set_depth(c, d + c.length)
set_depth(root, 0.0)
tips = {}
def collect(node):
    if not node.children and node.name:
        tips[node.name] = node
    elif node.children:
        for c in node.children:
            collect(c)
