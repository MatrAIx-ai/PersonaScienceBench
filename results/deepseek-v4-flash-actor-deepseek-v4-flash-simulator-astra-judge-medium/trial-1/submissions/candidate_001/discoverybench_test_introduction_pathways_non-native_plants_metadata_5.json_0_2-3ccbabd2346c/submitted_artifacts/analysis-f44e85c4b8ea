OUT.append(f"Parsed {len(tips)} tips; tree set == species phylo.tip.label set: {set(tips) == set(df_sp['phylo.tip.label'])}")

path_cache = {}
def path_to_root(node):
    if id(node) in path_cache:
        return path_cache[id(node)]
    p = []
    n = node
    while n is not None:
        p.append(n); n = n.parent
    path_cache[id(node)] = p
    return p

def phylo_dist(t1, t2):
    p1 = set(map(id, path_to_root(tips[t1])))
    for n in path_to_root(tips[t2]):
        if id(n) in p1:
            lca = n; break
    return depth[id(tips[t1])] + depth[id(tips[t2])] - 2 * depth[id(lca)]

order = df_sp["phylo.tip.label"].tolist()
