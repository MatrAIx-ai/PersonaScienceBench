        b, se = lg.params.iloc[ui], lg.bse.iloc[ui]
        z = b / se; p = 2 * (1 - stats.norm.cdf(abs(z)))
        sig = "***" if p < 0.001 else "**" if p < 0.01 else "*" if p < 0.05 else "n.s."
        OUT.append(f"  [{y}] presence OR={np.exp(b):.3f} (CI {np.exp(b-1.96*se):.3f}-{np.exp(b+1.96*se):.3f}) p={p:.4f} {sig}")
