long = pd.concat(long_rows, ignore_index=True)
long["pathway"] = pd.Categorical(long["pathway"], categories=["AgriForest", "Gardening", "Unintentional"])
U = "urban.2009.500m_z"
inter_tables = {}
for hab in [True, False]:
    ctrl = CTRL_HAB if hab else CTRL_NOHAB
    tags = []
    for Model, nm in [(NegativeBinomial, "NB"), (Poisson, "Poisson")]:
        yv, X = patsy.dmatrices("count ~ pathway * " + "Q('" + U + "')" + ctrl, long, return_type="dataframe")
        m = Model(yv, X).fit(maxiter=300, disp=False)
        tbl = m.summary2().tables[1].rename(columns={"Coef.": "beta", "Std.Err.": "se", "P>|z|": "p"})
        tbl["IRR"] = np.exp(tbl["beta"])
        inter_tables[(hab, nm)] = tbl
        main = [c for c in tbl.index if c == "Q('" + U + "')"]
        ints = [c for c in tbl.index if c.startswith("pathway[T.") and c.endswith(":" + "Q('" + U + "')")]
        OUT.append(f"[interaction {nm} habitat={hab}] AIC={m.aic:.1f}")
        if main:
            r = tbl.loc[main[0]]
            OUT.append(f"   AgriForest urban slope: beta={r['beta']:.3f}, IRR={r['IRR']:.3f}, p={r['p']:.4f}")
        for c in ints:
            r = tbl.loc[c]
            OUT.append(f"   {c.replace(':Q(' + chr(39) + U + chr(39) + ')', '').replace('pathway[T.', '').replace(']', '')} x urban: "
                       f"INTERACTION beta={r['beta']:.3f} (SE {r['se']:.3f}), p={r['p']:.4f}")

