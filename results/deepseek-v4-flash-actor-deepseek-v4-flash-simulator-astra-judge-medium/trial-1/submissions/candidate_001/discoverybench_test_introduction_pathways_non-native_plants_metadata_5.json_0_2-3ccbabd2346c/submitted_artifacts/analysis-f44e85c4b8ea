for i in range(len(order)):
    for j in range(i + 1, len(order)):
        dd = phylo_dist(order[i], order[j])
        D[i, j] = D[j, i] = dd
Dv = D[np.triu_indices(len(order), 1)]

def mantel(trait, perms=499):
    vals = df_sp[trait].values
    Tv = np.abs(vals[:, None] - vals[None, :])[np.triu_indices(len(order), 1)]
    r = stats.pearsonr(Dv, Tv)[0]
    nulls = []
    idx0 = np.arange(len(order))
    for _ in range(perms):
        sh = np.random.permutation(idx0)
        Tv_sh = np.abs(vals[sh][:, None] - vals[sh][None, :])[np.triu_indices(len(order), 1)]
        nulls.append(stats.pearsonr(Dv, Tv_sh)[0])
    p = (1 + np.sum(np.abs(nulls) >= np.abs(r))) / (perms + 1)
    return r, p

for trait in ["number.of.invaded.plots", "invaded.niche.breadth", "area.of.occupancy.10km"]:
