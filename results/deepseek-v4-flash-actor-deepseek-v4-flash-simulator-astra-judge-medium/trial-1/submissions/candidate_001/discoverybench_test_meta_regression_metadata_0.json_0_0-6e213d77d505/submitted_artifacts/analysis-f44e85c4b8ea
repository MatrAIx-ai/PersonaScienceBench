#!/usr/bin/env python3
"""
Domain-level comparison of original vs replication effect sizes.
Data: meta-regression_joined_data_heterogeneity_in_replication_projects.csv
Each row is a paired original-replication study.

Produces:
  - per-domain descriptive + paired-inference tables (discipline & project level)
  - cross-domain ranking (Kruskal-Wallis, OLS, ANOVA on the paired gap)
  - two SVG plots (paired scatter, mean bars) written with zero external deps
"""
import pandas as pd
import numpy as np
from scipy import stats
import statsmodels.formula.api as smf
from statsmodels.formula.api import ols
from statsmodels.stats.anova import anova_lm

DATA = "data/meta-regression_joined_data_heterogeneity_in_replication_projects.csv"
OUT = "analysis/output"

df = pd.read_csv(DATA)
df["d"] = df["ro"] - df["rr"]            # signed diff, correlation scale
df["d_f"] = df["fiso"] - df["fisr"]      # signed diff, Fisher-z scale
df["mag_ratio"] = df["rr"].abs() / df["ro"]   # magnitude ratio |rep|/|orig|
df["log_mag_ratio"] = np.log(df["mag_ratio"]) # <0 => original larger in magnitude

def domain_table(g, name):
    n = len(g)
    row = {
        "domain": name, "n": n,
        "med_ro": g.ro.median(), "med_rr": g.rr.median(),
        "mean_ro": g.ro.mean(), "mean_rr": g.rr.mean(),
        "med_fiso": g.fiso.median(), "med_fisr": g.fisr.median(),
        "mean_fiso": g.fiso.mean(), "mean_fisr": g.fisr.mean(),
        "pct_ro_gt_rr": 100*(g.ro > g.rr).mean(),
        "pct_fiso_gt_fisr": 100*(g.fiso > g.fisr).mean(),
        "med_d": g.d.median(), "mean_d": g.d.mean(),
        "med_d_f": g.d_f.median(), "mean_d_f": g.d_f.mean(),
        "med_abs_ratio": g.mag_ratio.median(),
        "mean_log_ratio": g.log_mag_ratio.mean(),
        "n_neg_rr": int((g.rr < 0).sum()),
        "pct_rep_same_dir": 100*(g.rr > 0).mean(),
        "wilcox_d_f_p": stats.wilcoxon(g.d_f).pvalue,
        "ttest_d_f_p": stats.ttest_1samp(g.d_f, 0).pvalue,
        "wilcox_d_p": stats.wilcoxon(g.d).pvalue,
        "ttest_d_p": stats.ttest_1samp(g.d, 0).pvalue,
    }
    return pd.DataFrame([row])

disc_tbl = pd.concat([domain_table(g, disc) for disc, g in df.groupby("discipline", sort=False)],
                     ignore_index=True)
proj_tbl = pd.concat([domain_table(g, proj) for proj, g in df.groupby("project.x", sort=False)],
                     ignore_index=True)
all_tbl = pd.concat([disc_tbl, domain_table(df, "ALL")], ignore_index=True)

pd.set_option("display.width", 250)
pd.set_option("display.max_columns", 50)
print("=" * 100)
print("TABLE A: discipline level (+ overall)")
print("=" * 100)
print(all_tbl.round(3).to_string(index=False))
print()
print("=" * 100)
print("TABLE B: replication-project level")
print("=" * 100)
print(proj_tbl.round(3).to_string(index=False))

print()
print("=" * 100)
print("CROSS-DOMAIN COMPARISON")
print("=" * 100)
k_disc_f, p_disc_f = stats.kruskal(*[g.d_f.values for _, g in df.groupby("discipline")])
k_proj_f, p_proj_f = stats.kruskal(*[g.d_f.values for _, g in df.groupby("project.x")])
print(f"Kruskal-Wallis d_f by discipline:  H={k_disc_f:.3f}, p={p_disc_f:.4f}")
print(f"Kruskal-Wallis d_f by project:     H={k_proj_f:.3f}, p={p_proj_f:.4f}")
k_disc_r, p_disc_r = stats.kruskal(*[g.log_mag_ratio.values for _, g in df.groupby("discipline")])
k_proj_r, p_proj_r = stats.kruskal(*[g.log_mag_ratio.values for _, g in df.groupby("project.x")])
print(f"Kruskal-Wallis log|rr|/ro by discipline: H={k_disc_r:.3f}, p={p_disc_r:.4f}")
print(f"Kruskal-Wallis log|rr|/ro by project:    H={k_proj_r:.3f}, p={p_proj_r:.4f}")

# OLS: d_f ~ discipline (ref = Economics = the EE project), and log ratio version
m_f = smf.ols("d_f ~ C(discipline, Treatment(reference='Economics'))", data=df).fit()
print()
print("OLS: d_f (fiso - fisr) ~ discipline (ref=Economics):")
print(m_f.params.round(3).to_string())
print("p-values:", {k: round(v, 4) for k, v in m_f.pvalues.items()})

aov = anova_lm(ols("d_f ~ C(discipline)", data=df).fit(), typ=2)
print()
print("ANOVA d_f ~ discipline:")
print(aov.round(4).to_string())

m_r = smf.ols("log_mag_ratio ~ C(discipline, Treatment(reference='Economics'))", data=df).fit()
print()
print("OLS: log|rr|/ro ~ discipline (ref=Economics):")
print(m_r.params.round(3).to_string())
print("p-values:", {k: round(v, 4) for k, v in m_r.pvalues.items()})

print()
print("Binomial test %(ro>rr) vs 50% per discipline:")
for disc, g in df.groupby("discipline"):
    k = int((g.ro > g.rr).sum())
    p = stats.binomtest(k, len(g), 0.5).pvalue
    print(f"  {disc:10s} {k}/{len(g)}  p={p:.4f}")

print()
print("MAGNITUDE interpretation: median |rr|/ro (and implied original-multiplier):")
for disc, g in df.groupby("discipline"):
    ratio = g.mag_ratio.median()
    print(f"  {disc:10s} median |rr|/ro = {ratio:.3f}  => original ~{1/ratio:.2f}x larger")

# ---------------- Plots (zero-dependency SVG) ----------------
COLORS = {"Cognitive": "#1f77b4", "Social": "#ff7f0e", "Economics": "#2ca02c"}
ORDER = ["Social", "Cognitive", "Economics"]

def svg_escape(s):
    return str(s).replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")

# ---- Plot 1: paired scatter, fiso vs fisr ----
W, H, M = 720, 520, 70
xmin, xmax = float(df.fiso.min()) - 0.05, float(df.fiso.max()) + 0.05
ymin, ymax = float(df.fisr.min()) - 0.2, float(df.fisr.max()) + 0.2
def sx(x): return M + (x - xmin) / (xmax - xmin) * (W - 2 * M)
def sy(y): return H - M - (y - ymin) / (ymax - ymin) * (H - 2 * M)

parts = [f'<svg xmlns="http://www.w3.org/2000/svg" width="{W}" height="{H}">',
         f'<text x="{M}" y="30" font-size="16" font-weight="bold">Paired effect sizes: original vs replication (Fisher-z)</text>',
         f'<rect x="{M}" y="{M}" width="{W-2*M}" height="{H-2*M}" fill="white" stroke="#888" stroke-width="1"/>']
# identity line
parts.append(f'<line x1="{sx(xmin):.1f}" y1="{sy(xmin):.1f}" x2="{sx(xmax):.1f}" y2="{sy(xmax):.1f}" stroke="#555" stroke-width="1.5" stroke-dasharray="6,4"/>')
# axes labels & ticks
parts.append(f'<text x="{W/2}" y="{H-12}" font-size="13" text-anchor="middle">Original effect size (fiso)</text>')
parts.append(f'<text x="16" y="{H/2}" font-size="13" text-anchor="middle" transform="rotate(-90 16,{H/2})">Replication effect size (fisr)</text>')
for t in np.linspace(xmin, xmax, 6):
    parts.append(f'<text x="{sx(t):.1f}" y="{H-M+16}" font-size="10" text-anchor="middle">{t:.2f}</text>')
for t in np.linspace(ymin, ymax, 6):
    parts.append(f'<text x="{M-8}" y="{sy(t):.1f}" font-size="10" text-anchor="end">{t:.2f}</text>')
for disc, c in COLORS.items():
    g = df[df.discipline == disc]
    for _, r in g.iterrows():
        parts.append(f'<circle cx="{sx(r.fiso):.1f}" cy="{sy(r.fisr):.1f}" r="4.5" fill="{c}" stroke="#000" stroke-width="0.4"/>')
    legend_x = W - M - 8
    parts.append(f'<circle cx="{legend_x - 60}" cy="{M + 18 + 20*list(COLORS).index(disc)}" r="4.5" fill="{c}" stroke="#000" stroke-width="0.4"/>')
    parts.append(f'<text x="{legend_x - 50}" y="{M + 22 + 20*list(COLORS).index(disc)}" font-size="11">{svg_escape(disc)} (n={len(g)})</text>')
parts.append(f'<text x="{W-M-8}" y="{M+38+20*len(COLORS)}" font-size="11" font-style="italic">dashed = original = replication</text>')
parts.append('</svg>')
scatter_svg = "\n".join(parts)
with open(f"{OUT}_paired_scatter.svg", "w") as f:
    f.write(scatter_svg)

# ---- Plot 2: bar chart, mean fiso vs mean fisr per discipline ----
means_o = [df[df.discipline == d].fiso.mean() for d in ORDER]
means_r = [df[df.discipline == d].fisr.mean() for d in ORDER]
sem_o = [df[df.discipline == d].fiso.sem() for d in ORDER]
sem_r = [df[df.discipline == d].fisr.sem() for d in ORDER]
ymax_b = max(means_o + means_r) * 1.25
def by(y): return H - M - (y - 0) / (ymax_b - 0) * (H - 2 * M)
bw = 46
parts = [f'<svg xmlns="http://www.w3.org/2000/svg" width="{W}" height="{H}">',
         f'<text x="{M}" y="30" font-size="16" font-weight="bold">Mean original vs replication effect size by discipline (Fisher-z, +-SE)</text>',
         f'<rect x="{M}" y="{M}" width="{W-2*M}" height="{H-2*M}" fill="white" stroke="#888" stroke-width="1"/>',
         f'<line x1="{M}" y1="{by(0):.1f}" x2="{W-M}" y2="{by(0):.1f}" stroke="#888"/>']
n = len(ORDER)
group_w = 3 * 2 * bw
start_x = (M + (W - M)) / 2 - group_w
for i, d in enumerate(ORDER):
    cx = start_x + (i * 3 + 1) * bw + bw / 2      # original bar center
    cx2 = start_x + (i * 3 + 2) * bw + bw / 2     # replication bar center
    # original bar
    parts.append(f'<rect x="{cx-bw/2:.1f}" y="{by(means_o[i]):.1f}" width="{bw}" height="{by(0)-by(means_o[i]):.1f}" fill="#b0b7c9" stroke="#333" stroke-width="0.6"/>')
    parts.append(f'<line x1="{cx:.1f}" y1="{by(means_o[i]-sem_o[i]):.1f}" x2="{cx:.1f}" y2="{by(means_o[i]+sem_o[i]):.1f}" stroke="#333" stroke-width="1.2"/>')
    parts.append(f'<text x="{cx:.1f}" y="{by(means_o[i]+sem_o[i])-6:.1f}" font-size="10" text-anchor="middle">{means_o[i]:.2f}</text>')
    # replication bar
    parts.append(f'<rect x="{cx2-bw/2:.1f}" y="{by(means_r[i]):.1f}" width="{bw}" height="{by(0)-by(means_r[i]):.1f}" fill="#e0a458" stroke="#333" stroke-width="0.6"/>')
    parts.append(f'<line x1="{cx2:.1f}" y1="{by(means_r[i]-sem_r[i]):.1f}" x2="{cx2:.1f}" y2="{by(means_r[i]+sem_r[i]):.1f}" stroke="#333" stroke-width="1.2"/>')
    parts.append(f'<text x="{cx2:.1f}" y="{by(means_r[i]+sem_r[i])-6:.1f}" font-size="10" text-anchor="middle">{means_r[i]:.2f}</text>')
    parts.append(f'<text x="{(cx+cx2)/2:.1f}" y="{H-M+16}" font-size="12" text-anchor="middle" font-weight="bold">{d} (n={len(df[df.discipline==d])})</text>')
for t in np.linspace(0, ymax_b, 6):
    parts.append(f'<text x="{M-8}" y="{by(t):.1f}" font-size="10" text-anchor="end">{t:.2f}</text>')
    parts.append(f'<line x1="{M}" y1="{by(t):.1f}" x2="{W-M}" y2="{by(t):.1f}" stroke="#ddd" stroke-width="0.6"/>')
# legend
parts.append(f'<rect x="{M+10}" y="{M+10}" width="12" height="12" fill="#b0b7c9" stroke="#333" stroke-width="0.6"/>')
parts.append(f'<text x="{M+28}" y="{M+21}" font-size="11">Original</text>')
parts.append(f'<rect x="{M+100}" y="{M+10}" width="12" height="12" fill="#e0a458" stroke="#333" stroke-width="0.6"/>')
parts.append(f'<text x="{M+118}" y="{M+21}" font-size="11">Replication</text>')
parts.append('</svg>')
bar_svg = "\n".join(parts)
with open(f"{OUT}_mean_bars.svg", "w") as f:
    f.write(bar_svg)

# Save tables
all_tbl.round(4).to_csv(f"{OUT}_discipline_table.csv", index=False)
proj_tbl.round(4).to_csv(f"{OUT}_project_table.csv", index=False)
print()
print("Artifacts written to analysis/ :",
      f"{OUT}_discipline_table.csv, {OUT}_project_table.csv,",
      f"{OUT}_paired_scatter.svg, {OUT}_mean_bars.svg")
