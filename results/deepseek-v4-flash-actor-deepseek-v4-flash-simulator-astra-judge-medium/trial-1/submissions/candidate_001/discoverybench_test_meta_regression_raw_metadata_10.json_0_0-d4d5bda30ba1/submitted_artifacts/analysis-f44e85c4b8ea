"""
Question: What is the proportion of junior professors in replicated studies in Psychology?

Approved definition (per researcher):
  - Population        : project == 'rpp'  (Reproducibility Project: Psychology; the schema maps
                         'rpp: Psychology'. The 'discipline' column never equals Psychology.)
  - 'replicated'      : replicated == 1   (schema: p <= 0.05 and effect same direction as original)
  - seniority variable: seniority.r       (most senior author of the REPLICATION paper)
  - 'junior professor': rank in {'Assistant', 'Assistant Professor'}
                         ('Professor' and 'Associate Professor' are not junior; 'Researcher' is not
                          a professor rank under the default definition.)

File 2 (meta-regression_replication_success_...) is deliberately EXCLUDED from the computation:
it has no seniority column, no `replicated` column, and shares no rows with File 1's rpp studies.
Only File 1 is used.
"""
import pandas as pd

FILE1 = 'data/meta-regression_study_data_heterogeneity_in_replication_projects.csv'
df = pd.read_csv(FILE1)

# ---- Sanity checks ---------------------------------------------------------
rpp = df[df['project'] == 'rpp'].copy()
print('rpp rows            :', len(rpp))
print('rpp unique ids      :', rpp['id'].nunique())
print('rpp duplicate rows  :', int(rpp['id'].duplicated().sum()), '(any duplicate would inflate a count)')
print('rpp missing replicated:', int(rpp['replicated'].isna().sum()))
print('rpp missing seniority.r:', int(rpp['seniority.r'].isna().sum()))

rep = rpp[rpp['replicated'] == 1].copy()
print('replicated==1 rows  :', len(rep))
print('replicated==1 unique ids:', rep['id'].nunique())
print('replicated==1 duplicate rows:', int(rep['id'].duplicated().sum()))

# ---- Main tabulation --------------------------------------------------------
print('\nseniority.r value counts (rpp, replicated==1, n=%d):' % len(rep))
print(rep['seniority.r'].value_counts().to_string())

junior = {'Assistant', 'Assistant Professor'}
junior_n = int(rep['seniority.r'].isin(junior).sum())
total = len(rep)
prop = junior_n / total
print(f'\njunior professors (Assistant / Assistant Professor): {junior_n} / {total} = {prop:.4f} ({prop*100:.1f}%)')

# ---- Caveat / sensitivity numbers for unambiguous reporting -----------------
junior_res = junior | {'Researcher'}
print(f'caveat: incl Researcher   : {rep["seniority.r"].isin(junior_res).sum()} / {total} = {rep["seniority.r"].isin(junior_res).mean():.4f}')
print(f'caveat: all rpp (no filter): junior={rpp["seniority.r"].isin(junior).sum()} / {len(rpp)} = {rpp["seniority.r"].isin(junior).mean():.4f}')
print(f'caveat: seniority.o (original authors): junior={rep["seniority.o"].isin(junior).sum()} / {total} = {rep["seniority.o"].isin(junior).mean():.4f}')

HYPOTHESIS = (
    f"In the Reproducibility Project: Psychology (project == 'rpp'), {junior_n:.0f} of the {total} "
    f"successfully replicated studies ({prop*100:.1f}%) have a junior professor "
    "(Assistant or Assistant Professor) as the most senior replication author (seniority.r)."
)
print('\nHYPOTHESIS:', HYPOTHESIS)
