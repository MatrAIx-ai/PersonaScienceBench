"""
DiscoveryBench — subject-type analysis
Question: In which domain did BOTH original and replication studies primarily
          use student subjects (original: 82.4%, replication: 80.9%)?

Primary computation : pair-level study_data (141 unique original/replication pairs),
                      representative row per pair.
Sensitivity variants: row-level (927) and per-lab-level (786) pooling.
Subject categories  : students, online, anyone, community.
NA handling         : single NA pair (rpp.154, Social) counted as not-student in
                      denominator (included in n, contributes 0 to numerator).
Drops               : `drop` flag NOT used to exclude (subject usage describes
                      studies actually conducted; exclusion distorts the shares).
"""
import pandas as pd

STUDY_DATA = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
df = pd.read_csv(STUDY_DATA)

print("=== 0. Load & structure validation ===")
print("study_data shape:", df.shape)
print("unique pairs (ids):", df['id'].nunique())
print("pairs per project:", df.groupby('id')['project'].first().value_counts().to_dict())
print("subjects.o distinct values per pair (constancy):",
      dict(df.groupby('id')['subjects.o'].nunique().value_counts()))
# representative row per pair
rep = df[df['aggregated'].isna() | (df['aggregated'] == True)]
assert rep['id'].is_unique, "representative rows must be unique per id"
print("representative rows:", len(rep), "| aggregated=True:", (rep['aggregated']==True).sum(),
      "| NaN:", rep['aggregated'].isna().sum())
print()

def share(src, col):
    """share (%) of rows in src where col == 'students', counting NA as not-student."""
    n = len(src)
    k = int((src[col] == 'students').sum())
    return k, n, round(k / n * 100, 2) if n else None

subsets = {
    "pair-level (141)": rep,
    "row-level (927)": df,
    "per-lab (786)": df[df['aggregated'] == False],
}

print("=== 1. Per-domain student-subject shares by pooling variant ===")
rows = []
for vname, sub in subsets.items():
    for disc, g in sub.groupby('discipline'):
        ko, no, po = share(g, 'subjects.o')
        kr, nr, pr = share(g, 'subjects.r')
        rows.append({"variant": vname, "discipline": disc, "n": len(g),
                     "orig_students": f"{ko}/{no}", "orig_%": po,
                     "repl_students": f"{kr}/{nr}", "repl_%": pr})
res = pd.DataFrame(rows)
print(res.to_string(index=False))
print()

print("=== 2. Comparison vs quoted values (82.4% original, 80.9% replication) ===")
for _, r in res.iterrows():
    d_o = abs((r["orig_%"] or 0) - 82.4)
    d_r = abs((r["repl_%"] or 0) - 80.9)
    match = (d_o <= 2.5) and (d_r <= 2.5)
    flag = " <-- matches BOTH quoted values" if match else ""
    print(f"{r.variant:16s} {r.discipline:10s} orig={r['orig_%']:>6}%  repl={r['repl_%']:>6}%  "
          f"|d_orig|={d_o:4.2f} |d_repl|={d_r:4.2f}{flag}")
print()

print("=== 3. Whole-dataset shares (reference, all domains pooled) ===")
for vname, sub in subsets.items():
    ko, no, po = share(sub, 'subjects.o')
    kr, nr, pr = share(sub, 'subjects.r')
    print(f"{vname:16s} orig={po}% ({ko}/{no})  repl={pr}% ({kr}/{nr})")
print()

print("=== 4. Robustness: NA & drop handling for Social (pair-level) ===")
soc = rep[rep['discipline'] == 'Social']
print("Social pairs:", len(soc))
print("subjects.o counts:", soc['subjects.o'].value_counts(dropna=False).to_dict())
print("subjects.r counts:", soc['subjects.r'].value_counts(dropna=False).to_dict())
ko, no, po = share(soc, 'subjects.o'); kr, nr, pr = share(soc, 'subjects.r')
print(f"incl NA-as-not-student : orig={po}% ({ko}/{no})  repl={pr}% ({kr}/{nr})")
soc2 = soc[soc['subjects.o'].notna()]
ko2, no2, po2 = share(soc2, 'subjects.o'); kr2, nr2, pr2 = share(soc2, 'subjects.r')
print(f"excl NA study          : orig={po2}% ({ko2}/{no2})  repl={pr2}% ({kr2}/{nr2})")
soc3 = soc[soc['drop'] == False]
ko3, no3, po3 = share(soc3, 'subjects.o'); kr3, nr3, pr3 = share(soc3, 'subjects.r')
print(f"excl dropped (sensitivity, NOT primary): orig={po3}% ({ko3}/{no3})  repl={pr3}% ({kr3}/{nr3})")
print()

print("=== 5. Per-domain category cross-tab (pair-level) ===")
print("--- subjects.o ---")
print(pd.crosstab(rep['discipline'], rep['subjects.o']).to_string())
print("--- subjects.r ---")
print(pd.crosstab(rep['discipline'], rep['subjects.r']).to_string())
