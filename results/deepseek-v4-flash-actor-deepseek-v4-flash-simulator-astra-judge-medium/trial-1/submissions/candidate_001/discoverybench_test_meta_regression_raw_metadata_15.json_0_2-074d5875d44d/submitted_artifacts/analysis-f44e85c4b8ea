"""
Analysis: What proportion of original studies in Experimental Economics
were conducted in the United Kingdom?
Data: meta-regression_study_data_heterogeneity_in_replication_projects.csv
"""
import pandas as pd

DATA = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
df = pd.read_csv(DATA)

print("=" * 70)
print("STEP 1 — Scope: Experimental Economics studies (project == 'ee')")
print("=" * 70)
ee = df[df["project"] == "ee"]
print("rows with project=='ee':", len(ee))
print("unique original-study ids with project=='ee':", ee["id"].nunique())
print("duplicate ids in EE set (should be []):",
      ee[ee.duplicated(subset="id", keep=False)]["id"].unique().tolist())

# Cross-check with discipline filter (identical scope)
econ = df[df["discipline"] == "Economics"]
print("rows with discipline=='Economics':", len(econ))
print("id sets identical (project=='ee' vs discipline=='Economics'):",
      set(ee["id"]) == set(econ["id"]))

print()
print("=" * 70)
print("STEP 2 — Numerator: original studies conducted in the United Kingdom")
print("=" * 70)
uk = ee[ee["experiment_country.o"] == "United Kingdom"]
print("rows with experiment_country.o=='United Kingdom':", len(uk))
for _, row in uk.iterrows():
    print("  id=%s | country=%r | authors=%s" % (row["id"], row["experiment_country.o"], row["authors.o"]))

print()
print("=" * 70)
print("STEP 3 — Missingness in EE country field")
print("=" * 70)
print("missing experiment_country.o within EE:", int(ee["experiment_country.o"].isna().sum()))
print("overall missing experiment_country.o (rows):",
      df["experiment_country.o"].isna().sum(),
      "-> ids:", df.loc[df["experiment_country.o"].isna(), "id"].tolist())
print("empty-string country labels overall:", int((df["experiment_country.o"].astype(str).str.strip() == "").sum()))

print()
print("=" * 70)
print("FINAL RESULT")
print("=" * 70)
den = ee["id"].nunique()
num = int(uk.shape[0])
prop = num / den if den else float("nan")
print("Denominator (unique EE original studies):", den)
print("Numerator (UK EE original studies):", num)
print("Proportion UK:", round(prop, 4), f"= {prop:.2%}")
print("== 1 of", den, "original Experimental Economics studies were conducted in the United Kingdom ==")
