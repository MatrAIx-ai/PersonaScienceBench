"""
DiscoveryBench — meta_regression_raw / metadata_18
Question: What proportion of studies in Experimental Economics were conducted in a lab setting?

Scope locked with researcher:
  * Experimental Economics = project == 'ee'  (coincident with discipline == 'Economics'; 18 studies)
  * Unit of counting = one original study per O/R pair (single row each; identical denominator for
    originals, replications, and pairs)
  * Operationalization: "lab setting" == NOT conducted online (online == 0), corroborated by
    subject type (none 'online'/'anyone' in scope; single 'community' study is non-online).
    NOTE: no literal 'lab' column exists in the schema — this is the key recorded ambiguity.
"""
import pandas as pd

PATH1 = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
PATH2 = "data/meta-regression_replication_success_data_heterogeneity_in_replication_projects.csv"

df = pd.read_csv(PATH1)
df2 = pd.read_csv(PATH2)

# 1) Scope: project == 'ee' (equivalently discipline == 'Economics')
ee = df[df["project"] == "ee"].copy()
econ = df[df["discipline"] == "Economics"].copy()
print("== Scope ==")
print(f"Rows where project=='ee'            : {len(ee)}")
print(f"Rows where discipline=='Economics'  : {len(econ)}")
print(f"Unique ids in ee scope              : {ee['id'].nunique()}")
print(f"ee ids == econ ids (set equality)   : {set(ee['id']) == set(econ['id'])}")
print()

# 2) Rows-per-study structure within scope (no lab expansion / aggregated rows)
print("== Structure within scope ==")
print("Rows per id (expected all 1):", sorted(ee.groupby("id").size().unique().tolist()))
print("aggregated column non-null in ee scope:", ee["aggregated"].notna().sum())
print("lab_id non-null in ee scope:", ee["lab_id"].notna().sum())
print("drop True in ee scope:", int(ee["drop"].sum())) if ee["drop"].dtype != object else None
print("duplicate full rows in ee scope:", int(ee.duplicated().sum()))
print()

# 3) Missingness in relevant fields within scope
rel = ["project", "discipline", "online.o", "online.r", "subjects.o", "subjects.r",
       "same_online", "same_subjects", "id", "title"]
print("== Missingness within scope ==")
for c in rel:
    print(f"  {c:14s} missing = {ee[c].isna().sum()}")
print()

# 4) Lab-setting verification (primary: online == 0; corroboration: subject type != 'online')
print("== Lab-setting verification (primary: online.o == 0) ==")
print(f"online.o == 0 : {int((ee['online.o'] == 0).sum())}/{len(ee)}  ({(ee['online.o'] == 0).mean()*100:.1f}%)")
print(f"online.r == 0 : {int((ee['online.r'] == 0).sum())}/{len(ee)}  ({(ee['online.r'] == 0).mean()*100:.1f}%)")
print(f"same_online==1: {int((ee['same_online'] == 1).sum())}/{len(ee)}")
print()
print("subjects.o value counts (scope):", ee["subjects.o"].value_counts().to_dict())
print("subjects.r value counts (scope):", ee["subjects.r"].value_counts().to_dict())
print("Any 'online' or 'anyone' subject in scope (o or r)?",
      bool((ee["subjects.o"].isin(["online", "anyone"])).any() or (ee["subjects.r"].isin(["online", "anyone"])).any()))
print()

# 5) Community-subject study detail (the only non-student original)
comm = ee[ee["subjects.o"] == "community"]
print("== Only 'community' original study ==")
print(comm[["id", "title", "online.o", "online.r", "subjects.o", "subjects.r", "same_online"]].to_string(index=False))
print()

# 6) Corroboration from File 2 (no online/subjects fields; only confirms scope)
ee2 = df2[df2["project"] == "Experimental Economics"]
print("== File 2 corroboration ==")
print(f"File 2 rows labelled 'Experimental Economics': {len(ee2)}")
print(f"File 2 columns with online/lab/subjects info: "
      f"{[c for c in df2.columns if any(k in c.lower() for k in ['online','lab','subject'])] or 'NONE'}")
print()

# 7) Context: full-file (deduped) for contrast, clearly NOT the answer
uni = df.drop_duplicates("id")
print("== Context (NOT the answer) ==")
print(f"All unique O/R pairs in file 1: {len(uni)}")
print(f"  of which online.o==0: {int((uni['online.o']==0).sum())}, online.o==1: {int((uni['online.o']==1).sum())}, missing: {int(uni['online.o'].isna().sum())}")
print(f"  per-project % not-online:")
print(uni.groupby('project')['online.o'].apply(lambda s: f"{100*(s==0).mean():.1f}%").to_string())
print()

# 8) Final derived answer
n = len(ee)
lab = int((ee["online.o"] == 0).sum())
print("== FINAL ==")
print(f"Experimental Economics studies: {n}")
print(f"Conducted in a lab (online.o==0): {lab}")
print(f"Proportion: {lab}/{n} = {lab/n*100:.1f}%")
