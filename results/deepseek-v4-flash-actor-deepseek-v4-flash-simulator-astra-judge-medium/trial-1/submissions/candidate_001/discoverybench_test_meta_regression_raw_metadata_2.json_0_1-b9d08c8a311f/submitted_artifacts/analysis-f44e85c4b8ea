import pandas as pd

MAIN = 'data/meta-regression_study_data_heterogeneity_in_replication_projects.csv'
df = pd.read_csv(MAIN)

def stats(s, name, n_papers=None):
    out = pd.Series({
        'group': name,
        'n_rows': int(s.size),
        'n_unique_papers': n_papers if n_papers is not None else int(s.nunique()),
        'mean': round(s.mean(), 2),
        'median': round(s.median(), 2),
        'sd': round(s.std(ddof=1), 2),
        'min': int(s.min()),
        'max': int(s.max()),
    })
    return out

rows = []
for proj, label in [('ee', 'Experimental Economics (project=ee)'), ('rpp', 'Psychology (project=rpp = RPP)')]:
    sub = df[df['project'] == proj]
    n_unique = sub['title'].nunique()
    rows.append(stats(sub['length'], label, n_papers=n_unique))
    # drop sensitivity: exclude drop==True rows (only affects rpp; ee has none)
    sub_keep = sub[~sub['drop']]
    if len(sub_keep) != len(sub):
        rows.append(stats(sub_keep['length'], label + ' [sensitivity: drop=True excluded]', n_papers=sub_keep['title'].nunique()))

res = pd.DataFrame(rows).set_index('group')
pd.set_option('display.width', 160)
print(res.to_string())
print()
print('n unique ids (O/R pairs) ee=%d rpp=%d' % (df[df.project=='ee']['id'].nunique(), df[df.project=='rpp']['id'].nunique()))
