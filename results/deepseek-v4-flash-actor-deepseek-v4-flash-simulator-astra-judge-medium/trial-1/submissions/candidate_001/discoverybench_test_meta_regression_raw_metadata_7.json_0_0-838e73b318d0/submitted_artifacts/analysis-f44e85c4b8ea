import pandas as pd
import numpy as np

sd = pd.read_csv('data/meta-regression_study_data_heterogeneity_in_replication_projects.csv')

# ---------- PRIMARY ANALYSIS: row-level (id x lab) pairs, strict >0.5 ----------
print('='*70)
print('PRIMARY: row-level O/R pairs, male-majority = authors_male > 0.5 for BOTH')
print('='*70)
rows = []
for disc in ['Social', 'Cognitive', 'Economics']:
    sub = sd[sd['discipline'] == disc]
    both = (sub['authors_male.o'] > 0.5) & (sub['authors_male.r'] > 0.5)
    rows.append({'discipline': disc, 'n_rows': len(sub), 'n_studies': sub['id'].nunique(),
                 'both_majority': int(both.sum()), 'share': both.mean()})
primary = pd.DataFrame(rows)
print(primary.to_string(index=False))
winner = primary.loc[primary['share'].idxmax()]
print(f"\n>> Largest share of both-male-majority pairs (row-level, >0.5): {winner['discipline']} "
      f"({winner['share']:.3f}, {winner['both_majority']}/{winner['n_rows']} rows, "
      f"{winner['n_studies']} studies)")

# ---------- ROBUSTNESS 1: threshold >= 0.5 ----------
print('\n' + '='*70)
print('ROBUSTNESS 1: row-level, male-majority = authors_male >= 0.5 (>= 0.5 threshold)')
print('='*70)
rows = []
for disc in ['Social', 'Cognitive', 'Economics']:
    sub = sd[sd['discipline'] == disc]
    both = (sub['authors_male.o'] >= 0.5) & (sub['authors_male.r'] >= 0.5)
    rows.append({'discipline': disc, 'n_rows': len(sub), 'both_majority': int(both.sum()),
                 'share': both.mean()})
r1 = pd.DataFrame(rows)
print(r1.to_string(index=False))
print(f">> Largest under >=0.5: {r1.loc[r1['share'].idxmax(),'discipline']} "
      f"({r1['share'].max():.3f})")

# ---------- ROBUSTNESS 2: id-level aggregation ----------
print('\n' + '='*70)
print('ROBUSTNESS 2: id-level, one pair per original study')
print('='*70)
g = sd.groupby('id').agg(discipline=('discipline','first'),
                         male_o=('authors_male.o','first'),
                         male_r=('authors_male.r','first'))
# variant 2a: first lab's replication team
rows = []
for disc in ['Social', 'Cognitive', 'Economics']:
    sub = g[g['discipline'] == disc]
    both = (g.loc[sub.index, 'male_o'] > 0.5) & (g.loc[sub.index, 'male_r'] > 0.5)
    rows.append({'discipline': disc, 'n_studies': len(sub),
                 'both_majority': int(both.sum()), 'share': both.mean()})
r2a = pd.DataFrame(rows)
print('Variant 2a: first-lab replication team, >0.5')
print(r2a.to_string(index=False))

# variant 2b: mean male ratio across labs per study
rows = []
for disc in ['Social', 'Cognitive', 'Economics']:
    sub = sd[sd['discipline'] == disc]
    agg = sub.groupby('id')['authors_male.r'].mean()
    both = (sub.groupby('id')['authors_male.o'].first() > 0.5) & (agg > 0.5)
    rows.append({'discipline': disc, 'n_studies': len(sub),
                 'both_majority': int(both.sum()), 'share': both.mean()})
r2b = pd.DataFrame(rows)
print('\nVariant 2b: mean replication male-ratio across labs, >0.5')
print(r2b.to_string(index=False))
print(f"\n>> Largest under id-level (mean): {r2b.loc[r2b['share'].idxmax(),'discipline']} "
      f"({r2b['share'].max():.3f})")

# ---------- Summary ----------
print('\n' + '='*70)
print('FINAL RANKINGS (share of both-male-majority pairs)')
print('='*70)
print('Row-level >0.5   :', {r['discipline']: round(r['share'],3) for _, r in primary.iterrows()})
print('Row-level >=0.5  :', {r['discipline']: round(r['share'],3) for _, r in r1.iterrows()})
print('Id-level (mean)  :', {r['discipline']: round(r['share'],3) for _, r in r2b.iterrows()})
