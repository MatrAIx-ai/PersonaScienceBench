"""
DiscoveryBench NLS Incarceration / Wealth analysis
Question: What kind of demographic disparities exist in median wealth in 1985
among individuals who were ever incarcerated?

Design (approved plan):
  1. Lead: within ever_jailed==1 demographic comparison of median composite_wealth_1985
     by race, by sex, and race x sex.
  2. Secondary context: ever-jailed vs never-jailed overall wealth gap + same splits
     for the never-jailed group.
  3. Main statistic: median including zero/negative wealth (real economic states),
     reported with n, median, IQR and bootstrap 95% CIs.
  4. Sensitivity: positive-wealth-only medians to see how zero-wealth share drives ordering.
  5. Explicit flagging of temporal ambiguity (ever_jailed 1985-1994 vs wealth 1985)
     and small subgroup counts.
"""
import pandas as pd
import numpy as np
import os, json

RNG = np.random.default_rng(2024)
W = "composite_wealth_1985"
OUT = os.path.join(os.path.dirname(os.path.abspath(__file__)), "results")

def boot_median_ci(values, n_resamples=10000, seed=2024):
    """Bootstrap 95% CI for the median."""
    rng = np.random.default_rng(seed)
    vals = np.asarray(values, dtype=float)
    if len(vals) == 0:
        return (np.nan, np.nan)
    boots = [np.median(rng.choice(vals, size=len(vals), replace=True))
             for _ in range(n_resamples)]
    return (np.percentile(boots, 2.5), np.percentile(boots, 97.5))

def med_table(sub, group_cols):
    rows = []
    for keys, g in sub.groupby(group_cols, sort=True):
        v = g[W]
        lo, hi = boot_median_ci(v.values, seed=2024 + len(rows))
        rows.append({
            "group": " x ".join(str(k) for k in (keys if isinstance(keys, tuple) else [keys])),
            "n": int(len(g)),
            "median": float(v.median()),
            "IQR": f"[{v.quantile(.25):.0f}, {v.quantile(.75):.0f}]",
            "mean": float(v.mean()),
            "boot_CI95": f"[{lo:.0f}, {hi:.0f}]",
            "n_zero": int((v == 0).sum()),
            "n_neg": int((v < 0).sum()),
            "pct_zero": round(100 * (v == 0).mean(), 1),
        })
    return pd.DataFrame(rows)

def main():
    df = pd.read_csv("data/nls_incarceration_processed.csv")
    os.makedirs(OUT, exist_ok=True)
    report = {}

    # ---------- 0. Overview ----------
    report["overview"] = {
        "rows": int(len(df)), "cols": int(df.shape[1]),
        "missing_any": bool(df.isna().any().any()),
        "ever_jailed_counts": {int(k): int(v) for k, v in df["ever_jailed"].value_counts().items()},
        "race_counts": {k: int(v) for k, v in df["race"].value_counts().items()},
        "sex_counts": {k: int(v) for k, v in df["sex"].value_counts().items()},
        "wealth1985": {
            "mean": float(df[W].mean()), "median": float(df[W].median()),
            "min": int(df[W].min()), "max": int(df[W].max()),
            "n_zero": int((df[W] == 0).sum()), "n_negative": int((df[W] < 0).sum()),
            "n_positive": int((df[W] > 0).sum()),
        },
    }

    ej = df[df["ever_jailed"] == 1]
    nv = df[df["ever_jailed"] == 0]

    # ---------- 1. Lead: within ever-jailed demographic medians ----------
    t_race  = med_table(ej, ["race"])
    t_sex   = med_table(ej, ["sex"])
    t_race_x_sex = med_table(ej, ["race", "sex"])
    report["within_ever_jailed_race"] = t_race.to_dict("records")
    report["within_ever_jailed_sex"] = t_sex.to_dict("records")
    report["within_ever_jailed_race_x_sex"] = t_race_x_sex.to_dict("records")

    # ---------- 2. Secondary context: ever vs never ----------
    lo, hi = boot_median_ci(ej[W].values, seed=1)
    lo2, hi2 = boot_median_ci(nv[W].values, seed=2)
    diffs = [np.median(RNG.choice(ej[W].values, len(ej), replace=True))
             - np.median(RNG.choice(nv[W].values, len(nv), replace=True))
             for _ in range(10000)]
    report["context_ever_vs_never"] = {
        "ever_n": int(len(ej)), "ever_median": float(ej[W].median()),
        "ever_CI95": [float(lo), float(hi)],
        "never_n": int(len(nv)), "never_median": float(nv[W].median()),
        "never_CI95": [float(lo2), float(hi2)],
        "median_diff_ever_minus_never": float(ej[W].median() - nv[W].median()),
        "diff_CI95": [float(np.percentile(diffs, 2.5)), float(np.percentile(diffs, 97.5))],
    }
    # same race/sex splits within never-jailed (context)
    report["never_jailed_race"] = med_table(nv, ["race"]).to_dict("records")
    report["never_jailed_sex"] = med_table(nv, ["sex"]).to_dict("records")
    # temporal context
    report["temporal_medians"] = {
        "ever": {c: float(ej[c].median()) for c in ["composite_wealth_1985","composite_wealth_1990","composite_wealth_1996"]},
        "never": {c: float(nv[c].median()) for c in ["composite_wealth_1985","composite_wealth_1990","composite_wealth_1996"]},
    }

    # ---------- 3. Sensitivity: positive-wealth-only ----------
    ej_pos = ej[ej[W] > 0]
    t_race_pos  = med_table(ej_pos, ["race"])
    t_sex_pos   = med_table(ej_pos, ["sex"])
    report["sensitivity_positive_only_race"] = t_race_pos.to_dict("records")
    report["sensitivity_positive_only_sex"] = t_sex_pos.to_dict("records")

    with open(os.path.join(OUT, "report.json"), "w") as f:
        json.dump(report, f, indent=2)

    # ---------- Print a readable summary ----------
    print("=" * 78)
    print("LEAD: within EVER-JAILED, median composite_wealth_1985 by RACE")
    print(t_race.to_string(index=False))
    print("\nby SEX")
    print(t_sex.to_string(index=False))
    print("\nby RACE x SEX")
    print(t_race_x_sex.to_string(index=False))
    print("\n" + "=" * 78)
    print("CONTEXT: ever-jailed vs never-jailed")
    print(json.dumps(report["context_ever_vs_never"], indent=2))
    print("\nnever-jailed by race (context)")
    print(pd.DataFrame(report["never_jailed_race"]).to_string(index=False))
    print("\nnever-jailed by sex (context)")
    print(pd.DataFrame(report["never_jailed_sex"]).to_string(index=False))
    print("\ntemporal medians (1985/1990/1996):")
    print(json.dumps(report["temporal_medians"], indent=2))
    print("\n" + "=" * 78)
    print("SENSITIVITY: POSITIVE-wealth-only, within ever-jailed")
    print("by race (excludes zero/negative wealth)")
    print(t_race_pos.to_string(index=False))
    print("by sex")
    print(t_sex_pos.to_string(index=False))

    # zero-wealth share breakdown for interpretation
    print("\nZero-wealth share among ever-jailed by race:")
    for r in ["white", "black", "hipanic"]:
        g = ej[ej["race"] == r][W]
        print(f"  {r}: n={len(g)}, median={g.median():.0f}, n_zero={int((g==0).sum())} "
              f"({100*(g==0).mean():.1f}%), n_neg={int((g<0).sum())}")
    print("Zero-wealth share among ever-jailed by sex:")
    for s in ["male", "female"]:
        g = ej[ej["sex"] == s][W]
        print(f"  {s}: n={len(g)}, median={g.median():.0f}, n_zero={int((g==0).sum())} "
              f"({100*(g==0).mean():.1f}%), n_neg={int((g<0).sum())}")

    print(f"\nReport JSON saved to {OUT}/report.json")
    print("DONE: analysis executed successfully, table rows computed.")

if __name__ == "__main__":
    main()
