import pandas as pd
import numpy as np

df = pd.read_csv('/workspace/data/nls_incarceration_processed.csv')
b = df[df['race']=='black'].copy()
wc = ['composite_wealth_1985','composite_wealth_1990','composite_wealth_1996']

print("BLACK n by ever_jailed:", b['ever_jailed'].value_counts().to_dict())
print("\nBLACK wealth percentiles by ever_jailed:")
for j in [0,1]:
    sub = b[b['ever_jailed']==j]
    print(f"\n--- ever_jailed={j} (n={len(sub)}) ---")
    for c in wc:
        q = sub[c].quantile([0,.25,.5,.75,.95,1]).round(0)
        print(f"  {c}: mean={sub[c].mean():.0f} median={sub[c].median():.0f}")
        print(f"      percentiles: {q.to_dict()}  nzero={(sub[c]==0).sum()} nneg={(sub[c]<0).sum()}")

# difference over time (1996 - 1985) for black
b['d_90_85'] = b['composite_wealth_1990'] - b['composite_wealth_1985']
b['d_96_85'] = b['composite_wealth_1996'] - b['composite_wealth_1985']
print("\nBLACK change 1985->1990, 1985->1996 by ever_jailed:")
print(b.groupby('ever_jailed')[['d_90_85','d_96_85']].agg(['mean','median']).to_string())

# Proxy income/economic level: 1985 wealth terciles among black
print("\nProxy economic strata using 1985 wealth terciles among black:")
terc = pd.qcut(b['composite_wealth_1985'], 3, labels=['Low','Mid','High'])
b['econ'] = terc
ct = pd.crosstab(b['econ'], b['ever_jailed'])
ct['jail_rate'] = (ct[1]/(ct[0]+ct[1])*100).round(2)
print(ct.to_string())
print("\n1996 wealth by econ-tercile x ever_jailed (black):")
print(b.groupby(['econ','ever_jailed'], observed=True)['composite_wealth_1996'].agg(['mean','median','count']).round(0).to_string())
print("\n1990 wealth by econ-tercile x ever_jailed (black):")
print(b.groupby(['econ','ever_jailed'], observed=True)['composite_wealth_1990'].agg(['mean','median','count']).round(0).to_string())
