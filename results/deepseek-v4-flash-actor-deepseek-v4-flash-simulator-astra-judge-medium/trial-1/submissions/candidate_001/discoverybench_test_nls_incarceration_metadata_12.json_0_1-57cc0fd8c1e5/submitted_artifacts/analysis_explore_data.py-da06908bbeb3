import pandas as pd
import numpy as np

pd.set_option('display.width', 200)
pd.set_option('display.max_columns', 20)

df = pd.read_csv('/workspace/data/nls_incarceration_processed.csv')
print("SHAPE:", df.shape)
print("\nDTYPES:\n", df.dtypes)
print("\nMISSING VALUES PER COLUMN:\n", df.isna().sum())
print("\nUNIQUE VALUES per categorical:")
for c in ['race','sex','ever_jailed']:
    print(f"  {c}: {df[c].unique()}  counts:\n{df[c].value_counts(dropna=False).to_string()}")

wealth_cols = ['composite_wealth_1985','composite_wealth_1990','composite_wealth_1996']
print("\nDESCRIPTIVES (all rows):")
print(df[wealth_cols].describe(percentiles=[.01,.05,.25,.5,.75,.95,.99]).to_string())

print("\nNEGATIVE / ZERO / EXTREME values:")
for c in wealth_cols:
    s = df[c]
    print(f"  {c}: n={s.notna().sum()}, neg={ (s<0).sum() }, zero={ (s==0).sum() }, >1e6={(s>1_000_000).sum()}, min={s.min()}, max={s.max()}")

print("\nMEANS/MEDIANS by RACE:")
g = df.groupby('race')[wealth_cols].agg(['mean','median','count'])
print(g.to_string())

print("\nMEANS/MEDIANS by EVER_JAILED:")
g = df.groupby('ever_jailed')[wealth_cols].agg(['mean','median','count'])
print(g.to_string())

print("\nMEANS/MEDIANS by RACE x EVER_JAILED:")
g = df.groupby(['race','ever_jailed'])[wealth_cols].agg(['mean','median','count'])
print(g.to_string())

print("\nCROSS-TAB race x ever_jailed x sex:")
print(pd.crosstab([df['race'], df['sex']], df['ever_jailed']).to_string())

# black only detailed
black = df[df['race']=='black']
print("\nBLACK SUBSET shape:", black.shape, "ever_jailed counts:\n", black['ever_jailed'].value_counts().to_string())
print("BLACK means/medians by ever_jailed:\n", black.groupby('ever_jailed')[wealth_cols].agg(['mean','median','count']).to_string())
