import pandas as pd
import numpy as np
from scipy import stats

df = pd.read_csv('/workspace/data/nls_incarceration_processed.csv')
b = df[df['race'] == 'black'].copy()
wc = ['composite_wealth_1985','composite_wealth_1990','composite_wealth_1996']
male = (b['sex'] == 'male').astype(int)

print("="*70)
print("BLACK: ever vs never jailed — means / medians / n per snapshot")
print("="*70)
rows = []
for j in [0, 1]:
    sub = b[b['ever_jailed'] == j]
    r = {'n': len(sub)}
    for c in wc:
        r[f'{c}_mean'] = sub[c].mean()
        r[f'{c}_median'] = sub[c].median()
    rows.append(r)
tbl = pd.DataFrame(rows, index=['never_jailed','ever_jailed'])
print(tbl.round(0).to_string())
print("\nWilcoxon (Mann-Whitney) ever vs never, black, per snapshot:")
for c in wc:
    u, p = stats.mannwhitneyu(b[b['ever_jailed']==1][c], b[b['ever_jailed']==0][c], alternative='two-sided')
    print(f"  {c}: U={u:.0f}, p={p:.3e}")

print("\n" + "="*70)
print("BLACK: 1985-wealth tercile x ever_jailed — 1990 & 1996 stats, within-tercile gap")
print("="*70)
b['econ'] = pd.qcut(b['composite_wealth_1985'], 3, labels=['Low','Mid','High'])
for yr in ['1990','1996']:
    c = f'composite_wealth_{yr}'
    print(f"\n--- {yr} composite wealth ---")
    out = {}
    for econ in ['Low','Mid','High']:
        for j in [0, 1]:
            sub = b[(b['econ']==econ) & (b['ever_jailed']==j)]
            out[(econ, j)] = dict(n=len(sub), mean=sub[c].mean(), median=sub[c].median())
    t = pd.DataFrame(out).T.round(0)
    print(t.to_string())
    print("within-tercile median gap (never - ever):")
    for econ in ['Low','Mid','High']:
        gap_m = out[(econ,0)]['median'] - out[(econ,1)]['median']
        gap_a = out[(econ,0)]['mean'] - out[(econ,1)]['mean']
        print(f"  {econ}: median gap={gap_m:.0f}, mean gap={gap_a:.0f} (n never={out[(econ,0)]['n']}, n ever={out[(econ,1)]['n']})")
    print("Wilcoxon p within tercile:")
    for econ in ['Low','Mid','High']:
        u, p = stats.mannwhitneyu(b[(b['econ']==econ)&(b['ever_jailed']==1)][c],
                                  b[(b['econ']==econ)&(b['ever_jailed']==0)][c],
                                  alternative='two-sided')
        print(f"  {econ}: p={p:.3f}")

print("\n" + "="*70)
print("OLS: ever_jailed -> wealth, black, controlling 1985 wealth + sex")
print("="*70)
import statsmodels.api as sm
X = b[['ever_jailed','composite_wealth_1985']].copy()
X['male'] = male
X['const'] = 1.0
for yr in ['1990','1996']:
    y = b[f'composite_wealth_{yr}']
    m = sm.OLS(y, X).fit()
    print(f"\nOutcome composite_wealth_{yr}  (n={len(b)})")
    print(f"  ever_jailed coef = {m.params['ever_jailed']:.1f}  se = {m.bse['ever_jailed']:.1f}  p = {m.pvalues['ever_jailed']:.3e}  t={m.tvalues['ever_jailed']:.2f}")
    print(f"  composite_wealth_1985 coef = {m.params['composite_wealth_1985']:.4f}  p={m.pvalues['composite_wealth_1985']:.3e}")
    print(f"  male coef = {m.params['male']:.1f}  p={m.pvalues['male']:.3f}")
    print(f"  R2={m.rsquared:.3f}")

# Robustness: winsorize each wealth at 99th percentile, recompute OLS
print("\n--- Robustness: 99th-percentile winsorized outcomes ---")
def winsor(s, p=99):
    lo, hi = np.percentile(s, [100-p, p])
    return s.clip(lo, hi)
for yr in ['1990','1996']:
    y = winsor(b[f'composite_wealth_{yr}'])
    m = sm.OLS(y, X).fit()
    print(f"Outcome wealth_{yr} (winsorized): ever_jailed coef = {m.params['ever_jailed']:.1f}  p = {m.pvalues['ever_jailed']:.3e}")
