"""Final analysis for DiscoveryBench: nls_incarceration_processed.csv
Question: Between which years did the largest increases in median wealth occur among black females?
"""
import pandas as pd

df = pd.read_csv('data/nls_incarceration_processed.csv')
sub = df[(df['race'] == 'black') & (df['sex'] == 'female')].copy()
assert len(sub) == 1548, f"unexpected subset size {len(sub)}"

cols = ['composite_wealth_1985', 'composite_wealth_1990', 'composite_wealth_1996']
years = [1985, 1990, 1996]

medians = {c: sub[c].median() for c in cols}
print("Subset n =", len(sub))
for c, y in zip(cols, years):
    s = sub[c]
    print(f"year {y}: median={medians[c]:.0f} | mean={s.mean():.1f} | "
          f"zeros={(s==0).sum()} ({(s==0).mean()*100:.1f}%) | "
          f"neg={(s<0).sum()} | min={s.min()} | max={s.max()}")
print("nulls per col:", sub[cols].isnull().sum().to_dict())

# Year-on-year changes in median (absolute dollars)
abs_85_90 = medians['composite_wealth_1990'] - medians['composite_wealth_1985']
abs_90_96 = medians['composite_wealth_1996'] - medians['composite_wealth_1990']
print(f"\nAbsolute median change 1985->1990: {abs_85_90:.0f}  (1985 median = {medians['composite_wealth_1985']:.0f})")
print(f"Absolute median change 1990->1996: {abs_90_96:.0f}  (1990 median = {medians['composite_wealth_1990']:.0f})")
print(f"Larger absolute window: {'1985->1990' if abs_85_90 > abs_90_96 else '1990->1996'}")

# Relative changes (supporting context only; fragile due to tiny 1985 base)
rel_85_90 = abs_85_90 / medians['composite_wealth_1985'] * 100
rel_90_96 = abs_90_96 / medians['composite_wealth_1990'] * 100
print(f"Relative change 1985->1990: {rel_85_90:.1f}% ; 1990->1996: {rel_90_96:.1f}%")

# Sanity checks vs inspection
assert abs_85_90 == 2425 and abs_90_96 == 1400
print("\nSanity check vs inspection table: PASSED (85->90 = +$2,425; 90->96 = +$1,400)")
