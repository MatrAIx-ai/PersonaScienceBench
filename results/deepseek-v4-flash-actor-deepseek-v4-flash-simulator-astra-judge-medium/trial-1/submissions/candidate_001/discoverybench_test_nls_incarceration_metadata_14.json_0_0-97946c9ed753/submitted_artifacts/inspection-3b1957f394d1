"""Inspection (plan-stage) for nls_incarceration_processed.csv on black females."""
import pandas as pd

df = pd.read_csv('data/nls_incarceration_processed.csv')
print("shape:", df.shape)
print(df['race'].value_counts(dropna=False))
print(df['sex'].value_counts(dropna=False))

sub = df[(df['race'] == 'black') & (df['sex'] == 'female')].copy()
print("black+female n =", len(sub))
print("nulls:\n", sub.isnull().sum())

for col in ['composite_wealth_1985', 'composite_wealth_1990', 'composite_wealth_1996']:
    s = sub[col]
    print(f"{col}: median={s.median()} mean={s.mean():.1f} min={s.min()} max={s.max()} "
          f"zeros={(s == 0).sum()} neg={(s < 0).sum()} pos={(s > 0).sum()}")

m = {c: sub[c].median() for c in ['composite_wealth_1985', 'composite_wealth_1990', 'composite_wealth_1996']}
d1 = m['composite_wealth_1990'] - m['composite_wealth_1985']
d2 = m['composite_wealth_1996'] - m['composite_wealth_1990']
print("median deltas 85->90:", d1, " 90->96:", d2)
print("rel change 85->90 (%):", d1 / m['composite_wealth_1985'] * 100,
      " 90->96 (%):", d2 / m['composite_wealth_1990'] * 100)
