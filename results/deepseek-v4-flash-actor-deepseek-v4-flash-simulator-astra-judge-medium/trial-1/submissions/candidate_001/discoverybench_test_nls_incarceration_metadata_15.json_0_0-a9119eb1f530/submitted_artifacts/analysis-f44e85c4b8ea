#!/usr/bin/env python3
"""
Wealth inequality change among white males and females, 1990 -> 1996.
NLS-derived processed data: data/nls_incarceration_processed.csv

Primary reading: WITHIN-GROUP inequality for white males and white females,
plus the gender wealth gap (F/M of mean and median) as between-group lens.
"""
import pandas as pd
import numpy as np

RNG = np.random.default_rng(42)
PATH = "data/nls_incarceration_processed.csv"

# ---------- helpers ----------
def gini(s):
    s = np.asarray(s, dtype=float)
    n = len(s)
    if n == 0 or s.sum() == 0:
        return np.nan
    ss = np.sort(s)
    idx = np.arange(1, n + 1)
    return (2 * np.sum(idx * ss) - (n + 1) * np.sum(ss)) / (n * np.sum(ss))

def top10_share(s):
    s = np.asarray(s, dtype=float)
    if s.sum() == 0:
        return np.nan
    thr = np.quantile(s, 0.9)
    return s[s >= thr].sum() / s.sum()

def p_ratio(s, hi=0.9, lo=0.5):
    s = np.asarray(s, dtype=float)
    denom = np.quantile(s, lo)
    if denom == 0:
        return np.inf
    return np.quantile(s, hi) / denom

def boot_change(fn, s90, s96, iters=4000, seed=42):
    """Bootstrap 95% CI for fn(s96)-fn(s90)."""
    rng = np.random.default_rng(seed)
    n90, n96 = len(s90), len(s96)
    a90 = np.asarray(s90, dtype=float); a96 = np.asarray(s96, dtype=float)
    d = np.empty(iters)
    for i in range(iters):
        b90 = a90[rng.integers(0, n90, n90)]
        b96 = a96[rng.integers(0, n96, n96)]
        v90 = fn(b90); v96 = fn(b96)
        d[i] = v96 - v90 if not (np.isnan(v90) or np.isnan(v96)) else np.nan
    d = d[~np.isnan(d)]
    return dict(est=d.mean(), lo=np.percentile(d, 2.5), hi=np.percentile(d, 97.5), n=len(d))

# ---------- load ----------
df = pd.read_csv(PATH)
w = df[df["race"] == "white"].copy()
YEARS = ["composite_wealth_1990", "composite_wealth_1996"]
YEARTAG = {"composite_wealth_1990": "1990", "composite_wealth_1996": "1996"}

print("=" * 78)
print("DATA SNAPSHOT")
print("=" * 78)
print("Rows:", df.shape, "| duplicates:", int(df.duplicated().sum()),
      "| all-three-wealth==0 rows:", int((df[YEARS + ["composite_wealth_1985"]] == 0).all(axis=1).sum()))
print("Whites:", len(w), "| male:", int((w.sex == "male").sum()),
      "| female:", int((w.sex == "female").sum()))
print("White jailed: male", int(((w.sex == "male") & (w.ever_jailed == 1)).sum()),
      "female", int(((w.sex == "female") & (w.ever_jailed == 1)).sum()))

# ---------- 1) headline within-group metrics ----------
print("\n" + "=" * 78)
print("TABLE 1. WITHIN-GROUP WEALTH INEQUALITY, WHITE MALES & FEMALES (raw: zeros/negatives kept)")
print("=" * 78)
rows = []
for sex in ["male", "female"]:
    sub = w[w.sex == sex]
    for yr in YEARS:
        s = sub[yr]
        med, mean = s.median(), s.mean()
        rows.append({
            "sex": sex, "year": YEARTAG[yr], "n": len(s),
            "mean": mean, "median": med,
            "gini": gini(s), "cv": s.std() / mean,
            "p90_p50": p_ratio(s, 0.9, 0.5), "p75_p25": p_ratio(s, 0.75, 0.25),
            "top10_share": top10_share(s), "skew": s.skew(),
            "pct_zero": 100 * (s == 0).mean(), "pct_neg": 100 * (s < 0).mean(),
            "mean_over_median": mean / med if med != 0 else np.inf,
        })
t1 = pd.DataFrame(rows)
print(t1.round(3).to_string(index=False))

print("\nTABLE 1b. CHANGES 1990 -> 1996 (within-group), raw treatment")
cols = ["mean", "median", "gini", "cv", "p90_p50", "p75_p25", "top10_share",
        "skew", "pct_zero", "pct_neg"]
for sex in ["male", "female"]:
    a = t1[t1.sex == sex].set_index("year")
    delta = (a.loc["1996", cols] - a.loc["1990", cols]).rename("delta")
    ratio = (a.loc["1996", cols] / a.loc["1990", cols]).rename("ratio")
    print(f"\n{sex}: delta(96-90)\n{delta.round(3).to_string()}")
    print(f"{sex}: ratio(96/90)\n{ratio.round(3).to_string()}")

# ---------- 2) gender wealth gap ----------
print("\n" + "=" * 78)
print("TABLE 2. GENDER WEALTH GAP (FEMALE / MALE), WHITE subsample")
print("=" * 78)
for yr in YEARS:
    fm = w[w.sex == "female"][yr]; mm = w[w.sex == "male"][yr]
    print(f"{YEARTAG[yr]}: F mean {fm.mean():,.0f} | M mean {mm.mean():,.0f} | "
          f"F/M mean {fm.mean()/mm.mean():.3f} | "
          f"F med {fm.median():,.0f} | M med {mm.median():,.0f} | "
          f"F/M med {fm.median()/mm.median():.3f}")
fm96 = w[w.sex == "female"]["composite_wealth_1996"]; fm90 = w[w.sex == "female"]["composite_wealth_1990"]
mm96 = w[w.sex == "male"]["composite_wealth_1996"];   mm90 = w[w.sex == "male"]["composite_wealth_1990"]
print(f"Mean gap change: {(fm96.mean()/mm96.mean())/(fm90.mean()/mm90.mean()):.3f}x "
      f"(from {fm90.mean()/mm90.mean():.3f} to {fm96.mean()/mm96.mean():.3f})")
print(f"Median gap change: {(fm96.median()/mm96.median())/(fm90.median()/mm90.median()):.3f}x "
      f"(from {fm90.median()/mm90.median():.3f} to {fm96.median()/mm96.median():.3f})")

# ---------- 3) robustness ----------
print("\n" + "=" * 78)
print("TABLE 3. ROBUSTNESS: GINI UNDER ALTERNATIVE TREATMENTS")
print("=" * 78)
for sex in ["male", "female"]:
    sub = w[w.sex == sex]
    for yr in YEARS:
        s = sub[yr]
        s0 = s[s >= 0]; sp = s[s > 0]
        print(f"{sex} {YEARTAG[yr]}: gini(all)={gini(s):.3f}  gini(>=0)={gini(s0):.3f}  "
              f"gini(>0)={gini(sp):.3f}  n_pos={len(sp)}")

print("\nTABLE 3b. ROBUSTNESS: DEDUP (exact duplicate rows removed)")
w_d = w.drop_duplicates()
print(f"after dedup: whites n={len(w_d)} (male {int((w_d.sex=='male').sum())}, "
      f"female {int((w_d.sex=='female').sum())})")
for sex in ["male", "female"]:
    sd = w_d[w_d.sex == sex]
    g90, g96 = gini(sd["composite_wealth_1990"]), gini(sd["composite_wealth_1996"])
    m90, m96 = sd["composite_wealth_1990"].median(), sd["composite_wealth_1996"].median()
    print(f"{sex}: gini 1990={g90:.3f} -> 1996={g96:.3f} | "
          f"median 1990={m90:,.0f} -> 1996={m96:,.0f}")

print("\nTABLE 3c. ROBUSTNESS: positive-wealth conditional medians/means (whites)")
for sex in ["male", "female"]:
    sub = w[w.sex == sex]
    for yr in YEARS:
        sp = sub[yr]; sp = sp[sp > 0]
        print(f"{sex} {YEARTAG[yr]}: n_pos={len(sp)} mean={sp.mean():,.0f} median={sp.median():,.0f}")

print("\nTABLE 3d. ROBUSTNESS: excluding the tiny jailed subgroup (whites)")
w_n = w[w.ever_jailed == 0]
for sex in ["male", "female"]:
    sd = w_n[w_n.sex == sex]
    g90, g96 = gini(sd["composite_wealth_1990"]), gini(sd["composite_wealth_1996"])
    print(f"{sex} (never-jailed): gini 1990={g90:.3f} -> 1996={g96:.3f} | n={len(sd)}")

# ---------- 4) bootstrap CIs on 1990->1996 changes ----------
print("\n" + "=" * 78)
print("TABLE 4. BOOTSTRAP 95% CI OF 1990->1996 CHANGES (raw treatment, 4000 iters)")
print("=" * 78)
for sex in ["male", "female"]:
    a90 = w[(w.sex == sex)][YEARS[0]]
    a96 = w[(w.sex == sex)][YEARS[1]]
    med_d = boot_change(lambda s: np.median(s), a90, a96)
    gini_d = boot_change(gini, a90, a96)
    cv_d = boot_change(lambda s: np.std(s) / np.mean(s), a90, a96)
    p9050_d = boot_change(lambda s: p_ratio(s, 0.9, 0.5), a90, a96)
    t10_d = boot_change(top10_share, a90, a96)
    print(f"\n{sex}:")
    for name, b in [("median ($)", med_d), ("gini", gini_d),
                    ("cv", cv_d), ("p90/p50", p9050_d), ("top10_share", t10_d)]:
        print(f"  {name:<12} delta = {b['est']:+.4f}  95% CI [{b['lo']:+.4f}, {b['hi']:+.4f}]")

# gender-gap ratio bootstrap
def gap_mean(s96, s90, m96, m90):
    return None
print("\nGender-gap change (mean F/M ratio, 1990->1996), bootstrap CI on ratio 1996/1990:")
fm = w[w.sex == "female"]; mm = w[w.sex == "male"]
rng = np.random.default_rng(7)
iters = 4000
r = np.empty(iters)
for i in range(iters):
    f90 = fm["composite_wealth_1990"].sample(frac=1, replace=True, random_state=rng)
    f96 = fm["composite_wealth_1996"].sample(frac=1, replace=True, random_state=rng)
    m90 = mm["composite_wealth_1990"].sample(frac=1, replace=True, random_state=rng)
    m96 = mm["composite_wealth_1996"].sample(frac=1, replace=True, random_state=rng)
    ratio96 = (f96.mean()/m96.mean()); ratio90 = (f90.mean()/m90.mean())
    r[i] = ratio96/ratio90
print(f"  mean F/M gap ratio 1996/1990: est {r.mean():.3f}  95% CI [{np.percentile(r,2.5):.3f}, {np.percentile(r,97.5):.3f}]")

print("\nDONE")

