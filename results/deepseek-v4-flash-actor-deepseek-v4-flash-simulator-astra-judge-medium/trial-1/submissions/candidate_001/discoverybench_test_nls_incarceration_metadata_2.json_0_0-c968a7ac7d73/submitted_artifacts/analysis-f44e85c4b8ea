"""
NLSY79 Incarceration & Wealth analysis (DiscoveryBench: nls_incarceration)
Q: In which years were individuals with a criminal record found to have
   significantly lower wealth compared to those without?

Group definition: ever_jailed == 1 (jailed sometime 1985-1994) is the PROXY
for 'criminal record' available in this 6-column processed file.
NOTE: the residence-based 'Jail'/detention-facilities gauge from domain
knowledge cannot be applied here because the file contains no residence field.
"""
import numpy as np
import pandas as pd
import scipy.stats as st

RNG = np.random.default_rng(42)
ALPHA = 0.05
YEARS = ['composite_wealth_1985', 'composite_wealth_1990', 'composite_wealth_1996']
YLAB = {'composite_wealth_1985': '1985', 'composite_wealth_1990': '1990', 'composite_wealth_1996': '1996'}

df = pd.read_csv('data/nls_incarceration_processed.csv')
g0 = df[df.ever_jailed == 0]   # without criminal-proxy record
g1 = df[df.ever_jailed == 1]   # with criminal-proxy record (jailed 1985-1994)

L = []
def p(msg=''): L.append(str(msg))

p('='*80)
p('NLSY79 INCARCERATION vs WEALTH - FULL ANALYSIS (executed)')
p('Criminal-record PROXY: ever_jailed==1 (jailed 1985-1994), n=%d vs no-record n=%d'
  % (len(g1), len(g0)))
p('NOTE: residence-based "Jail" gauge not applicable; file has only 6 columns.')
p('='*80)

# ---------------- 1) Descriptive table ----------------
p('\n[1] DESCRIPTIVE STATISTICS (raw wealth)')
hdr = f"{'year':<6}{'group':<20}{'n':>6}{'mean':>13}{'median':>12}{'p25':>10}{'p75':>12}{'%zero':>8}{'%neg':>7}"
p(hdr); p('-'*len(hdr))
for y in YEARS:
    for lab, g in [('no record', g0[y]), ('record (jailed)', g1[y])]:
        p(f"{YLAB[y]:<6}{lab:<20}{len(g):>6}{g.mean():>13,.0f}{g.median():>12,.0f}"
          f"{g.quantile(.25):>10,.0f}{g.quantile(.75):>12,.0f}"
          f"{(g==0).mean()*100:>7.1f}%{(g<0).mean()*100:>6.1f}%")

# ---------------- 2) Primary tests ----------------
p('\n[2] PRIMARY - Mann-Whitney U per year (two-sided), Holm-Bonferroni across 3 years')
raw_p, stats = {}, {}
for y in YEARS:
    u, pv = st.mannwhitneyu(g1[y], g0[y], alternative='two-sided')
    raw_p[y] = pv
    n1, n2 = len(g1[y]), len(g0[y])
    cliff = (2.0*u - n1*n2)/(n1*n2)          # negative => jailed lower
    med_diff = g1[y].median() - g0[y].median()
    boot = np.empty(2000)
    for b in range(2000):
        s1 = g1[y].sample(n=n1, replace=True, random_state=int(RNG.integers(1, 10**9)))
        s0 = g0[y].sample(n=n2, replace=True, random_state=int(RNG.integers(1, 10**9)))
        boot[b] = s1.median() - s0.median()
    lo, hi = np.percentile(boot, [2.5, 97.5])
    stats[y] = dict(cliff=cliff, med_diff=med_diff, boot=(lo, hi))
    p(f"{YLAB[y]}: U={u:.0f}  p_raw={pv:.3e}  Cliff's d={cliff:+.3f}  "
      f"median_diff(jailed-minus-other)={med_diff:,.0f}  95% boot CI=[{lo:,.0f},{hi:,.0f}]")

# Holm-Bonferroni adjustment across the 3 years
order = sorted(YEARS, key=lambda y: raw_p[y])   # ascending raw p
adj = {}
for i, y in enumerate(order):                 # correct Holm step-down: max rule
    candidate = raw_p[y] * (len(YEARS) - i)
    adj[y] = candidate if i == 0 else max(candidate, adj[order[i-1]])
p('\nHolm-Bonferroni (family-wise alpha=0.05):')
sig = {}
for y in YEARS:
    sig[y] = (adj[y] < ALPHA) and (stats[y]['cliff'] < 0)
    p(f"  {YLAB[y]}: p_raw={raw_p[y]:.3e} -> p_holm={adj[y]:.3e}  "
      f"direction={'LOWER' if stats[y]['cliff']<0 else 'higher'}  significant={sig[y]}")

# ---------------- 3) Sensitivity ----------------
p('\n[3] SENSITIVITY ANALYSES')
p('--- Part A: chi-square on wealth<=0 vs >0 (jail status x category) ---')
for y in YEARS:
    cat = np.where(df[y]==0, 'zero', np.where(df[y]<0, 'negative', 'positive'))
    ct = pd.crosstab(df.ever_jailed, cat)
    chi, pvA, dof, _ = st.chi2_contingency(ct)
    j_le0 = (g1[y] <= 0).mean()*100
    o_le0 = (g0[y] <= 0).mean()*100
    p(f"  {YLAB[y]}: chi2={chi:.1f}, p={pvA:.3e};  P(wealth<=0): record={j_le0:.1f}%  no-record={o_le0:.1f}%  "
      f"[zero/neg cells: zero {ct.get('zero',{}).to_dict()} / neg {ct.get('negative',{}).to_dict() if 'negative' in ct else 'NA'}]")

p('--- Part B: Mann-Whitney on strictly positive wealth only ---')
for y in YEARS:
    a = g1[y][g1[y] > 0]; b = g0[y][g0[y] > 0]
    u, pvB = st.mannwhitneyu(a, b, alternative='two-sided')
    n1, n2 = len(a), len(b)
    cliff = (2*u - n1*n2)/(n1*n2)
    p(f"  {YLAB[y]}: n_pos(record)={len(a)}, n_pos(no-record)={len(b)}, U p={pvB:.3e}, Cliff's d={cliff:+.3f}")

p('--- Part C: Welch t-test on log1p(wealth+offset) ---')
for y in YEARS:
    off = max(0, -min(df[y].min(), g1[y].min(), g0[y].min())) + 1
    l1 = np.log1p(g1[y] + off); l0 = np.log1p(g0[y] + off)
    t, pvC = st.ttest_ind(l1, l0, equal_var=False)
    p(f"  {YLAB[y]}: Welch t={t:.3f}, p={pvC:.3e}  (offset=+{off})")

# ---------------- 4) Agreement + final hypothesis ----------------
p('\n[4] CONCLUSION TABLE (primary + sensitivity, jailed lower?)')
summary = {}
for y in YEARS:
    cat = np.where(df[y]==0, 'zero', np.where(df[y]<0, 'negative', 'positive'))
    _, pvA, _, _ = st.chi2_contingency(pd.crosstab(df.ever_jailed, cat))
    a = g1[y][g1[y] > 0]; b = g0[y][g0[y] > 0]
    _, pvB = st.mannwhitneyu(a, b, alternative='two-sided')
    off = max(0, -min(df[y].min(), g1[y].min(), g0[y].min())) + 1
    _, pvC = st.ttest_ind(np.log1p(g1[y]+off), np.log1p(g0[y]+off), equal_var=False)
    summary[y] = dict(holm=adj[y], cliff=stats[y]['cliff'], partA=pvA, partB=pvB, partC=pvC,
                      sens_sig=sum(x < ALPHA for x in (pvA, pvB, pvC)), significant=sig[y])
    p(f"  {YLAB[y]}: p_holm={adj[y]:.3e}  Cliff's d={stats[y]['cliff']:+.3f}  primary_sig={sig[y]}  |  "
      f"sensitivity p: partA={pvA:.2e} partB={pvB:.2e} partC={pvC:.2e}  (sig {summary[y]['sens_sig']}/3)")

sig_years = [YLAB[y] for y in YEARS if sig[y]]
hypothesis = (
    f"Individuals with a criminal record (proxy: jailed 1985-1994, ever_jailed==1) had significantly "
    f"lower wealth than those without a criminal record in "
    f"{', '.join(sig_years) if sig_years else 'none of the observed years'} "
    f"(two-sided Mann-Whitney U with Holm-Bonferroni adjustment across 1985/1990/1996 at alpha=0.05; "
    f"median wealth in the criminal-record group was lower in {sum(stats[y]['cliff']<0 for y in YEARS)}/3 years)."
)
p('\n' + '='*80)
p('FINAL HYPOTHESIS (natural-language):')
p(hypothesis)
p('='*80)

with open('analysis_output.txt', 'w') as f:
    f.write('\n'.join(L) + '\n')
print('\n'.join(L))
