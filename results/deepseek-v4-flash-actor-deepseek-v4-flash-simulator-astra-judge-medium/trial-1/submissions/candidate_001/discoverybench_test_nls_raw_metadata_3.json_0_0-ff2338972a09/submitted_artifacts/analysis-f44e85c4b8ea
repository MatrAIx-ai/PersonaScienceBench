import pandas as pd, numpy as np, warnings
warnings.filterwarnings('ignore')
import statsmodels.formula.api as smf

df = pd.read_csv('data/nls_raw.csv')
hgc="Highest grade completed, 1979"; agev="Age of respondent, 1979"; race="Racial/ethnic cohort, 1979"
df['black']=(df[race]==1).astype(float); df['hisp']=(df[race]==2).astype(float)
df['male']=(df['Sex of respondent, 1979']==1).astype(float); df['age']=df[agev]
df['hgc']=df[hgc].replace(95,np.nan)
df['O2']=(df['hgc']>=13).astype(float); df['O1']=(df['hgc']>=16).astype(float)
df['loginc']=np.log1p(df["Total net family income, previous calendar year, 1979"])
df['mothed']=df["Highest grade completed by respondent's mother, 1979"]
df['fathed']=df["Highest grade completed by respondent's father, 1979"]
df['fsize']=df["Family size, 1979"]
asv=["ASVAB - Arithmetic Reasoning Z Score (rounded), 1981","ASVAB - Word Knowledge Z Score (rounded), 1981",
     "ASVAB - Paragraph Comprehension Z Score (rounded), 1981","ASVAB - Mathematics Knowledge Z Score (rounded), 1981"]
df['asvab']=df[asv].mean(axis=1)
r="Rank in class last year attended at this school, 1981"; s="Number of students in class last year attended at this school, 1981"
mm=df[r].notna() & df[s].notna() & (df[s]>1); df['rank_pct']=np.where(mm,(df[r]-1)/(df[s]-1),np.nan)
df['standing']=1.0-df['rank_pct']
df['ever_college_housing']=df[[c for c in df.columns if c.startswith("Type of residence")]].isin([3.0]).any(axis=1).astype(float)
for c in ['loginc','mothed','fathed','fsize','asvab','standing']:
    df[c+'_z']=(df[c]-df[c].mean())/df[c].std()
df['ses_index']=(df['loginc_z']+df['mothed_z']+df['fathed_z']-df['fsize_z'])/4.0

def fit(data,outcome='O2',add='',base='black + hisp + male + age'):
    f=f"{outcome} ~ {base}"+((" + "+add) if add else "")
    return smf.logit(f,data=data).fit(disp=0), f

def ame(mod,data,var,step=1.0):
    if mod.params[var] is None: return np.nan
    if var in ('black','hisp','male'):
        d=data.copy(); p0=mod.predict(d.assign(**{var:0.0})); p1=mod.predict(d.assign(**{var:1.0}))
    else:
        d=data.copy(); p0=mod.predict(d); p1=mod.predict(d.assign(**{var:d[var]+step}))
    return float((p1-p0).mean())

PRED = ['black','hisp','male','age','loginc_z','mothed_z','fathed_z','fsize_z','asvab_z','standing_z']
def ladder(data,outcome='O2'):
    rows=[]
    for tag,add in [('M0',''),('M1','loginc_z + mothed_z + fathed_z + fsize_z'),
                    ('M2','loginc_z + mothed_z + fathed_z + fsize_z + asvab_z'),
                    ('M2r','loginc_z + mothed_z + fathed_z + fsize_z + asvab_z + standing_z')]:
        mod,f=fit(data,outcome,add)
        row={'model':tag,'n':int(mod.nobs),'O2_rate':float(data['O2'].mean()) if outcome=='O2' else np.nan}
        for v in PRED:
            if v in mod.params.index:
                row[f'{v}_b']=float(mod.params[v]); row[f'{v}_se']=float(mod.bse[v])
                row[f'{v}_p']=float(mod.pvalues[v]); row[f'{v}_AME']=ame(mod,data,v)
        rows.append(row)
    return rows

def att(rows,var,c_from,c_to):
    b1=[r for r in rows if r['model']==c_from][0].get(f'{var}_b'); b2=[r for r in rows if r['model']==c_to][0].get(f'{var}_b')
    if b1 is None or b2 is None or b1==0: return np.nan
    return (b1-b2)/abs(b1)*100.0

# ---------- PRIMARY ----------
prim=df[(df['age']>=20)&df[['loginc','mothed','fathed','asvab']].notna().all(axis=1)].copy()
print("="*112); print("PRIMARY: age>=20 complete-case (income|parent-ed|ASVAB); outcome O2 = HGC1979>=13 (college-track)")
print("="*112)
print(f"n={len(prim)}  O2={prim['O2'].mean():.3f}   O1(HGC>=16)={int(prim['O1'].sum())} cases (descriptive only)")
for lab,cond in [('Black',prim['black']==1),('Hisp',prim['hisp']==1),('NonB/NonH',(prim['black']==0)&(prim['hisp']==0))]:
    print(f"  {lab}: O2={prim.loc[cond,'O2'].mean():.3f} (n={int(cond.sum())})  ASVAB_z={prim.loc[cond,'asvab_z'].mean():.2f}  loginc={prim.loc[cond,'loginc'].mean():.2f}  mothed={prim.loc[cond,'mothed'].mean():.1f}")
rows=ladder(prim)
for x in rows:
    print(f"[{x['model']}] n={x['n']} || "+" | ".join(f"{v}={x[f'{v}_b']:+.3f}(AME {x[f'{v}_AME']:+.3f},p {x[f'{v}_p']:.3f})" for v in ['black','hisp'] if f'{v}_b' in x))
print("\nSES & academic terms per model:")
for x in rows:
    if x['model']=='M1':
        print("  M1:", " | ".join(f"{v}={x[f'{v}_b']:+.3f}(AME {x[f'{v}_AME']:+.3f})" for v in ['loginc_z','mothed_z','fathed_z','fsize_z'] if f'{v}_b' in x))
    if x['model']=='M2':
        print("  M2:", " | ".join(f"{v}={x[f'{v}_b']:+.3f}(AME {x[f'{v}_AME']:+.3f})" for v in ['loginc_z','mothed_z','fathed_z','fsize_z','asvab_z'] if f'{v}_b' in x))
    if x['model']=='M2r':
        print("  M2+rank(n=%d):" % x['n'], "asvab_z=%.3f standing_z=%.3f (AME %.3f)" % (x['asvab_z_b'], x['standing_z_b'], x['standing_z_AME']))

print("\n--- % coefficient change across nested models (primary) ---")
print(f"Black:  M0->M1 = {att(rows,'black','M0','M1'):+.0f}%   M1->M2 = {att(rows,'black','M1','M2'):+.0f}%   M0->M2 = {att(rows,'black','M0','M2'):+.0f}%")
print(f"Hispanic: M0->M1 = {att(rows,'hisp','M0','M1'):+.0f}%   M1->M2 = {att(rows,'hisp','M1','M2'):+.0f}%   M0->M2 = {att(rows,'hisp','M0','M2'):+.0f}%")
for v in ['loginc_z','mothed_z','fathed_z','fsize_z']:
    print(f"{v}: M1->M2 = {att(rows,v,'M1','M2'):+.0f}%")

# SES composite single-index ladder
rs=[]
for tag,add in [('M0',''),('M1','ses_index'),('M2','ses_index + asvab_z')]:
    mod,f=fit(prim,'O2',add); rs.append({'model':tag,'n':int(mod.nobs),
        'black_b':float(mod.params['black']),'hisp_b':float(mod.params['hisp']),
        'ses_b':float(mod.params['ses_index']) if 'ses_index' in mod.params.index else np.nan,
        'asvab_b':float(mod.params['asvab_z']) if 'asvab_z' in mod.params.index else np.nan})
print("\nSES composite index version: Black %.3f -> %.3f -> %.3f | Hisp %.3f -> %.3f -> %.3f | SESidx M1=%.3f -> M2=%.3f | ASVAB M2=%.3f" % (
    rs[0]['black_b'],rs[1]['black_b'],rs[2]['black_b'],rs[0]['hisp_b'],rs[1]['hisp_b'],rs[2]['hisp_b'],rs[1]['ses_b'],rs[2]['ses_b'],rs[2]['asvab_b']))
print(f"   SES composite M1->M2 attenuation = {att(rs,'ses','M1','M2'):+.0f}%")

# Clean family-of-origin SES (parental education only) sensitivity
cd=prim.copy()
rc=[]
for tag,add in [('M0',''),('M1','mothed_z + fathed_z'),('M2','mothed_z + fathed_z + asvab_z')]:
    mod,f=fit(cd,'O2',add); rc.append({'model':tag,'black_b':float(mod.params['black']),'hisp_b':float(mod.params['hisp']),
        'mothed_b':float(mod.params['mothed_z']) if 'mothed_z' in mod.params.index else np.nan,
        'asvab_b':float(mod.params['asvab_z']) if 'asvab_z' in mod.params.index else np.nan})
print("\nCLEAN family-of-origin SES (parental education only): Black %.3f -> %.3f -> %.3f | Hisp %.3f -> %.3f -> %.3f | mothed M1=%.3f->M2=%.3f (%+.0f%%) | ASVAB M2=%.3f" % (
    rc[0]['black_b'],rc[1]['black_b'],rc[2]['black_b'],rc[0]['hisp_b'],rc[1]['hisp_b'],rc[2]['hisp_b'],
    rc[1]['mothed_b'],rc[2]['mothed_b'],(rc[1]['mothed_b']-rc[2]['mothed_b'])/abs(rc[1]['mothed_b'])*100, rc[2]['asvab_b']))

# ---------- INTERACTIONS ----------
print("\n--- Interactions (primary sample) ---")
for label,f in [
    ("race x SES_index",'O2 ~ black + hisp + male + age + ses_index + asvab_z + black:ses_index + hisp:ses_index'),
    ("race x ASVAB",'O2 ~ black + hisp + male + age + ses_index + asvab_z + black:asvab_z + hisp:asvab_z'),
    ("race x mothered",'O2 ~ black + hisp + male + age + mothed_z + fathed_z + asvab_z + black:mothed_z + hisp:mothed_z')]:
    mod=smf.logit(f,prim).fit(disp=0)
    inter={k:round(float(v),3) for k,v in mod.params.items() if ':' in k}
    print(f"  {label}: {inter}")
    for k,v in mod.params.items():
        if ':' in k: print(f"     {k}: b={v:.3f} (se {mod.bse[k]:.3f}, p={mod.pvalues[k]:.3f})")

# ---------- ROBUSTNESS ----------
print("\n"+"="*112); print("ROBUSTNESS")
print("="*112)
# age cutoffs
for cu in [19,20,21]:
    d=df[(df['age']>=cu)&df[['loginc','mothed','fathed','asvab']].notna().all(axis=1)].copy(); rw=ladder(d)
    m1=[x for x in rw if x['model']=='M1'][0]; m2=[x for x in rw if x['model']=='M2'][0]
    print(f"age>={cu} (n={len(d)}, O2={d['O2'].mean():.3f}): Black {m1['black_b']:+.3f}->{m2['black_b']:+.3f} ({att(rw,'black','M1','M2'):+.0f}%) | Hisp {m1['hisp_b']:+.3f}->{m2['hisp_b']:+.3f} ({att(rw,'hisp','M1','M2'):+.0f}%) | ASVAB {m2['asvab_z_b']:+.3f}")
# median imputation
imp=df[df['age']>=20].copy()
for c in ['loginc','mothed','fathed','asvab']:
    imp[c+'_z']=(imp[c].fillna(imp[c].median())-imp[c+'_z'].mean())  # placeholder; recompute below
# proper re-standardization
for c in ['loginc','mothed','fathed','asvab']:
    imp[c+'_z']=(imp[c].fillna(imp[c].median())-imp[c+'_z'].mean())/imp[c+'_z'].std()
rw=ladder(imp); m1=[x for x in rw if x['model']=='M1'][0]; m2=[x for x in rw if x['model']=='M2'][0]
print(f"median-impute age>=20 (n={len(imp)}, O2={imp['O2'].mean():.3f}): Black {m1['black_b']:+.3f}->{m2['black_b']:+.3f} ({att(rw,'black','M1','M2'):+.0f}%) | Hisp {m1['hisp_b']:+.3f}->{m2['hisp_b']:+.3f} ({att(rw,'hisp','M1','M2'):+.0f}%) | ASVAB {m2['asvab_z_b']:+.3f}")
# OLS continuous HGC
o=smf.ols('hgc ~ black + hisp + male + age',prim).fit(); o1=smf.ols('hgc ~ black + hisp + male + age + loginc_z + mothed_z + fathed_z + fsize_z',prim).fit()
o2=smf.ols('hgc ~ black + hisp + male + age + loginc_z + mothed_z + fathed_z + fsize_z + asvab_z',prim).fit()
print(f"OLS HGC continuous: Black {o.params['black']:+.3f} -> {o1.params['black']:+.3f} -> {o2.params['black']:+.3f} | ASVAB {o2.params['asvab_z']:+.3f} | R2 {o.rsquared:.3f}->{o1.rsquared:.3f}->{o2.rsquared:.3f}")
