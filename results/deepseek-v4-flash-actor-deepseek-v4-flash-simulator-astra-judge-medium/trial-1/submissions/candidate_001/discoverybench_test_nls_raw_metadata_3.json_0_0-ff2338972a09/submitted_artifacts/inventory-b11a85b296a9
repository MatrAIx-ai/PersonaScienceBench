import pandas as pd, numpy as np
df = pd.read_csv('data/nls_raw.csv')
hgc="Highest grade completed, 1979"; age="Age of respondent, 1979"
print("N rows:", len(df), "N cols:", len(df.columns))
# Outcome proxies
print("HGC>=16 (BA proxy, all):", (df[hgc]>=16).sum(), "| HGC>=13:", (df[hgc]>=13).sum())
for a in [18,19,20,21,22]:
    s=df[df[age]>=a]
    print(f"age>={a}: n={len(s)}, HGC>=16:{(s[hgc]>=16).sum()}, HGC>=13:{(s[hgc]>=13).mean():.3f}")
res=[c for c in df.columns if c.startswith("Type of residence")]
print("Ever dorm/frat (code 3) 1981-96:", df[res].isin([3.0]).any(axis=1).sum(),
      "| overall rate:", df[res].isin([3.0]).any(axis=1).mean().round(4))
# Missingness
for c in ["Total net family income, previous calendar year, 1979",
          "Highest grade completed by respondent's mother, 1979",
          "Highest grade completed by respondent's father, 1979",
          "Family net wealth, 1985","Family net wealth, 1996 (key data point)",
          "Rank in class last year attended at this school, 1981",
          "ASVAB - Arithmetic Reasoning Z Score (rounded), 1981"]:
    print(f"missing {c}: {df[c].isna().mean()*100:.1f}%")
# Race gaps
r="Racial/ethnic cohort, 1979"
print(df.groupby(r)[[c for c in df.columns if c.startswith('ASVAB')]].mean().round(1))
