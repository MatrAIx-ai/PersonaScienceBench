# ---------- Layer B logit with AMEs ----------
print("\n--- LAYER B | logistic SC13 ~ black*SES + age + age^2 + sex (Black vs NBNH) ---")

def logit_gaps(d, sescol, label):
    d=d[d['race'].isin(['Black','NonBlackNonHisp']) & d[sescol].notna()].copy()
    d['smid']=(d[sescol]=='mid').astype(int); d['shigh']=(d[sescol]=='high').astype(int)
    d['bsmid']=d['black']*d['smid']; d['bshigh']=d['black']*d['shigh']
    d=d.dropna(subset=['SC13']).reset_index(drop=True)
    X=d[['black','smid','shigh','bsmid','bshigh','female','agec','agec2']]
    Xc=sm.add_constant(X, has_constant='add')
    y=d['SC13'].astype(float)
    m=sm.Logit(y,Xc).fit(disp=0)
    m0=sm.Logit(y, sm.add_constant(X[['black','smid','shigh','female','agec','agec2']], has_constant='add')).fit(disp=0)
    lr=2*(m.llf-m0.llf); lrp=1-stats.chi2.cdf(lr,2)
    b=m.params.values; cv=m.cov_params().values
    cols=list(Xc.columns)
    print(f"\n{label} | n={len(y)} events={int(y.sum())} | black x SES interaction LR p={lrp:.4f} | AIC={m.aic:.0f}")
    # sample-averaged AME of Black within each SES (average individual contrast; delta-method SE)
    Xd=pd.DataFrame({c:Xc[c] for c in cols})
    def ame(ses):
        idx=[i for i in range(len(Xd)) if Xd.loc[Xd.index[i],'smid']==('mid'==ses) or True]
        rows=(Xd['smid']==(1 if ses=='mid' else 0)) & (Xd['shigh']==(1 if ses=='high' else 0))
        X1=Xd[rows].copy(); X0=X1.copy()
        X1['black']=1; X1['bsmid']=X1['black']*X1['smid']; X1['bshigh']=X1['black']*X1['shigh']
        X0['black']=0; X0['bsmid']=0; X0['bshigh']=0
        X1a=X1[cols].values; X0a=X0[cols].values
        p1=1/(1+np.exp(-X1a@b)); p0=1/(1+np.exp(-X0a@b))
        g=(np.expand_dims(p1*(1-p1),1)*X1a - np.expand_dims(p0*(1-p0),1)*X0a).mean(axis=0)
        ame_val=(p1-p0).mean(); se=np.sqrt(g@cv@g)
        return ame_val, se, (p1-p0).mean()
    for ter,midv,highv in [('low',0,0),('mid',1,0),('high',0,1)]:
        idx=(Xd['smid']==midv)&(Xd['shigh']==highv)
        X1=Xd[idx].copy(); X0=X1.copy()
        X1['black']=1; X1['bsmid']=X1['black']*X1['smid']; X1['bshigh']=X1['black']*X1['shigh']
        X0['black']=0; X0['bsmid']=0; X0['bshigh']=0
        X1a=X1[cols].values; X0a=X0[cols].values
        p1=1/(1+np.exp(-X1a@b)); p0=1/(1+np.exp(-X0a@b))
        g=(np.expand_dims(p1*(1-p1),1)*X1a - np.expand_dims(p0*(1-p0),1)*X0a).mean(axis=0)
        a=(p1-p0).mean(); se=np.sqrt(g@cv@g)
        # representative-age (age 20) predicted probs
        age20=pd.DataFrame({c:[Xc[c].mean()] for c in cols}); age20['agec']=[20-14]; age20['agec2']=[(20-14)**2]
        def rep(blk, sm, sh):
            x=age20.copy(); x['black']=[blk]; x['smid']=[sm]; x['shigh']=[sh]
            x['bsmid']=[x['black'][0]*x['smid'][0]]; x['bshigh']=[x['black'][0]*x['shigh'][0]]
            v=x[cols].values[0]; return 1/(1+np.exp(-v@b))
        r1,r0=rep(1,midv,highv),rep(0,midv,highv)
        print("  %s SES: AME(Black)=%+.2f pp (95%% CI %+.2f,%+.2f) | P(Black)~%.0f%% vs P(NBNH)~%.0f%% at age 20"%
              (ter,a*100,(a-1.96*se)*100,(a+1.96*se)*100,r1*100,r0*100))
    return m

for sesname,sescol in [('INCOME terciles','inc_ter'),('COMPOSITE terciles','comp_ter')]:
    logit_gaps(an,sescol,'SC13 logit | '+sesname)

