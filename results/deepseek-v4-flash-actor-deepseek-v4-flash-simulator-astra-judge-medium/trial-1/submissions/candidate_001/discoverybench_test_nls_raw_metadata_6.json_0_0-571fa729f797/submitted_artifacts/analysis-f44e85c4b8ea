def mice_impute(full, M=5, T=15, seed=7):
    rng2=np.random.default_rng(seed)
    pred_cols=['black','hisp','agec','agec2','female','famsize','ln_w85']
    dat=full.copy()
    dat['_lninc']=dat['ln_inc79'].fillna(dat['ln_inc79'].median())
    dat['_medu']=dat['medu'].fillna(dat['medu'].median())
    dat['_dedu']=dat['dedu'].fillna(dat['dedu'].median())
    dat['ln_w85']=dat['ln_w85'].fillna(dat['ln_w85'].median())
    imps=[]
    for m in range(M):
        for t in range(T):
            for v,src in [('_lninc','ln_inc79'),('_medu','medu'),('_dedu','dedu')]:
                miss=dat[src].isna()
                if miss.sum()==0: continue
                obs=~miss
                Xi=sm.add_constant(dat.loc[obs,pred_cols]); yi=dat.loc[obs,v]
                fit=sm.OLS(yi,Xi).fit()
                Xm=sm.add_constant(dat.loc[miss,pred_cols])
                pred=fit.predict(Xm); rs=fit.resid.std(ddof=fit.df_model+1)
                dat.loc[miss,v]=pred+rng2.normal(0,rs,len(pred))
                if v=='_medu': dat.loc[miss,v]=np.clip(np.round(dat.loc[miss,v]),0,20)
                if v=='_dedu': dat.loc[miss,v]=np.clip(np.round(dat.loc[miss,v]),0,20)
        d2=full.copy(); d2['ln_inc_imp']=dat['_lninc']; d2['medu_imp']=dat['_medu']; d2['dedu_imp']=dat['_dedu']
        imps.append(d2)
    return imps

