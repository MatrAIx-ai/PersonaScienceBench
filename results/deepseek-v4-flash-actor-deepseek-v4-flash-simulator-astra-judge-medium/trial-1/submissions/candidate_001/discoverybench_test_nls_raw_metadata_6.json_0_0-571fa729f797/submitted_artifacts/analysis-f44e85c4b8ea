def layerA_table(sub, sescol, sesname):
    rows=[]
    for race_ in ['Black','NonBlackNonHisp','Hispanic']:
        for ter in ['low','mid','high']:
            d=sub[(sub['race']==race_)&(sub[sescol]==ter)]
            k=int(d['BA19'].sum()); n=len(d)
            p,lo,hi=wilson(k,n)
            rows.append({'ses':ter,'race':race_,'BA_n':k,'N':n,'rate':round(p,4),
                         'rate_lo':round(lo,4),'rate_hi':round(hi,4)})
    tab=pd.DataFrame(rows)
    print(f"\n--- LAYER A | {sesname}: BA rates by race x SES ---")
    print(tab.to_string(index=False))
    out=[]
    for ter in ['low','mid','high']:
        b = tab[(tab.ses==ter)&(tab.race=='Black')].iloc[0]
        nb= tab[(tab.ses==ter)&(tab.race=='NonBlackNonHisp')].iloc[0]
        h = tab[(tab.ses==ter)&(tab.race=='Hispanic')].iloc[0]
        bnk, bnn, nbk, nbn = int(b.BA_n), int(b.N), int(nb.BA_n), int(nb.N)
        gl,gh=gap_ci(b.rate,bnn,nb.rate,nbn)
        rr=rr_ci(b.rate,bnn,nb.rate,nbn)
        fis=stats.fisher_exact([[bnk,bnn-bnk],[nbk,nbn-nbk]])
        out.append({'ses':ter,'comp':'Black vs NBNH','gap_pp':round((b.rate-nb.rate)*100,2),
                    'gap_ci':[round(gl*100,2),round(gh*100,2)],'RR':round(rr[0],3) if rr else None,
                    'RR_ci':[round(rr[1],3),round(rr[2],3)] if rr else None,'fisher_p':round(fis[1],4),
                    'n_black':bnn,'n_comp':nbn,'BA_black':bnk,'BA_comp':nbk,'verdict':verdict(gl,gh,b.rate,nb.rate)})
        allk= int(h.BA_n)+nbk; alln=int(h.N)+nbn
        p_all=allk/alln if alln else np.nan
        gl2,gh2=gap_ci(b.rate,bnn,p_all,alln)
        rr2=rr_ci(b.rate,bnn,p_all,alln)
        out.append({'ses':ter,'comp':'Black vs all-nonBlack','gap_pp':round((b.rate-p_all)*100,2),
                    'gap_ci':[round(gl2*100,2),round(gh2*100,2)],'RR':round(rr2[0],3) if rr2 else None,
                    'RR_ci':[round(rr2[1],3),round(rr2[2],3)] if rr2 else None,'fisher_p':None,
                    'n_black':bnn,'n_comp':alln,'BA_black':bnk,'BA_comp':allk,'verdict':verdict(gl2,gh2,b.rate,p_all)})
        gl3,gh3=gap_ci(b.rate,bnn,h.rate,int(h.N))
        rr3=rr_ci(b.rate,bnn,h.rate,int(h.N))
        out.append({'ses':ter,'comp':'Black vs Hispanic','gap_pp':round((b.rate-h.rate)*100,2),
                    'gap_ci':[round(gl3*100,2),round(gh3*100,2)],'RR':round(rr3[0],3) if rr3 else None,
                    'RR_ci':[round(rr3[1],3),round(rr3[2],3)] if rr3 else None,'fisher_p':None,
                    'n_black':bnn,'n_comp':int(h.N),'BA_black':bnk,'BA_comp':int(h.BA_n),
                    'verdict':verdict(gl3,gh3,b.rate,h.rate)})
    ot=pd.DataFrame(out)
    print(f"\n--- LAYER A | {sesname}: gaps / rate-ratios ---")
    print(ot.to_string(index=False))
    small=ot[(ot.n_black<5)|(ot.n_comp<5)|(ot.BA_black<5)|(ot.BA_comp<5)]
    print("WARNING cells with any n or BA count <5:")
    print(small[['ses','comp','n_black','n_comp','BA_black','BA_comp']].to_string(index=False))
    return tab, ot

