# ---------- helpers ----------
def wilson(k, n, z=1.96):
    if n==0: return (np.nan, np.nan, np.nan)
    p=k/n; den=1+z*z/n
    c=(p+z*z/(2*n))/den; h=z*np.sqrt(p*(1-p)/n+z*z/(4*n*n))/den
    return p, max(0,c-h), min(1,c+h)
def gap_ci(p1,n1,p2,n2,z=1.96):
    se=np.sqrt(p1*(1-p1)/n1+p2*(1-p2)/n2)
    return (p1-p2)-z*se, (p1-p2)+z*se
def rr_ci(p1,n1,p2,n2,z=1.96):
    if p1==0 or p2==0: return None
    r=p1/p2; se=np.sqrt((1-p1)/(n1*p1)+(1-p2)/(n2*p2))
    return r, r*np.exp(-z*se), r*np.exp(z*se)
def verdict(lo,hi,rate_b,rate_c):
    if np.isnan(lo) or np.isnan(hi): return 'not resolvable (no estimate)'
    if lo>0: return 'PRESENT'
    if hi<0: return 'ABSENT'
    return 'not resolvable (CI spans 0)'

