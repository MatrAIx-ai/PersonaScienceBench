def rubin_pool(models):
    B=len(models); coefs=np.array([mo['coef'] for mo in models]); vws=np.array([np.diag(mo['cov']) for mo in models])
    Qbar=coefs.mean(0); U=vws.mean(0)
    Bm=((coefs-Qbar)**2).sum(0)/(B-1)
    Tvar=U+(1+1/B)*Bm; dfm=(B-1)*(1+ U/((1+1/B)*Bm+1e-12))**2
    return Qbar,np.sqrt(Tvar),dfm

def mi_sc13(imps, sescol, sesname):
    models=[]
    for d in imps:
        d2=d.copy()
        d2['parent_ed_imp']=(d2['medu_imp']+d2['dedu_imp'])/2
        if sescol=='inc_ter':
            q=d2['ln_inc_imp'].quantile([1/3,2/3]).values
            d2['sesi']=pd.cut(d2['ln_inc_imp'],[-np.inf,q[0],q[1],np.inf],labels=['low','mid','high'])
        else:
            comp=pd.DataFrame({'z_inc':z(d2['ln_inc_imp']),'z_pe':z(d2['parent_ed_imp']),'z_fs':z(-d2['famsize'])})
            ci=comp.mean(axis=1); q=ci.quantile([1/3,2/3]).values
            d2['sesi']=pd.cut(ci,[-np.inf,q[0],q[1],np.inf],labels=['low','mid','high'])
        d2=d2[d2['race'].isin(['Black','NonBlackNonHisp']) & d2['HGc'].notna() & d2['sesi'].notna()]
        X=pd.DataFrame(index=d2.index)
        X['const']=1; X['black']=d2['black']; X['smid']=(d2.sesi=='mid').astype(int); X['shigh']=(d2.sesi=='high').astype(int)
        X['bsmid']=X.black*X.smid; X['bshigh']=X.black*X.shigh
        X['female']=d2['female']; X['agec']=d2['agec']; X['agec2']=d2['agec2']
        y=d2['SC13'].astype(float)
        m=sm.Logit(y,X[['const','black','smid','shigh','bsmid','bshigh','female','agec','agec2']]).fit(disp=0)
        models.append({'coef':m.params.values,'cov':m.cov_params().values})
    Qbar,se,dfm=rubin_pool(models)
    names=['const','black','smid','shigh','bsmid','bshigh','female','agec','agec2']
    print(f"\nMI-pooled SC13 logit ({sesname}), M={len(models)}:")
    for nm,q,s in zip(names,Qbar,se):
        print("  %-6s %+8.4f (SE %.4f)"%(nm,q,s))
    for label,idxs in [('low',['black']),('mid',['black','bsmid']),('high',['black','bshigh'])]:
        ii=[names.index(i) for i in idxs]
        v=Qbar[ii].sum(); se2=np.sqrt((se[ii]**2).sum())
        print("  MI-pooled Black log-odds advantage %s: %+.3f (95%% CI %+.3f,%+.3f)"%(label,v,v-1.96*se2,v+1.96*se2))

for sesname,sescol in [('INCOME terciles','inc_ter'),('COMPOSITE terciles','comp_ter')]:
    mi_sc13(imps,sescol,sesname)

