def ord_model(d,sescol,label):
    d=d[d['race'].isin(['Black','NonBlackNonHisp']) & d[sescol].notna() & d['ord'].notna()].copy()
    exog=pd.DataFrame(index=d.index)
    exog['black']=d['black']; exog['smid']=(d[sescol]=='mid').astype(int); exog['shigh']=(d[sescol]=='high').astype(int)
    exog['bsmid']=exog.black*exog.smid; exog['bshigh']=exog.black*exog.shigh
    exog['female']=d['female']; exog['agec']=d['agec']; exog['agec2']=d['agec2']
    y=d['ord'].astype(int)
    m=OrderedModel(y, exog, distr='logit').fit(disp=0, method='bfgs', maxiter=300)
    base=OrderedModel(y, exog[['black','smid','shigh','female','agec','agec2']], distr='logit').fit(disp=0, method='bfgs', maxiter=300)
    lr=2*(m.llf-base.llf); lrp=None if lr<0 else 1-stats.chi2.cdf(lr,2)
    print(f"\n{label} | n={len(y)} | black*SES interaction LR chi2(2)={lr:.2f} p={lrp if lrp is not None else 'n/a(neg)'}")
    ref=exog.mean()
    print("  mean predicted attainment category (0-3) at mean covariates:")
    for ter,dm in [('low',{'smid':0,'shigh':0}),('mid',{'smid':1,'shigh':0}),('high',{'smid':0,'shigh':1})]:
        x1=ref.copy(); x0=ref.copy()
        for k,v in dm.items(): x1[k]=v; x0[k]=v
        x1['black']=1; x1['bsmid']=1*x1['smid']; x1['bshigh']=1*x1['shigh']
        x0['black']=0; x0['bsmid']=0; x0['bshigh']=0
        pr1=m.model.predict(m.params, exog=pd.DataFrame([x1]))[0]
        pr0=m.model.predict(m.params, exog=pd.DataFrame([x0]))[0]
        e1=np.dot(pr1,[0,1,2,3]); e0=np.dot(pr0,[0,1,2,3])
        print("    %s: Black E[cat]=%.3f vs NBNH %.3f (diff %+.3f)"%(ter,e1,e0,e1-e0))
    return m

for sesname,sescol in [('INCOME terciles','inc_ter'),('COMPOSITE terciles','comp_ter')]:
    ord_model(an,sescol,'Ordinal logit | '+sesname)

