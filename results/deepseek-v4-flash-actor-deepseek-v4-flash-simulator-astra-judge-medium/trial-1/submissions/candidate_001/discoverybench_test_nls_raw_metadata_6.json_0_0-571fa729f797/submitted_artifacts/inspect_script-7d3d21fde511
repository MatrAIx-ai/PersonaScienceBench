import pandas as pd
import numpy as np
pd.set_option('display.width', 250); pd.set_option('display.max_rows', 300)

df = pd.read_csv('data/nls_raw.csv', low_memory=False)
print("SHAPE:", df.shape)

info = pd.DataFrame({
    'dtype': df.dtypes.astype(str),
    'non_null': df.notna().sum(),
    'n_unique': df.nunique(dropna=True),
    'missing_pct': (df.isna().mean()*100).round(1),
}).sort_values('non_null', ascending=False)
print("\n=== COLUMN PROFILE ===")
print(info.to_string())

RACE='Racial/ethnic cohort, 1979'; HG='Highest grade completed, 1979'; AGE='Age of respondent, 1979'
race_map={1:'Black',2:'Hispanic',3:'NonBlackNonHisp'}
df['race']=df[RACE].map(race_map)
df['HGc']=df[HG].where(df[HG]<=20)   # 95 = missing/refused
df['BA']=(df['HGc']>=16).astype(float)
df['SC']=(df['HGc']>=13).astype(float)

print("\n=== RACE coding ===", dict(df[RACE].value_counts()), "->", df['race'].value_counts().to_dict())
print("=== SEX coding ===", df['Sex of respondent, 1979'].value_counts().to_dict())
print("=== AGE 1979 ===", dict(df[AGE].value_counts().sort_index()))
print("=== FAMILY SIZE ===", dict(df['Family size, 1979'].value_counts().sort_index()))
print("\n=== BA(HG>=16) x age ===\n", pd.crosstab(df[AGE], df['BA'], margins=True).to_string())
print("\n=== some-college(HG>=13) x age ===\n", pd.crosstab(df[AGE], df['SC'], margins=True).to_string())
print("\n=== BA x race ===\n", pd.crosstab(df['race'], df['BA'], margins=True).to_string())
print("\n=== BA among age>=21 x race ===\n",
      pd.crosstab(df[df[AGE]>=21]['race'], df[df[AGE]>=21]['BA'], margins=True).to_string())

for c in ['Total net family income, previous calendar year, 1979',
          'Total net family income, previous calendar year, 1985',
          'Family net wealth, 1985','Family net wealth, 1990',
          'Family net wealth, 1996 (key data point)',
          "Highest grade completed by respondent's mother, 1979",
          "Highest grade completed by respondent's father, 1979"]:
    s=df[c]
    print(f"\n{c}\n  n={s.notna().sum()} neg={(s<0).sum()} zero={(s==0).sum()} "
          f"min={s.min()} p50={s.median()} max={s.max()}")

print("\n=== SES means by race ===")
g=df.groupby('race')[['Total net family income, previous calendar year, 1979',
                      'Family net wealth, 1985','Total net family income, previous calendar year, 1985',
                      "Highest grade completed by respondent's mother, 1979",
                      "Highest grade completed by respondent's father, 1979",
                      'Family size, 1979']].mean().round(1)
g['n']=df.groupby('race').size()
print(g.to_string())
print("\n=== Sample ID x race (oversampling structure) ===")
print(pd.crosstab(df['Sample ID, 1979 (interview)'], df['race']).to_string())
