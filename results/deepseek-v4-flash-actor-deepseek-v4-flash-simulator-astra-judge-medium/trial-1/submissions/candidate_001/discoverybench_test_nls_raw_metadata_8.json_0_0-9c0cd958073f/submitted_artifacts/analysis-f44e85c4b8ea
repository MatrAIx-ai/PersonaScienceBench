#!/usr/bin/env python3
"""
NLSY79 wealth-by-cohort analysis (DiscoveryBench).
Question: How does the median wealth of white individuals compare to that of
black and Hispanic individuals from 1985 onwards?

Design (per approved plan):
  - cohort 1 = BLACK, 2 = HISPANIC, 3 = NON-BLACK NON-HISPANIC (White proxy)
  - metric = group median family net wealth for 1985, 1990, 1996 (the only
    wealth snapshots in the file)
  - missing data = complete-case per year (primary) + balanced-panel (robustness)
  - negative/zero wealth retained as valid observations
  - unweighted, sample-level result (no weight column in data)
"""
import pandas as pd
import numpy as np

RNG = np.random.default_rng(42)

def bootstrap_median_ci(x, n_boot=2000, alpha=0.05):
    """Percentile bootstrap CI for the median."""
    x = np.asarray(x, dtype=float)
    meds = np.array([np.median(RNG.choice(x, size=len(x), replace=True))
                     for _ in range(n_boot)])
    lo = np.percentile(meds, 100 * alpha / 2)
    hi = np.percentile(meds, 100 * (1 - alpha / 2))
    return lo, hi

def main():
    df = pd.read_csv('data/nls_raw.csv')
    cohort_col = 'Racial/ethnic cohort, 1979'
    wealth_cols = {
        1985: 'Family net wealth, 1985',
        1990: 'Family net wealth, 1990',
        1996: 'Family net wealth, 1996 (key data point)',
    }
    names = {1: 'BLACK', 2: 'HISPANIC', 3: 'WHITE(proxy)'}

    print('=' * 78)
    print('NLSY79 — MEDIAN FAMILY NET WEALTH BY RACIAL/ETHNIC COHORT')
    print(f'Rows={len(df):,}  Cols={df.shape[1]}')
    print('=' * 78)

    # ---- 1. Cohort counts & missingness ---------------------------------
    print('\n[1] COHORT COUNTS & WEALTH MISSINGNESS')
    print(f'{"Cohort":<22}{"n_total":>9}{"1985 %miss":>12}{"1990 %miss":>12}{"1996 %miss":>12}')
    for k in [1, 2, 3]:
        g = df[df[cohort_col] == k]
        row = [g.shape[0]] + [f"{g[c].isna().mean()*100:6.1f}" for c in wealth_cols.values()]
        print(f'{names[k]:<22}{row[0]:>9}{row[1]:>12}{row[2]:>12}{row[3]:>12}')

    noany = df[list(wealth_cols.values())].isna().all(axis=1)
    print(f'\nRespondents with no wealth in ANY year: {noany.sum():,} '
          f'(by cohort: {df.loc[noany, cohort_col].value_counts().sort_index().to_dict()})')

    # ---- 2. Per-group medians (complete-case per year) -------------------
    print('\n[2] PER-GROUP MEDIAN FAMILY NET WEALTH  (complete-case per year)')
    print(f'{"Year":<6}{"Group":<24}{"n":>7}{"median":>11}{"mean":>12}'
          f'{"neg%":>7}{"zero%":>7}{"CI(median)":>22}')
    results = {}   # (year, cohort) -> median
    medians = pd.DataFrame(index=[1, 2, 3], columns=[1985, 1990, 1996], dtype=float)
    for y, c in wealth_cols.items():
        for k in [1, 2, 3]:
            sub = df.loc[df[cohort_col] == k, c].dropna()
            m = sub.median()
            lo, hi = bootstrap_median_ci(sub.values)
            results[(y, k)] = m
            medians.loc[k, y] = m
            print(f'{y:<6}{names[k]:<24}{len(sub):>7}{m:>11,.0f}{sub.mean():>12,.0f}'
                  f'{(sub<0).mean()*100:>7.1f}{(sub==0).mean()*100:>7.1f}'
                  f'  ${lo:>9,.0f}–${hi:>9,.0f}')

    # ---- 3. Ratios (White proxy vs others) + B/H --------------------------
    print('\n[3] MEDIAN WEALTH RATIOS (White proxy / group; Black / Hispanic)')
    for y in [1985, 1990, 1996]:
        w, b, h = medians.loc[3, y], medians.loc[1, y], medians.loc[2, y]
        print(f'  {y}: W/B={w/b:.2f}x   W/H={w/h:.2f}x   B/H={b/h:.2f}x'
              f'   | abs gap W-B=${w-b:,.0f}  W-H=${w-h:,.0f}')

    # ---- 4. Balanced-panel robustness ------------------------------------
    print('\n[4] ROBUSTNESS: BALANCED PANEL (respondents with all 3 wealth years)')
    mask = df[list(wealth_cols.values())].notna().all(axis=1)
    print(f'  balanced-panel n = {mask.sum():,}  '
          f'(by cohort: {df.loc[mask, cohort_col].value_counts().sort_index().to_dict()})')
    print(f'  {"Group":<24}{"n":>7}{"1985":>10}{"1990":>10}{"1996":>10}')
    for k in [1, 2, 3]:
        sub = df.loc[mask & (df[cohort_col] == k)]
        m = [sub[c].median() for c in wealth_cols.values()]
        print(f'  {names[k]:<24}{len(sub):>7}'
              + ''.join(f'{x:>10,.0f}' for x in m))
    # ratios in balanced panel
    for y, c in wealth_cols.items():
        w = df.loc[mask & (df[cohort_col] == 3), c].median()
        b = df.loc[mask & (df[cohort_col] == 1), c].median()
        h = df.loc[mask & (df[cohort_col] == 2), c].median()
        if y == 1985:
            print('  -- balanced-panel ratios (W/B, W/H):')
        print(f'      {y}: W/B={w/b:.2f}x  W/H={w/h:.2f}x')

    # ---- 5. CPI sensitivity (for describing growth across snapshots) ------
    print('\n[5] CPI SENSITIVITY (only for growth-over-time statements;')
    print('     within-year group ratios are inflation-invariant)')
    cpi = {1985: 107.6, 1990: 130.7, 1996: 156.9}   # CPI-U annual avg
    print(f'     {"Year":<6}{"Group":<24}{"nominal":>11}{"2019?no->1996$":>14}')
    for y in [1985, 1990]:
        scale = cpi[1996] / cpi[y]
        for k in [1, 2, 3]:
            print(f'     {y:<6}{names[k]:<24}{medians.loc[k, y]:>11,.0f}'
                  f'{(medians.loc[k, y]*scale):>14,.0f}   (x{scale:.2f} CPI)')
    # real growth factors 1985->1996
    print('     Real (1996$) median growth 1985->1996:')
    for k in [1, 2, 3]:
        g = (medians.loc[k, 1996]) / (medians.loc[k, 1985] * cpi[1996] / cpi[1985])
        print(f'     {names[k]:<24}x{g:>6.2f}')

    # ---- 6. Write machine-readable summary ---------------------------------
    rows = []
    for y, c in wealth_cols.items():
        for k in [1, 2, 3]:
            sub = df.loc[df[cohort_col] == k, c].dropna()
            lo, hi = bootstrap_median_ci(sub.values)
            rows.append({'year': y, 'cohort': k, 'group': names[k], 'n': len(sub),
                         'median': sub.median(), 'mean': sub.mean(),
                         'neg_pct': (sub < 0).mean() * 100, 'zero_pct': (sub == 0).mean() * 100,
                         'ci_lo': lo, 'ci_hi': hi})
    out = pd.DataFrame(rows)
    out.to_csv('analysis/wealth_median_table.csv', index=False)
    print('\n[6] wrote analysis/wealth_median_table.csv')
    print('\nDone.')

if __name__ == '__main__':
    main()
