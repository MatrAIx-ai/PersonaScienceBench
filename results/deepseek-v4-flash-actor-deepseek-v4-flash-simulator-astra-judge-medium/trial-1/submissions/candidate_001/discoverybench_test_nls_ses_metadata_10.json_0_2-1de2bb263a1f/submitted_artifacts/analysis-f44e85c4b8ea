"""DiscoveryBench: nls_ses — which variable's effect on BA completion drops
from ~+0.3636 to ~-0.2293 (and loses significance) once race AND academic
characteristics are controlled?

Design: nested logistic regressions (outcome = BA DEGREE COMPLETED, 0/1;
log-odds scale) on N=8,773 complete cases. Focal SES; negative controls
SEX and FAMILY SIZE; robustness LPM(HC3); mechanism via conditional rates.
"""
import pandas as pd, numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf

df = pd.read_csv("data/nls_ses_processed.csv")
df['BA'] = df['BA DEGREE COMPLETED'].astype(int)
df['male']     = (df['SAMPLE_SEX']=='Male').astype(int)
df['black']    = (df['SAMPLE_RACE']=='Black').astype(int)
df['hispanic'] = (df['SAMPLE_RACE']=='Hispanic').astype(int)
df['fam']     = df['FAMILY SIZE OF SAMPLE'].astype(float)
df['ability'] = df['ABILITY: COMPOSITE OF ASVAB SCORE'].astype(float)
df['percentile'] = df['PERCENTILE IN CLASS'].astype(float)
df['ses']     = df['SES'].astype(float)
for c in ['ability','percentile']:
    df['z'+c] = (df[c]-df[c].mean()) / df[c].std()
df['ability_q']  = pd.qcut(df['ability'], 4, labels=False)
df['percentile_q'] = pd.qcut(df['percentile'], 4, labels=False)
df['ability_q5'] = pd.qcut(df['ability'], 5, labels=False)
df['percentile_q5'] = pd.qcut(df['percentile'], 5, labels=False)

def logit(cols):
    X = sm.add_constant(df[cols].copy())
    m = sm.Logit(df['BA'], X).fit(disp=0)
    return m

print("="*78)
print("PART 0 | DATA OVERVIEW")
print("="*78)
print(f"Sample size (complete cases): {len(df)};  missing: {int(df.isna().any(axis=1).sum())}")
print(f"BA completion rate: {df['BA'].mean():.4f} ({df['BA'].sum()} of {len(df)})")
print("Race: " + "; ".join(f"{r}={v}" for r,v in df['SAMPLE_RACE'].value_counts().items()))
print("Sex:  " + "; ".join(f"{s}={v}" for s,v in df['SAMPLE_SEX'].value_counts().items()))
print("Correlations with BA: ability=%.3f percentile=%.3f famsize=%.3f SES=%.3f"
      % (df['ability'].corr(df['BA']), df['percentile'].corr(df['BA']),
         df['fam'].corr(df['BA']), df['ses'].corr(df['BA'])))

print("\n" + "="*78)
print("PART 1 | SES COEFFICIENT PROGRESSION (logit, focal predictor = SES)")
print("="*78)
grid = {
    'G1  SES only':                     ['ses'],
    'G2  SES + sex':                    ['ses','male'],
    'G3  SES + family size':            ['ses','fam'],
    'G4  SES + sex + family size':      ['ses','male','fam'],
    'G5  SES + race (ref White)':       ['ses','black','hispanic'],
    'G6  G5 + academic CONTINUOUS':     ['ses','black','hispanic','ability','percentile'],
    'G7  G5 + academic Z-SCORED':       ['ses','black','hispanic','zability','zpercentile'],
    'G8  G5 + academic QUARTILES':      ['ses','black','hispanic','ability_q','percentile_q'],
    'G9  G5 + academic QUINTILES':      ['ses','black','hispanic','ability_q5','percentile_q5'],
}
print(f"{'spec':48s} {'SES coef':>9s} {'SE':>7s} {'p':>8s}  verdict")
for k, cols in grid.items():
    m = logit(cols)
    b, se, p = m.params['ses'], m.bse['ses'], m.pvalues['ses']
    star = 'SIGNIFICANT' if p < 0.05 else 'n.s.'
    print(f"{k:48s} {b:+9.4f} {se:7.4f} {p:8.4f}  {star}")
print("\nNOTE: SES+race (academic-free) = +0.3524 is closest to the reported "
      "+0.3636; adding academic characteristics flips SES to negative.")

print("\n" + "="*78)
print("PART 2 | NEGATIVE CONTROLS (sex, family size must NOT flip)")
print("="*78)
for name, col in [('SEX (male)', 'male'), ('FAMILY SIZE', 'fam')]:
    row = []
    for cols in ([col], [col,'black','hispanic'],
                 [col,'black','hispanic','ability','percentile']):
        m = logit(cols); row.append(m.params[col])
    print(f"{name:12s} bare={row[0]:+.4f}  +race={row[1]:+.4f}  +race+acad={row[2]:+.4f}"
          f"  -> {'NO FLIP' if row[2]>row[0] else 'no flip'}")

print("\n" + "="*78)
print("PART 3 | ROBUSTNESS: linear probability model (HC3 robust SEs)")
print("="*78)
for lab, form in {
 'LPM: SES + race (no academic)':   'BA ~ ses + black + hispanic',
 'LPM: SES + race + academic':      'BA ~ ses + black + hispanic + ability + percentile'}.items():
    m = smf.ols(form, data=df).fit(cov_type='HC3')
    print(f"{lab:35s} SES coef={m.params['ses']:+.4f} se={m.bse['ses']:.4f} p={m.pvalues['ses']:.4f}")

print("\n" + "="*78)
print("PART 4 | MECHANISM: BA rate by ability x SES tercile (the reversal)")
print("="*78)
df['ses_t'] = pd.qcut(df['ses'], 3, labels=['low','mid','high'])
df['ab_t']  = pd.qcut(df['ability'], 3, labels=['low','mid','high'])
print(df.groupby(['ab_t','ses_t'], observed=True)['BA'].mean().round(4).unstack())
print("Unconditional BA rate by SES tercile: " +
      df.groupby('ses_t', observed=True)['BA'].mean().round(4).to_string().replace('\n',' | '))

print("\n" + "="*78)
print("PART 5 | CONCLUSION (data-grounded)")
print("="*78)
print("""SES (socioeconomic status) is the variable: its logit coefficient on BA
degree completion is strongly positive before academic controls (+0.473
unadjusted; +0.352 with race controlled - closest to the reported +0.3636)
and turns NEGATIVE once BOTH race and academic characteristics (ASVAB test
score + class percentile) are included: -0.2316 (continuous controls,
p=0.021) / -0.1593 (grouped quartile controls, p=0.105, insignificant).
Sex and family size never flip sign. Under grouped academic coding the SES
effect becomes statistically nonsignificant; under continuous coding it is
negative but marginally significant - spec-dependence reported plainly.
Mechanism: unconditional BA rate rises across SES terciles (1.6/2.9/3.5%)
but within high-ability students low-SES completes at 7.9% vs high-SES 5.7%,
i.e. ability/class standing absorb SES's positive association and reveal a
negative conditional association.""")
