#!/usr/bin/env python3
"""
DiscoveryBench (nls_ses, full_workflow) - identify the variable whose effect on
BA degree completion decreases from ~0.5024 to ~0.0923 (becoming insignificant)
once SES and academic characteristics are controlled.

Scale decision (agreed with researcher): with BA prevalence ~2.7% and all
point-biserial correlations <=0.18, OLS/LPM slopes and standardized betas can
never reach 0.50; the target numbers are read as LOGISTIC (log-odds)
coefficients. We also report probit and OLS variants for robustness.

Design:
  Model A (bivariate):   BA ~ focal
  Model B (full):        BA ~ focal + SES + academic characteristics
                         where academic characteristics = ABILITY (ASVAB composite)
                         and PERCENTILE IN CLASS (the only academic-resource
                         columns in the CSV; no curriculum field is present).
Sensitivity variants B1..B4 differ in which covariates enter Model B.
"""
import numpy as np
import pandas as pd
import statsmodels.api as sm
import json, os

OUT = os.path.join(os.path.dirname(__file__), "outputs")
os.makedirs(OUT, exist_ok=True)

# ----------------------------------------------------------------------------
# 1. Data inspection
# ----------------------------------------------------------------------------
df = pd.read_csv("data/nls_ses_processed.csv")
df.columns = [str(c).strip() for c in df.columns]
df["BA"] = df["BA DEGREE COMPLETED"].astype(int)
df["ASVAB"] = df["ABILITY: COMPOSITE OF ASVAB SCORE"]
df["PCT"] = df["PERCENTILE IN CLASS"]
df["FAMSZ"] = df["FAMILY SIZE OF SAMPLE"]
df["SES"] = df["SES"].astype(float)
df["SEX_F"] = (df["SAMPLE_SEX"] == "Female").astype(int)
df["WHITE"] = (df["SAMPLE_RACE"] == "White").astype(int)
df["BLACK"] = (df["SAMPLE_RACE"] == "Black").astype(int)
df["HISP"] = (df["SAMPLE_RACE"] == "Hispanic").astype(int)
df["MINORITY"] = (1 - df["WHITE"]).astype(int)

inspection = {
    "n_rows": int(len(df)),
    "columns": [str(c) for c in df.columns],
    "missing_by_column": {str(c): int(v) for c, v in df.isna().sum().items()},
    "ba_rate": float(df["BA"].mean()),
    "ba_rate_by_race": {str(k): float(v) for k, v in df.groupby("SAMPLE_RACE")["BA"].mean().items()},
    "ba_rate_by_sex": {str(k): float(v) for k, v in df.groupby("SAMPLE_SEX")["BA"].mean().items()},
    "corr_with_BA": {c: float(np.corrcoef(df[c], df["BA"])[0, 1]) for c in
                     ["ASVAB", "PCT", "SES", "FAMSZ", "WHITE", "SEX_F"]},
    "note": "No curriculum/track column exists in the CSV despite dataset description",
}

TARGET_BIV = 0.5024
TARGET_FULL = 0.0923

# ----------------------------------------------------------------------------
# 2. Focal candidates
# ----------------------------------------------------------------------------
FOCALS = {
    "RACE: White (1) vs non-White (0)": "WHITE",
    "RACE: Black (1) vs non-Black (0)": "BLACK",
    "RACE: Hispanic (1) vs non-Hispanic (0)": "HISP",
    "RACE: Minority (non-White) (1)": "MINORITY",
    "SEX: Female (1) vs Male (0)": "SEX_F",
    "FAMILY SIZE OF SAMPLE": "FAMSZ",
    "SES": "SES",
    "ABILITY (ASVAB composite)": "ASVAB",
    "PERCENTILE IN CLASS": "PCT",
}

# Model B control sets
# B1: SES + both academic characteristics (the canonical 'SES + academic characteristics' model)
B1_SES_ACAD = ["SES", "ASVAB", "PCT"]
# B2: SES + class rank only
B2_SES_PCT = ["SES", "PCT"]
# B3: SES + ability only
B3_SES_ASVAB = ["SES", "ASVAB"]
# B4: full social backgr + academics (everything not focal)
def b4_controls(focal):
    base = ["SES", "ASVAB", "PCT"]
    if focal not in ("WHITE",):
        base = base + ["WHITE"]
    if focal not in ("BLACK",):
        base = base + ["BLACK"]
    if focal not in ("HISP",):
        base = base + ["HISP"]
    if focal not in ("SEX_F",):
        base = base + ["SEX_F"]
    if focal not in ("FAMSZ",):
        base = base + ["FAMSZ"]
    return base

CONTROL_VARIANTS = {
    "B1 SES+ASVAB+PCT (canonical)": B1_SES_ACAD,
    "B2 SES+PCT (class rank)": B2_SES_PCT,
    "B3 SES+ASVAB (ability)": B3_SES_ASVAB,
}

def fit(fam, y, X):
    if fam == "logit":
        return sm.Logit(y, X).fit(disp=0)
    if fam == "probit":
        return sm.Probit(y, X).fit(disp=0)
    return sm.OLS(y, X).fit()

rows = []
y = df["BA"].values
for label, foc in FOCALS.items():
    xf = df[foc].values
    for fam in ["logit", "probit", "ols"]:
        # Model A: bivariate
        Xa = sm.add_constant(xf)
        try:
            ma = fit(fam, y, Xa)
            biv_b, biv_p = float(ma.params[1]), float(ma.params[1] > 0 or True)  # placeholder
            biv_b, biv_p = float(ma.params[1]), float(ma.pvalues[1])
        except Exception:
            continue
        variants = {k: v for k, v in CONTROL_VARIANTS.items()}
        variants["B4 social+academic"] = b4_controls(foc)
        for vname, controls in variants.items():
            cols = [c for c in controls if c != foc]
            Xmat = np.column_stack([xf] + [df[c].values for c in cols])
            Xb = sm.add_constant(Xmat)
            try:
                mb = fit(fam, y, Xb)
                full_b, full_p = float(mb.params[1]), float(mb.pvalues[1])
            except Exception as e:
                rows.append({
                    "focal": label, "var": foc, "model_family": fam,
                    "model_B": vname, "biv_b": biv_b, "biv_p": biv_p,
                    "full_b": np.nan, "full_p": np.nan, "note": f"fit failed: {e}"})
                continue
            rows.append({
                "focal": label, "var": foc, "model_family": fam,
                "model_B": vname, "biv_b": biv_b, "biv_p": biv_p,
                "full_b": full_b, "full_p": full_p, "note": ""})

res = pd.DataFrame(rows)
res["drop_pct"] = 100 * (1 - res["full_b"] / res["biv_b"])
res["drop_x"] = res["biv_b"] / res["full_b"]
res["biv_target_dist"] = (res["biv_b"] - TARGET_BIV).abs()
res["full_target_dist"] = (res["full_b"] - TARGET_FULL).abs()
res["ns"] = res["full_p"] > 0.05
res.to_csv(os.path.join(OUT, "score_table_all_candidates.csv"), index=False)

# ----------------------------------------------------------------------------
# 3. Candidate scoring summary (LOGIT / canonical B1) + key variants
# ----------------------------------------------------------------------------
logit_b1 = res[(res["model_family"] == "logit") & (res["model_B"] == "B1 SES+ASVAB+PCT (canonical)")].copy()
logit_b1 = logit_b1.sort_values("biv_b")
print("\n================ CANONICAL TWO-MODEL COMPARISON (logit) ================")
print("Target: bivariate +0.5024 -> full +0.0923 (ns)")
print(logit_b1[["focal", "biv_b", "biv_p", "full_b", "full_p", "ns", "drop_x", "biv_target_dist", "full_target_dist"]].round(4).to_string(index=False))

# focus table: which variants each focal collapses under
print("\n================ FULL-MODEL COEFFICIENTS BY CONTROL VARIANT (logit) ================")
pivot = res[res["model_family"] == "logit"].pivot_table(
    index="focal", columns="model_B", values="full_b", aggfunc="first").round(4)
print(pivot.to_string())
pivot_p = res[res["model_family"] == "logit"].pivot_table(
    index="focal", columns="model_B", values="full_p", aggfunc="first").round(4)
print("\n(full-model p-values)")
print(pivot_p.to_string())

# ----------------------------------------------------------------------------
# 4. SES sign-flip check
# ----------------------------------------------------------------------------
print("\n================ SES-specific sensitivity (logit) ================")
for tag, cols in [("SES alone", ["SES"]), ("+PCT", ["SES", "PCT"]), ("+ASVAB", ["SES", "ASVAB"]),
                  ("+PCT+ASVAB", ["SES", "PCT", "ASVAB"]), ("+PCT+ASVAB+race+sex+famsz", ["SES", "PCT", "ASVAB", "WHITE", "BLACK", "HISP", "SEX_F", "FAMSZ"])]:
    X = sm.add_constant(df[cols].values)
    m = sm.Logit(y, X).fit(disp=0)
    print(f"SES in model {tag:>28}: b={m.params[1]:.4f} p={m.pvalues[1]:.4f}")

# ----------------------------------------------------------------------------
# 5. Write inspection JSON + summary text
# ----------------------------------------------------------------------------
with open(os.path.join(OUT, "inspection.json"), "w") as f:
    json.dump(inspection, f, indent=2, default=float)

summary_lines = []
summary_lines.append("INSPECTION:")
for k, v in inspection.items():
    if k != "corr_with_BA":
        summary_lines.append(f"  {k}: {v}")
    else:
        summary_lines.append(f"  corr_with_BA: {v}")
summary_lines.append("")
summary_lines.append("TIE-BREAK (researcher rule): SES is framed as a CONTROL in the question,")
summary_lines.append("so the focal must be a social-background factor whose association collapses")
summary_lines.append("once SES + academic characteristics enter. Family size is ruled out (no collapse);")
summary_lines.append("sex never reaches ~0.50. Leading candidate = RACE (White vs non-White).")
summary_lines.append("")
with open(os.path.join(OUT, "summary.txt"), "w") as f:
    f.write("\n".join(summary_lines))

print("\n================ INSPECTION ================")
for s in summary_lines:
    print(s)
print("\nOutputs written to", OUT)
