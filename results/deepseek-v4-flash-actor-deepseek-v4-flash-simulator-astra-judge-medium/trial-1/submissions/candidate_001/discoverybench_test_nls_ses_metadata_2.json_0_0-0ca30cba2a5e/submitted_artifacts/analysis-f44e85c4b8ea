"""
Analysis: Is the SES -> degree-completion association moderated by race?
Data: data/nls_ses_processed.csv (NLS-derived, n=8773, no missingness)
Design:
  Primary   : full-sample logistic regression, BA ~ SES(std) * race (White ref) + controls
              (sex, ability/ASVAB, percentile-in-class, family size); LR test + Wald test
              of the SES x race interaction; race-specific SES OR (per SD) with 95% CI.
  Secondary : race-stratified logits (with and without controls), including within-race
              SES-standardized ORs.
  Robustness: (a) SES global-tertile x race interaction; (b) Firth penalized logistic
              (rare outcome: 236 events; Hispanic 19, Black 28) on primary + stratified;
              (c) VIF collinearity check for ability vs percentile.
No causal claim is intended ("affected by racial lines" = statistical moderation).
"""
import numpy as np
import pandas as pd
import statsmodels.api as sm
from scipy import stats
from scipy.optimize import minimize

pd.set_option('display.width', 220)
pd.set_option('display.max_columns', 50)
pd.set_option('display.float_format', lambda x: f'{x:.4f}')

df = pd.read_csv('data/nls_ses_processed.csv').drop(columns=['Unnamed: 0'])
df['BA'] = df['BA DEGREE COMPLETED'].astype(int)

def z(s):  # global standardization
    return (s - s.mean()) / s.std(ddof=0)

df['SES_std']   = z(df['SES'])
df['ABILITY_std'] = z(df['ABILITY: COMPOSITE OF ASVAB SCORE'])
df['PERCENTILE_std'] = z(df['PERCENTILE IN CLASS'])
df['FAMILY_SIZE_std'] = z(df['FAMILY SIZE OF SAMPLE'])
df['Female'] = (df['SAMPLE_SEX'] == 'Female').astype(float)

d = pd.get_dummies(df['SAMPLE_RACE'], prefix='race')  # columns race_Black, race_Hispanic, race_White
df['Black']    = d['race_Black'].astype(float)
df['Hispanic'] = d['race_Hispanic'].astype(float)
df['SESxBlack']    = df['SES_std'] * df['Black']
df['SESxHispanic'] = df['SES_std'] * df['Hispanic']

CONTROLS = ['Female', 'ABILITY_std', 'PERCENTILE_std', 'FAMILY_SIZE_std']

def build_X(interaction, add_controls):
    cols = ['SES_std', 'Black', 'Hispanic']
    if interaction:
        cols += ['SESxBlack', 'SESxHispanic']
    if add_controls:
        cols += CONTROLS
    cols += ['const']
    X = df[[c for c in cols if c != 'const']].copy()
    X['const'] = 1.0
    return X, cols

y = df['BA'].values

# ---------------------------------------------------------------- PRIMARY
full_cols = ['SES_std', 'Black', 'Hispanic', 'SESxBlack', 'SESxHispanic'] + CONTROLS + ['const']
Xf, _ = build_X(interaction=True, add_controls=True)
print("=" * 100)
print("PRIMARY: full-sample logistic, BA ~ SES_std * race + controls (White = reference)")
print("=" * 100)
m_full = sm.Logit(y, Xf).fit(disp=0)
print(m_full.summary2().tables[1][['Coef.', 'Std.Err.', 'z', 'P>|z|', '[0.025', '0.975]']])
print(f"\nLog-likelihood (full): {m_full.llf:.3f}")

# Wald joint test of interaction terms
wald = m_full.wald_test('SESxBlack = 0, SESxHispanic = 0', scalar=True)
print(f"\nWald joint test (SESxBlack = SESxHispanic = 0): chi2={wald.statistic:.3f}, df={wald.df_denom:.0f}, p={wald.pvalue:.4f}")
for term in ['SESxBlack', 'SESxHispanic']:
    w = m_full.wald_test(f'{term} = 0', scalar=True)
    print(f"Wald {term}: chi2={w.statistic:.3f}, p={w.pvalue:.4f}")

# LR test: full vs reduced (no interaction), same controls
Xr, _ = build_X(interaction=False, add_controls=True)
m_reduced = sm.Logit(y, Xr).fit(disp=0)
lr = 2 * (m_full.llf - m_reduced.llf)
p_lr = stats.chi2.sf(lr, 2)
print(f"\nLR test (interaction vs no-interaction, df=2): LR={lr:.3f}, p={p_lr:.4g}")

# Race-specific SES effect (per SD) from controlled interaction model + CI
def race_ses_effect(model):
    b = model.params
    cov = model.cov_params()
    out = {}
    for race, base, inter in [('White', 'SES_std', None), ('Black', 'SES_std', 'SESxBlack'), ('Hispanic', 'SES_std', 'SESxHispanic')]:
        beta = b[base] + (b[inter] if inter else 0.0)
        var = cov.loc[base, base]
        if inter:
            var += cov.loc[inter, inter] + 2 * cov.loc[base, inter]
        se = np.sqrt(var)
        lo, hi = beta - 1.96 * se, beta + 1.96 * se
        out[race] = dict(logOR=beta, se=se, OR=np.exp(beta), lo=np.exp(lo), hi=np.exp(hi), p=2 * stats.norm.sf(abs(beta / se)))
    return out

print(f"\nRace-specific SES effect, per 1 SD SES, CONTROLLED interaction model:")
race_eff = race_ses_effect(m_full)
for k, v in race_eff.items():
    print(f"  {k:9s}: OR={v['OR']:.3f}  95%CI=({v['lo']:.3f},{v['hi']:.3f})  p={v['p']:.4f}")

# ---------------------------------------------------------------- SECONDARY: stratified
print("\n" + "=" * 100)
print("SECONDARY: race-stratified logits — SES_std effect with & without controls")
print("=" * 100)
strat = {}
for race in ['White', 'Black', 'Hispanic']:
    sub = df[df['SAMPLE_RACE'] == race]
    sy = sub['BA'].values
    row = dict(n=len(sub), events=int(sy.sum()))
    for label, cols in [('no-controls', ['SES_std', 'const']), ('controls', ['SES_std'] + CONTROLS + ['const'])]:
        SX = sub[[c for c in cols if c != 'const']].copy()
        SX['const'] = 1.0
        SX = SX[cols]
        m = sm.Logit(sy, SX).fit(disp=0)
        b, se = m.params['SES_std'], m.bse['SES_std']
        ci = m.conf_int().loc['SES_std']
        row[label] = dict(OR=np.exp(b), lo=np.exp(ci[0]), hi=np.exp(ci[1]), p=m.pvalues['SES_std'])
        print(f"  [{race}] {label:12s}: OR_per_SD={np.exp(b):.3f} 95%CI=({np.exp(ci[0]):.3f},{np.exp(ci[1]):.3f}) p={m.pvalues['SES_std']:.4f}  (n={len(sub)}, events={sy.sum()})")
    # within-race SES standardization (sensitivity)
    sub2 = sub.copy()
    sub2['SES_wr'] = z(sub2['SES'])
    SX2 = sub2[['SES_wr'] + CONTROLS].copy()
    SX2['const'] = 1.0
    SX2 = SX2[['SES_wr'] + CONTROLS + ['const']]
    m2 = sm.Logit(sub2['BA'].values, SX2).fit(disp=0)
    ci = m2.conf_int().loc['SES_wr']
    print(f"  [{race}] within-race-SD: OR={np.exp(m2.params['SES_wr']):.3f} 95%CI=({np.exp(ci[0]):.3f},{np.exp(ci[1]):.3f}) p={m2.pvalues['SES_wr']:.4f}")
    strat[race] = row

# ---------------------------------------------------------------- ROBUSTNESS A: SES tertiles
print("\n" + "=" * 100)
print("ROBUSTNESS A: SES global-tertile bin x race interaction (controlled)")
print("=" * 100)
df['SES_t'] = pd.qcut(df['SES'], 3, labels=['Low', 'Mid', 'High'])
dm = pd.get_dummies(df['SES_t'], prefix='ses').astype(float)  # Low/Mid/High
df['SES_Mid'] = dm['ses_Mid']; df['SES_High'] = dm['ses_High']
df['SES_MidxBlack'] = df['SES_Mid'] * df['Black']
df['SES_HighxBlack'] = df['SES_High'] * df['Black']
df['SES_MidxHispanic'] = df['SES_Mid'] * df['Hispanic']
df['SES_HighxHispanic'] = df['SES_High'] * df['Hispanic']
colsA = ['SES_Mid', 'SES_High', 'Black', 'Hispanic',
         'SES_MidxBlack', 'SES_HighxBlack', 'SES_MidxHispanic', 'SES_HighxHispanic'] + CONTROLS + ['const']
XA = df[[c for c in colsA if c != 'const']].copy(); XA['const'] = 1.0; XA = XA[colsA]
mA = sm.Logit(y, XA).fit(disp=0)
colsA_r = ['SES_Mid', 'SES_High', 'Black', 'Hispanic'] + CONTROLS + ['const']
XAr = df[[c for c in colsA_r if c != 'const']].copy(); XAr['const'] = 1.0; XAr = XAr[colsA_r]
mAr = sm.Logit(y, XAr).fit(disp=0)
lrA = 2 * (mA.llf - mAr.llf); pA = stats.chi2.sf(lrA, 4)
print(f"LR test (SES-bin x race interactions, df=4): LR={lrA:.3f}, p={pA:.4g}")
print("SES-tier ORs (vs Low, ref=White) and interaction ORs:")
for c in ['SES_Mid', 'SES_High', 'SES_Mid:Black', 'SES_High:Black', 'SES_Mid:Hispanic', 'SES_High:Hispanic']:
    pass
# manual naming
for c, inter in [('SES_Mid', 'SES_MidxBlack'), ('SES_High', 'SES_HighxBlack'),
                 ('SES_Mid', 'SES_MidxHispanic'), ('SES_High', 'SES_HighxHispanic')]:
    b = mA.params[inter]; ci = mA.conf_int().loc[inter]
    print(f"  {inter:18s}: OR={np.exp(b):.3f} 95%CI=({np.exp(ci[0]):.3f},{np.exp(ci[1]):.3f}) p={mA.pvalues[inter]:.4f}")

# ---------------------------------------------------------------- ROBUSTNESS B: Firth
print("\n" + "=" * 100)
print("ROBUSTNESS B: Firth penalized logistic (rare-outcome sensitivity)")
print("=" * 100)

def firth_fit(X, y):
    """Firth penalized logistic: minimize -[LL + 0.5*log|I(beta)|] with analytic gradient."""
    X = np.asarray(X, dtype=float); y = np.asarray(y, dtype=float).ravel()
    p = X.shape[1]
    def pen_grad(beta):
        xb = X @ beta
        mu = 1.0 / (1.0 + np.exp(-xb))
        Wdiag = mu * (1.0 - mu)
        I = (X * Wdiag[:, None]).T @ X
        invI = np.linalg.inv(I)
        g = np.empty(p)
        for j in range(p):
            dI = (X * (Wdiag * (1.0 - 2.0 * mu) * X[:, j])[:, None]).T @ X
            g[j] = 0.5 * np.trace(invI @ dI)
        return g
    def obj_and_grad(beta):
        xb = X @ beta
        mu = 1.0 / (1.0 + np.exp(-xb))
        ll = np.sum(y * xb - np.logaddexp(0, xb))
        Wdiag = mu * (1.0 - mu)
        I = (X * Wdiag[:, None]).T @ X
        sign, logdet = np.linalg.slogdet(I)
        f = -(ll + 0.5 * logdet)
        gr = -(X.T @ (y - mu)) - pen_grad(beta)
        return f, gr
    beta0 = np.zeros(p)
    res = minimize(obj_and_grad, beta0, method='L-BFGS-B', jac=True,
                   options={'ftol': 1e-12, 'gtol': 1e-9, 'maxiter': 3000})
    beta = res.x
    xb = X @ beta
    mu = 1.0 / (1.0 + np.exp(-xb))
    Wdiag = mu * (1.0 - mu)
    I = (X * Wdiag[:, None]).T @ X
    cov = np.linalg.inv(I)
    se = np.sqrt(np.diag(cov))
    return beta, se, cov, res

# Firth on primary controlled interaction model
XB = Xf.values
bF, seF, covF, resF = firth_fit(XB, y)
names = Xf.columns.tolist()
print(f"Firth convergence: {resF.success} (msg: {resF.message})")
print("Firth primary model — race-specific SES effect per SD:")
for race, base, inter in [('White', 'SES_std', None), ('Black', 'SES_std', 'SESxBlack'), ('Hispanic', 'SES_std', 'SESxHispanic')]:
    i_base = names.index(base)
    beta = bF[i_base] + (bF[names.index(inter)] if inter else 0.0)
    var = covF[i_base, i_base]
    if inter:
        i_inter = names.index(inter)
        var += covF[i_inter, i_inter] + 2 * covF[i_base, i_inter]
    se = np.sqrt(var)
    print(f"  {race:9s}: OR={np.exp(beta):.3f} 95%CI=({np.exp(beta - 1.96 * se):.3f},{np.exp(beta + 1.96 * se):.3f}) logOR={beta:.4f} (se={se:.4f})")

# Firth stratified (no controls) — key rare-event check
print("\nFirth stratified (SES_std only):")
for race in ['White', 'Black', 'Hispanic']:
    sub = df[df['SAMPLE_RACE'] == race]
    Xs = sm.add_constant(sub[['SES_std']], has_constant='add', prepend=False).values  # [SES, const]; SES=idx0
    b, se, cov, _ = firth_fit(Xs, sub['BA'].values.astype(float))
    print(f"  [{race}] n={len(sub)} events={int(sub['BA'].sum())}: OR={np.exp(b[0]):.3f} 95%CI=({np.exp(b[0]-1.96*se[0]):.3f},{np.exp(b[0]+1.96*se[0]):.3f}) p={2*stats.norm.sf(abs(b[0]/se[0])):.4f}")

# ---------------------------------------------------------------- ROBUSTNESS C: VIF
print("\n" + "=" * 100)
print("ROBUSTNESS C: VIF (collinearity) on main-effects controlled model")
print("=" * 100)
pred_cols = ['SES_std'] + CONTROLS
R = df[pred_cols].corr()
vif = {}
for c in pred_cols:
    others = [o for o in pred_cols if o != c]
    Xo = sm.add_constant(df[others])
    r2 = sm.OLS(df[c], Xo).fit().rsquared
    vif[c] = 1.0 / (1.0 - r2)
for k, v in vif.items():
    print(f"  VIF {k:16s}: {v:.3f}")
print(f"\nCorrelation matrix:\n{R}")

# ---------------------------------------------------------------- Key summary counts (traceability)
print("\n" + "=" * 100)
print("TRACE: key numbers for the hypothesis")
print("=" * 100)
print(f"Overall BA rate: {df['BA'].mean():.4f} ({df['BA'].sum()}/{len(df)})")
print(f"By race BA rates:\n{df.groupby('SAMPLE_RACE')['BA'].agg(['count','mean'])}")
print("\nRace-specific SES OR (per SD) from CONTROLLED interaction model (primary):")
for k, v in race_eff.items():
    print(f"  {k:9s}: OR={v['OR']:.3f} (95%CI {v['lo']:.3f}-{v['hi']:.3f})")
print(f"\nModeration tests: LR(2)={lr:.3f} p={p_lr:.4g} | Wald(2) chi2={wald.statistic:.3f} p={wald.pvalue:.4g}")
