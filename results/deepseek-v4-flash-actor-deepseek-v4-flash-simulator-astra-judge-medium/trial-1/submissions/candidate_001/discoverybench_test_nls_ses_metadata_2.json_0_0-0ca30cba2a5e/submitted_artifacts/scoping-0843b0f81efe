"""Scoping inspection for NLS SES dataset (DiscoveryBench task)."""
import pandas as pd
import numpy as np
from scipy.stats import pearsonr
import statsmodels.api as sm

pd.set_option('display.width', 200)
pd.set_option('display.max_columns', 50)
pd.set_option('display.float_format', lambda x: f'{x:.4f}')

df = pd.read_csv('data/nls_ses_processed.csv')

print("SHAPE:", df.shape)
print("\nDTYPES:\n", df.dtypes)
print("\nMISSING per column:\n", df.isna().sum())
print("\nDuplicated CASE IDs:", df['CASE ID'].duplicated().sum())

print("\n=== SAMPLE_RACE ===")
print(df['SAMPLE_RACE'].value_counts())
print("\n=== SAMPLE_SEX ===")
print(df['SAMPLE_SEX'].value_counts())
print("\n=== BA DEGREE COMPLETED overall ===")
print("Rate:", df['BA DEGREE COMPLETED'].mean(), "| counts:\n", df['BA DEGREE COMPLETED'].value_counts())
print("\n=== BA completion by race ===")
print(df.groupby('SAMPLE_RACE')['BA DEGREE COMPLETED'].agg(['count', 'mean']))
print("\n=== SES summary (overall & by race) ===")
print(df['SES'].describe())
print(df.groupby('SAMPLE_RACE')['SES'].describe())
print("\n=== ABILITY ===")
print(df['ABILITY: COMPOSITE OF ASVAB SCORE'].describe())
print("\n=== PERCENTILE IN CLASS ===")
print(df['PERCENTILE IN CLASS'].describe())

# Scoping cross-tab: BA rate by race x SES global tercile
df['SES_tercile'] = pd.qcut(df['SES'], 3, labels=['Low SES', 'Mid SES', 'High SES'])
print("\n=== BA completion rate & N by RACE x SES tercile ===")
print(df.groupby(['SAMPLE_RACE', 'SES_tercile'], observed=True)['BA DEGREE COMPLETED'].agg(['count', 'mean']))

r, p = pearsonr(df['SES'], df['BA DEGREE COMPLETED'].astype(int))
print(f"\nPoint-biserial SES~BA: r={r:.4f}, p={p:.2e}")

# Univariate logit per race (scoping preview)
for race in ['White', 'Black', 'Hispanic']:
    sub = df[df['SAMPLE_RACE'] == race]
    X = sm.add_constant(sub['SES'])
    m = sm.Logit(sub['BA DEGREE COMPLETED'].astype(int), X).fit(disp=0)
    ci = m.conf_int().loc['SES']
    print(f"Univariate logit SES->BA [{race}]: OR={np.exp(m.params['SES']):.3f} "
          f"95%CI=({np.exp(ci[0]):.3f},{np.exp(ci[1]):.3f}) p={m.pvalues['SES']:.3f} "
          f"n={len(sub)} events={sub['BA DEGREE COMPLETED'].sum()}")

print("\n=== Predictor correlations ===")
print(df[['SES', 'ABILITY: COMPOSITE OF ASVAB SCORE', 'PERCENTILE IN CLASS']].corr())
