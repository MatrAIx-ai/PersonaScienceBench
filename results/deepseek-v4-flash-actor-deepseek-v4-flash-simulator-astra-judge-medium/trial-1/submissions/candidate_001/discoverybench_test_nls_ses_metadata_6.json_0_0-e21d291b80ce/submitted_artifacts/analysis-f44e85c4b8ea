"""DiscoveryBench: At what SES levels is the Black completion-rate advantage most pronounced?
Main analysis + sensitivity checks. Outputs CSV tables to analysis/results/."""
import os, pandas as pd, numpy as np, statsmodels.api as sm
from scipy import stats

OUT = "analysis/results"; os.makedirs(OUT, exist_ok=True)
df = pd.read_csv('data/nls_ses_processed.csv')
df['completed'] = df['BA DEGREE COMPLETED'].astype(int)
df['SES_c'] = df['SES'] - df['SES'].mean()
df['race'] = df['SAMPLE_RACE'].astype(str)
df['Black'] = (df['race']=='Black').astype(int)
df['Hispanic'] = (df['race']=='Hispanic').astype(int)

def wilson(k, n, z=1.96):
    if n == 0: return (np.nan, np.nan)
    p = k/n; denom = 1 + z**2/n
    center = (p + z**2/(2*n))/denom
    half = z*np.sqrt(p*(1-p)/n + z**2/(4*n**2))/denom
    return (center-half)*100, (center+half)*100

def rate_table(df, bcol):
    rows=[]
    for (race,b),g in df.groupby(['SAMPLE_RACE',bcol], observed=True):
        k=int(g['completed'].sum()); n=int(len(g)); lo,hi=wilson(k,n)
        rows.append({'race':race,'ses_level':b,'n':n,'completed':k,
                     'rate_pct':round(k/n*100,3),'ci_lo_pct':round(lo,3),
                     'ci_hi_pct':round(hi,3),'ci_width_pct':round(hi-lo,3)})
    return pd.DataFrame(rows)

def gaps_table(df, bcol):
    res=[]
    for b,g in df.groupby(bcol, observed=True):
        blk=g[g['SAMPLE_RACE']=='Black']; whi=g[g['SAMPLE_RACE']=='White']
        his=g[g['SAMPLE_RACE']=='Hispanic']; oth=g[g['SAMPLE_RACE']!='Black']
        res.append({'ses_level':b,'n_black':len(blk),'n_white':len(whi),'n_other':len(oth),
            'r_black_pct':round(blk['completed'].mean()*100,3),
            'r_white_pct':round(whi['completed'].mean()*100,3),
            'r_hispanic_pct':round(his['completed'].mean()*100,3),
            'r_other_pct':round(oth['completed'].mean()*100,3),
            'gap_white_minus_black_pp':round((whi['completed'].mean()-blk['completed'].mean())*100,3),
            'gap_other_minus_black_pp':round((oth['completed'].mean()-blk['completed'].mean())*100,3),
            'gap_hispanic_minus_black_pp':round((his['completed'].mean()-blk['completed'].mean())*100,3)})
    return pd.DataFrame(res)

for k,label in [(3,'tercile'),(4,'quartile')]:
    df[f'bin_{k}'] = pd.qcut(df['SES'], k, labels=[f'{label}{i+1}' for i in range(k)])
    rt = rate_table(df, f'bin_{k}'); rt.to_csv(f'{OUT}/rates_race_{label}.csv', index=False)
    gt = gaps_table(df, f'bin_{k}'); gt.to_csv(f'{OUT}/gaps_race_{label}.csv', index=False)
    print(f"### RACE x SES {label.upper()} ###")
    print(rt.to_string(index=False)); print()
    print(gt[['ses_level','r_black_pct','r_white_pct','r_other_pct',
              'gap_white_minus_black_pp','gap_other_minus_black_pp']].to_string(index=False)); print()
    df.drop(columns=[f'bin_{k}'], inplace=True)

# Logistic, continuous SES x race (baseline White)
m_full = smf_logit = None
import statsmodels.formula.api as smf
m_full = smf.logit('completed ~ SES_c * Black + SES_c * Hispanic', data=df).fit(disp=0)
m_main = smf.logit('completed ~ SES_c + Black + Hispanic', data=df).fit(disp=0)
lr = -2*(m_main.llf - m_full.llf); p = 1-stats.chi2.cdf(lr,2)
print("### LOGIT continuous SES x race (baseline White) ###")
print(pd.DataFrame({'coef':m_full.params,'p':m_full.pvalues}).round(4).to_string())
print(f"\nLR test for interactions (2 df): chi2={lr:.3f}, p={p:.4f}")

# Predicted trajectory
srange = df['SES_c'].quantile([0.10,0.25,0.50,0.75,0.90])
Xp = pd.DataFrame({'Intercept':1.0,'SES_c':srange.values,'Black':1,'Hispanic':0,
                   'SES_c:Black':srange.values,'SES_c:Hispanic':0})
pb = m_full.predict(Xp)
Xp['Black']=0; Xp['SES_c:Black']=0
pw = m_full.predict(Xp)
print("\nPredicted Black vs White completion by SES centile:")
for q,x,y in zip(srange.index,pb,pw):
    print(f"  {q:.0%}: Black={100*x:.3f}% White={100*y:.3f}%  diffB-W={100*(x-y):+.3f}pp")

# Adjusted model (ability + class percentile), design matrix
X = pd.DataFrame({'Intercept':1.0,'SES_c':df['SES_c'],'Black':df['Black'],'Hispanic':df['Hispanic'],
    'SES_c_Black':df['SES_c']*df['Black'],'SES_c_Hispanic':df['SES_c']*df['Hispanic'],
    'ABILITY':df['ABILITY: COMPOSITE OF ASVAB SCORE'],'PERCENTILE':df['PERCENTILE IN CLASS']})
m_adj = sm.Logit(df['completed'], X).fit(disp=0)
Xm = X[['Intercept','SES_c','Black','Hispanic','ABILITY','PERCENTILE']]
m_adjm = sm.Logit(df['completed'], Xm).fit(disp=0)
lr2 = -2*(m_adjm.llf-m_adj.llf); p2 = 1-stats.chi2.cdf(lr2,2)
print("\n### LOGIT adjusted for ABILITY + CLASS PERCENTILE (interpretation only) ###")
print(pd.DataFrame({'coef':m_adj.params,'p':m_adj.pvalues}).round(4).to_string())
print(f"LR test for interactions (adjusted): chi2={lr2:.3f}, p={p2:.4f}")

# Within-race terciles (secondary lens)
df['SES_wr'] = df.groupby('race')['SES'].transform(lambda x: pd.qcut(x,3,labels=['low','mid','high']))
wr = df.groupby(['race','SES_wr'])['completed'].agg(['sum','count']).assign(rate_pct=lambda d:(d['sum']/d['count']*100).round(3))
wr.to_csv(f'{OUT}/within_race_terciles.csv')
print("\n### WITHIN-RACE SES terciles (secondary lens) ###")
print(wr.to_string())
print("\nMean absolute SES in each race's own top tercile:")
print(df[df['SES_wr']=='high'].groupby('race')['SES'].mean().round(3).to_string())
print("\nSaved CSVs:", sorted(os.listdir(OUT)))
