"""
DiscoveryBench - requirements_engineering_for_ML-enabled_systems
Full analysis: per-role proportion of association with ML requirements (Q8),
ranking, bootstrap 95% CIs (percentile + SE + normal-approx/BCa cross-check),
robustness under -77-as-0 (denominator 276), and reference-CI mismatch audit.
"""
import csv, collections
import numpy as np
from scipy.stats import norm

PATH = "data/requirements_engineering_for_ML-enabled_systems.csv"
with open(PATH, newline="", encoding="utf-8") as f:
    reader = csv.reader(f)
    header = next(reader)
    rows = list(reader)

ROLE_COLS = [
    "Q8_ML_Addressing_Project_Lead",
    "Q8_ML_Addressing_Business_Analyst",
    "Q8_ML_Addressing_Requirement_Engineer",
    "Q8_ML_Addressing_Solution_Architect",
    "Q8_ML_Addressing_Data_Scientist",
    "Q8_ML_Addressing_Developer",
    "Q8_ML_Addressing_Tester",
]
ROLES = [c.replace("Q8_ML_Addressing_", "") for c in ROLE_COLS]
IX = [header.index(c) for c in ROLE_COLS]
N_all = len(rows)
N_valid = [sum(r[i] != "-77" for r in rows) for i in IX]
assert all(n == N_valid[0] for n in N_valid), "uneven valid n across roles"
N = N_valid[0]

# valid respondent mask (same for all roles: skip block = 82)
valid_mask = [r[IX[0]] != "-77" for r in rows]
X = np.array([[1 if r[i] == "quoted" else 0 for r in rows] for i in IX])[:, np.array(valid_mask)]

print(f"total rows={N_all}  valid Q8 respondents={N}  (skip block -77 = {N_all - N})")

# ---- observed proportions (denominator 194) ----
p_obs = X.mean(axis=1)
order = np.argsort(-p_obs)
print("\n=== Ranked table (denominator = valid Q8 n = 194; -77 = NA) ===")
print(f"{'Role':<24}{'quoted':>8}{'n':>5}{'proportion':>12}")
for j in order:
    print(f"{ROLES[j]:<24}{int(X[j].sum()):>8}{N:>5}{p_obs[j]*100:>11.2f}%")

# ---- bootstrap percentile 95% CI + SE (B=10k, seed=42) ----
rng = np.random.RandomState(42)
B = 10000
boot = np.empty((len(ROLES), B))
for b in range(B):
    idx = rng.randint(0, N, size=N)
    boot[:, b] = X[:, idx].mean(axis=1)

lo = np.percentile(boot, 2.5, axis=1)
hi = np.percentile(boot, 97.5, axis=1)
se = boot.std(axis=1)

print("\n=== Bootstrap 95% percentile CIs (B=10,000; RandomState(42)) ===")
print(f"{'Role':<24}{'prop':>9}{'95% CI':>22}{'boot SE':>9}")
for j in order:
    print(f"{ROLES[j]:<24}{p_obs[j]*100:>8.2f}%  [{lo[j]*100:6.2f}, {hi[j]*100:6.2f}]  {se[j]*100:7.2f} pp")

# ---- cross-check for top-2: normal-approx + BCa ----
def bca_ci(x, boot_samp, alpha=0.05):
    p = x.mean()
    n = len(x)
    # bias correction
    z0 = norm.ppf(np.mean(boot_samp < p) + np.mean(boot_samp == p) / 2)
    # jackknife leave-one-out for acceleration
    theta_j = np.array([(x.sum() - x[k]) / (n - 1) for k in range(n)])
    theta_bar = theta_j.mean()
    num = np.sum((theta_bar - theta_j) ** 3)
    den = 6 * (np.sum((theta_bar - theta_j) ** 2) ** 1.5)
    a = num / den if den > 0 else 0.0
    za = norm.ppf(1 - alpha / 2)
    a1 = norm.cdf(z0 + (z0 - za) / (1 - a * (z0 - za)))
    a2 = norm.cdf(z0 + (z0 + za) / (1 - a * (z0 + za)))
    return np.percentile(boot_samp, [100 * a1, 100 * a2])

print("\n=== Cross-check for TOP-2 (normal-approx & BCa) ===")
for j in order[:2]:
    norm_lo, norm_hi = p_obs[j] - 1.96 * se[j], p_obs[j] + 1.96 * se[j]
    bca_lo, bca_hi = bca_ci(X[j], boot[j])
    print(f"{ROLES[j]:<24} normal: [{norm_lo*100:6.2f}, {norm_hi*100:6.2f}]   BCa: [{bca_lo*100:6.2f}, {bca_hi*100:6.2f}]")

# ---- robustness: treat -77 as 0 (denominator 276) ----
X276 = np.array([[1 if r[i] == "quoted" else 0 for r in rows] for i in IX])
p276 = X276.mean(axis=1)
ord276 = np.argsort(-p276)
print("\n=== Robustness: -77 as 0, denominator 276 ===")
for j in ord276:
    print(f"{ROLES[j]:<24}{p276[j]*100:>8.2f}%  (quoted {int(X276[j].sum())}/276)")
print("top-2 under denom 276:", [ROLES[j] for j in ord276[:2]])

# ---- reference-CI mismatch audit ----
print("\n=== Reference estimate mismatch audit ===")
for p_ref, width in [(0.61389, 0.61822 - 0.60955), (0.496, 0.49981 - 0.49219)]:
    se_ref = width / (2 * 1.96)
    n_impl = p_ref * (1 - p_ref) / se_ref**2
    se_here = (p_ref * (1 - p_ref) / N) ** 0.5
    print(f"ref {p_ref*100:.3f}%  CI width {width*100:.3f} pp -> implied n ~ {n_impl:,.0f}   |  at n={N}: CI ~ +/-{1.96*se_here*100:.1f} pp (width {2*1.96*se_here*100:.1f} pp)")

# ---- save results ----
import json
out = {"total_rows": N_all, "valid_n": N, "top2_seed": 42, "B": B,
       "roles": {ROLES[j]: {"quoted": int(X[j].sum()), "n": N,
                            "proportion": round(p_obs[j], 6),
                            "ci95": [round(lo[j], 6), round(hi[j], 6)],
                            "boot_se": round(se[j], 6)} for j in range(len(ROLES))}}
with open("q8_analysis_results.json", "w") as f:
    json.dump(out, f, indent=2)
print("\nsaved -> q8_analysis_results.json")
