"""
DiscoveryBench - requirements_engineering_for_ML-enabled_systems inspection (PLAN STAGE).

Inspection only (no bootstrap ranking yet): reports encoding, missingness,
and role-proportion point estimates that ground the proposed analysis plan.
"""
import csv
import collections

PATH = "data/requirements_engineering_for_ML-enabled_systems.csv"

with open(PATH, newline="", encoding="utf-8") as f:
    reader = csv.reader(f)
    header = next(reader)
    rows = list(reader)

ROLE_COLS = [
    "Q8_ML_Addressing_Project_Lead",
    "Q8_ML_Addressing_Business_Analyst",
    "Q8_ML_Addressing_Requirement_Engineer",
    "Q8_ML_Addressing_Solution_Architect",
    "Q8_ML_Addressing_Data_Scientist",
    "Q8_ML_Addressing_Developer",
    "Q8_ML_Addressing_Tester",
]
ROLES = [c.replace("Q8_ML_Addressing_", "") for c in ROLE_COLS]
IDX = {c: header.index(c) for c in ROLE_COLS}

print(f"data rows (excl. header): {len(rows)}   |   columns: {len(header)}")

# 1. Value encoding per Q8 role column
print("\n== Q8 role column value encoding ==")
for c in ROLE_COLS:
    vals = collections.Counter(r[header.index(c)] for r in rows)
    print(f"  {c:45s} {dict(vals)}")

# 2. Missingness (negative / -99 / -77 sentinel handling)
print("\n== Missing-cell count per role column (raw negative values = '-77') ==")
all77 = [r for r in rows if all(r[header.index(c)] == "-77" for c in ROLE_COLS)]
part = [r for r in rows if not all(r[header.index(c)] == "-77" for c in ROLE_COLS)
        and any(r[header.index(c)] == "-77" for c in ROLE_COLS)]
print(f"  rows with ALL 7 Q8 role cols == '-77' (skip block): {len(all77)}")
print(f"  rows with SOME but not all -77:                    {len(part)}")
valid = len(rows) - len(all77)
print(f"  => valid Q8 denominator per role: {valid}")

# 3. Proportions of 'quoted' (association) among non-missing
print("\n== 'quoted' proportion per role (quoted / 194) ==")
res = []
for c, role in zip(ROLE_COLS, ROLES):
    cnt = collections.Counter(r[header.index(c)] for r in rows)
    q = cnt.get("quoted", 0)
    prop = q / valid
    res.append((prop, q, role))
    print(f"  {role:22s} q={q:3d}/{valid}  {prop*100:6.2f}%")
res.sort(reverse=True)
print("\n  Ranked top:", [(role, round(p*100, 2)) for p, _, role in res[:3]])

# 4. Elephant check: what n would reproduce the reference CIs?
print("\n== Reference-CI reproducibility check (no bootstrap run) ==")
for p, width in [(0.61389, 0.61822 - 0.60955), (0.496, 0.49981 - 0.49219)]:
    se = width / (2 * 1.96)
    n_implied = p * (1 - p) / (se ** 2)
    print(f"  p={p:.4f}  CI width={width:.4f} -> SE={se:.6f} -> implied n ~ {n_implied:,.0f}")
for p in (0.61389, 0.496):
    se = (p * (1 - p) / valid) ** 0.5
    print(f"  actual n={valid}, p={p:.4f}: expected SE={se:.4f}, 95% CI +/-{1.96*se*100:.1f} pp")
