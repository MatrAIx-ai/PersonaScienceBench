"""
Full analysis of Q9_ML_Elicitation_* (requirements elicitation techniques)
for the ML-enabled-systems survey dataset.

Encoding (validated): 'quoted' = technique selected/used; 'not quoted' = not
selected; '-77' = question not answered (NA); paired free-text column uses
'-66' for the same non-answer group and '-99' when the 'Others' option was not
selected.  CSV is thus read as strings.
"""
import numpy as np
import pandas as pd

DATA = "data/requirements_engineering_for_ML-enabled_systems.csv"
Q9 = [
    "Q9_ML_Elicitation_Interviews",
    "Q9_ML_Elicitation_Scenarios",
    "Q9_ML_Elicitation_Prototyping",
    "Q9_ML_Elicitation_Workshops_Meetings",
    "Q9_ML_Elicitation_Observation",
    "Q9_ML_Elicitation_Others",
]
LABEL = {
    "Q9_ML_Elicitation_Interviews": "Interviews",
    "Q9_ML_Elicitation_Scenarios": "Scenarios",
    "Q9_ML_Elicitation_Prototyping": "Prototyping",
    "Q9_ML_Elicitation_Workshops_Meetings": "Workshops/Meetings",
    "Q9_ML_Elicitation_Observation": "Observation",
    "Q9_ML_Elicitation_Others": "Others",
}

rng = np.random.default_rng(42)  # fixed seed for reproducibility
B = 10_000

df = pd.read_csv(DATA, dtype=str)
n_total = len(df)

print("=" * 78)
print(f"Dataset: {DATA}")
print(f"Total respondents: {n_total}   Rows/Columns: {df.shape}")
print("=" * 78)

# --- validation of -77 no-response block ---
block = (df[Q9] == "-77").sum(axis=1)
print(f"\nRows with '-77' in all six Q9 columns: {(block == 6).sum()} "
      f"(identical non-response block)")
print(f"Rows with zero '-77': {(block == 0).sum()}")

# --- cross-validation via paired free-text column ---
xo = pd.crosstab(df["Q9_ML_Elicitation_Others"], df["Q9_ML_Elicitation_Others_Free"], dropna=False)
print("\nCross-tab Q9_Others (rows) x Q9_Others_Free (cols):")
print(xo)
print("  -> 'quoted' pairs with free text (selected); 'not quoted' pairs with '-99';")
print("     '-77' pairs with '-66' (non-response NA).")

# --- per-technique statistics ---
rows_primary = []   # denominator = valid responders (>=194)
rows_all = []       # robustness: denominator = all 276 (-77 treated as not selected)
valid_mask = df[Q9[0]] != "-77"
n_valid = int(valid_mask.sum())
print(f"\nValid respondents (answered Q9): {n_valid}")

used_any = 0
for c in Q9:
    sel = df.loc[valid_mask, c] == "quoted"
    k = int(sel.sum())
    p_prim = k / n_valid * 100.0
    # bootstrap among valid responders
    y = sel.astype(int).to_numpy()
    boot = np.array([y[rng.integers(0, n_valid, size=n_valid)].mean()
                     for _ in range(B)])
    lo, hi = np.percentile(boot, [2.5, 97.5])
    # robustness: all-276 denominator, -77 as 'not selected'
    k_all = int((df[c] == "quoted").sum())
    p_all = k_all / n_total * 100.0
    rows_primary.append((LABEL[c], k, n_valid - k, k, p_prim, lo * 100, hi * 100))
    rows_all.append((LABEL[c], k_all, n_total - k_all, k_all, p_all))
    if sel.sum() > 0:
        used_any += 0
# respondents using at least one listed technique (among valid)
any_tech = (df.loc[valid_mask, Q9] == "quoted").any(axis=1)
print(f"Valid respondents using at least one listed technique: {int(any_tech.sum())} "
      f"({100 * any_tech.mean():.2f}%)")

cols1 = ["Technique", "Selected", "NotSelected", "k", "%use(n=194)", "CI_low%", "CI_high%"]
tab1 = pd.DataFrame(rows_primary, columns=cols1)
cols2 = ["Technique", "Selected_all", "NotSelected_all", "k", "%use(n=276)"]
tab2 = pd.DataFrame(rows_all, columns=cols2)

print("\n--- PRIMARY: percent of VALID responders (n=194), percentile bootstrap 95% CI (B=10k, seed 42) ---")
print(tab1.to_string(index=False))
print("\n--- ROBUSTNESS: percent of ALL 276 respondents (-77 treated as not selected) ---")
print(tab2.to_string(index=False))

# --- most commonly used ---
best = tab1.sort_values("k", ascending=False).iloc[0]
print("\n--- MOST COMMONLY USED (max selection count / %use) ---")
print(f"{best['Technique']}: selected by {int(best['k'])}/{n_valid} valid responders "
      f"= {best['%use(n=194)']:.3f}% (95% CI [{best['CI_low%']:.3f}, {best['CI_high%']:.3f}])")

# --- claim verification ---
target = 69.399
target_ci = (69.062, 69.735)
print("\n--- CLAIM VERIFICATION: target 69.399% (95% CI [69.062, 69.735]) ---")
print(f"Max achievable single-technique %use in this file = {tab1['%use(n=194)'].max():.3f}% (Interviews).")
inside = bool(((tab1["CI_low%"] <= target) & (target <= tab1["CI_high%"])).any())
print(f"69.399% falls inside any computed per-technique bootstrap CI? {inside}")
# CI width implication
se_implied = (target_ci[1] - target_ci[0]) / (2 * 1.96)
n_implied = 0.69399 * (1 - 0.69399) / (se_implied / 100) ** 2
print(f"Claimed CI half-width implies a sample size of n ≈ {n_implied:,.0f} "
      f"(vs n=276 here) for a binomial proportion.")

# save a compact table for evidence
tab1.to_csv("q9_per_technique_primary.csv", index=False)
tab2.to_csv("q9_per_technique_all276.csv", index=False)
print("\nSaved: q9_per_technique_primary.csv, q9_per_technique_all276.csv")
print("=" * 78)
