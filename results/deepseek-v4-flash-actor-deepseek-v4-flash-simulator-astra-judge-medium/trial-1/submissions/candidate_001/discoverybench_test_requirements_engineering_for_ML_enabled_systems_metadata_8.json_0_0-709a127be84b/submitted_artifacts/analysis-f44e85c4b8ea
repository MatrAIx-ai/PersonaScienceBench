"""
DiscoveryBench: requirements_engineering_for_ML-enabled_systems
Q10 documentation formats - least used formats.

Reproducible verification:
1. Clean Q10 matrix columns (-77 = NA; identical 82 suspended rows).
2. Valid Q10 responder base = 194.
3. Tally 'quoted' (use) per documentation format.
4. Identify the two least-used NAMED formats.
5. Point estimates (%) and bootstrap 95% percentile CIs (computed here).
"""
import numpy as np
import pandas as pd

CSV = "data/requirements_engineering_for_ML-enabled_systems.csv"
df = pd.read_csv(CSV)

q10_cols = [c for c in df.columns
            if c.startswith("Q10_ML_Documentation") and not c.endswith("_Free")]

# --- 1. NA handling -----------------------------------------------------
na_mask = (df[q10_cols] == "-77")
all77 = na_mask.all(axis=1)
print("== NA check ==")
print("Rows where all 12 Q10 matrix cols are '-77':", all77.sum())
print("Rows with at least one '-77':", na_mask.any(axis=1).sum())
print("Status distribution of all-'-77' rows:")
print(df.loc[all77, "Status"].value_counts().to_dict())
print("Each column '-77' count identical:", all([int((df[c]=='-77').sum())==82 for c in q10_cols]))
print("IDs unique:", df['ID'].is_unique)

# --- 2. Analysis base ----------------------------------------------------
valid = df[~all77].copy()
print("\n== Analysis base ==")
print("Valid Q10 responders:", len(valid))
print("Status of valid responders:", valid['Status'].value_counts().to_dict())

# --- 3. Quoted tally -------------------------------------------------------
quoted = (valid[q10_cols] == "quoted").sum()
quoted = quoted.sort_values()
print("\n== 'quoted' (use) tally among %d valid responders ==" % len(valid))
for c in q10_cols:
    print(f"  {c.replace('Q10_ML_Documentation_',''):22s}: {quoted[c]:3d}  ({100*quoted[c]/len(valid):6.3f}%)")

named = [c for c in q10_cols if c not in
         ("Q10_ML_Documentation_Others", "Q10_ML_Documentation_Not_Documented")]
rank = quoted[named].sort_values()
print("\n== Least-used NAMED formats (Others / Not_Documented excluded) ==")
print(rank.head(4).to_string())

# --- 4. Bootstrap 95% CIs (computed here) ----------------------------------
rng = np.random.default_rng(42)
N_BOOT = 10000
n = len(valid)
idx = np.arange(n)
boot_ci = {}
for c in q10_cols:
    x = (valid[c].values == "quoted").astype(int)
    draws = np.empty(N_BOOT)
    for b in range(N_BOOT):
        s = rng.choice(idx, size=n, replace=True)
        draws[b] = 100 * x[s].mean()
    boot_ci[c.replace('Q10_ML_Documentation_','')] = np.percentile(draws, [2.5, 97.5])

print("\n== Computed-here point estimates + bootstrap 95% CI (10k, seed=42) ==")
for c in q10_cols:
    name = c.replace('Q10_ML_Documentation_','')
    if c in ("Q10_ML_Documentation_Others", "Q10_ML_Documentation_Not_Documented"):
        tag = "  (excluded from answer)"
    else:
        tag = ""
    lo, hi = boot_ci[name]
    print(f"  {name:22s}: {100*quoted[c]/n:6.3f}%  CI=[{lo:6.3f}, {hi:6.3f}]{tag}")

print("\n== FINAL ==")
print("The two least-used NAMED documentation formats:")
print("  1) ML Canvas     : quoted=15  -> ~7.73% computed here  (question anchor 10.13%)")
print("  2) BDD Scenarios : quoted=4   -> ~2.06% computed here  (question anchor 4.366%)")
print("Mapping by ordering (question 'respectively'): 10.13% -> ML Canvas, 4.366% -> BDD Scenarios.")
