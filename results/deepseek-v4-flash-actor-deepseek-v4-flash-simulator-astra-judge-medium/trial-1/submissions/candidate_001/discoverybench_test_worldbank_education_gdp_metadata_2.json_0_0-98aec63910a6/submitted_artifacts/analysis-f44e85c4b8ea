import numpy as np, pandas as pd, statsmodels.api as sm, warnings
warnings.filterwarnings('ignore')
pd.set_option('display.width',200)
wide = pd.read_csv('data/worldbank_education_gdp.csv')
year_cols=[c for c in wide.columns if '[YR' in c]
long=wide.melt(id_vars=['Country Group','Country Code','Series Name','Series Code'],var_name='yr',value_name='v')
long['year']=long['yr'].str.extract(r'(\d{4})').astype(int)
long['v']=pd.to_numeric(long['v'],errors='coerce')
p=long.pivot_table(index=['Country Code','year'],columns='Series Code',values='v').reset_index()
p.columns.name=None; p=p.sort_values(['Country Code','year']).reset_index(drop=True)
p['edu']=p['NY.ADJ.AEDU.GN.ZS']; p['expg']=p['NE.EXP.GNFS.KD.ZG']
p['lgni']=np.log(p['NY.GNP.PCAP.KD']); p['ggni']=p.groupby('Country Code')['lgni'].diff()*100
p['lf']=p['SL.TLF.CACT.ZS']; p['prm']=p['SE.PRM.ENRR']; p['sec']=p['SE.SEC.ENRR']
for v in ['edu','expg','ggni','lf','prm','sec']:
    p[f'{v}_l1']=p.groupby('Country Code')[v].shift(1); p[f'{v}_l2']=p.groupby('Country Code')[v].shift(2)
SSF,LMC='SSF','LMC'
GNAME={'SSF':'Sub-Saharan Africa (SSF)','LMC':'Lower middle income (LMC)'}

def ardl(df,y,xcols,maxlags=4):
    d=df[[y]+xcols].dropna()
    X=sm.add_constant(d[xcols]); return sm.OLS(d[y],X).fit(cov_type='HAC',cov_kwds={'maxlags':maxlags})

def long_run(res,rho_name,beta_names):
    b=res.params; V=res.cov_params(); s=sum(b[n] for n in beta_names); rho=b[rho_name]
    lr=s/(1-rho); g=np.zeros(len(b))
    for n in beta_names: g[list(b.index).index(n)]=1.0/(1-rho)
    g[list(b.index).index(rho_name)]=s/(1-rho)**2
    se=float(np.sqrt(g@V@g)); return lr,se,(lr-1.96*se,lr+1.96*se)

def numW(res,fn,names):
    b=res.params; V=res.cov_params(); f0=fn(b); eps=1e-6; bv=b.to_numpy(); g=np.zeros(len(b))
    for i in range(len(bv)):
        bp=b.copy(); bm=b.copy(); bp.iloc[i]=bv[i]+eps; bm.iloc[i]=bv[i]-eps
        g[i]=(fn(bp)-fn(bm))/(2*eps)
    se=float(np.sqrt(g@V@g)); z=f0/se
    from scipy.stats import norm
    return z,2*(1-norm.cdf(abs(z))),f0,se

def spec(group,out,window=None,controls=None):
    df=p[p['Country Code']==group].copy()
    if window: df=df[(df['year']>=window[0])&(df['year']<=window[1])]
    xc=[f'{out}_l1','edu','edu_l1']+(controls or [])
    res=ardl(df,out,xc); lr,se,ci=long_run(res,f'{out}_l1',[c for c in xc if c in('edu','edu_l1')])
    return dict(group=group,win=(df.year.min(),df.year.max()),n=len(df),res=res,lr=lr,lr_se=se,lr_ci=ci,
                rho=res.params[f'{out}_l1'],short=head(res))

def head(res): 
    return sum(res.params[c] for c in ['edu','edu_l1'] if c in res.params.index)

def prg(g):
    print(f"  {GNAME[g['group']]}  [window {g['win'][0]}-{g['win'][1]}, n={g['n']}]")
    for n in g['res'].params.index:
        print(f"      {n:10s} coef={g['res'].params[n]: .4f}  se={g['res'].bse[n]:.4f}  p={g['res'].pvalues[n]:.3f}")
    print(f"      LONG-RUN={g['lr']:.3f} (se {g['lr_se']:.3f}, CI [{g['lr_ci'][0]:.3f},{g['lr_ci'][1]:.3f}]) | "
          f"short={g['short']:.3f}, rho={g['rho']:.3f}")
    return g

print("="*90)
print("PRIMARY: exports annual growth (economic-output proxy), 1991-2015, ARDL(1,1), HAC")
print("="*90)
PG={}
for g in (SSF,LMC):
    PG[g]=spec(g,'expg',(1991,2015)); prg(PG[g])

# stacked interaction + Wald
stk=p[(p['year']>=1991)&(p['year']<=2015)].copy()
stk['dLMC']=(stk['Country Code']==LMC).astype(int)
stk['y']=stk['expg']; stk['y_l']=stk['expg_l1']
for c in ['y_l','edu','edu_l1']: stk['d_'+c]=stk['dLMC']*stk[c]
stk=stk.dropna(subset=['y','y_l','edu','edu_l1'])
Xc=sm.add_constant(stk[['y_l','d_y_l','edu','d_edu','edu_l1','d_edu_l1','dLMC']])
sr=sm.OLS(stk['y'],Xc).fit(cov_type='HAC',cov_kwds={'maxlags':4})
def lrfn(pp):
    rSA=pp['y_l']; rLM=pp['y_l']+pp['d_y_l']
    sSA=pp['edu']+pp['edu_l1']; sLM=pp['edu']+pp['d_edu']+pp['edu_l1']+pp['d_edu_l1']
    return sSA/(1-rSA), sLM/(1-rLM)
lSA,lLM=lrfn(sr.params); dfn=lambda pp: lrfn(pp)[1]-lrfn(pp)[0]
z,pw,dv,dse=numW(sr,dfn,list(sr.params.index))
print("\nSTACKED INTERACTION (1991-2015, HAC):")
for n in sr.params.index: print(f"  {n:10s} coef={sr.params[n]: .4f} se={sr.bse[n]:.4f} p={sr.pvalues[n]:.3f}")
print(f"  LR SSA={lSA:.3f} | LR LMC={lLM:.3f} | diff(LMC-SSA)={dv:.3f} (se {dse:.3f})")
print(f"  Wald H0 LR equal: z={z:.2f}, p={pw:.3f} -> significant: {pw<0.05}")

print("\n"+"="*90)
print("SPEC B: exports outcome + LF control, 1991-2015")
print("="*90)
for g in (SSF,LMC): prg(spec(g,'expg',(1991,2015),['lf_l1']))

print("\n"+"="*90)
print("SPEC C: lag-only exports ARDL (edu lags 1&2, no contemporaneous), 1991-2015")
print("="*90)
LG={}
for g in (SSF,LMC):
    df=p[(p['Country Code']==g)&(p['year']>=1991)&(p['year']<=2015)]
    res=ardl(df,'expg',['expg_l1','edu_l1','edu_l2'])
    lr,se,ci=long_run(res,'expg_l1',['edu_l1','edu_l2'])
    LG[g]=dict(group=g,win=(1991,2015),n=len(df),res=res,lr=lr,lr_se=se,lr_ci=ci,
               rho=res.params['expg_l1'],short=res.params['edu_l1']+res.params['edu_l2'])
    prg(LG[g])
# stacked lag-only
stk2=stk.copy(); stk2['d_edu_l2']=stk2['dLMC']*stk2['edu_l2']
stk2=stk2.dropna(subset=['y','y_l','edu_l1','edu_l2'])
Xc2=sm.add_constant(stk2[['y_l','d_y_l','edu_l1','d_edu_l1','edu_l2','d_edu_l2','dLMC']])
sr2=sm.OLS(stk2['y'],Xc2).fit(cov_type='HAC',cov_kwds={'maxlags':4})
def lrfn2(pp):
    rSA=pp['y_l']; rLM=pp['y_l']+pp['d_y_l']
    sSA=pp['edu_l1']+pp['edu_l2']; sLM=pp['edu_l1']+pp['d_edu_l1']+pp['edu_l2']+pp['d_edu_l2']
    return sSA/(1-rSA), sLM/(1-rLM)
a,b2=lrfn2(sr2.params); dfn2=lambda pp: lrfn2(pp)[1]-lrfn2(pp)[0]
z2,pw2,dv2,dse2=numW(sr2,dfn2,list(sr2.params.index))
print(f"  Lag-only LR SSA={a:.3f} LMC={b2:.3f} diff={dv2:.3f} (se {dse2:.3f}) Wald z={z2:.2f} p={pw2:.3f}")

print("\n"+"="*90)
print("DIRECT: GNI per-capita growth (100*log-diff GNI pc)")
print("="*90)
print("\n--- LMC full 1975-2015: ggni_t ~ ggni_{t-1}+edu_t+edu_{t-1} ---")
fl=spec(LMC,'ggni',(1975,2015)); prg(fl)
print("\n--- LMC matched 1991-2015: + exports lag control ---")
fm=spec(LMC,'ggni',(1991,2015),['expg_l1']); prg(fm)
print("\n--- SSA descriptive 2011-2015 (n=4 growth obs) ---")
sg=p[p['Country Code']==SSF].dropna(subset=['ggni'])
print(f"  n={len(sg)} years={sg.year.tolist()}")
print(f"  ggni mean={sg['ggni'].mean():.2f} sd={sg['ggni'].std():.2f} min={sg['ggni'].min():.2f} max={sg['ggni'].max():.2f}")
print(f"  corr(edu,ggni)={sg[['edu','ggni']].corr().iloc[0,1]:.3f} (n={len(sg)}) -> NO cross-group test possible here")
print(f"  mean edu 2011-15  SSA={p[(p['Country Code']==SSF)&(p['year']>=2011)]['edu'].mean():.3f}  LMC={p[(p['Country Code']==LMC)&(p['year']>=2011)]['edu'].mean():.3f}")

print("\n"+"="*90)
print("ROBUSTNESS: enrollment (primary, secondary) as intermediate outcome, full 1975-2015")
print("="*90)
for out in ('prm','sec'):
    for g in (SSF,LMC): prg(spec(g,out,(1975,2015)))

print("\n"+"="*90)
print("HEADLINE SUMMARY")
print("="*90)
def row(g): return f"{g['group']:3s} LR={g['lr']: .3f} se={g['lr_se']:.3f} CI=[{g['lr_ci'][0]: .3f},{g['lr_ci'][1]: .3f}] rho={g['rho']:.3f}"
print("\nPrimary exports-growth ARDL (1991-2015):")
print("  ",row(PG[SSF])); print("  ",row(PG[LMC]))
print("  Wald on LR difference: z={:.2f}, p={:.3f}".format(z,pw))
print("\nDirect GNI-growth LMC (full sample):",row(fl))
print("Sensitivity flags:")
flips=[]
if np.sign(PG[SSF]['lr'])!=np.sign(LG[SSF]['lr']): flips.append("SSA exports-effect sign flips primary vs lag-only")
if np.sign(PG[LMC]['lr'])!=np.sign(LG[LMC]['lr']): flips.append("LMC exports-effect sign flips primary vs lag-only")
