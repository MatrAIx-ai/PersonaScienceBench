#!/usr/bin/env python3
"""
NLS BMI / savings analysis: How does age influence the likelihood of withdrawing
more money from savings than putting in?  (DiscoveryBench episode)

Design notes (carried through from the approved plan):
  * Cross-sectional, between-person design: AGE is each respondent's age in 1989
    (24-32 only). "Influence" = adjusted conditional association, NOT causation.
  * AGE_2 = AGE^2 exactly (constructed quadratic to allow curvature).
  * DISSAVED and SAMESAVE are mutually exclusive categories; a residual "neither"
    category (= 0,0) means the respondent added to savings.
  * Dataset appears processed/synthetic -> inferential p-values indicative only;
    emphasis on estimated probabilities / effect sizes.
"""
import json
import numpy as np
import pandas as pd

import statsmodels.api as sm
import statsmodels.formula.api as smf
from scipy import stats

try:
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt
    HAVE_MPL = True
except Exception:
    HAVE_MPL = False

RNG = np.random.default_rng(0)
OUT = {}

# ------------------------------------------------------------------ load
df = pd.read_csv("data/nls_bmi_processed.csv")
OUT["dimensions"] = {"rows": len(df), "cols": df.shape[1],
                     "n_missing_total": int(df.isna().sum().sum())}

# build three-category outcome
def save_cat(r):
    if r["DISSAVED"] == 1:  return "dissaved"    # withdrew > put in
    if r["SAMESAVE"] == 1:  return "samesave"    # no change / none
    return "saved_more"                           # put in > withdrew (implied)
df["SAVCAT"] = df.apply(save_cat, axis=1)
OUT["savecat_counts"] = df["SAVCAT"].value_counts().to_dict()

# covariates, ready to model
df["INCOME_LOG"] = np.log1p(df["INCOME"])           # handles the 1% zeros
df["AGE_C"] = df["AGE"] - df["AGE"].mean()          # centered for stability
df["AGE_C2"] = df["AGE_C"] ** 2
df["FEMALE"] = (df["GENDER"] == "FEMALE").astype(int)
df["INCOME_Q"] = pd.qcut(df["INCOME"], 4, labels=["Q1", "Q2", "Q3", "Q4"])

# ------------------------------------------------------------------ helpers
def pred_margins(model_fit, data, age_grid, formula_covariates):
    """Predictive margins: for each age a, set everyone AGE=a (AGE_2=a^2),
    keep other covariates at their observed values, average the predictions."""
    rows = []
    for a in age_grid:
        Xd = data.copy()
        Xd["AGE"] = a
        Xd["AGE_2"] = a ** 2
        Xd["AGE_C"] = a - df["AGE"].mean()
        Xd["AGE_C2"] = Xd["AGE_C"] ** 2
        p = model_fit.predict(Xd)
        rows.append({"age": a, "p_dissaved": p.mean()})
    return pd.DataFrame(rows)

def ame_by_age(model_fit, data, age_grid):
    """Average marginal effect of AGE on P(DISSAVED) at each age (chain rule)."""
    rows = []
    b1 = model_fit.params.get("AGE", 0.0)
    b2 = model_fit.params.get("AGE_2", 0.0)
    for a in age_grid:
        Xd = data.copy()
        Xd["AGE"] = a
        Xd["AGE_2"] = a ** 2
        Xd["AGE_C"] = a - df["AGE"].mean()
        Xd["AGE_C2"] = Xd["AGE_C"] ** 2
        p = model_fit.predict(Xd)
        d = p * (1 - p) * (b1 + 2 * b2 * a)        # dP/d(a) chain rule
        rows.append({"age": a, "ame_dP_per_year": d.mean()})
    return pd.DataFrame(rows)

age_grid = np.arange(24, 33)

# ------------------------------------------------------------------ 1. PRIMARY LOGIT  AGE + AGE_2
# Spec A: log(income)
formulaA = ("DISSAVED ~ AGE + AGE_2 + INCOME_LOG + FEMALE + BLACK + "
            "HISPANIC + BMI")
modA = smf.logit(formulaA, data=df).fit(disp=0)
OUT["modelA_logit_logincome"] = {
    "params": modA.params.round(4).to_dict(),
    "pvalues": modA.pvalues.round(4).to_dict(),
    "conf_int": modA.conf_int().round(4).to_dict(),
    "aic": round(modA.aic, 2),
    "pseudo_r2": round(modA.prsquared, 4),
}

# Spec B: income quartile dummies
formulaB = ("DISSAVED ~ AGE + AGE_2 + C(INCOME_Q) + FEMALE + BLACK + "
            "HISPANIC + BMI")
modB = smf.logit(formulaB, data=df).fit(disp=0)
OUT["modelB_logit_incomeQUART"] = {
    "params": modB.params.round(4).to_dict(),
    "pvalues": modB.pvalues.round(4).to_dict(),
    "aic": round(modB.aic, 2),
}

# Predictive margins (age curve), both specs
margA = pred_margins(modA, df, age_grid, formulaA)
margB = pred_margins(modB, df, age_grid, formulaB)
curveA = margA.set_index("age")["p_dissaved"].round(4).to_dict()
curveB = margB.set_index("age")["p_dissaved"].round(4).to_dict()
OUT["margins_logincome"] = curveA
OUT["margins_incomeQUART"] = curveB

# average marginal effect at each age (spec A)
ameA = ame_by_age(modA, df, age_grid)
OUT["AME_per_year_by_age_logincome"] = ameA["ame_dP_per_year"].round(4).to_dict()
OUT["AME_avg_over_sample"] = round(float(ameA["ame_dP_per_year"].mean()), 4)

# ------------------------------------------------------------------ 2a. SENSITIVITY: linear only (no AGE_2)
formulaC = "DISSAVED ~ AGE + INCOME_LOG + FEMALE + BLACK + HISPANIC + BMI"
modC = smf.logit(formulaC, data=df).fit(disp=0)
formulaD = "DISSAVED ~ AGE + C(INCOME_Q) + FEMALE + BLACK + HISPANIC + BMI"
modD = smf.logit(formulaD, data=df).fit(disp=0)
OUT["modelC_linear_logincome"] = {
    "params": modC.params.round(4).to_dict(),
    "pvalues": modC.pvalues.round(4).to_dict(),
    "aic": round(modC.aic, 2),
    "OR_per_year": float(np.exp(modC.params["AGE"]).round(4)),
}
OUT["modelD_linear_incomeQUART"] = {
    "params": modD.params.round(4).to_dict(),
    "aic": round(modD.aic, 2),
    "OR_per_year": float(np.exp(modD.params["AGE"]).round(4)),
}

# likelihood-ratio test: does AGE_2 add anything?  (A vs C nested)
llfA = modA.llf; llfC = modC.llf
lr_stat = 2 * (llfA - llfC)
p_lr = stats.chi2.sf(lr_stat, df=1)
OUT["LR_test_AGE2"] = {"lr_stat": round(lr_stat, 3), "p": round(float(p_lr), 4),
                       "conclusion": ("AGE_2 significant (p<0.05)"
                                      if p_lr < 0.05
                                      else "AGE_2 NOT significant (p>=0.05)")}
# AIC comparison
OUT["AIC_comparison"] = {"A_log+quad": round(modA.aic,2),
                         "C_linear": round(modC.aic,2),
                         "B_quart+quad": round(modB.aic,2),
                         "D_quart_linear": round(modD.aic,2)}

# ------------------------------------------------------------------ 2b. SENSITIVITY: multinomial {dissaved, samesave, saved_more}
# Baseline = dissaved (the outcome of interest). We report the RR of each
# other category vs dissaved, and flip to report dissaved vs saved_more.
df_m = df[["SAVCAT", "AGE", "AGE_2", "INCOME_LOG", "FEMALE", "BLACK",
           "HISPANIC", "BMI"]].copy()
endog_m = pd.get_dummies(df_m["SAVCAT"], prefix="", prefix_sep="").astype(int)
base = "dissaved"
endog_m = endog_m[[base,
                   "samesave",
                   "saved_more"]]      # first column = baseline (dropped)
exog_m = sm.add_constant(df_m[["AGE", "AGE_2", "INCOME_LOG", "FEMALE",
                               "BLACK", "HISPANIC", "BMI"]])
mn = sm.MNLogit(endog_m, exog_m).fit(disp=0)
# map model outcome indices (0,1) to categories after the baseline
mapped = {i: c for i, c in enumerate(["samesave", "saved_more"])}
OUT["multinomial_base_category"] = base
OUT["multinomial"] = {}
for i, mcat in enumerate(mn.params.columns):
    cat = mapped[i]
    coefs = mn.params[mcat].round(4).to_dict()
    coef_age_vs_base = float(mn.params.loc["AGE", mcat])
    p_age_vs_base = float(mn.pvalues.loc["AGE", mcat])
    d = {"params_vs_dissaved": coefs,
         "pvals_vs_dissaved": mn.pvalues[mcat].round(3).to_dict(),
         "RR_per_year_vs_dissaved": float(np.exp(coef_age_vs_base).round(4)),
         "p_age_vs_dissaved": round(p_age_vs_base, 4)}
    if cat == "saved_more":
        # dissaved vs saved_more = inverse of saved_more vs dissaved
        d["RR_dissaved_vs_saved_more_per_year"] = float(np.exp(-coef_age_vs_base).round(4))
        d["p_age_dissaved_vs_saved_more"] = round(p_age_vs_base, 4)
    OUT["multinomial"][cat] = d


# ------------------------------------------------------------------ 3. DESCRIPTIVE table for narrative
raw_by_age = df.groupby("AGE").agg(n=("DISSAVED", "size"),
                                   raw_rate=("DISSAVED", "mean")).round(4)
adj = pd.Series(curveA, name="adj_rate_logincome")
desc = raw_by_age.join(adj)
OUT["descriptive_age_table"] = desc.reset_index().to_dict("records")

# ------------------------------------------------------------------ curve table / figure
curve_tbl = pd.DataFrame({"age": age_grid,
                          "raw_rate": [raw_by_age.loc[a, "raw_rate"] for a in age_grid],
                          "adjusted_logincome": [curveA[a] for a in age_grid],
                          "adjusted_incomeQUART": [curveB[a] for a in age_grid]})
curve_tbl.to_csv("analysis/age_curve_table.csv", index=False)

if HAVE_MPL:
    fig, ax = plt.subplots(figsize=(8, 5))
    ax.plot(age_grid, [raw_by_age.loc[a, "raw_rate"] for a in age_grid],
            "o-", label="Raw rate (observed)")
    ax.plot(age_grid, [curveA[a] for a in age_grid],
            "s--", label="Adjusted margins (log income, quad age)")
    ax.plot(age_grid, [curveB[a] for a in age_grid],
            "d-.", label="Adjusted margins (income quartiles, quad age)")
    ax.set_xlabel("Age (1989)")
    ax.set_ylabel("P(DISSAVED = 1)")
    ax.set_title("Likelihood of withdrawing more from savings than putting in, by age")
    ax.legend(); ax.grid(alpha=0.3)
    fig.tight_layout()
    fig.savefig("analysis/age_dissaving_curve.png", dpi=150)
    print("saved figure")
else:
    print("matplotlib unavailable; curve written to CSV only")




# difference 24 vs 32
OUT["diff_p_age24_vs_32"] = {
    "raw": round(float(raw_by_age.loc[24, "raw_rate"] - raw_by_age.loc[32, "raw_rate"]), 4),
    "adjusted_logincome": round(curveA[24] - curveA[32], 4),
}

with open("analysis/results_nls_bmi.json", "w") as f:
    json.dump(OUT, f, indent=2, default=str)

# ------------------------------------------------------------------ print report
print("\n================ REPORT ================")
print(json.dumps(OUT, indent=2, default=str))
