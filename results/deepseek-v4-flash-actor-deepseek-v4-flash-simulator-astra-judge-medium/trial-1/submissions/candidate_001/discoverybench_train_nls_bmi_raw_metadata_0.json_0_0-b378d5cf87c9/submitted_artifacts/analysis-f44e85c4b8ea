"""
NLSY79: Does increased time preference (impatience) lead to higher BMI?
Associational, temporally-ordered analysis.
  Outcome:  BMI(1992) primary; BMI(1989) and BMI change 1989->1992 robustness.
            BMI = weight(lb->kg) / height(in->m)^2, height 1985, winsorized 1/99.
  Proxies:  (1) PRIMARY 1989 savings direction (1=put more in [patient] .. 4=no savings [impatient])
            (2) 1990 family net wealth (low/negative = impatience)
            (3) ASVAB Arithmetic Reasoning 1981 (higher = more patient/able)
  All models: robust (HC1) SEs; unadjusted vs adjusted; complete-case with reported n.
"""
import pandas as pd, numpy as np, statsmodels.api as sm, json, warnings
warnings.filterwarnings('ignore')

df = pd.read_csv('data/nls_raw.csv')
def n0(s): return pd.to_numeric(df[s], errors='coerce')
def wins(x, lo=1, hi=99):
    l,u = np.nanpercentile(x,[lo,hi]); return x.clip(l,u)

H85 = n0('Height of respondent, 1985')          # inches
bmi89 = wins((n0('Weight of respondent, 1989')*0.453592)/(H85*0.0254)**2)
bmi92 = wins((n0('Weight of respondent, 1992')*0.453592)/(H85*0.0254)**2)
df['bmi89']=bmi89; df['bmi92']=bmi92; df['bmi_change']=wins(bmi92-bmi89)

df['sav_dir'] = n0('Was more money put into or taken out of R/spouse savings since last interview, 1989')
df['wealth90'] = wins(n0('Family net wealth, 1990'))
df['asv_ar'] = n0('ASVAB - Arithmetic Reasoning Z Score (rounded), 1981')
df['sent_bef80'] = n0('Ever been sentenced in any correctional institution before 1980')
df['conv_bef80'] = n0('Ever convicted of an illegal act in adult court before 1980')
df['age89']=n0('Age of respondent at interview date, 1989'); df['sex']=n0('Sex of respondent, 1979')
df['race']=n0('Racial/ethnic cohort, 1979'); df['momed']=n0("Highest grade completed by respondent's mother, 1979")
df['daded']=n0("Highest grade completed by respondent's father, 1979"); df['famsize']=n0('Family size, 1979')
df['hged']=n0('Highest grade completed, 1979'); df['inc79']=n0('Total net family income, previous calendar year, 1979')
df['inc85']=n0('Total net family income, previous calendar year, 1985')
df['sav_z']=(df['sav_dir']-df['sav_dir'].mean())/df['sav_dir'].std()
df['wealth90_z']=(df['wealth90']-df['wealth90'].mean())/df['wealth90'].std()
df['asv_z']=(df['asv_ar']-df['asv_ar'].mean())/df['asv_ar'].std()

CONF_CORE = ['age89','sex','race','momed','daded','famsize','hged','asv_z','inc79']
CONF_EXT  = CONF_CORE + ['inc85']
CONF_NOASV = ['age89','sex','race','momed','daded','famsize','hged','inc79']

rows=[]
def rec(label,y,proxy,confset,n,coef,se,p,beta_std=None):
    rows.append(dict(label=label,y=y,proxy=proxy,confset=confset,n=int(n),
        coef=float(coef),se=float(se),p=float(p),beta_std=beta_std))

print("="*104)
print("PRIMARY PROXY: 1989 savings direction -> BMI 1992   (1=put more in [patient] .. 4=no savings [impatient])")
print("="*104)
tmp = df.dropna(subset=['bmi92','sav_dir'])
print("Unadjusted BMI92 by category (n, mean, sd):"); print(tmp.groupby('sav_dir')['bmi92'].agg(['count','mean','std']).round(3))
m0 = sm.OLS(tmp['bmi92'], sm.add_constant(tmp['sav_dir'])).fit(cov_type='HC1')
print(f"[unadj trend] b={m0.params['sav_dir']:.3f}/step SE={m0.bse['sav_dir']:.3f} p={m0.pvalues['sav_dir']:.3g} n={int(m0.nobs)} std={m0.params['sav_dir']*tmp['sav_dir'].std()/tmp['bmi92'].std():.3f}")
rec('sav_trend_unadj','bmi92','sav_dir','none',m0.nobs,m0.params['sav_dir'],m0.bse['sav_dir'],m0.pvalues['sav_dir'],m0.params['sav_dir']*tmp['sav_dir'].std()/tmp['bmi92'].std())
for cset,cname in [(CONF_CORE,'core'),(CONF_EXT,'extended')]:
    d = df[['bmi92','sav_dir']+cset].dropna()
    X = sm.add_constant(d[cset+['sav_dir']]); m = sm.OLS(d['bmi92'],X).fit(cov_type='HC1')
    b,se,p = m.params['sav_dir'],m.bse['sav_dir'],m.pvalues['sav_dir']
    print(f"[adj {cname} trend] b={b:.3f}/step SE={se:.3f} p={p:.3g} n={int(m.nobs)} std={b*d['sav_dir'].std()/d['bmi92'].std():.3f}")
    rec(f'sav_trend_{cname}','bmi92','sav_dir',cname,m.nobs,b,se,p,b*d['sav_dir'].std()/d['bmi92'].std())
    dd=d.copy(); dd['sav_c']=dd['sav_dir'].astype(int)
    dums=pd.get_dummies(dd['sav_c'],prefix='sav',drop_first=True).astype(float)
    X=sm.add_constant(pd.concat([dd[cset].reset_index(drop=True), dums.reset_index(drop=True)],axis=1))
    md=sm.OLS(dd['bmi92'].reset_index(drop=True),X).fit(cov_type='HC1')
    for c in dums.columns:
        print(f"   [adj {cname} dummy] {c} vs 'put more in': {md.params[c]:+.3f} SE={md.bse[c]:.3f} p={md.pvalues[c]:.3g}")

print("="*104)
print("ROBUSTNESS A: 1990 family net wealth -> BMI 1992 (low/negative wealth = impatience)")
print("="*104)
for cset,cname in [(['wealth90_z'],'unadj'),(CONF_CORE,'core'),(CONF_EXT,'extended')]:
    keep=['bmi92','wealth90_z']+[x for x in cset if x!='wealth90_z']
    d=df[keep].dropna(); Xadd=[x for x in cset if x!='wealth90_z']
    X=sm.add_constant(d[Xadd+['wealth90_z']]); m=sm.OLS(d['bmi92'],X).fit(cov_type='HC1')
    b,se,p=m.params['wealth90_z'],m.bse['wealth90_z'],m.pvalues['wealth90_z']
    print(f"[wealth90 {cname}] b per 1-SD = {b:.3f} BMI SE={se:.3f} p={p:.3g} n={int(m.nobs)}")
    rec(f'wealth90_{cname}','bmi92','wealth90_z',cname,m.nobs,b,se,p,b)
d=df[['bmi92','wealth90']+CONF_CORE].dropna(); d['wq']=pd.qcut(d['wealth90'].rank(method='first'),5,labels=['Q1_low','Q2','Q3','Q4','Q5_high'])
print("Unadjusted BMI92 by wealth quintile:"); print(d.groupby('wq',observed=True)['bmi92'].agg(['count','mean']).round(2))
dums=pd.get_dummies(d['wq'],prefix='w',drop_first=True).astype(float)
X=sm.add_constant(pd.concat([d[CONF_CORE].reset_index(drop=True), dums.reset_index(drop=True)],axis=1))
m=sm.OLS(d['bmi92'].reset_index(drop=True),X).fit(cov_type='HC1')
print("[adj core quintiles vs Q1_low]:")
for c in dums.columns: print(f"   {c}: {m.params[c]:+.3f} SE={m.bse[c]:.3f} p={m.pvalues[c]:.3g}")

print("="*104)
print("ROBUSTNESS B: ASVAB Arithmetic Reasoning 1981 -> BMI 1992 (higher = more patient/able)")
print("="*104)
for cset,cname in [(['asv_z'],'unadj'),(CONF_NOASV,'core'),(CONF_NOASV+['inc85'],'extended')]:
    keep=['bmi92','asv_z']+[x for x in cset if x!='asv_z']
    d=df[keep].dropna(); Xadd=[x for x in cset if x!='asv_z']
    X=sm.add_constant(d[Xadd+['asv_z']]); m=sm.OLS(d['bmi92'],X).fit(cov_type='HC1')
    b,se,p=m.params['asv_z'],m.bse['asv_z'],m.pvalues['asv_z']
    print(f"[asv {cname}] b per 1-SD = {b:+.3f} BMI SE={se:.3f} p={p:.3g} n={int(m.nobs)}")
    rec(f'asv_{cname}','bmi92','asv_z',cname,m.nobs,b,se,p,b)
d=df[['bmi92','asv_ar']+CONF_NOASV].dropna(); d['at']=pd.qcut(d['asv_ar'].rank(method='first'),3,labels=['low','mid','high'])
print("Unadjusted BMI92 by ASVAB tercile:"); print(d.groupby('at',observed=True)['bmi92'].agg(['count','mean']).round(2))
dums=pd.get_dummies(d['at'],prefix='a').astype(float)[['a_low','a_mid']]
X=sm.add_constant(pd.concat([d[CONF_NOASV].reset_index(drop=True), dums.reset_index(drop=True)],axis=1))
m=sm.OLS(d['bmi92'].reset_index(drop=True),X).fit(cov_type='HC1')
print("[adj core terciles vs high]: low", round(m.params['a_low'],3), "mid", round(m.params['a_mid'],3))

print("="*104)
print("ROBUSTNESS OUTCOMES: savings direction -> BMI1989 & BMI change 1989->1992 (adj core)")
print("="*104)
for y,yname in [('bmi89','BMI1989'),('bmi_change','BMI change 1989->1992')]:
    d=df[[y,'sav_dir']+CONF_CORE].dropna()
    X=sm.add_constant(d[CONF_CORE+['sav_dir']]); m=sm.OLS(d[y],X).fit(cov_type='HC1')
    b,se,p=m.params['sav_dir'],m.bse['sav_dir'],m.pvalues['sav_dir']
    print(f"[{yname}] b={b:+.3f}/step SE={se:.3f} p={p:.3g} n={int(m.nobs)} std={b*d['sav_dir'].std()/d[y].std():.3f}")
    rec(f'sav_{yname}','sav_dir_proxy','sav_dir','core',m.nobs,b,se,p,b*d['sav_dir'].std()/d[y].std())

print("="*104)
print("EXPLORATORY: criminal proxies (thin coverage)")
print("="*104)
for prox,pname in [('sent_bef80','sentenced pre-1980'),('conv_bef80','convicted pre-1980')]:
    d=df[['bmi92',prox]+CONF_CORE].dropna()
    print(f"{pname}: n={len(d)}; mean BMI by group:"); print(d.groupby(prox)['bmi92'].agg(['count','mean']).round(2))
    if len(d)>500:
        X=sm.add_constant(d[CONF_CORE+[prox]]); m=sm.OLS(d['bmi92'],X).fit(cov_type='HC1')
        print(f"   [adj core] {m.params[prox]:+.3f} SE={m.bse[prox]:.3f} p={m.pvalues[prox]:.3g}")

pd.DataFrame(rows).to_csv('/workspace/model_summary.csv', index=False)
print("\nDONE. rows saved to /workspace/model_summary.csv ; n rows =", len(rows))
