{
  "task": "B3 scRNA-seq: clusters + pseudotime + marker ranking + TF GRN",
  "normalization": {
    "method": "library-size normalization + log1p",
    "detail": "counts / lib_size * median_library_size, then log1p",
    "justification": "removes sequencing-depth differences; log1p stabilizes variance",
    "scale": 2447.5
  },
  "hvg": {
    "method": "top-150 by binned normalized dispersion (var z-score within mean-exp bins of log data)",
    "n_hvg": 150,
    "n_bins": 20,
    "justification": "keeps most variable genes, avoids mean-variance bias"
  },
  "pca": {
    "method": "SVD (numpy.linalg.svd) on z-scored HVG log matrix",
    "n_pcs": 15,
    "justification": "linear dimensionality reduction for embedding/kNN"
  },
  "clustering": {
    "method": "k-means (k-means++ init, seed 0, 10 restarts) primary; spectral (kNN/normalized Laplacian) as fallback & ARI check",
    "n_clusters": 4,
    "n_clusters_source": "system_info.json (metadata fact)",
    "used": "k-means",
    "cluster_sizes": [
      121,
      291,
      298,
      90
    ],
    "ari_kmeans_vs_spectral": 0.7912285314999695,
    "mean_silhouette_pca": 0.13958112419971078,
    "justification": "metadata specifies n_clusters=4; k-means robust on synthetic separated data"
  },
  "pseudotime": {
    "method": "Dijkstra shortest-path on kNN graph (k=20, weight=euclidean in PCA) from root, normalized to [0,1]",
    "root": 552,
    "root_choice": "cell with max Euclidean distance to PCA centroid (A2 assumption, no annotation)",
    "knn_k": 20,
    "graph_components": 1,
    "range": [
      0.0,
      1.0
    ]
  },
  "de_genes": {
    "method": "rank ALL 250 genes by max over clusters of -log10(Wilcoxon rank-sum p, cluster vs rest) on log-normalized data; tie-break |logFC|",
    "threshold": "none (full ranked list per contract)",
    "n_genes_output": 250
  },
  "grn": {
    "method": "directed OLS: each TF target regressed on the other 19 TFs (z-scored -> standardized coefficients)",
    "convention": "grn_scores[i,j] = edge i -> j (i regulator, j target), diagonal = 0",
    "sign": "positive = activation, negative = repression",
    "direction": "statistical (not causal) inference",
    "shape": [
      20,
      20
    ],
    "nz_fraction": 0.95,
    "abs_range": [
      0.0,
      0.2098881909394161
    ]
  },
  "assumptions": {
    "A1": "no ground-truth annotation; clusters validated only internally (silhouette, ARI)",
    "A2": "pseudotime root = PCA-extremal cell (max distance to centroid); pseudotime is ordinal",
    "A3": "DE metric = Wilcoxon rank-sum + logFC, cluster-vs-rest, score = max -log10(p)",
    "A4": "GRN = standardized OLS coefficients; direction is statistical not causal",
    "A5": "hyperparameters: N_HVG=150, N_PCS=15, KNN_K=20 (fixed, stability checked)",
    "A6": "n_clusters=4 taken from system_info.json (metadata fact)",
    "A7": "np.random.seed(0); fixed k-means++ init and restarts"
  },
  "reproducibility": {
    "seed": 0,
    "numpy": "2.4.4",
    "scipy": "1.16.0"
  }
}