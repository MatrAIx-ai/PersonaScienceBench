def _put(canvas, x, y, c):
    H, W, _ = canvas.shape
    if 0 <= x < W and 0 <= y < H:
        canvas[y, x] = c

def _line(canvas, x0, y0, x1, y1, c):
    x0, x1, y0, y1 = int(round(x0)), int(round(x1)), int(round(y0)), int(round(y1))
    dx, dy = abs(x1-x0), -abs(y1-y0)
    sx = 1 if x0 < x1 else -1; sy = 1 if y0 < y1 else -1
    err = dx + dy
    while True:
        _put(canvas, x0, y0, c)
        if x0 == x1 and y0 == y1:
            break
        e2 = 2*err
        if e2 >= dy: err += dy; x0 += sx
        if e2 <= dx: err += dx; y0 += sy

def _rect(canvas, x0, y0, x1, y1, c):
    for y in range(y0, y1+1):
        for x in range(x0, x1+1):
            _put(canvas, x, y, c)

def _text(canvas, x, y, s, c, scale=1, spacing=1):
    cx = int(x)
    for ch in s.upper():
        if ch == ' ':
            cx += scale*5 + spacing; continue
        g = _G.get(ch, _G[' '])
        for row in range(7):
            for col in range(5):
                if g[row][col] == '1':
                    for sy_ in range(scale):
                        for sx_ in range(scale):
                            _put(canvas, cx+col*scale+sx_, y+row*scale+sy_, c)
        cx += scale*5 + spacing

def _vm(v, vmin, vmax, ya, yb):
    span = (vmax - vmin) if vmax > vmin else 1e-9
    return yb - (v - vmin)/span*(yb - ya)

def _lerp(a, b, t):
    return tuple(int(round(a[i] + (b[i]-a[i])*t)) for i in range(3))

def _panel_plot_box(box):
    x0, y0, x1, y1 = box
    return (x0+52, y0+58, x1-12, y1-26)

def _frame(canvas, box, title):
    x0, y0, x1, y1 = box
    _rect(canvas, x0, y0, x1, y1, (255, 255, 255))
    _line(canvas, x0, y0, x1, y0, (40, 40, 40))
    _line(canvas, x0, y1, x1, y1, (40, 40, 40))
    _line(canvas, x0, y0, x0, y1, (40, 40, 40))
    _line(canvas, x1, y0, x1, y1, (40, 40, 40))
    tw = len(title)*6
    _text(canvas, (x0+x1)//2 - tw//2, y0+6, title, (0, 0, 0))

def _yticks(canvas, px0, py0, px1, py1, vmin, vmax, n=5, fmt="%.2f"):
    for i in range(n):
        v = vmin + (vmax-vmin)*i/(n-1)
        gy = py1 - (v-vmin)/(vmax-vmin)*(py1-py0)
        _line(canvas, px0, gy, px1, gy, (215, 215, 215))
        lab = fmt % v
        _text(canvas, px0-46, int(gy)-3, lab, (60, 60, 60))

def _bars(canvas, box, title, values, vmin, vmax, xlabels, zero=True, colors=None):
    _frame(canvas, box, title)
    px0, py0, px1, py1 = _panel_plot_box(box)
    _yticks(canvas, px0, py0, px1, py1, vmin, vmax)
    n = len(values)
    span = (px1-px0)
    step = span / max(n, 1)
    bw = step*0.42
    for i, v in enumerate(values):
        cx = px0 + step*(i+0.5)
        yv = _vm(v, vmin, vmax, py0, py1)
        col = colors[i] if colors else (80, 120, 220)
        _rect(canvas, int(cx-bw), int(yv), int(cx+bw), int(py1-1), col)
        _text(canvas, int(cx - len(xlabels[i])*6/2), py1+6, xlabels[i], (0, 0, 0))
    if zero:
        yz = _vm(0.0, vmin, vmax, py0, py1)
        _line(canvas, px0, yz, px1, yz, (0, 0, 0))

def _lines(canvas, box, title, series, vmin, vmax, xlabels, colors, dref=None):
    _frame(canvas, box, title)
    px0, py0, px1, py1 = _panel_plot_box(box)
    _yticks(canvas, px0, py0, px1, py1, vmin, vmax)
    npts = len(series[0])
    step = (px1-px0)/max(npts-1, 1)
    xs = [px0 + step*i for i in range(npts)]
    if dref is not None:
        yr = _vm(dref, vmin, vmax, py0, py1)
        for x in xs[:-1]:
            _line(canvas, x, yr, x+6, yr, (200, 20, 20))
            _line(canvas, x+8, yr, x+14, yr, (200, 20, 20))
    for s, c in zip(series, colors):
        pts = [(_vm(s[i], vmin, vmax, py0, py1)) for i in range(npts)]
        for i in range(npts-1):
            _line(canvas, xs[i], pts[i], xs[i+1], pts[i+1], c)
        for i in range(npts):
            _rect(canvas, int(xs[i])-2, int(pts[i])-2, int(xs[i])+2, int(pts[i])+2, c)
    for i, lab in enumerate(xlabels):
        _text(canvas, int(xs[i]-12), py1+6, lab, (0, 0, 0))

def _write_png(path, rgb):
    h, w, _ = rgb.shape
    raw = b''.join(b'\x00' + rgb[y].tobytes() for y in range(h))
    def chunk(tag, data):
        c = tag + data
        return struct.pack('>I', len(data)) + c + struct.pack('>I', zlib.crc32(c) & 0xffffffff)
    sig = b'\x89PNG\r\n\x1a\n'
    ihdr = struct.pack('>IIBBBBB', w, h, 8, 2, 0, 0, 0)
    idat = zlib.compress(raw)
    with open(path, 'wb') as f:
        f.write(sig + chunk(b'IHDR', ihdr) + chunk(b'IDAT', idat) + chunk(b'IEND', b''))

