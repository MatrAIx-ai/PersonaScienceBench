#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
Deterministic transition-kernel forensic audit for the anonymous HMC Neal-funnel instance.

Pipeline
--------
1. Build target mechanics (sampler chart -> centered funnel coordinates, U, grad U, K, H)
   with the PUBLIC formulas from the manifest / brief.
2. Kernel audit: for every public candidate compute the contract metrics
   (energy_rmse, energy_slope, reverse_p95, volume_logdet_abs, acceptance_rate,
   panel_mean_v/var_v, panel_ess_v, panel_rhat_v, validity_score).
3. Identify the selected valid kernel:
     * primary signal: fit the leapfrog / velocity-Verlet template (L = integration_steps,
       epsilon = ladder step, kinetic 0.5 p^T G p, force = -dU/dq in SAMPLER q through the
       full chart) against the observed forward proposal arrays and keep the candidate with
       the smallest robust (median-abs) residual;
     * confirm with the contract validity_score (must be the maximum).
   This yields candidate kernel_05 == leapfrog, so the replay uses the leapfrog template
   with the schedule's step_size / integration_steps (production) and the holdout values.
   NOTE: the candidate forward/reverse arrays are observational and contain small
   deterministic perturbations; the replay therefore uses the inferred template, not the
   raw arrays.
4. Failure-mode labels: deterministic, metric-based priority assignment (documented below).
5. Deterministic replay of the production and hold-out streams using the *supplied*
   transition_momenta / transition_uniforms (no independent redraws).
6. Centered-coordinate samples, funnel profile, diagnostics, figure.

Every data/figure artifact is written under results/.
"""

import json
import os
import numpy as np

OUT = "results"
os.makedirs(OUT, exist_ok=True)

# ----------------------------------------------------------------------------
# Inputs
# ----------------------------------------------------------------------------
manifest = json.load(open("data/target_manifest.json"))
schedule = json.load(open("data/transition_schedule.json"))

DIM = manifest["dimension"]
SIG_V = float(manifest["sigma_v"])
CHART = manifest["sampler_chart"]
MATRIX = np.asarray(CHART["matrix"], dtype=float)          # M (12 x 12)
SHIFT = np.asarray(CHART["shift"], dtype=float)            # (12,)
WARP = float(CHART["warp_strength"])
PHASE = np.asarray(CHART["warp_phase"], dtype=float)       # (11,)
G = np.asarray(manifest["kinetic_metric"]["inverse_mass_matrix"], dtype=float)  # (12,12)

N_CHAINS = schedule["n_chains"]
WARMUP = schedule["warmup_transitions"]
KEPT = schedule["kept_transitions"]
TOTAL = schedule["total_transitions"]
STEP_SIZE = schedule["step_size"]
INT_STEPS = schedule["integration_steps"]
AUDIT_TRANS = schedule["audit_transitions"]

HO_CHAINS = schedule["holdout_chains"]
HO_TRANS = schedule["holdout_transitions"]
HO_STEP = schedule["holdout_step_size"]
HO_INT_STEPS = schedule["holdout_integration_steps"]
HO_AUDIT = schedule["holdout_audit_transitions"]

bundle = np.load("data/candidate_transition_bundle.npz")
panel = np.load("data/candidate_chain_panel.npz")
PROFILE_BINS = np.loadtxt("data/profile_bins.csv", delimiter=",", skiprows=1)

# ----------------------------------------------------------------------------
# Target mechanics (public formulas, sampler <-> centered funnel chart)
# ----------------------------------------------------------------------------
def chart_u(q):
    """u = (q - shift) @ matrix.T"""
    return (q - SHIFT) @ MATRIX.T


def centered_from_u(u):
    """centered[0] = u[0]; centered[j] = u[j] + warp*sin(u[0] + warp_phase[j-1])"""
    u0 = u[..., 0]
    c = np.empty_like(u)
    c[..., 0] = u0
    if DIM > 1:
        c[..., 1:] = u[..., 1:] + WARP * np.sin(u0[..., None] + PHASE[None, :])
    return c


def U_centered(c):
    """funnel potential in centered coordinates: v=centered[0], x_i=centered[i]"""
    v = c[..., 0]
    x = c[..., 1:]
    return (0.5 * (v / SIG_V) ** 2 + 0.5 * (DIM - 1) * v
            + 0.5 * np.exp(-v) * np.sum(x * x, axis=-1))


def U(q):
    """potential of a sampler-coordinate state q (full chart transform)"""
    return U_centered(centered_from_u(chart_u(q)))


def gradU_centered(c):
    v = c[..., 0]
    x = c[..., 1:]
    g = np.empty_like(c)
    g[..., 0] = v / SIG_V**2 + 0.5 * (DIM - 1) - 0.5 * np.exp(-v) * np.sum(x * x, axis=-1)
    g[..., 1:] = np.exp(-v)[..., None] * x
    return g


def gradU(q):
    """grad U in sampler coordinates (public formula: grad_u -> grad_U(q)=grad_u @ matrix)"""
    u = chart_u(q)
    c = centered_from_u(u)
    gc = gradU_centered(c)
    gu = np.empty_like(gc)
    gu[..., 0] = gc[..., 0] + WARP * np.sum(
        gc[..., 1:] * np.cos(u[..., 0:1] + PHASE[None, :]), axis=-1)
    gu[..., 1:] = gc[..., 1:]
    return gu @ MATRIX


def kinetic(p):
    """K(p) = 0.5 p^T G p"""
    return 0.5 * np.einsum("...i,...ij,...j->...", p, G, p)


def hamiltonian(q, p):
    return U(q) + kinetic(p)


def leapfrog(q, p, eps, L):
    """velocity-Verlet / leapfrog map T(q,p) = (q', p') (reversible, volume-preserving)."""
    q = np.array(q, dtype=float)
    p = np.array(p, dtype=float)
    for _ in range(L):
        p = p - 0.5 * eps * gradU(q)
        q = q + eps * (p @ G)
        p = p - 0.5 * eps * gradU(q)
    return q, p


def forward_euler(q, p, eps, L):
    """first-order (non time-reversible) Euler map, used only for kernel identification."""
    q = np.array(q, dtype=float)
    p = np.array(p, dtype=float)
    for _ in range(L):
        q = q + eps * (p @ G)
        p = p - eps * gradU(q)
    return q, p

# ----------------------------------------------------------------------------
# 3. Kernel audit
# ----------------------------------------------------------------------------
cand_ids = list(bundle["candidate_ids"])
ladder = bundle["step_size_ladder"]                       # (4,)
base_idx = int(np.argmin(np.abs(ladder - STEP_SIZE)))     # = 2 (exact match to 0.0732)

probe_states = bundle["probe_states"]                     # (72, 12) sampler q
probe_mom = bundle["probe_momenta"]                       # (72, 12)
prop_states = bundle["proposal_states"]                   # (6,4,72,12)
prop_mom = bundle["proposal_momenta"]
rev_states = bundle["reverse_states"]
rev_mom = bundle["reverse_momenta"]
vol_in = bundle["volume_input"]                           # (64, 24)
vol_out = bundle["volume_output"]                         # (6,64,24)

panel_samples = panel["panel_centered_samples"]           # (6,3,220,12) centered
panel_dh = panel["panel_delta_h"]                         # (6,3,260)
panel_acc = panel["panel_accepted"]                       # (6,3,260)


def linear(error, full, zero):
    """linear(error, full, zero) = 1 if error<=full, 0 if error>=zero, else linear."""
    error = float(error)
    if error <= full:
        return 1.0
    if error >= zero:
        return 0.0
    return (zero - error) / (zero - full)


def ips_ess(x):
    """Geyer initial-positive-sequence ESS for a 1-d chain."""
    x = np.asarray(x, dtype=float)
    n = x.size
    if n < 3:
        return float(n)
    xc = x - x.mean()
    acf = np.correlate(xc, xc, "full")[n - 1:] / n
    rho = acf / acf[0]
    tau = 1.0
    prev = 1.0
    for k in range(1, len(rho)):
        cur = min(rho[k], prev)
        if cur <= 0:
            break
        tau += 2.0 * cur
        prev = cur
    return max(1.0, n / tau)


def split_rhat(x):
    """split-Rhat for a 2-d array x of shape (chains, n): split each chain in half."""
    x = np.asarray(x, dtype=float)
    n = x.shape[1]
    if n < 2:
        return float("nan")
    half = n // 2
    segs = np.concatenate([x[:, :half], x[:, half:]], axis=0)   # (2*C, half)
    M = segs.shape[0]
    ns = segs.shape[1]
    means = segs.mean(axis=1)
    grand = means.mean()
    B = ns / (M - 1) * np.sum((means - grand) ** 2)
    W = segs.var(axis=1, ddof=1).mean()
    var_hat = (ns - 1) / ns * W + B / ns
    return float(np.sqrt(var_hat / W))


audit_rows = []
validity = {}
for i, cid in enumerate(cand_ids):
    # --- energy_rmse at base ladder step + energy_slope over the ladder
    rmse_by_ladder = []
    for li in range(4):
        dH = (hamiltonian(prop_states[i, li], prop_mom[i, li])
              - hamiltonian(probe_states, probe_mom))
        rmse_by_ladder.append(float(np.sqrt(np.mean(dH ** 2))))
    energy_rmse = rmse_by_ladder[base_idx]
    energy_slope = float(np.polyfit(np.log(ladder), np.log(rmse_by_ladder), 1)[0])

    # --- reverse_p95 at base ladder
    d_rev = (np.linalg.norm(rev_states[i, base_idx] - probe_states, axis=-1)
             + np.linalg.norm(rev_mom[i, base_idx] + probe_mom, axis=-1))
    reverse_p95 = float(np.percentile(d_rev, 95))

    # --- volume_logdet_abs via local affine least squares (with intercept)
    Xa = np.hstack([vol_in, np.ones((vol_in.shape[0], 1))])
    coef, _, _, _ = np.linalg.lstsq(Xa, vol_out[i], rcond=None)
    A_local = coef[:24]                                  # 24x24 linear part
    sign, logdet = np.linalg.slogdet(A_local)
    volume_logdet_abs = float(abs(logdet)) if sign != 0 else float("inf")

    # --- panel statistics
    acceptance_rate = float(panel_acc[i].mean())
    v_panel = panel_samples[i][..., 0].reshape(panel_samples.shape[1], -1)
    panel_mean_v = float(v_panel.mean())
    panel_var_v = float(v_panel.var(ddof=1))
    panel_rhat_v = split_rhat(v_panel)
    per_chain_ess = [ips_ess(panel_samples[i][c, :, 0]) for c in range(panel_samples.shape[1])]
    panel_ess_v = float(np.sum(per_chain_ess))

    # --- contract validity score
    var_rel = abs(panel_var_v - SIG_V**2) / SIG_V**2
    acc_dev = abs(0.82 - acceptance_rate)
    score = (0.24 * linear(energy_rmse, 0.01, 0.18)
             + 0.24 * linear(reverse_p95, 1e-8, 5e-3)
             + 0.20 * linear(volume_logdet_abs, 1e-5, 0.08)
             + 0.16 * linear(var_rel, 0.08, 0.55)
             + 0.16 * linear(acc_dev, 0.25, 0.80))
    validity[cid] = score
    audit_rows.append(dict(candidate_id=cid, energy_rmse=energy_rmse,
                           energy_slope=energy_slope, reverse_p95=reverse_p95,
                           volume_logdet_abs=volume_logdet_abs,
                           acceptance_rate=acceptance_rate,
                           panel_mean_v=panel_mean_v, panel_var_v=panel_var_v,
                           panel_ess_v=panel_ess_v, panel_rhat_v=panel_rhat_v,
                           validity_score=score))

cols = ["candidate_id", "energy_rmse", "energy_slope", "reverse_p95",
        "volume_logdet_abs", "acceptance_rate", "panel_mean_v", "panel_var_v",
        "panel_ess_v", "panel_rhat_v", "validity_score"]
with open(os.path.join(OUT, "kernel_audit.csv"), "w") as f:
    f.write(",".join(cols) + "\n")
    for row in audit_rows:
        f.write(",".join(str(row[c]) for c in cols) + "\n")

# ----------------------------------------------------------------------------
# Selected kernel: infer the anonymous reversible volume-preserving map
# ----------------------------------------------------------------------------
# Primary identification: leapfrog/velocity-Verlet template with L = integration_steps.
# The frame of the probe arrays is sampler q (their H values through the full chart are
# meaningful and the template reproduces candidate kernel_05 essentially exactly).
templ_resid = []
for i, cid in enumerate(cand_ids):
    res = []
    for li in range(4):
        qq, pp = leapfrog(probe_states, probe_mom, ladder[li], INT_STEPS)
        res.append(float(np.median(np.abs(qq - prop_states[i, li]))
                         + np.median(np.abs(pp - prop_mom[i, li]))))
    templ_resid.append(np.mean(res))
selected_by_template = cand_ids[int(np.argmin(templ_resid))]

# corroborating identification: forward Euler template (first-order, non-reversible)
euler_resid = []
for i, cid in enumerate(cand_ids):
    res = []
    for li in range(4):
        qq, pp = forward_euler(probe_states, probe_mom, ladder[li], INT_STEPS)
        res.append(float(np.median(np.abs(qq - prop_states[i, li]))
                         + np.median(np.abs(pp - prop_mom[i, li]))))
    euler_resid.append(np.mean(res))

selected_by_score = max(cand_ids, key=lambda c: validity[c])
assert selected_by_template == selected_by_score, \
    "template identification and validity-score selection disagree"
selected = selected_by_template
print("leapfrog template residual per candidate :", np.round(templ_resid, 6))
print("forward-Euler template residual per candid:", np.round(euler_resid, 6))
print("validity scores                          :", {c: round(validity[c], 4) for c in cand_ids})
print("selected valid candidate                 :", selected)

kernel_meta = {
    "selected_candidate_id": selected,
    "transition_family": "leapfrog_velocity_verlet",
    "reversible": True,
    "volume_preserving": True,
    "coordinate_frame": "sampler_q",
    "production_step_size": STEP_SIZE,
    "production_integration_steps": INT_STEPS,
    "holdout_step_size": HO_STEP,
    "holdout_integration_steps": HO_INT_STEPS,
    "kinetic": "0.5 p^T G p (G = inverse_mass_matrix)",
    "selection_rule": ("minimum robust (median-abs) forward-template residual across the "
                       "step-size ladder among leapfrog templates, confirmed by maximum "
                       "contract validity_score"),
    "leapfrog_template_residuals": dict(zip(cand_ids, np.round(templ_resid, 8).tolist())),
}
json.dump(kernel_meta, open(os.path.join(OUT, "selected_kernel.json"), "w"), indent=2)

# ----------------------------------------------------------------------------
# Failure modes: deterministic metric-priority assignment
# ----------------------------------------------------------------------------
# Rule (documented): exactly one candidate is valid (selected above). The remaining
# candidates receive the five canonical failure labels by dominant anomaly, in a fixed
# deterministic priority order of the contract metrics:
#   1) energy_drift        <- largest energy_rmse (runaway/divergent Hamiltonian)
#   2) volume_loss         <- largest |volume_logdet_abs| (non volume-preserving map)
#   3) terminal_imbalance  <- largest reverse_p95 (time-reversal / terminal symmetry broken)
#   4) coordinate_mismatch <- largest panel-var deviation |var_v - sigma_v^2|/sigma_v^2
#   5) delayed_response    <- remaining candidate
labels = {c: None for c in cand_ids}
labels[selected] = "valid_transition"
pool = [c for c in cand_ids if c != selected]
m = {r["candidate_id"]: r for r in audit_rows}

lab_energy = max(pool, key=lambda c: m[c]["energy_rmse"])
labels[lab_energy] = "energy_drift"; pool.remove(lab_energy)
lab_volume = max(pool, key=lambda c: abs(m[c]["volume_logdet_abs"]))
labels[lab_volume] = "volume_loss"; pool.remove(lab_volume)
lab_term = max(pool, key=lambda c: m[c]["reverse_p95"])
labels[lab_term] = "terminal_imbalance"; pool.remove(lab_term)
lab_coord = max(pool, key=lambda c: abs(m[c]["panel_var_v"] - SIG_V**2) / SIG_V**2)
labels[lab_coord] = "coordinate_mismatch"; pool.remove(lab_coord)
labels[pool[0]] = "delayed_response"
label_set = set(labels.values())
assert len(label_set) == 6 and "valid_transition" in label_set
json.dump(labels, open(os.path.join(OUT, "failure_modes.json"), "w"), indent=2)
print("failure modes:", labels)

# ----------------------------------------------------------------------------
# Deterministic replay (uses the *supplied* momenta and uniform draws only)
# ----------------------------------------------------------------------------
init_states = np.load("data/initial_latent_states.npy")          # (4,12)
momenta = np.load("data/transition_momenta.npy")                 # (4,1020,12)
uniforms = np.load("data/transition_uniforms.npy")               # (4,1020)


def replay_stream(init, moms, unifs, eps, L):
    """Return accepted_latent/proposal_latent arrays over the whole stream and terminal q."""
    n_ch, n_tr, _ = moms.shape
    acc_lat = np.empty((n_ch, n_tr, DIM))
    prop_lat = np.empty((n_ch, n_tr, DIM))
    delta_h = np.empty((n_ch, n_tr))
    accept_prob = np.empty((n_ch, n_tr))
    accepted = np.empty((n_ch, n_tr), dtype=bool)
    q = np.array(init, dtype=float)
    for t in range(n_tr):
        p = moms[:, t, :]
        qp, pp = leapfrog(q, p, eps, L)
        dh = hamiltonian(qp, pp) - hamiltonian(q, p)
        ap = np.minimum(1.0, np.exp(-dh))
        acc = unifs[:, t] < ap
        prop_lat[:, t, :] = qp
        delta_h[:, t] = dh
        accept_prob[:, t] = ap
        accepted[:, t] = acc
        newq = np.where(acc[:, None], qp, q)
        acc_lat[:, t, :] = newq
        q = newq
    return acc_lat, prop_lat, delta_h, accept_prob, accepted, q


acc_lat, prop_lat, delta_h, accept_prob, accepted, _ = \
    replay_stream(init_states, momenta, uniforms, STEP_SIZE, INT_STEPS)

# latent_samples = accepted sampler-coordinate states after the kept window
latent_samples = acc_lat[:, WARMUP:TOTAL, :]          # (4,900,12)
# transition audit = first audit_transitions of the stream
np.savez_compressed(
    os.path.join(OUT, "transition_audit.npz"),
    accepted_latent=acc_lat[:, :AUDIT_TRANS, :],
    proposal_latent=prop_lat[:, :AUDIT_TRANS, :],
    delta_h=delta_h[:, :AUDIT_TRANS],
    accept_prob=accept_prob[:, :AUDIT_TRANS],
    accepted=accepted[:, :AUDIT_TRANS],
)
np.save(os.path.join(OUT, "latent_samples.npy"), latent_samples)
print("latent_samples shape:", latent_samples.shape,
      "acceptance (kept):", float(accepted[:, WARMUP:TOTAL].mean()))

# --- holdout replay ---
ho_init = np.load("data/holdout_initial_latent_states.npy")     # (3,12)
ho_moms = np.load("data/holdout_transition_momenta.npy")        # (3,160,12)
ho_unifs = np.load("data/holdout_transition_uniforms.npy")      # (3,160)
ho_acc, ho_prop, ho_dh, ho_ap, ho_ac, ho_term = \
    replay_stream(ho_init, ho_moms, ho_unifs, HO_STEP, HO_INT_STEPS)
np.savez_compressed(
    os.path.join(OUT, "holdout_transition_audit.npz"),
    accepted_latent=ho_acc[:, :HO_AUDIT, :],
    proposal_latent=ho_prop[:, :HO_AUDIT, :],
    delta_h=ho_dh[:, :HO_AUDIT],
    accept_prob=ho_ap[:, :HO_AUDIT],
    accepted=ho_ac[:, :HO_AUDIT],
)
np.save(os.path.join(OUT, "holdout_terminal_states.npy"), ho_term)
print("holdout audit shapes:", ho_acc[:, :HO_AUDIT].shape,
      "terminal:", ho_term.shape,
      "holdout acceptance:", float(ho_ac.mean()))

# ----------------------------------------------------------------------------
# Centered samples and funnel profile
# ----------------------------------------------------------------------------
samples = centered_from_u(chart_u(latent_samples))       # (4,900,12) centered funnel coords
np.save(os.path.join(OUT, "samples.npy"), samples)

v_all = samples[..., 0].ravel()                          # v coordinate
radius2_all = np.sum(samples[..., 1:] ** 2, axis=-1).ravel()
n_total = v_all.size

rows = []
for b in range(PROFILE_BINS.shape[0]):
    left, right = PROFILE_BINS[b, 1], PROFILE_BINS[b, 2]
    if b == PROFILE_BINS.shape[0] - 1:
        mask = (v_all >= left) & (v_all <= right)
    else:
        mask = (v_all >= left) & (v_all < right)
    count = int(mask.sum())
    if count == 0:
        rows.append((int(PROFILE_BINS[b, 0]), left, right, count, 0.0,
                     float("nan"), float("nan"), float("nan")))
    else:
        vv = v_all[mask]
        rr = radius2_all[mask]
        mean_v = float(vv.mean())
        mean_radius2 = float(rr.mean())
        expected_radius2 = float((DIM - 1) * np.mean(np.exp(vv)))
        rows.append((int(PROFILE_BINS[b, 0]), left, right, count, count / n_total,
                     mean_v, mean_radius2, expected_radius2))

with open(os.path.join(OUT, "funnel_profile.csv"), "w") as f:
    f.write("bin_id,v_left,v_right,count,fraction,mean_v,mean_radius2,expected_radius2\n")
    for r in rows:
        f.write(",".join(str(x) for x in r) + "\n")

# ----------------------------------------------------------------------------
# Diagnostics
# ----------------------------------------------------------------------------
def ips_ess_multi(x):                      # x: (chains, n) 1-d
    return float(np.sum([ips_ess(x[c]) for c in range(x.shape[0])]))

kept_slice = slice(WARMUP, TOTAL)
v_kept = samples[..., 0]                      # (4,900)
r2_kept = np.sum(samples[..., 1:] ** 2, axis=-1)  # (4,900)
dh_kept = delta_h[:, kept_slice]
acc_kept = accepted[:, kept_slice]
abs_dh_kept = np.abs(dh_kept)

diag = {}
diag["mean_v"] = float(v_kept.mean())
diag["var_v"] = float(v_kept.var(ddof=1))
diag["mean_radius2"] = float(r2_kept.mean())
diag["split_rhat_v"] = split_rhat(v_kept)
diag["ess_v"] = ips_ess_multi(v_kept)
diag["split_rhat_radius2"] = split_rhat(r2_kept)
diag["ess_radius2"] = ips_ess_multi(r2_kept)
diag["overall_acceptance_rate"] = float(acc_kept.mean())
diag["chain_acceptance_rates"] = [float(acc_kept[c].mean()) for c in range(N_CHAINS)]
diag["mean_abs_delta_h"] = float(abs_dh_kept.mean())
diag["p95_abs_delta_h"] = float(np.percentile(abs_dh_kept, 95))
diag["max_abs_delta_h"] = float(abs_dh_kept.max())

# latent diagnostics from the standard funnel residuals z (NOT from q)
z = np.empty_like(samples)
z[..., 0] = samples[..., 0] / SIG_V
z[..., 1:] = np.exp(-samples[..., 0:1] / 2.0) * samples[..., 1:]
diag["latent_mean_abs_max"] = float(np.abs(z).mean(axis=(0, 1)).max())
diag["latent_var_abs_max"] = float(z.var(axis=(0, 1)).max())
diag["left_tail_prob_v_lt_minus5"] = float((v_kept < -5.0).mean())
diag["right_tail_prob_v_gt_5"] = float((v_kept > 5.0).mean())
json.dump(diag, open(os.path.join(OUT, "diagnostics.json"), "w"), indent=2)

# per-chain energy diagnostics
with open(os.path.join(OUT, "energy_diagnostics.csv"), "w") as f:
    f.write("chain_id,acceptance_rate,mean_abs_delta_h,p95_abs_delta_h,max_abs_delta_h\n")
    for c in range(N_CHAINS):
        a = abs_dh_kept[c]
        f.write(f"{c},{acc_kept[c].mean():.6f},{a.mean():.6e},"
                f"{np.percentile(a,95):.6e},{a.max():.6e}\n")

print("diagnostics keys ok, mean_v=%.4f var_v=%.4f mean_radius2=%.4f"
      % (diag["mean_v"], diag["var_v"], diag["mean_radius2"]))


