def _glyph(ch):
    ch = ch.upper()
    if ch not in _GLYPHS:
        return None
    return [int(_GLYPHS[ch][i:i+2], 16) for i in range(0, 14, 2)]

def text_w(chars):
    return sum(6 for c in chars if _glyph(c) is not None)

def draw_text(img, x, y, chars, color, scale=1):
    """draw 5x7 text, scale = pixel amplification, x,y = top-left."""
    cx = int(x)
    for ch in chars:
        g = _glyph(ch)
        if g is None:
            cx += 6
            continue
        for r in range(7):
            byte = g[r]
            for c in range(5):
                if byte & (1 << (4 - c)):
                    for dy in range(scale):
                        for dx in range(scale):
                            yy = int(round(y)) + r * scale + dy
                            xx = int(round(cx)) + c * scale + dx
                            if 0 <= yy < img.shape[0] and 0 <= xx < img.shape[1]:
                                img[yy, xx] = color
        cx += 6 * scale

def draw_line(img, x0, y0, x1, y1, color, lw=1):
    """anti-aliased-free thick-ish line via supersampling."""
    steps = int(max(abs(x1 - x0), abs(y1 - y0))) + 1
    pts = []
    for i in range(steps + 1):
        t = i / steps
        pts.append((x0 + t * (x1 - x0), y0 + t * (y1 - y0)))
    for (px, py) in pts:
        for dy in range(lw):
            for dx in range(lw):
                xx = int(round(px + dx - lw / 2))
                yy = int(round(py + dy - lw / 2))
                if 0 <= yy < img.shape[0] and 0 <= xx < img.shape[1]:
                    img[yy, xx] = color

def fill_rect(img, x0, y0, x1, y1, color):
    x0, x1 = sorted((int(x0), int(x1)))
    y0, y1 = sorted((int(y0), int(y1)))
    img[max(0, y0):min(img.shape[0], y1 + 1), max(0, x0):min(img.shape[1], x1 + 1)] = color


class Panel:
    def __init__(self, img, x0, y0, x1, y1, title, dark=(20, 24, 34),
                 line=(150, 160, 178), acc=(235, 235, 245)):
        self.img = img
        self.x0, self.y0, self.x1, self.y1 = x0, y0, x1, y1
        fill_rect(img, x0, y0, x1, y1, dark)
        # title
        draw_text(img, x0 + 8, y0 + 6, title, acc, scale=2)
        # axis box inside panel
        self.ax = (x0 + 52, y0 + 46, x1 - 16, y1 - 40)
        draw_text(img, self.ax[0], y1 - 24, "t", line, scale=1)
        # frame
        fill_rect(img, self.ax[0], self.ax[2], self.ax[0], self.ax[3] + 1, line)  # left
        fill_rect(img, self.ax[0], self.ax[3], self.ax[1], self.ax[3], line)      # bottom
        self.xmap = lambda v: self.ax[0] + (v - self.vmin) / (self.vmax - self.vmin) * (self.ax[1] - self.ax[0])
        self.ymap = lambda v: self.ax[3] - (v - self.ymin) / (self.ymax - self.ymin) * (self.ax[3] - self.ax[2])

    def set_lims(self, vmin, vmax, ymin, ymax):
        self.vmin, self.vmax = vmin, vmax
        self.ymin, self.ymax = ymin, ymax

    def polyline(self, xs, ys, color, lw=1):
        prev = None
        for x, y in zip(xs, ys):
            px, py = self.xmap(x), self.ymap(y)
            if prev is not None and not (np.isnan(x) or np.isnan(y)):
                draw_line(self.img, prev[0], prev[1], px, py, color, lw)
            prev = (px, py)

    def bars(self, xs, ys, color):
        n = len(xs)
        if n == 1:
            w = (self.ax[1] - self.ax[0])
        else:
            w = (self.ax[1] - self.ax[0]) / (self.vmax - self.vmin) * (xs[1] - xs[0]) * 0.7
        w = max(2.0, w)
        for x, y in zip(xs, ys):
            x0 = self.xmap(x) - w / 2
            x1 = self.xmap(x) + w / 2
            y1 = self.ymap(max(y, self.ymin * 1e-30))
            y0 = self.ymap(0.0)
            fill_rect(self.img, x0, min(y0, y1), x1, max(y0, y1), color)

    def text(self, x, y, s, color, pct=False, scale=1):
        if pct:
            px = self.ax[0] + (x - self.vmin) / (self.vmax - self.vmin) * (self.ax[1] - self.ax[0])
            py = self.ax[3] - (y - self.ymin) / (self.ymax - self.ymin) * (self.ax[3] - self.ax[2])
        else:
            px, py = x, y
        draw_text(self.img, px, py, s, color, scale)


def write_png(path, img):
    """minimal RGB PNG writer using zlib + struct."""
    h, w = img.shape[0], img.shape[1]
    raw = bytearray()
    for y in range(h):
        raw.append(0)  # filter type None
        raw.extend(img[y, :, 0].tobytes())
        raw.extend(img[y, :, 1].tobytes())
        raw.extend(img[y, :, 2].tobytes())

    def chunk(tag, data):
        c = tag + data
        return _struct.pack(">I", len(data)) + c + _struct.pack(">I", _zlib.crc32(c) & 0xffffffff)

    sig = b"\x89PNG\r\n\x1a\n"
    ihdr = _struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0)  # 8-bit RGB
    idat = _zlib.compress(bytes(raw), 6)
    with open(path, "wb") as f:
        f.write(sig)
        f.write(chunk(b"IHDR", ihdr))
        f.write(chunk(b"IDAT", idat))
        f.write(chunk(b"IEND", b""))


