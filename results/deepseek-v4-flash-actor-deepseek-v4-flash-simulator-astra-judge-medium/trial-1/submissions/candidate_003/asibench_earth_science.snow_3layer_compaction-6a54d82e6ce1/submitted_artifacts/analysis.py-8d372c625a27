 'E':["11111","10000","10000","11110","10000","10000","11111"],
 'F':["11111","10000","10000","11110","10000","10000","10000"],
 'G':["01110","10001","10000","10111","10001","10001","01111"],
 'H':["10001","10001","10001","11111","10001","10001","10001"],
 'I':["01110","00100","00100","00100","00100","00100","01110"],
 'J':["00111","00010","00010","00010","00010","10010","01100"],
 'K':["10001","10010","10100","11000","10100","10010","10001"],
 'L':["10000","10000","10000","10000","10000","10000","11111"],
 'M':["10001","11011","10101","10101","10001","10001","10001"],
 'N':["10001","11001","10101","10011","10001","10001","10001"],
 'O':["01110","10001","10001","10001","10001","10001","01110"],
 'P':["11110","10001","10001","11110","10000","10000","10000"],
 'Q':["01110","10001","10001","10101","10010","01101","00000"],
 'R':["11110","10001","10001","11110","10100","10010","10001"],
 'S':["01111","10000","10000","01110","00001","00001","11110"],
 'T':["11111","00100","00100","00100","00100","00100","00100"],
 'U':["10001","10001","10001","10001","10001","10001","01110"],
 'V':["10001","10001","10001","10001","10001","01010","00100"],
 'W':["10001","10001","10001","10101","10101","10101","01010"],
 'X':["10001","10001","01010","00100","01010","10001","10001"],
 'Y':["10001","10001","01010","00100","00100","00100","00100"],
 'Z':["11111","00001","00010","00100","01000","10000","11111"],
 '0':["01110","10001","10011","10101","11001","10001","01110"],
 '1':["00100","01100","00100","00100","00100","00100","01110"],
 '2':["01110","10001","00001","00010","00100","01000","11111"],
 '3':["11111","00010","00100","00010","00001","10001","01110"],
 '4':["00010","00110","01010","10010","11111","00010","00010"],
 '5':["11111","10000","11110","00001","00001","10001","01110"],
 '6':["00110","01000","10000","11110","10001","10001","01110"],
 '7':["11111","00001","00010","00100","01000","01000","01000"],
 '8':["01110","10001","10001","01110","10001","10001","01110"],
 '9':["01110","10001","10001","01111","00001","00010","01100"],
 ' ':[ "00000"]*7,'-':["00000"]*3+["11111"]+["00000"]*3,
 '.':["00000"]*5+["01100","01100"],
 ',':["00000"]*5+["01100","00100"],
 '%':["11001","11011","00010","00100","01000","11011","10011"],
 '+':["00000","00100","00100","11111","00100","00100","00000"],
 '_':["00000"]*6+["11111"],
 ':':["00000","01100","01100","00000","01100","01100","00000"],
 '/':["00001","00010","00010","00100","01000","01000","10000"],
 '(':["00010","00100","01000","01000","01000","00100","00010"],
 ')':["01000","00100","00010","00010","00010","00100","01000"],
 '~':["00000"]*2+["01010","10101","01010"]+["00000"]*2}
_CW,_CH=5,7
def Txt(s, scale=1, color=(20,20,20)):
    return ([_FONT.get(c.upper(), _FONT[' ']) for c in s], scale, color)
def TxtW(tx): return (max(len(g) for g in tx[0])*_CW + (len(tx[0])-1)*_CH//_CH*_CW*(tx[1]>0)) * tx[1]
def Blit(img,x,y,tx):
    gs,sc,col=tx; H,W=img.shape[0],img.shape[1]; cx=int(x)
    for g in gs:
        for r,row in enumerate(g):
            for c,ch in enumerate(row):
                if ch=='1':
                    for dy in range(sc):
                        for dx in range(sc):
                            px,py=cx+c*sc+dx,int(y)+r*sc+dy
                            if 0<=px<W and 0<=py<H: img[py,px]=col
        cx+=_CW*sc
    return cx
def Line(img,x0,y0,x1,y1,col,w=1):
    H,W=img.shape[0],img.shape[1]; n=int(max(abs(x1-x0),abs(y1-y0),1))
    for i in range(n+1):
        t=i/n; px=int(round(x0+(x1-x0)*t)); py=int(round(y0+(y1-y0)*t))
        for dy in range(w):
            for dx in range(w):
                xx,yy=px+dx-w//2,py+dy-w//2
                if 0<=xx<W and 0<=yy<H: img[yy,xx]=col
def Poly(img,xs,ys,x0,y0,x1,y1,col,w=2):
    xs=np.asarray(xs,float); ys=np.asarray(ys,float)
    xmn,xmx=float(xs.min()),float(xs.max())
    ymn,ymx=float(ys.min()),float(ys.max())
    if xmx==xmn: xmx=xmn+1
    if ymx==ymn: ymx=ymn+1
    X=[int(x0+(xx-xmn)/(xmx-xmn)*(x1-x0)) for xx in xs]
    Y=[int(y1-(yy-ymn)/(ymx-ymn)*(y1-y0)) for yy in ys]
    for j in range(len(X)-1): Line(img,X[j],Y[j],X[j+1],Y[j+1],col,w)
def Axis(img,x0,x1,y0,y1,col=(30,30,30),grid=(215,215,215)):
    for gx in np.linspace(x0,x1,7)[1:-1]: Line(img,int(gx),y0,int(gx),y1,grid,1)
    for gy in np.linspace(y0,y1,4)[1:-1]: Line(img,x0,int(gy),x1,int(gy),grid,1)
    for p in [(x0,y0,x1,y0),(x0,y1,x1,y1),(x0,y0,x0,y1),(x1,y0,x1,y1)]:
        Line(img,p[0],p[1],p[2],p[3],col,1)
def SavePNG(path,img):
    H,W=img.shape[0],img.shape[1]
    raw=bytearray()
    for r in range(H):
        raw.append(0); raw.extend(img[r].tobytes())
    def ch(tag,data):
        c=tag+data
        return struct.pack(">I",len(data))+c+struct.pack(">I",zlib.crc32(c)&0xffffffff)
    ihdr=struct.pack(">IIBBBBB",W,H,8,2,0,0,0)
    idat=zlib.compress(bytes(raw),9)
    with open(path,"wb") as f:
        f.write(b"\x89PNG\r\n\x1a\n"+ch(b"IHDR",ihdr)+ch(b"IDAT",idat)+ch(b"IEND",b""))

def render_figure(state, summary, closure, max_res, stats,
                  final_SWE, final_depth, tot_melt, tot_refr, tot_runoff, path):
    W,H=1760,1250; img=np.full((H,W,3),255,np.uint8)
    days=summary["day"].to_numpy()
    dark=(20,20,20); blue=(25,55,190); red=(190,35,35)
    green=(25,130,70); grey=(120,120,120)
    cols=[(25,55,190),(25,130,70),(200,60,60)]
    ti=Txt("SNOWPACK DYNAMICS - fixed 3-layer process model (68 days, hourly dt)",2)
    Blit(img,(W-TxtW(ti))//2,30,ti)
    sb=Txt("albedo=0.78 | wind=3 m/s | latent=0 | ground flux=2 W/m2 | retention=5% ice | "
           "snow rho=110 kg/m3 | Anderson/Niu compaction",1)
    Blit(img,(W-TxtW(sb))//2,62,sb)
    px0=[50,620,1190]; pY0=130; pY1=620; pY2=700; pX1=560
    for p in range(3):
        Axis(img,px0[p],px0[p]+pX1,pY0,pY1); Axis(img,px0[p],px0[p]+pX1,pY2,pY2+pX1)
    Poly(img,days,summary["swe_mm"].to_numpy(),px0[0],pY0,px0[0]+pX1,pY1,blue,3)
    Blit(img,px0[0]+6,pY0-24,Txt("P1  Bulk SWE (mm)",1))
    Blit(img,px0[0],pY1+8,Txt("final SWE %.1f mm (init 209.8)"%final_SWE,1,blue))
    Poly(img,days,summary["melt_mm"].to_numpy(),px0[1],pY0,px0[1]+pX1,pY1,blue,2)
    Poly(img,days,summary["refreeze_mm"].to_numpy(),px0[1],pY0,px0[1]+pX1,pY1,green,2)
    Poly(img,days,summary["runoff_mm"].to_numpy(),px0[1],pY0,px0[1]+pX1,pY1,red,2)
    Blit(img,px0[1]+6,pY0-24,Txt("P2  Daily melt / refreeze / runoff (mm)",1))
    Blit(img,px0[1],pY1+8,Txt("melt %.0f refreeze %.0f runoff %.0f mm"%(tot_melt,tot_refr,tot_runoff),1,dark))
    Poly(img,days,summary["snow_depth_m"].to_numpy(),px0[2],pY0,px0[2]+pX1,pY1,dark,3)
    Blit(img,px0[2]+6,pY0-24,Txt("P3  Snow depth (m)",1))
    Blit(img,px0[2],pY1+8,Txt("final %.2f m  mean rho %.0f kg/m3"%(final_depth,final_SWE/final_depth),1,dark))
    for i in range(3):
        Poly(img,days,state[:,i,4],px0[0],pY2,px0[0]+pX1,pY2+pX1,cols[i],2)
    Blit(img,px0[0]+6,pY2-24,Txt("P4  Layer temperatures (K) top/mid/bottom",1))
    for i in range(3):
        Poly(img,days,state[:,i,1],px0[1],pY2,px0[1]+pX1,pY2+pX1,cols[i],2)
    Blit(img,px0[1]+6,pY2-24,Txt("P5  Layer densities (kg/m3) top/mid/bottom",1))
    Poly(img,days,closure*1e12,px0[2],pY2,px0[2]+pX1,pY2+pX1,green,2)
    Blit(img,px0[2]+6,pY2-24,Txt("P6  Mass-balance closure residual (x1e-12 mm)",1))
    Blit(img,px0[2],pY2+pX1+8,Txt("max |resid| %.2e mm (tol 1e-6) | T %.1f..%.1f K"%(
        max_res,stats['Trange'][0],stats['Trange'][1]),1,dark))
    ft=Txt("model: enthalpy melt/refreeze | semi-implicit conduction | Anderson/Niu compaction | "
           "bucket retention/drainage | snow+rain-(dSWE+runoff)=0",1,grey)
    Blit(img,(W-TxtW(ft))//2,H-28,ft)
    SavePNG(path,img); return path

render_figure(state, summary, closure, max_res, stats, final_SWE, final_depth,
              tot_melt, tot_refr, tot_runoff, os.path.join(OUT,"snow_evolution.png"))

