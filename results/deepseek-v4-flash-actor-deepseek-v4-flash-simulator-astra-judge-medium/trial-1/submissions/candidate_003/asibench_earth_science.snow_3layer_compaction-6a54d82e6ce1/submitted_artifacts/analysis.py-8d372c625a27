    (cum_snow+cum_rain)-((final_SWE-SWE0)+cum_runoff)))
_p("max per-day closure residual: %.2e mm   (tolerance 1e-6 mm)"%max_res)
_p("stability: max |dT|/h = %.2f K ; F_surf [%.0f, %.0f] W/m2 ; T [%.1f, %.1f] K"%(
    stats['max_dT_per_hr'],stats['Fsurf_min'],stats['Fsurf_max'],stats['Trange'][0],stats['Trange'][1]))
_p("outputs: results/snow_state.npy, results/snow_summary.csv, results/snow_evolution.png")
