#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
analysis.py - process-based fixed 3-layer snowpack model (hourly forcing).

State per layer i: {h_i [m], rho_i [kg/m3], W_ice_i [mm w.e.],
W_liq_i [mm w.e.], T_i [K]}. Thickness is DERIVED from mass & density:
h_i = (W_ice_i + W_liq_i)/rho_i   (mm w.e. == kg/m2), so mass conservation
holds by construction; the only sources/sinks are precipitation (add) and
bottom runoff (remove). Latent heat flux = 0 (no humidity in forcing),
giving the exact closing relation  snowfall + rainfall = dSWE + runoff.

Processes per hourly step:
 1 precipitation (fresh snow into top layer, energy-blended temp; rain branch)
 2 semi-implicit conduction (3x3 tridiagonal) + surface (SW/LW/sensible) and
   ground (Neumann G_GND) fluxes + enthalpy melt/refreeze at 273.15 K
 3 Anderson/Niu-type compaction (overburden + metamorphism, fresh-snow boost)
 4 liquid-water retention (LIQ_RET of ice mass) & bucket drainage -> runoff

Outputs: results/snow_state.npy (n_days,3,5) = [th, rho, ice, liq, T] at END
of day; results/snow_summary.csv (day, swe, depth, melt, refreeze, runoff,
mean_density); results/snow_evolution.png (pure-python PNG, no matplotlib).
"""
import os, json, zlib, struct
import numpy as np
import pandas as pd

# ---------------- physical / model constants (documented choices) ------
T_FREEZE   = 273.15          # [K] freezing point
L_F        = 3.34e5          # [J/kg] latent heat of fusion
C_ICE      = 2100.0          # [J/kg/K] ice/snow specific heat
SIGMA      = 5.670374419e-8  # [W/m2/K4]
RHO_W      = 1000.0          # [kg/m3] water; mm w.e. == kg/m2
G          = 9.81            # [m/s2]
ALB        = 0.78            # [-] fixed snow albedo (assumption)
EMIS       = 0.98            # [-] snow LW emissivity
RHO_AIR    = 1.29            # [kg/m3] air density
CP_AIR     = 1005.0          # [J/kg/K]
U_WIND     = 3.0             # [m/s] nominal wind (assumption, not in forcing)
C_H        = 2.0e-3          # [-] bulk transfer coefficient (sensible)
LATENT     = 0.0             # [W/m2] latent flux = 0 (assumption; closes mass)
G_GND      = 2.0             # [W/m2] fixed ground heat flux (Neumann BC)
ETA0       = 6.0e8           # [Pa s] viscosity ref at 0 C (overburden)
C_OV       = 0.021           # [m3/kg] density exponent in viscosity
K_T        = 0.08            # [1/K] compaction temperature sensitivity
CMET       = 6.0e-8          # [1/s] metamorphism settling prefactor
KMET       = 0.08            # [1/K] metamorphism temperature sensitivity
FRESH_BOOST= 12.0            # [-] settling multiplier for fresh snow
TAU_FRESH  = 6.0*3600.0      # [s] e-folding decay of fresh-snow boost
RHO_CAP    = 520.0           # [kg/m3] density cap
LIQ_RET    = 0.05            # [-] retention capacity, fraction of ice mass
RHO_NEW    = 110.0           # [kg/m3] density of freshly fallen snow
DT         = 3600.0          # [s] timestep (1 h)

# ---------------- load data -------------------------------
HERE = os.path.dirname(os.path.abspath(__file__))
DATA = os.path.join(HERE, "data"); OUT = os.path.join(HERE, "results")
os.makedirs(OUT, exist_ok=True)
with open(os.path.join(DATA, "snowpack_init.json")) as f:
    _init = json.load(f)["layers"]
W_ice = np.array([l["ice_mm"] for l in _init], float)
W_liq = np.array([l["liq_mm"] for l in _init], float)
rho   = np.array([l["density_kg_m3"] for l in _init], float)
T     = np.array([l["temp_K"] for l in _init], float)

forc  = pd.read_csv(os.path.join(DATA, "forcing.csv"))
t_air = forc["t_air_K"].to_numpy(float); sw = forc["sw_in_wm2"].to_numpy(float)
lwin  = forc["lw_in_wm2"].to_numpy(float)
snowf = forc["snowfall_mm_hr"].to_numpy(float); rainf = forc["rainfall_mm_hr"].to_numpy(float)
n_hr   = len(forc)
n_days = int(np.floor(forc["time_hr"].max() / 24)) + 1
assert (np.diff(forc["time_hr"].to_numpy()) == 1.0).all()

def thickness(Wi, Wl, r): return (Wi + Wl) / r            # m
def k_eff(r): return 0.023 + 0.234 * r / 1000.0           # Sturm-type

snow_day_in = forc.groupby(np.floor(forc["time_hr"]/24).astype(int))["snowfall_mm_hr"].sum().to_numpy()
rain_day_in = forc.groupby(np.floor(forc["time_hr"]/24).astype(int))["rainfall_mm_hr"].sum().to_numpy()

state = np.zeros((n_days, 3, 5))
SWE0  = float(W_ice.sum() + W_liq.sum())
cum_snow=0.0; cum_rain=0.0; cum_runoff=0.0
day_run=np.zeros(n_days); day_melt=np.zeros(n_days); day_refr=np.zeros(n_days)
fs=np.zeros(3)
stats=dict(max_dT_per_hr=0.0,Fsurf_min=np.inf,Fsurf_max=-np.inf,Trange=[np.inf,-np.inf])

def cond_coef(kk, hh, i, j, C):
    zk=(kk[i]+kk[j])/2.0; dz=(hh[i]+hh[j])/2.0
    return DT*zk/(dz*C)

# ---------------- hourly integration ----------------------
for k in range(n_hr):
    d = k // 24
    if snowf[k] > 0.0:
        m_snow = snowf[k]; W_ice[0] += m_snow
        rho[0] = (rho[0]*(W_ice[0]-m_snow) + RHO_NEW*m_snow)/W_ice[0]
        fs[0] = 1.0; cum_snow += m_snow
        tmix = min(t_air[k], T_FREEZE); m_prev = W_ice[0]-m_snow
        t_mix = (m_prev*C_ICE*T[0] + m_snow*C_ICE*tmix)/((m_prev+m_snow)*C_ICE) if m_prev>0 else tmix
        T[0] = min(t_mix, T_FREEZE)
    if rainf[k] > 0.0:
        W_liq[0] += rainf[k]; cum_rain += rainf[k]

    M = W_ice + W_liq                          # kg/m2
    Ccap = np.maximum(M,1e-6)*C_ICE            # J/K per m2
    hh = thickness(W_ice,W_liq,rho); kk = k_eff(rho)
    T0 = T[0]
    f_surf = (1.0-ALB)*sw[k] + EMIS*(lwin[k]-SIGMA*T0**4) \
           + RHO_AIR*CP_AIR*C_H*U_WIND*(t_air[k]-T0) + LATENT
    stats["Fsurf_min"]=min(stats["Fsurf_min"],f_surf)
    stats["Fsurf_max"]=max(stats["Fsurf_max"],f_surf)
    a01c0=cond_coef(kk,hh,0,1,Ccap[0]); a01c1=cond_coef(kk,hh,0,1,Ccap[1])
    a12c1=cond_coef(kk,hh,1,2,Ccap[1]); a12c2=cond_coef(kk,hh,1,2,Ccap[2])
    A=np.zeros((3,3)); b=np.zeros(3)
    A[0,0]=1+a01c0;  A[0,1]=-a01c0;             b[0]=T[0]+DT/Ccap[0]*f_surf
    A[1,0]=-a01c1;   A[1,1]=1+a01c1+a12c1; A[1,2]=-a12c1; b[1]=T[1]
    A[2,1]=-a12c2;   A[2,2]=1+a12c2;            b[2]=T[2]+DT/Ccap[2]*G_GND
    Tn = np.linalg.solve(A,b)
    stats["max_dT_per_hr"]=max(stats["max_dT_per_hr"],float(np.abs(Tn-T).max()))
    Wliq_old = W_liq.copy()
    for i in range(3):
        E = Ccap[i]*(Tn[i]-T_FREEZE) + L_F*W_liq[i]
        if E >= 0.0:                        # at melting point: liquid present
            W_liq[i] = E/L_F; T[i] = T_FREEZE
        else:                               # deficit: refreeze as much liquid
            freez = min(W_liq[i], -E/L_F)   # as needed to hold T at 273.15 K
            W_liq[i] -= freez
            E2 = E + freez*L_F              # remaining cold content after refreeze
            T[i] = T_FREEZE + E2/Ccap[i]
            if W_liq[i] < 1e-9: W_liq[i] = 0.0
        W_ice[i] = M[i]-W_liq[i]            # conserve total water mass per layer
        if W_ice[i] < 0.0: W_ice[i]=0.0; W_liq[i]=M[i]
    d_melt = np.maximum(0.0,W_liq-Wliq_old); d_refr = np.maximum(0.0,Wliq_old-W_liq)
    day_melt[d]+=d_melt.sum(); day_refr[d]+=d_refr.sum()
    stats["Trange"][0]=min(stats["Trange"][0],float(T.min()))
    stats["Trange"][1]=max(stats["Trange"][1],float(T.max()))

    for i in range(3):
        if W_ice[i] <= 0.0: continue
        sig = G*M[np.arange(3) < i].sum()
        rate = (sig/(ETA0*np.exp(C_OV*rho[i]))*np.exp(K_T*(T_FREEZE-T[i])) \
              + CMET*np.exp(-KMET*(T_FREEZE-T[i]))) * (1.0+FRESH_BOOST*fs[i])
        rho[i] = min(rho[i] + rho[i]*rate*DT, RHO_CAP)
    fs *= np.exp(-DT/TAU_FRESH)

    for i in range(3):
        cap = LIQ_RET*W_ice[i]; ex = W_liq[i]-cap
        if ex > 0.0:
            drain = min(ex, 0.5*W_liq[i]); W_liq[i] -= drain
            if i < 2: W_liq[i+1] += drain
            else: cum_runoff += drain; day_run[d] += drain

    if (k+1) % 24 == 0:
        drec = (k+1)//24 - 1; hh = thickness(W_ice,W_liq,rho)
        for i in range(3):
            state[drec,i,:] = [hh[i], rho[i], W_ice[i], W_liq[i], T[i]]

# ---------------- mass balance verification ---------------
swe_day = state[:,:,2].sum(1) + state[:,:,3].sum(1)
cum_in  = np.cumsum(snow_day_in + rain_day_in); cum_run = np.cumsum(day_run)
closure = swe_day - SWE0 - (cum_in - cum_run)
max_res = float(np.abs(closure).max())
final_SWE=float(W_ice.sum()+W_liq.sum()); final_depth=float(thickness(W_ice,W_liq,rho).sum())
tot_runoff=float(cum_runoff); tot_melt=float(day_melt.sum()); tot_refr=float(day_refr.sum())

# ---------------- required outputs ------------------------
np.save(os.path.join(OUT,"snow_state.npy"), state.astype(np.float64))
summary = pd.DataFrame({
    "day": np.arange(n_days), "swe_mm": swe_day,
    "snow_depth_m": state[:,:,0].sum(1),
    "melt_mm": day_melt, "refreeze_mm": day_refr, "runoff_mm": day_run,
    "mean_density_kg_m3": swe_day / state[:,:,0].sum(1),
})
summary.to_csv(os.path.join(OUT,"snow_summary.csv"), index=False)

# ================= pure-python PNG figure renderer ===================
_FONT = {
 'A':["01110","10001","10001","11111","10001","10001","10001"],
 'B':["11110","10001","10001","11110","10001","10001","11110"],
 'C':["01110","10001","10000","10000","10000","10001","01110"],
