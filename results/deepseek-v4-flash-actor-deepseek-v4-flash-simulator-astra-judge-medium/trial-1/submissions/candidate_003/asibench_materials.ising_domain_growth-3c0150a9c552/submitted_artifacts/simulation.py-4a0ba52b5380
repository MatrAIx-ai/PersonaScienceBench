def put_imshow(x0, y0, x1, y1, arr):
    """Nearest-neighbor upscale of a [-1,1] grid with an RdBu-like colormap."""
    pw, ph = int(x1 - x0 + 1), int(y1 - y0 + 1)
    yi = np.clip(np.round(np.linspace(0, L - 1, ph)).astype(int), 0, L - 1)
    xi = np.clip(np.round(np.linspace(0, L - 1, pw)).astype(int), 0, L - 1)
    sub = arr[np.ix_(yi, xi)]                      # (ph, pw) in [-1,1]
    t = (sub + 1.0) / 2.0
    R = (1 - t) * 40 + t * 225
    G = (1 - t) * 70 + t * 45
    B = (1 - t) * 170 + t * 60
    panel = np.stack([R, G, B], axis=-1)
    cv.img[int(y0):int(y1) + 1, int(x0):int(x1) + 1] = np.clip(panel, 0, 255).astype(np.uint8)

def legend_item(x, y, c, label, scale=1, marker="line"):
    if marker == "line":
        cv.line(x, y + 3, x + 26, y + 3, c)
    cv.text(x + 32, y, label, C_BLACK, scale)

def dashed(cv, mapxy, xs, ys, c):
    pts = []
    for x, y in zip(xs, ys):
        if not (np.isfinite(x) and np.isfinite(y)) or x <= 0 or y <= 0:
            pts.append(None); continue
        pts.append(mapxy(x, y))
    i = 0
    while i < len(pts) - 1:
        if pts[i] is not None and pts[i + 1] is not None:
            cv.line(pts[i][0], pts[i][1], pts[i + 1][0], pts[i + 1][1], c)
        i += 2

