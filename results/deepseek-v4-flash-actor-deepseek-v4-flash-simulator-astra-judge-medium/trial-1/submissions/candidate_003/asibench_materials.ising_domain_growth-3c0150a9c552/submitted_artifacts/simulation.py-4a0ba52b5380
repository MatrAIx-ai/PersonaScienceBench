def write_png(path, img):
    """Encode an (H, W, 3) uint8 RGB image as PNG (stdlib zlib/struct)."""
    h, w = img.shape[:2]
    raw = b"".join(b"\x00" + img[y].tobytes() for y in range(h))
    def chunk(tag, data):
        body = tag + data
        return struct.pack(">I", len(data)) + body + struct.pack(">I", zlib.crc32(body) & 0xffffffff)
    ihdr = struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0)
    with open(path, "wb") as fo:
        fo.write(b"\x89PNG\r\n\x1a\n")
        fo.write(chunk(b"IHDR", ihdr))
        fo.write(chunk(b"IDAT", zlib.compress(raw, 6)))
        fo.write(chunk(b"IEND", b""))

class Canvas:
    def __init__(self, w, h, bg=(255, 255, 255)):
        self.w, self.h = w, h
        self.img = np.full((h, w, 3), bg, dtype=np.uint8)
    def px(self, x, y, c):
        x, y = int(x), int(y)
        if 0 <= x < self.w and 0 <= y < self.h:
            self.img[y, x] = c
    def line(self, x0, y0, x1, y1, c):
        x0, y0, x1, y1 = int(round(x0)), int(round(y0)), int(round(x1)), int(round(y1))
        dx, dy = abs(x1 - x0), -abs(y1 - y0)
        sx = 1 if x0 < x1 else -1; sy = 1 if y0 < y1 else -1
        err = dx + dy
        while True:
            self.px(x0, y0, c)
            if x0 == x1 and y0 == y1:
                break
            e2 = 2 * err
            if e2 >= dy: err += dy; x0 += sx
            if e2 <= dx: err += dx; y0 += sy
    def rect(self, x0, y0, x1, y1, c, thick=1):
        for k in range(thick):
            self.line(x0 + k, y0, x1 - k, y0, c)
            self.line(x0 + k, y1, x1 - k, y1, c)
            self.line(x0, y0 + k, x0, y1 - k, c)
            self.line(x1, y0 + k, x1, y1 - k, c)
    def fill_rect(self, x0, y0, x1, y1, c):
        x0, x1 = max(0, int(x0)), min(self.w - 1, int(x1))
        y0, y1 = max(0, int(y0)), min(self.h - 1, int(y1))
        if x1 >= x0 and y1 >= y0:
            self.img[y0:y1 + 1, x0:x1 + 1] = c
    def text(self, x, y, s, c, scale=1):
        x, y = int(x), int(y)
        cx = x
        for ch in s:
            g = FONT.get(ch.upper(), FONT[" "])
            for ry, row in enumerate(g):
                for rx, cc in enumerate(row):
                    if cc == "#":
                        xx = cx + rx * scale
                        yy = y + ry * scale
                        for dy in range(scale):
                            for dx in range(scale):
                                self.px(xx + dx, yy + dy, c)
            cx += 6 * scale
        return cx

def panel_coords(px0, py0, px1, py1, xmin, xmax, ymin, ymax, logx=False, logy=False):
    def mapxy(x, y):
        xx = np.log10(x) if logx else x
        yy = np.log10(y) if logy else y
        xx0 = np.log10(xmin) if logx else xmin
        xx1 = np.log10(xmax) if logx else xmax
        yy0 = np.log10(ymin) if logy else ymin
        yy1 = np.log10(ymax) if logy else ymax
        sx = px0 + (xx - xx0) / (xx1 - xx0) * (px1 - px0)
        sy = py1 - (yy - yy0) / (yy1 - yy0) * (py1 - py0)
        return sx, sy
    return mapxy

def plot_series(cv, mapxy, xs, ys, c, every=1):
    prev = None
    for x, y in zip(xs[::every], ys[::every]):
        if not (np.isfinite(x) and np.isfinite(y)) or x <= 0 or y <= 0:
            prev = None; continue
        p = mapxy(x, y)
        if prev is not None:
            cv.line(prev[0], prev[1], p[0], p[1], c)
        prev = p

def draw_axes(cv, px0, py0, px1, py1, c=C_BLACK):
    cv.rect(px0, py0, px1, py1, c, thick=1)

def draw_ticks(cv, px0, py0, px1, py1, xticks, yticks, logx, logy,
               xmin, xmax, ymin, ymax, fmtx="%.0f", fmty="%.1f", scale=1):
    for tx in xticks:
        if logx:
            if tx <= 0: continue
            sx = px0 + (np.log10(tx) - np.log10(xmin)) / (np.log10(xmax) - np.log10(xmin)) * (px1 - px0)
        else:
            sx = px0 + (tx - xmin) / (xmax - xmin) * (px1 - px0)
        cv.line(sx, py1, sx, py1 + 3, C_BLACK)
        cv.text(sx - 14, py1 + 6, fmtx % tx, C_BLACK, scale)
    for ty in yticks:
        if logy:
            if ty <= 0: continue
            sy = py1 - (np.log10(ty) - np.log10(ymin)) / (np.log10(ymax) - np.log10(ymin)) * (py1 - py0)
        else:
            sy = py1 - (ty - ymin) / (ymax - ymin) * (py1 - py0)
        cv.line(px0 - 3, sy, px0, sy, C_BLACK)
        cv.text(px0 - 34, sy - 4, fmty % ty, C_BLACK, scale)

