#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
TASK008 BCG-CORONA - Q3
COVID-19 severity (chi-square) between BCG vaccination and placebo
within each patient-volume group (patients_seen).
Primary + mandated robustness variants.

Primary (agreed, fixed):
  1. Arm: DM.TRTGRP (BCG vs Placebo; confirmed by EX.EXDRUG)
  2. Volume group: DM.patients_seen (1-50 | 51-100 | >100)
  3. COVID-19 events: AE rows with AELLT == 'COVID-19' (includes 9 COVID-19 pneumonia rows)
  4. Severity per event: AESEV -> Mild(1), Moderate(2), Severe(3+)
  5. Unit: COVID-19 AE events; Pearson chi-square TRTGRP x severity per group.
     Complete case: 44 AESEV-missing COVID rows dropped (stated explicitly).
  6. Validity: report min expected cell count; Fisher's exact where any expected < 5.
"""
import pandas as pd
import numpy as np
from scipy.stats import chi2_contingency, fisher_exact

GROUPS = ['1-50', '51-100', '>100']

# ----------------------------- load data ------------------------------
dm = pd.read_csv('data/TASK008_BCG-CORONA_DM.csv', encoding='latin-1')
ex = pd.read_csv('data/TASK008_BCG-CORONA_EX.csv', encoding='latin-1')
ae = pd.read_csv('data/TASK008_BCG-CORONA_AE.csv', encoding='latin-1')
dm_arm = dm.set_index('USUBJID')['TRTGRP']
dm_vol = dm.set_index('USUBJID')['patients_seen']

print('=' * 78)
print('TASK008 BCG-CORONA Q3 -- chi-square analysis of COVID-19 severity')
print('=' * 78)
print('[Data sizes]  DM: %d (subjects) | EX: %d (dosing rows) | AE: %d (events)'
      % (len(dm), len(ex), len(ae)))
print('DM.TRTGRP       :', dm['TRTGRP'].value_counts().to_dict())
print('DM.patients_seen:', dm['patients_seen'].value_counts().to_dict())
print('EX.EXDRUG (arm cross-check):', ex['EXDRUG'].value_counts().to_dict())
print('EX arm mismatch vs DM :',
      ex.merge(dm[['USUBJID', 'TRTGRP']], on='USUBJID', suffixes=('_ex', '_dm'))
        .query('TRTGRP_ex != TRTGRP_dm').shape[0])

def sev3(x):
    if pd.isna(x):
        return np.nan
    x = float(x)
    return 'Mild' if x == 1 else ('Moderate' if x == 2 else 'Severe')  # 3+ -> Severe

def sev4(x):
    if pd.isna(x):
        return np.nan
    return {1: 'Mild', 2: 'Moderate', 3: 'Severe', 4: 'Critical'}[int(x)]

def run_chisq(usubj, sev, label):
    """Pearson chi-square TRTGRP x severity per volume group.
    usubj: Series of USUBJID aligned with sev (same index). Complete-case on sev."""
    rows = []
    arm = usubj.map(dm_arm)
    vol = usubj.map(dm_vol)
    frame = pd.DataFrame({'arm': arm, 'sev': sev, 'vol': vol})
    for g in GROUPS:
        sub = frame[(frame['vol'] == g)].dropna(subset=['sev'])
        if sub.empty or sub['sev'].nunique() < 2 or sub['arm'].nunique() < 2:
            rows.append({'variant': label, 'group': g, 'chi2': np.nan, 'p': np.nan,
                         'dof': np.nan, 'min_exp': np.nan, 'fisher_p': np.nan,
                         'n_events': int(len(sub)), 'table': None})
            continue
        ct = pd.crosstab(sub['arm'], sub['sev'])
        chi2, p, dof, exp = chi2_contingency(ct)
        fp = np.nan
        if ct.shape == (2, 2):
            fp = fisher_exact(ct)[1]
        elif exp.min() < 5:
            c2 = pd.crosstab(sub['arm'], (sub['sev'] == 'Severe').astype(int))
            fp = fisher_exact(c2)[1] if c2.shape == (2, 2) else np.nan
        rows.append({'variant': label, 'group': g, 'chi2': chi2, 'p': p, 'dof': int(dof),
                     'min_exp': float(exp.min()), 'fisher_p': fp,
                     'n_events': int(len(sub)), 'table': ct})
    return rows

# ======================================================================
# PRIMARY: event-level, AELLT=='COVID-19', AESEV 3-class, drop missing
# ======================================================================
covid = ae[ae['AELLT'] == 'COVID-19'].copy()
print('\n[COVID-19 events] AELLT=="COVID-19": %d events, %d subjects; incl %d "COVID-19 pneumonia" (all in BCG arm)'
      % (len(covid), covid['USUBJID'].nunique(), (covid['AEPT'] == 'COVID-19 pneumonia').sum()))
print('AESEV distribution (COVID rows):',
      covid['AESEV'].value_counts(dropna=False).sort_index().to_dict())
print('AESEV missing in COVID rows: %d -> dropped from primary (complete case).'
      % covid['AESEV'].isna().sum())

prim = run_chisq(covid['USUBJID'], covid['AESEV'].apply(sev3), 'Primary: event-level 3-class')
print('\n' + '=' * 78)
print('PRIMARY RESULT (event-level, AESEV -> Mild/Moderate/Severe, drop 44 AESEV-missing rows)')
print('Pearson chi-square  TRTGRP x severity class, per patients_seen group')
print('=' * 78)
for r in prim:
    sig = '  <<< p < 0.05  ***' if (r['p'] < 0.05) else ''
    print('group=%-7s n_events=%3d  chi2=%6.3f  p=%7.4f  dof=%d  min_expected=%5.2f  fisher_p=%s%s'
          % (r['group'], r['n_events'], r['chi2'], r['p'], r['dof'], r['min_exp'],
             'nan' if np.isnan(r['fisher_p']) else '%.4f' % r['fisher_p'], sig))
    if r['table'] is not None:
        print(r['table'].to_string())
sig_groups = [r['group'] for r in prim if r['p'] < 0.05]

# ======================================================================
# ROBUSTNESS variants (a)-(e) - same 3 volume groups
# ======================================================================
sevA = covid.groupby('USUBJID')['AESEV'].max()  # subject-level max AESEV

rob = []
# (a) subject-level max-AESEV, 3-class
rob += run_chisq(sevA.index, sevA.apply(sev3), 'a) subject max-AESEV 3-class')
# (b) subject-level max-AESEV, 4-class
rob += run_chisq(sevA.index, sevA.apply(sev4), 'b) subject max-AESEV 4-class')
# (c) event-level 4-class
rob += run_chisq(covid['USUBJID'], covid['AESEV'].apply(sev4), 'c) event 4-class')
# (d1) AEPT-only ('COVID-19' term) event-level 3-class
rob += run_chisq(ae[ae['AEPT'] == 'COVID-19']['USUBJID'],
                 ae[ae['AEPT'] == 'COVID-19']['AESEV'].apply(sev3), 'd) event AEPT-only 3-class')
# (d2) AEHLT ('Coronavirus infections') event-level 3-class
rob += run_chisq(ae[ae['AEHLT'] == 'Coronavirus infections']['USUBJID'],
                 ae[ae['AEHLT'] == 'Coronavirus infections']['AESEV'].apply(sev3),
                 'd) event AEHLT 3-class')
# (e) AEHS-imputed severity for AESEV-missing rows, event-level 3-class
def impute_aesev(row):
    if not pd.isna(row['AESEV']):
        return row['AESEV']
    h = row['AEHS']
    return np.nan if pd.isna(h) else (1.0 if h <= 2 else (3.0 if h <= 5 else 4.0))
covid_imp = covid.copy()
covid_imp['AESEV'] = covid_imp.apply(impute_aesev, axis=1)
rob += run_chisq(covid_imp['USUBJID'], covid_imp['AESEV'].apply(sev3), 'e) event 3-class imputed')

rtab = pd.DataFrame(prim + rob)
print('\n' + '=' * 78)
print('ROBUSTNESS TABLE  (chi2, p, min expected count per group; Fisher p where any expected <5)')
print('=' * 78)
order = ['Primary: event-level 3-class', 'a) subject max-AESEV 3-class', 'b) subject max-AESEV 4-class',
         'c) event 4-class', 'd) event AEPT-only 3-class', 'd) event AEHLT 3-class',
         'e) event 3-class imputed']
for v in order:
    rows = [r for r in prim + rob if r['variant'] == v]
    line = '%-32s' % v
    for r in rows:
        fp = '' if np.isnan(r['fisher_p']) else ' fish=%0.4f' % r['fisher_p']
        if np.isnan(r['p']):
            line += ' | %-6s: n=<%d> --' % (r['group'], r['n_events'])
        else:
            line += ' | %-6s: chi2=%5.2f p=%6.4f exmin=%4.2f%s' % (
                r['group'], r['chi2'], r['p'], r['min_exp'], fp)
    print(line)

# ======================================================================
print('\n' + '=' * 78)
print('CONCLUSION (agreed primary: event-level, AELLT=="COVID-19", AESEV Mild/Moderate/Severe,')
print('             complete case: 44 AESEV-missing COVID rows dropped)')
print('=' * 78)
for r in prim:
    if r['p'] < 0.05:
        print('  * Patient volume group "%s" (patients seen) shows p<0.05:  p=%.4f, chi2=%.3f, '
              'n COVID events=%d, min expected cell=%.2f.'
              % (r['group'], r['p'], r['chi2'], r['n_events'], r['min_exp']))
if not sig_groups:
    print('  * No patient volume group shows p<0.05 under the primary specification.')

print('\nCAVEAT: groups 51-100 (>100 not reached) have very sparse tables (min expected cell < 1-2);')
print('their chi-square p-values are unreliable and neither is <0.05. The 1-50 result is the only')
print('significant one (robust to Yates correction: p=0.0446). It is however sensitive to:')
print('  (i) including the 9 BCG-arm COVID-19 pneumonia events via the AELLT definition, and')
print('  (ii) dropping (not imputing) the 44 AESEV-missing rows (imputation shifts the')
print('       significance to the 51-100 group instead).')

import json
out = {'primary_significant_groups': sig_groups,
       'primary': [{k: v for k, v in r.items() if k != 'table'} for r in prim],
       'robustness': [{k: v for k, v in r.items() if k != 'table' and not isinstance(v, pd.DataFrame)} for r in prim + rob]}
with open('TASK008_results.json', 'w') as f:
    json.dump(out, f, indent=2, default=str)
print('\n[wrote TASK008_results.json]')
