#!/usr/bin/env python3
"""
BixBench bix-14-q3 — Clonal hematopoiesis (CHIP) non-reference exonic variant count
across the 86 samples.

Question: "After filtering out reference variant calls and variants located in
intronic, intergenic, or UTR regions how many non-reference exonic variants remain
in clonal hematopoiesis (CHIP) genes from the 86 samples analyzed?"

Decisions (fixed with researcher):
  - Counting unit (primary) = total variant CALLS (rows) across the 86 samples;
    a variant seen in multiple samples counts once per sample. Unique-variant
    totals reported secondarily.
  - Non-reference = Zygosity in {Heterozygous, Homozygous Variant};
    'Reference' and blank-zygosity rows are excluded as reference calls.
  - Region filter (literal reading): exclude ONLY:
        intron_variant, upstream_gene_variant (~intergenic),
        3_prime_UTR_variant, 5_prime_UTR_variant,
        5_prime_UTR_premature_start_codon_gain_variant
    splice_region_variant is KEPT (not in the listed intronic/intergenic/UTR set).
  - Sensitivity: also report the strict 'coding-only exonic' version that
    additionally EXCLUDES splice_region_variant.
  - CHIP filter: token match (split Gene Names on ';'/',') against the 56-gene
    list, case-sensitive; any matching token counts the row.
"""
import openpyxl, glob, os, re, collections, json

DATA = "data"
CHIP_DIR = os.path.join(DATA, "CHIP_DP10_GQ20_PASS")
GENE_LIST = os.path.join(DATA, "230214_Schenz_et_al_2022_CHIP_Genes.xlsx")

# ---------------------------------------------------------------- 1. genes
wb = openpyxl.load_workbook(GENE_LIST, data_only=True)
chip_genes = {r[0] for r in wb["Sheet1"].iter_rows(values_only=True) if r[0]}
print("CHIP gene list:", len(chip_genes), "genes (single column A1:A56, no header)")

# ---------------------------------------------------------------- 2. files
files = sorted(glob.glob(os.path.join(CHIP_DIR, "*.xlsx")))
assert len(files) == 86, f"Expected 86 sample files, found {len(files)}"
print("Sample workbooks found:", len(files))

NONREF = {"Heterozygous", "Homozygous Variant"}
REGION_EXCLUDE_LITERAL = {
    "intron_variant",
    "upstream_gene_variant",                 # intergenic-type term present in data
    "3_prime_UTR_variant",
    "5_prime_UTR_variant",
    "5_prime_UTR_premature_start_codon_gain_variant",
}
SPLICE = "splice_region_variant"
CODING_EXONIC = {  # strict coding-region SO terms
    "missense_variant", "synonymous_variant", "frameshift_variant",
    "inframe_insertion", "inframe_deletion",
}

def split_genes(raw):
    return [t.strip() for t in re.split(r"[;,]", str(raw)) if t.strip()]

# ---------------------------------------------------------------- 3. iterate
records = []          # one dict per data row
splice_p_annot = 0    # splice_region rows with a non-empty HGVS p.
splice_total = 0

for f in files:
    sample = os.path.basename(f).replace("230209_Exome_GRCh38_CHIP_", "").replace(".xlsx", "")
    wb = openpyxl.load_workbook(f, data_only=True, read_only=False)  # NOT read_only (dimension quirk)
    ws = wb[wb.sheetnames[0]]
    rows = list(ws.iter_rows(values_only=True))
    # header row = the row whose column A == 'Chr:Pos' (row index 2 in these files)
    hdr = next(i for i, r in enumerate(rows) if r and r[0] == "Chr:Pos")
    for r in rows[hdr + 1:]:
        if r[0] is None:
            continue
        rec = {
            "sample": sample,
            "chrpos": r[0],
            "refalt": r[1],
            "zyg": r[4],
            "dp": r[7],
            "gq": r[8],
            "genes": split_genes(r[12]),
            "so": r[13],
            "effect": r[14],
            "hgvp": r[18],
        }
        records.append(rec)
        if rec["so"] == SPLICE:
            splice_total += 1
            if rec["hgvp"] not in (None, ""):
                splice_p_annot += 1
    wb.close()

print("Total variant rows across 86 samples:", len(records))

# ---------------------------------------------------------------- 4. counts
def chip_hit(rec):
    return any(g in chip_genes for g in rec["genes"])

def region_ok_literal(rec):
    return rec["so"] not in REGION_EXCLUDE_LITERAL        # keeps splice_region

def region_ok_strict(rec):
    return rec["so"] in CODING_EXONIC                     # drops splice_region

def count_with(mask, tag):
    rows = [rec for rec, m in zip(records, mask) if m]
    n = len(rows)
    uniq_keys = {(x["chrpos"], x["refalt"]) for x in rows}
    uniq_pos = {x["chrpos"] for x in rows}
    per_sample = collections.Counter(x["sample"] for x in rows)
    so_break = collections.Counter(x["so"] for x in rows)
    eff_break = collections.Counter(x["effect"] for x in rows)
    zyg_break = collections.Counter(x["zyg"] for x in rows)
    genes_mut = set()
    for x in rows:
        for g in x["genes"]:
            if g in chip_genes:
                genes_mut.add(g)
    print("\n" + "=" * 70)
    print(f"[{tag}]")
    print("  variant CALLS (primary unit):", n)
    print("  unique variants (chr:pos + ref/alt):", len(uniq_keys))
    print("  unique positions (chr:pos):", len(uniq_pos))
    print("  samples with >=1 such variant:", len(per_sample), "of 86")
    if per_sample:
        v = list(per_sample.values())
        print("  per-sample calls: min={} max={} mean={:.2f} median={}".format(
            min(v), max(v), sum(v) / len(v), sorted(v)[len(v) // 2]))
    print("  SO breakdown:", dict(so_break))
    print("  Effect breakdown:", dict(eff_break))
    print("  Zygosity breakdown:", dict(zyg_break))
    print("  distinct CHIP genes mutated:", len(genes_mut))
    return {"tag": tag, "calls": n, "unique": len(uniq_keys),
            "samples": len(per_sample), "genes": sorted(genes_mut),
            "so": dict(so_break), "effect": dict(eff_break),
            "zyg": dict(zyg_break)}

# reference = excluded; non-ref = kept
nonref_mask = [r["zyg"] in NONREF for r in records]
print("\nNon-reference rows:", sum(nonref_mask))
chip_nonref_mask = [m and chip_hit(r) for m, r in zip(nonref_mask, records)]
print("Non-reference rows in CHIP genes:", sum(chip_nonref_mask))

mask_literal   = [m and chip_hit(r) and region_ok_literal(r) for m, r in zip(nonref_mask, records)]
mask_strict    = [m and chip_hit(r) and region_ok_strict(r)  for m, r in zip(nonref_mask, records)]

res_primary = count_with(mask_literal, "PRIMARY (literal): exclude intronic/intergenic/UTR, keep splice_region_variant")
res_sens    = count_with(mask_strict,  "SENSITIVITY: additionally exclude splice_region_variant (coding-only exonic)")

diff = res_primary["calls"] - res_sens["calls"]
print("\nDifference primary - sensitivity:", diff, "(all from splice_region_variant)")

# ---------------------------------------------------------------- 5. checks
# a) splice_region HGVS p. annotation check (global + among candidates)
print("\n" + "=" * 70)
print("Splice-region annotation check")
print("  total splice_region_variant rows:", splice_total)
print("  splice_region rows with non-empty HGVS p.:", splice_p_annot,
      f"({100.0*splice_p_annot/splice_total:.2f}% of all splice rows)" if splice_total else "")
cand_splice = [r for r in records if r["so"] == SPLICE and r["zyg"] in NONREF and chip_hit(r)]
cand_splice_p = sum(1 for r in cand_splice if r["hgvp"] not in (None, ""))
print("  splice_region rows among PRIMARY candidates:", len(cand_splice),
      "with HGVS p.:", cand_splice_p)

# b) DP/GQ/PASS pre-filter verification on primary candidate rows
viol = 0
for r in records:
    if mask_literal[records.index(r)]:
        if not ((r["dp"] is not None and r["dp"] >= 10) and (r["gq"] is not None and r["gq"] >= 20)):
            viol += 1
# recompute cleanly by index
viol = sum(1 for i, r in enumerate(records)
           if mask_literal[i] and
           not ((r["dp"] is not None and r["dp"] >= 10) and (r["gq"] is not None and r["gq"] >= 20)))
print("\nPrimary-candidate rows violating DP>=10 or GQ>=20:", viol)
# PASS column (col T) is 'PASS' for every row by prior inspection; confirm here
# (re-open a scan of Filter column T = index 19)

# c) zygosity / excluded rows sanity
ref_rows = sum(1 for r in records if r["zyg"] == "Reference")
blank_rows = sum(1 for r in records if r["zyg"] is None)
print("\nReference-zygosity rows excluded:", ref_rows,
      "| blank-zygosity rows excluded:", blank_rows)

# ---------------------------------------------------------------- 6. save summary
summary = {
    "chip_gene_count": len(chip_genes),
    "sample_files": len(files),
    "total_rows": len(records),
    "zygosity": dict(collections.Counter(r["zyg"] for r in records)),
    "so_all": dict(collections.Counter(r["so"] for r in records)),
    "splice_region_global": splice_total,
    "splice_region_with_hgvp": splice_p_annot,
    "nonreference_rows": sum(nonref_mask),
    "nonreference_chip_rows": sum(chip_nonref_mask),
    "primary": res_primary,
    "sensitivity": res_sens,
    "primary_minus_sensitivity": diff,
    "primary_candidates_dp_gq_violations": viol,
    "excluded_reference_rows": ref_rows,
    "excluded_blank_zyg_rows": blank_rows,
}
with open("analysis/chip_summary.json", "w") as fh:
    json.dump(summary, fh, indent=2, default=str)
print("\nSaved summary -> analysis/chip_summary.json")
print("DONE")
