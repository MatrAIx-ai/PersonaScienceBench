"""
Analysis: skewness of gene expression (log2(TPM+1) batch-corrected)
distribution across all cell lines in the DepMap expression panel.
Headline: pooled Fisher-Pearson moment skewness over ALL cell-line x gene values.

No matplotlib dependency: figure rendered as an SVG using numpy only.
"""
import time
import numpy as np
import pandas as pd
import scipy.stats as stats

t0 = time.time()
PATH = 'data/OmicsExpressionProteinCodingGenesTPMLogp1BatchCorrected.csv'

print("=== 1. Load & validate matrix ===")
df = pd.read_csv(PATH, index_col=0)          # empty-header index column = ACH cell-line IDs
print(f"Shape (rows=cell lines, cols=genes): {df.shape}")
print(f"Index unique: {df.index.is_unique}; dtype: {df.dtypes.unique()}")
print(f"Missing values: {int(df.isna().sum().sum())}  (fraction {df.isna().sum().sum()/df.size:.6f})")
print(f"Column index sample: {df.columns[:3].tolist()}")
flat = df.to_numpy(dtype=np.float64, copy=False)
vals = flat.ravel()
print(f"All numeric float64: {flat.dtype}; total values: {vals.size}")

print("\n=== 2. Pooled skewness (headline) ===")
n = vals.size
mean = float(vals.mean())
m2 = float(((vals - mean)**2).mean())
m3 = float(((vals - mean)**3).mean())
s = float(np.sqrt(m2))
g1 = m3 / (s**3)
G1 = g1 * np.sqrt(n*(n-1)) / (n-2)
g1_scipy_ub = float(stats.skew(vals, bias=False))
G1_scipy = float(stats.skew(vals, bias=True))
print(f"n = {n:,}")
print(f"g1 (Pearson moment, m3/s^3, ddof=0)  = {g1:.10f}")
print(f"G1 (bias-corrected)                  = {G1:.10f}")
print(f"scipy uncorrected / corrected        = {g1_scipy_ub:.10f} / {G1_scipy:.10f}")
print(f"correction factor                    = {np.sqrt(n*(n-1))/(n-2):.12f}")
sign = 'positive (right/heavy upper tail)' if g1 > 0 else 'negative (left/heavy lower tail)'
ab = abs(g1)
band = ("approximately symmetric (<0.5)" if ab < 0.5 else
        "moderately skewed (0.5-1.0)" if ab < 1.0 else "highly skewed (>1.0)")
print(f"SIGN: {sign}")
print(f"MAGNITUDE band: {band}  (|g1|={ab:.4f})")

print("\n=== 3. Supporting diagnostics ===")
median = float(np.median(vals))
mn = float(vals.min()); mx = float(vals.max())
pcts = {p: float(np.percentile(vals, p)) for p in (1, 5, 10, 25, 50, 75, 90, 95, 99)}
print(f"min={mn:.4f}  max={mx:.4f}")
print(f"mean={mean:.4f}  median={median:.4f}  (mean-median={mean-median:+.4f})")
print("percentiles:", {k: round(v, 4) for k, v in pcts.items()})
print(f"fraction <=0 (batch-corrected negatives/zeros): {(vals<=0).mean():.4f}")

print("\n=== 4. Robustness: per-gene skewness (n=19,138) ===")
gene_skew = stats.skew(flat, axis=0, bias=False)
print(f"per-gene skew: median={np.median(gene_skew):.4f}  mean={gene_skew.mean():.4f}")
print(f"fraction positive: {np.mean(gene_skew>0):.4f}")
for k, lo, hi in [('approx. symmetric (|s|<0.5)', 0, 0.5),
                  ('moderate (0.5<=|s|<1.0)', 0.5, 1.0),
                  ('high (|s|>=1.0)', 1.0, np.inf)]:
    fr = np.mean((np.abs(gene_skew) >= lo) & (np.abs(gene_skew) < hi))
    print(f"  {k}: {fr:.4f}")

print("\n=== 5. Figure (SVG, no matplotlib) ===")
def hist_svg(data, limits, bins, panel, xlab, title, g1v, meanv, medv, color='#4682B4'):
    h, edges = np.histogram(np.clip(data, limits[0], limits[1]), bins=bins)
    xmin, xmax = limits
    W, Hp, margin = 460, 300, 34
    plot_w, plot_h = W - 2*margin, Hp - 2*margin
    hmax = h.max()
    def X(v): return margin + (v - xmin)/(xmax - xmin)*plot_w
    def Y(c): return Hp - margin - c/hmax*plot_h
    s = [f'<rect x="0" y="0" width="{W}" height="{Hp}" fill="white"/>']
    # bars
    for i, c in enumerate(h):
        x0 = X(edges[i]); x1 = X(edges[i+1])
        y0 = Y(c)
        s.append(f'<rect x="{x0:.1f}" y="{y0:.1f}" width="{max(x1-x0,0.8):.1f}" height="{Hp-margin-y0:.1f}" fill="{color}" stroke="none"/>')
    # axis lines & labels
    s.append(f'<line x1="{margin}" y1="{Hp-margin}" x2="{W-margin}" y2="{Hp-margin}" stroke="black"/>')
    s.append(f'<line x1="{margin}" y1="{margin}" x2="{margin}" y2="{Hp-margin}" stroke="black"/>')
    s.append(f'<text x="{margin}" y="{Hp-8}" font-size="10">{xmin:.0f}</text>')
    s.append(f'<text x="{W-margin-30}" y="{Hp-8}" font-size="10">{xmax:.0f}</text>')
    # mean / median lines
    s.append(f'<line x1="{X(meanv):.1f}" y1="{margin+4}" x2="{X(meanv):.1f}" y2="{Hp-margin}" stroke="red" stroke-width="1.6" stroke-dasharray="4,3"/>')
    s.append(f'<line x1="{X(medv):.1f}" y1="{margin+4}" x2="{X(medv):.1f}" y2="{Hp-margin}" stroke="#228B22" stroke-width="1.6" stroke-dasharray="4,3"/>')
    s.append(f'<text x="{margin}" y="{margin-6}" font-size="11" font-weight="bold">{title}</text>')
    s.append(f'<text x="{margin}" y="{margin+10}" font-size="10" fill="red">mean={meanv:.2f}</text>')
    s.append(f'<text x="{margin}" y="{margin+24}" font-size="10" fill="#228B22">median={medv:.2f}</text>')
    s.append(f'<text x="{margin}" y="{Hp-2}" font-size="10">{xlab}</text>')
    return '\n'.join(s)

Wfull = 960
part1 = hist_svg(vals, (min(vals), max(vals)), 300, 1, 'z',
                 f'Pooled expression (n={n/1e6:.1f}M), skew g1={g1:.3f} (positive/right tail)', g1, mean, median)
# clip histogram is redundant of same panel; make panel2 full but with percentile marks is complex; use same panel twice with zoom label
part2 = hist_svg(vals, (-5, 15), 300, 2, 'z',
                 'Zoomed bulk (-5..15): mean > median => right-heavy tail', g1, mean, median, color='#5F9EA0')
svg = ('<svg xmlns="http://www.w3.org/2000/svg" width="%d" height="320" font-family="Arial, sans-serif">'
       '<g transform="translate(0,0)">%s</g><g transform="translate(%d,0)">%s</g></svg>') % (Wfull, part1, Wfull//2, part2)
open('expression_skewness_histogram.svg', 'w').write(svg)
print("saved: expression_skewness_histogram.svg")

print(f"\nElapsed {time.time()-t0:.1f}s")
print("\n=== SUMMARY ===")
print(f"Pooled skewness over {n:,} cell-line x gene values:")
print(f"  g1 (Pearson/Fisher moment) = {g1:.6f}")
print(f"  G1 (bias-corrected)        = {G1:.6f}")
print(f"  Interpretation: {band}; heavy RIGHT (upper) tail")
print(f"  Basis: pooled distribution across all 1,673 cell lines x 19,138 genes.")
