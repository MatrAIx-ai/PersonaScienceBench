#!/usr/bin/env python3
"""Gene length vs mean expression (protein_coding, CD4) - BixBench bix-22-q2.

Pipeline:
  1. Merge Length + gene_biotype onto counts on Geneid.
  2. Keep gene_biotype == "protein_coding" (exact).
  3. CD4 samples = annotation celltype == 'CD4' (151 samples, NOT suffix heuristic).
  4. Mean expression per gene = arithmetic mean of batch-corrected counts as-is
     over the 151 CD4 samples (PRIMARY).
  5. Pearson r between Length and per-gene mean; report n.
Also reports two contextual sensitivities:
  S1: log2(count+1) mean instead of raw arithmetic mean.
  S2: drop the 1,518 all-zero (across CD4) genes.
"""
import numpy as np
import pandas as pd
from scipy import stats

# ---- Load inputs -----------------------------------------------------------
meta = pd.read_csv("data/GeneMetaInfo_Zenodo.csv")
counts = pd.read_csv("data/BatchCorrectedReadCounts_Zenodo.csv", index_col=0)
ann = pd.read_csv("data/Sample_annotated_Zenodo.csv")

# ---- 1) Merge Length + gene_biotype onto counts, keyed by Geneid -----------
meta = meta[["Geneid", "Length", "gene_biotype"]].copy()
merged = counts.reset_index().rename(columns={"index": "Geneid"})
merged = merged.merge(meta, on="Geneid", how="inner")
assert merged["Geneid"].is_unique, "Geneid not unique after merge"
assert merged["Length"].notna().all(), "NA Length after merge"
print(f"[merge] {merged.shape[0]} rows after inner merge on Geneid; "
      f"{merged['Geneid'].duplicated().sum()} dups; Length NA={merged['Length'].isna().sum()}")

# ---- 2) Keep exact protein_coding -------------------------------------------
pc = merged[merged["gene_biotype"] == "protein_coding"].copy()
print(f"[filter] protein_coding genes kept: {len(pc)} (exact match)")

# ---- 3) CD4 samples from annotation celltype --------------------------------
cd4_samples = ann.loc[ann["celltype"] == "CD4", "sample"].tolist()
assert len(cd4_samples) == 151, f"expected 151 CD4, got {len(cd4_samples)}"
assert all(s in counts.columns for s in cd4_samples)
print(f"[cd4] {len(cd4_samples)} CD4 samples selected via annotation celltype; "
      f"all present in count matrix")

# gene-level CD4 matrix (drop the metadata cols we attached)
gene_cols = [c for c in pc.columns if c not in ("Geneid", "Length", "gene_biotype")]
X = pc[cd4_samples]                 # protein-coding x CD4 counts matrix
L = pc["Length"].values.astype(float)
assert len(cd4_samples) == X.shape[1]
print(f"[matrix] protein_coding x CD4 = {X.shape}")

# ---- 4) PRIMARY: arithmetic mean over CD4, Pearson r ------------------------
mean_expr = X.mean(axis=1)                       # as-is raw mean per gene
r, p = stats.pearsonr(L, mean_expr)
n = len(L)
print("\n=== PRIMARY ===")
print(f"n (protein_coding genes)  = {n}")
print(f"Pearson r (Length, arith-mean CD4 counts) = {r:.6f}")
print(f"p-value = {p:.3e}")

# ---- Sensitivities (context only) -------------------------------------------
# S1: mean of log2(count+1)
mean_log = np.log2(X + 1.0).mean(axis=1)
r1, p1 = stats.pearsonr(L, mean_log)

# S2: drop all-zero genes (gene mean == 0 across CD4)
mask = mean_expr > 0
L2 = L[mask]; m2 = mean_expr[mask]
r2, p2 = stats.pearsonr(L2, m2)

print("\n=== SENSITIVITIES (context only) ===")
print(f"S1: r on mean of log2(count+1)          = {r1:.6f}  (n={n})")
print(f"S2: r dropping all-zero genes (n={mask.sum()}) = {r2:.6f}")

# sanity: length describe
print("\nLength (bp): min={:.0f} median={:.0f} max={:.0f}".format(
    L.min(), np.median(L), L.max()))
print("mean-expr: min={:.3f} median={:.3f} max={:.1f}".format(
    mean_expr.min(), mean_expr.median(), mean_expr.max()))

import json
out = {
    "primary_pearson_r": float(r),
    "primary_p_value": float(p),
    "n_protein_coding_genes": int(n),
    "n_cd4_samples": len(cd4_samples),
    "length_unit": "base pairs (bp); unit-invariant for Pearson r",
    "sensitivity_log2mean_r": float(r1),
    "sensitivity_no_allzero_r": float(r2),
    "n_after_dropping_allzero": int(mask.sum()),
    "all_zero_genes_dropped": int((~mask).sum()),
    "mean_expression_def": "arithmetic mean of batch-corrected counts as-is over CD4",
}
with open("results.json", "w") as f:
    json.dump(out, f, indent=2)
print("\nresults.json written")
