"""
Correlation between gene length and mean expression across CD14 immune cells
for protein-coding genes. BixBench task bix-22-q4.
Primary analysis: raw scales (batch-corrected counts as-is, length in bp),
per literal question wording. Sensitivity on log scales reported separately.
"""
import pandas as pd
import numpy as np
from scipy import stats

DATA = "data"

# ----------------------------------------------------------------------
# 1. Load input files
# ----------------------------------------------------------------------
meta    = pd.read_csv(f"{DATA}/GeneMetaInfo_Zenodo.csv", index_col=0)
counts  = pd.read_csv(f"{DATA}/BatchCorrectedReadCounts_Zenodo.csv", index_col=0)
samp    = pd.read_csv(f"{DATA}/Sample_annotated_Zenodo.csv")

print("GeneMetaInfo shape:", meta.shape)
print("CountMatrix shape: ", counts.shape)
print("SampleAnnot shape: ", samp.shape)

# ----------------------------------------------------------------------
# 2. Identify the 132 CD14 samples via celltype column (not name suffix)
# ----------------------------------------------------------------------
cd14_samples = list(samp.loc[samp["celltype"] == "CD14", "sample"])
assert len(cd14_samples) == 132, f"expected 132 CD14 samples, got {len(cd14_samples)}"
missing = [s for s in cd14_samples if s not in counts.columns]
assert not missing, f"CD14 samples missing from count matrix: {missing}"

# naive suffix check as a guard/sanity (should be 118, i.e. 14 _1/_2-suffixed)
suffix_only = [c for c in counts.columns if c.endswith("CD14")]
print("CD14 by celltype:", len(cd14_samples), "| by name suffix 'CD14':", len(suffix_only))
print("CD14 samples not caught by suffix filter:", len(set(cd14_samples) - set(suffix_only)))

# ----------------------------------------------------------------------
# 3. Per-gene mean expression across the 132 CD14 samples (raw scale)
# ----------------------------------------------------------------------
cd14_counts = counts[cd14_samples]
mean_expr = cd14_counts.mean(axis=1)
mean_expr.name = "mean_expr_CD14"
assert len(mean_expr) == counts.shape[0]

# ----------------------------------------------------------------------
# 4. Filter gene metadata to protein_coding
# ----------------------------------------------------------------------
meta_pc = meta[meta["gene_biotype"] == "protein_coding"].copy()
print("protein_coding genes:", meta_pc.shape[0])
assert meta_pc["Geneid"].duplicated().sum() == 0, "duplicate Geneid in protein-coding subset"

# ----------------------------------------------------------------------
# 5. Join by Geneid with an index alignment assertion
# ----------------------------------------------------------------------
# Count-matrix gene index is a plain 0..n-1 index with the gene id as a column? Check:
# In this file the first column of the matrix is the gene id and index_col=0 made it
# the index. The metadata Geneid is a column. Verify identical sets and order.
count_gene_ids = pd.Index(counts.index.astype(str))
meta_ids = pd.Index(meta_pc["Geneid"].astype(str))

assert count_gene_ids.is_unique, "duplicate gene ids in count matrix"
assert meta_ids.is_unique, "duplicate Geneid in metadata"
assert set(count_gene_ids) == set(pd.Index(meta["Geneid"].astype(str))), \
    "gene id sets differ between count matrix and full metadata"

# attach mean expression to metadata by gene id
df = meta_pc[["Geneid", "Length", "gene_biotype"]].copy()
df["mean_expr_CD14"] = df["Geneid"].astype(str).map(mean_expr)
n_unmatched = df["mean_expr_CD14"].isna().sum()
assert n_unmatched == 0, f"{n_unmatched} protein-coding genes unmapped to expression"

print("Final analysis table rows (protein_coding genes):", df.shape[0])

# ----------------------------------------------------------------------
# 6. Pearson correlation (primary: raw scales, no transforms)
# ----------------------------------------------------------------------
r_raw, p_raw = stats.pearsonr(df["Length"], df["mean_expr_CD14"])
print(f"\n[PRIMARY] Pearson(length_bp, mean_expr_raw) = {r_raw:.6f}  (n={df.shape[0]}, p={p_raw:.3e})")

# ----------------------------------------------------------------------
# Optional sensitivity on log scales (reported, NOT the primary answer)
# ----------------------------------------------------------------------
r_ll, p_ll = stats.pearsonr(
    np.log2(df["Length"]),
    np.log2(df["mean_expr_CD14"] + 1),
)
print(f"[SENSITIVITY] Pearson(log2 length, log2(mean_expr+1)) = {r_ll:.6f}  (n={df.shape[0]}, p={p_ll:.3e})")

# Distributional summaries for context
def summ(s):
    import numpy as _np
    return dict(n=len(s), min=float(s.min()), median=float(s.median()),
                mean=float(s.mean()), max=float(s.max()))
print("\nLength (bp) summary:", summ(df["Length"]))
print("mean_expr CD14 summary:", summ(df["mean_expr_CD14"]))
print("Genes with mean_expr == 0:", int((df["mean_expr_CD14"] == 0).sum()))

# ----------------------------------------------------------------------
# Save results
# ----------------------------------------------------------------------
df.to_csv("analysis/gene_length_vs_cd14_expression.csv", index=False)
with open("analysis/result.txt", "w") as fh:
    fh.write(f"n_cd14_samples={len(cd14_samples)}\n")
    fh.write(f"n_protein_coding_genes={df.shape[0]}\n")
    fh.write(f"pearson_r_raw={r_raw:.10f}\n")
    fh.write(f"pearson_p_raw={p_raw:.3e}\n")
    fh.write(f"pearson_r_loglog_sensitivity={r_ll:.10f}\n")
print("\nSaved analysis/gene_length_vs_cd14_expression.csv and analysis/result.txt")
