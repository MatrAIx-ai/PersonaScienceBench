import pandas as pd
import numpy as np
from scipy import stats
import json

# ---------- Load ----------
meta = pd.read_csv('data/GeneMetaInfo_Zenodo.csv', index_col=0)
counts = pd.read_csv('data/BatchCorrectedReadCounts_Zenodo.csv', index_col=0)
samp = pd.read_csv('data/Sample_annotated_Zenodo.csv')

# ---------- Filter protein-coding ----------
pc = meta[meta['gene_biotype'] == 'protein_coding'].copy()
pc_counts = counts.loc[pc.index]              # 19,942 x 723
print("protein_coding genes:", pc.shape[0], "| count rows match:", pc_counts.shape[0])
assert pc.shape[0] == 19942

# ---------- Expression definitions ----------
mean_raw = pc_counts.mean(axis=1)                                    # log-of-mean style base
mean_of_log = np.log2(pc_counts + 1).mean(axis=1)                    # mean-of-log (per-sample log2 then mean)
log_mean = np.log2(mean_raw + 1)                                     # log of the pooled mean
Length = pc['Length'].to_numpy()
logLength = np.log10(Length)

# ---------- Primary: Pearson(log2(E+1), log10(Length)), E = pooled mean over 723 samples ----------
r_prim, p_prim = stats.pearsonr(log_mean, logLength)
n_prim = len(log_mean)

# ---------- Sensitivity table ----------
sens = {}
sens['raw count vs raw Length']            = stats.pearsonr(mean_raw, Length)[0]
sens['raw count vs log10 Length']          = stats.pearsonr(mean_raw, logLength)[0]
sens['log2(E+1) vs raw Length']            = stats.pearsonr(log_mean, Length)[0]
sens['log2(E+1) vs log10 Length (PRIMARY)']= stats.pearsonr(log_mean, logLength)[0]
sens['mean-of-log2(count+1) vs log10 Length'] = stats.pearsonr(mean_of_log, logLength)[0]

# per-cell-type: pooled-mean within each cell type, log2(E+1), vs log10(Length)
cell_results = {}
for ct, subset in samp.groupby('celltype'):
    cols = subset['sample'].tolist()
    E_ct = pc_counts[cols].mean(axis=1)
    x_ct = np.log2(E_ct + 1)
    r_ct, p_ct = stats.pearsonr(x_ct, logLength)
    cell_results[ct] = {'n_cell_samples': len(cols), 'r': round(r_ct,5), 'p': float(p_ct)}
pooled_pc = np.mean([cell_results[c]['n_cell_samples'] for c in cell_results])

# ---------- Length distribution for protein-coding ----------
L_stats = {
    'n': int(len(Length)), 'min': int(Length.min()), 'max': int(Length.max()),
    'median': float(np.median(Length)), 'mean': float(Length.mean()),
    'q25': float(np.quantile(Length,0.25)), 'q75': float(np.quantile(Length,0.75)),
    'pct<=100bp': float((Length<=100).mean()), 'pct>=10000bp': float((Length>=10000).mean()),
    'biotype_exact': "protein_coding"
}

# ---------- Report ----------
print("="*70)
print("PRIMARY RESULT  (approval scheme)")
print("   filter = gene_biotype == 'protein_coding'  -> n =", n_prim)
print("   E_g     = mean batch-corrected read count over all 723 samples")
print("   x       = log2(E_g + 1)")
print("   y       = log10(Length)")
print("   Pearson r = %.6f" % r_prim)
print("   p-value   = %.3e" % p_prim)
print("   n          = %d" % n_prim)
print("="*70)
print("\nSENSITIVITY TABLE (Pearson r):")
for k, v in sens.items():
    print(f"   {k:45s} r = {v:.6f}")

# mean-of-log vs log-of-mean discrepancy
disc = sens['mean-of-log2(count+1) vs log10 Length'] - r_prim
print("\n   mean-of-log minus log-of-mean (primary) r-delta = %.6f" % disc)
print("   verdict: %s" % ("MATERIAL (>0.05) -> recommendation needed" if abs(disc) > 0.05 else "negligible (<=0.05)"))

print("\nPER-CELL-TYPE Pearson r (log2(mean_ct+1) vs log10 Length):")
for c, d in cell_results.items():
    print(f"   {c:5s} (n_samples={d['n_cell_samples']:4d})  r = {d['r']:.5f}  p = {d['p']:.2e}")
print("   pooled-over-all-samples (primary): r = %.5f" % r_prim)

print("\nPROTEIN-CODING LENGTH DISTRIBUTION (bp):")
for k, v in L_stats.items():
    print(f"   {k:10s}: {v}")

# ---------- Save outputs ----------
out = {
    "primary": {
        "filter": "gene_biotype=='protein_coding'",
        "n_genes": n_prim,
        "expression": "mean batch-corrected read count over 723 samples",
        "x": "log2(E+1)", "y": "log10(Length)",
        "pearson_r": round(float(r_prim),6), "p_value": float(p_prim), "n": int(n_prim)
    },
    "sensitivity": {k: round(float(v),6) for k,v in sens.items()},
    "mean_of_log_minus_log_of_mean_delta": round(float(disc),6),
    "per_cell_type": {c:{'r':d['r'],'p':d['p']} for c,d in cell_results.items()},
    "protein_coding_length_distribution": L_stats
}
with open('correlation_results.json','w') as f:
    json.dump(out, f, indent=2)
print("\nsaved: correlation_results.json")
