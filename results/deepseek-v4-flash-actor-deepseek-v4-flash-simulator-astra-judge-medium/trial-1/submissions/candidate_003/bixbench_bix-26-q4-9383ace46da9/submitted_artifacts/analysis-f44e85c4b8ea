#!/usr/bin/env python3
"""
BixBench bix-26-q4 — KEGG over-representation analysis, P. aeruginosa (pae).
Approved spec:
  1) two media conditions = two DE comparisons (GluFe vs GluFePlus, Succ vs GluFePlus)
  2) significantly downregulated genes: log2FoldChange <= -1.5 AND padj < 0.05
  3) pathway significance: BH-adjusted p < 0.05
  4) common pathways = intersection of significant KEGG pathway IDs across conditions;
     answer = number of distinct pathway IDs in the intersection
  5) KEGG organism 'pae' (PAO1); gene IDs must be mapped PA14 -> PAO1 (KEGG locus tags)
  background = all annotated pae genes; genes without annotation removed from input
  but retained in the background.

External data REQUIRED (not present in this offline sandbox):
  A. PA14 -> PAO1 mapping   (default: data/pa14_to_pao1.tsv)
  B. KEGG pae pathway-gene annotation
     (default: data/kegg_pae_gene2pathway.tsv, data/kegg_pae_pathway_names.tsv)
If either is missing the ORA cannot be computed -> reported honestly, no number invented.
"""
import os, sys, gzip, struct, math
import pandas as pd
import numpy as np
from scipy.stats import hypergeom
from scipy.stats import rankdata

DATA_DIR = 'data'
OUT_DIR  = 'analysis'
ANALYSIS_SCRIPT = os.path.abspath(__file__)

# ----------------------------------------------------------------------------
# minimal RDS reader (R serialization format v3, XDR) for DESeq2 results
# ----------------------------------------------------------------------------
def u32(buf, off): return struct.unpack('>I', buf[off:off+4])[0]
def u64(buf, off): return struct.unpack('>Q', buf[off:off+8])[0]

def parse_strvec(buf, pos, n):
    out, p = [], pos
    for _ in range(n):
        w = u32(buf, p)
        if (w & 0xff) == 255:     # REFSXP
            out.append('<ref>'); p += 8; continue
        ln = u32(buf, p+4)
        if ln == 0xFFFFFFFF:      # NA_STRING
            out.append(None); p += 8; continue
        out.append(buf[p+8:p+8+ln].decode('utf-8','replace'))
        p += 8 + ln
    return out

def find_vecs(buf, typ_byte, nrows=5828):
    res = []
    for i in range(23, len(buf)-8):
        w = u32(buf, i)
        if (w & 0xff) == typ_byte and (w >> 8) == 0:
            if u32(buf, i+4) == nrows:
                res.append(i)
    return res

def load_results(path):
    buf = gzip.open(path,'rb').read()
    assert buf[:2] == b'X\n' and u32(buf,2) == 3, 'not an RDS format-3 file'
    nrows = 5828
    rownames = parse_strvec(buf, 84+8, nrows)
    rpos = find_vecs(buf, 0x0e, nrows)
    assert len(rpos) == 6, rpos
    cols = ['baseMean','log2FoldChange','lfcSE','stat','pvalue','padj']
    d = {}
    for c, s in zip(cols, rpos):
        d[c] = np.array([u64(buf,s+8+i*8) for i in range(nrows)],
                        dtype='>u8').view('>f8').astype(float)
    return pd.DataFrame(d, index=rownames)

# ----------------------------------------------------------------------------
# ORA (hypergeometric over-representation)
# ----------------------------------------------------------------------------
def ora(input_genes, kegg_gene2path, pathway_names, background_genes, padj_cut=0.05):
    """One-sided hypergeometric ORA. Returns per-pathway p-values & padj (BH)."""
    input_set   = set(input_genes) & set(kegg_gene2path.keys())  # genes with annotation
    bg_set      = set(background_genes) & set(kegg_gene2path.keys())
    N           = len(bg_set)           # background with >=1 pathway annotation
    pathways    = sorted(pathway_names.keys())
    rows = []
    for pw in pathways:
        members_bg   = {g for g in bg_set if pw in kegg_gene2path[g]}
        K            = len(members_bg)          # annotated in pathway (background)
        if K == 0:
            continue
        n            = len(input_set)           # input size (annotated)
        k            = len(input_set & members_bg)
        pv           = float(hypergeom.sf(k-1, N, K, n)) if k > 0 else 1.0
        rows.append({'pathway_id': pw, 'pathway_name': pathway_names[pw],
                     'input_genes_in_pathway': k, 'bg_genes_in_pathway': K,
                     'pvalue': pv, 'n_input': n, 'N': N})
    if not rows:
        return pd.DataFrame(columns=['pathway_id','pathway_name','pvalue','padj'])
    df = pd.DataFrame(rows)
    pv = df['pvalue'].values
    ranked = rankdata(pv, method='average')
    m = len(pv)
    df['padj'] = np.minimum(pv * m / ranked, 1.0)   # BH with ties correction
    df['significant'] = df['padj'] < padj_cut
    return df

def bh_adjust(pvals):
    p = np.asarray(pvals, float)
    n = len(p)
    ranked = rankdata(p, method='average')
    return np.minimum(p * n / ranked, 1.0)

# ----------------------------------------------------------------------------
def load_mapping(path):
    """PA14 -> PAO1 mapping table: columns pa14, pao1."""
    df = pd.read_csv(path, sep='\t' if path.endswith('.tsv') else ',')
    df.columns = [c.strip().lower() for c in df.columns]
    m = dict(zip(df['pa14'], df['pao1']))
    return m

def load_gene2pathway(path):
    df = pd.read_csv(path, sep='\t' if path.endswith('.tsv') else ',')
    df.columns = [c.strip().lower() for c in df.columns]
    g2p = {}
    for _, r in df.iterrows():
        g2p.setdefault(r['gene'], set()).add(r['pathway_id'])
    return g2p

def load_pathway_names(path):
    df = pd.read_csv(path, sep='\t' if path.endswith('.tsv') else ',')
    df.columns = [c.strip().lower() for c in df.columns]
    return dict(zip(df['pathway_id'], df['pathway_name']))

# ----------------------------------------------------------------------------
def main():
    os.makedirs(OUT_DIR, exist_ok=True)
    report = []
    ok = True

    # ---- step 1: extract DE tables & choose downregulated gene sets ----
    conditions = [
        ('GluFe_vs_GluFePlus', 'data/res_GluFevsGluFePlus.rds'),
        ('Succ_vs_GluFePlus',  'data/res_SuccvsGluFePlus.rds'),
    ]
    gene_sets = {}
    for name, path in conditions:
        df = load_results(path)
        down = df[(df['log2FoldChange'] <= -1.5) & (df['padj'] < 0.05)]
        gene_sets[name] = list(down.index)
        report.append(f'{name}: {df.shape[0]} genes tested; '
                      f'downregulated (log2FC<=-1.5 & padj<0.05) = {len(down)}')
        down.index.name = 'pa14'
        down[['log2FoldChange','padj']].to_csv(f'{OUT_DIR}/downregulated_{name}.csv')

    print('\n'.join(report)); print('-'*70)

    # ---- step 2: external data availability --------------------------------
    mmap_file = f'{DATA_DIR}/pa14_to_pao1.tsv'
    g2p_file  = f'{DATA_DIR}/kegg_pae_gene2pathway.tsv'
    pn_file   = f'{DATA_DIR}/kegg_pae_pathway_names.tsv'

    missing = [f for f in (mmap_file, g2p_file, pn_file) if not os.path.exists(f)]
    if missing:
        msg = ('NOT COMPUTABLE: KEGG pae pathway annotation / PA14->PAO1 mapping are '
               'unavailable in this sandbox (no internet, no R, no bundled snapshot). '
               'Missing required inputs: ' + ', '.join(missing) +
               '. Per the approved spec the ORA cannot be run; no number is reported.')
        print('\n' + msg)
        with open(f'{OUT_DIR}/run_report.txt','w') as f:
            f.write(msg + '\nrequired_sources: '
                    'KEGG REST (latest release, pae gene<-pathway) + PA14->PAO1 (PGDB/Sanger)\n')
        sys.exit(2)

    # ---- step 3: map genes & run ORA (only reached when data present) -------
    pa14_to_pao1 = load_mapping(mmap_file)
    kegg_gene2path = load_gene2pathway(g2p_file)
    pathway_names = load_pathway_names(pn_file)

    oras = {}
    for name, genes in gene_sets.items():
        mapped = [pa14_to_pao1[g] for g in genes if g in pa14_to_pao1]
        report.append(f'{name}: PA14 genes={len(genes)}, mapped to PAO1={len(mapped)} '
                      f'({100*len(mapped)/len(genes):.1f}%)')
        oras[name] = ora(mapped, kegg_gene2path, pathway_names,
                         background_genes=list(kegg_gene2path.keys()))
        sig = oras[name][oras[name]['significant']]
        sig.to_csv(f'{OUT_DIR}/significant_pathways_{name}.csv', index=False)
        report.append(f'{name}: significant pathways (padj<0.05) = {len(sig)}')
        for _, r in sig.sort_values('padj').iterrows():
            report.append(f'   {r.pathway_id}  {r.pathway_name}  '
                          f'(genes={r.input_genes_in_pathway}, padj={r.padj:.3g})')

    # ---- step 4: intersection ------------------------------------------------
    a = set(oras['GluFe_vs_GluFePlus'].query('significant')['pathway_id'])
    b = set(oras['Succ_vs_GluFePlus'].query('significant')['pathway_id'])
    inter = a & b
    report.append('='*70)
    report.append(f'GluFe significant pathways ({len(a)}): {sorted(a)}')
    report.append(f'Succ significant pathways ({len(b)}): {sorted(b)}')
    report.append(f'COMMON pathways (=intersection): {len(inter)} distinct: {sorted(inter)}')
    answer = len(inter) if len(a) or len(b) else 0
    report.append(f'ANSWER: {answer}')
    with open(f'{OUT_DIR}/run_report.txt','w') as f:
        f.write('\n'.join(report) + '\n')
    print('\n'.join(report))

if __name__ == '__main__':
    main()
