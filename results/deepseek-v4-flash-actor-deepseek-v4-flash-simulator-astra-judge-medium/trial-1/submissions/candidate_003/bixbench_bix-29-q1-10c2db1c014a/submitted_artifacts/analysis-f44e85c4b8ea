#!/usr/bin/env python3
"""
BCG-CORONA (TASK008) — Ordinal regression of COVID-19 severity on BCG vaccination,
controlling for prior medical history count, patient interaction frequency and
their pairwise two-way interactions.

Headline model (locked):
  - Outcome  : 5-level AESEV severity, subject worst-event:
       0 = no COVID-19 AE (uninfected), 1 = Mild, 2 = Moderate, 3 = Severe, 4 = Critical/death
  - Predictors: bcg (BCG=1/Placebo=0), hist_c (n present conditions, mean-centered),
                freq_c (patients_seen score 1/2/3, mean-centered),
                + bcg*hist_c, bcg*freq_c, hist*freq_c  (all pairwise two-way)
  - Link     : proportional-odds logit (statsmodels OrderedModel)
  - Target   : OR(BCG) = exp(beta_bcg), 95% CI, p-value (at mean hist & mean freq)
Sensitivity (evidence only): AEHS 9-level outcome; expect_interact / work_hours
as frequency proxies; interaction set without hist*freq; PO-stability heuristic.
"""
import numpy as np
import pandas as pd
from scipy import stats
from statsmodels.miscmodels.ordinal_model import OrderedModel
import statsmodels.api as sm

rng = np.random.default_rng(0)

# ----------------------------------------------------------------- load
dm = pd.read_csv('data/TASK008_BCG-CORONA_DM.csv')
ae = pd.read_csv('data/TASK008_BCG-CORONA_AE.csv')
mh = pd.read_csv('data/TASK008_BCG-CORONA_MH.csv')

# ----------------------------------------------------------------- outcome: AESEV severity (primary)
covid = ae.AEPT.astype(str).str.upper().str.contains('COVID') | \
        ae.AELLT.astype(str).str.upper().str.contains('COVID')
cov = ae[covid].copy()
sev = cov.groupby('USUBJID')['AESEV'].max().fillna(1).astype(int)   # NaN->Mild (all proven non-serious)
sev = sev.reindex(dm.USUBJID, fill_value=0)

# AEHS 9-level sensitivity outcome (0 uninfected; 1..8 = maxAEHS+1)
hsm = cov.groupby('USUBJID')['AEHS'].max().astype(int) + 1
sev9 = hsm.reindex(dm.USUBJID, fill_value=0)

# ----------------------------------------------------------------- covariates
hist = mh[(mh.MHSCAT=='MEDICAL HISTORY') & (mh.MHORRES==2)].copy()
hist['term_norm'] = hist.MHTERM.str.replace(r'^Other:', '', regex=True).str.strip().str.lower()
hist_n = hist.groupby('USUBJID')['term_norm'].nunique()   # distinct normalized terms
hist_n = hist_n.reindex(dm.USUBJID, fill_value=0).astype(int)

freq = dm.patients_seen.map({'1-50':1, '51-100':2, '>100':3}).astype(float)
wh   = dm.work_hours.map({'1-40':1, '41-80':2, '>80':3}).astype(float)
exi  = dm.expect_interact.map({'No':0, 'Yes':1}).astype(float)

assert len(sev)==len(hist_n)==len(freq)==1000
print('n subjects:', len(dm), '| severity dist:', sev.value_counts().sort_index().to_dict())
print('history count dist:', hist_n.value_counts().sort_index().to_dict())
print('freq dist:', freq.value_counts().sort_index().to_dict())

# ----------------------------------------------------------------- fit helper
def fit_ordinal(y, X_df, label):
    y = y.astype(int)
    mod = OrderedModel(y, X_df, distr='logit')
    res = mod.fit(method='bfgs', disp=False, maxiter=500)
    k = X_df.shape[1]
    beta = res.params[:k]
    bse = res.bse[:k]
    ci = res.conf_int().iloc[:k]
    pvals = 2*(1-stats.norm.cdf(np.abs(beta/bse)))
    out = pd.DataFrame({'coef':beta, 'se':bse,
                        'or':np.exp(beta),
                        'or_lo':np.exp(ci.iloc[:,0]), 'or_hi':np.exp(ci.iloc[:,1]),
                        'p':pvals})
    print(f'\n=== {label} ===  (logLik {res.llf:.3f}, converged {res.mle_retvals.get("converged") if hasattr(res,"mle_retvals") else "-"})')
    print(out.round(4).to_string())
    return res, out

dat = pd.DataFrame({'bcg': (dm.TRTGRP=='BCG').astype(int),
                    'hist': hist_n.values.astype(float),
                    'freq': freq.values,
                    'sev': sev.values, 'sev9': sev9.values,
                    'exi': exi.values, 'wh': wh.values})
dat['hist_c'] = dat['hist'] - dat['hist'].mean()
dat['freq_c'] = dat.freq - dat.freq.mean()

X_primary = pd.DataFrame({
    'bcg': dat.bcg,
    'hist_c': dat.hist_c,
    'freq_c': dat.freq_c,
    'bcg_x_hist': dat.bcg*dat.hist_c,
    'bcg_x_freq': dat.bcg*dat.freq_c,
    'hist_x_freq': dat.hist_c*dat.freq_c,
})
res_main, out_main = fit_ordinal(dat.sev, X_primary, 'PRIMARY: AESEV 5-level, all pairwise two-way')

b = res_main.params['bcg']; se = res_main.bse['bcg']
ci = res_main.conf_int().loc['bcg']
p = 2*(1-stats.norm.cdf(abs(b/se)))
print(f'\nHEADLINE OR(BCG) = {np.exp(b):.4f}  (95% CI {np.exp(ci.iloc[0]):.4f}–{np.exp(ci.iloc[1]):.4f}),  p={p:.4f}')
print('at mean hist_count and mean freq (centered=0)')

# OR at freq levels 1 and 3 (bcg coefficient + bcg_x_freq*(f - mean_freq))
mean_freq = dat.freq.mean()
b_ix = res_main.params['bcg_x_freq']
for f in (1,3):
    bf = b + b_ix*(f-mean_freq)
    print(f'OR(BCG) at freq={f} (=pat_seen {f}): {np.exp(bf):.4f}')

# ----------------------------------------------------------------- sensitivity runs
# S1: AEHS 9-level outcome
res_s1, _ = fit_ordinal(dat.sev9, X_primary, 'SENS1: AEHS 9-level outcome, same predictors')

# S2: frequency proxies
for name, f in [('expect_interact','exi'), ('work_hours','wh')]:
    fc = dat[f] - dat[f].mean()
    X2 = pd.DataFrame({'bcg':dat.bcg,'hist_c':dat.hist_c,'freq_c':fc,
                       'bcg_x_hist':dat.bcg*dat.hist_c,'bcg_x_freq':dat.bcg*fc,
                       'hist_x_freq':dat.hist_c*fc})
    res_s2, _ = fit_ordinal(dat.sev, X2, f'SENS2: freq proxy = {name}')

# S3: interaction set without hist_x_freq (only bcg x hist, bcg x freq)
X3 = X_primary[['bcg','hist_c','freq_c','bcg_x_hist','bcg_x_freq']]
res_s3, _ = fit_ordinal(dat.sev, X3, 'SENS3: drop hist_x_freq interaction')

# S4: main-effects only (no interactions) for reference
X4 = X_primary[['bcg','hist_c','freq_c']]
res_s4, _ = fit_ordinal(dat.sev, X4, 'SENS4: main effects only (reference)')

# ----------------------------------------------------------------- PO assumption heuristic
# separate cumulative binary logits; compare bcg/hist/freq coefs across cutpoints
from statsmodels.discrete.discrete_model import Logit
print('\n=== PO stability check: binary cumulative logits, regression coefs per cut ===')
rows=[]
for cut in [1,2,3]:
    yc = (dat.sev > cut).astype(int)
    Xc = X_primary.copy()
    m = Logit(yc, sm.add_constant(Xc)).fit(disp=False)
    rows.append({'cut|higher': f'>{cut}', **m.params[['bcg','hist_c','freq_c']].to_dict()})
print(pd.DataFrame(rows).round(4).to_string(index=False))

# ----------------------------------------------------------------- save evidence
dat.to_csv('analysis_dataset_built.csv', index=False)
report = {
  'headline_OR_BCG': float(np.exp(b)),
  'headline_CI': [float(np.exp(ci.iloc[0])), float(np.exp(ci.iloc[1]))],
  'pvalue': float(p),
  'coef': float(b), 'se': float(se),
  'mean_hist': float(hist_n.mean()), 'mean_freq': float(mean_freq),
  'OR_at_freq1': float(np.exp(b+b_ix*(1-mean_freq))),
  'OR_at_freq3': float(np.exp(b+b_ix*(3-mean_freq))),
  'n': 1000,
}
import json
with open('analysis_report.json','w') as fh:
    json.dump(report, fh, indent=2)
print('\nsaved analysis_report.json and analysis_dataset_built.csv')
