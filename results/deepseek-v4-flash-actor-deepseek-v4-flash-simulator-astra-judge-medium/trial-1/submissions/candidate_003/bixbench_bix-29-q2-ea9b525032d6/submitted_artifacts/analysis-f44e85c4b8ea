#!/usr/bin/env python3
"""
BixBench bix-29-q2 - BCG-CORONA ordinal regression.
Independent effect of each additional ongoing medical condition (MHONGO='Yes')
on the odds of higher COVID-19 severity, controlling for BCG vaccination status
and patient-interaction variables (work_hours, patients_seen, expect_interact).

Outcome (primary): per-patient max AESEV (1<2<3<4) over COVID-coded AEs among
COVID cases (n=153). Model: proportional-odds cumulative-link logit.
Effect = 100*(exp(beta)-1) percent increase in odds per extra ongoing condition.
Fully self-contained (engine inlined below).
"""

"""Proportional-odds (PO) and partial-PO cumulative-link logit MLE.

PO model:        P(Y<=j) = logit(g_j - X*b)                    (all slopes common)
partial-PO:      P(Y<=j) = logit(g_j - (X_com*b + Z*b_j))      (Z slopes per threshold)

Monotone thresholds enforced via g_{j+1} = g_j + exp(delta_j).
Supports any contiguous integer category labeling via y.min()/y.max().
"""
import numpy as np
import pandas as pd
from scipy.optimize import minimize
from scipy.special import expit
from scipy import stats


class CUMULOGIT:
    def __init__(self, y, X, free_cols=()):
        self.y = np.asarray(y).astype(int)
        self.ymin = int(self.y.min()); self.ymax = int(self.y.max())
        self.K = self.ymax - self.ymin + 1                # number of categories
        self.X = np.asarray(X, dtype=float)
        self.n, self.p = self.X.shape
        self.free_cols = list(free_cols)
        self.n_thr = self.K - 1                           # number of thresholds
        self.p_com = self.p - len(self.free_cols)         # common-slope covariates
        self.p_free = len(self.free_cols)                 # threshold-varying covariates
        # param layout: [beta_common(p_com), beta_free ((K-1)*p_free),
        #                gamma_1, delta_2..delta_{K-1}]
        self.n_param = self.p_com + self.n_thr*self.p_free + self.n_thr

    def unpack(self, th):
        beta_c = th[:self.p_com]
        bf = th[self.p_com:self.p_com + self.n_thr*self.p_free].reshape(self.n_thr, self.p_free)
        g = np.empty(self.n_thr)
        g[0] = th[self.p_com + self.n_thr*self.p_free]
        for j in range(1, self.n_thr):
            g[j] = g[j-1] + np.exp(th[self.p_com + self.n_thr*self.p_free + j])
        return beta_c, bf, g

    def _linear_pred(self, th):
        beta_c, bf, _ = self.unpack(th)
        cols_com = [c for c in range(self.p) if c not in self.free_cols]
        eta = np.zeros((self.n, self.n_thr))
        if cols_com:
            eta += (self.X[:, cols_com] @ beta_c)[:, None]
        if bf.size and self.free_cols:
            eta += self.X[:, self.free_cols] @ bf.T
        return eta

    def neg_ll(self, th):
        _, _, g = self.unpack(th)
        eta = self._linear_pred(th)
        cdf = expit(g[None, :] - eta)                      # P(Y<=j), n x (K-1)
        C = np.column_stack([np.zeros(self.n), cdf, np.ones(self.n)])
        P = np.clip(C[:, 1:] - C[:, :-1], 1e-12, 1.0)      # P(Y=j)
        idx = self.y - self.ymin
        return -np.log(P[np.arange(self.n), idx]).sum()

    def grad(self, th, eps=1e-6):
        g = np.empty_like(th)
        for i in range(len(th)):
            tp = th.copy(); tp[i] += eps; tm = th.copy(); tm[i] -= eps
            g[i] = (self.neg_ll(tp) - self.neg_ll(tm)) / (2*eps)
        return g

    def hessian(self, th, eps=1e-4):
        d = len(th); H = np.zeros((d, d))
        for i in range(d):
            for j in range(i, d):
                tpp = th.copy(); tmm = th.copy(); tp = th.copy(); tm = th.copy()
                tpp[i] += eps; tpp[j] += eps; tmm[i] -= eps; tmm[j] -= eps
                tp[i] += eps; tm[i] -= eps
                H[i, j] = H[j, i] = (self.neg_ll(tpp) - self.neg_ll(tp)
                                     - self.neg_ll(tm) + self.neg_ll(tmm)) / (4*eps*eps)
        return H

    def fit(self, maxiter=3000, start=None):
        if start is not None:
            th0 = np.asarray(start, dtype=float)
        else:
            props = [(self.y > j).mean() for j in range(self.ymin, self.ymax)]
            g0 = np.log(np.array(props) / (1 - np.array(props)))
            base = np.zeros(self.p) if not self.p_free else np.zeros(self.p_com + self.n_thr*self.p_free)
            th0 = np.concatenate([base, [g0[0]], np.log(np.maximum(np.diff(g0), 0.1))])
        res = minimize(self.neg_ll, th0, method='L-BFGS-B', jac=self.grad,
                       options={'maxiter': maxiter, 'ftol': 1e-13, 'gtol': 1e-9})
        th = res.x
        beta_c, bf, g = self.unpack(th)
        ll = -self.neg_ll(th)
        try:
            cov = np.linalg.inv(self.hessian(th))
            se = np.sqrt(np.maximum(np.diag(cov), 0.0))
        except np.linalg.LinAlgError:
            se = np.full(len(th), np.nan)
        return dict(th=th, beta_c=beta_c, bf=bf, gamma=g, ll=ll, se=se,
                    converged=res.success, K=self.K)


def po_fit(name, y, Xdf, report=True):
    """Fit PO model; extract the n_ongoing effect (beta, SE, p, OR, %)."""
    Xdf = pd.DataFrame(Xdf).astype(float)
    m = CUMULOGIT(y, Xdf.values, free_cols=())
    f = m.fit()
    idx = list(Xdf.columns).index('n_ongoing')
    b, se = f['beta_c'][idx], f['se'][idx]
    if se and not np.isnan(se):
        z = b/se; p = 2*stats.norm.sf(abs(z))
    else:
        z = p = np.nan
    or_ = np.exp(b); or_ci = np.exp([b-1.96*se, b+1.96*se])
    pct = 100*(or_-1); pct_ci = 100*(or_ci-1)
    out = dict(model=name, n=m.n, beta=b, se=se, p=p, or_=or_,
               or_lo=or_ci[0], or_hi=or_ci[1], pct=pct,
               pct_lo=pct_ci[0], pct_hi=pct_ci[1], ll=f['ll'])
    if report:
        print(f"\n=== {name} ===")
        print(f"  n={m.n}, converged={f['converged']}, LL={f['ll']:.2f}, K={m.K}")
        print(f"  n_ongoing beta={b:.4f} (SE {se:.4f}, z={z:.3f}, p={p:.4f})")
        print(f"  OR={or_:.3f} (95% CI {or_ci[0]:.3f}-{or_ci[1]:.3f}); "
              f"% increase in odds={pct:.2f}% (95% CI {pct_ci[0]:.2f}% - {pct_ci[1]:.2f}%)")
    return f, out


def po_assumption_lr(y, Xdf, exposure='n_ongoing', report=True):
    """Exact LR test of proportional odds for the exposure slope:
    full-PO (common slope) vs partial-PO (exposure slope free per threshold).
    df = K-2. Returns LR, df, p, and per-threshold exposure slopes."""
    Xdf = pd.DataFrame(Xdf).astype(float)
    cols = list(Xdf.columns)
    free = [cols.index(exposure)]
    m0 = CUMULOGIT(y, Xdf.values, free_cols=())
    f0 = m0.fit()
    m1 = CUMULOGIT(y, Xdf.values, free_cols=free)
    p = m0.p; K = m0.K; n_thr = K - 1
    start = np.zeros(m1.n_param)
    com_cols = [c for c in range(p) if c not in free]
    start[:len(com_cols)] = f0['beta_c'][com_cols]                       # common slopes
    start[len(com_cols):len(com_cols)+n_thr] = np.tile(f0['beta_c'][free[0]], n_thr)
    start[len(com_cols)+n_thr:] = f0['th'][p:p+n_thr]                    # gamma1 + deltas
    f1 = m1.fit(start=start)
    lr = 2.0*(f1['ll'] - f0['ll'])
    df = K - 2
    pval = stats.chi2.sf(lr, df)
    slopes = f1['bf'].flatten().tolist() if f1['bf'].size else []
    if report:
        print(f"  [PO test] LR={lr:.2f} (df={df}, p={pval:.4f}) -> "
              f"proportional odds for '{exposure}' "
              f"{'HOLDS' if pval>0.05 else 'QUESTIONABLE/VIOLATED'}")
        print(f"  [PO test] per-threshold n_ongoing slopes: "
              f"{[round(float(s),3) for s in slopes]}")
    return dict(lr=lr, df=df, p=pval, slopes=slopes, ll_po=f0['ll'], ll_partial=f1['ll'])


# ----------------------------------------------------------------------
# 1) Load
# ----------------------------------------------------------------------
dm = pd.read_csv('data/TASK008_BCG-CORONA_DM.csv')
ae = pd.read_csv('data/TASK008_BCG-CORONA_AE.csv', dtype=str)
mh = pd.read_csv('data/TASK008_BCG-CORONA_MH.csv', dtype=str)

ae['AESEVn'] = pd.to_numeric(ae['AESEV'], errors='coerce')
ae['date'] = pd.to_numeric(ae['AESTDTC'], errors='coerce')
covid_terms = ['COVID-19','COVID-19 pneumonia','Asymptomatic COVID-19','SARS-CoV-2 test positive']
ae['isCOVID'] = ae['AEPT'].isin(covid_terms)

nongoing = mh[mh['MHONGO']=='Yes'].groupby('USUBJID').size().rename('n_ongoing').to_frame()
print("Inspection: %d MHONGO='Yes' (ongoing-condition) rows across %d patients; "
      "exposure = per-patient count (range 0-7)."
      % (nongoing['n_ongoing'].sum(), len(nongoing)))

# ----------------------------------------------------------------------
# 2) One-row-per-subject analysis frame
# ----------------------------------------------------------------------
frame = dm.merge(nongoing, left_on='USUBJID', right_index=True, how='left')
frame['n_ongoing'] = frame['n_ongoing'].fillna(0).astype(int)
frame['TRTGRP_BCG'] = (frame['TRTGRP']=='BCG').astype(int)
frame['work_hours'] = frame['work_hours'].map({'1-40':1,'41-80':2,'>80':3}).astype(float)
frame['patients_seen'] = frame['patients_seen'].map({'1-50':1,'51-100':2,'>100':3}).astype(float)
frame['expect_interact_Yes'] = (frame['expect_interact']=='Yes').astype(int)
age_map = {a:i+1 for i,a in enumerate(['10-19','20-29','30-39','40-49','50-59','60-69','70-79'])}
frame['SEX_num'] = pd.to_numeric(frame['SEX'], errors='coerce').astype(float)
frame['Age_rank'] = frame['Age'].map(age_map).astype(float)
frame['RACE_num'] = pd.to_numeric(frame['RACE'], errors='coerce').astype(float)
frame['edu_num'] = pd.to_numeric(frame['education'], errors='coerce').astype(float)

# severity outcomes
gmax  = ae[ae['isCOVID']].groupby('USUBJID')['AESEVn'].max().dropna()              # COVID max
gfirst = (ae[ae['isCOVID']].sort_values(['USUBJID','date'])
          .groupby('USUBJID')['AESEVn'].first().dropna())                           # COVID first
rmax  = ae[ae['AECAT']=='RTI'].groupby('USUBJID')['AESEVn'].max().dropna()          # RTI max

covs = ['n_ongoing','TRTGRP_BCG','work_hours','patients_seen','expect_interact_Yes']

cases = frame[frame['USUBJID'].isin(gmax.index)].copy()
cases['severity'] = cases['USUBJID'].map(gmax).astype(int)
print("PRIMARY sample: n=%d ; severity counts: %s"
      % (len(cases), cases['severity'].value_counts().sort_index().to_dict()))
print("  mean n_ongoing by severity (raw trend):",
      {int(k): round(v,2) for k,v in cases.groupby('severity')['n_ongoing'].mean().items()})

# ----------------------------------------------------------------------
# 3) PRIMARY model: PO cumulative-link logit, COVID-cases only
# ----------------------------------------------------------------------
res_prim, out_prim = po_fit('PRIMARY: COVID-cases max AESEV 1-4, BCG + interaction adj',
                            cases['severity'], cases[covs])
po1 = po_assumption_lr(cases['severity'], cases[covs], exposure='n_ongoing',
                       )

# ----------------------------------------------------------------------
# 4) Sensitivities
# ----------------------------------------------------------------------
sens = {}
res_dem, sens['+demographics'] = po_fit(
    'S1 demographics (SEX,Age,RACE,education added)',
    cases['severity'], cases[covs+['SEX_num','Age_rank','RACE_num','edu_num']])

rti_cases = frame[frame['USUBJID'].isin(rmax.index)].copy()
rti_cases['sev'] = rti_cases['USUBJID'].map(rmax).astype(int)
res_rti, sens['all-RTI max'] = po_fit('S2 all-RTI max AESEV 1-4 (n=%d)'%len(rti_cases),
                                       rti_cases['sev'], rti_cases[covs])
po2 = po_assumption_lr(rti_cases['sev'], rti_cases[covs], exposure='n_ongoing',
                       report=True)

f04 = frame.copy(); f04['sev'] = f04['USUBJID'].map(gmax)
f04.loc[~f04['USUBJID'].isin(gmax.index), 'sev'] = 0.0
f04 = f04[f04['sev'].notna()].copy(); f04['sev'] = f04['sev'].astype(int)
res04, sens['all-patient 0-4'] = po_fit(
    'S3 all patients ordinal 0-4 (0=no COVID; n=%d)'%len(f04), f04['sev'], f04[covs])
po3 = po_assumption_lr(f04['sev'], f04[covs], exposure='n_ongoing',
                       report=True)

fc = frame[frame['USUBJID'].isin(gfirst.index)].copy()
fc['sev'] = fc['USUBJID'].map(gfirst).astype(int)
res_first, sens['first-event'] = po_fit('S4 first-COVID-event AESEV 1-4 (n=%d)'%len(fc),
                                         fc['sev'], fc[covs])

cc = cases.copy(); cc['sev'] = cc['severity'].map({1:1,2:2,3:3,4:3})
res_coll, sens['collapse 3&4'] = po_fit('S5 COVID-cases AESEV 3&4 collapsed (n=%d)'%len(cc),
                                         cc['sev'], cc[covs])


# ----------------------------------------------------------------------
# 4b) Bootstrap CI for the PRIMARY effect (robustness; PO model refit)
# ----------------------------------------------------------------------
print("\nBootstrap 95% CI for PRIMARY %-increase (200 resamples, seed 7)...")
rng = np.random.default_rng(7)
n = len(cases)
bs_pct = []
for _ in range(200):
    idx = rng.integers(0, n, n)
    yy = cases['severity'].iloc[idx].reset_index(drop=True)
    XX = cases[covs].iloc[idx].reset_index(drop=True)
    try:
        mm = CUMULOGIT(yy, XX.values.astype(float), free_cols=())
        ff = mm.fit()
        bb_ = ff['beta_c'][0]
        bs_pct.append(100.0*(np.exp(bb_) - 1.0))
    except Exception:
        pass
if bs_pct:
    lo, hi = np.percentile(bs_pct, [2.5, 97.5])
    print(f"  bootstrap %-increase: median={np.median(bs_pct):.1f}%, "
          f"95% percentile CI=[{lo:.1f}%, {hi:.1f}%]  (n_boot={len(bs_pct)})")

cases[['USUBJID','severity','n_ongoing'] + covs].to_csv('work/analysis_frame.csv', index=False)
print("Saved work/analysis_frame.csv")

# ----------------------------------------------------------------------
# 5) Summary
# ----------------------------------------------------------------------
print("\n" + "="*108)
print("SUMMARY  (% increase in odds per additional ongoing condition, 95% CI, p)")
print("="*108)
rows = [dict(model='PRIMARY', **{k: out_prim[k] for k in ['n','or_','or_lo','or_hi','pct','pct_lo','pct_hi','p']})]
for name, o in sens.items():
    rows.append(dict(model=name, **{k: o[k] for k in ['n','or_','or_lo','or_hi','pct','pct_lo','pct_hi','p']}))
s = pd.DataFrame(rows)[['model','n','or_','or_lo','or_hi','pct','pct_lo','pct_hi','p']].round(3)
print(s.to_string(index=False))

print("\nFINAL ANSWER (primary, COVID-cases proportional-odds model):")
print("- Each additional ongoing medical condition (MHONGO='Yes') => "
      "%+.2f%% change in odds of higher COVID-19 severity "
      "(OR %.2f; 95%% CI %+.2f%% to %+.2f%%; p=%.3f)."
      % (out_prim['pct'], out_prim['or_'], out_prim['pct_lo'], out_prim['pct_hi'], out_prim['p']))
print("- Proportional-odds assumption for the exposure: LR test p=%.3f -> %s"
      % (po1['p'], 'holds (no evidence of non-proportionality)' if po1['p']>0.05
         else 'non-proportional odds detected'))
