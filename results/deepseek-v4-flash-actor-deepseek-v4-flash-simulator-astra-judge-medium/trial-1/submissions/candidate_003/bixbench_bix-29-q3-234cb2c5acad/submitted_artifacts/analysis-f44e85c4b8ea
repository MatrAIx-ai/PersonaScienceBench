#!/usr/bin/env python3
"""TASK008 BCG-CORONA: interaction of BCG status x prior medical history on
COVID-19 severity (ordinal regression controlled for patient interaction).
PRIMARY: PO cumulative logit, outcome = subject max HS(0-7) over COVID-19 AEs
(0 = no COVID AE); predictors BCG, PH binary, BCG:PH, patients_seen (ordinal 1-3).
"""
import pandas as pd, numpy as np, json, warnings
warnings.filterwarnings("ignore")
from statsmodels.miscmodels.ordinal_model import OrderedModel
import statsmodels.api as sm, statsmodels.formula.api as smf
from scipy import stats

DATA = "data"
DM, AE, MH = (f"{DATA}/TASK008_BCG-CORONA_{x}.csv" for x in ("DM", "AE", "MH"))

def to_num(s):
    return pd.to_numeric(s.astype(str).str.replace("N_A", "", regex=False).str.strip(),
                         errors="coerce")

dm = pd.read_csv(DM, encoding="utf-8-sig")
ae = pd.read_csv(AE, encoding="utf-8-sig")
mh = pd.read_csv(MH, encoding="utf-8-sig")

# ---------------- subject-level dataset ----------------
sub = dm.copy()
sub["BCG"] = (sub["TRTGRP"] == "BCG").astype(int)
sub["patients_seen_n"] = sub["patients_seen"].map({"1-50":1,"51-100":2,">100":3}).astype(float)
sub["work_hours_n"] = sub["work_hours"].map({"1-40":1,"41-80":2,">80":3}).astype(float)
sub["expect_interact_n"] = (sub["expect_interact"] == "Yes").astype(int)

med = mh[mh["MHSCAT"] == "MEDICAL HISTORY"].copy()
present = (med["MHORRES"] == 2.0) | med["MHTERM"].str.startswith("Other:", na=False)
sub["hist_count"] = sub["USUBJID"].map(present.groupby(med["USUBJID"]).sum()).fillna(0).astype(int)
sub["PH"] = (sub["hist_count"] > 0).astype(int)
sub["BCGxPH"] = sub["BCG"] * sub["PH"]

cov = ae[ae["AEPT"] == "COVID-19"].copy()
wkcols = [c for c in ae.columns if c.startswith("AEWK")]
cov["wkmax"] = cov[wkcols].apply(lambda r: to_num(r).max(skipna=True), axis=1)
cov["allhs"] = pd.concat([to_num(cov["OnsetHS"]), to_num(cov["AEHS"]), cov["wkmax"]], axis=1).max(axis=1)
cov["aev"] = to_num(cov["AESEV"])
sub["SEV_HS"] = sub["USUBJID"].map(cov.groupby("USUBJID")["allhs"].max()).fillna(0).astype(int)
sub["SEV_AESEV"] = sub["USUBJID"].map(cov.groupby("USUBJID")["aev"].max())
covid_set = set(cov["USUBJID"])

print("=" * 74)
print("DATASET SUMMARY  n =", len(sub))
print("BCG:", int(sub['BCG'].sum()), " Placebo:", int((sub['BCG'] == 0).sum()))
print("prior-history present:", int(sub['PH'].sum()), " (BCG", int(sub.loc[sub.BCG==1,'PH'].sum()),
      "/ Placebo", int(sub.loc[sub.BCG==0,'PH'].sum()), ")")
print("history-count dist:", sub['hist_count'].value_counts().sort_index().to_dict())
print("COVID subjects:", len(covid_set), " COVID x PH=1:", int(((sub.PH==1)&sub.USUBJID.isin(covid_set)).sum()),
      " COVID x PH=0:", int(((sub.PH==0)&sub.USUBJID.isin(covid_set)).sum()))
print("SEV_HS dist:", sub['SEV_HS'].value_counts().sort_index().to_dict())
print("  COVID+ 2x2 by BCG/PH (COVID rates):")
for b in (0,1):
    for p in (0,1):
        m = sub[(sub.BCG==b)&(sub.PH==p)]
        print(f"   BCG={b} PH={p}: n={len(m)} covid={int((m.SEV_HS>0).sum())} ({100*(m.SEV_HS>0).mean():.1f}%)")

# ---------------- helpers ----------------
def fit_ordered(Y, Xdf, n_pos_min=10, maxiter=3000):
    X = Xdf.copy().astype(float)
    Y = pd.Series(Y, index=X.index)
    res = None; mod = None
    try:
        mod = OrderedModel(Y, X, distr="logit")
        res = mod.fit(method="bfgs", disp=False, maxiter=maxiter)
        if not res.mle_retvals.get("converged", True):
            res = mod.fit(method="nm", disp=False, maxiter=60000)
    except Exception:
        # merge sparse top categories and retry
        Yc = Y.copy()
        top = Y.max()
        while not Yc.value_counts().eq(0).all() and Yc[Yc < top].nunique() >= 2:
            pass
        return None, None
    ci = res.conf_int()
    out = {}
    for c in X.columns:
        out[c] = dict(beta=res.params[c], se=res.bse[c], OR=np.exp(res.params[c]),
                      lo=np.exp(ci.loc[c,0]), hi=np.exp(ci.loc[c,1]), p=res.pvalues[c])
    return out, res

def report_table(out, res, title):
    print("-" * 74); print(title)
    if out is None:
        print("  (fit failed / not reported)"); return
    print(f"{'term':<20}{'beta':>9}{'se':>8}{'OR':>10}{' 95% CI':>20}{'p':>11}")
    for c, d in out.items():
        print(f"{c:<20}{d['beta']:>9.4f}{d['se']:>8.4f}{d['OR']:>10.4f} [{d['lo']:.4f},{d['hi']:.4f}]{d['p']:>11.3g}")
    print(f"converged={res.mle_retvals.get('converged','?')} llf={res.llf:.2f}")

def ors(d):
    return f"OR={d['OR']:.4f} (95% CI {d['lo']:.4f}-{d['hi']:.4f}), p={d['p']:.4g}"

Xbase = sub[["BCG","PH","BCGxPH","patients_seen_n"]]
res_map = {}

def fit_flex(Y, Xdf, label):
    """PO cumulative-logit with automatic top-category collapse on failure."""
    for cap in (None, 5, 4, 3):
        Yuse = Y.map(lambda v: min(v, int(cap)) if cap else v)
        try:
            mod = OrderedModel(pd.Series(Yuse, index=Xdf.index), Xdf.astype(float), distr="logit")
            res = mod.fit(method="bfgs", disp=False, maxiter=4000)
            if not res.mle_retvals.get("converged", True):
                res = mod.fit(method="nm", disp=False, maxiter=80000)
            ci = res.conf_int()
            out = {c: dict(beta=res.params[c], se=res.bse[c], OR=np.exp(res.params[c]),
                           lo=np.exp(ci.loc[c,0]), hi=np.exp(ci.loc[c,1]), p=res.pvalues[c])
                   for c in Xdf.columns}
            return out, res, ("cap>=" + str(cap) if cap else "full")
        except Exception:
            continue
    return None, None, "failed"

def bin_int(yb, Xdf):
    d = Xdf.copy(); d["yb"] = yb
    try:
        m = smf.logit("yb ~ BCG + PH + BCGxPH + patients_seen_n", data=d).fit(disp=False, maxiter=300)
        if not m.mle_retvals.get("converged", True):
            return None
        b3, se3 = m.params["BCGxPH"], m.bse["BCGxPH"]
        return dict(b3=b3, se3=se3, OR=np.exp(b3), lo=np.exp(b3-1.96*se3), hi=np.exp(b3+1.96*se3),
                    p=2*(1-stats.norm.cdf(abs(b3/se3))), n_pos=int(yb.sum()), llf=m.llf, n=len(yb))
    except Exception:
        return None

# ---------------- PRIMARY ----------------
print("\n" + "=" * 74)
print("PRIMARY: PO cumulative logit  SEV_HS(0-7) ~ BCG + PH + BCG:PH + patients_seen")
po, resP, cap = fit_flex(sub["SEV_HS"], Xbase, "primary")
report_table(po, resP, f"Primary PO ordinal regression (n=1000, scale-cap={cap})")
inter = po["BCGxPH"]
print("\nINTERACTION ODDS RATIO (primary):", ors(inter))
res_map["primary"] = dict(interaction=inter, bcg=po["BCG"], ph=po["PH"], control=po["patients_seen_n"])

# ---------------- PO ASSUMPTION CHECK (robust: collapsed 4-cat + guarded splits) ----------------
print("\n" + "=" * 74)
print("PROPORTIONAL-ODDS ASSUMPTION CHECK")
SEV3 = sub["SEV_HS"].map(lambda v: min(v, 3))   # 0,1,2,>=3
po3, res3, cap3 = fit_flex(SEV3, Xbase, "sev3")
report_table(po3, res3, f"PO on collapsed 4-category scale (0,1,2,>=3 ; cap={cap3})")
print("  collapsed-scale interaction OR:", ors(po3["BCGxPH"]))
print("  category-level interaction (binary logits, guarded):")
splits = []
for k, name in [(0, "any COVID\n(P>0)"), (1, ">=2"), (2, ">=3")]:
    yb = (SEV3 > k).astype(int)
    r = bin_int(yb, Xbase)
    if r:
        splits.append(r)
        print(f"   P(SEV3>{k}) [=SEV>{k}]: n_pos={r['n_pos']:>3}  OR_BCGxPH={r['OR']:.4f} "
              f"({r['lo']:.4f}-{r['hi']:.4f}) b3={r['b3']:+.4f} p={r['p']:.4g}")
    else:
        print(f"   P(SEV3>{k}): unstable (n_pos={int(yb.sum())}) - split skipped")
if len(splits) >= 2:
    dev_po3 = -2 * res3.llf
    dev_bin = sum(-2 * r["llf"] for r in splits)
    df_b = (len(splits) + 1 - 2) * len(Xbase.columns)
    chi = dev_bin - dev_po3
    pbr = 1 - stats.chi2.cdf(chi, df_b)
    print(f"  Brant-type LR (collapsed scale): dev(PO)={dev_po3:.2f}, sum dev(binary)={dev_bin:.2f}, "
          f"chi2={chi:.2f} df={df_b} p={pbr:.4g}")
    print("  " + ("=> PROPORTIONAL-ODDS ASSUMPTION APPEARS VIOLATED" if pbr < 0.05 else
                  "=> no strong evidence against proportional odds"))
    res_map["po_check"] = dict(chi2=chi, df=df_b, p=pbr)
else:
    print("  Brant-type LR: insufficient stable splits for a global test")
res_map["po_check_cat"] = [dict(SEV_gt=r["n_pos"] > 0, OR=r["OR"], lo=r["lo"], hi=r["hi"], p=r["p"]) for r in splits]

# ---------------- SENSITIVITIES ----------------
print("\n" + "=" * 74)
print("SENSITIVITY RUNS")
sens = {}

c = sub.loc[sub["SEV_HS"] > 0]
oa, ra, capa = fit_flex(c["SEV_HS"], c[["BCG","PH","BCGxPH","patients_seen_n"]], "a")
report_table(oa, ra, f"Sensitivity (a): COVID subjects only, HS 1-{int(c['SEV_HS'].max())} (n={len(c)}, cap={capa})")
sens["a_covid_only"] = dict(interaction=oa["BCGxPH"] if oa else None, n=len(c))
print("  (a)", ors(oa["BCGxPH"]) if oa else "  (a) fit failed")

b = sub.loc[sub["SEV_AESEV"].notna()].copy(); b["SEV_AESEV"] = b["SEV_AESEV"].astype(int)
ob, rb, capb = fit_flex(b["SEV_AESEV"], b[["BCG","PH","BCGxPH","patients_seen_n"]], "b")
report_table(ob, rb, f"Sensitivity (b): max AESEV 1-4, COVID subjects (n={len(b)}, cap={capb})")
sens["b_aesev"] = dict(interaction=ob["BCGxPH"] if ob else None, n=len(b))
print("  (b)", ors(ob["BCGxPH"]) if ob else "  (b) fit failed")

Xc = sub[["BCG","hist_count","patients_seen_n"]].copy()
Xc["BCGx_Hcount"] = sub["BCG"] * sub["hist_count"]
oc, rc, capc = fit_flex(sub["SEV_HS"], Xc, "c")
report_table(oc, rc, "Sensitivity (c): prior history as COUNT")
sens["c_count"] = dict(interaction=oc["BCGx_Hcount"] if oc else None)
print("  (c)", ors(oc["BCGx_Hcount"]) if oc else "  (c) fit failed")

for ctrl in ["expect_interact_n", "work_hours_n"]:
    Xd = sub[["BCG","PH","BCGxPH",ctrl]]
    od, rd, capd = fit_flex(sub["SEV_HS"], Xd, f"d_{ctrl}")
    report_table(od, rd, f"Sensitivity (d): control={ctrl} (cap={capd})")
    sens[f"d_{ctrl}"] = dict(interaction=od["BCGxPH"] if od else None, control=od[ctrl] if od else None)
    print(f"  (d {ctrl}):", ors(od["BCGxPH"]) if od else "  fit failed")

Xe = sub[["BCG","PH","BCGxPH"]]
oe, re, cape = fit_flex(sub["SEV_HS"], Xe, "e")
sens["e_no_control"] = dict(interaction=oe["BCGxPH"] if oe else None)
print("  (e no control):", ors(oe["BCGxPH"]) if oe else "  fit failed")

rti = ae[ae["AECAT"] == "RTI"].copy()
rti["wkmax"] = rti[wkcols].apply(lambda r: to_num(r).max(skipna=True), axis=1)
rti["allhs"] = pd.concat([to_num(rti["OnsetHS"]), to_num(rti["AEHS"]), rti["wkmax"]], axis=1).max(axis=1)
sub["SEV_RTI"] = sub["USUBJID"].map(rti.groupby("USUBJID")["allhs"].max()).fillna(0).astype(int)
of, rf, capf = fit_flex(sub["SEV_RTI"], Xbase, "f")
sens["f_rti_sev"] = dict(interaction=of["BCGxPH"] if of else None)
print(f"  (f severity over all RTI AE rows, n_pos={int((sub['SEV_RTI']>0).sum())}):",
      ors(of["BCGxPH"]) if of else "  fit failed")

res_map["sensitivities"] = sens

# ---------------- COMPACT SUMMARY ----------------
print("\n" + "=" * 74)
print("COMPACT SUMMARY")
print("PRIMARY (PO cumulative logit, n=1000, control=patients_seen):")
print("  Interaction BCG x prior-history OR = %.4f (95%% CI %.4f-%.4f), Wald p = %.4g"
      % (inter["OR"], inter["lo"], inter["hi"], inter["p"]))
print("  Main: BCG OR=%.4f (p=%.3g); prior-history OR=%.4f (p=%.3g); patients_seen OR=%.4f (p=%.3g)"
      % (po["BCG"]["OR"], po["BCG"]["p"], po["PH"]["OR"], po["PH"]["p"],
         po["patients_seen_n"]["OR"], po["patients_seen_n"]["p"]))
pc = res_map.get("po_check", {})
print("  PO Brant-type LR (collapsed scale): chi2=%.2f, df=%d, p=%.4g" % (pc.get("chi2", np.nan), pc.get("df", np.nan), pc.get("p", np.nan)))
print("SENSITIVITY interaction ORs (BCG x PH):")
def g(k):
    v = sens.get(k, {}).get("interaction"); return v["OR"] if v else float("nan")
print("  (a) COVID-only HS 1-7 : %.4f" % g("a_covid_only"))
print("  (b) AESEV 1-4         : %.4f" % g("b_aesev"))
print("  (c) history as count  : %.4f (per condition)" % g("c_count"))
print("  (d) ctrl=expect_interact : %.4f" % g("d_expect_interact_n"))
print("  (d) ctrl=work_hours      : %.4f" % g("d_work_hours_n"))
print("  (e) no control          : %.4f" % g("e_no_control"))
print("  (f) severity over RTI   : %.4f" % g("f_rti_sev"))

with open("/workspace/analysis/results.json", "w") as fh:
    json.dump(res_map, fh, indent=2, default=str)
print("\nsaved /workspace/analysis/results.json")
