#!/usr/bin/env python3
"""
BixBench bix-3-q5: which tissue comparison shows negligible effects?

NormCount sheet = RAW read counts for 30 mice x 3 tissues (90 samples);
library sizes differ markedly (baseline blood median 13.4M vs final blood
18.9M), so counts are normalized (DESeq median-of-ratios size factors)
before testing. Pairing by mouse verified 30/30 from Mapping_statistics.

Per comparison (Final vs Baseline blood, Dentate gyrus vs Baseline blood,
Dentate gyrus vs Final blood):
  - per-gene DE, PAIRED by mouse, on log2(normalized+1): paired t-test
    (vectorized) -> raw p + log2FC; BH padj.
  - DEG = padj<0.05 AND |log2FC|>1 (>=2-fold change).
  - binomial exact test, 5% threshold: H0 proportion(DEG) = 0.05 vs
    Ha > 0.05 (scipy.stats.binomtest, alternative='greater').
    If H0 NOT rejected => fraction of DEGs ~ 5% chance level =>
    NEGLIGIBLE EFFECTS.
"""
import pandas as pd
import numpy as np
from scipy import stats

XLSX = "data/Data_deposition_RNAseq_Paroxetine_2017.xlsx"
ALPHA = 0.05
FC = 1.0

# -------- load & pair --------
ms = pd.read_excel(XLSX, sheet_name="Mapping_statistics", header=0)
nc = pd.read_excel(XLSX, sheet_name="NormCount", header=3)
sample_cols = [c for c in nc.columns[2:92]]
raw = nc[sample_cols].apply(pd.to_numeric, errors="coerce").to_numpy(float)
gene_ids = nc["GeneID"].astype(str).to_numpy()
n_all = raw.shape[0]

ms = ms[["Sample ID", "Tissue", "Code"]].copy()
ms["mouse"] = ms["Sample ID"].str.extract(r"um_mueller_2017_02_\d+_(\d+)_[a-z]+")
pairs = {}
for _, r in ms.iterrows():
    pairs.setdefault(r["mouse"], {})[r["Tissue"]] = r["Code"]
mice = sorted(pairs, key=int)
assert all(len(v) == 3 for v in pairs.values())
print(f"samples={len(sample_cols)} mice={len(mice)} genes={n_all}")

def tissue(m, t):
    return m[:, [sample_cols.index(pairs[x][t]) for x in mice]]

# -------- normalization --------
def sfnorm(r):
    gm = np.exp(np.mean(np.log(np.maximum(r, 1e-10)), axis=1))
    gm = np.where(gm > 0, gm, np.nan)
    return r / np.nanmedian(r / gm[:, None], axis=0)

norm = sfnorm(raw)
norm_cpm = raw / raw.sum(axis=0) * 1e6
norm_med = raw / np.median(raw, axis=0)
TS = ["baseline_blood", "dentate_gyrus", "final_blood"]
LOG = {name: {t: np.log2(tissue(N, t) + 1.0) for t in TS}
       for name, N in [("size_factor", norm), ("cpm", norm_cpm),
                       ("median", norm_med), ("raw", raw)]}

# -------- vectorized tests --------
def tests(A, B, do_wilcoxon=False):
    n = A.shape[1]
    d = A - B
    md = d.mean(axis=1); sd = d.std(axis=1, ddof=1)
    test = (sd > 0) & np.isfinite(A).all(1) & np.isfinite(B).all(1)
    t = md / (sd / np.sqrt(n))
    p = np.where(np.isfinite(t), 2 * stats.t.sf(np.abs(t), df=n - 1), np.nan)
    lfc = md
    mA = A.mean(1); mB = B.mean(1)
    vA = A.var(1, ddof=1); vB = B.var(1, ddof=1)
    se = np.sqrt(vA / n + vB / n)
    tU = (mA - mB) / se
    dfU = (vA / n + vB / n) ** 2 / ((vA / n) ** 2 / (n - 1) + (vB / n) ** 2 / (n - 1))
    pU = np.where(np.isfinite(tU), 2 * stats.t.sf(np.abs(tU), df=dfU), np.nan)
    pW = np.full(A.shape[0], np.nan)
    if do_wilcoxon:
        for g in np.where(test)[0]:
            try:
                pW[g] = stats.wilcoxon(d[g]).pvalue
            except ValueError:
                pass
    return test, p, lfc, pU, pW

def bh_fdr(p):
    ok = ~np.isnan(p); q = np.full_like(p, np.nan)
    pv = p[ok]; o = np.argsort(pv); m = len(pv)
    qv = np.minimum.accumulate((pv[o][::-1] * m / np.arange(m, 0, -1))[::-1])
    qf = np.full(m, np.nan); qf[o] = np.minimum(qv, 1.0); q[ok] = qf
    return q

COMP = [("Final blood vs Baseline blood", "final_blood", "baseline_blood"),
        ("Dentate gyrus vs Baseline blood", "dentate_gyrus", "baseline_blood"),
        ("Dentate gyrus vs Final blood", "dentate_gyrus", "final_blood")]

def deg_count(pvals, lfc, test=None):
    padj = bh_fdr(pvals)
    m = (np.abs(lfc) > FC) & np.isfinite(lfc) & (padj < ALPHA)
    if test is not None:
        m = m & test
    return int(m.sum())

def binom(k, n):
    return stats.binomtest(k, n, 0.05, alternative="greater")

# -------- main --------
print("\n=== MAIN (size-factor norm, paired t-test, DEG=padj<0.05&|log2FC|>1) ===")
store = []
LOGm = LOG["size_factor"]
for name, a, b in COMP:
    test, p, lfc, pU, pW = tests(LOGm[a], LOGm[b], do_wilcoxon=True)
    k_all = deg_count(p, lfc)
    k_test = deg_count(p, lfc, test)
    n_test = int(test.sum())
    bt_all = binom(k_all, n_all); bt_test = binom(k_test, n_test)
    k_w = deg_count(pW, lfc, test)
    k_u = deg_count(pU, lfc)
    up = int((lfc[(np.abs(lfc) > FC) & (bh_fdr(p) < ALPHA)] > 0).sum())
    dn = k_all - up
    store.append(dict(comparison=name, k_deg=k_all, frac_all=100 * k_all / n_all,
                      binom_p_all=bt_all.pvalue, k_test=k_test, n_test=n_test,
                      frac_test=100 * k_test / n_test, binom_p_test=bt_test.pvalue,
                      k_wilc=k_w, k_unpaired=k_u, up=up, down=dn))
    v = "NEGLIGIBLE (not rejected)" if bt_all.pvalue >= ALPHA else "real effects (rejected)"
    print(f"{name:30s} k={k_all:5d}  {100*k_all/n_all:5.2f}%  binomial_p={bt_all.pvalue:.4g}  -> {v}")
    print(f"   testable {k_test}/{n_test} ({100*k_test/n_test:.2f}%, p={bt_test.pvalue:.4g}) | "
          f"wilcoxon k={k_w}, unpaired k={k_u}, up={up} down={dn}")

res = pd.DataFrame(store)
neg = res.sort_values("binom_p_all").iloc[-1]
print("\n==================== ANSWER ====================")
print("Negligible comparison:", neg["comparison"])
print(f"DEGs {neg['k_deg']}/{n_all} = {neg['frac_all']:.2f}% (<= 5% chance level); "
      f"one-sided binomial p = {neg['binom_p_all']:.4g} >= 0.05 -> H0 (5%) not rejected -> "
      f"negligible effects")

# -------- robustness --------
print("\n=== ROBUSTNESS: DEG fraction & binomial p by normalization (all-genes denom) ===")
for nm in ["size_factor", "cpm", "median", "raw"]:
    parts = [nm]
    for name, a, b in COMP:
        test, p, lfc, pU, pW = tests(LOG[nm][a], LOG[nm][b])
        k = deg_count(p, lfc)
        parts.append(f"{name.split(' vs ')[0]}:{k} ({100*k/n_all:.1f}%, p={binom(k, n_all).pvalue:.1g})")
    print(" | ".join(parts))

print("\n=== FC-threshold sweep (size_factor, all-genes) ===")
for fc in [0.5, 0.75, 1.0, 1.25, 1.5]:
    parts = [f"|lfc|>{fc}"]
    for name, a, b in COMP:
        test, p, lfc, pU, pW = tests(LOGm[a], LOGm[b])
        padj = bh_fdr(p)
        k = int((((np.abs(lfc) > fc) & (padj < 0.05) & np.isfinite(lfc))).sum())
        parts.append(f"{name.split(' vs ')[0]}:{100*k/n_all:.1f}%(p={binom(k, n_all).pvalue:.1g})")
    print(" | ".join(parts))

res.to_csv("bix3q5_results.tsv", sep="\t", index=False)
print("\nsaved bix3q5_results.tsv")
