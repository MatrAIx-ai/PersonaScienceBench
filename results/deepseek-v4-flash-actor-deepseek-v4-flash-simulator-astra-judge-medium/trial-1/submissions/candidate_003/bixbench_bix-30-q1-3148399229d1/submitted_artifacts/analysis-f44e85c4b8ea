"""
BIXBench episode bix-30-q1
Percentage of miRNAs with significant differential expression (patient vs control)
BEFORE multiple testing correction.

Data: data/pone.0150501.s002.xls  (OLE2/BIFF8 .xls, sheet 'RAW DATA')
  - Row 0: title; Row 1: sample headers P_1..P_10 (DM1 patients), C_11..C_20 (controls)
  - Rows 2..176: 175 miRNA IDs x 20 samples of RAW qPCR Ct values
  - 'NAN' = undetected / no amplification (22 cells, 0.63%)

Primary line (per approved plan):
  - unpaired two-sided Welch t-test on raw Ct per miRNA
  - NAN handled as Ct = 40 (qPCR detection limit)
  - significance at raw p < 0.05, NO FDR/Bonferroni
  - percentage = (#significant miRNAs) / 175 * 100

Sensitivity checks (reported for transparency only):
  - Mann-Whitney U, NAN->40
  - Welch t-test with pairwise NAN drop
"""
import struct
import numpy as np
from scipy import stats
from scipy.stats import ttest_ind, mannwhitneyu

# ---------------- 1) parse OLE2/CFB -> Workbook stream -> BIFF8 records ----------------
OLE2 = 'data/pone.0150501.s002.xls'

data = open(OLE2, 'rb').read()
assert data[:8] == b'\xd0\xcf\x11\xe0\xa1\xb1\x1a\xe1'
sector = 1 << struct.unpack_from('<H', data, 30)[0]
num_fat = struct.unpack_from('<I', data, 44)[0]
first_dir = struct.unpack_from('<I', data, 48)[0]
mini_cutoff = struct.unpack_from('<I', data, 56)[0]
first_minifat = struct.unpack_from('<I', data, 60)[0]
num_minifat = struct.unpack_from('<I', data, 64)[0]
first_difat = struct.unpack_from('<I', data, 68)[0]
num_difat = struct.unpack_from('<I', data, 72)[0]
difat = list(struct.unpack_from('<109I', data, 76))
nxt = first_difat
for _ in range(num_difat):
    vals = struct.unpack_from('<128I', data, (nxt + 1) * sector)
    difat += [v for v in vals[:127]]
    nxt = vals[127]
    if nxt >= 0xFFFFFFFE:
        break
fat = []
for sec in difat:
    if sec < 0xFFFFFFFC:
        fat += list(struct.unpack_from('<%dI' % (sector // 4), data, (sec + 1) * sector))

def chain(start):
    out, s = [], start
    while s < 0xFFFFFFF8:
        out.append(s)
        s = fat[s]
    return out

def stream_bytes(start, size):
    return b''.join(data[(s + 1) * sector:(s + 2) * sector] for s in chain(start))[:size]

# directory entries
def read_dir():
    entries = []
    for s in chain(first_dir):
        base = (s + 1) * sector
        for e in range(sector // 128):
            off = base + e * 128
            nl = struct.unpack_from('<H', data, off + 64)[0]
            ot = data[off + 66]
            st = struct.unpack_from('<I', data, off + 116)[0]
            sz = struct.unpack_from('<Q', data, off + 120)[0]
            nm = data[off:off + nl - 2].decode('utf-16-le', errors='replace')
            entries.append((nm, ot, st, sz))
    return entries

entries = read_dir()
root = next(e for e in entries if e[1] == 5)
wb_info = next(e for e in entries if e[1] == 2 and e[0] in ('Workbook', 'Book'))
wb = stream_bytes(wb_info[2], wb_info[3])
print('Workbook stream extracted: %d bytes (sheet name: %s)' % (len(wb), 'RAW DATA'))

def records(buf):
    i = 0
    while i + 4 <= len(buf):
        op, ln = struct.unpack_from('<HH', buf, i)
        yield op, buf[i + 4:i + 4 + ln]
        i += 4 + ln

recs = list(records(wb))

# shared string table (SST)
def parse_sst(b):
    total, unique = struct.unpack_from('<II', b, 0)
    ss, off = [], 8
    for _ in range(unique):
        cch, fl = struct.unpack_from('<HB', b, off); off += 3
        if fl & 0x04:
            cext = struct.unpack_from('<I', b, off)[0]; off += 4
        if fl & 0x01:
            s = b[off:off + cch * 2].decode('utf-16-le'); off += cch * 2
        else:
            s = b[off:off + cch].decode('latin-1'); off += cch
        if fl & 0x04:
            cbrst = struct.unpack_from('<H', b, off)[0]; off += 2 + cbrst + cext * 2
        ss.append(s)
    return ss

sst = next(parse_sst(b) for op, b in recs if op == 0x00FC)
sheet_off = next(struct.unpack_from('<I', b, 0)[0] for op, b in recs if op == 0x0085)
cells = {}
for op, b in records(wb[sheet_off:]):
    if op == 0x00FD:  # LABELSST
        r, c, xf, idx = struct.unpack_from('<HHHI', b, 0)
        cells[(r, c)] = sst[idx]
    elif op == 0x0203:  # NUMBER
        r, c, xf = struct.unpack_from('<HHH', b, 0)
        cells[(r, c)] = struct.unpack_from('<d', b, 6)[0]

rs = [r for r, _ in cells]; cs = [c for _, c in cells]
r0, c0 = min(rs), min(cs)
H, W = max(rs) - r0 + 1, max(cs) - c0 + 1
grid = [[""] * W for _ in range(H)]
for (r, c), v in cells.items():
    grid[r - r0][c - c0] = v

# ---------------- 2) assemble data matrix ----------------
samples = grid[1][1:21]
mirnas = [grid[r][0] for r in range(2, 177)]
X = np.array([[grid[r][c] for c in range(1, 21)] for r in range(2, 177)], dtype=object)
Ct = X.astype(float)                     # 'NAN' -> np.nan
pat = np.array([i for i, s in enumerate(samples) if s.startswith('P')])
con = np.array([i for i, s in enumerate(samples) if s.startswith('C')])
print('samples=%d (patients=%d, controls=%d), miRNAs=%d' % (len(samples), len(pat), len(con), len(mirnas)))
print('NAN cells: %d / %d (%.2f%%) across %d miRNAs' % (
    int(np.isnan(Ct).sum()), Ct.size, np.isnan(Ct).mean() * 100,
    int((np.isnan(Ct).sum(axis=1) > 0).sum())))

N_MIR = Ct.shape[0]
Ct40 = np.where(np.isnan(Ct), 40.0, Ct)   # undetected -> detection-limit Ct

# ---------------- 3) PRIMARY: Welch t-test, raw Ct, NAN->40 ----------------
p_welch = np.array([ttest_ind(Ct40[i, pat], Ct40[i, con], equal_var=False).pvalue
                    for i in range(N_MIR)])
sig_welch = p_welch < 0.05
n_sig = int(sig_welch.sum())
denom = N_MIR
pct = n_sig / denom * 100
# Wilson 95% CI for the proportion
z = 1.959963984540054
phat = n_sig / denom
den = 1 + z ** 2 / denom
center = (phat + z ** 2 / (2 * denom)) / den
half = z * np.sqrt(phat * (1 - phat) / denom + z ** 2 / (4 * denom ** 2)) / den
ci_lo, ci_hi = center - half, center + half

print('\n================ PRIMARY (ANSWER) ================')
print('Test: unpaired two-sided Welch t-test on raw Ct, NAN->Ct=40')
print('Numerator (significant, raw p<0.05, unadjusted): %d' % n_sig)
print('Denominator (all assayed miRNAs): %d' % denom)
print('Percentage: %.2f%%' % pct)
print('95%% Wilson CI for proportion: %.2f%% - %.2f%%' % (ci_lo * 100, ci_hi * 100))

# ---------------- 4) SENSITIVITY CHECKS (transparency only) ----------------
p_mw = np.array([mannwhitneyu(Ct40[i, pat], Ct40[i, con], alternative='two-sided').pvalue
                 for i in range(N_MIR)])
p_welch_pair = []
for i in range(N_MIR):
    pp = Ct[i, pat][~np.isnan(Ct[i, pat])]
    cc = Ct[i, con][~np.isnan(Ct[i, con])]
    p_welch_pair.append(np.nan if (len(pp) < 2 or len(cc) < 2)
                        else ttest_ind(pp, cc, equal_var=False).pvalue)
p_welch_pair = np.array(p_welch_pair)
print('\n================ SENSITIVITY (not the answer) ================')
print('Mann-Whitney U (NAN->40):            %.2f%%  (%d/%d)' % (
    (p_mw < 0.05).sum() / denom * 100, int((p_mw < 0.05).sum()), denom))
print('Welch t-test (pairwise NAN drop):    %.2f%%  (%d/%d)' % (
    (p_welch_pair < 0.05).sum() / denom * 100, int((p_welch_pair < 0.05).sum()), denom))

# ---------------- 5) context: direction of the significant hits ----------------
delta = Ct40[:, pat].mean(axis=1) - Ct40[:, con].mean(axis=1)  # patient Ct - control Ct
print('\n================ CONTEXT ================')
print('Significant hits: %d lower-Ct-in-patients (higher expr), %d higher-Ct-in-patients' % (
    int((delta[sig_welch] < 0).sum()), int((delta[sig_welch] > 0).sum())))
print('Median mean(delta Ct) across all 175: %.3f (patient - control)' % np.median(delta))
print('Most significant: %s (p=%.2e)' % (mirnas[np.argmin(p_welch)], p_welch.min()))

# save parsed table + p-values for reproducibility
import pandas as pd
df = pd.DataFrame(Ct40, columns=samples)
df.insert(0, 'miRNA', mirnas)
df['p_welch'] = p_welch
df['sig_welch_p005'] = sig_welch
df['p_mannwhitney'] = p_mw
df.to_csv('work/pone.0150501.s002.parsed.csv', index=False)
print('saved: work/pone.0150501.s002.parsed.csv (%d rows)' % len(df))
