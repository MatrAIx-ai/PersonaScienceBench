#!/usr/bin/env python3
"""
BixBench bix-33-q1 — Which immune cell type has the highest number of
significantly differentially expressed genes after AAV9 mini-dystrophin
treatment?

Primary source (approved): the author-provided Post-vs-Pre per-cell-type DEG
tables in "Supplemental Data File 1 PostvsPre_DEG_tables_ANNOTATED by_cell_type.xlsx".

Definition (approved): a significant DEG = a gene whose p_val_adj < 0.05
(Seurat/BH-adjusted value as reported by the authors); one row = one gene per
sheet (sheets are duplicate-free); no |avg_log2FC| cut; direction recorded as
descriptor only. Count is within the authors' exported gene universe.

Outputs:
  - console report (winner + full 25-type table + top-5)
  - analysis/deg_results.json  (machine-readable full table)
  - analysis/deg_top5.csv     (top-5 summary)
  - analysis/deg_full_table.csv (all 25 cell types)
"""
import openpyxl, json, csv, os

XLSX = "data/Supplemental Data File 1 PostvsPre_DEG_tables_ANNOTATED by_cell_type.xlsx"
OUT_DIR = "analysis"
THRESHOLD = 0.05
THRESHOLD_ALT = 0.01


def analyze_workbook(path):
    wb = openpyxl.load_workbook(path, read_only=True)
    sheets = []
    for name in wb.sheetnames:
        ws = wb[name]
        rows = list(ws.iter_rows(min_row=2, values_only=True))
        n_rows = 0
        sig05 = 0
        sig01 = 0
        up05 = 0
        dn05 = 0
        duplicates = 0
        seen = set()
        for r in rows:
            if not r or r[0] is None:
                continue
            n_rows += 1
            gene = str(r[0])
            if gene in seen:
                duplicates += 1
            seen.add(gene)
            p = r[5] if len(r) > 5 else None
            fc = r[2] if len(r) > 2 else None
            if isinstance(p, (int, float)):
                if p < THRESHOLD:
                    sig05 += 1
                    if isinstance(fc, (int, float)):
                        if fc > 0:
                            up05 += 1
                        elif fc < 0:
                            dn05 += 1
                if p < THRESHOLD_ALT:
                    sig01 += 1
        sheets.append({
            "cell_type": name,
            "rows": n_rows,
            "unique_genes": len(seen),
            "sig_adj_0.05": sig05,
            "sig_adj_0.01": sig01,
            "sig05_up": up05,
            "sig05_down": dn05,
            "duplicate_gene_rows": duplicates,
        })
    wb.close()
    return sheets


def main():
    os.makedirs(OUT_DIR, exist_ok=True)
    sheets = analyze_workbook(XLSX)
    sheets_sorted = sorted(sheets, key=lambda s: -s["sig_adj_0.05"])

    winner = sheets_sorted[0]
    runner_up = sheets_sorted[1]

    print("=" * 78)
    print("POST-vs-PRE DEG count per cell type  (significant = p_val_adj < 0.05)")
    print("=" * 78)
    print(f"{'cell type':<18}{'rows':>6}{'unique':>7}{'adj<0.05':>9}{'adj<0.01':>9}{'up':>5}{'down':>6}")
    for s in sheets_sorted:
        print(f"{s['cell_type']:<18}{s['rows']:>6}{s['unique_genes']:>7}"
              f"{s['sig_adj_0.05']:>9}{s['sig_adj_0.01']:>9}{s['sig05_up']:>5}{s['sig05_down']:>6}")

    print("=" * 78)
    print(f"WINNER (max # significant DEGs, p_val_adj < 0.05): "
          f"{winner['cell_type']} with {winner['sig_adj_0.05']} DEGs "
          f"(runner-up: {runner_up['cell_type']} with {runner_up['sig_adj_0.05']})")
    print("=" * 78)

    # duplicates check across the whole workbook
    total_dup = sum(s["duplicate_gene_rows"] for s in sheets)
    print(f"Duplicate gene rows across all sheets: {total_dup}")
    union = set()
    wb = openpyxl.load_workbook(XLSX, read_only=True)
    for name in wb.sheetnames:
        ws = wb[name]
        for r in ws.iter_rows(min_row=2, values_only=True):
            if r and r[0]:
                union.add(str(r[0]))
    wb.close()
    print(f"Author gene universe (unique genes across all sheets): {len(union)}")

    result = {
        "question": ("Which immune cell type has the highest number of "
                     "significantly differentially expressed genes after "
                     "AAV9 mini-dystrophin treatment?"),
        "method": ("Count genes with p_val_adj<0.05 in each author-provided "
                   "Post-vs-Pre DEG worksheet; one row = one gene; no FC cut."),
        "threshold": THRESHOLD,
        "threshold_alt": THRESHOLD_ALT,
        "winner": winner["cell_type"],
        "winner_sig_deg": winner["sig_adj_0.05"],
        "runner_up": runner_up["cell_type"],
        "runner_up_sig_deg": runner_up["sig_adj_0.05"],
        "author_gene_universe": len(union),
        "sheets": sheets_sorted,
    }

    with open(os.path.join(OUT_DIR, "deg_results.json"), "w") as fh:
        json.dump(result, fh, indent=2)

    with open(os.path.join(OUT_DIR, "deg_top5.csv"), "w", newline="") as fh:
        w = csv.writer(fh)
        w.writerow(["cell_type", "sig_adj_0.05", "sig_adj_0.01", "rows", "unique_genes"])
        for s in sheets_sorted[:5]:
            w.writerow([s["cell_type"], s["sig_adj_0.05"], s["sig_adj_0.01"],
                        s["rows"], s["unique_genes"]])

    with open(os.path.join(OUT_DIR, "deg_full_table.csv"), "w", newline="") as fh:
        w = csv.writer(fh)
        w.writerow(["cell_type", "rows", "unique_genes", "sig_adj_0.05",
                    "sig_adj_0.01", "sig05_up", "sig05_down", "duplicate_gene_rows"])
        for s in sheets_sorted:
            w.writerow([s["cell_type"], s["rows"], s["unique_genes"],
                        s["sig_adj_0.05"], s["sig_adj_0.01"], s["sig05_up"],
                        s["sig05_down"], s["duplicate_gene_rows"]])

    print("\nArtifacts written:")
    print("  analysis/deg_results.json")
    print("  analysis/deg_top5.csv")
    print("  analysis/deg_full_table.csv")
    return result


if __name__ == "__main__":
    res = main()
    print("\nFINAL ANSWER:", res["winner"])
