"""BixBench bix-37-q2 — ENO1 base protein level in normal samples.

Reads data/Proteomic_data .xlsx (sheet 'Tumor vs Normal'),
locates the row for gene == 'ENO1', and reports the 'Normal'
(base protein level in normal samples) rounded to 3 significant figures.
"""
import math
import pandas as pd

PROT_PATH = "data/Proteomic_data .xlsx"
SHEET = "Tumor vs Normal"

df = pd.read_excel(PROT_PATH, sheet_name=SHEET)

eno = df[df["gene"].eq("ENO1")]
assert len(eno) == 1, f"expected exactly 1 ENO1 row, found {len(eno)}"

row = eno.iloc[0]
normal = float(row["Normal"])

print("=== ENO1 row (proteomic data) ===")
print("protein        :", row["protein"])
print("Description    :", row["Description"])
print("gene           :", row["gene"])
print("gene_id        :", row["gene_id"])
print("Normal (raw)   :", repr(normal))
print("Tumor          :", row["Tumor"])
print("Ratio / FC     :", row["Ratio"], "/", row["FC"])
print("log2FC         :", row["log2FC"])
print("p.value        :", row["p.value"])
print("adj.Pval       :", row["adj.Pval"])
print("compare        :", row["compare"])

# Round to 3 significant figures.
digits = int(math.floor(math.log10(abs(normal))))
rounded = round(normal, -digits + (3 - 1))

print("\n=== Base protein level of ENO1 in normal samples ===")
print("Normal value          :", normal)
print("Rounded (3 sig figs)  :", rounded)
print("Scientific notation   : {:.2e}".format(rounded))
print("Standard notation     : {:,}".format(int(rounded)))
