#!/usr/bin/env python3
"""
Analysis: skewness of the distribution of RNA expression data (BixBench bix-42-q2).

Input : data/COAD__geneExp.xls (tab-delimited; GeneSymbol rows x sample columns)
Output: printed summary of pooled and gene-wise skewness on raw and log2 scales.

Categorization rule (as locked in):
    |skew| <= 0.5                      -> approximately normal
    0.5 <  |skew| <= 1.0               -> minimally right/left skewed
    |skew| >  1.0                      -> highly right/left skewed   (sign -> direction)
"""
import numpy as np
import pandas as pd
from scipy import stats

INPUT = 'data/COAD__geneExp.xls'

expr = pd.read_csv(INPUT, sep='\t')
n_genes, n_samples = expr.shape[0], expr.shape[1] - 1
mat = expr.iloc[:, 1:].astype(float)
vals = mat.values.ravel()

assert np.isnan(vals).sum() == 0, "unexpected missing values"
assert np.isfinite(vals).all(), "non-finite values present"

def classify(sk):
    a = abs(sk)
    if a <= 0.5:
        return "approximately normal"
    side = "right" if sk > 0 else "left"
    return f"{'minimally' if a <= 1.0 else 'highly'} {side} skewed"

print("=" * 78)
print("RNA expression file structure")
print("=" * 78)
print(f"Dimensions          : {expr.shape}  ({n_genes} genes x {n_samples} samples)")
print(f"Genes in rows?      : yes (first col = {expr.columns[0]})")
print(f"Samples in cols?    : yes (e.g., {expr.columns[1]})")
print(f"Missing values      : {int(np.isnan(vals).sum())}")
print(f"Non-numeric entries : {int((~np.isfinite(vals)).sum())}")

print()
print("=" * 78)
print("Distribution / skewness summary (pooled over all genes x all samples)")
print("=" * 78)
rng = np.percentile(vals, [0, 1, 5, 25, 50, 75, 95, 99, 100])
print(f"Raw scale            : min={vals.min():.3g} max={vals.max():.3g} | zero frac={100*(vals==0).mean():.2f}%")
print(f"                      percentiles(0,25,50,75,100)={np.percentile(vals,[0,25,50,75,100])}")
print(f"                      mean={vals.mean():.2f}  median={np.median(vals):.2f}")

for name, v in [
        ("RAW (as supplied)          ", vals),
        ("log2(x+1) pooled           ", np.log2(vals + 1)),
        ("log2(x), zeros excluded    ", np.log2(vals[vals > 0])),
]:
    sk = stats.skew(v)
    print(f"  {name}: skew={sk:+.3f}  kurtosis={stats.kurtosis(v):+.2f}  -> {classify(sk)}")

print()
print("=" * 78)
print("Corroboration: gene-wise skewness (per-gene across samples)")
print("=" * 78)
sk_raw = mat.apply(lambda s: stats.skew(s.values), axis=1)
sk_l2 = np.log2(mat + 1).apply(lambda s: stats.skew(s.values), axis=1)
print(f"  raw    : median={sk_raw.median():+.2f}  q25={sk_raw.quantile(.25):+.2f} q75={sk_raw.quantile(.75):+.2f}  "
      f"frac right-skewed={100*(sk_raw>0).mean():.1f}%")
print(f"  log2+1 : median={sk_l2.median():+.2f}  q25={sk_l2.quantile(.25):+.2f} q75={sk_l2.quantile(.75):+.2f}  "
      f"frac right-skewed={100*(sk_l2>0).mean():.1f}%")

print()
print("=" * 78)
print("CONCLUSION")
print("=" * 78)
print(f"Pooled skewness of the RNA expression distribution on the RAW (as-supplied) scale")
print(f"  = {stats.skew(vals):+.3f}  ->  {classify(stats.skew(vals))}.")
