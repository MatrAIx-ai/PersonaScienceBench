#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
BixBench bix-43-q2 - offline analysis
CBD/cisplatin (G9) vs DMSO (G3): DESeq2-equivalent DE + Enrichr-style Fisher OR
for Reactome_2022 term "p53-mediated cell cycle gene regulation".

This runtime has NO internet, NO R/DESeq2, NO gseapy, NO local Reactome_2022 GMT.
DESeq2 and Enrichr are reproduced offline in pure Python. Gene-set membership and
background N for the Enrichr Reactome_2022 library are RECONSTRUCTED (assumption).
"""
import numpy as np
import pandas as pd
from scipy.special import gammaln, digamma
from scipy.stats import norm, hypergeom
from scipy.optimize import minimize_scalar
import warnings, json, time
warnings.filterwarnings('ignore')
t0 = time.time()

# ---------------- 1) Load & align ----------------
cnt = pd.read_csv('data/counts_raw_unfiltered.csv', index_col=0)
lay = pd.read_csv('data/sample_layout.csv')
lay['col'] = lay['SampleID'].astype(str).str.replace('-', '_', n=1)
assert list(cnt.columns) == list(lay['col'])
cnt.columns = lay['col']
groups = ['Untreated','Serum_starvation','DMSO','DMSO_Serum_starvation',
          'Cisplatin_IC50','Cisplatin_IC50_Serum_starvation_16h',
          'CBD_IC50','CBD_IC50_Serum_starvation_16h',
          'Cisplatin_IC50_CBD_IC50','Cisplatin_IC50_CBD_IC50_Serum_starvation_16h']
grp_map = dict(lay[['col','Group']].values)
samp_cols = [c for c in cnt.columns if '_' in c]
K = cnt[samp_cols].astype(int).values.T
genes = cnt.index.values
samples = [grp_map[c] for c in samp_cols]
G = K.shape[0]
print(f"[1] {cnt.shape[0]} genes x {G} samples; {len(groups)} groups")

ref, combo = 'DMSO', 'Cisplatin_IC50_CBD_IC50'
level_order = [ref] + [g for g in groups if g != ref]
X = np.zeros((G, len(level_order)))
for j, g in enumerate(samples):
    X[j, level_order.index(g)] = 1.0
combo_idx = level_order.index(combo)
print(f"    design cols: {level_order}; contrast {combo} vs {ref}")

# ---------------- 2) DESeq2-equivalent size factors ----------------
Kf = K.astype(float)
import os
SUBSET = int(os.environ.get('SUBSET','0'))
if SUBSET:
    Kf = Kf[:, :SUBSET]
    genes = genes[:SUBSET]
allpos = Kf.min(axis=0) > 0
Kpos = Kf[:, allpos]
loggeo = np.mean(np.log(Kpos), axis=0)
ratios = np.log(Kpos) - loggeo[None, :]
sf = np.exp(np.median(ratios, axis=1))
sf = sf / np.exp(np.mean(np.log(sf)))
nrm = Kf / sf[:, None]
baseMean = nrm.mean(axis=0)
print(f"[2] size factors min={sf.min():.3f} max={sf.max():.3f} mean={sf.mean():.3f}")

offs = np.log(sf)
def glm_mu(Kj, alpha=0.0, max_iter=50, tol=1e-8):
    XtX0 = X.T @ X; np.fill_diagonal(XtX0, np.diag(XtX0) + 1e-4)
    beta = np.linalg.solve(XtX0, X.T @ np.log(Kj + 0.1))
    for it in range(max_iter):
        eta = X @ beta + offs
        mu = np.exp(np.clip(eta, -18, 18))
        w = mu / (1.0 + alpha*mu)
        W = X * w[:, None]
        XtWX = W.T @ X
        d = np.diag(XtWX)
        XtWX[np.diag_indices_from(XtWX)] = d + np.clip(1e-6 * d.max() + 1e-8, 1e-8, 1e6)
        score = X.T @ (Kj - mu)
        try:
            step = np.linalg.solve(XtWX, score)
        except np.linalg.LinAlgError:
            break
        step = np.clip(step, -5, 5)          # dampen per-iteration beta moves
        beta = beta + step
        beta = np.clip(beta, -40, 40)
        if np.max(np.abs(step)) < tol:
            break
    eta = np.clip(X @ beta + offs, -18, 18)
    mu = np.exp(eta)
    return beta, mu

# ---------------- 3) NB log-likelihood helpers ----------------
def nb_loglik(Kj, mu, log_alpha):
    alpha = np.exp(log_alpha); t = 1.0/alpha; m = mu + t
    return (Kj*np.log(mu/m) + t*np.log(t/m) + gammaln(Kj+t) - gammaln(t) - gammaln(Kj+1))

def dL_dl(Kj, mu, log_alpha):
    alpha = np.exp(log_alpha); t = 1.0/alpha; m = mu + t
    dL_dt = -(Kj+t)/m + (np.log(t)+1) - np.log(m) + digamma(Kj+t) - digamma(t)
    return -t * dL_dt

def d2L_dl2(Kj, mu, log_alpha):
    h = 1e-4
    return (dL_dl(Kj, mu, log_alpha+h) - dL_dl(Kj, mu, log_alpha-h)) / (2*h)

# ---------------- 4) initial mu, gene-wise dispersion MLE ----------------
mu_init = np.zeros_like(Kf)
for i in range(Kf.shape[1]):
    _, mu_init[:, i] = glm_mu(Kf[:, i], alpha=0.0)
mu_init = np.clip(mu_init, 1e-3, None)
print(f"[4] initial design-based mu fitted ({time.time()-t0:.1f}s)")

alpha_mle = np.zeros(Kf.shape[1])
for i in range(Kf.shape[1]):
    Kj, muj = Kf[:, i], mu_init[:, i]
    f = lambda l: -nb_loglik(Kj, muj, l).sum()
    res = minimize_scalar(f, bounds=(-18, 4), method='bounded', options={'xatol':1e-4})
    alpha_mle[i] = np.exp(res.x)
print(f"    gene-wise disp median alpha={np.median(alpha_mle):.4g} ({time.time()-t0:.1f}s)")

# ---------------- 5) trend + MAP dispersion ----------------
from statsmodels.nonparametric.smoothers_lowess import lowess
mb = np.clip(baseMean, 1e-3, None)
good = np.isfinite(alpha_mle) & (alpha_mle > 0) & (mb > 0)
lo_rep = np.where(alpha_mle < 1e-4, 1e-4, alpha_mle)
lmb = np.log(mb[good]); ld = np.log(lo_rep[good])
order = np.argsort(lmb); xs = lmb[order]; ys = np.log(lo_rep[good])[order]
ys_c = np.clip(ys, np.percentile(ys,1), np.percentile(ys,99))
sm = lowess(ys_c, xs, frac=0.4, it=3, return_sorted=False)
trend_ld = np.interp(np.log(mb), xs, sm)
trend_alpha = np.exp(trend_ld)
resid = np.log(lo_rep) - trend_ld
m = good & (alpha_mle >= 1e-4)
disp_prior_var = float(np.clip(np.var(resid[m]), 1e-8, 10))
print(f"[5] dispersion prior var = {disp_prior_var:.2g}")

def map_alpha(Kj, muj, trend_a, pv):
    tol = np.log(trend_a)
    if pv <= 1e-8:
        return trend_a
    g = lambda l: -nb_loglik(Kj, muj, l).sum() + 0.5*((l-tol)**2)/pv
    res = minimize_scalar(g, bounds=(-18, 4), method='bounded', options={'xatol':1e-4})
    return np.exp(res.x)

alpha_map = np.zeros(Kf.shape[1])
for i in range(Kf.shape[1]):
    alpha_map[i] = map_alpha(Kf[:, i], mu_init[:, i], trend_alpha[i], disp_prior_var)
print(f"    MAP disp median={np.median(alpha_map):.4g} ({time.time()-t0:.1f}s)")

# ---------------- 6) final GLM, Wald ---------------
pval = np.full(Kf.shape[1], np.nan); bc = np.full(Kf.shape[1], np.nan)
bcse = np.full(Kf.shape[1], np.nan)
for i in range(Kf.shape[1]):
    a = max(alpha_map[i], 1e-8)
    beta, mu = glm_mu(Kf[:, i], alpha=a)
    w = mu / (1.0 + a*mu)
    W = X * w[:, None]
    XtWX = W.T @ X
    d = np.diag(XtWX)
    XtWX[np.diag_indices_from(XtWX)] = d + np.clip(1e-6 * d.max() + 1e-8, 1e-8, 1e6)
    try:
        cov = np.linalg.pinv(XtWX)
    except np.linalg.LinAlgError:
        cov = np.linalg.pinv(XtWX + 1e-3*np.eye(X.shape[1]))
    se = np.sqrt(np.clip(np.diag(cov), 0, 1e6))
    ref_idx = 0
    bd = beta[combo_idx] - beta[ref_idx]              # cell-means: contrast coeff
    sd = np.sqrt(se[combo_idx]**2 + se[ref_idx]**2)   # block-orthogonal -> cov=0
    b = bd/np.log(2.0); s = sd/np.log(2.0)
    if s > 0:
        bc[i] = b; bcse[i] = s
        pval[i] = 2.0*norm.sf(np.abs(b/s))
print(f"[6] Wald done ({time.time()-t0:.1f}s); finite p: {np.isfinite(pval).sum()}")

# ---------------- 7) DEG table + symbol mapping ----------------
res = pd.DataFrame({'ENSG': genes, 'baseMean': baseMean,
                    'log2FoldChange': bc, 'lfcSE': bcse, 'pvalue': pval})
res = res[np.isfinite(res['pvalue'])]
res.to_csv('DESeq2_allgenes.csv', index=False)
deg = res[(res['pvalue'] < 0.05) & (res['log2FoldChange'].abs() > 0.5) & (res['baseMean'] > 10)].copy()
print(f"[7] DEGs p<.05,|lfc|>.5,bm>10: n={len(deg)}  up={(deg.log2FoldChange>0.5).sum()}  down={(deg.log2FoldChange<-.5).sum()}")

mapdf = pd.read_csv('data/ensg_to_gene_name.tsv', sep='\t')
deg = deg.merge(mapdf, on='ENSG', how='left')
n_unmap = deg['gene_name'].isna().sum()
deg = deg.dropna(subset=['gene_name'])
deg = deg.sort_values('baseMean', ascending=False).drop_duplicates('gene_name', keep='first')
deg.to_csv('DEG_table.csv', index=False)
sig_genes = set(deg['gene_name'])
print(f"    unmapped dropped={n_unmap}; final DEG symbols={len(sig_genes)}")

# ---------------- 8) Enrichment: Enrichr/gseapy-style Fisher OR ----------
term = 'p53-mediated cell cycle gene regulation'
recon_set = ['AURKA','BIRC5','CCNB1','CCNB2','CDKN1A','GADD45A','PLK1','SFN','TOP2A']
recon_tp53 = recon_set + ['TP53']
N_recon = 10500

def fisher_or(deg_set, gset, N):
    a = len(deg_set & set(gset)); ss = len(set(gset)); inp = len(deg_set)
    b = ss - a; c = inp - a; d = N - ss - inp + a
    if b == 0 or c == 0 or d <= 0:
        return None, (a,b,c,d)
    return (a*d)/(b*c), (a,b,c,d)

for nm, gs in [('reconstructed n=9', recon_set), ('reconstructed+TP53 n=10', recon_tp53)]:
    OR, (a,b,c,d) = fisher_or(sig_genes, gs, N_recon)
    ctx_p = hypergeom.sf(a-1, N_recon, len(set(gs)), len(sig_genes))
    print(f"\n[8] term '{term}'  [{nm}]  set={len(set(gs))} input={len(sig_genes)} a={a}")
    print(f"    2x2: a={a} b={b} | c={c} d={d} | N={N_recon}")
    print(f"    OR=(a*d)/(b*c)=({a}*{d})/({b}*{c}) = {OR if OR is None else round(OR,4)}")
    print(f"    context hypergeom p = {ctx_p:.3g}")
    print("    OR vs N:", {Nv: round(fisher_or(sig_genes, gs, Nv)[0],2) for Nv in [9000,10000,10500,11000,12000]})

# ---------------- 9) final ----------------
ORp, abcd = fisher_or(sig_genes, recon_set, N_recon)
print("\n=== FINAL ===")
print(f"DEG symbols: {len(sig_genes)}")
print(f"recon set (n={len(recon_set)}): {recon_set}")
print(f"N={N_recon}  2x2={abcd}  OR={round(ORp,4)}")
json.dump({'DEG_count': len(sig_genes), 'term': term, 'recon_set': recon_set,
           'N': N_recon, 'a': abcd[0], 'b': abcd[1], 'c': abcd[2], 'd': abcd[3],
           'odds_ratio': round(ORp,4)}, open('result.json','w'), indent=2)
print(f"[done {time.time()-t0:.1f}s]")
