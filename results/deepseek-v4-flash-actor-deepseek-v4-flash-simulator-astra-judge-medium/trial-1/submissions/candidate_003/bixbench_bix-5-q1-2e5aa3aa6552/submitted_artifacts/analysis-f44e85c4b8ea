                 sep=r"\s+")
cd = pd.read_excel(f"{DATA}/Issy_ASXL1_fibro_coldata_gender.xlsx")

annot_samples = list(cd["sample"])
counts = fc[["Geneid"] + annot_samples].copy()
counts[annot_samples] = counts[annot_samples].astype(int)
counts = counts.set_index("Geneid")

design = pd.DataFrame({
    "sexM":   (cd["sex"] == "M").astype(int).values,
    "disease": (cd["condition"] == "disease").astype(int).values,
}, index=annot_samples)
X = np.column_stack([np.ones(len(annot_samples)), design["sexM"], design["disease"]])
p = X.shape[1]
n_samp = len(annot_samples)
df_resid = n_samp - p

print("=" * 78)
print("STEP 0 | inputs")
print("  featureCounts rows/cols:", fc.shape, "| samples:", len(annot_samples))
print("  coldata: disease=%d control=%d, sex %s, NA=%d"
      % ((cd.condition=="disease").sum(), (cd.condition=="control").sum(),
         dict(cd.sex.value_counts()), int(cd.isna().sum().sum())))

# ----------------------------------------------------------------------------
# 2. Prefilter
# ----------------------------------------------------------------------------
keep = counts.sum(axis=1) >= 10
cnt = counts.loc[keep]
print("\nSTEP 1 | prefilter (rowSum >= 10 over 14 samples):")
print("  genes before:", counts.shape[0], "| after:", cnt.shape[0])

# ----------------------------------------------------------------------------
# 3. Median-of-ratios size factors (DESeq2)
# ----------------------------------------------------------------------------
def median_of_ratios_size_factors(mat):
    gm = np.exp(np.nanmean(np.where(mat > 0, np.log(mat), np.nan), axis=1))
    valid = np.isfinite(gm) & (gm > 0)
    ratios = np.where(valid[:, None], mat[valid] / gm[valid, None], np.nan)
    sf = np.nanmedian(ratios, axis=0)
    sf = sf / np.exp(np.mean(np.log(sf)))
    return sf

mat = cnt.to_numpy().astype(float)
sf = median_of_ratios_size_factors(mat)
print("\nSTEP 2 | size factors (median-of-ratios, centered):")
print("  ", dict(zip(annot_samples, np.round(sf, 3))))

# ----------------------------------------------------------------------------
# 4. NB-GLM helper functions
# ----------------------------------------------------------------------------
def nb_loglik(y, mu, phi):
    inv = 1.0 / np.maximum(phi, 1e-12)
    ll = (np.where(y > 0, gammaln(y + inv), 0.0) - gammaln(inv) - gammaln(y + 1)
          + y * np.log(np.maximum(phi * mu, 1e-300))
          - (y + inv) * np.log1p(np.maximum(phi * mu, 1e-300)))
    return np.sum(ll)

def irls_beta(y, off, phi, X, beta0, iters=30, tol=1e-7):
    beta = beta0.copy().astype(float)
    last_beta = beta.copy()
    for _ in range(iters):
        eta = np.clip(X @ beta + off, -30.0, 30.0)
        mu = np.clip(np.exp(eta), 1e-10, 1e12)
        w = mu / (1.0 + phi * mu)
        w = np.clip(w, 1e-12, 1e12)
        z = np.clip(eta - off + (y - mu) / np.maximum(mu, 1e-10), -50.0, 50.0)
        Xw = X * np.sqrt(w)[:, None]
        zw = z * np.sqrt(w)
        if not (np.all(np.isfinite(Xw)) and np.all(np.isfinite(zw))):
            break
        try:
            beta_new, *_ = np.linalg.lstsq(Xw, zw, rcond=None)
        except np.linalg.LinAlgError:
            break
        if not np.all(np.isfinite(beta_new)):
            break
        if np.max(np.abs(beta_new - beta)) < tol:
            beta = beta_new; break
        beta = beta_new
    eta = np.clip(X @ beta + off, -30.0, 30.0)
    mu = np.clip(np.exp(eta), 1e-10, 1e12)
    return beta, mu

def cr_adjusted_disp(y, mu, X, lo=-18.0, hi=10.0, tol=1e-4):
    """Fast golden-section minimization over log(phi) of the Cox-Reid adjusted
    NB profile log-likelihood (DESeq2 gene-wise dispersion). Vectorized numpy."""
    yf = y.astype(float)
    logY1 = gammaln(yf + 1.0)
    GR = (1.0 + np.sqrt(5.0)) / 2.0

    def profile(logphi):
        phi = np.exp(float(logphi))
        inv = 1.0 / phi
        # negative profile log-likelihood (CR-adjusted)
        ll = (gammaln(yf + inv) - gammaln(inv) - logY1
              + yf * np.log(np.maximum(phi * mu, 1e-300))
              - (yf + inv) * np.log1p(np.maximum(phi * mu, 1e-300)))
        w = np.clip(mu / (1.0 + phi * mu), 1e-12, 1e12)
        Xw = X * np.sqrt(w)[:, None]
        R = np.linalg.qr(Xw, mode="r")
        d = np.clip(np.abs(np.diag(R)), 1e-15, None)
        ldet = 2.0 * np.sum(np.log(d))
        return -(np.sum(ll) - 0.5 * ldet)

    a, b = lo, hi
    c = b - (b - a) / GR
    d = a + (b - a) / GR
    fc, fd = profile(c), profile(d)
    while abs(b - a) > tol:
        if fc < fd:
            b, fd = d, fc
            d = c
            c = b - (b - a) / GR
            fc = profile(c)
        else:
            a, fc = c, fd
            c = d
            d = a + (b - a) / GR
            fd = profile(d)
    return np.exp((a + b) / 2.0)

# ----------------------------------------------------------------------------
# 5. Per-gene NB-GLM fit: genewise dispersion + beta (MLE, CR-adjusted)
# ----------------------------------------------------------------------------
off = np.log(sf)
gene_ids = cnt.index.to_numpy()
Y = cnt.to_numpy().astype(float)

beta_disease_gw = np.full(len(gene_ids), np.nan)
se_disease_gw   = np.full(len(gene_ids), np.nan)
phi_gw          = np.full(len(gene_ids), np.nan)
mean_expr       = np.full(len(gene_ids), np.nan)
beta_matrix     = np.full((len(gene_ids), p), np.nan)

for i in range(len(gene_ids)):
    y = Y[i]
    # 1) Poisson GLM fit -> provisional means
    beta0, mu = irls_beta(y, off, 1e-8, X, np.zeros(p))
    # 2) gene-wise dispersion: CR-adjusted NB MLE given the fitted means (DESeq2-style)
    phi = cr_adjusted_disp(y, mu, X)
    # 3) refit mean model under NB to get a stable beta0 for the final pass
    beta1, mu1 = irls_beta(y, off, phi, X, beta0)
    w = mu1 / (1.0 + phi * mu1)
    w = np.clip(w, 1e-12, 1e12)
    Xw = X * np.sqrt(w)[:, None]
    covb = np.linalg.pinv(Xw.T @ Xw)
    se = np.sqrt(np.diag(covb))
    beta_disease_gw[i] = beta1[2]
    se_disease_gw[i]   = se[2]
    phi_gw[i]          = phi
    mean_expr[i]       = np.exp(np.mean(np.log(np.maximum(mu1 / sf, 1e-12))))
    beta_matrix[i]     = beta1
    if (i + 1) % 8000 == 0:
        print("   ...fitted %d/%d genes" % (i + 1, len(gene_ids)), flush=True)
print("\nSTEP 3 | per-gene NB-GLM (CR-adjusted dispersion MLE + Wald):")
print("  genes fitted:", int(np.isfinite(beta_disease_gw).sum()))

# ----------------------------------------------------------------------------
# 6. Empirical-Bayes shrinkage of dispersions toward a mean-trend
# ----------------------------------------------------------------------------
ok = np.isfinite(phi_gw) & (phi_gw > 1e-8) & np.isfinite(mean_expr) & (mean_expr > 0)
logphi = np.log(phi_gw[ok]); logm = np.log(mean_expr[ok])
nbins = 30
bin_edge = np.linspace(logm.min(), logm.max(), nbins + 1)
bx = []; by = []
for b in range(nbins):
    m = (logm >= bin_edge[b]) & (logm < bin_edge[b + 1])
    if m.sum() >= 3:
        bx.append(np.median(logm[m])); by.append(np.median(logphi[m]))
bx = np.array(bx); by = np.array(by)
trend_par = np.polyfit(bx, by, 2) if len(bx) >= 3 else np.polyfit(bx, by, 1)
logphi_trend = np.polyval(trend_par, logm)

s2 = 2.0 / df_resid                       # approx sampling variance of log(phi_gw)
tau2 = max(0.0, float(np.mean((logphi - logphi_trend) ** 2) - s2))
if tau2 <= 0:
    tau2 = 1e-6
logphi_final = (logphi_trend / tau2 + logphi / s2) / (1.0 / tau2 + 1.0 / s2)
phi_final = np.full(len(gene_ids), np.nan)
phi_final[ok] = np.exp(logphi_final)
trend_fill = np.polyval(trend_par, np.log(np.maximum(mean_expr[~ok], 1e-12)))
phi_final[~ok] = np.exp(np.clip(trend_fill, -18, 10))
phi_final = np.clip(phi_final, 1e-8, None)
print("  empirical-Bayes shrinkage: tau2 = %.4g (prior variance)" % tau2)

# ----------------------------------------------------------------------------
# 7. Final fit with shrunken dispersion -> Wald test + BH
# ----------------------------------------------------------------------------
beta_f = np.full((len(gene_ids), p), np.nan)
se_f   = np.full((len(gene_ids), p), np.nan)
for i in range(len(gene_ids)):
    y = Y[i]
    beta0, mu = irls_beta(y, off, phi_final[i], X, beta_matrix[i])
    w = mu / (1.0 + phi_final[i] * mu)
    Xw = X * np.sqrt(w)[:, None]
    covb = np.linalg.pinv(Xw.T @ Xw)
    beta_f[i] = beta0
    se_f[i] = np.sqrt(np.diag(covb))

lfc = beta_f[:, 2] / np.log(2.0)
se_lfc = se_f[:, 2] / np.log(2.0)
z = lfc / se_lfc
pval = 2.0 * stats.norm.sf(np.abs(z))
mask = np.isfinite(pval) & (pval > 0) & (pval < 1)
padj = np.full(len(pval), np.nan)
padj[mask] = stats.false_discovery_control(pval[mask], method="bh")

res = pd.DataFrame({
    "gene_id": gene_ids, "baseMean": mean_expr, "log2FoldChange": lfc,
    "lfcSE": se_lfc, "stat": z, "pvalue": pval, "padj": padj,
    "dispersion": phi_final,
})
res = res.sort_values("padj").reset_index(drop=True)

sig = (res["padj"] < 0.05) & np.isfinite(res["padj"])
n_up = int(((sig) & (res["log2FoldChange"] > 0)).sum())
n_dn = int(((sig) & (res["log2FoldChange"] < 0)).sum())
print("\nSTEP 4 | DE results (|log2FC| threshold = 0, padj<0.05, BH):")
print("  significant DE genes: %d   (UP in disease: %d | DOWN: %d)" % (sig.sum(), n_up, n_dn))

res.to_csv(f"{OUT}/DE_results_full.csv", index=False)

genc = pd.read_csv(f"{DATA}/gencode.v31.primary_assembly.genes.csv",
                   dtype={"hgnc_id": str})
g_gene = genc[genc["type"] == "gene"][["gene_id", "gene_name", "gene_type", "hgnc_id"]]
res_ann = res.merge(g_gene, on="gene_id", how="left")
res_ann["Direction"] = np.where(res_ann["log2FoldChange"] > 0, "UP",
                                np.where(res_ann["log2FoldChange"] < 0, "DOWN", "NA"))
res_ann.to_csv(f"{OUT}/DE_results_annotated.csv", index=False)

print("\n  Top 15 DE genes by padj:")
print(res_ann.loc[sig].head(15)[["gene_id", "gene_name", "gene_type",
      "log2FoldChange", "pvalue", "padj", "Direction"]].to_string(index=False))

pidx = g_gene["gene_type"] == "protein_coding"
pc_ids = set(g_gene.loc[pidx, "gene_id"])
tested_pc = [g for g in gene_ids if g in pc_ids]
res_lookup = res.set_index("gene_id")
sig_pc = [g for g in tested_pc if res_lookup.loc[g, "padj"] < 0.05]
up_pc  = [g for g in sig_pc if res_lookup.loc[g, "log2FoldChange"] > 0]
dn_pc  = [g for g in sig_pc if res_lookup.loc[g, "log2FoldChange"] < 0]
