# -*- coding: utf-8 -*-
"""
BixBench episode bix-5-q1
Question: "Which is statistically the most enriched GO biological process in
          samples from diseased patients compared to control?"

Pipeline:
  1) Differential expression (DESeq2-inspired, implemented with numpy/scipy)
     - 14 annotated samples (MGD1640F/MGD1641F excluded)
     - integer count matrix, prefilter: row sum >= 10 across 14 samples
     - median-of-ratios size factors (DESeq2)
     - NB-GLM log(mu) = X*beta + log(size factor),  X = [1, sexM, disease]
       reference = control  ->  positive log2FC = UP in disease
     - per-gene dispersion (Cox-Reid adjusted NB MLE) + empirical-Bayes shrinkage
     - Wald test on disease coefficient, BH adjustment; |log2FC| threshold = 0
  2) GO biological process enrichment (hypergeometric / Fisher, one-tailed)
     background = protein_coding genes that entered the DE test (after prefilter)
     BH across all BP terms; 'most enriched' = smallest padj (tie: raw p, then enrichment)
     GO annotation source is RE-DISCOVERED at runtime (goa_human / gene2go / *.obo / *.gmt,
     gseapy/goatools/mygene, R + org.Hs.eg.db/GO.db). If none exists, this step documents
     the missing resource and terminates with an explicit statement (no fabricated data).
"""
import os, sys, glob, subprocess, gzip, itertools, re, json, shutil
import numpy as np
import pandas as pd
from scipy import stats
from scipy.optimize import minimize_scalar
from scipy.special import gammaln

RNG = np.random.default_rng(0)
DATA = "data"
OUT = "outputs"
