# --- Hypergeometric GO engine (ready once annotation present) ---
def parse_goa_human(path):
    ens_by_go = {}
    opener = gzip.open if str(path).endswith(".gz") else open
    with opener(path, "rt", errors="ignore") as fh:
        for line in fh:
            if line.startswith("!"):
                continue
            f = line.rstrip("\n").split("\t")
            if len(f) < 17 or f[8] != "P":
                continue
            go = f[4]
            ens = None
            for xref in f[16].split("|"):
                if xref.startswith("Ensembl:"):
                    ens = xref.split(":", 1)[1].split(".")[0]; break
            if ens:
                ens_by_go.setdefault(go, set()).add(ens)
    return ens_by_go

def parse_obo_terms(path):
    terms = {}
    opener = gzip.open if str(path).endswith(".gz") else open
    cur_id = cur_name = None
    with opener(path, "rt", errors="ignore") as fh:
        for line in fh:
            line = line.strip()
            if line == "[Term]":
                cur_id = cur_name = None
            elif line.startswith("id: "):
                cur_id = line[4:]
            elif line.startswith("name: ") and cur_id:
                cur_name = line[6:]
            elif line == "" and cur_id and cur_name:
                terms[cur_id] = cur_name
                cur_id = cur_name = None
    return terms

def run_go_enrichment(de_ids, background_ids, go_to_genes, term_names, label):
    de_set = set(de_ids); bg_set = set(background_ids)
    N = len(bg_set); n = len(de_set & bg_set)
    rows = []
    for go, genes in go_to_genes.items():
        term_genes = set(genes) & bg_set
        K = len(term_genes)
        if K == 0:
            continue
        k = len(term_genes & de_set)
        if k == 0:
            continue
        p = stats.hypergeom.sf(k - 1, N, K, n)
        rows.append({"GO_ID": go, "Term": term_names.get(go, go),
                     "k_DE_in_term": k, "K_term_size": K, "n_DE": n, "N_bg": N,
                     "Enrichment_ratio": (k / n) / (K / N), "pvalue": p})
    df = pd.DataFrame(rows)
    if df.empty:
        print("   [%s] no overlapping BP terms -> no enrichment" % label)
        return df
    df = df.sort_values("pvalue")
    df["padj"] = stats.false_discovery_control(df["pvalue"].to_numpy(), method="bh")
    df = df.sort_values(["padj", "pvalue", "Enrichment_ratio"])
    df.to_csv(f"{OUT}/GO_BP_enrichment_{label}.csv", index=False)
    return df

go_sets = None; go_names = {}; go_source_desc = "NONE"
if goa_path:
