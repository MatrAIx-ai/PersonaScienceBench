if go_sets is not None:
    log_find("Using GO annotation source: %s ; BP terms: %d" % (go_source_desc, len(go_sets)))
    main = run_go_enrichment(sig_pc, tested_pc, go_sets, go_names, "main_allDE")
    up   = run_go_enrichment(up_pc,   tested_pc, go_sets, go_names, "sensitivity_UP")
    print("\n  MAIN (all DE, up+down) top 10 BP terms:")
