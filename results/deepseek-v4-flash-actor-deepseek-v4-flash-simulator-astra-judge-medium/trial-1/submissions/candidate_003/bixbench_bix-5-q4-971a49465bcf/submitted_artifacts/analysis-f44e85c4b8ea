"""
HGNC-derived gene-family enrichment as an OFFLINE PROXY for biological-process
enrichment (bixbench:bix-5-q4, ASXL1-mutated fibroblasts vs control).

IMPORTANT LABELING (non-negotiable, must appear in outputs/answer):
  "HGNC gene-family enrichment used as an offline proxy for biological-process
   enrichment; official GO BP could not be executed because no gene-set ontology
   source exists in the sandbox and the network is unreachable."
Also: the supplied HGNC_05-09-19.txt contains NO gene_family / gene_family_id
column (exactly 11 fields on all 46,580 rows, header verified). The only
"family" information is embedded in free-text Approved names
("...subfamily X member N", "...superfamily member N", "...family N member N").
Families are therefore DERIVED (text rule, deterministic) from those names.

Methods:
  - ranked list = protein-coding DE list, ranked by Wald z-stat (stat), descending
    (top = up-regulated in ASXL1-mutated). NOT raw log2FC (18 sparse-gene outliers).
  - Preranked GSEA-style ES per family (weighted, p=1; max-deviation signed ES,
    evaluated at hit positions); NES = ES/mean(|null ES|) with a gene-sampling null
    (B=1000 random gene sets of the family's size); two-sided permutation p-value;
    BH FDR across families.
  - ORA cross-check: hypergeometric (BH) on DE genes (padj<0.05 & |log2FC|>1),
    up- and down-regulated separately, same family groupings.
"""
import numpy as np, pandas as pd, re
from scipy import stats

CAVEAT = ("HGNC gene-family enrichment used as an offline proxy for biological-process "
          "enrichment; official GO BP could not be executed because no gene-set "
          "ontology source exists in the sandbox and the network is unreachable.")
print("LABEL:", CAVEAT)
print("FACT: HGNC file has NO gene_family/gene_family_id column; families derived "
      "deterministically from free-text Approved names.\n")

DE  = 'analysis/DE_ranked_gene_list_protein_coding.csv'
HGNC = 'data/HGNC_05-09-19.txt'
rng = np.random.default_rng(7)
B = 1000
MIN_SIZE, MAX_SIZE = 5, 2000

# ---------------- family map from HGNC ----------------
hg = pd.read_csv(HGNC, sep='\t', dtype=str)
hg = hg[hg['Status'] == 'Approved'].copy()
ens = 'Ensembl ID(supplied by Ensembl)'
hg = hg[hg[ens].notna() & hg[ens].str.startswith('ENSG')].copy()
hg['ens_base'] = hg[ens].str.split('.').str[0]

def family_key(name):
    """Deterministic text rule: family = approved-name text before first ' member'
    (falls back to text through last family keyword), so e.g.
    'ATP binding cassette subfamily A member 1' -> 'ATP binding cassette subfamily A';
    'family with sequence similarity 102 member A' -> 'family with sequence similarity 102'."""
    low = name.lower()
    if ' member ' in low or low.endswith(' member'):
        idx = low.find(' member')
        key = name[:idx].strip()
    else:
        kw = re.findall(r'(subfamily|superfamily|family)', low)
        if not kw:
            return np.nan
        idx = max(low.rfind(w) for w in set(kw))
        key = name[:idx + len(kw[0])].strip() if kw else np.nan
    if len(key.split()) < 2:
        return np.nan
    return key

hg['family'] = hg['Approved name'].apply(family_key)
fam_map = hg.dropna(subset=['family']).set_index('ens_base')['family']
print(f"HGNC Approved rows with Ensembl ID: {len(hg)}")
print(f"Genes with >=1 family assignment (HGNC-wide): {int(fam_map.notna().sum())}")
print(f"Distinct families: {fam_map.nunique()}\n")

# ---------------- ranked DE list ----------------
de = pd.read_csv(DE)
de = de[['gene_id','gene_name','stat','pvalue','padj','log2FoldChange']].copy()
de['ens_base'] = de['gene_id'].str.split('.').str[0]
de['family'] = de['ens_base'].map(fam_map)
de = de.sort_values('stat', ascending=False).reset_index(drop=True)
N = len(de)
fam = de.groupby('family')['stat'].agg(['count']).rename(columns={'count':'size'})
fam = fam[(fam['size'] >= MIN_SIZE) & (fam['size'] <= MAX_SIZE)]
de_has_fam = int(de['family'].notna().sum())
print(f"DE universe: {N} genes | with a family assignment: {de_has_fam} "
      f"({100*de_has_fam/N:.1f}%) | families (size {MIN_SIZE}-{MAX_SIZE}): {len(fam)}\n")

# ---------------- ranked metric ----------------
r = de['stat'].to_numpy()
a = np.abs(r)                 # weight p=1
pos = np.arange(1, N + 1)
Sa_all_needed = False

def signed_es(hit_pos, a, N):
    """Signed GSEA ES (weighted p=1) evaluated at hit positions (assumed sorted)."""
    m = len(hit_pos)
    if m == 0:
        return 0.0
    cum = a[hit_pos - 1].cumsum()
    Sa = cum[-1]
    denom_miss = N - m
    term = cum / Sa - (hit_pos - np.arange(1, m + 1)) / denom_miss
    ep, en = term.max(), term.min()
    return ep if abs(ep) >= abs(en) else en

# observed ES per family
rows = []
de_by_fam = {k: v['ens_base'] for k, v in de.groupby('family')}
rank_pos_of_gene = de.reset_index().set_index('ens_base')['index'].add(1)  # 1-based rank

for f in fam.index:
    members = de[de['family'] == f]['ens_base']
    hp = np.sort(rank_pos_of_gene.reindex(members).to_numpy())
    es_obs = signed_es(hp, a, N)
    m = len(hp)
    # gene-sampling null: B random gene sets of size m (positions 1..N)
    perm = np.argsort(rng.random((B, N)), axis=1)[:, :m] + 1  # B x m distinct positions
    perm.sort(axis=1)
    cum = np.take(a, perm - 1).cumsum(axis=1)
    Sa = cum[:, -1]
    arange_m = np.arange(1, m + 1)
    term = cum / Sa[:, None] / 1.0 - (perm - arange_m) / (N - m)
    null_ep = term.max(axis=1); null_en = term.min(axis=1)
    null_es = np.where(np.abs(null_ep) >= np.abs(null_en), null_ep, null_en)
    nes = es_obs / (np.mean(np.abs(null_es)) + 1e-12)
    pv = max(1.0 / (B + 1), float((np.abs(null_es) >= abs(es_obs)).mean()))
    rows.append({'family': f, 'size': m, 'ES': es_obs, 'NES': nes, 'pvalue': pv,
                 'direction': 'up_in_disease' if es_obs > 0 else 'down_in_disease'})
gsea = pd.DataFrame(rows).sort_values('NES', key=lambda s: s.abs(), ascending=False)
gsea['FDR'] = stats.false_discovery_control(gsea['pvalue'], method='bh')
gsea.to_csv('analysis/enrichment_GSEA_family_proxy.csv', index=False)
print("=== GSEA-STYLE (preranked on Wald stat) TOP 15 FAMILIES ===")
print(gsea.head(15).round(4).to_string(index=False))

# ---------------- ORA (hypergeometric, BH) ----------------
up = de[(de['padj'] < 0.05) & (de['log2FoldChange'] > 1)]['ens_base']
dn = de[(de['padj'] < 0.05) & (de['log2FoldChange'] < -1)]['ens_base']
K_up, K_dn, Nbg = len(up), len(dn), N

def ora(members, K):
    out = []
    for f in fam.index:
        m = int((de['family'] == f).sum())
        k = int(de[(de['family'] == f)]['ens_base'].isin(members).sum())
        p = stats.hypergeom.sf(k - 1, Nbg, K, m)
        out.append({'family': f, 'size': m, 'k': k, 'K': K, 'pvalue': p, 'fold_enrich': (k/m)/(K/Nbg)})
    o = pd.DataFrame(out)
    o['FDR'] = stats.false_discovery_control(o['pvalue'], method='bh')
    return o.sort_values('FDR')

ora_up, ora_dn = ora(up, K_up), ora(dn, K_dn)
ora_up.to_csv('analysis/enrichment_ORA_family_proxy_UP.csv', index=False)
ora_dn.to_csv('analysis/enrichment_ORA_family_proxy_DOWN.csv', index=False)
print("\n=== ORA top 10 (DE UP in disease) ===")
print(ora_up.head(10).round(4).to_string(index=False))
print("\n=== ORA top 10 (DE DOWN in disease) ===")
print(ora_dn.head(10).round(4).to_string(index=False))

# agreement between GSEA top and ORA
g5 = set(gsea.head(10)['family']); u5 = set(ora_up.head(10)['family']); d5 = set(ora_dn.head(10)['family'])
print("\nGSEA top-10 ∩ ORA-up top-10:", g5 & u5)
print("GSEA top-10 ∩ ORA-down top-10:", g5 & d5)
print("\nDE context: %d DE genes FDR<0.05 (UP %d / DOWN %d); %d at |log2FC|>1" % (
    int((de['padj']<0.05).sum()), int(((de['padj']<0.05)&(de['log2FoldChange']>0)).sum()),
    int(((de['padj']<0.05)&(de['log2FoldChange']<0)).sum()),
    int(((de['padj']<0.05)&(de['log2FoldChange'].abs()>1)).sum())))
print("\nSaved: enrichment_GSEA_family_proxy.csv, enrichment_ORA_family_proxy_UP.csv, "
      "enrichment_ORA_family_proxy_DOWN.csv")
print("ENRICHMENT-PROXY COMPLETE (proxy only, per labeling above)")
