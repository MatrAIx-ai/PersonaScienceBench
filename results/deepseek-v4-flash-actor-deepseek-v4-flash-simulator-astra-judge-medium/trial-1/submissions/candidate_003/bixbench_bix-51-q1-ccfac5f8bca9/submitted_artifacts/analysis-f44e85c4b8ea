import numpy as np
import pandas as pd
import statsmodels.api as sm

# ============ Load data ============
df_raw = pd.read_excel('data/data.xlsx', sheet_name='Sheet1')
# Only real patient rows (Sequence number present); trailing 41 rows are empty padding
df = df_raw.dropna(subset=['Sequence number']).copy()
n_total = len(df)

# ============ Outcome: PR -> 1, else (PD/SD) -> 0 ============
df['y'] = (df['Efficacy'] == 'PR').astype(int)

# ============ Predictor: Age, continuous years ============
df['Age_num'] = pd.to_numeric(df['Age'], errors='coerce')
assert df['Age_num'].isna().sum() == 0, "Missing Age among real patients"

X = df['Age_num'].values
y = df['y'].values
AGE = 65.0

# ============ Main: statsmodels Logit (unregularized MLE) ============
Xc = sm.add_constant(X)
model = sm.Logit(y, Xc).fit(disp=0)
b0 = model.params[0]          # const
b1 = model.params[1]          # Age
se = model.bse
pval_age = model.pvalues[1]
ci_b1 = model.conf_int()[1]

logit65 = b0 + b1 * AGE
p_sm = 1.0 / (1.0 + np.exp(-logit65))
p_sm_pred = model.predict([1.0, AGE])[0]

# ============ Sanity check 1: pure-numpy IRLS (unregularized MLE) ============
def irls_logit(Xd, y, max_iter=200, tol=1e-12):
    Xd = np.asarray(Xd, float)
    beta = np.zeros(Xd.shape[1])
    for _ in range(max_iter):
        eta = Xd @ beta
        p = 1.0 / (1.0 + np.exp(-eta))
        W = p * (1 - p)
        z = eta + (y - p) / np.maximum(W, 1e-15)
        XWX = Xd.T @ (W[:, None] * Xd)
        beta_new = np.linalg.solve(XWX, Xd.T @ (W * z))
        if np.max(np.abs(beta_new - beta)) < tol:
            beta = beta_new
            break
        beta = beta_new
    return beta

Xd = np.column_stack([np.ones(n_total), X])
beta_irls = irls_logit(Xd, y)
p_irls = 1.0 / (1.0 + np.exp(-(beta_irls[0] + beta_irls[1] * AGE)))

# ============ Sanity check 2: scikit-learn if available ============
p_sk = None
try:
    from sklearn.linear_model import LogisticRegression
    sk = LogisticRegression(C=1e12, fit_intercept=True, solver='liblinear')
    sk.fit(X.reshape(-1, 1), y)
    p_sk = sk.predict_proba([[AGE]])[0, 1]
except Exception as e:
    print(f"  (sklearn unavailable: {type(e).__name__} - {e})")

# ============ Summary ============
print("=" * 72)
print(f"DATA: rows read={df_raw.shape[0]}, real patients n={n_total}, "
      f"PR={int(y.sum())} ({y.mean():.4f}), Age min/max/mean={X.min()}/{X.max()}/{X.mean():.2f}")
print()
print(f"statsmodels Logit: PR ~ Age  (n = {n_total})")
print(f"  b0 (intercept)      = {b0:.10f}")
print(f"  b1 (Age coefficient)= {b1:.10f}")
print(f"  SE(b0)={se[0]:.6f}  SE(b1)={se[1]:.6f}   p(Age)={pval_age:.6g}")
print(f"  95% CI(b1) = [{ci_b1[0]:.6f}, {ci_b1[1]:.6f}]")
print(f"  LogLik={model.llf:.4f}  PseudoR2={model.prsquared:.4f}")
print()
print(f"PREDICTION at Age = 65")
print(f"  p = 1/(1+exp(-(b0 + b1*65)))  : {p_sm:.10f}")
print(f"  statsmodels model.predict([1,65]): {p_sm_pred:.10f}  (exact match: {np.isclose(p_sm, p_sm_pred)})")
print(f"  numpy IRLS (MLE) cross-check   : {p_irls:.10f}  diff={abs(p_sm-p_irls):.3e}")
if p_sk is not None:
    print(f"  sklearn LogisticRegression     : {p_sk:.10f}  diff={abs(p_sm-p_sk):.3e}")
print()
print(f"FINAL: predicted P(efficacy PR | treatment, Age=65) = {p_sm:.10f}  ->  {p_sm:.3g}")
print("=" * 72)
