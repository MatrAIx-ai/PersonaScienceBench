"""
BixBench bix-51-q2: AIC for logistic regression with BMI as the sole predictor
of treatment response (efficacy PR).

Outcome coding: response = 1 if Efficacy == 'PR' (n=41), 0 if Efficacy in ('SD','PD') (n=39).
Model: logit(response) = b0 + b1*BMI  (k = 2 parameters, intercept + BMI).
Complete cases: the 80 rows with non-missing BMI & Efficacy (no imputation needed).
AIC computed as 2k - 2*logLik (matches statsmodels result.aic).
"""
import numpy as np
import pandas as pd
import statsmodels.api as sm

# ---- 1. Load and prep data ----
df = pd.read_excel('data/data.xlsx', sheet_name='Sheet1', header=0)
print('Parsed shape:', df.shape)

# Only the first 80 rows (Sequence 1..80) carry data; trailing rows are blank.
complete = df.loc[:79, ['Sequence number', 'Groups', 'Efficacy', 'BMI']].copy()
complete['y'] = (complete['Efficacy'] == 'PR').astype(int)

n_missing_bmi = int(complete['BMI'].isna().sum())
n_missing_eff = int(complete['Efficacy'].isna().sum())
print('Analytic sample (rows 1-80): n =', len(complete),
      '| missing BMI =', n_missing_bmi, '| missing Efficacy =', n_missing_eff)
print('Efficacy counts (analytic sample):\n', complete['Efficacy'].value_counts())
print('\nBinary outcome counts:  1=PR:', int((complete['y'] == 1).sum()),
      ' 0=SD/PD:', int((complete['y'] == 0).sum()))

# ---- 2. Fit logistic regression: intercept + BMI (sole predictor) ----
X = sm.add_constant(complete['BMI'])          # [1, BMI]
model = sm.Logit(complete['y'], X)
res = model.fit(disp=0)

print('\n=== Logistic Regression Results ===')
print('nobs           :', int(res.nobs))
print('df_model       :', int(res.df_model), ' df_resid:', int(res.df_resid))
print('converged      :', res.mle_retvals['converged'])
print('params (index) :', list(res.params.index))
print('params         : const=%.6f, BMI=%.6f' % (res.params['const'], res.params['BMI']))
print('p-values       : const=%.4g, BMI=%.4g' % (res.pvalues['const'], res.pvalues['BMI']))
print('Log-Likelihood : %.10f' % res.llf)
print('AIC (statsmodels): %.10f' % res.aic)
print(res.summary())

# ---- 3. Verify AIC against the definition 2k - 2*logLik, k = #parameters ----
k = int(res.df_model) + 1                      # intercept + BMI = 2
aic_formula = 2 * k - 2 * res.llf
print('\nCheck: k = %d;  AIC = 2*k - 2*logLik = 2*%d - 2*(%.10f) = %.10f' %
      (k, k, res.llf, aic_formula))
print('AIC match (statsmodels == formula):', np.isclose(res.aic, aic_formula))

# ---- 4. Diagnostics: non-degenerate predictor, scaling invariance ----
bmi = complete['BMI'].values
print('\nDiagnostics:')
print('  BMI continuous/non-degenerate (std > 0):', bool(bmi.std() > 0),
      '| unique values:', len(np.unique(bmi)), '| range: %.1f - %.1f' % (bmi.min(), bmi.max()))
for label, b in [('raw', bmi),
                 ('centered', bmi - bmi.mean()),
                 ('standardized', (bmi - bmi.mean()) / bmi.std())]:
    r2 = sm.Logit(complete['y'], sm.add_constant(b)).fit(disp=0)
    print('  BMI %-12s -> logLik=%.10f  AIC=%.10f' % (label, r2.llf, r2.aic))

print('\nFINAL ANSWER: AIC = %.6f (logLik=%.6f, k=%d, n=%d)' %
      (res.aic, res.llf, k, int(res.nobs)))
