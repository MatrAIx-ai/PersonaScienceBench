"""
BixBench bix-51-q3: Combined logistic regression (BMI + Age + Gender)
predicting treatment response (PR) -> Wald p-value for Age.
"""
import pandas as pd
import numpy as np
import statsmodels.formula.api as smf

# ---- Load data ----
df = pd.read_excel('data/data.xlsx', sheet_name='Sheet1')

# Drop the 41 trailing fully-empty padding rows -> effective n=80
df = df[df['Sequence number'].notna()].copy()

# Age stored as text: normalize (replace whitespace-only cells) and coerce to numeric
df['Age'] = pd.to_numeric(df['Age'].astype(str).str.strip(), errors='coerce')

# Binary outcome: PR = 1, all others (SD, PD) = 0
df['PR'] = (df['Efficacy'] == 'PR').astype(int)

# Gender dummy: Male = 1, Female = 0
df['Male'] = (df['Gender'] == 'Male').astype(int)

n = len(df)
print(f"Effective sample size used in model: n = {n}")
print(f"Outcome counts (PR=1 / PR=0): {df['PR'].sum()} / {(df['PR']==0).sum()}")
print(f"Gender counts (Male=1 / Female=0): {df['Male'].sum()} / {(df['Male']==0).sum()}")
print(f"Missing in predictors: Age={df['Age'].isna().sum()}, BMI={df['BMI'].isna().sum()}, Male={df['Male'].isna().sum()}")
print(f"Age range: {df['Age'].min()}-{df['Age'].max()}, mean {df['Age'].mean():.3f}")
print(f"BMI range: {df['BMI'].min()}-{df['BMI'].max()}, mean {df['BMI'].mean():.3f}")
print()

# ---- Fit combined logistic regression: PR ~ BMI + Age + Gender ----
model = smf.logit("PR ~ BMI + Age + Male", data=df).fit(disp=0)
print(model.summary())
print()

# ---- Extract Age term ----
res_age = model.params['Age'], model.bse['Age'], model.tvalues['Age'], model.pvalues['Age']
coef, se, z, p = res_age
print("="*70)
print(f"AGE TERM  (units: per 1-year increase in Age)")
print(f"  coefficient = {coef:.6f}")
print(f"  std. error  = {se:.6f}")
print(f"  z-statistic = {z:.6f}")
print(f"  p-value     = {p:.6e}  (Wald z-test)")
print("="*70)

# Also report other terms for context
for term in ['Intercept', 'BMI', 'Male']:
    print(f"  {term:9s}: coef={model.params[term]:.6f}, SE={model.bse[term]:.6f}, z={model.tvalues[term]:.4f}, p={model.pvalues[term]:.4e}")
