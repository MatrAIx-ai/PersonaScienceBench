"""
Task: bixbench:bix-51-q4
Fit logistic regression: remission ~ Age + BMI + Gender; report change in
log-odds of remission per +1 year of age (Age coefficient).
"""
import pandas as pd
import numpy as np
import statsmodels.api as sm

# ---------- 1. Load & clean ----------
df = pd.read_excel('data/data.xlsx', sheet_name='Sheet1')
df['Age_num'] = pd.to_numeric(df['Age'], errors='coerce')

# Keep only informative rows (drop 41 fully-blank trailing rows)
data = df.dropna(subset=['Sequence number', 'Efficacy', 'Age_num', 'Gender', 'BMI']).copy()
data = data.reset_index(drop=True)
print(f"Analytic sample: {len(data)} rows")
print("Efficacy counts:", data['Efficacy'].value_counts().to_dict())
print("Gender counts:  ", data['Gender'].value_counts().to_dict())
print("Any NaN in Age/BMI/Gender in sample:", data[['Age_num','BMI','Gender']].isna().sum().sum())

# ---------- 2. Outcome + predictor encoding ----------
# remission = PR (only response class); non-remission = SD + PD
data['remission_PR'] = (data['Efficacy'] == 'PR').astype(int)

# Gender: Male = 1, Female = 0 (Female reference)
data['Male'] = (data['Gender'] == 'Male').astype(int)

X = sm.add_constant(data[['Age_num', 'BMI', 'Male']])  # const, Age, BMI, Male
y = data['remission_PR']

# ---------- 3. Primary model ----------
model = sm.Logit(y, X).fit(disp=False)
print("\n=== PRIMARY MODEL: remission = PR(1) vs SD+PD(0) ===")
print("Converged:", model.mle_retvals.get('converged'))
print(model.summary())

b_age = model.params['Age_num']
ci = model.conf_int().loc['Age_num']
p_age = model.pvalues['Age_num']
se_age = model.bse['Age_num']
print("\n--- Age coefficient (log-odds per +1 yr) ---")
print(f"beta_Age = {b_age:.6f}")
print(f"SE      = {se_age:.6f}")
print(f"95% CI  = [{ci[0]:.6f}, {ci[1]:.6f}]")
print(f"p-value = {p_age:.6g}")
print(f"OR per year = exp(beta) = {np.exp(b_age):.6f}")
print(f"OR CI       = [{np.exp(ci[0]):.6f}, {np.exp(ci[1]):.6f}]")

# ---------- 4. Sensitivity: remission = (SD + PR) vs PD ----------
data['remission_SDPR'] = (data['Efficacy'].isin(['SD', 'PR'])).astype(int)
print("\nSensitivity coding counts (SD+PR=1, PD=0):",
      data['remission_SDPR'].value_counts().to_dict())

y2 = data['remission_SDPR']
model2 = sm.Logit(y2, X).fit(disp=False)
print("\n=== SENSITIVITY MODEL: remission = SD+PR(1) vs PD(0) ===")
print("Converged:", model2.mle_retvals.get('converged'))
print(model2.summary())
b_age2 = model2.params['Age_num']
ci2 = model2.conf_int().loc['Age_num']
p_age2 = model2.pvalues['Age_num']
println = (f"\nbeta_Age(sensitivity) = {b_age2:.6f}\n"
           f"95% CI = [{ci2[0]:.6f}, {ci2[1]:.6f}]\n"
           f"p-value = {p_age2:.6g}\n"
           f"OR per year = {np.exp(b_age2):.6f}")
print(println)
