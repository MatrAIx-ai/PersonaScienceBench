"""
BixBench bix-51-q5 — Logistic regression: BMI and treatment response
=====================================================================
Question: Using a logistic regression model, what is the p-value for evaluating
the null hypothesis that BMI is not associated with treatment response?

Reproducibility notes
---------------------
- Input: data/data.xlsx, sheet 'Sheet1'.
- The sheet contains 80 real observations (Excel rows 2-81); rows 82-122 are
  empty trailing rows and are excluded (no imputation applied).
- Within the 80 kept rows, all clinical variables are complete except
  'Toxic and side effect', whose NaN is interpreted as 'no toxic/side effect'
  and recoded to the level 'None' (4-level factor: None/cardio/renal/neuro).
- Outcome: response = 1 if Efficacy == 'PR' (responder), else 0 (SD/PD, non-response).
  This is forced by the data: 'Groups' is exactly PR (n=41) vs SD+PD (n=39), i.e.
  Groups is the numeric encoding of the same binary outcome, so it is EXCLUDED
  from the covariate set (perfect collinearity).
- Exposure: BMI, continuous per-1-unit linear term.
- Adjustments (all specified columns): Age (numeric), Family history,
  ECOG-PS ('0-1' vs '2'), Child-Pugh (A vs B), Chemotherapy experience,
  HBV infection, Gender, Toxic and side effect ('None' baseline).
- Software: Python statsmodels Logit (equivalent R: glm(..., family='binomial')).
- P-value: two-sided Wald p of the BMI coefficient; LRT (likelihood-ratio,
  full vs restricted-without-BMI) reported as sensitivity.
"""
import numpy as np
import pandas as pd
import statsmodels.api as sm
from scipy import stats

DATA = "/workspace/data/data.xlsx"

# ---------------- 1. Load and clean ----------------
df = pd.read_excel(DATA, sheet_name="Sheet1")
d = df.copy()
# Keep only the 80 real observation rows: those with non-missing Efficacy
d = d[d["Efficacy"].notna()].reset_index(drop=True)
assert len(d) == 80, f"expected 80 obs, got {len(d)}"

# Outcome: responder = PR
d["response"] = (d["Efficacy"] == "PR").astype(int)

# Covariate coding (explicit dummies; coding does not affect BMI p-value)
d["Age"] = pd.to_numeric(d["Age"])
d["FamHist"]  = (d["Family history"] == "Yes").astype(int)          # 1 = Yes
d["ECOG2"]    = (d["ECOG-PS"].astype(str) == "2").astype(int)        # 1 = score 2, 0 = '0-1' (raw cells mix int 2 and str '0-1')
d["ChildB"]   = (d["Child-Pugh"] == "B").astype(int)                 # 1 = B, 0 = A
d["ChemoYes"] = (d["Chemotherapy experience"] == "Yes").astype(int)  # 1 = Yes
d["HBVYes"]   = (d["HBV infection"] == "Yes").astype(int)            # 1 = Yes
d["Male"]     = (d["Gender"] == "Male").astype(int)                  # 1 = Male, 0 = Female
d["Toxic"]    = d["Toxic and side effect"].fillna("None")            # NaN -> 'None'
d["BMIC"]     = d["BMI"].astype(float)

# Design matrix (BMI + listed specified covariates; Groups excluded = outcome)
X = pd.DataFrame({
    "intercept": 1.0,
    "BMI": d["BMIC"],
    "Age": d["Age"],
    "FamHist": d["FamHist"],
    "ECOG2": d["ECOG2"],
    "ChildB": d["ChildB"],
    "ChemoYes": d["ChemoYes"],
    "HBVYes": d["HBVYes"],
    "Male": d["Male"],
    "Toxic_neuro": (d["Toxic"] == "neurotoxicity").astype(int),
    "Toxic_renal": (d["Toxic"] == "renal toxicity").astype(int),
    "Toxic_cardio": (d["Toxic"] == "cardiotoxicity").astype(int),
})
# Note: Toxic baseline = 'None'
y = d["response"]

# ---------------- 2. Full model ----------------
full = sm.Logit(y, X).fit(disp=0, method="newton", maxiter=200)

print("=" * 78)
print("FULL ADJUSTED LOGISTIC MODEL  (n = {})".format(len(y)))
print("=" * 78)
print(full.summary2())

beta  = full.params["BMI"]
se    = full.bse["BMI"]
wald_z = full.tvalues["BMI"]
p_wald = full.pvalues["BMI"]
print("-" * 78)
print(f"BMI coefficient (per 1 unit) : {beta: .5f}")
print(f"BMI standard error           : {se: .5f}")
print(f"Wald z / p (two-sided)       : {wald_z: .4f}  /  {p_wald:.6g}")
print(f"exp(BMI OR)                  : {np.exp(beta): .3f}")

# Convergence / separation flags
print("-" * 78)
print("Convergence flags:")
print("  converged        :", full.mle_retvals.get("converged", "n/a"))
print("  optimization flag:", full.mle_retvals.get("flag", "n/a"))
try:  # Hessian invertibility checked via cov_params (raises if singular)
    _ = full.cov_params(); print("  hessian invertible: True (cov_params OK)")
except Exception as e:
    print("  hessian invertible: False ->", e)
print("  max abs coef (check separation):", np.abs(full.params).max())
print("  log-likelihood full        :", full.llf)

# ---------------- 3. LRT for BMI (sensitivity) ----------------
Xr = X.drop(columns=["BMI"])
red = sm.Logit(y, Xr).fit(disp=0, method="newton", maxiter=200)
lr_stat = 2 * (full.llf - red.llf)
df_lr = 1
p_lrt = stats.chi2.sf(lr_stat, df_lr)
print("-" * 78)
print("LIKELIHOOD-RATIO TEST for BMI (full vs model without BMI, df=1)")
print(f"  LR chi2 = {lr_stat: .4f}   p = {p_lrt:.6g}")
print(f"  log-likelihood restricted : {red.llf}")

# ---------------- 4. Headline ----------------
print("=" * 78)
print(f"HEADLINE (two-sided Wald p for BMI): {p_wald:.6g}")
print(f"LRT p (sensitivity)               : {p_lrt:.6g}")
print("=" * 78)
