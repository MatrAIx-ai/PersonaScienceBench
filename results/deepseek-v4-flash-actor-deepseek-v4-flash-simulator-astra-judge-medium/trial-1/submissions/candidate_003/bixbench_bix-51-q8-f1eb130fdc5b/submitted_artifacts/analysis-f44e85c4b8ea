#!/usr/bin/env python3
"""
BixBench bix-51-q8 — Camrelizumab: simple logistic regression of treatment
response on age, coefficient (change in log-odds) for age.

CODING (as approved):
  outcome = response: 1 if Group 1 / Efficacy == 'PR' (responder), 0 if Group 2 (PD/SD, non-responder).
  predictor = Age, continuous, integer years (1 year = 1 unit of change in log-odds).
  41 blank filler rows (Groups/Efficacy NaN) dropped; no imputation.
  Single-predictor model; Groups NOT included as predictor (it is a 1:1 recode of
  the outcome -> quasi-complete separation).
"""
import pandas as pd
import numpy as np
import statsmodels.api as sm

F = "data/data.xlsx"
df = pd.read_excel(F, sheet_name=0)
print("Raw sheet shape:", df.shape)

# --- 1. Drop the 41 empty filler rows (blank Excel rows; Groups & Efficacy NaN) ---
full = df[df["Groups"].notna()].copy()
assert len(full) == 80, f"Expected 80 valid patients, got {len(full)}"
print("Valid patient rows (after dropping blank filler rows):", len(full))

# --- 2. Outcome coding (explicit) ---
full["response"] = (full["Groups"] == 1).astype(int)   # Group 1 / PR = 1 ; Group 2 / PD+SD = 0
full["age"] = pd.to_numeric(full["Age"], errors="coerce")

n_resp = int(full["response"].sum())
n_non  = int((1 - full["response"]).sum())
print(f"Outcome coding: response=1 (Group 1 / PR) n={n_resp}; response=0 (Group 2 / PD+SD) n={n_non}")
assert full["age"].notna().all(), "Missing ages among valid patients"
assert bool(np.all(full["age"] == full["age"].astype(int))), "Age not integer-valued"
print(f"Age: n={len(full)}, min={full['age'].min()}, max={full['age'].max()}, "
      f"mean={full['age'].mean():.4f}, median={full['age'].median()}")

# --- 3. Simple logistic regression: logit(P(response=1)) = b0 + b1*Age ---
X = sm.add_constant(full["age"])
model = sm.Logit(full["response"], X)
result = model.fit(disp=False)

b_age = result.params["age"]
se_age = result.bse["age"]
p_age = result.pvalues["age"]
ci = result.conf_int().loc["age"]
or_age = np.exp(b_age)

print("\n=== FINAL RESULT ===")
print(f"Coefficient for Age (change in log-odds per 1 year):  {b_age:.10f}")
print(f"95% CI for Age coefficient: [{ci[0]:.10f}, {ci[1]:.10f}]")
print(f"Standard error (Age): {se_age:.10f}")
print(f"P-value (Age): {p_age:.10f}")
print(f"Odds ratio per 1-year: {or_age:.10f}")
print(f"N = {int(result.nobs)} (responders={n_resp}, non-responders={n_non})")
print(f"Converged: {result.mle_retvals['converged']}, iterations: {result.mle_retvals['iterations']}")
print(f"Intercept (b0): {result.params['const']:.6f}")

# --- 4. Robustness: same model via scikit-learn? (reference only) / R-equivalent ---
# Verify sign convention: reverse coding -> sign flips
y_rev = 1 - full["response"]
m_rev = sm.Logit(y_rev, X).fit(disp=False)
print(f"\nCheck reverse coding (response=0): age coef = {m_rev.params['age']:.10f} (expect +0.07495...)")

# Save compact summary for reproducibility
summary = {
    "n": int(result.nobs),
    "n_responder": n_resp,
    "n_non_responder": n_non,
    "coding": "response=1 if Group1/PR; response=0 if Group2/PD+SD",
    "age_unit": "1 year",
    "coef_age_logodds": b_age,
    "se_age": se_age,
    "p_age": p_age,
    "ci95_low": ci[0],
    "ci95_high": ci[1],
    "or_per_year": or_age,
    "intercept": result.params["const"],
    "converged": bool(result.mle_retvals["converged"]),
}
print("\nSummary dict:", summary)
