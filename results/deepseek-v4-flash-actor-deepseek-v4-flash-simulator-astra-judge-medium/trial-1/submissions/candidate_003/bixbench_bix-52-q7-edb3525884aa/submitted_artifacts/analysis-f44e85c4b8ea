# -*- coding: utf-8 -*-
"""
BixBench bix-52-q7: How many sites are removed when filtering sites that do not
show >90% or <10% methylation in Zebra Finch?

Approach:
  1. Load ZF_AgeRelated_CpG_noMT_Final.csv
  2. Unique sites = unique Pos (== Chromosome_StartPosition)
  3. Per-site methylation value = mean of MethylationPercentage across the
     samples present (also check median and pooled counts as sensitivity)
  4. Retained site iff value < 10 OR value > 90 (strict); removed otherwise
     (10 <= value <= 90)
  5. Count removed sites vs total sites and report
"""
import pandas as pd

ZF = "data/ZF_AgeRelated_CpG_noMT_Final.csv"
JD = "data/JD_AgeRelated_CpG_noMT_Final.csv"

zf = pd.read_csv(ZF)
jd = pd.read_csv(JD)
col = "MethylationPercentage"

print("=== INPUT INSPECTION ===")
print(f"ZF file: {zf.shape[0]} rows x {zf.shape[1]} columns; columns = {list(zf.columns)}")
print(f"JD file: {jd.shape[0]} rows x {jd.shape[1]} columns")
print(f"ZF unique sites (Pos): {zf['Pos'].nunique()}")
print(f"ZF unique (Chromosome,Start,End): {zf[['Chromosome','StartPosition','EndPosition']].drop_duplicates().shape[0]}")
print(f"JD unique sites (Pos): {jd['Pos'].nunique()}\n")

print(f"=== MethylationPercentage (ZF) ===")
print(f"rows={len(zf)}  missing={zf[col].isna().sum()}  min={zf[col].min():.4f}  max={zf[col].max():.4f}  mean={zf[col].mean():.4f}")
print(f"Coverage==0 rows: {(zf['Coverage']==0).sum()}")
rows_per_site = zf.groupby('Pos').size()
print(f"rows-per-site: min={rows_per_site.min()}, median={rows_per_site.median()}, max={rows_per_site.max()}, mean={rows_per_site.mean():.3f}\n")

tot_sites = zf['Pos'].nunique()
site = zf.groupby('Pos')[col].agg(['mean', 'median']).copy()
# pooled (sum counts) per site
pool = zf.groupby('Pos').agg(CM=('CountMethylated', 'sum'), CN=('CountNonMethylated', 'sum'))
site['pooled'] = 100 * pool['CM'] / (pool['CM'] + pool['CN'])

def removed_count(vals):
    """Retain iff value<10 OR value>90 (strict); removed iff 10<=value<=90."""
    retained = ((vals < 10) | (vals > 90)).sum()
    removed = (vals >= 10) & (vals <= 90)
    return int(removed.sum()), int(retained)

for key in ['mean', 'median', 'pooled']:
    r, k = removed_count(site[key])
    print(f"Per-site {key:6s}: removed={r} / {tot_sites}, retained={k}")

# Row-level sensitivity: site extreme if ANY sample row <10 or >90
any_ext = zf.groupby('Pos')[col].apply(lambda s: ((s < 10) | (s > 90)).any())
r = int((~any_ext).sum()); k = int(any_ext.sum())
print(f"Row-level 'any sample extreme': removed={r} / {tot_sites}, retained={k}")

# Boundary check
print(f"\nsites with aggregate ==10 or ==90 (mean): {(site['mean'].isin([10,90])).sum()}")

print("\n=== RESULT ===")
r, k = removed_count(site['mean'])
print(f"PRIMARY (per-site mean, strict <10 or >90 retained): {r} of {tot_sites} sites removed; {k} retained.")
print(f"ANSWER: {r} sites removed out of {tot_sites} total unique sites ({(100*r/tot_sites):.1f}%).")
