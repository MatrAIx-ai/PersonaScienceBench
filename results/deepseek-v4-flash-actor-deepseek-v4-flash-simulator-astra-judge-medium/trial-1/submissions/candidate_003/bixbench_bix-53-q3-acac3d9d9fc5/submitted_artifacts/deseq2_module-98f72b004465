#!/usr/bin/env python3
"""DESeq2-like differential expression for KL (KD) vs WL (WT) mouse counts.
Implemented from scratch with numpy/scipy only.
Pipeline: median-of-ratios size factors -> dispersion MLE -> trend + MAP shrinkage
-> NB GLM Wald test -> BH padj -> LFC shrinkage -> filters.
"""
import numpy as np, pandas as pd
from scipy.optimize import minimize_scalar
from scipy.special import gammaln
from scipy.stats import norm
from statsmodels.stats.multitest import multipletests

def size_factors(counts):
    """DESeq2 median-of-ratios size factors."""
    logc = np.zeros_like(counts, dtype=float)
    m = counts > 0
    logc[m] = np.log(counts[m])
    geomean = np.exp(np.mean(logc, axis=1))
    valid = geomean > 0
    ratio = counts[valid] / geomean[valid][:, None]
    sf = np.median(ratio, axis=0)
    return sf / np.exp(np.mean(np.log(sf)))

def np_loglik(k, mu, theta):
    """Negative binomial log-likelihood for fixed dispersion theta."""
    t = theta
    if t <= 0: return -np.inf
    return np.sum(gammaln(k + 1.0/t) - gammaln(1.0/t) - gammaln(k+1)
                  + k*np.log(t) + k*np.log(mu) - (k + 1.0/t)*np.log1p(t*mu))

def dispersion_mle(k, mu):
    def neg(l): return -np_loglik(k, mu, np.exp(l))
    res = minimize_scalar(neg, bounds=(-7, 7), method='bounded', options={'xatol':1e-5})
    return float(np.exp(res.x))

def fit_trend(baseMean_arr, disp_log, min_mean=1.0):
    """Robust linear trend of log(dispersion) ~ log(baseMean)."""
    m = np.log(np.maximum(baseMean_arr, 1e-9))
    keep = (baseMean_arr >= min_mean) & np.isfinite(disp_log) & np.isfinite(m)
    x, y = m[keep], disp_log[keep]
    if len(x) < 10:
        return np.array([-1.0, 0.0]), 0.5
    w = np.ones_like(x)
    b = np.polyfit(x, y, 1, w=w)
    for _ in range(50):
        resid = y - np.polyval(b, x)
        s = 1.4826*np.median(np.abs(resid - np.median(resid))); s = max(s, 1e-4)
        u = resid/s
        w = np.where(np.abs(u) <= 1.345, 1.0, 1.345/np.abs(u))
        b = np.polyfit(x, y, 1, w=w)
    resid = y - np.polyval(b, x)
    prior_var = (1.4826*np.median(np.abs(resid - np.median(resid))))**2
    prior_var = max(prior_var, 0.05)
    return b, prior_var

def map_dispersion(k, mu, trend_b, prior_var):
    m = np.mean(mu)
    tl_trend = trend_b[0] + trend_b[1]*np.log(m) if m>0 else trend_b[0]
    def neg_map(l):
        ll = np_loglik(k, mu, np.exp(l))
        prior = -0.5*((l - tl_trend)**2)/prior_var
        return -(ll + prior)
    res = minimize_scalar(neg_map, bounds=(-7,7), method='bounded', options={'xatol':1e-5})
    return float(np.exp(res.x))

def nb_glm_mle(k, X, offset, theta, max_iter=200):
    p = X.shape[1]
    # data-driven init: intercept from overall mean (offset absorbs size factors)
    beta = np.zeros(p)
    beta[0] = np.log(max(float(np.mean(k)), 1e-9))
    beta_prev = beta.copy()
    for it in range(max_iter):
        eta = offset + X @ beta
        eta = np.clip(eta, -25, 25)
        mu = np.exp(eta); mu = np.maximum(mu, 1e-12)
        V = mu + theta*mu*mu
        w = mu*mu / V
        z = eta + (k - mu)/mu
        z = np.clip(z, -30, 30)
        Xw = X * np.sqrt(w)[:, None]; zw = z * np.sqrt(w)
        XtWX = Xw.T @ Xw; XtWz = Xw.T @ zw
        try:
            beta_new = np.linalg.solve(XtWX, XtWz)
        except np.linalg.LinAlgError:
            break
        # step-halving if the weighted SSR increases
        ssr = lambda b: np.sum(w*(z - X@b)**2)
        step = 1.0
        for _ in range(12):
            cand = beta + step*(beta_new - beta)
            if np.isfinite(ssr(cand)) and ssr(cand) <= ssr(beta)*1.0000001 + 1e-9:
                beta_new = cand; break
            step *= 0.5
        if np.allclose(beta_new, beta_prev, atol=1e-7, rtol=1e-5):
            beta = beta_new; break
        beta_prev = beta.copy()
        beta = beta_new
    else:
        beta = beta_new
    cov = np.linalg.inv(XtWX)
    return beta, cov

def run_deseq2_like(counts, design, sf, shrinkage='normal'):
    n, m = counts.shape
    norm_counts = counts / sf
    baseMean = norm_counts.mean(axis=1)
    disp = np.full(n, np.nan)
    for i in range(n):
        k = counts[i].astype(float); mu = sf*baseMean[i]
        if baseMean[i] <= 0: continue
        try: disp[i] = dispersion_mle(k, mu)
        except Exception: disp[i] = np.nan
    ok = np.isfinite(disp) & (baseMean > 0)
    trend_b, prior_var = fit_trend(baseMean[ok], np.log(disp[ok]))
    disp_map = np.full(n, np.nan)
    for i in np.where(ok)[0]:
        k = counts[i].astype(float); mu = sf*baseMean[i]
        try: disp_map[i] = map_dispersion(k, mu, trend_b, prior_var)
        except Exception: disp_map[i] = disp[i]
    bc = design.shape[1]-1
    lfc = np.full(n, np.nan); se = np.full(n, np.nan); pval = np.full(n, np.nan)
    offset = np.log(sf)
    for i in range(n):
        if not np.isfinite(disp_map[i]): continue
        k = counts[i].astype(float)
        try:
            b, cov = nb_glm_mle(k, design, offset, disp_map[i])
            b1, s1 = b[bc], np.sqrt(cov[bc, bc])
            if s1 <= 0: continue
            lfc[i] = b1/np.log(2); se[i] = s1/np.log(2)
            pval[i] = 2*(1-norm.cdf(abs(b1/s1)))
        except Exception: pass
    finite = np.isfinite(pval)
    padj = np.full(n, np.nan)
    if finite.sum() > 0:
        padj[finite] = multipletests(pval[finite], method='fdr_bh')[1]
    lfc_shrunk = np.full(n, np.nan)
    if shrinkage == 'normal':
        tau = np.sqrt(2.0)
        m = np.isfinite(lfc)&np.isfinite(se)&(se>0)
        lfc_shrunk[m] = lfc[m]*tau**2/(se[m]**2+tau**2)
    res = pd.DataFrame({'baseMean':baseMean,'lfcMLE':lfc,'se':se,
                        'pvalue':pval,'padj':padj,'lfcShrink':lfc_shrunk})
    res['trend_intercept'] = trend_b[0]; res['trend_slope'] = trend_b[1]; res['prior_var'] = prior_var
    return res

if __name__ == '__main__':
    df = pd.read_csv('data/count.csv')
    counts = df[['KL1','KL2','KL3','WL1','WL2','WL3']].values.astype(float)
    genes = df['geneID'].values
    conditions = np.array(['KL','KL','KL','WL','WL','WL'])
    design = np.column_stack([np.ones(6), (conditions=='KL').astype(float)])
    sf = size_factors(counts)
    res = run_deseq2_like(counts, design, sf, shrinkage='normal')
    out = pd.DataFrame({'geneID': genes})
    for c in ['baseMean','lfcMLE','se','pvalue','padj','lfcShrink']:
        out[c] = res[c].values
    out.to_csv('scripts/de_results.tsv', sep='\t', index=False, float_format='%.6g')
    print('SIZE FACTORS:', np.round(sf,4))
    print('genes total:', len(out))
    print('finite pvalue:', np.isfinite(out.pvalue).sum())
    print('trend slope/intercept/prior_var:', res.trend_intercept[0], res.trend_slope[0], res.prior_var[0])
    print('padj<0.05:', (out.padj<0.05).sum())
    print('pvalue<0.05:', (out.pvalue<0.05).sum())
    for label, mask in [
        ('padj<0.05 & |lfcMLE|>1 & baseMean>10', (out.padj<0.05)&(out.lfcMLE.abs()>1)&(out.baseMean>10)),
        ('p<0.05 & |lfcMLE|>1 & baseMean>10', (out.pvalue<0.05)&(out.lfcMLE.abs()>1)&(out.baseMean>10)),
        ('padj<0.05 & |lfcShrink|>1 & baseMean>10', (out.padj<0.05)&(out.lfcShrink.abs()>1)&(out.baseMean>10)),
        ('p<0.05 & |lfcShrink|>1 & baseMean>10', (out.pvalue<0.05)&(out.lfcShrink.abs()>1)&(out.baseMean>10))]:
        print(label, ':', int(mask.sum()))
