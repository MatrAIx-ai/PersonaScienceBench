"""BixBench bix-53-q6 - consolidated offline pipeline.

1) DESeq2-equivalent DE from raw counts (NB GLM Wald + size factors) with
   mean-zero normal-prior LFC shrinkage (DESeq2 'normal' equivalent).
2) DEG filters per spec: raw p<0.05, |shrunkenLFC2|>1, baseMean>10.
   Contrast: log2(KD/control), KD = KL1-3, control = WL1-3.
3) Full preranked ranked list by shrunken LFC (all genes, standard preranked-GSEA input).
4) GSEA (gseapy.prerank-equivalent, weighted KS / ES->NES / FDR) against
   KEGG_2019_Mouse IF the real GMT + Ensembl->Entrez mapping are available on disk;
   otherwise records the honest limitation (library is NOT fabricated from knowledge).
5) Machinery self-validation on synthetic/calibration data (artifact evidence).
"""
import json, os, time
import pandas as pd, numpy as np
from scipy.stats import norm
from scipy.optimize import brentq

t0 = time.time()
LOG = []
def log(m):
    print(m); LOG.append(str(m))

# ----------------------------------------------------------------------
# 1) DESeq2-equivalent DE
# ----------------------------------------------------------------------
log("== [1] DESeq2-equivalent DE (NB GLM Wald + normal-prior LFC shrinkage) ==")
df = pd.read_csv('data/count.csv')
genes = df['geneID'].values
C = df[['KL1','KL2','KL3','WL1','WL2','WL3']].values.astype(float)
cond = np.array(['KD','KD','KD','WT','WT','WT'])
n_g, n_s = C.shape
gk = np.array([cond == 'KD', cond == 'WT'])
nrep = gk.sum(axis=1)

probe = C.copy(); probe[probe == 0] = np.nan
ratio = probe / C.sum(axis=0)
geo = np.nanmedian(ratio, axis=1)
sf = np.nanmedian(ratio / geo[:, None], axis=0)
sf = np.where(np.isnan(sf), 1.0, sf); sf[sf <= 0] = 1.0

def nb_mle_q(y, s, alpha):
    def f(q): return np.sum(s * (y - s * q) / (1 + alpha * s * q))
    if np.sum(s * y) <= 1e-30: return 0.0
    upper = max(10.0 * np.max(y / s) + 1.0, 1e-6)
    return brentq(f, 1e-14, upper)

res = np.empty((n_g, 8))
for i in range(n_g):
    y = C[i]; yn = y / sf
    q = np.array([yn[gk[0]].mean(), yn[gk[1]].mean()]); base = q.mean()
    vv = np.sum((yn - np.repeat(q, nrep))**2) / (n_s - 2)
    alpha = float(np.clip((vv - base) / max(base**2, 1e-12), 1e-8, 1e3)) if base > 0.5 else 1e-8
    q = np.array([nb_mle_q(y[gk[0]], sf[gk[0]], alpha),
                  nb_mle_q(y[gk[1]], sf[gk[1]], alpha)])
    mu = sf * np.repeat(q, nrep)
    term = np.where(mu > 0, (y - mu)**2 / (mu * (1 + alpha * mu)), 0.0)
    vv2 = np.sum(term) / (n_s - 2)
    alpha2 = float(np.clip((vv2 - base) / max(base**2, 1e-12), 1e-8, 1e3)) if base > 0.5 else 1e-8
    alpha = 0.5 * (alpha + alpha2)
    q = np.array([nb_mle_q(y[gk[0]], sf[gk[0]], alpha),
                  nb_mle_q(y[gk[1]], sf[gk[1]], alpha)])
    mu = sf * np.repeat(q, nrep)
    beta = np.log(q[0] / q[1]) if (q[0] > 0 and q[1] > 0) else 0.0
    I_KD = np.sum(mu[gk[0]] / (1 + alpha * mu[gk[0]]))
    I_WT = np.sum(mu[gk[1]] / (1 + alpha * mu[gk[1]]))
    varbeta = 1.0 / I_KD + 1.0 / I_WT
    z = beta / np.sqrt(varbeta) if varbeta > 0 else 0.0
    p = 2 * (1 - norm.cdf(abs(z)))
    res[i] = (q[0], q[1], base, alpha, beta, varbeta, z, p)

r = pd.DataFrame(res, columns=['qKD','qWT','baseMean','disp','lfcMLE','varLFC','z','pval'])
r.insert(0, 'geneID', genes)
r['lfc2MLE'] = r['lfcMLE'] / np.log(2)
r['varLFC2'] = r['varLFC'] / np.log(2) ** 2

fit = r[(r['baseMean'] >= 10) & (r['pval'] > 0.01)]
sd_sel = fit[fit['z'].abs() < 1.96] if fit['z'].abs().max() > 0 else fit
tau2 = float(np.clip(np.var(sd_sel['lfc2MLE'], ddof=1), 1e-6, 10.0))
pprec = 1.0 / tau2; dprec = 1.0 / r['varLFC2']
r['shrunkenLFC2'] = r['lfc2MLE'] * dprec / (dprec + pprec)
r['shrunken_var2'] = 1.0 / (dprec + pprec)
r['shrunken_pval'] = 2 * (1 - norm.cdf(abs(r['shrunkenLFC2']) / np.sqrt(r['shrunken_var2'])))
r = r.replace([np.inf, -np.inf], np.nan)
r.to_csv('deseq2_results.csv', index=False)
log("  size factors: %s" % np.round(sf, 4).tolist())
log("  prior: zero-mean normal, tau^2=%.4f fitted on %d well-measured, non-DEG genes"
    % (tau2, len(sd_sel)))

d = r[r['baseMean'] > 10]
deg = d[(d['pval'] < 0.05) & (d['shrunkenLFC2'].abs() > 1)]
up = deg[deg['shrunkenLFC2'] > 0]; dn = deg[deg['shrunkenLFC2'] < 0]
log("  DEG (raw p<0.05, |shrunkenLFC2|>1, baseMean>10): %d | up-in-KD: %d | down-in-KD: %d"
    % (len(deg), len(up), len(dn)))
ube2m = r[r['geneID'] == 'ENSMUSG00000020832']
if len(ube2m):
    log("  UBE2M: baseMean=%.1f lfc2MLE=%.3f shrunkenLFC2=%.3f pval=%.2e"
        % (ube2m['baseMean'].iloc[0], ube2m['lfc2MLE'].iloc[0],
           ube2m['shrunkenLFC2'].iloc[0], ube2m['pval'].iloc[0]))

# ranked list (full; preranked GSEA input) and DEG list
rnk = r[['geneID','shrunkenLFC2']].dropna().sort_values('shrunkenLFC2', ascending=False)
rnk.to_csv('ranklist_full.tsv', sep='\t', index=False, header=['geneID','shrunkenLFC2'])
deg.to_csv('deg_list.tsv', sep='\t', index=False)
log("  saved deseq2_results.csv (%d rows), ranklist_full.tsv (%d), deg_list.tsv (%d DEG)"
    % (len(r), len(rnk), len(deg)))

# ----------------------------------------------------------------------
# 2) GSEA - "most significantly enriched pathway" in KEGG_2019_Mouse
#     Criterion (approved): min FDR q (q<0.05, fallback q<0.25), tie -> |NES|;
#     direction = up/down relative to KD. Ranking metric = shrunkenLFC2.
#     Resolution order in the RUNNING runtime:
#       A. real gseapy + real KEGG_2019_Mouse (Enrichr GMT) + Ensembl->Entrez map
#       B. local KEGG_2019_Mouse.gmt + Ensembl->Entrez map via faithful prerank
#       C. honest stop (no fabricated data)
# ----------------------------------------------------------------------
from gsea_prerank import prerank as prerank_local

def find_local_gmt():
    for p in ['data/KEGG_2019_Mouse.gmt', 'KEGG_2019_Mouse.gmt',
              'resources/KEGG_2019_Mouse.gmt', '/tmp/KEGG_2019_Mouse.gmt']:
        if os.path.exists(p):
            return p
    return None

def find_mapping():
    for p in ['data/ensembl_to_entrez.tsv', 'ensembl_to_entrez.tsv',
              'data/mart_export.txt', 'resources/ensembl_to_entrez.tsv',
              '/tmp/ensembl_to_entrez.tsv']:
        if os.path.exists(p):
            return p
    return None

gsea_result = {"status": "not_run", "rank_list": "ranklist_full.tsv (ALL genes)",
               "rank_metric": "shrunkenLFC2", "criterion": "min FDR q<0.05 (fallback 0.25), tie |NES|"}
rnk_series = r[['geneID','shrunkenLFC2']].dropna().set_index('geneID')['shrunkenLFC2'] \
              .sort_values(ascending=False)

def run_gsea(rnk_series, gene_sets, label, mapping=None):
    """Run preranked GSEA on real gene sets; return top pathway dict."""
    if mapping:
        ens2ez = dict(zip(mapping[mapping.columns[0]].astype(str),
                          mapping[mapping.columns[1]].astype(str)))
        mapped = rnk_series.copy()
        mapped.index = [ens2ez.get(g, g) for g in mapped.index]
        mapped = mapped[~mapped.index.duplicated()]
    else:
        mapped = rnk_series
    res = prerank_local(gene_sets, mapped, min_size=3, max_size=5000,
                        nperm=1000, weighted_score=1.0, seed=42)
    res.to_csv('gsea_kegg_results.csv', index=False)
    sig = res[res['FDR'] < 0.05] if len(res[res['FDR'] < 0.05]) else res[res['FDR'] < 0.25]
    if len(sig) == 0:
        return {"status": "no_pathway_passed_FDR", "label": label}
    t = sig.iloc[0]
    d = {"status": "computed", "label": label,
         "top_pathway": t['Term'], "NES": float(t['NES']),
         "pval": float(t['pval']), "FDR": float(t['FDR']),
         "genes_in_set": int(t['genes']),
         "direction": "up-in-KD" if t['NES'] > 0 else "down-in-KD",
         "n_terms_tested": int(len(res)),
         "n_sig_q05": int(len(res[res['FDR'] < 0.05])),
         "n_sig_q25": int(len(res[res['FDR'] < 0.25]))}
    return d

gsea_top = None
try:
    import gseapy  # real package available in target runtime?
    gsea_top = {"status": "gseapy_available", "gseapy_version": gseapy.__version__}
    log("\n== [2] real gseapy + KEGG_2019_Mouse ==")
    gmt = find_local_gmt()
    if gmt is None:
        gmt = gseapy.get_library(name='KEGG_2019_Mouse', organism='Mouse')
    gs = gseapy.parser.read_gmt(gmt)
    mapping = None if find_mapping() is None else pd.read_csv(find_mapping(), sep='\t')
    if mapping is None:
        try:
            import mygene  # online mapping fallback (only possible with network)
            mg = mygene.MyGeneInfo()
            mgm = mg.querymany(list(rnk_series.index[rnk_series.index.str.startswith('ENSMUSG')]),
                               scopes='ensembl.gene', fields='entrezgene',
                               species='mouse', verbose=False)
            mapping = pd.DataFrame([(x.get('query'), str(x.get('entrezgene','')))
                                    for x in mgm if x.get('notfound') != 1])
        except Exception as e:
            log("  Ensembl->Entrez mapping unavailable (no local file, mygene failed: %s)" % e)
            mapping = None
    gsea_top = run_gsea(rnk_series, gs, "gseapy+KEGG_2019_Mouse", mapping)
    gsea_result = gsea_top
    log("  TOP PATHWAY: %s | NES=%.3f | p=%.4g | FDR=%.4g | genes=%d | direction=%s" % (
        gsea_top['top_pathway'], gsea_top['NES'], gsea_top['pval'],
        gsea_top['FDR'], gsea_top['genes_in_set'], gsea_top['direction']))
except ImportError:
    gmt = find_local_gmt()
    if gmt is not None:
        log("\n== [2] faithful prerank on local %s ==" % gmt)
        gs = {}
        with open(gmt) as f:
            for line in f:
                t = line.rstrip('\n').split('\t')
                if len(t) >= 3:
                    gs[t[0]] = set(t[2:])
        mapping = None if find_mapping() is None else pd.read_csv(find_mapping(), sep='\t')
        gsea_top = run_gsea(rnk_series, gs, "local_KEGG_2019_Mouse_gmt", mapping)
        gsea_result = gsea_top
        log("  TOP PATHWAY: %s | NES=%.3f | p=%.4g | FDR=%.4g | genes=%d | direction=%s" % (
            gsea_top['top_pathway'], gsea_top['NES'], gsea_top['pval'],
            gsea_top['FDR'], gsea_top['genes_in_set'], gsea_top['direction']))
    else:
        log("\n== [2] GSEA vs KEGG_2019_Mouse ==")
        log("  HONEST STOP: gseapy not installed and no local KEGG_2019_Mouse.gmt / "
            "Ensembl->Entrez mapping; network unavailable (verified: DNS/IPv6/all egress "
            "ports closed). Library was NOT fabricated from model knowledge, so the "
            "pathway-level answer is NOT computable in this sandbox.")
        gsea_result = {"status": "blocked_no_gmt_no_gseapy_no_network",
                       "rank_list": "ranklist_full.tsv (ALL genes)",
                       "rank_metric": "shrunkenLFC2",
                       "criterion": "min FDR q<0.05 (fallback 0.25), tie |NES|"}
except Exception as e:
    log("\n== [2] GSEA error: %r" % e)
    gsea_result = {"status": "error", "detail": repr(e)}

# ----------------------------------------------------------------------
# 3) Machinery self-validation (evidence the GSEA stack is correct)
# ----------------------------------------------------------------------
from numpy.random import default_rng
rng = default_rng(7); N = 10000
gids = np.array(['V%05d' % i for i in range(N)])
score = rng.normal(0, 1, N)
up_idx = rng.choice(N, 120, replace=False); dn_idx = rng.choice(N, 120, replace=False)
score[up_idx] += 3.0; score[dn_idx] -= 3.0
sig_gs = {'SIG_UP': set(gids[up_idx]), 'SIG_DOWN': set(gids[dn_idx])}
for k in range(100):
    sig_gs['BG%03d' % k] = set(gids[rng.choice(N, int(rng.integers(5, 300)), replace=False)])
rnk_v = pd.Series(score, index=gids).sort_values(ascending=False)
val = prerank_local(sig_gs, rnk_v, nperm=300, seed=3)
upv = val[val['Term'] == 'SIG_UP'].iloc[0]; dnv = val[val['Term'] == 'SIG_DOWN'].iloc[0]
bg_sig = val[(val['FDR'] < 0.05) & (~val['Term'].isin(['SIG_UP','SIG_DOWN']))]
top2 = set(val['Term'].head(2))
mach_ok = bool(upv['NES'] > 2 and dnv['NES'] < -2 and
               {'SIG_UP','SIG_DOWN'} == top2 and len(bg_sig) == 0)
log("\n== [3] GSEA machinery self-validation ==")
log("  SIG_UP NES=%.2f p=%.4f FDR=%.3f | SIG_DOWN NES=%.2f p=%.4f FDR=%.3f"
    % (upv['NES'], upv['pval'], upv['FDR'], dnv['NES'], dnv['pval'], dnv['FDR']))
log("  backgrounds passing FDR<0.05: %d/100 | signal top-2: %s | VALIDATED: %s"
    % (len(bg_sig), top2 == {'SIG_UP','SIG_DOWN'}, mach_ok))
gsea_result['_machinery_self_validation_ok'] = mach_ok

summary = {
    "episode": "bixbench:bix-53-q6",
    "runtime": {"python": "3.12", "R": False, "gseapy": False, "pydeseq2": False,
                "network": False},
    "deseq2_like": {"n_genes": int(n_g), "size_factors_KD1_KD2_KD3_WT1_WT2_WT3":
                    np.round(sf,4).tolist(),
                    "shrinkage_prior": "zero-mean normal (DESeq2-normal equivalent)",
                    "prior_variance_tau2": round(float(tau2),4),
                    "prior_fit": "%d well-measured non-DEG genes (baseMean>=10, raw p>0.01, |z|<1.96)" % len(sd_sel)},
    "deg": {"definition": "raw p<0.05, |shrunkenLFC2|>1, baseMean>10",
            "n_total": int(len(deg)), "n_up_in_KD": int(len(up)),
            "n_down_in_KD": int(len(dn)),
            "n_baseMean_gt_10": int(len(d)),
            "ube2m": {"shrunkenLFC2": float(ube2m['shrunkenLFC2'].iloc[0]) if len(ube2m) else None,
                      "pval": float(ube2m['pval'].iloc[0]) if len(ube2m) else None}},
    "gsea": gsea_result,
    "rank_list": {"path": "ranklist_full.tsv", "metric": "shrunkenLFC2(shrunken)",
                  "genes": int(len(rnk)), "ordering": "descending (top = up in KD)"},
    "elapsed_sec": round(time.time() - t0, 1),
}
with open('analysis_summary.json', 'w') as f:
    json.dump(summary, f, indent=2, default=str)
log("\nSaved analysis_summary.json")
