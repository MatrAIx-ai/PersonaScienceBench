#!/usr/bin/env python3
"""
BixBench bix-57-q1 - Percentage of gap characters relative to total alignment
positions across all alignments after aligning with MAFFT '--auto'.

Method per instructions:
  1) Honestly probe for the MAFFT binary (PATH + common locations). If found,
     run: mafft --auto <input.faa> > <output.afa> (per file, subprocess).
  2) If MAFFT is NOT available (this capsule: no network, no binary), use the
     documented fallback: progressive MSA (pairwise Needleman-Wunsch, BLOSUM62,
     affine gap penalties, UPGMA guide tree, once-a-gap-always-a-gap profile
     merging). This is a METHOD SUBSTITUTION and is disclosed; not MAFFT itself.
  3) Pooled gap percentage over the whole pool (all gaps incl. terminal):
       numerator   = sum of ALL '-' across all alignments
       denominator = sum over files of (alignment_length_f * n_sequences_f)
       result      = numerator / denominator * 100
     Also the unweighted mean of per-file percentages for sensitivity.
"""
import os, re, shutil, subprocess, json

DATA_DIR = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'data')
OUT_DIR  = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'alignments')
os.makedirs(OUT_DIR, exist_ok=True)

# ---------------- BLOSUM62 (standard NCBI order) ----------------
AAS = "ARNDCQEGHILKMFPSTWYV"
BLOSUM62_RAW = """A  4 -1 -2 -2  0 -1 -1  0 -2 -1 -1 -1 -1 -2 -1  1  0 -3 -2  0
R -1  5  0 -2 -3  1  0 -2  0 -3 -2  2 -1 -3 -2 -1 -1 -3 -2 -3
N -2  0  6  1 -3  0  0  0  1 -3 -3  0 -2 -3 -2  1  0 -4 -2 -3
D -2 -2  1  6 -3  0  2 -1 -1 -3 -4 -1 -3 -3 -1  0 -1 -4 -3 -3
C  0 -3 -3 -3  9 -3 -4 -3 -3 -1 -1 -3 -1 -2 -3 -1 -1 -2 -2 -1
Q -1  1  0  0 -3  5  2 -2  0 -3 -2  1  0 -3 -1  0 -1 -2 -1 -2
E -1  0  0  2 -4  2  5 -2  0 -3 -3  1 -2 -3 -1  0 -1 -3 -2 -2
G  0 -2  0 -1 -3 -2 -2  6 -2 -4 -4 -2 -3 -3 -2  0 -2 -2 -3 -3
H -2  0  1 -1 -3  0  0 -2  8 -3 -3 -1 -2 -1 -2 -1 -2 -2  2 -3
I -1 -3 -3 -3 -1 -3 -3 -4 -3  4  2 -3  1  0 -3 -2 -1 -3 -1  3
L -1 -2 -3 -4 -1 -2 -3 -4 -3  2  4 -2  2  0 -3 -2 -1 -2 -1  1
K -1  2  0 -1 -3  1  1 -2 -1 -3 -2  5 -1 -3 -1  0 -1 -3 -2 -2
M -1 -1 -2 -3 -1  0 -2 -3 -2  1  2 -1  5  0 -2 -1 -1 -1 -1  1
F -2 -3 -3 -3 -2 -3 -3 -3 -1  0  0 -3  0  6 -4 -2 -2  1  3 -1
P -1 -2 -2 -1 -3 -1 -1 -2 -2 -3 -3 -1 -2 -4  7 -1 -1 -4 -3 -2
S  1 -1  1  0 -1  0  0  0 -1 -2 -2  0 -1 -2 -1  4  1 -3 -2 -2
T  0 -1  0 -1 -1 -1 -1 -2 -2 -1 -1 -1 -1 -2 -1  1  5 -2 -2  0
W -3 -3 -4 -4 -2 -2 -3 -2 -2 -3 -2 -3 -1  1 -4 -3 -2 11  2 -3
Y -2 -2 -2 -3 -2 -1 -2 -3  2 -1 -1 -2 -1  3 -3 -2 -2  2  7 -1
V  0 -3 -3 -3 -1 -2 -2 -3 -3  3  1 -2  1 -1 -2 -2  0 -3 -1  4"""
BLOSUM = {}
for line in BLOSUM62_RAW.strip().splitlines():
    p = line.split(); aa = p[0]
    for k, v in zip(AAS, p[1:]):
        BLOSUM[(aa, k)] = int(v)

GAP_OPEN = -11.0   # affine gap open penalty (fallback scoring, BLOSUM62 units)
GAP_EXT  = -1.0    # affine gap extension penalty

# ---------------- FASTA parsing ----------------
def parse_fasta(path):
    recs, cur = [], None
    with open(path, encoding='utf-8') as fh:
        for line in fh:
            line = line.rstrip('\n')
            if not line.strip():
                continue
            if line.startswith('>'):
                if cur is not None:
                    recs.append(cur)
                cur = {'id': line[1:].strip(), 'seq': []}
            else:
                cur['seq'].append(line.strip())
    if cur is not None:
        recs.append(cur)
    for r in recs:
        r['seq'] = re.sub(r'\s+', '', ''.join(r['seq'])).upper()
    return recs

# ---------------- Pairwise NW (char-level, affine) ----------------
def nw_pair(seqX, seqY):
    """Affine-gap Needleman-Wunsch for two strings; returns (alX, alY)."""
    n, m = len(seqX), len(seqY)
    M  = [[-1e9]*(m+1) for _ in range(n+1)]
    Ix = [[-1e9]*(m+1) for _ in range(n+1)]
    Iy = [[-1e9]*(m+1) for _ in range(n+1)]
    tbM  = [[-1]*(m+1) for _ in range(n+1)]
    tbIx = [[-1]*(m+1) for _ in range(n+1)]
    tbIy = [[-1]*(m+1) for _ in range(n+1)]
    M[0][0] = 0.0
    for i in range(1, n+1):
        Ix[i][0] = GAP_OPEN + (i-1)*GAP_EXT
    for j in range(1, m+1):
        Iy[0][j] = GAP_OPEN + (j-1)*GAP_EXT
    for i in range(1, n+1):
        x = seqX[i-1]
        for j in range(1, m+1):
            sc = BLOSUM[(x, seqY[j-1])]
            v = [M[i-1][j-1]+sc, Ix[i-1][j-1]+sc, Iy[i-1][j-1]+sc]
            b = max(v); tbM[i][j] = v.index(b); M[i][j] = b
            v = [M[i-1][j]+GAP_OPEN, Ix[i-1][j]+GAP_EXT]
            b = max(v); tbIx[i][j] = v.index(b); Ix[i][j] = b
            v = [M[i][j-1]+GAP_OPEN, Iy[i][j-1]+GAP_EXT]
            b = max(v); tbIy[i][j] = v.index(b); Iy[i][j] = b
    v = [M[n][m], Ix[n][m], Iy[n][m]]
    state = v.index(max(v))
    i, j = n, m; ax, ay = [], []
    while i > 0 or j > 0:
        if i == 0:
            ax.append('-'); ay.append(seqY[j-1]); j -= 1; continue
        if j == 0:
            ax.append(seqX[i-1]); ay.append('-'); i -= 1; continue
        if state == 0:
            s = tbM[i][j]; ax.append(seqX[i-1]); ay.append(seqY[j-1]); i -= 1; j -= 1; state = s
        elif state == 1:
            s = tbIx[i][j]; ax.append('-'); ay.append(seqY[j-1]); j -= 1; state = s
        else:
            s = tbIy[i][j]; ax.append(seqX[i-1]); ay.append('-'); i -= 1; state = s
    return ''.join(reversed(ax)), ''.join(reversed(ay))

# ---------------- Profile-column NW (for progressive merging) ----------------
def col_score(colA, colB):
    """Average BLOSUM62 over residue pairs of two columns; gap-residue->GAP_OPEN."""
    s, n = 0.0, 0
    for a in colA:
        for b in colB:
            if a == '-' and b == '-':
                pass
            elif a == '-':
                s += GAP_OPEN; n += 1
            elif b == '-':
                s += GAP_OPEN; n += 1
            else:
                s += BLOSUM[(a, b)]; n += 1
    return s / n if n else 0.0

def nw_columns(colsX, colsY, nX, nY):
    """Affine-gap NW on profile columns. Returns (ax, ay) where each element is
    a string: residues of one column, or '-'*nX / '-'*nY for an inserted gap."""
    n, m = len(colsX), len(colsY)
    M  = [[-1e9]*(m+1) for _ in range(n+1)]
    Ix = [[-1e9]*(m+1) for _ in range(n+1)]
    Iy = [[-1e9]*(m+1) for _ in range(n+1)]
    tbM  = [[-1]*(m+1) for _ in range(n+1)]
    tbIx = [[-1]*(m+1) for _ in range(n+1)]
    tbIy = [[-1]*(m+1) for _ in range(n+1)]
    M[0][0] = 0.0
    for i in range(1, n+1):
        Ix[i][0] = GAP_OPEN + (i-1)*GAP_EXT
    for j in range(1, m+1):
        Iy[0][j] = GAP_OPEN + (j-1)*GAP_EXT
    for i in range(1, n+1):
        for j in range(1, m+1):
            sc = col_score(colsX[i-1], colsY[j-1])
            v = [M[i-1][j-1]+sc, Ix[i-1][j-1]+sc, Iy[i-1][j-1]+sc]
            b = max(v); tbM[i][j] = v.index(b); M[i][j] = b
            v = [M[i-1][j]+GAP_OPEN, Ix[i-1][j]+GAP_EXT]
            b = max(v); tbIx[i][j] = v.index(b); Ix[i][j] = b
            v = [M[i][j-1]+GAP_OPEN, Iy[i][j-1]+GAP_EXT]
            b = max(v); tbIy[i][j] = v.index(b); Iy[i][j] = b
    v = [M[n][m], Ix[n][m], Iy[n][m]]
    state = v.index(max(v))
    i, j = n, m; ax, ay = [], []
    while i > 0 or j > 0:
        if i == 0:
            ax.append('-'*nX); ay.append(''.join(colsY[j-1])); j -= 1; continue
        if j == 0:
            ax.append(''.join(colsX[i-1])); ay.append('-'*nY); i -= 1; continue
        if state == 0:
            s = tbM[i][j]; ax.append(''.join(colsX[i-1])); ay.append(''.join(colsY[j-1]))
            i -= 1; j -= 1; state = s
        elif state == 1:
            s = tbIx[i][j]; ax.append('-'*nX); ay.append(''.join(colsY[j-1])); j -= 1; state = s
        else:
            s = tbIy[i][j]; ax.append(''.join(colsX[i-1])); ay.append('-'*nY); i -= 1; state = s
    ax.reverse(); ay.reverse()
    return ax, ay

def align_profiles(msaA, msaB):
    """Align two MSAs (lists of aligned strings) -> (alignedA, alignedB) rows."""
    nA, nB = len(msaA), len(msaB)
    colsA = [''.join(col) for col in zip(*msaA)]
    colsB = [''.join(col) for col in zip(*msaB)]
    alnA, alnB = nw_columns(colsA, colsB, nA, nB)
    L = len(alnA)
    outA = [''.join(alnA[c][r] for c in range(L)) for r in range(nA)]
    outB = [''.join(alnB[c][r] for c in range(L)) for r in range(nB)]
    return outA, outB

def pair_identity(seqA, seqB):
    a, b = nw_pair(seqA, seqB)
    idn = sum(1 for x, y in zip(a, b) if x == y and x != '-' and y != '-')
    den = sum(1 for x, y in zip(a, b) if x != '-' and y != '-')
    return idn / den if den else 1.0

# ---------------- UPGMA guide tree + progressive assembly ----------------
def progressive_msa(seqs):
    """seqs: list of raw (no-gap) sequences -> aligned MSA (list of strings)."""
    n = len(seqs)
    if n == 1:
        return [seqs[0]]
    dist = [[0.0]*n for _ in range(n)]
    for i in range(n):
        for j in range(i+1, n):
            d = 1.0 - pair_identity(seqs[i], seqs[j])
            dist[i][j] = dist[j][i] = d
    clusters = [{'members': [i], 'msa': [seqs[i]]} for i in range(n)]
    while len(clusters) > 1:
        best = None
        for a in range(len(clusters)):
            for b in range(a+1, len(clusters)):
                ds = [dist[i][j] for i in clusters[a]['members'] for j in clusters[b]['members']]
                d = sum(ds)/len(ds)
                if best is None or d < best[0]:
                    best = (d, a, b)
        _, a, b = best
        merged, other = clusters[a], clusters[b]
        ma, mb = align_profiles(merged['msa'], other['msa'])
        merged['msa'] = ma + mb
        merged['members'] = merged['members'] + other['members']
        del clusters[b]
    # restore original input order of rows
    final = clusters[0]
    ordered = [None]*n
    for idx, row in zip(final['members'], final['msa']):
        ordered[idx] = row
    return ordered

# ---------------- Main ----------------
def main():
    mode = 'fallback'; mafft_version = None
    exe = shutil.which('mafft')
    if exe is None:
        for cand in ['/usr/local/bin/mafft', '/usr/bin/mafft', '/opt/mafft/mafft',
                     os.path.expanduser('~/bin/mafft')]:
            if os.path.isfile(cand) and os.access(cand, os.X_OK):
                exe = cand; break
    if exe:
        try:
            ver = subprocess.run([exe, '--version'], capture_output=True, text=True, timeout=30)
            mafft_version = (ver.stdout or ver.stderr).strip().splitlines()[0]
            mode = 'mafft'
            print(f"[probe] MAFFT found: {exe} version header: {mafft_version}", flush=True)
        except Exception as e:
            print(f"[probe] MAFFT binary exists but failed: {e}", flush=True); exe = None
    else:
        print("[probe] MAFFT binary NOT found (PATH + common locations). Using documented "
              "fallback (NW + BLOSUM62 + affine gaps + UPGMA progressive MSA). "
              "METHOD SUBSTITUTION - not MAFFT itself.", flush=True)

    files = sorted(f for f in os.listdir(DATA_DIR) if f.endswith('.faa'))
    per_file = []; total_gaps = 0; total_positions = 0

    for fn in files:
        path = os.path.join(DATA_DIR, fn)
        recs = parse_fasta(path)
        ids = [r['id'] for r in recs]; seqs = [r['seq'] for r in recs]
        if mode == 'mafft':
            inp = os.path.join(OUT_DIR, fn + '.in.fa')
            with open(inp, 'w', encoding='utf-8') as fh:
                for r in recs:
                    fh.write(f">{r['id']}\n{r['seq']}\n")
            outp = os.path.join(OUT_DIR, fn + '.afa')
            with open(inp, 'rb') as fi, open(outp, 'wb') as fo:
                subprocess.run([exe, '--auto'], stdin=fi, stdout=fo, check=True, timeout=600)
            amsa = [r['seq'] for r in parse_fasta(outp)]
        else:
            amsa = progressive_msa(seqs)
            with open(os.path.join(OUT_DIR, fn + '.afa'), 'w', encoding='utf-8') as fh:
                for rid, a in zip(ids, amsa):
                    fh.write(f">{rid}\n{a}\n")
        alen = len(amsa[0])
        assert all(len(a) == alen for a in amsa), f"ragged alignment in {fn}"
        gaps = sum(a.count('-') for a in amsa)
        pos = alen * len(amsa)
        total_gaps += gaps; total_positions += pos
        pct = 100.0 * gaps / pos
        per_file.append({'file': fn, 'n_seq': len(amsa), 'align_len': alen,
                         'gaps': gaps, 'positions': pos, 'pct': pct})

    pooled_pct = 100.0 * total_gaps / total_positions
    mean_pct = sum(p['pct'] for p in per_file) / len(per_file)

    print('==========================================================')
    for p in per_file:
        print(f"{p['file']:24s} n={p['n_seq']} aln_len={p['align_len']:4d} "
              f"gaps={p['gaps']:4d} per-file%={p['pct']:6.3f}")
    print('==========================================================')
    print(f"tot_seqs={sum(p['n_seq'] for p in per_file)}  tot_files={len(per_file)}")
    print(f"TOTAL_GAPS={total_gaps}  TOTAL_POSITIONS={total_positions}")
    print(f"POOLED_GAP_PERCENT = {pooled_pct:.6f} ({pooled_pct:.4f}%)")
    print(f"SENSITIVITY mean-of-per-file-percent = {mean_pct:.6f} "
          f"(delta vs pooled = {mean_pct-pooled_pct:+.6f})")
    print(f"MODE={mode}  mafft_version={mafft_version}")

    result = {
        'mode': mode, 'mafft_version': mafft_version,
        'gap_open': GAP_OPEN, 'gap_extend': GAP_EXT,
        'total_sequences': sum(p['n_seq'] for p in per_file),
        'total_files': len(per_file),
        'total_gaps': total_gaps, 'total_positions': total_positions,
        'pooled_gap_percent': pooled_pct,
        'mean_of_per_file_percent': mean_pct,
        'per_file': per_file,
    }
    with open(os.path.join(os.path.dirname(os.path.abspath(__file__)), 'result.json'), 'w') as fh:
        json.dump(result, fh, indent=2, ensure_ascii=False)
    print('result.json written.')

if __name__ == '__main__':
    main()
