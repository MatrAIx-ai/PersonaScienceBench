#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
BixBench bix-7-q2: average number of CHIP variants per sample after filtering out
intronic, intergenic and UTR variants.

Definitions used (literal reading of the question):
  * "variant" per sample = row with non-reference genotype:
        Zygosity in {Heterozygous, Homozygous Variant}
    (Reference and missing-Zygosity rows are NOT variants).
  * Filtered-out Sequence Ontology (Combined) classes (exactly those named in the
    question): intron_variant, intergenic_variant (absent from exome data),
    3_prime_UTR_variant, 5_prime_UTR_variant.
  * Borderline SO terms (splice_region_variant, synonymous_variant, missense_variant,
    upstream_gene_variant, 5_prime_UTR_premature_start_codon_gain_variant) are KEPT in
    the main count; sensitivity to the two UTR-/intergenic-flavoured ones is reported.
  * ClinVar / Classification is NOT used (the question is about variant type only).
  * Denominator = all 86 sample files (one sample per file), including zero-variant
    samples. No zero-variant samples exist (min = 39).
  * No duplicate surviving (Chr:Pos, Ref/Alt) entries within a file, so row count,
    unique-position count and unique-variant count coincide; we count unique
    (Chr:Pos, Ref/Alt) pairs for strictness.

NOTE (discrepancy recorded as requested): the In_CHIP column is True for 100% of rows,
yet only ~89% of surviving variant rows map to genes in the CHIP_Genes list (56 genes).
The In_CHIP flag is evidently computed differently from a plain gene-list membership;
this does not affect the main answer because the gene-list filter is NOT part of the
question. A footnote with the gene-list-restricted figure is printed for transparency.
"""
import glob
import statistics as st
import pandas as pd

DATA_DIR = "data/CHIP_DP10_GQ20_PASS"
EXCLUDED_SO = {"intron_variant", "intergenic_variant", "3_prime_UTR_variant", "5_prime_UTR_variant"}
VARIANT_ZYG = {"Heterozygous", "Homozygous Variant"}

files = sorted(glob.glob(f"{DATA_DIR}/*.xlsx"))
assert len(files) == 86, f"expected 86 files, got {len(files)}"

# load CHIP_Genes list (footnote only; not used as a filter)
chip_genes = set(pd.read_excel("data/230214_Schenz_et_al_2022_CHIP_Genes.xlsx",
                               header=None, usecols=[0])[0].dropna().astype(str))

rows = []            # per-sample record
excl = {"intron_variant": 0, "3_prime_UTR_variant": 0, "5_prime_UTR_variant": 0}
tot_rows = tot_var_rows = 0
tot_survive = 0
tot_alt_UTR = 0   # 5_prime_UTR_premature_start_codon_gain_variant among variants
tot_upstream = 0  # upstream_gene_variant among variants
gene_restricted_total = 0

for f in files:
    df = pd.read_excel(f, header=[0, 1])          # 2-level header (blocks / fields)
    zyg_col = [c for c in df.columns if c[1] == "Zygosity"][0]
    so_col = [c for c in df.columns if c[0] == "RefSeq Genes 110, NCBI" and c[1] == "Sequence Ontology (Combined)"][0]
    gn_col = [c for c in df.columns if c[0] == "RefSeq Genes 110, NCBI" and c[1] == "Gene Names"][0]
    pos_col = ("Variant Info", "Chr:Pos")
    alt_col = ("Variant Info", "Ref/Alt")

    z = df[zyg_col].astype(str)
    so = df[so_col].astype(str)
    is_var = z.isin(VARIANT_ZYG)
    keep = ~so.isin(EXCLUDED_SO)

    tot_rows += len(df)
    tot_var_rows += int(is_var.sum())
    for cls in excl:
        excl[cls] += int(so.eq(cls).sum())

    sub = df[is_var & keep]                        # surviving variant rows
    n_surv = sub[pos_col].astype(str) + "|" + sub[alt_col].astype(str)
    n_unique = n_surv.nunique()
    tot_survive += n_unique

    tot_alt_UTR += int(sub[so_col].astype(str).eq("5_prime_UTR_premature_start_codon_gain_variant").sum())
    tot_upstream += int(sub[so_col].astype(str).eq("upstream_gene_variant").sum())
    gene_restricted_total += int(sub[gn_col].dropna().astype(str).isin(chip_genes).sum())

    sample_name = f.split("/")[-1]
    rows.append({"file": sample_name, "variants": int(n_unique),
                 "variant_rows": int(is_var.sum()),
                 "surviving_rows": int(len(sub))})

per = [r["variants"] for r in rows]
mean = sum(per) / len(per)
mean_surv_rows = sum(r["surviving_rows"] for r in rows) / len(rows)

# ----- sensitivity: additionally drop the two borderline classes among variants -----
mean_minus_altUTR = (tot_survive - tot_alt_UTR) / len(rows)
mean_minus_upstream = (tot_survive - tot_upstream) / len(rows)
mean_minus_both = (tot_survive - tot_alt_UTR - tot_upstream) / len(rows)

print("=" * 78)
print("files (samples) analysed:", len(rows))
print(f"total data rows read: {tot_rows:,}")
print(f"variant rows (Het/HomVariant): {tot_var_rows:,}")
print(f"surviving variants after filter (unique Chr:Pos|Ref/Alt): {tot_survive:,}")
print()
print("-" * 78)
print("Excluded rows per Sequence Ontology class (all rows, incl. Reference):")
for cls, n in excl.items():
    print(f"   {cls:30s} {n:8,}")
print("-" * 78)
print("Per-sample surviving variants  (n = 86)")
print(f"   mean  : {mean:.3f}")
print(f"   median: {st.median(per)}")
print(f"   min   : {min(per)}")
print(f"   max   : {max(per)}")
print(f"   stdev : {st.pstdev(per):.3f}")
print(f"   zero-variant samples: {sum(1 for v in per if v == 0)}")
print(f"   (mean over surviving *rows* not uniquely deduped: {mean_surv_rows:.3f} -> "
      f"{sum(r['surviving_rows'] for r in rows):,} rows)")
print("-" * 78)
print("MAIN ANSWER: average CHIP variants per sample after filtering out")
print(f"intronic / intergenic / UTR variants  =  {mean:.3f}   (rounded: {mean:.1f})")
print(f"  = {tot_survive:,} surviving variants / 86 samples")
print()
print("SENSITIVITY (borderline classes kept in main count):")
print(f"   also exclude 5_prime_UTR_premature_start_codon_gain_variant (n={tot_alt_UTR}): "
      f"{(tot_survive-tot_alt_UTR):,} -> {mean_minus_altUTR:.3f}")
print(f"   also exclude upstream_gene_variant (n={tot_upstream}): "
      f"{(tot_survive-tot_upstream):,} -> {mean_minus_upstream:.3f}")
print(f"   exclude both: {(tot_survive-tot_alt_UTR-tot_upstream):,} -> {mean_minus_both:.3f}")
print()
print("FOOTNOTE (not part of the question): restrict surviving variants to genes in")
print(f"CHIP_Genes list ({len(chip_genes)} genes) -> {gene_restricted_total:,} / {tot_survive:,} "
      f"({100*gene_restricted_total/tot_survive:.1f}%) surviving; In_CHIP column is True for "
      f"100% of rows, so the flag is computed differently from plain gene-list membership.")
print("=" * 78)

# persist per-sample table for evidence
pd.DataFrame(rows).to_csv("per_sample_variants.csv", index=False)

with open("result.txt", "w") as fh:
    fh.write(f"avg_chip_variants_per_sample={mean:.6f}\n")
    fh.write(f"rounded_one_decimal={mean:.1f}\n")
    fh.write(f"total_surviving={tot_survive}\n")
    fh.write(f"n_samples={len(rows)}\n")
    fh.write(f"sensitivity_minus_5primeUTR_startgain={mean_minus_altUTR:.6f}\n")
    fh.write(f"sensitivity_minus_upstream={mean_minus_upstream:.6f}\n")
    fh.write(f"gene_restricted_total={gene_restricted_total}\n")

print("Wrote: per_sample_variants.csv, result.txt")
