#!/usr/bin/env python3
"""Count CHIP variant calls across all 86 per-sample VarSeq exports.

Rule (per researcher approval):
- CHIP variant call = row with Zygosity in {Heterozygous, Homozygous Variant}
  (i.e., remove reference calls AND exclude no-call/None rows).
- Unit = a row in each per-sample export; aggregate by simple sum over the
  86 files (no cross-sample deduplication).
- No gene filtering needed: In_CHIP == True for all rows of every file
  (exports already restricted to the 56-gene CHIP panel).
- Trio_Status metadata (BLM/Status/Sex/Age/Cancer) not used for counting.

Sensitivity (reported for transparency only, NOT the answer):
- literal rule 'Zygosity != Reference' (None/no-call rows included).
"""
import glob
import re
from collections import Counter

import openpyxl

SRC = "data/CHIP_DP10_GQ20_PASS/*.xlsx"
files = sorted(glob.glob(SRC))

# Column layout (row1 = group header, row2 = sub-header, data starts row 3):
#   1  Chr:Pos | 2  Ref/Alt | 3 Primary Findings | 4 Incidental Findings
#   5  Zygosity | 6 Mendel Error | 7 Inherited From | 8 DP | 9 GQ | 10 VAF
#   30 In_CHIP | 31 Match(gene) ...
ZYGO_COL = 5
INCHIP_COL = 30

def sample_id(fname):
    return re.search(r"_CHIP_(.+)\.xlsx", fname).group(1)

total_rows = 0
main_count = 0          # variant calls: Het + Hom
sensitivity_count = 0   # literal: Zygosity != 'Reference' (None included)
ref_count = 0
none_count = 0
inchip_issues = []

rows_table = []

for f in files:
    wb = openpyxl.load_workbook(f, data_only=True)
    ws = wb.active
    sid = sample_id(f)
    zygo = Counter()
    for r in range(3, ws.max_row + 1):
        z = ws.cell(row=r, column=ZYGO_COL).value
        ic = ws.cell(row=r, column=INCHIP_COL).value
        if ic is not True:
            inchip_issues.append((sid, r, ic))
        zygo[z] += 1
        total_rows += 1
    n_ref = zygo.get("Reference", 0)
    n_het = zygo.get("Heterozygous", 0)
    n_hom = zygo.get("Homozygous Variant", 0)
    n_none = zygo.get(None, 0)
    ref_count += n_ref
    none_count += n_none
    main_count += n_het + n_hom
    sensitivity_count += sum(v for k, v in zygo.items() if k != "Reference")
    rows_table.append((sid, ws.title, n_ref, n_het, n_hom, n_none))
    wb.close()

print(f"files processed: {len(files)}")
print(f"total rows:      {total_rows}")
print(f"rows with In_CHIP not True: {len(inchip_issues)} {inchip_issues[:3]}")
print("")
print("per-file table (Reference | Het | Hom | None):")
for sid, title, nr, nh, nhom, nn in rows_table:
    print(f"  {sid:>14s}  {title:35s}  {nr:5d}  {nh:5d}  {nhom:5d}  {nn:5d}")
print("")
print("==== MAIN ANSWER ====")
print(f"CHIP variant calls (Zygosity in {{Heterozygous, Homozygous Variant}}): {main_count}")
print("")
print("==== SENSITIVITY (literal 'Zygosity != Reference', None included) ====")
print(f"count = {sensitivity_count}  (difference vs main = {sensitivity_count - main_count}, of which 380/381 None = 1077)")
print(f"Reference rows removed total: {ref_count}; None/no-call rows excluded: {none_count}")
