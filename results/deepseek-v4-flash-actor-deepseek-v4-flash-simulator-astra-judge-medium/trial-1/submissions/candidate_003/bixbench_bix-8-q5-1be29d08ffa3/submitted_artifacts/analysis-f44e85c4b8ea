"""
BixBench bix-8-q5 — independence between m6A methylation status and
differential expression status in the bladder cancer dataset.

PRIMARY ANSWER: Pearson chi-squared test of independence on the FULL 3x3
contingency table m6A x DEG (Hyper/Hypo/no sig  x  Up/Down/no-DEGs),
without Yates continuity correction.

Data: data/MeRIP_RNA_result.xlsx, sheet 'Date Formatting' (12754 rows,
each row = transcript observation; status columns have zero missing).
"""
import numpy as np
import pandas as pd
from scipy import stats

DATA = 'data/MeRIP_RNA_result.xlsx'
df = pd.read_excel(DATA, sheet_name='Date Formatting')

# ---- Verify input integrity (defensive) ----
assert df['m6A'].notna().all() and df['DEG'].notna().all(), 'missing statuses'
# ready-made m6A_DEG must equal the concatenation -> confirms status columns
assert (df['m6A_DEG'] == (df['m6A'] + ' and ' + df['DEG'])).all()

# ---- PRIMARY: full 3x3 contingency table ----
row_order = ['m6A Hyper', 'm6A Hypo', 'm6A no sig']
col_order = ['Up', 'Down', 'no-DEGs']
tab3 = (pd.crosstab(df['m6A'], df['DEG'])
          .reindex(index=row_order, columns=col_order))
print('PRIMARY 3x3 contingency table (m6A rows x DEG cols):')
print(tab3.to_string())
print('cell sum =', tab3.values.sum())

chi3, p3, dof3, exp3 = stats.chi2_contingency(tab3, correction=False)
print(f'\nPRIMARY RESULT (3x3 Pearson chi-square, no Yates):')
print(f'  chi2            = {chi3:.8f}')
print(f'  dof             = {dof3}')
print(f'  p-value         = {p3:.6e}  (scientific notation: {p3:.3e})')
print(f'  min expected    = {exp3.min():.3f}  (all expected > 5: {(exp3 > 5).all()})')
print(f'  expected table:\n{np.round(exp3, 2)}')

# ---- Sensitivity (discussion only, NOT the answer) ----
df['m6A_bin'] = np.where(df['m6A'] == 'm6A no sig', 'm6A_no_sig', 'm6A_sig')
df['DEG_bin'] = np.where(df['DEG'] == 'no-DEGs', 'no_DEG', 'DEG')
tab2 = (pd.crosstab(df['m6A_bin'], df['DEG_bin'])
          .reindex(index=['m6A_sig', 'm6A_no_sig'], columns=['DEG', 'no_DEG']))
chi2_nc, p2_nc, _, _ = stats.chi2_contingency(tab2, correction=False)
chi2_y,  p2_y,  _, _ = stats.chi2_contingency(tab2, correction=True)
print('\nSENSITIVITY (discussion only):')
print(f'  2x2 Pearson (no Yates) : chi2={chi2_nc:.4f} p={p2_nc:.6e}')
print(f'  2x2 with Yates         : chi2={chi2_y:.4f} p={p2_y:.6e}')

with open('result_summary.txt', 'w') as fh:
    fh.write(f'chi2={chi3:.8f}\ndf={dof3}\np={p3:.6e}\nmin_expected={exp3.min():.3f}\n')
print('\nWrote result_summary.txt')
