"""
Main task: in which tissue type do bad responders show the highest number of
significantly differentially expressed genes (|log2FC|>0.5, baseMean>10, padj<0.05)
compared to controls?

Design (approved):
- per tissue (baseline_blood, dentate_gyrus, final_blood): bad_responder (n=10) vs Control (n=10)
- DESeq2-equivalent NB GLM/Wald on provided (DESeq-normalized) counts, size factors ~1
- filter |log2FC|>0.5 AND baseMean>10 AND padj<0.05 (two-sided), Benjamini-Hochberg
- cross-validation vs embedded DESeq2 blocks (Comp1=baseline Control-bad, Comp8=final Control-bad)
- sensitivity: NB-Wald with three dispersion strategies (shrunken / method-of-moments /
  common) to confirm tissue ranking is robust
Assumptions fixed: padj<0.05; two-sided |log2FC|; baseMean over all samples of the
comparison; all 20 samples used (no outlier exclusion); tissues analyzed independently.
"""
import pandas as pd, numpy as np
from scipy import stats
from statsmodels.nonparametric.smoothers_lowess import lowess
from statsmodels.stats.multitest import multipletests

SRC = 'data/Data_deposition_RNAseq_Paroxetine_2017.xlsx'
FILT = dict(lfc=0.5, bm=10.0, padj=0.05)


def bh(pvals):
    mask = ~np.isnan(pvals)
    out = np.full(len(pvals), np.nan)
    if mask.sum():
        out[mask] = multipletests(pvals[mask], method='fdr_bh')[1]
    return out


def count_de(lfc, bm, padj):
    return int(np.sum((np.abs(lfc) > FILT['lfc']) & (bm > FILT['bm']) & (padj < FILT['padj'])))


def dispersion_trend(baseMean, d_mm):
    ok = (baseMean > 0.05) & np.isfinite(d_mm) & (d_mm > 0)
    lo = np.log10(np.maximum(baseMean[ok], 1e-8)); ld = np.log10(d_mm[ok])
    order = np.argsort(lo); lo_s, ld_s = lo[order], ld[order]
    trend = np.repeat(np.nan, len(ld))
    if len(lo_s) > 50:
        sm = lowess(ld_s, lo_s, frac=0.5, it=3, return_sorted=True)
        trend[order] = np.interp(lo_s, sm[:, 0], sm[:, 1])
    fill = np.nanmedian(ld_s) if len(ld_s) else 0.0
    trend = np.where(np.isnan(trend), fill, trend)
    d_trend = np.repeat(1e-8, len(baseMean))
    d_trend[ok] = 10**np.clip(trend, -8, 8)
    return d_trend


def deseq_wald(q0, q1, disp_mode='shrink'):
    """DESeq2-equivalent NB Wald. disp_mode: 'shrink'|'mm'|'trend'|'common'."""
    n0, n1 = q0.shape[0], q1.shape[0]
    mu0 = q0.mean(axis=0); mu1 = q1.mean(axis=0)
    baseMean = np.concatenate([q0, q1], axis=0).mean(axis=0)
    with np.errstate(divide='ignore', invalid='ignore'):
        log2FC = np.log2(mu1 / mu0)   # DESeq2 convention log2(B/A), B=bad
    var0 = q0.var(axis=0, ddof=1); var1 = q1.var(axis=0, ddof=1)
    with np.errstate(divide='ignore', invalid='ignore'):
        d0 = (var0 - mu0) / mu0**2
        d1 = (var1 - mu1) / mu1**2
    d_mm = ((n0 - 1) * d0 + (n1 - 1) * d1) / (n0 + n1 - 2)
    d_mm = np.clip(np.nan_to_num(d_mm, nan=1e-8, posinf=1e-8, neginf=1e-8), 1e-8, None)
    d_trend = dispersion_trend(baseMean, d_mm)

    if disp_mode == 'mm':
        d = d_mm
    elif disp_mode == 'trend':
        d = d_trend
    elif disp_mode == 'common':
        # common dispersion: use 75th percentile of shrunken gene dispersions (edgeR-style)
        df = n0 + n1 - 2; prior_df = 3.0
        d_shr = np.exp((df * np.log(d_mm) + prior_df * np.log(d_trend)) / (df + prior_df))
        d = np.repeat(np.percentile(d_shr, 75), len(baseMean))
    else:  # shrink (default)
        df = n0 + n1 - 2; prior_df = 3.0
        d = np.exp((df * np.log(d_mm) + prior_df * np.log(d_trend)) / (df + prior_df))

    with np.errstate(divide='ignore', invalid='ignore'):
        v0 = (1 + d * mu0) / (n0 * mu0)
        v1 = (1 + d * mu1) / (n1 * mu1)
    se = np.sqrt(v0 + v1)
    se = np.where(np.isfinite(se) & (se > 0), se, 1e6)
    lnFC = log2FC * np.log(2.0)
    z = np.nan_to_num(lnFC / se, nan=0.0, posinf=0.0, neginf=0.0)
    pval = 2 * (1 - stats.norm.cdf(np.abs(z)))
    pval = np.clip(pval, 1e-320, 1.0)
    return dict(baseMean=baseMean, log2FC=log2FC, pval=pval, padj=bh(pval), disp=d)


def load():
    xl = pd.ExcelFile(SRC)
    nc = xl.parse('NormCount', header=3)
    nc.columns = [f'c{i}' for i in range(len(nc.columns))]
    return nc['c1'].to_numpy(), nc.iloc[:, 2:92].to_numpy(float), nc


def tissue_matrices(mat):
    out = {}
    for t, base in [('baseline_blood', 0), ('dentate_gyrus', 30), ('final_blood', 60)]:
        out[t] = (mat[:, base:base + 10].T, mat[:, base + 20:base + 30].T)
    return out


def main():
    geneid, mat, nc = load()
    tissues = ['baseline_blood', 'dentate_gyrus', 'final_blood']
    tmat = tissue_matrices(mat)

    print('=' * 78)
    print('MAIN DE (DESeq2-equivalent NB Wald, shrunk dispersion): bad vs Control')
    print('filter: |log2FC|>0.5 AND baseMean>10 AND padj<0.05 (two-sided, BH)')
    print('=' * 78)
    results = {}
    for t in tissues:
        q0, q1 = tmat[t]
        r = deseq_wald(q0, q1)
        n = count_de(r['log2FC'], r['baseMean'], r['padj'])
        up = int(np.sum((r['log2FC'] > 0) & (np.abs(r['log2FC']) > 0.5) &
                        (r['baseMean'] > 10) & (r['padj'] < 0.05)))
        results[t] = (r, n, up)
        print(f'{t:16s}: significant = {n:4d}  (up={up:3d}, down={n-up:3d})')
    best = max(results.items(), key=lambda kv: kv[1][1])
    print()
    print(f'>>> ANSWER: "{best[0]}" with {best[1][1]} significant genes')
    print()

    print('=' * 78)
    print('SENSITIVITY: NB-Wald with 4 dispersion strategies (count of DE genes)')
    print('=' * 78)
    print(f'{"tissue":16s} {"shrink":>10s} {"moments":>10s} {"trend":>10s} {"common":>10s}')
    verdict = []
    for t in tissues:
        q0, q1 = tmat[t]
        cnts = []
        for mode in ['shrink', 'mm', 'trend', 'common']:
            r = deseq_wald(q0, q1, mode)
            cnts.append(count_de(r['log2FC'], r['baseMean'], r['padj']))
        verdict.append((t, cnts))
        print(f'{t:16s} {cnts[0]:10d} {cnts[1]:10d} {cnts[2]:10d} {cnts[3]:10d}')
    print()
    print('Winner per dispersion strategy:')
    for mode_i, name in enumerate(['shrink', 'mm', 'trend', 'common']):
        w = max(verdict, key=lambda x: x[1][mode_i])
        print(f'  {name:7s}: {w[0]} ({w[1][mode_i]} genes)')
    print()

    print('=' * 78)
    print('CROSS-VALIDATION vs embedded DESeq2 blocks (author results)')
    print('=' * 78)
    emb_map = {1: 'baseline_blood', 8: 'final_blood', 5: 'dentate_gyrus'}
    for comp_i, t in emb_map.items():
        j = comp_i - 1
        emb_bm = nc[f'c{98+9*j}'].to_numpy(float)
        emb_lfc = nc[f'c{102+9*j}'].to_numpy(float)
        emb_p = nc[f'c{104+9*j}'].to_numpy(float)
        r, n, up = results[t]
        c_bm = np.corrcoef(emb_bm, r['baseMean'])[0, 1]
        emb_n = count_de(emb_lfc, emb_bm, emb_p)
        emb_up = int(np.sum((emb_lfc > 0) & (np.abs(emb_lfc) > 0.5) & (emb_bm > 10) & (emb_p < 0.05)))
        inter = len(set(np.where((np.abs(emb_lfc) > 0.5) & (emb_bm > 10) & (emb_p < 0.05))[0]) &
                     set(np.where((np.abs(r['log2FC']) > 0.5) & (r['baseMean'] > 10) & (r['padj'] < 0.05))[0]))
        direction_note = ''
        if t == 'dentate_gyrus':
            direction_note = '  [embedded block is GOOD-vs-BAD, not bad-vs-ctrl: shown as reference for dentate DE strength]'
        print(f'Comp{comp_i} ({t}): baseMean corr={c_bm:.4f} | embedded-sig={emb_n} '
              f'(up={emb_up},down={emb_n-emb_up}){" "*0} | our NB-Wald sig={n}, overlap={inter}{direction_note}')
    print()
    print('NOTE: embedded per-gene stats were computed by authors on raw counts with')
    print('"exclude outliers"; only baseMean is directly comparable (~1.00 corr). They are')
    print('used as an independent reference for the DE signal per tissue.')

    import json
    out = {t: dict(n=results[t][1], up=results[t][2],
                   disp_variants=dict(zip(['shrink', 'mm', 'trend', 'common'],
                                          [v[1] for v in verdict if v[0] == t][0]))) for t in tissues}
    out['winner'] = best[0]
    with open('analysis/de_summary.json', 'w') as fh:
        json.dump(out, fh, indent=2)
    print('saved analysis/de_summary.json')


if __name__ == '__main__':
    main()
