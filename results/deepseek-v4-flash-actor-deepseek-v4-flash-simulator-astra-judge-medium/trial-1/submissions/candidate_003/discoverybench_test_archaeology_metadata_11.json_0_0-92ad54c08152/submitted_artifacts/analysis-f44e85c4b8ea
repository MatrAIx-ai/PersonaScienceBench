# -*- coding: utf-8 -*-
"""
DiscoveryBench archaeology/metadata_11 — final analysis.
Question: century where Diversity in Pottery Form collapses AND Diversity in
Pottery Decoration increases simultaneously.

Decisions (researcher-approved):
  1) Answer century = 17th c. BCE (bin 1700 BCE, i.e. 1700-1601 BCE).
  2) "Simultaneous" = the same 100-yr bin transition (single anchor node).
  3) Conclusion on native 100-yr grid of capital.csv; annual _inter columns
     only as a cross-check, not as a precise-year source.
Grid: BCE(100-yr bins, 4300->500) == CE = -BCE == calBP = 1950+BCE.
Z-norm is GLOBAL (mean~0, std~1). high Z = high diversity (assumption).
"""

import pandas as pd
import numpy as np
import json

# ---------------- 1. Load capital.csv (comma decimals) ----------------
cap = pd.read_csv('data/capital.csv', sep=',')
for c in cap.columns:
    if c in ('BCE', 'group', 'color'):
        continue
    cap[c] = cap[c].astype(str).str.replace(',', '.').astype(float)

# sort ascending in time: BCE 4300 (oldest) -> 500 (youngest)
cap = cap.sort_values('BCE', ascending=False).reset_index(drop=True)
cap['CE'] = -cap['BCE']
cap['calBP'] = 1950 + cap['BCE']

# ---------------- 2. First differences (100-yr transitions) ----------------
cap['dForm'] = cap['ZKeform'].diff()   # Positive = form diversity up; negative = collapse
cap['dDec']  = cap['Zkeverz'].diff()   # Positive = decoration diversity up

SD_FORM = cap['ZKeform'].std()   # ~1.0
SD_DEC  = cap['Zkeverz'].std()   # ~1.0

print('ZKeform: mean=%.3f std=%.3f | Zkeverz: mean=%.3f std=%.3f' %
      (cap['ZKeform'].mean(), SD_FORM, cap['Zkeverz'].mean(), SD_DEC))
print('bins: %d | 100-yr step OK: %s' % (len(cap), (np.diff(cap['BCE'].values) == -100).all()))

# ---------------- 3. Criterion A: simultaneous |Δ| >= 1 SD in one transition --------
critA = cap[(cap['dForm'] <= -1.0) & (cap['dDec'] >= 1.0)]
print('\n### Criterion A (same transition: dForm<=-1 SD AND dDec>=+1 SD) ###')
print(cap.loc[critA.index[0] - 1: critA.index[0]].to_string(index=False) if len(critA)
      else 'NONE')

# also show which transitions satisfy each condition separately (context)
print('\n-- transitions with dForm<=-1 SD (collapse candidates) --')
print(cap.loc[cap['dForm'] <= -1.0, ['BCE', 'CE', 'calBP', 'ZKeform', 'dForm']].to_string(index=False))
print('-- transitions with dDec>=+1 SD (increase candidates) --')
print(cap.loc[cap['dDec'] >= 1.0, ['BCE', 'CE', 'calBP', 'Zkeverz', 'dDec']].to_string(index=False))

# ---------------- 4. Criterion B: state thresholds (first bin both extreme) --------
low_form  = cap['ZKeform'] <= (cap['ZKeform'].min() + 1e-9)   # == global min -1.13
# decoration 'increased plateau': value reached right after the step rise
dec_plateau = cap['Zkeverz'].max() if False else 0.97         # first high plateau value
high_dec = cap['Zkeverz'] >= 0.9
both = cap[low_form & high_dec]
print('\n### Criterion B: bins with Form==global min (<=-1 SD) AND Decoration elevated (>=0.9) ###')
print(both[['BCE', 'CE', 'calBP', 'group', 'ZKeform', 'Zkeverz']].to_string(index=False))
print('First such bin ->', both.iloc[0]['BCE'])

# ---------------- 5. Criterion C: first bin of sustained regime -------------------
# Form global minimum plateau starts at the first bin with ZKeform == -1.13
first_form_min = cap[cap['ZKeform'] == cap['ZKeform'].min()].iloc[0]
print('\n### Criterion C: first bin of sustained regime ###')
print('Form  global min (%.2f) first reached at BCE=%d (CE %d, calBP %d)'
      % (first_form_min['ZKeform'], first_form_min['BCE'], first_form_min['CE'], first_form_min['calBP']))
print('Decoration step rise %.2f -> %.2f across %d->%d BCE (dDec=%.2f)'
      % (cap['Zkeverz'].iloc[25], cap['Zkeverz'].iloc[26], cap['BCE'].iloc[25], cap['BCE'].iloc[26], cap['dDec'].iloc[26]))

# ---------------- 6. Full 39-bin summary --------------------------
print('\n### Full summary (all %d bins, ascending time) ###' % len(cap))
print(cap[['BCE', 'calBP', 'CE', 'group', 'ZKeform', 'Zkeverz', 'dForm', 'dDec']].to_string(index=False))

# ---------------- 7. Cross-check with time_series_data raw + inter ----------------
ts = pd.read_csv('data/time_series_data.csv', index_col=0)
raw_check = []
for _, r in cap.iterrows():
    row = ts[ts['CE'] == r['CE']]
    if len(row):
        raw_check.append(float(row['PotteryForm'].iloc[0]) == r['ZKeform'] and
                         float(row['PotteryDecoration'].iloc[0]) == r['Zkeverz'])
print('\n### Cross-check ###')
print('raw time_series values byte-equal to capital Z on overlap: %d/%d' %
      (sum(raw_check), len(raw_check)))

# annual _inter ramp across the transition (verification only)
inter = ts[(ts['CE'] >= -1800) & (ts['CE'] <= -1700)][['CE', 'PotteryForm_inter', 'PotteryDecoration_inter']]
inter = inter.set_index('CE')
print('inter ramp form span: %.3f -> %.3f (annual interpolation between anchors) | '
      'dec span: %.3f -> %.3f' % (inter['PotteryForm_inter'].iloc[0], inter['PotteryForm_inter'].iloc[-1],
                                  inter['PotteryDecoration_inter'].iloc[0], inter['PotteryDecoration_inter'].iloc[-1]))

# ---------------- 8. Compact result record --------------------------
result = {
    'answer_century_BCE': '17th century BCE (1700-1601 BCE)',
    'bin_label_BCE': 1700,
    'CE': -1700,
    'calBP': 3650,
    'dForm_Z': round(float(cap['dForm'].iloc[26]), 2),
    'dDec_Z': round(float(cap['dDec'].iloc[26]), 2),
    'form_before_after': [round(float(cap['ZKeform'].iloc[25]), 2), round(float(cap['ZKeform'].iloc[26]), 2)],
    'dec_before_after': [round(float(cap['Zkeverz'].iloc[25]), 2), round(float(cap['Zkeverz'].iloc[26]), 2)],
    'criterion_A_unique_transition': len(critA) == 1,
    'criterion_B_first_bin': int(both.iloc[0]['BCE']),
    'criterion_C_first_bin': int(first_form_min['BCE']),
}
with open('result.json', 'w') as f:
    json.dump(result, f, indent=2)
print('\n### result.json ###')
print(json.dumps(result, indent=2))
