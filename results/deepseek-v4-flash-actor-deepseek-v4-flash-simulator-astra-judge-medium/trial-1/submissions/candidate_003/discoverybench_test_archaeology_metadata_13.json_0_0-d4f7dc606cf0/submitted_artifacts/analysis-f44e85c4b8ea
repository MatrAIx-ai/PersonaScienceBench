"""
DiscoveryBench archaeology task — full analysis.
Q: In what centuries did we see the highest growth phase of 2000-1100 BCE?

Approved approach:
  window CE in [-2000,-1100] (2000-1100 BCE), CE = BCE*(-1); 9 century bins of
  100 yr (last bin absorbs the lone year -1100; robustness rerun without it);
  primary growth metric = century mean of pollen_grate_100 (sanctioned
  openness-growth measure); diagnostics = century max, positive-year fraction,
  change in pollen_inter_100; capital Z-indicators corroborative only.

Notes baked in: pollen_grate_100 is taken as given (formula not re-derivable;
relative ordering is what matters); only 48 raw pollen observations fall inside
the window so the curve is largely interpolated (century-mean robust, single
year-peak not); 100-yr smoothing leaks across the window edges (boundary check).
"""
import pandas as pd, numpy as np
rng = np.random.default_rng(42)

ts = pd.read_csv('data/time_series_data.csv')
cap = pd.read_csv('data/capital.csv', decimal=',')
CE_LO, CE_HI = -2000, -1100
bins = {0:'2000-1900 BCE',1:'1900-1800 BCE',2:'1800-1700 BCE',3:'1700-1600 BCE',
        4:'1600-1500 BCE',5:'1500-1400 BCE',6:'1400-1300 BCE',7:'1300-1200 BCE',
        8:'1200-1100 BCE'}

# raw pollen sparsity inside the window (context for interpolation caveat)
raw_in_window = ts[(ts['CE']>=CE_LO)&(ts['CE']<=CE_HI)]['pollen'].notna().sum()
print(f"[context] raw pollen observations inside 2000-1100 BCE window: {raw_in_window} of 901 years")

w = ts[(ts['CE'] >= CE_LO) & (ts['CE'] <= CE_HI)].copy()
w['bin'] = ((w['CE'] - CE_LO) // 100).clip(0, 8)
w['cent'] = w['bin'].map(bins)

def century_table(df):
    return df.groupby('cent', sort=False).agg(
        years=('CE','count'),
        grate_mean=('pollen_grate_100','mean'),
        grate_sem=('pollen_grate_100', lambda s: s.std(ddof=1)/np.sqrt(s.notna().sum())),
        grate_max=('pollen_grate_100','max'),
        pos_frac=('pollen_grate_100', lambda s:(s>0).mean()),
        open_chg=('pollen_inter_100', lambda s: s.iloc[-1]-s.iloc[0]))

print("\nMAIN: 9-century table, window CE[-2000,-1100] (2000-1100 BCE), -1100 in last bin")
tab = century_table(w)
print(tab.round(5).to_string())

order = tab['grate_mean'].sort_values(ascending=False)
print("\nRanking by century-mean growth rate (pollen_grate_100):")
for i,(c,v) in enumerate(order.items(),1):
    print(f"  {i}. {c:14s} mean={v:+.6f} pos_frac={tab.loc[c,'pos_frac']:.2f} open_chg={tab.loc[c,'open_chg']:+.4f} max={tab.loc[c,'grate_max']:+.6f}")

adj = [(bins[i],bins[i+1]) for i in range(8)
       if tab.loc[bins[i],'grate_mean']>0 and tab.loc[bins[i+1],'grate_mean']>0]
print("\nAdjacent positive-mean runs (sustained multi-century growth):", adj)

# ---- robustness ----
print("\nROBUSTNESS CHECKS")
w2 = w[w['CE'] != -1100]
t2 = century_table(w2)
print("(a) Drop -1100 edge year. Top-3 by mean:", list(t2['grate_mean'].sort_values(ascending=False).head(3).index))

w3 = w[(w['CE'] >= -1950) & (w['CE'] <= -1150)]
w3['bin'] = ((w3['CE'] - (-1950)) // 100).clip(0,7)
w3['cent'] = w3['bin'].map({0:'2000-1900 BCE',1:'1900-1800 BCE',2:'1800-1700 BCE',
    3:'1700-1600 BCE',4:'1600-1500 BCE',5:'1500-1400 BCE',6:'1400-1300 BCE',7:'1300-1200 BCE'})
t3 = w3.groupby('cent', sort=False)['pollen_grate_100'].mean().sort_values(ascending=False)
print("(b) Trim 50 yr off each edge (smoothing-boundary leakage). Top-3 by mean:")
for i,(c,v) in enumerate(t3.head(3).items(),1): print(f"     {i}. {c:14s} mean={v:+.6f}")

def bs_ci(s, n=10000):
    m = s.dropna().to_numpy(); means = np.array([rng.choice(m, size=m.size, replace=True).mean() for _ in range(n)])
    return np.percentile(means, [2.5, 97.5])
print("(c) Bootstrap 95% CI of century means:")
for c in ['1500-1400 BCE','1400-1300 BCE','1700-1600 BCE']:
    lo,hi = bs_ci(w.loc[w['cent']==c,'pollen_grate_100']); print(f"     {c:14s} [{lo:+.6f}, {hi:+.6f}]")

print("(d) Spike reading (single-year max rank):")
for i,(c,v) in enumerate(tab['grate_max'].sort_values(ascending=False).head(3).items(),1):
    print(f"     {i}. {c:14s} max={v:+.6f} mean={tab.loc[c,'grate_mean']:+.6f} pos_frac={tab.loc[c,'pos_frac']:.2f}")

g = w.set_index('CE')['pollen_grate_100'].sort_index()
smooth = g.rolling(200, center=True, min_periods=50).mean()
print("(e) 200-yr centered smooth: peak at CE %d (bin %s); turns positive at CE %d (bin %s)"
      % (int(smooth.idxmax()), bins.get((int(smooth.idxmax())-CE_LO)//100),
         int(smooth.dropna().index[smooth.dropna()>0].min()),
         bins.get((int(smooth.dropna().index[smooth.dropna()>0].min())-CE_LO)//100)))

# ---- capital Z cross-check (corroborative) ----
zc = [c for c in cap.columns if c.startswith('Z')]
capw = cap[(cap['BCE']>=1100)&(cap['BCE']<=2000)].copy()
capw['cent'] = capw['BCE'].map({2000:'2000-1900 BCE',1900:'1900-1800 BCE',1800:'1800-1700 BCE',
    1700:'1700-1600 BCE',1600:'1600-1500 BCE',1500:'1500-1400 BCE',1400:'1400-1300 BCE',
    1300:'1300-1200 BCE',1200:'1200-1100 BCE',1100:'1200-1100 BCE'})
capw['meanZ'] = capw[zc].mean(axis=1)
print("\nCAPITAL Z CROSS-CHECK (100-yr granularity, corroborative only)")
print(capw[['BCE','cent','meanZ']].round(3).to_string(index=False))
best = capw.sort_values('meanZ', ascending=False).iloc[0]
print("Highest mean-Z at BCE %d -> %s (meanZ=%.3f)" % (best['BCE'], best['cent'], best['meanZ']))

# ---- final decision ----
print("\nFINAL: top = %s | sustained run = 1500-1400 & 1400-1300 BCE" % order.index[0])
