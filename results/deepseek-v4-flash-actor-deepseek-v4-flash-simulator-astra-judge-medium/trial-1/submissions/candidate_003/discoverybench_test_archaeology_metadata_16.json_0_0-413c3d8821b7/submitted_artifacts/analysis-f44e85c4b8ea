# -*- coding: utf-8 -*-
"""
PCA on the forms of capital in hundred-year time slices (capital.csv).
Pipeline:
  1) Load capital.csv (BCE 4300->500, 39 slices), parse German comma decimals.
  2) Correlation-matrix PCA on the 12 capital-form Z columns.
  3) Explicit PC1 sign convention: orient so the dominant loading block is positive
     (net loading sum >= 0); "high PC1" = the pole indicated by the positive loadings.
  4) PC1 time series attached to slice years and phase groups.
  5) Characterize Middle Neolithic (MN, 3400-3000 BCE) vs Younger Neolithic
     (SG group, 2900-2300 BCE): mean/range of PC1 and the 3000->2900 transition.
  6) Robustness: Neolithic-only window (4100-2200 BCE) and/or dropping near-constant
     ZSichel; report whether the phase characterization flips.
Outputs: console report + analysis/capital_pca_outputs.csv, capital_pca_loadings.csv
"""
import numpy as np
import pandas as pd

RAW = "data/capital.csv"

def load_capital(path):
    df = pd.read_csv(path)
    zcols = [c for c in df.columns if c.startswith("Z")]
    z = df[zcols].replace(",", ".", regex=True).apply(pd.to_numeric)
    out = df[["BCE", "group"]].copy()
    for c in zcols:
        out[c] = z[c].astype(float)
    return out, zcols

def pca_corr(X):
    """Correlation-matrix PCA. X: (n x p) numeric."""
    Xs = (X - X.mean(axis=0)) / X.std(axis=0, ddof=1)   # enforce standardization
    corr = np.corrcoef(Xs, rowvar=False)
    eigvals, eigvecs = np.linalg.eigh(corr)
    order = np.argsort(eigvals)[::-1]
    eigvals, eigvecs = eigvals[order], eigvecs[:, order]
    explained = eigvals / eigvals.sum()
    scores = Xs @ eigvecs
    return corr, eigvals, explained, eigvecs, scores, Xs

def orient_pc1(loadings, scores):
    """Flip PC1 so net loading sum >= 0 (dominant loading block positive)."""
    L = loadings[:, 0].copy()
    s = scores[:, 0].copy()
    if L.sum() < 0:
        L, s = -L, -s
    return L, s

def phase_summary(s):
    return {"mean": float(s.mean()), "min": float(s.min()), "max": float(s.max())}

df, zcols = load_capital(RAW)
Z = df[zcols].values
print("=== INPUT ===")
print("slices:", df["BCE"].min(), "->", df["BCE"].max(), "n =", len(df))
print("variables:", zcols)
print("group counts:", df["group"].value_counts().to_dict())

# ---- MAIN PCA: full window (39 slices) ----
corr, ev, expl, loadings, scores, Xs = pca_corr(Z)
L1, S1 = orient_pc1(loadings, scores)
print("\n=== MAIN PCA (all 39 century slices, BCE 4300-500) ===")
print("eigenvalues (PC1..PCn):", np.round(ev, 3))
print("explained variance:", np.round(expl, 4))
print("PC1 explained %.1f%% ; PC2 explained %.1f%% ; PC1+PC2 = %.1f%%"
      % (100*expl[0], 100*expl[1], 100*(expl[0]+expl[1])))

print("\nPC1 loadings (oriented: net loading sum = %.3f >= 0)" % L1.sum())
LOAD = pd.DataFrame({"variable": zcols, "loading_PC1": L1})
LOAD["grouping"] = LOAD["variable"].map({
    "ZAxtSchwert": "symbolic", "ZDolch": "symbolic", "ZCU_AU": "symbolic", "Zamber": "symbolic",
    "ZMonument": "social", "ZMW": "social", "ZHort": "social",
    "Zhausgr": "economic", "ZSichel": "economic", "ZBeil": "economic",
    "ZKeform": "cultural", "Zkeverz": "cultural",
})
LOAD = LOAD.sort_values("loading_PC1", ascending=False)
LOAD.to_csv("analysis/capital_pca_loadings.csv", index=False)
print(LOAD.round(3).to_string(index=False))

df["PC1"] = S1
print("\n=== PC1 TIME SERIES (oriented) ===")
print(df[["BCE", "group", "PC1"]].round(3).to_string(index=False))

# ---- Phase characterization (full-window PCA) ----
mn = df[(df["BCE"] >= 3000) & (df["BCE"] <= 3400)]
yn = df[(df["BCE"] >= 2300) & (df["BCE"] <= 2900)]
print("\n=== PHASE CHARACTERIZATION (full-window PC1) ===")
print("Middle Neolithic  MN  3400-3000 :", phase_summary(mn["PC1"].values))
print("Younger Neolithic SG  2900-2300 :", phase_summary(yn["PC1"].values))
print("diff (MN mean - YN mean):", round(mn["PC1"].mean() - yn["PC1"].mean(), 3))
r3000 = df[df["BCE"] == 3000]["PC1"].iloc[0]
r2900 = df[df["BCE"] == 2900]["PC1"].iloc[0]
print("transition 3000->2900: PC1(3000)=%.3f  PC1(2900)=%.3f  (sign flip? %s)"
      % (r3000, r2900, (r3000 >= 0) != (r2900 >= 0)))
print("MN PC1 all < 0?", bool((mn["PC1"] < 0).all()), "| YN PC1 all < 0?", bool((yn["PC1"] < 0).all()))

# ---- Robustness ----
print("\n=== ROBUSTNESS ===")
configs = {
    "Neolithic-only (4100-2200 BCE)": (df["BCE"].between(2200, 4100).values, zcols),
    "drop ZSichel (full window)": (np.ones(len(df), bool), [c for c in zcols if c != "ZSichel"]),
    "Neolithic-only AND drop ZSichel": (df["BCE"].between(2200, 4100).values, [c for c in zcols if c != "ZSichel"]),
}
for name, (mask, cols) in configs.items():
    sub = df.loc[mask].copy()
    Xc = sub[cols].values
    _, evc, explc, loadc, scorec, _ = pca_corr(Xc)
    Lc, Sc = orient_pc1(loadc, scorec)
    sub["PC1r"] = Sc
    mnm = sub[(sub["BCE"] >= 3000) & (sub["BCE"] <= 3400)]["PC1r"].mean()
    ynm = sub[(sub["BCE"] >= 2300) & (sub["BCE"] <= 2900)]["PC1r"].mean()
    top = pd.Series(Lc, index=cols).sort_values()
    print("- %s:" % name)
    print("    PC1 expl=%.1f%% ; net loading sum=%.3f ; strongest + : %s ; strongest - : %s"
          % (100*explc[0], Lc.sum(),
             ", ".join(f"{v} {w:+.3f}" for v, w in top.sort_values(ascending=False).head(3).items()),
             ", ".join(f"{v} {w:+.3f}" for v, w in top.head(3).items())))
    print("    MN mean=%+.3f , YN mean=%+.3f , MN-YN=%+.3f ; same side of zero (no phase sign flip): %s"
          % (mnm, ynm, mnm - ynm, (mnm >= 0) == (ynm >= 0)))

# exports
df.round(6).to_csv("analysis/capital_pca_outputs.csv", index=False)
print("\nWrote analysis/capital_pca_outputs.csv and analysis/capital_pca_loadings.csv")
