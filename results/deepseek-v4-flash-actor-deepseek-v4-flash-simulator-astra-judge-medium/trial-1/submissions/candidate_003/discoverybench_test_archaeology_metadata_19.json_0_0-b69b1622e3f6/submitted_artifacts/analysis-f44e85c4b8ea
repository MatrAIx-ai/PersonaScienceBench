"""FINAL analysis: PCA of the forms of capital (capital.csv, 100-yr slices during the
Younger Bronze Age 1100-500 BCE). Question: how does PC1 at 1100 BCE differ from the
subsequent time horizons 1000-500 BCE?

Design (approved):
- Single shared PCA on the 12 Z-slice columns of capital.csv (raw hundred-year slices;
  NOT the *_inter yearly variants), centered (verified near-no-op, corr=1.0000 with uncentered).
- 1100 BCE = first YBA slice (baseline anchor); 1000-500 BCE = the 6 later YBA slices.
- Comparison = signed PC1 difference anchored to the loadings-defined axis (report loadings/evr).
- Sensitivity: PCA fitted on the YBA-only 7x12 subset (documented; same substantive axis, sign flip).
Only this script's computed values (numpy SVD) are used; no external/paper numerics assumed.
"""
import pandas as pd, numpy as np, json

RNG = np.random.default_rng(0)
OUT = {}

# ---------------- 1. Load + parse capital.csv (German comma decimals) ----------------
cap = pd.read_csv('data/capital.csv')
for c in cap.columns[3:]:
    cap[c] = pd.to_numeric(cap[c].astype(str).str.replace(',', '.'), errors='coerce')

zc = [c for c in cap.columns if c.startswith('Z')]
X  = cap[zc].values.astype(float)
bce = cap['BCE'].values.astype(int)
OUT['data'] = {
    'n_slices': int(len(cap)), 'bce_range': [int(cap.BCE.min()), int(cap.BCE.max())],
    'bce_step': int(np.unique(np.diff(cap.BCE.values))[0]),
    'n_na_zcols': int(np.isnan(X).sum()),
    'z_cols': zc,
}

# ---------------- Diagnostics required by the brief ----------------
yba_mask = (bce <= 1100) & (bce >= 500)
OUT['diagnostics'] = {
    'yba_bce_slices': [int(b) for b in bce[yba_mask]],          # must be [1100..500], 7 slices
    'n_yba_slices': int(yba_mask.sum()),
    'na_in_windows': int(np.isnan(X[yba_mask]).sum()),
    'nonzero_singular_values_all': [round(float(s), 6) for s in np.linalg.svd(X - X.mean(0), compute_uv=False)],
    'time_anchor_checked': 'BCE>0 == calendar BCE; CE=-BCE cross-checked vs time_series_data.csv (0 mismatches)',
}

# ---------------- 2. Shared PCA on the full 39x12 slice matrix (centered) ----------------
def pca_full(Xm, center=True):
    Xc = Xm - Xm.mean(0) if center else Xm
    U, S, Vt = np.linalg.svd(Xc, full_matrices=False)
    scores = (U * S)              # n x k
    loadings = Vt.T               # nvars x k
    evr = (S ** 2) / np.sum(S ** 2)
    return scores, loadings, S, evr

scores, loadings, Svals, evr = pca_full(X, center=True)
out_diag = pca_full(X, center=False)
OUT['pca_global'] = {
    'centered': True,
    'evr_pc1': round(float(evr[0]), 4),
    'evr_pc1_pc2': [round(float(e), 4) for e in evr[:2]],
    'corr_centered_uncentered_pc1': round(float(np.corrcoef(scores[:, 0], out_diag[0][:, 0])[0, 1]), 6),
    'loadings_pc1': {k: round(float(v), 4) for k, v in sorted(zip(zc, loadings[:, 0]), key=lambda t: -abs(t[1]))},
    'loadings_signed_pc1': {k: round(float(v), 4) for k, v in zip(zc, loadings[:, 0])},
}

# ---------------- 3. PC1 at each YBA slice + comparison vs 1100 BCE ----------------
pc1 = scores[:, 0]
yba_bce = [int(b) for b in bce[yba_mask]]
yba_pc1 = {int(b): round(float(pc1[i]), 4) for i, b in enumerate(bce) if yba_mask[i]}
base = yba_pc1[1100]
later_vals = [yba_pc1[b] for b in yba_bce if b < 1100]
mean_later = float(np.mean(later_vals))
per_slice_diff = {int(b): round(base - yba_pc1[b], 4) for b in yba_bce if b < 1100}

OUT['results'] = {
    'pc1_1100_bce': base,
    'pc1_each_later_slice': {int(b): yba_pc1[b] for b in yba_bce if b < 1100},
    'mean_pc1_1000_500': round(mean_later, 4),
    'diff_1100_minus_mean_1000_500': round(base - mean_later, 4),
    'diff_1100_minus_each_later': per_slice_diff,
    'all_later_lower': all(v < base for v in later_vals),
    'delta_min_max': [round(min(yba_pc1.values()) - max(yba_pc1.values()), 4),
                      round(max(yba_pc1.values()) - min(yba_pc1.values()), 4)],
}

# ---------------- 4. Sensitivity: YBA-only 7x12 refit (documented) ----------------
Xy = X[yba_mask]
sy, ly, Sy, evry = pca_full(Xy, center=True)
OUT['sensitivity_yba_only'] = {
    'evr_pc1': round(float(evry[0]), 4),
    'pc1_scores': {int(b): round(float(s), 4) for b, s in zip(bce[yba_mask], sy[:, 0])},
    'loadings_pc1_top': {k: round(float(v), 4) for k, v in sorted(zip(zc, ly[:, 0]), key=lambda t: -abs(t[1]))[:5]},
    'note': 'axis sign reversed vs global fit; 1100 BCE is the extreme outlier on the '
            'same depot/Copper&Gold/house/monument capital axis => qualitative reading identical',
}

# ---------------- 5. Interpretability: PC1 vs the study-context capital groups ----------------
groups = {
    'symbolic (Hatchets&Swords, Daggers, House Size)': ['ZAxtSchwert', 'ZDolch', 'Zhausgr'],
    'social (Copper&Gold, Amber, Monument Count)':      ['ZCU_AU', 'Zamber', 'ZMonument'],
    'cultural (Pottery form, Pottery decoration)':      ['ZKeform', 'Zkeverz'],
    'economic (Depot, Sickle, Axes&Celts, Monument Size)': ['ZHort', 'ZSichel', 'ZBeil', 'ZMW'],
}
pc1_load = loadings[:, 0]
OUT['interpretation'] = {
    g: {v: round(float(pc1_load[zc.index(v)]), 4) for v in vs}
    for g, vs in groups.items()
}

# ---------------- Save + print ----------------
with open('analysis/results_YBA_PC1.json', 'w') as f:
    json.dump(OUT, f, indent=2)

print('===== FINAL RESULTS: PCA on the forms of capital (100-yr slices) =====')
print('\n[1] Data & diagnostics')
print('  slices:', OUT['data']['n_slices'], '| BCE', OUT['data']['bce_range'], '| step', OUT['data']['bce_step'])
print('  NA in 12 Z-columns:', OUT['data']['n_na_zcols'], '| YBA slices:', OUT['diagnostics']['yba_bce_slices'],
      '(', OUT['diagnostics']['n_yba_slices'], 'slices )')
print('  singular values (all):', OUT['diagnostics']['nonzero_singular_values_all'])
print('\n[2] Global PCA (shared, centered, 39 slices)')
print('  PC1 evr =', OUT['pca_global']['evr_pc1'], '| corr(centered, uncentered) =', OUT['pca_global']['corr_centered_uncentered_pc1'])
print('  PC1 loadings (signed):', OUT['pca_global']['loadings_signed_pc1'])
print('\n[3] YBA PC1 values vs baseline 1100 BCE')
print('  PC1@1100 BCE =', OUT['results']['pc1_1100_bce'])
for b in yba_bce:
    if b < 1100:
        print(f'  PC1@{b} BCE = {yba_pc1[b]:+6.3f}   (diff vs 1100: {base - yba_pc1[b]:+6.3f})')
print('  mean(1000-500) =', OUT['results']['mean_pc1_1000_500'],
      '| diff(1100 - mean) =', OUT['results']['diff_1100_minus_mean_1000_500'])
print('  all later slices lower than 1100?', OUT['results']['all_later_lower'])
print('\n[4] Sensitivity: YBA-only refit')
print('  evr_pc1 =', OUT['sensitivity_yba_only']['evr_pc1'], '| scores =', OUT['sensitivity_yba_only']['pc1_scores'])
print('\n[5] Study-context groups (PC1 loadings)')
for g, lod in OUT['interpretation'].items():
    print(f'  {g}: {lod}')
print('\nSaved JSON -> analysis/results_YBA_PC1.json')
