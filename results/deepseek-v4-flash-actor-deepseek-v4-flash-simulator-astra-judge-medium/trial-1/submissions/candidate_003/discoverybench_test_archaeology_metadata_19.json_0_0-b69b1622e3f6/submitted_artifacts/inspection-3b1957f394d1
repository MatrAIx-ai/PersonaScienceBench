"""Inspection + exploratory PCA for the forms-of-capital (YBA 1100-500 BCE) task.
DiscoveryBench: archaeology / metadata_19. Handoff stage = plan (inspection only)."""
import pandas as pd, numpy as np

def parse_comma_decimal(s):
    return pd.to_numeric(str(s).replace(',', '.'), errors='coerce')

cap = pd.read_csv('data/capital.csv')
for c in cap.columns[3:]:
    cap[c] = pd.to_numeric(cap[c].astype(str).str.replace(",", "."), errors="coerce")
zc = [c for c in cap.columns if c.startswith('Z')]
print('[capital.csv] shape', cap.shape)
print('[capital.csv] cols:', list(cap.columns))
print('[capital.csv] BCE range:', cap['BCE'].min(), '-', cap['BCE'].max(),
      '| unique step=', np.unique(np.diff(cap['BCE'])), '| descending?', cap['BCE'].is_monotonic_decreasing)
print('[capital.csv] groups:', cap['group'].value_counts().to_dict())
print('[capital.csv] NA:', int(cap.isna().sum().sum()))
print('[capital.csv] Z global mean:', cap[zc].mean().round(3).to_dict())
print('[capital.csv] Z global sd  :', cap[zc].std().round(3).to_dict())
print('[capital.csv] YBA rows (BCE):', cap.loc[cap.group=='YBA','BCE'].tolist())

ts = pd.read_csv('data/time_series_data.csv', index_col=0)
raw12 = ['HatchetSword','Dagger','HouseSize','CopperGold','Amber','MonumentCount',
         'Depot','Sickle','AxesCelts','MonumentSize','PotteryForm','PotteryDecoration']
inter12 = [c+'_inter' for c in raw12]
print('\n[time_series] shape', ts.shape, '| CE', ts.CE.min(), ts.CE.max(),
      '| calBP', ts.calBP.min(), ts.calBP.max(), '| step', np.unique(ts.calBP.diff().dropna()))
print('[time_series] raw12 nonNA per col:', ts[raw12].notna().sum().to_dict())
print('[time_series] inter12 nonNA (first 2):', ts[inter12].notna().sum().head(2).to_dict())
print('[time_series] pollen NA raw/inter/detrend/grate:',
      int(ts['pollen'].isna().sum()), ts['pollen_inter'].isna().sum(),
      ts['pollen_detrend'].isna().sum(), ts['pollen_grate_100'].isna().sum())

pol = pd.read_csv('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv')
print('\n[pollen] shape', pol.shape, '| cols:', list(pol.columns))
print('[pollen] firstcol min/max:', pol.iloc[:,0].min(), pol.iloc[:,0].max(),
      '| firstcol==CE col?', (pol['CE']==pol.iloc[:,0]).all())
print('[pollen] NA: Belau_PC1', pol['Belau_PC1'].isna().sum(), '| Woserin_PC1',
      pol['Woserin_PC1'].isna().sum(), '| MEAN/inter/smooths', int(pol['MEAN'].isna().sum()))

m = {'ZAxtSchwert':'HatchetSword','ZDolch':'Dagger','Zhausgr':'HouseSize','ZCU_AU':'CopperGold',
     'Zamber':'Amber','ZMonument':'MonumentCount','ZHort':'Depot','ZSichel':'Sickle',
     'ZBeil':'AxesCelts','ZMW':'MonumentSize','ZKeform':'PotteryForm','Zkeverz':'PotteryDecoration'}
n=0; bad=0
for _,r in cap[cap.BCE<=4100].iterrows():
    row = ts[ts['CE']==-int(r.BCE)]
    if row.empty: continue
    for k,v in m.items():
        n+=1
        if abs(r[k]-row[v].iloc[0])>1e-9: bad+=1
print('\n[cross-check] capital vs time_series raw @100yr marks: n=', n, 'mismatches=', bad)

def pca1(X, center=True):
    Xc = X - X.mean(0) if center else X
    U,S,Vt = np.linalg.svd(Xc, full_matrices=False)
    return (U*S)[:,0], Vt.T[:,0], S[0], (S**2)/sum(S**2)

X = cap[zc].values; bce = cap['BCE'].values; yba = (bce<=1100)&(bce>=500)
scores, load, Sval, evr = pca1(X, center=True)
print('\n[PCA global, all 39 slices] PC1 evr=%.3f' % evr[0])
print('[PCA global] PC1 loadings:', {k: round(float(v),3) for k,v in sorted(zip(zc,load), key=lambda t:-abs(t[1]))})
print('[PCA global] YBA PC1:', {int(b): round(float(scores[i]),3) for i,b in enumerate(bce) if yba[i]})
base = scores[np.where(bce==1100)[0][0]]
later = [scores[i] for i,b in enumerate(bce) if (bce[i]<=1000)&(bce[i]>=500)]
print('[PCA global] PC1@1100=%.3f | mean(1000-500)=%.3f | diff=+%.3f' % (base, np.mean(later), base-np.mean(later)))

scores_y, load_y, S_y, evr_y = pca1(X[yba], center=True)
print('[PCA YBA-only] PC1 evr=%.3f ; YBA PC1:' % evr_y[0],
      {int(b): round(float(s),3) for b,s in zip(bce[yba], scores_y)})

s_nc, _, _, _ = pca1(X, center=False)
print('[robust] corr(centered, non-centered PC1)=%.4f' % np.corrcoef(scores, s_nc)[0,1])
