"""
PCA on forms of capital, analyzed in hundred-year time slices (capital.csv).
Question: how are symbolic capital components (house size, daggers, hatchets/swords)
characterized by their PC1 values and their distribution across PC2?

Pipeline
 1. capital.csv = authoritative hundred-year time-slice dataset (39 centuries 4300..500 BCE
    x 12 capital variables as standardized Z-scores). Each row is one 100-year slice.
 2. Pooled PCA on the 39x12 matrix: slices are observations, capital forms are variables.
    Variables are re-standardized before SVD (correlation-based PCA; near-identical to
    covariance PCA because inputs are already Z-scores).
 3. Symbolic capital = ZAxtSchwert (hatchets/swords), ZDolch (daggers), Zhausgr (house size).
 4. Consistency: PCA on the 37 overlapping century rows of capital.csv (BCE 4100..500)
    vs PCA on the 37 raw century rows of time_series_data.csv (values verified identical,
    max abs diff = 0.0) -> loadings must match.
"""
import csv
import numpy as np
import pandas as pd

# ---------------- loading ----------------
def parse_cap(fn):
    """capital.csv uses comma as decimal separator inside quoted fields."""
    with open(fn, newline='', encoding='utf-8-sig') as f:
        rows = list(csv.reader(f))
    header, data = rows[0], []
    for r in rows[1:]:
        rec = {}
        for h, v in zip(header, r):
            v = v.strip().strip('"').replace(',', '.')
            try:
                rec[h] = float(v)
            except ValueError:
                rec[h] = v
        data.append(rec)
    return pd.DataFrame(data)

cap = parse_cap('data/capital.csv')
cap['BCE'] = cap['BCE'].astype(int)
cap = cap.sort_values('BCE', ascending=False).reset_index(drop=True)
zcols = [c for c in cap.columns if c.startswith('Z')]
X39 = cap[zcols].astype(float).values          # 39 slices x 12 capital variables
century = cap['BCE'].values
groups = cap['group'].values

# ---------------- PCA on standardized data ----------------
def pca(X):
    Xs = (X - X.mean(axis=0)) / X.std(axis=0, ddof=1)
    U, S, Vt = np.linalg.svd(Xs, full_matrices=False)
    V = Vt.T
    eig = S**2 / (X.shape[0] - 1)
    return dict(Xs=Xs, V=V, eig=eig, var_ratio=eig/eig.sum(),
                cum=eig.cumsum()/eig.sum(),
                scores=Xs @ V)

def fix_sign(res, k):
    """arbitrary PC sign: make the largest-|loading| variable positive on that PC."""
    v = res['V'][:, k]; i = int(np.argmax(np.abs(v)))
    if v[i] < 0:
        res['V'][:, k] *= -1
        res['scores'][:, k] *= -1

r39 = pca(X39)
fix_sign(r39, 0); fix_sign(r39, 1)
V39, S39 = r39['V'], r39['scores']

# ---------------- 1. Diagnostics (39 slices) ----------------
print("="*76)
print("PCA on forms of capital - hundred-year time slices (capital.csv, N=%d)" % len(cap))
print("="*76)
print("\n[1] Explained variance (39-slice PCA)")
print("  PC1: lambda=%.4f  variance share=%.4f (%.1f%%)   | cumulative PC1=%.1f%%"
      % (r39['eig'][0], r39['var_ratio'][0], 100*r39['var_ratio'][0], 100*r39['cum'][0]))
print("  PC2: lambda=%.4f  variance share=%.4f (%.1f%%)   | cumulative PC1+PC2=%.1f%%"
      % (r39['eig'][1], r39['var_ratio'][1], 100*r39['var_ratio'][1], 100*r39['cum'][1]))

print("\n[2] Loadings on PC1 and PC2 (standardized eigenvector coefficients; correlation loading in parentheses)")
load = pd.DataFrame({'variable': zcols,
                     'PC1_coef': V39[:, 0], 'PC1_corr': V39[:, 0]*np.sqrt(r39['eig'][0]),
                     'PC2_coef': V39[:, 1], 'PC2_corr': V39[:, 1]*np.sqrt(r39['eig'][1])})
load['r1'] = load['PC1_coef'].abs().rank(ascending=False).astype(int)
load['r2'] = load['PC2_coef'].abs().rank(ascending=False).astype(int)
for _, r in load.sort_values('r1').iterrows():
    print("  %-11s PC1=%+0.4f (%.3f) |PC1|r=%d  |  PC2=%+0.4f (%.3f) |PC2|r=%d"
          % (r['variable'], r['PC1_coef'], r['PC1_corr'], r['r1'], r['PC2_coef'], r['PC2_corr'], r['r2']))

print("\n[3] Summary of the three symbolic capital components (39-slice loadings)")
sym = load[load['variable'].isin(['Zhausgr', 'ZDolch', 'ZAxtSchwert'])]
for _, r in sym.iterrows():
    print("  %-11s PC1=%+.4f (rank %d/12 by |PC1|), PC2=%+.4f (rank %d/12 by |PC2|)"
          % (r['variable'], r['PC1_coef'], r['r1'], r['PC2_coef'], r['r2']))
print("  PC2 loadings of the three symbolic components span %.4f (Zhausgr) to %.4f (ZAxtSchwert)"
      % (sym['PC2_coef'].min(), sym['PC2_coef'].max()))

print("\n[4] Per-century PC1 and PC2 scores (standardized)")
sc = pd.DataFrame({'BCE': century, 'group': groups, 'PC1': S39[:, 0], 'PC2': S39[:, 1]})
print(sc.to_string(index=False))
print("\n  PC1 score range: %+.4f .. %+.4f (span %.4f); PC2 score range: %+.4f .. %+.4f (span %.4f)"
      % (S39[:, 0].min(), S39[:, 0].max(), S39[:, 0].max()-S39[:, 0].min(),
         S39[:, 1].min(), S39[:, 1].max(), S39[:, 1].max()-S39[:, 1].min()))
print("  PC2 score by period group (mean):")
print(sc.groupby('group')['PC2'].mean().round(3).to_string())

# ---------------- 4. Consistency checks ----------------
print("\n" + "="*76)
print("[5] Consistency checks")
print("="*76)
ts = pd.read_csv('data/time_series_data.csv')
ts_map = {'HatchetSword':'ZAxtSchwert','Dagger':'ZDolch','HouseSize':'Zhausgr',
          'CopperGold':'ZCU_AU','Amber':'Zamber','MonumentCount':'ZMonument',
          'Depot':'ZHort','Sickle':'ZSichel','AxesCelts':'ZBeil',
          'MonumentSize':'ZMW','PotteryForm':'ZKeform','PotteryDecoration':'Zkeverz'}
sub = ts[ts[list(ts_map)].notna().all(axis=1)].sort_values('CE').reset_index(drop=True)
colmatch = [list(ts_map.keys())[list(ts_map.values()).index(z)] for z in zcols]
Xts = sub[colmatch].astype(float).values                       # 37 century rows from time_series

# identity of values: capital rows BCE 4100..500 vs ts rows CE -4100..-500
cap_o = cap[(cap['BCE'] >= 500) & (cap['BCE'] <= 4100)].reset_index(drop=True)
A = cap_o[zcols].astype(float).values
print("  (a) capital(37 rows, BCE 4100..500) vs time_series raw(37 rows): max abs diff = %.9f" % np.abs(A-Xts).max())

# identity of loadings: PCA on capital 37 rows vs PCA on time_series 37 rows
rA = pca(A); rB = pca(Xts)
d1 = np.abs(rA['V'] - rB['V']).max()
print("  (b) max |diff| of PC1..PC12 loading columns, capital-37 vs time_series-37 PCA: %.2e" % d1)
print("      (PC1..PC2 coefficients identical to machine precision: "
      + " & ".join("%.2e" % np.abs(rA['V'][:,k]-rB['V'][:,k]).max() for k in (0,1)) + ")")

# sensitivity: 39-slice vs 37-slice loadings (sign-aligned)
r37, _ = rA, None
def align(a, b):
    b2 = b.copy()
    for k in range(b.shape[1]):
        if a[:, k] @ b[:, k] < 0:
            b2[:, k] *= -1
    return b2
V37al = align(V39, rA['V'])
print("  (c) 39-slice vs 37-row capital PCA (sign-aligned, sensitivity to the two extra early rows):")
for z, a, b in zip(zcols, V39, V37al):
    if z in ('Zhausgr','ZDolch','ZAxtSchwert','ZCU_AU','ZBeil'):
        print("      %-11s PC1 39=%+.4f vs 37=%+.4f | PC2 39=%+.4f vs 37=%+.4f"
              % (z, a[0], b[0], a[1], b[1]))
print("      max |diff| 39 vs 37: PC1=%.4f, PC2=%.4f (PC1 structure stable; PC2 shifts slightly because"
      % (np.abs(V39[:,0]-V37al[:,0]).max(), np.abs(V39[:,1]-V37al[:,1]).max()))
print("      the two extra early Neolithic rows carry extreme values, e.g. ZMW=-3.13, ZKeform=-1.13)")
print("\nDONE")
