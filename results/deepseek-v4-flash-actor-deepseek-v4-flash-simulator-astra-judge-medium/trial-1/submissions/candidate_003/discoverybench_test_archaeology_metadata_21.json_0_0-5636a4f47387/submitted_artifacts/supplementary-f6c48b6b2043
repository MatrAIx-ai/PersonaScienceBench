import csv, numpy as np, pandas as pd
# recompute 39-slice loadings quickly (same as analysis_pca_capital.py)
def parse_cap(fn):
    with open(fn, newline='', encoding='utf-8-sig') as f: rows=list(csv.reader(f))
    header,data=rows[0],[]
    for r in rows[1:]:
        rec={}
        for h,v in zip(header,r):
            v=v.strip().strip('"').replace(',','.')
            try: rec[h]=float(v)
            except ValueError: rec[h]=v
        data.append(rec)
    return pd.DataFrame(data)
cap=parse_cap('data/capital.csv'); cap['BCE']=cap['BCE'].astype(int)
cap=cap.sort_values('BCE',ascending=False).reset_index(drop=True)
zcols=[c for c in cap.columns if c.startswith('Z')]
X=cap[zcols].astype(float).values
Xs=(X-X.mean(0))/X.std(0,ddof=1)
U,S,Vt=np.linalg.svd(Xs,full_matrices=False); V=Vt.T; eig=S**2/(len(X)-1)
for k in (0,1):
    i=int(np.argmax(np.abs(V[:,k])))
    if V[i,k]<0: V[:,k]*=-1
scores=Xs@V

print("Angles of symbolic-capital loading vectors from the PC1 axis (degrees):")
for z in ['ZAxtSchwert','ZDolch','Zhausgr']:
    i=zcols.index(z)
    ang=np.degrees(np.arctan2(V[i,1], V[i,0]))
    print("  %-11s (PC1=%+.4f, PC2=%+.4f) -> angle from PC1 axis = %5.2f deg"%(z,V[i,0],V[i,1],ang))
ang_da=np.degrees(np.arctan2(V[zcols.index('ZDolch'),1],V[zcols.index('ZDolch'),0])-np.arctan2(V[zcols.index('ZAxtSchwert'),1],V[zcols.index('ZAxtSchwert'),0]))
ang_hd=np.degrees(np.arctan2(V[zcols.index('Zhausgr'),1],V[zcols.index('Zhausgr'),0])-np.arctan2(V[zcols.index('ZDolch'),1],V[zcols.index('ZDolch'),0]))
print("  Dagger minus Hatchet/Sword: %+.2f deg ; House size minus Dagger: %+.2f deg"% (ang_da,ang_hd))

# Save output artifacts
load=pd.DataFrame({'variable':zcols,'PC1_coef':V[:,0],'PC1_corr':V[:,0]*np.sqrt(eig[0]),
                   'PC2_coef':V[:,1],'PC2_corr':V[:,1]*np.sqrt(eig[1])})
load.loc[:,'r1']=load['PC1_coef'].abs().rank(ascending=False).astype(int)
load.loc[:,'r2']=load['PC2_coef'].abs().rank(ascending=False).astype(int)
load.to_csv('output_loadings.csv',index=False)
sc=pd.DataFrame({'BCE':cap['BCE'].values,'group':cap['group'].values,
                 'PC1':scores[:,0],'PC2':scores[:,1]})
sc.to_csv('output_scores.csv',index=False)
print("\nSaved output_loadings.csv and output_scores.csv")
print("Variance shares:", (eig/eig.sum()).round(4)[:3].tolist(), "cum:", (eig.cumsum()/eig.sum()).round(4)[:3].tolist())
