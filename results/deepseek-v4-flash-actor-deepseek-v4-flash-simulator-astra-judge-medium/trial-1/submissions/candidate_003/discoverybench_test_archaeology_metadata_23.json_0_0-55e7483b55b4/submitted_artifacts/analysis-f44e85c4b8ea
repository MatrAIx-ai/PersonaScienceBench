"""Final analysis: 3400-3000 BCE window, MonumentCount & AxesCelts vs symbolic capital.
Units of analysis: 5 raw 100-yr bins. Interpolated columns used only as robustness footnote.
Run: python3 analysis/window_analysis.py
"""
import pandas as pd, numpy as np, math
from scipy import stats

CWD='data/'
ts  = pd.read_csv(CWD+'time_series_data.csv')
pol = pd.read_csv(CWD+'pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv', decimal=',')

bins = ts[(ts.CE>=-3400)&(ts.CE<=-3000) & ts['HatchetSword'].notna()].copy().reset_index(drop=True)
dv   = ['MonumentCount','AxesCelts']
pred = ['HatchetSword','Dagger','HouseSize']

pb = pol[(pol.CE<=-3000)&(pol.CE>=-3400)].sort_values('CE')
pb = pb[pb.CE.isin([-3400,-3300,-3200,-3100,-3000])].set_index('CE')
tsb = ts[ts.CE.isin([-3400,-3300,-3200,-3100,-3000])].set_index('CE')
bins['o100y'] = bins.CE.map(pb['SMOOTH_MEAN_100y'])
bins['grow']  = bins.CE.map(tsb['pollen_grate_100'])

def slope(y):
    return np.polyfit(np.arange(len(y)), y, 1)[0]

def fisher_ci(r, n=5):
    if not np.isfinite(r): return (np.nan, np.nan)
    z=np.arctanh(np.clip(r,-0.9999,0.9999)); se=1/math.sqrt(n-3)
    return np.tanh(z-1.96*se), np.tanh(z+1.96*se)

L=[]
L.append('WINDOW 3400-3000 BCE (5 raw 100-yr bins; calBP 5350-4950)')
L.append('')
L.append('Bins (CE / calBP / MonumentCount / AxesCelts / HatchetSword / Dagger / HouseSize):')
for _,r in bins.iterrows():
    L.append(f"  {r.CE} {int(r.calBP)} {r.MonumentCount:+.4f} {r.AxesCelts:+.4f} {r.HatchetSword:+.4f} {r.Dagger:+.4f} {r.HouseSize:+.4f}")
L.append('')
L.append('TREND SLOPES (OLS, Z per 100 yr):')
for c in dv+pred:
    L.append(f"  {c}: {slope(bins[c]):+.4f}")
L.append('')
L.append('START->END CHANGE (last-first):')
first, last = bins.iloc[0], bins.iloc[-1]
for c in dv+pred:
    L.append(f"  {c}: {last[c]-first[c]:+.4f}")
L.append('')
L.append('CORRELATIONS over n=5 bins (Pearson r + Fisher 95% CI; Spearman rho):')
for d in dv:
    for p in pred:
        if bins[p].std()==0:
            L.append(f"  r({d},{p}) = NaN (zero variance: {p} constant in window)")
            continue
        pr,pp=stats.pearsonr(bins[p],bins[d]); lo,hi=fisher_ci(pr)
        sr,sp=stats.spearmanr(bins[p],bins[d])
        L.append(f"  r({d},{p}) = {pr:+.3f} [95%CI {lo:+.3f}..{hi:+.3f}] p={pp:.3f} | rho={sr:+.3f} (p={sp:.3f})")
L.append('')
L.append('DESCRIPTIVE POLLEN CONTROL (r over n=5 bins; openness=SMOOTH_MEAN_100y, growth=pollen_grate_100):')
for d in dv:
    ro,_ = stats.pearsonr(bins['o100y'], bins[d])
    rg,_ = stats.pearsonr(bins['grow'], bins[d])
    L.append(f"  {d}: r(openness)={ro:+.3f}, r(growth)={rg:+.3f}")
    r_h,_ = stats.pearsonr(bins['HouseSize'],bins[d])
    for name, ctrl in [('openness','o100y'),('growth','grow')]:
        r_dc,_=stats.pearsonr(bins[ctrl],bins[d]); r_hc,_=stats.pearsonr(bins[ctrl],bins['HouseSize'])
        denom=np.sqrt((1-r_dc**2)*(1-r_hc**2))
        prt=(r_h-r_dc*r_hc)/denom if denom>0 else np.nan
        L.append(f"    partial r({d}, HouseSize | {name}) = {prt:+.3f} (zero-order {r_h:+.3f})")
ann = ts[(ts.CE>=-3400)&(ts.CE<=-3000)]
L.append('')
L.append('FOOTNOTE (robustness, NOT primary): annual interpolated r over 401 pts (inflated n):')
for d in dv:
    rh,_=stats.pearsonr(ann[d+'_inter'],ann['HouseSize_inter'])
    L.append(f"  r_inter({d},HouseSize) = {rh:+.3f}")

txt='\n'.join(L)
with open('analysis/results.txt','w') as f:
    f.write(txt)
print(txt)

# ASCII chart (matplotlib unavailable in this env)
def ascii_row(x):
    w=42; lo,hi=-2.0,3.0
    pos=int((x-lo)/(hi-lo)*w); pos=max(0,min(w-1,pos))
    return '.'*pos+'|'+'.'*(w-pos-1)
print('\nASCII linecharts (x window = Z -2..+3):')
for c in dv+pred+['o100y','grow']:
    print(f'{c:14s}: ' + '  '.join(f'CE{r.CE}:'+ascii_row(r[c]) for _,r in bins.iterrows()))
