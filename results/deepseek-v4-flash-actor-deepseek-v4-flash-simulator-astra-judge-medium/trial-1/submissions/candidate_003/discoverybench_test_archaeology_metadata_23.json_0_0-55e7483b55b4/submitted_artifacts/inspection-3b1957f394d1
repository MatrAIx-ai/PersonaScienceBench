"""Data inspection for the 3400-3000 BCE window (planning stage only).
Run: python3 analysis/inspect_data.py
"""
import pandas as pd, numpy as np

print('='*70)
print('1) time_series_data.csv')
ts = pd.read_csv('data/time_series_data.csv')
print('shape:', ts.shape)
print('CE range:', ts.CE.min(), ts.CE.max(), '| calBP range:', ts.calBP.min(), ts.calBP.max())
print('calBP = 1950 - CE (annual, CE step=1)')
nn = ts[ts['MonumentCount'].notna()]
print('raw non-null points per variable = 37, at CE multiples of 100 -> 100-year bins confirmed')
w = ts[(ts.CE>=-3400)&(ts.CE<=-3000)]
print('window rows by CE -3400..-3000:', len(w), '(calBP 5350..4950)')
print('raw (100-yr) bins in window:')
cols=['CE','calBP','HatchetSword','Dagger','HouseSize','MonumentCount','AxesCelts']
print(w[w['HatchetSword'].notna()][cols].to_string(index=False))
print('interp columns non-null in window:',
      {c:int(w[c].notna().sum()) for c in ['MonumentCount_inter','AxesCelts_inter','HatchetSword_inter','Dagger_inter','HouseSize_inter','pollen_inter','pollen_inter_100','pollen_grate_100']})

print()
print('='*70)
print('2) capital.csv  (comma decimal separator!)')
cap = pd.read_csv('data/capital.csv', decimal=',')
print('shape:', cap.shape, '| BCE range:', cap.BCE.min(), cap.BCE.max())
print('mapping: ZAxtSchwert=HatchetSword, ZDolch=Dagger, Zhausgr=HouseSize, ZMonument=MonumentCount, ZBeil=AxesCelts')
print('window rows BCE 3400..3000:')
print(cap[(cap.BCE>=3000)&(cap.BCE<=3400)][['BCE','group','ZAxtSchwert','ZDolch','Zhausgr','ZMonument','ZBeil']].to_string(index=False))

print()
print('='*70)
print('3) pollen_openness_score (comma decimal separator!)')
pol = pd.read_csv('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv', decimal=',')
print('shape:', pol.shape, '| CE range:', pol.CE.min(), pol.CE.max(), '| annual, reverse chronological')
pw = pol[(pol.CE<=-3000)&(pol.CE>=-3400)]
print('window rows:', len(pw), '| Belau_PC1 observed in window:', int(pw.Belau_PC1.notna().sum()))
print('openness at 100-yr bins (Belau_PC1_inter / SMOOTH_MEAN_100y):')
print(pw[pw.CE.isin([-3400,-3300,-3200,-3100,-3000])][['CE','calBP','Belau_PC1_inter','SMOOTH_MEAN_100y']].to_string(index=False))
print()
print('NOTE: calBP window for 3400-3000 BCE = 4950..5350 '
      '(researcher draft said 4950-4350, which actually is 3000-2400 BCE)')
