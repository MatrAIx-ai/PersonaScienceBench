import pandas as pd, numpy as np

# ---------- Load ----------
ts = pd.read_csv('data/time_series_data.csv')
cap = pd.read_csv('data/capital.csv')
def num(s): return float(str(s).replace(',','.'))
cap['ZKeform_n'] = cap['ZKeform'].map(num)
cap['Zkeverz_n'] = cap['Zkeverz'].map(num)

# ---------- 1) Cross-file consistency on shared century anchors ----------
tsb = ts[ts['CE'] % 100 == 0][['CE','calBP','PotteryForm','PotteryDecoration']].copy()
cap_map = {r.BCE: (r.ZKeform_n, r.Zkeverz_n) for r in cap.itertuples()}
matched, mism = 0, 0
for _, r in tsb.iterrows():
    bce = -int(r.CE)
    if bce in cap_map:
        matched += 1
        zf, zd = cap_map[bce]
        if abs(zf - r.PotteryForm) > 1e-9 or abs(zd - r.PotteryDecoration) > 1e-9:
            mism += 1
print(f"[1] Cross-file: matched={matched} shared century anchors, mismatches={mism}")

# ---------- 2) Forward century differences (chronologically forward = decreasing BCE) ----------
bce = cap['BCE'].values.astype(int)
F   = cap['ZKeform_n'].values
D   = cap['Zkeverz_n'].values
# change INTO the younger bin bce[i+1] = bce[i]-100
idx_from = bce[:-1]; idx_to = bce[1:]
dF = F[1:] - F[:-1]
dD = D[1:] - D[:-1]
steps = pd.DataFrame({'from_BCE': idx_from, 'to_BCE': idx_to,
                      'dForm': dF, 'dDec': dD,
                      'F_from': F[:-1], 'F_to': F[1:],
                      'D_from': D[:-1], 'D_to': D[1:]})
steps['opposite_raw'] = (steps.dForm < 0) & (steps.dDec > 0)
print(f"[2] Total century transitions (capital): {len(steps)}; "
      f"transitions with raw opposite (dForm<0 & dDec>0): {int(steps.opposite_raw.sum())}")

# ---------- 3) Significance sweep ----------
med_abs_F = steps.dForm.abs().median(); med_abs_D = steps.dDec.abs().median()
mad3_F = 3*np.median(np.abs(steps.dForm - steps.dForm.median()))
mad3_D = 3*np.median(np.abs(steps.dDec - steps.dDec.median()))
print(f"[3] median |dForm|={med_abs_F:.3f}, median |dDec|={med_abs_D:.3f}; "
      f"3*MAD: Form={mad3_F:.3f}, Dec={mad3_D:.3f}")

thresholds = [0.1, 0.2, 0.3, 0.5]
results = {}
for delta in thresholds + ['3xMAD']:
    if delta == '3xMAD':
        mask = (steps.dForm <= -max(0.0, mad3_F)) & (steps.dDec >= max(0.0, mad3_D))
        dl = '3xMAD'
    else:
        mask = (steps.dForm <= -delta) & (steps.dDec >= delta)
        dl = delta
    hit = steps[mask]
    # ensure first time: no earlier transition satisfies condition
    first_ok = True
    if len(hit): 
        first_idx = hit.index[0]
        # check no earlier (older) transition passed and no other at all => uniqueness
        first_ok = (hit.index.tolist() == [first_idx])
    results[dl] = {'delta': dl, 'n_hits': len(hit),
                   'first': hit[['from_BCE','to_BCE','dForm','dDec']].to_dict('records') if len(hit) else [],
                   'unique': first_ok}
    print(f"    threshold={dl}: n_hits={len(hit)}, unique_first={first_ok}, "
          f"first={hit[['from_BCE','to_BCE','dForm','dDec']].values.round(3).tolist() if len(hit) else []}")

# ---------- 4) Candidate detail ----------
cand = steps[(steps.dForm < 0) & (steps.dDec > 0)]
print("\n[4] Candidate transition detail (capital.csv):")
print(cand[['from_BCE','to_BCE','F_from','F_to','dForm','D_from','D_to','dDec']].to_string(index=False))

# ---------- 5) Same check on time_series_data raw anchors (overlap BCE 4100..500) ----------
tsb2 = tsb.copy(); tsb2['BCE'] = -tsb2['CE']
tsb2 = tsb2.sort_values('BCE', ascending=False)  # oldest first
F2 = tsb2['PotteryForm'].values; D2 = tsb2['PotteryDecoration'].values
b2 = tsb2['BCE'].values.astype(int)
dF2 = F2[1:]-F2[:-1]; dD2 = D2[1:]-D2[:-1]
opp2 = (dF2 < 0) & (dD2 > 0)
print(f"[5] time_series_data raw anchors: n_transitions={len(dF2)}, raw-opposite hits={int(opp2.sum())}")
for i in np.where(opp2)[0]:
    print(f"      from BCE {b2[i]} -> {b2[i+1]}: dForm={dF2[i]:+.3f}, dDec={dD2[i]:+.3f}")

# ---------- 6) Verify _inter adds nothing at century scale (monotone within century) ----------
max_incentury_sign_flip = 0
for a0, a1 in zip(ts[ts['CE']%100==0].index[:-1], ts[ts['CE']%100==0].index[1:]):
    seg = ts.iloc[a0:a1+1]
    if (seg['PotteryForm_inter'].diff().dropna() < 0).any() and (seg['PotteryForm_inter'].diff().dropna() > 0).any():
        max_incentury_sign_flip += 1
print(f"[6] centuries with both + and - annual inter slope for Form: {max_incentury_sign_flip} (should be 0 => no within-century extremum)")

# ---------- 7) Compact per-century transition table for diagnostics ----------
print("\n[7] All century transitions (capital): from_BCE -> to_BCE | dForm, dDec | flags")
for _, r in steps.iterrows():
    flag = '  <-- OPPOSITE' if r.opposite_raw else ''
    print(f"  {int(r.from_BCE):>6}-{int(r.to_BCE):>6} | {r.dForm:+.3f}, {r.dDec:+.3f}{flag}")

print("\nFINAL: first century with Decoration increasing (>=thr) & Form declining (<=-thr):",
      int(steps[steps.opposite_raw]['to_BCE'].iloc[0]) if len(steps[steps.opposite_raw]) else None,
      "BCE (interval", int(steps[steps.opposite_raw]['from_BCE'].iloc[0]),
      "-", int(steps[steps.opposite_raw]['to_BCE'].iloc[0]), "BCE)")
