"""
Full analysis: 'In which millennium did amber have the highest value and in
what time interval did it peak?'

Data:
  - data/time_series_data.csv : Amber (raw, 100-yr bins) and Amber_inter (1-yr interp), CE/calBP axes
  - data/capital.csv          : Zamber (100-yr bins), BCE axis, comma-decimals
  - data/pollen_....csv       : no amber column (set aside; confirmed)

Definition (per approved approach / context fact archaeology.domain_knowledge.1):
  amber "value" = the amber Z-score as social capital.
  Highest value = global max of the amber Z series.
  Peak interval = sustained full-max-elevation window (all years at max Z).
  Millennium reported in BCE convention (calBP/CE given for completeness).
"""
import pandas as pd
import numpy as np

# ---------- load ----------
ts  = pd.read_csv('data/time_series_data.csv')
cap = pd.read_csv('data/capital.csv').copy()

# ---------- 1) parse Zamber (comma decimals) ----------
cap['Zamber_num'] = cap['Zamber'].str.replace(',', '.').astype(float)
assert cap['Zamber_num'].notna().all(), "unparsed Zamber values!"
assert len(cap) == 39 and (np.diff(cap['BCE']) < 0).all() and (np.diff(cap['BCE']) == -100).all()

# ---------- 2) identify raw century bins / plateau ----------
raw = ts.loc[ts['Amber'].notna(), ['CE', 'calBP', 'Amber']].copy()
raw['BCE'] = -raw['CE']   # BCE convention
# merge capital Zamber for cross-check on the same bins
raw = raw.merge(cap[['BCE', 'Zamber_num']], on='BCE', how='left')

print("== 1) Global max ==")
print(f"max raw Amber (time_series bins)        = {raw['Amber'].max():.4f}")
print(f"max Zamber (capital.csv, parsed)        = {raw['Zamber_num'].max():.4f}")
print(f"max Amber_inter (1-yr interpolated)     = {ts['Amber_inter'].max():.4f}")
print(f"max |Amber - Zamber| on all 37 bins     = {(raw['Amber']-raw['Zamber_num']).abs().max()}")

print("\n== 2) Raw plateau at the maximum ==")
plat = raw[raw['Amber'] == raw['Amber'].max()]
print(f"{len(plat)} consecutive bins at max Z = {plat['Amber'].max():.2f}:")
print(plat[['BCE','CE','calBP','Amber','Zamber_num']].to_string(index=False))
# neighbours
nb = raw[raw['Amber'].between(1.0, raw['Amber'].max())]
print("\nBins within Z in [1.0, max]:")
print(nb[['BCE','Amber']].to_string(index=False))

print("\n== 3) Year-level (interpolated) full-elevation window ==")
gk = ts[ts['Amber_inter'] == ts['Amber_inter'].max()]
print(f"years at global max Z: {len(gk)}")
print(f"CE   {int(gk['CE'].min())} .. {int(gk['CE'].max())}")
print(f"calBP{int(gk['calBP'].max())} .. {int(gk['calBP'].min())}   (calBP = 1950 - CE)")

# ---------- 3) rolling-mean robustness ----------
print("\n== 4) Peak stability under smoothing ==")
for w in [50, 100, 150, 200]:
    r = ts['Amber_inter'].rolling(w, center=True).mean()
    print(f"  window {w:>3}y  argmax CE {ts.loc[r.idxmax(),'CE']:>5}  value {r.max():.4f}  inside-plateau: "
          f"{int(gk['CE'].min()) <= ts.loc[r.idxmax(),'CE'] <= int(gk['CE'].max())}")

# ---------- 5) millennium assignment ----------
print("\n== 5) Millennium assignment (BCE convention) ==")
peak_year = int(gk['CE'].max()) * -1  # 3000 BCE
peak_start = int(gk['CE'].min()) * -1  # 3300 BCE
print(f"Peak plateau in BCE: {peak_start} BCE .. {peak_year} BCE")
# 4th millennium BCE = 4000..3001 BCE ; 3rd mill BCE = 3000..2001 BCE
in_4th = gk[gk['BCE2'] if False else gk['CE'] <= -3001]  # placeholder guard
# compute properly:
ce_vals = gk['CE'].values
# CE -4000..-3001 -> 4th mill BCE ; CE -3000..-2001 -> 3rd mill BCE
fourth = int((ce_vals >= -4000).sum())  # all plateau years >= -4000 anyway
n4 = int((ce_vals <= -3001).sum())
n3 = int((ce_vals >= -3000).sum())
print(f"plateau years in 4th millennium BCE (CE <= -3001): {n4} / {len(gk)} = {n4/len(gk)*100:.1f}%")
print(f"plateau years at nominal 3rd-millennium boundary (CE == -3000): {n3} / {len(gk)}")
print(f"Peak (max) year reading: {int(gk['CE'].min())*-1} BCE (= {int(gk['CE'].min())} CE, calBP {int(gk.loc[gk['CE'].idxmin(),'calBP'])})"
      f" -> 4th millennium BCE")

print("\n== 6) Final assertion ==")
assert raw['Amber'].max() == 1.54 and raw['Zamber_num'].max() == 1.54
assert len(plat) == 4 and list(plat['BCE']) == [3300, 3200, 3100, 3000]
assert len(gk) == 301 and gk['CE'].min() == -3300 and gk['CE'].max() == -3000
print("All assertions passed: highest value 1.54, 4-bin plateau 3300..3000 BCE, "
      "interpolated plateau CE -3300..-3000 (301 yr).")
print("\nDONE")
