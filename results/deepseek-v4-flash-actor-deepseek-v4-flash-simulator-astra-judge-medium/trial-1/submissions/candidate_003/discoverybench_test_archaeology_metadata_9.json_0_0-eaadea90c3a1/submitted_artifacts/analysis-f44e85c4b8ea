import pandas as pd, numpy as np

R = lambda s: None  # noop
# ---- load & clean capital.csv (decimal commas) ----
raw = pd.read_csv('data/capital.csv')
def clean(s): return pd.to_numeric(s.astype(str).str.replace(',', '.', regex=False))
for c in ['ZAxtSchwert','ZDolch','Zhausgr','ZCU_AU','Zamber','ZMonument','ZHort','ZSichel','ZBeil','ZMW','ZKeform','Zkeverz']:
    raw[c] = clean(raw[c])

SOC = {'ZCU_AU':'Copper&Gold', 'Zamber':'Amber', 'ZMonument':'MonumentCount'}
cap = raw[['BCE']+list(SOC)].copy()
cap['Sum'] = cap[list(SOC)].sum(axis=1)
cap['Century'] = (cap.BCE/100).astype(int).astype(str)+' c. BCE'

# ---- peak century on 100yr bins ----
imax = cap['Sum'].idxmax()
peak = cap.loc[imax]
maxval = cap['Sum'].max()
winners = cap[cap['Sum']==maxval]
print("=== capital.csv 100-yr bins ===")
print("Sum range:", cap.Sum.min(), cap.Sum.max())
print("Peak bin BCE =", int(peak.BCE), "| Century:", peak.Century, "| Sum =", round(peak.Sum,3))
print("Ties (all argmax bins):", winners.BCE.tolist())
print("\nTop-5 bins by sum:")
print(cap.sort_values('Sum', ascending=False).head(5).to_string(index=False))

# ---- cross-check with time_series raw bins ----
ts = pd.read_csv('data/time_series_data.csv')
tsb = ts[ts.CopperGold.notna()].copy()
tsb['BCE'] = -tsb.CE
tsb['Sum'] = tsb.CopperGold + tsb.Amber + tsb.MonumentCount
print("\n=== cross-check time_series raw bins (37) ===")
merged = cap.merge(tsb[['BCE','Sum']], on='BCE', suffixes=('_cap','_ts'))
print("max |Sum_cap - Sum_ts|:", (merged.Sum_cap-merged.Sum_ts).abs().max())
print("peak in time_series raw: BCE =", int(tsb.loc[tsb.Sum.idxmax(),'BCE']), "sum =", round(tsb.Sum.max(),3))

# ---- robustness: interpolated yearly series ----
tsi = ts[['CE']].copy()
for a,b in [('CopperGold_inter','CuAu'),('Amber_inter','Amber'),('MonumentCount_inter','Mon')]:
    tsi[b] = ts[a]
tsi['Sum'] = tsi[['CuAu','Amber','Mon']].sum(axis=1)
tsi['BCE'] = -tsi.CE
# century of peak in yearly interpolated: find max of rolling 100-yr mean of yearly sum (robustness only)
tsi = tsi.sort_values('BCE', ascending=False).reset_index(drop=True)
roll = tsi['Sum'].rolling(100, min_periods=50).mean()
im = roll.idxmax()
print("\n=== robustness on interpolated yearly series (BCE 4100..500) ===")
print("Peak of 100-yr rolling mean of yearly sum: BCE ~", int(tsi.loc[im,'BCE']), "val=", round(roll.loc[im],3))
# also simply max of yearly interpolated sum
iy = tsi['Sum'].idxmax()
print("Max of yearly interpolated sum at BCE:", int(tsi.loc[iy,'BCE']), round(tsi.loc[iy,'Sum'],3))

# ---- component growth criteria at peak bin ----
cap = cap.sort_values('BCE', ascending=False).reset_index(drop=True)
p = int(cap.loc[cap['Sum']==maxval,'BCE'].min())  # earliest winning bin if tie
pi = cap.index[cap.BCE==p][0]
print("\n=== component status at peak bin BCE", p, "===")
prev = pi-1
prev3 = pi-3
rows=[]
for c,name in SOC.items():
    v  = cap.loc[pi,c]
    vp = cap.loc[prev,c] if prev>=0 else np.nan
    v3 = cap.loc[prev3,c] if prev3>=0 else np.nan
    ownmax = cap[c].max()
    crit1 = (v > vp) if prev>=0 else None   # positive delta vs previous bin
    crit2 = (abs(v-ownmax) < 1e-12)         # own series maximum at peak bin
    crit3 = (v > v3) if prev3>=0 else None  # rise over ~300yr window
    rows.append([name, round(v,3), round(vp,3), crit1, crit2, round(v3,3), crit3, round(ownmax,3)])
df = pd.DataFrame(rows, columns=['component','value@peak','prev_bin', 'rise_vs_prev', 'own_max_here','value_300y_ago','rise_vs_300y', 'series_max'])
print(df.to_string(index=False))
print("\npeak bin row:", cap.loc[pi].to_string())
if prev>=0: print("prev bin row:", cap.loc[prev].to_string())
print("\n=== per-century sum table (all bins) ===")
print(cap[['BCE','Century','ZCU_AU','Zamber','ZMonument','Sum']].to_string(index=False))
