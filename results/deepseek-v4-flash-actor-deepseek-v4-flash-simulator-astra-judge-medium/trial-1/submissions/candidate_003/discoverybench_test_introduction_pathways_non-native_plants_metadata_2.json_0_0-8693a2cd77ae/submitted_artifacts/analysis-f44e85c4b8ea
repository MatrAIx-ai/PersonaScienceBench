"""DiscoveryBench / introduction_pathways_non-native_plants
Question: How does the prevalence of non-native plants introduced via gardening
vary based on habitat type?

Operational definitions (assumptions, agreed with researcher):
  * prevalence = share of all non-native occurrences per habitat attributable to
    the Gardening pathway = n.gard / n.total, plus absolute occurrence counts and
    plot-presence rate (>=1 Gardening species per plot);
  * 'Gardening' = literal pathway label (n.gard / intro.pathway == 'Gardening').
"""
import numpy as np
import pandas as pd
import warnings
warnings.filterwarnings('ignore')
import statsmodels.api as sm
import statsmodels.formula.api as smf
from scipy import stats
from statsmodels.stats.proportion import proportion_confint

rng = np.random.default_rng(42)

# ---------------- DATA ----------------
inv = pd.read_csv('data/invaded_niche_pathways.csv', sep='\t')
sp  = pd.read_csv('data/invasion_success_pathways.csv')
tt  = pd.read_csv('data/temporal_trends_contingency_table.csv', sep='\t')

# ---------------- METRIC A/B/C: aggregation by habitat ----------------
agg = inv.groupby('habitat').agg(
    n_plots=('n.gard', 'size'),
    gard=('n.gard', 'sum'), unint=('n.unint', 'sum'), agfo=('n.agfo', 'sum'),
    total=('n.total', 'sum'),
    plots_with_gard=('n.gard', lambda s: int((s > 0).sum())),
).reset_index()
agg['other'] = agg['total'] - agg['gard']
agg['share_gard_of_total'] = agg['gard'] / agg['total']
agg['mean_gard_per_plot'] = agg['gard'] / agg['n_plots']
agg['presence_rate'] = agg['plots_with_gard'] / agg['n_plots']
w_lo, w_hi = proportion_confint(agg['gard'].values, agg['total'].values, alpha=0.05, method='wilson')
p_lo, p_hi = proportion_confint(agg['plots_with_gard'].values, agg['n_plots'].values, alpha=0.05, method='wilson')
agg['share_CI_lo'], agg['share_CI_hi'] = w_lo, w_hi
agg['presence_CI_lo'], agg['presence_CI_hi'] = p_lo, p_hi
agg = agg.sort_values('share_gard_of_total', ascending=False)
print('===== METRIC A (relative share) / B (absolute) / C (presence rate) =====')
print(agg.round(4).to_string(index=False))
agg.to_csv('output/per_habitat_gardening_prevalence.csv', index=False)

# ---------------- TEST 1: chi-square homogeneity, Monte Carlo ----------------
def mc_chi2(table, n_mc=20000, seed=42):
    r = np.random.default_rng(seed)
    ct = np.asarray(table)
    chi2_obs = stats.contingency.chi2_contingency(ct, correction=False).statistic
    row, col = ct.sum(1), ct.sum(0)
    n = ct.sum(); p_row = col / n
    exp = np.outer(row, col) / n
    cnt = 0
    for _ in range(n_mc):
        s = np.array([r.multinomial(int(rw), p_row) for rw in row])
        if ((s - exp) ** 2 / exp).sum() >= chi2_obs:
            cnt += 1
    return chi2_obs, cnt / n_mc

sparse = ['Broad-leaved forests', 'Coniferous forests', 'Scrublands', 'Rock outcrops']
robust = agg[~agg['habitat'].isin(sparse)]
print('\n===== TEST 1: chi-square homogeneity (Gardening vs other occurrences) =====')
for name, fr in [('FULL 10 habitats', agg), ('ROBUST 6 habitats (n.total>=13)', robust)]:
    c = fr[['gard', 'other']].values.astype(int)
    chi2_obs, p_mc = mc_chi2(c)
    ee = stats.contingency.chi2_contingency(c, correction=False).expected_freq.min()
    print(f'{name}: chi2={chi2_obs:.2f} MC_p={p_mc:.4f} min_expected={ee:.2f}')

# ---------------- TEST 2: plot-level quasi-binomial GLM (robust habitats) ----------------
d = inv[~inv['habitat'].isin(sparse)].rename(columns={'n.gard': 'gard', 'n.total': 'total'}).copy()
d['other'] = d['total'] - d['gard']
dp = d[d['total'] > 0]                       # plots with >=1 non-native occurrence
null = smf.glm("gard + other ~ 1", data=dp, family=sm.families.Binomial()).fit(scale='X2')
full = smf.glm("gard + other ~ C(habitat)", data=dp, family=sm.families.Binomial()).fit(scale='X2')
F = (null.deviance / null.scale - full.deviance / full.scale) / (full.df_model - null.df_model)
pF = stats.f.sf(F, full.df_model - null.df_model, full.df_resid)
print('\n===== TEST 2: plot-level quasi-binomial GLM (Dispersion %.2f) =====' % full.scale)
print(f'Quasi-F habitat effect: F={F:.2f} df=({full.df_model - null.df_model},{full.df_resid}) p={pF:.2e}')
habs = dp['habitat'].unique().tolist()
res = pd.DataFrame({'habitat': habs})
pred = full.get_prediction(pd.DataFrame({'habitat': habs}))
res['p_gard'] = pred.predicted_mean
res['CI_lo'], res['CI_hi'] = pred.conf_int()[:, 0], pred.conf_int()[:, 1]
print('Predicted P(Gardening share) per habitat:')
print(res.sort_values('p_gard', ascending=False).round(4).to_string(index=False))

full_r = smf.glm("gard + other ~ C(habitat, Treatment(reference='Urban'))",
                 data=dp, family=sm.families.Binomial()).fit(scale='X2')
print('Wald contrasts vs Urban (odds ratios):')
rows = []
for h in habs:
    if h == 'Urban':
        continue
    coef = f"C(habitat, Treatment(reference='Urban'))[T.{h}]"
    z = full_r.params[coef] / full_r.bse[coef]
    rows.append({'habitat': h, 'logOR': full_r.params[coef], 'OR': np.exp(full_r.params[coef]), 'p': 2 * stats.norm.sf(abs(z))})
print(pd.DataFrame(rows).round(3).to_string(index=False))

# ---------------- SUPPORTING: invasion_success pathways ----------------
print('\n===== SUPPORTING: per-species spread by pathway (invasion_success) =====')
kw = {c: stats.kruskal(*(sp[sp['intro.pathway'] == p][c] for p in sp['intro.pathway'].unique())).pvalue
      for c in ['habitat.range', 'number.of.invaded.plots', 'area.of.occupancy.10km']}
print('Kruskal-Wallis p:', {k: round(v, 3) for k, v in kw.items()})
g_ = sp[sp['intro.pathway'] == 'Gardening'] if True else None
ng_ = sp[sp['intro.pathway'] != 'Gardening']
for c in ['habitat.range', 'number.of.invaded.plots']:
    u, p = stats.mannwhitneyu(sp[sp['intro.pathway']=='Gardening'][c], ng_[c], alternative='two-sided')
    print(f'Mann-Whitney {c}: p={p:.3f} | medians Gardening={sp[sp["intro.pathway"]=="Gardening"][c].median():.1f}, non-Gard={ng_[c].median():.1f}')
print(sp.groupby('intro.pathway')[['habitat.range', 'number.of.invaded.plots']].median().round(2).to_string())

# ---------------- CONTEXT: temporal trends ----------------
piv = tt.pivot_table(index='introduction.period', columns='pathway', values='n', aggfunc='sum')
share = piv['Gardening'] / piv.sum(axis=1)
print('\n===== CONTEXT: Gardening share of introductions by period =====')
print(share.round(3).to_string())
print('Overall Gardening share (Catalonia historical pool): %.3f' % (piv['Gardening'].sum() / piv.sum(axis=1).sum()))
print('\nDONE')
