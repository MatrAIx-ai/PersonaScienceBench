"""MAIN ANALYSIS — gardening pathway prevalence styles across habitat types.
A. Temporal prevalence (temporal_trends)  B. Compositional share (10x3, MC chi2, residuals, enrichment)
C. Per-plot intensity / occupancy  D. Species-level niche/spread (de-dup) + KW
E. Context logistic (descriptive)  F. Phylogeny coverage + Mantel autocorrelation"""
import re, warnings
import numpy as np, pandas as pd
from scipy import stats
warnings.filterwarnings("ignore")
rng = np.random.default_rng(2024)
def sec(t): print("\n" + "="*70 + "\n" + t + "\n" + "="*70)

# ---------------- A: TEMPORAL ----------------
sec("A. TEMPORAL PREVALENCE (introduced-species census)")
tt = pd.read_csv("data/temporal_trends_contingency_table.csv", sep="\t")
piv = tt.pivot_table(index="introduction.period", columns="pathway", values="n")
order = ["Before 1500","1501-1900","1901-1984","1985-2019"]
piv = piv.reindex(order)
share = piv.div(piv.sum(axis=1), axis=0)*100
print("Pathway share (%) of new species per period:\n", share.round(1).to_string())
print("\nGardening counts per period:", piv["Gardening"].to_dict())
chi2t, pt, doft, _ = stats.chi2_contingency(piv.values)
print(f"Period x pathway chi2={chi2t:.2f}, df={doft}, p={pt:.2e}, Cramer's V={np.sqrt(chi2t/(piv.values.sum()*(min(piv.shape)-1))):.3f}")

# ---------------- B: COMPOSITIONAL ----------------
sec("B. COMPOSITIONAL PREVALENCE - habitat x pathway (species occurrences)")
nic = pd.read_csv("data/invaded_niche_pathways.csv", sep="\t")
assert (nic["n.total"] == nic[["n.gard","n.unint","n.agfo"]].sum(axis=1)).all()
hb = ["Broad-leaved forests","Coniferous forests","Wetlands","Coastal","Scrublands",
      "Riparian","Meadows","Urban","Croplands","Rock outcrops"]
g = nic.groupby("habitat")[["n.gard","n.unint","n.agfo"]].sum().reindex(hb)
obs = g.values.copy(); N = obs.sum()
chi2_b, p_asym_b, dof_b, exp_b = stats.chi2_contingency(obs)
row = obs.sum(1); col = obs.sum(0)
prob = (row[:,None]*col[None,:])/(N*N)
sim = rng.multinomial(N, prob.ravel(), size=200000).reshape(200000, obs.shape[0], obs.shape[1])
exp_mc = sim.sum(2)[:,:,None]*sim.sum(1)[:,None,:]/N
exp_mc = np.where(exp_mc<1e-12,1e-12,exp_mc)
sim_chi = ((sim-exp_mc)**2/exp_mc).sum(axis=(1,2))
p_mc_b = float((sim_chi >= chi2_b).mean())
print(f"10x3 chi2={chi2_b:.2f}, df={dof_b}, asymptotic p={p_asym_b:.2e}, Monte-Carlo p={p_mc_b:.4f}, Cramer's V={np.sqrt(chi2_b/(N*(min(obs.shape)-1))):.3f}")
adj = (obs-exp_b)/np.sqrt(exp_b*(1-row[:,None]/N)*(1-col[None,:]/N))
tab = pd.DataFrame(obs, index=hb, columns=["Gardening","Unintentional","AgriForest"])
tab["n"] = obs.sum(1)
overall_gard = obs[:,0].sum()/N
tab["gard_share"] = (obs[:,0]/obs.sum(1)).round(3)
tab["enrich"] = (tab["gard_share"]/overall_gard).round(2)
tab["resid_gard"] = adj[:,0].round(2); tab["resid_unint"] = adj[:,1].round(2)
print(f"Overall Gardening share={overall_gard:.3f} (Unintentional {obs[:,1].sum()/N:.3f}, AgriForest {obs[:,2].sum()/N:.3f})")
print(tab.to_string())
g2 = g.drop("Rock outcrops")
chi2_b2, p_asym_b2, _, _ = stats.chi2_contingency(g2.values)
print(f"\nSensitivity 9x3 (drop Rock outcrops) chi2={chi2_b2:.2f}, p={p_asym_b2:.2e}")
print("\nPer-habitat deviation from overall gardening share (1-df chi-square):")
for i,h in enumerate(hb):
    rn = obs[i].sum()
    if rn==0: continue
    e = rn*overall_gard
    x = (obs[i,0]-e)**2/e + ((rn-obs[i,0])-rn*(1-overall_gard))**2/(rn*(1-overall_gard))
    print(f"  {h:22s} share={tab.loc[h,'gard_share']:.3f} chi2={x:.2f} p={1-stats.chi2.cdf(x,1):.4f}")

# ---------------- C: PER-PLOT INTENSITY ----------------
sec("C. PER-PLOT INTENSITY & OCCUPANCY BY HABITAT")
rows=[]
for h in hb:
    d = nic[nic["habitat"]==h]; invd = d[d["n.total"]>0]
    rows.append({"habitat":h, "n_plots":len(d), "n_invaded":len(invd),
                 "n_plots_with_gard":int((d["n.gard"]>0).sum()),
                 "mean_gard_all":d["n.gard"].mean(),
                 "mean_gard_among_invaded":invd["n.gard"].mean() if len(invd) else np.nan,
                 "gard_occ_among_invaded":(invd["n.gard"]>0).mean() if len(invd) else np.nan,
                 "mean_unint_among_invaded":invd["n.unint"].mean() if len(invd) else np.nan})
perdf = pd.DataFrame(rows).round(3)
print(perdf.to_string(index=False))

# ---------------- D: SPECIES-LEVEL ----------------
sec("D. SPECIES-LEVEL NICHE / SPREAD BY PATHWAY (de-duplicated)")
inv = pd.read_csv("data/invasion_success_pathways.csv")
print("Before de-dup:", len(inv), "| duplicated=TRUE:", int(inv["duplicated"].sum()))
inv_dd = inv[~inv["duplicated"]].copy()
print("After de-dup:", len(inv_dd), inv_dd["intro.pathway"].value_counts().to_dict())
resp = ["invaded.niche.breadth","habitat.range","number.of.invaded.plots","area.of.occupancy.10km","mrt","height","native.niche.breadth"]
print("\nPathway means (de-dup):")
print(inv_dd.groupby("intro.pathway")[resp].mean().round(3).to_string())
kw=[]
for c in resp:
    grps=[inv_dd.loc[inv_dd["intro.pathway"]==p,c].values for p in ["Gardening","Unintentional","AgriForest"]]
    H,pkw = stats.kruskal(*grps)
    mu1 = stats.mannwhitneyu(grps[0],grps[1],alternative="two-sided")
    mu2 = stats.mannwhitneyu(grps[0],grps[2],alternative="two-sided")
    kw.append({"trait":c,"H":round(H,2),"p_kw":round(pkw,4),
               "G_vs_U(U,p)":f"{mu1.statistic:.0f},{mu1.pvalue:.4f}",
               "G_vs_A(U,p)":f"{mu2.statistic:.0f},{mu2.pvalue:.4f}"})
print("\nKruskal-Wallis + post-hoc Mann-Whitney (raw p; Bonferroni x2 => 0.025 pair-level):")
print(pd.DataFrame(kw).to_string(index=False))
print("\nGrowth form x pathway (de-dup):\n", pd.crosstab(inv_dd["intro.pathway"],inv_dd["growth.form"]))
print("Dispersal x pathway (de-dup):\n", pd.crosstab(inv_dd["intro.pathway"],inv_dd["dispersal"]))

# ---------------- E: CONTEXT LOGISTIC (DESCRIPTIVE) ----------------
sec("E. CONTEXT MODEL (supporting, DESCRIPTIVE) - per-plot gardening presence")
import statsmodels.api as sm
import statsmodels.formula.api as smf
m = nic[["habitat","elevation","urban.2009.1000m","cropland.2009.1000m",
         "progressive.1993.2009.50m","distance.road","annual.temperature","n.gard","n.total"]].copy()
m = m.rename(columns={"urban.2009.1000m":"urban_2009_1km","cropland.2009.1000m":"crop_2009_1km",
                      "progressive.1993.2009.50m":"prog_change","annual.temperature":"annual_temp"})
m["gard_present"] = (m["n.gard"]>0).astype(int)
m["log_dist_road"] = np.log1p(m["distance.road"])
from patsy import Treatment
form = "gard_present ~ C(habitat, Treatment(reference='Urban')) + elevation + urban_2009_1km + crop_2009_1km + prog_change + log_dist_road + annual_temp"
def show_mod(mod, tag):
    coef = pd.DataFrame({"coef": mod.params.round(3)})
    coef["sign"] = np.sign(mod.params).map({-1.0:"-",0.0:"0",1.0:"+"})
    print(f"--- {tag} ---")
    print(coef.to_string())
    print()
# Model 1: all 632 plots (context of where gardening introductions occur)
m1_all = smf.logit(form, data=m).fit_regularized(alpha=0.05, disp=False)
show_mod(m1_all, "PENALIZED logistic M1: all 632 plots; y=gardening species present; ref habitat=Urban")
print("M1 gardening-present plots:", int(m["gard_present"].sum()), "of", len(m))
print("M1 summary of direction: + coefficient = higher odds of gardening presence than Urban (all else)")
# Model 2: only invaded plots (context of gardening relative to other pathways where invasion occurs)
invp = m[m["n.total"]>0].copy()
m2_inv = smf.logit(form, data=invp).fit_regularized(alpha=0.05, disp=False)
show_mod(m2_inv, "PENALIZED logistic M2: only invaded plots (n="+str(len(invp))+"); y=gardening species present; ref habitat=Urban")
print("M2 gardening-present invaded plots:", int(invp["gard_present"].sum()), "of", len(invp))
# plain (unpenalized) for sign comparison, non-convergence noted
try:
    p1 = smf.logit(form, data=m).fit(disp=False, maxiter=200)
    print("M1 plain Logit converged:", p1.mle_retvals.get("converged", False),
          "| signs equal penalized:", (np.sign(p1.params) == np.sign(m1_all.params)).all())
except Exception as e:
    print("M1 plain Logit failed:", repr(e))
print("NOTE: penalized (ridge) model used because sparse/zero cells (e.g., 0 gardening occurrences in Rock outcrops, "
      "forests with <=5 invaded plots) cause quasi-complete separation in unpenalized ML; coefficients read as "
      "DIRECTIONS and relative magnitudes only — purely descriptive, observational plot data.")

sec("F. PHYLOGENY - coverage + Mantel autocorrelation (Gardening species)")
with open("data/phylogenetic_tree.txt") as f:
    newick = f.read().strip()
class Node:
    __slots__=("name","length","children","parent","is_leaf")
    def __init__(self,name="",length=0.0):
        self.name,self.length,self.children,self.parent,self.is_leaf=name,length,[],None,False
def parse_newick(s):
    s = s.strip().rstrip(";").strip()
    def parse(i):
        nd = Node()
        if i < len(s) and s[i] == "(":
            i += 1
            while True:
                child, i = parse(i)
                child.parent = nd
                nd.children.append(child)
                if s[i] == ",":
                    i += 1; continue
                elif s[i] == ")":
                    i += 1; break
                else:
                    raise ValueError("unexpected char at pos %d: %r" % (i, s[i]))
        j = i
        while j < len(s) and s[j] not in "(),:;":
            j += 1
        nd.name = s[i:j]; i = j
        if i < len(s) and s[i] == ":":
            j = i+1
            while j < len(s) and (s[j].isdigit() or s[j] in ".eE+-"):
                j += 1
            nd.length = float(s[i+1:j]); i = j
        if not nd.children:
            nd.is_leaf = True
        return nd, i
    root, _ = parse(0)
    return root
tree=parse_newick(newick)
leaves=[]
def walk(nd):
    if nd.is_leaf: leaves.append(nd); return
    for c in nd.children: walk(c)
walk(tree)
leaf_map={nd.name:nd for nd in leaves}
inv_labels=set(inv_dd["phylo.tip.label"])
print(f"Tree leaves={len(leaves)}, de-dup species={len(inv_labels)}, coverage={len(inv_labels & set(leaf_map))}/{len(inv_labels)}")
root_paths={}
def paths(nd,path,cum):
    path=path+[(nd,cum)]
    if nd.is_leaf: root_paths[nd.name]=path
    for c in nd.children: paths(c,path,cum+(c.length or 0.0))
paths(tree,[],0.0)
def patr(a,b):
    pa,pb=root_paths[a],root_paths[b]
    for (na,ca),(nb,cb) in zip(pa[::-1],pb[::-1]):
        if na is nb: return (pa[-1][1]-ca)+(pb[-1][1]-cb)
    return pa[-1][1]+pb[-1][1]
gard=inv_dd[inv_dd["intro.pathway"]=="Gardening"]
gl=[x for x in gard["phylo.tip.label"] if x in leaf_map]; nG=len(gl)
if nG>=8:
    Dp,Dt=[],[]
    for a in range(nG):
        for b in range(a+1,nG):
            Dp.append(patr(gl[a],gl[b]))
            ta=gard.loc[gard["phylo.tip.label"]==gl[a],"invaded.niche.breadth"].iloc[0]
            tb=gard.loc[gard["phylo.tip.label"]==gl[b],"invaded.niche.breadth"].iloc[0]
            Dt.append(abs(ta-tb))
    Dp,Dt=np.asarray(Dp),np.asarray(Dt)
    r_m=stats.pearsonr(Dp,Dt).statistic
    cnt=sum(1 for _ in range(9999) if stats.pearsonr(Dp,rng.permutation(Dt)).statistic>=r_m)
    p_m=(cnt+1)/10000
    print(f"Gardening species in tree={nG}; Mantel r(phylo dist,|niche diff|)={r_m:.3f}, permuted p={p_m:.4f}")
else:
    print("Not enough Gardening species with tree tips for Mantel.")
print("\nDONE")
