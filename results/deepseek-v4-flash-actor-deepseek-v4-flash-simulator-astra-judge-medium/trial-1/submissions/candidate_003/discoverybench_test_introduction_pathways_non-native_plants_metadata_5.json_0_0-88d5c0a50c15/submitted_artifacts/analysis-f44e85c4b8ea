# ---- SPATIAL AUTOCORRELATION: Moran's I on primary-model residuals ----
def morans_i(resid, coords, k=32, nperm=1999):
    coords = coords.values.astype(float)
    tree = cKDTree(coords)
    dist, idx = tree.query(coords, k=k+1)
    n = len(resid)
    W = np.zeros((n,n))
    for i in range(n):
        for j,dd in zip(idx[i][1:], dist[i][1:]):
            if dd>0: W[i,j]=1.0/dd
    W=(W+W.T)/2.0; W0=W.sum()
    z = resid-resid.mean(); denom=(z**2).sum()
    Iobs = (n/W0)*(z @ W @ z)/denom
    perms=np.empty(nperm)
    for r in range(nperm):
        zp=np.random.permutation(z)
        perms[r]=(n/W0)*(zp @ W @ zp)/denom
    p = (np.abs(perms)>=abs(Iobs)).mean()
    return Iobs, p, perms.mean(), perms.std()

# plot-level spatial check: Poisson model of n.total on urban+covariates
plotd = niche.copy()
Xp = plotd[['urban.2009.500m','elevation','annual.temperature','annual.rainfall','annual.radiation','distance.road','distance.stream']]
Xp = sm.add_constant(Xp)
pm = Poisson(plotd['n.total'].values, Xp.values).fit(method='nm', maxiter=2000, disp=0)
mu_p = pm.predict(Xp.values)
dev_p = (plotd['n.total'].values - mu_p)/np.sqrt(mu_p+1e-9)
try:
    I,pv,pm_m,ps = morans_i(dev_p, niche[['longitude','latitude']])
    OUT['morans_I_primary'] = dict(n_plots=len(dev_p), n_perm=1999, I=round(I,4), p=round(pv,4), perm_mean=round(pm_m,4), perm_sd=round(ps,4))
except Exception as e:
    OUT['morans_I_primary'] = dict(error=str(e)[:300])

# ---- MARGINAL PREDICTED COUNTS by pathway at urban 0 vs 0.5 ----
def margin(m, Xdf, longdf, lo=0.0, hi=0.5):
    base = Xdf.copy()
    loX=base.copy(); hiX=base.copy()
    loX['urban']=lo; hiX['urban']=hi
    for p in ['Gardening','Unintentional']:
        loX['urban:pw'+p]=loX['pw_'+p]*lo; hiX['urban:pw'+p]=hiX['pw_'+p]*hi
    mu_lo=m.predict(loX); mu_hi=m.predict(hiX)
    out={}
    for p in ['AgriForest','Gardening','Unintentional']:
        mk=(longdf['pathway']==p).values
        out[p]=dict(pred_urban_lo=round(float(mu_lo[mk].mean()),3), pred_urban_hi=round(float(mu_hi[mk].mean()),3),
                    fold_change=round(float(mu_hi[mk].mean())/max(mu_lo[mk].mean(),1e-9),2))
    return out
