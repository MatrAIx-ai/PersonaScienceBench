def to_long(df, urban_col, delta_col):
    rows=[]
    for i,r in df.iterrows():
        for p,c in [('Gardening','n.gard'),('Unintentional','n.unint'),('AgriForest','n.agfo')]:
            rows.append(dict(plot_id=i, pathway=p, n=r[c], urban=r[urban_col],
                delta_urban=r[delta_col], habitat=r['habitat'], elevation=r['elevation'],
                temp=r['annual.temperature'], rain=r['annual.rainfall'], rad=r['annual.radiation'],
                dist_road=r['distance.road'], dist_stream=r['distance.stream']))
    return pd.DataFrame(rows)

def prep_matrix(df, with_habitat=True):
    df=df.copy()
    des = pd.get_dummies(df['pathway'], prefix='pw', drop_first=False, dtype=float)
    for p in ['AgriForest','Gardening','Unintentional']:
        des['pw_'+p] = (df['pathway']==p).astype(float)
    X = des.drop(columns=['pw_AgriForest'])
    if with_habitat:
        h = pd.get_dummies(df['habitat'], prefix='h', drop_first=True, dtype=float)
        X = pd.concat([X, h.reset_index(drop=True)], axis=1)
    Xc = df[['elevation','temp','rain','rad','dist_road','dist_stream']]
    X = pd.concat([X, Xc.reset_index(drop=True)], axis=1)
    X['urban'] = df['urban'].values
    for p in ['Gardening','Unintentional']:
        X['urban:pw'+p] = df['urban'].values * (df['pathway']==p).astype(float).values
    X = sm.add_constant(X)
    return X, df['n'].values, df['plot_id'].values

def fit_model(df, with_habitat=True, cov_opt='cluster'):
    X,y,g = prep_matrix(df, with_habitat)
    kw = dict(maxiter=1000, disp=0)
    if cov_opt=='cluster':
        kw.update(cov_type='cluster', cov_kwds={'groups':g})
    tried=False
    for method in ['nm','newton']:
        try:
            with warnings.catch_warnings():
                warnings.simplefilter('ignore')
                m = NegativeBinomial(y, X).fit(method=method, **kw)
            tried=True
            break
        except Exception:
            continue
    if not tried:
        with warnings.catch_warnings():
            warnings.simplefilter('ignore')
            m = NegativeBinomial(y, X).fit(**kw)
    return m, X

def extract(m, label):
    out=[]
    for cname in ['urban','urban:pwGardening','urban:pwUnintentional']:
        coef,se = m.params[cname], m.bse[cname]
        out.append(dict(model=label, term=cname, coef=round(coef,4), se=round(se,4),
            IRR=round(float(np.exp(coef)),3), IRR_low=round(float(np.exp(coef-1.96*se)),3),
            IRR_high=round(float(np.exp(coef+1.96*se)),3), p=round(float(m.pvalues[cname]),4)))
    return out

def urbandiff(m, a, b):
    ba,bb = m.params['urban:pw'+a], m.params['urban:pw'+b]
    sa,sb = m.bse['urban:pw'+a], m.bse['urban:pw'+b]
    cov = m.cov_params().loc['urban:pw'+a, 'urban:pw'+b]
    d = ba-bb; sed = np.sqrt(sa**2+sb**2-2*cov)
    return dict(diff=round(d,4), se=round(sed,4), z=round(d/sed,3), p=round(float(2*(1-norm.cdf(abs(d/sed)))),4))

