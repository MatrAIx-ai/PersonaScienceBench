#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""Urban land use and invasion of different types (introduction pathways) of
introduced plants - Catalonia/Barcelona non-native flora.
A) plot-level nested models (urban -> per-pathway richness): m0 urban-only, m1 +elevation,
   m2 +elevation+habgroup, m3 full; hurdle count-part on positive subset (NB w/ fallback).
B) species-level: pathways = functional types; success comparison (+mrt, family proxy).
C) hypothesis summary quantities."""
import numpy as np, pandas as pd
import statsmodels.api as sm
from statsmodels.discrete.discrete_model import NegativeBinomial, Logit, Poisson
from scipy import stats
import warnings
warnings.filterwarnings("ignore")
pd.set_option('display.width', 260)

df = pd.read_csv("data/invaded_niche_pathways.csv", sep="\t")
sp = pd.read_csv("data/invasion_success_pathways.csv")
for b in ["50m","500m","1000m"]:
    df[f"delta.urban.1956.2009.{b}"] = df[f"urban.2009.{b}"] - df[f"urban.1956.{b}"]
df["log.dist.road"] = np.log1p(df["distance.road"])
# functional habitat groups (empirical mean load: urban>managed>seminatural)
gmap = {"Urban":"urban",
        "Croplands":"managed","Riparian":"managed","Wetlands":"managed","Coastal":"managed",
        "Scrublands":"seminatural","Rock outcrops":"seminatural","Coniferous forests":"seminatural",
        "Broad-leaved forests":"seminatural","Meadows":"seminatural"}
df["habg3"] = df["habitat"].map(gmap)
def zc(col): return (df[col]-df[col].mean())/df[col].std()
for v in ["urban.2009.50m","urban.2009.500m","urban.2009.1000m",
          "delta.urban.1956.2009.50m","delta.urban.1956.2009.500m","delta.urban.1956.2009.1000m",
          "progressive.1956.2009.50m","regressive.1956.2009.50m",
          "elevation","cropland.2009.500m","log.dist.road","annual.rainfall","longitude"]:
    df[v+"_z"] = zc(v)
df["rainfall_z"] = df["annual.rainfall_z"]
CONTROLS = ["elevation_z","cropland.2009.500m_z","log.dist.road_z","rainfall_z","longitude_z"]
PATHWAYS = ["n.total","n.gard","n.unint","n.agfo"]
LAB = {"n.total":"Total","n.gard":"Gardening","n.unint":"Unintentional","n.agfo":"AgriForest"}

def design(d_, uv, use_elev=True, use_hab=True):
    X = pd.DataFrame(index=d_.index); X[uv] = d_[uv]
    if use_hab:
        hd = pd.get_dummies(d_["habg3"], prefix="hg", drop_first=True, dtype=float)
        for c in hd.columns: X[c] = hd[c].values
    if use_elev: X["elevation_z"] = d_["elevation_z"]
    for c in CONTROLS[1:]: X[c] = d_[c]
    X["const"] = 1.0
    return X

def fitm(kind, y, X):
    try:
        if kind=="logit": return Logit(y, X).fit(disp=0, maxiter=3000)
        if kind=="nb":    return NegativeBinomial(y, X).fit(disp=0, maxiter=4000)
        return Poisson(y, X).fit(disp=0, maxiter=3000)
    except Exception:
        return None

def eff(m, uv, k="OR"):
    if m is None: return None
    b,se = m.params[uv], m.bse[uv]
    v,lo,hi = (np.exp(b),np.exp(b-1.96*se),np.exp(b+1.96*se)) if k in("OR","IRR") else (b,b-1.96*se,b+1.96*se)
    return dict(val=float(v),lo=float(lo),hi=float(hi),p=float(m.pvalues[uv]))

def fmt(d):
    if d is None: return "n/a(fail)"
    st = "***" if d["p"]<0.001 else ("**" if d["p"]<0.01 else ("*" if d["p"]<0.05 else ("." if d["p"]<0.1 else "ns")))
    return f"{d['val']:.3f}[{d['lo']:.3f},{d['hi']:.3f}]{st} p={d['p']:.2g}"

def presence_nested(d_, col, uv):
    out={}
    for tag,eh,ehb in [("m0",False,False),("m1",True,False),("m3",True,True)]:
        m=fitm("logit",(d_[col]>0).astype(int),design(d_,uv,eh,ehb))
        out[tag]=eff(m,uv,"OR")
    return out

def count_on_pos(d_, col, uv):
    sub=d_[d_[col]>0]
    m=fitm("nb",sub[col],design(sub,uv,True,True))
    kind="nb"
    if m is None:
        m=fitm("pois",sub[col],design(sub,uv,True,True)); kind="pois"
    return eff(m,uv,"IRR") if m is not None else None, len(sub)

# ================== PART A EXECUTION ==================
print("="*100)
print("PART A. plot-level nested models: CURRENT urban (2009, 500m, z). PRESENCE (logit, n=632)")
print("m0 urban-only | m1 +elevation | m3 +elevation+habgroup+full-controls | count=NB on positive plots")
print("="*100)
store={}
for col in PATHWAYS:
    pres = presence_nested(df,col,"urban.2009.500m_z")
    cnt,nc = count_on_pos(df,col,"urban.2009.500m_z")
    store[("cur",col)] = dict(pres=pres, cnt=cnt, ncnt=nc)
    print(f"[{LAB[col]:14s}] pres m0={fmt(pres['m0'])}  m1={fmt(pres['m1'])}  m3={fmt(pres['m3'])}  "
          f"| count-nb IRR(positive n={nc}) = {fmt(cnt)}")

print("\n" + "-"*100)
print("HISTORICAL urban EXPANSION (delta 1956-2009, 500m, z): presence nested + count")
print("-"*100)
for col in PATHWAYS:
    pres = presence_nested(df,col,"delta.urban.1956.2009.500m_z")
    cnt,nc = count_on_pos(df,col,"delta.urban.1956.2009.500m_z")
    key=("del",col); store[key]=dict(pres=pres,cnt=cnt,ncnt=nc)
    print(f"[{LAB[col]:14s}] pres m0={fmt(pres['m0'])}  m1={fmt(pres['m1'])}  m3={fmt(pres['m3'])}  "
          f"| count-nb IRR = {fmt(cnt)}")

print("\n" + "-"*100)
print("Landscape-change categories (50m, z, ref=no.changes) -> presence, full model")
print("-"*100)
for cat in ["progressive.1956.2009.50m_z","regressive.1956.2009.50m_z"]:
    p = presence_nested(df,"n.total",cat)
    print(f"  {cat:32s} m0={fmt(p['m0'])} m3={fmt(p['m3'])}")

print("\n" + "-"*100)
print("Buffer robustness (PRESENCE, full model m3): current urban 2009 at 50/500/1000m")
print("-"*100)
for col in PATHWAYS:
    parts=[]
    for b in ["50m","500m","1000m"]:
        p=presence_nested(df,col,f"urban.2009.{b}_z")
        parts.append(f"m3-{b}:{fmt(p['m3'])}")
    print(f"[{LAB[col]:14s}] " + " | ".join(parts))

# ================== PART B ==================
print("\n" + "="*100)
print("PART B. species-level: pathways as functional plant types; success differences")
print("="*100)
print("\nPathway x trait (chi2):")
for tr in ["growth.form","dispersal","vegetative"]:
    ct = pd.crosstab(sp["intro.pathway"], sp[tr]); chi2,p,_,_ = stats.chi2_contingency(ct)
    print(f"  {tr:12s} chi2={chi2:.1f} p={p:.3g}"); print(ct.to_string())
metrics = ["number.of.invaded.plots","area.of.occupancy.10km","habitat.range",
           "invaded.niche.breadth","height","mrt"]
print("\nPathway means (species level):\n", sp.groupby("intro.pathway")[metrics].mean().round(3).to_string())
print("\nKruskal-Wallis across pathways:")
for m in metrics:
    g=[sp.loc[sp["intro.pathway"]==pw,m].values for pw in sp["intro.pathway"].unique()]
    H,p=stats.kruskal(*g); print(f"  {m:26s} H={H:.2f} p={p:.3g}")
sp2=sp.copy(); sp2["mrt_z"]=(sp2["mrt"]-sp2["mrt"].mean())/sp2["mrt"].std()
pw=pd.get_dummies(sp2["intro.pathway"], drop_first=True, dtype=float)
X=pd.concat([pw, sp2["mrt_z"]],axis=1); X["const"]=1.0
nb=fitm("nb", sp2["number.of.invaded.plots"].astype(int), X)
print("\nNB #invaded.plots ~ pathway(ref=Gardening) + mrt (z) [IRR]:")
print(pd.DataFrame({"coef":nb.params,"SE":nb.bse,"p":nb.pvalues,"IRR":np.exp(nb.params)}).round(4).to_string())
for yc,nm in [("area.of.occupancy.10km","area occupancy"),("habitat.range","habitat range")]:
    nb2=fitm("nb", sp2[yc].astype(int), X)
    print(f"  NB {nm}: IRR = {dict(zip(nb2.params.index,np.exp(nb2.params).round(3)))}")
yy=np.log1p(sp2["number.of.invaded.plots"])
fam=pd.get_dummies(sp2["family"], drop_first=True, dtype=float)
Xw=pd.concat([pw.reset_index(drop=True),sp2[["mrt_z"]].reset_index(drop=True)],axis=1); Xw["const"]=1.0
Xwf=pd.concat([pw.reset_index(drop=True),fam.reset_index(drop=True),sp2[["mrt_z"]].reset_index(drop=True)],axis=1); Xwf["const"]=1.0
for lab,mmod in [("without family", sm.OLS(yy,Xw).fit()),("with family (phylo proxy)", sm.OLS(yy,Xwf).fit())]:
    u,pu = mmod.params.get("Unintentional",np.nan), mmod.pvalues.get("Unintentional",np.nan)
    print(f"  OLS log1p(#plots) {lab:28s}: Unintentional coef={u:.3f} p={pu:.3g}")

# ================== PART C ==================
print("\n" + "="*100); print("PART C. quantities for the hypothesis"); print("="*100)
print("Presence OR (m3, current urban 500m): ", {LAB[c]: (round(store[('cur',c)]['pres']['m3']['val'],3) if store[('cur',c)]['pres']['m3'] else None) for c in PATHWAYS})
print("Presence OR (m3, delta urban 500m):    ", {LAB[c]: (round(store[('del',c)]['pres']['m3']['val'],3) if store[('del',c)]['pres']['m3'] else None) for c in PATHWAYS})
print("mean invaded plots/species by pathway: ", sp.groupby("intro.pathway")["number.of.invaded.plots"].mean().round(2).to_dict())
print("sum invaded plots by pathway:          ", sp.groupby("intro.pathway")["number.of.invaded.plots"].sum().to_dict())
print("mean n.* per plot by habitat group:    ", df.groupby("habg3")[["n.total","n.unint","n.gard","n.agfo"]].mean().round(3).to_dict())
print("DONE")
