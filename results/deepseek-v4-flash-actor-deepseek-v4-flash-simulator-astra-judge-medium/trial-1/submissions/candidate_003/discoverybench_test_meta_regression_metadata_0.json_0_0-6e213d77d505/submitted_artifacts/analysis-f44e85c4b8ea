# -*- coding: utf-8 -*-
"""Analysis: within which domains are original-study effect sizes larger than replication effect sizes.
Approach (approved): domain = discipline (primary) + project.x (robustness);
primary metric = fiso - fisr (Fisher-z, signed); rule = median/mean > 0 AND share P(fiso>fisr) > 0.5;
within-domain bootstrap 95% CIs (10,000 resamples) + paired tests; between-domain = descriptive only.
All four metrics reported; no imputation (no missing), no winsorization, median-based robustness.
"""
import numpy as np
import pandas as pd
from scipy import stats

RNG = np.random.default_rng(42)
N_BOOT = 10_000

df = pd.read_csv('data/meta-regression_joined_data_heterogeneity_in_replication_projects.csv')
df['fiso_minus_fisr'] = df['fiso'] - df['fisr']
df['ro_minus_rr'] = df['ro'] - df['rr']

def boot_ci(x, stat, alpha=0.05, n=N_BOOT):
    """Percentile bootstrap 95% CI for stat (callable returning scalar)."""
    if len(x) == 0:
        return np.nan, np.nan
    x = np.asarray(x, dtype=float)
    x = x[~np.isnan(x)]
    boots = np.empty(n)
    for i in range(n):
        boots[i] = stat(RNG.choice(x, size=len(x), replace=True))
    lo, hi = np.percentile(boots, [100*alpha/2, 100*(1-alpha/2)])
    return lo, hi

def summarize(groups):
    rows = []
    for grp, sub in groups:
        d = sub['fiso_minus_fisr'].dropna().values
        n = len(sub)
        mean_diff = float(np.mean(d)); med_diff = float(np.median(d))
        ml, mh = boot_ci(d, np.mean)          # CI for mean
        mdl, mdh = boot_ci(d, np.median)      # CI for median
        share = float((sub['fiso'] > sub['fisr']).mean())
        sl, sh = boot_ci((sub['fiso'] > sub['fisr']).astype(float).values, np.mean)
        share_ro = float((sub['ro'] > sub['rr']).mean())
        # paired tests on fiso-fisr
        t_stat, t_p = stats.ttest_1samp(d, 0) if n > 1 else (np.nan, np.nan)
        try:
            w_stat, w_p = stats.wilcoxon(d)
        except ValueError:
            w_stat, w_p = np.nan, np.nan
        rows.append(dict(
            group=grp, n=n,
            fiso_minus_fisr_mean=round(mean_diff,4), fiso_minus_fisr_median=round(med_diff,4),
            ci_mean_low=round(ml,4), ci_mean_high=round(mh,4),
            ci_median_low=round(mdl,4), ci_median_high=round(mdh,4),
            share_fiso_gt_fisr=round(share,4), ci_share_low=round(sl,4), ci_share_high=round(sh,4),
            share_ro_gt_rr=round(share_ro,4),
            ro_minus_rr_mean=round(float(np.mean(sub['ro_minus_rr'])),4),
            ro_minus_rr_median=round(float(np.median(sub['ro_minus_rr'])),4),
            relative_es_mean=round(float(np.mean(sub['relative_es'])),4),
            relative_es_median=round(float(np.median(sub['relative_es'])),4),
            t_pval=round(float(t_p),4),
            wilcoxon_pval=round(float(w_p),4),
            mean_gt0_ci=(ml > 0), median_gt0_ci=(mdl > 0), share_gt0p5=(sl > 0.5),
        ))
    return pd.DataFrame(rows)

by_discipline = summarize(df.groupby('discipline', sort=False))
by_project = summarize(df.groupby('project.x', sort=False))
by_discipline.insert(0, 'partition', 'discipline')
by_project.insert(0, 'partition', 'project.x')
table = pd.concat([by_discipline, by_project], ignore_index=True)
table.to_csv('domain_effect_size_summary.csv', index=False)

pd.set_option('display.width', 250)
pd.set_option('display.max_columns', 50)
print(table.to_string(index=False))
print()
print('=== Interpretation flags (rule: mean>0 & median>0 & share>0.5, all via CI lower bound) ===')
print('mean_gt0_ci  median_gt0_ci  share_gt0p5 -> per row')
print(table[['partition','group','n','mean_gt0_ci','median_gt0_ci','share_gt0p5']].to_string(index=False))
print()
print('=== Ranking by primary metric (median fiso-fisr, desc) among disciplines ===')
d = by_discipline.sort_values('fiso_minus_fisr_median', ascending=False)
print(d[['group','fiso_minus_fisr_median','fiso_minus_fisr_mean','share_fiso_gt_fisr','relative_es_median']].to_string(index=False))
print()
print('=== Ranking by share P(fiso>fisr), desc among disciplines ===')
print(by_discipline.sort_values('share_fiso_gt_fisr', ascending=False)[['group','share_fiso_gt_fisr','fiso_minus_fisr_median','relative_es_median']].to_string(index=False))
print()
print('=== project.x secondary slice ===')
print(by_project[['group','n','fiso_minus_fisr_median','fiso_minus_fisr_mean','share_fiso_gt_fisr','ro_minus_rr_median','relative_es_median']].to_string(index=False))
