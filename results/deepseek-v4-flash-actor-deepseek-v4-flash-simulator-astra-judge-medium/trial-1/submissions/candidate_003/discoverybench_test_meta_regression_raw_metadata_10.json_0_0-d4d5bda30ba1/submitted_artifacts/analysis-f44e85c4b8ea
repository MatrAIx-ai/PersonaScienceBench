"""Final analysis: proportion of junior professors among replicated Psychology studies.
Definitions (researcher-confirmed):
  junior professor := seniority.r == 'Assistant Professor' | 'Assistant'  (Researcher excluded)
  primary denominator := project=='rpp' & replicated==1 (n=35)
  robust. variants: all rpp (n=97); drop-excluded rpp replicated (n=31); AP-only sensitivity.
  replicated flag = provided column (authoritative)."""
import pandas as pd
import json

df = pd.read_csv('data/meta-regression_study_data_heterogeneity_in_replication_projects.csv')
rpp = df[df['project'] == 'rpp'].copy()
rep = rpp[rpp['replicated'] == 1].copy()

JUNIOR = ['Assistant Professor', 'Assistant']

def pct(a, b): return a / b

results = {}
# Primary: rpp & replicated==1
n = len(rep)
junior = int(rep['seniority.r'].isin(JUNIOR).sum())
ap_only = int((rep['seniority.r'] == 'Assistant Professor').sum())
results['primary_replicated_rpp'] = {
    'denominator_n': n,
    'junior_count': junior,
    'proportion': round(pct(junior, n), 4),
    'ap_only_count': ap_only,
    'ap_only_proportion': round(pct(ap_only, n), 4),
    'category_counts': {k: int(v) for k, v in rep['seniority.r'].value_counts().items()},
}

# Robustness: all rpp
n_all = len(rpp)
results['robust_all_rpp'] = {
    'denominator_n': n_all,
    'junior_count': int(rpp['seniority.r'].isin(JUNIOR).sum()),
    'proportion': round(pct(rpp['seniority.r'].isin(JUNIOR).sum(), n_all), 4),
    'ap_only_proportion': round(pct((rpp['seniority.r'] == 'Assistant Professor').sum(), n_all), 4),
}

# Robustness: drop-excluded rpp replicated
nd = rpp[rpp['drop'] == False]
ndr = nd[nd['replicated'] == 1]
n_nd = len(ndr)
results['robust_drop_excluded_replicated'] = {
    'denominator_n': n_nd,
    'junior_count': int(ndr['seniority.r'].isin(JUNIOR).sum()),
    'proportion': round(pct(ndr['seniority.r'].isin(JUNIOR).sum(), n_nd), 4),
    'ap_only_count': int((ndr['seniority.r'] == 'Assistant Professor').sum()),
    'ap_only_proportion': round(pct((ndr['seniority.r'] == 'Assistant Professor').sum(), n_nd), 4),
}

print('=== PRIMARY: rpp & replicated==1 (n=%d) ===' % n)
print(rep['seniority.r'].value_counts())
print('junior (AsstProf+Assistant) = %d/%d = %.3f (%.1f%%)' % (junior, n, pct(junior, n), 100*pct(junior, n)))
print('AP-only sensitivity = %d/%d = %.3f (%.1f%%)' % (ap_only, n, pct(ap_only, n), 100*pct(ap_only, n)))
print()
print('=== ROBUSTNESS all rpp (n=%d): junior = %d/%d = %.3f | AP-only = %.3f ===' %
      (n_all, results['robust_all_rpp']['junior_count'], n_all,
       results['robust_all_rpp']['proportion'], results['robust_all_rpp']['ap_only_proportion']))
print('=== ROBUSTNESS drop-excluded rpp replicated (n=%d): junior = %d/%d = %.3f | AP-only = %d/%d = %.3f ===' %
      (n_nd, results['robust_drop_excluded_replicated']['junior_count'], n_nd,
       results['robust_drop_excluded_replicated']['proportion'],
       results['robust_drop_excluded_replicated']['ap_only_count'], n_nd,
       results['robust_drop_excluded_replicated']['ap_only_proportion']))

hypothesis = (
    f"Among the {n} Psychology studies in the Reproducibility Project (project == 'rpp') that were successfully "
    f"replicated (replicated == 1), {junior} in {n} had a junior professor -- an Assistant Professor or Assistant "
    f"(seniority.r), excluding Researcher -- as the most senior replication author, i.e. approximately "
    f"{100*pct(junior, n):.1f}% ({junior}/{n}). If 'junior professor' is restricted to Assistant Professor only, "
    f"the proportion is {ap_only}/{n} = {100*pct(ap_only, n):.1f}%. Robustness across the full rpp sample "
    f"(n={n_all}) gives {results['robust_all_rpp']['junior_count']}/{n_all} = "
    f"{100*results['robust_all_rpp']['proportion']:.1f}%, and excluding 7 drop-flagged rows "
    f"(n={n_nd}) gives {results['robust_drop_excluded_replicated']['junior_count']}/{n_nd} = "
    f"{100*results['robust_drop_excluded_replicated']['proportion']:.1f}%, so the estimate is stable around 46-52%."
)

results['hypothesis'] = hypothesis
with open('analysis_results.json', 'w') as f:
    json.dump(results, f, indent=2)
print('\n=== HYPOTHESIS ===')
print(hypothesis)
print('\n(saved analysis_results.json)')
