"""Plan-stage inspection for: proportion of junior professors in replicated Psychology studies.
Runs the data checks described in the plan handoff (no final analysis)."""
import pandas as pd

df = pd.read_csv('data/meta-regression_study_data_heterogeneity_in_replication_projects.csv')
print('shape (rows, cols):', df.shape)

print('\n-- project counts --')
print(df['project'].value_counts(dropna=False))

print('\n-- replicated overall --')
print(df['replicated'].value_counts(dropna=False))
print('missing replicated by project:', df[df['replicated'].isna()].groupby('project').size().to_dict())

rpp = df[df['project'] == 'rpp']
print('\n-- rpp (Psychology) subset --')
print('rows:', len(rpp), '| unique ids:', rpp['id'].nunique(), '| dup id rows:', rpp['id'].duplicated().sum())
print('replicated:', rpp['replicated'].value_counts(dropna=False).to_dict())

for col in ['seniority.o', 'seniority.r']:
    print(f'\n-- {col} (all data) --')
    print(df[col].value_counts(dropna=False))
    print('nulls:', df[col].isna().sum(), '| empty strings:', (df[col].astype(str).str.strip() == '').sum())

print('\n-- rpp seniority.o --\n', rpp['seniority.o'].value_counts(dropna=False))
print('\n-- rpp seniority.r --\n', rpp['seniority.r'].value_counts(dropna=False))

rep = rpp[rpp['replicated'] == 1]
print('\n-- rpp replicated==1 (n=%d) seniority.r --' % len(rep))
print(rep['seniority.r'].value_counts())

print('\n-- candidate proportions (rpp, seniority.r) --')
n35, n97 = len(rep), len(rpp)
for name, cats in {
    'Assistant Professor only': ['Assistant Professor'],
    'Assistant Professor + Assistant': ['Assistant Professor', 'Assistant'],
    'Assistant Professor + Assistant + Researcher': ['Assistant Professor', 'Assistant', 'Researcher'],
}.items():
    a = rep['seniority.r'].isin(cats).sum()
    b = rpp['seniority.r'].isin(cats).sum()
    print(f'{name:42s} denom=replicated({n35}): {a:2d}/{n35} = {a/n35:.3f} | denom=all_rpp({n97}): {b:2d}/{n97} = {b/n97:.3f}')

print('\n-- drop flag (rpp) --')
print(rpp['drop'].value_counts(dropna=False))
nd = rpp[rpp['drop'] == False]
ndr = nd[nd['replicated'] == 1]
print('non-dropped rpp replicated==1:', len(ndr), 'seniority.r counts:', ndr['seniority.r'].value_counts().to_dict())

print('\n-- validate replicated flag vs rule p<=0.05 & same direction --')
rule = (rpp['p_value.r'] <= 0.05) & (rpp['effect_size.r'] * rpp['effect_size.o'] > 0)
print('rule count:', int(rule.sum()), '| flagged:', int(rpp['replicated'].sum()), '| mismatches:', int((rule != (rpp['replicated'] == 1)).sum()))
