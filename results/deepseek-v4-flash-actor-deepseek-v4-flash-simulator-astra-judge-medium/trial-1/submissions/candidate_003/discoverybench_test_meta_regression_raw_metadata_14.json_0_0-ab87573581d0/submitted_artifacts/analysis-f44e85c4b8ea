import pandas as pd
import numpy as np

DF = 'data/meta-regression_study_data_heterogeneity_in_replication_projects.csv'
DF2 = 'data/meta-regression_replication_success_data_heterogeneity_in_replication_projects.csv'

df = pd.read_csv(DF, low_memory=False)
df2 = pd.read_csv(DF2, low_memory=False)

# ---------- 1. Build pair-level (study) table ----------
pairs = pd.concat([
    df[df['aggregated'] == True],          # one per multi-lab study
    df[df['id'].map(df.groupby('id').size() == 1)]  # single-row studies
], ignore_index=True)
pairs['is_agg'] = pairs['aggregated'] == True
pairs = pairs.sort_values('id').reset_index(drop=True)
print(f'Pair-level rows: {len(pairs)} (unique ids: {pairs["id"].nunique()})')
print(f'  from aggregated==True: {(pairs["aggregated"]==True).sum()}; from single-row ids: {(pairs["aggregated"].isna()).sum()}')
assert pairs['id'].nunique() == len(pairs), 'pair-level ids not unique!'

# ---------- 2. Subject helper ----------
def student_shares(sub, label):
    total = len(sub)
    known = sub.dropna(subset=['subjects.o', 'subjects.r'])
    o_stud = (sub['subjects.o'] == 'students').sum()
    r_stud = (sub['subjects.r'] == 'students').sum()
    both = ((sub['subjects.o'] == 'students') & (sub['subjects.r'] == 'students')).sum()
    same = (sub['same_subjects'] == 1).sum()
    return {
        'domain': label, 'n_pairs': total,
        'o_students_n': int(o_stud), 'o_students_pct': round(100*o_stud/total, 2),
        'r_students_n': int(r_stud), 'r_students_pct': round(100*r_stud/total, 2),
        'both_students_n': int(both), 'both_students_pct': round(100*both/total, 2),
        'same_subjects_n': int(same), 'same_subjects_pct': round(100*same/total, 2),
    }

# ---------- rpp.154 impact ----------
na_row = pairs[pairs['subjects.o'].isna() | pairs['subjects.r'].isna()]
print('\nRows missing subject info (pair-level):', len(na_row), '->', na_row['id'].tolist())
print('Impact on total n: excluded 1 of', len(pairs), 'pairs (0.11%) -> kept', len(pairs)-len(na_row))

# ---------- 3. Shares per grouping (exclude the 1 missing-subject row from denominators) ----------
print('\n=========== DISCIPLINE grouping (pair-level, excl. rpp.154) ===========')
rows_dis = []
for d in sorted(pairs['discipline'].dropna().unique()):
    sub = pairs[pairs['discipline'] == d].dropna(subset=['subjects.o', 'subjects.r'])
    rows_dis.append(student_shares(sub, d))
res_dis = pd.DataFrame(rows_dis)
print(res_dis.to_string(index=False))

print('\n=========== PROJECT grouping (pair-level, excl. rpp.154) ===========')
rows_proj = []
for p in sorted(pairs['project'].dropna().unique()):
    sub = pairs[pairs['project'] == p].dropna(subset=['subjects.o', 'subjects.r'])
    rows_proj.append(student_shares(sub, p))
res_proj = pd.DataFrame(rows_proj)
print(res_proj.to_string(index=False))

# ---------- 4. Sensitivity: row-level view (all 927 rows) ----------
print('\n=========== SENSITIVITY: row-level (all 927 attempts) ===========')
rows_row = []
for d in sorted(df['discipline'].dropna().unique()):
    sub = df[df['discipline'] == d].dropna(subset=['subjects.o', 'subjects.r'])
    rows_row.append(student_shares(sub, d + '(row)'))
for p in sorted(df['project'].dropna().unique()):
    sub = df[df['project'] == p].dropna(subset=['subjects.o', 'subjects.r'])
    rows_row.append(student_shares(sub, p + '(row)'))
res_row = pd.DataFrame(rows_row)
print(res_row.to_string(index=False))

# ---------- 5. Decision scoring: majority on both sides + closeness to 82.4/80.9 ----------
print('\n=========== DECISION SCORING (pair-level) ===========')
target = (82.4, 80.9)
for r in res_dis.to_dict('records'):
    both_maj = r['o_students_pct'] > 50 and r['r_students_pct'] > 50
    dist = ((r['o_students_pct']-target[0])**2 + (r['r_students_pct']-target[1])**2)**0.5
    print(f"discipline={r['domain']:<11} o={r['o_students_pct']:5.1f}% r={r['r_students_pct']:5.1f}% both={r['both_students_pct']:5.1f}% "
          f"| both-sides-majority={both_maj} | dist_to_82.4/80.9={dist:.2f}")
for r in res_proj.to_dict('records'):
    both_maj = r['o_students_pct'] > 50 and r['r_students_pct'] > 50
    dist = ((r['o_students_pct']-target[0])**2 + (r['r_students_pct']-target[1])**2)**0.5
    print(f"project={r['domain']:<11} o={r['o_students_pct']:5.1f}% r={r['r_students_pct']:5.1f}% both={r['both_students_pct']:5.1f}% "
          f"| both-sides-majority={both_maj} | dist_to_82.4/80.9={dist:.2f}")

# ---------- 6. Second dataset role (side cross-check only) ----------
print('\n=========== SECOND DATASET (replication_success) ===========')
print('Columns:', list(df2.columns))
print('Has subjects/discipline fields:', any(c in df2.columns for c in ['subjects.o','subjects.r','discipline']))
print('study count:', df2['study'].nunique(), '| project counts:', df2['project'].value_counts().to_dict())
print('Confirms: effect-size/p-value only; NOT used in subject classification.')

# ---------- 7. What about the missing-subject row in row-level sensitivity ----------
print('\nRow-level (all rows incl. rpp.154) overall share: students.o=%.1f%% students.r=%.1f%%' % (
    100*(df['subjects.o']=='students').sum()/len(df), 100*(df['subjects.r']=='students').sum()/len(df)))

res_dis.to_csv('discipline_pairlevel_shares.csv', index=False)
res_proj.to_csv('project_pairlevel_shares.csv', index=False)
res_row.to_csv('rowlevel_sensitivity_shares.csv', index=False)
print('\nSaved CSVs: discipline_pairlevel_shares.csv, project_pairlevel_shares.csv, rowlevel_sensitivity_shares.csv')
