"""
DiscoveryBench: proportion of original studies in Experimental Economics (project == 'ee')
conducted in the United Kingdom (experiment_country.o == 'United Kingdom').

Workflow:
  1) Load the main study dataset (927 x 57).
  2) Filter 'original studies in Experimental Economics' = rows with project == 'ee' (denominator).
     - sanity: discipline == 'Economics' for all; drop flag False; aggregated empty.
     - duplicates: each ee 'id' appears exactly once -> counting rows == counting unique original studies.
     - missing: no NaN in experiment_country.o among ee.
  3) Numerator = ee rows with experiment_country.o == 'United Kingdom'.
  4) proportion = numerator / denominator, reported as fraction, percent.
"""
import pandas as pd

PATH = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"

df = pd.read_csv(PATH)
print(f"[1] Loaded dataset: {df.shape[0]} rows x {df.shape[1]} cols")
print(f"    project counts: {df['project'].value_counts().to_dict()}")

# ---- Denominator: original studies in Experimental Economics ----
ee = df[df['project'] == 'ee'].copy()
denom = len(ee)
print(f"\n[2] Denominator: rows with project=='ee' (Experimental Economics) = {denom}")

# sanity checks (transparency)
print(f"    unique ee ids = {ee['id'].nunique()}  (=> counting rows == counting original studies)")
print(f"    discipline values among ee: {ee['discipline'].value_counts().to_dict()}")
print(f"    drop==True among ee: {int(ee['drop'].sum())};  aggregated non-null among ee: {int(ee['aggregated'].notna().sum())}")
print(f"    missing experiment_country.o among ee: {int(ee['experiment_country.o'].isna().sum())}")

# ---- Numerator: among ee, conducted in the United Kingdom ----
uk = ee[ee['experiment_country.o'] == 'United Kingdom']
numer = len(uk)
print(f"\n[3] Numerator: ee rows with experiment_country.o == 'United Kingdom' = {numer}")
print(f"    UK study id(s): {uk['id'].tolist()} | title: {uk['title'].iloc[0] if numer else ''}")

# transparency: full country distribution among ee (confirms numerator/denominator)
print("\n[4] Country distribution among ee (experiment_country.o):")
print(ee['experiment_country.o'].value_counts().to_string())

# ---- Result ----
prop = numer / denom
print(f"\n[5] PROPORTION of original Experimental Economics studies conducted in the UK = "
      f"{numer}/{denom} = {prop:.4f} ({prop*100:.1f}%)")
