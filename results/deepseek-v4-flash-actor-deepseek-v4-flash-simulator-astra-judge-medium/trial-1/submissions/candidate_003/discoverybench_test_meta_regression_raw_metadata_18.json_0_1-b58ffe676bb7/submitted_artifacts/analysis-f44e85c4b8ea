#!/usr/bin/env python3
"""
Analysis: What proportion of studies in Experimental Economics were conducted in a lab setting?

Operational definitions (per approved plan):
  - "Studies in Experimental Economics" = the 18 original studies of the Experimental
    Economics Replication Project (dataset1 project=='ee' == discipline=='Economics'
    == dataset2 project=='Experimental Economics'; all three select the SAME 18 studies).
  - "Lab setting" = the experiment was NOT conducted online: online.o == 0.
    (Assumption: no explicit 'lab' column exists; not-online is the recorded proxy,
    cross-checked against subjects.o, experiment_country.o, same_online, us_lab.o.)
"""
import pandas as pd

D1 = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
D2 = "data/meta-regression_replication_success_data_heterogeneity_in_replication_projects.csv"

df1 = pd.read_csv(D1)
df2 = pd.read_csv(D2)

# ---- 1. Identify the Experimental Economics studies (dataset 1) ----
ee = df1[df1["project"] == "ee"].copy()
ee_alt = df1[df1["discipline"] == "Economics"]
print("== Scope check (project=='ee' vs discipline=='Economics') ==")
print("identical sets:", set(ee["id"]) == set(ee_alt["id"]),
      "| ee rows:", len(ee), "| Economics rows:", len(ee_alt))
print("unique id/title in ee:", ee["id"].nunique(), "/", ee["title"].nunique())

# ---- 2. Lab-setting proportion (original studies) ----
lab_orig = (ee["online.o"] == 0).sum()
denom = len(ee)
print("\n== Main result: original studies (EE) ==")
print(f"lab (online.o==0): {lab_orig}/{denom}  proportion = {lab_orig/denom:.4f} "
      f"({100*lab_orig/denom:.1f}%)")

# cross-checks
cross1 = ((ee["online.o"] == 0) & (ee["subjects.o"] != "online")).sum()
print(f"cross-check online.o==0 AND subjects.o!='online': {cross1}/{denom}")
print(f"experiment_country.o populated: {(ee['experiment_country.o'].notna()).sum()}/{denom}")
print(f"subjects.o value counts:\n{ee['subjects.o'].value_counts(dropna=False).to_string()}")
print(f"same_online value counts:\n{ee['same_online'].value_counts(dropna=False).to_string()}")
print(f"us_lab.o (US lab) value counts:\n{ee['us_lab.o'].value_counts(dropna=False).to_string()}")

# ---- 3. Replication-side rate (context) ----
lab_rep = (ee["online.r"] == 0).sum()
print(f"\n== Context: replication studies (EE) ==\nlab (online.r==0): {lab_rep}/{denom} "
      f"proportion = {lab_rep/denom:.4f}")

# ---- 4. Denominator verification against dataset 2 ----
ee2 = df2[df2["project"].str.lower() == "experimental economics"]
print("\n== Denominator verification (dataset 2) ==")
print(f"dataset2 'Experimental Economics' rows: {len(ee2)}, unique study: {ee2['study'].nunique()}")

# ---- 5. Whole-dataset lab rate (context) ----
sub = df1.dropna(subset=["online.o"])
overall = (sub["online.o"] == 0).mean()
print(f"\n== Context: whole-dataset lab rate (online.o==0) = {overall:.4f} "
      f"({(sub['online.o']==0).sum()}/{len(sub)})")
