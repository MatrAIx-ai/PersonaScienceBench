"""
Average length of original papers: Experimental Economics (project=ee) vs Psychology (project=rpp).

Dataset: meta-regression_study_data_heterogeneity_in_replication_projects.csv
Rows are replication attempts (original study x lab). length is an attribute of the
ORIGINAL paper, repeated across rows, so we average at the unique-original-paper level
(dedupe by title), not the row level.

Group mapping (canonical, per data dictionary project labels):
  - Experimental Economics = project == 'ee'  (discipline Economics; AER/QJE)
  - Psychology            = project == 'rpp' (discipline Social/Cognitive; PS/JPSP/JEPLMC)
  - ml1/ml3 (Many Labs) excluded.

length has 0 missing values -> no imputation needed.
Primary: all rows (including the 7 RPP rows flagged drop=True, which are real original papers).
Sensitivity: (a) exclude drop==True; (b) row-level averaging; (c) broad Psychology
(rpp + ml1 + ml3 Social/Cognitive).
"""
import pandas as pd

DATA = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
df = pd.read_csv(DATA)

print("Total rows:", len(df), "| unique titles:", df["title"].nunique())
print("Project counts:", df["project"].value_counts().to_dict())
print("length missing:", df["length"].isna().sum(), "| pub_year missing:", df["pub_year"].isna().sum())
print()

def summarize(sub, label):
    row_level = sub["length"]
    unique = sub.drop_duplicates(subset=["title"])
    up = unique["length"]
    print(f"--- {label} ---")
    print(f"  rows={len(sub)}  unique_original_papers={unique['title'].nunique()}")
    print(f"  unique-paper mean={up.mean():.3f}  median={up.median():.1f}  sd={up.std():.3f}  min={up.min()}  max={up.max()}")
    print(f"  row-level mean={row_level.mean():.3f} (n_rows={len(row_level)})")
    print(f"  disciplines={sub['discipline'].value_counts().to_dict()}")
    print(f"  journals={sub['journal'].value_counts().to_dict()}")
    return unique

# ---- Primary (canonical) analysis: average over unique original papers ----
ee_papers = summarize(df[df["project"] == "ee"], "Experimental Economics (project=ee)")
rpp_papers = summarize(df[df["project"] == "rpp"], "Psychology (project=rpp)")

print("\n=== PRIMARY RESULT (unique-original-paper level, all rows) ===")
print(f"Experimental Economics: mean original-paper length = {ee_papers['length'].mean():.2f} pages (n={len(ee_papers)})")
print(f"Psychology:            mean original-paper length = {rpp_papers['length'].mean():.2f} pages (n={len(rpp_papers)})")
print(f"Difference (EE - Psych): {ee_papers['length'].mean() - rpp_papers['length'].mean():.2f} pages")

# ---- Sensitivity checks ----
print("\n=== SENSITIVITY CHECKS ===")
# (a) exclude drop==True
rpp_nodrop = df[df["project"] == "rpp"]
rpp_nodrop = rpp_nodrop[rpp_nodrop["drop"] != True].drop_duplicates(subset=["title"])
print(f"(a) Psychology excluding 7 drop==True RPP studies: mean={rpp_nodrop['length'].mean():.3f} pages (n={len(rpp_nodrop)})")
# (b) row-level mean
print(f"(b) Row-level mean: EE={df.loc[df['project']=='ee','length'].mean():.3f} (n=18 rows), "
      f"Psych={df.loc[df['project']=='rpp','length'].mean():.3f} (n=97 rows)")
# (c) broad Psychology = all Social/Cognitive across rpp + ml1 + ml3
broad = df[df["project"].isin(["rpp", "ml1", "ml3"]) & df["discipline"].isin(["Social", "Cognitive"])]
broad = broad.drop_duplicates(subset=["title"])
print(f"(c) Broad Psychology (rpp+ml1+ml3, Social/Cognitive): mean={broad['length'].mean():.3f} pages (n={len(broad)} unique papers)")
# (d) discipline-based confirmation for the two groups
econ = df[df["discipline"] == "Economics"].drop_duplicates(subset=["title"])
rpp_sc = df[(df["project"] == "rpp") & df["discipline"].isin(["Social", "Cognitive"])].drop_duplicates(subset=["title"])
print(f"(d) Discipline-based: Economics mean={econ['length'].mean():.3f} (n={len(econ)}); "
      f"RPP Social/Cognitive unique-paper mean={rpp_sc['length'].mean():.3f} (n={len(rpp_sc)})")

# ---- Duplicate-paper handling note ----
dups = df[df["project"] == "rpp"].groupby("title").size()
print("\nRPP titles appearing more than once (same original paper, two replication attempts):")
print(dups[dups > 1].to_string())
