"""Primary + sensitivity analysis for:
'In which domain do the majority of authors tend to be male for both original and replication studies?'

Criterion (approved): majority-male-in-both = authors_male.o > 0.5 AND authors_male.r > 0.5,
at O/R-pair level (141 pairs, dedup by id), with each pair's replication ratio = mean of its lab rows.
Sensitivities: (a) row-level unit; (b) inclusive >= 0.5 threshold.
"""
import pandas as pd

df = pd.read_csv("data/meta-regression_study_data_heterogeneity_in_replication_projects.csv")

# ---------- Primary: per-pair, r = mean of lab rows ----------
pair = df.groupby("id").agg(
    discipline=("discipline", "first"),
    authors_male_o=("authors_male.o", "first"),
    authors_male_r=("authors_male.r", "mean"),
).reset_index()
assert len(pair) == 141

def summarize(d, label, o_col, r_col):
    d = d.copy()
    d["both_strict"] = (d[o_col] > 0.5) & (d[r_col] > 0.5)
    d["both_incl"]   = (d[o_col] >= 0.5) & (d[r_col] >= 0.5)
    rows = []
    for disc, g in d.groupby("discipline"):
        rows.append({
            "discipline": disc,
            "n": len(g),
            "mean_o": g[o_col].mean(),
            "mean_r": g[r_col].mean(),
            "cnt_both_strict": int(g["both_strict"].sum()),
            "share_both_strict": g["both_strict"].mean(),
            "cnt_both_incl": int(g["both_incl"].sum()),
            "share_both_incl": g["both_incl"].mean(),
        })
    out = pd.DataFrame(rows).sort_values("share_both_strict", ascending=False)
    print(f"\n===== {label} =====")
    print(out.round(3).to_string(index=False))
    return out

print("OVERALL sample sizes:")
print("  pairs:", len(pair), "| rows:", len(df))
print("  pair discipline counts:", pair["discipline"].value_counts().to_dict())

primary = summarize(pair, "PRIMARY: per-pair (141 pairs), r = mean of lab rows, strict >0.5 both",
                    "authors_male_o", "authors_male_r")

# ---------- Sensitivity (a): row-level unit ----------
row = summarize(df, "SENSITIVITY (a): row-level (927 lab-study rows) as unit",
                "authors_male.o", "authors_male.r")

# ---------- Sensitivity (b): per-pair but inclusive >= 0.5 (already in primary table above) ----------
# additionally: per-pair, r = mean, but ALSO report per-pair using r of the aggregated rows? not per-pair; skip.

# ---------- Support: cross-tab of joint majority statuses, per-pair ----------
pair["o_maj"] = pair["authors_male_o"] > 0.5
pair["r_maj"] = pair["authors_male_r"] > 0.5
joint = pair.groupby("discipline").apply(
    lambda g: pd.Series({
        "both_maj": int((g["o_maj"] & g["r_maj"]).sum()),
        "o_only": int((g["o_maj"] & ~g["r_maj"]).sum()),
        "r_only": int((~g["o_maj"] & g["r_maj"]).sum()),
        "neither": int((~g["o_maj"] & ~g["r_maj"]).sum()),
    }), include_groups=False)
print("\n===== Joint majority status counts (per-pair, strict >0.5) =====")
print(joint.to_string())

# ---------- Final decision support ----------
best = primary.loc[primary["share_both_strict"].idxmax()]
print("\n===== DECISION =====")
print("Domain with highest share of both-majority pairs:", best["discipline"],
      "| share:", round(best["share_both_strict"], 3),
      "| mean_o:", round(best["mean_o"], 3), "| mean_r:", round(best["mean_r"], 3))
print("\nMean-ratio corroboration (per-pair mean-of-labs):")
print(pair.groupby("discipline")[["authors_male_o", "authors_male_r"]].mean().round(3).to_string())

# dominance: is Economics also highest on both means?
means = pair.groupby("discipline")[["authors_male_o", "authors_male_r"]].mean()
print("\nHighest mean_o:", means["authors_male_o"].idxmax(),
      "| Highest mean_r:", means["authors_male_r"].idxmax())
