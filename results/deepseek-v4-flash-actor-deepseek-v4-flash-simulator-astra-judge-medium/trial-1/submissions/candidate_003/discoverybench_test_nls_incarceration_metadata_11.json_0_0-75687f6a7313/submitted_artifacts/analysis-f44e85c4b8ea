"""
NLS Incarceration & 1985 Median Wealth — Disparity Analysis
Question: What kind of demographic disparities exist in median wealth in 1985
among individuals who were ever incarcerated (jailed 1985-1994)?

Approach: median composite_wealth_1985 (robust to heavy right tail + negatives)
by race, sex, race x sex within ever_jailed==1, with never-jailed context,
sensitivity variants (exclude negatives / exclude zeros / top-1% trimmed),
and bootstrap 95% CIs for the jailed race medians.
"""
import numpy as np
import pandas as pd

rng = np.random.default_rng(42)
W = "composite_wealth_1985"

df = pd.read_csv("data/nls_incarceration_processed.csv")
# normalize the 'hipanic' typo -> hispanic
df["race"] = df["race"].str.replace("hipanic", "hispanic", regex=False)

def boot_ci_median(x, n_boot=10000, alpha=0.05):
    x = np.asarray(x, dtype=float)
    meds = np.array([
        np.median(rng.choice(x, size=len(x), replace=True))
        for _ in range(n_boot)
    ])
    lo, hi = np.percentile(meds, [100*alpha/2, 100*(1-alpha/2)])
    return lo, hi

def med_stats(sub, label=""):
    if len(sub) == 0:
        return None
    x = sub[W]
    neg = x[x < 0]
    zer = x[x == 0]
    pos = x[x > 0]
    qs = x.quantile([0.25, 0.5, 0.75])
    lo, hi = boot_ci_median(x)
    return {
        "group": label, "n": len(sub),
        "n_neg": int((x < 0).sum()), "n_zero": int((x == 0).sum()),
        "median_all": float(qs[0.5]), "q25": float(qs[0.25]), "q75": float(qs[0.75]),
        "median_no_neg": float(np.median(x[x >= 0])),
        "median_no_zero": float(np.median(x[x != 0])),
        "median_trim1pct": float(np.median(x[(x >= x.quantile(0.01)) & (x <= x.quantile(0.99))])),
        "mean": float(x.mean()),
        "boot_ci_95": (round(lo, 2), round(hi, 2)),
    }

rows = []
# 1) PRIMARY: ever_jailed==1 by race, sex, race x sex with context (ever_jailed==0)
for jailed in [1, 0]:
    sub = df[df["ever_jailed"] == jailed]
    rows.append(med_stats(sub, f"ever_jailed={jailed} (all)"))
    for r in ["black", "hispanic", "white"]:
        rows.append(med_stats(sub[sub["race"] == r], f"ever_jailed={jailed}, race={r}"))
    for s in ["male", "female"]:
        rows.append(med_stats(sub[sub["sex"] == s], f"ever_jailed={jailed}, sex={s}"))
    for r in ["black", "hispanic", "white"]:
        for s in ["male", "female"]:
            rows.append(med_stats(sub[(sub["race"] == r) & (sub["sex"] == s)],
                                  f"ever_jailed={jailed}, race={r}, sex={s}"))

res = pd.DataFrame(rows).set_index("group")
pd.set_option("display.width", 200)
pd.set_option("display.max_rows", 200)
pd.set_option("display.max_columns", 30)
print("="*100)
print("MEDIAN composite_wealth_1985 by group (all values incl. negatives/zeros)")
print("="*100)
print(res[["n","n_neg","n_zero","median_all","q25","q75","median_no_neg","median_no_zero","median_trim1pct","mean","boot_ci_95"]].to_string())
print()

# 2) Jailed vs never-jailed within race (the disparity gradient)
print("="*100)
print("Jailed vs Never-jailed median wealth within each race/sex (for context)")
print("="*100)
piv = res[["n","median_all"]].reset_index()
piv["jailed"] = piv["group"].str.extract(r"ever_jailed=(\d)")[0]
piv["demog"] = piv["group"].str.replace(r"ever_jailed=\d, ", "", regex=True)
pv = piv.pivot(index="demog", columns="jailed", values="median_all")
pv.columns = ["median_never_jailed","median_jailed"]
pv = pv[["median_jailed","median_never_jailed"]]
pv["diff"] = pv["median_jailed"] - pv["median_never_jailed"]
print(pv.to_string())
print()

# 3) Non-parametric: among jailed, do race medians differ? (Kruskal-Wallis, descriptive)
from scipy import stats
j = df[df["ever_jailed"] == 1]
groups = [j.loc[j["race"] == r, W].values for r in ["black","hispanic","white"]]
kw = stats.kruskal(*groups)
print("Kruskal-Wallis across races within ever_jailed==1: H=%.2f, p=%.4f" % (kw.statistic, kw.pvalue))
# pairwise Mann-Whitney (2-sided)
from itertools import combinations
for ra, rb in combinations(["black","hispanic","white"], 2):
    mw = stats.mannwhitneyu(
        j.loc[j["race"]==ra, W].values, j.loc[j["race"]==rb, W].values, alternative="two-sided")
    print(f"  Mann-Whitney {ra} vs {rb}: U={mw.statistic:.0f}, p={mw.pvalue:.4f}")
# jailed vs never-jailed per race
for r in ["black","hispanic","white"]:
    a = j.loc[j["race"]==r, W].values
    b = df.loc[(df["race"]==r)&(df["ever_jailed"]==0), W].values
    mw = stats.mannwhitneyu(a, b, alternative="two-sided")
    print(f"  Mann-Whitney {r}: jailed(n={len(a)}) vs never-jailed(n={len(b)}): p={mw.pvalue:.4f}")
print()

# 4) Zero shares within jailed by race (to explain median being driven to 0/low)
print("="*100)
print("Within ever_jailed==1: zero-wealth and negative-wealth shares by race")
print("="*100)
z = j.groupby("race")[W].agg(["count", lambda s:(s==0).mean(), lambda s:(s<0).mean()])
z.columns = ["n","share_zero","share_neg"]
print((z.round(3)).to_string())
print()

res.to_csv("analysis/median_wealth_by_group.csv")
print("Saved analysis/median_wealth_by_group.csv")
