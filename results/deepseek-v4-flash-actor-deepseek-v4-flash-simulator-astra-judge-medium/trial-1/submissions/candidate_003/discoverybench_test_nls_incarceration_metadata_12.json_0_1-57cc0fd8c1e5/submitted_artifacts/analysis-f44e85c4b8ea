#!/usr/bin/env python3
"""Step A: descriptives, growth, Mann-Whitney, Wilcoxon. Black subsample.
Income proxy quintiles = rank-based (equal-n) quintiles of composite_wealth_1985 within black sample.
"""
import numpy as np, pandas as pd
from scipy import stats
OUT="analysis/output"
df = pd.read_csv("data/nls_incarceration_processed.csv")
df = df[df["race"]=="black"].copy()
W={"1985":"composite_wealth_1985","1990":"composite_wealth_1990","1996":"composite_wealth_1996"}
QL=["Q1_lowest","Q2","Q3","Q4","Q5_highest"]
rq=pd.qcut(df["composite_wealth_1985"].rank(method="first"),5,labels=QL)
df["quintile"]=rq
nq=QL
print("Quintiles:",nq)
print("\nquintile x jailed counts (full black):\n",pd.crosstab(df["quintile"],df["ever_jailed"]))
tmp=df.assign(rq=df["quintile"])
print("\n1985-wealth ranges per quintile:")
print(tmp.groupby("quintile").apply(lambda g: pd.Series({"min":g["composite_wealth_1985"].min(),
 "max":g["composite_wealth_1985"].max(),"median85":g["composite_wealth_1985"].median(),"n":len(g)}),include_groups=False).to_string())

rows=[]
for q in nq:
  for j in [0,1]:
    sub=df[(df["quintile"]==q)&(df["ever_jailed"]==j)]
    for y in ["1985","1990","1996"]:
      v=sub[W[y]]
      rows.append({"quintile":q,"ever_jailed":j,"year":y,"n":len(sub),"median":v.median(),
        "mean":v.mean(),"q25":v.quantile(.25),"q75":v.quantile(.75),
        "pct_zero":(v==0).mean(),"pct_neg":(v<0).mean()})
desc=pd.DataFrame(rows)
pd.set_option("display.width",250);pd.set_option("display.max_rows",200)
s=desc.copy();s["med[q25,q75]"]=s.apply(lambda r:f"{r['median']:.0f} [{r['q25']:.0f},{r['q75']:.0f}]",axis=1)
s["zero%"]=(s["pct_zero"]*100).round(1);s["neg%"]=(s["pct_neg"]*100).round(1)
s["mean"]=s["mean"].round(0)
print("\n=== DESCRIPTIVES (quintile x jailed x year) ===")
print(s[["quintile","ever_jailed","year","n","med[q25,q75]","mean","zero%","neg%"]].to_string(index=False))
desc.to_csv(f"{OUT}/descriptives_by_quintile_jailed_year.csv",index=False)

print("\n=== GROWTH 1985->1996 (median & mean based) ===")
gr=[]
for q in nq:
  for j in [0,1]:
    sub=df[(df["quintile"]==q)&(df["ever_jailed"]==j)]
    if len(sub)==0: continue
    m85,m96=sub[W["1985"]].median(),sub[W["1996"]].median();a85,a96=sub[W["1985"]].mean(),sub[W["1996"]].mean()
    gr.append({"quintile":q,"ever_jailed":j,"n":len(sub),
     "med85":round(m85),"med96":round(m96),"abs_med":round(m96-m85),
     "rel_med%":round((m96-m85)/abs(m85)*100,1) if m85!=0 else None,
     "mean85":round(a85),"mean96":round(a96),"abs_mean":round(a96-a85),
     "rel_mean%":round((a96-a85)/abs(a85)*100,1) if a85!=0 else None})
g=pd.DataFrame(gr);print(g.to_string(index=False));g.to_csv(f"{OUT}/growth_1985_1996.csv",index=False)

print("\n=== MANN-WHITNEY U (jailed vs non), per quintile per year ===")
mwr=[]
for q in nq:
  for y in ["1985","1990","1996"]:
    j1=df[(df["quintile"]==q)&(df["ever_jailed"]==1)][W[y]];j0=df[(df["quintile"]==q)&(df["ever_jailed"]==0)][W[y]]
    if len(j1)<3 or len(j0)<3:
      mwr.append({"quintile":q,"year":y,"n_j":len(j1),"n_n":len(j0),"U":np.nan,"p":np.nan,"med_diff":np.nan});continue
    U,p=stats.mannwhitneyu(j1,j0,alternative="two-sided")
    mwr.append({"quintile":q,"year":y,"n_j":int(len(j1)),"n_n":int(len(j0)),"U":U,"p":round(p,4),"med_diff":round(j1.median()-j0.median(),1)})
mw=pd.DataFrame(mwr);print(mw.round(4).to_string(index=False));mw.to_csv(f"{OUT}/mannwhitney_by_quintile_year.csv",index=False)

print("\n=== WILCOXON signed-rank WITHIN group 1985->1996 ===")
wlr=[]
for q in nq:
  for j in [0,1]:
    sub=df[(df["quintile"]==q)&(df["ever_jailed"]==j)]
    d=sub[W["1996"]]-sub[W["1985"]];d=d[d!=0]
    if len(d)<3:
      wlr.append({"quintile":q,"ever_jailed":j,"n_nonzero":len(d),"median_change":np.nan,"p":np.nan});continue
    Ws,p=stats.wilcoxon(d,alternative="two-sided")
    wlr.append({"quintile":q,"ever_jailed":j,"n_nonzero":int(len(d)),"median_change":round(float(d.median()),1),"p":round(p,4)})
wl=pd.DataFrame(wlr);print(wl.to_string(index=False));wl.to_csv(f"{OUT}/wilcoxon_within_1985_1996.csv",index=False)

print("\n=== HEADLINE overall medians (all black) ===")
print(df.groupby("ever_jailed")[list(W.values())].median().round(0).to_string())
print("\nOverall jailed vs non: 1985 pct zero, 1996 pct zero:")
for j in [0,1]:
    sub=df[df["ever_jailed"]==j]
    print(f" jailed={j}: n={len(sub)}, zero85={(sub['composite_wealth_1985']==0).mean():.3f}, zero90={(sub['composite_wealth_1990']==0).mean():.3f}, zero96={(sub['composite_wealth_1996']==0).mean():.3f}, neg85={(sub['composite_wealth_1985']<0).mean():.3f}, neg96={(sub['composite_wealth_1996']<0).mean():.3f}")
