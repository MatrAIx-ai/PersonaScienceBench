import pandas as pd

OUT = pd.DataFrame()

def medians_for(df, label):
    df = df[['composite_wealth_1985','composite_wealth_1990','composite_wealth_1996']]
    m = df.median()
    rows = {
        'label': label,
        'n': len(df),
        'median_1985': m['composite_wealth_1985'],
        'median_1990': m['composite_wealth_1990'],
        'median_1996': m['composite_wealth_1996'],
        'abs_gain_85_90': m['composite_wealth_1990'] - m['composite_wealth_1985'],
        'abs_gain_90_96': m['composite_wealth_1996'] - m['composite_wealth_1990'],
        'abs_gain_85_96': m['composite_wealth_1996'] - m['composite_wealth_1985'],
        'rel_gain_85_90': (m['composite_wealth_1990'] - m['composite_wealth_1985']) / abs(m['composite_wealth_1985']),
        'rel_gain_90_96': (m['composite_wealth_1996'] - m['composite_wealth_1990']) / abs(m['composite_wealth_1990']),
    }
    return pd.DataFrame([rows])

df = pd.read_csv('data/nls_incarceration_processed.csv')
bf = df[(df['race'] == 'black') & (df['sex'] == 'female')]

# 1) Primary line: all black females as-is
res = medians_for(bf, 'primary: black females, all rows')

# 2) Sensitivity: deduplicate exact rows
bf_dedup = bf.drop_duplicates()
res = pd.concat([res, medians_for(bf_dedup, 'sens: dedup identical rows')], ignore_index=True)

# 3) Sensitivity: exclude ever_jailed==1
res = pd.concat([res, medians_for(bf[bf['ever_jailed'] == 0], 'sens: exclude ever_jailed')], ignore_index=True)

# 4) Sensitivity: exclude zero/negative wealth rows (only rows with all wealth > 0)
positive_mask = (bf['composite_wealth_1985'] > 0) & (bf['composite_wealth_1990'] > 0) & (bf['composite_wealth_1996'] > 0)
res = pd.concat([res, medians_for(bf[positive_mask], 'sens: only positive wealth (all years)')], ignore_index=True)

# 5) Sensitivity: exclude non-positive for each year separately (pairwise available wealth)
def pairwise_year_medians(df):
    """Median for each year computed over rows where that year's wealth is > 0 (standard per-year handling)."""
    out = {}
    for y in ['1985', '1990', '1996']:
        col = f'composite_wealth_{y}'
        m = df.loc[df[col] > 0, col].median()
        out[f'median_{y}'] = m
    out['abs_gain_85_90'] = out['median_1990'] - out['median_1985']
    out['abs_gain_90_96'] = out['median_1996'] - out['median_1990']
    out['abs_gain_85_96'] = out['median_1996'] - out['median_1985']
    out['label'] = 'sens: per-year wealth>0 medians (no abs value)'
    out['n'] = len(df)
    return pd.DataFrame([out])

res = pd.concat([res, pairwise_year_medians(bf)], ignore_index=True)

print("=== RESULT TABLE ===")
cols = ['label','n','median_1985','median_1990','median_1996',
        'abs_gain_85_90','abs_gain_90_96','abs_gain_85_96','rel_gain_85_90','rel_gain_90_96']
print(res[cols].to_string(index=False))

print("\n=== Winner by abs gain (adjacent periods), per line ===")
for _, r in res.iterrows():
    if pd.isna(r.get('abs_gain_85_90')):
        continue
    win = '1985->1990' if r['abs_gain_85_90'] > r['abs_gain_90_96'] else ('1990->1996' if r['abs_gain_90_96'] > r['abs_gain_85_90'] else 'tie')
    print(f"{r['label']:<50} winner={win}")

res.to_csv('results_table.csv', index=False)
print("\nSaved results_table.csv")
