def gini(x):
    """Gini on bottom-coded-at-0 wealth (negatives floored to 0)."""
    x = np.asarray(x, dtype=float)
    x = np.where(x < 0, 0.0, x)   # bottom-code at 0
    x = np.sort(x)
    n = len(x)
    if n == 0 or x.sum() <= 0:
        return np.nan
    idx = np.arange(1, n+1)
    return float((2*np.sum(idx*x) - (n+1)*np.sum(x)) / (n*np.sum(x)))

def gini_pos(x):
    """Gini computed on positive-wealth-only subset (sensitivity)."""
    x = np.asarray(x, dtype=float)
    x = x[x > 0]
    if len(x) == 0:
        return np.nan
    x = np.sort(x)
    n = len(x)
    idx = np.arange(1, n+1)
    return float((2*np.sum(idx*x) - (n+1)*np.sum(x)) / (n*np.sum(x)))

def top_share(x, q=0.90):
    """Share of total (bottom-coded) wealth held by the top (1-q) share of individuals."""
    x = np.asarray(x, dtype=float)
    x = np.where(x < 0, 0.0, x)
    x = np.sort(x)[::-1]
    total = x.sum()
    if total <= 0:
        return np.nan
    k = max(1, int(round((1-q)*len(x))))
    return x[:k].sum() / total

def pct_ratios(s):
    p25, p50, p75, p90, p95 = [s.quantile(p) for p in (0.25,0.50,0.75,0.90,0.95)]
    def ratio(num, den):
        return np.nan if den <= 0 else num/den
    return dict(p25=p25, p50=p50, p75=p75, p90=p90, p95=p95,
                p90_p50=ratio(p90,p50), p75_p50=ratio(p75,p50),
                p95_p50=ratio(p95,p50), p75_p25=ratio(p75,p25))

def describe(s):
    s = s.copy()
    stats = dict(
        n=len(s),
        mean=s.mean(),
        median=s.median(),
        mean_med_ratio=s.mean()/s.median() if s.median()>0 else np.nan,
        pct_nonpositive=(s<=0).mean()*100,
        pct_negative=(s<0).mean()*100,
        pct_zero=(s==0).mean()*100,
    )
    stats.update(pct_ratios(s))
    stats['gini_bottomcoded'] = gini(s)
    stats['gini_posonly'] = gini_pos(s)
    stats['top10_share'] = top_share(s, 0.90)
    stats['top5_share'] = top_share(s, 0.95)
    return stats

