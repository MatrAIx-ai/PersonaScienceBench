# ---- Bootstrap CI for headline Gini (bottom-coded) ----
print("\nBOOTSTRAP 95% CI for bottom-coded Gini (2000 reps):")
rng = np.random.default_rng(42)
for sx in ['male','female']:
    sub = w[w['sex']==sx]
    for y in years:
        arr = sub[f'composite_wealth_{y}'].to_numpy(dtype=float)
        arr = np.where(arr<0,0,arr)
        boots = []
        for _ in range(2000):
            b = rng.choice(arr, size=len(arr), replace=True)
            bs = np.sort(b); n=len(bs); idx=np.arange(1,n+1)
            if bs.sum()>0:
                boots.append((2*np.sum(idx*bs)-(n+1)*np.sum(bs))/(n*np.sum(bs)))
        lo,hi = np.percentile(boots,[2.5,97.5])
        print(f"  white {sx} {y}: Gini = {gini(arr):.3f}  [95% CI {lo:.3f}, {hi:.3f}]")

