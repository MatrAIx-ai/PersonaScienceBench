import pandas as pd
import numpy as np

df = pd.read_csv('data/nls_incarceration_processed.csv')
pd.set_option('display.width', 200)
pd.set_option('display.max_columns', 50)

print("="*70)
print("BASIC SHAPE & TYPES")
print("="*70)
print("Shape (rows, cols):", df.shape)
print()
print("Dtypes:")
print(df.dtypes)

print()
print("="*70)
print("HEAD (first 8 rows)")
print("="*70)
print(df.head(8).to_string())

print()
print("="*70)
print("MISSING VALUES")
print("="*70)
print("Missing per column:")
print(df.isna().sum())
print("Any NaN anywhere:", df.isna().any().any())

print()
print("="*70)
print("CATEGORICAL STRUCTURE: race, sex, ever_jailed")
print("="*70)
for c in ['race','sex','ever_jailed']:
    print(f"\n{c} value_counts (incl NA):")
    print(df[c].value_counts(dropna=False))

print()
print("Value combinations race x sex:")
print(pd.crosstab(df['race'], df['sex']))

print()
print("ever_jailed x race cross-tab:")
print(pd.crosstab(df['race'], df['ever_jailed']))
print("\never_jailed x sex cross-tab:")
print(pd.crosstab(df['sex'], df['ever_jailed']))
print("\never_jailed x race x sex cross-tab:")
print(pd.crosstab([df['race'],df['sex']], df['ever_jailed']))

print()
print("="*70)
print("WEALTH COLUMNS: ranges, zeros, negatives")
print("="*70)
wcols = ['composite_wealth_1985','composite_wealth_1990','composite_wealth_1996']
for c in wcols:
    s = df[c]
    nz = (s==0).sum()
    neg = (s<0).sum()
    pos = (s>0).sum()
    print(f"\n{c}:")
    print(f"  min={s.min():.0f}, max={s.max():.0f}, mean={s.mean():.1f}, median={s.median():.0f}")
    print(f"  zeros={nz} ({nz/len(s)*100:.1f}%), negatives={neg} ({neg/len(s)*100:.2f}%), positives={pos} ({pos/len(s)*100:.1f}%)")
    print(f"  std={s.std():.1f}, skew={s.skew():.2f}, kurtosis={s.kurtosis():.2f}")

print()
print("="*70)
print("DISTRIBUTION SUMMARY (percentiles) - all data")
print("="*70)
desc = df[wcols].describe(percentiles=[.01,.05,.1,.25,.5,.75,.9,.95,.99]).T
print(desc.to_string())

print()
print("="*70)
print("SUMMARY STATS BY RACE x SEX x ever_jailed")
print("="*70)
# simpler
g = df.groupby(['race','sex','ever_jailed'])[wcols].mean()
print(g.to_string())
print()
g2 = df.groupby(['race','sex','ever_jailed'])[wcols].median()
print(g2.to_string())
print()
g3 = df.groupby(['race','sex','ever_jailed'])[wcols].count()
print(g3.to_string())

print()
print("="*70)
print("ZERO / NEGATIVE PATTERNS (all rows share zero in multiple years?)")
print("="*70)
allzero = (df[wcols]==0).all(axis=1).sum()
print(f"Rows with 0 in ALL three wealth cols: {allzero} ({allzero/len(df)*100:.1f}%)")
print(f"Rows with any negative in 1990 or 1996: {((df['composite_wealth_1990']<0)|(df['composite_wealth_1996']<0)).sum()}")

print()
print("="*70)
print("ever_jailed structure: is it predictable from wealth?")
print("="*70)
# correlation of ever_jailed with wealth
print("Correlation of ever_jailed with wealth cols:")
print(df[wcols+['ever_jailed']].corr()['ever_jailed'].to_string())
# ever_jailed vs zero wealth
for c in wcols:
    zero_vs_jail = pd.crosstab(df[c]==0, df['ever_jailed'])
    print(f"\ncrosstab ({c} zero vs ever_jailed):")
    print(zero_vs_jail)

print()
print("="*70)
print("WHITE SUBSET - core analysis population")
print("="*70)
w = df[df['race']=='white']
print("White rows:", len(w))
print(pd.crosstab(w['sex'], w['ever_jailed']))
print()
for sx in ['male','female']:
    sub = w[w['sex']==sx]
    print(f"white {sx}: n={len(sub)}")
    for c in wcols:
        s=sub[c]
        print(f"  {c}: min={s.min():.0f}, max={s.max():.0f}, mean={s.mean():.0f}, median={s.median():.0f}, zeros={(s==0).sum()} ({(s==0).sum()/len(s)*100:.1f}%), neg={(s<0).sum()}, skew={s.skew():.2f}")

# print data types as string for clarity
print()
print("Raw dtypes as strings:", dict(df.dtypes.astype(str)))
