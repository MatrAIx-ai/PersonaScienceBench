import pandas as pd, numpy as np
df = pd.read_csv('data/nls_incarceration_processed.csv')
w = df[df['race']=='white'].copy()

print("WHITE SUBSET — NON-POSITIVE SHARES & PERCENTILE LOCATIONS\n")
for sx in ['male','female']:
    sub = w[w['sex']==sx]
    for y in [1990,1996]:
        c=f'composite_wealth_{y}'
        s=sub[c]
        p=[.05,.1,.25,.5,.75,.9,.95]
        pcts=s.quantile(p).to_dict()
        nonpos=((s<=0)).mean()*100
        neg=(s<0).mean()*100
        zero=(s==0).mean()*100
        print(f"white {sx} {y}: n={len(sub)} | mean={s.mean():.0f} med={s.median():.0f} | %<=0={nonpos:.1f} %<0={neg:.1f} %=0={zero:.1f}")
        print(f"   P05/P10/P25/P50/P75/P90/P95 = " + " / ".join(f"{pcts[q]:.0f}" for q in p))
    print()

# Percentile ratios feasibility
print("P90/P10 feasibility (ratios only computable if P10>0):")
for sx in ['male','female']:
    sub = w[w['sex']==sx]
    for y in [1990,1996]:
        s=sub[f'composite_wealth_{y}']
        p10=s.quantile(.10); p90=s.quantile(.90); p50=s.quantile(.50)
        ratio = np.nan if p10<=0 else p90/p10
        print(f"  white {sx} {y}: P10={p10:.0f} P50={p50:.0f} P90={p90:.0f} P90/P10={'NA' if p10<=0 else round(ratio,1)}")

# Gini feasibility: compute simple Gini on positive-only vs all (positive wealth only, Gini well-defined)
def gini(x):
    x = np.asarray(x, dtype=float)
    x = x[x>0]
    if len(x)==0: return np.nan
    x = np.sort(x)
    n = len(x)
    index = np.arange(1, n+1)
    return (2*np.sum(index*x) - (n+1)*np.sum(x)) / (n*np.sum(x))

print("\nGini (positive-wealth-only, for reference):")
for sx in ['male','female']:
    sub = w[w['sex']==sx]
    for y in [1990,1996]:
        s=sub[f'composite_wealth_{y}']
        print(f"  white {sx} {y}: Gini={gini(s):.3f}  (n positive={(s>0).sum()})")
