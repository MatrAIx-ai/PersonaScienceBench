import numpy as np
import pandas as pd
from scipy import stats
from statsmodels.formula.api import ols, quantreg

df = pd.read_csv('data/nls_incarceration_processed.csv')
df['jailed'] = df['ever_jailed']
# dummies (reference: white, female)
df['race_black'] = (df['race'] == 'black').astype(int)
df['race_hipanic'] = (df['race'] == 'hipanic').astype(int)
df['male'] = (df['sex'] == 'male').astype(int)

wealth_cols = ['composite_wealth_1985','composite_wealth_1990','composite_wealth_1996']
alpha = 0.05
n_tests = 3
bonf = alpha / n_tests

results = []
print("=" * 100)
print("PRIMARY: one-sided Mann-Whitney U (jailed < non-jailed)")
print("=" * 100)
for c in wealth_cols:
    j = df.loc[df['jailed'] == 1, c].values
    nj = df.loc[df['jailed'] == 0, c].values
    n1, n2 = len(j), len(nj)
    U, p = stats.mannwhitneyu(j, nj, alternative='less', method='auto')
    # normal approx z
    mu = n1 * n2 / 2.0
    sigma = np.sqrt(n1 * n2 * (n1 + n2 + 1) / 12.0)
    z = (U - mu) / sigma
    N = n1 + n2
    r_z = z / np.sqrt(N)
    rank_biserial = 1 - 2 * U / (n1 * n2)
    p_bonf = min(p * n_tests, 1.0)
    med_j, med_nj = np.median(j), np.median(nj)
    mean_j, mean_nj = np.mean(j), np.mean(nj)
    sig = "YES" if p < alpha else "no"
    sig_b = "YES" if p < bonf else "no"
    results.append(c)
    print(f"\n{c}: n_jailed={n1}, n_nonjailed={n2}")
    print(f"  medians (jailed / non): {med_j:,.0f} / {med_nj:,.0f}   (diff non-jailed - jailed = {med_nj - med_j:,.0f})")
    print(f"  means  (jailed / non): {mean_j:,.0f} / {mean_nj:,.0f}")
    print(f"  U = {U:,.0f}, z = {z:.3f}")
    print(f"  p (one-sided raw) = {p:.6f}  -> significant at alpha=0.05: {sig}")
    print(f"  p (Bonferroni*3)  = {p_bonf:.6f}  -> significant at 0.0167: {sig_b}")
    print(f"  effect size: r = z/sqrt(N) = {r_z:.4f};  rank-biserial = 1-2U/(n1*n2) = {rank_biserial:.4f}")

print("\n" + "=" * 100)
print("ROBUSTNESS 1: median (quantile) regression wealth ~ jailed + race + sex")
print("=" * 100)
for c in wealth_cols:
    mod = quantreg(c + ' ~ jailed + race_black + race_hipanic + male', df)
    res = mod.fit(q=0.5)
    b = res.params['jailed']
    p = res.pvalues['jailed']
    print(f"{c}: median-reg coef jailed = {b:,.1f}  (p = {p:.4f})  sign={'NEG' if b<0 else 'POS'}")

print("\n" + "=" * 100)
print("ROBUSTNESS 2: OLS on winsorized wealth (clip at 99th pct) ~ jailed + race + sex")
print("=" * 100)
for c in wealth_cols:
    clip = df[c].quantile(0.99)
    df['_w'] = df[c].clip(upper=clip)
    res = ols('_w ~ jailed + race_black + race_hipanic + male', df).fit()
    b = res.params['jailed']
    p = res.pvalues['jailed']
    print(f"{c}: OLS(winsor, clip={clip:,.0f}) coef jailed = {b:,.0f}  (p = {p:.4f})  sign={'NEG' if b<0 else 'POS'}")

print("\n" + "=" * 100)
print("ROBUSTNESS 3: OLS on log(wealth - min + 1) ~ jailed + race + sex")
print("=" * 100)
for c in wealth_cols:
    shift = df[c].min() - 1
    df['_logw'] = np.log(df[c] - shift)
    res = ols('_logw ~ jailed + race_black + race_hipanic + male', df).fit()
    b = res.params['jailed']
    p = res.pvalues['jailed']
    print(f"{c}: OLS(log-shift {shift:,.0f}) coef jailed = {b:.4f}  (p = {p:.4f})  sign={'NEG' if b<0 else 'POS'}")

print("\n" + "=" * 100)
print("SUMMARY TABLE")
print("=" * 100)
summary = []
for c in wealth_cols:
    j = df.loc[df['jailed'] == 1, c].values
    nj = df.loc[df['jailed'] == 0, c].values
    U, p = stats.mannwhitneyu(j, nj, alternative='less', method='auto')
    mu = len(j) * len(nj) / 2.0
    sigma = np.sqrt(len(j) * len(nj) * (len(j) + len(nj) + 1) / 12.0)
    z = (U - mu) / sigma
    r_z = z / np.sqrt(len(j) + len(nj))
    summary.append({
        'year': c,
        'median_jailed': np.median(j),
        'median_non': np.median(nj),
        'p_raw': p,
        'p_bonf': min(p * n_tests, 1.0),
        'r': r_z,
    })
tbl = pd.DataFrame(summary)
print(tbl.to_string(index=False, float_format=lambda x: f"{x:.4f}"))
tbl.to_csv('analysis/summary_table.csv', index=False)
