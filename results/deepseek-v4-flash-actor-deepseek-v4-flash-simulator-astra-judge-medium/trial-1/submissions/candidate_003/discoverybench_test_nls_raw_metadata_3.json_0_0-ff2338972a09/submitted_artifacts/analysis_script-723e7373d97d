"""NLSY79 subset analysis: how academic characteristics alter SES & race effects on
educational attainment (proxy for eventual BA completion).
Outcome = 'Highest grade completed, 1979' (0-20). Cohort aged 14-22 in 1979 -> EARLY
attainment; n=39 have >=16 yrs (BA proxy n is reported, not used in conclusions)."""
import pandas as pd, numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf
from statsmodels.stats.anova import anova_lm
from scipy import stats

rng = np.random.default_rng(20261022)
df = pd.read_csv("data/nls_raw.csv")

def z(x):
    m, s = np.nanmean(x), np.nanstd(x)
    return (x - m) / s if s > 0 else (x - m)
def rowmean(M, mc):
    cnt = M.notna().sum(axis=1)
    return M.sum(axis=1, min_count=1).where(cnt >= mc) / cnt.where(cnt >= mc)

df['female'] = (df['Sex of respondent, 1979'] == 2).astype(float)
df['black'] = (df['Racial/ethnic cohort, 1979'] == 1).astype(float)
df['hispanic'] = (df['Racial/ethnic cohort, 1979'] == 2).astype(float)
df['age'] = df['Age of respondent, 1979'].astype(float)

hg = df['Highest grade completed, 1979'].replace(95, np.nan)
df['yrs'] = hg; df['y'] = z(hg)
df['some_college'] = (hg >= 13).astype(float); df['ba_proxy'] = (hg >= 16).astype(float)

df['linc'] = np.log1p(df['Total net family income, previous calendar year, 1979'])
df['momedu'] = df["Highest grade completed by respondent's mother, 1979"].astype(float)
df['dadedu'] = df["Highest grade completed by respondent's father, 1979"].astype(float)
df['famsize'] = df['Family size, 1979'].astype(float)
occ = df['Occupation of adult male in household at age 14, 1979'].astype(float)
df['profocc'] = pd.Series(np.where(occ.isna(), np.nan, ((occ >= 0) & (occ < 300)).astype(float)), index=df.index)

ses_parts = pd.DataFrame({'zlinc': z(df['linc']), 'zmomedu': z(df['momedu']), 'zdadedu': z(df['dadedu']),
                          'zprofocc': z(df['profocc']), 'znfamsize': z(-df['famsize'])})
df['SESz'] = rowmean(ses_parts, 4)     # composite over available components (any 4 of 5)

asv_cols = [c for c in df.columns if c.startswith("ASVAB")]
df['asvab_z'] = z(pd.DataFrame({c: z(df[c]) for c in asv_cols}).mean(axis=1))
rank = df['Rank in class last year attended at this school, 1981'].astype(float)
nstu = df['Number of students in class last year attended at this school, 1981'].astype(float)
df['classpct'] = (1.0 - rank / nstu).clip(0, 1)

# ---- samples
core_comp = ['y', 'black', 'hispanic', 'female', 'age', 'SESz', 'asvab_z']
S1 = df[core_comp + ['yrs', 'some_college', 'ba_proxy', 'linc', 'momedu', 'dadedu', 'famsize', 'profocc', 'classpct']].dropna(subset=core_comp)  # composite sample
S_ind = S1.dropna(subset=['linc', 'momedu', 'dadedu', 'famsize', 'profocc'])   # all individual SES indicators
S2 = S1.dropna(subset=['classpct'])                                            # rank subsample

out = []
def p(*a):
    line = " ".join(str(x) for x in a); print(line); out.append(line)
def fit(f, d): return smf.ols(f, data=d).fit()
def att(a, b): return (1 - b / a) * 100

p("="*100)
p("NLSY79 analysis: SES & race effects on educational attainment, with/without academic characteristics")
p("Cohort aged 14-22 in 1979 -> outcome = highest grade completed by 1979 (early attainment)")
p("Composite sample S1 n=%d (race+sex+age+SESz+ASVAB); individual-indicator sample n=%d; rank subsample n=%d" % (len(S1), len(S_ind), len(S2)))

# ---- descriptive
p("\n[D1] Descriptive by race (full file)")
p(df.groupby('Racial/ethnic cohort, 1979').agg(n=('yrs', 'size'), yrs_mean=('yrs', 'mean'),
    some_college_pct=('some_college', 'mean'), ba_proxy_pct=('ba_proxy', 'mean'), asvab_mean=('asvab_z', 'mean'),
    SESz_mean=('SESz', 'mean'), profocc_pct=('profocc', 'mean'), med_inc=('linc', 'median')).round(3).to_string())
p("\n[D2] SES z-index quartiles x attainment")
df['sesq'] = pd.qcut(df['SESz'], 4, labels=['Q1(low)', 'Q2', 'Q3', 'Q4(high)'])
p(df.groupby('sesq', observed=True).agg(n=('yrs', 'size'), yrs_mean=('yrs', 'mean'),
    some_college_pct=('some_college', 'mean'), asvab_mean=('asvab_z', 'mean')).round(3).to_string())

# ---- composite models (S1)
F_A = "y ~ black + hispanic + female + age"
F_Bz = "y ~ black + hispanic + female + age + SESz"
F_Cz = "y ~ black + hispanic + female + age + SESz + asvab_z"
mA = fit(F_A, S1); mBz = fit(F_Bz, S1); mCz = fit(F_Cz, S1)
p("\n[M1] Composite models (S1 n=%d): R2 A=%.4f Bz=%.4f Cz=%.4f" % (len(S1), mA.rsquared, mBz.rsquared, mCz.rsquared))
def block_table(models, names):
    rows = [[n, m.params['black'], m.bse['black'], m.pvalues['black'], m.params['hispanic'], m.bse['hispanic'], m.pvalues['hispanic']] for n, m in zip(names, models)]
    p(pd.DataFrame(rows, columns=['model', 'black_b', 'black_se', 'black_p', 'hisp_b', 'hisp_se', 'hisp_p']).set_index('model').round(4).to_string())
p("Race coefficients across A / Bz / Cz:")
block_table([mA, mBz, mCz], ['A(basic)', 'Bz(+SES)', 'Cz(+ASVAB)'])
p("SESz and ASVAB: Bz: SESz=%.4f(se %.3f) | Cz: SESz=%.4f(se %.3f), asvab_z=%.4f(se %.3f)" % (mBz.params['SESz'], mBz.bse['SESz'], mCz.params['SESz'], mCz.bse['SESz'], mCz.params['asvab_z'], mCz.bse['asvab_z']))
af, ap_ = anova_lm(mBz, mCz)['F'].iloc[1], anova_lm(mBz, mCz)['Pr(>F)'].iloc[1]
p("Joint significance of ASVAB block (Cz vs Bz): F=%.2f p=%.2e" % (af, ap_))
p("\n[M2] % change in coefficients adding ASVAB (Bz -> Cz):")
p("  SESz:    %.4f -> %.4f  (%+.1f%%)" % (mBz.params['SESz'], mCz.params['SESz'], att(mBz.params['SESz'], mCz.params['SESz'])))
p("  black:   %.4f -> %.4f  (%+.1f%%)" % (mBz.params['black'], mCz.params['black'], att(mBz.params['black'], mCz.params['black'])))
p("  hispanic:%.4f -> %.4f  (%+.1f%%)" % (mBz.params['hispanic'], mCz.params['hispanic'], att(mBz.params['hispanic'], mCz.params['hispanic'])))

# ---- individual-indicator models (S_ind)
F_B = "y ~ black + hispanic + female + age + linc + momedu + dadedu + famsize + profocc"
F_C = "y ~ black + hispanic + female + age + linc + momedu + dadedu + famsize + profocc + asvab_z"
mBi = fit(F_B, S_ind); mCi = fit(F_C, S_ind)
p("\n[M3] Individual SES indicators (S_ind n=%d): R2 B=%.4f C=%.4f" % (len(S_ind), mBi.rsquared, mCi.rsquared))
p(pd.DataFrame({'B': mBi.params, 'B_se': mBi.bse, 'C': mCi.params, 'C_se': mCi.bse}).loc[
    ['linc', 'momedu', 'dadedu', 'famsize', 'profocc', 'asvab_z']].round(4).to_string())
for v in ['linc', 'momedu', 'dadedu', 'famsize', 'profocc']:
    p("  %-9s %.4f -> %.4f  (%+.1f%%)" % (v, mBi.params[v], mCi.params[v], att(mBi.params[v], mCi.params[v])))

# ---- rank subsample -> D
p("\n[M4] Class-standing subsample S2 n=%d (restricted to in-school 1980; structural missingness)" % len(S2))
mB2 = fit(F_Bz, S2); mC2 = fit(F_Cz, S2)
F_Dz = "y ~ black + hispanic + female + age + SESz + asvab_z + classpct"
mD = fit(F_Dz, S2)
p("  R2 Bz2=%.4f Cz2=%.4f D=%.4f ; classpct b=%.4f(se %.3f p=%.1e)" % (mB2.rsquared, mC2.rsquared, mD.rsquared, mD.params['classpct'], mD.bse['classpct'], mD.pvalues['classpct']))
p("  SESz: Bz2=%.4f -> Cz2=%.4f -> D=%.4f  (Bz2->D %+.1f%%)" % (mB2.params['SESz'], mC2.params['SESz'], mD.params['SESz'], att(mB2.params['SESz'], mD.params['SESz'])))
p("  Black: Bz2=%.4f -> Cz2=%.4f -> D=%.4f  (Bz2->D %+.1f%%)" % (mB2.params['black'], mC2.params['black'], mD.params['black'], att(mB2.params['black'], mD.params['black'])))
p("  Hisp:  Bz2=%.4f -> Cz2=%.4f -> D=%.4f  (Bz2->D %+.1f%%)" % (mB2.params['hispanic'], mC2.params['hispanic'], mD.params['hispanic'], att(mB2.params['hispanic'], mD.params['hispanic'])))

# ---- logit robustness
p("\n[M5] Logit robustness (S1)")
Lb = smf.logit("some_college ~ black + hispanic + female + age + SESz", data=S1).fit(disp=0)
Lc = smf.logit("some_college ~ black + hispanic + female + age + SESz + asvab_z", data=S1).fit(disp=0)
p("  >=13yrs: Black %+.4f->%+.4f (OR %.3f->%.3f) ; Hisp %+.4f->%+.4f (OR %.3f->%.3f) ; asvab OR %.3f ; SESz OR %.3f->%.3f" % (
    Lb.params['black'], Lc.params['black'], np.exp(Lb.params['black']), np.exp(Lc.params['black']),
    Lb.params['hispanic'], Lc.params['hispanic'], np.exp(Lb.params['hispanic']), np.exp(Lc.params['hispanic']),
    np.exp(Lc.params['asvab_z']), np.exp(Lb.params['SESz']), np.exp(Lc.params['SESz'])))
p("  >=16yrs BA proxy: counts by race " + str(df.groupby('Racial/ethnic cohort, 1979')['ba_proxy'].agg(['sum', 'count']).to_dict('index')) + " -> n=39, too sparse; not used.")
# ---- mediation (product method with bootstrap CI; direct = total - indirect)
def mediate(Xvar, f_tot, f_dir):
    m_tot = smf.ols(f_tot, data=S1).fit()
    a = smf.ols("asvab_z ~ %s + female + age" % Xvar, data=S1).fit().params[Xvar]
    m_dir = smf.ols(f_dir, data=S1).fit()
    b = m_dir.params['asvab_z']
    ind = a * b; tot = m_tot.params[Xvar]
    inds = []
    n = len(S1)
    for _ in range(500):
        s = S1.iloc[rng.integers(0, n, n)]
        inds.append(smf.ols("asvab_z ~ %s + female + age" % Xvar, data=s).fit().params[Xvar] *
                    smf.ols(f_dir, data=s).fit().params['asvab_z'])
    lo, hi = np.percentile(inds, [2.5, 97.5])
    direct = tot - ind
    pct = 100 * ind / tot if abs(tot) > 1e-9 else np.nan
    p("  %-8s total=%.4f indirect(via_ASVAB)=%.4f [95%%CI %.4f,%.4f] direct=%.4f %%mediated=%.1f" % (Xvar, tot, ind, lo, hi, direct, pct))
    return dict(total=tot, indirect=ind, direct=direct, ci=(lo, hi), pct=pct)

p("\n[M6] Mediation via ASVAB composite (S1; associational; 1981 ASVAB vs 1979 outcome; timing caveat)")
FT = "y ~ black + hispanic + female + age + SESz"
FD = "y ~ black + hispanic + female + age + SESz + asvab_z"
med_black = mediate('black', FT, FD)
med_hisp = mediate('hispanic', FT, FD)
med_ses = mediate('SESz', FT, FD)

# ---- interactions
mI = smf.ols("y ~ black + hispanic + female + age + SESz + asvab_z + black:asvab_z + hispanic:asvab_z + SESz:asvab_z", data=S1).fit()
p("\n[M7] Interactions (S1): does ASVAB moderate SES/race gaps?")
p("  black:asvab=%.4f(p=%.3f) hispanic:asvab=%.4f(p=%.3f) SESz:asvab=%.4f(p=%.3f)" % (
    mI.params['black:asvab_z'], mI.pvalues['black:asvab_z'], mI.params['hispanic:asvab_z'],
    mI.pvalues['hispanic:asvab_z'], mI.params['SESz:asvab_z'], mI.pvalues['SESz:asvab_z']))
av = S1['asvab_z']
for lab, q in [('low(p10)', av.quantile(.1)), ('mean', av.mean()), ('high(p90)', av.quantile(.9))]:
    gb = mI.params['black'] + mI.params['black:asvab_z'] * q
    gh = mI.params['hispanic'] + mI.params['hispanic:asvab_z'] * q
    gs = mI.params['SESz'] + mI.params['SESz:asvab_z'] * q
    p("  at ASVAB %-9s: Black gap=%+.3f Hisp gap=%+.3f SESz slope=%.3f" % (lab, gb, gh, gs))

# ---- MI sensitivity (20 imputations, chained OLS with proper residual ddof, Rubin's rules)
def mice_once(data, iters=10, noise=True):
    r2 = np.random.default_rng(int(rng.integers(1, 1e9)))
    X = data.copy()
    for _ in range(iters):
        for var in X.columns:
            miss = X[var].isna()
            if miss.sum() == 0: continue
            ok = X.drop(columns=[var]).notna().all(axis=1) & ~miss
            if ok.sum() < 20: continue
            y = X.loc[ok, var]; Xp = X.loc[ok].drop(columns=[var]); Xp['_c'] = 1.0
            beta = np.linalg.lstsq(Xp.values, y.values, rcond=None)[0]
            resid = y.values - Xp.values @ beta
            sigma = resid.std(ddof=Xp.shape[1])
            pm = X.loc[miss].drop(columns=[var]); pm['_c'] = 1.0
            X.loc[miss, var] = pm.values @ beta + (r2.normal(0, sigma, miss.sum()) if noise else 0.0)
    return X

def fit_pooled(f, imps):
    coefs = pd.DataFrame([smf.ols(f, data=i).fit().params for i in imps])
    ses = pd.DataFrame([smf.ols(f, data=i).fit().bse for i in imps])
    est = coefs.mean(); W = (ses ** 2).mean(); B = coefs.var(ddof=1)
    return est, np.sqrt(W + (1 + 1 / len(imps)) * B)

p("\n[M8] MI sensitivity: 20 imputations (chained OLS, corrected ddof), full file n with race/sex/age.")
mi_vars = ['y', 'black', 'hispanic', 'female', 'age', 'SESz', 'asvab_z']
mimat = df[mi_vars].copy().dropna(subset=['black', 'hispanic', 'female', 'age'])
mimat['age'] = z(mimat['age'])
imps = [mice_once(mimat) for _ in range(20)]
eB, sB = fit_pooled("y ~ black + hispanic + female + age + SESz", imps)
eC, sC = fit_pooled("y ~ black + hispanic + female + age + SESz + asvab_z", imps)
def zp(e, s): return 2 * stats.norm.sf(abs(e / s))
p("  n=%d | Pooled Bz: SESz=%.4f(se %.4f p=%.2e) Black=%.4f(%.4f) Hisp=%.4f(%.4f)" % (
    len(mimat), eB['SESz'], sB['SESz'], zp(eB['SESz'], sB['SESz']), eB['black'], sB['black'], eB['hispanic'], sB['hispanic']))
p("  Pooled Cz: SESz=%.4f(se %.4f) Black=%.4f(%.4f) Hisp=%.4f(%.4f) asvab_z=%.4f(%.4f)" % (
    eC['SESz'], sC['SESz'], eC['black'], sC['black'], eC['hispanic'], sC['hispanic'], eC['asvab_z'], sC['asvab_z']))
p("  Pooled change Bz->Cz: SESz %+.1f%% ; Black %+.1f%% ; Hisp %+.1f%%" % (
    att(eB['SESz'], eC['SESz']), att(eB['black'], eC['black']), att(eB['hispanic'], eC['hispanic'])))

