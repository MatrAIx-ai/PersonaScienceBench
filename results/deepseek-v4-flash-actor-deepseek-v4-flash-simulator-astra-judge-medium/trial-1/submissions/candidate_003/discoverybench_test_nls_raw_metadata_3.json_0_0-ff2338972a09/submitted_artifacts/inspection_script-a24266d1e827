"""Exploratory inspection of NLSY79 subset (data/nls_raw.csv)."""
import pandas as pd, numpy as np

df = pd.read_csv("data/nls_raw.csv")
print("SHAPE:", df.shape)
print("DUP ids:", df['ID# (range 1-12686) 1979'].duplicated().sum())

info = df.notna().sum()
for c in df.columns:
    print(f"{c} | nonnull={info[c]:6d} ({info[c]/len(df)*100:5.1f}%) | dtype={df[c].dtype}")

print("\nRace value counts:", df['Racial/ethnic cohort, 1979'].value_counts().sort_index().to_dict())
print("Sex value counts:", df['Sex of respondent, 1979'].value_counts().sort_index().to_dict())
print("Age 1979 min/med/max:", df['Age of respondent, 1979'].min(), df['Age of respondent, 1979'].median(), df['Age of respondent, 1979'].max())
h = df['Highest grade completed, 1979']
print("Highest grade 1979: >=16 n =", (h>=16).sum(), "; 95-code n =", (h==95).sum())
asv = [c for c in df.columns if c.startswith("ASVAB")]
print("ASVAB corr:\n", df[asv].corr().round(3).to_string())
r = df['Rank in class last year attended at this school, 1981']
ns = df['Number of students in class last year attended at this school, 1981']
print("corr(rank_pct, ASVAB_AR)=", pd.concat([r/ns, df[asv[0]]], axis=1).corr().iloc[0,1].round(3))

key = ['Racial/ethnic cohort, 1979','Sex of respondent, 1979','Age of respondent, 1979',
       'Total net family income, previous calendar year, 1979',
       "Highest grade completed by respondent's mother, 1979",
       "Highest grade completed by respondent's father, 1979",
       'Family size, 1979','Highest grade completed, 1979']
acad = asv + ['Rank in class last year attended at this school, 1981','Number of students in class last year attended at this school, 1981']
print("\nComplete-case n (SES+outcome):", len(df[key].dropna()))
print("Complete-case n (+ASVAB):", len(df[key+asv].dropna()))
print("Complete-case n (+ASVAB+rank):", len(df[key+acad].dropna()))
