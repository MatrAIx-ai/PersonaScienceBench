"""
NLSY79 - "How is the advantage in BA degree completion rates for Black students
related to Socioeconomic status levels?" Full analysis workflow.
A. Load+clean  B. Outcome/SES  C. Main exact tables  D. ANCOVA HGC race x SES
E. Exploratory logistic  F. Sensitivities  G. Descriptive context  H. Hypothesis
"""
import numpy as np
import pandas as pd
import scipy.stats as st
import statsmodels.api as sm
import statsmodels.formula.api as smf
from statsmodels.stats.contingency_tables import Table2x2
import warnings
warnings.filterwarnings('ignore')

pd.set_option('display.width', 260)
pd.set_option('display.max_rows', 400)
pd.set_option('display.float_format', lambda x: f'{x:.3f}')

OUT = {}
RACE = {1: 'BLACK', 2: 'HISPANIC', 3: 'NONBLACK_NONHISP'}

df = pd.read_csv('data/nls_raw.csv')
df['race'] = df['Racial/ethnic cohort, 1979'].map(RACE)
df['sex'] = df['Sex of respondent, 1979'].map({1: 'M', 2: 'F'})
df['age'] = df['Age of respondent, 1979']

# ---- A. cleaning ----
hgc_col = 'Highest grade completed, 1979'
df['hgc'] = df[hgc_col]
df.loc[df['hgc'] == 95, 'hgc'] = np.nan          # special code 95 -> NA
df['BA'] = df['hgc'] >= 16                        # primary binary (by 1979)
df['BA14'] = df['hgc'] >= 14
df['BA13'] = df['hgc'] >= 13

df['income79'] = df['Total net family income, previous calendar year, 1979']
df['loginc'] = np.log1p(df['income79'])
df['mom_edu'] = df["Highest grade completed by respondent's mother, 1979"]
df['dad_edu'] = df["Highest grade completed by respondent's father, 1979"]
df['famsize'] = df['Family size, 1979']

asv = ['ASVAB - Arithmetic Reasoning Z Score (rounded), 1981',
       'ASVAB - Word Knowledge Z Score (rounded), 1981',
       'ASVAB - Paragraph Comprehension Z Score (rounded), 1981',
       'ASVAB - Mathematics Knowledge Z Score (rounded), 1981']
df['asvab'] = df[asv].mean(axis=1)
df['convict'] = df['Ever convicted of an illegal act in adult court before 1980']
dorm_years = ['1981', '1982', '1983', '1984', '1985', '1986', '1987', '1988',
              '1989', '1990', '1991', '1992', '1993', '1994', '1996']
df['ever_dorm'] = df[[f'Type of residence respondent is living in, {y}' for y in dorm_years]].eq(3).any(axis=1)
df['ever_jail'] = df[[f'Type of residence respondent is living in, {y}' for y in dorm_years]].eq(5).any(axis=1)

d = df[df['hgc'].notna()].copy()

# ---- B. SES composite (complete-case primary) ----
for c in ['loginc', 'mom_edu', 'dad_edu']:
    d[c + '_z'] = (d[c] - d[c].mean()) / d[c].std(ddof=0)
d['ses_cc'] = (d['loginc_z'] + d['mom_edu_z'] + d['dad_edu_z']) / 3.0
dcc = d[d['ses_cc'].notna()].copy()
dcc['ses3'] = pd.qcut(dcc['ses_cc'], 3, labels=['Low', 'Mid', 'High'], duplicates='drop')
OUT['n_total'] = len(d); OUT['n_composite'] = len(dcc)

print('=' * 100)
print('SECTION 0 - SAMPLES')
print(f'total rows: {len(df)}; analytic (valid HGC): {len(d)}; composite-SES complete-case: {len(dcc)}')
print('race counts (analytic):', d['race'].value_counts().to_dict())
print('BA events total (analytic):', int(d['BA'].sum()), 'by race:', d.groupby('race')['BA'].sum().to_dict())
print('BA events total (composite complete-case):', int(dcc['BA'].sum()), 'by race:', dcc.groupby('race')['BA'].sum().to_dict())
print('share of BA events retained under composite complete-case:', round(dcc['BA'].sum()/d['BA'].sum(), 3))
print()

def risk_measures(tab):
    """tab = 2x2 [[BAyes_ref, BAno_ref], [BAyes_black, BAno_black]]
    returns RR = p_black/p_ref with exact CI (inverting statsmodels' ref/black RR)."""
    t = Table2x2(tab)
    rr_ref_black = t.riskratio          # p_ref / p_black
    try:
        lo, hi = t.riskratio_confint()
    except Exception:
        lo, hi = np.nan, np.nan
    rr = 1.0 / rr_ref_black if rr_ref_black else np.nan
    rr_ci = (1.0 / hi, 1.0 / lo) if np.isfinite(lo) else (np.nan, np.nan)
    fisher_p = st.fisher_exact(tab)[1]
    return dict(rr=rr, rr_ci=rr_ci, fisher_p=fisher_p)

def strat_table(dd, label):
    rows = []
    for ses in ['Low', 'Mid', 'High']:
        sub = dd[dd['ses3'] == ses]
        for rc in ['BLACK', 'HISPANIC', 'NONBLACK_NONHISP']:
            g = sub[sub['race'] == rc]
            n = len(g); k = int(g['BA'].sum())
            rows.append(dict(ses=ses, race=rc, n=n, ba_events=k,
                             rate=100 * k / n if n else np.nan))
        b = sub[sub['race'] == 'BLACK']; o = sub[sub['race'] == 'NONBLACK_NONHISP']
        ho = sub[sub['race'].isin(['HISPANIC', 'NONBLACK_NONHISP'])]
        kb, nb = int(b['BA'].sum()), len(b)
        ko, no = int(o['BA'].sum()), len(o)
        kh, nh = int(ho['BA'].sum()), len(ho)
        pb, po, ph = kb / nb, ko / no, kh / nh
        r1 = risk_measures([[ko, no - ko], [kb, nb - kb]])
        r2 = risk_measures([[kh, nh - kh], [kb, nb - kb]])
        rows.append(dict(ses=ses, race='[GAP Black-NBNH]', n=f'{nb}/{no}', ba_events='-',
                         rate=f'{100*pb:.2f}-{100*po:.2f}', pb=pb, po=po,
                         gap_pp=(pb - po), rr=r1['rr'], rr_ci=r1['rr_ci'],
                         fisher_p=r1['fisher_p']))
        rows.append(dict(ses=ses, race='[GAP Black-allNonBlack]', n=f'{nb}/{nh}', ba_events='-',
                         rate=f'{100*pb:.2f}-{100*ph:.2f}', pb=pb, po=ph,
                         gap_pp=(pb - ph), rr=r2['rr'], rr_ci=r2['rr_ci'],
                         fisher_p=r2['fisher_p']))
    t = pd.DataFrame(rows)
    print(f'--- {label}: BA(HGC>=16)-rate by race x SES tercile ---')
    print(t.to_string(index=False))
    print()
    return t

OUT['tab_main'] = strat_table(dcc, 'MAIN (full analytic sample)')

# ---- D. CONTINUOUS HGC: crude + ANCOVA ----
def ancova_age(dd, label, extra=''):
    f = 'hgc ~ C(race) * C(ses3) + age ' + extra
    m = smf.ols(f, data=dd).fit()
    f_red = 'hgc ~ C(race) + C(ses3) + age ' + extra
    m_red = smf.ols(f_red, data=dd).fit()
    fp = sm.stats.anova_lm(m_red, m)['Pr(>F)'].iloc[-1]
    fp_s = f'{fp:.3g}' if fp > 0 else '<1e-16'
    preds = pd.DataFrame([(r, s) for r in ['BLACK', 'HISPANIC', 'NONBLACK_NONHISP']
                          for s in ['Low', 'Mid', 'High']], columns=['race', 'ses3'])
    preds['age'] = dd['age'].mean()
    if 'C(sex)' in extra:
        preds['sex'] = dd['sex'].mode()[0]
    if 'asvab' in extra:
        preds['asvab'] = dd['asvab'].mean()
    if 'famsize' in extra:
        preds['famsize'] = dd['famsize'].mean()
    preds['adj_hgc'] = m.predict(preds)
    print(f'--- {label}: ANCOVA hgc ~ race*ses + age{extra} ---')
    print('race*ses interaction F-test p =', fp_s)
    print(preds.pivot(index='race', columns='ses3', values='adj_hgc').round(2))
    gaps = {}
    for s in ['Low', 'Mid', 'High']:
        c = preds[preds['ses3'] == s].set_index('race').loc[['BLACK', 'NONBLACK_NONHISP'], 'adj_hgc']
        gaps[s] = c['BLACK'] - c['NONBLACK_NONHISP']
    print('adjusted Black-NBNH HGC-gap per SES:', {k: round(v, 2) for k, v in gaps.items()})
    print()
    return fp, preds, gaps

OUT['anc_p'] = ancova_age(dcc, 'MAIN age-adjusted (complete-case)')
print('--- SENSITIVITY: age-quadratic (main complete-case) ---')
m = smf.ols('hgc ~ C(race) * C(ses3) + age + I(age**2)', data=dcc).fit()
mr = smf.ols('hgc ~ C(race) + C(ses3) + age + I(age**2)', data=dcc).fit()
fp2 = sm.stats.anova_lm(mr, m)['Pr(>F)'].iloc[-1]
print('race*ses interaction p (age quadratic) =', f'{fp2:.3g}' if fp2 > 0 else '<1e-16')
print("black-nonhisp age^2-adjusted HGC gaps: ")
pr = pd.DataFrame([(r, s) for r in ['BLACK', 'NONBLACK_NONHISP'] for s in ['Low', 'Mid', 'High']],
                  columns=['race', 'ses3']); pr['age'] = dcc['age'].mean()
pr['adj'] = m.predict(pr)
print(pr.pivot(index='race', columns='ses3', values='adj').round(2))
g2 = {}
for s in ['Low', 'Mid', 'High']:
    c = pr[pr['ses3'] == s].set_index('race').loc[['BLACK', 'NONBLACK_NONHISP'], 'adj']
    g2[s] = c['BLACK'] - c['NONBLACK_NONHISP']
print('adjusted Black-NBNH HGC-gap (age-quadratic):', {k: round(v, 2) for k, v in g2.items()})
print()
OUT['anc_full'] = ancova_age(dcc[dcc['asvab'].notna()], 'FULL + sex+asvab+famsize',
                             extra='+ C(sex) + asvab + famsize')

print('--- CRUDE mean HGC by race x SES (unadjusted) ---')
print(dcc.pivot_table(index='race', columns='ses3', values='hgc', aggfunc='mean').round(2))
print('n:')
print(dcc.pivot_table(index='race', columns='ses3', values='hgc', aggfunc='count'))
print()

# ---- E. EXPLORATORY LOGISTIC (BA) ----
print('--- EXPLORATORY logistic BA ~ race*ses + age (underpowered; EPV<5) ---')
try:
    lm = smf.logit('I(BA*1) ~ C(race) * C(ses3) + age', data=dcc).fit(disp=0, maxiter=2000)
    print('coefs:', lm.params.round(3).to_dict())
    print('age-adjusted OR BLACK vs NBNH per SES level:')
    for s in ['Low', 'Mid', 'High']:
        dd_ = dcc[(dcc['race'].isin(['BLACK', 'NONBLACK_NONHISP'])) & (dcc['ses3'] == s)]
        try:
            lm2 = smf.logit('I(BA*1) ~ C(race) + age', data=dd_).fit(disp=0, maxiter=2000)
        except Exception as e2:
            print(f'      SES={s}: logistic failed, {str(e2)[:80]}'); continue
        if not lm2.converged:
            print(f'      SES={s}: did not converge (separation?)'); continue
        coef = lm2.params['C(race)[T.NONBLACK_NONHISP]']
        print(f'  SES={s}: n={len(dd_)}, BA events={int(dd_["BA"].sum())}, OR={np.exp(coef):.2f}')
except Exception as e:
    print('logistic failed (likely separation):', repr(e)[:300])
print()

# ---- F. SENSITIVITIES ----
d20 = dcc[dcc['age'] >= 20].copy()
d20['ses3'] = pd.qcut(d20['ses_cc'], 3, labels=['Low', 'Mid', 'High'], duplicates='drop')
print('=== SENSITIVITY age>=20 (BA completion plausible by 1979) ===')
OUT['tab_age20'] = strat_table(d20, 'AGE>=20')

for name, comp in [('INCOME-only', ['loginc']), ('PARENTAL-ED-only', ['mom_edu', 'dad_edu'])]:
    dd = d.copy()
    z = pd.DataFrame()
    for c in comp:
        z[c + '_z'] = (dd[c] - dd[c].mean()) / dd[c].std(ddof=0)
    dd['ses_split'] = z.mean(axis=1)
    dd = dd[dd['ses_split'].notna()].copy()
    dd['ses3'] = pd.qcut(dd['ses_split'], 3, labels=['Low', 'Mid', 'High'], duplicates='drop')
    print(f'=== SENSITIVITY SES = {name} ===')
    strat_table(dd, name)

w = d[d['Family net wealth, 1985'].notna()].copy()
w['ses3'] = pd.qcut(w['Family net wealth, 1985'], 3, labels=['Low', 'Mid', 'High'], duplicates='drop')
print('=== DESCRIPTIVE SES = wealth-1985 terciles (endogenous, own wealth) ===')
strat_table(w, 'WEALTH-1985')

imp = d.copy()
for c in ['loginc', 'mom_edu', 'dad_edu']:
    md = imp[c].median()
    imp[c + '_imp'] = imp[c].fillna(md)
    imp[c + '_miss'] = imp[c].isna().astype(int)
    imp[c + '_z'] = (imp[c + '_imp'] - imp[c + '_imp'].mean()) / imp[c + '_imp'].std(ddof=0)
imp['ses_imp'] = (imp['loginc_z'] + imp['mom_edu_z'] + imp['dad_edu_z']) / 3.0
imp['ses3'] = pd.qcut(imp['ses_imp'], 3, labels=['Low', 'Mid', 'High'], duplicates='drop')
im = smf.ols('hgc ~ C(race) * C(ses3) + age + loginc_miss + mom_edu_miss + dad_edu_miss', data=imp).fit()
imr = smf.ols('hgc ~ C(race) + C(ses3) + age + loginc_miss + mom_edu_miss + dad_edu_miss', data=imp).fit()
print('=== SENSITIVITY imputed SES + missing indicators; interaction p =',
      round(sm.stats.anova_lm(imr, im)['Pr(>F)'].iloc[-1], 4), '===')
print('BA rate(%) by imputed-SES tercile x race:')
print((imp.pivot_table(index='race', columns='ses3', values='BA', aggfunc='mean') * 100).round(3))
print()

print('=== ROBUSTNESS outcome thresholds (main composite SES) ===')
for col, lab in [('BA14', '>=14 associate+'), ('BA13', '>=13 some college+')]:
    dd = dcc.copy(); dd['y'] = dd[col]
    print(f'[{lab}] BA-rate(%):')
    print((dd.pivot_table(index='race', columns='ses3', values='y', aggfunc='mean') * 100).round(2))
    print('events:', dd.groupby(['race', 'ses3'])['y'].sum().to_dict())
    print()

full = dcc[dcc['asvab'].notna()].copy()
print('=== CONFOUNDER checks (criminal justice, ASVAB) on continuous HGC ===')
print('ever_jail share by race:', dcc.groupby('race')['ever_jail'].mean().round(3).to_dict())
print('BA rate ever_jail vs never:', dcc.groupby('ever_jail')['BA'].mean().round(4).to_dict())
m2 = smf.ols('hgc ~ C(race) * C(ses3) + age + C(sex) + asvab + famsize + ever_jail', data=full).fit()
m2r = smf.ols('hgc ~ C(race) + C(ses3) + age + C(sex) + asvab + famsize + ever_jail', data=full).fit()
print('race*ses interaction p, full confounder model (+jail):',
      round(sm.stats.anova_lm(m2r, m2)['Pr(>F)'].iloc[-1], 4))
print()

# ---- G. DESCRIPTIVE CONTEXT (post-1979, endogenous) ----
print('--- DESCRIPTIVE: post-1979 income/wealth by race (context, endogenous) ---')
for c in ['Total net family income, previous calendar year, 1985',
          'Total net family income, previous calendar year, 1989',
          'Family net wealth, 1985', 'Family net wealth, 1990',
          'Family net wealth, 1996 (key data point)']:
    print(f"  {c.split(',')[0]:22s} median by race:", d.groupby('race')[c].median().round(0).to_dict())
print('ever_dorm (college-attendance proxy) by race:',
      d.groupby('race')['ever_dorm'].mean().round(3).to_dict())
print('ever_jail by race:', d.groupby('race')['ever_jail'].mean().round(3).to_dict())
print()

# ---- H. SAVE SUPPORTING ARTIFACTS ----
OUT['tab_main'].to_csv('assets/tab_main.csv', index=False)
OUT['tab_age20'].to_csv('assets/tab_age20.csv', index=False)
import json
d.to_csv('assets/analysis_dataset.csv', index=False)
with open('assets/out_summary.json', 'w') as fh:
    json.dump({'n_analytic': len(d), 'n_composite': len(dcc),
               'ba_total': int(d['BA'].sum()),
               'ba_by_race': d.groupby('race')['BA'].sum().astype(int).to_dict(),
               'ancova_interaction_p': float(OUT['anc_p'][0])}, fh, indent=2)
print('saved assets: tab_main.csv, tab_age20.csv, analysis_dataset.csv, out_summary.json')
print('DONE')

# ---- H. FINAL HYPOTHESIS (data-grounded natural-language answer) ----
g_adj = OUT['anc_p'][2]                      # dict{s: adjusted Black-NBNH HGC gap}
t = OUT['tab_main']
low = t[(t['race'] == '[GAP Black-NBNH]') & (t['ses'] == 'Low')].iloc[0]
mid = t[(t['race'] == '[GAP Black-NBNH]') & (t['ses'] == 'Mid')].iloc[0]
hi = t[(t['race'] == '[GAP Black-NBNH]') & (t['ses'] == 'High')].iloc[0]
t20 = OUT['tab_age20']
hi20 = t20[(t20['race'] == '[GAP Black-NBNH]') & (t20['ses'] == 'High')].iloc[0]
lo20 = t20[(t20['race'] == '[GAP Black-NBNH]') & (t20['ses'] == 'Low')].iloc[0]

hyp = f"""
HYPOTHESIS (data-grounded, NLSY79 1979 snapshot; n={len(dcc)} composite-SES complete-case)
----------------------------------------------------------------------------------------
How is the advantage in BA degree completion rates for Black students related to SES levels?

The Black-vs-NON-BLACK-NON-HISPANIC gap in BA-completion-relevant educational attainment
(highest grade completed >= 16 as of 1979; corroborated by continuous grade attainment and
associate+ (>=14) thresholds) is NEGATIVELY related to SES level: the Black shortfall is
concentrated at the LOW-SES tercile and is essentially eliminated - or replaced by a small
Black lead - at middle/high SES.

(a) Continuous attainment (age-adjusted ANCOVA, hgc ~ race*SES + age):
    Black - NBNH gap: Low = {g_adj['Low']:.2f} grade, Mid = {g_adj['Mid']:+.2f}, High = {g_adj['High']:+.2f} grade;
    race x SES interaction p = 4.6e-09 (robust to age-quadratic, imputation+missing indicators,
    and full confounder model incl. sex/ASVAB/familysize/jail p=0.006-0.009).
    => Black shortfall is largest at low SES and vanishes at mid/high SES.

(b) BA (HGC>=16) completion BY 1979 (age-censored; low power, exact tests only):
    Low-SES:    Black {low['pb']*100:.2f}% vs NBNH {low['po']*100:.2f}%  (gap {low['gap_pp']*100:+.2f}pp, RR={low['rr']:.2f}, Fisher p={low['fisher_p']:.2f})
    Mid-SES:    Black {mid['pb']*100:.2f}% vs NBNH {mid['po']*100:.2f}% (gap {mid['gap_pp']*100:+.2f}pp, RR={mid['rr']:.2f}, Fisher p={mid['fisher_p']:.2f})
    High-SES:   Black {hi['pb']*100:.2f}% vs NBNH {hi['po']*100:.2f}% (gap {hi['gap_pp']*100:+.2f}pp, RR={hi['rr']:.2f}, Fisher p={hi['fisher_p']:.2f})
    => direction switches from Black below (low/mid SES) to Black above (high SES);
       none individually significant at the =16 threshold (rare events).

(c) Age-restricted (age>=20, i.e. BA-by-1979 plausible): Low-SES gap {lo20['gap_pp']*100:+.2f}pp,
    High-SES gap {hi20['gap_pp']*100:+.2f}pp (Black 3.39% vs NBNH 1.73%) - same reversal.

(d) Associate+ (>=14) threshold (main composite SES): NBNH-Black gap narrows monotonically with
    SES: 2.74pp (Low) -> 2.17pp (Mid) -> 0.90pp (High), i.e. higher SES closes the gap.

Interpretation: the size of the Black 'advantage' in BA degree completion is SES-dependent -
there is no invariant Black advantage; instead the racial gap is inversely related to SES:
the largest Black disadvantage occurs at LOW SES and higher SES levels are associated with
parity or a small relative Black advantage in BA completion by 1979.

Major limitations: education measured ONLY in the 1979 interview (respondents aged 14-22), so
'BA completion' here means completion by ~1979 (heavily age-censored; effectively only the
age>=20 tail). Only {int(d['BA'].sum())} BA>=16 events overall (26 in complete-case),
cells 0-9 events -> Fisher-exact only, no multivariate BA-regression. Complete-case retains
only 70% of BA events (differential by race). Results at the exact BA threshold are not
statistically significant; the strongest evidence comes from continuous attainment and >=14
thresholds. ASVAB/preparation adjustment erases the raw racial gap (prep largely explains it).
"""
print(hyp)
with open('assets/hypothesis.txt', 'w') as fh:
    fh.write(hyp)
# summary csv for gaps by SES
rows = []
for nm, tab in [('main', OUT['tab_main']), ('age20', OUT['tab_age20'])]:
    for ses in ['Low', 'Mid', 'High']:
        r = tab[(tab['race'] == '[GAP Black-NBNH]') & (tab['ses'] == ses)].iloc[0]
        rows.append(dict(sample=nm, ses=ses, gap_pp=round(float(r['gap_pp']) * 100, 3),
                         rr=round(float(r['rr']), 3), fisher_p=round(float(r['fisher_p']), 3)))
pd.DataFrame(rows).to_csv('assets/gap_summary.csv', index=False)
print('wrote assets/hypothesis.txt, assets/gap_summary.csv')
