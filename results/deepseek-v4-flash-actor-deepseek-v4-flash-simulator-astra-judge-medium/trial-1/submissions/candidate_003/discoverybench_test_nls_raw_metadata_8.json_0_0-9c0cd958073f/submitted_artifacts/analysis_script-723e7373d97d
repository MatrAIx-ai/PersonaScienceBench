"""NLSY79 family net wealth: white vs black vs Hispanic medians, 1985-1996.

Cohort mapping (documented assumption, evidence-based, DEVIATES from datasets.json schema):
    1 = HISPANIC        (schema in datasets.json says 1=BLACK - reversed)
    2 = BLACK
    3 = NON-BLACK NON-HISPANIC  ('white' proxy)
File-internal + real NLSY79 (R0217800) evidence: group 2 lowest median wealth in
every snapshot, group sizes match real oversample design (~3,002 Black).
"""
import pandas as pd
import numpy as np

df = pd.read_csv('data/nls_raw.csv')
cohort = 'Racial/ethnic cohort, 1979'
wcols = ['Family net wealth, 1985', 'Family net wealth, 1990', 'Family net wealth, 1996 (key data point)']
years = [1985, 1990, 1996]

groups = {
    'Hispanic': 1,
    'Black': 2,
    'White (non-Black non-Hispanic)': 3,
}
group_short = {'Hispanic': 'HISP', 'Black': 'BLK', 'White (non-Black non-Hispanic)': 'WHT'}

# ---- 1) PRIMARY: per-year complete-case medians (nominal $) ----
print('=' * 78)
print('PRIMARY: per-year medians, nominal dollars (complete-case per year, no imputation)')
print('=' * 78)
rows = []
for y, col in zip(years, wcols):
    s = pd.to_numeric(df[col], errors='coerce')
    for gname, code in groups.items():
        sub = s[df[cohort] == code]
        n = int(sub.notna().sum())
        med = sub.median()
        rows.append({'year': y, 'group': gname, 'n': n, 'median_nominal': med})
    # ratios this year
    w = s[df[cohort] == 3].median()
    b = s[df[cohort] == 2].median()
    h = s[df[cohort] == 1].median()
    print(f'year={y}:  WHT med={w:>12,.0f}  BLK med={b:>10,.0f}  HISP med={h:>10,.0f}   '
          f'WHT:BLK={w/b:5.2f}  WHT:HISP={w/h:5.2f}')
    rows[-3]['WHT:BLK'] = w / b
    rows[-3]['WHT:HISP'] = w / h

prim = pd.DataFrame(rows[::3]).copy()
# attach n
for i, gname in enumerate(groups):
    pass
table = []
for gname in groups:
    row = {'group': gname}
    ns = []
    for y, col in zip(years, wcols):
        s = pd.to_numeric(df[col], errors='coerce')
        sub = s[df[cohort] == groups[gname]]
        row[f'med{y}'] = sub.median()
        row[f'n{y}'] = int(sub.notna().sum())
        ns.append(int(sub.notna().sum()))
    row['growth_mult_85_96'] = row['med1996'] / row['med1985']
    row['n_min_cell'] = min(ns)
    table.append(row)
t = pd.DataFrame(table)
print(t.to_string(index=False, float_format=lambda x: f'{x:,.2f}' if abs(x) < 100 else f'{x:,.0f}'))

print()
# ratios by year
print('RATIOS per year (nominal): white:black, white:hispanic')
for y, col in zip(years, wcols):
    s = pd.to_numeric(df[col], errors='coerce')
    w = s[df[cohort] == 3].median(); b = s[df[cohort] == 2].median(); h = s[df[cohort] == 1].median()
    print(f'  {y}: WHT:BLK = {w/b:.2f}   WHT:HISP = {w/h:.2f}')

print()
print('GROWTH 1985->1996 nominal multiple per group:')
for gname in groups:
    s85 = pd.to_numeric(df[wcols[0]], errors='coerce'); s96 = pd.to_numeric(df[wcols[2]], errors='coerce')
    m85 = s85[df[cohort] == groups[gname]].median(); m96 = s96[df[cohort] == groups[gname]].median()
    print(f'  {gname:<34}: {m85:>9,.0f} -> {m96:>9,.0f}  = {m96/m85:5.2f}x')

# ---- 2) SENSITIVITY: balanced all-3-years panel ----
print()
print('=' * 78)
print('SENSITIVITY: balanced panel (respondents with all 3 wealth years non-missing), medians nominal $')
print('=' * 78)
keep = df[wcols].notna().all(axis=1)
d_all = df[keep]
print(f'balanced-panel n = {len(d_all)}')
for y, col in zip(years, wcols):
    s = pd.to_numeric(d_all[col], errors='coerce')
    for gname in groups:
        sub = s[d_all[cohort] == groups[gname]]
        print(f'  {y}: {gname:<34} n={int(sub.notna().sum()):5d} med={sub.median():>11,.0f}')
print()
w85 = pd.to_numeric(d_all[wcols[0]], errors='coerce'); w96 = pd.to_numeric(d_all[wcols[2]], errors='coerce')
for gname in groups:
    m85 = w85[d_all[cohort] == groups[gname]].median(); m96 = w96[d_all[cohort] == groups[gname]].median()
    print(f'  balanced-panel growth {gname:<30}: {m85:>10,.0f} -> {m96:>10,.0f} = {m96/m85:5.2f}x')

# ---- 3) CPI-deflated to constant 1996 dollars (interpretive aid) ----
cpi = {1985: 107.6, 1990: 130.7, 1996: 156.9}   # BLS CPI-U annual averages
print()
print('=' * 78)
print('INTERPRETIVE AID: medians deflated to constant 1996 dollars (BLS CPI-U annual avg)')
print('=' * 78)
for y, col in zip(years, wcols):
    s = pd.to_numeric(df[col], errors='coerce')
    d = 156.9 / cpi[y]
    line = f'  {y}:'
    for gname in groups:
        m = s[df[cohort] == groups[gname]].median()
        line += f'   {group_short[gname]}={m*d:>11,.0f}'
    print(line)

# ---- 4) quick check of zeros in primary table (already included at face value) ----
print()
print('=' * 78)
print('Face-value inclusion note: negatives+zeros included in all medians above (no exclusion, no imputation).')
print('=' * 78)
