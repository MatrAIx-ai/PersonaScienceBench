"""NLS-SES: identify which variable's effect on BA degree completion collapses
(quoted 0.3636 -> -0.2293, becoming insignificant) when race AND academic
characteristics are added.  OLS (linear-probability) primary; probit/logit robustness.
"""
import pandas as pd, numpy as np, warnings, itertools, json
import statsmodels.api as sm
from scipy import stats
warnings.filterwarnings("ignore")

df = pd.read_csv("data/nls_ses_processed.csv")
df["BA"] = df["BA DEGREE COMPLETED"].astype(int)
df["Male"]   = (df["SAMPLE_SEX"]   == "Male").astype(int)
df["Black"]  = (df["SAMPLE_RACE"]  == "Black").astype(int)
df["Hispanic"]=(df["SAMPLE_RACE"]  == "Hispanic").astype(int)
df["Famsize"]= df["FAMILY SIZE OF SAMPLE"]
df["Ability"]= df["ABILITY: COMPOSITE OF ASVAB SCORE"]
df["Pctile"] = df["PERCENTILE IN CLASS"]
df["SES"]    = df["SES"]

# z-scored versions (for standardized specs)
for c in ["SES","Famsize","Ability","Pctile"]:
    df[c+"_z"] = (df[c]-df[c].mean())/df[c].std()
df["BA_z"] = (df["BA"]-df["BA"].mean())/df["BA"].std()

n = len(df)
print(f"N={n}  BA completions={df['BA'].sum()} ({df['BA'].mean()*100:.2f}%)  missing={df.isna().sum().sum()}")
print("Race:", df["SAMPLE_RACE"].value_counts().to_dict())
print("Sex :", df["SAMPLE_SEX"].value_counts().to_dict())

F = {
 "OLS":   lambda X,y: sm.OLS(y, X).fit(cov_type="HC3"),
 "Logit": lambda X,y: sm.Logit(y, X).fit(disp=0),
 "Probit":lambda X,y: sm.Probit(y, X).fit(disp=0),
}
LABEL = {
 "OLS":"Linear-probability (OLS, robust HC3 se)",
 "Logit":"Logistic regression",
 "Probit":"Probit",
}

# ---------------- 1) BLOCK REGRESSION TABLE (all 3 families x 4 blocks) ----------------
race=["Black","Hispanic"]; acad=["Ability","Pctile"]; social=["SES","Famsize","Male"]
blocks = {
 "M1 baseline (social only)": social,
 "M2 + race":                 social+race,
 "M3 + academic chars":       social+acad,
 "M4 + race + academic":      social+race+acad,
}
order=["SES","Famsize","Male","Black","Hispanic","Ability","Pctile"]
def fmt(x): return f"{x:+.4f}"
rows={}
print("\n" + "="*100)
print("BLOCK-REGression TABLE  (coefficient (p-value)); SES row is the candidate")
for fam_k,fam_f in F.items():
    print("\n---", LABEL[fam_k], "---")
    hdr = "var      " + "".join(f"{b[:len(b)]:>30s}" for b in blocks)
    print("var".ljust(9) + "".join(b[:30].rjust(30) for b in blocks))
    for v in order:
        line = v.ljust(9)
        for bn, cols in blocks.items():
            X = sm.add_constant(df[cols])
            m = fam_f(X, df["BA"])
            if v in cols:
                line += f"{float(m.params[v]):+.4f} ({float(m.pvalues[v]):.3f})".rjust(30)
            else:
                line += "(not in model)".rjust(30)
        print(line)
    # attenuation of SES across blocks
    for bn, cols in blocks.items():
        X = sm.add_constant(df[cols]); m=fam_f(X, df["BA"])
        rows[(fam_k,bn)] = (float(m.params["SES"]), float(m.pvalues["SES"]), float(m.tvalues["SES"]))
    base_ses = rows[(fam_k,"M1 baseline (social only)")][0]
    full_ses = rows[(fam_k,"M4 + race + academic")][0]
    atten = (full_ses-base_ses)/abs(base_ses)*100
    print(f"  => SES M1->M4 attenuation: {atten:+.1f}%  (sign flip: {np.sign(base_ses)!=np.sign(full_ses)})")

# ---------------- 2) ROBUSTNESS SWEEPS: try to recover BOTH 0.3636 and -0.2293 ----------
print("\n" + "="*100)
print("ROBUSTNESS SWEEPS - search space for the quoted (0.3636, -0.2293) pair on SES")

target = (0.3636, -0.2293)
def dist2(cb, cf): return (cb-0.3636)**2 + (cf+0.2293)**2

results=[]
# baseline variants: SES-only vs +Famsize vs +Male vs +Famsize+Male
base_variants = {
  "SES-only":        ["SES"],
  "SES+Famsize":     ["SES","Famsize"],
  "SES+Male":        ["SES","Male"],
  "SES+Famsize+Male":["SES","Famsize","Male"],
}
acad_variants = {
  "raw both":   ["Ability","Pctile"],
  "z both":     ["Ability_z","Pctile_z"],
  "raw ability only": ["Ability"],
  "raw pctile  only": ["Pctile"],
  "z ability only":   ["Ability_z"],
  "z pctile  only":   ["Pctile_z"],
}
race_variants = {"two dummies": ["Black","Hispanic"]}

best=[]
for fam_k,fam_f in F.items():
    for bname,bcols in base_variants.items():
        for rname,rcols in race_variants.items():
            for aname,acols in acad_variants.items():
                full_cols = bcols + rcols + acols
                for spec_k, (use_z_dep) in [("raw",False),("beta_std",True)]:
                    d = df
                    dep = "BA"
                    if spec_k=="beta_std":
                        # both predictors and outcome z-scored (beta weights), OLS only -> skip for logit/probit
                        pass
                    try:
                        Xb = sm.add_constant(df[bcols])
                        Xf = sm.add_constant(df[full_cols])
                        mb = fam_f(Xb, df["BA"]); mf = fam_f(Xf, df["BA"])
                        cb, cf = float(mb.params["SES"]), float(mf.params["SES"])
                        d2 = dist2(cb,cf)
                        best.append((d2, fam_k, bname, aname, cb, cf,
                                     float(mb.pvalues["SES"]), float(mf.pvalues["SES"])))
                    except Exception:
                        pass

# beta (standardized) sweep: OLS with z-scored outcome & predictors
for bname,bcols in base_variants.items():
    bz = [c+"_z" for c in bcols]
    for aname,acols in acad_variants.items():
        az = [c if c.endswith("_z") else c+"_z" for c in acols]
        full_z = bz + ["Black","Hispanic"] + az
        try:
            Xb = sm.add_constant(df[bz]); Xf = sm.add_constant(df[full_z])
            mb = sm.OLS(df["BA_z"], Xb).fit(); mf = sm.OLS(df["BA_z"], Xf).fit()
            cb, cf = float(mb.params["SES_z"]), float(mf.params["SES_z"])
            d2 = dist2(cb,cf)
            best.append((d2, "OLS-beta(std x & y)", bname, aname, cb, cf,
                         float(mb.pvalues["SES_z"]), float(mf.pvalues["SES_z"])))
        except Exception:
            pass

best.sort(key=lambda x:x[0])
print("\nTOP 12 closest SES specifications to quoted (0.3636, -0.2293):")
for d2,fk,bn,an,cb,cf,pb,pf in best[:12]:
    print(f"  d2={d2:.6f} | {fk:22s} | base={bn:18s} | acad={an:16s} | SES {cb:+.4f}(p={pb:.3f}) -> {cf:+.4f}(p={pf:.3f})")

# closest overall + best attempt per family where full (cf) is most negative
print("\nClosest pair overall:", best[0] if best else None)

# ---------------- 3) QUANTITATIVE STORY FOR SES (main evidence) -------------------------
print("\n" + "="*100)
print("SES QUANTITATIVE STORY  (base = BA ~ SES+Famsize+Male; full = +Black+Hispanic+Ability+Pctile)")
for fam_k in ["OLS","Logit","Probit"]:
    cb,pb,_ = rows[(fam_k,"M1 baseline (social only)")]
    cf,pf,_ = rows[(fam_k,"M4 + race + academic")]
    atten = (cf-cb)/abs(cb)*100
    sig = "significant" if pf<0.05 else ("marginally sig (p<.10)" if pf<0.10 else "INSIGNIFICANT")
    print(f"  {fam_k:6s}: SES {cb:+.4f} (p={pb:.3f})  ->  {cf:+.4f} (p={pf:.3f})  | attenuation {atten:+.0f}% | full effect {sig} @alpha=.05")

# bivariate SES-only baseline for reference across families (raw + beta)
print("\nBivariate (SES-only) baseline -> full(+race+acad):")
for fam_k,fam_f in F.items():
    Xb=sm.add_constant(df[["SES"]]); Xf=sm.add_constant(df[["SES"]+race+acad])
    mb=fam_f(Xb,df["BA"]); mf=fam_f(Xf,df["BA"])
    print(f"  {fam_k:6s}: {float(mb.params['SES']):+.4f}(p={float(mb.pvalues['SES']):.3f}) -> {float(mf.params['SES']):+.4f}(p={float(mf.pvalues['SES']):.3f})")
Xb=sm.add_constant(df[["SES_z"]]); Xf=sm.add_constant(df[["SES_z","Black","Hispanic","Ability_z","Pctile_z"]])
mb=sm.OLS(df["BA_z"],Xb).fit(); mf=sm.OLS(df["BA_z"],Xf).fit()
print(f"  OLS-beta: {float(mb.params['SES_z']):+.4f}(p={float(mb.pvalues['SES_z']):.3f}) -> {float(mf.params['SES_z']):+.4f}(p={float(mf.pvalues['SES_z']):.3f})")

# correlation evidence for mediation
print("\nCorrelations with SES:", {c: round(float(np.corrcoef(df["SES"],df[c])[0,1]),3) for c in ["Ability","Pctile"]})
print("BA rate by SES tercile:", df.groupby(pd.qcut(df["SES"],3,labels=["low","mid","high"]),observed=True)["BA"].mean().round(4).to_dict())
