"""
DiscoveryBench full_workflow — nls_ses
Question: The effect of which variable on BA degree completion decreases from
~0.5024 to ~0.0923 (becoming insignificant) when both SES and academic
characteristics are included in analysis?

Approach (agreed):
  - For each candidate X in {SES, ABILITY, PERCENTILE, FAMILY SIZE}, compare
      M1  : BA ~ X
      M2a : BA ~ X + SES + PERCENTILE
      M2b : BA ~ X + SES + PERCENTILE + ABILITY
      M2c : BA ~ X + SES + PERCENTILE + ABILITY + FAMILY_SIZE + RACE + SEX
    in raw (log-odds) and standardized (z) scales.
  - Identification criterion: relative drop >= ~80% AND transition
    significant -> insignificant (p<0.05) when SES + academic characteristics
    are added. Robustness: LPM and probit.
"""
import numpy as np
import pandas as pd
import statsmodels.api as sm
import warnings
warnings.filterwarnings('ignore')

RNG = 42
df = pd.read_csv('data/nls_ses_processed.csv')
df['BA'] = df['BA DEGREE COMPLETED'].astype(int)
df['ABILITY'] = df['ABILITY: COMPOSITE OF ASVAB SCORE']
df['PERCENTILE'] = df['PERCENTILE IN CLASS']
df['FAMSIZE'] = df['FAMILY SIZE OF SAMPLE']
df['FEMALE'] = (df['SAMPLE_SEX'] == 'Female').astype(int)
df['BLACK'] = (df['SAMPLE_RACE'] == 'Black').astype(int)
df['HISPANIC'] = (df['SAMPLE_RACE'] == 'Hispanic').astype(int)

CANDIDATES = ['SES', 'ABILITY', 'PERCENTILE', 'FAMSIZE']
CONT = ['SES', 'ABILITY', 'PERCENTILE']
DEMO = ['FEMALE', 'BLACK', 'HISPANIC']


def zseries(x):
    return (x - x.mean()) / x.std()


raw = df.copy()
std = df.copy()
for c in ['SES', 'ABILITY', 'PERCENTILE', 'FAMSIZE']:
    std[c] = zseries(df[c])

# control sets (per candidate) for the coefficient of interest X
def ctrl_sets(X):
    base_acad = [c for c in ['SES', 'PERCENTILE'] if c != X]
    full_acad = [c for c in CONT if c != X]
    full = full_acad + [c for c in ['FAMSIZE'] + DEMO if c != X]
    return {
        'M1 (univariate)': [X],
        'M2a (X + SES + PERCENTILE)': [X] + base_acad,
        'M2b (+ ABILITY too)': [X] + full_acad,
        'M2c (full + demog)': [X] + full,
    }


def run_models(data, family):
    rows = []
    for X in CANDIDATES:
        for mname, cols in ctrl_sets(X).items():
            y = data['BA']
            Xm = sm.add_constant(data[cols].astype(float))
            if family == 'logit':
                r = sm.Logit(y, Xm).fit(disp=0)
            elif family == 'lpm':
                r = sm.OLS(y, Xm).fit()
            elif family == 'probit':
                r = sm.Probit(y, Xm).fit(disp=0)
            coef = r.params[X]
            se = r.bse[X]
            p = r.pvalues[X]
            rows.append({
                'candidate': X, 'model': mname, 'n_pred': len(cols),
                'coef': coef, 'se': se, 'p': p,
                'sig': p < 0.05, 'n': int(r.nobs),
            })
    return pd.DataFrame(rows)


def summarize(res, scale_name):
    out = []
    for X in CANDIDATES:
        sub = res[res['candidate'] == X].copy()
        m1 = sub.iloc[0]
        for _, m in sub.iterrows():
            if m['model'] == 'M1 (univariate)':
                continue
            abs_chg = m['coef'] - m1['coef']
            rel_chg = abs_chg / abs(m1['coef']) if m1['coef'] != 0 else np.nan
            out.append({
                'candidate': X,
                'model': m['model'],
                'coef_M1': m1['coef'], 'p_M1': m1['p'],
                'coef': m['coef'], 'se': m['se'], 'p': m['p'],
                'sig_M1': m1['sig'], 'sig': m['sig'],
                'abs_chg': abs_chg, 'rel_chg': rel_chg,
                'lost_significance': m1['sig'] and (not m['sig']),
            })
    return pd.DataFrame(out)


print('=' * 90)
print('RAW-scale LOGIT coefficients (log-odds) for each candidate')
print('=' * 90)
res_raw = run_models(raw, 'logit')
sum_raw = summarize(res_raw, 'raw')
pd.set_option('display.width', 250)
print(sum_raw.to_string(index=False, float_format=lambda v: f'{v:.4f}'))

print()
print('=' * 90)
print('Z-standardized LOGIT coefficients (log-odds per 1 SD)')
print('=' * 90)
res_z = run_models(std, 'logit')
sum_z = summarize(res_z, 'z')
print(sum_z.to_string(index=False, float_format=lambda v: f'{v:.4f}'))

print()
print('IDENTIFICATION (logit, raw scale): candidates losing significance')
hit = sum_raw[sum_raw['lost_significance']].copy()
print(hit.to_string(index=False, float_format=lambda v: f'{v:.4f}'))

print()
print('Relative drop of the candidate coefficient across models:')
for X in CANDIDATES:
    sub = sum_raw[sum_raw['candidate'] == X]
    drops = sub[['model', 'rel_chg']].copy()
    print(X, drops.to_dict('records'))

# Robustness: LPM and probit
print()
print('=' * 90)
print("ROBUSTNESS — LPM and PROBIT (raw scale), 'lost_significance' flag")
print('=' * 90)
for fam in ['lpm', 'probit']:
    r = run_models(raw, fam)
    s = summarize(r, fam)
    h = s[s['lost_significance'] & (s['rel_chg'] <= -0.5)][['candidate', 'model', 'coef_M1', 'p_M1', 'coef', 'p', 'rel_chg']]
    print(f'-- {fam.upper()} candidates losing significance:')
    print(h.to_string(index=False, float_format=lambda v: f'{v:.4f}'))

# Final headline numbers
print()
print('=' * 90)
print('HEADLINE: SES effect on BA completion')
print('=' * 90)
for fam in ['logit', 'lpm', 'probit']:
    m1 = sm.Logit if fam == 'logit' else (sm.OLS if fam == 'lpm' else sm.Probit)
    r1 = m1(raw['BA'], sm.add_constant(raw[['SES']])).fit(disp=0)
    r2 = m1(raw['BA'], sm.add_constant(raw[['SES', 'PERCENTILE']])).fit(disp=0)
    print(f'{fam:6s}: SES {r1.params["SES"]:.4f}(p={r1.pvalues["SES"]:.2e}) -> '
          f'{r2.params["SES"]:.4f}(p={r2.pvalues["SES"]:.2e})  [relative drop '
          f'{100*(1-r2.params["SES"]/r1.params["SES"]):.1f}%]')

# Save artifacts
sum_raw.to_csv('analysis/table_logit_raw.csv', index=False)
sum_z.to_csv('analysis/table_logit_z.csv', index=False)
print()
print('Saved: analysis/table_logit_raw.csv, analysis/table_logit_z.csv')
