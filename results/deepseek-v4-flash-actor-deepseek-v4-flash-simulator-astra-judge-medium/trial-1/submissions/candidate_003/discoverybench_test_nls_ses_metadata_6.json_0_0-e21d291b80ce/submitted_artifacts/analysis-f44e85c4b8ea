#!/usr/bin/env python3
"""
NLS SES: At what SES levels is the advantage in completion rates for
Black students more pronounced?  (DiscoveryBench / full-workflow)
Approved analysis: pooled-quartile strata tables (pp gaps + Wald CIs),
tertile & fixed-threshold sensitivity, univariable logistic with
SES x race interaction (primary), continuous-SES predicted Black-White
gap curve with delta-method CI (headline figure), covariate-adjusted
robustness pass.  Outputs -> ./outputs/
"""
import os, json
import numpy as np
import pandas as pd
import statsmodels.api as sm

os.makedirs("outputs", exist_ok=True)
df = pd.read_csv("data/nls_ses_processed.csv").drop(columns=["Unnamed: 0"])
df["BA"] = df["BA DEGREE COMPLETED"].astype(int)
df["BLACK"] = (df["SAMPLE_RACE"] == "Black").astype(int)
df["HISP"] = (df["SAMPLE_RACE"] == "Hispanic").astype(int)
df["SEX_MALE"] = (df["SAMPLE_SEX"] == "Male").astype(int)

def prop_diff_ci(r1, n1, r2, n2, z=1.96):
    p1, p2 = r1 / n1, r2 / n2
    se = np.sqrt(p1 * (1 - p1) / n1 + p2 * (1 - p2) / n2)
    d = p1 - p2
    return d, d - z * se, d + z * se, se

# ---------------- 1. pooled-quartile strata ----------------
df["Q"] = pd.qcut(df["SES"], 4, labels=["Q1", "Q2", "Q3", "Q4"])
rate = df.pivot_table(index="Q", columns="SAMPLE_RACE", values="BA", aggfunc="mean")
cnt = df.pivot_table(index="Q", columns="SAMPLE_RACE", values="BA", aggfunc="count")
sume = df.pivot_table(index="Q", columns="SAMPLE_RACE", values="BA", aggfunc="sum")
others = df[df.SAMPLE_RACE != "Black"].groupby("Q", observed=True)["BA"].agg(["sum", "count"])\
    .rename(columns={"sum": "OTH_BA", "count": "OTH_N"})
b = df[df.SAMPLE_RACE == "Black"].groupby("Q", observed=True)["BA"].agg(["sum", "count"])\
    .rename(columns={"sum": "BLK_BA", "count": "BLK_N"})
rows = []
for q in ["Q1", "Q2", "Q3", "Q4"]:
    d_w, lo_w, hi_w, _ = prop_diff_ci(sume.loc[q, "Black"], cnt.loc[q, "Black"],
                                     sume.loc[q, "White"], cnt.loc[q, "White"])
    d_o, lo_o, hi_o, _ = prop_diff_ci(b.loc[q, "BLK_BA"], b.loc[q, "BLK_N"],
                                      others.loc[q, "OTH_BA"], others.loc[q, "OTH_N"])
    rows.append({"stratum": q,
                 "SES_range": f"{df.loc[df.Q==q,'SES'].min():.2f}..{df.loc[df.Q==q,'SES'].max():.2f}",
                 "N": int(cnt.loc[q].sum()),
                 "Black_rate": rate.loc[q, "Black"], "White_rate": rate.loc[q, "White"],
                 "Hisp_rate": rate.loc[q, "Hispanic"],
                 "Others_rate": others.loc[q, "OTH_BA"] / others.loc[q, "OTH_N"],
                 "Black_n": int(cnt.loc[q, "Black"]), "Black_BA": int(sume.loc[q, "Black"]),
                 "White_n": int(cnt.loc[q, "White"]), "White_BA": int(sume.loc[q, "White"]),
                 "Others_n": int(others.loc[q, "OTH_N"]), "Others_BA": int(others.loc[q, "OTH_BA"]),
                 "Black_minus_White_pp": d_w * 100, "BW_lo_pp": lo_w * 100, "BW_hi_pp": hi_w * 100,
                 "Black_minus_Others_pp": d_o * 100, "BO_lo_pp": lo_o * 100, "BO_hi_pp": hi_o * 100})
qtab = pd.DataFrame(rows)
qtab.round(4).to_csv("outputs/quartile_strata.csv", index=False)
print("### POOLED-QUARTILE STRATA ###")
print(qtab.round(4).to_string(index=False)); print()

# ---------------- sensitivity: tertiles ----------------
df["T"] = pd.qcut(df["SES"], 3, labels=["T1", "T2", "T3"])
rate_t = df.pivot_table(index="T", columns="SAMPLE_RACE", values="BA", aggfunc="mean")
cnt_t = df.pivot_table(index="T", columns="SAMPLE_RACE", values="BA", aggfunc="count")
sume_t = df.pivot_table(index="T", columns="SAMPLE_RACE", values="BA", aggfunc="sum")
others_t = df[df.SAMPLE_RACE != "Black"].groupby("T", observed=True)["BA"].agg(["sum", "count"])\
    .rename(columns={"sum": "OTH_BA", "count": "OTH_N"})
b_t = df[df.SAMPLE_RACE == "Black"].groupby("T", observed=True)["BA"].agg(["sum", "count"])\
    .rename(columns={"sum": "BLK_BA", "count": "BLK_N"})
trows = []
for t in ["T1", "T2", "T3"]:
    d_w, lo_w, hi_w, _ = prop_diff_ci(sume_t.loc[t, "Black"], cnt_t.loc[t, "Black"],
                                      sume_t.loc[t, "White"], cnt_t.loc[t, "White"])
    trows.append({"stratum": t, "Black_rate": rate_t.loc[t, "Black"], "White_rate": rate_t.loc[t, "White"],
                  "Black_minus_White_pp": d_w * 100, "BW_lo_pp": lo_w * 100, "BW_hi_pp": hi_w * 100,
                  "Black_n": int(cnt_t.loc[t, "Black"]), "Black_BA": int(sume_t.loc[t, "Black"])})
ttab = pd.DataFrame(trows)
ttab.round(4).to_csv("outputs/tertile_strata.csv", index=False)
print("### TERTILE STRATA ###")
print(ttab.round(4).to_string(index=False)); print()

# ---------------- sensitivity: fixed reference thresholds ----------------
def band(s):
    if s < -0.5: return "Low (<-0.5)"
    if s <= 0.5: return "Mid (-0.5..0.5)"
    return "High (>0.5)"
df["BAND"] = df["SES"].apply(band)
rate_b = df.pivot_table(index="BAND", columns="SAMPLE_RACE", values="BA", aggfunc="mean")
cnt_b = df.pivot_table(index="BAND", columns="SAMPLE_RACE", values="BA", aggfunc="count")
sume_b = df.pivot_table(index="BAND", columns="SAMPLE_RACE", values="BA", aggfunc="sum")
others_b = df[df.SAMPLE_RACE != "Black"].groupby("BAND", observed=True)["BA"].agg(["sum", "count"])\
    .rename(columns={"sum": "OTH_BA", "count": "OTH_N"})
b_b = df[df.SAMPLE_RACE == "Black"].groupby("BAND", observed=True)["BA"].agg(["sum", "count"])\
    .rename(columns={"sum": "BLK_BA", "count": "BLK_N"})
brows = []
for bd in ["Low (<-0.5)", "Mid (-0.5..0.5)", "High (>0.5)"]:
    d_w, lo_w, hi_w, _ = prop_diff_ci(sume_b.loc[bd, "Black"], cnt_b.loc[bd, "Black"],
                                      sume_b.loc[bd, "White"], cnt_b.loc[bd, "White"])
    brows.append({"band": bd,
                  "Black_rate": rate_b.loc[bd, "Black"], "White_rate": rate_b.loc[bd, "White"],
                  "Hisp_rate": rate_b.loc[bd, "Hispanic"],
                  "Others_rate": others_b.loc[bd, "OTH_BA"] / others_b.loc[bd, "OTH_N"],
                  "Black_minus_White_pp": d_w * 100, "BW_lo_pp": lo_w * 100, "BW_hi_pp": hi_w * 100,
                  "Black_n": int(cnt_b.loc[bd, "Black"]), "Black_BA": int(sume_b.loc[bd, "Black"])})
btab = pd.DataFrame(brows)
btab.round(4).to_csv("outputs/fixed_threshold_strata.csv", index=False)
print("### FIXED REFERENCE THRESHOLDS (low<-.5 / mid / high>+.5) ###")
print(btab.round(4).to_string(index=False)); print()

# ---------------- 2. logistic: univariable primary ----------------
X = pd.DataFrame({"const": 1.0, "SES": df["SES"], "BLACK": df["BLACK"], "HISP": df["HISP"],
                  "BLACKxSES": df["BLACK"] * df["SES"], "HISPxSES": df["HISP"] * df["SES"]})
m = sm.Logit(df["BA"], X).fit(disp=0)
print("### LOGISTIC (univariable): BA ~ SES + race + SES x race ###")
print(pd.DataFrame({"coef": m.params, "se": m.bse, "p": m.pvalues,
                    "ci_lo": m.conf_int()[0], "ci_hi": m.conf_int()[1]}).round(4).to_string())
print("Log-lik:", round(m.llf, 2), "Pseudo-R2:", round(m.prsquared, 4)); print()

# ---------------- 3. headline: predicted Black-White pp gap curve ----------------
cov = m.cov_params().values; beta = m.params.values
order = list(X.columns)
i_ses = order.index("SES"); i_black = order.index("BLACK")
i_bxs = order.index("BLACKxSES"); i_c = order.index("const")
def sig(x): return 1 / (1 + np.exp(-x))

grid = np.arange(-2.45, 2.75, 0.05)
recs = []
for s in grid:
    lw = beta[i_c] + beta[i_ses] * s
    lb = beta[i_c] + beta[i_ses] * s + beta[i_black] + beta[i_bxs] * s
    pw, pb = sig(lw), sig(lb)
    gap = pb - pw
    g = np.zeros(len(order))
    g[i_c] = pb * (1 - pb) - pw * (1 - pw)
    g[i_ses] = s * (pb * (1 - pb) - pw * (1 - pw))
    g[i_black] = pb * (1 - pb)
    g[i_bxs] = s * pb * (1 - pb)
    se = float(np.sqrt(g @ cov @ g))
    recs.append({"SES": round(s, 3), "P_White": pw, "P_Black": pb,
                 "Gap_Black_minus_White_pp": gap * 100,
                 "Gap_lo_pp": (gap - 1.96 * se) * 100,
                 "Gap_hi_pp": (gap + 1.96 * se) * 100,
                 "gap_se_pp": se * 100})
gapdf = pd.DataFrame(recs)
gapdf.to_csv("outputs/predicted_gap_curve.csv", index=False)

sign = np.sign(gapdf["Gap_Black_minus_White_pp"].values)
cross_idx = np.where(np.diff(sign) != 0)[0]
crossover = []
for ix in cross_idx:
    s0, s1 = grid[ix], grid[ix + 1]
    g0, g1 = gapdf.loc[ix, "Gap_Black_minus_White_pp"], gapdf.loc[ix + 1, "Gap_Black_minus_White_pp"]
    crossover.append(round(float(s0 - g0 * (s1 - s0) / (g1 - g0)), 2))
pos_sig = gapdf[gapdf.Gap_lo_pp > 0]
neg_sig = gapdf[gapdf.Gap_hi_pp < 0]
print("### HEADLINE: predicted Black - White pp gap vs continuous SES ###")
print(gapdf[["SES", "P_White", "P_Black", "Gap_Black_minus_White_pp", "Gap_lo_pp", "Gap_hi_pp"]].round(3).to_string(index=False))
print()
print("Crossover SES (predicted Black = White):", crossover)
print("SES range with CI strictly above 0 (Black sig > White):",
      (pos_sig.SES.min(), pos_sig.SES.max()) if len(pos_sig) else "none")
print("SES range with CI strictly below 0 (Black sig < White):",
      (neg_sig.SES.min(), neg_sig.SES.max()) if len(neg_sig) else "none")
print()

# ---------------- SVG figure (headline) ----------------
def svg_plot(gapdf, path):
    W, H, pad_l, pad_r, pad_t, pad_b = 800, 480, 70, 20, 30, 45
    xmin, xmax = gapdf.SES.min(), gapdf.SES.max()
    ymin, ymax = -4.0, 2.5
    def X(s): return pad_l + (s - xmin) / (xmax - xmin) * (W - pad_l - pad_r)
    def Y(y): return pad_t + (ymax - y) / (ymax - ymin) * (H - pad_t - pad_b)
    el = []
    el.append(f'<line x1="{X(xmin)}" y1="{Y(0)}" x2="{X(xmax)}" y2="{Y(0)}" stroke="#888" stroke-width="1"/>')
    poly_hi = " ".join(f"{X(s):.1f},{Y(h):.1f}" for s, h in zip(gapdf.SES, gapdf.Gap_hi_pp))
    poly_lo = " ".join(f"{X(s):.1f},{Y(l):.1f}" for s, l in zip(gapdf.SES[::-1], gapdf.Gap_lo_pp[::-1]))
    el.append(f'<polygon points="{poly_hi} {poly_lo}" fill="#aec6e8" opacity="0.55"/>')
    pts = " ".join(f"{X(s):.1f},{Y(g):.1f}" for s, g in zip(gapdf.SES, gapdf.Gap_Black_minus_White_pp))
    el.append(f'<polyline points="{pts}" fill="none" stroke="#1f4e9c" stroke-width="2.5"/>')
    el.append(f'<text x="{X(xmin)+6}" y="{Y(0)-5}" font-size="11" fill="#666">0 (parity)</text>')
    for qv, lab in [(-0.478, "Q1|Q2"), (-0.080, "Q2|Q3"), (0.413, "Q3|Q4")]:
        el.append(f'<line x1="{X(qv)}" y1="{pad_t}" x2="{X(qv)}" y2="{H-pad_b}" stroke="#ccc" stroke-dasharray="3,3"/>')
        el.append(f'<text x="{X(qv)+3}" y="{pad_t+12}" font-size="9" fill="#999">{lab}</text>')
    for sc in crossover:
        el.append(f'<circle cx="{X(sc)}" cy="{Y(0)}" r="4" fill="#c22" stroke="white"/>')
        el.append(f'<text x="{min(X(sc)+6, W-160)}" y="{Y(0)-8}" font-size="10" fill="#c22">crossover SES ~ {sc}</text>')
    for tv in range(-2, 3):
        el.append(f'<line x1="{X(tv)}" y1="{H-pad_b}" x2="{X(tv)}" y2="{H-pad_b+5}" stroke="#333"/>')
        el.append(f'<text x="{X(tv)-8}" y="{H-pad_b+18}" font-size="10" fill="#333">{tv}</text>')
    for tv in range(-4, 3):
        el.append(f'<line x1="{pad_l-5}" y1="{Y(tv)}" x2="{pad_l}" y2="{Y(tv)}" stroke="#333"/>')
        el.append(f'<text x="{pad_l-40}" y="{Y(tv)+4}" font-size="10" fill="#333">{tv}%</text>')
    svg = (f'<svg xmlns="http://www.w3.org/2000/svg" width="{W}" height="{H}" viewBox="0 0 {W} {H}">'
           f'<rect width="{W}" height="{H}" fill="white"/>{"".join(el)}'
           f'<text x="{pad_l+10}" y="{pad_t-8}" font-size="13" font-weight="bold" fill="#222">'
           f'Predicted Black minus White BA-completion rate by SES (logistic with BLACK x SES interaction)</text>'
           f'<text x="{pad_l+10}" y="{pad_t+8}" font-size="11" fill="#444">'
           f'Shaded = 95% delta-method CI; dashed = pooled-sample quartile boundaries; SES = externally-normed z-composite.</text></svg>')
    with open(path, "w") as f:
        f.write(svg)

svg_plot(gapdf, "outputs/predicted_gap_curve.svg")
print("SVG figure written to outputs/predicted_gap_curve.svg"); print()

# ---------------- 4. robustness: adjusted logistic ----------------
av = df["ABILITY: COMPOSITE OF ASVAB SCORE"]; pc = df["PERCENTILE IN CLASS"]
Xa = pd.DataFrame({"const": 1.0, "SES": df["SES"], "BLACK": df["BLACK"], "HISP": df["HISP"],
                   "BLACKxSES": df["BLACK"] * df["SES"], "HISPxSES": df["HISP"] * df["SES"],
                   "SEX_MALE": df["SEX_MALE"],
                   "ASVAB_z": (av - av.mean()) / av.std(),
                   "PCTILE_z": (pc - pc.mean()) / pc.std()})
ma = sm.Logit(df["BA"], Xa).fit(disp=0)
print("### ROBUSTNESS LOGISTIC (adjusted: + sex, ASVAB z, percentile z) ###")
print(pd.DataFrame({"coef": ma.params, "se": ma.bse, "p": ma.pvalues,
                    "ci_lo": ma.conf_int()[0], "ci_hi": ma.conf_int()[1]}).round(4).to_string())
print("Log-lik:", round(ma.llf, 2), "Pseudo-R2:", round(ma.prsquared, 4))
cov_a = ma.cov_params().values; beta_a = ma.params.values; order_a = list(Xa.columns)
i_c = order_a.index("const"); i_ses = order_a.index("SES")
i_black = order_a.index("BLACK"); i_bxs = order_a.index("BLACKxSES")
grid_a = np.arange(-2.45, 2.75, 0.05)
gap_a = []
for s in grid_a:
    lw = beta_a[i_c] + beta_a[i_ses] * s
    lb = beta_a[i_c] + beta_a[i_ses] * s + beta_a[i_black] + beta_a[i_bxs] * s
    pw, pb = sig(lw), sig(lb)
    gap_a.append(pb - pw)
gdf_a = pd.DataFrame({"SES": grid_a, "Gap_pp": np.array(gap_a) * 100})
sign_a = np.sign(gdf_a.Gap_pp.values); cross_a = np.where(np.diff(sign_a) != 0)[0]
cross_adj = []
for ix in cross_a:
    s0, s1 = grid_a[ix], grid_a[ix + 1]; g0, g1 = gdf_a.loc[ix, "Gap_pp"], gdf_a.loc[ix + 1, "Gap_pp"]
    cross_adj.append(round(float(s0 - g0 * (s1 - s0) / (g1 - g0)), 2))
print("Adjusted-model crossover SES (Black=White):", cross_adj)
gdf_a.to_csv("outputs/predicted_gap_curve_adjusted.csv", index=False)
print("Adjusted gap curve saved.")

# ---------------- summary json ----------------
summary = {
    "n": int(len(df)),
    "overall_ba_rate": float(df["BA"].mean()),
    "ba_by_race": df.groupby("SAMPLE_RACE")["BA"].mean().round(4).to_dict(),
    "ses_stats": {"mean": float(df["SES"].mean()), "sd": float(df["SES"].std()),
                  "min": float(df["SES"].min()), "max": float(df["SES"].max()),
                  "q25": float(df["SES"].quantile(.25)), "q50": float(df["SES"].quantile(.5)),
                  "q75": float(df["SES"].quantile(.75))},
    "univariable_logit": {k: {"coef": round(float(m.params[k]), 3),
                              "p": round(float(m.pvalues[k]), 4)} for k in order},
    "adjusted_logit_BLACKxSES": {"coef": round(float(ma.params["BLACKxSES"]), 3),
                                  "p": round(float(ma.pvalues["BLACKxSES"]), 4),
                                  "crossover_SES": cross_adj},
    "crossover_SES_univariable": [round(float(c), 2) for c in crossover],
    "quartile_strata": rows,
}
with open("outputs/summary.json", "w") as f:
    json.dump(summary, f, indent=2, default=str)
print("\nWrote outputs/summary.json")
