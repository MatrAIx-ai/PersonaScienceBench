import pandas as pd, numpy as np
from statsmodels.formula.api import logit, probit, ols
import statsmodels.api as sm
from scipy.stats import norm as _norm

df = pd.read_csv('data/nls_ses_processed.csv')
df['BA'] = df['BA DEGREE COMPLETED'].astype(int)
T = -0.9568
target_abs = abs(T)
def distance(v): return abs(abs(v)-target_abs)

print("="*70)
print("FINAL ANALYSIS — factor of BA degree completion vs race")
print("="*70)
print("\n[1] Race composition & BA completion rates")
print(df.groupby('SAMPLE_RACE')['BA'].agg(['count','sum','mean']).round(4).to_string())
print("Overall BA completion rate:", round(df['BA'].mean(),5))

def logodds(p): return np.log(p/(1-p))
def cloglog(p): return np.log(-np.log(1-p))
def probit_t(p): return _norm.ppf(p)
rate = df.groupby('SAMPLE_RACE')['BA'].mean()

print("\n[2] Candidate race-pair coefficients for BA completion (marginal, pairwise)")
pairs = [('White','Black'),('White','Hispanic'),('Black','Hispanic')]
print(f"\n{'pair':<20}{'logit':>10}{'|d-logit|':>10}{'probit':>10}{'|d-prob|':>10}{'cloglog':>10}{'|d-ccl|':>10}")
rows=[]
for a,b in pairs:
    lo  = logodds(rate[b])-logodds(rate[a])
    pr  = probit_t(rate[b])-probit_t(rate[a])
    cl  = cloglog(rate[b])-cloglog(rate[a])
    rows.append((f"{b} vs {a}", lo, pr, cl))
for (label,lo,pr,cl) in rows:
    print(f"{label:<20}{lo:>10.4f}{distance(lo):>10.4f}{pr:>10.4f}{distance(pr):>10.4f}{cl:>10.4f}{distance(cl):>10.4f}")

print("\n[3] Full-model fits (reference=White), binomial GLM: logit vs probit")
df['rc'] = pd.Categorical(df['SAMPLE_RACE'], categories=['White','Black','Hispanic'])
X = pd.get_dummies(df['rc'], prefix='', prefix_sep='', drop_first=True).astype(float)
X['const'] = 1.0
X = X[['const','Black','Hispanic']]
rows2=[]
for linkname in ['Logit','Probit']:
    link = getattr(sm.families.links, linkname)()
    r = sm.GLM(df['BA'], X, family=sm.families.Binomial(link=link)).fit()
    b, h = r.params['Black'], r.params['Hispanic']
    rows2.append((linkname,b,h))
    print(f"  {linkname:7s}: Black(vs White)={b: .5f} (|d|={distance(b):.4f}); "
          f"Hispanic(vs White)={h: .5f} (|d|={distance(h):.4f}) ; winner={ 'Hispanic-White' if distance(h)<distance(b) else 'Black-White'}")

print("\n[4] Probit rescaled to logit scale (multiply by ~1.7) for a scale-free ranking")
for linkname, b, h in rows2:
    if linkname=='Probit':
        print(f"  rescaled probit: Black={b*1.7:.5f} (|d|={distance(b*1.7):.4f}), "
              f"Hispanic={h*1.7:.5f} (|d|={distance(h*1.7):.4f}) "
              f"; winner={'Hispanic-White' if distance(h*1.7)<distance(b*1.7) else 'Black-White'}")

print("\n[5] Logit model implied odds factor")
r = sm.GLM(df['BA'], X, family=sm.families.Binomial(link=sm.families.links.Logit())).fit()
eta = {'White': r.params['const'],
       'Black': r.params['const']+r.params['Black'],
       'Hispanic': r.params['const']+r.params['Hispanic']}
for nm in ['White','Black','Hispanic']:
    print(f"  log-odds({nm}) = {eta[nm]:.5f}  ->  odds = {np.exp(eta[nm]):.5f}")
print(f"\n  exp(-0.9568) = {np.exp(-0.9568):.5f} (odds factor implied by target)")
print(f"  exp(-0.9241) = {np.exp(-0.9241):.5f}   (Hispanic vs White)")
print(f"  exp(-1.0057) = {np.exp(-1.0057):.5f}   (Black vs White)")

print("\n"+"="*70); print("CONCLUSION"); print("="*70)
print("Closest two-race pair to target log-odds factor -0.9568 (White reference):")
print("  Hispanic vs White: -0.9241  (|d| = 0.0327)  <- closest candidate")
print("  Black vs White:    -1.0057  (|d| = 0.0489)")
print("  Black vs Hispanic:  +0.0816  (wrong sign, negligible)")
print("Target -0.9568 is NOT exactly reproduced by any standard specification; it lies")
print("between the two White-vs-minority coefficients.  Same pair set and sign structure")
print("under logit and probit (both minorities negative vs White; Black-Hispanic ~ 0).")
