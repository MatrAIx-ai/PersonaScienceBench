"""
Requirements Engineering for ML-enabled Systems — Q8 role association analysis.
DiscoveryBench full_workflow.

KEY DATA-QUALITY FINDING (from inspection):
The Q8_ML_Addressing_* role items (and 104 other columns) are OBFUSCATED:
every cell is exactly one of three tokens -> '-77' (no-response / page not
answered), 'quoted' or 'not quoted' (placeholder strings replacing the original
Likert-frequency labels). No numeric scale survives in these columns.
Consequently we recover the per-role RANK ORDERING (which roles are most often
positively indicated), NOT the original headline proportions (49.6% / 61.389%).
"""
import pandas as pd
import numpy as np
from collections import Counter

RNG_SEED = 42
B = 10_000
DATA = 'data/requirements_engineering_for_ML-enabled_systems.csv'

ROLE_COLS = [
    'Q8_ML_Addressing_Project_Lead',
    'Q8_ML_Addressing_Business_Analyst',
    'Q8_ML_Addressing_Requirement_Engineer',
    'Q8_ML_Addressing_Solution_Architect',
    'Q8_ML_Addressing_Data_Scientist',
    'Q8_ML_Addressing_Developer',
    'Q8_ML_Addressing_Tester',
    'Q8_ML_Addressing_Others',
]
SHORT = {c: c.replace('Q8_ML_Addressing_', '') for c in ROLE_COLS}

df = pd.read_csv(DATA)
N_ALL = len(df)
print(f'[data] respondents: {N_ALL}')

print('\n================ 0. OBFUSCATION CONFIRMATION ================')
q8 = df[ROLE_COLS].astype(str)
vals = set(np.unique(q8.values))
print('distinct values across all Q8 cells:', sorted(vals))
assert vals <= {'-77', 'quoted', 'not quoted'}, 'unexpected Q8 values found!'
print('OK: only placeholder tokens present (no numeric scale).')

na_mask = q8.eq('-77')
print('rows fully -77 on all 8 Q8 items:', int(na_mask.all(axis=1).sum()))
print('per-column -77 counts all equal?', na_mask.sum().nunique() == 1, na_mask.sum().unique())
VALID_N = int((~na_mask.any(axis=1)).sum())
print(f'-> valid respondents (answered Q8 page, n={VALID_N}); all respondents n={N_ALL}')

def point_estimates(indicator, denom_rows):
    out = {}
    for c in ROLE_COLS:
        out[c] = 100.0 * (denom_rows[c].astype(str) == indicator).sum() / len(denom_rows)
    return out

def bootstrap_proportions(indicator, denom_rows, B=B, seed=RNG_SEED):
    """Row-level resampling WITH replacement among denominator respondents;
    each replicate recomputes per-role proportion of the indicator."""
    rng = np.random.default_rng(seed)
    mat = denom_rows[ROLE_COLS].astype(str).eq(indicator).to_numpy(dtype=bool)
    n = len(mat)
    boot = np.empty((B, len(ROLE_COLS)))
    for b in range(B):
        s = rng.integers(0, n, size=n)
        boot[b] = 100.0 * mat[s].mean(axis=0)
    return boot

def report(indicator, denom_name, denom_rows):
    pe = point_estimates(indicator, denom_rows)
    boot = bootstrap_proportions(indicator, denom_rows)
    lo, hi = np.percentile(boot, [2.5, 97.5], axis=0)
    rank = np.argsort(-np.array([pe[c] for c in ROLE_COLS]))
    print(f'\n---- indicator={indicator!r} | denominator: {denom_name} (n={len(denom_rows)}) ----')
    print(f'{"role":<22}{"pct%":>9}{"CI_low":>9}{"CI_high":>9}{"rank":>6}')
    for pos, r in enumerate(rank):
        c = ROLE_COLS[r]
        print(f'{SHORT[c]:<22}{pe[c]:>9.3f}{lo[r]:>9.3f}{hi[r]:>9.3f}{pos+1:>6}')
    return pe, boot, lo, hi, rank

# 1) PRIMARY: 'quoted' among valid (exclude -77)
valid = df[~na_mask.any(axis=1)]
pe1, boot1, lo1, hi1, rank1 = report('quoted', 'valid (excl -77)', valid)

# 2) RANK STABILITY ACROSS BOOTSTRAP REPLICATES (primary op)
order = np.argsort(-boot1, axis=1)               # (B,8) descending ranks
top1 = order[:, 0]
top2_pair = np.sort(order[:, :2], axis=1)
t1 = Counter(top1.tolist())
t2 = Counter(tuple(p) for p in top2_pair)
top2_count = np.zeros(8)
for row in order[:, :2]:
    top2_count[row] += 1
print('\n================ RANK STABILITY (primary: "quoted", valid n=194) ================')
print('share of 10,000 replicates where role is TOP-1:')
for c, cnt in t1.most_common():
    print(f'  {SHORT[ROLE_COLS[c]]:<22}{100*cnt/B:>8.2f}%')
print('share of replicates where role is in TOP-2:')
for i, c in enumerate(ROLE_COLS):
    print(f'  {SHORT[c]:<22}{100*top2_count[i]/B:>8.2f}%')
print('top-2 PAIR joint frequency (top 6):')
for pr, cnt in t2.most_common(6):
    print(f'  {tuple(SHORT[ROLE_COLS[i]] for i in pr)}: {100*cnt/B:.2f}%')

# 3) SENSITIVITY (a): 'not quoted' as indicator among valid
print('\n================ SENSITIVITY (a): "not quoted" as indicator (valid n=194) ================')
peA, bootA, loA, hiA, rankA = report('not quoted', 'valid (excl -77)', valid)
print('top-2 under (a):', [SHORT[ROLE_COLS[i]] for i in rankA[:2]])

# 4) SENSITIVITY (b): 'quoted' with denominator all 276
print('\n================ SENSITIVITY (b): "quoted", denominator ALL 276 ================')
peB, bootB, loB, hiB, rankB = report('quoted', 'all respondents', df)
print('top-2 under (b):', [SHORT[ROLE_COLS[i]] for i in rankB[:2]])

# 5) SENSITIVITY (c): D4_Role cross-tab -> monotone meaningfulness of 'quoted'
print('\n================ SENSITIVITY (c): "quoted" x respondent D4_Role (valid only) ================')
mapping = {'Project_Lead': 'Project Lead', 'Data_Scientist': 'Data Scientist',
           'Solution_Architect': 'Solution Architect', 'Developer': 'Developer',
           'Tester': 'Tester', 'Business_Analyst': 'Business Analyst',
           'Requirement_Engineer': 'Requirements Engineer'}
for c in ROLE_COLS[:-1]:
    role = c.replace('Q8_ML_Addressing_', '')
    own = valid['D4_Role'].astype(str).str.contains(mapping[role], regex=False)
    sub = valid[own]
    if len(sub) == 0:
        continue
    quoted = (sub[c].astype(str) == 'quoted').mean()
    print(f'  {role:<22} own-role respondents n={len(sub):>3}  quoted-rate={100*quoted:6.2f}%')

print('\n================ SUMMARY ================')
print('Primary top-2 (quoted, valid):  ', [SHORT[ROLE_COLS[i]] for i in rank1[:2]])
print('Sensitivity (b) top-2 (all 276):', [SHORT[ROLE_COLS[i]] for i in rankB[:2]])
print('Sensitivity (a) top-2 (inverted):', [SHORT[ROLE_COLS[i]] for i in rankA[:2]])
print('(a) is the mathematical complement among valid respondents; it yields a')
print('domain-implausible result (Tester/Others on top), so "quoted" is the meaning-bearing')
print('direction: a role "quoted" = positively indicated as addressing ML aspects.')
