#!/usr/bin/env python3
"""
Analysis: most commonly used requirements elicitation technique (Q9) in
ML-enabled system projects.
Survey data: data/requirements_engineering_for_ML-enabled_systems.csv
Approved fact: domain_knowledge.1 -> negative numbers / -99 are NA and excluded.
"""
import pandas as pd
import numpy as np

DATA = "data/requirements_engineering_for_ML-enabled_systems.csv"
Q9 = ["Q9_ML_Elicitation_Interviews",
      "Q9_ML_Elicitation_Scenarios",
      "Q9_ML_Elicitation_Prototyping",
      "Q9_ML_Elicitation_Workshops_Meetings",
      "Q9_ML_Elicitation_Observation",
      "Q9_ML_Elicitation_Others"]

df = pd.read_csv(DATA)
print("="*78)
print("STEP 0 - Dataset overview")
print(f"shape: {df.shape}  (rows x cols) ; n respondents = {len(df)}")
print("Status counts:\n", df["Status"].value_counts(dropna=False).to_string())

print("\n" + "="*78)
print("STEP 1 - VERIFY 'quoted'/'not quoted' are binary string literals in Q9")
for c in Q9:
    vc = df[c].value_counts(dropna=False)
    print(f"\n{c}: dtype={df[c].dtype}, nunique={df[c].nunique()}, NaN={df[c].isna().sum()}")
    print(vc.to_string())

print("\n" + "="*78)
print("STEP 2 - Sample of RAW rows (Q9 block + Status + others free)")
cols_view = ["ID", "Status"] + Q9 + ["Q9_ML_Elicitation_Others_Free"]
print("First 8 valid rows (no -77):")
print(df[~df[Q9[0]].eq("-77")][cols_view].head(8).to_string())
print("\nFirst 4 NA rows (all -77):")
print(df[df[Q9[0]].eq("-77")][cols_view].head(4).to_string())

print("\n" + "="*78)
print("STEP 3 - VERIFY the 82-row NA set is exactly Status='Suspended (22)'")
na_set = df[Q9[0]].eq("-77")         # -77 in Interviews col
# all six columns identical -77?
all77 = df[Q9].eq("-77").all(axis=1)
print("rows with -77 in Q9_Interviews:", na_set.sum())
print("rows with -77 in ALL six Q9 cols:", all77.sum())
print("diff (inconsistent -77 patterns):", (na_set != all77).sum())
print("rows with -77 in Interviews that are NOT in all77:", (na_set & ~all77).sum())
print("rows in all77 but not -77 in Interviews:", (all77 & ~na_set).sum())
print("\nCross-tab Status x all77:")
print(pd.crosstab(df["Status"], all77).to_string())
print("\nCompleted/Completed-after-break rows containing -77 or -66 in Q9 block:",
      ((df["Status"].isin(["Completed (31)", "Completed after break (32)"]))
       & (df[Q9].isin(["-77", "-66"]).any(axis=1))).sum())
print("Suspended rows NOT in all77 (answered Q9):", ((df["Status"]=="Suspended (22)") & ~all77).sum())

print("\n" + "="*78)
print("STEP 4 - Missingness among VALID Q9 rows (no -77 row)")
valid_mask = ~all77
sub = df[valid_mask]
print("n valid Q9 responders:", sub.shape[0])
for c in Q9:
    print(f"  {c}: NaN={sub[c].isna().sum()}, '-77'={ (sub[c]=='-77').sum() }, '-66'={(sub[c]=='-66').sum()}")
rows_with_any_na_in_Q9 = sub[Q9].isna().any(axis=1).sum()
print("valid rows with ANY NaN across the six Q9 columns:", rows_with_any_na_in_Q9)

print("\n" + "="*78)
print("STEP 5 - Per-technique percentages (both denominators) + bootstrap 95% CI")
rng = np.random.default_rng(2026)
n_all = len(df)
n_val = valid_mask.sum()
B = 10000
rows = []
for c in Q9:
    v_all = (df[c].eq("quoted")).astype(int).values           # all 276
    # valid indicators: treat -77 as NA -> excluded; quoted=1, not quoted=0
    v_val = (sub[c].eq("quoted")).astype(int).values          # 194 valid
    k_all = int(v_all.sum()); k_val = int(v_val.sum())
    p_all = k_all / n_all * 100
    p_val = k_val / n_val * 100
    # bootstrap on valid denominator
    bs_val = rng.choice(v_val, size=(B, n_val), replace=True).mean(axis=1) * 100
    # bootstrap on all-respondents denominator
    bs_all = rng.choice(v_all, size=(B, n_all), replace=True).mean(axis=1) * 100
    rows.append({
        "technique": c.replace("Q9_ML_Elicitation_", ""),
        "quoted_all": k_all, "pct_all": round(p_all,3),
        "ci_all_lo": round(np.percentile(bs_all,2.5),3),
        "ci_all_hi": round(np.percentile(bs_all,97.5),3),
        "quoted_valid": k_val, "pct_valid": round(p_val,3),
        "ci_valid_lo": round(np.percentile(bs_val,2.5),3),
        "ci_valid_hi": round(np.percentile(bs_val,97.5),3),
    })
res = pd.DataFrame(rows).sort_values("quoted_valid", ascending=False)
print(res.to_string(index=False))

print("\n" + "="*78)
print("STEP 6 - Ranking by raw quoted count (most-used = highest)")
print("By quoted count (valid & all): ", res["technique"].iloc[0],
      f"({res['quoted_valid'].iloc[0]}/194 = {res['pct_valid'].iloc[0]}%; "
      f"{res['quoted_all'].iloc[0]}/276 = {res['pct_all'].iloc[0]}%)")

print("\n" + "="*78)
print("STEP 7 - Check against reported anchor 69.399% CI [69.062, 69.735]")
p = 0.69399
se_anchor = (69.735-69.062)/100/3.92
n_implied = p*(1-p)/se_anchor**2
print(f"Reported anchor: 69.399% CI [69.062, 69.735]  (half-width +/-{(69.735-69.062)/2:.3f}pp)")
print(f"Implied n for that CI width: {n_implied:.0f}  (dataset n=276, valid n=194)")
closest = res.iloc[0]
print(f"Closest data technique: {closest['technique']} pct_valid={closest['pct_valid']}% "
      f"CI [{closest['ci_valid_lo']},{closest['ci_valid_hi']}]")
print("MISMATCH: no Q9 technique reaches 69.4%; anchor treated as external reference only.")

# Save outputs
res.to_csv("q9_result_table.csv", index=False)
print("\nSaved q9_result_table.csv")
