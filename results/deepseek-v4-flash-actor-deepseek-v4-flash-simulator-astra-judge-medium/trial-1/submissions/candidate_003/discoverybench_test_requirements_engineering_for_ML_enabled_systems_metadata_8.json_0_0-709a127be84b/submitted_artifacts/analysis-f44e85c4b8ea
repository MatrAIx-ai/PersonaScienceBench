#!/usr/bin/env python3
"""
Analysis: least-used documentation formats for requirements in ML-enabled systems.
Data: requirements_engineering_for_ML-enabled_systems.csv
Decisions (approved):
  - Denominator for percentages = n=194 (all respondents who answered the Q10
    documentation block; '-77' = 82 Suspended respondents where the block was
    not shown -> treated as NA and excluded). Sensitivity shown for 276/188/164.
  - Measure: p = #quoted / n_valid per format; a format is 'used' iff 'quoted'.
  - 'Not Documented' = separate valid option (not NA, not a format) -> excluded
    from format candidates, remains in denominator.
  - 'Others' = residual category (free text) -> excluded from format candidates;
    when included it ties with ML Canvas at 7.73%.
  - Bootstrap: resample respondent rows with replacement (size n=194), B=10000,
    fixed seed 42, percentile 95% CI (2.5/97.5), plus paired bootstrap of the
    difference of proportions (BDD vs ML Canvas and neighbours) for ranking order.
"""
import numpy as np
import pandas as pd

RNG = np.random.default_rng(42)
B = 10000

df = pd.read_csv("data/requirements_engineering_for_ML-enabled_systems.csv")

Q10_FMT = [
    "Vision_Document", "Requirements_Lists", "Goal_Models", "Use_Case_Models",
    "Prototypes", "User_Stories", "BDD_Scenarios", "MLCanvas", "Notebooks",
    "Data_Models",
]
Q10_ALL = Q10_FMT + ["Others"]
Q10_COLS = ["Q10_ML_Documentation_" + c for c in Q10_ALL]
Q10_COLS_PLUS_ND = Q10_COLS + ["Q10_ML_Documentation_Not_Documented"]

# ---------- 1. data / encoding checks ----------
print("="*90)
print("1) ENCODING / MISSINGNESS")
print("="*90)
print("rows:", len(df), "cols:", len(df.columns))
mat = df[Q10_COLS_PLUS_ND]
print("unique values in Q10 block:", sorted(mat.stack().unique()))
print("rows with '-77' in ALL 12 Q10 cols:", int(mat.eq("-77").all(axis=1).sum()))
print("Status among all-'-77' rows:", df[mat.eq('-77').all(axis=1)]['Status'].value_counts().to_dict())
print("Status among rest:", df[~mat.eq('-77').all(axis=1)]['Status'].value_counts().to_dict())
print("any '-99' inside Q10 block:", bool(mat.eq("-99").any().any()))

miss_all = mat.eq("-77").all(axis=1)
valid = df[~miss_all]
print("valid Q10 respondents (denominator base):", len(valid))

# ---------- 2. proportions under 4 denominators ----------
print("\n" + "="*90)
print("2) PROPORTIONS (quoted %) UNDER ALTERNATIVE DENOMINATORS")
print("="*90)
subsets = {
    "n=194 (all who answered Q10; -77=NA)": valid,
    "n=276 (all respondents, -77 counted as denominator)": df,
    "n=188 (exclude ALL Suspended)": df[df["Status"] != "Suspended (22)"],
    "n=164 (Completed only)": df[df["Status"] == "Completed (31)"],
}
rank_tables = {}
for label, sub in subsets.items():
    n = len(sub)
    rows = []
    for i, c in enumerate(Q10_ALL):
        col = "Q10_ML_Documentation_" + c
        cnt = int((sub[col] == "quoted").sum())
        rows.append((c, cnt, 100.0 * cnt / n))
    # add Not Documented for the record
    ndc = int((sub["Q10_ML_Documentation_Not_Documented"] == "quoted").sum())
    rows.append(("Not_Documented*", ndc, 100.0 * ndc / n))
    rt = pd.DataFrame(rows, columns=["format", "count", "pct"]).sort_values("pct")
    rank_tables[label] = rt
    print(f"\n-- {label} --")
    print(rt.to_string(index=False, float_format=lambda x: f"{x:7.3f}"))

# ---------- 3. main analysis on n=194 ----------
print("\n" + "="*90)
print(f"3) MAIN: n=194, bootstrap 95% CI (percentile, B={B}, seed=42)")
print("="*90)
x = valid
n = len(x)
results = []
for i, c in enumerate(Q10_ALL):
    col = "Q10_ML_Documentation_" + c
    vec = (x[col] == "quoted").to_numpy().astype(int)
    p_obs = vec.mean()
    boots = np.empty(B)
    for b in range(B):
        boots[b] = vec[RNG.integers(0, n, n)].mean()
    lo, hi = np.percentile(boots, [2.5, 97.5])
    results.append((c, int(vec.sum()), p_obs, lo, hi))
results.sort(key=lambda r: r[2])   # ascending by observed proportion
print(" ranks (ascending share of respondents selecting the format):")
print(f"{'rank':<4}{'format':<22}{'quoted':>6}{'p%':>9}{'CI_low%':>10}{'CI_high%':>11}")
for rk, (c, cnt, p, lo, hi) in enumerate(results, 1):
    print(f"{rk:<4}{c:<22}{cnt:>6}{100*p:>9.3f}{100*lo:>10.3f}{100*hi:>11.3f}")

# Not Documented for the record under n=194
ndv = (x["Q10_ML_Documentation_Not_Documented"] == "quoted").to_numpy().astype(int)
p_nd = ndv.mean()
bnd = np.array([ndv[RNG.integers(0, n, n)].mean() for _ in range(B)])
print(f"Not_Documented*: quoted={ndv.sum()}, p={100*p_nd:.3f}% CI=[{100*np.percentile(bnd,2.5):.3f}, {100*np.percentile(bnd,97.5):.3f}]  (* valid option, not a format)")

# ---------- 4. top of the ranking: the two least used candidates ----------
print("\n" + "="*90)
print("4) TWO LEAST-USED NAMED FORMATS (excl. 'Others' residual, 'Not Documented')")
print("="*90)
cand = [r for r in results if r[0] in Q10_FMT]
cand.sort(key=lambda r: r[2])
first, second = cand[0], cand[1]
print(" 1st (least used):", first[0], f"{100*first[2]:.3f}%  CI=[{100*first[3]:.3f},{100*first[4]:.3f}]")
print(" 2nd (2nd least): ", second[0], f"{100*second[2]:.3f}%  CI=[{100*second[3]:.3f},{100*second[4]:.3f}]")
# 'Others' for reference (tie with 2nd)
oth = [r for r in results if r[0] == "Others"][0]
print(" (reference) Others residual:", f"{100*oth[2]:.3f}%  CI=[{100*oth[3]:.3f},{100*oth[4]:.3f}]")

# ---------- 5. paired bootstrap of difference of proportions ----------
print("\n" + "="*90)
print(f"5) PAIRED BOOTSTRAP OF DIFFERENCE OF PROPORTIONS (n=194, B={B})")
print("="*90)
def paired_boots(cA, cB):
    vA = (x["Q10_ML_Documentation_"+cA] == "quoted").to_numpy().astype(int)
    vB = (x["Q10_ML_Documentation_"+cB] == "quoted").to_numpy().astype(int)
    d = np.empty(B)
    for b in range(B):
        idx = RNG.integers(0, n, n)
        d[b] = vA[idx].mean() - vB[idx].mean()
    lo, hi = np.percentile(d, [2.5, 97.5])
    p_less = (d < 0).mean()
    return vA, vB, d, lo, hi, p_less

pairs = [
    ("BDD_Scenarios", "MLCanvas"),
    ("BDD_Scenarios", "Vision_Document"),
    ("MLCanvas", "Vision_Document"),
    ("MLCanvas", "Others"),
]
for cA, cB in pairs:
    _, _, d, lo, hi, p_less = paired_boots(cA, cB)
    print(f"Delta = p({cA}) - p({cB}): obs={np.mean(d):+.4f} "
          f"95%CI=[{lo:+.4f},{hi:+.4f}]  P(Delta<0)={p_less:.4f}")
