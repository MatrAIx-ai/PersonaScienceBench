"""
World Bank Education Expenditure & Per-Capita Income — DiscoveryBench episode.

Question: How does the effect of increasing education expenditure on per capita GDP
compare between developing countries (here: WDI Lower-Middle-Income aggregate, LMC)
and countries in Sub-Saharan Africa (WDI aggregate SSF)?

The file contains TWO aggregate time series (N=2 units) for 1975-2015:
  - Outcome proxy:  GNI per capita (constant 2015 US$)  [NY.GNP.PCAP.KD]
  - Regressor:      Adjusted savings: education expenditure (% of GNI) [NY.ADJ.AEDU.GN.ZS]
plus enrollments (primary/secondary), exports growth, labor force participation.

Identification is descriptive only: a causal group-specific effect is NOT identifiable
from two aggregate series where the SSA outcome is observed only for 2011-2015.
"""
import numpy as np
import pandas as pd
import statsmodels.api as sm
from statsmodels.stats.stattools import durbin_watson

RNG = np.random.default_rng(0)
pd.set_option("display.width", 200)

DATA = "data/worldbank_education_gdp.csv"

# ----------------------------------------------------------------------------
# 1. Load, reshape, coverage
# ----------------------------------------------------------------------------
df = pd.read_csv(DATA)
year_cols = [c for c in df.columns if "[YR" in c]
long = df.melt(
    id_vars=["Country Group", "Country Code", "Series Name", "Series Code"],
    var_name="Year_raw", value_name="Value",
)
long["Year"] = long["Year_raw"].str.extract(r"(\d{4})").astype(float)
long = long.dropna(subset=["Year"])
long["Year"] = long["Year"].astype(int)

def series_pivot(pattern):
    sub = long[long["Series Name"].str.contains(pattern)]
    p = sub.pivot_table(index="Year", columns="Country Group", values="Value")
    return p

gni   = series_pivot("GNI per capita")
edu   = series_pivot("education expenditure")
prim  = series_pivot("School enrollment, primary")
sec   = series_pivot("School enrollment, secondary")
expg  = series_pivot("Exports of goods and services")
lab   = series_pivot("Labor force participation")

G_SSA = "Sub-Saharan Africa"
G_LMC = "Lower middle income"

# Coverage table
cov_rows = []
for name, p in [("GNI per capita (outcome)", gni), ("Education exp. % of GNI", edu),
                ("Enroll primary", prim), ("Enroll secondary", sec),
                ("Exports growth", expg), ("Labor force part.", lab)]:
    cov_rows.append({
        "series": name,
        "SSA (n/41)": int(p[G_SSA].notna().sum()),
        "LMC (n/41)": int(p[G_LMC].notna().sum()),
        "SSA years": ",".join(map(str, p.index[p[G_SSA].notna()])) if p[G_SSA].notna().sum() < 41 else "1975-2015",
    })
cov = pd.DataFrame(cov_rows)
print("=" * 90)
print("1. COVERAGE")
print(cov.to_string(index=False))
cov.to_csv("results/coverage.csv", index=False)

# ----------------------------------------------------------------------------
# 2. Helper to run OLS and report key quantities
# ----------------------------------------------------------------------------
def ols_report(y, X, label, cov_type="HC1", nw_lags=None):
    """y, X are DataFrames (aligned). Returns a dict + prints a compact line."""
    m = sm.OLS(y, X)
    if nw_lags is not None:
        res = m.fit(cov_type="HAC", cov_kwds={"maxlags": nw_lags})
    else:
        res = m.fit(cov_type=cov_type)
    out = {
        "label": label, "n": int(res.nobs),
        "r2": float(res.rsquared), "dw": float(durbin_watson(res.resid, axis=0)),
    }
    ci_df = res.conf_int()
    for name in res.params.index:
        out[f"b_{name}"] = float(res.params[name])
        out[f"se_{name}"] = float(res.bse[name])
        out[f"p_{name}"] = float(res.pvalues[name])
        lo_, hi_ = ci_df.loc[name]
        out[f"lo_{name}"] = float(lo_); out[f"hi_{name}"] = float(hi_)
    # pretty print
    parts = [f"{label}  n={out['n']}  R2={out['r2']:.3f}  DW={out['dw']:.2f}"]
    for name in X.columns:
        parts.append(f"{name}={out['b_'+name]:+.4f} [CI {out['lo_'+name]:+.4f},{out['hi_'+name]:+.4f}] p={out['p_'+name]:.3f}")
    print("   " + " | ".join(parts))
    return out

ln_gni_lmc = np.log(gni[G_LMC])
d_lmc      = np.log(gni[G_LMC]).diff()
dedu_lmc   = edu[G_LMC].diff()
edu_lmc    = edu[G_LMC]

ln_gni_ssa = np.log(gni[G_SSA])
d_ssa      = np.log(gni[G_SSA]).diff()
dedu_ssa   = edu[G_SSA].diff()
edu_ssa    = edu[G_SSA]

results = []
Y = pd.DataFrame({"ln_y": ln_gni_lmc}).dropna().iloc[1:, :]  # placeholder alignment
print("=" * 90)
print("2A. LMC (developing-countries proxy), FULL SAMPLE 1975-2015")

# --- M1 levels bivariate + trend ---
d1 = pd.concat([ln_gni_lmc.rename("ln_y"), edu_lmc.rename("edu")], axis=1).dropna()
X1 = sm.add_constant(d1[["edu"]])
X1["trend"] = np.arange(len(X1))
results.append(ols_report(d1["ln_y"], X1, "M1 LMC levels ln(GNI)~edu+trend"))

# --- M2 levels AR(1) + trend ---
d2 = pd.concat([ln_gni_lmc.rename("ln_y"), edu_lmc.rename("edu"), ln_gni_lmc.shift(1).rename("ln_y_lag1")], axis=1).dropna()
X2 = sm.add_constant(d2[["edu", "ln_y_lag1"]])
X2["trend"] = np.arange(len(X2))
results.append(ols_report(d2["ln_y"], X2, "M2 LMC levels AR(1) ln(GNI)~edu+lag+trend"))

# --- M3 growth bivariate ---
d3 = pd.concat([d_lmc.rename("d_ln_y"), dedu_lmc.rename("d_edu")], axis=1).dropna()
X3 = sm.add_constant(d3[["d_edu"]])
results.append(ols_report(d3["d_ln_y"], X3, "M3 LMC growth dln(GNI)~d(edu)"))

# --- M4 growth AR(1) ---
d4 = pd.concat([d3["d_ln_y"], d3["d_edu"], d3["d_ln_y"].shift(1).rename("dlag")], axis=1).dropna()
X4 = sm.add_constant(d4[["d_edu", "dlag"]])
results.append(ols_report(d4["d_ln_y"], X4, "M4 LMC growth AR(1) dln~d(edu)+lag"))

# --- M5 growth vs 1-yr lagged education level ---
d5 = pd.concat([d_lmc.rename("d_ln_y"), edu_lmc.shift(1).rename("edu_lag1")], axis=1).dropna()
X5 = sm.add_constant(d5[["edu_lag1"]])
results.append(ols_report(d5["d_ln_y"], X5, "M5 LMC growth dln~edu(t-1)"))

# --- M6 growth vs 5-yr lagged education level ---
d6 = pd.concat([d_lmc.rename("d_ln_y"), edu_lmc.shift(5).rename("edu_lag5")], axis=1).dropna()
X6 = sm.add_constant(d6[["edu_lag5"]])
results.append(ols_report(d6["d_ln_y"], X6, "M6 LMC growth dln~edu(t-5)"))

# --- M7 growth vs CHANGE in education (1-yr lagged diff) ---
d7 = pd.concat([d_lmc.rename("d_ln_y"), dedu_lmc.shift(1).rename("d_edu_lag1")], axis=1).dropna()
X7 = sm.add_constant(d7[["d_edu_lag1"]])
results.append(ols_report(d7["d_ln_y"], X7, "M7 LMC growth dln~d(edu)(t-1)"))

# --- M8 five-year growth vs five-year change in edu share ---
dl5 = np.log(gni[G_LMC]).diff(5); de5 = edu[G_LMC].diff(5)
d8 = pd.concat([dl5.rename("d5_ln_y"), de5.rename("d5_edu")], axis=1).dropna()
X8 = sm.add_constant(d8[["d5_edu"]])
results.append(ols_report(d8["d5_ln_y"], X8, "M8 LMC 5-yr growth ~ 5-yr d(edu)"))

# --- M9 LMC with controls, 1991-2015 window (controls available) ---
d9 = pd.concat([d_lmc.rename("d_ln_y"), dedu_lmc.rename("d_edu"),
                prim[G_LMC].diff().rename("d_prim"), sec[G_LMC].diff().rename("d_sec"),
                expg[G_LMC].rename("expg"), lab[G_LMC].diff().rename("d_lab")], axis=1).dropna()
X9 = sm.add_constant(d9[["d_edu", "d_prim", "d_sec", "expg", "d_lab"]])
results.append(ols_report(d9["d_ln_y"], X9, "M9 LMC growth +controls 1991-2015"))

# HAC robustness for the workhorse growth spec
d3b = d3
X3b = sm.add_constant(d3b[["d_edu"]])
results.append(ols_report(d3b["d_ln_y"], X3b, "M3b LMC growth HAC(2) dln~d(edu)", nw_lags=2))

print()
print("2B. SSA (Sub-Saharan Africa), ONLY 2011-2015 OBSERVED FOR OUTCOME (n=5)")
# --- S1 levels bivariate ---
s1 = pd.concat([ln_gni_ssa.rename("ln_y"), edu_ssa.rename("edu")], axis=1).dropna()
XS1 = sm.add_constant(s1[["edu"]])
results.append(ols_report(s1["ln_y"], XS1, "S1 SSA levels ln(GNI)~edu (n=5)"))

# --- S2 growth bivariate (n=4) ---
s2 = pd.concat([d_ssa.rename("d_ln_y"), dedu_ssa.rename("d_edu")], axis=1).dropna()
XS2 = sm.add_constant(s2[["d_edu"]])
results.append(ols_report(s2["d_ln_y"], XS2, "S2 SSA growth dln~d(edu) (n=4)"))

# SSA same-window descriptive numbers
print("   SSA 2011-2015 raw: edu share % ->", np.round(edu_ssa.loc[2011:2015], 2).tolist())
print("   SSA 2011-2015 raw: ln(GNI)   ->", np.round(np.log(gni[G_SSA].loc[2011:2015]), 3).tolist())
print("   SSA corr(levels edu, GNI_pc) = %.3f; corr(d_edu, d_ln_gni) = %.3f" %
      (edu_ssa.loc[2011:2015].corr(gni[G_SSA].loc[2011:2015]),
       dedu_ssa.loc[2011:2015].corr(d_ssa.loc[2011:2015])))

print()
print("3. POOLED 2011-2015 COMPARISON (the only window where BOTH groups have outcome)")
# --- P1 pooled levels with group x edu interaction ---
p_rows = []
for grp in [G_SSA, G_LMC]:
    yy = np.log(gni[grp]); ee = edu[grp]
    pp = pd.concat([yy.rename("ln_y"), ee.rename("edu")], axis=1).loc[2011:2015].dropna()
    pp["group"] = 1.0 if grp == G_LMC else 0.0
    pp["group_x_edu"] = pp["group"] * pp["edu"]
    pp["grp_name"] = grp
    p_rows.append(pp)
pool = pd.concat(p_rows)
XP1 = sm.add_constant(pool[["edu", "group", "group_x_edu"]])
results.append(ols_report(pool["ln_y"], XP1, "P1 pooled levels ln~edu+group+eduXgroup (n=10)"))

# P1 without interaction (equal slope)
XP1b = sm.add_constant(pool[["edu", "group"]])
results.append(ols_report(pool["ln_y"], XP1b, "P1b pooled levels no-interaction (n=10)"))

# --- P2 pooled growth with interaction ---
p2_rows = []
for grp in [G_SSA, G_LMC]:
    yy = np.log(gni[grp]).diff(); ee = edu[grp].diff()
    pp = pd.concat([yy.rename("d_ln_y"), ee.rename("d_edu")], axis=1).loc[2012:2015].dropna()
    pp["group"] = 1.0 if grp == G_LMC else 0.0
    pp["group_x_edu"] = pp["group"] * pp["d_edu"]
    p2_rows.append(pp)
pool2 = pd.concat(p2_rows)
XP2 = sm.add_constant(pool2[["d_edu", "group", "group_x_edu"]])
results.append(ols_report(pool2["d_ln_y"], XP2, "P2 pooled growth dln~dedu+group+deduXgroup (n=8)"))

XP2b = sm.add_constant(pool2[["d_edu", "group"]])
results.append(ols_report(pool2["d_ln_y"], XP2b, "P2b pooled growth no-interaction (n=8)"))

# Implied group slopes from P1
mP1 = sm.OLS(pool["ln_y"], XP1).fit(cov_type="HC1")
b_edu, b_inter = mP1.params["edu"], mP1.params["group_x_edu"]
print()
print(f"   P1 implied slope SSA = {b_edu:+.4f}; LMC = {b_edu + b_inter:+.4f}; interaction p = {mP1.pvalues['group_x_edu']:.3f}")
mP2 = sm.OLS(pool2["d_ln_y"], XP2).fit(cov_type="HC1")
b_edu2, b_inter2 = mP2.params["d_edu"], mP2.params["group_x_edu"]
print(f"   P2 implied slope SSA growth = {b_edu2:+.4f}; LMC growth = {b_edu2 + b_inter2:+.4f}; interaction p = {mP2.pvalues['group_x_edu']:.3f}")


# ----------------------------------------------------------------------------
# 4. Robustness / specification-sensitivity
# ----------------------------------------------------------------------------
print()
print("4. ROBUSTNESS / SPEC-SENSITIVITY CHECKS")
# R1: HAC(4) for the overlapping 5-yr window model (M8)
results.append(ols_report(d8["d5_ln_y"], X8, "R1 LMC 5-yr growth ~ 5-yr d(edu) HAC(4)", nw_lags=4))
# R2: LMC restricted to the SAME 2011-2015 window in growth terms (n=4, apples-to-apples with SSA)
d_same = pd.concat([d_lmc.rename("d_ln_y"), dedu_lmc.rename("d_edu")], axis=1).loc[2011:2015].dropna()
X_same = sm.add_constant(d_same[["d_edu"]])
results.append(ols_report(d_same["d_ln_y"], X_same, "R2 LMC 2011-15 growth dln~d(edu) (n=4)"))
# R3: LMC full-sample growth EXCLUDING 2011-2015 (is the recent window atypical?)
d_pre = d3.loc[:2010].dropna()
X_pre = sm.add_constant(d_pre[["d_edu"]])
results.append(ols_report(d_pre["d_ln_y"], X_pre, "R3 LMC growth 1976-2010 dln~d(edu)"))
# R4: LMC levels restricted to 2011-2015 (n=5) for level-slope apple-to-apples with SSA
d_lv_same = pd.concat([ln_gni_lmc.rename("ln_y"), edu_lmc.rename("edu")], axis=1).loc[2011:2015].dropna()
X_lv_same = sm.add_constant(d_lv_same[["edu"]])
results.append(ols_report(d_lv_same["ln_y"], X_lv_same, "R4 LMC 2011-15 levels ln~edu (n=5)"))

# LMC education-share path in recent window (for the %-of-GNI mechanics note)
print()
print("   LMC edu share % 2011-2015:", np.round(edu[G_LMC].loc[2011:2015], 2).tolist())
print("   LMC ln(GNI)     2011-2015:", np.round(np.log(gni[G_LMC].loc[2011:2015]), 3).tolist())

