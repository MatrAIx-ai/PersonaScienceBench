# ----------------------------------------------------------------------------
rows_out = []
key = ["constant", "edu", "d_edu", "ln_y_lag1", "dlag", "edu_lag1", "edu_lag5",
       "d_edu_lag1", "d5_edu", "group", "group_x_edu", "trend",
       "d_prim", "d_sec", "expg", "d_lab"]
for r in results:
