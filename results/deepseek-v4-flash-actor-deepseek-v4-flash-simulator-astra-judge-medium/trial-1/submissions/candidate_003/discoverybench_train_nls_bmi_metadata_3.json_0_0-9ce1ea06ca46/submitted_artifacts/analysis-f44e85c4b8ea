import pandas as pd, numpy as np
import statsmodels.api as sm

df = pd.read_csv('data/nls_bmi_processed.csv')

# ---- Imputation flags (values exactly at column mean = imputation signature) ----
imp_inc = np.isclose(df['INCOME'], df['INCOME'].mean())
imp_bmi = np.isclose(df['BMI'],    df['BMI'].mean())
df['IMP_INC'] = imp_inc.astype(int)
df['IMP_BMI'] = imp_bmi.astype(int)

# BMI: exclude 11 implausible values (>=80)
n_excl = (df['BMI']>=80).sum()
df = df[df['BMI']<80].copy()
print("Excluding BMI>=80 rows:", n_excl)

df['MALE'] = (df['GENDER']=='MALE').astype(int)
df['AGEc'] = df['AGE'] - 28.0
df['AGEc2'] = df['AGEc']**2
df['LOGINCOME'] = np.log1p(df['INCOME'])

complete = df[(~df['IMP_INC'].astype(bool)) & (~df['IMP_BMI'].astype(bool))].copy()
allrows  = df.copy()
print("Complete-case rows (no imputed values, BMI<80):", complete.shape[0], "| full:", allrows.shape[0])

def show(m, title):
    t = m.conf_int(); t.columns=['2.5%','97.5%']
    t['Coef.']=m.params; t['Std.Err.']=m.bse; t['z']=m.tvalues; t['P>|z|']=m.pvalues
    print("\n"+title)
    print(t.round(4).to_string())

# ============ 1. DESCRIPTIVE ============
print("\n===== DISSAVED rate (%) by AGE: all vs complete =====")
rows=[]
for age in sorted(df['AGE'].unique()):
    d_=df[df['AGE']==age]; d_c=complete[complete['AGE']==age]
    rows.append([age, len(d_), round(d_['DISSAVED'].mean()*100,1), len(d_c), round(d_c['DISSAVED'].mean()*100,1)])
print(pd.DataFrame(rows, columns=['AGE','n_all','rate_all%','n_complete','rate_complete%']).to_string(index=False))

for lab, d in [("ALL rows", df), ("COMPLETE rows", complete)]:
    d=d.copy()
    d['AGEBAND']=pd.cut(d['AGE'], bins=[23,25,28,31,32.1], labels=['24-25','26-28','29-31','32'], right=False)
    t=d.groupby('AGEBAND')['DISSAVED'].agg(['mean','count']); t['mean']=(t['mean']*100).round(1)
    print(("\n===== DISSAVED rate (%%) by age-band, %s =====") % lab); print(t.to_string())

# ============ 2. PRIMARY LOGIT (complete rows) ============
Y = complete['DISSAVED']
Xq = sm.add_constant(complete[['AGEc','AGEc2','MALE','INCOME','BLACK','HISPANIC','BMI']])
m_quad = sm.Logit(Y, Xq).fit(disp=0)
show(m_quad, "PRIMARY: DISSAVED ~ AGEc+AGEc2+MALE+INCOME+BLACK+HISPANIC+BMI (complete, n=%d)" % len(Y))

Xa = sm.add_constant(complete[['AGEc','MALE','INCOME','BLACK','HISPANIC','BMI']])
m_age = sm.Logit(Y, Xa).fit(disp=0)
from scipy import stats as _st
_lr = 2*(m_quad.llf - m_age.llf); _lp = 1 - _st.chi2.cdf(_lr, 1)
_R = np.zeros((2, len(m_quad.params))); _R[0, m_quad.params.index.get_loc('AGEc')]=1; _R[1, m_quad.params.index.get_loc('AGEc2')]=1
wald = m_quad.wald_test(_R)
print("\nAIC: AGE-only %.1f | AGE+AGE2 %.1f" % (m_age.aic, m_quad.aic))
print("LRT for AGE^2 term: chi2=%.3f df=1 p=%.4f" % (_lr, _lp))
_cs = float(np.asarray(wald.statistic).ravel()[0]); _cp = float(np.asarray(wald.pvalue).ravel()[0])
print("Joint Wald test of AGE & AGE^2: chi2=%.3f df=2 p=%.4f" % (_cs, _cp))
print("Pseudo R2: AGE-only %.4f / AGE+AGE2 %.4f" % (m_age.prsquared, m_quad.prsquared))

# ============ 3. Predicted probabilities ============
ref = {'MALE': round(complete['MALE'].mean()), 'INCOME': complete['INCOME'].mean(),
       'BLACK': complete['BLACK'].mean(), 'HISPANIC': complete['HISPANIC'].mean(),
       'BMI': complete['BMI'].mean()}
from scipy.special import expit
def pred_at(age, model, r):
    ae=age-28.0
    Xn=pd.DataFrame([{'const':1,'AGEc':ae,'AGEc2':ae**2,'MALE':r['MALE'],'INCOME':r['INCOME'],
                      'BLACK':r['BLACK'],'HISPANIC':r['HISPANIC'],'BMI':r['BMI']}])
    Xn=Xn[['const','AGEc','AGEc2','MALE','INCOME','BLACK','HISPANIC','BMI']].values
    lp = float(np.dot(Xn, model.params.values).ravel()[0])
    p  = float(expit(lp))
    se = float(np.sqrt(np.dot(np.dot(Xn, model.cov_params().values), Xn.T)).ravel()[0])
    lo = float(expit(lp - 1.96*se)); hi = float(expit(lp + 1.96*se))
    return p, (lo, hi)

preds=[]
print("\n===== Predicted P(DISSAVED=1) by age (covariates at complete-row means, modal male) =====")
print("AGE | P(DISSAVED) | 95% CI")
grid=[]
for a in range(24,33):
    p,ci=pred_at(a,m_quad,ref); preds.append((a,p,ci))
    print("%2d  |    %.3f     | [%.3f, %.3f]" % (a,p,ci[0],ci[1]))
    grid.append({'AGE':a,'P_DISSAVED':round(p,4),'CI_low':round(ci[0],4),'CI_high':round(ci[1],4)})
pd.DataFrame(grid).to_csv('prediction_grid.csv', index=False)

p25,_=pred_at(25,m_quad,ref); p30,_=pred_at(30,m_quad,ref)
p24,_=pred_at(24,m_quad,ref); p32,_=pred_at(32,m_quad,ref)
print("\nAge 25 vs 30: %.3f vs %.3f  (Δ %.1f pp)" % (p25,p30,(p30-p25)*100))
print("Age 24 vs 32: %.3f vs %.3f  (Δ %.1f pp)" % (p24,p32,(p32-p24)*100))
pk = max(preds, key=lambda x:x[1]); print("Predicted peak age: %d (P=%.3f)" % (pk[0], pk[1]))

lp = m_quad.predict(Xq, linear=True); p=m_quad.predict(Xq)
b1,b2 = m_quad.params['AGEc'], m_quad.params['AGEc2']
ame = np.mean(p*(1-p)*(b1+2*b2*complete['AGEc']))
print("Average marginal effect of +1 yr on P(DISSAVED): %.4f (%.2f pp/yr)" % (ame, ame*100))

# ============ 4. SENSITIVITY: all rows with imputation indicators ============
Yall = allrows['DISSAVED']
Xai = sm.add_constant(allrows[['AGEc','AGEc2','MALE','INCOME','BLACK','HISPANIC','BMI','IMP_INC','IMP_BMI']])
m_all = sm.Logit(Yall, Xai).fit(disp=0)
show(m_all, "SENSITIVITY: all rows (n=%d) incl. IMP_INC, IMP_BMI" % len(allrows))

Xar = sm.add_constant(allrows[['AGEc','AGEc2','MALE','INCOME','BLACK','HISPANIC','BMI']])
m_raw = sm.Logit(Yall, Xar).fit(disp=0)
print("\nCONTRAST (all rows, NO imputation indicators = raw data):")
print("AGEc coef=%.4f p=%.4f | AGEc2 coef=%.4f p=%.4f" % (
    m_raw.params['AGEc'], m_raw.pvalues['AGEc'], m_raw.params['AGEc2'], m_raw.pvalues['AGEc2']))

# ============ 5. ROBUSTNESS: log income ============
Xl = sm.add_constant(complete[['AGEc','AGEc2','MALE','LOGINCOME','BLACK','HISPANIC','BMI']])
m_log = sm.Logit(Y, Xl).fit(disp=0)
print("\nROBUSTNESS (complete rows, log1p income):")
print("AGEc coef=%.4f p=%.4f | AGEc2 coef=%.4f p=%.4f" % (
    m_log.params['AGEc'], m_log.pvalues['AGEc'], m_log.params['AGEc2'], m_log.pvalues['AGEc2']))
print("\nDONE")
