import pandas as pd
import numpy as np

df = pd.read_csv('data/nls_bmi_processed.csv')
print("Shape:", df.shape)
print("\nColumn dtypes:\n", df.dtypes)
print("\nMissingness per column:\n", df.isna().sum())
print("\nDuplicate rows (exact all-column dups):", df.duplicated().sum())

print("\n=== GENDER ===")
print(df['GENDER'].value_counts(dropna=False))
print("\n=== DISSAVED ===")
print(df['DISSAVED'].value_counts(dropna=False))
print("Mean (rate):", df['DISSAVED'].mean())
print("\n=== SAMESAVE ===")
print(df['SAMESAVE'].value_counts(dropna=False))
print("Mean:", df['SAMESAVE'].mean())
print("\n=== BLACK ===")
print(df['BLACK'].value_counts(dropna=False))
print("\n=== HISPANIC ===")
print(df['HISPANIC'].value_counts(dropna=False))

print("\n=== AGE ===")
print("Range:", df['AGE'].min(), "-", df['AGE'].max())
print("Unique values:", sorted(df['AGE'].unique()))
print("Value counts (top):\n", df['AGE'].value_counts().sort_index())
print("\n=== AGE_2 ===")
print("Check AGE_2 == AGE^2:", (df['AGE_2'] == df['AGE']**2).all())
mism = df[df['AGE_2'] != df['AGE']**2]
print("Mismatched count:", len(mism))
if len(mism): print(mism.head())

print("\n=== INCOME ===")
print(df['INCOME'].describe())
print("Skew:", df['INCOME'].skew())
print("Share <=0:", (df['INCOME']<=0).mean())

print("\n=== BMI ===")
print(df['BMI'].describe())
print("Implausible BMI (<10 or >80):", ((df['BMI']<10)|(df['BMI']>80)).sum())
