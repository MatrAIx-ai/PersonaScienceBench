"""NLSY79 analysis: Does higher time preference lead to higher BMI?
Unit forensics, BMI construction, time-preference proxies, bivariate+adjusted regressions."""
import numpy as np, pandas as pd, statsmodels.api as sm
import statsmodels.formula.api as smf
np.random.seed(0); pd.set_option('display.width', 210)

df = pd.read_csv('data/nls_raw.csv')
# --- Unit forensics: 1981 height = feet+inches encoded (F'II); weights = POUNDS ---
df['H81_in'] = (df['Height of respondent, 1981'] // 100) * 12 + (df['Height of respondent, 1981'] % 100)
df['H85_in'] = df['Height of respondent, 1985']
df['BMI81'] = 703 * df['Weight of respondent, 1981'] / df['H81_in'] ** 2
df['BMI89'] = 703 * df['Weight of respondent, 1989'] / df['H85_in'] ** 2
df['BMI92'] = 703 * df['Weight of respondent, 1992'] / df['H85_in'] ** 2
df['dBMI_81_92'] = df['BMI92'] - df['BMI81']
df['obese92'] = (df['BMI92'] >= 30).astype(float)
for c in ['BMI81', 'BMI89', 'BMI92']:
    df.loc[(df[c] < 10) | (df[c] > 60), c] = np.nan

# --- Time preference proxies ---
df['sav_dir'] = df['Was more money put into or taken out of R/spouse savings since last interview, 1989']
df['sav_cat'] = df['sav_dir'].map({1: 'put_in', 2: 'took_out', 3: 'no_change', 4: 'no_savings'})
df['tp_ord'] = df['sav_dir'].map({1: 0.0, 3: 1.0, 2: 2.0, 4: 3.0})  # impatience intensity
df['asinh_wealth90'] = np.arcsinh(df['Family net wealth, 1990'])
df['asinh_wealth85'] = np.arcsinh(df['Family net wealth, 1985'])
df['log_inc89'] = np.log1p(df['Total net family income, previous calendar year, 1989'].clip(lower=0))
df['log_inc79'] = np.log1p(df['Total net family income, previous calendar year, 1979'].clip(lower=0))
resc = [c for c in df.columns if c.startswith('Type of residence') and int(c[-2:]) <= 92]
jail = np.zeros(len(df)); ever = np.zeros(len(df), dtype=bool)
for c in resc:
    jail = np.maximum(jail, (df[c] == 5).fillna(False).astype(float).values)
    ever = ever | df[c].notna().values
df['jail_any'] = np.where(ever, jail, np.nan)
df['ever_sent'] = df['Ever been sentenced in any correctional institution before 1980']
df['ever_conv'] = df['Ever convicted of an illegal act in adult court before 1980']

# --- Covariates ---
df['female'] = (df['Sex of respondent, 1979'] == 2).astype(float)
df['race_black'] = (df['Racial/ethnic cohort, 1979'] == 1).astype(float)
df['race_hisp'] = (df['Racial/ethnic cohort, 1979'] == 2).astype(float)
df['age89'] = df['Age of respondent at interview date, 1989']
df['educ79'] = df['Highest grade completed, 1979']; df.loc[df['educ79'] >= 95, 'educ79'] = np.nan
df['mom_edu'] = df["Highest grade completed by respondent's mother, 1979"]
df['dad_edu'] = df["Highest grade completed by respondent's father, 1979"]
df['famsize'] = df['Family size, 1979']
asv = [c for c in df.columns if c.startswith('ASVAB')]
df['asvab'] = df[asv].mean(axis=1)
df['asvab_z'] = (df['asvab'] - df['asvab'].mean()) / df['asvab'].std()
df['sample_id'] = df['Sample ID, 1979 (interview)'].astype('category')

adjvars = ['female', 'race_black', 'race_hisp', 'age89', 'educ79', 'log_inc89',
           'mom_edu', 'dad_edu', 'famsize', 'asvab_z', 'BMI81', 'C(sample_id)']
adj2 = df.dropna(subset=['BMI92', 'sav_dir', 'BMI81', 'female', 'race_black', 'race_hisp', 'age89',
                         'educ79', 'log_inc89', 'mom_edu', 'dad_edu', 'famsize', 'asvab_z']).copy()
mx = df[df['BMI92'].notna() & df['sav_dir'].notna()].copy()
# dummy dummies with put_in as reference (constant absorbs put_in)
for lab in ['no_change', 'took_out', 'no_savings']:
    adj2['d_' + lab] = (adj2['sav_cat'] == lab).astype(float)
    mx['d_' + lab] = (mx['sav_cat'] == lab).astype(float)
adj2['saver'] = (adj2['sav_cat'] == 'put_in').astype(float)
mx['saver'] = (mx['sav_cat'] == 'put_in').astype(float)

print('=== SUMMARY ==='); print('Rows:', len(df))
for c in ['BMI81', 'BMI89', 'BMI92', 'dBMI_81_92', 'obese92']:
    s = df[c].dropna()
    print(f'{c:12s} N={len(s):6d} med={s.median():5.1f} mean={s.mean():5.1f} obese%={(s>=30).mean()*100:4.1f}')
print('Savings dir categories:'); print(df['sav_cat'].value_counts(dropna=False))
print('N reports:')
print(f'  [full file] N={len(df)}')
print(f'  [maximal bivariate: BMI92+sav_dir nonnull] N={len(mx)}  (BMI81 missing={mx["BMI81"].isna().sum()})')
print(f'  [adjusted sample] N={len(adj2)}  (lost {len(df)-len(adj2)} = {100*(len(df)-len(adj2))/len(df):.1f}% of file)')
comp = pd.DataFrame({
    'full': [df['female'].mean(), df['race_black'].mean(), df['age89'].mean(), df['BMI81'].mean(),
             df['BMI89'].mean(), df['BMI92'].mean(), df['sav_cat'].eq('put_in').mean()],
    'adj_sample': [adj2['female'].mean(), adj2['race_black'].mean(), adj2['age89'].mean(),
                   adj2['BMI81'].mean(), adj2['BMI89'].mean(), adj2['BMI92'].mean(), adj2['sav_cat'].eq('put_in').mean()]},
    index=['female', 'black', 'age89', 'BMI81', 'BMI89', 'BMI92', 'pct_put_in']).round(3)
print('Analytic(adj) vs full-file on observables:')
print(comp)

DP = 'd_no_change + d_took_out + d_no_savings'  # put_in = reference
ADJ = ' + '.join(adjvars)

print('\n=== BMI 1992 vs SAVINGS DIRECTION (PRIMARY PROXY) ===')
print('Raw BMI-92 means by savings category (maximal N=%d):' % len(mx))
print(mx.groupby('sav_cat')['BMI92'].agg(['mean', 'median', 'count']).round(2))
X = mx[['tp_ord']].dropna(); m0 = sm.OLS(mx.loc[X.index, 'BMI92'], sm.add_constant(X)).fit()
print(f'BIVAR trend BMI92~impatience_order(0..3): b={m0.params["tp_ord"]:.3f} (SE {m0.bse["tp_ord"]:.3f}, p={m0.pvalues["tp_ord"]:.2e}), N={len(X)}')

m_b = smf.ols('BMI92 ~ ' + DP, data=mx).fit()
print(f'BIVARIATE category model (ref=put_in), N={m_b.nobs:.0f}:')
for lab in ['no_change', 'took_out', 'no_savings']:
    p = 'd_' + lab; c = m_b.conf_int().loc[p]
    print(f'  {lab:10s} vs put_in: b={m_b.params[p]:+6.3f} CI=[{c[0]:+.3f},{c[1]:+.3f}] p={m_b.pvalues[p]:.3f}')

m_adj = smf.ols('BMI92 ~ ' + DP + ' + ' + ADJ, data=adj2).fit()
print(f'FULLY-ADJUSTED category model (ref=put_in; incl BMI81 baseline), N={m_adj.nobs:.0f}, R2={m_adj.rsquared_adj:.3f}:')
for lab in ['no_change', 'took_out', 'no_savings']:
    p = 'd_' + lab; c = m_adj.conf_int().loc[p]
    print(f'  {lab:10s} vs put_in: b={m_adj.params[p]:+6.3f} CI=[{c[0]:+.3f},{c[1]:+.3f}] p={m_adj.pvalues[p]:.3f}')

m_sv = smf.ols('BMI92 ~ saver + ' + ADJ, data=adj2).fit()
cs = m_sv.conf_int().loc['saver']
print(f'FULLY-ADJUSTED saver(put_in) vs not: b={m_sv.params["saver"]:+.3f} CI=[{cs[0]:+.3f},{cs[1]:+.3f}] p={m_sv.pvalues["saver"]:.4f}')

print('\n=== DELTA BMI 1981->1992 (proxy<=1989; no baseline control) ===')
m_d = smf.ols('dBMI_81_92 ~ ' + DP + ' + ' + ADJ.replace('BMI81 + ', ''), data=adj2).fit()
print(f'N={m_d.nobs:.0f}')
for lab in ['no_change', 'took_out', 'no_savings']:
    p = 'd_' + lab; c = m_d.conf_int().loc[p]
    print(f'  {lab:10s} vs put_in: b={m_d.params[p]:+6.3f} CI=[{c[0]:+.3f},{c[1]:+.3f}] p={m_d.pvalues[p]:.3f}')

print('\n=== OBESITY (BMI>=30) 1992, GLM binomial (sample_id omitted: separation) ===')
obadj = adj2.dropna(subset=['obese92'])
m_l = smf.glm('obese92 ~ ' + DP + ' + ' + ' + '.join([v for v in adjvars if v != 'C(sample_id)']),
              data=obadj, family=sm.families.Binomial()).fit()
print(f'N={m_l.nobs:.0f}')
for lab in ['no_change', 'took_out', 'no_savings']:
    p = 'd_' + lab; c = m_l.conf_int().loc[p]
    print(f'  {lab:10s} vs put_in: OR={np.exp(m_l.params[p]):.3f} CI=[{np.exp(c[0]):.3f},{np.exp(c[1]):.3f}] p={m_l.pvalues[p]:.3f}')

print('\n=== SECONDARY: BMI 1989 (contemporaneous with 1989 savings) ===')
d89 = df.dropna(subset=['BMI89', 'sav_dir', 'BMI81', 'female', 'race_black', 'race_hisp', 'age89',
                        'educ79', 'log_inc89', 'mom_edu', 'dad_edu', 'famsize', 'asvab_z']).copy()
for lab in ['no_change', 'took_out', 'no_savings']:
    d89['d_' + lab] = (d89['sav_cat'] == lab).astype(float)
m89 = smf.ols('BMI89 ~ ' + 'd_no_change + d_took_out + d_no_savings + ' + ADJ, data=d89).fit()
print(f'N={m89.nobs:.0f}')
for lab in ['no_change', 'took_out', 'no_savings']:
    p = 'd_' + lab; c = m89.conf_int().loc[p]
    print(f'  {lab:10s} vs put_in: b={m89.params[p]:+6.3f} CI=[{c[0]:+.3f},{c[1]:+.3f}] p={m89.pvalues[p]:.3f}')

print('\n=== SECONDARY: WEALTH-FOR-INCOME (asinh(wealth90) residualized on income89) ===')
dW = df.dropna(subset=['asinh_wealth90', 'log_inc89', 'age89', 'female', 'educ79']).copy()
dW['wf_res'] = smf.ols('asinh_wealth90 ~ log_inc89 + age89 + female + educ79', data=dW).fit().resid
dW = dW.dropna(subset=['BMI92', 'wf_res', 'BMI81', 'race_black', 'race_hisp', 'mom_edu', 'dad_edu', 'famsize', 'asvab_z'])
mW = smf.ols('BMI92 ~ wf_res + ' + ADJ, data=dW).fit()
cw = mW.conf_int().loc['wf_res']
print(f'wealth-for-income residual: b={mW.params["wf_res"]:+.4f} CI=[{cw[0]:+.4f},{cw[1]:+.4f}] p={mW.pvalues["wf_res"]:.3f} N={mW.nobs:.0f}')

print('\n=== SECONDARY: IMPULSIVITY/CRIMINAL ===')
dJ = df.dropna(subset=['BMI92', 'jail_any', 'BMI81', 'female', 'race_black', 'race_hisp', 'age89',
                       'educ79', 'log_inc89', 'mom_edu', 'dad_edu', 'famsize', 'asvab_z'])
mJ = smf.ols('BMI92 ~ jail_any + ' + ADJ, data=dJ).fit()
cj = mJ.conf_int().loc['jail_any']
print(f'jail_any 81-92: prev={(dJ["jail_any"]==1).mean()*100:.2f}% b={mJ.params["jail_any"]:+.3f} CI=[{cj[0]:+.3f},{cj[1]:+.3f}] p={mJ.pvalues["jail_any"]:.3f} N={mJ.nobs:.0f}')
dS = df.dropna(subset=['BMI92', 'ever_sent', 'BMI81', 'female', 'race_black', 'race_hisp', 'age89',
                       'educ79', 'log_inc89', 'mom_edu', 'dad_edu', 'famsize', 'asvab_z'])
mS = smf.ols('BMI92 ~ ever_sent + ' + ADJ, data=dS).fit()
cse = mS.conf_int().loc['ever_sent']
print(f'ever_sentenced<1980: prev={(dS["ever_sent"]==1).mean()*100:.2f}% b={mS.params["ever_sent"]:+.3f} CI=[{cse[0]:+.3f},{cse[1]:+.3f}] p={mS.pvalues["ever_sent"]:.3f} N={mS.nobs:.0f}')

print('\n=== COMPOSITE (robustness only; impatience - wealth_res + jail) ===')
dC = df.dropna(subset=['BMI92', 'tp_ord', 'asinh_wealth85', 'log_inc79', 'jail_any', 'BMI81',
                       'female', 'race_black', 'race_hisp', 'age89', 'educ79', 'log_inc89',
                       'mom_edu', 'dad_edu', 'famsize', 'asvab_z']).copy()
def z(x): return (x - x.mean()) / x.std()
dC['tp_z'] = z(dC['tp_ord'])
dC['w85res'] = smf.ols('asinh_wealth85 ~ log_inc79 + age89 + female + educ79', data=dC).fit().resid
dC['comp'] = dC['tp_z'] - z(dC['w85res']) + z(dC['jail_any'])
mC = smf.ols('BMI92 ~ comp + ' + ADJ, data=dC).fit()
cc = mC.conf_int().loc['comp']
print(f'composite: b={mC.params["comp"]:+.3f} CI=[{cc[0]:+.3f},{cc[1]:+.3f}] p={mC.pvalues["comp"]:.3f} N={mC.nobs:.0f}')

print('\n=== CONSISTENCY ACROSS PROXY BATTERY (positive = more impatience -> higher BMI) ===')
rows = [
    ('savings_order_bivar', m0.params['tp_ord'], m0.pvalues['tp_ord']),
    ('took_out_vs_put_in_adj', m_adj.params['d_took_out'], m_adj.pvalues['d_took_out']),
    ('no_savings_vs_put_in_adj', m_adj.params['d_no_savings'], m_adj.pvalues['d_no_savings']),
    ('saver_vs_not_adj', -m_sv.params['saver'], m_sv.pvalues['saver']),
    ('wealth_for_income_adj', -mW.params['wf_res'], mW.pvalues['wf_res']),
    ('jail_any_adj', mJ.params['jail_any'], mJ.pvalues['jail_any']),
    ('ever_sent_adj', mS.params['ever_sent'], mS.pvalues['ever_sent']),
    ('composite_adj', mC.params['comp'], mC.pvalues['comp']),
]
con = pd.DataFrame(rows, columns=['proxy', 'b', 'p']).set_index('proxy').round(3)
print(con)
npos = int(con['b'].gt(0).sum()); ntot = int(con['b'].notna().sum())
print(f'Proxies with positive (impatience -> higher BMI) sign: {npos}/{ntot}')
con.to_csv('proxy_estimates.csv')
adj2[['BMI92', 'BMI81', 'BMI89', 'tp_ord', 'log_inc89']].describe().round(2).to_csv('analytic_sample_desc.csv')
print('\n=== DONE ===')
