"""
Planet/Activity separation task (asibench:astronomy.planet_activity_sep).

Recover latent summary (component A + background B + offset) and predict
component-A-only future values.

Model per task summary (reference epoch ref from input_0.json):
  obs_0(t) = a1*sin(2*pi*(t-ref)/P_A) + a2*cos(2*pi*(t-ref)/P_A)
           + b1*sin(2*pi*(t-ref)/P_B) + b2*cos(2*pi*(t-ref)/P_B)
           + b3*sin(4*pi*(t-ref)/P_B) + b4*cos(4*pi*(t-ref)/P_B)
           + offset

Pipelines:
  1. Read inputs.
  2. For each case estimate (P_A, P_B) on obs_0 by a coarse 2-D least-squares
     grid over periods followed by local refinement.
  3. Fit B-only (no A) model and full model; decide component_a_present with an
     F-test AND an amplitude-vs-noise threshold.
  4. Build signal_summary.csv (exact 11 columns, case_order from input_0.json)
     and target_predictions.csv (exact 3 columns, input_2 row order, zeros for
     absent component A).
"""
import json
import numpy as np
import pandas as pd
from scipy import stats

# ---------------------------------------------------------------- read inputs
with open("data/input_0.json") as f:
    meta = json.load(f)
ref = float(meta["reference_epoch_day"])
case_order = meta["case_order"]

df1 = pd.read_csv("data/input_1.csv")
df2 = pd.read_csv("data/input_2.csv")

# ------------------------------------------------------------- model helpers
def design_b(t, P_B):
    """B fundamental + first harmonic + offset columns (task semantics)."""
    return np.column_stack([
        np.sin(2 * np.pi * (t - ref) / P_B),
        np.cos(2 * np.pi * (t - ref) / P_B),
        np.sin(4 * np.pi * (t - ref) / P_B),
        np.cos(4 * np.pi * (t - ref) / P_B),
        np.ones_like(t),
    ])

def design_full(t, P_A, P_B):
    """A sinusoid + B fundamental + B harmonic + offset columns."""
    return np.column_stack([
        np.sin(2 * np.pi * (t - ref) / P_A),
        np.cos(2 * np.pi * (t - ref) / P_A),
        design_b(t, P_B),
    ])

def lsq(y, X):
    coef, _, _, _ = np.linalg.lstsq(X, y, rcond=None)
    r = y - X @ coef
    return coef, np.sum(r ** 2)

def fit_b(t, y, P_B):
    return lsq(y, design_b(t, P_B))

def fit_full(t, y, P_A, P_B):
    return lsq(y, design_full(t, P_A, P_B))

def fit_2d(t, y, lo=6.0, hi=40.0, coarse=0.3, refine=0.02, wind=0.55):
    """Coarse 2-D period grid + local refinement. Returns P_A, P_B, coef, chi2."""
    best_chi, best_PA, best_PB, best_coef = np.inf, None, None, None
    for PA in np.arange(lo, hi + coarse, coarse):
        for PB in np.arange(lo, hi + coarse, coarse):
            co, chi = fit_full(t, y, PA, PB)
            if chi < best_chi:
                best_chi, best_PA, best_PB, best_coef = chi, PA, PB, co
    for PA in np.arange(best_PA - wind, best_PA + wind, refine):
        for PB in np.arange(best_PB - wind, best_PB + wind, refine):
            co, chi = fit_full(t, y, PA, PB)
            if chi < best_chi:
                best_chi, best_PA, best_PB, best_coef = chi, PA, PB, co
    return best_PA, best_PB, best_coef, best_chi

def best_b(t, y):
    best_chi, best_P, best_coef = np.inf, None, None
    for P in np.arange(4.0, 90.0, 0.1):
        co, chi = fit_b(t, y, P)
        if chi < best_chi:
            best_chi, best_P, best_coef = chi, P, co
    for P in np.arange(best_P - 0.3, best_P + 0.3, 0.005):
        co, chi = fit_b(t, y, P)
        if chi < best_chi:
            best_chi, best_P, best_coef = chi, P, co
    return best_P, best_coef, best_chi

# ------------------------------------------------------------- per-case solve
summary = []
predict_rows = []
noise_by_case = {}

for cid in case_order:
    g = df1[df1["case_id"] == cid]
    if g.empty:
        raise RuntimeError(f"case {cid} missing in input_1.csv")
    t = g["time_day"].to_numpy(float)
    y = g["obs_0"].to_numpy(float)
    n = len(t)
    sigma = float(np.median(g["obs_0_err"].to_numpy(float)))
    noise_by_case[cid] = sigma

    # 2-D period estimation (full model)
    P_A, P_B, coef_full, chi_full = fit_2d(t, y)
    a1, a2, b1, b2, b3, b4, off = coef_full
    amp_A = np.hypot(a1, a2)

    # B-only best for F-test
    P_Bb, coef_bonly, chi_bonly = best_b(t, y)

    # component A presence: F-test AND amplitude above ~1.5*noise
    F = ((chi_bonly - chi_full) / 2.0) / (chi_full / (n - 7))
    p = float(1 - stats.f.cdf(F, 2, n - 7))
    present = int((p < 0.01) and (amp_A > 1.5 * sigma))

    print(f"== {cid}: n={n} sigma={sigma:.3f} P_A={P_A:.4f} P_B={P_B:.4f} "
          f"chi_full={chi_full:.2f} chi_bonly={chi_bonly:.2f} F={F:.1f} p={p:.2e} "
          f"A_amp={amp_A:.3f} -> present={present}")

    if present:
        a1_out, a2_out, PA_out = a1, a2, P_A
    else:
        a1_out, a2_out, PA_out = 0.0, 0.0, 0.0
        b1, b2, b3, b4, off = coef_bonly
        P_B = P_Bb

    summary.append({
        "case_id": cid,
        "component_a_present": present,
        "component_a_period_day": PA_out,
        "component_a_basis1_u0": a1_out,
        "component_a_basis2_u0": a2_out,
        "component_b_period_day": P_B,
        "component_b_basis1_u0": b1,
        "component_b_basis2_u0": b2,
        "component_b_basis3_u0": b3,
        "component_b_basis4_u0": b4,
        "offset_u0": off,
    })

    # future component-A-only predictions at input_2 times (row order preserved)
    g2 = df2[df2["case_id"] == cid]
    for _, row in g2.iterrows():
        tt = float(row["time_day"])
        aval = 0.0
        if present:
            aval = (a1 * np.sin(2 * np.pi * (tt - ref) / P_A)
                    + a2 * np.cos(2 * np.pi * (tt - ref) / P_A))
        predict_rows.append({"case_id": cid, "time_day": tt,
                             "component_a_value_u0": aval})

# ------------------------------------------------------------- write outputs
summary_cols = [
    "case_id", "component_a_present", "component_a_period_day",
    "component_a_basis1_u0", "component_a_basis2_u0",
    "component_b_period_day", "component_b_basis1_u0",
    "component_b_basis2_u0", "component_b_basis3_u0",
    "component_b_basis4_u0", "offset_u0",
]
df_s = pd.DataFrame(summary, columns=summary_cols)
df_p = pd.DataFrame(predict_rows, columns=[
    "case_id", "time_day", "component_a_value_u0"])

df_s.to_csv("signal_summary.csv", index=False)
df_p.to_csv("target_predictions.csv", index=False)

print("\n--- signal_summary.csv ---")
print(df_s.to_string(index=False))
print("\n--- target_predictions.csv preview ---")
print(df_p.head(12).to_string(index=False))
print(f"\nrows summary={len(df_s)} (must be 4)  rows predictions={len(df_p)} "
      f"(must be {len(df2)})")
