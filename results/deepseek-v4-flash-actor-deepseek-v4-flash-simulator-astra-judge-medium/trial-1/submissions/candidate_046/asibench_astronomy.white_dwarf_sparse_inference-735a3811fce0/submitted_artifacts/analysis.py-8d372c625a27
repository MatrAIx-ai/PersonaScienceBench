ext_den_q = np.zeros_like(r_grid); ext_menc_q = np.zeros_like(r_grid)
for i, mt in enumerate(prof_masses):
    dens, menc = interp_at(mt)
    prof_dens[i] = dens; prof_menc[i] = menc
    if mt == max(prof_masses):
        ext_den_q[:], ext_menc_q[:] = dens, menc

# cross-check for the most uncertain mass (1.3): blend data-trend with polytrope
prof_dens[2] = 0.5 * ext_den_q + 0.5 * poly13_den
prof_menc[2] = 0.5 * ext_menc_q + 0.5 * poly13_menc
prof_dens[2] = isotonic_regression(prof_dens[2], increasing=False).x
prof_menc[2] = isotonic_regression(prof_menc[2], increasing=True).x
prof_dens[2, 0] = 1.0; prof_dens[2, -1] = SURF_THRESH
prof_menc[2, 0] = 0.0; prof_menc[2, -1] = 1.0

