class Canvas:
    def __init__(self, w, h, bg=(255,255,255,255)):
        self.w=int(w); self.h=int(h)
        self.img = np.zeros((self.h, self.w, 4), dtype=np.uint8)
        self.img[:] = bg

    def _blend(self, y, x, color):
        if y<0 or x<0 or y>=self.h or x>=self.w: return
        c = np.asarray(color, dtype=np.float64)/255.0
        a = c[3]
        cur = self.img[y,x].astype(np.float64)/255.0
        out = a*c[:3] + (1-a)*cur[:3]
        self.img[y,x,:3] = np.clip(out*255,0,255).astype(np.uint8)
        self.img[y,x,3] = 255

    def dot(self, x, y, r, color):
        y,x = float(y), float(x)
        for j in range(int(np.floor(y-r)), int(np.ceil(y+r))+1):
            for i in range(int(np.floor(x-r)), int(np.ceil(x+r))+1):
                if (i-x)**2+(j-y)**2 <= r*r:
                    self._blend(j,i,color)

    def line(self, x0, y0, x1, y1, width, color):
        dx, dy = float(x1-x0), float(y1-y0)
        L = np.hypot(dx,dy)
        if L < 1e-6:
            self.dot(x0,y0,width/2,color); return
        n = max(2, int(L*1.5))
        sgx, sgy = dx/n, dy/n
        xmin = max(0,int(np.floor(min(x0,x1)-width-1))); xmax = min(self.w-1,int(np.ceil(max(x0,x1)+width+1)))
        ymin = max(0,int(np.floor(min(y0,y1)-width-1))); ymax = min(self.h-1,int(np.ceil(max(y0,y1)+width+1)))
        if xmax<xmin or ymax<ymin: return
        px, py = np.meshgrid(np.arange(xmin,xmax+1,dtype=np.float64), np.arange(ymin,ymax+1,dtype=np.float64))
        for k in range(n):
            sx = x0 + k*sgx; sy = y0 + k*sgy
            t = ((px-sx)*sgx + (py-sy)*sgy)/(sgx**2+sgy**2)
            t = np.clip(t,0,1)
            d = np.hypot(px-(sx+t*sgx), py-(sy+t*sgy))
            ys_, xs_ = np.nonzero(d <= width/2.0)
            for jj,ii in zip(ys_, xs_):
                self._blend(int(jj+ymin), int(ii+xmin), color)
        self.dot(x0,y0,width/2,color); self.dot(x1,y1,width/2,color)

    def polyline(self, xs, ys, width, color):
        for i in range(len(xs)-1):
            self.line(xs[i],ys[i],xs[i+1],ys[i+1],width,color)

    def text(self, x, y, s, color, scale=1):
        cx, cy = int(x), int(y)
        for ch in s:
            g = _F.get(ch, _F[' '])
            for r in range(7):
                row = g[r]
                for c_ in range(5):
                    if row[c_]:
                        for sy in range(scale):
                            for sx in range(scale):
                                self._blend(cy+r*scale+sy, cx+c_*scale+sx, color)
            cx += 6*scale

    def text_center(self, cx, y, s, color, scale=1):
        self.text(cx - len(s)*6*scale/2, y, s, color, scale)

def save_png(path, img):
    h,w = img.shape[:2]
    rgb = img[:, :, :3]
    raw = bytearray()
    for r in range(h):
        raw.append(0)
        raw.extend(rgb[r].tobytes())   # C-order: R,G,B interleaved per pixel
    def chunk(typ, data):
        c = struct.pack('>I', len(data)) + typ + data
        c += struct.pack('>I', zlib.crc32(typ+data)&0xffffffff)
        return c
    ihdr = struct.pack('>IIBBBBB', w, h, 8, 2, 0, 0, 0)
    out = b'\x89PNG\r\n\x1a\n'
    out += chunk(b'IHDR', ihdr)
    out += chunk(b'IDAT', zlib.compress(bytes(raw), 9))
    out += chunk(b'IEND', b'')
    with open(path,'wb') as f: f.write(out)

def load_back_png(path):
    d = open(path,'rb').read()
    assert d[:8]==b'\x89PNG\r\n\x1a\n'
    pos = 8
    while pos < len(d):
        ln = int.from_bytes(d[pos:pos+4],'big'); typ = d[pos+4:pos+8]
        if typ==b'IHDR': return struct.unpack('>II', d[pos+8:pos+16])
        pos += 12+ln



