def mr_family(M, p):
    C, a, Mch, b, c = p
    x = (M / Mch) ** b
    return C * M ** (-a) * (1.0 - x) ** c

def dr_dm_family(M, p):
    C, a, Mch, b, c = p
    M = np.asarray(M, float)
    x = (M / Mch) ** b
    R = mr_family(M, p)
    return R * (-a / M - (c * b * x) / (M * (1.0 - x)))

def fit_mr(M, R, sR, sM, fixed=None, free=(0, 1, 2), p0=(8926.0, 0.294, 1.3989)):
    """Weighted fit of the Chandrasekhar-family R=C*M^-a*(1-(M/Mch)^b)^c,
    anchored to the physical exponents b=4/3, c=1/2 (relativistic correction).
    Default free params: C, a, Mch (index 0,1,2). Returns full 5-vector."""
    fixed = dict(fixed or {})
    def build(pv):
        p = [None] * 5
        p[3] = 4.0 / 3.0
        p[4] = 0.5
        for i, v in fixed.items():
            p[i] = v
        for j, i in enumerate(free):
            p[i] = pv[j]
        return p
    def resid(pv):
        p = build(pv)
        if p[2] is None or p[2] <= np.max(M) * 0.999:
            return np.full_like(M, 1e6)
        sig = np.sqrt(sR ** 2 + (dr_dm_family(M, p) * sM) ** 2)
        return (mr_family(M, p) - R) / sig
    sol = least_squares(resid, np.asarray(p0, float), max_nfev=40000)
    return np.asarray(build(sol.x), float)

def smooth_taper(M, mmin, mmax, edge=0.045):
    w = np.ones_like(M, float)
    l0, l1 = mmin, mmin + edge
    r0, r1 = mmax - edge, mmax
    for i, m in enumerate(M):
        if m <= l0:
            w[i] = 0.0
        elif m < l1:
            t = (m - l0) / (l1 - l0); w[i] = t * t * (3 - 2 * t)
        elif m <= r0:
            w[i] = 1.0
        elif m < r1:
            t = (m - r0) / (r1 - r0); w[i] = 1 - t * t * (3 - 2 * t)
        else:
            w[i] = 0.0
    return w

# --- global family fit to set the mass limit + tail ---
p_glob = fit_mr(M_obs, R_obs, sR_obs, sM_obs)
Mch = float(p_glob[2])

def residual_correction(M_line):
    """Fit smoothed spline to residuals, taper to zero outside observed band,
    keep the corrected curve strictly decreasing (fallback = pure family)."""
    Rf_obs = mr_family(M_obs, p_glob)
    res = R_obs - Rf_obs
    sig = np.sqrt(sR_obs ** 2 + (dr_dm_family(M_obs, p_glob) * sM_obs) ** 2)
    Rfit_line = mr_family(M_line, p_glob)
    tau = smooth_taper(M_line, M_obs.min(), M_obs.max())
    s_spl = 0.6 * np.sum(sig ** 2)
    best = (Rfit_line, np.zeros_like(M_line), s_spl, False)
    for _ in range(8):
        try:
            spl = UnivariateSpline(M_obs, res, w=1.0 / np.maximum(sig, 1e-2), s=s_spl, k=3)
        except Exception:
            s_spl *= 2.0; continue
        g_line = spl(M_line) * tau
        r_test = Rfit_line + g_line
        tt = np.linspace(0.24, 0.9990 * Mch, 6000)
        rr = mr_family(tt, p_glob) + spl(tt) * smooth_taper(tt, M_obs.min(), M_obs.max())
        if np.all(np.diff(rr) < 0) and np.all(rr > 0):
            best = (r_test, g_line, s_spl, True)
            break
        s_spl *= 2.0
    return best

