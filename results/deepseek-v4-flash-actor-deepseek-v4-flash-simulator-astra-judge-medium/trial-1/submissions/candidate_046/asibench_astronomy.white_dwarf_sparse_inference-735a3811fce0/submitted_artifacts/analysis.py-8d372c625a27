        dd, mm = polytrope_profiles(n, r_grid)
        cost = np.mean((dd - dv) ** 2) + 0.5 * np.mean((mm - mv) ** 2)
        if cost < bc:
            bc, best = cost, n
    ns_obs.append(best)
