def monotone_spline(fr, vals, increasing):
    keep = np.isfinite(vals)
    fr, vals = fr[keep], vals[keep]
    order = np.argsort(fr)
    fr, vals = fr[order], vals[order]
    iso = isotonic_regression(vals, increasing=increasing).x
    return PchipInterpolator(fr, iso, extrapolate=False)

frag_masses = sorted(pf['target_mass_solar'].unique())
frag_den, frag_menc = {}, {}
for fm in frag_masses:
    sub = pf[pf['target_mass_solar'] == fm]
