# --- mass interpolation on the radius grid ---
def interp_at(Mt):
    dens = np.zeros_like(r_grid); menc = np.zeros_like(r_grid)
    if Mt <= frag_masses[0]:
        dens = frag_den[frag_masses[0]](r_grid); menc = frag_menc[frag_masses[0]](r_grid)
    elif Mt >= frag_masses[-1]:
        for k in range(len(r_grid)):
            dv = np.array([frag_den[f](r_grid[k]) for f in frag_masses])
            dens[k] = np.polyval(np.polyfit(frag_masses, dv, 2), Mt)
            mv = np.array([frag_menc[f](r_grid[k]) for f in frag_masses])
            menc[k] = np.polyval(np.polyfit(frag_masses, mv, 2), Mt)
        dens = np.clip(dens, 0.0, 1.0); menc = np.clip(menc, 0.0, 1.0)
        dens = isotonic_regression(dens, increasing=False).x
        menc = isotonic_regression(menc, increasing=True).x
    else:
        lo = frag_masses[[i for i, f in enumerate(frag_masses) if f < Mt][-1]]
        hi = next(f for f in frag_masses if f > Mt)
        t = (Mt - lo) / (hi - lo)
        dens = (1 - t) * frag_den[lo](r_grid) + t * frag_den[hi](r_grid)
        menc = (1 - t) * frag_menc[lo](r_grid) + t * frag_menc[hi](r_grid)
    dens[0] = 1.0; dens[-1] = SURF_THRESH
    menc[0] = 0.0; menc[-1] = 1.0
    return dens, menc

