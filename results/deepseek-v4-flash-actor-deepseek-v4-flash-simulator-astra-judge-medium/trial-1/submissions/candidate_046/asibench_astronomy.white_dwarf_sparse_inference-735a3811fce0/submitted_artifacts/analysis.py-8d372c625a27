# --- calibrated Lane-Emden polytrope helper ---
def lane_emden(n, xi_max=40.0):
    def deriv(xi, y):
        th, dth = y
        xim = max(xi, 1e-9)
        return [dth, -2.0 * dth / xim - th ** n]
    def surface(xi, y):
        return y[0] - 1e-5
    surface.terminal = True; surface.direction = -1
    with contextlib.redirect_stderr(io.StringIO()):
        sol = solve_ivp(deriv, [1e-5, xi_max], [1.0 - 1e-10, -1e-5],
                        method='RK45', rtol=1e-9, atol=1e-12, events=surface,
                        max_step=0.02, dense_output=False)
    xi = sol.t; th = sol.y[0]; dth = sol.y[1]
    xi1 = float(sol.t_events[0][0]) if sol.t_events[0].size else float(xi[-1])
    xi = np.concatenate([xi, [xi1]])
    th = np.concatenate([th, [0.0]])
    dth = np.concatenate([dth, [dth[-1]]])
    return xi, th, dth, xi1

def polytrope_profiles(n, rgrid):
    xi, th, dth, xi1 = lane_emden(n)
    dens_fr = np.interp(rgrid * xi1, xi, np.maximum(th, 0.0) ** n)
    dth1 = -dth[-1]
    m = np.where(xi > 0, xi ** 2 * (-dth) / (xi1 ** 2 * dth1), 0.0)
    menc = np.interp(rgrid * xi1, xi, m)
    return dens_fr, menc

# calibrate effective polytrope index at each fragment mass
