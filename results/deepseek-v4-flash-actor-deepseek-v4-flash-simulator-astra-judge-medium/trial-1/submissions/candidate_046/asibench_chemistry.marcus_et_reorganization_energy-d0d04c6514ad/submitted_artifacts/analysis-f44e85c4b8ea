    _line(img, box3[0], box3[3], box3[2], box3[3], _BLACK, 1)
    _line(img, box3[0], box3[1], box3[0], box3[3], _BLACK, 1)
    rxx = lambda v: box3[0] + (v-xminr)/(xmaxr-xminr)*(box3[2]-box3[0])
    ryy = lambda v: box3[3] - (v-yminr)/(ymaxr-yminr)*(box3[3]-box3[1])
    for t in _ticks(xminr, xmaxr, 6):
        px = int(rxx(t)); _line(img, px, box3[3], px, box3[3]+4, _BLACK, 1)
        _txt(img, px-14, box3[3]+6, _fmt(t), _BLACK)
    for t in _ticks(yminr, ymaxr, 5):
        py = int(ryy(t)); _line(img, box3[0]-4, py, box3[0], py, _BLACK, 1)
        _txt(img, box3[0]-60, py-4, _fmt(t), _BLACK)
    pts = [(rxx(v), ryy(y)) for v, y in zip(srt_x, srt_y)]
    for i in range(1, len(pts)):
        _line(img, pts[i-1][0], pts[i-1][1], pts[i][0], pts[i][1], _BLACK, 1)
    for px, py in pts:
        _circ(img, int(px), int(py), 2, (0, 0, 0))
    for v, c, lbl in ((-lam_total, _GRAY, "-lambda_total"), (peak_axis, _GREEN, "peak")):
        px = int(rxx(v)); _line(img, px, box3[1], px, box3[3], c, 1)
        _txt(img, px+3, box3[1]+4, lbl, c)
    if first_inv is not None:
        px = int(rxx(first_inv[1])); _line(img, px, box3[1], px, box3[3], _RED, 1)
        _txt(img, px+3, box3[1]+18, "inverted", _RED)
    _txt(img, box3[0], box3[3]+22, "driving force axis (eV)", _BLACK)
    _txt(img, 10, (box3[1]+box3[3])//2, "log10 k_et (s^-1)", _BLACK)
    _txt(img, box3[0], box3[1]-16, "semiclassical Marcus rate curve", _BLACK)

    # panel 4: reorganization summary
    box4 = (620, 430, 1120, 730)
    labels = ["inner/fwd", "inner/bwd", "inner/eff", "outer", "total"]
    vals = [lam_4pt_f, lam_4pt_b, lam_inner_effective, lam_outer, lam_total]
    colors = [_BLUE, _CYAN, _GREEN, _ORANGE, _RED]
    vmax = max(vals)*1.15
    _line(img, box4[0], box4[3], box4[2], box4[3], _BLACK, 1)
    _line(img, box4[0], box4[1], box4[0], box4[3], _BLACK, 1)
    syy = lambda v: box4[3] - v/vmax*(box4[3]-box4[1])
    n = len(vals)
    bw = (box4[2]-box4[0])/n*0.6
    for i, v in enumerate(vals):
        cxx = box4[0] + (i+0.5)/n*(box4[2]-box4[0])
        _frect(img, int(cxx-bw/2), int(syy(v)), int(cxx+bw/2), int(box4[3]), colors[i])
        _txt(img, int(cxx-10), int(syy(v))-14, _fmt(v), _BLACK)
        _txt(img, int(cxx-bw), box4[3]+8, labels[i], _BLACK)
    for t in _ticks(0, vmax, 4):
        py = int(syy(float(t))); _line(img, box4[0]-4, py, box4[0], py, _BLACK, 1)
        _txt(img, box4[0]-46, py-4, _fmt(t), _BLACK)
    _txt(img, box4[0], box4[1]-16, "reorganization energy (eV)", _BLACK)

    _write_png(path, img)

