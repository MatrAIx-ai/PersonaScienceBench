    bary = lambda v: box2[3] - v/maxc*(box2[3]-box2[1])
    for i in range(15):
        cx0 = box2[0] + (i+0.5)/15*(box2[2]-box2[0])
        bw = 0.25*(box2[2]-box2[0])/15
        vf, vb = float(contrib_f[i]), float(contrib_b[i])
        _frect(img, int(cx0-bw), int(bary(vf)), int(cx0), int(box2[3]), _BLUE)
        _frect(img, int(cx0), int(bary(vb)), int(cx0+bw), int(box2[3]), _RED)
    for t in _ticks(0, maxc, 4):
        py = int(bary(float(t))); _line(img, box2[0]-4, py, box2[0], py, _BLACK, 1)
        _txt(img, box2[0]-52, py-4, _fmt(t), _BLACK)
    _txt(img, box2[0], box2[3]+22, "retained mode", _BLACK)
    _txt(img, 585, (box2[1]+box2[3])//2, "0.5 w^2 p^2 (eV)", _BLACK)
    _txt(img, box2[0], box2[1]-16, "per-mode reorganization  blue fwd / red bwd", _BLACK)

    # panel 3: rate curve (axis-sorted)
    box3 = (60, 430, 560, 730)
    xminr, xmaxr = min(srt_x), max(srt_x)
