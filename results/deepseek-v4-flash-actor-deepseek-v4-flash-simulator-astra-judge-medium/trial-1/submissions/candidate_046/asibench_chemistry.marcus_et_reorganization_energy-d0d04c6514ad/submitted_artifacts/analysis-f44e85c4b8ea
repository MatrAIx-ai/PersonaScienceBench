def _txt(img, x, y, s, color, scale=1):
    H, W, _ = img.shape
    cx = x
    for ch in s.upper():
        pat = _FONT2.get(ch, _FONT2[' '])
        for r in range(7):
            row = pat[r]
            for c in range(5):
                if row[c] == '#':
                    for dy in range(scale):
                        for dx in range(scale):
                            px, py = cx + c*scale + dx, y + r*scale + dy
                            if 0 <= px < W and 0 <= py < H:
                                img[py, px] = color
        cx += 6 * scale

def _line(img, x0, y0, x1, y1, color, th=1):
    H, W, _ = img.shape
    x0, y0, x1, y1 = int(x0), int(y0), int(x1), int(y1)
    dx, dy = abs(x1-x0), abs(y1-y0)
    sx, sy = (1 if x0 < x1 else -1), (1 if y0 < y1 else -1)
    err = dx - dy
    while True:
        for ox in range(-(th//2), th - th//2):
            for oy in range(-(th//2), th - th//2):
                px, py = x0+ox, y0+oy
                if 0 <= px < W and 0 <= py < H:
                    img[py, px] = color
        if x0 == x1 and y0 == y1:
            break
        e2 = 2*err
        if e2 > -dy:
            err -= dy; x0 += sx
        if e2 < dx:
            err += dx; y0 += sy

def _frect(img, x0, y0, x1, y1, color):
    H, W, _ = img.shape
    x0, x1 = max(0, min(x0, x1)), min(W, max(x0, x1))
    y0, y1 = max(0, min(y0, y1)), min(H, max(y0, y1))
    img[int(y0):int(y1), int(x0):int(x1)] = color

def _circ(img, cx, cy, r, color):
    H, W, _ = img.shape
    for dy in range(-r, r+1):
        for dx in range(-r, r+1):
            if dx*dx + dy*dy <= r*r:
                px, py = cx+dx, cy+dy
                if 0 <= px < W and 0 <= py < H:
                    img[py, px] = color

def _write_png(path, img):
    H, W, _ = img.shape
    raw = bytearray()
    for y in range(H):
        raw.append(0)
        raw.extend(img[y, :, 0].tobytes())
        raw.extend(img[y, :, 1].tobytes())
        raw.extend(img[y, :, 2].tobytes())
    def chunk(tag, data):
        c = struct.pack(">I", len(data)) + tag + data
        return c + struct.pack(">I", zlib.crc32(tag + data) & 0xffffffff)
    png = b"\x89PNG\r\n\x1a\n"
    png += chunk(b"IHDR", struct.pack(">IIBBBBB", W, H, 8, 2, 0, 0, 0))
    png += chunk(b"IDAT", zlib.compress(bytes(raw), 6))
    png += chunk(b"IEND", b"")
    with open(path, "wb") as f:
        f.write(png)

# --------------------------------------------------------------------------
# 1) Parse inputs
# --------------------------------------------------------------------------
def load_site_table():
    sites = {}
    with open(os.path.join(DATA, "site_table.csv"), newline="") as fh:
        for row in csv.DictReader(fh):
            sites[int(row["site_id"])] = float(row["mass_amu"])
    return sites, len(sites)

def load_frame_order():
    order = {"frame_a": {}, "frame_b": {}}
    with open(os.path.join(DATA, "frame_site_order.csv"), newline="") as fh:
        for row in csv.DictReader(fh):
            order[row["frame_id"]][int(row["row_index"])] = int(row["site_id"])
    return order

def frame_arrays_as_site_order(frame_id, order, sites, n_site):
    """(coords (n,3), hessian (3n,3n), masses (n,)) in ascending site_id order."""
    o = order[frame_id]
    coords = np.load(os.path.join(DATA, f"{frame_id}_coords.npy"))
    hess = np.load(os.path.join(DATA, f"{frame_id}_hessian.npy"))
    site_of_row = [o[i] for i in range(n_site)]
    asc_idx = np.argsort(site_of_row)
    coords = coords[asc_idx]
    masses = np.array([sites[site_of_row[i]] for i in range(n_site)])[asc_idx]
    perm = []
    for i in asc_idx:
        perm += [3*i, 3*i+1, 3*i+2]
    hess = hess[np.ix_(perm, perm)]
    return coords, hess, masses

def kabsch_align(P, Q):
    """Rigid alignment of P onto Q; returns R,t with aligned = P @ R.T + t."""
    Pc = P - P.mean(axis=0)
    Qc = Q - Q.mean(axis=0)
    H = Pc.T @ Qc
    U, S, Vt = np.linalg.svd(H)
    d = np.sign(np.linalg.det(Vt.T @ U.T))
    R = Vt.T @ np.diag([1.0, 1.0, d]) @ U.T
    t = Q.mean(axis=0) - R @ P.mean(axis=0)
    return R, t

def block_rotate(R, n_site):
    """Block-diagonal 3n x 3n rotation applying R to every site."""
    M = np.zeros((3*n_site, 3*n_site))
    for i in range(n_site):
        M[3*i:3*i+3, 3*i:3*i+3] = R
    return M

# --------------------------------------------------------------------------
# 2) Alignment + mass-weighted displacement (forward, backward)
# --------------------------------------------------------------------------
sites, n_site = load_site_table()
order = load_frame_order()
A, Ha, mA = frame_arrays_as_site_order("frame_a", order, sites, n_site)
B, Hb, mB = frame_arrays_as_site_order("frame_b", order, sites, n_site)
assert mA.shape == mB.shape and np.allclose(mA, mB), "site masses must match across frames"

w = np.repeat(np.sqrt(mA), 3)           # mass weighting per Cartesian coordinate

# FORWARD: frame B aligned into the frame of A; source = B, target = A
Rf, tf = kabsch_align(B, A)
Bf = B @ Rf.T + tf
dq_f_cart = (Bf - A).ravel()            # signed cartesian displacement (source - target)
dq_mw_f = dq_f_cart * w                 # mass-weighted displacement (21,)
rmsd_f = float(np.sqrt(((Bf - A) ** 2).sum(axis=1).mean()))

# BACKWARD: frame A aligned into the frame of B; source = A, target = B
Rb, tb = kabsch_align(A, B)
Ab = A @ Rb.T + tb
dq_b_cart = (Ab - B).ravel()
dq_mw_b = dq_b_cart * w
rmsd_b = float(np.sqrt(((Ab - B) ** 2).sum(axis=1).mean()))

aligned_displacement_mw = np.stack([dq_mw_f, dq_mw_b])      # (2,21)

# --------------------------------------------------------------------------
# 3) Vibrational bases (mass-weighted Hessian eigh, retain 15 modes)
# --------------------------------------------------------------------------
def mw_hessian(H, ww):
    return H / np.outer(ww, ww)

Ha_mw = mw_hessian(Ha, w)
Hb_mw = mw_hessian(Hb, w)

n_modes = 15
eigA, Ua = np.linalg.eigh(Ha_mw)
eigB, Ub = np.linalg.eigh(Hb_mw)
# discard the 6 null (translation/rotation) modes, keep the 15 resolved ones
Ua = Ua[:, -n_modes:]
Ub = Ub[:, -n_modes:]
eigA = eigA[-n_modes:]
eigB = eigB[-n_modes:]
freq_scale = 521.4708983725066          # cm^-1 per sqrt(eV/amu/A^2)
nuA = np.sqrt(np.clip(eigA, 0, None)) * freq_scale
nuB = np.sqrt(np.clip(eigB, 0, None)) * freq_scale

vibrational_basis_mw = np.stack([Ua, Ub])   # (2,21,15)

# --------------------------------------------------------------------------
# 4) Overlaps, projections, transport
# --------------------------------------------------------------------------
Pf = block_rotate(Rf, n_site)           # B modes -> A frame  (forward)
Pb = block_rotate(Rb, n_site)           # A modes -> B frame  (backward)
Ub_inA = Pf @ Ub
Ua_inB = Pb @ Ua
O_f = Ua.T @ Ub_inA                     # forward overlap (15,15)
O_b = Ua_inB.T @ Ub                     # backward overlap (15,15)
mode_overlap = np.stack([O_f, O_b])     # (2,15,15)

# signed projections of the mass-weighted displacement on each frame's modes
p_f = Ua.T @ dq_mw_f                    # forward: A = target
p_b = Ub.T @ dq_mw_b                    # backward: B = target
proj_f = Ua @ p_f                       # reconstructed displacement (21,)
proj_b = Ub @ p_b
projected_displacement_mw = np.stack([proj_f, proj_b])   # (2,21)

# mode_projection (2,15,3): [nu_cm-1, signed p, 0.5*omega^2*p^2 eV]
contrib_f = 0.5 * eigA * p_f ** 2
contrib_b = 0.5 * eigB * p_b ** 2
mode_projection = np.stack([
    np.stack([nuA, p_f, contrib_f], axis=1),
    np.stack([nuB, p_b, contrib_b], axis=1),
])                                              # (2,15,3)

# transported profiles (magnitude-based in eigenvector sign where stated)
p_onB_f = Ub_inA.T @ dq_mw_f            # source (B) projections, A frame
t_signed_f = O_f @ p_onB_f              # signed transport into A basis
t_mag_f = np.abs(O_f) @ np.abs(p_onB_f) # magnitude transport
p_onA_b = Ua_inB.T @ dq_mw_b            # source (A) projections, B frame
t_signed_b = O_b.T @ p_onA_b
t_mag_b = np.abs(O_b).T @ np.abs(p_onA_b)
transported_mode_projection = np.stack([
    np.stack([t_signed_f, t_mag_f], axis=1),
    np.stack([t_signed_b, t_mag_b], axis=1),
])                                              # (2,15,2)

# --------------------------------------------------------------------------
# 5) Reorganization summary and rate
# --------------------------------------------------------------------------
lam_4pt_f = 0.5 * float(dq_mw_f @ Ha_mw @ dq_mw_f)
lam_4pt_b = 0.5 * float(dq_mw_b @ Hb_mw @ dq_mw_b)
lam_nm_f = 0.5 * float(np.sum(eigA * p_f ** 2))
lam_nm_b = 0.5 * float(np.sum(eigB * p_b ** 2))

lam_inner_effective = 0.5 * (lam_4pt_f + lam_4pt_b)    # mean over directions

# outer-sphere reorganization: two-sphere Marcus formula from medium_response
med = json.load(open(os.path.join(DATA, "medium_response.json")))
lam_outer = (14.399645
             * (1.0/(2*med["shell_0_A"]) + 1.0/(2*med["shell_1_A"]) - 1.0/med["span_A"])
             * (1.0/med["eps_fast"] - 1.0/med["eps_slow"]))
lam_total = lam_inner_effective + lam_outer

coupling = med["coupling_eV"]
T_kelvin = med["temp_K"]
kBT = 8.617333262145e-5 * T_kelvin
hbar_eVs = 6.582119569e-16

def marcus_k(dG, lam=lam_total):
    """Semiclassical nonadiabatic Marcus rate (s^-1) at driving force dG (eV)."""
    pre = (2*math.pi/hbar_eVs) * coupling**2 / math.sqrt(4*math.pi*lam*kBT)
    return pre * math.exp(-(dG + lam)**2 / (4*lam*kBT))

k_self_exchange = marcus_k(0.0)

lambda_summary = {
    "lambda_4pt_forward_eV": lam_4pt_f,
    "lambda_4pt_backward_eV": lam_4pt_b,
    "lambda_nm_forward_eV": lam_nm_f,
    "lambda_nm_backward_eV": lam_nm_b,
    "lambda_inner_effective_eV": lam_inner_effective,
    "lambda_outer_eV": lam_outer,
    "lambda_total_eV": lam_total,
    "k_self_exchange_s_inv": k_self_exchange,
}
with open(os.path.join(RES, "lambda_summary.csv"), "w", newline="") as fh:
    wr = csv.DictWriter(fh, fieldnames=list(lambda_summary.keys()))
    wr.writeheader()
    wr.writerow(lambda_summary)

# rate curve: preserve supplied grid rows (original order) + rate columns
grid_rows = []
with open(os.path.join(DATA, "driving_force_grid.csv"), newline="") as fh:
    for row in csv.DictReader(fh):
        grid_rows.append((int(row["grid_id"]), float(row["axis_eV"])))
with open(os.path.join(RES, "rate_curve.csv"), "w", newline="") as fh:
    wr = csv.writer(fh)
    wr.writerow(["grid_id", "axis_eV", "k_et_s_inv", "log10_k_et_s_inv"])
    for gid, axis in grid_rows:
        k = marcus_k(axis)
        wr.writerow([gid, axis, k, math.log10(k)])

# --------------------------------------------------------------------------
# 6) Diagnostics
# --------------------------------------------------------------------------
srt = sorted(grid_rows, key=lambda x: x[1])
srt_k = [marcus_k(dg) for _, dg in srt]
imax = max(range(len(srt_k)), key=lambda i: srt_k[i])
peak_gid, peak_axis, peak_k = srt[imax][0], srt[imax][1], srt_k[imax]

first_inv = None
for i in range(imax - 1, -1, -1):       # branch more negative than the peak
    if srt_k[i] < peak_k:
        first_inv = srt[i]
        break
inverted_detected = first_inv is not None

axis_only = [a for _, a in grid_rows]
decreases = [i for i in range(len(axis_only)-1) if axis_only[i+1] < axis_only[i]]
grid_monotonic = len(decreases) == 0

diagnostics = {
    "alignment_rmsd_forward_A": rmsd_f,
    "alignment_rmsd_backward_A": rmsd_b,
    "closure_error_forward_eV": abs(lam_nm_f - lam_4pt_f),
    "closure_error_backward_eV": abs(lam_nm_b - lam_4pt_b),
    "effective_inner_consistency_eV": abs(lam_4pt_f - lam_4pt_b),
    "rigid_norm_forward": float(np.linalg.norm(dq_mw_f)),
    "rigid_norm_backward": float(np.linalg.norm(dq_mw_b)),
    "projected_norm_forward": float(np.linalg.norm(proj_f)),
    "projected_norm_backward": float(np.linalg.norm(proj_b)),
    "dominant_mode_forward": int(np.argmax(np.abs(p_f))),
    "dominant_mode_backward": int(np.argmax(np.abs(p_b))),
    "rate_peak_grid_id": int(peak_gid),
    "rate_peak_axis_eV": peak_axis,
    "rate_peak_s_inv": peak_k,
    "inverted_region_detected": bool(inverted_detected),
    "first_inverted_grid_id": int(first_inv[0]) if first_inv else None,
    "first_inverted_axis_eV": first_inv[1] if first_inv else None,
    # informational extras (all required keys above are present):
    "driving_force_grid_monotonic": bool(grid_monotonic),
    "driving_force_grid_nonmonotonic_first_decrease_row": decreases[0] if decreases else None,
    "driving_force_grid_nonmonotonic_decrease_count": len(decreases),
    "lambda_inner_effective_definition": "mean of directional 4pt forward/backward",
    "lambda_outer_definition": "two-sphere Marcus formula from medium_response",
    "mode_projection_columns": ["nu_cm-1", "signed_projection", "0.5*omega^2*p^2_eV"],
    "transported_mode_projection_columns": ["signed_overlap_transport", "magnitude_transport"],
}
with open(os.path.join(RES, "diagnostics.json"), "w") as fh:
    json.dump(diagnostics, fh, indent=2)

# --------------------------------------------------------------------------
# 7) Write numpy outputs
# --------------------------------------------------------------------------
np.save(os.path.join(RES, "aligned_displacement_mw.npy"), aligned_displacement_mw)
np.save(os.path.join(RES, "vibrational_basis_mw.npy"), vibrational_basis_mw)
np.save(os.path.join(RES, "mode_overlap.npy"), mode_overlap)
np.save(os.path.join(RES, "projected_displacement_mw.npy"), projected_displacement_mw)
np.save(os.path.join(RES, "transported_mode_projection.npy"), transported_mode_projection)
np.save(os.path.join(RES, "mode_projection.npy"), mode_projection)

print("core outputs written; HAS_MPL =", HAS_MPL)

