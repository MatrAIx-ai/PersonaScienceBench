# 8) overview.png
# --------------------------------------------------------------------------
_BLACK = (0, 0, 0); _BLUE = (30, 90, 200); _RED = (200, 40, 40)
_GREEN = (30, 160, 60); _ORANGE = (240, 150, 30); _CYAN = (0, 180, 180)
_GRAY = (120, 120, 120)

def _fmt(v):
    a = abs(v)
    if a >= 1e4: return f"{v:.1e}"
    if a >= 100: return f"{v:.0f}"
    if a >= 1: return f"{v:.2f}"
    return f"{v:.3f}"

def _ticks(vmin, vmax, n=5):
    return np.linspace(float(vmin), float(vmax), n)

def _overview_pure(path):
    """Pure-python overview.png (used when matplotlib is unavailable)."""
    W, H = 1150, 860
    img = np.full((H, W, 3), 255, dtype=np.uint8)
    _txt(img, W//2-200, 18, "Solution-phase electron-transfer (Marcus) overview", _BLACK, 2)

    # panel 1: aligned structures (xy projection)
    box = (60, 70, 560, 370)
    allx = np.concatenate([A[:, 0], Bf[:, 0]])
    ally = np.concatenate([A[:, 1], Bf[:, 1]])
    xmin, xmax = allx.min(), allx.max()
    ymin, ymax = ally.min(), ally.max()
    dx, dy = 0.05*(xmax-xmin) or 1.0, 0.05*(ymax-ymin) or 1.0
    xmin, xmax, ymin, ymax = xmin-dx, xmax+dx, ymin-dy, ymax+dy
    _line(img, box[0], box[3], box[2], box[3], _BLACK, 1)
    _line(img, box[0], box[1], box[0], box[3], _BLACK, 1)
    mxx = lambda v: box[0] + (v-xmin)/(xmax-xmin)*(box[2]-box[0])
    myv = lambda v: box[3] - (v-ymin)/(ymax-ymin)*(box[3]-box[1])
    for t in _ticks(xmin, xmax, 5):
        px = int(mxx(t)); _line(img, px, box[3], px, box[3]+4, _BLACK, 1)
        _txt(img, px-12, box[3]+6, _fmt(t), _BLACK)
    for t in _ticks(ymin, ymax, 4):
        py = int(myv(t)); _line(img, box[0]-4, py, box[0], py, _BLACK, 1)
        _txt(img, box[0]-50, py-4, _fmt(t), _BLACK)
    _txt(img, box[0], box[3]+22, "x (A)", _BLACK)
    _txt(img, 12, (box[1]+box[3])//2, "y (A)", _BLACK)
    for P, c in ((A, _BLUE), (Bf, _RED)):
        for k in range(P.shape[0]):
