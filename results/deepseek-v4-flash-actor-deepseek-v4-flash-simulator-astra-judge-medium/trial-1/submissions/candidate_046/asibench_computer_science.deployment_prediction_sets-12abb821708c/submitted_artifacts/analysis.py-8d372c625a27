def draw_axes_on(img, x0, y0, x1, y1, lo, hi):
    """axes within pixel box; returns mappers."""
    def fx(v): return x0 + (v - lo[0]) / (hi[0] - lo[0] + 1e-12) * (x1 - x0)
    def fy(v): return y1 - (v - lo[1]) / (hi[1] - lo[1] + 1e-12) * (y1 - y0)
    c = np.array([40, 40, 40], dtype=np.uint8)
    draw_line(img, x0, y0, x0, y1, c, 1)
    draw_line(img, x0, y1, x1, y1, c, 1)
    for i in range(3):
        v = lo[1] + (hi[1] - lo[1]) * i / 2.0
        py = int(fy(v))
        draw_line(img, x0 - 3, py, x0, py, c, 1)
        put_text(img, x0 - 28, py - 3, f"{v:.2f}", (40, 40, 40), 1)
    return fx, fy


