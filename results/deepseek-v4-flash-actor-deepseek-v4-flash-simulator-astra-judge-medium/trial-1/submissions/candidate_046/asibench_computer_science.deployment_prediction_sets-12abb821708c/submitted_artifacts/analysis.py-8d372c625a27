    put_text(img, int(fx(lo[0])) + 6, int(ty) - 14, "target_risk=0.1084", (200, 60, 60), 1)
    # tradeoff curve (x = mean deployment set size, y = transfer risk)
    cblue = (40, 80, 190)
    for j in range(len(pts) - 1):
        draw_line(img, fx(sizes[j]), fy(risks[j]), fx(sizes[j+1]), fy(risks[j+1]), cblue, 2)
    for j, b in enumerate(budgets):
        rx, ry = int(fx(sizes[j])), int(fy(risks[j]))
        fill_rect(img, rx-3, ry-3, rx+3, ry+3, cblue)
    # chosen point (budget 0.08)
    ch = min(range(len(budgets)), key=lambda j: abs(budgets[j] - GROUP_BUDGET))
    rx, ry = int(fx(sizes[ch])), int(fy(risks[ch]))
    fill_rect(img, rx-6, ry-6, rx+6, ry+6, (220, 120, 30))
    put_text(img, rx + 8, ry - 4, f"budget={GROUP_BUDGET}", (220, 120, 30), 1)
    put_text(img, 24, 12, "set-size / risk tradeoff (calibration-transfer estimate)", (20, 20, 20), 1)
    put_text(img, 24, H - 20, "mean deployment set size", (20, 20, 20), 1)
    put_text(img, 14, 210, "weighted miss risk", (20, 20, 20), 1)
    write_png(path, img)
    print("  tradeoff points (budget, risk, mean_size):",
          [(b, round(r, 4), round(s, 3)) for b, r, s in zip(budgets, risks, sizes)])


def bar_series(img, fx, fy, labels, values, color):
    n = len(labels)
    bw = 1.0 / n * 0.7
    for i, v in enumerate(values):
        cx = fx((i + 0.5) / n)
        x0 = fx((i + 0.5) / n - bw / 2.0)
        x1 = fx((i + 0.5) / n + bw / 2.0)
        y0 = fy(0.0)
        y1 = fy(v)
        fill_rect(img, x0, min(y0, y1), x1, max(y0, y1), color)
        put_text(img, int(cx) - 8, int(fy(0.0)) + 6, str(labels[i])[:5], (30, 30, 30), 1)


