def _glyph(c):
    c = c.upper()
    return _FONT.get(c, [0]*7)

def put_text(img, x, y, text, color, scale=1):
    h, w = img.shape[:2]
    cx = x
    for ch in text:
        g = _glyph(ch)
        for r in range(7):
            row = g[r]
            for cbit in range(5):
                if row & (0x10 >> cbit):
                    for dy in range(scale):
                        for dx in range(scale):
                            px, py = cx + cbit*scale + dx, y + r*scale + dy
                            if 0 <= px < w and 0 <= py < h:
                                img[py, px] = color
        cx += 6 * scale
    return cx

def draw_line(img, x0, y0, x1, y1, color, thick=1):
    h, w = img.shape[:2]
    x0, y0, x1, y1 = int(x0), int(y0), int(x1), int(y1)
    dx, dy = abs(x1-x0), abs(y1-y0)
    sx = 1 if x0 < x1 else -1
    sy = 1 if y0 < y1 else -1
    err = dx - dy
    while True:
        for ox in range(thick):
            for oy in range(thick):
                px, py = x0-ox//2, y0-oy//2
                if 0 <= px < w and 0 <= py < h:
                    img[py, px] = color
        if x0 == x1 and y0 == y1:
            break
        e2 = 2*err
        if e2 > -dy: err -= dy; x0 += sx
        if e2 < dx:  err += dx; y0 += sy

def fill_rect(img, x0, y0, x1, y1, color):
    h, w = img.shape[:2]
    x0, y0, x1, y1 = int(x0), int(y0), int(x1), int(y1)
    if x0 > x1:
        x0, x1 = x1, x0
    if y0 > y1:
        y0, y1 = y1, y0
    x0, x1 = max(0, x0), min(w - 1, x1)
    y0, y1 = max(0, y0), min(h - 1, y1)
    if x1 < x0 or y1 < y0:
        return
    img[y0:y1+1, x0:x1+1] = color

def write_png(path, img):
    h, w = img.shape[:2]
    if img.dtype != np.uint8:
        img = np.clip(img, 0, 255).astype(np.uint8)
    raw = b"".join(b"\x00" + img[y].tobytes() for y in range(h))
    data = zlib.compress(raw, 6)
    def chunk(typ, dat):
        return (struct.pack(">I", len(dat)) + typ + dat +
                struct.pack(">I", zlib.crc32(typ + dat) & 0xffffffff))
    with open(path, "wb") as f:
        f.write(b"\x89PNG\r\n\x1a\n")
        f.write(chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0)))
        f.write(chunk(b"IDAT", data))
        f.write(chunk(b"IEND", b""))

