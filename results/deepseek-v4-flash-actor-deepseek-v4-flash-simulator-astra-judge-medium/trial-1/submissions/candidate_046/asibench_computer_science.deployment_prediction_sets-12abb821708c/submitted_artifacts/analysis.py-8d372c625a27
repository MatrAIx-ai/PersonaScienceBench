"""
analysis.py - Deployment prediction sets under label-weighted miss risk (ASI benchmark).

Approach (as approved):
  - Risk spec: R = E[ c(Y) * 1{Y notin S(X)} ] (unnormalized), target_risk = 0.1084,
    empty prediction sets disallowed.
  - Public grouping: k-means (k=4) on z-scored anonymous features, fit on calibration,
    deployment assigned by nearest centroid -> proxy_stratum s0..s3.
  - Policy: per (proxy_stratum, label) inclusion thresholds t_{g,l}, calibrated on the
    labeled calibration set with a cost-aware greedy threshold sweep and a conservative
    per-group risk budget (~0.08), so each stratum's empirical weighted-miss risk stays
    well below target.  Every set always includes the argmax-score label (non-empty).
  - Deployment risk audit: importance-weighted transfer, R_hat_dep = sum_g w_g^dep * R_g^cal,
    and two-stage transfer for recovered groups (argmax-label groups of public scores).
  - All outputs written under results/; PNG diagnostics rendered with a pure-stdlib
    numpy+zlib raster encoder (matplotlib unavailable, no network).

No reference/ files are read; deployment labels are intentionally hidden and never used.
"""
import os, json, math, struct, zlib, heapq
import numpy as np
import pandas as pd
from scipy import stats

RNG = np.random.default_rng(0)
PD_VER_ROUND = True  # pandas 3.x: use axis= as keyword

# ----------------------------------------------------------------------------
# configuration & data loading
# ----------------------------------------------------------------------------
DATA = "data"
LABELS = [f"label_{i:02d}" for i in range(9)]
FEATURES = [f"v{i:03d}" for i in range(10)]
K_GROUPS = 4
GROUP_BUDGET = 0.076            # per-proxy-stratum calibration risk budget (empir+UB<=target)
DELTA = 0.1366                 # failure probability for confidence bounds (risk spec)
K_BINS_CALDIAG = 10            # bins per group in calibration_diagnostics
SEED = 0


def load_all():
    cal_f = pd.read_csv(f"{DATA}/calibration_features.csv")
    cal_l = pd.read_csv(f"{DATA}/calibration_labels.csv")
    cal_s = pd.read_csv(f"{DATA}/calibration_scores.csv")
    dep_f = pd.read_csv(f"{DATA}/deployment_features.csv")
    dep_s = pd.read_csv(f"{DATA}/deployment_scores.csv")
    with open(f"{DATA}/risk_spec.json") as fh:
        risk_spec = json.load(fh)
    with open(f"{DATA}/metadata.json") as fh:
        meta = json.load(fh)
    return cal_f, cal_l, cal_s, dep_f, dep_s, risk_spec, meta


cal_f, cal_l, cal_s, dep_f, dep_s, RISK, META = load_all()
TARGET_RISK = float(RISK["target_risk"])
COSTS = {k: float(v) for k, v in RISK["label_costs"].items()}
COST = np.array([COSTS[l] for l in LABELS])
LABEL_SET = set(LABELS)

cal = cal_s.merge(cal_l, on="record_id").merge(cal_f, on="record_id")
dep = dep_s.merge(dep_f, on="record_id")
assert not cal["true_label"].isna().any()
assert cal["record_id"].duplicated().sum() == 0
assert dep["record_id"].duplicated().sum() == 0

os.makedirs("results", exist_ok=True)

# ----------------------------------------------------------------------------
# proxy strata: k-means k=4 on z-scored features (cal-fit + nearest centroid)
# ----------------------------------------------------------------------------
def kmeans_fit(X, k, seed=SEED, iters=300):
    rng = np.random.default_rng(seed)
    cent = X[rng.choice(len(X), k, replace=False)]
    for _ in range(iters):
        d2 = ((X[:, None, :] - cent[None, :, :]) ** 2).sum(2)
        a = d2.argmin(1)
        newc = np.array([X[a == j].mean(0) if (a == j).sum() > 0 else cent[j]
                         for j in range(k)])
        if np.abs(newc - cent).max() < 1e-9:
            break
        cent = newc
    return cent


def assign_groups(X, cent):
    return ((X[:, None, :] - cent[None, :, :]) ** 2).sum(2).argmin(1)


zmean = cal[FEATURES].values.mean(0)
zstd = cal[FEATURES].values.std(0)
Z_cal = (cal[FEATURES].values - zmean) / zstd
Z_dep = (dep[FEATURES].values - zmean) / zstd

centroids = kmeans_fit(Z_cal, K_GROUPS)
cal["stratum"] = assign_groups(Z_cal, centroids)
dep["stratum"] = assign_groups(Z_dep, centroids)

STRATA = [f"s{i}" for i in range(K_GROUPS)]

# ----------------------------------------------------------------------------
# risk / set-size helpers
# ----------------------------------------------------------------------------
def weighted_miss_risk(Smat, yidx, mask):
    """mean over masked calibration records of cost[true]*1[true not included]."""
    n = mask.sum()
    if n == 0:
        return 0.0
    miss = ~Smat[mask, yidx[mask]]
    return float((COST[yidx[mask]] * miss).sum() / n)


def build_sets(score_mat, thr_mat):
    """Return boolean (n,9) inclusion matrix:
    include l if score>=threshold OR l is the argmax label (non-empty guarantee)."""
    inc = score_mat >= thr_mat
    am = np.argmax(score_mat, axis=1)
    inc[np.arange(len(score_mat)), am] = True
    return inc


# ----------------------------------------------------------------------------
# cost-aware greedy threshold calibration per proxy stratum
# ----------------------------------------------------------------------------
def calibrate_group(S, yidx, budget, n_g, cost_arr):
    """Greedy: start include-everything (risk 0, size 9), raise per-label thresholds,
    each step drops the highest-benefit / lowest-risk-increase slice of records.
    A record's label-l score can only affect set membership if l is NOT its argmax
    (argmax is always included -> non-empty guarantee). Returns thresholds (9,)."""
    am = np.argmax(S, axis=1)
    # eligible indicator: y==l and not argmax  -> contributes risk when dropped
    # droppable indicator: not argmax           -> contributes set-size benefit when dropped
    eligible = np.zeros((9, n_g), dtype=bool)   # records with true label l and l != argmax
    droppable = np.zeros((9, n_g), dtype=bool)
    for l in range(9):
        yl = (yidx == l)
        eligible[l] = yl & (am != l)
        droppable[l] = am != l

    thr = np.zeros(9)
    risk = 0.0
    # per label, candidate thresholds = observed score values of its eligible records, ascending
    steps_heap = []  # (-efficiency, seq, l, t)
    cur = np.zeros(9, dtype=int)  # index pointer into sorted candidate thresholds per label
    cand = []
    for l in range(9):
        vals = np.unique(S[eligible[l], l])
        cand.append(vals)
    seq = 0
    for l in range(9):
        if len(cand[l]) > 0:
            t = cand[l][0]
            # step risk/benefit raising threshold from thr[l]=0 to just-above t
            add_risk = COST[l] * int((eligible[l] & (S[:, l] < t)).sum()) / n_g
            benefit = int((droppable[l] & (S[:, l] < t)).sum()) / n_g
            eff = benefit / max(add_risk, 1e-12)
            heapq.heappush(steps_heap, (-eff, seq, l, t))
            seq += 1
    while steps_heap:
        neg_eff, _, l, t = heapq.heappop(steps_heap)
        if t <= thr[l]:
            continue
        add_risk = COST[l] * int((eligible[l] & (S[:, l] >= thr[l]) & (S[:, l] < t)).sum()) / n_g
        if risk + add_risk > budget:
            # try next higher candidate for this label later (skip this one)
            cur[l] += 1
            while cur[l] < len(cand[l]) and cand[l][cur[l]] <= thr[l]:
                cur[l] += 1
            if cur[l] < len(cand[l]):
                t2 = cand[l][cur[l]]
                add_risk2 = COST[l] * int((eligible[l] & (S[:, l] >= thr[l]) & (S[:, l] < t2)).sum()) / n_g
                benefit2 = int((droppable[l] & (S[:, l] >= thr[l]) & (S[:, l] < t2)).sum()) / n_g
                heapq.heappush(steps_heap, (-benefit2 / max(add_risk2, 1e-12), seq, l, t2))
                seq += 1
            continue
        thr[l] = t
        risk += add_risk
        # push next candidate step for this label
        cur[l] += 1
        while cur[l] < len(cand[l]) and cand[l][cur[l]] <= thr[l]:
            cur[l] += 1
        if cur[l] < len(cand[l]):
            t2 = cand[l][cur[l]]
            add_risk2 = COST[l] * int((eligible[l] & (S[:, l] >= thr[l]) & (S[:, l] < t2)).sum()) / n_g
            benefit2 = int((droppable[l] & (S[:, l] >= thr[l]) & (S[:, l] < t2)).sum()) / n_g
            heapq.heappush(steps_heap, (-benefit2 / max(add_risk2, 1e-12), seq, l, t2))
            seq += 1
    return thr

# ----------------------------------------------------------------------------
# apply calibrated policy to calibration (for diagnostics) and deployment (output)
# ----------------------------------------------------------------------------
def apply_policy(df, strata_col):
    """df needs score columns + stratum. Returns inc matrix, thr per stratum."""
    S = df[LABELS].values
    n = len(df)
    thr = np.zeros((K_GROUPS, 9))
    for g in range(K_GROUPS):
        idx = np.where(df[strata_col].values == g)[0]
        Sg = S[idx]
        yg = np.array([LABELS.index(y) for y in df["true_label"].values[idx]]) \
            if "true_label" in df.columns else None
        if yg is not None:
            thr[g] = calibrate_group(Sg, yg, GROUP_BUDGET, len(idx), COST)
        else:
            thr[g] = THRESHOLDS[g]  # carry over calibration thresholds
    inc = np.zeros((n, 9), dtype=bool)
    for g in range(K_GROUPS):
        idx = np.where(df[strata_col].values == g)[0]
        inc[idx] = build_sets(S[idx], thr[g])
    return inc, thr


# calibration: calibrate thresholds on the calibration set
S_cal = cal[LABELS].values
yidx_cal = np.array([LABELS.index(y) for y in cal["true_label"]])
inc_cal = np.zeros((len(cal), 9), dtype=bool)
THRESHOLDS = np.zeros((K_GROUPS, 9))
for g in range(K_GROUPS):
    idx = np.where(cal["stratum"].values == g)[0]
    Sg = S_cal[idx]
    yg = yidx_cal[idx]
    THRESHOLDS[g] = calibrate_group(Sg, yg, GROUP_BUDGET, len(idx), COST)
    inc_cal[idx] = build_sets(Sg, THRESHOLDS[g])

# deployment: apply calibration thresholds
S_dep = dep[LABELS].values
inc_dep = np.zeros((len(dep), 9), dtype=bool)
for g in range(K_GROUPS):
    idx = np.where(dep["stratum"].values == g)[0]
    inc_dep[idx] = build_sets(S_dep[idx], THRESHOLDS[g])

# set-size stats
size_cal = inc_cal.sum(1)
size_dep = inc_dep.sum(1)
dep["set_size"] = size_dep

# --- per-stratum calibration risk (transferred deployment estimate) ---
cal_risk_g = np.zeros(K_GROUPS)
cal_size_g = np.zeros(K_GROUPS)
for g in range(K_GROUPS):
    m = cal["stratum"].values == g
    cal_risk_g[g] = weighted_miss_risk(inc_cal, yidx_cal, m)
    cal_size_g[g] = size_cal[m].mean()

w_cal = np.bincount(cal["stratum"].values, minlength=K_GROUPS) / len(cal)
w_dep = np.bincount(dep["stratum"].values, minlength=K_GROUPS) / len(dep)

dep_risk_g = cal_risk_g                      # transfer: conditional risk per stratum
dep_risk_overall = float((w_dep * dep_risk_g).sum())   # importance re-weighted
mean_size_dep_g = np.array([size_dep[dep["stratum"].values == g].mean()
                            for g in range(K_GROUPS)])
p90_size_dep_g = np.array([np.percentile(size_dep[dep["stratum"].values == g], 90)
                           for g in range(K_GROUPS)])
mean_size_overall = float(size_dep.mean())
p90_size_overall = float(np.percentile(size_dep, 90))

# --- recovered groups (argmax-label from public scores) ---
dep["argmax"] = S_dep.argmax(1)
cal["argmax"] = S_cal.argmax(1)
rec_ids = {i: f"rl_{i:02d}" for i, l in enumerate(LABELS)}
rec_risk = {}   # deployment estimate via two-stage transfer
rec_n_dep = {}
rec_mean_size = {}
rec_p90_size = {}
# joint prevalence of (recovered group, proxy stratum) for transfer
joint_dep = np.zeros((9, K_GROUPS))
for l in range(9):
    for g in range(K_GROUPS):
        joint_dep[l, g] = ((dep["argmax"].values == l) & (dep["stratum"].values == g)).sum()
for l in range(9):
    n_dep = int(joint_dep[l].sum())
    rec_n_dep[l] = n_dep
    if n_dep > 0:
        w = joint_dep[l] / n_dep
        rec_risk[l] = float((w * dep_risk_g).sum())
    else:
        rec_risk[l] = 0.0
    mm = dep["argmax"].values == l
    rec_mean_size[l] = size_dep[mm].mean() if n_dep else 0.0
    rec_p90_size[l] = np.percentile(size_dep[mm], 90) if n_dep else 0.0

# calibration risk for recovered groups (for calibration_diagnostics coverage)
rec_risk_cal = {}
for l in range(9):
    mm = cal["argmax"].values == l
    rec_risk_cal[l] = weighted_miss_risk(inc_cal, yidx_cal, mm)

# ----------------------------------------------------------------------------
# 1) prediction_sets.csv
# ----------------------------------------------------------------------------
pred_labels = np.where(inc_dep, np.array(LABELS)[None, :], "")
pred_sets = [" ".join(pred_labels[i][pred_labels[i] != ""]) for i in range(len(dep))]
# safety: never empty (argmax always included, but double check)
for i in range(len(dep)):
    if pred_sets[i] == "":
        pred_sets[i] = LABELS[int(S_dep[i].argmax())]
prediction_sets = pd.DataFrame({"record_id": dep["record_id"], "prediction_set": pred_sets})
assert len(prediction_sets) == len(dep)
assert prediction_sets["prediction_set"].str.strip().str.len().min() > 0
prediction_sets.to_csv("results/prediction_sets.csv", index=False)

# ----------------------------------------------------------------------------
# 2) policy_parameters.csv
# ----------------------------------------------------------------------------
def hoeffding_ub(risk_est, n):
    return min(1.0, risk_est + math.sqrt(math.log(1.0 / DELTA) / (2.0 * max(n, 1))))

rows = []
for g in range(K_GROUPS):
    m = cal["stratum"].values == g
    n_g = int(m.sum())
    n_lab = np.array([int((cal["true_label"] == l).values[m].sum()) for l in LABELS])
    ub = hoeffding_ub(dep_risk_g[g], n_g)
    for j, l in enumerate(LABELS):
        rows.append({
            "proxy_stratum": STRATA[g],
            "label": l,
            "n_calibration": n_g,
            "n_calibration_label": int(n_lab[j]),
            "threshold": float(THRESHOLDS[g, j]),
            "group_empirical_weighted_miss_risk": float(dep_risk_g[g]),
            "group_upper_confidence_risk": float(ub),
            "group_expected_set_size": float(cal_size_g[g]),
            "calibration_target_risk": GROUP_BUDGET,
            "target_risk": TARGET_RISK,
        })
policy_parameters = pd.DataFrame(rows, columns=[
    "proxy_stratum", "label", "n_calibration", "n_calibration_label", "threshold",
    "group_empirical_weighted_miss_risk", "group_upper_confidence_risk",
    "group_expected_set_size", "calibration_target_risk", "target_risk"])
policy_parameters.to_csv("results/policy_parameters.csv", index=False)

# ----------------------------------------------------------------------------
# 3) audit_summary.csv
# ----------------------------------------------------------------------------
def audit_row(scope, sid, n, risk, msz, p90, target):
    return {"scope": scope, "stratum_id": sid, "n_records": int(n),
            "empirical_risk": float(risk), "mean_set_size": float(msz),
            "p90_set_size": float(p90), "target_risk": float(target),
            "risk_violation": float(risk) - float(target)}

audit_rows = [audit_row("overall", "all", len(dep), dep_risk_overall,
                        mean_size_overall, p90_size_overall, TARGET_RISK)]
for g in range(K_GROUPS):
    n_g_dep = int((dep["stratum"].values == g).sum())
    audit_rows.append(audit_row("proxy_stratum", STRATA[g], n_g_dep,
                                dep_risk_g[g], mean_size_dep_g[g], p90_size_dep_g[g],
                                TARGET_RISK))
for l in range(9):
    audit_rows.append(audit_row("recovered_group", rec_ids[l], rec_n_dep[l],
                                rec_risk[l], rec_mean_size[l], rec_p90_size[l],
                                TARGET_RISK))
audit_summary = pd.DataFrame(audit_rows, columns=[
    "scope", "stratum_id", "n_records", "empirical_risk", "mean_set_size",
    "p90_set_size", "target_risk", "risk_violation"])
audit_summary.to_csv("results/audit_summary.csv", index=False)

# ----------------------------------------------------------------------------
# 4) set_size_summary.csv
# ----------------------------------------------------------------------------
set_size_summary = pd.DataFrame({
    "record_id": dep["record_id"],
    "set_size": size_dep,
    "proxy_stratum": [STRATA[g] for g in dep["stratum"].values]})
set_size_summary.to_csv("results/set_size_summary.csv", index=False)

# ----------------------------------------------------------------------------
# 5) partition_diagnostics.csv (proxy_stratum + recovered_group scopes)
# ----------------------------------------------------------------------------
prows = []
for g in range(K_GROUPS):
    n_g_dep = int((dep["stratum"].values == g).sum())
    prows.append({"scope": "proxy_stratum", "stratum_id": STRATA[g],
                  "n_records": n_g_dep, "empirical_risk": dep_risk_g[g],
                  "mean_set_size": mean_size_dep_g[g], "p90_set_size": p90_size_dep_g[g],
                  "target_risk": TARGET_RISK,
                  "risk_margin": TARGET_RISK - dep_risk_g[g]})
for l in range(9):
    prows.append({"scope": "recovered_group", "stratum_id": rec_ids[l],
                  "n_records": rec_n_dep[l], "empirical_risk": rec_risk[l],
                  "mean_set_size": rec_mean_size[l], "p90_set_size": rec_p90_size[l],
                  "target_risk": TARGET_RISK,
                  "risk_margin": TARGET_RISK - rec_risk[l]})
partition_diagnostics = pd.DataFrame(prows, columns=[
    "scope", "stratum_id", "n_records", "empirical_risk", "mean_set_size",
    "p90_set_size", "target_risk", "risk_margin"])
partition_diagnostics.to_csv("results/partition_diagnostics.csv", index=False)

# ----------------------------------------------------------------------------
# 6) distribution_diagnostics.csv
# ----------------------------------------------------------------------------
frac_cal = np.bincount(cal["stratum"].values, minlength=K_GROUPS) / len(cal)
frac_dep = np.bincount(dep["stratum"].values, minlength=K_GROUPS) / len(dep)
drows = []
for g in range(K_GROUPS):
    dr = float(frac_dep[g] / frac_cal[g]) if frac_cal[g] > 1e-9 else float("nan")
    drows.append({"proxy_stratum": STRATA[g],
                  "calibration_fraction": float(frac_cal[g]),
                  "deployment_fraction": float(frac_dep[g]),
                  "density_ratio_estimate": dr,
                  "absolute_fraction_shift": float(abs(frac_dep[g] - frac_cal[g]))})
distribution_diagnostics = pd.DataFrame(drows, columns=[
    "proxy_stratum", "calibration_fraction", "deployment_fraction",
    "density_ratio_estimate", "absolute_fraction_shift"])
distribution_diagnostics.to_csv("results/distribution_diagnostics.csv", index=False)

# ----------------------------------------------------------------------------
# 7) calibration_diagnostics.csv (score bins within each proxy stratum;
#    mean_true_label_score = mean score of the true calibration label in the bin)
# ----------------------------------------------------------------------------
cal_ts = S_cal[np.arange(len(cal)), yidx_cal]
cbins = np.linspace(0.0, 1.0, K_BINS_CALDIAG + 1)
crows = []
for g in range(K_GROUPS):
    m = cal["stratum"].values == g
    for b in range(K_BINS_CALDIAG):
        lo, hi = cbins[b], cbins[b + 1]
        # bin over the record's max score (confidence axis)
        inbin = m & (cal_ts >= lo) & (cal_ts <= hi)
        n_rec = int(inbin.sum())
        if n_rec > 0:
            mts = float(cal_ts[inbin].mean())
        else:
            mts = float("nan")
        crows.append({"proxy_stratum": STRATA[g], "bin_id": f"bin_{b:02d}",
                      "score_left": float(lo), "score_right": float(hi),
                      "n_records": n_rec, "mean_true_label_score": mts})
calibration_diagnostics = pd.DataFrame(crows, columns=[
    "proxy_stratum", "bin_id", "score_left", "score_right", "n_records",
    "mean_true_label_score"])
calibration_diagnostics.to_csv("results/calibration_diagnostics.csv", index=False)

# ----------------------------------------------------------------------------
# 8) constraint_audit.csv (same scopes as audit_summary)
# ----------------------------------------------------------------------------
crows = []
for _, r in audit_summary.iterrows():
    risk = float(r["empirical_risk"])
    tgt = float(r["target_risk"])
    crows.append({"scope": r["scope"], "stratum_id": r["stratum_id"],
                  "empirical_risk": risk, "target_risk": tgt,
                  "risk_violation": risk - tgt,
                  "violates": bool(risk > tgt)})
constraint_audit = pd.DataFrame(crows, columns=[
    "scope", "stratum_id", "empirical_risk", "target_risk", "risk_violation",
    "violates"])
constraint_audit.to_csv("results/constraint_audit.csv", index=False)

