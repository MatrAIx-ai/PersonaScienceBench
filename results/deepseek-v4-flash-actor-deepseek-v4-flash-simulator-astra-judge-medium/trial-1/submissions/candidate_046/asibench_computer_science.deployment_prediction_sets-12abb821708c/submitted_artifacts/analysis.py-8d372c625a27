# print summary for the handoff
# ----------------------------------------------------------------------------
print("=" * 78)
print("CALIBRATION-TRANSFER DEPLOYMENT RISK ESTIMATES (unnormalized E[c(Y)*miss])")
overall = dep_risk_overall
print(f"overall      : R={overall:.4f}  | mean_set_size={mean_size_overall:.3f}  p90={p90_size_overall:.1f}  n={len(dep)}")
for g in range(K_GROUPS):
    print(f"proxy_stratum {STRATA[g]}: R={dep_risk_g[g]:.4f}  | mean_set_size={mean_size_dep_g[g]:.3f}  p90={p90_size_dep_g[g]:.1f}  n={(dep['stratum'].values==g).sum()}  w_dep={w_dep[g]:.3f}")
print("recovered_group (argmax label) deployment estimates:")
for l in range(9):
    print(f"  {rec_ids[l]} ({LABELS[l]}): R={rec_risk[l]:.4f} n={rec_n_dep[l]} mean_size={rec_mean_size[l]:.2f}")
print("target_risk =", TARGET_RISK, " budget/group =", GROUP_BUDGET)
print("calibration group risks:", np.round(dep_risk_g, 4))
print("Hoeffding UBs (delta=%.4f):" % DELTA, np.round([hoeffding_ub(dep_risk_g[g], (cal['stratum'].values==g).sum()) for g in range(K_GROUPS)], 4))
print("thr matrix:"); print(np.round(THRESHOLDS, 3))
print("distribution:"); print(distribution_diagnostics.to_string(index=False))

