def draw_axes(img, ml, mt, mr, mb, lo, hi):
    """Cartesian axes mapping data [lo,hi] x [lo,hi] into image; draws frame & ticks.
    Returns fx(v), fy(v) pixel mappers (y inverted)."""
    H, W = img.shape[:2]
    X0, X1 = ml, W - mr - 1
    Y0, Y1 = mt, H - mb - 1
    def fx(v): return X0 + (v - lo[0]) / (hi[0] - lo[0] + 1e-12) * (X1 - X0)
    def fy(v): return Y1 - (v - lo[1]) / (hi[1] - lo[1] + 1e-12) * (Y1 - Y0)
    c = np.array([40, 40, 40], dtype=np.uint8)
    draw_line(img, X0, Y0, X0, Y1, c, 1)
    draw_line(img, X0, Y1, X1, Y1, c, 1)
    # x ticks
    for i in range(6):
        v = lo[0] + (hi[0] - lo[0]) * i / 5.0
        px = int(fx(v))
        draw_line(img, px, Y1, px, Y1 + 4, c, 1)
        put_text(img, px - 10, Y1 + 6, f"{v:.2f}", (40, 40, 40), 1)
    # y ticks
    for i in range(5):
        v = lo[1] + (hi[1] - lo[1]) * i / 4.0
        py = int(fy(v))
        draw_line(img, X0 - 4, py, X0, py, c, 1)
        put_text(img, ml - 32, py - 3, f"{v:.2f}", (40, 40, 40), 1)
    return fx, fy


def run_budget(b):
    """Recalibrate thresholds at budget b; return (overall transfer risk,
    deployment mean set size, per-group cal risk)."""
    thr_b = np.zeros((K_GROUPS, 9))
    inc_b = np.zeros((len(cal), 9), dtype=bool)
    for g in range(K_GROUPS):
        idx = np.where(cal["stratum"].values == g)[0]
        Sg = S_cal[idx]; yg = yidx_cal[idx]
        thr_b[g] = calibrate_group(Sg, yg, b, len(idx), COST)
        inc_b[idx] = build_sets(Sg, thr_b[g])
    rg = np.array([weighted_miss_risk(inc_b, yidx_cal, cal["stratum"].values == g)
                   for g in range(K_GROUPS)])
    risk = float((w_dep * rg).sum())
    inc_d_b = np.zeros((len(dep), 9), dtype=bool)
    for g in range(K_GROUPS):
        idx = np.where(dep["stratum"].values == g)[0]
        inc_d_b[idx] = build_sets(S_dep[idx], thr_b[g])
    msz = float(inc_d_b.sum(1).mean())
    return risk, msz


