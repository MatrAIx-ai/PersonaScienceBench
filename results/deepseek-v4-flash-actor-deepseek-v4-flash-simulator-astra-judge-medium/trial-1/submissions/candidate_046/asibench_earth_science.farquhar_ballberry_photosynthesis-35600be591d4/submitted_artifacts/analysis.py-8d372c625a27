#!/usr/bin/env python3
"""
Leaf physiological response reconstruction (C4 Collatz + Ball-Berry).

Land-surface form of coupled C4 (Collatz) photosynthesis and Ball-Berry
stomatal conductance, evaluated at a coupled fixed point per sunlit /
shaded leaf for every row of data/forcing.csv, plus single-point case
runs seeded from user-supplied ci_init guesses.

Scientific convention (from the task brief):
  * pathway = C4 (data/leaf_params.json)
  * Wc = Vcmax, Wj = alpha_q*APAR, We = 4000*Vcmax*Ci/p_atm, A = min(...) - Rd
    with APAR = 4.6*PAR (no absorptance factor)
  * CLM/Noah-MP Q10 response for Vcmax incl. high-temperature inhibition:
    Vcmax(T) = vcmax25*2.4^((Tc-25)/10) / (1+exp((-2.2e5+710*T)/(R*T)))
  * Kc25=30 Pa, Ko25=30000 Pa, Q10=(2.1,1.2,2.4),
    Gamma* = 0.5*(Kc/Ko)*O2*0.21, Rd = 0.015*Vcmax
  * n_factor and btran scale photosynthetic capacity (not the Ball-Berry intercept)
  * leaf T = air T; h_s = min(max(1 - vpd/esat(T), 0.25), 1.0); esat via Magnus
  * gas-diffusion closure:
      cf = p_atm/(R*T)
      cs = ca - 1.37*rb*A_mol/cf*p_atm
      gs = m*A_mol*h_s/cs*p_atm + b0
      rs = cf/gs
      Ci = cs - 1.65*rs*A_mol/cf*p_atm
  * night (APAR ~ 0): A = -Rd (respiration), gs = b0 (intercept conductance)

Daytime solution: bisection on Ci in (0, ca) for the coupled fixed point.
The diurnal figure is drawn with matplotlib when available, otherwise with
a pure-stdlib raster fallback embedded in this file so the script runs
anywhere with numpy/pandas only.
"""
import json
import os
import numpy as np
import pandas as pd
import zlib
import struct

try:                                   # optional matplotlib fast path
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt
    HAVE_MPL = True
except Exception:
    HAVE_MPL = False

R_GAS = 8.314          # J mol^-1 K^-1
T0    = 273.16         # K
KC25  = 30.0           # Pa
KO25  = 30000.0        # Pa
Q10_KC, Q10_KO, Q10_VC = (2.1, 1.2, 2.4)
RSTAR  = 0.21
APAR_F = 4.6
RD_F   = 0.015
APAR_NIGHT_EPS = 1e-6
BISECT_TOL = 1e-8      # Pa
BISECT_MAXIT = 200

# ---------------- environmental / physiological functions --------------- #
def esat_magnus(T):
    """Saturation vapour pressure (Pa), Magnus/Tetens, T in K."""
    Tc = T - T0
    return 611.0 * np.exp(17.27 * Tc / (Tc + 237.30))   # 611*exp(17.27(T-273.16)/(T-35.85))

def vcmax_eff(vcmax25, T, n_factor, btran):
    """CLM/Noah-MP Q10 response (+ high-T inhibition), then n_factor*btran."""
    Tc = T - T0
    fq = Q10_VC ** ((Tc - 25.0) / 10.0)                     # 2.4^((Tc-25)/10)
    ft = 1.0 / (1.0 + np.exp((-2.2e5 + 710.0 * T) / (R_GAS * T)))
    return n_factor * btran * vcmax25 * fq * ft

def kc_ko(T):
    Tc = T - T0
    return (KC25 * Q10_KC ** ((Tc - 25.0) / 10.0),
            KO25 * Q10_KO ** ((Tc - 25.0) / 10.0))

def gamma_star(Kc, Ko, o2):
    return 0.5 * (Kc / Ko) * o2 * RSTAR

def rel_humidity(vpd, T):
    return min(max(1.0 - vpd / esat_magnus(T), 0.25), 1.0)

def assim_C4(ci, apar, vcmax, alpha_q, p_atm, Rd):
    Wc = vcmax
    Wj = alpha_q * apar
    We = 4000.0 * vcmax * ci / p_atm
    return min(Wc, Wj, We) - Rd

def assim_C3(ci, apar, vcmax, alpha_q, p_atm, Rd, kc, ko, gstar, o2):
    J  = alpha_q * apar
    Wc = vcmax * (ci - gstar) / (ci + kc * (1.0 + o2 / ko))
    Wj = J * (ci - gstar) / (4.0 * ci + 8.0 * gstar)
    We = 0.5 * vcmax
    return min(Wc, Wj, We) - Rd

def coupled_map(ci, apar, vcmax, alpha_q, ca, o2, p_atm, T, vpd, rb,
                m, b0, hs, pathway="C4", kc=None, ko=None, gstar=None):
    """Gas-diffusion closure for a trial internal CO2 ci -> (A, cs, gs, rs, ci_out)."""
    Rd = RD_F * vcmax
    if pathway.upper() == "C4":
        A = assim_C4(ci, apar, vcmax, alpha_q, p_atm, Rd)
    else:
        A = assim_C3(ci, apar, vcmax, alpha_q, p_atm, Rd, kc, ko, gstar, o2)
    A_mol = A / 1.0e6                       # umol -> mol
    cf    = p_atm / (R_GAS * T)             # mol m^-3
    cs    = ca - 1.37 * rb * A_mol / cf * p_atm
    gs_day = m * A_mol * hs / cs * p_atm + b0
    if gs_day <= b0 * 0.5:                  # guard non-positive gs
        gs_day = b0
    rs    = cf / gs_day
    ci_out = cs - 1.65 * rs * A_mol / cf * p_atm
    return A, cs, gs_day, rs, ci_out

# ---------------- daytime coupled fixed point (bisection on Ci) --------- #
def solve_day(apar, vcmax, alpha_q, ca, o2, p_atm, T, vpd, rb, m, b0,
              pathway="C4", tol=BISECT_TOL, max_iter=BISECT_MAXIT):
    hs = rel_humidity(vpd, T)
    kc = ko = gstar = None
    if pathway.upper() != "C4":
        kc, ko = kc_ko(T)
        gstar = gamma_star(kc, ko, o2)

    def resid(ci):
        return coupled_map(ci, apar, vcmax, alpha_q, ca, o2, p_atm, T, vpd,
                           rb, m, b0, hs, pathway, kc, ko, gstar)[4]

    lo, hi = 0.0, ca
    flo = resid(lo) - lo            # >0 expected at ci=0
    fhi = resid(hi) - hi            # <0 expected at ci=ca
    nit = 0
    if not (flo > 0.0 and fhi < 0.0):
        sol = lo if abs(flo) <= abs(fhi) else hi
        A, cs, gs, rs, ci_out = coupled_map(
            sol, apar, vcmax, alpha_q, ca, o2, p_atm, T, vpd, rb, m, b0,
            hs, pathway, kc, ko, gstar)
        return A, ci_out, rs, gs, nit, False

    while (hi - lo) > tol and nit < max_iter:
        mid = 0.5 * (lo + hi)
        fmid = resid(mid) - mid
        if fmid > 0.0:
            lo, flo = mid, fmid
        elif fmid < 0.0:
            hi, fhi = mid, fmid
        else:
            break
        nit += 1
    ci = 0.5 * (lo + hi)
    A, cs, gs, rs, ci_out = coupled_map(
        ci, apar, vcmax, alpha_q, ca, o2, p_atm, T, vpd, rb, m, b0,
        hs, pathway, kc, ko, gstar)
    return A, ci, rs, gs, nit, True

# ---------------- night branch: respiration + intercept conductance ------ #
def solve_night(vcmax, ca, o2, p_atm, T, vpd, rb, b0, pathway="C4"):
    Rd    = RD_F * vcmax
    A     = -Rd
    A_mol = A / 1.0e6
    cf    = p_atm / (R_GAS * T)
    cs    = ca - 1.37 * rb * A_mol / cf * p_atm
    gs    = b0
    rs    = cf / gs
    ci    = cs - 1.65 * rs * A_mol / cf * p_atm
    return A, ci, rs, gs

def solve_row(row, params):
    T     = row["t_air_K"]; p_atm = row["p_atm_Pa"]; ca = row["co2_pa"]
    o2    = row["o2_pa"];   vpd   = row["vpd_Pa"];   rb = row["rb_sm"]
    btran = row["btran"];   nf    = params["n_factor"]
    vcmax = vcmax_eff(params["vcmax25"], T, nf, btran)
    m  = params["bb_slope"]; b0 = params["bb_intercept"]
    aq = params["alpha_q"];  path = params["pathway"]
    out = {}
    for tag, par in (("sun", row["par_sun_wm2"]), ("shade", row["par_shade_wm2"])):
        apar = APAR_F * par
        if apar < APAR_NIGHT_EPS:
            A, ci, rs, gs = solve_night(vcmax, ca, o2, p_atm, T, vpd, rb, b0, path)
        else:
            A, ci, rs, gs, nit, ok = solve_day(
                apar, vcmax, aq, ca, o2, p_atm, T, vpd, rb, m, b0, path)
            if not ok:
                print(f"  [warn] no bracketed root row={row['time_hr']} {tag}")
        out[f"A_{tag}"] = A; out[f"rs_{tag}"] = rs
        out[f"ci_{tag}"] = ci; out[f"gs_{tag}"] = gs
    out["time_hr"] = row["time_hr"]
    return out


