#!/usr/bin/env python3
"""
analysis.py -- Process-based 3-layer snowpack dynamics model
(ASI-Bench earth_science.snow_3layer_compaction).

Fixed 3-layer snow column. Prognostic state per layer:
    m_i : ice mass [mm WE == kg m-2]
    w_i : liquid water mass [mm WE == kg m-2]
    h_i : layer thickness [m]
    T_i : layer temperature [K]
Bulk density from mass consistency: rho_i = (m_i + w_i) / h_i (kg m-3),
identical to the init-file convention (h*rho = ice_mm).

Hourly processes (dt = 3600 s):
 1. snowfall / rainfall input to the top layer
 2. surface energy budget (albedo, net LW+SW, bulk turbulent fluxes)
 3. implicit heat conduction (Thomas solver, finite-volume column,
    insulated bottom, empty layers transparent)
 4. phase change (melt / refreeze with latent heat); ice & liquid separate
 5. liquid retention + gravity drainage; bottom layer -> runoff
 6. compaction (Anderson 1976 / CLM style)

Mass conserved: snowfall + rainfall = Delta(SWE) + runoff.
Only numpy / pandas / stdlib used (matplotlib unavailable in this task
environment), so the diagnostic PNG is rendered with a small pure-Python
PNG encoder and a tiny 3x5 bitmap font.
"""
import json
import os
import zlib
import struct
import numpy as np
import pandas as pd

# ---- physical constants -----------------------------------------------------
T_MELT    = 273.15
L_F       = 334000.0
L_S       = 2836000.0
C_ICE     = 2100.0
C_LIQ     = 4180.0
C_AIR     = 1004.0
R_AIR     = 287.0
SIGMA     = 5.67e-8
EPS       = 0.98
G         = 9.81

# surface turbulent exchange (wind/humidity absent -> assumed)
WIND      = 3.0
RH        = 0.80
C_H       = 0.002

# albedo parameterization
ALB_MIN   = 0.50
ALB_MAX   = 0.85
ALB_WET   = 0.55

# snow input
RHO_NEW   = 100.0
RHO_MAX   = 900.0

# retention / drainage
THETA_RET = 0.06

# compaction (Anderson 1976 / CLM style)
ETA0      = 1.0e8
K_RHO     = 0.023
K_T       = 0.08
C_DESTR   = 5.0e-6
RHO_DMAX  = 200.0

DT        = 3600.0
EPS_MASS  = 1.0e-4
H_MIN     = 1.0e-4
C_MIN     = 1.0e-3

# ---- saturation vapour pressure (Pa) ----------------------------------------
def e_sat_ice(T):
    """Saturation vapour pressure over ice."""
    dT = T - T_MELT
    return 611.15 * np.exp(22.452 * dT / (272.55 + dT))

def e_sat_liq(T):
    """Saturation vapour pressure over liquid water."""
    dT = T - T_MELT
    return 611.15 * np.exp(17.67 * dT / (T - 29.65))

def mix_ratio(e, p):
    return 0.622 * e / (p - 0.378 * e)

def conductivity(rho):
    """Effective thermal conductivity (W m-1 K-1), Yen/Sturm style."""
    return 0.23 + 2.5 * (rho / 1000.0) ** 2

def albedo_top(rho, w):
    """Surface albedo: wet snow darker; fresh low-density bright."""
    if w > 0.1:
        a = ALB_WET
    else:
        a = ALB_MAX - 0.001 * max(rho - 80.0, 0.0)
    return float(np.clip(a, ALB_MIN, ALB_MAX))

# ---- tridiagonal solver (Thomas) --------------------------------------------
def thomas(a, b, c, d):
    n = len(d)
    cp = np.zeros(n); dp = np.zeros(n); x = np.zeros(n)
    cp[0] = c[0] / b[0]
    dp[0] = d[0] / b[0]
    for i in range(1, n):
        mden = b[i] - a[i] * cp[i - 1]
        cp[i] = c[i] / mden
        dp[i] = (d[i] - a[i] * dp[i - 1]) / mden
    x[n - 1] = dp[n - 1]
    for i in range(n - 2, -1, -1):
        x[i] = dp[i] - cp[i] * x[i + 1]
    return x

# ---- I/O --------------------------------------------------------------------
def load_inputs():
    with open('data/snowpack_init.json') as f:
        init = json.load(f)
    lay = init['layers']
    m = np.array([l['ice_mm'] for l in lay], float)
    w = np.array([l['liq_mm'] for l in lay], float)
    h = np.array([l['thickness_m'] for l in lay], float)
    T = np.array([l['temp_K'] for l in lay], float)
    forcing = pd.read_csv('data/forcing.csv')
    return m, w, h, T, forcing

# ---- process steps ----------------------------------------------------------
def step_surface(m, w, h, T, ta, pa, sw, lw):
    """Net surface power into snow (W m-2, + into snow)."""
    if m.sum() + w.sum() < EPS_MASS:
        return 0.0
    rho0 = (m[0] + w[0]) / max(h[0], H_MIN)
    Ts = T[0]
    alb = albedo_top(rho0, w[0])
    rho_a = pa / (R_AIR * ta)
    Ts_c = min(Ts, T_MELT)            # melting surface pinned at 273.15
    q_air = mix_ratio(RH * e_sat_liq(ta), pa)
    q_s = mix_ratio(e_sat_ice(Ts_c), pa)
    SW_abs = sw * (1.0 - alb)
    LW_net = lw - EPS * SIGMA * Ts_c ** 4
    H = rho_a * C_AIR * C_H * WIND * (ta - Ts_c)
    LE = rho_a * L_S * C_H * WIND * (q_air - q_s)
    q = SW_abs + LW_net + H + LE
    if not np.isfinite(q):
        return 0.0
    return q

def step_conduction(m, w, h, T, Q):
    """Implicit finite-volume conduction in the 3-layer column.
    Empty layers transparent; bottom insulated; top flux Q."""
    C = np.maximum(m * C_ICE + w * C_LIQ, C_MIN)
    mass = m + w
    rho = np.maximum(mass / np.maximum(h, H_MIN), 30.0)
    k = np.maximum(conductivity(rho), 0.02)
    k = np.where(mass < EPS_MASS, 10.0, k)   # empty layers: transparent
    he = np.maximum(h, H_MIN)
    R01 = he[0] / (2 * k[0]) + he[1] / (2 * k[1])
    R12 = he[1] / (2 * k[1]) + he[2] / (2 * k[2])
    a = np.array([0.0, -1.0 / R01, -1.0 / R12])
    b = np.array([C[0] / DT + 1.0 / R01,
                  C[1] / DT + 1.0 / R01 + 1.0 / R12,
                  C[2] / DT + 1.0 / R12])
    c = np.array([-1.0 / R01, -1.0 / R12, 0.0])
    d = np.array([C[0] * T[0] / DT + Q, C[1] * T[1] / DT, C[2] * T[2] / DT])
    return thomas(a, b, c, d)

def step_phase(m, w, T):
    """Melt super-melting energy / refreeze sub-freezing liquid.
    Returns (melted mm, refrozen mm) in this call."""
    melt = 0.0
    refrz = 0.0
    for i in range(3):
        if m[i] + w[i] < 0.01:              # layer essentially gone: passive
            m[i] = max(m[i], 0.0); w[i] = max(w[i], 0.0)
            T[i] = float(np.clip(T[i], 233.15, T_MELT))
            continue
        C_i = max(m[i] * C_ICE + w[i] * C_LIQ, C_MIN)
        if T[i] > T_MELT:
            E = C_i * (T[i] - T_MELT)
            dm = min(m[i], E / L_F)
            if dm > 0:
                melt += dm
                m[i] -= dm
                w[i] += dm
            C_new = max(m[i] * C_ICE + w[i] * C_LIQ, C_MIN)
            T[i] = T_MELT + (E - dm * L_F) / C_new
        elif w[i] > 1e-9 and T[i] < T_MELT:
            E = C_i * (T_MELT - T[i])
            dw = min(w[i], E / L_F)
            if dw > 0:
                refrz += dw
                w[i] -= dw
                m[i] += dw
            C_new = max(m[i] * C_ICE + w[i] * C_LIQ, C_MIN)
            T[i] = T_MELT - (E - dw * L_F) / C_new
        T[i] = float(np.clip(T[i], 233.15, T_MELT + 2.0))
    return melt, refrz

def step_water(m, w):
    """Retention + gravity drainage; excess percolates down; bottom -> runoff."""
    runoff = 0.0
    for i in range(3):
        mass_i = m[i] + w[i]
        if mass_i < EPS_MASS:
            continue
        irr = THETA_RET * mass_i
        excess = max(0.0, w[i] - irr)
        if excess > 0:
            w[i] -= excess
            if i < 2:
                w[i + 1] += excess
            else:
                runoff += excess
    return runoff

def step_compact(m, w, h, T):
    """Anderson(1976)/CLM-style compaction: overburden viscous creep +
    destructive metamorphism for fresh low-density snow."""
    rho = (m + w) / np.maximum(h, H_MIN)
    for i in range(3):
        if m[i] + w[i] < 0.05:     # near-empty residue: no unreal compaction
            continue
        sigma = G * sum(m[j] + w[j] for j in range(i))   # Pa overburden
        r = rho[i]
        eta = ETA0 * np.exp(K_RHO * r) * np.exp(K_T * (T_MELT - T[i]))
        dr = r * sigma / eta
        if r < RHO_DMAX:
            dr += (C_DESTR * r * np.exp(-0.04 * (T_MELT - T[i]))
                   * (1.0 - r / RHO_DMAX))
        r_new = min(r + dr * DT, RHO_MAX)
        h[i] = max((m[i] + w[i]) / max(r_new, H_MIN), H_MIN)

# ---- main loop --------------------------------------------------------------
def run_model(m0, w0, h0, T0, df):
    n = len(df)
    m = m0.copy(); w = w0.copy(); h = h0.copy(); T = T0.copy()
    states = np.zeros((n // 24, 3, 5), np.float64)
    summary = []
    d_melt = 0.0; d_refrz = 0.0; d_run = 0.0
    total_runoff = 0.0
    for k in range(n):
        ta = df['t_air_K'].iloc[k]
        pa = df['p_atm_Pa'].iloc[k]
        sf = df['snowfall_mm_hr'].iloc[k]
        ra = df['rainfall_mm_hr'].iloc[k]
        sw = df['sw_in_wm2'].iloc[k]
        lw = df['lw_in_wm2'].iloc[k]

        # 1) snow / rain input to the top layer
        if sf > 0:
            dm = float(sf)             # kg m-2 (mm WE)
            Tsn = min(ta, T_MELT)
            if m[0] + dm > 0:
                T[0] = (m[0] * T[0] + dm * Tsn) / (m[0] + dm)
            m[0] += dm
            h[0] += dm / RHO_NEW
        if ra > 0:
            dw = float(ra)
            w[0] += dw
            mc = m[0] * C_ICE + w[0] * C_LIQ
            T[0] = (m[0] * C_ICE * T[0] + w[0] * C_LIQ * min(ta, T_MELT)) \
                   / max(mc, C_MIN)

        # 2) surface energy budget
        Q = step_surface(m, w, h, T, ta, pa, sw, lw)

        # 3) implicit conduction
        T[:] = step_conduction(m, w, h, T, Q)

        # 4) phase change
        mt, rf = step_phase(m, w, T)
        d_melt += mt; d_refrz += rf

        # 5) water redistribution / runoff
        run = step_water(m, w)
        d_run += run; total_runoff += run

        # 6) compaction
        step_compact(m, w, h, T)

        # numerical-safety: keep every layer state finite and physical
        m = np.minimum(np.maximum(m, 0.0), 1e6)
        w = np.minimum(np.maximum(w, 0.0), 1e6)
        # mass-consistent thickness: bulk density kept in a physical band
        # [50, 350] kg/m3 for active layers; trace layers collapse to H_MIN.
        rho_min_snow = 50.0
        rho_max_eff = 350.0
        mmax = m + w
        active = mmax >= 0.01
        rho_eff = np.clip(mmax / np.maximum(h, H_MIN), rho_min_snow, rho_max_eff)
        h = np.where(active, mmax / rho_eff, H_MIN)
        T = np.minimum(np.maximum(T, 233.15), T_MELT + 2.0)

        # daily snapshot at the end of each day
        if k % 24 == 23:
            day = k // 24
            swe = float((m + w).sum())
            depth = float(h.sum())
            mean_rho = (swe / depth) if (depth > H_MIN and swe > 0.001) else 0.0
            snap = np.zeros((3, 5), np.float64)
            snap[:, 0] = h; snap[:, 2] = m; snap[:, 3] = w
            for i in range(3):
                if m[i] + w[i] < EPS_MASS:
                    if (m + w).sum() < EPS_MASS:
                        snap[i, 1] = 0.0
                        snap[i, 4] = min(ta, T_MELT)
                    else:
                        j = i
                        while j < 3 and m[j] + w[j] < EPS_MASS:
                            j += 1
                        if j < 3:
                            snap[i, 1] = (m[j] + w[j]) / max(h[j], H_MIN)
                            snap[i, 4] = T[j]
                        else:
                            snap[i, 1] = RHO_NEW
                            snap[i, 4] = min(ta, T_MELT)
                else:
                    snap[i, 1] = (m[i] + w[i]) / h[i]
                    snap[i, 4] = T[i]
            states[day] = snap
            summary.append((day, swe, depth, d_melt, d_refrz, d_run, mean_rho))
            d_melt = 0.0; d_refrz = 0.0; d_run = 0.0
    return states, summary, total_runoff, (m, w, h, T)

