def write_png(path, img):
    h, w, _ = img.shape
    def chunk(tag, data):
        c = struct.pack('>I', len(data)) + tag + data
        c += struct.pack('>I', zlib.crc32(tag + data) & 0xffffffff)
        return c
    raw = b''.join(b'\x00' + img[i].tobytes() for i in range(h))
    png = (b'\x89PNG\r\n\x1a\n'
           + chunk(b'IHDR', struct.pack('>IIBBBBB', w, h, 8, 2, 0, 0, 0))
           + chunk(b'IDAT', zlib.compress(raw, 9))
           + chunk(b'IEND', b''))
    with open(path, 'wb') as f:
        f.write(png)

def draw_rect(img, x0, y0, x1, y1, color):
    x0 = int(max(x0, 0)); y0 = int(max(y0, 0))
    x1 = int(min(x1, img.shape[1] - 1)); y1 = int(min(y1, img.shape[0] - 1))
    if x1 < x0 or y1 < y0:
        return
    img[y0:y1 + 1, x0:x1 + 1] = color

def draw_text(img, x, y, text, scale, color):
    px = int(x); py = int(y)
    for ch in text.upper():
        g = FONT.get(ch, FONT[' '])
        for r in range(5):
            for c in range(3):
                if g[r][c] != '0':
                    draw_rect(img, px + c * scale, py + r * scale,
                              px + (c + 1) * scale - 1, py + (r + 1) * scale - 1,
                              color)
        px += (3 + 1) * scale

def draw_thick_line(img, x0, y0, x1, y1, color, thick):
    steps = max(int(np.hypot(x1 - x0, y1 - y0) * 1.5), 1)
    xs = np.linspace(x0, x1, steps)
    ys = np.linspace(y0, y1, steps)
    r = max(int(thick / 2), 1)
    for x, y in zip(xs, ys):
        draw_rect(img, int(x) - r, int(y) - r, int(x) + r, int(y) + r, color)

def draw_series(img, px0, py0, px1, py1, data, vmin, vmax, color, thick):
    npts = len(data)
    if npts < 2:
        return
    x = px0 + np.arange(npts) * (px1 - px0) / max(npts - 1, 1)
    y = py1 - (np.asarray(data, float) - vmin) / max(vmax - vmin, 1e-12) * (py1 - py0)
    for i in range(npts - 1):
        draw_thick_line(img, x[i], y[i], x[i + 1], y[i + 1], color, thick)

def make_figure(days, swe, depth, melt_c, refrz_c, run_c, mean_rho,
                out='results/snow_evolution.png'):
    W, Ht = 1560, 1080
    img = np.full((Ht, W, 3), 255, np.uint8)
    textc = (10, 10, 10)
    draw_text(img, 30, 25,
              "SNOWPACK 3-LAYER MODEL - 68 DAYS - DAILY STATE SNAPSHOTS", 5, textc)
    px0, py0, px1, py1 = 120, 170, 820, 500      # panel geometry (per panel)
    names = [("SWE [MM]", swe, (20, 90, 200)),
             ("SNOW DEPTH [M]", depth, (30, 160, 40)),
             ("MEAN DENSITY [KG/M3]", mean_rho, (160, 60, 160)),
             ("CUM MELT(BRN)/RUNOFF(BLU) [MM]", melt_c, (200, 130, 20))]
    for idx, (title, data, col) in enumerate(names):
        gx0 = px0 + (idx % 2) * (px1 - px0 + 150)
        gy0 = py0 + (idx // 2) * (py1 - py0 + 150)
        gx1 = gx0 + (px1 - px0); gy1 = gy0 + (py1 - py0)
        vmin = float(np.min(data)); vmax = float(np.max(data))
        if vmax - vmin < 1e-9:
            vmax = vmin + 1.0
        pad = (vmax - vmin) * 0.08
        vmin -= pad; vmax += pad
        # grid + axes
        for fy in range(5):
            gy = int(gy1 - (fy / 4) * (gy1 - gy0))
            draw_thick_line(img, gx0, gy, gx1, gy, (215, 215, 215), 1)
            val = vmin + (fy / 4) * (vmax - vmin)
            draw_text(img, gx0 - 12, gy - 6, "{:.1f}".format(val), 3, (70, 70, 70))
        draw_thick_line(img, gx0, gy1, gx1, gy1, (0, 0, 0), 2)
        draw_thick_line(img, gx0, gy0, gx0, gy1, (0, 0, 0), 2)
        for d in [0, 17, 34, 51, 67]:
            gx = int(gx0 + (d / 67) * (gx1 - gx0))
            draw_thick_line(img, gx, gy1, gx, gy1 + 6, (0, 0, 0), 2)
            draw_text(img, gx - 5, gy1 + 10, str(d), 3, (70, 70, 70))
        draw_series(img, gx0, gy0, gx1, gy1, data, vmin, vmax, col, 3)
        if idx == 3:
            draw_series(img, gx0, gy0, gx1, gy1, run_c, vmin, vmax, (10, 120, 200), 3)
        draw_text(img, gx0 + 5, gy0 - 24, title, 4, textc)
        draw_text(img, gx0 + 5, gy1 + 22, "DAY", 3, (70, 70, 70))
    draw_text(img, 30, Ht - 25,
              "TOP-LEFT:SWE  TOP-RIGHT:DEPTH  BOTTOM-LEFT:CUM MELT(BROWN)/RUNOFF(BLUE)  BOTTOM-RIGHT:MEAN DENSITY",
              3, (90, 90, 90))
    write_png(out, img)

# ---- main ------------------------------------------------------------------
def main():
    m0, w0, h0, T0, df = load_inputs()
    states, summary, total_runoff, final = run_model(m0, w0, h0, T0, df)
    mf, wf, hf, Tf = final

    os.makedirs('results', exist_ok=True)
    np.save('results/snow_state.npy', states.astype(np.float64))

    cols = ['day', 'swe_mm', 'snow_depth_m', 'melt_mm', 'refreeze_mm',
            'runoff_mm', 'mean_density_kg_m3']
    summ = pd.DataFrame(summary, columns=cols)
    summ.to_csv('results/snow_summary.csv', index=False)

    make_figure(summ['day'].values, summ['swe_mm'].values,
                summ['snow_depth_m'].values, np.cumsum(summ['melt_mm'].values),
                np.cumsum(summ['refreeze_mm'].values),
                np.cumsum(summ['runoff_mm'].values),
                summ['mean_density_kg_m3'].values)

    # diagnostics / mass balance
    swe_0 = float((m0 + w0).sum())
    swe_f = float(summ['swe_mm'].iloc[-1])
    snow_in = float(df['snowfall_mm_hr'].sum())
    rain_in = float(df['rainfall_mm_hr'].sum())
    closure = (swe_f + total_runoff) - (swe_0 + snow_in + rain_in)
    print("=" * 64)
    print("SNOWPACK 3-LAYER MODEL DIAGNOSTICS (68 days, hourly)")
    print("=" * 64)
    print(f"initial SWE        : {swe_0:.3f} mm")
    print(f"final SWE          : {swe_f:.3f} mm")
    print(f"snowfall input     : {snow_in:.3f} mm")
    print(f"rainfall input     : {rain_in:.3f} mm")
    print(f"total runoff       : {total_runoff:.3f} mm")
    print(f"final depth        : {summ['snow_depth_m'].iloc[-1]:.4f} m")
    print(f"final mean density : {summ['mean_density_kg_m3'].iloc[-1]:.1f} kg/m3")
    print("-" * 64)
    print("MASS BALANCE: (final SWE + runoff) - (init SWE + inputs) =")
    print(f"   {swe_f:.4f} + {total_runoff:.4f} - "
          f"({swe_0:.4f} + {snow_in:.4f} + {rain_in:.4f}) = {closure:.2e} mm")
    print(f"   closure / SWE0  = {closure / swe_0:.2e}")
    print("-" * 64)
    print("CUMULATIVE (68 days):")
    print(f"   melt     = {summ['melt_mm'].sum():.3f} mm")
