"""
analysis.py - Transmission-Line Target Prediction
(ASIBench electrical_engineering.lossy_tline_skin)

Goal: use calibration transmission-line data (calibration_lines.csv, calibration_transfer.csv)
to predict the INTRINSIC frequency-domain transfer functions and received pulse waveforms for
the target lines (same conductor family, different geometry/roughness).

Approach (validated by leave-one-out cross-validation on the 8 calibration lines):
 1. From calibration transfer extract, per calibration line and frequency, the intrinsic
    per-unit-length propagation constant gamma = alpha + j*beta.  The reported phase carries a
    constant per-line reference delay tau0 (~0.40-0.45 ns, length-independent -> NOT intrinsic);
    it is removed so everything below is intrinsic.
 2. gamma is modelled by gamma(f)=sqrt((R(f)+j*w*L'(f))*(G+j*w*C)) with CSV L,C,G and a
    frequency-dependent resistance R(f) plus a small low-frequency internal-inductance bump
    L'(f)=L*(1+eps(f)) (causal skin-effect phase correction).
 3. R(f) and L'(f) are smooth functions of geometry (width, roughness) and frequency, with
    surfaces fitted on the calibration lines; targets lie inside that envelope.
 4. Target intrinsic transfer: H_target(f)=exp(-gamma_target(f)*length).
 5. Waveform: rfft of the input pulse on the DFT grid (== frequency_grid), multiply by the
    intrinsic H, irfft -> output pulse.  Metrics computed from both pulses.

Conventions (as required): SI units, exp(+j*w*t) phasor, phase_rad unwrapped radians,
group_delay_s = -d(phase_rad)/d(omega).
"""
import numpy as np
import pandas as pd
from scipy.ndimage import gaussian_filter1d

try:
    import os
    os.makedirs('results', exist_ok=True)
except Exception:
    pass

DB2NP = 20.0/np.log(10.0)      # 8.6858896 dB -> neper (20log10); -magdB/DB2NP = nepers
np.seterr(divide='ignore', invalid='ignore')

# ---- 0. Load inputs ----
cal_lines = pd.read_csv('data/calibration_lines.csv')
cal_trans = pd.read_csv('data/calibration_transfer.csv')
tgt_lines = pd.read_csv('data/target_lines.csv')
fg        = pd.read_csv('data/frequency_grid.csv')['frequency_hz'].to_numpy()
pulse     = pd.read_csv('data/input_pulse.csv')
pulse_t   = pulse['time_s'].to_numpy()
pulse_v   = pulse['input_v'].to_numpy()

omega = 2.0*np.pi*fg
NF    = len(fg)                 # 2049 positive freqs incl DC
N     = len(pulse_v)            # 4096 time samples
dt    = pulse_t[1]-pulse_t[0]
assert np.allclose(fg, np.arange(N//2+1)/(dt*N)), 'frequency_grid must equal rfft grid'

# ---- 1. Extract intrinsic gamma / R(f) / L'(f) per calibration line ----
def extract_cal(lid, row, ct_sub):
    L   = row['length_m']; Lp = row['inductance_h_per_m']
    Cp  = row['capacitance_f_per_m']; Gp = row['conductance_s_per_m']
    Rdc = row['dc_resistance_ohm_per_m']
    s   = ct_sub.sort_values('frequency_hz')
    ph  = s['phase_rad'].to_numpy(); magdb = s['magnitude_db'].to_numpy()
    mask = omega > 40e9
    tau0 = np.median(-(ph[mask] + omega[mask]*np.sqrt(Lp*Cp)*L)/omega[mask])  # ref delay
    alpha = -magdb/DB2NP/L                       # neper/m (intrinsic)
    beta  = (-ph - omega*tau0)/L                # rad/m (intrinsic)
    Z  = (alpha + 1j*beta)**2/(Gp + 1j*omega*Cp)
    R  = Z.real.copy(); R[0] = Rdc; R = np.maximum(R, Rdc*0.5)
    Lmod = Z.imag/omega; Lmod[0] = Lmod[1]
    Lmod = gaussian_filter1d(Lmod, sigma=2.5, mode='nearest')
    return dict(L=L, Lp=Lp, Cp=Cp, Gp=Gp, Rdc=Rdc, width=row['trace_width_um'], rough=row['roughness_index'], tau0=tau0,
                alpha=alpha, beta=beta, R=R, Lmod=Lmod)

cal = {}
for _, row in cal_lines.iterrows():
    cal[row['line_id']] = extract_cal(row['line_id'], row,
                                      cal_trans[cal_trans['line_id'] == row['line_id']])
cal_ids = list(cal.keys())

# ---- 2. R(f; width, roughness): per-line cubic in log10(f), linear surface on (w, r) ----
lf = np.log10(fg[1:])
def polyA(order):
    return np.column_stack([lf**k for k in range(order+1)])
ORDER = 3
A = polyA(ORDER)

def line_rcoefs(lid):
    co, *_ = np.linalg.lstsq(A, np.log10(cal[lid]['R'][1:]), rcond=None)
    return co
RC = np.array([line_rcoefs(l) for l in cal_ids])

def surf_design(feat):
    return np.column_stack([np.ones(len(feat)), feat[:,0], feat[:,1]])
def surf_ev(wt, rt):
    return np.array([1.0, wt, rt])

wr = np.array([[cal[l]['width'], cal[l]['rough']] for l in cal_ids])
coef_R, *_ = np.linalg.lstsq(surf_design(wr), RC, rcond=None)      # (3, ORDER+1)

def predict_R(width_um, roughness):
    cnew = surf_ev(width_um, roughness) @ coef_R
    R = np.empty(NF); R[0] = np.nan; R[1:] = 10.0**(A @ cnew)
    return R

# ---- 3. L'(f): eps(f)=Lmod/Lp-1 predicted from width (linear in 1/width) ----
Wcal  = np.array([cal[l]['width'] for l in cal_ids])
Lpcal = np.array([cal[l]['Lp'] for l in cal_ids])
Lmcal = np.array([cal[l]['Lmod'] for l in cal_ids])
eps   = Lmcal/Lpcal[:, None] - 1.0
Xe    = np.column_stack([np.ones(len(cal_ids)), 1.0/Wcal])
coef_eps, *_ = np.linalg.lstsq(Xe, eps, rcond=None)                # (2, NF)

def predict_Lmod_f(width_um):
    return 1.0 + np.array([1.0, 1.0/width_um]) @ coef_eps

# ---- 4. Gamma and intrinsic transfer for an arbitrary line ----
def line_gamma_transfer(L, Lp, Cp, Gp, Rtot, Lratio):
    R = np.maximum(Rtot.copy(), 1e-7)
    gam = np.sqrt((R + 1j*omega*(Lp*Lratio)) * (Gp + 1j*omega*Cp))
    return gam, np.exp(-gam*L)

# ---- 5. Deliverables ----
def fwhm(t, v):
    imax = int(np.argmax(v)); vmax = v[imax]; hm = vmax/2.0
    i2 = imax
    while i2 < len(v)-1 and v[i2] >= hm: i2 += 1
    f_b = t[i2-1] + (hm-v[i2-1])*(t[i2]-t[i2-1])/(v[i2]-v[i2-1]) if i2 > imax else t[-1]
    i1 = imax
    while i1 > 0 and v[i1] >= hm: i1 -= 1
    r_b = t[i1+1] + (hm-v[i1+1])*(t[i1]-t[i1+1])/(v[i1]-v[i1+1]) if i1 < imax else t[0]
    return f_b - r_b

Pt = np.fft.rfft(pulse_v)
t_input_peak = pulse_t[int(np.argmax(pulse_v))]
in_fwhm = fwhm(pulse_t, pulse_v)
in_e = np.sum(pulse_v**2)
i_peak_in = int(np.argmax(pulse_v))

transfer_rows, waveform_rows, metric_rows = [], [], []
for _, trow in tgt_lines.iterrows():
    tid = trow['line_id']
    L = trow['length_m']; Lp = trow['inductance_h_per_m']; Cp = trow['capacitance_f_per_m']
    Gp = trow['conductance_s_per_m']; RdcG = trow['dc_resistance_ohm_per_m']
    wt = trow['trace_width_um']; rt = trow['roughness_index']
    Rtot = predict_R(wt, rt); Rtot[0] = RdcG
    Lratio = predict_Lmod_f(wt)
    gamma, H = line_gamma_transfer(L, Lp, Cp, Gp, Rtot, Lratio)
    magdb = 20.0*np.log10(np.abs(H))
    phase = -np.imag(gamma)*L
    gd    = -np.gradient(phase, omega)
    atten = np.real(gamma)
    for k in range(NF):
        transfer_rows.append((tid, fg[k], magdb[k], phase[k], gd[k], atten[k]))
    out_v = np.fft.irfft(Pt*H, n=N)
    out_fwhm = fwhm(pulse_t, out_v)
    io = int(np.argmax(out_v))
    out_e = np.sum(out_v**2)
    out_tail_ratio = np.sum(out_v[io+1:]**2)/max(np.sum(out_v[:io]**2), 1e-30)
    metric_rows.append(dict(target_id=tid, input_fwhm_s=in_fwhm, output_fwhm_s=out_fwhm,
        fwhm_broadening_ratio=out_fwhm/in_fwhm,
        peak_delay_s=pulse_t[io]-t_input_peak, output_peak_time_s=pulse_t[io],
        energy_ratio=out_e/in_e, tail_asymmetry=out_tail_ratio))
    for k in range(N):
        waveform_rows.append((tid, pulse_t[k], pulse_v[k], out_v[k]))

pd.DataFrame(transfer_rows, columns=['target_id','frequency_hz','magnitude_db','phase_rad',
                                     'group_delay_s','attenuation_np_per_m']).to_csv(
    'results/target_transfer.csv', index=False)
pd.DataFrame(waveform_rows, columns=['target_id','time_s','input_v','output_v']).to_csv(
    'results/target_waveforms.csv', index=False)
pd.DataFrame(metric_rows).to_csv('results/pulse_metrics.csv', index=False)

# ---- 6. Validation ----
def model_line_transfer(meta, Rtot, Lratio):
    R = np.maximum(Rtot.copy(), 1e-7)
    gam = np.sqrt((R + 1j*omega*(meta['Lp']*Lratio))*(meta['Gp'] + 1j*omega*meta['Cp']))
    return np.exp(-gam*meta['L'])

loo = dict(rmsdB=[], maxdB=[], rmsPh=[], maxPh=[], pkerr=[])
for hold in cal_ids:
    fit = [l for l in cal_ids if l != hold]
    wrf = np.array([[cal[l]['width'], cal[l]['rough']] for l in fit])
    RCf = np.array([line_rcoefs(l) for l in fit])
    cof, *_ = np.linalg.lstsq(surf_design(wrf), RCf, rcond=None)
    Rpred = np.empty(NF); Rpred[0] = cal[hold]['Rdc']
    cn = surf_ev(cal[hold]['width'], cal[hold]['rough']) @ cof
    Rpred[1:] = 10.0**(A @ cn)
    Wf = np.array([cal[l]['width'] for l in fit]); Lpf = np.array([cal[l]['Lp'] for l in fit])
    Lmf = np.array([cal[l]['Lmod'] for l in fit]); epf = Lmf/Lpf[:,None]-1.0
    Xef = np.column_stack([np.ones(len(fit)), 1.0/Wf])
    cof2, *_ = np.linalg.lstsq(Xef, epf, rcond=None)
    Lrat = 1.0 + np.array([1.0, 1.0/cal[hold]['width']]) @ cof2
    Hp = model_line_transfer(cal[hold], Rpred, Lrat)
    Ht = np.exp(-(cal[hold]['alpha'] + 1j*cal[hold]['beta'])*cal[hold]['L'])
    m = fg > 1e6
    dBo = 20*np.log10(np.abs(Hp)) - 20*np.log10(np.abs(Ht))
    pho = np.angle(Hp*np.conj(Ht))
    loo['rmsdB'].append(np.sqrt(np.mean(dBo[m]**2)))
    loo['maxdB'].append(np.max(np.abs(dBo[m])))
    loo['rmsPh'].append(np.sqrt(np.mean(pho[m]**2)))
    loo['maxPh'].append(np.max(np.abs(pho[m])))
    yp = np.fft.irfft(Pt*Hp, n=N); yt = np.fft.irfft(Pt*Ht, n=N)
    loo['pkerr'].append(abs(yp.max()-yt.max())/yt.max()*100.0)

tr1 = pd.read_csv('results/target_transfer.csv')
tr1 = tr1[tr1.target_id == tgt_lines.iloc[0].line_id].reset_index(drop=True)
gd1_num = -np.gradient(tr1['phase_rad'].to_numpy(), omega)
gd_rel = np.abs(gd1_num-tr1['group_delay_s'])/np.maximum(np.abs(tr1['group_delay_s']),1e-12)
wv1 = pd.read_csv('results/target_waveforms.csv')
wv1 = wv1[wv1.target_id == tgt_lines.iloc[0].line_id].reset_index(drop=True)
causal_pre = float(wv1['output_v'].iloc[:32].abs().max())

summary = dict(
    calibration_lines=cal_lines.shape[0], target_lines=tgt_lines.shape[0],
    transfer_rows=len(transfer_rows), waveform_rows=len(waveform_rows),
    LOO_rmsdB_mean=float(np.mean(loo['rmsdB'])), LOO_maxdB_mean=float(np.mean(loo['maxdB'])),
    LOO_rmsPh_mean=float(np.mean(loo['rmsPh'])), LOO_maxPh_mean=float(np.mean(loo['maxPh'])),
    LOO_pkerr_mean_pct=float(np.mean(loo['pkerr'])),
    tau0_ns_per_line={l: float(cal[l]['tau0']*1e9) for l in cal_ids},
    group_delay_max_rel_err=float(np.max(gd_rel[fg > 1e6])),
    output_precursor_max_v=causal_pre)
print('=== Validation summary ===')
for k, v in summary.items():
    print(f'  {k}: {v}')
print('  pulse_metrics:')
print(pd.DataFrame(metric_rows).to_string(index=False))
pd.DataFrame([{'metric': k, 'value': v} for k, v in summary.items()]).to_csv(
    'results/validation_summary.csv', index=False)
print('Done. Wrote results/target_transfer.csv, results/target_waveforms.csv, results/pulse_metrics.csv')
