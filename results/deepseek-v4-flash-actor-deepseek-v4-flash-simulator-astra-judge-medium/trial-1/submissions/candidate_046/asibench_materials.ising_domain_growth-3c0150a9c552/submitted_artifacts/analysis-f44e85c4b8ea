"""Post-hoc verification of all B3 output artifacts (evidence for handoff)."""
import json, os, numpy as np
from scipy import stats

ok = True
def req(cond, msg):
    global ok
    print(('PASS  ' if cond else 'FAIL  ') + msg)
    ok = ok and bool(cond)

par = json.load(open('data/parameters.json'))
n_meas, n_snap, max_r, G = par['n_measurements'], par['n_snapshots'], par['max_r'], par['grid_size']
mt = par['measurement_times']

A = np.load('seriesA.npy'); B = np.load('seriesB.npy')
C = np.load('stackC.npy'); D = np.load('stackD.npy'); E = np.load('stackE.npy')

req(A.shape == (2, n_meas), 'seriesA shape (2,%d)' % n_meas)
req(B.shape == (2, n_meas), 'seriesB shape (2,%d)' % n_meas)
req(C.shape == (n_snap, max_r), 'stackC shape (%d,%d)' % (n_snap, max_r))
req(D.shape == (n_snap, G), 'stackD shape (%d,%d)' % (n_snap, G))
req(E.shape == (n_snap, 2, G), 'stackE shape (%d,2,%d)' % (n_snap, G))
for nm, arr in [('seriesA', A), ('seriesB', B), ('stackC', C), ('stackD', D), ('stackE', E)]:
    req(arr.dtype == np.float64, '%s dtype float64' % nm)
    req(np.all(np.isfinite(arr)), '%s all finite' % nm)

metaA = json.load(open('metadataA.json'))
metaB = json.load(open('metadataB.json'))
req(set(metaA) == {'collapse_check_applicable','collapse_quality','collapse_relative_rms_spread',
                   'collapse_dimension','collapse_snapshot_times','collapse_lengths',
                   'collapse_x_range','collapse_grid_size','notes'}, 'metadataA exact keys')
req(set(metaB) == {'exponent','exponent_std_error','amplitude','fit_range','r_squared','notes'},
    'metadataB exact keys')
req(metaA['collapse_dimension'] == 2, 'collapse_dimension == 2')
req(metaA['collapse_grid_size'] == G, 'collapse_grid_size == grid_size')
req(isinstance(metaA['collapse_check_applicable'], bool), 'collapse_check_applicable bool')
q = metaA['collapse_quality']
req(q is None or (0.0 <= q <= 1.0), 'collapse_quality in [0,1] or null (%s)' % q)
req(len(metaA['collapse_snapshot_times']) == len(metaA['collapse_lengths']) == n_snap,
    'collapse snapshot/length lists length == n_snapshots')
req(isinstance(metaB['exponent'], float) and isinstance(metaB['r_squared'], (int, float)),
    'exponent/r_squared numeric')
print('exponent=%.4f +/- %.4f amp=%.4f R2=%.4f fit_range=%s' %
      (metaB['exponent'], metaB['exponent_std_error'], metaB['amplitude'],
       metaB['r_squared'], metaB['fit_range']))
print('collapse quality=%.4f spread=%.4f xrange=%s' %
      (q, metaA['collapse_relative_rms_spread'], metaA['collapse_x_range']))
req(os.path.exists('figure.png') and open('figure.png','rb').read(8)[:8] == b'\x89PNG\r\n\x1a\n',
    'figure.png exists and has PNG magic')
print('ALL CHECKS PASS' if ok else 'SOME CHECKS FAILED')
