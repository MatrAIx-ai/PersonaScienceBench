#!/usr/bin/env python3
"""
B3: Hidden Binary-Grid Time Evolution - 2D Ising domain growth.

Model inferred from data/parameters.json + data/initial_state.npy:
  2D Ising ferromagnet (J=1, zero field) at reduced temperature T = `control`.
  control = 2.0236 < Tc(2D Ising) = 2/ln(1+sqrt(2)) ~ 2.269  -> order-parameter
  coarsening / domain growth. Dynamics = single-spin-flip METROPOLIS, periodic
  boundaries, one Monte Carlo sweep = checkerboard update of all even (i+j even)
  then all odd sites. Random numbers from np.random.default_rng(dynamics_seed).

Outputs (exact contract):
  simulation.py, seriesA.npy [2,170], seriesB.npy [2,170], stackC.npy [6,50],
  stackD.npy [6,100], stackE.npy [6,2,100], metadataA.json, metadataB.json,
  figure.png.

Observables:
  seriesA[0] = |magnetization|/N ; seriesA[1] = energy/site E/N.
  seriesB[0] = L_zero (first zero crossing of the axial correlation, avg x/y);
  seriesB[1] = L_int   (integral scale = sum_{r=1}^{max_r-1} C_rad(r)).
  stackC = radial C(r)=mean(Cx,Cy), r=0..max_r-1; stackD = Cx(r), r=0..grid-1;
  stackE = [Cx, Cy] full range, both axes.
  metadataA = dynamic-scaling collapse of C(r,t) vs r/L(t); metadataB = OLS
  power-law fit L_int(t) = A * t^n in log-log on an adaptive window.
  figure.png = 3x2 diagnostic (matplotlib when available, else a pure
  numpy+stdlib PNG fallback so the required artifact is always produced).
"""
import json
import os
import numpy as np

# ----------------------------------------------------------------------------
# 1) Inputs
# ----------------------------------------------------------------------------
BASE = os.path.dirname(os.path.abspath(__file__))
with open(os.path.join(BASE, "data", "parameters.json")) as f:
    PAR = json.load(f)

G = int(PAR["grid_size"])            # 100
TEMP = float(PAR["control"])         # 2.0236 (Ising temperature)
N_STEPS = int(PAR["n_steps"])        # 12305
SNAP_T = [float(t) for t in PAR["snapshot_times"]]       # 6
MEAS_T = [float(t) for t in PAR["measurement_times"]]    # 170
MAX_R = int(PAR["max_r"])            # 50
SEED = int(PAR["dynamics_seed"])     # 1802725656

state0 = np.load(os.path.join(BASE, "data", "initial_state.npy"))
assert state0.shape == (G, G)
assert set(np.unique(state0)) <= {-1, 1}
state = state0.astype(np.int8).copy()
BETA = 1.0 / TEMP
N = G * G

# ----------------------------------------------------------------------------
# 2) Dynamics helpers
# ----------------------------------------------------------------------------
def neighbor_sum(s):
    """Sum of the 4 nearest neighbours (periodic wrap)."""
    return (np.roll(s, 1, axis=0) + np.roll(s, -1, axis=0) +
            np.roll(s, 1, axis=1) + np.roll(s, -1, axis=1))

def energy_per_site(s):
    """E/N = -0.5 * mean(s * neighbor_sum)."""
    return -0.5 * float(np.mean(s.astype(np.float64) * neighbor_sum(s)))

def correlations_xy(s, rmax):
    """Cx(r), Cy(r), r = 0..rmax-1 (periodic; C(0)=1)."""
    s = s.astype(np.float64)
    cx = np.empty(rmax); cy = np.empty(rmax)
    cx[0] = 1.0; cy[0] = 1.0
    for r in range(1, rmax):
        cx[r] = float(np.mean(s * np.roll(s, -r, axis=1)))
        cy[r] = float(np.mean(s * np.roll(s, -r, axis=0)))
    return cx, cy

def first_zero_avg(cx, cy):
    """Interpolated first zero crossing (mean over both axes); cap = size."""
    out = []
    for c in (cx, cy):
        found = None
        for r in range(len(c) - 1):
            if c[r] > 0.0 >= c[r + 1]:
                denom = c[r] - c[r + 1]
                found = r + c[r] / denom if denom > 0 else r + 1.0
                break
        out.append(float(found if found is not None else len(c)))
    return 0.5 * (out[0] + out[1])

# checkerboard parity masks (fixed)
iy, ix = np.indices((G, G))
even_mask = ((iy + ix) % 2 == 0)
odd_mask = ~even_mask

# ----------------------------------------------------------------------------
# 3) Main run: Metropolis sweeps + measurements
# ----------------------------------------------------------------------------
rng = np.random.default_rng(SEED)
n_meas = len(MEAS_T)
meas_index = {int(t): k for k, t in enumerate(MEAS_T)}     # all integer-valued
seriesA = np.zeros((2, n_meas), dtype=np.float64)
seriesB = np.zeros((2, n_meas), dtype=np.float64)

snap_pos = {int(t): k for k, t in enumerate(SNAP_T)}
stackC = np.zeros((len(SNAP_T), MAX_R), dtype=np.float64)
stackD = np.zeros((len(SNAP_T), G), dtype=np.float64)
stackE = np.zeros((len(SNAP_T), 2, G), dtype=np.float64)
snap_states = [None] * len(SNAP_T)          # spin configs for the figure
snap_lint = np.zeros(len(SNAP_T), dtype=np.float64)   # L_int at snapshots
snap_lzero = np.zeros(len(SNAP_T), dtype=np.float64)  # L_zero at snapshots

one = np.float64(1.0)
for t in range(1, N_STEPS + 1):
    # black/even sweep
    h = neighbor_sum(state)
    dE = 2.0 * state * h
    p = np.exp(-BETA * dE)
    state = np.where(even_mask & (rng.random((G, G)) < np.minimum(one, p)),
                     -state, state)
    # white/odd sweep
    h = neighbor_sum(state)
    dE = 2.0 * state * h
    p = np.exp(-BETA * dE)
    state = np.where(odd_mask & (rng.random((G, G)) < np.minimum(one, p)),
                     -state, state)

    if t in meas_index or t in snap_pos:
        h = neighbor_sum(state)
        s_f = state.astype(np.float64)
        cx_all, cy_all = correlations_xy(state, G)       # full range
        cx_half, cy_half = cx_all[:MAX_R], cy_all[:MAX_R]
        crad = 0.5 * (cx_half + cy_half)
        lzero = first_zero_avg(cx_all, cy_all)
        lint = float(np.sum(crad[1:]))                    # integral scale, r=1..
        if t in meas_index:
            k = meas_index[t]
            seriesA[0, k] = abs(float(np.mean(s_f)))
            seriesA[1, k] = -0.5 * float(np.mean(s_f * h))
            seriesB[0, k] = lzero
            seriesB[1, k] = lint
        if t in snap_pos:
            k = snap_pos[t]
            stackC[k] = crad
            stackD[k] = cx_all
            stackE[k, 0, :] = cx_all
            stackE[k, 1, :] = cy_all
            snap_states[k] = state.copy()
            snap_lint[k] = lint
            snap_lzero[k] = lzero

final_state = state.copy()
np.save(os.path.join(BASE, "seriesA.npy"), seriesA)
np.save(os.path.join(BASE, "seriesB.npy"), seriesB)
np.save(os.path.join(BASE, "stackC.npy"), stackC)
np.save(os.path.join(BASE, "stackD.npy"), stackD)
np.save(os.path.join(BASE, "stackE.npy"), stackE)

# ----------------------------------------------------------------------------
# 4) metadataA: dynamic-scaling collapse (C(r,t) vs r/L(t))
# ----------------------------------------------------------------------------
L_snap = snap_lint.copy()   # L_int evaluated at each snapshot time
notesA = []
collapse_applicable = True

# common x-band covered by all snapshots
x_avail = np.array([(MAX_R - 1) / Lk for Lk in L_snap])
x_min = 0.5
x_max = min(2.5, float(x_avail.min()))
if x_max <= x_min + 1e-6:
    x_min = 0.25
    x_max = max(x_max, x_min + 0.5)
xg = np.linspace(x_min, x_max, 48)
C_interp = np.empty((len(SNAP_T), xg.size))
for k in range(len(SNAP_T)):
    r_k = np.arange(MAX_R, dtype=np.float64)
    x_k = r_k / L_snap[k]
    C_interp[k] = np.interp(xg, x_k, stackC[k])
mean_curve = C_interp.mean(axis=0)
std_curve = C_interp.std(axis=0)
# restrict to region where the collapsed function is comfortably above zero
mask = mean_curve >= 0.20
if mask.sum() < 4:
    mask = np.ones_like(mean_curve, dtype=bool)
rel_spread = float(np.sqrt(np.mean((std_curve[mask] / mean_curve[mask]) ** 2)))
collapse_quality = float(1.0 - min(1.0, rel_spread))
notesA += [
    "Ising domain growth: radial C(r)=mean(Cx,Cy), r=0..%d." % (MAX_R - 1),
    "Length L(t)=L_int=sum_{r=1}^{max_r-1} C_rad(r) at each snapshot.",
    "Collapse x=r/L evaluated on common band [%.3f, %.3f]; C(x)>=0.20 mask." % (x_min, x_max),
    "collapse_quality = 1 - clip(relative_rms_spread,0,1); 1 = perfect collapse.",
    "Expected ideal collapse for 2D non-conserved coarsening; finite-size/early-time deviations noted.",
]

metadataA = {
    "collapse_check_applicable": bool(collapse_applicable),
    "collapse_quality": collapse_quality,
    "collapse_relative_rms_spread": rel_spread,
    "collapse_dimension": 2,
    "collapse_snapshot_times": [float(t) for t in SNAP_T],
    "collapse_lengths": [float(l) for l in L_snap],
    "collapse_x_range": [float(x_min), float(x_max)],
    "collapse_grid_size": int(G),
    "notes": notesA,
}
with open(os.path.join(BASE, "metadataA.json"), "w") as f:
    json.dump(metadataA, f, indent=2)

# ----------------------------------------------------------------------------
# 5) metadataB: power law L_int(t) = A t^n (OLS in log10-log10)
# ----------------------------------------------------------------------------
t = np.array(MEAS_T, dtype=np.float64)
L = seriesB[1].copy()
Lmax_w = G / 4.0
win = (L >= 2.0) & (L <= Lmax_w)
if win.sum() < 5:              # fallback window if adaptive rule too narrow
    win = np.argsort(L)[max(0, len(L) - 60):]
fit_t = t[win]
fit_L = L[win]
from scipy import stats as _stats
slope, intercept, rval, pval, stderr = _stats.linregress(np.log10(fit_t),
                                                         np.log10(fit_L))
exponent = float(slope)
amplitude = float(10.0 ** intercept)
r_squared = float(rval ** 2)
fit_range = [float(fit_t.min()), float(fit_t.max())]
notesB = [
    "OLS on log10(L_int) vs log10(t); L_int integral scale (r=1..max_r-1).",
    "Adaptive window: measurement times with 2 <= L_int <= grid_size/4 (%.1f)." % (G / 4.0),
    "Actual fit_range=[%.1f, %.1f], %d points." % (fit_range[0], fit_range[1], win.sum()),
    "Expected n ~ 0.5 for 2D non-conserved (Ising) coarsening; finite-size/transient effects may bias.",
]
metadataB = {
    "exponent": exponent,
    "exponent_std_error": float(stderr),
    "amplitude": amplitude,
    "fit_range": fit_range,
    "r_squared": r_squared,
    "notes": notesB,
}
with open(os.path.join(BASE, "metadataB.json"), "w") as f:
    json.dump(metadataB, f, indent=2)

# ----------------------------------------------------------------------------
# 6) figure.png diagnostic
# ----------------------------------------------------------------------------
def _draw_figure(mpl_ok):
    """Save figure.png. Uses matplotlib if available, else pure-numpy fallback."""
    if mpl_ok:
        import matplotlib
        matplotlib.use("Agg")
        import matplotlib.pyplot as plt
        fig, axs = plt.subplots(2, 3, figsize=(15, 9))
        for ax, s, title in ((axs[0, 0], state0, "initial t=0"),
                             (axs[0, 1], snap_states[3], "snapshot t=%.0f" % SNAP_T[3]),
                             (axs[0, 2], final_state, "final t=%.0f" % N_STEPS)):
            ax.imshow(s, cmap="RdBu_r", vmin=-1, vmax=1)
            ax.set_title(title, fontsize=10)
            ax.set_xticks([]); ax.set_yticks([])
        ax = axs[1, 0]
        ax.plot(t, seriesA[0], "b-", label=r"$|m|/N$")
        ax.set_xscale("log")
        ax.set_ylabel(r"$|m|/N$"); ax.set_xlabel("t")
        ax2 = ax.twinx()
        ax2.plot(t, seriesA[1], "r-", label="E/N")
        ax2.set_ylabel("E/N", color="r")
        ax.set_title("seriesA", fontsize=10)
        lines = ax.get_lines() + ax2.get_lines()
        ax.legend(lines, [l.get_label() for l in lines], fontsize=8, loc="best")
        ax = axs[1, 1]
        ax.plot(t, seriesB[1], "k.", ms=3, label="L_int")
        tt = np.linspace(fit_range[0], fit_range[1], 100)
        ax.plot(tt, amplitude * tt ** exponent, "g-", lw=2,
                label="fit A t^%.3f" % exponent)
        ax.set_xscale("log"); ax.set_yscale("log")
        ax.set_xlabel("t"); ax.set_ylabel("L_int")
        ax.set_title("seriesB + power law", fontsize=10)
        ax.legend(fontsize=8)
        ax = axs[1, 2]
        for k in range(len(SNAP_T)):
            r_k = np.arange(MAX_R)
            ax.plot(r_k / L_snap[k], stackC[k], ".-", ms=4,
                    label="t=%.0f" % SNAP_T[k])
        ax.set_xlabel("r / L(t)"); ax.set_ylabel("C(r,t)")
        ax.set_title("collapse check", fontsize=10)
        ax.legend(fontsize=8)
        fig.suptitle("B3 Ising domain growth (T=%.4f, L=%d, seed=%d)"
                     % (TEMP, G, SEED), fontsize=12)
        fig.tight_layout(rect=(0, 0, 1, 0.96))
        fig.savefig(os.path.join(BASE, "figure.png"), dpi=110)
        plt.close(fig)
        return

    # ---- pure numpy + stdlib fallback PNG writer (no matplotlib installed) ----
    import zlib, struct

    def write_png(path, rgb):
        h, w, _ = rgb.shape
        raw = b"".join(b"\x00" + rgb[y].tobytes() for y in range(h))
        def chunk(typ, data):
            c = struct.pack(">I", len(data)) + typ + data
            return c + struct.pack(">I", zlib.crc32(typ + data) & 0xffffffff)
        ihdr = struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0)
        png = (b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", ihdr) +
               chunk(b"IDAT", zlib.compress(raw)) + chunk(b"IEND", b""))
        with open(path, "wb") as f:
            f.write(png)

    W, H = 1500, 1000
    canvas = np.full((H, W, 3), 255, dtype=np.uint8)

    def panel(px, py, pw, ph):
        x0, x1, y0, y1 = px, px + pw, py, py + ph
        canvas[y0:y1, x0:x1] = 235
        canvas[y0, x0:x1] = canvas[y1 - 1, x0:x1] = 140
        canvas[y0:y1, x0] = canvas[y0:y1, x1 - 1] = 140
        return x0, x1, y0, y1

    def heatmap(arr, box):
        x0, x1, y0, y1 = box
        A = np.where(arr.astype(np.float64) > 0, 1.0, -1.0)
        hh, ww = A.shape
        xs = np.linspace(x0 + 2, x1 - 2, ww).astype(int)
        ys = np.linspace(y0 + 2, y1 - 2, hh).astype(int)
        X, Y = np.meshgrid(xs, ys)
        col = np.zeros((hh, ww, 3))
        col[A > 0] = [230, 60, 40]      # positive / spin up (red)
        col[A <= 0] = [40, 80, 220]     # negative / spin down (blue)
        canvas[Y, X] = col

    def line_plot(box, series_list, xlog=False, ylog=False):
        """series_list: list of (x, y, rgb) tuples drawn on a shared log/lin scale."""
        x0, x1, y0, y1 = box
        allx = np.concatenate([np.asarray(s[0], float) for s in series_list])
        ally = np.concatenate([np.asarray(s[1], float) for s in series_list])
        ok = np.isfinite(allx) & np.isfinite(ally) & (allx > 0) & (ally > 0)
        allx, ally = allx[ok], ally[ok]
        ax0, ax1 = float(allx.min()), float(allx.max())
        ay0, ay1 = float(ally.min()), float(ally.max())
        if ay1 - ay0 <= 0: ay1 = ay0 + 1
        if ax1 - ax0 <= 0: ax1 = ax0 + 1
        fn = (lambda v, a, b: (np.log(v) - np.log(a)) / (np.log(b) - np.log(a))) \
            if xlog else (lambda v, a, b: (v - a) / (b - a))
        gn = (lambda v, a, b: (np.log(v) - np.log(a)) / (np.log(b) - np.log(a))) \
            if ylog else (lambda v, a, b: (v - a) / (b - a))
        # axes frame
        canvas[y1 - 4, x0:x1] = 0
        canvas[y0:y1, x0 + 4] = 0
        for xs_, ys_, col in series_list:
            xs_ = np.asarray(xs_, float); ys_ = np.asarray(ys_, float)
            fx = fn(xs_, ax0, ax1)
            fy = gn(ys_, ay0, ay1)
            px = (x0 + 4 + fx * (x1 - x0 - 12)).astype(int)
            py = (y1 - 4 - fy * (y1 - y0 - 12)).astype(int)
            for i in range(len(px) - 1):
                xa, ya = int(px[i]), int(py[i])
                xb, yb = int(px[i + 1]), int(py[i + 1])
                nn = max(abs(xb - xa), abs(yb - ya), 1)
                for fr in np.linspace(0, 1, nn + 1):
                    xx = int(round(xa + fr * (xb - xa)))
                    yy = int(round(ya + fr * (yb - ya)))
                    if x0 <= xx < x1 and y0 <= yy < y1:
                        canvas[yy - 1:yy + 2, xx - 1:xx + 2] = col
        return

    pw, ph = (W - 90) // 3, (H - 180) // 2
    boxes = []
    for r in range(2):
        for c in range(3):
            px = 20 + c * (pw + 15)
            py = 20 + r * (ph + 15)
            boxes.append(panel(px, py, pw, ph))
    # row 0: heatmaps (initial / mid / final)
    heatmap(state0, boxes[0])
    mid = snap_states[2] if snap_states[2] is not None else final_state
    heatmap(mid, boxes[1])
    heatmap(final_state, boxes[2])
    # row 1 col 0: seriesA (|m|/N in blue, rescaled E/N in red)
    line_plot(boxes[3], [(t, seriesA[0], (30, 60, 180)),
                         (t, (seriesA[1] + 2.0) / 2.0, (200, 40, 40))], ylog=False)
    # row 1 col 1: L_int + power-law fit (log-log)
    tt = np.linspace(fit_range[0], fit_range[1], 60)
    line_plot(boxes[4], [(t, seriesB[1], (40, 40, 40)),
                         (tt, amplitude * tt ** exponent, (30, 180, 60))],
              xlog=True, ylog=True)
    # row 1 col 2: collapse curves C vs r/L
    coll = [(np.arange(MAX_R) / L_snap[k], stackC[k],
             (200 - k * 20 % 150, 60 + k * 25 % 120, 120 + k * 20 % 100))
            for k in range(len(SNAP_T))]
    line_plot(boxes[5], coll, xlog=False, ylog=False)
    write_png(os.path.join(BASE, "figure.png"), canvas)

# decide: can we import matplotlib?
try:
    import matplotlib  # noqa
    _draw_figure(True)
except Exception as e:
    print("matplotlib unavailable (%s); using pure-numpy fallback figure." % e)
    _draw_figure(False)

# ----------------------------------------------------------------------------
# 7) Sanity summary (stdout)
# ----------------------------------------------------------------------------
print("== artifacts ==")
for fname in ["simulation.py", "seriesA.npy", "seriesB.npy", "stackC.npy",
              "stackD.npy", "stackE.npy", "metadataA.json", "metadataB.json",
              "figure.png"]:
    p = os.path.join(BASE, fname)
    print("%-18s %s" % (fname, os.path.exists(p)))
for name, arr in [("seriesA", seriesA), ("seriesB", seriesB),
                  ("stackC", stackC), ("stackD", stackD), ("stackE", stackE)]:
    print("%-8s shape=%s finite=%s min=%.4f max=%.4f" %
          (name, arr.shape, bool(np.all(np.isfinite(arr))), np.min(arr), np.max(arr)))
print("final |m|/N =", abs(float(np.mean(final_state))))
print("metadataA: applicable=%s quality=%.4f spread=%.4f xrange=%s Lsnap=%s" %
      (metadataA["collapse_check_applicable"], collapse_quality, rel_spread,
       metadataA["collapse_x_range"], np.round(L_snap, 3)))
print("metadataB: n=%.4f +/- %.4f amp=%.4f range=%s R2=%.4f" %
      (exponent, stderr, amplitude, fit_range, r_squared))
