"""analysis.py
Action-selection model for deterministic symbolic grid-search problems.

Learns (inside make_policy) a softmax classifier that predicts the next action
from local observations, using the solved training trajectories. Combines the
learned probabilities with strong empirical priors (momentum, no 180-degree
reversals, open-perpendicular turns) so the returned scores guide a
policy-based best-first search with very few expansions.
"""

import numpy as np

ACTIONS = ["U", "D", "L", "R"]
DIRS = {"U": (-1, 0), "D": (1, 0), "L": (0, -1), "R": (0, 1)}
OPP = {"U": "D", "D": "U", "L": "R", "R": "L"}
LETTERS = "abcdefghijklmnopqrst"
ALL_CHARS = LETTERS + "G"
ACH = {a: i for i, a in enumerate(ACTIONS)}


def _as_scalar(v):
    return v.item() if isinstance(v, np.generic) else v


def _parse_neighbors(state):
    """Return list of 4 items in U,D,L,R order (char or None)."""
    neighbors = state.get("neighbors")
    out = [None] * 4
    if neighbors is None:
        return out
    if isinstance(neighbors, str):
        for i, ch in enumerate(neighbors[:4]):
            out[i] = ch
        return out
    try:
        lst = list(neighbors)
    except TypeError:
        return out
    for i, v in enumerate(lst[:4]):
        if isinstance(v, str):
            out[i] = v[0] if v else None
        elif isinstance(v, dict):
            c = v.get("char") or v.get("symbol") or v.get("tile") or v.get("cell")
            out[i] = (c[0] if isinstance(c, str) and c else None)
        elif v is not None:
            out[i] = str(v)[0]
    return out


def _parse_prev(state):
    p = state.get("previous_action")
    if p is None:
        return None
    if isinstance(p, str) and p in ACTIONS:
        return p
    p = _as_scalar(p)
    if isinstance(p, (int, np.integer)) and 0 <= int(p) < 4:
        return ACTIONS[int(p)]
    return None


def _parse_action_seq(x):
    """Normalize an action container (list/str/ndarray/None) to a list of
    action strings, ignoring non-action tokens (e.g. tile letters)."""
    if x is None:
        return []
    if isinstance(x, np.ndarray):
        x = x.tolist() if x.ndim else [x.item()]
    if isinstance(x, str):
        return [ch for ch in x if ch in ACTIONS]
    try:
        out = []
        for v in x:
            v = _as_scalar(v)
            if isinstance(v, str) and v in ACTIONS:
                out.append(v)
            elif isinstance(v, (int, np.integer)) and 0 <= int(v) < 4:
                out.append(ACTIONS[int(v)])
        return out
    except TypeError:
        return []


def _legal_actions(state, neighbors):
    """Resolve legal actions (U,D,L,R order) from legal_mask, legal_actions
    or neighbors, in that order of preference."""
    legal = state.get("legal_mask")
    if legal is not None:
        try:
            lst = [bool(_as_scalar(x)) for x in legal]
            if len(lst) == 4:
                return [a for a, ok in zip(ACTIONS, lst) if ok]
        except TypeError:
            pass
    seq = _parse_action_seq(state.get("legal_actions"))
    if seq:
        return list(dict.fromkeys(seq))
    return [a for i, a in enumerate(ACTIONS) if neighbors[i] not in (None, "#")]


def _run_length(prev, hist):
    if prev is None or not hist:
        return 0
    n = 0
    for a in reversed(hist):
        if a == prev:
            n += 1
        else:
            break
    return n


def _num(state, k, dflt):
    v = state.get(k, dflt)
    v = _as_scalar(v)
    try:
        return float(v)
    except (TypeError, ValueError):
        return float(dflt)


def _feat(state, level=None):
    """Convert a local observation dict into a fixed-length feature vector."""
    cell = state.get("cell")
    if isinstance(cell, str):
        cell = cell[0] if cell else ""
    elif cell is not None:
        cell = str(cell)
    else:
        cell = ""
    neighbors = _parse_neighbors(state)
    prev = _parse_prev(state)
    hist = _parse_action_seq(state.get("history"))
    tail = _parse_action_seq(state.get("history_tail"))
    legal = _legal_actions(state, neighbors)
    open_mask = [1.0 if a in legal else 0.0 for a in ACTIONS]

    depth = _num(state, "depth", 0.0)
    depth_mod = int(_num(state, "depth_mod", depth % 4))
    phase = int(_num(state, "depth_phase", depth // 8))
    run = _num(state, "run_length_bucket", -1.0)
    if run < 0:
        run = float(_run_length(prev, hist))

    max_depth = 0.0
    if level is not None and isinstance(level, dict):
        md = level.get("max_depth")
        if md is not None:
            md = _as_scalar(md)
            try:
                max_depth = float(md)
            except (TypeError, ValueError):
                max_depth = 0.0

    f = []
    f.extend(open_mask)                                   # 4

    for a in ACTIONS:                                     # 4 x 21 neighbor letters
        ch = neighbors[ACH[a]]
        f.extend([0.0] * len(ALL_CHARS))
        if ch is not None and ch in ALL_CHARS:
            f[-len(ALL_CHARS) + ALL_CHARS.index(ch)] = 1.0

    f.extend([0.0] * len(ALL_CHARS))                      # 21 cell letter
    if cell and cell in ALL_CHARS:
        f[-len(ALL_CHARS) + ALL_CHARS.index(cell)] = 1.0

    f.extend([0.0] * 5)                                   # 5 previous action
    if prev is not None:
        f[-5 + ACH[prev]] = 1.0
    else:
        f[-1] = 1.0

    tail4 = list(tail[-4:] if tail else hist[-4:])        # 16 history tail
    while len(tail4) < 4:
        tail4.insert(0, "")
    for t in tail4:
        f.extend([0.0] * 4)
        if t in ACTIONS:
            f[-4 + ACH[t]] = 1.0

    run_bins = [1, 2, 3, 4, 6, 8, 10, 13, 16, 20, 25, 30]      # 12 bins
    rb = 0
    for b in run_bins:
        if run >= b:
            rb += 1
    f.extend([0.0] * len(run_bins))
    f[-len(run_bins) + min(rb, len(run_bins) - 1)] = 1.0

    depth_bins = [0, 3, 8, 13, 18, 23, 28, 33, 40, 48, 60]     # 11 bins
    db = 0
    for b in depth_bins:
        if depth >= b:
            db += 1
    f.extend([0.0] * len(depth_bins))
    f[-len(depth_bins) + min(db, len(depth_bins) - 1)] = 1.0

    f.extend([0.0] * 4)                                   # depth % 4 one-hot
    f[-4 + (depth_mod % 4)] = 1.0

    f.extend([0.0] * 8)                                   # 8 depth-phase one-hot
    f[-8 + (int(phase) % 8)] = 1.0

    f.append(min(max_depth, 100.0) / 100.0)               # 1 max_depth
    return np.array(f, dtype=np.float64)


def _build_observation(level, grid, R, C, r, c, hist, prev, depth):
    """Build the canonical local observation dict for a state during training
    (same schema the tolerant parser consumes at inference)."""
    nb = []
    for a in ACTIONS:
        dr, dc = DIRS[a]
        nr, nc = r + dr, c + dc
        nb.append(grid[nr][nc] if (0 <= nr < R and 0 <= nc < C and
                                   grid[nr][nc] != "#") else "#")
    legal = [x != "#" for x in nb]
    run = 0
    if prev is not None:
        for x in reversed(hist):
            if x == prev:
                run += 1
            else:
                break
    return {
        "cell": grid[r][c],
        "neighbors": nb,
        "previous_action": prev,
        "history": list(hist),
        "history_tail": "".join(hist[-5:]),
        "run_length_bucket": run,
        "depth": depth,
        "depth_mod": depth % 4,
        "depth_phase": depth // 8,
        "legal_mask": legal,
        "legal_actions": [a for a, ok in zip(ACTIONS, legal) if ok],
    }


# ---------------------------------------------------------------------------
# numpy softmax classifier (MLP / logistic regression with Adam)
# ---------------------------------------------------------------------------

class _SoftmaxModel:
    def __init__(self, D, K, hidden=48, seed=0):
        self.D, self.K = D, K
        self.hidden = hidden
        rng = np.random.RandomState(seed)
        if hidden > 0:
            s = np.sqrt(6.0 / (D + hidden))
            self.W1 = rng.uniform(-s, s, (D, hidden))
            self.b1 = np.zeros(hidden)
            s = np.sqrt(6.0 / (hidden + K))
            self.W2 = rng.uniform(-s, s, (hidden, K))
            self.b2 = np.zeros(K)
        else:
            self.W1 = np.zeros((D, 0))
            self.b1 = np.zeros(0)
            s = np.sqrt(6.0 / (D + K))
            self.W2 = rng.uniform(-s, s, (D, K))
            self.b2 = np.zeros(K)
        self.params = [self.W1, self.b1, self.W2, self.b2]
        self.mean = np.zeros(D)
        self.std = np.ones(D)

    def _forward(self, X, out_act=False):
        if self.hidden > 0:
            h = np.maximum(0.0, X @ self.W1 + self.b1)
            logits = h @ self.W2 + self.b2
            return (logits, h) if out_act else logits
        return X @ self.W2 + self.b2

    def fit(self, X, y, Xv=None, yv=None, iters=1200, lr=5e-3, l2=5e-4,
            batch=256, verbose=False):
        mu = X.mean(0)
        sd = X.std(0)
        sd[sd < 1e-9] = 1.0
        self.mean, self.std = mu, sd
        Xn = (X - mu) / sd
        N = Xn.shape[0]
        m = {i: np.zeros_like(p) for i, p in enumerate(self.params)}
        v = {i: np.zeros_like(p) for i, p in enumerate(self.params)}
        t = 0
        best, best_params = -1.0, None
        for it in range(iters):
            idx = np.arange(N)
            np.random.shuffle(idx)
            for s in range(0, N, batch):
                t += 1
                ids = idx[s:s + batch]
                Xb, Yb = Xn[ids], y[ids]
                if self.hidden > 0:
                    logits, h = self._forward(Xb, out_act=True)
                else:
                    logits, h = self._forward(Xb), None
                ex = np.exp(logits - logits.max(1, keepdims=True))
                probs = ex / ex.sum(1, keepdims=True)
                grad_out = probs.copy()
                grad_out[np.arange(len(ids)), Yb] -= 1.0
                grad_out /= len(ids)
                if self.hidden > 0:
                    gW2 = h.T @ grad_out
                    gb2 = grad_out.sum(0)
                    gH = grad_out @ self.W2.T
                    gH[h <= 0] = 0.0
                    gW1 = Xb.T @ gH
                    gb1 = gH.sum(0)
                    grads = [gW1, gb1, gW2, gb2]
                else:
                    gW2 = Xb.T @ grad_out
                    gb2 = grad_out.sum(0)
                    grads = [np.zeros_like(self.W1), np.zeros_like(self.b1),
                             gW2, gb2]
                for i, g in enumerate(grads):
                    g = g + l2 * self.params[i]
                    m[i] = 0.9 * m[i] + 0.1 * g
                    v[i] = 0.999 * v[i] + 0.001 * g * g
                    mh = m[i] / (1 - 0.9 ** t)
                    vh = v[i] / (1 - 0.999 ** t)
                    self.params[i] -= lr * mh / (np.sqrt(vh) + 1e-8)
            if Xv is not None and yv is not None and (it % 100 == 0):
                acc = self.score(Xv, yv)
                if best is None or acc > best:
                    best = acc
                    best_params = [p.copy() for p in self.params]
                if verbose:
                    print(f"  iter {it}: val_acc={acc:.4f}")
        if best_params is not None:
            self.params = best_params
        return best

    def predict_proba(self, X):
        Xn = (X - self.mean) / self.std
        logits = self._forward(Xn)
        ex = np.exp(logits - logits.max(1, keepdims=True))
        return ex / ex.sum(1, keepdims=True)

    def score(self, X, y):
        return float((self.predict_proba(X).argmax(1) == y).mean())


# ---------------------------------------------------------------------------
# Policy
# ---------------------------------------------------------------------------

class Policy:
    """Returned by make_policy. Learned model + robust empirical priors."""

    def __init__(self, model, straight_boost=10.0, reverse_penalty=0.05,
                 temperature=1.0, top_boost=1.0):
        self.model = model
        self.straight_boost = straight_boost
        self.reverse_penalty = reverse_penalty
        self.temperature = temperature
        self.top_boost = top_boost
        self.train_info = {}

    def action_probs(self, level, state, legal_actions):
        logp = np.log(np.clip(
            self.model.predict_proba(_feat(state, level).reshape(1, -1))[0],
            1e-12, 1.0))
        T = max(self.temperature, 1e-4)
        lp = logp / T
        lp = lp - lp.max()
        p = np.exp(lp)
        p = p / p.sum()
        prev = _parse_prev(state)
        top = int(p.argmax())
        raw = {}
        for a in ACTIONS:
            pr = p[ACH[a]]
            if prev is not None and a == prev:
                pr *= self.straight_boost
            elif prev is not None and a == OPP[prev]:
                pr *= self.reverse_penalty
            if ACH[a] == top:
                pr *= self.top_boost
            raw[a] = float(pr)
        legal = list(legal_actions) if legal_actions else \
            _legal_actions(state, _parse_neighbors(state))
        out = {a: 0.0 for a in ACTIONS}
        total = 0.0
        for a in legal:
            if a in raw and raw[a] > 0:
                out[a] = max(raw[a], 1e-9)
                total += out[a]
        if total > 0:
            for a in legal:
                out[a] = out[a] / total
        return out


# ---------------------------------------------------------------------------
# make_policy
# ---------------------------------------------------------------------------

def make_policy(training_data, config=None):
    """Train on solved training instances and return a Policy."""
    config = config or {}
    levels = training_data.get("levels") if isinstance(training_data, dict) \
        else training_data
    if isinstance(levels, dict):
        levels = levels.get("levels", [])
    levels = list(levels)

    Xs, ys = [], []
    for lv in levels:
        grid = lv["grid"]
        R, C = len(grid), len(grid[0])
        r, c = int(lv["start"][0]), int(lv["start"][1])
        sol = lv["solution"]
        hist, prev, depth = [], None, 0
        for a in sol:
            obs = _build_observation(lv, grid, R, C, r, c, hist, prev, depth)
            Xs.append(_feat(obs, lv))
            ys.append(ACH[a])
            dr, dc = DIRS[a]
            r, c = r + dr, c + dc
            hist.append(a)
            prev = a
            depth += 1
    X = np.stack(Xs)
    y = np.array(ys, dtype=np.int64)

    np.random.seed(int(config.get("seed", 1234)))
    n = len(y)
    perm = np.random.permutation(n)
    nval = max(1, int(n * float(config.get("val_frac", 0.15))))
    val_idx, tr_idx = perm[:nval], perm[nval:]

    model = _SoftmaxModel(X.shape[1], 4,
                          hidden=int(config.get("hidden", 48)),
                          seed=int(config.get("seed", 1234)))
    best = model.fit(X[tr_idx], y[tr_idx], X[val_idx], y[val_idx],
                     iters=int(config.get("iters", 1200)),
                     lr=float(config.get("lr", 5e-3)),
                     l2=float(config.get("l2", 5e-4)),
                     verbose=bool(config.get("verbose", False)))
    p = Policy(model,
               straight_boost=float(config.get("straight_boost", 10.0)),
               reverse_penalty=float(config.get("reverse_penalty", 0.05)),
               temperature=float(config.get("temperature", 1.0)),
               top_boost=float(config.get("top_boost", 1.0)))
    p.train_info = {
        "n_levels": len(levels), "n_examples": n,
        "feat_dim": X.shape[1], "train_acc": model.score(X, y),
        "val_acc": best, "hidden": model.hidden,
    }
    return p
