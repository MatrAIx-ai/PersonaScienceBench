import json, heapq, math
import numpy as np
import analysis as A
ACTIONS=['U','D','L','R']; DIRS={'U':(-1,0),'D':(1,0),'L':(0,-1),'R':(0,1)}
def open_dirs(grid,R,C,r,c):
    return [a for a in ACTIONS if 0<=r+DIRS[a][0]<R and 0<=c+DIRS[a][1]<C and grid[r+DIRS[a][0]][c+DIRS[a][1]]!='#']
def obs_at(grid,R,C,r,c,hist,prev):
    nb=[grid[r+DIRS[a][0]][c+DIRS[a][1]] if (0<=r+DIRS[a][0]<R and 0<=c+DIRS[a][1]<C and grid[r+DIRS[a][0]][c+DIRS[a][1]]!='#') else '#' for a in ACTIONS]
    legal=[x!='#' for x in nb]; run=0
    if prev is not None:
        for x in reversed(hist):
            if x==prev: run+=1
            else: break
    return {"cell":grid[r][c],"neighbors":nb,"previous_action":prev,"history":list(hist),
            "history_tail":''.join(hist[-5:]),"run_length_bucket":run,"depth":len(hist),
            "depth_mod":len(hist)%4,"depth_phase":len(hist)//8,
            "legal_mask":legal,"legal_actions":[a for a,ok in zip(ACTIONS,legal) if ok]}
def best_first(policy, level, grid, start, goal, budget):
    R,C=len(grid),len(grid[0]); r0,c0=start
    so=obs_at(grid,R,C,r0,c0,[],None)
    heap=[(0.0,0,r0,c0,tuple(),so)]; cnt=1
    closed=set(); open_costs={(r0,c0):0.0}
    exp=0; raw_gen=1; dedup_gen=1
    while heap:
        cost,_,r,c,ht,obs=heapq.heappop(heap)
        if (r,c) in closed: continue
        if open_costs.get((r,c)) is not None and cost > open_costs[(r,c)]+1e-12: continue
        closed.add((r,c)); exp+=1
        if (r,c)==tuple(goal): return True, exp, raw_gen, dedup_gen, len(open_costs)
        if exp>=budget: return False, exp, raw_gen, dedup_gen, len(open_costs)
        legal=open_dirs(grid,R,C,r,c)
        probs=policy.action_probs(level, obs, legal)
        for a in legal:
            dr,dc=DIRS[a]; nr,nc=r+dr,c+dc
            if (nr,nc) in closed: continue
            p=probs.get(a,0.0)
            if p<=0: continue
            child_cost=cost - math.log(max(p,1e-12))
            if (nr,nc) in open_costs and child_cost >= open_costs[(nr,nc)] - 1e-12:
                continue
            ch=obs_at(grid,R,C,nr,nc,ht+(a,),a)
            heapq.heappush(heap,(child_cost,cnt,nr,nc,ht+(a,),ch))
            cnt+=1; raw_gen+=1
            if (nr,nc) not in open_costs:
                dedup_gen+=1
            open_costs[(nr,nc)]=child_cost
    return False, exp, raw_gen, dedup_gen, len(open_costs)
def greedy(policy, level, grid, start, goal, max_steps):
    R,C=len(grid),len(grid[0]); r,c=start; hist=[]; prev=None; steps=0; seen={(r,c)}
    while steps<max_steps:
        if (r,c)==tuple(goal): return True, steps
        legal=open_dirs(grid,R,C,r,c)
        obs=obs_at(grid,R,C,r,c,hist,prev)
        pr=policy.action_probs(level, obs, legal)
        best=max(legal, key=lambda a:pr.get(a,0))
        dr,dc=DIRS[best]; nr,nc=r+dr,c+dc
        if (nr,nc) in seen: return False, steps
        r,c=nr,nc; hist.append(best); prev=best; steps+=1; seen.add((r,c))
    return False, steps
def train_acc(policy, td):
    ok=0; tot=0
    for lv in td['levels']:
        g=lv['grid']; R,C=len(g),len(g[0]); r,c=lv['start']; hist=[]; prev=None
        for a in lv['solution']:
            ob=obs_at(g,R,C,r,c,hist,prev)
            legal=[x for x in ACTIONS if x in ob['legal_actions']]
            pr=policy.action_probs(lv, ob, legal)
            if max(legal,key=lambda x:pr.get(x,0))==a: ok+=1
            tot+=1
            r,c=r+DIRS[a][0],c+DIRS[a][1]; hist.append(a); prev=a
    return ok/tot
def main():
    td=json.load(open('data/training_levels.json'))
    pe=json.load(open('data/public_eval_levels.json')); budget=pe['budget']
    cfgs=[
        ('base(boost10,top1,T1)', {'straight_boost':10.0,'top_boost':1.0,'temperature':1.0}),
        ('boost20,top1,T1',      {'straight_boost':20.0,'top_boost':1.0,'temperature':1.0}),
        ('boost10,top2,T1',      {'straight_boost':10.0,'top_boost':2.0,'temperature':1.0}),
        ('boost10,top3,T1',      {'straight_boost':10.0,'top_boost':3.0,'temperature':1.0}),
        ('boost10,top2,T0.8',    {'straight_boost':10.0,'top_boost':2.0,'temperature':0.8}),
        ('boost10,top2,T0.65',   {'straight_boost':10.0,'top_boost':2.0,'temperature':0.65}),
    ]
    for name,cfg in cfgs:
        pol=A.make_policy(td, config=cfg)
        acc=train_acc(pol, td)
        res=[best_first(pol,lv,lv['grid'],tuple(lv['start']),tuple(lv['goal']),budget) for lv in pe['levels']]
        gg=[greedy(pol,lv,lv['grid'],tuple(lv['start']),tuple(lv['goal']),300) for lv in pe['levels']]
        s=sum(1 for x in res if x[0]); gs=sum(1 for x in gg if x[0])
        exps=[x[1] for x in res]; raws=[x[2] for x in res]; deps=[x[3] for x in res]
        print(f'{name:26s} acc={acc:.4f} solved={s}/4 exp[max={max(exps)},mean={sum(exps)/4:.1f}] '
              f'rawgen[max={max(raws)},mean={sum(raws)/4:.1f}] dedupgen[max={max(deps)},mean={sum(deps)/4:.1f}] greedy={gs}/4')
        print('     detail(exp,raw,dedup):', [(x[1],x[2],x[3]) for x in res])
if __name__=='__main__':
    main()
