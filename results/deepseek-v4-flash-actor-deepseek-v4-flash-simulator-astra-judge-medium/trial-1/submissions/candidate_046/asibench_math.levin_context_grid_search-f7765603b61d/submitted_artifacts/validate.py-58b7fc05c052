"""Validation harness for analysis.py (development evidence, not part of the
required submission artifact). Simulates the hidden transition system using the
public evaluation grids and measures policy-guided best-first search
expansions vs. baselines within the public budget."""
import json, heapq, math, time
import numpy as np
import analysis
from analysis import ACTIONS, DIRS, ACH, OPP

ACTIONS = ['U','D','L','R']
DIRS={'U':(-1,0),'D':(1,0),'L':(0,-1),'R':(0,1)}

def open_dirs(grid,R,C,r,c):
    out=[]
    for a in ACTIONS:
        dr,dc=DIRS[a]; nr,nc=r+dr,c+dc
        if 0<=nr<R and 0<=nc<C and grid[nr][nc]!='#':
            out.append(a)
    return out

def best_first(policy, level, grid, start, goal, budget, use_prior=True):
    R,C=len(grid),len(grid[0])
    r0,c0=start; gr,gc=goal
    # canonical obs builder mirroring analysis (same schema)
    hist=[]
    def obs_at(r,c,hist,prev):
        nb=[]
        for a in ACTIONS:
            dr,dc=DIRS[a]; nr,nc=r+dr,c+dc
            nb.append(grid[nr][nc] if (0<=nr<R and 0<=nc<C and grid[nr][nc]!='#') else '#')
        legal=[x!='#' for x in nb]
        run=0
        if prev is not None:
            for x in reversed(hist):
                if x==prev: run+=1
                else: break
        return {"cell":grid[r][c],"neighbors":nb,"previous_action":prev,
                "history":list(hist),"history_tail":''.join(hist[-5:]),
                "run_length_bucket":run,"depth":len(hist),"depth_mod":len(hist)%4,
                "depth_phase":len(hist)//8,"legal_mask":legal,
                "legal_actions":[a for a,ok in zip(ACTIONS,legal) if ok]}
    start_obs=obs_at(r0,c0,[],None)
    open_list=[(0.0,0, r0,c0, tuple(hist), start_obs)]
    counter=1
    closed=set()
    expansions=0; generated=1
    while open_list:
        cost,_,r,c,hist_t,obs=heapq.heappop(open_list)
        if (r,c) in closed:
            continue
        closed.add((r,c)); expansions+=1
        if (r,c)==(gr,gc):
            return True, expansions, generated
        if expansions>=budget:
            return False, expansions, generated
        legal=open_dirs(grid,R,C,r,c)
        probs=policy.action_probs(level, obs, legal)
        for a in legal:
            dr,dc=DIRS[a]; nr,nc=r+dr,c+dc
            if (nr,nc) in closed: continue
            p=probs.get(a,0.0)
            if p<=0: continue
            nc_hist=hist_t+(a,)
            child_obs=obs_at(nr,nc,nc_hist,a)
            child_cost=cost - math.log(max(p,1e-9))
            heapq.heappush(open_list,(child_cost,counter,nr,nc,nc_hist,child_obs))
            counter+=1; generated+=1
    return False, expansions, generated

class StraightRule:
    """Baseline: follow straight until blocked; at a turn pick first open
    perpendicular in U,D,L,R order; never reverse."""
    def __init__(self, use_goal=False):
        self.use_goal=use_goal
    def action_probs(self, level, state, legal_actions):
        prev=state.get('previous_action')
        legal=list(legal_actions)
        out={a:0.0 for a in ACTIONS}
        if prev in legal:
            out[prev]=1.0
        else:
            cands=[a for a in ACTIONS if a in legal and a!=OPP.get(prev)]
            if not cands: cands=legal
            # if use_goal (oracle baseline): pick candidate minimizing dist to goal
            if self.use_goal and ('grid' in level):
                r,c=state.get('_pos',(0,0)); gr,gc=level['goal']
                cands=[min(cands,key=lambda a: abs(r+DIRS[a][0]-gr)+abs(c+DIRS[a][1]-gc))]
            out[cands[0]]=1.0
        return out

class UniformRule:
    def action_probs(self, level, state, legal_actions):
        legal=list(legal_actions); n=max(1,len(legal))
        return {a:(1.0/n if a in legal else 0.0) for a in ACTIONS}

def main():
    td=json.load(open('data/training_levels.json'))
    pe=json.load(open('data/public_eval_levels.json'))
    budget=pe['budget']

    print('=== next-action accuracy on training data (by category) ===')
    t0=time.time(); pol=analysis.make_policy(td, config={}); print('train time %.1fs'%(time.time()-t0))
    rows={'start':[0,0],'straight':[0,0],'turn_single':[0,0],'turn_double':[0,0],'all':[0,0]}
    for lv in td['levels']:
        g=lv['grid']; R,C=len(g),len(g[0]); r,c=lv['start']; hist=[]; prev=None; dep=0
        for a in lv['solution']:
            nb=[]
            for dd in ACTIONS:
                dr,dc=DIRS[dd]; nr,nc=r+dr,c+dc
                nb.append(g[nr][nc] if (0<=nr<R and 0<=nc<C and g[nr][nc]!='#') else '#')
            legal=[dd for dd in ACTIONS if nb[ACH[dd]]!='#']
            run=0
            if prev is not None:
                for x in reversed(hist):
                    if x==prev: run+=1
                    else: break
            obs={"cell":g[r][c],"neighbors":nb,"previous_action":prev,"history":list(hist),
                 "history_tail":''.join(hist[-5:]),"run_length_bucket":run,"depth":dep,
                 "depth_mod":dep%4,"depth_phase":dep//8,
                 "legal_mask":[x!='#' for x in nb],"legal_actions":legal}
            pred=pol.action_probs(lv,obs,legal); pa=max(legal,key=lambda x:pred[x]); correct=(pa==a)
            if prev is None: cat='start'
            else:
                dr,dc=DIRS[prev]; nr,nc=r+dr,c+dc; fwd=(0<=nr<R and 0<=nc<C and g[nr][nc]!='#')
                perp=[x for x in ({'U','D'} if prev in 'LR' else {'L','R'}) if x in legal]
                if not fwd and len(perp)==2: cat='turn_double'
                elif not fwd: cat='turn_single'
                else: cat='straight'
            rows[cat][0]+=1; rows[cat][1]+=int(correct)
            rows['all'][0]+=1; rows['all'][1]+=int(correct)
            dr,dc=DIRS[a]; r,c=r+dr,c+dc; hist.append(a); prev=a; dep+=1
    for k,v in rows.items():
        print(f"  {k:12s} n={v[0]:5d}  acc={v[1]/v[0]:.4f}")
    model_score=(rows['all'][1]/rows['all'][0])

    print('\n=== best-first expansions on PUBLIC levels (budget=%d) ==='%budget)
    level_meta=pe['levels']
    policies={'policy(model)':pol,
              'uniform':UniformRule(),
              'straight-rule':StraightRule(use_goal=False),
              'oracle-straight-toward-goal':StraightRule(use_goal=True)}
    for name,p in policies.items():
        results=[]
        for lv in level_meta:
            ok,exp,gen=best_first(p,lv,lv['grid'],tuple(lv['start']),tuple(lv['goal']),budget)
            results.append((ok,exp,gen,lv['id'],lv['max_depth']))
        s=sum(1 for x in results if x[0])
        mid=sum(x[1] for x in results)/len(results)
        mg=sum(x[2] for x in results)/len(results)
        print(f'  {name:28s} solved={s}/4  mean_expan={mid:.1f}  mean_generated={mg:.1f}')
        for ok,e,g,lv_id,md in results:
            print(f'      {lv_id}: max_depth={md:2d} solved={ok} expansions={e} generated={g}')
    print('\ntraining next-action accuracy: %.4f'%model_score)

if __name__=='__main__':
    main()
