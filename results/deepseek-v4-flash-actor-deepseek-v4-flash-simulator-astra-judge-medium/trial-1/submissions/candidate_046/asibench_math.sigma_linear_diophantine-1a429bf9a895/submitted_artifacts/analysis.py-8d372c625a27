"""Solve a*sigma(n) = b*n + c for 1 <= n <= U (sigma = sum of divisors).

Structured factorization-tree search:
  - enumerates candidate factorizations of n in increasing prime order
  - exact integer leaf verification a*sigma(n) == b*n + c
  - rigorous ratio-window prunes (never discard a solution):
      * upper: appending prime-power blocks only increases sigma/n;
               compared exactly with integer cross-multiplication
      * lower: if current ratio times the EXACT maximum achievable future
               sigma(m)/m (m <= U/n_part, prefix-max table) cannot reach
               the feasible ratio window, prune
  - module-level caches (primes, divisor-sum table, prefix-max ratio) so
    re-imports / re-runs stay fast
  - wide-window cases (e.g. large positive c) naturally collapse to a light
    traversal; a cached divisor-sum scan is used for tiny U / fallback.

Self-contained (no import of a module named 'analysis').
"""

import bisect

# --------------------------- module-level caches --------------------------
PRIME_LIST = [2, 3]        # all primes <= PRIME_CAP
PRIME_CAP = 2
SIGMA_TBL = [0, 1]         # divisor-sum table, sigma[n] for n <= len-1
SIGMA_CAP = 1
MAXRATIO = [0.0, 1.0]      # prefix max of sigma[m]/m over m <= len-1

# ------------------------------ primes sieve ------------------------------
def _extend_primes(n):
    """Extend the cached prime list up to n (inclusive). Simple, exact sieve."""
    global PRIME_LIST, PRIME_CAP
    if n <= PRIME_CAP:
        return
    limit = max(n, 2)
    sieve = bytearray(b'\x01') * (limit + 1)
    sieve[0] = sieve[1] = 0
    for i in range(2, int(limit ** 0.5) + 1):
        if sieve[i]:
            sieve[i * i::i] = b'\x00' * (((limit - i * i) // i) + 1)
    PRIME_LIST = [i for i in range(2, limit + 1) if sieve[i]]
    PRIME_CAP = limit


def _primes_up_to(n):
    _extend_primes(n)
    return PRIME_LIST[:bisect.bisect_right(PRIME_LIST, n)]

# ------------------------- sigma table + ratio max ------------------------
def _ensure_sigma_table(U):
    """Build divisor-sum table and prefix-max ratio up to U (cached)."""
    global SIGMA_TBL, SIGMA_CAP, MAXRATIO
    if U <= SIGMA_CAP:
        return
    need = U
    sig = [0] * (need + 1)
    for d in range(1, need + 1):
        for m in range(d, need + 1, d):
            sig[m] += d
    SIGMA_TBL = sig
    SIGMA_CAP = need
    mx = 0.0
    mr = [0.0] * (need + 1)
    for n in range(1, need + 1):
        v = sig[n] / n
        if v > mx:
            mx = v
        mr[n] = mx
    MAXRATIO = mr


def _max_ratio_up_to(R):
    """Exact maximum of sigma(m)/m over 1 <= m <= R (R >= 1)."""
    if R <= 0:
        return 1.0
    _ensure_sigma_table(R)
    return MAXRATIO[R]

# --------------------- independent sigma (verification) -------------------
def _sigma_direct(n):
    """Direct sum-of-divisors by trial-division factorization."""
    if n <= 1:
        return n
    s = 1
    m = n
    d = 2
    while d * d <= m:
        if m % d == 0:
            pe = 1
            pp = 1
            while m % d == 0:
                m //= d
                pp *= d
                pe += pp
            s *= pe
        d += 1 if d == 2 else 2
    if m > 1:
        s *= (1 + m)
    return s

# ------------------------------ edge cases --------------------------------
def _degenerate(a, b, c, U):
    """Handle a==0 and/or b==0. Return None if not degenerate else solutions."""
    if a == 0 and b == 0:
        return list(range(1, U + 1)) if c == 0 else []
    if a == 0:
        # 0 = b*n + c  ->  n = -c/b
        if b != 0 and (-c) % b == 0:
            n = (-c) // b
            return [n] if 1 <= n <= U else []
        return []
    if b == 0:
        # a*sigma(n) = c  ->  sigma(n) = c/a (positive integer)
        if c % a != 0 or c // a <= 0:
            return []
        t = c // a
        res = []
        for n in range(1, U + 1):
            if _sigma_direct(n) == t:
                res.append(n)
        return res
    return None

# --------------------------- structured search ----------------------------
LIMIT_EXACT_RATIO = 2_200_000   # build exact max-ratio table up to this


def _maxratio_fallback(R):
    """Safe loose upper bound for max sigma(m)/m over m <= R (R >= 1).

    sigma(m)/m = prod_{q|m} (1 + 1/q + ...) < prod_{q|m} q/(q-1)
               <= prod_{q <= R} q/(q-1)  (over all primes up to R).
    An overestimate, hence always a safe prune bound.
    """
    _extend_primes(R)
    prod = 1.0
    for q in PRIME_LIST:
        if q > R:
            break
        prod *= q / (q - 1)
    return prod


def _max_ratio(R):
    """Exact (<= LIMIT_EXACT_RATIO) or safe-upper max of sigma(m)/m, 1<=m<=R."""
    if R <= 0:
        return 1.0
    if R <= LIMIT_EXACT_RATIO:
        return _max_ratio_up_to(R)
    return _maxratio_fallback(R)


def _search(a, b, c, U):
    """Factorization-tree solver for a > 0, b > 0."""
    _extend_primes(U)
    primes = PRIME_LIST

    # ---- feasible ratio window: r(n) = a*sigma(n)/n = b + c/n, n in [1,U]
    if c >= 0:
        w_lo = b + c / U
        w_hi = b + c
    else:
        w_lo = b + c
        w_hi = b + c / U
    eff_lo = max(w_lo, float(a))     # r(n) >= a always (sigma(n) >= n)
    if w_hi < float(a):              # window entirely below minimum ratio
        return []

    sols = []

    def leaf(n, sig):
        if a * sig == b * n + c:
            sols.append(n)

    leaf(1, 1)                        # candidate n = 1

    # iterative DFS: (n, sigma, last_prime); stack LIFO, order irrelevant
    stack = [(1, 1, 0)]
    maxr_cache = {}
    while stack:
        n, sig, last = stack.pop()

        # upper bound prune (exact integer comparison)
        if c >= 0:
            if a * sig > (b + c) * n:
                continue
        else:
            if a * sig * U > (b * U + c) * n:
                continue

        # lower bound prune (necessity: r * max_future_ratio >= eff_lo)
        # only relevant when eff_lo > a; otherwise r = a*sigma/n >= a = eff_lo
        if eff_lo > a:
            R = U // n
            if R >= 1:
                mr = maxr_cache.get(R)
                if mr is None:
                    mr = _max_ratio(R)
                    maxr_cache[R] = mr
                if (a * sig / n) * mr < eff_lo - 1e-12 * (1.0 + abs(eff_lo)):
                    continue

        start = bisect.bisect_right(primes, last)
        for idx in range(start, len(primes)):
            p = primes[idx]
            if n * p > U:
                break
            P = p          # P = p^e
            S = p + 1      # S = sigma(p^e) = 1 + p + ... + p^e
            while n * P <= U:
                n2 = n * P
                s2 = sig * S
                # exact upper prune on this extension; larger exponents only
                # raise the ratio further, so once it exceeds, break
                if c >= 0:
                    big = a * s2 > (b + c) * n2
                else:
                    big = a * s2 * U > (b * U + c) * n2
                if big:
                    break
                leaf(n2, s2)
                stack.append((n2, s2, p))
                P *= p
                S += P
    sols.sort()
    return sols




def _scan(a, b, c, U):
    """Cached divisor-sum table scan (exact). Used for wide ratio windows."""
    _ensure_sigma_table(U)
    sig = SIGMA_TBL
    sols = []
    for n in range(1, U + 1):
        if a * sig[n] == b * n + c:
            sols.append(n)
    return sols

# ------------------------------- public API -------------------------------
def solve(a: int, b: int, c: int, U: int) -> list[int]:
    """Return all n in [1, U] with a*sigma(n) == b*n + c, sorted."""
    if U <= 0:
        return []
    if a < 0 or b < 0:
        # not expected by the dataset; safe brute-force fallback
        out = []
        for n in range(1, U + 1):
            if a * _sigma_direct(n) == b * n + c:
                out.append(n)
        return out
    deg = _degenerate(a, b, c, U)
    if deg is not None:
        return sorted(deg)
    # hybrid: structured tree when the ratio window has pruning power,
    # otherwise the cached divisor-sum scan (both paths exact).
    if c < 0:
        return _search(a, b, c, U)          # tight upper window -> tree
    if U > LIMIT_EXACT_RATIO:
        return _search(a, b, c, U)          # avoid huge exact sigma table
    mr = _max_ratio(U)                      # exact max sigma(m)/m (cached)
    if (b + c) <= a * mr + a:               # upper ratio bound can prune
        return _search(a, b, c, U)
    return _scan(a, b, c, U)


# ------------------------- CSV generation (entry) -------------------------
def _main():
    import json, os, time
    with open('data/problem_instances.json') as f:
        data = json.load(f)
    instances = data['instances']

    os.makedirs('results', exist_ok=True)
    sol_rows = []
    sum_rows = []
    t0 = time.perf_counter()
    for r in instances:
        iid = r['instance_id']
        t_start = time.perf_counter()
        sols = solve(r['a'], r['b'], r['c'], r['U'])
        t_call = time.perf_counter() - t_start
        sols.sort()
        for n in sols:
            sol_rows.append((iid, n))
        largest = sols[-1] if sols else 0
        sum_rows.append((iid, len(sols), largest))
        print('%-16s a=%d b=%d c=%d U=%8d count=%-3d largest=%-7d time=%.3fs'
              % (iid, r['a'], r['b'], r['c'], r['U'], len(sols), largest, t_call))
    total = time.perf_counter() - t0

    with open('results/solutions.csv', 'w') as f:
        f.write('instance_id,n\n')
        for iid, n in sol_rows:
            f.write('%s,%d\n' % (iid, n))
    with open('results/instance_summary.csv', 'w') as f:
        f.write('instance_id,solution_count,largest_solution\n')
        for iid, cnt, big in sum_rows:
            f.write('%s,%d,%d\n' % (iid, cnt, big))
    print('total time: %.3fs' % total)


if __name__ == '__main__':
    _main()
