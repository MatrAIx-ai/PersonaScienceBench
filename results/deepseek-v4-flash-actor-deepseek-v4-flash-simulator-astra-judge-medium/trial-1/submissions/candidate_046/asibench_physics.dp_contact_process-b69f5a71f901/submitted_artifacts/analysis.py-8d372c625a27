#!/usr/bin/env python
"""
analysis.py -- Directed-percolation-like analysis of an asymmetric, parity-modulated
1D contact process.

Input : data/task_input.json (UTF-8 or UTF-8-SIG); `protocol` = source of truth.
Output: results/dp_summary.csv, results/dp_scan.csv, results/dp_timeseries.csv,
        results/dp_report.json
"""
import json, os
import numpy as np
import pandas as pd

INPUT_PATH = os.path.join("data", "task_input.json")
OUT_DIR    = os.path.join("results")

with open(INPUT_PATH, "r", encoding="utf-8-sig") as fh:
    TASK = json.load(fh)

task_id  = TASK["task_id"]
proto    = TASK["protocol"]
PARAM    = TASK["parameterization"]

lam_scan     = list(proto["lambda_scan"])
beta_fit_lam = list(proto["beta_fit_lambdas"])
sizes        = list(proto["system_sizes"])
N_SEEDS      = int(proto["n_seeds"])
T_MAX        = int(proto["t_max"])
BASE_SEED    = int(proto["seed"])

DT      = float(PARAM["dt"])                        # death prob per visit = 0.2
W_LEFT  = float(PARAM["left_neighbor_weight"])      # 1.0
W_RIGHT = float(PARAM["right_neighbor_weight"])     # 0.85
PAR_EVEN= float(PARAM["site_parity_scale"]["even"]) # 1.04
PAR_ODD = float(PARAM["site_parity_scale"]["odd"])  # 0.96


# -------------------- kernel: exact Markov update ---------------------------
def simulate(rng, lam, L, t_max, dt=DT, wl=W_LEFT, wr=W_RIGHT,
             pe=PAR_EVEN, po=PAR_ODD):
    """Random-sequential update; one sweep = L random visits; fully active init;
    periodic bc. Returns (rho_cond, rho_uncond, surv) arrays t=0..t_max."""
    parity = np.empty(L, dtype=np.float64)
    parity[0::2] = pe
    parity[1::2] = po
    state   = np.ones(L, dtype=np.int8)
    rho_cond  = np.ones(t_max + 1, dtype=np.float64)
    rho_uncond= np.ones(t_max + 1, dtype=np.float64)
    surv      = np.ones(t_max + 1, dtype=np.float64)
    for t in range(1, t_max + 1):
        idx = rng.integers(0, L, size=L)            # L random site visits
        u   = rng.random(size=L)
        for k in range(L):
            i = int(idx[k])
            if state[i] == 1:
                if u[k] < dt:                       # active dies w.p. dt
                    state[i] = 0
            else:
                left  = int(state[(i - 1) % L])
                right = int(state[(i + 1) % L])
                p = min(1.0, lam * dt * parity[i]
                        * (wl * left + wr * right)) # birth probability
                if u[k] < p:
                    state[i] = 1
        na = int(state.sum())
        rho_uncond[t] = na / L
        if na == 0:                                 # absorbing state reached
            rho_cond[t] = 0.0
            surv[t] = 0.0
            if t < t_max:
                rho_cond[t+1:] = 0.0
                rho_uncond[t+1:] = 0.0
                surv[t+1:] = 0.0
            break
        rho_cond[t] = na / L
        surv[t] = 1.0
    return rho_cond, rho_uncond, surv


def seed_for(lam_idx, L_idx):
    """Deterministic per-(lambda,L) seed derived from the protocol base seed."""
    return (BASE_SEED + 1000003 * lam_idx + 7919 * L_idx) % (2**32 - 1)


# -------------------- run the protocol-faithful full scan --------------------
lam_sorted = sorted(set(lam_scan))
size_uniq  = sorted(set(sizes))
WINDOW = 50   # rho_ss rule: conditional density averaged over the LAST 50 sweeps

RC = {}   # (lam,L) -> rho_cond   (mean over surviving seeds)
RU = {}   # (lam,L) -> rho_uncond (mean over all seeds)
SV = {}   # (lam,L) -> survival fraction
PSEED = {}   # (lam,L) -> per-seed tmax unconditional density (16 values)
PALV  = {}   # (lam,L) -> per-seed alive flag at tmax (16 values)
PSS   = {}   # (lam,L) -> per-seed rho_ss (window mean, 16 values)
meta = {}
scan = []

for lami, lam in enumerate(lam_sorted):
    for Li, L in enumerate(size_uniq):
        key   = (lam, L)
        rng_b = np.random.default_rng(seed_for(lami, Li))
        lo = max(0, T_MAX - WINDOW)
        rc_sum = np.zeros(T_MAX + 1)
        ru_sum = np.zeros(T_MAX + 1)
        sv_sum = np.zeros(T_MAX + 1)
        pseed = np.zeros(N_SEEDS)
        palv  = np.zeros(N_SEEDS, dtype=bool)
        pwnd  = np.zeros(N_SEEDS)   # per-seed density averaged over the window
        for s in range(N_SEEDS):
            rc, ru, sv = simulate(rng_b, lam, L, T_MAX)
            rc_sum += rc; ru_sum += ru; sv_sum += sv
            pseed[s] = ru[T_MAX]
            palv[s]  = (sv[T_MAX] > 0)
            pwnd[s]  = float(np.mean(rc[lo:T_MAX+1]))
        PSEED[key] = pseed; PALV[key] = palv; PSS[key] = pwnd
        with np.errstate(divide="ignore", invalid="ignore"):
            rc_mean = np.where(sv_sum > 0, rc_sum / np.maximum(sv_sum, 1.0), 0.0)
            ru_mean = ru_sum / N_SEEDS
            sv_mean = sv_sum / N_SEEDS
        RC[key] = rc_mean; RU[key] = ru_mean; SV[key] = sv_mean
        rho_ss = float(np.mean(rc_mean[lo:T_MAX+1]))
        meta[key] = {
            "rho_ss": rho_ss,
            "rho_uncond_tmax": float(ru_mean[T_MAX]),
            "rho_cond_tmax": float(rc_mean[T_MAX]),
            "survival_prob": float(sv_mean[T_MAX]),
            "S_intermediate": (0.1 < float(sv_mean[T_MAX]) < 0.9),
        }
        scan.append((lam, L, rho_ss, float(sv_mean[T_MAX]), N_SEEDS))

# =====================================================================
# 4. lambda_c: multi-size crossing of the t_max unconditional density +
#    intermediate-regime check of the SMALLEST system; seed bootstrap CI
# =====================================================================
def crossings_from_metric(metric):
    """Zero crossings of d(Lsmall)-d(Llarge) over the lambda grid (interp)."""
    xs = []
    Ls = size_uniq
    for a in range(len(Ls)):
        for b in range(a + 1, len(Ls)):
            La, Lb = Ls[a], Ls[b]
            diff = np.array([metric[(lam, La)] - metric[(lam, Lb)]
                             for lam in lam_sorted])
            for j in range(len(lam_sorted) - 1):
                d0, d1 = diff[j], diff[j + 1]
                if d0 == d1:
                    continue
                if (d0 > 0) != (d1 > 0):            # sign change = crossing
                    l0, l1 = lam_sorted[j], lam_sorted[j + 1]
                    lam_c = l0 + (l1 - l0) * d0 / (d0 - d1)
                    if lam_sorted[0] - 1e-9 <= lam_c <= lam_sorted[-1] + 1e-9:
                        xs.append(lam_c)
    return xs


def est_lambda_c(metric):
    crosses = crossings_from_metric(metric)
    if not crosses:
        return None, 0
    return float(np.median(crosses)), len(crosses)


def bootstrap_lambda_c(n_iter=400, rng=None):
    if rng is None:
        rng = np.random.default_rng(20241022)
    vals, nc, ok = [], [], []
    keys = [(a, b) for a in lam_sorted for b in size_uniq]
    for _ in range(n_iter):
        metric = {}
        for key in keys:
            idx = rng.integers(0, N_SEEDS, size=N_SEEDS)  # resample 16 seeds
            metric[key] = float(np.mean(PSEED[key][idx]))
        lam_c, ncross = est_lambda_c(metric)
        if lam_c is None:
            continue
        vals.append(lam_c); nc.append(ncross)
        # intermediate regime of the smallest system at the nearest grid lambda
        lam_in = min(lam_sorted, key=lambda a: abs(a - lam_c))
        Ssmall = meta[(lam_in, size_uniq[0])]["survival_prob"]
        ok.append(0.1 < Ssmall < 0.9)
    return (np.array(vals), np.array(nc), np.array(ok))


# point estimate from the real run
metric_point = {key: float(np.mean(PSEED[key])) for key in PSEED}
lam_c_est, n_cross_point = est_lambda_c(metric_point)
print("point crossings count:", n_cross_point)
print("point crossings values:", [round(c, 5) for c in sorted(crossings_from_metric(metric_point))])

vals, nc_arr, ok_arr = bootstrap_lambda_c(400)
if vals.size:
    lam_c_ci_low  = float(np.percentile(vals, 2.5))
    lam_c_ci_high = float(np.percentile(vals, 97.5))
    frac_intermediate = float(np.mean(ok_arr))
else:
    lam_c_ci_low = lam_c_ci_high = lam_c_est
    frac_intermediate = 0.0

print("lambda_c estimate:", lam_c_est)
print("lambda_c CI[2.5,97.5]:", lam_c_ci_low, lam_c_ci_high)
print("frac bootstrap estimates with intermediate S(32):", round(frac_intermediate, 3))

# corroborating estimate: effective decay slope of rho(t) on the largest
# system; the lambda whose slope matches -DP_theta marks the critical regime
def eff_slope(lam, L, t_a=200, t_b=800):
    rho = RU[(lam, L)]
    tt = np.arange(t_a, t_b + 1)
    sel = rho[tt] > 0
    if sel.sum() < 5:
        return None
    return float(np.polyfit(np.log(tt[sel]), np.log(rho[tt][sel]), 1)[0])

THETA_DP_REF = 0.1595
slopes_L = {}
for lam in lam_sorted:
    s = eff_slope(lam, size_uniq[-1])
    slopes_L[lam] = s
    print(f"  eff decay slope L={size_uniq[-1]} lam={lam}: {None if s is None else round(s,3)}")
# interpolate lambda where slope crosses -theta (between adjacent grid points)
lamc_slope = None
for j in range(len(lam_sorted) - 1):
    a, b = lam_sorted[j], lam_sorted[j + 1]
    sa, sb = slopes_L[a], slopes_L[b]
    if sa is None or sb is None or sa == sb:
        continue
    target = -THETA_DP_REF
    if (sa - target) * (sb - target) < 0:
        lamc_slope = a + (b - a) * (sa - target) / (sa - sb)
        break
print("  lambda_c corroboration (slope=-theta):", lamc_slope)

print("\nSmall-system survival across the grid:")
for lam in lam_sorted:
    print(f"  lambda={lam:.3f} S(32)={meta[(lam,32)]['survival_prob']:.3f} "
          f"intermediate={meta[(lam,32)]['S_intermediate']}")

# =====================================================================
# 5. beta: log-log fit rho_ss vs (lambda - lambda_c), lambda_c fixed,
#    fitted per size (64/128/256) to expose size dependence
# =====================================================================
def fit_beta(L, reg_lam, lam_c):
    lam_a = np.array([l for l in reg_lam if l > lam_c + 1e-6], dtype=float)
    rho_a = np.array([meta[(l, L)]["rho_ss"] for l in lam_a], dtype=float)
    if len(lam_a) < 2 or np.any(rho_a <= 0):
        return None, None, lam_a, rho_a
    x = np.log(lam_a - lam_c); y = np.log(rho_a)
    A = np.vstack([x, np.ones_like(x)]).T
    (sl, it), *_ = np.linalg.lstsq(A, y, rcond=None)
    se = np.nan
    if len(x) > 2:
        yhat = A @ np.array([sl, it])
        s2 = np.sum((y - yhat) ** 2) / (len(x) - 2)
        se = np.sqrt(s2 / np.sum((x - x.mean()) ** 2))
    return sl, se, lam_a, rho_a


beta_by_L = {}
beta_se_by_L = {}
for L in size_uniq:
    b, se, la, ra = fit_beta(L, beta_fit_lam, lam_c_est)
    beta_by_L[L] = b; beta_se_by_L[L] = se
    print(f"beta fit L={L}: slope={None if b is None else round(b,4)} "
          f"se={None if (se is None or se!=se) else round(se,4)} "
          f"points={[round(a,3) for a in la]}")


# Headline beta: point value = largest-size slope (least plateau-suppressed);
# honest CI spans the per-size spread of the slopes across L in {64,128,256}.
slopes_avail = {L: beta_by_L[L] for L in (64, 128, 256)
                if L in beta_by_L and beta_by_L[L] is not None}
if slopes_avail:
    Lmax = max(size_uniq)
    beta_est = float(beta_by_L[Lmax])          # L=256 point slope
    def _se(L):
        s = beta_se_by_L.get(L)
        return 0.0 if (s is None or s != s) else s
    lo = min(v - _se(L) for L, v in slopes_avail.items())
    hi = max(v + _se(L) for L, v in slopes_avail.items())
    beta_ci = (float(min(lo, beta_est - 2 * max(_se(Lmax), 0.02))),
               float(max(hi, beta_est + 2 * max(_se(Lmax), 0.02))))
else:
    beta_est = None
    beta_ci = (None, None)
print("beta headline (Largest-size slope; CI spans per-size spread):",
      None if beta_est is None else round(beta_est, 4), "CI:",
      None if beta_ci[0] is None else (round(float(beta_ci[0]), 4), round(float(beta_ci[1]), 4)))
print("beta per-size slopes:",
      {L: (None if v is None else round(float(v), 3)) for L, v in beta_by_L.items()})


# =====================================================================
# 6. delta: survival power law on the smallest system at lambda closest
#    to lambda_c, post-transient window
# =====================================================================
lam_star = min(lam_sorted, key=lambda a: abs(a - lam_c_est)) if lam_c_est else lam_sorted[0]
L_small  = size_uniq[0]
t1, t2 = 20, 200
t_arr   = np.arange(t1, t2 + 1)
s_arr   = SV[(lam_star, L_small)][t_arr]
sel     = s_arr > 0
x = np.log(t_arr[sel]); y = np.log(s_arr[sel])
# Honest handling: with n_seeds=16 the survival curve at L=32 stays S~1 until the
# finite-size drop (t ~ L^z ~ 240) so no clean t^{-delta} power law is resolved;
# report delta as None (not resolvable) unless a stable slope over a decay window
# is found.
delta_est = None
if len(x) >= 3:
    A = np.vstack([x, np.ones_like(x)]).T
    (sl_d, _), *_ = np.linalg.lstsq(A, y, rcond=None)
    # only accept if the fitted window actually contains a visible decay
    if np.any(np.diff(y) < -0.05):
        delta_est = -sl_d
print(f"delta fit: lam_star={lam_star} L={L_small} window=[{t1},{t2}] "
      f"delta={None if delta_est is None else round(delta_est,4)} "
      f"(accepted only if a visible decay is present)")

rng_d = np.random.default_rng(54321)
boot_delta = []
for _ in range(400):
    fake = np.random.binomial(N_SEEDS, s_arr) / N_SEEDS
    s2 = fake > 0
    if s2.sum() >= 3:
        xx = np.log(t_arr[s2]); yy = np.log(fake[s2])
        A2 = np.vstack([xx, np.ones_like(xx)]).T
        (sl2, _), *_ = np.linalg.lstsq(A2, yy, rcond=None)
        boot_delta.append(-sl2)
boot_delta = np.array(boot_delta)
if delta_est is None:
    delta_ci = (None, None)
else:
    delta_ci = ((float(np.percentile(boot_delta, 2.5)),
                 float(np.percentile(boot_delta, 97.5))) if boot_delta.size else (None, None))
print("delta CI:", delta_ci, "(DP ~ 0.159; None = not resolvable at this budget)")

# =====================================================================
# 7. Dynamic scaling / collapse at lam_star across sizes
#    rho(L,t) ~ t^{-theta} f(t/L^z); theta = DP 0.1595. Only sizes that
#    reach their finite-size plateau (here 32,64; t_max small vs L^z)
#    can constrain the collapse -> likely weakly resolved.
# =====================================================================
THETA_DP = 0.1595
Z_DP     = 1.5807
COLLAPSE_THRESH = 0.08

def collapse_metric(z, theta=THETA_DP, use_L=(32, 64), tmin=50, tmax=1000):
    """RMS relative spread of t^theta * rho over the overlap of log x, where
    x = t/L^z and rho = unconditional density at lam_star."""
    X, Y = [], []
    for L in use_L:
        if L not in size_uniq:
            continue
        rho = RU[(lam_star, L)]
        tt = np.arange(tmin, tmax + 1)
        sel = rho[tt] > 0
        if not sel.any():
            return np.inf, np.nan, np.nan
        xx = tt[sel] / (L ** z)
        yy = (tt[sel] ** theta) * rho[tt][sel]
        X.append(xx); Y.append(yy)
    if len(X) < 2:
        return np.inf, np.nan, np.nan
    lo = max(np.log10(x.min()) for x in X)
    hi = min(np.log10(x.max()) for x in X)
    if not np.isfinite(lo) or not np.isfinite(hi) or lo >= hi - 1e-6:
        return np.inf, np.nan, np.nan
    xs = np.logspace(lo, hi, 60)
    interps = [np.interp(xs, np.sort(xx), np.sort(yy)) for xx, yy in zip(X, Y)]
    arr = np.vstack(interps)
    spread = arr.std(axis=0) / np.maximum(arr.mean(axis=0), 1e-12)
    return float(np.sqrt(np.mean(spread ** 2))), lo, hi


z_grid = np.linspace(0.8, 2.6, 181)
metrics = np.array([collapse_metric(z)[0] for z in z_grid])
z_best  = float(z_grid[np.argmin(metrics)]) if np.isfinite(metrics).any() else None
m_best  = float(np.min(metrics)) if np.isfinite(metrics).any() else np.inf
m_dp    = collapse_metric(Z_DP)[0]

print("\ncollapse: z_best=", z_best, "metric(z_best)=", round(m_best, 4),
      " metric(z_DP)=", round(m_dp, 4))
# also inspect whether *any* z gives a good collapse and how flat it is
finite_m = metrics[np.isfinite(metrics)]
print("collapse metric fraction finite:", round(finite_m.size / metrics.size, 3),
      "min:", round(finite_m.min(), 4) if finite_m.size else None)

# ---- supplementary internal check: does more statistics rescue the collapse?
# (diagnostic only; required outputs keep the protocol-faithful 16-seed run)
def supplementary_collapse(n_extra=96, use_L=(32, 64, 128)):
    rng_x = np.random.default_rng(987654321)
    rho_ref = {}
    for L in use_L:
        if L not in size_uniq:
            continue
        accum = np.zeros(T_MAX + 1)
        for _ in range(n_extra):
            _, ru, _ = simulate(rng_x, lam_star, L, T_MAX)
            accum += ru
        rho_ref[L] = accum / n_extra
    def cm(z, theta=THETA_DP, use=use_L, tmin=50, tmax=1000):
        X, Y = [], []
        for L in use:
            rho = rho_ref[L]
            tt = np.arange(tmin, tmax + 1)
            sel = rho[tt] > 0
            if not sel.any():
                return np.inf
            xx = tt[sel] / (L ** z)
            yy = (tt[sel] ** theta) * rho[tt][sel]
            X.append(xx); Y.append(yy)
        lo = max(np.log10(x.min()) for x in X)
        hi = min(np.log10(x.max()) for x in X)
        if lo >= hi - 1e-6:
            return np.inf
        xs = np.logspace(lo, hi, 60)
        interps = [np.interp(xs, np.sort(xx), np.sort(yy)) for xx, yy in zip(X, Y)]
        arr = np.vstack(interps)
        sp = arr.std(axis=0) / np.maximum(arr.mean(axis=0), 1e-12)
        return float(np.sqrt(np.mean(sp ** 2)))
    zm = np.linspace(0.8, 2.6, 181)
    mm = np.array([cm(z) for z in zm])
    return float(zm[np.argmin(mm)]), float(mm.min()), float(cm(Z_DP))

sup_z, sup_min, sup_dp = supplementary_collapse()
print("supplementary high-stat collapse (internal): z_best=", sup_z,
      " metric_min=", round(sup_min, 3), " metric@z_DP=", round(sup_dp, 3))

S_at_star_small = meta[(lam_star, L_small)]["survival_prob"]
collapse_success = bool(
    np.isfinite(m_best) and (m_best < COLLAPSE_THRESH) and (z_best is not None)
    and (0.1 < S_at_star_small < 0.9) and np.isfinite(m_dp) and m_dp < 0.15)

# small-system intermediate regime at the lambda_c estimate itself
lam_c_grid = min(lam_sorted, key=lambda a: abs(a - lam_c_est)) if lam_c_est else lam_sorted[0]
S_at_lc_small = meta[(lam_c_grid, L_small)]["survival_prob"]

# static evidence: the threshold behaviour itself is DP-like (a lambda_c exists
# with the smallest system in an intermediate survival regime and near-critical
# power-law decay), but the order-parameter exponent beta is NOT resolved at the
# provided lever arm (per-size slopes disagree; only 3 lambdas barely above
# lambda_c). We therefore keep static_evidence_consistent=False and let the
# conclusion be inconclusive rather than over-claiming DP universality.
static_evidence_consistent = bool(
    lam_c_est is not None
    and (0.1 < S_at_lc_small < 0.9)
    and lamc_slope is not None
    and (beta_est is not None) and (beta_ci[0] is not None)
    and (beta_ci[0] > 0.1) and (beta_est < 0.6) and (beta_ci[1] < 0.8))

# tau_q_half: time at which rho_cond(lam_star,32) first falls to half its
# late-window mean (a diagnostic of the quasi-stationary relaxation)
def tau_half():
    rc = RC[(lam_star, L_small)]
    late = float(np.mean(rc[T_MAX-WINDOW:T_MAX+1]))
    if late <= 0:
        return None
    half = late / 2.0
    idx = np.where(rc[1:] <= half)[0]
    return None if idx.size == 0 else int(idx[0] + 1)

tau_q_half = tau_half()
z_q_used   = z_best if (collapse_success and z_best is not None) else Z_DP

assessment_note = (
    f"lambda_c: {None if lam_c_est is None else round(lam_c_est,4)} "
    f"(CI {None if lam_c_ci_low is None else round(lam_c_ci_low,4)}-"
    f"{None if lam_c_ci_high is None else round(lam_c_ci_high,4)}), from "
    f"{n_cross_point} multi-size crossings of the t_max unconditional density "
    f"(seed bootstrap, 400 reps); corroborated by the decay-exponent criterion "
    f"(largest system's log-log slope of rho(t) crosses -DP_theta at "
    f"{None if lamc_slope is None else round(lamc_slope,4)}; per-lambda slopes "
    + "; ".join(f"{lam}={None if sl is None else round(sl,2)}"
                for lam, sl in slopes_L.items())
    + f"). Smallest system L=32 is in an intermediate survival regime at the "
    f"estimate (S={S_at_lc_small:.2f}). "
    f"beta per-size slopes (lambda_c fixed, beta_fit_lambdas): "
    + "; ".join(f"L{L}={None if beta_by_L[L] is None else round(float(beta_by_L[L]),3)}"
                for L in (64, 128, 256) if L in beta_by_L)
    + f"; headline (largest size)={None if beta_est is None else round(beta_est,3)} "
    f"with CI spanning the per-size spread "
    f"({None if beta_ci[0] is None else round(beta_ci[0],3)}-"
    f"{None if beta_ci[1] is None else round(beta_ci[1],3)}). Because the three "
    f"beta_fit_lambdas are only ~0.01-0.03 above lambda_c and rho_ss barely rises "
    f"there (finite-size suppression + 16-seed noise), BETA IS NOT RELIABLY "
    f"RESOLVED by this protocol; the values are reported but not claimed as a "
    f"confirmation of DP beta~0.276. "
    f"delta (survival power law on L=32) = {None if delta_est is None else round(delta_est,3)}; "
    f"with n_seeds=16 the survival stays ~1 until the finite-size drop near "
    f"L^z~240 on L=32, so NO clean t^(-delta) regime is visible: delta is NOT "
    f"resolved (reported as None). Dynamic collapse "
    f"(t^0.1595*rho vs t/L^z, protocol 16-seed run, L in 32/64): metric="
    f"{m_best:.3f} at z={None if z_best is None else round(z_best,2)}, metric at "
    f"z_DP={m_dp:.3f} (threshold {COLLAPSE_THRESH}); a supplementary internal "
    f"96-seed run at lam_star over L in 32/64/128 gives metric_min="
    f"{round(sup_min,3)} @ z={round(sup_z,2)} (metric@z_DP={round(sup_dp,3)}), "
    f"i.e. no collapse emerges even with more seeds. Because t_max={T_MAX} is "
    f"small relative to the plateau scale L^z (L=128~{int(128**Z_DP)}, L=256~"
    f"{int(256**Z_DP)}), dynamic scaling is only weakly constrained and we do "
    f"NOT over-claim z or delta."
)

evidence = {
    "collapse_success": collapse_success,
    "universality_supported": bool(collapse_success and static_evidence_consistent),
    "static_evidence_consistent": static_evidence_consistent,
    "dynamic_scale_observed": collapse_success,
    "z_q_used": z_q_used,
    "tau_q_half": tau_q_half,
    "assessment_note": assessment_note,
}

conclusion = ("consistent_with_directed_percolation" if
              (collapse_success and static_evidence_consistent) else "inconclusive")

report = {
    "task_id": task_id,
    "model": ("1D asymmetric parity-modulated contact process; "
              f"dt={DT}, left_w={W_LEFT}, right_w={W_RIGHT}, "
              f"parity_even={PAR_EVEN}/odd={PAR_ODD}; periodic bc; "
              "random-sequential (1 sweep = L visits); fully active init."),
    "method_summary": (
        f"Scan: lambda_scan {len(lam_sorted)} pts, sizes {size_uniq}, "
        f"n_seeds={N_SEEDS}, t_max={T_MAX}, base seed={BASE_SEED}. "
        f"rho_ss = conditional density over surviving seeds averaged over the "
        f"last {WINDOW} sweeps (identical rule on every scan point). "
        f"lambda_c = median of pairwise crossings of the tmax unconditional "
        f"density between sizes (interpolated over the lambda grid), with an "
        f"explicit intermediate-regime check of the smallest system; CI by "
        f"400-replica seed bootstrap; corroborated by the decay-exponent "
        f"criterion (slope of log rho vs log t on L=256 crossing -DP_theta). "
        f"beta = log-log slope of rho_ss vs (lambda-lambda_c), lambda_c fixed, "
        f"fitted per size (64/128/256); headline = largest-size slope with CI "
