'(':["00010","00100","01000","01000","01000","00100","00010"],
')':["01000","00100","00010","00010","00010","00100","01000"],
}

def png_write(path, rgb, scale=2):
    H, W, _ = rgb.shape
    # simple 2x2 box upscale for a crisper figure
    if scale > 1:
        H2, W2 = H * scale, W * scale
        big = np.zeros((H2, W2, 3), dtype=np.uint8)
        for dy in range(scale):
            for dx in range(scale):
                big[dy::scale, dx::scale] = rgb
        rgb = big; H, W = H2, W2
    raw = bytearray()
    for y in range(H):
        raw.append(0)
        raw.extend(rgb[y].tobytes())
    def chunk(typ, data):
        c = struct.pack(">I", len(data)) + typ + data
        return c + struct.pack(">I", zlib.crc32(typ + data) & 0xffffffff)
    sig = b"\x89PNG\r\n\x1a\n"
    ihdr = struct.pack(">IIBBBBB", W, H, 8, 2, 0, 0, 0)
    idat = zlib.compress(bytes(raw), 6)
    with open(path, "wb") as fh:
        fh.write(sig + chunk(b"IHDR", ihdr) + chunk(b"IDAT", idat) + chunk(b"IEND", b""))

class Canvas:
    def __init__(self, W, H):
        self.W, self.H = W, H
        self.img = np.full((H, W, 3), 255, dtype=np.uint8)
    def rect(self, x0, y0, x1, y1, color):
        x0, y0 = max(0, int(x0)), max(0, int(y0))
        x1, y1 = min(self.W, int(x1)), min(self.H, int(y1))
        if x1 > x0 and y1 > y0:
            self.img[y0:y1, x0:x1] = color
    def line(self, p0, p1, color, w=1):
        x0, y0 = int(p0[0]), int(p0[1]); x1, y1 = int(p1[0]), int(p1[1])
        dx, dy = abs(x1-x0), abs(y1-y0)
        sx, sy = (1 if x1 > x0 else -1), (1 if y1 > y0 else -1)
        err = dx - dy
        while True:
            for ox in range(-w//2, -(-w//2)):
                for oy in range(-w//2, -(-w//2)):
                    xx, yy = x0+ox, y0+oy
                    if 0 <= xx < self.W and 0 <= yy < self.H:
                        self.img[yy, xx] = color
            if x0 == x1 and y0 == y1: break
            e2 = 2*err
            if e2 > -dy: err -= dy; x0 += sx
            if e2 < dx: err += dx; y0 += sy
    def polyline(self, pts, color, w=1):
        for i in range(len(pts)-1):
            self.line(pts[i], pts[i+1], color, w)
    def text(self, x, y, s, color, scale=1):
        s = s.upper()
        xx, yy = int(x), int(y)
        for ch in s:
            pat = FONT.get(ch, FONT[' '])
            if ch != ' ':
                for r in range(7):
                    for c in range(5):
                        if pat[r][c] == '1':
                            for ox in range(scale):
                                for oy in range(scale):
                                    px, py = xx + c*scale + ox, yy + r*scale + oy
                                    if 0 <= px < self.W and 0 <= py < self.H:
                                        self.img[py, px] = color
            xx += 6 * scale

def _fmt(x):
    return ("%.3f" % x) if abs(x) < 100 else ("%.1f" % x)

