def _add_text(img_f, px, py, text, color, scale):
    """Draw text with the 5x7 bitmap font at pixel (px,py). color: RGB float."""
    cx = px
    for ch in text.lower():
        glyph = FONT5X7.get(ch, FONT5X7[" "])
        gw, gh = 5, 7
        for row, pat in enumerate(glyph):
            for col, bit in enumerate(pat):
                if bit == "1":
                    r0 = int(py + row * scale)
                    c0 = int(cx + col * scale)
                    for dy in range(scale):
                        for dx in range(scale):
                            rr, cc = r0 + dy, c0 + dx
                            if 0 <= rr < img_f.shape[0] and 0 <= cc < img_f.shape[1]:
                                img_f[rr, cc] = np.asarray(color, float)
        cx += (gw + 1) * scale
    return cx


def _add_capsule(img_f, a, b, color, radius, alpha=1.0):
    """Anti-aliased thick line (capsule) into a float RGB buffer."""
    h, w = img_f.shape[:2]
    a = np.asarray(a, float)
    b = np.asarray(b, float)
    ab = b - a
    lab2 = float(ab @ ab)
    x0 = int(np.floor(min(a[0], b[0]) - radius)); x1 = int(np.ceil(max(a[0], b[0]) + radius))
    y0 = int(np.floor(min(a[1], b[1]) - radius)); y1 = int(np.ceil(max(a[1], b[1]) + radius))
    x0 = max(0, x0); y0 = max(0, y0); x1 = min(w - 1, x1); y1 = min(h - 1, y1)
    if x1 < x0 or y1 < y0:
        return
    xs = np.arange(x0, x1 + 1, dtype=float)
    ys = np.arange(y0, y1 + 1, dtype=float)
    X, Y = np.meshgrid(xs, ys)
    P = np.stack([X, Y], axis=-1)
    if lab2 > 1e-12:
        t = np.clip(((P - a) @ ab) / lab2, 0.0, 1.0)
        Q = a + t[..., None] * ab
        dist = np.linalg.norm(P - Q, axis=-1)
    else:
        dist = np.linalg.norm(P - a, axis=-1)
    cov = np.clip(1.0 - dist / radius, 0.0, 1.0)
    acov = alpha * cov[..., None]
    sl = (slice(y0, y1 + 1), slice(x0, x1 + 1))
    img_f[sl] += acov * (np.asarray(color, float) - img_f[sl])


def _false_color(p):
    """RGB color for a loop by false_probability (green=0 -> red=1)."""
    t = float(np.clip(p, 0.0, 1.0))
    return (t, 1.0 - t, 0.18 * (1.0 - t))


def make_diagnostics_png(p_init, p_fin, loops, p_false, accepted_mask,
                         accepted_ids, out_path):
    """Render trajectory + loop diagnostics to a PNG (pure numpy/zlib)."""
    W, H = 1280, 960
    margin_l, margin_r, margin_t, margin_b = 95, 45, 80, 65
    img = np.full((H, W, 3), 1.0, dtype=float)          # white background

    xs = p_fin[:, 0]; ys = p_fin[:, 1]
    xmin, xmax = float(xs.min()), float(xs.max())
    ymin, ymax = float(ys.min()), float(ys.max())
    pad = max(2.0, 0.05 * max(xmax - xmin, ymax - ymin))
    xmin -= pad; xmax += pad; ymin -= pad; ymax += pad
    avail_w = W - margin_l - margin_r
    avail_h = H - margin_t - margin_b
    scale = min(avail_w / (xmax - xmin), avail_h / (ymax - ymin))
    ox = margin_l + (avail_w - (xmax - xmin) * scale) / 2.0
    oy = margin_t + (avail_h - (ymax - ymin) * scale) / 2.0

    def wx(imgx): return (imgx - ox) / scale + xmin
    def wy(imgy): return ymax - (imgy - oy) / scale

    def to_img(x, y):
        return (ox + (x - xmin) * scale, oy + (ymax - y) * scale)

    plot_x0, plot_y0 = to_img(xmin, ymin)
    plot_x1, plot_y1 = to_img(xmax, ymax)

    # --- grid + axes ticks (5 m) ---
    tick = 5.0
    grid_col = (0.88, 0.88, 0.90)
    txs = np.arange(np.ceil(xmin / tick) * tick, xmax, tick)
    tys = np.arange(np.ceil(ymin / tick) * tick, ymax, tick)
    for gx in txs:
        a = to_img(gx, ymin); b = to_img(gx, ymax)
        _add_capsule(img, a, b, grid_col, 0.6)
    for gy in tys:
        a = to_img(xmin, gy); b = to_img(xmax, gy)
        _add_capsule(img, a, b, grid_col, 0.6)
    for gx in txs:
        a, _ = to_img(gx, ymin)
        _add_capsule(img, (a, plot_y0 - 4), (a, plot_y0 + 4), (0.2, 0.2, 0.2), 1.0)
        _add_text(img, a - 14, plot_y0 + 8, ("%.0f" % gx), (0.1, 0.1, 0.1), 2)
    for gy in tys:
        _, b = to_img(xmin, gy)
        _add_capsule(img, (plot_x0 - 4, b), (plot_x0 + 4, b), (0.2, 0.2, 0.2), 1.0)
        _add_text(img, plot_x0 - 58, b - 6, ("%.0f" % gy), (0.1, 0.1, 0.1), 2)
    _add_text(img, plot_x0 + 2, plot_y0 + 28, "x [m]", (0.15, 0.15, 0.15), 2)
    _add_text(img, 10, plot_y0 + (plot_y1 - plot_y0) // 2, "y [m]", (0.15, 0.15, 0.15), 2)

    # --- trajectories ---
    xi, yi = to_img(p_init[:, 0], p_init[:, 1])
    pts_init = list(zip(np.atleast_1d(xi), np.atleast_1d(yi)))
    for k in range(len(pts_init) - 1):
        _add_capsule(img, pts_init[k], pts_init[k + 1], (0.72, 0.72, 0.72), 1.1)
    xf, yf = to_img(p_fin[:, 0], p_fin[:, 1])
    pts_fin = list(zip(np.atleast_1d(xf), np.atleast_1d(yf)))
    for k in range(len(pts_fin) - 1):
        _add_capsule(img, pts_fin[k], pts_fin[k + 1], (0.06, 0.22, 0.80), 1.4)
    # anchor pose 0
    a0 = to_img(p_fin[0, 0], p_fin[0, 1])
    _add_capsule(img, (a0[0] - 4, a0[1]), (a0[0] + 4, a0[1]), (0.0, 0.0, 0.0), 2.0)
    _add_capsule(img, (a0[0], a0[1] - 4), (a0[0], a0[1] + 4), (0.0, 0.0, 0.0), 2.0)

    # --- loop candidates ---
    for k in range(len(loops)):
        i = int(loops["from"].to_numpy()[k])
        j = int(loops["to"].to_numpy()[k])
        a = to_img(p_fin[i, 0], p_fin[i, 1])
        b = to_img(p_fin[j, 0], p_fin[j, 1])
        col = _false_color(p_false[k])
        _add_capsule(img, a, b, col, 1.3, alpha=0.85)
        if bool(accepted_mask[k]):
            _add_capsule(img, a, b, (0.0, 0.0, 0.0), 2.6, alpha=1.0)
            _add_capsule(img, a, b, col, 2.0, alpha=1.0)

    # --- colorbar for false_probability ---
    cb_x0, cb_y0, cb_w, cb_h = plot_x0 + 40, plot_y1 + 14, 240, 12
    n_steps = 200
    for s in range(n_steps):
        p = s / (n_steps - 1)
        col = _false_color(p)
        _add_capsule(img, (cb_x0 + s * cb_w / n_steps, cb_y0),
                     (cb_x0 + s * cb_w / n_steps, cb_y0), col, cb_h / 2.0)
    _add_text(img, cb_x0, cb_y0 + 16, "0.0", (0.1, 0.1, 0.1), 2)
    _add_text(img, cb_x0 + cb_w / 2 - 16, cb_y0 + 16, "0.5", (0.1, 0.1, 0.1), 2)
    _add_text(img, cb_x0 + cb_w - 42, cb_y0 + 16, "1.0", (0.1, 0.1, 0.1), 2)
    _add_text(img, cb_x0, cb_y0 + 30, "loop false probability", (0.15, 0.15, 0.15), 2)

    # --- legend ---
    lx, ly = margin_l + 10, 14
    _add_capsule(img, (lx, ly + 4), (lx + 46, ly + 4), (0.72, 0.72, 0.72), 2.0)
    _add_text(img, lx + 52, ly, "initial trajectory", (0.15, 0.15, 0.15), 2)
    _add_capsule(img, (lx + 250, ly + 4), (lx + 296, ly + 4), (0.06, 0.22, 0.80), 2.2)
    _add_text(img, lx + 302, ly, "final trajectory", (0.15, 0.15, 0.15), 2)
    _add_capsule(img, (lx + 500, ly + 4), (lx + 546, ly + 4), (0.85, 0.15, 0.15), 1.8)
    _add_text(img, lx + 552, ly, "loop candidate", (0.15, 0.15, 0.15), 2)
    if len(accepted_ids):
        _add_capsule(img, (lx + 760, ly + 4), (lx + 806, ly + 4), (0.0, 0.0, 0.0), 3.0)
        _add_text(img, lx + 812, ly, "accepted loop", (0.15, 0.15, 0.15), 2)

    # --- title ---
    _add_text(img, margin_l, 6, "Mobile-Robot Map Consistency -- robust pose graph",
              (0.05, 0.05, 0.05), 3)

    # frame
    _add_capsule(img, (plot_x0, plot_y0), (plot_x1, plot_y0), (0.15, 0.15, 0.15), 1.0)
    _add_capsule(img, (plot_x1, plot_y0), (plot_x1, plot_y1), (0.15, 0.15, 0.15), 1.0)
    _add_capsule(img, (plot_x1, plot_y1), (plot_x0, plot_y1), (0.15, 0.15, 0.15), 1.0)
    _add_capsule(img, (plot_x0, plot_y1), (plot_x0, plot_y0), (0.15, 0.15, 0.15), 1.0)

    rgb = np.clip(np.round(img * 255.0), 0, 255).astype(np.uint8)
    with open(out_path, "wb") as f:
        f.write(_png_encode(rgb))
    print("map_diagnostics.png written:", out_path, rgb.shape)


