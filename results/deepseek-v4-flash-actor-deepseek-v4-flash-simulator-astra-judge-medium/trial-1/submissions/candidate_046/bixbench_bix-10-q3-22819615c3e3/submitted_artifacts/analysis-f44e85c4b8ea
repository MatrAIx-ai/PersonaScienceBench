"""
BixBench episode bix-10-q3
In which patient volume group (patients_seen) is there a statistically significant
(p < 0.05) difference in COVID-19 severity between BCG and placebo, by chi-square?

Approach (approved plan):
  - Read DM (patients_seen, TRTGRP) and AE (AESEV, AEPT, USUBJID) from CSV (UTF-8).
  - COVID-19 events: AEPT contains 'COVID' (COVID-19, COVID-19 pneumonia,
    Asymptomatic COVID-19). Severity = AESEV (CDISC: 1=Mild, 2=Moderate,
    3=Severe, 4=Critical/Life-threatening).
  - Collapse severity to 3 classes: Mild(1) / Moderate(2) / Severe(3+4).
  - Drop COVID events with missing AESEV (duplicate/follow-up rows without grading).
  - Unit of analysis: COVID events (event level), a documented working assumption.
  - For each existing patients_seen stratum (1-50, 51-100, >100): chi-square test
    of independence on the TRTGRP x severity 2x3 table.
"""
import numpy as np
import pandas as pd
from scipy.stats import chi2_contingency

CSV_DM = "data/TASK008_BCG-CORONA_DM.csv"
CSV_AE = "data/TASK008_BCG-CORONA_AE.csv"

dm = pd.read_csv(CSV_DM, encoding="utf-8")          # 1000 x 11
ae = pd.read_csv(CSV_AE, encoding="utf-8")          # 2694 x 51

# --- COVID-19 event filter (AEPT contains 'COVID') ---------------------------
covid = ae[ae["AEPT"].str.contains("COVID", case=False, na=False)].copy()
dm_join = dm[["USUBJID", "TRTGRP", "patients_seen"]]
covid = covid.drop(columns=["TRTGRP"]).merge(dm_join, on="USUBJID", how="left")  # TRTGRP/patients_seen from DM

# --- Severity from AESEV ------------------------------------------------------
# CDISC AESEV: 1=Mild, 2=Moderate, 3=Severe, 4=Critical
severity_map = {1: "Mild", 2: "Moderate", 3: "Severe", 4: "Severe"}  # 3+4 collapsed
covid = covid.dropna(subset=["AESEV"]).copy()        # drop missing-severity events
covid["severity"] = covid["AESEV"].map(severity_map)
assert covid["severity"].notna().all()

print("COVID-19 events with non-null severity: n =", len(covid))
print(covid.groupby("severity").size().rename("events"))
print()

# --- Per-stratum chi-square test of independence (TRTGRP x severity) ---------
print("=" * 78)
print("Chi-square (TRTGRP BCG vs Placebo  x  COVID-19 severity) within each patients_seen stratum")
print("Severity classes: Mild(1) | Moderate(2) | Severe(3+4)   [event-level analysis]")
print("=" * 78)

results = []
for ps in ["1-50", "51-100", ">100"]:
    sub = covid[covid["patients_seen"] == ps]
    table = pd.crosstab(sub["TRTGRP"], sub["severity"]).reindex(
        index=["BCG", "Placebo"], columns=["Mild", "Moderate", "Severe"], fill_value=0
    )
    chi2, p, dof, expected = chi2_contingency(table)
    results.append({"patients_seen": ps, "n_events": len(sub), "chi2": chi2, "p": p,
                    "dof": dof, "table": table})
    sig = "SIGNIFICANT (p<0.05)" if p < 0.05 else "not significant"
    print(f"\npatients_seen = {ps!r}   (n COVID events = {len(sub)})")
    print(table.to_string())
    print(f"  chi2 = {chi2:.3f}, df = {dof}, p = {p:.5f}  -> {sig}")

print("\n" + "=" * 78)
print("SUMMARY")
for r in results:
    print(f"  patients_seen={r['patients_seen']!r}: chi2={r['chi2']:.3f}, p={r['p']:.5f} "
          f"{'<0.05 SIGNIFICANT' if r['p'] < 0.05 else '(NS)'}")

sig_groups = [r["patients_seen"] for r in results if r["p"] < 0.05]
print("\nGroups with statistically significant difference (p<0.05):", sig_groups or "none")

# -----------------------------------------------------------------------------
# SENSITIVITY / ROBUSTNESS (documented working assumptions)
# -----------------------------------------------------------------------------
print("\n" + "=" * 78)
print("SENSITIVITY CHECKS")
print("=" * 78)

# (a) Patient-level: worst AESEV per patient (3 classes), COVID patients only
print("\n(a) PATIENT-level analysis (worst AESEV per patient, 3 classes):")
covid_pl = ae[ae["AEPT"].str.contains("COVID", case=False, na=False)].copy()
covid_pl = covid_pl.drop(columns=["TRTGRP"]).merge(dm[["USUBJID", "TRTGRP", "patients_seen"]], on="USUBJID", how="left")
covid_pl = covid_pl.dropna(subset=["AESEV"])
worst = covid_pl.groupby("USUBJID")["AESEV"].max().reset_index()
worst = worst.merge(dm[["USUBJID", "TRTGRP", "patients_seen"]], on="USUBJID")
worst["severity"] = worst["AESEV"].map(severity_map)
for ps in ["1-50", "51-100", ">100"]:
    sub = worst[worst["patients_seen"] == ps]
    table = pd.crosstab(sub["TRTGRP"], sub["severity"]).reindex(
        index=["BCG", "Placebo"], columns=["Mild", "Moderate", "Severe"], fill_value=0)
    chi2, p, dof, _ = chi2_contingency(table)
    print(f"  patients_seen={ps!r}: n_patients={len(sub)} chi2={chi2:.3f} p={p:.4f} "
          f"{'SIG' if p < 0.05 else 'NS'}")

# (b) Include 'SARS-CoV-2 test positive' as COVID events
print("\n(b) Including 'SARS-CoV-2 test positive' events (AEPT contains 'COVID' or 'SARS'):")
covid_s = ae[ae["AEPT"].str.contains("COVID|SARS", case=False, na=False)].copy()
covid_s = covid_s.drop(columns=["TRTGRP"]).merge(dm[["USUBJID", "TRTGRP", "patients_seen"]], on="USUBJID", how="left")
covid_s = covid_s.dropna(subset=["AESEV"])
covid_s["severity"] = covid_s["AESEV"].map(severity_map)
for ps in ["1-50", "51-100", ">100"]:
    sub = covid_s[covid_s["patients_seen"] == ps]
    table = pd.crosstab(sub["TRTGRP"], sub["severity"]).reindex(
        index=["BCG", "Placebo"], columns=["Mild", "Moderate", "Severe"], fill_value=0)
    chi2, p, dof, _ = chi2_contingency(table)
    print(f"  patients_seen={ps!r}: n_events={len(sub)} chi2={chi2:.3f} p={p:.4f} "
          f"{'SIG' if p < 0.05 else 'NS'}")

# (c) AESEV codebook sanity: confirm AE TRTGRP always equals DM TRTGRP
print("\n(c) AESEV non-null event counts by severity code (all 174 COVID events):")
print(covid.groupby("AESEV").size().rename({1: "1=Mild", 2: "2=Moderate", 3: "3=Severe", 4: "4=Critical"}))
print("\nAll done.")
