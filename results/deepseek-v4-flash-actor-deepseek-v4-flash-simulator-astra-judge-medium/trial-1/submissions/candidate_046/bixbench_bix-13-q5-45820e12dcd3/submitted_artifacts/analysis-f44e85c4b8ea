#!/usr/bin/env python3
"""
BixBench bix-13-q5 - DESeq2-style differential expression, reference strain JBX1.

Question: Using DESeq2 relative to strain JBX1, how many genes are uniquely and
statistically differentially expressed in at least one of the Delta-lasI or Delta-rhlI
single mutants but are NOT differentially expressed in the Delta-lasI Delta-rhlI double
mutant?  Benjamini-Hochberg FDR < 0.05.

Implementation = faithful DESeq2 default pipeline re-implemented in Python
(numpy/scipy) because this sandbox has no R/Bioconductor and no network:
  * size factors: median-of-ratios (genes with positive geometric mean)
  * dispersion:   per-gene Cox-Reid APL MLE (2 passes of NB-GLM IRLS + CR optimisation)
                  -> parametric quadratic mean-dispersion trend on log scale
                  -> empirical-Bayes MAP shrinkage (weighted average in log space with
                     per-gene variance; dispersions floored at the trend)  [DESeq2 default]
  * LFC:          NB-GLM MLE (log link, Var = mu + disp*mu^2), IRLS
  * test:         Wald, t-distribution with n-p df
  * padj:         Benjamini-Hochberg over genes passing independent filtering by baseMean
                  (DESeq2 results() default); NA padj = not significant
  * design:       ~ Media + Strain, reference strain JBX1 = "1" (Media as covariate)
  * contrasts:    strain 97/98/99 vs strain 1 (3 pairwise Wald contrasts)
Final operation (no double counting):
  count(genes) = (padj_lasI < 0.05) OR (padj_rhlI < 0.05)  AND  NOT (padj_dbl < 0.05)
Strain->mutant assignment is data-driven: the mutant with the largest DE footprint vs
JBX1 is the double mutant (quorum-sensing regulon logic); the two single mutants are
exchangeable because the criterion uses their union.
"""
import numpy as np, pandas as pd
from scipy.special import gammaln
from scipy.optimize import minimize_scalar
from scipy.stats import t as tdist
np.seterr(divide="ignore", invalid="ignore", over="ignore")
DATA="/workspace/data"; OUT="/workspace/analysis"

# ---------------- core ----------------
def glm_weights(mu,d): return mu/(1.0+d*mu)
def cr_apl(a,y,mu,X):
    mu=np.clip(mu,1e-12,None); k=1.0/a
    ll=(gammaln(y+k)-gammaln(k)-gammaln(y+1)+k*np.log(k)+y*np.log(mu)-(y+k)*np.log(mu+k))
    w=glm_weights(mu,a); M=(X*w[:,None]).T@X; s,ld=np.linalg.slogdet(M)
    return ll.sum()-0.5*(ld if s>0 else -1e10)
def nbll(Y,mu,d):
    k=1.0/d; return (gammaln(Y+k)-gammaln(k)-gammaln(Y+1)+k*np.log(k)
                     +Y*np.log(mu)-(Y+k)*np.log(mu+k)).sum(0)
def irls(X,Y,b0,d,max_iter=150,tol=1e-9):
    b=b0.copy()
    for it in range(max_iter):
        eta=X@b; mu=np.clip(np.exp(eta),1e-15,None); ll=nbll(Y,mu,d)
        w=glm_weights(mu,d); z=eta+(Y-mu)/mu
        A=np.einsum("ni,nj,ng->gij",X,X,w); B=np.einsum("ni,ng,ng->gi",X,w,z)
        nb=np.linalg.solve(A,B[:,:,None])[...,0].T; st=nb-b; al=1.0; acc=False
        for _ in range(30):
            cand=b+al*st
            if np.all(nbll(Y,np.clip(np.exp(X@cand),1e-15,None),d)>=ll-1e-9):
                b=cand; acc=True; break
            al*=0.5
        if not acc: break
        if np.abs(al*st).max()<tol: return b,it+1
    return b,max_iter
def bh(pv):
    m=len(pv); o=np.argsort(pv); q=pv[o]*m/np.arange(1,m+1)
    q=np.minimum.accumulate(q[::-1])[::-1]; out=np.empty(m); out[o]=q
    return np.clip(out,0,1)

# ---------------- data & design ----------------
md=pd.read_csv(f"{DATA}/experiment_metadata.csv").set_index("AzentaName")
raw=pd.read_csv(f"{DATA}/raw_counts.csv", index_col=0)
Y0=raw[md.index].T.values.astype(float); n,g=Y0.shape; genes=raw.index
media=md["Media"].astype(str).values; strain=md["Strain"].astype(str).values
X=np.column_stack([np.ones(n),(media=="MMGluFePlus").astype(float),
                   (media=="Succinate").astype(float),(strain=="97").astype(float),
                   (strain=="98").astype(float),(strain=="99").astype(float)])
cols=["(Intercept)","media_MMGluFePlus","media_Succinate","strain_97","strain_98","strain_99"]
strain_col={s:f"strain_{s}" for s in ["97","98","99"]}

# ---------------- size factors ----------------
lc=np.log(Y0); vg=np.all(np.isfinite(lc),axis=0)
gm=np.exp(lc[:,vg].mean(axis=0)); sf=np.median(Y0[:,vg]/gm[None,:],axis=1)
norm=Y0/sf[:,None]; baseMean=norm.mean(axis=0)

# ---------------- dispersion ----------------
disp=np.full(g,0.1); beta,_=irls(X,Y0,np.zeros((len(cols),g)),np.full(g,1e-5))
for k in range(2):
    beta,it=irls(X,Y0,beta,disp); mu=np.clip(np.exp(X@beta),1e-12,None)
    disp=np.array([minimize_scalar(lambda a:-cr_apl(a,Y0[:,j],mu[:,j],X),
                                   bounds=(1e-8,1e2),method="bounded",
                                   options={"xatol":1e-8}).x for j in range(g)])
ldisp=np.log(disp); lm=np.log(np.clip(baseMean,0.5,None))
coef=np.polyfit(lm,ldisp,2); tld=np.polyval(coef,lm); trend=np.exp(tld)
def cr_log(la,j): return cr_apl(np.exp(la),Y0[:,j],mu[:,j],X)
h=1e-4; geneVar=np.empty(g)
for j in range(g):
    la0=ldisp[j]; f0=cr_log(la0,j); fp=cr_log(la0+h,j); fm=cr_log(la0-h,j)
    d2=(fp-2*f0+fm)/h**2
    geneVar[j]=max(-1/d2,1e-8) if np.isfinite(d2) and d2<-1e-12 else 1e6
resid=ldisp-tld; priorVar=max((1.4826*np.median(np.abs(resid-np.median(resid))))**2,0.1)
la_map=(tld/priorVar+ldisp/geneVar)/(1/priorVar+1/geneVar)
disp_map=np.where(disp<=trend, trend, np.exp(la_map))     # floor at trend
disp_final=np.clip(disp_map,1e-8,1e2)

# ---------------- final Wald ----------------
beta,it=irls(X,Y0,beta,disp_final); mu=np.clip(np.exp(X@beta),1e-12,None)
w=glm_weights(mu,disp_final)
A=np.einsum("ni,nj,ng->gij",X,X,w); se=np.sqrt(np.einsum("gii->gi",np.linalg.inv(A)))
dof=n-len(cols)

def res(contr,ifilter=True):
    i=cols.index(contr); lfc=beta[i]; st=lfc/se[:,i]
    pv=np.clip(2*tdist.sf(np.abs(st),dof),0,1)
    if ifilter:
        cut=np.unique(np.quantile(baseMean,np.arange(0,21)/20)); best=(-1,None)
        for c in cut:
            kp=baseMean>c; nr=int(np.sum(pv[kp]<0.1))
            if nr>best[0]: best=(nr,c)
        kp=baseMean>best[1]; padj=np.full(g,np.nan); padj[kp]=bh(pv[kp])
    else:
        padj=bh(pv)
    return padj, lfc

R={}; P={}
for s in ["97","98","99"]:
    P[s], L = res(strain_col[s])
    R[s]=pd.DataFrame({"baseMean":baseMean,"log2FoldChange":L[cols.index(strain_col[s])]/np.log(2),
                       "lfcSE":se[:,cols.index(strain_col[s])]/np.log(2),
                       "pvalue":2*tdist.sf(np.abs(beta[cols.index(strain_col[s])]/se[:,cols.index(strain_col[s])]),dof),
                       "padj":P[s]}, index=genes)

# ---------------- interpretation ----------------
de={s:int((P[s]<0.05).sum()) for s in ["97","98","99"]}
dbl=max(de,key=de.get); sin=[s for s in ["97","98","99"] if s!=dbl]
pl=P[sin[0]]; pr=P[sin[1]]; pd_=P[dbl]
final_mask=((pl<0.05)|(pr<0.05)) & ~(pd_<0.05)
final_count=int(final_mask.sum())

print("="*72)
print("DESIGN: ~ Media + Strain;  reference strain JBX1 = '1'")
print("size factors: min=%.3f max=%.3f median=%.3f"%(sf.min(),sf.max(),np.median(sf)))
print("dispersion medians: gene-wise=%.4f trend=%.4f MAP=%.4f (priorVar=%.3f)"%(
      np.median(disp),np.median(trend),np.median(disp_final),priorVar))
print("DE per strain (padj<0.05 vs JBX1): %s"%de)
print("Double-mutant candidate (largest footprint): strain %s | singles: %s"%(dbl,sin))
print("Genes sig in >=1 single:",int(((pl<0.05)|(pr<0.05)).sum()))
print("  of which also sig in double:",int((((pl<0.05)|(pr<0.05))&(pd_<0.05)).sum()))
print("FINAL = %d" % final_count)
print("="*72)

# sensitivity
def count_alt(tld, disp_use_gw, ifilter=True):
    dm=np.where(disp<=trend,trend,np.exp((tld/priorVar+ldisp/geneVar)/(1/priorVar+1/geneVar)))
    b2,_=irls(X,Y0,beta,dm); m2=np.clip(np.exp(X@b2),1e-12,None); w2=glm_weights(m2,dm)
    A2=np.einsum("ni,nj,ng->gij",X,X,w2); se2=np.sqrt(np.einsum("gii->gi",np.linalg.inv(A2)))
    out={}
    for s in ["97","98","99"]:
        i=cols.index(strain_col[s]); st=b2[i]/se2[:,i]
        pv=np.clip(2*tdist.sf(np.abs(st),dof),0,1)
        if ifilter:
            cut=np.unique(np.quantile(baseMean,np.arange(0,21)/20)); best=(-1,None)
            for c in cut:
                kp=baseMean>c; nr=int(np.sum(pv[kp]<0.1))
                if nr>best[0]: best=(nr,c)
            kp=baseMean>best[1]; padj=np.full(g,np.nan); padj[kp]=bh(pv[kp])
        else: padj=bh(pv)
        out[s]=padj
    return int((((out[sin[0]]<0.05)|(out[sin[1]]<0.05)) & ~(out[dbl]<0.05)).sum())

print("SENSITIVITY:")
print("  MAP, no independent filtering:            ", count_alt(tld,None,ifilter=False))
print("  gene-wise CR dispersion (no MAP):          ", end="")
b_gw,_=irls(X,Y0,beta,disp); m2=np.clip(np.exp(X@b_gw),1e-12,None); w2=glm_weights(m2,disp)
A2=np.einsum("ni,nj,ng->gij",X,X,w2); se2=np.sqrt(np.einsum("gii->gi",np.linalg.inv(A2)))
o={}
for s in ["97","98","99"]:
    i=cols.index(strain_col[s]); st=b_gw[i]/se2[:,i]
    pv=np.clip(2*tdist.sf(np.abs(st),dof),0,1)
    cut=np.unique(np.quantile(baseMean,np.arange(0,21)/20)); best=(-1,None)
    for c in cut:
        kp=baseMean>c; nr=int(np.sum(pv[kp]<0.1))
        if nr>best[0]: best=(nr,c)
    kp=baseMean>best[1]; padj=np.full(g,np.nan); padj[kp]=bh(pv[kp]); o[s]=padj
print(int((((o[sin[0]]<0.05)|(o[sin[1]]<0.05)) & ~(o[dbl]<0.05)).sum()))
print("  trend-only dispersion:                     ", end="")
b_tr,_=irls(X,Y0,beta,trend); m2=np.clip(np.exp(X@b_tr),1e-12,None); w2=glm_weights(m2,trend)
A2=np.einsum("ni,nj,ng->gij",X,X,w2); se2=np.sqrt(np.einsum("gii->gi",np.linalg.inv(A2)))
o={}
for s in ["97","98","99"]:
    i=cols.index(strain_col[s]); st=b_tr[i]/se2[:,i]
    pv=np.clip(2*tdist.sf(np.abs(st),dof),0,1)
    cut=np.unique(np.quantile(baseMean,np.arange(0,21)/20)); best=(-1,None)
    for c in cut:
        kp=baseMean>c; nr=int(np.sum(pv[kp]<0.1))
        if nr>best[0]: best=(nr,c)
    kp=baseMean>best[1]; padj=np.full(g,np.nan); padj[kp]=bh(pv[kp]); o[s]=padj
print(int((((o[sin[0]]<0.05)|(o[sin[1]]<0.05)) & ~(o[dbl]<0.05)).sum()))
print("  design ~Strain only (no Media):            see deseq2_strain_only.py -> reported below")

# --- save outputs ---
for s in ["97","98","99",]:
    R[s].to_csv(f"{OUT}/final_results_strain_{s}.csv")
pd.Series(sf,index=md.index,name="sizeFactor").to_csv(f"{OUT}/final_size_factors.csv")
pd.DataFrame({"gene":genes,"disp_geneWise":disp,"disp_trend":trend,"disp_MAP":disp_final,
              "baseMean":baseMean}).to_csv(f"{OUT}/final_dispersions.csv",index=False)
final_genes = pd.Series(genes[final_mask])
final_genes.to_csv(f"{OUT}/final_gene_list.csv",header=["gene"],index=False)
summary = pd.DataFrame({
    "per_strain_DE": de,
    "double_mutant_candidate_strain": dbl,
    "single_mutant_strains": [sin],
    "single_union_DE": int(((pl<0.05)|(pr<0.05)).sum()),
    "single_and_double_DE": int((((pl<0.05)|(pr<0.05))&(pd_<0.05)).sum()),
    "FINAL_COUNT": final_count,
}, index=[0])
summary.to_csv(f"{OUT}/final_summary.csv",index=False)
print("saved outputs to",OUT)
