#!/usr/bin/env python3
"""Sensitivity: same DESeq2-style pipeline but design = ~ Strain only (no Media).
Reference strain JBX1='1'. Reports DE per strain and the final-style count.
(Note: media is a real, balanced experimental factor, so the primary analysis uses
~ Media + Strain; this run quantifies how much the model choice matters.)"""
import numpy as np, pandas as pd
from scipy.special import gammaln
from scipy.optimize import minimize_scalar
from scipy.stats import t as tdist
np.seterr(all="ignore")
DATA="/workspace/data"; OUT="/workspace/analysis"
def glm_weights(mu,d): return mu/(1.0+d*mu)
def cr_apl(a,y,mu,X):
    mu=np.clip(mu,1e-12,None); k=1.0/a
    ll=(gammaln(y+k)-gammaln(k)-gammaln(y+1)+k*np.log(k)+y*np.log(mu)-(y+k)*np.log(mu+k))
    w=glm_weights(mu,a); M=(X*w[:,None]).T@X; s,ld=np.linalg.slogdet(M)
    return ll.sum()-0.5*(ld if s>0 else -1e10)
def nbll(Y,mu,d):
    k=1.0/d; return (gammaln(Y+k)-gammaln(k)-gammaln(Y+1)+k*np.log(k)+Y*np.log(mu)-(Y+k)*np.log(mu+k)).sum(0)
def irls(X,Y,b0,d,max_iter=150,tol=1e-9):
    b=b0.copy()
    for it in range(max_iter):
        eta=X@b; mu=np.clip(np.exp(eta),1e-15,None); ll=nbll(Y,mu,d)
        w=glm_weights(mu,d); z=eta+(Y-mu)/mu
        A=np.einsum("ni,nj,ng->gij",X,X,w); B=np.einsum("ni,ng,ng->gi",X,w,z)
        nb=np.linalg.solve(A,B[:,:,None])[...,0].T; st=nb-b; al=1.0; acc=False
        for _ in range(30):
            cand=b+al*st
            if np.all(nbll(Y,np.clip(np.exp(X@cand),1e-15,None),d)>=ll-1e-9): b=cand; acc=True; break
            al*=0.5
        if not acc: break
        if np.abs(al*st).max()<tol: return b,it+1
    return b,max_iter
def bh(pv):
    m=len(pv); o=np.argsort(pv); q=pv[o]*m/np.arange(1,m+1)
    q=np.minimum.accumulate(q[::-1])[::-1]; out=np.empty(m); out[o]=q
    return np.clip(out,0,1)

md=pd.read_csv(f"{DATA}/experiment_metadata.csv").set_index("AzentaName")
raw=pd.read_csv(f"{DATA}/raw_counts.csv",index_col=0)
Y=raw[md.index].T.values.astype(float); n,g=Y.shape; genes=raw.index
strain=md["Strain"].astype(str).values
X=np.column_stack([np.ones(n),(strain=="97").astype(float),(strain=="98").astype(float),(strain=="99").astype(float)])
cols=["(Intercept)","strain_97","strain_98","strain_99"]
strain_col={s:f"strain_{s}" for s in ["97","98","99"]}
lc=np.log(Y); vg=np.all(np.isfinite(lc),axis=0)
gm=np.exp(lc[:,vg].mean(axis=0)); sf=np.median(Y[:,vg]/gm[None,:],axis=1)
baseMean=(Y/sf[:,None]).mean(axis=0)
disp=np.full(g,0.1); beta,_=irls(X,Y,np.zeros((4,g)),np.full(g,1e-5))
for k in range(2):
    beta,it=irls(X,Y,beta,disp); mu=np.clip(np.exp(X@beta),1e-12,None)
    disp=np.array([minimize_scalar(lambda a:-cr_apl(a,Y[:,j],mu[:,j],X),bounds=(1e-8,1e2),method="bounded",options={"xatol":1e-8}).x for j in range(g)])
ldisp=np.log(disp); lm=np.log(np.clip(baseMean,0.5,None))
coef=np.polyfit(lm,ldisp,2); tld=np.polyval(coef,lm); trend=np.exp(tld)
def cr_log(la,j): return cr_apl(np.exp(la),Y[:,j],mu[:,j],X)
h=1e-4; geneVar=np.empty(g)
for j in range(g):
    la0=ldisp[j]; f0=cr_log(la0,j); fp=cr_log(la0+h,j); fm=cr_log(la0-h,j)
    d2=(fp-2*f0+fm)/h**2
    geneVar[j]=max(-1/d2,1e-8) if np.isfinite(d2) and d2<-1e-12 else 1e6
resid=ldisp-tld; priorVar=max((1.4826*np.median(np.abs(resid-np.median(resid))))**2,0.1)
la_map=(tld/priorVar+ldisp/geneVar)/(1/priorVar+1/geneVar)
disp_final=np.clip(np.where(disp<=trend,trend,np.exp(la_map)),1e-8,1e2)
beta,it=irls(X,Y,beta,disp_final); mu=np.clip(np.exp(X@beta),1e-12,None)
w=glm_weights(mu,disp_final); A=np.einsum("ni,nj,ng->gij",X,X,w); se=np.sqrt(np.einsum("gii->gi",np.linalg.inv(A)))
dof=n-4
def res(contr):
    i=cols.index(contr); st=beta[i]/se[:,i]
    pv=np.clip(2*tdist.sf(np.abs(st),dof),0,1)
    cut=np.unique(np.quantile(baseMean,np.arange(0,21)/20)); best=(-1,None)
    for c in cut:
        kp=baseMean>c; nr=int(np.sum(pv[kp]<0.1))
        if nr>best[0]: best=(nr,c)
    kp=baseMean>best[1]; padj=np.full(g,np.nan); padj[kp]=bh(pv[kp]); return padj
R={s:res(strain_col[s]) for s in ["97","98","99"]}
de={s:int((R[s]<0.05).sum()) for s in ["97","98","99"]}
dbl=max(de,key=de.get); sin=[s for s in ["97","98","99"] if s!=dbl]
f=((R[sin[0]]<0.05)|(R[sin[1]]<0.05)) & ~(R[dbl]<0.05)
print("DESIGN ~Strain only: DE per strain:", de)
print("double candidate:",dbl,"singles:",sin)
print("FINAL (design ~Strain only) =", int(f.sum()))
pd.Series(genes[f],name="gene").to_csv(f"{OUT}/strain_only_final_genes.csv",index=False)
