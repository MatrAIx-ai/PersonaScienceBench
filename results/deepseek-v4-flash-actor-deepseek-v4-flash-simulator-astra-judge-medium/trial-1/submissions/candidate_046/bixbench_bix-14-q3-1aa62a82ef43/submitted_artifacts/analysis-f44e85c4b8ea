#!/usr/bin/env python3
"""
BIX-14-Q3: Count non-reference exonic variants in CHIP genes across 86 exomes.

Definitions (per approved plan):
  * Unit         = per-sample variant observation (one row in one sample's xlsx),
                  summed over the 86 sample files (NOT unique variant sites
                  across samples).
  * Non-reference= Zygosity in {'Heterozygous', 'Homozygous Variant'}.
                  'Reference' and None (no-call) are excluded.
  * Exonic (primary, per researcher decision): Sequence Ontology (Combined) in
      {synonymous_variant, missense_variant, frameshift_variant,
       inframe_insertion, inframe_deletion, splice_region_variant}
    (splice_region_variant is NOT intronic/intergenic/UTR, so it is retained).
    '5_prime_UTR_premature_start_codon_gain_variant' and 'upstream_gene_variant'
    are excluded (UTR / non-exonic).
  * CHIP gene filter: row kept if In_CHIP == 'True' (col 30) and cross-validated
    case-insensitively that Gene Names (col 13) / Match (col 31) are in the
    56-gene list from 230214_Schenz_et_al_2022_CHIP_Genes.xlsx.
  * No additional filters: files are already DP>=10 / GQ>=20 / PASS per folder name.
"""
import openpyxl
import glob
import os
import json
import collections

DATA_DIR = "data"
VAR_DIR = os.path.join(DATA_DIR, "CHIP_DP10_GQ20_PASS")
GENE_FILE = os.path.join(DATA_DIR, "230214_Schenz_et_al_2022_CHIP_Genes.xlsx")

# CHIP gene list (56 genes)
wb = openpyxl.load_workbook(GENE_FILE)
ws = wb[wb.sheetnames[0]]
chip_genes = set()
for row in ws.iter_rows(values_only=True):
    v = row[0]
    if v is not None and str(v).strip():
        chip_genes.add(str(v).strip())
print(f"CHIP gene list: {len(chip_genes)} genes loaded")

# Exonic Sequence Ontology terms to RETAIN (primary, incl. splice_region)
EXONIC_TERMS = {
    "synonymous_variant", "missense_variant", "frameshift_variant",
    "inframe_insertion", "inframe_deletion", "splice_region_variant",
}
# Strict (sensitivity, no splice_region)
EXONIC_STRICT = EXONIC_TERMS - {"splice_region_variant"}

# Columns (1-based) in the two-row header layout
C_CHRPOS, C_REFALT = 1, 2
C_ZYGO, C_GENE, C_SO, C_INCHIP, C_MATCH = 5, 13, 14, 30, 31

files = sorted(glob.glob(os.path.join(VAR_DIR, "*.xlsx")))
print(f"Variant files found: {len(files)}")

so_by_zygo = collections.Counter()          # (so_term, zygosity) -> count
per_sample = collections.defaultdict(lambda: collections.Counter())
inchip_true = 0
gene_validate_fail = 0
total_rows = 0
n_splice_excluded_explain = collections.Counter()

for f in files:
    sample = os.path.basename(f)
    wb = openpyxl.load_workbook(f)          # non-read-only: reliable row count
    ws = wb[wb.sheetnames[0]]
    # rows 1-2 are the two-row header; data starts at row 3
    for r in range(3, ws.max_row + 1):
        zygo = ws.cell(row=r, column=C_ZYGO).value
        so = ws.cell(row=r, column=C_SO).value
        inchip = ws.cell(row=r, column=C_INCHIP).value
        gene = ws.cell(row=r, column=C_GENE).value
        match = ws.cell(row=r, column=C_MATCH).value
        if zygo is None and so is None:
            continue
        total_rows += 1
        if inchip == "True":
            inchip_true += 1
        so_by_zygo[(so, zygo)] += 1
        per_sample[sample][(zygo, so)] += 1
        # validate CHIP membership (case-insensitive) against the 56-gene list
        g = match if match else gene
        if inchip == "True" and g and str(g).strip().upper() not in {x.upper() for x in chip_genes}:
            gene_validate_fail += 1

# ---- Compute counts ----
def nonref(term_set):
    """Rows with Zygosity in {Het, HomVariant} whose SO term is in term_set."""
    n = 0
    for (so, zygo), c in so_by_zygo.items():
        if so in term_set and zygo in ("Heterozygous", "Homozygous Variant"):
            n += c
    return n

primary_nonref_exonic_chip = nonref(EXONIC_TERMS)          # incl. splice_region
strict_nonref_exonic_chip = nonref(EXONIC_STRICT)          # without splice_region
splice_region_contrib = nonref({"splice_region_variant"})

# Per-SO-term non-reference breakdown (for documentation)
per_term_nonref = {}
excluded_terms = {"3_prime_UTR_variant", "5_prime_UTR_variant",
                  "5_prime_UTR_premature_start_codon_gain_variant",
                  "intron_variant", "upstream_gene_variant"}
per_term_excluded = {}
for (so, zygo), c in so_by_zygo.items():
    if zygo not in ("Heterozygous", "Homozygous Variant"):
        continue
    d = per_term_nonref if so in EXONIC_TERMS else per_term_excluded
    d[so] = d.get(so, 0) + c

# Per-sample distribution sanity (all 86 samples contribute)
n_samples_with_nonref = sum(1 for s, c in per_sample.items()
                            if any(zy in ("Heterozygous", "Homozygous Variant") for zy, so in c))

results = {
    "num_sample_files": len(files),
    "num_samples_with_nonref_exonic": n_samples_with_nonref,
    "total_rows_all_files": total_rows,
    "rows_inchip_true": inchip_true,
    "gene_validate_failures": gene_validate_fail,
    "CHIP_genes_loaded": len(chip_genes),
    "primary_nonref_exonic_chip_INCL_splice_region": primary_nonref_exonic_chip,
    "sensitivity_nonref_exonic_chip_EXCL_splice_region": strict_nonref_exonic_chip,
    "splice_region_contribution": splice_region_contrib,
    "exonic_terms_retained": sorted(EXONIC_TERMS),
    "per_term_nonref_retained": dict(sorted(per_term_nonref.items())),
    "per_term_nonref_excluded": dict(sorted(per_term_excluded.items())),
    "total_nonref_all_so_terms": sum(per_term_nonref.values()) + sum(per_term_excluded.values()),
}

print("\n================ RESULT SUMMARY ================")
print(f"Sample files analyzed            : {results['num_sample_files']}")
print(f"Samples with >=1 non-ref exonic  : {results['num_samples_with_nonref_exonic']}")
print(f"Total rows across files         : {results['total_rows_all_files']}")
print(f"Rows with In_CHIP=True           : {results['rows_inchip_true']}")
print(f"Gene-list validation failures    : {results['gene_validate_failures']}")
print(f"--- PRIMARY ANSWER (splice_region included) ---")
print(f"NON-REFERENCE EXONIC VARIANTS IN CHIP GENES (86 samples): {primary_nonref_exonic_chip}")
print("--- SENSITIVITY ---")
print(f"Strict exonic (splice_region EXCLUDED)                : {strict_nonref_exonic_chip}")
print(f"splice_region_variant contribution                   : {splice_region_contrib}")
print("--- Per-SO term, non-reference retained ---")
for k, v in per_term_nonref.items():
    print(f"  {k:<45} {v}")
print("--- Per-SO term, non-reference excluded ---")
for k, v in per_term_excluded.items():
    print(f"  {k:<45} {v}")

os.makedirs("analysis", exist_ok=True)
with open("analysis/CHIP_exonic_count_results.json", "w") as fh:
    json.dump(results, fh, indent=2, sort_keys=True)
print("\nSaved analysis/CHIP_exonic_count_results.json")
