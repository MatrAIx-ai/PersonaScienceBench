#!/usr/bin/env python3
"""
Skewness characterization of gene expression log2(TPM+1) across all cell lines.
Dataset: data/OmicsExpressionProteinCodingGenesTPMLogp1BatchCorrected.csv
Matrix orientation: rows = cell lines (DepMap ACH-*), columns = genes (19138).
Values are already transformed: log2(TPM+1), batch-corrected.

Metrics:
  - Primary : pooled Fisher-Pearson skewness over all values (adjusted, bias=False)
  - Reference: raw moment skewness (bias=True)
  - Secondary: distribution of per-gene skewness and per-cell-line skewness.
"""
import numpy as np
import pandas as pd
import scipy.stats as st
import time

T0 = time.time()
PATH = "data/OmicsExpressionProteinCodingGenesTPMLogp1BatchCorrected.csv"

print("=" * 78)
print("STEP 0 | Load matrix")
df = pd.read_csv(PATH, index_col=0)          # rows = cell lines, cols = genes
print(f"  Loaded in {time.time()-T0:.1f}s | shape = {df.shape[0]} cell lines x {df.shape[1]} genes | dtype = {df.values.dtype}")

# ---- integrity checks ----
n_cells, n_genes = df.shape
na_total = int(df.isna().sum().sum())
n_zero = int((df.values == 0).sum())
print(f"  NaN cells = {na_total} | zero cells = {n_zero}")
assert na_total == 0 and n_zero == 0, "unexpected NaN/zero in matrix"

vals = df.values.ravel()                     # pooled values (32,017,874)

# =====================================================================
print("=" * 78)
print("STEP 1 | Pooled descriptive statistics (all cells x all genes)")
mean = float(vals.mean())
median = float(np.median(vals))
sd = float(vals.std(ddof=1))
mn, mx = float(vals.min()), float(vals.max())
q = np.percentile(vals, [1, 5, 25, 50, 75, 95, 99])
desc = pd.DataFrame({
    "statistic": ["n_values", "cell_lines", "genes", "mean", "median", "sd(ddof=1)",
                  "min", "max", "p1", "p5", "p25", "p50", "p75", "p95", "p99"],
    "value": [vals.size, n_cells, n_genes, mean, median, sd, mn, mx] + list(q),
})
print(desc.to_string(index=False, float_format=lambda x: f"{x:,.6f}"))
print(f"  mean - median = {mean - median:+.4f}  -> mean > median (positive asymmetry hint)")

# ---- pooled Fisher-Pearson skewness ----
print("=" * 78)
print("STEP 2 | Pooled Fisher-Pearson skewness (primary answer)")
g1_adj   = float(st.skew(vals, bias=False))   # adjusted Fisher-Pearson (bias-corrected)
g1_raw   = float(st.skew(vals, bias=True))    # raw moment (population/MLE)
# cross-check with manual third standardized moment
m3 = float(np.mean((vals - mean) ** 3))
g1_manual = m3 / (sd ** 3) if sd > 0 else float("nan")
print(f"  g1 adjusted (bias=False, primary)  = {g1_adj:+.6f}")
print(f"  g1 raw      (bias=True,  reference) = {g1_raw:+.6f}")
print(f"  g1 manual   (m3/s^3, ddof=1 s)      = {g1_manual:+.6f}")
if g1_adj > 0:
    interp = ("POSITIVE (right/positive skew): long right tail -> most genes have low-to-moderate "
              "expression while a relatively small number of genes reach very high expression levels.")
elif g1_adj < 0:
    interp = "NEGATIVE (left skew): long left tail."
else:
    interp = "~0 (approximately symmetric)."
print(f"  Interpretation: {interp}")

# ---- histogram summary (10 bins) for shape context ----
print("=" * 78)
print("STEP 3 | Binned histogram of pooled values (shape context)")
counts, edges = np.histogram(vals, bins=10)
for i in range(10):
    print(f"  [{edges[i]:8.3f}, {edges[i+1]:8.3f}): {counts[i]:>10,}  ({100*counts[i]/vals.size:5.2f}%)")

# =====================================================================
print("=" * 78)
print("STEP 4 | Secondary: per-gene skewness across the 1673 cell lines")
g_by_gene = df.apply(lambda c: st.skew(c.values, bias=False), axis=0)
g1g = g_by_gene.values
print(f"  genes = {g1g.size}")
print(f"  mean={g1g.mean():+.4f}  median={np.median(g1g):+.4f}  sd={g1g.std(ddof=1):.4f}")
print(f"  p1={np.percentile(g1g,1):+.4f} p25={np.percentile(g1g,25):+.4f} "
      f"p50={np.percentile(g1g,50):+.4f} p75={np.percentile(g1g,75):+.4f} p99={np.percentile(g1g,99):+.4f}")
print(f"  % genes with g1>0 = {100*np.mean(g1g>0):.2f}%   % genes with g1>0.5 = {100*np.mean(g1g>0.5):.2f}%   "
      f"range=[{g1g.min():+.4f},{g1g.max():+.4f}]")

print("=" * 78)
print("STEP 5 | Secondary: per-cell-line skewness across the 19138 genes")
g_by_cell = df.apply(lambda r: st.skew(r.values, bias=False), axis=1)
g1c = g_by_cell.values
print(f"  cell lines = {g1c.size}")
print(f"  mean={g1c.mean():+.4f}  median={np.median(g1c):+.4f}  sd={g1c.std(ddof=1):.4f}")
print(f"  p1={np.percentile(g1c,1):+.4f} p25={np.percentile(g1c,25):+.4f} "
      f"p50={np.percentile(g1c,50):+.4f} p75={np.percentile(g1c,75):+.4f} p99={np.percentile(g1c,99):+.4f}")
print(f"  % cell lines with g1>0 = {100*np.mean(g1c>0):.2f}%   % with g1>1 = {100*np.mean(g1c>1):.2f}%   "
      f"range=[{g1c.min():+.4f},{g1c.max():+.4f}]")

# ---- save compact numeric outputs ----
res = {
    "pooled_values_n": int(vals.size),
    "cell_lines": int(n_cells),
    "genes": int(n_genes),
    "pooled_skewness_adjusted_FisherPearson": g1_adj,
    "pooled_skewness_raw_moment": g1_raw,
    "pooled_mean": mean,
    "pooled_median": median,
    "pooled_sd_ddof1": sd,
    "pooled_min": mn,
    "pooled_max": mx,
    "per_gene_skewness_mean": float(g1g.mean()),
    "per_gene_skewness_median": float(np.median(g1g)),
    "per_gene_pct_positive": float(100*np.mean(g1g>0)),
    "per_cell_skewness_mean": float(g1c.mean()),
    "per_cell_skewness_median": float(np.median(g1c)),
    "per_cell_pct_positive": float(100*np.mean(g1c>0)),
}
pd.Series(res).to_csv("results_summary.csv", header=["value"])
print("\nSaved machine-readable summary -> results_summary.csv")
print(f"Total runtime: {time.time()-T0:.1f}s")
print("DONE")
