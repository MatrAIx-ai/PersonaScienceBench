#!/usr/bin/env python3
"""
BixBench bix-22-q2: Pearson correlation between gene length and mean expression
(across samples) for protein-coding genes in CD4 immune cells.

Fixed decisions (agreed with researcher):
  1. Genes: gene_biotype == 'protein_coding' (strict, 19942 genes), joined by Geneid.
  2. Samples: the 151 CD4 samples selected by celltype == 'CD4' in Sample_annotated.
  3. Mean expression per gene = simple arithmetic mean of batch-corrected counts
     over those 151 CD4 samples, NO prior transformation.
  4. Keep ALL protein-coding genes, including those with mean == 0.
  5. Pearson correlation between Length (bp, as-is) and mean expression per gene;
     each gene is one observation.

Sensitivity analyses (reported separately, NOT the final answer):
  a) log2(mean+1) and mean of per-sample log2(count+1)
  b) excluding genes with mean expression == 0
"""

import numpy as np
import pandas as pd
from scipy import stats

DATA = 'data/'

# ----------------------------------------------------------------------
# 1. Load inputs
# ----------------------------------------------------------------------
meta = pd.read_csv(DATA + 'GeneMetaInfo_Zenodo.csv', index_col=0)
ann  = pd.read_csv(DATA + 'Sample_annotated_Zenodo.csv')
counts = pd.read_csv(DATA + 'BatchCorrectedReadCounts_Zenodo.csv', index_col=0)

print('=== Input sizes ===')
print('GeneMetaInfo shape:', meta.shape)
print('Sample_annotated shape:', ann.shape)
print('Counts shape:', counts.shape)

# Check index alignment
assert (counts.index == meta.index).all(), 'Gene index mismatch between counts and meta'
print('Gene index identical between counts and GeneMetaInfo: True')

# ----------------------------------------------------------------------
# 2. Filter protein-coding genes (join by Geneid; already aligned)
# ----------------------------------------------------------------------
pc_mask = (meta['gene_biotype'] == 'protein_coding')
pc_genes = meta.index[pc_mask]
print('\nprotein_coding (strict) genes:', len(pc_genes))

# ----------------------------------------------------------------------
# 3. Select CD4 samples by annotation celltype
# ----------------------------------------------------------------------
cd4_samples = ann.loc[ann['celltype'] == 'CD4', 'sample'].tolist()
n_cd4_by_suffix = sum(1 for s in cd4_samples if s.endswith('CD4'))
print('CD4 samples by celltype annotation:', len(cd4_samples),
      f'({n_cd4_by_suffix} end with literal "CD4" suffix)')
assert set(cd4_samples) <= set(counts.columns), 'Some CD4 samples missing from counts'
print('All CD4 samples present in counts columns: True')

# Ensure the CD4 column order in the expression matrix follows the annotation
# (so "across samples" is well-defined)
cd4_subset = counts.loc[pc_genes, cd4_samples]
print('CD4 expression sub-matrix shape:', cd4_subset.shape)
print('Any missing values:', int(cd4_subset.isna().sum().sum()))
print('All counts non-negative:', bool((cd4_subset >= 0).all().all()))

# ----------------------------------------------------------------------
# 4. Mean expression per gene (simple arithmetic mean, no transformation)
# ----------------------------------------------------------------------
mean_exp = cd4_subset.mean(axis=1)

# ----------------------------------------------------------------------
# 5. Pearson correlation between Length and mean expression
# ----------------------------------------------------------------------
length = meta.loc[pc_genes, 'Length'].astype(float).values
mean_val = mean_exp.values.astype(float)

# Confirm Length > 0
print('\nGenes with Length <= 0:', int((length <= 0).sum()))

r_main, p_main = stats.pearsonr(length, mean_val)
n = len(length)
# 95% confidence interval via Fisher z
z = np.arctanh(r_main)
se = 1.0 / np.sqrt(n - 3)
ci = (np.tanh(z - 1.96 * se), np.tanh(z + 1.96 * se))

print(f'\n=== MAIN RESULT (agreed definition) ===')
print(f'n genes (protein_coding, all): {n}')
print(f'n CD4 samples: {len(cd4_samples)}')
print(f'Pearson r(Length, mean(raw counts)) = {r_main:.6f}')
print(f'p-value = {p_main:.3e}')
print(f'95% CI = ({ci[0]:.6f}, {ci[1]:.6f})')

# ----------------------------------------------------------------------
# 6. Sensitivity analyses (NOT the final answer)
# ----------------------------------------------------------------------
print('\n=== SENSITIVITY (separate from final answer) ===')

# a1) log2(mean+1)
log2_mean1 = np.log2(mean_val + 1.0)
r_a1, _ = stats.pearsonr(length, log2_mean1)

# a2) mean of per-sample log2(count+1)
log_per_sample = np.log2(cd4_subset + 1.0).mean(axis=1).values
r_a2, _ = stats.pearsonr(length, log_per_sample)

# a3) mean of natural-log(count+1)
ln_per_sample = np.log(cd4_subset + 1.0).mean(axis=1).values
r_a3, _ = stats.pearsonr(length, ln_per_sample)

# b) excluding genes with mean expression == 0
keep = mean_val > 0
r_b, _ = stats.pearsonr(length[keep], mean_val[keep])

print(f'(a1) Pearson r(Length, log2(mean+1))              = {r_a1:.6f}')
print(f'(a2) Pearson r(Length, mean of log2(c+1)/sample)  = {r_a2:.6f}')
print(f'(a3) Pearson r(Length, mean of ln(c+1)/sample)    = {r_a3:.6f}')
print(f'(b)  Pearson r(Length, mean raw) excluding mean==0= {r_b:.6f}  (n={int(keep.sum())})')
print(f'     number of genes with mean==0 excluded: {int((~keep).sum())}')

# Spearman as extra reference (rank-based)
r_sp, _ = stats.spearmanr(length, mean_val)
print(f'\n(extra) Spearman rho on main definition = {r_sp:.6f}')

# Save a compact result summary
summary = pd.DataFrame({
    'metric': ['main_r_pearson', 'main_n_genes', 'main_n_samples',
               'sens_log2mean1_r', 'sens_meanlog2_r', 'sens_meanln_r',
               'sens_noZero_r', 'sens_noZero_n', 'spearman_rho'],
    'value': [r_main, n, len(cd4_samples),
              r_a1, r_a2, r_a3, r_b, int(keep.sum()), r_sp],
})
summary.to_csv('analysis/results_summary.csv', index=False)
print('\nSaved analysis/results_summary.csv')
print('DONE')
