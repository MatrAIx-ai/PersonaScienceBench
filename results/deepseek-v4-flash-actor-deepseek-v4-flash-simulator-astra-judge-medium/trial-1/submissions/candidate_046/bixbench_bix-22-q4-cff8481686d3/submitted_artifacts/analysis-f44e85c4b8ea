#!/usr/bin/env python3
"""
BixBench bix-22-q4: Pearson correlation between gene length and mean expression
for protein-coding genes in CD14 immune cells.

Primary: mean expression = arithmetic mean of batch-corrected read counts across
the 132 samples with celltype == 'CD14', correlated with Length (as-is).
Context variant: log2(mean+1).

Approved approach (researcher): keep zero-expression genes; no negative clipping
(verified 0% negatives); exact gene_biotype == 'protein_coding' match.
"""
import numpy as np
import pandas as pd
from scipy.stats import pearsonr

# 1. Load gene metadata
meta = pd.read_csv('data/GeneMetaInfo_Zenodo.csv')
meta = meta[['Geneid', 'Length', 'gene_biotype']].copy()

# 2. Filter protein-coding (exact match)
pc = meta[meta['gene_biotype'] == 'protein_coding'][['Geneid', 'Length']].copy()
print(f"Protein-coding genes (exact biotype match): {len(pc)}")
print(f"  unique Geneid: {pc['Geneid'].nunique()}, Length min/max: {pc['Length'].min()}/{pc['Length'].max()}")

# 3. Load sample annotation -> CD14 sample names
samp = pd.read_csv('data/Sample_annotated_Zenodo.csv')
cd14_samps = samp.loc[samp['celltype'] == 'CD14', 'sample'].tolist()
print(f"CD14 samples (celltype=='CD14'): {len(cd14_samps)}")

# 4. Load count matrix; verify 1:1 Geneid overlap with metadata
counts = pd.read_csv('data/BatchCorrectedReadCounts_Zenodo.csv', index_col=0)
meta_ids = set(meta['Geneid'].astype(str))
count_ids = set(counts.index.astype(str))
print(f"Geneid overlap -> meta-only: {len(meta_ids-count_ids)}, "
      f"counts-only: {len(count_ids-meta_ids)}, common: {len(meta_ids & count_ids)}")
assert counts.index.duplicated().sum() == 0
assert all(c in counts.columns for c in cd14_samps), "Missing CD14 column!"

# 5. Subset counts to CD14 columns and protein-coding genes
sub = counts.loc[pc['Geneid'], cd14_samps]           # rows in PC order
sub = sub.astype(float)
assert (sub.values < 0).sum() == 0, "Negative values found (unexpected)"

# 6. Mean expression per gene across CD14 (arithmetic mean of raw corrected counts)
gene_expr = sub.mean(axis=1).rename('mean_expr_raw')

# 7. Merge with Length
df = pc.set_index('Geneid').join(gene_expr).dropna(subset=['mean_expr_raw'])
print(f"Genes used in correlation: {len(df)}")
print(f"Genes with mean expression == 0 kept: {(df['mean_expr_raw']==0).sum()}")

# 8. Pearson correlation (primary: raw corrected-count mean vs Length)
r_raw, p_raw = pearsonr(df['Length'], df['mean_expr_raw'])

# 9. Context variant: log2(mean+1)
r_log, p_log = pearsonr(df['Length'], np.log2(df['mean_expr_raw'] + 1))

print("\n=== RESULTS ===")
print(f"Pearson r (Length vs raw corrected-count mean): {r_raw:.6f}  (p={p_raw:.3e})")
print(f"Pearson r (Length vs log2(mean+1))             : {r_log:.6f}  (p={p_log:.3e})")
print(f"Pearson r rounded 3-decimals: {r_raw:.3f}")
print(f"Pearson r rounded 4-decimals: {r_raw:.4f}")

# quick context: length/expression summary
print("\nMean expression describe (protein-coding, CD14):")
print(df['mean_expr_raw'].describe().to_string())
