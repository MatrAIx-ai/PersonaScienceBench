#!/usr/bin/env python
"""BixBench bix-22-q6: Pearson correlation between gene length and gene expression
for protein-coding genes (Groningen / Zenodo capsule: GeneMetaInfo + BatchCorrectedReadCounts).

Primary result (approved plan):
  - filter: gene_biotype == 'protein_coding' (exact)         -> 19,942 genes
  - gene expression per gene: arithmetic mean over 723 samples (batch-corrected counts)
  - primary Pearson: log10(mean_expr + 1) vs log10(Length), on N = 19,297
    (excluding 645 genes whose mean expression == 0)
  - report r (4 decimals), p-value and N.

Sensitivities (documented only):
  (a) include the 645 zero-mean genes -> N = 19,942, log10(0+1)=0
  (b) raw (untransformed) mean expression vs raw Length
"""
import pandas as pd
import numpy as np
from scipy import stats

meta = pd.read_csv("data/GeneMetaInfo_Zenodo.csv", index_col=0)
counts = pd.read_csv("data/BatchCorrectedReadCounts_Zenodo.csv", index_col=0)

# --- sanity: identical IDs, same order ---
assert (meta.index == counts.index).all()
assert counts.shape[1] == 723

# --- filter protein_coding (exact) ---
idx_pc = (meta['gene_biotype'] == 'protein_coding')
expr = counts.loc[idx_pc]                       # 19,942 x 723
length = meta.loc[idx_pc, 'Length']
assert expr.shape[0] == 19942

# --- gene expression: mean over 723 samples ---
mean_expr = expr.mean(axis=1)                   # per-gene mean expression

# --- primary subset: exclude genes with mean expression == 0 ---
n_all_zero = int((mean_expr == 0).sum())
mask_nz = (mean_expr > 0)
print(f"protein_coding genes (exact filter): {len(mean_expr)}")
print(f"genes with mean expression == 0 (excluded): {n_all_zero}")
print(f"PRIMARY N = {int(mask_nz.sum())}")

# --- transforms ---
log_expr = np.log10(mean_expr + 1.0)
log_len  = np.log10(length)

# ===== PRIMARY =====
r_primary, p_primary = stats.pearsonr(log_expr[mask_nz], log_len[mask_nz])
print("\n==== PRIMARY RESULT ====")
print(f"log10(mean_expr+1) vs log10(Length), N={int(mask_nz.sum())}:")
print(f"  Pearson r = {r_primary:.4f}")
print(f"  p-value   = {p_primary:.3e}")

# ===== SENSITIVITY (a): include zero-mean genes (log10(0+1)=0), N=19,942 =====
r_all, p_all = stats.pearsonr(log_expr, log_len)
print("\n==== SENSITIVITY (a): all protein_coding incl. zero-mean genes ====")
print(f"log10(mean_expr+1) vs log10(Length), N={len(log_expr)}:")
print(f"  Pearson r = {r_all:.4f}   p = {p_all:.3e}")

# ===== SENSITIVITY (b): untransformed raw vs raw =====
r_raw, p_raw = stats.pearsonr(mean_expr[mask_nz], length[mask_nz])
print("\n==== SENSITIVITY (b): raw mean_expr vs raw Length, N={} ====".format(int(mask_nz.sum())))
print(f"  Pearson r = {r_raw:.4f}   p = {p_raw:.3e}")
# also mixed: log10 expr vs raw length, and raw expr vs log10 length (diagnostic)
r_el, p_el = stats.pearsonr(log_expr[mask_nz], length[mask_nz])
r_le, p_le = stats.pearsonr(mean_expr[mask_nz], log_len[mask_nz])
print(f"  log10expr vs rawLength  r = {r_el:.4f}   p = {p_el:.3e}")
print(f"  rawExpr   vs log10Length r = {r_le:.4f}   p = {p_le:.3e}")

# ---- save a machine-readable summary ----
out = {
    "filter": "gene_biotype == 'protein_coding' (exact)",
    "n_protein_coding": int(len(mean_expr)),
    "expression_def": "arithmetic mean of batch-corrected counts over 723 samples",
    "transform_primary": "log10(mean_expr + 1) vs log10(Length)",
    "excluded_zero_mean_genes": int(n_all_zero),
    "primary_N": int(mask_nz.sum()),
    "primary_r": round(float(r_primary), 4),
    "primary_pvalue": float(p_primary),
    "sens_a_N_incl_zeros": int(len(log_expr)),
    "sens_a_r": round(float(r_all), 4),
    "sens_b_raw_raw_r": round(float(r_raw), 4),
}
with open("bix22q6_result_summary.json", "w") as f:
    json_out = pd.io.json  # placeholder no-op
import json
with open("bix22q6_result_summary.json", "w") as f:
    json.dump(out, f, indent=2)
print("\nSaved bix22q6_result_summary.json")
