"""
BixBench bix-29-q1 — BCG vaccination effect on COVID-19 severity (ordinal regression)
======================================================================================
Question: odds ratio of BCG vaccination on COVID-19 severity controlling for prior
medical history count and patients interaction frequency and interaction between terms,
predicted by an ordinal regression model.

Primary model:  proportional-odds cumulative-logit (polr-equivalent).
    severity(0-4) ~ trt + mh_count + freq + mh_count:freq
    OR(BCG) = exp(beta_trt)

Severity derivation (primary): 0 = no COVID-19 AE; otherwise 1-4 = max AESEV
among COVID-19 AEPT {COVID-19, COVID-19 pneumonia, Asymptomatic COVID-19,
SARS-CoV-2 test positive}; COVID patients lacking AESEV assigned level 1.
Prior medical history count mh_count  = # MHORRES=='2' in MEDICAL HISTORY section.
Interaction frequency freq = patients_seen recoded {'1-50':1,'51-100':2,'>100':3}.

Robustness runs: 4-level AEPT mapping; MHONGO=='Yes' count; expect_interact binary;
with/without covariate interaction.
"""
import numpy as np
import pandas as pd
from scipy import stats
from statsmodels.miscmodels.ordinal_model import OrderedModel

DATA = 'data/'
dm = pd.read_csv(DATA + 'TASK008_BCG-CORONA_DM.csv', dtype=str)
ae = pd.read_csv(DATA + 'TASK008_BCG-CORONA_AE.csv', dtype=str)
mh = pd.read_csv(DATA + 'TASK008_BCG-CORONA_MH.csv', dtype=str)
print(f'dimensions: DM {dm.shape}, AE {ae.shape}, MH {mh.shape}')

# ---------------- build one-row-per-subject analysis frame ----------------
covid_aepts = ['COVID-19', 'COVID-19 pneumonia', 'Asymptomatic COVID-19', 'SARS-CoV-2 test positive']

# drop all-blank filler AE rows
ae = ae[ae['AESTDTC'].notna()].copy()

medhis = mh[mh['MHSCAT'] == 'MEDICAL HISTORY']
mh2_cnt  = medhis.groupby('USUBJID').apply(lambda x: (x['MHORRES'] == '2').sum(), include_groups=False)
mh2_cnt.name = 'mh2'
mhong_cnt = medhis.groupby('USUBJID').apply(lambda x: (x['MHONGO'] == 'Yes').sum(), include_groups=False)
mhong_cnt.name = 'mhongo'

df = dm[['USUBJID', 'TRTGRP', 'patients_seen', 'expect_interact']].copy()
df['trt'] = (df['TRTGRP'] == 'BCG').astype(int)
df['mh_count'] = df['USUBJID'].map(mh2_cnt).fillna(0).astype(int)
df['mhongo_count'] = df['USUBJID'].map(mhong_cnt).fillna(0).astype(int)
df['freq'] = df['patients_seen'].map({'1-50': 1, '51-100': 2, '>100': 3}).astype(float)
df['expect'] = (df['expect_interact'] == 'Yes').astype(int)

# ---- COVID severity per subject ----
c = ae[ae['AEPT'].isin(covid_aepts)].copy()
c['asev'] = pd.to_numeric(c['AESEV'], errors='coerce')
c['pn'] = (c['AEPT'] == 'COVID-19 pneumonia').astype(int)
c['ser'] = (c['AESER'] == 'Yes').astype(int)
c['asym'] = c['AEPT'].isin(['Asymptomatic COVID-19', 'SARS-CoV-2 test positive']).astype(int)
cg = c.groupby('USUBJID').agg(
    max_asev=('asev', 'max'),
    any_covid=('asev', 'size'),      # any COVID AE row
    any_pn=('pn', 'max'),
    any_ser=('ser', 'max'),
    any_asym_only=('asym', 'min'),   # 1 only if ALL covid AEs are asymptomatic/test+
).reset_index()
df = df.merge(cg, on='USUBJID', how='left')
df['any_covid'] = df['any_covid'].fillna(0).astype(int)
df['any_pn'] = df['any_pn'].fillna(0).astype(int)
df['any_ser'] = df['any_ser'].fillna(0).astype(int)
df['any_asym_only'] = df['any_asym_only'].fillna(0).astype(int)
df['has_covid_with_asev'] = df['max_asev'].notna().astype(int)

# PRIMARY severity: 0 none; else max AESEV (covid without AESEV -> level 1)
df['severity'] = df['max_asev'].fillna(1).astype(int)
df.loc[df['any_covid'] == 0, 'severity'] = 0

# ROBUSTNESS severity: 4-level AEPT mapping 0 none / 1 mild(asym/test+) / 2 'COVID-19' / 3 pneumonia|serious
df['severity_a4'] = 0
# build explicitly
df['severity_a4'] = df['any_covid']
df.loc[(df['any_asym_only'] == 1) & (df['any_covid'] == 1), 'severity_a4'] = 1
df.loc[(df['any_asym_only'] == 0) & (df['any_covid'] == 1) & (df['any_pn'] == 0) & (df['any_ser'] == 0), 'severity_a4'] = 2
df.loc[(df['any_pn'] == 1) | (df['any_ser'] == 1), 'severity_a4'] = 3

print('\nSeverity (primary, 0-4) counts:', df['severity'].value_counts().sort_index().to_dict())
print('Severity (4-level AEPT) counts:', df['severity_a4'].value_counts().sort_index().to_dict())
print('mh_count (MHORRES==2) 0-7 counts:', df['mh_count'].value_counts().sort_index().to_dict())
print('mhongo_count counts:', df['mhongo_count'].value_counts().sort_index().to_dict())
print('freq (patients_seen) counts:', df['freq'].value_counts().sort_index().to_dict())
print('expect (expect_interact) counts:', df['expect'].value_counts().sort_index().to_dict())

# ---------------- helpers ----------------
def fit_ordinal(sev_col, df, formula, label):
    d = df.copy()
    d['sev'] = pd.to_numeric(d[sev_col], errors='coerce').astype(int)
    try:
        mod = OrderedModel.from_formula(formula, d, distr='logit')
        res = mod.fit(method='bfgs', disp=False, maxiter=1000)
    except Exception as e:
        print(f'{label:68s} -> FIT ERROR: {str(e)[:120]}')
        return None
    if not res.mle_retvals.get('converged', True):
        print(f'{label:68s} -> WARNING: not converged')
    b = res.params['trt']; se = res.bse['trt']
    if np.isnan(se) or se == 0:
        print(f'{label:68s} -> degenerate (se=NaN); OR unreportable')
        return None
    lo, hi = np.exp(b - 1.96 * se), np.exp(b + 1.96 * se)
    p = 2 * (1 - stats.norm.cdf(abs(b / se)))
    # interaction term estimate (mh_count:freq)
    int_key = [k for k in res.params.index if k.startswith('mh_count:freq') or k.startswith('mhongo_count:freq')]
    int_est = res.params[int_key[0]] if int_key else np.nan
    int_se  = res.bse[int_key[0]] if int_key else np.nan
    n_obs = int(res.nobs)
    print(f'{label:68s} -> OR={np.exp(b):.4f} (95% CI {lo:.4f}-{hi:.4f})  '
          f'b={b:.4f} se={se:.4f} p={p:.4f}  int_est={int_est:.4f} (se {int_se:.4f})  n={n_obs}')
    return {'label': label, 'OR': np.exp(b), 'CI_lo': lo, 'CI_hi': hi, 'b': b,
            'se': se, 'p': p, 'int_est': int_est, 'int_se': int_se, 'n': n_obs}

print('\n================ PRIMARY MODEL ================')
primary = fit_ordinal(
    'severity',
    df,
    'severity ~ trt + mh_count + freq + mh_count:freq',
    'PRIMARY: severity(0-4)~trt+mh+freq+mh:freq')

print('\n================ ROBUSTNESS RUNS ================')
rows = []
rows.append(fit_ordinal('severity',    df, 'severity ~ trt + mh_count + freq',                    'R1: no interaction term'))
rows.append(fit_ordinal('severity_a4', df, 'severity_a4 ~ trt + mh_count + freq + mh_count:freq', 'R2: 4-level AEPT severity'))
rows.append(fit_ordinal('severity',    df, 'severity ~ trt + mhongo_count + freq + mhongo_count:freq', 'R3: mhongo(Yes) count'))
rows.append(fit_ordinal('severity',    df, 'severity ~ trt + mh_count + expect + mh_count:expect', 'R4: expect_interact binary freq'))
# BCG x covariate interactions (anticipated degenerate)
rows.append(fit_ordinal('severity',    df, 'severity ~ trt + mh_count + freq + trt:mh_count + trt:freq', 'R5: BCG x covariate interactions'))

print('\n================ HEADLINE ANSWER ================')
if primary:
    b, se = primary['b'], primary['se']
    print(f"BCG odds ratio (exp of BCG coefficient) = {primary['OR']:.4f}  "
          f"(95% CI {primary['CI_lo']:.4f}-{primary['CI_hi']:.4f}), p = {primary['p']:.4f}")
    print(f"BCG beta = {b:.4f} (se {se:.4f}); interaction mh_count:freq = {primary['int_est']:.4f} "
          f"(se {primary['int_se']:.4f})")
    print('Interpretation: an OR > 1 means BCG vaccination is associated with higher'
          ' odds of being in a more severe COVID-19 category.')
