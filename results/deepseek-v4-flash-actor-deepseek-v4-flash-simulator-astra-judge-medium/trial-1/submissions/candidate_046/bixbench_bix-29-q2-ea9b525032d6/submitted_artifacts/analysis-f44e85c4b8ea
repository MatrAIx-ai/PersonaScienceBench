"""
BixBench bix-29-q2 - BCG-CORONA
Ordinal regression: effect of each ADDITIONAL ONGOING medical condition
(MHONGO) on odds of HIGHER COVID-19 severity, controlling for BCG vaccination
status and patient-interaction variables. Answer = 100*(exp(b_n_ongoing)-1).

Coding decisions (documented):
  * Exposure: count (per subject) of MEDICAL HISTORY conditions with
    MHONGO=='Yes' (present AND ongoing). MHORRES==2.0 => condition PRESENT
    (validated via plausible prevalence: Hypertension 174, Asthma 68,
    Diabetes 63, Cancer 7); MHORRES in {1.0, NaN} => absent (not counted);
    MHONGO=='No' => present but not ongoing (not counted). MHORRES==NaN rows
    (80 'Current respiratory tract infection', 81 'Hay fever') treated absent.
  * Outcome (primary): per-subject ordinal COVID-19 severity 0-7 = max AEHS
    across the subject's COVID-19 AEs (AEHLT=='Coronavirus infections');
    0 if no COVID-19 event. AEHS is complete for all 218 COVID rows (AESEV is
    missing for 42/191 infected subjects). Sensitivity uses max AESEV (1-4)
    with missing values DROPPED or SET TO 0.
  * Covariates (primary, exactly those named in the question):
    BCG vaccination (TRTGRP=='BCG'), expect_interact (Yes), patients_seen
    (ordinal 1-3), work_hours (ordinal 1-3). Sensitivity adds Age + SEX.
  * Model: cumulative proportional-odds logistic regression
    (statsmodels OrderedModel, logit). Diagnostics: Brant-style test.
"""
import numpy as np
import pandas as pd
import statsmodels.api as sm
from statsmodels.miscmodels.ordinal_model import OrderedModel
import warnings
warnings.filterwarnings('ignore')

DM_F, AE_F, MH_F = ('data/TASK008_BCG-CORONA_DM.csv',
                    'data/TASK008_BCG-CORONA_AE.csv',
                    'data/TASK008_BCG-CORONA_MH.csv')
OUT_CSV = 'analysis/sensitivity_table.csv'
OUT_TXT = 'analysis/results_summary.txt'

dm = pd.read_csv(DM_F); ae = pd.read_csv(AE_F); mh = pd.read_csv(MH_F)
print('DM:', dm.shape, '| AE:', ae.shape, '| MH:', mh.shape)
print('Subjects:', dm.USUBJID.nunique(),
      '| BCG:', (dm.TRTGRP=='BCG').sum(), 'Placebo:', (dm.TRTGRP=='Placebo').sum())

# --- exposure ---------------------------------------------------------------
med = mh[mh.MHSCAT=='MEDICAL HISTORY'].copy()
n_present = med[med.MHORRES==2.0].groupby('USUBJID').size().rename('n_present')
n_ongoing = med[med.MHONGO=='Yes'].groupby('USUBJID').size().rename('n_ongoing')

# --- outcome ----------------------------------------------------------------
covid = ae[ae.AEHLT=='Coronavirus infections'].copy()
print('COVID-19 AE rows:', len(covid), '| subjects:', covid.USUBJID.nunique(),
      '| AEPT:', covid.AEPT.value_counts().to_dict())
sev = covid.groupby('USUBJID').agg(max_aehs=('AEHS','max'),
                                   max_aesev=('AESEV','max'))

df = dm.copy()
df = df.merge(n_ongoing, on='USUBJID', how='left')
df = df.merge(n_present, on='USUBJID', how='left')
df = df.merge(sev, on='USUBJID', how='left')
df['n_ongoing'] = df['n_ongoing'].fillna(0).astype(int)
df['n_present'] = df['n_present'].fillna(0).astype(int)
df['max_aehs']  = df['max_aehs'].fillna(0.0)
df['hs_all']    = df['max_aehs'].astype(int)
df['sev_drop']  = np.where(df['max_aesev'].isna() & (df['max_aehs']>0), np.nan,
                          df['max_aesev'].fillna(0.0))
df['sev_fill0'] = df['max_aesev'].fillna(0.0)
df['hs_coll']   = df['max_aehs'].map(lambda x: 0 if x==0 else (1 if x<=1 else (2 if x==2 else 3))).astype(int)

df['bcg'] = (df.TRTGRP=='BCG').astype(int)
df['ei']  = (df.expect_interact=='Yes').astype(int)
df['ps']  = df.patients_seen.map({'1-50':1,'51-100':2,'>100':3}).astype(float)
df['wh']  = df.work_hours.map({'1-40':1,'41-80':2,'>80':3}).astype(float)
age_map   = {a:i for i,a in enumerate(['10-19','20-29','30-39','40-49','50-59','60-69','70-79'])}
df['age_o'] = df.Age.map(age_map).astype(float)
df['sex_male'] = (df.SEX==1).astype(int)

F_SHORT = ['n_ongoing','bcg','ei','ps','wh']
F_FULL  = F_SHORT + ['age_o','sex_male']

print('Exposure n_ongoing dist:', df['n_ongoing'].value_counts().sort_index().to_dict())
print('Severity hs_all dist:', df['hs_all'].value_counts().sort_index().to_dict())
print('AESEV drop dist:', df['sev_drop'].value_counts(dropna=False).sort_index().to_dict())

def fit_ordinal(y, X):
    d = y.to_frame('y').join(X).dropna()
    yv = d['y'].astype(int); Xv = d[X.columns].astype(float)
    return OrderedModel(yv, Xv, distr='logit').fit(method='bfgs',
                        disp=False, maxiter=1000), yv, Xv

def summarize(res, label):
    b = res.params['n_ongoing']; ci = res.conf_int().loc['n_ongoing']
    p = res.pvalues['n_ongoing']; orr = np.exp(b)
    return dict(model=label, n=int(res.nobs), llf=res.llf, b=b,
                se=res.bse['n_ongoing'], OR=orr, pct=100*(orr-1),
                pct_lo=100*(np.exp(ci[0])-1), pct_hi=100*(np.exp(ci[1])-1), p=p)

rows = []
res_prim, y_prim, X_prim = fit_ordinal(df['hs_all'], df[F_SHORT])
rows.append(summarize(res_prim, 'PRIMARY: AEHS 0-7 short (BCG+expect_interact+patients_seen+work_hours)'))

# --- sensitivity table ------------------------------------------------------
specs = [
    ('AEHS 0-7, short',                    df['hs_all'],    F_SHORT),
    ('AEHS 0-7, full (+age+sex)',          df['hs_all'],    F_FULL),
    ('AEHS collapsed 0-3, short',          df['hs_coll'],   F_SHORT),
    ('AEHS collapsed 0-3, full (+age+sex)',df['hs_coll'],   F_FULL),
    ('AESEV 1-4 (missing DROPPED), short', df['sev_drop'],  F_SHORT),
    ('AESEV 1-4 (missing DROPPED), full (+age+sex)', df['sev_drop'], F_FULL),
    ('AESEV 1-4 (missing->0), short',      df['sev_fill0'], F_SHORT),
    ('AESEV 1-4 (missing->0), full (+age+sex)', df['sev_fill0'], F_FULL),
]
for lab, y, X in specs:
    try:
        r, _, _ = fit_ordinal(y, df[X])
        rows.append(summarize(r, lab))
    except Exception as e:
        rows.append(dict(model=lab, error=str(e)[:80]))

sens = pd.DataFrame(rows)
sens.to_csv(OUT_CSV, index=False)
print('\n=== SENSITIVITY TABLE (% increase in odds per additional ongoing condition) ===')
print(sens[['model','n','b','se','OR','pct','pct_lo','pct_hi','p']].to_string(index=False))

print('\n=== PRIMARY MODEL (AEHS 0-7; controls BCG+expect_interact+patients_seen+work_hours) ===')
print(res_prim.summary())
b = res_prim.params['n_ongoing']; ci = res_prim.conf_int().loc['n_ongoing']
p_prim = res_prim.pvalues['n_ongoing']
print('\nPRIMARY ANSWER: OR = %.4f | %% increase in odds = %.2f%% | 95%% CI (%.2f%%, %.2f%%) | p=%.4f'
      % (np.exp(b), 100*(np.exp(b)-1), 100*(np.exp(ci[0])-1), 100*(np.exp(ci[1])-1), p_prim))

# --- proportional-odds: Brant-style Wald test --------------------------------
def brant_test(y, X):
    from scipy import stats as st
    y = y.astype(int); K = int(y.max()-y.min()+1)
    p = X.shape[1]
    Xc = sm.add_constant(X.astype(float))
    coefs, ses = [], []
    for k in range(int(y.min()), int(y.max())):
        yb = (y > k).astype(int)
        r = sm.Logit(yb, Xc).fit(disp=False)
        coefs.append(r.params.iloc[1:].values)
        ses.append(r.bse.iloc[1:].values)
    coefs = np.array(coefs); ses = np.array(ses)      # (K-1) x p
    w = 1.0/(ses**2)
    bbar = np.average(coefs, axis=0, weights=w)
    chi2_var = ((coefs-bbar)**2 * w).sum(axis=0)
    df_var = K-2
    ov = chi2_var.sum(); df_ov = df_var*p
    out = pd.DataFrame({'variable': X.columns, 'chi2': chi2_var,
                        'df': df_var, 'p': 1-st.chi2.cdf(chi2_var, df_var)})
    return out, ov, df_ov, 1-st.chi2.cdf(ov, df_ov)

bt, chi_ov, df_ov, p_ov = brant_test(y_prim, X_prim)
print('\n=== BRANT-STYLE TEST (proportional odds), primary model ===')
print(bt.to_string(index=False))
print('Overall chi2=%.2f df=%d p=%.4f  (p>0.05 -> no strong evidence against proportional odds)'
      % (chi_ov, df_ov, p_ov))

# --- category stability ------------------------------------------------------
print('\nCATEGORY STABILITY: n(cat6)=%d, n(cat7)=%d (single subjects).' %
      ((df['hs_all']==6).sum(), (df['hs_all']==7).sum()))
print('Collapsed 0-3 short pct = %.2f%% vs primary 0-7 = %.2f%%.' %
      (sens.loc[sens.model.str.startswith('AEHS collapsed 0-3, short'),'pct'].iloc[0],
       100*(np.exp(b)-1)))
r_coll, _, _ = fit_ordinal(df['hs_coll'], df[F_SHORT])
print('Also without the 2 single-subject extreme cases (drop cat 6,7):')
drop67 = df[~df['hs_all'].isin([6,7])]
r_d67, _, _ = fit_ordinal(drop67['hs_all'], drop67[F_SHORT])
print('  n=%d pct=%.2f%%' % (r_d67.nobs, 100*(np.exp(r_d67.params['n_ongoing'])-1)))

# --- ordinal vs nominal parsimony check --------------------------------------
d = y_prim.to_frame('y').join(X_prim).dropna()
Xc = sm.add_constant(d[X_prim.columns])
mnom = sm.MNLogit(d['y'].astype(int), Xc).fit(method='bfgs', disp=False, maxiter=1000)
print('\nORDINAL vs NOMINAL: OrderedModel BIC=%.2f | MNLogit BIC=%.2f (lower=better)'
      % (res_prim.bic, mnom.bic))

# --- write summary -----------------------------------------------------------
with open(OUT_TXT, 'w') as f:
    f.write('PRIMARY ANSWER\n')
    f.write('Per additional ongoing medical condition (MHONGO):\n')
    f.write('  OR = %.4f\n' % np.exp(b))
    f.write('  %% increase in odds of higher COVID-19 severity = %.2f%%\n' % (100*(np.exp(b)-1)))
    f.write('  95%% CI = (%.2f%%, %.2f%%); p = %.4f\n\n' %
            (100*(np.exp(ci[0])-1), 100*(np.exp(ci[1])-1), p_prim))
    f.write(sens[['model','n','OR','pct','pct_lo','pct_hi','p']].to_string(index=False))
    f.write('\n\nBrant overall chi2=%.2f df=%d p=%.4f\n' % (chi_ov, df_ov, p_ov))
    f.write(bt.to_string(index=False))
print('\nSaved:', OUT_CSV, '|', OUT_TXT)

# --- cutpoint-level diagnostics for n_ongoing (non-proportionality) ---------
print('\n=== CUTPOINT-LEVEL n_ongoing COEFFICIENTS (binary logits P(sev>k|X)) ===')
print('POLR (proportional odds) n_ongoing coef = %.3f (OR %.2f)' %
      (b, np.exp(b)))
Xc = sm.add_constant(X_prim.astype(float))
for k in range(int(y_prim.min()), int(y_prim.max())):
    yb = (y_prim > k).astype(int)
    rk = sm.Logit(yb, Xc).fit(disp=False)
    bk = rk.params['n_ongoing']
    print('  cutpoint k=%d: n_ongoing coef=%.3f (se=%.3f)  OR=%.2f  p=%.3f   [P(sev>%d)]'
          % (k, bk, rk.bse['n_ongoing'], np.exp(bk), rk.pvalues['n_ongoing'], k))

# --- generalized ordered logit (n_ongoing free per cutpoint), avg OR ---------
import scipy.stats as st_chi
coefs_non, se_non = [], []
for k in range(int(y_prim.min()), int(y_prim.max())):
    yb = (y_prim > k).astype(int)
    rk = sm.Logit(yb, Xc).fit(disp=False)
    coefs_non.append(rk.params['n_ongoing']); se_non.append(rk.bse['n_ongoing'])
coefs_non = np.array(coefs_non); se_non = np.array(se_non)
w = 1.0/se_non**2
avg_eff = np.average(coefs_non, weights=w)
lo = avg_eff - 1.96*np.sqrt(1.0/w.sum()); hi = avg_eff + 1.96*np.sqrt(1.0/w.sum())
print('\nGeneralized ordered logit: average (inverse-variance) n_ongoing coef = %.3f,' 
      % avg_eff)
print('  OR = %.2f -> %% increase = %.1f%% (approx 95%% CI %.1f%% .. %.1f%%)' %
      (np.exp(avg_eff), 100*(np.exp(avg_eff)-1),
       100*(np.exp(lo)-1), 100*(np.exp(hi)-1)))
print('  (The POLR point estimate %.1f%% lies within the non-parallel range.)' %
      (100*(np.exp(b)-1)))

# append diagnostics to saved summary
with open(OUT_TXT, 'a') as f:
    f.write('\n\n=== CUTPOINT-LEVEL n_ongoing (binary logits) ===\n')
    for k in range(int(y_prim.min()), int(y_prim.max())):
        yb = (y_prim > k).astype(int)
        rk = sm.Logit(yb, Xc).fit(disp=False)
        f.write('  k=%d: coef=%.3f OR=%.2f p=%.3f\n' %
                (k, rk.params['n_ongoing'], np.exp(rk.params['n_ongoing']),
                 rk.pvalues['n_ongoing']))
    f.write('Generalized-OL average OR=%.2f -> %%increase=%.1f%%\n'
            % (np.exp(avg_eff), 100*(np.exp(avg_eff)-1)))
print('summary updated')
