"""
Task 008 BCG-CORONA - Question 3
Ordinal (cumulative-logit / proportional-odds) regression of COVID-19 severity
on BCG vaccination status, prior medical history, their interaction, controlling
for patient interaction frequency (patients_seen, work_hours, expect_interact).

PRIMARY DEFINITIONS (as approved):
  * Outcome severity (0-4): 0 = no COVID-19 AE in the AE table;
    1-4 = worst AESEV (1=mild .. 4=severe) among the subject's COVID-19 AEs
    (AEPT containing 'COVID-19'). COVID-19 AE present but ungraded AESEV =>
    assigned severity 1 (mild) in the primary analysis (sensitivity: drop them).
  * Prior medical history (medhx): any of the 18 standard MH screening
    conditions = Yes (MHORRES==2.0) else No (MHORRES==1.0 or missing => absent).
  * References: Placebo; no prior medical history; patients_seen '1-50';
    work_hours '1-40'; expect_interact 'No'.
  * Controls: patients_seen, work_hours, expect_interact.
"""
import numpy as np
import pandas as pd
import statsmodels.api as sm
from statsmodels.miscmodels.ordinal_model import OrderedModel
from scipy import stats

DATA = "data"
SEV_UNGRADED_AS_MILD = True   # primary: ungraded COVID AE -> severity 1; False = drop

dm = pd.read_csv(f"{DATA}/TASK008_BCG-CORONA_DM.csv")
ae = pd.read_csv(f"{DATA}/TASK008_BCG-CORONA_AE.csv")
mh = pd.read_csv(f"{DATA}/TASK008_BCG-CORONA_MH.csv")

# ---- 1. Medical-history features per subject ----
mhx = mh[mh.MHSCAT == "MEDICAL HISTORY"].copy()
med = mhx.pivot_table(index="USUBJID", columns="MHTERM", values="MHORRES")
std_cond = [c for c in med.columns if not c.startswith("Other:")]
other_cond = [c for c in med.columns if c.startswith("Other:")]

mh_df = pd.DataFrame(index=dm.USUBJID)
mh_df["medhx"]  = (med[std_cond] == 2).any(axis=1).astype(int)
mh_df["n_cond"] = (med[std_cond] == 2).sum(axis=1).astype(int)
mh_df["medhx_other"] = (((med[std_cond] == 2).any(axis=1)) |
                        med[other_cond].notna().any(axis=1)).astype(int)
core_risk = ["Hypertension", "Diabetes Mellitus", "Cardiovascular disease",
             "Chronic Obstructive Pulmonary Disease", "Other lung disease",
             "Asthma", "Cancer"]
mh_df["medhx_core"] = (med[core_risk] == 2).any(axis=1).astype(int)

# ---- 2. COVID-19 severity outcome per subject ----
covid = ae[ae.AEPT.str.contains("COVID", case=False, na=False)].copy()
covid["sev"] = covid["AESEV"]
covid.loc[covid.AEPT.str.contains("Asymptomatic", case=False, na=False), "sev"] = 0.0
worst = covid.groupby("USUBJID")["sev"].max()

sev_out = pd.Series(0, index=dm.USUBJID, dtype=float)
ungraded = []
for u, v in worst.items():
    if isinstance(v, float) and np.isnan(v):
        ungraded.append(u)
        if SEV_UNGRADED_AS_MILD:
            sev_out[u] = 1.0
    else:
        sev_out[u] = float(v)

sev_df = pd.DataFrame({"severity": sev_out, "has_covid": sev_out.index.isin(worst.index)})

# ---- 3. Analytic frame ----
frame = dm[["USUBJID", "TRTGRP", "patients_seen", "work_hours", "expect_interact"]].copy()
frame = frame.merge(mh_df, left_on="USUBJID", right_index=True, how="left")
frame = frame.merge(sev_df, left_on="USUBJID", right_index=True, how="left")
frame["bcg"] = (frame.TRTGRP == "BCG").astype(int)
frame["severity"] = frame["severity"].astype(int)

if not SEV_UNGRADED_AS_MILD:
    frame = frame[~frame["USUBJID"].isin(ungraded)].copy()

frame["patients_seen"]  = pd.Categorical(frame.patients_seen,  categories=["1-50", "51-100", ">100"], ordered=True)
frame["work_hours"]     = pd.Categorical(frame.work_hours,     categories=["1-40", "41-80", ">80"],   ordered=True)
frame["expect_interact"]= pd.Categorical(frame.expect_interact, categories=["No", "Yes"], ordered=True)

n = len(frame)
print(f"[frame] n = {n} (ungraded kept as mild: {SEV_UNGRADED_AS_MILD})")
print("severity counts:", frame.severity.value_counts().reindex(range(5)).to_dict())

# ---- 4. Model helpers ----
def fit_ordinal(data, formula, label):
    model = OrderedModel.from_formula(formula, data, distr="logit")
    res = model.fit(method="bfgs", maxiter=2000, disp=False)
    print("\n" + "=" * 88)
    print("MODEL:", label)
    print("formula:", formula)
    print("n =", int(res.nobs), "| Log-Lik =", round(res.llf, 3), "| Pseudo-R2(CS) =", round(res.prsquared, 4))
    print(res.summary())
    return model, res

def report_interaction(model, res, label=""):
    params = res.params; bnames = list(params.index)
    b = lambda name: params.get(name, np.nan)
    cb = [x for x in bnames if x.startswith("bcg") and ":" not in x][0]
    ci = [x for x in bnames if ("bcg:" in x or "bcg_medhx" in x)][0]
    cm = [x for x in bnames if x.startswith("medhx") and ":" not in x and x != "medhx_core"][0]
    xb, xi, xm = b(cb), b(ci), b(cm)
    V = res.cov_params()
    se_i = np.sqrt(V.loc[ci, ci]); z_i = xi / se_i
    p_i  = 2 * (1 - stats.norm.cdf(abs(z_i)))
    lo_i, hi_i = xi - 1.96 * se_i, xi + 1.96 * se_i
    se_b = np.sqrt(V.loc[cb, cb]); z_b = xb / se_b; p_b = 2 * (1 - stats.norm.cdf(abs(z_b)))
    lo_b, hi_b = xb - 1.96 * se_b, xb + 1.96 * se_b
    sumbci = xb + xi
    se_s = np.sqrt(V.loc[cb, cb] + V.loc[ci, ci] + 2 * V.loc[cb, ci]); z_s = sumbci / se_s
    p_s  = 2 * (1 - stats.norm.cdf(abs(z_s)))
    lo_s, hi_s = sumbci - 1.96 * se_s, sumbci + 1.96 * se_s
    print("-" * 88)
    print(f"[{label}] INTERACTION OR (BCG x medhx) = exp({xi:.4f}) = {np.exp(xi):.4f}  (95% CI {np.exp(lo_i):.4f} - {np.exp(hi_i):.4f}; p = {p_i:.4g})")
    print(f"[{label}] BCG OR within medhx=0 (no prior history) = exp({xb:.4f}) = {np.exp(xb):.4f}  (95% CI {np.exp(lo_b):.4f} - {np.exp(hi_b):.4f}; p = {p_b:.4g})")
    print(f"[{label}] BCG OR within medhx=1 (prior history)    = exp({xb+xi:.4f}) = {np.exp(sumbci):.4f}  (95% CI {np.exp(lo_s):.4f} - {np.exp(hi_s):.4f}; p = {p_s:.4g})")
    print(f"[{label}] medhx main-effect OR = {np.exp(xm):.4f} (beta {xm:.4f})")
    thr = [x for x in bnames if "/" in x]
    print(f"[{label}] thresholds: " + "; ".join(f"{t}: {b(t):.4f}" for t in thr))
    return {"label": label, "inter_OR": float(np.exp(xi)), "inter_CI": (float(np.exp(lo_i)), float(np.exp(hi_i))),
            "inter_p": float(p_i), "bcg_or_medhx0": float(np.exp(xb)), "bcg_ci_medhx0": (float(np.exp(lo_b)), float(np.exp(hi_b))),
            "bcg_or_medhx1": float(np.exp(sumbci)), "bcg_ci_medhx1": (float(np.exp(lo_s)), float(np.exp(hi_s))),
            "medhx_or": float(np.exp(xm))}

def brant_test(data, formula):
    y = data["severity"].values
    X = pd.get_dummies(pd.DataFrame({
        "bcg": data["bcg"], "medhx": data["medhx"],
        "pat2": (data["patients_seen"] == "51-100").astype(int),
        "pat3": (data["patients_seen"] == ">100").astype(int),
        "wh2":  (data["work_hours"] == "41-80").astype(int),
        "wh3":  (data["work_hours"] == ">80").astype(int),
        "exp":  (data["expect_interact"] == "Yes").astype(int),
        "bcg_medhx": data["bcg"] * data["medhx"],
    }), dtype=float)
    Xc = sm.add_constant(X, has_constant="add")
    k = Xc.shape[1]
    m = OrderedModel.from_formula(formula, data, distr="logit")
    r = m.fit(method="bfgs", maxiter=2000, disp=False)
    slopes_names = [c for c in r.params.index if "/" not in c]
    name_map = {"bcg": "bcg", "medhx": "medhx",
                "C(patients_seen)[T.51-100]": "pat2", "C(patients_seen)[T.>100]": "pat3",
                "C(work_hours)[T.41-80]": "wh2", "C(work_hours)[T.>80]": "wh3",
                "C(expect_interact)[T.Yes]": "exp"}
    po_vec = np.zeros(k)
    for sn in slopes_names:
        dst = name_map.get(sn)
        if sn == "bcg:medhx":
            dst = "bcg_medhx"
        if dst is not None and dst in Xc.columns:
            po_vec[Xc.columns.get_loc(dst)] = r.params[sn]
    j_levels = np.sort(np.unique(y))
    chi_global = 0.0; chi_var = {dst: 0.0 for dst in Xc.columns}
    used = 0
    for j in j_levels[:-1]:
        yb = (y >= j).astype(int)
        try:
            mlogit = sm.Logit(yb, Xc).fit(disp=False)
            if not mlogit.mle_retvals["converged"]:
                continue
            bj  = mlogit.params.iloc[1:].values
            Vj  = mlogit.cov_params().iloc[1:, 1:].values
            diff = bj - po_vec[1:]
            chi_j = float(diff @ np.linalg.inv(Vj) @ diff)
            if np.isfinite(chi_j):
                chi_global += chi_j; used += 1
                for i, dst in enumerate(Xc.columns[1:]):
                    if Vj[i, i] > 0:
                        chi_var[dst] += diff[i] ** 2 / Vj[i, i]
        except Exception as exc:
            print(f"   [brant] cutpoint >= {j} skipped ({type(exc).__name__})")
    dfv = len(j_levels) - 1
    p_global = stats.chi2.sf(chi_global, dfv * (k - 1)) if used else np.nan
    print("-" * 88)
    print(f"[Brant] global chi2 = {chi_global:.3f}, df = {dfv * (k - 1)}, p = {p_global:.4g} (cutpoints used: {used}) "
          f"({'proportional odds OK (p>=0.05)' if (p_global >= 0.05) else 'PROPORTIONAL ODDS VIOLATED (p<0.05)'})")
    for dst in Xc.columns[1:]:
        if used:
            pv = stats.chi2.sf(chi_var[dst], dfv)
            print(f"   per-variable {dst:10s}: chi2 = {chi_var[dst]:7.3f}, df = {dfv}, p = {pv:.4g}")

    # --- aggregated 3-level proportional-odds check (more stable on sparse top categories) ---
    data3 = data.copy()
    data3["y3"] = data3["severity"].map({0: 0, 1: 1, 2: 1, 3: 2, 4: 2})
    m3 = OrderedModel.from_formula(formula.replace("severity", "y3"), data3, distr="logit")
    r3 = m3.fit(method="bfgs", maxiter=2000, disp=False)
    sl3 = [c for c in r3.params.index if "/" not in c]
    po3 = np.zeros(k)
    for sn in sl3:
        dst = name_map.get(sn)
        if sn == "bcg:medhx":
            dst = "bcg_medhx"
        if dst is not None and dst in Xc.columns:
            po3[Xc.columns.get_loc(dst)] = r3.params[sn]
    chi3 = 0.0; used3 = 0
    for j in [1, 2]:
        yb = (data3["y3"] >= j).astype(int)
        try:
            ml = sm.Logit(yb, Xc).fit(disp=False)
            if not ml.mle_retvals["converged"]:
                continue
            bj = ml.params.iloc[1:].values; Vj = ml.cov_params().iloc[1:, 1:].values
            d = bj - po3[1:]
            c3 = float(d @ np.linalg.inv(Vj) @ d)
            if np.isfinite(c3):
                chi3 += c3; used3 += 1
        except Exception as exc:
            print(f"   [brant3] cutpoint {j} skipped ({type(exc).__name__})")
    if used3:
        p3 = stats.chi2.sf(chi3, 1 * (k - 1))
        print(f"[Brant/3-level (0 |1-2| 3-4)] chi2 = {chi3:.3f}, df = {k - 1}, p = {p3:.4g} "
              f"({'OK (p>=0.05)' if p3 >= 0.05 else 'VIOLATED (p<0.05)'})")
    return p_global

# ---- 5. PRIMARY MODEL ----
PRIMARY_FORMULA = ("severity ~ bcg + medhx + bcg:medhx "
                   "+ C(patients_seen) + C(work_hours) + expect_interact")
model, res = fit_ordinal(frame, PRIMARY_FORMULA, "PRIMARY (n=%d, bcg*medhx, controls: patients_seen+work_hours+expect_interact)" % len(frame))
pri = report_interaction(model, res, "PRIMARY")
brant_test(frame, PRIMARY_FORMULA)

# ---- 6. SENSITIVITY ANALYSES ----
sens = {}

# (a) medhx incl. Other: free-text conditions
f_a = frame.copy(); f_a["medhx"] = f_a["medhx_other"]
mA, rA = fit_ordinal(f_a, PRIMARY_FORMULA, "SENS a: medhx incl 'Other:' free-text")
sens["a"] = report_interaction(mA, rA, "SENS a")

# (b) medhx as count of conditions
mB = OrderedModel.from_formula("severity ~ bcg + n_cond + bcg:n_cond + C(patients_seen) + C(work_hours) + expect_interact",
                               frame, distr="logit")
rB = mB.fit(method="bfgs", maxiter=2000, disp=False)
print("\n" + "=" * 88)
print("MODEL: SENS b: medhx = count n_cond | n =", int(rB.nobs), "| LL =", round(rB.llf, 3))
print(rB.summary())
s = rB.params
nb = [x for x in s.index if x.startswith("bcg") and ":" not in x][0]
ni = [x for x in s.index if "bcg" in x and "n_cond" in x and ":" in x][0]
V = rB.cov_params()
se = np.sqrt(V.loc[ni, ni]); zz = s[ni] / se; pp = 2 * (1 - stats.norm.cdf(abs(zz)))
print(f"[SENS b] INTERACTION OR (BCG x n_cond, per extra condition) = exp({s[ni]:.4f}) = {np.exp(s[ni]):.4f} "
      f"(95% CI {np.exp(s[ni]-1.96*se):.4f}-{np.exp(s[ni]+1.96*se):.4f}; p = {pp:.4g})")
sens["b"] = {"inter_OR": float(np.exp(s[ni]))}

# (c) specific core risk cluster
f_c = frame.copy(); f_c["medhx"] = f_c["medhx_core"]
mC, rC = fit_ordinal(f_c, PRIMARY_FORMULA, "SENS c: medhx = core risk cluster (HTN/DM/CVD/Lung/Cancer)")
sens["c"] = report_interaction(mC, rC, "SENS c")

# (d) control = patients_seen only
mD, rD = fit_ordinal(frame, "severity ~ bcg + medhx + bcg:medhx + C(patients_seen)", "SENS d: control = patients_seen only")
sens["d"] = report_interaction(mD, rD, "SENS d")

# (e) drop ungraded-severity subjects
f_e = frame[~frame.USUBJID.isin(ungraded)].copy()
mE, rE = fit_ordinal(f_e, PRIMARY_FORMULA, "SENS e: drop ungraded severity (n=%d)" % len(f_e))
sens["e"] = report_interaction(mE, rE, "SENS e")

print("\n" + "=" * 88)
print("SUMMARY  --  INTERACTION OR (BCG x prior medical history) on COVID-19 severity")
print("severity: 0 = no COVID-19 AE; 1-4 = worst AESEV among COVID-19 AEs (ungraded -> mild)")
print("medhx (primary): any of 18 standard MH conditions present; controls: patients_seen, work_hours, expect_interact")
print("-" * 88)
for key, v in pri.items():
    print(f"PRIMARY {key}: {v}")
print("-" * 88)
for key, v in sens.items():
    if isinstance(v, dict) and "inter_OR" in v:
        print(f"SENS {key} interaction OR: {v['inter_OR']:.4f}")

frame.to_csv(f"{DATA}/analysis_frame_ordinal.csv", index=False)
print("\n[saved] analytic frame -> data/analysis_frame_ordinal.csv")
