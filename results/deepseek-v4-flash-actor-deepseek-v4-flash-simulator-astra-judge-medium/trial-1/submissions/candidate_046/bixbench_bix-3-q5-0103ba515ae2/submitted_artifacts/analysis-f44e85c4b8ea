#!/usr/bin/env python3
"""
Consolidated analysis: paired exact binomial (sign) differential expression test
on the three tissue comparisons of Data_deposition_RNAseq_Paroxetine_2017.xlsx.

Contrasts (response groups pooled, n=30 per tissue; pairwise by animal):
  1) Final blood  vs Baseline blood
  2) Dentate gyrus vs Baseline blood
  3) Dentate gyrus vs Final blood

Method per gene: two-sided exact binomial test (scipy.stats.binomtest) on the
number k of paired animals (out of n_eff non-tied pairs) with higher normalized
count (+0.5 pseudo-count) in condition A vs B, under H0: p=0.5.
Both raw p<0.05 and BH-FDR<0.05 counts are reported; FDR<0.05 is the primary
significance criterion. 'Negligible effects' is evaluated via #DEGs per contrast.
"""
import pandas as pd
import numpy as np
from scipy.stats import binomtest
from statsmodels.stats.multitest import multipletests

XLSX = 'data/Data_deposition_RNAseq_Paroxetine_2017.xlsx'
PSEUDO = 0.5

# ---------- 1. Sample map (Mapping_statistics) ----------
ms = pd.read_excel(XLSX, sheet_name='Mapping_statistics', header=0)
ms['animal'] = ms['Sample ID'].apply(lambda s: str(s).split('_')[5])
ms['col'] = np.arange(2, 92)                     # NormCount columns 2..91 = Code order (verified 90/90)
mp = {(a, t): c for a, t, c in zip(ms['animal'], ms['Tissue'], ms['col'])}
animals = sorted(ms['animal'].unique())
n_animals = len(animals)
print(f"1) DESIGN: {len(ms)} samples; {n_animals} animals each with the 3 tissues "
      f"({ms['Tissue'].value_counts().to_dict()}); "
      f"per group: {dict(ms.groupby(['Tissue','Response']).size())}")

# ---------- 2. Normalized counts ----------
raw = pd.read_excel(XLSX, sheet_name='NormCount', header=None)
genes = raw.iloc[4:, 1].astype(str).values
counts = raw.iloc[4:, 2:92].astype(float).values
print(f"2) COUNTS: {len(genes)} genes x {counts.shape[1]} samples; NaN={int(np.isnan(counts).sum())}; "
      f"all-zero genes={int((counts.sum(1)==0).sum())}; >=50pct-zero genes={int(((counts==0).mean(1)>=0.5).sum())}")

tc = {t: [mp[(a, t)] - 2 for a in animals] for t in ['baseline_blood', 'dentate_gyrus', 'final_blood']}

def sign_test(Ac, Bc):
    A = Ac + PSEUDO; B = Bc + PSEUDO
    up = (A > B).astype(int); dn = (B > A).astype(int)
    k = up.sum(1); ne = up.sum(1) + dn.sum(1)
    p = np.array([binomtest(k[i], ne[i], 0.5).pvalue if ne[i] > 0 else 1.0 for i in range(len(k))])
    return p, k, ne

def log2fc(Ac, Bc):
    return np.log2((Ac.mean(1) + PSEUDO) / (Bc.mean(1) + PSEUDO))

contrasts = [('Final blood vs Baseline blood', 'final_blood', 'baseline_blood'),
             ('Dentate gyrus vs Baseline blood', 'dentate_gyrus', 'baseline_blood'),
             ('Dentate gyrus vs Final blood', 'dentate_gyrus', 'final_blood')]

print("\n3) EXACT BINOMIAL (paired sign) TEST per gene, n=30, two-sided, H0 p=0.5")
rows = []
for name, ta, tb in contrasts:
    A = counts[:, tc[ta]]; B = counts[:, tc[tb]]
    p, k, ne = sign_test(A, B)
    padj = multipletests(p, method='fdr_bh')[1]
    lfc = log2fc(A, B)
    raw_sig = p < 0.05; fdr_sig = padj < 0.05
    rows.append(dict(Contrast=name,
                     raw_n=int(raw_sig.sum()), raw_up=int((raw_sig & (lfc > 0)).sum()),
                     raw_dn=int((raw_sig & (lfc < 0)).sum()),
                     fdr_n=int(fdr_sig.sum()), fdr_up=int((fdr_sig & (lfc > 0)).sum()),
                     fdr_dn=int((fdr_sig & (lfc < 0)).sum()),
                     fdr_lfc2=int((fdr_sig & (abs(lfc) >= 2)).sum()),
                     fdr_lfc3=int((fdr_sig & (abs(lfc) >= 3)).sum()),
                     mean_ne=round(float(ne.mean()), 1)))

df = pd.DataFrame(rows)
print(df.to_string(index=False))

print("\n4) ROBUSTNESS (FDR<0.05 counts across methods/settings)")
# (a) gene filters
for fname, mask in [('all genes', np.ones(len(genes), bool)),
                    ('exclude all-zero genes', counts.sum(1) > 0),
                    ('exclude genes with >=50% zeros', (counts == 0).mean(1) < 0.5)]:
    line = f"   filters - {fname:28s}: "
    for name, ta, tb in contrasts:
        p, _, _ = sign_test(counts[mask][:, tc[ta]], counts[mask][:, tc[tb]])
        padj = multipletests(p, method='fdr_bh')[1]
        line += f"{name.split(' vs')[0]}={int((padj<.05).sum())}  "
    print(line)
# (b) unpaired pooled-count binomial on CPM-scaled counts
print("   unpaired pooled-count binomial (CPM-scaled), FDR<0.05:")
cpm = counts / counts.sum(0, keepdims=True) * 1e6
for name, ta, tb in contrasts:
    SA = cpm[:, tc[ta]].sum(1) + PSEUDO; SB = cpm[:, tc[tb]].sum(1) + PSEUDO
    p = np.array([binomtest(int(round(SA[i])), int(round(SA[i] + SB[i])), 0.5).pvalue for i in range(len(SA))])
    padj = multipletests(p, method='fdr_bh')[1]
    print(f"      {name:34s} FDR={int((padj<.05).sum()):5d}  FDR+|lfc|>=2={int(((padj<.05)&(abs(np.log2(SA/SB))>=2)).sum()):5d}")

print("\n5) DECISION")
order = df.sort_values('fdr_n')
for _, r in order.iterrows():
    print(f"   {r['Contrast']:36s} FDR<0.05={r['fdr_n']:6d} (up={r['fdr_up']}, down={r['fdr_dn']}) | "
          f"FDR&|lfc2|>=2={r['fdr_lfc2']:6d} | FDR&|lfc|>=3={r['fdr_lfc3']:6d}")
best = order.iloc[0]['Contrast']
worst = order.iloc[2]['fdr_n']
ratio = worst / max(order.iloc[0]['fdr_n'], 1)
print(f"\n   -> The comparison with the fewest DEGs (primary FDR<0.05) is: {best}")
print(f"   -> At any fold-change magnitude (>=2/>=3) it is ~2 orders of magnitude below the "
      f"cross-tissue contrasts (ratio vs largest={ratio:.1f}x at FDR-only), i.e. it shows NEGLIGIBLE effects.")
print(f'ANSWER: {best}')

# Optional CSV of per-gene results for the final-vs-baseline contrast (first one)
pF, kF, neF = sign_test(counts[:, tc['final_blood']], counts[:, tc['baseline_blood']])
padjF = multipletests(pF, method='fdr_bh')[1]
lfcF = log2fc(counts[:, tc['final_blood']], counts[:, tc['baseline_blood']])
pd.DataFrame({'GeneID': genes, 'p_raw': pF, 'p_FDR': padjF, 'log2FC_final_vs_baseline': lfcF,
              'k_up': kF, 'n_eff': neF}).to_csv('final_vs_baseline_binom.csv', index=False)
print("\n[CSV] per-gene results saved: final_vs_baseline_binom.csv")
