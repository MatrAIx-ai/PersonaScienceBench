#!/usr/bin/env python3
"""
BixBench bix-30-q1
"What percentage of miRNAs show significant differential expression between
 patient and control groups before multiple testing correction?"

Main test : two-sample Student's t-test (equal variances), two-sided,
            per miRNA, on raw Ct values, patients (P_1..P_10) vs controls (C_11..C_20).
Threshold : nominal p < 0.05 (NO multiple testing correction).
Denominator: 175 testable miRNAs.
Missing data: pairwise deletion; text 'NAN' treated as missing.
Robustness : Welch t-test (equal_var=False), Mann-Whitney U, and direction
            (up/down in patients based on mean Ct).
"""
import struct, math, statistics
import numpy as np
from scipy import stats

# ---------------- OLE2 (CFB) + BIFF8 minimal parser ----------------
MAGIC = bytes.fromhex('d0cf11e0a1b11ae1')

class Cfb:
    def __init__(self, data):
        self.data = data
        assert data[:8] == MAGIC, "Not a CFB file"
        self.sector_shift = struct.unpack_from('<H', data, 0x1E)[0]
        self.mini_sector_shift = struct.unpack_from('<H', data, 0x20)[0]
        self.sector_size = 1 << self.sector_shift
        self.mini_sector_size = 1 << self.mini_sector_shift
        nfat = struct.unpack_from('<I', data, 0x2C)[0]
        self.first_dir_sector = struct.unpack_from('<I', data, 0x30)[0]
        self.mini_stream_cutoff = struct.unpack_from('<I', data, 0x38)[0]
        self.first_minifat_sector = struct.unpack_from('<I', data, 0x3C)[0]
        nminifat = struct.unpack_from('<I', data, 0x40)[0]
        self.first_difat_sector = struct.unpack_from('<I', data, 0x44)[0]
        ndifat = struct.unpack_from('<I', data, 0x48)[0]
        difat = list(struct.unpack_from('<109I', data, 0x4C))
        extra, sec = [], self.first_difat_sector
        for _ in range(ndifat):
            off = (sec + 1) * self.sector_size
            extra.extend(struct.unpack_from('<%dI' % ((self.sector_size//4)-1), data, off))
            nxt = struct.unpack_from('<I', data, off + self.sector_size - 4)[0]
            if nxt == 0xFFFFFFFE: break
            sec = nxt
        self.fat_sectors = [s for s in difat + extra if s < 0xFFFFFFFA]
        fat = []
        for s in self.fat_sectors:
            off = (s + 1) * self.sector_size
            fat.extend(struct.unpack_from('<%dI' % (self.sector_size//4), data, off))
        self.fat = fat
        off = (self.first_minifat_sector + 1) * self.sector_size
        self.minifat = struct.unpack_from('<%dI' % (nminifat * self.sector_size // 4), data, off)
        self.mini_stream = None

    def _sector_bytes(self, sec, mini):
        if not mini:
            off = (sec + 1) * self.sector_size
            return self.data[off:off+self.sector_size]
        off = sec * self.mini_sector_size
        return self.mini_stream[off:off+self.mini_sector_size]

    def _read_chain(self, start, mini=False):
        fat = self.minifat if mini else self.fat
        ss = self.mini_sector_size if mini else self.sector_size
        out, sec, seen = bytearray(), start, set()
        while sec != 0xFFFFFFFE and sec < 0xFFFFFFFA:
            if sec in seen: break
            seen.add(sec)
            out.extend(self._sector_bytes(sec, mini))
            sec = fat[sec] if sec < len(fat) else 0xFFFFFFFE
        return bytes(out)

    def read_stream(self, start, size):
        if size < self.mini_stream_cutoff and start != 0xFFFFFFFE:
            if self.mini_stream is None:
                root = self.directory[0]
                self.mini_stream = self._read_chain(root['start'])[:root['size']]
            return self._read_chain(start, mini=True)[:size]
        return self._read_chain(start)[:size]

    @property
    def directory(self):
        if hasattr(self, '_dir'): return self._dir
        ents = []
        off = (self.first_dir_sector + 1) * self.sector_size
        for i in range(self.sector_size // 128):
            eo = off + i*128
            name_len = struct.unpack_from('<H', self.data, eo+64)[0]
            if name_len == 0: break
            name = self.data[eo:eo+name_len-2].decode('utf-16-le', 'replace')
            otype = self.data[eo+66]
            start = struct.unpack_from('<I', self.data, eo+0x74)[0]
            size = struct.unpack_from('<Q', self.data, eo+0x78)[0]
            ents.append({'name': name, 'type': otype, 'start': start, 'size': size})
        self._dir = ents
        return ents

def parse_sst(data):
    total, unique = struct.unpack_from('<II', data, 0)
    pos, strings = 8, []
    for _ in range(unique):
        cch = struct.unpack_from('<H', data, pos)[0]; pos += 2
        flags = data[pos]; pos += 1
        frich, fext, fhigh = bool(flags & 0x08), bool(flags & 0x04), bool(flags & 0x01)
        if frich: pos += 2
        if fext: pos += 4
        if fhigh:
            s = data[pos:pos+cch*2].decode('utf-16-le', 'replace'); pos += cch*2
        else:
            s = data[pos:pos+cch].decode('latin-1'); pos += cch
        if frich: pos += (data[pos-2] if False else 0)   # placeholder, not needed here
        strings.append(s)
    return strings

def decode_rk(v):
    hundred, intflag = v & 0x02, v & 0x01
    val = v >> 2
    if intflag:
        f = float(val) if val < (1 << 30) else float(val - (1 << 30))
    else:
        d = ((val & 0x3FFFFFFF) | (v & 0x80000000)) << 32
        f = struct.unpack('<d', struct.pack('<Q', d))[0]
    return f / 100.0 if hundred else f

def read_xls_sheet(path):
    data = open(path, 'rb').read()
    cfb = Cfb(data)
    wb = None
    for e in cfb.directory:
        if e['type'] == 2 and e['name'].lower() in ('workbook', 'book'):
            wb = cfb.read_stream(e['start'], e['size']); break
    assert wb is not None, "no workbook stream"
    recs, pos = [], 0
    while pos + 4 <= len(wb):
        rtype, rlen = struct.unpack_from('<HH', wb, pos)
        recs.append((rtype, wb[pos+4:pos+4+rlen]))
        pos += 4 + rlen
    sst = parse_sst([r for t, r in recs if t == 0x00FC][0])
    cells = {}
    in_sheet = False
    for rtype, rdata in recs:
        if rtype == 0x0085:
            in_sheet = True; continue
        if not in_sheet: continue
        if rtype == 0x00FD:      # LABELSST
            row, col = struct.unpack_from('<HH', rdata, 0)
            cells[(row, col)] = sst[struct.unpack_from('<I', rdata, 6)[0]]
        elif rtype == 0x0203:    # NUMBER
            row, col = struct.unpack_from('<HH', rdata, 0)
            cells[(row, col)] = struct.unpack_from('<d', rdata, 6)[0]
        elif rtype == 0x027E:    # RK
            row, col = struct.unpack_from('<HH', rdata, 0)
            cells[(row, col)] = decode_rk(struct.unpack_from('<I', rdata, 6)[0])
        elif rtype == 0x00BD:    # MULRK
            row = struct.unpack_from('<H', rdata, 0)[0]
            col0 = struct.unpack_from('<H', rdata, 2)[0]
            for i in range((len(rdata) - 6) // 6):
                cells[(row, col0 + i)] = decode_rk(struct.unpack_from('<I', rdata, 4 + i*6)[0])
    return cfb, cells

def num(x):
    return x if isinstance(x, (int, float)) else None  # 'NAN' -> None

# ---------------- Load data ----------------
XLS_PATH = 'data/pone.0150501.s002.xls'
cfb, cells = read_xls_sheet(XLS_PATH)

P_COLS = list(range(1, 11))    # P_1..P_10 -> patients
C_COLS = list(range(11, 21))   # C_11..C_20 -> controls
N_MIRNA = 175

mirnas = [cells.get((r, 0)) for r in range(2, 2 + N_MIRNA)]
matrix = [[num(cells.get((r, c))) for c in range(1, 21)] for r in range(2, 2 + N_MIRNA)]
sample_ids = [cells.get((1, c)) for c in range(1, 21)]
assert len(set(mirnas)) == N_MIRNA, "miRNA names not unique"
assert sample_ids[:10] == [f'P_{i}' for i in range(1, 11)]
assert sample_ids[10:] == [f'C_{i}' for i in range(11, 21)]

# ---------------- Per-miRNA tests ----------------
rows = []
sig_student = sig_welch = sig_mw = 0
for name, row in zip(mirnas, matrix):
    pv = [v for v in (row[c-1] for c in P_COLS) if v is not None]
    cv = [v for v in (row[c-1] for c in C_COLS) if v is not None]
    if len(pv) < 2 or len(cv) < 2:
        rows.append((name, len(pv), len(cv), math.nan, math.nan, math.nan, math.nan, math.nan, math.nan))
        continue
    mean_p, mean_c = statistics.mean(pv), statistics.mean(cv)
    t_student, p_student = stats.ttest_ind(pv, cv, equal_var=True)
    t_welch, p_welch = stats.ttest_ind(pv, cv, equal_var=False)
    U, p_mw = stats.mannwhitneyu(pv, cv, alternative='two-sided', method='asymptotic')
    # direction: lower Ct in patients -> HIGHER expression in patients (='up in patients')
    direction = 'up_in_patients' if mean_p < mean_c else 'down_in_patients'
    rows.append((name, len(pv), len(cv), mean_p, mean_c,
                 p_student, p_welch, p_mw, direction))
    sig_student += int(p_student < 0.05)
    sig_welch   += int(p_welch   < 0.05)
    sig_mw      += int(p_mw      < 0.05)

cols = ['miRNA', 'n_patients', 'n_controls', 'mean_Ct_patients', 'mean_Ct_controls',
        'p_student', 'p_welch', 'p_mw', 'direction']
df_rows = rows

# ---------------- Results ----------------
print("=" * 72)
print("BIXBENCH bix-30-q1 — differential expression BEFORE multiple-testing correction")
print("Data: Table S1 Ct values, 175 miRNAs, 10 patients (P_1..P_10) vs 10 controls (C_11..C_20)")
print("=" * 72)
print(f"Total miRNAs tested (denominator)      : {N_MIRNA}")
print(f"miRNAs with p < 0.05  [Student t-test] : {sig_student} / {N_MIRNA}")
pct = 100.0 * sig_student / N_MIRNA
print(f"PERCENTAGE (main, Student t-test)      : {pct:.2f}%")
print("-" * 72)
print("Robustness (sensitivity) checks:")
print(f"  Welch  t-test (equal_var=False)  : {sig_welch} / {N_MIRNA}  -> {100.0*sig_welch/N_MIRNA:.2f}%")
print(f"  Mann–Whitney U (asymptotic)      : {sig_mw} / {N_MIRNA}  -> {100.0*sig_mw/N_MIRNA:.2f}%")
print("-" * 72)
# direction among significant (Student)
sig_rows = [r for r in df_rows if r[5] < 0.05]
up = sum(1 for r in sig_rows if r[8] == 'up_in_patients')
down = sum(1 for r in sig_rows if r[8] == 'down_in_patients')
print(f"Direction among {len(sig_rows)} significant (Student p<0.05):")
print(f"  up in patients   (patients lower Ct => higher expression): {up}")
print(f"  down in patients (patients higher Ct => lower expression): {down}")
print("-" * 72)
print("Top 15 most significant (Student t-test):")
top = sorted([r for r in df_rows if r[5] == r[5]], key=lambda r: r[5])[:15]
for r in top:
    print(f"  {r[0]:<18} meanCt P={r[3]:6.2f} C={r[4]:6.2f}  p_student={r[5]:.4e}  p_welch={r[6]:.4e}  p_mw={r[7]:.4e}  {r[8]}")

# Save machine-readable table
import csv
with open('de_results.csv', 'w', newline='') as f:
    w = csv.writer(f)
    w.writerow(cols)
    w.writerows(df_rows)
print("-" * 72)
print("Saved full per-miRNA table to de_results.csv (%d rows)" % len(df_rows))
print(f"FINAL ANSWER: {pct:.2f}% of miRNAs ({sig_student}/175) show significant differential",
      "expression (Student t-test, nominal p < 0.05, no multiple-testing correction).")
