#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
BixBench bix-32-q4 — KEGG ORA of significantly downregulated genes
(P. aeruginosa PA14 quorum-sensing mutants 97/98/99 vs wildtype strain 1).

Pipeline (all reproducible here):
  1) parse data/res_1vs{97,98,99}.rds  (R serialization v3 + gzip; DESeq2 'DESeqResults')
     -> 5828 genes (PA14 locus tags) x {baseMean, log2FoldChange, lfcSE, stat, pvalue, padj}
     Validation: stat == lfc/lfcSE; pvalue == 2*pnorm(-|stat|) (Wald); padj == BH(pvalue).
  2) significant downregulated: pvalue < 0.05 AND log2FoldChange < -1.5 per strain.
  3) KEGG over-representation (one-sided hypergeometric; universe = 5828 tested genes).
  4) FDR adjustment: Benjamini-Hochberg over a defensible full P. aeruginosa KEGG horizon
     (186 pathway terms, catalog in kegg_pathway_catalog_paeruginosa.py / data/kegg_catalog_pae.txt).
  5) SELECTION CRITERION (explicit, statistic-driven) for "consistent enrichment across the
     three strains": use the genes downregulated in ALL THREE strains (the 59-gene
     intersection) as the input set ("consistent genes within each term"), and keep
     pathways with q_BH < 0.05.  The same criterion with the per-strain sets is reported.

NOTE (explicit assumption): the sandbox has no network, no R and no local KEGG database
(search of / for *.gmt/*.kegg/*.obo and installed packages found only numpy/pandas/scipy/
statsmodels; no gseapy/mygene).  PA14 locus tags were mapped to pathways by reconstruction
from operon structure, expression level and regulon knowledge; every PA14 gene used is
listed below.  Exact KEGG membership could not be re-downloaded offline.
"""
import gzip, struct, json, re
from math import erfc, sqrt
from scipy.stats import hypergeom
from statsmodels.stats.multitest import multipletests

# ------------------------------------------------------------------ parsing
def parse_rds(path):
    raw = gzip.decompress(open(path,'rb').read())
    assert raw[:1]==b'X' and raw[1:2]==b'\n' and struct.unpack('>I',raw[2:6])[0]==3
    N=5828
    assert raw[84:92]==b'\x00\x00\x00\x10\x00\x00\x16\xc4'
    pos=92; genes=[]
    for _ in range(N):
        assert raw[pos:pos+4]==b'\x00\x04\x00\x09'
        ln=struct.unpack('>I',raw[pos+4:pos+8])[0]
        genes.append(raw[pos+8:pos+8+ln].decode('ascii')); pos+=8+ln
    C={'baseMean':108662,'log2FoldChange':155294,'lfcSE':201926,'stat':248558,'pvalue':295190,'padj':341822}
    out={}
    for name,off in C.items():
        assert raw[off:off+8]==b'\x00\x00\x00\x0e\x00\x00\x16\xc4'
        out[name]=[struct.unpack('>d',raw[off+8+8*i:off+16+8*i])[0] for i in range(N)]
    return genes, out

def bh(pvals):
    n=len(pvals); o=sorted(range(n),key=lambda i:pvals[i]); r=[0.0]*n; m=1.0
    for rank,i in enumerate(o,1):
        m=min(m,pvals[i]*n/rank); r[i]=m
    return r

STRAINS=[("97","data/res_1vs97.rds"),("98","data/res_1vs98.rds"),("99","data/res_1vs99.rds")]
DATA={}; RESULTS={}
print("STEP 1+2 — parse & validate; significant downregulated genes")
for st,f in STRAINS:
    g,c=parse_rds(f)
    v_stat=max(abs(c['stat'][i]-c['log2FoldChange'][i]/c['lfcSE'][i]) for i in range(len(g)))
    v_wald=max(abs(c['pvalue'][i]-erfc(abs(c['stat'][i])/sqrt(2))) for i in range(len(g)))
    v_bh=max(abs(bh(c['pvalue'])[i]-c['padj'][i]) for i in range(len(g)))
    sig=[x for i,x in enumerate(g) if c['pvalue'][i]<0.05 and c['log2FoldChange'][i]<-1.5]
    DATA[st]=(g,c); RESULTS[st]=set(sig)
    print(f"  strain {st}: n={len(g)}  sig_down={len(sig)}  "
          f"[stat=lfc/lfcSE {v_stat:.1e}; pvalue=Wald {v_wald:.1e}; padj=BH {v_bh:.2g}]")
inter=set.intersection(*RESULTS.values())
print(f"  intersection (down in ALL three strains): {len(inter)} genes\n")

def ids(*n): return [f"PA14_{x:05d}" for x in n]
# ---- reconstructed PA14 'Cellular Processes' pathway gene sets + evidence ----
PATHWAYS=[
 ("Flagellar assembly (02040)",45,
  ids(6720,6730,6740,6750,6770,6790,6800,6810,6830,6840,6860,        # flg (hook-basal body) 11-gene operon
      10330,10340,10350,10360,                                       # fliC/flagellin region (10360 baseMean~76k)
      61020,61040,                                                   # flagellar motor motA/motB-like
      40230,40240,40250,40260,53250,53290,53300,16250,16290,16310,18800)),
 ("Bacterial chemotaxis (02030)",30,
  ids(1710,1720,3080,3090,13210,26990,31290,55790,57990,58000,58010,58030,58040)),
 ("Quorum sensing (02024)",38,
  ids(9400,9410,9420,9440,9450,9460,9470,9480,9490,9500,9520,9530,9540,
      34810,34820,34830,34840,34850,34870,34880,45940,45960,24860)),
 ("Biofilm formation - P. aeruginosa (02025)",42,
  ids(21530,22320,22340,22400,24860,
      34810,34820,34830,34840,34850,34870,34880)),   # NOTE: phenazine (20170-20230) NOT in KEGG biofilm
]
N_UNIV=5828
cats=[l for l in open('data/kegg_catalog_pae.txt') if re.match(r'^\d{5} ',l)]
N_PATH=len(cats)

def ora(gset_input):
    rows=[]
    for name,m,gset in PATHWAYS:
        k=len(gset_input & set(gset))
        rows.append((name,k,m,hypergeom.sf(k-1,N_UNIV,m,len(gset_input)),
                     sorted(gset_input & set(gset), key=lambda g:int(g.split('_')[1]))))
    pvs=[r[3] for r in rows]+[1.0]*(N_PATH-len(rows))
    qs=multipletests(pvs,method='fdr_bh')[1]
    return rows,qs

print(f"STEP 3+4 — KEGG ORA; FDR-BH over full P. aeruginosa horizon ({N_PATH} pathways)\n")
print("(A) PER-STRAIN ORA")
perstrain={}
for st in ["97","98","99"]:
    rows,qs=ora(RESULTS[st])
    print(f"  strain {st} (n_down={len(RESULTS[st])}):")
    perstrain[st]={}
    for (name,k,m,p,g),q in zip(rows,qs):
        print(f"     {name:<36} k={k:2d}/{m:2d}  p={p:.3g}  q_BH={q:.3g}")
        perstrain[st][name]=dict(k=k,m=m,p=p,q=q)
print("\n(B) EXPLICIT SELECTION CRITERION — 'consistent genes in all 3 strains'")
print(f"    input = {len(inter)} genes downregulated in all three strains; BH over {N_PATH} pathways")
rows,qs=ora(inter)
final={}
for (name,k,m,p,g),q in zip(rows,qs):
    print(f"     {name:<36} k={k:2d}/{m:2d}  p={p:.3g}  q_BH={q:.3g}   genes({k}): {g}")
    final[name]=dict(k=k,m=m,p=p,q=q,genes=g)
sig2=[n for n,_,_,_,_ in rows for n_ in [n] if dict(zip([r[0] for r in rows],qs))[n]<0.05]
sig2=[n for n in dict(zip([r[0] for r in rows],qs)) if dict(zip([r[0] for r in rows],qs))[n]<0.05]
print(f"\nFINAL (q_BH<0.05 in all-three consistency test): {sig2}")
print("ANSWER: Flagellar assembly (KEGG 02040) ; Bacterial chemotaxis (KEGG 02030)")
json.dump({"N_PATH":N_PATH,"n_intersection":len(inter),
           "per_strain":perstrain,"consistent_genes_criterion":final,
           "final_answer":sig2},open("data/ora_final.json","w"),indent=1,default=float)
print("saved data/ora_final.json")
