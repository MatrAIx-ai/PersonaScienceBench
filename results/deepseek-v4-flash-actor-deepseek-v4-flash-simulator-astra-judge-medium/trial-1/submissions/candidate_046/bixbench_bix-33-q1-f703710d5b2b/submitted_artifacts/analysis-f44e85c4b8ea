"""
BixBench bix-33-q1 — Which immune cell type has the highest number of
significantly differentially expressed genes after AAV9 mini-dystrophin treatment?

Authoritative source: "Supplemental Data File 1 PostvsPre_DEG_tables_ANNOTATED
by_cell_type.xlsx" (Post vs Pre AAV9 mini-dystrophin per cell type).

Primary criterion (approved): DEG significant = p_val_adj < 0.05, counted per
cell-type sheet. Tables are already pre-filtered to |avg_log2FC| >= 0.25
(Seurat FindMarkers default), so no second log2FC threshold is applied.
Sensitivity variants (|log2FC|>=0.5, nominal p<0.05) are reported for
transparency only.
"""
import pandas as pd

XLSX = "data/Supplemental Data File 1 PostvsPre_DEG_tables_ANNOTATED by_cell_type.xlsx"

xl = pd.ExcelFile(XLSX)
print(f"# cell-type sheets: {len(xl.sheet_names)}")

rows = []
for s in xl.sheet_names:
    df = pd.read_excel(XLSX, sheet_name=s)
    if list(df.columns) != ['Unnamed: 0','p_val','avg_log2FC','pct.1','pct.2','p_val_adj']:
        raise ValueError(f"Unexpected columns in sheet {s}: {list(df.columns)}")
    n_total = len(df)
    n_adj05 = int((df['p_val_adj'] < 0.05).sum())
    n_adj05_fc05 = int(((df['p_val_adj'] < 0.05) & (df['avg_log2FC'].abs() >= 0.5)).sum())
    n_nom05 = int((df['p_val'] < 0.05).sum())
    n_na = int(df.isna().sum().sum())
    n_dup = int(df['Unnamed: 0'].duplicated().sum())
    rows.append(dict(cell_type=s, n_rows=n_total,
                     n_DEG_adj05=n_adj05, n_adj05_absFC05=n_adj05_fc05,
                     n_nominal_p05=n_nom05, n_NA=n_na, n_dup_genes=n_dup))

res = pd.DataFrame(rows)
res = res.sort_values('n_DEG_adj05', ascending=False).reset_index(drop=True)

print("\n=== COUNT PER CELL TYPE (primary criterion: p_val_adj < 0.05) ===")
print(res[['cell_type','n_rows','n_DEG_adj05','n_adj05_absFC05','n_nominal_p05','n_NA','n_dup_genes']].to_string(index=False))

winner = res.iloc[0]
print("\n=== RESULT ===")
print(f"Immune cell type with the highest number of significantly differentially "
      f"expressed genes (p_val_adj < 0.05) after AAV9 mini-dystrophin treatment: "
      f"{winner['cell_type']} with {winner['n_DEG_adj05']} DEGs.")

# sensitivity (transparency only, NOT the answer)
print("\n=== SENSITIVITY (transparency only, not the answer) ===")
print("Top under p_val_adj<0.05 AND |log2FC|>=0.5 ->",
      res.sort_values('n_adj05_absFC05', ascending=False).iloc[0][['cell_type','n_adj05_absFC05']].to_dict())
print("Top under nominal p<0.05 ->",
      res.sort_values('n_nominal_p05', ascending=False).iloc[0][['cell_type','n_nominal_p05']].to_dict())

# save results table for evidence
res.to_csv("deg_counts_per_cell_type.csv", index=False)
print("\nSaved per-cell-type counts to deg_counts_per_cell_type.csv")
print("Global checks: total NA cells =", int(res['n_NA'].sum()),
      "| total duplicated gene rows (within sheet) =", int(res['n_dup_genes'].sum()))
