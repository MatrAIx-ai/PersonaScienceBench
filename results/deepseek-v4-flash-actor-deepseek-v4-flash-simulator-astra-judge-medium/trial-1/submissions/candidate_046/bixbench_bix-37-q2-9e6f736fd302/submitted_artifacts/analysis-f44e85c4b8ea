"""Determine basal ENO1 protein level in normal samples (3 significant figures).

Evidence plan:
1. Load Proteomic_data.xlsx, sheet 'Tumor vs Normal'.
2. Inspect structure (shape, columns, dtypes, nulls).
3. Locate ENO1 row (gene == 'ENO1'; confirm single match, protein P06733).
4. Extract raw 'Normal' value and round to 3 significant figures.
5. Cross-check: Ratio ~ Tumor/Normal; no duplicate ENO1 rows.
"""
import pandas as pd

PATH = "/workspace/data/Proteomic_data .xlsx"
df = pd.read_excel(PATH, sheet_name="Tumor vs Normal")

print("Shape:", df.shape)
print("Columns:", list(df.columns))
print("\nDtypes:\n", df.dtypes)
print("\nNon-null counts:\n", df.count())

# Locate ENO1
exact = df['gene'].astype(str).str.strip() == 'ENO1'
print("\nRows with gene=='ENO1':", int(exact.sum()))
eno1 = df.loc[exact]
print(eno1[['protein', 'Description', 'gene', 'gene_id', 'Normal', 'Tumor',
            'Ratio', 'FC', 'log2FC', 'p.value', 'adj.Pval', 'is_sig']].to_string())

normal_raw = float(eno1['Normal'].iloc[0])
print("\nRaw Normal value:", repr(normal_raw))
print("Scientific 3 sig figs: {:.3e}".format(normal_raw))
print("Decimal 3 sig figs:    {:.3g}".format(normal_raw))
print("Integer rounded (3 sig figs):", int(round(normal_raw, -4)))

# Cross-checks
print("\nTumor/Normal =", eno1['Tumor'].iloc[0] / eno1['Normal'].iloc[0], "(Ratio =", eno1['Ratio'].iloc[0], ")")
print("Any other row with 'ENO1' in protein/Description:",
      int(df['protein'].astype(str).str.contains('ENO1', na=False).sum()
          + df['Description'].astype(str).str.contains('ENO1', na=False).sum()))
