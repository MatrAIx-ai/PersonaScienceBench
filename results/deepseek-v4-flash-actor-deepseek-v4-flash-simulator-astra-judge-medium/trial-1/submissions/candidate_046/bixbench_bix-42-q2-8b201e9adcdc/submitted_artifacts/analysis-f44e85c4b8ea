# ----------------------------------------------------------------------
# Helpers
# ----------------------------------------------------------------------
def fisher_pearson(x, ddof=1):
    """x: 1d array. Returns (g1_bias, g1_corrected) Fisher-Pearson moment skewness."""
    x = np.asarray(x, dtype=float)
    x = x[np.isfinite(x)]
    n = x.size
    if n < 3:
        return np.nan, np.nan
    m2 = np.mean((x - x.mean())**2)
    m3 = np.mean((x - x.mean())**3)
    if m2 <= 0:
        return np.nan, np.nan
    g1_bias = m3 / m2**1.5
    # sample-size correction (adjusted Fisher-Pearson)
    g1_corr = g1_bias * (np.sqrt(n*(n-1)) / (n-2))
    return g1_bias, g1_corr

def bowley(x):
    """Yule-Kendall (Bowley) quartile skewness = (Q3+Q1-2*Q2)/(Q3-Q1)."""
    x = np.asarray(x, dtype=float); x = x[np.isfinite(x)]
    q1, q2, q3 = np.percentile(x, [25, 50, 75])
    denom = q3 - q1
    return np.nan if denom == 0 else (q3 + q1 - 2*q2)/denom

def classify(g1):
    """Explicit thresholds agreed with the researcher."""
    if abs(g1) < 0.5:
        return "approximately normal / symmetric"
    if abs(g1) < 1.0:
        return "moderately skewed"
    return "highly skewed"

def summarize(name, x):
    x = np.asarray(x, dtype=float); xf = x[np.isfinite(x)]
    g1_b, g1_c = fisher_pearson(xf)
    se = np.sqrt(6*xf.size) / xf.size if xf.size>=3 else np.nan
    # standard error of g1 (approx sqrt(6/n) for normal data)
    se_norm = np.sqrt(6.0/xf.size)
    bow = bowley(xf)
    out = {
        "unit": name, "n": int(xf.size),
        "min": float(np.nanmin(xf)), "max": float(np.nanmax(xf)),
        "mean": float(np.nanmean(xf)), "median": float(np.nanmedian(xf)),
        "sd": float(np.nanstd(xf, ddof=1)),
        "q1": float(np.percentile(xf,25)), "q3": float(np.percentile(xf,75)),
        "g1_bias": g1_b, "g1_corrected": g1_c, "g1_se_normal": se_norm,
        "bowley": bow, "mean_minus_median_over_sd": (np.nanmean(xf)-np.nanmedian(xf))/np.nanstd(xf, ddof=1),
        "classification": classify(g1_c) + (" | RIGHT-skewed (positive)" if g1_c > 0 else " | LEFT-skewed (negative)"),
    }
    return out

def ascii_hist(x, bins=60, width=70, title=""):
    """Bin on log10(x+1) to make the heavy tail visible in the terminal."""
    y = np.log10(np.asarray(x)+1.0)
    h, edges = np.histogram(y, bins=bins)
    mx = h.max() or 1
    lines = [f"--- {title} ---"]
    lines.append("Histogram of log10(value+1) [linear count, log-x binning]")
    for i in range(bins):
        bar = "#" * int(round(h[i]/mx*width))
        lines.append(f"{edges[i]:6.2f}-{edges[i+1]:6.2f} | {h[i]:>8d} {bar}")
    return "\n".join(lines)

