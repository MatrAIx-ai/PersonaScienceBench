# ----------------------------------------------------------------------
# 4. PER-GENE summary
# ----------------------------------------------------------------------
print("="*78)
print("PER-GENE MOMENT SKEWNESS (raw scale, adjusted Fisher-Pearson)")
# only genes with nonzero sd within a gene; keep zero-expression genes separately
var_per_gene = vals.var(axis=1, ddof=1)
const_zero = var_per_gene == 0
# vectorized g1 per gene
n = vals.shape[1]
m2 = np.mean((vals - vals.mean(axis=1, keepdims=True))**2, axis=1)
m3 = np.mean((vals - vals.mean(axis=1, keepdims=True))**3, axis=1)
g1_bias_g = np.where(m2 > 0, m3 / m2**1.5, np.nan)
g1_corr_g = g1_bias_g * (np.sqrt(n*(n-1)) / (n-2))
finite = np.isfinite(g1_corr_g)
print(f"  genes with constant values (sd=0): {int(const_zero.sum())} ({const_zero.mean()*100:.2f}%)")
print(f"  genes with computable skewness     : {int(finite.sum())}")
print(f"  mean(g1)={np.nanmean(g1_corr_g):.3f}  median(g1)={np.nanmedian(g1_corr_g):.3f}  "
      f"p25={np.nanpercentile(g1_corr_g,25):.3f} p75={np.nanpercentile(g1_corr_g,75):.3f}")
print(f"  fraction g1>0  (right-skewed genes): {(np.nan_to_num(g1_corr_g)>0).mean()*100:.2f}%")
print(f"  fraction g1>1  (highly right-skewed): {(np.nan_to_num(g1_corr_g)>1).mean()*100:.2f}%")
print(f"  min(g1)={np.nanmin(g1_corr_g):.3f}  max(g1)={np.nanmax(g1_corr_g):.3f}")
print(ascii_hist(g1_corr_g[finite], bins=50, title="Per-gene g1 (raw scale)"))

# ----------------------------------------------------------------------
# 5. Graphical evidence — self-contained SVG (no matplotlib dependency)
# ----------------------------------------------------------------------
def svg_hist(x, bins, logx=False, logy=False, xlabel="value", title="", fname="artifacts/h.png"):
    x = x[np.isfinite(x)]
    if logx:
        xp = np.log10(x + 1.0)
    else:
        xp = x
    h, edges = np.histogram(xp, bins=bins)
    n_edges = len(edges) - 1
    W, H = 760, 380
    padL, padB, padT, padR = 70, 46, 40, 16
    xmin, xmax = edges[0], edges[-1]
    ymax = np.nanmax(h)
    def X(v): return padL + (v - xmin)/(xmax - xmin) * (W - padL - padR)
    def Y(v): return padB - np.log10(v + 1) if logy else padB - v/ymax * (H - padT - padB)
    # careful: define Y mapping for linear and log y
    def Ylin(v): return padB - v/ymax * (H - padT - padB)
    Yf = Ylin
    # x axis ticks
    xt = []
    if logx:
        for t in range(0, 8): xt.append((t, f"1e{t}"))
        # include the "+1" note
    else:
        for t in range(0, int(xmax)+1, max(1, int(xmax)//6)): xt.append((t, str(t)))
    parts = [f'<svg xmlns="http://www.w3.org/2000/svg" width="{W}" height="{H}" viewBox="0 0 {W} {H}">']
    parts.append(f'<rect width="{W}" height="{H}" fill="white"/>')
    parts.append(f'<text x="{W/2}" y="22" font-size="15" text-anchor="middle" font-family="sans-serif">{title}</text>')
    parts.append(f'<text x="{padL-8}" y="{padB+36}" font-size="12" text-anchor="end" font-family="sans-serif">{xlabel}</text>')
    for t, lab in xt:
        if xmin <= t <= xmax:
            parts.append(f'<line x1="{X(t):.1f}" y1="{padB}" x2="{X(t):.1f}" y2="{padB+4}" stroke="#888" stroke-width="1"/>')
            parts.append(f'<text x="{X(t):.1f}" y="{padB+16}" font-size="10" text-anchor="middle" font-family="sans-serif">{lab}</text>')
    from math import log10
    parts.append(f'<line x1="{padL}" y1="{padB}" x2="{W-padR}" y2="{padB}" stroke="#333"/>')
    parts.append(f'<line x1="{padL}" y1="{padT}" x2="{padL}" y2="{padB}" stroke="#333"/>')
    for b in range(n_edges):
        if h[b] <= 0: continue
        x0, x1 = X(edges[b]), X(edges[b+1])
        y0 = Yf(h[b]); y1 = Yf(0)
        parts.append(f'<rect x="{x0:.1f}" y="{y0:.1f}" width="{max(0.5,x1-x0-0.5):.1f}" height="{y1-y0:.1f}" fill="#2a7ab0" stroke="none" opacity="0.9"/>')
    parts.append('</svg>')
    with open(fname, "w") as fh:
        fh.write("\n".join(parts))
    return fname

fA = svg_hist(flat, bins=80, logx=True, xlabel="log10(value+1) [0=low expression]",
