#!/usr/bin/env python3
"""
BixBench bix-43-q1: CBD/cisplatin combination vs DMSO control
Enrichment analysis with gseapy + GO_Biological_Process_2021

Design (approved plan):
  - Comparison   : Group 'Cisplatin_IC50_CBD_IC50' (samples 9_1..9_3)
                   vs Group 'DMSO' (samples 3_1..3_3), n=3 vs n=3.
  - Filtering    : keep genes with rowSum >= 10 in >= 2 of the 6 samples
                   belonging to the two compared groups.
  - Normalization: DESeq2-style median-of-ratios size factors (numpy).
  - DE statistic : signed DESeq2/NB-Wald-like statistic: mean-dispersion trend
                   (log10 alpha ~ log10 mean, 40 bins) + edgeR-like shrinkage to
                   the trend, Wald z, normal p, Benjamini-Hochberg padj.
  - Mapping      : ENSG -> gene symbol (ensg_to_gene_name.tsv); entries whose
                   'gene_name' is a literal ENSG id (no real symbol) plus entries
                   absent from the mapping are DROPPED (documented); duplicate
                   symbols collapsed to the most-expressed entry.
  - Enrichment   : PRIMARY     gseapy.enrichr  (library GO_Biological_Process_2021,
                   Enrichr API, 'Adjusted P-value' = Benjamini-Hochberg) on the
                   DE gene list (padj < 0.05 & |log2FC| >= 1).
                   CROSS-CHECK gseapy.prerank on the signed ranked list (only if
                   a local GMT of GO_Biological_Process_2021 is available).
  - Report       : GO terms sorted by Adjusted P-value; term with the lowest
                   adjusted p-value is the answer.

How the library is obtained:
  * gseapy.enrichr queries the Enrichr API live (requires network).
  * gseapy.prerank needs local gene-set files; the script downloads the GMT from
    maayanlab.cloud (requests) or reuses a local file (--gmt). If unavailable,
    prerank is skipped (it is only the cross-check, not the reported answer).
Local runner (no gseapy, no network) completes everything up to the ranked/DE
gene-list files under outputs/ and reports that gseapy must run in a
gseapy-enabled environment to produce outputs/go_enrichment_results.csv.
"""

import argparse
import os
import sys

import numpy as np
import pandas as pd
from scipy import stats

OUTDIR = os.path.join(os.path.dirname(os.path.abspath(__file__)), "outputs")
os.makedirs(OUTDIR, exist_ok=True)
DATA = os.path.join(os.path.dirname(os.path.abspath(__file__)), "data")
COUNTS = os.path.join(DATA, "counts_raw_unfiltered.csv")
MAPPING = os.path.join(DATA, "ensg_to_gene_name.tsv")
LAYOUT = os.path.join(DATA, "sample_layout.csv")
GMT_URL = ("https://maayanlab.cloud/Enrichr/geneSetLibrary"
           "?mode=text&libraryName=GO_Biological_Process_2021")

GROUP_A = "Cisplatin_IC50_CBD_IC50"   # CBD/cisplatin combination
GROUP_B = "DMSO"                       # control

FILTER_MIN_TOTAL = 10    # min rowSum across the 6 samples
FILTER_MIN_SAMPLES = 2   # in at least this many samples
PADJ_CUT = 0.05          # DE gene-list threshold
LFC_CUT = 1.0            # |log2 fold-change| threshold for the DE list


def load_data():
    counts = pd.read_csv(COUNTS, index_col=0)
    lay = pd.read_csv(LAYOUT)
    # counts columns 1_1..10_3 <-> layout SampleID 1-1..10-3 (via '-' -> '_')
    lay["col"] = lay["SampleID"].str.replace("-", "_")
    s2g = {c: g for c, g in zip(lay["col"], lay["Group"])}
    cols_a = [c for c in counts.columns if s2g.get(c) == GROUP_A]
    cols_b = [c for c in counts.columns if s2g.get(c) == GROUP_B]
    a = counts[cols_a].copy()   # n=3, unique sample names
    b = counts[cols_b].copy()   # n=3
    if a.shape[1] != 3 or b.shape[1] != 3:
        raise ValueError(f"Expected 3+3 replicates, got {a.shape[1]}+{b.shape[1]}")
    return counts, a, b, lay


def size_factors(a, b):
    """DESeq2-style median-of-ratios size factors over the two groups."""
    x = pd.concat([a, b], axis=1)
    geo = np.exp(np.log(x.replace(0, np.nan)).mean(axis=1))
    ratios = x.div(geo.replace(0, np.nan), axis=0)
    sf = ratios.median(axis=0).fillna(1.0)
    return sf / sf.mean()


def dispersion_trend(mu, alpha_raw, nbins=40):
    """Mean-dispersion trend: median log10(alpha) per log10(mean) bin,
    interpolated; returns trend value for every gene."""
    d = pd.DataFrame({"m": np.log10(mu.replace(0, np.nan)),
                      "a": np.log10(alpha_raw.replace(0, np.nan))}).dropna()
    if len(d) == 0:
        return pd.Series(0.02, index=mu.index)
    bins = pd.cut(d["m"], bins=nbins)
    tm = d.groupby(bins, observed=True)["m"].median()
    ta = d.groupby(bins, observed=True)["a"].median()
    trend = np.power(10.0, np.interp(np.log10(mu.clip(lower=1e-6)),
                                     tm.values, ta.values))
    return pd.Series(trend, index=mu.index)


def de_statistics(a, b, sf):
    """Signed DESeq2/NB-Wald-like statistic (numpy/scipy only, no R)."""
    na, nb = a.shape[1], b.shape[1]
    a_n = a.div(sf[a.columns], axis=1)
    b_n = b.div(sf[b.columns], axis=1)
    muA = a_n.mean(axis=1)
    muB = b_n.mean(axis=1)
    mu = (muA + muB) / 2.0
    all_n = pd.concat([a_n, b_n], axis=1)
    var = all_n.var(axis=1, ddof=1)
    alpha_raw = ((var - mu) / mu.pow(2)).clip(lower=0.0).fillna(0.0)
    alpha_trend = dispersion_trend(mu, alpha_raw)
    prior_df, df_g = 10.0, float(na + nb - 2)
    alpha = (df_g * alpha_raw + prior_df * alpha_trend) / (df_g + prior_df)

    log2fc = np.log2((muA + 1e-6) / (muB + 1e-6))
    muAf = muA.clip(lower=1e-3)
    muBf = muB.clip(lower=1e-3)
    se = (np.sqrt((muA + alpha * muA.pow(2)) / (na * muAf.pow(2))
                  + (muB + alpha * muB.pow(2)) / (nb * muBf.pow(2)))
          / np.log(2))
    z = log2fc / se.clip(lower=1e-12)
    pval = pd.Series(2.0 * (1.0 - stats.norm.cdf(np.abs(z))), index=z.index)
    # floor exact-0 p-values (z very extreme) to the smallest positive float
    p_f = pval.clip(lower=np.nextafter(0.0, 1.0)).fillna(0.5)
    import statsmodels.stats.multitest as mt
    padj = pd.Series(mt.multipletests(p_f.values, method="fdr_bh")[1],
                     index=z.index)
    return pd.DataFrame({
        "baseMean": mu.round(4), "log2FC": log2fc.round(5),
        "stat": z.round(5), "pvalue": pval, "padj": padj, "dispersion": alpha,
    })


def map_symbols(de):
    m = pd.read_csv(MAPPING, sep="\t")
    de = de.reset_index().rename(columns={"index": "ensembl_id"})
    de = de.merge(m, left_on="ensembl_id", right_on="ENSG", how="left")
    de = de.drop(columns=["ENSG"]).rename(columns={"gene_name": "gene_symbol"})
    return de


def resolve_duplicates(de):
    """Collapse duplicate gene symbols, keeping the most-expressed entry."""
    de["is_dup"] = de.duplicated(subset="gene_symbol", keep=False)
    n_dupsyms = int(de.loc[de["is_dup"], "gene_symbol"].nunique())
    n_before = len(de)
    de = (de.sort_values(["gene_symbol", "baseMean"], ascending=[True, False])
            .drop_duplicates(subset="gene_symbol", keep="first")
            .sort_values("padj"))
    return de, n_dupsyms, n_before - len(de)


def build_ranked_and_de_lists(de):
    """Ranked list (for prerank) and DE gene list (for enrichr)."""
    de_s = de[(de["gene_symbol"].notna())
              & (~de["gene_symbol"].str.startswith("ENSG"))]
    p_rank = de_s["pvalue"].clip(lower=np.nextafter(0.0, 1.0))  # finite for p==0
    de_s = de_s.assign(score=np.sign(de_s["log2FC"]) * -np.log10(p_rank))
    ranked = (de_s[["gene_symbol", "score"]].drop_duplicates(subset="gene_symbol")
              .sort_values("score", ascending=False))
    de_list = (de_s[(de_s["padj"] < PADJ_CUT) & (de_s["log2FC"].abs() >= LFC_CUT)]
               .drop_duplicates(subset="gene_symbol").sort_values("padj"))
    return ranked, de_list


def write_outputs(de, ranked, de_list, diag):
    de = de.drop(columns=["is_dup"], errors="ignore")
    de.to_csv(os.path.join(OUTDIR, "de_results.csv"), index=False)
    ranked.to_csv(os.path.join(OUTDIR, "ranked_gene_list.csv"), index=False)
    de_list[["gene_symbol"]].to_csv(os.path.join(OUTDIR, "de_gene_list.txt"),
                                    index=False, header=False)
    with open(os.path.join(OUTDIR, "diagnostics.txt"), "w") as fh:
        for k, v in diag.items():
            fh.write(f"{k}\t{v}\n")


def fetch_gmt(dest):
    """Download GO_Biological_Process_2021 GMT (needed only for prerank)."""
    try:
        import requests
        r = requests.get(GMT_URL, timeout=60)
        r.raise_for_status()
        with open(dest, "w") as fh:
            fh.write(r.text)
        return dest
    except Exception as e:
        print(f"[warn] could not download GMT ({type(e).__name__}: {e}); "
              f"prerank cross-check skipped.")
        return None


def run_gseapy(ranked_csv, de_list_txt, gmt_path=None):
    """Primary gseapy.enrichr + optional prerank cross-check (needs gseapy)."""
    import gseapy as gp
    de_symbols = [l.strip() for l in open(de_list_txt) if l.strip()]
    if not de_symbols:
        print("[warn] empty DE gene list -> enrichr skipped")
        return None
    print(f"[gseapy] enrichr with {len(de_symbols)} DE genes ...")
    enr = gp.enrichr(gene_list=de_symbols,
                     gene_sets="GO_Biological_Process_2021",
                     organism="human",
                     description="CBD_cisplatin_vs_DMSO",
                     outdir=os.path.join(OUTDIR, "enrichr"))
    res = enr.results.copy()
    res["Adjusted P-value"] = pd.to_numeric(res["Adjusted P-value"],
                                            errors="coerce")
    res = res.sort_values("Adjusted P-value").reset_index(drop=True)
    res.to_csv(os.path.join(OUTDIR, "go_enrichment_results.csv"), index=False)
    if gmt_path and os.path.exists(gmt_path):
        print("[gseapy] prerank cross-check ...")
        pre = gp.prerank(rnk=ranked_csv, gene_sets=gp.read_gmt(gmt_path),
                         outdir=os.path.join(OUTDIR, "prerank"),
                         seed=42, threads=2)
        pre.res2d.sort_values("FWER p-value").to_csv(
            os.path.join(OUTDIR, "prerank_results.csv"), index=False)
    else:
        print("[gseapy] no GMT -> prerank cross-check skipped")
    return res


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--gmt", default=None,
                    help="local GMT for GO_Biological_Process_2021 (optional; "
                         "used only by the prerank cross-check)")
    args = ap.parse_args()

    counts, a, b, lay = load_data()
    diag = {"comparison_A": GROUP_A, "comparison_B": GROUP_B,
            "total_genes": int(counts.shape[0]),
            "samples_A": ",".join(a.columns),
            "samples_B": ",".join(b.columns)}
    mat = pd.concat([a, b], axis=1)
    keep = (mat >= 1).sum(axis=1) >= FILTER_MIN_SAMPLES
    keep &= mat.sum(axis=1) >= FILTER_MIN_TOTAL
    a_f, b_f = a[keep], b[keep]
    diag |= {"genes_kept": int(keep.sum()),
             "genes_filtered_out": int((~keep).sum())}

    sf = size_factors(a_f, b_f)
    diag["size_factor_A_mean"] = round(float(sf[a_f.columns].mean()), 4)
    diag["size_factor_B_mean"] = round(float(sf[b_f.columns].mean()), 4)
    de = de_statistics(a_f, b_f, sf)
    de = map_symbols(de)

    # drop unmappable: absent from mapping (NaN) or literal ENSG-as-'symbol'
    unm = de["gene_symbol"].isna() | de["gene_symbol"].str.startswith("ENSG", na=False)
    n_unmapped = int(unm.sum())
    de = de[~unm].reset_index(drop=True)
    de, n_dupsyms, n_dropped = resolve_duplicates(de)
    diag |= {"mapped_genes": int(len(de)),
             "unmapped_or_ensg_symbols_dropped": n_unmapped,
             "duplicate_symbols_collapsed": int(n_dupsyms),
             "duplicate_entries_removed": int(n_dropped),
             "de_genes_padj0.05": int((de["padj"] < PADJ_CUT).sum()),
             "de_genes_padj0.05_and_lfc1": int(
                 ((de["padj"] < PADJ_CUT) & (de["log2FC"].abs() >= LFC_CUT)).sum())}

    ranked, de_list = build_ranked_and_de_lists(de)
    diag |= {"ranked_genes": int(len(ranked)),
             "de_list_genes": int(len(de_list))}
    write_outputs(de, ranked, de_list, diag)

    print("=" * 78)
    print("LOCAL PIPELINE DIAGNOSTICS")
    print("=" * 78)
    for k, v in diag.items():
        print(f"  {k:48s} {v}")
    print("  top 8 DE genes (padj):\n" + de.head(8).to_string())
    print("  top 8 ranked genes by score:\n" + ranked.head(8).to_string())

    gmt = args.gmt
    if not gmt:
        cand = os.path.join(OUTDIR, "GO_Biological_Process_2021.txt")
        gmt = cand if os.path.exists(cand) else fetch_gmt(cand)
    try:
        res = run_gseapy(os.path.join(OUTDIR, "ranked_gene_list.csv"),
                         os.path.join(OUTDIR, "de_gene_list.txt"), gmt)
        if res is None:
            print("\nNo enrichment result (empty DE list).")
            sys.exit(0)
        print("\n" + "=" * 78)
        print("GO_Biological_Process_2021 — SORTED BY ADJUSTED P-VALUE")
        print("(PRIMARY RESULT: gseapy.enrichr / Enrichr API / BH)")
        print("=" * 78)
        cols = ["Term", "Adjusted P-value", "P-value", "Overlap",
                "Odds Ratio", "Combined Score", "Genes"]
        show = res[[c for c in cols if c in res.columns]].head(10)
        print(show.to_string())
        print("\nANSWER: cellular process with lowest adjusted p-value = "
              f"{res.iloc[0]['Term']}  "
              f"(Adjusted P-value = {res.iloc[0]['Adjusted P-value']:.3e})")
    except ImportError:
        print("\n[local runner] gseapy is NOT installed here and cannot be "
              "installed (no network). The gseapy.enrichr step with "
              "'GO_Biological_Process_2021' is fully wired and will run "
              "end-to-end in a gseapy-enabled environment, writing "
              "outputs/go_enrichment_results.csv. All upstream artefacts "
              "(DE stats, ranked list, DE gene list) are in outputs/.")
    except Exception as e:
        print(f"\n[local runner] enrichment could not complete HERE: "
              f"{type(e).__name__}: {e}\n"
              f"The same code runs end-to-end once gseapy + network to the "
              f"Enrichr API (or a local GMT) are available.")


if __name__ == "__main__":
    main()
