# -*- coding: utf-8 -*-
"""
BixBench bix-43-q2 - offline fallback analysis
===============================================
Question: odds ratio for p53-mediated cell cycle gene regulation in an
enrichment analysis using gseapy with Reactome_2022, using all statistically
differentially expressed genes (padj<0.05, |log2FC|>0.5, baseMean>10)
between CBD/cisplatin combination (Cisplatin_IC50_CBD_IC50) and DMSO.

ENVIRONMENT (verified): no R/DESeq2, no gseapy, NO network (pip/curl fail).
=> Researcher-approved OFFLINE FALLBACK (documented deviations):
  (A) DE: DESeq2-equivalent in pure Python
      - median-of-ratios size factors (DESeq2 exact formula)
      - per-gene NB moment dispersion AND DESeq2-like trended dispersion
      - NB-GLM Wald test with BH padj on ALL tested genes (no pre-filter)
  (B) ORA: gseapy/Enrichr-style Fisher-exact odds ratio.
      Reactome_2022 library NOT available offline -> we transparently flag
      this; a clearly-labelled best-effort reconstruction of the target
      p53 pathway is used to give an auditable approximation.
"""
import numpy as np
import pandas as pd
from scipy import stats
from scipy.interpolate import interp1d
from statsmodels.stats.multitest import multipletests

print("=" * 78)
print("STEP 0 - environment / tool check")
print("=" * 78)
try:
    import gseapy
    print("gseapy AVAILABLE:", gseapy.__version__)
    HAVE_GSEAPY = True
except Exception:
    print("gseapy NOT available")
    HAVE_GSEAPY = False

results = {}

# ------------------------------------------------------------------ STEP 1
print("\n" + "=" * 78)
print("STEP 1 - load data, map groups, ENSG -> symbol")
print("=" * 78)
counts = pd.read_csv("data/counts_raw_unfiltered.csv", index_col=0)
layout = pd.read_csv("data/sample_layout.csv")
mapping = pd.read_csv("data/ensg_to_gene_name.tsv", sep="\t")
layout["col"] = layout["SampleID"].str.replace("-", "_")

treat_group = "Cisplatin_IC50_CBD_IC50"
ctrl_group = "DMSO"
cols = (layout[layout["Group"].isin([ctrl_group, treat_group])]
        .set_index("col")["Group"].sort_index())
cm = counts[cols.index].astype(int)
cm = cm[cm.sum(axis=1) > 0]
print("comparison columns:", list(cols.index))
print("genes with total count>0 in the 6 samples:", cm.shape[0])

X = cm.values.astype(float)
grp = np.array([0 if cols.iloc[i] == ctrl_group else 1 for i in range(len(cols))])

# ------------------------------------------------------------------ STEP 2
print("\n" + "=" * 78)
print("STEP 2 - size factors (DESeq2 median-of-ratios, exact formula)")
print("=" * 78)
with np.errstate(divide="ignore"):
    lc = np.log(X)
loggeomeans = np.where(np.isfinite(lc).all(axis=1), lc.mean(axis=1), np.nan)
use = np.isfinite(loggeomeans)
logratios = lc[use] - loggeomeans[use][:, None]
sizefactors = np.exp(np.median(logratios, axis=0))
print("size factors:", np.round(sizefactors, 4))
normX = X / sizefactors[None, :]
baseMean = normX.mean(axis=1)

def nbinom_wald(X, s, grp, alpha_vec):
    """NB mean (per-group) + Wald test of log(c1/c0)."""
    n = X.shape[0]
    lfc = np.zeros(n); pv = np.zeros(n); c_hat = np.zeros((n, 2))
    for i in range(n):
        y = X[i]
        c = np.array([y[grp == 0].sum() / s[grp == 0].sum(),
                      y[grp == 1].sum() / s[grp == 1].sum()], dtype=float)
        c[c <= 0] = 1e-6
        for g in (0, 1):
            idx = grp == g
            for _ in range(40):                      # Newton on NB score
                mu = s[idx] * c[g]
                sc = np.sum(s[idx] * (y[idx] - mu) / (1 + alpha_vec[i] * mu))
                der = -np.sum(s[idx] ** 2 / ((1 + alpha_vec[i] * mu) ** 2))
                step = sc / der
                c[g] = max(c[g] - step, 1e-6)
        c_hat[i] = c
        beta1 = np.log(c[1] / c[0])
        T0 = np.sum(s[grp == 0] / (1 + alpha_vec[i] * s[grp == 0] * c[0]))
        T1 = np.sum(s[grp == 1] / (1 + alpha_vec[i] * s[grp == 1] * c[1]))
        var_b = 1.0 / (c[0] * T0) + 1.0 / (c[1] * T1)
        z = beta1 / np.sqrt(var_b)
        pv[i] = 2 * (1 - stats.norm.cdf(abs(z)))
        lfc[i] = beta1 / np.log(2)
    return lfc, pv, c_hat

def moment_dispersion(X, s, grp):
    """Poisson-Pearson moment estimator (DESeq original style)."""
    n = X.shape[0]; n_s = X.shape[1]; p = 2
    c = np.array([X[:, grp == 0].sum(1) / s[grp == 0].sum(),
                  X[:, grp == 1].sum(1) / s[grp == 1].sum()]).T
    c[c <= 0] = 1e-6
    mu = s[None, :] * c[:, grp]
    pearson = np.sum((X - mu) ** 2 / mu, axis=1)
    alpha = np.clip((pearson - (n_s - p)) / np.sum(mu ** 2, axis=1), 1e-8, None)
    return alpha

def trend_dispersion(alpha, baseMean):
    """DESeq2-like trended dispersion: local median of log-disp vs log-mean."""
    ok = np.isfinite(alpha) & (baseMean > 0)
    am = alpha[ok]; bm = baseMean[ok]
    qs = np.quantile(bm, np.linspace(0.05, 0.95, 30))
    med = np.array([np.median(am[(bm >= lo) & (bm < hi)])
                    for lo, hi in zip(qs[:-1], qs[1:])])
    xs = np.sqrt(qs[:-1]); ys = np.log10(med)
    f = interp1d(xs, ys, bounds_error=False,
                 fill_value=(ys[0], ys[-1]))
    fitted_log10 = f(np.sqrt(bm))
    out = np.full_like(alpha, np.nan)
    out[ok] = 10 ** fitted_log10
    return out

# ------------------------------------------------------------------ STEP 3
print("\n" + "=" * 78)
print("STEP 3 - DE: two dispersion modes (moment vs trended) + NB Wald + BH")
print("=" * 78)
alpha_mom = moment_dispersion(X, sizefactors, grp)
alpha_trend = trend_dispersion(alpha_mom, baseMean)

def run_de(alpha_mode):
    lfc, pvals, _ = nbinom_wald(X, sizefactors, grp, alpha_mode)
    padj = multipletests(pvals, method="fdr_bh")[1]
    r = pd.DataFrame({"gene": cm.index, "baseMean": baseMean,
                      "log2FoldChange": lfc, "pvalue": pvals,
                      "padj": padj, "dispersion": alpha_mode})
    r["symbol"] = r["gene"].map(dict(zip(mapping["ENSG"], mapping["gene_name"])))
    return r

resM = run_de(alpha_mom)
resT = run_de(alpha_trend)
print("dispersion median (moment):", np.round(np.median(alpha_mom), 5),
      "| (trended):", np.round(np.nanmedian(alpha_trend), 5))
print("padj<0.05 -> moment:", int((resM.padj < 0.05).sum()),
      "trended:", int((resT.padj < 0.05).sum()))

def deg_table(r):
    d = r[(r.padj < 0.05) & (r.log2FoldChange.abs() > 0.5) & (r.baseMean > 10)].copy()
    return d

degM, degT = deg_table(resM), deg_table(resT)
print("DEG (padj<.05 & |lfc|>.5 & baseMean>10) -> moment:", len(degM),
      "trended:", len(degT))

# ------------------------------------------------------------------ STEP 5
print("\n" + "=" * 78)
print("STEP 5 - ORA (Enrichr/Fisher exact) | Reactome_2022 target term")
print("=" * 78)
universe_syms = set(resM["symbol"].dropna().unique())
N_univ = len(universe_syms)
print("universe proxy (distinct symbols, 6-sample matrix):", N_univ)

# official library availability flag
found_lib = False
for loc in ["reactome_2022.gmt", "Reactome_2022.gmt", "data/Reactome_2022.gmt",
            "/tmp/Reactome_2022.gmt"]:
    import os
    if os.path.exists(loc):
        found_lib = True
if not HAVE_GSEAPY and not found_lib:
    print("WARNING: Reactome_2022 library NOT available offline. The "
          "canonical gseapy/Enrichr OR CANNOT be reproduced. Best-effort "
          "reconstruction below is approximate and for audit only.")
results["reactome_library_available_offline"] = bool(found_lib or HAVE_GSEAPY)

# best-effort reconstruction of Reactome_2022 'p53-Dependent G1 DNA Damage
# Response' (R-HSA-69541). Manual reconstruction from documented Reactome
# content - NOT the official Enrichr membership (offline constraint).
p53_pathway = [
    "ATM", "ATR", "CHEK1", "CHEK2", "TP53", "MDM2", "MDM4", "RPS27L",
    "CDKN1A", "GADD45A", "SFN", "PCNA", "CCNE1", "CCNE2", "CDK2", "RB1",
    "CUL1", "SKP1", "SKP2", "E2F1", "E2F2", "E2F3", "FBXO5", "TP53INP1",
]
k_path = len(p53_pathway)

def fisher_odds_ratio(x, n, k, N):
    a, b, c, d = x, n - x, k - x, N - n - k + x
    orr, pf = stats.fisher_exact([[a, b], [c, d]], alternative="two-sided")
    return orr, pf, (a, b, c, d)

def eval_ora(deg):
    syms = set(deg["symbol"].dropna().unique())
    n = len(syms & universe_syms)
    overlap = sorted(syms & set(p53_pathway))
    x = len(overlap)
    orr, pf, tbl = fisher_odds_ratio(x, n, k_path, N_univ)
    return dict(n=n, x=x, overlap=overlap, orr=orr, pf=pf,
                table=tbl, n_up=int((deg.log2FoldChange > 0).sum()),
                n_down=int((deg.log2FoldChange < 0).sum()))

for name, d in [("moment", degM), ("trended", degT)]:
    o = eval_ora(d)
    print(f"\n[{name} dispersion] DEG={len(d)} (up {o['n_up']}/down {o['n_down']}); "
          f"n={o['n']}, k(recon)={k_path}, x={o['x']}, N={N_univ}")
    print(f"   overlap: {o['overlap']}")
    print(f"   Fisher OR approx = {o['orr']:.4f}  (p={o['pf']:.4g})")
    results[f"ora_{name}"] = o

# final reported values (trended dispersion = closer to DESeq2 defaults)
final = results["ora_trended"]
results["term"] = "p53-Dependent G1 DNA Damage Response (R-HSA-69541)"
results["term_confirmed_offline_library"] = False
results["n_deg_trended"] = len(degT)
results["n_deg_moment"] = len(degM)
results["fisher_odds_ratio_approx"] = float(final["orr"])
results["fisher_p_approx"] = float(final["pf"])

# ------------------------------------------------------------------ STEP 6
print("\n" + "=" * 78)
print("STEP 6 - outputs")
print("=" * 78)
degT = degT.sort_values("padj")
print("DEG table head (trended):")
print(degT.head(15).to_string())
results["deg_symbols"] = sorted(degT["symbol"].dropna().unique())
lines = [f"{k}: {v}" for k, v in results.items() if k != "deg_symbols"]
with open("results_summary.txt", "w") as fh:
    fh.write("\n".join(lines))
    fh.write(f"\n\ndeg_symbols ({len(results['deg_symbols'])}):\n")
    fh.write("\n".join(results["deg_symbols"]))
print("wrote results_summary.txt; DEG symbols:", len(results["deg_symbols"]))
print("\nKEY:", {k: results[k] for k in results if k not in ("deg_symbols", "ora_moment", "ora_trended")})
