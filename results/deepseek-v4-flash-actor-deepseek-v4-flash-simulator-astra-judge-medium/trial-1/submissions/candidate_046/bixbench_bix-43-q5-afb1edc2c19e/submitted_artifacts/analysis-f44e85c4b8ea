def nb_nll(alpha,y,mu):
    if alpha<=0: return 1e12
    return -stats.nbinom.logpmf(y,1.0/alpha,1.0/(1.0+alpha*mu)).sum()
log("gene-wise dispersion MLE ..."); t0=time.time()
alpha_mle=np.zeros(n)
for i in range(n):
    try:
        rr=optimize.minimize_scalar(nb_nll,bounds=(1e-8,1e2),method='bounded',args=(K[i],mu_sat[i]))
        alpha_mle[i]=rr.x
    except Exception: alpha_mle[i]=0.05
log(f"  done {time.time()-t0:.1f}s med={np.median(alpha_mle):.3g}")
# dispersion trend: robust linear fit log10(alpha)~log10(mu) on robust subset (OLS, no IRLS loop)
ok=(baseMean>1)&(alpha_mle>1e-8)
xt=np.log10(baseMean[ok]); yt=np.log10(alpha_mle[ok])
lo,hi=np.percentile(xt,[5,95])
sel=(xt>=lo)&(xt<=hi)
coef=np.polyfit(xt[sel],yt[sel],1)
resid=yt[sel]-(coef[0]+coef[1]*xt[sel])
s=np.median(np.abs(resid-np.median(resid)))*1.4826+1e-6
wts=np.clip(1.4826*s/np.maximum(np.abs(resid),1e-9),0,1)
coef=np.polyfit(xt[sel],yt[sel],1,w=wts)
alpha_tr=10.0**(coef[0]+coef[1]*np.log10(baseMean))
