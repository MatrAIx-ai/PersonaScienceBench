resid_log=np.log(alpha_mle[ok])-np.log(alpha_tr[ok])
pv=max(np.var(resid_log),1e-4)
log(f"dispersion prior var(log): {pv:.4f}")
def map_nll(alpha,y,mu,tr,pvv):
    if alpha<=0: return 1e12
    ll=stats.nbinom.logpmf(y,1.0/alpha,1.0/(1.0+alpha*mu)).sum()
    return -(ll-0.5*(math.log(alpha)-math.log(tr))**2/pvv)
def est_map(y,mu,tr,pvv):
    lo=np.clip(tr*0.01,1e-8,1e1)
    rr=optimize.minimize_scalar(map_nll,bounds=(lo,1e2),method='bounded',args=(y,mu,tr,pvv))
    return max(rr.x,1e-8) if np.isfinite(rr.x) else tr
alpha_maps=np.array([est_map(K[i],mu_sat[i],alpha_tr[i],pv) for i in range(n)])
alpha_fin=np.where(alpha_mle<alpha_tr,alpha_mle,alpha_maps).clip(1e-8,1e2)
log(f"median final dispersion: {np.median(alpha_fin):.3g}")
def group_mle(y,sf,alpha):
    """profile MLE of group mean q (NB, known alpha). Returns q and SE_log2(q)."""
    tot=y.sum()
    if tot==0: return 1e-7, 2633.0   # boundary floor -> huge SE -> not significant
    def nll(t):
        q=math.exp(t)
        mu=sf*q
        return -stats.nbinom.logpmf(y,1.0/alpha,1.0/(1.0+alpha*mu)).sum()
    # bounds on t from method-of-moments guess
    q0=tot/sf.sum()
    lo=math.log(max(q0*1e-4,1e-12)); hi=math.log(max(q0*1e4,1e2))
    lo=max(lo,-40); hi=min(hi,40)
    rr=optimize.minimize_scalar(nll,bounds=(lo,hi),method='bounded')
    q=math.exp(rr.x)
    mu=sf*q
    I=(mu/(1.0+alpha*mu)).sum()      # observed Fisher info (natural-log scale)
    se_log2=1.0/(math.log(2.0)*math.sqrt(max(I,1e-12)))
    return q,se_log2
