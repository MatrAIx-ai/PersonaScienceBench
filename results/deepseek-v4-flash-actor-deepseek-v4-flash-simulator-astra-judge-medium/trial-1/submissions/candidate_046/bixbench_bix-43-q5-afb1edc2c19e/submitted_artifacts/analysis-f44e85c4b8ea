def ora_hypergeometric(gene_list,gmt):
    n_=len(gene_list); iset=set(gene_list)
    univ=set().union(*[set(v) for v in gmt.values()]) if gmt else set()
    N_=len(univ); rows=[]
    for term,genes in gmt.items():
        gu=set(genes)&univ; K_=len(gu); k=len(gu&iset)
        if K_==0 or k==0: continue
        p=stats.hypergeom.sf(k-1,N_,K_,n_)
        try: or_=stats.fisher_exact([[k,K_-k],[n_-k,N_-K_-n_+k]],alternative='greater')[0]
        except Exception: or_=np.nan
        mu=n_*K_/N_; var=n_*K_*(N_-K_)*(N_-n_)/(N_**2*(N_-1))
        zz=(k-mu)/np.sqrt(var) if var>0 else 0.0
        cs=math.log(p)*zz if p>0 else -1000*zz
        rows.append({'Term':term,'Overlap':f"{k}/{K_}",'P-value':p,'Adjusted P-value':p,
                     'Odds Ratio':or_,'Combined Score':cs,'Genes':";".join(sorted(gu&iset))})
    if not rows: return pd.DataFrame()
    out=pd.DataFrame(rows); pv=out['P-value'].values; nt=len(pv); order=np.argsort(pv)
    bh=np.minimum.accumulate(np.minimum(pv[order]*nt/np.arange(1,nt+1),1.0))
    bho=np.empty(nt); bho[order]=bh; out['Adjusted P-value']=bho
    return out.sort_values('Adjusted P-value').reset_index(drop=True)
def parse_gmt(text):
    gmt={}
    for line in text.splitlines():
        if not line.strip(): continue
        p=line.rstrip('\r\n').split('\t')
        if len(p)<3: continue
        gmt[p[0]]=set(g.upper() for g in p[2:] if g.strip())
    return gmt
