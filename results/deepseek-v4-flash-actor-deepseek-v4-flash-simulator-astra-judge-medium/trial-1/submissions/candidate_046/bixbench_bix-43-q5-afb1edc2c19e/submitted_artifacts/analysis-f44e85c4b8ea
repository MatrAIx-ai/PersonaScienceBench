def contrast(idx_grp, name):
    """idx_grp: dict group->col indices; returns DataFrame with lfc and pvalue vs first group."""
    g0,gn = name
    c0=idx_grp[g0]; cn=idx_grp[gn]
    lfc=np.empty(n); se=np.empty(n); pv=np.empty(n)
    for i in range(n):
        q0,s0=group_mle(K[i,c0],SF[c0],alpha_fin[i])
        qn,sn=group_mle(K[i,cn],SF[cn],alpha_fin[i])
        lf=math.log2(qn)-math.log2(q0)
        sev=math.hypot(s0,sn)
        lfc[i]=lf; se[i]=sev; pv[i]=2*stats.norm.sf(abs(lf/sev))
    return lfc,se,pv
