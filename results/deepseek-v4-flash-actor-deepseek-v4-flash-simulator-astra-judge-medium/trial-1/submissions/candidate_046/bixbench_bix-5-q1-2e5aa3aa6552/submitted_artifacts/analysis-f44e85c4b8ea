"""
DESeq2-style differential expression (pure Python implementation)
BixBench bix-5-q1 — Issy ASXL1 fibroblast counts, disease vs control.

Design: ~ sex + condition (disease vs control); sensitivity: ~ condition.
Method: DESeq2-style:
  1) prefilter total counts >= 10 (across the 14 annotated samples)
  2) median-of-ratios size factors
  3) per-gene dispersion by Cox-Reid adjusted NB profile likelihood (grid + refine)
  4) empirical-Bayes shrinkage toward a trend (disp ~ 1/mean)
  5) NB GLM (IRLS, log link, offset=size factors) + Wald test
  6) BH/FDR multiple-testing correction
"""
import numpy as np
import pandas as pd
from scipy import special, stats
from statsmodels.stats.multitest import multipletests
import time, json

t_start = time.time()
rng = np.random.default_rng(0)

# ------------------------------------------------------------------ utils
def nb_loglik(Y, mu, alpha):
    """Per-gene NB log-likelihood, y & mu shape (G,n), alpha scalar."""
    t = 1.0 / alpha
    a = special.gammaln(Y + t) - special.gammaln(t) - special.gammaln(Y + 1.0)
    b = -t * np.log1p(alpha * mu) + Y * (np.log(alpha * mu) - np.log1p(alpha * mu))
    return (a + b).sum(axis=-1)

def fit_nb_glm(Y, X, offset, alpha, beta0=None, maxit=80, tol=1e-8, ridge=1e-8):
    """Vectorized NB GLM (log link) with offset. Y:(G,n), X:(n,p).
    alpha may be scalar or per-gene vector of length G."""
    G = Y.shape[0]
    p = X.shape[1]
    alpha_v = np.broadcast_to(np.atleast_1d(np.asarray(alpha, dtype=float))[:, None], (G, 1))
    if beta0 is None:
        beta = np.zeros((G, p))
    else:
        beta = beta0.copy()
    Xe = X[None, :, :]                      # (1,n,p)
    Xouter = (Xe[:, :, :, None] * Xe[:, :, None, :])   # (1,n,p,p)
    eta = offset[None, :] + np.einsum('np,gp->gn', X, beta)
    mu = np.exp(np.clip(eta, -40.0, 40.0))
    converged = np.zeros(G, dtype=bool)
    BMAX = 25.0   # bounded-MLE cap (natural-log fold change); avoids overflow/NaN for separated genes
    for it in range(maxit):
        w = mu / (1.0 + alpha_v * mu)
        w = np.clip(w, 1e-12, None)
        z = eta + (Y - mu) / np.clip(mu, 1e-12, None) - offset[None, :]   # working response minus offset
        XtWX = (w[:, :, None, None] * Xouter).sum(axis=1)                # (G,p,p)
        d = np.arange(p)
        XtWX[:, d, d] += ridge
        XtWz = (w[:, :, None] * z[:, :, None] * X[None, :, :]).sum(axis=1)  # (G,p)
        beta_new = np.linalg.solve(XtWX, XtWz[:, :, None])[:, :, 0]      # (G,p)
        if beta0 is None:
            beta_new = np.clip(beta_new, -BMAX, BMAX)                    # cap non-intercept too (all cols here)
        eta_new = offset[None, :] + np.einsum('np,gp->gn', X, beta_new)
        delta = np.abs(eta_new - eta).max(axis=1)
        beta = beta_new
        eta = eta_new
        mu = np.exp(np.clip(eta, -40.0, 40.0))
        if it > 2:
            ok = delta < tol
            converged[ok] = True
            if converged.all():
                break
    return beta, mu, XtWX, converged

def cr_profile(Y, X, offset, alpha, beta0=None):
    """Cox-Reid adjusted profile log-likelihood per gene at given alpha."""
    beta, mu, XtWX, conv = fit_nb_glm(Y, X, offset, alpha, beta0)
    l = nb_loglik(Y, mu, alpha)
    sign, logdet = np.linalg.slogdet(XtWX)
    return beta, mu, l - 0.5 * logdet, conv, beta

# ------------------------------------------------------------------ load
counts = pd.read_csv("data/Issy_ASXL1_fibro_featureCounts_GeneTable_final.txt", sep=r"\s+")
co = pd.read_excel("data/Issy_ASXL1_fibro_coldata_gender.xlsx")
samples = list(co["sample"])
mat = counts[samples].values.astype(float)
genes = counts["Geneid"].values
n = len(samples)

# prefilter
keep = mat.sum(axis=1) >= 10
matF, genesF = mat[keep], genes[keep]
G = matF.shape[0]
print(f"[data] {mat.shape[0]} genes -> {G} after total>=10 filter; {n} samples")

# designs
sexM = (co["sex"] == "M").values.astype(float)
condD = (co["condition"] == "disease").values.astype(float)
X_full = np.column_stack([np.ones(n), sexM, condD])
X_cond = np.column_stack([np.ones(n), condD])

# size factors (median of ratios)
lmat = np.log(matF)
use = (matF > 0).all(axis=1)
lgm = lmat[use].mean(axis=1)
sf = np.exp(np.median(lmat[use] - lgm[:, None], axis=0))
sf = sf / np.exp(np.mean(np.log(sf)))
offset = np.log(sf)
print(f"[norm] size factors (geom-mean 1), range {sf.min():.3f}..{sf.max():.3f}")

baseMean = (matF / sf[None, :]).mean(axis=1)   # mean normalized count per gene

# ------------------------------------------------------------------ dispersion grid
alphas = np.logspace(-4, 2.0, 25)   # 1e-4 .. 100
CR = np.full((G, len(alphas)), -np.inf)
beta_grid = np.zeros((G, X_full.shape[1]))
beta0 = None
for i, a in enumerate(alphas):
    beta_grid, _, cr, _, _ = cr_profile(matF, X_full, offset, a, beta0)
    CR[:, i] = cr
    beta0 = beta_grid  # warm start
CR[~np.isfinite(CR)] = -np.inf
best = CR.argmax(axis=1)
dispMLE = alphas[best]
# parabolic refine around best grid index
for k in range(G):
    b = best[k]
    if 0 < b < len(alphas) - 1:
        x0, x1, x2 = np.log(alphas[b-1]), np.log(alphas[b]), np.log(alphas[b+1])
        y0, y1, y2 = CR[k, b-1], CR[k, b], CR[k, b+1]
        denom = (y0 - 2*y1 + y2)
        if abs(denom) > 1e-12:
            delta = 0.5 * (y0 - y2) / denom
            dispMLE[k] = np.exp(x1 + np.clip(delta, -0.5, 0.5) * (x2 - x0))
print(f"[disp] grid done; dispMLE range {dispMLE.min():.3e}..{dispMLE.max():.2f}, "
      f"median {np.median(dispMLE):.3f}")

# ------------------------------------------------------------------ trend (DESeq2 parametric-ish: log disp ~ a0 + a1/mean)
x = np.log10(np.clip(baseMean, 1e-6, None))
y = np.log10(np.clip(dispMLE, 1e-6, None))
nbin = 40
bins = np.linspace(x.min() if np.isfinite(x.min()) else -3, np.log10(baseMean.max()) if np.isfinite(baseMean.max()) else 3, nbin+1)
idx = np.clip(np.digitize(x, bins[1:-1]), 0, nbin-1)
binx = np.full(nbin, np.nan); biny = np.full(nbin, np.nan); wgt = np.zeros(nbin)
for b in range(nbin):
    sel = idx == b
    if sel.sum() > 2:
        binx[b] = np.median(x[sel]); biny[b] = np.median(y[sel]); wgt[b] = sel.sum()
okb = np.isfinite(binx) & np.isfinite(biny)
p = np.polyfit(10**(-binx[okb]) / (np.max(10**(-binx[okb]))), biny[okb], 1, w=np.sqrt(wgt[okb]))
# we fit y = p[1] + p[0]*(1/mean_normalized_by_scale) with scale=max to keep coefficients sane
scale = np.max(10**(-binx[okb]))
trend_log10 = p[1] + p[0] * (10**(-x)) / scale
dispTrend = np.clip(10**trend_log10, 1e-8, None)
print(f"[trend] fitted a0={p[1]:.4f}, a1_scaled={p[0]:.4f} (log10 disp)")

# ------------------------------------------------------------------ empirical-Bayes shrinkage
resid = y - trend_log10
mad = np.median(np.abs(resid - np.median(resid))) * 1.4826
sig2_prior = max(mad**2, 1e-6)
df = n - X_full.shape[1]
w_prior = 1.0 / sig2_prior
w_lik = df / 2.0
logd_shrunk = (w_prior * trend_log10 + w_lik * y) / (w_prior + w_lik)
dispFinal = 10**logd_shrunk
dispFinal = np.maximum(dispFinal, dispTrend)   # DESeq2-style floor at the trend
print(f"[shrink] prior sd {np.sqrt(sig2_prior):.3f}; med dispFinal {np.median(dispFinal):.4f}")

np.save("/workspace/scripts/_disp_stage.npy",
        np.vstack([baseMean, dispMLE, dispTrend, dispFinal]))

# ------------------------------------------------------------------ final fit + Wald (full model)
betaF, muF, XtWXf, convF = fit_nb_glm(matF, X_full, offset, dispFinal, beta0=None, maxit=80)
cov = np.linalg.inv(XtWXf)                      # (G,p,p)
idx_d = X_full.shape[1] - 1
b_d = betaF[:, idx_d]
se_d = np.sqrt(cov[:, idx_d, idx_d])
se_d = np.clip(se_d, 1e-12, None)
log2FC = b_d / np.log(2.0)
lfcSE = se_d / np.log(2.0)
stat = b_d / se_d
pval = 2.0 * stats.norm.sf(np.abs(stat))
padj = multipletests(pval, method="fdr_bh")[1]
print("[wald full] beta_d range {:.3f}..{:.3f}; med se {:.4f}".format(b_d.min(), b_d.max(), np.median(se_d)))

# ------------------------------------------------------------------ sensitivity: condition-only
betaC, muC, XtWXc, convC = fit_nb_glm(matF, X_cond, offset, dispFinal, beta0=None, maxit=80)
covC = np.linalg.inv(XtWXc)
b_c = betaC[:, 1]; se_c = np.clip(np.sqrt(covC[:, 1, 1]), 1e-12, None)
log2FC_c = b_c / np.log(2.0); pval_c = 2.0 * stats.norm.sf(np.abs(b_c / se_c))
padj_c = multipletests(pval_c, method="fdr_bh")[1]

# ------------------------------------------------------------------ symbol mapping via HGNC (Ensembl no-version)
hgnc = pd.read_csv("data/HGNC_05-09-19.txt", sep="\t", dtype=str)
hgnc_map = (hgnc.dropna(subset=["Ensembl ID(supplied by Ensembl)"])
            .groupby(hgnc["Ensembl ID(supplied by Ensembl)"].str.strip())
            ["Approved symbol"].first())
g = pd.read_csv("data/gencode.v31.primary_assembly.genes.csv")
g["ens_no_ver"] = g["gene_id"].str.split(".").str[0]
symmap = dict(zip(g["ens_no_ver"], g["gene_name"]))
ens_nv = np.array([x.split(".")[0] for x in genesF])
symbols = pd.Series(ens_nv).map(symmap).values
hgnc_sym = pd.Series(ens_nv).map(hgnc_map).values

res = pd.DataFrame({
    "ensembl_id": genesF, "gene_name": symbols, "hgnc_symbol": hgnc_sym,
    "baseMean": baseMean, "dispersion": dispFinal,
    "log2FoldChange": log2FC, "lfcSE": lfcSE, "stat": stat, "pvalue": pval, "padj": padj,
    "log2FC_condOnly": log2FC_c, "pvalue_condOnly": pval_c, "padj_condOnly": padj_c,
})
res = res.sort_values("padj")
print("\n[summary] DE results table rows:", len(res))
print(res.head(15).to_string())

# ------------------------------------------------------------------ DEG counts
FDR = 0.05; LFC = 1.0
deg_full = res[(res["padj"] < FDR) & (res["log2FoldChange"].abs() >= LFC)]
deg_p_only = res[(res["padj"] < FDR)]
deg_up = deg_full[deg_full["log2FoldChange"] > 0]
deg_dn = deg_full[deg_full["log2FoldChange"] < 0]
deg_c = res[(res["padj_condOnly"] < FDR) & (res["log2FC_condOnly"].abs() >= LFC)]
print("\n[DEG counts]")
print(f"  full model  padj<0.05 & |log2FC|>=1 : {len(deg_full)}  (up {len(deg_up)}, down {len(deg_dn)})")
print(f"  full model  padj<0.05 (no LFC cut)  : {len(deg_p_only)}")
print(f"  cond-only   padj<0.05 & |log2FC|>=1 : {len(deg_c)}")
print(f"  overlap full vs cond-only DEGs: {len(set(deg_full.ensembl_id) & set(deg_c.ensembl_id))}")

res.to_csv("scripts/DE_results_full.csv", index=False)
deg_full.to_csv("scripts/DEGs_full_padj05_lfc1.csv", index=False)
deg_p_only.to_csv("scripts/DEGs_full_padj05.csv", index=False)
deg_c.to_csv("scripts/DEGs_condOnly_padj05_lfc1.csv", index=False)

json.dump({
    "n_total_genes": int(mat.shape[0]), "n_after_filter": int(G),
    "size_factor_range": [float(sf.min()), float(sf.max())],
    "n_deg_full_padj05_lfc1": int(len(deg_full)),
    "n_deg_up": int(len(deg_up)), "n_deg_down": int(len(deg_dn)),
    "n_deg_full_padj05": int(len(deg_p_only)),
    "n_deg_condOnly_padj05_lfc1": int(len(deg_c)),
    "runtime_sec": round(time.time() - t_start, 1),
}, open("scripts/DE_summary.json", "w"), indent=2)
print("\n[save] tables written; runtime %.1f s" % (time.time() - t_start))
