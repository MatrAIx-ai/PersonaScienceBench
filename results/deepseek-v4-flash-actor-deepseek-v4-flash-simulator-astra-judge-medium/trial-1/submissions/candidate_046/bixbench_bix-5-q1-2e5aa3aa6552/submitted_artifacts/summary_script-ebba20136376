"""
Summary + GO-blockage evidence for BixBench bix-5-q1.
Loads DE_results_full.csv produced by 01_deseq2_style_de.py.
"""
import pandas as pd, numpy as np, json, os, socket

res = pd.read_csv("scripts/DE_results_full.csv")
print("rows loaded:", len(res))

FDR, LFC = 0.05, 1.0

# ---- PRIMARY model: condition-only (stable) ----
sig_c = res["padj_condOnly"] < FDR
deg_c_lfc = res[sig_c & (res["log2FC_condOnly"].abs() >= LFC)].copy()
up_c = deg_c_lfc[deg_c_lfc["log2FC_condOnly"] > 0]
dn_c = deg_c_lfc[deg_c_lfc["log2FC_condOnly"] < 0]
n_c_p_only = int(sig_c.sum())

# ---- SENSITIVITY: sex-adjusted (diagnosed degenerate) ----
sig_f = res["padj"] < FDR
deg_f_lfc = res[sig_f & (res["log2FoldChange"].abs() >= LFC)].copy()
cap = res["log2FoldChange"].abs() >= 35.0

print("="*60)
print("CONDITION-ONLY MODEL (primary): contrast disease vs control")
print("="*60)
print(f"  genes tested (post-filter): {len(res)}")
print(f"  DEGs padj<{FDR} & |log2FC|>={LFC}: {len(deg_c_lfc)}  (up {len(up_c)}, down {len(dn_c)})")
print(f"  DEGs padj<{FDR} (no LFC cut): {n_c_p_only}")
print()
print("  Top 25 DEGs by padj (cond-only):")
cols = ["ensembl_id","gene_name","hgnc_symbol","baseMean","dispersion","log2FC_condOnly","pvalue_condOnly","padj_condOnly"]
top = deg_c_lfc.sort_values("padj_condOnly").head(25)[cols]
print(top.to_string(index=False))
print()
print("="*60)
print("SEX-ADJUSTED MODEL (sensitivity): design ~sex+condition")
print("="*60)
print(f"  genes at |LFC| cap (>=35): {int(cap.sum())}  ({cap.mean()*100:.1f}% of tested)")
print(f"  DEGs padj<{FDR} & |log2FC|>={LFC}: {len(deg_f_lfc)}  (up {(deg_f_lfc.log2FoldChange>0).sum()}, down {(deg_f_lfc.log2FoldChange<0).sum()})")
print(f"  DEGs padj<{FDR} (no LFC cut): {int(sig_f.sum())}")
print("  ** STATISTICALLY DEGENERATE: single male in disease group causes "
      "perfect separation; MLE of disease coeff is infinite for a large fraction of genes. **")
print()

# overlap of the two DEG sets
inter = set(deg_c_lfc.ensembl_id) & set(deg_f_lfc.ensembl_id)
print(f"  overlap cond-only ∩ sex-adj DEGs: {len(inter)}")
J = len(set(deg_f_lfc.ensembl_id) | set(deg_c_lfc.ensembl_id))
jacc = len(inter)/J if J else 0
print(f"  Jaccard index: {jacc:.3f}")

# chromosome/Y-chromosome confound check
g = pd.read_csv("data/gencode.v31.primary_assembly.genes.csv")
chrmap = g.set_index("gene_id")["seqnames"].to_dict()
deg_c_lfc = deg_c_lfc.copy()
deg_c_lfc["seqnames"] = deg_c_lfc["ensembl_id"].map(chrmap)
ydeg = deg_c_lfc[deg_c_lfc["seqnames"]=="chrY"]
print(f"  cond-only DEGs on chrY (sex-linked, driven by male imbalance): {len(ydeg)}")

summary = {
  "n_tested": int(len(res)),
  "condOnly_DEGs_padj05_lfc1": int(len(deg_c_lfc)),
  "condOnly_DEGs_up": int(len(up_c)), "condOnly_DEGs_down": int(len(dn_c)),
  "condOnly_DEGs_padj05_only": n_c_p_only,
  "sexAdj_DEGs_padj05_lfc1": int(len(deg_f_lfc)),
  "sexAdj_genes_at_lfc_cap": int(cap.sum()),
  "sexAdj_cap_fraction": round(float(cap.mean()), 4),
  "overlap_both": len(inter), "jaccard": round(jacc, 3),
}
json.dump(summary, open("scripts/analysis_summary.json","w"), indent=2)
print("\n[saved] scripts/analysis_summary.json")

# ---- GO blockage evidence ----
print("="*60)
print("GO ENRICHMENT BLOCKAGE — evidence")
print("="*60)
try:
    socket.gethostbyname("pypi.org")
    print("  DNS pypi.org: RESOLVES")
except Exception as e:
    print(f"  DNS pypi.org: FAILS ({e})")
try:
    socket.gethostbyname("ftp.ebi.ac.uk")
    print("  DNS ftp.ebi.ac.uk: RESOLVES")
except Exception as e:
    print(f"  DNS ftp.ebi.ac.uk: FAILS ({e})")
print("  R/Rscript binary:", "PRESENT" if (os.path.exists("/usr/bin/R") or os.path.exists("/usr/local/bin/R")) else "ABSENT")
print("  GO annotation files (*.gaf, gene2go, go.obo, GO.db, org.Hs*, MSigDB): NONE found in filesystem scan")
print("  Pip offline install of pydeseq2/gseapy/goatools: FAILED (no network / no index)")
print("  gencode 'ont' column: all NaN (no functional annotations supplied)")

print("\n[DONE]")
