"""
BixBench bix-51-q1 — Logistic regression: P(PR | Age) predicted at Age=65
Dataset: data/data.xlsx (Sheet1)
"""
import numpy as np
import pandas as pd
import statsmodels.api as sm
from scipy.special import expit

# ---------- 1. Load & clean ----------
df = pd.read_excel('data/data.xlsx', sheet_name='Sheet1')
age = pd.to_numeric(df['Age'].replace({' ': np.nan}), errors='coerce')
df['age_num'] = age

# 80 complete rows: Age present and Efficacy present (41 blank rows dropped)
d = df[df['age_num'].notna() & df['Efficacy'].notna()].copy()
d['PR'] = (d['Efficacy'] == 'PR').astype(int)
n = len(d)
n_pr = int(d['PR'].sum())

print(f"Usable rows: n={n} | PR={n_pr} | non-PR={n - n_pr} | PR rate={d['PR'].mean():.4f}")

# ---------- 2. Final logistic fit: Logit(P(PR)) = b0 + b1*Age ----------
X = sm.add_constant(d['age_num'])
model = sm.Logit(d['PR'], X)
res = model.fit(disp=True, maxiter=100)   # default IRLS (Newton); disp=True shows convergence

b0, b1 = res.params['const'], res.params['age_num']
se_b1 = res.bse['age_num']
p_b1 = res.pvalues['age_num']
ci_b1 = res.conf_int().loc['age_num']

print("\n=== Final fit: Logit(P(PR)) = b0 + b1*Age ===")
print(f"b0 (intercept) = {b0:.6f}")
print(f"b1 (Age)       = {b1:.6f}")
print(f"SE(b1)         = {se_b1:.6f}")
print(f"z = {res.tvalues['age_num']:.4f} | p-value(b1) = {p_b1:.5f}")
print(f"95% CI(b1)     = [{ci_b1[0]:.5f}, {ci_b1[1]:.5f}]")
print(f"Pseudo R2 (McFadden) = {res.prsquared:.4f}")
print(f"LR p-value (model)   = {res.llr_pvalue:.5f}")
print(f"Converged (mle_retvals): {res.mle_retvals.get('converged')} | iterations={res.mle_retvals.get('iterations')}")

# ---------- 3. Prediction at Age = 65 ----------
age_range = (d['age_num'].min(), d['age_num'].max())
x65 = np.array([1.0, 65.0])
linpred65 = x65 @ res.params
p65 = expit(linpred65)
print(f"\nAge range observed = [{age_range[0]}, {age_range[1]}]  -> Age 65 inside range: {age_range[0] <= 65 <= age_range[1]}")
print(f"Linear predictor at 65 = b0 + b1*65 = {linpred65:.6f}")
print(f"P(PR | Age=65) full             = {p65:.10f}")
print(f"P(PR | Age=65) rounded 3 dec    = {p65:.3f}")
print(f"P(PR | Age=65) rounded 2 dec    = {p65:.2f}")

# 95% CI on probability via delta method (optional support)
from statsmodels.stats.proportion import proportion_confint
# Wald on linear predictor
se_lp = np.sqrt(x65 @ res.cov_params() @ x65)
print(f"95% CI (linear predictor) = [{linpred65-1.96*se_lp:.4f}, {linpred65+1.96*se_lp:.4f}]")
print(f"95% CI (probability, delta) = [{expit(linpred65-1.96*se_lp):.4f}, {expit(linpred65+1.96*se_lp):.4f}]")

# ---------- 4. Validity checks ----------
print("\n=== Validity check A: outcome (PR) distribution by age band ===")
bins = [39, 49, 59, 69, 76]
labels = ['40-49', '50-59', '60-69', '70-75']
d['age_band'] = pd.cut(d['age_num'], bins=bins, labels=labels, right=False)
tab = d.groupby('age_band', observed=True).agg(n=('PR', 'size'), PR=('PR', 'sum'))
tab['PR_rate'] = (tab['PR'] / tab['n']).round(3)
print(tab)

print("\n=== Validity check B: complete separation by Age? ===")
# If Age perfectly separated PR/non-PR we'd see monotone disjoint ranges; check overlap of age distributions
pr_age = d.loc[d['PR'] == 1, 'age_num']
np_age = d.loc[d['PR'] == 0, 'age_num']
print(f"PR group     age: min={pr_age.min()}, max={pr_age.max()}, n={len(pr_age)}")
print(f"non-PR group age: min={np_age.min()}, max={np_age.max()}, n={len(np_age)}")
print(f"Age ranges overlap: {pr_age.min() <= np_age.max() and np_age.min() <= pr_age.max()} "
      f"(-> no complete/quasi separation by Age alone if overlap)")
print(f"Unique Age values where both PR and non-PR co-occur: "
      f"{int(d.groupby('age_num')['PR'].nunique().gt(1).sum())} of {d['age_num'].nunique()} distinct ages")

# Also report Hosmer-Lemeshow-like sanity: observed vs fitted by decile of fitted prob
try:
    d['pHat'] = res.predict(X)
    d['decile'] = pd.qcut(d['pHat'], 10, duplicates='drop')
    hltab = d.groupby('decile', observed=True).agg(n=('PR','size'), obsPR=('PR','sum'), meanPHat=('pHat','mean'))
    hltab['expPR'] = (hltab['n']*hltab['meanPHat']).round(2)
    print("\n=== Observed vs expected PR by decile of fitted probability (sanity) ===")
    print(hltab)
except Exception as e:
    print("HL table skipped:", e)

print("\n=== Sample of fitted table (Age 40-75 step 5) ===")
agemesh = np.arange(40, 76, 5)
for a in agemesh:
    print(f"Age={a}: P(PR)={expit(res.params['const']+res.params['age_num']*a):.3f}")

print("\nDONE")
