"""BixBench bix-51-q2: AIC for logistic regression of treatment response (Efficacy PR) on BMI."""
import pandas as pd
import statsmodels.api as sm

df = pd.read_excel('data/data.xlsx', sheet_name='Sheet1')
# Complete-case: drop rows with missing Efficacy (these also have missing BMI)
sub = df[['Efficacy', 'BMI']].dropna()
y = (sub['Efficacy'] == 'PR').astype(int)   # PR=1, SD/PD=0
X = sm.add_constant(sub['BMI'])             # sole predictor + intercept
model = sm.Logit(y, X).fit(disp=0)

print("n used:", int(model.nobs))
print("PR events:", int(y.sum()), "non-PR:", int((y == 0).sum()))
print("log-likelihood:", model.llf)
print("k (intercept + BMI):", len(model.params))
print("AIC = -2*llf + 2*k =", model.aic)
print("coefficients:"); print(model.params)
print("p-values:"); print(model.pvalues)
