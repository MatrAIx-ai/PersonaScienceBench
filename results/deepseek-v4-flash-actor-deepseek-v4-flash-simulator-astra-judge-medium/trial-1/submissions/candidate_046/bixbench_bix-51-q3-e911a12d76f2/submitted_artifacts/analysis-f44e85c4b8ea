"""BixBench bix-51-q3 - FINAL: combined logistic regression: response ~ BMI + Age + Gender.
response = 1 if Efficacy == 'PR' else 0 (PD/SD; no CR present)
Gender reference: Female (treatment coding); n = 80 real records.
"""
import numpy as np, pandas as pd, statsmodels.api as sm
import statsmodels.formula.api as smf
from scipy.optimize import minimize
from scipy.special import expit
from scipy.stats import norm

out = []
def log(*a): out.append(" ".join(str(x) for x in a))

# ---- 1. Load & clean ----
df = pd.read_excel('data/data.xlsx', sheet_name='Sheet1')
df = df[df['Sequence number'].notna()].copy()               # drop 41 blank padding rows
df['Age_num'] = pd.to_numeric(df['Age'], errors='coerce')
df['response'] = (df['Efficacy'] == 'PR').astype(int)
assert df['BMI'].notna().all() and df['Age_num'].notna().all() and df['Gender'].notna().all()
n = len(df); n1 = int((df['response'] == 1).sum()); n0 = int((df['response'] == 0).sum())
log(f"n used = {n} (80 real records; 41 blank padding rows dropped)")
log(f"Binary response: response=1 if Efficacy=='PR' ({n1}), =0 if PD/SD ({n0}); no CR present")
log(f"Gender: levels {df['Gender'].unique().tolist()}, reference 'Female' (alphabetical treatment coding)")
log(f"Age {int(df['Age_num'].min())}-{int(df['Age_num'].max())} yrs, BMI {df['BMI'].min()}-{df['BMI'].max()}")

# ---- 2. Primary fit: statsmodels formula API (default treatment coding, Female ref) ----
m = smf.logit("response ~ BMI + Age_num + C(Gender)", data=df).fit(disp=0)
log("\n=== statsmodels smf.logit response ~ BMI + Age + C(Gender) ===")
log(m.summary().as_text())
tab = pd.DataFrame({'coef': m.params, 'std err': m.bse, 'z': m.tvalues,
                    'P>|z|': m.pvalues, '[0.025': m.conf_int()[0], '0.975]': m.conf_int()[1]})
log("\nCoefficient table:\n" + tab.to_string())

# ---- 3. Cross-check A: manual dummies (Male=1, Female=0) with sm.Logit ----
X = pd.DataFrame({'const': 1.0, 'BMI': df['BMI'], 'Age': df['Age_num'],
                  'Gender_Male': (df['Gender'] == 'Male').astype(float)})
y = df['response'].values
m2 = sm.Logit(y, X).fit(disp=0)
log("\nCross-check A sm.Logit (explicit dummies, Female ref) age p = "
    f"{m2.pvalues['Age']!r} -> {m2.pvalues['Age']:.10f}")

# ---- 4. Cross-check B: independent scipy MLE with exact Hessian (X'WX) ----
Xa = X.values
def nll(b):
    p = expit(Xa @ b); return -np.sum(y*np.log(p) + (1-y)*np.log(1-p))
res = minimize(nll, np.asarray(m2.params, dtype=float), method='Nelder-Mead',
               options={'xatol': 1e-14, 'fatol': 1e-14, 'maxiter': 20000})
p = expit(Xa @ res.x)
H = Xa.T @ np.diag(p*(1-p)) @ Xa
cov = np.linalg.inv(H); z = res.x/np.sqrt(np.diag(cov)); pv = 2*(1-norm.cdf(np.abs(z)))
log("\nCross-check B independent scipy MLE + exact Hessian:")
log(pd.DataFrame({'coef': res.x, 'se': np.sqrt(np.diag(cov)), 'z': z, 'p': pv},
                 index=['const','BMI','Age','Gender_Male']).round(10).to_string())
log(f"age p (scipy) = {pv[2]!r} -> {pv[2]:.10f}")

# ---- 5. Concordance & final ----
p_age = float(m.pvalues['Age_num'])
match_a = np.isclose(p_age, m2.pvalues['Age'], atol=1e-10)
match_b = np.isclose(p_age, pv[2], atol=1e-9)
log(f"\nConcordance: smf vs sm.Logit {'MATCH' if match_a else 'DIFFER'}; "
    f"smf vs scipy-MLE {'MATCH' if match_b else 'DIFFER'}")
log(f"FINAL: p-value for Age = {p_age!r}")
log(f"   decimal full  : {p_age:.10f}")
log(f"   formatted     : {p_age:.4f}")
log(f"   scientific    : {p_age:.4e}")
log(f"   odds ratio Age: {np.exp(m.params['Age_num']):.4f}")

report = "\n".join(out)
print(report)
with open('analysis/model_output.txt', 'w') as f: f.write(report)
print("\nSaved to analysis/model_output.txt")
