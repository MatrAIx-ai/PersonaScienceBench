#!/usr/bin/env python3
"""
BixBench bix-51-q4 — Logistic regression: remission ~ Age + BMI + Gender
Change in log-odds of remission per year increase in patient age.
"""
import numpy as np
import pandas as pd
import statsmodels.api as sm
import statsmodels.formula.api as smf

# ---------- 1. Load data ----------
df = pd.read_excel('data/data.xlsx', sheet_name='Sheet1')

# ---------- 2. Drop blank filler rows ----------
# 40 rows are entirely all-NaN; 1 row (index 120) holds only a whitespace ' ' in Age.
df['Age_str'] = df['Age'].astype('string')
df['Age_str'] = df['Age_str'].str.strip()
blanks = df[['Sequence number','Groups','Efficacy','Family history','ECOG-PS','Child-Pugh',
             'Chemotherapy experience','HBV infection','Gender','BMI','Toxic and side effect']].isna().all(axis=1)
df = df[~blanks].copy()
df = df[df['Age_str'].notna()].copy()   # removes the lone ' ' row
df = df.reset_index(drop=True)
n_raw = len(df)

# ---------- 3. Encode variables ----------
df['Age'] = pd.to_numeric(df['Age'], errors='coerce').astype(float)
df['BMI'] = df['BMI'].astype(float)
df['Gender_Male'] = (df['Gender'] == 'Male').astype(int)          # Male = 1, Female = 0 (Male reference == 0)
df['remission'] = (df['Efficacy'] == 'PR').astype(int)            # PR = remission (1), SD/PD = 0

# ---------- 4. Logistic regression (statsmodels) ----------
X = df[['Age', 'BMI', 'Gender_Male']].copy()
X['Gender_Female'] = 1 - X['Gender_Male']     # explicit dummy Female vs reference Male
X = X[['Age', 'BMI', 'Gender_Female']]
X = sm.add_constant(X, prepend=True)          # intercept
y = df['remission']

model = sm.Logit(y, X)
result = model.fit(disp=0)

# ---------- 5. Extract results ----------
params = result.params
se = result.bse
ci = result.conf_int(alpha=0.05)
pvals = result.pvalues
or_per_year = np.exp(params['Age'])

n = int(result.nobs)
n_rem = int(y.sum())
n_nonrem = int(n - n_rem)

# ---------- 6. Convergence / separation diagnostics ----------
conv = result.mle_retvals.get('converged', False)
conv_msg = "OK" if conv else "WARNING: did not converge"
warned = bool(result.mle_retvals.get('warnflag', 0))
# Separation check: extreme coefs / std errors
max_se = float(se.max())

print("=" * 70)
print("LOGISTIC REGRESSION  remission ~ Age + BMI + Gender")
print("=" * 70)
print(f"Definition: remission = (Efficacy == 'PR'); SD and PD = no remission")
print(f"Gender: reference category = Male (Female coded as 1)")
print(f"Rows used: n = {n}  |  remission = {n_rem}  |  non-remission = {n_nonrem}")
print(f"Baseline counts: PR={int((df.Efficacy=='PR').sum())}, SD={int((df.Efficacy=='SD').sum())}, PD={int((df.Efficacy=='PD').sum())}")
print()
print("Convergence:", conv_msg)
print("Optimization warnflag:", warned)
print("Max abs std error of params:", round(max_se, 6))
print("Model log-likelihood:", round(result.llf, 6), "| AIC:", round(result.aic, 6))
print()
table = pd.DataFrame({
    'coef (log-odds)': params,
    'SE': se,
    'z': result.tvalues,
    'p-value': pvals,
    '95% CI lower': ci[0],
    '95% CI upper': ci[1],
    'OR = exp(coef)': np.exp(params),
})
print("Coefficients (log-odds scale):")
print(table.round(6).to_string())
print()
print("=" * 70)
print(f"ANSWER: change in log-odds of remission per +1 year of age = {params['Age']:.4f}")
print(f"SE = {se['Age']:.4f} | 95% CI = [{ci[0]['Age']:.4f}, {ci[1]['Age']:.4f}]")
print(f"OR per year (exp) = {or_per_year:.4f}")
print("=" * 70)

# Save summary for record
result.save('/workspace/analysis/logit_result.pkl')
pd.DataFrame({'variable': X.columns, 'coef': params, 'se': se,
              'pvalue': pvals, 'ci_low': ci[0], 'ci_high': ci[1]}).to_csv(
    '/workspace/analysis/coefficients.csv', index=False)
print("\nArtifacts saved: logit_result.pkl, coefficients.csv")
