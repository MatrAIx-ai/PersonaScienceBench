"""
BixBench bix-51-q5: p-value for H0 that BMI is not associated with treatment response.

Plan (approved):
- Use the 80 complete-case observations from data/data.xlsx (Sheet1), no imputation.
- Response = 1 if Efficacy == 'PR' (equiv. Groups == 1), 0 otherwise (PD + SD).
- Primary model: unadjusted logistic regression  response ~ BMI  (statsmodels).
- Report Wald p-value for BMI coefficient (primary) + likelihood-ratio p-value (chi2 df=1
  vs intercept-only) as complement. Adjusted model included as sensitivity analysis.
"""
import pandas as pd
import numpy as np
import statsmodels.formula.api as smf
import statsmodels.api as sm

DATA = 'data/data.xlsx'

# ---------- 1. Load and clean ----------
df = pd.read_excel(DATA, sheet_name='Sheet1')
print('Raw rows x cols:', df.shape)

core = [c for c in df.columns if c != 'Toxic and side effect']
cc = df.dropna(subset=core).copy()
print('Complete-case rows (all core cols non-null):', len(cc))

# Confirm outcome coding is determined by data (Groups==1 <=> Efficacy==PR)
ct = pd.crosstab(cc['Groups'], cc['Efficacy'])
print('\nGroups x Efficacy crosstab:\n', ct)

# ---------- 2. Define binary response ----------
cc['response'] = (cc['Efficacy'] == 'PR').astype(int)
print('\nResponse class counts:', cc['response'].value_counts().sort_index().to_dict())
assert (cc['response'] == (cc['Groups'] == 1).astype(int)).all(), 'Groups coding mismatch!'

# BMI as continuous
cc['BMI'] = cc['BMI'].astype(float)
print('BMI summary:\n', cc['BMI'].describe().round(4))

# ---------- 3. Primary model: unadjusted ----------
X = sm.add_constant(cc['BMI'])
m1 = sm.Logit(cc['response'], X).fit(disp=False)
print('\n===== PRIMARY MODEL: response ~ BMI (unadjusted) =====')
print(m1.summary2().tables[1])

bmi_beta = m1.params['BMI']
bmi_se   = m1.bse['BMI']
wald_p   = m1.pvalues['BMI']
print(f'\nUnadjusted: BMI coeff = {bmi_beta:.6f}, SE = {bmi_se:.6f}, Wald p = {wald_p:.6e}')
print(f'            Wald p (4 sig): {wald_p:.4g}    (3 sig): {wald_p:.3g}')

# Likelihood-ratio test vs intercept-only model (chi2 df=1)
m0 = sm.Logit(cc['response'], sm.add_constant(pd.Series(1.0, index=cc.index))).fit(disp=False)
lr_stat = 2 * (m1.llf - m0.llf)
lr_df = m1.df_model - m0.df_model
from scipy import stats
lr_p = stats.chi2.sf(lr_stat, lr_df)
print(f'\nLR test: stat = {lr_stat:.6f}, df = {lr_df}, p = {lr_p:.6e}  (vs intercept-only)')

# Model fit summary
print(f'Log-likelihood full = {m1.llf:.4f}, null = {m0.llf:.4f}')
print(f'N = {int(m1.nobs)}')

# ---------- 4. Sensitivity: adjusted model ----------
age = pd.to_numeric(cc['Age'], errors='coerce')
adj = cc.copy()
adj['Age'] = age
# recode binary/categorical covariates
adj['Gender_Male'] = (adj['Gender'] == 'Male').astype(int)
adj['HBV_Yes'] = (adj['HBV infection'] == 'Yes').astype(int)
adj['FamHist_Yes'] = (adj['Family history'] == 'Yes').astype(int)
adj['ChemoExp_Yes'] = (adj['Chemotherapy experience'] == 'Yes').astype(int)
adj['ECOG_0_1'] = (adj['ECOG-PS'] == '0-1').astype(int)
adj['ChildPugh_A'] = (adj['Child-Pugh'] == 'A').astype(int)
adj['Toxic_Any'] = adj['Toxic and side effect'].notna().astype(int)

formula = ('response ~ BMI + Age + Gender_Male + HBV_Yes + FamHist_Yes + '
           'ChemoExp_Yes + ECOG_0_1 + ChildPugh_A + Toxic_Any')
ma = smf.logit(formula, data=adj).fit(disp=False)
print('\n===== SENSITIVITY MODEL: response ~ BMI + covariates =====')
wa = ma.pvalues['BMI']
print(f'Adjusted: BMI coeff = {ma.params["BMI"]:.6f}, SE = {ma.bse["BMI"]:.6f}, Wald p = {wa:.6e}')

# Save a compact results table
m1.summary2().tables[1].to_csv('analysis/primary_model_summary.csv')
print('\nSaved primary model summary -> analysis/primary_model_summary.csv')
print('DONE')
