"""Análisis definitivo: regresión logística simple de respuesta a camrelizumab ~ Age.
Epidemologia: bixbench bix-51-q8
Codificación (aprobada): Efficacy = PR (1, respondedor) vs SD+PD (0, no respondedor).
Predictor único: Age en años (40-75), no centrado/escalado.
Filas: 80 pacientes (filas Excel 2-81); se descarta la fila 122 (espacio suelto en Age)
y las columnas M:AJ (vacías).
"""
import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf

# --- 1. Carga y limpieza ---
raw = pd.read_excel('data/data.xlsx', sheet_name='Sheet1', header=0)  # header fila 1
# Eliminar filas totalmente vacías y la fila/ruido con solo espacio en Age
df = raw.dropna(how='all')
df = df[df['Age'].notna() & (df['Age'].astype(str).str.strip() != '')].copy()
df = df.reset_index(drop=True)

# Garantizar tipos
df['Age'] = df['Age'].astype(float)
df['Efficacy'] = df['Efficacy'].astype(str).str.strip()

# --- 2. Recodificación de la respuesta (ORR: PR = 1, SD/PD = 0) ---
df['response'] = np.where(df['Efficacy'] == 'PR', 1, 0)

print("=== Datos usados ===")
print("n filas:", len(df), "| rango Age:", df['Age'].min(), "-", df['Age'].max())
print("Efficacy:", df['Efficacy'].value_counts().to_dict())
print("response: 1=", int(df['response'].sum()), " 0=", int((1 - df['response']).sum()))

# --- 3. Modelo logístico simple: response ~ Age ---
model = smf.logit("response ~ Age", data=df).fit(disp=False, maxiter=200)
intercept = model.params['Intercept']
b_age = model.params['Age']
se_age = model.bse['Age']
p_age = model.pvalues['Age']
ci = model.conf_int().loc['Age']
n = int(model.nobs)

print("\n=== RESULTADO: logit(P(responder=1)) = b0 + b_age*Age ===")
print(f"n = {n}")
print(f"Intercepto  b0     = {intercept:.6f}")
print(f"Edad       b_age   = {b_age:.6f}")
print(f"SE(b_age)          = {se_age:.6f}")
print(f"z = {model.tvalues['Age']:.4f}")
print(f"p-valor(b_age)     = {p_age:.6e}")
print(f"IC95%(b_age)       = [{ci[0]:.6f}, {ci[1]:.6f}]")
print(f"Log-likelihood     = {model.llf:.4f}")
print(f"AIC                = {model.aic:.4f}")
print("\n=== Summary (tabla de coeficientes) ===")
print(model.summary2().tables[1])
