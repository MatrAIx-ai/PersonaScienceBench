#!/usr/bin/env python3
"""Final analysis: sites removed in Zebra Finch by filtering sites that do
not show >90% or <10% methylation.

Approved rule:
  - "site" = unique CpG position (Pos), n = 1140 in ZF.
  - a site "shows >90% or <10%" if at least ONE of its sample rows falls in
    (>90) or (<10).
  - a site is REMOVED if NONE of its samples falls in those ranges, i.e.
    min(MethylationPercentage) >= 10 AND max(MethylationPercentage) <= 90.
"""
import pandas as pd

FILE = "data/ZF_AgeRelated_CpG_noMT_Final.csv"
zf = pd.read_csv(FILE)
print(f"File: {FILE}")
print(f"Rows: {len(zf)} | Unique sites (Pos): {zf['Pos'].nunique()} | Samples: {zf['Sample'].nunique()}")

mp = zf['MethylationPercentage']
assert mp.notna().all(), "Unexpected NaN in MethylationPercentage"

# ---- 1) Definitive count under approved rule ----
g = zf.groupby('Pos')['MethylationPercentage']
site = pd.DataFrame({'min': g.min(), 'max': g.max()})
n_total = len(site)
removed = (site['min'] >= 10) & (site['max'] <= 90)   # no sample <10 and no sample >90
kept = ~removed
n_removed = int(removed.sum())
n_kept = int(kept.sum())
print(f"\n== 1) Definitive count (approved rule) ==")
print(f"Total sites: {n_total}")
print(f"Sites REMOVED (no sample <10 AND no sample >90): {n_removed}")
print(f"Sites KEPT (at least one sample <10 or >90): {n_kept}")
print(f"Checks: n_removed + n_kept = {n_removed + n_kept} == {n_total} : {n_removed + n_kept == n_total}")

# ---- 2) Boundary handling: values exactly at 10.0 or 90.0 ----
exact10 = (mp == 10.0).sum()
exact90 = (mp == 90.0).sum()
print(f"\n== 2) Boundary handling ==")
print(f"Rows with MethylationPercentage exactly 10.0: {exact10}")
print(f"Rows with MethylationPercentage exactly 90.0: {exact90}")
# A row exactly at 10 or 90 is NOT (<10) and NOT (>90) -> counts as non-showing.
strict_low = mp < 10
strict_high = mp > 90
# Confirm rule uses strict comparisons:
print(f"Rows with <10: {strict_low.sum()} | Rows with >90: {strict_high.sum()} | "
      f"Rows with 10<=mp<=90: {((mp>=10)&(mp<=90)).sum()}")
# Sites affected by exact-boundary rows:
sites_exact10 = set(zf.loc[exact10, 'Pos'])
sites_exact90 = set(zf.loc[exact90, 'Pos'])
print(f"Sites containing a row at exactly 10.0: {len(sites_exact10)}")
print(f"Sites containing a row at exactly 90.0: {len(sites_exact90)}")
# If a site has an exact-10 row, its min could be ==10; still fails min>=10? min>=10 includes 10,
# so such a site is still removed unless it has any <10. Verify with the strict-any rule:
anyL = g.min() < 10
anyH = g.max() > 90
print(f"Recheck with strict any-<10 / any->90 -> removed = {(~(anyL|anyH)).sum()} | "
      f"kept = {int((anyL|anyH).sum())}")
assert int((~(anyL | anyH)).sum()) == n_removed, "Boundary recheck mismatch"

# ---- 3) Consistency control: row-level filter then count surviving sites ----
rows_kept = zf[(mp < 10) | (mp > 90)]
kept_sites_from_rows = rows_kept['Pos'].nunique()
print(f"\n== 3) Consistency control (row-filter then count unique sites) ==")
print(f"Rows with <10 or >90 (kept rows): {len(rows_kept)}")
print(f"Unique sites remaining after dropping 10-90 rows: {kept_sites_from_rows}")
print(f"Sites removed by difference 1140 - kept = {n_total - kept_sites_from_rows}")
print(f"Matches site-level removed count ({n_removed}): {kept_sites_from_rows == n_kept}")

print(f"\n== ANSWER ==")
print(f"{n_removed} sites removed in Zebra Finch when filtering sites that do not show "
      f">90% or <10% methylation (file {FILE}; {n_total} total unique sites; "
      f"rule: a site is removed if none of its samples has <10% or >90% methylation).")
