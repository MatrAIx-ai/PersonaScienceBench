"""Sensitivity + fallback strengthening (bix-53-q3).
(1) Confirm no offline gseapy/Enrichr possible (reported separately).
(2) Expand pathway gene set grounding ONLY in the count matrix (presence +
    expression), incl. gene-family cluster blocks. (3) Sensitivity of the
    contributing-DGE count to filter relaxations."""
import pandas as pd, numpy as np

res = pd.read_csv('analysis/deseq2_results_v2.csv')
res = res.set_index('Ensembl')
K = pd.read_csv('data/count.csv').set_index('geneID')
sfs = np.load('analysis/size_factors.npy')
bm = (K / sfs[None,:]).mean(axis=1)
present = set(K.index)

# ---- core mapped set (present in matrix; baseMean>0 => real expressed gene) ----
core = {'ENSMUSG00000032350':'Gclc','ENSMUSG00000020422':'Gclm','ENSMUSG00000026688':'Gsr',
 'ENSMUSG00000024856':'Gpx1','ENSMUSG00000018339':'Gpx3','ENSMUSG00000021815':'Gpx4',
 'ENSMUSG00000073409':'Gpx6','ENSMUSG00000028671':'Gpx7','ENSMUSG00000027890':'Gstm4',
 'ENSMUSG00000032348':'Gsta4','ENSMUSG00000029844':'Gstk1','ENSMUSG00000025068':'Gsto1',
 'ENSMUSG00000025040':'Gsto2','ENSMUSG00000028540':'Mgst1','ENSMUSG00000029535':'Mgst2',
 'ENSMUSG00000028933':'Mgst3','ENSMUSG00000021555':'Glrx','ENSMUSG00000017607':'Glrx3',
 'ENSMUSG00000028689':'Prdx1','ENSMUSG00000005161':'Prdx2','ENSMUSG00000024997':'Prdx3',
 'ENSMUSG00000026701':'Prdx6','ENSMUSG00000031862':'Ggt1','ENSMUSG00000029401':'Ggct',
 'ENSMUSG00000020639':'Oplah'}
core = {e:s for e,s in core.items() if e in present}

# ---- cluster-block expansion: find ALL matrix IDs in recalled family ranges ----
ranges = {'Gstm(chr3)': ('ENSMUSG00000004050','ENSMUSG00000004080'),
          'Gstt(chr10)': ('ENSMUSG00000020020','ENSMUSG00000020060'),
          'Gstt2/4(chr10)': ('ENSMUSG00000029620','ENSMUSG00000029645'),
          'Gsta(chr9)': ('ENSMUSG00000021320','ENSMUSG00000021355'),
          'Gstp(chr9)': ('ENSMUSG00000026140','ENSMUSG00000026170'),
          'Gpx2(chr12)': ('ENSMUSG00000021000','ENSMUSG00000021090'),
          'Gpx8(chr13)': ('ENSMUSG00000021720','ENSMUSG00000021750'),
          'Prdx5(chr19)': ('ENSMUSG00000034640','ENSMUSG00000034680'),
          'Ggt(clust chr10)': ('ENSMUSG00000020600','ENSMUSG00000020630'),
          'Glrx5(chr12)': ('ENSMUSG00000014120','ENSMUSG00000014135'),
          'Glrx2(chr1)': ('ENSMUSG00000046040','ENSMUSG00000046055')}
found = {}
for family,(lo,hi) in ranges.items():
    m = [e for e in present if lo <= e <= hi]
    if m:
        found[family] = m
print("Cluster-block candidates found in matrix for recalled ranges:")
for f, m in found.items():
    print(f"  {f}: {len(m)} IDs e.g. {m[:6]}")

# expanded set = core + cluster-block candidates (present & expressed)
ids_in_family = set()
for f,m in found.items(): ids_in_family |= set(m)
expanded = set(core) | ids_in_family
expanded_expr = {e for e in expanded if bm[e] > 0}
print("\ncore (mapped, verified present):", len(core))
print("cluster-expanded:", len(expanded), "; expressed:", len(expanded_expr))

# ---- DGE filters ----
p05 = res['padj'] < 0.05
bm10 = res['baseMean'] > 10
lfc1 = res['log2FC_shrunken'].abs() > 1

def count(eset, label):
    d = res.index.isin(eset)
    full = int((p05 & bm10 & lfc1 & d).sum())
    print(f"\n[{label}] set size={len(eset)}")
    print(f"   FULL (padj<.05 & bm>10 & |lfc|>1): {full}")
    # relaxations
    print(f"   no |lfc|>1  (padj<.05 & bm>10)      : {int((p05 & bm10 & d).sum())}")
    print(f"   no baseMean (padj<.05 & |lfc|>1)    : {int((p05 & lfc1 & d).sum())}")
    print(f"   no padj     (bm>10 & |lfc|>1)       : {int((bm10 & lfc1 & d).sum())}")
    print(f"   only padj<.05                       : {int((p05 & d).sum())}")
    print("   members meeting full:", list(res.index[(p05&bm10&lfc1&d)]))

print("#"*70)
print("SENSITIVITY: contributing-DGE count vs gene-set/filter choices")
count(expanded_expr, "expanded expressed set")
count(core, "core verified set")
print("\n(whole-genome DGE counts for reference)")
print("  padj<.05 & bm>10 & |lfc|>1:", int((p05&bm10&lfc1).sum()),
      "| no |lfc|:", int((p05&bm10).sum()),
      "| no bm:", int((p05&lfc1).sum()),
      "| no padj:", int((bm10&lfc1).sum()))
