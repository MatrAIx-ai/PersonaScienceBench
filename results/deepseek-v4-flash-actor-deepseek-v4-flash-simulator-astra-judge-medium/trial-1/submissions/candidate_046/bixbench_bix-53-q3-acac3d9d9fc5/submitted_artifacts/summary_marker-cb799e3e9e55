"""bix-53-q3 final summary + explicit fallback marker (NOT gseapy output)."""
import pandas as pd, numpy as np
res = pd.read_csv('analysis/deseq2_results_v2.csv').set_index('Ensembl')
K = pd.read_csv('data/count.csv').set_index('geneID')
sfs = np.load('analysis/size_factors.npy'); bm = (K/sfs[None,:]).mean(axis=1)
present = set(K.index)
core = {  # Ensembl IDs present & expressed in the count matrix (verified locally)
 'ENSMUSG00000032350':'Gclc','ENSMUSG00000020422':'Gclm','ENSMUSG00000026688':'Gsr',
 'ENSMUSG00000024856':'Gpx1','ENSMUSG00000018339':'Gpx3','ENSMUSG00000021815':'Gpx4',
 'ENSMUSG00000073409':'Gpx6','ENSMUSG00000028671':'Gpx7','ENSMUSG00000027890':'Gstm4',
 'ENSMUSG00000032348':'Gsta4','ENSMUSG00000029844':'Gstk1','ENSMUSG00000025068':'Gsto1',
 'ENSMUSG00000025040':'Gsto2','ENSMUSG00000028540':'Mgst1','ENSMUSG00000029535':'Mgst2',
 'ENSMUSG00000028933':'Mgst3','ENSMUSG00000021555':'Glrx','ENSMUSG00000017607':'Glrx3',
 'ENSMUSG00000028689':'Prdx1','ENSMUSG00000005161':'Prdx2','ENSMUSG00000024997':'Prdx3',
 'ENSMUSG00000026701':'Prdx6','ENSMUSG00000031862':'Ggt1','ENSMUSG00000029401':'Ggct',
 'ENSMUSG00000020639':'Oplah'}
core = {e:s for e,s in core.items() if e in present and bm[e]>0}
p05=res['padj']<0.05; bm10=res['baseMean']>10; lfc1=res['log2FC_shrunken'].abs()>1
full = (p05&bm10&lfc1).values
dge_ids = set(res.index[full])
inter = [e for e in core if e in dge_ids]
near_lfc = [e for e in core if (p05.loc[e] and bm10.loc[e] and res.loc[e,'log2FC_shrunken'] not in [None]) and abs(res.loc[e,'log2FC_shrunken'])<=1]
sig_sub = [e for e in core if p05.loc[e] and bm10.loc[e]]
print("FALLBACK RESULT (gseapy/Enrichr NOT available - this is NOT gseapy output)")
print("="*66)
print(f"Verified pathway genes used (present+expressed in matrix): {len(core)}")
print(f"DGEs (padj<.05 & bm>10 & |shrunken lfc|>1) in pathway : {len(inter)}")
for e in inter: print(f"   - {e} ({core[e]}): baseMean={res.loc[e,'baseMean']:.1f}, "
                      f"lfc_shr={res.loc[e,'log2FC_shrunken']:.2f}, padj={res.loc[e,'padj']:.2e}")
print(f"\nSensitivity (verified set):")
print(f"   dropping |lfc|>1 (padj<.05 & bm>10)   -> {len(sig_sub)} pathway genes "
      f"(DE in expr but |lfc_shr|<=1, e.g. {[core[e] for e in sig_sub][:8]})")
print(f"   dropping baseMean (padj<.05 & |lfc|>1) -> {len(inter)}  | dropping padj (bm>10&|lfc|>1) -> {len(inter)}")
print(f"   crude genomic-window expansion adds candidate ENSMUSG00000021071 (unverified) -> upper 2")
print(f"\n171-DGE subset that is NOT in verified set: {len(dge_ids - set(core))} (symbols unmappable offline)")
print("="*66)
print(f"FINAL ANSWER (documented fallback): {len(inter)}")
