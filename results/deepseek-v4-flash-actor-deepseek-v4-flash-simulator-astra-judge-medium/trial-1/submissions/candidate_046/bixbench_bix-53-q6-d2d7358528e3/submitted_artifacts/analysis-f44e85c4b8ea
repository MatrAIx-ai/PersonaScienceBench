#!/usr/bin/env python3
"""Formal environment verification for BixBench episode bix-53-q6.

Goal: determine whether the EXACT contract is satisfiable in this runner:
   - GSEApy (importable + able to fetch KEGG_2019_Mouse from Enrichr), and
   - R/Bioconductor DESeq2 + apeglm (or pydeseq2 as the official DESeq2 port).
If not satisfiable, this script documents WHY (no fabrication of data/library).
"""
import importlib, json, os, socket, subprocess, sys

report = {"host": socket.gethostname(), "python": sys.version.split()[0]}

# ------------------------------------------------------------------
# 1. Key Python packages (in the active interpreter and system python)
# ------------------------------------------------------------------
def pkg_status(pkg, py):
    try:
        r = subprocess.run([py, "-c", f"import {pkg}, sys; print(getattr({pkg},'__version__','installed'))"],
                           capture_output=True, text=True, timeout=60)
        return r.stdout.strip() or r.stderr.strip().splitlines()[-1][:80]
    except Exception as e:
        return f"ERR {type(e).__name__}"

for py_name, py in [("active", sys.executable), ("system", "/usr/bin/python3"), ("libpy", "/lib/python3.14/bin/python3")]:
    for pkg in ["gseapy", "pydeseq2"]:
        if os.path.exists(py):
            report[f"{py_name}:{pkg}"] = pkg_status(pkg, py)
        else:
            report[f"{py_name}:{pkg}"] = "interpreter not found"

# ------------------------------------------------------------------
# 2. pip install attempts (fast-fail, no retries) for gseapy & pydeseq2
# ------------------------------------------------------------------
for pkg in ["gseapy", "pydeseq2"]:
    try:
        r = subprocess.run([sys.executable, "-m", "pip", "install", "--timeout", "5", "--retries", "0", pkg],
                           capture_output=True, text=True, timeout=120)
        ok = "Successfully installed" in r.stdout + r.stderr
        report[f"pip install {pkg}"] = "OK" if ok else (r.stderr.strip().splitlines()[-1][:120] or r.stdout.strip().splitlines()[-1][:120])
    except Exception as e:
        report[f"pip install {pkg}"] = f"ERR {type(e).__name__}"

# ------------------------------------------------------------------
# 3. R / Bioconductor availability
# ------------------------------------------------------------------
for exe in ["R", "Rscript"]:
    try:
        r = subprocess.run(["command", "-v", exe], capture_output=True, text=True, timeout=30)
        report[f"cmd {exe}"] = r.stdout.strip() or r.stderr.strip() or "NOT FOUND"
    except Exception as e:
        report[f"cmd {exe}"] = f"ERR {type(e).__name__}"
for p in ["/usr/lib/R", "/usr/local/lib/R", "/opt/R"]:
    report[f"dir {p}"] = os.path.isdir(p)

# ------------------------------------------------------------------
# 4. Network / DNS / outbound connectivity (incl. Enrichr endpoints)
# ------------------------------------------------------------------
hosts = ["enrichr.org", "api.enrichr.org", "pypi.org", "files.pythonhosted.org", "google.com"]
for h in hosts:
    try:
        ip = socket.gethostbyname(h)
        report[f"dns {h}"] = ip
    except Exception as e:
        report[f"dns {h}"] = f"FAIL ({type(e).__name__}: {e})"

# general outbound TCP test (bypass DNS using a public resolver IP)
def tcp(host, port, timeout=6):
    try:
        s = socket.create_connection((host, port), timeout=timeout)
        s.close()
        return "reachable"
    except Exception as e:
        return f"blocked ({type(e).__name__})"
report["tcp 8.8.8.8:53"] = tcp("8.8.8.8", 53)
report["tcp 1.1.1.1:53"] = tcp("1.1.1.1", 53)

# try HTTP(S) to Enrichr's well-known public DNS (if resolvable)
try:
    import urllib.request
    req = urllib.request.Request("https://enrichr.org", headers={"User-Agent": "curl/8"})
    with urllib.request.urlopen(req, timeout=10) as r:
        report["http enrichr.org"] = f"HTTP {r.status}"
except Exception as e:
    report["http enrichr.org"] = f"FAIL ({type(e).__name__}: {e})"

# ------------------------------------------------------------------
# 5. Filesystem search for any pre-cached gene-set library (GMT/KEGG/Enrichr)
# ------------------------------------------------------------------
hits = []
for root, dirs, files in os.walk("/"):
    if "/proc" in root or "/sys" in root or "/dev" in root:
        dirs[:] = []
        continue
    for f in files:
        low = f.lower()
        if low.endswith((".gmt", ".gmx")) or "enrichr" in low or "kegg" in low or "gseapy" in low or "pydeseq" in low:
            hits.append(os.path.join(root, f))
report["filesystem gene-set cache hits"] = hits[:20] if hits else "NONE"

with open("/workspace/env_report.json", "w") as fh:
    json.dump(report, fh, indent=2)
print(json.dumps(report, indent=2))
print("\n-> env_report.json written")
