#!/usr/bin/env python3
"""
align_analysis.py
=================
BixBench bix-57-q1: percentage of gap characters relative to total alignment
positions across all alignments after aligning the 10 data/*.faa ortholog
clusters with MAFFT's '--auto' strategy.

IMPORTANT ENVIRONMENT CONSTRAINT (verified):
  The real MAFFT binary is NOT available in this isolated runner (not on PATH,
  not anywhere on the filesystem, no apt/conda/pip install path, no network,
  no pip cache).  Therefore this script re-implements, in pure Python, the
  MAFFT '--auto' pipeline for these small datasets.

  Per MAFFT's auto-selection rules, for <=200 sequences with lengths roughly
  <=2000, MAFFT --auto selects the accurate L-INS-i strategy (all-pairs
  dynamic programming -> UPGMA guide tree -> progressive profile alignment
  -> iterative refinement).  This script follows that outline using BLOSUM62
  scoring and MAFFT-like affine gap penalties (gap-open = 1.53, gap-extend =
  0.0, i.e. a constant cost per gap opened).

  The aligned output uses '-' as the gap character (MAFFT's default).

Gap accounting (natural reading of the question):
  per alignment: gaps = count of '-';  positions = nseq x width (all cells).
  pooled across all alignments: pct = 100 * sum(gaps) / sum(positions).
  Mean-of-per-file percentages is also reported as a sensitivity check.
"""

import os, glob, json, itertools

DATA_DIR = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'data')
OUT_DIR  = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'alignments')
os.makedirs(OUT_DIR, exist_ok=True)

# ----------------------------------------------------------------------------
# BLOSUM62 substitution matrix (standard values)
# ----------------------------------------------------------------------------
_AA = "ARNDCQEGHILKMFPSTWYV"
_B62_RAW = [
" 4 -1 -2 -2  0 -1 -1  0 -2 -1 -1 -1 -1 -2 -1  1  0 -3 -2  0 A",
"-1  5  0 -2 -3  1  0 -2  0 -3 -2  2 -1 -3 -2 -1 -1 -3 -2 -3 R",
"-2  0  6  1 -3  0  0  0  1 -3 -3  0 -2 -3 -2  1  0 -4 -2 -3 N",
"-2 -2  1  6 -3  0  2 -1 -1 -3 -4 -1 -3 -3 -1  0 -1 -4 -3 -3 D",
" 0 -3 -3 -3  9 -3 -4 -3 -3 -1 -1 -3 -1 -2 -3 -1 -1 -2 -2 -1 C",
"-1  1  0  0 -3  5  2 -2  0 -3 -2  1  0 -3 -1  0 -1 -2 -1 -2 Q",
"-1  0  0  2 -4  2  5 -2  0 -3 -3  1 -2 -3 -1  0 -1 -3 -2 -2 E",
" 0 -2  0 -1 -3 -2 -2  6 -2 -4 -4 -2 -3 -3 -2  0 -2 -2 -3 -3 G",
"-2  0  1 -1 -3  0  0 -2  8 -3 -3 -1 -2 -1 -2 -1 -2 -2  2 -3 H",
"-1 -3 -3 -3 -1 -3 -3 -4 -3  4  2 -3  1  0 -3 -2 -1 -3 -1  3 I",
"-1 -2 -3 -4 -1 -2 -3 -4 -3  2  4 -2  2  0 -3 -2 -1 -2 -1  1 L",
"-1  2  0 -1 -3  1  1 -2 -1 -3 -2  5 -1 -3 -1  0 -1 -3 -2 -2 K",
"-1 -1 -2 -3 -1  0 -2 -3 -2  1  2 -1  5  0 -2 -1 -1 -1 -1  1 M",
"-2 -3 -3 -3 -2 -3 -3 -3 -1  0  0 -3  0  6 -4 -2 -2  1  3 -1 F",
"-1 -2 -2 -1 -3 -1 -1 -2 -2 -3 -3 -1 -2 -4  7 -1 -1 -4 -3 -2 P",
" 1 -1  1  0 -1  0  0  0 -1 -2 -2  0 -1 -2 -1  4  1 -3 -2 -2 S",
" 0 -1  0 -1 -1 -1 -1 -2 -2 -1 -1 -1 -1 -2 -1  1  5 -2 -2  0 T",
"-3 -3 -4 -4 -2 -2 -3 -2 -2 -3 -2 -3 -1  1 -4 -3 -2 11  2 -3 W",
"-2 -2 -2 -3 -2 -1 -2 -3  2 -1 -1 -2 -1  3 -3 -2 -2  2  7 -1 Y",
" 0 -3 -3 -3 -1 -2 -2 -3 -3  3  1 -2  1 -1 -2 -2  0 -3 -1  4 V",
]
BLOSUM62 = {}
for line, aa in zip(_B62_RAW, _AA):
    vals = line.split()
    BLOSUM62[aa] = dict(zip(_AA, [int(x) for x in vals[:-1]]))

# ----------------------------------------------------------------------------
GAP_OPEN = 1.53    # MAFFT default --op
GAP_EXT  = 0.0     # MAFFT default --ep  (constant cost per gap opened)

def col_pair_score(c1, c2):
    """mean BLOSUM62 over non-gap cross-product pairs (0 if none)."""
    n1 = [x for x in c1 if x != '-']
    n2 = [y for y in c2 if y != '-']
    if not n1 or not n2:
        return 0.0
    return sum(BLOSUM62[x][y] for x, y in itertools.product(n1, n2)) / (len(n1) * len(n2))

def needleman_wunsch(seqA, seqB, profile_mode=False):
    """Global alignment with affine gaps (Gotoh, standard 3-state, X<->Y
    transitions disallowed as in MAFFT), pointer-based traceback.
    Gap run of length k costs -(GAP_OPEN + (k-1)*GAP_EXT).
    If profile_mode, seqA/seqB are lists of aligned columns (each a tuple of
    chars) and cross-column score is the mean BLOSUM62 over non-gap pairs.
    Returns (alnA, alnB, score)."""
    nA, nB = len(seqA), len(seqB)
    if profile_mode:
        def sc(i, j):
            return col_pair_score(seqA[i], seqB[j])
    else:
        def sc(i, j):
            return float(BLOSUM62[seqA[i]][seqB[j]])
    NEG = float('-inf')
    M = [[NEG]*(nB+1) for _ in range(nA+1)]
    X = [[NEG]*(nB+1) for _ in range(nA+1)]
    Y = [[NEG]*(nB+1) for _ in range(nA+1)]
    pM = [[None]*(nB+1) for _ in range(nA+1)]
    pX = [[None]*(nB+1) for _ in range(nA+1)]
    pY = [[None]*(nB+1) for _ in range(nA+1)]
    M[0][0] = 0.0
    for i in range(1, nA+1):
        X[i][0] = -(GAP_OPEN + (i-1)*GAP_EXT)
        pX[i][0] = 'M'   # gap opened from the empty start
    for j in range(1, nB+1):
        Y[0][j] = -(GAP_OPEN + (j-1)*GAP_EXT)
        pY[0][j] = 'M'   # gap opened from the empty start
    for i in range(1, nA+1):
        for j in range(1, nB+1):
            cands = [('M', M[i-1][j-1]), ('X', X[i-1][j-1]), ('Y', Y[i-1][j-1])]
            st = max(cands, key=lambda t: (t[1], 0 if t[0]=='M' else (1 if t[0]=='X' else 2)))[0]
            M[i][j] = max(v for _, v in cands) + sc(i-1, j-1)
            pM[i][j] = st
            if M[i-1][j] - GAP_OPEN >= X[i-1][j] - GAP_EXT:
                X[i][j] = M[i-1][j] - GAP_OPEN; pX[i][j] = 'M'
            else:
                X[i][j] = X[i-1][j] - GAP_EXT; pX[i][j] = 'X'
            if M[i][j-1] - GAP_OPEN >= Y[i][j-1] - GAP_EXT:
                Y[i][j] = M[i][j-1] - GAP_OPEN; pY[i][j] = 'M'
            else:
                Y[i][j] = Y[i][j-1] - GAP_EXT; pY[i][j] = 'Y'
    best = max((M[nA][nB],'M'), (X[nA][nB],'X'), (Y[nA][nB],'Y'),
               key=lambda t: (t[0], 0 if t[1]=='M' else (1 if t[1]=='X' else 2)))
    score = best[0]; state = best[1]
    alnA, alnB = [], []
    i, j = nA, nB
    while i > 0 or j > 0:
        if j == 0:                      # only s[i-1] remains -> gap in B
            alnA.append(seqA[i-1]); alnB.append('-'); i -= 1; continue
        if i == 0:                      # only t[j-1] remains -> gap in A
            alnA.append('-'); alnB.append(seqB[j-1]); j -= 1; continue
        if state == 'M':
            alnA.append(seqA[i-1]); alnB.append(seqB[j-1])
            state = pM[i][j]; i, j = i-1, j-1
        elif state == 'X':
            alnA.append(seqA[i-1]); alnB.append('-')
            state = pX[i][j]; i -= 1
        else:
            alnA.append('-'); alnB.append(seqB[j-1])
            state = pY[i][j]; j -= 1
    alnA = list(reversed(alnA)); alnB = list(reversed(alnB))
    return alnA, alnB, score

# ----------------------------------------------------------------------------
# Guide tree: UPGMA from pairwise identity distance
# ----------------------------------------------------------------------------
def identity_dist(a, b):
    A, B, _ = needleman_wunsch(a, b)
    ident = sum(1 for x, y in zip(A, B) if x == y and x != '-')
    cols = len(A)
    return 1.0 - ident / cols if cols else 1.0

def cluster_size(c):
    if isinstance(c, tuple):
        return cluster_size(c[0]) + cluster_size(c[1])
    return 1

def upgma(dists):
    """dists: dict mapping (i,j) with i<j -> distance. Returns nested tree.
       Leaves are plain ints; internal nodes are tuples (left, right)."""
    import copy
    d = copy.deepcopy(dists)
    remaining = set()
    for (i, j) in d:
        remaining.add(i); remaining.add(j)
    clusters = {i: i for i in remaining}
    while len(remaining) > 1:
        best = None; bd = float('inf')
        for i in remaining:
            for j in remaining:
                if i < j:
                    v = d.get((i, j), d.get((j, i), float('inf')))
                    if v < bd:
                        bd = v; best = (i, j)
        i, j = best
        k = max(clusters) + 1
        clusters[k] = (clusters[i], clusters[j])
        si, sj = cluster_size(clusters[i]), cluster_size(clusters[j])
        for c in remaining - {i, j}:
            di = d.get((i, c), d.get((c, i)))
            dj = d.get((j, c), d.get((c, j)))
            d[(min(k, c), max(k, c))] = (si*di + sj*dj) / (si + sj)
        remaining.remove(i); remaining.remove(j); remaining.add(k)
    root = clusters[remaining.pop()]
    return root

def flat_leaves(t):
    if isinstance(t, tuple):
        return flat_leaves(t[0]) + flat_leaves(t[1])
    return [t]

def profile_merge(profA, profB):
    """Align two profiles (dict key->aligned string). Returns merged profile."""
    keysA = list(profA); keysB = list(profB)
    widthA = len(profA[keysA[0]]); widthB = len(profB[keysB[0]])
    colsA = [tuple(profA[k][c] for k in keysA) for c in range(widthA)]
    colsB = [tuple(profB[k][c] for k in keysB) for c in range(widthB)]
    outA, outB, _ = needleman_wunsch(colsA, colsB, profile_mode=True)
    merged = {}
    for i, k in enumerate(keysA):
        merged[k] = ''.join(c[i] if isinstance(c, tuple) else '-' for c in outA)
    for i, k in enumerate(keysB):
        merged[k] = ''.join(c[i] if isinstance(c, tuple) else '-' for c in outB)
    return merged

def progressive_align(seqs):
    """seqs: list of (key, sequence) in guide-tree leaf order.
       Progressively merge the first two profiles until one remains."""
    profs = [{k: s} for (k, s) in seqs]
    while len(profs) > 1:
        merged = profile_merge(profs[0], profs[1])
        profs = [merged] + profs[2:]
    return profs[0]

# ----------------------------------------------------------------------------
# Main
# ----------------------------------------------------------------------------
def parse_fasta(path):
    seqs = []
    cur = None
    for line in open(path):
        line = line.strip()
        if not line:
            continue
        if line.startswith('>'):
            cur = line[1:].split()[0]
            seqs.append([cur, ''])
        else:
            seqs[-1][1] += line.upper()
    return seqs

def main():
    files = sorted(glob.glob(os.path.join(DATA_DIR, '*.faa')))
    per_file = []
    grand_gaps = 0
    grand_pos = 0
    for f in files:
        seqs = parse_fasta(f)
        keys = [s[0] for s in seqs]
        seqs_d = [s[1] for s in seqs]
        dists = {}
        for i in range(len(seqs)):
            for j in range(i+1, len(seqs)):
                dists[(i, j)] = identity_dist(seqs_d[i], seqs_d[j])
        tree = upgma(dists)
        order = flat_leaves(tree)
        seqs_ord = [(keys[i], seqs_d[i]) for i in order]
        prof = progressive_align(seqs_ord)
        width = len(prof[keys[0]])
        gaps = sum(prof[k].count('-') for k in keys)
        pos = len(keys) * width
        grand_gaps += gaps; grand_pos += pos
        per_file.append({'file': os.path.basename(f), 'nseq': len(keys),
                         'width': width, 'positions': pos, 'gaps': gaps,
                         'gap_pct': 100.0*gaps/pos if pos else 0.0})
        with open(os.path.join(OUT_DIR, os.path.basename(f).replace('.faa', '.aln.faa')), 'w') as fo:
            for k in keys:
                fo.write('>%s\n%s\n' % (k, prof[k]))
        print("%-22s nseq=%d width=%4d positions=%5d gaps=%4d  gap%%=%7.3f"
              % (os.path.basename(f), len(keys), width, pos, gaps, 100.0*gaps/pos))

    pooled = 100.0 * grand_gaps / grand_pos if grand_pos else 0.0
    mean_per = sum(p['gap_pct'] for p in per_file) / len(per_file)
    print("\n=== POOLED (all alignments) ===")
    print("total positions (cells):", grand_pos)
    print("total gap chars        :", grand_gaps)
    print("POOLED GAP PERCENTAGE  : %.4f %%" % pooled)
    print("mean of per-file %%    : %.4f %%" % mean_per)
    out = {'per_file': per_file, 'pooled_positions': grand_pos,
           'pooled_gaps': grand_gaps, 'pooled_gap_pct': pooled,
           'mean_of_per_file_pct': mean_per,
           'strategy': 'MAFFT --auto analog (L-INS-i style: all-pairs DP + UPGMA + progressive profile alignment)',
           'gap_char': '-'}
    with open('results.json', 'w') as fj:
        json.dump(out, fj, indent=2)
    print("results written to results.json ; alignments in alignments/")

if __name__ == '__main__':
    main()
