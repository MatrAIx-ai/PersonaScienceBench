"""
CHIP variant analysis (FINAL, decisions approved on 2026-10-22)
Question: average number of CHIP variants per sample after filtering out
intronic, intergenic, and UTR variants.

Approved decisions:
  1) Sample = each of the 86 CHIP xlsx files; denominator of the average = 86.
  2) Exclude SO terms exactly: intron_variant, intergenic_variant,
     3_prime_UTR_variant, 5_prime_UTR_variant,
     5_prime_UTR_premature_start_codon_gain_variant; plus anything matching
     'intergenic*' defensively (none present in the data).
  3) Keep splice_region_variant, upstream_gene_variant, and all coding
     terms (strict reading of the question).
  4) Exclude 'Reference' zygosity rows; count as variants:
     Heterozygous + Homozygous Variant + blank-zygosity rows passing the
     SO filter (they carry non-reference Ref/Alt and HGVS/ClinVar annotation).
  5) Count per row within each sample; deduplicated count by (Chr:Pos, Ref/Alt)
     also reported for confirmation (expected identical because all within-file
     duplicates are intron_variant).

Two-level header: row1 = block names, row2 = sub-headers, data from row3.
  A2 'Chr:Pos' (1:1789231) | B2 'Ref/Alt' (G/A, A/-, TC/-) | E2 'Zygosity'
  N2 'Sequence Ontology (Combined)' | T2 'Filter' (PASS) | AD2 'In_CHIP' (True)
"""
import openpyxl, glob, os
from collections import Counter

DATA_DIR = "data"
CHIP_DIR = os.path.join(DATA_DIR, "CHIP_DP10_GQ20_PASS")
FILES = sorted(glob.glob(os.path.join(CHIP_DIR, "*.xlsx")))

VARIANT_ZYGOSITIES = {"Heterozygous", "Homozygous Variant", None}  # None = blank zygosity
EXCLUDED_SO = {
    "intron_variant",
    "intergenic_variant",
    "3_prime_UTR_variant",
    "5_prime_UTR_variant",
    "5_prime_UTR_premature_start_codon_gain_variant",
}

def is_excluded(so):
    if so is None:
        return True
    if so in EXCLUDED_SO:
        return True
    if str(so).startswith("intergenic"):
        return True
    return False

def read_file(path):
    wb = openpyxl.load_workbook(path, read_only=False)
    ws = wb[wb.sheetnames[0]]
    sample_block = ws.cell(row=1, column=5).value or os.path.basename(path)
    rows = [row for row in ws.iter_rows(min_row=3, values_only=True)
            if not (row[0] is None and row[1] is None and row[2] is None)]
    return sample_block, rows

def main():
    assert len(FILES) == 86, f"expected 86 files, got {len(FILES)}"
    per_sample = []                 # (sample, count_rows, count_dedup)
    so_breakdown = Counter()        # SO of KEPT variant rows
    zygo_breakdown = Counter()      # zygosity of KEPT variant rows
    excluded_by_type = 0            # rows dropped by SO filter (all zygosities)
    reference_dropped = 0           # Reference rows that passed the SO filter
    intergenic_seen = 0

    for f in FILES:
        sample, rows = read_file(f)
        kept = []
        kept_keys = set()
        for r in rows:
            so = r[13]
            if str(so).startswith("intergenic"):
                intergenic_seen += 1
            # type filter first (applies to every row)
            if is_excluded(so):
                excluded_by_type += 1
                continue
            # then zygosity filter (Reference is not a variant)
            if r[4] == "Reference":
                reference_dropped += 1
                continue
            if r[4] not in VARIANT_ZYGOSITIES:
                continue
            kept.append(r)
            kept_keys.add((r[0], r[1]))
        for r in kept:
            so_breakdown[r[13]] += 1
            zygo_breakdown[r[4]] += 1
        per_sample.append((sample, len(kept), len(kept_keys)))

    total_rows = sum(c for _, c, _ in per_sample)
    total_dedup = sum(d for _, _, d in per_sample)
    n = len(per_sample)
    counts_only = [c for _, c, _ in per_sample]

    print("=" * 62)
    print("FINAL RESULT")
    print("=" * 62)
    print(f"Samples (files) used                    : {n}")
    print(f"Total CHIP variants after filter (rows) : {total_rows}")
    print(f"Total CHIP variants after filter (dedup by Chr:Pos+Ref/Alt per sample): {total_dedup}")
    print(f"AVERAGE variants per sample (rows / 86) : {total_rows/n:.4f}")
    print(f"AVERAGE variants per sample (dedup / 86): {total_dedup/n:.4f}")
    print(f"Min per sample: {min(counts_only)} | Max per sample: {max(counts_only)}")
    print(f"Rows dropped by SO filter (intronic/intergenic/UTR): {excluded_by_type}")
    print(f"'Reference' rows dropped after SO filter : {reference_dropped}")
    print(f"intergenic* rows seen                   : {intergenic_seen}")
    print("\nKept variant rows by SO (Sequence Ontology Combined):")
    for k, v in so_breakdown.most_common():
        print(f"  {v:7d}  {k!r}")
    print("\nKept variant rows by Zygosity:")
    for k, v in zygo_breakdown.most_common():
        print(f"  {v:7d}  {k!r}")
    print("\nPer-sample counts (sample, rows, dedup):")
    for s, c, d in per_sample:
        print(f"  {s:60s} {c:5d} {d:5d}")

if __name__ == "__main__":
    main()
