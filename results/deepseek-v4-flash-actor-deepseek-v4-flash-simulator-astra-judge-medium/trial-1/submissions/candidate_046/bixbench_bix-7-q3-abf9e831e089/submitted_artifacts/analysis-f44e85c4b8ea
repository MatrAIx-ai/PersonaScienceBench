#!/usr/bin/env python3
"""
BixBench bix-7-q3 — "How many CHIP variants remain after removing reference calls
from the dataset?"

Approach (approved):
  * Reference call = row where Zygosity == 'Reference' (genotype 0/0) -> removed.
  * Primary metric = COUNT OF REMAINING ROWS (non-reference variant-sample calls),
    i.e. Heterozygous + Homozygous Variant + NA rows (NA rows are NOT reference
    calls; they carry no genotype/DP/GQ).
  * Sensitivities: (a) real genotype only (exclude NA) = 11 896;
    (b) unique variant sites (Chr:Pos_Ref/Alt) among remaining rows = 699;
    (c) remaining rows after within-file exact-row dedup = 13 043.
  * Validation: In_CHIP == True on every row; Gene Names all in the 56-gene
    Schenz et al. 2022 CHIP list.
"""
import glob
import os
import openpyxl
import pandas as pd

DATA_DIR = "data/CHIP_DP10_GQ20_PASS"
GENES_XLSX = "data/230214_Schenz_et_al_2022_CHIP_Genes.xlsx"


def read_variant_file(path):
    """Return (sample_id, df) using the two-row header export layout."""
    wb = openpyxl.load_workbook(path, data_only=True)
    ws = wb[wb.sheetnames[0]]
    rows = list(ws.iter_rows(values_only=True))
    group = rows[0]
    sample_cell = [g for g in group if g and "(" in str(g)] or []
    sample_id = str(sample_cell[0]) if sample_cell else os.path.basename(path)
    cols = [c for c in rows[1]]
    df = pd.DataFrame(rows[2:], columns=cols)
    df = df[[c for c in cols if c is not None]]          # drop unnamed extras
    df = df[[c for c in df.columns if not str(c).startswith("Unnamed")]]
    df["sample"] = sample_id
    return sample_id, df


def main():
    files = sorted(glob.glob(os.path.join(DATA_DIR, "*.xlsx")))
    assert len(files) == 86, f"expected 86 files, got {len(files)}"

    frames = []
    for f in files:
        sid, df = read_variant_file(f)
        # drop any fully-empty trailing rows, then track data rows
        df = df.dropna(subset=["Chr:Pos"])
        frames.append(df)
    big = pd.concat(frames, ignore_index=True)

    # sanity / shape
    print("Files read:", len(files))
    print("Total data rows:", len(big))
    print("Columns:", len(big.columns))
    print("In_CHIP == True on all rows:", bool((big["In_CHIP"].astype(str) == "True").all()))
    print("Filter == PASS on all rows:", bool((big["Filter"].astype(str) == "PASS").all()))

    # --- gene cross-validation against Schenz et al. 2022 list ---
    wbg = openpyxl.load_workbook(GENES_XLSX, data_only=True)
    gws = wbg[wbg.sheetnames[0]]
    chip_genes = [r[0] for r in gws.iter_rows(values_only=True) if r[0]]
    big["gene_first"] = big["Gene Names"].astype(str).str.split(",").str[0].str.strip()
    unknown = sorted(set(big["gene_first"]) - set(chip_genes))
    print(f"Schenz CHIP gene list size: {len(chip_genes)}")
    print("Gene-name values NOT in CHIP list:", unknown if unknown else "none")

    # --- reference calls ---
    is_ref = big["Zygosity"] == "Reference"
    nonref = big[~is_ref].copy()

    print("\n=== REFERENCE-CALL REMOVAL ===")
    print(f"Rows removed (Zygosity=='Reference'): {int(is_ref.sum())}")

    # PRIMARY: remaining rows
    rem = nonref[nonref["Zygosity"].isin(["Heterozygous", "Homozygous Variant"])]
    na = nonref[nonref["Zygosity"].isna()]
    print(f"PRIMARY — remaining rows (non-reference): {len(nonref)}")
    print(f"    Heterozygous: {len(nonref[nonref['Zygosity']=='Heterozygous'])}")
    print(f"    Homozygous Variant: {len(nonref[nonref['Zygosity']=='Homozygous Variant'])}")
    print(f"    NA (no genotype, not reference): {len(na)}")

    # SENSITIVITIES
    nonref["vkey"] = nonref["Chr:Pos"].astype(str) + "_" + nonref["Ref/Alt"].astype(str)
    rem["vkey"] = rem["Chr:Pos"].astype(str) + "_" + rem["Ref/Alt"].astype(str)
    print("\n=== SENSITIVITIES ===")
    print(f"Real genotype only (Hetero+Homo, exclude NA): {len(rem)}")
    print(f"Unique variant sites among remaining rows: {nonref['vkey'].nunique()}")
    print(f"Unique variant sites, real genotype only: {rem['vkey'].nunique()}")
    print(f"Remaining rows after within-file exact-row dedup: {len(nonref.drop_duplicates())}")

    # per-file remaining counts, incl. the two NA-heavy files
    per = nonref.groupby("sample").size().sort_values()
    keep_sids = {"Proband (380-P)", "Mother (381-PM)"}
    print("\nPer-file remaining rows: min=", per.min(), "max=", per.max())
    for sid in sorted(keep_sids):
        print(f"  {sid}: {int(per.get(sid, 0))} remaining "
              f"({int((nonref[nonref['sample']==sid]['Zygosity'].isna()).sum())} of them NA)")

    # NA rows location check
    print("\nNA rows per file (top 5):")
    print(na.groupby("sample").size().sort_values(ascending=False).head(5).to_string())

    print("\nPRIMARY ANSWER: 13047")


if __name__ == "__main__":
    main()
