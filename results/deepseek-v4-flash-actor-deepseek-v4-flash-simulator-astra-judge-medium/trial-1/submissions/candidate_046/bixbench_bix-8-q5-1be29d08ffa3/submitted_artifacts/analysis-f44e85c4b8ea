"""BixBench bix-8-q5: independence between m6A methylation and DEG status.
Bladder cancer dataset. Reads data/MeRIP_RNA_result.xlsx, builds the 2x2
contingency table (m6A sig = Hyper|Hypo; DEG sig = Up|Down), applies the
chi-square test of independence using scipy.stats.chi2_contingency with the
default continuity (Yates) correction -> p = 8.32e-72.

Robustness checks (all three reject independence):
  * chi-square WITHOUT Yates correction      -> p = 2.95e-72
  * chi-square WITH Yates correction (final) -> p = 8.32e-72
  * Fisher's exact test                      -> p = 8.22e-54

QA: combined column m6A_DEG reconstructed from m6A + " and " + DEG shows
0 mismatches across all 12754 rows.
"""
import numpy as np
import pandas as pd
from scipy import stats

XL = 'data/MeRIP_RNA_result.xlsx'
df = pd.read_excel(XL)

# ---------- 1) Schema / QA ----------
print("shape:", df.shape)
for col in ['m6A', 'DEG', 'm6A_DEG']:
    print(f"{col}:", df[col].value_counts(dropna=False).to_dict())
print("NaN in key cols:", df[['m6A', 'DEG', 'm6A_DEG']].isna().sum().to_dict())

df['exp_m6A_DEG'] = df['m6A'] + ' and ' + df['DEG']
mismatch = int((df['m6A_DEG'] != df['exp_m6A_DEG']).sum())
print("m6A_DEG consistency mismatches:", mismatch)

# ---------- 2) Binarize ----------
df['m6A_sig'] = df['m6A'].isin(['m6A Hyper', 'm6A Hypo'])   # 1191 True
df['DEG_sig'] = df['DEG'].isin(['Up', 'Down'])               #  963 True

ct = pd.crosstab(df['m6A_sig'], df['DEG_sig']).reindex(index=[True, False],
                                                       columns=[True, False])
print("\n2x2 contingency (rows = m6A sig?, cols = DEG sig?):")
print(ct.to_string())
table = ct.values
print("grand total:", int(table.sum()))

# ---------- 3) Tests ----------
chi2_noY, p_noY, dof, exp = stats.chi2_contingency(table, correction=False)
chi2_Y,   p_Y,   dof, exp = stats.chi2_contingency(table, correction=True)
odds, p_fisher = stats.fisher_exact(table)

print(f"\nmin expected count = {exp.min():.3f}")
print(f"chi2 no-Yates : X2={chi2_noY:.6f} p={p_noY:.6e}")
print(f"chi2 Yates    : X2={chi2_Y:.6f} p={p_Y:.6e}")
print(f"fisher exact  : odds={odds:.6f} p={p_fisher:.6e}")

# ---------- 4) Final answer (Yates-corrected chi-square), scientific notation ----------
ans = f"{p_Y:.2e}"
print("\nFINAL ANSWER (chi2 with continuity correction):", ans)
assert p_Y < 0.05, "independence NOT rejected"
