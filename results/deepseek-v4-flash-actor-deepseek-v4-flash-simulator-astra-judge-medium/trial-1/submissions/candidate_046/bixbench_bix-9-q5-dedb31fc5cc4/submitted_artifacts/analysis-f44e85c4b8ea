"""
BixBench bix-9-q5 - Which tissue shows the highest number of significantly
differentially expressed (lfc>0.5 and baseMean>10) genes in bad responders
compared to controls?

Data:
  data/Data_deposition_RNAseq_Paroxetine_2017.xlsx
    - Mapping_statistics : sample annotations (Response, Tissue, Code, Index)
    - NormCount          : normalized counts (decimals) for 25402 genes x 90
                           samples, plus per-tissue Max/Median, plus NINE
                           pre-computed DESeq2 comparison blocks and nine
                           summary "Comparison1..9" columns.

Note on DESeq2:
  NormCount stores NORMALIZED (non-integer) counts, so DESeq2 cannot be re-run
  from these data (DESeq2 requires raw integer counts). No raw-count file is
  present in the capsule. We therefore use the DESeq2 outputs ALREADY embedded
  in the workbook (baseMean, log2FoldChange, pval, padj, DEG flags). The
  bad-vs-Control comparison per tissue is identified and verified by
  correlating each comparison's log2FoldChange with log2(groupB.mean/groupA.mean)
  reconstructed from the sample columns.
"""
import numpy as np
import pandas as pd

np.seterr(divide="ignore", invalid="ignore")

XLSX = "data/Data_deposition_RNAseq_Paroxetine_2017.xlsx"
xl = pd.ExcelFile(XLSX)

# ----------------------------------------------------------------------------
# 0. Load sheets
# ----------------------------------------------------------------------------
mapping = xl.parse("Mapping_statistics")
raw = xl.parse("NormCount", header=None)          # composite headers
header_row = list(raw.iloc[3])                    # sample-name header row
data = raw.iloc[4:].reset_index(drop=True)        # 25402 gene rows

n_genes = len(data)
print(f"[0] genes={n_genes}, sample-cols=90")

# ----------------------------------------------------------------------------
# 1. Sample columns -> (Response, Tissue) annotation via Code == NormCount header
# ----------------------------------------------------------------------------
samples2col = {header_row[c]: c for c in range(2, 92)}   # 90 normalized-count cols
# sanity: every sample header must exist in Mapping_statistics 'Code'
codes = set(mapping["Code"].dropna())
assert all(s in codes for s in samples2col), "some NormCount headers not in Mapping Code"
by_code = mapping.set_index("Code")
print(f"[1] all 90 sample columns matched to Mapping_statistics codes")

# ----------------------------------------------------------------------------
# 2. Reconstruct group means per (Response, Tissue) from the 90 sample columns
# ----------------------------------------------------------------------------
gmeans = {}
for _, r in mapping.iterrows():
    code, resp, tiss = r["Code"], r["Response"], r["Tissue"]
    if pd.isna(code):
        continue
    key = f"{resp}_{tiss}"
    gmeans.setdefault(key, []).append(samples2col[code])

for key in list(gmeans):
    cols = gmeans[key]
    gmeans[key] = data[cols].astype(float).mean(axis=1)   # per-gene group mean
print("[2] reconstructed 9 (Response x Tissue) group-mean vectors")

# ----------------------------------------------------------------------------
# 3. DESeq comparison blocks
# ----------------------------------------------------------------------------
comp = {}
for k in range(1, 10):
    base = 98 + (k - 1) * 9
    comp[k] = dict(
        tissue=None, groupA=None, groupB=None,
        baseMean=data[base].astype(float),
        baseMeanA=data[base + 1].astype(float),
        baseMeanB=data[base + 2].astype(float),
        foldChange=data[base + 3].astype(float),
        log2FC=data[base + 4].astype(float),
        pval=data[base + 5].astype(float),
        padj=data[base + 6].astype(float),
        DEG_max=data[base + 7],          # variant 'Max'
        DEG_med=data[base + 8],          # variant 'Median' (== summary col)
        summary=data[178 + k],           # Comparison{k} summary column
    )

# ----------------------------------------------------------------------------
# 4. Identify tissue + direction of every comparison by correlating log2FC
#    with log2(groupB.mean / groupA.mean). Highest correlation wins.
# ----------------------------------------------------------------------------
tissues = ["baseline_blood", "dentate_gyrus", "final_blood"]
groups = ["Control", "good_responder", "bad_responder"]

print("\n[4] Comparison identification (log2FC <-> log2(groupB/groupA) corr)")
assigned = {}
for k, C in comp.items():
    lfc = C["log2FC"]
    best = (-1.0, None, None)
    for tiss in tissues:
        for ga in groups:
            for gb in groups:
                if ga == gb:
                    continue
                ratio = np.log2(gmeans[f"{gb}_{tiss}"] / gmeans[f"{ga}_{tiss}"])
                m = np.isfinite(ratio) & np.isfinite(lfc)
                if m.sum() < 10:
                    continue
                r = np.corrcoef(ratio[m], lfc[m])[0, 1]
                if r > best[0]:
                    best = (r, f"{gb} vs {ga}", (tiss, gb, ga))
    r, label, (tiss, gb, ga) = best
    C["tissue"], C["groupB"], C["groupA"] = tiss, gb, ga
    assigned[k] = (tiss, gb, ga)
    print(f"  Comp{k}: corr={r:.4f}  groupB={gb:14s} vs groupA={ga:14s}  tissue={tiss}")

# The bad-vs-Control comparison per tissue:
bad_vs_ctrl = {}
for k, (tiss, gb, ga) in assigned.items():
    if ga == "Control" and gb == "bad_responder":
        bad_vs_ctrl[tiss] = k
print(f"\n  bad-vs-Control comparisons per tissue: {bad_vs_ctrl}")

# ----------------------------------------------------------------------------
# 5. Threshold counting for the bad-vs-Control comparison of each tissue
# ----------------------------------------------------------------------------
def count_de(C, sig_padj=0.05, lfc_min=0.5, use_abs_lfc=True, use_deg=None):
    lfc = C["log2FC"].abs() if use_abs_lfc else C["log2FC"]
    if use_deg is not None:                      # native DEG flag (U/D vs -)
        sig = use_deg != "-"
    else:                                        # adjusted p-value threshold
        sig = C["padj"].notna() & (C["padj"] < sig_padj)
    return int((sig & (lfc > lfc_min) & (C["baseMean"] > 10)).sum())

print("\n[5] Counts (bad vs Control) per tissue")
rows = []
for tiss in tissues:
    C = comp[bad_vs_ctrl[tiss]]
    rows.append({
        "tissue": tiss,
        "comp": bad_vs_ctrl[tiss],
        "padj0.05_|lfc|": count_de(C, 0.05, use_abs_lfc=True),
        "padj0.05_lfc+":  count_de(C, 0.05, use_abs_lfc=False),
        "padj0.1_|lfc|":  count_de(C, 0.10, use_abs_lfc=True),
        "padj0.1_lfc+":   count_de(C, 0.10, use_abs_lfc=False),
        "DEG_med_|lfc|":  count_de(C, use_deg=C["DEG_med"], use_abs_lfc=True),
        "DEG_med_lfc+":   count_de(C, use_deg=C["DEG_med"], use_abs_lfc=False),
        "DEG_max_|lfc|":  count_de(C, use_deg=C["DEG_max"], use_abs_lfc=True),
    })
res = pd.DataFrame(rows)
print(res.to_string(index=False))

# winners per criterion column
print("\n  winner per criterion:")
for col in res.columns[2:]:
    w = res.loc[res[col].idxmax(), "tissue"]
    print(f"    {col:16s} -> {w}  (counts {list(res[col])})")

# ----------------------------------------------------------------------------
# 6. Final answer (primary criterion: padj<0.05, |lfc|>0.5, baseMean>10)
# ----------------------------------------------------------------------------
prim = res.set_index("tissue")["padj0.05_|lfc|"]
answer = prim.idxmax()
print("\n[6] FINAL ANSWER")
print(f"  Primary counts (padj<0.05, |lfc|>0.5, baseMean>10):")
print(f"    baseline_blood = {prim['baseline_blood']}")
print(f"    dentate_gyrus  = {prim['dentate_gyrus']}")
print(f"    final_blood    = {prim['final_blood']}")
print(f"  => tissue with highest number of DE genes: {answer}")
