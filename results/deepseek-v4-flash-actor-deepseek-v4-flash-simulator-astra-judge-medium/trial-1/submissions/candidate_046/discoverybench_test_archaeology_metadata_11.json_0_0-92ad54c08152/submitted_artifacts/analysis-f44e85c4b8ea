"""
FINAL ANALYSIS: In which century did Pottery Form diversity COLLAPSE and
Pottery Decoration diversity INCREASE simultaneously?

Approved plan (researcher):
  - Analysis resolution: 100-year bins (native scale of pottery Z-values);
    the yearly interpolated series is a linear artifact and is not used for detection.
  - "Collapse" (Form)  : between-bin drop  dForm <= -1.0  (to series-minimum plateau -1.13).
  - "Increase" (Decor) : between-bin rise   dDec  >= +1.0  (to sustained positive plateau).
  - Both must occur in the SAME bin transition; new level must persist >= 3 subsequent bins.
  - Uniqueness + sensitivity sweep (thresholds @ 0.75*sigma and 1.0*sigma) as sanity check.
  - Temporal anchor: CE (calBP = 1950 - CE). Reported in BCE/CE.
  - Century naming (confirmed by researcher): primary answer = century of the FIRST bin
    showing the new state (1700 BCE -> 17th century BCE), with the explicit note that the
    change occurs at the horizon between the 18th and 17th centuries BCE (bins 1800 -> 1700 BCE).
"""
import pandas as pd, numpy as np

# ---------- 1. Load & cross-check the two sources ----------
cap = pd.read_csv('data/capital.csv', decimal=',')
ts  = pd.read_csv('data/time_series_data.csv')

# anchors of the raw (non-interpolated) pottery Z in time_series_data (every 100 y)
anch = ts[ts['PotteryForm'].notna()][['CE', 'PotteryForm', 'PotteryDecoration']].reset_index(drop=True)
over = cap[cap['BCE'] <= 4100].reset_index(drop=True)   # overlapping centuries (4100..500 BCE)

print('CROSS-CHECK capital.csv <-> time_series_data.csv (overlap 4100..500 BCE):')
print('  BCE(capital) == -CE(time_series) :', (over['BCE'].values == -anch['CE'].values).all())
print('  ZKeform == PotteryForm           :', np.allclose(over['ZKeform'].values, anch['PotteryForm'].values))
print('  Zkeverz == PotteryDecoration     :', np.allclose(over['Zkeverz'].values, anch['PotteryDecoration'].values))
print('  calBP = 1950 - CE (time_series)  :', bool((ts['calBP'] == 1950 - ts['CE']).all()))
print()

# ---------- 2. Century-bin table + between-bin deltas ----------
t = cap[['BCE', 'ZKeform', 'Zkeverz']].copy()
t.columns = ['century_anchor_BCE', 'Form', 'Decoration']   # anchor = start-year BCE of the bin
t['CE'] = -t['century_anchor_BCE']                          # temporal anchor column used: CE
t['calBP'] = 1950 + t['century_anchor_BCE']                 # calBP = 1950 - CE
t['dForm'] = t['Form'].diff()
t['dDec']  = t['Decoration'].diff()
print('ANCHOR COLUMN (reporting): CE = -BCE ;  calBP = 1950 - CE =', t['calBP'].tolist()[0], 'at 4300 BCE')

print('\n=== Century-bin pottery table & between-bin deltas ===')
print(t[['century_anchor_BCE', 'CE', 'Form', 'Decoration', 'dForm', 'dDec']].to_string(index=False))

# ---------- 3. Criteria: collapse(Form) + increase(Decoration) in the same transition ----------
THR_FORM = -1.0
THR_DEC  = +1.0
crit = (t['dForm'] <= THR_FORM) & (t['dDec'] >= THR_DEC)
cand = t[crit]
print(f'\n=== criteria: dForm <= {THR_FORM} AND dDec >= +{THR_DEC} (same bin transition) ===')
print(cand[['century_anchor_BCE', 'CE', 'Form', 'Decoration', 'dForm', 'dDec']].to_string(index=False))

# ---------- 4. Persistence check (new level held >= 3 subsequent bins) ----------
assert len(cand) >= 1, 'no candidate found'
i = cand.index[0]
persist_form = (t['Form'].loc[i:i+3] == t['Form'].loc[i]).all()
persist_dec  = (t['Decoration'].loc[i:i+3] == t['Decoration'].loc[i]).all()
print('\nPersistence of new level at candidate bin (next 3 bins):')
print('  Form plateau sustained (>=4 bins):', persist_form, '| value =', t['Form'].loc[i])
print('  Decoration plateau sustained (>=4):', persist_dec, '| nearest value =', t['Decoration'].loc[i])
print('  (Decoration steps from 0.97 to 1.53 at 1000 BCE, still a high positive plateau)')

# ---------- 5. Uniqueness across the full series ----------
others_looser = t[(t['dForm'] <= -0.5) & (t['dDec'] >= 0.5)]
print('\nUniqueness scan (looser grid dForm<=-0.5 & dDec>=+0.5, full range):')
print(others_looser[['century_anchor_BCE', 'dForm', 'dDec']].to_string(index=False))

# ---------- 6. Sensitivity sweep on thresholds (san check only) ----------
dF = t['dForm'].dropna(); dD = t['dDec'].dropna()
print('\nSigma diagnostics: sd(dForm) = %.3f  |  sd(dDec) = %.3f' % (dF.std(), dD.std()))
for thr_f, thr_d, label in [(-0.75*dF.std(), 0.75*dD.std(), '0.75*sigma'),
                            (-1.00*dF.std(), 1.00*dD.std(), '1.00*sigma'),
                            (-1.00, +1.00, 'fixed +-1.0')]:
    sel = t[(t['dForm'] <= thr_f) & (t['dDec'] >= thr_d)]
    print(f'  thresholds {label:10s} (dF<={thr_f:+.2f}, dD>={thr_d:+.2f}) -> bins {sel["century_anchor_BCE"].tolist()}')

# ---------- 7. Confirm 4000 BCE is NOT a valid candidate (both rise) ----------
r4000 = t[t['century_anchor_BCE'] == 4000].iloc[0]
print('\n4000 BCE transition (excluded): dForm = %+.2f (up), dDec = %+.2f (up) -> both INCREASE, not collapse+increase.' % (r4000['dForm'], r4000['dDec']))

# ---------- 8. Summary ----------
print('\n' + '='*70)
print('RESULT')
print('='*70)
print(f'Simultaneous collapse (Form) + increase (Decoration) detected at bin:')
print(f'  anchor  {int(t["century_anchor_BCE"].loc[i])} BCE  (CE={int(t["CE"].loc[i])}, calBP={int(t["calBP"].loc[i])})')
print(f'  Form:       {t["Form"].loc[i-1]:+.2f} -> {t["Form"].loc[i]:+.2f}   (dForm={t["dForm"].loc[i]:+.2f})')
print(f'  Decoration: {t["Decoration"].loc[i-1]:+.2f} -> {t["Decoration"].loc[i]:+.2f}   (dDec={t["dDec"].loc[i]:+.2f})')
print('  Unique under the fixed, loosed and sigma-scaled thresholds; new state persists >=3 bins.')
