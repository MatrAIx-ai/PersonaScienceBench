# -*- coding: utf-8 -*-
"""
Analysis: highest growth phase between 2000 BCE and 1100 BCE.
Canonical growth measure: pollen_grate_100 (100-year smoothed growth rate of
landscape openness, proxy for population), with pollen_inter_100 as level.
Robustness: alternative century-block metrics (mean/max/sustained runs/slope)
and alternative growth series (diff/pct_change of smoothed level, and the
Belau+Woserin pollen file's smoothed/MEAN series). Capital Z-values as
secondary corroboration.
"""
import pandas as pd, numpy as np, json, os

def parse_num(s):
    if s is None or (isinstance(s, str) and s.strip() == ''):
        return np.nan
    return float(str(s).replace(',', '.'))

BASE = '/workspace/data'
OUT  = '/workspace/analysis'
os.makedirs(OUT, exist_ok=True)

# ---------------- Load time_series (canonical) ----------------
t = pd.read_csv(os.path.join(BASE, 'time_series_data.csv'))
t['BCE'] = -t['CE']

# ---------------- Load pollen file (sensitivity) ----------------
p = pd.read_csv(os.path.join(BASE, 'pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv'))
for c in ['Belau_PC1', 'Woserin_PC1', 'Belau_PC1_inter', 'Woserin_PC1_inter', 'MEAN',
          'SMOOTH_MEAN_50y', 'SMOOTH_MEAN_100y', 'SMOOTH_MEAN_150y', 'SMOOTH_MEAN_200y', 'SMOOTH_MEAN_250y']:
    p[c] = p[c].map(parse_num)
p['BCE'] = -p['Unnamed: 0']

# ---------------- Load capital ----------------
c = pd.read_csv(os.path.join(BASE, 'capital.csv'))
for col in c.columns[3:]:
    c[col] = c[col].astype(str).str.replace(',', '.').astype(float)

# ---------------- Window 2000..1100 BCE ----------------
w = t[(t['BCE'] >= 1100) & (t['BCE'] <= 2000)].copy().sort_values('CE')
print('window rows:', len(w), '| BCE', w['BCE'].min(), '..', w['BCE'].max())

# ---------- Century blocks (k = 100*floor(BCE/100): e.g. k=1400 -> BCE 1499..1400) ----------
w['century_key'] = 100 * np.floor(w['BCE'] / 100).astype(int)
def block_label(k):
    # span of BCE years in the block, descending
    return f"{k+99}–{k} a.C." if k != 1100 else f"(año {k} a.C. parcial)"

res = {}
# 1) primary: mean(pollen_grate_100) per century
cent = w.groupby('century_key').agg(
    n=('pollen_grate_100', 'count'),
    mean_grate=('pollen_grate_100', 'mean'),
    median_grate=('pollen_grate_100', 'median'),
    max_grate=('pollen_grate_100', 'max'),
    pct_positive=('pollen_grate_100', lambda s: (s > 0).mean()),
    slope_level=('pollen_inter_100', lambda s: (float(s.iloc[-1])-float(s.iloc[0]))/max(len(s)-1,1)),
    level_first=('pollen_inter_100','first'),
    level_last=('pollen_inter_100','last'),
)
cent['label_bce'] = cent.index.map(block_label)
cent = cent.sort_values('mean_grate', ascending=False)
print('\n=== Primary: mean pollen_grate_100 per century (desc) ===')
print(cent.round(5).to_string())
res['primary_century_means'] = cent.reset_index().to_dict('records')

# ---------- 2) max annual rate ----------
top = w.nlargest(5, 'pollen_grate_100')[['CE', 'BCE', 'pollen_grate_100', 'pollen_inter_100']]
print('\n=== Top-5 annual growth-rate years ===')
print(top.to_string(index=False))
res['top_annual'] = top.to_dict('records')

# ---------- 3) sustained positive runs ----------
pos = (w['pollen_grate_100'] > 0).astype(int)
runs = []
start = None
for i, v in pos.items():
    if v == 1 and start is None:
        start = i
    if v == 0 and start is not None:
        runs.append((start, i - 1)); start = None
if start is not None:
    runs.append((start, pos.index[-1]))
runs_info = []
for a, b in runs:
    seg = w.loc[a:b]
    runs_info.append(dict(start_bce=int(-seg['CE'].iloc[0]), end_bce=int(-seg['CE'].iloc[-1]),
                          years=int(len(seg)), mean_grate=float(seg['pollen_grate_100'].mean()),
                          mean_level=float(seg['pollen_inter_100'].mean())))
runs_info.sort(key=lambda r: (-r['mean_grate'], -r['years']))
print('\n=== Sustained positive runs (top by mean rate) ===')
for r in runs_info[:5]:
    print(f"{r['start_bce']}–{r['end_bce']} a.C.  years={r['years']}  mean_grate={r['mean_grate']:.5f}  mean_level={r['mean_level']:.3f}")
res['positive_runs'] = runs_info

# ---------- 4) alternative growth series (sensitivity) ----------
w = w.assign(
    g_diff_level   = w['pollen_inter_100'].diff(),          # annual change of level
    g_pct_level    = w['pollen_inter_100'].pct_change()*100,# pct change of level
)
pp = p[(p['BCE'] >= 1100) & (p['BCE'] <= 2000)].sort_values('Unnamed: 0').copy()
pp = pp.assign(
    g_smooth100 = pp['SMOOTH_MEAN_100y'].diff(),
    g_pct_smooth100 = pp['SMOOTH_MEAN_100y'].pct_change()*100,
    g_mean = pp['MEAN'].diff(),
)
# join onto w by BCE
alt = w.merge(pp[['BCE', 'g_smooth100', 'g_pct_smooth100', 'g_mean']], on='BCE', how='left')
alt = alt.dropna(subset=['BCE'])
gcols = {'grate_100_ts': 'pollen_grate_100',
         'diff_level_ts': 'g_diff_level',
         'pct_level_ts': 'g_pct_level',
         'diff_smooth100_pollenfile': 'g_smooth100',
         'pct_smooth100_pollenfile': 'g_pct_smooth100',
         'diff_MEAN_pollenfile': 'g_mean'}
sens = pd.DataFrame({'century_key': alt['century_key']})
for name, col in gcols.items():
    sens[name] = alt[col]
sens = sens.groupby('century_key')[list(gcols.keys())].mean()
for gc in gcols.keys():
    sens[f'rank_{gc}'] = sens[gc].rank(ascending=False, method='min')
print('\n=== Sensitivity: mean growth per century across 6 growth series (rank) ===')
print(sens.round(5).to_string())
res['sensitivity_century_means'] = sens.reset_index().to_dict('records')

# ---------- 5) level trajectory summary ----------
lev = w.groupby('century_key')['pollen_inter_100'].agg(['first', 'last']).sort_index()
lev.columns = ['level_at_block_start', 'level_at_block_end']
print('\n=== Level trajectory by century (100-yr smoothing) ===')
print(lev.round(3).to_string())
res['level_trajectory'] = lev.reset_index().to_dict('records')

# ---------- 6) Capital corroboration ----------
cw = c[(c['BCE'] >= 1100) & (c['BCE'] <= 2000)].copy()
print('\n=== Capital Z-values 2000..1100 BCE ===')
print(cw.round(3).to_string(index=False))
cap_max = cw[c.columns[3:]].max()
print('\ncapital Z max in window:')
print(cap_max.round(3).to_string())
res['capital_window'] = cw.to_dict('records')
res['capital_window_max'] = cap_max.to_dict()

# ---------- summary result ----------
winner = cent.index[0]
print('\n=== WINNER (primary) ===')
print('century_key:', winner, '| span:', cent.loc[winner, 'label_bce'], '| mean_grate:', round(cent.loc[winner, 'mean_grate'], 5))
res['winner_primary'] = {'century_key': int(winner), 'label_bce': cent.loc[winner, 'label_bce'],
                         'mean_grate': float(cent.loc[winner, 'mean_grate'])}

with open(os.path.join(OUT, 'results.json'), 'w') as f:
    json.dump(res, f, indent=2, default=str)
print('\nsaved ->', os.path.join(OUT, 'results.json'))

# ============ Standard-century report (clean labeling) ============
import math
def std_cent(bce):
    return int(math.ceil(bce / 100) * 100) // 100
w2 = w.copy()
w2['std_century'] = w2['BCE'].apply(std_cent)
g2 = w2.groupby('std_century').agg(
    n=('pollen_grate_100', 'count'),
    mean_grate=('pollen_grate_100', 'mean'),
    median=('pollen_grate_100', 'median'),
    max_g=('pollen_grate_100', 'max'),
    pct_pos=('pollen_grate_100', lambda s: (s > 0).mean()),
    slope=('pollen_inter_100', lambda s: (float(s.iloc[-1]) - float(s.iloc[0])) / max(len(s) - 1, 1)))
g2['span_bce'] = g2.index.map(lambda k: f"{k*100}–{k*100-99} a.C.")
g2 = g2.sort_values('mean_grate', ascending=False)
print('\n=== Standard centuries (desc by mean grate) ===')
print(g2.round(5).to_string())
res['standard_centuries'] = g2.reset_index().to_dict('records')
res['century_consensus'] = {'top1': f"{g2.index[0]}º siglo a.C. ({g2.iloc[0]['span_bce']}) mean={round(float(g2.iloc[0]['mean_grate']),5)}",
                            'top2': f"{g2.index[1]}º siglo a.C. ({g2.iloc[1]['span_bce']}) mean={round(float(g2.iloc[1]['mean_grate']),5)}"}

with open(os.path.join(OUT, 'results.json'), 'w') as f:
    json.dump(res, f, indent=2, default=str)
print('\nfinal saved ->', os.path.join(OUT, 'results.json'))
print('FINAL CONSENSUS:', json.dumps(res['century_consensus'], ensure_ascii=False))
