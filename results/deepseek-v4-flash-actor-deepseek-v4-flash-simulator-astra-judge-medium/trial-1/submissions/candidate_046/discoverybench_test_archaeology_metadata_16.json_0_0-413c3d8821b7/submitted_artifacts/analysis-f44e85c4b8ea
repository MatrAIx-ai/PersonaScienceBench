"""
Capital PCA on hundred-year slices (BCE 4300..500), capital.csv.
Question: How were the Middle Neolithic (3400-3000 BCE) and Younger Neolithic
(2900-2300 BCE) characterized in terms of PC1 of a PCA on the forms of capital?

Pipeline:
  1) load capital.csv; convert comma decimals; drop group/color metadata.
  2) correlation-based PCA (standardize the 12 Z variables across 39 slices) via SVD;
     eigenvalues reported from the correlation matrix (sum = p = 12).
  3) fix PC1 sign so that the sum of PC1 loadings > 0 (PC1 = "overall capital" axis).
  4) report loadings (per variable and per capital type), eigenvalue/explained variance,
     and per-slice PC1 scores.
  5) characterize MN (3400-3000 BCE; 5 slices) and Younger Neolithic SG (2900-2300 BCE; 7 slices):
     mean PC1 +/- sd vs whole-series baseline and vs EN (4300-3500) and LN (2200-1700);
     dominant capital types via loadings weighted by actual variable values.
  6) pollen Belau_PC1 kept separate (demographic/openness context only, clearly labeled).
"""
import numpy as np
import pandas as pd

# ---------------- 1) load & clean capital.csv ----------------
cap = pd.read_csv('data/capital.csv')
for c in cap.columns:
    if c in ('BCE', 'group', 'color'):
        continue
    cap[c] = cap[c].astype(str).str.replace(',', '.').astype(float)

zcols = ['ZAxtSchwert', 'ZDolch', 'Zhausgr', 'ZCU_AU', 'Zamber', 'ZMonument',
         'ZHort', 'ZSichel', 'ZBeil', 'ZMW', 'ZKeform', 'Zkeverz']
cap_type = {
    'symbolic': ['ZAxtSchwert', 'ZDolch', 'Zhausgr'],
    'social':   ['ZCU_AU', 'Zamber', 'ZMonument'],
    'cultural': ['ZKeform', 'Zkeverz'],
    'economic': ['ZHort', 'ZSichel', 'ZBeil', 'ZMW'],
}

X = cap[zcols].values.astype(float)          # 39 x 12
bce = cap['BCE'].values

print('capital.csv: %d slices, BCE %d..%d, 12 Z variables, NAs = %d'
      % (len(cap), bce.min(), bce.max(), cap[zcols].isna().sum().sum()))

# ---------------- 2) correlation-based PCA ----------------
mu, sd = X.mean(0), X.std(0, ddof=0)
Xs = (X - mu) / sd
U, S, Vt = np.linalg.svd(Xs, full_matrices=False)
loadings = Vt.T
scores = (U * S)

# correlation-matrix eigenvalues (interpretable: sum = p = 12)
C = np.corrcoef(X, rowvar=False)
evals = np.linalg.eigvalsh(C)[::-1]

# ---------------- 3) fix PC1 sign: sum of loadings > 0 ----------------
if loadings[:, 0].sum() < 0:
    loadings[:, 0] = -loadings[:, 0]
    scores[:, 0] = -scores[:, 0]

print('\n--- Explained variance (eigenvalues of correlation matrix; total = 12) ---')
for i in range(4):
    print('PC%d eigenvalue=%.4f  variance-explained=%.4f (%.2f%%)  cumsum=%.4f'
          % (i+1, evals[i], evals[i]/12.0, 100*evals[i]/12.0, evals[:i+1].sum()/12.0))

print('\n--- PC1 loadings (sign fixed: sum of loadings = %.3f > 0) ---' % loadings[:, 0].sum())
tab = pd.DataFrame({'variable': zcols, 'loading': loadings[:, 0],
                    'capital_type': [t for v in zcols for t, vs in cap_type.items() if v in vs]})
print(tab.to_string(index=False, float_format=lambda x: '%.4f' % x))

print('\n--- PC1 loadings aggregated by capital type ---')
agg = tab.groupby('capital_type')['loading'].agg(['mean', 'sum'])
agg['n'] = tab.groupby('capital_type').size()
print(agg.to_string(float_format=lambda x: '%.4f' % x))

print('\n--- Per-slice PC1 scores ---')
sc = pd.DataFrame({'BCE': bce, 'PC1': scores[:, 0], 'phase': cap['group']})
print(sc.to_string(index=False, float_format=lambda x: '%.4f' % x))

# ---------------- 5) phase characterization ----------------
base_mean = scores[:, 0].mean()
base_sd = scores[:, 0].std(ddof=1)
phases = [('EN (4300-3500 BCE)', 4300, 3500),
          ('MN Middle Neolithic (3400-3000 BCE)', 3400, 3000),
          ('YN/SG Younger Neolithic (2900-2300 BCE)', 2900, 2300),
          ('LN (2200-1700 BCE)', 2200, 1700)]

print('\n--- Phase mean PC1 (whole-series mean = %.3f, sd = %.3f over %d slices) ---'
      % (base_mean, base_sd, len(scores)))
for label, lo, hi in phases:
    m = (bce >= hi) & (bce <= lo)
    sl = scores[m, 0]
    z = (sl.mean() - base_mean) / (base_sd / np.sqrt(len(sl)))
    print('%-38s n=%d  mean PC1=%+.4f +/- %.4f  (z-vs-baseline=%+.2f)  sign=%s'
          % (label, m.sum(), sl.mean(), sl.std(ddof=1), z,
             'positive' if sl.mean() > 0 else 'negative'))

print('\n--- Dominant capital types per phase (mean contribution = loading x standardized value, summed per type; drives PC1) ---')
for label, lo, hi in phases:
    m = (bce >= hi) & (bce <= lo)
    out = {}
    for t, vs in cap_type.items():
        out[t] = round(float(sum((Xs[m, zcols.index(v)] * loadings[zcols.index(v), 0]).mean()
                                 for v in vs)), 4)   # total pull of the type on PC1
    print('%s -> %s' % (label, out))

# ---------------- 6) pollen context (separate proxy, clearly labeled) ----------------
pol = pd.read_csv('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv')
for c in ['Belau_PC1', 'SMOOTH_MEAN_100y']:
    pol[c] = pol[c].astype(str).str.replace(',', '.').astype(float)
print('\n--- Pollen openness context (SEPARATE already-computed PCA; NOT part of the capital PCA) ---')
for label, b_hi, b_lo in [('MN 3400-3000 BCE', 3400, 3000), ('YN/SG 2900-2300 BCE', 2900, 2300)]:
    # CE = -BCE, so older time is more negative CE: CE in [-b_hi, -b_lo]
    seg = pol[(pol['CE'] >= -b_hi) & (pol['CE'] <= -b_lo)]
    print('%s n=%d  Belau_PC1 mean=%+.3f (sd=%.3f)  SMOOTH_MEAN_100y mean=%+.3f'
          % (label, len(seg), seg['Belau_PC1'].mean(), seg['Belau_PC1'].std(), seg['SMOOTH_MEAN_100y'].mean()))

print('\nDONE')
