"""
PCA de las formas de capital en cortes de 100 anos (capital.csv), Edad del Bronce
Joven 1100-500 a.C.  Compara PC1 en 1100 a.C. (corte unico) vs horizontes 1000-500 a.C.
Implementacion: numpy SVD. Signo de PC1 fijado: carga de mayor |magnitud| positiva.
"""
import pandas as pd, numpy as np

# ---------- 1. Carga y parseo ----------
capital = pd.read_csv("data/capital.csv")
ZCOLS = ["ZAxtSchwert","ZDolch","Zhausgr","ZCU_AU","Zamber","ZMonument","ZHort",
         "ZSichel","ZBeil","ZMW","ZKeform","Zkeverz"]
Z = capital[ZCOLS].apply(lambda s: s.str.replace(",", ".").astype(float))
bce = capital["BCE"].values
group = capital["group"].values
print("capital.csv cortes:", bce.min(), "-", bce.max(), "| paso 100:", np.all(np.diff(bce) == -100))

ts = pd.read_csv("data/time_series_data.csv")
tsmap = {"ZAxtSchwert":"HatchetSword","ZDolch":"Dagger","Zhausgr":"HouseSize",
         "ZCU_AU":"CopperGold","Zamber":"Amber","ZMonument":"MonumentCount",
         "ZHort":"Depot","ZSichel":"Sickle","ZBeil":"AxesCelts","ZMW":"MonumentSize",
         "ZKeform":"PotteryForm","Zkeverz":"PotteryDecoration"}
ok = True
for b in bce:
    r = ts[ts["CE"] == -b]
    if len(r) == 0: continue
    if not np.allclose(r[list(tsmap.values())].iloc[0].values,
                       Z[capital["BCE"] == b].iloc[0].values, atol=1e-9): ok = False
print("calBP = 1950 - CE:", np.allclose(ts["calBP"], 1950 - ts["CE"]),
      "| coinciden capital<->time_series:", ok)

# ---------- 2. PCA principal (39 cortes, centrado) ----------
X = Z.values - Z.values.mean(axis=0)
U, S, Vt = np.linalg.svd(X, full_matrices=False)
scores = U * S
loadings = Vt.copy()
for p in range(loadings.shape[0]):
    if loadings[p][np.argmax(np.abs(loadings[p]))] < 0:
        loadings[p] = -loadings[p]; scores[:, p] = -scores[:, p]
evr = S**2 / np.sum(S**2)
print("\n=== PCA principal (39 cortes, centrado) ===")
print("Varianza explicada PC1..PC4:", np.round(evr[:4], 4), "| PC1+PC2:", round(float((evr[0]+evr[1])*100), 2), "%")
print("Cargas PC1:", {c: round(w, 3) for c, w in zip(ZCOLS, loadings[0])})
print("\nScore PC1 por corte:")
for b, s, g in zip(bce, scores[:, 0], group):
    print(f"  {int(b):5d} a.C. {g:3s} PC1={s:+.3f}")

idx1100 = np.where(bce == 1100)[0][0]
later_mask = (bce >= 500) & (bce <= 1000)
pc1_1100 = scores[idx1100, 0]; pc1_later = scores[later_mask, 0]
print("\n=== Comparacion: 1100 a.C. vs 1000-500 a.C. ===")
print(f"PC1(1100 a.C.) = {pc1_1100:+.3f}")
for b, s in zip(bce[later_mask], pc1_later):
    print(f"  {int(b)} a.C.  PC1={s:+.3f}   diff(1100-{int(b)})={pc1_1100 - s:+.3f}")
mu = pc1_later.mean()
print(f"media(1000-500) = {mu:+.3f} | diff(1100 - media) = {pc1_1100 - mu:+.3f}")
print("1100 > todos los horizontes 1000-500:", bool(np.all(pc1_1100 > pc1_later)))
y_win = scores[(bce >= 500) & (bce <= 1100), 0]; x_win = -bce[(bce >= 500) & (bce <= 1100)]
slope = np.polyfit(x_win, y_win, 1)[0]; corr = np.corrcoef(x_win, y_win)[0, 1]
print(f"tendencia PC1 en 1100-500: slope = {slope:+.3f}/año ({slope*100:+.2f}/siglo), corr = {corr:+.3f}")

# ---------- 3. Variantes ----------
print("\n=== Variantes de robustez ===")
m_yba = (bce >= 500) & (bce <= 1100)   # 7 cortes YBA
Xy = Z.values[m_yba] - Z.values[m_yba].mean(axis=0)
Uy, Sy, Vty = np.linalg.svd(Xy, full_matrices=False)
scy = Uy * Sy
for p in range(Vty.shape[0]):
    if Vty[p][np.argmax(np.abs(Vty[p]))] < 0: Vty[p] = -Vty[p]; scy[:, p] = -scy[:, p]
yb = bce[m_yba]; iy = np.where(yb == 1100)[0][0]; my = (yb >= 500) & (yb <= 1000)
print("V1 PCA solo-YBA (7 cortes): PC1(1100)={:+.3f} | 1000-500=[{}] | media={:+.3f} | var PC1={:.3f}".format(
    scy[iy,0], ", ".join(f"{v:+.2f}" for v in scy[my,0]), scy[my,0].mean(), (Sy[0]**2)/np.sum(Sy**2)))
print("   1100 mayor que todos (solo-YBA):", bool(np.all(scy[iy,0] > scy[my,0])))
print("   cargas PC1 (solo-YBA):", {c: round(w, 3) for c, w in zip(ZCOLS, Vty[0])})

U2, S2, Vt2 = np.linalg.svd(Z.values, full_matrices=False)
sc2 = U2 * S2
for p in range(Vt2.shape[0]):
    if Vt2[p][np.argmax(np.abs(Vt2[p]))] < 0: Vt2[p] = -Vt2[p]; sc2[:, p] = -sc2[:, p]
i2 = np.where(bce == 1100)[0][0]; m2 = (bce >= 500) & (bce <= 1000)
print("V2 PCA sin centrar: PC1(1100)={:+.3f} | media(1000-500)={:+.3f} | 1100>media: {}".format(
    sc2[i2,0], sc2[m2,0].mean(), sc2[i2,0] > sc2[m2,0].mean()))

inter = [c + "_inter" for c in tsmap.values()]
ts_i = ts[["CE"] + inter].set_index("CE").sort_index()
years_all = ts_i.index.values
pc1_all = ts_i.values @ loadings[0]
def bin_mean_ce(ce0, ce1):  # CE en (ce0, ce1] con ce0<ce1
    m = (years_all >= ce0) & (years_all < ce1)
    return pc1_all[m].mean() if m.sum() else np.nan
print("V3 bins anuales interpolados proyectados sobre PC1 (full-range); '1100 a.C.' = bin [1100,1000):")
for a, b in [(1100,1000),(1000,900),(900,800),(800,700),(700,600),(600,500),(500,450)]:
    v = bin_mean_ce(-a, -b)   # a.C. [a,b) -> CE (-a, -b]
    print(f"   bin {a}-{int(b)} a.C.  mean PC1 anual = {v:+.3f}")

res = pd.DataFrame({"BCE": bce, "group": group, "PC1": scores[:, 0]})
res.to_csv("pc1_scores_by_slice.csv", index=False)
print("\nGuardado: pc1_scores_by_slice.csv")
