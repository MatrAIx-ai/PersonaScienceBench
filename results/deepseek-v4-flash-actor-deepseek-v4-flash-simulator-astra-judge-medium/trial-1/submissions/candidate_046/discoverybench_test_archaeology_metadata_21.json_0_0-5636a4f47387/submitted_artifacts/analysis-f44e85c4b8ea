#!/usr/bin/env python3
"""
Main analysis: PCA on forms of capital in hundred-year time slices (4100-500 BCE).

Primary source : raw Z values in time_series_data.csv, which are defined EXACTLY at
                 centennial time points (37 points, gaps = 100 yrs).
Robustness check: interpolated (_inter) series binned into 100-year means (37 bins).
"""
import pandas as pd, numpy as np

TS = 'data/time_series_data.csv'
COLS = ['HatchetSword','Dagger','HouseSize','CopperGold','Amber','MonumentCount',
        'Depot','Sickle','AxesCelts','MonumentSize','PotteryForm','PotteryDecoration']
LABELS = {
    'HatchetSword':'Hatchet/Sword (symbolic)',
    'Dagger':'Dagger (symbolic)',
    'HouseSize':'House Size (symbolic)',
    'CopperGold':'Copper+Gold (social)',
    'Amber':'Amber (social)',
    'MonumentCount':'Monument Count (social)',
    'PotteryForm':'Pottery Form (cultural)',
    'PotteryDecoration':'Pottery Decoration (cultural)',
    'Depot':'Depot/Hoard (economic)',
    'Sickle':'Sickle (economic)',
    'AxesCelts':'Axes/Celts (economic)',
    'MonumentSize':'Monument Size (economic)',
}
SYMB = ['HouseSize','Dagger','HatchetSword']

def pca(X):
    """PCA on N x p data: variables standardized to unit variance. Returns loadings, evals, scores."""
    mu = X.mean(axis=0)
    sd = X.std(axis=0, ddof=0)
    sd[sd==0] = 1.0
    Xz = (X - mu) / sd
    evals, evecs = np.linalg.eigh(np.cov(Xz.T))
    order = np.argsort(evals)[::-1]
    evals, evecs = evals[order], evecs[:, order]
    scores = Xz @ evecs
    return mu, sd, evals, evecs, scores, Xz

ts = pd.read_csv(TS, index_col=0)
raw = ts[ts['HouseSize'].notna()].copy()
X = raw[COLS].values
ce = raw['CE'].values

mu, sd, evals, evecs, scores, Xz = pca(X)
var_ratio = evals / evals.sum()

print('='*80)
print('PRIMARY  PCA  | RAW centennial Z values | %d rows x %d vars' % X.shape)
print('='*80)
print('Century points (CE):', ce[0], '->', ce[-1], '| n =', len(ce))
print('Eigenvalues (PC1..PC4):', np.round(evals[:4],3))
print('Variance explained (PC1..PC4):', np.round(var_ratio[:4],3))
print('Cumulative PC1: %.3f | PC1+PC2: %.3f' % (var_ratio[0], var_ratio[:2].sum()))

ld = pd.DataFrame(evecs[:, :2], index=COLS, columns=['PC1','PC2'])
print('\nLOADINGS (PC1, PC2) - all 12 variables:')
print(ld.round(3).to_string())
print('\nLoadings of the THREE symbolic components on PC1 (same pole?):')
s = ld.loc[SYMB]
for c in SYMB:
    print('  %-14s PC1=%+.3f   PC2=%+.3f' % (c, ld.loc[c,'PC1'], ld.loc[c,'PC2']))
print('  All three PC1 loadings have SAME sign:', (s['PC1']*s['PC1'].iloc[0] > 0).all())
print('  PC2 ordering (most negative -> least):', ', '.join(s['PC2'].sort_values().index))

print('\nSCORES PC1 / PC2 (distribution across the two components):')
scores_df = pd.DataFrame({'CE': ce, 'PC1': scores[:,0], 'PC2': scores[:,1]})
print(scores_df.round(3).to_string(index=False))
print('\nPC2 score margin: min=%.3f max=%.3f std=%.3f range=%.3f'
      % (scores[:,1].min(), scores[:,1].max(), scores[:,1].std(), scores[:,1].max()-scores[:,1].min()))
print('PC1 score margin: min=%.3f max=%.3f std=%.3f'
      % (scores[:,0].min(), scores[:,0].max(), scores[:,0].std()))

# ---- Robustness: interpolated series binned into 100-year means ----
print('='*80)
print('ROBUSTNESS CHECK | interpolated (_inter) series binned to 100-yr means (37 bins)')
print('='*80)
inter_cols = [c+'_inter' for c in COLS]
ts['bin100'] = (ts['CE'] // 100) * 100
bins = ts.groupby('bin100')[inter_cols].mean().sort_index()
print('Bins (CE):', bins.index.min(), '->', bins.index.max(), '| n bins =', len(bins))
mu2, sd2, evals2, evecs2, scores2, Xz2 = pca(bins[inter_cols].values)
var2 = evals2/evals2.sum()
print('Variance explained PC1=%.3f PC2=%.3f' % (var2[0], var2[1]))
ld2 = pd.DataFrame(evecs2[:, :2], index=COLS, columns=['PC1','PC2'])
print('Symbolic loadings (binned interpolated):')
for c in SYMB:
    print('  %-14s PC1=%+.3f   PC2=%+.3f' % (c, ld2.loc[c,'PC1'], ld2.loc[c,'PC2']))
s2 = ld2.loc[SYMB]
print('  All three same sign on PC1:', (s2['PC1']*s2['PC1'].iloc[0] > 0).all())
print('  PC2 ordering:', ', '.join(s2['PC2'].sort_values().index))

# Compare primary vs robustness for the 3 symbolic vars
print('\nComparison (primary vs binned-interpolated) - symbolic components:')
cmp = pd.DataFrame({'var': SYMB,
                    'PC1_primary': ld.loc[SYMB,'PC1'].values,
                    'PC1_binned': ld2.loc[SYMB,'PC1'].values,
                    'PC2_primary': ld.loc[SYMB,'PC2'].values,
                    'PC2_binned': ld2.loc[SYMB,'PC2'].values})
print(cmp.round(3).to_string(index=False))
corr_pc1 = np.corrcoef(ld.loc[COLS,'PC1'], ld2.loc[COLS,'PC1'])[0,1]
corr_pc2 = np.corrcoef(ld.loc[COLS,'PC2'], ld2.loc[COLS,'PC2'])[0,1]
print('Correlation of all-12 loadings primary vs binned: PC1 r=%.3f, PC2 r=%.3f' % (corr_pc1, corr_pc2))

np.save('/workspace/loadings_primary.npy', evecs[:, :2])
np.save('/workspace/scores_primary.npy', scores[:, :2])
ld.round(4).to_csv('/workspace/loadings_primary.csv')
scores_df.round(4).to_csv('/workspace/scores_primary.csv', index=False)
print('\nSaved: loadings_primary.csv, loadings_primary.npy, scores_primary.csv, scores_primary.npy')
