#!/usr/bin/env python3
"""
DiscoveryBench analysis: 3400-3000 BCE, monuments & axes (Z) vs. symbolic capital.
Raw 100-year bins are canonical evidence; annual interpolated series as robustness.
"""
import pandas as pd, io, csv
import numpy as np
from scipy import stats

OUT = {}
def report(k, v):
    OUT[k] = v
    print(f"{k}: {v}")

# ---------- Load time_series_data.csv (annual, interpolated) ----------
ts = pd.read_csv("data/time_series_data.csv")  # CE = -BCE
# ---------- Load capital.csv (raw 100-yr bins, European decimal commas) ----------
raw = open("data/capital.csv","r",encoding="utf-8",errors="replace").read()
rows = list(csv.reader(io.StringIO(raw)))
hdr, data = rows[0], rows[1:]
def euro(x):
    x = str(x).strip().strip('"')
    try: return float(x.replace(",", "."))
    except: return None
cap = pd.DataFrame(data, columns=hdr)
for c in hdr[3:]:
    cap[c] = cap[c].apply(euro)
cap["BCE"] = cap["BCE"].astype(int)

# column mapping: (capital label -> [capital.csv col, time_series inter col])
SERIES = {
    "Monuments (MonumentCount/ZMonument)": ("ZMonument", "MonumentCount_inter"),
    "Axes (AxesCelts/ZBeil)":               ("ZBeil",      "AxesCelts_inter"),
    "SymCap HatchetSword (ZAxtSchwert)":    ("ZAxtSchwert","HatchetSword_inter"),
    "SymCap Dagger (ZDolch)":               ("ZDolch",     "Dagger_inter"),
    "SymCap HouseSize (Zhausgr)":           ("Zhausgr",    "HouseSize_inter"),
    "SymCap CopperGold (ZCU_AU)":           ("ZCU_AU",     "CopperGold_inter"),
    "SymCap Amber (Zamber)":                ("Zamber",     "Amber_inter"),
    "MonumentSize (ZMW)":                   ("ZMW",        "MonumentSize_inter"),
}
LAB, CAPCOL, INTERCOL = list(zip(*[(k, v[0], v[1]) for k, v in SERIES.items()]))

# ---------- Window 3400-3000 BCE inclusive, raw bins ----------
win = cap[(cap["BCE"] >= 3000) & (cap["BCE"] <= 3400)].sort_values("BCE", ascending=False).reset_index(drop=True)
print("=== RAW 100-yr points, window 3400-3000 BCE (inclusive) ===")
print(win[["BCE"] + list(CAPCOL)].to_string(index=False))

# ---------- Net deltas (3000 vs 3400) and peaks ----------
print("\n=== Direction of change: net 3400->3000, peak, excursion ===")
start_end, peaks = {}, {}
for lab, ccol in zip(LAB, CAPCOL):
    v = win[ccol].astype(float).values
    start, end = v[0], v[-1]
    ipeak = int(np.argmax(np.abs(v - start)))
    # peak value & year
    pv, py = v[ipeak], win["BCE"].iloc[ipeak]
    start_end[lab] = (start, end, end - start)
    peaks[lab] = (pv, int(py), pv - start)
    print(f"{lab:38s} start3400={start:7.3f} end3000={end:7.3f} net={end-start:+7.3f} | "
          f"max-excursion={pv:7.3f} at {int(py)} BCE (vs start {pv-start:+.3f})")

# ---------- Correlations on the 5 raw points ----------
print("\n=== Correlations on n=5 raw points (Pearson r / Spearman rho) ===")
corr_tabs = {}
mon = win["ZMonument"].astype(float).values
axe = win["ZBeil"].astype(float).values
for lab, ccol in zip(LAB, CAPCOL):
    if ccol in ("ZMonument", "ZBeil"):
        continue
    v = win[ccol].astype(float).values
    r_m, p_m = stats.pearsonr(mon, v)
    r_a, p_a = stats.pearsonr(axe, v)
    rs_m, ps_m = stats.spearmanr(mon, v)
    rs_a, ps_a = stats.spearmanr(axe, v)
    corr_tabs[lab] = dict(mon_r=r_m, mon_rho=rs_m, axe_r=r_a, axe_rho=rs_a)
    print(f"{lab:34s} | vs Monuments: r={r_m:+.3f} (p={p_m:.3f}) rho={rs_m:+.3f} | "
          f"vs Axes: r={r_a:+.3f} (p={p_a:.3f}) rho={rs_a:+.3f}")

# ---------- Correlations on annual interpolated series (robustness, n=401) ----------
print("\n=== Correlations on annual interpolated series n=401 (robustness) ===")
wts = ts[(ts["CE"] >= -3400) & (ts["CE"] <= -3000)].reset_index(drop=True)
icorr = {}
for lab, ccol, icol in zip(LAB, CAPCOL, INTERCOL):
    if ccol in ("ZMonument", "ZBeil"):
        continue
    m = wts["MonumentCount_inter"].values.astype(float)
    a = wts["AxesCelts_inter"].values.astype(float)
    v = wts[icol].values.astype(float)
    r_m, r_a = stats.pearsonr(m, v)[0], stats.pearsonr(a, v)[0]
    rs_m, rs_a = stats.spearmanr(m, v)[0], stats.spearmanr(a, v)[0]
    icorr[lab] = dict(mon_r=r_m, mon_rho=rs_m, axe_r=r_a, axe_rho=rs_a)
    print(f"{lab:34s} | vs Monuments: r={r_m:+.3f} rho={rs_m:+.3f} | "
          f"vs Axes: r={r_a:+.3f} rho={rs_a:+.3f}")

# ---------- Linear slope over the 5 raw points (per 100-yr step) ----------
print("\n=== Simple linear slope on n=5 raw points (Z per 100-yr bin) ===")
for lab, ccol in zip(LAB, CAPCOL):
    v = win[ccol].astype(float).values
    b = np.polyfit(win["BCE"].values, v, 1)[0]
    print(f"{lab:38s} slope={b:+.4f} /100yr  (i.e. over 400yr window: {b*4:+.3f})")

# ---------- Extra context: pollen MEAN & MonumentSize in window ----------
pr = open("data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv","r",encoding="utf-8",errors="replace").read()
prows = list(csv.reader(io.StringIO(pr)))
phdr, pdata = prows[0], prows[1:]
pdf = pd.DataFrame(pdata, columns=phdr)
for c in phdr[1:]:
    pdf[c] = pdf[c].apply(euro)
pdf["CE"] = pdf["CE"].astype(int)
pwin = pdf[(pdf["CE"] <= -3000) & (pdf["CE"] >= -3400)].copy()
print("\nPollen openness (MEAN) at window edges:", round(pwin["MEAN"].iloc[-1],3),
      "3400BCE ->", round(pwin["MEAN"].iloc[0],3), "3000BCE (net", round(pwin["MEAN"].iloc[0]-pwin["MEAN"].iloc[-1],3), ")")

# ---------- Save compact evidence table ----------
ev = pd.DataFrame({
    "series": LAB,
    "start_3400": [start_end[l][0] for l in LAB],
    "end_3000": [start_end[l][1] for l in LAB],
    "net_3400_3000": [start_end[l][2] for l in LAB],
    "peak_value": [peaks[l][0] for l in LAB],
    "peak_BCE": [peaks[l][1] for l in LAB],
    "peak_excursion_vs_start": [peaks[l][2] for l in LAB],
    "slope_per_100yr": [np.polyfit(win["BCE"].values, win[c].astype(float).values, 1)[0] for c in CAPCOL],
})
ev.to_csv("window_evidence_3400_3000.csv", index=False)
print("\nSaved: window_evidence_3400_3000.csv")
print("\nDONE")
