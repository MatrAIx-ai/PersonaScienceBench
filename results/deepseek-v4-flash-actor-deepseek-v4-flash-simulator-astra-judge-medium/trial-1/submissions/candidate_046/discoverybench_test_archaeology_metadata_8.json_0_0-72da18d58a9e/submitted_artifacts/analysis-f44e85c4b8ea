#!/usr/bin/env python3
"""
DiscoveryBench - archaeology metadata_8
Question: "In which millennium did amber have its highest value and in what
time interval did it peak?"

Approach (approved):
  - 'value' of amber = Z-score series. Primary: Amber_inter (annual linear
    interpolation); cross-check: raw Amber nodes (every 100 yr) and capital.csv Zamber.
  - Millennium assignment: strict convention (4th millennium BCE = BCE 4000-3001).
  - Peak interval = flat plateau where Amber_inter == max (1.54).
  - Robustness window: Amber_inter >= 1.46.
  - Time systems: BCE = -CE (per data files), calBP = 1950 - CE (present = 1950 AD).
"""
import pandas as pd
import numpy as np
import json, os

OUT = "amber_peak_outputs"
os.makedirs(OUT, exist_ok=True)

# ---------------------------------------------------------------- load data
ts = pd.read_csv("data/time_series_data.csv")
cap = pd.read_csv("data/capital.csv")
pol = pd.read_csv("data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv")

# capital.csv uses European comma decimals -> convert numeric cols
def to_num(df, cols):
    for c in cols:
        df[c] = pd.to_numeric(df[c].astype(str).str.replace(",", "."), errors="coerce")
    return df
cap = to_num(cap, [c for c in cap.columns if c not in ("group", "color")])

rows = {}
rows["time_series"] = {"rows": len(ts), "cols": ts.shape[1],
                       "CE_range": [int(ts.CE.min()), int(ts.CE.max())],
                       "calBP_range": [int(ts.calBP.min()), int(ts.calBP.max())]}
rows["capital"] = {"rows": len(cap), "cols": cap.shape[1],
                   "BCE_range": [int(cap.BCE.min()), int(cap.BCE.max())]}
rows["pollen"] = {"rows": len(pol), "cols": pol.shape[1],
                  "CE_range": [int(pol.CE.min()), int(pol.CE.max())]}

# ---------------------------------------------------------------- amber series
ts["BCE"] = -ts["CE"]                      # BCE = -CE per data files
ts["lininterp"] = np.interp(ts["CE"], ts.loc[ts.Amber.notna(), "CE"],
                            ts.loc[ts.Amber.notna(), "Amber"])
maxdiff = float((ts.Amber_inter - ts.lininterp).abs().max())

max_val = float(ts.Amber_inter.max())
min_val = float(ts.Amber_inter.min())

# plateau at the max
plat = ts[np.isclose(ts.Amber_inter, max_val, atol=1e-12)]
plat_ce = (int(plat.CE.min()), int(plat.CE.max()))
plat_bce = (int(plat.BCE.min()), int(plat.BCE.max()))
plat_calbp = (int(plat.calBP.max()), int(plat.calBP.min()))
plat_n = int(len(plat))

# robustness window >= 1.46
hi = ts[ts.Amber_inter >= 1.46]
hi_ce = (int(hi.CE.min()), int(hi.CE.max()))
hi_calbp = (int(hi.calBP.max()), int(hi.calBP.min()))
hi_n = int(len(hi))

# ------------------------------------------------------- per-millennium stats
# strict convention: BCE year y belongs to mill m (label 'm+1th mill BCE'),
# where m = (y-1)//1000  => 4000-3001 -> m=3 -> 4th millennium BCE
def mill_key(y):
    return (int(y) - 1) // 1000
MILL_LABELS = {0: "1st mill BCE (1-1000)", 1: "2nd mill BCE (1001-2000)",
               2: "3rd mill BCE (2001-3000)", 3: "4th mill BCE (3001-4000)",
               4: "5th mill BCE (4001-5000)"}

ts["mill"] = ts.BCE.apply(mill_key)
g = ts.groupby("mill")["Amber_inter"].agg(["max", "mean", "count"])
g2 = ts[ts.Amber.notna()].groupby("mill")["Amber"].agg(["max", "mean", "count"])
g.index = [MILL_LABELS[i] for i in g.index]
g2.index = [MILL_LABELS[i] for i in g2.index]

# which years with value == max belong to each millennium
plat["mill"] = plat.BCE.apply(mill_key)
plat_by_mill = plat.groupby("mill")["BCE"].agg(["min", "max", "count"])
plat_by_mill.index = [MILL_LABELS[i] for i in plat_by_mill.index]

peak_mill_keys = [k for k in g.index if np.isclose(g.loc[k, "max"], max_val, atol=1e-9)]
peak_mill = ", ".join(peak_mill_keys)

# ------------------------------------------------------------------- plot (optional if matplotlib missing)
fig_png = None
try:
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt
    fig, ax = plt.subplots(figsize=(11, 5))
    ax.plot(ts.BCE, ts.Amber_inter, lw=1.2, color="#444", label="Amber_inter (annual linear interp)")
    ax.scatter(ts.loc[ts.Amber.notna(), "BCE"], ts.loc[ts.Amber.notna(), "Amber"],
               s=28, color="#1f77b4", zorder=5, label="Amber (raw 100-yr nodes)")
    ax.axvspan(plat_bce[1], plat_bce[0], color="#2ca02c", alpha=0.30, label="Peak plateau (max 1.54)")
    ax.axvspan(hi.BCE.min(), hi.BCE.max(), color="#ff7f0e", alpha=0.12, label="Robustness window >=1.46")
    ax.axhline(max_val, color="green", ls="--", lw=1, alpha=0.7)
    ax.set_xlabel("BCE (year)   |   BCE = -CE")
    ax.set_ylabel("Amber Z score")
    ax.set_title("Amber Z-score time series: peak plateau BCE 3300-3000 (calBP 5250-4950)")
    ax.legend(fontsize=8, loc="upper right")
    ax.invert_xaxis()
    fig.tight_layout()
    fig_png = os.path.join(OUT, "amber_series_peak.png")
    fig.savefig(fig_png, dpi=150)
    plt.close(fig)
except Exception as e:
    print("NOTE: plot skipped (matplotlib unavailable):", e)

# ASCII fallback visualization (always produced)
print("\nASCII summary of Amber_inter vs BCE (sampled every 100 yr):")
lbl = "BCE"
for _, r in ts[::100].iterrows():
    v = float(r.Amber_inter)
    bar = "#" * int(round((v - (-1.2)) / (1.6 - (-1.2)) * 40))
    print(f"{int(r.BCE):>6}  {v:+.2f}  {bar}")

# ------------------------------------------------------------- capital check
cap_max = float(cap.Zamber.max())
cap_peak = cap.loc[cap.Zamber == cap_max, "BCE"].astype(int)
cap_peak = (int(cap_peak.min()), int(cap_peak.max()))
agreement = bool(np.allclose(
    ts.loc[ts.Amber.notna(), "Amber"].reset_index(drop=True),
    cap.Zamber.sort_index()[-len(ts.loc[ts.Amber.notna(), "Amber"]):].reset_index(drop=True),
    atol=1e-6))

# ------------------------------------------------------------------ final
result = {
  "tables": {
    "time_series": rows["time_series"],
    "capital": rows["capital"],
    "pollen": rows["pollen"],
  },
  "interpolation_verified": maxdiff,
  "amber_series": {"raw_nodes": int(ts.Amber.notna().sum()),
                   "interp_nonnull": int(ts.Amber_inter.notna().sum()),
                   "min": min_val, "max": max_val},
  "peak_interval": {
      "definition": "flat plateau where Amber_inter == max",
      "CE": list(plat_ce), "BCE": list(plat_bce), "calBP": list(plat_calbp),
      "rows": plat_n},
  "robustness_window": {
      "definition": "Amber_inter >= 1.46",
      "CE": list(hi_ce), "BCE": [int(-hi_ce[0]), int(-hi_ce[1])],
      "calBP": list(hi_calbp), "rows": hi_n},
  "per_millennium_interp": g.round(4).to_dict(),
  "per_millennium_raw_nodes": g2.round(4).to_dict(),
  "peak_millennium": peak_mill,
  "max_value_rows_in_each_mill": plat_by_mill.round(0).to_dict(),
  "capital_check": {"Zamber_max": cap_max, "Zamber_peak_BCE": list(cap_peak),
                    "matches_time_series_Amber": agreement},
}

with open(os.path.join(OUT, "results.json"), "w") as f:
    json.dump(result, f, indent=2, default=str)

# ------------------------------------------------------------------- console
print("=" * 78)
print("FINAL ANSWER (data-grounded hypothesis)")
print("=" * 78)
print("Highest amber value (Z = 1.54) was reached in the 4th MILLENNIUM BCE.")
print("Peak interval (flat plateau at the maximum, Amber_inter == 1.54):")
print(f"   BCE  {plat_bce[1]} - {plat_bce[0]}")
print(f"   CE   {plat_ce[0]} - {plat_ce[1]}")
print(f"   calBP {plat_calbp[0]} - {plat_calbp[1]}   (calBP = 1950 - CE)")
print(f"   -> {plat_n} annual rows at the maximum")
print("Robustness (sustained peak window, Amber_inter >= 1.46):")
print(f"   BCE {int(-hi_ce[0])} - {int(-hi_ce[1])} | CE {hi_ce[0]} - {hi_ce[1]} | "
      f"calBP {hi_calbp[0]} - {hi_calbp[1]}  ({hi_n} rows)")
print("=" * 78)
print("PER-MILLENNIUM (Amber_inter): max / mean")
print(g.round(3).to_string())
print()
print("PLATEAU (== max) split by millennium:")
print(plat_by_mill.round(0).to_string())
print()
print("capital.csv cross-check: Zamber max =", cap_max,
      "peak BCE", cap_peak, "| matches time_series Amber:", agreement)
print("Saved:", os.path.join(OUT, "results.json"), "|",
      (os.path.join(OUT, "amber_series_peak.png") if fig_png else "(png skipped)"))
