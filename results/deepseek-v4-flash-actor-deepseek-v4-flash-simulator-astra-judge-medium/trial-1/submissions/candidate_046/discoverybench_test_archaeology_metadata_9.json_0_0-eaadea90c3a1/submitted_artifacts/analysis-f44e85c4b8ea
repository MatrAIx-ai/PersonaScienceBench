"""
DiscoveryBench: archaeology/metadata_9
Question: In which century did summed social capital peak, and which individual
social capital components (copper&gold, amber, monument) increase after/around it?

Study-context definition (archaeology.domain_knowledge.1):
    Social Capital = ZCU_AU (Copper & Gold) + Zamber (Amber) + ZMonument (Monument Count)
Time-series analysis / PCA are done in 100-year bins. capital.csv is authoritative
(values identical to time_series raw at all 37 shared century points); the _inter
annual series is used only as a cross-check.

Operationalization of "increase after the summed peak" (two measures reported):
  I. value at total-peak bin (BCE 1400) vs mean of the immediate ~200-yr post-peak
     window (BCE 1300-1200) and vs the full post-peak window (BCE 1300-500);
  II. each component's own peak century relative to the total peak century,
      plus OLS slope per century over the full post-peak window.
"""
import pandas as pd
import numpy as np

DATA = 'data/'

def parse_comma(s):
    return float(s.replace(',', '.')) if isinstance(s, str) else float(s)

# ----------------------------------------------------------------------
# 1. Load & clean
# ----------------------------------------------------------------------
cap = pd.read_csv(DATA + 'capital.csv')
for c in ['ZAxtSchwert','ZDolch','Zhausgr','ZCU_AU','Zamber','ZMonument',
          'ZHort','ZSichel','ZBeil','ZMW','ZKeform','Zkeverz']:
    cap[c] = cap[c].map(parse_comma)
cap = cap.drop(columns=['group','color']).copy()
cap['BCE'] = cap['BCE'].astype(int)
cap['CE']   = -cap['BCE']
cap['calBP']= 1950 + cap['BCE']            # verified: CE -4100 -> calBP 6050
cap = cap.sort_values('CE').reset_index(drop=True)   # time increasing left->right
cap['SocialCapital'] = cap['ZCU_AU'] + cap['Zamber'] + cap['ZMonument']
comp_cols = ['ZCU_AU','Zamber','ZMonument']
COMP_NAMES = {'ZCU_AU':'Copper & Gold', 'Zamber':'Amber', 'ZMonument':'Monument Count'}

ts = pd.read_csv(DATA + 'time_series_data.csv').sort_values('CE').reset_index(drop=True)
ts['century'] = (ts['CE'] // 100) * 100
ts['Sum_inter'] = ts['CopperGold_inter'] + ts['Amber_inter'] + ts['MonumentCount_inter']
bin_inter = ts.groupby('century')[['CopperGold_inter','Amber_inter',
                                   'MonumentCount_inter','Sum_inter']].mean()
bin_inter.index = -bin_inter.index                      # marker -> BCE start year

print('='*78)
print('STEP 1 - cross-check: capital.csv raw vs time_series raw @ 37 century points')
raw_marker = ts[ts['CopperGold'].notna()][['CE','CopperGold','Amber','MonumentCount']].copy()
raw_marker['BCE'] = -raw_marker['CE']
m = cap.merge(raw_marker, on='BCE', suffixes=('','_ts'))
for a, b in [('ZCU_AU','CopperGold'), ('Zamber','Amber'), ('ZMonument','MonumentCount')]:
    print(f'  max|{a} - {b}| = {(m[a]-m[b]).abs().max():.6f}')

print('\n' + '='*78)
print('STEP 2 - summed social capital peak (100-yr bins, capital.csv)')
pk = cap.loc[cap['SocialCapital'].idxmax()]
print(f'  PEAK bin: BCE {int(pk.BCE)} | CE {int(pk.CE)} | calBP {int(pk.calBP)} '
      f'| SocialCapital = ZCU_AU+Zamber+ZMonument = {pk.SocialCapital:.3f}')
print(f'    components at peak: ZCU_AU(Copper&Gold)={pk.ZCU_AU:.3f}, '
      f'Zamber(Amber)={pk.Zamber:.3f}, ZMonument(MonCount)={pk.ZMonument:.3f}')
print('  Top-4 raw binned sums:')
print(cap.nlargest(4, 'SocialCapital')[['BCE','calBP','ZCU_AU','Zamber','ZMonument','SocialCapital']]
      .round(3).to_string(index=False))
print('  raw tie check: sum@1400=%.3f sum@1300=%.3f (tie in raw sampled values)'
      % (cap.loc[cap.BCE==1400,'SocialCapital'].iloc[0],
         cap.loc[cap.BCE==1300,'SocialCapital'].iloc[0]))
print('  interpolated century-binned SUM cross-check (annual _inter averaged to 100-yr):')
print(bin_inter.loc[[1400,1300,1200,1100]].round(3).to_string())
ib_peak = int(bin_inter['Sum_inter'].idxmax())
print(f'  -> interpolated binned SUM max at BCE {ib_peak} (value {bin_inter.loc[ib_peak,"Sum_inter"]:.3f}) '
      f'-> unambiguously BCE 1400')

# ----------------------------------------------------------------------
# 3. Per-component post-peak analysis
# ----------------------------------------------------------------------
peak_bce = int(pk.BCE)
post = cap[cap['BCE'] < peak_bce].sort_values('BCE', ascending=False)
short_bces = [peak_bce-100, peak_bce-200]      # 1300,1200 (200 yr)
long_bces  = sorted(set(post['BCE'].tolist()))
print('\n' + '='*78)
print('STEP 3 - component behavior relative to TOTAL peak (window definitions stated)')
print(f'  short post-peak window (200 yr): BCE {short_bces} ; '
      f'long post-peak window: BCE {long_bces[0]}..{long_bces[-1]} ({len(long_bces)} bins)')

def ols_slope(x, y):
    x = np.asarray(x, float); y = np.asarray(y, float)
    return float(np.polyfit(x, y, 1)[0])

print(f'\n  {"component":<16}{"val@1400":>9}{"shortMean":>10}{"dShort":>8}'
      f'{"longMean":>9}{"dLong":>7}{"slopeLg":>9}{"ownPk":>7}{"ownVal":>8}  verdict')
verdicts = {}
for c in comp_cols:
    val_at_peak = float(cap.loc[cap['BCE']==peak_bce, c].iloc[0])
    short_mean = float(post.loc[post['BCE'].isin(short_bces), c].mean())
    long_mean  = float(post.loc[post['BCE'].isin(long_bces), c].mean())
    x = post.loc[post['BCE'].isin(long_bces), 'BCE'].values
    y = post.loc[post['BCE'].isin(long_bces), c].values
    slope = ols_slope(-x, y)                     # per century, time ascending
    d_short, d_long = short_mean - val_at_peak, long_mean - val_at_peak
    own_pk_bce = int(cap.loc[cap[c].idxmax(), 'BCE'])
    own_val = float(cap[c].max())
    incr_short = d_short > 1e-9
    incr_long  = d_long  > 1e-9
    late_own   = own_pk_bce < peak_bce
    if incr_short or late_own:
        verdict = 'INCREASES after peak'
        if incr_long: verdict += ' (also net up over full window)'
        else: verdict += ' (up ~200yr; net down later)'
    else:
        verdict = 'not increasing (declines both windows)'
    verdicts[c] = dict(val_at_peak=val_at_peak, short_mean=short_mean, d_short=d_short,
                       long_mean=long_mean, d_long=d_long, slope=slope,
                       own_pk_bce=own_pk_bce, own_val=own_val, incr_short=incr_short,
                       incr_long=incr_long, late_own=late_own, verdict=verdict)
    print(f'  {COMP_NAMES[c]:<16}{val_at_peak:>9.3f}{short_mean:>10.3f}{d_short:>8.3f}'
          f'{long_mean:>9.3f}{d_long:>7.3f}{slope:>9.4f}{own_pk_bce:>7}{own_val:>8.3f}  {verdict}')

print('\n  Raw century-by-century values (BCE 2400..500, run-up + post-peak):')
sub = cap[cap['BCE'].between(500, 2400)]
print(sub[['BCE','calBP','ZCU_AU','Zamber','ZMonument','SocialCapital']].round(3).to_string(index=False))

pd.DataFrame([dict(comp=COMP_NAMES[c], **verdicts[c]) for c in comp_cols]).to_csv('component_analysis.csv', index=False)
cap[['BCE','CE','calBP']+comp_cols+['SocialCapital']].to_csv('social_capital_series_100yr.csv', index=False)

# ----------------------------------------------------------------------
# 4. Context ONLY (not part of the capital answer)
# ----------------------------------------------------------------------
pc = pd.read_csv(DATA + 'pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv')
for c in ['Belau_PC1','Woserin_PC1','Belau_PC1_inter','Woserin_PC1_inter','MEAN',
          'SMOOTH_MEAN_50y','SMOOTH_MEAN_100y','SMOOTH_MEAN_150y','SMOOTH_MEAN_200y','SMOOTH_MEAN_250y']:
    pc[c] = pc[c].map(parse_comma)
pc_ov = pc[(pc['CE'] <= -500) & (pc['CE'] >= -4100)]
g = pc_ov.groupby((pc_ov['CE'] // 100) * 100)['MEAN'].mean()
g.index = -g.index
print('\n' + '='*78)
print('STEP 4 - CONTEXT ONLY (openness/demography, overlap -4100..-500 CE)')
print(f'  Openness PC1 MEAN 100-yr bins: start={g.iloc[0]:.2f}, end={g.iloc[-1]:.2f}, max={g.max():.2f}@BCE {g.idxmax()}')
pt = ts.groupby('century')['pollen_inter_100'].mean()
print('  pollen_inter_100 (openness proxy):')
for b in [1400,1200,1000,800,600,500]:
    print(f'     BCE {b}: {pt.loc[-b]:.2f}')
print(f'  kde_all_mean range: {ts["kde_all_mean"].min():.5f}..{ts["kde_all_mean"].max():.5f}')
print(f'  g_all_mean (KDE growth) range: {ts["g_all_mean"].min():.5f}..{ts["g_all_mean"].max():.5f}')

print('\n' + '='*78)
print('DATA QUIRK NOTES')
print('  - capital.csv z-values are comma-decimal strings (parsed); group/color dropped')
print('  - capital.csv = 39 century bins, BCE 500..4300, no NAs; 100-yr sampling')
print('  - time_series raw indicator z-cols: only 37 non-null century points; _inter = annual linear interp')
print('  - calBP convention: calBP = 1950 - CE (= 1950 + BCE); peak BCE1400 => calBP 3350 (bin 3350..3250)')
print('  - interpolated century-mean values differ slightly from raw point values (interp artifact)')
print('  - raw sum is tied at BCE 1400 & 1300 (both 4.238); interpolated binned series resolves to 1400')
