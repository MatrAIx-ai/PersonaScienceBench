"""
FINAL ANALYSIS
Question: How does the prevalence of non-native plants introduced via gardening
vary based on habitat type?
Data:  invaded_niche_pathways.csv (primary: 632 plots x 37), 
       temporal_trends_contingency_table.csv, invasion_success_pathways.csv,
       phylogenetic_tree.txt
Prevalence (primary) = mean n.gard (count of gardening-introduced non-natives) per plot by habitat.
Also: P(any gardening species)/plot; share n.gard/n.total among invaded plots (n.total>0).
"""
import re, numpy as np, pandas as pd
import statsmodels.api as sm
import statsmodels.formula.api as smf
from statsmodels.discrete.discrete_model import NegativeBinomial
from scipy import stats
from collections import Counter

# ------------------------------------------------------------- load
trends = pd.read_csv("data/temporal_trends_contingency_table.csv", sep="\t")
inv    = pd.read_csv("data/invasion_success_pathways.csv")
niche0 = pd.read_csv("data/invaded_niche_pathways.csv", sep="\t")
assert (niche0["n.total"] == niche0[["n.gard","n.unint","n.agfo"]].sum(axis=1)).all()

ren = {"n.gard":"n_gard","n.unint":"n_unint","n.agfo":"n_agfo","n.total":"n_total",
       "urban.2009.1000m":"urban_2009_1000m","cropland.2009.1000m":"cropland_2009_1000m"}
niche = niche0.rename(columns=ren)
niche["any_gard"]    = (niche["n_gard"]>0).astype(int)
niche["any_non_nat"] = (niche["n_total"]>0).astype(int)

# ------------------------------------------------------------- 1. metrics
inv_plots = niche[niche["n_total"]>0].copy(); inv_plots["share_gard"] = inv_plots["n_gard"]/inv_plots["n_total"]
tab = pd.DataFrame({
    "n_plots":       niche.groupby("habitat").size(),
    "mean_n_gard":   niche.groupby("habitat")["n_gard"].mean(),
    "prop_any_gard": niche.groupby("habitat")["n_gard"].apply(lambda x:(x>0).mean()),
    "n_invaded":     inv_plots.groupby("habitat").size(),
    "share_gard_invaded": inv_plots.groupby("habitat")["share_gard"].mean()}).sort_values("mean_n_gard", ascending=False).round(3)

print("TABLE 1. PREVALENCE PER HABITAT (primary = mean n.gard per plot)\n", tab.to_string(), "\n")
print(f"Global: N plots={len(niche)}, invaded={len(inv_plots)}, mean n.gard/plot={niche['n_gard'].mean():.3f}, "
      f"P(any gard)={niche['any_gard'].mean():.3f}, mean share invaded={inv_plots['share_gard'].mean():.3f}\n")

# ------------------------------------------------------------- 2. models
mb_full = smf.glm("any_gard ~ C(habitat)", data=niche, family=sm.families.Binomial()).fit()
mb_null = smf.glm("any_gard ~ 1", data=niche, family=sm.families.Binomial()).fit()
LR1 = 2*(mb_full.llf-mb_null.llf); P1 = stats.chi2.sf(LR1, mb_full.df_model)
print(f"MODEL binomial P(any gardening)~habitat: LR={LR1:.2f}, df={mb_full.df_model}, p={P1:.2e}, McFadden={1-mb_full.llf/mb_null.llf:.3f}")

mp = smf.glm("n_gard ~ C(habitat)", data=niche, family=sm.families.Poisson()).fit()
mp0= smf.glm("n_gard ~ 1", data=niche, family=sm.families.Poisson()).fit()
LRp=2*(mp.llf-mp0.llf); Pp=stats.chi2.sf(LRp, mp.df_model)
print(f"MODEL count Poisson n.gard~habitat: AIC={mp.aic:.1f}, LR={LRp:.2f}, p={Pp:.2e}, dispersion={mp.deviance/mp.df_resid:.2f}")

X  = sm.add_constant(pd.get_dummies(niche["habitat"], drop_first=True, prefix="h", dtype=float))
X0 = sm.add_constant(np.ones(len(niche)))
nb = NegativeBinomial(niche["n_gard"], X, loglike_method="nb2").fit(maxiter=300, disp=False)
nb0= NegativeBinomial(niche["n_gard"], X0, loglike_method="nb2").fit(maxiter=300, disp=False)
LRn=2*(nb.llf-nb0.llf); Pn=stats.chi2.sf(LRn, nb.df_model-nb0.df_model)
print(f"MODEL count NB2 n.gard~habitat: AIC={nb.aic:.1f}, alpha={nb.params['alpha']:.3f}, LR={LRn:.2f}, p={Pn:.2e}")

covs = "elevation + urban_2009_1000m + cropland_2009_1000m"
mc = smf.glm(f"any_gard ~ {covs}", data=niche, family=sm.families.Binomial()).fit()
mch= smf.glm(f"any_gard ~ {covs} + C(habitat)", data=niche, family=sm.families.Binomial()).fit()
LRc=2*(mch.llf-mc.llf); Pc=stats.chi2.sf(LRc, len(mch.params)-len(mc.params))
print(f"MODEL robustness (binomial): habitat beyond elevation+urban+cropland -> LR={LRc:.2f}, df={len(mch.params)-len(mc.params)}, p={Pc:.2e}; AIC cov-only={mc.aic:.1f} vs +habitat={mch.aic:.1f}")

mcc = smf.glm(f"n_gard ~ {covs}", data=niche, family=sm.families.NegativeBinomial()).fit()
mcch= smf.glm(f"n_gard ~ {covs} + C(habitat)", data=niche, family=sm.families.NegativeBinomial()).fit()
LRc2=2*(mcch.llf-mcc.llf); Pc2=stats.chi2.sf(LRc2, len(mcch.params)-len(mcc.params))
print(f"MODEL robustness (NB count): habitat beyond covariates -> LR={LRc2:.2f}, df={len(mcch.params)-len(mcc.params)}, p={Pc2:.2e}; AIC cov-only={mcc.aic:.1f} vs +habitat={mcch.aic:.1f}")

niche["g"] = np.where(niche["habitat"].isin(["Coastal","Wetlands","Urban","Riparian","Croplands"]),"high_prev","low_prev")
mg = smf.glm("any_gard ~ g", data=niche, family=sm.families.Binomial()).fit()
coef, pv = mg.params["g[T.low_prev]"], mg.pvalues["g[T.low_prev]"]
print(f"CONTRAST high-prev{['Coastal','Wetlands','Urban','Riparian','Croplands']} vs low: P(any gard)={niche['any_gard'][niche['g']=='high_prev'].mean():.3f} vs {niche['any_gard'][niche['g']=='low_prev'].mean():.3f}; mean n.gard {niche['n_gard'][niche['g']=='high_prev'].mean():.3f} vs {niche['n_gard'][niche['g']=='low_prev'].mean():.3f}; OR(low/high)={np.exp(coef):.2f}, p={pv:.2e}")

# habitat-level correlates
hc = pd.concat([niche.groupby("habitat")["n_gard"].mean().rename("mean_n_gard"),
                niche.groupby("habitat")[["annual.temperature","annual.rainfall","elevation","urban_2009_1000m","cropland_2009_1000m"]].mean()], axis=1)
print("\nHabitat-level Spearman corr(mean n.gard, X):")
for c in ["annual.temperature","annual.rainfall","elevation","urban_2009_1000m","cropland_2009_1000m"]:
    r,pv = stats.spearmanr(hc["mean_n_gard"], hc[c]); print(f"  {c}: r={r:+.2f}, p={pv:.3f}")

# ------------------------------------------------------------- 3. context
piv = trends.pivot(index="introduction.period", columns="pathway", values="n").fillna(0)
piv["tot"]=piv.sum(axis=1); piv["gard_share"]=piv["Gardening"]/piv["tot"]
print("\nCONTEXT temporal trends:\n", piv.round(3).to_string())
gard = inv[inv["intro.pathway"]=="Gardening"]
print("\nCONTEXT top gardening invaders (by invaded plots):")
print(gard.sort_values("number.of.invaded.plots",ascending=False).head(8)
      [["Scientific_name","family","number.of.invaded.plots","habitat.range","mrt"]].to_string())
print("\nCONTEXT pathway means (invasion success):")
print(inv.groupby("intro.pathway")[["number.of.invaded.plots","habitat.range","invaded.niche.breadth","mrt"]].mean().round(2).to_string())

with open("data/phylogenetic_tree.txt") as f: tree = f.read()
tips = {t for t in set(re.findall(r'([A-Za-z_][A-Za-z0-9_\.\-]*)\s*:', tree))
        if not (t.startswith("mrcaott") or t in {"Pentapetalae","Caryophyllales"})}
pmap = dict(zip(inv["phylo.tip.label"], inv["intro.pathway"]))
lab  = Counter(v for t,v in pmap.items() if t in tips)
print(f"\nCONTEXT phylogeny: {len(tips)} tips, matched={sum(lab.values())}, composition={dict(lab)}, "
      f"gardening fraction={lab['Gardening']/sum(lab.values()):.3f}")
fam = inv.set_index("phylo.tip.label").loc[[t for t in tips if t in pmap]]
gfam = fam[fam["intro.pathway"]=="Gardening"]["family"].value_counts().head(6)
print("gardening tips top families:", dict(gfam))

tab.to_csv("prevalence_by_habitat.csv")
print("\nSaved: prevalence_by_habitat.csv")
