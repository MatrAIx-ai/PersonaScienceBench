# -*- coding: utf-8 -*-
"""Full analysis: gardening pathway prevalence styles across habitat types.
Datasets: invaded_niche_pathways.csv (primary), temporal_trends (context),
invasion_success (trait context)."""
import pandas as pd, numpy as np
from scipy.stats import chi2_contingency
import statsmodels.api as sm
import statsmodels.formula.api as smf

OUT = 'outputs'
import os; os.makedirs(OUT, exist_ok=True)

pl = pd.read_csv('data/invaded_niche_pathways.csv', sep='\t')
sp = pd.read_csv('data/invasion_success_pathways.csv')
tmp = pd.read_csv('data/temporal_trends_contingency_table.csv', sep='\t')
tmp['introduction.period'] = tmp['introduction.period'].str.strip()
tmp['pathway'] = tmp['pathway'].str.strip()

pl['garden_present'] = (pl['n.gard']>0).astype(int)
pl['any_present']    = (pl['n.total']>0).astype(int)

# ---------------------------------------------------------------- descriptive
hab_order = ['Urban','Wetlands','Coastal','Riparian','Croplands','Meadows',
             'Coniferous forests','Broad-leaved forests','Scrublands','Rock outcrops']
desc = []
for h in hab_order:
    d = pl[pl.habitat==h]
    n_plots = len(d); g = (d["n.gard"]>0).sum(); u=(d["n.unint"]>0).sum(); a=(d["n.agfo"]>0).sum(); any_=(d["n.total"]>0).sum()
    sg = d["n.gard"].sum(); su=d["n.unint"].sum(); sa=d["n.agfo"].sum(); st=d["n.total"].sum()
    desc.append(dict(habitat=h, n_plots=n_plots,
        prev_gard_pct=round(100*g/n_plots,1), prev_unint_pct=round(100*u/n_plots,1),
        prev_any_pct=round(100*any_/n_plots,1),
        n_gard=int(sg), n_unint=int(su), n_agfo=int(sa), n_total=int(st),
        share_gard_spp_pct=round(100*sg/st,1) if st else 0.0,
        plots_with_gard=g, plots_any=any_))
desc = pd.DataFrame(desc)
desc = desc.sort_values('prev_gard_pct', ascending=False)
desc.to_csv(f'{OUT}/table_habitat_summary.csv', index=False)
print('=== Tabla descriptiva por hábitat ===')
print(desc.to_string(index=False))

# ---------------------------------------------------------------- chi square
ct = pd.crosstab(pl['habitat'], pl['garden_present'])
chi2, p, dof, exp = chi2_contingency(ct)
print('\n=== Chi-cuadrado (presencia Gardening x hábitat) ===')
print('tabla:\n', ct.to_string())
print(f'chi2={chi2:.2f}, dof={dof}, p={p:.3e}  -> heterogeneidad entre hábitats: {"SÍ" if p<0.05 else "no"}')

# ---------------------------------------------------------------- logistic
# column names with dots are not formula-safe -> rename
pl2 = pl.rename(columns={'urban.2009.1000m':'urban2009_1000m','annual.temperature':'annual_temperature',
                         'distance.road':'distance_road','distance.stream':'distance_stream','elevation':'elevation'})
# Rock outcrops has zero gardening plots (complete separation) -> excluded from regression, noted separately
pl2 = pl2[pl2['habitat']!='Rock outcrops'].copy()
pl2['habitat'] = pl2['habitat'].astype('category')

# Model A: habitat only (reference Scrublands)
mA = smf.logit('garden_present ~ C(habitat, Treatment(reference="Scrublands"))', data=pl2).fit(disp=0)
print('\n=== Regresión logística A: presencia Gardening ~ hábitat (ref=Scrublands; Rock outcrops excluido por separación: 0 parcelas con Gardening) ===')
print(mA.summary2().tables[1].to_string())
print('LR p:', mA.llr_pvalue)
orrA = np.exp(mA.params)
print('OR hábitat vs Scrublands:', dict(zip([k.replace('C(habitat, Treatment(reference="Scrublands"))[T.','').replace(']','') for k in orrA.index], np.round(orrA.values,2))))

# Model B: habitat + environmental context (covariables centradas)
mB = smf.logit('garden_present ~ C(habitat, Treatment(reference="Scrublands")) + elevation + urban2009_1000m + annual_temperature + distance_road + distance_stream', data=pl2).fit(disp=0)
print('\n=== Regresión logística B: presencia Gardening ~ hábitat + contexto ambiental ===')
print(mB.summary2().tables[1].to_string())
print('LR p:', mB.llr_pvalue)
orrB = np.exp(mB.params)
print('OR (hábitat vs Scrublands; covariables por +1 unidad):')
for k,v in orrB.items():
    print('  ', k, round(v,3))

# ---------------------------------------------------------------- binomial share (solo parcelas con no-nativas; hábitat con n pequeña frágiles)
inv = pl[pl['n.total']>0].copy()   # 191 invaded plots
inv = inv[inv['habitat']!='Rock outcrops'].copy()
inv = inv.rename(columns={'n.gard':'n_gard','n.total':'n_total'})
inv['habitat'] = inv['habitat'].astype('category')
endog = np.column_stack([inv['n_gard'], inv['n_total']-inv['n_gard']])
# build design matrix by formula
import statsmodels.formula.api as smf2
mb = smf2.glm('n_gard + I(n_total-n_gard) ~ C(habitat, Treatment(reference="Scrublands"))', data=inv, family=sm.families.Binomial()).fit()
print('\n=== GLM binomial: share de Gardening entre registros de spp (parcelas invadidas n.total>0, ref=Scrublands) ===')
print(mb.summary2().tables[1].to_string())
print('overdispersion (deviance/df):', round(mb.deviance/mb.df_resid,3))
mb0 = smf2.glm('n_gard + I(n_total-n_gard) ~ 1', data=inv, family=sm.families.Binomial()).fit()
LR = -2*(mb0.llf - mb.llf)
from scipy.stats import chi2
df_lr = mb.df_model - mb0.df_model
print(f'LR test share~habitat: chi2={LR:.2f}, df={df_lr}, p={chi2.sf(LR, df_lr):.3e}')
sh = pl[pl['n.total']>0].groupby('habitat').apply(lambda d: pd.Series({'n_gard_records':int(d['n.gard'].sum()),'n_total_records':int(d['n.total'].sum()),'share_pct':round(100*d['n.gard'].sum()/d['n.total'].sum(),1)}), include_groups=False)
print('\nShare observado Gardening (solo parcelas invadidas, n.total>0):')
print(sh.sort_values('share_pct', ascending=False).to_string())
# ---------------------------------------------------------------- temporal context
print('\n=== Contexto temporal (tabla temporal_trends) ===')
tp = tmp.pivot(index='introduction.period', columns='pathway', values='n')[['AgriForest','Gardening','Unintentional']]
tp['total'] = tp.sum(axis=1)
tp['gard_share_pct'] = (100*tp['Gardening']/tp['total']).round(1)
tp = tp.reindex(['Before 1500','1501-1900','1901-1984','1985-2019'])
print(tp.to_string())
print(f"Gardening pico 1985-2019: {tp.loc['1985-2019','Gardening']:.0f} de {tp.loc['1985-2019','total']:.0f} introducciones ({100*tp.loc['1985-2019','Gardening']/tp.loc['1985-2019','total']:.1f}%), "
      f"y {100*tp.Gardening.loc['1985-2019']/tp.Gardening.sum():.1f}% de todas sus introducciones históricas")

# ---------------------------------------------------------------- trait context
print('\n=== Contexto de rasgos (invasion_success) ===')
tcol = ['number.of.invaded.plots','area.of.occupancy.10km','habitat.range','invaded.niche.breadth','mrt','height']
tr = sp.groupby('intro.pathway')[tcol].mean().round(2)
print(tr.to_string())
print('crosstab growth.form x pathway:'); print(pd.crosstab(sp['growth.form'], sp['intro.pathway']).to_string())

# ---------------------------------------------------------------- SVG figures
def bar_prevalence_svg(df, file):
    rows = df[::-1].reset_index(drop=True)
    n = len(rows); W, Hm, row_h, mar = 640, 40, 34, 16
    H = Hm + n*row_h + 30
    plotw = W - 180 - 80
    y_for = lambda i: Hm + i*row_h + 6
    def R(df,i): return df.iloc[i]
    s = [f'<svg xmlns="http://www.w3.org/2000/svg" width="{W}" height="{H}">',
         f'<rect width="{W}" height="{H}" fill="white"/>',
         '<text x="10" y="20" font-family="Arial" font-size="14" font-weight="bold" fill="#222">Prevalencia de la vía Gardening por tipo de hábitat</text>',
         f'<text x="10" y="36" font-family="Arial" font-size="11" fill="#555">% parcelas que contienen ≥1 especie no-nativa introducida por jardiner&iacute;a (Barcelona, n=632 parcelas)</text>']
    for i in range(n):
        r = R(rows,i)
        v = r['prev_gard_pct']; yv = y_for(i)
        ylab = Hm + i*row_h + 6
        s.append(f'<text x="{180-8}" y="{ylab+13}" font-family="Arial" font-size="11" text-anchor="end" fill="#333">{r["habitat"]}</text>')
        s.append(f'<rect x="180" y="{yv}" width="{plotw*v/100:.1f}" height="{row_h-12}" rx="3" fill="#3b7a4e"/>')
        s.append(f'<text x="{182+plotw*v/100:.1f}" y="{yv+15}" font-family="Arial" font-size="10.5" fill="#222">{v:.1f}%</text>')
        # gridline at 50
        s.append(f'<line x1="{180+plotw*0.5:.1f}" y1="{Hm+4}" x2="{180+plotw*0.5:.1f}" y2="{Hm+n*row_h-4}" stroke="#ddd" stroke-width="0.6" stroke-dasharray="3,3"/>')
    s.append(f'<text x="10" y="{H-8}" font-family="Arial" font-size="10" fill="#777">L&iacute;nea discontinua = 50%. Datos: invaded_niche_pathways.csv</text>')
    s.append('</svg>')
    open(f'{OUT}/{file}','w').write('\n'.join(s))

def stacked_share_svg(df, file):
    rows = df[::-1].reset_index(drop=True)
    n = len(rows); W, Hm, row_h, mar = 640, 40, 34, 16
    H = Hm + n*row_h + 46
    colors = {'Gardening':'#3b7a4e','Unintentional':'#c97b35','AgriForest':'#6b6bbd'}
    s = [f'<svg xmlns="http://www.w3.org/2000/svg" width="{W}" height="{H}">',
         f'<rect width="{W}" height="{H}" fill="white"/>',
         '<text x="10" y="20" font-family="Arial" font-size="14" font-weight="bold" fill="#222">Composici&oacute;n de la flora no-nativa por v&iacute;a y h&aacute;bitat</text>',
         f'<text x="10" y="36" font-family="Arial" font-size="11" fill="#555">Proporci&oacute;n de registros de especies no-nativas por v&iacute;a (share de Gardening = n.gard/n.total) dentro de cada h&aacute;bitat</text>']
    plotw = W - 180 - 90
    for i in range(n):
        r = rows.iloc[i]
        yv = Hm + i*row_h + 6; ylab = Hm + i*row_h + 6
        g, u, a = r['share_gard_spp_pct']/100, r['n_unint_share']/100, r['n_agfo_share']/100
        x = 180
        s.append(f'<text x="{x-8}" y="{ylab+13}" font-family="Arial" font-size="11" text-anchor="end" fill="#333">{r["habitat"]}</text>')
        for frac, col in [(g,'Gardening'),(u,'Unintentional'),(a,'AgriForest')]:
            if frac>0:
                s.append(f'<rect x="{x:.1f}" y="{yv}" width="{plotw*frac:.1f}" height="{row_h-12}" fill="{colors[col]}"/>')
                x += plotw*frac
        s.append(f'<text x="{184}" y="{yv+15}" font-family="Arial" font-size="10" fill="#fff" opacity="0.95">n={int(r["n_total"])}</text>')
    lx = 10; ly = H - 24
    for j,(lab,col) in enumerate([('Gardening','#3b7a4e'),('Unintentional','#c97b35'),('AgriForest','#6b6bbd')]):
        bx = lx + j*180
        s.append(f'<rect x="{bx}" y="{ly}" width="14" height="14" fill="{col}"/>')
        s.append(f'<text x="{bx+18}" y="{ly+12}" font-family="Arial" font-size="11" fill="#333">{lab}</text>')
    s.append('</svg>')
    open(f'{OUT}/{file}','w').write('\n'.join(s))

# normalize shares for plotting (using all-plot species counts)
plotdf = desc.copy()
plotdf['n_unint_share'] = 100*plotdf['n_unint']/plotdf['n_total']
plotdf['n_agfo_share']  = 100*plotdf['n_agfo']/plotdf['n_total']
sorted_hab = plotdf.sort_values('prev_gard_pct', ascending=False)['habitat'].tolist()
plotdf = plotdf.set_index('habitat').loc[sorted_hab].reset_index()
bar_prevalence_svg(plotdf, 'fig_prevalence_by_habitat.svg')
stacked_share_svg(plotdf, 'fig_composition_by_habitat.svg')
print('\nSaved figures:', os.listdir(OUT))

print('\n=== DONE ===')
