print("\n\n################ FINAL CONSOLIDATED RESULTS ################")

# --- Table: mean success by pathway (original units) ---
print("\n[1] Mean success by introduction pathway (81 species, raw units):")
sub, V = build_data(df)
print(sub.groupby('intro.pathway')[metrics].mean().round(2).to_string())

# --- Table: growth-form composition ---
print("\n[2] Growth-form composition by pathway (counts):")
print(pd.crosstab(sub['intro.pathway'], sub['growth.form']).to_string())

# --- Rankings summary (best urban per pathway) ---
import pandas as pd
rank = pd.read_csv('analysis/partA_rankings.csv')
print("\n[3] Top-3 urban variables per pathway (Poisson HC3, beta per SD, |z| rank):")
for r in ['n.gard','n.unint','n.agfo','n.total']:
    subr = rank[(rank.resp==r) & (rank.family=='poisson') & (~rank.habit)].sort_values('z', key=abs, ascending=False)
    print(f"  {r}: " + " | ".join(f"{row.urban} b={row.beta_urbanSD:+.2f} p={row.p_urbanSD:.1e}" for _,row in subr.head(3).iterrows()))

# --- Save summary table for the researcher ---
summary_rows = []
for r in ['n.gard','n.unint','n.agfo','n.total']:
    subr = rank[(rank.resp==r) & (rank.family=='poisson') & (~rank.habit)].sort_values('z', key=abs, ascending=False)
    row = {'pathway':r}
    for i,(_,R) in enumerate(subr.head(3).iterrows()):
        row[f'rank{i+1}_var'] = R.urban; row[f'rank{i+1}_betaSD'] = round(R.beta_urbanSD,3)
        row[f'rank{i+1}_p'] = f"{R.p_urbanSD:.1e}"
    summary_rows.append(row)
pd.DataFrame(summary_rows).to_csv('analysis/summary_urban_rankings.csv', index=False)
print("\nSaved analysis/summary_urban_rankings.csv")
