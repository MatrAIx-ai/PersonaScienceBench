"""MAIN ANALYSIS - DiscoveryBench: 'In what scenario did urban land use promote a
specific type of plant invasion?'
Parts: A) plot-level pathway GLMs vs urban cover; B) species-level success by pathway
with phylogenetic control (PGLS). See also phylo_utils.py (Newick/VCV/PGLS).
"""
import numpy as np, pandas as pd, statsmodels.api as sm
from scipy import stats
import subprocess, os, io, runpy, contextlib
"""PART B: species-level success by pathway with phylogenetic correction (PGLS).
- Baseline OLS (no phylogeny) vs PGLS with estimated Pagel lambda.
- Sensitivity: excluding the 4 duplicated=TRUE records (77 species, tree re-pruned).
- Sensitivity: PGLS controlling for growth.form.
Metrics tested: number.of.invaded.plots, area.of.occupancy.10km, habitat.range,
invaded.niche.breadth, mrt. Counts -> log1p; mrt -> log.
"""
import sys; sys.path.insert(0, 'analysis')
import numpy as np, pandas as pd
from scipy import stats
import statsmodels.api as sm
import phylo_utils as pu

sp = pd.read_csv('data/invasion_success_pathways.csv').sort_values('phylo.tip.label').reset_index(drop=True)
# keep only needed cols
keep = ['phylo.tip.label','intro.pathway','growth.form','duplicated']
metrics = ['number.of.invaded.plots','area.of.occupancy.10km','habitat.range','invaded.niche.breadth','mrt']
df = sp[keep+metrics].copy()
df['log_plots'] = np.log1p(df['number.of.invaded.plots'])
df['log_aoo'] = np.log1p(df['area.of.occupancy.10km'])
df['log_hab'] = np.log1p(df['habitat.range'])
df['log_mrt'] = np.log(df['mrt'])
df['niche'] = df['invaded.niche.breadth']
for m in metrics: print(m, 'min/max', df[m].min(), df[m].max())
print('dup records:', int(sp['duplicated'].sum()), '| pathway counts:', df['intro.pathway'].value_counts().to_dict())

tree_str = open('data/phylogenetic_tree.txt').read().replace('\r','')
root = pu.parse_newick(tree_str)

def build_data(subset_df):
    tips_full = pu.collect_tips(root)
    p_root, kept = pu.prune_to_tips(root, set(subset_df['phylo.tip.label']))
    V = pu.make_vcv(p_root, kept)
    # map data rows to kept tips (alignment identical since kept matches subset)
    names = [t.name for t in kept]
    sub = subset_df.set_index('phylo.tip.label').loc[names].reset_index()
    return sub, V

def design_matrix(sub, ref='Gardening'):
    X = pd.DataFrame(index=sub.index)
    X['(Intercept)'] = 1.0
    X['pw_Unintentional'] = (sub['intro.pathway']=='Unintentional').astype(float)
    X['pw_AgriForest'] = (sub['intro.pathway']=='AgriForest').astype(float)
    return X[['(Intercept)','pw_Unintentional','pw_AgriForest']]

def pgls_report(y, X, V, label):
    m = pu.pgls(X.values, y.values, V)
    names = list(X.columns)
    out = []
    for i, nm in enumerate(names):
        if nm == '(Intercept)': continue
        out.append((nm, m['beta'][i], m['se'][i], m['p'][i]))
    print(f"  {label}: lambda={m['lam']:.2f} | " + " | ".join(
        f"{nm} beta={b:+.3f} se={s:.3f} p={p:.2e}" for nm,b,s,p in out))
    return m

print("\n'Unintentional' & 'AgriForest' effects vs Gardening reference\n")

for metric, yv in [('plots','log_plots'),('AOO','log_aoo'),('habitat.range','log_hab'),
                   ('invaded niche','niche'),('MRT','log_mrt')]:
    print(f"===== metric: {metric} (transform: {yv}) =====")
    # Baseline OLS (no phylogeny), HC3
    sub, V = build_data(df)
    X = design_matrix(sub)
    m = sm.OLS(sub[yv], sm.add_constant(X[['pw_Unintentional','pw_AgriForest']])).fit(cov_type='HC3')
    ols = []
    for k in ['pw_Unintentional','pw_AgriForest']:
        ols.append(f"{k} {m.params[k]:+.3f} (p={m.pvalues[k]:.2e})")
    print("  OLS (naive):      " + " | ".join(ols))
    # PGLS
    pgls_report(sub[yv], X, V, "PGLS (lambda estimated)")
    # PGLS + growth.form control
    sub2 = sub.copy()
    gf = pd.get_dummies(sub2['growth.form'], prefix='gf').astype(float)
    gf = gf.drop(columns=[c for c in ['gf_Perennial fg'] if c in gf.columns])  # drop ref 'Perennial fg'
    # ensure all three present
    Xg = X.copy()
    for c in gf.columns: Xg[c] = gf[c].values
    pgls_report(sub2[yv], Xg, V, "PGLS + growth.form")
    # Sensitivity: exclude duplicated
    subd, Vd = build_data(df[df['duplicated'] == False])
    Xd = design_matrix(subd)
    pgls_report(subd[yv], Xd, Vd, "PGLS no-duplicates (77sp)")
    print()

# phylogenetic signal in response (intercept-only PGLS lambda)
print("\nPagel lambda (intercept-only) per metric = phylogenetic signal of the response")
sub, V = build_data(df)
for metric, yv in [('plots','log_plots'),('AOO','log_aoo'),('habitat.range','log_hab'),
                   ('niche','niche'),('MRT','log_mrt')]:
    Xint = pd.DataFrame(index=sub.index); Xint['(Intercept)'] = 1.0
    m = pu.pgls(Xint.values, sub[yv].values, V)
    print(f"  {metric}: lambda={m['lam']:.2f}")

# ======================== PART A ==========================
partA_stdout = io.StringIO()
import contextlib
with contextlib.redirect_stdout(partA_stdout):
    runpy.run_path('analysis/partA_plot_glm.py', run_name='__main__')
print(partA_stdout.getvalue())
partA2_stdout = io.StringIO()
with contextlib.redirect_stdout(partA2_stdout):
    runpy.run_path('analysis/partA_followup.py', run_name='__main__')
print(partA2_stdout.getvalue())

