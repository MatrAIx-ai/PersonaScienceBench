"""
Analysis: which introduction pathway types (Gardening, Unintentional, AgriForest)
were influenced by urban land use?  Plot-level data (Barcelona province, Catalonia).

Approved design:
  - Response per pathway: (a) presence/absence -> logistic GLM; (b) counts -> ZIP/ZINB.
  - Urban = continuous % cover; buffer 1000 m primary, 50/500 m sensitivity.
  - Habitat covariate: report urban effect with and WITHOUT habitat (urban habitat is a
    manifestation of urban land use, so both views are reported honestly).
  - Cropland contrast; temporal table as context only; phylogeny excluded from plots.
"""
import numpy as np
import pandas as pd
import statsmodels.api as sm
from statsmodels.discrete.count_model import (ZeroInflatedPoisson,
                                              ZeroInflatedNegativeBinomialP)
from statsmodels.discrete.discrete_model import Poisson
from statsmodels.stats.multitest import multipletests
from scipy.stats import kruskal
import warnings
warnings.filterwarnings('ignore')
pd.set_option('display.width', 220)
pd.set_option('display.max_columns', 60)

OUT = 'analysis/results'
niche = pd.read_csv('data/invaded_niche_pathways.csv', sep='\t')
inv   = pd.read_csv('data/invasion_success_pathways.csv', sep=',')
tt    = pd.read_csv('data/temporal_trends_contingency_table.csv', sep='\t')

PATHWAYS = ['n.gard', 'n.unint', 'n.agfo']
PNAME = {'n.gard': 'Gardening', 'n.unint': 'Unintentional', 'n.agfo': 'AgriForest'}

# standardized urban vars
for y in ['1956', '1993', '2009']:
    for b in ['50m', '500m', '1000m']:
        v = f'urban.{y}.{b}'
        niche[v + '.z'] = (niche[v] - niche[v].mean()) / niche[v].std()

# ------------------------------------------------------------------ design matrices (array approach; no patsy, dots are safe)
HAB = pd.get_dummies(niche['habitat'], prefix='hab', drop_first=True).astype(float)

def design(urban_var, crop_var='cropland.2009.1000m', hab=True):
    cols = [np.ones(len(niche))]
    cols += [niche[urban_var].values, niche[crop_var].values, niche['elevation'].values,
             niche['annual.temperature'].values]
    names = ['intercept', 'urban', 'cropland', 'elevation', 'temp']
    if hab:
        cols += [HAB[c].values for c in HAB.columns]
        names += list(HAB.columns)
    return np.column_stack(cols), names

def urban_position(hab):
    return 1  # urban is index 1 always

def report_logit(y, X, names, tag):
    res = sm.GLM(y, X, family=sm.families.Binomial()).fit(maxiter=300)
    iu = 1
    return {'tag': tag, 'coef': np.asarray(res.params)[iu], 'se': np.asarray(res.bse)[iu],
            'p': np.asarray(res.pvalues)[iu], 'OR_per10pp': float(np.exp(np.asarray(res.params)[iu] * 0.1)),
            'AIC': res.aic, 'converged': res.converged, 'n_pos': int(y.sum())}

# ------------------------------------------------------------------ t0 counts overview
rec = [{'pathway': c, 'present_plots': int((niche[c] > 0).sum()),
        'mean': round(niche[c].mean(), 3), 'max': int(niche[c].max()),
        'var/mean': round(niche[c].var() / niche[c].mean(), 2)} for c in PATHWAYS + ['n.total']]
pd.DataFrame(rec).to_csv(f'{OUT}/t0_pathway_counts.csv', index=False)

# ------------------------------------------------------------------ 1. LOGISTIC: urban.2009.1000m, with/without habitat
print('=' * 100)
print('1) LOGISTIC presence/absence | urban = urban.2009.1000m, cropland control')
print('=' * 100)
rows = []
for c in PATHWAYS:
    y = (niche[c] > 0).astype(int)
    for hab in [True, False]:
        X, names = design('urban.2009.1000m', hab=hab)
        rows.append({'pathway': PNAME[c], **report_logit(y, X, names, 'with_hab' if hab else 'no_hab')})
t1 = pd.DataFrame(rows)
print(t1.round(4).to_string(index=False))
t1.to_csv(f'{OUT}/t1_logistic_urban2009_1000m.csv', index=False)

# BH over the 3 pathways, with-habitat view
kk = t1[t1.tag == 'with_hab'].sort_values('p').reset_index(drop=True)
kk['p_BH'] = multipletests(kk['p'], method='fdr_bh')[1]
print('\nBH-corrected p (with habitat):')
print(kk[['pathway', 'coef', 'p', 'p_BH', 'OR_per10pp']].round(4).to_string(index=False))
kk.to_csv(f'{OUT}/t1b_BH_with_hab.csv', index=False)

# ------------------------------------------------------------------ 2. habitat-level view: is the signal carried by Urban habitat?
print()
print('=' * 100)
print('2) Habitat contrast & collinearity check')
print('=' * 100)
urb = niche['urban.2009.1000m']
print('urban.2009.1000m mean by habitat:')
print(niche.groupby('habitat')[['urban.2009.1000m']].mean().round(3).to_string())
print('\nmean urban.2009.1000m urban-habitat vs others:',
      niche.groupby(niche.habitat == 'Urban')['urban.2009.1000m'].mean().round(3).to_dict())
# within Urban habitat correlation
uw = niche[niche.habitat == 'Urban']
print('within Urban habitat, Spearman corr of n with urban.2009.1000m:',
      {PNAME[c]: round(uw[c].corr(uw['urban.2009.1000m'], method='spearman'), 3) for c in PATHWAYS})
# non-urban habitats only: urban effect WITH habitat covariate
print('\nNon-urban habitats only (urban effect with habitat covariate):')
rows = []
for c in PATHWAYS:
    nd = niche[niche.habitat != 'Urban'].copy()
    hd = pd.get_dummies(nd['habitat'], prefix='hab', drop_first=True).astype(float)
    def dd(uv, cv='cropland.2009.1000m'):
        cols = [np.ones(len(nd)), nd[uv].values, nd[cv].values, nd['elevation'].values,
                nd['annual.temperature'].values] + [hd[col].values for col in hd.columns]
        return np.column_stack(cols)
    y = (nd[c] > 0).astype(int)
    X = dd('urban.2009.1000m')
    res = sm.GLM(y, X, family=sm.families.Binomial()).fit(maxiter=300)
    rows.append({'pathway': PNAME[c], 'coef': np.asarray(res.params)[1], 'p': np.asarray(res.pvalues)[1],
                 'OR_per10pp': float(np.exp(np.asarray(res.params)[1] * 0.1)), 'AIC': res.aic,
                 'n_pos': int(y.sum()), 'n_plots': len(nd)})
tu = pd.DataFrame(rows)
print('non-urban plots n =', len(niche[niche.habitat != 'Urban']))
print(tu.round(4).to_string(index=False))
tu.to_csv(f'{OUT}/t2_nonurban_only.csv', index=False)

# ------------------------------------------------------------------ 3. buffer x year (per-SD), no habitat (full gradient) + with habitat
print()
print('=' * 100)
print('3) Urban effect per +1 SD by buffer x year | LEFT no-habitat, RIGHT with-habitat')
print('=' * 100)
out = {}
for lab, hab in [('no_hab', False), ('with_hab', True)]:
    rows = []
    for c in PATHWAYS:
        y = (niche[c] > 0).astype(int)
        for yr in ['1956', '1993', '2009']:
            for b in ['50m', '500m', '1000m']:
                X, names = design(f'urban.{yr}.{b}.z', hab=hab)
                try:
                    res = sm.GLM(y, X, family=sm.families.Binomial()).fit(maxiter=300)
                    rows.append({'pathway': PNAME[c], 'year': yr, 'buffer': b,
                                 'coef_perSD': np.asarray(res.params)[1], 'p': np.asarray(res.pvalues)[1]})
                except Exception as e:
                    rows.append({'pathway': PNAME[c], 'year': yr, 'buffer': b,
                                 'coef_perSD': np.nan, 'p': np.nan})
    df = pd.DataFrame(rows)
    pv = df.pivot_table(index='pathway', columns=['year', 'buffer'], values='coef_perSD')
    pv.columns = [f'{y}|{b}' for y, b in pv.columns]
    out[lab] = pv
    print(f'--- {lab} ---')
    print(pv.round(3).to_string())
    pv.to_csv(f'{OUT}/t3_coef_perSD_{lab}.csv')
print('Signal (sign) per pathway/buffer/year: no-habitat coefficients for 2009:')
print(out['no_hab'][['2009|50m', '2009|500m', '2009|1000m']].round(3).to_string())

# ------------------------------------------------------------------ 4. COUNTS: Poisson / ZIP / ZINB (urban.2009.1000m, with & without habitat)
print()
print('=' * 100)
print('4) Counts: Poisson vs ZIP vs ZINB per pathway (urban.2009.1000m)')
print('=' * 100)
def count_models(c, hab):
    y = niche[c].values.astype(int)
    X, names = design('urban.2009.1000m', hab=hab)
    Xi = np.column_stack([np.ones(len(y)), niche['urban.2009.1000m'].values])
    res = {}
    try:
        res['Poisson'] = Poisson(y, X).fit(method='newton', maxiter=300, disp=0)
    except Exception as e:
        print('  Poisson fail', c, hab, e)
    for nm, cls in [('ZIP', ZeroInflatedPoisson), ('ZINB', ZeroInflatedNegativeBinomialP)]:
        try:
            kw = dict(p=2) if nm == 'ZINB' else {}
            res[nm] = cls(y, X, exog_infl=Xi, **kw).fit(method='bfgs', maxiter=1000, disp=0)
        except Exception as e:
            print(f'  {nm} fail', c, hab, str(e)[:120])
    return res

rows = []
for c in PATHWAYS:
    for hab in [True, False]:
        res = count_models(c, hab)
        for nm, r in res.items():
            rows.append({'pathway': PNAME[c], 'habitat': 'with' if hab else 'no',
                         'model': nm, 'AIC': r.aic, 'converged': r.mle_retvals.get('converged', np.nan)
                         if hasattr(r, 'mle_retvals') else np.nan,
                         'coef_urban': np.asarray(r.params)[1], 'p_urban': np.asarray(r.pvalues)[1],
                         'IRR_per10pp': float(np.exp(np.asarray(r.params)[1] * 0.1))})
t4 = pd.DataFrame(rows)
print(t4.round(4).to_string(index=False))
t4.to_csv(f'{OUT}/t4_counts.csv', index=False)

# ------------------------------------------------------------------ 5. descriptive tertiles
print()
print('=' * 100)
print('5) Descriptive: means & presence by terci of urban.2009.1000m')
print('=' * 100)
t = pd.qcut(niche['urban.2009.1000m'], 3, labels=['low', 'mid', 'high'])
tab = niche.groupby(t, observed=True)[PATHWAYS + ['n.total']].mean().round(3)
print(tab.to_string()); tab.to_csv(f'{OUT}/t5_means_tertile.csv')
pres = niche.groupby(t, observed=True)[PATHWAYS].apply(lambda x: (x > 0).mean()).round(3)
print(pres.to_string()); pres.to_csv(f'{OUT}/t5b_presence_tertile.csv')
print('Kruskal-Wallis p:', {PNAME[c]: round(kruskal(*(niche[c][t == l] for l in ['low', 'mid', 'high'])).pvalue, 6) for c in PATHWAYS})
print('Urban habitat means:', niche[niche.habitat == 'Urban'][PATHWAYS + ['n.total']].mean().round(3).to_dict())

# ------------------------------------------------------------------ 6. species-level support + temporal context
print()
print('=' * 100)
print('6) Species-level support (traits & invasion success by pathway) + temporal context')
print('=' * 100)
prof = inv.groupby('intro.pathway')[['number.of.invaded.plots', 'area.of.occupancy.10km',
                                     'habitat.range', 'invaded.niche.breadth', 'mrt', 'height']].mean().round(2)
print(prof.to_string()); prof.to_csv(f'{OUT}/t6_species_by_pathway.csv')
gf = pd.crosstab(inv['intro.pathway'], inv['growth.form'], normalize='index').round(2)
print('\nGrowth form share by pathway:'); print(gf.to_string()); gf.to_csv(f'{OUT}/t6b_growthform.csv')
piv = tt.pivot_table(index='introduction.period', columns='pathway', values='n', aggfunc='sum', fill_value=0)
print('\nTemporal context:'); print(piv.to_string()); piv.to_csv(f'{OUT}/t6c_temporal_context.csv')

print('\nDone. Tables in', OUT)
