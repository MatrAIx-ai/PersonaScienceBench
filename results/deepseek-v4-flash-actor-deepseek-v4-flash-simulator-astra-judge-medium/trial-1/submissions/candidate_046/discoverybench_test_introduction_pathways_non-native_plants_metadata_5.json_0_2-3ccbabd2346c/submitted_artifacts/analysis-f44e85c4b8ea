#!/usr/bin/env python3
"""Main analysis: urban land use vs invasion of different types of introduced plants.
A) plot-level hurdle models (+habitat random effect);
B) species-level PGLS (Pagel lambda) + OLS contrast;
C) temporal chi-square; -> synthesis hypothesis."""
import numpy as np, pandas as pd, re, warnings
from scipy import stats as sst
from scipy.optimize import minimize_scalar
import statsmodels.api as sm
from statsmodels.genmod.bayes_mixed_glm import BinomialBayesMixedGLM, PoissonBayesMixedGLM
warnings.filterwarnings("ignore"); np.random.seed(42)
OUT=[]
tt=pd.read_csv("data/temporal_trends_contingency_table.csv",sep="\t")
sp=pd.read_csv("data/invasion_success_pathways.csv")
iv=pd.read_csv("data/invaded_niche_pathways.csv",sep="\t")
tree_str=open("data/phylogenetic_tree.txt").read()
OUT.append("LOADED: temporal={} species={} plots={}".format(tt.shape,sp.shape,iv.shape))
def zs(s): return (s-s.mean())/s.std()

# ---- PART C: temporal chi-square ----
ct=pd.crosstab(tt["introduction.period"],tt["pathway"],values=tt["n"],aggfunc="sum").reindex(
    ["Before 1500","1501-1900","1901-1984","1985-2019"],columns=["AgriForest","Gardening","Unintentional"])
chi2,p,dof,exp=sst.chi2_contingency(ct)
obs=ct.values
se_std=np.sqrt(exp*(1-exp.sum(1,keepdims=True)/exp.sum())*(1-exp.sum(0,keepdims=True)/exp.sum()))
stdres=pd.DataFrame((obs-exp)/se_std,index=ct.index,columns=ct.columns)
OUT.append("C chi2={:.2f} dof={} p={:.2e}".format(chi2,dof,p))
OUT.append("C std.residuals:\n"+stdres.round(2).to_string())
prop=pd.DataFrame((obs-exp)**2/exp,index=ct.index,columns=ct.columns)
OUT.append("C % of chi2:\n"+(prop/prop.sum().sum()*100).round(1).to_string())

# ---- PART A: plot-level ----
iv2=iv.copy()
iv2["dist_road_log"]=np.log1p(iv2["distance.road"]); iv2["dist_stream_log"]=np.log1p(iv2["distance.stream"])
cont_covs=["elevation","annual.temperature","annual.rainfall","dist_road_log","dist_stream_log"]
for c in cont_covs: iv2[c+"_z"]=(iv2[c]-iv2[c].mean())/iv2[c].std()

def hurdle_fit(resp_col,urb_col,crop_col):
    y=iv2[resp_col].values
    base=pd.DataFrame({
        "urban_z":zs(iv2[urb_col]).values,"crop_z":zs(iv2[crop_col]).values,
        "elev_z":iv2["elevation_z"].values,"temp_z":iv2["annual.temperature_z"].values,
        "rain_z":iv2["annual.rainfall_z"].values,"road_z":iv2["dist_road_log_z"].values,
        "stream_z":iv2["dist_stream_log_z"].values})
    pres=(y>0).astype(int)
    Xp=pd.concat([sm.add_constant(base),pd.get_dummies(iv2["habitat"],prefix="hab").astype(float).iloc[:,1:]],axis=1)
    gp=sm.GLM(pres,Xp,family=sm.families.Binomial()).fit(cov_type="HC3")
    sel=y>0; yc=y[sel]
    if len(yc)<15: return None
    Xc=pd.concat([sm.add_constant(base.loc[sel]),pd.get_dummies(iv2["habitat"].loc[sel],prefix="hab").astype(float).iloc[:,1:]],axis=1)
    gc=sm.GLM(yc,Xc,family=sm.families.Poisson()).fit(cov_type="HC3")
    return {"a":gp.aic+gc.aic,"ap":gp.aic,"ac":gc.aic}

sel_results={}
for resp in ["n.total","n.unint","n.gard"]:
    rows=[]
    for buf in ["50m","500m","1000m"]:
        for yr in ["1956","1993","2009"]:
            r=hurdle_fit(resp,f"urban.{yr}.{buf}",f"cropland.{yr}.{buf}")
            if r: rows.append((buf,yr,r["a"],r["ap"],r["ac"]))
    sr=pd.DataFrame(rows,columns=["buffer","year","AIC","AICp","AICc"]).sort_values("AIC")
    sr["dAIC"]=(sr["AIC"]-sr["AIC"].min()).round(1)
    sel_results[resp]=sr
    OUT.append(f"A.{resp} best: buf={sr.iloc[0]['buffer']} yr={sr.iloc[0]['year']} AIC={sr.iloc[0]['AIC']:.1f}")
    OUT.append(sr.head(9).to_string(index=False))
sel_bufs={k:int(v.iloc[0]["buffer"].replace("m","")) for k,v in sel_results.items()}
sel_yrs={k:v.iloc[0]["year"] for k,v in sel_results.items()}
from collections import Counter
best_buf=Counter(sel_bufs.values()).most_common(1)[0][0]; best_yr=Counter(sel_yrs.values()).most_common(1)[0][0]
OUT.append(f"A MAJORITY SELECTED: buffer={best_buf}m year={best_yr} (per-response: {sel_bufs}, {sel_yrs})")

# ---- A diagnostics: VIF ----
def vif_from(dfc):
    out={}; cols=list(dfc.columns)
    for c in cols:
        o=cols.copy(); o.remove(c)
        try: r2=sm.OLS(dfc[c],sm.add_constant(dfc[o])).fit().rsquared
        except Exception: r2=1.0
        out[c]=1/(1-r2) if r2<1 else np.inf
    return out
base_preds=pd.DataFrame({c:iv2[c+"_z"].values for c in cont_covs})
base_preds["urban_z"]=zs(iv2[f"urban.{best_yr}.{best_buf}m"]).values
base_preds["crop_z"]=zs(iv2[f"cropland.{best_yr}.{best_buf}m"]).values
OUT.append("A VIF(selected spec): "+str({k:round(v,2) for k,v in vif_from(base_preds).items()}))

def final_hurdle(resp_col,buf_int,yr,with_change=False):
    buf=f"{buf_int}m"; urb=f"urban.{yr}.{buf}"; crop=f"cropland.{yr}.{buf}"
    base=pd.DataFrame({
        "urban_z":zs(iv2[urb]).values,"crop_z":zs(iv2[crop]).values,
        "elev_z":iv2["elevation_z"].values,"temp_z":iv2["annual.temperature_z"].values,
        "rain_z":iv2["annual.rainfall_z"].values,"road_z":iv2["dist_road_log_z"].values,
        "stream_z":iv2["dist_stream_log_z"].values})
    if with_change: base["change50_z"]=zs(iv2["progressive.1956.2009.50m"]).values
    y=iv2[resp_col].values; pres=(y>0).astype(int)
    Xp=pd.concat([sm.add_constant(base),pd.get_dummies(iv2["habitat"],prefix="hab").astype(float).iloc[:,1:]],axis=1)
    gp=sm.GLM(pres,Xp,family=sm.families.Binomial()).fit(cov_type="HC3")
    sel=y>0; yc=y[sel]
    Xc=pd.concat([sm.add_constant(base.loc[sel]),pd.get_dummies(iv2["habitat"].loc[sel],prefix="hab").astype(float).iloc[:,1:]],axis=1)
    gc=sm.GLM(yc,Xc,family=sm.families.Poisson()).fit(cov_type="HC3")
    return gp,gc,(gc.deviance/gc.df_resid)

for resp in ["n.gard","n.unint","n.agfo","n.total"]:
    gp,gc,dd=final_hurdle(resp,best_buf,best_yr)
    zprob=float(np.mean(iv2[resp].values==0))
    OUT.append(f"\nA FINAL {resp} (buf={best_buf}m yr={best_yr} habitat-fixed robustSE): zeros={zprob:.2f} count-overdispersion dev/df={dd:.2f}")
    for part,g in [("presence-logit",gp),("count-log",gc)]:
        b=g.params["urban_z"]; se=g.bse["urban_z"]; lo,hi=g.conf_int().loc["urban_z"]
        OUT.append(f"  urban_z {part}: beta={b:+.3f} SE={se:.3f} 95%CI[{lo:+.3f},{hi:+.3f}] {'SIG' if (lo>0 or hi<0) else 'ns'}")
    gp2,gc2,dd2=final_hurdle(resp,50,best_yr,with_change=True)
    if "change50_z" in gp2.params:
        b=gp2.params["change50_z"]; lo,hi=gp2.conf_int().loc["change50_z"]
        OUT.append(f"  change50_z(progressive1956-2009@50m) presence: {b:+.3f} CI[{lo:+.3f},{hi:+.3f}] {'SIG' if (lo>0 or hi<0) else 'ns'}")
        if "change50_z" in gc2.params:
            b=gc2.params["change50_z"]; lo,hi=gc2.conf_int().loc["change50_z"]
            OUT.append(f"  change50_z count: {b:+.3f} CI[{lo:+.3f},{hi:+.3f}] {'SIG' if (lo>0 or hi<0) else 'ns'}")

# ---- A2: random habitat effect via BayesMixedGLM ----
hab_dummy=pd.get_dummies(iv2["habitat"]).astype(float).values
ident=np.ones(hab_dummy.shape[1],dtype=int)
def bayes_gateway(resp_col):
    out=[f"A RANDOM-HABITAT {resp_col} (buf={best_buf}m yr={best_yr}):"]
    y=iv2[resp_col].values
    Xf=pd.DataFrame({
        "urban_z":zs(iv2[f"urban.{best_yr}.{best_buf}m"]).values,"crop_z":zs(iv2[f"cropland.{best_yr}.{best_buf}m"]).values,
        "elev_z":iv2["elevation_z"].values,"temp_z":iv2["annual.temperature_z"].values,
        "rain_z":iv2["annual.rainfall_z"].values,"road_z":iv2["dist_road_log_z"].values,
        "stream_z":iv2["dist_stream_log_z"].values}).values.astype(float)
    pres=(y>0).astype(float)
    r_p=BinomialBayesMixedGLM(pres,Xf,hab_dummy,ident).fit_vb(fit_method="BFGS")
    b=r_p.fe_mean[0]; s=r_p.fe_sd[0]
    out.append(f"  PRESENCE urban_z posterior {b:+.3f} sd {s:.3f} CI[{b-1.96*s:+.3f},{b+1.96*s:+.3f}] | habitat_varcomp={float(r_p.vc_mean[0]):.3f}")
    sel=y>0
    if sel.sum()>15:
        r_c=PoissonBayesMixedGLM(y[sel],Xf[sel],hab_dummy[sel],ident).fit_vb(fit_method="BFGS")
        b=r_c.fe_mean[0]; s=r_c.fe_sd[0]
        out.append(f"  COUNT(pos) urban_z posterior {b:+.3f} sd {s:.3f} CI[{b-1.96*s:+.3f},{b+1.96*s:+.3f}]")
    return "\n".join(out)
try:
    OUT.append(bayes_gateway("n.unint")); OUT.append(bayes_gateway("n.gard"))
except Exception as e:
    OUT.append("BayesMixedGLM warning: "+repr(e))

# ---- PART B: species-level PGLS (corrected Newick parser) ----
sp_main=sp[sp["duplicated"]==False].copy().reset_index(drop=True)   # primary rows (77)
sp_drop=sp[~sp["Scientific_name"].isin(sp[sp["duplicated"]==True]["Scientific_name"])].copy().reset_index(drop=True)  # 73
OUT.append(f"\nB species: full={sp.shape[0]} main={sp_main.shape[0]} sensitivity(no dup-species)={sp_drop.shape[0]}")

def parse_newick(s):
    pos=[0]
    def skip():
        while pos[0]<len(s) and s[pos[0]] in ' \t\n': pos[0]+=1
    def read_until(dels):
        st=pos[0]
        while pos[0]<len(s) and s[pos[0]] not in dels: pos[0]+=1
        return s[st:pos[0]]
    def parse_branch():
        skip(); node={'name':'','length':None,'children':[]}
        if s[pos[0]]=='(':
            pos[0]+=1
            while True:
                node['children'].append(parse_branch()); skip()
                if s[pos[0]]==',': pos[0]+=1
                elif s[pos[0]]==')': pos[0]+=1; break
                else: break
            skip()
            if s[pos[0]] not in '(),;:': node['name']=read_until('(),;:')
        else:
            node['name']=read_until('(),:;')
        skip()
        if s[pos[0]]==':':
            pos[0]+=1; node['length']=float(read_until('(),:;'))
        return node
    root={'name':'','length':None,'children':[]}
    while True:
        skip()
        if pos[0]>=len(s): break
        if s[pos[0]]==';': pos[0]+=1; break
        root['children'].append(parse_branch()); skip()
        if s[pos[0]]==',': pos[0]+=1
    skip()
    if pos[0]<len(s) and s[pos[0]] not in ',;': root['name']=read_until(';')
    return root

def build_cov(tip_names):
    t=parse_newick(tree_str)
    def annotate(node,d=0.0):
        node['d']=d+(node.get('length') or 0)
        for c in node['children']: annotate(c,node['d'])
    annotate(t,0.0)
    ids={}
    def assign(node,pid=None):
        nid=len(ids); ids[nid]=node; node['id']=nid; node['parent']=pid
        for c in node['children']: assign(c,nid)
    assign(t)
    rev={node['name']:nid for nid,node in ids.items() if not node['children'] and node['name']}
    miss=[n for n in tip_names if n not in rev]
    if miss: raise ValueError("missing tips "+str(miss[:5]))
    n=len(tip_names); V=np.zeros((n,n))
    anc={}
    def ancset(nid):
        if nid not in anc:
            a=[nid]; node=ids[nid]
            while node['parent'] is not None:
                a.append(node['parent']); node=ids[node['parent']]
            anc[nid]=set(a)
        return anc[nid]
    for i in range(n):
        V[i,i]=ids[rev[tip_names[i]]]['d']
        for j in range(i):
            sa=ancset(rev[tip_names[i]]); cur=rev[tip_names[j]]
            while cur not in sa: cur=ids[cur]['parent']
            V[i,j]=V[j,i]=ids[cur]['d']
    return V

def pgls(Y,X,V):
    n=len(Y); k=X.shape[1]; D=np.diag(np.diag(V))
    def negll(lam):
        Vv=lam*V+(1-lam)*D
        if np.linalg.cond(Vv)>1e13 or np.linalg.det(Vv)<=0: return 1e12
        Vi=np.linalg.inv(Vv); XtV=X.T@Vi
        beta=np.linalg.solve(XtV@X,XtV@Y); r=Y-X@beta
        sgn,ld=np.linalg.slogdet(Vv)
        return 0.5*(n*np.log(2*np.pi)+ld+float(r.T@Vi@r))
    res=minimize_scalar(negll,bounds=(0,1),method='bounded')
    lam=res.x
    Vv=lam*V+(1-lam)*D; Vi=np.linalg.inv(Vv); XtV=X.T@Vi
    XtVX=XtV@X
    beta=np.linalg.solve(XtVX,XtV@Y); cov=np.linalg.inv(XtVX); se=np.sqrt(np.diag(cov))
    r=Y-X@beta; rss=float(r.T@Vi@r); tss=float((Y-Y.mean()).T@(Y-Y.mean()))
    sgn,ld=np.linalg.slogdet(Vv); ll=-0.5*(n*np.log(2*np.pi)+ld+rss)
    return {"lam":lam,"beta":beta,"se":se,"cov":cov,"aic":2*k-2*ll,"r2":1-rss/tss}

def species_block(df,label):
    out=[f"\nB {label}: n={df.shape[0]}"]
    df=df.copy()
    df["lplots"]=np.log(df["number.of.invaded.plots"]); df["laoo"]=np.log(df["area.of.occupancy.10km"])
    df["lmrt"]=np.log1p(df["mrt"])
    ne=df["invaded.niche.breadth"]-df["native.niche.breadth"]
    df["niche_exp_std"]=zs(ne)
    df["lmrt_z"]=zs(df["lmrt"]); df["laoo_z"]=zs(df["laoo"])
    dum=[]
    for cat in ["intro.pathway","growth.form","dispersal"]:
        dum.append(pd.get_dummies(df[cat],prefix=cat,drop_first=True).astype(float).reset_index(drop=True))
    traits=pd.concat(dum,axis=1)
    V=build_cov(df["phylo.tip.label"].tolist())
    models={"success(log-plots)":("lplots",["lmrt_z"]),"success(log-AOO)":("laoo",["lmrt_z"]),
            "niche_std":("invaded.niche.breadth",["lmrt_z","laoo_z"]),"niche_expansion_std":("niche_exp_std",["lmrt_z","laoo_z"])}
    for mname,(resp,covs) in models.items():
        X=pd.concat([traits]+[df[c].reset_index(drop=True) for c in covs],axis=1)
        X=sm.add_constant(X).astype(float)
        Y=df[resp].values; Ys=(Y-Y.mean())/Y.std()
        r=pgls(Ys,X.values,V)
        # OLS contrast (no phylogeny)
        ols=sm.OLS(Ys,X).fit()
        out.append(f"  PGLS {mname}: lambda={r['lam']:.2f} R2={r['r2']:.3f} AIC={r['aic']:.1f} | OLS R2={ols.rsquared:.3f} AIC={ols.aic:.1f}")
        for j,name in enumerate(X.columns):
            if name=="const": continue
            b=r["beta"][j]; se=r["se"][j]; lo,hi=b-1.96*se,b+1.96*se
            sig="PGLS*" if (lo>0 or hi<0) else ""
            ob=ols.params[name]; ose=ols.bse[name]; olo,ohi=ob-1.96*ose,ob+1.96*ose
            osig="OLS*" if (olo>0 or ohi<0) else ""
            out.append(f"    {name:>26s}: PGLS {b:+.3f} CI[{lo:+.3f},{hi:+.3f}] {sig:6s} | OLS {ob:+.3f} CI[{olo:+.3f},{ohi:+.3f}] {osig}")
    return "\n".join(out)

OUT.append(species_block(sp_main,"MAIN (primary rows, n=77)"))
OUT.append(species_block(sp_drop,"SENSITIVITY (drop 4 dup-species, n=73)"))
OUT.append("\n=== SYNTHESIS KEY NUMBERS ===")
OUT.append(f"SELECTED spec: buffer={best_buf}m year={best_yr}")
txt="\n".join(OUT)
print(txt)
open("analysis_output.txt","w").write(txt)
print("\nDONE")
