"""Supplementary outputs for the result synthesis."""
import numpy as np, pandas as pd, warnings
from scipy.optimize import minimize_scalar
import statsmodels.api as sm
warnings.filterwarnings("ignore")
sp=pd.read_csv("data/invasion_success_pathways.csv")
iv=pd.read_csv("data/invaded_niche_pathways.csv",sep="\t")
def zs(s): return (s-s.mean())/s.std()

print("="*70)
print("S1) RAW bivariate urban associations (no covariates) - mediation by habitat")
buf,yr="500m","2009"
for resp in ["n.gard","n.unint","n.agfo","n.total"]:
    r=iv[resp].corr(iv[f"urban.{yr}.{buf}"])
    print(f"  {resp} ~ urban.{yr}.{buf}: r={r:.3f} (n={len(iv)})")
print("\n  mean urban.{yr}.{buf} in invaded (n>0) vs non-invaded plots:")
for resp in ["n.gard","n.unint","n.total"]:
    pos=iv[iv[resp]>0][f"urban.{yr}.{buf}"].mean(); neg=iv[iv[resp]==0][f"urban.{yr}.{buf}"].mean()
    print(f"  {resp}: invaded={pos:.3f} vs not={neg:.3f}")

print("="*70)
print("S2) Habitat 'Urban' dummy + raw urban before/after habitat (presence model, n.total)")
y=(iv["n.total"]>0).astype(int)
urb_z=zs(iv[f"urban.{yr}.{buf}"]).values
# model A: urban only
mA=sm.GLM(y,sm.add_constant(urb_z),family=sm.families.Binomial()).fit(cov_type="HC3")
# model B: urban + habitat factor
Xb=pd.DataFrame({"urban_z":urb_z})
Xb=pd.concat([sm.add_constant(Xb),pd.get_dummies(iv["habitat"],prefix="hab").astype(float).iloc[:,1:]],axis=1)
mB=sm.GLM(y,Xb,family=sm.families.Binomial()).fit(cov_type="HC3")
u=mA.params["x1"]; lo,hi=mA.conf_int().loc["x1"]
print(f"  urban_z alone (no habitat): beta={u:+.3f} CI[{lo:+.3f},{hi:+.3f}] {'SIG' if (lo>0 or hi<0) else 'ns'}")
u=mB.params["urban_z"]; lo,hi=mB.conf_int().loc["urban_z"]
print(f"  urban_z with habitat factor: beta={u:+.3f} CI[{lo:+.3f},{hi:+.3f}] {'SIG' if (lo>0 or hi<0) else 'ns'}")
if "hab_Urban" in mB.params:
    u=mB.params["hab_Urban"]; lo,hi=mB.conf_int().loc["hab_Urban"]
    print(f"  habitat=Urban dummy: beta={u:+.3f} CI[{lo:+.3f},{hi:+.3f}]")

print("="*70)
print("S3) Contrast final hurdle at 500m for year 1956 vs 2009 (n.gard & n.unint & n.total)")
def final_h(resp_col,buf_int,yr):
    urb=f"urban.{yr}.{buf_int}m"; crop=f"cropland.{yr}.{buf_int}m"
    base=pd.DataFrame({
        "urban_z":zs(iv[urb]).values,"crop_z":zs(iv[crop]).values,
        "elev_z":zs(iv["elevation"]).values,"temp_z":zs(iv["annual.temperature"]).values,
        "rain_z":zs(iv["annual.rainfall"]).values,
        "road_z":zs(np.log1p(iv["distance.road"])).values,"stream_z":zs(np.log1p(iv["distance.stream"])).values})
    y=iv[resp_col].values; pres=(y>0).astype(int)
    X=pd.concat([sm.add_constant(base),pd.get_dummies(iv["habitat"],prefix="hab").astype(float).iloc[:,1:]],axis=1)
    g=sm.GLM(pres,X,family=sm.families.Binomial()).fit(cov_type="HC3")
    b=g.params["urban_z"]; lo,hi=g.conf_int().loc["urban_z"]
    return f"  {resp_col} 500m/yr={yr} PRESENCE urban_z: {b:+.3f} CI[{lo:+.3f},{hi:+.3f}] {'SIG' if (lo>0 or hi<0) else 'ns'}"
for yr in ["1956","1993","2009"]:
    for resp in ["n.gard","n.unint","n.total"]:
        print(final_h(resp,500,yr))

print("="*70)
print('SUPPLEMENT DONE')