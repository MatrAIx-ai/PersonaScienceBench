"""Main analysis: compare original vs replication effect sizes by domain.
Question: For which domains do the effect size estimates tend to be larger
in original studies compared to replication studies?
Primary domain = discipline (Social / Cognitive / Economics).
Robustness      = project.x (Psychology / Experimental Economics).
Metric          = paired per-study gap ro - rr and fiso - fisr (and medians).
"""
import pandas as pd
import numpy as np
from scipy import stats

PATH = 'data/meta-regression_joined_data_heterogeneity_in_replication_projects.csv'
df = pd.read_csv(PATH).copy()

# Paired gaps
df['gap_ro']  = df['ro']  - df['rr']
df['gap_fis'] = df['fiso'] - df['fisr']

def bootstrap_ci(x, n_boot=10000, seed=42, alpha=0.05):
    rng = np.random.default_rng(seed)
    x = np.asarray(x, dtype=float)
    boot = np.array([rng.choice(x, size=len(x), replace=True).mean() for _ in range(n_boot)])
    return np.percentile(boot, [100*alpha/2, 100*(1-alpha/2)])

def summarize_by_groups(groups):
    rows = []
    for name, g in groups:
        d = {
            'domain': name,
            'n': len(g),
            'ro_mean': g['ro'].mean(),      'ro_med': g['ro'].median(),
            'rr_mean': g['rr'].mean(),      'rr_med': g['rr'].median(),
            'gap_ro_mean': g['gap_ro'].mean(), 'gap_ro_med': g['gap_ro'].median(),
            'fiso_mean': g['fiso'].mean(),  'fisr_mean': g['fisr'].mean(),
            'gap_fis_mean': g['gap_fis'].mean(), 'gap_fis_med': g['gap_fis'].median(),
            'replicated_rate': g['replicated'].mean(),
        }
        lo, hi = bootstrap_ci(g['gap_ro'].values)
        d['gap_ro_ci95_lo'], d['gap_ro_ci95_hi'] = lo, hi
        # within-domain tests gap>0
        d['wilcoxon_p'] = stats.wilcoxon(g['gap_ro'].values, alternative='greater').pvalue
        d['ttest_p'] = stats.ttest_1samp(g['gap_ro'].values, 0, alternative='greater').pvalue
        rows.append(d)
    return pd.DataFrame(rows).set_index('domain')

def rank_report(res, label):
    print(f'\n===== RANKING by mean gap (ro - rr) by {label} =====')
    r = res.sort_values('gap_ro_mean', ascending=False)
    for dom, row in r.iterrows():
        print(f"  {dom:26s} n={int(row['n']):3d} | ro:{row['ro_mean']:.3f} vs rr:{row['rr_mean']:.3f} "
              f"| gap mean={row['gap_ro_mean']:+.3f} (95% CI [{row['gap_ro_ci95_lo']:+.3f},{row['gap_ro_ci95_hi']:+.3f}]) "
              f"| median gap={row['gap_ro_med']:+.3f} | gap(fisz) mean={row['gap_fis_mean']:+.3f} "
              f"| wilcoxon p={row['wilcoxon_p']:.4f} | repl.rate={row['replicated_rate']:.2f}")
    return r

# ---- Primary: by discipline ----
print('#'*78)
print('PRIMARY: DOMAIN = discipline (Social / Cognitive / Economics)')
print('#'*78)
res_disc = summarize_by_groups([(d, g) for d, g in df.groupby('discipline')])
overall = summarize_by_groups([('ALL', df)])
print('\nSummary table (by discipline):')
print(res_disc.round(4).to_string())
print('\nOverall (all 86):')
print(overall.round(4).to_string())

print('\nBetween-domain tests on gap_ro (discipline):')
groups = [df.loc[df['discipline']==d, 'gap_ro'].values for d in df['discipline'].unique()]
print('  Kruskal-Wallis H =', stats.kruskal(*groups).statistic.round(3),
      ' p =', stats.kruskal(*groups).pvalue.round(4))
# one-way ANOVA (sensitivity only)
f, p = stats.f_oneway(*groups)
print('  one-way ANOVA  F =', round(f,3), ' p =', round(p,4))

rank_disc = rank_report(res_disc, 'discipline')

# Check ordering consistency on Fisher-z scale
print('\nRanking by Fisher-z gap (discipline):')
r_f = res_disc.sort_values('gap_fis_mean', ascending=False)
print(' ', ' > '.join(r_f.index.tolist()))
print('Ranking by correlation-scale gap (discipline):')
print(' ', ' > '.join(rank_disc.index.tolist()))
print('  Ordering identical across scales:', list(rank_disc.index) == list(r_f.index))

# ---- Robustness: by project.x ----
print('\n' + '#'*78)
print('ROBUSTNESS: DOMAIN = project.x (Psychology / Experimental Economics)')
print('#'*78)
res_proj = summarize_by_groups([(p, g) for p, g in df.groupby('project.x')])
print(res_proj.round(4).to_string())
rank_proj = rank_report(res_proj, 'project.x')

# ---- Sensitivity: reversed-sign replications (rr<0) ----
print('\n' + '#'*78)
print('SENSITIVITY: excluding 18 reversed-sign replications (rr<0)')
print('#'*78)
df_pos = df[df['rr'] >= 0]
res_disc_pos = summarize_by_groups([(d, g) for d, g in df_pos.groupby('discipline')])
print(res_disc_pos.round(4).to_string())
r_pos = res_disc_pos.sort_values('gap_ro_mean', ascending=False)
print('Ranking (excl. reversals): ', ' > '.join(r_pos.index.tolist()))
print('Ranking (all data):        ', ' > '.join(rank_disc.index.tolist()))
print('  Ordering stable:', list(r_pos.index) == list(rank_disc.index))

# ---- Sensitivity: linear regression gap ~ discipline (ANOVA equivalent) ----
print('\n' + '#'*78)
print('SENSITIVITY: OLS  gap_ro ~ discipline   (only as sensitivity)')
print('#'*78)
import statsmodels.formula.api as smf
model = smf.ols('gap_ro ~ C(discipline, Treatment(reference="Economics"))', data=df).fit()
print(model.params.round(3))
ci = model.conf_int().round(3)
for i, idx in enumerate(model.params.index):
    print(f'  {idx:52s} coef={model.params.iloc[i]:+.3f} 95%CI=({ci.iloc[i,0]:+.3f},{ci.iloc[i,1]:+.3f})  p={model.pvalues.iloc[i]:.4f}')

# ---- Save results ----
with open('analysis_output.txt', 'w') as fh:
    fh.write('RESULT: discipline\n'); fh.write(res_disc.round(4).to_string()); fh.write('\n\n')
    fh.write('RESULT: project\n'); fh.write(res_proj.round(4).to_string()); fh.write('\n')
    fh.write('\nRANK discipline:\n'); fh.write(rank_disc.to_string())
print('\nSaved analysis_output.txt')
