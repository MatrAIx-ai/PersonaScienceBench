"""BixBench: proportion of junior professors in replicated Psychology studies.
Definitions (as agreed with researcher):
  - Psychology        = project == 'rpp'
  - Replicated        = replicated column == 1 (verified == p.r<=0.05 & same sign)
  - Junior professor  = seniority.r in {Assistant, Assistant Professor}
  - Seniority         = seniority.r (replication study's most senior author)
  - drop flag         = NOT filtered (denominator = all 35 replicated rpp pairs)
"""
import pandas as pd

df = pd.read_csv('data/meta-regression_study_data_heterogeneity_in_replication_projects.csv')

# ---- 0. sanity: replicated column vs p.r<=0.05 & same direction ----
sub = df.dropna(subset=['replicated', 'p_value.r', 'p_value.o', 'effect_size.o', 'effect_size.r'])
derived = (sub['p_value.r'] <= 0.05) & ((sub['effect_size.r'] * sub['effect_size.o']) > 0)
mismatch = int((sub['replicated'].astype(int) != derived.astype(int)).sum())
print(f"[sanity] replicated column vs derived (p.r<=0.05 & same sign): mismatches = {mismatch}")

# ---- 1. subset: Psychology (rpp) ----
psy = df[df['project'] == 'rpp'].copy()
print(f"[subset] rpp rows: {len(psy)} | replicated==1: {(psy['replicated']==1).sum()} | replicated NaN: {psy['replicated'].isna().sum()}")

# ---- 2. denominator: replicated studies in Psychology ----
rep = psy[psy['replicated'] == 1]
n_denom = len(rep)

# ---- 3. junior definition (Assistant + Assistant Professor) ----
JUNIOR = {'Assistant', 'Assistant Professor'}
rep['junior'] = rep['seniority.r'].isin(JUNIOR)
n_junior = int(rep['junior'].sum())
prop = n_junior / n_denom

print(f"[main] replicated rpp n = {n_denom}; junior (Assistant+AsstProf) = {n_junior}; "
      f"proportion = {n_junior}/{n_denom} = {prop:.4f} ({100*prop:.1f}%)")
print(f"[main] seniority.r distribution among replicated: {rep['seniority.r'].value_counts().to_dict()}")

# ---- 4. robustness variants ----
JUNIOR_WITH_RESEARCHER = JUNIOR | {'Researcher'}
prop_alt1 = int(rep['seniority.r'].isin(JUNIOR_WITH_RESEARCHER).sum()) / n_denom
print(f"[robust1] junior incl. Researcher = {round(prop_alt1*100,1)}%")

non_drop = rep[~rep['drop']]
prop_alt2 = int(non_drop['seniority.r'].isin(JUNIOR).sum()) / len(non_drop)
print(f"[robust2] excluding drop-flagged rows: replicated non-drop n={len(non_drop)}, "
      f"junior={int(non_drop['junior'].sum())}, proportion = {prop_alt2:.4f} ({100*prop_alt2:.1f}%)")
print(f"[robust2 detail] replicated rpp drop counts: {rep['drop'].value_counts().to_dict()}")

hypothesis = (f"Approximately {prop:.1%} of studies successfully replicated in the Psychology "
              f"replication project (Reproducibility Project: Psychology, n={n_denom}) were "
              f"carried out by a team whose most senior author was a junior professor "
              f"(Assistant Professor or Assistant), i.e. {n_junior} of {n_denom} replicated studies.")
print("\n[HYPOTHESIS] " + hypothesis)

with open('output_rpp_junior.txt', 'w') as f:
    f.write(f"proportion_junior_replicated_rpp = {prop:.6f}\n")
    f.write(f"n_replicated_rpp = {n_denom}\n")
    f.write(f"n_junior = {n_junior}\n")
    f.write("hypothesis = " + hypothesis + "\n")
