#!/usr/bin/env python3
"""Analisis final DiscoveryBench: dominio con sujetos estudiantes (original 82.4%, replica 80.9%).
Cubrimos: % students por disciplina (fila y estudio unico), sensibilidad drop/aggregated,
manejo del unico NaN, y seleccion del dominio."""
import pandas as pd
import json

df = pd.read_csv("data/meta-regression_study_data_heterogeneity_in_replication_projects.csv")
byid = df.drop_duplicates(subset=['id'])          # estudio unico (141)

def students_pct(sub):
    """% de estudiantes entre valores NO nulos de la serie."""
    n = sub.notna().sum()
    return (sub=='students').sum()/n*100, int((sub=='students').sum()), int(n)

def table(d, label):
    print(f"\n===== {label} =====")
    print(f"{'discipline':<12}{'n':>5}{'o%':>8}{'r%':>8}")
    for disc in ['Social','Cognitive','Economics']:
        g = d[d['discipline']==disc]
        o = students_pct(g['subjects.o'])
        r = students_pct(g['subjects.r'])
        print(f"{disc:<12}{len(g):>5}{o[0]:>8.2f}{r[0]:>8.2f}   (o {o[1]}/{o[2]}, r {r[1]}/{r[2]})")

table(df, "POR FILA - todas las 927 filas laboratorio")
table(byid, "POR ESTUDIO UNICO - 141 ids (primera fila por id)")

# Sensibilidad: excluir drop==True y aggregated==True
d_nodrop = df[df['drop']==False]
d_noagg = df[~(df['aggregated']==True)]
d_clean  = df[(df['drop']==False) & ~(df['aggregated']==True)]
table(d_nodrop, "SENSIBILIDAD - excluyendo drop==True")
table(d_noagg,  "SENSIBILIDAD - excluyendo aggregated==True")
table(d_clean,  "SENSIBILIDAD - excluyendo drop==True y aggregated==True")
table(d_clean.drop_duplicates(subset=['id']), "SENSIBILIDAD - limpio y por estudio unico")

# Valores unicos y missing
print("\n===== Valores unicos / missing =====")
for col in ['discipline','subjects.o','subjects.r']:
    print(col, "->", df[col].value_counts(dropna=False).to_dict(), "| missing:", int(df[col].isna().sum()))
print("fila con NaN en subjects:", df[df['subjects.o'].isna()][['id','discipline','project','subjects.o','subjects.r']].to_string(index=False))
print("n labs repetidos por id (dup rows / unique ids):", df.duplicated(subset=['id']).sum(), "/", df['id'].nunique())

# Resumen ejecutivo (json para el payload/workflow)
summary = {
    "n_rows": len(df), "n_unique_studies": byid['id'].nunique(),
    "row_level": {d: {"n_rows": int((df['discipline']==d).sum()),
                      "o_pct": round(students_pct(df[df['discipline']==d]['subjects.o'])[0],2),
                      "r_pct": round(students_pct(df[df['discipline']==d]['subjects.r'])[0],2)}
                  for d in ['Social','Cognitive','Economics']},
    "study_level": {d: {"n_ids": int(byid[byid['discipline']==d]['id'].nunique()),
                        "o_pct": round(students_pct(byid[byid['discipline']==d]['subjects.o'])[0],2),
                        "r_pct": round(students_pct(byid[byid['discipline']==d]['subjects.r'])[0],2)}
                    for d in ['Social','Cognitive','Economics']},
    "missing_subjects_rows": int(df['subjects.o'].isna().sum()),
}
with open("data/final_summary.json","w") as f:
    json.dump(summary, f, indent=2)
print("\n===== RESUMEN JSON =====")
print(json.dumps(summary, indent=2))
