import pandas as pd

# Main data file with original-study metadata (incl. experiment_country.o)
path = 'data/meta-regression_study_data_heterogeneity_in_replication_projects.csv'
df = pd.read_csv(path)

# 1) Confirm scope: project "ee" == Experimental Economics Replication Project (EERP)
ee = df[df['project'] == 'ee'].copy()
print('Rows in whole file:', len(df), '| unique ids:', df['id'].nunique())
print('Project counts:', df['project'].value_counts().to_dict())
print('EE rows:', len(ee), '| EE unique ids:', ee['id'].nunique())

# 2) Country of the original experiment within project "ee"
vc = ee['experiment_country.o'].value_counts(dropna=False)
print('experiment_country.o (ee):')
print(vc.to_string())

# 3) Numerator / denominator
n_uk = int((ee['experiment_country.o'] == 'United Kingdom').sum())
denom = len(ee)
prop = n_uk / denom
print(f'UK original studies: {n_uk} / {denom} = {prop:.4f} (~{prop*100:.1f}%)')
print('UK study id/title:')
print(ee.loc[ee['experiment_country.o'] == 'United Kingdom',
             ['id', 'title', 'experiment_country.o']].to_string(index=False))

# 4) Robustness checks
print('EE discipline unique:', ee['discipline'].unique())
print('EE duplicate ids:', int(ee['id'].duplicated().sum()), '| duplicate titles:', int(ee['title'].duplicated().sum()))
print('Missing experiment_country.o overall:', int(df['experiment_country.o'].isna().sum()),
      '| in EE:', int(ee['experiment_country.o'].isna().sum()))
uk_aliases = [v for v in df['experiment_country.o'].dropna().unique()
              if any(k in str(v) for k in ['UK', 'U.K', 'Great Britain', 'England', 'Britain'])]
print('UK-like alias values found:', uk_aliases)
