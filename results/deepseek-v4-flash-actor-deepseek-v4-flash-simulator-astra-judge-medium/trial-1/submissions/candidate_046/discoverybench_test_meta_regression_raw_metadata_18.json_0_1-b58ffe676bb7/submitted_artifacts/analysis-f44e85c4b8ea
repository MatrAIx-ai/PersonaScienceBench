"""
Final analysis: proportion of Experimental Economics (project == 'ee') studies
conducted in a lab setting.

Operational definition (primary): lab = online.o == 0 (in-person / physical lab).
Sensitivity (strict): lab = online.o == 0 AND subjects.o == 'students'.

Unit of counting: original studies (one row per study in the ee subset).
"""
import pandas as pd

SRC = 'data/meta-regression_study_data_heterogeneity_in_replication_projects.csv'
df = pd.read_csv(SRC)

# ---- subset: Experimental Economics project ----
ee = df[df['project'] == 'ee'].copy()
n_total = len(ee)

# ---- missingness check on setting columns (ee) ----
for c in ['online.o', 'subjects.o', 'experiment_country.o', 'online.r', 'subjects.r']:
    assert ee[c].isna().sum() == 0, f'{c} has missing values in ee'

# ---- unit-of-counting check: one row per study in ee ----
assert ee['id'].nunique() == n_total, 'multiple rows per study in ee'

# ---- primary definition: lab = not online ----
n_lab_primary = int((ee['online.o'] == 0).sum())
pct_primary = 100.0 * n_lab_primary / n_total

# ---- sensitivity definition: in-person + student subjects ----
n_lab_strict = int(((ee['online.o'] == 0) & (ee['subjects.o'] == 'students')).sum())
pct_strict = 100.0 * n_lab_strict / n_total

# ---- consistency checks ----
n_online_o = int((ee['online.o'] == 1).sum())
n_online_r = int((ee['online.r'] == 1).sum())
subj_o = ee['subjects.o'].value_counts().to_dict()
same_online_all = ee['same_online'].eq(1).all()

# ---- results ----
print('EE studies (n):                    ', n_total)
print('online.o == 1 (online originals):  ', n_online_o)
print('online.r == 1 (online replications):', n_online_r)
print('subjects.o counts:                 ', subj_o)
print('same_online all == 1:              ', same_online_all)
print()
print('PRIMARY  (lab = online.o==0)      : %d/%d = %.1f%%' % (n_lab_primary, n_total, pct_primary))
print('STRICT   (+ subjects.o==students) : %d/%d = %.1f%%' % (n_lab_strict, n_total, pct_strict))

# ---- hypothesis statement ----
hypothesis = (
    f"Among the {n_total} original studies in the Experimental Economics replication "
    f"project (project=='ee'), {n_lab_primary} of {n_total} "
    f"({pct_primary:.0f}%) were conducted in a lab setting — defined as an in-person / "
    f"non-online experiment (online.o == 0) — because none of the EE originals were run "
    f"online. Under the stricter definition that additionally requires student subjects "
    f"(subjects.o == 'students'), the share is {n_lab_strict} of {n_total} "
    f"({pct_strict:.0f}%)."
)
print()
print('HYPOTHESIS:', hypothesis)
