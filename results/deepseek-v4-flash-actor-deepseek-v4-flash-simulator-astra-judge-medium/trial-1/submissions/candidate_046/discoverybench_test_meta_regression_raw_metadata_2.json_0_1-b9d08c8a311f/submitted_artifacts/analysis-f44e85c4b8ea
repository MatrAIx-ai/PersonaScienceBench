"""Main analysis: average length (pages) of original papers by field group.
Aggregates at unique-study level (dedupe on id). Primary grouping:
- Experimental Economics = project=='ee'
- Psychology = project=='rpp'   (per dataset guide; rpp -> Psychology)
Sensitivities: Psychology = discipline in {Social,Cognitive}; project in {rpp,ml1,ml3}.
Outlier sensitivity: 1.5xIQR exclusion.
"""
import pandas as pd, numpy as np
from scipy import stats

df = pd.read_csv('data/meta-regression_study_data_heterogeneity_in_replication_projects.csv')
uniq = df.drop_duplicates('id').copy()          # 141 unique original studies
assert len(uniq) == 141

def summarize(g, label):
    x = g['length'].dropna()
    res = dict(group=label, n=len(x), mean=float(x.mean()), median=float(x.median()),
               std=float(x.std(ddof=1)), min=int(x.min()), max=int(x.max()), na=int(len(g)-len(x)))
    return res

rows = []
ee  = uniq[uniq['project'] == 'ee']                       # Experimental Economics (n=18)
rpp = uniq[uniq['project'] == 'rpp']                      # Psychology primary (n=97)
psb = uniq[uniq['discipline'].isin(['Social', 'Cognitive'])]  # Psychology by discipline (n=123)

rows.append(summarize(ee,  'Experimental Economics (project==ee)'))
rows.append(summarize(rpp, 'Psychology (project==rpp)  [PRIMARY]'))
rows.append(summarize(psb, 'Psychology (discipline in Social,Cognitive) [sensitivity]'))
rows.append(summarize(uniq[uniq['project'].isin(['rpp','ml1','ml3'])],
                      'Psychology (project in rpp,ml1,ml3) [sensitivity]'))

tab = pd.DataFrame(rows)
print(tab.to_string(index=False))

# Welch t-test for the PRIMARY comparison (Economics vs rpp Psychology)
t, p = stats.ttest_ind(ee['length'], rpp['length'], equal_var=False)
dof = (ee['length'].std(ddof=1)**2/len(ee) + rpp['length'].std(ddof=1)**2/len(rpp))**2 / \
      ((ee['length'].std(ddof=1)**2/len(ee))**2/(len(ee)-1) +
       (rpp['length'].std(ddof=1)**2/len(rpp))**2/(len(rpp)-1))
ci = stats.t.ppf(0.975, dof)
diff = ee['length'].mean() - rpp['length'].mean()
se = np.sqrt(ee['length'].var(ddof=1)/len(ee) + rpp['length'].var(ddof=1)/len(rpp))
print(f"\nPRIMARY differential (EE - Psychology/rpp): mean_diff={diff:.3f} pages, "
      f"95% CI=[{diff-ci*se:.3f}, {diff+ci*se:.3f}], Welch t={t:.3f}, p={p:.3e}, dof~{dof:.1f}")

# Outlier sensitivity (1.5xIQR) for primary groups
def fences(x):
    q1, q3 = x.quantile(.25), x.quantile(.75)
    iqr = q3 - q1
    return q1 - 1.5*iqr, q3 + 1.5*iqr
for g, name in [(ee,'EE'), (rpp,'Psychology_rpp')]:
    lo, hi = fences(g['length'])
    keep = g['length'][(g['length'] >= lo) & (g['length'] <= hi)]
    print(f"Outlier sensitivity {name}: {len(g)-len(keep)} outliers excluded "
          f"(fence {lo:.1f}-{hi:.1f}); mean without outliers = {keep.mean():.3f} (n={len(keep)})")
