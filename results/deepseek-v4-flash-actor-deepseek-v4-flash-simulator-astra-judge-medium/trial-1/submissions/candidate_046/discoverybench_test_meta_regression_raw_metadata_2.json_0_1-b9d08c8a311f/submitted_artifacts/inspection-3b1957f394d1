import pandas as pd

df = pd.read_csv('data/meta-regression_study_data_heterogeneity_in_replication_projects.csv')

print('Shape (rows):', df.shape[0])
print('Unique studies (id):', df['id'].nunique())
print('Fully duplicated rows:', df.duplicated().sum())
print('Ids with varying length within id:', (df.groupby('id')['length'].nunique() > 1).sum())

print('\nproject values:')
print(df['project'].value_counts(dropna=False))
print('\ndiscipline values:')
print(df['discipline'].value_counts(dropna=False))

print('\nproject x discipline cross-tab:')
print(pd.crosstab(df['project'], df['discipline']))

print('\nlength: dtype=', df['length'].dtype, ' NA=', int(df['length'].isna().sum()))
print(df['length'].describe())

uniq = df.drop_duplicates('id')

def stats(g, label):
    print(f'{label}: n={len(g)}, mean={g["length"].mean():.3f}, median={g["length"].median()}, '
          f'min={g["length"].min()}, max={g["length"].max()}, NA={int(g["length"].isna().sum())}')

print('\n--- Study-level length summaries (unique id) ---')
stats(uniq[uniq['project'] == 'ee'], 'Experimental Economics (project==ee / disc==Economics)')
stats(uniq[uniq['project'] == 'rpp'], 'Psychology A: project==rpp')
stats(uniq[uniq['discipline'].isin(['Social', 'Cognitive'])], 'Psychology B: discipline in {Social,Cognitive}')
stats(uniq[uniq['project'].isin(['rpp', 'ml1', 'ml3'])], 'Psychology C: project in {rpp,ml1,ml3}')

print('\n--- Row-level (lab-level) length means (for contrast) ---')
for p in ['ee', 'rpp', 'ml1', 'ml3']:
    sub = df[df['project'] == p]
    print(f'{p}: rows={len(sub)}, mean={sub["length"].mean():.3f}')
