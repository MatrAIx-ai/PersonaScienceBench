# --- Primary metric: proportion of pairs male-majority in BOTH ---
pairs['both_male'] = (pairs['authors_male.o'] > 0.5) & (pairs['authors_male.r'] > 0.5)
grp = pairs.groupby('discipline')
tab = pd.DataFrame({
    'n_pairs': grp.size(),
    'both_majority_male': grp['both_male'].sum(),
    'prop_both_gt05': grp['both_male'].mean(),
    'prop_orig_gt05': grp['authors_male.o'].apply(lambda s: (s > 0.5).mean()),
    'prop_rep_gt05':  grp['authors_male.r'].apply(lambda s: (s > 0.5).mean()),
    'mean_male.o': grp['authors_male.o'].mean(),
    'mean_male.r': grp['authors_male.r'].mean(),
    'median_male.o': grp['authors_male.o'].median(),
    'median_male.r': grp['authors_male.r'].median(),
})
print('=== PRIMARY: by discipline (141 pairs) ===')
print(tab.round(3).to_string())
print()
