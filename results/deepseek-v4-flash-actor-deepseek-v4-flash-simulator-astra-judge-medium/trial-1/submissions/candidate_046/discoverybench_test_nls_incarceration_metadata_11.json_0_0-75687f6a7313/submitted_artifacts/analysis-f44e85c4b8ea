"""Main analysis: demographic disparities in median 1985 wealth among ever-incarcerated.
Disclosure-safe, executed on nls_incarceration_processed.csv."""
import pandas as pd

DF = pd.read_csv('data/nls_incarceration_processed.csv')
W = 'composite_wealth_1985'

# Normalize race typo for display
DF['race'] = DF['race'].replace({'hipanic': 'hispanic'})
pd.set_option('display.width', 250)
pd.set_option('display.max_columns', None)

def summarize(g, label):
    out = []
    for (key, grp), jl in zip(g.groupby(['race', 'sex']), ['ever']):
        pass
    return out

print('=' * 80)
print('TABLE A. Overall context (median wealth 1985, all groups)')
print('=' * 80)
for ej, gl in DF.groupby('ever_jailed'):
    print(f'ever_jailed={ej}: n={len(gl):6d}  median={gl[W].median():10.0f}  mean={gl[W].mean():10.0f}')

print()
print('=' * 80)
print('TABLE B. Among ever_jailed == 1 (n=289) / and non-jailed reference (n=11724)')
print('Groups: race, sex, and race x sex. Reported: n, median(raw incl zeros),')
print('median(excl zeros, n>0), % zero, % positive, % negative.')
print('=' * 80)

def block(df, groupers, title):
    print(f'\n--- {title} ---')
    rows = []
    for key, g in df.groupby(groupers, dropna=False):
        keyt = key if isinstance(key, tuple) else (key,)
        n = len(g)
        nz = (g[W] > 0).sum()
        zeros = (g[W] == 0).sum()
        neg = (g[W] < 0).sum()
        med_raw = g[W].median()
        med_nz = g[W][g[W] > 0].median() if nz > 0 else float('nan')
        rows.append({
            **dict(zip(['race', 'sex'][:len(keyt)], keyt)),
            'n': n, 'median_raw': med_raw, 'median_gt0': med_nz,
            'pct_zero': round(100 * zeros / n, 1),
            'pct_pos': round(100 * nz / n, 1),
            'pct_neg': round(100 * neg / n, 1),
        })
    t = pd.DataFrame(rows)
    print(t.to_string(index=False))
    return t

jailed = DF[DF['ever_jailed'] == 1]
never = DF[DF['ever_jailed'] == 0]

t_race_j = block(jailed, ['race'], 'Jailed: by race')
t_sex_j = block(jailed, ['sex'], 'Jailed: by sex')
t_cross_j = block(jailed, ['race', 'sex'], 'Jailed: by race x sex')
t_race_n = block(never, ['race'], 'Never jailed: by race (reference)')
t_sex_n = block(never, ['sex'], 'Never jailed: by sex (reference)')
t_cross_n = block(never, ['race', 'sex'], 'Never jailed: by race x sex (reference)')

print()
print('=' * 80)
print('TABLE C. Disparity ratios (jailed median / never-jailed median), raw medians')
print('=' * 80)
cross = jailed.groupby(['race', 'sex'])[W].median().rename('med_j')
cross_n = never.groupby(['race', 'sex'])[W].median().rename('med_n')
ratio = pd.concat([cross, cross_n], axis=1)
ratio['ratio_j_to_n'] = ratio['med_j'] / ratio['med_n'].replace(0, np_nan := float('nan'))
print(ratio.to_string())

print()
print('=' * 80)
print('TABLE D. Gap within jailed: female vs male median by race')
print('=' * 80)
print(ratio.to_string())

