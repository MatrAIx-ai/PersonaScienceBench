"""Exploratory analysis of NLSY79 processed incarceration/wealth data.
Question: demographic disparities in median 1985 wealth among ever-incarcerated individuals."""
import pandas as pd

DF = pd.read_csv('data/nls_incarceration_processed.csv')
pd.set_option('display.max_columns', None)
pd.set_option('display.width', 250)

print('SHAPE:', DF.shape)
print('\nDTYPES:\n', DF.dtypes, sep='')
print('\nMISSING (NaNs per col):')
print(DF.isna().sum())
for c in ['race', 'sex']:
    print(c, 'blank-string count:', (DF[c].astype(str).str.strip() == '').sum())

print('\never_jailed value counts:', DF['ever_jailed'].value_counts().to_dict())
print('\ncross-tab race x ever_jailed:\n', pd.crosstab(DF['race'], DF['ever_jailed'], margins=True))
print('\ncross-tab sex x ever_jailed:\n', pd.crosstab(DF['sex'], DF['ever_jailed'], margins=True))
print('\ncross-tab race x sex x ever_jailed:\n',
      pd.crosstab([DF['race'], DF['sex']], DF['ever_jailed']))

w = 'composite_wealth_1985'
print('\nwealth 1985 zeros:', (DF[w] == 0).sum(), '(', round((DF[w] == 0).mean() * 100, 2), '%)')
print('wealth 1985 negative:', (DF[w] < 0).sum())
print('wealth 1985 quantiles:\n', DF[w].quantile([0, .1, .25, .5, .75, .9, 1]))

print('\nmedian wealth 1985 by ever_jailed:')
print(DF.groupby('ever_jailed')[w].median())

print('\ngroup table (count, median, mean) by race x sex x ever_jailed:')
print(DF.groupby(['race', 'sex', 'ever_jailed'])[w].agg(['count', 'median', 'mean']).to_string())

sub = DF[DF['ever_jailed'] == 1].copy()
print('\n=== ever_jailed==1 (n=%d) ===' % len(sub))
print('by race:\n', sub.groupby('race')[w].agg(['count', 'median', 'mean']).to_string())
print('by sex:\n', sub.groupby('sex')[w].agg(['count', 'median', 'mean']).to_string())
print('by race x sex:\n', sub.groupby(['race', 'sex'])[w].agg(['count', 'median', 'mean']).to_string())
print('\nunique race labels:', DF['race'].unique().tolist())
