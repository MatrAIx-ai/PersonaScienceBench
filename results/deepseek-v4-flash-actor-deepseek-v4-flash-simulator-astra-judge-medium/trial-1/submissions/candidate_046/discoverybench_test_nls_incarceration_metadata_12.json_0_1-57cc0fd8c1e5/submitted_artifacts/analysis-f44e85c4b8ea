"""Main analysis: incarceration and wealth of black individuals by income-stratum proxy.
Proxy for 'income level': terciles of composite_wealth_1985 within the black subsample.
Associational, descriptive-inferential only. Medians/means with bootstrap CIs + effect sizes.
"""
import pandas as pd
import numpy as np

rng = np.random.default_rng(2026)
W = ['composite_wealth_1985', 'composite_wealth_1990', 'composite_wealth_1996']
YR = {'composite_wealth_1985': 1985, 'composite_wealth_1990': 1990, 'composite_wealth_1996': 1996}

df = pd.read_csv("data/nls_incarceration_processed.csv")
b = df[df['race'] == 'black'].copy()

def boot_ci(x, stat=np.median, n_boot=20000, alpha=0.05):
    """Percentile bootstrap CI and bootstrap SE for a statistic."""
    x = np.asarray(x, dtype=float)
    if len(x) == 0:
        return (np.nan, np.nan, np.nan, 0)
    boots = np.array([stat(rng.choice(x, size=len(x), replace=True)) for _ in range(n_boot)])
    lo, hi = np.percentile(boots, [100*alpha/2, 100*(1-alpha/2)])
    return (stat(x), lo, hi, boots.std(ddof=1))

def describe_group(g, label):
    out = []
    med_by_year = {}
    for c in W:
        med, lo, hi, se = boot_ci(g[c].values)
        med_by_year[c] = (med, lo, hi)
        out.append(f"{label} {YR[c]} median={med:,.0f} [{lo:,.0f}, {hi:,.0f}] se~{se:,.0f} | mean={g[c].mean():,.0f}")
    return "\n".join(out), med_by_year

# Stratify within black using 1985 wealth terciles (duplicates='drop' due to mass of zeros)
b['stratum'] = pd.qcut(b['composite_wealth_1985'], 3,
                       labels=['low', 'mid', 'high'], duplicates='drop')
print("=== STRATUM SIZES (black) ===")
print(pd.crosstab(b['stratum'], b['ever_jailed'], margins=True))

# Per-individual wealth changes
b['d85_90'] = b['composite_wealth_1990'] - b['composite_wealth_1985']
b['d90_96'] = b['composite_wealth_1996'] - b['composite_wealth_1990']
b['d85_96'] = b['composite_wealth_1996'] - b['composite_wealth_1985']

rows = []
print("\n=== MEDIAN WEALTH BY STRATUM x JAILED x YEAR (bootstrap CI) ===")
for st in ['low', 'mid', 'high']:
    for j in [0, 1]:
        g = b[(b['stratum'] == st) & (b['ever_jailed'] == j)]
        print(f"-- stratum={st} jailed={j} n={len(g)}")
        txt, med_by_year = describe_group(g, f"  [{st}, jailed={j}]")
        print(txt)
        rows.append(dict(stratum=st, jailed=j, n=len(g),
                         **{f"med_{y}": med_by_year[c][0] for c, y in YR.items()},
                         **{f"lo_{y}": med_by_year[c][1] for c, y in YR.items()},
                         **{f"hi_{y}": med_by_year[c][2] for c, y in YR.items()}))

med_tab = pd.DataFrame(rows)
print("\n=== MEDIAN TABLE (stratum x jailed) ===")
print(med_tab.round(0).to_string(index=False))

print("\n=== MEDIAN PER-INDIVIDUAL WEALTH CHANGE (bootstrap CI) ===")
print("\n--- jailed=0 ---")
for st in ['low', 'mid', 'high']:
    g = b[(b['stratum'] == st) & (b['ever_jailed'] == 0)]
    m1, l1, h1, _ = boot_ci(g['d85_90']); m2, l2, h2, _ = boot_ci(g['d90_96']); m3, l3, h3, _ = boot_ci(g['d85_96'])
    print(f"{st} n={len(g)}: d85->90 med {m1:,.0f} [{l1:,.0f},{h1:,.0f}] | "
          f"d90->96 med {m2:,.0f} [{l2:,.0f},{h2:,.0f}] | d85->96 med {m3:,.0f} [{l3:,.0f},{h3:,.0f}]")
print("\n--- jailed=1 ---")
for st in ['low', 'mid', 'high']:
    g = b[(b['stratum'] == st) & (b['ever_jailed'] == 1)]
    m1, l1, h1, _ = boot_ci(g['d85_90']); m2, l2, h2, _ = boot_ci(g['d90_96']); m3, l3, h3, _ = boot_ci(g['d85_96'])
    print(f"{st} n={len(g)}: d85->90 med {m1:,.0f} [{l1:,.0f},{h1:,.0f}] | "
          f"d90->96 med {m2:,.0f} [{l2:,.0f},{h2:,.0f}] | d85->96 med {m3:,.0f} [{l3:,.0f},{h3:,.0f}]")

print("\n=== JAILED MINUS NOT-JAILED: MEDIAN d85->96 (bootstrap CI of the difference) ===")
for st in ['low', 'mid', 'high']:
    g0 = b[(b['stratum'] == st) & (b['ever_jailed'] == 0)]['d85_96'].values
    g1 = b[(b['stratum'] == st) & (b['ever_jailed'] == 1)]['d85_96'].values
    # bootstrap the difference of median changes
    reps = []
    for _ in range(20000):
        reps.append(np.median(rng.choice(g1, len(g1), replace=True)) -
                    np.median(rng.choice(g0, len(g0), replace=True)))
    lo, hi = np.percentile(reps, [2.5, 97.5])
    print(f"stratum={st}: diff(jailed-not) median of d85->96 = {np.median(reps):,.0f} "
          f"[{lo:,.0f}, {hi:,.0f}] (bootstrap); n0={len(g0)}, n1={len(g1)}")

# Effect sizes: Glass-style delta (group diff in medians of d85_96 / pooled SD of d85_96)
print("\n=== EFFECT SIZE (Glass-like, median diff / pooled-SD of d85_96) and 1996 medians ===")
for st in ['low', 'mid', 'high']:
    g0 = b[(b['stratum'] == st) & (b['ever_jailed'] == 0)]
    g1 = b[(b['stratum'] == st) & (b['ever_jailed'] == 1)]
    pooled_sd = np.sqrt((g0['d85_96'].var() + g1['d85_96'].var()) / 2)
    delt = (g1['d85_96'].median() - g0['d85_96'].median()) / pooled_sd
    print(f"stratum={st}: median d85_96 jailed={g1['d85_96'].median():,.0f} vs not={g0['d85_96'].median():,.0f} "
          f"| delta={delt:.3f} | med96 jailed={g1['composite_wealth_1996'].median():,.0f} "
          f"vs not={g0['composite_wealth_1996'].median():,.0f}")

# Nonparametric check (Mann-Whitney on 1996 wealth), reported as context only
from scipy.stats import mannwhitneyu
print("\n=== CONTEXT: Mann-Whitney U on 1996 wealth per stratum (U, p) ===")
for st in ['low', 'mid', 'high']:
    g0 = b[(b['stratum'] == st) & (b['ever_jailed'] == 0)]['composite_wealth_1996'].values
    g1 = b[(b['stratum'] == st) & (b['ever_jailed'] == 1)]['composite_wealth_1996'].values
    U, p = mannwhitneyu(g0, g1, alternative='two-sided')
    print(f"stratum={st}: U={U:,.0f} p={p:.4f} (context only)")

# Robustness: terciles of 1990 wealth within black; terciles of 1985 in full sample
print("\n=== ROBUSTNESS A: terciles of 1990 wealth within black ===")
b['stratum90'] = pd.qcut(b['composite_wealth_1990'], 3, labels=['low', 'mid', 'high'], duplicates='drop')
print(pd.crosstab(b['stratum90'], b['ever_jailed'], margins=True))
for st in ['low', 'mid', 'high']:
    g0 = b[(b['stratum90'] == st) & (b['ever_jailed'] == 0)]
    g1 = b[(b['stratum90'] == st) & (b['ever_jailed'] == 1)]
    if len(g1) == 0:
        print(f"  {st}: no jailed cases")
        continue
    m0, l0, h0, _ = boot_ci(g0['composite_wealth_1996'])
    m1, l1, h1, _ = boot_ci(g1['composite_wealth_1996'])
    print(f"  stratum90={st}: med96 not={m0:,.0f} [{l0:,.0f},{h0:,.0f}] (n={len(g0)}) | "
          f"jailed={m1:,.0f} [{l1:,.0f},{h1:,.0f}] (n={len(g1)})")

print("\n=== ROBUSTNESS B: terciles of 1985 wealth in FULL sample, applied to black ===")
full = df.copy()
full['stratum_all'] = pd.qcut(full['composite_wealth_1985'], 3, labels=['low', 'mid', 'high'], duplicates='drop')
b2 = full[full['race'] == 'black'].copy()
b2['stratum_all'] = pd.Categorical(b2['stratum_all'])
print(pd.crosstab(b2['stratum_all'], b2['ever_jailed'], margins=True))
for st in ['low', 'mid', 'high']:
    g0 = b2[(b2['stratum_all'] == st) & (b2['ever_jailed'] == 0)]
    g1 = b2[(b2['stratum_all'] == st) & (b2['ever_jailed'] == 1)]
    if len(g1) == 0:
        print(f"  {st}: no jailed cases")
        continue
    m0, l0, h0, _ = boot_ci(g0['composite_wealth_1996'])
    m1, l1, h1, _ = boot_ci(g1['composite_wealth_1996'])
    print(f"  strata_all={st}: med96 not={m0:,.0f} [{l0:,.0f},{h0:,.0f}] (n={len(g0)}) | "
          f"jailed={m1:,.0f} [{l1:,.0f},{h1:,.0f}] (n={len(g1)})")

print("\n=== DONE ===")
