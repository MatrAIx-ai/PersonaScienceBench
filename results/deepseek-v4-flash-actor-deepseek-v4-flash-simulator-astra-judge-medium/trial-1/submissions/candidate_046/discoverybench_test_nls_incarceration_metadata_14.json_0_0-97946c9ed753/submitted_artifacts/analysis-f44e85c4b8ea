#!/usr/bin/env python3
"""
DiscoveryBench analysis: nls_incarceration_processed.csv
Question: "Between which years did the largest increases in median wealth occur among black females?"
Author: research agent
Description:
  - Subset race=='black' & sex=='female'
  - Compute median composite_wealth for 1985, 1990, 1996
  - Compute absolute and relative (%) increases for 1985->1990, 1990->1996, 1985->1996
  - Identify the interval with the largest increase
  - Output a machine-readable evidence table + natural-language hypothesis
"""
import pandas as pd

DATA = "data/nls_incarceration_processed.csv"
CW = ["composite_wealth_1985", "composite_wealth_1990", "composite_wealth_1996"]
YEARS = [1985, 1990, 1996]

df = pd.read_csv(DATA)
print("Input shape:", df.shape)
print("Missing values per column:\n", df.isna().sum())

# --- Filter: black females only (not conditional on ever_jailed) ---
bf = df[(df["race"] == "black") & (df["sex"] == "female")].copy()
print(f"\nBlack females N = {len(bf)}")

medians = pd.Series({y: bf[c].median() for c, y in zip(CW, YEARS)}, name="median_wealth")
print("\nMedians (nominal USD):\n", medians)

# --- Pairwise increases ---
pairs = [(1985, 1990), (1990, 1996), (1985, 1996)]
rows = []
for a, b in pairs:
    m_a = medians[a]
    m_b = medians[b]
    abs_diff = m_b - m_a
    pct = (abs_diff / m_a * 100) if m_a != 0 else float("nan")
    rows.append({"from_year": a, "to_year": b,
                 "median_from": m_a, "median_to": m_b,
                 "abs_increase": abs_diff, "pct_increase": pct})

inc = pd.DataFrame(rows)
print("\nPairwise increases (absolute & %):\n", inc.round(2).to_string(index=False))

# --- Interpretation ---
adj = inc[inc["to_year"] - inc["from_year"] == 5]  # adjacent pairs only
largest_abs = inc.loc[inc["abs_increase"].idxmax()]
largest_adj_abs = adj.loc[adj["abs_increase"].idxmax()]
largest_pct = inc.loc[inc["pct_increase"].idxmax()]

print("\nLargest increase overall (incl. full period, absolute):",
      f"{largest_abs['from_year']}->{largest_abs['to_year']}  Δ={largest_abs['abs_increase']:.0f}")
print("Largest increase among ADJACENT pairs (absolute):",
      f"{int(largest_adj_abs["from_year"])}->{int(largest_adj_abs["to_year"])}  Δ={largest_adj_abs['abs_increase']:.0f}")
print("Largest increase (percentage):",
      f"{largest_pct['from_year']}->{largest_pct['to_year']}  Δ%={largest_pct['pct_increase']:.1f}%")

hypothesis = (
    f"Among black females, median (composite) wealth was ${medians[1985]:,.0f} in 1985, "
    f"${medians[1990]:,.0f} in 1990 and ${medians[1996]:,.0f} in 1996 (nominal dollars). "
    f"The largest increase occurred between {int(largest_adj_abs["from_year"])} and {int(largest_adj_abs["to_year"])}, "
    f"with an absolute rise of ${largest_adj_abs['abs_increase']:,.0f} "
    f"(+{largest_adj_abs['pct_increase']:.1f}%), exceeding the change between "
    f"1990 and 1996 (Δ${inc[(inc['from_year']==1990)&(inc['to_year']==1996)]['abs_increase'].iloc[0]:,.0f}). "
    f"The full-period 1985->1996 rise (Δ${inc[(inc['from_year']==1985)&(inc['to_year']==1996)]['abs_increase'].iloc[0]:,.0f}) "
    f"is the largest cumulative change."
)
print("\nHYPOTHESIS:\n" + hypothesis)

# Persist evidence + hypothesis
medians.to_frame().to_csv("analysis/medians_black_female.csv")
inc.to_csv("analysis/increases_black_female.csv", index=False)
with open("analysis/hypothesis.txt", "w") as fh:
    fh.write(hypothesis)

print("\nSaved: analysis/medians_black_female.csv, analysis/increases_black_female.csv, analysis/hypothesis.txt")
