#!/usr/bin/env python3
"""
Wealth inequality for white males & females, NLSY79 (processed NLS data).
Question: What changes occurred in the wealth inequality for white males and
females between 1990 and 1996?

Design (per approved plan):
  - Groups: white-female, white-male; years 1990 vs 1996; plus gender gap.
  - Metrics: percentiles, mean/median, Gini, ratios 90/50 & 75/25, mean/median
    ratio, top-10% / top-5% / top-1% wealth shares, share of the bottom half.
  - Robustness: RAW vs DEDUPLICATED (exact duplicate rows removed) reported side
    by side for the key metrics; no single preprocessing is used for the verdict.
  - Variables are nominal dollars (no deflator available) -> caveat in report.
"""
import pandas as pd
import numpy as np

DATA = "data/nls_incarceration_processed.csv"
OUT = "summary_inequality_metrics.csv"

# ---------------------------------------------------------------- helpers
def gini(s: pd.Series) -> float:
    """Gini coefficient; accepts negatives (net wealth). Formula = rel. mean diff."""
    v = np.sort(s.to_numpy(dtype=float))
    n = len(v)
    if n == 0 or v.sum() == 0:
        return np.nan
    idx = np.arange(1, n + 1)
    return (2 * np.sum(idx * v)) / (n * np.sum(v)) - (n + 1) / n

def wealth_share(s: pd.Series, q: float) -> tuple:
    """
    Share of total wealth held by the wealthiest q-fraction of respondents.
    Returns (share_including_negatives, share_truncating_negatives_to_0).
    """
    v = np.sort(s.to_numpy(dtype=float))
    k = max(1, int(round(q * len(v))))  # number of respondents in the top q-fraction
    top = v[-k:]
    total_raw = v.sum()
    total_pos = v[v > 0].sum()
    sh_raw = top.sum() / total_raw if total_raw != 0 else np.nan
    sh_pos = top.sum() / total_pos if total_pos != 0 else np.nan
    return sh_raw, sh_pos

def bottom_half_share(s: pd.Series) -> tuple:
    v = np.sort(s.to_numpy(dtype=float))
    k = len(v) // 2
    bot = v[:k]
    total_raw = v.sum()
    total_pos = v[v > 0].sum()
    return (bot.sum() / total_raw if total_raw != 0 else np.nan, bot.sum() / total_pos if total_pos != 0 else np.nan)

def summarize(sub: pd.DataFrame, year: int):
    c = f"composite_wealth_{year}"
    s = sub[c].astype(float)
    p = {q: s.quantile(q) for q in [0.10, 0.25, 0.50, 0.75, 0.90, 0.95, 0.99]}
    top10 = wealth_share(s, 0.10)
    top5 = wealth_share(s, 0.05)
    top1 = wealth_share(s, 0.01)
    bot50 = bottom_half_share(s)
    return {
        "n": len(s), "neg": int((s < 0).sum()), "zero": int((s == 0).sum()),
        "mean": s.mean(), "median": s.median(),
        "p10": p[0.10], "p25": p[0.25], "p75": p[0.75],
        "p90": p[0.90], "p95": p[0.95], "p99": p[0.99],
        "gini": gini(s),
        "r90_50": p[0.90] / p[0.50] if p[0.50] > 0 else np.nan,
        "r75_25": p[0.75] / p[0.25] if p[0.25] > 0 else np.nan,
        "mean_med": s.mean() / s.median() if s.median() > 0 else np.nan,
        "top10_share_tot": top10[0], "top10_share_pos": top10[1],
        "top5_share_tot": top5[0],  "top5_share_pos": top5[1],
        "top1_share_tot": top1[0],  "top1_share_pos": top1[1],
        "bot50_share_tot": bot50[0], "bot50_share_pos": bot50[1],
    }

def report(df: pd.DataFrame, label: str):
    rows = []
    for grp in ["female", "male"]:
        sub = df[(df["race"] == "white") & (df["sex"] == grp)]
        for yr in [1990, 1996]:
            r = summarize(sub, yr)
            r["group"], r["year"], r["version"] = f"white-{grp}", yr, label
            rows.append(r)
    return rows

# ---------------------------------------------------------------- load
df = pd.read_csv(DATA)
df_dedup = df.drop_duplicates()

res = report(df, "raw") + report(df_dedup, "dedup")
res = pd.DataFrame(res)
res = res.set_index(["version", "group", "year"]).sort_index()

# format
fmt = res.round(0).astype(object)
for col in ["gini", "r90_50", "r75_25", "mean_med",
            "top10_share_tot", "top10_share_pos", "top5_share_tot", "top5_share_pos",
            "top1_share_tot", "top1_share_pos", "bot50_share_tot", "bot50_share_pos"]:
    fmt[col] = res[col].round(4).astype(object)

def fmt_row(r):
    return (f"  n={r['n']} neg={r['neg']} zero={r['zero']} | mean={r['mean']:>12,.0f} "
            f"med={r['median']:>12,.0f} | p10={r['p10']:>10,.0f} p25={r['p25']:>10,.0f} "
            f"p75={r['p75']:>10,.0f} p90={r['p90']:>10,.0f} p95={r['p95']:>10,.0f} "
            f"p99={r['p99']:>12,.0f}")

print("=" * 140)
print("DISTRIBUTION SUMMARY  (white group, nominal USD)")
print("=" * 140)
for (ver, grp, yr), r in res.iterrows():
    print(f"[{ver.upper():5} | {grp:12} | {yr}] {fmt_row(r)}")

print()
print("=" * 140)
print("INEQUALITY METRICS  (raw vs dedup)")
print("=" * 140)
ineq_cols = ["gini", "r90_50", "mean_med",
             "top10_share_tot", "top10_share_pos", "top1_share_tot", "top1_share_pos",
             "bot50_share_tot", "bot50_share_pos"]
print(res[ineq_cols].to_string())

print()
print("=" * 140)
print("GENDER GAP (white): female-to-male ratios, raw & dedup")
print("=" * 140)
for ver in ["raw", "dedup"]:
    f90 = res.loc[(ver, "white-female", 1990)]
    m90 = res.loc[(ver, "white-male", 1990)]
    f96 = res.loc[(ver, "white-female", 1996)]
    m96 = res.loc[(ver, "white-male", 1996)]
    print(f"\n[{ver}]")
    for yr, F, M in [(1990, f90, m90), (1996, f96, m96)]:
        print(f"  {yr}: F/M mean ratio = {F['mean']/M['mean']:.3f} | "
              f"F/M median ratio = {F['median']/M['median']:.3f} | "
              f"Gini F - Gini M = {F['gini']-M['gini']:+.4f}")
    print(f"  Change 1990->1996: F/M mean ratio {f90['mean']/m90['mean']:.3f} -> {f96['mean']/m96['mean']:.3f}")
    print(f"  Change 1990->1996: F/M median ratio {f90['median']/m90['median']:.3f} -> {f96['median']/m96['median']:.3f}")

if OUT is not None:
    res.to_csv(OUT)
    print(f"\nSaved summary -> {OUT}")
