#!/usr/bin/env python3
"""
Main analysis: in which years did individuals with a criminal record
(ever_jailed=1, jailed 1985-1994) have significantly lower wealth than
those without (ever_jailed=0)?

Agreed criteria:
 - Primary test: two-sided Mann-Whitney U per year on composite wealth,
   keeping negative (debt) and zero values.
 - Multiple comparisons: Bonferroni over 3 years -> alpha per test = 0.05/3
   ~ 0.0167. 'Significantly lower' = Bonferroni-adjusted p < 0.05 AND lower
   median/mean wealth in the jailed group.
 - Complementary only: Welch t-test and robustness regression
   (rank/wealth ~ ever_jailed + race + sex); they do not change the conclusion.
"""
import numpy as np
import pandas as pd
from scipy import stats
import statsmodels.api as sm
import statsmodels.formula.api as smf

df = pd.read_csv('data/nls_incarceration_processed.csv')
wealth_cols = ['composite_wealth_1985', 'composite_wealth_1990', 'composite_wealth_1996']
K = len(wealth_cols)
alpha_family = 0.05
alpha_per = alpha_family / K

# Race/sex as dummies for regression (keep all categories; use dropped base)
df = pd.get_dummies(df, columns=['race', 'sex'], drop_first=True)
# 'race_white' and 'sex_male' are created (hipanic is base race via black dummy
# because alphabetical drops 'hipanic'? check below)
print('Columns after dummies:', [c for c in df.columns])

results = []
for c in wealth_cols:
    g0 = df.loc[df['ever_jailed'] == 0, c]
    g1 = df.loc[df['ever_jailed'] == 1, c]
    n0, n1 = len(g0), len(g1)

    # Primary: two-sided Mann-Whitney U
    mw = stats.mannwhitneyu(g0, g1, alternative='two-sided', method='auto')
    p_raw = mw.pvalue
    p_bonf = min(1.0, p_raw * K)

    # Complement: Welch t-test (two-sided)
    welch = stats.ttest_ind(g0, g1, equal_var=False)

    # Effect metrics
    med0, med1 = g0.median(), g1.median()
    mean0, mean1 = g0.mean(), g1.mean()

    results.append({
        'year': c, 'n_no_jail': n0, 'n_jailed': n1,
        'mean_no_jail': mean0, 'mean_jailed': mean1,
        'median_no_jail': med0, 'median_jailed': med1,
        'p_mw_raw': p_raw, 'p_mw_bonf': p_bonf,
        'p_welch': welch.pvalue,
        'significant': p_bonf < alpha_family and med1 < med0 and mean1 < mean0,
    })

res = pd.DataFrame(results)
print('\n=== PER-YEAR RESULTS ===')
print(res.to_string(index=False, float_format=lambda x: f'{x:.4g}'))
print('\nalpha_per_test =', alpha_per)

print('\nSignificant years (adjusted p < 0.05 AND lower median AND lower mean):')
sig_years = res.loc[res['significant'], 'year'].tolist()
print(sig_years)

# --- Robustness regression: rank of wealth ~ ever_jailed + race + sex (per year) ---
print('\n=== ROBUSTNESS (complement only): rank-regression per year ===')
for c in wealth_cols:
    df['rank_w'] = df[c].rank()
    m = smf.ols('rank_w ~ ever_jailed + race_hipanic + race_white + sex_male', data=df).fit()
    coef = m.params['ever_jailed']
    p = m.pvalues['ever_jailed']
    print(f'{c}: ever_jailed coef={coef:.1f} (rank units), p={p:.3e}')

# --- Robustness regression: raw wealth ~ ever_jailed + race + sex (per year) ---
print('\n=== ROBUSTNESS (complement only): OLS on raw wealth per year ===')
for c in wealth_cols:
    m = smf.ols(f'{c} ~ ever_jailed + race_hipanic + race_white + sex_male', data=df).fit()
    coef = m.params['ever_jailed']
    p = m.pvalues['ever_jailed']
    print(f'{c}: ever_jailed coef={coef:.1f} USD, p={p:.3e}')

print('\nDONE')
