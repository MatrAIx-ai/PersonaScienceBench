#!/usr/bin/env python3
"""Initial inspection of nls_incarceration_processed.csv for the project plan."""
import pandas as pd
from scipy import stats

df = pd.read_csv('data/nls_incarceration_processed.csv')
wealth_cols = ['composite_wealth_1985', 'composite_wealth_1990', 'composite_wealth_1996']

print('Shape:', df.shape)
print('Columns:', list(df.columns))
print('NAs per column:\n', df.isna().sum())
print('\never_jailed distribution:')
print(df['ever_jailed'].value_counts(dropna=False))
print(df['ever_jailed'].value_counts(dropna=False, normalize=True))

print('\n=== Overall descriptive stats ===')
print(df[wealth_cols].describe(percentiles=[.25, .5, .75, .9, .95]).T)

print('\n=== Negative/zero wealth counts ===')
for c in wealth_cols:
    print(c, 'neg:', (df[c] < 0).sum(), 'zero:', (df[c] == 0).sum(), 'pos:', (df[c] > 0).sum())

print('\n=== Group comparisons ===')
for g, grp in df.groupby('ever_jailed'):
    print(f'--- ever_jailed={g} (n={len(grp)}) ---')
    print(grp[wealth_cols].describe(percentiles=[.25, .5, .75, .9, .95]).T[
        ['count', 'mean', 'std', '25%', '50%', '75%', '90%', '95%', 'max']])

print('\n=== Medians by group and skewness ===')
for c in wealth_cols:
    m0, m1 = df.loc[df.ever_jailed == 0, c].median(), df.loc[df.ever_jailed == 1, c].median()
    print(f'{c}: jailed median={m1}, non-jailed median={m0}, ratio={m1 / m0:.3f}')
for c in wealth_cols:
    print(c, 'jailed skew:', round(df.loc[df.ever_jailed == 1, c].skew(), 2),
          'non-jailed skew:', round(df.loc[df.ever_jailed == 0, c].skew(), 2))

print('\n=== Informational p-values (NOT the final analysis) ===')
for c in wealth_cols:
    t = stats.ttest_ind(df.loc[df.ever_jailed == 0, c], df.loc[df.ever_jailed == 1, c], equal_var=False)
    mw = stats.mannwhitneyu(df.loc[df.ever_jailed == 0, c], df.loc[df.ever_jailed == 1, c], alternative='greater')
    print(f'{c}: Welch t p={t.pvalue:.3e}, MWU (greater) p={mw.pvalue:.3e}')
