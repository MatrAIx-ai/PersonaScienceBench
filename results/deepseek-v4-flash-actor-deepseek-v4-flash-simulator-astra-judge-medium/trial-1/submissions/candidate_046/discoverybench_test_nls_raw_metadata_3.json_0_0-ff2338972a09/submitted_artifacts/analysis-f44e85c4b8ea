#!/usr/bin/env python3
"""NLSY79 extract - BA completion (proxy) & SES/race vs academic characteristics."""
import pandas as pd, numpy as np, json, warnings
warnings.filterwarnings('ignore')
import statsmodels.api as sm
import statsmodels.formula.api as smf
from statsmodels.imputation.mice import MICE

df = pd.read_csv('data/nls_raw.csv')
N0 = len(df)
ID = 'ID# (range 1-12686) 1979'
df['id'] = df[ID]
RES = [c for c in df.columns if c.startswith('Type of residence')]
ASV = [c for c in df.columns if c.startswith('ASVAB')]

# ---------- RACE LABEL VERIFICATION ----------
df['asvab_mean'] = df[ASV].mean(axis=1, skipna=True)
df['par_edu_max'] = np.nanmax(df[["Highest grade completed by respondent's mother, 1979",
                                  "Highest grade completed by respondent's father, 1979"]], axis=1)
df['inc79'] = df['Total net family income, previous calendar year, 1979']
race_check = df.groupby('Racial/ethnic cohort, 1979').agg(n=(ID,'size'),asvab=('asvab_mean','mean'),
                                       par_edu=('par_edu_max','mean'),inc_med=('inc79','median')).reset_index()

# ---------- OUTCOMES (proxy) ----------
res_mat = df[RES].to_numpy()
n_obs_res = np.sum(~np.isnan(res_mat), axis=1)
ever3  = np.any(res_mat == 3, axis=1)
ever23 = np.any((res_mat == 2) | (res_mat == 3), axis=1)
ever5  = np.any(res_mat == 5, axis=1)
Y  = np.where(n_obs_res == 0, np.nan, ever3.astype(float))
Y2 = np.where(n_obs_res == 0, np.nan, ever23.astype(float))
df['Y']=Y; df['Y2']=Y2
df['ever_jail_res']=ever5.astype(float); df['n_res_waves']=n_obs_res

# ---------- PREDICTORS ----------
# EMPIRICAL labels (code1=HISPANIC, code2=BLACK, code3=nonblk/nonhisp) per verification below
df['hisp']=(df['Racial/ethnic cohort, 1979']==1).astype(int)
df['black']=(df['Racial/ethnic cohort, 1979']==2).astype(int)
df['white']=(df['Racial/ethnic cohort, 1979']==3).astype(int)
df['female']=(df['Sex of respondent, 1979']==2).astype(int)
df['age']=df['Age of respondent, 1979']
df['famsize']=df['Family size, 1979']
df['loginc']=np.log1p(df['inc79'])
df['wealth96']=df['Family net wealth, 1996 (key data point)']
df['asvab_z']=(df['asvab_mean']-df['asvab_mean'].mean())/df['asvab_mean'].std()
df['par_edu_z']=(df['par_edu_max']-df['par_edu_max'].mean())/df['par_edu_max'].std()
df['loginc_z']=(df['loginc']-df['loginc'].mean())/df['loginc'].std()
df['saver']=(df['Was more money put into or taken out of R/spouse savings since last interview, 1989']==1).astype(float)
df['saver']=np.where(df['Was more money put into or taken out of R/spouse savings since last interview, 1989'].isna(),np.nan,df['saver'])

KEYS=['hisp','black','par_edu_z','loginc_z']
formA='Y ~ hisp + black + par_edu_z + loginc_z + female + age + famsize'
formB=formA+' + asvab_z'

def fit_AB(data, formA, formB):
    needA=['Y','hisp','black','par_edu_z','loginc_z','female','age','famsize']
    needB=needA+['asvab_z']
    dB=data.dropna(subset=needB).copy()
    dA_on_B=dB.dropna(subset=needA).copy()   # same rows for both
    mA_l=smf.ols(formA,data=dA_on_B).fit(cov_type='HC1')
    mB_l=smf.ols(formB,data=dA_on_B).fit(cov_type='HC1')
    mA_g=smf.logit(formA,data=dA_on_B).fit(disp=0)
    mB_g=smf.logit(formB,data=dA_on_B).fit(disp=0)
    return dict(nB=len(dA_on_B),A_l=mA_l,B_l=mB_l,A_g=mA_g,B_g=mB_g)

def ame_counterfactual(g, data, var, ref_col='white'):
    """Avg marginal effect of binary var via counterfactual predictions."""
    X=data.copy()
    X1=X.copy(); X1[var]=1
    X0=X.copy(); X0[var]=0
    p1=g.predict(X1); p0=g.predict(X0)
    return float(np.mean(p1-p0))

def table(res, outcome_label=''):
    rows=[]
    for k in KEYS:
        aL=res['A_l'].params[k]; bL=res['B_l'].params[k]
        att=(aL-bL)/aL*100 if aL!=0 else np.nan
        aOR=np.exp(res['A_g'].params[k]); bOR=np.exp(res['B_g'].params[k])
        rows.append((k,aL,bL,att,aOR,bOR))
    return rows


D=df.dropna(subset=['Y','hisp','black','par_edu_z','loginc_z','female','age','famsize','asvab_z']).copy()
main=fit_AB(D,formA,formB)

print('=== RACE LABEL VERIFICATION ===')
print(race_check.to_string())
print('Reference NLSY79 official totals: Black~3,317 / Hispanic~2,002 / nonblk_nonhisp~7,367')
print('-> empirical counts + ASVAB order (code2<code1<code3) imply code1=HISPANIC, code2=BLACK; metadata labels (1=BLACK,2=HISPANIC) appear SWAPPED.')
print()
print('=== SAMPLE/MISSING ===')
print('N total:',N0,'| Y valid:',int(df.Y.notna().sum()),'Y=1:',int((df.Y==1).sum()),'Y=0:',int((df.Y==0).sum()),'Y NaN(no res wave):',int(df.Y.isna().sum()))
print('ASVAB all4:',int(df[ASV].notna().all(axis=1).sum()),'par_edu:',int(df.par_edu_max.notna().sum()),'inc79:',int(df.inc79.notna().sum()),'wealth96:',int(df.wealth96.notna().sum()))
print('Same analytic sample N (A and B):',main['nB'])
print('Raw ever-college-res rate by cohort: race1(emp.HISP):%.1f%% race2(emp.BLACK):%.1f%% race3(white):%.1f%%'%(
      (df.Y[df.hisp==1].mean()*100),(df.Y[df.black==1].mean()*100),(df.Y[df.white==1].mean()*100)))
print()
print('=== MAIN MODELS (same sample N=%d) ==='%main['nB'])
print('%-9s %10s %10s %9s %10s %10s %10s %10s'%('var','LPM_A','LPM_B','att%','AME_A','AME_B','OR_A','OR_B'))
for k,aL,bL,att,aOR,bOR in table(main):
    ameA=ame_counterfactual(main['A_g'],D,k)
    ameB=ame_counterfactual(main['B_g'],D,k)
    print('%-9s %+10.4f %+10.4f %+9.1f %+10.4f %+10.4f %10.3f %10.3f'%(k,aL,bL,att,ameA,ameB,aOR,bOR))
print('PseudoR2(logit): A=%.4f B=%.4f | LPM R2: A=%.4f B=%.4f'%(main['A_g'].prsquared,main['B_g'].prsquared,main['A_l'].rsquared,main['B_l'].rsquared))
print()
print('Model B LPM coefficients:')
print(main['B_l'].summary2().tables[1].round(4).to_string())

# ---------- ROBUSTNESS ----------
print('\n=== ROB 1: alt outcome Y2 (res code 2|3) ===')
df['Yold']=df['Y']; df['Y']=df['Y2']
D2=df.dropna(subset=['Y','hisp','black','par_edu_z','loginc_z','female','age','famsize','asvab_z']).copy()
r2=fit_AB(D2,formA,formB)
for k,aL,bL,att,aOR,bOR in table(r2):
    ameA=ame_counterfactual(r2['A_g'],D2,k); ameB=ame_counterfactual(r2['B_g'],D2,k)
    print('%-9s LPM_A=%+.4f LPM_B=%+.4f att=%+.1f%% AME_A=%+.4f AME_B=%+.4f OR_A=%.3f OR_B=%.3f'%(k,aL,bL,att,ameA,ameB,aOR,bOR))
print('N=',r2['nB'])
df['Y']=df['Yold']

print('\n=== ROB 2: imputed larger sample (mean + miss indicator, LPM) ===')
cols_imp=['par_edu_z','loginc_z','famsize','asvab_z']
dimp=df[df.Y.notna()].copy()
for c in cols_imp:
    dimp[c+'_miss']=dimp[c].isna().astype(float); dimp[c]=dimp[c].fillna(dimp[c].mean())
mA_i=smf.ols(formA,data=dimp).fit(cov_type='HC1'); mB_i=smf.ols(formB,data=dimp).fit(cov_type='HC1')
print('N(imputed):',len(dimp))
for k in KEYS:
    a=mA_i.params[k]; b=mB_i.params[k]
    print('%-9s LPM_A=%+.4f LPM_B=%+.4f att=%+.1f%%'%(k,a,b,(a-b)/a*100 if a!=0 else np.nan))

print('\n=== ROB 3: extended controls (Model C: + ever_jail_res + saver + wealth96) ===')
formC='Y ~ hisp + black + par_edu_z + loginc_z + asvab_z + female + age + famsize + ever_jail_res + saver + wealth96'
dC=df[df.Y.notna()].dropna(subset=['par_edu_z','loginc_z','asvab_z','saver','wealth96','famsize'])
mC=smf.ols(formC,data=dC).fit(cov_type='HC1')
print('N(Model C):',len(dC))
print(mC.summary2().tables[1].round(4).to_string())

print('\n=== ROB 4: age-restricted cohort (14-17 in 1979, college window inside 1981-1996) ===')
Dyoung=df[(df.Y.notna()) & (df.age>=14) & (df.age<=17)].dropna(
    subset=['hisp','black','par_edu_z','loginc_z','female','age','famsize','asvab_z']).copy()
ry=fit_AB(Dyoung,formA,formB)
print('N(young 14-17 B-sample):',ry['nB'])
for k,aL,bL,att,aOR,bOR in table(ry):
    ameA=ame_counterfactual(ry['A_g'],Dyoung,k); ameB=ame_counterfactual(ry['B_g'],Dyoung,k)
    print('%-9s LPM_A=%+.4f LPM_B=%+.4f att=%+.1f%% AME_A=%+.4f AME_B=%+.4f OR_A=%.3f OR_B=%.3f'%(k,aL,bL,att,ameA,ameB,aOR,bOR))

print('\n=== ROB 5: cluster SEs by Sample ID (Model B LPM), main sample ===')
try:
    mBc=smf.ols(formB,data=D).fit(cov_type='cluster',cov_kwds={'groups':D['Sample ID, 1979 (interview)']})
    print(mBc.summary2().tables[1].round(4).to_string())
except Exception as e:
    print('cluster failed:',repr(e)[:200])

print('\n=== ROB 6: MICE (statsmodels, 5 imputations, LPM Model B) ===')
try:
    dm=df[['Y','hisp','black','par_edu_z','loginc_z','female','age','famsize','asvab_z']].dropna(subset=['Y']).copy()
    mi=MICE(formB,sm.OLS,dm)
    rm=mi.fit(n_burnin=20,n_imputations=5)
    print(rm.params.round(4).to_string())
except Exception as e:
    print('MICE failed:',repr(e)[:200])

print('\n=== DOC-LABEL version (1=BLACK,2=HISPANIC per metadata) ===')
Dl=D.copy(); Dl['black']=(Dl['Racial/ethnic cohort, 1979']==1).astype(int); Dl['hisp']=(Dl['Racial/ethnic cohort, 1979']==2).astype(int)
rl=fit_AB(Dl,formA,formB)
for k,aL,bL,att,aOR,bOR in table(rl):
    ameA=ame_counterfactual(rl['A_g'],Dl,k); ameB=ame_counterfactual(rl['B_g'],Dl,k)
    print('%-9s LPM_A=%+.4f LPM_B=%+.4f att=%+.1f%% AME_A=%+.4f AME_B=%+.4f OR_A=%.3f OR_B=%.3f'%(k,aL,bL,att,ameA,ameB,aOR,bOR))

json.dump(dict(race_check=race_check.to_dict('records'),n_main=main['nB']),open('outputs_race_check.json','w'),indent=2)
print('\nsaved outputs_race_check.json')
