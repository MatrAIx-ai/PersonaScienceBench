"""
DiscoveryBench / NLSY79 -- How is the advantage in BA degree completion rates for
Black students related to Socioeconomic status (SES) levels?

Operationalizations (approved plan):
  - BA (primary proxy) : Highest grade completed, 1979 in [16,20]
  - any college (sens.) : Highest grade completed, 1979 in [13,20]
  - Analytic sample     : respondents aged >= 21 in 1979 (only they could have
                          completed a BA by 1979) with valid (0-20) grade
  - SES levels (terciles within analytic sample, low/mid/high):
        W = Family net wealth 1996 ('key data point')      [adult SES]
        O = origin-SES composite z(log income79) + z(max parent edu)
        I = family income 1979                              [origin SES]
  - Advantage            : d_k = P(BA|Black,k) - P(BA|NonBlackNonHisp,k)
  - Missing handling     : complete-case primary; missing-as-category +
                           race/age-median single imputation as robustness;
                           complete-case bias documented.
"""
import pandas as pd, numpy as np, itertools, json
from scipy import stats
import statsmodels.formula.api as smf
import statsmodels.api as sm

pd.set_option('display.width', 200)
df = pd.read_csv('data/nls_raw.csv')

race_map = {1:'BLACK', 2:'HISPANIC', 3:'NON-BLACK-NON-HISP'}
df['race'] = df['Racial/ethnic cohort, 1979'].map(race_map)
df['age'] = df['Age of respondent, 1979']
df['grade'] = df['Highest grade completed, 1979']

# Outcomes
df['BA']     = np.where(df['grade'].between(16,20), 1, np.where(df['grade'].between(0,15), 0, np.nan))
df['anycol'] = np.where(df['grade'].between(13,20), 1, np.where(df['grade'].between(0,12), 0, np.nan))

# Origin-SES components
df['loginc79'] = np.log(df['Total net family income, previous calendar year, 1979'].clip(lower=1) + 1)
df['max_pedu'] = df[["Highest grade completed by respondent's mother, 1979",
                     "Highest grade completed by respondent's father, 1979"]].max(axis=1)
for comp in ['loginc79','max_pedu']:
    df[comp+'_z'] = (df[comp] - df[comp].mean()) / df[comp].std()
df['ses_origin'] = df[['loginc79_z','max_pedu_z']].mean(axis=1)

WEALTH = 'Family net wealth, 1996 (key data point)'
INCOME = 'Total net family income, previous calendar year, 1979'

def terciles(s):
    q = s.quantile([1/3, 2/3])
    return pd.cut(s, [-np.inf, q.iloc[0], q.iloc[1], np.inf], labels=[0,1,2])

# --- helper: stats for a 2x2 black vs reference ---
def wilson(p, n, z=1.96):
    if n == 0: return (np.nan, np.nan)
    d = 1 + z*z/n
    c = p + z*z/(2*n); w = z*np.sqrt(p*(1-p)/n + z*z/(4*n*n))
    return ((c-w)/d, (c+w)/d)

def newcombe_diff(p1,n1,p2,n2,z=1.96):
    l1,u1 = wilson(p1,n1); l2,u2 = wilson(p2,n2)
    d = p1-p2
    lo = d - np.sqrt(max((p1-l1)**2 + (u2-p2)**2,0))
    hi = d + np.sqrt(max((u1-p1)**2 + (p2-l2)**2,0))
    return lo,hi

def or_ci(a,b,c,d):
    # BLACK completers a, BLACK non b ; ref completers c, ref non d
    a_,b_,c_,d_ = a+0.5,b+0.5,c+0.5,d+0.5
    lo = np.log((a_/b_)/(c_/d_))
    se = np.sqrt(1/a_+1/b_+1/c_+1/d_)
    return np.exp(lo-1.96*se), np.exp(lo+1.96*se)

def cell_stats(data, outcome, sescol, level, race_black='BLACK', race_ref='NON-BLACK-NON-HISP'):
    """Outcome rates Black vs ref at given SES level. Returns dict."""
    out = {}
    for r_ in [race_black, race_ref]:
        sub = data[(data['race']==r_) & (data['ses_level']==level) & data[outcome].notna()]
        out[r_] = {'n':len(sub), 'k':int(sub[outcome].sum()), 'rate':sub[outcome].mean() if len(sub) else np.nan}
    a = out[race_black]['k']; c = out[race_ref]['k']
    n1 = out[race_black]['n']; n2 = out[race_ref]['n']
    p1 = out[race_black]['rate']; p2 = out[race_ref]['rate']
    d = p1-p2; lo,hi = newcombe_diff(p1,n1,p2,n2)
    orl,orh = or_ci(a, n1-a, c, n2-c)
    if n1>0 and n2>0:
        fisher = stats.fisher_exact([[a,n1-a],[c,n2-c]])[1]
    else:
        fisher = np.nan
    flag = '<5 completers' if (a<5 or c<5) else ''
    return dict(black_n=n1, black_k=a, black_rate=p1,
                ref_n=n2, ref_k=c, ref_rate=p2,
                delta=d, delta_ci=(lo,hi), or_=((a+0.5)/(n1-a+0.5))/((c+0.5)/(n2-c+0.5)),
                or_ci=(orl,orh), fisher_p=fisher, flag=flag)

def print_report(data, outcome, outname, sescols):
    print('\n' + '='*100)
    print(f'OUTCOME = {outname} (analytic sample age>=21, valid grades, n={len(data)})')
    for col,label in sescols:
        print('\n' + '-'*90)
        print(f'SES = {label}  [col={col}]')
        d_cc = data[data[col].notna()].copy()
        d_cc['ses_level'] = terciles(d_cc[col]).astype(int)
        # --- table all three races
        tab = d_cc.groupby(['ses_level','race'])[outcome].agg(n='count', k='sum')
        tab['rate'] = tab['k']/tab['n']
        print('\nRate table (rows=race, cols=SES level low/mid/high; k/n = completers)')
        for lvl in [0,1,2]:
            for r_ in ['BLACK','HISPANIC','NON-BLACK-NON-HISP']:
                if (lvl,r_) in tab.index:
                    row = tab.loc[(lvl,r_)]
                    print(f'  level{lvl} {r_:22s} k={int(row.k):3d}/n={int(row.n):4d}  rate={row.rate:6.4f}')
                else:
                    print(f'  level{lvl} {r_:22s} --')
        # --- Black vs ref advantage
        print('\nBlack vs NBNH advantage (d = P(Black)-P(ref), pp):')
        rows=[]
        for lvl in [0,1,2]:
            try:
                st = cell_stats(d_cc, outcome, col, lvl)
            except Exception as e:
                print(f'  level{lvl}: cell error {e}')
                continue
            rows.append(st)
            print(f'  level{lvl}: d={100*st["delta"]:+6.2f}pp [{100*st["delta_ci"][0]:+6.2f}, {100*st["delta_ci"][1]:+6.2f}] | '
                  f'OR={st["or_"]:.2f} [{st["or_ci"][0]:.2f}, {st["or_ci"][1]:.2f}] | '
                  f'Black {st["black_k"]}/{st["black_n"]} vs ref {st["ref_k"]}/{st["ref_n"]} | '
                  f'Fisher p={st["fisher_p"]:.3f} {st["flag"]}'.rstrip())
        # --- logistic interaction (complete-case within this SES variable)
        m_data = d_cc.dropna(subset=[outcome,'ses_level']).copy()
        m_data['race2'] = m_data['race'].map({'BLACK':'Black','HISPANIC':'Hispanic','NON-BLACK-NON-HISP':'White'})
        m_data['lvl'] = m_data['ses_level'].astype(int)
        m_int = smf.logit(f'{outcome} ~ C(race2)*C(lvl)', data=m_data).fit(disp=0)
        m_add = smf.logit(f'{outcome} ~ C(race2)+C(lvl)', data=m_data).fit(disp=0)
        lr = -2*(m_add.llf - m_int.llf); p_inter = 1 - stats.chi2.cdf(lr, (m_int.df_model - m_add.df_model))
        # trend interaction: treat lvl as ordinal
        m_add2 = smf.logit(f'{outcome} ~ C(race2)+lvl', data=m_data).fit(disp=0)
        m_trend= smf.logit(f'{outcome} ~ C(race2)*lvl', data=m_data).fit(disp=0)
        lr2 = -2*(m_add2.llf - m_trend.llf); p_trend = 1 - stats.chi2.cdf(lr2, 2)
        print(f'  INTERACTION test (categorical race x SES): LR chi2={lr:.2f}, p={p_inter:.3f}   [n_model={len(m_data)}]')
        print(f'  INTERACTION test (ordinal trend, race x lvl): LR chi2={lr2:.2f}, p={p_trend:.3f}')

def missing_bias_report():
    print('\n' + '='*100)
    print('DOCUMENTATION OF COMPLETE-CASE BIAS (domain note: missing data in longitudinal surveys)')
    base = df[(df['age']>=21) & df['grade'].between(0,20)].copy()
    print(f'\nAnalytic base (age>=21, valid grade): n={len(base)}  racial comp:')
    print(base['race'].value_counts().to_dict())
    for col,label in [(WEALTH,'wealth 1996'),(INCOME,'income 1979'),('ses_origin','origin composite')]:
        cc = base[base[col].notna()]
        print(f'\n{label:20s} missing={100*base[col].isna().mean():.1f}%   complete-case n={len(cc)}')
        print('  racial comp full :', {r:round(100*(base.race==r).mean(),1) for r in ['BLACK','NON-BLACK-NON-HISP']})
        print('  racial comp CC   :', {r:round(100*(cc.race==r).mean(),1) for r in ['BLACK','NON-BLACK-NON-HISP']})
        print('  BA rate full (BA non-missing): ', round(base.BA.mean(),4), ' in CC:', round(cc.BA.mean(),4))
        print('  anycol rate full:', round(base.anycol.mean(),4), ' in CC:', round(cc.anycol.mean(),4))

# ---------- build analytic sample ----------
anal = df[(df['age']>=21) & df['grade'].between(0,20)].copy()
print(f'=== ANALYTIC SAMPLE: age>=21 in 1979, valid grades 0-20 ===')
print('n =', len(anal), ' by race:', anal['race'].value_counts().to_dict())
print('BA completers:', int(anal['BA'].sum()), ' anycol:', int(anal['anycol'].sum()))

sescols = [(WEALTH,'Adult wealth 1996 (key data point)'),
           ('ses_origin','Origin-SES composite (log income79 + max parent edu)'),
           (INCOME,'Origin income 1979'),
           ('Total net family income, previous calendar year, 1985','Income 1985')]

print_report(anal, 'BA', 'BA (>=16 grades)', sescols)
print_report(anal, 'anycol', 'ANY COLLEGE (>=13 grades)', sescols)

# age>=20 robustness for primary
print('\n' + '='*100)
print('ROBUSTNESS: age>=20 sample for BA outcome, wealth 1996')
anal20 = df[(df['age']>=20) & df['grade'].between(0,20)].copy()
d20 = anal20[anal20[WEALTH].notna()].copy(); d20['ses_level'] = terciles(d20[WEALTH]).astype(int)
rows=[]
for lvl in [0,1,2]:
    st = cell_stats(d20,'BA',WEALTH,lvl); rows.append(st)
    print(f'  level{lvl}: d={100*st["delta"]:+6.2f}pp | OR={st["or_"]:.2f} | Black {st["black_k"]}/{st["black_n"]} vs Ref {st["ref_k"]}/{st["ref_n"]} | Fisher p={st["fisher_p"]:.3f} {st["flag"]}')

print('\n' + '='*100)
print('ROBUSTNESS: full sample (all ages) with age control, BA outcome, wealth 1996')
full = df[df['grade'].between(0,20)].copy()
dfull = full[full[WEALTH].notna()].copy(); dfull['ses_level'] = terciles(dfull[WEALTH]).astype(int)
dfull['race2']=dfull['race'].map({'BLACK':'Black','HISPANIC':'Hispanic','NON-BLACK-NON-HISP':'White'})
dfull['lvl']=dfull['ses_level'].astype(int)
m=smf.logit('BA ~ C(race2)*C(lvl)+age', data=dfull).fit(disp=0)
print('logit BA ~ race*SES + age (full sample): LR model p=', m.llf)
ma=smf.logit('BA ~ C(race2)+C(lvl)+age', data=dfull).fit(disp=0)
lr=-2*(ma.llf-m.llf); p=1-stats.chi2.cdf(lr, (m.df_model-ma.df_model))
print('interaction p (full sample, age-controlled):', round(p,4))

# ---------- missing-as-category robustness ----------
print('\n' + '='*100)
print('ROBUSTNESS: missing-SES-as-category model (BA, age>=21 sample, wealth 1996)')
mcat = anal.copy(); mcat['lvl'] = 3; m_ = ~mcat[WEALTH].isna(); mcat.loc[m_,'lvl'] = terciles(mcat.loc[m_,WEALTH]).astype(int); mcat['lvl'] = mcat['lvl'].astype(int)
mcat['race2']=mcat['race'].map({'BLACK':'Black','HISPANIC':'Hispanic','NON-BLACK-NON-HISP':'White'})
m_a=smf.logit('BA ~ C(race2)+C(lvl)', data=mcat).fit(disp=0)
m_b=smf.logit('BA ~ C(race2)*C(lvl)', data=mcat).fit(disp=0)
lr=-2*(m_a.llf-m_b.llf); p=1-stats.chi2.cdf(lr, m_b.df_model-m_a.df_model)
print('interaction p (missing-as-category):', round(p,4), ' n_model=', len(mcat))

# race/age-median single imputation of wealth
print('\n' + '='*100)
print('ROBUSTNESS: race/age-median single imputation of wealth 1996 (age>=21)')
imp = anal.copy()
med = imp.groupby(['race','age'])[WEALTH].transform('median')
imp['w_imp'] = imp[WEALTH].fillna(med)
imp_s = imp[imp['w_imp'].notna()].copy(); imp_s['ses_level']=terciles(imp_s['w_imp']).astype(int); imp_s['lvl']=imp_s['ses_level'].astype(int)
imp_s['race2']=imp_s['race'].map({'BLACK':'Black','HISPANIC':'Hispanic','NON-BLACK-NON-HISP':'White'})
m_a=smf.logit('BA ~ C(race2)+C(lvl)', data=imp_s).fit(disp=0)
m_b=smf.logit('BA ~ C(race2)*C(lvl)', data=imp_s).fit(disp=0)
lr=-2*(m_a.llf-m_b.llf); p=1-stats.chi2.cdf(lr, m_b.df_model-m_a.df_model)
rows=[]
for lvl in [0,1,2]:
    st=cell_stats(imp_s,'BA','w_imp',lvl); rows.append(st)
    print(f'  level{lvl}: d={100*st["delta"]:+6.2f}pp | Black {st["black_k"]}/{st["black_n"]} vs Ref {st["ref_k"]}/{st["ref_n"]} | Fisher p={st["fisher_p"]:.3f} {st["flag"]}')
print('interaction p (imputed):', round(p,4))

missing_bias_report()
