#!/usr/bin/env python3
"""
NLSY79 wealth-by-race analysis (DiscoveryBench).
Question: How does the median wealth of white individuals compare to that of
black and Hispanic individuals from 1985 onwards?

Design (approved):
- Groups from 'Racial/ethnic cohort, 1979': 1=BLACK, 2=HISPANIC,
  3=NON-BLACK NON-HISPANIC (white proxy). Group 3 is the standard NLSY79
  proxy for 'white' since no explicit white label exists.
- 'From 1985 onwards' = the available net-wealth waves: 1985, 1990, 1996.
- Unit = respondent (one row per person); family net wealth assigned to each
  respondent. Per-year complete cases. Unweighted (no survey-weight column).
- Negative/zero wealth retained. Median used (robust to skew/top-coding).
"""
import numpy as np
import pandas as pd
from scipy import stats

pd.set_option('display.width', 220)
pd.set_option('display.max_columns', 50)

rng = np.random.default_rng(42)

# ----------------------------------------------------------------------
# Load
# ----------------------------------------------------------------------
df = pd.read_csv('data/nls_raw.csv')
race_col = 'Racial/ethnic cohort, 1979'
wealth_cols = {
    1985: 'Family net wealth, 1985',
    1990: 'Family net wealth, 1990',
    1996: 'Family net wealth, 1996 (key data point)',
}
label = {1: 'BLACK', 2: 'HISPANIC', 3: 'WHITE-PROXY(NON-BLACK/NON-HISP)'}
df['_group'] = df[race_col].map(label)

results = {}
for year, col in wealth_cols.items():
    d = df[['_group', col]].dropna()
    rows = []
    for g, sub in d.groupby('_group'):
        s = sub[col].values
        med = np.median(s)
        # bootstrap CI for median
        boot = [np.median(rng.choice(s, size=len(s), replace=True)) for _ in range(2000)]
        lo, hi = np.percentile(boot, [2.5, 97.5])
        rows.append({'year': year, 'group': g, 'n': len(s),
                     'median': med, 'ci_lo': lo, 'ci_hi': hi,
                     'mean': s.mean(), 'p25': np.percentile(s, 25),
                     'p75': np.percentile(s, 75),
                     'neg%': (s < 0).mean() * 100,
                     'zero%': (s == 0).mean() * 100,
                     'pos%': (s > 0).mean() * 100})
    results[year] = pd.DataFrame(rows)

med_frame = pd.DataFrame({y: r.set_index('group')['median'] for y, r in results.items()})
print('=== MEDIAN NET FAMILY WEALTH BY GROUP & YEAR ===')
print(med_frame.round(0).to_string())
print()

print('=== FULL PER-YEAR PER-GROUP TABLE ===')
for y in wealth_cols:
    print(results[y].round(2).to_string(index=False))
    print()

# ----------------------------------------------------------------------
# White-vs-Black and White-vs-Hispanic gaps (absolute + ratio) per year
# ----------------------------------------------------------------------
white = 'WHITE-PROXY(NON-BLACK/NON-HISP)'
print('=== GAPS: WHITE-PROXY vs BLACK / HISPANIC ===')
gap_rows = []
for year in wealth_cols:
    w = results[year].set_index('group').loc[white, 'median']
    b = results[year].set_index('group').loc['BLACK', 'median']
    h = results[year].set_index('group').loc['HISPANIC', 'median']
    gap_rows.append({
        'year': year,
        'white_med': round(w, 0),
        'black_med': round(b, 0),
        'hispanic_med': round(h, 0),
        'WminusB': round(w - b, 0),
        'WdivB': round(w / b, 3),
        'Bmed_share_of_W_pct': round(b / w * 100, 1),
        'WminusH': round(w - h, 0),
        'WdivH': round(w / h, 3),
        'Hmed_share_of_W_pct': round(h / w * 100, 1),
    })
gaps = pd.DataFrame(gap_rows)
print(gaps.to_string(index=False))
print()

# ----------------------------------------------------------------------
# Trajectory across waves (median growth within group)
# ----------------------------------------------------------------------
print('=== TRAJECTORY 1985 -> 1990 -> 1996 (median, within group) ===')
for g in [white, 'BLACK', 'HISPANIC']:
    meds = [med_frame.loc[g, y] for y in wealth_cols]
    mult_85_96 = meds[2] / meds[0]
    mult_85_90 = meds[1] / meds[0]
    mult_90_96 = meds[2] / meds[1]
    print(f'{g}: 85={meds[0]:,.0f} 90={meds[1]:,.0f} 96={meds[2]:,.0f}  | '
          f'90/85={mult_85_90:.2f}x  96/90={mult_90_96:.2f}x  96/85={mult_85_96:.2f}x')
print()

# ----------------------------------------------------------------------
# Rank-based separation tests (supporting, per year)
# ----------------------------------------------------------------------
print('=== MANN-WHITNEY U (White-proxy vs Black / Hispanic), per year ===')
for year, col in wealth_cols.items():
    d = df[['_group', col]].dropna()
    w = d.loc[d['_group'] == white, col]
    b = d.loc[d['_group'] == 'BLACK', col]
    h = d.loc[d['_group'] == 'HISPANIC', col]
    for nm, other in [('Black', b), ('Hispanic', h)]:
        u = stats.mannwhitneyu(w, other, alternative='two-sided')
        print(f'{year} White vs {nm}: U={u.statistic:.1f} p={u.pvalue:.3e}  '
              f'(median W={np.median(w):,.0f} vs {np.median(other):,.0f})')
print()

# ----------------------------------------------------------------------
# Summary numbers used for the hypothesis (auditable)
# ----------------------------------------------------------------------
print('=== SUMMARY (values used in the hypothesis) ===')
for year in wealth_cols:
    r = results[year].set_index('group')
    w = r.loc[white, 'median']; b = r.loc['BLACK', 'median']; h = r.loc['HISPANIC', 'median']
    print(f'{year}: White(proxy) ${w:,.0f}  Black ${b:,.0f}  Hispanic ${h:,.0f}  | '
          f'W/B={w/b:.2f}x  W/H={w/h:.2f}x')
