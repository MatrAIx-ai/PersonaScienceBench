#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
DiscoveryBench - nls_ses (metadata_10.json / 0 / 2)
Question: "The effect of which variable on BA degree completion decreases from
0.3636 to -0.2293 (while becoming insignificant) when both race and academic
characteristics are included in analysis?"

Pipeline:
  A) Data description
  B) Nested-model chain (M0 simple -> M1 +race -> M2 +race+academics) for every
     social-background candidate, in LPM / logit / probit, raw & standardized,
     reporting b, SE, p, 95% CI and the per-step change (race-confounding vs
     academic-mediation).
  C) Rigorous test of the coefficient change M0->M2 (bootstrap CI + Wald)
  D) Honest search for the specification nearest to (0.3636, -0.2293)
  E) Final natural-language hypothesis
"""
import numpy as np
import pandas as pd
import statsmodels.api as sm
import itertools, warnings
warnings.filterwarnings("ignore")

rng = np.random.default_rng(20261022)
DATA = "../data/nls_ses_processed.csv"
A   = "ABILITY: COMPOSITE OF ASVAB SCORE"
P   = "PERCENTILE IN CLASS"
SES = "SES"

# ----------------------------------------------------------------------------
# 0. data prep
# ----------------------------------------------------------------------------
df = pd.read_csv(DATA)
df = df.rename(columns={"ABILITY: COMPOSITE OF ASVAB SCORE": "ABILITY",
                        "PERCENTILE IN CLASS": "PERCENTILE"})
df["BA"]  = df["BA DEGREE COMPLETED"].astype(int)
df["Female"] = (df["SAMPLE_SEX"] == "Female").astype(int)
df["Male"]   = (df["SAMPLE_SEX"] == "Male").astype(int)
df["Black"]  = (df["SAMPLE_RACE"] == "Black").astype(int)
df["Hispanic"] = (df["SAMPLE_RACE"] == "Hispanic").astype(int)
df["WHITE"]   = (df["SAMPLE_RACE"] == "White").astype(int)

def z(x): return (x - x.mean()) / x.std(ddof=0)
for c in ["SES", "ABILITY", "PERCENTILE", "FAMILY SIZE OF SAMPLE"]:
    df[c + "_z"] = z(df[c])

print("=" * 88)
print("A) DATA DESCRIPTION")
print("=" * 88)
print("shape:", df.shape, "| missing:", int(df.isna().sum().sum()))
desc = df[["CASE ID", "SAMPLE_RACE", "SAMPLE_SEX", "FAMILY SIZE OF SAMPLE",
           "ABILITY", "BA", "PERCENTILE", "SES"]].describe(percentiles=[.25, .5, .75]).T
desc.to_csv("outputs/table_A_descriptives.csv")
print(desc.round(3).to_string())
print("\nBA completion rate: %.4f  (True=%d / %d)" % (df.BA.mean(), int(df.BA.sum()), len(df)))
print("RACE:", dict(df.SAMPLE_RACE.value_counts()))
print("mean SES by race:", df.groupby("SAMPLE_RACE").SES.mean().round(3).to_dict())
print("mean ABILITY by race:", df.groupby("SAMPLE_RACE").ABILITY.mean().round(1).to_dict())
print("mean %ile by race:", df.groupby("SAMPLE_RACE").PERCENTILE.mean().round(2).to_dict())
print("corr SES-ABILITY=%.3f  SES-PERCENTILE=%.3f  ABILITY-PERCENTILE=%.3f"
      % (df.SES.corr(df.ABILITY), df.SES.corr(df.PERCENTILE), df.ABILITY.corr(df.PERCENTILE)))

# ----------------------------------------------------------------------------
# helpers
# ----------------------------------------------------------------------------
def fit(link, y, X):
    if link == "LPM":   return sm.OLS(y, X).fit(cov_type="HC1")
    if link == "LOGIT": return sm.Logit(y, X).fit(disp=False, maxiter=400)
    if link == "PROBIT":return sm.Probit(y, X).fit(disp=False, maxiter=400)

def stats_row(m, v):
    b   = float(m.params[v]); se = float(m.bse[v]); p = float(m.pvalues[v])
    lo, hi = float(m.conf_int().loc[v, 0]), float(m.conf_int().loc[v, 1])
    return b, se, p, lo, hi

def uniq(xs): return list(dict.fromkeys(xs))

RACE = ["Black", "Hispanic"]
ACAD = ["ABILITY", "PERCENTILE"]

def run_chain(var, zvar=None):
    """nested chain M0(simple)->M1(+race)->M2(+race+acad) for a variable."""
    use = zvar if zvar is not None else var
    out = {}
    for link in ["LPM", "LOGIT", "PROBIT"]:
        M0 = fit(link, df.BA, sm.add_constant(df[[use]]))
        M1 = fit(link, df.BA, sm.add_constant(df[uniq(RACE + [use])]))
        M2 = fit(link, df.BA, sm.add_constant(df[uniq(RACE + ACAD + [use])]))
        row = {}
        for nm, m in [("M0", M0), ("M1", M1), ("M2", M2)]:
            b, se, p, lo, hi = stats_row(m, use)
            row[nm] = dict(b=b, se=se, p=p, lo=lo, hi=hi, OR=np.exp(b) if link == "LOGIT" else None)
        # per-step change in b
        row["dM0M1"] = row["M1"]["b"] - row["M0"]["b"]      # role of race
        row["dM1M2"] = row["M2"]["b"] - row["M1"]["b"]      # role of academics
        row["dM0M2"] = row["M2"]["b"] - row["M0"]["b"]
        out[link] = row
    return out

def fmt(row, link):
    if link == "LOGIT":
        return "b=%+.4f (SE %.4f, p=%.4f), OR=%.3f, IC95[%.4f, %.4f]" % (
            row["b"], row["se"], row["p"], row["OR"], row["lo"], row["hi"])
    return "b=%+.4f (SE %.4f, p=%.4f), IC95[%.4f, %.4f]" % (
        row["b"], row["se"], row["p"], row["lo"], row["hi"])

# ----------------------------------------------------------------------------
# B) nested chains for every candidate
# ----------------------------------------------------------------------------
print("\n" + "=" * 88)
print("B) NESTED-MODEL CHAIN  (M0: var alone -> M1: +Black+Hispanic -> M2: +ABILITY+PERCENTILE)")
print("=" * 88)
candidates = [("SES", "SES_z"), ("Female", None), ("Male", None),
              ("FAMILY SIZE OF SAMPLE", "FAMILY SIZE OF SAMPLE_z"),
              # reference: race dummies (cannot be the interest var; shown for comparison)
              ("Black", None), ("Hispanic", None)]
chain_rows = []
for var, zv in candidates:
    lab = var + (" [z]" if zv else "")
    print("\n### %s" % lab)
    res = run_chain(var, zv)
    for link in ["LPM", "LOGIT", "PROBIT"]:
        r = res[link]
        print("  %-6s M0: %s" % (link, fmt(r["M0"], link)))
        print("  %-6s M1: %s" % (link, fmt(r["M1"], link)))
        print("  %-6s M2: %s" % (link, fmt(r["M2"], link)))
        print("       d(M1-M0)=%+.4f (raza) | d(M2-M1)=%+.4f (académicas) | d(M2-M0)=%+.4f"
              % (r["dM0M1"], r["dM1M2"], r["dM0M2"]))
        chain_rows.append(dict(var=lab, link=link,
                               b0=r["M0"]["b"], p0=r["M0"]["p"], se0=r["M0"]["se"],
                               b1=r["M1"]["b"], p1=r["M1"]["p"], se1=r["M1"]["se"],
                               b2=r["M2"]["b"], p2=r["M2"]["p"], se2=r["M2"]["se"],
                               d_race=r["dM0M1"], d_acad=r["dM1M2"], d_total=r["dM0M2"]))
pd.DataFrame(chain_rows).to_csv("outputs/table_B_nested_chains.csv", index=False)

# ----------------------------------------------------------------------------
# C) bootstrap + Wald of the coefficient change M0 -> M2  (SES, headline)
# ----------------------------------------------------------------------------
print("\n" + "=" * 88)
print("C) RIGOROUS TEST OF COEFFICIENT CHANGE  SES:  M0(simple) -> M2(+race+acad)")
print("=" * 88)
B = 2000
n = len(df)
boot = {ln: {"d": [], "b2": []} for ln in ["LPM", "LOGIT"]}
idx_all = np.arange(n)
for _ in range(B):
    idx = rng.integers(0, n, n)
    d = df.iloc[idx]
    for ln in ["LPM", "LOGIT"]:
        m0 = fit(ln, d.BA, sm.add_constant(d[["SES"]]))
        m2 = fit(ln, d.BA, sm.add_constant(d[uniq(RACE + ACAD + ["SES"])]))
        b0 = float(m0.params["SES"]); b2 = float(m2.params["SES"])
        boot[ln]["d"].append(b0 - b2)
        boot[ln]["b2"].append(b2)
for ln in ["LPM", "LOGIT"]:
    dA = np.array(boot[ln]["d"]); b2 = np.array(boot[ln]["b2"])
    lo, hi = np.percentile(dA, [2.5, 97.5])
    p_gt = 2 * min((dA > 0).mean(), (dA <= 0).mean())      # two-sided H0: d=0
    print("  %-6s mean(d)=%+.5f  bootSE=%.5f  IC95[%.5f, %.5f]  p(bootstrap)~%.4f  P(M2 b<0)=%.3f"
          % (ln, dA.mean(), dA.std(), lo, hi, p_gt, (b2 < 0).mean()))
    # Clogg-style Wald z = (b0-b2)/sqrt(se0^2 - se2^2)  [nested-model asymptotic form]
    # (recompute on full sample for the SEs)
    m0 = fit(ln, df.BA, sm.add_constant(df[["SES"]]))
    m2 = fit(ln, df.BA, sm.add_constant(df[uniq(RACE + ACAD + ["SES"])]))
    b0, se0 = float(m0.params["SES"]), float(m0.bse["SES"])
    b2, se2 = float(m2.params["SES"]), float(m2.bse["SES"])
    var_d = abs(se0**2 - se2**2)
    z = (b0 - b2) / np.sqrt(var_d)
    from scipy import stats as st
    print("  %-6s Clogg-Wald: z=%.3f  p=%.4f   (se0=%.4f, se2=%.4f)" % (ln, z, 2*(1-st.norm.cdf(abs(z))), se0, se2))
    np.save("outputs/boot_delta_%s.npy" % ln, dA)

# ----------------------------------------------------------------------------
# D) specification search nearest to (0.3636, -0.2293)
# ----------------------------------------------------------------------------
print("\n" + "=" * 88)
print("D) SPECIFICATION SEARCH  (which spec gets SES closest to simple=0.3636, full=-0.2293)")
print("=" * 88)
T1, T2 = 0.3636, -0.2293
ses_codings = {"SES": "SES", "SES_z": "SES_z"}
race_codings = {"Black+Hispanic": ["Black", "Hispanic"],
                "Black_only": ["Black"],
                "Hispanic_only": ["Hispanic"]}
acad_codings = {
    "ABILITY+PERCENTILE": ["ABILITY", "PERCENTILE"],
    "ABILITY": ["ABILITY"],
    "PERCENTILE": ["PERCENTILE"],
    "ABILITYz+PERCENTILEz": ["ABILITY_z", "PERCENTILE_z"],
}
links = ["LOGIT", "PROBIT", "LPM"]
hits = []
for sv, sname in ses_codings.items():
    for rc, rname in race_codings.items():
        for ac, aname in acad_codings.items():
            for link in links:
                m0 = fit(link, df.BA, sm.add_constant(df[[sv]]))
                cols = uniq(rname + aname + [sv])
                m2 = fit(link, df.BA, sm.add_constant(df[cols]))
                b0, b2 = float(m0.params[sv]), float(m2.params[sv])
                p2 = float(m2.pvalues[sv])
                dist = abs(b0 - T1) + abs(b2 - T2)
                hits.append((dist, sname, "+".join(rname), "+".join(aname), link,
                             b0, b2, p2))
res_d = pd.DataFrame(sorted(hits), columns=["dist", "SES_coding", "race", "acad", "link",
                                            "b_simple", "b_full", "p_full"])
res_d.to_csv("outputs/table_D_spec_search.csv", index=False)
print(res_d.head(12).round(4).to_string(index=False))
print("... closest spec: b_simple=%.4f, b_full=%.4f (targets %.4f, %.4f)"
      % (res_d.iloc[0].b_simple, res_d.iloc[0].b_full, T1, T2))

print("\nDONE.")
