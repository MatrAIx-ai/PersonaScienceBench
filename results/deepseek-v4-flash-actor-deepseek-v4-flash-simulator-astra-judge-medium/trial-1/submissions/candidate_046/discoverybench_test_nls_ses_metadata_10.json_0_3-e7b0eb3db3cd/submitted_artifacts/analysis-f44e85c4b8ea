import pandas as pd, numpy as np, warnings
import statsmodels.api as sm
warnings.filterwarnings("ignore")

df = pd.read_csv('data/nls_ses_processed.csv', index_col=0)
y = df['BA DEGREE COMPLETED'].astype(int)
RACE = df['SAMPLE_RACE'].astype(str).str.strip().str.lower()
SEX  = df['SAMPLE_SEX'].astype(str).str.strip().str.lower()
FS   = df['FAMILY SIZE OF SAMPLE'].astype(float)
ABIL = df['ABILITY: COMPOSITE OF ASVAB SCORE'].astype(float)
PCT  = df['PERCENTILE IN CLASS'].astype(float)
SES  = df['SES'].astype(float)
black=(RACE=='black').astype(float); hisp=(RACE=='hispanic').astype(float); white=(RACE=='white').astype(float)
female=(SEX=='female').astype(float)
print(f"N={len(df)}, BA completions={y.sum()} ({100*y.mean():.2f}%); by race: White={y[RACE=='white'].mean():.4f}, "
      f"Black={y[RACE=='black'].mean():.4f}, Hispanic={y[RACE=='hispanic'].mean():.4f}")
print("="*100)

def fit(X):
    return sm.Logit(y, X.astype(float).assign(const=1.0)).fit(disp=0)

controls  = pd.DataFrame({'SES':SES.values,'Ability':ABIL.values,'Percentile':PCT.values})
controls_fs = controls.assign(FamilySize=FS.values)
controls_z = pd.DataFrame({'SES_z':(SES-SES.mean())/SES.std(),
                           'Ability_z':(ABIL-ABIL.mean())/ABIL.std(),
                           'Percentile_z':(PCT-PCT.mean())/PCT.std()})

def line(label, Xb, Xf, c):
    mb, mf = fit(Xb), fit(Xf)
    b0,se0,p0 = float(mb.params[c]),float(mb.bse[c]),float(mb.pvalues[c])
    b1,se1,p1 = float(mf.params[c]),float(mf.bse[c]),float(mf.pvalues[c])
    s0 = 'SIG' if p0<0.05 else 'n.s.'
    s1 = 'SIG' if p1<0.05 else 'n.s.'
    print(f"{label:<28}{b0:>9.4f}{se0:>8.4f}{p0:>8.4f}{s0:>6}{b1:>9.4f}{se1:>8.4f}{p1:>8.4f}{s1:>6}")

print("\n### EVERY CANDIDATE: BASE (candidate alone) vs FULL (+SES,+Ability,+Percentile) ###")
print(f"{'CANDIDATE':<28}{'B_base':>9}{'SE':>8}{'P':>8}{'':>6}{'B_full':>9}{'SE':>8}{'P':>8}{'':>6}")
Xb3 = pd.DataFrame({'Black':black.values,'Hispanic':hisp.values})
line("RACE Black (vs White)", Xb3, pd.concat([Xb3,controls],axis=1), 'Black')
line("RACE Hispanic (vs White)", Xb3, pd.concat([Xb3,controls],axis=1), 'Hispanic')
line("RACE White (vs Black)", pd.DataFrame({'Hispanic':hisp.values,'White':white.values}),
     pd.concat([pd.DataFrame({'Hispanic':hisp.values,'White':white.values}),controls],axis=1), 'White')
line("RACE Black vs other", pd.DataFrame({'B':black.values}), pd.concat([pd.DataFrame({'B':black.values}),controls],axis=1), 'B')
line("RACE Minority vs White", pd.DataFrame({'M':(RACE!='white').astype(float).values}),
     pd.concat([pd.DataFrame({'M':(RACE!='white').astype(float).values}),controls],axis=1), 'M')
line("SEX Female (vs Male)", pd.DataFrame({'F':female.values}), pd.concat([pd.DataFrame({'F':female.values}),controls],axis=1), 'F')
line("FAMILY SIZE (1 unit)", pd.DataFrame({'FS':FS.values}), pd.concat([pd.DataFrame({'FS':FS.values}),controls],axis=1), 'FS')
line("FAMILY SIZE (reversed)", pd.DataFrame({'FSr':(1+(FS.max()-FS)).values}),
     pd.concat([pd.DataFrame({'FSr':(1+(FS.max()-FS)).values}),controls],axis=1), 'FSr')
line("SES", pd.DataFrame({'SES':SES.values}), pd.concat([pd.DataFrame({'SES':SES.values}),controls.drop(columns=['SES'])],axis=1), 'SES')
line("ABILITY", pd.DataFrame({'AB':ABIL.values}), pd.concat([pd.DataFrame({'AB':ABIL.values}),controls.drop(columns=['Ability'])],axis=1), 'AB')
line("PERCENTILE", pd.DataFrame({'PC':PCT.values}), pd.concat([pd.DataFrame({'PC':PCT.values}),controls.drop(columns=['Percentile'])],axis=1), 'PC')

print("\n### SCALING CHECK (Z-scored controls) - candidate coefficient invariant to control scaling ###")
line("RACE Black (vs White)", Xb3, pd.concat([Xb3,controls_z],axis=1), 'Black')

print("\n### FAMILY-SIZE-AS-CONTROL VARIANT (full=+SES,+Ability,+Percentile,+FamilySize) ###")
line("RACE Black (vs White)", Xb3, pd.concat([Xb3,controls_fs],axis=1), 'Black')

print("\n### REFERENCE-CODING CHECK ###")
mb=fit(Xb3); mf=fit(pd.concat([Xb3,controls],axis=1))
print(f"  ref=White, Black focal: base={mb.params['Black']:.4f} (p={mb.pvalues['Black']:.4f}) | full={mf.params['Black']:.4f} (p={mf.pvalues['Black']:.4f})")
Xwr=pd.DataFrame({'Hispanic':hisp.values,'White':white.values})
mw=fit(Xwr); mwf=fit(pd.concat([Xwr,controls],axis=1))
print(f"  ref=Black, White focal: base={mw.params['White']:.4f} (p={mw.pvalues['White']:.4f}) | full={mwf.params['White']:.4f} (p={mwf.pvalues['White']:.4f})")

print("\n### EVENTS / EFFECTIVE N / ODDS + SIGNIFICANCE CROSSING (Black vs White) ###")
print(f"  Models N={int(controls.shape[0])}, BA events={y.sum()}, zeros={len(y)-y.sum()}")
print(f"  Black events={int(y[RACE=='black'].sum())}/{int((RACE=='black').sum())}; "
      f"White events={int(y[RACE=='white'].sum())}/{int((RACE=='white').sum())}; "
      f"Hispanic events={int(y[RACE=='hispanic'].sum())}/{int((RACE=='hispanic').sum())}")
print(f"  BASE:  Black b={mb.params['Black']:.4f} (SE {mb.bse['Black']:.4f}, OR {np.exp(mb.params['Black']):.3f}, p={mb.pvalues['Black']:.4f}) -> significant")
print(f"  FULL:  Black b={mf.params['Black']:.4f} (SE {mf.bse['Black']:.4f}, OR {np.exp(mf.params['Black']):.3f}, p={mf.pvalues['Black']:.4f}) -> insignificant")
print(f"  P crosses 0.05: YES (base p~0.0000 < 0.05 -> full p={mf.pvalues['Black']:.4f} > 0.05)")
