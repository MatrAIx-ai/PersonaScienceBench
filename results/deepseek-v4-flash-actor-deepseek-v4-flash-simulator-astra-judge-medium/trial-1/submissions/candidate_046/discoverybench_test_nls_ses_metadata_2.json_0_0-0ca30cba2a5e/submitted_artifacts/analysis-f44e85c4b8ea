"""
Analisis definitivo: moderacion de la relacion SES -> BA por linea racial.
Dataset: nls_ses_processed.csv (NLS; cohorte probable NLSY79, inferido del etiquetado)
Pregunta: ?La relacion entre SES y la probabilidad de completar el grado (BA)
cambia segun la linea racial (Hispanic, Black, White)?

Estrategia (aprobada):
  1. Titular: modelo logit CRUDO  BA ~ SES*RACE  (White = referencia)
  2. Robustez/mediacion: modelo AJUSTADO (+ sexo, tamano familiar, ASVAB, percentil)
  3. Probabilidades predichas de BA a SES = -1 SD vs +1 SD por raza, en ambos modelos
  4. Sensibilidad: logit penalizado (Firth) dado 2.7% de eventos
"""
import numpy as np
import pandas as pd
from scipy import stats
import statsmodels.formula.api as smf
from statsmodels.formula.api import logit as smf_logit

# ---------------------------------------------------------------- carga
df = pd.read_csv('data/nls_ses_processed.csv').rename(columns={
    'CASE ID':'CASEID',
    'ABILITY: COMPOSITE OF ASVAB SCORE':'ASVAB',
    'BA DEGREE COMPLETED':'BA',
    'PERCENTILE IN CLASS':'PCTILE',
    'FAMILY SIZE OF SAMPLE':'FAMSIZE'})
df['BA'] = df['BA'].astype(int)
df['SESc'] = (df['SES'] - df['SES'].mean()) / df['SES'].std()
# White como categoria de referencia, como se acordo
df['RACE'] = pd.Categorical(df['SAMPLE_RACE'], categories=['White','Hispanic','Black'], ordered=False)
# estandarizar controles continuos para interpretacion
df['ASVABz'] = (df['ASVAB'] - df['ASVAB'].mean())/df['ASVAB'].std()
df['PCTz'] = (df['PCTILE'] - df['PCTILE'].mean())/df['PCTILE'].std()
df['FAMz'] = (df['FAMSIZE'] - df['FAMSIZE'].mean())/df['FAMSIZE'].std()

n = len(df); n_events = int(df['BA'].sum())
print('='*80)
print('Datos: N=%d, eventos BA=%d (%.2f%%)' % (n, n_events, 100*n_events/n))
print('Raza: %s' % dict(df['RACE'].value_counts()))
print('Tasas BA por raza: %s' % df.groupby('RACE')['BA'].mean().round(4).to_dict())
print('='*80)

def lrt(nested, full):
    stat = 2*(full.llf - nested.llf); dof = int(full.df_model - nested.df_model)
    return stat, dof, stats.chi2.sf(stat, dof)

def lincomb_or(model, param_names, label, per_1SD=True):
    """OR e IC para una combinacion lineal de coeficientes (p. ej. pendiente de SES por grupo)."""
    b = model.params; cov = model.cov_params(); idx = model.params.index
    w = np.zeros(len(idx))
    for pn in param_names: w[list(idx).index(pn)] += 1.0
    val = w @ b; se = np.sqrt(w @ cov @ w)
    lo, hi = val - 1.96*se, val + 1.96*se
    print('  %-12s  b=%.3f  OR(1SD)=%.2f  IC95%%=[%.2f, %.2f]  p=%.4f'
          % (label, val, np.exp(val), np.exp(lo), np.exp(hi), 2*stats.norm.sf(abs(val/se))))
    return np.exp(val), np.exp(lo), np.exp(hi)

def report_slopes(model, tag):
    print('\n--- Pendientes marginales de SES (por +1 SD) | %s ---' % tag)
    idx = list(model.params.index)
    base = 'SESc'
    print('  [referencia RACE = White]')
    lincomb_or(model, [base], 'White')
    for r, term in [('Hispanic','SESc:C(RACE)[T.Hispanic]'), ('Black','SESc:C(RACE)[T.Black]')]:
        line = lincomb_or(model, [base, term], r)

# ================================================================ 1) CRUDO
print('\n' + '#'*80)
print('# 1) MODELO CRUDO (TITULAR):  BA ~ SES*RACE , White=referencia')
print('#'*80)
mc0 = smf_logit('BA ~ SESc + C(RACE)', data=df).fit(disp=0)
mc1 = smf_logit('BA ~ SESc * C(RACE)', data=df).fit(disp=0)
chi, dof, p_int = lrt(mc0, mc1)
print('\nTest de moderacion (LRT, interaccion vs efectos principales):')
print('  chi2=%.3f, df=%d, p=%.5f' % (chi, dof, p_int))
print('\nCoeficientes del modelo crudo con interaccion:')
print(mc1.params.round(4).to_string())
print('\np-valores:')
print(mc1.pvalues.round(4).to_string())
report_slopes(mc1, 'MODELO CRUDO')

# probabilidad predicha -1SD vs +1SD (crudo)
print('\nProbabilidad predicha de BA, SES -1SD vs +1SD (MODELO CRUDO, marginal por raza):')
pred_rows = []
for race in ['White','Hispanic','Black']:
    row = {'race': race}
    for sdlab, sdv in [('-1SD',-1.0), ('+1SD',+1.0)]:
        exog = pd.DataFrame({'SESc':[sdv], 'RACE':pd.Categorical([race], categories=['White','Hispanic','Black'])})
        pr = mc1.get_prediction(exog)
        m, lo, hi = pr.predicted[0], pr.conf_int()[0,0], pr.conf_int()[0,1]
        row[sdlab] = m; row[sdlab+'_lo'] = lo; row[sdlab+'_hi'] = hi
        print('  %-8s SES %s: prob=%.4f  IC95%%=[%.4f, %.4f]' % (race, sdlab, m, lo, hi))
    row['abs_diff'] = row['+1SD']-row['-1SD']
    pred_rows.append(row)

# ================================================================ 2) AJUSTADO
print('\n' + '#'*80)
print('# 2) MODELO AJUSTADO (ROBUSTEZ / MEDIACION):')
print('#    BA ~ SES*RACE + SEXO + FAMILIA + ASVAB + PERCENTIL')
print('#'*80)
ma1 = smf_logit('BA ~ SESc*C(RACE) + C(SAMPLE_SEX) + FAMz + ASVABz + PCTz', data=df).fit(disp=0)
chi_a, dof_a, p_int_a = lrt(mc0, ma1)  # vs modelo crudo sin interaccion (mismo n)
print('\nLRT del modelo ajustado completo vs crudo sin interaccion: chi2=%.3f df=%d p=%.5f' % (chi_a, dof_a, p_int_a))
print('\nCoeficientes del modelo ajustado (p-valores):')
print(ma1.pvalues.round(4).to_string())
report_slopes(ma1, 'MODELO AJUSTADO')

# Probabilidad predicha ajustada: covariables continuas en la media muestral, sexo marginalizado
print('\nProbabilidad predicha de BA, SES -1SD vs +1SD (MODELO AJUSTADO;')
print('covariables continuas en media muestral, promedio sobre sexo):')
for race in ['White','Hispanic','Black']:
    for sdlab, sdv in [('-1SD',-1.0), ('+1SD',+1.0)]:
        probs = []
        for sex in ['Female','Male']:
            exog = pd.DataFrame({'SESc':[sdv],'RACE':pd.Categorical([race],categories=['White','Hispanic','Black']),
                                 'SAMPLE_SEX':[sex],'FAMz':[0.0],'ASVABz':[0.0],'PCTz':[0.0]})
            pr = ma1.get_prediction(exog)
            probs.append((pr.predicted[0], pr.conf_int()[0]))
        m = np.mean([p[0] for p in probs])
        lo = np.min([p[1][0] for p in probs]); hi = np.max([p[1][1] for p in probs])
        print('  %-8s SES %s: prob=%.4f  IC95%%=[%.4f, %.4f]' % (race, sdlab, m, lo, hi))

# ================================================================ 3) FIRTH
print('\n' + '#'*80)
print('# 3) SENSIBILIDAD: LOGIT PENALIZADO (FIRTH) ANTES EVENTOS RAROS')
print('#'*80)
def firth_logit(X, y, maxiter=200, tol=1e-9):
    beta = np.zeros(X.shape[1])
    for it in range(maxiter):
        eta = np.clip(X @ beta, -35, 35); p = 1/(1+np.exp(-eta))
        Wv = p*(1-p)
        XWX = (X * Wv[:,None]).T @ X
        XWX_inv = np.linalg.inv(XWX + 1e-12*np.eye(X.shape[1]))
        H = (X*Wv[:,None]) @ XWX_inv @ X.T
        h = np.diag(H)
        U = X.T @ (y - p + h*(0.5-p))
        delta = XWX_inv @ U
        beta = beta + delta
        if np.max(np.abs(delta)) < tol: break
    # SE con covarianza final
    eta = np.clip(X @ beta, -35, 35); p = 1/(1+np.exp(-eta)); Wv = p*(1-p)
    XWX = (X * Wv[:,None]).T @ X
    cov = np.linalg.inv(XWX + 1e-12*np.eye(X.shape[1]))
    return beta, np.sqrt(np.diag(cov))

print('\nPendiente de SES por raza: MLE (crudo) vs Firth, OR por +1 SD')
for race in ['White','Hispanic','Black']:
    sub = df[df['RACE']==race].copy()
    X = np.column_stack([np.ones(len(sub)), sub['SESc'].values])
    y = sub['BA'].values
    b_f, se_f = firth_logit(X, y)
    or_f = np.exp(b_f[1]); ci_f = np.exp(np.array([b_f[1]-1.96*se_f[1], b_f[1]+1.96*se_f[1]]))
    mr = smf_logit('BA ~ SESc', data=sub).fit(disp=0)
    ci_m = np.exp(mr.conf_int().loc['SESc'].values)
    print('  %-8s n=%4d ev=%3d | MLE  OR=%.2f [%.2f, %.2f]   Firth OR=%.2f [%.2f, %.2f]'
          % (race, len(sub), int(y.sum()), np.exp(mr.params['SESc']), ci_m[0], ci_m[1], or_f, ci_f[0], ci_f[1]))

# Firth en el modelo de interaccion completo (White referencia): direccion de las interacciones
Xf = np.column_stack([
    np.ones(n),
    (df['RACE']=='Hispanic').astype(float),
    (df['RACE']=='Black').astype(float),
    df['SESc'],
    df['SESc']*(df['RACE']=='Hispanic'),
    df['SESc']*(df['RACE']=='Black')])
names = ['Intercept','Hispanic','Black','SESc','SESc_Hispanic','SESc_Black']
bf, sef = firth_logit(Xf, df['BA'].values)
print('\nModelo de interaccion completo con Firth (White=ref):')
for nm, b, s in zip(names, bf, sef):
    print('  %-14s b=%+.3f  OR=%.2f  p=%.4f' % (nm, b, np.exp(b), 2*stats.norm.sf(abs(b/s))))


# LRT de interaccion DENTRO del modelo ajustado (comparacion correcta de atenuacion)
adj_noint = smf_logit('BA ~ SESc + C(RACE) + C(SAMPLE_SEX) + FAMz + ASVABz + PCTz', data=df).fit(disp=0)
chi_in, dof_in, p_in = lrt(adj_noint, ma1)
print('\nLRT de interaccion DENTRO del modelo ajustado: chi2=%.3f df=%d p=%.4f' % (chi_in, dof_in, p_in))
print('  (atenuacion vs crudo: p_interaccion %.4f -> %.4f al anadir rendimiento academico)' % (p_int, p_in))
