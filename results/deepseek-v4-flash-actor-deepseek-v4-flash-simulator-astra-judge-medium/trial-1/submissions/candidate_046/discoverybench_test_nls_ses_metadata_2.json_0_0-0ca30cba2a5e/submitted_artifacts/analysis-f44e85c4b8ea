print('\n' + '='*80)
print('RESUMEN PARA LA HIPOTESIS')
print('='*80)
print('Test de moderacion crudo: chi2=%.2f, p=%.4f' % (chi, p_int))
print('Pendientes SES (OR por +1SD, crudo):')
for r in ['White','Hispanic','Black']:
    sub = df[df['RACE']==r]; mr = smf_logit('BA ~ SESc', data=sub).fit(disp=0)
    ci = np.exp(mr.conf_int().loc['SESc'].values)
    print('   %-8s OR=%.2f [%.2f,%.2f]  p=%.4f' % (r, np.exp(mr.params['SESc']), ci[0], ci[1], mr.pvalues['SESc']))
print('Test de moderacion ajustado (por sexo, familia, ASVAB, percentil): p=%.4f' % p_int_a)
print('Probabilidades predichas crudas -1SD -> +1SD:')
for row in pred_rows:
    print('   %-8s %.4f -> %.4f  (diff +%.4f)' % (row['race'], row['-1SD'], row['+1SD'], row['abs_diff']))
