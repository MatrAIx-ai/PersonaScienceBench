import pandas as pd, numpy as np
from scipy.stats import fisher_exact
from statsmodels.formula.api import logit

df = pd.read_csv('data/nls_ses_processed.csv', index_col=0)
df['BA'] = df['BA DEGREE COMPLETED'].astype(int)
df = df[df['SAMPLE_RACE'].isin(['Black','White','Hispanic'])].copy()

lines = []
def pr(s):
    print(s); lines.append(s)

pr("="*70)
pr("FINAL ANALYSIS - NLS SES / BA completion")
pr("="*70)
pr("Total N = %d; BA completions = %d (%.2f%%)" % (len(df), df['BA'].sum(), 100*df['BA'].mean()))

# --- 1) Quartiles (primary) ---
q = df['SES'].quantile([0,.25,.5,.75,1]).values
df['SES_q'] = pd.cut(df['SES'], bins=q, include_lowest=True, labels=['Q1 (lowest)','Q2','Q3','Q4 (highest)'])
pr("\n[1] BA completion rate (%) by race x SES QUARTILE; Black-White diff/ratio; Fisher")
pr(f"{'Level':<14}{'Black%':>8}{'White%':>8}{'Hisp%':>8}{'nB':>6}{'nW':>6}{'kB':>5}{'kW':>5}{'diffB-W(pp)':>13}{'ratio B/W':>10}{'Fisher p':>9}")
for lab in ['Q1 (lowest)','Q2','Q3','Q4 (highest)']:
    sub = df[df['SES_q']==lab]
    b = sub[sub['SAMPLE_RACE']=='Black']['BA']; w = sub[sub['SAMPLE_RACE']=='White']['BA']; h = sub[sub['SAMPLE_RACE']=='Hispanic']['BA']
    table = [[(b==1).sum(), (b==0).sum()],[(w==1).sum(), (w==0).sum()]]
    or_, p = fisher_exact(table)
    ratio = b.mean()/w.mean() if w.mean()>0 else np.nan
    pr(f"{lab:<14}{100*b.mean():>8.2f}{100*w.mean():>8.2f}{100*h.mean():>8.2f}{len(b):>6}{len(w):>6}{(b==1).sum():>5}{(w==1).sum():>5}{100*(b.mean()-w.mean()):>+13.2f}{ratio:>10.2f}{p:>9.4f}")

# --- 2) Tertiles (robustness) ---
t = df['SES'].quantile([0,1/3,2/3,1]).values
df['SES_t'] = pd.cut(df['SES'], bins=t, include_lowest=True, labels=['T1 (low)','T2 (mid)','T3 (high)'])
pr("\n[2] Robustness: race x SES TERTILE (Black vs White)")
pr(f"{'Level':<12}{'Black%':>8}{'White%':>8}{'nB':>6}{'nW':>6}{'kB':>5}{'kW':>5}{'diffB-W(pp)':>13}{'ratio B/W':>10}")
for lab in ['T1 (low)','T2 (mid)','T3 (high)']:
    sub = df[df['SES_t']==lab]
    b = sub[sub['SAMPLE_RACE']=='Black']['BA']; w = sub[sub['SAMPLE_RACE']=='White']['BA']
    pr(f"{lab:<12}{100*b.mean():>8.2f}{100*w.mean():>8.2f}{len(b):>6}{len(w):>6}{(b==1).sum():>5}{(w==1).sum():>5}{100*(b.mean()-w.mean()):>+13.2f}{b.mean()/w.mean():>10.2f}")

# --- 3) Black vs Rest (robustness) ---
pr("\n[3] Robustness: Black vs Rest (White+Hispanic) by quartile")
for lab in ['Q1 (lowest)','Q2','Q3','Q4 (highest)']:
    sub = df[df['SES_q']==lab]
    b = sub[sub['SAMPLE_RACE']=='Black']['BA']; rest = sub[sub['SAMPLE_RACE']!='Black']['BA']
    pr(f"{lab:<14} Black={100*b.mean():.2f}% (n={len(b)}, k={b.sum()})  Rest={100*rest.mean():.2f}% (n={len(rest)}, k={rest.sum()})  diff={100*(b.mean()-rest.mean()):+.2f}pp  ratio={b.mean()/rest.mean():.2f}")

# --- 4) Continuous logistic interaction ---
df['SES_z'] = (df['SES']-df['SES'].mean())/df['SES'].std()
m = logit('BA ~ SES_z*SAMPLE_RACE', data=df).fit(disp=0)
pr("\n[4] Logistic: BA ~ SES_z * RACE  (baseline = Black; SES_z standardized; ORs)")
for k in m.params.index:
    pr(f"  {k:<34} coef={m.params[k]:>7.3f}  OR={np.exp(m.params[k]):>6.2f}  p={m.pvalues[k]:.4f}")
pr("  -> White's SES slope = SES_z + SES_z:White = %.3f (vs Black's %.3f); "
   "log-odds gap White-Black narrows from %.2f at SES_z=-1.5 to %.2f at SES_z=+1.5"
   % (m.params['SES_z']+m.params['SES_z:SAMPLE_RACE[T.White]'], m.params['SES_z'],
       m.params['SAMPLE_RACE[T.White]'] + (m.params['SES_z:SAMPLE_RACE[T.White]'])*(-1.5),
       m.params['SAMPLE_RACE[T.White]'] + (m.params['SES_z:SAMPLE_RACE[T.White]'])*(1.5)))

# --- 5) Model-predicted probabilities (FIXED: correct White logit = Int + White + SES_z*z + SES_z:White*z) ---
pr("\n[5] Logistic predicted BA completion (Black vs White) over SES_z (fixed formula)")
for z in [-1.5,-1.0,-0.5,0,0.5,1.0,1.5]:
    b_logit = m.params['Intercept'] + m.params['SES_z']*z
    w_logit = m.params['Intercept'] + m.params['SAMPLE_RACE[T.White]'] + m.params['SES_z']*z + m.params['SES_z:SAMPLE_RACE[T.White]']*z
    pb = 1/(1+np.exp(-b_logit)); pw = 1/(1+np.exp(-w_logit))
    pr(f"  SES_z={z:>5.1f}: Black={100*pb:5.2f}%  White={100*pw:5.2f}%  ratio={pb/max(pw,1e-9):.2f}  log-odds gap={w_logit-b_logit:+.2f}")

with open('analysis/evidence_summary.txt','w') as f:
    f.write("\n".join(lines))
print("\nSaved -> analysis/evidence_summary.txt")
