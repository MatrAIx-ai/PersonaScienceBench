"""
Análisis: roles con mayor proporción de asociación con requirements en sistemas ML.
Definición: asociación = 'quoted' en Q8_ML_Addressing_*; '-77' = NA (excluido de numerador y denominador).
Base principal: 188 completos (todos responden Q8). Robustez: 194 que respondieron el bloque Q8.
Bootstrap: B=10,000, seed 42, CI95 percentil 2.5-97.5 + BCa (scipy).
Test: bootstrap de la diferencia Project_Lead - Data_Scientist.
"""
import pandas as pd
import numpy as np
from scipy.stats import bootstrap

RNG_SEED = 42
B = 10000
ALPHA = 0.05

df = pd.read_csv('data/requirements_engineering_for_ML-enabled_systems.csv')
q8 = ['Q8_ML_Addressing_Project_Lead','Q8_ML_Addressing_Business_Analyst',
      'Q8_ML_Addressing_Requirement_Engineer','Q8_ML_Addressing_Solution_Architect',
      'Q8_ML_Addressing_Data_Scientist','Q8_ML_Addressing_Developer',
      'Q8_ML_Addressing_Tester','Q8_ML_Addressing_Others']
roles = [c.replace('Q8_ML_Addressing_','') for c in q8]

def to_binary(series):
    """quoted->1, not quoted->0, cualquier otro (p.ej. -77) -> NaN"""
    return series.map({'quoted': 1.0, 'not quoted': 0.0}).astype(float)

def summarize(sub, base_label):
    X = pd.DataFrame({r: to_binary(sub[c]) for r, c in zip(roles, q8)})
    n = len(X)
    rows = []
    for r in roles:
        x = X[r].dropna().values
        k = int(x.sum())          # numerador (quoted)
        nv = len(x)               # denominador (válidos)
        p = 100.0 * k / nv
        bp = bootstrap((x,), np.mean, n_resamples=B, method='percentile',
                       random_state=RNG_SEED, confidence_level=1-ALPHA)
        lo_pct, hi_pct = 100.0*bp.confidence_interval.low, 100.0*bp.confidence_interval.high
        bb = bootstrap((x,), np.mean, n_resamples=B, method='BCa',
                       random_state=RNG_SEED, confidence_level=1-ALPHA)
        lo_bca, hi_bca = 100.0*bb.confidence_interval.low, 100.0*bb.confidence_interval.high
        rows.append({'base': base_label, 'n_filas': n, 'rol': r, 'quoted': k, 'validos': nv,
                     'pct': p, 'CI95_perc_lo': round(lo_pct,3), 'CI95_perc_hi': round(hi_pct,3),
                     'CI95_bca_lo': round(lo_bca,3), 'CI95_bca_hi': round(hi_bca,3),
                     'ancho_perc_pp': round(hi_pct-lo_pct,3)})
    return pd.DataFrame(rows)

# ---- Base principal: 188 completos (todos responden Q8) ----
comp = df[df['Status'].str.startswith('Completed')].copy()
main = summarize(comp, 'completos_188')
# robustez: 194 con Q8 != -77 (mismo patrón de -77 en todos los ítems)
answered = df[df['Q8_ML_Addressing_Project_Lead'] != '-77'].copy()
rob = summarize(answered, 'answered_194')
table = pd.concat([main, rob], ignore_index=True)

print("=== TABLA COMPLETA: proporción de asociación (quoted) por rol ===")
for _, r in table.iterrows():
    print(f"[{r['base']:14s} | n={r['n_filas']:3d}] {r['rol']:20s} quoted={r['quoted']:3d}/{r['validos']:3d} "
          f"= {r['pct']:6.3f}%   CI95_perc=[{r['CI95_perc_lo']:7.3f},{r['CI95_perc_hi']:7.3f}]  ancho={r['ancho_perc_pp']:5.2f}pp  "
          f"CI95_bca=[{r['CI95_bca_lo']:7.3f},{r['CI95_bca_hi']:7.3f}]")

print("\n=== RANKING (base completos n=188) ===")
print(main.sort_values('pct', ascending=False)[['rol','quoted','validos','pct']].to_string(index=False))

# ---- Test de diferencia entre los dos primeros: Project_Lead - Data_Scientist (paired) ----
Xc = pd.DataFrame({r: to_binary(comp[c]) for r, c in zip(roles, q8)})
d_obs = (Xc['Project_Lead'].mean() - Xc['Data_Scientist'].mean()) * 100
def diff_of_means(d1, d2, axis=0):
    return d1.mean(axis=axis) - d2.mean(axis=axis)
bootd = bootstrap((Xc['Project_Lead'].values, Xc['Data_Scientist'].values), diff_of_means,
                  n_resamples=B, method='percentile', random_state=RNG_SEED, confidence_level=1-ALPHA)
lo, hi = bootd.confidence_interval.low, bootd.confidence_interval.high
sig = "NO cruza 0 => diferencia SIGNIFICATIVA" if not (lo <= 0 <= hi) else "cruza 0 => diferencia NO significativa"
print("\n=== DIFERENCIA Project_Lead - Data_Scientist (completos, paired bootstrap) ===")
lo_pp, hi_pp = lo*100, hi*100
print(f"d_obs = {d_obs:.3f} pp ; CI95 percentil = [{lo_pp:.3f}, {hi_pp:.3f}] pp -> {sig}")

rng = np.random.default_rng(RNG_SEED)
n = len(Xc)
deltas = np.array([(Xc['Project_Lead'].values[rng.integers(0,n,n)].mean()
                    - Xc['Data_Scientist'].values[rng.integers(0,n,n)].mean())*100 for _ in range(B)])
print(f"P(diff <= 0) en bootstrap = {(deltas<=0).mean():.4f}")

# ---- Contexto / tamaño muestral ----
print("\n=== TAMAÑO MUESTRAL y contexto ===")
print("filas:", len(df), "| IDs únicos:", df['ID'].nunique())
print("Status:", df['Status'].value_counts().to_dict())
print("Q8 respondida:", int((df['Q8_ML_Addressing_Project_Lead']!='-77').sum()), "/ 276")
print("D4_Role completos:", comp['D4_Role'].value_counts(dropna=False).to_dict())
print("\nDone.")
