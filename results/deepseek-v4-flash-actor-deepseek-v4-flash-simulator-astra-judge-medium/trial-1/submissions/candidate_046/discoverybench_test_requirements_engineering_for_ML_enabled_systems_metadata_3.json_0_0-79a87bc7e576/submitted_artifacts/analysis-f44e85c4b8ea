# -*- coding: utf-8 -*-
"""
DiscoveryBench - Requirements Engineering for ML-enabled systems
Análisis de técnicas de elicitación de requisitos (Q9_ML_Elicitation_*).

Pasos:
  1. Carga y validación del CSV (tamaño de muestra, unicidad de ID).
  2. Limpieza: '-77' = sin respuesta (se excluye por ítem). No hay '-99' en Q9.
  3. 'Usa la técnica' = valor 'quoted' (binario).
  4. % por técnica sobre denominador válido (194) [principal] y sobre 276 [sensibilidad].
  5. Ranking e identificación de la técnica más común.
  6. Bootstrap percentil 95% (B=10,000, semilla 42) por técnica.
  7. Comparación con la cifra declarada en la pregunta (69.399%, IC [69.062, 69.735])
     y documentación explícita de la discrepancia.
"""
import json
import numpy as np
import pandas as pd

SEED = 42
B = 10_000
DATA = "data/requirements_engineering_for_ML-enabled_systems.csv"
Q9_COLS = [
    "Q9_ML_Elicitation_Interviews",
    "Q9_ML_Elicitation_Scenarios",
    "Q9_ML_Elicitation_Prototyping",
    "Q9_ML_Elicitation_Workshops_Meetings",
    "Q9_ML_Elicitation_Observation",
    "Q9_ML_Elicitation_Others",
]

rng = np.random.default_rng(SEED)
df = pd.read_csv(DATA)

results = {}
results["sample_n"] = int(len(df))
results["unique_ids"] = int(df["ID"].nunique())
results["cols_total"] = int(df.shape[1])

# ---- 1. Encoding / cleaning -------------------------------------------------
enc = {"quoted": 1, "not quoted": 0, "-77": np.nan}
for c in Q9_COLS:
    df[c + "_bin"] = df[c].astype(str).map(enc)

# sanity: missing pattern (same 82 respondents across the 6 columns)
miss = df[[c + "_bin" for c in Q9_COLS]].isna()
results["missing_all_six"] = int(miss.all(axis=1).sum())
results["missing_none"] = int((~miss.any(axis=1)).sum())
results["missing_partial"] = int(((miss.sum(axis=1) > 0) & (~miss.all(axis=1))).sum())

# negative codes actually present in the 6 raw Q9 columns
neg_q9 = sorted({v for c in Q9_COLS for v in df[c].astype(str).unique()
                 if v.startswith("-")})
results["negative_codes_in_Q9"] = neg_q9  # esperado: ['-77'] únicamente

# ---- 2-4. Counts and percentages --------------------------------------------
rows = []
for c in Q9_COLS:
    b = df[c + "_bin"]
    nv = int(b.count())                 # válidos (excluye '-77')
    q = int((b == 1).sum())             # quoted
    nq = int((b == 0).sum())            # not quoted
    m = int(b.isna().sum())             # missing (-77)
    rows.append({
        "technique": c.replace("Q9_ML_Elicitation_", ""),
        "quoted": q, "not_quoted": nq, "missing": m,
        "n_valid": nv,
        "pct_of_valid": round(q / nv * 100, 3) if nv else None,
        "pct_of_all": round(q / results["sample_n"] * 100, 3),
    })
tab = pd.DataFrame(rows).sort_values("pct_of_valid", ascending=False).reset_index(drop=True)
results["table"] = tab.to_dict(orient="records")

# ---- 5. ranking / most common -----------------------------------------------
most = tab.iloc[0]
results["most_common_technique"] = most["technique"]
results["most_common_quoted"] = int(most["quoted"])
results["most_common_pct_valid"] = most["pct_of_valid"]
results["most_common_pct_all"] = most["pct_of_all"]
results["rank"] = [r["technique"] for r in tab.to_dict(orient="records")]

# ---- 6. Bootstrap percentil 95% (B, seed) por técnica ------------------------
def percentile_ci(sample, seed=SEED, b=B):
    r = np.random.default_rng(seed)
    boot = np.array([sample[r.integers(0, len(sample), len(sample))].mean()
                     for _ in range(b)])
    lo, hi = np.percentile(boot, [2.5, 97.5])
    return lo, hi, boot.mean()

for r in results["table"]:
    c = "Q9_ML_Elicitation_" + r["technique"]
    sample = df[c + "_bin"].dropna().to_numpy()
    lo, hi, bm = percentile_ci(sample)
    r["ci95_low"] = round(lo * 100, 3)
    r["ci95_high"] = round(hi * 100, 3)
    r["ci95_width_pp"] = round((hi - lo) * 100, 3)
    r["bootstrap_mean"] = round(bm * 100, 3)

# ---- 7. Discrepancia con la cifra declarada en la pregunta -------------------
declared_pct = 69.399
declared_lo, declared_hi = 69.062, 69.735
declared_width = declared_hi - declared_lo
max_obs = max(r["pct_of_valid"] for r in results["table"])
top_width = [r2["ci95_width_pp"] for r2 in results["table"] if r2["technique"] == most["technique"]][0]
# n teórico que se necesitaría para un IC de ese ancho con el p más alto posible
z = 1.96
needed_n = z**2 * (0.5 * 0.5) / (declared_width / 100) ** 2
results["discrepancy"] = {
    "declared_pct": declared_pct,
    "declared_ci": [declared_lo, declared_hi],
    "declared_ci_width_pp": round(declared_width, 3),
    "max_observed_pct_valid": max_obs,
    "technique_with_max": most["technique"],
    "n_required_for_declared_width_at_p05": int(round(needed_n)),
    "conclusion": (
        "La cifra 69.399% con IC [69.062, 69.735] NO es reproducible con las columnas "
        "Q9_ML_Elicitation_* de este CSV: la técnica más citada (Interviews) alcanza "
        f"{most['pct_of_valid']}% de los 194 válidos ({most['pct_of_all']}% de 276), y un IC 95% "
        f"bootstrapped en n=194 tiene un ancho de ~{top_width} pp (frente a los "
        f"{declared_width} pp declarados). El IC declarado exigiría n≈{int(round(needed_n)):,} "
        "respondientes. La cifra citada no se fuerza; se reporta con los datos reales."
    ),
}

out_path = "analysis/elicitation_results.json"
with open(out_path, "w", encoding="utf-8") as f:
    json.dump(results, f, ensure_ascii=False, indent=2)

# ---- Consola ----------------------------------------------------------------
pd.set_option("display.width", 200)
print(f"muestra: {results['sample_n']} filas, {results['unique_ids']} IDs únicos")
print(f"faltantes: {results['missing_all_six']} respondientes sin respuesta en las 6 Q9; "
      f"{results['missing_none']} con respuesta completa; parciales={results['missing_partial']}")
print(f"códigos negativos en Q9: {neg_q9}")
print()
print(tab.to_string(index=False))
print()
print("--- IC bootstrap percentil 95% (B=10,000, seed=42) ---")
for r in results["table"]:
    print(f"{r['technique']:18s} {r['pct_of_valid']:7.3f}%  "
          f"IC95 [{r['ci95_low']:6.3f}, {r['ci95_high']:6.3f}]  ancho {r['ci95_width_pp']:.3f} pp")
print()
print("--- Discrepancia ---")
for k, v in results["discrepancy"].items():
    print(f"{k}: {v}")
print()
print("Tabla y resumen guardados en analysis/elicitation_results.json")
