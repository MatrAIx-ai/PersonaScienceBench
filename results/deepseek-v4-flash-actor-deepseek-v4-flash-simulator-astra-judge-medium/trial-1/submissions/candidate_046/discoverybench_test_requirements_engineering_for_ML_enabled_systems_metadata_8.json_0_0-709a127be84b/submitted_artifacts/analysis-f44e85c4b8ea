"""Main analysis: two least-used documentation formats for ML requirements (Q10),
with bootstrap CIs. Coding: 'quoted'/'not quoted'/'-77' (question not reached ->
excluded from denominator); '-99' = no answer, free-text only, NA.
"""
import numpy as np
import pandas as pd

rng = np.random.default_rng(42)
df = pd.read_csv('data/requirements_engineering_for_ML-enabled_systems.csv', dtype=str)

fmts = ['Vision_Document','Requirements_Lists','Goal_Models','Use_Case_Models',
        'Prototypes','User_Stories','BDD_Scenarios','MLCanvas','Notebooks',
        'Data_Models','Others','Not_Documented']
qcols = ['Q10_ML_Documentation_' + f for f in fmts]
short = {c: c.replace('Q10_ML_Documentation_', '') for c in qcols}

all77 = (df[qcols] == '-77').all(axis=1)
valid = df[~all77].copy()
N_valid, N_all = len(valid), len(df)
print(f'Valid Q10 respondents: {N_valid}; total rows: {N_all}\n')

def make_res(sub, cols, denom, B=10000, seed=42):
    """count, share, percentile & normal bootstrap CIs aligned to cols order."""
    q = (sub[cols] == 'quoted').values.astype(int)
    n, ncol = q.shape
    r = np.random.default_rng(seed)
    idx = r.integers(0, n, size=(B, denom))
    boot = q[idx].sum(axis=1) / denom          # (B, ncol), mean over resampled rows
    lo  = np.percentile(boot, 2.5, axis=0)
    hi  = np.percentile(boot, 97.5, axis=0)
    mean = boot.mean(axis=0)
    sd  = boot.std(axis=0)
    count = q.sum(axis=0)
    res = pd.DataFrame({
        'format': [short[c] for c in cols],
        'count': count,
        'share_pct': (count/denom*100).round(3),
        'boot_mean_pct': (mean*100).round(3),
        'ci95_lo_pct': (lo*100).round(3),
        'ci95_hi_pct': (hi*100).round(3),
        'norm_lo_pct': ((mean-1.96*sd)*100).round(3),
        'norm_hi_pct': ((mean+1.96*sd)*100).round(3),
    }).sort_values('share_pct').reset_index(drop=True)
    return res, boot

# 1) PRIMARY: valid N=194, exclude Others & Not_Documented
rank_cols = [c for c in qcols if short[c] not in ('Others', 'Not_Documented')]
res, boot = make_res(valid, rank_cols, N_valid)
print('=== PRIMARY (N=194 valid, excludes Others & Not_Documented) ===')
print(res.to_string(index=False))

bdd = res[res['format']=='BDD_Scenarios'].iloc[0]
mc  = res[res['format']=='MLCanvas'].iloc[0]
third = res.iloc[2]
print(f"\n1st least used: BDD_Scenarios {bdd['share_pct']}% 95%CI [{bdd['ci95_lo_pct']},{bdd['ci95_hi_pct']}]")
print(f"2nd least used: MLCanvas {mc['share_pct']}% 95%CI [{mc['ci95_lo_pct']},{mc['ci95_hi_pct']}]")
print(f"3rd (next): {third['format']} {third['share_pct']}% 95%CI [{third['ci95_lo_pct']},{third['ci95_hi_pct']}]")
print(f"Gap BDD->MLCanvas {mc['share_pct']-bdd['share_pct']:.2f}pp; MLCanvas->3rd {third['share_pct']-mc['share_pct']:.2f}pp")

# ranking stability in bootstrap
names = np.array([short[c] for c in rank_cols])
order = np.argsort(boot, axis=1).argsort(axis=1)  # rank of each col (0=lowest) per resample
p_bdd_rank0 = np.mean(order[:, names.tolist().index('BDD_Scenarios')] == 0)
two_lowest = ['BDD_Scenarios', 'MLCanvas']
p_both_top2 = np.mean([set(names[r]) == set(two_lowest) for r in np.argsort(boot, axis=1)[:, :2]])
print(f'Bootstrap P(BDD lowest share)= {p_bdd_rank0:.3f}; P(BDD & MLCanvas are the two lowest)= {p_both_top2:.3f}')

# 2) SENSITIVITY: full N=276, -77 treated as not selected
dfb = df.copy()
for c in qcols:
    dfb[c] = np.where(dfb[c] == 'quoted', 1, 0)
def sens(cols, denom, label):
    s = dfb[cols].sum(); sv = s.sort_values()
    print(f'\n=== {label} ===')
    for c in sv.index:
        print(f'  {short[c]:22s} count={int(sv[c]):3d}  share={sv[c]/denom*100:6.2f}%')
sens(rank_cols, N_all, 'SENSITIVITY full N=276 (treat -77=NOT selected), exclude Others & ND')
sens(qcols, N_all, 'SENSITIVITY full N=276 (treat -77=NOT selected), include Others & ND')

# 3) SENSITIVITY: valid N=194 inclusive
res_incl, _ = make_res(valid, qcols, N_valid)
print('\n=== SENSITIVITY valid N=194, INCLUDING Others & Not_Documented ===')
print(res_incl[['format','count','share_pct','ci95_lo_pct','ci95_hi_pct']].to_string(index=False))

# 4) numeric fit of the question's stated values
print('\n=== Fit of stated 10.13% / 4.366% to counts ===')
for c in (28, 12, 15, 4):
    print(f'  count={c}: {c}/276={c/276*100:.3f}% | {c}/194={c/194*100:.3f}%')
