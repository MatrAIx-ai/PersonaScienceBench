"""Inspection of Q10_ML_Documentation_* columns for the ML requirements survey."""
import pandas as pd

df = pd.read_csv('data/requirements_engineering_for_ML-enabled_systems.csv', dtype=str)
print('Total rows:', len(df), '| ID range:', df['ID'].min(), '-', df['ID'].max(), '| unique IDs:', df['ID'].nunique())

print('\nStatus:')
print(df['Status'].value_counts(dropna=False).to_string())

fmts = ['Vision_Document','Requirements_Lists','Goal_Models','Use_Case_Models',
        'Prototypes','User_Stories','BDD_Scenarios','MLCanvas','Notebooks',
        'Data_Models','Others','Not_Documented']
qcols = ['Q10_ML_Documentation_' + f for f in fmts]

print('\nCoding check (unique values per format column):')
for c in qcols:
    print(f'  {c}: values={sorted(set(df[c]))}')

all77 = (df[qcols] == '-77').all(axis=1)
print('\nRows where ALL 12 Q10 format cols equal -77:', int(all77.sum()))
print(pd.crosstab(df['Status'], all77).to_string())

valid = df[~all77]
print('\nValid respondents for Q10 (>=1 usable answer):', len(valid))
print('Quoted counts over ALL 276 rows:')
print((df[qcols] == 'quoted').sum().to_string())
print('\nQuoted counts over VALID 194 rows (share):')
q_valid = (valid[qcols] == 'quoted').sum()
sv = q_valid / len(valid) * 100
for c in qcols:
    print(f'  {c.replace("Q10_ML_Documentation_",""):22s} quoted={int(q_valid[c]):3d}  share={sv[c]:6.2f}%')

# -99 vs -77 in free text and demographic columns
print('\n-99 (no-answer/free-text NA) presence in Q10_Others_Free:',
      (df['Q10_ML_Documentation_Others_Free'] == '-99').sum(),
      '| -77:', (df['Q10_ML_Documentation_Others_Free'] == '-77').sum())
