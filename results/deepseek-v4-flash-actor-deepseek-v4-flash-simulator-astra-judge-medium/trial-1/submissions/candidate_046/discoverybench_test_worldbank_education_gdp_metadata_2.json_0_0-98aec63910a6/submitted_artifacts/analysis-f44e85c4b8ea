# -*- coding: utf-8 -*-
"""
Effect of education expenditure (% of GNI) on per-capita income (GNI pc, 2015 US$)
Comparison: Sub-Saharan Africa (SSA) vs Lower Middle Income (LMC).

Plan approved by researcher:
- Education expenditure = NY.ADJ.AEDU.GN.ZS (Adjusted savings: education expenditure, % of GNI)
- Per-capita income      = NY.GNP.PCAP.KD  (GNI per capita, constant 2015 US$)
- Window: 2011-2015 (only fully balanced window; SSA outcome exists only 2011-2015)
- Simple approach: pooled OLS log(GNIpc) ~ z(edu) + SSA + z(edu)xSSA + limited controls
- Robustness: robust SEs (HC1), lagged edu (t-1), LMC long-panel validation (1975-2015)
  with Durbin-Watson, mechanism spending->enrollment.
- All results are CONDITIONAL ASSOCIATIONS, NOT causal effects (no instruments).
"""
import pandas as pd
import numpy as np
import statsmodels.api as sm

pd.set_option('display.width', 200)
pd.set_option('display.max_columns', 50)

# ------------------------------------------------------------------ load/long
raw = pd.read_csv('data/worldbank_education_gdp.csv')
id_vars = ['Country Group', 'Country Code', 'Series Name', 'Series Code']
long = raw.melt(id_vars=id_vars, var_name='Year', value_name='Value')
long['Year'] = long['Year'].str.extract(r'(\d{4})', expand=False).astype(int)
long['Value'] = pd.to_numeric(long['Value'], errors='coerce')

S = {
 'edu': 'Adjusted savings: education expenditure (percentage of GNI)',
 'gni': 'GNI per capita (constant 2015 USdollar)',
 'exp': 'Exports of goods and services (annual percentage growth)',
 'pri': 'School enrollment, primary (percentage gross)',
 'sec': 'School enrollment, secondary (percentage gross)',
 'lfp': 'Labor force participation rate, total (percentage of total population ages 15+) (modeled ILO estimate)',
}

def panel():
    d = {}
    for k, name in S.items():
        sub = long[long['Series Name'] == name][['Country Group', 'Year', 'Value']]
        sub = sub.rename(columns={'Value': k})
        d[k] = sub
    df = d['edu']
    for k in ['gni', 'exp', 'pri', 'sec', 'lfp']:
        df = df.merge(d[k], on=['Country Group', 'Year'], how='outer')
    df['group'] = np.where(df['Country Group'] == 'Sub-Saharan Africa', 'SSA', 'LMC')
    return df.sort_values(['group', 'Year']).reset_index(drop=True)

p = panel()
win = p[(p['Year'] >= 2011) & (p['Year'] <= 2015)].copy()

# ------------------------------------------------------------------ descriptives
print("="*100)
print("WINDOW 2011-2015  (n=5 per group; fully balanced)")
print("="*100)
desc = win.groupby('group')[['edu', 'gni', 'sec', 'pri', 'exp']].agg(['mean', 'std', 'min', 'max'])
print(desc.to_string())
print("\nStart vs end of window (edu, GNI pc):")
for g in ['LMC', 'SSA']:
    sub = win[win['group'] == g]
    e0, e1 = sub.iloc[0]['edu'], sub.iloc[-1]['edu']
    g0, g1 = sub.iloc[0]['gni'], sub.iloc[-1]['gni']
    print(f"  {g}: edu {e0:.3f}->{e1:.3f} ({ (e1-e0)/e0*100:+.1f}%), GNIpc {g0:.0f}->{g1:.0f} ({ (g1-g0)/g0*100:+.1f}%)")

# ------------------------------------------------------------------ model vars
win['log_gni'] = np.log(win['gni'])
# standardize edu on the POOLED window (10 obs) -> coefficients comparable
mu_e, sd_e = win['edu'].mean(), win['edu'].std(ddof=1)
win['edu_z'] = (win['edu'] - mu_e) / sd_e
win['ssa'] = (win['group'] == 'SSA').astype(int)
win['edu_x_ssa'] = win['edu_z'] * win['ssa']

def ols(y, X, label, robust=True):
    X1 = sm.add_constant(X)
    m = sm.OLS(y, X1).fit(cov_type='HC1' if robust else 'nonrobust')
    print(f"\n--- {label} ---  n={m.nobs}, R2={m.rsquared:.3f}, adjR2={m.rsquared_adj:.3f}, resid df={m.df_resid:.0f}")
    for term in X1.columns:
        c = m.params[term]; se = m.bse[term]; pv = m.pvalues[term]
        print(f"   {term:<12} : {c:+.4f}  (SE {se:.4f}, t {m.tvalues[term]:+.2f}, p {pv:.3f})")
    return m

m_main = ols(win['log_gni'], win[['edu_z', 'ssa', 'edu_x_ssa']], "MAIN pooled: log(GNIpc) ~ z(edu)*SSA  [2011-2015]")

# ------------------------------------------------------------------ per-group simples
print("\n" + "="*100)
print("PER-GROUP SIMPLE REGRESSIONS  log(GNIpc) ~ z(edu)  [2011-2015, n=5 each]")
print("="*100)
group_models = {}
for g in ['LMC', 'SSA']:
    sub = win[win['group'] == g]
    m = ols(sub['log_gni'], sub[['edu_z']], f"group={g}")
    group_models[g] = m
    r_p = sub[['edu', 'gni']].corr().iloc[0, 1]
    r_l = sub[['edu', 'log_gni']].corr().iloc[0, 1]
    print(f"   raw corr(edu, GNIpc)={r_p:+.3f} ; corr(edu, logGNIpc)={r_l:+.3f}")

# ------------------------------------------------------------------ limited controls
print("\n" + "="*100)
print("LIMITED-CONTROL MODELS (pooled window; keep d.f.)")
print("="*100)
win['sec_z'] = (win['sec'] - win['sec'].mean()) / win['sec'].std(ddof=1)
win['exp_z'] = (win['exp'] - win['exp'].mean()) / win['exp'].std(ddof=1)
ols(win['log_gni'], win[['edu_z', 'ssa', 'edu_x_ssa', 'sec_z']], "POOLED + secondary enrollment")
ols(win['log_gni'], win[['edu_z', 'ssa', 'edu_x_ssa', 'exp_z']], "POOLED + exports growth (note SSA 2011 outlier -43%)")
ols(win['log_gni'], win[['edu_z', 'ssa', 'edu_x_ssa', 'sec_z', 'exp_z']], "POOLED + sec + exports  (resid df=4, thin)")

# ------------------------------------------------------------------ lagged edu
print("\n" + "="*100)
print("ROBUSTNESS: LAGGED edu (t-1)  [2011-2015, lag uses 2010]")
print("="*100)
lag = p[p['Year'] >= 2010][['group', 'Year', 'edu']].rename(columns={'edu': 'edu_lag', 'Year': 'Year_lag'})
lag['Year'] = lag['Year_lag'] + 1
w = win.merge(lag[['group', 'Year', 'edu_lag']], on=['group', 'Year'], how='left')
mu_el, sd_el = w['edu_lag'].mean(), w['edu_lag'].std(ddof=1)
w['edu_lag_z'] = (w['edu_lag'] - mu_el) / sd_el
w['edu_lag_x_ssa'] = w['edu_lag_z'] * w['ssa']
ols(w['log_gni'], w[['edu_lag_z', 'ssa', 'edu_lag_x_ssa']], "POOLED lagged edu (t-1)")

# ------------------------------------------------------------------ LMC long-panel validation
print("\n" + "="*100)
print("LMC LONG PANEL VALIDATION  1975-2015 (n=41)")
print("="*100)
lmc = p[p['group'] == 'LMC'].copy()
lmc = lmc[(lmc['edu'].notna()) & (lmc['gni'].notna())].copy()
lmc['log_gni'] = np.log(lmc['gni'])
lmc['edu_zf'] = (lmc['edu'] - lmc['edu'].mean()) / lmc['edu'].std(ddof=1)
lmc['trend'] = lmc['Year'] - 1975

m_lmc_full = ols(lmc['log_gni'], lmc[['edu_zf']], "LMC full-sample: log(GNIpc) ~ z(edu) [1975-2015]")
m_lmc_trend = ols(lmc['log_gni'], lmc[['edu_zf', 'trend']], "LMC full-sample + linear trend")

# Durbin-Watson
resid = m_lmc_full.resid
dw = np.sum(np.diff(resid) ** 2) / np.sum(resid ** 2)
print(f"\nDurbin-Watson (LMC full, no controls): {dw:.3f}  (<2 => positive autocorrelation)")

# AR(1) lagged-outcome check
lmc['log_gni_l1'] = lmc['log_gni'].shift(1)
lmc2 = lmc.dropna(subset=['log_gni_l1'])
m_ar = ols(lmc2['log_gni'], lmc2[['edu_zf', 'log_gni_l1']], "LMC full: log(GNIpc) ~ z(edu) + lag1(logGNIpc)  [AR(1) check]")

# LMC slope in 2011-2015 vs full sample, both z-scored on LMC full sample
lmcw = lmc[(lmc['Year'] >= 2011)].copy()
m_lmcw = ols(lmcw['log_gni'], lmcw[['edu_zf']], "LMC restricted 2011-2015 (edu z-scored on LMC full sample) -> representativeness check")
print(f"\nLMC slope full-sample 1975-2015 : {m_lmc_full.params['edu_zf']:+.4f} per LMC-full SD")
print(f"LMC slope in 2011-2015 only     : {m_lmcw.params['edu_zf']:+.4f} per LMC-full SD")

# ------------------------------------------------------------------ mechanism
print("\n" + "="*100)
print("MECHANISM (descriptive): education spending -> enrollment   [1975-2015 full]")
print("="*100)
for g in ['LMC', 'SSA']:
    sub = p[p['group'] == g]
    for out in ['pri', 'sec']:
        rr = sub[['edu', out]].dropna().corr().iloc[0, 1]
        print(f"   {g}: corr(edu, {out} enrollment) = {rr:+.3f}  (n={sub[['edu', out]].dropna().shape[0]})")

# ------------------------------------------------------------------ summary numbers
print("\n" + "="*100)
print("SUMMARY FOR HYPOTHESIS")
print("="*100)
b_main = m_main.params
se_main = m_main.bse
print(f"Pooled window 2011-2015, std=1 pooled SD of edu_exp (SD={sd_e:.3f}pp of GNI):")
print(f"  - LMC slope  dlog(GNIpc)/SD : {b_main['edu_z']:+.4f} (SE {se_main['edu_z']:.4f})")
print(f"  - SSA slope (base+dummy+interact): {b_main['edu_z']+b_main['edu_x_ssa']:+.4f}")
print(f"  - Difference (interaction coef)  : {b_main['edu_x_ssa']:+.4f} (SE {se_main['edu_x_ssa']:.4f}, p {m_main.pvalues['edu_x_ssa']:.3f})")
print(f"  - SSA level shifter (intercept diff at mean edu): {b_main['ssa']:+.4f}")

# Export results
import json
results = {
  'window': '2011-2015', 'n_total': int(m_main.nobs),
  'main_pooled': {'edu_z': b_main['edu_z'], 'ssa': b_main['ssa'], 'interaction': b_main['edu_x_ssa'],
                  'se_edu_z': se_main['edu_z'], 'se_ssa': se_main['ssa'], 'se_interaction': se_main['edu_x_ssa'],
                  'p_interaction': m_main.pvalues['edu_x_ssa'], 'r2': m_main.rsquared},
  'per_group_slope': {g: {'slope': group_models[g].params['edu_z'], 'se': group_models[g].bse['edu_z'],
                          'p': group_models[g].pvalues['edu_z'], 'r2': group_models[g].rsquared} for g in ['LMC', 'SSA']},
  'lmc_full_slope_per_SD': m_lmc_full.params['edu_zf'],
  'lmc_full_dw': dw,
  'mean_edu': {'LMC': win[win.group=='LMC']['edu'].mean(), 'SSA': win[win.group=='SSA']['edu'].mean()},
  'mean_gni': {'LMC': win[win.group=='LMC']['gni'].mean(), 'SSA': win[win.group=='SSA']['gni'].mean()},
}
with open('analysis_results.json', 'w') as f:
    json.dump(results, f, indent=2, default=float)
print("\nSaved analysis_results.json")
