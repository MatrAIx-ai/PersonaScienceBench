"""
Final analysis: age and probability of DISSAVED=1 (withdrew more from savings than put in)
NLSY79-derived nls_bmi_processed.csv. Logistic regression (statsmodels), headline = covariate-
adjusted linear age gradient plus unadjusted contrast, AME and predicted probabilities,
linearity/curvature diagnostics, and agreed sensitivity analyses.
"""
import pandas as pd, numpy as np
import statsmodels.formula.api as smf
from scipy.stats import chi2
import warnings; warnings.filterwarnings("ignore")
pd.set_option("display.float_format", lambda x: f"{x:,.5f}")
OUT = []
def log(s=""):
    print(s); OUT.append(s)

df = pd.read_csv("data/nls_bmi_processed.csv")
df["race_grp"] = np.select([(df.BLACK==1)&(df.HISPANIC==1),(df.BLACK==1),(df.HISPANIC==1)],
                           ["BLACK & HISP","BLACK only","HISP only"], default="WHITE/NON-HISP")
log("SHAPE %dx%d, missing: %d" % (df.shape[0], df.shape[1], int(df.isna().sum().sum())))
log("RACE groups: " + ", ".join(f"{k}={v}" for k,v in df["race_grp"].value_counts().items()))
log("Outcome DISSAVED=1: %d (%.1f%%)" % (df.DISSAVED.sum(), df.DISSAVED.mean()*100))

df["age_c"]  = df["AGE"] - df["AGE"].mean();  df["age_c2"] = df["age_c"]**2
df["FEMALE"] = (df.GENDER=="FEMALE").astype(int)
df["inc_mean_imputed"] = (df.INCOME == df.INCOME.mean()).astype(int)
df["inc_topcoded"]     = (df.INCOME == df.INCOME.max()).astype(int)
df["dup"]    = df.duplicated(keep=False).astype(int)
df["AGEB"]   = pd.cut(df.AGE,[23,26,29,32],labels=["24-26","27-29","30-32"])
log("Imputed-INCOME rows %d (%.1f%%); topcoded %d; duplicate rows %d" %
    (df.inc_mean_imputed.sum(), df.inc_mean_imputed.mean()*100, df.inc_topcoded.sum(), df.dup.sum()))
log("Overlap imputed&dup: %d; imputed&top: %d; dup&top: %d" %
    (((df.inc_mean_imputed==1)&(df.dup==1)).sum(), ((df.inc_mean_imputed==1)&(df.inc_topcoded==1)).sum(),
     ((df.dup==1)&(df.inc_topcoded==1)).sum()))

def fit(f,d): return smf.logit(f, data=d).fit(disp=0)
def ame_age(m):
    p = m.predict(); u = m.model.data.frame; b = m.params
    if "age_c2" in u.columns and "age_c2" in b.index: d = b["age_c"]+2*b["age_c2"]*u["age_c"]
    elif "age_c" in u.columns and "age_c" in b.index:  d = np.repeat(b["age_c"], len(u))
    else:                                              return None
    return float(np.mean(p*(1-p)*d))
def pred_at(m, ages):
    u = m.model.data.frame.copy(); am = df.AGE.mean(); out={}
    for a in ages:
        uu = u.copy()
        if "age_c" in uu.columns: uu["age_c"]=a-am
        if "age_c2" in uu.columns: uu["age_c2"]=(a-am)**2
        out[a]=float(m.predict(uu).mean())
    return out
def show(m,tag):
    log("\n== %s ==\n%s" % (tag, m.summary2().tables[1].to_string()))
    log("AIC=%.1f BIC=%.1f LogL=%.3f n=%d" % (m.aic,m.bic,m.llf,m.nobs))
    if "age_c" in m.params:
        aa = ame_age(m)
        log("AME(+1yr age)=%s; pred P%s" % ("%.5f"%aa, {k:round(v,4) for k,v in pred_at(m,(24,27,30,32)).items()}))

COV = "INCOME + FEMALE + BLACK + HISPANIC"
m0  = fit("DISSAVED ~ age_c", df);                show(m0,"M0 UNadjusted linear AGE")
m1  = fit(f"DISSAVED ~ age_c + {COV}", df);       show(m1,"M1 HEADLINE adjusted linear AGE")
m1q = fit(f"DISSAVED ~ age_c + age_c2 + {COV}", df); show(m1q,"M1q adjusted + quadratic AGE")
m2  = fit(f"DISSAVED ~ AGEB + {COV}", df);        show(m2,"M2 adjusted age-bucketed")

lrt_b = 2*(m2.llf-m1.llf); lrt_q = 2*(m1q.llf-m1.llf)
log("\nLINEARITY: LR linear-vs-buckets chi2=%.3f p=%.4f; LR quadratic chi2=%.3f p=%.4f" %
    (lrt_b, chi2.sf(lrt_b,1), lrt_q, chi2.sf(lrt_q,1)))
log("AIC/BIC: linear %.1f/%.1f | bucketed %.1f/%.1f | quadratic %.1f/%.1f" %
    (m1.aic,m1.bic,m2.aic,m2.bic,m1q.aic,m1q.bic))

b,se,pp = m1.params["age_c"], m1.bse["age_c"], m1.pvalues["age_c"]
b0,se0  = m0.params["age_c"], m0.bse["age_c"]
pp1, pp0 = pred_at(m1,(24,27,30,32)), pred_at(m0,(24,27,30,32))
log("\nHEADLINE: logit age_c=%.4f (SE=%.4f p=%.2g) OR/yr=%.4f; AME=%.5f" % (b,se,pp,np.exp(b),ame_age(m1)))
log(" adjusted pred P: age24=%.3f age27=%.3f age30=%.3f age32=%.3f  (24->32: %.1f%% rel, %.1f pp)" %
    (pp1[24],pp1[27],pp1[30],pp1[32],(pp1[32]/pp1[24]-1)*100,(pp1[32]-pp1[24])*100))
log("UNadjusted: age_c=%.4f (SE=%.4f); AME=%.5f; pred P age24=%.3f age32=%.3f (24->32 %.1f%% rel)" %
    (b0,se0,ame_age(m0),pp0[24],pp0[32],(pp0[32]/pp0[24]-1)*100))

log("\nSENSITIVITIES (headline adjusted linear):")
for nm, d in [("S_B excl mean-imputed INCOME", df[df.inc_mean_imputed==0]),
              ("S_C excl mean-imputed+topcoded", df[(df.inc_mean_imputed==0)&(df.inc_topcoded==0)]),
              ("S_E excl duplicate rows", df[df.dup==0]),
              ("S_F excl implausible BMI>60", df[~((df.BMI>60))])]:
    mm = fit(f"DISSAVED ~ age_c + {COV}", d)
    log("  %-36s n=%d: age_c=%+.4f (SE=%.4f p=%.3g) AME=%.5f" %
        (nm, mm.nobs, mm.params["age_c"], mm.bse["age_c"], mm.pvalues["age_c"], ame_age(mm)))
mm = fit(base_formula if False else f"DISSAVED ~ age_c + {COV} + SAMESAVE", df)
log("  %-36s n=%d: age_c=%+.4f (SE=%.4f p=%.3g) AME=%.5f" %
    ("S_D headline + SAMESAVE", mm.nobs, mm.params["age_c"], mm.bse["age_c"], mm.pvalues["age_c"], ame_age(mm)))
mm = fit(f"DISSAVED ~ age_c + {COV} + BMI", df)
log("  %-36s n=%d: age_c=%+.4f (SE=%.4f p=%.3g) AME=%.5f (BMI not sig p=%.2f)" %
    ("S_G headline + BMI", mm.nobs, mm.params["age_c"], mm.bse["age_c"], mm.pvalues["age_c"], ame_age(mm), mm.pvalues["BMI"]))

log("\nDissave-by-age within subsamples:")
for nm,d in [("ALL",df),("IMPUTED-INCOME",df[df.inc_mean_imputed==1]),("NON-IMPUTED",df[df.inc_mean_imputed==0]),
             ("CLEAN(no imp/dup/top)",df[(df.inc_mean_imputed==0)&(df.dup==0)&(df.inc_topcoded==0)])]:
    g=d.groupby("AGEB")["DISSAVED"].agg(["count","mean"])
    log("  %-22s n=%d: %s" % (nm,len(d), "; ".join(f"{i}:{r['mean']*100:.1f}%" for i,r in g.iterrows())))

log("\nGENDER STRATIFICATION:")
for gname,slc in [("FEMALES",df.FEMALE==1),("MALES",df.FEMALE==0)]:
    mm=fit(f"DISSAVED ~ age_c + INCOME + BLACK + HISPANIC", df[slc])
    log("  %-8s n=%d: age_c=%+.4f (SE=%.4f p=%.3g) AME=%.5f" %
        (gname,mm.nobs,mm.params["age_c"],mm.bse["age_c"],mm.pvalues["age_c"],ame_age(mm)))
mint=fit(f"DISSAVED ~ age_c*FEMALE + INCOME + BLACK + HISPANIC", df)
log("  interaction age_c:FEMALE=%+.4f (p=%.3g)" % (mint.params["age_c:FEMALE"], mint.pvalues["age_c:FEMALE"]))

with open("results_summary.txt","w") as f: f.write("\n".join(OUT))
log("\nSAVED results_summary.txt; headline pred P 24/27/30/32: "+str([round(pp1[a],4) for a in (24,27,30,32)]))
