"""
Análisis NLSY79: ¿Una mayor preferencia temporal (impaciencia) se asocia con mayor BMI?
Proxies de preferencia temporal: conducta de ahorro 1989 y riqueza neta familiar.
Outcome: BMI (peso kg / altura m^2) en 1992 (principal), 1989 (contemporáneo) y cambio 1981->1992.
Diseño: OLS con línea base BMI_1981 y controles de SES/demografía; errores robustos HC1.
"""
import pandas as pd
import numpy as np
import statsmodels.api as sm
import warnings
warnings.filterwarnings('ignore')

df = pd.read_csv('data/nls_raw.csv')

# ---------------- LIMPIEZA ----------------
# Altura 1981 codificada como pies*100+pulgadas
h81 = np.floor(df['Height of respondent, 1981']/100)*12 + (df['Height of respondent, 1981']%100)
h85 = df['Height of respondent, 1985']
height_in = h85.where(h85.notna(), h81)          # prefer 1985, fallback decoded 1981
height_m  = height_in * 0.0254

# Peso en libras -> kg ; BMI = kg/m2
def bmi(w_col, height_m):
    return (df[w_col] * 0.453592) / (height_m ** 2)

bmi81 = bmi('Weight of respondent, 1981', height_m)
bmi89 = bmi('Weight of respondent, 1989', height_m)
bmi92 = bmi('Weight of respondent, 1992', height_m)

# Validez: descartar BMI implausibles para outcomes
valid_bmi = (bmi92.between(15,60)) & (bmi89.between(15,60)) & (bmi81.between(15,60))

# excluir grado 95 (código inválido)
valid_educ = df['Highest grade completed, 1979'] < 60

# ---------------- VARIABLES ----------------
save = df['Was more money put into or taken out of R/spouse savings since last interview, 1989']
A = pd.DataFrame({
    'id': df['ID# (range 1-12686) 1979'],
    'bmi81': bmi81, 'bmi89': bmi89, 'bmi92': bmi92,
    'save': save,
    'female': (df['Sex of respondent, 1979']==2).astype(int),
    'race3': df['Racial/ethnic cohort, 1979'],
    'age89': df['Age of respondent at interview date, 1989'],
    'educ': df['Highest grade completed, 1979'],
    'moeduc': df["Highest grade completed by respondent's mother, 1979"],
    'faeduc': df["Highest grade completed by respondent's father, 1979"],
    'famsize': df['Family size, 1979'],
    'inc89': df['Total net family income, previous calendar year, 1989'],
    'wealth85': df['Family net wealth, 1985'],
    'wealth90': df['Family net wealth, 1990'],
    'wealth96': df['Family net wealth, 1996 (key data point)'],
    'asvab': df[['ASVAB - Arithmetic Reasoning Z Score (rounded), 1981',
                 'ASVAB - Word Knowledge Z Score (rounded), 1981',
                 'ASVAB - Paragraph Comprehension Z Score (rounded), 1981',
                 'ASVAB - Mathematics Knowledge Z Score (rounded), 1981']].mean(axis=1),
})
# dummy racionales
A['black'] = (A['race3']==1).astype(int)
A['hisp']  = (A['race3']==2).astype(int)
# IHS wealth (maneja ceros y negativos)
A['ihs_w85'] = np.arcsinh(A['wealth85']/1000)
A['ihs_w90'] = np.arcsinh(A['wealth90']/1000)
A['ihs_w96'] = np.arcsinh(A['wealth96']/1000)
A['linc89']  = np.log1p(A['inc89'])
A['linc85']  = np.log1p(df['Total net family income, previous calendar year, 1985'])

# dummy de ahorro con referencia cat1 (metió más = más paciente)
A['s2'] = (A['save']==2).astype(float)   # sacó más
A['s3'] = (A['save']==3).astype(float)   # sin cambio
A['s4'] = (A['save']==4).astype(float)   # sin ahorros

# residencia jail (algún año 1981-1992)
rescols = [c for c in df.columns if 'Type of residence' in c and c.split(', ')[-1] in
           ['1981','1982','1983','1984','1985','1986','1987','1988','1989','1990','1991','1992']]
A['jail'] = pd.concat([(df[c]==5).astype(int) for c in rescols], axis=1).max(axis=1)

# ---------------- HELPERS ----------------
CONTROLS = ['age89','female','black','hisp','educ','moeduc','faeduc','famsize','linc89']

def robust_fit(y, X, label=None, yname='BMI'):
    X = sm.add_constant(X)
    m = sm.OLS(y, X, missing='drop').fit(cov_type='HC1')
    if label:
        show(m, label, yname)
    return m

def show(fit, label, yname):
    n = int(fit.nobs)
    print(f"\n### {label}  | N={n} | R2={fit.rsquared:.3f}")
    for var in fit.params.index:
        if var == 'const':
            continue
        b = fit.params[var]; lo, hi = fit.conf_int().loc[var]
        p = fit.pvalues[var]
        star = '***' if p<0.001 else ('**' if p<0.01 else ('*' if p<0.05 else ('+' if p<0.1 else '')))
        print(f"  {var:<12} b={b:+7.3f}  [95% CI {lo:+7.3f}, {hi:+7.3f}]  p={p:.4f} {star}")

# ---------------- MUESTRA NÚCLEO ----------------
core = A[valid_bmi & valid_educ & A['bmi92'].notna() & A['save'].notna() &
         A['linc89'].notna() & A['age89'].notna()].copy()
print("Muestra núcleo (BMI92 válido + ahorro89 + ingreso89 + edad + demos):", len(core))
print("Distribución save en muestra:\n", core['save'].value_counts().sort_index().to_dict())

# =============== 1) MODELO PRINCIPAL: BMI_1992 ~ ahorro1989 (ref cat1) + BMI_1981 + controles ===============
X1 = core[['s2','s3','s4','bmi81'] + CONTROLS]
m1 = robust_fit(core['bmi92'], X1, 'BMI92', 'PRINCIPAL: BMI_1992 ~ ahorro1989 (ref=1 metió+) + BMI81 + controles')

# 1b) sin BMI_1981 (para ver asociación bruta ajustada por SES)
m1b = robust_fit(core['bmi92'], core[['s2','s3','s4'] + CONTROLS], 'BMI92', 'SENS: sin BMI_1981')

# 1c) SOLO AHORRADORES ACTIVOS: cat1 vs cat2 (contraste limpio de paciencia vs impaciencia)
act = A[valid_bmi & valid_educ & A['bmi92'].notna() & A['save'].isin([1,2]) &
        A['linc89'].notna() & A['age89'].notna()].copy()
act['impat'] = (act['save']==2).astype(float)
Xact = act[['impat','bmi81'] + CONTROLS]
m_active = robust_fit(act['bmi92'], Xact, 'BMI92', 'CONTRASTE cat2 vs cat1 (solo ahorradores activos)')

# 1d) BINARIO: impaciente = sacó más o sin ahorros (cat2|cat4) vs resto (cat1|cat3)
core['impat_bin'] = core['save'].isin([2,4]).astype(float)
Xbin = core[['impat_bin','bmi81'] + CONTROLS]
m_bin = robust_fit(core['bmi92'], Xbin, 'BMI92', 'BINARIO: impaciente(cat2|cat4) vs resto')

# =============== 2) RIQUEZA NETA ===============
Xw = core[['ihs_w90','bmi81'] + CONTROLS]
m_w90 = robust_fit(core['bmi92'], Xw, 'BMI92', 'RIQUEZA: BMI_1992 ~ IHS(wealth1990) + BMI81 + controles')
Xw96 = core[['ihs_w96','bmi81'] + CONTROLS]
m_w96 = robust_fit(core['bmi92'], Xw96, 'BMI92', 'RIQUEZA: BMI_1992 ~ IHS(wealth1996) + BMI81 + controles')

# cuartiles de riqueza 1990
wq = core[['wealth90','bmi92']].dropna(subset=['wealth90'])
wq['q'] = pd.qcut(wq['wealth90'], 4, labels=['Q1','Q2','Q3','Q4'], duplicates='drop')
# merge
core['wq90'] = pd.qcut(core['wealth90'].clip(lower=-np.inf), 4, labels=False, duplicates='drop')
# dummies
core['wq2'] = (core['wq90']==1).astype(float)
core['wq3'] = (core['wq90']==2).astype(float)
core['wq4'] = (core['wq90']==3).astype(float)
Xwq = core[['wq2','wq3','wq4','bmi81'] + CONTROLS]
m_wq = robust_fit(core['bmi92'], Xwq, 'BMI92', 'RIQUEZA por cuartil 1990 (ref Q1 bajo)')

# =============== 3) CONTEMPORÁNEO BMI_1989 ~ ahorro1989 ===============
core89 = A[valid_bmi & valid_educ & A['bmi89'].notna() & A['save'].notna() &
           A['linc89'].notna() & A['age89'].notna()].copy()
X89 = core89[['s2','s3','s4','bmi81'] + CONTROLS]
m89 = robust_fit(core89['bmi89'], X89, 'BMI89', 'CONTEMPORÁNEO: BMI_1989 ~ ahorro1989 + BMI81 + controles')

# =============== 4) CAMBIO BMI 1981->1992 ===============
core_ch = core.dropna(subset=['bmi81'])
core_ch['dbmi'] = core_ch['bmi92'] - core_ch['bmi81']
Xch = core_ch[['s2','s3','s4'] + CONTROLS]
m_ch = robust_fit(core_ch['dbmi'], Xch, 'dBMI', 'CAMBIO: BMI92-BMI81 ~ ahorro1989 + controles')

# =============== 5) SENSIBILIDAD: control jail + ASVAB ===============
Xsens = core[['s2','s3','s4','bmi81','jail','asvab'] + CONTROLS]
m_sens = robust_fit(core['bmi92'], Xsens, 'BMI92', 'SENSIBILIDAD: + jail (encarcelamiento) + ASVAB')

# =============== RESUMEN EFECTOS EN UNIDADES DE BMI ===============
print("\n" + "="*90)
print("RESUMEN DE EFECTOS (unidades de BMI, con 95% CI), muestras de casos completos por modelo")
print("="*90)

def effect_summary(fit, var):
    b = fit.params[var]; lo, hi = fit.conf_int().loc[var]; p = fit.pvalues[var]
    n = int(fit.nobs)
    print(f"  {var:<14} b={b:+6.2f} BMI [CI {lo:+6.2f},{hi:+6.2f}] p={p:.4f}  N={n}")

print("\nPRINCIPAL (BMI92, ref=cat1 'metió más'):")
effect_summary(m1,'s4'); effect_summary(m1,'s2'); effect_summary(m1,'s3')
print("\nCONTRASTE AHORRADORES ACTIVOS (cat2 vs cat1):")
effect_summary(m_active,'impat')
print("\nBINARIO impaciente(cat2|cat4) vs resto:")
effect_summary(m_bin,'impat_bin')
print("\nRIQUEZA IHS(wealth90):")
effect_summary(m_w90,'ihs_w90')
print("\nRIQUEZA cuartil 1990 (Q4 vs Q1):")
effect_summary(m_wq,'wq4')
print("\nCONTEMPORÁNEO BMI89: cat4 vs cat1:")
effect_summary(m89,'s4')
print("\nCAMBIO BMI92-BMI81: cat4 vs cat1:")
effect_summary(m_ch,'s4')
print("\nSENSIBILIDAD (+jail +ASVAB): cat4 vs cat1:")
effect_summary(m_sens,'s4')
