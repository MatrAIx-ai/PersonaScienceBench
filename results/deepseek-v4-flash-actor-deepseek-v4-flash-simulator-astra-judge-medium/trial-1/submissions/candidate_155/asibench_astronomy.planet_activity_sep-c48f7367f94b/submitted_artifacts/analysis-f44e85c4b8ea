"""Recover latent summary (planet-activity separation, ASIBench) per case and
predict component-A-only future values.  Uses obs_0 (primary channel, per
contract; obs_1/obs_2 are auxiliaries with unmodeled structure and are ignored
for parameter recovery).

Pipeline (approved):
  1. Enumerate ALL local minima of the weighted chi2 over the full (P1,P2)
     period landscape for the model
        obs_0(t) = offset
                 + [A] sA*sin(2pi t/PA)+cA*cos(2pi t/PA)
                 + [B] sB*sin(2pi t/PB)+cB*cos(2pi t/PB)
                 + sB2*sin(4pi t/PB)+cB2*cos(4pi t/PB)         (1st harmonic of B)
     weighted by 1/obs_0_err.
  2. Reject degenerate basins where A is not identifiable:
       - swap-contrast ratio  chi2(swapped A<->B)/chi2 < 5   (A sits on B's
         first harmonic -> unidentifiable), and
       - |PA - PB| < 2 d   (A sits on B's fundamental -> unphysical for a
         planet/activity separation).
  3. Among surviving (separated) minima pick the lowest chi2; component A =
     harmonic-free fundamental, component B = fundamental + first harmonic
     (orientation validated by the same swap-contrast test).
  4. component_a_present decision:
       present = 1  if  (F-test 2-df p-value < 0.01  AND  dBIC(B-only - full) > 10)
                   OR  (A amplitude > 3 * fitted residual sigma)
       else 0.  If 0: PA, A coefficients, and future A values are set to 0.
  5. Predict A(t) = sA*sin(2pi t/PA) + cA*cos(2pi t/PA) at the input_2 times
     (reference_epoch_day = 0.0), preserving row order.
  6. Write signal_summary.csv and target_predictions.csv exactly per contract.
"""
import json
import numpy as np
import pandas as pd
from scipy.optimize import least_squares
from scipy.signal import lombscargle
from scipy import stats

with open('data/input_0.json') as f:
    meta = json.load(f)
REFF = float(meta['reference_epoch_day'])
CASE_ORDER = list(meta['case_order'])
assert REFF == 0.0
df1 = pd.read_csv('data/input_1.csv')
df2 = pd.read_csv('data/input_2.csv')


def design(t, P1, P2):
    return np.column_stack([
        np.ones_like(t),
        np.sin(2*np.pi*(t-REFF)/P1), np.cos(2*np.pi*(t-REFF)/P1),
        np.sin(2*np.pi*(t-REFF)/P2), np.cos(2*np.pi*(t-REFF)/P2),
        np.sin(4*np.pi*(t-REFF)/P2), np.cos(4*np.pi*(t-REFF)/P2)])


def fit_full(t, y, err, P1, P2):
    X = design(t, P1, P2)
    w = 1.0/err
    coef, *_ = np.linalg.lstsq(X*w[:, None], y*w, rcond=None)
    r = (y - X@coef)/err
    return float(r@r), coef


def fit_bonly(t, y, err, PB):
    X = np.column_stack([np.ones_like(t),
        np.sin(2*np.pi*(t-REFF)/PB), np.cos(2*np.pi*(t-REFF)/PB),
        np.sin(4*np.pi*(t-REFF)/PB), np.cos(4*np.pi*(t-REFF)/PB)])
    w = 1.0/err
    coef, *_ = np.linalg.lstsq(X*w[:, None], y*w, rcond=None)
    r = (y - X@coef)/err
    return float(r@r), coef


def local_minima(t, y, err, Plo=4.0, Phi=120.0, ngrid=220, nref=25):
    """Enumerate distinct local minima of chi2 over (P1,P2)."""
    Pg = np.geomspace(Plo, Phi, ngrid)
    grid = np.empty((ngrid, ngrid))
    for i, P1 in enumerate(Pg):
        for j, P2 in enumerate(Pg):
            grid[i, j] = fit_full(t, y, err, P1, P2)[0]
    seeds = []
    for i in range(1, ngrid-1):
        for j in range(1, ngrid-1):
            v = grid[i, j]
            if v <= min(grid[i-1, j], grid[i+1, j], grid[i, j-1], grid[i, j+1]):
                seeds.append((v, Pg[i], Pg[j]))
    seeds.sort()
    minima = []
    seen = set()
    for c0, P1, P2 in seeds[:nref]:
        def resid(logp):
            return np.sqrt(fit_full(t, y, err, np.exp(logp[0]), np.exp(logp[1]))[0])
        r = least_squares(resid, np.log([P1, P2]), bounds=(np.log(Plo), np.log(Phi)),
                          max_nfev=250)
        P1m, P2m = np.exp(r.x)
        key = (round(P1m, 2), round(P2m, 2))
        if key in seen:
            continue
        seen.add(key)
        c, coef = fit_full(t, y, err, P1m, P2m)
        c_sw, _ = fit_full(t, y, err, P2m, P1m)
        minima.append(dict(PA=P1m, PB=P2m, chi2=c, chi2_swap=c_sw, coef=coef))
    minima.sort(key=lambda d: d['chi2'])
    return minima


def analyze_case(cid):
    g = df1[df1['case_id'] == cid].sort_values('time_day')
    t = g['time_day'].values.astype(float)
    y = g['obs_0'].values.astype(float)
    err = g['obs_0_err'].values.astype(float)
    n = len(t)
    mins = local_minima(t, y, err)

    # --- B-only reference fit (needed for presence test and present=0 case) ---
    def bonly_resid(logp):
        return np.sqrt(fit_bonly(t, y, err, np.exp(logp[0]))[0])
    Pg = np.geomspace(6, 200, 500)
    c0, P0 = min((fit_bonly(t, y, err, P)[0], P) for P in Pg)
    rb = least_squares(bonly_resid, np.log(P0), bounds=(np.log(6), np.log(200)),
                       max_nfev=150)
    PB_b = np.exp(rb.x[0])
    SSR_b, coef_b = fit_bonly(t, y, err, PB_b)

    # --- degenerate-basin filtering (separated A short / B long solution) ---
    chosen = None
    for m in mins:
        PA, PB = m['PA'], m['PB']
        swap_ratio = m['chi2_swap']/m['chi2'] if m['chi2'] > 0 else 1e9
        if swap_ratio < 5.0:
            continue          # A indistinguishable from B's first harmonic
        if abs(PA - PB) < 2.0:
            continue          # A on top of B's fundamental (unphysical for sep.)
        chosen = m
        break
    if chosen is None:        # fallback: least-degenerate minimum
        chosen = max(mins, key=lambda m: m['chi2_swap']/m['chi2'] if m['chi2']>0 else 0)
    PA, PB = chosen['PA'], chosen['PB']
    SSR_full, coef = chosen['chi2'], chosen['coef']

    # --- presence decision (F-test + BIC + amplitude check) ---
    k_full, k_b = 7, 5
    dof_full = n - k_full
    F = ((SSR_b - SSR_full)/2.0)/(SSR_full/dof_full)
    pval = 1.0 - stats.f.cdf(F, 2, dof_full)
    bic_full = n*np.log(SSR_full/n) + k_full*np.log(n)
    bic_b = n*np.log(SSR_b/n) + k_b*np.log(n)
    dbic = bic_b - bic_full
    sigma_fit = np.sqrt(SSR_full/dof_full)
    A_amp = np.hypot(coef[1], coef[2])
    present = 1 if ((pval < 0.01 and dbic > 10.0) or A_amp > 3.0*sigma_fit) else 0

    if present:
        PA_out, a1, a2 = PA, coef[1], coef[2]
    else:
        PA_out, a1, a2 = 0.0, 0.0, 0.0
        PB, SSR_b, coef_b = PB_b, SSR_b, coef_b     # re-report B from B-only fit

    # --- residual whitening diagnostics at the chosen solution ---
    if present:
        X = design(t, PA, PB)
        rnorm = (y - X@coef)/err
        b1, b2, b3, b4, off = coef[3], coef[4], coef[5], coef[6], coef[0]
        PB_out = PB
    else:
        X = np.column_stack([np.ones_like(t),
            np.sin(2*np.pi*(t-REFF)/PB), np.cos(2*np.pi*(t-REFF)/PB),
            np.sin(4*np.pi*(t-REFF)/PB), np.cos(4*np.pi*(t-REFF)/PB)])
        rnorm = (y - X@coef_b)/err
        b1, b2, b3, b4, off = coef_b[1], coef_b[2], coef_b[3], coef_b[4], coef_b[0]
        PB_out = PB
    fr = np.linspace(1/150.0, 1/1.5, 4000)
    pg = lombscargle(t, rnorm - rnorm.mean(), fr, normalize=True)
    dw = np.mean(np.diff(rnorm[np.argsort(t)])**2)/np.var(rnorm)

    diag = dict(cid=cid, n=n, dof=dof_full, chi2=SSR_full, chi2red=SSR_full/dof_full,
                PA=PA, PB=PB_out, chi2_swap=chosen['chi2_swap'],
                swap_ratio=chosen['chi2_swap']/SSR_full,
                A_amp=A_amp, sigma_fit=sigma_fit, F=F, p=pval, dbic=dbic,
                present=present, PB_b=PB_b, SSR_b=SSR_b,
                rnorm_std=rnorm.std(), dw_like=dw, resid_ls=pg.max(),
                n_minima=len(mins))
    row = dict(case_id=cid, component_a_present=present,
               component_a_period_day=float(PA_out),
               component_a_basis1_u0=float(a1), component_a_basis2_u0=float(a2),
               component_b_period_day=float(PB_out),
               component_b_basis1_u0=float(b1), component_b_basis2_u0=float(b2),
               component_b_basis3_u0=float(b3), component_b_basis4_u0=float(b4),
               offset_u0=float(off))
    return row, diag


rows, diags = [], []
for cid in CASE_ORDER:
    row, diag = analyze_case(cid)
    rows.append(row)
    diags.append(diag)
summary = pd.DataFrame(rows)
summary.to_csv('signal_summary.csv', index=False)

pred_rows = []
for _, r in df2.iterrows():
    s = summary[summary['case_id'] == r['case_id']].iloc[0]
    td = float(r['time_day'])
    if int(s['component_a_present']) == 1:
        PA = float(s['component_a_period_day'])
        val = (float(s['component_a_basis1_u0'])*np.sin(2*np.pi*(td-REFF)/PA)
               + float(s['component_a_basis2_u0'])*np.cos(2*np.pi*(td-REFF)/PA))
    else:
        val = 0.0
    pred_rows.append({'case_id': r['case_id'], 'time_day': td,
                      'component_a_value_u0': val})
pred = pd.DataFrame(pred_rows, columns=['case_id', 'time_day', 'component_a_value_u0'])
pred.to_csv('target_predictions.csv', index=False)

# ---------------- diagnostics report ----------------
print('=== DIAGNOSTICS ===')
for d in diags:
    print(f"[{d['cid']}] n={d['n']} local_minima={d['n_minima']}")
    print(f"   chosen: PA={d['PA']:.4f}  PB={d['PB']:.4f}  chi2={d['chi2']:.2f}  chi2red={d['chi2red']:.4f}")
    print(f"   swap chi2red={d['chi2_swap']/(d['n']-7):.2f}  swap_ratio={d['swap_ratio']:.1f}")
    print(f"   F={d['F']:.1f} p={d['p']:.2e}  dBIC={d['dbic']:.1f}  A_amp={d['A_amp']:.3f} sigma={d['sigma_fit']:.3f} amp/sig={d['A_amp']/d['sigma_fit']:.2f}")
    print(f"   present={d['present']}  |  residuals: std={d['rnorm_std']:.3f} DW={d['dw_like']:.3f} LSmax={d['resid_ls']:.3f}")
print()
print('=== signal_summary.csv ===')
print(summary.to_string(index=False))
print()
print('=== target_predictions.csv ===')
print(pred.to_string(index=False))
