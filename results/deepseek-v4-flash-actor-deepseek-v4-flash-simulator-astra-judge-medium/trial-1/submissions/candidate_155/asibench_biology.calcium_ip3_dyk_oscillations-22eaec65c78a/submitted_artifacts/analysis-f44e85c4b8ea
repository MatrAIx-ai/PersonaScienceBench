    axes[0, 1].set_xlabel("IP3 (uM)"); axes[0, 1].set_ylabel("period (s)")

    axes[1, 0].plot(CHANNEL_COUNTS, cv_isi_vs_N, "s-", color="tab:red")
    axes[1, 0].set_title("ISI CV vs N  (lowest IP3 level, idx %d)"
                         % CR_IP3_IDX)
    axes[1, 0].set_xlabel("channel count N"); axes[1, 0].set_ylabel("CV of ISI")
    axes[1, 0].set_xscale("log")

    axes[1, 1].plot(IP3_LEVELS, p_open_vs_ip3, "^-", color="tab:purple")
