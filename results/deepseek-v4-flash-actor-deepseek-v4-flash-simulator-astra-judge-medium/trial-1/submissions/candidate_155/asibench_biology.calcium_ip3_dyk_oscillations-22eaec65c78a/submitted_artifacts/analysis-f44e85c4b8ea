    t = np.arange(N_SAMPLES) * DT_OUT
    axes[0, 0].plot(t, tr[0], lw=0.8, color="tab:blue")
    axes[0, 0].set_title("Representative cytosolic Ca trace  (IP3=%.4f uM, N=%d)"
                         % (IP3_LEVELS[r], CHANNEL_COUNTS[c]))
    axes[0, 0].set_xlabel("time (s)"); axes[0, 0].set_ylabel("Ca_cyt (uM)")

    axes[0, 1].plot(IP3_LEVELS, period_vs_ip3, "o-", color="tab:green")
    axes[0, 1].set_title("Fundamental period vs IP3  (N = %d)"
