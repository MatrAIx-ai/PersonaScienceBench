#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
B3 Cellular Signaling Dynamics from Channel-Level Kinetic Data
==============================================================
Stochastic channel-state simulation of the public
De Young-Keizer / Li-Rinzel IP3 receptor model (8-state subunits,
s = 4k + 2j + i), coupled to a cytosolic calcium balance.

Public model contract:  data/system_info.json
Scan specification:     data/scan_spec.json
Outputs:
    simulate.py, ca_traces.npz, summary_stats.json, calcium_summary.png

Numerical scheme
----------------
* Each channel has 3 independent 8-state subunits.  At every integration
  step the subunit transition generator Q(IP3, Ca) (8x8) is built from the
  public transition-rate semantics and the exact one-step transition
  matrix P = expm(Q * dt) is computed.  The next subunit state is drawn
  from the row distribution Categorical(P[s, :]) (matrix-exponential
  sampling of the CTMC -- exact for piecewise-constant rates).
* The calcium ODE
      dCa/dt = v1*(n_open/N)*(Ca_lumen-Ca) + v2*(Ca_lumen-Ca)
               - Vmax*Ca^2/(Km^2 + Ca^2),   Ca_lumen = (c0-Ca)/c1
  is advanced with Heun (RK2) on the same grid (dt = 5 ms).
  J = v1*(open_fraction)*(Ca_lumen-Ca) is the Li-Rinzel whole-cell
  mean-field-consistent flux (open_fraction = n_open/N).
* Initial condition: ca_cyt(0)=0.1 uM (public hint); ca_lumen follows from
  the c0/c1 conservation.  Subunits are drawn from the stationary
  distribution of their 8-state chain at (IP3, ca_cyt=0.1).

Summary statistics (from simulated traces, peak-to-peak robust)
-----------------------------------------------------------------
* period_vs_ip3      : median peak-to-peak ISI at the largest channel
                       count (scipy find_peaks, prominence 0.15). NaN
                       where fewer than 2 spikes are observed.
* cv_isi_vs_N        : CV = std(ISI)/mean(ISI) at the lowest IP3 level
                       (cr_ip3_idx_used = 0), pooled over replicates.
* p_open_vs_ip3      : time-averaged open fraction at the largest channel
                       count (continuous-time average).
* conservation_error_max : worst relative drift of total calcium content
                       Ca_cyt + c1*Ca_lumen (exactly c0 by the public
                       constraint, so the drift is floating-point only).

The figure uses matplotlib when available; otherwise a self-contained
pure-numpy+zlib PNG renderer is used (valid PNG either way).
"""
import json
import math
import zlib
import struct
import numpy as np
from scipy.linalg import expm
from scipy.signal import find_peaks

# ----------------------------------------------------------------------
# 1. Load the public contract
# ----------------------------------------------------------------------
with open("data/system_info.json") as fh:
    SYS = json.load(fh)
with open("data/scan_spec.json") as fh:
    SCAN = json.load(fh)

RK = SYS["receptor_kinetics"]
CM = SYS["compartment"]
FX = SYS["channel_flux_and_pump"]
OB = SYS["observation"]
IH = SYS["initial_conditions_hint"]

_BI = {b["idx"]: b for b in RK["binding_interactions"]}
A1, D1 = _BI[1]["forward_rate"], _BI[1]["equilibrium_kd"]
A2, D2 = _BI[2]["forward_rate"], _BI[2]["equilibrium_kd"]
A3, D3 = _BI[3]["forward_rate"], _BI[3]["equilibrium_kd"]
A4, D4 = _BI[4]["forward_rate"], _BI[4]["equilibrium_kd"]
A5, D5 = _BI[5]["forward_rate"], _BI[5]["equilibrium_kd"]

C0 = float(CM["total_free_ca_micromolar"])
C1 = float(CM["volume_ratio_lumen_to_cyt"])
V1 = float(FX["max_channel_flux_rate_per_second"])
V2 = float(FX["lumen_leak_rate_per_second"])
V3 = float(FX["reuptake_vmax_micromolar_per_second"])
K3 = float(FX["reuptake_km_micromolar"])
T_OBS = float(OB["T_obs_seconds"])
DT_OUT = float(OB["dt_out_seconds"])
N_REPS = int(OB["n_replicates"])
CA0 = float(IH["ca_cyt_initial_micromolar"])

IP3_LEVELS = [float(x) for x in SCAN["ip3_levels_micromolar"]]
CHANNEL_COUNTS = [int(x) for x in SCAN["channel_counts"]]
N_SAMPLES = int(round(T_OBS / DT_OUT))          # 1200
N_IP3 = len(IP3_LEVELS)
N_N = len(CHANNEL_COUNTS)

# Numerical parameters (validated by distributional convergence tests;
# the channel CTMC is exact for any dt via the matrix exponential).
DT_INT = 0.005          # integration step (s); DT_OUT/DT_INT = 20
BASE_SEED = 12345       # deterministic master seed


def make_Q(ip3, ca):
    """8x8 generator (off-diagonal rates in 1/s; row sums 0).

    State s = 4*k + 2*j + i, i: IP3 bound, j: activating Ca bound,
    k: inhibitory Ca bound.
      flip_i : (a1,d1) when k=0 ; (a3,d3) when k=1 ;  bind a*[IP3], unbind a*d
      flip_j : (a5,d5)
      flip_k : (a4,d4) when i=0 ; (a2,d2) when i=1 ;  bind a*[Ca],  unbind a*d
    """
    Q = np.zeros((8, 8))
    for k in (0, 1):
        for j in (0, 1):
            for i in (0, 1):
                s = 4 * k + 2 * j + i
                a = A1 if k == 0 else A3
                d = D1 if k == 0 else D3
                t = 4 * k + 2 * j + (1 - i)
                Q[s, t] += a * ip3 if i == 0 else a * d
                t = 4 * k + 2 * (1 - j) + i
                Q[s, t] += A5 * ca if j == 0 else A5 * D5
                a = A4 if i == 0 else A2
                d = D4 if i == 0 else D2
                t = 4 * (1 - k) + 2 * j + i
                Q[s, t] += a * ca if k == 0 else a * d
    for s in range(8):
        Q[s, s] = -Q[s].sum()
    return Q


def subunit_stationary(ip3, ca):
    """Stationary distribution of a single subunit at fixed (IP3, Ca)."""
    w, v = np.linalg.eig(make_Q(ip3, ca).T)
    p = v[:, np.argmin(np.abs(w))].real
    return p / p.sum()


def simulate_grid_point(ip3, n_ch, dt=DT_INT, n_reps=N_REPS, master_seed=BASE_SEED):
    """Simulate one (IP3, channel count) grid point.

    Returns:
        traces   : (n_reps, n_samples) float64 cytosolic Ca (uM),
                   trace[k] aligned to t = k*dt_out seconds.
        popen    : (n_reps,) continuous-time averaged open fraction.
        cons_max : (n_reps,) max relative drift of total Ca content.
    """
    n_steps = int(round(T_OBS / dt))
    n_out = N_SAMPLES
    steps_per_out = int(round(DT_OUT / dt))
    m = 3 * n_ch
    traces = np.zeros((n_reps, n_out), dtype=np.float64)
    popen = np.zeros(n_reps, dtype=np.float64)
    cons_max = np.zeros(n_reps, dtype=np.float64)

    pi0 = subunit_stationary(ip3, CA0)   # subunit initial distribution

    for rep in range(n_reps):
        rng = np.random.default_rng(master_seed + 1000 * IP3_LEVELS.index(ip3)
                                    + 100 * CHANNEL_COUNTS.index(n_ch) + rep)
        states = rng.choice(8, size=m, p=pi0).astype(np.int32)
        cur_ca = CA0
        open_acc = 0.0
        out_cursor = 0
        max_drift = 0.0

        for step in range(n_steps):
            # record at the start of each output block (t = out_cursor*dt_out)
            if out_cursor < n_out and step % steps_per_out == 0:
                traces[rep, out_cursor] = cur_ca
                out_cursor += 1

            # exact CTMC step for all subunits (matrix-exponential sampling)
            Q = make_Q(ip3, cur_ca)
            P = expm(Q * dt)
            u = rng.random(m)
            acc = np.cumsum(P[states, :], axis=1)
            states = np.argmax(acc >= u[:, None], axis=1).astype(np.int32)

            # open fraction and calcium balance
            n_open = np.mean((states == 3).reshape(-1, 3).all(axis=1))
            open_acc += n_open

            ca_lum = (C0 - cur_ca) / C1
            drift = abs((cur_ca + C1 * ca_lum) - C0) / C0
            if drift > max_drift:
                max_drift = drift

            f1 = (V1 * n_open * (ca_lum - cur_ca)
                  + V2 * (ca_lum - cur_ca)
                  - V3 * cur_ca * cur_ca / (K3 * K3 + cur_ca * cur_ca))
            ca_h = cur_ca + dt * f1
            ca_lum_h = (C0 - ca_h) / C1
            f2 = (V1 * n_open * (ca_lum_h - ca_h)
                  + V2 * (ca_lum_h - ca_h)
                  - V3 * ca_h * ca_h / (K3 * K3 + ca_h * ca_h))
            cur_ca = cur_ca + 0.5 * dt * (f1 + f2)

        popen[rep] = open_acc / n_steps
        cons_max[rep] = max_drift

    return traces, popen, cons_max


# ----------------------------------------------------------------------
# 2. Run the full (IP3 x channel-count) grid
# ----------------------------------------------------------------------
print("Simulating %d grid points (ip3 x N), %d replicates each ..."
      % (N_IP3 * N_N, N_REPS), flush=True)
CA_TRACES = {}          # key "ip3{i}_N{j}" -> (reps, samples)
P_OPEN = np.zeros((N_IP3, N_N))      # time-averaged open fraction
CONS_ERR = np.zeros((N_IP3, N_N))    # worst per-point relative drift
for i, ip3 in enumerate(IP3_LEVELS):
    for j, nc in enumerate(CHANNEL_COUNTS):
        key = "ip3%d_N%d" % (i, j)
        tr, po, cm = simulate_grid_point(ip3, nc)
        CA_TRACES[key] = tr
        P_OPEN[i, j] = po.mean()
        CONS_ERR[i, j] = cm.max()
        print("  %s  done (Ca span [%.3f, %.3f], p_open %.5f)"
              % (key, tr.min(), tr.max(), po.mean()), flush=True)

np.savez_compressed("ca_traces.npz", **CA_TRACES)

# ----------------------------------------------------------------------
# 3. Summary statistics (peak-to-peak, robust for relaxation oscillations)
# ----------------------------------------------------------------------
N_IDX_MAX = int(np.argmax(CHANNEL_COUNTS))          # largest channel count
CR_IP3_IDX = 0                                       # lowest-IP3 scan level
PROMINENCE = 0.15   # uM; spikes rise ~1 uM here, plateau ripple < 0.15


def peak_times(trace):
    pks, _ = find_peaks(trace, prominence=PROMINENCE)
    return pks * DT_OUT


def isis_from_traces(tr):
    """Pooled peak-to-peak ISIs (s) from all replicates of a trace set."""
    isis = []
    for r in range(tr.shape[0]):
        tt = peak_times(tr[r])
        if tt.size >= 2:
            isis.extend(np.diff(tt).tolist())
    return isis

period_vs_ip3 = []
for i, ip3 in enumerate(IP3_LEVELS):
    isis = isis_from_traces(CA_TRACES["ip3%d_N%d" % (i, N_IDX_MAX)])
    if len(isis) >= 1:
        period_vs_ip3.append(float(np.median(isis)))
    else:
        period_vs_ip3.append(float("nan"))   # fewer than 2 spikes

cv_isi_vs_N = []
for j, nc in enumerate(CHANNEL_COUNTS):
    isis = isis_from_traces(CA_TRACES["ip3%d_N%d" % (CR_IP3_IDX, j)])
    if len(isis) >= 2:
        cv_isi_vs_N.append(float(np.std(isis) / np.mean(isis)))
    else:
        cv_isi_vs_N.append(float("nan"))

p_open_vs_ip3 = [float(P_OPEN[i, N_IDX_MAX]) for i in range(N_IP3)]
conservation_error_max = float(CONS_ERR.max())

summary = {
    "ip3_levels": IP3_LEVELS,
    "channel_counts": CHANNEL_COUNTS,
    "period_vs_ip3": period_vs_ip3,
    "cv_isi_vs_N": cv_isi_vs_N,
    "p_open_vs_ip3": p_open_vs_ip3,
    "conservation_error_max": conservation_error_max,
    "cr_ip3_idx_used": CR_IP3_IDX,
}
with open("summary_stats.json", "w") as fh:
    json.dump(summary, fh, indent=2)
print("summary_stats.json written.", flush=True)

