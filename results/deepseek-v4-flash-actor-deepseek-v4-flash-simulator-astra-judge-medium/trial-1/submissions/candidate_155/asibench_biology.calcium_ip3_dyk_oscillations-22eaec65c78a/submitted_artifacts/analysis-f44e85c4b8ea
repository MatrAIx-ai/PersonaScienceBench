def _text_width(scale):
    return (5 + 1) * scale


def _draw_text(canvas, x, y, text, color, scale=2):
    """Draw 5x7 bitmap text with top-left at (x, y)."""
    for ch in text:
        glyph = _F5x7.get(ch, _F5x7[" "])
        for r, bits in enumerate(glyph):
            for cbit in range(5):
                if bits & (0b10000 >> cbit):
                    for sy in range(scale):
                        for sx in range(scale):
                            yy = y + r * scale + sy
                            xx = x + cbit * scale + sx
                            if 0 <= yy < canvas.shape[0] and 0 <= xx < canvas.shape[1]:
                                canvas[yy, xx] = color
        x += (5 + 1) * scale


def _plot_xy(canvas, x0, x1, y0, y1, xs, ys, color, pad=1):
    """Map finite data (xs, ys) into the pixel region and draw samples."""
    xmin, xmax = float(np.nanmin(xs)), float(np.nanmax(xs))
    fin = ys[~np.isnan(ys)]
    if fin.size == 0:
        return
    ymin, ymax = float(fin.min()), float(fin.max())
    if xmax == xmin:
        xmax = xmin + 1.0
    if ymax == ymin:
        ymax = ymin + 1.0

    def px(v):
        return int(round(x0 + (v - xmin) / (xmax - xmin) * (x1 - x0)))

    def py(v):
        return int(round(y1 - (v - ymin) / (ymax - ymin) * (y1 - y0)))

    for xv, yv in zip(xs, ys):
        if np.isnan(yv):
            continue
        xx, yy = px(xv), py(yv)
        for dy in range(-pad, pad + 1):
            for dx in range(-pad, pad + 1):
                cx, cy = xx + dx, yy + dy
                if x0 <= cx <= x1 and y0 <= cy <= y1:
                    canvas[cy, cx] = color


def _nice_ticks(vmin, vmax, n=4):
    span = vmax - vmin
    if span <= 0:
        return [float(vmin)]
    step = 10 ** math.floor(math.log10(span / n))
    for m in (1.0, 2.0, 5.0, 10.0):
        if span / (step * m) <= n:
            step *= m
            break
    out = []
    v = math.ceil(vmin / step) * step
    while v <= vmax + 1e-9:
        out.append(v)
        v += step
    return out


def _fmt(v):
    if v == int(v):
        return "%.0f" % v
    if abs(v) >= 100:
        return "%.0f" % v
    if abs(v) >= 10:
        return "%.1f" % v
    return "%.2f" % v


def _make_figure_pure_numpy():
    """Self-contained 4-panel diagnostic PNG (no external image library)."""
    W, H = 1300, 1000
    img = np.full((H, W, 3), 245, dtype=np.uint8)
    black = np.array([20, 20, 20])
    gridc = np.array([202, 202, 202])
    blue = np.array([31, 119, 180])
    green = np.array([44, 160, 44])
    red = np.array([214, 39, 40])
    purple = np.array([148, 103, 189])

    def panel(x0, x1, y0, y1, title, xlab, ylab, xs, ys, color, xlog=False):
        img[y0, x0:x1 + 1] = black
        img[y1, x0:x1 + 1] = black
        img[y0:y1 + 1, x0] = black
        img[y0:y1 + 1, x1] = black

        if xlog:
            xv = np.log10(np.array(xs, dtype=float))
            xmin, xmax = float(xv.min()), float(xv.max())
        else:
            xv = np.asarray(xs, dtype=float)
            xmin, xmax = float(xv.min()), float(xv.max())
        fin = ys[~np.isnan(ys)]
        ymin, ymax = float(fin.min()), float(fin.max())

        for t in _nice_ticks(xmin, xmax):
            if not (xmin <= t <= xmax):
                continue
            xx = int(round(x0 + (t - xmin) / (xmax - xmin) * (x1 - x0)))
            img[y0:y1 + 1, xx] = gridc
            img[y1 + 1:y1 + 4, xx] = black
            lab = "%.0f" % (10 ** t) if xlog else _fmt(t)
            _draw_text(img, max(0, xx - 6), y1 + 6, lab, black, 1)
        for t in _nice_ticks(ymin, ymax, 3):
            if not (ymin <= t <= ymax):
                continue
            yy = int(round(y1 - (t - ymin) / (ymax - ymin) * (y1 - y0)))
            img[yy, x0:x1 + 1] = gridc
            img[yy, x0 - 3:x0] = black
            lab = _fmt(t)
            _draw_text(img, max(0, x0 - 5 - 8 * len(lab)), yy - 3, lab, black, 1)

        _draw_text(img, x0 + 4, y0 - 16, title, black, 2)
        if len(xlab):
            _draw_text(img, x0 + 8, y1 + 30, xlab, black, 2)
        if len(ylab):
            _draw_text(img, 6, max(8, y0 - 60), ylab, black, 2)
        _plot_xy(img, x0 + 2, x1 - 2, y0 + 2, y1 - 2,
                 (10 ** xv) if xlog else xv, ys, color, pad=1)

    rep_i, rep_j = IP3_LEVELS.index(0.2434), CHANNEL_COUNTS.index(20)
    tr = CA_TRACES["ip3%d_N%d" % (rep_i, rep_j)][0]
    tvec = np.arange(N_SAMPLES) * DT_OUT
    panel(90, 630, 80, 470,
          "Ca trace  (IP3=%.4f uM, N=%d)" % (IP3_LEVELS[rep_i], CHANNEL_COUNTS[rep_j]),
          "time (s)", "Ca (uM)", tvec, tr, blue)
    panel(690, 1260, 80, 470, "Period vs IP3", "IP3 (uM)", "period (s)",
          IP3_LEVELS, np.array(period_vs_ip3), green)
    panel(90, 630, 540, 930, "CV vs N", "N", "CV",
          np.array(CHANNEL_COUNTS), np.array(cv_isi_vs_N), red, xlog=True)
    panel(690, 1260, 540, 930, "P_open vs IP3", "IP3 (uM)", "P_open",
          IP3_LEVELS, np.array(p_open_vs_ip3), purple)

    _write_png("calcium_summary.png", img)


