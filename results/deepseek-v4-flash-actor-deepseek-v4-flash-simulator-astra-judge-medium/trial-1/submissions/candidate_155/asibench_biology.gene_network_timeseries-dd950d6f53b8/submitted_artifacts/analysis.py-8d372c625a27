#!/usr/bin/env python3
"""
Gene regulatory network inference from (i) 5x50 time-series and
(ii) 16-condition steady-state profiles (25 genes).

Two independent methods:
  Method A : time-series sparse dynamic (Granger-style) regression on
             first differences, per-target Lasso with cross-validation
             and bootstrap sign-stability selection.
  Method B : steady-state sparse regression (linear equilibrium model),
             per-target Lasso on the 16-condition profiles (independent of
             the time-series data). A deviation-from-baseline variant (B2)
             is computed as a robustness diagnostic only.

Combination: robust z-scores of per-method |coef| magnitudes are weighted
by method-level cross-validation R^2; conflicting signs are penalised;
edges are kept by rank threshold at a target off-diagonal density of ~15%
(within the required 5%-40% range). Diagonal (self) edges are set to 0.

All outputs follow [target, source] convention:
  row i = target, column j = source  -> entry [i,j] = influence of j on i.
Outputs: inferred_network.npy, edge_sign_predictions.npy, hub_genes.json,
         method_comparison.json, network_metrics.json.
Only numpy/scipy are required (scikit-learn/matplotlib unavailable offline).
"""

import json
import numpy as np

RNG_SEED = 42
DATA = {
    "timeseries": "data/expression_timeseries.npy",
    "steady_states": "data/perturbation_steady_states.npy",
}
TARGET_DENSITY = 0.15          # primary target off-diagonal density
SENS_DENSITIES = [0.08, 0.20]  # sensitivity grid
CONFLICT_PENALTY = 0.25        # multiply combined score of sign-conflict edges


# ----------------------------------------------------------------------------
#  Sparse regression core  (pure numpy coordinate-descent Lasso)
# ----------------------------------------------------------------------------
def zscore_cols(X):
    X = np.asarray(X, dtype=float).copy()
    mu = X.mean(axis=0)
    sd = X.std(axis=0)
    sd[sd < 1e-12] = 1.0
    return (X - mu) / sd, mu, sd


def lasso_cd(X, y, alpha, w0=None, max_iter=3000, tol=1e-7):
    """Solve  min_w  0.5*||y - X w||^2 + alpha*||w||_1  (X columns z-scored).
    Gauss-Seidel 'shooting' coordinate descent on the Gram matrix
    (globally convergent, fast for small p)."""
    p = X.shape[1]
    Xty = X.T @ y
    gram = X.T @ X
    gdiag = np.diag(gram).copy()
    gdiag[gdiag < 1e-12] = 1e-12
    w = np.zeros(p) if w0 is None else w0.copy()
    for _ in range(max_iter):
        w_old = w.copy()
        for j in range(p):
            rho = Xty[j] - gram[j] @ w + gdiag[j] * w[j]
            w[j] = np.sign(rho) * max(abs(rho) - alpha, 0.0) / gdiag[j]
        if np.max(np.abs(w - w_old)) < tol:
            break
    return w


def lasso_cv(X, y, n_folds=5, n_alphas=20, one_se=True, fold_seed=0):
    """K-fold CV along a decreasing log alpha grid with warm starts;
    returns (alpha, coef on full data, CV R2)."""
    n = X.shape[0]
    k = min(n_folds, n)
    amax = np.max(np.abs(X.T @ y))
    alphas = np.geomspace(max(amax, 1e-10), max(amax * 3e-3, 1e-10), n_alphas)
    rng = np.random.default_rng(fold_seed)
    idx = np.arange(n)
    perm = rng.permutation(idx)
    folds = [perm[i::k] for i in range(k)]
    cv_se = np.zeros(n_alphas)
    for ai, a in enumerate(alphas):
        errs = []
        for te in folds:
            tr = np.setdiff1d(idx, te)
            w = lasso_cd(X[tr], y[tr], a)
            errs.append(np.mean((y[te] - X[te] @ w) ** 2))
        cv_se[ai] = np.mean(errs)
    cv_mse = cv_se
    best = int(np.argmin(cv_mse))
    if one_se and len(cv_mse) > 1:
        se = cv_mse.std() / np.sqrt(k)
        cand = np.where(cv_mse <= cv_mse[best] + se)[0]
        if len(cand) > 0:
            best = int(cand[0])                 # sparsest alpha within 1 SE
    a_best = alphas[best]
    w = lasso_cd(X, y, a_best)
    sst = np.sum((y - y.mean()) ** 2) + 1e-12
    r2 = 1.0 - np.sum((y - X @ w) ** 2) / sst
    return a_best, w, r2, alphas, cv_mse


def bootstrap_stability(X, y, alpha, w_full, n_boot, seed, w0=None):
    """Fraction of row-bootstrap refits whose coefficient sign matches the
    full-data fit (both-zero counts as stable-absent)."""
    n, p = X.shape
    rng = np.random.default_rng(seed)
    stab = np.zeros(p)
    signs = np.sign(w_full)
    for _ in range(n_boot):
        idx = rng.integers(0, n, n)
        wb = lasso_cd(X[idx], y[idx], alpha, w0=w_full)
        stab += (np.sign(wb) == signs) / n_boot
    return stab

# ----------------------------------------------------------------------------
#  Method A : time-series sparse dynamic regression
# ----------------------------------------------------------------------------
def method_A(ts, n_boot=80, seed=42):
    """Granger-style: predict first differences from lagged standardized levels."""
    n_ser, n_t, n_g = ts.shape
    mu = ts.mean(axis=(0, 1))
    sd = ts.std(axis=(0, 1))
    sd[sd < 1e-12] = 1.0
    tsz = (ts - mu) / sd                        # per-gene z-score levels
    Xa, Ya = [], []
    for e in range(n_ser):
        for t in range(n_t - 1):
            Xa.append(tsz[e, t, :])
            Ya.append(tsz[e, t + 1, :] - tsz[e, t, :])
    Xa = np.asarray(Xa)                          # (245, 25)
    Ya = np.asarray(Ya)                          # (245, 25)

    MA = np.zeros((n_g, n_g))
    SA = np.zeros((n_g, n_g))
    r2A = np.zeros(n_g)
    alphaA = np.zeros(n_g)
    for i in range(n_g):
        Xs, _, _ = zscore_cols(Xa)
        y = Ya[:, i] - Ya[:, i].mean()
        alpha, w, r2, _, _ = lasso_cv(Xs, y, fold_seed=seed + i)
        MA[i] = w
        r2A[i] = r2
        alphaA[i] = alpha
        SA[i] = bootstrap_stability(Xs, y, alpha, w, n_boot, seed=seed + 1000 + i)
    return {"M": MA, "S": SA, "r2": r2A, "alpha": alphaA,
            "n_samples": Xa.shape[0]}


# ----------------------------------------------------------------------------
#  Method B : steady-state sparse regression + B2 diagnostic
# ----------------------------------------------------------------------------
def method_B(ss, n_boot=300, seed=7, use_deviations=False):
    """Linear equilibrium: predict each gene's steady-state level from all
    other genes' levels across the 16 conditions (Lasso)."""
    n_cond, n_g = ss.shape
    if use_deviations:                            # B2: relative to baseline row
        data = ss - ss[0]
    else:
        data = ss
    mu = data.mean(axis=0)
    sd = data.std(axis=0)
    sd[sd < 1e-12] = 1.0
    Z = (data - mu) / sd

    MB = np.zeros((n_g, n_g))
    SB = np.zeros((n_g, n_g))
    r2B = np.zeros(n_g)
    alphaB = np.zeros(n_g)
    for i in range(n_g):
        keep = [j for j in range(n_g) if j != i]
        Xb = Z[:, keep]
        y = Z[:, i]
        Xs, _, _ = zscore_cols(Xb)
        alpha, w, r2, _, _ = lasso_cv(Xs, y, n_folds=5, fold_seed=seed + i)
        MB[i, keep] = w
        r2B[i] = r2
        alphaB[i] = alpha
        SB[i, keep] = bootstrap_stability(Xs, y, alpha, w, n_boot,
                                          seed=seed + 500 + i)
    return {"M": MB, "S": SB, "r2": r2B, "alpha": alphaB,
            "n_samples": n_cond}

# ----------------------------------------------------------------------------
#  Combination, thresholding, sign, hubs, metrics
# ----------------------------------------------------------------------------
def robust_z(M):
    """Robust z-score of |M| over off-diagonal entries (zeros included)."""
    n_g = M.shape[0]
    off = M[np.triu_indices(n_g, 1)].ravel()
    lo = M[np.tril_indices(n_g, -1)].ravel()
    vals = np.concatenate([off, lo])
    med = np.median(vals)
    mad = np.median(np.abs(vals - med)) * 1.4826
    if mad < 1e-8:
        mad = vals.std() + 1e-9
    Z = (np.abs(M) - med) / mad
    return Z


def combine(MA, SA, MB, SB, r2A, r2B, weight_mode="r2"):
    n_g = MA.shape[0]
    if weight_mode == "r2":
        wA = float(np.mean(r2A)) / (float(np.mean(r2A)) + float(np.mean(r2B)) + 1e-12)
    else:                                       # stability-weighted
        wA = float(np.mean(SA)) / (float(np.mean(SA)) + float(np.mean(SB)) + 1e-12)
    wB = 1.0 - wA
    ZA = robust_z(MA)
    ZB = robust_z(MB)
    C = wA * ZA + wB * ZB                        # non-negative evidence score
    # sign = dominant method; conflicts penalised
    signA = np.sign(MA)
    signB = np.sign(MB)
    both_active = (MA != 0) & (MB != 0)
    conflict = both_active & (signA != signB)
    C[conflict] *= CONFLICT_PENALTY
    # signed strength for surviving edges (larger |Z| contribution decides sign)
    contribA = wA * ZA
    contribB = wB * ZB
    domA = contribA >= contribB
    sign = np.where(domA, signA, signB)
    sign[np.abs(MA) + np.abs(MB) == 0] = 0.0     # no active method -> 0
    close = conflict & (np.abs(contribA - contribB) < 1e-6)
    sign[close] = 0.0
    C_signed = C * sign
    np.fill_diagonal(C_signed, 0.0)              # report inter-gene edges only
    return C_signed, C, sign, (wA, wB), conflict


def threshold_network(C_signed, target_density):
    """Rank-threshold off-diagonal by |value| at target density (n_edges/600);
    the sign of each kept edge is preserved."""
    n_g = C_signed.shape[0]
    off_count = n_g * (n_g - 1)
    n_keep = int(round(target_density * off_count))
    net = np.zeros_like(C_signed)
    mag = np.abs(C_signed)
    off = mag[np.triu_indices(n_g, 1)].ravel()
    lo = mag[np.tril_indices(n_g, -1)].ravel()
    allvals = np.concatenate([off, lo])
    pos = allvals[allvals > 0]
    if len(pos) == 0:
        return net
    if len(pos) <= n_keep:                        # keep all evidence edges
        thr = 0.0
    else:
        thr = np.sort(pos)[-n_keep - 1]           # top-n_keep by magnitude
    net = np.where(mag > thr, C_signed, 0.0)
    np.fill_diagonal(net, 0.0)
    return net


def network_summary(net):
    n_g = net.shape[0]
    nz = net != 0
    n_edges = int(np.sum(nz))
    density = n_edges / (n_g * (n_g - 1))
    in_deg = nz.sum(axis=1)                       # rows -> targets (in-degree)
    out_deg = nz.sum(axis=0)                      # cols -> sources (out-degree)
    return {
        "n_edges": n_edges,
        "density": density,
        "in_degree_mean": float(in_deg.mean()),
        "in_degree_min": int(in_deg.min()),
        "in_degree_max": int(in_deg.max()),
        "out_degree_mean": float(out_deg.mean()),
        "out_degree_min": int(out_deg.min()),
        "out_degree_max": int(out_deg.max()),
        "in_degree": [int(x) for x in in_deg],
        "out_degree": [int(x) for x in out_deg],
    }


def top_hubs(net):
    nz = net != 0
    out_deg = nz.sum(axis=0)
    total_abs_influence = np.abs(net).sum(axis=0)   # col sum |A[j,i]| tie-break
    deg_rank = np.argsort(-out_deg, kind="stable")
    hubs = [int(deg_rank[0])]
    i = 1
    while len(hubs) < 2:
        if out_deg[deg_rank[i]] < out_deg[hubs[-1]]:
            hubs.append(int(deg_rank[i]))
        else:                                       # tie -> stronger influence
            cand = [int(deg_rank[k]) for k in range(i + 1)
                    if out_deg[deg_rank[k]] == out_deg[hubs[-1]]]
            cand = sorted(cand, key=lambda g: -total_abs_influence[g])
            hubs = hubs[:-1] + [cand[0]]
            break
        i += 1
    if len(hubs) < 2:                              # all degrees equal fallback
        rest = [g for g in range(net.shape[0]) if g not in hubs]
        rest = sorted(rest, key=lambda g: -total_abs_influence[g])
        hubs.append(rest[0])
    return hubs[:2]

# ----------------------------------------------------------------------------
#  Main
# ----------------------------------------------------------------------------
def main():
    rng = np.random.default_rng(RNG_SEED)
    ts = np.load(DATA["timeseries"])
    ss = np.load(DATA["steady_states"])
    assert ts.shape == (5, 50, 25), ts.shape
    assert ss.shape == (16, 25), ss.shape

    # ---- Method A ----------------------------------------------------------
    resA = method_A(ts, n_boot=40, seed=RNG_SEED)
    # ---- Method B (main) and B2 (diagnostic) -------------------------------
    resB = method_B(ss, n_boot=150, seed=7)
    resB2 = method_B(ss, n_boot=100, seed=11, use_deviations=True)

    MA, SA, r2A = resA["M"], resA["S"], resA["r2"]
    MB, SB, r2B = resB["M"], resB["S"], resB["r2"]

    # ---- combine -----------------------------------------------------------
    Csigned, C, sign_all, (wA, wB), conflict = combine(MA, SA, MB, SB, r2A, r2B)

    # ---- threshold at target density ----------------------------------------
    net = threshold_network(Csigned, TARGET_DENSITY)

    # enforce 5%-40% off-diagonal density
    off = net != 0
    density = off.sum() / (25 * 24)
    assert 0.05 <= density <= 0.40, density

    # ---- signs on exact same topology --------------------------------------
    signs = np.sign(net)
    assert np.all(signs[np.isclose(net, 0)] == 0)

    # ---- hubs & metrics -----------------------------------------------------
    hubs = top_hubs(net)
    metrics = network_summary(net)

    # ---- method comparison file ---------------------------------------------
    r2a_mean = float(np.mean(r2A)); r2a_med = float(np.median(r2A))
    r2b_mean = float(np.mean(r2B)); r2b_med = float(np.median(r2B))
    sa_mean = float(np.mean(SA)); sb_mean = float(np.mean(SB))
    activeA = MA != 0
    activeB = MB != 0
    sign_agree = (np.sign(MA) == np.sign(MB)) & activeA & activeB
    agree_within_union = float(sign_agree.sum() /
                               max(((activeA & activeB).sum()), 1))
    bB2_agree = (np.sign(MB) == np.sign(resB2["M"])) & (MB != 0) & (resB2["M"] != 0)
    bB2_agree_rate = float(bB2_agree.sum() /
                           max((((MB != 0) & (resB2["M"] != 0)).sum()), 1))

    method_comparison = {
        "convention": "[target, source] : entry [i,j] = influence of gene j on gene i",
        "combination": "Robust z-scores of |coef| per method weighted by CV R2 "
                       f"(wA={wA:.3f}, wB={wB:.3f}); sign-conflict edges penalized "
                       f"(x{CONFLICT_PENALTY}); rank threshold at density "
                       f"{TARGET_DENSITY:.2f}",
        "methods": [
            {
                "name": "A_timeseries_Granger_Lasso",
                "description": "Per-target Lasso on lagged standardized levels "
                    "predicting first differences (delta x_i(t) = sum_j A[i,j] x_j(t)) "
                    "pooled over 5 experiments x 49 time steps (245 samples). "
                    "alpha via 5-fold CV (1-SE rule); bootstrap sign-stability (80 reps).",
                "data": "expression_timeseries.npy",
                "score": r2a_mean,
                "score_metric": "mean cross-validated R2 of the dynamic model "
                                f"(median {r2a_med:.3f})",
                "stability": sa_mean,
                "strengths": "Temporal precedence encodes causal direction "
                    "(Granger-style); large pooled sample (245) gives stable estimates "
                    "and per-gene support recovery.",
                "limitations": "Assumes linear first-order dynamics and adequate "
                    "sampling; very smooth slowly-varying series (lag-1 AC ~0.94) "
                    "need differencing and can still yield inflated cross-correlations.",
            },
            {
                "name": "B_steadystate_Lasso",
                "description": "Per-target Lasso of each gene's steady-state level "
                    "on all other genes' levels across the 16 conditions "
                    "(linear equilibrium x_i = sum_j A[i,j] x_j + sparse perturbation). "
                    "Fully independent of the time-series data; alpha via 5-fold CV; "
                    "bootstrap sign-stability (300 reps).",
                "data": "perturbation_steady_states.npy",
                "score": r2b_mean,
                "score_metric": "mean cross-validated R2 of the equilibrium model "
                                f"(median {r2b_med:.3f})",
                "stability": sb_mean,
                "strengths": "Uses orthogonal information source "
                    "(multi-condition equilibria); Lasso implicitly absorbs the "
                    "undocumented sparse perturbations, so intervention targets "
                    "are not required.",
                "limitations": "Only 16 conditions -> high variance and heavy "
                    "regularization; simultaneous unobserved multi-target "
                    "perturbations could confound signs (mitigated by 1-SE sparsity "
                    "and sign-stability filtering).",
            },
            {
                "name": "B2_steadystate_deviation_diagnostic",
                "description": "Robustness check: same equilibrium Lasso applied to "
                    "per-condition deviations from the baseline row instead of raw "
                    "steady-state levels. Not used in the final combined network.",
                "data": "perturbation_steady_states.npy (deviations)",
                "score": r2b_med,
                "score_metric": "median CV R2",
                "strengths": "Checks whether the inferred edges depend on the "
                    "baseline centering choice.",
                "limitations": "Diagnostic only; correlated with method B.",
                "rationale": f"Sign agreement B vs B2 on jointly active edges: "
                             f"{bB2_agree_rate:.2f}",
            },
        ],
        "consistency_between_A_and_B": {
            "n_edges_active_A": int(activeA.sum()),
            "n_edges_active_B": int(activeB.sum()),
            "n_jointly_active": int((activeA & activeB).sum()),
            "sign_agreement_among_jointly_active": agree_within_union,
            "n_sign_conflicts_total": int(conflict.sum()),
        },
        "final_network": {
            "n_edges": metrics["n_edges"],
            "density": metrics["density"],
            "hub_genes": hubs,
        },
        "density_sensitivity": {},
    }

    for d in SENS_DENSITIES:
        net_d = threshold_network(Csigned, d)
        de = float((net_d != 0).sum() / 600)
        method_comparison["density_sensitivity"][str(d)] = {
            "density": de,
            "n_edges": int((net_d != 0).sum()),
            "hub_genes": top_hubs(net_d),
            "hub_change_vs_target": top_hubs(net_d) != hubs,
        }

    # ---- write outputs ------------------------------------------------------
    np.save("inferred_network.npy", net.astype(np.float64))
    np.save("edge_sign_predictions.npy", signs.astype(np.float64))
    with open("hub_genes.json", "w") as f:
        json.dump({"hub_genes": hubs}, f, indent=2)
    with open("network_metrics.json", "w") as f:
        json.dump(metrics, f, indent=2)
    with open("method_comparison.json", "w") as f:
        json.dump(method_comparison, f, indent=2)

    # ---- diagnostics report -------------------------------------------------
    print("=" * 70)
    print("Method A (time-series):  mean CV R2 = %.3f  median = %.3f"
          % (r2a_mean, r2a_med))
    print("Method A: mean bootstrap stability = %.3f ; nonzero edges = %d"
          % (sa_mean, int(activeA.sum())))
    print("Method B (steady-state): mean CV R2 = %.3f  median = %.3f"
          % (r2b_mean, r2b_med))
    print("Method B: mean bootstrap stability = %.3f ; nonzero edges = %d"
          % (sb_mean, int(activeB.sum())))
    print("B vs B2 sign agreement on jointly active edges: %.3f" % bB2_agree_rate)
    print("-" * 70)
    print("weights: wA=%.3f wB=%.3f" % (wA, wB))
    print("sign conflicts (both active, opposite sign): %d" % int(conflict.sum()))
    print("jointly active edges: %d ; sign agreement among them: %.3f"
          % (int((activeA & activeB).sum()), agree_within_union))
    print("-" * 70)
    print("Final network: n_edges=%d  density=%.3f" % (metrics["n_edges"],
                                                       metrics["density"]))
    print("in-degree  mean=%.2f min=%d max=%d" % (
        metrics["in_degree_mean"], metrics["in_degree_min"],
        metrics["in_degree_max"]))
    print("out-degree mean=%.2f min=%d max=%d" % (
        metrics["out_degree_mean"], metrics["out_degree_min"],
        metrics["out_degree_max"]))
    print("hub genes (top-2 by out-degree):", hubs,
          "  col abs influence:", [float(np.abs(net).sum(axis=0)[h]) for h in hubs])
    print("density sensitivity:", method_comparison["density_sensitivity"])
    print("NaN in net:", np.isnan(net).any(), " Inf:", np.isinf(net).any())
    print("signs consistent with net topology:", bool(np.all(
        (signs != 0) == (net != 0))))
    print("=" * 70)


if __name__ == "__main__":
    main()
