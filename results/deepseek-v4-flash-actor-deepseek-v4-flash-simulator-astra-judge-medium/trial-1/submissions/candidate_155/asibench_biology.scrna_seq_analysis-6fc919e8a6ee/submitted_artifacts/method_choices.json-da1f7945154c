  },
  "grn_scores": {
    "method": "directed OLS regression scores among the first n_tf_genes TF columns (log-normalised)",
    "details": "grn_scores[i,j] = t-value of TF i as regressor of TF j (edge i -> j); regressor set = all TFs EXCLUDING the target j (prevents self-prediction collapse); diagonal i==j set to 0 (ignored)",
    "justification": "asymmetric marginal predictive contribution gives a directed, signed score; correlation-based measures are symmetric and not directional"
