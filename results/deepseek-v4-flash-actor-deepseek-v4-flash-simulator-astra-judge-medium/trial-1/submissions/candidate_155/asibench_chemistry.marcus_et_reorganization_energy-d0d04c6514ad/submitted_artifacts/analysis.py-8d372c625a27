#!/usr/bin/env python3
"""
analysis.py  —  solution-phase electron-transfer response calculation.
Reads the nine inputs in data/ and writes the ten required outputs under results/.
Method:
  * Coordinates and Hessians are re-ordered to ascending site_id order using
    data/frame_site_order.csv (raw rows are frame-specific).
  * The frames are not in a shared Cartesian frame and their per-frame site labels
    are arbitrary; the physical atom correspondence is found by an exhaustive
    rigid-body (Kabsch) match over the 7! permutations of the 7 sites (unique
    minimum, RMSD ~0.071 Angstrom).
  * Forward: frame B placed in frame A (reference target = A), displacement =
    aligned_B - A. Backward: A placed in B, displacement = aligned_A - B. All signed
    displacement-like outputs use "aligned source minus reference target", ascending
    site order.
  * Vibrations: H_mw = M^{-1/2} H M^{-1/2} (M amu, H eV/A^2); 6 null modes dropped,
    15 vibrational modes retained. mode_overlap magnitude-based (sign-insensitive).
  * Inner lambda: four-point 0.5*(V_A(xB)+V_B(xA)) fwd/bwd; normal-mode per frame;
    effective = 0.5*(nm_fwd+nm_bwd). Outer: two-sphere Marcus
    e^2/(8 pi eps0)(1/r1+1/r2-2/R)(1/eps_fast-1/eps_slow), R=span_A. total = inner+outer.
  * Marcus nonadiabatic (semiclassical) rate over the 61 grid rows (order preserved),
    driving-force axis = DeltaG.
"""
import json
import numpy as np
import pandas as pd
try:
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt
    HAVE_MPL = True
except Exception:
    HAVE_MPL = False

EV = 1.602176634e-19
HBAR = 1.054571817e-34
KB = 1.380649e-23
EPS0 = 8.8541878128e-12
FREQ_SCALE = 521.4708983725066

# --------------------------------------------------------------- 1. inputs
def parse_inputs(data_dir="data"):
    site = pd.read_csv(f"{data_dir}/site_table.csv")
    m = site["mass_amu"].to_numpy(float)
    order = pd.read_csv(f"{data_dir}/frame_site_order.csv")
    manifest = json.load(open(f"{data_dir}/system_manifest.json"))
    medium = json.load(open(f"{data_dir}/medium_response.json"))
    grid = pd.read_csv(f"{data_dir}/driving_force_grid.csv")
    row2site = {}
    for f in ("frame_a", "frame_b"):
        sub = order[order.frame_id == f].sort_values("row_index")
        row2site[f] = sub["site_id"].to_numpy(int)
    coords = {"frame_a": np.load(f"{data_dir}/frame_a_coords.npy"),
              "frame_b": np.load(f"{data_dir}/frame_b_coords.npy")}
    hess = {"frame_a": np.load(f"{data_dir}/frame_a_hessian.npy"),
            "frame_b": np.load(f"{data_dir}/frame_b_hessian.npy")}
    return m, row2site, coords, hess, manifest, medium, grid


def reorder_to_site(coords, hess, row2site, key):
    asc_idx = np.argsort(row2site[key])
    assert (row2site[key][asc_idx] == np.arange(7)).all()
    c = coords[key][asc_idx]
    p21 = (asc_idx[:, None] * 3 + np.arange(3)).ravel()
    h = hess[key][np.ix_(p21, p21)]
    return c, h

# --------------------------------------------------------------- 2. rigid align
def kabsch(P, Q):
    Pc = P - P.mean(0); Qc = Q - Q.mean(0)
    H = Pc.T @ Qc
    U, _, Vt = np.linalg.svd(H)
    d = np.sign(np.linalg.det(Vt.T @ U.T))
    R = Vt.T @ np.diag([1.0, 1.0, d]) @ U.T
    t = Q.mean(0) - R @ P.mean(0)
    return R, t


def find_correspondence(Ca, Cb):
    from itertools import permutations
    best = (1e18, None)
    for p in permutations(range(7)):
        R, t = kabsch(Cb[list(p)], Ca)
        r = np.sqrt(np.mean(np.sum((R @ Cb[list(p)].T + t[:, None] - Ca.T).T ** 2, axis=1)))
        if r < best[0]:
            best = (r, p)
    return np.array(best[1]), best[0]

# --------------------------------------------------------------- 3. normal modes
def normal_modes(H, m, n_mode=15, tol=1e-6):
    Mnsq = np.repeat(1.0 / np.sqrt(m), 3)
    Hmw = Mnsq[:, None] * H * Mnsq[None, :]
    w, L = np.linalg.eigh(Hmw)
    keep = w > tol
    assert keep.sum() == n_mode
    return w[keep], L[:, keep], Hmw


# --------------------------------------------------------------- overview figure
def _mpl_overview(Ca, baligned, rmsd_f, mode_projection, mode_overlap, axis, kET,
                  peak_axis, peak_grid, inverted, first_inv_axis,
                  aligned_displacement_mw, transported_mode_projection, n_atom):
    fig, ax = plt.subplots(2, 3, figsize=(16, 9))
    ax[0, 0].scatter(Ca[:, 0], Ca[:, 1], s=90, c="tab:blue", label="frame A (target)")
    ax[0, 0].scatter(baligned[:, 0], baligned[:, 1], s=60, marker="x", c="tab:red",
                     label="frame B aligned")
    for i in range(n_atom):
        ax[0, 0].annotate(str(i), (Ca[i, 0], Ca[i, 1]))
    ax[0, 0].set_title(f"Aligned structures (RMSD {rmsd_f:.4f} A)")
    ax[0, 0].legend(); ax[0, 0].set_xlabel("x (A)"); ax[0, 0].set_ylabel("y (A)")
    x = np.arange(15)
    ax[0, 1].bar(x - 0.2, mode_projection[0, :, 1], 0.4, label="forward (A modes)")
    ax[0, 1].bar(x + 0.2, mode_projection[1, :, 1], 0.4, label="backward (B modes)")
    ax[0, 1].set_title("Per-mode inner reorg. energy (eV)")
    ax[0, 1].set_xlabel("retained mode index"); ax[0, 1].legend()
    im = ax[0, 2].imshow(mode_overlap[0], cmap="viridis")
    ax[0, 2].set_title("|Mode overlap| (A x B)")
    ax[0, 2].set_xlabel("B mode"); ax[0, 2].set_ylabel("A mode")
    fig.colorbar(im, ax=ax[0, 2], fraction=0.046)
    ax[1, 0].semilogy(axis, np.maximum(kET, 1e-20), "o-", ms=4, alpha=0.7)
    ax[1, 0].axvline(peak_axis, c="r", ls="--", label=f"peak {peak_axis:.3f} eV")
    if inverted:
        ax[1, 0].axvspan(first_inv_axis, axis.max(), color="orange", alpha=0.15,
                         label="inverted region")
    ax[1, 0].set_title("Marcus rate vs driving force (DeltaG, eV)")
    ax[1, 0].set_xlabel("axis_eV"); ax[1, 0].set_ylabel("k_et (s^-1)"); ax[1, 0].legend()
    ax[1, 1].plot(aligned_displacement_mw[0], "o-", label="forward (B-A)")
    ax[1, 1].plot(aligned_displacement_mw[1], "s-", label="backward (A-B)")
    ax[1, 1].set_title("Mass-weighted aligned displacement (21 comps)")
    ax[1, 1].set_xlabel("coordinate index"); ax[1, 1].legend()
    ax[1, 2].bar(x - 0.2, transported_mode_projection[0, :, 0], 0.4,
                 label="fwd transported B modes")
    ax[1, 2].bar(x + 0.2, transported_mode_projection[1, :, 0], 0.4,
                 label="bwd transported A modes")
    ax[1, 2].set_title("Transported-mode signed projections Q")
    ax[1, 2].set_xlabel("mode index"); ax[1, 2].legend()
    fig.suptitle("solution-phase electron-transfer response - analysis overview")
    fig.tight_layout()
    fig.savefig("results/overview.png", dpi=110)
    plt.close(fig)


def _raster_overview(Ca, baligned, rmsd_f, mode_projection, mode_overlap, axis, kET,
                     peak_axis, peak_grid, inverted, first_inv_axis,
                     aligned_displacement_mw, transported_mode_projection, n_atom):
    from plot_utils import (write_png, put_text, text_width, viridis, fill_rect,
                            draw_line, draw_circle, draw_x, heatmap_into)
    W, H = 1800, 1200
    canvas = np.full((H, W, 3), 16, dtype=np.uint8)
    WHITE = (235, 235, 235); RED = (220, 60, 60); BLUE = (70, 120, 220)
    GREEN = (60, 190, 110); ORANGE = (230, 160, 40); YELLOW = (235, 225, 70)

    def panel(x0, y0, x1, y1, title):
        fill_rect(canvas, x0, y0, x1, y1, (20, 20, 24))
        draw_line(canvas, (x0, y0), (x1, y0), (60, 60, 70), 2)
        draw_line(canvas, (x1, y0), (x1, y1), (60, 60, 70), 2)
        draw_line(canvas, (x1, y1), (x0, y1), (60, 60, 70), 2)
        draw_line(canvas, (x0, y1), (x0, y0), (60, 60, 70), 2)
        put_text(canvas, title, x0 + 10, y0 + 8, WHITE, scale=2)
        return (x0 + 15, y0 + 30, x1 - 15, y1 - 15)

    def axes(area, xr, yr):
        x0, y0, x1, y1 = area
        for t in np.linspace(0, 1, 5):
            px = int(x0 + t * (x1 - x0)); py = int(y0 + (1 - t) * (y1 - y0))
            draw_line(canvas, (px, y1 - 3), (px, y1 + 3), (120, 120, 130), 1)
            draw_line(canvas, (x0 - 3, py), (x0 + 3, py), (120, 120, 130), 1)
        draw_line(canvas, (x0, y1), (x1, y1), (150, 150, 160), 2)
        draw_line(canvas, (x0, y0), (x0, y1), (150, 150, 160), 2)
        def mapx(v): return int(x0 + (v - xr[0]) / (xr[1] - xr[0] + 1e-12) * (x1 - x0))
        def mapy(v):
            log = False
            return int(y1 - (v - yr[0]) / (yr[1] - yr[0] + 1e-12) * (y1 - y0))
        return mapx, mapy

    # --- (0,0) aligned structures
    ar = panel(40, 40, 640, 460, "ALIGNED STRUCTURES (RMSD %.3f A)" % rmsd_f)
    allx = np.concatenate([Ca[:, 0], baligned[:, 0]])
    ally = np.concatenate([Ca[:, 1], baligned[:, 1]])
    xr = (allx.min() - 0.2, allx.max() + 0.2); yr = (ally.min() - 0.2, ally.max() + 0.2)
    put_text(canvas, "x (A)", 560, 470, (150, 150, 160), 1)
    put_text(canvas, "y (A)", 40, 110, (150, 150, 160), 1)
    for i in range(n_atom):
        mx, my = ar[0] + (Ca[i, 0] - xr[0]) / (xr[1] - xr[0]) * (ar[2] - ar[0]), \
                 ar[3] - (Ca[i, 1] - yr[0]) / (yr[1] - yr[0]) * (ar[3] - ar[1])
        draw_circle(canvas, (mx, my), 6, BLUE)
        bx, by = ar[0] + (baligned[i, 0] - xr[0]) / (xr[1] - xr[0]) * (ar[2] - ar[0]), \
                 ar[3] - (baligned[i, 1] - yr[0]) / (yr[1] - yr[0]) * (ar[3] - ar[1])
        draw_x(canvas, (bx, by), 5, RED)
        put_text(canvas, str(i), mx + 8, my - 16, YELLOW, 1)

    # --- (0,1) per-mode lambda bars
    ar = panel(680, 40, 1280, 460, "PER-MODE INNER LAMBDA (EV)")
    vals = np.concatenate([mode_projection[0, :, 1], mode_projection[1, :, 1]])
    vmax = vals.max()
    for i in range(15):
        h0 = mode_projection[0, i, 1] / vmax * (ar[3] - ar[1] - 20)
        h1 = mode_projection[1, i, 1] / vmax * (ar[3] - ar[1] - 20)
        bw = (ar[2] - ar[0]) / 15.0
        bx = ar[0] + i * bw
        fill_rect(canvas, bx + 2, ar[3] - h0, bx + bw / 2 - 2, ar[3], BLUE)
        fill_rect(canvas, bx + bw / 2 + 2, ar[3] - h1, bx + bw - 2, ar[3], RED)
        put_text(canvas, "%d" % i, bx + bw / 2 - 3, ar[3] + 6, (150, 150, 160), 1)

    # --- (0,2) mode overlap heatmap
    ar = panel(1320, 40, 1760, 460, "|MODE OVERLAP| (A x B)")
    heatmap_into(canvas, ar[0], ar[1], ar[2], ar[3], mode_overlap[0])
    put_text(canvas, "B MODE", ar[0] + 120, ar[3] + 6, (150, 150, 160), 1)
    put_text(canvas, "A MODE", 1760 - 130, ar[1] - 14, (150, 150, 160), 1)

    # --- (1,0) rate curve (semilog)
    ar = panel(40, 520, 640, 940, "MARCUS RATE VS DRIVING FORCE (EV)")
    logk = np.log10(np.maximum(kET, 1e-20))
    kmin, kmax = logk.min(), logk.max()
    xr = (axis.min(), axis.max())
    mx = lambda v: int(ar[0] + (v - xr[0]) / (xr[1] - xr[0]) * (ar[2] - ar[0]))
    my = lambda v: int(ar[3] - (v - kmin) / (kmax - kmin + 1e-12) * (ar[3] - ar[1]))
    draw_line(canvas, (ar[0], my(kmin)), (ar[2], my(kmin)), (150, 150, 160), 2)
    draw_line(canvas, (ar[0], my(kmax)), (ar[0], my(kmin)), (150, 150, 160), 2)
    if inverted:
        fill_rect(canvas, mx(first_inv_axis), ar[1], ar[2], ar[3], ORANGE)
    prev = None
    for a, y in zip(axis, logk):
        p = (mx(a), my(y))
        draw_circle(canvas, p, 3, WHITE)
        if prev is not None:
            draw_line(canvas, prev, p, GREEN, 2)
        prev = p
    px = mx(peak_axis)
    draw_line(canvas, (px, ar[1]), (px, ar[3]), RED, 2)
    put_text(canvas, "PEAK", px - 20, ar[3] + 6, RED, 1)
    put_text(canvas, "DELTA-G (EV)", ar[0] + 20, ar[3] + 8, (150, 150, 160), 1)

    # --- (1,1) aligned displacement (21 comps)
    ar = panel(680, 520, 1280, 940, "MW ALIGNED DISPLACEMENT (21 COMPS)")
    vals = np.concatenate([aligned_displacement_mw[0], aligned_displacement_mw[1]])
    lo, hi = vals.min(), vals.max()
    mx = lambda v: int(ar[0] + v / 20.0 * (ar[2] - ar[0]))
    my = lambda v: int(ar[3] - (v - lo) / (hi - lo + 1e-12) * (ar[3] - ar[1]))
    draw_line(canvas, (ar[0], my(0)), (ar[2], my(0)), (90, 90, 100), 1)
    prev = None
    for i, v in enumerate(aligned_displacement_mw[0]):
        p = (mx(i), my(v))
        draw_circle(canvas, p, 3, BLUE)
        draw_line(canvas, prev if prev else p, p, BLUE, 1); prev = p
    prev = None
    for i, v in enumerate(aligned_displacement_mw[1]):
        p = (mx(i), my(v))
        draw_circle(canvas, p, 3, RED)
        draw_line(canvas, prev if prev else p, p, RED, 1); prev = p
    put_text(canvas, "FORWARD (B-A) BLUE / BACKWARD (A-B) RED", ar[0], ar[3] + 8, (150, 150, 160), 1)

    # --- (1,2) transported-mode projections
    ar = panel(1320, 520, 1760, 940, "TRANSPORTED-MODE Q")
    vals = np.concatenate([transported_mode_projection[0, :, 0],
                           transported_mode_projection[1, :, 0]])
    vmax = vals.max()
    for i in range(15):
        h0 = transported_mode_projection[0, i, 0] / vmax * (ar[3] - ar[1] - 20)
        h1 = transported_mode_projection[1, i, 0] / vmax * (ar[3] - ar[1] - 20)
        bw = (ar[2] - ar[0]) / 15.0
        bx = ar[0] + i * bw
        fill_rect(canvas, bx + 2, ar[3] - h0, bx + bw / 2 - 2, ar[3], BLUE)
        fill_rect(canvas, bx + bw / 2 + 2, ar[3] - h1, bx + bw - 2, ar[3], RED)
    put_text(canvas, "FWD B-MODES BLUE / BWD A-MODES RED", ar[0], ar[3] + 8, (150, 150, 160), 1)

    put_text(canvas, "SOLUTION-PHASE ELECTRON-TRANSFER RESPONSE - OVERVIEW",
             40, H - 40, WHITE, 3)
    write_png("results/overview.png", canvas)


def make_overview(Ca, baligned, rmsd_f, mode_projection, mode_overlap, axis, kET,
                  peak_axis, peak_grid, inverted, first_inv_axis,
                  aligned_displacement_mw, transported_mode_projection, n_atom):
    if HAVE_MPL:
        _mpl_overview(Ca, baligned, rmsd_f, mode_projection, mode_overlap, axis, kET,
                      peak_axis, peak_grid, inverted, first_inv_axis,
                      aligned_displacement_mw, transported_mode_projection, n_atom)
    else:
        _raster_overview(Ca, baligned, rmsd_f, mode_projection, mode_overlap, axis, kET,
                         peak_axis, peak_grid, inverted, first_inv_axis,
                         aligned_displacement_mw, transported_mode_projection, n_atom)


# =========================================================== main pipeline
def main():
    import os
    os.makedirs("results", exist_ok=True)
    m, row2site, coords_in, hess_in, manifest, medium, grid = parse_inputs()
    Ca, Ha = reorder_to_site(coords_in, hess_in, row2site, "frame_a")
    Cb, Hb = reorder_to_site(coords_in, hess_in, row2site, "frame_b")
    n_atom = 7
    Mv = np.repeat(m, 3)
    Msq = np.sqrt(Mv)

    # ---- correspondence + forward alignment (B into A)
    perm, rmsd_f = find_correspondence(Ca, Cb)        # A k <-> B perm[k]
    Rf, tf = kabsch(Cb[perm], Ca)
    baligned = (Rf @ Cb[perm].T + tf[:, None]).T
    d_f = (baligned - Ca).ravel()
    Dq_f = d_f * Msq

    # ---- backward alignment (A into B)
    Rb, tb = kabsch(Ca, Cb[perm])
    a_in_b_frames = (Rb @ Ca.T + tb[:, None]).T
    A_in_B = np.empty_like(Cb)
    A_in_B[perm] = a_in_b_frames
    d_b = (A_in_B - Cb).ravel()
    Dq_b = d_b * Msq

    # ---- normal modes (ascending site order, mass-weighted)
    wA, LA, HmwA = normal_modes(Ha, m)
    wB, LB, HmwB = normal_modes(Hb, m)
    freqA = np.sqrt(wA) * FREQ_SCALE
    freqB = np.sqrt(wB) * FREQ_SCALE

    # ---- forward: projections onto target (A) modes
    qA_f = LA.T @ Dq_f
    lA_f = 0.5 * wA * qA_f ** 2
    proj_f = LA @ qA_f

    # ---- backward: projections onto target (B) modes
    qB_b = LB.T @ Dq_b
    lB_b = 0.5 * wB * qB_b ** 2
    proj_b = LB @ qB_b

    # ---- transport source modes into target frame
    inv_perm = np.argsort(perm)
    LBf = np.zeros_like(LB)
    for k in range(n_atom):
        j = perm[k]
        LBf[3 * k:3 * k + 3, :] = Rf @ LB[3 * j:3 * j + 3, :]
    qBf = LBf.T @ Dq_f
    lBf = 0.5 * wB * qBf ** 2
    LAb = np.zeros_like(LA)
    for j in range(n_atom):
        k = inv_perm[j]
        LAb[3 * j:3 * j + 3, :] = Rb @ LA[3 * k:3 * k + 3, :]
    qAb = LAb.T @ Dq_b
    lAb = 0.5 * wA * qAb ** 2

    # ---- normal-mode vs four-point inner lambda
    nm_f = lA_f.sum()
    nm_b = lB_b.sum()
    V_A_xB = 0.5 * Dq_f @ HmwA @ Dq_f
    V_B_xA = 0.5 * Dq_b @ HmwB @ Dq_b
    lam4_f = 0.5 * (V_A_xB + V_B_xA)
    lam4_b = 0.5 * (V_A_xB + V_B_xA)
    inner_eff = 0.5 * (nm_f + nm_b)

    # ---- outer (two-sphere Marcus) lambda
    r1, r2, R_ = medium["shell_0_A"], medium["shell_1_A"], medium["span_A"]
    ep, es = medium["eps_fast"], medium["eps_slow"]
    lam_out = (EV ** 2 / (8 * np.pi * EPS0)) * (1.0 / r1 + 1.0 / r2 - 2.0 / R_) * 1e10 * \
              (1.0 / ep - 1.0 / es) / EV
    lam_tot = inner_eff + lam_out

    # ---- rate curve (semiclassical Marcus), grid rows preserved
    Vc = medium["coupling_eV"] * EV
    kT = KB * medium["temp_K"]
    lamJ = lam_tot * EV
    pref = (2.0 * np.pi / HBAR) * Vc ** 2 / np.sqrt(4.0 * np.pi * lamJ * kT)
    axis = grid["axis_eV"].to_numpy(float)
    expo = -(lam_tot + axis) ** 2 / (4.0 * lam_tot * medium["temp_K"] * (KB / EV))
    kET = pref * np.exp(expo)
    grid_out = pd.DataFrame({
        "grid_id": grid["grid_id"],
        "axis_eV": axis,
        "k_et_s_inv": kET,
        "log10_k_et_s_inv": np.log10(np.maximum(kET, 1e-300)),
    })
    k_self = pref * np.exp(-lam_tot / (4.0 * medium["temp_K"] * (KB / EV)))

    # ---- diagnostics
    rmsd_b = np.sqrt(np.mean(np.sum((a_in_b_frames - Cb[perm]) ** 2, axis=1)))
    rigid_norm_f = float(np.linalg.norm(Dq_f)); rigid_norm_b = float(np.linalg.norm(Dq_b))
    proj_norm_f = float(np.linalg.norm(proj_f)); proj_norm_b = float(np.linalg.norm(proj_b))
    dom_f = int(np.argmax(lA_f)); dom_b = int(np.argmax(lB_b))

    srt = np.argsort(axis)
    k_s = kET[srt]; axis_s = axis[srt]; gid_s = grid["grid_id"].to_numpy()[srt]
    peak_s = int(np.argmax(k_s))
    peak_grid = int(gid_s[peak_s]); peak_axis = float(axis_s[peak_s]); peak_k = float(k_s[peak_s])
    inv_idx = None
    for i in range(peak_s + 1, len(k_s) - 1):
        if k_s[i] < k_s[i - 1]:
            inv_idx = i
            break
    if inv_idx is None and peak_s < len(k_s) - 1:
        inv_idx = peak_s + 1
    inverted = inv_idx is not None
    first_inv_grid = int(gid_s[inv_idx]) if inv_idx is not None else None
    first_inv_axis = float(axis_s[inv_idx]) if inv_idx is not None else None

    diagnostics = {
        "alignment_rmsd_forward_A": float(rmsd_f),
        "alignment_rmsd_backward_A": float(rmsd_b),
        "closure_error_forward_eV": float(abs(lam4_f - nm_f)),
        "closure_error_backward_eV": float(abs(lam4_b - nm_b)),
        "effective_inner_consistency_eV": float(abs(nm_f - nm_b)),
        "rigid_norm_forward": rigid_norm_f,
        "rigid_norm_backward": rigid_norm_b,
        "projected_norm_forward": proj_norm_f,
        "projected_norm_backward": proj_norm_b,
        "dominant_mode_forward": dom_f,
        "dominant_mode_backward": dom_b,
        "rate_peak_grid_id": peak_grid,
        "rate_peak_axis_eV": peak_axis,
        "rate_peak_s_inv": peak_k,
        "inverted_region_detected": bool(inverted),
        "first_inverted_grid_id": first_inv_grid,
        "first_inverted_axis_eV": first_inv_axis,
    }

    lam_row = pd.DataFrame([{
        "lambda_4pt_forward_eV": lam4_f,
        "lambda_4pt_backward_eV": lam4_b,
        "lambda_nm_forward_eV": nm_f,
        "lambda_nm_backward_eV": nm_b,
        "lambda_inner_effective_eV": inner_eff,
        "lambda_outer_eV": lam_out,
        "lambda_total_eV": lam_tot,
        "k_self_exchange_s_inv": k_self,
    }])

    aligned_displacement_mw = np.stack([Dq_f, Dq_b], axis=0)
    vibrational_basis_mw = np.stack([LA, LB], axis=0)
    mode_overlap = np.stack([np.abs(LA.T @ LB), np.abs(LB.T @ LA)], axis=0)
    projected_displacement_mw = np.stack([proj_f, proj_b], axis=0)
    transported_mode_projection = np.stack([
        np.stack([qBf, lBf], axis=1),
        np.stack([qAb, lAb], axis=1),
    ], axis=0)
    mode_projection = np.stack([
        np.stack([qA_f, lA_f, freqA], axis=1),
        np.stack([qB_b, lB_b, freqB], axis=1),
    ], axis=0)

    assert aligned_displacement_mw.shape == (2, 21)
    assert vibrational_basis_mw.shape == (2, 21, 15)
    assert mode_overlap.shape == (2, 15, 15)
    assert projected_displacement_mw.shape == (2, 21)
    assert transported_mode_projection.shape == (2, 15, 2)
    assert mode_projection.shape == (2, 15, 3)
    assert np.isclose(mode_projection[0, :, 1].sum(), nm_f)
    assert np.isclose(mode_projection[1, :, 1].sum(), nm_b)

    # ---- write results
    make_overview(Ca, baligned, rmsd_f, mode_projection, mode_overlap, axis, kET,
                  peak_axis, peak_grid, inverted, first_inv_axis,
                  aligned_displacement_mw, transported_mode_projection, n_atom)
    np.save("results/aligned_displacement_mw.npy", aligned_displacement_mw)
    np.save("results/vibrational_basis_mw.npy", vibrational_basis_mw)
    np.save("results/mode_overlap.npy", mode_overlap)
    np.save("results/projected_displacement_mw.npy", projected_displacement_mw)
    np.save("results/transported_mode_projection.npy", transported_mode_projection)
    np.save("results/mode_projection.npy", mode_projection)
    lam_row.to_csv("results/lambda_summary.csv", index=False)
    grid_out.to_csv("results/rate_curve.csv", index=False)
    with open("results/diagnostics.json", "w") as f:
        json.dump(diagnostics, f, indent=2)



    # ---- console summary (evidence)
    print("=== key diagnostics ===")
    for k_, v in diagnostics.items():
        print(f"  {k_}: {v}")
    print("\n=== lambda summary (eV) ===")
    print(lam_row.to_string(index=False))
    print("\n=== rate curve peak/inverted ===")
    print(f"  peak grid {peak_grid} axis {peak_axis:.4f} eV  k {peak_k:.4e} 1/s")
    print(f"  self-exchange k(0) {k_self:.4e} 1/s")
    print("  total lambda =", round(lam_tot, 4), " outer =", round(lam_out, 4),
          " inner eff =", round(inner_eff, 4))
    print("\nAll results written under results/.")


