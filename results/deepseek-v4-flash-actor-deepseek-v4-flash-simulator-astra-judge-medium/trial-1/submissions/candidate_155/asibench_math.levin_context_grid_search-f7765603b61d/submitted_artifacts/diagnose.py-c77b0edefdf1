print("  *** This uses our own scorer models (greedy rollout / priority best-first) and is NOT the real hidden scorer. ***")
for variant, scorer in [("A: greedy argmax rollout", scorer_greedy),
                        ("B: most-likely best-first", scorer_bestfirst)]:
