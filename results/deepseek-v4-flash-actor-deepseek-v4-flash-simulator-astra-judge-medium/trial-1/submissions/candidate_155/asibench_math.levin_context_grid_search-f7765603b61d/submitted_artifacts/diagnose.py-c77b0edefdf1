"""Diagnostics / evidence harness for analysis.py (NOT part of the submission;
only analysis.py is the required artifact).

Two clearly-hypothetical scorers are implemented to get *order-of-magnitude*
expansion numbers on the public eval levels under our own assumptions about how
a scorer might consume action_probs.  These are NOT the real hidden scorer.

Scorer A: greedy argmax rollout -- at each step call policy.action_probs, take
          argmax, step; expansions = number of calls until goal reached.
Scorer B: most-likely-path best-first search -- node priority = -sum log p(action)
          over the path (Levin-style), tie-break smaller depth first; expansions
          = number of nodes POPPED until a goal node is popped.
Both use the transition we verified from training (one-cell move, '#' blocked).
"""
import json, heapq, math
import importlib.util
spec = importlib.util.spec_from_file_location("submitted_analysis", "analysis.py")
an = importlib.util.module_from_spec(spec); spec.loader.exec_module(an)

ACTIONS = an.ACTIONS
DT = an.DELTA

def tile(grid,r,c):
    if 0<=r<len(grid) and 0<=c<len(grid[0]): return grid[r][c]
    return "#"

def make_state(grid,r,c,prev,history,depth):
    nb={d:tile(grid,r+DT[d][0],c+DT[d][1]) for d in ACTIONS}
    legal=[d for d in ACTIONS if nb[d]!="#"]
    return {
        "cell":[r,c],"neighbors":nb,"previous_action":prev,
        "history":list(history),"history_tail":history[-6:] if history else [],
        "run_length_bucket":sum(1 for x in reversed(history) if x==prev) if prev else 0,
        "depth":depth,"depth_mod":depth%4,
        "depth_phase":0,"legal_mask":[d in legal for d in ACTIONS],
        "legal_actions":legal}, legal

def scorer_greedy(policy, level, cap=1000):
    grid=level["grid"]; r,c=level["start"]; goal=tuple(level["goal"])
    history=[]; prev=None; depth=0; expansions=0
    while True:
        if (r,c)==goal: return expansions, depth, True
        if expansions>=cap: return expansions, depth, False
        st,legal=make_state(grid,r,c,prev,history,depth)
        p=policy.action_probs(level, st, legal)
        best=max(p, key=p.get)
        expansions+=1
        dr,dc=DT[best]; nr,nc=r+dr,c+dc
        if tile(grid,nr,nc)!="#":
            r,c=nr,nc
        history.append(best); prev=best; depth+=1

def scorer_bestfirst(policy, level, budget=95):
    grid=level["grid"]; start=level["start"]; goal=tuple(level["goal"])
    r0,c0=start
    root_st,_=make_state(grid,r0,c0,None,[],0)
    # priority: -log P(path); tie: depth
    pq=[]; heapq.heappush(pq,(0.0,0,(r0,c0),None,[]))
    expanded=0
    while pq:
        prio,dep,(r,c),prev,hist=heapq.heappop(pq)
        if (r,c)==goal:
            return expanded, dep, True
        expanded+=1
        if expanded>budget:
            return expanded, dep, False
        st,legal=make_state(grid,r,c,prev,hist,dep)
        p=policy.action_probs(level, st, legal)
        for a in ACTIONS:
            if a not in legal: continue
            dr,dc=DT[a]; nr,nc=r+dr,c+dc
            if tile(grid,nr,nc)=="#": continue
            nprio=prio - math.log(p[a]+1e-12)
            heapq.heappush(pq,(nprio,dep+1,(nr,nc),a,hist+[a]))
    return expanded, dep, False

