# ---------- held-out level generalization ----------
levels=td["levels"]
import random
random.seed(0); idx=list(range(len(levels))); random.shuffle(idx)
split=int(0.7*len(idx)); tr_idx=idx[:split]; va_idx=idx[split:]
tr_data={"levels":[levels[i] for i in tr_idx]}
va_data={"levels":[levels[i] for i in va_idx]}
pol2=an.make_policy(tr_data)
st2=pol2._train_stats
def eval_levels(policy, levels):
    correct=0; n=0
    for L in levels:
        for state,a in an._simulate_trajectory(L):
            legal=an._extract_legal(state, state.get("legal_actions"))
            p=policy.action_probs(L, state, legal)
            best=max(p,key=p.get)
            correct += (best==a); n+=1
    return correct, n
cva,nva=eval_levels(pol2, va_data["levels"])
print("="*70)
print("HELD-OUT level generalization (train on 70%% of levels, eval on other 30%%):")
print("  eval steps=%d, policy top-1 accuracy=%.4f (%d/%d)" % (nva, cva/nva, cva, nva))
# prior-only accuracy on the same held-out steps
pc=0
for L in va_data["levels"]:
    for state,a in an._simulate_trajectory(L):
        legal=an._extract_legal(state, state.get("legal_actions"))
        s=an._structural_prior(L,state,legal,None,8.0,10.0)
        pc += (s.argmax()==an.ACTIONS.index(a))
print("  structural-prior-only top-1 accuracy=%.4f (%d/%d)" % (pc/nva, pc, nva))

# free-turn irreducible accuracy on held-out
ft_c=0; ft_n=0
for L in va_data["levels"]:
    for state,a in an._simulate_trajectory(L):
        legal=set(an._extract_legal(state, state.get("legal_actions")))
        prev=an._extract_prev(state)
        if prev is None or prev in legal: continue
        perp=an.PERP[prev]; pl=[d for d in perp if d in legal]
        if len(pl)==2:
            ft_c+=(a==max(pl,key=lambda d: (an._structural_prior(L,state,pl,None,8.,10.))[an.ACTIONS.index(d)]))
            ft_n+=1
print("  free-turn ('both perpendiculars legal') top-1 accuracy=%.4f (%d/%d) [irreducible without goal]" % (ft_c/max(1,ft_n), ft_c, ft_n))

