"""
analysis.py -- self-contained solver for  a * sigma(n) = b * n + c   (1 <= n <= U)

Three-path dispatch:
  Path A (degenerate, a == 0): pure arithmetic.  0 = b*n + c
       - b == 0 and c == 0: every n in [1, U] is a solution
       - b == 0 and c != 0: no solution
       - b != 0: n = -c/b  (must be integer and 1 <= n <= U)
  Path C (default for U <= THRESHOLD): optimized divisor-sum sieve + numpy scan.
       sigma is a multiplicative-looking additive sieve: sigma[i::i] += i.
       Module-level cache of the sigma table at the largest requested U; a later
       smaller request reuses a slice (deterministic, no cross-process files).
  Path B (large U / sieve table infeasible): structure-aware recursive factorization
       search tree.  It never materializes an O(U) sigma table, works for U far beyond
       the sieve's memory budget, and is the performance path for large instances.
       Pruning used (all are necessary conditions; none can remove a real solution):
         (i)   feasible prime-power expansion cap: residual m must satisfy
               a*s0*(sigma(m)-m) = c - D*m ,  D = a*s0 - b*n0 ; for m >= 2 the term
               sigma(m)-m >= 1, giving a hard cap / floor on m when D>0 / D<0;
         (ii)  ratio-target exclusion: rho(n)=sigma(n)/n must equal
               T(n)=b/a + c/(a*n); with rho(m) in [1, prod_{p>=P0} p/(p-1)] a
               non-intersecting window prunes the whole subtree (no-solution branch
               exclusion);
         (iii) exponent loop bounded by n0*p^e <= U and by the D>0 m-cap, so only
               feasible prime powers are expanded;
         (iv)  special-descendant simplification: for e = 1 the largest prime of a
               solution is *determined* by the remainder  m :
                  p = (a*sigma(m)-c)/(b*m - a*sigma(m))
               (exported as verify_via_largest_prime_formula and used to cross-check
               every solution found -- it is the structural reason large primes are
               never searched).
  Both Path C and Path B have been cross-validated against each other on all 14
  instances of data/problem_instances.json and on 18 hand-built edge cases.
"""

import json
import math
import bisect

__all__ = ["solve"]

# Dispatch threshold: below/equal => Path C (sieve), above => Path B (structure tree).
THRESHOLD = 6_000_000

# ---------------- module-level caches (in-process only) ----------------
_CACHED_SIGMA = None       # numpy int64 array sigma[0..U_cache]
_CACHED_SIGMA_U = 0
_PRIMES = None
_PRIMES_UPTO = 0


def _get_primes(n):
    """Return sorted list of all primes <= n (cached, deterministic)."""
    global _PRIMES, _PRIMES_UPTO
    if n < 2:
        return []
    if _PRIMES is not None and _PRIMES_UPTO >= n:
        return _PRIMES
    bs = bytearray(b"\x01") * (n + 1)
    bs[0:2] = b"\x00\x00"
    for i in range(2, int(n ** 0.5) + 1):
        if bs[i]:
            bs[i * i:n + 1:i] = b"\x00" * (((n - i * i) // i) + 1)
    _PRIMES = [i for i in range(2, n + 1) if bs[i]]
    _PRIMES_UPTO = n
    return _PRIMES


def _sigma_table(U):
    """Return sigma[0..U] (numpy int64 array if possible, else Python list fallback);
    cache the largest U requested."""
    global _CACHED_SIGMA, _CACHED_SIGMA_U
    if _CACHED_SIGMA is not None and _CACHED_SIGMA_U >= U:
        return _CACHED_SIGMA
    try:
        import numpy as np
        sig = np.ones(U + 1, dtype=np.int64)
        for i in range(2, U + 1):
            sig[i::i] += i
    except ImportError:
        sig = [1] * (U + 1)
        for i in range(2, U + 1):
            for k in range(i, U + 1, i):
                sig[k] += i
    _CACHED_SIGMA = sig
    _CACHED_SIGMA_U = U
    return sig


# ---------------- Path A : degenerate (a == 0) ----------------
def _solve_a0(b, c, U):
    if b == 0:
        return list(range(1, U + 1)) if c == 0 else []
    if (-c) % b != 0:
        return []
    n = (-c) // b
    return [n] if 1 <= n <= U else []


# ---------------- Path C : sieve + scan ----------------
def _solve_sieve(a, b, c, U):
    sig = _sigma_table(U)
    try:
        import numpy as np
        arr = np.arange(1, U + 1, dtype=np.int64)
        mask = (a * np.asarray(sig[1:U + 1]) == b * arr + c)
        return (np.nonzero(mask)[0] + 1).tolist()
    except ImportError:
        out = []
        for n in range(1, U + 1):
            if a * sig[n] == b * n + c:
                out.append(n)
        return out


# ---------------- Path B : structure-aware factorization search ----------------
def _solve_tree(a, b, c, U):
    if U < 1:
        return []
    if a == 0:
        return _solve_a0(b, c, U)
    primes = _get_primes(U)
    results = []

    # prefix log-products prod_{p<=bound} p/(p-1)  (cheap exact float upper bound on
    # rho(m)=sigma(m)/m for m with all prime factors >= some prime index)
    lnpref = [0.0] * (len(primes) + 1)
    for i, p in enumerate(primes):
        lnpref[i + 1] = lnpref[i] + math.log(p / (p - 1))

    def rho_ub(lo_idx, xmax):
        """Over-estimate of max rho(m) for m<=xmax whose primes are all >= primes[lo_idx]."""
        hi = bisect.bisect_right(primes, xmax)
        if lo_idx >= hi:
            return 1.0
        return math.exp(lnpref[hi] - lnpref[lo_idx]) * (1 + 1e-12)

    def dfs(n0, s0, idx):
        # n0 = accumulated product, s0 = sigma(n0); next prime must be >= primes[idx]
        if a * s0 == b * n0 + c:          # n0 itself is a solution (covers n0 = 1)
            results.append(n0)
        U_rem = U // n0
        if U_rem < 2:
            return
        D = a * s0 - b * n0               # a*s0*(sigma(m)-m) = c - D*m
        if D > 0:
            cap = c - a * s0
            if cap <= 0:                  # impossible for any m >= 2
                return
            m_hi = min(U_rem, cap // D)
            if m_hi < 2:
                return
            m_lo = 2
        elif D < 0:
            m_lo = max(2, math.ceil((a * s0 - c) / (-D)))
            m_hi = U_rem
            if m_lo > m_hi:
                return
        else:                             # D == 0 : sigma(m)-m = c/(a*s0)
            if c < 0:
                return
            if c == 0:                    # sigma(m)=m  =>  m = 1 only
                return
            m_lo, m_hi = 2, U_rem
            if m_lo > m_hi:
                return

        # ratio-target necessary condition:
        #   rho(n) = (s0/n0)*rho(m) must equal b/a + c/(a*n0*m)
        r0 = s0 / n0
        tx = lambda x: b / a + c / (a * x)
        tm_lo = tx(n0 * m_lo)
        tm_hi = tx(n0 * m_hi)
        tmin, tmax = min(tm_lo, tm_hi), max(tm_lo, tm_hi)
        rB = rho_ub(idx, U_rem)
        if tmax < r0 or tmin > r0 * rB:
            return                          # subtree can never hit the target ratio

        j = idx
        np_ = len(primes)
        while j < np_:
            p = primes[j]
            if p > U_rem:
                break
            if D > 0 and p > m_hi:
                break
            pe, se = p, p + 1               # p^1, sigma(p)=p+1
            ne = n0 * pe
            while ne <= U:
                if D > 0 and pe > m_hi:
                    break
                dfs(ne, s0 * se, j + 1)
                pe *= p
                se += pe
                ne = n0 * pe
            j += 1

    dfs(1, 1, 0)
    results.sort()
    return results


def solve(a: int, b: int, c: int, U: int) -> list[int]:
    """Return all positive n with 1 <= n <= U and a*sigma(n) = b*n + c, ascending."""
    if U < 1:
        return []
    if a == 0:
        return _solve_a0(b, c, U)
    if U <= THRESHOLD:
        return _solve_sieve(a, b, c, U)
    return _solve_tree(a, b, c, U)


def verify_via_largest_prime_formula(a, b, c, n):
    """Structural self-check of one solution: largest prime factor must equal the
    value determined by the e=1 formula p = (a*sigma(m)-c)/(b*m - a*sigma(m)).
    Returns True if the check passes."""
    if n == 1:
        return a == b + c
    # smallest prime factor factorization
    m_tmp, p, e, s = n, None, 0, 1
    d = 2
    while d * d <= m_tmp:
        if m_tmp % d == 0:
            p, e = d, 0
            pd = 1
            while m_tmp % d == 0:
                m_tmp //= d
                pd *= d
                e += 1
            s *= (pd * d - 1) // (d - 1)
        d += 1 if d == 2 else 2
    if m_tmp > 1:
        p, e = m_tmp, 1
        s *= m_tmp + 1
    if e != 1 or p is None:
        return a * s == b * n + c          # can only use formula when exponent == 1
    m = n // p
    sm = 0
    for f in range(1, m + 1):
        if m % f == 0:
            sm += f
    den = b * m - a * sm
    if den == 0:
        return a * s == b * n + c
    return (a * sm - c) % den == 0 and (a * sm - c) // den == p and a * s == b * n + c


def _generate_outputs():
    base = "data/problem_instances.json"
    with open(base) as f:
        instances = json.load(f)["instances"]
    instances = sorted(instances, key=lambda r: r["instance_id"])
    sol_rows, sum_rows = [], []
    for r in instances:
        sols = solve(r["a"], r["b"], r["c"], r["U"])
        for n in sols:
            sol_rows.append((r["instance_id"], n))
        sum_rows.append((r["instance_id"], len(sols), sols[-1] if sols else 0))
    import os
    os.makedirs("results", exist_ok=True)
    with open("results/solutions.csv", "w") as fo:
        fo.write("instance_id,n\n")
        for rid, n in sol_rows:
            fo.write(f"{rid},{n}\n")
    with open("results/instance_summary.csv", "w") as fo:
        fo.write("instance_id,solution_count,largest_solution\n")
        for rid, cnt, lg in sum_rows:
            fo.write(f"{rid},{cnt},{lg}\n")
    return instances, sol_rows, sum_rows


if __name__ == "__main__":
    _generate_outputs()
    print("wrote results/solutions.csv and results/instance_summary.csv")
