#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
Sparse Hyperbolic Scalar-Field Recovery - 2D
=============================================
Reconstruct a dense scalar field from scattered noisy (t,x,y,u) observations,
detect moving sharp transition curves, estimate their normals and normal speeds,
and fit a governing dynamical rule (candidate families compared).

Native ASIBench task: math.sparse_hyperbolic_recovery_2d
Constraints: numpy/scipy/matplotlib only; single entry script (no args);
scattered points used as scattered points (no artificial zero-filling).
"""
import json, os, time, struct, zlib
import numpy as np
from scipy.spatial import cKDTree

CFG = dict(h=0.22, tau=0.030, tlim_fraction=3.0, grad_threshold=0.15,
           curve_spacing=0.16, profile_bins=240, profile_min_count=20,
           mask_radius_cells=2)
WORKDIR = os.path.dirname(os.path.abspath(__file__)) or "."
DATADIR = os.path.join(WORKDIR, "data")
t_start = time.time()

def out_path(name):
    return os.path.join(WORKDIR, name)

# Load inputs
obs = np.load(os.path.join(DATADIR, "spacetime_observations.npz"))
T = obs["t"].astype(np.float64); X = obs["x"].astype(np.float64)
Y = obs["y"].astype(np.float64); U = obs["u"].astype(np.float64)

with open(os.path.join(DATADIR, "observation_grid.json")) as f:
    grid = json.load(f)
ET = np.array(grid["evaluation_times"], dtype=np.float64)
DTE = ET[1] - ET[0]; NEVAL = len(ET)
gx = np.linspace(grid["evaluation_grid_x"][0], grid["evaluation_grid_x"][1], 128)
gy = np.linspace(grid["evaluation_grid_y"][0], grid["evaluation_grid_y"][1], 128)
DX = gx[1] - gx[0]
GX, GY = np.meshgrid(gx, gy, indexing="xy")
NODES = np.stack([GX.ravel(), GY.ravel()], axis=1)
XI = (GX + GY) / np.sqrt(2.0)

# S0 - Exploration summary
def make_exploration_summary():
    edges = np.linspace(U.min(), U.max(), 21)
    hist, _ = np.histogram(U, bins=edges)
    value_histogram = [[round(edges[i], 6), int(hist[i])] for i in range(len(hist))]
    tree = cKDTree(np.stack([X, Y], axis=1))
    dist, idx = tree.query(np.stack([X, Y], axis=1), k=6)
    sel = (dist[:, 1:] < 0.12) & (np.abs(T[:, None] - T[idx[:, 1:]]) < 0.025)
    res = []
    for i in range(len(U)):
        m = sel[i]
        if m.sum() >= 2:
            res.append(float(abs(U[i] - np.median(U[idx[i, 1:][m]]))))
    noise = float(np.median(res)) if res else 0.05
    fracs = []
    for tv in ET:
        m = np.abs(T - tv) < 0.025
        tr = cKDTree(np.stack([X[m], Y[m]], axis=1))
        dd, _ = tr.query(NODES)
        fracs.append((dd < 0.15).mean())
    summary = dict(n_observations=int(len(T)),
                   u_range=[float(U.min()), float(U.max())],
                   noise_estimate=noise, coverage_estimate=float(np.mean(fracs)),
                   value_histogram=value_histogram)
    with open(out_path("exploration_summary.json"), "w") as f:
        json.dump(summary, f, indent=2)
    return summary

# S1 - Dense reconstruction (space-time Nadaraya-Watson kernel regression)
def reconstruct(t_eval):
    m = np.abs(T - t_eval) <= CFG["tlim_fraction"] * CFG["tau"]
    tp, xp, yp, up = T[m], X[m], Y[m], U[m]
    dt = tp - t_eval
    d2 = (xp[:, None] - NODES[:, 0][None, :]) ** 2 + \
         (yp[:, None] - NODES[:, 1][None, :]) ** 2
    w = np.exp(-dt[:, None] ** 2 / (2.0 * CFG["tau"] ** 2)) * \
        np.exp(-d2 / (2.0 * CFG["h"] ** 2))
    F = (w * up[:, None]).sum(axis=0) / np.maximum(w.sum(axis=0), 1e-9)
    return F.reshape(128, 128)

print("Exploration summary ...")
expl = make_exploration_summary()
print("Reconstructing fields ...")
RECON = np.stack([reconstruct(tv) for tv in ET]).astype(np.float32)
assert RECON.shape == (6, 128, 128) and RECON.dtype == np.float32
np.save(out_path("reconstructed_field.npy"), RECON)

# gradients, Laplacian, u_t
RF = RECON.astype(np.float64)
UX = np.gradient(RF, DX, axis=2); UY = np.gradient(RF, DX, axis=1)
GM = np.hypot(UX, UY)
LAP = np.gradient(np.gradient(RF, DX, axis=2), DX, axis=2) + \
      np.gradient(np.gradient(RF, DX, axis=1), DX, axis=1)
UT = np.zeros_like(RF)
UT[1:-1] = (RF[2:] - RF[0:-2]) / (2.0 * DTE)
UT[0] = (RF[1] - RF[0]) / DTE
UT[-1] = (RF[-1] - RF[-2]) / DTE

# S2 - Transition curve detection (median 1D profile crossings)
def profile_crossings(Fk, lvl):
    xf = XI.ravel(); Ff = Fk.ravel()
    order = np.argsort(xf); xs = xf[order]; ys = Ff[order]
    edges = np.linspace(-4.0, 4.0, CFG["profile_bins"])
    meds, mxi = [], []
    for i in range(len(edges) - 1):
        mask = (xs >= edges[i]) & (xs < edges[i + 1])
        if mask.sum() >= CFG["profile_min_count"]:
            meds.append(np.median(ys[mask])); mxi.append(0.5 * (edges[i] + edges[i + 1]))
    meds = np.array(meds); mxi = np.array(mxi)
    c = np.where((meds[:-1] - lvl) * (meds[1:] - lvl) <= 0)[0]
    out = []
    for j in c:
        x0, x1 = mxi[j], mxi[j + 1]; y0, y1 = meds[j], meds[j + 1]
        out.append(x0 + (lvl - y0) * (x1 - x0) / (y1 - y0 + 1e-12))
    return out, meds, mxi

def bilinear(Fk, px, py):
    ix = (px - gx[0]) / DX; iy = (py - gy[0]) / DX
    x0 = np.floor(ix).astype(int); y0 = np.floor(iy).astype(int)
    fx = ix - x0; fy = iy - y0
    x0 = np.clip(x0, 0, 126); y0 = np.clip(y0, 0, 126)
    return (Fk[y0, x0] * (1 - fx) * (1 - fy) +
            Fk[y0, x0 + 1] * fx * (1 - fy) +
            Fk[y0 + 1, x0] * (1 - fx) * fy +
            Fk[y0 + 1, x0 + 1] * fx * fy)

def line_points(xi0):
    ssum = xi0 * np.sqrt(2.0)
    n = max(8, int(2 * 2.8 / CFG["curve_spacing"]) + 1)
    pts = []
    for xp_ in np.linspace(-2.8, 2.8, n):
        yp_ = ssum - xp_
        if -2.8 <= yp_ <= 2.8:
            pts.append((float(xp_), float(yp_)))
    return np.array(pts)

print("Detecting transition curves ...")
front_xi1 = np.full(NEVAL, np.nan); front_xi2 = np.full(NEVAL, np.nan)
curve_points = {}; norms = {}; speeds = {}
mask = np.zeros((6, 128, 128), dtype=bool)

for k, tv in enumerate(ET):
    Fk = RF[k]
    A = np.percentile(Fk, 3.0); C = np.percentile(Fk, 98.0); B = np.median(Fk)
    c1, _, _ = profile_crossings(Fk, (C + B) / 2.0)
    c2, _, _ = profile_crossings(Fk, (B + A) / 2.0)
    xi1 = c1[0] if len(c1) else np.nan
    xi2 = c2[0] if len(c2) else np.nan
    front_xi1[k] = xi1; front_xi2[k] = xi2
    pts = []
    if np.isfinite(xi1): pts.append(line_points(xi1))
    if np.isfinite(xi2): pts.append(line_points(xi2))
    pts = np.vstack(pts) if len(pts) else np.zeros((0, 2))
    curve_points[k] = pts
    nx = bilinear(UX[k], pts[:, 0], pts[:, 1])
    ny = bilinear(UY[k], pts[:, 0], pts[:, 1])
    nm = np.hypot(nx, ny)
    n = np.stack([nx / np.maximum(nm, 1e-12), ny / np.maximum(nm, 1e-12)], axis=1)
    norms[k] = n
    speeds[k] = np.zeros(len(pts), dtype=np.float64)
    if len(pts):
        tr = cKDTree(pts)
        dq, _ = tr.query(NODES)
        mask[k] = (dq <= 1.5 * DX).reshape(128, 128)

ok1 = np.isfinite(front_xi1); ok2 = np.isfinite(front_xi2)
s1 = np.polyfit(ET[ok1], front_xi1[ok1], 1)[0] if ok1.sum() >= 2 else 0.0
s2 = np.polyfit(ET[ok2], front_xi2[ok2], 1)[0] if ok2.sum() >= 2 else 0.0
LINE_SPEED = (float(-s1), float(-s2))   # +n points toward increasing u
for k in range(NEVAL):
    n1 = len(line_points(front_xi1[k])) if np.isfinite(front_xi1[k]) else 0
    if np.isfinite(front_xi1[k]): speeds[k][0:n1] = LINE_SPEED[0]
    if np.isfinite(front_xi2[k]): speeds[k][n1:] = LINE_SPEED[1]

def write_curves(name, m):
    np.savez(out_path(name), **{f"t_{k}": v for k, v in m.items()})
write_curves("transition_curves.npz", {k: v.astype(np.float32) for k, v in curve_points.items()})
write_curves("transition_normals.npz", {k: v.astype(np.float32) for k, v in norms.items()})
write_curves("transition_speeds.npz", {k: v.astype(np.float32) for k, v in speeds.items()})
np.save(out_path("transition_mask_preview.npy"), mask.astype(bool))

# S3 - Governing model fitting
print("Fitting governing models ...")
gm = GM > CFG["grad_threshold"]
u_flat = RF[gm]; ux_flat = UX[gm]; uy_flat = UY[gm]
ut_flat = UT[gm]; lap_flat = LAP[gm]
w = GM[gm].astype(np.float64)
design = {"const": np.ones_like(u_flat), "ux": ux_flat, "uy": uy_flat,
          "uux": u_flat * ux_flat, "uuy": u_flat * uy_flat, "lap": lap_flat}
cands = [
    (["const"], "constant_rate"),
    (["ux", "uy", "const"], "linear_advection"),
    (["uux", "uuy", "const"], "burgers_nonlinear"),
    (["uux", "uuy", "ux", "uy", "const"], "nonlinear_advection"),
    (["lap", "const"], "linear_diffusion"),
    (["ux", "uy", "lap", "const"], "advection_diffusion"),
    (["uux", "uuy", "lap", "const"], "burgers_diffusion"),
]
motiv = {
 "constant_rate": "null benchmark: u_t = const",
 "linear_advection": "rigid transport u_t+a u_x+b u_y=0; first hypothesis for a transported field",
 "burgers_nonlinear": "1D scalar conservation u_t+(u^2)_xi=0 (hyperbolic); fronts of different levels move at different speeds",
 "nonlinear_advection": "nonlinear transport plus linear advection terms",
 "linear_diffusion": "diffusion u_t=D lap u; would round the transition fronts",
 "advection_diffusion": "mixed advection + diffusion",
 "burgers_diffusion": "nonlinear transport plus diffusion",
}
model_results = []; fit = {}
for cols, name in cands:
    Amat = np.stack([design[c] for c in cols], axis=1) * w[:, None]
    b = ut_flat * w
    coef, _, _, _ = np.linalg.lstsq(Amat, b, rcond=None)
    pred = Amat @ coef
    rss = float(((pred - b) ** 2).sum()); tss = float(((b - b.mean()) ** 2).sum())
    rrmse = float(np.sqrt(rss / w.size)); r2 = float(1.0 - rss / tss) if tss > 0 else 0.0
    aic = int(w.size * np.log(rss / w.size + 1e-30) + 2 * len(cols))
    model_results.append(dict(family=name, fit_residual_rms=rrmse, r2=r2, aic=aic,
                              coefficients=[float(c) for c in coef]))
    fit[name] = (cols, coef, rrmse, r2)

model_candidates = [dict(family=m["family"], motivation=motiv[m["family"]],
                         fit_residual_rms=m["fit_residual_rms"], r2=m["r2"],
                         aic=m["aic"], coefficients=m["coefficients"])
                    for m in model_results]
with open(out_path("model_candidates.json"), "w") as f:
    json.dump(model_candidates, f, indent=2)

best_r2 = max(m["r2"] for m in model_results)
eps_simple = 0.005
simple = [m for m in model_results if m["r2"] >= best_r2 - eps_simple]
best = min(simple, key=lambda m: (len(m["coefficients"]), -m["r2"]))
cols, coef, rrmse, r2 = fit[best["family"]]
coef_map = {c: float(v) for c, v in zip(cols, coef)}
alpha_x = coef_map.get("uux", coef_map.get("ux", 0.0))
alpha_y = coef_map.get("uuy", coef_map.get("uy", 0.0))
extra = {c: v for c, v in coef_map.items() if c not in ("uux", "uuy")}
governing = dict(family=best["family"],
                 coefficients=dict(alpha_x=alpha_x, alpha_y=alpha_y, **extra),
                 confidence=float(r2), fit_residual_rms=rrmse)
with open(out_path("governing_model.json"), "w") as f:
    json.dump(governing, f, indent=2)

# S4 - Consistency at curve points and diagnostics
def model_ut_pred(k, pts):
    uq = bilinear(RF[k], pts[:, 0], pts[:, 1])
    uxq = bilinear(UX[k], pts[:, 0], pts[:, 1])
    uyq = bilinear(UY[k], pts[:, 0], pts[:, 1])
    lq = bilinear(LAP[k], pts[:, 0], pts[:, 1])
    terms = []
    for c in cols:
        if c == "const": terms.append(np.ones(len(pts)))
        elif c == "ux": terms.append(uxq)
        elif c == "uy": terms.append(uyq)
        elif c == "uux": terms.append(uq * uxq)
        elif c == "uuy": terms.append(uq * uyq)
        elif c == "lap": terms.append(lq)
    return sum(co * t for co, t in zip(coef, terms))

curve_resid = {}; jumps = {}; utq_all = []
for k in range(NEVAL):
    pts = curve_points[k]
    if len(pts) == 0:
        curve_resid[k] = np.array([]); jumps[k] = np.array([]); continue
    utq = bilinear(UT[k], pts[:, 0], pts[:, 1]); utq_all.append(utq)
    r = utq - model_ut_pred(k, pts)
    nxq = bilinear(UX[k], pts[:, 0], pts[:, 1]); nyq = bilinear(UY[k], pts[:, 0], pts[:, 1])
    nmq = np.hypot(nxq, nyq); eps = 4.0 * DX
    upos = bilinear(RF[k], pts[:, 0] + eps * nxq / np.maximum(nmq, 1e-12),
                    pts[:, 1] + eps * nyq / np.maximum(nmq, 1e-12))
    uneg = bilinear(RF[k], pts[:, 0] - eps * nxq / np.maximum(nmq, 1e-12),
                    pts[:, 1] - eps * nyq / np.maximum(nmq, 1e-12))
    curve_resid[k] = r; jumps[k] = upos - uneg

all_r = np.concatenate([curve_resid[k] for k in range(NEVAL)])
utq_all = np.concatenate(utq_all) if utq_all else np.array([1.0])
scale = max(float(np.median(np.abs(utq_all))), 1e-6)
pass_frac = float((np.abs(all_r) <= 0.2 * scale).mean()) if all_r.size else 0.0
methodology = (
 "Reconstruction: Nadaraya-Watson space-time kernel regression (h={h}, tau={tau}, window=3*tau) "
 "over scattered observations; no zero-filling. Curves: C->B and B->A front lines from median 1D "
 "profile u(xi), xi=(x+y)/sqrt(2), crossing mid-levels (C+B)/2 and (B+A)/2. "
 "Normal n = grad(u)/|grad(u)| (toward increasing u; ~(-1,-1)/sqrt(2)). "
 "Signed normal speed per line = measured rigid motion d(xi)/dt along +n "
 "(LS slope over eval times; + toward increasing u). "
 "Governing rule: LS fit of candidate families at grid points with |grad u|>{g} weighted by "
 "|grad u|; family by max weighted R^2. Residuals at curve points r=u_t_meas - u_t_model(t), "
 "median/p90 of |r|; pass_fraction_20pct = P(|r| <= 0.2*scale), scale=median|u_t| at curve pts. "
 "Jump = field at +/-4 cells along normal (bilinear). Line speeds (along +n): CB {s1:.3f}, BA {s2:.3f}. "\
"Residuals use u_t from finite differences of reconstructed fields over dt=0.0835; temporal resolution limits the fast-front residual."
).format(h=CFG["h"], tau=CFG["tau"], g=CFG["grad_threshold"], s1=LINE_SPEED[0], s2=LINE_SPEED[1])
consistency = dict(median_residual=float(np.median(np.abs(all_r))) if all_r.size else None,
                   p90_residual=float(np.percentile(np.abs(all_r), 90)) if all_r.size else None,
                   pass_fraction_20pct=pass_frac, methodology=methodology)
with open(out_path("consistency_report.json"), "w") as f:
    json.dump(consistency, f, indent=2)
diagnostics = {}
for k, tv in enumerate(ET):
    r = curve_resid[k]; jv = jumps[k]
    diagnostics[f"t_{k}"] = dict(time=float(tv), n_points=int(len(r)),
        median_residual=float(np.median(np.abs(r))) if len(r) else None,
        p90_residual=float(np.percentile(np.abs(r), 90)) if len(r) else None,
        median_jump=float(np.median(np.abs(jv))) if len(jv) else None,
        front_xi1=float(front_xi1[k]) if np.isfinite(front_xi1[k]) else None,
        front_xi2=float(front_xi2[k]) if np.isfinite(front_xi2[k]) else None)
with open(out_path("diagnostic_report.json"), "w") as f:
    json.dump(diagnostics, f, indent=2)

# S5 - Figure
def write_png_rgb(path, rgb):
    h, w, _ = rgb.shape
    raw = b"".join(b"\x00" + rgb[i].tobytes() for i in range(h))
    comp = zlib.compress(raw, 6)
    def chunk(tag, payload):
        c = struct.pack(">I", len(payload)) + tag + payload
        return c + struct.pack(">I", zlib.crc32(tag + payload) & 0xffffffff)
    ihdr = struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0)
    png = b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", ihdr) + chunk(b"IDAT", comp) + chunk(b"IEND", b"")
    with open(path, "wb") as f:
        f.write(png)

def coolwarm(v):
    v = np.clip(v, 0.0, 1.0); t = v * 4.0
    def l(a, b, t): return a + (b - a) * t
    r = np.where(t < 1, l(59, 221, t), np.where(t < 2, l(221, 255, t - 1),
        np.where(t < 3, l(255, 221, t - 2), l(221, 49, t - 3))))
    g = np.where(t < 1, l(76, 221, t), np.where(t < 2, l(221, 255, t - 1),
        np.where(t < 3, l(255, 221, t - 2), l(221, 112, t - 3))))
    b = np.where(t < 1, l(192, 221, t), np.where(t < 2, l(221, 255, t - 1),
        np.where(t < 3, l(255, 221, t - 2), l(221, 59, t - 3))))
    return np.stack([r, g, b], axis=-1)

try:
    import matplotlib; matplotlib.use("Agg")
    import matplotlib.pyplot as plt; HAVE_MPL = True
except Exception:
    HAVE_MPL = False

if HAVE_MPL:
    fig, axes = plt.subplots(2, 3, figsize=(13.5, 9))
    for ax, k in zip(axes.ravel(), range(NEVAL)):
        im = ax.imshow(RECON[k], origin="lower", extent=[gx[0], gx[-1], gy[0], gy[-1]],
                       vmin=-1.4, vmax=0.5, cmap="coolwarm")
        pts = curve_points[k]
        if len(pts):
            ax.plot(pts[:, 0], pts[:, 1], "k.", markersize=2.5)
            step = max(1, len(pts) // 12); nq = norms[k]
            ax.quiver(pts[::step, 0], pts[::step, 1], nq[::step, 0] * 0.25,
                      nq[::step, 1] * 0.25, color="lime", scale=1, width=0.006)
        ax.set_title(f"t={ET[k]:.4f}"); ax.set_xlim(gx[0], gx[-1]); ax.set_ylim(gy[0], gy[-1])
        ax.set_aspect("equal")
    fig.suptitle("Reconstructed field + transition curves + normals")
    fig.tight_layout(); fig.savefig(out_path("reconstruction_slices.png"), dpi=110)
    plt.close(fig)
else:
    W, H = 260, 260; all_rows = []
    for k in range(NEVAL):
        Fk = RECON[k]
        xs = (np.arange(W) + 0.5) / W * (gx[-1] - gx[0]) + gx[0]
        ys = (np.arange(H) + 0.5) / H * (gy[-1] - gy[0]) + gy[0]
        XGp, YGp = np.meshgrid(xs, ys, indexing="xy")
        ix = np.clip(((XGp - gx[0]) / DX).astype(int), 0, 127)
        iy = np.clip(((YGp - gy[0]) / DX).astype(int), 0, 127)
        img = (coolwarm((Fk[iy, ix] - (-1.4)) / (0.5 + 1.4)) * 255).astype(np.uint8)
        def pc(p):
            return int(round((p[0] - gx[0]) / (gx[-1] - gx[0]) * (W - 1))), \
                   int(round((p[1] - gy[0]) / (gy[-1] - gy[0]) * (H - 1)))
        for p in curve_points[k]:
            xx, yy = pc(p)
            if 0 <= xx < W and 0 <= yy < H: img[yy, xx] = (0, 0, 0)
        step = max(1, len(curve_points[k]) // 12); nq = norms[k]
        for j in range(0, len(curve_points[k]), step):
            x0, y0 = pc(curve_points[k][j])
            x1 = int(round(x0 + nq[j, 0] * 20)); y1 = int(round(y0 + nq[j, 1] * 20))
            for tt in range(21):
                xx = int(x0 + (x1 - x0) * tt / 20); yy = int(y0 + (y1 - y0) * tt / 20)
                if 0 <= xx < W and 0 <= yy < H: img[yy, xx] = (0, 255, 0)
        all_rows.append(img)
    sep = 4; colw = W + sep; rowh = H + sep
    canvas = np.full((2 * rowh + sep, 3 * colw + sep, 3), 255, dtype=np.uint8)
    for i, img in enumerate(all_rows):
        r, c = divmod(i, 3)
        canvas[r * rowh + sep:r * rowh + sep + H, c * colw + sep:c * colw + sep + W] = img
    write_png_rgb(out_path("reconstruction_slices.png"), canvas)

elapsed = time.time() - t_start
print("Run summary")
print(f"elapsed {elapsed:.1f}s | obs {len(T)} | eval times {NEVAL}")
print(f"line speeds: C->B {LINE_SPEED[0]:.3f}  B->A {LINE_SPEED[1]:.3f} (along +n)")
print(f"governing: {governing['family']}  ax={alpha_x:.3f} ay={alpha_y:.3f} "
      f"conf={governing['confidence']:.3f} rms={governing['fit_residual_rms']:.3f}")
print(f"curve residual: median {consistency['median_residual']:.3f} "
      f"p90 {consistency['p90_residual']:.3f} pass20 {pass_frac:.3f}")
