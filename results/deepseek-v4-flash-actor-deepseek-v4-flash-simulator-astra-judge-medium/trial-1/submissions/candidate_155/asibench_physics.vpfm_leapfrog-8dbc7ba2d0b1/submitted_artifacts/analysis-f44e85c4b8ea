"""
analysis.py -- post-hoc verification and diagnostics for the VPFM leapfrog
outputs (vorticity_frames.npy, kinetic_energy.npy, run_log.txt and the
input data).  Pure inspection: no simulation is re-run here.
"""
import os, re
import numpy as np

N = 135
print("=" * 72)
print("INPUT DATA")
print("=" * 72)
for name in ["data/initial_u_x.npy", "data/initial_u_y.npy"]:
    a = np.load(name)
    print(f"{name}: shape={a.shape} dtype={a.dtype} finite={bool(np.isfinite(a).all())} "
          f"min={a.min():.6g} max={a.max():.6g} mean={a.mean():.6g}")

print()
print("=" * 72)
print("OUTPUT ARTIFACTS (must match the public contract)")
print("=" * 72)
wf = np.load("vorticity_frames.npy")
ke = np.load("kinetic_energy.npy")
print("vorticity_frames.npy  shape =", wf.shape, " dtype =", wf.dtype,
      " expected (5,135,135) float32")
print("kinetic_energy.npy    shape =", ke.shape, " dtype =", ke.dtype,
      " expected (108,) float32")
print("finite:", bool(np.isfinite(wf).all()), bool(np.isfinite(ke).all()))
assert wf.shape == (5, N, N) and wf.dtype == np.float32
assert ke.shape == (108,) and ke.dtype == np.float32

# frame-0 exactness: vorticity/KE from the raw input faces (output formula)
ux0 = np.load("data/initial_u_x.npy").astype(np.float64)
uy0 = np.load("data/initial_u_y.npy").astype(np.float64)
h = 1.0 / N
CI = np.arange(N); IP1 = np.clip(CI + 1, 0, N - 1); IM1 = np.clip(CI - 1, 0, N - 1)
u = 0.5 * (ux0[0:N, :] + ux0[1:N + 1, :]); v = 0.5 * (uy0[:, 0:N] + uy0[:, 1:N + 1])
w0 = (v[IP1, :] - v[IM1, :]) / (2 * h) - (u[:, IP1] - u[:, IM1]) / (2 * h)
ke0 = 0.5 * h * h * np.sum(u * u + v * v)
print(f"\nframe-0 vorticity exact match: max|wf[0]-w0| = {np.abs(wf[0].astype(np.float64) - w0).max():.3e}")
print(f"frame-0 KE exact match: ke[0]={ke[0]:.6e}  direct={ke0:.6e}  diff={abs(ke[0]-ke0):.3e}")

print()
print("=" * 72)
print("KINETIC ENERGY TREND (energy conservation check)")
print("=" * 72)
print(f"ke[0]={ke[0]:.6e}  ke[107]={ke[107]:.6e}  ratio={ke[107]/ke[0]:.4f}")
for k in [0, 10, 26, 52, 78, 104, 107]:
    print(f"  frame {k:3d} t={0.1*k:5.1f}  KE={ke[k]:.6e}")

print()
print("=" * 72)
print("VORTICITY FRAMES (structure / circulation diagnostics)")
print("=" * 72)
for si, f in enumerate([0, 26, 52, 78, 104]):
    w = wf[si].astype(np.float64)
    print(f"frame {f:3d}: max={w.max():.4f} min={w.min():.4f} "
          f"sum(h^2 * w)={ (w*h*h).sum(): .3e}  l1={np.abs(w).sum():.1f}")

print()
print("=" * 72)
print("TIME STEPPING / CFL (from run_log.txt)")
print("=" * 72)
log = open("run_log.txt").read() if os.path.exists("run_log.txt") else ""
frames, maxv, dt, subs = [], [], [], []
for line in log.splitlines():
    m = re.search(r"\[frame\s+(\d+)\].*?max_vel=([\d.]+).*?dt=([\d.]+).*?subs/in=(\d+)", line)
    if m:
        frames.append(int(m.group(1))); maxv.append(float(m.group(2)))
        dt.append(float(m.group(3))); subs.append(int(m.group(4)))
if frames:
    print(f"frames advanced: {len(frames)}  total substeps: {sum(subs)}")
    print(f"substeps per frame distribution: { {k: subs.count(k) for k in set(subs)} }")
    print(f"max-velocity evolution: start (given field) ~0.2277 -> frame1 {maxv[0]:.4f} "
          f"-> early min {min(maxv):.4f} -> frame107 {maxv[-1]:.4f}")
    print(f"frame-1 substeps = {subs[0]}  (early frames split by CFL clip), "
          f"then single substep/frame after max_vel < CFL*h/0.1 = {1.8797/135/0.1:.4f}")

# timing
m = re.search(r"real\s+([\d.]+)m([\d.]+)s", log)
if m:
    print(f"wall time (real): {float(m.group(1))*60 + float(m.group(2)):.1f} s")
print("\nAll contract checks passed.")
