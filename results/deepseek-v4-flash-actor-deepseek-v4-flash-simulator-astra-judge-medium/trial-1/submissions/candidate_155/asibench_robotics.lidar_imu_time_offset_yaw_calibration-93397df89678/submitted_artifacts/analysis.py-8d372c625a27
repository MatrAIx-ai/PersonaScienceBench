"""
asibench: robotics.lidar_imu_time_offset_yaw_calibration
Multi-Sensor Motion Record Audit

Calibrates three time-invariant sensor parameters from a high-rate IMU gyro
(omega_z at ~134 Hz) and a lower-rate relative scan-matching stream (9.13 Hz):

    gyro_bias_rad_s   : gyro bias b, such that omega_true = omega_meas - b
    time_offset_s     : clock offset delta such that the lidar interval maps to
                        IMU samples via dyaw = int_{t0+delta}^{t1+delta}(omega-b) dt
    yaw_extrinsic_rad : yaw of the body->lidar rotation R_IL (T_IL convention):
                        a vector expressed in the LIDAR frame is expressed in the
                        body/IMU frame as Rz(+extrinsic) * v_L; equivalently the
                        robot's direction of travel, expressed in the LIDAR frame,
                        sits at heading = yaw_extrinsic.

Only rows marked split=train are used for fitting. Held-out rows are used for
diagnostics only (residuals.csv).

Outputs (workspace root): analysis.py, calibration.csv, observability.csv,
residuals.csv, calibration_diagnostics.png, metrics.json
"""
import json
import numpy as np
import pandas as pd
try:
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt
    HAVE_MPL = True
except Exception:
    HAVE_MPL = False

from scipy.optimize import least_squares

RNG = np.random.default_rng(20261022)
PI = np.pi

# ----------------------------------------------------------------------
# 1. Load inputs
# ----------------------------------------------------------------------
imu = pd.read_csv("data/imu_gyro.csv")
lid = pd.read_csv("data/lidar_scan_matches.csv")
seg = pd.read_csv("data/segment_windows.csv")
with open("data/task_info.json") as f:
    task_info = json.load(f)

ts = imu["imu_time_s"].to_numpy(float)
w  = imu["omega_z_rad_s"].to_numpy(float)

train = lid[lid.split == "train"].reset_index(drop=True)
hold  = lid[lid.split == "heldout"].reset_index(drop=True)

DT = float(np.median(np.diff(ts)))          # IMU sample period
t0 = train["t0_lidar_s"].to_numpy(float)
t1 = train["t1_lidar_s"].to_numpy(float)
dyaw = train["dyaw_lidar_rad"].to_numpy(float)
dx = train["dx_lidar_m"].to_numpy(float)
dy = train["dy_lidar_m"].to_numpy(float)
TMATCH = float(t1[0] - t0[0])               # constant scan-match interval
print(f"[data] imu rows={len(imu)} dt={DT:.6f}s freq~{1/DT:.1f}Hz")
print(f"[data] lidar rows={len(lid)} train={len(train)} heldout={len(hold)} TMATCH={TMATCH:.6f}s")


def cumulative_integral(t, w):
    """Trapezoidal cumulative integral of w(t) from t[0]."""
    out = np.zeros(len(t))
    out[1:] = np.cumsum(0.5 * (w[1:] + w[:-1]) * np.diff(t))
    return out


C = cumulative_integral(ts, w)              # C(t) = int_{ts[0]}^{t} omega(s) ds

# ----------------------------------------------------------------------
# 2. Rotation channel: fit (delta, bias) on TRAIN rows only
#    dyaw_k = C(t1_k + delta) - C(t0_k + delta) - bias*TMATCH
# ----------------------------------------------------------------------
SIG_YAW = float(lid["sigma_yaw_rad"].iloc[0])
SIG_TRANS = float(lid["sigma_trans_m"].iloc[0])


def yaw_residuals(p):
    delta, bias = p
    dint = np.interp(t1 + delta, ts, C) - np.interp(t0 + delta, ts, C)
    return (dint - bias * TMATCH - dyaw) / SIG_YAW


# coarse grid initialization (delta is weakly identifiable; scan whole range)
best_init = None
for delta0 in np.linspace(-0.25, 0.25, 501):
    dint = np.interp(t1 + delta0, ts, C) - np.interp(t0 + delta0, ts, C)
    bias0 = (dint.mean() - dyaw.mean()) / TMATCH
    r = np.std((dint - bias0 * TMATCH - dyaw) / SIG_YAW)
    if best_init is None or r < best_init[2]:
        best_init = (delta0, bias0, r)

fit = least_squares(yaw_residuals, [best_init[0], best_init[1]], method="lm", max_nfev=40000)
delta_hat, bias_hat = fit.x
per_scan_sigma_hat = float(np.std(fit.fun) * SIG_YAW)

# parameter covariance from Jacobian (scaled by residual variance)
J = fit.jac
cov = np.linalg.inv(J.T @ J) * (np.sum(fit.fun ** 2) / (len(fit.fun) - 2))
sd_delta, sd_bias = float(np.sqrt(cov[0, 0])), float(np.sqrt(cov[1, 1]))

# cross-check bias via overall means (independent aggregation)
mid = 0.5 * (t0 + t1)
bias_check = float(np.interp(mid, ts, w).mean() - (dyaw / TMATCH).mean())

# bootstrap delta + bias for a non-parametric uncertainty statement
nb = 300
boot_b = []
for _ in range(nb):
    idx = RNG.integers(0, len(train), size=len(train))
    dd = np.interp(t1[idx] + delta_hat, ts, C) - np.interp(t0[idx] + delta_hat, ts, C)
    boot_b.append(float((dd - dyaw[idx]).mean() / TMATCH))
boot_b = np.array(boot_b)
b_boot_lo, b_boot_hi = np.percentile(boot_b, 2.5), np.percentile(boot_b, 97.5)

print(f"[fit] delta={delta_hat:+.6f} +/- {sd_delta:.5f} s ; bias={bias_hat:+.6f} +/- {sd_bias:.5f} rad/s")
print(f"[fit] per-scan yaw residual std={per_scan_sigma_hat:.6f} (declared sigma_yaw={SIG_YAW})")
print(f"[fit] bias cross-check (aggregate)={bias_check:+.6f} ; boot 95% CI [{b_boot_lo:+.5f},{b_boot_hi:+.5f}]")

# ----------------------------------------------------------------------
# 3. Extrinsic yaw from translation direction (TRAIN rows only)
#    yaw_extrinsic = mean over train of atan2(dy, dx)  (body->lidar R_IL convention)
# ----------------------------------------------------------------------
ang_train = np.arctan2(train["dy_lidar_m"].to_numpy(float), train["dx_lidar_m"].to_numpy(float))
ext_hat = float(ang_train.mean())
ext_se = float(ang_train.std(ddof=1) / np.sqrt(len(ang_train)))
boot_e = np.array([float(np.arctan2(
    train["dy_lidar_m"].to_numpy(float)[idx],
    train["dx_lidar_m"].to_numpy(float)[idx]).mean())
    for idx in (RNG.integers(0, len(train), size=len(train)) for _ in range(300))])
e_lo, e_hi = np.percentile(boot_e, 2.5), np.percentile(boot_e, 97.5)
print(f"[fit] yaw_extrinsic (body->lidar / R_IL yaw) = {ext_hat:+.6f} +/- {ext_se:.5f} ; boot 95% CI [{e_lo:+.5f},{e_hi:+.5f}]")
print("[note] convention: rotation body/IMU->LIDAR is Rz(yaw_extrinsic); travel dir in LIDAR frame = yaw_extrinsic.")

# ----------------------------------------------------------------------
# 4. Residuals helper
# ----------------------------------------------------------------------
def compute_residuals(delta, bias, ext, df):
    a = df["t0_lidar_s"].to_numpy(float)
    b = df["t1_lidar_s"].to_numpy(float)
    dy_ = df["dyaw_lidar_rad"].to_numpy(float)
    dx_ = df["dx_lidar_m"].to_numpy(float)
    dyy = df["dy_lidar_m"].to_numpy(float)
    dint = np.interp(b + delta, ts, C) - np.interp(a + delta, ts, C)
    pred = dint - bias * TMATCH
    ry = (pred - dy_ + PI) % (2 * PI) - PI          # wrap to [-pi, pi)
    rt = -np.sin(ext) * dx_ + np.cos(ext) * dyy      # signed transverse (m)
    return ry, rt


ry_tr, rt_tr = compute_residuals(delta_hat, bias_hat, ext_hat, train)
print(f"[resid-train] yaw std={ry_tr.std():.6f} (mean={ry_tr.mean():+.2e}) ; trans std={rt_tr.std():.5f} (mean={rt_tr.mean():+.2e}, declared sigma={SIG_TRANS})")

# ----------------------------------------------------------------------
# 5. Observability per segment (larger = more useful for constraining the
#    three reported quantities, weighted by task parameter weights)
# ----------------------------------------------------------------------
param_w = task_info["scoring"]["parameter_weights"]
seg_t0 = seg["t0_lidar_s"].to_numpy(float)
seg_t1 = seg["t1_lidar_s"].to_numpy(float)
rows = []
for sid, (sa, sb) in enumerate(zip(seg_t0, seg_t1)):
    m = (train["t0_lidar_s"] >= sa - 1e-9) & (train["t1_lidar_s"] <= sb + 1e-9)
    n = int(m.sum())
    om0 = np.interp(t0[m], ts, w)
    om1 = np.interp(t1[m], ts, w)
    I_delta = float(np.sum((om1 - om0) ** 2) / SIG_YAW ** 2)
    I_bias = float(n * TMATCH ** 2 / SIG_YAW ** 2)
    I_ext = float(np.sum((np.hypot(dx[m], dy[m]) / SIG_TRANS) ** 2))
    rows.append({"segment_id": int(sid), "n_scans": n, "I_delta": I_delta,
                 "I_bias": I_bias, "I_ext": I_ext})
obs = pd.DataFrame(rows)
w_delta, w_bias, w_ext = param_w["time_offset_s"], param_w["gyro_bias_rad_s"], param_w["yaw_extrinsic_rad"]
score = (w_delta * obs["I_delta"] / obs["I_delta"].max()
         + w_bias * obs["I_bias"] / obs["I_bias"].max()
         + w_ext * obs["I_ext"] / obs["I_ext"].max())
obs["observability_score"] = score
obs_out = obs[["segment_id", "observability_score"]].copy()
print("\n[observability]")
print(obs_out.round(4).to_string(index=False))

# ----------------------------------------------------------------------
# 6. Held-out diagnostics (no fitting here)
# ----------------------------------------------------------------------
ry_ho, rt_ho = compute_residuals(delta_hat, bias_hat, ext_hat, hold)
resid_out = pd.DataFrame({
    "scan_id": hold["scan_id"].to_numpy(int),
    "residual_yaw_rad": ry_ho,
    "residual_trans_m": rt_ho,
})
print(f"\n[heldout] n={len(resid_out)} yaw std={ry_ho.std():.6f} (mean={ry_ho.mean():+.2e}) ; trans std={rt_ho.std():.5f} (mean={rt_ho.mean():+.2e})")

# ----------------------------------------------------------------------
# 7. Diagnostics figure
# ----------------------------------------------------------------------
def build_figure_diagnostics():
    if HAVE_MPL:
        fig, axes = plt.subplots(2, 2, figsize=(13, 9))
        ax = axes[0, 0]
        ax.plot(mid, np.interp(mid, ts, w), "-", lw=0.7, label="omega(mid)")
        ax.plot(mid, dyaw / TMATCH, ".", ms=2, alpha=0.5, label="dyaw/T")
        ax.set_title("Angular rate: IMU vs scan-match mean rate")
        ax.set_xlabel("time (s)"); ax.set_ylabel("rad/s"); ax.legend(fontsize=8)
        ax = axes[0, 1]
        all_t = np.concatenate([t0 + TMATCH / 2,
                                hold["t0_lidar_s"].to_numpy(float) + TMATCH / 2])
        all_r = np.concatenate([ry_tr, ry_ho])
        ax.plot(all_t, all_r, ".", ms=3, alpha=0.5)
        ax.axhline(0, color="k", lw=0.6)
        ax.set_title(f"Yaw residuals (train+heldout), std={all_r.std():.4f} rad")
        ax.set_xlabel("time (s)"); ax.set_ylabel("rad")
        ax = axes[1, 0]
        ang_ho = np.arctan2(hold["dy_lidar_m"].to_numpy(float), hold["dx_lidar_m"].to_numpy(float))
        ax.plot(mid, ang_train, ".", ms=3, alpha=0.5, label="train")
        ax.plot(hold["t0_lidar_s"].to_numpy(float) + TMATCH / 2, ang_ho, "x", ms=3, alpha=0.5, label="heldout")
        ax.axhline(ext_hat, color="C1", lw=1.2, label=f"extrinsic {ext_hat:+.4f}")
        ax.set_title("Direction of travel in LIDAR frame (yaw extrinsic)")
        ax.set_xlabel("time (s)"); ax.set_ylabel("atan2(dy,dx) (rad)"); ax.legend(fontsize=8)
        ax = axes[1, 1]
        ax.bar(obs["segment_id"], obs["observability_score"], color="C2", alpha=0.7)
        ax.set_title("Per-segment observability")
        ax.set_xlabel("segment_id"); ax.set_ylabel("observability score")
        fig.tight_layout()
        fig.savefig("calibration_diagnostics.png", dpi=130)
        plt.close(fig)
    else:
        import miniplot as mp
        img = mp.make_canvas(1500, 1020)
        # Panel 1: angular rate
        axes1 = mp.Plot(img, 60, 460, 660, 390, (float(mid[0]), float(mid[-1])),
                (float(np.min(np.concatenate([np.interp(mid, ts, w), dyaw / TMATCH]))),
                 float(np.max(np.concatenate([np.interp(mid, ts, w), dyaw / TMATCH])))),
                xlabel="time (s)", ylabel="rad/s",
                title="Angular rate: IMU vs scan-match mean rate",
                xticks=[0, 20, 40, 60, 80], yfmt="{:.2f}")
        axes1.curve(mid, np.interp(mid, ts, w), (30, 60, 200), lw=1)
        axes1.scatter(mid, dyaw / TMATCH, (200, 80, 80), r=2)
        # Panel 2: yaw residuals
        all_t = np.concatenate([t0 + TMATCH / 2, hold["t0_lidar_s"].to_numpy(float) + TMATCH / 2])
        all_r = np.concatenate([ry_tr, ry_ho])
        ylo = float(min(all_r.min(), 0) * 1.2); yhi = float(max(all_r.max(), 0.0001) * 1.2)
        axes2 = mp.Plot(img, 780, 60, 660, 400, (float(mid[0]), float(mid[-1])), (ylo, yhi),
                xlabel="time (s)", ylabel="rad", title="Yaw residuals (train+heldout)",
                xticks=[0, 20, 40, 60, 80], yfmt="{:.3f}")
        axes2.hline(0, (0, 0, 0))
        axes2.scatter(all_t, all_r, (70, 70, 70), r=2)
        # Panel 3: travel direction
        ang_ho = np.arctan2(hold["dy_lidar_m"].to_numpy(float), hold["dx_lidar_m"].to_numpy(float))
        alo = float(np.concatenate([ang_train, ang_ho, [ext_hat]]).min()); ahi = float(np.concatenate([ang_train, ang_ho, [ext_hat]]).max())
        axes3 = mp.Plot(img, 60, 540, 660, 400, (float(mid[0]), float(mid[-1])), (alo, ahi),
                xlabel="time (s)", ylabel="atan2(dy,dx) (rad)",
                title="Direction of travel in LIDAR frame (yaw extrinsic)",
                xticks=[0, 20, 40, 60, 80], yfmt="{:.2f}")
        axes3.scatter(mid, ang_train, (200, 80, 80), r=2)
        axes3.scatter(hold["t0_lidar_s"].to_numpy(float) + TMATCH / 2, ang_ho, (80, 80, 200), r=2)
        axes3.hline(ext_hat, (30, 160, 60))
        # Panel 4: observability
        axes4 = mp.Plot(img, 780, 540, 660, 400, (-0.4, float(len(obs)) - 0.6),
                (0, float(obs["observability_score"].max() * 1.15)),
                xlabel="segment_id", ylabel="observability score",
                title="Per-segment observability",
                xticks=np.arange(0, len(obs), 1), yfmt="{:.2f}")
        axes4.bar(obs["segment_id"], obs["observability_score"], (40, 170, 120))
        mp.png_save("calibration_diagnostics.png", img)
    print("[png] calibration_diagnostics.png written")


build_figure_diagnostics()
# ----------------------------------------------------------------------
# 8. Write outputs
# ----------------------------------------------------------------------
cal_out = pd.DataFrame([{
    "gyro_bias_rad_s": bias_hat,
    "time_offset_s": delta_hat,
    "yaw_extrinsic_rad": ext_hat,
}])
cal_out.to_csv("calibration.csv", index=False)
obs_out.to_csv("observability.csv", index=False)
resid_out.to_csv("residuals.csv", index=False)

metrics = {
    "dataset": {
        "imu_rows": int(len(imu)), "imu_hz": round(1 / DT, 3),
        "lidar_rows": int(len(lid)), "train_rows": int(len(train)),
        "heldout_rows": int(len(hold)), "segments": int(len(seg)),
        "match_duration_s": TMATCH,
        "declared_sigma_yaw_rad": SIG_YAW, "declared_sigma_trans_m": SIG_TRANS,
    },
    "model": {
        "rotation_channel": "dyaw_k = int_{t0_k+delta}^{t1_k+delta} (omega(t) - bias) dt",
        "extrinsic_convention": "yaw_extrinsic = yaw of body/IMU->lidar rotation R_IL (T_IL); "
                                "travel direction in LIDAR frame at heading = yaw_extrinsic",
        "time_offset_convention": "delta positive shifts lidar interval to later IMU time; "
                                  "estimate near zero reflects weak identifiability",
    },
    "parameters": {
        "gyro_bias_rad_s": bias_hat, "time_offset_s": delta_hat, "yaw_extrinsic_rad": ext_hat,
    },
    "uncertainty": {
        "time_offset_sd": sd_delta,
        "time_offset_95ci": [delta_hat - 2 * sd_delta, delta_hat + 2 * sd_delta],
        "gyro_bias_sd": sd_bias,
        "gyro_bias_aggregate_check": bias_check,
        "gyro_bias_bootstrap_95ci": [float(b_boot_lo), float(b_boot_hi)],
        "yaw_extrinsic_se": ext_se,
        "yaw_extrinsic_bootstrap_95ci": [float(e_lo), float(e_hi)],
        "note_time_offset_weakly_identifiable": "omega is smooth within 0.11 s scans; "
            "per-scan sensitivity to delta (omega(t1)-omega(t0)) is small, CRB ~ 0.01 s",
        "yaw_extrinsic_sign_convention_disclosure": "yaw_extrinsic_rad = +0.032 uses the "
            "body/IMU->lidar (T_IL) convention: rotation body/IMU->LIDAR is Rz(yaw_extrinsic), "
            "so the robot's travel direction in the LIDAR frame sits at heading = yaw_extrinsic. "
            "This frame-order convention is NOT specified by task_info.json/data semantics and is "
            "the single remaining data-inherent uncertainty: if the reference convention is the "
            "reverse (lidar->body), the value must be negated (-0.032). All internal residual "
            "computations use the +0.032 value consistently.",
    },
    "residual_diagnostics": {
        "train_yaw_residual_std": float(ry_tr.std()),
        "train_yaw_residual_mean": float(ry_tr.mean()),
        "train_trans_residual_std": float(rt_tr.std()),
        "heldout_yaw_residual_std": float(ry_ho.std()),
        "heldout_yaw_residual_mean": float(ry_ho.mean()),
        "heldout_trans_residual_std": float(rt_ho.std()),
        "heldout_trans_residual_mean": float(rt_ho.mean()),
        "residual_yaw_wrapped_to": "[-pi, pi)",
        "residual_trans_definition_m": "signed transverse (perpendicular) component of the "
            "measured lidar translational delta relative to the mean direction of travel "
            "after removing the yaw extrinsic; rt = -sin(ext)*dx + cos(ext)*dy",
    },
    "observability": {
        "formula": "score = w_delta*(I_delta/max) + w_bias*(I_bias/max) + w_ext*(I_ext/max), "
                   "with w = task parameter weights {time_offset:0.4, bias:0.25, yaw:0.35}",
        "components": ["I_delta = sum((omega(t1)-omega(t0))^2)/sigma_yaw^2  (time-offset info)",
                       "I_bias = n_scans * T^2 / sigma_yaw^2  (bias info)",
                       "I_ext  = sum((|delta|/sigma_trans)^2)  (extrinsic/translation info)"],
        "per_segment": obs[["segment_id", "I_delta", "I_bias", "I_ext", "observability_score"]]
                       .round(6).to_dict(orient="records"),
    },
    "fit_note": "Only split=train rows used for fitting; heldout rows used for diagnostics only.",
}

with open("metrics.json", "w") as f:
    json.dump(metrics, f, indent=2)

print("[csv] calibration.csv / observability.csv / residuals.csv ; [json] metrics.json written")
print("DONE")
