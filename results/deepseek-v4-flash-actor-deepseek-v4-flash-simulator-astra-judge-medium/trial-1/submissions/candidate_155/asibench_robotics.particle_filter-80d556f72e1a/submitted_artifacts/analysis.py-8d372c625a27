def _text_w(s, scale=1):
    return sum((5 + 1) * scale for _ in s) - scale

def draw_text(img, s, x, y, rgb, scale=1):
    cx = x
    for ch in s:
        g = FONT.get(ch, FONT[' '])
        for row in range(7):
            for col in range(5):
                if g[row * 5 + col] == '#':
                    for dy in range(scale):
                        for dx in range(scale):
                            _put(img, cx + col * scale + dx, y + row * scale + dy, rgb)
        cx += (5 + 1) * scale

def _put(img, x, y, rgb):
    H, W = img.shape[:2]
    if 0 <= x < W and 0 <= y < H:
        img[y, x] = rgb

def _fill(img, x0, y0, x1, y1, rgb):
    x0, x1 = int(max(0, min(x0, x1))), int(min(img.shape[1], max(x0, x1)))
    y0, y1 = int(max(0, min(y0, y1))), int(min(img.shape[0], max(y0, y1)))
    img[y0:y1, x0:x1] = rgb

def _fill_alpha(img, x0, y0, x1, y1, rgb, a):
    x0, x1 = int(max(0, min(x0, x1))), int(min(img.shape[1], max(x0, x1)))
    y0, y1 = int(max(0, min(y0, y1))), int(min(img.shape[0], max(y0, y1)))
    if x1 <= x0 or y1 <= y0:
        return
    sub = img[y0:y1, x0:x1].astype(float)
    img[y0:y1, x0:x1] = (a * np.asarray(rgb) + (1 - a) * sub).astype(np.uint8)

def _rect(img, x0, y0, x1, y1, rgb, th=1):
    _fill(img, x0, y0, x1, y0 + th, rgb)
    _fill(img, x0, y1 - th, x1, y1, rgb)
    _fill(img, x0, y0, x0 + th, y1, rgb)
    _fill(img, x1 - th, y0, x1, y1, rgb)

def _line(img, x0, y0, x1, y1, rgb, th=1):
    x0, y0, x1, y1 = int(x0), int(y0), int(x1), int(y1)
    dx = abs(x1 - x0); dy = -abs(y1 - y0)
    sx = 1 if x0 < x1 else -1; sy = 1 if y0 < y1 else -1
    err = dx + dy
    while True:
        for a in range(-(th // 2), (th + 1) // 2):
            for b in range(-(th // 2), (th + 1) // 2):
                _put(img, x0 + a, y0 + b, rgb)
        if x0 == x1 and y0 == y1:
            break
        e2 = 2 * err
        if e2 >= dy:
            err += dy; x0 += sx
        if e2 <= dx:
            err += dx; y0 += sy

def _write_png(path, img):
    h, w = img.shape[:2]
    def chunk(typ, data):
        return (_struct.pack(">I", len(data)) + typ + data +
                _struct.pack(">I", _zlib.crc32(typ + data) & 0xffffffff))
    raw = b"".join(b"\x00" + img[y].tobytes() for y in range(h))
    png = b"\x89PNG\r\n\x1a\n"
    png += chunk(b"IHDR", _struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0))
    png += chunk(b"IDAT", _zlib.compress(raw, 6))
    png += chunk(b"IEND", b"")
    with open(path, "wb") as f:
        f.write(png)

def _fmt(v):
    if abs(v - round(v)) < 1e-9:
        return str(int(round(v)))
    s = f"{v:.2f}"
    return s

def _plot_series(img, box, ys, colors, labels, ylabel, title, xlim=None,
                 xlabel=None, hband=None, markers_first=None):
    """box=(x0,y0,x1,y1). ys: list of (xv, yv). markers_first: dict ci->set of point idx."""
    x0, y0, x1, y1 = box
    draw_text(img, title, x0 + 4, y0 + 2, (0, 0, 0), 1)
    ml, mr, mt0, mb = 56, 12, 18 + 10, 22
    ax0, ay0, ax1, ay1 = x0 + ml, y0 + mt0, x1 - mr, y1 - mb
    px0, py0, px1, py1 = ax0 + 6, ay0 + 6, ax1 - 6, ay1 - 6
    vmin, vmax = np.inf, -np.inf
    for (xv, yv) in ys:
        vv = np.asarray(yv, float)[np.isfinite(yv)]
        if vv.size:
            vmin = min(vmin, float(np.nanmin(vv)))
            vmax = max(vmax, float(np.nanmax(vv)))
    if vmin == vmax:
        vmin -= 0.5; vmax += 0.5
    pad = 0.08 * (vmax - vmin)
    vmin -= pad; vmax += pad
    for g in range(5):
        gy = py1 - (py1 - py0) * g / 4
        _line(img, px0, gy, px1, gy, (228, 228, 228), 1)
    if hband is not None:
        xv0 = np.asarray(ys[0][0], float)
        dx = xv0[-1] - xv0[0]
        for (hs, he) in hband:
            bxs = px0 + (px1 - px0) * (hs - xv0[0]) / dx
            bxe = px0 + (px1 - px0) * (he - xv0[0]) / dx
            _fill_alpha(img, bxs, py0, bxe, py1, (255, 165, 0), 0.16)
    _rect(img, px0, py0, px1, py1, (0, 0, 0), 1)
    for ci, (xv, yv) in enumerate(ys):
        col = colors[ci % len(colors)]
        xv = np.asarray(xv, float); yv = np.asarray(yv, float)
        if xlim is None:
            xlo, xhi = float(np.nanmin(xv)), float(np.nanmax(xv))
        else:
            xlo, xhi = xlim
        def X(u): return px0 + (px1 - px0) * (u - xlo) / (xhi - xlo)
        def Y(u): return py1 - (py1 - py0) * (u - vmin) / (vmax - vmin)
        valid = np.isfinite(xv) & np.isfinite(yv)
        prev = None
        for i in range(len(xv)):
            if not valid[i]:
                prev = None; continue
            cx, cy = X(xv[i]), Y(yv[i])
            if markers_first is not None and i in markers_first.get(ci, set()):
                for a in range(-3, 4):
                    for b in range(-3, 4):
                        if a * a + b * b <= 9:
                            _put(img, int(cx + a), int(cy + b), (220, 20, 60))
            if prev is not None:
                _line(img, X(prev[0]), Y(prev[1]), cx, cy, col, 2)
            prev = (xv[i], yv[i])
    for g in range(5):
        gy = py1 - (py1 - py0) * g / 4
        try:
            tv = vmin + (vmax - vmin) * g / 4
        except Exception:
            tv = 0.0
        lab = _fmt(tv)
        tw = _text_w(lab, 1)
        draw_text(img, lab, px0 - tw - 6, int(gy) - 4, (0, 0, 0), 1)
    if xlim is not None:
        xlo2, xhi2 = xlim
    else:
        xlo2, xhi2 = float(np.nanmin(xs0 := np.asarray(ys[0][0], float))), float(np.nanmax(xs0))
    n_ticks = 3
    for g in range(n_ticks):
        gx = px0 + (px1 - px0) * g / (n_ticks - 1)
        lab = _fmt(xlo2 + (xhi2 - xlo2) * g / (n_ticks - 1))
        draw_text(img, lab, int(gx) - 3, py1 + 6, (0, 0, 0), 1)
    if xlabel is not None:
        draw_text(img, xlabel, px1 - _text_w(xlabel, 1) - 4, py1 + 6, (0, 0, 0), 1)
    draw_text(img, ylabel, 4, ay0 + (ay1 - ay0) // 2, (0, 0, 0), 1)
    lx = px1 - 62; ly = ay0 + 4
    for ci in range(len(ys)):
        if labels and ci < len(labels) and labels[ci]:
            lyy = ly + ci * 10
            _line(img, lx, lyy + 3, lx + 14, lyy + 3, colors[ci % len(colors)], 2)
            draw_text(img, labels[ci][:18], lx + 18, lyy - 2, (0, 0, 0), 1)

def _new_canvas(W, H):
    return np.full((H, W, 3), 255, dtype=np.uint8)


def render_overview(rec, t, r_meas, th_meas, mask, p_refx, p_refy, ref_ok,
                    maneuver_intervals, wrap_events, resampling_count, ess_min,
                    pos_rmse, vel_rmse, mean_nees):
    W, H = 1600, 1050
    img = _new_canvas(W, H)
    draw_text(img, "OVERVIEW - deterministic target-tracking audit  (SIR particle filter, N=%d)" % N_PARTICLES,
              40, 12, (0, 0, 0), 2)
    draw_text(img, "state [px,py,vx,vy,b_r];  robust gated range-bearing likelihood;  adaptive process noise on maneuvers;  "
                   "proxies vs measurement reference",
              40, 44, (0, 0, 0), 1)
    top = 78; gpx = 26; gpy = 30
    pw = (W - 5 * gpx) // 3; ph = (H - top - 4 * gpy) // 2
    boxes = []
    for r in range(2):
        for c in range(3):
            x0 = gpx + c * (pw + gpx); y0 = top + gpy + r * (ph + gpy)
            boxes.append((x0, y0, x0 + pw, y0 + ph))
    n = len(t)

    # ---- panel 1: trajectory ----
    bx = boxes[0]
    _rect(img, bx[0], bx[1], bx[2], bx[3], (0, 0, 0), 1)
    draw_text(img, "Trajectory: measurement reference vs PF estimate", bx[0] + 4, bx[1] + 4, (0, 0, 0), 1)
    x0, y0, x1, y1 = bx[0] + 56, bx[1] + 44, bx[2] - 12, bx[3] - 24
    px0, py0, px1, py1 = x0 + 6, y0 + 6, x1 - 6, y1 - 6
    lo = min(float(np.nanmin(p_refx[ref_ok])), float(np.nanmin(p_refy[ref_ok])))
    hi = max(float(np.nanmax(p_refx[ref_ok])), float(np.nanmax(p_refy[ref_ok])))
    pad = 0.08 * (hi - lo); lo -= pad; hi += pad
    def X(u): return px0 + (px1 - px0) * (u - lo) / (hi - lo)
    def Y(u): return py1 - (py1 - py0) * (u - lo) / (hi - lo)
    _rect(img, px0, py0, px1, py1, (0, 0, 0), 1)
    for i in np.where(ref_ok)[0]:
        cx, cy = X(p_refx[i]), Y(p_refy[i])
        for a in range(-2, 3):
            for b in range(-2, 3):
                if a * a + b * b <= 4:
                    _put(img, int(cx + a), int(cy + b), (128, 128, 128))
    estx, esty = rec["est_px"], rec["est_py"]
    for i in range(n - 1):
        _line(img, X(float(estx[i])), Y(float(esty[i])), X(float(estx[i + 1])), Y(float(esty[i + 1])),
              (31, 119, 180), 2)
    # start marker
    sx, sy = X(float(estx[0])), Y(float(esty[0]))
    for a in range(-4, 5):
        for b in range(-4, 5):
            if a * a + b * b <= 16:
                _put(img, int(sx + a), int(sy + b), (20, 140, 20))
    draw_text(img, "start", int(sx) + 8, int(sy) - 6, (20, 140, 20), 1)
    draw_text(img, "gray dots=meas ref   blue line=PF estimate   green=start",
              px0 + 4, py0 - 16, (0, 0, 0), 1)

    # ---- panel 2: range ----
    r_est = np.sqrt(rec["est_px"] ** 2 + rec["est_py"] ** 2) + rec["est_bias"]
    rm = np.where(mask[:, 0], r_meas, np.nan)
    _plot_series(img, boxes[1],
                 [(t, rm), (t, r_est)],
                 [(34, 139, 34), (31, 119, 180)],
                 ["range meas", "pred range"], "r",
                 "Channel 0: range (orange = maneuver, red = missing t22-31)",
                 xlim=(float(t[0]), float(t[-1])), xlabel="t", hband=maneuver_intervals)

    # ---- panel 3: bearing ----
    th_est = np.arctan2(rec["est_py"], rec["est_px"])
    thm = np.where(mask[:, 1], th_meas, np.nan)
    wrap_ids = {i + 1 for i in wrap_events}
    _plot_series(img, boxes[2],
                 [(t, thm), (t, th_est)],
                 [(147, 51, 153), (31, 119, 180)],
                 ["bearing meas", "pred bearing"], "theta",
                 "Channel 1: bearing wrapped to [-pi,pi]; red marker at wrap",
                 xlim=(float(t[0]), float(t[-1])), xlabel="t", hband=maneuver_intervals,
                 markers_first={0: wrap_ids})

    # ---- panel 4: covariances ----
    _plot_series(img, boxes[3],
                 [(t, rec["cov_px"]), (t, rec["cov_py"]), (t, rec["cov_vx"]), (t, rec["cov_vy"])],
                 [(31, 119, 180), (255, 127, 14), (44, 160, 44), (214, 39, 40)],
                 ["cov_px", "cov_py", "cov_vx", "cov_vy"], "cov",
                 "State covariance diagonals (grow during gaps, shrink with data)",
                 xlim=(float(t[0]), float(t[-1])), xlabel="t", hband=maneuver_intervals)

    # ---- panel 5: ESS + resampled + degeneracy threshold ----
    resampled_idx = np.where(rec["resampled"] == 1)[0]
    deg_line = np.full(n, N_PARTICLES * DEGENERACY_FRAC)
    _plot_series(img, boxes[4],
                 [(t, rec["ess"]), (t, deg_line)],
                 [(31, 119, 180), (220, 20, 60)],
                 ["ESS", "degeneracy thresh"], "ESS",
                 "Effective sample size  (resamples=%d, ess_min=%.0f)" % (resampling_count, ess_min),
                 xlim=(float(t[0]), float(t[-1])), xlabel="t", hband=maneuver_intervals,
                 markers_first={0: set(int(i) for i in resampled_idx)})

    # ---- panel 6: diagnostics proxies ----
    _plot_series(img, boxes[5],
                 [(t, rec["rmse_pos"]), (t, rec["rmse_vel"]), (t, rec["bearing_res_mean"])],
                 [(214, 39, 40), (255, 127, 14), (44, 160, 44)],
                 ["rmse_pos", "rmse_vel", "bear resid"], "err",
                 "Diagnostics proxies: pos_rmse=%.3f vel_rmse=%.3f mean_nees=%.2f" % (pos_rmse, vel_rmse, mean_nees),
                 xlim=(float(t[0]), float(t[-1])), xlabel="t", hband=maneuver_intervals)

    _write_png("results/overview.png", img)


