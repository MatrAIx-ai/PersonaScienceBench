"""
TASK008 BCG-CORONA — COVID-19 severity by patient-volume group, BCG vs placebo (chi-square)
BixBench bix-10-q3 | approved plan implementation.

Design (approved):
 1) COVID-19 case   : subject with >=1 AE record whose AEPT contains 'COVID' or 'SARS'
 2) Severity        : per-subject MAX AEHS (0-7) over that subject's COVID records
 3) Primary collapse: mild (0-2) vs moderate/severe (3-7); sensitivity 0-3 vs 4-7
 4) Volume group    : DM.patients_seen (1-50 / 51-100 / >100), join on USUBJID
 5) Treatment       : TRTGRP (verified 100% vs EX actual drug)
 6) Per group chi-square (chi2_contingency); when any expected<5 -> Fisher exact + Monte-Carlo permutation reported too.
Sensitivity A  : denominator = COVID cases only (primary, n=197)
Sensitivity B  : denominator = all subjects (non-COVID severity = 0, n=1000)
"""
import numpy as np
import pandas as pd
from scipy import stats

AE = pd.read_csv('data/TASK008_BCG-CORONA_AE.csv', dtype=str, encoding='latin-1')
DM = pd.read_csv('data/TASK008_BCG-CORONA_DM.csv', dtype=str, encoding='latin-1')

# ---- 1. COVID cases & per-subject severity ----
cov = AE[AE['AEPT'].str.contains('COVID|SARS', case=False, na=False)].copy()
cov['hs'] = pd.to_numeric(cov['AEHS'], errors='coerce')
subj = cov.groupby('USUBJID').agg(max_aehs=('hs', 'max'), TRTGRP=('TRTGRP', 'first')).reset_index()
subj = subj.merge(DM[['USUBJID', 'patients_seen']], on='USUBJID')
print(f'COVID AE records: {len(cov)} | unique COVID subjects: {len(subj)}')
assert subj['max_aehs'].notna().all()  # AEHS complete for COVID records

# ---- 2. helper to test a contingency table ----
def test_table(tbl, label):
    """tbl: 2 x k observed. Returns dict with chi-square (uncorrected & Yates 2x2), Fisher, permutation p."""
    obs = np.asarray(tbl, dtype=float)
    out = {}
    # Pearson chi-square
    chi2, p_chi, dof, exp = stats.chi2_contingency(obs, correction=False)
    out['chi2'] = chi2; out['p_chi'] = p_chi; out['dof'] = dof; out['expected'] = exp
    out['min_expected'] = exp.min()
    # Yates correction (only meaningful 2x2)
    if obs.shape == (2, 2):
        chi2y, p_y = stats.chi2_contingency(obs, correction=True)[:2]
        out['p_yates'] = p_y
    # Fisher exact (2x2 only)
    if obs.shape == (2, 2):
        odds, p_fish = stats.fisher_exact(obs)
        out['odds'] = odds; out['p_fisher'] = p_fish
    # Monte-Carlo permutation p (fixed margins, 100k)
    rng = np.random.default_rng(42)
    nperm = 100_000
    row_tot = obs.sum(axis=1); col_tot = obs.sum(axis=0); n = obs.sum()
    if n > 0 and obs.shape == (2, 2):
        def stat(mat):  # Pearson chi2 stat
            a = mat.sum()
            exp = np.outer(row_tot, col_tot) / a
            with np.errstate(all='ignore'):
                return np.nansum((mat - exp) ** 2 / np.where(exp == 0, np.nan, exp))
        obs_stat = stat(obs)
        # simulate 2x2 tables with same margins via hypergeometric (column 0 count in row 0)
        k = row_tot[0]
        sim_col0 = rng.hypergeometric(col_tot[0], col_tot[1], k, size=nperm)
        sim = np.zeros((nperm, 2, 2))
        sim[:, 0, 0] = sim_col0; sim[:, 0, 1] = row_tot[0] - sim_col0
        sim[:, 1, 0] = col_tot[0] - sim_col0; sim[:, 1, 1] = row_tot[1] - (col_tot[0] - sim_col0)
        sim_stats = np.array([stat(m) for m in sim])
        out['p_perm'] = (sim_stats >= obs_stat).mean()
    printout(out, label)
    return out

def printout(o, label):
    print(f'--- {label}')
    print(f'    chi2={o.get("chi2", np.nan):.3f}  dof={o.get("dof")}  p_chi={o.get("p_chi", np.nan):.4f}'
          f'  min_expected={o.get("min_expected", np.nan):.2f}')
    if 'p_yates' in o:   print(f'    Yates p={o["p_yates"]:.4f}  Fisher p={o["p_fisher"]:.4f} (odds={o["odds"]:.3f})  perm p={o["p_perm"]:.4f}')

def collapse(vals, cut):
    """vals: per-subject severity. Return 2-category labels: 0 if <=cut else 1."""
    return (vals > cut).astype(int)

def run_denominator(df, cut, denom_name):
    print('\n' + '=' * 78)
    print(f'DENOMINATOR: {denom_name}  | severity cut: {cut} (severe = AEHS>{cut})')
    print('=' * 78)
    res = {}
    for g in ['1-50', '51-100', '>100']:
        d = df[df['patients_seen'] == g]
        sev = collapse(d['max_aehs'], cut)
        # order rows BCG, Placebo
        tbl = np.array([
            [int(((d.TRTGRP=='BCG') & (sev==0)).sum()), int(((d.TRTGRP=='BCG') & (sev==1)).sum())],
            [int(((d.TRTGRP=='Placebo') & (sev==0)).sum()), int(((d.TRTGRP=='Placebo') & (sev==1)).sum())],
        ])
        print(f'\nGroup {g}  |  BCG n={int((d.TRTGRP=="BCG").sum())}, Placebo n={int((d.TRTGRP=="Placebo").sum())}')
        print(f'  mild/severe counts -> BCG {list(tbl[0])} | Placebo {list(tbl[1])}')
        res[g] = test_table(tbl, f'group {g}')
    return res

# ---- Denominator A: COVID cases only ----
subjA = subj.copy()
resA_cut1 = run_denominator(subjA, 2, 'COVID cases only (n=197)  [PRIMARY]')
resA_cut2 = run_denominator(subjA, 3, 'COVID cases only (n=197)  [SENSITIVITY cut: severe=AEHS>3 i.e. 4-7]')

# ---- Denominator B: all subjects (non-COVID = 0) ----
allsubj = DM[['USUBJID', 'TRTGRP', 'patients_seen']].copy()
allsubj['max_aehs'] = allsubj['USUBJID'].map(subj.set_index('USUBJID')['max_aehs']).fillna(0)
resB_cut1 = run_denominator(allsubj, 2, 'ALL subjects, non-COVID=0 (n=1000)  [SENSITIVITY]')
resB_cut2 = run_denominator(allsubj, 3, 'ALL subjects, non-COVID=0 (n=1000)  [SENSITIVITY cut: severe>3]')

# ---- Full 0-7 ordinal test (chi-square 2xk) for informational completeness ----
print('\n' + '=' * 78)
print('INFORMATION: full 0-7 ordinal arm x severity (COVID cases only), chi-square 2x8')
print('=' * 78)
for g in ['1-50', '51-100', '>100']:
    d = subj[subj['patients_seen'] == g]
    cats = sorted(d['max_aehs'].unique())
    tbl = np.array([[int(((d.TRTGRP==a) & (d.max_aehs==c)).sum()) for c in range(8)] for a in ['BCG','Placebo']])
    print(f'\nGroup {g} full 0-7 table (rows BCG/Placebo):\n{tbl}')
    try:
        chi2, p, dof, exp = stats.chi2_contingency(tbl, correction=False)
        print(f'  chi2={chi2:.3f} dof={dof} p={p:.4f} min_expected={exp.min():.2f}')
    except Exception as e:
        print('  test failed:', e)

print('\nDONE.')
