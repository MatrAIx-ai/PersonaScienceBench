"""BixBench bix-14-q3 — full reproducible count of non-reference exonic CHIP variants.
Criteria (researcher-approved):
  - CHIP genes: 56-gene list in data/230214_Schenz_et_al_2022_CHIP_Genes.xlsx
    (comma-split exact-uppercase token match); sensitivity = use file In_CHIP flag instead.
  - Reference filter: Zygosity == 'Reference' excluded; keep Heterozygous/Homozygous Variant;
    Zygosity=None counted in primary (sensitivity: excluded).
  - Exonic: RefSeq110 Sequence Ontology (Combined) in
    {missense_variant, synonymous_variant, frameshift_variant, inframe_insertion,
     inframe_deletion}; excludes intron/3'UTR/5'UTR/5'UTR_premature/upstream/splice_region
    (sensitivity: splice_region_variant included).
  - Counting: within-file dedup by (Chr:Pos, Ref/Alt); primary = sum across 86 samples;
    sensitivity = unique variant count across samples.
"""
import glob, json, csv
from collections import Counter
import openpyxl

DATA = "data/CHIP_DP10_GQ20_PASS"
FILES = sorted(glob.glob(f"{DATA}/*.xlsx"))

def load_chip_genes():
    wb = openpyxl.load_workbook("data/230214_Schenz_et_al_2022_CHIP_Genes.xlsx", data_only=True)
    ws = wb["Sheet1"]
    return set(str(ws.cell(row=r, column=1).value).strip()
               for r in range(1, ws.max_row + 1)
               if ws.cell(row=r, column=1).value is not None)

CHIP = load_chip_genes()
EXONIC = {"missense_variant", "synonymous_variant", "frameshift_variant",
          "inframe_insertion", "inframe_deletion"}
EXONIC_SPLICE = EXONIC | {"splice_region_variant"}

def in_chip_gene(gene_str):
    return any(t in CHIP for t in str(gene_str).split(","))

def run(splice_in_exonic=False, count_none=True, chip_flag=False):
    """Return {total_rows, after_dedup, nonref, exonic, chip_rows, unique_keys} for primary path
    plus breakdown counts per filter step (counting rows before within-file dedup), and
    nonref/exonic/chip counts that INCLUDE reference rows (for layered reporting)."""
    per_sample = []
    unique = set()
    # layer counters (row-level, before within-file dedup)
    R_total = 0; R_nonref = 0; R_exonic = 0; R_chip = 0
    for f in FILES:
        wb = openpyxl.load_workbook(f, data_only=True)
        ws = wb.worksheets[0]
        rows = list(ws.iter_rows(min_row=3, values_only=True))
        wb.close()
        sample_id = f.split("_CHIP_")[-1].replace(".xlsx", "")
        seen = set()
        n_total = n_nonref = n_exonic = n_chip = 0
        for row in rows:
            R_total += 1; n_total += 1
            zy = row[4]
            so = row[13]
            gene = row[12]
            chip_ok = (str(row[29]) == 'True' if chip_flag else in_chip_gene(gene))  # In_CHIP vs 56-gene list
            # layer: non-reference (any zygosity except Reference; None counts if count_none)
            is_nonref = (zy != "Reference") and (count_none or zy is not None)
            if is_nonref: R_nonref += 1; n_nonref += 1
            # layer: exonic (independent of zygosity, for layered diagnostics)
            is_exonic = so in (EXONIC_SPLICE if splice_in_exonic else EXONIC)
            if is_exonic: R_exonic += 1
            if chip_ok: R_chip += 1
            # final criteria for this sample
            if is_nonref and is_exonic and chip_ok:
                key = (row[0], row[1])
                seen.add(key)
                unique.add(key)
        per_sample.append((sample_id, n_total, n_nonref, len(seen)))
    total_dedup = sum(s for *_, s in per_sample)
    return {
        "splice_in_exonic": splice_in_exonic,
        "count_none": count_none,
        "chip_flag_infile": chip_flag,
        "n_samples": len(per_sample),
        "row_total_all_files": R_total,
        "row_nonref_pre_dedup": R_nonref,
        "row_exonic_pre_dedup": R_exonic,
        "row_chip_pre_dedup": R_chip,
        "sum_after_filters_infile_dedup": total_dedup,
        "unique_across_samples": len(unique),
    }

results = {}
# PRIMARY: 56-gene CHIP list, none counted, splice excluded
results["primary"] = run(splice_in_exonic=False, count_none=True, chip_flag=False)
# sensitivities
results["sens_include_splice"] = run(splice_in_exonic=True, count_none=True, chip_flag=False)
results["sens_exclude_none"] = run(splice_in_exonic=False, count_none=False, chip_flag=False)
results["sens_in_chip_flag"] = run(splice_in_exonic=False, count_none=True, chip_flag=True)

print(json.dumps(results, indent=2))

with open("chip_results.json", "w") as fh:
    json.dump(results, fh, indent=2)
print("saved: chip_results.json")

# per-sample primary counts
per_sample = []
for f in FILES:
    wb = openpyxl.load_workbook(f, data_only=True)
    ws = wb.worksheets[0]
    rows = list(ws.iter_rows(min_row=3, values_only=True)); wb.close()
    sample_id = f.split("_CHIP_")[-1].replace(".xlsx", "")
    seen = set(); n_total = 0; n_nonref = 0
    for row in rows:
        n_total += 1
        zy = row[4]; so = row[13]
        if zy != "Reference" and so in EXONIC and in_chip_gene(row[12]):
            n_nonref += 1; seen.add((row[0], row[1]))
    per_sample.append((sample_id, n_total, n_nonref, len(seen)))
with open("per_sample_primary.csv", "w", newline="") as fh:
    w = csv.writer(fh); w.writerow(["sample", "total_rows", "nonref_exonic_chip_rows_pre_dedup", "after_infile_dedup"])
    w.writerows(per_sample)
print("saved: per_sample_primary.csv (n_samples=%d, sum_dedup=%d)" % (len(per_sample), sum(p[3] for p in per_sample)))
