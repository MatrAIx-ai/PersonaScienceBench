#!/usr/bin/env python3
"""
BixBench bix-16-q2: skewness of the gene expression (log2(TPM+1), batch-corrected)
distribution pooled across all cell lines x all protein-coding genes.

Data: OmicsExpressionProteinCodingGenesTPMLogp1BatchCorrected.csv
Rows = cell lines (DepMap ModelID, ACH-xxx); Columns = protein-coding genes "GENE (EntrezID)".
Values are ALREADY log2(TPM+1) and batch-corrected -> used as-is, no further transform.
Batch-correction artefacts (negative values) are retained (not clipped/floored).

Method: pool all 1673 x 19138 = n values into one distribution (equal weight);
compute Fisher-Pearson moment skewness g1 = m3/m2^(3/2), bias-corrected G1,
standard error SE, 95% CI, plus mean/median/quantiles/histogram for shape context.
The pooled array (n x float64 ~ 256 MB) is held in memory; moments computed in a
numerically stable two-pass (mean first, then centralized sums of squares/cubes).
"""
import numpy as np
from scipy import stats
import json, time, os

SRC = "data/OmicsExpressionProteinCodingGenesTPMLogp1BatchCorrected.csv"
N_GENES = 19138

t0 = time.time()

# ---- 1) load all expression values into one pooled array ----
# count lines first (reuse earlier verified count) but guard within loop
n_rows_total = 0
rows = []  # not needed; we read directly
values = np.empty(N_GENES * 1673, dtype=np.float64)
n_fill = 0
row_ids = []
with open(SRC) as f:
    header = f.readline().rstrip("\n").split(",")
    gene_cols = header[1:]
    for line in f:
        parts = line.rstrip("\n").split(",", 1)
        rid = parts[0]
        row_ids.append(rid)
        vals = np.fromstring(parts[1], sep=",", dtype=np.float64)
        if vals.size != N_GENES:
            raise RuntimeError(f"row {rid}: expected {N_GENES} values, got {vals.size}")
        values[n_fill:n_fill + N_GENES] = vals
        n_fill += N_GENES
        n_rows_total += 1

values = values[:n_fill]
n = values.size
n_rows = n // N_GENES
print(f"loaded {n_rows} rows x {N_GENES} genes = n={n} values "
      f"({time.time()-t0:.1f}s)")

# sanity: no NaN / inf
print("NaNs:", int(np.isnan(values).sum()), " Infs:", int(np.isinf(values).sum()))

# ---- 2) location / scale / quantiles ----
mean = values.mean()
std = values.std(ddof=0)
median = np.median(values)
qs = {p: float(np.quantile(values, p)) for p in
      [0.001, 0.01, 0.05, 0.25, 0.5, 0.75, 0.95, 0.99, 0.999]}
vmin, vmax = float(values.min()), float(values.max())

# ---- 3) skewness (moments, two-pass for stability) ----
m2 = np.sum((values - mean) ** 2) / n          # variance m2
m3 = np.sum((values - mean) ** 3) / n          # third central moment m3
g1 = m3 / (m2 ** 1.5)                            # Fisher-Pearson moment skewness
G1 = np.sqrt(n * (n - 1)) / (n - 2) * g1         # bias-corrected
SE = np.sqrt(6.0 * n * (n - 1) / ((n - 2) * (n + 1) * (n + 3)))  # standard error of g1
z = 1.959963984540054
ci = (g1 - z * SE, g1 + z * SE)

# cross-check with scipy
g1_sp = float(stats.skew(values, bias=True))
G1_sp = float(stats.skew(values, bias=False))

# ---- 4) histogram (data only, no plotting lib available) ----
counts, edges = np.histogram(values, bins=100, range=(float(np.floor(vmin)), float(np.ceil(vmax))))
hist = {"bins": int(counts.size),
        "counts": counts.astype(int).tolist(),
        "edges": edges.tolist()}
# right-tail measure: 99th vs 50th, and mass above mean+3sd
p99 = qs[0.99]
p50 = qs[0.5]
tail_above_3sd = float((values > mean + 3 * std).mean())

# ---- 5) output ----
summary = {
    "source": SRC,
    "n_cell_lines": n_rows,
    "n_genes": N_GENES,
    "n_pooled_values": int(n),
    "n_missing": 0,
    "transformation": "used as-is (already log2(TPM+1) batch-corrected); "
                      "negative batch-correction values retained",
    "mean": float(mean),
    "median": float(median),
    "std": float(std),
    "mean_minus_median": float(mean - median),
    "min_max": [vmin, vmax],
    "quantiles": {str(k): v for k, v in qs.items()},
    "skewness_g1_moment": float(g1),
    "skewness_G1_bias_corrected": float(G1),
    "skewness_scipy_bias_true": g1_sp,
    "skewness_scipy_bias_false": G1_sp,
    "se_g1": float(SE),
    "ci95": [ci[0], ci[1]],
    "right_tail": {
        "p99": p99,
        "p99_minus_p50": float(p99 - p50),
        "frac_above_mean_plus_3sd": tail_above_3sd,
        "max": vmax,
    },
    "conclusion": ("The pooled gene expression (log2(TPM+1), batch-corrected) "
                   "distribution across all cell lines is strongly RIGHT-SKEWED "
                   f"(positive): g1={g1:.4f}, SE={SE:.6f}, 95% CI=[{ci[0]:.4f}, {ci[1]:.4f}] "
                   f"(excludes 0), mean={mean:.3f} > median={median:.3f}, long right tail "
                   f"(p99={p99:.3f}, max={vmax:.2f})."),
}
with open("summary.json", "w") as f:
    json.dump(summary, f, indent=2)
with open("histogram.json", "w") as f:
    json.dump(hist, f, indent=2)

# text histogram (compact) for the report
print("\nText histogram (log10 frequency):")
nb = hist["bins"]
cmax = max(counts)
for i, c in enumerate(counts):
    bar = int(np.log10(c + 1) / np.log10(cmax + 1) * 60)
    print(f"[{edges[i]:6.1f},{edges[i+1]:6.1f}) {'#'*bar} n={c:,}")

print("\n===== SUMMARY =====")
for k, v in summary.items():
    if k != "conclusion":
        print(f"{k}: {v}")
print("\nCONCLUSION:\n", summary["conclusion"])
print(f"\nwall time: {time.time()-t0:.1f}s")
