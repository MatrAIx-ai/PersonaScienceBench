"""
BixBench bix-22-q2: Pearson correlation between gene length and mean expression
across CD4 immune cells for protein-coding genes.

PRIMARY DEFINITION (approved):
  - CD4 sample set   : the 151 sample IDs with celltype == 'CD4' (verified to match
                       the 151 CD4-labelled columns 1:1).
  - Mean expression  : arithmetic mean of the raw (batch-corrected) read counts
                       across the 151 CD4 samples, per gene.
  - Alignment        : Geneid in GeneMetaInfo_Zenodo.csv vs the expression matrix
                       (Unnamed: 0 / row labels), verified identical row order.
  - Correlation      : scipy.stats.pearsonr(Length, mean_expression) over ALL
                       19,942 protein-coding genes, including genes with mean = 0.

Sensitivity table: mean log2(x+1); log2(mean) with zeros excluded; Spearman;
CPM-based variants.
"""
import json
import numpy as np
import pandas as pd
from scipy.stats import pearsonr, spearmanr

RESULTS = {}

# ---------------- 1. Load & schema check ----------------
meta = pd.read_csv('data/GeneMetaInfo_Zenodo.csv', index_col=0)
expr = pd.read_csv('data/BatchCorrectedReadCounts_Zenodo.csv', index_col=0)
ann  = pd.read_csv('data/Sample_annotated_Zenodo.csv')

RESULTS['dims'] = {
    'GeneMetaInfo': list(meta.shape),
    'BatchCorrectedReadCounts': list(expr.shape),
    'Sample_annotated': list(ann.shape),
}
RESULTS['dtypes_meta'] = meta.dtypes.astype(str).to_dict()
RESULTS['missing'] = {
    'GeneMetaInfo': int(meta.isna().sum().sum()),
    'BatchCorrectedReadCounts': int(expr.isna().sum().sum()),
    'Sample_annotated': int(ann.isna().sum().sum()),
}
# malformed / non-numeric Length
Length_num = pd.to_numeric(meta['Length'], errors='coerce')
RESULTS['Length'] = {
    'missing': int(meta['Length'].isna().sum()),
    'non_numeric': int(Length_num.isna().sum()),
    'min': int(meta['Length'].min()), 'max': int(meta['Length'].max()),
    'duplicated_Geneid': int(meta['Geneid'].duplicated().sum()),
    'Geneid_missing': int(meta['Geneid'].isna().sum()),
}

# ---------------- 2. Biotype distribution ----------------
biot = meta['gene_biotype'].value_counts()
RESULTS['biotype_top'] = biot.head(8).astype(int).to_dict()
RESULTS['protein_coding_count'] = int((meta['gene_biotype'] == 'protein_coding').sum())

# ---------------- 3. CD4 mapping ----------------
cd4_samps = ann.loc[ann['celltype'] == 'CD4', 'sample'].tolist()
RESULTS['CD4_count'] = len(cd4_samps)
RESULTS['celltype_counts'] = ann['celltype'].value_counts().astype(int).to_dict()
# exact match of annotation CD4 set vs CD4-labelled expression columns
expr_cd4_cols = [c for c in expr.columns if 'CD4' in c]
RESULTS['expr_CD4_cols'] = len(expr_cd4_cols)
RESULTS['CD4_set_match'] = (set(cd4_samps) == set(expr_cd4_cols))

# ---------------- 4. Expression nature ----------------
vals = expr.values
RESULTS['expression'] = {
    'dtype': str(vals.dtype),
    'all_integer_valued': bool(np.all(vals == np.floor(vals))),
    'min': float(vals.min()), 'max': float(vals.max()),
    'frac_zeros': float((vals == 0).mean()),
    'n_negative': int((vals < 0).sum()),
    'coltotal_min': float(expr.sum(axis=0).min()),
    'coltotal_max': float(expr.sum(axis=0).max()),
    'coltotal_cv': float(expr.sum(axis=0).std() / expr.sum(axis=0).mean()),
}

# ---------------- 5. Alignment check ----------------
RESULTS['row_alignment'] = {
    'meta_index_equals_expr_index': bool((meta.index == expr.index).all()),
    'geneid_equals_index': bool((meta['Geneid'] == meta.index).all()),
}

# ---------------- 6. Primary computation ----------------
pc_mask = (meta['gene_biotype'] == 'protein_coding').values
pc = meta.index[pc_mask]
Results_Length = meta.loc[pc, 'Length'].values.astype(float)
CD4 = expr.loc[pc, cd4_samps]

mean_raw = CD4.values.mean(axis=1)          # arithmetic mean over 151 CD4 samples
n_pc = len(pc)
n_zero_mean_pc = int((mean_raw == 0).sum())

r_primary, p_primary = pearsonr(Results_Length, mean_raw)
RESULTS['primary'] = {
    'definition': 'arithmetic mean of raw (batch-corrected) CD4 read counts per gene',
    'n_protein_coding': n_pc,
    'zero_mean_genes_included': n_zero_mean_pc,
    'pearson_r': float(r_primary),
    'pearson_p': float(p_primary),
}

# ---------------- 7. Sensitivity table ----------------
sens = {}

# (a) mean of log2(x+1) across CD4 (zeros included)
mean_log2 = np.log2(CD4.values + 1).mean(axis=1)
r_a, p_a = pearsonr(Results_Length, mean_log2)
sens['mean_log2_x+1 (zeros incl)'] = {'r': float(r_a), 'p': float(p_a), 'n': n_pc}

# (b) log2(mean raw), zero-mean genes excluded
nz = mean_raw > 0
r_b, p_b = pearsonr(Results_Length[nz], np.log2(mean_raw[nz]))
sens['log2(mean_raw), zeros excl'] = {'r': float(r_b), 'p': float(p_b), 'n': int(nz.sum())}

# (c) raw mean, zero-mean genes excluded (n changes)
r_c, p_c = pearsonr(Results_Length[nz], mean_raw[nz])
sens['raw mean, zeros excl'] = {'r': float(r_c), 'p': float(p_c), 'n': int(nz.sum())}

# (d) Spearman rank (raw mean)
rho_d, p_d = spearmanr(Results_Length, mean_raw)
sens['spearman raw mean'] = {'r': float(rho_d), 'p': float(p_d), 'n': n_pc}

# (e) mean of log2(CPM+1) across CD4 (CPM normalised per sample)
cpm = CD4.values / CD4.values.sum(axis=0, keepdims=True) * 1e6
mean_logcpm = np.log2(cpm + 1).mean(axis=1)
r_e, p_e = pearsonr(Results_Length, mean_logcpm)
sens['mean_log2(CPM+1)'] = {'r': float(r_e), 'p': float(p_e), 'n': n_pc}

RESULTS['sensitivity'] = sens

# ---------------- 8. Output ----------------
print('=' * 78)
print('BixBench bix-22-q2 — gene length vs mean expression, protein-coding, CD4')
print('=' * 78)
print(f'Protein-coding genes (n)                    : {n_pc}')
print(f'CD4 samples used in the mean                : {len(cd4_samps)}')
print(f'Protein-coding genes with zero mean included: {n_zero_mean_pc}')
print()
print('PRIMARY (raw arithmetic mean over CD4 samples):')
print(f'   Pearson r = {r_primary:.6f}')
print(f'   Pearson p = {p_primary:.3e}')
print()
print('SENSITIVITY TABLE')
print(f"{'variant':45s}{'n':>8s}{'r':>12s}{'p':>12s}")
for k, v in sens.items():
    print(f"{k:45s}{v['n']:>8d}{v['r']:>12.6f}{v['p']:>12.3e}")
print()
print('Data quality checks:')
for k, v in RESULTS['missing'].items():
    print(f'   missing values {k}: {v}')
print(f"   meta index == expr index : {RESULTS['row_alignment']['meta_index_equals_expr_index']}")
print(f"   Geneid == row index      : {RESULTS['row_alignment']['geneid_equals_index']}")
print(f"   Length non-numeric       : {RESULTS['Length']['non_numeric']}")
print(f"   CD4 annotation set == CD4 expression cols: {RESULTS['CD4_set_match']}")

with open('results.json', 'w') as fh:
    json.dump(RESULTS, fh, indent=2)
print('\nresults.json written.')
