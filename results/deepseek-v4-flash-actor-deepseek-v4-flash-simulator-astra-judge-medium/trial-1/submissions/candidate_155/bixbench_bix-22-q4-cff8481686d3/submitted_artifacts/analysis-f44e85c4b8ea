#!/usr/bin/env python3
"""
BixBench bix-22-q4 (full_workflow)
What is the Pearson correlation coefficient between gene length and mean
expression (across samples) for protein-coding genes in CD14 immune cells?

Agreed convention (researcher-approved):
  * protein-coding   = gene_biotype == 'protein_coding'            (exact match)
  * CD14 samples     = read-count columns whose name contains 'CD14'
                       (cross-verified: identical to annotation celltype=='CD14')
  * mean expression  = mean of RAW batch-corrected read counts over the 132 CD14 colums
  * MAIN answer      = pearsonr(Length (raw bp), mean_expr (raw) )
                       over all 19,942 protein-coding genes; NO log transform,
                       NO pre-filtering of low/zero-expression genes.
Sensitivity (reported, not the main answer):
  * r(log2(mean+1), Length)
  * r(log10(mean+1), log10(Length))
  * main r after excluding the 1,849 zero-mean genes
Diagnostics: sample-column count, gene counts, missing/duplicate checks.
"""
import pandas as pd
import numpy as np
from scipy.stats import pearsonr

DATA = {
    'meta':  'data/GeneMetaInfo_Zenodo.csv',
    'counts':'data/BatchCorrectedReadCounts_Zenodo.csv',
    'ann':   'data/Sample_annotated_Zenodo.csv',
}

def main():
    # ---------- 1. Load ----------
    meta = pd.read_csv(DATA['meta'], index_col=0)          # index = Geneid
    rc   = pd.read_csv(DATA['counts'], index_col=0)        # index = Geneid
    ann  = pd.read_csv(DATA['ann'])

    print('=' * 70)
    print('DIAGNOSTICS / INPUT VERIFICATION')
    print('=' * 70)
    print(f'GeneMetaInfo rows          : {len(meta)}')
    print(f'ReadCounts shape           : {rc.shape[0]} genes x {rc.shape[1]} cols')
    print(f'Sample_annotated rows      : {len(ann)}')

    # ---------- 2. Missing / duplicate checks ----------
    print('\n-- missing / duplicates --')
    print(f'Geneid duplicates (meta)   : {int(meta.index.duplicated().sum())}')
    print(f'Geneid duplicates (counts) : {int(rc.index.duplicated().sum())}')
    print(f'Length missing             : {int(meta["Length"].isna().sum())}')
    print(f'Length <= 0                : {int((meta["Length"] <= 0).sum())}')
    print(f'biotype missing            : {int(meta["gene_biotype"].isna().sum())}')
    print(f'read-count NaN cells       : {int(rc.isna().sum().sum())}')
    print(f'read-count negative cells  : {int((rc < 0).sum().sum())}')
    print(f'read-count non-integer cells: {int((rc.values != np.floor(rc.values)).sum())}')
    print(f'gene order identical       : {(rc.index == meta.index).all()}')

    # ---------- 3. sample-column vs annotation verification ----------
    samp_cols = list(rc.columns)
    ann_samples = set(ann['sample'])
    print('\n-- sample columns vs annotation --')
    print(f'num sample columns (counts): {len(samp_cols)}')
    print(f'num annotated samples      : {len(ann)}')
    print(f'annotated set == column set: {set(samp_cols) == ann_samples}')
    print(f'cols not in annotation     : {len(set(samp_cols) - ann_samples)}')
    print(f'annotated not in cols      : {len(ann_samples - set(samp_cols))}')

    # ---------- 4. CD14 sample selection (agreed: column name contains 'CD14') ----------
    cd14_cols = [c for c in rc.columns if 'CD14' in c]
    cd14_ann  = set(ann.loc[ann['celltype'] == 'CD14', 'sample'])
    n_cd14 = len(cd14_cols)
    print('\n-- CD14 selection (cross-verification) --')
    print(f'CD14 cols by name contains CD14 : {n_cd14}')
    print(f'CD14 samples by celltype==CD14 : {len(cd14_ann)}')
    print(f'sets equal                     : {set(cd14_cols) == cd14_ann}')

    # ---------- 5. protein-coding genes ----------
    pc_mask = (meta['gene_biotype'] == 'protein_coding').values
    n_pc = int(pc_mask.sum())
    multi = meta['gene_biotype'].str.contains(';')
    print('\n-- protein-coding definition --')
    print(f'protein_coding (exact match) : {n_pc}')
    print(f'rows with multi-biotype (all): {int(multi.sum())}'
          f' | of them containing protein_coding: {int((multi & meta["gene_biotype"].str.contains("protein_coding")).sum())}')

    # ---------- 6. mean expression across CD14 samples (raw counts) ----------
    X = rc[cd14_cols].astype(float)
    Length = meta['Length'].astype(float)

    # apply on the pc subset (order aligned)
    pc_idx = pc_mask
    L     = Length[pc_idx].reset_index(drop=True)
    Xpc   = X[pc_idx].reset_index(drop=True)

    mean_raw  = Xpc.mean(axis=1)
    mean_log2 = np.log2(Xpc + 1.0).mean(axis=1)
    mean_log10= np.log10(Xpc + 1.0).mean(axis=1)
    logL      = np.log10(L)

    n_used = len(L)
    print('\n' + '=' * 70)
    print('MAIN ANALYSIS (protein-coding genes x CD14 mean expression)')
    print('=' * 70)
    print(f'protein-coding genes analysed : {n_used}')
    print(f'CD14 samples used for mean    : {n_cd14}')

    # ---------- 7. Correlations ----------
    r_main           = pearsonr(L,    mean_raw)[0]
    r_log2_vs_L      = pearsonr(L,    mean_log2)[0]
    r_log10v_log10L  = pearsonr(logL, mean_log10)[0]

    # zero-mean exclusion sensitivity
    zmask = mean_raw > 0
    n_zero = int((mean_raw == 0).sum())
    r_main_nozero = pearsonr(L[zmask], mean_raw[zmask])[0]

    print('\n-- MAIN ANSWER --')
    print(f'r( Length, mean_raw )                 = {r_main:.6f}')
    print('\n-- SENSITIVITY --')
    print(f'r( Length, log2(mean+1) )             = {r_log2_vs_L:.6f}')
    print(f'r( log10(Length), log10(mean+1) )     = {r_log10v_log10L:.6f}')
    print(f'zero-mean genes excluded: {n_zero} '
          f'-> r( Length, mean_raw ) = {r_main_nozero:.6f}')

    # ---------- 8. Summary ----------
    print('\n' + '=' * 70)
    print('SUMMARY (agreed convention)')
    print('=' * 70)
    print(f'Pearson correlation between gene length and mean expression '
          f'(raw, all {n_used} protein-coding genes, {n_cd14} CD14 samples): {r_main:.6f}')
    print(f'  (approx 3 decimals for concise answer: {r_main:.3f})')

if __name__ == '__main__':
    main()
