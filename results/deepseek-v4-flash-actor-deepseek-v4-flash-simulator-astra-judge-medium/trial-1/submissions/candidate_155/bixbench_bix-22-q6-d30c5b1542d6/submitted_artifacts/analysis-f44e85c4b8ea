"""
BixBench bix-22-q6
Question: When examining protein-coding genes only, what is the pearson correlation
coefficient between gene length and gene expression?

Approach (approved):
1. Gene identifier = first column 'Unnamed: 0' of counts table == meta 'Geneid'.
2. Filter gene_biotype == 'protein_coding' exactly (19,942 genes).
3. Gene expression (primary) = mean of 723 batch-corrected sample counts per gene.
4. Length = 'Length' column as-is (bp).
5. PRIMARY: scipy.stats.pearsonr(Length, log2(mean+1)); keep all 19,942 genes.
   Variants: (a) raw Length vs raw mean; (b) log10(Length) vs log2(mean+1);
             (c) Length vs mean of per-sample log2(count+1).
   Extra sensitivity: median summary; drop-zero-mean genes.
"""
import numpy as np
import pandas as pd
import scipy.stats as st

DATA = "data"

def pearson(x, y):
    r, p = st.pearsonr(x, y)
    return r, p

# ---- 1. Load ----
meta = pd.read_csv(f"{DATA}/GeneMetaInfo_Zenodo.csv")
counts = pd.read_csv(f"{DATA}/BatchCorrectedReadCounts_Zenodo.csv")
sample_annot = pd.read_csv(f"{DATA}/Sample_annotated_Zenodo.csv")

sample_cols = [c for c in counts.columns if c != "Unnamed: 0"]
assert len(sample_cols) == 723
assert list(sample_cols) == list(sample_annot["sample"].values), "sample column mismatch"

# ---- 2. Protein-coding filter + join ----
pc_meta = meta[meta["gene_biotype"] == "protein_coding"].copy()
print(f"protein_coding genes (exact match): {len(pc_meta)}")

merged = counts.merge(pc_meta[["Geneid", "Length"]],
                      left_on="Unnamed: 0", right_on="Geneid", how="inner")
print(f"merged rows: {len(merged)}  (should equal protein_coding count)")
assert len(merged) == len(pc_meta)

L = merged["Length"].to_numpy(dtype=float)
X = merged[sample_cols].to_numpy(dtype=np.float64)   # 19,942 x 723
print(f"matrix shape: {X.shape}")

# ---- 3. per-gene summaries ----
mean_expr      = X.mean(axis=1)                 # primary summary
median_expr    = np.median(X, axis=1)           # sensitivity
mean_log2p1    = np.log2(X + 1.0).mean(axis=1)  # mean of per-sample log2(c+1)
log2_mean_p1   = np.log2(mean_expr + 1.0)       # log2(mean+1)  [primary x-variable]
log10_L        = np.log10(L)

n_all = len(L)
zero_mean_mask = mean_expr == 0.0
print(f"zero-mean protein-coding genes: {int(zero_mean_mask.sum())} "
      f"(kept, mapped to log2(0+1)=0)")

def report(name, x, y):
    r, p = pearson(x, y)
    print(f"{name:55s} r = {r:.8f}   (p = {p:.3e}, n = {len(x)})")
    return r

print("\n===== RESULTS =====")
print("\nPRIMARY  pearsonr(Length, log2(mean+1))  [all protein-coding genes]")
r_primary = report("PRIMARY Length vs log2(mean+1)", L, log2_mean_p1)

print("\nVARIANTS")
r_a = report("(a) Length vs raw mean expression", L, mean_expr)
r_b = report("(b) log10(Length) vs log2(mean+1)", log10_L, log2_mean_p1)
r_c = report("(c) Length vs mean of per-sample log2(count+1)", L, mean_log2p1)

print("\nEXTRA SENSITIVITY")
r_med = report("median summary: Length vs log2(median+1)", L, np.log2(median_expr + 1.0))
r_drop = report("drop zero-mean genes: Length vs log2(mean+1)",
                L[~zero_mean_mask], log2_mean_p1[~zero_mean_mask])
r_drop_raw = report("drop zero-mean genes: Length vs raw mean",
                    L[~zero_mean_mask], mean_expr[~zero_mean_mask])

print("\nFINAL ANSWER (primary):")
print(f"pearson correlation (Length, log2(mean+1)) among protein-coding genes = "
      f"{r_primary:.6f}")

# sanity cross-check with np.corrcoef
assert np.allclose(r_primary, np.corrcoef(L, log2_mean_p1)[0, 1])
print("sanity np.corrcoef cross-check OK")
