for k in META_SETS:
    META_SETS[k] = list(dict.fromkeys(META_SETS[k]))

def ora(degs, universe, genesets):
    U = set(universe); N = len(U)
    M = set(degs); m = len(M & U)
    rows = []
    for term, gs in genesets.items():
        K = len(set(gs) & U)
        k = len(set(gs) & M & U)
        if K == 0:
            continue
        p = stats.hypergeom.sf(k - 1, N, K, m) if k > 0 else 1.0
        rows.append({"term": term, "set_size_in_universe": K, "deg_in_set": k,
                     "deg_frac": k / max(m, 1), "pvalue": p})
    df = pd.DataFrame(rows)
    if len(df):
        df["padj"] = multipletests(df.pvalue, method="fdr_bh")[1]
        df["signif"] = df.padj < 0.05
        df = df.sort_values("padj")
    return df, m

COMBINED_META = set().union(*META_SETS.values())

def ora_summary(name, res_df):
    univ = list(res_df.index)
    print(f"\n--- ORA for {name} ---")
    for direction, sel in [("UP", res_df.query("DEG=='up'")),
                           ("DOWN", res_df.query("DEG=='down'"))]:
        degs = list(sel.index)
        df, m = ora(degs, univ, META_SETS)
        in_meta = int(df.deg_in_set.sum()) if len(df) else 0
        nsig = int(df.signif.sum()) if len(df) else 0
        minp = float(df.padj.min()) if len(df) and len(df) else np.nan
        # also fraction of DEGs in combined metabolic set
        comb_in = len(set(degs) & COMBINED_META & set(univ))
        print(f"  [{direction}] DEGs={m}; in any curated metabolic set={comb_in} "
              f"({(100*comb_in/max(m,1)):.1f}% of {direction} DEGs)")
        print(f"  [{direction}] significant curated BP terms (padj<0.05): {nsig}; "
              f"min padj={minp:.3g}")
        if len(df):
            print(df[["term", "deg_in_set", "set_size_in_universe", "deg_frac",
                      "padj", "signif"]].to_string(index=False,
                      float_format=lambda x: f"{x:.3g}"))
        df.to_csv(f"/workspace/analysis/ORA_{direction}_{name}.csv", index=False)
    return

