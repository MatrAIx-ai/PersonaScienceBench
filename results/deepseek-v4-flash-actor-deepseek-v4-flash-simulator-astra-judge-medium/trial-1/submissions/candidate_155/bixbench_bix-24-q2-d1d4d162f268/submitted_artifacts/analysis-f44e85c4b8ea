#!/usr/bin/env python3
"""
BixBench bix-24-q2 - CBD effects in CRC cells.
Differential expression (NB Wald test, DESeq2-style size factors) +
GO Biological Process over-representation analysis.

ENVIRONMENT NOTE (disclosed, per researcher approval):
  The offline runner has NO GO ontology/gene-annotation files
  (*.gmt/*.obo/*.gaf, gene2go, org.Hs.eg.db, msigdb...), NO R
  (DESeq2/edgeR/clusterProfiler) and NO network (DNS fails for every host).
  A genuine full GO-BP enrichment is therefore NOT possible here. Per the
  approved fallback, GO BP is approximated by CURATED, well-known metabolic
  GO-BP directed gene sets (ENSEMBL IDs) analyzed with hypergeometric
  over-representation analysis. This is an OFFLINE-FORCED APPROXIMATION and
  is NOT the full GO BP ontology. All limitations disclosed in the report.
"""
import numpy as np
import pandas as pd
import warnings
warnings.filterwarnings("ignore")
from scipy import stats
from statsmodels.nonparametric.smoothers_lowess import lowess
from statsmodels.stats.multitest import multipletests

RNG = np.random.default_rng(0)

# ---------------- 1. LOAD DATA ----------------
counts = pd.read_csv("/workspace/data/counts_raw_unfiltered.csv", index_col=0)
layout = pd.read_csv("/workspace/data/sample_layout.csv")

def col_to_sampleid(c):
    return c.replace("_", "-")

col_group = {}
for c in counts.columns:
    sid = col_to_sampleid(c)
    g = layout.loc[layout["SampleID"] == sid, "Group"]
    col_group[c] = g.iloc[0] if len(g) == 1 else None
grp = pd.Series(col_group)
print("Column->Group mapping (sample, group):")
for c in counts.columns:
    print(f"  {c}: {grp[c]}")
libsize = counts.sum(axis=0)
print(f"Library sizes: min={libsize.min():.0f} median={libsize.median():.0f} max={libsize.max():.0f}")

# ---------------- 2. PRE-FILTER (edgeR-style) ----------------
cpm = counts.div(libsize, axis=1) * 1e6
keep = (cpm >= 1).sum(axis=1) >= 3
sub = counts.loc[keep]
print(f"Genes total: {counts.shape[0]}, after CPM>=1 in >=3 samples: {sub.shape[0]}")
sub.to_csv("/workspace/analysis/filtered_counts.csv")

# ---------------- 3. DESeq2-style SIZE FACTORS (median of ratios) ----------------
pos = sub.gt(0)
geomean = pd.Series(np.nan, index=sub.index)
for g in sub.index:
    vals = sub.loc[g].values
    geomean.loc[g] = np.exp(np.mean(np.log(vals[vals > 0]))) if (vals > 0).any() else np.nan
gm = geomean[geomean > 0]
ratios = sub.loc[gm.index] / gm.values[:, None]
size_factors = ratios.median(axis=0)
size_factors = size_factors / size_factors.mean()

def deseq_two_group(ctrl_cols, trt_cols, label):
    y_ctrl = sub[ctrl_cols].values; y_trt = sub[trt_cols].values
    s_ctrl = size_factors[ctrl_cols].values; s_trt = size_factors[trt_cols].values
    n1, n2 = len(ctrl_cols), len(trt_cols)
    c_ctrl = y_ctrl / s_ctrl; c_trt = y_trt / s_trt
    m1 = c_ctrl.mean(axis=1); m2 = c_trt.mean(axis=1)
    v1 = c_ctrl.var(axis=1, ddof=1); v2 = c_trt.var(axis=1, ddof=1)
    num = (n1 - 1) * (v1 - m1) + (n2 - 1) * (v2 - m2)
    den = (n1 - 1) * m1 ** 2 + (n2 - 1) * m2 ** 2
    phi_mom = np.where(den > 0, num / den, np.nan)
    phi_mom = np.clip(phi_mom, 0, 5)
    mbar = (m1 + m2) / 2
    ok = np.isfinite(phi_mom) & (mbar > 0)
    lp = np.log(phi_mom[ok]); lm = np.log(mbar[ok])
    trend_d = lowess(lp, lm, frac=0.4, it=1)
    trend_fn = np.interp(np.log(mbar), trend_d[:, 0], trend_d[:, 1],
                         left=trend_d[0, 1], right=trend_d[-1, 1])
    phi_trend = np.where(mbar > 0, np.exp(trend_fn), np.nan)
    df = (n1 - 1) + (n2 - 1); d0 = 8.0
    phi = (d0 * phi_trend + df * phi_mom) / (d0 + df)
    phi = np.clip(np.nan_to_num(phi, nan=0.05), 1e-8, 5)
    log2fc = np.log2((m2 + 0.5) / (m1 + 0.5))
    se2 = ((1 + phi * m1) / np.maximum(m1, 1e-6)) / n1 + \
          ((1 + phi * m2) / np.maximum(m2, 1e-6)) / n2
    se_log2 = np.sqrt(se2) / np.log(2)
    z = log2fc / np.maximum(se_log2, 1e-12)
    p = 2 * (1 - stats.norm.cdf(np.abs(z)))
    padj = multipletests(p, method="fdr_bh")[1]
    res = pd.DataFrame({
        "gene": sub.index, "baseMean": mbar,
        "log2FC": log2fc, "mean_ctrl": m1, "mean_trt": m2,
        "dispersion": phi, "pvalue": p, "padj": padj,
    }).set_index("gene")
    res["DEG"] = np.where((res.padj < 0.05) & (res.log2FC > 0.5), "up",
                 np.where((res.padj < 0.05) & (res.log2FC < -0.5), "down", "ns"))
    return res

def summarize(res, label):
    n = len(res); nsig = int((res.DEG != "ns").sum())
    up = int((res.DEG == "up").sum()); down = int((res.DEG == "down").sum())
    print(f"\n===== {label} =====")
    print(f"  genes tested: {n}; DEGs (padj<0.05 & |log2FC|>0.5): {nsig}")
    print(f"  up-regulated : {up}  ({(100*up/n):.2f}% of tested, {(100*up/max(nsig,1)):.1f}% of DEGs)")
    print(f"  down-regulated: {down} ({(100*down/n):.2f}% of tested, {(100*down/max(nsig,1)):.1f}% of DEGs)")
    return dict(n=n, nsig=nsig, up=up, down=down,
                up_frac_all=up / n, down_frac_all=down / n,
                up_frac_deg=up / max(nsig, 1), down_frac_deg=down / max(nsig, 1))

#-------------- Comparisons & run DE --------------
comp = {
    "CBD_IC50_vs_DMSO": (list(grp[grp == "DMSO"].index),
                         list(grp[grp == "CBD_IC50"].index)),
    "CBD_IC50_vs_Untreated": (list(grp[grp == "Untreated"].index),
                              list(grp[grp == "CBD_IC50"].index)),
}
results = {}
summaries = {}
for name, (cc, tc) in comp.items():
    res = deseq_two_group(cc, tc, name)
    results[name] = res
    res.to_csv(f"/workspace/analysis/DE_{name}.csv")
    summaries[name] = summarize(res, name)

prim = "CBD_IC50_vs_DMSO"
r = results[prim].sort_values("padj")
