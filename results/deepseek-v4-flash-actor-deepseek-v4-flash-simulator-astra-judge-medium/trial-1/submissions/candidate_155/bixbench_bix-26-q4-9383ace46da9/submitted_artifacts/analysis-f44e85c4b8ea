#!/usr/bin/env python3
"""
BixBench bix-26-q4 - Step 1: parse DESeq2 results stored as RDS (gzip + R v3
serialization) and derive the significantly downregulated gene lists.

Inputs (P. aeruginosa PA14, 5828 genes):
  data/res_GluFevsGluFePlus.rds   -> contrast GluFe vs GluFePlus
  data/res_SuccvsGluFePlus.rds    -> contrast Succ  vs GluFePlus

Each RDS contains a DESeq2 DESeqResults (S4 DataFrame, package DESeq2):
columns baseMean, log2FoldChange, lfcSE, stat, pvalue, padj;
row.names = PA14 locus tags (e.g. PA14_33530).

The R binary serialization is decoded here without external R:
 - CHARSXP token   : 00 04 00 09 <4-byte len> <bytes>
 - REALSXP vector  : 00 00 00 0e <4-byte len> <N doubles>
Rows: 6 vectors of N doubles in column order (baseMean..padj).
"""
import gzip, struct, sys, os
import pandas as pd

CHARSXP_MARKER = bytes([0x00, 0x04, 0x00, 0x09])
COLNAMES = ["baseMean", "log2FoldChange", "lfcSE", "stat", "pvalue", "padj"]

def read_deseq_results(path):
    p = gzip.open(path, "rb").read()
    # strip RDS header (magic "X\n" + v3 header through "UTF-8" label)
    p = p[23:]
    # 1) row names = CHARSXP tokens holding PA14_XXXXX
    rownames = []
    start = 0
    while True:
        i = p.find(CHARSXP_MARKER, start)
        if i < 0:
            break
        L = int.from_bytes(p[i + 4:i + 8], "big")
        token = p[i + 8:i + 8 + L]
        if L == 10 and token.startswith(b"PA14_"):
            rownames.append(token.decode())
        start = i + 1
    n = len(rownames)
    # 2) numeric columns: 6 REALSXP vectors (header 00 00 00 0e + len), 8 bytes/double
    hdr = bytes([0x00, 0x00, 0x00, 0x0E]) + n.to_bytes(4, "big")
    idx = p.find(hdr)
    if idx < 0:
        raise RuntimeError("numeric block header not found")
    s = idx + 8
    cols = []
    for _ in range(6):
        cols.append(struct.unpack(f">{n}d", p[s:s + n * 8]))
        s += n * 8 + 8
    df = pd.DataFrame({c: cols[i] for i, c in enumerate(COLNAMES)}, index=rownames)
    df.index.name = "locus_tag"
    return df

def main():
    conds = {
        "GluFe": "data/res_GluFevsGluFePlus.rds",
        "Succ":  "data/res_SuccvsGluFePlus.rds",
    }
    lfc_cutoff = -1.5   # significantly DOWNREGULATED (researcher-approved)
    summary = {}
    for cond, path in conds.items():
        df = read_deseq_results(path)
        assert not df.index.duplicated().any()
        df.to_csv(f"outputs/de_{cond}.csv")
        down = df.index[df["log2FoldChange"] <= lfc_cutoff]
        down_sig = df.index[(df["log2FoldChange"] <= lfc_cutoff) & (df["padj"] < 0.05)]
        summary[cond] = dict(n_genes=len(df),
                             n_down=len(set(down)),
                             n_down_padj=len(set(down_sig)))
        pd.Series(sorted(down_sig)).to_csv(f"outputs/downreg_{cond}.txt", header=False, index=False)
    print("summary:", summary)
    g = set(pd.read_csv("outputs/downreg_GluFe.txt", header=None)[0])
    s = set(pd.read_csv("outputs/downreg_Succ.txt", header=None)[0])
    print("GluFe down:", len(g), "| Succ down:", len(s), "| overlap:", len(g & s))
    assert os.path.exists("outputs/de_GluFe.csv")

if __name__ == "__main__":
    main()
