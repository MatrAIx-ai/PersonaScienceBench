#!/usr/bin/env python3
"""
BixBench bix-29-q1 - Full analysis
Ordinal (proportional-odds) regression of BCG vaccination on COVID-19 severity,
controlling for prior medical history count and patients interaction frequency,
with the interaction between those two covariates.

Data:
  data/TASK008_BCG-CORONA_DM.csv  (demographics, TRTGRP, patients_seen, ...)
  data/TASK008_BCG-CORONA_AE.csv  (adverse events, incl. COVID-19 + AESEV grades)
  data/TASK008_BCG-CORONA_MH.csv  (medical history questionnaire; = MH.xlsx)
Environment: no R available, so statsmodels OrderedModel(distr='logit') is used
(a direct equivalent of MASS::polr / ordinal::clm with logit link).
Sign convention verified by simulation: positive coef => higher odds of a
HIGHER outcome category; exp(beta) = OR per 1-unit increase in the covariate.
"""
import numpy as np
import pandas as pd
import statsmodels.api as sm
from statsmodels.miscmodels.ordinal_model import OrderedModel
from scipy import stats

DATA = 'data/'
DM = pd.read_csv(DATA + 'TASK008_BCG-CORONA_DM.csv')
AE = pd.read_csv(DATA + 'TASK008_BCG-CORONA_AE.csv')
MH = pd.read_csv(DATA + 'TASK008_BCG-CORONA_MH.csv')

# ---------------------------------------------------------------- outcome ----
def covid_severity(ae=AE, dm=DM, missing='as0'):
    """Per-subject COVID-19 severity = max AESEV among COVID-related AEs;
    no COVID AE => 0. Levels 0<1<2<3<4."""
    cov = ae[ae.AEPT.str.contains('COVID', case=False, na=False)]
    mx = cov.groupby('USUBJID')['AESEV'].max().rename('sev')
    dat = dm[['USUBJID', 'TRTGRP', 'patients_seen', 'expect_interact', 'work_hours']].copy()
    dat = dat.merge(mx, how='left', on='USUBJID')
    if missing == 'as0':
        dat['sev'] = dat['sev'].fillna(0.0).astype(int)      # primary: missing -> level 0
    elif missing == 'drop':
        dat = dat[dat['sev'].notna()].copy()                 # exclude 43 subjects
        dat['sev'] = dat['sev'].astype(int)
    elif missing == 'as1':
        dat['sev'] = dat['sev'].fillna(1.0).astype(int)      # missing -> mildest COVID grade
    else:
        raise ValueError(missing)
    return dat

def medhx_count(mh=MH, dm=DM):
    """Prior medical history count = # MEDICAL HISTORY checklist items with
    MHONGO='Yes' per subject (0..7)."""
    hx = mh[mh.MHSCAT == 'MEDICAL HISTORY']
    cnt = (hx[hx.MHONGO == 'Yes'].groupby('USUBJID').size()
           .reindex(dm.USUBJID, fill_value=0).rename('medhx'))
    return cnt

def freq_values(series, field):
    """Numerical coding of 'patients interaction frequency'."""
    if field == 'patients_seen':
        return series.map({'1-50': 25.0, '51-100': 75.0, '>100': 150.0})
    if field == 'expect_interact':
        return (series == 'Yes').astype(float)
    if field == 'work_hours':
        return series.map({'1-40': 20.0, '41-80': 60.0, '>80': 90.0})
    raise ValueError(field)

def build_dataset(missing='as0', field='patients_seen'):
    dat = covid_severity(missing=missing)
    dat = dat.merge(medhx_count().rename('medhx'), on='USUBJID')
    dat['freq'] = freq_values(dat[field], field)
    dat['bcg'] = (dat.TRTGRP == 'BCG').astype(int)
    dat['medhx_c'] = dat['medhx'] - dat['medhx'].mean()
    dat['freq_c']  = dat['freq']  - dat['freq'].mean()
    dat['medhxXfreq'] = dat['medhx_c'] * dat['freq_c']       # interaction term
    return dat

def fit_model(dat, add_bcg_cov_int=False):
    cols = ['bcg', 'medhx_c', 'freq_c', 'medhxXfreq']
    X = dat[cols].copy()
    if add_bcg_cov_int:   # sensitivity: alternative reading (BCG x covariates)
        X['bcgXmedhx'] = dat['bcg'] * dat['medhx_c']
        X['bcgXfreq']  = dat['bcg'] * dat['freq_c']
    mod = OrderedModel(dat['sev'].astype(int), X, distr='logit')
    res = mod.fit(method='bfgs', disp=False)
    return res, X

def fmt_or(res, term='bcg'):
    b, s, p = res.params[term], res.bse[term], res.pvalues[term]
    lo, hi = res.conf_int().loc[term]
    return pd.Series({
        'coef': b, 'SE': s, 'p': p,
        'OR': np.exp(b), 'OR_lo': np.exp(lo), 'OR_hi': np.exp(hi)})

# ------------------------------------------------------------- main model ----
print('=' * 78)
print('MAIN MODEL: proportional-odds ordinal logistic regression')
print('  sev ~ bcg + medhx_c + freq_c + medhx_c:freq_c   (patients_seen, missing->0)')
print('=' * 78)
dat = build_dataset(missing='as0', field='patients_seen')
print('n =', len(dat))
print('severity distribution (0=no COVID, 1-4=max AESEV):')
print(dat['sev'].value_counts().sort_index().to_dict())
res, X = fit_model(dat)
print('converged:', res.mle_retvals is None or res.mle_retvals.get('converged', 'n/a'))
print()
print(res.summary())

print()
print('---- BCG effect (primary answer) ----')
b = res.params['bcg']; s = res.bse['bcg']; p = res.pvalues['bcg']
lo, hi = res.conf_int().loc['bcg']
print(f'BCG coef = {b:.4f} (SE {s:.4f}, z={b/s:.3f}, p={p:.4f})')
print(f'BCG OR = exp(coef) = {np.exp(b):.4f}  95% CI ({np.exp(lo):.4f}, {np.exp(hi):.4f})')
print('Interpretation: Placebo=0 (reference); OR>1 means BCG subjects have higher odds')
print('of being in a MORE severe COVID-19 category; OR<1 would mean protection.')
print()
print('---- Interaction term medhx_c x freq_c ----')
ib = res.params['medhxXfreq']; is_ = res.bse['medhxXfreq']; ip = res.pvalues['medhxXfreq']
print(f'medhx_c:freq_c coef = {ib:.4f} (SE {is_:.4f}, p={ip:.4f})')
print('--- main effects for reference (medhx_c, freq_c) ---')
for t in ['medhx_c', 'freq_c']:
    print(f'{t}: coef={res.params[t]:.4f}, SE={res.bse[t]:.4f}, p={res.pvalues[t]:.4f}')

# ------------------------------------------------------------- sensitivities ----
print()
print('=' * 78)
print('SENSITIVITY ANALYSIS')
print('=' * 78)
rows = []
for missing in ['as0', 'drop', 'as1']:
    for field in ['patients_seen', 'expect_interact', 'work_hours']:
        d = build_dataset(missing=missing, field=field)
        r, _ = fit_model(d)
        s_ = fmt_or(r)
        s_['sev_missing'] = missing
        s_['freq_field'] = field
        s_['n'] = len(d)
        s_['int_p'] = r.pvalues['medhxXfreq']
        s_['int_coef'] = r.params['medhxXfreq']
        rows.append(s_)
sens = pd.DataFrame(rows)
pd.set_option('display.width', 200)
print('OR(BCG) and interaction by missing-handling x frequency-field:')
print(sens[['sev_missing', 'freq_field', 'n', 'coef', 'SE', 'p', 'OR', 'OR_lo', 'OR_hi', 'int_coef', 'int_p']].round(4).to_string(index=False))

# ------------------------------------------------------- PO assumption check ----
print()
print('=' * 78)
print('PROPORTIONAL-ODDS DIAGNOSTIC (graded binary logits) - main dataset')
print('Compares coefficient of each predictor across cumulative cutpoints P(sev>k).')
print('Roughly constant coefficients across cutpoints are consistent with PO.')
print('=' * 78)
X = X.assign(y=dat['sev'].values)
for k in sorted(dat['sev'].unique())[:-1]:
    yk = (dat['sev'] > k).astype(int)
    glogit = sm.Logit(yk, sm.add_constant(X[['bcg', 'medhx_c', 'freq_c', 'medhxXfreq']]))
    gr = glogit.fit(disp=False)
    print(f'P(sev>{k}): ' + '  '.join(f'{t}={gr.params[t]:+.3f}' for t in ['bcg', 'medhx_c', 'freq_c', 'medhxXfreq']))

# ----------------------------------------- sensitivity: alternative interaction ----
print()
print('=' * 78)
print('SENSITIVITY: alternative reading - include BCG x covariate interactions too')
print('=' * 78)
r2, X2 = fit_model(dat, add_bcg_cov_int=True)
print(pd.Series(r2.params).round(4))
b2 = r2.params['bcg']
lo2, hi2 = r2.conf_int().loc['bcg']
print(f'BCG OR (with BCG x covariate interactions) = {np.exp(b2):.4f} '
      f'95%CI ({np.exp(lo2):.4f}, {np.exp(hi2):.4f})')

# -------------------------------------------------------------------- output ----
dat.to_csv('analysis/analysis_dataset.csv', index=False)
print()
print('Analysis dataset written to analysis/analysis_dataset.csv')
print('DONE.')
