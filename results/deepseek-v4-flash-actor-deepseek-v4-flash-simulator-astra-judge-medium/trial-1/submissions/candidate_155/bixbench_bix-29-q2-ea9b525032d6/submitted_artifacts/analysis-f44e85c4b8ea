"""BixBench TASK008: independent effect of #ongoing medical conditions (MHONGO)
on odds of higher COVID-19 severity via proportional-odds cumulative-logit regression.
Outcome: per-subject ordinal severity 0=no RTI, 1..4=max AESEV over RTI events.
Predictor: n_ongoing = #rows MHONGO=='Yes' (per additional ongoing condition, +1/unit).
Covariates: BCG(TRTGRP), work_hours_ord, patients_seen_ord, expect_interact(Yes=1).
Report OR=exp(b), %increase=(OR-1)*100 with 95% CI (Wald/delta; profile CI separate).
Sensitivities: (a) RTI-only levels 1-4; (b) collapse 3+4; (c) dummies; (d) dummies+collapse.
PO check: Brant-style LR test (PO vs threshold-specific slopes, exact ordinal likelihood)."""
import numpy as np, pandas as pd
from scipy.optimize import minimize
from scipy.special import expit
from scipy import stats
from statsmodels.miscmodels.ordinal_model import OrderedModel

XCOLS = ['n_ongoing','bcg','work_hours_ord','patients_seen_ord','expect_interact_yes']

def build_theta(t0, deltas):
    th = np.empty(1+len(deltas)); th[0]=t0; acc=t0
    for m,d in enumerate(deltas,start=1): acc+=np.exp(d); th[m]=acc
    return th

def ordinal_llh(params, X, y, K, nonpo=False):
    n,p = X.shape; J=K-1
    t0,deltas = params[0], params[1:J]; th = build_theta(t0,deltas)
    if not nonpo:
        G = expit(th[None,:] - (X@params[J:])[:,None])
    else:
        B = params[J:].reshape(J,p)
        G = np.stack([expit(th[j]-X@B[j]) for j in range(J)],axis=1)
    pj = np.empty((n,K)); pj[:,0]=G[:,0]; pj[:,1:J]=np.diff(G,axis=1); pj[:,J]=1-G[:,J-1]
    pj = np.clip(pj,1e-12,1-1e-12)
    return np.log(pj[np.arange(n),y]).sum()

def fit_ordinal(df, Xcols, nonpo=False, seed=0):
    X = df[Xcols].astype(float).values; y=df['severity'].values.astype(int)
    K = int(y.max())+1; J=K-1; p=X.shape[1]
    rng = np.random.default_rng(seed)
    p0 = np.concatenate([[-1.0],np.zeros(J-1),rng.normal(0,0.05,p if not nonpo else J*p)])
    res = minimize(lambda prm:-ordinal_llh(prm,X,y,K,nonpo), p0, method='BFGS',
                   options={'maxiter':5000,'gtol':1e-7})
    return res, K

def om_table(omr, Xcols, label):
    b=omr.params[Xcols]; se=omr.bse[Xcols]; pv=omr.pvalues[Xcols]
    orr=np.exp(b); lo=np.exp(b-1.96*se); hi=np.exp(b+1.96*se)
    pct=(orr-1)*100; pct_se=orr*se*100
    return pd.DataFrame({'model':label,'coef':b,'se':se,'OR':orr,'OR_lo95':lo,
        'OR_hi95':hi,'p_value':pv,'pct_inc':pct,'pct_inc_lo95':pct-1.96*pct_se,
        'pct_inc_hi95':pct+1.96*pct_se})

def fit_om(df, Xcols, label):
    om = OrderedModel(df['severity'], df[Xcols].astype(float), distr='logit')
    omr = om.fit(method='bfgs', disp=False, maxiter=500)
    return omr, om_table(omr, Xcols, label)

if __name__ == '__main__':
    df = pd.read_csv('analysis/analysis_dataset.csv')
    out=[]

    # ---- PRIMARY ----
    omr, ptab = fit_om(df, XCOLS, 'primary_0to4_n1000')
    out.append(ptab)
    print('PRIMARY llf=%.4f  n=%d'%(omr.llf,len(df)))
    print(ptab.round(4).to_string())
    b_mh, se_mh = omr.params['n_ongoing'], omr.bse['n_ongoing']
    or_mh = np.exp(b_mh); pct_mh=(or_mh-1)*100
    pct_lo=(np.exp(b_mh-1.96*se_mh)-1)*100; pct_hi=(np.exp(b_mh+1.96*se_mh)-1)*100
    print('MHONGO OR=%.4f  %%increase=%.2f%% (95%%CI %.2f-%.2f) [Wald/delta]'%(or_mh,pct_mh,pct_lo,pct_hi))

    # sign sanity via manual PO MLE thresholds
    res_po,K_ = fit_ordinal(df,XCOLS,nonpo=False); J=K_-1
    th = build_theta(res_po.x[0],res_po.x[1:J]); bset = res_po.x[J:]
    Xm0=df[XCOLS].astype(float); Xm0['n_ongoing']=0
    Xm3=df[XCOLS].astype(float); Xm3['n_ongoing']=3
    lin0=Xm0[XCOLS].values@bset; lin3=Xm3[XCOLS].values@bset
    pge2_0=np.mean(1-expit(th[1]-lin0)); pge2_3=np.mean(1-expit(th[1]-lin3))
    print('Sign check: mean P(sev>=2) n_ongoing=0:%.3f vs n=3:%.3f (higher -> raises severity: %s)'
          %(pge2_0,pge2_3,pge2_3>pge2_0))

    # ---- PO (Brant-style) LR test ----
    res_np,_ = fit_ordinal(df,XCOLS,nonpo=True)
    Bp = res_np.x[J:].reshape(J,len(XCOLS))
    brant = pd.DataFrame(Bp,columns=XCOLS,index=['cut%d'%j for j in range(J)])
    LR=2*((-res_np.fun)-omr.llf); dfree=(K_-2)*len(XCOLS); pval=stats.chi2.sf(LR,dfree)
    print('\nPO LR test: PO llf=%.3f  nonPO llf=%.3f  LR=%.3f  df=%d  p=%.4f'%(omr.llf,-res_np.fun,LR,dfree,pval))
    print('threshold slopes:\n',brant.round(3))
    brant.to_csv('analysis/brant_threshold_slopes.csv')

    # ---- SENSITIVITIES ----
    dfa = df[df['sev_rti'].notna()].copy(); dfa['severity']=(dfa['severity']-1).astype(int)
    omr_a,ta = fit_om(dfa,XCOLS,'sens_a_RTIonly_n%d'%len(dfa)); out.append(ta)
    print('\nSENS (a) RTI-only n=%d:'%len(dfa)); print(ta.round(4).to_string())

    dfb=df.copy(); dfb['severity']=dfb['severity'].clip(upper=3)
    omr_b,tb = fit_om(dfb,XCOLS,'sens_b_collapse34_n%d'%len(dfb)); out.append(tb)
    print('\nSENS (b) collapse 3+4:'); print(tb.round(4).to_string())

    dfc=df.copy()
    dfc['wh_41_80']=(dfc['work_hours']=='41-80').astype(int); dfc['wh_gt80']=(dfc['work_hours']=='>80').astype(int)
    dfc['ps_51_100']=(dfc['patients_seen']=='51-100').astype(int); dfc['ps_gt100']=(dfc['patients_seen']=='>100').astype(int)
    XC=['n_ongoing','bcg','wh_41_80','wh_gt80','ps_51_100','ps_gt100','expect_interact_yes']
    omr_c,tc = fit_om(dfc,XC,'sens_c_dummies_n%d'%len(dfc)); out.append(tc)
    print('\nSENS (c) dummies:'); print(tc.round(4).to_string())

    dfd=dfc.copy(); dfd['severity']=dfd['severity'].clip(upper=3)
    omr_d,td = fit_om(dfd,XC,'sens_d_dummies_collapse_n%d'%len(dfd)); out.append(td)
    print('\nSENS (d) dummies+collapse:'); print(td.round(4).to_string())

    alltab=pd.concat(out,ignore_index=True)
    alltab.to_csv('analysis/model_tables_all.csv',index=False)
    heads=alltab.groupby('model').head(1)
    heads.round(4).to_csv('analysis/MHONGO_effect_summary.csv',index=False)
    print('\n=== MHONGO effect across all models ===')
    print(heads[['model','coef','se','OR','OR_lo95','OR_hi95','p_value','pct_inc','pct_inc_lo95','pct_inc_hi95']].round(4).to_string())

    # predicted distribution by n_ongoing
    rows=[]
    for n in range(8):
        Xm=df[XCOLS].astype(float); Xm['n_ongoing']=n; lin=Xm[XCOLS].values@bset
        G0=expit(th[0]-lin); G1=expit(th[1]-lin); G2=expit(th[2]-lin); G3=expit(th[3]-lin)
        rows.append([n,G0.mean(),(G1-G0).mean(),(G2-G1).mean(),(G3-G2).mean(),(1-G3).mean()])
    pred=pd.DataFrame(rows,columns=['n_ongoing','p_sev0','p_sev1','p_sev2','p_sev3','p_sev4'])
    pred['p_any']=1-pred['p_sev0']
    pred.round(3).to_csv('analysis/predicted_severity_by_ongoing.csv',index=False)
    print('\nPredicted severity by n_ongoing:\n',pred.round(3).to_string())

    with open('analysis/results_summary.txt','w') as f:
        f.write('=== PRIMARY PO model (sev 0-4, n=1000) ===\n'+ptab.round(4).to_string()+'\n\n')
        f.write('MHONGO: b=%.4f se=%.4f OR=%.4f  %%increase=%.2f%% (95%%CI %.2f-%.2f) -- Wald/delta\n'
                %(b_mh,se_mh,or_mh,pct_mh,pct_lo,pct_hi))
        f.write('\n=== PO (Brant-style LR) test ===\nPO llf=%.3f nonPO llf=%.3f LR=%.3f df=%d p=%.4f\n'
                %(omr.llf,-res_np.fun,LR,dfree,pval))
        f.write(brant.round(3).to_string()+'\n\n=== SENSITIVITIES (MHONGO rows) ===\n')
        f.write(heads[['model','coef','se','OR','OR_lo95','OR_hi95','p_value','pct_inc','pct_inc_lo95','pct_inc_hi95']].round(4).to_string()+'\n')
    print('\nSaved: results_summary.txt, model_tables_all.csv, MHONGO_effect_summary.csv, predicted_severity_by_ongoing.csv')
