import pandas as pd, numpy as np, scipy.stats as st
import statsmodels.api as sm
from statsmodels.miscmodels.ordinal_model import OrderedModel

dm = pd.read_csv('data/TASK008_BCG-CORONA_DM.csv')
ae = pd.read_csv('data/TASK008_BCG-CORONA_AE.csv')
mh = pd.read_csv('data/TASK008_BCG-CORONA_MH.csv')

S = dm.copy()
S['BCG'] = (S['TRTGRP']=='BCG').astype(int)
covid = ae[ae['AEPT'].astype(str).str.contains('COVID',case=False,na=False)].copy()
for i in range(1,13): covid[f'AEWK{i}HS']=pd.to_numeric(covid[f'AEWK{i}HS'],errors='coerce')
for c in ['AESEV','OnsetHS','AEHS']: covid[c]=pd.to_numeric(covid[c],errors='coerce')
wk=[f'AEWK{i}HS' for i in range(1,13)]
covid['maxAEWK']=covid[wk].max(axis=1,skipna=True)
covid['peak']=covid['maxAEWK'].fillna(covid[['AEHS','OnsetHS']].max(axis=1,skipna=True))
g=covid.groupby('USUBJID')
S=S.set_index('USUBJID')
S['has_covid']=g.size().reindex(S.index).fillna(0).astype(int)>0
S['Y_peak']=g['peak'].max().reindex(S.index).fillna(0)       # primary severity 0..7
S['Y_AESEV']=g['AESEV'].max().reindex(S.index).fillna(0)
S['has_AESEV']=g['AESEV'].count().reindex(S.index).fillna(0)>0
S=S.reset_index()

core=['Tuberculosis','Hypertension','Diabetes Mellitus','Chronic Obstructive Pulmonary Disease','Asthma','Other lung disease','Cardiovascular disease','Cerebrovascular disease','Kidney disease','Liver disease','Cancer','Organ or bone marrow transplantation','Primary immunodeficiency','Neutropenia or lymphopenia','Current respiratory tract infection','Allergy','Hay fever','chronic sinusitis']
cardio=['Hypertension','Diabetes Mellitus','Cardiovascular disease','Cerebrovascular disease','Kidney disease','Liver disease']
mhs=mh[(mh['MHSCAT']=='MEDICAL HISTORY')&(mh['MHORRES']==2.0)]
pres=mhs.groupby('USUBJID')['MHTERM'].apply(set)
S['conds']=S['USUBJID'].map(pres).apply(lambda s: s if isinstance(s,set) else set())
S['MH']=S['conds'].apply(lambda s: len(s&set(core))>0).astype(int)
S['MH_cardio']=S['conds'].apply(lambda s: len(s&set(cardio))>0).astype(int)
S['MH_count']=S['conds'].apply(lambda s: len(s&set(core)))
S['expect_interact']=(S['expect_interact']=='Yes').astype(int)
S['patients_seen_ord']=S['patients_seen'].map({'1-50':1,'51-100':2,'>100':3})
S['Y_coll3']=np.minimum(S['Y_peak'],3); S['Y_coll4']=np.minimum(S['Y_peak'],4); S['Y_coll5']=np.minimum(S['Y_peak'],5)
S['Y_AESEV_imp']=S['Y_AESEV'].copy()
m=(S['has_covid'])&(~S['has_AESEV'])&(S['Y_peak']>0)
S.loc[m,'Y_AESEV_imp']=S.loc[m,'Y_peak'].clip(upper=4)

def fit(form,dat):
    mod=OrderedModel.from_formula(form,dat,distr='logit')
    res=mod.fit(method='bfgs',disp=False,maxiter=5000)
    terms=[p for p in res.params.index if (':' in p) and ('BCG' in p) and ('MH' in p)]
    return res,terms[0]
def rep(res,t):
    b,se=res.params[t],res.bse[t]; lo,hi=b-1.96*se,b+1.96*se
    pv=2*(1-st.norm.cdf(abs(b/se)))
    return dict(OR=float(np.exp(b)),lo=float(np.exp(lo)),hi=float(np.exp(hi)),p=float(pv),beta=float(b),se=float(se))

lines=[]
def run(tag,form,dat):
    try:
        res,t=fit(form,dat); r=rep(res,t); r['tag']=tag
        s=f"{tag:48s} OR={r['OR']:7.4f}  95%CI=[{r['lo']:7.4f},{r['hi']:7.4f}]  p={r['p']:8.4f}  n={int(res.nobs)}"
        print(s); lines.append(s); return r
    except Exception as e:
        print(tag,'ERROR',str(e)[:50]); return None

R={}
print("="*120)
R['primary']=run("PRIMARY (approved): AEWK peak, any-of-18, C(patients_seen)","Y_peak ~ BCG + MH + BCG:MH + C(patients_seen)",S)
print("-"*120)
R['coll3']=run("Collapse severity to 4 levels (0,1,2,3+)","Y_coll3 ~ BCG + MH + BCG:MH + C(patients_seen)",S)
R['coll4']=run("Collapse severity to 5 levels (0-4, 4+)","Y_coll4 ~ BCG + MH + BCG:MH + C(patients_seen)",S)
R['aesev_cc']=run("AESEV 0-4, complete-case COVID (drop 43 w/o AESEV)","Y_AESEV ~ BCG + MH + BCG:MH + C(patients_seen)", S[(S['Y_AESEV']>0) | (~S['has_covid'])])
R['aesev_imp']=run("AESEV 0-4, missing AESEV imputed from peak","Y_AESEV_imp ~ BCG + MH + BCG:MH + C(patients_seen)",S)
print("-"*120)
R['mh_cardio']=run("MH = cardiometabolic subset","Y_peak ~ BCG + MH_cardio + BCG:MH_cardio + C(patients_seen)",S)
R['mh_count']=run("MH = condition count (linear)","Y_peak ~ BCG + MH_count + BCG:MH_count + C(patients_seen)",S)
print("-"*120)
R['ctrl_exp']=run("Control includes expect_interact","Y_peak ~ BCG + MH + BCG:MH + C(patients_seen) + expect_interact",S)
R['ctrl_num']=run("Control patients_seen numeric 1/2/3","Y_peak ~ BCG + MH + BCG:MH + patients_seen_ord",S)
R['ctrl_age']=run("Control plus Age + SEX","Y_peak ~ BCG + MH + BCG:MH + C(patients_seen) + C(Age) + C(SEX)",S)

print("\n"+"="*120)
print("PRIMARY MODEL - full coefficient table")
res0,_=fit("Y_peak ~ BCG + MH + BCG:MH + C(patients_seen)",S)
pv=2*(1-st.norm.cdf(np.abs(res0.params/res0.bse)))
tbl=pd.DataFrame({'coef':res0.params.round(4),'se':res0.bse.round(4),'OR':np.exp(res0.params).round(4),'p':pv.round(4)})
print(tbl.to_string()); lines.append("\nPRIMARY MODEL TABLE\n"+tbl.to_string())

print("\nCumulative severity distribution by BCG x prior-MH (%):")
cum=pd.crosstab([S['BCG'],S['MH']],S['Y_peak']).apply(lambda r:100*r/r.sum(),axis=1)
print(cum.round(1).to_string())

# PO informal check (stable cutpoints only)
print("\nPO-assumption informal check (binary logit ORs per cutpoint):")
Xf=pd.DataFrame({'BCG':S['BCG'],'MH':S['MH'],'BxM':S['BCG']*S['MH'],
                 'p51':(S['patients_seen']=='51-100').astype(int),'p100':(S['patients_seen']=='>100').astype(int)})
for cut in [1,2]:
    yb=(S['Y_peak']>=cut).astype(int)
    m=sm.Logit(yb,sm.add_constant(Xf)).fit(disp=False)
    s=f"Y>={cut}: OR_BCG={np.exp(m.params['BCG']):.3f} OR_MH={np.exp(m.params['MH']):.3f} OR_BxM={np.exp(m.params['BxM']):.3f}"
    print(s); lines.append(s)
lines.append("NOTE: Y>=3/Y>=4 cutpoints too sparse (~24/~10 events) for stable binary-logit estimation (separation); collapsing sensitivity shows results unchanged.")

with open('work/result_summary.txt','w') as f:
    f.write("\n".join(lines))
    f.write(f"\n\nPRIMARY interaction OR = {R['primary']['OR']:.4f} (95% CI {R['primary']['lo']:.4f}-{R['primary']['hi']:.4f}), p={R['primary']['p']:.4f}\n")
print("\nsaved work/result_summary.txt")
print("\nFINAL ANSWER NUMBER:")
print(f"OR_interaction = {R['primary']['OR']:.4f}, 95% CI = [{R['primary']['lo']:.4f}, {R['primary']['hi']:.4f}], p = {R['primary']['p']:.4f}")
