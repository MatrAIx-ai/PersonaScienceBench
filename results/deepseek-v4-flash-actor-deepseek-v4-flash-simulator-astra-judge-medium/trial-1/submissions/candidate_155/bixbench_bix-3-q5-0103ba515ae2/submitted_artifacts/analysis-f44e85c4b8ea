"""
BixBench bix-3-q5 (FINAL) — Differential expression + binomial exact test at 5%.

Three tissue comparisons (pooled across Control/good_responder/bad_responder, 30 samples/tissue):
   C1  Final vs Baseline Blood      dentate vs baseline/final for comparison
   C2  Dentate gyrus vs Baseline blood
   C3  Dentate gyrus vs Final blood

DE evidence (per gene): Welch two-sample t-test on log2(normalised count + 1);
BH-adjusted padj and log2 fold change computed per comparison.
  - success ("DEG") = padj < 0.05 AND |log2FC| > 1
    (conventional DESeq-style DEG definition; the file's own embedded 'DEG' flags
     likewise apply a fold-change filter, their counts 19-212 << padj counts 27-755).
  - main text also reports the raw p<0.05-only count to be transparent.

Binomial exact test (5% threshold):
  - N = testable genes (non-zero variance in both groups)
  - X = observed DEG count; expected under global null = 0.05 * N
  - H0: p = 0.05, one-sided upper tail: P(X >= observed | n=N, p=0.05)
  - Negligible effects  <=>  binomial p >= 0.05 (observed DEG count not significantly
    above the 5% chance expectation).

Validation:
  - Null calibration: random within-tissue splits (15 vs 15) -> p<0.05 fraction ~5%.
  - Cross-check: our t-test reproduces the file's embedded DESeq pval<0.05 counts on
    the same within-tissue responder subsets (e.g. baseline Control_vs_bad 1224 vs 1324).
  - Robustness: same pipeline within each response group (Control, good, bad; 10v10).
"""
import numpy as np, pandas as pd
from scipy import stats
from statsmodels.stats.multitest import multipletests

XL = 'data/Data_deposition_RNAseq_Paroxetine_2017.xlsx'
df = pd.read_excel(XL, sheet_name='NormCount', header=3)
df.columns = [str(c) for c in df.columns]
gene_id = df.iloc[:, 1].astype(str).values
sample_cols = list(df.columns[2:92])
M = df[sample_cols].values.astype(float)
L = np.log2(M + 1.0)
N_GENES = len(df)
print(f"Genes read: {N_GENES}; samples: {len(sample_cols)}")

def subset(group, tissue):
    lo = {'baseline':0,'dentate':30,'final':60}[tissue]; hi = lo+30
    return [i for i in range(lo, hi) if sample_cols[i].startswith(group+'_')]

def per_gene(L, ai, bi):
    """return p, log2FC(B vs A), padj, testable mask"""
    varA = L[:, ai].var(1, ddof=1); varB = L[:, bi].var(1, ddof=1)
    testable = (varA > 0) & (varB > 0)
    p = np.full(L.shape[0], np.nan)
    p[testable] = stats.ttest_ind(L[testable][:, ai], L[testable][:, bi],
                                  axis=1, equal_var=False).pvalue
    lfc = np.mean(L[:, bi], 1) - np.mean(L[:, ai], 1)
    padj = np.full(L.shape[0], np.nan)
    padj[testable] = multipletests(p[testable], method='fdr_bh')[1]
    return p, lfc, padj, testable

def binom_result(name, p, padj, lfc, testable, fc_filter=True):
    N = int(testable.sum())
    if fc_filter:
        deg = (padj[testable] < 0.05) & (np.abs(lfc[testable]) > 1.0)
    else:
        deg = p[testable] < 0.05
    X = int(deg.sum())
    expected = 0.05 * N
    p_binom = stats.binomtest(X, N, p=0.05, alternative='greater').pvalue
    return dict(name=name, N=N, X=X, expected=expected, frac=X/N,
                p_binom=float(p_binom), negligible=bool(p_binom >= 0.05))

# ---------------- MAIN pooled analysis ----------------
comp = {
 'C1 Final vs Baseline Blood':   (np.arange(60,90), np.arange(0,30)),
 'C2 DG vs Baseline Blood':      (np.arange(30,60), np.arange(0,30)),
 'C3 DG vs Final Blood':         (np.arange(30,60), np.arange(60,90)),
}
print("\n" + "="*80)
print("MAIN (pooled, n=30/tissue)  -- DEG = padj<0.05 & |log2FC|>1; binomial H0:p=0.05")
print("="*80)
rows=[]
for name,(ai,bi) in comp.items():
    p,lfc,padj,mask = per_gene(L, ai, bi)
    r = binom_result(name, p, padj, lfc, mask, fc_filter=True)
    rows.append(r)
    print(f"{name:<26} N={r['N']:>6} X(DEG)={r['X']:>6} exp(0.05N)={r['expected']:>7.0f} "
          f"frac={r['frac']:.4f}  binom_p={r['p_binom']:.3g}  negligible={r['negligible']}")
    # transparency: raw p<0.05 only
    Xraw = int((p[mask]<0.05).sum())
    print(f"    [transparency] raw p<0.05 only: X={Xraw} ({Xraw/mask.sum():.3f}) "
          f"binom_p={stats.binomtest(Xraw, int(mask.sum()), 0.05, alternative='greater').pvalue:.3g}")
pd.DataFrame(rows).to_csv('analysis/results_pooled.csv', index=False)

# ---------------- Null calibration ----------------
print("\n" + "="*80)
print("VALIDATION 1 - null calibration (random within-tissue splits)")
print("="*80)
rng = np.random.RandomState(0)
null_r = []; null_praw=[] 
for rep in range(10):
    pr = rng.permutation(30)
    p,lfc,padj,mask = per_gene(L, pr[:15], pr[15:])
    r = binom_result('null', p, padj, lfc, mask)
    null_r.append(r['frac'])
    null_praw.append(float((p[mask]<0.05).mean()))
print(f"  random baseline 15v15: raw p<0.05 frac mean = {np.mean(null_praw):.4f}  (DEG-with-FC-filter frac mean = {np.mean(null_r):.4f})")
# null DEG rate (padj&|lfc|>1) should be near 0
for rep in range(5):
    pr = rng.permutation(30)
    p,lfc,padj,mask = per_gene(L, pr[:15], pr[15:])
    r = binom_result('null', p, padj, lfc, mask)
    print(f"   null rep:{rep} X(DEG)={r['X']} frac={r['frac']:.5f} binom_p={r['p_binom']:.3f}")

# ---------------- Cross-check vs embedded DESeq ----------------
print("\n" + "="*80)
print("VALIDATION 2 - our t-test vs file's embedded DESeq pval<0.05 counts (same subsets)")
print("="*80)
embed = {'baseline':[774,1324,2040],'dentate':[2038,2314,2141],'final':[2168,1062,1411]}
for tissue, ecounts in embed.items():
    pairs=[('Control','good_responder'),('Control','bad_responder'),('good_responder','bad_responder')]
    for (g1,g2), ec in zip(pairs, ecounts):
        a=subset(g1,tissue); b=subset(g2,tissue)
        p,_,_,_ = per_gene(L, a, b)
        x=int((p[p==p]<0.05).sum())
        print(f"  {tissue:<10} {g1:<15} vs {g2:<15} ours={x:>5}  embedded={ec}")

# ---------------- Robustness: within each response group ----------------
print("\n" + "="*80)
print("VALIDATION 3 - robustness within each response group (n=10/tissue)")
print("="*80)
for g in ['Control','good_responder','bad_responder']:
    bl=subset(g,'baseline'); dg=subset(g,'dentate'); fi=subset(g,'final')
    print(f"  --- {g} ---")
    for name, ai, bi in [('C1 Final vs Baseline',fi,bl),('C2 DG vs Baseline',dg,bl),('C3 DG vs Final',dg,fi)]:
        p,lfc,padj,mask = per_gene(L, ai, bi)
        r = binom_result(name, p, padj, lfc, mask)
        print(f"     {name:<22} N={r['N']} X={r['X']} exp={r['expected']:.0f} "
              f"frac={r['frac']:.4f} binom_p={r['p_binom']:.3g} negligible={r['negligible']}")

print("\nDONE. Pooled results saved to analysis/results_pooled.csv")
