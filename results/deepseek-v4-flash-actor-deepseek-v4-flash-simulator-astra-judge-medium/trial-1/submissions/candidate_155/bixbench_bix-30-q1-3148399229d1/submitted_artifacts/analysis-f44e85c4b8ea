#!/usr/bin/env python3
"""
BIXBENCH bix-30-q1 -- FINAL ANALYSIS
Question: What percentage of miRNAs show significant differential expression
between patient and control groups before multiple testing correction?

Approved methodology:
  * Groups: cols 1-10 (P_1..P_10) = patients (DM1), cols 11-20 (C_11..C_20) = controls.
  * Test:   two-sample Welch t-test on the per-miRNA raw Ct values.
  * Criterion: raw (uncorrected) p < 0.05  -> "significant differential expression".
             (No multiple-testing correction, as requested "before multiple testing correction".)
  * Percentage = (#significant miRNAs / 175) * 100.
  * Missing "NAN" strings are dropped per miRNA; if either group has < 2 valid
    samples the miRNA is skipped (in practice all 175 remain analyzable).
  * No delta-Ct normalization to an endogenous control (the table has no
    reference-gene column).

The script also records six sensitivity variants (29.7 % - 38.3 %) as background.
"""
import sys, os
import numpy as np
import pandas as pd
from scipy import stats

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from parse_xls import read_ole2, biff8_records, parse_sst, extract_sheet

DATA = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'data', 'pone.0150501.s002.xls')
SHEET_BOF_OFFSET = 19867          # BOF of the sole sheet "RAW DATA" in the Workbook stream
ALPHA = 0.05                       # raw p-value threshold (no correction)
OUTDIR = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'outputs')


def load_table():
    """Parse the legacy .xls (pure-Python OLE2/BIFF8) and return miRNA names and Ct matrices."""
    streams = read_ole2(open(DATA, 'rb').read())
    wb = streams['Workbook']
    records = list(biff8_records(wb))
    sst = None
    for i, (pos, rtype, pl) in enumerate(records):
        if rtype == 0x00FC:  # SST
            payloads = [pl]; j = i + 1
            while j < len(records) and records[j][1] == 0x003C:  # CONTINUE
                payloads.append(records[j][2]); j += 1
            sst = parse_sst(payloads)
            break
    cells = extract_sheet(records, SHEET_BOF_OFFSET, len(wb), sst)
    nrows = max(r for r, c in cells) + 1
    ncols = max(c for r, c in cells) + 1
    grid = np.full((nrows, ncols), np.nan, dtype=object)
    for (r, c), v in cells.items():
        grid[r, c] = v
    df = pd.DataFrame(grid)
    # Rows 2..176 = 175 miRNAs; col 0 = miRNA names; cols 1-10 = P (patients), cols 11-20 = C (controls)
    mirna = df.iloc[2:177, 0].astype(str).values
    num = df.iloc[2:177, 1:21].apply(pd.to_numeric, errors='coerce').astype(float)
    P = num.iloc[:, 0:10].to_numpy()
    C = num.iloc[:, 10:20].to_numpy()
    return mirna, P, C


def run_test(mirna, P, C, transform, test, alpha=ALPHA):
    """Per-miRNA two-sample test on transform(Ct); returns summary dict + p-value array."""
    results = []
    pvals = np.full(len(mirna), np.nan)
    for i, name in enumerate(mirna):
        pv = transform(P[i]); cv = transform(C[i])
        pv = pv[~np.isnan(pv)]; cv = cv[~np.isnan(cv)]
        if len(pv) < 2 or len(cv) < 2:
            results.append(dict(mirna=name, n_p=len(pv), n_c=len(cv), p=np.nan,
                                mean_P=np.nan, mean_C=np.nan, significant=np.nan))
            continue
        if test == 'student':
            p = stats.ttest_ind(pv, cv, equal_var=True).pvalue
        elif test == 'welch':
            p = stats.ttest_ind(pv, cv, equal_var=False).pvalue
        elif test == 'mwu':
            p = stats.mannwhitneyu(pv, cv, alternative='two-sided').pvalue
        pvals[i] = p
        results.append(dict(mirna=name, n_p=len(pv), n_c=len(cv), p=p,
                            mean_P=np.mean(pv), mean_C=np.mean(cv),
                            significant=int(p < alpha)))
    dfr = pd.DataFrame(results)
    n_sig = int((pvals < alpha).sum()) if np.isfinite(pvals).any() else 0
    return n_sig, (n_sig / len(mirna) * 100.0), pvals, dfr


def main():
    os.makedirs(OUTDIR, exist_ok=True)
    mirna, P, C = load_table()
    n = len(mirna)
    print(f'Parsed: {n} miRNAs | patients(P_1..P_10) n={P.shape[1]} | controls(C_11..C_20) n={C.shape[1]}')

    # ---- APPROVED MAIN RESULT: Welch t-test on raw Ct, raw p<0.05 ----
    n_sig, pct, pvals, dfr = run_test(mirna, P, C, lambda x: x, 'welch')
    print('=' * 78)
    print(f'APPROVED MAIN RESULT  Welch t-test on raw Ct, uncorrected p<{ALPHA}:')
    print(f'  significant miRNAs : {n_sig} / {n}')
    print(f'  PERCENTAGE         : {pct:.1f}%')
    print('=' * 78)

    # ---- Background: sensitivity matrix (6 variants) ----
    print('\nBackground sensitivity (all with raw p<0.05):')
    for tf, tfn in [(lambda x: x, 'Ct    '), (lambda x: 2.0 ** (-x), '2^-Ct ')]:
        for test in ['student', 'welch', 'mwu']:
            s, pctv, _, _ = run_test(mirna, P, C, tf, test)
            print(f'  {tfn} {test:8s}: {s:3d}/{n} = {pctv:5.1f}%')

    # ---- Outputs ----
    dfr.to_csv(os.path.join(OUTDIR, 'per_mirna_welch_ct.csv'), index=False)
    pd.DataFrame({'mirna': mirna, 'p_welch_Ct': pvals}).to_csv(
        os.path.join(OUTDIR, 'pvalues_welch_ct.csv'), index=False)
    header = pd.DataFrame([[f'p<{ALPHA} without correction']], columns=['note'])
    table_num = pd.concat([header, pd.DataFrame({
        'metric': ['significant_count', 'total_count', 'percentage'],
        'value': [n_sig, n, round(pct, 1)]})], ignore_index=True)
    table_num.to_csv(os.path.join(OUTDIR, 'main_result_summary.csv'), index=False)
    print('\nWrote outputs to:', OUTDIR)
    return pct, n_sig, n, dfr


if __name__ == '__main__':
    pct, n_sig, n, dfr = main()
