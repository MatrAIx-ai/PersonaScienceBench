"""Pure-Python parser for a non-standard OLE2 compound document (BIFF8 xls).
Header fields are located with HEADER_OFFSET=16 (the file's header fields are
shifted by 16 bytes relative to the spec), but sector addressing is standard
(sector n at offset (n+1)*sector_size)."""
import struct

SIGNATURE = b'\xd0\xcf\x11\xe0\xa1\xb1\x1a\xe1'
HEADER_OFFSET = 16

FREESECT   = 0xFFFFFFFF
ENDOFCHAIN = 0xFFFFFFFE
FATSECT    = 0xFFFFFFFD

def read_ole2(data):
    assert data[:8] == SIGNATURE, "Not an OLE2 file"
    sector_shift = struct.unpack_from('<H', data, HEADER_OFFSET+14)[0]
    mini_shift   = struct.unpack_from('<H', data, HEADER_OFFSET+16)[0]
    sector_size = 1 << sector_shift
    mini_size   = 1 << mini_shift
    num_fat     = struct.unpack_from('<I', data, HEADER_OFFSET+28)[0]
    first_dir   = struct.unpack_from('<I', data, HEADER_OFFSET+32)[0]
    minicutoff  = struct.unpack_from('<I', data, HEADER_OFFSET+40)[0]
    first_minifat = struct.unpack_from('<I', data, HEADER_OFFSET+44)[0]
    num_minifat = struct.unpack_from('<I', data, HEADER_OFFSET+48)[0]
    first_difat = struct.unpack_from('<I', data, HEADER_OFFSET+52)[0]
    num_difat   = struct.unpack_from('<I', data, HEADER_OFFSET+56)[0]

    def read_sector(n):
        return data[(n+1)*sector_size:(n+2)*sector_size]

    # DIFAT: header array + chain sectors
    difat = list(struct.unpack_from('<109I', data, HEADER_OFFSET+60))
    pos = first_difat
    for _ in range(num_difat):
        sec_off = (pos + 1)*sector_size
        difat.extend(struct.unpack_from('<%dI' % (sector_size//4 - 1), data, sec_off))
        nxt = struct.unpack_from('<I', data, sec_off + sector_size - 4)[0]
        if nxt == ENDOFCHAIN: break
        difat.append(nxt); pos = nxt
    difat = [s for s in difat if s < FATSECT][:num_fat]
    print('FAT sectors:', difat)

    fat = []
    for fs in difat:
        fat.extend(struct.unpack_from('<%dI' % (sector_size//4), read_sector(fs), 0))

    def read_chain(start):
        out = b''; cur = start; seen = set()
        while cur < len(fat) and cur != ENDOFCHAIN and cur not in seen:
            seen.add(cur)
            out += read_sector(cur)
            cur = fat[cur]
        return out

    # Directory
    dirbuf = read_chain(first_dir)
    entries = []
    for off in range(0, len(dirbuf) - 127, 128):
        ent = dirbuf[off:off+128]
        name_len = struct.unpack_from('<H', ent, 64)[0]
        name = ent[:name_len].decode('utf-16-le', errors='replace').rstrip('\x00')
        typ = ent[66]
        start = struct.unpack_from('<I', ent, 116)[0]
        size  = struct.unpack_from('<Q', ent, 120)[0]
        entries.append({'name': name, 'type': typ, 'start': start, 'size': size})

    root = [e for e in entries if e['type'] == 5]
    assert root, 'no root entry'
    root = root[0]
    mini_stream = read_chain(root['start'])

    # Mini FAT
    minifat = []
    cur = first_minifat
    for _ in range(num_minifat):
        minifat.extend(struct.unpack_from('<%dI' % (sector_size//4), read_sector(cur), 0))
        cur = fat[cur]

    def read_stream(ent):
        if ent['size'] < minicutoff:
            out = b''; c = ent['start']; seen = set()
            while c != ENDOFCHAIN and c < len(minifat) and c not in seen:
                seen.add(c)
                out += mini_stream[c*mini_size:(c+1)*mini_size]
                c = minifat[c]
            return out[:ent['size']]
        return read_chain(ent['start'])[:ent['size']]

    streams = {}
    for e in entries:
        if e['type'] == 2:
            streams[e['name']] = read_stream(e)
    return streams

# ---------------- BIFF8 ----------------
def biff8_records(stream):
    pos = 0; n = len(stream)
    while pos + 4 <= n:
        rtype, length = struct.unpack_from('<HH', stream, pos)
        yield pos, rtype, stream[pos+4:pos+4+length]
        pos += 4 + length

def parse_rk(v):
    div = 100.0 if (v & 0x02) else 1.0
    if v & 0x01:
        val = v >> 2
        if val & 0x40000000:
            val -= 0x80000000
        return val / div
    iv = (v >> 2) << 34
    return struct.unpack('<d', struct.pack('<Q', iv & 0xFFFFFFFFFFFFFFFF))[0] / div

def parse_biff_string(buf, pos):
    cch = struct.unpack_from('<H', buf, pos)[0]; pos += 2
    flags = buf[pos]; pos += 1
    fRich = flags & 0x08; fExt = flags & 0x04; fHigh = flags & 0x01
    if fRich:
        n_runs = struct.unpack_from('<H', buf, pos)[0]; pos += 2
    else:
        n_runs = 0
    if fExt:
        cb_ext = struct.unpack_from('<I', buf, pos)[0]; pos += 4
    else:
        cb_ext = 0
    if fHigh:
        s = buf[pos:pos+cch*2].decode('utf-16-le', errors='replace'); pos += cch*2
    else:
        s = buf[pos:pos+cch].decode('latin-1'); pos += cch
    pos += n_runs*4 + cb_ext
    return s, pos

def parse_sst(payloads):
    buf = b''.join(payloads)
    cst_total, cst_unique = struct.unpack_from('<II', buf, 0)
    pos = 8
    out = []
    for _ in range(cst_unique):
        s, pos = parse_biff_string(buf, pos)
        out.append(s)
    return out

def extract_sheet(records, start_pos, end_pos, sst):
    start_idx = None
    for k, (pos, rtype, pl) in enumerate(records):
        if pos >= start_pos:
            start_idx = k; break
    if start_idx is None: return {}
    cells = {}
    needs_string = None
    for k in range(start_idx, len(records)):
        pos, rtype, pl = records[k]
        if pos >= end_pos: break
        if rtype == 0x00FD:  # LABELSST
            r, c, xf, isst = struct.unpack_from('<HHHI', pl, 0)
            cells[(r,c)] = sst[isst]
        elif rtype == 0x0203:  # NUMBER
            r, c, xf = struct.unpack_from('<HHH', pl, 0)
            cells[(r,c)] = struct.unpack_from('<d', pl, 6)[0]
        elif rtype == 0x000B:  # MULRK
            r, cf = struct.unpack_from('<HH', pl, 0)
            cl = struct.unpack_from('<H', pl, len(pl)-2)[0]
            o = 4; c = cf
            while o + 6 <= len(pl)-2:
                xf, rk = struct.unpack_from('<HI', pl, o)
                cells[(r,c)] = parse_rk(rk)
                o += 6; c += 1
        elif rtype == 0x0205:  # LABEL
            r, c, xf = struct.unpack_from('<HHH', pl, 0)
            s, _ = parse_biff_string(pl, 6)
            cells[(r,c)] = s
        elif rtype == 0x0006:  # FORMULA
            r, c, xf = struct.unpack_from('<HHH', pl, 0)
            res = pl[6:14]
            if res == b'\xff\xff\xff\xff\xff\xff\xff\xff':
                cells[(r,c)] = '__STR__'
            elif res[6:8] == b'\xff\xff':
                if res[0] == 0: cells[(r,c)] = ''
                elif res[0] == 1: cells[(r,c)] = bool(res[2])
                elif res[0] == 2: cells[(r,c)] = bool(res[2])
                else: cells[(r,c)] = None
            else:
                cells[(r,c)] = struct.unpack('<d', res)[0]
        elif rtype == 0x0007:  # STRING formula result
            s, _ = parse_biff_string(pl, 0)
            # attach to nearest pending __STR__ cell
            for key in list(cells.keys())[::-1]:
                if cells[key] == '__STR__':
                    cells[key] = s; break
        elif rtype == 0x0010:
            continue
    return cells

def main(path):
    data = open(path, 'rb').read()
    streams = read_ole2(data)
    print('Streams:', list(streams.keys()))
    wb = streams.get('Workbook') or streams.get('Book')
    if wb is None:
        raise SystemExit('no workbook stream')
    print('Workbook stream size:', len(wb))
    records = list(biff8_records(wb))
    print('Total BIFF records:', len(records))

    # SST
    sst = None
    for i, (pos, rtype, pl) in enumerate(records):
        if rtype == 0x00FC:
            payloads = [pl]; j = i+1
            while j < len(records) and records[j][1] == 0x003C:
                payloads.append(records[j][2]); j += 1
            sst = parse_sst(payloads)
            print('SST strings:', len(sst))
            break

    # BOUNDSHEET
    sheets = []
    for pos, rtype, pl in records:
        if rtype == 0x0085:
            offset = struct.unpack_from('<I', pl, 0)[0]
            name_len = pl[6]
            name = pl[7:7+name_len].decode('latin-1')
            sheets.append((name, offset))
    sheets.sort(key=lambda x: x[1])
    print('Sheets:', len(sheets))
    for k, (name, off) in enumerate(sheets):
        end = sheets[k+1][1] if k+1 < len(sheets) else len(wb)
        cells = extract_sheet(records, off, end, sst)
        nr = max((r for r,c in cells), default=-1)+1
        nc = max((c for r,c in cells), default=-1)+1
        print(f"  '{name}': offset={off} cells={len(cells)} rows={nr} cols={nc}")
    return streams, records, sst, sheets

if __name__ == '__main__':
    main('/workspace/data/pone.0150501.s002.xls')
