#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
BixBench bix-32-q4 -- full KEGG over-representation analysis of DESeq2 results.
Question: which two "Cellular Processes" KEGG pathways show consistent enrichment
(adjusted p<0.05) across quorum-sensing mutant strains 97, 98, 99 vs wildtype 1,
for significantly DOWNREGULATED genes (pvalue<0.05 and log2FoldChange<-1.5)?

Pipeline:
  1) Parse gzipped R-serialization RDS files -> per-gene DESeq2 results (5828 genes).
  2) Extract PA14 locus-tag rownames + 6 stat columns (baseMean, log2FoldChange,
     lfcSE, stat, pvalue, padj).
  3) Build KEGG 'pau' (P. aeruginosa UCBPP-PA14) pathway gene sets. NOTE: reconstructed
     from canonical public knowledge (offline environment - no internet/annotation data);
     documented as approximate in kegg_recon.py.
  4) Hypergeometric ORA per strain; Benjamini-Hochberg over (a) the 4 Cellular
     Processes pathways and (b) a larger reconstructed test set.
  5) Conservative sensitivity with realistic (inflated) KEGG pathway sizes.
  6) Pathway consistency across strains 97,98,99 (adj p<0.05 in all three).
"""
import sys, os, json
import pandas as pd
import numpy as np
from scipy.stats import hypergeom

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from extract_rds import extract
import kegg_recon as KR

OUT = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'bix32_output.json')
REPORT = {}

# ---------- 1) & 2) extract ----------
DFS = {s: extract(f'data/res_1vs{s}.rds').set_index('gene') for s in '97 98 99'.split()}
BG = set(DFS['97'].index)
REPORT['data'] = {'n_genes': len(BG),
                  'cols': list(DFS['97'].columns),
                  'identical_gene_sets': DFS['97'].index.equals(DFS['98'].index) or sorted(DFS['97'].index) == sorted(DFS['98'].index),
                  'na_counts': {s: int(DFS[s].isna().sum().sum()) for s in DFS}}

def down(s):
    d = DFS[s]
    return set(d[(d['pvalue'] < 0.05) & (d['log2FoldChange'] < -1.5)].index)

DOWN = {s: down(s) for s in '97 98 99'.split()}
REPORT['downregulated'] = {s: {'count': len(DOWN[s]), 'pvalue_threshold': 0.05, 'lfc_threshold': -1.5} for s in DOWN}
REPORT['downregulated']['intersection_all3'] = len(set.intersection(*DOWN.values()))

# ---------- 3) pathways ----------
PMAP = {}
for kid, name, cat, gs in KR.PATHWAYS:
    PMAP[kid] = {'name': name, 'cat': cat, 'genes': set(g for g in gs if g in BG)}
REPORT['pathway_recon'] = {k: {'name': v['name'], 'cat': v['cat'],
                               'n_genes_present': len(v['genes'])} for k, v in PMAP.items()}

# ---------- 4) ORA ----------
def bh(pvals):
    p = np.asarray(pvals, float); m = len(p)
    o = np.argsort(p); r = p[o]
    adj = r * m / np.arange(1, m + 1)
    adj = np.minimum.accumulate(adj[::-1])[::-1]
    out = np.empty_like(adj); out[o] = np.minimum(adj, 1.0)
    return out

def run_scope(ids):
    res = {}
    for kid in ids:
        K = len(PMAP[kid]['genes'])
        row = {'name': PMAP[kid]['name'], 'cat': PMAP[kid]['cat'], 'K_recon': K}
        for s in '97 98 99'.split():
            n = len(DOWN[s]); k = len(DOWN[s] & PMAP[kid]['genes'])
            p = hypergeom.sf(k - 1, 5828, K, n) if K > 0 else 1.0
            row[s] = {'k': k, 'n': n, 'p': float(p)}
        res[kid] = row
    for s in '97 98 99'.split():
        pv = [res[k][s]['p'] for k in ids]
        for k, a in zip(ids, bh(pv)):
            res[k][s]['padj'] = float(a)
    return res

cp_ids = sorted(KR.CP_IDS)
all_ids = [p[0] for p in KR.PATHWAYS]
res_cp = run_scope(cp_ids)
res_big = run_scope(all_ids)

def sig_all3(res):
    return [k for k, v in res.items()
            if v['K_recon'] > 0 and all(v[s]['padj'] < 0.05 for s in '97 98 99'.split())]

REPORT['scope_cp4'] = {k: {**{'name': v['name'], 'cat': v['cat'], 'K_recon': v['K_recon']},
                           **{s: {'k': v[s]['k'], 'n': v[s]['n'], 'p': v[s]['p'], 'padj': v[s]['padj']} for s in '97 98 99'.split()}}
                       for k, v in res_cp.items()}
REPORT['scope_larger'] = {k: {**{'name': v['name'], 'cat': v['cat'], 'K_recon': v['K_recon']},
                              **{s: {'k': v[s]['k'], 'n': v[s]['n'], 'p': v[s]['p'], 'padj': v[s]['padj']} for s in '97 98 99'.split()}}
                          for k, v in res_big.items()}
REPORT['sig_all3_cp4'] = sig_all3(res_cp)
REPORT['sig_all3_larger'] = sig_all3(res_big)
REPORT['cellular_processes_sig_all3_larger'] = [k for k in sig_all3(res_big) if res_big[k]['cat'] == 'Cellular Processes']

# ---------- 5) conservative sensitivity (inflated K, k fixed) ----------
inflated = {'pau02024': 55, 'pau02026': 90, 'pau02030': 45, 'pau02040': 45}
sens = {}
for kid, K in inflated.items():
    sens[kid] = {'K_estimate': K}
    for s in '97 98 99'.split():
        k = len(DOWN[s] & PMAP[kid]['genes'])
        sens[kid][s] = {'k': k, 'p': float(hypergeom.sf(k - 1, 5828, K, len(DOWN[s])))}
REPORT['conservative_sensitivity_inflatedK'] = sens

# ---------- 6) final answer ----------
final = REPORT['cellular_processes_sig_all3_larger']
REPORT['final_cellular_processes_pathways'] = final
REPORT['final_answer'] = " & ".join(k + " (" + REPORT['scope_larger'][k]['name'] + ")" for k in final)

with open(OUT, 'w') as f:
    json.dump(REPORT, f, indent=1)

# ---------- print summary ----------
print("BixBench bix-32-q4 -- final ORA report")
print("=" * 78)
print("Data: %d PA14 genes, cols %s" % (len(BG), list(DFS['97'].columns)))
print("Downregulated (pvalue<0.05 & lfc<-1.5):", {s: len(DOWN[s]) for s in DOWN},
      "| 3-strain intersection: %d genes" % REPORT['downregulated']['intersection_all3'])
print()
print("SCOPE (a): BH over the 4 Cellular Processes pathways")
print("  %-46s %s" % ("pathway", " | ".join("%s (k, padj)" % s for s in '97 98 99'.split())))
for k, v in REPORT['scope_cp4'].items():
    print("  %-46s %s" % (v['name'][:46], " | ".join("%s (k=%d, %.2e)" % (s, v[s]['k'], v[s]['padj']) for s in '97 98 99'.split())))
print()
print("SCOPE (b): BH over larger reconstructed test set (%d pathways)" % len(all_ids))
print("  %-46s %s" % ("pathway (category)", " | ".join("%s (k, padj)" % s for s in '97 98 99'.split())))
for k, v in REPORT['scope_larger'].items():
    print("  %-46s %s" % ((v['name'][:38] + " [" + v['cat'][:22] + "]")[:46],
                          " | ".join("%s (k=%d, %.2e)" % (s, v[s]['k'], v[s]['padj']) for s in '97 98 99'.split())))
print()
print("Significant in all 3 (cp4 scope):   ", REPORT['sig_all3_cp4'])
print("Significant in all 3 (larger scope):", REPORT['sig_all3_larger'])
print("Cellular Processes subset (larger): ", REPORT['cellular_processes_sig_all3_larger'])
print()
print("Conservative sensitivity (K inflated to realistic KEGG pau sizes):")
for k, v in sens.items():
    print("  %-8s %s" % (k, " | ".join("%s p=%.2e" % (s, v[s]['p']) for s in '97 98 99'.split())))
print()
print("FINAL ANSWER:", REPORT['final_answer'])
print("JSON report written to", OUT)
