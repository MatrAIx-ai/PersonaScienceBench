#!/usr/bin/env python3
"""BixBench bix-37-q2: base protein level of ENO1 in normal samples."""
import pandas as pd

XLSX = 'data/Proteomic_data .xlsx'
SHEET = 'Tumor vs Normal'

df = pd.read_excel(XLSX, sheet_name=SHEET)
print("Sheet shape:", df.shape)
print("Columns:", list(df.columns))

# Unique ENO1 row (gene-level)
eno1 = df[df['gene'] == 'ENO1']
assert len(eno1) == 1, f"Expected exactly 1 ENO1 row, got {len(eno1)}"
row = eno1.iloc[0]
print("\nENO1 row:")
print(eno1[['protein', 'Description', 'gene', 'gene_id',
            'Normal', 'Tumor', 'Ratio', 'FC', 'log2FC',
            'p.value', 'adj.Pval', 'is_sig', 'compare']].to_string())

normal_raw = float(row['Normal'])
print("\nENO1 Normal raw value:", repr(normal_raw))

# Cross-check with Ratio
print("Cross-check Tumor/Ratio:", row['Tumor'] / row['Ratio'])

# Round to 3 significant figures
rounded = round(normal_raw, -int(f"{normal_raw:.0e}".split('e')[-1]) + 2)
sig_str = f"{normal_raw:.3g}"
print("3 significant figures (format .3g):", sig_str,
      "-> numeric:", float(sig_str))

# also print integer-form
print("Rounded integer form:", int(float(sig_str)))

# Full-precision float of the 3-sig-fig value
print("Final answer numeric:", float(sig_str))
