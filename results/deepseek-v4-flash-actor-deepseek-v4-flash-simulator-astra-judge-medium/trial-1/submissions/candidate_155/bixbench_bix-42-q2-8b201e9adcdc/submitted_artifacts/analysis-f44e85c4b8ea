#!/usr/bin/env python3
"""
Analysis: Skewness of RNA expression distribution (bix-42-q2)
- Data: data/COAD__geneExp.xls (tab-separated text)
- Primary: pooled skewness of raw (untransformed) expression values
- Supporting: per-gene & per-sample skewness; log2(x+1), log2(positives-only),
  and per-gene z-score transforms as robustness/cross-check
- Figures: raw histogram, log2 histogram, Q-Q plot vs normal (SVG, no matplotlib)
"""
import numpy as np
import pandas as pd
from scipy import stats
import json, warnings
warnings.filterwarnings("ignore")

OUT = "analysis"

# ---------------- Load ----------------
df = pd.read_csv("data/COAD__geneExp.xls", sep="\t", index_col=0)
print("Matrix shape (genes x samples):", df.shape)
print("Any NaN:", int(df.isna().sum().sum()))
allnum = bool(df.apply(lambda c: pd.to_numeric(c, errors='coerce').notna().all()).all())
print("All numeric:", allnum)
print("Duplicate gene symbols:", int(df.index.duplicated().sum()),
      "| duplicate sample cols:", int(df.columns.duplicated().sum()))

vals = df.values.astype(float).ravel()
vals = vals[~np.isnan(vals)]

def report(name, x):
    g1 = stats.skew(x, bias=False)
    print(f"{name:28s} n={x.size:>9d}  mean={x.mean():>12.3f} median={np.median(x):>12.3f} "
          f"min={x.min():>13.3f} max={x.max():>14.3f}  skew={g1:>+9.3f}")
    return g1

print("\n================ SKEWNESS (Fisher-Pearson, bias=False) ================")
g_pool_raw = report("pooled RAW (all values)", vals)
df_dedup = df[~df.index.duplicated(keep=False)].copy()
g_pool_dedup = report("pooled RAW (dedup genes)", df_dedup.values.ravel())

g_genes = df.apply(lambda r: stats.skew(r.dropna(), bias=False), axis=1)
g_genes = g_genes[np.isfinite(g_genes)]
print("\nPer-gene skewness: median=%.3f mean=%.3f" % (np.median(g_genes), g_genes.mean()))
print("  %% genes right-skewed (g1>0): %.1f%%" % (100*(g_genes>0).mean()))
print("  %% genes |g1|>=1 (highly): %.1f%%   |g1| in [0.5,1): %.1f%%   |g1|<0.5: %.1f%%" % (
    100*(g_genes.abs()>=1).mean(), 100*((g_genes.abs()>=0.5)&(g_genes.abs()<1)).mean(),
    100*(g_genes.abs()<0.5).mean()))

g_sams = df.apply(lambda c: stats.skew(c.dropna(), bias=False), axis=0)
print("\nPer-sample skewness: median=%.3f mean=%.3f | %% right-skewed: %.1f%% | min=%.3f max=%.3f" % (
    np.median(g_sams), g_sams.mean(), 100*(g_sams>0).mean(), g_sams.min(), g_sams.max()))

pos = vals[vals > 0]
log2p1 = np.log2(vals + 1.0)
log2pos = np.log2(pos)
g_log2p1  = report("pooled log2(x+1) [all]", log2p1)
g_log2pos = report("pooled log2(positives)", log2pos)
gmean = df.mean(axis=1); gstd = df.std(axis=1, ddof=1)
zs = (df.sub(gmean, axis=0)).div(gstd, axis=0)
zvals = zs.values.ravel(); zvals = zvals[np.isfinite(zvals)]
g_z = report("pooled per-gene z-score", zvals)

rng = np.random.default_rng(42)
sh = stats.shapiro(rng.choice(pos, size=5000, replace=False))
dag = stats.normaltest(rng.choice(vals, size=5000, replace=False))
print("\nShapiro-Wilk (5k positives): stat=%.4f p=%.3e" % (sh.statistic, sh.pvalue))
print("D'Agostino-Pearson (5k raw) : stat=%.4f p=%.3e" % (dag.statistic, dag.pvalue))

# ---------------- Classification per approved thresholds ----------------
def classify(g1):
    if abs(g1) < 0.5: lab = "approximately normal"
    elif abs(g1) < 1.0: lab = "minimally skewed"
    else: lab = "highly skewed"
    direction = "right" if g1 > 0 else "left" if g1 < 0 else "symmetric"
    return lab, direction

print("\n--- Classification ---")
for name, g1 in [("pooled raw", g_pool_raw), ("per-gene median", float(np.median(g_genes))),
                 ("per-sample median", float(np.median(g_sams))), ("log2(x+1)", g_log2p1),
                 ("log2(positives)", g_log2pos), ("z-score", g_z)]:
    lab, d = classify(g1)
    print(f"  {name:18s} skew={g1:>+8.3f}  -> {lab}, {d}-skewed")

summary = {
  "shape": list(df.shape),
  "n_missing": int(df.isna().sum().sum()),
  "all_numeric": allnum,
  "zeros_pct": round(100*(vals==0).mean(), 3),
  "pooled_raw_skew": float(g_pool_raw),
  "pooled_raw_dedup_skew": float(g_pool_dedup),
  "per_gene_skew_median": float(np.median(g_genes)),
  "per_gene_pct_right": float(100*(g_genes>0).mean()),
  "per_gene_pct_highly": float(100*(g_genes.abs()>=1).mean()),
  "per_sample_skew_median": float(np.median(g_sams)),
  "log2p1_skew": float(g_log2p1),
  "log2pos_skew": float(g_log2pos),
  "zscore_skew": float(g_z),
  "mean": float(vals.mean()), "median": float(np.median(vals)), "std": float(vals.std()),
  "min": float(vals.min()), "max": float(vals.max()),
}
with open(f"{OUT}/skewness_summary.json", "w") as f:
    json.dump(summary, f, indent=2)
print("\nSummary JSON -> analysis/skewness_summary.json")
