#!/usr/bin/env python3
"""
BixBench bix-43-q1 — CBD/cisplatin combination vs DMSO control.
FULL DE PIPELINE (executed 2026-10-22, offline sandbox /workspace)

Method (documented):
  1. median-of-ratios size factors (DESeq2)
  2. low-count filter: sum(counts) >= 10 across the 6 compared samples
  3. common overdispersion alpha by profile maximum likelihood over all
     filtered genes (edgeR classic / DESeq2 simple mode style; grid 0.01..5)
  4. per-gene Negative-Binomial GLM (log link) with common alpha -> Wald z, p
  5. BH adjusted p-values
  6. ENSG->symbol mapping; drop ENSG-locus(no symbol)/duplicate symbols
  7. prerank input: signed_lp = sign(z)*-log10(p) (primary), z (secondary)

Outputs: de_results.tsv, ranked_genes_signed_lp.tsv (prerank input),
         ranked_genes_z.tsv (sensitivity ranking)
"""
import numpy as np, pandas as pd, scipy.stats as st
from statsmodels.genmod.generalized_linear_model import GLM
from statsmodels.genmod.families import NegativeBinomial
from statsmodels.genmod.families.links import Log

CTRL = ['3_1','3_2','3_3']; TRT = ['9_1','9_2','9_3']

counts = pd.read_csv('data/counts_raw_unfiltered.csv', index_col=0)
sym = pd.read_csv('data/ensg_to_gene_name.tsv', sep='\t').drop_duplicates('ENSG').set_index('ENSG')['gene_name']
X = counts[CTRL+TRT].astype(float)

# ---- 1. median-of-ratios size factors ----
gm = np.exp(np.log(X.replace(0, np.nan)).mean(axis=1)); gm = gm[gm>0]
sf = (X.loc[gm.index].div(gm, axis=0)).median(axis=0)
sf = sf / np.exp(np.log(sf).mean())
print("Size factors:"); [print(f"  {c}: {sf[c]:.4f}") for c in CTRL+TRT]

# ---- 2. filter ----
Y = X[X.sum(axis=1) >= 10]
print(f"Low-count filter: {Y.shape[0]}/{X.shape[0]} genes kept")

# ---- 3. common overdispersion ----
Yv = Y.values; sfv = sf.values
mg = np.array([Yv[:,:3].mean(axis=1), Yv[:,3:].mean(axis=1)])
mu_all = np.vstack([np.outer(mg[0], sfv[:3]).T, np.outer(mg[1], sfv[3:]).T])  # (6,N)
def nb_ll(y, mu, a):
    th = a**-1
    return st.nbinom.logpmf(y.astype(int), n=th, p=th/(th+mu))
agrid = np.geomspace(0.01, 5.0, 60)
ll = np.array([sum(nb_ll(Yv[:,j].astype(int), mu_all[j], a).sum() for j in range(6)) for a in agrid])
alpha = float(agrid[np.argmax(ll)])
print(f"Common overdispersion alpha (profile MLE) = {alpha:.4f}")

# ---- 4-5. NB GLM Wald + BH ----
design = pd.DataFrame({'group':[0,0,0,1,1,1], 'intercept':1.0})
rows = []
for i, g in enumerate(Y.index):
    try:
        f = GLM(Yv[i], design, family=NegativeBinomial(alpha=alpha, link=Log())).fit()
        b, se = f.params['group'], f.bse['group']
        z = b/se; p = 2*st.norm.sf(abs(z))
        rows.append((g, b, z, p))
    except Exception:
        rows.append((g, np.nan, np.nan, np.nan))
de = pd.DataFrame(rows, columns=['gene','log2FC','z','p']).set_index('gene')
de['padj'] = st.false_discovery_control(de['p'].fillna(1.0), method='bh')
de['symbol'] = de.index.map(sym)
print(f"NB-GLM Wald: {len(de)} genes; significant (BH padj<0.05): {int((de['padj']<0.05).sum())}")

de['signed_lp'] = np.sign(de['z']) * (-np.log10(de['p']))
de['abs_z'] = de['z'].abs()
de.to_csv('analysis/de_results.tsv', sep='\t')

# ---- 6-7. symbol-level ranked lists ----
def build_ranked(key):
    rl = de.dropna(subset=['symbol']).copy()
    rl = rl[~rl['symbol'].astype(str).str.startswith('ENSG')]
    rl = rl.sort_values('abs_z', ascending=False).drop_duplicates('symbol')
    return rl.sort_values(key, ascending=False)[['symbol','signed_lp','z','log2FC','p','padj']]

r1 = build_ranked('signed_lp'); r1.to_csv('analysis/ranked_genes_signed_lp.tsv', sep='\t', index=False)
r2 = build_ranked('z');        r2.to_csv('analysis/ranked_genes_z.tsv', sep='\t', index=False)
print(f"Prerank inputs: signed_lp {len(r1)} genes; z {len(r2)} genes")
rho, _ = st.spearmanr(r1['signed_lp'], r2.loc[r2['symbol'].isin(r1['symbol'])].set_index('symbol').loc[r1['symbol'],'z'])
print(f"Sensitivity: Spearman(z-ranking, signed_lp ranking) = {rho:.4f}")

print("\n=== TOP 25 UP (combo vs DMSO) ===")
print(de.dropna(subset=['symbol']).sort_values('z', ascending=False).head(25)[['symbol','log2FC','z','p','padj']].to_string())
print("\n=== TOP 25 DOWN (combo vs DMSO) ===")
print(de.dropna(subset=['symbol']).sort_values('z', ascending=True).head(25)[['symbol','log2FC','z','p','padj']].to_string())
print("\nDone. Outputs: de_results.tsv, ranked_genes_signed_lp.tsv, ranked_genes_z.tsv")
