"""
DESeq2-equivalent differential expression for the approved pipeline.
Design ~ Group (10 groups); contrast: group 9 (Cisplatin_IC50_CBD_IC50) vs group 3 (DMSO).
Implemented from first principles (scipy/numpy/statsmodels):
  - DESeq2 median-of-ratios size factors
  - per-gene Negative Binomial GLM (log link, log(size factor) offset), Fisher-scoring IRLS
  - trended per-gene dispersion (moment estimator + lowess trend, DESeq2-style)
  - Wald test for the g9-g3 contrast, BH multiple-testing correction
NOTE: canonical DESeq2 (R/pyDESeq2) is NOT installed in this environment; this is an
equivalent implementation. Reported numbers are approximate DESeq2 results.
"""
import numpy as np, pandas as pd, warnings
from scipy.stats import norm
from statsmodels.nonparametric.smoothers_lowess import lowess
from statsmodels.stats.multitest import multipletests

warnings.filterwarnings('ignore')

counts = pd.read_csv('data/counts_raw_unfiltered.csv', index_col=0)
lay = pd.read_csv('data/sample_layout.csv')
col_names = [s.replace('-', '_') for s in lay['SampleID']]
counts = counts[col_names]
groups = lay['Group'].values
K = counts.values.astype(float)
n_genes, m = K.shape

# ---------- size factors (DESeq2 median-of-ratios) ----------
logK = np.log(K)
with np.errstate(divide='ignore', invalid='ignore'):
    gmean_gene = np.exp(np.where(K > 0, logK, np.nan).mean(axis=1))
gmean_safe = np.where(gmean_gene > 0, gmean_gene, np.nan)
ratio = K / gmean_safe[:, None]
with np.errstate(invalid='ignore'):
    sf = np.nanmedian(np.where(K > 0, ratio, np.nan), axis=0)
sf = np.nan_to_num(sf, nan=np.median(sf[np.isfinite(sf)]))
if (sf <= 0).any(): sf[sf<=0] = np.median(sf)
print("size factors min/med/max:", np.round(sf.min(),3), np.round(np.median(sf),3), np.round(sf.max(),3))
norm_counts = K / sf[None, :]
baseMean = norm_counts.mean(axis=1)

# ---------- design matrix ----------
uniq = list(dict.fromkeys(groups))
g = pd.Categorical(groups, categories=uniq)
X = pd.get_dummies(g, drop_first=True).values.astype(float)
X = np.column_stack([np.ones(m), X])
p = X.shape[1]
col_of = {code: k for k, code in enumerate(uniq[1:], start=1)}
cvec = np.zeros(p); cvec[col_of['Cisplatin_IC50_CBD_IC50']] = 1.0; cvec[col_of['DMSO']] = -1.0
print("group order:", uniq)

def nb_irls(alpha_vec, K, X, sf, max_iter=15, tol=1e-8):
    n, m = K.shape; p = X.shape[1]
    logl = np.log(sf)[None, :]
    beta = np.zeros((n, p))
    mu = (K.mean(axis=1)[:, None] * sf[None, :])
    lp = np.log(np.clip(mu, 1e-9, None)) - logl          # (n,m) linear predictor w/o offset
    for it in range(max_iter):
        mu = np.exp(np.clip(lp + logl, -30, 30))
        a = alpha_vec[:, None]
        w = mu / (1.0 + a * mu)
        z = lp + (K - mu) / np.clip(mu, 1e-9, None)
        new_beta = np.empty_like(beta)
        for i in range(n):
            WX = X * w[i][:, None]
            A = X.T @ WX
            XWz = X.T @ (w[i] * z[i])
            try:
                new_beta[i] = np.linalg.solve(A + 1e-9*np.eye(p), XWz)
            except np.linalg.LinAlgError:
                new_beta[i] = beta[i]
        lp_new = (X @ new_beta.T).T
        d = np.abs(lp_new - lp).max(axis=1)
        beta, lp = new_beta, lp_new
        if d.max() < tol:
            break
    mu = np.exp(np.clip(lp + logl, -30, 30))
    return beta, mu

# Poisson starting fit for dispersion estimation
beta0, mu0 = nb_irls(np.zeros(n_genes), K, X, sf)

# genewise dispersion by moments + lowess trend
disp_g = ((K - mu0)**2 - mu0).sum(axis=1) / np.maximum((mu0**2).sum(axis=1), 1e-12)
disp_g = np.clip(disp_g, 1e-8, None)
mask = (baseMean > 1) & np.isfinite(np.log(disp_g))
if mask.sum() > 50:
    yy = np.log(disp_g[mask]); xx = np.log(baseMean[mask])
    order = np.argsort(xx)
    lw = lowess(yy[order], xx[order], frac=0.5, it=0, return_sorted=True)
    lo = np.log(baseMean[mask].min()); hi = np.log(baseMean[mask].max())
    trend_logdisp = np.interp(np.clip(np.log(baseMean), lo, hi), lw[:,0], lw[:,1])
elif (baseMean>1).any():
    mm = baseMean>1
    trend_logdisp = np.full(n_genes, np.median(np.log(disp_g[mm])))
else:
    trend_logdisp = np.zeros(n_genes)
disp_final = np.exp(trend_logdisp)

# final NB GLM
beta, mu = nb_irls(disp_final, K, X, sf)

# Wald test
lfc_nat = beta @ cvec
lfc2 = lfc_nat / np.log(2)
se2 = np.empty(n_genes)
for i in range(n_genes):
    wi = mu[i]/(1.0 + disp_final[i]*mu[i])
    A = (X * wi[:, None]).T @ X
    try:
        Cov = np.linalg.inv(A + 1e-9*np.eye(p))
    except np.linalg.LinAlgError:
        Cov = np.full((p, p), np.nan)
    se2[i] = np.sqrt(np.clip(cvec @ Cov @ cvec, 1e-12, None))
z = lfc_nat / se2
pval = np.clip(2*(1 - norm.cdf(np.abs(z))), 1e-300, 1.0)
padj = multipletests(pval, method='fdr_bh')[1]

res = pd.DataFrame({'ENSG': counts.index, 'baseMean': baseMean,
                    'log2FoldChange': lfc2, 'lfcSE': se2/np.log(2),
                    'pvalue': pval, 'padj': padj}).sort_values('padj')

deg = res[(res.baseMean > 10) & (res.log2FoldChange.abs() > 0.5) & (res.padj < 0.05)].copy()
print("\nTotal genes:", n_genes)
print("DEG (baseMean>10, |log2FC|>0.5, padj<0.05):", len(deg),
      "| up:", int((deg.log2FoldChange>0).sum()), "down:", int((deg.log2FoldChange<0).sum()))

mp = pd.read_csv('data/ensg_to_gene_name.tsv', sep='\t').drop_duplicates('ENSG').set_index('ENSG')['gene_name']
deg['gene_name'] = deg['ENSG'].map(mp)
deg_mapped = deg.dropna(subset=['gene_name']).copy()
print("DEG with symbol:", len(deg_mapped), "| unmapped dropped:", len(deg)-len(deg_mapped))
deg_dedup = deg_mapped.sort_values('baseMean', ascending=False).drop_duplicates('gene_name', keep='first')
print("DEG after symbol dedup:", len(deg_dedup))

res['gene_name'] = res['ENSG'].map(mp)
res.to_csv('res_all_genes_g9_vs_DMSO.csv', index=False)
deg_dedup.to_csv('deg_g9_vs_DMSO.csv', index=False)

print("\ntop12 DEG by padj:")
print(deg_dedup[['gene_name','baseMean','log2FoldChange','pvalue','padj']].head(12).to_string())
print("\nsanity: padj<0.05:", int((res.padj<0.05).sum()),
      "| baseMean>10 & |lfc|>0.5 (all):", int(((res.baseMean>10)&(res.log2FoldChange.abs()>0.5)).sum()))
