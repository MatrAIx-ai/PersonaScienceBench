#!/usr/bin/env python3
"""
Extract the log2 fold change of mexG (PA14_09540) in Delta-rhlI (strain #97)
vs wt (strain #1) from the supplied DESeq2 results object res_1vs97.rds.

Inputs
------
  data/res_1vs97.rds                          : DESeq2 DESeqResults (RDS, gzip, XDR v3)
  data/res_1vs98.rds                          : control (strain #98 vs #1), NOT used for answer
  data/Pseudomonas_aeruginosa_UCBPP-PA14.csv  : PGD annotation (locates mexG locus tag)

The RDS file is R serialization v3 (XDR).  This script implements the minimal
pure-Python parsing needed to recover the DESeq2 results table:
  * header    : magic b'X\\n' + u32 version (3) + u32 writer R-version (0x00040400 -> R 4.4.0)
  * strings   : token b'\\x00\\x04\\x00\\x09' + u32 length + raw bytes (unpadded)
  * rownames  : STRSXP (type 16) that immediately follows the "rownames" attribute
  * columns   : the six contiguous REALSXP (type 14) vectors of length 5828 in the
                DataFrame listData (each: type-token, u32 length, 8*len bytes)
  * col names : STRSXP(6) = baseMean, log2FoldChange, lfcSE, stat, pvalue, padj
                (verified via the serialized `names` attribute)
  * mcols     : description strings encoding the per-column comparison labels
"""
import gzip, struct, csv, re, os, json, math

BASE = os.path.dirname(os.path.abspath(__file__))
COL_HEADER = b'\x00\x00\x00\x0e\x00\x00\x16\xc4'   # REALSXP, length 5828

# ---------------------------------------------------------------- RDS helpers
def load_rds(path):
    with open(path, 'rb') as f:
        return gzip.decompress(f.read())

def parse_header(data):
    assert data[:2] == b'X\n', 'not an XDR RDS file'
    return int.from_bytes(data[2:6], 'big'), int.from_bytes(data[6:10], 'big')

def skip_string(data, pos):
    """b'\\x00\\x04\\x00\\x09' + u32 len + bytes -> (string, next_pos)."""
    assert data[pos:pos+4] == b'\x00\x04\x00\x09', (hex(pos), data[pos:pos+4].hex())
    ln = int.from_bytes(data[pos+4:pos+8], 'big')
    s  = data[pos+8:pos+8+ln].decode('utf-8')
    return s, pos + 8 + ln

def find_string(data, want):
    pat = b'\x00\x04\x00\x09' + struct.pack('>I', len(want.encode())) + want.encode()
    i = data.find(pat)
    assert i >= 0, 'string %r not found' % want
    return i

def read_strsxp(data, pos):
    """pos points at STRSXP type token (u32==16); return (list_of_strings, next_pos)."""
    assert int.from_bytes(data[pos:pos+4], 'big') == 16, hex(pos)
    n = int.from_bytes(data[pos+4:pos+8], 'big')
    p = pos + 8
    out = []
    for _ in range(n):
        s, p = skip_string(data, p)
        out.append(s)
    return out, p

def read_row_names(data):
    pos = find_string(data, 'rownames') + 8 + len('rownames')
    return read_strsxp(data, pos)

def find_column_vectors(data):
    """All REALSXP vectors with length 5828 (exactly the 6 data columns)."""
    starts, pos = [], 0
    while True:
        i = data.find(COL_HEADER, pos)
        if i < 0:
            break
        starts.append(i)
        pos = i + 1
    return starts

def read_column(data, off):
    n = int.from_bytes(data[off+4:off+8], 'big')
    return struct.unpack('>%dd' % n, data[off+8:off+8+8*n])

def read_column_names(data):
    pos = find_string(data, 'baseMean') - 8
    names, _ = read_strsxp(data, pos)      # STRSXP(len 6): baseMean..padj
    return names

def read_mcols_descriptions(data):
    """Six description strings = comparison labels per column."""
    p = find_string(data, 'mean of normalized counts for all samples') - 8
    assert int.from_bytes(data[p:p+4], 'big') == 16, hex(p)
    n = int.from_bytes(data[p+4:p+8], 'big')
    p += 8
    descs = []
    for _ in range(n):
        s, p = skip_string(data, p)
        descs.append(s)
    return descs

# ---------------------------------------------------------------- CSV mapping
def load_gene_map(csv_path):
    m = {}
    with open(csv_path, newline='') as f:
        for row in csv.DictReader(f):
            lt = (row['Locus Tag'] or '').strip()
            if lt:
                m[lt] = ((row['Gene Name'] or '').strip(), (row['Product Name'] or '').strip())
    return m

# ---------------------------------------------------------------------- main
def analyze(rds_path):
    data = load_rds(rds_path)
    version, writer = parse_header(data)
    rownames, _ = read_row_names(data)
    colnames = read_column_names(data)
    descs = read_mcols_descriptions(data)
    starts = find_column_vectors(data)
    assert len(starts) == 6, f'expected 6 column vectors, got {len(starts)}'
    # columns must be contiguous in memory
    for a, b in zip(starts, starts[1:]):
        assert b - a == 8 + 8 * len(rownames), (hex(a), hex(b))
    cols = [read_column(data, s) for s in starts]
    return version, writer, rownames, colnames, descs, cols, starts

def main():
    print('=' * 78)
    print('Analysis: mexG log2 fold change in Delta-rhlI (strain #97) vs wt (#1)')
    print('=' * 78)

    # ---- target: res_1vs97.rds
    rds97 = os.path.join(BASE, 'data', 'res_1vs97.rds')
    ver, wri, rownames, colnames, descs, cols, starts = analyze(rds97)
    print(f'[RDS header]  res_1vs97.rds : serialization v{ver}, writer R-version '
          f'0x{wri:08x} (R4.4.0)')
    print(f'[Structure]   {len(rownames)} rows x {len(colnames)} columns; column vector '
          f'offsets = {[hex(s) for s in starts]}')
    print(f'[Column names] {colnames}')

    # ---- CSV mapping of mexG
    gene_map = load_gene_map(os.path.join(BASE, 'data', 'Pseudomonas_aeruginosa_UCBPP-PA14.csv'))
    hits = [lt for lt, (gn, _p) in gene_map.items()
            if gn.lower() == 'mexg' and lt in set(rownames)]
    print(f'[CSV mapping]  gene name "mexG" -> locus hits present in results: {hits}')
    assert len(hits) == 1, 'mexG -> locus mapping must be unique'
    locus = hits[0]
    row_idx = rownames.index(locus)
    print(f'[Mapping]      mexG -> {locus} (row index {row_idx}; product '
          f'{gene_map[locus][1]!r})')

    # ---- diagnostics
    print('\n--- Diagnostics ---')
    print(f'rows (genes)      : {len(rownames)}')
    print(f'columns           : {len(colnames)}')
    print(f'column order      : {list(colnames)}')
    print('mcols descriptions (comparison labels), same column order:')
    for c, d in zip(colnames, descs):
        print(f'    {c:<14s} : {d}')
    print('per-column summary (min, max, NaN count):')
    for c, vals in zip(colnames, cols):
        nn = sum(1 for v in vals if math.isnan(v))
        print(f'    {c:<14s} n={len(vals):5d}  min={min(vals): .6g}   max={max(vals): .6g}   NaN={nn}')
    ok = (all(v >= 0 for v in cols[0]) and all(v >= 0 for v in cols[2])
          and all(0 <= v <= 1 for v in cols[4]) and all(0 <= v <= 1 for v in cols[5]))
    print(f'value-range sanity: baseMean>=0, lfcSE>=0, pvalue/padj in [0,1] -> '
          f'{"PASS" if ok else "FAIL"}')
    known = set(gene_map)
    missing = [r for r in rownames if r not in known]
    print(f'rownames present in CSV annotation: {len(rownames)-len(missing)}/{len(rownames)} '
          f'({"all match" if not missing else "MISSING "+str(missing[:5])})')

    # ---- target extraction
    lfc = cols[1][row_idx]            # column index 1 == log2FoldChange
    rounded = round(lfc, 2)
    print('\n--- Target value (res_1vs97.rds) ---')
    print(f'gene / locus tag            : mexG / {locus}')
    print(f'log2FoldChange (MLE)        : {lfc!r}')
    print(f'rounded to 2 decimal places : {rounded}')
    print(f'->  {lfc:.2f}')

    # ---- control file
    ver98, wri98, rn98, cn98, d98, col98, st98 = analyze(os.path.join(BASE, 'data', 'res_1vs98.rds'))
    i98 = rn98.index(locus)
    lfc98 = col98[1][i98]
    print('\n--- Control (res_1vs98.rds = strain #98 vs #1) ---')
    print('This file is NOT used for the answer; it only serves as a control.')
    print(f'rows={len(rn98)} cols={cn98}; {locus} (mexG) log2FoldChange={lfc98:.4f}, '
          f'pvalue={col98[4][i98]:.4g}  -> no change, consistent with a different strain.')

    # ---- artifacts
    out_csv = os.path.join(BASE, 'res_1vs97_results_table.csv')
    with open(out_csv, 'w', newline='') as f:
        w = csv.writer(f)
        w.writerow(['rownames'] + list(colnames))
        for r, *vals in zip(rownames, *cols):
            w.writerow([r] + [float(v) for v in vals])
    print(f'\nSaved results table: {out_csv}')
    summary = {'gene': 'mexG', 'locus': locus, 'row_index': row_idx,
               'log2FoldChange': lfc, 'log2FoldChange_2dp': rounded,
               'nrows': len(rownames), 'ncols': len(colnames),
               'colnames': list(colnames), 'mcols': list(descs)}
    with open(os.path.join(BASE, 'analysis_summary.json'), 'w') as f:
        json.dump(summary, f, indent=2)
    print(f'Saved summary     : {os.path.join(BASE, "analysis_summary.json")}')
    return rounded

if __name__ == '__main__':
    ans = main()
    print('\nFINAL ANSWER:', ans)
