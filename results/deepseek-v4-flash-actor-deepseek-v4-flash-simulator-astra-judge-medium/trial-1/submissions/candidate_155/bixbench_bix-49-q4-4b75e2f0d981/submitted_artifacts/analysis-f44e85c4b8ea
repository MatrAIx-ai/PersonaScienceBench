#!/usr/bin/env python3
"""
BixBench bix-49-q4 -- Issy ASXL1 blood, DESeq2-style differential expression.
FINAL ANALYSIS (executable end-to-end).

Question: total number of significantly differentially regulated genes
(padj < 0.05), both up and down, using DESeq2 with LFC shrinkage (type=apeglm),
comparing disease (ASXL1 mutation) vs control.

Environment: R/DESeq2/pydeseq2 unavailable and no network; this is a faithful
pure-Python reimplementation of the DESeq2 algorithm
(size factors -> NB dispersion MLE + robust trend -> empirical-Bayes MAP
shrinkage -> NB GLM Wald test -> independent filtering -> BH padj; plus
empirical-Bayes (apeglm-style) LFC shrinkage).

Pipeline (per the approved plan):
  * count matrix = 60,662 genes x 19 matched samples (MGD1640B, MGD1641B drop:
    present in the count table but absent from the coldata workbook)
  * design ~ condition with Control as reference level (ASXL1 = disease)
  * sex/age NOT in primary model (age missing 7/19); sex-adjusted run = sensitivity
  * significant genes = all genes with padj < 0.05 (up + down); count = ANSWER
"""
import sys, os, json, time
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
import numpy as np
import pandas as pd
from scipy import stats as _st
import deseq2_v2 as v2

DATA = '/workspace/data'
OUT  = '/workspace/output'
os.makedirs(OUT, exist_ok=True)

# ----------------------------------------------------------------------------
# 1. Load inputs
# ----------------------------------------------------------------------------
cnt = pd.read_csv(f'{DATA}/Issy_ASXL1_blood_featureCounts_GeneTable_final.txt',
                  sep=r'\s+', engine='python').set_index('Geneid')
cd = pd.read_excel(f'{DATA}/Issy_ASXL1_blood_coldata_gender.xlsx').set_index('sample')
matched = [s for s in cnt.columns if s in cd.index]          # 19 shared samples
X = cnt[matched].astype(int)
cond = (cd.loc[matched, 'condition'] == 'ASXL1').astype(float).values   # 1 = disease
sex_cov = (cd.loc[matched, 'sex'] == 'M').astype(float).values
sf = v2.estimate_size_factors(X.values.astype(float))
gene_ids = cnt.index.values

# ----------------------------------------------------------------------------
# 2. Primary pipeline: ~condition, Control ref, no pre-filter
# ----------------------------------------------------------------------------
print(f'genes={X.shape[0]} samples={X.shape[1]} '
      f'ASXL1={int(cond.sum())} Control={len(cond)-int(cond.sum())}', flush=True)
res, meta = v2.run_deseq2(X.values.astype(float), sf, cond, disp_mode='plain')
res['gene_id'] = gene_ids

# ----------------------------------------------------------------------------
# 3. Annotation (gencode v31: 1:1 EnsemblID -> gene symbol/type)
# ----------------------------------------------------------------------------
gen = pd.read_csv(f'{DATA}/gencode.v31.primary_assembly.genes.csv')
gen['gene_id_clean'] = gen['gene_id'].astype(str).str.replace(r'\.[0-9]+$', '', regex=True)
g_gene = gen[gen['type'] == 'gene'].drop_duplicates('gene_id_clean').set_index('gene_id_clean')
id_clean = res['gene_id'].astype(str).str.replace(r'\.[0-9]+$', '', regex=True)
res['gene_symbol'] = id_clean.map(g_gene['gene_name']).values
res['gene_type']   = id_clean.map(g_gene['gene_type']).values
sym_counts = res['gene_symbol'].value_counts()
res['symbol_ambiguous'] = res['gene_symbol'].isin(sym_counts[sym_counts > 1].index)

# ----------------------------------------------------------------------------
# 4. apeglm-style empirical-Bayes LFC shrinkage (EB normal prior)
#    EB prior sd from well-measured genes (baseMean>=20).
# ----------------------------------------------------------------------------
def eb_shrink(beta, se, bm, bm_min=20.0):
    m = (bm >= bm_min) & np.isfinite(beta) & (se > 0)
    b = beta[m]; s2 = se[m]**2
    tau2 = max(0.0, float(np.mean(b**2) - np.mean(s2)))
    if tau2 < 1e-8:
        tau2 = float(np.median(b**2))
    ok = np.isfinite(beta) & (se > 0)
    w = tau2/(tau2 + se[ok]**2)
    pm = beta[ok]*w; psd = np.sqrt(se[ok]**2*tau2/(tau2 + se[ok]**2))
    return pm, psd, np.sqrt(tau2), ok, np.clip(1-_st.norm.cdf(np.abs(pm)/np.clip(psd,1e-12,None)),0,1)

pm, psd, tau, oki, sv = eb_shrink(res['log2FoldChange'].values,
                                  res['lfcSE'].values, res['baseMean'].values)
res['shrunkenLFC'] = np.nan; res['shrunkenLFCSE'] = np.nan; res['svalue'] = np.nan
res.loc[oki, 'shrunkenLFC'] = pm; res.loc[oki, 'shrunkenLFCSE'] = psd
res.loc[oki, 'svalue'] = sv

# ----------------------------------------------------------------------------
# 5. Significance (padj < 0.05, both directions)
# ----------------------------------------------------------------------------
res['significant'] = res['padj'] <= 0.05
res['direction'] = np.where(res['significant'],
                            np.where(res['shrunkenLFC'] > 0, 'up', 'down'), 'ns')
sig = res[res['significant']].copy()
n_de = len(sig); n_up = int((sig['direction']=='up').sum()); n_dn = int((sig['direction']=='down').sum())
sval_count = int((res['svalue'] < 0.05).sum())
FINAL_ANSWER = n_de

# ----------------------------------------------------------------------------
# 6. Sensitivities (cached from already-run configurations) + derived metrics
# ----------------------------------------------------------------------------
def bh_adjust(p):
    p = np.asarray(p, float); out = np.full(len(p), np.nan)
    valid = np.isfinite(p); pv = p[valid].copy(); m = len(pv)
    if m:
        order = np.argsort(pv); r = np.arange(1, m+1)
        adj = np.minimum(1.0, np.minimum.accumulate((pv[order]*m/r)[::-1])[::-1])
        ranked = np.empty(m); ranked[order] = adj; out[valid] = ranked
    return out

res_cr = pd.read_csv(f'{OUT}/cr_res.csv')
res_pf = pd.read_csv(f'{OUT}/prefilter10_res.csv')
res_sx = pd.read_csv(f'{OUT}/sex_res.csv')
padj_nof = np.full(len(res), np.nan)
fin = np.isfinite(res['pvalue'].values); padj_nof[fin] = bh_adjust(res['pvalue'].values[fin])
prim = set(res['gene_id'][res['significant']])
sets = {k: set(d['gene_id'][d['padj']<=0.05]) for k,d in
        {'cr':res_cr,'prefilter10':res_pf,'sex':res_sx}.items()}
near = int(((res['padj']>=0.03)&(res['padj']<=0.10)).sum())
sens = dict(
    cr_clamped_dispersion         = len(sets['cr']),
    prefilter_rowSums10           = len(sets['prefilter10']),
    design_condition_plus_sex     = len(sets['sex']),
    no_independent_filtering      = int(np.nansum(padj_nof<=0.05)),
    apeglm_svalue_below_005      = sval_count,
    overlap_primary_prefilter10   = len(prim & sets['prefilter10']),
    overlap_primary_cr            = len(prim & sets['cr']),
    overlap_primary_sex           = len(prim & sets['sex']),
    n_genes_padj_03_10_boundary   = near)

summary = dict(question="padj<0.05 total DE genes (up+down), ASXL1 vs Control, DESeq2 + apeglm",
               final_answer=FINAL_ANSWER, up=n_up, down=n_dn,
               design="~ condition (Control reference)", disp_mode="plain NB-MLE + robust trend/MAP",
               n_tested=60662, n_with_pvalue=int(np.isfinite(res['pvalue']).sum()),
               prior_var=meta['prior_var'], theta_star=float(meta['theta_star']),
               ebfs_prior_tau=float(tau), svalue_count=sval_count,
               sensitivities=sens)
json.dump(summary, open(f'{OUT}/summary.json','w'), indent=2)

# ----------------------------------------------------------------------------
# 7. Save outputs and report
# ----------------------------------------------------------------------------
res.sort_values('padj').to_csv(f'{OUT}/deseq2_results_all.csv', index=False)
sig.sort_values('padj').to_csv(f'{OUT}/deseq2_significant_genes.csv', index=False)
sig.sort_values('padj').head(30).to_csv(f'{OUT}/deseq2_top30.csv', index=False)

print('\n==================== FINAL RESULT ====================')
print(f'Total significantly DE genes (padj < 0.05, up+down) = {FINAL_ANSWER}')
print(f'  up-regulated:  {n_up}')
print(f'  down-regulated:{n_dn}')
print(f'  (apeglm analog svalue<0.05: {sval_count}, reported only as sensitivity)')
print('======================================================')
print(json.dumps(summary, indent=2))
