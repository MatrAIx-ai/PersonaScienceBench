"""DESeq2-equivalent DE analysis (disease vs control) for bix-5-q1.
Normalization : DESeq2 median-of-ratios size factors (log-library offsets).
Per-gene test : NB2 GLM (log link) with offset=log(size factor); dispersion alpha
                per gene = trend (bin-median of Pearson method-of-moments alpha over
                baseMean bins), floored by the gene's own moment estimate
                [ alpha_final = max(trend_bin, raw_alpha) ] - an edgeR/DESeq2-style
                two-step with shrinkage toward the mean-variance trend.
Wald test on 'condition_disease' coefficient (ref level: control; sex covariate in A).
Designs: A = ~ sex + condition ; B = ~ condition (sensitivity). BH-FDR across genes.
"""
import pandas as pd, numpy as np, re, warnings, time
import statsmodels.api as sm
from statsmodels.genmod.families import NegativeBinomial as NBF
from statsmodels.stats.multitest import multipletests
warnings.filterwarnings("ignore")
DATA="data"; T0=time.time()
cold=pd.read_excel(f"{DATA}/Issy_ASXL1_fibro_coldata_gender.xlsx")
fc=pd.read_csv(f"{DATA}/Issy_ASXL1_fibro_featureCounts_GeneTable_final.txt",sep=r'\s+')
samps=[s for s in cold['sample'] if s in fc.columns]
cold=cold.set_index('sample').loc[samps]
cts=fc[['Geneid']+samps].set_index('Geneid')[samps]
keep=(cts>=10).sum(axis=1)>=7
print(f"filter: count>=10 in >=7/14 -> kept {int(keep.sum())}/60662")
cts=cts[keep]
# size factors
gm=np.exp(cts.apply(lambda r:np.mean(np.log(r[r>0])) if (r>0).any() else np.nan,axis=1))
sf=np.median(np.log(cts.div(gm,axis=0)),axis=0); sf=sf-sf.mean()
# designs
sex=(cold['sex'].to_numpy()=='M').astype(int); cond=(cold['condition'].to_numpy()=='disease').astype(int)
DA=dict(nam=['Intercept','sexM','condition_disease'],X=np.column_stack([np.ones(14),sex,cond]))
DB=dict(nam=['Intercept','condition_disease'],X=np.column_stack([np.ones(14),cond]))
off=np.exp(sf); Y=cts.to_numpy(dtype=float); gids=cts.index

# ---- preliminary Poisson GLM: mu, baseMean, raw alpha ----
mu_store=np.zeros((len(Y),14)); raw=np.zeros(len(Y)); bmean=np.zeros(len(Y))
for i in range(len(Y)):
    pf=sm.GLM(Y[i],DA['X'],family=sm.families.Poisson(),offset=off).fit()
    mu=pf.fittedvalues; mu_store[i]=mu; bmean[i]=mu.mean()
    raw[i]=max(((Y[i]-mu)**2/mu).sum()-11, 0)/max(mu.sum(),1e-9)   # (n-3=11)
# ---- trend alpha per log10(baseMean) bin (median) ----
tmp=pd.DataFrame({'l10':np.log10(np.clip(bmean,0.5,None)),'raw':raw})
bins=np.linspace(tmp.l10.min(),tmp.l10.max(),21)
tr=tmp.groupby(pd.cut(tmp.l10,bins))['raw'].median()
bins_lab=tr.index
tmp['bin']=pd.cut(tmp.l10,bins)
trend_map={iv:tr[iv] for iv in bins_lab}
alpha=np.array([max(trend_map.get(iv,0.05), r) for iv,r in zip(tmp['bin'],raw)])
print("dispersion alpha: median=%.4g, p10=%.4g, p90=%.4g"%(np.median(alpha),np.percentile(alpha,10),np.percentile(alpha,90)))

def fit_nb(design):
    X=design['X']; cols=design['nam']; rows=[]
    for i in range(len(Y)):
        try:
            m=sm.GLM(Y[i],X,family=NBF(alpha=alpha[i]),offset=off).fit()
            b=m.params; se=np.sqrt(np.diag(m.cov_params())); pv=m.pvalues
            rows.append([str(gids[i])]+list(b)+list(se)+list(pv))
        except Exception:
            rows.append([str(gids[i])]+[np.nan]*(3*len(cols)))
    ci=[c+"_beta" for c in cols]+[c+"_se" for c in cols]+[c+"_p" for c in cols]
    df=pd.DataFrame(rows,columns=['gene_id']+ci)
    df['log2FC_condition']=df['condition_disease_beta']/np.log(2)
    df['padj_condition']=multipletests(df['condition_disease_p'].fillna(1),method='fdr_bh')[1]
    return df
resA=fit_nb(DA); resB=fit_nb(DB)
print(f"fit done {time.time()-T0:.0f}s")

g=pd.read_csv(f"{DATA}/gencode.v31.primary_assembly.genes.csv",index_col=0)
ann=g[['gene_id','gene_name','gene_type','hgnc_id']].drop_duplicates('gene_id').set_index('gene_id')
resA=resA.join(ann,on='gene_id'); resB=resB.join(ann,on='gene_id')
resA.to_csv("analysis/DE_results_modelA_sex_condition.csv",index=False)
resB.to_csv("analysis/DE_results_modelB_condition.csv",index=False)
for r,n in [(resA,"Model A ~ sex + condition"),(resB,"Model B ~ condition")]:
    sig=r['padj_condition']<0.05; main=sig & (r['log2FC_condition'].abs()>1)
    print(f"[{n}] genes={len(r)} padj<.05={int(sig.sum())} DEG(padj<.05&|lfc|>1)={int(main.sum())} "
          f"up={int((main&(r.log2FC_condition>0)).sum())} down={int((main&(r.log2FC_condition<0)).sum())}")
reg=lambda s:re.sub(r'\.\d+$','',str(s))
for r,m,tag in [(resA,resA['padj_condition']<0.05,'modelA_padjOnly'),(resA,(resA['padj_condition']<0.05)&(resA['log2FC_condition'].abs()>1),'modelA'),
                (resB,resB['padj_condition']<0.05,'modelB_padjOnly'),(resB,(resB['padj_condition']<0.05)&(resB['log2FC_condition'].abs()>1),'modelB')]:
    pd.DataFrame({'gene_id':r.loc[m,'gene_id'],'ensembl_noVer':r.loc[m,'gene_id'].map(reg),
                  'log2FC':r.loc[m,'log2FC_condition'].round(3),'padj':r.loc[m,'padj_condition']}).sort_values('padj').to_csv(f"analysis/DEG_{tag}.csv",index=False)
print("\nTop 15 Model A by padj:")
print(resA.sort_values('padj_condition')[['gene_name','gene_type','log2FC_condition','padj_condition']].head(15).to_string(index=False))
print("\nTop 15 Model B by padj:")
print(resB.sort_values('padj_condition')[['gene_name','gene_type','log2FC_condition','padj_condition']].head(15).to_string(index=False))
print("\nDEG overlap A vs B (main):", int((set(resA.loc[(resA.padj_condition<.05)&(resA.log2FC_condition.abs()>1),'gene_id']) & set(resB.loc[(resB.padj_condition<.05)&(resB.log2FC_condition.abs()>1),'gene_id'])).__len__()))
