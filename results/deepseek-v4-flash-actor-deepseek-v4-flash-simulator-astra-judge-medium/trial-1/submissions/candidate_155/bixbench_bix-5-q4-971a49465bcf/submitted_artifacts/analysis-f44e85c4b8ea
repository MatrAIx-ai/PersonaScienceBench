#!/usr/bin/env python3
"""Differential expression: ASXL1-mutated (disease) vs control.
edgeR/DESeq2-style NB-GLM:
  - median-of-ratios size factors (DESeq2)
  - design-fitted means via robust IRLS (seed = log row-mean of normalized counts)
  - genewise dispersion = CR-adjusted Pearson method-of-moments
  - trend (binned median of log-phi vs log-mean), df-weighted shrinkage
  - final NB-GLM fit (sex + condition) -> Wald test, BH-FDR
  - unadjusted (~condition) model as sensitivity
14 coldata samples; MGD1640F/MGD1641F excluded.
"""
import numpy as np, pandas as pd
from scipy import stats
from scipy.special import gammaln as _g
from scipy.interpolate import interp1d
from statsmodels.stats.multitest import multipletests

def g_l(x): return _g(np.clip(x, 1e-300, None))
def s_eta(e): return np.clip(e, -30, 30)
def s_mu(e):  return np.exp(s_eta(e))

fc = pd.read_csv('data/Issy_ASXL1_fibro_featureCounts_GeneTable_final.txt', sep=r'\s+', comment='#')
cd = pd.read_excel('data/Issy_ASXL1_fibro_coldata_gender.xlsx')
assert list(fc.columns[1:15]) == list(cd['sample'])
samples = cd['sample'].tolist()
Y = fc[samples].astype(float).values
gene_ids = fc['Geneid'].values
n_genes, n = Y.shape
libsize = Y.sum(axis=0)

cpm = Y / libsize * 1e6
keep = (cpm > 1).sum(axis=1) >= 4
print(f"filtered genes: {keep.sum()} / {n_genes}")
Yf = Y[keep]; gf = gene_ids[keep]

# size factors (DESeq2 median-of-ratios)
loggeo = np.zeros(Yf.shape[0])
for i in range(Yf.shape[0]):
    pos = Yf[i] > 0
    loggeo[i] = np.mean(np.log(Yf[i,pos])) if pos.any() else np.log(1e-6)
ratio = Yf / np.exp(loggeo)[:,None]
sf = np.median(ratio, axis=0); sf = sf / np.exp(np.mean(np.log(sf)))
norm = Yf / sf[None,:]
print("size factors:", np.round(sf,4))

sexM = (cd['sex'].values=='M').astype(float)
cond = (cd['condition'].values=='disease').astype(float)
X  = np.column_stack([np.ones(n), sexM, cond])
Xu = np.column_stack([np.ones(n), cond])
off = np.log(sf)
mu_start = np.clip(norm.mean(axis=1), 1e-2, None)[:,None]  # per-gene seed

def irls_fit(Yg, Xm, phi_vec, off, mu_seed):
    """Per-gene NB IRLS, phi_vec per gene (broadcast). Returns beta (G x p) and mu (G x n)."""
    G, p = Yg.shape[0], Xm.shape[1]
    beta = np.zeros((G, p))
    eta = np.log(np.clip(mu_seed,1e-9,None)) + off[None,:]
    mu = np.exp(eta[None]) if False else np.exp(eta)
    for it in range(60):
        pv = phi_vec[:,None]
        w = mu/(1+pv*mu)
        z = (Yg-mu)/np.maximum(mu,1e-9) + eta
        XW = Xm[None,:,:]*w[:,:,None]
        XtWX = np.einsum('npk,npl->nkl', XW, Xm[None,:,:])
        XtWz = np.einsum('npk,np->nk', XW, z)
        try:
            bn = np.linalg.solve(XtWX, XtWz[:,:,None])[:,:,0]
        except np.linalg.LinAlgError:
            bn = beta
        if np.nanmax(np.abs(bn-beta)) < 1e-8:
            beta = bn; break
        beta = bn
        eta = s_eta(Xm.dot(beta.T).T + off[None,:])
        mu = s_mu(eta)
    return beta, mu

# 1) initial fit with common dispersion phi=0.05 (robust, from log-mean seed)
beta0, mu0 = irls_fit(Yf, X, np.full(Yf.shape[0], 0.05), off, mu_start)

# 2) genewise dispersion: CR-adjusted Pearson method-of-moments
# df-corrected NB moment-of-moments dispersion:
#   RSS_i - (n-p)*mean(mu_i)  accounts for Poisson baseline variance
RSS = ((Yf - mu0)**2).sum(axis=1)
mu_mean = mu0.mean(axis=1)
phi_mm = (RSS - (n - X.shape[1]) * mu_mean) / np.maximum((mu0**2).sum(axis=1), 1e-9)
phi_mm = np.clip(phi_mm, 1e-6, 10)
print("Pearson dispersion: median=%.4f mean=%.4f" % (np.median(phi_mm), phi_mm.mean()))

# 3) trend: binned median of log(phi) vs log(mean), then interp, and df-weighted shrinkage
mu_bar = np.clip(norm.mean(axis=1), 1e-3, None)
x = np.log(mu_bar); y = np.log(phi_mm)
ok = np.isfinite(x)&np.isfinite(y); x, y = x[ok], y[ok]
qs = np.quantile(x, np.linspace(0,1,26)); bx, by = [], []
for b in range(25):
    sel = (x>=qs[b])&(x<=qs[b+1])
    if sel.sum()>0: bx.append(np.median(x[sel])); by.append(np.median(y[sel]))
tf = interp1d(np.array(bx), np.array(by), bounds_error=False, fill_value=(by[0],by[-1]))
phi_trend = np.clip(np.exp(tf(np.log(mu_bar))), 1e-6, 1.0)
df_resid = n - X.shape[1]; prior_df = 4.0
lp_final = (df_resid*np.log(phi_mm) + prior_df*np.log(phi_trend))/(df_resid+prior_df)
phi_final = np.clip(np.exp(lp_final), 1e-6, 10)
print("shrunken dispersion: median=%.4f" % np.median(phi_final))
np.savetxt('analysis/results/dispersion_diagnostics.txt',
           np.column_stack([np.log10(mu_bar), np.log10(phi_mm), np.log10(phi_trend), np.log10(phi_final)]),
           header='log10_mean log10_phi_mm log10_phi_trend log10_phi_final')

# 4) final fits
p = X.shape[1]
beta_f  = np.zeros((Yf.shape[0], p)); var_cond  = np.zeros(Yf.shape[0]); mu_final  = np.zeros((Yf.shape[0], n))
beta_u  = np.zeros((Yf.shape[0], 2)); var_cond_u = np.zeros(Yf.shape[0])
for i in range(Yf.shape[0]):
    yy = Yf[i]; phi = phi_final[i]
    eta = np.log(mu_start[i,0]) + off; beta = np.zeros(p); mu = s_mu(eta)
    for it in range(80):
        w = mu/(1+phi*mu); z = (yy-mu)/np.maximum(mu,1e-9)+eta
        XW = X*w[:,None]
        try: bn = np.linalg.solve(XW.T@X, XW.T@z)
        except np.linalg.LinAlgError: break
        if np.max(np.abs(bn-beta))<1e-9: beta=bn; break
        beta=bn; eta=s_eta(X@beta+off); mu=s_mu(eta)
    beta_f[i]=beta; mu_final[i]=mu
    var_cond[i]=np.linalg.inv((X*np.sqrt(w)[:,None]).T@(X*np.sqrt(w)[:,None]))[2,2]
    # unadjusted
    phi = phi_final[i]; eta = np.log(mu_start[i,0])+off; beta=np.zeros(2); mu=s_mu(eta)
    for it in range(80):
        w = mu/(1+phi*mu); z=(yy-mu)/np.maximum(mu,1e-9)+eta
        XW = Xu*w[:,None]
        try: bn=np.linalg.solve(XW.T@Xu, XW.T@z)
        except np.linalg.LinAlgError: break
        if np.max(np.abs(bn-beta))<1e-9: beta=bn; break
        beta=bn; eta=s_eta(Xu@beta+off); mu=s_mu(eta)
    beta_u[i]=beta
    var_cond_u[i]=np.linalg.inv((Xu*np.sqrt(w)[:,None]).T@(Xu*np.sqrt(w)[:,None]))[1,1]

l2fc = beta_f[:,2]/np.log(2); se=np.sqrt(var_cond)
pv = 2*(1-stats.norm.cdf(np.abs(beta_f[:,2]/np.maximum(se,1e-300)))); fdr = multipletests(pv, method='fdr_bh')[1]
l2fc_u = beta_u[:,1]/np.log(2); se_u=np.sqrt(var_cond_u)
pv_u = 2*(1-stats.norm.cdf(np.abs(beta_u[:,1]/np.maximum(se_u,1e-300)))); fdr_u = multipletests(pv_u, method='fdr_bh')[1]

res = pd.DataFrame({'gene_id': gf, 'baseMean': mu_final.mean(axis=1),
                    'log2FoldChange_sex_adj': l2fc, 'lfcSE_sex_adj': se/np.log(2),
                    'pvalue_sex_adj': pv, 'padj_sex_adj': fdr,
                    'log2FoldChange_unadj': l2fc_u, 'lfcSE_unadj': se_u/np.log(2),
                    'pvalue_unadj': pv_u, 'padj_unadj': fdr_u,
                    'dispersion_final': phi_final}).sort_values('padj_sex_adj')

gmap = pd.read_csv('data/gencode.v31.primary_assembly.genes.csv', dtype=str)[['gene_id','gene_name']]
res2 = res.merge(gmap, on='gene_id', how='left')
res2.to_csv('analysis/results/DE_all_genes_with_symbols.tsv', sep='\t', index=False)
print("\n== DE summary (sex-adjusted) ==")
for th in [0.05,0.1,0.2]:
    m=(res.padj_sex_adj<th)
    print(f"padj<{th}: {m.sum()} (up {int((m&(res.log2FoldChange_sex_adj>0)).sum())}, down {int((m&(res.log2FoldChange_sex_adj<0)).sum())})")
m=(res.padj_sex_adj<0.05); print(f"DE padj<0.05 & |l2fc|>1: {int((m&(res.log2FoldChange_sex_adj.abs()>1)).sum())}")
print("ASXL1:", res2[res2.gene_name=='ASXL1'][['gene_name','baseMean','log2FoldChange_sex_adj','padj_sex_adj']].to_dict('records'))
print("top DE:")
print(res2[['gene_name','log2FoldChange_sex_adj','padj_sex_adj','baseMean']].head(15).to_string())
print("saved: analysis/results/DE_all_genes_with_symbols.tsv")
