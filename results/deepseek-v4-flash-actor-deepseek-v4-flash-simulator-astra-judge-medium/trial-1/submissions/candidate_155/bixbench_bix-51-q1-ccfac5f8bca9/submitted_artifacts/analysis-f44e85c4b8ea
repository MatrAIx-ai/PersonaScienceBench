"""
BixBench bix-51-q1
Logistic regression: PR ~ Age (age as the only predictor), n=80 valid records.
Predicted probability of efficacy PR at Age = 65 (with treatment, full cohort).
"""
import pandas as pd
import numpy as np
import statsmodels.api as sm

# ---- Load and prepare data ----
df = pd.read_excel('data/data.xlsx', sheet_name='Sheet1')
df = df[df['Sequence number'].notna()].copy()          # drop 41 empty padding rows
df['AgeNum'] = pd.to_numeric(df['Age'], errors='coerce')  # integer years (40-75)
df['PR'] = (df['Efficacy'] == 'PR').astype(int)            # PR=1; PD/SD=0

print("Valid records used:", len(df))
print("PR=1:", int(df['PR'].sum()), " PR=0:", int((df['PR']==0).sum()))
print("Age range:", int(df['AgeNum'].min()), "-", int(df['AgeNum'].max()))

# ---- Fit Logit(PR ~ Age) ----
X = sm.add_constant(df['AgeNum'])          # [1, Age]
y = df['PR']
model = sm.Logit(y, X).fit(disp=0)

print("\n=== Model diagnostics ===")
print("Converged:", model.converged)
print("Hessian invertible (normalized cov exists):",
      model.normalized_cov_params is not None)
print("nobs:", int(model.nobs), "| df_model:", model.df_model)

print("\n=== Coefficients (Logit(PR) = b0 + b1*Age) ===")
print(model.summary2().tables[1].to_string())
b0, b1 = model.params['const'], model.params['AgeNum']

# ---- Prediction at Age=65 (inverse link) + delta-method 95% CI ----
pred = model.get_prediction(pd.DataFrame({'const': 1.0, 'AgeNum': [65.0]}))
sf = pred.summary_frame(alpha=0.05)   # 'predicted','se','ci_lower','ci_upper'
p65   = float(sf['predicted'].iloc[0])
se65  = float(sf['se'].iloc[0])
ci_lo = float(sf['ci_lower'].iloc[0])
ci_up = float(sf['ci_upper'].iloc[0])

print("\n=== Predicted P(PR | Age=65) ===")
print(f"Linear predictor at 65 : {b0:.4f} + {b1:.4f}*65 = {b0 + b1*65:.4f}")
print(f"Point estimate (inverse logit) : {p65:.4f}")
print(f"Std error  : {se65:.4f}")
print(f"95% CI (delta method) : [{ci_lo:.4f}, {ci_up:.4f}]")
manual = 1/(1+np.exp(-(b0 + b1*65)))
print(f"Manual check 1/(1+exp(-(b0+b1*65))) : {manual:.4f}")

print("\n=== Interpretation ===")
print(f"For the fitted cohort, a 65-year-old patient has an estimated {p65:.3f} "
      f"probability (95% CI {ci_lo:.3f}-{ci_up:.3f}) of achieving efficacy PR "
      f"under treatment.")
