"""Analysis for bix-51-q2: AIC of logistic regression logit(P(PR)) ~ BMI.

Approved plan:
  - Use the 80 complete records (Sequence number 1-80); drop trailing blank rows.
  - Binary outcome Y=1 iff Efficacy == 'PR' (41), Y=0 = PD+SD merged (39).
  - Model: logit(P(Y=1)) = b0 + b1*BMI, statsmodels Logit (MLE), raw BMI units.
  - Primary: standard AIC = -2*logL + 2k, k=2 (result.aic).
  - Sensitivity: AICc = AIC + 2k(k+1)/(n-k-1), n=80, k=2 => +12/77.
"""
import pandas as pd
import numpy as np
import statsmodels.api as sm

# 1) Load and clean: keep rows where both BMI and Efficacy are non-missing
df = pd.read_excel("data/data.xlsx", sheet_name="Sheet1")
sub = df.dropna(subset=["BMI", "Efficacy"]).copy()
sub = sub.reset_index(drop=True)

print("Usable records:", len(sub))
print("Sequence range:", sub['Sequence number'].min(), "-", sub['Sequence number'].max())

# 2) Binary outcome
sub["Y"] = (sub["Efficacy"] == "PR").astype(int)
print("Y=1 (PR):", int(sub['Y'].sum()), "| Y=0 (PD+SD):", int((sub['Y'] == 0).sum()))

# 3) Fit logistic regression
X = sm.add_constant(sub["BMI"])            # [1, BMI]
y = sub["Y"]
model = sm.Logit(y, X).fit(disp=False)

beta0 = model.params["const"]
beta1 = model.params["BMI"]
n = model.nobs
k = len(model.params)                       # 2 (intercept + BMI)
loglik = model.llf
aic = model.aic                             # -2*logL + 2k
aicc = aic + 2 * k * (k + 1) / (n - k - 1)  # small-sample correction

print("\n--- Model summary ---")
print(model.summary2().tables[1].to_string())
print("Converged:", model.mle_retvals['converged'])
print("n =", int(n), "| k =", int(k))
print("logL =", f"{loglik:.10f}")
print("beta0 (intercept) =", f"{beta0:.10f}")
print("beta1 (BMI)       =", f"{beta1:.10f}")
print("AIC  (standard)   =", f"{aic:.10f}")
print("AICc (=AIC+12/77) =", f"{aicc:.10f}")

# Separation / convergence check
print("\nCoefficient std err:", model.bse.to_dict())
print("Min/max predicted prob:", float(model.predict(X).min()), float(model.predict(X).max()))

# Round-trip sanity check: AIC must equal -2*logL + 2*k
print("\nCheck AIC == -2logL + 2k:", np.isclose(aic, -2 * loglik + 2 * k))

print("\nRESULT (final):")
print(f"  AIC  = {aic:.6f}")
print(f"  AICc = {aicc:.6f}")
