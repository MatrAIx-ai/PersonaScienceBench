#!/usr/bin/env python3
"""
BixBench bix-51-q3: p-value for Age in combined logistic regression
   PR ~ BMI + Age + Gender
Data source: data/data.xlsx, Sheet1 (rows 0-79 real data; rows 80-120 blank).
Outcome: PR = 1, PD/SD = 0. Gender: Female reference. Age, BMI numeric continuous.
"""
import numpy as np
import pandas as pd
from scipy import stats
import statsmodels.api as sm

DATA = '../data/data.xlsx'

# ----------------------------------------------------------------------------
# 1) Load and prepare data
# ----------------------------------------------------------------------------
df = pd.read_excel(DATA, sheet_name='Sheet1', header=0)
print("Raw sheet shape (incl. trailing blank rows):", df.shape)

df = df[df['Sequence number'].notna()].copy().reset_index(drop=True)
print("Usable data rows (N):", len(df))

df['Age'] = pd.to_numeric(df['Age'], errors='coerce').astype(float)
df['PR']  = (df['Efficacy'].astype(str).str.strip() == 'PR').astype(int)
df['Gender_F'] = (df['Gender'].astype(str).str.strip() == 'Female').astype(int)

print("Outcome counts (PR=1 / non-PR=0):", df['PR'].value_counts().to_dict())
print("Efficacy:", df['Efficacy'].value_counts().to_dict())
print("Gender:", df['Gender'].value_counts().to_dict())
print("Missing in model cols:", df[['Age','BMI','Gender_F','PR']].isna().sum().to_dict())

# ----------------------------------------------------------------------------
# 2) Combined logistic regression: PR ~ BMI + Age + Gender (Female ref.)
# ----------------------------------------------------------------------------
y = df['PR'].values
X = df[['BMI','Age','Gender_F']].copy()
X.insert(0, 'Intercept', 1.0)

model = sm.Logit(y, X).fit(disp=False)
print("\n" + "="*72)
print("COMBINED LOGISTIC REGRESSION  PR ~ BMI + Age + Gender")
print("="*72)
print(model.summary())
print("="*72)

coef_age = model.params['Age']; se_age = model.bse['Age']
z_age    = model.tvalues['Age']; p_age  = model.pvalues['Age']
print("Age coefficient (log-odds/year): %.6f" % coef_age)
print("Age SE:                         %.6f" % se_age)
print("Age z:                          %.6f" % z_age)
print("Age Wald p-value:               %.10f" % p_age)

# manual p = 2*(1-Phi(|z|))
p_manual = 2.0*(1.0 - stats.norm.cdf(abs(z_age)))
print("Manual p check:", "%.10f matches (%.1f)" % (p_manual, np.isclose(p_manual, p_age)))

# ----------------------------------------------------------------------------
# 3) Exact observed-information (Hessian) cross-check  == what statsmodels & R glm use
# ----------------------------------------------------------------------------
beta = model.params.values
eta = X.values @ beta
pi = 1.0/(1.0+np.exp(-eta))
# Negative Hessian of log-likelihood (observed information), analytic:
#  I = X' W X,  W = diag(pi*(1-pi))
I = (X.values.T * (pi*(1-pi))) @ X.values
cov = np.linalg.inv(I)                 # exact, same as statsmodels' bse^2
se_cross = np.sqrt(np.diag(cov))
z_cross  = beta[2]/se_cross[2]
p_cross  = 2.0*(1.0 - stats.norm.cdf(abs(z_cross)))
print("\nAnalytic observed-information cross-check (X'WX, same as R glm/statsmodels):")
for n, c, s in zip(['Intercept','BMI','Age','Gender_F'], beta, se_cross):
    print("  %-10s coef=%.6f  se=%.6f" % (n, c, s))
print("  Age z=%.6f p=%.10f  -> se/p match statsmodels: %s / %s"
      % (z_cross, p_cross, np.allclose(se_cross, model.bse.values, atol=1e-10),
         np.isclose(p_cross, p_age, atol=1e-10)))

# Also compare to Fisher-information (expected info = same X'WX here)
# and confirm no separation issue
print("\nMin/Max fitted prob: %.6f / %.6f (no complete separation)" %
      (pi.min(), pi.max()))

# ----------------------------------------------------------------------------
# 4) Save evidence (DataFrame-typed summary table + result)
# ----------------------------------------------------------------------------
tbl = model.summary2().tables[1].copy()
tbl.to_csv('model_summary.csv')
res = pd.DataFrame([{
    'n': int(len(df)), 'n_PR': int((df['PR']==1).sum()), 'n_nonPR': int((df['PR']==0).sum()),
    'coef_age': float(coef_age), 'se_age': float(se_age), 'z_age': float(z_age),
    'p_age_wald': float(p_age), 'p_age_exact_check': float(p_cross)}])
res.to_csv('result_summary.csv', index=False)
print("\nSaved: model_summary.csv, result_summary.csv")
print("\nFINAL ANSWER: Age p-value (Wald) = %.10f  (~%.6f)" % (p_age, p_age))
