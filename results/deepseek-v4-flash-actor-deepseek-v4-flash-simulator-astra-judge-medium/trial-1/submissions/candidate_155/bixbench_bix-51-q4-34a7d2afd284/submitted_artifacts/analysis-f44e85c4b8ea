"""
BixBench bix-51-q4 — Logistic regression of remission on age, BMI, gender.

Question: What is the change in log-odds of remission for each year increase in
patient age, using a logistic regression model that includes age, BMI, and gender
as predictors?

Analysis:
  - Outcome: remission = 1 if Efficacy == 'PR' (data contain no CR); 0 = PD/SD
  - Predictors: Age (years, continuous), BMI (kg/m^2, continuous), Gender
    (Male=1, Female=0 reference)
  - Sample: complete cases only (Efficacy/Age/Gender/BMI all non-missing, n=80);
    the other 41 rows are effectively empty (all key cells missing) and excluded.
  - Model: statsmodels Logit  remission ~ Age + BMI + Gender_male
  - Reported: Age coefficient (log-odds change per 1-year increase), SE, p,
    95% Wald CI, and OR = exp(coef) with its 95% CI.
"""
import pandas as pd
import numpy as np
import statsmodels.formula.api as smf

# ---------- 1. Load and clean ----------
df = pd.read_excel("data/data.xlsx", sheet_name="Sheet1")
df["Age"] = pd.to_numeric(df["Age"], errors="coerce")   # blank ' ' -> NaN

# ---------- 2. Outcome encoding ----------
df["remission"] = (df["Efficacy"] == "PR").astype(int)  # PR=1, PD/SD=0, NaN stays NaN

# ---------- 3. Complete-case sample (n=80) ----------
cc = df[["remission", "Age", "BMI", "Gender"]].dropna().copy()
cc["Gender_male"] = (cc["Gender"] == "Male").astype(int)  # Male=1, Female=0 (ref)

n = len(cc)
events = int(cc["remission"].sum())
print("=" * 72)
print("DATA SUMMARY")
print(f"  Complete cases (n)        : {n}")
print(f"  Remission events (y=1)    : {events}  ({events/n:.1%})")
print(f"  Efficacy counts           : {df['Efficacy'].value_counts().to_dict()}")
print(f"  Gender counts             : Male={int((cc['Gender_male']==1).sum())}, "
      f"Female={int((cc['Gender_male']==0).sum())}")
print(f"  Age   mean/SD/min/max     : {cc['Age'].mean():.2f} / {cc['Age'].std():.2f} / "
      f"{cc['Age'].min():.0f} / {cc['Age'].max():.0f}")
print(f"  BMI   mean/SD/min/max     : {cc['BMI'].mean():.2f} / {cc['BMI'].std():.2f} / "
      f"{cc['BMI'].min():.1f} / {cc['BMI'].max():.1f}")

# ---------- 4. Fit logistic regression ----------
model = smf.logit("remission ~ Age + BMI + Gender_male", data=cc).fit(disp=0)
print("=" * 72)
print(f"MODEL CONVERGENCE: {model.mle_retvals['converged']} "
      f"(iterations={model.mle_retvals['iterations']}, "
      f"LL={model.llf:.4f}, LL-null={model.llnull:.4f})")

# ---------- 5. Extract Age coefficient and inference ----------
b_age = model.params["Age"]
se_age = model.bse["Age"]
p_age = model.pvalues["Age"]
ci_age = model.conf_int().loc["Age"]                 # 95% Wald CI
or_age = np.exp(b_age)
or_ci = np.exp(ci_age)

print("\n" + "=" * 72)
print("LOGISTIC REGRESSION COEFFICIENTS (dependent = remission)")
print(model.summary2().tables[1].round(4).to_string())
print("=" * 72)
print("PRIMARY ANSWER — AGE EFFECT (per 1-year increase in age)")
print(f"  Age coefficient (log-odds change per year): {b_age:.6f}")
print(f"  Standard error                           : {se_age:.6f}")
print(f"  z / p-value                              : {model.tvalues['Age']:.4f} / {p_age:.6f}")
print(f"  95% Wald CI for coefficient              : [{ci_age[0]:.6f}, {ci_age[1]:.6f}]")
print(f"  Odds ratio (OR) = exp(coef)              : {or_age:.6f}")
print(f"  95% CI for OR                            : [{or_ci[0]:.6f}, {or_ci[1]:.6f}]")
print("=" * 72)
print("Interpretation: per additional year of age, the log-odds of remission change by "
      f"{b_age:+.4f} (OR {or_age:.4f} per year), holding BMI and gender constant.")
