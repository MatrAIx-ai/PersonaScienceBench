"""BixBench bix-51-q5: BMI association with treatment response (logistic regression).
Inspection helper + analysis script. Primary spec: univariate binary logistic
regression, outcome = treatment response (PR vs SD+PD), BMI continuous (Wald p)."""
import pandas as pd, numpy as np
import statsmodels.api as sm
from scipy import stats
import warnings
warnings.filterwarnings('ignore')

# ---- Load and clean ----
df = pd.read_excel('data/data.xlsx', sheet_name='Sheet1')
df = df[df['Sequence number'].notna()].copy()          # drop padding rows (41)
df['Age'] = df['Age'].astype(float)

# ---- Outcome coding ----
df['resp'] = (df['Efficacy'] == 'PR').astype(int)      # response = PR; non-resp = SD+PD
print('n=', len(df), 'resp=', int(df['resp'].sum()), 'nonresp=', int((1-df['resp']).sum()))
print('Groups==resp?', (df['resp'] == (df['Groups'] == 1)).all())

# ---- Primary: univariate logistic, BMI continuous ----
X = sm.add_constant(df['BMI'])
m = sm.Logit(df['resp'], X).fit(disp=False)
b, se = m.params['BMI'], m.bse['BMI']
z = b / se
p_wald = 2 * stats.norm.sf(abs(z))
ci = m.conf_int().loc['BMI']
print('Coefficient BMI = %.6f, SE = %.6f, z = %.6f, Wald p = %.10f' % (b, se, z, p_wald))
print('OR = %.4f, 95%% CI [%.4f, %.4f]' % (np.exp(b), np.exp(ci[0]), np.exp(ci[1])))
print('Rounded p = %.4f' % p_wald)

# LR test
llf = m.llf
ll0 = sm.Logit(df['resp'], np.ones(len(df))).fit(disp=False).llf
print('LR chi2 = %.4f, LR p = %.6f' % (2*(llf-ll0), stats.chi2.sf(2*(llf-ll0), 1)))

print('\nBMI by response:'); print(df.groupby('resp')['BMI'].agg(['count','mean','std']).to_string())
