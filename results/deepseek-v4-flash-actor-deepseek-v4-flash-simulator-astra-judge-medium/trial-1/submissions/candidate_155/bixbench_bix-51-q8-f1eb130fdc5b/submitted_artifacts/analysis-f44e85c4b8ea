"""
BixBench bix-51-q8
In a simple logistic regression model assessing age and camrelizumab treatment
response, what is the coefficient estimate (change in log-odds) for age?

Design (researcher-approved):
  - Sample: 80 complete records (Groups 1/2, non-missing Efficacy and Age);
    41 fully-blank rows removed (complete-case).
  - Response: camrelizumab treatment response, Efficacy coded PR=1 (responded),
    SD/PD=0 (not responded).  (Equivalent to Group==1.)
  - Predictor: Age, continuous integer years (40-75), untransformed.
  - Model:  logit(P(respond=1)) = b0 + b1*Age   (no other covariates)
  - Software: statsmodels (primary); independent scipy Newton-Raphson MLE
    (equivalent to R glm/IRLS) as cross-check. R glm unavailable here.
"""
import numpy as np
import pandas as pd
import statsmodels.api as sm
from scipy.optimize import minimize
from scipy.stats import norm

# ---------- data preparation ----------
df = pd.read_excel('data/data.xlsx', sheet_name='Sheet1')

def clean_age(v):
    if isinstance(v, str):
        v = v.strip()
        if v == '':
            return np.nan
        try:
            return float(v)
        except Exception:
            return np.nan
    return float(v)

df['Age_clean'] = df['Age'].apply(clean_age)
cc = df.dropna(subset=['Groups', 'Efficacy', 'Age_clean']).copy()
assert len(cc) == 80, len(cc)

cc['respond'] = (cc['Efficacy'] == 'PR').astype(int)
# sanity: respond == Group==1 must hold
assert (cc['respond'] == (cc['Groups'] == 1.0).astype(int)).all()

X = cc['Age_clean'].to_numpy(float)
y = cc['respond'].to_numpy(int)
print(f"Sample: n={len(cc)}; responders(PR)=1: {y.sum()}; non-responders(SD/PD)=0: {(1-y).sum()}")
print(f"Age range: {X.min():.0f}-{X.max():.0f} years  (continuous, untransformed)\n")

# ---------- primary fit: statsmodels ----------
Xc = sm.add_constant(X)
sm_model = sm.Logit(y, Xc).fit(disp=False)
b0, b1 = sm_model.params
se0, se1 = sm_model.bse
p1 = sm_model.pvalues[1]
ci1 = np.asarray(sm_model.conf_int())[1]
print("=" * 72)
print("PRIMARY FIT  -  statsmodels Logit(respond ~ Age)")
print("=" * 72)
print(sm_model.summary2().tables[1].to_string())
print(f"\nAge coefficient beta1  = {b1:.6f}   (change in log-odds per +1 year)")
print(f"SE(beta1)              = {se1:.6f}")
print(f"z = {b1/se1:.4f} ;  P(|z|) = {p1:.6f}")
print(f"95% CI for beta1       = [{ci1[0]:.6f}, {ci1[1]:.6f}]")
print(f"Odds ratio per +1 year = {np.exp(b1):.4f}")
print(f"Odds ratio per +5 years= {np.exp(b1*5):.4f}")
print(f"Intercept beta0        = {b0:.6f}")
print(f"Log-likelihood         = {sm_model.llf:.4f}")

# ---------- cross-check: independent Newton-Raphson MLE (== glm/IRLS) ----------
def neg_ll(beta, X, y):
    eta = beta[0] + beta[1] * X
    p = 1.0 / (1.0 + np.exp(-eta))
    p = np.clip(p, 1e-15, 1 - 1e-15)
    return -np.sum(y * np.log(p) + (1 - y) * np.log(1 - p))

def neg_ll_grad_hess(beta, X, y):
    eta = beta[0] + beta[1] * X
    p = 1.0 / (1.0 + np.exp(-np.clip(eta, -700, 700)))
    w = p * (1 - p)
    grad = np.array([np.sum(p - y), np.sum((p - y) * X)])
    H = np.array([[np.sum(w), np.sum(w * X)],
                  [np.sum(w * X), np.sum(w * X * X)]])
    return grad, H

beta_est = np.array([0.0, 0.0])
for _ in range(200):
    g, H = neg_ll_grad_hess(beta_est, X, y)
    step = np.linalg.solve(H, -g)
    beta_est = beta_est + step
    if np.max(np.abs(step)) < 1e-12:
        break
b0_nr, b1_nr = beta_est
_, H = neg_ll_grad_hess(beta_est, X, y)
cov_nr = np.linalg.inv(H)
se1_nr = np.sqrt(cov_nr[1, 1])
ll_nr = -neg_ll(beta_est, X, y)
print("=" * 72)
print("CROSS-CHECK - independent scipy Newton-Raphson MLE (== R glm/IRLS)")
print("=" * 72)
print(f"Age coefficient beta1  = {b1_nr:.10f}")
print(f"Intercept beta0        = {b0_nr:.10f}")
print(f"SE(beta1)              = {se1_nr:.10f}")
print(f"Log-likelihood         = {ll_nr:.10f}")
print(f"Max abs diff beta1     = {abs(b1 - b1_nr):.2e}")
print(f"Max abs diff beta0     = {abs(b0 - b0_nr):.2e}")
print(f"Max abs diff SE(beta1) = {abs(se1 - se1_nr):.2e}")

# ---------- interpretation ----------
print("=" * 72)
print("INTERPRETATION")
print("=" * 72)
print("beta1 < 0  ->  older age is associated with LOWER odds of a camrelizumab")
print("response (PR).  For each additional year of age, the log-odds of response")
print(f"decrease by {abs(b1):.4f}, i.e. odds are multiplied by {np.exp(b1):.4f} per year.")
