"""
BixBench bix-52-q7 — How many sites are removed when filtering sites that do
not show >90% or <10% methylation in Zebra Finch?

Main (approved) interpretation:
  - 'site' = unique Pos in ZF_AgeRelated_CpG_noMT_Final.csv
             (verified Pos == Chromosome + '_' + StartPosition for all rows)
  - A site 'shows >90% or <10% methylation' if MethylationPercentage > 90% in
    at least one sample OR < 10% in at least one sample.
  - Sites removed = sites that never show such extreme methylation
    (all sample observations lie within the 10-90% inclusive band).
  - Answer = total_unique_sites - number_of_sites_showing_extreme(strict)
"""
import pandas as pd

ZF = 'data/ZF_AgeRelated_CpG_noMT_Final.csv'
zf = pd.read_csv(ZF)

print('='*70)
print('Input checks (Zebra Finch)')
print('='*70)
print('rows:', len(zf))
print('unique Pos:', zf['Pos'].nunique())
print('unique samples:', zf['Sample'].nunique())
print('missing MethylationPercentage:', zf['MethylationPercentage'].isna().sum())
chk = (zf['Chromosome'].astype(str) + '_' + zf['StartPosition'].astype(str)) == zf['Pos'].astype(str)
print('Pos == Chromosome_StartPosition for all rows:', bool(chk.all()))
print('MT rows:', int((zf['Chromosome'] == 'MT').sum()))

total = zf['Pos'].nunique()
print('\nTotal unique sites (Pos):', total)

# ---- MAIN interpretation (strict: >90 or <10) -------------------------------
pos_gt90 = set(zf.loc[zf['MethylationPercentage'] > 90, 'Pos'])
pos_lt10 = set(zf.loc[zf['MethylationPercentage'] < 10, 'Pos'])
pos_extreme_strict = pos_gt90 | pos_lt10
n_kept_strict = len(pos_extreme_strict)
n_removed_strict = total - n_kept_strict

print('\n----- MAIN (strict >90 or <10, at least one sample) -----')
print('sites with any sample >90  :', len(pos_gt90))
print('sites with any sample <10  :', len(pos_lt10))
print('sites with any sample >90 OR <10 (kept):', n_kept_strict)
print('*** SITES REMOVED (main) =', n_removed_strict, '***')
print('(i.e., sites whose every sample observation is within 10-90%)')

# ---- Sensitivity 1: inclusive (>=90 or <=10) --------------------------------
pos_ge90 = set(zf.loc[zf['MethylationPercentage'] >= 90, 'Pos'])
pos_le10 = set(zf.loc[zf['MethylationPercentage'] <= 10, 'Pos'])
pos_extreme_ns = pos_ge90 | pos_le10
n_removed_ns = total - len(pos_extreme_ns)
print('\n----- Sensitivity: inclusive (>=90 or <=10) -----')
print('sites kept:', len(pos_extreme_ns), ' sites removed:', n_removed_ns)

# ---- Sensitivity 2: per-site mean aggregation -------------------------------
site_mean = zf.groupby('Pos')['MethylationPercentage'].mean()
print('\n----- Sensitivity: per-site mean aggregation -----')
print('site-mean min/max:', round(site_mean.min(), 2), '/', round(site_mean.max(), 2))
print('sites with mean <10:', int((site_mean < 10).sum()),
      ' sites with mean >90:', int((site_mean > 90).sum()))
print('=> sites removed under mean-in-band [10,90] rule:', int(((site_mean >= 10) & (site_mean <= 90)).sum()))

# ---- Sensitivity 3: row-level (site-sample) count ---------------------------
n_rows_removed_strict = int(((zf['MethylationPercentage'] <= 90) &
                            (zf['MethylationPercentage'] >= 10)).sum())
n_rows_removed_ns = int(((zf['MethylationPercentage'] < 90) &
                        (zf['MethylationPercentage'] > 10)).sum())
print('\n----- Sensitivity: row-level (site-sample) counts -----')
print('rows in 10-90 inclusive (removed, strict):', n_rows_removed_strict)
print('rows in (10,90) (removed, inclusive-extreme):', n_rows_removed_ns)

print('\nBoundary rows: exactly 90:', int((zf['MethylationPercentage'] == 90).sum()),
      ' exactly 10:', int((zf['MethylationPercentage'] == 10).sum()))
print('\nFINAL ANSWER (main):', n_removed_strict, 'sites removed of', total)
