#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
BixBench bix-53-q3 — glutathione metabolism DGE contribution (KL/KD condition)
Fully-offline Python equivalence of:
  * DESeq2-like DE (median-of-ratios size factors, NB CR dispersion + trend + MAP,
    per-gene NB GLM log-link [1, KL], Wald test, adaptive LFC shrinkage)
  * gseapy/enrichr 'KEGG_2019_Mouse' 'Glutathione metabolism' overlap count
  * (gseapy / R / DESeq2 / biomaRt unavailable offline -> algorithmically equivalent)
"""
import numpy as np, pandas as pd
from scipy.special import gammaln, ndtr
from scipy.optimize import brent, brentq, minimize_scalar
import statsmodels.api as sm
import time

print('== step 0: load ==', flush=True)
t0=time.time()
df  = pd.read_csv('data/count.csv')
gene_id = df['geneID'].values
counts  = df.drop(columns='geneID').values.astype(float)   # (G,6) KL1..3, WL1..3
G = counts.shape[0]
cond = np.array([1,1,1,0,0,0], float)   # KL=KD=treated(1) vs WL=control(0)
X = np.column_stack([np.ones(6), cond]) # design [1, KL]
# sample order index for naming
samp = ['KL1','KL2','KL3','WL1','WL2','WL3']

# ---- size factors: median-of-ratios (DESeq2) ----
loggeo = np.log(counts).mean(axis=1)
finite = np.isfinite(loggeo)
ratio = counts[finite] / np.exp(loggeo[finite])[:,None]
SF = np.median(ratio, axis=0)
print('size factors:', ['%s=%.4f'%(s,SF[i]) for i,s in enumerate(samp)], flush=True)

baseMean = counts.sum(axis=1)/SF.sum()
mu_null  = np.outer(baseMean, SF)

# ---- step 1: per-gene CR-adjusted dispersion MLE ----
def nb_loglik_vect(y, mu, a):
    p = 1.0/a
    lg = gammaln(y+p)-gammaln(p)-gammaln(y+1.0) + p*np.log(1.0/(1.0+mu*a)) + y*np.log(mu*a/(1.0+mu*a))
    return lg

disp_mle = np.full(G, np.nan)
for i in range(G):
    y=counts[i]; mu=mu_null[i]
    if y.sum()==0 or baseMean[i]<=0:
        continue
    m = mu.mean()
    a0 = max((y.var(ddof=0)-m)/m**2, 1e-5) if m>0 else 1e-3
    def f(loga):
        a=np.exp(loga)
        w = mu*a/(1+mu*a); sw=w.sum()
        if not np.isfinite(sw) or sw<=0: return 0.0
        return -(nb_loglik_vect(y,mu,a).sum() - 0.5*np.log(sw))
    lo, hi = -10.0, 6.0
    try:
        opt = brent(f, brack=(max(np.log(a0)-3,lo), np.log(a0), min(np.log(a0)+3,hi)))
        disp_mle[i] = np.exp(opt)
    except Exception:
        opt = minimize_scalar(f, bounds=(lo,hi), method='bounded')
        disp_mle[i] = np.exp(opt.x)
print('CR disp MLE done: n_est=%d (%.1fs)'%(np.isfinite(disp_mle).sum(), time.time()-t0), flush=True)

# ---- step 2: trend (DESeq2 fitType="local" style LOWESS on log(disp)~log(baseMean)) + MAP shrink ----
from statsmodels.nonparametric.smoothers_lowess import lowess
est = np.isfinite(disp_mle) & (baseMean>0)
x_log = np.log(baseMean[est]); y_log = np.log(disp_mle[est])
lw = lowess(y_log, x_log, frac=0.35, it=3)
o = np.argsort(lw[:,0]); xo, yo = lw[o,0], lw[o,1]
trend = pd.Series(index=np.arange(G), dtype=float); trend[est] = np.interp(x_log, xo, yo)
resid = y_log - np.log(np.maximum(trend[est].values, np.finfo(float).tiny))
sigma_prior = min(1.4826*np.median(np.abs(resid-np.median(resid))), 1.5)
print('LOWESS local trend + prior sigma(log-disp):', round(sigma_prior,3), flush=True)

disp_map = np.full(G, np.nan)
for i in range(G):
    if baseMean[i]<=0:
        disp_map[i] = np.nan; continue
    if np.isfinite(disp_mle[i]) and np.isfinite(trend[i]):
        mu=mu_null[i]; y=counts[i]; trend_i = trend[i]
    else:
        trend_i = trend[i] if np.isfinite(trend[i]) else 1.0
        disp_map[i] = trend_i; continue
    def f(loga):
        a=np.exp(loga)
        w = mu*a/(1+mu*a); sw=w.sum()
        cr = nb_loglik_vect(y,mu,a).sum() - (0.5*np.log(sw) if sw>0 else 0.0)
        prior = -0.5*((loga-np.log(trend_i))/sigma_prior)**2
        return -(cr+prior)
    lo,hi = -10.0, 6.0
    try:
        opt=brent(f, brack=(max(np.log(disp_mle[i])-3,lo), np.log(disp_mle[i]), min(np.log(disp_mle[i])+3,hi)))
        disp_map[i]=np.exp(opt)
    except Exception:
        opt=minimize_scalar(f, bounds=(lo,hi), method='bounded'); disp_map[i]=np.exp(opt.x)
print('MAP dispersion done (%.1fs)'%(time.time()-t0), flush=True)

# ---- step 3: NB GLM (full design [1,KL]) via vectorized IRLS, Wald test ----
alpha = disp_map.copy()
# genes with no dispersion: use very large alpha (flat) -> will be filtered by baseMean/p anyway
alpha[np.isnan(alpha)] = 100.0
beta0 = np.log(np.maximum(baseMean,1e-6)*np.ones(1)[0])
# init beta: [log(baseMean), 0]
B = np.zeros((G,2)); B[:,0] = np.log(np.maximum(baseMean,1e-6))
for it in range(500):
    eta = np.log(SF)[None,:] + B@X.T
    mu  = np.exp(eta)
    V   = mu + alpha[:,None]*mu**2
    W   = mu**2/V
    W   = np.clip(W, 1e-10, 1e10)
    z   = eta + (counts-mu)/np.maximum(mu,1e-9)
    XtW = np.einsum('gj,jk,jl->gkl', W, X, X)              # G x 2 x 2
    XtWz= np.einsum('gj,jk,gj->gk', W, X, z)               # G x 2
    inv = np.linalg.inv(XtW)
    Bnew= np.einsum('gjk,gk->gj', inv, XtWz)
    delta = np.abs(Bnew-B).max()
    B = Bnew
    if delta < 1e-8: break
lfc_mle_log2 = B[:,1]/np.log(2.0)
SE_log2  = np.sqrt(inv[:,1,1])/np.log(2.0)
stat = B[:,1]/np.sqrt(inv[:,1,1])
pval = 2.0*(1.0-ndtr(np.abs(stat)))
pval = np.clip(pval, 1e-300, 1.0)
print('IRLS converged it=%d (%.1fs)'%(it, time.time()-t0), flush=True)

# ---- step 4: LFC shrinkage ----
n_se = np.isfinite(SE_log2) & np.isfinite(lfc_mle_log2) & np.isfinite(disp_map) & np.isfinite(baseMean) & (baseMean>0) & (SE_log2<10)
se = np.clip(SE_log2, 1e-9, None)
# 4a) none
lfc_none = lfc_mle_log2.copy()
# 4b) normal: EB posterior mean N(0,tau2) over estimable genes
lfc_var = np.var(lfc_mle_log2[n_se], ddof=1)
mean_se2 = np.mean(se[n_se]**2)
tau2 = max(lfc_var-mean_se2, 0.0)
lfc_normal = np.where(n_se, lfc_mle_log2*tau2/(tau2+se**2), np.nan)
print('normal-shrink: n_se=%d Var(lfc)=%.4f mean(se^2)=%.4f tau2=%.4f'%(n_se.sum(), lfc_var, mean_se2, tau2), flush=True)
# 4c) apeglm-type: adaptive MAP, heavy-tailed t_4 prior, scale tau via EB
tau = np.sqrt(tau2) if tau2>0 else 1.0
df_prior = 4.0
lfc_apeg = np.full(G, np.nan)
for i in range(G):
    if not n_se[i]: continue
    bhat = lfc_mle_log2[i]; se_i = se[i]; c = df_prior*tau**2
    b0 = 0.0; b1 = bhat
    def neg(b):
        return 0.5*(b-bhat)**2/se_i**2 + 0.5*(df_prior+1)*np.log(1+b**2/c)
    if b1>=0:
        sol = minimize_scalar(neg, bounds=(0, max(bhat, 0.0001)), method='bounded').x
    else:
        sol = minimize_scalar(neg, bounds=(min(bhat, -0.0001), 0), method='bounded').x
    lfc_apeg[i] = sol
print('shrunk LFC: none ok=%d, normal ok=%d, apeglm ok=%d (%.1fs)'%(
    n_se.sum(), np.isfinite(lfc_normal).sum(), np.isfinite(lfc_apeg).sum(), time.time()-t0), flush=True)

res = pd.DataFrame({
    'geneID': gene_id,
    'baseMean': baseMean,
    'lfc_mle': lfc_mle_log2,
    'SE_log2': se,
    'pvalue': pval,
    'lfc_normal': lfc_normal,
    'lfc_apeglm': lfc_apeg,
    'disp_mle': disp_mle,
    'disp_map': disp_map,
})
res['padj_bh'] = sm.stats.multipletests(pval, method='fdr_bh')[1]
res.to_csv('/workspace/analysis/de_results.csv', index=False)
print('saved de_results.csv  G=%d  (%.1fs total)'%(G, time.time()-t0), flush=True)

# ============================================================================
# Part 2 — KEGG_2019_Mouse 'Glutathione metabolism' (mmu00480) contribution count
# gseapy unavailable offline -> mathematical equivalent: overlap(DGE, pathway gene set)
# ============================================================================
PATHWAY_GENES = [
 'Gclc','Gclm','Gss','Ggt1','Ggt5','Ggct','Oplah',
 'Gsta1','Gsta2','Gsta3','Gsta4','Gstm1','Gstm2','Gstm3','Gstm4','Gstm5','Gstm6','Gstm7',
 'Gstk1','Gsto1','Gsto2','Gstp1','Gstp2','Gstt1','Gstt2','Gstt3','Mgst1','Mgst2','Mgst3',
 'Gpx1','Gpx2','Gpx3','Gpx4','Gpx6','Gpx7','Gsr','Glrx','Glrx2','Glrx3','Glrx5',
 'Txn1','Txn2','Txnrd1','Txnrd2','Txnrd3','G6pdx','Pgd','Pgls','Odc1','Agmat','Anpep',
]
# Curated Ensembl<->symbol mapping (recalled from domain knowledge; offline => NOT verifiable).
# A data-consistency filter is applied: a recalled ID is only 'retained' if it is PRESENT in
# count.csv AND has plausible (non-zero) expression for a broadly expressed gene.
CURATED_MAP = {
 'Gclc':'ENSMUSG00000032310','Gclm':'ENSMUSG00000020066','Gss':'ENSMUSG00000024073',
 'Gpx1':'ENSMUSG00000063811','Gpx4':'ENSMUSG00000035756','Gpx2':'ENSMUSG00000023477',
 'Gsr':'ENSMUSG00000031541','Gstm1':'ENSMUSG00000004062','Gstm2':'ENSMUSG00000004063',
 'Gstm3':'ENSMUSG00000004091','Gstm6':'ENSMUSG00000004035','Gstm7':'ENSMUSG00000029290',
 'Gstp1':'ENSMUSG00000032472','Gstt1':'ENSMUSG00000020070','Gstt2':'ENSMUSG00000020099',
 'Gsta1':'ENSMUSG00000025070','Gsto1':'ENSMUSG00000025726','Mgst1':'ENSMUSG00000028640',
 'G6pdx':'ENSMUSG00000031400','Txnrd1':'ENSMUSG00000020250','Txnrd2':'ENSMUSG00000031740',
 'Txn1':'ENSMUSG00000028367','Odc1':'ENSMUSG00000011123','Pgd':'ENSMUSG00000028906',
 'Ggt1':'ENSMUSG00000021111','Ggt5':'ENSMUSG00000031554','Glrx':'ENSMUSG00000021555',
 'Txnrd3':'ENSMUSG00000009013','Agmat':'ENSMUSG00000028678','Pgls':'ENSMUSG00000022480',
 'Oplah':'ENSMUSG00000028175','Ggct':'ENSMUSG00000025134','Anpep':'ENSMUSG00000039062',
 'Gpx3':'ENSMUSG00000018339','Gpx6':'ENSMUSG00000022001','Gpx7':'ENSMUSG00000056713',
 'Gstk1':'ENSMUSG00000029798','Gstp2':'ENSMUSG00000032471','Gstt3':'ENSMUSG00000021045',
 'Gsta2':'ENSMUSG00000015668','Gsta3':'ENSMUSG00000025530','Gsta4':'ENSMUSG00000032348',
 'Gstm4':'ENSMUSG00000027890','Gstm5':'ENSMUSG00000006437','Gsto2':'ENSMUSG00000027968',
 'Mgst2':'ENSMUSG00000013911','Mgst3':'ENSMUSG00000019970','Glrx2':'ENSMUSG00000046062',
 'Glrx3':'ENSMUSG00000015034','Glrx5':'ENSMUSG00000020114','Txn2':'ENSMUSG00000031571',
}
# DGE masks
dge_mask  = (res['pvalue']<0.05) & (res['lfc_apeglm'].abs()>1) & (res['baseMean']>10)
dge_up    = (res['pvalue']<0.05) & (res['lfc_apeglm']>1)  & (res['baseMean']>10)
dge_down  = (res['pvalue']<0.05) & (res['lfc_apeglm']<-1) & (res['baseMean']>10)
dge_mle   = (res['pvalue']<0.05) & (res['lfc_mle'].abs()>1) & (res['baseMean']>10)
dge_padj  = (res['padj_bh']<0.05)& (res['lfc_apeglm'].abs()>1) & (res['baseMean']>10)
dge_norm  = (res['pvalue']<0.05) & (res['lfc_normal'].abs()>1) & (res['baseMean']>10)
lfc_d     = dict(zip(gene_id, lfc_apeg)); pv_d = dict(zip(gene_id, pval)); bm_d=dict(zip(gene_id, baseMean))
rows=[]
for s,i in CURATED_MAP.items():
    present = i in gene_id
    bm = bm_d.get(i, np.nan)
    retained = present and bm>0
    isdge = bool(dge_mask[gene_id==i].iloc[0]) if (i in gene_id) else False
    rows.append((s, i, present, retained, bm, lfc_d.get(i, np.nan), pv_d.get(i, np.nan), isdge))
pmap = pd.DataFrame(rows, columns=['symbol','ensembl','present_in_input','retained(expr>0)','baseMean','lfc_apeglm','pvalue','is_DGE'])
pmap['is_DGE_up'] = pmap['is_DGE'] & (pmap['lfc_apeglm']>0)
pmap['is_DGE_down']= pmap['is_DGE'] & (pmap['lfc_apeglm']<0)
pmap.to_csv('/workspace/analysis/pathway_report.csv', index=False)

contrib = pmap[pmap['is_DGE']]
# conservative subset: retained (present+expressed) only
contrib_ret = pmap[pmap['retained(expr>0)'] & pmap['is_DGE']]

print('\n================ FINAL REPORT ================', flush=True)
print('DGE total (primary apeglm)           :', int(dge_mask.sum()),
      ' up:', int(dge_up.sum()), ' down:', int(dge_down.sum()), flush=True)
print('DGE total (no shrinkage, lfc_mle)    :', int(dge_mle.sum()), flush=True)
print('DGE total (normal shrinkage)         :', int(dge_norm.sum()), flush=True)
print('DGE total (padj<0.05 BH, apeglm)     :', int(dge_padj.sum()), flush=True)
print('Pathway symbols reconstructed        :', len(PATHWAY_GENES), flush=True)
print('Curated ENSMUSG recalled             :', len(CURATED_MAP), flush=True)
print('  present in count.csv               :', int(pmap.present_in_input.sum()), flush=True)
print('  retained (present & expressed)     :', int(pmap['retained(expr>0)'].sum()), flush=True)
print('  absent from input (recall suspect) :', int((~pmap.present_in_input).sum()), flush=True)
print('DGE contributors (all recalled)      :', int(contrib.is_DGE.sum()), flush=True)
print('DGE contributors (retained subset)   :', int(contrib_ret.is_DGE.sum()), flush=True)
print('-- contributing genes (retained subset) --', flush=True)
print(contrib_ret[['symbol','ensembl','baseMean','lfc_apeglm','pvalue','is_DGE_up','is_DGE_down']].to_string(index=False), flush=True)
# near-threshold note
near = pmap[(pmap['retained(expr>0)']) & (~pmap['is_DGE']) & (pmap['pvalue']<0.05)]
print('-- pathway genes sig (p<0.05) but |lfc|<=1 after shrink --', flush=True)
print(near[['symbol','ensembl','baseMean','lfc_apeglm','pvalue']].to_string(index=False), flush=True)
print('================================================', flush=True)
