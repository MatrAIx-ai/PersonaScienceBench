"""BixBench bix-53-q6 full workflow (offline, Plan A).
1) DESeq2-like DE + apeglm-like shrinkage (native numpy/scipy)
2) DEG filtering: p<0.05, |shrunk log2FC|>1, baseMean>10
3) GSEA prerank (native) on KEGG_2019_Mouse RECONSTRUCTED library (APPROXIMATE)
4) Diagnostics: Ensembl->symbol mapping success, genes per gene set.
"""
import numpy as np, pandas as pd, json, time, sys
from scipy import stats
from deseq_like import run_deseq_like
from gsea_native import prerank
import recon_data

np.set_printoptions(suppress=True)
t0 = time.time()

# ---------------- load data ----------------
df = pd.read_csv('data/count.csv')
K = df.iloc[:,1:].values.astype(float)
gene_ids = df['geneID'].values
groups = ['KD','KD','KD','CTL','CTL','CTL']

# ---------------- DE + shrinkage ----------------
print("[1/4] DESeq2-like DE + shrinkage ...", flush=True)
with np.errstate(divide='ignore', invalid='ignore'):
    res, s, norm = run_deseq_like(pd.DataFrame(K, index=gene_ids), groups)
res = res.reset_index(drop=True)
res['geneID'] = gene_ids
res['padj'] = stats.false_discovery_control(res['pvalue'].values, method='bh')

# DEG filtering (per public contract)
deg = res[(res['pvalue'] < 0.05) & (res['l2fc_shrunk'].abs() > 1) & (res['baseMean'] > 10)].copy()
print("   -> total genes:", len(res), "| DEGs:", len(deg),
      "| up(KD):", int((deg['l2fc_shrunk']>0).sum()), "| down:", int((deg['l2fc_shrunk']<0).sum()), flush=True)

# ---------------- symbol/Ensembl mapping diagnostics ----------------
print("[2/4] Ensembl->symbol mapping diagnostics (reconstructed library) ...", flush=True)
ens2sym = {v: k for k, v in recon_data.ENS_MAP.items()}
present = {}
mapped_any = 0
for eid in gene_ids:
    if eid in ens2sym:
        present[eid] = ens2sym[eid]; mapped_any += 1
print("   mapped genes present in data:", mapped_any, "/", len(gene_ids),
      f"({100.0*mapped_any/len(gene_ids):.2f}% of genome)", flush=True)

# build gene sets as Ensembl lists present in data
gene_sets = []          # (name, set of original-gene indices)
set_coverage = []
for name, syms in recon_data.PATHWAYS.items():
    eids = set()
    for sym in syms:
        e = recon_data.ENS_MAP.get(sym.upper())
        if e and e in present:
            eids.add(e)
    idx = set(np.where(np.isin(gene_ids, list(eids)))[0])
    gene_sets.append((name, idx))
    set_coverage.append((name, len(syms), len(eids), len(idx)))
cov = pd.DataFrame(set_coverage, columns=['pathway','n_symbols','n_mapped','n_present_in_data'])
print(cov.to_string(index=False))
print("   pathways with >=5 genes present:", int((cov['n_present_in_data']>=5).sum()), flush=True)

# ---------------- GSEA prerank ----------------
print("[3/4] GSEA prerank (native, nperm=500) ...", flush=True)
rnk = res['l2fc_shrunk'].values
gs_idx = [(n, idx) for (n, idx) in gene_sets if len(idx) >= 3]
t1 = time.time()
gsea_res = prerank(rnk, gs_idx, nperm=1000, seed=123)
print(f"   GSEA done in {time.time()-t1:.1f}s", flush=True)
gr = pd.DataFrame(gsea_res)
gr['qval'] = stats.false_discovery_control(gr['pval'].values, method='bh')
gr = gr.sort_values(['qval','NES'], ascending=[True,False]).reset_index(drop=True)
print(gr.to_string(index=False, float_format=lambda x: f"{x:.4g}"))

# ---------------- ORA cross-check on DEGs ----------------
print("[4/4] ORA (hypergeometric) cross-check on DEG list ...", flush=True)
deg_ids = set(deg['geneID'])
N_all = len(gene_ids)
ora_rows = []
for name, syms in recon_data.PATHWAYS.items():
    eids = set()
    for sym in syms:
        e = recon_data.ENS_MAP.get(sym.upper())
        if e:
            eids.add(e)
    set_ids = eids & set(gene_ids)
    if len(set_ids) < 3: 
        ora_rows.append(dict(pathway=name, set_size=len(set_ids), deg_in_set=0, pval=1.0, qval=1.0, direction='na')); continue
    k = len(set_ids & deg_ids); m = len(set_ids); n_deg = len(deg_ids)
    p = stats.hypergeom.sf(k-1, N_all, n_deg, m)
    direction = 'up' if (k>0 and np.median(res.set_index('geneID').loc[list(set_ids & deg_ids),'l2fc_shrunk']>0)) else 'down'
    ora_rows.append(dict(pathway=name, set_size=len(set_ids), deg_in_set=int(k), pval=p, qval=stats.false_discovery_control([p])[0] if p==p else 1.0, direction=direction))
ora = pd.DataFrame(ora_rows).sort_values('pval')
print(ora.to_string(index=False, float_format=lambda x: f"{x:.4g}"))

# ---------------- save outputs ----------------
out = {
  'size_factors': list(np.round(s,4)),
  'n_genes_total': int(len(res)),
  'n_DEG': int(len(deg)),
  'n_DEG_up': int((deg.l2fc_shrunk>0).sum()),
  'n_DEG_down': int((deg.l2fc_shrunk<0).sum()),
  'mapped_genes_in_data': mapped_any,
  'genome_mapping_rate': float(mapped_any/len(gene_ids)),
  'gsea': gr.to_dict('records'),
  'ora': ora.to_dict('records'),
  'top_deg': deg.reindex(deg.l2fc_shrunk.abs().sort_values(ascending=False).index).head(20)[['geneID','baseMean','l2fc_raw','l2fc_shrunk','pvalue','padj']].to_dict('records'),
}
with open('outputs.json','w') as f:
    json.dump(out, f, indent=2, default=float)
deg.to_csv('deg_table.csv', index=False)
res.to_csv('de_results_all.csv', index=False)

if len(gr) and gr.iloc[0]['qval'] < 0.05:
    top = gr.iloc[0]
    answer = f"{top['pathway']}"
    print("\nMOST SIGNIFICANTLY ENRICHED PATHWAY (q<0.05):", answer, "| NES=", round(top['NES'],3), "q=", round(top['qval'],5))
else:
    print("\nNo pathway reached q<0.05; top by q:", gr.iloc[0]['pathway'] if len(gr) else None)
print(f"total runtime {time.time()-t0:.1f}s")
