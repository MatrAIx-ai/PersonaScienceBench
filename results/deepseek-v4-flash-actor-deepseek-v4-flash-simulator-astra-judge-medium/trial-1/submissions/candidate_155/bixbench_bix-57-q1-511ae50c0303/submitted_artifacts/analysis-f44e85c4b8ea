#!/usr/bin/env python3
"""
BixBench bix-57-q1 - Gap percentage across MAFFT(auto) alignments.
See docstring details in comments.
"""
import os, glob, json, shutil, subprocess, sys

AA = "ARNDCQEGHILKMFPSTWYV"
ROWS = {
'A': [4,-1,-2,-2,0,-1,-1,0,-2,-1,-1,-1,-1,-2,-1,1,0,-3,-2,0],
'R': [-1,5,0,-2,-3,1,0,-2,0,-3,-2,2,-1,-3,-2,-1,-1,-3,-2,-3],
'N': [-2,0,6,1,-3,0,0,0,1,-3,-3,0,-2,-3,-2,1,0,-4,-2,-3],
'D': [-2,-2,1,6,-3,0,2,-1,-1,-3,-4,-1,-3,-3,-1,0,-1,-4,-3,-3],
'C': [0,-3,-3,-3,9,-3,-4,-3,-3,-1,-1,-3,-1,-2,-3,-1,-1,-2,-2,-1],
'Q': [-1,1,0,0,-3,5,2,-2,0,-3,-2,1,0,-3,-1,0,-1,-2,-1,-2],
'E': [-1,0,0,2,-4,2,5,-2,0,-3,-3,1,-2,-3,-1,0,-1,-3,-2,-2],
'G': [0,-2,0,-1,-3,-2,-2,6,-2,-4,-4,-2,-3,-3,-2,0,-2,-2,-3,-3],
'H': [-2,0,1,-1,-3,0,0,-2,8,-3,-3,-1,-2,-1,-2,-1,-2,-2,2,-3],
'I': [-1,-3,-3,-3,-1,-3,-3,-4,-3,4,2,-3,1,0,-3,-2,-1,-3,-1,3],
'L': [-1,-2,-3,-4,-1,-2,-3,-4,-3,2,4,-2,2,0,-3,-2,-1,-2,-1,1],
'K': [-1,2,0,-1,-3,1,1,-2,-1,-3,-2,5,-1,-3,-1,0,-1,-3,-2,-2],
'M': [-1,-1,-2,-3,-1,0,-2,-3,-2,1,2,-1,5,0,-2,-1,-1,-1,-1,1],
'F': [-2,-3,-3,-3,-2,-3,-3,-3,-1,0,0,-3,0,6,-4,-2,-2,1,3,-1],
'P': [-1,-2,-2,-1,-3,-1,-1,-2,-2,-3,-3,-1,-2,-4,7,-1,-1,-4,-3,-2],
'S': [1,-1,1,0,-1,0,0,0,-1,-2,-2,0,-1,-2,-1,4,1,-3,-2,-2],
'T': [0,-1,0,-1,-1,-1,-1,-2,-2,-1,-1,-1,-1,-2,-1,1,5,-2,-2,0],
'W': [-3,-3,-4,-4,-2,-2,-3,-2,-2,-3,-2,-3,-1,1,-4,-3,-2,11,2,-3],
'Y': [-2,-2,-2,-3,-2,-1,-2,-3,2,-1,-1,-2,-1,3,-3,-2,-2,2,7,-1],
'V': [0,-3,-3,-3,-1,-2,-2,-3,-3,3,1,-2,1,-1,-2,-2,0,-3,-1,4],
}
BLOSUM62 = {}
for i, a in enumerate(AA):
    BLOSUM62[a] = {AA[j]: ROWS[a][j] for j in range(20)}
def bl(a, b):
    if a == '-' or b == '-':
        return 0.0
    return float(BLOSUM62[a][b])

GAP_OPEN, GAP_EXT = -1.53, -0.123

def parse_fasta(path):
    seqs, name = [], None
    for line in open(path):
        line = line.strip()
        if not line:
            continue
        if line.startswith(">"):
            name = line[1:].split()[0]
            seqs.append([name, ""])
        else:
            seqs[-1][1] += line.upper()
    return seqs

def align_pair(seqA, seqB):
    """Affine-gap Needleman-Wunsch over residues; returns (alA, alB)."""
    m, n = len(seqA), len(seqB)
    neg = float("-inf")
    M = [[neg]*(n+1) for _ in range(m+1)]
    X = [[neg]*(n+1) for _ in range(m+1)]
    Y = [[neg]*(n+1) for _ in range(m+1)]
    T = [[None]*(n+1) for _ in range(m+1)]
    M[0][0] = 0.0
    for i in range(1, m+1):
        X[i][0] = GAP_OPEN + (i-1)*GAP_EXT; T[i][0] = 'X'
    for j in range(1, n+1):
        Y[0][j] = GAP_OPEN + (j-1)*GAP_EXT; T[0][j] = 'Y'
    for i in range(1, m+1):
        for j in range(1, n+1):
            s = bl(seqA[i-1], seqB[j-1])
            M[i][j] = max(M[i-1][j-1], X[i-1][j-1], Y[i-1][j-1]) + s
            X[i][j] = max(M[i-1][j] + GAP_OPEN, X[i-1][j] + GAP_EXT)
            Y[i][j] = max(M[i][j-1] + GAP_OPEN, Y[i][j-1] + GAP_EXT)
            best = max(M[i][j], X[i][j], Y[i][j])
            T[i][j] = 'M' if best == M[i][j] else ('X' if best == X[i][j] else 'Y')
    i, j = m, n
    alA, alB = [], []
    while i > 0 or j > 0:
        st = T[i][j]
        if st == 'M':
            alA.append(seqA[i-1]); alB.append(seqB[j-1]); i -= 1; j -= 1
        elif st == 'X':
            alA.append(seqA[i-1]); alB.append('-'); i -= 1
        else:
            alA.append('-'); alB.append(seqB[j-1]); j -= 1
    return "".join(reversed(alA)), "".join(reversed(alB))

def pair_identity(seqA, seqB):
    aA, aB = align_pair(seqA, seqB)
    L = len(aA)
    if L == 0:
        return 1.0
    ident = sum(1 for x, y in zip(aA, aB) if x == y and x != '-')
    return ident / L

def build_guide_upgma(seqs):
    n = len(seqs)
    dist = [[0.0]*n for _ in range(n)]
    for i in range(n):
        for j in range(i+1, n):
            d = 1.0 - pair_identity(seqs[i][1], seqs[j][1])
            dist[i][j] = dist[j][i] = d
    clusters = [[i] for i in range(n)]
    dc = [[None]*n for _ in range(n)]
    for i in range(n):
        for j in range(n):
            if i != j:
                dc[i][j] = dist[i][j]
    merges = []
    while len(clusters) > 1:
        ni = len(clusters)
        bi, bj, bd = -1, -1, float("inf")
        for i in range(ni):
            for j in range(i+1, ni):
                d = dc[i][j]
                if d is not None and d < bd:
                    bd, bi, bj = d, i, j
        merges.append((bi, bj, bd))
        for k in range(ni):
            if k == bi or k == bj or dc[bi][k] is None:
                continue
            ni_, nj_ = len(clusters[bi]), len(clusters[bj])
            dc[bi][k] = dc[k][bi] = (dc[bi][k]*ni_ + dc[bj][k]*nj_) / (ni_ + nj_)
        clusters[bi] = clusters[bi] + clusters[bj]
        clusters.pop(bj)
        dc.pop(bj)
        for row in dc:
            row.pop(bj)
    return merges

def fallback_msa(seqs):
    """Progressive MSA: UPGMA merge order + profile-profile affine NW."""
    n = len(seqs)
    if n == 1:
        return [seqs[0][1]]
    merges = build_guide_upgma(seqs)
    profs = [ ([{i: c} for c in seqs[i][1]], {i}) for i in range(n) ]

    def col_score(dA, dB):
        ra = [c for c in dA.values() if c != '-']
        rb = [c for c in dB.values() if c != '-']
        if not ra or not rb:
            return 0.0
        tot, cnt = 0.0, 0
        for a in ra:
            for b in rb:
                tot += bl(a, b); cnt += 1
        return tot / cnt

    def align_prof(pA, pB):
        m, nb = len(pA), len(pB)
        neg = float("-inf")
        M = [[neg]*(nb+1) for _ in range(m+1)]
        X = [[neg]*(nb+1) for _ in range(m+1)]
        Y = [[neg]*(nb+1) for _ in range(m+1)]
        T = [[None]*(nb+1) for _ in range(m+1)]
        M[0][0] = 0.0
        for i in range(1, m+1):
            X[i][0] = GAP_OPEN + (i-1)*GAP_EXT; T[i][0] = 'X'
        for j in range(1, nb+1):
            Y[0][j] = GAP_OPEN + (j-1)*GAP_EXT; T[0][j] = 'Y'
        for i in range(1, m+1):
            for j in range(1, nb+1):
                s = col_score(pA[i-1], pB[j-1])
                M[i][j] = max(M[i-1][j-1], X[i-1][j-1], Y[i-1][j-1]) + s
                X[i][j] = max(M[i-1][j] + GAP_OPEN, X[i-1][j] + GAP_EXT)
                Y[i][j] = max(M[i][j-1] + GAP_OPEN, Y[i][j-1] + GAP_EXT)
                best = max(M[i][j], X[i][j], Y[i][j])
                T[i][j] = 'M' if best == M[i][j] else ('X' if best == X[i][j] else 'Y')
        i, j = m, nb
        resA, resB = [], []
        while i > 0 or j > 0:
            st = T[i][j]
            if st == 'M':
                resA.append(i-1); resB.append(j-1); i -= 1; j -= 1
            elif st == 'X':
                resA.append(i-1); resB.append(-1); i -= 1
            else:
                resA.append(-1); resB.append(j-1); j -= 1
        resA.reverse(); resB.reverse()
        out = []
        for ia, ib in zip(resA, resB):
            col = {}
            if ia >= 0: col.update(pA[ia])
            if ib >= 0: col.update(pB[ib])
            out.append(col)
        return out

    for srcA, srcB, _ in merges:
        if srcB >= len(profs):
            continue
        pA, idxA = profs[srcA]; pB, idxB = profs[srcB]
        merged = align_prof(pA, pB)
        profs[srcA] = (merged, idxA | idxB)
        profs.pop(srcB)
    prof = profs[0][0]
    rows = [["-"]*len(prof) for _ in range(n)]
    for c, col in enumerate(prof):
        for i, ch in col.items():
            rows[i][c] = ch
    return ["".join(r) for r in rows]

def parse_mafft_fasta(text):
    seqs = {}
    name = None
    for line in text.splitlines():
        line = line.strip()
        if not line:
            continue
        if line.startswith(">"):
            name = line[1:].split()[0]; seqs[name] = ""
        else:
            seqs[name] += line.upper()
    return list(seqs.keys()), list(seqs.values())

def main():
    files = sorted(glob.glob("data/*.faa"))
    print("==" * 45)
    print("Input files:", len(files))
    mafft_path = shutil.which("mafft")
    print("MAFFT available:", mafft_path if mafft_path else "NO (fallback MSA used)")
    tool = "mafft" if mafft_path else "fallback_progressive_MSA"
    os.makedirs("alignments", exist_ok=True)
    os.makedirs("artifacts", exist_ok=True)
    per_file = []
    grand_cells = grand_gaps = grand_cols = 0
    for f in files:
        seqs = parse_fasta(f)
        names = [s[0] for s in seqs]
        rc = [s[1] for s in seqs]
        n_seq = len(rc)
        if mafft_path:
            res = subprocess.run([mafft_path, "--auto", f], capture_output=True, text=True)
            if res.returncode != 0:
                raise RuntimeError("MAFFT failed on %s: %s" % (f, res.stderr))
            onames, aligned = parse_mafft_fasta(res.stdout)
        else:
            aligned = fallback_msa(seqs)
        aln_len = len(aligned[0])
        assert all(len(a) == aln_len for a in aligned), "ragged alignment in %s" % f
        gaps = sum(a.count('-') for a in aligned)
        cells = aln_len * n_seq
        base = os.path.basename(f).replace(".faa", "")
        with open("alignments/%s.aln.faa" % base, "w") as out:
            for nm, a in zip(names, aligned):
                out.write(">%s\n%s\n" % (nm, a))
        pct_cells = gaps / cells * 100.0
        pct_cols = gaps / aln_len * 100.0
        per_file.append(dict(file=os.path.basename(f), n_seq=n_seq, aln_len=aln_len,
                             cells=cells, gaps=gaps, gap_pct_cells=pct_cells,
                             gap_pct_cols=pct_cols))
        grand_cells += cells; grand_gaps += gaps; grand_cols += aln_len
        print("%-22s n=%d len=%4d cells=%6d gaps=%4d  gap%%(cells)=%6.3f gap%%(cols)=%6.3f"
              % (os.path.basename(f), n_seq, aln_len, cells, gaps, pct_cells, pct_cols))
    primary = grand_gaps / grand_cells * 100.0
    variant = grand_gaps / grand_cols * 100.0
    print("==" * 45)
    print("TOTAL cells (sum len*n) =", grand_cells)
    print("TOTAL columns (sum len)= %d" % grand_cols)
    print("TOTAL gap ('-') chars   = %d" % grand_gaps)
    print("PRIMARY %% (gaps/total_cells*100) = %.4f %%" % primary)
    print("VARIANT %% (gaps/total_columns*100) = %.4f %%" % variant)
    print("Tool used =", tool)
    summary = dict(tool=tool, mafft_available=bool(mafft_path),
        denominator="total aligned cells = sum(len_i * n_seq_i)",
        primary_percent=primary, variant_percent_columns=variant,
        total_cells=grand_cells, total_columns=grand_cols, total_gaps=grand_gaps,
        per_file=per_file)
    with open("artifacts/analysis_summary.json", "w") as fh:
        json.dump(summary, fh, indent=2)
    print("Summary written to artifacts/analysis_summary.json")

if __name__ == "__main__":
    main()
