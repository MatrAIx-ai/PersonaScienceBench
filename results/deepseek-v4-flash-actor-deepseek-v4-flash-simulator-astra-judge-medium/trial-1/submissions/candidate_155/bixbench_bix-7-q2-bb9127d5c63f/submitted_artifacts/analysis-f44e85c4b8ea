"""BixBench bix-7-q2 final analysis.
Average number of CHIP variants per sample after filtering out intronic,
intergenic, and UTR variants.

Conventions (approved):
- A sample's carried variants = rows with Zygosity in {Heterozygous, Homozygous Variant}.
- Filter out SO(Combined) in {intron_variant, 3_prime_UTR_variant,
  5_prime_UTR_variant, 5_prime_UTR_premature_start_codon_gain_variant}.
- upstream_gene_variant retained in the primary analysis (sensitivity shown).
- Counting: one row = one allele variant; no dedup (dedup by (Chr:Pos,Ref/Alt)
  reported as sensitivity).
- Mean denominator = all 86 samples (0-variant samples count as 0); carrier-only
  denominator reported as sensitivity.
"""
import pandas as pd, glob, os, json
from collections import Counter

EXCLUDED_SO = {"intron_variant", "3_prime_UTR_variant",
               "5_prime_UTR_variant", "5_prime_UTR_premature_start_codon_gain_variant"}
CARRIER_ZYG = {"Heterozygous", "Homozygous Variant"}

def s(x): return "" if pd.isna(x) else str(x).strip()

files = sorted(glob.glob("data/CHIP_DP10_GQ20_PASS/*.xlsx"))
assert len(files) == 86

rows = []
for f in files:
    xl = pd.ExcelFile(f)
    df = xl.parse(xl.sheet_names[0], header=None)
    row1 = [s(v) for v in df.iloc[1]]
    iz, iso, icp, ira = (row1.index(t) for t in
        ["Zygosity", "Sequence Ontology (Combined)", "Chr:Pos", "Ref/Alt"])
    data = df.iloc[2:]
    sample = os.path.basename(f).replace("230209_Exome_GRCh38_CHIP_", "").replace(".xlsx", "")
    for _, r in data.iterrows():
        z = s(r[iz]); so = s(r[iso])
        if z in CARRIER_ZYG:
            rows.append({"sample": sample, "chr_pos": s(r[icp]),
                         "ref_alt": s(r[ira]), "so": so,
                         "zygosity": z,
                         "excluded": so in EXCLUDED_SO,
                         "upstream": so == "upstream_gene_variant"})

rec = pd.DataFrame(rows)
print("Total carried-variant rows:", len(rec))
print("Excluded rows (intronic/UTR):", int(rec['excluded'].sum()))
print("Retained rows (primary, upstream kept):", int((~rec['excluded']).sum()))
print("Retained rows if upstream excluded:", int((~rec['excluded'] & ~rec['upstream']).sum()))

def summarize(crit_label, crit_mask, dedup=False):
    sub = rec[crit_mask]
    if dedup:
        sub = sub.drop_duplicates(["sample", "chr_pos", "ref_alt"])
    per = sub.groupby("sample").size().reindex(sorted(rec['sample'].unique()), fill_value=0)
    n_carriers = int((per > 0).sum())
    total = int(per.sum())
    return per, total, n_carriers

# Primary: upstream kept, row-count (no dedup)
per_main, tot_main, car_main = summarize("main", ~rec['excluded'])
# Sensitivity: upstream excluded
per_noUp, tot_noUp, car_noUp = summarize("no_upstream", ~rec['excluded'] & ~rec['upstream'])
# Sensitivity: dedup by (Chr:Pos, Ref/Alt), upstream kept
per_dedup, tot_dedup, car_dedup = summarize("main_dedup", ~rec['excluded'], dedup=True)

N = 86
def mean2(per, total, n_carriers):
    return total / N, total / n_carriers if n_carriers else float("nan")

m_main86, m_main_car = mean2(per_main, tot_main, car_main)
m_noUp86, m_noUp_car = mean2(per_noUp, tot_noUp, car_noUp)
m_dedup86, m_dedup_car = mean2(per_dedup, tot_dedup, car_dedup)

print("\n================ SUMMARY ================")
print(f"Primary (upstream kept, no dedup): total={tot_main}, carriers={car_main}, "
      f"mean/86={m_main86:.3f}, mean/carriers={m_main_car:.3f}")
print(f"Sens1 (upstream excluded):        total={tot_noUp}, carriers={car_noUp}, "
      f"mean/86={m_noUp86:.3f}, mean/carriers={m_noUp_car:.3f}")
print(f"Sens2 (dedup Chr:Pos+Ref/Alt):    total={tot_dedup}, carriers={car_dedup}, "
      f"mean/86={m_dedup86:.3f}, mean/carriers={m_dedup_car:.3f}")

# Per-sample table
tbl = pd.DataFrame({
    "sample": sorted(rec['sample'].unique()),
    "primary_retained": per_main.values,
    "primary_dedup": per_main.reindex(sorted(rec['sample'].unique()), fill_value=0).values,  # same index
    "no_upstream": per_noUp.values,
})
tbl = tbl.sort_values("sample").reset_index(drop=True)
tbl.to_csv("per_sample_counts.csv", index=False)

# Descriptive stats (retained under primary): SO distribution among retained
ret_so = rec.loc[~rec['excluded'], 'so'].value_counts().to_dict()
print("\nSO distribution among RETAINED variant rows (primary):", ret_so)
print("\nPer-sample table head:")
print(tbl.head(15).to_string(index=False))
print("...")
print("Per-sample table row count:", len(tbl))
print("Zero-variant samples under primary:", int((per_main == 0).sum()))

# Persist full results
res = {
    "N_samples": N,
    "carried_variant_rows": int(len(rec)),
    "excluded_rows": int(rec['excluded'].sum()),
    "excluded_by_SO": {k: int(v) for k, v in rec.loc[rec['excluded'], 'so'].value_counts().items()},
    "retained_rows_primary": tot_main,
    "primary": {"total": tot_main, "carriers": car_main, "mean_over_86": round(m_main86, 6),
                 "mean_over_carriers": round(m_main_car, 6)},
    "sensitivity_no_upstream": {"total": tot_noUp, "carriers": car_noUp,
                 "mean_over_86": round(m_noUp86, 6), "mean_over_carriers": round(m_noUp_car, 6)},
    "sensitivity_dedup": {"total": tot_dedup, "carriers": car_dedup,
                 "mean_over_86": round(m_dedup86, 6), "mean_over_carriers": round(m_dedup_car, 6)},
    "retained_SO_primary": ret_so,
    "per_sample": [{"sample": sample, "retained": int(per_main[sample])}
                   for sample in per_main.index],
}
with open("analysis_results.json", "w") as fh:
    json.dump(res, fh, indent=2)
print("\nWrote per_sample_counts.csv and analysis_results.json")
