"""BixBench bix-7-q2 data reconnaissance (no final computation).
Scans all 86 CHIP_DP10_GQ20_PASS workbooks for structure, key columns,
Zygosity, VAF presence, and Sequence Ontology category frequencies."""
import pandas as pd, glob, os, json
from collections import Counter

def s(x): return "" if pd.isna(x) else str(x).strip()

files = sorted(glob.glob("data/CHIP_DP10_GQ20_PASS/*.xlsx"))
assert len(files) == 86, len(files)

so_all, so_var, zyg = Counter(), Counter(), Counter()
vaf_by_zyg = Counter()
total_rows = vari_rows = 0
issues = []
per_file = {}
for f in files:
    xl = pd.ExcelFile(f)
    if len(xl.sheet_names) != 1:
        issues.append((os.path.basename(f), "multi-sheet"))
    df = xl.parse(xl.sheet_names[0], header=None)
    row1 = [s(v) for v in df.iloc[1]]
    for t in ["Chr:Pos","Ref/Alt","Zygosity","Variant Allele Freq",
              "Sequence Ontology (Combined)","Classification","In_CHIP"]:
        if t not in row1:
            issues.append((os.path.basename(f), "missing:"+t))
    iz, iso, ivaf = row1.index("Zygosity"), row1.index("Sequence Ontology (Combined)"), row1.index("Variant Allele Freq")
    data = df.iloc[2:]
    total_rows += len(data)
    z = [s(v) for v in data.iloc[:, iz]]
    so = [s(v) for v in data.iloc[:, iso]]
    vaf = data.iloc[:, ivaf]
    for zz, ss, vv in zip(z, so, vaf):
        zz = zz if zz else "<empty>"
        zyg[zz] += 1
        vaf_by_zyg[(zz, "VAF" if pd.notna(vv) else "noVAF")] += 1
        so_all[ss] += 1
        if zz in ("Heterozygous","Homozygous Variant"):
            so_var[ss] += 1
            vari_rows += 1
    per_file[os.path.basename(f)] = {"sheet": xl.sheet_names[0], "shape": [df.shape[0], df.shape[1]], "rows": len(data)}

out = {
    "n_files": len(files), "total_rows": total_rows, "variant_rows": vari_rows,
    "issues": issues,
    "zygosity": dict(zyg),
    "vaf_by_zygosity": {f"{k[0]}|{k[1]}": v for k, v in vaf_by_zyg.items()},
    "so_combined_all_rows": dict(so_all),
    "so_combined_variant_rows": dict(so_var),
    "per_file": per_file,
}
with open("recon_results.json", "w") as fh:
    json.dump(out, fh, indent=2)
print("n_files:", len(files), "total_rows:", total_rows, "variant_rows:", vari_rows)
print("issues:", issues)
print("zygosity:", dict(zyg))
print("SO all:", dict(so_all))
print("SO variant-rows:", dict(so_var))
