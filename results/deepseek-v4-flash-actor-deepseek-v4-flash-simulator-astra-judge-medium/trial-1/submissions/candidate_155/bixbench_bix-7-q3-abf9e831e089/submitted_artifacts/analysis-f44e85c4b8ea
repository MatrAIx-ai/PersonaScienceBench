"""
BixBench bix-7-q3 — "How many CHIP variants remain after removing reference calls from the dataset?"

Method (approved):
  1. Load all 86 CHIP variant files from data/CHIP_DP10_GQ20_PASS/ (single-sheet, two-row header;
     Zygosity is the per-sample genotype column; values: Reference / Heterozygous /
     Homozygous Variant; blank (NaN) = no-call).
  2. Reference call := Zygosity == 'Reference'  -> removed.
  3. No-call (NaN) rows carry no variant call and are NOT counted as "remaining CHIP variants".
  4. PRIMARY (final answer): count rows with Zygosity in {Heterozygous, Homozygous Variant}
     after concatenating all 86 files (sample-variant rows) = 11,896.
  5. Sensitivity contrasts: (a) naive '!= Reference' incl. NaN = 13,047;
     (b) unique loci (Chr:Pos) among non-reference calls = 673;
     (c) sum of per-file unique positions = 11,891; (d) excluding the two special files
     380-P/381-PM under primary convention = 11,630.
  6. Consistency checks: In_CHIP is True in all rows; Match.1 (CHIP gene) always inside the
     56-gene CHIP list (case-insensitive); CHIP gene list itself read with header=None.
"""
import pandas as pd
import glob
import os

DATA = 'data/CHIP_DP10_GQ20_PASS'
GENE_FILE = 'data/230214_Schenz_et_al_2022_CHIP_Genes.xlsx'
TRIO_FILE = 'data/230215_Trio_Status.xlsx'

files = sorted(glob.glob(os.path.join(DATA, '*.xlsx')))
print('Number of variant files:', len(files))

# ---- Load CHIP gene list (header=None so the first gene ABL1 is not dropped) ----
genes = pd.read_excel(GENE_FILE, header=None, sheet_name=0)[0].dropna().tolist()
genes_lower = {g.lower() for g in genes}
print('CHIP gene list size (with ABL1 as data row):', len(genes))

# ---- Load Trio Status (context only) ----
trio = pd.read_excel(TRIO_FILE)
print('Trio Status rows (samples):', trio.shape[0])

frames = []
per_file = []
zyg_values = set()
in_chip_false = 0
gene_list_violations = []

for f in files:
    fn = os.path.basename(f)
    df = pd.read_excel(f, header=1)          # two-row header; field names on row 1
    df.columns = [str(c) for c in df.columns]
    df['_sample'] = fn
    frames.append(df)
    z = df['Zygosity']
    zyg_values.update(z.dropna().astype(str).unique())
    n_ref = (z == 'Reference').sum()
    n_het = (z == 'Heterozygous').sum()
    n_hom = (z == 'Homozygous Variant').sum()
    n_nan = z.isna().sum()
    n_nonref = n_het + n_hom
    per_file.append({
        'file': fn, 'rows': len(df), 'reference': n_ref, 'het': n_het,
        'hom': n_hom, 'nan': n_nan, 'nonref': n_nonref,
        'uniq_pos': df.loc[df['Zygosity'].isin(['Heterozygous', 'Homozygous Variant']), 'Chr:Pos'].nunique(),
    })
    in_chip_false += (df['In_CHIP'].astype(str) == 'False').sum()
    m = df['Match.1'].dropna().astype(str)
    bad = m[~m.str.lower().isin(genes_lower)]
    if len(bad):
        gene_list_violations.append((fn, bad.unique().tolist()))

ALL = pd.concat(frames, ignore_index=True)
print('\nTotal rows across dataset:', len(ALL))
print('Unique Zygosity values observed:', sorted(zyg_values))
print('Rows with In_CHIP==False:', in_chip_false)
print('Files whose Match.1 gene falls outside the 56-gene list:', gene_list_violations or 'NONE')

# ---- Counts ----
n_ref = (ALL['Zygosity'] == 'Reference').sum()
n_het = (ALL['Zygosity'] == 'Heterozygous').sum()
n_hom = (ALL['Zygosity'] == 'Homozygous Variant').sum()
n_nan = ALL['Zygosity'].isna().sum()
n_nonref = n_het + n_hom

print('\n===== Counts (whole dataset) =====')
print(f'Reference calls removed          : {n_ref}')
print(f'Heterozygous calls               : {n_het}')
print(f'Homozygous Variant calls         : {n_hom}')
print(f'No-call (NaN) rows (excluded)    : {n_nan}')

primary = n_nonref
naive = len(ALL) - n_ref                       # '!= Reference' incl. NaN
uniq_pos = ALL.loc[ALL['Zygosity'].isin(['Heterozygous', 'Homozygous Variant']), 'Chr:Pos'].nunique()
sum_perfile_uniq = sum(p['uniq_pos'] for p in per_file)
nonref_no_380_381 = sum(p['nonref'] for p in per_file if '380-P' not in p['file'] and '381-PM' not in p['file'])

print('\n===== RESULTS =====')
print('PRIMARY  (non-reference calls, no-call excluded)          :', primary)
print('Contrast (a) naive "!= Reference" incl. NaN               :', naive)
print('Contrast (b) unique loci (Chr:Pos), non-reference calls   :', uniq_pos)
print('Contrast (c) sum of per-file unique non-ref positions     :', sum_perfile_uniq)
print('Contrast (d) non-ref excl. 380-P & 381-PM                 :', nonref_no_380_381)

# ---- special files detail ----
print('\n===== Special files (380-P, 381-PM) & any no-call rows =====')
print(f"{'file':38s} {'rows':>5s} {'ref':>4s} {'het':>4s} {'hom':>4s} {'nan':>4s} {'nonref':>6s}")
for p in per_file:
    if p['nan'] > 0:
        print(f"{p['file']:38s} {p['rows']:5d} {p['reference']:4d} {p['het']:4d} "
              f"{p['hom']:4d} {p['nan']:4d} {p['nonref']:6d}")

# ---- per-file summary table (first 10) ----
print('\n===== Per-file summary (first 12) =====')
pf = pd.DataFrame(per_file)
print(pf.head(12).to_string(index=False))
print('...')
print('Per-file nonref totals: min/mean/max =',
      pf['nonref'].min(), pf['nonref'].mean().round(1), pf['nonref'].max())

# save per-file detail to CSV for the record
pf.to_csv('chip_per_file_summary.csv', index=False)
print('\nSaved per-file summary -> chip_per_file_summary.csv')
