"""BixBench bix-8-q5 - Independence test between m6A methylation status
and differential expression status (bladder cancer, transcript-level rows).

Contract (researcher-approved):
- Source: data/MeRIP_RNA_result.xlsx, columns m6A and DEG, all 12754 rows.
- Statuses:
    m6A  -> methylated   = 'm6A Hyper' + 'm6A Hypo'
            not_methylated = 'm6A no sig'
    DEG  -> DEG          = 'Up' + 'Down'
            not_DEG        = 'no-DEGs'
- Primary test: Pearson chi-square (scipy chi2_contingency, Yates correction default).
- Robustness: Fisher exact test.
- p-value reported in scientific notation.
"""
import numpy as np
import pandas as pd
from scipy import stats

# ---- 1. Load data ----
df = pd.read_excel("data/MeRIP_RNA_result.xlsx", sheet_name="Date Formatting")
assert df.shape == (12754, 13), f"Unexpected shape {df.shape}"
assert df[['m6A', 'DEG']].isna().sum().sum() == 0, "Unexpected missing values in m6A/DEG"

# ---- 2. Binary class mapping ----
m6A_map = {'m6A Hyper': 'methylated', 'm6A Hypo': 'methylated', 'm6A no sig': 'not_methylated'}
DEG_map = {'Up': 'DEG', 'Down': 'DEG', 'no-DEGs': 'not_DEG'}
df['m6A_bin'] = df['m6A'].map(m6A_map)
df['DEG_bin'] = df['DEG'].map(DEG_map)
assert df['m6A_bin'].notna().all() and df['DEG_bin'].notna().all(), "Unmapped labels present"

# ---- 3. 2x2 contingency table (rows = DEG status, cols = m6A status) ----
ct = pd.crosstab(df['DEG_bin'], df['m6A_bin'])
ct = ct.loc[['DEG', 'not_DEG'], ['methylated', 'not_methylated']]  # fixed ordering
table = ct.values.astype(np.int64)
print("Contingency table (rows=DEG; cols=m6A):")
print(ct)
print("\nRaw counts: DEG&methylated=%d, DEG&not_methylated=%d, "
      "not_DEG&methylated=%d, not_DEG&not_methylated=%d"
      % (table[0,0], table[0,1], table[1,0], table[1,1]))
print("Table total:", table.sum())

# Expected counts under independence
tot = table.sum()
expected = np.outer(table.sum(axis=1), table.sum(axis=0)) / tot
print("\nExpected counts (row sums) under independence:")
print(pd.DataFrame(expected, index=ct.index, columns=ct.columns))
print("Min expected cell:", expected.min().min())

# ---- 4. Primary: Pearson chi-square with Yates continuity correction ----
chi2_corrected, p_chi2_corrected, dof, _ = stats.chi2_contingency(table, correction=True)
chi2_uncorrected, p_chi2_uncorrected, _, _ = stats.chi2_contingency(table, correction=False)

# ---- 5. Robustness: Fisher exact test ----
odds_ratio, p_fisher = stats.fisher_exact(table, alternative='two-sided')

print("\n=================== RESULTS ===================")
print(f"Pearson chi-square (Yates correction=True):")
print(f"  chi2 = {chi2_corrected:.6f}, dof = {dof}, p = {p_chi2_corrected:.4e}")
print(f"Pearson chi-square (correction=False, reference):")
print(f"  chi2 = {chi2_uncorrected:.6f}, p = {p_chi2_uncorrected:.4e}")
print(f"Fisher exact test (two-sided):")
print(f"  odds_ratio = {odds_ratio:.6f}, p = {p_fisher:.4e}")

def sci(x):
    s = f"{x:.3e}"
    m, e = s.split('e')
    return f"{m}e{e}"

print("\n=================== REPORT (scientific notation) ===================")
print("2x2 table [DEG&m6A+ , DEG&m6A- ; notDEG&m6A+ , notDEG&m6A-]:", table.tolist())
print("chi2 (Yates) =", f"{chi2_corrected:.4f}", "| dof =", dof)
print("p_chi2 (Yates) =", sci(p_chi2_corrected))
print("p_fisher (two-sided) =", sci(p_fisher))
