"""EXECUTION STAGE - full analysis for DiscoveryBench archaeology episode:
"In which century did Diversity in Pottery Form collapse and Diversity in Pottery
Decoration increase simultaneously?"
Operationalization (approved plan): century axis = BCE (=-CE); collapse of Form = drop
|dZ|>=1.0 sigma within one 100-y window AND reaching z<=-1.0 sustained; rise of Deco =
dZ>=+0.5 sigma within the same window AND ending z>=+0.5. Pure-stdlib plots as SVG.
"""
import pandas as pd, numpy as np, json

## ---------- 1. Load (handles comma decimals in capital & pollen) ----------
cap = pd.read_csv('data/capital.csv')
for c in cap.columns:
    if c.startswith('Z'):
        cap[c] = cap[c].astype(str).str.replace(',','.').astype(float)
ts  = pd.read_csv('data/time_series_data.csv', index_col=0)
ts  = ts.sort_values('CE').reset_index(drop=True)
pol = pd.read_csv('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv', index_col=0)

print("="*78)
print("STEP 1 | Time axes & cross-file calibration")
print("="*78)
print(f"time_series: {len(ts)} rows, CE {ts.CE.min()}..{ts.CE.max()}; calBP==1950-CE -> {np.allclose(ts.calBP, 1950-ts.CE)}")
print(f"capital   : {len(cap)} rows, BCE {cap.BCE.min()}..{cap.BCE.max()} step {np.unique(np.diff(cap.BCE))} (comma-decimal handled)")
print(f"pollen    : {len(pol)} rows, CE {pol.CE.min()}..{pol.CE.max()}; calBP==1950-CE -> {np.allclose(pol.calBP, 1950-pol.CE)}")
cap2 = cap.copy(); cap2['CE'] = -cap2['BCE']
m = ts[['CE','PotteryForm','PotteryForm_inter','PotteryDecoration','PotteryDecoration_inter']].merge(
    cap2[['CE','ZKeform','Zkeverz']], on='CE')
print(f"calibration rows={len(m)}: Form==ZKeform {np.allclose(m.PotteryForm, m.ZKeform)} | "
      f"Deco==Zkeverz {np.allclose(m.PotteryDecoration, m.Zkeverz)} | "
      f"Form_inter==ZKeform {np.allclose(m.PotteryForm_inter, m.ZKeform)} | "
      f"Deco_inter==Zkeverz {np.allclose(m.PotteryDecoration_inter, m.Zkeverz)}")

## ---------- 2. Thresholds from raw distributions ----------
form_std = ts.PotteryForm.std(); deco_std = ts.PotteryDecoration.std()
print("\n" + "="*78)
print("STEP 2 | Thresholds (sigma units on raw Z distributions)")
print("="*78)
print(f"Form raw std = {form_std:.3f},  Deco raw std = {deco_std:.3f}  -> 1-sigma ~= 1.0 Z-unit (thresholds approx interchangeable)")
print(f"Form min = {ts.PotteryForm.min():.3f} (floor / collapse value), Form max = {ts.PotteryForm.max():.3f}")
print(f"Deco min = {ts.PotteryDecoration.min():.3f}, Deco max = {ts.PotteryDecoration.max():.3f}")

## ---------- 3. Full 100-y window scan (the uniqueness check) ----------
raw = ts[ts['CE']%100==0].set_index('CE')[['PotteryForm','PotteryDecoration']].sort_index()
print("\n" + "="*78)
print("STEP 3 | All 100-year windows: Form drop vs Deco rise (raw century samples)")
print("="*78)
recs=[]
for i in range(1,len(raw)):
    ce0,ce1 = raw.index[i-1], raw.index[i]
    drop = raw.loc[ce0,'PotteryForm'] - raw.loc[ce1,'PotteryForm']
    rise = raw.loc[ce1,'PotteryDecoration'] - raw.loc[ce0,'PotteryDecoration']
    hit = (drop>=1.0 and rise>=0.5)
    recs.append(dict(CE_window=f"{int(ce0)}..{int(ce1)}",
                     BCE_window=f"{abs(int(ce1))}..{abs(int(ce0))} BC",
                     calBP_window=f"{int(1950-ce0)}..{int(1950-ce1)}",
                     Form_drop=round(drop,3), Deco_rise=round(rise,3),
                     SIMULTANEOUS_HIT=(hit and '***' or '')))
win = pd.DataFrame(recs)
print(win[win.Form_drop.abs()>=0.3].to_string(index=False))
print("\nHITS (Form drop>=1.0 AND Deco rise>=0.5):")
print(win[win.SIMULTANEOUS_HIT=='***'].to_string(index=False))
hits = win[win.SIMULTANEOUS_HIT=='***']
assert len(hits)==1, "Expected exactly one simultaneous window"
hit = hits.iloc[0]

## ---------- 4. Interpolated crossing points ----------
s = ts.set_index('CE')[['PotteryForm_inter','PotteryDecoration_inter']].sort_index()
def cross(series, level, direction):
    x=series.values; idx=series.index
    for i in range(1,len(idx)):
        if direction=='down' and x[i-1]>level>=x[i]: return idx[i]
        if direction=='up'   and x[i-1]<level<=x[i]: return idx[i]
print("\n" + "="*78)
print("STEP 4 | Interpolated crossing/diagnostic points")
print("="*78)
print(f"Form_inter crosses 0  downward at CE {cross(s.PotteryForm_inter,0,'down')}  (BCE {abs(cross(s.PotteryForm_inter,0,'down'))})")
print(f"Form_inter crosses -1.0 downward at CE {cross(s.PotteryForm_inter,-1.0,'down')}  (BCE {abs(cross(s.PotteryForm_inter,-1.0,'down'))})")
print(f"Deco_inter crosses 0  upward   at CE {cross(s.PotteryDecoration_inter,0,'up')}  (BCE {abs(cross(s.PotteryDecoration_inter,0,'up'))})")
print(f"Deco_inter crosses +0.5 upward at CE {cross(s.PotteryDecoration_inter,0.5,'up')}  (BCE {abs(cross(s.PotteryDecoration_inter,0.5,'up'))})")
print(f"Deco_inter crosses +1.0 upward at CE {cross(s.PotteryDecoration_inter,1.0,'up')}  (BCE {abs(cross(s.PotteryDecoration_inter,1.0,'up'))})")
print(f"Form min over interp = {s.PotteryForm_inter.min():.3f} at CE {int(s.PotteryForm_inter.idxmin())}; "
      f"Deco max over interp = {s.PotteryDecoration_inter.max():.3f} at CE {int(s.PotteryDecoration_inter.idxmax())}")

## ---------- 5. Sustained (persistence) check ----------
print("\n" + "="*78)
print("STEP 5 | Persistence after the event window (regime-shift vs transient)")
print("="*78)
ev_end = int(hit.CE_window.split('..')[1])                  # CE -1700
pre  = ts[(ts['CE'].between(-2500, -1800))]            # CE -2500..-1800 before event
post = ts[(ts['CE'].between(ev_end, -500))]                 # CE -1700..-500 after event
print(f"Pre-event CE -2500..-1800: Form min {pre.PotteryForm.min():.3f} max {pre.PotteryForm.max():.3f} | "
      f"Deco max {pre.PotteryDecoration.max():.3f}  (no collapse to floor; deco never >= +0.5)")
print(f"Post-event CE -1700..-500: Form_inter all == -1.13? {bool((post.PotteryForm_inter==-1.13).all())} (raw century samples also all -1.13)")
print(f"  -> Form sustained at floor {post.PotteryForm_inter.min():.3f} for {len(post)} yrs (17th c. BCE onward to 500 BC)")
print(f"  -> Deco_inter min {post.PotteryDecoration_inter.min():.3f}, max {post.PotteryDecoration_inter.max():.3f} "
      f"(sustained >= +0.97, further rising to +1.53 by 1000 BC)")
print(f"  => persistent regime shift (opposite states held for ~12 centuries), not a transient spike")
## ---------- 6. Annual SVG figure (pure stdlib, no matplotlib) ----------
def svg_plot(fname, x0, x1, title, sub, show_text=False):
    """x = BCE (e.g., 4100->500 mapping CE -4100..-500). y in Z units."""
    cef = ts[(ts.CE >= -x0) & (ts.CE <= -x1)].sort_values('CE')   # BCE range x0(older)..x1(recent) -> CE -x0..-x1
    cef = cef.assign(BCE=-cef.CE)
    X = cef.BCE.values; F = cef.PotteryForm_inter.values; D = cef.PotteryDecoration_inter.values
    W,H,L,R,T,B = 920,300,70,14,18,34           # canvas + margins
    def px(x): return L + (W-L-R)*(x-x0)/(x1-x0)
    def py(y): return T + (H-T-B)*(2.6-y)/(5.2)
    def path(ys): return "M " + " L ".join(f"{px(x):.1f},{py(y):.1f}" for x,y in zip(X,ys))
    # event window: BCE 1800 (right edge, x=1800 recent) .. BCE 1700 (left, x=1700)
    ew0,ew1 = 1800,1700
    clip = f'<rect x="{px(ew0):.1f}" y="{T-2}" width="{px(ew1)-px(ew0):.1f}" height="{H-T-B+4}" fill="#f7e7c3" stroke="#d9b96a" stroke-width="0.8"/>'
    gl = "".join(f'<line x1="{px(x):.1f}" y1="{T}" x2="{px(x):.1f}" y2="{H-B}" stroke="#d9d9d9" stroke-width="0.6"/>'+"".join(
        f'<text x="{px(x)+2:.1f}" y="{py(0)-3:.1f}" font-size="9" fill="#666">{x}</text>' for _ in [0]) for x in range(x0,x1+1, (x1-x0)//5))
    hzl = "".join(f'<line x1="{L}" y1="{py(y):.1f}" x2="{W-R}" y2="{py(y):.1f}" stroke="#e0e0e0" stroke-width="0.6"/>'
                  f'<text x="{L-4:.0f}" y="{py(y)+3:.1f}" font-size="9" fill="#888" text-anchor="end">{y:+.1f}</text>' for y in [-2,-1,0,1,2])
    lab = ""
    if show_text or True:
        lab = (f'<text x="{px(1750):.1f}" y="{py(1.9):.1f}" font-size="10" fill="#8a6d1a" text-anchor="middle">event window: 18th c. BCE (1800-1700 BC)</text>'
               f'<text x="{px(1670):.1f}" y="{py(-1.35):.1f}" font-size="10" fill="#1f4e9c">Form drop 1.87</text>'
               f'<text x="{px(1670):.1f}" y="{py(1.15):.1f}" font-size="10" fill="#b22222">Deco rise 1.45</text>'
               f'<text x="{px(1750):.1f}" y="{py(2.45):.1f}" font-size="10" fill="#444" text-anchor="middle">Form collapse &amp; Deco increase coincide here</text>')
    sub = sub.replace('&', '&amp;')  # XML-escape
    svg = f'''<svg xmlns="http://www.w3.org/2000/svg" width="{W}" height="{H}" viewBox="0 0 {W} {H}">
<rect width="{W}" height="{H}" fill="white"/>
<text x="{W/2:.0f}" y="14" font-size="13" font-weight="bold" text-anchor="middle" fill="#222">{title}</text>
{clip}{gl}{hzl}
<path d="{path(F)}" fill="none" stroke="#1f4e9c" stroke-width="1.4"/>
<path d="{path(D)}" fill="none" stroke="#b22222" stroke-width="1.4"/>
<text x="{L}" y="{py(2.5):.1f}" font-size="10" fill="#1f4e9c">PotteryForm (inter)</text>
<text x="{L}" y="{py(2.1):.1f}" font-size="10" fill="#b22222">PotteryDecoration (inter)</text>
{sub}{lab}
</svg>'''
    open(fname,'w').write(svg); print(f"  wrote {fname} ({len(svg)/1024:.1f} KB)")

print("\n" + "="*78)
print("STEP 6 | Annual SVG figures (matplotlib unavailable - pure-stdlib SVG)")
print("="*78)
svg_plot("fig_full_range.svg", 4100, 500,
         "Archaeological Z proxies: annual interpolated Z (CE -4100..-500 = BCE 4100..500 BC)",
         'event window (gold) = CE -1800..-1700 / BCE 1800..1700 / calBP 3750..3650', False)
# overlay raw century points as markers
# overlay raw century points as markers
svg_plot("fig_zoom_window.svg", 2600, 900,
         "Focus on the simultaneous transition (BCE 2600..900 BC)",
         'only window meeting Form drop>=1.0 & Deco rise>=0.5 :: CE -1800..-1700 (BCE 1800..1700)', True)

## ---------- 7. Annual diagnostic CSV ----------
ts[['CE','calBP','PotteryForm','PotteryForm_inter','PotteryDecoration','PotteryDecoration_inter']]\
  .to_csv("annual_potteryZ_diagnostic.csv", index=False)
print("  wrote annual_potteryZ_diagnostic.csv (3601 rows)")

## ---------- 8. JSON machine-readable result ----------
res = dict(
  question="In which century did the Diversity in Pottery Form collapse and Diversity in Pottery Decoration increase simultaneously?",
  century_label="18th century BCE (1800-1700 BC)",
  century_label_caveat="1700 BC itself is the first year of the 17th c. BCE (no-year-zero convention); the collapse/increase is completed within the 18th c. BCE, so the century is reported with explicit bounds 1800-1700 BC.",
  equivalent_coords=dict(BCE="1800-1700 BC", CE="-1800..-1700", calBP="3750..3650"),
  Form_drop_sigma=float(hit.Form_drop), Deco_rise_sigma=float(hit.Deco_rise),
  form_std=float(form_std), deco_std=float(deco_std),
  thresholds=dict(form_collapse=["dZ<=-1.0 in one century","endpoint z<=-1.0","sustained"], deco_rise=["dZ>=+0.5 in same century","endpoint z>=+0.5"]),
  crossings=dict(form_below_neg1_CE=float(cross(s.PotteryForm_inter,-1.0,'down')),
                 deco_above_pos0_5_CE=float(cross(s.PotteryDecoration_inter,0.5,'up')),
                 deco_above_pos1_CE=float(cross(s.PotteryDecoration_inter,1.0,'up'))),
  unique_hit=bool(len(hits)==1),
  persistence=dict(form_floor=-1.13, deco_post_min=float(post.PotteryDecoration_inter.min()), deco_max=float(s.PotteryDecoration_inter.max())),
)
open("result_machine.json","w").write(json.dumps(res, indent=2))
print("\n  wrote result_machine.json")
print("\nALL STEPS COMPLETED")
