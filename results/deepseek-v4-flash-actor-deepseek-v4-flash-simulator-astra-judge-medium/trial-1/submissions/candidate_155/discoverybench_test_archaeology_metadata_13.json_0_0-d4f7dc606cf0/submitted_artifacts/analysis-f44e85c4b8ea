# -*- coding: utf-8 -*-
"""
DiscoveryBench archaeology task - analysis
Question: In what centuries did we see the highest growth phase of the period between 2000 BCE and 1100 BCE?

Design (approved):
- Time axis: CE = -BCE, calBP = 1950 - CE (verified on both files).
- Range: 2000 BCE - 1100 BCE  =>  CE in [-2000, -1100] (901 annual points, gap-free).
- Primary growth proxies:
    * g_all_mean (mean KDE growth rate of all archaeological findings)
    * Self-computed pollen-openness growth from pollen_inter (=Belau_PC1_inter) & pollen_inter_100 (=SMOOTH_MEAN_100y)
- Cross-validation: capital.csv Z columns grouped into 4 capitals (approved mapping):
    Symbolic = ZAxtSchwert, ZDolch, Zhausgr ;  Social = ZCU_AU, Zamber, ZMonument
    Economic = ZHort, ZSichel, ZBeil, ZMW   ;  Cultural = ZKeform, Zkeverz
- Binning schemes:
    A (primary): 9 full centuries (2000s..1200s BCE = CE [-2000,-1901]..[-1200,-1101]), endpoint 1100 BCE reported separately
    B (robustness): 10 discrete century points 2000,1900,...,1100; growth = change in levels between consecutive markers
- pollen_grate_100: low-confidence (definition not reproducible), reported but not used as decision criterion.
"""
import pandas as pd, numpy as np

def tofloat(x): return float(str(x).replace(',','.'))

# ---------------- Load & clean ----------------
ts = pd.read_csv('data/time_series_data.csv').sort_values('CE').reset_index(drop=True)
cap = pd.read_csv('data/capital.csv')
for col in cap.columns:
    if col in ('BCE','group','color'): continue
    cap[col] = cap[col].astype(str).str.replace(',','.').astype(float)
pol = pd.read_csv('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv')
for col in ['MEAN','SMOOTH_MEAN_100y']:
    pol[col] = pol[col].map(tofloat)
pol = pol.sort_values('CE').reset_index(drop=True)

assert (ts.calBP == 1950 - ts.CE).all() and (pol.calBP == 1950 - pol.CE).all()
print('[fact] calBP=1950-CE holds in both time_series & pollen files')
g = ts.g_all_mean; dk = ts.kde_all_mean.diff(); rl = np.log(ts.kde_all_mean.clip(lower=1e-12)).diff()
m = ~(g.isna()|dk.isna()|rl.isna())
print('[interp] corr(g_all_mean, d(kde)) = %.3f ; corr(g_all_mean, d(log kde)) = %.3f -> g_all_mean ~ relative growth rate of KDE (proxy of total activity)'
      %(np.corrcoef(g[m],dk[m])[0,1], np.corrcoef(g[m],rl[m])[0,1]))

# merge pollen-file 100y-smoothed mean (Woserin+Belau) for reference
ts = ts.merge(pol[['CE','MEAN','SMOOTH_MEAN_100y']], on='CE', how='left', suffixes=('','_pol'))

# ---------------- Correct century definition (CE-based) ----------------
rng = ts[(ts.CE>=-2000)&(ts.CE<=-1100)].copy()
# block start year (BCE) from CE: CE -2000..-1901 -> year 2000; CE -1900..-1801 -> 1900 ... etc.
rng['cent_CE'] = (rng.CE // 100) * 100          # -2000,-1900,...,-1200
rng['cent_year'] = -rng['cent_CE']              # 2000,1900,...,1200
print('[check] block sizes (should be 100 except none):')
print(rng.groupby('cent_year').size().to_string())

def block_stats(d):
    d = d.sort_values('CE')
    out = {}
    out['n'] = len(d)
    out['g_all_mean'] = d['g_all_mean'].mean()
    out['g_all_sum'] = d['g_all_mean'].sum()
    out['grate100_mean'] = d['pollen_grate_100'].mean()
    # pollen openness: mean annual relative change of the 100y-smoothed series (positive baseline, no zero-division)
    out['open_pct_yr'] = (d['pollen_inter_100'].pct_change().mean())*100.0
    # pollen openness level changes across the century (absolute & %)
    s, e = d['pollen_inter_100'].iloc[0], d['pollen_inter_100'].iloc[-1]
    out['open_level_chg'] = e - s
    out['open_level_pct'] = (e-s)/s*100.0 if s!=0 else np.nan
    # raw interpolated openness level changes (can go near zero -> % unstable, absolute ok)
    si, ei = d['pollen_inter'].iloc[0], d['pollen_inter'].iloc[-1]
    out['pollen_inter_chg'] = ei - si
    out['kde_level_chg'] = d['kde_all_mean'].iloc[-1]-d['kde_all_mean'].iloc[0]
    return pd.Series(out)

# ---------- Scheme A: 9 full centuries ----------
SA = pd.DataFrame({c: block_stats(rng[rng.cent_year==c]) for c in [2000,1900,1800,1700,1600,1500,1400,1300,1200]}).T
SA.index.name='century (start BCE)'
ep = rng[rng.cent_year==1100]
print('\n===== SCHEME A: 9 full centuries 2000s..1200s BCE =====')
print(SA.round(4).to_string())
print('Endpoint 1100 BCE (1 yr, partial): g_all_mean=%.5f'%ep.g_all_mean.iloc[0])

# ---------- Scheme B: 10 discrete points, growth between consecutive markers ----------
markers = [2000,1900,1800,1700,1600,1500,1400,1300,1200,1100]
rngm = rng.set_index('CE')
def vat(bce, col): return rngm.loc[-bce, col]
rows = []
for i in range(len(markers)-1):
    o, n = markers[i], markers[i+1]
    rows.append({'interval': '%d->%d BCE'%(o,n),
        'g_all_mean_mean': rngm.loc[-o:-n+1,'g_all_mean'].mean(),   # mean rate over years O..N
        'g_all_mean_chg_between': vat(n,'g_all_mean')-vat(o,'g_all_mean'),  # acceleration proxy
        'open_level_chg': vat(n,'pollen_inter_100')-vat(o,'pollen_inter_100'),
        'open_level_pct': (vat(n,'pollen_inter_100')-vat(o,'pollen_inter_100'))/vat(o,'pollen_inter_100')*100,
        'open_pct_yr_mean': rngm.loc[-o:-n+1,'pollen_inter_100'].pct_change().mean()*100,
        'kde_level_chg': vat(n,'kde_all_mean')-vat(o,'kde_all_mean'),
    })
SB = pd.DataFrame(rows).set_index('interval')
print('\n===== SCHEME B: 10 discrete points -> 9 intervals =====')
print(SB.round(4).to_string())

# ---------------- Capital: 4 capitals (approved mapping) ----------------
CAP = {'Symbolic':['ZAxtSchwert','ZDolch','Zhausgr'],
       'Social':['ZCU_AU','Zamber','ZMonument'],
       'Economic':['ZHort','ZSichel','ZBeil','ZMW'],
       'Cultural':['ZKeform','Zkeverz']}
capr = cap[(cap.BCE<=2000)&(cap.BCE>=1100)].sort_values('BCE',ascending=False).reset_index(drop=True)
def cap_deltas(mark_list):
    rows=[]
    for o,n in zip(mark_list[:-1], mark_list[1:]):
        ro=capr[capr.BCE==o].iloc[0]; rn=capr[capr.BCE==n].iloc[0]
        d={'interval':'%d->%d BCE'%(o,n)}
        for cc,cats in CAP.items():
            dv=[rn[col]-ro[col] for col in cats]
            d[cc+'_dmean']=np.mean(dv); d[cc+'_dsum']=np.sum(dv)
        rows.append(d)
    return pd.DataFrame(rows).set_index('interval')
capA = cap_deltas([2000,1900,1800,1700,1600,1500,1400,1300,1200])  # scheme A: up to 1200
capB = cap_deltas(markers)                                         # scheme B: full 2000..1100
print('\n===== CAPITAL scheme A (2000..1200): 4-capital mean-column delta per century =====')
print(capA.round(3).to_string())
print('Total across capitals:')
print(capA[[c+'_dmean' for c in CAP]].sum(axis=1).round(3).to_string())
print('\n===== CAPITAL scheme B (2000..1100) total across capitals =====')
print(capB[[c+'_dmean' for c in CAP]].sum(axis=1).round(3).to_string())

# ---------------- Rankings ----------------
print('\n===== RANKINGS (highest growth first) =====')
def show(title, s): print('\n'+title); print(s.round(4).to_string())
show('A | g_all_mean (mean annual KDE growth rate)', SA['g_all_mean'].sort_values(ascending=False))
show('A | pollen openness 100y level change', SA['open_level_chg'].sort_values(ascending=False))
show('A | pollen openness mean annual pct (100y smoothed)', SA['open_pct_yr'].sort_values(ascending=False))
show('B | g_all_mean (mean over interval years)', SB['g_all_mean_mean'].sort_values(ascending=False))
show('B | pollen openness 100y level change', SB['open_level_chg'].sort_values(ascending=False))
show('B | pollen openness interval pct', SB['open_level_pct'].sort_values(ascending=False))
show('B | capital total delta', capB[[c+'_dmean' for c in CAP]].sum(axis=1).sort_values(ascending=False))
show('A | capital total delta', capA[[c+'_dmean' for c in CAP]].sum(axis=1).sort_values(ascending=False))
show('A | pollen_grate_100 mean (LOW-CONFIDENCE, reference only)', SA['grate100_mean'].sort_values(ascending=False))

# agreement (Scheme A)
rank = pd.DataFrame({'g_all':SA.g_all_mean,'open_chg':SA.open_level_chg,
                     'open_pct':SA.open_pct_yr,'kde_chg':SA.kde_level_chg,
                     'grate100':SA.grate100_mean})
print('\nSpearman corr among Scheme-A proxies:'); print(rank.corr(method='spearman').round(2).to_string())
print('\nScheme-A top-2 centuries per proxy:')
for c0 in rank.columns: print(' ',c0,'->',rank[c0].sort_values(ascending=False).index[:2].tolist())
print('\nScheme-B top-2 intervals per proxy:')
for c0 in ['g_all_mean_mean','open_level_chg','open_level_pct','open_pct_yr_mean','kde_level_chg']:
    print(' ',c0,'->',SB[c0].sort_values(ascending=False).index[:2].tolist())
