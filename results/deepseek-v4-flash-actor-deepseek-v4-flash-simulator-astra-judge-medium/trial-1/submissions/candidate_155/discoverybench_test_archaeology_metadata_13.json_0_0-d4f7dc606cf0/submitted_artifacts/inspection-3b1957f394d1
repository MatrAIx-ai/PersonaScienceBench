# Data inspection & feasibility checks for archaeology task (BCE 2000-1100)
# Produces the key facts used in the plan handoff.
import pandas as pd, numpy as np

def tofloat(x): return float(str(x).replace(',','.'))

# ---------- time_series_data.csv ----------
ts = pd.read_csv('data/time_series_data.csv')
print('time_series rows:', len(ts), 'cols:', len(ts.columns))
print('CE range:', ts.CE.min(), ts.CE.max(), '| calBP range:', ts.calBP.min(), ts.calBP.max())
print('calBP==1950-CE all:', (ts.calBP==1950-ts.CE).all(), '| CE step unique:', ts.CE.diff().dropna().unique())
sub = ts[(ts.CE>=-2000)&(ts.CE<=-1100)]
print('range rows:', len(sub), '| no pollen_grate100 NaN:', sub.pollen_grate_100.notna().all(),
      '| no g_all_mean NaN:', sub.g_all_mean.notna().all())
print('g_all_mean in-range: mean=%.5f std=%.5f max=%.5f'%(sub.g_all_mean.mean(), sub.g_all_mean.std(), sub.g_all_mean.max()))

# ---------- capital.csv ----------
c = pd.read_csv('data/capital.csv')
for col in c.columns:
    if col in ('BCE','group','color'): continue
    c[col] = c[col].astype(str).str.replace(',','.').astype(float)
print('\ncapital rows:', len(c), '| BCE range:', c.BCE.min(), c.BCE.max(), '| step:', c.BCE.diff().dropna().unique())
cap = c[(c.BCE<=2000)&(c.BCE>=1100)].sort_values('BCE', ascending=False)
print('capital pts in 2000-1100 BCE:', cap.BCE.tolist())

# ---------- pollen_openness file ----------
p = pd.read_csv('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv')
for col in ['Belau_PC1','Woserin_PC1','Belau_PC1_inter','Woserin_PC1_inter','MEAN',
            'SMOOTH_MEAN_50y','SMOOTH_MEAN_100y','SMOOTH_MEAN_150y','SMOOTH_MEAN_200y','SMOOTH_MEAN_250y']:
    p[col] = p[col].map(tofloat)
print('\npollen file rows:', len(p), '| CE range:', p.CE.min(), p.CE.max())
print('calBP==1950-CE all:', (p.calBP==1950-p.CE).all())
ps = p[(p.CE>=-2000)&(p.CE<=-1100)]
print('pollen range rows:', len(ps), '| Belau raw non-NaN:', ps.Belau_PC1.notna().sum(),
      '| Woserin raw non-NaN:', ps.Woserin_PC1.notna().sum())

# cross-check ts.pollen_inter vs pollen-file Belau_PC1_inter
m = ts.merge(p[['CE','Belau_PC1_inter']], on='CE', how='inner')
print('\noverlap ts vs pollen-file rows:', len(m),
      '| corr pollen_inter vs Belau_PC1_inter: %.5f'%np.corrcoef(m.pollen_inter, m.Belau_PC1_inter)[0,1])

# ---------- century summaries (preliminary, for plan) ----------
tsr = ts[(ts.CE>=-2000)&(ts.CE<=-1100)].copy()
tsr['bce'] = -tsr['CE']; tsr['century'] = (tsr['bce']//100)*100
tsr = tsr[tsr.century!=1100]
g = tsr.groupby('century').agg(g_all_mean=('g_all_mean','mean'), grate100=('pollen_grate_100','mean'))
print('\ncentury means (2000..1200 BCE):\n', g.sort_index().to_string())
print('g_all_mean top3:', g.sort_values('g_all_mean',ascending=False).index[:3].tolist())
print('grate100 top3:', g.sort_values('grate100',ascending=False).index[:3].tolist())
