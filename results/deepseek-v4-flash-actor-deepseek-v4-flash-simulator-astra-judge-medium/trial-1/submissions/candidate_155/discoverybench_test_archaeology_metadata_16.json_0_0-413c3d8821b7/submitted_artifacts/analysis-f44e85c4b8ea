"""
DiscoveryBench archaeology (metadata_16): Capital-forms PCA in 100-year time slices.
Phases: Middle Neolithic (3400-3000 BCE) vs Younger Neolithic (2900-2300 BCE).
Corrected capital mapping (domain knowledge id archaeology.domain_knowledge.1).
"""
import pandas as pd
import numpy as np
from itertools import combinations

# ---------- 1. Load & clean ----------
cap = pd.read_csv('data/capital.csv')
for c in cap.columns:
    if pd.api.types.is_string_dtype(cap[c]):
        cap[c] = cap[c].astype(str).str.replace(',', '.')

num_cols = ['ZAxtSchwert','ZDolch','Zhausgr','ZCU_AU','Zamber','ZMonument','ZHort',
            'ZSichel','ZBeil','ZMW','ZKeform','Zkeverz']
en_short = {'ZAxtSchwert':'HatchetSword','ZDolch':'Dagger','Zhausgr':'HouseSize',
            'ZCU_AU':'CopperGold','Zamber':'Amber','ZMonument':'MonumentCount',
            'ZHort':'Depot','ZSichel':'Sickle','ZBeil':'AxesCelts','ZMW':'MonumentSize',
            'ZKeform':'PotteryForm','Zkeverz':'PotteryDecoration'}
cap[num_cols] = cap[num_cols].apply(pd.to_numeric)
X = cap[num_cols].to_numpy(dtype=float)
bce = cap['BCE'].to_numpy(dtype=int)
group = cap['group'].to_numpy()

print("capital.csv numeric matrix:", X.shape, "NaN count:", np.isnan(X).sum())
print("BCE rows:", bce.tolist())

# corrected capital->variable mapping
cap_groups = {
 'Symbolic':  ['HatchetSword','Dagger','HouseSize'],
 'Social':    ['CopperGold','Amber','MonumentCount'],
 'Cultural':  ['PotteryForm','PotteryDecoration'],
 'Economic':  ['Depot','Sickle','AxesCelts','MonumentSize'],
}
col2idx = {en_short[c]: i for i,c in enumerate(num_cols)}

# ---------- helpers ----------
def pca_corr(M):
    """PCA on correlation matrix (center+scale columns). Returns loadings (p x k),
    scores (n x k), explained variance ratio."""
    n, p = M.shape
    Mc = M - M.mean(axis=0)
    std = M.std(axis=0, ddof=1)
    Zs = Mc / std
    U, S, Vt = np.linalg.svd(Zs, full_matrices=False)
    scores = U * S                     # scores = Zs @ V
    loadings = Vt.T                    # columns are loadings of each PC
    ev = (S**2) / (n - 1)
    evr = ev / ev.sum()
    return loadings, scores, evr

def orient(loadings, scores, colnames, dom_idx=0, sign_of_dom=1.0):
    """Fix sign convention: make the chosen dominant variable's loading positive."""
    if loadings[dom_idx, 0] * sign_of_dom < 0:
        loadings[:, 0] *= -1
        scores[:, 0] *= -1
    return loadings, scores

def phase_stats(pc1, bce, phase_bces, name):
    m = np.isin(bce, phase_bces)
    vals = pc1[m]
    b = bce[m].astype(float)
    slope, intercept = np.polyfit(b, vals, 1)   # slope per 1 BCE unit (i.e., per year)
    return dict(name=name, n=len(vals), mean=vals.mean(), std=vals.std(ddof=1),
                min=vals.min(), max=vals.max(), first=vals[0], last=vals[-1],
                first_last_diff=vals[-1]-vals[0], slope_per_100y=slope*100,
                r2=np.corrcoef(b, vals)[0,1]**2 if vals.std()>0 else np.nan,
                frac_pos=(vals>0).mean(), frac_neg=(vals<0).mean())

MN = np.array([b for b in [3400,3300,3200,3100,3000] if b in bce])
YN = np.array([b for b in range(2900,2299,-100) if b in bce])
print("\nPhase slices  MN:", MN.tolist(), " YN:", YN.tolist())

# ---------- 2. Overall PCA on all 12 variables ----------
names_all = [en_short[c] for c in num_cols]
load_all, scores_all, evr_all = pca_corr(X)
# orient so largest-|loading| variable is positive
dom = int(np.argmax(np.abs(load_all[:,0])))
load_all, scores_all = orient(load_all, scores_all, names_all, dom_idx=dom)
pc1_all = scores_all[:, 0]

print("\n=== OVERALL PCA (12 variables) ===")
print("Explained variance ratio:", np.round(evr_all[:3],4), "PC1 EVR=%.4f" % evr_all[0])
order = np.argsort(-np.abs(load_all[:,0]))
print("PC1 loadings (oriented, largest-|loading| var = %s > 0):" % names_all[dom])
for i in order:
    print(f"  {names_all[i]:16s} {load_all[i,0]:+.4f}")

# ---------- 3. Per-capital PCA ----------
print("\n=== PER-CAPITAL PCA (corrected mapping) ===")
pc_scores = {}
pc_loads = {}
for gname, vnames in cap_groups.items():
    idx = [col2idx[v] for v in vnames]
    Mg = X[:, idx]
    Lg, Sg, evg = pca_corr(Mg)
    domg = int(np.argmax(np.abs(Lg[:,0])))
    Lg, Sg = orient(Lg, Sg, vnames, dom_idx=domg)
    pc_scores[gname] = Sg[:,0]
    pc_loads[gname] = (Lg[:,0], vnames)
    print(f"\n{gname} capital (n={len(vnames)}): PC1 EVR=%.4f" % evg[0])
    for i in np.argsort(-np.abs(Lg[:,0])):
        print(f"   {vnames[i]:16s} {Lg[i,0]:+.4f}")

# ---------- 4. Phase characterization ----------
print("\n=== PHASE CHARACTERIZATION ===")
full_mean_all = pc1_all.mean()
rows = []
for gname in [None] + list(cap_groups.keys()):
    series = pc1_all if gname is None else pc_scores[gname]
    label = "Overall PC1" if gname is None else f"{gname} PC1"
    for ph in ['MN','YN']:
        pb = MN if ph=='MN' else YN
        rows.append(phase_stats(series, bce, pb, f"{label} | {ph}"))
    full = phase_stats(series, bce, bce, f"{label} | FULL")
    rows.append(full)

tbl = pd.DataFrame(rows)
print(tbl.to_string(index=False))

# ---------- 5. Dominant loading var per series ----------
print("\n=== PC1 sign convention / dominant loadings ===")
def dom_var(loads, names):
    i = int(np.argmax(np.abs(loads)))
    return names[i], float(loads[i])
dv, lv = dom_var(load_all[:,0], names_all)
print(f"Overall PC1 dominant: {dv} (loading {lv:+.3f}); PC1 score at full-series mean = {pc1_all.mean():.3f}")
for gname in cap_groups:
    Lg, vnames = pc_loads[gname]
    dv, lv = dom_var(Lg, vnames)
    print(f"{gname} PC1 dominant: {dv} (loading {lv:+.3f})")

# ---------- 6. Save evidence ----------
out = pd.DataFrame({'BCE': bce, 'group': group,
                    'Overall_PC1': pc1_all,
                    **{f'{g}_PC1': pc_scores[g] for g in cap_groups}})
out.to_csv('phase_pc1_evidence.csv', index=False)
print("\nSaved phase_pc1_evidence.csv; rows:", out.shape)
