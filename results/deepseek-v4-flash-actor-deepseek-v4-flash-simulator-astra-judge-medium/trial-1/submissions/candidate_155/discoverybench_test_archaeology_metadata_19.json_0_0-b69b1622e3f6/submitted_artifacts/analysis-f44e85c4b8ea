"""
Formal analysis for 'PC1 of forms of capital in hundred-year time slices,
YBA 1100 BCE vs 1000-500 BCE'.
Joint PCA (SVD) on the 12 capital Z-variables across all 39 century slices
in capital.csv. Comparison metrics + robustness (YBA-only PCA).
"""
import pandas as pd
import numpy as np
from scipy.linalg import svd

# ----------------------------------------------------------------------
# 1. Load capital.csv (European decimal comma)
# ----------------------------------------------------------------------
cap = pd.read_csv("data/capital.csv", sep=",", decimal=",")
VARS = ['ZAxtSchwert','ZDolch','Zhausgr','ZCU_AU','Zamber','ZMonument',
        'ZHort','ZSichel','ZBeil','ZMW','ZKeform','Zkeverz']
X = cap[VARS].values.astype(float)
yrs = cap['BCE'].values.astype(int)

# ----------------------------------------------------------------------
# 2. Verification: capital.csv Z == raw Z at century points in time_series_data.csv
# ----------------------------------------------------------------------
ts = pd.read_csv("data/time_series_data.csv")
raw_map = {'ZAxtSchwert':'HatchetSword','ZDolch':'Dagger','Zhausgr':'HouseSize','ZCU_AU':'CopperGold',
           'Zamber':'Amber','ZMonument':'MonumentCount','ZHort':'Depot','ZSichel':'Sickle','ZBeil':'AxesCelts',
           'ZMW':'MonumentSize','ZKeform':'PotteryForm','Zkeverz':'PotteryDecoration'}
maxdiff = 0.0
for k,v in raw_map.items():
    for _,r in cap.iterrows():
        sub = ts[ts['CE'] == -int(r['BCE'])]
        if len(sub):
            maxdiff = max(maxdiff, float(abs(sub[v].iloc[0] - r[k])))
print("VERIFY: max |capital.csv Z - time_series raw Z| at century points =", maxdiff)

# ----------------------------------------------------------------------
# 3. PCA (centered, not re-scaled; SVD)
# ----------------------------------------------------------------------
def run_pca(Xm):
    Xc = Xm - Xm.mean(axis=0)
    U, S, Vt = svd(Xc, full_matrices=False)
    scores = U * S                       # columns = PCs
    loadings = Vt.T                      # columns = PCs
    evr = S**2 / (S**2).sum()
    return scores, loadings, evr

def fix_sign(loadings, scores, anchor_var, positive=True):
    """Fix PC1 sign so anchor variable loading is positive."""
    s = np.sign(loadings[VARS.index(anchor_var), 0])
    if (s > 0) != positive:
        loadings[:,0] *= -1
        scores[:,0]  *= -1
    return loadings, scores

# --- MAIN ANALYSIS: joint PCA across all 39 slices ---
scA, loA, evA = run_pca(X)
loA, scA = fix_sign(loA, scA, 'ZCU_AU')     # economic wealth anchor positive
pc1_A = scA[:,0]
evr1_A = evA[0]

# --- ROBUSTNESS: PCA within YBA (1100-500 BCE), drop zero-variance vars ---
mask_yba = (yrs >= 500) & (yrs <= 1100)
Xy = X[mask_yba]
keep = ~np.all(Xy == Xy[0], axis=0)
dropped = [VARS[i] for i in range(12) if not keep[i]]
scB, loB, evB = run_pca(Xy[:, keep])
# anchor on the most-loaded economic var available within YBA (ZHort or ZCU_AU)
vkeep = [VARS[i] for i in range(12) if keep[i]]
anchorB = vkeep[int(np.argmax(np.abs(loB[:,0])))]
sgn = np.sign(loB[np.argmax(np.abs(loB[:,0])),0])
if sgn < 0:
    loB[:,0] *= -1; scB[:,0] *= -1
pc1_B = scB[:,0]
evr1_B = evB[0]

# ----------------------------------------------------------------------
# 4. Extract YBA values + comparison metrics (MAIN analysis)
# ----------------------------------------------------------------------
yba_years = [1100,1000,900,800,700,600,500]
pc1_at = {y: float(pc1_A[yrs==y][0]) for y in yba_years}
p1100 = pc1_at[1100]
sub_years = yba_years[1:]                      # 1000-500
sub_vals  = np.array([pc1_at[y] for y in sub_years])
mean_sub = sub_vals.mean()
diff_1100 = p1100 - mean_sub

# (a) difference
# (b) relative comparison: 1100 vs each of the 6 points
# (c) trend 1000->500: linear slope (per century) and point-to-point changes
slope = float(np.polyfit(sub_years, sub_vals, 1)[0])
pt_changes = np.diff(sub_vals)                 # 1000->900, 900->800, ...

# percentile of 1100 within full-series PC1 and within YBA PC1
pc1_full_sorted = np.sort(pc1_A)
pct_full = (pc1_full_sorted < p1100).mean()*100
yba_pc1 = pc1_A[mask_yba]
pct_yba  = (np.sort(yba_pc1) < p1100).mean()*100
z_full = (p1100 - pc1_A.mean())/pc1_A.std(ddof=0)
z_yba  = (p1100 - yba_pc1.mean())/yba_pc1.std(ddof=0)

# ----------------------------------------------------------------------
# 5. Print results
# ----------------------------------------------------------------------
print("\n" + "="*72)
print("MAIN ANALYSIS: joint PCA on 12 capital vars, 39 century slices (4300-500 BCE)")
print("="*72)
print("PC1 explained variance share : %.1f%%  (PC2 %.1f%%, PC3 %.1f%%)"
      % (100*evr1_A, 100*evA[1], 100*evA[2]))
print("PC1 loadings (sign fixed: ZCU_AU positive):")
order = np.argsort(-np.abs(loA[:,0]))
for i in order:
    print("   %-14s %+ .3f" % (VARS[i], loA[i,0]))

print("\nPC1 at YBA century slices (full-series PCA):")
for y in yba_years:
    tag = "  <-- beginning of YBA" if y==1100 else ""
    print("   %4d BCE : %+7.3f%s" % (y, pc1_at[y], tag))
print("\nComparison metrics:")
print("   mean(1000-500)                : %+.3f" % mean_sub)
print("   difference 1100 - mean(1000-500): %+.3f" % diff_1100)
print("   1100 vs each 1000-500 point (1100 - point):")
for y in sub_years:
    print("     vs %4d BCE : %+.3f" % (y, p1100 - pc1_at[y]))
print("   linear slope 1000->500 (PC1 per century): %+.3f" % slope)
print("   point-to-point changes 1000->900,900->800,800->700,700->600,600->500:",
      ["%+.2f"%c for c in pt_changes])
print("\nRelative position of 1100 BCE:")
print("   percentile within full-series PC1 : %.1f%%" % pct_full)
print("   percentile within YBA PC1         : %.1f%%" % pct_yba)
print("   z within full series : %+.2f ; z within YBA : %+.2f" % (z_full, z_yba))

# ----------------------------------------------------------------------
# 6. Robustness printout
# ----------------------------------------------------------------------
print("\n" + "="*72)
print("ROBUSTNESS: PCA within YBA only (%d slices), dropped zero-variance: %s"
      % (mask_yba.sum(), dropped))
print("="*72)
print("PC1 explained variance share : %.1f%%" % (100*evr1_B))
print("PC1 loadings (sign fixed):")
ordB = np.argsort(-np.abs(loB[:,0]))
for i in ordB:
    print("   %-14s %+ .3f" % (vkeep[i], loB[i,0]))
print("PC1 at YBA slices (within-YBA PCA):")
for i,y in enumerate(yba_years):
    print("   %4d BCE : %+7.3f%s" % (y, float(pc1_B[i]), "  <-- beginning" if y==1100 else ""))
print("   mean(1000-500) : %+.3f ; diff 1100 - mean : %+.3f"
      % (float(pc1_B[1:].mean()), float(pc1_B[0]-pc1_B[1:].mean())))
print("\nDirectional agreement (1100 > all 1000-500 points):",
      "YES" if all(pc1_B[0] > pc1_B[i] for i in range(1,7)) else "NO")
