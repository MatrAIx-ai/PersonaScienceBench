"""
PCA on forms of capital in hundred-year time slices (capital.csv).
Question: how are symbolic capital components (Zhausgr=house size,
ZDolch=dagger, ZAxtSchwert=hatchet/sword) characterized in terms of
their values on PC1 and distribution across PC2?

Analysis steps
--------------
1. Load capital.csv (comma decimals). 39 rows = one row per century,
   BCE 4300 -> 500 BCE (hundred-year time slices).
2. Drop BCE, group, color (grouped-plotting columns dropped after loading).
   Keep the 12 capital Z-variables (already Z-normalized, mean~0 sd~1).
3. PCA by SVD on the standardized 39x12 matrix (= correlation-based PCA
   since columns are already z-scored; re-standardization is a near no-op).
4. Read off symbolic-capital loadings on PC1 ("value on PC1") and PC2
   ("distribution across PC2", primary metric = |PC2 loading|).
   Cross-check metric = std/range of each variable's z-scores projected
   onto the PC2 axis across the 39 centuries.
5. Robustness: repeat PCA excluding ZSichel (atypical sd=0.54).
6. Sign invariance: PC signs are arbitrary; relative characterizations
   (moderate vs near-zero loadings) are unchanged under sign flip.
"""

import numpy as np
import pandas as pd

pd.set_option('display.width', 200)

# ----------------------------------------------------------------------
# 1-2. Load and clean capital.csv
# ----------------------------------------------------------------------
cap = pd.read_csv('data/capital.csv', decimal=',')
print("capital.csv shape (rows x cols):", cap.shape)
print("BCE values (the hundred-year slices):", cap['BCE'].tolist())

ZCOLS = ['ZAxtSchwert','ZDolch','Zhausgr','ZCU_AU','Zamber','ZMonument',
         'ZHort','ZSichel','ZBeil','ZMW','ZKeform','Zkeverz']

X_raw = cap[ZCOLS].values.astype(float)
print("\nPer-column mean / std (check pre-standardization):")
print(cap[ZCOLS].agg(['mean','std']).T.round(3).to_string())
print("Missing values:", np.isnan(X_raw).sum())

def pca_fit(X):
    """Center+scale columns (no-op given z-scores) and run PCA via SVD."""
    mu = X.mean(axis=0)
    sd = X.std(axis=0)
    Xc = (X - mu) / sd
    n = Xc.shape[0]
    U, S, Vt = np.linalg.svd(Xc, full_matrices=False)
    scores = U * S                      # PC scores  (n x p)
    loadings = Vt.T                     # loadings   (p x p)
    # explained variance ratio of each PC (on the standardized total variance = p)
    evr = (S**2) / (n - 1) / Xc.shape[1]
    return scores, loadings, evr, mu, sd

# ----------------------------------------------------------------------
# 3. Main PCA on all 12 capital variables
# ----------------------------------------------------------------------
scores, loadings, evr, mu, sd = pca_fit(X_raw)
ncomp = len(evr)

print("\n===== MAIN PCA: 12 capital variables, 39 hundred-year slices =====")
print("Explained variance ratio (first 6 PCs):")
for i in range(min(6, ncomp)):
    print(f"  PC{i+1}: {evr[i]:.4f}  (cumulative {evr[:i+1].sum():.4f})")

ldf = pd.DataFrame(loadings, index=ZCOLS,
                   columns=[f'PC{i+1}' for i in range(ncomp)])
print("\nLoadings, all 12 variables (PC1-PC6):")
print(ldf.round(3).to_string())

# ----------------------------------------------------------------------
# 4. Symbolic capital characterization
# ----------------------------------------------------------------------
SYMBOLIC = ['Zhausgr', 'ZDolch', 'ZAxtSchwert']  # house size, dagger, hatchet/sword

print("\n===== SYMBOLIC CAPITAL: value on PC1 and distribution across PC2 =====")
sym = ldf.loc[SYMBOLIC, ['PC1','PC2']].round(4)
sym['abs_PC2_loading'] = sym['PC2'].abs()
print(sym.to_string())

# Cross-check metric: spread of each variable's z-scores projected onto PC2 axis
# projected coords = (variable z-vector) dot (PC2 loading vector)  -> equivalent to
# the column's contribution to PC2; use std and range across the 39 centuries
zmat = (X_raw - mu) / sd
pc2_axis = loadings[:, 1]  # unit vector of PC2 in variable space
proj = zmat @ pc2_axis      # (39,) coordinate of each century along PC2
# for each variable, its projected spread along PC2 = its loading * (variable std=1),
# i.e., the loading itself; the cross-check is the std/range of each variable's
# z-values weighted by the PC2 axis, equivalent to |loading| metric at PC level.
# More directly: variable-specific contribution = cov(variable, PC2-score)/var(PC2-score)
scores_df = pd.DataFrame(scores[:, :3],
                         columns=['PC1','PC2','PC3'],
                         index=cap['BCE'])
scores_df.index.name = 'BCE_century'

print("\nPC scores by century (PC1, PC2) - the century path in PC space:")
print(scores_df.round(3).to_string())

# Variable spread along PC2 via correlation of each variable with PC2 score
# (== loading up to normalization), plus std/range of the variable in PC2 direction
corr_pc2 = pd.Series(
    [np.corrcoef(zmat[:, j], scores[:, 1])[0, 1] for j in range(zmat.shape[1])],
    index=ZCOLS, name='corr_with_PC2')
print("\nCross-check: correlation of each variable with PC2 score "
      "(= signed loading):")
print(corr_pc2.round(3).to_string())

# Range/std of the 39 century-level PC2 scores (context for 'distribution')
print("\nPC2 score spread across 39 centuries: "
      f"std={scores[:,1].std():.3f}, min={scores[:,1].min():.3f}, "
      f"max={scores[:,1].max():.3f}, range={scores[:,1].max()-scores[:,1].min():.3f}")

# ----------------------------------------------------------------------
# 5. Robustness: PCA without ZSichel (atypical sd 0.54)
# ----------------------------------------------------------------------
print("\n===== ROBUSTNESS: PCA excluding ZSichel =====")
ZCOLS_rob = [c for c in ZCOLS if c != 'ZSichel']
scores_r, loadings_r, evr_r, mu_r, sd_r = pca_fit(X_raw[:, [ZCOLS.index(c) for c in ZCOLS_rob]])
print("Explained variance ratio: PC1={:.4f}, PC2={:.4f}".format(evr_r[0], evr_r[1]))
ldf_r = pd.DataFrame(loadings_r, index=ZCOLS_rob, columns=[f'PC{i+1}' for i in range(len(evr_r))])
print("Symbolic-capital loadings (no ZSichel):")
print(ldf_r.loc[SYMBOLIC, ['PC1','PC2']].round(4).to_string())

# ----------------------------------------------------------------------
# 6. Save reproducible outputs
# ----------------------------------------------------------------------
ldf.round(5).to_csv('output_loadings.csv')
scores_df.round(5).to_csv('output_pcscores.csv')
pd.DataFrame({'variable': ZCOLS, 'PC1': loadings[:,0], 'PC2': loadings[:,1],
              'abs_PC2': np.abs(loadings[:,1])}).round(5).to_csv('output_summary.csv', index=False)

print("\nSaved: output_loadings.csv, output_pcscores.csv, output_summary.csv")
