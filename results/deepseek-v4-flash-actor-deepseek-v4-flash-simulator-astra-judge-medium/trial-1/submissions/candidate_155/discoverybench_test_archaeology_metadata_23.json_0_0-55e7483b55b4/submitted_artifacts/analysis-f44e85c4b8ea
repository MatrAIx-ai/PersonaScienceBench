"""DiscoveryBench archaeology metadata_23 -- formal analysis (3400-3000 BCE).
Units: capital.csv 100-yr raw knots (n=5). Symbolic capital = ZAxtSchwert, ZDolch, Zhausgr.
Interpolated (_inter) series used ONLY for trajectory visualization, not inference.
"""
import pandas as pd, numpy as np
from scipy.stats import spearmanr, kendalltau

cap = pd.read_csv('data/capital.csv')
for c in cap.columns[3:]:
    cap[c] = cap[c].map(lambda x: float(str(x).replace(',', '.')))

ts = pd.read_csv('data/time_series_data.csv')

bce = [3400, 3300, 3200, 3100, 3000]
knots = cap[cap['BCE'].isin(bce)].sort_values('BCE').reset_index(drop=True)
Z = {c: {b: knots.loc[knots.BCE == b, c].iloc[0] for b in bce} for c in cap.columns[3:]}

print("=" * 70)
print("WINDOW 3400-3000 BCE: Z-values at 5 knots")
print("=" * 70)
rows = []
for c, name in [('ZMonument','MonumentCount'), ('ZBeil','AxesCelts'), ('ZAxtSchwert','HatchetSword'),
                ('ZDolch','Dagger'), ('Zhausgr','HouseSize'), ('ZCU_AU','CopperGold'),
                ('Zamber','Amber'), ('ZMW','MonumentSize'), ('ZHort','Depot'),
                ('ZKeform','PotteryForm'), ('Zkeverz','PotteryDecoration')]:
    vals = [round(Z[c][b], 3) for b in bce]
    rows.append([name, c] + vals)
df = pd.DataFrame(rows, columns=['var', 'col'] + [f'{b}BCE' for b in bce])
print(df.to_string(index=False))

print("\n" + "=" * 70)
print("NET CHANGE  dZ = Z(3000 BCE) - Z(3400 BCE)  and PEAK TIMING")
print("=" * 70)
res = []
for c, name in [('ZMonument','MonumentCount'), ('ZBeil','AxesCelts'), ('ZAxtSchwert','HatchetSword'),
                ('ZDolch','Dagger'), ('Zhausgr','HouseSize'), ('ZCU_AU','CopperGold'),
                ('Zamber','Amber'), ('ZMW','MonumentSize'), ('ZHort','Depot'),
                ('ZKeform','PotteryForm'), ('Zkeverz','PotteryDecoration')]:
    vals = np.array([Z[c][b] for b in bce])
    peak_idx = int(np.argmax(vals)); trough_idx = int(np.argmin(vals))
    res.append({'var': name, 'start': vals[0], 'end': vals[-1], 'dZ': vals[-1]-vals[0],
                'peak': vals[peak_idx], 'peak_BCE': bce[peak_idx],
                'trough': vals[trough_idx], 'trough_BCE': bce[trough_idx]})
rdf = pd.DataFrame(res).round(3)
print(rdf.to_string(index=False))

print("\n" + "=" * 70)
print("100-YEAR SEGMENT CHANGES (delta per century)")
print("=" * 70)
seg = [f'{bce[i]}->{bce[i+1]}' for i in range(4)]
seg_rows = []
for c, name in [('ZMonument','MonumentCount'), ('ZBeil','AxesCelts'), ('ZAxtSchwert','HatchetSword'),
                ('ZDolch','Dagger'), ('Zhausgr','HouseSize')]:
    vals = np.array([Z[c][b] for b in bce])
    seg_rows.append([name] + [round(vals[i+1]-vals[i], 3) for i in range(4)])
print(pd.DataFrame(seg_rows, columns=['var']+seg).to_string(index=False))

print("\n" + "=" * 70)
print("RANK CORRELATION at knots (n=5; Spearman / Kendall tau) -- descriptive only")
print("=" * 70)
sym_el = {'ZMonument': 'MonumentCount', 'ZBeil': 'AxesCelts', 'ZAxtSchwert': 'HatchetSword',
          'ZDolch': 'Dagger', 'Zhausgr': 'HouseSize'}
pairs = [('ZMonument','ZBeil'), ('ZMonument','ZAxtSchwert'), ('ZMonument','ZDolch'),
         ('ZMonument','Zhausgr'), ('ZBeil','ZAxtSchwert'), ('ZBeil','ZDolch'), ('ZBeil','Zhausgr'),
         ('ZAxtSchwert','Zhausgr'), ('ZDolch','Zhausgr')]
cor = []
for a, b in pairs:
    va = np.array([Z[a][x] for x in bce]); vb = np.array([Z[b][x] for x in bce])
    rho = spearmanr(va, vb).statistic if (va.std()>0 and vb.std()>0) else np.nan
    tau = kendalltau(va, vb).statistic if (va.std()>0 and vb.std()>0) else np.nan
    # note: nan may occur but with constant series scipy returns nan
    cor.append({'A': sym_el[a], 'B': sym_el[b], 'spearman': round(rho, 3) if rho==rho else 'NA',
                'kendall': round(tau, 3) if tau==tau else 'NA'})
print(pd.DataFrame(cor).to_string(index=False))

print("\n" + "=" * 70)
print("SENSITIVITY: reading 'axes' as HatchetSword (ZAxtSchwert) instead of ZBeil")
print("=" * 70)
beil = np.array([Z['ZBeil'][b] for b in bce])
axt = np.array([Z['ZAxtSchwert'][b] for b in bce])
mon = np.array([Z['ZMonument'][b] for b in bce])
print(f"ZBeil dZ={beil[-1]-beil[0]:+.3f}, peak={bce[np.argmax(beil)]}; "
      f"ZMonument dZ={mon[-1]-mon[0]:+.3f}, peak={bce[np.argmax(mon)]}")
print(f"ZAxtSchwert dZ={axt[-1]-axt[0]:+.3f}, peak={bce[np.argmax(axt)]} (flat within window)")
print(f"Spearman(ZMonument,ZBeil)={spearmanr(mon,beil).statistic:.3f}; "
      f"Spearman(ZMonument,ZAxtSchwert)={spearmanr(mon,axt).statistic:.3f}")

# ---- trajectory export using _inter (visualization aid only, CSV output) ----
import csv
win_ts = ts[(ts.CE >= -3400) & (ts.CE <= -3000)].copy()
cols = ['MonumentCount_inter','AxesCelts_inter','HatchetSword_inter','Dagger_inter','HouseSize_inter']
out = pd.DataFrame({'CE': win_ts.CE, 'calBP': win_ts.calBP,
                    **{c: win_ts[c].values for c in cols}})
out['BCE'] = -out.CE
out.to_csv('analysis/window_trajectories_inter.csv', index=False)
print("\ntrajectory CSV saved: analysis/window_trajectories_inter.csv "
      f"{len(out)} rows x {out.shape[1]} cols (interpolated, visualization only)")
# compact yearly shape for Monument & Axes at 50-yr steps
sub = out[(out.BCE % 50) == 0]
print(sub[['BCE','MonumentCount_inter','AxesCelts_inter']].round(3).to_string(index=False))
print("\nDONE")
