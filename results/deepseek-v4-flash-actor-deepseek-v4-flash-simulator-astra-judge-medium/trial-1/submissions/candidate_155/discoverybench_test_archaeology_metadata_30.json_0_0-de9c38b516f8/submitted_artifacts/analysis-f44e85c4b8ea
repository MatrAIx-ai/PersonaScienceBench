"""
DiscoveryBench — archaeology / Cultural Capital (domain_knowledge.1)
Question: "In which century do Diversity in Pottery Decoration and Diversity in
Pottery Form show opposite growth trends for the first time, with Pottery
Decoration increasing significantly and Pottery Form declining simultaneously?"

Approved method:
  1. Primary series: raw 100-year anchors from capital.csv (BCE 4300 -> 500),
     read with comma decimal separator (decimal=',').
  2. Growth trend of each series = sign of the first difference between
     consecutive 100-yr bins (chronological, from most ancient to most recent).
  3. Target bin = the SAME bin where Decoration change > 0 AND Form change < 0.
  4. "First time" = earliest in absolute time (scan from 4300 BCE forward).
  5. Cross-checks: (a) capital.csv anchors vs time_series_data.csv raw anchors;
     (b) interpolated 1-yr series sign consistency; (c) magnitude thresholds.
"""
import pandas as pd
import numpy as np

# ---------------- data loading ----------------
cap = pd.read_csv('data/capital.csv', sep=',', decimal=',', thousands='.')
ts  = pd.read_csv('data/time_series_data.csv', index_col=0)
print("capital.csv:", cap.shape, "| time_series_data.csv:", ts.shape)

d = cap[['BCE', 'ZKeform', 'Zkeverz']].copy()           # ZKeform = Pottery Form, Zkeverz = Pottery Decoration
assert (np.diff(d['BCE'].to_numpy()) == -100).all() and d['BCE'].is_unique

# ---------------- cross-file consistency ----------------
ts_raw = ts.loc[ts['PotteryForm'].notna(), ['CE', 'PotteryForm', 'PotteryDecoration']].copy()
ts_raw['BCE'] = -ts_raw['CE']
m = d.merge(ts_raw[['BCE', 'PotteryForm', 'PotteryDecoration']], on='BCE', how='left')
valid = m['PotteryForm'].notna()
agree = pd.Series(np.isclose(m['ZKeform'], m['PotteryForm'], atol=1e-6) &
                  np.isclose(m['Zkeverz'], m['PotteryDecoration'], atol=1e-6), index=m.index)[valid]
print(f"Cross-file anchor agreement: {agree.sum()}/{len(agree)} overlapping anchors identical")

# ---------------- growth trends (chronological first difference) ----------------
d['dForm'] = d['ZKeform'].shift(-1) - d['ZKeform']      # change during the century that starts at this BCE year
d['dDec']  = d['Zkeverz'].shift(-1) - d['Zkeverz']
d['target'] = (d['dForm'] < 0) & (d['dDec'] > 0)        # Form declines & Decoration increases in SAME bin
print("\n--- All 100-yr transitions (chronological) ---")
print(d[['BCE', 'ZKeform', 'dForm', 'Zkeverz', 'dDec', 'target']].to_string())

hits = d[d['target'].fillna(False)]
print(f"\nBins with Pottery Form declining & Pottery Decoration increasing: {len(hits)} (unique in whole series)")
first = hits.iloc[0]
bce0, bce1 = int(first['BCE']), int(first['BCE'] - 100)
print(f"FIRST qualifying century: {bce0}--{bce1} BCE  =  {bce0//100}th century BCE")
print(f"  Pottery Form Z       : {first['ZKeform']:.2f} -> {first['ZKeform']+first['dForm']:.2f}  (Delta = {first['dForm']:+.2f})")
print(f"  Pottery Decoration Z : {first['Zkeverz']:.2f} -> {first['Zkeverz']+first['dDec']:.2f}  (Delta = {first['dDec']:+.2f})")

# ---------------- robustness - magnitude thresholds ----------------
print("\n--- Robustness: first qualifying century vs |Delta| threshold ---")
for thr in [0.0, 0.2, 0.5, 1.0, 1.2]:
    h = d[(d['dForm'] < 0) & (d['dDec'] > 0) & (d['dForm'].abs() >= thr) & (d['dDec'].abs() >= thr)]
    if len(h):
        print(f"  |d|>={thr}: {int(h.iloc[0]['BCE'])}--{int(h.iloc[0]['BCE']-100)} BCE "
              f"(Form {h.iloc[0]['dForm']:+.2f}, Dec {h.iloc[0]['dDec']:+.2f})")
    else:
        print(f"  |d|>={thr}: none")

# ---------------- cross-check - interpolated 1-yr series ----------------
print("\n--- Interpolated 1-yr series sign checks ---")
sub = ts[(ts['CE'] >= -1800) & (ts['CE'] <= -1700)].reset_index(drop=True)
aF = sub['PotteryForm_inter'].diff(); aD = sub['PotteryDecoration_inter'].diff()
inner = sub.iloc[1:]
print(f"  Within 1800-1700 BCE: annual dForm<0 for {int((aF.iloc[1:]<0).sum())}/{len(inner)} years; "
      f"annual dDec>0 for {int((aD.iloc[1:]>0).sum())}/{len(inner)} years")

tsa = ts[['CE', 'PotteryForm_inter', 'PotteryDecoration_inter']].copy()
opp = tsa[((tsa['PotteryForm_inter'].diff() < 0) & (tsa['PotteryDecoration_inter'].diff() > 0))].dropna()
print(f"  Total 1-yr opposite steps (Form<0 & Dec>0) in whole series: {len(opp)}")
print(f"  Earliest such 1-yr step: CE={int(opp['CE'].iloc[0])} (BCE={-int(opp['CE'].iloc[0])})")

# boundary artifact note: diff at CE=-1800 is tiny positive (two ramp slopes meet)
idx0 = -1800 + 4100
print(f"  Note: at exact anchor CE=-1800 the year-over-year diff is an interpolation artifact "
      f"(dForm={float(ts['PotteryForm_inter'].iloc[idx0]-ts['PotteryForm_inter'].iloc[idx0-1]):+.4f}, "
      f"dDec={float(ts['PotteryDecoration_inter'].iloc[idx0]-ts['PotteryDecoration_inter'].iloc[idx0-1]):+.4f}); "
      f"all real 100-yr transitions after 1800 BCE are monotone down/up.")

print("\nDONE - FIRST OPPOSITE-TREND CENTURY: 18th century BCE (1800-1700 BCE)")
