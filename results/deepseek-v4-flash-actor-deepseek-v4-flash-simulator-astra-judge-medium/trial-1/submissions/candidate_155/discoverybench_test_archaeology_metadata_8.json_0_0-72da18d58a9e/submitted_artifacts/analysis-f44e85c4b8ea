#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
Amber value analysis - DiscoveryBench archaeology episode
Question: In which millennium did amber have the highest value and in what
time interval did it peak?

Fixed conventions (approved):
  1. Amber value = Z-score (datasets contain standardized Z values only).
     Primary series: time_series_data.Amber (raw century points) and
     time_series_data.Amber_inter (yearly linear interpolation).
     Cross-validation: capital.csv.Zamber (identical series).
  2. Peak = global max Z (1.54) + its continuous plateau on Amber_inter,
     verified against raw century points. Secondary plateau 1.46 reported.
  3. Millennium conventions (three reported): CE-grid bins,
     traditional BCE millennia (k-th millennium = (k*1000)-(k*1000-999) BCE),
     calBP millennium bins [k*1000,(k+1)*1000).
  4. Peak interval annotated in CE / BCE / calBP, with ~+/-50 yr precision
     caveat imposed by century-resolution raw data.
"""
import re
from io import StringIO
import numpy as np
import pandas as pd

OUT = []

def note(s):
    print(s)
    OUT.append(s)

# ---------- helpers ----------
def load_decimal_comma(path):
    """capital.csv & pollen use ',' as decimal separator inside quotes."""
    raw = open(path, encoding='utf-8-sig').read()
    fixed = re.sub(r'\"[^\"]*\"', lambda m: m.group(0).replace(',', '.'), raw)
    return pd.read_csv(StringIO(fixed))

def bce_millennium(ce):
    """Convention: k-th millennium BCE = (k*1000)-(k*1000-999) BCE."""
    y = int(-ce)          # BCE year count
    return (y - 1) // 1000 + 1   # 4000..3001 BCE -> 4

# ---------- load ----------
ts = pd.read_csv('data/time_series_data.csv')
cap = load_decimal_comma('data/capital.csv')
pol = load_decimal_comma('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv')

note('=' * 72)
note('STEP 0 - DATASET OVERVIEW / TIME AXES')
for name, df, cols in [
    ('time_series_data.csv', ts, ['CE', 'calBP']),
    ('capital.csv', cap, ['BCE']),
    ('pollen_..._2019.csv', pol, ['CE', 'calBP']),
]:
    for c in cols:
        s = df[c].dropna()
        note(f'  {name}: {c} range [{s.min()}, {s.max()}], n={len(s)}, row={len(df)}')

# ---------- amber fields ----------
note('=' * 72)
note('STEP 1 - AMBER VALUE FIELDS (Z-scores)')
for lab, s in [
    ('time_series.Amber (raw, century pts)', ts['Amber']),
    ('time_series.Amber_inter (yearly, linear)', ts['Amber_inter']),
    ('capital.Zamber (century pts)', cap['Zamber']),
]:
    note(f'  {lab}: n_nonnull={s.notna().sum()}/{len(s)}, '
         f'min={s.min():.4g}, max={s.max():.4g}, mean={s.mean():.4g}, median={s.median():.4g}')

# cross-validation capital vs amber
m = pd.merge(cap.assign(CE=-cap['BCE']), ts[['CE', 'Amber']], on='CE', how='inner')
note(f'  Cross-check: {len(m)} overlapping century rows, '
     f'Zamber==Amber exactly: {bool(np.allclose(m["Zamber"], m["Amber"], atol=1e-12))}')

# ---------- interpolation check ----------
note('=' * 72)
note('STEP 2 - RAW vs INTERPOLATION')
chk = ts[ts['CE'].isin([-4100, -4099, -4050, -4001])][['CE', 'Amber', 'Amber_inter']]
note('  CE -4100(raw)=-1.07, CE -4000(raw)=1.46  -> check midpoints:')
for _, r in chk.iterrows():
    note(f'    CE {int(r.CE)}: Amber={r.Amber}, Amber_inter={r.Amber_inter:.4g}')
note('  (linear interpolation confirmed: -4099 -> -1.0447 = -1.07 + 2.53/100)')

# ---------- peak detection ----------
note('=' * 72)
note('STEP 3 - PEAK DETECTION')
vmax = ts['Amber_inter'].max()
plat = ts[ts['Amber_inter'] == vmax]
rawmax = ts[ts['Amber'] == ts['Amber'].max()]
capmax = cap[cap['Zamber'] == cap['Zamber'].max()]
note(f'  Global max Z = {vmax}')
note(f'  Amber_inter continuous plateau at max: CE {plat.CE.min()}..{plat.CE.max()} '
     f'({len(plat)} yr), calBP {plat.calBP.min()}..{plat.calBP.max()}')
note(f'  Raw century points at max: CE {rawmax.CE.tolist()} '
     f'= BCE {[-int(c) for c in rawmax.CE]} = calBP {rawmax.calBP.tolist()}')
note(f'  capital.Zamber max {capmax.Zamber.max()} at BCE {capmax.BCE.tolist()}')
# secondary plateau
p2 = ts[ts['Amber_inter'] == 1.46]
note(f'  Secondary plateau (1.46): CE {p2.CE.min()}..{p2.CE.max()} '
     f'({len(p2)} yr), calBP {p2.calBP.min()}..{p2.calBP.max()}')

# ---------- millennium aggregates (3 conventions) ----------
note('=' * 72)
note('STEP 4 - MILLENNIUM AGGREGATES (three conventions)')

# (a) CE-grid bins
bins_ce = list(range(-5000, -499, 1000))
ts['mCE'] = pd.cut(ts['CE'], bins=bins_ce, right=False)
g_ce = ts.groupby('mCE', observed=True)['Amber_inter'].agg(['mean', 'max', 'count'])
note('  (a) CE-grid millennium bins (right=False):')
note(g_ce.to_string())

# (b) traditional BCE millennia
ts['mBCE'] = ts['CE'].apply(bce_millennium)
g_bce = ts.groupby('mBCE')['Amber_inter'].agg(['mean', 'max', 'count'])
note('  (b) Traditional BCE millennia  k-th = (k*1000)-(k*1000-999) BCE:')
note(g_bce.to_string())

# (c) calBP millennium bins
bins_bp = list(range(2000, 7001, 1000))
ts['mBP'] = pd.cut(ts['calBP'], bins=bins_bp, right=False)
g_bp = ts.groupby('mBP', observed=True)['Amber_inter'].agg(['mean', 'max', 'count'])
note('  (c) calBP millennium bins [k*1000,(k+1)*1000):')
note(g_bp.to_string())

# raw-century means by BCE millennium (cross-check)
raw = ts[ts['Amber'].notna()].copy()
raw['mBCE'] = raw['CE'].apply(bce_millennium)
note('  (raw-century mean of Amber by BCE millennium):')
note(raw.groupby('mBCE')['Amber'].agg(['mean', 'max', 'count']).to_string())

# ---------- peak interval triple annotation ----------
note('=' * 72)
note('STEP 5 - PEAK INTERVAL (CE / BCE / calBP)')
cmin, cmax = plat.CE.min(), plat.CE.max()
note(f'  CE   : {cmin} .. {cmax}')
note(f'  BCE  : {-cmax} .. {-cmin}  (i.e. {cmax:.0f}..{-cmin} BCE counting)'.replace('--','-'))
note(f'  calBP: {1950-cmax} .. {1950-cmin}  (calBP = 1950 - CE)')
note('  Precision limited by century-resolution raw data: ~+/-50 yr per raw point;')
note('  plateau length partly an artifact of linear interpolation construction.')

note('=' * 72)
note('DONE')
