import pandas as pd, numpy as np, json, itertools
from scipy import stats
import statsmodels.api as sm
import statsmodels.formula.api as smf
from statsmodels.stats.multitest import multipletests

# ---------------- Load data ----------------
tt   = pd.read_csv('data/temporal_trends_contingency_table.csv', sep='\t')
suc  = pd.read_csv('data/invasion_success_pathways.csv')
inv  = pd.read_csv('data/invaded_niche_pathways.csv', sep='\t')
assert (inv['n.gard']+inv['n.unint']+inv['n.agfo']==inv['n.total']).all()

res = {}

# ---------------- 1. Temporal trend (background) ----------------
piv = tt.pivot(index='pathway', columns='introduction.period', values='n').reindex(['Gardening','Unintentional','AgriForest'])
res['temporal_trends_pivot'] = piv.to_dict()

# ---------------- Modelling frame (patsy-safe names) ----------------
df = pd.DataFrame({
    'gard': inv['n.gard'], 'unint': inv['n.unint'], 'agfo': inv['n.agfo'], 'total': inv['n.total'],
    'habitat': inv['habitat'], 'elev': inv['elevation'],
    'urban1000': inv['urban.2009.1000m'], 'crop1000': inv['cropland.2009.1000m'],
    'urban50': inv['urban.2009.50m'], 'crop50': inv['cropland.2009.50m'],
})
df['any_gard'] = (df['gard']>0).astype(int)
for c in ['elev','urban1000','crop1000']:
    df['z_'+c] = (df[c]-df[c].mean())/df[c].std()

# ---------------- 2. Per-habitat descriptive ----------------
g = inv.groupby('habitat').agg(
    plots=('n.total','size'),
    plots_with_gard=('n.gard', lambda x:(x>0).sum()),
    plots_with_nonnative=('n.total', lambda x:(x>0).sum()),
    sum_gard=('n.gard','sum'), sum_unint=('n.unint','sum'), sum_agfo=('n.agfo','sum'),
    sum_total=('n.total','sum'), mean_gard=('n.gard','mean'), sd_gard=('n.gard','std'))
g['occupancy_pct'] = 100*g['plots_with_gard']/g['plots']
g['gard_share_of_records_pct'] = 100*g['sum_gard']/g['sum_total']
g['mean_gard_per_nonnative_plot'] = g['sum_gard']/g['plots_with_nonnative']
g = g.sort_values('occupancy_pct', ascending=False)
res['per_habitat'] = g.round(3).to_dict('index')
print('=== Per-habitat (sorted by occupancy) ==='); print(g.round(2).to_string()); print()

# ---------------- 3. Omnibus tests ----------------
tab = pd.crosstab(df['habitat'], df['any_gard'])
chi2, p_chi2, dof, _ = stats.chi2_contingency(tab)
res['presence_chi2'] = {'chi2': round(chi2,3), 'p': float(p_chi2)}
print(f'Chi-square (garden-present x habitat): chi2={chi2:.2f}, df={dof}, p={p_chi2:.2e}')

stat_kw, p_kw = stats.kruskal(*[df.loc[df.habitat==h,'gard'] for h in sorted(df.habitat.unique())])
res['kruskal_gard_by_habitat'] = {'H': round(float(stat_kw),3), 'p': float(p_kw)}
print(f'Kruskal-Wallis gard ~ habitat: H={stat_kw:.2f}, p={p_kw:.2e}'); print()

# ---------------- 4. Logistic presence (ref=Urban) ----------------
base = 'Urban'
df['hab'] = pd.Categorical(df['habitat'], categories=[base]+[h for h in df.habitat.unique() if h!=base])
m1 = smf.glm('any_gard ~ hab', data=df, family=sm.families.Binomial()).fit()
res['logistic_presence_by_habitat'] = {'ref': base,
    'OR': {k: round(float(np.exp(v)),2) for k,v in m1.params.items()},
    'p': {k: round(float(v),4) for k,v in m1.pvalues.items()}}
print('--- Logistic presence ~ habitat (ref=Urban) ---')
for k in m1.params.index: print(f'  {k}: OR={np.exp(m1.params[k]):.2f}, p={m1.pvalues[k]:.4f}')
print()

# ---------------- 5. Multivariate presence ----------------
m2 = smf.glm('any_gard ~ hab + z_elev + z_urban1000 + z_crop1000', data=df,
             family=sm.families.Binomial()).fit()
res['logistic_presence_multivariate'] = {'OR': {k: round(float(np.exp(v)),2) for k,v in m2.params.items()},
    'p': {k: round(float(v),4) for k,v in m2.pvalues.items()}}
m2null = smf.glm('any_gard ~ z_elev + z_urban1000 + z_crop1000', data=df, family=sm.families.Binomial()).fit()
lrt = 2*(m2.llf-m2null.llf); plrt = float(stats.chi2.sf(lrt, 9))
res['lrt_presence_habitat_after_covariates'] = {'LRT': round(float(lrt),3), 'p': plrt}
print('--- Logistic presence multivariate (ref=Urban) ---')
for k in m2.params.index: print(f'  {k}: OR={np.exp(m2.params[k]):.2f}, p={m2.pvalues[k]:.4f}')
print(f'  LRT habitat after covariates: LRT={lrt:.2f}, p={plrt:.2e}'); print()

# ---------------- 6. Compositional dominance via NB(offset log total) ----------------
occ = df[df['total']>0].copy()
occ['logtotal'] = np.log(occ['total'])
pois = smf.glm('gard ~ hab', data=occ, offset=occ['logtotal'], family=sm.families.Poisson()).fit()
mu = pois.predict(occ); y = occ['gard'].values
alpha_est = float(max(((y-mu)**2 - y).sum()/(mu**2).sum(), 0.05))
res['nb_alpha_est'] = round(alpha_est,4)
m4 = smf.glm('gard ~ hab', data=occ, offset=occ['logtotal'],
             family=sm.families.NegativeBinomial(alpha=alpha_est)).fit()
res['nb_offset_share_gard'] = {'alpha': alpha_est,
    'RR': {k: round(float(np.exp(v)),2) for k,v in m4.params.items()},
    'p': {k: round(float(v),4) for k,v in m4.pvalues.items()}}
m4null = smf.glm('gard ~ 1', data=occ, offset=occ['logtotal'],
                 family=sm.families.NegativeBinomial(alpha=alpha_est)).fit()
lrt4 = 2*(m4.llf-m4null.llf); plrt4 = float(stats.chi2.sf(lrt4, 9))
res['lrt_habitat_composition'] = {'LRT': round(float(lrt4),3), 'p': plrt4}
print(f'--- NB offset log(total), alpha={alpha_est:.3f} (ref=Urban) ---')
for k in m4.params.index: print(f'  {k}: RR={np.exp(m4.params[k]):.2f}, p={m4.pvalues[k]:.4f}')
print(f'  LRT habitat (composition): LRT={lrt4:.2f}, p={plrt4:.2e}'); print()

# Multivariate compositional control
m5 = smf.glm('gard ~ hab + z_elev + z_urban1000 + z_crop1000', data=occ, offset=occ['logtotal'],
             family=sm.families.NegativeBinomial(alpha=alpha_est)).fit()
res['nb_offset_multivariate'] = {'RR': {k: round(float(np.exp(v)),2) for k,v in m5.params.items()},
    'p': {k: round(float(v),4) for k,v in m5.pvalues.items()}}
m5null = smf.glm('gard ~ z_elev + z_urban1000 + z_crop1000', data=occ, offset=occ['logtotal'],
                 family=sm.families.NegativeBinomial(alpha=alpha_est)).fit()
lrt5 = 2*(m5.llf-m5null.llf); plrt5 = float(stats.chi2.sf(lrt5, 9))
res['lrt_composition_habitat_after_covariates'] = {'LRT': round(float(lrt5),3), 'p': plrt5}
print('--- NB offset multivariate (ref=Urban) ---')
for k in m5.params.index: print(f'  {k}: RR={np.exp(m5.params[k]):.2f}, p={m5.pvalues[k]:.4f}')
print(f'  LRT habitat after covariates (composition): LRT={lrt5:.2f}, p={plrt5:.2e}'); print()

# ---------------- 7. Pairwise comparisons (Holm-corrected) ----------------
hab = sorted(df.habitat.unique())
pairp = {}
for a,b in itertools.combinations(hab,2):
    sub = df[df.habitat.isin([a,b])]
    t = pd.crosstab(sub.habitat, sub.any_gard)
    _,p = stats.fisher_exact(t.values)
    pairp[(a,b)] = p
_, padj, _, _ = multipletests(list(pairp.values()), method='holm')
res['presence_pairwise_fisher_holm'] = {f'{a} vs {b}': round(float(v),4) for (a,b),v in zip(pairp.keys(), padj)}
print('--- Pairwise Fisher (presence), Holm-corrected p<0.05 ---')
for k,v in res['presence_pairwise_fisher_holm'].items():
    if v<0.05: print(f'  {k}: p_adj={v:.4f}')

pairp2 = {}
for a,b in itertools.combinations(hab,2):
    x = df.loc[df.habitat==a,'gard']; y = df.loc[df.habitat==b,'gard']
    _,p = stats.mannwhitneyu(x, y, alternative='two-sided')
    pairp2[(a,b)] = p
_, padj2, _, _ = multipletests(list(pairp2.values()), method='holm')
res['gard_count_pairwise_mannwhitney_holm'] = {f'{a} vs {b}': round(float(v),4) for (a,b),v in zip(pairp2.keys(), padj2)}
print('--- Pairwise Mann-Whitney (gard counts), Holm-corrected p<0.05 ---')
for k,v in res['gard_count_pairwise_mannwhitney_holm'].items():
    if v<0.05: print(f'  {k}: p_adj={v:.4f}')
print()

# ---------------- 8. Species-level supplementary ----------------
su = suc.groupby('intro.pathway').agg(
    n_species=('Scientific_name','size'),
    mean_inv_plots=('number.of.invaded.plots','mean'),
    sum_inv_plots=('number.of.invaded.plots','sum'),
    mean_aoo=('area.of.occupancy.10km','mean'),
    sum_aoo=('area.of.occupancy.10km','sum'),
    mean_hab_range=('habitat.range','mean'),
    mean_niche=('invaded.niche.breadth','mean'),
    mean_mrt=('mrt','mean')).round(2)
res['species_level_by_pathway'] = su.to_dict('index')
print('=== Species-level (invasion_success) ==='); print(su.to_string()); print()

# ---------------- Save ----------------
with open('analysis_results.json','w') as f:
    json.dump(res, f, indent=2, default=str)
print('saved analysis_results.json')
