import pandas as pd, re, json

out = {}

# 1. temporal trends
tt = pd.read_csv('data/temporal_trends_contingency_table.csv', sep='\t')
out['temporal_trends'] = {str(k):v for k,v in tt.set_index(['introduction.period','pathway'])['n'].items()}
piv = tt.pivot(index='pathway', columns='introduction.period', values='n')
out['temporal_trends_pivot'] = {str(k):v for k,v in piv.to_dict().items()}

# 2. invasion success (species-level)
suc = pd.read_csv('data/invasion_success_pathways.csv')
out['invasion_success_shape'] = suc.shape
out['invasion_success_pathways'] = suc['intro.pathway'].value_counts().to_dict()
out['gardening_metrics_mean'] = suc.groupby('intro.pathway')[['number.of.invaded.plots','area.of.occupancy.10km','habitat.range','invaded.niche.breadth','mrt']].mean().round(2).to_dict()

# 3. invaded niche (plot-level)
inv = pd.read_csv('data/invaded_niche_pathways.csv', sep='\t')
inv['chk'] = inv['n.gard']+inv['n.unint']+inv['n.agfo']
out['row_consistency_ok'] = int((inv['chk']==inv['n.total']).sum())
g = inv.groupby('habitat').agg(
    plots=('n.total','size'),
    plots_with_gard=('n.gard', lambda x:(x>0).sum()),
    sum_gard=('n.gard','sum'),
    sum_total=('n.total','sum'),
    mean_gard=('n.gard','mean'),
    mean_total=('n.total','mean')).reset_index()
g['gard_share_of_records'] = g['sum_gard']/g['sum_total']
g['gard_prevalence_plots'] = g['plots_with_gard']/g['plots']
out['per_habitat'] = g.to_dict('records')

# 4. tree overlap
tree = open('data/phylogenetic_tree.txt').read()
tips = set(re.findall(r'([A-Za-z0-9_\-\.]+):\s*[\d\.]+', tree))
pl = set(suc['phylo.tip.label'].str.strip())
out['tree_tips'] = len(tips)
out['species_with_tips'] = len(pl)
out['overlap'] = len(pl & tips)

with open('exploration_summary.json','w') as f:
    json.dump(out, f, indent=2, default=str)
print('saved exploration_summary.json')
print(piv.to_string())
