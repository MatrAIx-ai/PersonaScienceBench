#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""Analysis for: 'In what context does the gardening pathway for introducing
non-native plants show different prevalence styles across habitat types?'"""
import pandas as pd, numpy as np, os, itertools
from scipy.stats import spearmanr, chi2_contingency
import statsmodels.api as sm

OUT="outputs"; os.makedirs(OUT,exist_ok=True); RNG=np.random.default_rng(123)

temporal = pd.read_csv("data/temporal_trends_contingency_table.csv", sep="\t")
niche    = pd.read_csv("data/invaded_niche_pathways.csv", sep="\t")
species  = pd.read_csv("data/invasion_success_pathways.csv")
treetxt  = open("data/phylogenetic_tree.txt").read().strip().rstrip(";")

print("="*78); print("A. REGIONAL-TEMPORAL STYLE")
tmp=temporal.copy(); tmp["pathway"]=tmp["pathway"].str.lower()
tp = tmp.pivot(index="introduction.period",columns="pathway",values="n")
tp["total"]=tp.sum(axis=1)
for c in ["gardening","unintentional","agriforest"]: tp["p."+c[:4]] = tp[c]/tp["total"]
print(tp.round(3).to_string()); tp.round(3).to_csv(f"{OUT}/A_temporal_styles.csv")

print("="*78); print("B. HABITAT-SPATIAL STYLE")
hab = niche.groupby("habitat")[["n.gard","n.unint","n.agfo","n.total"]].sum()
hab["n.plots"]=niche.groupby("habitat").size()
hab["n.occ_plots"]=niche[niche["n.total"]>0].groupby("habitat").size()
hab["p.gard"]=hab["n.gard"]/hab["n.total"].replace(0,np.nan)
hab["p.unint"]=hab["n.unint"]/hab["n.total"].replace(0,np.nan)
hab["p.agfo"]=hab["n.agfo"]/hab["n.total"].replace(0,np.nan)
CT=hab[["n.gard","n.unint","n.agfo"]].values
chi2,pval,dof,exp=chi2_contingency(CT)
obsC=pd.DataFrame(CT,index=hab.index,columns=["gard","unint","agfo"])
expC=pd.DataFrame(exp,index=hab.index,columns=["gard","unint","agfo"])
resid=(obsC-expC)/np.sqrt(expC)
hab["resid.gard"]=resid["gard"]; hab["resid.unint"]=resid["unint"]; hab["resid.agfo"]=resid["agfo"]
hab["reliability"]=np.where(hab["n.total"]>=20,"RELIABLE","tentative")
print(f"Habitat x Pathway chi2={chi2:.2f}, df={dof}, p={pval:.2e}")
print("Reliable:",list(hab[hab["n.total"]>=20].index)); print("Tentative:",list(hab[hab["n.total"]<20].index))
col=["n.total","n.plots","n.occ_plots","p.gard","p.unint","p.agfo","resid.gard","resid.unint","resid.agfo"]
print(hab.sort_values("p.gard",ascending=False)[col].round(3).to_string())
hab.round(3).to_csv(f"{OUT}/B_habitat_prevalence.csv")

print("="*78); print("C. SPECIES-ECOLOGICAL STYLE")
trc=["number.of.invaded.plots","area.of.occupancy.10km","habitat.range","invaded.niche.breadth","mrt","height"]
sp_full=species.groupby("intro.pathway")[trc].mean().round(2)
sp_dedup=species[species["duplicated"]!=True].groupby("intro.pathway")[trc].mean().round(2)
print("ALL 81 rows:"); print(sp_full.to_string())
print("DEDUP 77 taxa:"); print(sp_dedup.to_string())
sp_full.to_csv(f"{OUT}/C_species_style_full.csv"); sp_dedup.to_csv(f"{OUT}/C_species_style_dedup.csv")
gf=pd.crosstab(species["intro.pathway"],species["growth.form"])
print("growth form x pathway:"); print(gf.to_string()); gf.to_csv(f"{OUT}/C_growthform_x_pathway.csv")

print("="*78); print("D. SENSITIVITY: zero-count treatment")
occ=niche[niche["n.total"]>0].copy(); allp=niche.copy()
occ["p.gard"]=occ["n.gard"]/occ["n.total"]; occ["gard_dom"]=(occ["p.gard"]>0.5).astype(int)
allp["gard_dom_info0"]=0
allp.loc[allp["n.total"]>0,"gard_dom_info0"]=(allp.loc[allp["n.total"]>0,"n.gard"]/allp.loc[allp["n.total"]>0,"n.total"]>0.5).astype(int)
print(f"occ plots={len(occ)} (gard_dom=1: {(occ.gard_dom==1).sum()}) | all incl. zeros={len(allp)} (gard_dom=1: {(allp.gard_dom_info0==1).sum()})")
print("NOTE: habitat-level proportions identical across treatments (zeros add 0 to num & denom).")

ctxv=["elevation","cropland.2009.50m","urban.2009.50m","cropland.1956.50m","urban.1956.50m",
      "progressive.1993.2009.50m","regressive.1993.2009.50m","no.changes.1993.2009.50m",
      "distance.stream","distance.road","annual.temperature","annual.rainfall","annual.radiation"]
rows=[]
for c in ctxv:
    r1,p1=spearmanr(occ["p.gard"],occ[c]); r2,p2=spearmanr(allp["gard_dom_info0"],allp[c]); r3,p3=spearmanr(occ["gard_dom"],occ[c])
    rows.append([c,round(r1,3),round(p1,4),round(r2,3),round(p2,4),round(r3,3),round(p3,4)])
spe=pd.DataFrame(rows,columns=["ctx","rho.p.gard(occ)","p","rho.gard_dom(all632)","p","rho.gard_dom(occ191)","p"])
print("Univariate Spearman (both treatments):")
print(spe.sort_values("rho.p.gard(occ)",ascending=False).to_string())
spe.to_csv(f"{OUT}/D_spearman_sensitivity.csv")

def logit(df,y,covs,name):
    X=(df[covs]-df[covs].mean())/df[covs].std()
    X=sm.add_constant(X)
    m=sm.Logit(df[y],X).fit(disp=0)
    res=pd.DataFrame({"coef":m.params,"se":m.bse,"OR(perSD)":np.exp(m.params),"p":m.pvalues})
    print(f"\nLogit [{name}]: n={len(df)}, events={int(df[y].sum())}, McFaddenR2={m.prsquared:.3f}")
    print(res.round(4).to_string()); res.to_csv(f"{OUT}/D_logit_{name}.csv")

covs_main=["elevation","cropland.2009.50m","urban.2009.50m","progressive.1993.2009.50m","distance.stream","annual.temperature"]
logit(occ,"gard_dom",covs_main,"occ_only_n191")
logit(allp,"gard_dom_info0",covs_main,"incl_zeros_n632")
cm=occ[covs_main].corr().round(2)
print("\ncovariate corr (occ):"); print(cm.to_string()); cm.to_csv(f"{OUT}/D_covariate_corr.csv")
prof=occ.groupby("gard_dom")[["elevation","cropland.2009.50m","urban.2009.50m","progressive.1993.2009.50m",
      "distance.stream","distance.road","annual.temperature","annual.rainfall"]].mean().round(2)
print("\ncontext, gardening-dominant vs not (occ):"); print(prof.to_string()); prof.to_csv(f"{OUT}/D_context_profile_garddom.csv")

print("="*78); print("E. PHYLOGENETIC CONTEXT")
def parse_newick(s):
    s=s.strip().rstrip(";"); i=0; n=len(s)
    def node():
        nonlocal i
        children=[]
        if s[i]=='(':
            i+=1
            while True:
                children.append(node())
                if s[i]==',': i+=1
                elif s[i]==')': i+=1; break
                else: raise ValueError(s[i:i+10])
        st=i
        while i<n and s[i] not in '(),:;': i+=1
        lab=s[st:i] if i>st else None
        length=None
        if i<n and s[i]==':':
            i+=1; st=i
            while i<n and s[i] not in '(),:;': i+=1
            length=float(s[st:i])
        return (children,lab,length)
    return node()
root_tree=parse_newick(treetxt)
class N:
    __slots__=("children","name","length","parent")
    def __init__(s,name=None,length=None): s.children=[]; s.name=name; s.length=length; s.parent=None
def build(nd,parent=None):
    ch,lab,length=nd; nn=N(lab,length); nn.parent=parent
    for c in ch: nn.children.append(build(c,nn))
    return nn
T=build(root_tree)
tips=[]
def collect(nn,acc):
    if not nn.children: acc.append(nn)
    for c in nn.children: collect(c,acc)
collect(T,tips)
assert len(tips)==81 and all(t.name for t in tips)
print("Tips:",len(tips))
def root_info(nn):
    d={}; cur=nn; acc=0.0
    while cur is not None:
        d[id(cur)]=acc; acc += cur.length if cur.length else 0.0; cur=cur.parent
    return d,id(nn)
RI={id(t):root_info(t) for t in tips}
def dist(t1,t2):
    d1,id1=RI[id(t1)]; d2,id2=RI[id(t2)]
    anc=set(d1); cur=t2
    while id(cur) not in anc: cur=cur.parent
    lca=id(cur); return d1[lca]+d2[lca]
pathmap=dict(zip(species["phylo.tip.label"],species["intro.pathway"]))
tippath=[pathmap[t.name] for t in tips]
D=np.zeros((81,81))
for a,b in itertools.combinations(range(81),2):
    dd=dist(tips[a],tips[b]); D[a,b]=D[b,a]=dd
def mw(g):
    ids=[i for i,p in enumerate(tippath) if p==g]
    return D[np.ix_(ids,ids)][np.triu_indices(len(ids),1)].mean() if len(ids)>1 else np.nan
def mb(g1,g2):
    i1=[i for i,p in enumerate(tippath) if p==g1]; i2=[i for i,p in enumerate(tippath) if p==g2]
    return D[np.ix_(i1,i2)].mean()
print(f"mean within-dist: ALL={D[np.triu_indices(81,1)].mean():.2f} Gardening={mw('Gardening'):.2f} Unint={mw('Unintentional'):.2f} (AgFo={mw('AgriForest'):.2f})")
print(f"between: Gard-vs-Unint={mb('Gardening','Unintentional'):.2f} Gard-vs-AgFo={mb('Gardening','AgriForest'):.2f}")
labels=np.array(tippath); nperm=9999
def stat_g(la):
    g=[i for i,p in enumerate(la) if p=='Gardening']
    return D[np.ix_(g,g)][np.triu_indices(len(g),1)].mean()
obs_g=stat_g(labels)
null_g=np.array([stat_g(RNG.permutation(labels)) for _ in range(nperm)])
p_closer=(null_g<=obs_g).sum()/nperm; z=(obs_g-null_g.mean())/null_g.std()
print(f"Gardening phylo clustering: obs={obs_g:.2f} null.mean={null_g.mean():.2f} sd={null_g.std():.2f} z={z:+.2f} p( closer-than-expected)={p_closer:.4f}")
def stat_u(la):
    g=[i for i,p in enumerate(la) if p=='Unintentional']
    return D[np.ix_(g,g)][np.triu_indices(len(g),1)].mean()
obs_u=stat_u(labels)
null_u=np.array([stat_u(RNG.permutation(labels)) for _ in range(nperm)])
p_u=(null_u<=obs_u).sum()/nperm; z_u=(obs_u-null_u.mean())/null_u.std()
print(f"Unint phylo clustering: obs={obs_u:.2f} null.mean={null_u.mean():.2f} sd={null_u.std():.2f} z={z_u:+.2f} p={p_u:.4f}")
open(f"{OUT}/E_phylo_test.txt","w").write(
 f"tips=81 mean.all={D[np.triu_indices(81,1)].mean():.2f}\n"
 f"gard.within={mw('Gardening'):.2f} unint.within={mw('Unintentional'):.2f} agfo.within={mw('AgriForest'):.2f}\n"
 f"gard.vs.unint={mb('Gardening','Unintentional'):.2f} gard.vs.agfo={mb('Gardening','AgriForest'):.2f}\n"
 f"perm.gard obs={obs_g:.2f} null.mean={null_g.mean():.2f} sd={null_g.std():.2f} z={z:+.2f} p={p_closer:.4f}\n"
 f"perm.unint obs={obs_u:.2f} null.mean={null_u.mean():.2f} sd={null_u.std():.2f} z={z_u:+.2f} p={p_u:.4f}\n")
print("\nDONE -> ./outputs/")
