# effect sizes: predicted presence at low vs high urban (10th vs 90th pct)
def pred_effect(op, d, term='urban2009', buf='500'):
    Xb=baseX(d)
    lo_q, hi_q = np.percentile(stand(d['2009']), [10,90]) if term=='urban2009' else np.percentile(stand(d['gain']),[10,90])
    out={}
    for p in ['gard','unint','agfo']:
        m=op[p]['modelp']; x0=Xb.mean().values.copy(); x1=Xb.mean().values.copy()
        i=list(Xb.columns).index(term)
        x0[i]=lo_q; x1[i]=hi_q
        p0=m.predict(x0[np.newaxis,:])[0]; p1=m.predict(x1[np.newaxis,:])[0]
        out[p]=(p0,p1)
    return out
