def align_su(s):
    s=s.copy()
    mapped=[s.index[s['phylo.tip.label']==nm][0] for nm in names]
    return s.loc[mapped].reset_index(drop=True)
def buildX(ss,preds):
    X=pd.DataFrame(index=ss.index); X['const']=1.0
    for pr in preds:
        if pr=='unint': X['unint']=(ss['intro.pathway']=='Unintentional').astype(float)
        elif pr=='agfo': X['agfo']=(ss['intro.pathway']=='AgriForest').astype(float)
        elif pr=='annual': X['annual']=(ss['growth.form']=='Annual fg').astype(float)
        elif pr=='peren': X['peren']=(ss['growth.form']=='Perennial fg').astype(float)
        elif pr=='wind': X['wind']=(ss['dispersal']=='Wind').astype(float)
        elif pr=='animal': X['animal']=(ss['dispersal']=='Animal').astype(float)
        elif pr=='veg': X['veg']=(ss['vegetative']=='Yes').astype(float)
        elif pr=='mrt': X['mrt']=stand(ss['log_mrt'])
        elif pr=='nnb': X['nnb']=stand(ss['native.niche.breadth'])
        elif pr=='h': X['h']=stand(ss['log_h'])
    return X

def spp_run(s, preds, ycol='log_plots', lam='ml'):
    ss=align_su(s); X=buildX(ss,preds)
    return pgls(ss[ycol].values, X.values, V, lam=lam, cols=list(X.columns)), list(X.columns)

