# ============================== NEWICK ==============================
class Node:
    __slots__=('name','length','children')
    def __init__(s,name=None,length=None): s.name=name; s.length=length; s.children=[]
def parse_newick(st):
    st=st.strip().rstrip(';').strip(); pos=0
    def read():
        nonlocal pos
        n=Node()
        if st[pos]=='(':
            pos+=1
            while True:
                n.children.append(read())
                if st[pos]==',': pos+=1; continue
                if st[pos]==')': pos+=1; break
        b=pos
        while pos<len(st) and st[pos] not in ',):;': pos+=1
        n.name=st[b:pos].strip()
        if pos<len(st) and st[pos]==':':
            pos+=1; b=pos
            while pos<len(st) and st[pos] not in ',):;': pos+=1
            n.length=float(st[b:pos])
        return n
    return read()
def collect_tips(r):
    t={}
    def w(n):
        if not n.children:
            if n.name: t[n.name]=n
        for c in n.children: w(c)
    w(r); return t
def parents(r):
    pa={}
    def w(n,p):
        pa[n]=p
        for c in n.children: w(c,n)
    w(r,None); return pa
def dists(r, bp=1.0):
    d={}
    def w(n,x):
        d[n]=x
        for c in n.children:
            L=c.length or 0.0
            if bp!=1.0: L=L**bp
            w(c,x+L)
    w(r,0.0); return d
def path(rn,pa):
    p=[]; c=rn
    while c is not None: p.append(c); c=pa.get(c)
    return p[::-1]
def patristic_cov(r,tips,bp=1.0):
    pa=parents(r); dd=dists(r,bp); nm=sorted(tips); ph={}
    for n in nm: ph[n]={id(x):dd[x] for x in path(tips[n],pa)}
    V=np.zeros((len(nm),len(nm)))
    for i,a in enumerate(nm):
        for j,b in enumerate(nm):
            if i==j: V[i,j]=dd[tips[a]]
            else: V[i,j]=max(ph[a][k] for k in (ph[a].keys() & ph[b].keys()))
    return V,nm
def pagel(V,lam):
    D=np.diag(np.diag(V))
    return D if lam==0 else D+lam*(V-D)
def pgls(y,X,V,lam='ml',cols=None):
    n=len(y)
    def f(Vv):
        Vv=(Vv+Vv.T)/2; Vi=np.linalg.pinv(Vv); Xt=X.T@Vi
        b=np.linalg.solve(Xt@X, Xt@y); r=y-X@b
        s2=(r@Vi@r)/(n-X.shape[1]); cb=s2*np.linalg.pinv(Xt@X)
        LL=-0.5*(n*np.log(2*np.pi)+np.linalg.slogdet(Vv)[1]+n+n*np.log(s2))
        return b,cb,s2,LL
    if lam=='ml':
        best=None
        for lc in [0,.2,.4,.6,.8,1.0]:
            try: b,c,s,LL=f(pagel(V,lc))
            except Exception: continue
            if best is None or LL>best[0]: best=(LL,b,c,s,lc)
        LL,b,c,s,lam=best
    else: b,c,s,LL=f(pagel(V,lam))
    sd=np.sqrt(np.diag(c)); z=b/sd; pv=2*(1-norm.cdf(np.abs(z)))
    o=pd.DataFrame({'coef':b,'se':sd,'z':z,'p':pv}); o.index=list(cols)
    return o,s,LL,lam

