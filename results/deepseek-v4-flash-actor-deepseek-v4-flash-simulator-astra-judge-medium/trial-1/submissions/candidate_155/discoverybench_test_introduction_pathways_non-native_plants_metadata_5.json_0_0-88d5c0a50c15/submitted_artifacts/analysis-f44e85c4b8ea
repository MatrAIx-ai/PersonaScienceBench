# ============================== A. PLOT-LEVEL ==============================
def plot_data(buf):
    d=pd.DataFrame()
    for p in ['gard','unint','agfo']: d['n.'+p]=niche['n.'+p].values
    for yr in ['1956','1993','2009']:
        d[yr]=niche['urban.'+yr+'.'+buf+'m'].values
    d['crop']=niche['cropland.2009.'+buf+'m'].values
    d['road']=niche['distance.road'].values; d['stream']=niche['distance.stream'].values
    d['elev']=niche['elevation'].values; d['temp']=niche['annual.temperature'].values
    d['rain']=niche['annual.rainfall'].values
    d['gain']=d['2009']-d['1956']; d['gain93']=d['2009']-d['1993']
    return d

def baseX(d, gain_col='gain'):
    X=pd.DataFrame({'const':1.0,
        'urban2009':stand(d['2009']),
        'urban_gain':stand(d[gain_col]),
        'prog56':stand(niche['progressive.1956.2009.50m'].values),
        'log_road':stand(np.log1p(d['road'])),
        'log_stream':stand(np.log1p(d['stream'])),
        'crop':stand(d['crop']),
        'elev':stand(d['elev']),
        'temp':stand(d['temp'])})
    return X

def conf(res, k):
    ci=res.conf_int()
    return ci

# --- combined pooled NB with pathway interactions (formal single test) ---
def combined_nb(buf, gain_col='gain'):
    d=plot_data(buf); Xb=baseX(d,gain_col)
    rows=[]
    for p,lab in [('gard','gard'),('unint','unint'),('agfo','agfo')]:
        r=Xb.copy(); r['count']=d['n.'+p].values; r['lab']=lab; rows.append(r)
    long=pd.concat(rows,ignore_index=True)
    long['unint']=(long['lab']=='unint').astype(int); long['agfo']=(long['lab']=='agfo').astype(int)
    X=pd.DataFrame(index=long.index); X['const']=1.0
    for c in ['urban2009','urban_gain','log_road','log_stream','crop','elev','temp','prog56']:
        X[c]=long[c]
    X['unint']=long['unint']; X['agfo']=long['agfo']
    for c in ['urban2009','urban_gain','log_road']:
        X[c+':unint']=X[c]*X['unint']; X[c+':agfo']=X[c]*X['agfo']
    m=sm.NegativeBinomial(long['count'].values,X.values).fit(disp=0,maxiter=400)
    k=X.shape[1]
    t=pd.DataFrame({'coef':m.params[:k],'se':m.bse[:k],'p':m.pvalues[:k],'IRR':np.exp(m.params[:k])},index=X.columns)
    ci=m.conf_int()[:k]
    t['ci_low']=np.exp(ci[:,0]); t['ci_high']=np.exp(ci[:,1])
    # LR test: with vs without interactions
    Xr=X[['const','urban2009','urban_gain','log_road','log_stream','crop','elev','temp','prog56','unint','agfo']]
    mr=sm.NegativeBinomial(long['count'].values,Xr.values).fit(disp=0,maxiter=400)
    lr=2*(m.llf-mr.llf); from scipy.stats import chi2
    p_lr=1-chi2.cdf(lr, X.shape[1]-Xr.shape[1])
    return t, p_lr, lr

P('='*70); P('A1. POOLED NB (full long data, main 500m): urban dims x pathway interactions')
t500, p_lr, lr = combined_nb('500')
