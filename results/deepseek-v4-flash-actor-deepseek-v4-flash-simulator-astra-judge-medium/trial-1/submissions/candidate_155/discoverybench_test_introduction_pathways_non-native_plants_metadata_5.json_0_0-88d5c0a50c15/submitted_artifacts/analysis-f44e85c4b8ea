# --- per-pathway hurdle: presence logistic + NB intensity ---
def per_pathway(buf, gain_col='gain'):
    d=plot_data(buf); Xb=baseX(d,gain_col); out={}
    for p in ['gard','unint','agfo']:
        y=d['n.'+p].values; pres=(y>0).astype(int)
        rp=sm.Logit(pres,Xb.values).fit(disp=0,maxiter=400)
        rn=sm.NegativeBinomial(y,Xb.values).fit(disp=0,maxiter=400)
        k=Xb.shape[1]
        cip=rp.conf_int(); cin=rn.conf_int()[:k]
        tp=pd.DataFrame({'coef':rp.params,'se':rp.bse,'p':rp.pvalues,'OR':np.exp(rp.params),
                         'lo':np.exp(cip[:,0]),'hi':np.exp(cip[:,1])},index=Xb.columns)
        tn=pd.DataFrame({'coef':rn.params[:k],'se':rn.bse[:k],'p':rn.pvalues[:k],'IRR':np.exp(rn.params[:k]),
                         'lo':np.exp(cin[:,0]),'hi':np.exp(cin[:,1])},index=Xb.columns)
        out[p]=dict(pres=tp,nb=tn,npres=int(pres.sum()),modelp=rp,modeln=rn)
    return out, d

