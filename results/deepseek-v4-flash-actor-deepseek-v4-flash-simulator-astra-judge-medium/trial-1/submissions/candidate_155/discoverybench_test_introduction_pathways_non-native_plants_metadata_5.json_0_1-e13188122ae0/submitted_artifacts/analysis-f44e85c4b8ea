"""Full DiscoveryBench workflow runner: data-grounded analysis for
'What types of plant introductions were influenced by urban land use?'"""
import subprocess, sys, os
os.chdir("/workspace")
scripts=["inspect_data.py","analyze_core_final.py","analyze_core2.py","analyze_temporal_species.py","analyze_phylo.py","analyze_zip_manual.py"]
for s in scripts:
    out=f"analysis/out_{s.replace('.py','')}.txt"
    with open(out,"w") as f:
        r=subprocess.run([sys.executable, f"analysis/{s}"], capture_output=True, text=True)
        f.write(r.stdout)
        if r.returncode!=0:
            f.write("\n[STDERR]\n"+r.stderr)
    print(f"{s}: exit={r.returncode} -> {out}")
print("ALL DONE")
