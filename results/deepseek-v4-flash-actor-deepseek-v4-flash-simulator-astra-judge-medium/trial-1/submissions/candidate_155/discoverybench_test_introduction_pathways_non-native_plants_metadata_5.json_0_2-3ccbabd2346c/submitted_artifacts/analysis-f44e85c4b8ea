#!/usr/bin/env python3
"""Plot-level count models: urban -> per-plot species counts by pathway.
Effect sizes: IRR per +0.10 urban with 95% CI (negative binomial / ZINB-robustness + MixedLM random effects)."""
import pandas as pd, numpy as np, warnings
import statsmodels.api as sm
from statsmodels.discrete.count_model import ZeroInflatedNegativeBinomialP
from statsmodels.regression.mixed_linear_model import MixedLM
warnings.filterwarnings('ignore')
pd.set_option('display.width', 260); pd.set_option('display.max_columns', 80)

inp = pd.read_csv("data/invaded_niche_pathways.csv", sep="\t")
# ---------- clean names ----------
rn = {'annual.temperature':'temp','annual.rainfall':'rain','annual.radiation':'rad',
      'urban.2009.500m':'urban','cropland.2009.500m':'crop','elevation':'elev',
      'distance.road':'road','distance.stream':'stream','longitude':'lon','latitude':'lat'}
inp = inp.rename(columns=rn)
for c in ['elev','road','stream','temp','rain','rad','lon','lat']:
    inp['z_'+c] = (np.log1p(inp[c]) if c in ['road','stream'] else inp[c])
    inp['z_'+c] = (inp['z_'+c]-inp['z_'+c].mean())/inp['z_'+c].std()
inp['grid'] = (inp['lon']//5000).astype(int).astype(str)+"_"+(inp['lat']//5000).astype(int).astype(str)
HAB = pd.get_dummies(inp['habitat'], prefix='H', dtype=int)
inp = pd.concat([inp, HAB], axis=1); HABCOLS=HAB.columns.tolist()
print("n:",len(inp),"| grid cells:",inp['grid'].nunique(),"| habitats:",inp['habitat'].nunique())

def irr_from(b, se):
    return (float(np.exp(0.1*b)), float(np.exp(0.1*(b-1.96*se))), float(np.exp(0.1*(b+1.96*se))))

def safe_nb(y, covs):
    try:
        exog = sm.add_constant(inp[covs])
        m = sm.NegativeBinomial(inp[y], exog, loglike_method='nb2').fit(maxiter=500, disp=False)
        if not m.mle_retvals.get('converged', True): return None
        b,se = m.params['urban'], m.bse['urban']
        if not np.all(np.isfinite([b,se])): return None
        irr,lo,hi = irr_from(b,se)
        return dict(model='NB', irr=irr, lo=lo, hi=hi, beta=float(b), se=float(se), aic=float(m.aic))
    except Exception as e:
        return None

def safe_zinb(y, covs, infl):
    try:
        exog = sm.add_constant(inp[covs]); exog_infl = sm.add_constant(inp[infl])
        mod = ZeroInflatedNegativeBinomialP(inp[y], exog, exog_infl=exog_infl, inflation='logit')
        for meth in ['bfgs','nm','powell']:
            try:
                m = mod.fit(maxiter=2000, method=meth, disp=False)
                if m.mle_retvals is not None and not m.mle_retvals.get('converged', True): continue
                b,se = m.params['urban'], np.sqrt(m.cov_params().loc['urban','urban'])
                p_infl = m.params['infl_urban'] if 'infl_urban' in m.params.index else np.nan
                irr,lo,hi = irr_from(b,se)
                return dict(model='ZINB', irr=irr, lo=lo, hi=hi, beta=float(b), se=float(se),
                            aic=float(m.aic), infl_urban=float(p_infl) if p_infl==p_infl else None)
            except Exception:
                continue
    except Exception:
        pass
    return None


def safe_gee(y, covs):
    try:
        exog = sm.add_constant(inp[covs])
        fam = sm.families.NegativeBinomial()
        m = sm.GEE(inp[y], exog, groups=inp['grid'], family=fam, cov_struct=sm.cov_struct.Independence()).fit(maxiter=100, cov_type='robust')
        b,se = m.params['urban'], m.bse['urban']
        if not np.all(np.isfinite([b,se])): return None
        irr,lo,hi = irr_from(b,se)
        return dict(model='GEE-NB', irr=irr, lo=lo, hi=hi, beta=float(b), se=float(se), aic=float('nan'))
    except Exception as e:
        return None

BASE = ['urban','crop','z_elev','z_lon','z_lat']
FULL = BASE + ['z_road','z_stream','z_temp','z_rain','z_rad'] + HABCOLS
HABMOD = BASE + HABCOLS
print("\n"+"="*92); print("IRR per +0.10 urban — NB simple | NB +habitat | NB full | ZINB(hab) | ZINB-infl-urban");
print("="*92)
RES={}
for y in ['n.gard','n.unint','n.agfo','n.total']:
    r_s = safe_nb(y, BASE)
    r_h = safe_nb(y, HABMOD)
    r_f = safe_nb(y, FULL)
    r_z = safe_zinb(y, HABMOD, ['urban','z_elev'])
    r_g = safe_gee(y, FULL)
    RES[y] = dict(simple=r_s, hab=r_h, full=r_f, zinb=r_z, gee=r_g)
    def fmt(r):
        return '  -' if r is None else f"IRR={r['irr']:.2f} [{r['lo']:.2f},{r['hi']:.2f}]"
    print(f"{y:8s} NB-simple:{fmt(r_s)}")
    print(f"{'':8s} NB+hab:   {fmt(r_h)}")
    print(f"{'':8s} NB-full:  {fmt(r_f)}")
    if r_z is not None:
        iu = f"{r_z['infl_urban']:.3f}" if r_z.get('infl_urban') is not None else 'NA'
        print(f"{'':8s} ZINB:     {fmt(r_z)}  (infl_urban={iu})")
    else:
        print(f"{'':8s} ZINB:     DID NOT CONVERGE")
    print(f"{'':8s} GEE-NB:   {fmt(r_g)}  (clustered by 5km grid, full covs)")
np.save('analysis/out/step3_counts.npy', RES, allow_pickle=True)

print("\n"+"="*92); print("MixedLM log1p — habitat & 5km-grid variance components, urban beta + CI"); print("="*92)
ML={}
for y in ['n.gard','n.unint','n.agfo','n.total']:
    inp['lny']=np.log1p(inp[y])
    f = ("lny ~ urban + crop + z_elev + z_road + z_stream + z_temp + z_rain + z_rad + z_lon + z_lat")
    m = MixedLM.from_formula(f, inp, groups=inp['grid'], re_formula='1',
                             vc_formula={'habitat':'0 + C(habitat)'}).fit(reml=True)
    b,p = m.params['urban'], m.pvalues['urban']; ci = m.conf_int().loc['urban']
    print(f"{y}: beta={b:.3f} [{ci[0]:.3f},{ci[1]:.3f}] p={p:.2g}  factor/0.1={np.exp(0.1*b):.2f}  grid={m.vcomp[0]:.4f} hab={float(m.cov_re.iloc[0,0]):.4f} resid={m.scale:.4f}")
    ML[y]=dict(beta=float(b), lo=float(ci[0]), hi=float(ci[1]), p=float(p))
np.save('analysis/out/step3_mixed.npy', ML, allow_pickle=True)
print("\nDONE step3")
