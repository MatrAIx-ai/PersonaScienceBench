"""
Reproducible analysis: in which domains is the original effect size larger than the replication effect size?

Question: For which domains do the effect size estimates tend to be larger in
original studies compared to replication studies?

Design (per approved plan):
 - Domain layers: project.x (Psychology / Experimental Economics) and discipline
   (Social / Cognitive / Economics); project.x and project.y are perfectly aligned.
 - Primary inference scale: paired Fisher-z difference D = fiso - fisr
   (variance-stabilized). Correlation-scale (ro - rr) and relative_es as descriptive support.
 - Reversed-direction replications (rr<0) are KEPT in the primary analysis (a
   sign flip is strong evidence; all ro>0 so original direction is fixed).
   Robustness: (a) excluding rr<0; (b) absolute magnitude |rr|.
 - Within-domain: paired t-test + Wilcoxon signed-rank, median/mean D, 95% CI,
   sign-consistency proportion, precision-weighted mean (w = 1/(se_fiso^2+se_fisr^2)).
 - Between-domain: Welch t / Mann-Whitney (project), ANOVA / Kruskal-Wallis (discipline).
 - No imputation (no missing key columns).
"""
import pandas as pd, numpy as np, json, warnings
from scipy import stats
warnings.filterwarnings('ignore')

df = pd.read_csv('data/meta-regression_joined_data_heterogeneity_in_replication_projects.csv')
df['D_fz'] = df['fiso'] - df['fisr']
df['D_r']  = df['ro']  - df['rr']
df['D_abs']= df['ro']  - df['rr'].abs()
df['w']    = 1.0/(df['se_fiso']**2 + df['se_fisr']**2)

out = {}

# ---------- within-domain ----------
def within(g):
    n=len(g); D=g['D_fz'].values
    t,p_t = stats.ttest_rel(g['fiso'], g['fisr'])
    wr = stats.wilcoxon(D)
    se = D.std(ddof=1)/np.sqrt(n)
    return dict(n=n, Dfz_mean=round(D.mean(),4), Dfz_med=round(np.median(D),4),
                ci95=[round(D.mean()-1.96*se,4), round(D.mean()+1.96*se,4)],
                p_paired_t=float(p_t), p_wilcox=float(wr.pvalue),
                wmean_w=round(float((g['w']*D).sum()/g['w'].sum()),4),
                sign_prop_gt0=round(float((D>0).mean()),3),
                Dr_med=round(float(np.median(g['D_r'])),4),
                rel_med=round(float(np.median(g['relative_es'])),4),
                Dabs_med=round(float(np.median(g['D_abs'])),4),
                rev=int((g['rr']<0).sum()))

within_res={}
for key,groups in [('project.x',['Psychology','Experimental Economics']),('discipline',['Social','Cognitive','Economics'])]:
    within_res[key]={g:within(df[df[key]==g]) for g in groups}
out['within']=within_res

# ---------- between-domain ----------
psy=df[df['project.x']=='Psychology']['D_fz']; ee=df[df['project.x']=='Experimental Economics']['D_fz']
t,p = stats.ttest_ind(psy,ee,equal_var=False); _,pu=stats.mannwhitneyu(psy,ee)
soc=df[df['discipline']=='Social']['D_fz']; cog=df[df['discipline']=='Cognitive']['D_fz']; eco=df[df['discipline']=='Economics']['D_fz']
F,pA=stats.f_oneway(soc,cog,eco); H,pK=stats.kruskal(soc,cog,eco)
out['between']=dict(project_welch=dict(t=round(float(t),3),p=float(p)),
                    project_mw=dict(p=float(pu),median_diff=round(float(np.median(psy)-np.median(ee)),3)),
                    discipline_anova=dict(F=round(float(F),3),p=float(pA)),
                    discipline_kw=dict(H=round(float(H),3),p=float(pK)))

# ---------- robustness ----------
dfn=df[df['rr']>=0]
rob_norev={}
for key,groups in [('project.x',['Psychology','Experimental Economics']),('discipline',['Social','Cognitive','Economics'])]:
    rob_norev[key]={g:{'n':int(len(g)),'Dfz_med':round(float(np.median(g['D_fz'])),3),
                      'sign_prop':round(float((g['D_fz']>0).mean()),3),
                      'p_paired_t':float(stats.ttest_rel(g['fiso'],g['fisr']).pvalue)} for g in [dfn[dfn[key]==grp] for grp in groups] if len(g)>0 for grp in []}
# fix nested dict properly
rob_norev={}
for key,groups in [('project.x',['Psychology','Experimental Economics']),('discipline',['Social','Cognitive','Economics'])]:
    d={}
    for grp in groups:
        g=dfn[dfn[key]==grp]
        if len(g)>0:
            d[grp]={'n':int(len(g)),'Dfz_med':round(float(np.median(g['D_fz'])),3),
                    'sign_prop':round(float((g['D_fz']>0).mean()),3),
                    'p_paired_t':float(stats.ttest_rel(g['fiso'],g['fisr']).pvalue)}
    rob_norev[key]=d
out['robust_exclude_rr_lt0']=rob_norev

rob_abs={}
for key,groups in [('project.x',['Psychology','Experimental Economics']),('discipline',['Social','Cognitive','Economics'])]:
    rob_abs[key]={g:{'Dabs_med':round(float(np.median(df[df[key]==g]['D_abs'])),3),
                     'sign_prop':round(float((df[df[key]==g]['D_abs']>0).mean()),3),
                     'p_paired_t':float(stats.ttest_rel(df[df[key]==g]['ro'],df[df[key]==g]['rr'].abs()).pvalue)} for g in groups}
out['robust_abs_magnitude']=rob_abs

out['overall']=dict(n=int(len(df)),
                    Dfz_med=round(float(np.median(df['D_fz'])),3),
                    sign_prop_gt0=round(float((df['D_fz']>0).mean()),3),
                    rel_es_med=round(float(np.median(df['relative_es'])),3),
                    n_reversed=int((df['rr']<0).sum()))

with open('analysis/outputs/results.json','w') as f: json.dump(out,f,indent=2,default=float)

# ---------- print summary ----------
print('WITHIN-DOMAIN (primary Fisher-z paired diff D = fiso - fisr)')
print(pd.DataFrame([{**{'domain':f'{k}/{gk}'},**v} for k,d in within_res.items() for gk,v in d.items()]).to_string(index=False))
print('\nBETWEEN-DOMAIN:'); print(json.dumps(out['between'],indent=1))
print('\nOVERALL:', out['overall'])
print('\nSaved -> analysis/outputs/results.json')
