#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
Question: What is the proportion of junior professors in replicated studies in Psychology?

Analysis for the RPP (Psychology) subset of the meta-regression study dataset.
Operational decisions (approved):
  - Psychology == project=='rpp' (97 study-level rows; per schema "rpp: Psychology")
  - Replicated studies == project=='rpp' & replicated==1 (N_replicated = 35)
  - Denominator = number of replicated studies (study-level counts), not number of authors
  - Junior professor = most senior author of the REPLICATION paper seniority.r
      main:  {Assistant, Assistant Professor}
      strict:{Assistant Professor}
      broad: {Assistant, Assistant Professor, Researcher}
  - sensitivity: also report seniority.o based junior proportion (=0, degenerate)
  - duplicate-title sensitivity: rpp.148/149 & rpp.49/50
  - file2 (replication_success) used only for cross-check of replication success; coverage differs
"""

import pandas as pd
from scipy.stats import fisher_exact

DATA = '/workspace/data'
f1 = f'{DATA}/meta-regression_study_data_heterogeneity_in_replication_projects.csv'
f2 = f'{DATA}/meta-regression_replication_success_data_heterogeneity_in_replication_projects.csv'

df = pd.read_csv(f1)
df2 = pd.read_csv(f2)

print('=' * 80)
print('STEP 0. Data structure')
print('=' * 80)
print('File1 (study data): shape', df.shape)
print('File1 project value_counts:'); print(df['project'].value_counts(dropna=False).to_string())
print('File1 replicated value_counts:'); print(df['replicated'].value_counts(dropna=False).to_string())
print('File1 unique ids by project prefix:')
for p in ['ml1','ml3','rpp','ee']:
    sub = df[df['id'].str.startswith(p)]
    print(f'  {p}: rows={len(sub)}, unique ids={sub["id"].nunique()}')
print('File2 (replication_success) shape:', df2.shape)
print('File2 project value_counts:'); print(df2['project'].value_counts(dropna=False).to_string())

# ----------------------------------------------------------------------
print()
print('=' * 80)
print('STEP 1. Psychology == rpp subset: completeness of key columns')
print('=' * 80)
rp = df[df['project'] == 'rpp'].copy()
print('rpp rows:', len(rp), '| unique id:', rp['id'].nunique())
print('rpp missing  replicated:', rp['replicated'].isna().sum(),
      '| seniority.o:', rp['seniority.o'].isna().sum(),
      '| seniority.r:', rp['seniority.r'].isna().sum())
print('rpp replicated value_counts:'); print(rp['replicated'].value_counts(dropna=False).to_string())
n_rep = int((rp['replicated'] == 1).sum())
n_not = int((rp['replicated'] == 0).sum())
print(f'N_replicated (denominator) = {n_rep}; N_not = {n_not}')

# ----------------------------------------------------------------------
print()
print('=' * 80)
print('STEP 2. crosstabs seniority x replicated (rpp)')
print('=' * 80)
print('-- seniority.r x replicated (all rpp) --')
print(pd.crosstab(rp['seniority.r'], rp['replicated'], margins=True).to_string())
print('-- seniority.o x replicated (all rpp) --')
print(pd.crosstab(rp['seniority.o'], rp['replicated'], margins=True).to_string())

# ----------------------------------------------------------------------
print()
print('=' * 80)
print('STEP 3. THREE junior definitions (denominator = 35 replicated studies)')
print('=' * 80)
rep = rp[rp['replicated'] == 1].copy()

def prop(mask):
    k = int(mask.sum()); n = len(rep)
    return k, n, k / n

k1, n1, p1 = prop(rep['seniority.r'].isin(['Assistant Professor']))
k2, n2, p2 = prop(rep['seniority.r'].isin(['Assistant', 'Assistant Professor']))
k3, n3, p3 = prop(rep['seniority.r'].isin(['Assistant', 'Assistant Professor', 'Researcher']))

def fmt(k, n, p): return f'{k}/{n} = {p*100:.1f}%'

print('strict (Assistant Professor only)                :', fmt(k1, n1, p1))
print('MAIN   (Assistant + Assistant Professor)         :', fmt(k2, n2, p2))
print('broad  (Assistant + Assistant Professor + Researcher):', fmt(k3, n3, p3))
print()
print('Seniority.r distribution among replicated studies (n=35):')
print(rep['seniority.r'].value_counts().to_string())

# seniority.o contrast
ko, no_, po = prop(rep['seniority.o'].isin(['Assistant', 'Assistant Professor']))
print()
print('CONTRAST seniority.o junior (Assistant/Assistant Professor):', fmt(ko, no_, po))

# 2x2 + fisher for main definition
jun = rp['seniority.r'].isin(['Assistant', 'Assistant Professor'])
tab = pd.crosstab(jun, rp['replicated'])
print()
print('2x2 (junior_r = Assistant+AsstProf) x replicated:')
print(tab.to_string())
odds, pv = fisher_exact(tab.values)
print(f'Fisher exact OR={odds:.3f}, p={pv:.4f}')

# ----------------------------------------------------------------------
print()
print('=' * 80)
print('STEP 4. duplicate-title sensitivity (rpp.148/149, rpp.49/50)')
print('=' * 80)
dupt = rp[rp['title'].duplicated(keep=False)].sort_values('id')
print(dupt[['id', 'title', 'replicated', 'seniority.o', 'seniority.r']].to_string())
# dedup by title (keep first) -> recompute MAIN proportion
rp_dedup = rp.drop_duplicates(subset='title', keep='first')
rep_d = rp_dedup[rp_dedup['replicated'] == 1]
n_d = len(rep_d)
k_d = int(rep_d['seniority.r'].isin(['Assistant', 'Assistant Professor']).sum())
print(f'After dedup by title: rpp studies={len(rp_dedup)}, replicated={n_d}, main junior={k_d}/{n_d} = {k_d/n_d*100:.1f}%')

# ----------------------------------------------------------------------
print()
print('=' * 80)
print('STEP 5. File2 cross-check of replication success + coverage note')
print('=' * 80)
psy2 = df2[df2['project'] == 'Psychology'].copy()
# file1 'replicated' definition == one-sided p in direction of original <= 0.05 == pr1 <= 0.05
n2 = len(psy2)
suc2 = int((psy2['pr1'] <= 0.05).sum())
print(f'File2 Psychology: n={n2}, pr1<=0.05 (success): {suc2}/{n2} = {suc2/n2*100:.1f}%')
print(f'File1 rpp:        n={len(rp)}, replicated==1: {n_rep}/{len(rp)} = {n_rep/len(rp)*100:.1f}%')
print('Coverage note: file2 Psychology=73 vs file1 rpp=97 (different extractions of RPP);')
print('file2 has no seniority columns and is used only for success-rate cross-check.')
print()
print('File1 rpp all 97 studies, seniority.r count (for context):')
print(rp['seniority.r'].value_counts().to_string())
