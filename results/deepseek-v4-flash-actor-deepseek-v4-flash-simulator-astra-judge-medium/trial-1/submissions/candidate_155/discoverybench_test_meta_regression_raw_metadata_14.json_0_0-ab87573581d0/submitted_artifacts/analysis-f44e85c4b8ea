import pandas as pd

MAIN = 'data/meta-regression_study_data_heterogeneity_in_replication_projects.csv'
TARGET = (82.4, 80.9)  # cited original %, replication %

df = pd.read_csv(MAIN)

# --- granularity subsets ---
study = df[(df['aggregated'] == True) | (df['aggregated'].isna())].copy()   # 141 study-level
rows  = df.copy()                                                            # 927 lab/row-level

def student_mask(series):
    return series == 'students'

def shares(sub, target_vals=TARGET):
    """Return per-discipline student shares for subjects.o and subjects.r.
    Variants: missing handled by (A) exclude from denominator, (B) treat as non-student.
    """
    out = []
    for d in ['Social', 'Cognitive', 'Economics']:
        g = sub[sub['discipline'] == d]
        for miss_mode in ['exclude', 'as_nonstudent']:
            so = g['subjects.o']; sr = g['subjects.r']
            if miss_mode == 'exclude':
                so = so.dropna(); sr = sr.dropna()
            # note: 'as_nonstudent' keeps NaN and student==1 else 0 -> NaN becomes 0
            po = student_mask(so).sum() / len(so)
            pr = student_mask(sr).sum() / len(sr)
            out.append({
                'discipline': d, 'n': len(g), 'miss_mode': miss_mode,
                'orig_pct': po * 100, 'repl_pct': pr * 100,
                'orig_students': int(student_mask(so).sum()), 'orig_den': len(so),
                'repl_students': int(student_mask(sr).sum()), 'repl_den': len(sr),
                'mae': (abs(po*100 - target_vals[0]) + abs(pr*100 - target_vals[1])) / 2,
                'euclid': ((po*100-target_vals[0])**2 + (pr*100-target_vals[1])**2) ** 0.5,
            })
    return pd.DataFrame(out)

result = []
for gname, g in [('STUDY-level (141 studies)', study), ('ROW-level (927 rows)', rows)]:
    t = shares(g)
    t.insert(0, 'granularity', gname)
    result.append(t)
grid = pd.concat(result, ignore_index=True)

pd.set_option('display.width', 200)
print('=== SENSITIVITY GRID: student share per discipline (student=1, online/anyone/community/NaN-as-nonstudent=0) ===')
print(grid.to_string(index=False))
print()
print('=== Distance to cited (orig 82.4%, repl 80.9%) — smaller is closer ===')
print(grid.sort_values('mae')[['granularity','discipline','miss_mode','orig_pct','repl_pct','mae']].to_string(index=False))
print()
best = grid.sort_values('mae').iloc[0]
print('CLOSEST CELL:', best['granularity'], '|', best['discipline'], '| missing', best['miss_mode'],
      '-> orig {:.2f}%, repl {:.2f}%  (mae={:.2f}pp)'.format(best['orig_pct'], best['repl_pct'], best['mae']))
print()
print('=== FINAL CROSS-TABULATIONS ===')
print('discipline x subjects.o (study-level)')
print(pd.crosstab(study['discipline'], study['subjects.o'], dropna=False).to_string())
print('discipline x subjects.r (study-level)')
print(pd.crosstab(study['discipline'], study['subjects.r'], dropna=False).to_string())
