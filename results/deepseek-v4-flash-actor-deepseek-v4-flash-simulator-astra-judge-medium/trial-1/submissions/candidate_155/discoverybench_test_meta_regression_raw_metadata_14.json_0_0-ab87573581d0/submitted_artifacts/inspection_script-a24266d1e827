import pandas as pd

MAIN = 'data/meta-regression_study_data_heterogeneity_in_replication_projects.csv'
SUCC = 'data/meta-regression_replication_success_data_heterogeneity_in_replication_projects.csv'

df = pd.read_csv(MAIN)
sc = pd.read_csv(SUCC)

print('MAIN CSV shape:', df.shape)
print('SUCCESS CSV shape:', sc.shape)
print('SUCCESS columns:', list(sc.columns))
print()

# --- columns of interest ---
print('=== discipline ===')
print(df['discipline'].value_counts(dropna=False))
print('missing:', df['discipline'].isna().sum())
print()
print('=== subjects.o ===')
print(df['subjects.o'].value_counts(dropna=False))
print('missing:', df['subjects.o'].isna().sum())
print()
print('=== subjects.r ===')
print(df['subjects.r'].value_counts(dropna=False))
print('missing:', df['subjects.r'].isna().sum())
print()

# --- row granularity ---
print('unique id (study) values:', df['id'].nunique(), '| rows:', len(df))
print('aggregated:', df['aggregated'].value_counts(dropna=False).to_dict())
print('ids occurring once:', (df['id'].value_counts()==1).sum(),
      '| ids occurring >1 (multi-lab):', (df['id'].value_counts()>1).sum())
print()

# --- study-level subset ---
st = df[(df['aggregated'] == True) | (df['aggregated'].isna())]
print('study-level rows:', len(st), '| unique ids:', st['id'].nunique())
print()

# --- cross-tabs ---
print('=== discipline x subjects.o (raw rows) ===')
print(pd.crosstab(df['discipline'], df['subjects.o'], dropna=False, margins=True).to_string())
print()
print('=== discipline x subjects.r (raw rows) ===')
print(pd.crosstab(df['discipline'], df['subjects.r'], dropna=False, margins=True).to_string())
print()

# --- student binary share diagnostics (NOT the final answer) ---
print('=== student binary share per discipline ===')
for subset_name, s in [('ROW-level', df), ('STUDY-level', st)]:
    print('--', subset_name, '--')
    for d in ['Social', 'Cognitive', 'Economics']:
        sub = s[s['discipline'] == d]
        so = sub['subjects.o'].dropna()
        sr = sub['subjects.r'].dropna()
        po = (so == 'students').mean() * 100
        pr = (sr == 'students').mean() * 100
        print(f'  {d:10s} n={len(sub):4d} | orig students {int((so=="students").sum()):3d}/{len(so):3d} = {po:5.1f}% | repl students {int((sr=="students").sum()):3d}/{len(sr):3d} = {pr:5.1f}%')
    print()

# rows missing subjects (both missing on same row?)
miss = df[df[['subjects.o', 'subjects.r']].isna().any(axis=1)]
print('rows missing subjects:', miss[['id', 'title', 'discipline', 'project']].to_string(index=False))
print()

# project x discipline
print('=== project x discipline ===')
print(pd.crosstab(df['discipline'], df['project']).to_string())
