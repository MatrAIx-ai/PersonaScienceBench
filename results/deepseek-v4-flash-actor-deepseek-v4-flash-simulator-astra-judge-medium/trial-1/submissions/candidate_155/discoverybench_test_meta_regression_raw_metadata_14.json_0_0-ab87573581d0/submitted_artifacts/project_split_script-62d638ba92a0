import pandas as pd
df = pd.read_csv('data/meta-regression_study_data_heterogeneity_in_replication_projects.csv')
study = df[(df['aggregated'] == True) | (df['aggregated'].isna())]
print('STUDY-level student share by discipline x project (NaN excluded):')
for d in ['Social', 'Cognitive', 'Economics']:
    sub = study[study['discipline'] == d]
    if sub['project'].nunique() == 1:
        p = sub['project'].iloc[0]
        so = sub['subjects.o'].dropna(); sr = sub['subjects.r'].dropna()
        print(f'{d:10s} [{p}] n={len(sub):3d} | orig {(so=="students").mean()*100:5.1f}% | repl {(sr=="students").mean()*100:5.1f}%')
    else:
        for p in sorted(sub['project'].unique()):
            g = sub[sub['project'] == p]
            so = g['subjects.o'].dropna(); sr = g['subjects.r'].dropna()
            if len(so) == 0:
                continue
            print(f'{d:10s} [{p}] n={len(g):3d} | orig {(so=="students").mean()*100:5.1f}% | repl {(sr=="students").mean()*100:5.1f}%')
