"""
Proportion of original studies in Experimental Economics
conducted in the United Kingdom.
Data: meta-regression_study_data_heterogeneity_in_replication_projects.csv
"""
import pandas as pd

DATA = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"

df = pd.read_csv(DATA)
print(f"[1] Loaded {df.shape[0]} rows x {df.shape[1]} columns from {DATA}")

# Operationalize "original studies in Experimental Economics" as project == 'ee'
ee = df[df["project"] == "ee"].copy()
print(f"[2] Experimental Economics (project=='ee') subset: {len(ee)} rows")

# Verification (a) discipline fully Economics
disc = ee["discipline"].value_counts(dropna=False).to_dict()
print(f"    - discipline distribution in subset: {disc}")
assert set(disc.keys()) == {"Economics"}, "unexpected disciplines in ee subset"

# Verification (b) no missing country, no duplicate ids
n_missing_country = int(ee["experiment_country.o"].isna().sum())
n_dup_ids = int(ee["id"].duplicated().sum())
print(f"    - missing experiment_country.o in subset: {n_missing_country}")
print(f"    - duplicate ids in subset: {n_dup_ids}")
assert n_missing_country == 0
assert n_dup_ids == 0

# Denominator and numerator
denominator = len(ee)
numerator = int((ee["experiment_country.o"] == "United Kingdom").sum())
proportion = numerator / denominator

print(f"[3] Counts: numerator (original studies in UK) = {numerator}; "
      f"denominator (all ee original studies) = {denominator}")
print(f"[4] Proportion = {proportion:.4f}   ({proportion*100:.1f}%)")

# Country distribution within subset for evidence
print("\n[5] experiment_country.o distribution in Experimental Economics subset:")
print(ee["experiment_country.o"].value_counts().to_string())

# The single UK study
uk_row = ee[ee["experiment_country.o"] == "United Kingdom"]
print("\n[6] UK original study row:")
print(uk_row[["id", "title", "authors.o", "pub_year", "discipline",
              "experiment_country.o", "experiment_country.r"]].to_string(index=False))

# Natural-language conclusion
conclusion = (f"Approximately {proportion*100:.1f}% of the original studies in "
              f"the Experimental Economics replication project (1 of {denominator}) "
              f"were conducted in the United Kingdom. "
              f"This small sample (n={denominator}) should be interpreted with caution.")
print(f"\n[7] CONCLUSION: {conclusion}")
