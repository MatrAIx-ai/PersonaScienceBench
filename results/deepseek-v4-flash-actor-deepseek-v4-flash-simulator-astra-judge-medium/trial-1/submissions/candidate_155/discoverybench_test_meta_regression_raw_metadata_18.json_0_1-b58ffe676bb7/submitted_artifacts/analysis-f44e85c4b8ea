"""Compute the proportion of Experimental Economics studies conducted in a lab (non-online) setting."""
import pandas as pd

FILE1 = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
FILE2 = "data/meta-regression_replication_success_data_heterogeneity_in_replication_projects.csv"

df1 = pd.read_csv(FILE1)
df2 = pd.read_csv(FILE2)

# --- 1. Select the Experimental Economics subset (study level, one row per O/R pair) ---
ee = df1[df1["project"] == "ee"].copy()
print(f"F1 rows (all):          {len(df1)}   unique ids: {df1['id'].nunique()}")
print(f"F2 rows (all):          {len(df2)}   unique study labels: {df2['study'].nunique()}")
print(f"ee rows (F1):           {len(ee)}   unique ids: {ee['id'].nunique()}\n")

# --- 2. Integrity checks on the ee subset (domain note: duplicates / missing pairs) ---
n_dup_ids = ee["id"].duplicated().sum()
n_missing_setting = ee[["online.o", "online.r", "subjects.o", "subjects.r"]].isna().sum().sum()
print(f"[integrity] ee duplicate ids:                 {n_dup_ids}")
print(f"[integrity] ee missing setting fields:        {n_missing_setting}")
assert n_dup_ids == 0 and n_missing_setting == 0, "ee subset not clean"

# --- 3. Distribution over setting-related fields ---
print("\n[distribution] online.o:", ee["online.o"].value_counts(dropna=False).to_dict())
print("[distribution] online.r:", ee["online.r"].value_counts(dropna=False).to_dict())
print("[distribution] subjects.o:", ee["subjects.o"].value_counts(dropna=False).to_dict())
print("[distribution] subjects.r:", ee["subjects.r"].value_counts(dropna=False).to_dict())
print("[distribution] discipline:", ee["discipline"].value_counts(dropna=False).to_dict())

# --- 4. Study-level proportion where "lab" == (online == 0) ---
n_ee = len(ee)
lab_o = int((ee["online.o"] == 0).sum())   # original studies in a lab (not online)
lab_r = int((ee["online.r"] == 0).sum())   # replication studies in a lab
all_online_o = (ee["online.o"] == 1).sum()
all_online_r = (ee["online.r"] == 1).sum()

print("\n[result, study-level]")
print(f"  Original studies:      {lab_o}/{n_ee} lab  -> {lab_o/n_ee:.0%}")
print(f"  Replication studies:   {lab_r}/{n_ee} lab  -> {lab_r/n_ee:.0%}")
pooled_lab = lab_o + lab_r
pooled_n = n_ee * 2
print(f"  Pooled (orig+repl):    {pooled_lab}/{pooled_n} lab  -> {pooled_lab/pooled_n:.0%}")
print(f"  Any online==1 anywhere? online.o: {all_online_o}, online.r: {all_online_r}")
print(f"  -> 100% under all definitions")

# --- 5. Cross check: no 'online'/'anyone' subject types in ee ---
assert not ee["subjects.o"].isin(["online", "anyone"]).any()
assert not ee["subjects.r"].isin(["online", "anyone"]).any()
print("\nSubject-type cross-check: no 'online'/'anyone' subjects in ee subset -> corroborates lab.")

# --- 6. File2 corroboration (no setting columns) ---
ee2 = df2[df2["project"] == "Experimental Economics"]
print(f"\n[F2 corroboration] 'Experimental Economics' rows: {len(ee2)}, unique study labels: {ee2['study'].nunique()}")
print("F2 has no setting columns:", not any(c.lower() in ("online.o","online.r","subjects.o","subjects.r") for c in df2.columns))
