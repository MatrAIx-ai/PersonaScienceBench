"""
Final analysis: average length (pages) of original papers in
Experimental Economics (ee) and Psychology (rpp).
Data: meta-regression_study_data_heterogeneity_in_replication_projects.csv
Grouping by `project` (approved plan); unit of analysis = unique original paper (id).
"""
import pandas as pd

SRC = 'data/meta-regression_study_data_heterogeneity_in_replication_projects.csv'
df = pd.read_csv(SRC)

print('='*70)
print('STEP 0: Input diagnostics')
print('='*70)
print('Rows=%d, cols=%d' % df.shape)
print('Required cols present:', all(c in df.columns for c in ['length','project','discipline','id']))

# --- Missing-length diagnostics ---
print('\n--- Missing `length` per project (row level) ---')
miss = df.assign(length_missing=df['length'].isna()).groupby('project').agg(
    rows=('length', 'size'),
    length_missing=('length_missing', 'sum'),
    length_present=('length', lambda s: s.notna().sum()),
)
print(miss.to_string())

# --- Duplication diagnostics ---
print('\n--- Duplication diagnostics per project ---')
dup_rows = []
for proj, sub in df.groupby('project'):
    per = sub.groupby('id').size()
    dup_rows.append({
        'project': proj,
        'rows': len(sub),
        'unique_original_papers (id)': sub['id'].nunique(),
        'max_rows_per_paper': per.max(),
        'mean_rows_per_paper': round(per.mean(), 3),
    })
dup_tab = pd.DataFrame(dup_rows)
print(dup_tab.to_string(index=False))

# --- Deduplicate: one row per original paper ---
uniq = df.drop_duplicates('id').copy()
print('\nDeduplicated dataset: rows=%d (unique original papers)' % len(uniq))
print('Length nulls after dedup:', uniq['length'].isna().sum())

# --- Grouping by project; compute study-level stats ---
print('\n' + '='*70)
print('STEP 1: Average length (pages) of original papers by group (study-level)')
print('Grouping: Experimental Economics = project=="ee"; Psychology = project=="rpp"')
print('='*70)

groups = {'Experimental Economics (ee)': 'ee', 'Psychology (rpp)': 'rpp'}
results = {}
for label, proj in groups.items():
    s = uniq[uniq['project'] == proj]['length']
    res = {
        'group': label,
        'n_original_papers': int(len(s)),
        'mean_pages': float(s.mean()),
        'sd_pages': float(s.std(ddof=1)) if len(s) > 1 else float('nan'),
        'median_pages': float(s.median()),
        'min_pages': int(s.min()),
        'max_pages': int(s.max()),
        'length_missing': int(s.isna().sum()),
    }
    results[label] = res
    print(f"\n{label}: n={res['n_original_papers']}, mean={res['mean_pages']:.2f} pages, "
          f"sd={res['sd_pages']:.2f}, median={res['median_pages']:.1f}, "
          f"range=[{res['min_pages']}, {res['max_pages']}], missing={res['length_missing']}")

# --- Distribution of rpp by discipline (descriptive context) ---
print('\n--- rpp (Psychology) group composition by discipline ---')
rpp = uniq[uniq['project'] == 'rpp']
print(pd.crosstab(rpp['project'], rpp['discipline']))
for d in ['Social', 'Cognitive']:
    s = rpp[rpp['discipline'] == d]['length']
    print(f"  rpp/{d}: n={len(s)}, mean={s.mean():.2f} pages")

# --- Consistency check: row-level vs study-level (should be identical for ee/rpp) ---
print('\n--- Consistency check: row-level vs study-level mean ---')
for proj in ['ee', 'rpp']:
    row_mean = df[df['project'] == proj]['length'].mean()
    st_mean = uniq[uniq['project'] == proj]['length'].mean()
    print(f'{proj}: row-level mean={row_mean:.4f}, study-level mean={st_mean:.4f}, identical={abs(row_mean-st_mean)<1e-12}')

# --- Summary table ---
print('\n' + '='*70)
print('SUMMARY (final result)')
print('='*70)
summary = pd.DataFrame(results).T[['n_original_papers', 'mean_pages', 'sd_pages', 'median_pages', 'min_pages', 'max_pages']]
print(summary.round(2).to_string())

print('\nFINAL ANSWER (natural language):')
print(f"The average length of original papers in Experimental Economics is {results['Experimental Economics (ee)']['mean_pages']:.1f} pages "
      f"(from {results['Experimental Economics (ee)']['n_original_papers']} papers; sd={results['Experimental Economics (ee)']['sd_pages']:.2f}), "
      f"and the average length of original papers in Psychology is {results['Psychology (rpp)']['mean_pages']:.1f} pages "
      f"(from {results['Psychology (rpp)']['n_original_papers']} papers; sd={results['Psychology (rpp)']['sd_pages']:.2f}).")
print('DONE')
