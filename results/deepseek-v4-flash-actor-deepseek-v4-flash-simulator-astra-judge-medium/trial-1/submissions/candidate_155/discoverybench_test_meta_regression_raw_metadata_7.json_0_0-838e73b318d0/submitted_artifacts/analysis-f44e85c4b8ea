# -*- coding: utf-8 -*-
"""
DiscoveryBench full-workflow analysis
Question: In which domain do the majority of authors tend to be male for
          both original and replication studies?

Agreed plan:
  (1) Unit of analysis = unique original study (id), N=141
  (2) For multi-lab projects (ml1/ml3) replication side uses the aggregated row
      (aggregated=="TRUE") as the pooled replication team
  (3) "Majority male" = author-team male ratio > 0.5 (strict; 0.5 = tie/non-majority)
  (4) Aggregate by discipline (Social/Cognitive/Economics); report three rates
      with exact counts + robustness checks.
"""
import csv, math
from collections import Counter, defaultdict

# ----------------------------------------------------------------------
# Load
# ----------------------------------------------------------------------
PATH = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
with open(PATH) as f:
    rows = list(csv.DictReader(f))

def fnum(x):
    return float(x)

# ----------------------------------------------------------------------
# Build study-level table (unit of analysis = unique id)
#   - original attributes are constant within id (verified)
#   - replication side: aggregated row if present else the single row
# ----------------------------------------------------------------------
byid = defaultdict(list)
for r in rows:
    byid[r["id"]].append(r)

studies = []
for i, sub in byid.items():
    agg = [x for x in sub if x["aggregated"] == "TRUE"]
    lab = [x for x in sub if x["aggregated"] == "FALSE"]
    if agg:
        rep = agg[0]                      # pooled replication team
        n_labs = len(lab)
        lab_rows = lab
    else:
        rep = sub[0]                      # single replication row (rpp / ee)
        n_labs = 1
        lab_rows = sub
    studies.append({
        "id": i,
        "discipline": sub[0]["discipline"],
        "project": sub[0]["project"],
        "amo": fnum(sub[0]["authors_male.o"]),
        "nao": fnum(sub[0]["n_authors.o"]),
        "amr": fnum(rep["authors_male.r"]),
        "nar": fnum(rep["n_authors.r"]),
        "is_multi": bool(agg),
        "lab_amr": [fnum(x["authors_male.r"]) for x in lab_rows],
        "n_rows": len(sub),
    })

DOMAINS = ["Social", "Cognitive", "Economics"]
PROJECTS = ["ml1", "ml3", "rpp", "ee"]

# ----------------------------------------------------------------------
# Helper: classification under a given threshold rule
# ----------------------------------------------------------------------
def _cmp(ratio, thresh, gt):
    return ratio > thresh if gt else ratio >= thresh

def summarize(objs, amof="amo", amrf="amr", thresh=0.5, gt=True):
    """Return per-domain {n, o_maj, r_maj, both_maj, ties}."""
    out = {}
    for d in DOMAINS:
        sel = [s for s in objs if s["discipline"] == d]
        o_maj = sum(1 for s in sel if _cmp(s[amof], thresh, gt))
        r_maj = sum(1 for s in sel if _cmp(s[amrf], thresh, gt))
        both = sum(1 for s in sel if _cmp(s[amof], thresh, gt) and _cmp(s[amrf], thresh, gt))
        o_tie = sum(1 for s in sel if s[amof] == 0.5)
        r_tie = sum(1 for s in sel if s[amrf] == 0.5)
        out[d] = dict(n=len(sel), o_maj=o_maj, r_maj=r_maj, both=both,
                      o_tie=o_tie, r_tie=r_tie)
    return out

def fmt(sumd, both_key="both"):
    lines = []
    for d in DOMAINS:
        x = sumd[d]
        tie = ""
        if "o_tie" in x:
            tie = f" | orig_tie0.5={x['o_tie']:2d} repl_tie0.5={x['r_tie']:2d}"
        lines.append(
            f"{d:11s} n={x['n']:3d} | orig_maj={x['o_maj']:3d} ({x['o_maj']/x['n']:5.1%}) | "
            f"repl_maj={x['r_maj']:3d} ({x['r_maj']/x['n']:5.1%}) | "
            f"both_maj={x[both_key]:3d} ({x[both_key]/x['n']:5.1%})" + tie
        )
    return "\n".join(lines)

print("=" * 100)
print("PRIMARY  (study-level N=141; replication side = aggregated row for ml1/ml3; strict > 0.5)")
print("=" * 100)
prim = summarize(studies)
print(fmt(prim))
print(f"Total studies: {len(studies)}  |  rows: {len(rows)}")

print()
print("=" * 100)
print("ROBUSTNESS 1  (threshold >= 0.5 instead of > 0.5; ties count as majority-male)")
print("=" * 100)
rob1 = summarize(studies, thresh=0.5, gt=False)
print(fmt(rob1))
diffs = []
for d in DOMAINS:
    diffs.append((prim[d]["both"], rob1[d]["both"]))
print("both_maj difference (>=0.5 minus >0.5) per domain:", dict(zip(DOMAINS, diffs)))

# ----------------------------------------------------------------------
# ROBUSTNESS 2: multi-lab projects use "majority of labs are male-majority"
# instead of the aggregated row value.
# ----------------------------------------------------------------------
def lab_majority_views():
    """Study-level replications from per-lab judgment."""
    views = []
    for s in studies:
        if s["is_multi"]:
            frac_lab_maj = sum(1 for v in s["lab_amr"] if v > 0.5) / len(s["lab_amr"])
            views.append(dict(s, amr2=1.0 if frac_lab_maj > 0.5 else 0.0, lab_frac=frac_lab_maj,
                              n_labs=len(s["lab_amr"])))
        else:
            views.append(dict(s, amr2=s["amr"], lab_frac=None, n_labs=1))
    return views

# recompute with amrf="amr2"
def summarize2(objs, thresh=0.5, gt=True):
    out = {}
    for d in DOMAINS:
        sel = [s for s in objs if s["discipline"] == d]
        o_maj = sum(1 for s in sel if _cmp(s["amo"], thresh, gt))
        r_maj = sum(1 for s in sel if _cmp(s["amr2"], thresh, gt))
        both = sum(1 for s in sel if _cmp(s["amo"], thresh, gt) and _cmp(s["amr2"], thresh, gt))
        out[d] = dict(n=len(sel), o_maj=o_maj, r_maj=r_maj, both=both)
    return out

print()
print("=" * 100)
print("ROBUSTNESS 2  (multi-lab studies: replication classified male-majority")
print("               if >50% of its labs have male-majority teams; else > 0.5 rule)")
print("=" * 100)
views = lab_majority_views()
rob2 = summarize2(views)
# verify agreement with primary for multi-lab studies
mism = [v["id"] for v in views if v["is_multi"] and (v["amr"] > 0.5) != (v["amr2"] > 0.5)]
print("multi-lab ids whose lab-majority judgment differs from aggregated-row judgment:",
      len(mism), mism[:10])
multi = [v for v in views if v["is_multi"]]
print("multi-lab studies (n=%d): mean fraction of labs male-majority = %.3f"
      % (len(multi), sum(v["lab_frac"] for v in multi) / len(multi)))
print("multi-lab studies where aggregated ratio >0.5:", sum(1 for v in multi if v["amr"] > 0.5),
      "| where majority of labs male-majority:", sum(1 for v in multi if v["amr2"] > 0.5))
print("per-domain (robustness 2):")
print(fmt(rob2))

# ----------------------------------------------------------------------
# ROBUSTNESS 3: author-count weighted pooled male fraction per domain
#   pooled_male_frac = sum(ratio * n_authors) / sum(n_authors)
# ----------------------------------------------------------------------
print()
print("=" * 100)
print("ROBUSTNESS 3  (author-count weighted pooled male fraction per domain)")
print("=" * 100)
for d in DOMAINS:
    sel = [s for s in studies if s["discipline"] == d]
    o_num = sum(s["amo"] * s["nao"] for s in sel)
    o_den = sum(s["nao"] for s in sel)
    r_num = sum(s["amr"] * s["nar"] for s in sel)
    r_den = sum(s["nar"] for s in sel)
    print(f"{d:11s} n={len(sel):3d} | pooled-orig-male-frac={o_num/o_den:5.1%} "
          f"({o_num:.1f}/{o_den}) | pooled-repl-male-frac={r_num/r_den:5.1%} "
          f"({r_num:.1f}/{r_den}) | both>=50%={'YES' if o_num/o_den>=.5 and r_num/r_den>=.5 else 'no'}")

# ----------------------------------------------------------------------
# ROBUSTNESS 4a: row-level (all 927 rows) sensitivity
# ----------------------------------------------------------------------
print()
print("=" * 100)
print("ROBUSTNESS 4a (row-level, all 927 rows, threshold >0.5)")
print("=" * 100)
for d in DOMAINS:
    sel = [r for r in rows if r["discipline"] == d]
    n = len(sel)
    o_maj = sum(1 for r in sel if fnum(r["authors_male.o"]) > 0.5)
    r_maj = sum(1 for r in sel if fnum(r["authors_male.r"]) > 0.5)
    both = sum(1 for r in sel if fnum(r["authors_male.o"]) > 0.5 and fnum(r["authors_male.r"]) > 0.5)
    print(f"{d:11s} rows={n:4d} | orig_maj={o_maj:4d} ({o_maj/n:5.1%}) | "
          f"repl_maj={r_maj:4d} ({r_maj/n:5.1%}) | both_maj={both:4d} ({both/n:5.1%})")

# ----------------------------------------------------------------------
# ROBUSTNESS 4b: study-level by project (primary rule) - shows composition
# ----------------------------------------------------------------------
print()
print("=" * 100)
print("ROBUSTNESS 4b (study-level by project, primary >0.5 rule) -- composition check")
print("=" * 100)
for p in PROJECTS:
    sel = [s for s in studies if s["project"] == p]
    if not sel:
        continue
    o_maj = sum(1 for s in sel if s["amo"] > 0.5)
    r_maj = sum(1 for s in sel if s["amr"] > 0.5)
    both = sum(1 for s in sel if s["amo"] > 0.5 and s["amr"] > 0.5)
    disc = Counter(s["discipline"] for s in sel)
    print(f"{p:5s} n={len(sel):3d} disc={dict(disc)} | orig_maj={o_maj:3d} "
          f"repl_maj={r_maj:3d} both_maj={both:3d}")

# ----------------------------------------------------------------------
# Descriptive Fisher exact comparisons (study-level both-majority, Economics vs each)
# ----------------------------------------------------------------------
print()
print("=" * 100)
print("DESCRIPTIVE 2x2 comparisons (Fisher exact; study-level primary rule)")
print("both-majority-male vs not, Economics vs Cognitive and vs Social")
print("=" * 100)
def fisher2x2(a, b, c, d):
    # classic two-sided Fisher exact via direct hypergeometric enumeration
    r1, r2, c1, c2 = a + b, c + d, a + c, b + d
    n = r1 + r2
    def table_p(aa, bb, cc, dd):
        return (math.comb(r1, aa) * math.comb(r2, cc)) / math.comb(n, c1)
    p0 = table_p(a, b, c, d)
    total = 0.0
    lo = max(0, c1 - r2)
    hi = min(r1, c1)
    for aa in range(lo, hi + 1):
        bb = r1 - aa
        cc = c1 - aa
        dd = r2 - cc
        if aa < 0 or bb < 0 or cc < 0 or dd < 0:
            continue
        pi = table_p(aa, bb, cc, dd)
        if pi <= p0 + 1e-15:
            total += pi
    return total

ee = [s for s in studies if s["discipline"] == "Economics"]
both_ee = sum(1 for s in ee if s["amo"] > 0.5 and s["amr"] > 0.5)
for other in ["Cognitive", "Social"]:
    oth = [s for s in studies if s["discipline"] == other]
    both_ot = sum(1 for s in oth if s["amo"] > 0.5 and s["amr"] > 0.5)
    a, b = both_ee, len(ee) - both_ee
    c, d = both_ot, len(oth) - both_ot
    p = fisher2x2(a, b, c, d)
    print(f"Economics(both={a}/{a+b}) vs {other}(both={c}/{c+d}): two-sided Fisher p = {p:.4f}")

# ----------------------------------------------------------------------
# Summary of the answer-relevant numbers
# ----------------------------------------------------------------------
print()
print("=" * 100)
print("ANSWER SUMMARY (primary study-level >0.5 rule)")
print("=" * 100)
for d in DOMAINS:
    x = prim[d]
    print(f"{d}: {x['n']} studies | original majority-male: {x['o_maj']} ({x['o_maj']/x['n']:.1%}) | "
          f"replication majority-male: {x['r_maj']} ({x['r_maj']/x['n']:.1%}) | "
          f"BOTH majority-male: {x['both']} ({x['both']/x['n']:.1%})")

print()
print("DONE")
