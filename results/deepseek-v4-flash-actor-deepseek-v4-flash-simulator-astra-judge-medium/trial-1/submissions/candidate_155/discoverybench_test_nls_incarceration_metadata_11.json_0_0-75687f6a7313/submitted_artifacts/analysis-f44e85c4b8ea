import numpy as np
import pandas as pd

rng = np.random.default_rng(42)
df = pd.read_csv('data/nls_incarceration_processed.csv')
W = 'composite_wealth_1985'

def boot_median_ci(x, n_boot=4000, alpha=0.05):
    x = x.to_numpy(dtype=float)
    meds = np.array([np.median(rng.choice(x, size=len(x), replace=True)) for _ in range(n_boot)])
    lo, hi = np.percentile(meds, [100*alpha/2, 100*(1-alpha/2)])
    return np.median(x), lo, hi

def boot_median_diff_ci(x, y, n_boot=4000, alpha=0.05):
    x = x.to_numpy(dtype=float); y = y.to_numpy(dtype=float)
    diffs = np.array([np.median(rng.choice(x, size=len(x), replace=True))
                      - np.median(rng.choice(y, size=len(y), replace=True)) for _ in range(n_boot)])
    return np.median(diffs), np.percentile(diffs, [100*alpha/2, 100*(1-alpha/2)])

# ---------- 1) Background: jailed vs non-jailed ----------
print("="*70)
print("BACKGROUND: ever_jailed (1) vs not (0), composite_wealth_1985")
bg = df.groupby('ever_jailed')[W].agg(['count','median','mean'])
print(bg.round(1).to_string())

# ---------- 2) MAIN: within jailed (ever_jailed==1) by race, sex, race x sex ----------
j = df[df['ever_jailed'] == 1]

print("\n" + "="*70)
print("MAIN ANALYSIS: median wealth 1985 among EVER-JAILED (n=%d)" % len(j))
print("-"*70)
print("BY RACE")
rows = []
for r, g in j.groupby('race', sort=False):
    med, lo, hi = boot_median_ci(g[W])
    nz = (g[W] != 0).sum()
    med_nz, *_ = boot_median_ci(g[W][g[W] != 0])
    rows.append([r, len(g), med, lo, hi, nz, med_nz])
tab = pd.DataFrame(rows, columns=['race','n','median_main','ci_lo','ci_hi','n_nonzero','median_excl0'])
print(tab.round(1).to_string(index=False))

print("\nBY SEX")
rows = []
for s, g in j.groupby('sex', sort=False):
    med, lo, hi = boot_median_ci(g[W])
    nz = (g[W] != 0).sum()
    med_nz, *_ = boot_median_ci(g[W][g[W] != 0])
    rows.append([s, len(g), med, lo, hi, nz, med_nz])
tab = pd.DataFrame(rows, columns=['sex','n','median_main','ci_lo','ci_hi','n_nonzero','median_excl0'])
print(tab.round(1).to_string(index=False))

print("\nBY RACE x SEX")
rows = []
for (r, s), g in j.groupby(['race','sex'], sort=False):
    med, lo, hi = boot_median_ci(g[W])
    nz = (g[W] != 0).sum()
    med_nz, *_ = boot_median_ci(g[W][g[W] != 0])
    rows.append([r, s, len(g), med, lo, hi, nz, med_nz])
tab = pd.DataFrame(rows, columns=['race','sex','n','median_main','ci_lo','ci_hi','n_nonzero','median_excl0'])
print(tab.round(1).to_string(index=False))

# ---------- 3) Pairwise median differences within jailed, with bootstrap 95% CI ----------
print("\n" + "="*70)
print("PAIRWISE MEDIAN DIFFERENCES (main definition incl. zeros) with bootstrap 95% CI")
print("  diff = median(A) - median(B)")
def show_diff(a, b, la, lb):
    if len(a) == 0 or len(b) == 0:
        print(f"  {la} vs {lb}: insufficient data"); return
    d, (lo, hi) = boot_median_diff_ci(a[W], b[W])
    print(f"  {la} - {lb}: diff={d:9.2f}  (95% CI [{lo:9.2f}, {hi:9.2f}])  nA={len(a)}, nB={len(b)}")

print("-- race contrasts (all jailed) --")
show_diff(j[j.race=='white'], j[j.race=='black'], 'white', 'black')
show_diff(j[j.race=='white'], j[j.race=='hipanic'], 'white', 'hipanic')
show_diff(j[j.race=='black'], j[j.race=='hipanic'], 'black', 'hipanic')
print("-- sex contrast (all jailed) --")
show_diff(j[j.sex=='male'], j[j.sex=='female'], 'male', 'female')
print("-- race contrasts WITHIN MALES (largest cells) --")
jm = j[j.sex=='male']
show_diff(jm[jm.race=='white'], jm[jm.race=='black'], 'white(m)', 'black(m)')
show_diff(jm[jm.race=='white'], jm[jm.race=='hipanic'], 'white(m)', 'hipanic(m)')
print("-- white male reference vs black male / hispanic male --")
show_diff(jm[jm.race=='black'], jm[jm.race=='white'], 'black(m)', 'white(m)')
show_diff(jm[jm.race=='hipanic'], jm[jm.race=='white'], 'hipanic(m)', 'white(m)')

# ---------- 4) Sensitivity: excluding zero values -------------
print("\n" + "="*70)
print("SENSITIVITY: median wealth 1985 EXCLUDING ZERO values, within jailed, by race x sex")
rows = []
for (r, s), g in j.groupby(['race','sex'], sort=False):
    gz = g[g[W] != 0]
    if len(gz) == 0:
        rows.append([r, s, len(g), 0, None, None, 'no nonzeros'])
        continue
    med, lo, hi = boot_median_ci(gz[W])
    rows.append([r, s, len(g), len(gz), med, lo, hi, ''])
tab = pd.DataFrame(rows, columns=['race','sex','n_total','n_nonzero','median_excl0','ci_lo','ci_hi','note'])
print(tab.to_string(index=False))

# ---------- 5) Jailed share of zeros by group (context for medians) ----------
print("\n" + "="*70)
print("ZERO-WEALTH SHARE within jailed, by race x sex (context)")
print(j.groupby(['race','sex'])[W].apply(lambda x: f"{(x==0).mean()*100:.1f}%").unstack().to_string())
