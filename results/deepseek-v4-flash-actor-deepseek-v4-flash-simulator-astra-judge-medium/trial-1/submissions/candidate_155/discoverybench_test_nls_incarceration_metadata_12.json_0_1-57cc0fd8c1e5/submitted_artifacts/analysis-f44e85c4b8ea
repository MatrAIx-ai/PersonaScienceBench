"""
Main analysis: How does incarceration affect the wealth of black individuals
based on their income levels?

Data: NLSY79-derived nls_incarceration_processed.csv (12,013 x 6)
  - race, sex, ever_jailed (jailed 1985-1994), composite_wealth_1985/1990/1996

Design (approved):
  - 'income level' proxied by 1985 composite wealth; blacks stratified into
    tertiles (low/mid/high) on 1985 wealth.
  - Observational -> conditional association (NOT causality).
  - Primary metrics: median wealth trajectory, P(1996 wealth <= 0),
    mean & median change 1985->1996 (diff-in-diff style within tertile).
  - Secondary: sex-adjusted OLS; white/hispanic comparison; robustness
    (median-split, quartiles, log(wealth+1), bootstrap CIs).
"""
import pandas as pd
import numpy as np
import statsmodels.formula.api as smf

pd.set_option('display.width', 250)
pd.set_option('display.max_columns', 60)
pd.set_option('display.float_format', lambda v: f'{v:,.2f}')

np.random.seed(42)

DF = pd.read_csv('data/nls_incarceration_processed.csv')
W = ['composite_wealth_1985', 'composite_wealth_1990', 'composite_wealth_1996']

print('=' * 100)
print('0. DATA OVERVIEW')
print('=' * 100)
print('shape:', DF.shape, '| missing:', DF.isna().sum().sum())
print(DF.groupby(['race', 'ever_jailed']).size().unstack(fill_value=0))
print('total jailed:', DF['ever_jailed'].sum())

BL = DF[DF['race'] == 'black'].copy()
print('\nBlack sample n =', len(BL), '| jailed =', BL['ever_jailed'].sum())

# ------------------------------------------------------------------
# 1. Main stratification: tertiles of 1985 wealth within blacks
# ------------------------------------------------------------------
print('\n' + '=' * 100)
print('1. MAIN: BLACKS STRATIFIED BY 1985-WEALTH TERTILE x ever_jailed')
print('=' * 100)

BL['tertile'] = pd.qcut(BL['composite_wealth_1985'], 3,
                        labels=['low', 'mid', 'high'], duplicates='drop')
print('\nTertile bounds (1985 wealth):')
print(BL.groupby('tertile', observed=True)['composite_wealth_1985']
      .agg(['min', 'max', 'median', 'count']).round(0))

# --- wealth levels at each wave ---
print('\nMEDIAN wealth by tertile x jailed (rows):')
print(BL.groupby(['tertile', 'ever_jailed'], observed=True)[W].median().round(0).T)

print('\nMEAN wealth by tertile x jailed (rows):')
print(BL.groupby(['tertile', 'ever_jailed'], observed=True)[W].mean().round(0).T)

# --- change 1985->1996 (mean & median), diff-in-diff style ---
BL['d85_96'] = BL['composite_wealth_1996'] - BL['composite_wealth_1985']
BL['w96_nonpos'] = (BL['composite_wealth_1996'] <= 0).astype(float)
BL['w96_zero'] = (BL['composite_wealth_1996'] == 0).astype(float)

g = BL.groupby(['tertile', 'ever_jailed'], observed=True)
print('\nCHANGE 1985->1996 (mean, median, n) and P(W96<=0), P(W96=0):')
tab = pd.DataFrame({
    'n': g.size(),
    'd_mean': g['d85_96'].mean().round(0),
    'd_median': g['d85_96'].median().round(0),
    'w96_median': g['composite_wealth_1996'].median().round(0),
    'P_w96_le0': g['w96_nonpos'].mean().round(3),
    'P_w96_eq0': g['w96_zero'].mean().round(3),
})
print(tab)

print('\nDiff-in-Diff style association (jailed minus non-jailed) within tertile:')
for t in ['low', 'mid', 'high']:
    sub = BL[BL['tertile'] == t]
    j = sub[sub['ever_jailed'] == 1]['d85_96']
    nj = sub[sub['ever_jailed'] == 0]['d85_96']
    dd_mean = j.mean() - nj.mean()
    dd_med = j.median() - nj.median()
    dp = sub[sub['ever_jailed'] == 1]['w96_nonpos'].mean() - \
         sub[sub['ever_jailed'] == 0]['w96_nonpos'].mean()
    print(f"  {t:4s}: n(jailed)={len(j):3d}  "
          f"DeltaMean(85->96) diff = {dd_mean:12,.0f}  "
          f"DeltaMedian diff = {dd_med:8,.0f}  "
          f"P(W96<=0) diff = {dp:+.3f}")

# --- bootstrap percentile CIs for the mean DD ---
print('\nBootstrap 95% CI (1000 reps) for mean-change difference (jailed - non-jailed):')
def boot_ci(x, y, n=1000):
    r = np.empty(n)
    for i in range(n):
        xb = np.random.choice(x, size=len(x), replace=True)
        yb = np.random.choice(y, size=len(y), replace=True)
        r[i] = xb.mean() - yb.mean()
    return np.percentile(r, [2.5, 97.5])
for t in ['low', 'mid', 'high']:
    sub = BL[BL['tertile'] == t]
    j = sub[sub['ever_jailed'] == 1]['d85_96'].values
    nj = sub[sub['ever_jailed'] == 0]['d85_96'].values
    lo, hi = boot_ci(j, nj)
    print(f"  {t:4s}: mean delta diff = {j.mean()-nj.mean():12,.0f}  CI=[{lo:12,.0f}, {hi:12,.0f}]")

# ------------------------------------------------------------------
# 2. Sex-adjusted OLS (separate sex effect from incarceration)
# ------------------------------------------------------------------
print('\n' + '=' * 100)
print('2. SEX-ADJUSTED OLS: d85_96 ~ ever_jailed*tertile + sex  (black only)')
print('=' * 100)
BL['sex_male'] = (BL['sex'] == 'male').astype(int)
m = smf.ols('d85_96 ~ ever_jailed * C(tertile) + sex_male',
            data=BL).fit(cov_type='HC3')
print(m.summary2().tables[1].round(4))
print('\nInteraction p-values (tertile x jailed) indicate effect heterogeneity.')

print('\nLog-wealth (1996) regression for robustness (log W96 ~ jail*tertile + sex):')
BL2 = BL[BL['composite_wealth_1996'] > -1].copy()
BL2['log_w96'] = np.log1p(np.maximum(BL2['composite_wealth_1996'], 0))
m2 = smf.ols('log_w96 ~ ever_jailed * C(tertile) + sex_male', data=BL2).fit(cov_type='HC3')
print(m2.summary2().tables[1].round(4))

# ------------------------------------------------------------------
# 3. Race comparison (secondary context)
# ------------------------------------------------------------------
print('\n' + '=' * 100)
print('3. RACE COMPARISON (secondary): tertiles within each race')
print('=' * 100)
for race in ['black', 'hipanic', 'white']:
    sub = DF[DF['race'] == race].copy()
    sub['tertile'] = pd.qcut(sub['composite_wealth_1985'], 3,
                             labels=['low', 'mid', 'high'], duplicates='drop')
    sub['w96_nonpos'] = (sub['composite_wealth_1996'] <= 0).astype(float)
    g = sub.groupby(['tertile', 'ever_jailed'], observed=True)
    print(f"\n-- race={race} (n={len(sub)}, jailed={sub['ever_jailed'].sum()}) --")
    print(pd.DataFrame({
        'n': g.size(),
        'med_w85': g['composite_wealth_1985'].median().round(0),
        'med_w96': g['composite_wealth_1996'].median().round(0),
        'P_w96_le0': g['w96_nonpos'].mean().round(3),
    }))

# ------------------------------------------------------------------
# 4. Robustness: alternative cutpoints
# ------------------------------------------------------------------
print('\n' + '=' * 100)
print('4. ROBUSTNESS: median split & quartiles (blacks) - P(W1996<=0) & median 1996')
print('=' * 100)
for k, labels in [(2, ['below', 'above']), (4, ['q1', 'q2', 'q3', 'q4'])]:
    BR = BL.copy()
    BR['grp'] = pd.qcut(BR['composite_wealth_1985'], k, labels=labels,
                        duplicates='drop')
    g = BR.groupby(['grp', 'ever_jailed'], observed=True)
    print(f"\n{k}-quantile:")
    print(pd.DataFrame({
        'n': g.size(),
        'med_w96': g['composite_wealth_1996'].median().round(0),
        'P_w96_le0': g['w96_nonpos'].mean().round(3),
    }))

print('\nDone.')
