import pandas as pd

df = pd.read_csv('data/nls_incarceration_processed.csv')
wealth_cols = ['composite_wealth_1985','composite_wealth_1990','composite_wealth_1996']
years = [1985, 1990, 1996]

# 1) subset
bf = df[(df['race']=='black') & (df['sex']=='female')].copy()
print("black female sample size:", len(bf))

# 2) medians
med = bf[wealth_cols].median()
print("\nMedians:")
print(med.to_string())

# 3) interval absolute differences
d1 = med['composite_wealth_1990'] - med['composite_wealth_1985']   # 1985 -> 1990
d2 = med['composite_wealth_1996'] - med['composite_wealth_1990']   # 1990 -> 1996
print(f"\nInterval 1985->1990: delta = {d1:+,.2f}")
print(f"Interval 1990->1996: delta = {d2:+,.2f}")
print(f"Both positive (increase)? {d1>0 and d2>0}")

winner = '1985-1990' if abs(d1) > abs(d2) else '1990-1996'
print(f"Interval with larger absolute increase: {winner}")

# 4) robustness: relative (%) change
rel1 = (d1 / med['composite_wealth_1985']) * 100
rel2 = (d2 / med['composite_wealth_1990']) * 100
print(f"\n[Robustness] Relative increase (%): 1985->1990 = {rel1:+,.1f}%, 1990->1996 = {rel2:+,.1f}%")

# 5) robustness: annualized absolute change (5-yr vs 6-yr interval)
ann1 = d1 / (1990-1985)
ann2 = d2 / (1996-1990)
print(f"[Robustness] Annualized absolute change: 1985->1990 = {ann1:+,.2f}/yr, 1990->1996 = {ann2:+,.2f}/yr")

# signed ratio for transparency
print(f"\nRatio d1/d2 = {d1/d2:.3f}")
