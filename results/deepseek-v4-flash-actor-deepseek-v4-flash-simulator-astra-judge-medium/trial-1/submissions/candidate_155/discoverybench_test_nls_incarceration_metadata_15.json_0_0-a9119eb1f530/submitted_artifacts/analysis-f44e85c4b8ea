"""
DiscoveryBench: NLS Incarceration - Wealth inequality among white males and females, 1990 vs 1996.

Main analysis + robustness checks.
Author: research agent run for DiscoveryBench episode.
"""
import numpy as np
import pandas as pd

DATA = "data/nls_incarceration_processed.csv"

def gini(x):
    """Gini using relative-mean-difference form, denominator |mean|; handles 0 and negatives."""
    x = np.sort(np.asarray(x, dtype=float))
    n = len(x)
    if n == 0:
        return np.nan
    mu = x.mean()
    if mu == 0:
        return np.nan
    return np.mean(np.abs(x - mu)) / (2 * abs(mu))

def top_share(x, p):
    x = np.sort(np.asarray(x, dtype=float))[::-1]
    k = max(1, int(round(len(x) * p)))
    tot = x.sum()
    return x[:k].sum() / tot if tot > 0 else np.nan

def block_metrics(v):
    v = np.asarray(v, dtype=float)
    p = np.percentile(v, [10, 25, 50, 75, 90])
    return {
        "n": len(v),
        "gini": gini(v),
        "top10": top_share(v, 0.10),
        "top5": top_share(v, 0.05),
        "p90_p50": p[4] - p[2],
        "p75_p25": p[3] - p[1],
        "mean": v.mean(),
        "median": p[2],
        "p90": p[4],
        "p75": p[3],
        "p25": p[1],
        "zero_pct": (v == 0).mean() * 100,
        "neg_pct": (v < 0).mean() * 100,
        "nonpos_pct": (v <= 0).mean() * 100,
    }

def build_frame(sub, years, label):
    rows = []
    for yr in years:
        for s in ["female", "male"]:
            v = sub.loc[sub.sex == s, yr].values
            m = block_metrics(v)
            m.update(year=yr, sex=s, sample=label)
            rows.append(m)
    return pd.DataFrame(rows)

df = pd.read_csv(DATA)
w = df[df.race == "white"]
years = ["composite_wealth_1990", "composite_wealth_1996"]

# 1) Main: all white respondents, wealth at face value (incl. 0 and negatives)
main = build_frame(w, years, "main_all")

# 2) Sensitivity A: wealth>0 only
w_pos = w[(w.composite_wealth_1990 > 0) & (w.composite_wealth_1996 > 0)]
sensA = build_frame(w_pos, years, "sensA_pos_gt0")

# 3) Sensitivity B: exclude ever_jailed==1 (main wealth definition retained)
w_nojail = w[w.ever_jailed == 0]
sensB = build_frame(w_nojail, years, "sensB_no_jailed")

# 4) Sensitivity C: wealth>=0 (drop negatives only, keep zeros) -- extra robustness
w_nonneg = w[(w.composite_wealth_1990 >= 0) & (w.composite_wealth_1996 >= 0)]
sensC = build_frame(w_nonneg, years, "sensC_nonneg")

res = pd.concat([main, sensA, sensB, sensC], ignore_index=True)
res.to_csv("/workspace/analysis/inequality_metrics.csv", index=False)

pd.set_option("display.width", 260)
keys = ["sample", "year", "sex", "n", "gini", "top10", "top5", "p90_p50", "p75_p25",
        "mean", "median", "zero_pct", "neg_pct"]
print(res[keys].to_string(index=False))

# Change 1990->1996 per sample/sex
print("\n=== CHANGES 1990 -> 1996 ===")
for sample, g in res.groupby("sample"):
    for s in ["female", "male"]:
        a = g[(g.year == "composite_wealth_1990") & (g.sex == s)].iloc[0]
        b = g[(g.year == "composite_wealth_1996") & (g.sex == s)].iloc[0]
        print(f"[{sample}] {s}: d_gini={b['gini']-a['gini']:+.4f}  d_top10={b['top10']-a['top10']:+.4f}  "
              f"d_p90p50=${b['p90_p50']-a['p90_p50']:+,.0f}  d_p75p25=${b['p75_p25']-a['p75_p25']:+,.0f}  "
              f"d_mean=${b['mean']-a['mean']:+,.0f}  d_median=${b['median']-a['median']:+,.0f}  "
              f"d_zero={b['zero_pct']-a['zero_pct']:+.1f}pp  d_neg={b['neg_pct']-a['neg_pct']:+.1f}pp")

# Male-vs-female relative inequality gap (gini_male - gini_female, and ratio)
print("\n=== SEX GAP (male - female) in Gini ===")
for sample, g in res.groupby("sample"):
    for yr in years:
        mf = g[(g.year == yr) & (g.sex == "female")].iloc[0].gini
        mm = g[(g.year == yr) & (g.sex == "male")].iloc[0].gini
        print(f"[{sample}] {yr}: male_gini={mm:.4f} female_gini={mf:.4f} gap(m-f)={mm-mf:+.4f}")
