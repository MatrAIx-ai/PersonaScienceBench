"""
Final analysis: nls_incarceration wealth by ever_jailed (criminal-record proxy).
Primary: two-sided Mann-Whitney U per year (1985/1990/1996), Holm-Bonferroni correction.
Effect size: Hodges-Lehmann median difference + rank-based 95% CI + bootstrap CI.
Robustness: permutation test (mean difference) and median quantile regression (race, sex).
"""
import numpy as np
import pandas as pd
from scipy import stats
from statsmodels.stats.multitest import multipletests
from statsmodels.formula.api import quantreg

rng = np.random.default_rng(12345)
df = pd.read_csv("data/nls_incarceration_processed.csv")
years = ["composite_wealth_1985", "composite_wealth_1990", "composite_wealth_1996"]
g0 = df["ever_jailed"] == 0
g1 = df["ever_jailed"] == 1
print("n0, n1:", int(g0.sum()), int(g1.sum()))

def hl_estimate(x, y):
    """Two-sample Hodges-Lehmann estimator = median of pairwise differences x - y."""
    w = (x[:, None] - y[None, :]).ravel()
    return np.median(w)

def hl_ci(x, y, alpha=0.05):
    """Rank-based 1-alpha CI for the two-sample HL shift (Hodges-Lehmann) estimator."""
    n, m = len(x), len(y)
    w = np.sort((x[:, None] - y[None, :]).ravel())
    z = stats.norm.ppf(1 - alpha / 2)
    c = int(np.floor(n * m / 2 - z * np.sqrt(n * m * (n + m + 1) / 12) - 0.5))
    return w[max(c, 0)], w[min(len(w) - 1, n * m - c + 1)]

def permutation_mean_diff(x, y, n_perm=5000):
    """Permutation test for H0: mean equal (two-sided), pooled labels."""
    obs = x.mean() - y.mean()
    pooled = np.concatenate([x, y])
    nx = len(x)
    cnt = 0
    for _ in range(n_perm):
        perm = rng.permutation(pooled)
        d = perm[:nx].mean() - perm[nx:].mean()
        if abs(d) >= abs(obs):
            cnt += 1
    return obs, (cnt + 1) / (n_perm + 1)

def bootstrap_median_diff(x, y, B=5000, alpha=0.05):
    obs = np.median(x) - np.median(y)
    bs = np.empty(B)
    for b in range(B):
        bx = rng.choice(x, size=len(x), replace=True)
        by = rng.choice(y, size=len(y), replace=True)
        bs[b] = np.median(bx) - np.median(by)
    lo, hi = np.percentile(bs, [100 * alpha / 2, 100 * (1 - alpha / 2)])
    return obs, lo, hi

print("\n" + "=" * 100)
print("PRIMARY: two-sided Mann-Whitney U per year + Holm-Bonferroni across the 3 years")
print("=" * 100)
rows = []
for y in years:
    x = df.loc[g0, y].to_numpy()   # no criminal record (ever_jailed=0)
    yv = df.loc[g1, y].to_numpy()  # criminal-record proxy (ever_jailed=1)
    u, p = stats.mannwhitneyu(x, yv, alternative="two-sided")
    rows.append({"year": y, "U": u, "p_raw": p,
                 "med0": np.median(x), "med1": np.median(yv),
                 "mean0": x.mean(), "mean1": yv.mean()})
table = pd.DataFrame(rows)
table["p_holm"] = multipletests(table["p_raw"], method="holm")[1]
# direction: jailed group lower if med/mean lower AND p significant
verdict = []
for r in table.itertuples():
    lower = (r.med1 < r.med0) and (r.mean1 < r.mean0)
    sig = (r.p_holm < 0.05) and (r.p_raw < 0.05)
    verdict.append("SIGNIFICANTLY LOWER" if (sig and lower) else
                   ("sig but NOT lower direction" if sig else "not significant"))
table["verdict"] = verdict
pd.set_option("display.width", 200)
print(table.to_string(index=False))

print("\n" + "=" * 100)
print("EFFECT SIZE: medians, IQR, Hodges-Lehmann median diff + rank-based 95% CI + bootstrap CI")
print("=" * 100)
for y in years:
    x = df.loc[g0, y].to_numpy(); yv = df.loc[g1, y].to_numpy()
    hl = hl_estimate(yv, x)                      # (jailed - not jailed), negative => lower
    lo, hi = hl_ci(yv, x)
    bo, blo, bhi = bootstrap_median_diff(yv, x)
    print(f"\n{y}")
    print(f"  no-record : n={len(x)} median={np.median(x):.0f} IQR=[{np.quantile(x,.25):.0f},{np.quantile(x,.75):.0f}] mean={x.mean():.0f}")
    print(f"  jailed    : n={len(yv)} median={np.median(yv):.0f} IQR=[{np.quantile(yv,.25):.0f},{np.quantile(yv,.75):.0f}] mean={yv.mean():.0f}")
    print(f"  HL median diff (jailed - no): {hl:.0f}   95% CI(rank) [{lo:.0f}, {hi:.0f}]")
    print(f"  boot median diff            : {bo:.0f}   95% CI(boot) [{blo:.0f}, {bhi:.0f}]")
    obs_d, p_perm = permutation_mean_diff(yv, x)
    print(f"  permutation test (mean diff jailed-no={obs_d:.0f}) p={p_perm:.4f}")

print("\n" + "=" * 100)
print("SENSITIVITY: composition by ever_jailed + median quantile regression (race, sex)")
print("=" * 100)
comp = df.groupby("ever_jailed")[["race", "sex"]].apply(
    lambda d: d.value_counts().to_dict(), include_groups=False)
print(comp)
for y in years:
    m = quantreg(f"{y} ~ ever_jailed + C(race) + C(sex)", df).fit(q=0.5, max_iter=2000)
    print(f"\n{y}: Ever_jailed coeff (median, adj) = {m.params['ever_jailed']:.1f}, "
          f"p = {m.pvalues['ever_jailed']:.4f}")

print("\nDONE")
