"""Descriptive inspection of nls_incarceration_processed.csv (planning stage)."""
import pandas as pd
import numpy as np

df = pd.read_csv("data/nls_incarceration_processed.csv")
print("Shape:", df.shape)
print("\n--- dtypes ---"); print(df.dtypes)
print("\n--- missing ---"); print(df.isna().sum())
print("\n--- categorical ---")
for c in ["race","sex","ever_jailed"]:
    print(c, df[c].value_counts(dropna=False).to_dict())
wealth = ["composite_wealth_1985","composite_wealth_1990","composite_wealth_1996"]
print("\n--- numeric describe (raw) ---")
print(df[wealth].describe().T)
print("\n--- sign split per wealth col ---")
for c in wealth:
    print(c, "neg:", int((df[c]<0).sum()), "zero:", int((df[c]==0).sum()), "pos:", int((df[c]>0).sum()))

print("\n--- group by ever_jailed, per year ---")
for w in wealth:
    print("="*70); print(w)
    for ej in [0,1]:
        s = df.loc[df["ever_jailed"]==ej, w]
        print(f"  ever_jailed={ej}: n={len(s)}, mean={s.mean():.2f}, median={s.median():.2f}, "
              f"Q25={s.quantile(.25):.2f}, Q75={s.quantile(.75):.2f}, "
              f"min={s.min():.2f}, max={s.max():.2f}, skew={s.skew():.2f}")
