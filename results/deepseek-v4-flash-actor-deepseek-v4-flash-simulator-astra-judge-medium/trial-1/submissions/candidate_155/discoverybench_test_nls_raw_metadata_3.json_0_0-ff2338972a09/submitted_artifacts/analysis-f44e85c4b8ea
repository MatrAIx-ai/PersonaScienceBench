"""Main analysis (approved plan). Outcome = PROXY for BA track: dorm/fraternity/sorority residence (value 3)
in college-age windows = 4-year college / Bachelor-track participation. Academic characteristics: ASVAB
composite 1981 + class-rank percentile 1981. SES: z-composite of log(1979 family income) & max parental
education; net wealth 1996 & savings 1989 (time-preference) as sensitivity. Race: Black/Hispanic vs
Non-Black Non-Hispanic. Nested logistic regression, same-caliber reduced vs full; attenuation %, mediation
share, bootstrap CI of (b_full-b_red). Descriptive/associational only.
"""
import numpy as np, pandas as pd, warnings
import statsmodels.api as sm
warnings.filterwarnings('ignore')

rng = np.random.default_rng(42)
df = pd.read_csv('data/nls_raw.csv')
res_cols = [c for c in df.columns if c.startswith('Type of residence')]

def window_outcome(years):
    cols = [c for c in res_cols if c[-4:] in [str(y) for y in years]]
    sub = df[cols]; seen = sub.notna().any(axis=1)
    y = sub.eq(3).any(axis=1).astype(int)
    return pd.Series(np.where(seen, y.values, np.nan), index=df.index)

df['outcome_8184'] = window_outcome([1981,1982,1983,1984])
df['outcome_8186'] = window_outcome([1981,1982,1983,1984,1985,1986])
df['ever_jail'] = df[res_cols].eq(5).any(axis=1).astype(int)

df['black'] = (df['Racial/ethnic cohort, 1979']==1).astype(int)
df['hisp']  = (df['Racial/ethnic cohort, 1979']==2).astype(int)
df['female']= (df['Sex of respondent, 1979']==2).astype(int)
df['log_finc79'] = np.log1p(df['Total net family income, previous calendar year, 1979'])
df['parent_edu'] = df[["Highest grade completed by respondent's mother, 1979",
                       "Highest grade completed by respondent's father, 1979"]].max(axis=1)
asv = ['ASVAB - Arithmetic Reasoning Z Score (rounded), 1981','ASVAB - Word Knowledge Z Score (rounded), 1981',
       'ASVAB - Paragraph Comprehension Z Score (rounded), 1981','ASVAB - Mathematics Knowledge Z Score (rounded), 1981']
df['asvab_mean'] = df[asv].mean(axis=1)
df['rank_pct_better'] = 1 - df['Rank in class last year attended at this school, 1981']/(df['Number of students in class last year attended at this school, 1981']+1)
df['savings_putmore'] = (df['Was more money put into or taken out of R/spouse savings since last interview, 1989']==1).astype(int)
df['nw1996'] = df['Family net wealth, 1996 (key data point)']

base_vars = ['log_finc79','parent_edu','asvab_mean','Age of respondent, 1979','female','Family size, 1979','ever_jail']
def prep(ycol, require_rank):
    cols = ['black','hisp'] + base_vars + [ycol] + (['rank_pct_better'] if require_rank else [])
    S = df[cols].dropna().copy()
    for v in ['log_finc79','parent_edu','asvab_mean','Age of respondent, 1979','Family size, 1979']:
        S[v+'_z'] = (S[v]-S[v].mean())/S[v].std()
    if require_rank:
        S['rank_z'] = (S['rank_pct_better']-S['rank_pct_better'].mean())/S['rank_pct_better'].std()
    S['ses_z'] = (S['log_finc79_z']+S['parent_edu_z'])/np.sqrt(2)
    S['y'] = S[ycol].astype(int)
    return S

S_rank = prep('outcome_8184', True);  S_base = prep('outcome_8184', False)
W_rank = prep('outcome_8186', True);  W_base = prep('outcome_8186', False)
print('Samples | n | events | rate')
for nm,s in [('S_rank',S_rank),('S_base',S_base),('W_rank',W_rank),('W_base',W_base)]:
    print(f'  {nm:7s} {len(s):5d} {s.y.sum():5d} {s.y.mean():.3f}')

def fit(S, acad, drop_jail=False):
    cols = ['black','hisp','ses_z','Age of respondent, 1979_z','female','Family size, 1979_z'] + ([] if drop_jail else ['ever_jail'])
    if acad:
        cols += ['asvab_mean_z'] + (['rank_z'] if 'rank_z' in S.columns else [])
    X = sm.add_constant(S[cols]); y = S['y']
    for method in ['newton','bfgs']:
        try:
            m = sm.Logit(y, X).fit(disp=0, method=method, maxiter=1000)
            if m.mle_retvals.get('converged', True) and np.isfinite(m.params).all():
                return m
        except Exception:
            pass
    return None

def pair(S, acad, label):
    mr = fit(S, False); mf = fit(S, acad)
    if mr is None or mf is None:
        return dict(label=label, rows=[], n=len(S), events=int(S.y.sum()), pr2_red=np.nan, pr2_full=np.nan)
    rows=[]
    for nm in ['black','hisp','ses_z']:
        br, bf = mr.params[nm], mf.params[nm]
        att = (br-bf)/br
        rows.append(dict(name=nm, b_red=br, se_red=mr.bse[nm], p_red=mr.pvalues[nm],
                         b_full=bf, se_full=mf.bse[nm], p_full=mf.pvalues[nm],
                         OR_red=np.exp(br), OR_full=np.exp(bf), atten=att))
    return dict(label=label, rows=rows, n=int(mr.nobs), events=int(S.y.sum()),
                pr2_red=mr.prsquared, pr2_full=mf.prsquared)

def boot(S, acad, iters=400):
    deltas={k:[] for k in ['black','hisp','ses_z']}
    N=len(S)
    for _ in range(iters):
        B = S.iloc[rng.integers(0,N,N)]
        m1 = fit(B,False); m2 = fit(B,acad)
        if m1 is None or m2 is None: continue
        for k in deltas: deltas[k].append(m2.params.get(k)-m1.params.get(k))
    out={}
    for k,v in deltas.items():
        v=np.array(v); 
        if len(v)<100: out[k]=(np.nan,np.nan,0)
        else:
            lo,hi=np.percentile(v,[2.5,97.5]); out[k]=(lo,hi,int(not(lo<=0<=hi)))
    return out

def show(res, boot):
    print('\n'+'='*88)
    print(f"SETTING {res['label']}: n={res['n']}, events={res['events']}, McFaddenR2 {res['pr2_red']:.3f} -> {res['pr2_full']:.3f}")
    print(f"{'coef':<8}{'b_red':>8}{'OR_red':>8}{'p_red':>7}{'b_full':>8}{'OR_full':>8}{'p_full':>7}{'atten%':>8}{'medShare%':>10}{'bootCI(delta)':>18}{'sig':>4}")
    for r in res['rows']:
        med = 100*(r['b_red']-r['b_full'])/r['b_red']
        bd = boot.get(r['name'],(np.nan,np.nan,0))
        sig = '*' if (bd[2]==1 and not np.isnan(bd[0])) else ''
        print(f"{r['name']:<8}{r['b_red']:>8.3f}{r['OR_red']:>8.2f}{r['p_red']:>7.3f}{r['b_full']:>8.3f}{r['OR_full']:>8.2f}{r['p_full']:>7.3f}{r['atten']*100:>8.1f}{med:>10.1f}[{bd[0]:>6.3f},{bd[1]:>6.3f}]{sig:>4}")

pairs = [('A primary 81-84 WITH class rank', S_rank, True),
         ('B primary 81-84 ASVAB only (no rank, larger N)', S_base, True),
         ('C sensitivity window 81-86 WITH class rank', W_rank, True),
         ('D sensitivity window 81-86 ASVAB only', W_base, True)]
res_all={}
for lab,S,acad in pairs:
    r = pair(S, acad, lab); r['boot']=boot(S,acad)
    res_all[lab]=r; show(r, r['boot'])

# ================= SENSITIVITY ANALYSES =================
def add_sens_cols(S, extra):
    S = S.copy()
    for v,expr in extra.items():
        # merge from df by index
        S[v] = df.loc[S.index, expr]
    return S

def fit_extra(S, extra_cols):
    cols = ['black','hisp','ses_z','Age of respondent, 1979_z','female','Family size, 1979_z','ever_jail',
            'asvab_mean_z'] + extra_cols
    cols = [c for c in cols if c in S.columns]
    X = sm.add_constant(S[cols])
    for method in ['newton','bfgs']:
        try:
            m = sm.Logit(S['y'],X).fit(disp=0,method=method,maxiter=1000)
            if m.mle_retvals.get('converged',True): return m
        except Exception: pass
    return None

print('\n'+'#'*88)
print('# ACADEMIC CHARACTERISTIC EFFECT SIZES in full models')
for lab,S,acad in pairs:
    m = fit(S, acad)
    print(f'  {lab}:')
    for v in ['asvab_mean_z','rank_z']:
        if v in m.params: print(f'    {v:12s} OR={np.exp(m.params[v]):.2f} p={m.pvalues[v]:.3f}')

print('\n'+'#'*88)
print('# SENSITIVITY 1: full model + time-preference(savings 1989) and + net wealth 1996 (endogenous, flag)')
S = S_base.copy()
# merge savings (time-preference proxy) and net wealth 1996 from df, then z-score on nonmissing
S['savings_putmore'] = df.loc[S.index, 'savings_putmore']
S['nw1996'] = df.loc[S.index, 'nw1996']
Ss = S.dropna(subset=['savings_putmore','nw1996']).copy()
Ss['nw1996_z'] = (Ss['nw1996']-Ss['nw1996'].mean())/Ss['nw1996'].std()
m0 = fit(Ss, True)                       # full (asvab-only) model on the same sample
m1 = fit_extra(Ss, ['savings_putmore','nw1996_z'])
print('  n(same sample)=%d  events=%d' % (len(Ss), int(Ss.y.sum())))
for nm in ['black','hisp','ses_z']:
    if m0 is not None:
        print(f"  {nm:6s} full-base b={m0.params[nm]:.3f}(p={m0.pvalues[nm]:.3f}) | +timepref/wealth b={m1.params[nm]:.3f}(p={m1.pvalues[nm]:.3f})")
    else:
        print(f'  {nm:6s} model did not converge')
if m1 is not None:
    print('  savings_putmore OR=%.2f p=%.3f ; nw1996_z OR=%.2f p=%.3f' % (
        np.exp(m1.params['savings_putmore']), m1.pvalues['savings_putmore'],
        np.exp(m1.params['nw1996_z']), m1.pvalues['nw1996_z']))

print('\n'+'#'*88)
print('# SENSITIVITY 2: exclusion of ever-jail respondents (incarceration robustness)')
for lab,S,acad in [('A (81-84, rank)',S_rank,True),('B (81-84, asvab only)',S_base,True)]:
    Sx = S[S.ever_jail==0]
    mr = fit(Sx,False,drop_jail=True); mf = fit(Sx,acad,drop_jail=True)
    print(f"  {lab}: n={len(Sx)}, events={Sx.y.sum()}")
    if mr is None or mf is None:
        print('    (did not converge)'); continue
    for nm in ['black','hisp','ses_z']:
        att = (mr.params[nm]-mf.params[nm])/mr.params[nm]
        print(f"    {nm:6s} b_red={mr.params[nm]:.3f}(p={mr.pvalues[nm]:.3f}) b_full={mf.params[nm]:.3f}(p={mf.pvalues[nm]:.3f}) atten={att*100:.1f}%")

print('\n'+'#'*88)
print('# SENSITIVITY 3: SES components (log income, parent edu) entered separately, full model (base sample)')
