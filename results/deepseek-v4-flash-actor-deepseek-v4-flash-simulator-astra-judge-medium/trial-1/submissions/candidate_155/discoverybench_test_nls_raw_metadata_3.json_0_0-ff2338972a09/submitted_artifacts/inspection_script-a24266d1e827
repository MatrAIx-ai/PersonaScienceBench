"""
Plan-stage data inspection for NLSY79 raw data (discoverybench episode).
Descriptive only; no formal modeling at this stage.
"""
import pandas as pd

df = pd.read_csv('data/nls_raw.csv')
print('Shape:', df.shape)
print('Columns:', len(df.columns))

# race / sex / age
print('\n[RACE]'); print(df['Racial/ethnic cohort, 1979'].value_counts().sort_index())
print('\n[SEX]'); print(df['Sex of respondent, 1979'].value_counts().sort_index())
print('\n[AGE 1979]'); print(df['Age of respondent, 1979'].value_counts().sort_index())

# education (only attainment field is 1979)
g = df['Highest grade completed, 1979']
print('\n[HIGHEST GRADE 1979]'); print(g.describe())
print('>=16 (BA-level):', (g >= 16).sum(), ' | >=13:', (g >= 13).sum(), ' | special code 95:', (g == 95).sum())

# check for any post-1979 attainment column
key = ['grade','school','educ','degree','diploma','college','enroll','attain','university']
edu_cols = [c for c in df.columns if any(k in c.lower() for k in key)]
print('\n[EDUCATION-RELATED COLUMNS]'); [print(' -', c) for c in edu_cols]

# parental education
print('\n[PARENT EDU] mother:', df["Highest grade completed by respondent's mother, 1979"].describe().round(2).to_dict())
print(' father:', df["Highest grade completed by respondent's father, 1979"].describe().round(2).to_dict())

# income
for c in ['Total net family income, previous calendar year, 1979',
          'Total net family income, previous calendar year, 1985',
          'Total net family income, previous calendar year, 1989']:
    print('\n[%s]' % c); print(df[c].describe().round(1)); print('missing:', df[c].isna().sum())

# wealth
for c in ['Family net wealth, 1985', 'Family net wealth, 1990', 'Family net wealth, 1996 (key data point)']:
    print('\n[%s]' % c); print(df[c].describe().round(1)); print('missing:', df[c].isna().sum(), '| share<=0:', (df[c] <= 0).mean().round(3))

# ASVAB
asv = [c for c in df.columns if c.startswith('ASVAB')]
print('\n[ASVAB 1981]'); print(df[asv].describe().round(1).T)

# class rank
print('\n[RANK 1981]'); print(df['Rank in class last year attended at this school, 1981'].describe().round(1))
print('[CLASS SIZE 1981]'); print(df['Number of students in class last year attended at this school, 1981'].describe().round(1))

# residence
res = [c for c in df.columns if c.startswith('Type of residence')]
print('\n[RESIDENCE: dorm(3)/jail(5) counts per year]')
for c in res:
    print(c[-5:], 'nonmissing=', df[c].notna().sum(), 'dorm3=', (df[c] == 3).sum(), 'jail5=', (df[c] == 5).sum())
res81_84 = [c for c in res if c[-4:] in ['1981','1982','1983','1984']]
df['ever_dorm_8184'] = df[res81_84].isin([3]).any(axis=1).astype(int)
df['any_jail'] = df[res].isin([5]).any(axis=1).astype(int)
print('ever dorm 1981-84:', df['ever_dorm_8184'].sum(), '| ever jail 1981-96:', df['any_jail'].sum())

# savings
c = 'Was more money put into or taken out of R/spouse savings since last interview, 1989'
print('\n[SAVINGS CATEGORY 1989]'); print(df[c].value_counts(dropna=False).sort_index())

# criminal records
for c in ['Ever convicted of an illegal act in adult court before 1980',
          'Ever been sentenced in any correctional institution before 1980']:
    print('\n[%s]' % c); print(df[c].value_counts(dropna=False).sort_index())

# bivariate grounding
race_map = {1:'BLACK',2:'HISPANIC',3:'NON-BLACK NON-HISP'}
df['race'] = df['Racial/ethnic cohort, 1979'].map(race_map)
df['asvab_mean'] = df[asv].mean(axis=1)
print('\n[BY RACE: n / dorm-rate / jail-rate / some-college / ASVABmean]')
print(df.groupby('race').agg(n=('ID# (range 1-12686) 1979','size'),
      dorm_rate=('ever_dorm_8184','mean'), jail_rate=('any_jail','mean'),
      some_college=('Highest grade completed, 1979', lambda s:(s>=13).mean()),
      asvab=('asvab_mean','mean')).round(3))
print('\n[BY INCOME QUARTILE: dorm-rate]')
inc = df['Total net family income, previous calendar year, 1979']
q = pd.qcut(inc.rank(method='first'), 4, labels=['Q1(low)','Q2','Q3','Q4(high)'])
print(df.assign(iq=q).groupby('iq', observed=True)['ever_dorm_8184'].agg(['mean','count']).round(4))
print('\n[BY PARENTAL EDUGRP: dorm-rate]')
pe = df[["Highest grade completed by respondent's mother, 1979","Highest grade completed by respondent's father, 1979"]].max(axis=1)
print(df.assign(pb=pd.cut(pe,[0,8,12,16,20],labels=['<=8','9-12','13-16','17+'])).groupby('pb',observed=True)['ever_dorm_8184'].agg(['mean','count']).round(4))
print('\nDONE - descriptive inspection complete (no modeling performed).')
