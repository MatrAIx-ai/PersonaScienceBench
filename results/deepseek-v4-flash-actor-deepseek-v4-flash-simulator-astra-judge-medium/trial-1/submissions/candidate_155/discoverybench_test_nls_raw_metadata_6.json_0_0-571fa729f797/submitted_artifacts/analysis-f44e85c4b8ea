df['wealth85']  = df['Family net wealth, 1985']

an = df[df['Racial/ethnic cohort, 1979'].isin([1,3])].copy()   # BLACK + NBNH (primary)

def composite_z(sub, comps, min_avail=2):
    t = pd.DataFrame(index=sub.index)
    for c in comps:
        v = pd.to_numeric(sub[c], errors='coerce')
        t[c] = (v - v.mean()) / v.std()
    n_avail = t.notna().sum(axis=1)
    out = t.mean(axis=1)
    return out.where(n_avail >= min_avail)

an['ses_z'] = composite_z(an, ['loginc','moth','fath'])
ancc = an.dropna(subset=['HG79','ses_z']).copy()
q1, q2 = ancc['ses_z'].quantile([1/3, 2/3])
