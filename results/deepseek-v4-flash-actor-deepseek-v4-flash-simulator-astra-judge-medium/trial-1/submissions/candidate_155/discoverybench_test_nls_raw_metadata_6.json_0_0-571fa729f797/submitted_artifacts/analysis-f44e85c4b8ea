print('\n================ PART D: BOOTSTRAP CI (age>=20 headline gaps) ================')
def bootstrap_gap(sub, B=1000, seed=42):
    rng=np.random.default_rng(seed)
    res={s:[] for s in ['Low','Mid','High']}
    idx=sub.index.values
    for _ in range(B):
        ridx=rng.choice(idx, size=len(idx), replace=True)
        b=sub.loc[ridx]
        for s in ['Low','Mid','High']:
            bb=b[(b['ses']==s)&(b['cohort']=='BLACK')]['AC']
            ww=b[(b['ses']==s)&(b['cohort']=='NBNH')]['AC']
            if len(bb) and len(ww): res[s].append(bb.mean()-ww.mean())
    return {s:(round(np.mean(a),4), round(np.percentile(a,2.5),4), round(np.percentile(a,97.5),4)) for s,a in res.items()}
