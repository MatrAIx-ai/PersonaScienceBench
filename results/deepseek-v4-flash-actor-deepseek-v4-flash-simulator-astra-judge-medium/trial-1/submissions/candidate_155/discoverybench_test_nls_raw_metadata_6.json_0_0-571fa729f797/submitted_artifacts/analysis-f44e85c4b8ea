def tertiary(sub, comp):
    sub = sub.copy()
    cc = sub.dropna(subset=['HG79', comp])
    c1, c2 = cc[comp].quantile([1/3,2/3])
    sub['ses'] = pd.cut(sub[comp], [-np.inf,c1,c2,np.inf], labels=['Low','Mid','High'])
    return sub.dropna(subset=['HG79','ses','age','male'])

