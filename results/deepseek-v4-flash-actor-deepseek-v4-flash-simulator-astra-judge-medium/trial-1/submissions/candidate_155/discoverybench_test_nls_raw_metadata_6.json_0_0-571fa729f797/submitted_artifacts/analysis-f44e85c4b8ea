print('\n[C3] MICE-lite (5 imputations of loginc/moth/fath), pooled gaps:')
def mice_ses(df_in, n_imp=5, n_iter=10, seed=42):
    cols = ['loginc','moth','fath']
    Xc = df_in[['age','male','black']].values
    imps=[]
    for m in range(n_imp):
        imp = df_in[cols].copy()
        for c in cols: imp[c] = imp[c].fillna(imp[c].mean())
        rng = np.random.default_rng(seed+999*m)
        for _ in range(n_iter):
            for c in cols:
                mask = df_in[c].notna().values
                others = [x for x in cols if x!=c]
                X = np.column_stack([Xc, imp[others].values])
                A = np.column_stack([np.ones(len(X)), X])
                beta,_,_,_ = np.linalg.lstsq(A[mask], df_in[c].values[mask], rcond=None)
                resid = df_in[c].values[mask] - A[mask]@beta
                sigma = np.std(resid)
                miss = ~mask
                imp.loc[miss, c] = (A[miss]@beta) + rng.normal(0, sigma, size=miss.sum())
        imps.append(imp)
    return imps

def pooled_gaps(an_orig, n_imp=5, min_age=14):
    imps = mice_ses(an_orig, n_imp=n_imp)
    out=pd.DataFrame(index=range(n_imp), columns=['Low','Mid','High'])
    for m,imp in enumerate(imps):
        t = an_orig[['HG79','AC','black','cohort','age','male']].copy()
        t['loginc']=imp['loginc'].values; t['moth']=imp['moth'].values; t['fath']=imp['fath'].values
        z = pd.DataFrame()
        for c in ['loginc','moth','fath']:
            v=t[c]; z[c]=(v-v.mean())/v.std()
        t['ses_z']=z.mean(axis=1)
        cc = t.dropna(subset=['HG79']); cc = cc[cc['age']>=min_age]
        c1,c2 = cc['ses_z'].quantile([1/3,2/3])
        t['ses']=pd.cut(t['ses_z'],[-np.inf,c1,c2,np.inf], labels=['Low','Mid','High'])
        t=t.dropna(subset=['ses']); t=t[t['age']>=min_age]
        for i,s in enumerate(['Low','Mid','High']):
            b=t[(t['ses']==s)&(t['cohort']=='BLACK')]['AC'].mean()
            w=t[(t['ses']==s)&(t['cohort']=='NBNH')]['AC'].mean()
            out.loc[m,s]=b-w
    return out.mean()
