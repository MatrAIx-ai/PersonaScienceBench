def summarize(sub, label):
    rows=[]
    for s in ['Low','Mid','High']:
        for c in ['NBNH','BLACK']:
            d = sub[(sub['ses']==s)&(sub['cohort']==c)]
            n=len(d)
            ac = d['AC'].mean() if n else np.nan
            ba = d['BA'].mean() if n else np.nan
            hg = d['HG79'].mean() if n else np.nan
            rows.append({'sample':label,'SES':s,'cohort':c,'n':n,'anycollege13':round(ac,4),
                         'BA16(desc)':round(ba,4),'HG_mean':round(hg,3)})
    return pd.DataFrame(rows)

def gaps_table(sub, label):
    out=[]
    for s in ['Low','Mid','High']:
        b = sub[(sub['ses']==s)&(sub['cohort']=='BLACK')]
        w = sub[(sub['ses']==s)&(sub['cohort']=='NBNH')]
        if len(b)==0 or len(w)==0: continue
        pb, pw = b['AC'].mean(), w['AC'].mean()
        n_b, n_w = len(b), len(w)
        se = np.sqrt(pb*(1-pb)/n_b + pw*(1-pw)/n_w)
        gap = pb - pw
        out.append({'sample':label,'SES':s,'Black_n':n_b,'NBNH_n':n_w,
                    'Black_rate':round(pb,4),'NBNH_rate':round(pw,4),
                    'Gap(B-W)':round(gap,4),'se':round(se,4),
                    'CI95':f'({round(gap-1.96*se,3)}, {round(gap+1.96*se,3)})'})
    return pd.DataFrame(out)

def run_model(sub, formula, outcome='AC'):
    d = sub.copy()
    if outcome=='AC': m = smf.logit(formula, data=d).fit(disp=False)
    else:             m = smf.ols(formula, data=d).fit()
    return m, d

def model_gaps(m, d, outcome='AC'):
    out={}
    for s in ['Low','Mid','High']:
        d0 = d.copy(); d1 = d.copy()
        d0['ses']=s; d0['black']=0.0
        d1['ses']=s; d1['black']=1.0
        p0 = m.predict(d0); p1 = m.predict(d1)
        out[s] = np.mean(p1-p0)
    return out

