"""Scoping pass for NLSY79 raw data — schema, coverage, feasibility (NOT final analysis)."""
import pandas as pd
import numpy as np

df = pd.read_csv('data/nls_raw.csv')
print('SHAPE:', df.shape)
df['HG79'] = df['Highest grade completed, 1979'].replace(95, np.nan)  # 95 = no formal schooling (NLSY code)
name = {1:'BLACK', 2:'HISP', 3:'NBNH'}
df['cohort'] = df['Racial/ethnic cohort, 1979'].map(name)

print('\n=== 1) No direct degree-attainment field? ===')
ed_cols = [c for c in df.columns if 'grade' in c.lower() or 'degree' in c.lower() or 'education' in c.lower()]
print('Education-related columns in file:', ed_cols)
print('-> Respondent education is ONLY "Highest grade completed, 1979" (ages 14-22). No later degree/attainment variable.')

print('\n=== 2) Cohort / age / sex coverage ===')
print(df['Racial/ethnic cohort, 1979'].value_counts().to_string())
print('Age range:', df['Age of respondent, 1979'].min(), '-', df['Age of respondent, 1979'].max())

print('\n=== 3) Missingness of proposed fields ===')
for c in ['Highest grade completed, 1979',
          "Highest grade completed by respondent's mother, 1979",
          "Highest grade completed by respondent's father, 1979",
          'Total net family income, previous calendar year, 1979',
          'Family net wealth, 1985', 'Family net wealth, 1990', 'Family net wealth, 1996 (key data point)',
          'ASVAB - Arithmetic Reasoning Z Score (rounded), 1981',
          'Rank in class last year attended at this school, 1981']:
    print(f'  {c}: {df[c].isna().mean()*100:.1f}% missing')

print('\n=== 4) BA-proxy (HG>=16) feasibility ===')
print('Total HG>=16:', int((df['HG79']>=16).sum()))
for c in [1,2,3]:
    s = df[df['Racial/ethnic cohort, 1979']==c]
    print(f'  {name[c]}: n={len(s)}, HG>=16={int((s["HG79"]>=16).sum())}, HG>=13={int((s["HG79"]>=13).sum())}')

bl20 = df[(df['Racial/ethnic cohort, 1979']==1) & (df['Age of respondent, 1979']>=20)]
comp = bl20.dropna(subset=['HG79','Total net family income, previous calendar year, 1979',
                           "Highest grade completed by respondent's mother, 1979"])
print(f'\n  BLACK age>=20 complete cases n={len(comp)}: HG>=16={int((comp["HG79"]>=16).sum())}, HG>=13={int((comp["HG79"]>=13).sum())}')

print('\n=== 5) Scoping pattern (any-college >=13) by income tertile x cohort ===')
inc = df['Total net family income, previous calendar year, 1979']
q1, q2 = inc.quantile([0.333, 0.667])
df['incT'] = pd.cut(inc, [-1, q1, q2, inc.max()+1], labels=['Low','Mid','High'])
df['anycollege'] = df['HG79']>=13
tab = df.groupby(['cohort','incT'], observed=True)['anycollege'].agg(['sum','count','mean'])
print(tab.round(3).to_string())
print('\nNote: scoping only (pre-analysis), NOT the final hypothesis.')
