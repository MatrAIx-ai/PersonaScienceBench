"""
NLSY79: Median family net wealth by racial/ethnic cohort, 1985/1990/1996.
Approach agreed with researcher:
 - White = cohort 3 NON-BLACK NON-HISPANIC (only viable mapping, proxy).
 - Primary: complete-case medians per cohort-year.
 - Sensitivity: balanced panel (wealth present in all three waves) + nominal/real note.
 - Statistic: median (robust to heavy right tail and negative/debt values).
"""
import pandas as pd
import numpy as np

df = pd.read_csv('data/nls_raw.csv')
idcol = 'ID# (range 1-12686) 1979'
race = 'Racial/ethnic cohort, 1979'
wcols = {
    '1985': 'Family net wealth, 1985',
    '1990': 'Family net wealth, 1990',
    '1996': 'Family net wealth, 1996 (key data point)',
}
cohort_map = {1: 'BLACK', 2: 'HISPANIC', 3: 'WHITE_proxy_NBNH'}
order = ['WHITE_proxy_NBNH', 'BLACK', 'HISPANIC']
df['cohort'] = df[race].map(cohort_map)

print('=' * 78)
print('1) COMPLETE-CASE MEDIANS BY COHORT x YEAR (nominal USD)')
print('=' * 78)
rows = []
for yr, c in wcols.items():
    for coh in order:
        sub = df.loc[df['cohort'] == coh, c].dropna()
        rows.append({'year': yr, 'cohort': coh, 'n': len(sub), 'median': sub.median()})
tab = pd.DataFrame(rows).pivot(index='cohort', columns='year', values='median')[['1985', '1990', '1996']]
print(tab.round(0).to_string())

print()
print('=' * 78)
print('2) WHITE:B LACK AND WHITE:HISPANIC RATIOS AND ABSOLUTE DIFFERENCES')
print('=' * 78)
med = df.groupby('cohort')[list(wcols.values())].median()  # complete-case medians
res = []
for yr, c in wcols.items():
    w = med.loc['WHITE_proxy_NBNH', c]
    b = med.loc['BLACK', c]
    h = med.loc['HISPANIC', c]
    res.append({
        'year': yr, 'white': w, 'black': b, 'hispanic': h,
        'W/B_ratio': w / b, 'W/H_ratio': w / h,
        'W-B_abs_diff': w - b, 'W-H_abs_diff': w - h,
    })
res_df = pd.DataFrame(res).set_index('year')
print(res_df.round(0).to_string())

print()
print('=' * 78)
print('3) TREND: ratio / absolute-gap across 1985 -> 1990 -> 1996')
print('=' * 78)
r85, r90, r96 = res
print(f'W/B ratio : {r85["W/B_ratio"]:.2f} -> {r90["W/B_ratio"]:.2f} -> {r96["W/B_ratio"]:.2f}  (increasing by {r96["W/B_ratio"]/r85["W/B_ratio"]:.2f}x)')
print(f'W/H ratio : {r85["W/H_ratio"]:.2f} -> {r90["W/H_ratio"]:.2f} -> {r96["W/H_ratio"]:.2f}  (increasing by {r96["W/H_ratio"]/r85["W/H_ratio"]:.2f}x)')
print(f'W-B abs   : {r85["W-B_abs_diff"]:,.0f} -> {r90["W-B_abs_diff"]:,.0f} -> {r96["W-B_abs_diff"]:,.0f} USD (nominal)')
print(f'W-H abs   : {r85["W-H_abs_diff"]:,.0f} -> {r90["W-H_abs_diff"]:,.0f} -> {r96["W-H_abs_diff"]:,.0f} USD (nominal)')

print()
print('=' * 78)
print('4) BALANCED PANEL SENSITIVITY (respondents with all 3 wealth values)')
print('=' * 78)
mask = df[list(wcols.values())].notna().all(axis=1)
print('Balanced-panel N total:', mask.sum(),
      '| by cohort:', df.loc[mask, 'cohort'].value_counts().to_dict())
med_bp = df.loc[mask].groupby('cohort')[list(wcols.values())].median()
print(med_bp.round(0).to_string())
bp_rows = []
for yr, c in wcols.items():
    w = med_bp.loc['WHITE_proxy_NBNH', c]
    b = med_bp.loc['BLACK', c]
    h = med_bp.loc['HISPANIC', c]
    bp_rows.append({'year': yr, 'W/B_ratio': w / b, 'W/H_ratio': w / h,
                    'W-B_abs': w - b, 'W-H_abs': w - h})
bp_df = pd.DataFrame(bp_rows).set_index('year')
print()
print('Balanced-panel W/B ratio : 1985=%.2f  1990=%.2f  1996=%.2f -> %.2fx' % (
    bp_df.loc['1985','W/B_ratio'], bp_df.loc['1990','W/B_ratio'], bp_df.loc['1996','W/B_ratio'],
    bp_df.loc['1996','W/B_ratio']/bp_df.loc['1985','W/B_ratio']))
print('Balanced-panel W/H ratio : 1985=%.2f  1990=%.2f  1996=%.2f -> %.2fx' % (
    bp_df.loc['1985','W/H_ratio'], bp_df.loc['1990','W/H_ratio'], bp_df.loc['1996','W/H_ratio'],
    bp_df.loc['1996','W/H_ratio']/bp_df.loc['1985','W/H_ratio']))

print()
print('=' * 78)
print('5) NOMINAL/REAL NOTE (CPI-U, 1982-84=100: 1985=107.6, 1990=130.7, 1996=156.9)')
print('=' * 78)
cpi = {'1985': 107.6, '1990': 130.7, '1996': 156.9}
print('Medians expressed in 1996 dollars:')
real = pd.DataFrame(index=order)
for yr, c in wcols.items():
    real[yr] = med.loc[order, c] * cpi["1996"] / cpi[yr]
print(real.round(0).to_string())
real_res = []
for yr in ['1985', '1990', '1996']:
    w = real.loc['WHITE_proxy_NBNH', yr]
    b = real.loc['BLACK', yr]
    h = real.loc['HISPANIC', yr]
    real_res.append({'year': yr, 'W/B_ratio': w / b, 'W/H_ratio': w / h,
                     'W-B_abs_1996USD': w - b, 'W-H_abs_1996USD': w - h})
real_df = pd.DataFrame(real_res).set_index('year')
print(real_df.round(0).to_string())
r96_last = real_df.loc['1996']
print('Real (1996 USD) W/B ratio: 1985=%.2f -> 1996=%.2f ; W/H ratio: 1985=%.2f -> 1996=%.2f' % (
    real_df.loc['1985','W/B_ratio'], r96_last['W/B_ratio'],
    real_df.loc['1985','W/H_ratio'], r96_last['W/H_ratio']))

print()
print('=' * 78)
print('6) MISSINGNESS DIRECTION NOTE (differential attrition)')
print('=' * 78)
for yr, c in wcols.items():
    tab_m = df.groupby('cohort')[c].apply(lambda s: s.isna().mean() * 100)
    print(f'{yr}: BLACK={tab_m["BLACK"]:.0f}%  HISPANIC={tab_m["HISPANIC"]:.0f}%  NBNH={tab_m["WHITE_proxy_NBNH"]:.0f}% missing')

print()
print('=' * 78)
print('7) BOOTSTRAP 95% CIs (B=2000) for complete-case median ratios / differentials')
print('=' * 78)
rng = np.random.default_rng(42)
B = 2000
for yr, c in wcols.items():
    w = df.loc[df['cohort'] == 'WHITE_proxy_NBNH', c].dropna().values
    b = df.loc[df['cohort'] == 'BLACK', c].dropna().values
    h = df.loc[df['cohort'] == 'HISPANIC', c].dropna().values
    def boot(x, y):
        mx = np.array([np.median(rng.choice(x, len(x), replace=True)) for _ in range(B)])
        my = np.array([np.median(rng.choice(y, len(y), replace=True)) for _ in range(B)])
        return np.percentile(mx / my, [2.5, 97.5]), np.percentile(mx - my, [2.5, 97.5])
    rb, db = boot(w, b); rh, dh = boot(w, h)
    print(f'{yr}: W/B ratio {rb[0]:.2f}..{rb[1]:.2f} | W-B abs {db[0]:,.0f}..{db[1]:,.0f} | '
          f'W/H ratio {rh[0]:.2f}..{rh[1]:.2f} | W-H abs {dh[0]:,.0f}..{dh[1]:,.0f}')
