"""
DiscoveryBench: nls_ses — which variable's effect on BA degree completion
decreases from ~0.3636 to ~-0.2293 (becoming insignificant) when both race and
academic characteristics are added?

Structured logit analysis:
  M0: BA ~ SES
  M1: BA ~ SES + RACE
  M2: BA ~ SES + RACE + ACADEMIC (ASVAB composite + class percentile)
Robustness: probit, OLS linear probability, standardized (beta) coefficients.
"""
import pandas as pd
import numpy as np
import statsmodels.api as sm

df = pd.read_csv('data/nls_ses_processed.csv')
df['BA'] = df['BA DEGREE COMPLETED'].astype(int)
df['ASVAB'] = df['ABILITY: COMPOSITE OF ASVAB SCORE']
df['PCT'] = df['PERCENTILE IN CLASS']
df['SES'] = df['SES']
race_white_ref = (pd.get_dummies(df['SAMPLE_RACE'], prefix='race', drop_first=False)
                  .astype(float).drop(columns=['race_White']))

print("="*80)
print("DATA INSPECTION")
print("="*80)
print("shape:", df.shape)
print("missing:", df.isna().sum().to_dict())
print(df['SAMPLE_RACE'].value_counts())
print(df['SAMPLE_SEX'].value_counts())
print(df['BA'].value_counts())

def fit(y, X, kind='logit'):
    Xc = sm.add_constant(X)
    if kind == 'logit':
        return sm.Logit(y, Xc).fit(disp=0)
    if kind == 'probit':
        return sm.Probit(y, Xc).fit(disp=0)
    return sm.OLS(y, Xc).fit()

def report(tag, m):
    ses = m.params['SES']; p = m.pvalues['SES']
    lo, hi = m.conf_int().loc['SES']
    print(f"\n[{tag}] SES coef={ses:+.4f}  p={p:.4g}  95%CI=[{lo:+.4f},{hi:+.4f}]")

print("\n" + "="*80)
print("LOGIT RESULTS (White as race reference)")
print("="*80)
X0 = df[['SES']]
X1 = pd.concat([df[['SES']], race_white_ref], axis=1)
X2 = pd.concat([df[['SES','ASVAB','PCT']], race_white_ref], axis=1)

m0 = fit(df['BA'], X0);            report("M0: BA ~ SES", m0);                     print(m0.summary2().tables[1][['Coef.','Std.Err.','P>|z|']].to_string())
m1 = fit(df['BA'], X1);            report("M1: BA ~ SES + RACE", m1);              print(m1.summary2().tables[1][['Coef.','Std.Err.','P>|z|']].to_string())
m2 = fit(df['BA'], X2);            report("M2: BA ~ SES+RACE+ASVAB+PCT", m2);      print(m2.summary2().tables[1][['Coef.','Std.Err.','P>|z|']].to_string())

print("\n" + "="*80)
print("ROBUSTNESS")
print("="*80)
report("probit  M2", fit(df['BA'], X2, 'probit'))
report("OLS-LPM M2", fit(df['BA'], X2, 'ols'))

# Standardized (beta) coefficients for reference-value comparison
z = pd.DataFrame({c: (df[c]-df[c].mean())/df[c].std() for c in ['SES','ASVAB','PCT']})
report("logit standardized M0 (SES only)", fit(df['BA'], z[['SES']]))
report("logit standardized M1 (SES+RACE)", fit(df['BA'], pd.concat([z[['SES']], race_white_ref], axis=1)))
report("logit standardized M2 (full)",      fit(df['BA'], pd.concat([z[['SES','ASVAB','PCT']], race_white_ref], axis=1)))

# Interpretation helper
print("\n" + "="*80)
print("CONCLUSION DRAFT")
print("="*80)
print("Variable of interest: SES (Socioeconomic Status).")
print("Effect on BA completion: +%.4f (ses+race) -> %.4f (ses+race+academic); sign flip to negative," % (m1.params['SES'], m2.params['SES']))
print("significance at 1%% threshold is lost (p=%.4f at 5%% marginal)." % m2.pvalues['SES'])
print("=> the relationship of SES with BA completion is confounded/suppressed by race and academic characteristics.")
