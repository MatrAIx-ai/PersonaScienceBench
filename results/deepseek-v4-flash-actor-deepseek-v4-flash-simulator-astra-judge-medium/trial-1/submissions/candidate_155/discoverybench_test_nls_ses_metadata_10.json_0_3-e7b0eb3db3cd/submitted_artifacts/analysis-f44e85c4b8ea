"""
Formal analysis: identify the variable whose effect on BA-degree completion
decreases from ~0.50 to ~0.09 and becomes insignificant when SES and academic
characteristics are included.

Specification (pre-registered in plan):
- DV: BA DEGREE COMPLETED (0/1), logistic primary (log-odds), LPM robustness.
- For each candidate X:
    (a) simple:  BA ~ X
    (b) full-A:  BA ~ X + SES + PERCENTILE
    (b) full-B:  BA ~ X + SES + ABILITY + PERCENTILE
- "Becomes insignificant": in (b) Wald p>=0.05 AND 95% CI contains 0; in (a) p<0.05.
- Criterion H4: unique variable with simple coef ~ +0.50 & significant and full coef ~ +0.09 & insignificant.
"""
import pandas as pd, numpy as np, warnings
import statsmodels.formula.api as smf
warnings.filterwarnings('ignore')

df = pd.read_csv('data/nls_ses_processed.csv')
df['BA'] = df['BA DEGREE COMPLETED'].astype(int)
df['ABILITY'] = df['ABILITY: COMPOSITE OF ASVAB SCORE']
df['PERCENTILE'] = df['PERCENTILE IN CLASS']
df['FAMILY'] = df['FAMILY SIZE OF SAMPLE']
df['Black']   = (df['SAMPLE_RACE']=='Black').astype(int)
df['Hispanic']= (df['SAMPLE_RACE']=='Hispanic').astype(int)
df['Male']    = (df['SAMPLE_SEX']=='Male').astype(int)

CANDIDATES = {
 'SES':        'SES',
 'Black':      'Black',
 'Hispanic':   'Hispanic',
 'Male':       'Male',
 'FAMILY':     'FAMILY',
 'ABILITY':    'ABILITY',
 'PERCENTILE': 'PERCENTILE',
}
FULL_A = 'SES + PERCENTILE'          # academic = class rank only
FULL_B = 'SES + ABILITY + PERCENTILE'# academic = ability + class rank

out = []
def log(s):
    print(s); out.append(s)

log("="*100)
log("MAIN ANALYSIS  (full sample n=%d)" % len(df))
log("BA completion rate = %.4f" % df['BA'].mean())
log("="*100)

def summarize(r, var):
    lo, hi = r.conf_int().loc[var]
    return dict(coef=r.params[var], p=r.pvalues[var], lo=lo, hi=hi,
                sig_full=(r.pvalues[var] < 0.05))

rows = []
for xname, xterm in CANDIDATES.items():
    for fam, famlbl, kwargs in [('logit','logit',dict(disp=0)), ('ols','LPM',dict())]:
        r1 = smf.logit(f'BA ~ {xterm}', df).fit(**kwargs) if fam=='logit' else smf.ols(f'BA ~ {xterm}', df).fit()
        r2a = smf.logit(f'BA ~ {FULL_A} + {xterm}', df).fit(**kwargs) if fam=='logit' else smf.ols(f'BA ~ {FULL_A} + {xterm}', df).fit()
        r2b = smf.logit(f'BA ~ {FULL_B} + {xterm}', df).fit(**kwargs) if fam=='logit' else smf.ols(f'BA ~ {FULL_B} + {xterm}', df).fit()
        s1, s2a, s2b = summarize(r1,xname), summarize(r2a,xname), summarize(r2b,xname)
        rows.append(dict(var=xname, model=famlbl,
                         b1=s1['coef'], p1=s1['p'], sig1=(s1['p']<0.05),
                         b2a=s2a['coef'], p2a=s2a['p'], lo2a=s2a['lo'], hi2a=s2a['hi'],
                         sig2a=s2a['sig_full'], ci0_a=(s2a['lo']<=0<=s2a['hi']),
                         b2b=s2b['coef'], p2b=s2b['p'], lo2b=s2b['lo'], hi2b=s2b['hi'],
                         sig2b=s2b['sig_full'], ci0_b=(s2b['lo']<=0<=s2b['hi'])))

t = pd.DataFrame(rows)
pd.set_option('display.width', 220); pd.set_option('display.float_format', lambda v: f'{v:,.4f}')
log("\n--- COEFFICIENT COMPARISON TABLE (logit) ---")
log(t[t.model=='logit'][['var','b1','p1','sig1','b2a','p2a','lo2a','hi2a','sig2a','ci0_a','b2b','p2b','lo2b','hi2b','sig2b','ci0_b']].to_string(index=False))
log("\n--- COEFFICIENT COMPARISON TABLE (LPM) ---")
log(t[t.model=='LPM'][['var','b1','p1','sig1','b2a','p2a','lo2a','hi2a','sig2a','ci0_a','b2b','p2b','lo2b','hi2b','sig2b','ci0_b']].to_string(index=False))

# Significance-decision summary (logit, full-A and full-B)
log("\n--- SIGNIFICANCE DECISION (logit): 'becomes insignificant' = p1<0.05 & p2>=0.05 & CI contains 0 ---")
tl = t[t.model=='logit']
for f, col in [('full-A (SES+PERCENTILE)', 'A'), ('full-B (SES+ABILITY+PERCENTILE)', 'B')]:
    log(f"[{f}]")
    log(tl.assign(match=tl.apply(lambda r: r['sig1'] and (not r['sig2'+col.lower()]) and r['ci0_'+col.lower()], axis=1))[['var','b1','p1','b2'+col.lower(),'p2'+col.lower(),'sig2'+col.lower(),'ci0_'+col.lower(),'match']].to_string(index=False))

# ---- SUBSAMPLE SENSITIVITY for SES ----
log("\n" + "="*100)
log("SUBSAMPLE SENSITIVITY  (SES decay pattern)")
log("="*100)
subs = {'ALL': df}
for r_ in df['SAMPLE_RACE'].unique(): subs[r_] = df[df['SAMPLE_RACE']==r_]
for s_ in df['SAMPLE_SEX'].unique(): subs[s_] = df[df['SAMPLE_SEX']==s_]
log(f"{'subsample':<18}{'n':>6}{'simple b1':>11}{'p1':>9}{'full-A b2':>11}{'p2':>9}{'full-B b2':>11}{'p2':>9}")
for name, sub in subs.items():
    r1  = smf.logit('BA ~ SES', sub).fit(disp=0)
    r2a = smf.logit('BA ~ SES + PERCENTILE', sub).fit(disp=0)
    r2b = smf.logit('BA ~ SES + ABILITY + PERCENTILE', sub).fit(disp=0)
    log(f"{name:<18}{len(sub):>6}{r1.params['SES']:>11.4f}{r1.pvalues['SES']:>9.4f}"
        f"{r2a.params['SES']:>11.4f}{r2a.pvalues['SES']:>9.4f}{r2b.params['SES']:>11.4f}{r2b.pvalues['SES']:>9.4f}")

# save outputs
res = '\n'.join(out)
with open('analysis/results.txt','w') as f: f.write(res)
t.to_csv('analysis/coef_tables.csv', index=False)
print("\n[saved analysis/results.txt and analysis/coef_tables.csv]")
