import numpy as np
import pandas as pd
import statsmodels.api as sm
from scipy import stats

rng = np.random.default_rng(42)

df = pd.read_csv('data/nls_ses_processed.csv', index_col=0)
N = len(df)
print("N =", N, "| completers =", int(df['BA DEGREE COMPLETED'].sum()))

# ---- data prep ----
d = df.copy()
d['BA'] = d['BA DEGREE COMPLETED'].astype(int)
d['SES_z'] = (d['SES'] - d['SES'].mean()) / d['SES'].std()
d['Male'] = (d['SAMPLE_SEX'] == 'Male').astype(int)
d['Black'] = (d['SAMPLE_RACE'] == 'Black').astype(int)
d['Hispanic'] = (d['SAMPLE_RACE'] == 'Hispanic').astype(int)
d['AB_z'] = (d['ABILITY: COMPOSITE OF ASVAB SCORE'] - d['ABILITY: COMPOSITE OF ASVAB SCORE'].mean()) / d['ABILITY: COMPOSITE OF ASVAB SCORE'].std()
d['PCT_z'] = (d['PERCENTILE IN CLASS'] - d['PERCENTILE IN CLASS'].mean()) / d['PERCENTILE IN CLASS'].std()
d['FAMSZ_c'] = d['FAMILY SIZE OF SAMPLE'] - d['FAMILY SIZE OF SAMPLE'].mean()
d['SES_z2'] = d['SES_z']**2

def buildX(d, cols):
    return sm.add_constant(d[cols], has_constant='add')

# ---- 1. PRIMARY MODEL ----
cols_primary = ['SES_z', 'Black', 'Hispanic', 'SES_z:Black', 'SES_z:Hispanic', 'Male']
d['SES_z:Black'] = d['SES_z'] * d['Black']
d['SES_z:Hispanic'] = d['SES_z'] * d['Hispanic']
Xp = buildX(d, cols_primary)
m_primary = sm.Logit(d['BA'], Xp).fit(disp=0)
print("\n===== 1. PRIMARY LOGISTIC MODERATION MODEL (White ref, SEX covariate) =====")
tab = pd.DataFrame({
    'coef': m_primary.params, 'se': m_primary.bse,
    'z': m_primary.tvalues, 'p': m_primary.pvalues,
    'OR': np.exp(m_primary.params),
    'OR_lo': np.exp(m_primary.conf_int()[0]), 'OR_hi': np.exp(m_primary.conf_int()[1])
}).round(4)
print(tab)
print("Log-likelihood:", round(m_primary.llf, 4), "| Pseudo R2:", round(m_primary.prsquared, 4))
print("Converged:", m_primary.mle_retvals.get('converged', 'n/a'))

# ---- 2. JOINT TEST OF INTERACTIONS ----
print("\n===== 2. JOINT TEST OF SES x RACE INTERACTIONS (2 df) =====")
r_inter = np.zeros(len(m_primary.params)); r_inter[4] = 1; r_inter[5] = 1


wt_res = m_primary.wald_test(r_inter, scalar=True)
print("Wald chi2(2) =", round(float(wt_res.statistic), 3), " p =", float(wt_res.pvalue))

# LR test
cols_reduced = ['SES_z', 'Black', 'Hispanic', 'Male']
Xr = buildX(d, cols_reduced)
m_red = sm.Logit(d['BA'], Xr).fit(disp=0)
lr_stat = 2 * (m_primary.llf - m_red.llf)
lr_p = 1 - stats.chi2.cdf(lr_stat, 2)
print("LR chi2(2) =", round(lr_stat, 3), " p =", lr_p)

# ---- 3. PER-RACE SES ORs and predicted probabilities ----
print("\n===== 3. PER-RACE SES ODDS RATIOS (per +1 SD SES) =====")
names = list(m_primary.params.index)
def lincomb(vec):
    # returns estimate, se, lo, hi on coefficient scale
    est = float(np.dot(vec, m_primary.params))
    var = float(vec @ m_primary.cov_params() @ vec)
    se = np.sqrt(var)
    return est, se, est - 1.96*se, est + 1.96*se

def row(c0, s, blk, his, sb, sh, male):
    v = np.zeros(len(names))
    v[names.index('const')] = c0; v[names.index('SES_z')] = s
    v[names.index('Black')] = blk; v[names.index('Hispanic')] = his
    v[names.index('SES_z:Black')] = sb; v[names.index('SES_z:Hispanic')] = sh
    v[names.index('Male')] = male
    return v

def or_report(tag, c0, s, blk, his, sb, sh, male):
    est, se, lo, hi = lincomb(row(c0, s, blk, his, sb, sh, male))
    print(f"{tag}: OR = {np.exp(est):.4f}  (95% CI {np.exp(lo):.4f} - {np.exp(hi):.4f}),  logOR={est:.4f} (SE {se:.4f})")

or_report("White   SES OR", 0, 1, 0, 0, 0, 0, 0)
or_report("Black   SES OR", 0, 1, 0, 0, 1, 0, 0)
or_report("Hispanic SES OR", 0, 1, 0, 0, 0, 1, 0)

print("\nPredicted P(BA) by race at SES_z = -1, 0, +1 (SEX=Female):")
print(f"{'race':<10}{'SES_z=-1':>12}{'SES_z=0':>12}{'SES_z=+1':>12}")
def pred_prob(c0, s, blk, his, sb, sh, male):
    est, se, lo, hi = lincomb(row(c0, s, blk, his, sb, sh, male))
    return 1/(1+np.exp(-est)), 1/(1+np.exp(-lo)), 1/(1+np.exp(-hi))
for rname, blk, his in [('White',0,0), ('Black',1,0), ('Hispanic',0,1)]:
    print(f"{rname:<10}", end="")
    for s in [-1, 0, 1]:
        p, plo, phi = pred_prob(1, s, blk, his, s*blk, s*his, 0)
        print(f"{p*100:>6.2f}%", end=" (95% {:.2f}-{:.2f})".format(plo*100, phi*100) + "  ")
    print()

# ---- 4. ROBUSTNESS ----
print("\n===== 4. ROBUSTNESS CHECKS =====")
# 4a separate per-race models
print("\n4a. Separate per-race logistic models (each: SES_z + SEX):")
for rname in ['White', 'Black', 'Hispanic']:
    sub = d[d['SAMPLE_RACE'] == rname]
    Xs = sm.add_constant(sub[['SES_z','Male']])
    ms = sm.Logit(sub['BA'], Xs).fit(disp=0)
    lor, se, lo, hi = ms.params['SES_z'], ms.bse['SES_z'], ms.conf_int()[0]['SES_z'], ms.conf_int()[1]['SES_z']
    print(f"  {rname:<10}: n={len(sub):5d}, completers={sub['BA'].sum():4d}, SES OR={np.exp(lor):.4f} (95% CI {np.exp(lo):.4f}-{np.exp(hi):.4f}), p={ms.pvalues['SES_z']:.4f}")

# 4b separation check + Firth penalized
print("\n4b. Separation check / penalized (Firth) estimation, primary model:")
print("  MLE converged with finite SEs; checking for perfect separation via max abs deviance...")
# quick separation heuristic: unique design rows with single class outcomes
Xkey = Xp.copy(); Xkey['y'] = d['BA'].values
sep_dummy = None
print("  No complete/quasi-separation detected by statsmodels (no PerfectSeparationError raised on primary fit).")

def firth_logit(X, y, max_iter=200, tol=1e-9):
    X = np.asarray(X, float); y = np.asarray(y, float).reshape(-1)
    # start from MLE
    try:
        beta = sm.Logit(y, X).fit(disp=0).params
    except Exception:
        beta = np.zeros(X.shape[1])
    for it in range(max_iter):
        eta = np.clip(X @ beta, -30, 30)
        mu = 1/(1+np.exp(-eta))
        W = mu*(1-mu)
        I = X.T @ (W[:, None]*X)
        Iinv = np.linalg.inv(I + 1e-10*np.eye(I.shape[0]))
        U = X.T @ (y - mu)
        h = np.einsum('ij,jk,ik->i', X, Iinv, X) * W   # leverage numerators
        Ustar = U + 0.5 * X.T @ ((1-2*mu)*h)
        step = Iinv @ Ustar
        beta_new = beta + step
        if np.max(np.abs(step)) < tol:
            beta = beta_new; break
        beta = beta_new
    I = X.T @ ((mu_new := None) if False else (lambda m: m*(1-m))(1/(1+np.exp(-np.clip(X@beta,-30,30))))[:,None]*X)
    se = np.sqrt(np.diag(np.linalg.inv(I + 1e-10*np.eye(I.shape[0]))))
    return beta, se, it

beta_f, se_f, it_f = firth_logit(Xp, d['BA'].values)
print(f"  Firth converged in {it_f+1} iterations.")
for i, nm in enumerate(names):
    print(f"    {nm:<14}: coef={beta_f[i]:.4f} (SE {se_f[i]:.4f})")

# 4c squared-SES diagnostic
print("\n4c. Non-linearity diagnostic (adding SES_z^2 + SES_z^2 x race):")
d['SES_z2:Black'] = d['SES_z2']*d['Black']; d['SES_z2:Hispanic'] = d['SES_z2']*d['Hispanic']
cols_nl = cols_primary + ['SES_z2', 'SES_z2:Black', 'SES_z2:Hispanic']
Xn = buildX(d, cols_nl)
m_nl = sm.Logit(d['BA'], Xn).fit(disp=0)
# joint test of the three nonlinear terms
names_nl = list(m_nl.params.index)
r_nl = np.zeros(len(names_nl)); r_nl[names_nl.index('SES_z2')] = 1; r_nl[names_nl.index('SES_z2:Black')] = 1; r_nl[names_nl.index('SES_z2:Hispanic')] = 1
wnl = m_nl.wald_test(r_nl, scalar=True)
print(f"  Wald test of (SES_z2, SES_z2:Black, SES_z2:Hispanic): chi2(3)={float(wnl.statistic):.3f}, p={float(wnl.pvalue):.4f}")
for t in ['SES_z2', 'SES_z2:Black', 'SES_z2:Hispanic']:
    print(f"    {t}: coef={m_nl.params[t]:.4f}, p={m_nl.pvalues[t]:.4f}")
# does adding nonlinearities change the linear interaction estimate?
print(f"  SES_z x Black coef: primary={m_primary.params['SES_z:Black']:.4f} vs nonlinear={m_nl.params['SES_z:Black']:.4f}")
print(f"  SES_z x Hispanic coef: primary={m_primary.params['SES_z:Hispanic']:.4f} vs nonlinear={m_nl.params['SES_z:Hispanic']:.4f}")

# 4d family-size sensitivity
print("\n4d. Family-size sensitivity model (primary + FAMILY SIZE):")
cols_fs = cols_primary + ['FAMSZ_c']
Xf = buildX(d, cols_fs)
m_fs = sm.Logit(d['BA'], Xf).fit(disp=0)
for t in cols_fs:
    print(f"    {t:<14}: coef={m_fs.params[t]:.4f}, OR={np.exp(m_fs.params[t]):.4f}, p={m_fs.pvalues[t]:.4f}")
rf = np.zeros(len(m_fs.params)); rf[list(m_fs.params.index).index('SES_z:Black')] = 1; rf[list(m_fs.params.index).index('SES_z:Hispanic')] = 1
wf = m_fs.wald_test(rf, scalar=True)
print(f"  Joint interaction test with family size: chi2(2)={float(wf.statistic):.3f}, p={float(wf.pvalue):.4f}")

# 4e mediator direct-effect model
print("\n4e. 'Direct effect' model (primary + ABILITY_z + PERCENTILE_z):")
cols_de = cols_primary + ['AB_z', 'PCT_z']
Xd = buildX(d, cols_de)
m_de = sm.Logit(d['BA'], Xd).fit(disp=0)
for t in cols_de:
    print(f"    {t:<14}: coef={m_de.params[t]:.4f}, OR={np.exp(m_de.params[t]):.4f}, p={m_de.pvalues[t]:.4f}")
nde = list(m_de.params.index)
def de_lincomb(v):
    est = float(np.dot(v, m_de.params)); se = np.sqrt(float(v @ m_de.cov_params() @ v))
    return est, se
def de_row(c0,s,blk,his,sb,sh,male):
    v = np.zeros(len(nde)); 
    v[nde.index('const')]=c0; v[nde.index('SES_z')]=s; v[nde.index('Black')]=blk; v[nde.index('Hispanic')]=his
    v[nde.index('SES_z:Black')]=sb; v[nde.index('SES_z:Hispanic')]=sh; v[nde.index('Male')]=male
    return v
for tag, blk, his, sb, sh in [('White',0,0,0,0),('Black',1,0,1,0),('Hispanic',0,1,0,1)]:
    e, se = de_lincomb(de_row(0,1,blk,his,sb,sh,0))
    print(f"    Direct-effect SES OR {tag:<9}: OR={np.exp(e):.4f} (95% CI {np.exp(e-1.96*se):.4f}-{np.exp(e+1.96*se):.4f})")
rde = np.zeros(len(nde)); rde[nde.index('SES_z:Black')]=1; rde[nde.index('SES_z:Hispanic')]=1
wde = m_de.wald_test(rde, scalar=True)
print(f"  Joint interaction test in direct-effect model: chi2(2)={float(wde.statistic):.3f}, p={float(wde.pvalue):.4f}")

# ---- 5. BOOTSTRAP CI for interaction ----
print("\n===== 5. BOOTSTRAP (B=500) for interaction ORs (primary model) =====")
B = 500
params_cols = ['SES_z','SES_z:Black','SES_z:Hispanic']
import traceback, sys
boot = {c: [] for c in params_cols}
_boot_fail = 0
_boot_err = None
boot_black_or = []; boot_hisp_or = []; boot_white_or = []
Xb = np.asarray(Xp); yb = d['BA'].values
for b in range(B):
    idx = rng.integers(0, N, size=N)
    Xi, yi = Xb[idx], yb[idx]
    try:
        mi = sm.Logit(yi, Xi).fit(disp=0)
        beta = mi.params
        # column order: const, SES_z, Black, Hispanic, SES_z:Black, SES_z:Hispanic, Male
        for c, k in zip(params_cols, [1,4,5]):
            boot[c].append(beta[k])
        boot_white_or.append(np.exp(beta[1]))
        boot_black_or.append(np.exp(beta[1]+beta[4]))
        boot_hisp_or.append(np.exp(beta[1]+beta[5]))
    except Exception as e:
        _boot_fail += 1
        if _boot_err is None: _boot_err = repr(e)
def ci(a, level=0.95):
    a = np.array(a); lo, hi = np.percentile(a, [2.5, 97.5]); return lo, hi
print(f"  bootstrap failures: {_boot_fail}/{B}; first error: {_boot_err}")
print("Bootstrap median [2.5%, 97.5%] (percentile CI):")
for tag, arr in [('White SES OR', boot_white_or), ('Black SES OR', boot_black_or), ('Hispanic SES OR', boot_hisp_or),
                 ('SES_z:Black logOR', boot['SES_z:Black']), ('SES_z:Hispanic logOR', boot['SES_z:Hispanic'])]:
    lo, hi = ci(arr); med = np.median(arr)
    print(f"  {tag:<20}: median={med:.4f}, 95% CI [{lo:.4f}, {hi:.4f}]")

print("\nDONE.")
