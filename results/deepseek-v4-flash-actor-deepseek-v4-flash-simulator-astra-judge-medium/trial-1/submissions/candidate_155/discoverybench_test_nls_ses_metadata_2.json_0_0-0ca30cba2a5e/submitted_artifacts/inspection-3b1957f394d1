import pandas as pd
import numpy as np

df = pd.read_csv('data/nls_ses_processed.csv', index_col=0)
print("Shape:", df.shape)
print("\nColumns and dtypes:")
print(df.dtypes)
print("\nFirst rows:")
print(df.head(3))

print("\nMissing values per column:")
print(df.isna().sum())

print("\nBA DEGREE COMPLETED value counts:")
print(df['BA DEGREE COMPLETED'].value_counts(dropna=False))

print("\nSAMPLE_RACE value counts:")
print(df['SAMPLE_RACE'].value_counts(dropna=False))

print("\nSAMPLE_SEX value counts:")
print(df['SAMPLE_SEX'].value_counts(dropna=False))

for c in ['SES','ABILITY: COMPOSITE OF ASVAB SCORE','PERCENTILE IN CLASS','FAMILY SIZE OF SAMPLE']:
    print(f"\n{c}: min={df[c].min():.3f}, max={df[c].max():.3f}, mean={df[c].mean():.3f}, median={df[c].median():.3f}, std={df[c].std():.3f}, q25={df[c].quantile(.25):.3f}, q75={df[c].quantile(.75):.3f}")

print("\nCompletion rate by race:")
print(df.groupby('SAMPLE_RACE')['BA DEGREE COMPLETED'].agg(['count','sum','mean']))

print("\nCompletion rate by sex:")
print(df.groupby('SAMPLE_SEX')['BA DEGREE COMPLETED'].agg(['count','sum','mean']))

print("\nSES by race:")
print(df.groupby('SAMPLE_RACE')['SES'].agg(['count','mean','median','std']))

print("\nAbility by race:")
print(df.groupby('SAMPLE_RACE')['ABILITY: COMPOSITE OF ASVAB SCORE'].agg(['count','mean','median','std']))

print("\nPercentile by race:")
print(df.groupby('SAMPLE_RACE')['PERCENTILE IN CLASS'].agg(['count','mean','median','std']))
