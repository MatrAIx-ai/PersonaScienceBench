import numpy as np
import pandas as pd
import warnings
warnings.filterwarnings('ignore')
import statsmodels.api as sm
from scipy import stats
import patsy

df = pd.read_csv('data/nls_ses_processed.csv')
df['BA'] = df['BA DEGREE COMPLETED'].astype(int)
df = df.rename(columns={'CASE ID':'caseid','SAMPLE_RACE':'race','SAMPLE_SEX':'sex',
    'FAMILY SIZE OF SAMPLE':'fam_size','ABILITY: COMPOSITE OF ASVAB SCORE':'asvab',
    'PERCENTILE IN CLASS':'pctile'})
for c, div in [('asvab',100.0),('pctile',100.0),('fam_size',10.0)]:
    df[c+'_s'] = df[c]/div
df['SES_Q'] = pd.qcut(df['SES'], 4, labels=['Q1','Q2','Q3','Q4'])
df['SES_T'] = pd.qcut(df['SES'], 3, labels=['T1','T2','T3'])
df['nonBlack'] = (df['race'] != 'Black').astype(int)

CONTROLS = 'asvab_s + pctile_s + sex + fam_size_s'
FORM3 = "BA ~ race*{lv} + " + CONTROLS
FORMB = "BA ~ nonBlack*{lv} + " + CONTROLS

def fit_model(frame, formula):
    y, X = patsy.dmatrices(formula, frame, return_type='dataframe')
    di = X.design_info
    m = sm.Logit(y, X)
    r = m.fit(disp=0, maxiter=200)
    return y, X, m, r, di

def predict_at(design_info, m, params, frame, level_col, level, group, group_mode):
    dd = frame.copy()
    if group_mode == '3race':
        dd['race'] = group
    else:
        dd['nonBlack'] = 0 if group=='nonB' else 1
    dd[level_col] = level
    Xd = patsy.build_design_matrices([design_info], dd, return_type='dataframe')[0]
    return np.asarray(m.predict(params, Xd)).ravel()

def margin_diff(params, m, frame, design_info, level_col, levels, group_mode):
    diffs = []
    for lv in levels:
        if group_mode == '3race':
            pW = predict_at(design_info, m, params, frame, level_col, lv, 'White','3race')
            pB = predict_at(design_info, m, params, frame, level_col, lv, 'Black','3race')
            diffs.append((pB - pW).mean())
        else:
            pNB = predict_at(design_info, m, params, frame, level_col, lv, 'nonB','binary')
            pB  = predict_at(design_info, m, params, frame, level_col, lv, 'B','binary')
            diffs.append((pB - pNB).mean())
    return np.array(diffs)

def delta_ci(m, r, frame, design_info, level_col, levels, group_mode):
    par = r.params.values
    h = 1e-5
    base = margin_diff(par, m, frame, design_info, level_col, levels, group_mode)
    J = np.zeros((len(levels), len(par)))
    for j in range(len(par)):
        p1 = par.copy(); p1[j] += h
        p2 = par.copy(); p2[j] -= h
        J[:,j] = (margin_diff(p1, m, frame, design_info, level_col, levels, group_mode)
                  - margin_diff(p2, m, frame, design_info, level_col, levels, group_mode))/(2*h)
    V = r.cov_params().values
    se = np.sqrt(np.einsum('ij,jk,ik->i', J, V, J))
    return base, se, base-1.96*se, base+1.96*se

def report(level_col, levels, label):
    print('='*80)
    print(f'### {label}  [{level_col}]')
    raw = df.groupby([level_col,'race'], observed=True)['BA'].agg(['count','sum','mean']).reset_index()
    print('\nRaw N / completers / completion rate by race x level:')
    print(raw.to_string(index=False))
    comp = pd.crosstab(df[level_col], df['race'], normalize='index')*100
    comp['N_total'] = df.groupby(level_col, observed=True)['BA'].count()
    print('\nLevel composition % (and total N):')
    print(comp.round(1).to_string())
    print('Completers per cell:')
    print(pd.crosstab(df[level_col], df['race'], values=df['BA'], aggfunc='sum').to_string())

    f3 = FORM3.format(lv=level_col)
    y3, X3, m3, r3, di3 = fit_model(df, f3)
    yR, XR = patsy.dmatrices(f"BA ~ race + {level_col} + {CONTROLS}", df, return_type='dataframe')
    red3 = sm.Logit(yR, XR).fit(disp=0)
    chi3, dfr3 = 2*(r3.llf - red3.llf), r3.df_model - red3.df_model; p3 = stats.chi2.sf(chi3, dfr3)
    base3, se3, lo3, hi3 = delta_ci(m3, r3, df, di3, level_col, levels, '3race')
    print(f'\n[3-race] race x {level_col} interaction: LRT chi2={chi3:.2f} df={dfr3} p={p3:.4f}')
    print('Marginal standardized Black - White predicted-prob difference per level:')
    for i,lv in enumerate(levels):
        print(f'  {lv}: diff={base3[i]:.4f}  SE={se3[i]:.4f}  CI=[{lo3[i]:.4f},{hi3[i]:.4f}]  excl0={"yes" if (lo3[i]>0 or hi3[i]<0) else "no"}')
    preds3 = {g:[predict_at(di3,m3,r3.params,df,level_col,lv,g,'3race').mean() for lv in levels]
              for g in ['White','Black','Hispanic']}
    print('\nMarginal standardized predicted P(BA) by race x level:')
    print(pd.DataFrame({'level':levels,'White':preds3['White'],'Black':preds3['Black'],'Hispanic':preds3['Hispanic']}).round(4).to_string(index=False))

    fB = FORMB.format(lv=level_col)
    yB, XB, mB, rB, diB = fit_model(df, fB)
    yRB, XRB = patsy.dmatrices(f"BA ~ nonBlack + {level_col} + {CONTROLS}", df, return_type='dataframe')
    redB = sm.Logit(yRB, XRB).fit(disp=0)
    chiB, dfrB = 2*(rB.llf - redB.llf), rB.df_model - redB.df_model; pB = stats.chi2.sf(chiB, dfrB)
    baseB, seB, loB, hiB = delta_ci(mB, rB, df, diB, level_col, levels, 'binary')
    print(f'\n[binary] nonBlack x {level_col} interaction: LRT chi2={chiB:.2f} df={dfrB} p={pB:.4f}')
    print('Marginal standardized Black - nonBlack predicted-prob difference per level:')
    for i,lv in enumerate(levels):
        print(f'  {lv}: diff={baseB[i]:.4f}  SE={seB[i]:.4f}  CI=[{loB[i]:.4f},{hiB[i]:.4f}]  excl0={"yes" if (loB[i]>0 or hiB[i]<0) else "no"}')
    print()
    return dict(p3=p3,pB=pB,base3=base3,lo3=lo3,hi3=hi3,baseB=baseB,loB=loB,hiB=hiB)

q = report('SES_Q', ['Q1','Q2','Q3','Q4'], 'PRIMARY: GLOBAL QUARTILES')
t = report('SES_T', ['T1','T2','T3'], 'ROBUSTNESS: GLOBAL TERTILES')

print('='*80)
print('Coefficient table: primary quartile 3-race model')
f3 = FORM3.format(lv='SES_Q')
y3, X3, m3, r3, di3 = fit_model(df, f3)
print(r3.summary2().tables[1].to_string())
