import pandas as pd
import numpy as np

df = pd.read_csv('data/nls_ses_processed.csv')
print('shape:', df.shape)
print('columns:', df.columns.tolist())
print('dtypes:\n', df.dtypes)
print('missing:\n', df.isna().sum())

print('\n=== categorical counts ===')
print(df['SAMPLE_RACE'].value_counts())
print(df['SAMPLE_SEX'].value_counts())

print('\n=== numeric ranges ===')
for c in ['CASE ID','FAMILY SIZE OF SAMPLE','ABILITY: COMPOSITE OF ASVAB SCORE',
          'PERCENTILE IN CLASS','SES']:
    s = df[c]; print(f'{c}: min={s.min():.3f} mean={s.mean():.3f} max={s.max():.3f}')

print('\n=== BA completion ===')
df['BA'] = df['BA DEGREE COMPLETED'].astype(int)
print('overall completion rate:', round(df['BA'].mean(), 4))
print('total completers:', int(df['BA'].sum()))
print(df.groupby('SAMPLE_RACE')['BA'].agg(['count','mean','sum']))

print('\n=== weight variable present? ===')
wt = [c for c in df.columns if 'weight' in c.lower() or 'wt' in c.lower()]
print('weight-related columns:', wt)

print('\n=== global SES quartiles by race ===')
df['ses_q'] = pd.qcut(df['SES'], 4, labels=['Q1(low)','Q2','Q3','Q4(high)'])
print('N by race x quartile:\n', pd.crosstab(df['ses_q'], df['SAMPLE_RACE']))
print('BA completers by race x quartile:\n', pd.crosstab(df['ses_q'], df['SAMPLE_RACE'], values=df['BA'], aggfunc='sum'))
print('BA rate by race x quartile:\n', pd.crosstab(df['ses_q'], df['SAMPLE_RACE'], values=df['BA'], aggfunc='mean'))
