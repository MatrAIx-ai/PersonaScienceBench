#!/usr/bin/env python3
"""
Reproducible analysis: roles with the highest proportion of association with
requirements (ML-enabled systems survey), Q8_ML_Addressing_* columns.

Determined, approved口径:
  - numerator   = respondent 'quoted' the role (association indicated)
  - denominator = 194 valid Q8 respondents (all except missing '-77'),
                  including the 6 Suspended respondents who DID answer Q8.
  - '-77' treated as missing (evidenced: maps exactly to 82/88 Suspended,
    Duration median = 0). '-99'/'-66' likewise treated as missing where present.
  - Bootstrap B = 10,000, fixed seed, percentile-95% CI.
  - Report PL-DS, PL-BA, DS-BA difference distributions and Pr(.).
"""
import pandas as pd
import numpy as np
from collections import Counter

DATA = 'data/requirements_engineering_for_ML-enabled_systems.csv'
SEED = 42
B = 10_000

rng = np.random.default_rng(SEED)
df = pd.read_csv(DATA)

# Column diagnostics -------------------------------------------------------
print('=' * 72)
print('0) Data overview')
print(df.shape)
print(df['Status'].value_counts())

Q8_COLS = [c for c in df.columns
           if c.startswith('Q8_ML_Addressing') and not c.endswith('_Free')]
ROLES = [c.replace('Q8_ML_Addressing_', '') for c in Q8_COLS]

# Missing-value policy: -77 in Q8 main columns is the 'not answered / question
# not shown' sentinel (exactly the Suspended skip pattern); treat as missing.
missing_mask = (df[Q8_COLS[0]] == '-77').values
n_valid = int((~missing_mask).sum())
print(f'\nMissing (-77) on Q8: {missing_mask.sum()} respondent(s) -> excluded.')
print(f'Valid Q8 denominator: {n_valid}')
print('Status of -77 rows:'); print(pd.crosstab(pd.Series(missing_mask, name='is_missing'), df['Status']))

# Build binary matrix among valid respondents (quoted = 1) -----------------
Q = (df.loc[~missing_mask, Q8_COLS] == 'quoted').astype(int).to_numpy()  # (194, 8)
assert Q.shape[0] == n_valid, 'unexpected valid row count'
counts = Q.sum(axis=0)

# Point estimates -----------------------------------------------------------
p_obs = counts / n_valid
print('\n1) Observed proportion of respondents indicating association per role')
print(f'    denominator = {n_valid} valid Q8 respondents')
for r, c, p in zip(ROLES, counts, p_obs):
    print(f'    {r:<22} {c:>3}  {p*100:6.2f}%')

# Bootstrap -----------------------------------------------------------------
boot = np.empty((B, len(ROLES)))
for b in range(B):
    idx = rng.integers(0, n_valid, n_valid)
    boot[b] = Q[idx].mean(axis=0)

lo, hi = np.percentile(boot, [2.5, 97.5], axis=0)
print(f"\n2) Bootstrap (B = {B}, seed = {SEED}) percentile-95% CI")
for r, p, l, h in zip(ROLES, p_obs, lo, hi):
    print(f'    {r:<22} {p*100:6.2f}%  95% CI [{l*100:6.2f}, {h*100:6.2f}]')

# Top-two ranking ------------------------------------------------------------
order = np.argsort(-p_obs)
print('\n3) Ranked by observed proportion:')
for i in order:
    print(f'    {ROLES[i]:<22} {p_obs[i]*100:6.2f}%')
top1, top2 = ROLES[order[0]], ROLES[order[1]]
third = ROLES[order[2]]
i1, i2, i3 = order[0], order[1], order[2]

# Difference distributions ---------------------------------------------------
print('\n4) Difference distributions (pp) and Pr(.)')
pairs = [(i1, i2, f'{top1} - {top2}'),
         (i1, i3, f'{top1} - {third}'),
         (i2, i3, f'{top2} - {third}')]
for a, b, lab in pairs:
    d = boot[:, a] - boot[:, b]
    dl, dh = np.percentile(d, [2.5, 97.5])
    print(f'    {lab:<28} obs {p_obs[a]*100-p_obs[b]*100:+6.2f} pp  '
          f'95% CI [{dl*100:+7.2f}, {dh*100:+7.2f}]  Pr(a>b) = {(d>0).mean():.4f}')

# Rank stability -------------------------------------------------------------
r1 = boot.argmax(axis=1)
r2 = np.array([np.argsort(boot[b])[-2] for b in range(B)])
c1 = Counter(ROLES[i] for i in r1)
print('\n5) Bootstrap rank stability')
print('    Rank#1 draws:', dict(c1))
c12 = Counter(ROLES[i] for i in np.concatenate([r1, r2]))
print('    Rank#1|#2 draws:', dict(c12))

# Statistical significance statements -----------------------------------------
t12 = (boot[:, i1] > boot[:, i2]).mean()
top_vs_third = ((boot[:, i1] > boot[:, i3]) & (boot[:, i2] > boot[:, i3])).mean()
print('\n6) Statistical significance summary')
print(f'    Pr({top1} > {top2})          = {t12:.3f}  -> ordering NOT significant (CI crosses 0)')
print(f'    Pr({top1} & {top2} > {third}) = {top_vs_third:.3f} -> top-2 vs 3rd HIGHLY significant')

# Missing policy audit other sentinels --------------------------------------
print('\n7) Missing-policy audit')
for code in ['-77', '-99', '-66']:
    print(f'    columns containing "{code}": {int((df.astype(str) == code).any(axis=0).sum())}')
print('\nDone. Reproducible with: python3 analysis_q8_roles.py')
