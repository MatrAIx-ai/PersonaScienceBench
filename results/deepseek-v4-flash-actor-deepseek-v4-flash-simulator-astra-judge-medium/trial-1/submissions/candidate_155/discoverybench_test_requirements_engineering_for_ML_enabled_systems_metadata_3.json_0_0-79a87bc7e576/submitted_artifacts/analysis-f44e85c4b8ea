"""DiscoveryBench episode: requirements_engineering_for_ML_enabled_systems.
FINAL analysis: most commonly used ML requirements-elicitation technique (Q9).

Consensus (approved):
- "most commonly used" = technique with the highest share of "quoted"
  (selected) among valid Q9 respondents (n=194; 82 rows with whole-grid
  -77 (=question not shown, all 'Suspended') are NA and excluded).
- Negative codes are non-values: -77 = not shown (NA), -99 = no answer / not
  mentioned, -66 = not applicable; none count as a selection.
- Q9 interpreted as a multi-select checkbox grid (quoted = selected).
- Bootstrap: B=10,000, nonparametric resampling of respondents,
  percentile 95% CI per technique; plus bootstrap CI of the difference
  Interviews - Scenarios and Interviews - Prototyping.
- Sensitivity denominators: 194 (primary), 174 (>=1 selected),
  276 (all rows, NA counted as 0).
"""
import pandas as pd, numpy as np

df = pd.read_csv('data/requirements_engineering_for_ML-enabled_systems.csv', encoding='utf-8-sig')

Q9 = [c for c in df.columns if c.startswith('Q9_ML_Elicitation') and 'Free' not in c]
rec = df[Q9].replace({'quoted': 1, 'not quoted': 0, '-77': np.nan}).astype(float)
valid_mask = rec.notna().all(axis=1)
n_valid = int(valid_mask.sum())
n_any = int(((rec.fillna(0).sum(axis=1) > 0) & valid_mask).sum())
print('Total rows:', len(df), '| valid Q9 (n=194):', n_valid, '| selected >=1 technique:', n_any)

quoted = rec.sum().astype(int)

def shares(denom):
    return {c: quoted[c] / denom for c in Q9}

# ---------- per-technique shares, primary denom 194 -----------------------
print('\n=== Shares (primary denominator = 194 valid respondents) ===')
order = sorted(Q9, key=lambda c: -quoted[c])
for c in order:
    print(f'  {c:45s} {quoted[c]:3d} / {n_valid:3d}  = {quoted[c]/n_valid*100:6.2f}%')

# ---------- bootstrap per technique (percentile 95% CI) --------------------
rng = np.random.default_rng(2026)
sub = rec.values[valid_mask.values]
B = 10_000
print(f'\n=== Bootstrap 95% CI (B={B}, resample respondents, percentile) ===')
row_idx = np.arange(len(sub))
boot_ci, boot_obs = {}, {}
for j, c in enumerate(Q9):
    col = sub[:, j]
    bs = col[rng.choice(row_idx, size=(B, len(sub)), replace=True)].mean(axis=1)
    boot_obs[c] = bs.mean() * 100
    boot_ci[c] = (np.percentile(bs, 2.5) * 100, np.percentile(bs, 97.5) * 100)
    print(f'  {c:45s} obs={boot_obs[c]:6.2f}%  CI=[{boot_ci[c][0]:6.3f}, {boot_ci[c][1]:6.3f}]')

# ---------- bootstrap difference vs second place ---------------------------
print('\n=== Bootstrap CI of difference vs the runner-up (B=10,000) ===')
iv = sub[:, Q9.index('Q9_ML_Elicitation_Interviews')]
for c in ['Q9_ML_Elicitation_Scenarios', 'Q9_ML_Elicitation_Prototyping']:
    oth = sub[:, Q9.index(c)]
    d = (iv - oth)[rng.choice(row_idx, size=(B, len(sub)), replace=True)].mean(axis=1)
    lo, hi = np.percentile(d, 2.5) * 100, np.percentile(d, 97.5) * 100
    excl = 'EXCLUDES 0 (CI above zero)' if lo > 0 else 'INCLUDES 0'
    print(f'  Interviews - {c:30s}: boot mean = {(d.mean()*100):6.2f}pp  CI=[{lo:6.3f}, {hi:6.3f}]  {excl}')

# ---------- sensitivity across denominators ---------------------------------
print('\n=== Sensitivity: Interviews share under alternative denominators ===')
sens = {
    194: ('valid Q9 respondents (primary)', quoted['Q9_ML_Elicitation_Interviews'] / 194),
    174: ('respondents selecting >=1 technique', quoted['Q9_ML_Elicitation_Interviews'] / 174),
    276: ('all survey rows (NA counted as 0)',   quoted['Q9_ML_Elicitation_Interviews'] / 276),
}
for den, (lab, v) in sens.items():
    print(f'  Interviews {quoted["Q9_ML_Elicitation_Interviews"]:3d}/{den:3d} = {v*100:6.2f}%   [{lab}]')

# confirm rank stability: second place never overtakes Interviews under any denom
print('\n=== Rank check for runner-ups under each denominator ===')
best = 'Q9_ML_Elicitation_Interviews'
for den, (lab, v) in [ (194, ('valid', None)), (174, ('>=1', None)), (276, ('all', None)) ]:
    s = shares(den)
    ranked = sorted(Q9, key=lambda c: -s[c])
    print(f'  den={den:3d} top1={ranked[0]:45s} ({s[ranked[0]]*100:5.2f}%)   top2={ranked[1]:45s} ({s[ranked[1]]*100:5.2f}%)')

print('\n=== FINAL: most commonly used elicitation technique = Interviews ===')
