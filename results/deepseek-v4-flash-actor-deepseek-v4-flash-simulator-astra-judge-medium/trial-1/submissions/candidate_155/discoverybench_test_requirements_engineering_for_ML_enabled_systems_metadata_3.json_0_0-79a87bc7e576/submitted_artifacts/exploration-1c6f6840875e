"""DiscoveryBench episode: ML-enabled systems RE survey.
Stage 1 (plan): dataset inspection of Q9_ML_Elicitation_* columns and
proposal-oriented preliminary computations for 'most commonly used technique'."""
import pandas as pd, numpy as np, itertools

df = pd.read_csv('data/requirements_engineering_for_ML-enabled_systems.csv', encoding='utf-8-sig')
print('shape:', df.shape, '| Status:', df['Status'].value_counts().to_dict())

Q9 = [c for c in df.columns if c.startswith('Q9_ML_Elicitation') and 'Free' not in c]
print('\nQ9 items:', Q9)

# --- 1) scale / distribution / missing / negatives -------------------------
for c in Q9 + ['Q9_ML_Elicitation_Others_Free']:
    print('\n---', c, '---')
    print(df[c].value_counts(dropna=False).to_dict())

# --- 2) recode & valid sample ----------------------------------------------
rec = df[Q9].replace({'quoted': 1, 'not quoted': 0, '-77': np.nan}).astype(float)
valid = rec.notna()
n_valid = int(valid.all(axis=1).sum())
print('\nValid respondents (answered the Q9 grid, all six not -77):', n_valid, 'of', len(df))
print('Rows where ALL six Q9 are -77 (=NA):', int((rec.isna().all(axis=1)).sum()))
print('Rows with partial NA in Q9 grid:', int(rec.isna().any(axis=1).sum() - rec.isna().all(axis=1).sum()))
# NA rows are all Suspended with ~0 duration
na_rows = df[rec.isna().all(axis=1)]
print('NA rows Status:', na_rows['Status'].value_counts().to_dict(),
      '| Duration median:', na_rows['Duration'].median())

# --- 3) per-technique selected share among valid ----------------------------
quoted = rec.sum().astype(int)
print('\nSelected counts / share of valid (n=%d):' % n_valid)
for c in Q9:
    print('  %-45s %4d   %6.2f%%' % (c, quoted[c], quoted[c] / n_valid * 100))

# --- 4) respondents selecting >=1 technique ---------------------------------
anyq = rec.fillna(0).sum(axis=1)
print('\nValid respondents selecting >=1 technique:', int(((anyq > 0) & valid.all(axis=1)).sum()))
print('Share of Interviews among those selecting >=1:',
      f"{quoted['Q9_ML_Elicitation_Interviews'] / int(((anyq > 0) & valid.all(axis=1)).sum()) * 100:.2f}%")

# --- 5) nonparametric bootstrap 95% CI (percentile) -------------------------
rng = np.random.default_rng(42)
sub = rec.values[valid.all(axis=1).values]
B = 10_000
print('\nBootstrap (B={}, resample respondents, percentile 95% CI):'.format(B))
for j, c in enumerate(Q9):
    col = sub[:, j]
    props = col[np.random.randint(0, len(col), size=(B, len(col)))].mean(axis=1)
    print('  %-45s obs=%.3f%%  CI=[%.3f, %.3f]' % (c, props.mean() * 100,
          np.percentile(props, 2.5) * 100, np.percentile(props, 97.5) * 100))

# --- 6) search for any combination yielding ~0.69399 -------------------------
target = 0.69399
print('\nSearch for ~69.399%% from Q9 cells:')
for combo_r in range(1, 7):
    for combo in itertools.combinations(Q9, combo_r):
        s = int(quoted[list(combo)].sum())
        for d in (194, 276, 1164, 1656, int(quoted.sum())):
            v = s / d
            if abs(v - target) < 0.005:
                print('  NEAR: %s -> num=%d den=%d v=%.6f' % ('+'.join(combo), s, d, v))
print('  (none found in band 0.689-0.699)')

# --- 7) free-text mention scan across all *Free columns ----------------------
free_cols = [c for c in df.columns if 'Free' in c]
corpus = df[free_cols].fillna('').astype(str).agg(' '.join, axis=1).str.lower()
print('\nFree-text mention counts (whole corpus, n=276):')
for pat, lab in [(r'interview', 'interview'), (r'scenario', 'scenario'),
                 (r'prototyp', 'prototyp'), (r'workshop', 'workshop'),
                 (r'meeting', 'meeting'), (r'observ', 'observ')]:
    print('  %-12s %d' % (lab, corpus.str.contains(pat, regex=True, na=False).sum()))
