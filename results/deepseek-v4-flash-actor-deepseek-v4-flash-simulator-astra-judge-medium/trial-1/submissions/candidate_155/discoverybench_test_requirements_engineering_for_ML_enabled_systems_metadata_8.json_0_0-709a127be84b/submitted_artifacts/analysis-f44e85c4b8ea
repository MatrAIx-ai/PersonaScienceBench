"""
Analysis of documentation-format usage proportions (Q10) in
requirements_engineering_for_ML-enabled_systems.csv

Contract:
- One CSV row = one respondent (ID unique).
- Q10_ML_Documentation_* released coding is binary {quoted, not quoted}.
- '-77' marks the 82 'Suspended (22)' respondents (question not reached /
  non-response) -> excluded; effective sample n = 194.
- Candidate formats = concrete documentation formats only (exclude
  catch-alls: Not Documented, Others, Others_Free).
- Usage proportion = #respondents whose column == 'quoted' / n_valid.
- 95% CI via bootstrap percentile method (B=10,000, alpha=0.05, seed=42).
- Ranking by point estimate -> two least-used formats.
"""
import numpy as np
import pandas as pd

RNG = np.random.default_rng(42)
B = 10_000
ALPHA = 0.05

CSV = 'data/requirements_engineering_for_ML-enabled_systems.csv'
df = pd.read_csv(CSV)

# --- 1. Valid sample (exclude -77 non-respondents) -------------------------
q10_all = [c for c in df.columns if c.startswith('Q10_ML_Documentation') and not c.endswith('_Free')]
not_documented = (df['Q10_ML_Documentation_Not_Documented'] == '-77')
n_all = len(df)
n_excluded = int(not_documented.sum())
valid = df[~not_documented].copy()
n = len(valid)
assert n == n_all - n_excluded

# Concrete candidate formats (exclude catch-alls)
CONCRETE = {
    'Q10_ML_Documentation_Vision_Document':   'Vision Document',
    'Q10_ML_Documentation_Requirements_Lists': 'Requirements Lists',
    'Q10_ML_Documentation_Goal_Models':        'Goal Models',
    'Q10_ML_Documentation_Use_Case_Models':    'Use Case Models',
    'Q10_ML_Documentation_Prototypes':         'Prototypes',
    'Q10_ML_Documentation_User_Stories':       'User Stories',
    'Q10_ML_Documentation_BDD_Scenarios':      'BDD Scenarios',
    'Q10_ML_Documentation_MLCanvas':           'ML Canvas',
    'Q10_ML_Documentation_Notebooks':          'Notebooks',
    'Q10_ML_Documentation_Data_Models':        'Data Models',
}

# --- 2. Point estimates ----------------------------------------------------
counts = {c: int((valid[c] == 'quoted').sum()) for c in CONCRETE}
props = {c: counts[c] / n for c in CONCRETE}

# --- 3. Bootstrap percentile 95% CIs --------------------------------------
ci = {}
for c in CONCRETE:
    x = (valid[c] == 'quoted').values.astype(int)
    boot = np.array([x[RNG.integers(0, n, size=n)].mean() for _ in range(B)])
    ci[c] = (np.percentile(boot, 100 * ALPHA / 2) * 100,
             np.percentile(boot, 100 * (1 - ALPHA / 2)) * 100)

rows = sorted(CONCRETE.items(), key=lambda kv: props[kv[0]])
print(f"Data: {n_all} rows, excluded -77 (suspended non-respondents): {n_excluded}, effective n = {n}")
print(f"{'Format':<20}{'quoted':>8}{'proportion':>12}{'95% bootstrap CI':>22}")
for c, name in rows:
    print(f"{name:<20}{counts[c]:>8}{props[c]*100:>11.3f}%[{ci[c][0]:.3f}, {ci[c][1]:.3f}]")

least_two = [name for _, name in rows[:2]]
print("\nTwo least-used concrete documentation formats (by point estimate):")
for name in least_two:
    c = [k for k, v in CONCRETE.items() if v == name][0]
    print(f"  - {name}: {counts[c]}/{n} = {props[c]*100:.3f}%  (95% CI [{ci[c][0]:.3f}, {ci[c][1]:.3f}])")

# --- 4. Evidence tables for artifact --------------------------------------
summary = pd.DataFrame([
    {'format': CONCRETE[c], 'quoted': counts[c], 'n_valid': n,
     'proportion_pct': round(props[c] * 100, 3),
     'ci_low_pct': round(ci[c][0], 3), 'ci_high_pct': round(ci[c][1], 3)}
    for c in CONCRETE
]).sort_values('proportion_pct').reset_index(drop=True)
summary.to_csv('q10_usage_proportions.csv', index=False)
print("\nSaved table -> q10_usage_proportions.csv")
print(summary.to_string(index=False))
