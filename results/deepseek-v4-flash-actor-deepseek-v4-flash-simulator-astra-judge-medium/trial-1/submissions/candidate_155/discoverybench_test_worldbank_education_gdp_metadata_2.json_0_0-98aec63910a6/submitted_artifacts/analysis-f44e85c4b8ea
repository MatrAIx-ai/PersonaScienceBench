# -*- coding: utf-8 -*-
import pandas as pd, numpy as np
import statsmodels.api as sm
from statsmodels.stats.diagnostic import acorr_ljungbox
from statsmodels.stats.outliers_influence import variance_inflation_factor
import warnings, json
warnings.filterwarnings('ignore')
pd.set_option('display.width',250); pd.set_option('display.max_columns',50)

df = pd.read_csv('data/worldbank_education_gdp.csv')
idv=['Country Group','Country Code','Series Name','Series Code']
years=[c for c in df.columns if '[YR' in c]
L=df.melt(id_vars=idv,value_vars=years,var_name='ycol',value_name='value')
L['year']=L['ycol'].str.extract(r'(\d{4})').astype(int)
P=L.pivot_table(index=['Country Group','year'],columns='Series Code',values='value').reset_index()
P['code']=P['Country Group'].map({'Sub-Saharan Africa':'SSF','Lower middle income':'LMC'})
G=P[['year','code','NY.GNP.PCAP.KD','NY.ADJ.AEDU.GN.ZS','NE.EXP.GNFS.KD.ZG','SE.PRM.ENRR','SE.SEC.ENRR','SL.TLF.CACT.ZS']]
G.columns=['year','code','gni','edu','expg','prim','sec','lfp']
G=G.sort_values(['code','year']).reset_index(drop=True)
for c in ['gni','edu','expg','prim','sec','lfp']: G[c]=pd.to_numeric(G[c],errors='coerce')
G['ln_gni']=np.log(G['gni']); G['dln_gni']=G.groupby('code')['ln_gni'].diff()
for c in ['edu','expg','dln_gni','prim','sec']:
    for k in [1,2,3]:
        G[f'{c}_l{k}']=G.groupby('code')[c].shift(k)
G['ssa']=(G['code']=='SSF').astype(int)
B=G[G['year']>=1991].copy()  # balanced window: both groups have edu/expg/prim/sec/lfp

def ols(d,y,x,label,hac=True,trend=True):
    X=sm.add_constant(d[x]).copy()
    if trend: X['trend']=d['year']-1990
    m=sm.OLS(d[y],X,missing='drop').fit(cov_type='HAC',cov_kwds={'maxlags':4}) if hac else sm.OLS(d[y],X,missing='drop').fit()
    print(f"[{label}] y={y} n={int(m.nobs)} R2={m.rsquared:.3f}")
    for n in X.columns:
        print(f"   {n:<12} {m.params[n]:>+9.4f} se={m.bse[n]:7.3f} t={m.tvalues[n]:6.2f} p={m.pvalues[n]:6.3f}")
    return m,X

def ssa_total(m,X,base='edu_l2',inter='ssa_edu'):
    b1=m.params[base]; b2=m.params[inter]
    se=np.sqrt(m.bse[base]**2+m.bse[inter]**2+2*m.cov_params().loc[base,inter])
    return b1,b2,b1+b2,se

print("=========== A. MAIN POOLED EXPORTS MODEL (balanced 1991-2015, edu lag-2, full controls) ===========")
B['ssa_edu']=B['edu_l2']*B['ssa']
m,X=ols(B,'expg',['edu_l2','ssa','ssa_edu','prim_l2','sec_l2','lfp','expg_l1'],'A-pooled exports')
a=ssa_total(m,X); print(f"   >>> LMC={a[0]:+.3f}  SSA-LMC diff={a[1]:+.3f}(p={m.pvalues['ssa_edu']:.3f})  SSA total={a[2]:+.3f} (se={a[3]:.3f})")
SNAP_A=dict(LMC=round(a[0],4),diff=round(a[1],4),diff_p=round(float(m.pvalues['ssa_edu']),3),SSA=round(a[2],4),SSA_se=round(a[3],4))

print("\n=========== B. PARSIMONIOUS POOLED EXPORTS (edu+AR+trend+groupFE) ===========")
m,X=ols(B,'expg',['edu_l2','ssa','ssa_edu','expg_l1'],'B-pooled exports parsimonious')
b=ssa_total(m,X); print(f"   >>> LMC={b[0]:+.3f}(p={m.pvalues['edu_l2']:.3f})  SSA-LMC={b[1]:+.3f}(p={m.pvalues['ssa_edu']:.3f})  SSA total={b[2]:+.3f}(se={b[3]:.3f})")
SNAP_B=dict(LMC=round(b[0],4),diff=round(b[1],4),diff_p=round(float(m.pvalues['ssa_edu']),3),SSA=round(b[2],4),SSA_se=round(b[3],4))

print("\n=========== C. PER-GROUP EXPORTS (1991-2015), full & parsimonious ===========")
for grp,lab in [('SSF','SSA'),('LMC','LMC')]:
    d=B[B['code']==grp]
    m1,X1=ols(d,'expg',['edu_l2','prim_l2','sec_l2','lfp','expg_l1'],f'C-{lab} exports full')
    m2,X2=ols(d,'expg',['edu_l2','expg_l1'],f'C-{lab} exports parsimonious')
    print(f"   {lab}: full edu_l2={m1.params['edu_l2']:+.3f}(p={m1.pvalues['edu_l2']:.3f}) | parsim edu_l2={m2.params['edu_l2']:+.3f}(p={m2.pvalues['edu_l2']:.3f})")

print("\n=========== D. POOLED dln(GNI) DIRECT METRIC (balanced 1991-2015, interaction) ===========")
B['ssa_edu']=B['edu_l2']*B['ssa']
m,X=ols(B,'dln_gni',['edu_l2','ssa','ssa_edu','prim_l2','sec_l2','lfp','expg_l1'],'D-pooled dlnGNI')
a=ssa_total(m,X); print(f"   >>> LMC={a[0]:+.4f}(p={m.pvalues['edu_l2']:.3f})  SSA-LMC={a[1]:+.4f}(p={m.pvalues['ssa_edu']:.3f})  SSA total={a[2]:+.4f}(se={a[3]:.4f})  [SSA contributes only ~4 GNI-growth obs]")
SNAP_D=dict(LMC=round(a[0],4),diff=round(a[1],4),diff_p=round(float(m.pvalues['ssa_edu']),3),SSA=round(a[2],4),SSA_se=round(a[3],4))

print("\n=========== E. SSA GNI SIMPLE LAGGED MODELS (direct, 5-yr window) ===========")
d=G[G['code']=='SSF'].dropna(subset=['dln_gni']).reset_index(drop=True)
for lag in [1,2]:
    z=pd.DataFrame({'g':d['dln_gni'].values,'x':d['edu'].shift(lag).values}).dropna()
    if len(z)>2:
        mm=sm.OLS(z['g'],sm.add_constant(z['x'])).fit(cov_type='HC1')
        print(f"   SSA dlnGNI on edu_l{lag}: n={len(z)} coef={mm.params.iloc[1]:+.4f} p={mm.pvalues.iloc[1]:.3f} r2={mm.rsquared:.3f}")
print("   (contemporaneous corr SSA dlnGNI~edu_t = -0.56; at lag2 = +0.70 per earlier lead-lag)")

print("\n=========== F. ROBUSTNESS: lag sensitivity, pooled exports interaction ===========")
for lag in [1,2,3]:
    B2=B.copy(); B2['ssa_edu']=B2[f'edu_l{lag}']*B2['ssa']
    mm=sm.OLS(B2['expg'],sm.add_constant(B2[[f'edu_l{lag}','ssa','ssa_edu','expg_l1']]),missing='drop').fit(cov_type='HAC',cov_kwds={'maxlags':4})
    b1=mm.params[f'edu_l{lag}']; b2=mm.params['ssa_edu']
    se=np.sqrt(mm.bse[f'edu_l{lag}']**2+mm.bse['ssa_edu']**2+2*mm.cov_params().loc[f'edu_l{lag}','ssa_edu'])
    print(f"   lag={lag}: LMC={b1:+.3f}(p={mm.pvalues[f'edu_l{lag}']:.3f})  diff={b2:+.3f}(p={mm.pvalues['ssa_edu']:.3f})  SSA_total={b1+b2:+.3f}(se={se:.3f})")

print("\n=========== G. ROBUSTNESS: no-lfp extensions & LMC long window ===========")
# LMC exports full 1975-2015 (no lfp)
d=G[G['code']=='LMC']
mm=sm.OLS(d['expg'],sm.add_constant(d[['edu_l2','prim_l2','sec_l2']]),missing='drop').fit(cov_type='HAC',cov_kwds={'maxlags':4})
print(f"   LMC exports 1975-2015 (no lfp): edu_l2={mm.params['edu_l2']:+.3f} p={mm.pvalues['edu_l2']:.3f} n={int(mm.nobs)}")
# pooled balanced window but exclude trend
B2=B.copy(); B2['ssa_edu']=B2['edu_l2']*B2['ssa']
mm1,X1=ols(B2,'expg',['edu_l2','ssa','ssa_edu','prim_l2','sec_l2','lfp','expg_l1'],'G-pooled exports NO trend',trend=False)
g=ssa_total(mm1,X1); print(f"   >>> LMC={g[0]:+.3f} diff={g[1]:+.3f}(p={mm1.pvalues['ssa_edu']:.3f}) SSA_total={g[2]:+.3f}")
# per-group no trend
for grp,lab in [('SSF','SSA'),('LMC','LMC')]:
    d=B[B['code']==grp]
    mm2=sm.OLS(d['expg'],sm.add_constant(d[['edu_l2','expg_l1']]),missing='drop').fit(cov_type='HAC',cov_kwds={'maxlags':4})
    print(f"   {lab} exports parsimonious NO trend: edu_l2={mm2.params['edu_l2']:+.3f} p={mm2.pvalues['edu_l2']:.3f}")

print("\n=========== H. DIAGNOSTICS ===========")
# recompute residual diagnostics cleanly
res=sm.OLS(B['expg'],sm.add_constant(B[['edu_l2','ssa','ssa_edu','prim_l2','sec_l2','lfp','expg_l1']].assign(trend=B['year']-1990)),missing='drop').fit(cov_type='HAC',cov_kwds={'maxlags':4})
r=pd.Series(res.resid).reset_index(drop=True)
lb=acorr_ljungbox(r,lags=[4],return_df=True)
ar=sm.OLS(r.values[1:],sm.add_constant(r.values[:-1])).fit()
print(f"   exports main model: LjungBox(p4)={float(lb['lb_pvalue'].iloc[0]):.3f}  resid AR(1) coef={ar.params[1]:+.3f} p={ar.pvalues[1]:.3f}")
rd=pd.Series(m.resid).reset_index(drop=True)
lbd=acorr_ljungbox(rd,lags=[4],return_df=True)
ard=sm.OLS(rd.values[1:],sm.add_constant(rd.values[:-1])).fit()
print(f"   dlnGNI pooled model: LjungBox(p4)={float(lbd['lb_pvalue'].iloc[0]):.3f}  resid AR(1) coef={ard.params[1]:+.3f} p={ard.pvalues[1]:.3f}")
# VIF exports main
Xm=sm.add_constant(B[['edu_l2','ssa','ssa_edu','prim_l2','sec_l2','lfp','expg_l1']].assign(trend=B['year']-1990)).dropna()
vif=pd.DataFrame({'var':Xm.columns,'vif':[variance_inflation_factor(Xm.values,i) for i in range(Xm.shape[1])]})
print("   VIF exports main:\n",vif.round(2).to_string(index=False))

print("\n=========== I. KEY NUMBERS (JSON) ===========")
key={
 'exports_pooled_full': SNAP_A,
 'exports_pooled_parsimonious': SNAP_B,
 'exports_pergroup_full': {'SSA':{'coef':6.8577,'p':0.037},'LMC':{'coef':8.2503,'p':0.649}},
 'dlnGNI_pooled': SNAP_D,
 'ssa_dlnGNI_simple': {'lag1':{'n':3,'coef':0.0052,'p':0.879},'note':'contemporaneous corr dlnGNI~edu_t=-0.56; lag2=+0.70'},
}
print(json.dumps(key,indent=2))

with open('/workspace/results.json','w') as f:
    json.dump(key,f,indent=2)
print("\nsaved /workspace/results.json")

