import pandas as pd, numpy as np, json

df = pd.read_csv('data/worldbank_education_gdp.csv')
print("Raw shape:", df.shape)
print("Columns:", list(df.columns))
print("Country groups:", df['Country Group'].unique().tolist())
print("Country codes:", df.groupby('Country Group')['Country Code'].first().to_dict())
print("Series count:", df['Series Name'].nunique(), "| per group rows:", df.groupby('Country Group').size().to_dict())

# Melt to long
id_vars = ['Country Group','Country Code','Series Name','Series Code']
years = [c for c in df.columns if '[YR' in c]
long = df.melt(id_vars=id_vars, value_vars=years, var_name='year_col', value_name='value')
long['year'] = long['year_col'].str.extract(r'(\d{4})').astype(int)
print("\nLong shape (units x series x years):", long.shape)

# Missingness by series (overall and by group)
miss = long.assign(isna=long['value'].isna()).groupby('Series Code')[['isna']].agg(
    total=('isna','count'), missing=('isna','sum'))
miss['pct_missing'] = (100*miss['missing']/miss['total']).round(1)
print("\n=== Missingness by Series (both groups combined) ===")
print(miss)

miss_g = long.assign(isna=long['value'].isna()).groupby(['Series Code','Country Group'])[['isna']].agg(
    total=('isna','count'), missing=('isna','sum'))
miss_g['pct_missing'] = (100*miss_g['missing']/miss_g['total']).round(1)
print("\n=== Missingness by Series x Group ===")
print(miss_g)

# Effective availability range per series/group
avail = long.dropna(subset=['value']).groupby(['Series Code','Country Group'])['year'].agg(['min','max','count'])
print("\n=== Available year range per Series x Group (of 1975-2015) ===")
print(avail)

# Per group GNI coverage
for g in ['Sub-Saharan Africa','Lower middle income']:
    gni = long[(long['Country Group']==g)&(long['Series Code']=='NY.GNP.PCAP.KD')].dropna()
    print(f"\n{g}: GNI per-capita years available = {gni['year'].min()}-{gni['year'].max()} (n={len(gni)})")

# Describe numeric ranges
print("\n=== Numeric summaries per series (both groups) ===")
print(long.groupby('Series Code')['value'].agg(['count','min','max','mean','std']).round(3))

# Descriptive panel summary per group across available series
piv = long.dropna().pivot_table(index=['Country Group','year'], columns='Series Code', values='value')
print("\n=== Balanced overlap rows (all 6 series together) ===")
ov = long.dropna(subset=['value']).groupby(['Country Group','year']).size().unstack('Country Group')
print(ov)
print("\nRows with all 6 series (SSA):", (ov['Sub-Saharan Africa']==6).sum(), "| first:", ov.index[(ov['Sub-Saharan Africa']==6)][:1] if (ov['Sub-Saharan Africa']==6).any() else None)
print("Rows with all 6 series (LMC):", (ov['Lower middle income']==6).sum(), "| first:", ov.index[(ov['Lower middle income']==6)][:1] if (ov['Lower middle income']==6).any() else None)
