import pandas as pd, numpy as np

df = pd.read_csv('data/worldbank_education_gdp.csv')
id_vars=['Country Group','Country Code','Series Name','Series Code']
years=[c for c in df.columns if '[YR' in c]
l=df.melt(id_vars=id_vars,value_vars=years,var_name='ycol',value_name='value')
l['year']=l['ycol'].str.extract(r'(\d{4})').astype(int)
piv=l.pivot_table(index=['Country Group','year'],columns='Series Code',values='value').reset_index()
piv['code']=piv['Country Group'].map({'Sub-Saharan Africa':'SSF','Lower middle income':'LMC'})

cols=['year','code','NY.GNP.PCAP.KD','NY.ADJ.AEDU.GN.ZS','NE.EXP.GNFS.KD.ZG','SE.PRM.ENRR','SE.SEC.ENRR','SL.TLF.CACT.ZS']
for grp in ['SSF','LMC']:
    d=piv[piv['code']==grp].sort_values('year').reset_index(drop=True)
    print(f"--- {grp} n={len(d)} ---")
    # GNI level vs edu exp at various lags
    dd=d.dropna(subset=['NY.GNP.PCAP.KD'])
    row={}
    for lag in [0,1,2,3,5]:
        x=dd['NY.ADJ.AEDU.GN.ZS'].shift(lag)
        z=pd.DataFrame({'x':x.values,'y':dd['NY.GNP.PCAP.KD'].values}).dropna()
        row[lag]=round(np.corrcoef(z['x'],z['y'])[0,1],3) if len(z)>3 else None
    print("  corr(GNI_level, eduExp with lag L):", row)
    d['lg']=np.log(d['NY.GNP.PCAP.KD']).diff()
    for lab,l in [('t',0),('t-1',1),('t-2',2)]:
        z=pd.DataFrame({'g':d['lg'].values,'x':d['NY.ADJ.AEDU.GN.ZS'].shift(l).values}).dropna()
        print(f"  corr(dlogGNI, eduExp_{lab}):", round(np.corrcoef(z['g'],z['x'])[0,1],3) if len(z)>3 else None)
    # exports growth proxy (researcher mapping)
    for lab,l in [('t',0),('t-1',1),('t-2',2),('t-3',3)]:
        z=pd.DataFrame({'ex':d['NE.EXP.GNFS.KD.ZG'].values,'x':d['NY.ADJ.AEDU.GN.ZS'].shift(l).values}).dropna()
        print(f"  corr(exports_growth, eduExp_{lab}):", round(np.corrcoef(z['ex'],z['x'])[0,1],3) if len(z)>3 else None)
    print()
