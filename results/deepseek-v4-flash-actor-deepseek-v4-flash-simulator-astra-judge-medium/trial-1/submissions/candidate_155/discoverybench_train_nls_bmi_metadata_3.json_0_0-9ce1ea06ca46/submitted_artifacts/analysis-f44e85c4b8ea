"""
Full analysis: How does age influence the likelihood of dissaving (DISSAVED)?
NLSY79 young-adult cross-section, 1989 (ages 24-32).
"""
import pandas as pd
import numpy as np
import statsmodels.formula.api as smf
import statsmodels.api as sm
from scipy import stats
import json, warnings
warnings.filterwarnings("ignore")

rng = np.random.default_rng(20261022)
df = pd.read_csv('data/nls_bmi_processed.csv')
df['MALE'] = (df['GENDER'] == 'MALE').astype(int)
df['AGE_C'] = df['AGE'] - 28.0            # centered
df['AGE_C2'] = df['AGE_C'] ** 2

out = {}
n = df.shape[0]
out['n'] = n
out['p_dissaved'] = float(df['DISSAVED'].mean())

# ---------- outcome / joint pattern ----------
age_tab = df.groupby('AGE')['DISSAVED'].agg(['count', 'mean'])
out['age_mean_dissave'] = {int(a): round(m, 4) for a, m in zip(age_tab.index, age_tab['mean'])}
df['band'] = pd.cut(df['AGE'], bins=[23, 27, 30, 32], labels=['b24_27', 'b28_30', 'b31_32'])
band_tab = df.groupby('band', observed=True)['DISSAVED'].agg(['count', 'mean'])
out['band_mean_dissave'] = {str(b): round(m, 4) for b, m in zip(band_tab.index, band_tab['mean'])}

# ---------- helper: predict P at ages with delta-method CI ----------
def pred_ci(model, df_base, ages):
    """Predicted P at each age with delta-method 95% CI (reference covariate profile)."""
    from patsy import dmatrix
    rows = []
    for a in ages:
        r = df_base.to_dict()
        r['AGE'] = a; r['AGE_2'] = a * a
        r['AGE_C'] = a - 28.0; r['AGE_C2'] = (a - 28.0) ** 2
        rows.append(r)
    Xpred = pd.DataFrame(rows)
    eta = model.predict(Xpred, linear=True)
    if hasattr(model.model, 'family'):
        link_inv = model.model.family.link.inverse
    else:
        link_inv = model.model.link.inverse
    Xm_full = dmatrix(model.model.data.design_info, Xpred)
    V = model.cov_params().values
    se = np.sqrt(np.einsum('ij,jk,ik->i', Xm_full, V, Xm_full))
    lo = link_inv(eta - 1.96 * se)
    hi = link_inv(eta + 1.96 * se)
    p = link_inv(eta)
    res = {}
    for i in range(len(ages)):
        res[int(ages[i])] = {'p': round(float(p[i]), 4),
                             'ci95': [round(float(lo[i]), 4), round(float(hi[i]), 4)]}
    return res

def params_dict(m):
    return {k: {'b': round(float(v), 4), 'p': round(float(m.pvalues[k]), 4)} for k, v in m.params.items()}
# ---------- fit models ----------
m_lin_u = smf.logit('DISSAVED ~ AGE', data=df).fit(disp=0)                       # unadjusted linear
m_lin_a = smf.logit('DISSAVED ~ AGE + INCOME + MALE + BLACK + HISPANIC + BMI', data=df).fit(disp=0)
# Quadratic (centered)
m_qua_u = smf.logit('DISSAVED ~ AGE_C + AGE_C2', data=df).fit(disp=0)
m_qua_a = smf.logit('DISSAVED ~ AGE_C + AGE_C2 + INCOME + MALE + BLACK + HISPANIC + BMI', data=df).fit(disp=0)


out['linear_unadj'] = {'coefs': params_dict(m_lin_u), 'OR_year': float(np.exp(m_lin_u.params['AGE'])),
                       'OR_ci': [float(np.exp(m_lin_u.conf_int().loc['AGE', 0])),
                                 float(np.exp(m_lin_u.conf_int().loc['AGE', 1]))],
                       'AIC': round(float(m_lin_u.aic), 1), 'BIC': round(float(m_lin_u.bic), 1)}
out['linear_adj'] = {'coefs': params_dict(m_lin_a), 'OR_year': float(np.exp(m_lin_a.params['AGE'])),
                     'OR_ci': [float(np.exp(m_lin_a.conf_int().loc['AGE', 0])),
                               float(np.exp(m_lin_a.conf_int().loc['AGE', 1]))],
                     'AIC': round(float(m_lin_a.aic), 1), 'BIC': round(float(m_lin_a.bic), 1)}
out['quad_unadj'] = {'coefs': params_dict(m_qua_u), 'AIC': round(float(m_qua_u.aic), 1),
                     'BIC': round(float(m_qua_u.bic), 1)}
out['quad_adj'] = {'coefs': params_dict(m_qua_a), 'AIC': round(float(m_qua_a.aic), 1),
                   'BIC': round(float(m_qua_a.bic), 1)}

# LR tests (likelihood-ratio, nested: linear -> quadratic)
def lr_p(m_small, m_large):
    stat = 2 * (m_large.llf - m_small.llf)
    return float(stat), float(1 - stats.chi2.cdf(stat, df=m_large.df_model - m_small.df_model))
out['lr_test_unadj'] = {'chi2': lr_p(m_lin_u, m_qua_u)[0], 'p': lr_p(m_lin_u, m_qua_u)[1]}
out['lr_test_adj'] = {'chi2': lr_p(m_lin_a, m_qua_a)[0], 'p': lr_p(m_lin_a, m_qua_a)[1]}

# ---------- AMEs ----------
ame_lin_u = m_lin_u.get_margeff()
ame_lin_a = m_lin_a.get_margeff()
out['AME_linear_unadj'] = {'ame': round(float(ame_lin_u.margeff[0]), 4),
                           'se': round(float(ame_lin_u.margeff_se[0]), 4),
                           'p': round(float(ame_lin_u.pvalues[0]), 4)}
out['AME_linear_adj'] = {'ame': round(float(ame_lin_a.margeff[0]), 4),
                         'se': round(float(ame_lin_a.margeff_se[0]), 4),
                         'p': round(float(ame_lin_a.pvalues[0]), 4)}

# AME of AGE in quadratic model = b1 + 2*b2*(a-28), evaluated at sample ages; avg = AME
b1, b2 = m_qua_a.params['AGE_C'], m_qua_a.params['AGE_C2']
vc = m_qua_a.cov_params().loc[['AGE_C', 'AGE_C2'], ['AGE_C', 'AGE_C2']]
def me_se(a):
    g = np.array([1.0, 2 * (a - 28.0)])
    me = b1 + 2 * b2 * (a - 28.0)
    se = np.sqrt(g @ vc @ g)
    return me, se
ames = {int(a): me_se(a)[0] for a in range(24, 33)}
ame_avg = float(np.mean([ames[a] for a in range(24, 33)]))
out['AME_quad_adj_by_age'] = {a: round(v, 4) for a, v in ames.items()}
out['AME_quad_adj_avg'] = round(ame_avg, 4)

# reference profile: means for continuous covariates, mode 0 for indicators
ref = {'INCOME': float(df['INCOME'].mean()), 'BMI': float(df['BMI'].mean()),
       'MALE': 0.0, 'BLACK': 0.0, 'HISPANIC': 0.0}
ref_base = pd.Series(ref)

# ---------- predicted probabilities (adjusted quadratic, reference profile) ----------
ages = [24, 25, 26, 27, 28, 29, 30, 31, 32]
pred_main = pred_ci(m_qua_a, ref_base, ages)
out['pred_quad_adj'] = pred_main
peak = b1 / (2 * (-b2)) + 28.0   # -b1/(2*b2) solves b1+2b2*(a-28)=0
out['quad_peak_age_adjusted'] = round(float(peak), 2)

# ---------- robustness ----------
# 1) probit
m_prob = smf.probit('DISSAVED ~ AGE_C + AGE_C2 + INCOME + MALE + BLACK + HISPANIC + BMI', data=df).fit(disp=0)
out['probit_AIC'] = round(float(m_prob.aic), 1)
# probit predicted at 24/28/32
pred_prob = pred_ci(m_prob, ref_base, [24, 28, 32])
out['pred_probit_quad_adj'] = pred_prob

# 2) age banding (logistic with band dummies + no intercept)
band_d = pd.get_dummies(df['band'], prefix='band', drop_first=False).astype(int)
dfb = pd.concat([df, band_d], axis=1)
m_band = smf.logit('DISSAVED ~ band_b24_27 + band_b28_30 + band_b31_32 + INCOME + MALE + BLACK + HISPANIC + BMI - 1', data=dfb).fit(disp=0)
out['band_logit'] = {b: {'p_dissave': round(float(1/(1+np.exp(-m_band.params[b]))), 4)} for b in
                     ['band_b24_27', 'band_b28_30', 'band_b31_32']}

# 3) BMI winsorization (99th pct)
bmi99 = np.percentile(df['BMI'], 99)
dfw = df.copy(); dfw['BMI_w'] = dfw['BMI'].clip(upper=bmi99)
m_bmi = smf.logit('DISSAVED ~ AGE_C + AGE_C2 + INCOME + MALE + BLACK + HISPANIC + BMI_w', data=dfw).fit(disp=0)
out['bmi_winsor'] = {'p99': round(float(bmi99), 2), 'AGE_C2_p': round(float(m_bmi.pvalues['AGE_C2']), 4),
                     'AGE_C2_b': round(float(m_bmi.params['AGE_C2']), 4)}

# 4) INCOME imputation-cluster sensitivity: (a) add flag, (b) drop at-mean cluster
df['inc_imp'] = (df['INCOME'] == df['INCOME'].mean()).astype(int)
m_flag = smf.logit('DISSAVED ~ AGE_C + AGE_C2 + INCOME + inc_imp + MALE + BLACK + HISPANIC + BMI', data=df).fit(disp=0)
out['income_flag'] = {'inc_imp_coef': round(float(m_flag.params['inc_imp']), 4),
                      'inc_imp_p': round(float(m_flag.pvalues['inc_imp']), 4),
                      'AGE_C2_p': round(float(m_flag.pvalues['AGE_C2']), 4)}
pdf = df[df['INCOME'] != df['INCOME'].mean()]
m_drop = smf.logit('DISSAVED ~ AGE_C + AGE_C2 + INCOME + MALE + BLACK + HISPANIC + BMI', data=pdf).fit(disp=0)
out['income_drop_n'] = int(pdf.shape[0])
out['income_drop'] = {'AGE_C2_p': round(float(m_drop.pvalues['AGE_C2']), 4),
                      'AGE_C2_b': round(float(m_drop.params['AGE_C2']), 4),
                      'AGE_p': round(float(m_drop.pvalues['AGE_C']), 4)}

# 5) bootstrap CIs for predicted P at 24/28/32 and AME at 28 (adjusted quadratic)
REPS = 100
boot_pred = {a: [] for a in [24, 28, 32]}
boot_ame28 = []
Xs = df[['AGE_C', 'AGE_C2', 'INCOME', 'MALE', 'BLACK', 'HISPANIC', 'BMI']]
y = df['DISSAVED'].values
idx = np.arange(n)
for b in range(REPS):
    s = rng.choice(idx, size=n, replace=True)
    d = Xs.iloc[s].copy(); d['DISSAVED'] = y[s]
    try:
        m = smf.logit('DISSAVED ~ AGE_C + AGE_C2 + INCOME + MALE + BLACK + HISPANIC + BMI', data=d).fit(disp=0, maxiter=50)
        bb1, bb2 = m.params['AGE_C'], m.params['AGE_C2']
        boot_ame28.append(bb1 + 2 * bb2 * 0.0)
        for a in [24, 28, 32]:
            x = np.array([1.0, a - 28.0, (a - 28.0) ** 2,
                          ref['INCOME'], 0.0, 0.0, 0.0, ref['BMI']])
            boot_pred[a].append(1 / (1 + np.exp(-(x @ m.params.values))))
    except Exception:
        pass
out['bootstrap'] = {
    'reps_used': len(boot_pred[24]),
    'pred24_ci95': [round(float(np.percentile(boot_pred[24], 2.5)), 4), round(float(np.percentile(boot_pred[24], 97.5)), 4)],
    'pred28_ci95': [round(float(np.percentile(boot_pred[28], 2.5)), 4), round(float(np.percentile(boot_pred[28], 97.5)), 4)],
    'pred32_ci95': [round(float(np.percentile(boot_pred[32], 2.5)), 4), round(float(np.percentile(boot_pred[32], 97.5)), 4)],
    'ame28_ci95': [round(float(np.percentile(boot_ame28, 2.5)), 4), round(float(np.percentile(boot_ame28, 97.5)), 4)],
}

# optional robustness: 3-category multinomial (dissave vs same vs save) -- not centerpiece
mlogit = sm.MNLogit(df['DISSAVED'].values + 2 * df['SAMESAVE'].values,  # 0=save(deposit>withdraw),1=dissave,2=same
                    sm.add_constant(Xs[['AGE_C', 'AGE_C2']].values)).fit(disp=0)
out['multinom_DISSAVED_vs_SAVE_AgeC_p'] = round(float(mlogit.pvalues[0, 1]), 4)   # column 1 = dissave

with open('analysis/results_summary.json', 'w') as f:
    json.dump(out, f, indent=2, default=str)
print("Saved analysis/results_summary.json")
