"""Full analysis: does increased time preference (savings/wealth proxy) predict higher BMI?
DiscoveryBench episode: nls_bmi_raw. Observational association only, no causal claim.
"""
import pandas as pd, numpy as np
import statsmodels.api as sm
from scipy import stats as sst

df = pd.read_csv('data/nls_raw.csv')

# ---------- 0. Derived variables ----------
# Height 1981 is feet+inch concatenation (507 = 5'07")
df['h81_in'] = (df['Height of respondent, 1981']//100)*12 + (df['Height of respondent, 1981']%100)
df['h_best'] = df['Height of respondent, 1985'].fillna(df['h81_in'])   # adult height
# BMI = 703 * lb / in^2
df['bmi81'] = 703*df['Weight of respondent, 1981']/df['h81_in']**2
df['bmi89'] = 703*df['Weight of respondent, 1989']/df['h_best']**2
df['bmi92'] = 703*df['Weight of respondent, 1992']/df['h_best']**2
for c in ['bmi81','bmi89','bmi92']:
    df.loc[~df[c].between(10,60), c] = np.nan

# Education cleanup (max==95 invalid)
df['educ79'] = df['Highest grade completed, 1979']
df.loc[df['educ79']>20, 'educ79'] = np.nan

# ASVAB composite (mean of available, need >=2 subtests)
asv = [c for c in df.columns if 'ASVAB' in c]
df['asvab'] = df[asv].mean(axis=1)
df['asvab'] = np.where(df[asv].notna().sum(axis=1)>=2, df['asvab'], np.nan)

# Proxy A: savings behavior 1989 (1 put in, 2 took out, 3 no change, 4 no savings)
df['sav_dir'] = df['Was more money put into or taken out of R/spouse savings since last interview, 1989']
for lbl,val in [('sav_putin',1),('sav_tookout',2),('sav_nochg',3),('sav_nosav',4)]:
    df[lbl] = (df['sav_dir']==val).astype(int)

# Proxy B: wealth accumulation (lowest quarter -> high time-preference proxy)
df['nw90'] = df['Family net wealth, 1990']
df['nw96'] = df['Family net wealth, 1996 (key data point)']
df['lowNW90'] = np.where(df['nw90'].isna(), np.nan, (df['nw90'].rank(pct=True)<0.25).astype(int))
df['lowNW96'] = np.where(df['nw96'].isna(), np.nan, (df['nw96'].rank(pct=True)<0.25).astype(int))
df['wr90'] = df['nw90']/df['Total net family income, previous calendar year, 1989'].clip(lower=1)
df['wr96'] = df['nw96']/df['Total net family income, previous calendar year, 1989'].clip(lower=1)
df['lowWR90'] = np.where(df['wr90'].isna(), np.nan, (df['wr90'].rank(pct=True)<0.25).astype(int))
df['lowWR96'] = np.where(df['wr96'].isna(), np.nan, (df['wr96'].rank(pct=True)<0.25).astype(int))

# Incomes (log)
inc_map = {'79':1979,'85':1985,'89':1989}
for suf,yr in inc_map.items():
    df[f'lninc{suf}'] = np.log1p(df[f'Total net family income, previous calendar year, {yr}'].clip(lower=0))

# Demographics / confounders
df['age79'] = df['Age of respondent, 1979']
df['female'] = (df['Sex of respondent, 1979']==2).astype(int)
df['black'] = (df['Racial/ethnic cohort, 1979']==1).astype(int)
df['hisp']  = (df['Racial/ethnic cohort, 1979']==2).astype(int)
df['famsize79'] = df['Family size, 1979']
df['mom_educ'] = df["Highest grade completed by respondent's mother, 1979"]
df['dad_educ'] = df["Highest grade completed by respondent's father, 1979"]
df['focc'] = df['Occupation of adult male in household at age 14, 1979']

CORE = ['age79','female','black','hisp','educ79','lninc79','lninc89','famsize79','mom_educ','dad_educ','asvab']

print("="*100)
print("SAMPLE SIZES")
print(f"  sav_dir: {df['sav_dir'].notna().sum()}; bmi89: {df.bmi89.notna().sum()}; bmi92: {df.bmi92.notna().sum()}")
print(f"  nw90: {df.nw90.notna().sum()}; nw96: {df.nw96.notna().sum()}")
print(f"  complete-case bmi89+sav_dir+core: {len(df[CORE+['bmi89','sav_dir']].dropna())}")
print(f"  complete-case bmi92+sav_dir+core: {len(df[CORE+['bmi92','sav_dir']].dropna())}")

# ---------- 1. Descriptive: BMI by savings category ----------
print("\n"+"="*100)
print("BMI BY SAVINGS-DIRECTION 1989 (Proxy A)")
d = df.groupby('sav_dir')[['bmi81','bmi89','bmi92']].agg(['mean','count']).round(2)
d.index = ['1 put in','2 took out','3 no change','4 no savings']
print(d.to_string())

# ---------- 2. Regression ----------
def run_ols(data, outcome, exp_cols, exp_label, conf=CORE):
    cols = conf + exp_cols
    sub = data[cols+[outcome]].dropna()
    X = sm.add_constant(sub[cols].astype(float))
    m = sm.OLS(sub[outcome], X).fit(cov_type='HC1')
    print(f"\nOUTCOME {outcome} | exposure '{exp_label}' | conf={len(conf)} vars | n={int(m.nobs)} | R2={m.rsquared:.3f}")
    for c in exp_cols:
        b,se,p = m.params[c], m.bse[c], m.pvalues[c]
        lo,hi = m.conf_int().loc[c]
        print(f"    {c:16s} b={b:+8.4f}  95%CI[{lo:+8.4f},{hi:+8.4f}]  p={p:.4f}  [std coef {b*sub[c].std()/sub[outcome].std():+.4f}]")
    return m

# ---------- 3. MAIN: Proxy A (savings 1989) -> BMI89 / BMI92 (both reported) ----------
print("\n"+"="*100)
print("MAIN ANALYSIS: Proxy A (savings direction 1989) -> BMI")
m1 = run_ols(df, 'bmi89', ['sav_tookout','sav_nochg','sav_nosav'], 'sav(89)')
m2 = run_ols(df, 'bmi92', ['sav_tookout','sav_nochg','sav_nosav'], 'sav(89)')

# ---------- 4. Baseline-controlled main model ----------
print("\n"+"="*100)
print("BASELINE-CONTROLLED (add BMI81): BMI89 ~ savings89 + BMI81 + confounders")
cols = CORE + ['sav_tookout','sav_nochg','sav_nosav','bmi81']
sub = df[cols+['bmi89']].dropna()
X = sm.add_constant(sub[cols].astype(float))
m = sm.OLS(sub['bmi89'], X).fit(cov_type='HC1')
print(f"  n={int(m.nobs)}  R2={m.rsquared:.3f}")
for c in ['sav_tookout','sav_nochg','sav_nosav']:
    b,lo,hi,p = m.params[c], m.conf_int().loc[c][0], m.conf_int().loc[c][1], m.pvalues[c]
    print(f"    {c:16s} b={b:+8.4f}  95%CI[{lo:+8.4f},{hi:+8.4f}]  p={p:.4f}")

# ---------- 5. ROBUSTNESS: Proxy B (wealth) -> BMI, aligned years ----------
print("\n"+"="*100)
print("ROBUSTNESS: Proxy B (bottom-wealth quarter = high time-pref proxy)")
run_ols(df, 'bmi89', ['lowNW90'], 'lowNW90')
run_ols(df, 'bmi92', ['lowNW96'], 'lowNW96')
run_ols(df, 'bmi89', ['lowWR90'], 'lowWR90')
run_ols(df, 'bmi92', ['lowWR96'], 'lowWR96')

# ---------- 6. Missingness: complete vs incomplete demographic comparison ----------
print("\n"+"="*100)
print("MISSINGNESS: complete vs incomplete (bmi89+sav_dir+core analytic sample)")
comp_idx = df[CORE+['bmi89','sav_dir']].dropna().index
inc_idx  = df.index[df['sav_dir'].notna()].difference(comp_idx)
comp = df.loc[comp_idx]; inc = df.loc[inc_idx]
vars_cmp = ['age79','female','black','hisp','educ79','famsize79','mom_educ','dad_educ','asvab','lninc79']
print(pd.DataFrame({'complete':comp[vars_cmp].mean().round(2),'incomplete':inc[vars_cmp].mean().round(2)}).to_string())
print(f"\n  n complete={len(comp)}, n incomplete(sav_dir present)={len(inc)}")

# ---------- 7. Diagnostics on main model ----------
print("\n"+"="*100)
print("DIAGNOSTICS (main model: bmi89 ~ savings + core)")
print(f"  residuals skew={sst.skew(m1.resid):.3f}  kurt={sst.kurtosis(m1.resid):.3f}  mean={m1.resid.mean():.3f}")
print(f"  robust SEs (HC1) used; R2={m1.rsquared:.3f}")
print("  VIF (savings & key confounders):")
from statsmodels.stats.outliers_influence import variance_inflation_factor
Xv = sm.add_constant(df[CORE+['sav_tookout','sav_nochg','sav_nosav']].dropna().astype(float))
for i,c in enumerate(Xv.columns[1:],1):
    print(f"    {c:12s} VIF={variance_inflation_factor(Xv.values,i):6.2f}")

# ---------- 8. Supplementary checks ----------
print("\n"+"="*100)
print("SUPPLEMENTARY A: UNADJUSTED reference (bmi89 ~ savings89 only)")
import statsmodels.formula.api as smf
m0 = smf.ols('bmi89 ~ C(sav_dir)', data=df).fit(cov_type='HC1')
print(m0.params.round(3).to_string())
print("  p-values:", (m0.pvalues.round(4)).to_dict())

print("\n"+"="*100)
print("SUPPLEMENTARY B: OBESITY (BMI89>=30) ~ savings89 + core (logistic, OR)")
sub = df[CORE+['sav_tookout','sav_nochg','sav_nosav','bmi89']].dropna().copy()
sub['obese'] = (sub['bmi89']>=30).astype(int)
Xl = sm.add_constant(sub[CORE+['sav_tookout','sav_nochg','sav_nosav']].astype(float))
ml = sm.Logit(sub['obese'], Xl).fit(disp=0)
for c in ['sav_tookout','sav_nochg','sav_nosav']:
    or_, lo, hi = np.exp(ml.params[c]), np.exp(ml.conf_int().loc[c][0]), np.exp(ml.conf_int().loc[c][1])
    print(f"  {c:16s} OR={or_:.3f} 95%CI[{lo:.3f},{hi:.3f}] p={ml.pvalues[c]:.4f}")
print(f"  baseline obesity prevalence (mean): {sub['obese'].mean():.3f}")

print("\n"+"="*100)
print("SUPPLEMENTARY C: primary outcome choice rationale check — n & effect, bmi89 vs bmi92")
print("  (bmi89 n=5414, bmi92 n=4503; both positive and significant for sav_tookout/sav_nosav;")
print("   bmi89 is same-survey-year as savings report -> primary; bmi92 = 3yr forward validation)")
