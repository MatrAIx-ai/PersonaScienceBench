"""Preliminary data inspection for DiscoveryBench episode: nls_bmi_raw."""
import pandas as pd, numpy as np

df = pd.read_csv('data/nls_raw.csv')
print("shape:", df.shape)

# 1) Missingness overview
miss = (df.isna().mean()*100).round(1)
print("\nTop missing columns (col: %missing):")
for c in miss.sort_values(ascending=False).head(12).items():
    print(f"  {c[0][:55]:55s} {c[1]}")

# 2) Height 1981 is feet+inch concatenation (507 => 5'07")
h = df['Height of respondent, 1981'].dropna()
dec = (h//100)*12 + (h % 100)
print("\nHeight81 feet-inch decode vs Height85(inches):")
both = pd.DataFrame({'h81': dec, 'h85': df['Height of respondent, 1985']}).dropna()
print("  |decoded81 - 85| <= 1 inch in", round((both.h81-both.h85).abs().le(1).mean(),3), "of pairs")

# 3) BMI computability (weights are in pounds despite 'kg' descriptions)
m = df[['Height of respondent, 1981','Weight of respondent, 1981']].dropna()
h_in = (m['Height of respondent, 1981']//100)*12 + (m['Height of respondent, 1981']%100)
bmi = 703*m['Weight of respondent, 1981']/h_in**2
print("BMI 1981: median %.1f, mean %.1f, 5-95%% [%.1f, %.1f]" % (bmi.median(), bmi.mean(), bmi.quantile(.05), bmi.quantile(.95)))

# 4) Exploratory Spearman: wealth/savings proxies vs BMI
m2 = df.copy()
m2['h_in81'] = (m2['Height of respondent, 1981']//100)*12 + (m2['Height of respondent, 1981']%100)
m2['bmi81'] = 703*m2['Weight of respondent, 1981']/m2['h_in81']**2
m2['bmi89'] = 703*m2['Weight of respondent, 1989']/df['Height of respondent, 1985']**2
m2['bmi92'] = 703*m2['Weight of respondent, 1992']/df['Height of respondent, 1985']**2
prox = ['Family net wealth, 1985','Family net wealth, 1990','Family net wealth, 1996 (key data point)',
        'Total net family income, previous calendar year, 1989']
print("\nSpearman rho (wealth proxy, BMI):")
for o in ['bmi81','bmi89','bmi92']:
    row = []
    for p in prox:
        sub = m2[[o,p]].dropna()
        row.append(f"{p[:30]}={sub[o].corr(sub[p],'spearman'):+.3f}(n={len(sub)})")
    print(f"  {o}: " + " | ".join(row))

# 5) Savings direction (1989) distribution
print("\nSavings direction 1989 (1=put in,2=took out,3=no change,4=no savings):")
print(df['Was more money put into or taken out of R/spouse savings since last interview, 1989']
      .value_counts(dropna=False).sort_index().to_dict())
