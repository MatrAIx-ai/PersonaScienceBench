"""Sparse/Noisy Compact-Star Sequence Reconstruction.

Reconstructs a physically self-consistent cold, non-rotating compact-star
(white-dwarf) sequence from sparse noisy observations and predicts the
holdout mass-radius values and normalized internal profiles requested in
data/query_targets.json.

Method
------
Fully degenerate cold-electron (Chandrasekhar) equation of state with one
physical parameter mu_e (mean electron molecular weight; nuclei give the
inertia). The Tolman-Oppenheimer-Volkoff (TOV) equations are integrated
outward for a ladder of central Fermi parameters x_c. Each star yields
(total mass, radius) AND the full normalized profile (radius_fraction,
density_fraction, enclosed_mass_fraction) from ONE sequence
(single-family consistency).

Surface: manifest threshold density_fraction = 1e-4, i.e.
x_surface = x_c*(1e-4)^(1/3), anchoring all profiles
(df(0)=1, ef(0)=0, df(1)=1e-4, ef(1)=1).

mu_e is fitted by weighted joint least squares over the 14 mass-radius
observations (per-point radius sigma + mass sigma propagated through the
local dR/dM slope) and all 44 available profile-fragment channels.

Only numpy/scipy/pandas are required. matplotlib is used for the plot if
available; otherwise a self-contained numpy+zlib PNG renderer is used.
"""
from __future__ import annotations
import json, math, os, struct, zlib, time
import numpy as np
import pandas as pd
from scipy.optimize import minimize_scalar

# ---------------------- physical constants (cgs) --------------------- #
HBAR   = 1.054571817e-27     # erg*s
C      = 2.99792458e10       # cm/s
ME     = 9.1093837015e-28    # g
MU_AMU = 1.66053906660e-24   # g
G      = 6.67430e-8          # cm^3 g^-1 s^-2
M_SUN  = 1.98892e33          # g
KM     = 1e5
SURF_FRAC = 1e-4             # manifest surface threshold (density fraction)

def eos_consts(mu_e):
    """Chandrasekhar cold degenerate-electron EOS constants.

    rho = rho0*x^3 (g/cm^3), P = P0*f(x) (dyn/cm^2),
    f(x) = x(2x^2-3)sqrt(1+x^2)+3 asinh(x).
    NR limit reproduces P = K rho^(5/3) (standard degenerate polytrope).
    """
    lb = HBAR / (ME * C)
    rho0 = (mu_e * MU_AMU) / (3 * np.pi**2 * lb**3)
    P0 = ME**4 * C**5 / (24 * np.pi**2 * HBAR**3)
    return rho0, P0

def P_of_x(x, P0):
    return P0 * (x*(2*x*x - 3)*np.sqrt(1 + x*x) + 3*np.arcsinh(x))

def dPdx(x, P0, h=5e-4):
    return (P_of_x(x*(1+h), P0) - P_of_x(x*(1-h), P0)) / (2*h*x)

# ------------------------- TOV integration ------------------------- #
def integrate_star(mu_e, xc, N=3000):
    """Integrate TOV for central Fermi parameter xc.

    Returns (M_sun, R_km, rf, df, ef): radius_fraction, density_fraction,
    enclosed_mass_fraction arrays. Fixed-step RK4 in y=log10(x).
    """
    rho0, P0 = eos_consts(mu_e)
    x_surf = xc * SURF_FRAC**(1/3)

    # central hydrostatic series expansion (regularity)
    dpc = dPdx(xc, P0)
    delta = 1e-4 * xc
    x0 = xc - delta
    rho_c = rho0 * xc**3
    r0 = math.sqrt(3*dpc*delta / (2*math.pi*G*rho_c**2))
    m0 = (4*math.pi/3) * rho_c * r0**3

    y0, y1 = math.log10(x0), math.log10(x_surf)
    ys = np.linspace(y0, y1, N)
    h = (y1 - y0) / (N - 1)
    L = math.log(10.0)

    def deriv(r, m, x):
        P = P_of_x(x, P0)
        rho = rho0 * x**3
        dp = dPdx(x, P0)
        denom = G * (m + 4*math.pi*r**3*P/C**2) * (rho + P/C**2)
        fac = r**2 * (1 - 2*G*m/(r*C**2)) / denom
        return -dp*fac*x*L, -4*math.pi*r**2*rho*dp*fac*x*L

    r, m = float(r0), float(m0)
    rs = np.empty(N); ms = np.empty(N); xs = np.empty(N)
    for i in range(N-1):
        y = ys[i]; x = 10.0**y
        rs[i] = r; ms[i] = m; xs[i] = x
        k1r, k1m = deriv(r, m, x)
        xm = 10.0**(y + 0.5*h)
        k2r, k2m = deriv(r + 0.5*h*k1r, m + 0.5*h*k1m, xm)
        k3r, k3m = deriv(r + 0.5*h*k2r, m + 0.5*h*k2m, xm)
        k4r, k4m = deriv(r + h*k3r, m + h*k3m, 10.0**(y + h))
        r += h/6*(k1r + 2*k2r + 2*k3r + k4r)
        m += h/6*(k1m + 2*k2m + 2*k3m + k4m)
    xs[N-1] = x_surf; rs[N-1] = r; ms[N-1] = m

    Rcm = rs[-1]; Mg = ms[-1]
    rf = rs / Rcm
    df = (xs / xc)**3
    ef = ms / Mg
    if rf[0] > 0.0:
        rf = np.concatenate([[0.0], rf]); df = np.concatenate([[1.0], df]); ef = np.concatenate([[0.0], ef])
    rf[-1] = 1.0; df[-1] = SURF_FRAC; ef[-1] = 1.0
    return m/M_SUN, r/KM, rf, df, ef

def build_sequence(mu_e, xcs, N=2000):
    stars = []
    for xc in xcs:
        M, R, rf, df, ef = integrate_star(mu_e, xc, N)
        stars.append((xc, M, R, rf, df, ef))
    Ms = np.array([s[1] for s in stars]); Rs = np.array([s[2] for s in stars])
    return stars, Ms, Rs

def mass_limit(mu_e, xcs, N=2000):
    """Sequence peak Mmax where dM/dR -> 0 (stable branch maximum)."""
    stars, Ms, Rs = build_sequence(mu_e, xcs, N)
    i = int(np.argmax(Ms))
    return Ms[i], Rs[i], stars, Ms, Rs

# ----------------------------- data I/O ---------------------------- #
DATA_DIR = "data"

def load_inputs():
    obs = pd.read_csv(os.path.join(DATA_DIR, "mr_observations.csv"))
    frag = pd.read_csv(os.path.join(DATA_DIR, "profile_fragments.csv"))
    with open(os.path.join(DATA_DIR, "query_targets.json")) as f:
        targets = json.load(f)
    return obs, frag, targets

def chi2_mr(Ms, Rs, mo, Ro, sm, sR):
    Rp = np.interp(mo, Ms, Rs)
    slope = np.interp(mo, Ms, np.gradient(Rs, Ms))
    sig_eff = np.sqrt(sR**2 + (slope*sm)**2)
    return np.sum(((Ro - Rp)/sig_eff)**2), (Ro - Rp), sig_eff, Rp

def profile_at_mass(stars, Ms, Mq, grid):
    idx = np.searchsorted(Ms, Mq)
    i0 = max(0, idx-1); i1 = min(len(Ms)-1, idx)
    if i0 == i1:
        lo = hi = stars[i0]; w = 0.0
    else:
        lo = stars[i0]; hi = stars[i1]; w = (Mq - Ms[i0])/(Ms[i1]-Ms[i0])
    df = (1-w)*np.interp(grid, lo[3], lo[4]) + w*np.interp(grid, hi[3], hi[4])
    ef = (1-w)*np.interp(grid, lo[3], lo[5]) + w*np.interp(grid, hi[3], hi[5])
    return grid, df, ef

def chi2_profs(stars, Ms, frag):
    chi = 0.0
    for mq in frag["target_mass_solar"].unique():
        rf, df, ef = profile_at_mass(stars, Ms, mq, np.linspace(0, 1, 401))
        sub = frag[frag["target_mass_solar"] == mq]
        for _, row in sub.iterrows():
            rq = row["radius_fraction"]
            dfm = np.interp(rq, rf, df); efm = np.interp(rq, rf, ef)
            if not np.isnan(row["density_fraction_obs"]):
                chi += ((row["density_fraction_obs"] - dfm)/row["sigma_density_fraction"])**2
            if not np.isnan(row["enclosed_mass_fraction_obs"]):
                chi += ((row["enclosed_mass_fraction_obs"] - efm)/row["sigma_enclosed_mass_fraction"])**2
    return chi

def fit_mu_e(obs, frag, xcs, N=1600):
    def f(mu_e):
        stars, Ms, Rs = build_sequence(mu_e, xcs, N)
        c1, *_ = chi2_mr(Ms, Rs, obs["mass_solar_obs"].values, obs["radius_km_obs"].values,
                         obs["sigma_mass_solar"].values, obs["sigma_radius_km"].values)
        c2 = chi2_profs(stars, Ms, frag)
        return c1 + c2
    res = minimize_scalar(f, bounds=(1.95, 2.15), method="bounded",
                          options={"xatol": 1e-4, "maxiter": 30})
    return res.x

