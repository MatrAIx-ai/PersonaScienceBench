            22,
            21
          ]
        }
      },
      "justification": "no Louvain/Leiden library available; Louvain directly maximizes modularity on the KNN graph"
    },
    "pseudotime": {
      "method": "kNN(k=15) + MST-connected trajectory graph; Dijkstra shortest path from root",
      "root_convention": "root = cell with minimum PC1 (documented orientation assumption; sign is arbitrary)",
      "normalization": "min-max to [0,1]",
