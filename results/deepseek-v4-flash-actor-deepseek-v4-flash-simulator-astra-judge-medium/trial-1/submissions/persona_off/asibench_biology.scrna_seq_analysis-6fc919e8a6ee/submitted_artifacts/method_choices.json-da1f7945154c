  "steps": {
    "normalization": {
      "method": "median library-size normalization + log1p",
      "justification": "standard size-factor normalization for droplet counts; log stabilizes variance"
    },
    "hvg": {
      "method": "top-100 genes by variance of log counts",
      "justification": "focus on informative genes; standard variance-based HVG"
    },
    "pca": {
      "method": "truncated SVD on z-scored HVG matrix, 15 PCs",
      "justification": "denoise/decorrelate before graph"
    },
    "clustering": {
      "method": "KNN(k=10) graph + hand-implemented Louvain modularity (gamma=1.0, seed=42), refined to exactly n_clusters=4",
      "detail": "Louvain found 2 natural communities; the largest community was split into 3 sub-clusters by k-means (kmeans++, marker-balance-scored restarts) to honor the metadata n_clusters.",
