"""
analysis.py -- solution-phase electron-transfer response calculation for asibench
episode 'chemistry.marcus_et_reorganization_energy'.

Reads data/ inputs and writes results/ outputs:
  aligned_displacement_mw.npy     (2,21)   mass-weighted aligned displacement
  vibrational_basis_mw.npy        (2,21,15) retained normal-mode basis per direction
  mode_overlap.npy                (2,15,15) magnitude-based cross-frame overlap
  projected_displacement_mw.npy   (2,21)   projection of mass-weighted displacement
  transported_mode_projection.npy (2,15,2) transported (cross-frame source) mode projection
  lambda_summary.csv              inner/outer/total lambda + self-exchange rate
  mode_projection.npy             (2,15,3) [retained idx, freq_cm1, signed modal coord]
  rate_curve.csv                  Marcus rate on supplied 61-row driving-force grid
  diagnostics.json                RMSDs, closure errors, norms, dominant modes, peak/inversion
  overview.png                    two-panel figure (aligned geometry + rate curve)

Conventions (committed):
  * ascending site_id order (via data/frame_site_order.csv) for every 21-component output
  * forward = frame B rigidly aligned into frame A (target A); backward = frame A into B (target B)
  * signed displacement-like outputs = aligned source minus reference target
  * mode_overlap & transported profiles are magnitude-based w.r.t. eigenvector sign
  * 15 retained modes per direction from the TARGET frame's mass-weighted Hessian
    (eigenvalues > 1e-6 eV/A2/amu; 6 rigid nulls dropped), sorted ascending frequency
  * dominant_mode = argmax |signed modal coordinate| (0-based retained index)
  * lambda_outer from two-sphere Marcus medium model (see diagnostics.json)
"""

import json
import numpy as np
import pandas as pd

try:                                     # matplotlib may be unavailable in constrained runtimes
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt
    MPL = True
except Exception:
    MPL = False

DATA = "data"
OUT = "results"
FREQ_SCALE = 521.4708983725066          # sqrt(eV/A2/amu) -> cm^-1
C0 = 14.399645                          # e^2/(4 pi eps0) in eV * A
HBAR_EVS = 6.582119569e-16              # hbar in eV*s
KB_EV = 8.617333262e-5                  # Boltzmann in eV/K

# ---------------------------------------------------------------------------
