def _png(path, img):
    import struct, zlib
    H, W, _ = img.shape
    def chunk(tag, data):
        c = struct.pack(">I", len(data)) + tag + data
        return c + struct.pack(">I", zlib.crc32(tag + data) & 0xffffffff)
    raw = b"".join(b"\x00" + img[y].tobytes() for y in range(H))
    out = b"\x89PNG\r\n\x1a\n"
    out += chunk(b"IHDR", struct.pack(">IIBBBBB", W, H, 8, 2, 0, 0, 0))
    out += chunk(b"IDAT", zlib.compress(raw, 6))
    out += chunk(b"IEND", b"")
    with open(path, "wb") as fh:
        fh.write(out)

def _disc(img, cx, cy, r, color, fill=True):
    H, W = img.shape[0], img.shape[1]
    for dy in range(-r, r + 1):
        for dx in range(-r, r + 1):
            if dx * dx + dy * dy <= r * r:
                if fill or (r - 0.0) ** 2 <= dx * dx + dy * dy <= (r + 1.5) ** 2:
                    x, y = int(cx + dx), int(cy + dy)
                    if 0 <= x < W and 0 <= y < H:
                        img[y, x] = color

def _line(img, p0, p1, color, thick=1):
    H, W = img.shape[0], img.shape[1]
    x0, y0 = int(round(p0[0])), int(round(p0[1]))
    x1, y1 = int(round(p1[0])), int(round(p1[1]))
    dx, dy = abs(x1 - x0), abs(y1 - y0)
    sx = 1 if x0 < x1 else -1
    sy = 1 if y0 < y1 else -1
    err = dx - dy
    while True:
        for ox in range(-(thick // 2), thick - thick // 2):
            for oy in range(-(thick // 2), thick - thick // 2):
                x, y = x0 + ox, y0 + oy
                if 0 <= x < W and 0 <= y < H:
                    img[y, x] = color
        if x0 == x1 and y0 == y1:
            break
        e2 = 2 * err
        if e2 > -dy:
            err -= dy; x0 += sx
        if e2 < dx:
            err += dx; y0 += sy

def _dashed(img, p0, p1, color, dash=8, gap=6):
    import math
    v = np.array([p1[0] - p0[0], p1[1] - p0[1]])
    L = math.hypot(*v)
    if L == 0:
        return
    v = v / L
    t = 0.0
    while t < L:
        t2 = min(t + dash, L)
        _line(img, (p0[0] + v[0] * t, p0[1] + v[1] * t),
              (p0[0] + v[0] * t2, p0[1] + v[1] * t2), color)
        t += dash + gap

def _text(img, x, y, s, color, scale=1):
    """Draw uppercase 5x7 bitmap font; returns end x position."""
    for ch in s:
        pat = _F5X7.get(ch.upper(), _F5X7[" "])
        for r, row in enumerate(pat):
            for c, bit in enumerate(row):
                if bit == "1":
                    for dy in range(scale):
                        for dx in range(scale):
                            px, py = x + c * scale + dx, y + r * scale + dy
                            if 0 <= px < img.shape[1] and 0 <= py < img.shape[0]:
                                img[py, px] = color
        x += 6 * scale - 1
    return x

def _mapv(v, vmin, vmax, pmin, pmax):
    return pmin + (v - vmin) / (vmax - vmin) * (pmax - pmin)

def _fallback_overview(A, B_al, ax, log10k, neg_lambda, rmsd_f,
                       peak_axis, peak_log10k, peak_gid, l_inner, l_outer, l_total):
    W, H = 1000, 460
    img = np.full((H, W, 3), 245, dtype=np.uint8)
    dark = np.array([20, 20, 20], np.uint8)
    blue = np.array([30, 90, 200], np.uint8)
    orange = np.array([230, 140, 20], np.uint8)
    red = np.array([200, 30, 30], np.uint8)
    gray = np.array([90, 90, 90], np.uint8)

    # panel boxes
    boxes = [(60, 60, 480, 360), (540, 60, 480, 360)]   # x0,y0,w,h (image y down)
    for x0, y0, w, h in boxes:
        _line(img, (x0, y0), (x0 + w, y0), dark)
        _line(img, (x0, y0), (x0, y0 + h), dark)
        _line(img, (x0 + w, y0), (x0 + w, y0 + h), dark)
        _line(img, (x0, y0 + h), (x0 + w, y0 + h), dark)

    # ---- panel 1 : aligned geometry ----
    x0, y0, w, h = boxes[0]
    pts = np.vstack([A[:, :2], B_al[:, :2]])
    xmin, xmax = pts[:, 0].min(), pts[:, 0].max()
    ymin, ymax = pts[:, 1].min(), pts[:, 1].max()
    xpad = 0.15 * (xmax - xmin) or 0.1; ypad = 0.15 * (ymax - ymin) or 0.1
    xmin -= xpad; xmax += xpad; ymin -= ypad; ymax += ypad
    def px(xv): return _mapv(xv, xmin, xmax, x0 + 40, x0 + w - 30)
    def py(yv): return _mapv(yv, ymin, ymax, y0 + h - 30, y0 + 40)
    for i in range(7):
        c = red if i == 2 else blue
        _disc(img, px(A[i, 0]), py(A[i, 1]), 7, blue if i != 2 else red)
        _disc(img, px(B_al[i, 0]), py(B_al[i, 1]), 8, orange, fill=False)
    _text(img, x0 + 10, y0 - 22, "PANEL1 ALIGNED FRAMES  RMSD=%0.3f A" % rmsd_f, dark, 2)
    # legend
    _disc(img, x0 + 12, y0 + h - 14, 5, blue)
    _text(img, x0 + 24, y0 + h - 22, "A (REF)", dark, 1)
    _disc(img, x0 + 110, y0 + h - 14, 6, orange, fill=False)
    _text(img, x0 + 124, y0 + h - 22, "B ALIGNED IN A", dark, 1)

    # ---- panel 2 : Marcus rate curve ----
    x0, y0, w, h = boxes[1]
    o = np.argsort(ax)
    xax, yax = ax[o], log10k[o]
    _text(img, x0 + 10, y0 - 22,
          "PANEL2 MARCUS RATE  L_IN=%0.3f L_OUT=%0.3f L_TOT=%0.3f" % (l_inner, l_outer, l_total),
          dark, 2)
    amax, amin = max(xax.max(), 0.05), xax.min()
    lmin = np.floor(yax.min()); lmax = np.ceil(yax.max())
    lg0 = lmin if lmin < yax.min() else lmin - 1
    def qx(av): return _mapv(av, amin, amax, x0 + 40, x0 + w - 30)
    def qy(lv): return _mapv(lv, lg0, lmax + 1, y0 + h - 30, y0 + 40)
    for i in range(len(xax) - 1):
        _line(img, (qx(xax[i]), qy(yax[i])), (qx(xax[i + 1]), qy(yax[i + 1])), blue, 2)
    ybar = qy(neg_lambda)
    _dashed(img, (qx(neg_lambda), y0 + 25), (qx(neg_lambda), y0 + h - 15), gray)
    _text(img, qx(neg_lambda) + 6, qy(neg_lambda) - 14, "-L=%0.3f" % neg_lambda, gray, 1)
    _disc(img, qx(peak_axis), qy(peak_log10k), 6, red)
    _text(img, x0 + 12, y0 + h - 12, "PEAK GID %d  AX %0.3f" % (peak_gid, peak_axis), dark, 1)
    # axis labels / ticks
    _text(img, x0 + w - 120, y0 + h - 12, "%0.2f" % amax, gray, 1)
    _text(img, x0 + 8, y0 + h - 12, "%0.2f" % amin, gray, 1)
    _line(img, (x0 + 40, y0 + h - 15), (x0 + w - 30, y0 + h - 15), dark)
    _text(img, x0 + w - 90, y0 + h + 6, "AXIS EV", dark, 2)
    _text(img, x0 + 2, y0 + 8, "LOG10K", dark, 1)

    _png(f"{OUT}/overview.png", img)
def main():
    import os
    os.makedirs(OUT, exist_ok=True)   # self-contained: create results dir
    site_table = pd.read_csv("data/site_table.csv").sort_values("site_id")
    masses = site_table["mass_amu"].values            # length 7, site order
    m21 = np.repeat(masses, 3)                        # per-coordinate masses (amu)
    sqm = np.sqrt(m21)
    Mw = np.diag(1.0 / sqm)                           # m^{-1/2}

    A = load_reorder_coords("frame_a")                # (7,3) site order
    B = load_reorder_coords("frame_b")
    HA = load_reorder_hessian("frame_a")              # (21,21) site order
    HB = load_reorder_hessian("frame_b")

    # ---- rigid alignment -------------------------------------------------
    Rf, tf, rmsd_f = kabsch(B, A)                     # forward: source B -> target A
    Rb, tb, rmsd_b = kabsch(A, B)                     # backward: source A -> target B
    B_al = B @ Rf.T + tf                              # frame B placed in frame A
    A_al = A @ Rb.T + tb                              # frame A placed in frame B

    # mass-weighted aligned displacement (signed, aligned source - reference target)
    Df21 = (B_al - A).reshape(-1)                     # forward displacement (cartesian, A)
    Db21 = (A_al - B).reshape(-1)                     # backward displacement (cartesian, B)
    qf = sqm * Df21
    qb = sqm * Db21
    aligned_displacement_mw = np.stack([qf, qb])      # (2,21)

    # ---- target-frame mass-weighted Hessians and retained modes ----------
    HA_mw = Mw @ HA @ Mw
    HB_mw = Mw @ HB @ Mw
    wa, MA, fA = retained_modes(HA_mw)                # forward basis (target frame A)
    wb, MB, fB = retained_modes(HB_mw)                # backward basis (target frame B)
    basis = np.stack([MA, MB])                        # (2,21,15)

    # ---- modal coordinates (signed) --------------------------------------
    qcoef_f = MA.T @ qf                               # (15,)
    qcoef_b = MB.T @ qb
    # ---- transported source modes: source eigvecs rotated into target frame
    MB_rot = block_rot(Rf) @ MB                       # B modes in A frame
    MA_rot = block_rot(Rb) @ MA                       # A modes in B frame
    qtrans_f = MB_rot.T @ qf                          # signed transported coord (forward)
    qtrans_b = MA_rot.T @ qb

    # ---- magnitude-based cross-frame overlap -----------------------------
    Ov_f = np.abs(MA.T @ MB_rot)                      # (15,15) forward
    Ov_b = np.abs(MB.T @ MA_rot)                      # (15,15) backward
    mode_overlap = np.stack([Ov_f, Ov_b])             # (2,15,15)

    # ---- projected displacement (mass-weighted, signed) ------------------
    proj_f = MA @ qcoef_f                             # (21,)
    proj_b = MB @ qcoef_b
    projected_displacement_mw = np.stack([proj_f, proj_b])

    # ---- lambda (four-point and nuclear-matrix-element on modes) ---------
    l4_f = 0.5 * Df21 @ HA @ Df21
    l4_b = 0.5 * Db21 @ HB @ Db21
    l_nm_f = 0.5 * np.sum(wa * qcoef_f ** 2)
    l_nm_b = 0.5 * np.sum(wb * qcoef_b ** 2)
    l_inner = 0.5 * (l4_f + l4_b)

    # ---- outer-sphere lambda (two-sphere Marcus medium model) ------------
    med = json.load(open("data/medium_response.json"))
    eps_f, eps_s = med["eps_fast"], med["eps_slow"]
    r0, r1, span = med["shell_0_A"], med["shell_1_A"], med["span_A"]
    geom_factor = 1.0 / (2 * r0) + 1.0 / (2 * r1) - 1.0 / span
    dielectric = 1.0 / eps_f - 1.0 / eps_s
    l_outer = C0 * geom_factor * dielectric           # 0.7340... eV
    l_total = l_inner + l_outer

    # ---- Marcus nonadiabatic rate ----------------------------------------
    kbT = KB_EV * med["temp_K"]
    V = med["coupling_eV"]
    pref = (2 * np.pi / HBAR_EVS) * V ** 2 / np.sqrt(4 * np.pi * l_total * kbT)
    k_self = pref * np.exp(-l_total / (4 * kbT))

    grid = pd.read_csv("data/driving_force_grid.csv")
    ax = grid["axis_eV"].values                       # (61,) in supplied row order
    k_et = pref * np.exp(-(ax + l_total) ** 2 / (4 * l_total * kbT))
    log10k = np.log10(k_et)

    rate_curve = pd.DataFrame({
        "grid_id": grid["grid_id"].values,
        "axis_eV": ax,
        "k_et_s_inv": k_et,
        "log10_k_et_s_inv": log10k,
    })

    # peak & inverted region
    pk = int(np.argmax(k_et))
    rate_peak_grid_id = int(grid["grid_id"].iloc[pk])
    rate_peak_axis = float(ax[pk])
    rate_peak_s = float(k_et[pk])
    inv = ax < -l_total
    first_inv = int(np.argmax(inv)) if inv.any() else -1
    inv_detected = bool(inv.any())

    # ---- diagnostics ------------------------------------------------------
    rigid_f = float(np.linalg.norm(qf))
    rigid_b = float(np.linalg.norm(qb))
    proj_norm_f = float(np.linalg.norm(proj_f))
    proj_norm_b = float(np.linalg.norm(proj_b))
    dom_f = int(np.argmax(np.abs(qcoef_f)))
    dom_b = int(np.argmax(np.abs(qcoef_b)))

    diagnostics = {
        "alignment_rmsd_forward_A": float(rmsd_f),
        "alignment_rmsd_backward_A": float(rmsd_b),
        "closure_error_forward_eV": float(l4_f - l_nm_f),
        "closure_error_backward_eV": float(l4_b - l_nm_b),
        "effective_inner_consistency_eV": float(0.5 * (l4_f + l4_b) - 0.5 * (l_nm_f + l_nm_b)),
        "rigid_norm_forward": rigid_f,
        "rigid_norm_backward": rigid_b,
        "projected_norm_forward": proj_norm_f,
        "projected_norm_backward": proj_norm_b,
        "dominant_mode_forward": dom_f,
        "dominant_mode_backward": dom_b,
        "rate_peak_grid_id": rate_peak_grid_id,
        "rate_peak_axis_eV": rate_peak_axis,
        "rate_peak_s_inv": rate_peak_s,
        "inverted_region_detected": inv_detected,
        "first_inverted_grid_id": int(grid["grid_id"].iloc[first_inv]) if inv_detected else None,
        "first_inverted_axis_eV": float(ax[first_inv]) if inv_detected else None,
    }

    diagnostics["outer_lambda_formula"] = {
        "expression": "C0 * (1/(2*r0) + 1/(2*r1) - 1/span) * (1/eps_fast - 1/eps_slow)",
        "C0_eV_A": C0,
        "r0_A": r0, "r1_A": r1, "span_A": span,
        "eps_fast_optical": eps_f, "eps_slow_static": eps_s,
        "lambda_outer_eV": float(l_outer),
    }
    diagnostics["rate_model"] = {
        "prefactor_s_inv": float(pref),
        "V_eV": V,
        "T_K": med["temp_K"],
        "kBT_eV": float(kbT),
        "lambda_total_eV": float(l_total),
        "formula": "k = pref * exp(-(dG+lambda_total)^2/(4*lambda_total*kBT)); pref=(2*pi/hbar)V^2/sqrt(4*pi*lambda_total*kBT)",
    }
    # ---- write structural/modal outputs ----------------------------------
    np.save(f"{OUT}/aligned_displacement_mw.npy", aligned_displacement_mw)
    np.save(f"{OUT}/vibrational_basis_mw.npy", basis)
    np.save(f"{OUT}/mode_overlap.npy", mode_overlap)
    np.save(f"{OUT}/projected_displacement_mw.npy", projected_displacement_mw)

    # mode_projection (2,15,3): [retained idx, freq_cm1, signed modal coord]
    mp_f = np.stack([np.arange(15), fA, qcoef_f], axis=1)
    mp_b = np.stack([np.arange(15), fB, qcoef_b], axis=1)
    mode_projection = np.stack([mp_f, mp_b])
    np.save(f"{OUT}/mode_projection.npy", mode_projection)

    # transported_mode_projection (2,15,2): [source freq_cm1, signed transported coord]
    tp_f = np.stack([fB, qtrans_f], axis=1)
    tp_b = np.stack([fA, qtrans_b], axis=1)
    transported_mode_projection = np.stack([tp_f, tp_b])
    np.save(f"{OUT}/transported_mode_projection.npy", transported_mode_projection)

    lambda_summary = pd.DataFrame([{
        "lambda_4pt_forward_eV": l4_f,
        "lambda_4pt_backward_eV": l4_b,
        "lambda_nm_forward_eV": l_nm_f,
        "lambda_nm_backward_eV": l_nm_b,
        "lambda_inner_effective_eV": l_inner,
        "lambda_outer_eV": l_outer,
        "lambda_total_eV": l_total,
        "k_self_exchange_s_inv": k_self,
    }])
    lambda_summary.to_csv(f"{OUT}/lambda_summary.csv", index=False)
    rate_curve.to_csv(f"{OUT}/rate_curve.csv", index=False)
    with open(f"{OUT}/diagnostics.json", "w") as fh:
        json.dump(diagnostics, fh, indent=2)

    # ---- overview.png ------------------------------------------------------
    if MPL:
        _matplotlib_overview(A, B_al, ax, log10k, rmsd_f, l_inner, l_outer, l_total,
                             rate_peak_axis, rate_peak_s, rate_peak_grid_id, neg_lambda=-l_total)
    else:
        _fallback_overview(A, B_al, ax, log10k, -l_total, rmsd_f,
                           rate_peak_axis, np.log10(rate_peak_s), rate_peak_grid_id,
                           l_inner, l_outer, l_total)

    # ---- console summary ---------------------------------------------------
    print("=== lambda_summary ===")
    print(lambda_summary.to_string(index=False))
    print("\n=== diagnostics ===")
    print(json.dumps(diagnostics, indent=2)[:1900])
    print("\nshapes:")
    for f in ["aligned_displacement_mw", "vibrational_basis_mw", "mode_overlap",
              "projected_displacement_mw", "transported_mode_projection", "mode_projection"]:
        print(" ", f, np.load(f"{OUT}/{f}.npy").shape)


def _matplotlib_overview(A, B_al, ax, log10k, rmsd_f, l_inner, l_outer, l_total,
                         peak_axis, peak_s, peak_gid, neg_lambda):
    fig, axs = plt.subplots(1, 2, figsize=(13, 5.2))
    colors = {2: "#b22222"}
    for i in range(len(A)):
        c = colors.get(i, "#4682b4")
        axs[0].scatter(*A[i, :2], s=90, color=c, edgecolor="k", zorder=3,
                       label=("reference A" if i == 2 else None))
        axs[0].scatter(*B_al[i, :2], s=90, marker="s", facecolors="none",
                       edgecolor="darkorange", linewidths=1.8, zorder=3,
                       label=("aligned B in A" if i == 2 else None))
    axs[0].set_title("Aligned frames (forward: B into A)\nRMSD = {:.3f} A".format(rmsd_f))
    axs[0].set_xlabel("x (A)"); axs[0].set_ylabel("y (A)")
    axs[0].legend(loc="best", fontsize=8)

    o = np.argsort(ax)
    axs[1].plot(ax[o], log10k[o], "-", color="#1f77b4", lw=2)
    axs[1].axvline(neg_lambda, color="gray", ls="--", lw=1.2,
                   label=r"$-\lambda_{total}=%.3f$ eV" % neg_lambda)
    axs[1].scatter(peak_axis, np.log10(peak_s), color="crimson", zorder=4,
                   label="grid peak ({}, {:.3f} eV)".format(peak_gid, peak_axis))
    axs[1].set_title("Marcus rate (inverted region at left)\n"
                     r"$\lambda_{in}=%.3f$, $\lambda_{out}=%.3f$, $\lambda_{tot}=%.3f$ eV" %
                     (l_inner, l_outer, l_total))
    axs[1].set_xlabel(r"driving force $\Delta G$ (eV)")
    axs[1].set_ylabel(r"$\log_{10}$ k (s$^{-1}$)")
    axs[1].legend(loc="best", fontsize=8)
    axs[1].set_ylim(np.log10(peak_s) - 6.0, np.log10(peak_s) + 0.8)
    fig.tight_layout()
    fig.savefig(f"{OUT}/overview.png", dpi=150)
    plt.close(fig)


