# ---------------------------------------------------------------------------
def load_reorder_coords(frame):
    """Load a frame's (7,3) coords and permute rows to ascending site_id."""
    fso = pd.read_csv(f"{DATA}/frame_site_order.csv")
    sub = fso[fso.frame_id == frame].sort_values("row_index")
    order = sub.site_id.values                      # site_id at each raw row
    row_of = np.empty(len(order), dtype=int)
    for i, s in enumerate(order):
        row_of[s] = i
    arr = np.load(f"{DATA}/{frame}_coords.npy")
    return arr[row_of]


def load_reorder_hessian(frame):
    """Load a frame's (21,21) Hessian and permute per-site 3-blocks to ascending site_id."""
    fso = pd.read_csv(f"{DATA}/frame_site_order.csv")
    sub = fso[fso.frame_id == frame].sort_values("row_index")
    order = sub.site_id.values
    row_of = np.empty(len(order), dtype=int)
    for i, s in enumerate(order):
        row_of[s] = i
    perm21 = np.concatenate([3 * row_of[i] + np.arange(3) for i in range(len(order))])
    arr = np.load(f"{DATA}/{frame}_hessian.npy")
    return arr[np.ix_(perm21, perm21)]


def kabsch(src, ref):
    """Rigid (rotation + translation, no scaling) alignment of src onto ref.
    Returns proper rotation R, translation t and RMSD in angstrom."""
    cs, cr = src.mean(0), ref.mean(0)
    X, Y = src - cs, ref - cr
    Uu, _, Vt = np.linalg.svd(X.T @ Y)
    d = np.sign(np.linalg.det(Vt.T @ Uu.T))
    R = Vt.T @ np.diag([1, 1, d]) @ Uu.T
    t = cr - R @ cs
    rmsd = np.sqrt(np.mean(np.sum((src @ R.T + t - ref) ** 2, axis=1)))
    return R, t, rmsd


def block_rot(R):
    """Block-diagonal 21x21 rotation replicating R for each of the 7 sites (3 coords each)."""
    return np.kron(np.eye(7), R)


def retained_modes(H_mw, tol=1e-6):
    """Mass-weighted Hessian diagonalization; retain eigenvalues>tol (6 rigid nulls dropped),
    sorted ascending frequency. Returns eigenvalues, eigenvectors(21x15), freq_cm1."""
    w, v = np.linalg.eigh(H_mw)
    sel = np.where(w > tol)[0]
    w = w[sel]
    v = v[:, sel]
    freq = FREQ_SCALE * np.sqrt(np.clip(w, 0, None))
    return w, v, freq
