#!/usr/bin/env python3
"""
Deterministic confidence-interval engine forensics (asibench bci_forensics).

Audits 9 anonymous CI engines across 6 public cases from data/ and writes every
artifact under results/.  Fully deterministic: no RNG, no replacement resampling
panels, no reliance on row order.  Depends only on numpy (the overview PNG is
rendered with a small built-in rasterizer so no image library is required).
"""
import json, os, csv, struct, zlib
import numpy as np

np.set_printoptions(suppress=True)
ROOT = os.path.dirname(os.path.abspath(__file__))
DATA = os.path.join(ROOT, "data")
RES = os.path.join(ROOT, "results")
os.makedirs(RES, exist_ok=True)

# ----------------------------------------------------------------------------
# 0. Load inputs
# ----------------------------------------------------------------------------
sm = json.load(open(os.path.join(DATA, "study_manifest.json")))
pm = json.load(open(os.path.join(DATA, "probe_manifest.json")))
NOMINAL = float(sm["confidence_level"])
CASES = [c["case_id"] for c in sm["cases"]]
case_def = {c["case_id"]: c for c in sm["cases"]}
ENGINES = list(sm["engine_ids"])
LABELS = list(sm["failure_label_vocabulary"])
PROBE_FAMS = list(pm["probe_families"])
N_CAL = int(sm["cases"][0]["n_calibration_replications"])
N_REP = len(CASES); N_ENG = len(ENGINES)

obs_df = list(csv.DictReader(open(os.path.join(DATA, "observed_samples.csv"))))
obs_vals = {}
for r in obs_df:
    obs_vals.setdefault(r["case_id"], []).append(float(r["value"]))
obs_vals = {c: np.asarray(obs_vals[c]) for c in CASES}

z = np.load(os.path.join(DATA, "engine_interval_panels.npz"))
assert list(z["engine_ids"]) == ENGINES
assert list(z["case_ids"]) == CASES
obs_stat = np.asarray(z["observed_stat"])
obs_low = z["observed_low"];   obs_high = z["observed_high"]
cal_low = z["calibration_low"]; cal_high = z["calibration_high"]
p02_low = z["probe_panel_02_low"]; p02_high = z["probe_panel_02_high"]
p03_low = z["probe_panel_03_low"]; p03_high = z["probe_panel_03_high"]
base_low = np.asarray(z["baseline_low"]); base_high = np.asarray(z["baseline_high"])

cal_samp = np.load(os.path.join(DATA, "calibration_samples.npz"))

# ----------------------------------------------------------------------------
# 1. Statistics (public definitions)
# ----------------------------------------------------------------------------
def calc_stat(x, d):
    s = d["statistic_name"]
    if s == "mean":
        return x.mean(axis=1)
    if s == "median":
        return np.median(x, axis=1)
    if s == "coefficient_of_variation":
        return x.std(axis=1, ddof=1) / x.mean(axis=1)
    if s == "upper_tail_rate":
        th = d["statistic_parameters"]["threshold"]
        return (x >= th).mean(axis=1)
    raise ValueError(s)

for i, c in enumerate(CASES):
    st = calc_stat(obs_vals[c].reshape(1, -1), case_def[c])[0]
    assert abs(st - obs_stat[i]) < 1e-9, (c, st, obs_stat[i])

cal = {c: cal_samp[c] for c in CASES}

# ----------------------------------------------------------------------------
# 2. Calibration coverage targets
# ----------------------------------------------------------------------------
# primary: statistic of pooled calibration data (population estimate per case)
pooled_target = {c: float(calc_stat(cal[c], case_def[c]).mean()) for c in CASES}
# robustness: leave-one-out pooled statistic per replication
loo_target = {}
for c in CASES:
    loo = np.empty(N_CAL)
    for r in range(N_CAL):
        mask = np.arange(N_CAL) != r
        loo[r] = calc_stat(cal[c][mask], case_def[c]).mean()
    loo_target[c] = loo

emp = np.empty((N_ENG, N_REP)); emp_loo = np.empty((N_ENG, N_REP))
missL = np.empty((N_ENG, N_REP)); missH = np.empty((N_ENG, N_REP))
mean_w = np.empty((N_ENG, N_REP))
for e in range(N_ENG):
    for i, c in enumerate(CASES):
        lo, hi = cal_low[e, i], cal_high[e, i]
        emp[e, i] = ((pooled_target[c] >= lo) & (pooled_target[c] <= hi)).mean()
        emp_loo[e, i] = ((loo_target[c] >= lo) & (loo_target[c] <= hi)).mean()
        missL[e, i] = (pooled_target[c] < lo).mean()
        missH[e, i] = (pooled_target[c] > hi).mean()
        mean_w[e, i] = (hi - lo).mean()

# ----------------------------------------------------------------------------
# 3. Neutral probe diagnostics (severity, higher = worse), per (case, engine)
# ----------------------------------------------------------------------------
w_obs = obs_high - obs_low
w_p02 = p02_high - p02_low
w_p03 = p03_high - p03_low
w_cal = cal_high - cal_low
med_w = np.median(w_obs, axis=0)
center_off = (obs_low + obs_high) / 2 - obs_stat[None, :]
off_norm = center_off / np.maximum(w_obs, 1e-12)

p_sev = np.zeros((5, N_ENG, N_REP))
p_sev[0] = np.abs(off_norm)                                            # probe_00 placement
p_sev[1] = np.abs(w_obs - med_w[None, :]) / np.maximum(med_w[None, :], 1e-12)  # probe_01 width efficiency
p_sev[2] = np.abs(w_p02 - w_obs) / np.maximum(w_obs, 1e-12)            # probe_02 responsiveness
p_sev[3] = np.nan_to_num(w_p03.std(axis=2) / np.maximum(w_p03.mean(axis=2), 1e-12))  # probe_03 stability
p_sev[4] = np.nan_to_num(w_cal.std(axis=2) / np.maximum(w_cal.mean(axis=2), 1e-12))  # probe_04 cal width CV
probe_metric = p_sev.mean(axis=2)                                       # (5,E)

# ----------------------------------------------------------------------------
# 4. Engine audit aggregates
# ----------------------------------------------------------------------------
cov_gap = emp - NOMINAL
cov_abs = np.abs(cov_gap).mean(axis=1)
tail_imb = np.abs(missL - missH).mean(axis=1)
bw = (base_high - base_low)[None, :]
width_ratio = (w_obs / bw).mean(axis=1)
case_disp = np.abs(cov_gap).std(axis=1)
wrdev = np.abs(w_obs / bw - 1.0).mean(axis=1)

components = np.vstack([cov_abs, tail_imb, case_disp] + [probe_metric[k] for k in range(5)])
def minmax01(v):
    lo, hi = v.min(), v.max()
    return (v - lo) / max(hi - lo, 1e-12)
comp_n = np.array([minmax01(components[k]) for k in range(components.shape[0])])
WGT = np.array([0.30, 0.10, 0.10] + [0.10] * 5)
severity = WGT @ comp_n
engine_score = 100.0 * (1.0 - severity)
rank_by_score = sorted(range(N_ENG), key=lambda e: -engine_score[e])
selected_e = rank_by_score[0]
selected_engine = ENGINES[selected_e]

# ----------------------------------------------------------------------------
# 5. Failure-label evidence scores (one per engine x label, finite own scale)
# ----------------------------------------------------------------------------
def mm01(v):
    return minmax01(np.asarray(v, dtype=float))

meancov = emp.mean(axis=1)
undercov = np.clip((NOMINAL - meancov) / NOMINAL, 0, 1)
skew_cases = [1, 2, 5]                                  # right-skewed regimes
negmirror = np.array([np.clip(-off_norm[e, skew_cases], 0, None).mean() for e in range(N_ENG)])
rate_dev = np.abs(off_norm[:, [3, 4]]).mean(axis=1)      # discrete/bounded mishandling
scale_dev = np.clip((bw[:, [2, 4]] - w_obs[:, [2, 4]]) / bw[:, [2, 4]], 0, None)
scale_dev = scale_dev.mean(axis=1)   # interval narrower than baseline on scale-sensitive cases
p02_dev = np.abs(probe_metric[2] - np.median(probe_metric[2]))

rel_ev = (1.0 - severity)
base_ev = 0.7 * np.clip(1.0 - wrdev / 0.1, 0, 1) + 0.3 * mm01(undercov)
refl_ev = mm01(negmirror)
disc_ev = mm01(rate_dev)
shape_ev = 0.5 * mm01(p02_dev) + 0.5 * mm01(probe_metric[3])
scale_ev = mm01(scale_dev)
noise_ev = 0.6 * mm01(probe_metric[4]) + 0.4 * mm01(case_disp)

label_scores = np.vstack([rel_ev, base_ev, refl_ev, disc_ev, shape_ev, scale_ev, noise_ev])
pred_idx = np.argmax(label_scores, axis=0)
pred_label = [LABELS[i] for i in pred_idx]

# ----------------------------------------------------------------------------
# 6. Write outputs
# ----------------------------------------------------------------------------
# 6a. engine_audit.csv
with open(os.path.join(RES, "engine_audit.csv"), "w", newline="") as f:
    wcsv = csv.writer(f)
    wcsv.writerow(["engine_id", "coverage_gap", "tail_imbalance", "width_ratio",
                   "case_dispersion"] + [f"probe_metric_{k:02d}" for k in range(5)] + ["engine_score"])
    for e in range(N_ENG):
        wcsv.writerow([ENGINES[e], round(float(cov_gap.mean(axis=1)[e]), 6),
                       round(float(tail_imb[e]), 6), round(float(width_ratio[e]), 6),
                       round(float(case_disp[e]), 6)] +
                      [round(float(probe_metric[k, e]), 6) for k in range(5)] +
                      [round(float(engine_score[e]), 6)])

# 6b. coverage_audit.csv
with open(os.path.join(RES, "coverage_audit.csv"), "w", newline="") as f:
    wcsv = csv.writer(f)
    wcsv.writerow(["case_id", "regime", "engine_id", "nominal_coverage", "empirical_coverage",
                   "mean_width", "miss_low_rate", "miss_high_rate", "n_replications", "coverage_score"])
    for i, c in enumerate(CASES):
        for e in range(N_ENG):
            cov_s = float(np.clip(1.0 - abs(emp[e, i] - NOMINAL) / 0.25, 0, 1))
            wcsv.writerow([c, case_def[c]["regime"], ENGINES[e], round(NOMINAL, 4),
                           round(float(emp[e, i]), 4), round(float(mean_w[e, i]), 6),
                           round(float(missL[e, i]), 4), round(float(missH[e, i]), 4),
                           N_CAL, round(cov_s, 6)])

# 6c. probe_audit.csv
with open(os.path.join(RES, "probe_audit.csv"), "w", newline="") as f:
    wcsv = csv.writer(f)
    wcsv.writerow(["case_id", "probe_family", "engine_id", "diagnostic_value", "diagnostic_score"])
    for k, fam in enumerate(PROBE_FAMS):
        vals = p_sev[k]; lo, hi = vals.min(), vals.max()
        for i, c in enumerate(CASES):
            for e in range(N_ENG):
                dscore = (vals[e, i] - lo) / max(hi - lo, 1e-12)
                wcsv.writerow([c, fam, ENGINES[e], round(float(vals[e, i]), 6), round(float(dscore), 6)])

# 6d. case_probe_profile.csv
sig = np.zeros((5, N_ENG, N_REP))
for k in range(5):
    v = p_sev[k]; lo, hi = v.min(), v.max()
    sig[k] = (v - lo) / max(hi - lo, 1e-12)
profile = 100.0 * (1.0 - sig.mean(axis=0))
with open(os.path.join(RES, "case_probe_profile.csv"), "w", newline="") as f:
    wcsv = csv.writer(f)
    wcsv.writerow(["case_id", "engine_id"] + [f"probe_signal_{k:02d}" for k in range(5)] + ["profile_score"])
    for i, c in enumerate(CASES):
        for e in range(N_ENG):
            wcsv.writerow([c, ENGINES[e]] + [round(float(sig[k, e, i]), 6) for k in range(5)] +
                          [round(float(profile[e, i]), 6)])

# 6e. failure_evidence.csv + failure_modes.json + selected_engine.json
with open(os.path.join(RES, "failure_evidence.csv"), "w", newline="") as f:
    wcsv = csv.writer(f)
    wcsv.writerow(["engine_id", "failure_label", "evidence_score", "label_rank", "is_predicted_label"])
    for e in range(N_ENG):
        order = sorted(range(7), key=lambda l: -label_scores[l, e])
        rank_of = {l: r + 1 for r, l in enumerate(order)}
        for l, lab in enumerate(LABELS):
            wcsv.writerow([ENGINES[e], lab, round(float(label_scores[l, e]), 6),
                           rank_of[l], 1 if l == pred_idx[e] else 0])

json.dump({"selected_engine_id": selected_engine,
           "failure_modes": {ENGINES[e]: pred_label[e] for e in range(N_ENG)}},
          open(os.path.join(RES, "failure_modes.json"), "w"), indent=2)
json.dump({"selected_engine_id": selected_engine,
           "selected_failure_mode": pred_label[selected_e],
           "selected_engine_score": round(float(engine_score[selected_e]), 6)},
          open(os.path.join(RES, "selected_engine.json"), "w"), indent=2)

# 6f. interval_summary.csv
with open(os.path.join(RES, "interval_summary.csv"), "w", newline="") as f:
    wcsv = csv.writer(f)
    wcsv.writerow(["case_id", "statistic_name", "observed_stat", "selected_engine_id",
                   "selected_low", "selected_high", "baseline_low", "baseline_high",
                   "selected_width", "baseline_width_ratio"])
    for i, c in enumerate(CASES):
        sw = obs_high[selected_e, i] - obs_low[selected_e, i]
        bw_ = base_high[i] - base_low[i]
        wcsv.writerow([c, case_def[c]["statistic_name"], round(float(obs_stat[i]), 6),
                       selected_engine, round(float(obs_low[selected_e, i]), 6),
                       round(float(obs_high[selected_e, i]), 6), round(float(base_low[i]), 6),
                       round(float(base_high[i]), 6), round(float(sw), 6), round(float(sw / bw_), 6)])

# 6g. family_ablation.csv
def ranking_with_excl(excl_set):
    keep = np.array([True, True, True] + [k not in excl_set for k in range(5)])
    W2 = WGT[keep]; comp2 = comp_n[keep]
    sev2 = (W2 @ comp2) / W2.sum()
    return 100.0 * (1.0 - sev2)

with open(os.path.join(RES, "family_ablation.csv"), "w", newline="") as f:
    wcsv = csv.writer(f)
    wcsv.writerow(["excluded_probe_family", "top_engine_id", "selected_engine_rank",
                   "runner_up_engine_id", "score_margin"])
    rows = [("none", set())] + [(fam, {k}) for k, fam in enumerate(PROBE_FAMS)]
    for name, ex in rows:
        sc = ranking_with_excl(ex)
        order = sorted(range(N_ENG), key=lambda e: -sc[e])
        margin = max(sc[order[0]] - sc[order[1]], 0.0)
        wcsv.writerow([name, ENGINES[order[0]], order.index(selected_e) + 1,
                       ENGINES[order[1]], round(float(margin), 6)])

# 6h. reliability_report.json
case_warnings = {}
for i, c in enumerate(CASES):
    wl = []
    covs = emp[:, i]
    if case_def[c]["regime"] == "discrete_tie":
        wl.append("discrete/tie regime: point-mass ties make interval positioning sensitive; use "
                  "calibrated evidence rather than observed-only.")
    if case_def[c]["regime"] == "ratio_statistic":
        wl.append("ratio statistic: engine_06 shows anomalous width ratio (0.87x baseline); "
                  "scale-response evidence should be read carefully.")
    if abs(float(covs.mean()) - NOMINAL) > 0.06:
        wl.append(f"all-engine mean empirical coverage {covs.mean():.3f} deviates >0.06 from nominal.")
    wl.append(f"finite-sample caveat: {N_CAL} calibration replications -> coverage SE ~ "
              f"{np.sqrt(NOMINAL * (1 - NOMINAL) / N_CAL):.3f}.")
    case_warnings[c] = wl

json.dump({
    "selected_engine_id": selected_engine,
    "aggregate_coverage_gap": round(float(cov_gap.mean(axis=1).mean()), 6),
    "aggregate_tail_imbalance": round(float(tail_imb.mean()), 6),
    "aggregate_probe_score": round(float(probe_metric.mean()), 6),
    "engine_ranking": [ENGINES[e] for e in rank_by_score],
    "case_warnings": case_warnings,
}, open(os.path.join(RES, "reliability_report.json"), "w"), indent=2)

# ----------------------------------------------------------------------------
# 6i. engine_overview.png -- pure-numpy rasterizer + PNG encoder (no matplotlib)
# ----------------------------------------------------------------------------
