GLY = _glyphs()

CW, CH = 5, 7   # glyph cell size in px at scale 1

class Canvas:
    def __init__(self, W, H, bg=(255, 255, 255)):
        self.W, self.H = W, H
        self.img = np.zeros((H, W, 3), dtype=np.uint8)
        self.img[:, :] = bg
    def set(self, x, y, c):
        if 0 <= x < self.W and 0 <= y < self.H:
            self.img[y, x] = c
    def fill(self, x0, y0, x1, y1, c):
        x0, x1 = max(0, int(x0)), min(self.W - 1, int(x1))
        y0, y1 = max(0, int(y0)), min(self.H - 1, int(y1))
        self.img[y0:y1 + 1, x0:x1 + 1] = c
    def text(self, x, y, s, c=(0, 0, 0), scale=2):
        """top-left anchor; scale px per font pixel"""
        px, py = int(x), int(y)
        for ch in s.upper():
            rows = GLY.get(ch, GLY[" "])
            for r, row in enumerate(rows):
                for cc, bit in enumerate(row):
                    if bit == "1":
                        self.fill(px + cc * scale, py + r * scale,
                                  px + (cc + 1) * scale - 1, py + (r + 1) * scale - 1, c)
            px += (CW + 1) * scale
    def hline(self, x0, x1, y, c, t=1):
        self.fill(x0, y - t, x1, y + t, c)
    def vline(self, x, y0, y1, c, t=1):
        self.fill(x - t, y0, x + t, y1, c)
    def rect(self, x0, y0, x1, y1, c, t=1):
        self.hline(x0, x1, y0, c, t); self.hline(x0, x1, y1, c, t)
        self.vline(x0, y0, y1, c, t); self.vline(x1, y0, y1, c, t)
    def line(self, x0, y0, x1, y1, c, t=1):
        n = int(max(abs(x1 - x0), abs(y1 - y0)) * 2) + 1
        for k in range(n + 1):
            tt = k / n
            self.fill(round(x0 + (x1 - x0) * tt) - t, round(y0 + (y1 - y0) * tt) - t,
                      round(x0 + (x1 - x0) * tt) + t, round(y0 + (y1 - y0) * tt) + t, c)
    def marker(self, x, y, c, r=4):
        self.fill(x - r, y - r, x + r, y + r, c)
    def save(self, path):
        h, w = self.img.shape[:2]
        raw = b"".join(b"\x00" + self.img[y].tobytes() for y in range(h))
        def chunk(tag, data):
            return struct.pack(">I", len(data)) + tag + data + struct.pack(">I", zlib.crc32(tag + data) & 0xffffffff)
        png = b"\x89PNG\r\n\x1a\n"
        png += chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0))
        png += chunk(b"IDAT", zlib.compress(raw, 6))
        png += chunk(b"IEND", b"")
        with open(path, "wb") as fh:
            fh.write(png)

def hue_color(h):
    # h in [0,1) -> rgb tuple
    s, v = 0.85, 0.9
    i = int(h * 6); f = h * 6 - i
    p, q, t = v * (1 - s), v * (1 - s * f), v * (1 - s * (1 - f))
    r, gg, b = [(v, t, p), (q, v, p), (p, v, t), (p, q, v), (t, p, v), (v, p, q)][i % 6]
    return (int(r * 255), int(gg * 255), int(b * 255))

def heat(t):
    stops = [(68, 1, 84), (59, 82, 139), (33, 144, 141), (93, 201, 99), (253, 231, 37)]
    t = float(np.clip(t, 0, 1)) * (len(stops) - 1)
    i = min(int(t), len(stops) - 2); f = t - i
    a, b = stops[i], stops[i + 1]
    return tuple(int(a[k] + (b[k] - a[k]) * f) for k in range(3))

