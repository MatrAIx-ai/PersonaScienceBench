    return x0, x1, yt, yb

def dm_x(x, xmin, xmax, A):
    x0, x1, _, _ = A
    return x0 + (x - xmin) / (xmax - xmin) * (x1 - x0)

def dm_y(v, vmin, vmax, A):
    x0, x1, yt, yb = A
    return yt + (vmax - v) / (vmax - vmin) * (yb - yt)

