"""
Leaf Physiological Response Reconstruction
------------------------------------------
Coupled Collatz-C4 photosynthesis + Ball-Berry stomatal conductance
(CLM/Noah-MP temperature conventions), solved as a fixed point over internal
CO2 (Ci) for each forcing row, for sunlit and shaded leaves separately.

Scientific conventions (from the task brief):
  * pathway = "C4" (leaf_params.json) -> Collatz C4 limitations:
        Wc = vcmax_eff,  Wj = alpha_q*APAR,  We = 4000*vcmax_eff*Ci/patm,
        A  = min(Wc, Wj, We) - Rd,   APAR = 4.6*PAR
  * CLM/Noah-MP Q10 temperature responses:
        Vcmax(T) = Vcmax25 * 2.4^((Tc-25)/10) /
                   (1+exp((-2.2e5+710*(Tc+273.16))/(R*(Tc+273.16))))
        Kc = 30*2.1^((Tc-25)/10);  Ko = 30000*1.2^((Tc-25)/10)
        Gamma* = 0.5*(Kc/Ko)*O2*0.21;  Rd = 0.015*Vcmax_eff
  * n_factor and btran applied to photosynthetic capacity (Vcmax) only; the
    Ball-Berry intercept b0 is NOT scaled by btran.
  * leaf temp = air temp;  h_s = min(max(1 - vpd/esat(T), 0.25), 1)
    esat(T) = 610.78*exp(17.269*Tc/(Tc+237.3))   (CLM-style Tetens)
  * gas-diffusion chain (A in mol m-2 s-1 = umol/1e6, cf = patm/(R*T) mol m-3):
        cs = ca - 1.37*rb*A_mol/cf*patm
        gs = m*A_mol*h_s/cs*patm + b0
        rs = cf/gs
        Ci = cs - 1.65*rs*A_mol/cf*patm
  * Night rows (PAR <= 1e-6): A = -Rd (respiratory), gs = b0 (intercept only),
    Ci from the same diffusion relation (respiring leaf = CO2 source, Ci>ca).

Outputs: results/leaf_fluxes.csv, results/case_convergence.csv, results/diurnal.png

The figure uses matplotlib when available; otherwise a pure-stdlib PNG renderer
(zlib/struct, embedded 5x7 bitmap font) is used so diurnal.png is always made.
"""
import json, os, struct, zlib
import numpy as np
import pandas as pd

try:
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt
    HAVE_MPL = True
except Exception:
    HAVE_MPL = False

R = 8.314                     # J mol-1 K-1
KC25, KO25 = 30.0, 30000.0    # Pa
Q10_KC, Q10_KO, Q10_VC = 2.1, 1.2, 2.4
NIGHT_PAR = 1e-6              # W m-2 threshold for the night branch
CI_TOL = 1e-6                 # Pa
MAX_ITER = 300


def load_params(path):
    with open(path) as f:
        return json.load(f)


def vcmax_t(vcmax25, Tc):
    """CLM/Noah-MP Q10 response for Vcmax incl. high-temperature inhibition."""
    Tk = Tc + 273.16
    q = Q10_VC ** ((Tc - 25.0) / 10.0)
    denom = 1.0 + np.exp((-2.2e5 + 710.0 * Tk) / (R * Tk))
    return vcmax25 * q / denom


def kc_t(Tc):
    return KC25 * Q10_KC ** ((Tc - 25.0) / 10.0)


def ko_t(Tc):
    return KO25 * Q10_KO ** ((Tc - 25.0) / 10.0)


def gamma_star_t(Tc, o2_pa):
    return 0.5 * (kc_t(Tc) / ko_t(Tc)) * o2_pa * 0.21


def esat_t(Tc):
    """CLM-style Tetens saturation vapour pressure (Pa)."""
    return 610.78 * np.exp(17.269 * Tc / (Tc + 237.3))


def c4_A_umol(ci, vcmax_eff, alpha_q, apar, patm, Rd):
    """Collatz C4 limitation set -> net assimilation, umol m-2 s-1."""
    Wc = vcmax_eff
    Wj = alpha_q * apar
    We = 4000.0 * vcmax_eff * ci / patm
    return min(Wc, Wj, We) - Rd


def night_state(env, Rd, cf, m, b0, ca, rb, patm):
    """Night branch: respiratory A, intercept-only gs, Ci from diffusion."""
    A_umol = -Rd
    A_mol = A_umol * 1e-6
    cs = ca - 1.37 * rb * A_mol / cf * patm
    gs = b0
    rs = cf / gs
    ci = cs - 1.65 * rs * A_mol / cf * patm
    return dict(A_umol=A_umol, cs=cs, gs=gs, rs=rs, ci=ci, n_iter=0, method="night")


def diffusion_chain(ci, ca, rb, patm, cf, m, b0, hs, vcmax_eff, alpha_q, apar, Rd):
    """One pass of the gas-diffusion chain starting from a Ci guess, C4."""
    A_umol = c4_A_umol(ci, vcmax_eff, alpha_q, apar, patm, Rd)
    A_mol = A_umol * 1e-6
    cs = ca - 1.37 * rb * A_mol / cf * patm
    gs = m * A_mol * hs / cs * patm + b0
    rs = cf / gs
    ci_new = cs - 1.65 * rs * A_mol / cf * patm
    return ci_new, cs, A_umol, gs, rs


def solve_row(env, seed_ci, apar):
    """Solve the coupled A/gs/Ci fixed point for one (row, leaf) forcing dict."""
    if apar <= NIGHT_PAR:
        return night_state(env, env["Rd"], env["cf"], env["m"], env["b0"],
                           env["ca"], env["rb"], env["patm"])
    ca, rb, patm, cf = env["ca"], env["rb"], env["patm"], env["cf"]
    m, b0, hs = env["m"], env["b0"], env["hs"]
    veff, aq, Rd = env["vcmax_eff"], env["alpha_q"], env["Rd"]

    def F(ci):
        return diffusion_chain(ci, ca, rb, patm, cf, m, b0, hs, veff, aq, apar, Rd)[0]

    # ---- damped fixed-point iteration over Ci ----
    ci = float(seed_ci)
    lam = 0.5
    for k in range(1, MAX_ITER + 1):
        ci_new = F(ci)
        step = ci_new - ci
        if abs(step) < CI_TOL:
            ci = ci_new
            n_iter = k
            break
        ci = float(np.clip(ci + lam * step, 0.0, 2.0 * ca))
        if k > 80 and k % 40 == 0:
            lam = max(0.05, lam * 0.5)
    else:
        # ---- bracketed fallback: bisection on g(ci) = ci - F(ci) ----
        def g(cc):
            return cc - F(cc)
        lo, hi = 0.0, ca
        glo = g(lo)
        if glo * g(hi) > 0.0:
            found = False
            for hi_ in np.linspace(ca, 2.0 * ca, 21)[1:]:
                ghi = g(hi_)
                if glo * ghi <= 0.0:
                    hi, found = hi_, True
                    break
            if not found:
                raise RuntimeError("no bracket found for ci at apar=%g" % apar)
        for k in range(1, 301):
            mid = 0.5 * (lo + hi)
            if abs(g(mid)) < CI_TOL or (hi - lo) < CI_TOL:
                break
            if glo * g(mid) <= 0.0:
                hi = mid
            else:
                lo, glo = mid, g(mid)
        n_iter = k

    ci_new, cs, A_umol, gs, rs = diffusion_chain(ci, ca, rb, patm, cf, m, b0, hs,
                                                 veff, aq, apar, Rd)
    return dict(ci=ci_new, cs=cs, A_umol=A_umol, gs=gs, rs=rs,
                n_iter=n_iter, method="fixed_point")


def build_env(row, params):
    """Environment/state quantities for one forcing row (leaf-agnostic T/P)."""
    patm = float(row["p_atm_Pa"])
    T = float(row["t_air_K"])
    Tc = T - 273.16
    cf = patm / (R * T)
    ca = float(row["co2_pa"])
    rb = float(row["rb_sm"])
    b0 = float(params["bb_intercept"])
    m = float(params["bb_slope"])
    alpha_q = float(params["alpha_q"])
    nf = float(params["n_factor"])
    btran = float(row["btran"])
    vcmaxT = vcmax_t(float(params["vcmax25"]), Tc)
    vcmax_eff = vcmaxT * nf * btran
    Rd = 0.015 * vcmax_eff
    hs = float(np.clip(1.0 - float(row["vpd_Pa"]) / esat_t(Tc), 0.25, 1.0))
    return dict(patm=patm, T=T, Tc=Tc, cf=cf, ca=ca, rb=rb, b0=b0, m=m,
                alpha_q=alpha_q, vcmax_eff=vcmax_eff, Rd=Rd, hs=hs)


