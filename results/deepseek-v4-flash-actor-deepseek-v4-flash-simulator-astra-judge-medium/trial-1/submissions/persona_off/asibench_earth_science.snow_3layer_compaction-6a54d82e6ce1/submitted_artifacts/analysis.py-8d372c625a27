def _fig_canvas(W, H, bg=(255, 255, 255)):
    c = np.zeros((H, W, 3), dtype=np.uint8)
    c[:, :] = bg
    return c

def _fig_px(c, x, y, col=(0, 0, 0)):
    H, W = c.shape[:2]
    if 0 <= x < W and 0 <= y < H:
        c[y, x] = col

def _fig_line(c, x0, y0, x1, y1, col=(0, 0, 0)):
    x0, y0, x1, y1 = int(x0), int(y0), int(x1), int(y1)
    dx, dy = abs(x1 - x0), abs(y1 - y0)
    sx = 1 if x0 < x1 else -1
    sy = 1 if y0 < y1 else -1
    err = dx - dy
    while True:
        _fig_px(c, x0, y0, col)
        if x0 == x1 and y0 == y1:
            break
        e2 = 2 * err
        if e2 > -dy:
            err -= dy; x0 += sx
        if e2 < dx:
            err += dx; y0 += sy

def _fig_text(c, x, y, s, col=(0, 0, 0), scale=1):
    cx = int(x)
    for ch in s:
        bmp = _FONT5x7.get(ch.upper(), _FONT5x7[' '])
        for r in range(7):
            row = bmp[r]
            for cc in range(5):
                if row & (0x10 >> cc):
                    for sx in range(scale):
                        for sy in range(scale):
                            _fig_px(c, cx + cc * scale + sx, int(y) + r * scale + sy, col)
        cx += 6 * scale

def _fig_series(c, box, days, y, vmin, vmax, col):
    x0, y0, xspan, yspan = box
    n = len(days)
    for i in range(n - 1):
        px0 = x0 + (days[i] - days[0]) / max(days[-1] - days[0], 1e-9) * xspan
        px1 = x0 + (days[i + 1] - days[0]) / max(days[-1] - days[0], 1e-9) * xspan
        py0 = y0 + (1 - (y[i] - vmin) / max(vmax - vmin, 1e-9)) * yspan
        py1 = y0 + (1 - (y[i + 1] - vmin) / max(vmax - vmin, 1e-9)) * yspan
        _fig_line(c, px0, py0, px1, py1, col)
def _figure_stdlib(figs, n_days, save):
    """Multi-panel diagnostic PNG using only the standard library."""
    W, H = 1120, 1480
    c = _fig_canvas(W, H)
    d = figs
    days = d["days"]
    x0, x1 = 90, W - 40
    panels = 6
    top = 64
    gap = 30
    plot_h = (H - top - gap * (panels + 1)) // panels
    yb = [top + gap * (p + 1) + plot_h * p for p in range(panels)]

    _fig_text(c, x0, 14, "Snowpack dynamics - fixed 3-layer process model", (0, 0, 0), 2)
    titles = ["SWE (mm)", "Snow depth (m)", "Layer density (kg m-3)",
              "Layer temperature (deg C)", "Daily melt/refreeze/runoff (mm)",
              "Mass balance (cumulative mm)"]
    for p in range(panels):
        _fig_text(c, x0, yb[p] - 22, titles[p], (0, 0, 0), 1)

    for p in range(panels):
        _fig_line(c, x0, yb[p], x0, yb[p] + plot_h, (30, 30, 30))
        _fig_line(c, x1, yb[p], x1, yb[p] + plot_h, (30, 30, 30))
        _fig_line(c, x0, yb[p] + plot_h, x1, yb[p] + plot_h, (30, 30, 30))

    box0 = (x0 + 4, yb[0] + 4, x1 - x0 - 8, plot_h - 8)

    # 1 SWE
    vmin, vmax = float(d["swe"].min()), float(d["swe"].max())
    vmin = max(0.0, vmin * 0.95); vmax = vmax * 1.05
    _fig_series(c, box0, days, d["swe"], vmin, vmax, (20, 90, 220))
    _fig_text(c, x1 - 70, yb[0] + 2, f"{vmax:.0f}", (90, 90, 90))
    _fig_text(c, x1 - 70, yb[0] + plot_h - 12, f"{vmin:.0f}", (90, 90, 90))

    # 2 depth
    vmax = float(d["depth"].max()) * 1.05
    _fig_series(c, box0, days, d["depth"], 0.0, vmax, (30, 140, 60))
    _fig_text(c, x1 - 70, yb[1] + 2, f"{vmax:.1f}", (90, 90, 90))

    # 3 density (3 layers)
    rmin = float(d["density"].min()) * 0.9; rmax = float(d["density"].max()) * 1.05
    cols = [(220, 60, 40), (40, 140, 220), (140, 60, 200)]
    for L in range(3):
        _fig_series(c, box0, days, d["density"][:, L], rmin, rmax, cols[L])
    _fig_text(c, x1 - 170, yb[2] + 2, "L1", (220, 60, 40))
    _fig_text(c, x1 - 140, yb[2] + 2, "L2", (40, 140, 220))
    _fig_text(c, x1 - 110, yb[2] + 2, "L3", (140, 60, 200))

    # 4 temps (deg C)
    tmin, tmax = float(d["temp"].min()) - 1, float(d["temp"].max()) + 1
    _fig_line(c, x0 + 4, yb[3] + 4 + (1 - (0 - tmin) / (tmax - tmin)) * (plot_h - 8),
              x1 - 4, yb[3] + 4 + (1 - (0 - tmin) / (tmax - tmin)) * (plot_h - 8), (0, 0, 0))
    for L in range(3):
        _fig_series(c, box0, days, d["temp"][:, L], tmin, tmax, cols[L])

    # 5 daily melt/refreeze/runoff (thin bars)
    vb = max(float(d["melt"].max()), float(d["refreeze"].max()),
             float(d["runoff"].max()), 1e-9) * 1.1
    for i in range(n_days):
        xx = x0 + 4 + i * (x1 - x0 - 8) / max(n_days - 1, 1)
        for val, off, col in [(-4, d["melt"][i], (220, 40, 40)),
                              (0, d["refreeze"][i], (160, 60, 200)),
                              (4, d["runoff"][i], (240, 150, 20))]:
            hh = (plot_h - 8) * val / vb
            _fig_line(c, xx + off, yb[4] + 4, xx + off, yb[4] + 4 - hh, col)
    _fig_text(c, x0 + 6, yb[4] + plot_h - 12, "R melt  P refreeze  O runoff", (120, 120, 120))

    # 6 cumulative melt & runoff vs total input
    cm = np.cumsum(d["melt"]); cr = np.cumsum(d["runoff"])
    v6 = float(d["mass_added"]) * 1.15
    _fig_series(c, box0, days, cm, 0.0, v6, (220, 40, 40))
    _fig_series(c, box0, days, cr, 0.0, v6, (240, 150, 20))
    _fig_line(c, x0 + 4, yb[5] + 4 + (1 - d["mass_added"] / v6) * (plot_h - 8),
              x1 - 4, yb[5] + 4 + (1 - d["mass_added"] / v6) * (plot_h - 8), (0, 0, 0))
    _fig_text(c, x0 + 6, yb[5] + plot_h - 12,
              f"in {d['mass_added']:.1f} mm init {d['init_swe']:.1f} final {d['final_swe']:.1f}",
              (120, 120, 120))
    _fig_text(c, x0 + 6, yb[5] + plot_h - 24, f"residual {d['residual']:+.3f} mm",
              (180, 30, 30))

    for p in range(panels):
        _fig_text(c, x0 + 2, yb[p] + plot_h + 3, "0", (120, 120, 120))
        _fig_text(c, x1 - 12, yb[p] + plot_h + 3, str(n_days), (120, 120, 120))
        _fig_text(c, (x0 + x1) // 2 - 10, yb[p] + plot_h + 3, "day", (120, 120, 120))

    # ---- write PNG (pure stdlib) ----
    Hh, Ww = c.shape[:2]
    raw = bytearray()
    for y in range(Hh):
        raw.append(0)  # filter type 0
        for x in range(Ww):
            raw += struct.pack(">BBB", int(c[y, x, 0]), int(c[y, x, 1]), int(c[y, x, 2]))
    def chunk(tag, data):
        out = struct.pack(">I", len(data)) + tag + data
        out += struct.pack(">I", zlib.crc32(tag + data) & 0xFFFFFFFF)
        return out
    png = b"\x89PNG\r\n\x1a\n"
    png += chunk(b"IHDR", struct.pack(">IIBBBBB", Ww, Hh, 8, 2, 0, 0, 0))
    png += chunk(b"IDAT", zlib.compress(bytes(raw), 6))
    png += chunk(b"IEND", b"")
    with open(save, "wb") as f:
        f.write(png)


