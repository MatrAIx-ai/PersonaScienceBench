"""
B3: Hidden Binary-Grid Time Evolution (episode asibench:materials.ising_domain_growth).

Self-contained simulation + diagnostics.

Model (inferred): nearest-neighbour ferromagnetic Ising model on a periodic LxL
square lattice, quenched below the 2D Ising critical temperature
(T_c = 2.269185) from a fully disordered (T=inf) initial state, evolving with
single-spin-flip Glauber kinetics at temperature T = `control` (beta=1/control,
J = 1).

Time: 1 step = 1 Monte-Carlo sweep = one flip attempt per site. Each sweep is
two vectorized checkerboard half-sweeps (each updates one parity class using the
untouched opposite-class neighbours), exactly equivalent to sequential Glauber,
preserving the Gibbs stationary state. Update rule: dE = 2*s_i*(s_E+s_W+s_N+s_S)
(periodic); flip prob p = 1/(1+exp(beta*dE)); flip iff u<p, u~U[0,1). All
randomness from np.random.default_rng(dynamics_seed).

Observables (semantics locked):
  seriesA [2,n_measurements]: row0 = measurement_times, row1 = energy/spin e(t)
  seriesB [2,n_measurements]: row0 = measurement_times, row1 = characteristic
        length L(t) via structure-factor first moment sum_{k!=0}S/sum_{k!=0}|k|S
  stackC  [n_snapshots,max_r]: radial spin-spin correlation C(r), r=0..max_r-1
        (exact torus circular average, C(0)=1)
  stackD  [n_snapshots,L]    : column-averaged spin profile p_x(x)
  stackE  [n_snapshots,2,L]  : [p_x(x), p_y(y)]
  metadataA: dynamical-scaling (collapse) check of stackC
  metadataB: power-law fit L(t)=amplitude*t^exponent in auto-selected window
  figure.png: 5-panel diagnostic (matplotlib Agg; numpy fallback if absent)

Only numpy, scipy, matplotlib used (stdlib only for last-resort PNG writer).
"""

import json
import os
import struct
import zlib

import numpy as np

BASE_DIR = os.path.dirname(os.path.abspath(__file__))
DATA_DIR = os.path.join(BASE_DIR, "data")

# ----------------------------------------------------------------------------
# 0. Inputs
# ----------------------------------------------------------------------------
with open(os.path.join(DATA_DIR, "parameters.json"), "r") as f:
    PAR = json.load(f)

GRID = int(PAR["grid_size"])            # L = 100
CONTROL = float(PAR["control"])         # temperature T (assumption)
SEED = int(PAR["dynamics_seed"])
N_STEPS = int(PAR["n_steps"])           # 12305 sweeps
N_SNAPSHOTS = int(PAR["n_snapshots"])   # 6
SNAP_TIMES = np.asarray(PAR["snapshot_times"], dtype=np.float64)
N_MEAS = int(PAR["n_measurements"])     # 170
MEAS_TIMES = np.asarray(PAR["measurement_times"], dtype=np.float64)
MAX_R = int(PAR["max_r"])               # 50

BETA = 1.0 / CONTROL

INIT = np.load(os.path.join(DATA_DIR, "initial_state.npy")).astype(np.int8)
assert INIT.shape == (GRID, GRID)
assert set(np.unique(INIT)).issubset({-1, 1})

# ----------------------------------------------------------------------------
# 1. Dynamics
# ----------------------------------------------------------------------------
_ix, _iy = np.meshgrid(np.arange(GRID), np.arange(GRID), indexing="ij")
BLACK = ((_ix + _iy) % 2 == 0)
WHITE = ~BLACK
del _ix, _iy


def half_sweep(state, mask, rng):
    """One checkerboard half-sweep of Glauber kinetics (periodic boundaries)."""
    s32 = state.astype(np.int32)
    nbr = (np.roll(s32, 1, 0) + np.roll(s32, -1, 0) +
           np.roll(s32, 1, 1) + np.roll(s32, -1, 1))
    dE = 2 * s32 * nbr                       # energy change for s_i -> -s_i
    p_flip = 1.0 / (1.0 + np.exp(BETA * dE))  # Glauber transition probability
    u = rng.random(s32.shape)
    flip = (u < p_flip) & mask
    return np.where(flip, -state, state).astype(np.int8)


def sweep(state, rng):
    """One Monte-Carlo sweep = one flip attempt per site (two half-sweeps)."""
    state = half_sweep(state, BLACK, rng)
    state = half_sweep(state, WHITE, rng)
    return state

# ----------------------------------------------------------------------------
# 2. Observables
# ----------------------------------------------------------------------------
def energy_per_spin(state):
    """e = -(1/(2N)) sum_i s_i * (sum of 4 neighbours), N = L^2."""
    s32 = state.astype(np.float64)
    nbr = (np.roll(s32, 1, 0) + np.roll(s32, -1, 0) +
           np.roll(s32, 1, 1) + np.roll(s32, -1, 1))
    return float(-0.5 * np.mean(s32 * nbr))


def characteristic_length(state):
    """L(t) = sum_{k!=0} S(k) / sum_{k!=0} |k| S(k), S = power spectrum."""
    s = state.astype(np.float64)
    N = s.size
    m = s.mean()
    S = np.abs(np.fft.fft2(s - m)) ** 2 / N     # fluctuation power spectrum
    kx = np.fft.fftfreq(GRID)
    ky = np.fft.fftfreq(GRID)
    KX, KY = np.meshgrid(kx, ky, indexing="ij")
    kabs = 2.0 * np.pi * np.sqrt(KX ** 2 + KY ** 2)
    nz = kabs > 1e-12
    num = S[nz].sum()
    den = (kabs[nz] * S[nz]).sum()
    if den <= 0 or not np.isfinite(den):
        return float(GRID)                       # no resolved scale -> system size
    return float(np.clip(num / den, 1e-6, float(GRID)))


def column_profile(state):
    """p_x(x) = mean over y of s(x,y), length GRID."""
    return state.astype(np.float64).mean(axis=0)


def row_profile(state):
    """p_y(y) = mean over x of s(x,y), length GRID."""
    return state.astype(np.float64).mean(axis=1)


# ----------------------------------------------------------------------------
# 3. Radial pair correlation (stackC)
# ----------------------------------------------------------------------------
# Reduced displacement vectors (|dx|,|dy| <= GRID//2) binned by radius,
# half-open bins [r-0.5, r+0.5), only fully-resolvable bins kept.
_OFFS_DX = []
_OFFS_DY = []
_BINID = []
for dx in range(-GRID // 2, GRID // 2 + 1):
    for dy in range(-GRID // 2, GRID // 2 + 1):
        r = float(np.sqrt(dx * dx + dy * dy))
        if r < MAX_R - 0.5:
            _OFFS_DX.append(dx)
            _OFFS_DY.append(dy)
            _BINID.append(int(np.floor(r + 0.5)))
_OFFS_DX = np.array(_OFFS_DX, dtype=np.int64)
_OFFS_DY = np.array(_OFFS_DY, dtype=np.int64)
_BINID = np.array(_BINID, dtype=np.int64)


def radial_correlation(state, max_r=MAX_R):
    """C(r)=<s_i s_{i+r}> torus circular average, r=0..max_r-1, C(0)=1."""
    s = state.astype(np.float64)
    ac = np.fft.ifft2(np.fft.fft2(s) *
                      np.conj(np.fft.fft2(s))).real / s.size
    acc = np.zeros(max_r)
    cnt = np.zeros(max_r)
    for r in range(max_r):
        sel = _BINID == r
        if sel.sum() == 0:
            continue
        vals = ac[_OFFS_DY[sel] % GRID, _OFFS_DX[sel] % GRID]
        acc[r] = vals.sum()
        cnt[r] = vals.size
    C = np.where(cnt > 0, acc / np.maximum(cnt, 1), 0.0)
    if C[0] > 0:
        C = C / C[0]
    return C

# ----------------------------------------------------------------------------
# 4. Main run
# ----------------------------------------------------------------------------
def main():
    rng = np.random.default_rng(SEED)
    state = INIT.copy()
    t = 0

    seriesA = np.full((2, N_MEAS), np.nan)
    seriesB = np.full((2, N_MEAS), np.nan)
    stackC = np.zeros((N_SNAPSHOTS, MAX_R), dtype=np.float64)
    stackD = np.zeros((N_SNAPSHOTS, GRID), dtype=np.float64)
    stackE = np.zeros((N_SNAPSHOTS, 2, GRID), dtype=np.float64)
    snapL = np.zeros(N_SNAPSHOTS, dtype=np.float64)

    schedule = np.unique(np.concatenate([MEAS_TIMES, SNAP_TIMES]))
    meas_ptr = 0
    snap_ptr = 0

    for tt in schedule:
        ti = int(round(tt))
        while t < ti:
            state = sweep(state, rng)
            t += 1
        if meas_ptr < N_MEAS and np.isclose(MEAS_TIMES[meas_ptr], tt):
            seriesA[0, meas_ptr] = tt
            seriesA[1, meas_ptr] = energy_per_spin(state)
            seriesB[0, meas_ptr] = tt
            seriesB[1, meas_ptr] = characteristic_length(state)
            meas_ptr += 1
        if snap_ptr < N_SNAPSHOTS and np.isclose(SNAP_TIMES[snap_ptr], tt):
            stackC[snap_ptr] = radial_correlation(state)
            stackD[snap_ptr] = column_profile(state)
            stackE[snap_ptr, 0] = column_profile(state)
            stackE[snap_ptr, 1] = row_profile(state)
            snapL[snap_ptr] = characteristic_length(state)
            snap_ptr += 1

    assert meas_ptr == N_MEAS and snap_ptr == N_SNAPSHOTS
    assert t == N_STEPS

    metaA, metaB = diagnostics(seriesA, seriesB, stackC, snapL)
    return dict(
        seriesA=seriesA, seriesB=seriesB, stackC=stackC, stackD=stackD,
        stackE=stackE, metaA=metaA, metaB=metaB, final=state,
    )


# ----------------------------------------------------------------------------
# 5. Diagnostics
# ----------------------------------------------------------------------------
def diagnostics(seriesA, seriesB, stackC, snapL):
    # ---------------- metadataA: collapse of C(r/L) -----------------
    ts = SNAP_TIMES
    Ls = snapL
    notesA = []
    x_min_i = 1.0 / Ls
    x_max_i = (MAX_R - 1.0) / Ls
    valid = np.isfinite(Ls) & (Ls > 1.0) & (ts >= 1.0)
    n_valid = int(valid.sum())
    ok = n_valid >= 3
    x_min = 0.0
    x_max = 0.0
    quality = None
    spread = None
    if ok:
        x_min = float(np.max(x_min_i[valid]))
        x_max = float(np.min(x_max_i[valid]))
        ok = (x_max > x_min * 1.5) and (x_max - x_min) >= 1e-3
        notesA.append(f"collapse: {n_valid} resolvable snapshots of {N_SNAPSHOTS}")

    if ok:
        grid = np.linspace(x_min, x_max, 80)
        curves = np.zeros((N_SNAPSHOTS, grid.size))
        for i in range(N_SNAPSHOTS):
            if not valid[i]:
                curves[i, :] = np.nan
                continue
            r = np.arange(MAX_R, dtype=np.float64)
            x_i = r / Ls[i]
            c = stackC[i]
            curves[i] = np.interp(grid, x_i, c)
        with_valid = curves[valid]
        mean_curve = np.nanmean(with_valid, axis=0)
        rms_mean = float(np.sqrt(np.nanmean(mean_curve ** 2)))
        dev = with_valid - mean_curve
        rms_dev = float(np.sqrt(np.nanmean(dev ** 2)))
        spread = rms_dev / max(rms_mean, 1e-12)
        quality = float(np.clip(1.0 - spread, 0.0, 1.0))
        notesA.append(
            f"collapse window: x in [{x_min:.3f},{x_max:.3f}], "
            f"rel RMS spread={spread:.4f}, quality={quality:.4f}"
        )
    else:
        notesA.append(
            "collapse not applicable: <3 resolvable snapshots or no common x-range"
        )

    metaA = {
        "collapse_check_applicable": bool(ok),
        "collapse_quality": quality,
        "collapse_relative_rms_spread": spread,
        "collapse_dimension": 2,
        "collapse_snapshot_times": [float(t) for t in ts],
        "collapse_lengths": [float(l) for l in Ls],
        "collapse_x_range": [x_min, x_max],
        "collapse_grid_size": int(GRID if ok else 0),
        "notes": notesA + [
            "model: 2D Ising Glauber, T=control=%.4f (Tc=2.269185), J=1, beta=1/T" % CONTROL,
            "stackC: radial pair correlation C(r), r=0..%d, C(0)=1" % (MAX_R - 1),
            "collapse: dynamical scaling C(r/L) vs r/L; dimension=2; grid_size=100",
        ],
    }
    return metaA, _fit_metaB(seriesB)


def _fit_metaB(seriesB):
    t_all = MEAS_TIMES
    L_all = seriesB[1]
    fin = np.isfinite(L_all) & (L_all > 0) & (t_all >= 1.0)
    t_f = t_all[fin]
    L_f = L_all[fin]

    floor = 1.1                                   # min resolvable length
    idx = np.where(L_f > floor)[0]
    if len(idx) == 0:
        idx = np.arange(len(L_f))
    t0 = float(t_f[idx[0]])

    t_lo_cands = np.unique(np.round(np.linspace(max(t0, 8.0), 0.7 * t_f[-1], 16)))
    best = None
    for t_lo in t_lo_cands:
        sel0 = t_f >= t_lo
        n_rem = int(sel0.sum())
        t_hi_cands = np.unique(
            np.round(np.linspace(t_lo * 1.5, t_f[-1], min(16, max(4, n_rem)))))
        for t_hi in t_hi_cands:
            if t_hi <= t_lo:
                continue
            sel = (t_f >= t_lo) & (t_f <= t_hi)
            if sel.sum() < 6:
                continue
            x = np.log10(t_f[sel]); y = np.log10(L_f[sel])
            slope, ic = np.polyfit(x, y, 1)
            ss_res = float(np.sum((y - (slope * x + ic)) ** 2))
            ss_tot = float(np.sum((y - y.mean()) ** 2))
            r2 = 1.0 - ss_res / max(ss_tot, 1e-30)
            key = (r2, t_hi - t_lo, t_lo)
            if best is None or key > best[0]:
                best = (key, t_lo, t_hi, slope, ic, r2, int(sel.sum()))

    if best is None:
        return {
            "exponent": float("nan"),
            "exponent_std_error": float("nan"),
            "amplitude": float("nan"),
            "fit_range": [],
            "r_squared": float("nan"),
            "notes": ["no valid power-law fit in any range"],
        }
    _, t_lo, t_hi, _, ic, r2, npt = best
    sel = (t_f >= t_lo) & (t_f <= t_hi)
    x = np.log10(t_f[sel]); y = np.log10(L_f[sel])
    p, cov = np.polyfit(x, y, 1, cov=True)
    m = float(p[0]); b = float(p[1])
    se = float(np.sqrt(cov[0, 0]))
    amp = float(10.0 ** b)
    yhat = m * x + b
    r2 = float(1.0 - np.sum((y - yhat) ** 2) / max(np.sum((y - y.mean()) ** 2), 1e-30))
    return {
        "exponent": m,
        "exponent_std_error": se,
        "amplitude": amp,
        "fit_range": [float(t_lo), float(t_hi)],
        "r_squared": r2,
        "notes": [
            "fit: log10 L = log10 A + n log10 t over [%.3f, %.3f] sweeps "
            "(drops early transient L<%.1f and non-growing tail; max R^2)" % (t_lo, t_hi, floor),
            "L(t): structure-factor first moment L=sum_{k!=0}S/sum_{k!=0}|k|S; "
            "n=%d fit points; r_squared=%.5f" % (npt, r2),
            "semantics: exponent = domain-growth exponent; at T=%.4f (0.89*Tc) "
            "near-critical slowing lowers the measured value below the deep-order 0.5" % CONTROL,
        ],
    }

# ----------------------------------------------------------------------------
# 6. figure.png
# ----------------------------------------------------------------------------
def write_figure(results):
    """matplotlib Agg; pure-numpy last-resort writer if matplotlib missing."""
    try:
        import matplotlib
        matplotlib.use("Agg")
        import matplotlib.pyplot as plt
        _draw_mpl(plt, results)
        return True
    except Exception as exc:
        print("[simulation] matplotlib unavailable (%s); numpy fallback" % exc)
        _draw_fallback(results)
        return False


def _draw_mpl(plt, R):
    fig, axs = plt.subplots(2, 3, figsize=(15, 9))
    axs[0, 0].imshow(INIT, cmap="RdBu_r", vmin=-1, vmax=1)
    axs[0, 0].set_title("initial state (t=0)")
    mid = N_SNAPSHOTS // 2
    axs[0, 1].plot(np.arange(GRID), R["stackD"][mid], ".-", ms=3)
    axs[0, 1].set_title("x-profile (stackD, t=%.0f)" % SNAP_TIMES[mid])
    axs[0, 2].imshow(R["final"], cmap="RdBu_r", vmin=-1, vmax=1)
    axs[0, 2].set_title("final state (t=%d)" % N_STEPS)
    axs[1, 0].loglog(R["seriesB"][0], R["seriesB"][1], ".", ms=4, label="L(t)")
    axs[1, 0].loglog(R["seriesA"][0], -R["seriesA"][1] + 1.0, ".", ms=4,
                     alpha=0.4, label="1 - |e(t)|")
    axs[1, 0].set_xlabel("t (sweeps)"); axs[1, 0].set_ylabel("L(t)")
    axs[1, 0].legend(fontsize=8)
    axs[1, 1].plot(np.arange(MAX_R), R["stackC"].T, ".-", ms=4,
                   label=[f"t={t:.0f}" for t in SNAP_TIMES])
    axs[1, 1].set_xlabel("r"); axs[1, 1].set_ylabel("C(r)")
    axs[1, 1].legend(fontsize=7)
    axs[1, 2].loglog(R["seriesB"][0], R["seriesB"][1], ".", ms=4)
    if R["metaB"]["fit_range"]:
        tr = R["metaB"]["fit_range"]
        s = (R["seriesB"][0] >= tr[0]) & (R["seriesB"][0] <= tr[1])
        axs[1, 2].loglog(R["seriesB"][0][s],
                         R["metaB"]["amplitude"] * R["seriesB"][0][s]
                         ** R["metaB"]["exponent"], "-", lw=2,
                         label="n=%.3f" % R["metaB"]["exponent"])
    axs[1, 2].set_xlabel("t"); axs[1, 2].set_ylabel("L(t) (log-log)")
    axs[1, 2].legend(fontsize=9)
    q = R["metaA"]["collapse_quality"]
    e = R["metaB"]["exponent"]
    fig.suptitle("B3 Ising domain growth T=%.4f | collapse_quality=%s | n_exp=%s"
                 % (CONTROL, "%.3f" % q if q is not None else "null",
                    "%.3f" % e if R["metaB"]["fit_range"] else "nan"))
    fig.tight_layout()
    fig.savefig(os.path.join(BASE_DIR, "figure.png"), dpi=110)
    plt.close(fig)


# ------------------- pure-numpy PNG fallback -------------------
def _png_bytes(rgb):
    h, w, _ = rgb.shape
    raw = b"".join(b"\x00" + rgb[y].tobytes() for y in range(h))

    def chunk(tag, data):
        c = struct.pack(">I", len(data)) + tag + data
        return c + struct.pack(">I", zlib.crc32(tag + data) & 0xFFFFFFFF)

    sig = b"\x89PNG\r\n\x1a\n"
    ihdr = struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0)
    return sig + chunk(b"IHDR", ihdr) + chunk(b"IDAT", zlib.compress(raw, 9)) \
        + chunk(b"IEND", b"")


def _draw_line(img, x0, y0, x1, y1, col):
    h, w, _ = img.shape
    dx, dy = abs(x1 - x0), -abs(y1 - y0)
    sx = 1 if x0 < x1 else -1
    sy = 1 if y0 < y1 else -1
    err = dx + dy
    while True:
        if 0 <= x0 < w and 0 <= y0 < h:
            img[y0, x0] = col
        if x0 == x1 and y0 == y1:
            break
        e2 = 2 * err
        if e2 >= dy:
            err += dy; x0 += sx
        if e2 <= dx:
            err += dx; y0 += sy


def _plot_series(img, box, xs, ys, logx=False, logy=False, color=(0, 20, 255)):
    x0, y0, x1, y1 = box  # pixel box (y down)
    xs = np.asarray(xs, float); ys = np.asarray(ys, float)
    xv = np.log10(xs) if logx else xs
    yv = np.log10(ys) if logy else ys
    xmin, xmax = xv.min(), xv.max()
    ymin, ymax = yv.min(), yv.max()
    if xmax <= xmin:
        xmax = xmin + 1
    if ymax <= ymin:
        ymax = ymin + 1
    px = x0 + (xv - xmin) / (xmax - xmin) * (x1 - x0)
    py = y1 - (yv - ymin) / (ymax - ymin) * (y1 - y0)
    for i in range(len(px) - 1):
        _draw_line(img, int(px[i]), int(py[i]), int(px[i + 1]), int(py[i + 1]), color)


def _draw_fallback(R):
    W, H = 1000, 700
    panel = (320, 320)
    img = np.full((H, W, 3), 255, dtype=np.uint8)
    black = (0, 0, 0); red = (200, 20, 20); blue = (20, 20, 200); gray = (120, 120, 120)
    upf = panel[0] // GRID

    def _imshow(x0, y0, a):
        u = np.kron((a > 0).astype(np.uint8),
                    np.ones((upf, upf), dtype=np.uint8))
        oh, ow = u.shape
        px = x0 + (panel[0] - ow) // 2
        py = y0 + (panel[1] - oh) // 2
        p = img[py:py + oh, px:px + ow]
        p[..., 0] = np.where(u > 0, 220, 40)
        p[..., 1] = np.where(u > 0, 60, 40)
        p[..., 2] = np.where(u > 0, 40, 200)

    _imshow(20, 20, INIT)          # panel 1: initial state
    _imshow(350, 20, R["final"])   # panel 2: final state
    # panel 3: middle profile (stackD)
    mid = N_SNAPSHOTS // 2
    _plot_series(img, (20, 380, 320, 680), np.arange(GRID), R["stackD"][mid], color=blue)
    # panel 4: L(t) log-log with fit
    box = (350, 380, 650, 680)
    s = R["seriesB"]
    _plot_series(img, box, s[0], s[1], logx=True, logy=True, color=black)
    if R["metaB"]["fit_range"]:
        tr = R["metaB"]["fit_range"]
        tt = np.linspace(tr[0], tr[1], 60)
        ll = R["metaB"]["amplitude"] * tt ** R["metaB"]["exponent"]
        _plot_series(img, box, tt, ll, logx=True, logy=True, color=red)
    # panel 5: e(t) - energy decay
    _plot_series(img, (680, 380, 980, 680), R["seriesA"][0], -R["seriesA"][1],
                 logx=True, logy=False, color=blue)
    # panel 6: C(r) curves
    for i in range(N_SNAPSHOTS):
        _plot_series(img, (680, 20, 1000, 340), np.arange(MAX_R), R["stackC"][i],
                     color=(int(20 + i * 30), int(20 + i * 30), int(255 - i * 30)))
    # axis frames
    for (x0, y0, x1, y1) in [(20, 380, 320, 680), (350, 380, 650, 680),
                             (680, 380, 980, 680), (680, 20, 1000, 340)]:
        _draw_line(img, x0, y0, x1, y0, gray)
        _draw_line(img, x0, y0, x0, y1, gray)
        _draw_line(img, x1, y0, x1, y1, gray)
        _draw_line(img, x0, y1, x1, y1, gray)
    with open(os.path.join(BASE_DIR, "figure.png"), "wb") as f:
        f.write(_png_bytes(img))


# ----------------------------------------------------------------------------
# 7. Output files
# ----------------------------------------------------------------------------
def save(outputs, results):
    for name in ["seriesA", "seriesB", "stackC", "stackD", "stackE"]:
        arr = results[name].astype(np.float64)
        assert np.all(np.isfinite(arr)), name + " not finite"
        np.save(os.path.join(BASE_DIR, name + ".npy"), arr)
    with open(os.path.join(BASE_DIR, "metadataA.json"), "w") as f:
        json.dump(results["metaA"], f, indent=2)
