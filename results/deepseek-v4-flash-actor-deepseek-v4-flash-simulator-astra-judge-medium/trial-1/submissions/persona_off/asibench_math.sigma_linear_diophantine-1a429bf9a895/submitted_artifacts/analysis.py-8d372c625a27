"""
Bounded solutions of  a * sigma(n) = b * n + c   (1 <= n <= U).

Algorithm (structure-aware search-tree, no bulk n-scan):
  * n is built multiplicatively, prime by prime, over an increasing-prime DFS
    ("recursive factorization-tree traversal").
  * Node state = (m, sm=sigma(m), i) where m is the partial product, and only
    primes >= primes[i] may still appear in the residual r = n/m.
  * Configuration reduction: the residual must satisfy
        A*sigma(r) = B*r + c      with A = a*sm, B = b*m.
    This yields a *signed* residual-size window from sigma(r) >= r
    ((B-A)*r >= -c) and a target-ratio window: t(r)=(B*r+c)/(A*r) must lie in
    [1, cap].  cap is the SOUND upper bound
        cap(p_i, U//m) = product over the smallest available primes q >= primes[i]
                         with product(q) <= U//m  of  q/(q-1)
    (asymptotic per-prime cap; strictly conservative because
        sigma(r)/r = prod (1+1/p+...+1/p^e) < prod p/(p-1)  and the product of
        the distinct primes dividing r is at most r, the maximum being taken by
        the smallest primes).  t(r) is monotone in r (sign of c), so the
    interval-intersection test is done with exact integer arithmetic.
  * Special descendant handling: at every node the leaf option (residual r = 1)
    is checked exactly (a*sm == b*m + c -> m is a solution; this includes n = 1
    at the root).  Both "include current prime with exponent e" and "skip the
    current prime" descendants are considered.
  * Skip-jump / prime-power pruning: the skip branch is advanced over a run of
    primes only if *including* each of them with any exponent e >= 1 (m*q^e<=U)
    fails the necessary-condition window test at the child node -- so no
    feasible n can use those primes, and skipping the whole range is exact.

Every pruning test is a NECESSARY condition only; sufficiency is decided solely
by the leaf test, so no feasible n can ever be dropped.
"""
import math

__all__ = ["solve"]


def _sieve_upto(m):
    if m < 2:
        return []
    s = bytearray(b"\x01") * (m + 1)
    s[0] = s[1] = 0
    for i in range(2, int(m ** 0.5) + 1):
        if s[i]:
            s[i * i:m + 1:i] = b"\x00" * (((m - i * i) // i) + 1)
    return [i for i in range(2, m + 1) if s[i]]


class _Solver:
    """Stateful tree solver for one (a, b, c, U) instance."""

    __slots__ = ("a", "b", "c", "U", "primes", "_feas_cache", "_cap_cache")

    def __init__(self, a, b, c, U):
        self.a, self.b, self.c, self.U = a, b, c, U
        self.primes = _sieve_upto(U)
        self._feas_cache = {}
        self._cap_cache = {}

    def cap_ratio(self, i, R):
        """Sound upper bound on sigma(r)/r for r <= R whose prime factors are
        all >= primes[i]: product of q/(q-1) over the smallest such primes
        whose product stays <= R."""
        key = (i, R)
        v = self._cap_cache.get(key)
        if v is not None:
            return v
        if i >= len(self.primes):
            self._cap_cache[key] = (1, 1)
            return (1, 1)
        pr = self.primes
        num = 1
        den = 1
        prod = 1
        for k in range(i, len(pr)):
            q = pr[k]
            if q > R:
                break
            if prod * q > R:
                break
            prod *= q
            num *= q
            den *= (q - 1)
        self._cap_cache[key] = (num, den)
        return (num, den)

    def feas_child(self, m, sm, i):
        """Necessary-condition feasibility at node (m, sm, i): could a residual
        r (r >= 1, all prime factors >= primes[i], m*r <= U) satisfy
        a*sm*sigma(r) = b*m*r + c ?  (Window tests only; never a sufficiency
        test.)"""
        A = self.a * sm
        B = self.b * m
        R = self.U // m
        if R < 1:
            return False
        c = self.c
        # sigma(r) >= r  =>  (B - A)*r >= -c
        diff = B - A
        r_lo, r_hi = 1, R
        if diff > 0:
            if c < 0:
                r_lo = max(r_lo, (-c + diff - 1) // diff)  # ceil(-c/diff)
        elif diff < 0:
            if c < 0:
                return False
            r_hi = min(r_hi, c // (A - B))
        else:
            if c < 0:
                return False
        if r_lo > r_hi:
            return False
        # target ratio t(r) = (B*r + c)/(A*r) must lie in [1, cap].
        num, den = self.cap_ratio(i, R)
        K = num * A - den * B
        cc = den * c
        # need exists r in [r_lo, r_hi] with K*r >= cc  (linear in r)
        if K > 0:
            if K * r_hi < cc:
                return False
        elif K < 0:
            if K * r_lo < cc:
                return False
        else:
            if cc > 0:
                return False
        return True

    def _include_ok(self, m, sm, j):
        """May prime primes[j] appear in n (some exponent e >= 1 with
        m*q^e <= U) without immediately failing the necessary window at the
        child node?"""
        key = (m, j)
        v = self._feas_cache.get(key)
        if v is not None:
            return v
        q = self.primes[j]
        ppow = 1
        sps = 1  # sigma(p^e) as it accumulates: 1 + p + ... + p^e
        while True:
            ppow *= q
            sps += ppow
            mq = m * ppow
            smq = sm * sps
            if mq > self.U:
                break
            if self.feas_child(mq, smq, j + 1):
                self._feas_cache[key] = True
                return True
        self._feas_cache[key] = False
        return False

    def solve(self):
        a, b, c, U = self.a, self.b, self.c, self.U
        if U < 1:
            return []
        if a == 0:
            # reduce to the linear equation b*n + c = 0
            if b == 0:
                return list(range(1, U + 1)) if c == 0 else []
            if (-c) % b != 0:
                return []
            n = (-c) // b
            return [n] if 1 <= n <= U else []
        p = self.primes
        npr = len(p)
        sols = set()
        stack = [(1, 1, 0)]
        while stack:
            m, sm, i = stack.pop()
            # leaf: residual r = 1  ==  n = m
            if a * sm == b * m + c:
                sols.add(m)
            if i >= npr:
                continue
            if p[i] > U // m:
                continue
            # skip-jump: find the first prime that may be included
            j = i
            while j < npr and p[j] <= U // m and not self._include_ok(m, sm, j):
                j += 1
            if j >= npr or p[j] > U // m:
                continue
            q = p[j]
            # include branches: every exponent e with m*q^e <= U that passes the
            # necessary window at the child
            ppow = 1
            sps = 1
            while True:
                ppow *= q
                sps += ppow
                mq = m * ppow
                smq = sm * sps
                if mq > U:
                    break
                if self.feas_child(mq, smq, j + 1):
                    stack.append((mq, smq, j + 1))
            # skip branch: prime q is not a factor of n
            stack.append((m, sm, j + 1))
        return sorted(sols)


def solve(a: int, b: int, c: int, U: int) -> list:
    """Return the sorted list of all positive integers n with 1 <= n <= U such
    that a * sigma(n) = b * n + c, where sigma is the sum-of-divisors function
    (sigma(1) = 1).  Pure, deterministic, self-contained."""
    if a < 0:
        # multiply both sides through by -1 to normalize to a > 0
        return solve(-a, -b, -c, U)
    return _Solver(a, b, c, U).solve()


if __name__ == "__main__":
    import json
    import os

    here = os.path.dirname(os.path.abspath(__file__))
    with open(os.path.join(here, "data", "problem_instances.json")) as fh:
        data = json.load(fh)
    instances = data["instances"]

    sol_rows = []          # (instance_id, n)
    summary_rows = []      # (instance_id, solution_count, largest_solution)

    for rec in instances:
        iid = rec["instance_id"]
        ns = solve(rec["a"], rec["b"], rec["c"], rec["U"])  # already sorted
        sol_rows.extend((iid, n) for n in ns)
        largest = ns[-1] if ns else 0
        summary_rows.append((iid, len(ns), largest))

    # deterministic: sort by instance_id then n
    sol_rows.sort(key=lambda r: (r[0], r[1]))
    summary_rows.sort(key=lambda r: r[0])

    outdir = os.path.join(here, "results")
    os.makedirs(outdir, exist_ok=True)

    with open(os.path.join(outdir, "solutions.csv"), "w", newline="") as fh:
        fh.write("instance_id,n\n")
        for iid, n in sol_rows:
            fh.write(f"{iid},{n}\n")

    with open(os.path.join(outdir, "instance_summary.csv"), "w", newline="") as fh:
        fh.write("instance_id,solution_count,largest_solution\n")
        for iid, cnt, largest in summary_rows:
            fh.write(f"{iid},{cnt},{largest}\n")

    print(f"wrote {len(sol_rows)} solution rows, {len(summary_rows)} summary rows")
