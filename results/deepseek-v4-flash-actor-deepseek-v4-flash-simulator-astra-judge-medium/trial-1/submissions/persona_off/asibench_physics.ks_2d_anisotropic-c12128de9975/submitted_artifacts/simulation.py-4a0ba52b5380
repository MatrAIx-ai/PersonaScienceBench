                 ("burg", [-1.4, -0.3, -1.2, -0.35, -0.9, -0.4, -0.05])]:
    try:
        uB = ifrk4(ic.copy(), cc, 10.0, form, 2000)
        if not np.isfinite(uB).all():
            print("  B %-5s %s -> diverged" % (form, np.round(cc, 2))); continue
        rms = np.sqrt(np.mean((uB-fe[-1])**2))/np.sqrt(np.mean(fe[-1]**2))
        cor = np.corrcoef(uB.ravel(), fe[-1].ravel())[0, 1]
        print("  B %-5s %s -> t=10 rel-rms=%.3f corr=%.3f (rms %.3f vs obs %.3f)"
              % (form, np.round(cc, 2), rms, cor, np.sqrt((uB**2).mean()),
                 np.sqrt((fe[-1]**2).mean())))
    except Exception as e:
        print("  B %s %s -> error %s" % (form, np.round(cc, 2), e))

# candidate C: low-wavenumber PDE regression fit
print("\n-- Candidate C (low-k PDE regression) --")
cut = 1.5
LF = np.expand_dims((Krad <= cut), 0)
feL = np.real(np.fft.ifft2(np.fft.fft2(fe, axes=(1, 2))*LF, axes=(1, 2)))
duL = np.zeros_like(feL)
duL[1:-1] = (feL[2:]-feL[:-2])/(2*DT)
duL[0] = (-3*feL[0]+4*feL[1]-feL[2])/(2*DT)
