print("  C one-step resid rms=%.4f (b rms=%.4f)" % (resC, np.sqrt(np.mean(b**2))))
uC = ifrk4(ic.copy(), coefC, 10.0, "grad", 2000)
if np.isfinite(uC).all():
    print("  C t=10 rel-rms=%.3f corr=%.3f"
          % (np.sqrt(np.mean((uC-fe[-1])**2))/np.sqrt(np.mean(fe[-1]**2)),
             np.corrcoef(uC.ravel(), fe[-1].ravel())[0, 1]))
else:
