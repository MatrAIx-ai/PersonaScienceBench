"""
B3: 2D Nonlinear Field Prediction
Episode: asibench:physics.ks_2d_anisotropic (2D anisotropic Kuramoto-Sivashinsky field)
Pipeline: load -> explore -> test candidates (A spectral continuation primary;
B anisotropic-KS with given coefficients, refuted; C low-k PDE fit) -> validate ->
predict at t=30 -> divergence protocol -> scored diagnostics -> visualizations (pure
stdlib PNG encoder; matplotlib/PIL unavailable) -> verification.
Interpretation: data_exploration.json <- OBSERVED; spectral_density.npy and
physical_quantities.json <- PREDICTED field; characteristic_scale_* = peak marginal
spatial frequency (cycles/unit); structural_ratio = dominant-energy anisotropy ratio
Pkx_peak/Pky_peak; decay_exponent = log-log slope of time-averaged radial PSD above
its peak below 0.65*k_max; temporal_decay = first zero crossing of mean-centred
centre-pixel autocorrelation (fallback obs/4); coherence_length_* = first zero
crossing of averaged centred periodic line autocorrelation * spacing.
"""
import os, json, math, struct, zlib
import numpy as np
from scipy.optimize import curve_fit

BASE = os.path.dirname(os.path.abspath(__file__))
DATA = os.path.join(BASE, "data")

with open(os.path.join(DATA, "system_info.json")) as fh:
    SYS = json.load(fh)
LX = float(SYS["domain_length_x"]);   LY = float(SYS["domain_length_y"])
NX = int(SYS["grid_size_x"]);         NY = int(SYS["grid_size_y"])
DX = float(SYS["dx"]);                DY = float(SYS["dy"])
OBS_T = float(SYS["observation_time"])
T_TGT = float(SYS["target_time"])
NOBS = int(SYS["n_obs_snapshots"])
COEFS = [float(SYS[k]) for k in
         ["system_coefficient_1","system_coefficient_2","system_coefficient_3",
          "system_coefficient_4","system_coefficient_5","system_coefficient_6",
          "system_coefficient_7"]]
fe = np.load(os.path.join(DATA, "field_evolution.npy")).astype(float)
ic = np.load(os.path.join(DATA, "initial_condition.npy")).astype(float)
N, Nx, Ny = fe.shape
DT = OBS_T/(N-1)
t_obs = np.arange(N)*DT
assert (NX, NY) == (Nx, Ny)
assert np.isfinite(fe).all() and np.isfinite(ic).all()
print("inputs ok fe", fe.shape, "ic", ic.shape, "ic==fe[0]:",
      float(np.abs(fe[0]-ic).max()) < 1e-12)

kx = np.fft.fftfreq(Nx, DX);  ky = np.fft.fftfreq(Ny, DY)
KX, KY = np.meshgrid(kx, ky, indexing="ij")
WX, WY = np.meshgrid(2*np.pi*kx, 2*np.pi*ky, indexing="ij")
Krad = np.sqrt(WX**2 + WY**2)

def F2(u):   return np.fft.fft2(u)
def iF2(U):  return np.real(np.fft.ifft2(U))
def deriv(u, px, py):
    return iF2(F2(u)*(1j*WX)**px*(1j*WY)**py)

# ---------------- explore observed data ----------------
f_avg = fe.mean(axis=0)
P2 = np.abs(F2(f_avg))**2 / f_avg.size
Pkx = P2.mean(axis=1)[1:Nx//2];  Pky = P2.mean(axis=0)[1:Ny//2]
kx_s = kx[1:Nx//2];  ky_s = ky[1:Ny//2]

def peak_freq(pv, fr):
    return float(np.asarray(fr)[int(np.argmax(np.asarray(pv)))])

cs1 = peak_freq(Pkx, kx_s); cs2 = peak_freq(Pky, ky_s)
aniso = float(Pkx.max()/max(Pky.max(), 1e-300))
explore = {"characteristic_scale_1": cs1, "characteristic_scale_2": cs2,
           "structural_ratio": aniso}
print("observed peaks kx=%.4f ky=%.4f aniso=%.3f" % (cs1, cs2, aniso))

def radial_psd(field, n_ann=65):
    Ff = np.fft.fft2(field); P = np.abs(Ff)**2/field.size
    Rx = np.abs(np.fft.fftfreq(field.shape[0], DX))
    Ry = np.abs(np.fft.fftfreq(field.shape[1], DY))
    R_ = np.sqrt(Rx[:, None]**2 + Ry[None, :]**2)
    edges = np.linspace(0.0, R_.max(), n_ann+1)
    out = np.zeros(n_ann)
    for b in range(n_ann):
        m = (R_ >= edges[b]) & (R_ < edges[b+1]) if b < n_ann-1 else \
            (R_ >= edges[b]) & (R_ <= edges[b+1])
        if m.sum(): out[b] = P[m].mean()
    return out, edges

psd_obs, edges_obs = radial_psd(f_avg)

def decay_exponent(psd, edges):
    pk = int(np.argmax(psd)); hi = 0.65*edges[-1]
    use = np.arange(pk+1, len(psd))
    rr = (edges[use]+edges[use+1])/2; yy = psd[use]
    m = (yy > 0) & (rr < hi)
    xv, yv = rr[m], yy[m]
    return float(np.polyfit(np.log(xv), np.log(yv), 1)[0]) if len(xv) >= 3 else float("nan")

explore["decay_exponent"] = decay_exponent(psd_obs, edges_obs)
print("observed decay exponent = %.3f" % explore["decay_exponent"])

# temporal decorrelation
c = fe - fe.mean(axis=0, keepdims=True)
cp = c[:, Nx//2, Ny//2]; cp = cp - cp.mean()
ac = np.array([np.sum(cp[l:]*cp[:N-l])/np.sum(cp**2) for l in range(N)])
t_zero = OBS_T/4.0
for l in range(1, N):
    if ac[l] <= 0:
        t_zero = (l-1 + ac[l-1]/(ac[l-1]-ac[l]))*DT
        break
explore["temporal_decay_scale"] = float(t_zero)
print("decorrelation first zero = %.3f s" % t_zero)

def line_ac_zero(field, axis, spacing):
    lines = field if axis == 0 else field.T
    L = lines.shape[1]; acc = np.zeros(L)
    for li in range(lines.shape[0]):
        x = lines[li] - lines[li].mean()
        a = np.real(np.fft.ifft(np.fft.fft(x)*np.conj(np.fft.fft(x))))
        if a[0] > 1e-30: a = a/a[0]
        acc += a
    acc /= lines.shape[0]
    for i in range(1, L):
        if acc[i] <= 0:
            return (i-1 + acc[i-1]/(acc[i-1]-acc[i]))*spacing
    return float(spacing*L)

coh_o1 = float(np.mean([line_ac_zero(fe[i], 0, DX) for i in range(N)]))
coh_o2 = float(np.mean([line_ac_zero(fe[i], 1, DY) for i in range(N)]))
print("observed coherence x=%.3f y=%.3f units" % (coh_o1, coh_o2))

# ---------------- model candidates ----------------
Ffull = np.stack([F2(fe[i]) for i in range(N)])

def fit_permode_g(nfit):
    A = np.stack([np.ones(nfit), t_obs[:nfit]], axis=1)
    g = np.zeros((Nx, Ny), complex)
    for mx in range(Nx):
        for my in range(Ny):
            z = Ffull[:nfit, mx, my]; a = np.abs(z)
            if a.min() < 1e-9: continue
            clog, *_ = np.linalg.lstsq(A, np.log(np.maximum(a, 1e-30)), rcond=None)
            cph,  *_ = np.linalg.lstsq(A, np.unwrap(np.angle(z)), rcond=None)
            g[mx, my] = clog[1] + 1j*cph[1]
    return g

def spectral_rollout(u0, g, times, reg=1e-3, cap=None):
    F0 = F2(u0); E0m = np.abs(F0)**2
    w = E0m/(E0m + reg*E0m.max())
    g_eff = g*w
    if cap is not None:
        g_eff = g_eff.real.clip(-cap, cap) + 1j*g_eff.imag
    return np.array([iF2(F0*np.exp(g_eff*tt)) for tt in times]), g_eff

def energy_curve(tt):
    E = (fe**2).mean(axis=(1, 2))
    def sat(tn, Es, tau): return Es-(Es-E[0])*np.exp(-tn/tau)
    try:
        p, _ = curve_fit(sat, t_obs, E, p0=[2.0*E.max(), 20.0], maxfev=30000)
        return float(sat(tt, *p))
    except Exception:
        sl = np.polyfit(t_obs, E, 1)
        return float(np.polyval(sl, tt))

def energy_normalize(u_pred, tt):
    Et = energy_curve(tt); Er = float((u_pred**2).mean())
    return u_pred if Er < 1e-300 else u_pred*math.sqrt(Et/Er)

SPLIT = N//2 - 1
gA = fit_permode_g(SPLIT+1)
print("\n-- Candidate A validation --")
for cap in [None, 0.06, 0.10]:
    predA, gAe = spectral_rollout(fe[0], gA, t_obs, cap=cap)
    cors = []; rmss = []
    for i in range(N):
        pr = energy_normalize(predA[i], t_obs[i])
        cors.append(np.corrcoef(pr.ravel(), fe[i].ravel())[0, 1])
        rmss.append(np.sqrt(np.mean((pr-fe[i])**2)))
    cor_hold = [np.corrcoef(energy_normalize(predA[i], t_obs[i]).ravel(), fe[i].ravel())[0, 1]
                for i in range(SPLIT+1, N)]
    print("  cap=%-5s full final corr=%.4f rms=%.4f | holdout mean corr=%.4f min=%.4f"
          % (str(cap), cors[-1], rmss[-1], np.mean(cor_hold), np.min(cor_hold)))

CAP = 0.06
gA_full = fit_permode_g(N)
predictor_roll, gA_eff = spectral_rollout(ic, gA_full, np.array([T_TGT]),
                                          reg=1e-3, cap=CAP)
pred_raw = predictor_roll[0]
pred_field = energy_normalize(pred_raw, T_TGT)
print("A final: raw rms=%.3f -> normalized rms=%.3f at t=30" %
      (np.sqrt((pred_raw**2).mean()), np.sqrt((pred_field**2).mean())))

# candidate B: anisotropic KS with given coefficients (tested-and-refuted)
def ifrk4(u0, c, T_end, form, substeps):
    L = (c[0]*(1j*WX)**2 + c[1]*(1j*WY)**2 + c[2]*(1j*WX)**4 +
         c[3]*(1j*WY)**4 + c[4]*(1j*WX)**2*(1j*WY)**2)
    if form == "grad":
        def nl(u): return c[5]*deriv(u, 1, 0)**2 + c[6]*deriv(u, 0, 1)**2
    else:
        def nl(u): return c[5]*u*deriv(u, 1, 0) + c[6]*u*deriv(u, 0, 1)
    Ls = L.copy(); Ls.real = np.clip(Ls.real, None, 2.0)
    h = T_end/substeps; u = u0.copy()
    for _ in range(substeps):
        eLh = np.exp(Ls*h)
        n1 = nl(u)
        u2 = iF2(np.fft.fft2(u+0.5*h*n1)*np.exp(Ls*0.5*h)); n2 = nl(u2)
        u3 = iF2(np.fft.fft2(u+0.5*h*n2)*np.exp(Ls*0.5*h)); n3 = nl(u3)
        u4 = iF2(np.fft.fft2(u+h*n3)*np.exp(Ls*h));         n4 = nl(u4)
        U = np.fft.fft2(u)
        U = eLh*(U + h*(np.fft.fft2(n1)/6+np.fft.fft2(n2)/3+np.fft.fft2(n3)/3+np.fft.fft2(n4)/6))
        u = iF2(U)
        if not np.isfinite(u).all(): return u
    return u

print("\n-- Candidate B (given coefficients, refuted) --")
import warnings
warnings.filterwarnings("ignore", category=RuntimeWarning)
for form, cc in [("grad", COEFS),
                 ("grad", [-x for x in COEFS]),
