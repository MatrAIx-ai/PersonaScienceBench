# PNG validity check
def verify_png(path):
    with open(path, "rb") as fh: data = fh.read()
    assert data[:8] == b"\x89PNG\r\n\x1a\n"
    pos = 8; w = h = None
    while pos < len(data):
        ln = struct.unpack(">I", data[pos:pos+4])[0]
        tag = data[pos+4:pos+8]; pay = data[pos+8:pos+8+ln]
        if tag == b"IHDR":
            w, h, bd, ct = struct.unpack(">IIBB", pay[:10])
        elif tag == b"IDAT":
            zlib.decompress(pay)
        pos += 12+ln
        if tag == b"IEND": break
    return w, h
for p in ["field_visualization.png", "spectral_visualization.png"]:
    w, h = verify_png(os.path.join(BASE, p))
    print("PNG ok: %s %dx%d" % (p, w, h))

