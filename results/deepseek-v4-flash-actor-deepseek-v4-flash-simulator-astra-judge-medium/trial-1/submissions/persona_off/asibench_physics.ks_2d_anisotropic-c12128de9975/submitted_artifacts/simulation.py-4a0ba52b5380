def dstack(px, py):
    return np.stack([deriv(feL[k], px, py) for k in range(N)])
uxL = dstack(1, 0); uyL = dstack(0, 1)
Tc = {"uxx": dstack(2, 0), "uyy": dstack(0, 2), "uxxxx": dstack(4, 0),
      "uyyyy": dstack(0, 4), "uxxyy": dstack(2, 2), "ux2": uxL**2, "uy2": uyL**2}
namesC = list(Tc.keys())
mask = np.arange(1, N-1)
A = np.stack([Tc[n][mask].reshape(-1) for n in namesC], axis=1)
b = duL[mask].reshape(-1)
