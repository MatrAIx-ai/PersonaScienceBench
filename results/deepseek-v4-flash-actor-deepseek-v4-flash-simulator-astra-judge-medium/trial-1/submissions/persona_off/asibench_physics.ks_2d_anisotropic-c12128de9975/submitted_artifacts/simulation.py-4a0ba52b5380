# divergence measure: rng(1729), norm 1e-8, 4 x 2 s segments
rng = np.random.default_rng(1729)
delta = rng.standard_normal((NX, NY))
delta = delta - delta.mean()
delta = delta/np.linalg.norm(delta)*1e-8
seg_len = 2.0
