def _glyph_rows(ch):
    return _FONT.get(ch.upper(), (0, 0, 0, 0, 0, 0, 0))

def _text_w(s, scale):
    return len(s) * 6 * scale

def _blit_text(img, x, y, s, color, scale=1):
    h, w = img.shape[:2]
    for ci, ch in enumerate(s):
        rows = _glyph_rows(ch)
        bx = x + ci * 6 * scale
        for r in range(7):
            bits = rows[r]
            for c in range(5):
                if bits & (1 << (4 - c)):
                    for dy in range(scale):
                        for dx in range(scale):
                            px, py = bx + c * scale + dx, y + r * scale + dy
                            if 0 <= px < w and 0 <= py < h:
                                img[py, px] = color

def _set_px(img, x, y, color):
    h, w = img.shape[:2]
    if 0 <= x < w and 0 <= y < h:
        img[y, x] = color

def _fill_rect(img, x0, y0, x1, y1, color):
    x0, x1 = sorted((int(x0), int(x1)))
    y0, y1 = sorted((int(y0), int(y1)))
    h, w = img.shape[:2]
    x0, y0 = max(x0, 0), max(y0, 0)
    x1, y1 = min(x1, w - 1), min(y1, h - 1)
    img[y0:y1 + 1, x0:x1 + 1] = color

def _line(img, x0, y0, x1, y1, color, width=1):
    x0, y0, x1, y1 = int(x0), int(y0), int(x1), int(y1)
    dx, dy = abs(x1 - x0), -abs(y1 - y0)
    sx, sy = (1 if x0 < x1 else -1), (1 if y0 < y1 else -1)
    err = dx + dy
    while True:
        for ox in range(-(width // 2), width - width // 2):
            for oy in range(-(width // 2), width - width // 2):
                _set_px(img, x0 + ox, y0 + oy, color)
        if x0 == x1 and y0 == y1:
            break
        e2 = 2 * err
        if e2 >= dy:
            err += dy; x0 += sx
        if e2 <= dx:
            err += dx; y0 += sy

def _polyline(img, pts, color, width=1):
    for (a, b) in zip(pts[:-1], pts[1:]):
        _line(img, a[0], a[1], b[0], b[1], color, width)

def _nice_ticks(lo, hi, n=5):
    if hi <= lo:
        return np.array([lo, hi])
    span = hi - lo
    step = 10 ** np.floor(np.log10(span / n))
    for m in (1, 2, 2.5, 5, 10):
        if span / (step * m) <= n:
            step *= m; break
    t0 = np.ceil(lo / step) * step
    return np.arange(t0, hi + 1e-12, step)


def render_diagnostics(t_imu, w_imu, train, held, res_yaw_tr, res_yaw_ho,
                       res_ang_tr, res_ang_ho, seg_rows, sigma_yaw,
                       b_cal, tau_cal, phi_cal, width=1500, height=1080):
    W, H = width, height
    img = np.full((H, W, 3), 255, dtype=np.uint8)
    WHITE = (255, 255, 255)
    BLACK = (10, 10, 10)
    BLUE = (31, 78, 156)
    RED = (192, 57, 43)
    GRAY = (190, 190, 190)
    GREEN = (46, 138, 87)
    LIGHT = (222, 228, 240)

    # header
    _blit_text(img, 24, 18, "CALIBRATION DIAGNOSTICS  (lidar-imu yaw/offset calibration)",
               BLACK, scale=2)
    hdr = ("BIAS = %.5f RAD/S   OFFSET = %.3f MS   YAW_EXTRINSIC = %.3f DEG   "
           "[train=700  heldout=154]") % (b_cal, tau_cal * 1000.0, np.degrees(phi_cal))
    _blit_text(img, 24, 46, hdr, (60, 60, 60), scale=1)

    # panel geometry (2x2)
    panels = [
        {"title": "IMU GYRO OMEGA_Z", "xl": "TIME (S)", "yl": "RAD/S"},
        {"title": "YAW RESIDUAL (TRAIN/HELDOUT)", "xl": "LIDAR T0 (S)", "yl": "RAD"},
        {"title": "TRANSLATION DIRECTION RESIDUAL", "xl": "LIDAR T0 (S)", "yl": "RAD"},
        {"title": "SEGMENT OBSERVABILITY (D-OPTIMAL)", "xl": "SEGMENT ID", "yl": "SCORE"},
    ]
    margin_l, margin_r, margin_b, margin_t = 108, 34, 74, 120
    gap = 34
    pw = (W - margin_l - margin_r - gap) // 2
    ph = (H - margin_t - margin_b - gap) // 2
    rects = []
    for idx, p in enumerate(panels):
        r, c = divmod(idx, 2)
        x0 = margin_l + c * (pw + gap)
        y0 = margin_t + r * (ph + gap)
        rects.append((x0, y0, x0 + pw, y0 + ph))

    # ---------------- helper to render one panel frame ----------------
    def frame(rect, title, xlabel, ylabel):
        x0, y0, x1, y1 = rect
        _fill_rect(img, x0, y0, x1, y1, LIGHT)         # light plot area
        _line(img, x0, y0, x1, y0, BLACK, 1)           # frame
        _line(img, x1, y0, x1, y1, BLACK, 1)
        _line(img, x1, y1, x0, y1, BLACK, 1)
        _line(img, x0, y1, x0, y0, BLACK, 1)
        _blit_text(img, x0 + 12, y0 - 30, title, BLACK, scale=2)
        tw = _text_w(xlabel, scale=1)
        _blit_text(img, x0 + (x1 - x0) // 2 - tw // 2, y1 + 12, xlabel, BLACK, scale=1)
        # vertical y-label (rotated by writing char by char)
        for i, ch in enumerate(ylabel):
            _blit_text(img, x0 - 28, y1 - 14 - i * 16, ch, BLACK, scale=2)

    def mapxy(rect, xr, yr):
        x0, y0, x1, y1 = rect
        return (lambda x: x0 + (x - xr[0]) / (xr[1] - xr[0]) * (x1 - x0),
                lambda y: y1 - (y - yr[0]) / (yr[1] - yr[0]) * (y1 - y0))

    def axes_ticks(rect, xr, yr):
        x0, y0, x1, y1 = rect
        fx, fy = mapxy(rect, xr, yr)
        for t in _nice_ticks(*xr):
            px = int(fx(t))
            _line(img, px, y1, px, y1 + 5, BLACK, 1)
            _blit_text(img, px - 3, y1 + 8, ("%.0f" % t) if abs(t) >= 10 else ("%.1f" % t),
                       BLACK, scale=1)
        for t in _nice_ticks(*yr):
            py = int(fy(t))
            _line(img, x0 - 5, py, x0, py, BLACK, 1)
            _blit_text(img, x0 - 52, py - 5, ("%.2f" % t) if abs(t) < 10 else ("%.0f" % t),
                       BLACK, scale=1)
        # inner grid (light)
        for t in _nice_ticks(*xr, 6):
            px = int(fx(t))
            _line(img, px, y0, px, y1, GRAY, 1)
        for t in _nice_ticks(*yr, 6):
            py = int(fy(t))
            _line(img, x0, py, x1, py, GRAY, 1)

    # ---- panel 1: gyro ----
    r0 = rects[0]
    frame(r0, panels[0]["title"], panels[0]["xl"], panels[0]["yl"])
    xr = (float(t_imu.min()), float(t_imu.max()))
    yr = (float(w_imu.min()), float(w_imu.max()))
    fx, fy = mapxy(r0, xr, yr)
    pts = [(fx(t), fy(w)) for t, w in zip(t_imu[::4], w_imu[::4])]
    _polyline(img, pts, BLUE, 2)
    axes_ticks(r0, xr, yr)
    _line(img, int(fx(0)), r0[1], int(fx(0)), r0[3], RED, 1)

    # ---- panel 2: yaw residual ----
    r1 = rects[1]
    frame(r1, panels[1]["title"], panels[1]["xl"], panels[1]["yl"])
    ts_tr = train["t0_lidar_s"].to_numpy(float)
    ts_ho = held["t0_lidar_s"].to_numpy(float)
    all_y = np.concatenate([res_yaw_tr, res_yaw_ho])
    xr = (float(min(ts_tr.min(), ts_ho.min())), float(max(ts_tr.max(), ts_ho.max())))
    m = max(abs(all_y.min()), abs(all_y.max()), 0.02)
    yr = (-m * 1.15, m * 1.15)
    fx, fy = mapxy(r1, xr, yr)
    axes_ticks(r1, xr, yr)
    _line(img, r1[0], int(fy(0)), r1[2], int(fy(0)), BLACK, 1)
    _line(img, r1[0], int(fy(sigma_yaw)), r1[2], int(fy(sigma_yaw)), RED, 1)
    _line(img, r1[0], int(fy(-sigma_yaw)), r1[2], int(fy(-sigma_yaw)), RED, 1)
    for t, v in zip(ts_tr, res_yaw_tr):
        _fill_rect(img, int(fx(t)) - 2, int(fy(v)) - 2, int(fx(t)) + 2, int(fy(v)) + 2, BLUE)
    for t, v in zip(ts_ho, res_yaw_ho):
        _fill_rect(img, int(fx(t)) - 3, int(fy(v)) - 3, int(fx(t)) + 3, int(fy(v)) + 3, RED)
    _blit_text(img, r1[0] + pw - 96, r1[1] + 8, "TRAIN . HELDOUT . +/-SIGMA", (50, 50, 50), scale=1)

    # ---- panel 3: translation direction residual ----
    r2 = rects[2]
    frame(r2, panels[2]["title"], panels[2]["xl"], panels[2]["yl"])
    all_a = np.concatenate([res_ang_tr, res_ang_ho])
    xr = (float(min(ts_tr.min(), ts_ho.min())), float(max(ts_tr.max(), ts_ho.max())))
    m = max(abs(all_a.min()), abs(all_a.max()), 0.3)
    yr = (-m * 1.15, m * 1.15)
    fx, fy = mapxy(r2, xr, yr)
    axes_ticks(r2, xr, yr)
    _line(img, r2[0], int(fy(0)), r2[2], int(fy(0)), BLACK, 1)
    for t, v in zip(ts_tr, res_ang_tr):
        _fill_rect(img, int(fx(t)) - 2, int(fy(v)) - 2, int(fx(t)) + 2, int(fy(v)) + 2, BLUE)
    for t, v in zip(ts_ho, res_ang_ho):
        _fill_rect(img, int(fx(t)) - 3, int(fy(v)) - 3, int(fx(t)) + 3, int(fy(v)) + 3, RED)

    # ---- panel 4: observability bars ----
    r3 = rects[3]
    frame(r3, panels[3]["title"], panels[3]["xl"], panels[3]["yl"])
    sid = np.array([r["segment_id"] for r in seg_rows], dtype=float)
    sc = np.array([r["observability_score"] for r in seg_rows], dtype=float)
    xr = (-0.6, len(seg_rows) - 0.4)
    yr = (0.0, max(1.0, float(sc.max()) * 1.15))
    fx, fy = mapxy(r3, xr, yr)
    axes_ticks(r3, xr, yr)
    for (s_, v_) in zip(sid, sc):
        x0p = int(fx(s_ - 0.34)); x1p = int(fx(s_ + 0.34)); y0p = int(fy(0)); y1p = int(fy(v_))
        _fill_rect(img, x0p, y1p, x1p, y0p, GREEN)
        _blit_text(img, int(fx(s_)) - 5, y0p + 8, "%d" % int(s_), BLACK, scale=1)

    return img


def _write_png_fallback(path, width=1500, height=1080):
    rgb = render_diagnostics(t_imu, w_imu, train, held, res_yaw_tr, res_yaw_ho,
                             res_ang_tr, res_ang_ho, seg_rows, SIGMA_YAW,
                             b_cal, tau_cal, phi_cal, width=width, height=height)
    h, w = rgb.shape[:2]
    raw = bytearray()
    for y in range(h):
        raw.append(0)
        raw.extend(rgb[y].tobytes())
    comp = zlib.compress(bytes(raw), 6)

    def chunk(typ, data):
        return (struct.pack(">I", len(data)) + typ + data +
                struct.pack(">I", zlib.crc32(typ + data) & 0xFFFFFFFF))

    png = (b"\x89PNG\r\n\x1a\n"
           + chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0))
           + chunk(b"IDAT", comp) + chunk(b"IEND", b""))
    with open(path, "wb") as f:
        f.write(png)


if not HAVE_MPL:
    _write_png_fallback(FIGFILE)
    print("diagnostics figure written via embedded renderer ->", FIGFILE)
