#!/usr/bin/env python3
"""
TASK008_BCG-CORONA -- Q3
In which patient volume group (number of patients seen) do healthcare workers show
statistically significant differences (p<0.05) in COVID-19 severity between BCG vaccination
and placebo groups based on chi-square analysis?

Design:
  - Unit of analysis: unique subjects (healthcare workers) with a COVID-19 AE.
  - Outcome: per-subject maximum AEHS (COVID-19 severity; 0=asymptomatic .. 7).
  - Binary severity split: AEHS >= 3 (moderate/severe, hospital-level) vs AEHS <= 2
    (mild/ambulatory, incl. asymptomatic = 0).
  - Strata: patients_seen groups '1-50', '51-100', '>100'.
  - Test: Pearson chi-square (no continuity correction) per stratum on the 2x2
    severity-by-treatment table; group-wise p < 0.05 threshold.
  - Sensitivity: Fisher's exact test reported for strata with any expected cell < 5;
    count of subjects with no COVID AE reported.
"""
import pandas as pd
import numpy as np
from scipy.stats import chi2_contingency, fisher_exact

DM_PATH = 'data/TASK008_BCG-CORONA_DM.csv'
AE_PATH = 'data/TASK008_BCG-CORONA_AE.csv'

def main():
    dm = pd.read_csv(DM_PATH)
    ae = pd.read_csv(AE_PATH)

    # ---- COVID-19 events from AE ----
    covid_mask = (ae['AEPT'].astype(str).str.contains(
        'covid|coronavirus|sars-cov', case=False, na=False))
    covid = ae[covid_mask].copy()
    print('COVID AE rows:', len(covid))
    covid_subjects = set(covid['USUBJID'])
    print('Unique subjects with a COVID AE:', len(covid_subjects))
    no_covid = dm[~dm['USUBJID'].isin(covid_subjects)]
    print('Unique subjects with NO COVID AE:', len(no_covid),
          '| by group:', dict(no_covid['patients_seen'].value_counts()))

    # ---- subject-level severity = max AEHS, join to treatment + stratum ----
    sub_sev = covid.groupby('USUBJID')['AEHS'].max().rename('AEHS_MAX').reset_index()
    sub = sub_sev.merge(dm[['USUBJID', 'TRTGRP', 'patients_seen']], on='USUBJID')
    sub['severity'] = np.where(sub['AEHS_MAX'] >= 3,
                               'mod_sev_3plus', 'mild_0to2')

    groups = ['1-50', '51-100', '>100']
    print('\nPer-subject COVID counts by stratum x treatment:')
    print(pd.crosstab(sub['patients_seen'], sub['TRTGRP']).reindex(groups))

    print('\n=== Pearson chi-square per patients_seen stratum ===')
    results = {}
    for g in groups:
        d = sub[sub['patients_seen'] == g].copy()
        tab = pd.crosstab(d['severity'], d['TRTGRP'])\
                .reindex(index=['mild_0to2', 'mod_sev_3plus'],
                         columns=['BCG', 'Placebo'], fill_value=0)
        chi2, p, dof, exp = chi2_contingency(tab, correction=False)
        # Fisher exact (two-sided) for sensitivity
        _, p_fish = fisher_exact(tab.values)
        results[g] = dict(n=len(d), chi2=chi2, p=p, dof=dof, exp=exp,
                          p_fisher=p_fish, table=tab)
        print(f'\nGroup {g}: n(subjects with COVID) = {len(d)}')
        print('  2x2 table (rows=severity, cols=TRTGRP):')
        print(tab)
        print('  Expected cell counts under H0:')
        exp_df = pd.DataFrame(exp, index=tab.index, columns=tab.columns).round(2)
        print(exp_df)
        print(f'  chi2 = {chi2:.3f} | dof = {dof} | p = {p:.4f} | '
              f'min expected = {exp.min():.2f} | Fisher p = {p_fish:.4f}  '
              f'-> {"*** SIGNIFICANT p<0.05 ***" if p < 0.05 else "not significant"}')

    sig = [g for g in groups if results[g]['p'] < 0.05]
    print('\nPatients-seen group(s) with chi-square p<0.05:', sig)
    print('ANSWER:', ', '.join(sig) if sig else 'none')

if __name__ == '__main__':
    main()
