#!/usr/bin/env python3
"""
Count non-reference exonic variants in CHIP genes across 86 samples.

Question: After filtering out reference variant calls and variants located in
intronic, intergenic, or UTR regions, how many non-reference exonic variants
remain in clonal hematopoiesis (CHIP) genes from the 86 samples analyzed?

Conventions (approved):
  - 86 sample files in data/CHIP_DP10_GQ20_PASS/ == the 86 samples.
  - non-reference = Zygosity in {'Heterozygous','Homozygous Variant'};
    'Reference' and NaN zygosity (no call) are excluded.
  - CHIP gene = ANY part of comma-split 'Gene Names' in the supplied 56-gene list.
  - PRIMARY exonic = strictly coding-effect Sequence Ontology terms:
        missense_variant, synonymous_variant, frameshift_variant,
        inframe_deletion, inframe_insertion.
    Excluded from exonic: intron_variant, 3_prime_UTR_variant,
    5_prime_UTR_variant, 5_prime_UTR_premature_start_codon_gain_variant,
    upstream_gene_variant, splice_region_variant.
  - SENSITIVITY count additionally retains splice_region_variant.
  - PRIMARY unit = non-reference variant occurrences per sample, summed over
    the 86 samples. Distinct-variant alternative = unique Chr:Pos|Ref/Alt
    across samples.
"""
import glob, re, json
from collections import Counter, OrderedDict
import pandas as pd

DATA_DIR = "data/CHIP_DP10_GQ20_PASS"
GENE_XLSX = "data/230214_Schenz_et_al_2022_CHIP_Genes.xlsx"
OUT_JSON = "analysis/results.json"
OUT_CSV = "analysis/per_sample_contributions.csv"
OUT_LOG = "analysis/audit.txt"

# 1) CHIP gene list (56 genes; row 0 is a gene symbol, not a header)
raw = pd.read_excel(GENE_XLSX, header=None)
chip_genes = set(str(x).strip() for x in raw[0].tolist())
assert len(chip_genes) == 56, f"expected 56 CHIP genes, got {len(chip_genes)}"

# 2) Exonic term sets
EXONIC_EXACT = {"missense_variant","synonymous_variant","frameshift_variant",
                "inframe_deletion","inframe_insertion"}
EXONIC_SPLICE_INCLUSIVE = EXONIC_EXACT | {"splice_region_variant"}

files = sorted(glob.glob(f"{DATA_DIR}/*.xlsx"))
assert len(files) == 86, f"expected 86 files, got {len(files)}"

# audit tallies across files
tally = Counter()          # reason -> rows
per_sample = []            # dicts per sample
var_occurrence_primary = 0 # primary unit: sample x variant occurrences
var_occurrence_splice = 0  # sensitivity unit (occ) incl splice
distinct_hits_primary = set()
distinct_hits_splice = set()

for f in files:
    label = re.search(r"CHIP_(.+)\.xlsx", f.split("/")[-1]).group(1)
    df = pd.read_excel(f, header=[0,1])
    df.columns = ["__".join(str(a).strip() for a in c) for c in df.columns]
    def col(t): return [c for c in df.columns if c.endswith("__"+t)][0]
    zcol  = col("Zygosity");      scol = col("Sequence Ontology (Combined)")
    gcol  = col("Gene Names");    dcol = col("Read Depths (DP)")

    z   = df[zcol].astype("string")
    so  = df[scol].astype("string").str.strip()
    gn  = df[gcol].fillna("")
    dp  = df[dcol]

    is_nonref = z.isin(["Heterozygous","Homozygous Variant"])
    is_ref    = z.eq("Reference")
    is_nocall = z.isna()

    # CHIP-gene membership per row (ANY part)
    chip_row = gn.apply(lambda g: any(p.strip() in chip_genes for p in str(g).split(",")))

    # strict-exonic rows
    exonic_row = so.isin(EXONIC_EXACT)
    # splice-inclusive rows
    exonic_splice_row = so.isin(EXONIC_SPLICE_INCLUSIVE)

    primary_rows  = (is_nonref & chip_row & exonic_row)
    splice_rows   = (is_nonref & chip_row & exonic_splice_row)

    n = len(df)
    tally["total_rows"] += n
    tally["reference"] += int(is_ref.sum())
    tally["no_call"] += int(is_nocall.sum())
    tally["nonref_nonchip"] += int((is_nonref & ~chip_row).sum())
    tally["nonref_chip_nonexonic"] += int((is_nonref & chip_row & ~exonic_splice_row).sum())
    tally["nonref_chip_splice_region"] += int((is_nonref & chip_row & so.eq("splice_region_variant")).sum())
    tally["primary_hit_rows"] += int(primary_rows.sum())
    tally["splice_inclusive_hit_rows"] += int(splice_rows.sum())

    # occurrence unit (rows)
    var_occurrence_primary += int(primary_rows.sum())
    var_occurrence_splice  += int(splice_rows.sum())

    # distinct unit: unique Chr:Pos + Ref/Alt across samples
    cp = df[col("Chr:Pos")].astype(str)
    ra = df[col("Ref/Alt")].astype(str)
    vkey = cp + "|" + ra
    distinct_hits_primary.update(vkey[primary_rows].tolist())
    distinct_hits_splice.update(vkey[splice_rows].tolist())

    hit_nr = df[is_nonref].groupby(so[is_nonref]).size()
    per_sample.append({
        "sample": label,
        "rows": n,
        "nonref_calls": int(is_nonref.sum()),
        "nonref_chip_exonic_primary": int(primary_rows.sum()),
        "nonref_chip_exonic_splice_inclusive": int(splice_rows.sum()),
    })

per_sample_df = pd.DataFrame(per_sample).sort_values("sample")
per_sample_df.to_csv(OUT_CSV, index=False)

# ---- Build audit text ----
lines = []
lines.append("AUDIT: non-reference exonic CHIP variants across 86 samples")
lines.append(f"CHIP gene list size: {len(chip_genes)}")
lines.append(f"Sample files analyzed: {len(files)} (labels unique: {per_sample_df['sample'].nunique()})")
lines.append("")
lines.append("ROW-LEVEL EXCLUSION BREAKDOWN (across all 86 files):")
for k in ["total_rows","reference","no_call","nonref_nonchip",
          "nonref_chip_nonexonic","nonref_chip_splice_region",
          "primary_hit_rows","splice_inclusive_hit_rows"]:
    lines.append(f"  {k}: {tally[k]}")
lines.append("")
lines.append("PRIMARY exonic terms (strictly coding, count only): "
             + ", ".join(sorted(EXONIC_EXACT)))
lines.append("Terms excluded from exonic (including splice region and UTR/intron/upstream).")
lines.append("")
lines.append(f"FINAL PRIMARY COUNT (occurrences summed over 86 samples): {var_occurrence_primary}")
lines.append(f"SENSITIVITY count (occurrences, splice_region incl.): {var_occurrence_splice}")
lines.append(f"Distinct variant count (unique Chr:Pos|Ref/Alt, primary def): {len(distinct_hits_primary)}")
lines.append(f"Distinct variant count (unique Chr:Pos|Ref/Alt, splice incl.): {len(distinct_hits_splice)}")
# per-sample distribution of the primary count
hits = per_sample_df["nonref_chip_exonic_primary"]
lines.append("")
lines.append("Per-sample primary-count distribution:")
lines.append(f"  samples with 0 hits: {(hits==0).sum()}")
lines.append(f"  min/max hits: {hits.min()} / {hits.max()}")
lines.append(f"  total primary occurrences (recompute): {hits.sum()}")
with open(OUT_LOG, "w") as fh:
    fh.write("\n".join(lines) + "\n")

results = {
  "n_samples": len(files),
  "n_chip_genes": len(chip_genes),
  "primary_count_occurrences": var_occurrence_primary,
  "sensitivity_count_occurrences_splice_inclusive": var_occurrence_splice,
  "distinct_variant_count_primary": len(distinct_hits_primary),
  "distinct_variant_count_splice_inclusive": len(distinct_hits_splice),
  "row_breakdown": dict(tally),
  "exonic_terms_primary": sorted(EXONIC_EXACT),
  "convention": ("Primary = non-reference (Zygosity in {Heterozygous, Homozygous Variant}) "
                 "strictly-coding exonic (SO in missense/synonymous/frameshift/inframe_del/inframe_ins) "
                 "in CHIP genes (ANY comma part in 56-gene list); unit = per-sample occurrences summed."),
}
with open(OUT_JSON, "w") as fh:
    json.dump(results, fh, indent=2)

print("\n".join(lines))
print("\nSaved:", OUT_JSON, OUT_CSV, OUT_LOG)
