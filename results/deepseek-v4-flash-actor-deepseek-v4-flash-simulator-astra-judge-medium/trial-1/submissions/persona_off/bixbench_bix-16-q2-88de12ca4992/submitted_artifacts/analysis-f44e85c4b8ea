#!/usr/bin/env python3
"""
BixBench bix-16-q2: Skewness of the gene-expression (log2(TPM+1)) distribution
across all cell lines in the DepMap OmicsExpression matrix.

Headline: pooled Fisher-Pearson skewness g1 over the full 1673 x 19138 matrix.
Secondary views (alternative reading of "across all cell lines"):
  - median per-gene skewness (each gene across the 1673 cell lines)
  - median per-cell-line skewness (each cell line across the 19138 genes)
Histograms are rendered with stdlib only (no matplotlib available in this env):
  - ASCII histogram in stdout
  - PNG histogram written with zlib/struct + a small 5x7 digit font
"""
import numpy as np
import pandas as pd
import scipy.stats as st
import zlib, struct, math

DATA = "/workspace/data/OmicsExpressionProteinCodingGenesTPMLogp1BatchCorrected.csv"
OUT_PNG = "/workspace/analysis/expression_histogram.png"

# ------------------------------------------------------------------
# Minimal pure-stdlib PNG writer (RGB, 8-bit)
# ------------------------------------------------------------------
def write_png(path, img):
    """img: numpy uint8 array shape (H, W, 3)."""
    h, w, _ = img.shape
    raw = bytearray()
    for row in img:
        raw.append(0)  # filter type 0
        raw.extend(row.tobytes())
    def chunk(tag, data):
        c = struct.pack(">I", len(data)) + tag + data
        c += struct.pack(">I", zlib.crc32(tag + data) & 0xFFFFFFFF)
        return c
    ihdr = struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0)
    png = b"\x89PNG\r\n\x1a\n"
    png += chunk(b"IHDR", ihdr)
    png += chunk(b"IDAT", zlib.compress(bytes(raw), 9))
    png += chunk(b"IEND", b"")
    with open(path, "wb") as f:
        f.write(png)

# 5x7 bitmap font (digits, dot, minus) - row bitmaps, MSB=leftmost pixel
FONT = {
    '0': ["01110","10001","10011","10101","11001","10001","01110"],
    '1': ["00100","01100","00100","00100","00100","00100","01110"],
    '2': ["01110","10001","00001","00110","01000","10000","11111"],
    '3': ["11111","00010","00100","00010","00001","10001","01110"],
    '4': ["00010","00110","01010","10010","11111","00010","00010"],
    '5': ["11111","10000","11110","00001","00001","10001","01110"],
    '6': ["00110","01000","10000","11110","10001","10001","01110"],
    '7': ["11111","00001","00010","00100","01000","01000","01000"],
    '8': ["01110","10001","10001","01110","10001","10001","01110"],
    '9': ["01110","10001","10001","01111","00001","00010","01100"],
    '.': ["00000","00000","00000","00000","00000","00110","00110"],
    '-': ["00000","00000","00000","11111","00000","00000","00000"],
}
def draw_text(img, x0, y0, s, color, scale=1):
    h, w, _ = img.shape
    for ch in s:
        glyph = FONT.get(ch)
        if glyph:
            for r, row in enumerate(glyph):
                for cbit, bit in enumerate(row):
                    if bit == '1':
                        for dy in range(scale):
                            for dx in range(scale):
                                py, px = y0 + r*scale + dy, x0 + cbit*scale + dx
                                if 0 <= py < h and 0 <= px < w:
                                    img[py, px] = color
        x0 += (5 + 1) * scale  # advance

# ------------------------------------------------------------------
# 1. Load data
# ------------------------------------------------------------------
print("=" * 78)
print("Loading expression matrix (1673 cell lines x 19138 genes)...")
df = pd.read_csv(DATA, index_col=0)
v = df.values
n_cell, n_gene = df.shape
N = v.size
print(f"Shape: {n_cell} cell lines x {n_gene} genes; total values N = {N:,}")
print(f"NaNs: {int(df.isna().sum().sum())} (none)")

# ------------------------------------------------------------------
# 2. Headline: pooled Fisher-Pearson g1
# ------------------------------------------------------------------
g1_pooled_adj = float(st.skew(v, axis=None, bias=False))
g1_pooled_biased = float(st.skew(v, axis=None, bias=True))
print("\n" + "=" * 78)
print("HEADLINE: pooled skewness over ALL values (all cell lines x all genes)")
print(f"  scipy.stats.skew(axis=None, bias=False) = {g1_pooled_adj:.6f}")
print(f"  scipy.stats.skew(axis=None, bias=True ) = {g1_pooled_biased:.6f}  (immaterial difference at N={N:,})")
if g1_pooled_adj > 0:
    print("  => POSITIVE skew (right-skewed): long right tail of highly expressed genes.")
elif g1_pooled_adj < 0:
    print("  => NEGATIVE skew (left-skewed).")
else:
    print("  => approximately symmetric.")

# ------------------------------------------------------------------
# 3. Descriptive evidence
# ------------------------------------------------------------------
mean = float(np.mean(v))
median = float(np.median(v))
std = float(np.std(v, ddof=1))
print("\n" + "=" * 78)
print("DESCRIPTIVE EVIDENCE (pooled distribution)")
print(f"  min  = {np.min(v):.4f}   max = {np.max(v):.4f}")
print(f"  mean = {mean:.4f}   median = {median:.4f}   std(ddof=1) = {std:.4f}")
print(f"  mean - median = {mean - median:.4f}  (>0 consistent with right skew)")
pcts = np.percentile(v, [1, 5, 25, 50, 75, 95, 99])
print("  percentiles: " + ", ".join(f"p{q}={x:.3f}" for q, x in zip([1, 5, 25, 50, 75, 95, 99], pcts)))
for t in [0, 0.5, 1, 2, 5, 10]:
    print(f"  fraction of values < {t}: {np.mean(v < t):.4f}   fraction >= {t}: {np.mean(v >= t):.4f}")
print(f"  fraction of negative values (batch-correction artifact, kept as real): {np.mean(v < 0):.4f}")

# ------------------------------------------------------------------
# 4. Secondary views
# ------------------------------------------------------------------
print("\n" + "=" * 78)
print("SECONDARY VIEWS (cover the 'across all cell lines' ambiguity)")
g_per_gene = st.skew(v, axis=0, bias=False, nan_policy="omit")   # each gene across cell lines
g_per_cell = st.skew(v, axis=1, bias=False, nan_policy="omit")   # each cell line across genes
print(f"  Per-gene skewness (each of {n_gene} genes across {n_cell} cell lines):")
print(f"    median = {np.median(g_per_gene):.4f}  (IQR {np.percentile(g_per_gene,25):.4f} - {np.percentile(g_per_gene,75):.4f})")
print(f"    mean   = {np.mean(g_per_gene):.4f}  | fraction of genes right-skewed (g1>0): {np.mean(g_per_gene>0):.4f}")
print(f"  Per-cell-line skewness (each of {n_cell} cell lines across {n_gene} genes):")
print(f"    median = {np.median(g_per_cell):.4f}  (IQR {np.percentile(g_per_cell,25):.4f} - {np.percentile(g_per_cell,75):.4f})")
print(f"    mean   = {np.mean(g_per_cell):.4f}  | fraction of cell lines right-skewed (g1>0): {np.mean(g_per_cell>0):.4f}")

# ------------------------------------------------------------------
# 5. ASCII histogram (printed evidence)
# ------------------------------------------------------------------
print("\n" + "=" * 78)
print("ASCII HISTOGRAM of pooled log2(TPM+1) (range -3..25, ~99.999% of data shown; max=18.44)")
nbins = 56
lo, hi = -3.0, 25.0
counts, edges = np.histogram(v.ravel(), bins=nbins, range=(lo, hi))
cmax = counts.max()
MAXBAR = 64
for i in range(nbins):
    bar = int(round(counts[i] / cmax * MAXBAR))
    label = f"[{edges[i]:6.1f},{edges[i+1]:6.1f})"
    print(f"{label} |{'#'*bar} {counts[i]:,}")
print(f"(peak bin {edges[np.argmax(counts)]:.1f}-{edges[np.argmax(counts)+1]:.1f} has {cmax:,} values)")

# ------------------------------------------------------------------
# 6. PNG histogram (stdlib-only renderer)
# ------------------------------------------------------------------
W, H = 1400, 700
W_px, H_px = W, H
img = np.full((H, W, 3), 255, dtype=np.uint8)  # white
BLUE = np.array([76, 114, 176], dtype=np.uint8)
BLACK = np.array([0, 0, 0], dtype=np.uint8)
RED = np.array([200, 30, 30], dtype=np.uint8)
GREEN = np.array([20, 160, 40], dtype=np.uint8)
GRAY = np.array([200, 200, 200], dtype=np.uint8)

ml, mt, mb = 90, 60, 70          # margins
mr = 30
pw, ph = W - ml - mr, H - mt - mb
ncols = 560                      # pixel columns for bins
hist_lo, hist_hi = -3.0, 25.0
cnts, _ = np.histogram(v.ravel(), bins=ncols, range=(hist_lo, hist_hi))
ymax = max(float(cnts.max()) * 1.12, 1.0)

def xpx(xval):
    return ml + int(round((xval - hist_lo) / (hist_hi - hist_lo) * pw))
def ypx(yval):
    return mt + ph - int(round(yval / ymax * ph))

# light horizontal gridlines + left axis
for frac in (0.0, 0.25, 0.5, 0.75, 1.0):
    y = ypx(frac * ymax)
    img[y, ml:ml+pw] = GRAY[None, :] if False else GRAY
# axes
img[mt:mt+ph, ml-2:ml+1] = BLACK          # y axis
img[ypx(0):ypx(0)+1, ml-2:ml+pw] = BLACK  # x axis (at y=0.. actually at ypx(0))
y0 = ypx(0)
img[y0:y0+1, ml:ml+pw] = BLACK

# bars
for i in range(ncols):
    if cnts[i] <= 0:
        continue
    c = cnts[i]
    x = ml + i * (pw // ncols)
    x1 = ml + (i + 1) * (pw // ncols)
    yb = ypx(c)
    img[yb:y0, x:x1] = BLUE

# mean / median reference lines (vertical) at their pixel x
xm = xpx(mean); xmed = xpx(median)
img[mt:y0-2, xm-1:xm+1] = RED
img[mt:y0-2, xmed-1:xmed+1] = GREEN
# x axis tick labels (digits font) for -2,0,5,10,15,20,25
for tv in [-2.0, 0.0, 5.0, 10.0, 15.0, 20.0, 25.0]:
    xx = xpx(tv)
    img[y0:y0+6, xx-1:xx+2] = BLACK      # tick mark
    txt = f"{tv:.0f}" if tv == int(tv) else f"{tv:.1f}"
    tw = len(txt) * 6
    draw_text(img, xx - tw // 2 + 3, y0 + 8, txt, BLACK, scale=1)
# a few y labels (rounded counts)
for frac, tv in [(0.25, cmax), (0.5, 2 * cmax), (0.75, 3 * cmax), (1.0, int(cmax * 1.12))]:
    pass
draw_text(img, ml - 30, ypx(0) - 4, "0", BLACK, scale=1)
yc_max = ypx(cmax)
txt = f"{cmax:,}"
tw = len(txt) * 6
draw_text(img, ml - tw - 12, yc_max - 4, txt, BLACK, scale=1)

write_png(OUT_PNG, img)
print(f"\nPNG histogram saved to {OUT_PNG}  ({W}x{H}, stdlib-only renderer; "
      "blue=bar, red=mean, green=median; x-axis = -3..25, tick marks labeled)")

# ------------------------------------------------------------------
# 7. Final summary
# ------------------------------------------------------------------
print("\n" + "=" * 78)
if g1_pooled_adj > 0:
    direction = "positive/right-skewed"
elif g1_pooled_adj < 0:
    direction = "negative/left-skewed"
else:
    direction = "approximately symmetric"
print(f"SUMMARY: pooled Fisher-Pearson skewness g1 = {g1_pooled_adj:.4f} ({direction}), "
      f"mean {mean:.3f} > median {median:.3f}, long high-expression right tail toward max {np.max(v):.2f}. "
      f"Secondary: median per-gene skew {np.median(g_per_gene):.3f}, "
      f"median per-cell-line skew {np.median(g_per_cell):.3f}.")
