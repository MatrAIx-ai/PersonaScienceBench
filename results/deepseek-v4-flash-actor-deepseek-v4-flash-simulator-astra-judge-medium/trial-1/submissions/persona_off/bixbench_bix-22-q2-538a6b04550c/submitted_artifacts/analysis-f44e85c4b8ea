#!/usr/bin/env python3
"""
BixBench bix-22-q2: Pearson correlation between gene length and mean CD4
expression for protein-coding genes.

Primary analysis (per approved plan):
  - CD4 samples: Sample_annotated celltype == 'CD4' (151 samples)
  - Protein-coding genes: strict gene_biotype == 'protein_coding' (19,942)
  - mean expression = mean of batch-corrected read counts across the 151 CD4 samples
  - Pearson r between Length (bp) and mean expression, keeping all-zero genes

Sensitivity variants (secondary):
  S1: mean(log2(count+1)) over CD4 samples
  S2: log2(mean(count)+1)
  S3: inclusive protein_coding (gene_biotype split on ';' containing 'protein_coding')
  S4: dropping all-zero-mean protein-coding genes on the raw-count metric
"""
import pandas as pd
import numpy as np
from scipy.stats import pearsonr

DATA = 'data/'

meta = pd.read_csv(DATA + 'GeneMetaInfo_Zenodo.csv', index_col=0)
counts = pd.read_csv(DATA + 'BatchCorrectedReadCounts_Zenodo.csv', index_col=0)
samp = pd.read_csv(DATA + 'Sample_annotated_Zenodo.csv')

# --- integrity checks (verified during inspection) ---
assert (counts.index == meta.index).all(), "count/meta row alignment broken"
assert counts.isnull().sum().sum() == 0 and meta.isnull().sum().sum() == 0
count_cols = set(counts.columns)
ann_cols = set(samp['sample'])
assert count_cols == ann_cols, "count columns vs annotation mismatch"

# --- CD4 sample identification ---
cd4 = samp.loc[samp['celltype'] == 'CD4', 'sample'].tolist()
n_cd4 = len(cd4)

# --- protein-coding gene identification ---
pc_strict = meta.index[meta['gene_biotype'] == 'protein_coding']            # 19,942
contains_pc = meta['gene_biotype'].str.split(';').apply(lambda x: 'protein_coding' in x)
pc_incl   = meta.index[contains_pc]                                          # 19,954

def compute(pc_ids, cd4_samples, transform=None, drop_zero=False):
    X = counts.loc[pc_ids, cd4_samples].astype(float)
    if transform == 'mean_log2':
        m = np.log2(X + 1.0).mean(axis=1)      # mean of log2(count+1)
    elif transform == 'log2_mean':
        m = np.log2(X.mean(axis=1) + 1.0)      # log2(mean+1)
    else:
        m = X.mean(axis=1)                     # raw batch-corrected counts
    if drop_zero:
        keep = m != 0
        m, L = m[keep], meta.loc[pc_ids, 'Length'].astype(float)[keep]
    else:
        L = meta.loc[pc_ids, 'Length'].astype(float)
    r, p = pearsonr(L.values, m.values)
    return r, p, len(m), (m == 0).sum()

# --- PRIMARY ---
r_primary, p_primary, n_primary, n_zero_primary = compute(pc_strict, cd4, transform=None, drop_zero=False)

# --- SENSITIVITIES ---
r_s1, p_s1, n_s1, _ = compute(pc_strict, cd4, transform='mean_log2', drop_zero=False)
r_s2, p_s2, n_s2, _ = compute(pc_strict, cd4, transform='log2_mean', drop_zero=False)
r_s3, p_s3, n_s3, _ = compute(pc_incl,   cd4, transform=None, drop_zero=False)
r_s4, p_s4, n_s4, _ = compute(pc_strict, cd4, transform=None, drop_zero=True)

print("=" * 62)
print("PRIMARY  : Pearson r = %.4f (p = %.3e)  n = %d protein-coding genes, %d CD4 samples"
      % (r_primary, p_primary, n_primary, n_cd4))
print("           (zero-mean genes kept: %d)" % n_zero_primary)
print("=" * 62)
print("SENSITIVITY (secondary, for context only):")
print("  S1 mean(log2(count+1))      : r = %.4f (p = %.3e, n = %d)" % (r_s1, p_s1, n_s1))
print("  S2 log2(mean+1)             : r = %.4f (p = %.3e, n = %d)" % (r_s2, p_s2, n_s2))
print("  S3 inclusive protein_coding : r = %.4f (p = %.3e, n = %d)" % (r_s3, p_s3, n_s3))
print("  S4 drop all-zero genes      : r = %.4f (p = %.3e, n = %d)" % (r_s4, p_s4, n_s4))
print("=" * 62)
print("PRIMARY ANSWER (4 sf): r = %.4f" % r_primary)
print("PRIMARY ANSWER (3 sf): r = %.3f" % r_primary)
