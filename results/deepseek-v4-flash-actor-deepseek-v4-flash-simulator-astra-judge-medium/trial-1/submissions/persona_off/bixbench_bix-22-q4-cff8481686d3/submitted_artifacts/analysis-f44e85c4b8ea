#!/usr/bin/env python3
"""
BixBench bix-22-q4: Pearson correlation between gene length and mean expression
for protein-coding genes in CD14 immune cells.

Data:
  - data/GeneMetaInfo_Zenodo.csv            : Geneid, Chr, Length, gene_biotype
  - data/BatchCorrectedReadCounts_Zenodo.csv: genes (rows) x samples (cols), batch-corrected
  - data/Sample_annotated_Zenodo.csv        : sample, samp, samtype, celltype, batch, sex

Primary (canonical, literal reading): Pearson corr(raw mean CD14 expression, raw Length).
Sensitivity variants (secondary evidence): log10(mean) vs log10(Length) [zero-mean dropped],
log10(mean+1) vs log10(Length) [all zero-mean kept].
"""
import pandas as pd, numpy as np
from scipy import stats

DATA = "data/"

# ---------- 1. Load ----------
meta  = pd.read_csv(DATA + "GeneMetaInfo_Zenodo.csv", index_col=0)
rc    = pd.read_csv(DATA + "BatchCorrectedReadCounts_Zenodo.csv", index_col=0)
ann   = pd.read_csv(DATA + "Sample_annotated_Zenodo.csv")

# ---------- 2. Alignment asserts ----------
assert (meta['Geneid'].values == rc.index.values).all(), "Gene row alignment FAILED"
assert rc.index.notna().all() and not rc.index.duplicated().any(), "rc index NA/dup"
assert set(rc.columns) == set(ann['sample']), "sample columns mismatch"
print(f"[align] genes in meta/rc: {len(meta)} (identical order: OK)")
print(f"[align] samples in rc/ann: {len(rc.columns)} (identical sets: OK)")

# ---------- 3. CD14 samples (celltype-based), assert name-based equivalence ----------
cd14_ann = ann.loc[ann['celltype'] == 'CD14', 'sample']
cd14_name = rc.columns[rc.columns.str.contains('CD14')]
assert set(cd14_ann) == set(cd14_name), "CD14 celltype vs name mismatch"
cd14_cols = list(cd14_ann)
print(f"[cd14] {len(cd14_cols)} CD14 samples; celltype==name selection identical: OK")

# ---------- 4. Protein-coding restriction ----------
pc = meta['gene_biotype'] == 'protein_coding'
print(f"[biotype] protein_coding (exact): {int(pc.sum())}")

# ---------- 5. Mean expression across CD14 samples ----------
cd14_mat = rc[cd14_cols].loc[meta[pc].index]            # pc genes x CD14 samples
mean_expr = cd14_mat.mean(axis=1)                       # per-gene mean across CD14
mean_expr.name = 'mean_expr'
length = meta.loc[meta[pc].index, 'Length']
length.name = 'Length'

df = pd.DataFrame({'Geneid': mean_expr.index, 'mean_expr': mean_expr.values,
                   'Length': length.values})
print(f"[stats] genes used: {len(df)}; mean_expr range [{df['mean_expr'].min():.4g},{df['mean_expr'].max():.4g}]; "
      f"Length range [{df['Length'].min()},{df['Length'].max()}]")
print(f"[stats] protein-coding genes with mean expression == 0: {(df['mean_expr']==0).sum()}")

# ---------- 6. Correlations ----------
# Primary: raw vs raw
r_raw = stats.pearsonr(df['Length'], df['mean_expr'])[0]

# Sensitivity A: log10(mean) vs log10(Length), drop zero-mean genes
dA = df[df['mean_expr'] > 0].copy()
r_log10 = stats.pearsonr(np.log10(dA['Length']), np.log10(dA['mean_expr']))[0]

# Sensitivity B: log10(mean+1) vs log10(Length), keep all genes
r_log10p1 = stats.pearsonr(np.log10(df['Length']), np.log10(df['mean_expr'] + 1))[0]

# Also report Spearman on raw as extra context (not part of question)
rho_raw = stats.spearmanr(df['Length'], df['mean_expr'])[0]

print("\n================ RESULTS ================")
print(f"PRIMARY  Pearson(Length, mean_expr)  [raw vs raw]         = {r_raw:.6f}")
print(f"SENS A   Pearson(log10 Length, log10 mean), zero-mean dropped (n={len(dA)}) = {r_log10:.6f}")
print(f"SENS B   Pearson(log10 Length, log10(mean+1)), all genes (n={len(df)}) = {r_log10p1:.6f}")
print(f"CONTEXT  Spearman(Length, mean_expr) [raw vs raw]         = {rho_raw:.6f}")
print(f"n (protein-coding genes, all CD14): {len(df)}")

# Sanity: correlation equals numpy covariance formula
cov = np.cov(df['Length'], df['mean_expr'])
r_check = cov[0,1]/np.sqrt(cov[0,0]*cov[1,1])
assert abs(r_check - r_raw) < 1e-12
print("\n[sanity] Pearson recomputed via covariance formula matches: OK")

df.to_csv("analysis_table.csv", index=False)
print("[out] analysis_table.csv written")
