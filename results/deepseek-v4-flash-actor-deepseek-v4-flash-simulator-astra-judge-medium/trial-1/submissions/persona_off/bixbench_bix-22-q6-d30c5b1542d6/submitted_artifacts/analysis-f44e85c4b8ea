import pandas as pd
import numpy as np
from scipy import stats

# ------------- Load inputs -------------
g    = pd.read_csv("data/GeneMetaInfo_Zenodo.csv")
expr = pd.read_csv("data/BatchCorrectedReadCounts_Zenodo.csv")
s    = pd.read_csv("data/Sample_annotated_Zenodo.csv")

# ------------- Step 1: restrict to protein-coding (exact) -------------
mask = (g['gene_biotype'] == "protein_coding").to_numpy()
n_pc = int(mask.sum())
print(f"Protein-coding genes (exact 'protein_coding'): {n_pc}")

# Aligned sample columns
sampcols = s['sample'].tolist()
assert expr.columns[1:].tolist() == sampcols
assert expr.iloc[:, 0].tolist() == g['Unnamed: 0'].tolist()

Length = g.loc[mask, 'Length'].to_numpy(dtype=float)
Counts = expr.loc[mask, sampcols].to_numpy(dtype=float)

# ------------- Step 2: per-gene expression = mean over samples of log2(count+1) -------------
expr_gene = np.log2(Counts + 1.0).mean(axis=1)

# ------------- Step 3: Pearson correlation between Length and expression -------------
r, p = stats.pearsonr(Length, expr_gene)
print(f"Pearson r  = {r:.6f}")
print(f"p-value    = {p:.3e}")
print(f"N genes    = {n_pc}")

# ------------- Persist evidence -------------
pd.DataFrame({
    "gene": g.loc[mask, 'Geneid'].to_numpy(),
    "length": Length,
    "mean_log2_count_plus_1": expr_gene,
}).to_csv("expression_length_protein_coding.csv", index=False)

with open("final_result.txt", "w") as fh:
    fh.write(f"pearson_r={r:.6f}\np_value={p:.3e}\nn_genes={n_pc}\ndefinition=mean_over_samples_of_log2(count+1)\n")
print("Saved: expression_length_protein_coding.csv, final_result.txt")
