def build_go_annotation(counts_index):
    idx = set(counts_index)
    ann, dropped = {}, []
    for go, syms in _MEM_SYM.items():
        ensgs = []
        for s in syms:
            e = SYM2ENSG.get(s)
            if e is None or e not in idx:
                dropped.append((go, s, e)); continue
            ensgs.append(e)
        ann[go] = sorted(set(ensgs))
    uniq = set(d for v in ann.values() for d in v)
    return ann, uniq, dropped

# ----------------------------------------------------------------------------
# 3. HYPERGEOMETRIC / FISHER GO-BP ENRICHMENT + DIRECTION ATTRIBUTION
# ----------------------------------------------------------------------------
def hypergeo_enrichment(de_genes, ann, universe):
    universe = list(universe); uni_set = set(universe); de_set = set(de_genes) & uni_set
    rows = []
    for go, members in ann.items():
        term = set(members) & uni_set
        a = len(de_set & term); b = len(term - de_set)
        c = len(de_set - term); d = len(uni_set - term - de_set)
        if a == 0:
            odds, p = 0.0, 1.0
        else:
            odds, p = stats.fisher_exact([[a, b], [c, d]], alternative='greater')
        rows.append({'GO': go, 'term': TERM_LABEL[go], 'n_term': len(term),
                     'n_de_in_term': a, 'odds': odds, 'pvalue': p,
                     'frac_de_in_term': a / max(len(term), 1)})
    df = pd.DataFrame(rows)
    df['padj'] = multipletests(df['pvalue'], method='fdr_bh')[1]
    return df.sort_values('pvalue')

def summarize_direction(direction, de_genes, ann, universe):
    df = hypergeo_enrichment(de_genes, ann, universe)
    sig = df[df['padj'] < 0.05]
    minp = sig['padj'].min() if len(sig) else None
    mean_neglog = (sig['pvalue'].apply(lambda p: -np.log10(max(p, 1e-300))).mean()
                   if len(sig) else 0.0)
    return {'direction': direction, 'n_DE': len(de_genes),
            'n_sig_metabolic_terms': len(sig),
            'min_padj_sig': None if minp is None else float(minp),
            'mean_neglog10_p_sig': float(mean_neglog),
            'significant_terms':
                sig[['GO','term','n_de_in_term','odds','padj']].to_dict('records'),
            'all_terms': df.to_dict('records')}

# ----------------------------------------------------------------------------
# 4. EDGER-PARADIGM CROSS-CHECK (common dispersion) -- robustness note
# ----------------------------------------------------------------------------
def edger_crosscheck(prim):
    res = prim['res']; meta = prim['meta']; norm = meta['norm']
    nA, nB = meta['nA'], meta['nB']
    muA = res['meanA'].values; muB = res['meanB'].values
    # common dispersion: maximize pooled NB LL over a gene subsample
    rng = np.random.default_rng(0)
    genes = res.index[rng.choice(len(res), size=min(4000, len(res)), replace=False)]
    colsA = [s for s in norm.columns if sample_group[s] == prim['groupA']]
    colsB = [s for s in norm.columns if sample_group[s] == prim['groupB']]
    kA = norm.loc[genes, colsA].values
    kB = norm.loc[genes, colsB].values
    mA = kA.mean(axis=1); mB = kB.mean(axis=1)
    def pool_ll(phi):
        ll = 0.0
        for m, K in ((mA, kA), (mB, kB)):
            for j in range(K.shape[1]):
                ll += nb_loglik_sum(K[:, j], m, phi)
        return -ll
    opt = optimize.minimize_scalar(pool_ll, bounds=(1e-4, 10.0), method='bounded')
    phi_c = opt.x
    se = np.sqrt((1 + phi_c * muA) / (nA * np.maximum(muA, 1e-6)) +
                 (1 + phi_c * muB) / (nB * np.maximum(muB, 1e-6))) / math.log(2)
    z = np.log2(np.maximum(muA, 1e-6) / np.maximum(muB, 1e-6)) / np.maximum(se, 1e-12)
    p = 2 * stats.norm.sf(np.abs(z)); padj = multipletests(p, method='fdr_bh')[1]
    out = res[['log2FC']].copy(); out['padj_common'] = padj
    up_c = list(out.index[(out['padj_common'] < 0.05) & (out['log2FC'] > 0.5)])
    down_c = list(out.index[(out['padj_common'] < 0.05) & (out['log2FC'] < -0.5)])
    return phi_c, up_c, down_c

