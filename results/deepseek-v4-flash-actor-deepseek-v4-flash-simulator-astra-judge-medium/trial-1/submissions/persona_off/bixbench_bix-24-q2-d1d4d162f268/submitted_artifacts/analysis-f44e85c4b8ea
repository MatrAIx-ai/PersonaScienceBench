# ----------------------------------------------------------------------------
# 1. DESeq2-PARADIGM DE IN PURE PYTHON
# ----------------------------------------------------------------------------
def estimate_size_factors(sub):
    """DESeq2 median-of-ratios size factors on a comparison subset."""
    vals = sub.values.astype(float)
    geo = np.exp(np.mean(np.log(np.clip(vals, 1e-9, None)), axis=1))
    pos = (vals > 0).all(axis=1) & (geo > 0)
    if pos.sum() < 50:
        pos = geo > 0
    geo = np.exp(np.mean(np.log(vals[pos]), axis=1))
    ratio = vals[pos] / geo[:, None]
    sf = np.median(ratio, axis=0)
    sf[sf <= 0] = 1.0
    return sf

def nb_loglik_sum(k, mu, phi):
    """Sum of NB-2 log-PMF over samples; Var = mu + phi*mu^2; alpha = 1/phi.
    Stable form using betaln."""
    a = 1.0 / phi
    k = np.asarray(k, float); mu = np.asarray(mu, float)
    out = np.empty_like(k)
    nz = k > 0
    out[~nz] = a * np.log(a / (mu[~nz] + a))
    kk, mm = k[nz], mu[nz]
    out[nz] = (-np.log(kk) - special.betaln(a, kk)
               + kk * np.log(mm / (mm + a)) + a * np.log(a / (mm + a)))
    return out.sum()

def mle_dispersion(k, grp):
    """Per-gene MLE dispersion given per-group sample means (bounded opt)."""
    mu_vec = np.empty_like(k, float)
    for g in np.unique(grp):
        mu_vec[grp == g] = k[grp == g].mean()
    f = lambda phi: (1e20 if phi <= 0 else -nb_loglik_sum(k, mu_vec, phi))
    res = optimize.minimize_scalar(f, bounds=(1e-6, 100.0), method='bounded',
                                   options={'xatol': 1e-10, 'maxiter': 200})
    return res.x

def deseq2_like_de(counts_df, groupA, groupB):
    """DESeq2-paradigm two-group DE on counts_df (genes x samples)."""
    cols = [s for s in counts_df.columns if sample_group[s] in (groupA, groupB)]
    sub = counts_df[cols].copy()
    grp = np.array([sample_group[s] for s in sub.columns])
    keep = sub.sum(axis=1) >= 10            # pre-filter
    sub = sub.loc[keep].copy()
    sf = estimate_size_factors(sub)          # normalization
    norm = sub.div(sf, axis=1)
    gA = grp == groupA
    nA, nB = int(gA.sum()), int((~gA).sum())
    mA = norm.loc[:, gA].mean(axis=1).values
    mB = norm.loc[:, ~gA].mean(axis=1).values
    baseMean = (sub.sum(axis=1)).values / (nA + nB)
    gvec = np.where(gA, 0, 1)
    K = norm.values
    phis_mle = np.array([mle_dispersion(K[i], gvec) for i in range(K.shape[0])])
    mu_mean = (mA + mB) / 2.0
    # dispersion-mean trend (lowess on log10 scale)
    ok = np.isfinite(np.log10(np.clip(phis_mle, 1e-8, None))) & np.isfinite(np.log10(mu_mean))
    trend_log = lowess(np.log10(np.clip(phis_mle, 1e-8, None))[ok],
                       np.log10(mu_mean[ok]), frac=0.4, it=3, return_sorted=False)
    log10tr = np.full(K.shape[0], np.nan)
    log10tr[ok] = trend_log
    med = np.nanmedian(np.log10(np.clip(phis_mle, 1e-8, None)))
    log10tr[~np.isfinite(log10tr)] = med
    phi_trend = 10.0 ** np.clip(log10tr, -8, 4)
    # empirical-Bayes-inspired shrinkage to trend (edgeR-style prior)
    dg = nA + nB - 2
    r = np.clip(phis_mle / phi_trend, 1e-6, 1e6)
    var_r = np.var(r[np.isfinite(r)])
    d0 = 100.0 if (var_r <= 0 or not np.isfinite(var_r)) else np.clip(2.0 / var_r, 1.0, 100.0)
    phi_shrunk = (d0 * phi_trend + dg * phis_mle) / (d0 + dg)
    # Wald test on log2FC with NB variance v = mu + phi*mu^2
    l2 = math.log(2.0); eps = 1e-6
    muA = np.maximum(mA, eps); muB = np.maximum(mB, eps)
    log2fc = np.log2(muA / muB)
    se = np.sqrt((1 + phi_shrunk * muA) / (nA * muA) +
                 (1 + phi_shrunk * muB) / (nB * muB)) / l2
    pval = 2.0 * stats.norm.sf(np.abs(log2fc / np.maximum(se, 1e-12)))
    padj = multipletests(pval, method='fdr_bh')[1]
    res = pd.DataFrame({'baseMean': baseMean, 'meanA': mA, 'meanB': mB,
                        'log2FC': log2fc, 'se': se, 'pvalue': pval, 'padj': padj,
                        'disp_mle': phis_mle, 'disp_trend': phi_trend,
                        'disp_shrunk': phi_shrunk}, index=sub.index)
    res = res.sort_values('padj')
    meta = {'sizeFactors': sf, 'nA': nA, 'nB': nB, 'd0': d0,
            'genes_tested': int(sub.shape[0]), 'norm': norm.loc[res.index]}
    return res, meta

def call_de(res, sign, fc_cut=0.5, padj_cut=0.05):
    return list(res.index[(res['padj'] < padj_cut) &
                          (np.sign(res['log2FC']) == sign) &
                          (np.abs(res['log2FC']) > fc_cut)])

def run_de(name, groupA, groupB):
    print(f"\n=== DE: {name} | {groupA} vs {groupB} ===")
    res, meta = deseq2_like_de(counts, groupA, groupB)
    up = call_de(res, 1); down = call_de(res, -1)
    print(f"genes tested (>=10 total in subset): {meta['genes_tested']}")
    print(f"size factors: {np.round(meta['sizeFactors'], 3).tolist()}")
    print(f"prior df d0 = {meta['d0']:.2f}")
    print(f"DE padj<0.05 & |log2FC|>0.5 : UP = {len(up)} , DOWN = {len(down)}")
    return {'name': name, 'groupA': groupA, 'groupB': groupB, 'res': res,
            'up': up, 'down': down, 'meta': meta}

