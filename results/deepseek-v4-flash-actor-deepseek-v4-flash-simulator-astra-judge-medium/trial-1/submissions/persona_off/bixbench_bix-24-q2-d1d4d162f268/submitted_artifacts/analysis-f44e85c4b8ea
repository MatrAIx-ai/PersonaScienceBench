results['sens_serumstarved'] = run_de('SENSITIVITY (serum-starved)',
                                      'CBD_IC50_Serum_starvation_16h',
                                      'DMSO_Serum_starvation')

ann, uniq_ann, dropped = build_go_annotation(counts.index)
print(f"\n[GO] annotated genes present in counts: {len(uniq_ann)}")
print(f"[GO] curated members dropped (ENSG absent): {len(dropped)}")

uni = set(results['primary']['res'].index)
print(f"[GO] enrichment universe (post-filter, primary) = {len(uni)}")

prim = results['primary']
up_sum = summarize_direction('UP', prim['up'], ann, uni)
down_sum = summarize_direction('DOWN', prim['down'], ann, uni)
results['primary']['up_summary'] = up_sum
results['primary']['down_summary'] = down_sum

print("\n=== ATTRIBUTION (primary CBD_IC50 vs DMSO) ===")
print(f"DE genes: UP = {len(prim['up'])} , DOWN = {len(prim['down'])} "
      f"(down/up ratio = {len(prim['down']) / max(len(prim['up']), 1):.2f})")
print(f"UP  : {up_sum['n_sig_metabolic_terms']:2d} significant metabolic GO-BP terms, "
      f"min padj = {up_sum['min_padj_sig']}, mean -log10p = {up_sum['mean_neglog10_p_sig']:.2f}")
print(f"DOWN: {down_sum['n_sig_metabolic_terms']:2d} significant metabolic GO-BP terms, "
      f"min padj = {down_sum['min_padj_sig']}, mean -log10p = {down_sum['mean_neglog10_p_sig']:.2f}")

metab_all = set().union(*ann.values()) & uni
metab_up = len(set(prim['up']) & metab_all)
metab_down = len(set(prim['down']) & metab_all)
print(f"annotated metabolic genes in universe: {len(metab_all)}")
print(f"  of these DE UP = {metab_up} ({metab_up / max(len(metab_all), 1) * 100:.1f}%) | "
      f"DE DOWN = {metab_down} ({metab_down / max(len(metab_all), 1) * 100:.1f}%)")

if (down_sum['n_sig_metabolic_terms'] > up_sum['n_sig_metabolic_terms']) or \
   (down_sum['n_sig_metabolic_terms'] == up_sum['n_sig_metabolic_terms'] and
        (down_sum['min_padj_sig'] or 1) < (up_sum['min_padj_sig'] or 1)):
    primary_dir = 'DOWN-regulation'
elif up_sum['n_sig_metabolic_terms'] > 0 or down_sum['n_sig_metabolic_terms'] > 0:
    primary_dir = 'UP-regulation'
else:
    primary_dir = 'indeterminate'
print(f"\nWITHIN CURATED METABOLIC GO-BP TERMS, the direction primarily driving "
      f"CBD metabolic effects: {primary_dir}")


# enrichment summaries for sensitivity comparisons (same metabolic GO-BP table)
for k in ['sens_untreated', 'sens_serumstarved']:
    r = results[k]
    u_uni = set(r['res'].index)
    for dr, genes in (('UP', r['up']), ('DOWN', r['down'])):
        s = summarize_direction(dr, genes, ann, u_uni)
        r[dr.lower() + '_summary'] = s
    print(f"[{r['name']}] UP sig metabolic terms = "
          f"{r['up_summary']['n_sig_metabolic_terms']} | "
          f"DOWN sig metabolic terms = {r['down_summary']['n_sig_metabolic_terms']}")
    sigd = r['down_summary']['significant_terms']
    if sigd:
        print('   DOWN significant terms:', [(t['term'], round(t['padj'],6)) for t in sigd])

print("\n=== SENSITIVITY DE direction split ===")

for k in ['sens_untreated', 'sens_serumstarved']:
    r = results[k]
    print(f"{r['name']:35s} UP={len(r['up']):4d}  DOWN={len(r['down']):4d}")

print("\n=== EDGER-PARADIGM CROSS-CHECK (common dispersion) ===")
phi_c, up_c, down_c = edger_crosscheck(prim)
jac_u = len(set(up_c) & set(prim['up'])) / max(len(set(up_c) | set(prim['up'])), 1)
jac_d = len(set(down_c) & set(prim['down'])) / max(len(set(down_c) | set(prim['down'])), 1)
print(f"common dispersion = {phi_c:.4f}")
print(f"common-disp DE: UP={len(up_c)} DOWN={len(down_c)}")
print(f"Jaccard vs primary (up) = {jac_u:.3f} | (down) = {jac_d:.3f}")

print("\n=== TOP METABOLIC-ANNOTATED GENES (primary) ===")
mres = prim['res'].loc[sorted(metab_all)].sort_values('log2FC')
print("top DOWN-regulated metabolic genes (log2FC | padj):")
print(mres[mres['log2FC'] < -0.5].sort_values('log2FC').head(18)[['log2FC', 'padj']].round(3).to_string())
print("top UP-regulated metabolic genes (log2FC | padj):")
print(mres[mres['log2FC'] > 0.5].sort_values('log2FC', ascending=False).head(8)[['log2FC', 'padj']].round(3).to_string())

prim['res'].to_csv('results_primary_DE.csv')
pd.DataFrame(up_sum['significant_terms']).to_csv('results_enrichment_UP.csv', index=False)
pd.DataFrame(down_sum['significant_terms']).to_csv('results_enrichment_DOWN.csv', index=False)
summary_json = {'n_up': len(prim['up']), 'n_down': len(prim['down']),
                'up_sig_terms': up_sum['n_sig_metabolic_terms'],
                'down_sig_terms': down_sum['n_sig_metabolic_terms'],
                'metabolic_up_de': metab_up, 'metabolic_down_de': metab_down,
                'conclusion_direction': primary_dir}
json.dump(summary_json, open('results_summary.json', 'w'), indent=2)
print("\n[Saved] results_primary_DE.csv, results_enrichment_UP.csv, "
      "results_enrichment_DOWN.csv, results_summary.json")
print("DONE")
