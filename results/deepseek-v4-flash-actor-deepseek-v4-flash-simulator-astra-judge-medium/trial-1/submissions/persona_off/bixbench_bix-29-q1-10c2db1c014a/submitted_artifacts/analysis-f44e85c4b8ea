"""
BCG-CORONA (TASK008): Ordinal-regression effect of BCG vaccination on COVID-19 severity.
Primary model: proportional-odds ordinal logistic regression
    severity ~ BCG + prior_medical_history_count + interaction_frequency + (history x frequency interaction)
Primary quantity: exp(beta_BCG) with 95% CI (Placebo = reference arm).
Approved primary definitions (researcher-fixed):
  Outcome  : 4 categories over full 1,000-subject cohort:
             0 = no COVID-19 AE; 1 = WHO 1-2 (asymptomatic-COVID mapped to 1);
             2 = WHO 3-5; 3 = WHO 6-7; per-subject max over OnsetHS/AEWK1-12HS of COVID rows.
  Predictor: TRTGRP == "BCG", Placebo reference.
  Covariates: n_hist = # present conditions (MHORRES==2.0 in MHSCAT==MEDICAL HISTORY);
              interact_freq = midpoint(patients_seen) x I(expect_interact=='Yes');
              interaction = n_hist x interact_freq.
"""
import json
import warnings
warnings.filterwarnings("ignore")
import numpy as np
import pandas as pd
import statsmodels.api as sm
from statsmodels.miscmodels.ordinal_model import OrderedModel
from scipy import stats as sps

PD = "data/"

# ------------------------------------------------------------------ load
dm = pd.read_csv(PD + "TASK008_BCG-CORONA_DM.csv")
ae = pd.read_csv(PD + "TASK008_BCG-CORONA_AE.csv")
mh = pd.read_csv(PD + "TASK008_BCG-CORONA_MH.csv")

# ------------------------------------------------------------------ covariates
hist = mh[(mh.MHSCAT == "MEDICAL HISTORY") & (mh.MHORRES == 2.0)].groupby("USUBJID").size()
df = dm.merge(hist.rename("n_hist"), on="USUBJID", how="left")
df["n_hist"] = df["n_hist"].fillna(0).astype(int)

MIDPT = {"1-50": 25.5, "51-100": 75.5, ">100": 150.0}
df["interact_freq"] = df.patients_seen.map(MIDPT) * (df.expect_interact == "Yes").astype(int)
df["bcg"] = (df.TRTGRP == "BCG").astype(int)

# ------------------------------------------------------------------ outcome
def to_num(x):
    try:
        return float(str(x).replace("N_A", ""))
    except (ValueError, TypeError):
        return np.nan

hs_cols = ["OnsetHS"] + [f"AEWK{i}HS" for i in range(1, 13)]
cov = ae[ae.AEPT.str.contains("COVID", case=False, na=False)].copy()
for c in hs_cols:
    cov[c] = cov[c].apply(to_num)
cov["row_max_hs"] = cov[hs_cols].max(axis=1, skipna=True)
cov["covid_ae"] = 1
by_subj = cov.groupby("USUBJID").agg(max_hs=("row_max_hs", "max"), n_covid_ae=("covid_ae", "sum"))
df = df.merge(by_subj, on="USUBJID", how="left")
df["n_covid_ae"] = df["n_covid_ae"].fillna(0).astype(int)
df["has_covid"] = (df["n_covid_ae"] >= 1).astype(int)
df["max_hs"] = df["max_hs"].fillna(0.0)

# Primary 4-category WHO-based severity
df["sev4"] = np.select([df.has_covid == 0, df.max_hs <= 2, df.max_hs <= 5, df.max_hs <= 7],
                       [0, 1, 2, 3], default=0).astype(int)
# Sensitivities
df["sev3"] = np.select([df.has_covid == 0, df.max_hs <= 2], [0, 1], default=2).astype(int)
df["sev_raw"] = np.where(df.has_covid == 0, 0, np.maximum(df.max_hs, 1).astype(int))
df["sev4_maxHS"] = np.select([df.max_hs == 0, df.max_hs <= 2, df.max_hs <= 5, df.max_hs <= 7],
                             [0, 1, 2, 3], default=0).astype(int)
df["sev_inf3"] = np.where(df.max_hs <= 2, 1, np.where(df.max_hs <= 5, 2, 3)).astype(int)

results = {"n_subjects": int(len(df)), "primary": {}, "sensitivity": {}, "po_checks": {}}

# ------------------------------------------------------------------ fitting helper
def fit_ordered(outcome, formula_cols, desc, dframe=df, add_interaction=True):
    d = dframe[[outcome] + formula_cols].dropna()
    y = d[outcome].astype(int)
    X = d[formula_cols].copy()
    if add_interaction:
        X["hist_x_interact"] = X["n_hist"] * X["interact_freq"]
    mod = OrderedModel(y, X, distr="logit")
    res = mod.fit(method="bfgs", disp=0)
    beta, se, pv = res.params, res.bse, res.pvalues
    cutoffs = {k: float(v) for k, v in beta.items() if k not in X.columns}
    out = dict(desc=desc, n=int(len(d)),
               or_bcg=float(np.exp(beta["bcg"])),
               ci_bcg=(float(np.exp(beta["bcg"] - 1.96 * se["bcg"])),
                       float(np.exp(beta["bcg"] + 1.96 * se["bcg"]))),
               coef_bcg=float(beta["bcg"]), se_bcg=float(se["bcg"]), p_bcg=float(pv["bcg"]),
               coef_hist=float(beta["n_hist"]), p_hist=float(pv["n_hist"]),
               coef_freq=float(beta["interact_freq"]), p_freq=float(pv["interact_freq"]),
               llf=float(res.llf), cutoffs=cutoffs, categories=sorted(set(y)),
               converged=bool(res.mle_retvals.get("converged", False)))
    if add_interaction:
        out.update(coef_interact=float(beta["hist_x_interact"]), se_interact=float(se["hist_x_interact"]),
                   p_interact=float(pv["hist_x_interact"]),
                   ci_interact=(float(beta["hist_x_interact"] - 1.96 * se["hist_x_interact"]),
                                float(beta["hist_x_interact"] + 1.96 * se["hist_x_interact"])))
    return out

COLS = ["bcg", "n_hist", "interact_freq"]

# ------------------------------------------------------------------ PRIMARY MODEL
results["primary"] = fit_ordered("sev4", COLS, "PRIMARY: 4-cat WHO-consistent (0/WHO1-2/WHO3-5/WHO6-7)")
results["cells_primary_by_arm"] = pd.crosstab(df["TRTGRP"], df["sev4"]).to_dict()
results["cells_n_hist_by_arm"] = pd.crosstab(df["TRTGRP"], df["n_hist"]).to_dict()
results["cells_interact_freq"] = pd.crosstab(df["TRTGRP"], df["interact_freq"]).to_dict()

# ------------------------------------------------------------------ proportional odds checks
# (i) Brant-style: per-cutpoint binary logits; coefficients should be equal across cutpoints.
d = df[["sev4"] + COLS].dropna(); y = d["sev4"].astype(int); X = d[COLS].copy()
X["hist_x_interact"] = X["n_hist"] * X["interact_freq"]
cutpoints = sorted(set(y))[:-1]
per_cut = {}
bt = []
for j in cutpoints:
    z = (y > j).astype(int)
    r = sm.Logit(z, sm.add_constant(X)).fit(disp=0)
    per_cut[int(j)] = {k: float(v) for k, v in r.params.items()}
    bt.append((int(j), z.sum(), int(len(z) - z.sum()), bool(r.mle_retvals.get("converged", False))))
# Wald test on contrasts of coefficients across cutpoints (exclude cutpoint with <5 events)
keep = [j for j in cutpoints if ((y > j).sum() >= 5 and (y <= j).sum() >= 5)]
K = len(X.columns) + 1
bvec = np.concatenate([np.array([per_cut[j][c] for c in ["const"] + X.columns.tolist()]) for j in keep])
V = np.zeros((len(bvec), len(bvec)))
for i, j in enumerate(keep):
    r = sm.Logit((y > j).astype(int), sm.add_constant(X)).fit(disp=0)
    V[i*K:(i+1)*K, i*K:(i+1)*K] = r.cov_params().values
rows = []
for p in range(K):
    for i in range(len(keep) - 1):
        row = np.zeros(len(bvec)); row[i*K + p] = 1.0; row[(i+1)*K + p] = -1.0
        rows.append(row)
C = np.vstack(rows)
stat = float(bvec @ C.T @ np.linalg.inv(C @ V @ C.T) @ C @ bvec)
dof = len(rows)
results["po_checks"]["brant"] = dict(
    chi2=stat, df=dof, pvalue=float(1 - sps.chi2.cdf(stat, dof)),
    cutpoints_binary_n=bt, per_cutpoint_coefs={str(k): v for k, v in per_cut.items()},
    note="Brant-style Wald test over non-degenerate cutpoints (>5 events per side); top category has only 2 observations.")

# (ii) LR: proportional-odds vs unconstrained multinomial (informational; sparse top cell -> unreliable)
po = OrderedModel(y, X, distr="logit").fit(method="bfgs", disp=0)
ml = sm.MNLogit(y, sm.add_constant(X)).fit(method="bfgs", disp=0, maxiter=2000)
lr = 2 * (ml.llf - po.llf)
dof_lr = (y.nunique() - 2) * len(X.columns)
results["po_checks"]["lr_vs_multinomial"] = dict(
    lr_stat=float(lr), df=int(dof_lr), pvalue=float(1 - sps.chi2.cdf(lr, dof_lr)),
    multinomial_converged=bool(ml.mle_retvals.get("converged", False)),
    note="Sparse highest category (n=2) makes both PO checks unreliable; treat as diagnostic only.")

# ------------------------------------------------------------------ SENSITIVITY TABLE
sens = {}
sens["S1_3cat"] = fit_ordered("sev3", COLS, "3-category collapse (0 / WHO1-2 / WHO>=3), asym->1")
sens["S2_rawWHO"] = fit_ordered("sev_raw", COLS, "raw WHO 0-7 (WHO-consistent; 0 = no COVID)")
sens["S3_maxHS_asym0"] = fit_ordered("sev4_maxHS", COLS, "maxHS-based 4-cat (asymptomatic-COVID -> 0)")
sens["S4_infected_only"] = fit_ordered("sev_inf3", COLS, "infected-only 3-cat (n=194; interpret cautiously)",
                                       dframe=df[df.has_covid == 1].copy())
sens["S5_no_interaction"] = fit_ordered("sev4", ["bcg", "n_hist", "interact_freq"],
                                        "no interaction term (BCG + n_hist + freq)", add_interaction=False)
results["sensitivity"] = sens

# ------------------------------------------------------------------ write outputs
with open("analysis_results.json", "w") as f:
    json.dump(results, f, indent=2, default=str)
print(json.dumps(results, indent=2, default=str))
print("\nSaved analysis_results.json")
