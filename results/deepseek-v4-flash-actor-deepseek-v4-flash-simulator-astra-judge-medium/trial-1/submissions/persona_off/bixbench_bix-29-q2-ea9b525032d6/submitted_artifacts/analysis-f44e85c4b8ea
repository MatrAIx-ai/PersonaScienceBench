"""
TASK008 BCG-CORONA: independent effect of each additional ongoing medical
condition (MHONGO) on odds of higher COVID-19 severity.

Ordinal (proportional-odds cumulative logit) regression via
statsmodels.miscmodels.ordinal_model.OrderedModel.
"""
import numpy as np
import pandas as pd
import statsmodels.api as sm
from statsmodels.miscmodels.ordinal_model import OrderedModel

np.random.seed(42)

DM = pd.read_csv("data/TASK008_BCG-CORONA_DM.csv")
AE = pd.read_csv("data/TASK008_BCG-CORONA_AE.csv")
MH = pd.read_csv("data/TASK008_BCG-CORONA_MH.csv")

# ---------------- one-row-per-patient dataset ----------------
df = DM.copy()
df["BCG"] = (df["TRTGRP"] == "BCG").astype(int)
wh_map = {"1-40": 1, "41-80": 2, ">80": 3}
ps_map = {"1-50": 1, "51-100": 2, ">100": 3}
df["work_hours_o"] = df["work_hours"].map(wh_map).astype(float)
df["patients_seen_o"] = df["patients_seen"].map(ps_map).astype(float)
df["expect_interact_b"] = (df["expect_interact"] == "Yes").astype(int)

# n ongoing medical conditions: count MHONGO=='Yes' per patient
ongo = MH[(MH["MHONGO"] == "Yes")].groupby("USUBJID").size()
df["n_ongoing"] = df["USUBJID"].map(ongo).fillna(0).astype(int)

# Age bands -> ordinal 1..7 (10-19..70-79) ; keep SEX, education, RACE as is
age_order = ["10-19", "20-29", "30-39", "40-49", "50-59", "60-69", "70-79"]
df["Age_o"] = df["Age"].map({a: i + 1 for i, a in enumerate(age_order)}).astype(float)

# ---------------- severity outcomes ----------------
AE = AE.dropna(subset=["AEPT"])  # drop the 143 empty artifact rows
# (a) all-AE worst grade
mx_all = AE.groupby("USUBJID")["AESEV"].max()
df["sev_ALL"] = df["USUBJID"].map(mx_all).fillna(0).astype(int)
# (b) COVID-19 AE rows only
covid = AE[AE["AEPT"].str.upper().str.contains("COVID", na=False)]
mx_cov = covid.groupby("USUBJID")["AESEV"].max()
df["sev_COVID"] = df["USUBJID"].map(mx_cov).fillna(0).astype(int)
# (c) all-AE worst grade, only patients with any scored AE (exclude no-severity)
df["sev_ALL_1_4"] = np.where(df["sev_ALL"] > 0, df["sev_ALL"], np.nan)
# (d) COVID severity, only patients with a scored COVID AE
df["sev_COVID_1_4"] = np.where(df["sev_COVID"] > 0, df["sev_COVID"], np.nan)

print("=" * 78)
print("n=1000 patient dataset built. Severity level counts:")
for c in ["sev_ALL", "sev_COVID", "sev_ALL_1_4", "sev_COVID_1_4"]:
    vc = df[c].value_counts(dropna=False).sort_index()
    print(f"  {c:14s} n_nonmiss(patients with severity)={df[c].notna().sum():4d}")
    print("    " + vc.to_string().replace("\n", "\n    "))
print("n_ongoing distribution:", df["n_ongoing"].value_counts().sort_index().to_dict())

# ---------------- model fitting helpers ----------------
def fit_ordinal(data, y, xs, distr="logit", label=""):
    """Proportional-odds cumulative model; returns summary dict."""
    d = data.dropna(subset=[y]).copy()
    X = d[xs].astype(float)
    m = OrderedModel(d[y], X, distr=distr)
    r = m.fit(method="bfgs", maxiter=1000, disp=False)
    beta = r.params[xs[0]]
    se = r.bse[xs[0]]
    ci = r.conf_int().loc[xs[0]].values            # low, high
    or_ = np.exp([beta, ci[0], ci[1]])
    pct = (np.exp(beta) - 1) * 100
    pct_lo = (np.exp(ci[0]) - 1) * 100
    pct_hi = (np.exp(ci[1]) - 1) * 100
    # ---- direction / scaling check via predicted cumulative probs ----
    probe_rows = X.copy()
    # reference: lowest n_ongoing vs +3 conditions, all other X at median-ish mode
    ref = X.iloc[[0]].copy()
    for k in range(len(ref)):
        for col in xs:
            ref.iloc[k, X.columns.get_loc(col)] = float(X[col].median())
    ref.iloc[0, X.columns.get_loc(xs[0])] = 0.0
    refup = ref.copy()
    for k in range(len(refup)):
        refup.iloc[k, X.columns.get_loc(xs[0])] = 3.0
    pr0 = m.predict(r.params, exog=ref, which="cumprob")
    pr3 = m.predict(r.params, exog=refup, which="cumprob")
    # P(Y<=j) at n=0 vs n=3 -> higher severity if P(Y<=j) decreases
    direction_ok = bool(np.sum(pr0 > pr3) > len(pr0) / 2)
    return {
        "label": label, "distr": distr, "n": int(r.nobs),
        "beta": beta, "se": se, "ci": ci,
        "OR": or_[0], "OR_lo": or_[1], "OR_hi": or_[2],
        "pct": pct, "pct_lo": pct_lo, "pct_hi": pct_hi,
        "pvalue": float(r.pvalues[xs[0]]),
        "llf": float(r.llf), "direction_positive_is_higher_severity": direction_ok,
        "P(Y<=j)_probe_n0": pr0.tolist(), "P(Y<=j)_probe_n3": pr3.tolist(),
    }

CONTROLS = ["BCG", "work_hours_o", "patients_seen_o", "expect_interact_b"]
X_PRIMARY = ["n_ongoing"] + CONTROLS

# ---------------- primary & sensitivity models ----------------
results = []
# 0) unadjusted (for reference / effect-size context)
results.append(fit_ordinal(df, "sev_COVID", ["n_ongoing"], "logit", "P0 unadj COVID-19 severity"))
results.append(fit_ordinal(df, "sev_ALL",  ["n_ongoing"], "logit", "P0 unadj all-AE severity"))
# PRIMARY: COVID-19-specific severity, adjusted
results.append(fit_ordinal(df, "sev_COVID", X_PRIMARY, "logit", "PRIMARY adj COVID-19 severity"))
# lead sensitivity: all-AE worst grade, adjusted
results.append(fit_ordinal(df, "sev_ALL", X_PRIMARY, "logit", "S1 adj all-AE worst grade"))
# restrict to patients with any scored severity (1-4 ordinal only)
results.append(fit_ordinal(df, "sev_COVID_1_4", X_PRIMARY, "logit", "S2 adj COVID severity, cases only (1-4)"))
results.append(fit_ordinal(df, "sev_ALL_1_4", X_PRIMARY, "logit", "S3 adj all-AE severity, cases only (1-4)"))
# dummy coding of interaction category controls
dums = pd.concat([
    pd.get_dummies(df["work_hours"], prefix="wh", drop_first=True).astype(float),
    pd.get_dummies(df["patients_seen"], prefix="ps", drop_first=True).astype(float),
], axis=1)
df2 = pd.concat([df, dums], axis=1)
X_prim_dum = ["n_ongoing", "BCG", "expect_interact_b"] + list(dums.columns)
results.append(fit_ordinal(df2, "sev_COVID", X_prim_dum, "logit", "S4 adj COVID severity, dummy-coded interactions"))
# add demographics
X_demog = ["n_ongoing"] + CONTROLS + ["SEX", "Age_o", "education", "RACE"]
results.append(fit_ordinal(df, "sev_COVID", X_demog, "logit", "S5 adj COVID severity + demographics"))
# cumulative-probit link
results.append(fit_ordinal(df, "sev_COVID", X_PRIMARY, "probit", "S6 adj COVID severity, probit link"))
# no-severity patients -> excluded on ALL variant (equivalent to S3); and treat-as-0 already primary

print("=" * 78)
print(f"{'model':52s} {'n':>4s} {'beta':>8s} {'OR':>7s} {'(OR-1)*100%':>12s} {'95%CI low':>10s} {'95%CI hi':>10s} {'dirOK':>6s}")
for r in results:
    tag = " (probit: % not an OR)" if r["distr"] == "probit" else ""
    print(f"{r['label']:52s} {r['n']:4d} {r['beta']:8.4f} {r['OR']:7.3f} "
          f"{r['pct']:11.2f}% {r['pct_lo']:10.2f}% {r['pct_hi']:10.2f}% {str(r['direction_positive_is_higher_severity']):>6s}{tag}")

print("=" * 78)
print("FULL COEFFICIENT TABLE - PRIMARY MODEL (adj COVID-19 severity, cumulative logit)")
d = df.dropna(subset=["sev_COVID"]).copy()
X = d[X_PRIMARY].astype(float)
m = OrderedModel(d["sev_COVID"], X, distr="logit")
r = m.fit(method="bfgs", maxiter=1000, disp=False)
tab = pd.DataFrame({
    "coef": r.params, "se": r.bse,
    "z": r.tvalues, "p": r.pvalues,
})
conf = r.conf_int()
tab["lo"] = conf[0].values
tab["hi"] = conf[1].values
tab["exp(coef)"] = np.exp(r.params)
tab["(exp-1)*100%"] = (np.exp(r.params) - 1) * 100
print(tab.round(4).to_string())
print("n =", int(r.nobs), "| log-likelihood =", round(r.llf, 3))
cuts = m.transform_threshold_params(r.params)
print("Cumulative cutpoints (theta_j, increasing):", np.round(cuts, 4))

# ---------------- proportional-odds assumption (Brant-style) ----------------
print("=" * 78)
print("PROPORTIONAL-ODDS CHECK (PRIMARY): separate binary logits P(Y>j), n_ongoing coef per cutpoint")
for j in [0, 1, 2, 3]:
    yj = (d["sev_COVID"] > j).astype(float)
    Xj = d[X_PRIMARY].astype(float)
    bj = sm.Logit(yj, Xj).fit(disp=False)
    print(f"  cutpoint Y>{j}: n_ongoing beta={bj.params['n_ongoing']:.4f} "
          f"(se={bj.bse['n_ongoing']:.4f}, p={bj.pvalues['n_ongoing']:.4f})")

# ---------------- predicted probabilities direction check (primary) ----------------
print("=" * 78)
print("DIRECTION CHECK (PRIMARY): predicted P(Y<=j) for median-control patient, n_ongoing=0 vs 3")
probe = X.iloc[[0]].copy()
for col in X_PRIMARY:
    probe.iloc[0, X.columns.get_loc(col)] = float(X[col].median())
probe0 = probe.copy(); probe3 = probe.copy()
probe0.iloc[0, X.columns.get_loc("n_ongoing")] = 0.0
probe3.iloc[0, X.columns.get_loc("n_ongoing")] = 3.0
p0 = m.predict(r.params, exog=probe0, which="cumprob")[0]
p3 = m.predict(r.params, exog=probe3, which="cumprob")[0]
print("  severity levels:", sorted(d['sev_COVID'].unique()))
print("  P(Y<=j) @ n=0:", np.round(p0, 4))
print("  P(Y<=j) @ n=3:", np.round(p3, 4))
print("  -> increasing n_ongoing DECREASES P(Y<=j) = higher severity:", bool(np.all(p0[:-1] > p3[:-1])))

# ---------------- bootstrap CI for primary effect (robustness) ----------------
print("=" * 78)
print("BOOTSTRAP 95% CI for primary n_ongoing effect (500 resamples)")
from numpy.random import default_rng
rng = default_rng(123)
betas = []
for b in range(500):
    idx = rng.integers(0, len(d), size=len(d))
    db = d.iloc[idx]
    Xb = db[X_PRIMARY].astype(float)
    mb = OrderedModel(db["sev_COVID"], Xb, distr="logit")
    try:
        rb = mb.fit(method="bfgs", maxiter=500, disp=False)
        betas.append(rb.params["n_ongoing"])
    except Exception:
        pass
betas = np.array(betas)
bpct = (np.exp(betas) - 1) * 100
print(f"  bootstrap (OR-1)*100%: median={np.median(bpct):.2f}%  "
      f"95% CI=[{np.percentile(bpct, 2.5):.2f}, {np.percentile(bpct, 97.5):.2f}]%")

# ---------------- export results ----------------
pd.DataFrame([{k: (round(v, 4) if isinstance(v, float) else v)
               for k, v in r.items() if k not in ("P(Y<=j)_probe_n0", "P(Y<=j)_probe_n3")}
              for r in results]).to_csv("analysis/model_results.csv", index=False)
df.to_csv("analysis/patient_level_data.csv", index=False)
print("\nSaved: analysis/model_results.csv, analysis/patient_level_data.csv")
