#!/usr/bin/env python3
"""
TASK008 BCG-CORONA — Interaction of BCG vaccination status x prior medical history
on COVID-19 severity, controlling for patient interaction frequency.

Model: proportional-odds (cumulative-logit) ordinal regression
       statsmodels OrderedModel (distr='logit'; equivalent to R MASS::polr)
Specification: sev_covid ~ bcg + mh + bcg:mh + patients_seen

Definitions (primary):
  bcg      = TRTGRP == 'BCG'  (1/0)
  mh       = any endorsed (MHORRES==2.0) condition in MHSCAT=='MEDICAL HISTORY' (1/0)
  sev_covid= per-patient max AEHS over COVID-labeled AEs (AEPT contains 'COVID');
             0 = no COVID AE; 1/2/3 = AEHS 1/2/3; AEHS>=4 collapsed to 4.
  patients_seen = '1-50'->1, '51-100'->2, '>100'->3 (primary interaction-frequency control)
Interaction odds ratio = exp(beta_bcg:mh), Wald 95% CI, p-value.
"""
import numpy as np
import pandas as pd
import json
from statsmodels.miscmodels.ordinal_model import OrderedModel

np.set_printoptions(suppress=True)
pd.set_option('display.width', 200)

DATA = 'data'
RNG = 202

# ---------------------------------------------------------------- load -------
dm = pd.read_csv(f'{DATA}/TASK008_BCG-CORONA_DM.csv')
ae = pd.read_csv(f'{DATA}/TASK008_BCG-CORONA_AE.csv')
mh = pd.read_csv(f'{DATA}/TASK008_BCG-CORONA_MH.csv')

# ---------------------------------------------------- construct variables ----
df = dm.copy().set_index('USUBJID')
df['bcg'] = (df['TRTGRP'] == 'BCG').astype(int)

# COVID-labeled AEs
covid = ae[ae['AEPT'].str.contains('COVID', case=False, na=False)].copy()
covid['AEHS'] = pd.to_numeric(covid['AEHS'], errors='coerce')
mxhs = covid.groupby('USUBJID')['AEHS'].max()          # per-patient max health score
sev = mxhs.reindex(df.index).fillna(0).astype(int)      # 0 = no COVID AE
df['sev8'] = sev
df['sev5'] = sev.where(sev <= 3, 4)                     # collapse >=4 -> 4
df['sev6'] = sev.where(sev <= 4, 5)                     # collapse >=5 -> 5

# AESEV-based severity (sensitivity): 0 = no COVID AE, 1-4 = max AESEV
mxse = pd.to_numeric(covid['AESEV'], errors='coerce').groupby(covid['USUBJID']).max()
df['sev_aev'] = mxse.reindex(df.index).fillna(0).astype(int)

# Prior medical history: any endorsed (MHORRES==2.0) condition in MEDICAL HISTORY
med = mh[(mh['MHSCAT'] == 'MEDICAL HISTORY') & (mh['MHORRES'] == 2.0)]
df['mh'] = df.index.isin(set(med['USUBJID'])).astype(int)

# Restricted high-risk comorbidity set (sensitivity)
risk_terms = ['Hypertension','Diabetes Mellitus','Cardiovascular disease','Cerebrovascular disease',
              'Chronic Obstructive Pulmonary Disease','Other lung disease','Kidney disease','Liver disease',
              'Cancer','Asthma','Tuberculosis','Primary immunodeficiency','Neutropenia or lymphopenia',
              'Organ or bone marrow transplantation']
restricted = med[med['MHTERM'].isin(risk_terms)]
df['mh_risk'] = df.index.isin(set(restricted['USUBJID'])).astype(int)

# Interaction-frequency controls
df['patients_seen_n'] = df['patients_seen'].map({'1-50': 1, '51-100': 2, '>100': 3}).astype(int)
df['work_hours_n'] = df['work_hours'].map({'1-40': 1, '41-80': 2, '>80': 3}).astype(int)
df['expect_interact'] = (df['expect_interact'] == 'Yes').astype(int)

print('=' * 78)
print('ANALYSIS FRAME SUMMARY  (n = %d)' % len(df))
print('=' * 78)
print('BCG:', df['bcg'].value_counts().sort_index().to_dict())
print('mh (any endorsed condition):', df['mh'].value_counts().sort_index().to_dict())
print('mh_risk (restricted high-risk set):', df['mh_risk'].value_counts().sort_index().to_dict())
print('sev5 (0-4) counts:', df['sev5'].value_counts().sort_index().to_dict())
print('sev8 (0-7) counts:', df['sev8'].value_counts().sort_index().to_dict())
print('patients_seen_n:', df['patients_seen_n'].value_counts().sort_index().to_dict())
print('work_hours_n:', df['work_hours_n'].value_counts().sort_index().to_dict())
print('expect_interact:', df['expect_interact'].value_counts().sort_index().to_dict())
print('crosstab BCG x sev5:\n', pd.crosstab(df['bcg'], df['sev5']))
print('crosstab mh x sev5:\n', pd.crosstab(df['mh'], df['sev5']))
print('crosstab patients_seen_n x sev5:\n', pd.crosstab(df['patients_seen_n'], df['sev5']))
print()

# ------------------------------------------------------------- model helper --
def fit_ordinal(endog, cov_cols, label):
    """Proportional-odds cumulative-logit via OrderedModel; returns OR + CI + p."""
    X = df[['bcg', 'mh']].copy()
    X['bcg:mh'] = X['bcg'] * X['mh']
    for c in cov_cols:
        X[c] = df[c].values
    cols = ['bcg', 'mh', 'bcg:mh'] + cov_cols
    mod = OrderedModel(df[endog], X[cols], distr='logit')
    res = mod.fit(method='bfgs', disp=False, maxiter=500)
    b = res.params['bcg:mh']; se = res.bse['bcg:mh']
    orr = float(np.exp(b)); lo = float(np.exp(b - 1.96*se)); hi = float(np.exp(b + 1.96*se))
    p = float(res.pvalues['bcg:mh'])
    n_levels = df[endog].nunique()
    return {'label': label, 'endog': endog, 'n': int(len(df)), 'levels': int(n_levels),
            'beta': float(b), 'se': float(se), 'or': orr, 'ci_lo': lo, 'ci_hi': hi,
            'p': p, 'llf': float(res.llf), 'cov_cols': cov_cols}

results = []

# -------- PRIMARY: sev_covid (0-4, AEHS) ~ bcg + mh + bcg:mh + patients_seen ---
primary = fit_ordinal('sev5', ['patients_seen_n'],
    'PRIMARY  sev5 ~ bcg + mh + bcg:mh + patients_seen')
results.append(primary)
print('=' * 78)
print('PRIMARY MODEL — interaction odds ratio')
print('=' * 78)
print(f"  sev_covid(0-4) ~ bcg + mh + bcg:mh + patients_seen   n={primary['n']}")
print(f"  Interaction OR = {primary['or']:.4f}  (95% CI {primary['ci_lo']:.4f} - {primary['ci_hi']:.4f})")
print(f"  beta = {primary['beta']:.4f} (SE {primary['se']:.4f}),  p = {primary['p']:.4f}")

# Full coefficient table for primary model
Xp = df[['bcg','mh']].copy(); Xp['bcg:mh'] = Xp['bcg']*Xp['mh']
Xp['patients_seen_n'] = df['patients_seen_n'].values
modp = OrderedModel(df['sev5'], Xp[['bcg','mh','bcg:mh','patients_seen_n']], distr='logit')
resp = modp.fit(method='bfgs', disp=False, maxiter=500)
print('\nPrimary model coefficient table (log-odds scale):')
tab = pd.DataFrame({'coef': resp.params, 'SE': resp.bse,
                    'OR': np.exp(resp.params), 'p': resp.pvalues})
print(tab.round(4).to_string())
print('\nThresholds (intercepts):', np.round([resp.params[k] for k in resp.params.index if '/' in k], 3))
print()

# ------------------------------------------------------------- sensitivities ---
print('=' * 78)
print('SENSITIVITY ANALYSES (interaction OR = exp(beta_bcg:mh))')
print('=' * 78)

# A: different interaction-frequency control (primary MH, severity 0-4)
for cols, lab in [
    ([],                         'no interaction-frequency covariate'),
    (['work_hours_n'],           'control = work_hours'),
    (['expect_interact'],        'control = expect_interact'),
    (['patients_seen_n', 'work_hours_n', 'expect_interact'], 'control = all three'),
]:
    r = fit_ordinal('sev5', cols, lab)
    results.append(r)
    print(f"  {lab:48s} OR={r['or']:.4f}  (95% CI {r['ci_lo']:.4f}-{r['ci_hi']:.4f})  p={r['p']:.4f}")

# B: severity collapse variants (primary MH + patients_seen control)
for out, lab in [
    ('sev5', 'severity 0-4 collapse (AEHS>=4 -> 4)'),
    ('sev6', 'severity 0-5 collapse (AEHS>=5 -> 5)'),
    ('sev8', 'severity 0-7 full scale (AEHS 0-7)'),
    ('sev_aev', 'severity 0-4 from AESEV (max)'),
]:
    r = fit_ordinal(out, ['patients_seen_n'], lab)
    results.append(r)
    print(f"  {lab:48s} OR={r['or']:.4f}  (95% CI {r['ci_lo']:.4f}-{r['ci_hi']:.4f})  p={r['p']:.4f}")

# C: restricted high-risk comorbidity MH definition (primary severity + patients_seen control)
df['mh'] = df['mh_risk']   # temporarily swap definition
r = fit_ordinal('sev5', ['patients_seen_n'],
    'restricted high-risk MH set (primary severity, patients_seen control)')
results.append(r)
print(f"  {r['label']:48s} OR={r['or']:.4f}  (95% CI {r['ci_lo']:.4f}-{r['ci_hi']:.4f})  p={r['p']:.4f}")
df['mh'] = df.index.isin(set(med['USUBJID'])).astype(int)   # restore

# D: restricted MH x each control
for cols, lab in [
    (['work_hours_n'], 'restricted MH + control = work_hours'),
    (['expect_interact'], 'restricted MH + control = expect_interact'),
]:
    df['mh'] = df['mh_risk']
    r = fit_ordinal('sev5', cols, lab)
    results.append(r); print(f"  {lab:48s} OR={r['or']:.4f}  (95% CI {r['ci_lo']:.4f}-{r['ci_hi']:.4f})  p={r['p']:.4f}")
    df['mh'] = df.index.isin(set(med['USUBJID'])).astype(int)

# --------------------------------------------------- proportional-odds check --
print('\n' + '=' * 78)
print('PROPORTIONAL-ODDS / DIAGNOSTIC CHECKS')
print('=' * 78)
# Brant-like check: fit binary logits at each threshold; compare slopes
from statsmodels.discrete.discrete_model import Logit
brant = []
for k in range(1, 4):
    y = (df['sev5'] > k).astype(int)
    X = df[['bcg','mh','patients_seen_n']].copy(); X['bcg:mh']=X['bcg']*X['mh']
    X = X[['bcg','mh','bcg:mh','patients_seen_n']]
    m = Logit(y, X).fit(disp=False, maxiter=500)
    brant.append({'threshold': f'>{k}', 'bcg:mh_beta': float(m.params['bcg:mh']),
                  'OR': float(np.exp(m.params['bcg:mh']))})
print('Binary cumulative logits at each threshold (informal PO check):')
for b in brant:
    print(f"  P(sev>{b['threshold']})  bcg:mh beta={b['bcg:mh_beta']:.3f}  OR={b['OR']:.3f}")
print('\nSparse high-severity cells (level counts):', df['sev5'].value_counts().sort_index().to_dict())

# ------------------------------------------------------------- save results ---
results_df = pd.DataFrame(results)
results_df.to_csv('analysis/ordinal_interaction_results.csv', index=False)
summary = {
    'primary': primary,
    'sensitivities': results[1:],
    'n': len(df),
    'brant_check': brant,
}
with open('analysis/ordinal_interaction_summary.json', 'w') as f:
    json.dump(summary, f, indent=2, default=float)

print('\nSaved: analysis/ordinal_interaction_results.csv, analysis/ordinal_interaction_summary.json')
print('\nPrimary interaction OR (headline): %.3f (95%% CI %.3f-%.3f, p=%.3f)' %
      (primary['or'], primary['ci_lo'], primary['ci_hi'], primary['p']))
