#!/usr/bin/env python3
"""
Differential-expression summary, Paroxetine 2017 RNA-seq deposition
===================================================================
QUESTION: "Using DESeq2 ... between final blood and baseline blood, dentate gyrus
and baseline blood, and dentate gyrus and final blood, how many genes are
differentially expressed across all comparisons?"

CAPSULE REALITY (verified):
  * R / DESeq2 is NOT provisioned (no R binary, no libR.so, no rpy2, no conda,
    no apt archives, no internet). An independent DESeq2 fit cannot be executed.
  * The only counts available are the NORMALIZED, non-integer matrix in the
    "NormCount" sheet (no raw integer htseq counts were deposited), so there is
    nothing DESeq2 could be pointed at for an independent fit.
  * The workbook DOES embed the authors' actual DESeq2 results
    ("DESeq, Comparison 1..9, exclude outliers" blocks).

STRUCTURE OF THE DEPOSITED DESEQ2 COMPARISONS (verified):
    The 9 comparisons are WITHIN-TISSUE, BETWEEN-RESPONSE-GROUP contrasts:
      C1: baseline_blood   Control vs good_responder
      C2: baseline_blood   Control vs bad_responder
      C3: baseline_blood   bad_responder  vs good_responder
      C4: dentate_gyrus    Control vs good_responder
      C5: dentate_gyrus    Control vs bad_responder
      C6: dentate_gyrus    bad_responder  vs good_responder
      C7: final_blood      Control vs good_responder
      C8: final_blood      Control vs bad_responder
      C9: final_blood      bad_responder  vs good_responder
    None of the 9 equals any of the three tissue-pair contrasts named in the
    question (final-vs-baseline blood, dentate-vs-baseline, dentate-vs-final);
    evidence: brain-marker genes (Snap25, Meg3) sit at DENTATE level on both
    sides only in C4-C6 (baseMean ~11k-30k), and at blood level in C1-C3/C7-C9.
    -> the three named contrasts are NOT computable from the capsule's data.

COMMITTED DESIGN / DEFINITION:
    We use the deposited DESeq2 statistics and the data's own canonical "DEG"
    flag (U/D = padj<=0.05 combined with the authors' fold-change criterion;
    the trailing "Comparison1..9" columns, identical to the per-comparison
    "DEG_median" columns).
    PRIMARY COUNT = UNION over all comparisons of genes flagged U/D:
        UNIQUE genes differentially expressed across all comparisons.
    Standard-threshold unions (padj<=0.05; padj<=0.05 & |log2FC|>=1) are also
    reported so the choice is explicit and auditable.
"""
import pandas as pd
import numpy as np

XLSX = "data/Data_deposition_RNAseq_Paroxetine_2017.xlsx"

# --------------------------------------------------------------------------
# 1) Sheets & structure validation
# --------------------------------------------------------------------------
msr = pd.read_excel(XLSX, sheet_name="Mapping_statistics", header=None)
ms = msr.iloc[1:].copy(); ms.columns = msr.iloc[0]
ms = ms[["Sample ID", "Response", "Tissue", "Code"]]
assert len(ms) == 90
assert (ms.groupby(["Tissue", "Response"]).size() == 10).all()

raw = pd.read_excel(XLSX, sheet_name="NormCount", header=None)
data = raw.iloc[4:].reset_index(drop=True)
gene = data.iloc[:, 1].astype(str)
n = len(gene)
assert gene.notna().all() and gene.nunique() == n
mat = data.iloc[:, 2:92].apply(pd.to_numeric, errors="coerce")
assert mat.shape == (n, 90) and mat.notna().all().all()
samples = raw.iloc[3, 2:92].tolist()
assert len(samples) == 90 and len(set(samples)) == 90

# brain-marker sanity (Snap25 dentate vs blood)
snap = mat.loc[gene.eq("Snap25")].iloc[0]
assert snap.iloc[30:60].mean() > 1000 and snap.iloc[[*range(0, 30), *range(60, 90)]].mean() < 100

# --------------------------------------------------------------------------
# 2) Extract 9 deposited DESeq2 blocks + canonical DEG columns
# --------------------------------------------------------------------------
padj = [pd.to_numeric(data.iloc[:, 98 + c * 9 + 6], errors="coerce") for c in range(9)]
lfc  = [pd.to_numeric(data.iloc[:, 98 + c * 9 + 4], errors="coerce") for c in range(9)]
canon = [data.iloc[:, 179 + c].isin(["U", "D"]) for c in range(9)]
for c in range(9):  # trailing == per-block median-basis DEG
    assert (canon[c].values == data.iloc[:, 98 + c * 9 + 8].isin(["U", "D"]).values).all()

tissue_of = ["baseline_blood"]*3 + ["dentate_gyrus"]*3 + ["final_blood"]*3
pair_of   = ["Control vs good_responder", "Control vs bad_responder",
             "bad_responder vs good_responder"] * 3

print("Per-comparison deposited DESeq2 summary (canonical DEG = authors' U/D flag):")
rows = []
for c in range(9):
    rows.append({"comp": f"C{c+1}", "tissue": tissue_of[c], "contrast": pair_of[c],
                 "n_DEG_flag": int(canon[c].sum()),
                 "n_padj<=0.05": int(padj[c].le(0.05).sum()),
                 "n_padj<=0.05&|lfc|>=1": int((padj[c].le(0.05) & lfc[c].abs().ge(1)).sum())})
tbl = pd.DataFrame(rows)
print(tbl.to_string(index=False))

# --------------------------------------------------------------------------
# 3) PRIMARY: union of canonical DEG flags across all comparisons
# --------------------------------------------------------------------------
union_canon = set()
for c in range(9):
    union_canon |= set(gene[canon[c].values])
print("\n=== PRIMARY ANSWER ===")
print(f"Unique genes differentially expressed across all comparisons "
      f"(canonical deposited DEG flags, union of C1..C9): {len(union_canon)}")
print(f"(for reference) sum of per-comparison DEG flags:      {int(sum(c.sum() for c in canon))}")

# standard-threshold alternatives (explicit fixed definitions)
def union(cond): 
    s = set()
    for c in range(9): s |= set(gene[cond[c].values])
    return len(s)
print("\n=== Alternative explicit fixed DEG definitions (union over C1..C9) ===")
print("padj <= 0.05              :", union([p.le(0.05) for p in padj]))
print("padj <= 0.05 & |lfc| >= 1 :", union([(p.le(0.05) & l.abs().ge(1)) for p, l in zip(padj, lfc)]))
print("padj <= 0.05 & |lfc| >= .5:", union([(p.le(0.05) & l.abs().ge(0.5)) for p, l in zip(padj, lfc)]))
print("max-basis DEG flags (union) :", len(set().union(*[set(gene[data.iloc[:,98+c*9+7].isin(['U','D']).values]) for c in range(9)])))

pd.DataFrame({"answer_unique_genes_DE_across_all_comparisons": [len(union_canon)]}).to_csv(
    "deseq_result_summary.csv", index=False)
print("\nResults written to deseq_result_summary.csv")
