#!/usr/bin/env python3
"""
BixBench bix-3-q5 — Differential expression across three tissue comparisons
(Final vs Baseline Blood; Dentate gyrus vs Baseline blood; Dentate gyrus vs Final blood)
with a binomial exact test (alpha = 0.05) on up/down DEG counts.

Input : data/Data_deposition_RNAseq_Paroxetine_2017.xlsx
        - 'Mapping_statistics': 90 samples (3 tissues x 30; Control/good/bad responder x10)
        - 'NormCount': 25402 genes x 90 normalized-count columns + DESeq summary blocks
Since R/DESeq2 is not available, a DESeq2-style per-gene negative-binomial Wald test
(dispersion estimated by method-of-moments, floored at the median; BH correction) is
implemented in numpy/scipy.
"""
import numpy as np, pandas as pd
from scipy import stats
from scipy.stats import binomtest
from statsmodels.stats.multitest import multipletests

XLSX = "data/Data_deposition_RNAseq_Paroxetine_2017.xlsx"
xl = pd.ExcelFile(XLSX)

# ---------------------------------------------------------------- 1. Parse sheets
ms = xl.parse("Mapping_statistics", header=0)
nc = xl.parse("NormCount", header=None)
body = nc.iloc[4:].reset_index(drop=True)                 # 25402 gene rows
counts = body.iloc[:, 2:92].apply(pd.to_numeric, errors="coerce")
counts.columns = [str(c) for c in nc.iloc[3, 2:92]]
genes = body.iloc[:, 1].astype(str).values
Y = counts.round().values

print("=== INPUT SUMMARY ===")
print(f"Sheets: {xl.sheet_names}")
print(f"Mapping_statistics rows (samples): {len(ms)} ; columns: {list(ms.columns)[:12]}")
print(f"Tissue x Response counts:\n{ms.groupby(['Tissue','Response']).size().to_string()}")
print(f"NormCount: {len(body)} genes x {counts.shape[1]} samples (+ DESeq blocks)")

def grp(pat): return [counts.columns.get_loc(c) for c in counts.columns if pat in c]

# ---------------------------------------------------------------- 2. DE engine
def nb_wald_deseq2like(Y, idxA, idxB, min_mean=10):
    """Per-gene negative-binomial Wald test (DESeq2-like).
    log(mu_i)=b0+b1*x ; Var = mu + alpha*mu^2 ; per-gene alpha floored at median."""
    nA, nB = len(idxA), len(idxB)
    a, b = Y[:, idxA].astype(float), Y[:, idxB].astype(float)
    muA, muB = a.mean(1), b.mean(1)
    mu = (a.sum(1) + b.sum(1)) / (nA + nB)
    yall = np.hstack([a, b])
    m, v = yall.mean(1), yall.var(1, ddof=1)
    with np.errstate(all="ignore"):
        d = (v - m) / (m ** 2)
    d = np.clip(np.nan_to_num(d, nan=1e-8), 1e-8, 1e3)
    dmed = np.median(d[mu >= min_mean]) if np.any(mu >= min_mean) else 0.3
    alpha = np.maximum(d, dmed)                     # per-gene dispersion
    keep = mu >= min_mean
    alpha_eff = np.where(keep, alpha, 1.0)
    wA = muA / (1 + alpha_eff * muA); wB = muB / (1 + alpha_eff * muB)
    xbar = nB / (nA + nB)
    info = wA * xbar ** 2 * nA + wB * (1 - xbar) ** 2 * nB   # information for b1
    with np.errstate(all="ignore"):
        b1 = np.log(muA) - np.log(muB)
        z = b1 / np.sqrt(1.0 / info)
        p = 2 * stats.norm.sf(np.abs(z))
    p = np.nan_to_num(p, nan=1.0); p[~keep] = 1.0
    l2fc = np.full(Y.shape[0], np.nan)
    with np.errstate(all="ignore"):
        l2fc[keep] = np.log2(muA[keep] / muB[keep])
    return l2fc, p, mu, alpha

COMP = {
    "Final vs Baseline Blood":              (grp("final_blood"),   grp("baseline_blood")),
    "Dentate gyrus vs Baseline blood":       (grp("dentate_gyrus"), grp("baseline_blood")),
    "Dentate gyrus vs Final blood":          (grp("dentate_gyrus"), grp("final_blood")),
}

res = {}
for name, (iA, iB) in COMP.items():
    l2fc, p, mu, alpha = nb_wald_deseq2like(Y, iA, iB)
    padj = np.nan_to_num(multipletests(p, method="fdr_bh")[1], nan=1.0)
    res[name] = dict(l2fc=l2fc, p=p, padj=padj, nA=len(iA), nB=len(iB), alpha=alpha)

def deg_counts(r, fc_req):
    l2fc, padj = r["l2fc"], r["padj"]
    if fc_req:
        up = (padj < 0.05) & (l2fc >= fc_req); dn = (padj < 0.05) & (l2fc <= -fc_req)
    else:
        up = (padj < 0.05) & (l2fc > 0); dn = (padj < 0.05) & (l2fc < 0)
    return int(up.sum()), int(dn.sum())

# ---------------------------------------------------------------- 3/4. Results + binomial test
print("\n=== DIFFERENTIAL EXPRESSION + BINOMIAL EXACT TEST (alpha=0.05) ===")
hdr = f"{'Comparison':32s} {'DEGdef':14s} {'UP':>5s} {'DOWN':>6s} {'TOT':>6s} {'up%':>6s} {'binomial p':>11s} {'sig@5%':>7s}"
print(hdr); print("-" * len(hdr))
summary = []
for name, r in res.items():
    for label, fcreq in [("padj<0.05", None), ("padj<0.05 & |l2fc|>=1", 1.0)]:
        u, d = deg_counts(r, fcreq); t = u + d
        bp = binomtest(min(u, d), t, 0.5, alternative="two-sided").pvalue if t else np.nan
        sig = "YES" if (np.isfinite(bp) and bp < 0.05) else "no"
        print(f"{name:32s} {label:14s} {u:5d} {d:6d} {t:6d} {u/t*100 if t else 0:5.1f}% {bp:11.4g} {sig:7s}")
        summary.append(dict(comparison=name, deg_def=label, up=u, down=d, total=t,
                            up_pct=round(u/t*100, 1) if t else np.nan,
                            binomial_p=bp, significant_imbalance=sig))

# effect-size distributions for padj<0.05 genes
print("\n=== EFFECT-SIZE OF padj<0.05 GENES ===")
for name, r in res.items():
    sig = r["padj"] < 0.05
    av = np.abs(r["l2fc"][sig & np.isfinite(r["l2fc"])])
    print(f"{name:32s}: n={int(sig.sum()):6d}  median|l2fc|={np.median(av):.2f}  "
          f"max|l2fc|={np.max(r['l2fc'][sig]) if np.isfinite(np.nanmax(r['l2fc'][sig])) else 'inf'}")

# ------------------------------------------------- 5. Conclusion (primary = padj<0.05)
print("\n=== ADJUDICATION (primary DEG definition: padj<0.05) ===")
for name in COMP:
    u, d = deg_counts(res[name], None)
    bp = binomtest(min(u, d), u + d, 0.5, alternative="two-sided").pvalue
    print(f"{name:32s}: UP={u}, DOWN={d}, binomial p={bp:.4g} -> "
          f"{'significant imbalance' if bp<0.05 else 'NO significant imbalance (negligible direction effect)'}")

# ------------------------------------------------- 6. Robustness: control-only pooling
print("\n=== ROBUSTNESS: CONTROL-ONLY POOLING (10 vs 10) ===")
ccomp = {
    "Final vs Baseline Blood":        (grp("Control_final_blood"),   grp("Control_baseline_blood")),
    "Dentate vs Baseline blood":       (grp("Control_dentate_gyrus"), grp("Control_baseline_blood")),
    "Dentate vs Final blood":          (grp("Control_dentate_gyrus"), grp("Control_final_blood")),
}
for name, (iA, iB) in ccomp.items():
    l2fc, p, mu, alpha = nb_wald_deseq2like(Y, iA, iB)
    padj = np.nan_to_num(multipletests(p, method="fdr_bh")[1], nan=1.0)
    u, d = int(((padj<0.05)&(l2fc>0)).sum()), int(((padj<0.05)&(l2fc<0)).sum()); t=u+d
    bp = binomtest(min(u,d), t, 0.5, alternative="two-sided").pvalue if t else np.nan
    u1, d1 = (int(((padj<0.05)&(l2fc>=1)).sum()), int(((padj<0.05)&(l2fc<=-1)).sum()))
    print(f"{name:32s} (control only): padj DEG UP={u} DOWN={d} tot={t} (bin p={bp:.4g}); "
          f"|l2fc|>=1: UP={u1} DOWN={d1} tot={u1+d1}")

# ------------------------------------------------- 7. Save tables
pd.DataFrame(summary).to_csv("deg_binomial_results.csv", index=False)
print("\nSaved deg_binomial_results.csv")

# Final answer
print("\nFINAL ANSWER: Final vs Baseline Blood")
