"""
BixBench bix-30-q1 — What percentage of miRNAs show significant differential
expression between patient and control groups before multiple testing correction?

Data: data/pone.0150501.s002.xls (PLoS ONE Table S1)
  - single BIFF8 worksheet "RAW DATA"
  - row 0: title; row 1: headers P_1..P_10 (patients), C_11..C_20 (controls)
  - rows 2..176: 175 miRNA names + 20 mean-of-triplicate Ct values each

Because the environment has no xlrd/network and liboffice is non-functional, the
legacy .xls is parsed with a dependency-free OLE2 + BIFF8 reader (ole2.py/biff8.py).

Primary test (pre-registered): per-miRNA unpaired two-sample WELCH t-test on RAW
Ct values (patient P_1..P_10 vs control C_11..C_20), observed non-missing values
only (pairwise complete). Denominator for the percentage = all 175 assayed miRNAs.
Significance: p < 0.05, uncorrected (no multiple-testing adjustment).
Sensitivity: (a) Wilcoxon rank-sum; (b) denominator = 161 fully-observed rows;
           (c) imputation of blank cells as Ct=40 (no amplification).
"""
import os, struct
import numpy as np
import pandas as pd
from scipy import stats

# ---------- 1. Parse the legacy .xls (dependency-free) ----------
sys = __import__('sys')
sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from ole2 import OLE2
from biff8 import parse_workbook

with open('/workspace/data/pone.0150501.s002.xls', 'rb') as f:
    raw = f.read()
ole = OLE2(raw)
wb_entry = ole.find_stream('Workbook')
assert wb_entry is not None, 'Workbook stream not found'
stream = ole.read_stream(wb_entry['start'], wb_entry['size'])
sheets = parse_workbook(stream)
assert len(sheets) == 1, 'expected exactly one worksheet, got %d' % len(sheets)
sh = sheets[0]

# ---------- 2. Build the data matrix ----------
mr, mc = sh.rows_max, sh.cols_max
grid = [[sh.cells.get((r, c), '') for c in range(mc)] for r in range(mr)]
df = pd.DataFrame(grid, dtype=object)
title = str(df.iloc[0, 0])
headers = [str(v) for v in df.iloc[1, 1:21]]
miRNAs = [str(v) for v in df.iloc[2:177, 0]]
mat = df.iloc[2:177, 1:21].apply(pd.to_numeric, errors='coerce').astype(float)
mat.index = miRNAs
mat.columns = headers

P_cols = list(range(0, 10))            # P_1..P_10 -> patients
C_cols = list(range(10, 20))           # C_11..C_20 -> controls

n_rows, n_cols = mat.shape
n_nan = int(mat.isna().sum().sum())
rows_any_nan = int(mat.isna().any(axis=1).sum())
rows_complete = int((~mat.isna().any(axis=1)).sum())

# ---------- 3. Primary analysis: Welch t-test per miRNA on observed Ct ----------
welch_p = {}
for mi in mat.index:
    p = mat.loc[mi, headers[:10]].dropna().values
    c = mat.loc[mi, headers[10:20]].dropna().values
    welch_p[mi] = stats.ttest_ind(p, c, equal_var=False, nan_policy='omit').pvalue
welch_series = pd.Series(welch_p)

wilcox_p = {}
for mi in mat.index:
    p = mat.loc[mi, headers[:10]].dropna().values
    c = mat.loc[mi, headers[10:20]].dropna().values
    wilcox_p[mi] = stats.mannwhitneyu(p, c, alternative='two-sided').pvalue
wilcox_series = pd.Series(wilcox_p)

# ---------- primary result ----------
n_welch_sig = int((welch_series < 0.05).sum())
denom = n_rows
pct = n_welch_sig / denom * 100.0

# ---------- 4. Sensitivity checks ----------
# (a) Wilcoxon counts
n_wilcox_sig = int((wilcox_series < 0.05).sum())
pct_wilcox = n_wilcox_sig / denom * 100.0

# (b) denominator = fully-observed rows only (161)
complete_mask = ~mat.isna().any(axis=1)
mat_complete = mat.loc[complete_mask]
w_sig_complete = int((welch_series.loc[complete_mask] < 0.05).sum())
denom_complete = int(complete_mask.sum())
pct_complete_denom = w_sig_complete / denom_complete * 100.0

# (c) imputation of blanks as Ct=40
mat_imp = mat.fillna(40.0)
w_imp = {}
for mi in mat_imp.index:
    p = mat_imp.loc[mi, headers[:10]].dropna().values
    c = mat_imp.loc[mi, headers[10:20]].dropna().values
    w_imp[mi] = stats.ttest_ind(p, c, equal_var=False).pvalue
w_imp_series = pd.Series(w_imp)
n_welch_imp = int((w_imp_series < 0.05).sum())
pct_imp = n_welch_imp / denom * 100.0

# ---------- 5. Report ----------
print('=' * 78)
print('INSPECTION SUMMARY')
print('=' * 78)
print('Title cell              :', title)
print('Sheet name              : RAW DATA (single worksheet)')
print('Matrix                  : %d miRNAs x %d samples' % (n_rows, n_cols))
print('Group columns           : P_1..P_10 (patients), C_11..C_20 (controls)')
print('NaN cells               : %d across %d rows; %d rows fully observed' % (n_nan, rows_any_nan, rows_complete))
print('Ct range                : %.2f - %.2f' % (np.nanmin(mat.values), np.nanmax(mat.values)))

print()
print('=' * 78)
print('PRIMARY RESULT  —  Welch t-test on RAW Ct values (patient vs control), uncorrected p<0.05')
print('=' * 78)
print('miRNAs with p < 0.05    : %d / %d' % (n_welch_sig, denom))
print('Percentage              : %.1f%%' % pct)
print('(denominator = all %d assayed miRNAs)' % denom)
print()
print('p-value distribution (Welch): min=%.4g median=%.3f max=%.3f' %
      (welch_series.min(), welch_series.median(), welch_series.max()))
print('counts: p<0.05=%d  p<0.01=%d  p<0.001=%d' %
      ((welch_series < 0.05).sum(), (welch_series < 0.01).sum(), (welch_series < 0.001).sum()))

print()
print('=' * 78)
print('SENSITIVITY CHECKS (for decision basis only)')
print('=' * 78)
print('(a) Wilcoxon rank-sum, denominator=175   : %d / %d = %.1f%%' % (n_wilcox_sig, denom, pct_wilcox))
print('(b) Welch, denominator=161 complete rows : %d / %d = %.1f%%' % (w_sig_complete, denom_complete, pct_complete_denom))
print('    Welch, same 161 rows, denominator175 : %d / 175 = %.1f%%' % (w_sig_complete, w_sig_complete/denom*100))
print('(c) Welch with blanks imputed as Ct=40   : %d / %d = %.1f%%' % (n_welch_imp, denom, pct_imp))

print()
print('=' * 78)
print('TOP 15 miRNAs by Welch p-value')
print('=' * 78)
top = welch_series.sort_values().head(15)
for mi, p in top.items():
    pp = mat.loc[mi, headers[:10]].dropna().values
    cc = mat.loc[mi, headers[10:20]].dropna().values
    print('%-14s Welch_p=%.4g  meanP=%.2f meanC=%.2f  dCt=%.2f' % (mi, p, pp.mean(), cc.mean(), cc.mean()-pp.mean()))

# save results for the record
res = pd.DataFrame({'miRNA': welch_series.index,
                    'welch_p': welch_series.values,
                    'wilcox_p': wilcox_series.values})
res.to_csv('/workspace/mirna_pvalues.tsv', sep='\t', index=False)
print('\nSaved per-miRNA results to /workspace/mirna_pvalues.tsv')
