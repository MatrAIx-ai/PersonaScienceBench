#!/usr/bin/env python3
"""
BixBench bix-32-q4 — KEGG ORA across three P. aeruginosa PA14 quorum-sensing
mutants (97, 98, 99) vs wildtype (strain 1), downregulated genes (p<0.05,
log2FoldChange<-1.5).

Pipeline
--------
1. Parse data/res_1vs97/98/99.rds (gzip-compressed R v3 XDR serialization of
   DESeqResults) in pure Python (no R/pyreadr available in this sandbox).
2. Downregulated set per strain.
3. KEGG 'pau' ORA: one-sided hypergeometric + Benjamini-Hochberg, padj<0.05,
   background = the 5828 detected genes (identical in all three files).
4. Intersect pathways enriched in all three strains.

CRITICAL TRANSPARENCY NOTE
--------------------------
This sandbox has NO network egress, NO R/Bioconductor and NO bundled KEGG/GMT
or .db pathway files. The KEGG 'pau' pathway->gene memberships used below are
therefore an OFFLINE RECONSTRUCTION assembled from documented KEGG pathway
composition, mapped to PA14 locus IDs and anchored to the loci that the DE data
itself identifies (flagellar cluster PA14_36470-36920 and che/mot clusters are
verified by contiguous co-downregulation; the two shared QS-regulon operons
PA14_55790-55940 and PA14_06720-06860 are assigned to KEGG maps 02024/02025 per
their documented membership). All adjusted p-values are APPROXIMATE.
"""
import gzip, struct
import numpy as np, pandas as pd
from scipy.stats import hypergeom

# ---------------- Step 1: parse the three DESeqResults files ----------------
COL_STARTS = [108666,155298,201930,248562,295194,341826]  # length-field offsets of the 6 REALSXP cols
NROWS, NAMES_HDR, COLNAMES_HDR = 5828, 84, 388462
COLNAMES = ['baseMean','log2FoldChange','lfcSE','stat','pvalue','padj']

def load_rds(path):
    with open(path,'rb') as fh: raw=fh.read()
    return gzip.decompress(raw)

def parse_strings_at(b,pos):
    L = struct.unpack('>I',b[pos+4:pos+8])[0]; q=pos+8; out=[]
    for _ in range(L):
        ln = struct.unpack('>I',b[q+4:q+8])[0]
        out.append(b[q+8:q+8+ln].decode()); q+=8+ln
    return out

def read_results(tag):
    b = load_rds(f'data/res_1vs{tag}.rds')
    gene = parse_strings_at(b, NAMES_HDR)
    cols = []
    for off in COL_STARTS:
        assert struct.unpack('>I',b[off-4:off])[0]==14
        cols.append(np.frombuffer(b[off+4:off+4+8*NROWS],dtype='>f8').astype('float64'))
    cnames = parse_strings_at(b, COLNAMES_HDR)
    assert cnames==COLNAMES
    return pd.DataFrame({c:cols[k] for k,c in enumerate(cnames)}, index=gene)

dfs = {t: read_results(t) for t in ['97','98','99']}
for t,df in dfs.items():
    df.to_pickle(f'data/res_{t}.pkl')
    v = (df['log2FoldChange']/df['lfcSE'] - df['stat']).abs().max()
    print(f'parsed strain {t}: {df.shape[0]} genes x {df.shape[1]} cols; stat==lfc/lfcSE max|diff|={v:.2e}')

# ---------------- Step 2: downregulated gene sets ---------------------------
down = {t: set(df[(df['pvalue']<0.05)&(df['log2FoldChange']<-1.5)].index)
        for t,df in dfs.items()}
for t in ['97','98','99']:
    print(f'strain {t} downregulated (p<0.05, lfc<-1.5): {len(down[t])} genes')

detected = set(dfs['97'].index)
assert detected==set(dfs['98'].index)==set(dfs['99'].index)
BG = len(detected)

# ---------------- Step 3: reconstructed KEGG 'pau' memberships --------------
def L(n): return f'PA14_{n:05d}'
def g(*ns): return {L(n) for n in ns}

PATHWAYS = {
 '02024 Quorum sensing [Cellular Processes]': g(
    45950,45960,45980,45990,45940,45970,
    55790,55800,55810,55820,55840,55850,55860,55880,55890,55900,55920,55930,55940),
 '02025 Biofilm formation - P. aeruginosa [Cellular Processes]': g(
    6720,6730,6740,6750,6770,6790,6800,6810,6830,6840,6860,
    45950,45960,45980,45990,36480,36500,36590,36620,36780,36790),
 '02030 Bacterial chemotaxis [Cellular Processes]': g(
    46360,46370,46380,46390,46400,46410,37610,37620,37630,36630,36710,36730),
 '02040 Flagellar assembly [Cellular Processes]': g(
    36480,36490,36500,36520,36530,36540,36550,36560,36570,36580,36590,36600,
    36610,36620,36630,36640,36650,36660,36670,36700,36710,36730,36740,36750,36760,
    36770,36780,36790,36800,36820,36830,36840,36900,36920),
 '02020 Two-component system [Signal transduction]': g(45960,45980,46380,46390,46400,36900,36920),
 '02026 Biofilm formation - E. coli [Cellular Processes]': g(
    45960,45980,6720,6730,6740,6750,6770,6790,6800,6810,6830,6840,6860),
 '00405 Phenazine biosynthesis [Metabolism]': g(
    55790,55800,55810,55820,55840,55850,55860,55880,55890,55900,55920,55930,55940),
 '03070 Bacterial secretion system [Genetic Info Processing]': g(53250,53290,53300,45940,45840),
}

# ---------------- Step 4: ORA (hypergeometric) + BH -------------------------
def ora_hp(set_genes, members, bg):
    return len(set_genes & members), len(members & detected)

names = list(PATHWAYS.keys()); npath = len(names)
out = {}
print(f'\nKEGG ORA; background = {BG} detected PA14 genes; memberships RECONSTRUCTED (approximate)')
print(f"{'pathway':46s} | " + " | ".join(f"{'ovlp/size p padj BH':>26s}" for _ in ['97','98','99']) + ' | all3<0.05')
print('-'*150)
pass3 = []
for name in names:
    members = PATHWAYS[name] & detected
    rows=[]; ps=[]
    for t in ['97','98','99']:
        K = len(down[t] & members); M = len(members)
        p = float(hypergeom.sf(K-1, BG, M, len(down[t]))) if K>0 else 1.0
        rows.append((K,M,p)); ps.append(p)
    # BH per strain over all 8 pathways
    padjs=[]
    for i in range(3):
        cols = sorted([(hypergeom.sf(len(down[st]&(PATHWAYS[n]&detected))-1, BG,
                      len(PATHWAYS[n]&detected), len(down[st])))[:1] if False else 0 for st in ['']] ) if False else None
    p_all = np.array([hypergeom.sf(len(down[t]&(PATHWAYS[n]&detected))-1, BG,
                     len(PATHWAYS[n]&detected), len(down[t])) if len(down[t]&(PATHWAYS[n]&detected))>0 else 1.0
                      for t in ['97','98','99'] for n in names]).reshape(3,len(names))
    padjs = []
    for i in range(3):
        pvec = p_all[i]
        order = np.argsort(pvec); padj = np.ones(len(pvec))
        running = 1.0
        for j in range(len(pvec)-1, -1, -1):
            idx = order[j]
            running = min(running, pvec[idx]*len(pvec)/(j+1))
            padj[idx] = running
        padjs.append(padj)
    ok = all(ps[i] < 0.05 and padjs[i][names.index(name)] < 0.05 for i in range(3))
    if ok: pass3.append(name)
    out[name] = rows
    print(f"{name:46s} | " + " | ".join(
        f"{rows[i][0]:4d}/{rows[i][1]:3d} {rows[i][2]:8.1e} {padjs[i][names.index(name)]:8.1e}" for i in range(3)) + f' | {"YES" if ok else "--"}')

print('\nEnriched (raw & BH-padj<0.05) in ALL three strains:', pass3)
print('Under KEGG Cellular Processes only:', [p for p in pass3 if '[Cellular Processes]' in p])
