#!/usr/bin/env python3
"""
BixBench bix-33-q1: Which immune cell type has the highest number of
significantly differentially expressed genes after AAV9 mini-dystrophin
treatment?

Authoritative input: 'Supplemental Data File 1 PostvsPre_DEG_tables_ANNOTATED
by_cell_type.xlsx' -- 25 sheets, one per cell type; each row = one tested gene
with columns [gene, p_val, avg_log2FC, pct.1, pct.2, p_val_adj]
(Post-treatment vs Pre-treatment within each cell type).

Significance: p_val_adj < 0.05 (standard), robust to an additional
|avg_log2FC| > 0.25 effect-size filter.

Immune cell types = all leukocyte lineages (B, CD4/8 T, dnT, gdT, MAIT, Treg,
NK/NK CD56 bright, CD14/CD16 Monocyte, cDC2, pDC, ILC, Plasmablast).
Eryth, Platelet, HSPC are non-immune (0 significant DEGs -> non-consequential).
"""
import pandas as pd

XLSX = "data/Supplemental Data File 1 PostvsPre_DEG_tables_ANNOTATED by_cell_type.xlsx"

NON_IMMUNE = {"Eryth", "Platelet", "HSPC"}  # not leukocyte/immune lineages

def classify(cell_type: str) -> str:
    return "immune" if cell_type not in NON_IMMUNE else "non-immune"

df = pd.read_excel(XLSX, sheet_name=None)
records = []
for ct, d in df.items():
    d = d.copy()
    d.columns = ["gene", "p_val", "avg_log2FC", "pct.1", "pct.2", "p_val_adj"]
    n_tested = len(d)
    n_padj = int((d["p_val_adj"] < 0.05).sum())
    n_padj_l2fc = int(((d["p_val_adj"] < 0.05) & (d["avg_log2FC"].abs() > 0.25)).sum())
    records.append({
        "cell_type": ct, "category": classify(ct),
        "genes_tested": n_tested,
        "sig_padj_lt_0.05": n_padj,
        "sig_padj_lt_0.05_and_abslog2FC_gt_0.25": n_padj_l2fc,
    })

res = pd.DataFrame(records)
res = res.sort_values(["category", "sig_padj_lt_0.05"], ascending=[True, False]).reset_index(drop=True)
print("=" * 100)
print("Per-cell-type Post-vs-Pre significant DEG counts")
print("=" * 100)
print(res.to_string(index=False))

immune = res[res["category"] == "immune"]
top_immune = immune.sort_values("sig_padj_lt_0.05", ascending=False).iloc[0]
print("\n" + "=" * 100)
print("FINAL RESULT")
print("=" * 100)
print(f"Highest-significant-DEG immune cell type: {top_immune['cell_type']}")
print(f"Number of significant DEGs (p_val_adj < 0.05): "
      f"{top_immune['sig_padj_lt_0.05']}")
print(f"(same with |avg_log2FC| > 0.25 filter: "
      f"{top_immune['sig_padj_lt_0.05_and_abslog2FC_gt_0.25']})")
print(f"Runner-up immune: "
      f"{immune.sort_values('sig_padj_lt_0.05', ascending=False).iloc[1]['cell_type']} "
      f"({immune.sort_values('sig_padj_lt_0.05', ascending=False).iloc[1]['sig_padj_lt_0.05']})")

res.to_csv("analysis/per_celltype_sigDEG_counts.csv", index=False)
print("\nSaved: analysis/per_celltype_sigDEG_counts.csv")
