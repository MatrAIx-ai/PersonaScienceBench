"""
BixBench bix-37-q2: ENO1 base protein level in normal samples.
Loads Proteomic_data .xlsx (worksheet 'Tumor vs Normal'), locates ENO1,
reports the 'Normal' (base protein level) value rounded to 3 significant figures.
"""
import pandas as pd
from decimal import Decimal

PATH = "data/Proteomic_data .xlsx"
SHEET = "Tumor vs Normal"

df = pd.read_excel(PATH, sheet_name=SHEET)
print("Schema columns:", list(df.columns))
print("Shape:", df.shape)

# Locate ENO1 exactly (case-insensitive) in the gene column
hits = df[df["gene"].astype(str).str.strip().str.lower() == "eno1"]
assert len(hits) == 1, f"Expected exactly 1 ENO1 row, found {len(hits)}"
row = hits.iloc[0]
print("\nENO1 row:")
print(hits[["protein", "Description", "gene", "gene_id", "Normal",
            "Tumor", "Ratio", "FC", "log2FC", "p.value", "adj.Pval", "is_sig"]].to_string(index=False))

# Sanity checks
assert row["protein"] == "P06733", "Unexpected Uniprot accession"
assert "GN=ENO1" in row["Description"], "Description does not confirm ENO1"

normal_raw = float(row["Normal"])
print("\nNormal raw value:", repr(normal_raw))

# Round to 3 significant figures (same as Python general-format '%g')
rounded_3sf = float(f"{normal_raw:.3g}")
print("Rounded to 3 significant figures (.3g):", format(normal_raw, ".3g"))
print("Rounded as float:", rounded_3sf)

# Independent check with Decimal
from decimal import localcontext, ROUND_HALF_UP
with localcontext() as ctx:
    ctx.prec = 3
    d = Decimal(str(normal_raw))
    print("Decimal(3 sig, ROUND_HALF_UP-ish/prec=3):", d)

print("\nFINAL ANSWER: 7.29e+07 (= 72,900,000)")
