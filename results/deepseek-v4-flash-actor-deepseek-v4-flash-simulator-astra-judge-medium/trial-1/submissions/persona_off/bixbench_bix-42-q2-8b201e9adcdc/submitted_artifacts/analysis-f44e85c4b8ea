#!/usr/bin/env python3
"""
BixBench bix-42-q2: Classify the skewness of the distribution of RNA expression data.

Input : data/COAD__geneExp.xls (tab-delimited; 20502 genes x 328 TCGA samples; raw non-log scale)
Output: skewness metrics on the pooled gene x sample distribution, per-gene layer, and
        log2/sqrt sensitivity; classification + PNG figures as evidence (histogram + Q-Q)
        rendered with a dependency-free PNG writer (zlib/struct stdlib only).

Classification convention (moment coefficient g1, Fisher-Pearson sample-corrected):
    g1 >  1              -> highly right-skewed
    0.5 <= g1 <= 1       -> minimally/moderately right-skewed
   -0.5 <  g1 < 0.5      -> approximately normal
   -1 <= g1 <= -0.5      -> minimally/moderately left-skewed
    g1 < -1              -> highly left-skewed
"""
import zlib, struct, json
import numpy as np
import pandas as pd
from scipy import stats

DATA = "data/COAD__geneExp.xls"
OUT_HIST = "expression_histogram.png"
OUT_QQ = "expression_qq.png"

# ---------------- dependency-free PNG writer (24-bit RGB) ----------------
def write_png(path, width, height, pix):
    """pix: list of rows, each a list of (r,g,b) tuples, top-to-bottom."""
    def chunk(typ, data):
        c = struct.pack(">I", len(data)) + typ + data
        c += struct.pack(">I", zlib.crc32(typ + data) & 0xffffffff)
        return c
    raw = bytearray()
    for y in range(height):
        raw.append(0)  # filter type 0
        for x in range(width):
            raw += bytes(pix[y][x])
    png = b"\x89PNG\r\n\x1a\n"
    png += chunk(b"IHDR", struct.pack(">IIBBBBB", width, height, 8, 2, 0, 0, 0))
    png += chunk(b"IDAT", zlib.compress(bytes(raw), 6))
    png += chunk(b"IEND", b"")
    with open(path, "wb") as f:
        f.write(png)

def canvas(W, H, bg=(255, 255, 255)):
    return [[bg for _ in range(W)] for _ in range(H)]

def hline(img, y, x0, x1, color, w=1):
    yi = int(round(float(y)))
    for x in range(int(x0), int(x1) + 1):
        for k in range(-(w//2), w - w//2):
            yy = yi + k
            if 0 <= yy < len(img) and 0 <= x < len(img[0]):
                img[yy][x] = color

def vline(img, x, y0, y1, color, w=1):
    xi = int(round(float(x)))
    for y in range(int(y0), int(y1) + 1):
        for k in range(-(w//2), w - w//2):
            xx = xi + k
            if 0 <= y < len(img) and 0 <= xx < len(img[0]):
                img[y][xx] = color

def rect(img, x0, y0, x1, y1, color):
    for y in range(int(y0), int(y1) + 1):
        if not (0 <= y < len(img)): continue
        for x in range(int(x0), int(x1) + 1):
            if 0 <= x < len(img[0]):
                img[y][x] = color

def scatter(img, pts, color, radius=1):
    for (x, y) in pts:
        ix, iy = int(round(x)), int(round(y))
        for dy in range(-radius, radius + 1):
            for dx in range(-radius, radius + 1):
                if 0 <= ix+dx < len(img[0]) and 0 <= iy+dy < len(img):
                    img[iy+dy][ix+dx] = color

# ---------------- skewness metrics ----------------
def g1(x, sample=True):
    x = np.asarray(x, dtype=float); x = x[~np.isnan(x)]
    n = x.size
    if n == 0: return np.nan
    if x.std(ddof=0) == 0: return np.nan
    m2 = np.mean((x - x.mean()) ** 2); m3 = np.mean((x - x.mean()) ** 3)
    g = m3 / m2 ** 1.5
    if sample and n > 2:
        g = np.sqrt(n * (n - 1)) / (n - 2) * g
    return g

def medskew(x):
    x = np.asarray(x, dtype=float); x = x[~np.isnan(x)]
    sd = x.std(ddof=0)
    return np.nan if sd == 0 else 3 * (x.mean() - np.median(x)) / sd

def classify(g):
    if np.isnan(g): return "indeterminate"
    if g > 1: return "highly right-skewed"
    if g >= 0.5: return "minimally/moderately right-skewed"
    if g <= -0.5 and g > -1: return "minimally/moderately left-skewed"
    if g <= -1: return "highly left-skewed"
    return "approximately normal"

def fmt(x):
    return f"{x:.4g}"

# ---------------- figure routines ----------------
def save_hist(xs, mean, med, path):
    W, H, M = 960, 520, 40
    img = canvas(W, H)
    lo, hi = np.log10(xs.min()), np.log10(xs.max())
    bins = np.logspace(lo, hi, 100)
    counts, _ = np.histogram(xs, bins=bins)
    c_max = max(counts.max(), 1)
    bw = (W - 2*M) / len(bins)
    for i, c in enumerate(counts):
        if c <= 0: continue
        bh = (np.log10(c) / np.log10(c_max)) * (H - 2*M)
        rect(img, M + i*bw, H - M - bh, M + i*bw + max(bw-1, 1), H - M, (68, 114, 196))
    hline(img, H - M, M, W - M, (0, 0, 0), 2)
    vline(img, M, M, H - M, (0, 0, 0), 2)
    def xpx(v): return M + (np.log10(v) - lo) / (hi - lo) * (W - 2*M)
    vline(img, xpx(mean), M, H - M, (220, 20, 20), 2)
    vline(img, xpx(med), M, H - M, (34, 139, 34), 2)
    write_png(path, W, H, img)
    print(f"Saved {path}")

def save_qq(z_sample, path):
    n = len(z_sample)
    W, H, M = 520, 520, 40
    img = canvas(W, H)
    theo = stats.norm.ppf((np.arange(1, n + 1) - 0.5) / n)
    tmin, tmax = theo.min(), theo.max()
    q1, q3 = np.quantile(z_sample, 0.25), np.quantile(z_sample, 0.75)
    t1, t3 = stats.norm.ppf(0.25), stats.norm.ppf(0.75)
    slope = (q3 - q1) / (t3 - t1); inter = q1 - slope * t1
    ymax = min(z_sample.max(), inter + slope * tmax)
    ymin = max(0.0, inter + slope * tmin)
    def X(t): return M + (t - tmin) / (tmax - tmin) * (W - 2*M)
    def Y(z): return H - M - (z - ymin) / (ymax - ymin) * (H - 2*M)
    hline(img, Y(inter + slope*tmin), X(tmin), X(tmin), (0,0,0), 2)  # small anchor
    hline(img, Y(inter + slope*tmax), X(tmax), X(tmax), (0,0,0), 2)
    # reference line drawn as many short segments
    tt = np.linspace(tmin, tmax, 400)
    for a, b in zip(tt[:-1], tt[1:]):
        hline(img, Y(inter + slope*a), X(a), X(a), (90, 90, 90), 1)
        hline(img, Y(inter + slope*b), X(b), X(b), (90, 90, 90), 1)
    pts = [(X(t), Y(z)) for t, z in zip(theo, z_sample)]
    scatter(img, pts, (68, 114, 196), radius=0)
    hline(img, H - M, M, W - M, (0, 0, 0), 2)
    vline(img, M, M, H - M, (0, 0, 0), 2)
    write_png(path, W, H, img)
    print(f"Saved {path}")

# ---------------- MAIN ----------------
def main():
    df = pd.read_csv(DATA, sep="\t").set_index("GeneSymbol")
    m = df.values.astype(float)
    ng, ns = m.shape
    pool = m.ravel()

    print("=" * 78)
    print("RNA expression distribution skewness analysis  (COAD__geneExp.xls)")
    print("=" * 78)
    print(f"Matrix: {ng} genes x {ns} samples = {pool.size} values")
    print(f"NaN: {np.isnan(pool).sum()}  Inf: {np.isinf(pool).sum()}")
    print(f"Min: {fmt(pool.min())}  Max: {fmt(pool.max())}")
    print(f"Mean: {fmt(pool.mean())}  Median: {fmt(np.median(pool))}  SD: {fmt(pool.std(ddof=0))}")
    print(f"Fraction zeros: {fmt((pool==0).mean())}  Fraction <1: {fmt((pool<1).mean())}")

    g1_pool, ms_pool = g1(pool), medskew(pool)
    print("\n--- PRIMARY: pooled all genes x all samples (RAW as-provided scale) ---")
    print(f"  g1 (moment, sample-corrected) = {g1_pool:.6f}  -> {classify(g1_pool)}")
    print(f"  g1 (moment, population)       = {g1(pool, sample=False):.6f}")
    print(f"  Pearson median-based 3(mean-med)/SD = {ms_pool:.4f}  -> {classify(ms_pool)} (robust check)")

    gm, gmd, sm = m.mean(axis=1), np.median(m, axis=1), m.mean(axis=0)
    g1_gm, g1_gmd, g1_sm = g1(gm), g1(gmd), g1(sm)
    print("\n--- SENSITIVITY LAYERS (raw scale, alternative views) ---")
    print(f"  Per-gene mean layer  : g1 = {g1_gm:.6f}  -> {classify(g1_gm)}")
    print(f"  Per-gene median layer: g1 = {g1_gmd:.6f}  -> {classify(g1_gmd)}")
    print(f"  Per-sample mean layer: g1 = {g1_sm:.6f}  -> {classify(g1_sm)}")

    nz = pool[pool > 0]
    g1_nz, g1_log2x1, g1_log2nz, g1_sqrt = g1(nz), g1(np.log2(pool+1)), g1(np.log2(nz)), g1(np.sqrt(pool))
    print("\n--- SENSITIVITY: zeros-excluded & transform-dependent (context ONLY, ---")
    print("---            NOT the provided distribution) ---")
    print(f"  Raw pooled EXCLUDING zeros: g1 = {g1_nz:.6f}  -> {classify(g1_nz)}")
    print(f"  log2(x+1)     : g1 = {g1_log2x1:.6f}  -> {classify(g1_log2x1)}")
    print(f"  log2(nonzero) : g1 = {g1_log2nz:.6f}  -> {classify(g1_log2nz)}")
    print(f"  sqrt(x)       : g1 = {g1_sqrt:.6f}  -> {classify(g1_sqrt)}")

    verdict = classify(g1_pool)
    print("\n" + "=" * 78)
    print(f"FINAL CLASSIFICATION: {verdict}")
    print("The file is on a RAW non-log2 scale; the log2 values above are a transformed")
    print("layer only and do NOT change the primary classification.")
    print("=" * 78)

    save_hist(pool[pool > 0], pool.mean(), np.median(pool), OUT_HIST)
    rng = np.random.RandomState(0)
    save_qq(rng.choice(pool, 50000, replace=False), OUT_QQ)

    res = dict(g1_pool=g1_pool, g1_population=g1(pool, sample=False), medskew_pool=ms_pool,
               per_gene_mean=g1_gm, per_gene_median=g1_gmd, per_sample_mean=g1_sm,
               zeros_excluded=g1_nz, log2x1=g1_log2x1, log2_nonzero=g1_log2nz, sqrt=g1_sqrt,
               verdict=verdict, n_genes=ng, n_samples=ns, n_values=int(pool.size),
               frac_zero=float((pool == 0).mean()), raw_scale=True,
               scale_note="file on raw non-log2 scale (range 0-1.3e6, mean~932)")
    with open("skewness_results.json", "w") as f:
        def clean(o):
            return None if isinstance(o, float) and np.isnan(o) else o
        json.dump({k: clean(v) for k, v in res.items()}, f, indent=2)
    print("Saved skewness_results.json")

if __name__ == "__main__":
    main()
