#!/usr/bin/env python3
"""
BixBench bix-43-q1 - full_workflow
Question: When comparing CBD/cisplatin combination treatment to the DMSO control,
which cellular process shows the LOWEST adjusted p-value in an enrichment analysis
using the gseapy package and GO_Biological_Process_2021 as the gene set library?

Pipeline (all parameters pinned for reproduction):
 1. Load counts (ENSG x samples), sample layout, ENSG->symbol map.
 2. Subset the two comparison arms (n=3 each):
      COMBINATION = Group 9 'Cisplatin_IC50_CBD_IC50' -> cols 9_1,9_2,9_3
      DMSO control = Group 3 'DMSO'                   -> cols 3_1,3_2,3_3
    (Group 10, combination+serum-starvation, is EXCLUDED as confounded.)
 3. Normalization: DESeq-style median-of-ratios size factors on the
    6-sample subset; size factor = median over genes of count/sample-geomean.
 4. Low-count filter: keep ENSG with rowSum(raw counts) >= 10 across the
    6 samples.
 5. DE: per-gene statsmodels GLM NegativeBinomial family (NB2), log link,
    offset=log(size factor), design ~ condition (1=combo,0=DMSO).
    Ranking metric = Wald t-value on condition coefficient (signed).
    Fallback only if NB fails broadly: t-test on log2(norm+1).
 6. ENSG->symbol aggregation: drop unmapped; dedupe duplicate symbols by
    max |statistic|; residual ties broken by symbol name.
 7. Ranked list (.rnk = symbol<TAB>statistic), DESCENDING, unique symbols.
 8. Enrichment (final deliverable): gseapy.prerank with library string
    'GO_Biological_Process_2021'. GMT resolution:
      (a) $GO_BP_2021_GMT ; (b) data/GO_Biological_Process_2021.gmt ;
      (c) gseapy.get_library(name=..., organism='Human') (needs network);
      (d) else -> BLOCKED, recorded, NOT fabricated.
    pinned prerank params: min_size=3 max_size=5000 permutation_num=1000 seed=2026
    "adjusted p-value" = fdr_qval (BH-FDR across tested gene sets).
    Answer = GO term with LOWEST fdr_qval.
    NOTE: Enrichr-ORA (gseapy.enrichr) is the documented alternative reading;
    prerank GSEA on the full ranked list is the primary reading chosen.
 9. Report diagnostics + top terms (if run) to stdout and JSON.
"""
import json, os, sys, time, warnings
import numpy as np
import pandas as pd

warnings.filterwarnings("ignore")
np.random.seed(2026)

COMBO_COLS   = ["9_1", "9_2", "9_3"]
DMSO_COLS    = ["3_1", "3_2", "3_3"]
MIN_ROWS     = 10
LIBRARY_NAME = "GO_Biological_Process_2021"
PRERANK_KW   = dict(min_size=3, max_size=5000, permutation_num=1000, seed=2026)
OUTDIR       = "analysis"
RNK_PATH     = os.path.join(OUTDIR, "gorank.rnk")
REPORT_PATH  = os.path.join(OUTDIR, "pipeline_report.json")
DE_PATH      = os.path.join(OUTDIR, "de_summary.csv")
EDIR         = os.path.join(OUTDIR, "enrichment_prerank")
GMT_CANDIDATES = [os.environ.get("GO_BP_2021_GMT", ""),
                  "data/GO_Biological_Process_2021.gmt",
                  os.path.join(OUTDIR, "GO_Biological_Process_2021.gmt"),
                  os.path.join(os.path.expanduser("~"), ".gseapy", "Library",
                               "GO_Biological_Process_2021.gmt")]

def main():
    t_start = time.time()
    os.makedirs(OUTDIR, exist_ok=True)

    # 1-2. Load inputs + subset comparison arms (verified vs sample_layout.csv)
    counts = pd.read_csv("data/counts_raw_unfiltered.csv", index_col=0)
    layout = pd.read_csv("data/sample_layout.csv")
    ensg_map = pd.read_csv("data/ensg_to_gene_name.tsv", sep="\t")
    sample_ok = all(c in layout["SampleID"].str.replace("-", "_").values for c in counts.columns)
    assert sample_ok, "counts columns do not match sample_layout SampleIDs"

    combo_labs = layout[layout["SampleID"].isin([c.replace("_", "-") for c in COMBO_COLS])]["Group"].tolist()
    dmso_labs  = layout[layout["SampleID"].isin([c.replace("_", "-") for c in DMSO_COLS])]["Group"].tolist()
    assert set(combo_labs) == {"Cisplatin_IC50_CBD_IC50"}, combo_labs
    assert set(dmso_labs) == {"DMSO"}, dmso_labs

    K = counts[COMBO_COLS + DMSO_COLS].astype(float)
    cond = np.array([1, 1, 1, 0, 0, 0], dtype=float)

    # 3. DESeq-style median-of-ratios size factors (6-sample subset)
    geo = np.exp(np.log(K.values).mean(axis=1))
    pos = geo > 0
    ratios = K.values[pos] / geo[pos, None]
    sf = np.median(ratios, axis=0)
    normK = K.values / sf
    offset = np.log(sf)

    # 4. Low-count filter
    keep = K.sum(axis=1) >= MIN_ROWS
    Kf = K[keep]
    normKf = normK[keep]
    n_raw, n_after_filter = int(K.shape[0]), int(keep.sum())

    # 5. Differential expression: per-gene GLM-NB Wald statistic
    from statsmodels.genmod.families import NegativeBinomial as NBF
    import statsmodels.api as sm
    fam = NBF(link=sm.families.links.Log())
    exog = np.column_stack([np.ones(6), cond])

    tvals = np.empty(len(Kf)); coefs = np.empty(len(Kf)); nb_nan = 0
    for i, (ensg, row) in enumerate(Kf.iterrows()):
        y = row.values.astype(float)
        try:
            r = sm.GLM(y, exog, family=fam, offset=offset).fit()
            tvals[i] = r.tvalues[1]
            coefs[i] = r.params[1]
        except Exception:
            tvals[i] = np.nan; coefs[i] = np.nan; nb_nan += 1

    # Global fallback (only if NB fails broadly): t-test on log2(norm+1)
    used_nb = True
    if nb_nan > 0.25 * len(Kf):
        used_nb = False
        print("[fallback] NB failed for %d/%d -> t-test log2(norm+1)" % (nb_nan, len(Kf)), file=sys.stderr)
        from scipy import stats as sst
        lg = np.log2(normKf + 1.0)
        a, b = lg[:, :3], lg[:, 3:]
        tt = sst.ttest_ind(a, b, axis=1, equal_var=False)
        tvals = tt.statistic
        coefs = np.median(b, axis=1) - np.median(a, axis=1)
        nb_nan = 0

    de = pd.DataFrame({"ENSG": Kf.index, "coef": coefs, "stat": tvals}).set_index("ENSG")
    de["log2FC"] = de["coef"] / np.log(2.0)
    de.to_csv(DE_PATH)
    n_with_nan = int(de["stat"].isna().sum())

    # 6. ENSG->symbol aggregation
    m = ensg_map.drop_duplicates("ENSG").set_index("ENSG")["gene_name"]
    de["symbol"] = de.index.map(m)
    # ENSG-identity symbols (mapping file falls back to the ENSG id itself,
    # i.e. no real biological symbol) carry no annotation -> treated as
    # unmapped and excluded from the prerank ranked list.
    de.loc[de["symbol"].str.match(r"^ENSG\d+$", na=False), "symbol"] = np.nan
    unmapped = int(de["symbol"].isna().sum())
    de_map = de.dropna(subset=["symbol"]).copy()
    de_map = de_map.loc[de_map.groupby("symbol")["stat"].apply(lambda s: s.abs().idxmax())]
    de_map = de_map.dropna(subset=["stat"]).copy()
    de_map = de_map.sort_values(["stat", "symbol"], ascending=[False, True])

    # 7. ranked list (.rnk) with gene SYMBOL as the key column
    rnk = de_map[["symbol", "stat"]].rename(columns={"stat": "score"}).set_index("symbol")
    rnk.to_csv(RNK_PATH, sep="\t", header=False)
    n_ranked = int(len(rnk))

    # 8. Enrichment: gseapy.prerank with GO_Biological_Process_2021
    enrichment = {"status": "blocked", "reason": "", "top": [],
                  "answer_term": None, "answer_fdr": None}
    try:
        import gseapy
        gseapy_ver = getattr(gseapy, "__version__", "unknown")
        gmt_path = None
        for cand in GMT_CANDIDATES:
            if cand and os.path.exists(cand):
                gmt_path = cand; break
        if gmt_path is None:
            try:
                gmt_path = gseapy.get_library(name=LIBRARY_NAME, organism="Human")
            except Exception as e:
                gmt_path = None
                enrichment["reason"] = "GMT resolution failed (network?): %s" % e
        if gmt_path is None:
            enrichment["reason"] = ("GO_Biological_Process_2021 library unavailable offline "
                                    "(no local GMT, no network to Enrichr); gseapy %s present." % gseapy_ver)
        else:
            prer = gseapy.prerank(rnk=RNK_PATH, gene_sets=gmt_path, outdir=EDIR, **PRERANK_KW)
            res = prer.res2d.sort_values("fdr_qval").reset_index(drop=True)
            enrichment["status"] = "run"
            enrichment["gseapy_version"] = gseapy_ver
            enrichment["gmt_path"] = str(gmt_path)
            enrichment["n_terms_tested"] = int(len(res))
            enrichment["seed"] = PRERANK_KW["seed"]
            enrichment["top"] = res.head(10)[["Term", "NES", "pval", "fdr_qval", "lead_genes"]].to_dict("records")
            enrichment["answer_term"] = res.iloc[0]["Term"]
            enrichment["answer_fdr"] = float(res.iloc[0]["fdr_qval"])
            res.to_csv(os.path.join(OUTDIR, "prerank_results.csv"), index=False)
    except ImportError:
        enrichment["reason"] = ("gseapy NOT installed in this sandbox (import failed) and no network to pip-install "
                                "it; enrichment step BLOCKED here - must run in the provisioned runner.")
    except Exception as e:
        enrichment["status"] = "blocked"
        enrichment["reason"] = "gseapy prerank error: %s" % e

    report = {
        "question": "GO term with lowest adjusted p-value (fdr_qval) for combo(9) vs DMSO(3), gseapy prerank, GO_Biological_Process_2021",
        "samples_used": {"combination": COMBO_COLS, "dmso": DMSO_COLS},
        "group_labels": {"combination": list(set(combo_labs)), "dmso": list(set(dmso_labs))},
        "size_factors": [round(float(x), 4) for x in sf],
        "filter": {"min_rowsum_across_6": MIN_ROWS, "n_raw_genes": n_raw,
                   "n_after_filter": n_after_filter},
        "de": {"model": "statsmodels.GLM NegativeBinomial (NB2), log link, offset=log(size)",
               "metric": "Wald t-value on condition coefficient (signed)",
               "used_nb": used_nb, "n_nb_nan": nb_nan, "n_nan_in_de": n_with_nan},
        "aggregation": {"n_unmapped_ensg": unmapped, "n_ranked_genes": n_ranked},
        "rnk_path": RNK_PATH,
        "top_ranked": [{"symbol": s, "stat": float(v)} for s, v in rnk["score"].head(10).items()],
        "bottom_ranked": [{"symbol": s, "stat": float(v)} for s, v in rnk["score"].tail(5).items()],
        "enrichment": enrichment,
        "methodological_notes": [
            "prerank-style GSEA on the FULL ranked list is the primary reading of the question.",
            "Enrichr-ORA (gseapy.enrichr) on a DE gene list is the documented alternative reading.",
            "pinned prerank params: %s" % PRERANK_KW,
            "adjusted p-value = fdr_qval (BH-FDR across tested gene sets in gseapy prerank).",
            "group 10 (combination + serum starvation) excluded as confounded.",
        ],
        "elapsed_sec": round(time.time() - t_start, 1),
    }
    with open(REPORT_PATH, "w") as f:
        json.dump(report, f, indent=2, default=str)

    print("=" * 78)
    print("PIPELINE COMPLETE. comparison: combo(group 9) vs DMSO(group 3), n=3 each")
    print("size factors (9_1,9_2,9_3,3_1,3_2,3_3):", np.round(sf, 3).tolist())
    print("filter rowSum>=%d -> %d -> %d genes; DE model: GLM-NB used=%s nan_stats=%d"
          % (MIN_ROWS, n_raw, n_after_filter, used_nb, n_with_nan))
    print("aggregation: unmapped=%d, deduped -> %d unique ranked symbols" % (unmapped, n_ranked))
    print("rnk ->", RNK_PATH, "| top ranked:", report["top_ranked"][:3])
    print("-" * 78)
    if enrichment["status"] == "run":
        print("ENRICHMENT RAN (gseapy prerank):")
        for t in enrichment["top"][:10]:
            print("  %-70s NES=%+.3f pval=%.3e fdr_qval=%.3e"
                  % (t["Term"][:70], t["NES"], t["pval"], t["fdr_qval"]))
        print("ANSWER (lowest adjusted p-value / fdr_qval): %s (fdr_qval=%.3e)"
              % (enrichment["answer_term"], enrichment["answer_fdr"]))
    else:
        print("ENRICHMENT STATUS: BLOCKED in this sandbox.")
        print("  reason:", enrichment["reason"])
        print("  NOTE: final answer term MUST be obtained by executing this script in the provisioned")
        print("  runner (gseapy + GO_Biological_Process_2021 available there). No term is fabricated here.")
    print("report ->", REPORT_PATH)
    print("=" * 78)
    return 0

if __name__ == "__main__":
    sys.exit(main())
