"""
BixBench task: odds ratio for 'p53 mediated cell cycle regulation'
(Reactome_2022 enrichment) among DEGs (padj<0.05, |log2FC|>0.5, baseMean>10)
between CBD/cisplatin combination (Group 9: Cisplatin_IC50_CBD_IC50) vs
DMSO (Group 3).

IMPORTANT ENVIRONMENT DEVIATION (documented):
The runtime is fully offline (pip DNS failure; no gseapy, pydeseq2, R, and no
cached Enrichr/Reactome_2022 .gmt on disk). Consequently:
  * Differential expression is implemented from scratch as a DESeq2-style
    negative-binomial GLM (median-of-ratios size factors, method-of-moments
    dispersion + parametric trend shrinkage, Wald test for log2FC, BH padj).
  * The enrichment is computed with the Enrichr-equivalent ORA formula
    OR = (a*d)/(b*c) over the DEG list with background = all mapped
    prefilter-passing genes - the same definition gseapy.enrichr's
    'Odds Ratio' column uses.
  * The Reactome_2022 'p53 Mediated Cell Cycle Regulation' gene set could not
    be downloaded; a best-faith canonical reconstruction is used (see
    GENE_SET below) and is flagged as an assumption.
"""
import json
import numpy as np
import pandas as pd
from scipy import stats
from statsmodels.stats.multitest import multipletests

# ----------------------------------------------------------------------
# 1. Load data, align samples to groups
# ----------------------------------------------------------------------
counts = pd.read_csv('data/counts_raw_unfiltered.csv', index_col=0)
layout = pd.read_csv('data/sample_layout.csv')
samp2grp = {r.SampleID.replace('-', '_'): r.Group for r in layout.itertuples()}
cts = counts.copy()
grp = pd.Series([samp2grp[c] for c in cts.columns], index=cts.columns)
assert cts.shape == (63677, 30), cts.shape
print('Counts shape:', cts.shape, '| unique groups:', grp.nunique())

COMP = 'Cisplatin_IC50_CBD_IC50'   # Group 9 = CBD/cisplatin combination treatment
CTRL = 'DMSO'                       # Group 3 = DMSO
print('Comparison: %s (n=%d) vs %s (n=%d)'
      % (COMP, (grp == COMP).sum(), CTRL, (grp == CTRL).sum()))

# ----------------------------------------------------------------------
# 2. Prefilter over ALL 30 samples: genes with total counts > 0
# ----------------------------------------------------------------------
keep30 = cts.sum(axis=1) > 0
print('Genes after prefilter (total counts across all 30 samples > 0): %d / %d'
      % (keep30.sum(), cts.shape[0]))

# 3. DESeq2 median-of-ratios size factors across all 30 samples
pre30 = cts.loc[keep30]
logc = np.log(pre30.values)
geomean_log = np.nanmean(logc, axis=1)          # no all-zero rows remain
ratio_all = pre30.values / np.exp(geomean_log)[:, None]
sf_all = np.nanmedian(ratio_all, axis=0)
sf_all = sf_all / np.exp(np.mean(np.log(sf_all)))
sf = pd.Series(sf_all, index=cts.columns)

# 4. Model the 6 samples (Groups 9 and 3)
cols6 = [c for c in cts.columns if samp2grp[c] in (COMP, CTRL)]
X6 = pre30[cols6]
y = X6.values.astype(float)
sf6 = sf[cols6].values
g9mask = np.array([samp2grp[c] == COMP for c in cols6])
g3mask = ~g9mask
print('Modeled columns (%d): %s' % (len(cols6), cols6))

# fitted means mu_i = sf_i * q_group(i)
q9 = (y[:, g9mask] / sf6[g9mask]).mean(axis=1)
q3 = (y[:, g3mask] / sf6[g3mask]).mean(axis=1)
mu = np.where(g9mask, sf6 * q9[:, None], sf6 * q3[:, None])
base_mean = (y / sf6).mean(axis=1)
lfc = np.full(len(q9), 0.0)
nz = (q9 > 0) & (q3 > 0)
lfc[nz] = np.log2(q9[nz] / q3[nz])

# 5. method-of-moments dispersion (DESeq2 initial estimator), pooled over 6 samples
pearson = ((y - mu) ** 2 / mu).sum(axis=1)
dfree = 6 - 2  # residual df (n - rank(design))
valid6_all = (mu ** 2).sum(axis=1) > 0
disp_mom = np.full(len(mu), np.nan)
disp_mom[valid6_all] = np.maximum(
    (pearson[valid6_all] - dfree) / np.maximum((mu[valid6_all] ** 2).sum(axis=1), 1e-12), 1e-8)

# 6. parametric trend: log(disp) ~ a + b*log(mu) + c*log(mu)^2, then EB shrinkage
ok = np.isfinite(np.log(disp_mom)) & (base_mean > 0) & \
     (base_mean < np.quantile(base_mean, 0.999))
A = np.column_stack([np.ones(ok.sum()),
                     np.log(base_mean[ok]),
                     np.log(base_mean[ok]) ** 2])
coef, *_ = np.linalg.lstsq(A, np.log(disp_mom[ok]), rcond=None)
lm = np.log(np.maximum(base_mean, 1e-6))
trend = np.exp(coef[0] + coef[1] * lm + coef[2] * lm ** 2)
trend = np.maximum(trend, 1e-6)
# empirical-Bayes-style shrinkage of log-dispersion toward trend
valid6 = mu.sum(axis=1) > 0
disp_mom[~valid6] = np.nan
fisher_d = np.zeros(len(mu))
fisher_d[valid6] = 0.5 * (mu[valid6] ** 2 / (1 + disp_mom[valid6, None] * mu[valid6]) ** 2).sum(axis=1)
fisher_d[~valid6] = np.nan
k = 2.0
disp = np.exp((fisher_d * np.log(disp_mom) + k * np.log(trend)) / (fisher_d + k))
disp = np.maximum(disp, 1e-8)

# 7. Wald test for log2FC (NB Fisher-information weights)
w = mu / (1 + disp[:, None] * mu)
var_lfc = (1.0 / np.log(2) ** 2) * (1.0 / w[:, g9mask].sum(axis=1) +
                                     1.0 / w[:, g3mask].sum(axis=1))
se_lfc = np.sqrt(var_lfc)
z = np.where((se_lfc > 0) & np.isfinite(se_lfc), lfc / se_lfc, 0.0)
pval = 2 * (1 - stats.norm.cdf(np.abs(z)))
# extreme-p safeguard
pval = np.clip(pval, 1e-300, 1.0)
padj = multipletests(pval, method='fdr_bh')[1]

res = pd.DataFrame({'baseMean': base_mean, 'log2FoldChange': lfc,
                    'lfcSE': se_lfc, 'pvalue': pval, 'padj': padj},
                   index=pre30.index)
print('Genes tested in DE: %d' % len(res))

# ----------------------------------------------------------------------
# 8. DEG filter
# ----------------------------------------------------------------------
deg = res[(res.padj < 0.05) & (res.log2FoldChange.abs() > 0.5) & (res.baseMean > 10)].copy()
print('DEGs (padj<0.05, |lfc|>0.5, baseMean>10): %d' % len(deg))
print('  up in %s: %d | down in %s: %d'
      % (COMP, (deg.log2FoldChange > 0).sum(), COMP, (deg.log2FoldChange < 0).sum()))

# ----------------------------------------------------------------------
# 9. ENSG -> gene name; enrichment uses mapped genes only
# ----------------------------------------------------------------------
m = pd.read_csv('data/ensg_to_gene_name.tsv', sep='\t')
name = m.set_index('ENSG')['gene_name'].to_dict()
bg = res.copy()
bg['gene'] = bg.index.map(name)
bg = bg.dropna(subset=['gene'])
bg = bg[~bg['gene'].duplicated(keep='first')]
print('Mapped background genes (name-deduped): %d' % len(bg))

deg = deg.copy()
deg['gene'] = deg.index.map(name)
print('DEGs unmapped (no gene name): %d' % deg['gene'].isna().sum())
deg = deg.dropna(subset=['gene'])
deg = deg[~deg['gene'].duplicated(keep='first')]
deg_set = set(deg['gene'])
print('DEGs with mapped unique names (used in enrichment): %d' % len(deg_set))

# ----------------------------------------------------------------------
# 10. Reactome_2022 'p53 Mediated Cell Cycle Regulation' gene-set reconstruction
# ----------------------------------------------------------------------
GENE_SET = ['CDKN1A', 'MDM2', 'MDM4', 'GADD45A', 'GADD45B', 'GADD45G',
            'RRM2B', 'BAX', 'BBC3', 'PMAIP1', 'CCNG1', 'CCNG2', 'BTG2',
            'DDB2', 'ZMAT3', 'TP53INP1', 'FAS', 'CASP3', 'SFN', 'SESN1',
            'SESN2', 'PPM1D', 'PLK3']
K = len(set(GENE_SET) & set(bg['gene']))
print('\nReconstructed gene set (%d genes): %s' % (len(GENE_SET), ', '.join(GENE_SET)))
print('  genes of set present in mapped background: %d' % K)

# ----------------------------------------------------------------------
# 11. ORA odds ratio: OR = (a*d)/(b*c)   [Enrichr formula]
# ----------------------------------------------------------------------
x = len(deg_set & set(GENE_SET))
Nq = len(deg_set)
Nb = len(bg)
a, b = x, Nq - x
c = K - x
d = Nb - Nq - c
OR = (a * d) / (b * c) if (b * c) > 0 else float('inf')
ht = stats.hypergeom(Nb, K, Nq)
hp = ht.sf(x - 1)
ft = stats.fisher_exact([[a, b], [c, d]], alternative='greater')

print('\n==== ORA RESULT ====')
print('Background Nb = %d | DEG list Nq = %d | set in bg K = %d | overlap x = %d'
      % (Nb, Nq, K, x))
print('Odds Ratio (a*d)/(b*c) = %.4f' % OR)
print('Contingency [[a,b],[c,d]] = [[%d,%d],[%d,%d]]' % (a, b, c, d))
print('Hypergeometric right-tail p = %.3e | Fisher(>)=%.3e' % (hp, ft[1]))
overlap_genes = sorted(deg_set & set(GENE_SET))
print('DEG members of the set (%d): %s' % (len(overlap_genes), ', '.join(overlap_genes)))
for g in GENE_SET:
    r = deg[deg['gene'] == g]
    if len(r):
        print('   %-10s DEG  lfc=%7.2f  baseMean=%9.1f  padj=%.2e'
              % (g, r.log2FoldChange.iloc[0], r.baseMean.iloc[0], r.padj.iloc[0]))
    else:
        print('   %-10s not-DEG' % g)

# ----------------------------------------------------------------------
# 12. Sensitivity / perturbation note (auditability)
# ----------------------------------------------------------------------
def ora_or(xx, Nqq, Kk, Nbb):
    bb = Nqq - xx
    cc = Kk - xx
    dd = Nbb - Nqq - cc
    return (xx * dd) / (bb * cc) if (bb * cc) > 0 else float('inf')

print('\n==== SENSITIVITY (one-member perturbations of the reconstructed set) ====')
for extra in ['PCNA', 'CCNE1', 'AEN', 'EI24', 'SERPINE1', 'TAP1', 'MDM2', 'CDK4']:
    inbg = extra in set(bg['gene'])
    isdeg = extra in deg_set
    print('  +%-10s in_bg=%-5s is_DEG=%-5s -> K=%d x=%d OR=%.3f'
          % (extra, inbg, isdeg, K + inbg, x + isdeg,
             ora_or(x + isdeg, Nq, K + inbg, Nb)))
for rem in overlap_genes:
    print('  -%-10s -> K=%d x=%d OR=%.3f'
          % (rem, K - 1, x - 1, ora_or(x - 1, Nq, K - 1, Nb)))

# ----------------------------------------------------------------------
# 13. Diagnostics and outputs
# ----------------------------------------------------------------------
print('\n==== DIAGNOSTICS ====')
print('Size factors (6 modeled samples): %s' % np.round(sf6, 3))
finite_disp = disp[np.isfinite(disp)]
print('Dispersion (tested genes, finite): n=%d min=%.2e med=%.2e max=%.2e'
      % (len(finite_disp), np.min(finite_disp), np.median(finite_disp),
         np.max(finite_disp)))
print('Median baseMean (tested): %.1f' % np.median(base_mean))
print('Genes with padj<0.05 (any lfc/baseMean): %d' % (res.padj < 0.05).sum())
print('DEG count ENSG-level pre-name-mapping: %d' % len(deg))

out = {
    'odds_ratio': float(OR),
    'a': a, 'b': b, 'c': c, 'd': d,
    'Nb_background': int(Nb), 'Nq_deg_list': int(Nq),
    'K_set_in_background': int(K), 'x_deg_in_set': int(x),
    'deg_after_full_filter_mapped': int(len(deg)),
    'gene_set_reconstruction': GENE_SET,
    'deg_overlap_genes': overlap_genes,
    'hypergeom_right_p': float(hp),
    'comparison': {'combo': COMP, 'dmso': CTRL, 'combo_n': 3, 'dmso_n': 3,
                   'excluded_group10_serum_starvation': True},
}
with open('analysis/results_summary.json', 'w') as fh:
    json.dump(out, fh, indent=2, default=str)
print('\nSaved analysis/results_summary.json')
print('\nFINAL ANSWER -> odds ratio = %.4f' % OR)
