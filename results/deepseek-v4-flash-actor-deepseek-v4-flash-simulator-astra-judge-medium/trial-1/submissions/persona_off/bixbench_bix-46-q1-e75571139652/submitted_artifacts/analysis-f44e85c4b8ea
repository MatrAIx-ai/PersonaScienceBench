"""
BixBench bix-46-q1: log2 fold change of mexG in Delta-rhlI (strain #97) vs wt (strain #1).

Inputs:
  - data/res_1vs97.rds : DESeq2 'DESeqResults' object for the "Strain 97 vs 1" contrast
  - data/Pseudomonas_aeruginosa_UCBPP-PA14.csv : genome table (Locus Tag <-> Gene Name)
R is not installed in the runner, so the RDS (R serialization v3, XDR, gzip) is parsed directly.

Approach:
  1. Map gene mexG -> Locus Tag via the CSV (mexG = PA14_09540).
  2. Parse res_1vs97.rds:
       - locate the 6 DESeqResults columns = back-to-back REALSXP vectors
         (header token 00 00 00 0e [type 14] + nrows 0x16c4=5828, then 5828 doubles);
         column order (confirmed via mcols descriptions + stat=lfc/lfcSE) is
         baseMean, log2FoldChange, lfcSE, stat, pvalue, padj.
       - locate the rownames STRSXP (type 0x10 + nrows 5828, tokens 00 04 00 09 <len> <locus-tag>);
         row order differs between contrasts, so match PA14_09540 by rowname.
  3. The stored contrast (from mcols description "log2 fold change (MLE): Strain 97 vs 1")
     already encodes 97 vs 1 (numerator = Strain 97), so the stored value is the answer.
  4. Round log2FoldChange[mexG] to 2 decimal places.
"""
import gzip, struct

ROW = 0x16C4  # 5828 genes
PATH = "data/res_1vs97.rds"

def read_bytes(path):
    with gzip.open(path, "rb") as f:
        return f.read()

def find_column_offsets(raw):
    pat = struct.pack(">II", 14, ROW)
    offs, s = [], 0
    while True:
        i = raw.find(pat, s)
        if i == -1:
            break
        offs.append(i)
        s = i + 1
    assert len(offs) == 6, f"expected 6 columns, found {len(offs)}"
    return offs

def parse_rownames(raw):
    # rownames STRSXP: type(0x10=16) + nrows then 5828 tokens 00 04 00 09 <len32> <string>
    assert raw[84:88] == struct.pack(">I", 16)
    assert raw[88:92] == struct.pack(">I", ROW)
    pos, names = 92, []
    for _ in range(ROW):
        assert raw[pos:pos+2] == b"\x00\x04" and raw[pos+2:pos+4] == b"\x00\x09"
        ln = struct.unpack(">I", raw[pos+4:pos+8])[0]
        names.append(raw[pos+8:pos+8+ln].decode("utf-8"))
        pos += 8 + ln
    return names

def main():
    raw = read_bytes(PATH)
    names = parse_rownames(raw)
    offs = find_column_offsets(raw)
    cols = {}
    for k, cn in enumerate(["baseMean", "log2FoldChange", "lfcSE", "stat", "pvalue", "padj"]):
        o = offs[k] + 8
        cols[cn] = struct.unpack(f">{ROW}d", raw[o:o + 8*ROW])

    i = names.index("PA14_09540")   # mexG
    lfc = cols["log2FoldChange"][i]
    print("Gene mexG -> locus tag PA14_09540")
    print("Row index in res_1vs97:", i)
    print("baseMean:", cols["baseMean"][i])
    print("log2FoldChange (Strain 97 vs 1):", lfc)
    print("lfcSE:", cols["lfcSE"][i])
    print("stat:", cols["stat"][i])
    print("pvalue:", cols["pvalue"][i])
    print("padj:", cols["padj"][i])
    print("ANSWER (log2FC mexG, 2 dp):", round(lfc, 2))

if __name__ == "__main__":
    main()
