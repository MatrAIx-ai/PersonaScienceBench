"""
bix-51-q1 — Logistic regression: P(PR | age) with age as the ONLY predictor,
evaluated at age = 65.

Data: data/data.xlsx (Sheet1)
  - 121 rows total; 80 rows with real data (Sequence number 1-80); the 41
    fully-empty trailing rows are excluded.
  - Groups: 1 (41) = all PR; 2 (39) = all PD/SD  -> Group/treatment is NOT a
    regressor because the question fixes age as the ONLY predictor.
  - Outcome y = 1 if Efficacy=='PR' else 0 (PD and SD pooled as non-PR).
  - Predictor: raw Age (integer years, 40-75, no missing in valid rows).

Models:
  A) statsmodels Logit (unregularized MLE)           -> primary
  B) scipy.optimize.minimize (BFGS, -loglik)          -> independent cross-check
  C) manual IRLS (Newton-Raphson)                     -> independent cross-check
"""
import numpy as np
import pandas as pd
import statsmodels.api as sm
import scipy.optimize as opt

# ----------------------------------------------------------------------------
# 1. Load & preprocess
# ----------------------------------------------------------------------------
df = pd.read_excel('data/data.xlsx', sheet_name='Sheet1')
print('Raw workbook rows x cols :', df.shape)

data = df[df['Sequence number'].notna()].copy()           # keep 80 valid rows
data['Age'] = pd.to_numeric(data['Age'], errors='coerce') # numeric age
data['pr']  = (data['Efficacy'] == 'PR').astype(int)      # PR=1, PD/SD=0

print('Analysed rows            :', len(data))
print('PR=1 / PR=0              :', data['pr'].sum(), '/', (data['pr']==0).sum())
print('Age non-missing          :', data['Age'].notna().sum(),
      '| range', data['Age'].min(), '-', data['Age'].max())
assert data['Age'].notna().all() and data['pr'].notna().all()

X = data['Age'].astype(float).values
y = data['pr'].values
AGE = 65.0

# ----------------------------------------------------------------------------
# A) statsmodels Logit (primary)
# ----------------------------------------------------------------------------
Xc = sm.add_constant(X)
model = sm.Logit(y, Xc).fit(disp=False)
b0, b1 = model.params
se_b0, se_b1 = model.bse
p65_sm = float(model.predict([1.0, AGE])[0])

print('\n===== A) statsmodels Logit (unregularized MLE) =====')
print(model.summary2().tables[1].to_string())
print(f'P(PR|age=65) = {p65_sm:.6f}')

# ----------------------------------------------------------------------------
# B) Independent cross-check: scipy BFGS on negative log-likelihood
# ----------------------------------------------------------------------------
def neg_ll(b, X, y):
    z = b[0] + b[1]*X
    p = 1.0/(1.0+np.exp(-z))
    eps = 1e-12
    return -np.sum(y*np.log(p+eps) + (1-y)*np.log(1-p+eps))

res = opt.minimize(neg_ll, x0=np.zeros(2), args=(X, y), method='BFGS')
b0_bfgs, b1_bfgs = res.x
p65_bfgs = 1.0/(1.0+np.exp(-(b0_bfgs + b1_bfgs*AGE)))

# ----------------------------------------------------------------------------
# C) Independent cross-check: manual IRLS (Newton-Raphson)
# ----------------------------------------------------------------------------
def irls(X, y, tol=1e-12, maxit=100):
    b = np.zeros(2)
    for _ in range(maxit):
        z = b[0] + b[1]*X
        p = 1.0/(1.0+np.exp(-z))
        W = p*(1-p)
        # weighted least squares: bwls = (X'WX)^-1 X' W ztilde
        zt = b[0] + b[1]*X + (y - p)/np.maximum(W, 1e-12)
        Xw = Xc * np.sqrt(W)[:, None]
        bwls = np.linalg.solve(Xw.T @ Xw, Xw.T @ (np.sqrt(W)*zt))
        if np.max(np.abs(bwls - b)) < tol:
            b = bwls
            break
        b = bwls
    return b
b_irls = irls(X, y)
b0_irls, b1_irls = b_irls
p65_irls = 1.0/(1.0+np.exp(-(b0_irls + b1_irls*AGE)))

# ----------------------------------------------------------------------------
# Diagnostics & result
# ----------------------------------------------------------------------------
llf = model.llf
llnull = model.llnull
lr_stat = 2*(llf - llnull)
from scipy import stats as _sp; p_lr = float(_sp.chi2.sf(lr_stat, 1))
print('\n===== CROSS-CHECKS (unregularized MLE) =====')
print(f'statsmodels : intercept {b0:.8f} | age coef {b1:.8f} | P65 {p65_sm:.8f}')
print(f'BFGS        : intercept {b0_bfgs:.8f} | age coef {b1_bfgs:.8f} | P65 {p65_bfgs:.8f}')
print(f'IRLS        : intercept {b0_irls:.8f} | age coef {b1_irls:.8f} | P65 {p65_irls:.8f}')
assert abs(p65_sm - p65_bfgs) < 1e-6 and abs(p65_sm - p65_irls) < 1e-6

p65 = p65_sm
print('\n===== RESULT =====')
print(f'P(PR | age = 65) = {p65:.6f}  ({p65*100:.2f}%)')
print(f'logit coef (age) = {b1:.6f} (SE {se_b1:.6f})')
print(f'intercept        = {b0:.6f} (SE {se_b0:.6f})')
print(f'odds per +1 yr   = {np.exp(b1):.4f}')
print(f'Log-lik = {llf:.4f} | null LL = {llnull:.4f} | LR chi2(1) = {lr_stat:.4f} | p = {p_lr:.6f}')
print(f'McFadden pseudo-R2 = {1 - llf/llnull:.4f}')

print('\nIn-sample P(PR) by age (model):')
for a in [50, 60, 65, 70]:
    print(f'  age {a}: {model.predict([1.0, a])[0]:.4f}')

emp = data[data['Age'].between(63, 67)]
print(f'\nEmpirical PR rate among patients aged 63-67 (context only): '
      f'{emp["pr"].mean():.3f} (n={len(emp)})')
