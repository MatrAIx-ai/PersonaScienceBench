#!/usr/bin/env python
"""
BixBench bix-51-q2
Question: AIC of the logistic regression with BMI as the sole predictor of
treatment response (efficacy PR).

Plan (approved):
 1. Load data/data.xlsx; drop blank tail block -> n=80 rows with valid
    Efficacy and non-missing BMI (complete cases; 0 missing BMI in this subset).
 2. Binary response: y=1 if Efficacy=='PR' (n=41) else 0 (PD/SD, n=39).
 3. Unpenalized single-predictor logistic regression: intercept + BMI, logit link.
 4. AIC = -2*logLik + 2k, k=2. Verify statsmodels AIC vs direct scipy MLE.
 5. Report AIC to 2 decimals.
"""
import numpy as np
import pandas as pd
import statsmodels.api as sm
from scipy.optimize import minimize

# ---------- 1. Load & clean ----------
df = pd.read_excel('data/data.xlsx')
print("Raw shape:", df.shape)

# Keep complete cases: valid Efficacy + non-missing BMI (the 41 blank tail rows
# have neither; this also removes them).
d = df.dropna(subset=['Efficacy', 'BMI']).copy()
print("Rows retained (valid Efficacy & BMI):", len(d))
assert d['BMI'].isna().sum() == 0
assert d['Efficacy'].isna().sum() == 0

# ---------- 2. Binary response ----------
d['y'] = (d['Efficacy'] == 'PR').astype(int)
print("y=1 (PR):", d['y'].sum(), "| y=0 (PD/SD):", (1 - d['y']).sum())

X = d['BMI'].to_numpy(dtype=float)
y = d['y'].to_numpy(dtype=int)
n = len(y)

# ---------- 3. statsmodels fit ----------
X_design = sm.add_constant(X, prepend=True)          # [1, BMI]
glm = sm.GLM(y, X_design, family=sm.families.Binomial(link=sm.families.links.Logit())).fit()
sm_aic = glm.aic
sm_llf = glm.llf
print("\n--- statsmodels GLM (binomial logit) ---")
print("Intercept:", glm.params[0])
print("BMI coef :", glm.params[1])
print("logLik   :", sm_llf)
print("aic      :", sm_aic)

# ---------- 4. Direct scipy MLE + AIC verify ----------
def neg_ll(beta):
    b0, b1 = beta
    eta = b0 + b1 * X
    # logsumexp trick for numerical stability
    from scipy.special import logsumexp
    ll = np.sum(y * eta - logsumexp(np.c_[np.zeros_like(eta), eta], axis=1))
    return -ll

res = minimize(neg_ll, x0=[0.0, 0.0], method='BFGS')
b0, b1 = res.x
max_ll = -res.fun
scipy_aic = -2 * max_ll + 2 * 2                     # k=2: intercept + BMI
print("\n--- Direct scipy MLE ---")
print("Intercept:", b0, "| BMI coef:", b1, "| converged:", res.success)
print("max logLik:", max_ll)
print("AIC (-2*ll + 2k, k=2):", scipy_aic)

print("\n--- Verification ---")
print("|statsmodels.aic - scipy AIC| =", abs(sm_aic - scipy_aic))
print("|statsmodels.aic - (-2*sm_llf + 4)| =", abs(sm_aic - (-2*sm_llf + 4)))
assert abs(sm_aic - scipy_aic) < 1e-6, "AIC mismatch!"
assert abs(sm_aic - (-2*sm_llf + 4)) < 1e-6
AIC = sm_aic
print("\nFINAL AIC =", round(AIC, 2), " (logLik =", round(sm_llf, 4),
      ", n =", n, ", k = 2)")
