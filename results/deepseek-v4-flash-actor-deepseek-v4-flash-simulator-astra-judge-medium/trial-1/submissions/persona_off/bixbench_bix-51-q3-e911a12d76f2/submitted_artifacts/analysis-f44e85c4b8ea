import pandas as pd
import numpy as np
import statsmodels.api as sm

# ---- Load data ----
df = pd.read_excel('data/data.xlsx', sheet_name=0)

# ---- Complete-case rows (n=80), response coding ----
sub = df[df['Efficacy'].notna() & df['Age'].notna() & df['Gender'].notna() & df['BMI'].notna()].copy()
sub['Age'] = sub['Age'].astype(float)
sub['response'] = (sub['Efficacy'] == 'PR').astype(int)   # PR=1, PD+SD=0 (no CR in data)
sub['gender_male'] = (sub['Gender'] == 'Male').astype(int)  # Male=1, Female=0
print('Analysis rows:', len(sub))
print('Response counts (PR=1 / nonPR=0):', sub['response'].value_counts().to_dict())
print('Gender counts:', sub['Gender'].value_counts().to_dict())
print()

# ---- MAIN MODEL: single combined model, BMI continuous ----
X_cont = sub[['BMI', 'Age', 'gender_male']].copy()
X_cont = sm.add_constant(X_cont, has_constant='add')
y = sub['response']
model_cont = sm.Logit(y, X_cont).fit(disp=0)

print('='*72)
print('MODEL (primary): BMI continuous + Age + Gender(Male=1/Female=0)')
print('='*72)
print(model_cont.summary2().tables[1])
print()
print('Log-likelihood full model:', model_cont.llf)
print('Pseudo R2 (McFadden):', model_cont.prsquared)

# Age coefficient, OR, CI, Wald p
age_row = model_cont.params['Age']
age_se = model_cont.bse['Age']
age_p_wald = model_cont.pvalues['Age']
age_or = np.exp(age_row)
age_ci = model_cont.conf_int().loc['Age']
age_or_ci = np.exp(age_ci)
print(f'\nAge: coef={age_row:.6f}, OR={age_or:.6f}, OR 95% CI=({age_or_ci[0]:.6f}, {age_or_ci[1]:.6f}), Wald p={age_p_wald:.6g}')

# ---- LR test for Age: drop Age, compare ----
Xn = X_cont[['const', 'BMI', 'gender_male']]
model_no_age = sm.Logit(y, Xn).fit(disp=0)
lr_stat = 2 * (model_cont.llf - model_no_age.llf)
lr_p = 1 - np.float64(__import__('scipy').stats.chi2.cdf(lr_stat, df=1))
print(f'LR test for Age: chi2(1)={lr_stat:.6f}, LR p={lr_p:.6g}')

# ---- SENSITIVITY: BMI categorical (WHO groups) ----
bins = [-np.inf, 18.5, 25.0, np.inf]
labels = ['<18.5', '18.5-24.9', '>=25']
sub['bmi_cat'] = pd.cut(sub['BMI'], bins=bins, labels=labels, right=True)  # 18.5 in normal, 25 in overweight
print('\nBMI category counts (WHO-ish):')
print(sub['bmi_cat'].value_counts().to_dict())
dummies = pd.get_dummies(sub['bmi_cat'], prefix='bmi', drop_first=True, dtype=float)  # reference = '<18.5'
X_cat = pd.concat([dummies, sub[['Age', 'gender_male']].astype(float)], axis=1)
X_cat = sm.add_constant(X_cat, has_constant='add')
model_cat = sm.Logit(y, X_cat).fit(disp=0)
print('\n' + '='*72)
print('SENSITIVITY MODEL: BMI categorical (ref <18.5) + Age + Gender')
print('='*72)
print(model_cat.summary2().tables[1])
print(f'\nSensitivity: Age coef={model_cat.params["Age"]:.6f}, Wald p={model_cat.pvalues["Age"]:.6g}')
