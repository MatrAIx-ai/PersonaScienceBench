"""
Logistic regression: remission ~ Age + BMI + Gender
Data: data/data.xlsx (Sheet1)
Outcome: remission = 1 iff Efficacy == 'PR' (partial response), else 0
Predictors: Age (raw, per 1-year increase), BMI (raw), Gender (Male=1, Female reference)
Complete cases: rows 0-79 (80 real patient records); 41 trailing blank rows dropped.

Reported quantity: Age coefficient = change in log-odds of remission per 1-year
increase in age, holding BMI and Gender fixed, with Wald 95% CI and SE.
"""
import numpy as np
import pandas as pd
import statsmodels.api as sm

# ---------------- Load data ----------------
df = pd.read_excel('data/data.xlsx', 'Sheet1')
print("Raw Sheet1 rows:", len(df))

# Keep only real patient records (drop placeholder/blank rows)
df = df[df['Sequence number'].notna()].copy()
n_complete = len(df)
print("Complete-case n (non-blank patient records):", n_complete)

# ---------------- Recoding ----------------
df['remission'] = (df['Efficacy'].astype(str).str.strip() == 'PR').astype(int)  # 1 = PR
df['Age'] = pd.to_numeric(df['Age'], errors='coerce')                            # years
df['Gender_male'] = (df['Gender'].astype(str).str.strip() == 'Male').astype(int) # Female ref

print("Remission counts (1=PR):", df['remission'].value_counts().to_dict())
print("Gender_male counts:", df['Gender_male'].value_counts().to_dict())
print("Missing in analysis columns:\n", df[['remission','Age','BMI','Gender_male']].isna().sum().to_string())

# ---------------- Model ----------------
X = sm.add_constant(df[['Age', 'BMI', 'Gender_male']])
y = df['remission']
model = sm.Logit(y, X).fit(disp=False, maxiter=100)

print("\nConverged:", model.mle_retvals.get('converged', 'n/a'))
print("Iterations:", model.mle_retvals.get('iterations', 'n/a'))
print("\nFull model summary (coef / SE / z / p / Wald 95% CI):")
print(model.summary2().tables[1].to_string())

# ---------------- Separation diagnostics ----------------
print("\n--- Complete separation / structure diagnostics ---")
print(pd.crosstab(df['remission'], df['Gender_male']).to_string())
df['age_q'] = pd.qcut(df['Age'], 4, duplicates='drop')
print("\nRemission by Age quartile:")
print(pd.crosstab(df['remission'], df['age_q']).to_string())
print("\nAge unique:", df['Age'].nunique(), "| BMI unique:", df['BMI'].nunique())
print("Pearson corr(Age,BMI):", round(df['Age'].corr(df['BMI']), 3))

# ---------------- Effect of interest ----------------
age_coef = model.params['Age']
age_se = model.bse['Age']
ci = model.conf_int(alpha=0.05).loc['Age']     # Wald 95% CI
or_year = np.exp(age_coef)

print("\n================ RESULT ================")
print(f"n = {model.nobs:.0f}")
print(f"Age coefficient (change in log-odds of remission per 1-yr age increase) = {age_coef:.6f}")
print(f"SE(Age coefficient) = {age_se:.6f}")
print(f"Wald 95% CI for Age coefficient = [{ci[0]:.6f}, {ci[1]:.6f}]")
print(f"Exp(Age coef) = odds ratio per year = {or_year:.6f}")
print(f"z = {model.tvalues['Age']:.3f}, p = {model.pvalues['Age']:.4f}")
print("========================================")

with open('age_effect_result.txt','w') as f:
    f.write(f"n = {model.nobs:.0f}\n")
    f.write(f"Age coef = {age_coef:.6f}\n")
    f.write(f"SE = {age_se:.6f}\n")
    f.write(f"95% CI = [{ci[0]:.6f}, {ci[1]:.6f}]\n")
    f.write(f"OR per year = {or_year:.6f}\n")
print("\nSaved age_effect_result.txt")
