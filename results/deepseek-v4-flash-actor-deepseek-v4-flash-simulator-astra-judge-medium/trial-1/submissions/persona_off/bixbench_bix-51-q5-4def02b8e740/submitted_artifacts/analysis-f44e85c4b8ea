"""
BixBench bix-51-q5: Logistic regression of treatment response on BMI (adjusted).
Question: p-value for the null hypothesis that BMI is not associated with treatment response.

Specification (agreed):
  Outcome   : Response = 1 if Groups == 1 (responders; all Efficacy==PR),
              else 0 (Group 2; Efficacy in {SD, PD}).  Coding forced by Groups x Efficacy partition.
  Predictors: BMI (continuous) + Age (continuous) + Family history (Yes/No)
              + ECOG-PS (2 vs 0-1) + Child-Pugh (B vs A) + Chemotherapy experience (Yes/No)
              + HBV infection (Yes/No) + Gender (Male/Female).
  Analysis  : binary logistic regression, complete cases (n=80).
  Test      : H0: beta_BMI = 0. Report two-sided Wald p-value for the BMI coefficient
              (headline); note LR p and unadjusted BMI-only p for reference.
"""
import pandas as pd
import numpy as np
import openpyxl
import statsmodels.api as sm
from scipy import stats

# ---------- Load data ----------
wb = openpyxl.load_workbook('data/data.xlsx', data_only=True)
ws = wb['Sheet1']
rows = list(ws.iter_rows(values_only=True))
df = pd.DataFrame([r[:12] for r in rows[1:]], columns=rows[0][:12])

# Complete cases: rows with a valid Sequence number (1-80)
df = df[df['Sequence number'].notna()].copy()
n = len(df)
print('Complete-case rows (n):', n)

# ---------- Outcome ----------
# Groups 1 = responders (PR), Group 2 = non-responders (SD/PD)
y = df['Groups'].map({1.0: 1, 2.0: 0}).astype(int)
print('Response counts: 1 (responder) = %d, 0 (non-responder) = %d' % (y.sum(), (1-y).sum()))
print('Cross-check: Efficacy==PR & Groups==1 matches:', (y == (df['Efficacy']=='PR').astype(int)).all())

# ---------- Predictors ----------
X = pd.DataFrame({
    'BMI':                      df['BMI'].astype(float),
    'Age':                      df['Age'].astype(float),
    'Family_history_Yes':      (df['Family history']=='Yes').astype(int),
    'ECOG_PS_2':               (df['ECOG-PS']==2).astype(int),
    'Child_Pugh_B':            (df['Child-Pugh']=='B').astype(int),
    'Chemotherapy_exp_Yes':    (df['Chemotherapy experience']=='Yes').astype(int),
    'HBV_infection_Yes':       (df['HBV infection']=='Yes').astype(int),
    'Gender_Male':             (df['Gender']=='Male').astype(int),
})

design = sm.add_constant(X)

# ---------- ADJUSTED model (primary) ----------
mod = sm.Logit(y, design)
res = mod.fit(disp=0)
print('\n========== ADJUSTED MODEL (headline) ==========')
print(res.summary2().tables[1].to_string())

b, se, z, p = res.params['BMI'], res.bse['BMI'], res.tvalues['BMI'], res.pvalues['BMI']
ci_lo, ci_hi = res.conf_int().loc['BMI']
print('\nBMI: b = %.6f | SE = %.6f | z = %.4f | Wald p (two-sided) = %.6f' % (b, se, z, p))
print('BMI OR = %.4f | 95%% CI (coef) = [%.4f, %.4f] | 95%% CI (OR) = [%.4f, %.4f]' % (np.exp(b), ci_lo, ci_hi, np.exp(ci_lo), np.exp(ci_hi)))

# LR test for BMI (drop BMI, refit)
X_no_bmi = sm.add_constant(X.drop(columns='BMI'))
res_null = sm.Logit(y, X_no_bmi).fit(disp=0)
lr_stat = 2 * (res.llf - res_null.llf)
lr_p = stats.chi2.sf(lr_stat, df=1)
print('LR test for BMI: chi2(1) = %.4f | LR p = %.6f' % (lr_stat, lr_p))

# ---------- UNADJUSTED model (reference only) ----------
res_u = sm.Logit(y, sm.add_constant(X['BMI'])).fit(disp=0)
print('\n========== UNADJUSTED MODEL (reference) ==========')
print('BMI: b = %.6f | z = %.4f | Wald p = %.6f' % (res_u.params['BMI'], res_u.tvalues['BMI'], res_u.pvalues['BMI']))
res_int = sm.Logit(y, sm.add_constant(pd.Series(np.ones(n), name='c'))).fit(disp=0)
ll0 = res_int.llf
print('Unadjusted LR p = %.6f' % stats.chi2.sf(2*(res_u.llf - ll0), df=1))

# ---------- Summary ----------
print('\n========== SUMMARY ==========')
print('Analysis sample n = %d (80 complete-case rows; 41 sparse/empty rows dropped)' % n)
print('Headline (adjusted Wald p for beta_BMI): %.4f' % p)
print('BMI coefficient = %.4f (95%% CI %.4f to %.4f), OR = %.3f' % (b, ci_lo, ci_hi, np.exp(b)))
print('LR p = %.4f; unadjusted Wald p = %.4f' % (lr_p, res_u.pvalues['BMI']))
