"""
BixBench bix-51-q8 -- Simple logistic regression of camrelizumab treatment
response on age.

Plan (approved):
- Use the 80-row real data block (rows 0-79) of data/data.xlsx Sheet1.
- Response y = 1 if Efficacy == "PR" (responder/effective), 0 if "SD" or "PD".
- Sole predictor: Age in raw integer years (per 1-year unit), unadjusted.
- Model: binomial GLM with logit link  ->  statsmodels GLM / Logit.
- Report: Age coefficient (change in log-odds per year), SE, intercept,
  plus coefficient table and null/deviance diagnostics.
"""
import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf

# ---------- 1. Load and clean data ----------
df = pd.read_excel("data/data.xlsx", sheet_name="Sheet1")
df = df.iloc[:80].copy()                       # real data block (rows 0-79)
df["Age_num"] = pd.to_numeric(df["Age"], errors="coerce")

assert df["Age_num"].notna().all(), "missing Age in block"
assert df["Efficacy"].notna().all(), "missing Efficacy in block"
assert df["Groups"].notna().all(), "missing Groups in block"

# ---------- 2. Code binary response ----------
# y = 1 if PR (responder), 0 if SD/PD (non-responder reference)
df["response"] = (df["Efficacy"] == "PR").astype(int)

print("Dataset used: n =", len(df))
print("Response counts: 0 (SD/PD) =", int((df["response"] == 0).sum()),
      "; 1 (PR) =", int((df["response"] == 1).sum()))
print("Groups==1 iff PR?",
      bool(((df["Groups"] == 1.0) == (df["response"] == 1)).all()))

# ---------- 3. Fit simple (unadjusted) binomial logistic regression ----------
model = smf.glm("response ~ Age_num", data=df, family=sm.families.Binomial()).fit()

print("\n=== Model summary ===")
print(model.summary())

age_coef = model.params["Age_num"]
age_se   = model.bse["Age_num"]
intercept = model.params["Intercept"]
print("\n=== Deliverable ===")
print(f"Age coefficient (change in log-odds per 1-year increase): {age_coef:.6f}")
print(f"Standard error of Age coefficient: {age_se:.6f}")
print(f"Intercept (log-odds of response at Age = 0): {intercept:.6f}")
print(f"Odds ratio per year (exp(beta)): {np.exp(age_coef):.6f}")

# Null vs residual deviance diagnostics
null_dev  = model.null_deviance
resid_dev = model.deviance
print("\n=== Diagnostics ===")
print(f"Null deviance (df={len(df)-1}): {null_dev:.4f}")
print(f"Residual deviance (df={model.df_resid}): {resid_dev:.4f}")
print(f"Log-likelihood: {model.llf:.4f}  AIC: {model.aic:.4f}  BIC: {model.bic:.4f}")
print(f"Pseudo R^2 (McFadden): {1 - model.llf/model.llnull:.4f}")

# Robustness: same model via statsmodels Logit (MLE, logit link) to confirm
logit_model = sm.Logit(df["response"], sm.add_constant(df["Age_num"])).fit(disp=0)
print("\n=== Cross-check via sm.Logit ===")
print("Age coef:", logit_model.params["Age_num"], "| SE:", logit_model.bse["Age_num"],
      "| Intercept:", logit_model.params["const"])

# Save results to CSV for the record
results = pd.DataFrame({
    "term": ["Intercept", "Age_num"],
    "coef": [model.params["Intercept"], model.params["Age_num"]],
    "std_err": [model.bse["Intercept"], model.bse["Age_num"]],
    "z": [model.tvalues["Intercept"], model.tvalues["Age_num"]],
    "p_value": [model.pvalues["Intercept"], model.pvalues["Age_num"]],
    "ci_lower": [model.conf_int().loc["Intercept", 0], model.conf_int().loc["Age_num", 0]],
    "ci_upper": [model.conf_int().loc["Intercept", 1], model.conf_int().loc["Age_num", 1]],
})
results.to_csv("logistic_regression_results.csv", index=False)
print("\nSaved coefficient table -> logistic_regression_results.csv")
print(results.to_string(index=False))
