"""
BixBench bix-52-q7 — How many sites are removed when filtering sites that do not
show >90% or <10% methylation in Zebra Finch?

Input : data/ZF_AgeRelated_CpG_noMT_Final.csv
Unit  : ROW-LEVEL (each row = a CpG-site-per-sample observation)
Boundary : REMOVED set = 10 <= MethylationPercentage <= 90
           (a value at exactly 10% or exactly 90% does NOT show >90% or <10%, so it is removed)
"""
import pandas as pd

PATH = "data/ZF_AgeRelated_CpG_noMT_Final.csv"
df = pd.read_csv(PATH)
m = df["MethylationPercentage"]

total_rows = len(df)
print("total rows:", total_rows)
print("unique sites (Pos):", df["Pos"].nunique())
print("unique samples (Sample):", df["Sample"].nunique())
print("missing methylation:", m.isna().sum(), " | zero coverage rows:", (df["Coverage"] == 0).sum())

# --- Primary row-level filter ---
kept_rows = (m > 90) | (m < 10)              # shows >90% or <10%
removed_rows = (m >= 10) & (m <= 90)         # does NOT show >90% or <10%  -> [10, 90]
print("\n[ROW-LEVEL primary]")
print("  kept  (>90 or <10):", int(kept_rows.sum()))
print("  removed [10,90]:   ", int(removed_rows.sum()))
assert kept_rows.sum() + removed_rows.sum() == total_rows
print("  >90 rows:", int((m > 90).sum()), "| <10 rows:", int((m < 10).sum()))
print("  ==90 rows:", int((m == 90).sum()), "| ==10 rows:", int((m == 10).sum()))

# --- Alternative boundary (exclusive) ---
removed_excl = (m > 10) & (m < 90)
print("\n[alternative boundary] removed exclusive (10,90):", int(removed_excl.sum()))

# --- Unique-site alternatives ---
g = df.groupby("Pos")["MethylationPercentage"].agg(["min", "max", "mean"])
extreme_any = (g["min"] < 10) | (g["max"] > 90)
print("\n[UNIQUE-SITE alternatives]")
print("  sites with ANY sample row extreme (>90 or <10):", int(extreme_any.sum()))
print("  sites removed if requiring at least one extreme row (no extreme row in ANY sample):",
      int((~extreme_any).sum()))
agg = df.groupby("Pos").agg(M=("CountMethylated", "sum"), N=("CountNonMethylated", "sum"))
agg["pct"] = 100 * agg["M"] / (agg["M"] + agg["N"])
print("  coverage-weighted per-site pct range: {:.2f}–{:.2f}  ->  sites with aggregated pct >90 or <10: {}"
      .format(agg["pct"].min(), agg["pct"].max(), int(((agg["pct"] > 90) | (agg["pct"] < 10)).sum())))

print("\nHEADLINE: 19,159 rows removed under row-level counting with inclusive [10, 90] boundaries.")
