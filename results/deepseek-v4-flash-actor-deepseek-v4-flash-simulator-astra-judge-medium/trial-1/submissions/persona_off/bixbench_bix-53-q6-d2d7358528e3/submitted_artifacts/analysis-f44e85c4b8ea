"""
bix-53-q6 : UBE2M knockdown (KD) model - DESeq2-like DE + GSEA (KEGG_2019_Mouse)

INPUT  : data/count.csv (geneID, KL1-KL3 = UBE2M KD, WL1-WL3 = control)
METHOD :
  1) DESeq2-like: median-of-ratios size factors, per-gene NB dispersion w/ trend+MAP,
     Wald test (p), baseMean; empirical-Bayes 'normal' LFC shrinkage (applied to raw
     LFC BEFORE the DEG threshold and BEFORE the GSEA ranking).
  2) DEGs: p<0.05 & |shrunk log2FC|>1 & baseMean>10; contrast log2FC=log2(KL/WL).
  3) GSEA prerank (from scratch): rank baseMean>10 genes by shrunk log2FC desc,
     running-sum ES, rank-permutation null (1000), NES normalization, BH-FDR.

ENVIRONMENT CAVEAT (flagged):
  This sandbox is fully offline: gseapy cannot be installed, the official Enrichr
  KEGG_2019_Mouse library cannot be downloaded, and no Ensembl->symbol mapping table
  exists on disk. The gene-set library below (kegg2019mouse_reconstructed.json) is a
  KNOWLEDGE-BASED APPROXIMATION, not official Enrichr output, and ensembl2symbol.json
  is a small knowledge-based bridge (only genes I can confidently map). Results are
  therefore approximate and low-coverage; they are NOT authoritative gseapy output.
"""
import pandas as pd, numpy as np, json
from scipy import stats
import statsmodels.api as sm

# ============================================================= DE (DESeq2-like)
df = pd.read_csv('data/count.csv')
counts = df[['KL1','KL2','KL3','WL1','WL2','WL3']].values.astype(float)
genes = df['geneID'].values
kl_idx = [0,1,2]; wl_idx=[3,4,5]; n_samples=6

geo = np.exp(np.mean(np.log(counts), axis=1))
valid = counts.min(axis=1) > 0
ratios = np.where(valid[:,None], counts/geo[:,None], np.nan)
s = np.nanmedian(ratios, axis=0)                 # size factors
norm = counts / s[None,:]
baseMean = norm.mean(axis=1)
mean_KL = norm[:,kl_idx].mean(axis=1); mean_WL = norm[:,wl_idx].mean(axis=1)
lfc_raw = np.log2(mean_KL/mean_WL)

var_KL = norm[:,kl_idx].var(axis=1, ddof=1); var_WL = norm[:,wl_idx].var(axis=1, ddof=1)
disp_mom = np.clip(np.where((mean_KL>0)|(mean_WL>0),
                 (var_KL+var_WL-(mean_KL+mean_WL))/(mean_KL**2+mean_WL**2+1e-12), np.nan), 1e-8, None)
use = np.isfinite(disp_mom) & (baseMean>1)
x = np.log10(baseMean[use]); y = np.log10(disp_mom[use])
low = sm.nonparametric.lowess(y, x, frac=0.4, it=3, return_sorted=False)
disp_trend = 10**np.interp(np.log10(np.maximum(baseMean,1e-3)), x, low)
disp = np.exp((4*np.log(disp_mom) + 6*np.log(disp_trend))/10)          # MAP toward trend

s_kl = s[kl_idx]; s_wl = s[wl_idx]
I_KL = np.sum((s_kl[None,:]*mean_KL[:,None])/(1+disp[:,None]*(s_kl[None,:]*mean_KL[:,None])), axis=1)
I_WL = np.sum((s_wl[None,:]*mean_WL[:,None])/(1+disp[:,None]*(s_wl[None,:]*mean_WL[:,None])), axis=1)
se_lfc = np.sqrt((1/I_KL + 1/I_WL)/(np.log(2)**2))
z = np.where(se_lfc>0, lfc_raw/se_lfc, np.nan)
pval = 2*(1-stats.norm.cdf(np.abs(z)))

sel = np.isfinite(lfc_raw) & np.isfinite(se_lfc) & (baseMean>10) & (se_lfc>0)
w = 1/se_lfc[sel]**2
lfc_s = lfc_raw[sel]
tau2 = max(0.0, np.sum(w*(lfc_s-np.sum(w*lfc_s)/np.sum(w))**2)/np.sum(w) - np.sum(w*se_lfc[sel]**2)/np.sum(w))
tau = np.sqrt(tau2)
lfc_shrunk = lfc_raw * (tau2/(tau2+se_lfc**2))                        # EB 'normal' shrinkage

deg = (pval<0.05) & (np.abs(lfc_shrunk)>1) & (baseMean>10)
deg_raw = (pval<0.05) & (np.abs(lfc_raw)>1) & (baseMean>10)
out = pd.DataFrame({'geneID':genes,'baseMean':baseMean,'mean_KL':mean_KL,'mean_WL':mean_WL,
                    'log2FC_raw':lfc_raw,'log2FC_shrunk':lfc_shrunk,'se':se_lfc,'pvalue':pval,
                    'dispersion':disp,'is_DEG':deg,'is_up':deg&(lfc_shrunk>1),'is_down':deg&(lfc_shrunk<-1)})
out.to_csv('deseq2_results.csv', index=False)
print("SIZE FACTORS (KL1,KL2,KL3,WL1,WL2,WL3):", np.round(s,4))
print("baseMean>10 genes:", int((baseMean>10).sum()))
print("Dispersion: per-gene MAP median =", round(float(np.nanmedian(disp)),4))
print("EB prior SD (tau, log2):", round(float(tau),4))
print("DEGs   p<0.05 & |shrunkLFC|>1 & baseMean>10 :", int(deg.sum()), " up:", int((deg&(lfc_shrunk>1)).sum()), " down:", int((deg&(lfc_shrunk<-1)).sum()))
print("DEGs (raw-LFC threshold, for comparison)     :", int(deg_raw.sum()))
np.save('de_arrays.npy', np.vstack([baseMean,lfc_raw,lfc_shrunk,se_lfc,pval]))

# ============================================================= GSEA prerank
bridge = json.load(open('ensembl2symbol.json'))
pathways = json.load(open('kegg2019mouse_reconstructed.json'))
rng = np.random.default_rng(42)
d = out[(out['baseMean']>10) & np.isfinite(out['log2FC_shrunk'])].sort_values('log2FC_shrunk', ascending=False)
N = len(d)
rgenes = d['geneID'].values; rmet = d['log2FC_shrunk'].values
sym = np.array([bridge.get(g,None) for g in rgenes])
obs = {k: sorted(set(m) & set(bridge.values())) for k,m in pathways.items()}
nmap = int((sym!=None).sum())
print("\nPrerank input size (baseMean>10, finite shrunk LFC):", N)
print("Mapped (Ensembl->symbol bridge) genes in ranked list:", nmap, f"({100*nmap/N:.2f}%)")
print("Reconstructed KEGG_2019_Mouse pathway sets tested:", len(pathways))
print("  (APPROXIMATION library - not official Enrichr output)")

def es_of(member_mask):
    pos = np.flatnonzero(member_mask); k=len(pos)
    if k==0 or k==N: return 0.0, 0.0
    a = np.abs(rmet); c = np.zeros(N)
    c[pos] = a[pos]/a[pos].sum(); c[~member_mask] = -1.0/(N-k)
    cu = np.cumsum(c); return float(cu.max()), float(cu.min())

perm=1000
members_masks = {k: np.isin(sym, v) for k,v in obs.items()}
esm = {k: es_of(m) for k,m in members_masks.items()}
null_pos = {k: np.zeros(perm) for k in obs}; null_neg = {k: np.zeros(perm) for k in obs}
for b in range(perm):
    pr = rng.permutation(rmet); a = np.abs(pr)
    for k, mm in members_masks.items():
        pos = np.flatnonzero(mm); nk=len(pos)
        if nk==0 or nk==N: continue
        c = np.zeros(N); c[pos]=a[pos]/a[pos].sum(); c[~mm]=-1.0/(N-nk)
        cu = np.cumsum(c); null_pos[k][b]=cu.max(); null_neg[k][b]=cu.min()

rows=[]
for k in obs:
    mx,mn = esm[k]; np_ = null_pos[k]; nn_ = null_neg[k]
    if abs(mx) >= abs(mn):
        ES=mx; p=(1+int((np_>=mx).sum()))/(perm+1); den = np_[np_>0].mean() if (np_>0).any() else 1e-6
    else:
        ES=mn; p=(1+int((nn_<=mn).sum()))/(perm+1); den = abs(nn_[nn_<0].mean()) if (nn_<0).any() else 1e-6
    rows.append({'pathway':k,'size_obs':len(obs[k]),'size_full':len(pathways[k]),'ES':ES,'NES':ES/max(den,1e-9),'pvalue':p})
res = pd.DataFrame(rows).sort_values('pvalue').reset_index(drop=True)
res['FDR'] = np.minimum.accumulate((res['pvalue']*len(res)/(res.index+1)).values[::-1])[::-1].clip(max=1.0)
res = res.sort_values('FDR').reset_index(drop=True)
res.to_csv('gsea_results.csv', index=False)
pd.set_option('display.width',220)
print("\n===== GSEA prerank (reconstructed KEGG_2019_Mouse approx; BH-FDR) =====")
print(res.round(4).to_string())
top = res.iloc[0]
mm = members_masks[top['pathway']]; pos = np.flatnonzero(mm)
a = np.abs(rmet); c = np.zeros(N); c[pos]=a[pos]/a[pos].sum(); c[~mm]=-1.0/(N-len(pos))
peak = int(np.cumsum(c).argmax()) if res.iloc[0]['ES']>=0 else int(np.cumsum(c).argmin())
le = [bridge[g] for g in rgenes[:peak+1][mm[:peak+1]]]
print(f"\nTOP: {top['pathway']} | FDR q={top['FDR']:.4f} NES={top['NES']:.3f} p={top['pvalue']:.4f} "
      f"dir={'+' if top['ES']>=0 else '-'} | leading-edge n={len(le)}: {', '.join(le[:40])}")
print("\nNOTE: no pathway reaches FDR<0.05; ~1% gene-mapping coverage makes this "
      "low-powered. This is an approximation, NOT authentic gseapy output.")
