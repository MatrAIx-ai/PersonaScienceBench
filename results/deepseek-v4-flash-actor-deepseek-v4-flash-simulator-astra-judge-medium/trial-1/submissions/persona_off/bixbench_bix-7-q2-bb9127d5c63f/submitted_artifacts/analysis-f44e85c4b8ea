#!/usr/bin/env python3
"""
BixBench bix-7-q2: average number of CHIP variants per sample after
filtering out intronic, intergenic, and UTR variants.

APPROVED PRIMARY RULE
---------------------
1. Counted variant = one row with Zygosity in {Heterozygous, Homozygous Variant}.
   Reference and NaN-zygosity rows are excluded (no alternate allele called).
2. Filter OUT rows whose Sequence Ontology (Combined) is one of:
   intron_variant, intergenic_variant, 5_prime_UTR_variant,
   3_prime_UTR_variant, 5_prime_UTR_premature_start_codon_gain_variant
   (strict/UTR-inclusive; intergenic_variant never occurs -> no-op).
3. All other SO classes are retained.
4. No additional gene-panel filter (the per-sample files are the CHIP
   deliverables; In_CHIP=True on 100% of rows).
5. Unit = one row per variant call; denominator = all 86 sample files.

SENSITIVITIES (secondary, for transparency):
  (a) lenient UTR: drop only {intron_variant, intergenic_variant,
      5_prime_UTR_variant, 3_prime_UTR_variant} (keep premature-start-codon rows).
  (b) panel-restricted: additionally keep only rows whose In_CHIP Match
      column (col30) is exactly one of the 56 genes in
      230214_Schenz_et_al_2022_CHIP_Genes.xlsx (no alias resolution).
"""
import glob
import os
import re
from collections import Counter

import pandas as pd

DATA_DIR = "data/CHIP_DP10_GQ20_PASS"
CHIP_GENES_PATH = "data/230214_Schenz_et_al_2022_CHIP_Genes.xlsx"
TRIO_PATH = "data/230215_Trio_Status.xlsx"

FILTER_STRICT = {
    "intron_variant",
    "intergenic_variant",
    "5_prime_UTR_variant",
    "3_prime_UTR_variant",
    "5_prime_UTR_premature_start_codon_gain_variant",
}
FILTER_LENIENT = {
    "intron_variant",
    "intergenic_variant",
    "5_prime_UTR_variant",
    "3_prime_UTR_variant",
}
VARIANT_ZYGS = {"Heterozygous", "Homozygous Variant"}


def load(f):
    df = pd.read_excel(f, header=None)
    body = df.iloc[2:].copy()
    body.columns = [
        "Cp", "RefAlt", "PF", "IF", "Zyg", "ME", "IH", "DP", "GQ", "VAF",
        "SF", "M1", "Gene", "SO", "Effect", "TX", "EX", "HGVSC", "HGVSP",
        "Filt", "gnAF", "gnAC", "gnAN", "gnHom", "ClVid", "ClCls", "ClAgg",
        "ClRev", "ClCond", "InCHIP", "M_CHIP", "InDNAm", "M_DNAm",
    ]
    return body


def main():
    files = sorted(glob.glob(os.path.join(DATA_DIR, "*.xlsx")))
    panel = set(
        pd.read_excel(CHIP_GENES_PATH, header=None)[0].dropna().astype(str)
    )
    trio = pd.read_excel(TRIO_PATH)

    rows_all = 0
    rows_not_chip_flag = 0
    so_full = Counter()
    per_sample = []

    for f in files:
        sid = os.path.basename(f).replace("230209_Exome_GRCh38_CHIP_", "").replace(".xlsx", "")
        b = load(f)
        rows_all += len(b)
        rows_not_chip_flag += int((b["InCHIP"].astype(str) != "True").sum())
        so_full.update(b["SO"].fillna("<NA>").astype(str))

        var = b[b["Zyg"].isin(VARIANT_ZYGS)]
        kept_strict = var[~var["SO"].isin(FILTER_STRICT)]
        kept_lenient = var[~var["SO"].isin(FILTER_LENIENT)]
        kept_panel = kept_strict[kept_strict["M_CHIP"].isin(panel)]  # Match col, no aliases

        per_sample.append({
            "sample": sid,
            "n_variant_rows": int(len(var)),
            "strict": int(len(kept_strict)),
            "lenient": int(len(kept_lenient)),
            "strict_panel": int(len(kept_panel)),
        })

    pdf = pd.DataFrame(per_sample)
    n = len(pdf)
    print(f"Sample workbooks: {n}")
    print(f"Total data rows across files: {rows_all}; rows with In_CHIP != True: {rows_not_chip_flag}")
    print("\nSequence Ontology (Combined) across ALL rows:")
    for k, v in so_full.most_common():
        print(f"  {k}: {v}")

    print("\n--- Per-sample retained counts: describe ---")
    print(pdf[["n_variant_rows", "strict", "lenient", "strict_panel"]].describe().to_string())

    total_strict = pdf["strict"].sum()
    total_lenient = pdf["lenient"].sum()
    total_panel = pdf["strict_panel"].sum()

    print("\n===== PRIMARY RESULT (strict/UTR-inclusive, no panel filter) =====")
    print(f"  total retained variant rows = {total_strict}")
    print(f"  average per sample = {total_strict / n:.4f}  (n = {n})")

    print("\n===== SENSITIVITIES (secondary) =====")
    print(f"  lenient UTR      : total {total_lenient}, mean {total_lenient / n:.4f}")
    print(f"  strict + panel   : total {total_panel}, mean {total_panel / n:.4f}")

    out = "analysis/per_sample_counts.csv"
    pdf.to_csv(out, index=False)
    print(f"\nWrote per-sample table -> {out}")


if __name__ == "__main__":
    main()
