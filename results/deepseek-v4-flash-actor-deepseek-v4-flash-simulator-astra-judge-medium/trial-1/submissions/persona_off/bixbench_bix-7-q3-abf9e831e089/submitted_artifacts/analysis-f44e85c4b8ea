"""
Count CHIP variants remaining after removing reference calls.

Dataset: 86 per-sample CHIP workbooks in data/CHIP_DP10_GQ20_PASS/
Each workbook = single sheet "(Variants N) Filter Variants", two-row header.
Per-sample call = Zygosity column (index 4); values: Reference / Heterozygous /
Homozygous Variant / blank(no call). In_CHIP = index 29 (gene in 56-gene CHIP list).

Headline result (per approved approach):
  CHIP variants = rows with Zygosity in {Heterozygous, Homozygous Variant}
                  and In_CHIP == True, summed across all 86 samples.
  Reference rows and blank/no-call rows contribute 0.
"""
import openpyxl, glob, os, csv
from collections import Counter, defaultdict

DATA = 'data/CHIP_DP10_GQ20_PASS'
STATUS_FILE = 'data/230215_Trio_Status.xlsx'
GENES_FILE = 'data/230214_Schenz_et_al_2022_CHIP_Genes.xlsx'

# ---- CHIP gene list ----
wb = openpyxl.load_workbook(GENES_FILE, data_only=True)
chip_genes = [r[0] for r in wb['Sheet1'].iter_rows(values_only=True) if r[0] is not None]
chip_set = {g.upper() for g in chip_genes}
print(f'CHIP gene list: {len(chip_set)} genes')

# ---- Trio status ----
wb = openpyxl.load_workbook(STATUS_FILE, data_only=True)
status = {}
for r in wb['Sheet1'].iter_rows(values_only=True):
    if r[0] is None:
        continue
    sid = str(r[0]).strip()
    if sid == 'Sample ID':
        continue
    status[sid] = str(r[1]).strip()
print(f'Trio status entries: {len(status)}')

# ---- match file sample id to status id by prefix ----
def sample_of_filename(fname):
    base = os.path.basename(fname)
    return base.replace('230209_Exome_GRCh38_CHIP_', '').replace('.xlsx', '')

def status_id_of_sample(sid):
    # status ids have no suffix (179, 502, SRR...); file sample ids may add -P1 etc.
    if sid in status:
        return sid
    for k in status:
        if sid.startswith(k + '-'):
            return k
    return None

files = sorted(glob.glob(os.path.join(DATA, '*.xlsx')))
print(f'Workbook files: {len(files)}')

records = []
total_rows = 0
total_ref = 0
total_het = 0
total_hom = 0
total_nocall = 0
gene_mismatch = 0
inchip_mismatch = 0
unmapped = []

for f in files:
    sid = sample_of_filename(f)
    sid_status = status_id_of_sample(sid)
    if sid_status is None:
        unmapped.append(sid)
    status_val = status.get(sid_status, 'UNMAPPED') if sid_status else 'UNMAPPED'
    wb = openpyxl.load_workbook(f, data_only=True)
    sheets = [s for s in wb.sheetnames if 'Filter Variants' in s]
    assert len(sheets) == 1, f'{sid}: expected 1 Filter Variants sheet, got {sheets}'
    ws = wb[sheets[0]]
    rows = list(ws.iter_rows(values_only=True))
    # locate header row guard
    hidx = None
    for i, r in enumerate(rows[:4]):
        if r and r[0] == 'Chr:Pos':
            hidx = i
            break
    assert hidx is not None, f'{sid}: header not found'
    data = [r for r in rows[hidx + 1:] if r[0] is not None]

    n = len(data)
    n_ref = sum(1 for r in data if r[4] == 'Reference')
    n_het = sum(1 for r in data if r[4] == 'Heterozygous')
    n_hom = sum(1 for r in data if r[4] == 'Homozygous Variant')
    n_nc = sum(1 for r in data if r[4] is None)

    # consistency / guards
    for r in data:
        if str(r[29]) != 'True':
            inchip_mismatch += 1
        g = str(r[30]).upper() if r[30] else ''
        if g not in chip_set:
            gene_mismatch += 1

    variant = n_het + n_hom
    total_rows += n
    total_ref += n_ref
    total_het += n_het
    total_hom += n_hom
    total_nocall += n_nc

    records.append(dict(
        sample=sid, status=status_val, sheet=sheets[0],
        rows=n, reference=n_ref, heterozygous=n_het,
        homozygous_variant=n_hom, no_call=n_nc, variants=variant,
    ))
    wb.close()

# ---- Aggregates ----
print('\n==== HEADLINE RESULT ====')
print(f'Total CHIP variants (Heterozygous + Homozygous Variant, In_CHIP=True, summed over {len(files)} samples): '
      f'{total_het + total_hom}')
print(f'   Heterozygous: {total_het}')
print(f'   Homozygous Variant: {total_hom}')

print('\n==== Internal consistency ====')
print(f'Total data rows across all files: {total_rows}')
print(f'   Reference:        {total_ref}')
print(f'   Heterozygous:     {total_het}')
print(f'   Homozygous Variant: {total_hom}')
print(f'   No-call (blank):  {total_nocall}')
print(f'   sum check = {total_ref + total_het + total_hom + total_nocall} (must equal {total_rows})')
print(f'   reference+no-call (excluded) = {total_ref + total_nocall}')
print(f'In_CHIP != True rows: {inchip_mismatch}')
print(f'Matched-gene not in 56-gene list: {gene_mismatch}')
print(f'Unmapped-to-status files: {unmapped}')

print('\n==== Per-status breakdown ====')
by_status = defaultdict(lambda: [0, 0, 0, 0, 0])  # files, rows, ref, variants, nocall
for rec in records:
    s = rec['status']
    by_status[s][0] += 1
    by_status[s][1] += rec['rows']
    by_status[s][2] += rec['reference']
    by_status[s][3] += rec['variants']
    by_status[s][4] += rec['no_call']
for s in sorted(by_status):
    f, r, rf, v, nc = by_status[s]
    print(f'  {s:8s} files={f:3d} rows={r:6d} reference={rf:6d} variants={v:6d} no-call={nc}')

print('\n==== Per-sample breakdown (saved to analysis/per_sample_counts.csv) ====')
with open('analysis/per_sample_counts.csv', 'w', newline='') as fh:
    w = csv.DictWriter(fh, fieldnames=['sample', 'status', 'rows', 'reference',
                                       'heterozygous', 'homozygous_variant',
                                       'no_call', 'variants'])
    w.writeheader()
    for rec in sorted(records, key=lambda x: x['sample']):
        w.writerow({k: rec[k] for k in ['sample','status','rows','reference','heterozygous','homozygous_variant','no_call','variants']})

# show files with anomalies
print('Files with >3 no-call rows:')
for rec in sorted(records, key=lambda x: -x['no_call']):
    if rec['no_call'] > 3:
        print(f"  {rec['sample']:12s} rows={rec['rows']:4d} ref={rec['reference']:4d} "
              f"het={rec['heterozygous']:3d} hom={rec['homozygous_variant']:3d} "
              f"no_call={rec['no_call']:4d} variants={rec['variants']:4d}")

print('\nPer-sample list (top 12 by variants):')
for rec in sorted(records, key=lambda x: -x['variants'])[:12]:
    print(f"  {rec['sample']:12s} {rec['status']:8s} variants={rec['variants']:4d}")

print('\n---- Alternative readings (notes only) ----')
# unique variant loci across samples (after removing reference per sample)
loci = set()
for f in files:
    wb = openpyxl.load_workbook(f, data_only=True)
    sheets = [s for s in wb.sheetnames if 'Filter Variants' in s]
    ws = wb[sheets[0]]
    rows = list(ws.iter_rows(values_only=True))
    hidx = [i for i, r in enumerate(rows[:4]) if r and r[0] == 'Chr:Pos'][0]
    for r in rows[hidx + 1:]:
        if r[0] is None:
            continue
        if r[4] in ('Heterozygous', 'Homozygous Variant'):
            loci.add((r[0], r[1]))
    wb.close()
print(f'Unique variant loci across samples (dedup by Chr:Pos/Ref:Alt): {len(loci)}')

# Patients-only scope
pat = sum(rec['variants'] for rec in records if rec['status'] == 'Patient')
pat_files = sum(1 for rec in records if rec['status'] == 'Patient')
print(f'Patient-only variants (10 patients): {pat}')
