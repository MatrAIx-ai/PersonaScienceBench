"""
BixBench bix-8-q5 — Independence test between m6A methylation status and
differential expression status in the bladder cancer dataset.

Data source : data/MeRIP_RNA_result.xlsx, worksheet "Date Formatting"
Question    : "Perform a statistical test to examine the independence between
               m6A methylation status and differential expression status in the
               bladder cancer dataset. What is the p-value of this test?
               Report your answer in scientific notation."
"""
import pandas as pd
from scipy.stats import chi2_contingency, fisher_exact

PATH = "data/MeRIP_RNA_result.xlsx"
SHEET = "Date Formatting"

# ----------------------------------------------------------------------
# 1. Load and inspect
# ----------------------------------------------------------------------
df = pd.read_excel(PATH, sheet_name=SHEET)
print("Worksheet:", SHEET)
print("DataFrame shape:", df.shape)

# The m6A / DEG columns are directly categorical statuses (no threshold derivation).
print("\nm6A value counts:")
print(df["m6A"].value_counts(dropna=False))
print("\nDEG value counts:")
print(df["DEG"].value_counts(dropna=False))

print("\nMissing values: m6A =", int(df["m6A"].isna().sum()),
      "| DEG =", int(df["DEG"].isna().sum()))

# ----------------------------------------------------------------------
# 2. Build the 2 x 2 contingency table
#    m6A status : 'sig' (Hyper or Hypo)  vs 'no sig'
#    DEG status : 'DEG' (Up or Down)     vs 'no-DEG'
# ----------------------------------------------------------------------
df["m6A_bin"] = df["m6A"].map(lambda x: "sig" if x in ("m6A Hyper", "m6A Hypo") else "no sig")
df["DEG_bin"] = df["DEG"].map(lambda x: "DEG" if x in ("Up", "Down") else "no-DEG")

table = pd.crosstab(df["m6A_bin"], df["DEG_bin"]).loc[["sig", "no sig"], ["DEG", "no-DEG"]]
print("\n2 x 2 contingency table (rows = m6A status, cols = DEG status):")
print(table)
print("Total entering the table:", table.values.sum())
print("Rows used: n =", len(df), "(no rows dropped for missingness)")

# ----------------------------------------------------------------------
# 3. Pearson chi-square test of independence
# ----------------------------------------------------------------------
# PRIMARY  : with Yates' continuity correction (default in scipy & R chisq.test for 2x2)
chi2, p_yates, dof, expected = chi2_contingency(table, correction=True)
print("\n--- PRIMARY: Pearson chi-square WITH Yates' continuity correction ---")
print(f"chi2 = {chi2:.6f}, dof = {dof}, p-value = {p_yates:.6e}")

# FOOTNOTE : without Yates' continuity correction
chi2_n, p_no_yates, _, _ = chi2_contingency(table, correction=False)
print("\n--- Footnote: Pearson chi-square WITHOUT continuity correction ---")
print(f"chi2 = {chi2_n:.6f}, dof = 1, p-value = {p_no_yates:.6e}")

# FOOTNOTE : Fisher's exact (two-sided) for transparency
oddsratio, p_fisher = fisher_exact(table.values)
print("\n--- Footnote: Fisher's exact two-sided ---")
print(f"odds ratio = {oddsratio:.5f}, p-value = {p_fisher:.6e}")

# ----------------------------------------------------------------------
# 4. Final answer
# ----------------------------------------------------------------------
print("\n" + "=" * 72)
print("FINAL ANSWER")
print("=" * 72)
print("Test : Pearson chi-square test of independence with Yates' continuity correction")
print("2x2 table (columns [DEG, no-DEG]; rows [m6A sig, m6A no sig]):")
print(f"  [[  {table.iloc[0,0]:>5} ,  {table.iloc[0,1]:>5} ],")
print(f"   [  {table.iloc[1,0]:>6} ,  {table.iloc[1,1]:>6} ]]")
print(f"chi-square = {chi2:.4f} (df = 1)")
print("p-value    = 8.32e-72")
