#!/usr/bin/env python3
"""
BixBench task: bix-9-q5
In which tissue type do bad responders show the highest number of significantly
differentially expressed (lfc>0.5 and basemean>10) genes compared to controls?

Approach (approved):
 - Data: data/Data_deposition_RNAseq_Paroxetine_2017.xlsx
 - Samples keyed by Code = Response_TissueN, identical across Mapping_statistics and NormCount.
 - No raw count matrix is supplied; the workbook contains precomputed DESeq2 outputs
   ('DESeq, Comparison N, exclude outliers') with baseMean, baseMeanA/B, log2FoldChange, padj.
 - Bad-responder vs control comparisons (verified by ratio matching of baseMeanA/B to
   per-group normalized-count means) are:
       Comparison 2 = Control vs bad_responder, baseline_blood
       Comparison 5 = Control vs bad_responder, dentate_gyrus
       Comparison 8 = Control vs bad_responder, final_blood
 - Primary filter (question's stated cutoffs): log2FoldChange > 0.5 and baseMean > 10,
   direction = bad responders up-regulated vs controls.
 - Robustness variants checked: |lfc|>0.5; plus padj<0.05 variants; and the deposition's
   own U/D DEG flags.
"""
import pandas as pd
import numpy as np

XLSX = 'data/Data_deposition_RNAseq_Paroxetine_2017.xlsx'
xl = pd.ExcelFile(XLSX)

# ---------------------------------------------------------------- Mapping_statistics
ms = xl.parse('Mapping_statistics')
print('=== Mapping_statistics ===')
print('rows:', len(ms), '| Response:', dict(ms['Response'].value_counts()))
print('Tissue:  ', dict(ms['Tissue'].value_counts()))
print('Response x Tissue:')
print(pd.crosstab(ms['Response'], ms['Tissue']))

# ---------------------------------------------------------------- NormCount
raw = xl.parse('NormCount', header=None)
labels3 = [str(x) if not pd.isna(x) else '' for x in raw.iloc[3].tolist()]
sample_cols = list(range(2, 92))                      # 90 sample count columns
data = raw.iloc[4:].reset_index(drop=True)
gene_ids = raw.iloc[4:, 1].astype(str).tolist()

# Cross-check sample keying
ms_codes = ms['Code'].astype(str).tolist()
norm_codes = [labels3[c] for c in sample_cols]
assert ms_codes == norm_codes, 'sample key order mismatch'
assert set(ms_codes) == set(norm_codes)
print('\n=== Keying check ===')
print('Mapping Code == NormCount sample-column order:', ms_codes == norm_codes)
print('missing in either sheet:', set(ms_codes) ^ set(norm_codes))

def numcol(i):
    return pd.to_numeric(data.iloc[:, i], errors='coerce')

# Per-group mean of normalized counts -> verify precomputed comparison pairing
TISSUE_FULL = {'baseline': 'baseline_blood', 'dentate': 'dentate_gyrus', 'final': 'final_blood'}
groups = {}
for ci in sample_cols:
    resp_tissue = norm_codes[ci - 2].rsplit('_', 1)[0]
    resp, tissue = resp_tissue.rsplit('_', 1)
    groups.setdefault((resp, TISSUE_FULL[tissue]), []).append(ci)
gmeans = {k: np.mean(np.column_stack([numcol(c).values for c in cols]), axis=1)
          for k, cols in groups.items()}

comp_start = [98, 107, 116, 125, 134, 143, 152, 161, 170]
pairings = {
    1: ('Control', 'baseline_blood', 'good_responder', 'baseline_blood'),
    2: ('Control', 'baseline_blood', 'bad_responder',  'baseline_blood'),
    3: ('bad_responder', 'baseline_blood', 'good_responder', 'baseline_blood'),
    4: ('Control', 'dentate_gyrus', 'good_responder', 'dentate_gyrus'),
    5: ('Control', 'dentate_gyrus', 'bad_responder',  'dentate_gyrus'),
    6: ('bad_responder', 'dentate_gyrus', 'good_responder', 'dentate_gyrus'),
    7: ('Control', 'final_blood', 'good_responder', 'final_blood'),
    8: ('Control', 'final_blood', 'bad_responder',  'final_blood'),
    9: ('bad_responder', 'final_blood', 'good_responder', 'final_blood'),
}

print('\n=== Recover precomputed comparison pairings (log2-ratio correlation) ===')
verified = {}
for ci, cs in enumerate(comp_start, start=1):
    bmA = numcol(cs + 1).values; bmB = numcol(cs + 2).values
    rAB = np.log2(np.maximum(bmA, 1e-6) / np.maximum(bmB, 1e-6))
    best = (None, None, -1)
    for kA, mA in gmeans.items():
        for kB, mB in gmeans.items():
            if kA == kB:
                continue
            r = np.log2(np.maximum(mA, 1e-6) / np.maximum(mB, 1e-6))
            m = np.isfinite(rAB) & np.isfinite(r)
            corr = np.corrcoef(rAB[m], r[m])[0, 1]
            if corr > best[2]:
                best = (kA, kB, corr)
    exp = f"{pairings[ci][0]}_{pairings[ci][1]} vs {pairings[ci][2]}_{pairings[ci][3]}"
    got = f"{best[0][0]}_{best[0][1]} vs {best[1][0]}_{best[1][1]}"
    verified[ci] = (exp == got)
    print(f'  Comparison {ci}: expected={exp:<45s} recovered={got:<45s} r={best[2]:.3f} match={verified[ci]}')
assert all(verified.values()), 'pairing verification failed'
print('  All 9 comparison pairings recovered correctly.')

# ---------------------------------------------------------------- Main counts
print('\n=== Bad responder vs control: DEG counts per tissue ===')
# comparison -> tissue label
bad_control = {2: 'baseline_blood', 5: 'dentate_gyrus', 8: 'final_blood'}
tissue_results = {}
for ci, tissue in bad_control.items():
    cs = comp_start[ci - 1]
    bm   = numcol(cs).values
    lfc  = numcol(cs + 4).values
    padj = numcol(cs + 6).values
    Ak, At, Bk, Bt = pairings[ci]
    mA = gmeans[(Ak, At)]; mB = gmeans[(Bk, Bt)]
    log2BA = np.log2(np.maximum(mB, 1e-6) / np.maximum(mA, 1e-6))
    m = np.isfinite(lfc) & np.isfinite(log2BA)
    sgn = np.sign(np.corrcoef(lfc[m], log2BA[m])[0, 1])          # +1 => lfc is log2(bad/control)
    lfc_bad = lfc * sgn

    primary   = int(((lfc_bad > 0.5) & (bm > 10)).sum())          # question's exact cutoffs
    any_dir   = int(((np.abs(lfc_bad) > 0.5) & (bm > 10)).sum())
    up_padj   = int(((lfc_bad > 0.5) & (bm > 10) & (padj < 0.05)).sum())
    any_padj  = int(((np.abs(lfc_bad) > 0.5) & (bm > 10) & (padj < 0.05)).sum())
    degU = int((np.array(data.iloc[:, cs + 7].astype(str)) == 'U').sum())
    degD = int((np.array(data.iloc[:, cs + 7].astype(str)) == 'D').sum())
    tissue_results[tissue] = dict(primary=primary, any_dir=any_dir, up_padj=up_padj,
                                  any_padj=any_padj, preprint_DEG=degU + degD, sign=sgn)
    print(f'  {tissue:14s} lfc>0.5 & bm>10 = {primary:4d}   '
          f'|lfc|>0.5 & bm>10 = {any_dir:4d}   '
          f'+padj<0.05 (up) = {up_padj:4d}   '
          f'+padj<0.05 (any) = {any_padj:4d}   '
          f'deposition DEG flags = {degU+degD:4d}   sign(s)={int(sgn)}')

print('\n=== Winner per interpretation ===')
winner = {}
for variant in ['primary', 'any_dir', 'up_padj', 'any_padj', 'preprint_DEG']:
    w = max(tissue_results, key=lambda t: tissue_results[t][variant])
    winner[variant] = (w, tissue_results[w][variant])
    print(f'  {variant:12s}: winner = {w:14s} count = {tissue_results[w][variant]}')

primary_winner = winner['primary'][0]
print('\nRESULT: bad responders show the highest number of significantly DE genes')
print(f'(log2FoldChange>0.5, baseMean>10, vs controls) in: {primary_winner.upper()}')
print('Answer stable across all robustness variants:', len(set(w[0] for w in winner.values())) == 1)

# ---------------------------------------------------------------- persistence
# Save a compact evidence CSV of the per-tissue counts used for the comparison
ev = pd.DataFrame(tissue_results).T
ev.to_csv('workspace_bad_responder_DEG_summary.csv')
print('\nSaved evidence summary -> workspace_bad_responder_DEG_summary.csv')
print('EXECUTED_ANALYSIS=true')
