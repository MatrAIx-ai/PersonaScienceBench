"""
DiscoveryBench: In what centuries did we see the highest growth phase between 2000 BCE and 1100 BCE?
Author: research agent
Approach (approved):
  PRIMARY: per-century (standard n-th century BCE bins) aggregation of the two explicit growth-RATE series
           g_all_mean (KDE growth rate) and pollen_grate_100 (pollen % change); rank centuries with a
           transparent z-score composite; report raw means/medians.
  SECONDARY: capital.csv Z-indicator century-over-century changes, and pollen smooth/MEAN level rises.
  CAVEATS: 16th century BCE sign divergence between the two rate series is reported, not averaged away.
"""
import pandas as pd, numpy as np, json, os

OUT = "analysis_output"
os.makedirs(OUT, exist_ok=True)
pd.set_option('display.float_format', lambda v: f'{v:+.6f}')

# ---------- 1. Load ----------
ts = pd.read_csv('data/time_series_data.csv', index_col=0)          # yearly, CE -4100..-500
cap = pd.read_csv('data/capital.csv', decimal=',')                  # century, BCE 500..4300
cap['BCE'] = pd.to_numeric(cap['BCE'])
cap = cap.sort_values('BCE', ascending=False).reset_index(drop=True)
pol = pd.read_csv('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv',
                  index_col=0, decimal=',')                          # yearly, file newest->oldest
pol = pol.sort_values('CE', ascending=False).reset_index(drop=True)

ts['BCE'] = -ts['CE']
pol['BCE'] = -pol['CE']

# ---------- 2. Window ----------
w_ts = ts[(ts['BCE'] >= 1100) & (ts['BCE'] <= 2000)].copy()
w_pol = pol[(pol['BCE'] >= 1100) & (pol['BCE'] <= 2000)].copy()
capw  = cap[(cap['BCE'] >= 1100) & (cap['BCE'] <= 2000)].copy()
print('Window (2000-1100 BCE): time_series rows', len(w_ts),
      'CE', w_ts.CE.min(), '->', w_ts.CE.max(),
      'calBP', w_ts.calBP.min(), '->', w_ts.calBP.max())

# ---------- 3. Century binning (standard n-th century BCE) ----------
def std_century(bce):
    return ((bce - 1) // 100) + 1          # 15th c.BCE = 1500..1401, 14th = 1400..1301, ...
def label(c): return f"{c}th century BCE"

w_ts['century'] = w_ts['BCE'].apply(std_century)
w_pol['century'] = w_pol['BCE'].apply(std_century)

# ---------- 4. PRIMARY: per-century aggregation of growth-rate series ----------
r = w_ts.groupby('century').agg(
    g_mean   = ('g_all_mean', 'mean'),
    g_median = ('g_all_mean', 'median'),
    p_mean   = ('pollen_grate_100', 'mean'),
    p_median = ('pollen_grate_100', 'median'),
    n = ('CE', 'size'),
)
r.index.name = 'century'
r = r.sort_index(ascending=False)

# z-score composite (per-year z of each rate over the window, average z per century)
for col in ('g_all_mean', 'pollen_grate_100'):
    w_ts['z_' + col] = (w_ts[col] - w_ts[col].mean()) / w_ts[col].std()
w_ts['z_comp'] = (w_ts['z_g_all_mean'] + w_ts['z_pollen_grate_100']) / 2.0
zc = w_ts.groupby('century')['z_comp'].mean().sort_index(ascending=False)
zg = w_ts.groupby('century')['z_g_all_mean'].mean().sort_index(ascending=False)
zp = w_ts.groupby('century')['z_pollen_grate_100'].mean().sort_index(ascending=False)
r['z_g'] = zg; r['z_p'] = zp; r['z_comp'] = zc
r_final = r[['n','g_mean','g_median','z_g','p_mean','p_median','z_p','z_comp']]
print('\nPRIMARY - per-century growth-rate stats (standard n-th century BCE bins):')
print(r_final.round(5).to_string())

# ranking
rank = r_final['z_comp'].sort_values(ascending=False)
print('\nRanking by z-score composite (mean of per-year z across window):')
for i, (c, v) in enumerate(rank.items(), 1):
    print(f'  rank {i}: {label(c):18s} z_comp={v:+.4f}  g_mean={r_final.loc[c,"g_mean"]:+.4f}  p_mean={r_final.loc[c,"p_mean"]:+.4f}')

# raw-rate ranking (simple average of the two century means)
r_final['rate_avg'] = (r_final['g_mean'] + r_final['p_mean']) / 2
print('\nRanking by simple mean of the two century-level rate means:')
print(r_final[['g_mean','p_mean','rate_avg']].sort_values('rate_avg', ascending=False).round(5).to_string())

# peak years
print('\nPeak years (window): g_all_mean max at BCE', int(w_ts.loc[w_ts.g_all_mean.idxmax(),'BCE']),
      '; pollen_grate_100 max at BCE', int(w_ts.loc[w_ts.pollen_grate_100.idxmax(),'BCE']))

# fraction of positive-growth years per century (divergence documentation)
w_ts['pos_g']=(w_ts.g_all_mean>0).astype(int); w_ts['pos_p']=(w_ts.pollen_grate_100>0).astype(int)
frac = w_ts.groupby('century')[['pos_g','pos_p']].mean().sort_index(ascending=False)
print('\nFraction of years with positive growth per century:')
print(frac.round(3).to_string())

# ---------- 5. SECONDARY: capital Z century-over-century changes ----------
zcols = [c for c in cap.columns if c not in ('BCE','group','color')]
capw['Zmean'] = capw[zcols].mean(axis=1)
capw = capw.sort_values('BCE', ascending=False).reset_index(drop=True)
capw['century'] = capw['BCE'].apply(std_century)
capw['dZmean'] = capw['Zmean'].diff()
capw['dZmean'] = np.where(capw['BCE']==2000, np.nan, capw['dZmean'])
print('\nSECONDARY - capital Z-matrix: century rows, mean-Z level, century-over-century change (into that BCE row):')
print(capw[['BCE','century','Zmean','dZmean']].round(4).to_string())
print('Largest century-over-century capital-Z mean rise within window:',
      label(int(capw.loc[capw['dZmean'].idxmax(),'century'])), 'BCE row', int(capw.loc[capw['dZmean'].idxmax(),'BCE']),
      'dZmean=', round(capw['dZmean'].max(),4))
dZ = capw[zcols].diff().set_axis(capw['BCE'], axis=0)
print('\nSingle largest variable jumps per century (capital Z):')
for _, row in capw.iloc[1:].iterrows():
    jumps = dZ.loc[row['BCE']]
    top = jumps.idxmax()
    print(f"  into BCE {int(row['BCE'])} ({label(int(row['century']))}): {top} {jumps[top]:+.3f}")

# ---------- 6. SECONDARY: pollen smooth-level forward century rises ----------
lev = w_pol.groupby('century')[['MEAN','SMOOTH_MEAN_100y','SMOOTH_MEAN_250y']].mean().sort_index(ascending=False)
levdiff = lev.diff()
print('\nSECONDARY - pollen level forward century means and forward change (20th->...->11th = forward time):')
print(lev.round(3).to_string())
print('Forward century change (into the later century):')
print(levdiff.dropna().round(3).to_string())

# ---------- 7. Save outputs ----------
r_final.round(6).to_csv(os.path.join(OUT, 'primary_century_stats.csv'))
capw[['BCE','century','Zmean','dZmean']].round(6).to_csv(os.path.join(OUT, 'capital_century_changes.csv'), index=False)
lev.round(6).to_csv(os.path.join(OUT, 'pollen_level_century_means.csv'))
summary = {
    'window_rows_time_series': int(len(w_ts)),
    'top_century_by_z_comp': label(int(rank.index[0])),
    'z_comp_top': float(rank.iloc[0]),
    'g_mean_top': float(r_final.loc[rank.index[0], 'g_mean']),
    'p_mean_top': float(r_final.loc[rank.index[0], 'p_mean']),
    'second_century_by_z_comp': label(int(rank.index[1])),
    'z_comp_second': float(rank.iloc[1]),
    '16th_c_sign_divergence': {'g_mean': float(r_final.loc[16,'g_mean']),
                               'p_mean': float(r_final.loc[16,'p_mean']),
                               'z_comp': float(r_final.loc[16,'z_comp'])},
    'peak_years': {'g_all_mean_BCE': int(w_ts.loc[w_ts.g_all_mean.idxmax(),'BCE']),
                   'pollen_grate_100_BCE': int(w_ts.loc[w_ts.pollen_grate_100.idxmax(),'BCE'])},
    'capital_largest_Zmean_rise': {'century': label(int(capw.loc[capw['dZmean'].idxmax(),'century'])),
                                   'into_BCE': int(capw.loc[capw['dZmean'].idxmax(),'BCE']),
                                   'dZmean': float(capw['dZmean'].max())},
}
with open(os.path.join(OUT, 'summary.json'), 'w') as f:
    json.dump(summary, f, indent=2)
print('\nSaved outputs to', OUT)
print('\nSUMMARY JSON:'); print(json.dumps(summary, indent=2))
