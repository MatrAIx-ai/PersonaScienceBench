"""Main analysis: PC1 of a PCA on the forms of capital in hundred-year time slices.
Question: How were the Middle Neolithic (3400-3000 BCE) and Younger Neolithic
(2900-2300 BCE) phases characterized in terms of the first principal component?
Approved taxonomy (interpretation-only):
  symbolic : ZAxtSchwert (Hatchet&Sword), ZDolch (Dagger), Zhausgr (House Size)
  social   : ZCU_AU (Copper&Gold), Zamber (Amber), ZMonument (Monument Count)
  cultural : ZKeform (Pottery Form), Zkeverz (Pottery Decoration)
  economic : ZHort (Depot), ZSichel (Sickle), ZBeil (Axes&Celt), ZMW (Monument Size)
Raw loadings remain the primary evidence.
"""
import numpy as np, pandas as pd

rng = np.random.default_rng(2026)
DEC = {'ZAxtSchwert':'axt_schwert','ZDolch':'dagger','Zhausgr':'house_size',
       'ZCU_AU':'cu_au','Zamber':'amber','ZMonument':'monument_count',
       'ZKeform':'pottery_form','Zkeverz':'pottery_decoration',
       'ZHort':'depot','ZSichel':'sickle','ZBeil':'axes_celts','ZMW':'monument_size'}
TAX = {'symbolic':['ZAxtSchwert','ZDolch','Zhausgr'],
       'social':['ZCU_AU','Zamber','ZMonument'],
       'cultural':['ZKeform','Zkeverz'],
       'economic':['ZHort','ZSichel','ZBeil','ZMW']}

def parse(s): return pd.to_numeric(s.astype(str).str.replace(',', '.', regex=False), errors='coerce')

cap = pd.read_csv('data/capital.csv')
X = cap[list(DEC)].apply(parse).values            # 39 x 12, already z-scored -> correlation PCA
colnames = list(DEC.values())
assert X.shape == (39, 12) and np.all(np.isfinite(X))

def pca(mat):
    """Correlation PCA on columns that are z-scores (mean0,sd1)."""
    mt = mat - mat.mean(axis=0)
    mt = mt / np.sqrt(((mt**2).mean(axis=0)))      # enforce unit variance (safe even though z-scored)
    cov = mt.T @ mt / mt.shape[0]
    evals, evecs = np.linalg.eigh(cov)
    order = np.argsort(evals)[::-1]
    evals, evecs = evals[order], evecs[:, order]
    loadings = evecs * np.sqrt(evals)              # loadings in correlation-CA convention
    scores = mt @ evecs
    pv = evals / evals.sum() * 100
    return evals, loadings, scores, pv

print('='*104)
print('PRIMARY PCA: 39 hundred-year slices (BCE 4300..500) x 12 capital Z-variables')
print('='*104)
evals, loadings, scores, pv = pca(X)
for i in range(6):
    print(f'  PC{i+1}: eigenvalue={evals[i]:.3f}, explained variance={pv[i]:.2f}%  (cum={pv[:i+1].sum():.2f}%)')
pc1 = loadings[:, 0]
print('\nPC1 loadings (raw, orientation as computed):')
for c, l in sorted(zip(colnames, pc1), key=lambda t: -abs(t[1])):
    print(f'  {c:18s} loading = {l:+.3f}')
print('  (positive pole = variables elevated when PC1 score is high)')

# SIGN FIX: orient so largest-magnitude loading is positive
flip = -1.0 if pc1[np.argmax(np.abs(pc1))] < 0 else 1.0
pc1f = flip * pc1
scores_f = flip * scores[:, 0]
print(f'\nSIGN CONVENTION: flipped by factor {flip:.0f} so the largest |loading| becomes positive.')
print('  oriented PC1 loadings:')
for c, l in sorted(zip(colnames, pc1f), key=lambda t: -abs(t[1])):
    print(f'    {c:18s} loading = {l:+.3f}')

# per-slice PC1 scores table
out = pd.DataFrame({'BCE': cap.BCE, 'group': cap.group, 'PC1': scores_f})
pd.set_option('display.width', 220)
print('\nPer-slice oriented PC1 scores (all 39 slices):')
print(out.to_string(index=False))

print('\n' + '='*104)
print('PHASE CHARACTERIZATION (oriented PC1)')
print('='*104)
phases = [('Middle Neolithic (MN)',  'MN', 3400, 3000, 5),
          ('Younger Neolithic (SG)',  'SG', 2900, 2300, 7)]
pc_full = out.copy()
stats = {}
for name, g, hi, lo, n in phases:
    rows = pc_full[(pc_full.BCE <= hi) & (pc_full.BCE >= lo)]
    s = rows.PC1
    stats[name] = (rows.copy(), s)
    print(f'  {name} [{hi}-{lo} BCE, n={len(rows)}]:')
    print(f'    PC1 mean={s.mean():+.3f}  median={s.median():+.3f}  min={s.min():+.3f}  max={s.max():+.3f}')
    print(f'    all slices positive? {bool((s>0).all())}  all negative? {bool((s<0).all())}  sign-mixed? {bool(((s>0).any()) and ((s<0).any()))}')
    print('    group label present in capital.csv:', g in cap[cap.BCE.isin(rows.BCE)]['group'].values)

# transition: full century-level trajectory summary
print('\n  PC1 trajectory (oriented) BCE 4300 -> 500:')
traj = out.sort_values('BCE', ascending=False)
marks = [4300,4100,3900,3700,3500,3400,3100,3000,2900,2600,2300,2000,1700,1400,1100,800,500]
for b in marks:
    r = traj[traj.BCE == b]
    print(f'    BCE {b:5d}  PC1={r.PC1.values[0]:+.3f}  (group {r.group.values[0]})')

print('\n' + '='*104)
print('MN -> Younger Neolithic transition (first difference over the two phases)')
print('='*104)
mn, sg = stats['Middle Neolithic (MN)'][0], stats['Younger Neolithic (SG)'][0]
seq = pd.concat([mn.sort_values('BCE', ascending=False), sg.sort_values('BCE', ascending=False)], axis=0)
seq = seq.drop_duplicates('BCE')
for i in range(len(seq)-1):
    a, b = seq.iloc[i], seq.iloc[i+1]
    print(f'  {int(a.BCE)}->{int(b.BCE)} BCE : PC1 {a.PC1:+.3f} -> {b.PC1:+.3f}  (delta {b.PC1-a.PC1:+.3f})')
print(f'  mean PC1(SG) - mean PC1(MN) = {sg.PC1.mean()-mn.PC1.mean():+.3f}')
print(f'  delta of group centroids is significant/tight: MN sd={mn.PC1.std(ddof=1):.3f}, SG sd={sg.PC1.std(ddof=1):.3f}')

print('\n' + '='*104)
print('ROBUSTNESS CHECKS')
print('='*104)
# (a) 37-slice subset BCE 4100..500 (matching time_series_data CE%100==0)
sub = cap[cap.BCE <= 4100]
X2 = sub[list(DEC)].apply(parse).values
ev2, load2, score2, pv2 = pca(X2)
pc1b = load2[:, 0]; flip2 = -1.0 if pc1b[np.argmax(np.abs(pc1b))] < 0 else 1.0; pc1b *= flip2
corr_score = np.corrcoef(scores_f[np.where(cap.BCE<=4100)], flip2*score2[:,0])[0,1]
print(f'(a) 37-slice PCA (BCE 4100..500): PC1 explained {pv2[0]:.2f}%')
print(f'    loading cos-similarity vs primary: {np.dot(pc1f, pc1b)/(np.linalg.norm(pc1f)*np.linalg.norm(pc1b)):.4f}')
print(f'    score correlation vs primary:      {corr_score:.4f}')
# (b) without ZSichel
cols_no = [c for c in DEC if c != 'ZSichel']
X3 = cap[cols_no].apply(parse).values
ev3, load3, score3, pv3 = pca(X3)
sel = [i for i,c in enumerate(DEC) if c != 'ZSichel']
pc1c = load3[:, 0]; flip3 = -1.0 if pc1c[np.argmax(np.abs(pc1c))] < 0 else 1.0; pc1c *= flip3
corr_no = np.corrcoef(scores_f, flip3*score3[:,0])[0,1]
print(f'(b) 11-var PCA (drop ZSichel): PC1 explained {pv3[0]:.2f}%; score corr vs primary {corr_no:.4f}')

print('\n' + '='*104)
print('POLLEN-OPENNESS PC1 AS DISTINCT CONTEXTUAL CORRELATE (not an input to capital PCA)')
print('='*104)
po = pd.read_csv('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv')
po['BCE'] = -po.CE
po['pollen100'] = parse(po['SMOOTH_MEAN_100y'])
po['pollen_mean'] = parse(po['MEAN'])
m = pd.merge(out[['BCE','PC1']], po[['BCE','pollen100','pollen_mean']], on='BCE', how='inner')
m = m.sort_values('BCE', ascending=False)
print(f'  shared century slices with pollen data: n={len(m)} (BCE {m.BCE.max()}..{m.BCE.min()})')
print(f'  corr(capitalPC1, pollen SMOOTH_MEAN_100y) = {m.PC1.corr(m.pollen100):+.3f}')
print(f'  corr(capitalPC1, pollen MEAN)             = {m.PC1.corr(m.pollen_mean):+.3f}')
mp = m.dropna()
for _, r in mp.iterrows():
    print(f'    BCE {int(r.BCE):5d}  capPC1={r.PC1:+.3f}  pollen100={r.pollen100:+.3f}')
# per-phase pollen stats
for name, g, hi, lo, n in phases:
    rows = mp[(mp.BCE <= hi) & (mp.BCE >= lo)]
    print(f'  {name}: mean pollen100={rows.pollen100.mean():+.3f}, mean capitalPC1={rows.PC1.mean():+.3f} (n={len(rows)})')

print('\nDone.')
