"""Inspection of the three staged datasets (DiscoveryBench archaeology episode).
Run: python3 inspect_data.py
"""
import pandas as pd, numpy as np

DATA = {
  'capital': 'data/capital.csv',
  'time_series': 'data/time_series_data.csv',
  'pollen_openness': 'data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv',
}

def parse(s):
    return pd.to_numeric(s.astype(str).str.replace(',', '.', regex=False), errors='coerce')

print('#'*100)
print('# 1. SCHEMAS')
print('#'*100)
frames = {}
for name, path in DATA.items():
    df = pd.read_csv(path)
    frames[name] = df
    print(f'\n== {name} ({path}) shape={df.shape} ==')
    print(df.dtypes.to_string())
    print('nulls:'); print(df.isna().sum().to_string())

print('\n' + '#'*100)
print('# 2. TIME AXES / SIGN CONVENTIONS')
print('#'*100)
ts, po, cap = frames['time_series'], frames['pollen_openness'], frames['capital']
print('time_series: CE range', ts.CE.min(), '..', ts.CE.max(), '| calBP', ts.calBP.min(), '..', ts.calBP.max())
print('  calBP == 1950 - CE?', np.allclose(ts.calBP, 1950 - ts.CE), '| annual step =', np.unique(np.diff(ts.CE)))
print('capital: BCE range', cap.BCE.min(), '..', cap.BCE.max(), '| step =', sorted(cap.BCE.diff().dropna().unique()))
print('pollen_openness: CE range', po.CE.min(), '..', po.CE.max(), '| calBP', po.calBP.min(), '..', po.calBP.max(),
      '| calBP==1950-CE?', np.allclose(po.calBP, 1950 - po.CE), '| CE==Unnamed:0?', np.allclose(po.CE, po['Unnamed: 0']))

print('\ncapital.csv phase groups (as-provided labels):')
for g, sub in cap.groupby('group', sort=False):
    print(f'  {g}: BCE {sub.BCE.min()}..{sub.BCE.max()}  (n={len(sub)})  [target MN=3400-3000 BCE; YoungerNeolithic/SG=2900-2300 BCE]')

print('\n' + '#'*100)
print('# 3. NUMERIC RANGES (comma-decimals converted)')
print('#'*100)
print('\ncapital Z-variables (39 century slices): mean ~ 0, sd ~ 1 => already z-scored')
for c in cap.columns[3:]:
    v = parse(cap[c])
    print(f'  {c:14s} min={v.min():9.4f} max={v.max():9.4f} mean={v.mean():+.4f} std={v.std(ddof=1):.4f} nan={v.isna().sum()}')
print('\npollen_openness PC1 columns:')
for c in po.columns[3:]:
    v = parse(po[c])
    print(f'  {c:22s} n={v.notna().sum():6d} min={v.min():9.3f} max={v.max():9.3f}')

print('\n' + '#'*100)
print('# 4. DATA-QUALITY / CONSISTENCY CHECKS')
print('#'*100)
# comma decimal separators
for name, df in frames.items():
    obj = df.select_dtypes(include='object').columns
    print(f'{name}: object-typed columns (likely comma-decimals / metadata): {list(obj)}')
# capital == time_series 100y rows
mapping = {'ZAxtSchwert':'HatchetSword','ZDolch':'Dagger','Zhausgr':'HouseSize','ZCU_AU':'CopperGold',
           'Zamber':'Amber','ZMonument':'MonumentCount','ZHort':'Depot','ZSichel':'Sickle',
           'ZBeil':'AxesCelts','ZMW':'MonumentSize','ZKeform':'PotteryForm','Zkeverz':'PotteryDecoration'}
t100 = ts[ts.CE % 100 == 0].copy(); t100['BCE'] = -t100.CE
m = pd.merge(cap, t100[['BCE'] + list(mapping.values())], on='BCE', how='inner')
match = all(np.allclose(parse(m[cc]), m[tc], atol=1e-6, equal_nan=True) for cc, tc in mapping.items())
print(f'capital.csv == time_series 100-yr rows for {len(m)} shared centuries: {match}')
# pollen raw vs interpolated completeness
print('raw (non-interpolated) columns in time_series are mostly NaN; _inter columns are complete')
print(f'  e.g., HatchetSword non-null {ts.HatchetSword.notna().sum()}/3601; HatchetSword_inter {ts.HatchetSword_inter.notna().sum()}/3601')
# time_series pollen == Belau_PC1_inter
mm = pd.merge(ts[ts.pollen.notna()][['CE','pollen']], po[['CE','Belau_PC1_inter']], on='CE', how='inner')
print(f'time_series.pollen vs pollen_openness.Belau_PC1_inter: corr={mm.pollen.corr(parse(mm.Belau_PC1_inter)):.6f} (n={len(mm)})')

print('\nDone. Data ready for the planned capital PCA on 39 hundred-year slices x 12 z-scored variables.')
