"""Clean, bug-free recomputation. Orientation: choose PC1 eigenvector v so that the
largest-|loading| variable (cu_au, Copper&Gold) has POSITIVE loading, and compute
PC1 scores consistently as X @ v_oriented. (Reconstruction keeps score=-X@v iff v->-v,
so loadings and scores are always flipped together.)"""
import numpy as np, pandas as pd

def parse(s): return pd.to_numeric(s.astype(str).str.replace(',', '.', regex=False), errors='coerce')
cap = pd.read_csv('data/capital.csv')
DEC = {'ZAxtSchwert':'axt_schwert','ZDolch':'dagger','Zhausgr':'house_size','ZCU_AU':'cu_au',
       'Zamber':'amber','ZMonument':'monument_count','ZKeform':'pottery_form',
       'Zkeverz':'pottery_decoration','ZHort':'depot','ZSichel':'sickle','ZBeil':'axes_celts','ZMW':'monument_size'}
colz = list(DEC)
X = cap[colz].apply(parse).values
mt = (X - X.mean(0)); mt = mt/np.sqrt((mt**2).mean(0))
cov = mt.T@mt/mt.shape[0]
evals, evecs = np.linalg.eigh(cov)
o = np.argsort(evals)[::-1]; evals, evecs = evals[o], evecs[:,o]
v = evecs[:,0].astype(float)
i = int(np.argmax(np.abs(v)))
if v[i] < 0: v = -v                      # force strongest |loading| (==Cu&Au) positive
load = v*np.sqrt(evals[0])
score = mt @ v                           # consistent projection

print("PC1 explained variance: %.2f%%" % (evals[0]/evals.sum()*100))
print("Dominant loading (forced positive): %s = %+.3f" % (DEC[colz[i]], load[i]))
print("Full loadings:")
for c, l in sorted(zip([DEC[c] for c in colz], load), key=lambda t:-abs(t[1])):
    print("   %-16s %+.3f" % (c, l))

df = pd.DataFrame({'BCE':cap.BCE,'group':cap.group,'PC1':score})
def stat(hi, lo, label):
    s = df[(df.BCE<=hi)&(df.BCE>=lo)].PC1
    print(f"{label} [{lo}-{hi} BCE], n={len(s)}: mean={s.mean():+.3f} median={s.median():+.3f} "
          f"min={s.min():+.3f} max={s.max():+.3f} | all positive={bool((s>0).all())} all negative={bool((s<0).all())}")
stat(3400,3000,"Middle Neolithic  ")
stat(2900,2300,"Younger Neolithic  ")
mn = df[(df.BCE<=3400)&(df.BCE>=3000)].PC1; sg = df[(df.BCE<=2900)&(df.BCE>=2300)].PC1
print(f"SG-MN mean shift: {sg.mean()-mn.mean():+.3f}")
print("Selected slices (PC1, group):")
for b in [3400,3300,3200,3100,3000,2900,2800,2700,2600,2500,2400,2300]:
    r = df[df.BCE==b]
    print(f"   BCE {b}: PC1={r.PC1.values[0]:+.3f} ({r.group.values[0]})")
# sanity: highest-Cu&Au slices must score high with this orientation
print("Sanity (positive pole = high Cu&Au etc.): max PC1 slice =", int(df.loc[df.PC1.idxmax(),'BCE']),
      "min PC1 slice =", int(df.loc[df.PC1.idxmin(),'BCE']))
