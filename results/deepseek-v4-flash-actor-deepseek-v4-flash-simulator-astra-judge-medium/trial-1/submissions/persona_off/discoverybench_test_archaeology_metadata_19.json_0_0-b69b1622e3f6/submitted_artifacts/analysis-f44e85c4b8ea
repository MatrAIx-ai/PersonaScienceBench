"""
Final analysis: PCA on the forms of capital in 100-year time slices (capital.csv).
Question: During the Younger Bronze Age (1100-500 BCE), how does PC1 at the beginning
(1100 BCE) differ from the subsequent time horizons (1000-500 BCE)?

Design (per approved plan):
- Forms of capital = all 12 Z-value columns of capital.csv.
- 100-year time slices = rows of capital.csv (BCE 4300 -> 500).
- PCA on the FULL dataset (39 slices x 12 variables); variables already Z-scored,
  so covariance == correlation. SVD-based PCA.
- Sign convention: PC1 oriented (natural SVD sign, no flip) so higher positive
  = higher capital accumulation (8/12 loadings positive).
- Comparison: per-horizon signed differences PC1(1100) - PC1(t) for t=1000..500,
  mean of 1000-500 horizons, and in-period trend.
- Sensitivity (reported as uncertainty, not reference): PCA restricted to YBA only (7 slices).
"""
import pandas as pd, numpy as np, json

# ---------- Load data ----------
cap = pd.read_csv('data/capital.csv', sep=',', quotechar='"', decimal=',')
zc = [c for c in cap.columns if c.startswith('Z')]
assert cap[zc].isna().sum().sum() == 0, "missing values in Z columns"

# ---------- PCA on full dataset ----------
X = cap[zc].values
Xc = X - X.mean(axis=0)
U, S, Vt = np.linalg.svd(Xc, full_matrices=False)
scores = U * S                      # all PC scores (natural sign)
var = S**2 / (len(cap) - 1)
pc1_raw = scores[:, 0]
# sign convention: natural SVD sign (majority-positive loadings -> positive = accumulation)
flip = np.sign(Vt[0].sum()) if Vt[0].sum() != 0 else 1
PC1 = pc1_raw * flip
load1 = Vt[0] * flip

# ---------- Results table ----------
res = pd.DataFrame({'BCE': cap['BCE'], 'group': cap['group'], 'PC1': PC1})
res = res.sort_values('BCE', ascending=False).reset_index(drop=True)

yba = res[res['BCE'].between(500, 1100)].sort_values('BCE', ascending=False).reset_index(drop=True)
p1100 = yba['PC1'].iloc[0]
yba = yba.assign(diff_vs_1100=np.round(p1100 - yba['PC1'], 4))

stats = {
    'n_slices_total': len(cap), 'n_variables': len(zc),
    'pc1_variance_explained': round(float(var[0] / var.sum()), 4),
    'sign_convention': 'natural SVD; + = higher accumulation (no flip applied)',
    'flip_applied': int(flip),
    'pc1_at_1100_BCE': round(float(p1100), 4),
    'pc1_is_global_max': bool(np.isclose(p1100, np.max(PC1))),
    'per_horizon': [
        {'BCE': int(r['BCE']), 'PC1': round(float(r['PC1']), 4),
         'diff_vs_1100': round(float(r['diff_vs_1100']), 4)} for r in yba.iloc[1:].to_dict('records')
    ],
    'mean_1000_500': round(float(yba['PC1'].iloc[1:].mean()), 4),
    'diff_vs_mean_of_following': round(float(p1100 - yba['PC1'].iloc[1:].mean()), 4),
    'pearson_r_PC1_vs_BCE_over_YBA': round(float(np.corrcoef(yba['BCE'], yba['PC1'])[0, 1]), 4),
    'n_following_horizons_higher_than_1100': int((yba['PC1'].iloc[1:] - p1100 > 0).sum()),
    'loadings_pc1': {n: round(float(l), 4) for n, l in zip(zc, load1)}
}

# ---------- Sensitivity: PCA on YBA only (7 slices) ----------
Xy = cap[cap['group'] == 'YBA'][zc].values
Xyc = Xy - Xy.mean(axis=0)
Uy, Sy, Vty = np.linalg.svd(Xyc, full_matrices=False)
sc_y = (Uy * Sy)[:, 0]
stats['sensitivity_yba_only'] = {
    'pc1_at_1100_BCE_raw_sign': round(float(sc_y[0]), 4),
    'pc1_500_BCE_raw_sign': round(float(sc_y[-1]), 4),
    'note': 'raw SVD sign; opposite polarity to full-data reading - reported as uncertainty, not the reference'
}

# ---------- Save outputs ----------
res.to_csv('analysis/capital_pca_scores.csv', index=False)
with open('analysis/capital_pca_stats.json', 'w') as f:
    json.dump(stats, f, indent=2)

# ---------- Console report ----------
print("=" * 70)
print("PCA on forms of capital, 100-year slices (full dataset, n=%d x %d vars)" % (len(cap), len(zc)))
print("=" * 70)
print("PC1 variance explained:", round(float(var[0] / var.sum()), 4))
print("PC1 loadings:", {n: round(float(l), 3) for n, l in zip(zc, load1)})
print("sign: natural SVD (no flip); + = higher accumulation")
print("\nAll slices PC1 (sorted by BCE, newest first):")
print(res.to_string(index=False))
print("\nYBA window 1100-500 BCE:")
print(yba.to_string(index=False))
print("\nSTATS:")
print(json.dumps(stats, indent=2))
print("\nSaved: analysis/capital_pca_scores.csv, analysis/capital_pca_stats.json")
