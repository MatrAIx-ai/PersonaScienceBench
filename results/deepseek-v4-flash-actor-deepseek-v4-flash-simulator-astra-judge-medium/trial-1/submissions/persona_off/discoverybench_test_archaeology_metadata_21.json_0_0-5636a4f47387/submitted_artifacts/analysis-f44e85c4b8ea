"""
DiscoveryBench (archaeology) - PCA on forms of capital in hundred-year time slices.

Question:
  In the PCA conducted on forms of capital, analyzed in hundred-year time slices,
  how are the symbolic capital components such as house size, daggers, and
  hatchets/swords characterized in terms of their values on the first principal
  component (PC1) and distribution across the second principal component (PC2)?

Workflow
========
1. Load capital.csv (already the 100-year time-slice table: 39 rows, BCE 4300->500 step 100).
   Drop group/color per metadata ("Dropped after data loading").
   Keep the 12 Z-score capital variables.
2. Cross-check: the same 12 series equal the *_inter columns of time_series_data.csv
   at CE = -BCE (exact match, max|diff| = 0).
3. Correlation-matrix PCA: standardize each of the 12 columns (mean 0, unit variance),
   then eigendecomposition of the 12x12 covariance matrix (numpy; sklearn unavailable).
4. Read off PC1 loadings and PC2 distribution for symbolic capital
   (ZAxtSchwert = Hatchet/Sword, ZDolch = Dagger, Zhausgr = House Size).

Environment: pandas, numpy (both present). All results are data-grounded.
"""
import pandas as pd
import numpy as np

pd.set_option('display.width', 120)
RNG = np.random.default_rng(42)  # fixed seed for any stochastic steps (none needed here)


# ---------------------------------------------------------------- load + clean
def load_capital(path='data/capital.csv'):
    """Read capital.csv (European decimal commas); drop group/color per metadata."""
    df = pd.read_csv(path, decimal=',')
    df = df.drop(columns=['group', 'color'])
    df = df.sort_values('BCE').reset_index(drop=True)
    return df


def pca_correlation(X):
    """Correlation-matrix PCA via eigendecomposition of covariance of standardized X.

    Returns eigenvalues (desc), eigenvectors (columns = PCs, rows = variables),
    and row scores (n_obs x n_pcs). Column signs follow np.linalg.eigh; a global
    PC sign flip is arbitrary and does not change interpretable structure.
    """
    Xs = (X - X.mean(axis=0)) / X.std(axis=0, ddof=0)
    cov = np.cov(Xs.T)
    evals, evecs = np.linalg.eigh(cov)
    order = np.argsort(evals)[::-1]
    evals, evecs = evals[order], evecs[:, order]
    scores = Xs @ evecs
    return evals, evecs, scores


def crosscheck_time_series(cap, ts_path='data/time_series_data.csv'):
    """Verify capital.csv Z-values == time_series *_inter at CE = -BCE (exact)."""
    ts = pd.read_csv(ts_path)
    col_map = {'ZAxtSchwert': 'HatchetSword', 'ZDolch': 'Dagger', 'Zhausgr': 'HouseSize',
               'ZCU_AU': 'CopperGold', 'Zamber': 'Amber', 'ZMonument': 'MonumentCount',
               'ZHort': 'Depot', 'ZSichel': 'Sickle', 'ZBeil': 'AxesCelts',
               'ZMW': 'MonumentSize', 'ZKeform': 'PotteryForm', 'Zkeverz': 'PotteryDecoration'}
    sub = ts[ts['CE'].isin(-cap['BCE'].values)].copy()
    sub['BCE'] = -sub['CE']
    merged = pd.merge(cap, sub[['BCE'] + [c + '_inter' for c in col_map.values()]],
                      on='BCE', how='inner')
    n_exact = 0
    for zc, tc in col_map.items():
        n_exact += int((merged[zc] == merged[tc + '_inter']).all())
    return n_exact, len(col_map), len(merged)


def main():
    cap = load_capital()
    feat_cols = [c for c in cap.columns if c.startswith('Z')]
    X = cap[feat_cols].values.astype(float)

    print('=' * 78)
    print('INPUT')
    print('=' * 78)
    print(f'capital.csv: {len(cap)} rows (100-year slices), BCE {cap["BCE"].min()} -> {cap["BCE"].max()}')
    print(f'capital variables entering PCA ({len(feat_cols)}): {feat_cols}')
    print('missing in the 12 Z columns:', int(cap[feat_cols].isna().sum().sum()))
    print('BCE spacing (unique diffs):', np.unique(np.diff(cap['BCE'].values)))

    # cross-check vs time_series_data.csv
    n_exact, n_tot, n_rows = crosscheck_time_series(cap)
    print(f'\ncross-check vs time_series_data.csv *_inter at CE=-BCE: '
          f'{n_exact}/{n_tot} variables exactly equal over {n_rows} intersecting slices')

    # ------------------------------------------------------------- PCA
    evals, evecs, scores = pca_correlation(X)
    var_ratio = evals / evals.sum()

    print('\n' + '=' * 78)
    print('PCA (correlation matrix) on 12 forms of capital, 39 hundred-year slices')
    print('=' * 78)
    for i in range(6):
        print(f'PC{i+1}: eigenvalue={evals[i]:6.3f}  explained variance={var_ratio[i]:.4f} '
              f'({var_ratio[i]*100:.1f}%)')
    print(f'cumulative PC1-2 = {var_ratio[:2].sum()*100:.1f}%')

    load_df = pd.DataFrame(evecs[:, :4], index=feat_cols,
                           columns=[f'PC{i+1}' for i in range(4)])
    print('\nFull loading table (first 4 PCs), sorted by |PC1|:')
    tmp = load_df.copy()
    tmp['|PC1|'] = tmp['PC1'].abs()
    print(tmp.sort_values('|PC1|', ascending=False).drop(columns='|PC1|').round(3).to_string())

    # symbolic capital
    sym = ['Zhausgr', 'ZDolch', 'ZAxtSchwert']  # House Size, Dagger, Hatchet/Sword
    print('\n' + '=' * 78)
    print('SYMBOLIC CAPITAL COMPONENTS: PC1 value and PC2 distribution')
    print('=' * 78)
    Xs = (X - X.mean(axis=0)) / X.std(axis=0, ddof=0)
    rows = []
    for v in sym:
        i = feat_cols.index(v)
        r1 = np.corrcoef(Xs[:, i], scores[:, 0])[0, 1]
        r2 = np.corrcoef(Xs[:, i], scores[:, 1])[0, 1]
        rows.append({
            'variable': v,
            'meaning': {'Zhausgr': 'House Size', 'ZDolch': 'Dagger',
                        'ZAxtSchwert': 'Hatchet/Sword'}[v],
            'PC1_loading': evecs[i, 0],
            'PC2_loading': evecs[i, 1],
            'r_PC1_scores': r1,
            'r_PC2_scores': r2,
            'PC2_loading_abs': abs(evecs[i, 1]),
        })
    sym_df = pd.DataFrame(rows)
    print(sym_df.drop(columns='meaning').round(3).to_string(index=False))
    print('\nPC2-loading position of each component:')
    for _, r in sym_df.iterrows():
        pos = 'near the PC2 axis (loads ~ 0)' if r['PC2_loading_abs'] < 0.15 else \
              'clear negative PC2 loading' if r['PC2_loading'] < -0.15 else \
              'clear positive PC2 loading'
        print(f"  {r['variable']:12s} ({r['meaning']:14s}): PC1={r['PC1_loading']:+.3f}, "
              f"PC2={r['PC2_loading']:+.3f} -> {pos}")

    # correlation of all variables with PC1/PC2 (context)
    print('\nCorrelation (loadings are the PCA weights; r = raw var vs PC score):')
    for v in feat_cols:
        i = feat_cols.index(v)
        print(f'  {v:12s} PC1_load={evecs[i,0]:+.3f}  PC2_load={evecs[i,1]:+.3f}  '
              f'r(PC2)={np.corrcoef(Xs[:,i], scores[:,1])[0,1]:+.3f}')

    # PC2 distribution context
    print('\nPC2 slice-score distribution (39 slices):')
    print(f'  min={scores[:,1].min():+.3f}  max={scores[:,1].max():+.3f}  '
          f'std={scores[:,1].std():.3f}')
    print('  slices with PC2 score < 0:', int((scores[:, 1] < 0).sum()),
          '  slices with PC2 score > 0:', int((scores[:, 1] > 0).sum()))

    # high-symbolic-capital slices: where do they sit on PC2?
    symZ = Xs[:, [feat_cols.index(v) for v in sym]].mean(axis=1)
    high = symZ > np.percentile(symZ, 66)
    print(f'\nHigh-symbolic-capital slices (top tercile of mean Z of the 3 sym vars, n={int(high.sum())}):')
    print('  PC2<0:', int((high & (scores[:, 1] < 0)).sum()), '  PC2>0:',
          int((high & (scores[:, 1] > 0)).sum()))
    print('  their PC2 scores:', np.round(scores[high, 1], 2))

    # save numeric results
    out = {'evals': evals[:6].tolist(), 'var_ratio': var_ratio[:6].tolist(),
           'loadings_first4': load_df.round(3).to_dict(),
           'symbolic': sym_df.round(4).to_dict('records'),
           'pc2_scores_stats': {'min': float(scores[:, 1].min()),
                                'max': float(scores[:, 1].max()),
                                'std': float(scores[:, 1].std())}}
    np.save('pca_results.npy', out, allow_pickle=True)

    print('\nSaved numeric results -> pca_results.npy')
    return out


if __name__ == '__main__':
    main()
