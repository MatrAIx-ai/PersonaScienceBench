"""Exploratory analysis for DiscoveryBench archaeology capital PCA problem.

Inspects the three supplied data files and runs a correlation-matrix PCA on the
12 forms of capital in capital.csv (100-year time slices, BCE 4300 -> 500).
"""
import pandas as pd
import numpy as np

# ---------- 1. Input inspection ----------
cap = pd.read_csv('data/capital.csv', decimal=',')
ts = pd.read_csv('data/time_series_data.csv')
pol = pd.read_csv('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv')

print('=== capital.csv ===')
print('shape:', cap.shape)
print('columns:', list(cap.columns))
print('BCE range:', cap['BCE'].min(), '->', cap['BCE'].max(), 'n unique:', cap['BCE'].nunique())
print('group:', cap['group'].unique())
print('missing in Z columns:', cap.filter(like='Z').isna().sum().sum())

print('\n=== time_series_data.csv ===')
print('shape:', ts.shape, ' CE range:', ts['CE'].min(), '->', ts['CE'].max())
raw_cols = ['HatchetSword','Dagger','HouseSize','CopperGold','Amber','MonumentCount',
            'Depot','Sickle','AxesCelts','MonumentSize','PotteryForm','PotteryDecoration']
print('raw (100-y mark) non-null counts:', ts[raw_cols].notna().sum().tolist())
print('inter non-null counts:', ts[[c+'_inter' for c in raw_cols]].notna().sum().min(), 'min')

print('\n=== pollen openness file ===')
print('shape:', pol.shape, ' CE range:', pol['CE'].min(), '->', pol['CE'].max())

# correspondence check: raw ts values at CE=-BCE equal capital Z values
col_map = {'ZAxtSchwert':'HatchetSword','ZDolch':'Dagger','Zhausgr':'HouseSize',
           'ZCU_AU':'CopperGold','Zamber':'Amber','ZMonument':'MonumentCount','ZHort':'Depot',
           'ZSichel':'Sickle','ZBeil':'AxesCelts','ZMW':'MonumentSize',
           'ZKeform':'PotteryForm','Zkeverz':'PotteryDecoration'}
sub = ts[ts['CE'].isin(-cap['BCE'].values)].copy()
sub['BCE'] = -sub['CE']
merged = pd.merge(cap, sub[['BCE'] + [c + '_inter' for c in col_map.values()]],
                  on='BCE', how='inner')
print('\ncapital vs time_series exact match at CE=-BCE (n=%d):' % len(merged))
for zc, tc in col_map.items():
    md = (merged[zc] - merged[tc + '_inter']).abs().max()
    print('  %s vs %-18s exact(%d/37) max|diff|=%.0e' % (zc, tc + '_inter',
          int((merged[zc] == merged[tc + '_inter']).sum()), md))

# ---------- 2. PCA on the 12 capitals (39 100-year slices) ----------
def pca_np(X):
    cov = np.cov(X.T)
    evals, evecs = np.linalg.eigh(cov)
    order = np.argsort(evals)[::-1]
    return evals[order], evecs[:, order], X @ evecs[:, order]

cap = cap.sort_values('BCE').reset_index(drop=True)
feat_cols = [c for c in cap.columns if c.startswith('Z')]
X = cap[feat_cols].values.astype(float)
Xz = (X - X.mean(axis=0)) / X.std(axis=0, ddof=0)
evals, evecs, scores = pca_np(Xz)
var_ratio = evals / evals.sum()

print('\n=== PCA (correlation matrix, 39 x 12) ===')
print('explained variance ratio first 6:', np.round(var_ratio[:6], 3))
loadings = pd.DataFrame(evecs[:, :3], index=feat_cols, columns=['PC1', 'PC2', 'PC3'])
print('\nloadings (sorted by |PC1|):')
loadings['|PC1|'] = loadings['PC1'].abs()
print(loadings.sort_values('|PC1|', ascending=False).drop(columns='|PC1|').round(3).to_string())

sym = ['Zhausgr', 'ZDolch', 'ZAxtSchwert']
print('\nsymbolic capital loadings:')
for v in sym:
    i = feat_cols.index(v)
    print(f'  {v:12s} PC1={evecs[i,0]:+.3f}  PC2={evecs[i,1]:+.3f}  PC3={evecs[i,2]:+.3f}')

print('\ncross-check: correlation of sym vars with slice scores')
for v in sym:
    i = feat_cols.index(v)
    print(f'  {v:12s} r(PC1)={np.corrcoef(Xz[:,i], scores[:,0])[0,1]:+.3f}  '
          f'r(PC2)={np.corrcoef(Xz[:,i], scores[:,1])[0,1]:+.3f}')

print('\nPC2 slice-score stats: min %.3f max %.3f std %.3f' %
      (scores[:, 1].min(), scores[:, 1].max(), scores[:, 1].std()))

# high-symbolic-capital slices vs PC2
symZ = Xz[:, [feat_cols.index(v) for v in sym]].mean(axis=1)
high = symZ > np.percentile(symZ, 66)
print('high-symbolic-capital slices PC2<0:', int((high & (scores[:, 1] < 0)).sum()),
      ' PC2>0:', int((high & (scores[:, 1] > 0)).sum()))
print('their PC2 scores:', np.round(scores[high, 1], 2))
