"""
DiscoveryBench analysis: 3400-3000 BCE monuments & axes vs symbolic capital.
Question: How does the number of monuments and axes change relative to elements
of symbolic capital (Hatchets & Swords, Daggers, House Size)?

Two resolution levels, kept separate:
  (a) native 100-yr bins (capital.csv): 3400,3300,3200,3100,3000 BCE
  (b) annual interpolated series (time_series_data.csv _inter cols), n=401,
      explicitly a linear interpolation between the block anchors.
"""
import pandas as pd
import numpy as np

# ---------- load ----------
cap = pd.read_csv("data/capital.csv", sep=",")
for c in [c for c in cap.columns if c not in ['BCE','group','color']]:
    cap[c] = pd.to_numeric(cap[c].astype(str).str.replace(',', '.', regex=False), errors='coerce')

ts = pd.read_csv("data/time_series_data.csv", index_col=0)

pf = pd.read_csv("data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv", index_col=0)
for c in pf.columns:
    pf[c] = pd.to_numeric(pf[c].astype(str).str.replace(',', '.', regex=False), errors='coerce')

# variable mapping (study context)
monument_var = 'ZMonument'      # MonumentCount  -> social capital
axes_var     = 'ZBeil'          # AxesCelts      -> economic capital
sym_map = {'ZAxtSchwert':'Hatchets & Swords','ZDolch':'Daggers','Zhausgr':'House Size'}

print("="*74)
print("(a) NATIVE 100-yr BINS  3400-3000 BCE  (capital.csv)")
print("="*74)
W = cap[cap['BCE'].between(3000,3400)].sort_values('BCE', ascending=False).reset_index(drop=True)
cols = ['BCE', monument_var, axes_var] + list(sym_map.keys())
print(W[cols].to_string(index=False), "\n")

b3400 = cap[cap['BCE']==3400].iloc[0]
b3000 = cap[cap['BCE']==3000].iloc[0]
print("Endpoint delta Z (BCE 3000 minus BCE 3400):")
for c in cols[1:]:
    print(f"   {c:10s}: {b3400[c]:+.3f} -> {b3000[c]:+.3f}   delta = {b3000[c]-b3400[c]:+.3f}")

def pearson(a,b):
    if np.std(a)==0 or np.std(b)==0: return np.nan
    return np.corrcoef(a,b)[0,1]
def spearman(a,b):
    if len(np.unique(a))<2 or len(np.unique(b))<2: return np.nan
    return pd.Series(a).corr(pd.Series(b), method='spearman')

print("\nCorrelations of MonumentCount / AxesCelts with symbolic-capital elements (n=5 bins):")
lab = {'ZMonument':'MonumentCount','ZBeil':'AxesCelts'}
for dep in [monument_var, axes_var]:
    for s in sym_map:
        pr = pearson(W[dep], W[s]); sp = spearman(W[dep], W[s])
        print(f"   {lab[dep]:12s} vs {sym_map[s]:20s}: Pearson r = {pr:+.3f}   Spearman rho = {sp:+.3f}")

print("\nMonotonicity note (5-bin paths):")
print("   MonumentCount path:", [round(v,3) for v in W[monument_var]])
print("   AxesCelts     path:", [round(v,3) for v in W[axes_var]])
print("   HouseSize     path:", [round(v,3) for v in W['Zhausgr']])
print("   HatchetSword  path:", [round(v,3) for v in W['ZAxtSchwert']])
print("   Daggers       path:", [round(v,3) for v in W['ZDolch']])

# endpoint delta from annual series for cross-check
print("\n" + "="*74)
print("(b) ANNUAL INTERPOLATED SERIES  CE in [-3400,-3000], n=401 (robustness only)")
print("    NOTE: values between the 100-yr block anchors are straight-line")
print("    interpolation; sub-century shape is an artifact of interpolation.")
print("="*74)
W2 = ts[(ts['CE']>=-3400)&(ts['CE']<=-3000)]
inter = {'MonumentCount_inter':'MonumentCount','AxesCelts_inter':'AxesCelts',
         'HatchetSword_inter':'Hatchets & Swords','Dagger_inter':'Daggers','HouseSize_inter':'House Size'}
print("Endpoint delta (CE -3000 minus CE -3400), annual data:")
for c in inter:
    v0 = W2[W2['CE']==-3400][c].iloc[0]; v1 = W2[W2['CE']==-3000][c].iloc[0]
    print(f"   {c:22s}: {v0:+.4f} -> {v1:+.4f}   delta = {v1-v0:+.4f}")

print("\nAnnual Pearson r (n=401):")
for dep in ['MonumentCount_inter','AxesCelts_inter']:
    for s in ['HatchetSword_inter','Dagger_inter','HouseSize_inter']:
        pr = pearson(W2[dep], W2[s]); sp = spearman(W2[dep], W2[s])
        print(f"   {dep:22s} vs {s:22s}: Pearson = {pr:+.3f}  Spearman = {sp:+.3f}")

print("\nPer-century linear slope over window (Z per 100 yr), annual data:")
for c in ['MonumentCount_inter','AxesCelts_inter','HatchetSword_inter','Dagger_inter','HouseSize_inter','MonumentSize_inter','CopperGold_inter']:
    sl = np.polyfit(W2['CE'].astype(float), W2[c].astype(float),1)[0]*100
    print(f"   {c:22s}: {sl:+.3f} per century")

# ---------- pollen openness context ----------
print("\n" + "="*74)
print("(c) POLLEN OPENNESS CONTEXT (Belau+Woserin PC1 MEAN); NOT a symbolic-capital element")
print("="*74)
P = pf[(pf['CE']>=-3400)&(pf['CE']<=-3000)]
slope = np.polyfit(P['CE'].astype(float), P['MEAN'].astype(float),1)[0]
print(f"   MEAN at -3400: {P[P['CE']==-3400]['MEAN'].iloc[0]:+.3f}   at -3000: {P[P['CE']==-3000]['MEAN'].iloc[0]:+.3f}")
print(f"   open-level decline slope ~ {slope*100:+.2f} per century; window mean {P['MEAN'].mean():+.3f}")
print(f"   SMOOTH_MEAN_100y at -3400: {P[P['CE']==-3400]['SMOOTH_MEAN_100y'].iloc[0]:+.3f}  at -3000: {P[P['CE']==-3000]['SMOOTH_MEAN_100y'].iloc[0]:+.3f}")
print("   Check under all smoothing windows (50-250y) sign is the same (decline):")
for w in ['SMOOTH_MEAN_50y','SMOOTH_MEAN_100y','SMOOTH_MEAN_150y','SMOOTH_MEAN_200y','SMOOTH_MEAN_250y']:
    v0=P[P['CE']==-3400][w].iloc[0]; v1=P[P['CE']==-3000][w].iloc[0]
    print(f"     {w}: {v0:+.3f} -> {v1:+.3f} (delta {v1-v0:+.3f})")
