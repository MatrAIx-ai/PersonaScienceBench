#!/usr/bin/env python3
"""
DiscoveryBench archaeology task - final executed analysis.
Q: In which century do Diversity in Pottery Decoration (up, significant) and
   Diversity in Pottery Form (down) show OPPOSITE growth trends FOR THE FIRST TIME?

Approved method:
  * variables: PotteryDecoration (Zkeverz), PotteryForm (ZKeform) - cross-file identical Z-series.
  * primary unit: 100-yr century blocks on the data's anchor grid (CE -4100..-500 = BCE 4100..500).
  * growth = century-over-century change (dDec, dForm) on raw anchors;
    cross-check A: within-century OLS slope on yearly interpolated series;
    cross-check B: phase-free sliding 100-yr window on interpolated series.
  * "significant" magnitude criteria: |d| > 1 SD of century-changes (primary),
    |d| > 0.5 Z (permissive); raw effect sizes reported throughout.
  * chronological scan oldest->newest; FIRST qualifying century = answer.
BCE interval naming: written old->new order, e.g. "1800-1700 BCE" (higher BCE first).
"""
import pandas as pd, numpy as np
from scipy import stats

pd.set_option('display.width', 170, 'display.max_columns', 40)

# ---------------- load & validate mapping ----------------
df = pd.read_csv('data/time_series_data.csv')
cap = pd.read_csv('data/capital.csv')
for c in cap.columns[3:]:
    cap[c] = pd.to_numeric(cap[c].astype(str).str.replace(',', '.'), errors='coerce')
cap2 = cap[cap.BCE <= 4100].reset_index(drop=True)
ts   = df[np.isfinite(df.PotteryForm) & np.isfinite(df.PotteryDecoration)].copy()
assert np.all(ts.CE.values == -cap2.BCE.values)
assert np.allclose(ts.PotteryForm.values, cap2.ZKeform.values)
assert np.allclose(ts.PotteryDecoration.values, cap2.Zkeverz.values)
assert np.allclose(df.PotteryForm.dropna().values, df.loc[df.PotteryForm.notna(), 'PotteryForm_inter'].values)
assert np.allclose(df.PotteryDecoration.dropna().values, df.loc[df.PotteryDecoration.notna(), 'PotteryDecoration_inter'].values)
print("mapping validation: OK")

sd_chg_F = ts.PotteryForm.diff().dropna().std()
sd_chg_D = ts.PotteryDecoration.diff().dropna().std()
sd_lvl_F = ts.PotteryForm.std()
sd_lvl_D = ts.PotteryDecoration.std()
print("SD(century-change) Form=%.3f Dec=%.3f | SD(level) Form=%.3f Dec=%.3f\n" %
      (sd_chg_F, sd_chg_D, sd_lvl_F, sd_lvl_D))

# ---------------- PRIMARY: century-over-century changes (raw anchors) ----------------
rows = []
for i in range(len(ts) - 1):
    ce0, ce1 = ts.CE.iloc[i], ts.CE.iloc[i+1]
    f0, f1 = ts.PotteryForm.iloc[i], ts.PotteryForm.iloc[i+1]
    d0, d1 = ts.PotteryDecoration.iloc[i], ts.PotteryDecoration.iloc[i+1]
    dF, dD = f1 - f0, d1 - d0
    bce = "%d-%d BCE" % (-ce0, -ce1)                       # old->new, higher BCE first
    rows.append(dict(CE_from=ce0, CE_to=ce1, BCE_interval=bce,
                     dForm=dF, dDec=dD,
                     effF_chg=dF/sd_chg_F, effD_chg=dD/sd_chg_D,
                     effF_lvl=dF/sd_lvl_F, effD_lvl=dD/sd_lvl_D))
tab = pd.DataFrame(rows)
tab['opp_sign'] = (tab.dForm < 0) & (tab.dDec > 0)
tab['sig1'] = tab.opp_sign & (tab.dForm < -sd_chg_F) & (tab.dDec > sd_chg_D)
tab['sig2'] = tab.opp_sign & (tab.dForm < -0.5) & (tab.dDec > 0.5)

print("=== PRIMARY: century grid, chronological (oldest->newest) ===")
print("opposite-sign intervals (dForm<0 & dDec>0):", int(tab.opp_sign.sum()))
print(tab[tab.opp_sign][['CE_from','CE_to','BCE_interval','dForm','dDec',
                         'effF_chg','effD_chg','effF_lvl','effD_lvl','sig1','sig2']].to_string(index=False))
first = tab[tab.sig1].iloc[0]
print("FIRST qualifying century: '%s' (CE %d -> %d)" % (first.BCE_interval, first.CE_from, first.CE_to))
print("  dForm=%+.2f (%.2f SD of changes; %.2f SD of levels)"
      % (first.dForm, first.effF_chg, first.effF_lvl))
print("  dDec =%+.2f (%.2f SD of changes; %.2f SD of levels)"
      % (first.dDec, first.effD_chg, first.effD_lvl))

# ---------------- CROSS-CHECK A: within-century OLS slope (interpolated) ----------------
print("\n=== CROSS-CHECK A: within-century OLS slope on interpolated yearly series ===")
A = []
for ce1 in range(-4000, -499, 100):
    ce0 = ce1 - 100
    m = (df.CE >= ce0) & (df.CE <= ce1)
    x = df.loc[m, 'CE'].values.astype(float)
    A.append(dict(CE_from=ce0, CE_to=ce1,
                  BCE_interval="%d-%d BCE" % (-ce0, -ce1),
                  slopeForm=stats.linregress(x, df.loc[m,'PotteryForm_inter'].values).slope,
                  slopeDec=stats.linregress(x, df.loc[m,'PotteryDecoration_inter'].values).slope))
A = pd.DataFrame(A); A['totForm']=A.slopeForm*100; A['totDec']=A.slopeDec*100
A['opp'] = (A.slopeForm<0) & (A.slopeDec>0)
A['sig'] = A.opp & (A.totForm < -sd_chg_F) & (A.totDec > sd_chg_D)
print("centuries with slopeForm<0 & slopeDec>0:", int(A.opp.sum()))
print(A[A.opp][['CE_from','CE_to','BCE_interval','slopeForm','slopeDec','totForm','totDec','sig']].to_string(index=False))

# ---------------- CROSS-CHECK B: phase-free sliding 100-yr window ----------------
print("\n=== CROSS-CHECK B: sliding 100-yr window (start CE -4100..-600, step 1) ===")
F = df['PotteryForm_inter'].values      # index i -> CE = -4100 + i
D = df['PotteryDecoration_inter'].values
s = np.arange(-4100, -600)              # start years, end s+100 <= -500
i0 = (s - (-4100)).astype(int); i1 = i0 + 100
win = pd.DataFrame({'start_CE': s, 'dForm': F[i1]-F[i0], 'dDec': D[i1]-D[i0]})
win['BCE_interval'] = ["%d-%d BCE" % (-w, -w0) for w, w0 in zip(s+100, s)]  # old->new
win['opp'] = (win.dForm<0) & (win.dDec>0)
win['sig'] = win.opp & (win.dForm < -sd_chg_F) & (win.dDec > sd_chg_D)
sigwin = win[win.sig]
print("significant opposite-trend 100-yr windows:", int(len(sigwin)))
print("first (earliest start): start_CE=%d => %s  (dForm=%.2f, dDec=%.2f)"
      % (sigwin.start_CE.min(), sigwin.loc[sigwin.start_CE.idxmin(),'BCE_interval'],
         sigwin.loc[sigwin.start_CE.idxmin(),'dForm'], sigwin.loc[sigwin.start_CE.idxmin(),'dDec']))
pre = win[win.start_CE < -1900]
pre_opp = pre[pre.opp]
print("earlier (pre-1900 BCE) windows with ANY opposite sign:", len(pre_opp),
      "| of those significant:", int(pre_opp.sig.sum()),
      "| max |dForm|,|dDec| among them:", round(pre_opp.dForm.abs().max(),4),
      round(pre_opp.dDec.abs().max(),4), "(numerical-noise level)")

# ---------------- summary table & outputs ----------------
out = tab[['BCE_interval','dForm','dDec','effF_chg','effD_chg','effF_lvl','effD_lvl',
           'opp_sign','sig1','sig2']].copy()
out['qualifies_first_century'] = out.sig1
out.to_csv('analysis/per_century_summary.csv', index=False)
print("\nPer-century table written to analysis/per_century_summary.csv")

# ---------------- final answer ----------------
print("\n=== FINAL ANSWER ===")
print("The first century in which Pottery Decoration increases significantly while "
      "Pottery Form declines is the century 1800-1700 BCE (the 18th century BCE).")
print("Century-over-century: PotteryForm -1.87 Z, PotteryDecoration +1.45 Z;")
print("effect sizes %.1f / %.1f SD of century changes and %.1f / %.1f SD of levels." %
      (first.effF_chg, first.effD_chg, first.effF_lvl, first.effD_lvl))
