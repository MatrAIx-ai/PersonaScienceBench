#!/usr/bin/env python3
"""
Amber value peak analysis (DiscoveryBench episode archaeology/metadata_8).

Question: In which millennium did amber have the highest value and in what
time interval did it peak?

Context: amber is classified as SOCIAL CAPITAL; its Z-series is the value
proxy. Value of amber = Zamber (capital.csv) == Amber (time_series raw) ==
Amber_inter (interpolated) at anchor years.

Outputs (BCE / CE / calBP axes):
  * peak value            = Zamber = 1.54
  * peak interval         = BCE 3300-3000 (CE -3300..-3000; calBP 5250-4950)
  * peak millennium       = 4th millennium BCE (sustained peak)
"""
import math
import numpy as np
import pandas as pd

# ---------------------------------------------------------------- 1. Load
cap = pd.read_csv("data/capital.csv")
ts = pd.read_csv("data/time_series_data.csv")

# German decimal commas -> float (capital.csv)
for c in cap.columns:
    if pd.api.types.is_string_dtype(cap[c]) and c not in ("group", "color"):
        cap[c] = pd.to_numeric(cap[c].astype(str).str.replace(",", "."))

zamber = cap["Zamber"]  # float series

# ---------------------------------------------------------------- 2. Verify axes
assert np.allclose(ts["calBP"], 1950 - ts["CE"]), "calBP != 1950 - CE"
ts["BCE"] = -ts["CE"]
assert len(ts) == 3601

# -------------------------------------------------- 3. Verify value-proxy identity
amb = ts.loc[ts["Amber"].notna(), ["CE", "Amber"]].copy()
amb["BCE"] = -amb["CE"]
m = cap[["BCE", "Zamber"]].merge(amb[["BCE", "Amber"]], on="BCE", how="inner")
diff = (m["Amber"] - m["Zamber"]).abs()
print("value-proxy identity: max |Amber - Zamber| over shared BCE =", float(diff.max()))
print("capital Zamber rows:", len(cap), "| time_series Amber anchors:", len(amb))
print("early rows in capital absent from time_series (BCE):",
      sorted(set(cap["BCE"]) - set(amb["BCE"])))

# --------------------------------------------------------- 4. Peak analysis
peak_val = ts["Amber_inter"].max()
print("\n== GLOBAL PEAK (Amber_inter, 1-yr resolution) ==")
print("peak value  Zamber =", peak_val)
pk = ts.loc[ts["Amber_inter"] == peak_val]
print("peak interval: BCE", int(-pk["CE"].max()), "-", int(-pk["CE"].min()),
      "| CE", int(pk["CE"].min()), "..", int(pk["CE"].max()),
      "| calBP", int(pk["calBP"].max()), "-", int(pk["calBP"].min()),
      "| duration", len(pk), "years")

# raw plateau (capital / raw anchors)
raw_peak_bce = cap.loc[zamber == peak_val, "BCE"]
print("raw plateau at max (capital Zamber): BCE", raw_peak_bce.min(), "-", raw_peak_bce.max())

# --------------------------------------------------------- 5. Millennium bins
def mill_bce(b):
    return int(math.ceil(b / 1000))  # 1st mill = BCE 1-1000

ts["mill"] = ts["BCE"].apply(mill_bce)
g = ts.groupby("mill")["Amber_inter"].agg(["max", "mean", "count"])
print("\n== MILLENNIA (BCE bins) ==")
print(g.to_string())

max_mill_mean = g["mean"].idxmax()
pk_years_in_mill = pk.assign(m= pk["BCE"].apply(mill_bce)).groupby("m")["Amber_inter"].count()
print("\npeak-years per millennium (year 3000 BCE -> 3rd mill; 3300-3001 -> 4th mill):")
print(pk_years_in_mill.to_string())
print("millennium with highest within-millennium mean amber value:", max_mill_mean,
      "(= 4th millennium BCE, years 4000-3001)")

# ------------------------------------------------- 6. Sustained high era (context)
for thr in (1.0, 0.5):
    hi = ts.loc[ts["Amber_inter"] >= thr]
    print(f"supporting context: Amber >= {thr}  ->  BCE {int(-hi['CE'].max())}-{int(-hi['CE'].min())}"
          f" (calBP {int(hi['calBP'].max())}-{int(hi['calBP'].min())}; CE {int(hi['CE'].min())}..{int(hi['CE'].max())})")

# ------------------------------------------------- 7. Boundary-year note
print("\nboundary note: year 3000 BCE = last year of the 3rd millennium BCE;",
      "years 3300-3001 BCE lie in the 4th millennium BCE.")
print("fraction of peak years inside 4th millennium:",
      round(pk_years_in_mill[4] / len(pk), 3))
print("\nDONE")
