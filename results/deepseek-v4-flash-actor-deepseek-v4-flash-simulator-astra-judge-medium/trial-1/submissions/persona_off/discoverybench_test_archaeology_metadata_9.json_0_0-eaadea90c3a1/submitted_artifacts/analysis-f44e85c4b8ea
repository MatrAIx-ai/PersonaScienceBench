"""
Social Capital analysis for archaeology domain.

Definition (study context): Social Capital = Copper&Gold + Amber + MonumentCount
  capital.csv (century-level, BCE):  ZCU_AU, Zamber, ZMonument
  time_series_data.csv (yearly):      CopperGold_inter, Amber_inter, MonumentCount_inter

Boundary decisions (approved by researcher):
  1. Aggregate result: century-level capital.csv (BCE) primary; explicit century bins
     resolve the BCE 1400/1300 plateau; cross-check with century-bin means of the
     interpolated yearly sum from time_series_data.csv. Peak century reported in BCE
     with CE-equivalent annotation.
  2. Per-component: peak value + peak century, full-span linear slope and Spearman
     rank correlation, explicit increase criterion (positive full-span slope AND
     later-window mean above early-baseline mean).
  3. Aggregate vs per-component results kept separate; BCE 4300/4200 coverage gap in
     time_series_data (cross-check begins BCE 4100) is noted.
  4. Pollen openness data: documentation-only; not a social-capital component.
"""
import pandas as pd
import numpy as np
from scipy import stats

print("="*70)
print("LOAD AND PARSE")
print("="*70)
# ---- capital.csv (comma decimals) ----
def parse_num(v):
    try:
        return float(str(v).strip().replace(',', '.'))
    except Exception:
        return np.nan

cap_raw = pd.read_csv('data/capital.csv', dtype=str)
cap = pd.DataFrame()
cap['BCE'] = cap_raw['BCE'].map(parse_num).astype(int)
for c in ['ZCU_AU', 'Zamber', 'ZMonument']:
    cap[c] = cap_raw[c].map(parse_num)
cap = cap.sort_values('BCE').reset_index(drop=True)
cap['CE'] = -cap['BCE']
cap['sum'] = cap[['ZCU_AU', 'Zamber', 'ZMonument']].sum(axis=1)
print(f"capital.csv: {len(cap)} rows, BCE {cap['BCE'].min()}..{cap['BCE'].max()}, "
      f"missing social cols = {cap[['ZCU_AU','Zamber','ZMonument']].isna().sum().sum()}")

# ---- time_series_data.csv ----
ts = pd.read_csv('data/time_series_data.csv', index_col=0)
ts['CE'] = ts['CE'].astype(int)
ts = ts.sort_values('CE').reset_index(drop=True)
ts['BCE'] = -ts['CE']
ts['sum_int'] = ts['CopperGold_inter'] + ts['Amber_inter'] + ts['MonumentCount_inter']
print(f"time_series_data.csv: {len(ts)} rows, CE {ts['CE'].min()}..{ts['CE'].max()} "
      f"(BCE {ts['BCE'].max()}..{ts['BCE'].min()}), inter missing = "
      f"{ts[['CopperGold_inter','Amber_inter','MonumentCount_inter']].isna().sum().sum()}")

# ---- pollen (documentation only) ----
pol = pd.read_csv('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv')
print(f"pollen csv: {len(pol)} rows, CE {pol['CE'].min()}..{pol['CE'].max()} (documentation-only)")

print()
print("="*70)
print("1) AGGREGATE / SUMMED SOCIAL CAPITAL  (ZCU_AU + Zamber + ZMonument)")
print("="*70)
# Century bin definition: anchor BCE X (multiple of 100) represents the century
#   BCE [X .. X-99]  (e.g., 1400 -> BCE 1400..1301 = the 14th century BCE)
cap['cc'] = cap['BCE'] // 100          # century index in BCE terms
print("\n[1a] Century-level summed series (capital.csv):")
show = cap[['BCE', 'ZCU_AU', 'Zamber', 'ZMonument', 'sum']].copy()
show['century_BCE_bin'] = show['BCE'].astype(str) + ' -> ' + (show['BCE'] - 99).astype(str)
print(show.to_string(index=False))

peak = cap.loc[cap['sum'].idxmax()]
print(f"\nSum max = {peak['sum']:.4f} at BCE anchors {cap.loc[cap['sum']==peak['sum'],'BCE'].tolist()} "
      f"(tied plateau BCE 1400 & 1300)")

# [1b] Interpolated yearly sum, century-bin means (CE-bins)
ts['ce_bin'] = (ts['CE'] // 100) * 100
bin_mean = ts.groupby('ce_bin')['sum_int'].agg(['mean', 'max', 'count'])
bin_mean = bin_mean.sort_values('mean', ascending=False)
print("\n[1b] Century-bin means of interpolated yearly sum (top 6):")
bm = bin_mean.head(6).copy()
bm['BCE_bin'] = -bm.index
bm['century_BCE'] = bm['BCE_bin'] // 100
print(bm.to_string())

# resolve the plateau: where does interpolated sum stay at 4.238?
topval = ts['sum_int'].max()
plateau = ts[ts['sum_int'] > 4.0]
print(f"\nInterpolated sum max {topval:.4f}; years with sum > 4.0: "
      f"CE {plateau['CE'].min()}..{plateau['CE'].max()} (BCE {plateau['BCE'].max()}..{plateau['BCE'].min()})")

# dominant century bin by yearly mean
top_bin = int(bin_mean.index[0])
print(f"\nDominant century bin (highest yearly-sum mean) = CE-bin {top_bin}..{top_bin+99} "
      f"= BCE {(top_bin+99)*-1}..{-top_bin} = {(-top_bin)//100}th century BCE")

print()
print("="*70)
print("2) PER-COMPONENT ANALYSIS")
print("="*70)
# time variable: CE (increases with time). For slopes use CE per century (scale /100).
comp_map = {
    'Copper&Gold (ZCU_AU / CopperGold_inter)': ('ZCU_AU', 'CopperGold_inter'),
    'Amber (Zamber / Amber_inter)':             ('Zamber', 'Amber_inter'),
    'Monument Count (ZMonument / MonumentCount_inter)': ('ZMonument', 'MonumentCount_inter'),
}

rows = []
for label, (colcap, colts) in comp_map.items():
    yc = cap[colcap].values
    x = cap['CE'].values / 100.0          # per century
    slope, intercept, r, p, se = stats.linregress(x, yc)
    rho, rho_p = stats.spearmanr(cap['CE'].values, yc)
    # peak
    pk = cap.loc[cap[colcap].idxmax()]
    pk_year = pk['BCE']
    # early baseline (oldest half of span) and later window
    early = cap.loc[cap['BCE'] >= 3300, colcap].mean()
    late  = cap.loc[cap['BCE'] <= 2000, colcap].mean()
    overall = cap[colcap].mean()
    increasing = (slope > 0.05) and (late > early + 0.1)
    rows.append({
        'component': label,
        'peak_val': pk[colcap], 'peak_BCE': pk_year,
        'slope_per_century': round(slope, 4), 'r2': round(r**2, 3),
        'spearman_rho': round(rho, 3), 'spearman_p': round(rho_p, 4),
        'early_mean(BCE>=3300)': round(early, 3),
        'late_mean(BCE<=2000)': round(late, 3),
        'increasing_criterion': increasing,
    })
    print(f"\n--- {label} ---")
    print(f"  peak Z = {pk[colcap]:.3f} at BCE {pk_year} "
          f"(= {pk_year//100}th century BCE); inter peak {ts[colts].max():.3f} @BCE {int(-ts.loc[ts[colts].idxmax(),'CE'])}")
    print(f"  full-span OLS slope = {slope:+.4f} Z per century (R^2={r**2:.3f}, p={p:.4g})")
    print(f"  Spearman rho = {rho:+.3f} (p={rho_p:.4g})")
    print(f"  early mean (BCE>=3300) = {early:.3f} ; late mean (BCE<=2000) = {late:.3f} ; overall = {overall:.3f}")
    print(f"  increase criterion (slope>0.05 & late>early+0.1) -> {increasing}")

print()
print("="*70)
print("3) COMPARISON / CROSS-CHECK")
print("="*70)
diff_rows = []
for label, (colcap, colts) in comp_map.items():
    sub = ts[ts['BCE'].isin(cap['BCE'])][['BCE', colts]]
    sub.columns = ['BCE', 'inter_val']
    merged = cap[['BCE', colcap]].merge(sub, on='BCE')
    adiff = (merged['inter_val'] - merged[colcap]).abs().max()
    diff_rows.append((label, adiff))
print("Max |interpolated - capital.csv| at the 37 overlapping BCE anchors:")
for lab, ad in diff_rows:
    print(f"  {lab}: {ad:.2e}")
print("\nNote: time_series yearly cross-check starts BCE 4100; capital.csv also has BCE 4300 & 4200 "
      "(2 extra early centuries, both with Z values that do not change the peak findings).")
print("\nPollen openness (Belau/Woserin PC1) documented only; not summed into social capital.")

print()
print("="*70)
print("4) FINAL PER-COMPONENT CLASSIFICATION (directional increase tests)")
print("="*70)
cols = {'Copper&Gold':'ZCU_AU', 'Amber':'Zamber', 'Monument Count':'ZMonument'}
for label, c in cols.items():
    x = cap['CE'].values/100.0
    y = cap[c].values
    slope, ic, r, p, se = stats.linregress(x, y)
    rho, rho_p = stats.spearmanr(cap['CE'].values, y)
    peak_bce = cap.loc[cap[c].idxmax(),'BCE']; peak_val = cap[c].max()
    late_sub = cap[cap['BCE']<=2000]
    late_peak_bce = late_sub.loc[late_sub[c].idxmax(),'BCE']; late_peak_val = late_sub[c].max()
    early = cap.loc[cap['BCE']>=3300, c].mean(); late = late_sub[c].mean()
    increasing = (slope>0) and (rho>0) and (late>early)
    print(f"\n{label}: peak Z={peak_val:.2f}@BCE {peak_bce}; late-half peak Z={late_peak_val:.2f}@BCE {late_peak_bce}")
    print(f"  OLS slope={slope:+.4f}/century (p={p:.4g}) | Spearman rho={rho:+.3f} (p={rho_p:.4g})")
    print(f"  early_mean={early:+.3f}, late_mean={late:+.3f} -> INCREASING: {increasing}")
