#!/usr/bin/env python3
"""
Full analysis:
How does the prevalence of non-native plants introduced via gardening vary based on habitat type?

Primary: per-habitat share of non-native species records attributed to Gardening
         (sum n.gard / sum n.total by habitat), plus binomial GLM (success=n.gard,
         failure=n.total-n.gard) on plots with n.total>0, LRT for the habitat term,
         and model-predicted gardening share per habitat with 95% CI.
         Robustness: Poisson GLM with offset=log(n.total).
Confounder check: add urban/cropland % (2009, 500m), elevation, distance.road,
                  distance.stream; habitat x pathway chi-square/Fisher.
Secondary: species-level Wilcoxon Gardening vs Unintentional on occupancy metrics,
           with sensitivity dropping duplicated (two-pathway) rows.
Context: temporal gardening-share trend.
"""
import numpy as np
import pandas as pd
import statsmodels.api as sm
import statsmodels.formula.api as smf
from scipy import stats

np.random.seed(42)
inv = pd.read_csv('data/invaded_niche_pathways.csv', sep='\t')
isp = pd.read_csv('data/invasion_success_pathways.csv')
tt = pd.read_csv('data/temporal_trends_contingency_table.csv', sep='\t')

out = []
def p(*a):
    s = ' '.join(str(x) for x in a)
    print(s); out.append(s)

# ----------------------------------------------------------------------
p('='*80)
p('PRIMARY: HABITAT-LEVEL GARDENING SHARE (sum n.gard / sum n.total)')
p('='*80)
agg = inv.groupby('habitat')[['n.gard','n.unint','n.agfo','n.total']].sum()
agg['n_plots'] = inv.groupby('habitat').size()
agg['gard_share'] = agg['n.gard']/agg['n.total']
agg = agg.sort_values('gard_share', ascending=False)
cols = ['n_plots','n.gard','n.unint','n.agfo','n.total','gard_share']
p(agg[cols].rename(columns={'gard_share':'gard_share(Sum)'}).round(3).to_string())
p(f"\nTotal species records: {agg['n.total'].sum()} | Gardening: {agg['n.gard'].sum()} "
  f"({100*agg['n.gard'].sum()/agg['n.total'].sum():.1f}%)")

# ----------------------------------------------------------------------
# rename columns to valid identifiers for patsy formulas
sub = inv[inv['n.total'] > 0].copy()
sub = sub.rename(columns={'n.gard':'n_gard','n.unint':'n_unint','n.agfo':'n_agfo',
                          'n.total':'n_total','urban.2009.500m':'urban09_500m',
                          'cropland.2009.500m':'crop09_500m','distance.road':'dist_road',
                          'distance.stream':'dist_stream'})
sub['gard'] = sub['n_gard'].astype(float)
sub['other'] = (sub['n_total'] - sub['n_gard']).astype(float)

p('\n' + '='*80)
p('MODEL 1a: BINOMIAL GLM on 191 plots with n.total>0 (success=n.gard, failure=n.total-n.gard)')
p('='*80)
m_full = smf.glm('gard + other ~ C(habitat)', family=sm.families.Binomial(), data=sub).fit()
m_null = smf.glm('gard + other ~ 1',        family=sm.families.Binomial(), data=sub).fit()
lrt_stat = 2*(m_full.llf - m_null.llf)
lrt_df = m_full.df_model - m_null.df_model
lrt_p = stats.chi2.sf(lrt_stat, lrt_df)
p(f"LRT habitat term: chi2={lrt_stat:.3f}, df={lrt_df}, p={lrt_p:.4g}")
p(f"Deviance (null) = {m_null.deviance:.1f} on {m_null.df_resid} df | "
  f"Deviance (full) = {m_full.deviance:.1f} on {m_full.df_resid} df")

pred_rows = []
for h in sub['habitat'].unique():
    nd = pd.DataFrame({'habitat':[h]})
    pr = m_full.get_prediction(nd).summary_frame(alpha=0.05)
    pred_rows.append((h, pr['mean'].iloc[0], pr['mean_ci_lower'].iloc[0], pr['mean_ci_upper'].iloc[0],
                      (sub['habitat']==h).sum(), sub.loc[sub['habitat']==h,'n_total'].sum(),
                      sub.loc[sub['habitat']==h,'n_gard'].sum()))
pred = pd.DataFrame(pred_rows, columns=['habitat','model_share','ci_low','ci_high','plots_used','n_total','n_gard'])
pred = pred.sort_values('model_share', ascending=False)
p('\nModel-predicted gardening share per habitat (95% CI, plots with n.total>0):')
p(pred.round(3).to_string())

# ----------------------------------------------------------------------
p('\n' + '='*80)
p('MODEL 1b (robustness): POISSON GLM n.gard ~ C(habitat), offset=log(n.total)')
p('='*80)
m_pois = smf.glm('n_gard ~ C(habitat)', family=sm.families.Poisson(),
                 offset=np.log(sub['n_total'].values), data=sub).fit(cov_type='HC0')
m_pois0 = smf.glm('n_gard ~ 1', family=sm.families.Poisson(),
                  offset=np.log(sub['n_total'].values), data=sub).fit(cov_type='HC0')
lrt2 = 2*(m_pois.llf - m_pois0.llf)
d2 = m_pois.df_model - m_pois0.df_model
p(f"LRT habitat term: chi2={lrt2:.3f}, df={d2}, p={stats.chi2.sf(lrt2, d2):.4g}")
p(f"Poisson Pearson chi2/df = {m_pois.pearson_chi2/m_pois.df_resid:.2f} (overdispersion indicator)")

# ----------------------------------------------------------------------
p('\n' + '='*80)
p('CONFOUNDER CHECK: binomial GLM + urban/cropland 2009 500m, elevation, distance.road/stream')
p('='*80)
covs = ['urban09_500m','crop09_500m','elevation','dist_road','dist_stream']
p('NAs in covariates on n.total>0 subset:')
p(sub[covs].isna().sum().to_string())
sub_c = sub.copy()
sub_c['habitat'] = pd.Categorical(sub_c['habitat'],
                                  categories=['Urban','Croplands','Riparian','Wetlands','Coastal',
                                              'Coniferous forests','Broad-leaved forests','Scrublands',
                                              'Meadows','Rock outcrops'])
m_cov = smf.glm('gard + other ~ C(habitat) + urban09_500m + crop09_500m + elevation + dist_road + dist_stream',
                family=sm.families.Binomial(), data=sub_c).fit()
m_cov_nohab = smf.glm('gard + other ~ urban09_500m + crop09_500m + elevation + dist_road + dist_stream',
                      family=sm.families.Binomial(), data=sub_c).fit()
# (a) habitat effect AFTER controlling for plot covariates
lrt_hab = 2*(m_cov.llf - m_cov_nohab.llf)
p(f"LRT habitat effect AFTER adjusting for 5 plot covariates: chi2={lrt_hab:.3f}, "
  f"df={m_cov.df_model - m_cov_nohab.df_model}, p={stats.chi2.sf(lrt_hab, m_cov.df_model - m_cov_nohab.df_model):.4g}")
# (b) covariates effect on top of habitat
lrt_cov = 2*(m_cov.llf - m_full.llf)
p(f"LRT adding 5 plot covariates to habitat-only model: chi2={lrt_cov:.3f}, "
  f"df={m_cov.df_model - m_full.df_model}, p={stats.chi2.sf(lrt_cov, m_cov.df_model - m_full.df_model):.4g}")
p('\nCovariate-adjusted model coefficient table (reference = Urban):')
p(m_cov.summary2().tables[1].to_string())
p('\nCovariate-only model (no habitat) coefficient table:')
p(m_cov_nohab.summary2().tables[1].to_string())
pred_cov = []
for h in sub_c['habitat'].cat.categories:
    nd = pd.DataFrame({'habitat':pd.Categorical([h], categories=sub_c['habitat'].cat.categories),
                       **{c:[0.0] for c in covs}})
    pr = m_cov.get_prediction(nd).summary_frame(alpha=0.05)
    pred_cov.append((h, pr['mean'].iloc[0], pr['mean_ci_lower'].iloc[0], pr['mean_ci_upper'].iloc[0]))
predcov = pd.DataFrame(pred_cov, columns=['habitat','share_covadj','ci_low','ci_high']).sort_values('share_covadj', ascending=False)
p('\nHabitat shares predicted by covariate-adjusted model (covariates at 0):')
p(predcov.round(3).to_string())

# ----------------------------------------------------------------------
p('\n' + '='*80)
p('SUPPORTING: habitat x pathway contingency (chi2)')
p('='*80)
tab = agg[['n.gard','n.unint','n.agfo']]
chi2, cp, dof, exp = stats.chi2_contingency(tab)
p(tab.to_string())
p(f"\nChi-square (habitat x 3 pathways): chi2={chi2:.2f}, df={dof}, p={cp:.4g}")
tab2 = pd.DataFrame({'gardening':agg['n.gard'], 'non_gardening':agg['n.unint']+agg['n.agfo']})
chi2b, pb, dofb, _ = stats.chi2_contingency(tab2)
p(f"Chi-square (habitat x [gardening vs non-gardening]): chi2={chi2b:.2f}, df={dofb}, p={pb:.4g}")
tot_g = agg['n.gard'].sum(); tot_ng = agg['n.total'].sum()-tot_g
rows=[]
for h,r in tab2.iterrows():
    st = np.array([[r['gardening'], r['non_gardening']],[tot_g-r['gardening'], tot_ng-r['non_gardening']]])
    odds, f_p = stats.fisher_exact(st)
    rows.append((h, r['gardening'], r['non_gardening'], odds, f_p))
fisher = pd.DataFrame(rows, columns=['habitat','gardening','non_gardening','odds_ratio','fisher_p'])
p('\nPer-habitat Fisher exact vs overall distribution (gardening vs non-gardening):')
p(fisher.round(3).to_string())

# ----------------------------------------------------------------------
p('\n' + '='*80)
p('SECONDARY: SPECIES-LEVEL OCCUPANCY BY PATHWAY (Wilcoxon/Mann-Whitney Gardening vs Unintentional)')
p('='*80)
metrics = ['number.of.invaded.plots','area.of.occupancy.10km','habitat.range','invaded.niche.breadth']
g = isp[isp['intro.pathway']=='Gardening']
u = isp[isp['intro.pathway']=='Unintentional']
a = isp[isp['intro.pathway']=='AgriForest']
def rank_biserial(u_stat, n1, n2):
    return 1 - 2*u_stat/(n1*n2)
res=[]
for m in metrics:
    ustat, wp = stats.mannwhitneyu(g[m], u[m], alternative='two-sided')
    rb = rank_biserial(ustat, len(g), len(u))
    res.append((m, g[m].median(), u[m].median(), g[m].mean(), u[m].mean(), ustat, wp, rb))
p(f"Gardening n={len(g)}, Unintentional n={len(u)}")
p(pd.DataFrame(res, columns=['metric','gard_median','unint_median','gard_mean','unint_mean','U','p','rank_biserial_rb']).round(3).to_string())

dup_idx = isp[isp['duplicated']==True].index
g2 = g.drop(dup_idx.intersection(g.index))
u2 = u.drop(dup_idx.intersection(u.index))
p(f"\nSENSITIVITY after dropping duplicated two-pathway rows: Gardening n={len(g2)}, Unintentional n={len(u2)} "
  f"(removed {len(g)-len(g2)} Gardening, {len(u)-len(u2)} Unintentional)")
res2=[]
for m in metrics:
    ustat, wp = stats.mannwhitneyu(g2[m], u2[m], alternative='two-sided')
    rb = rank_biserial(ustat, len(g2), len(u2))
    res2.append((m, g2[m].median(), u2[m].median(), ustat, wp, rb))
p(pd.DataFrame(res2, columns=['metric','gard_median','unint_median','U','p','rank_biserial_rb']).round(3).to_string())

p('\nKruskal-Wallis across all 3 pathways:')
for m in metrics:
    hk, wk = stats.kruskal(g[m], u[m], a[m])
    p(f"  {m}: H={hk:.2f}, p={wk:.4g}")

# ----------------------------------------------------------------------
p('\n' + '='*80)
p('CONTEXT: TEMPORAL GARDENING SHARE (Catalonia-wide, not habitat-linked)')
p('='*80)
piv = tt.pivot(index='introduction.period', columns='pathway', values='n')
piv['total'] = piv.sum(axis=1)
piv['pct.gardening'] = 100*piv['Gardening']/piv['total']
p(piv.round(1).to_string())

with open('analysis/full_analysis_output.txt','w') as f:
    f.write('\n'.join(out))
print('\nDONE - output saved to analysis/full_analysis_output.txt')
