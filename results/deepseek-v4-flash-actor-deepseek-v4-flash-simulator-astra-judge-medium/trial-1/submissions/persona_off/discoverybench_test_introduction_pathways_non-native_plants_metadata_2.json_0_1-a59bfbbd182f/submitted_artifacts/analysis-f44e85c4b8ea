"""
DiscoveryBench (test) - Introduction pathways of non-native plants (Catalonia/Barcelona)
Question: "In what context does the gardening pathway for introducing non-native
plants show different prevalence styles across habitat types?"
Pipeline:
  A. Load & validate the 4 assets.
  B. Per-habitat descriptive prevalence (Frequency style: % plots with >=1 gardening
     species; Dominance style: within invaded plots, gardening share n.gard/n.total
     and % of gardening-present plots where share >= 0.5). Sample sizes included.
  C. Collinearity diagnostics (VIF) for environmental context variables.
  D. Logistic regression: P(plot has >=1 gardening species) ~ environmental context
     across all 632 plots  -> "frequency style" conditioning.
  E. Binomial GLM (quasibinomial-corrected): n.gard / n.total ~ environmental
     context, restricted to invaded plots (n.total>0) -> "dominance style" conditioning.
  F. Supporting: species-level trait profile per pathway; temporal regime backdrop.
  G. Figures (SVG, stdlib-only) + machine-readable result tables.
"""
import os, math, json
import numpy as np
import pandas as pd
import scipy.stats as st
import statsmodels.api as sm
import statsmodels.formula.api as smf
from statsmodels.stats.outliers_influence import variance_inflation_factor

OUT = "outputs"; FIG = "figures"
os.makedirs(OUT, exist_ok=True); os.makedirs(FIG, exist_ok=True)
syspath = os.path.join(os.path.dirname(__file__), "helpers_svg.py")
import importlib.util
spec = importlib.util.spec_from_file_location("helpers_svg", syspath)
hs = importlib.util.module_from_spec(spec); spec.loader.exec_module(hs)
report_lines = []
def pr(*a):
    s = " ".join(str(x) for x in a); print(s); report_lines.append(s)

# -------------------------------------------------- A. Load & validate
pr("="*78); pr("A. LOAD & VALIDATE"); pr("="*78)
df_t = pd.read_csv("data/temporal_trends_contingency_table.csv", sep="\t")
df_s = pd.read_csv("data/invasion_success_pathways.csv")
df_p = pd.read_csv("data/invaded_niche_pathways.csv", sep="\t")
with open("data/phylogenetic_tree.txt") as f: tree_str = f.read().strip()

pr(f"temporal contingency   : {df_t.shape}, NA={df_t.isna().sum().sum()}")
pr(f"species-level (traits) : {df_s.shape}, NA cols: {list(df_s.columns[df_s.isna().any()])}")
pr(f"plot-level (inv. niche): {df_p.shape}, NA={df_p.isna().sum().sum()}")
assert (df_p['n.gard']+df_p['n.unint']+df_p['n.agfo'] - df_p['n.total']).abs().max() == 0
assert df_p[['latitude','longitude']].drop_duplicates().shape[0] == len(df_p)
pr("counts sum exactly to n.total; 632 unique coords (rows = plots)")
pr(f"plot totals: gard={df_p['n.gard'].sum()}, unint={df_p['n.unint'].sum()}, agfo={df_p['n.agfo'].sum()}, total={df_p['n.total'].sum()}")
pr(f"species pathway counts: {df_s['intro.pathway'].value_counts().to_dict()}")
pr(f"temporal pathway totals: {df_t.groupby('pathway')['n'].sum().to_dict()}")

# -------------------------------------------------- B. Per-habitat prevalence
pr(""); pr("="*78); pr("B. PER-HABITAT PREVALENCE (Frequency & Dominance styles)"); pr("="*78)
df_p['has_gard'] = (df_p['n.gard'] > 0).astype(int)
df_p['has_intro'] = (df_p['n.total'] > 0).astype(int)
inv = df_p[df_p['n.total'] > 0].copy()
inv['share'] = inv['n.gard'] / inv['n.total']
inv['dom'] = (inv['share'] >= 0.5).astype(int)

hab_order = ('Urban','Wetlands','Coastal','Riparian','Croplands','Meadows',
             'Coniferous forests','Broad-leaved forests','Scrublands','Rock outcrops')
rows = []
for h in hab_order:
    hh = df_p[df_p['habitat'] == h]; ii = inv[inv['habitat'] == h]
    nplots = len(hh); n_inv = int(hh['has_intro'].sum()); n_gp = int(hh['has_gard'].sum())
    occ = 100*n_gp/nplots; invp = 100*n_inv/nplots
    smean = ii['share'].mean() if n_inv>0 else np.nan
    smed = ii['share'].median() if n_inv>0 else np.nan
    domp = 100*ii['dom'].mean() if n_inv>0 else np.nan
    rows.append(dict(habitat=h, n_plots=nplots, n_invaded=n_inv, inv_pct=round(invp,1),
                     n_gard_present=n_gp, gard_occ_pct=round(occ,1),
                     share_mean=round(smean,2) if not np.isnan(smean) else np.nan,
                     share_median=round(smed,2) if not np.isnan(smed) else np.nan,
                     dom_pct=round(domp,1) if not np.isnan(domp) else np.nan))
ph = pd.DataFrame(rows)
ph.to_csv(f"{OUT}/per_habitat_prevalence.csv", index=False)
pr(ph.to_string(index=False, float_format=lambda x: f"{x:.2f}"))
pr("\nSpearman(r): gard_occ_pct vs share_mean = %s ; inv_pct vs gard_occ_pct = %s" % (
    round(st.spearmanr(ph['gard_occ_pct'], ph['share_mean'], nan_policy='omit').statistic,2),
    round(st.spearmanr(ph['inv_pct'], ph['gard_occ_pct']).statistic,2)))

high = ['Urban','Wetlands','Coastal','Riparian']
low  = ['Coniferous forests','Broad-leaved forests','Scrublands','Rock outcrops','Meadows']
hA = df_p[df_p['habitat'].isin(high)]; lA = df_p[df_p['habitat'].isin(low)]
tab = np.array([[hA['has_gard'].sum(), len(hA)-hA['has_gard'].sum()],
                [lA['has_gard'].sum(), len(lA)-lA['has_gard'].sum()]])
or_, p_fish = st.fisher_exact(tab)
pr(f"\nFisher exact gardening occurrence lowland-humanized(n={len(hA)}) vs upland-natural(n={len(lA)}): OR={or_:.2f}, p={p_fish:.2e} [{tab.tolist()}]")
shareA = inv[inv['habitat'].isin(high)]['share']; shareB = inv[inv['habitat'].isin(low)]['share']
u, p_mw = st.mannwhitneyu(shareA, shareB, alternative='two-sided')
pr(f"Mann-Whitney per-plot share: high-context n={len(shareA)} med={shareA.median():.2f} vs low-context n={len(shareB)} med={shareB.median():.2f}, p={p_mw:.3f}")

# -------------------------------------------------- C. Collinearity / VIF
pr(""); pr("="*78); pr("C. ENVIRONMENTAL CONTEXT: collinearity / VIF"); pr("="*78)
pred = ['elevation','urban.2009.1000m','cropland.2009.50m','distance.road','distance.stream',
        'progressive.1993.2009.50m','annual.rainfall','annual.temperature']
Xm = df_p[pred].copy(); Xz = (Xm - Xm.mean())/Xm.std(); Xz['const'] = 1.0
vif = pd.DataFrame({'var': pred, 'VIF_z': [variance_inflation_factor(Xz.values, i) for i in range(len(pred))]})
pr(vif.to_string(index=False))
pr("elev~temp r=-0.96, elev~rain r=0.86, temp~rain r=-0.90 => keep ELEVATION as climatic-xeric gradient;")
pr("drop temp & rainfall from joint models; keep urban.2009.1000m, cropland.2009.50m, dist.road, dist.stream, progressive.1993.2009.50m")

# -------------------------------------------------- D. Logistic regression (frequency)
pr(""); pr("="*78); pr("D. LOGISTIC REGRESSION - P(plot has >=1 gardening species), n=632 (FREQUENCY style)"); pr("="*78)
mpred = ['elevation','urban.2009.1000m','cropland.2009.50m','distance.road','distance.stream',
         'progressive.1993.2009.50m']
dfm = df_p.copy()
for c in mpred: dfm[c+'_z'] = (dfm[c]-dfm[c].mean())/dfm[c].std()
X1 = sm.add_constant(dfm[[c+'_z' for c in mpred]])
m_log = sm.GLM(dfm['has_gard'], X1, family=sm.families.Binomial()).fit()
pr(m_log.summary2().as_text())
b = m_log.params.iloc[1:]; pv = m_log.pvalues.iloc[1:]
or_df = pd.DataFrame({'predictor': mpred, 'coef': b.values,
                      'OR_per_1SD': np.exp(b.values), 'p': pv.values})
or_df = or_df.sort_values('OR_per_1SD')
pr("\nOdds ratios (+/- 1 SD) for gardening OCCURRENCE:")
pr(or_df.round(3).to_string(index=False))
or_df.to_csv(f"{OUT}/logistic_occurrence_results.csv", index=False)
yhat = m_log.predict(X1)
accu = ((yhat>0.5).astype(int)==dfm['has_gard'].values).mean()
pr(f"McFadden pseudo-R2={1-m_log.llf/m_log.llnull:.3f}; acc(0.5)={accu:.3f}; base rate={dfm['has_gard'].mean():.3f}")

# -------------------------------------------------- E. Binomial GLM (dominance/share)
pr(""); pr("="*78)
pr("E. BINOMIAL GLM - gardening share n.gard/n.total among INVADED plots (n.total>0, n=191) (DOMINANCE style)")
pr("="*78)
inv = inv.copy()
mpred2 = ['elevation','urban.2009.1000m','distance.road','progressive.1993.2009.50m','cropland.2009.50m']
for c in mpred2: inv[c+'_z'] = (inv[c]-inv[c].mean())/inv[c].std()
X2 = sm.add_constant(inv[[c+'_z' for c in mpred2]])
y2 = inv['n.gard']; wt = inv['n.total']
m_bin = sm.GLM(y2/wt, X2, family=sm.families.Binomial(), freq_weights=wt).fit()
pearson = np.sum(m_bin.resid_pearson**2); disp = pearson/m_bin.df_resid
pr(f"Pearson chi2={pearson:.1f}, df_resid={m_bin.df_resid}, overdispersion={disp:.2f}")
qt = np.sqrt(disp)
coefs = m_bin.params; se_b = m_bin.bse*qt; pvals = 2*(1-st.norm.cdf(np.abs(coefs/se_b)))
res_b = pd.DataFrame({'predictor':['Intercept']+mpred2,'coef':coefs,'SE_quasi':se_b,
                      'z':coefs/se_b,'p':pvals,'OR_per_1SD':np.exp(coefs)})
pr("Coefficients (quasibinomial SE = SE*sqrt(overdispersion)):")
pr(res_b.round(3).to_string(index=False))
res_b.to_csv(f"{OUT}/binomial_share_results.csv", index=False)
pr(f"Mean share invaded plots: {inv['share'].mean():.3f} n={len(inv)}; zero-share (gard=0 among invaded): {(inv['n.gard']==0).sum()}")

# -------------------------------------------------- F. Supporting evidence
pr(""); pr("="*78); pr("F. SUPPORTING EVIDENCE"); pr("="*78)
pr("--- F1. Species-level trait profile by pathway (composition style) ---")
tr = df_s.groupby('intro.pathway')[['number.of.invaded.plots','area.of.occupancy.10km','habitat.range',
                                    'invaded.niche.breadth','mrt','height']].mean().round(2)
pr(tr.to_string())
pr(pd.crosstab(df_s['intro.pathway'], df_s['growth.form']).to_string())
pr("--- F2. Temporal regime backdrop ---")
df_t['pct_period'] = 100*df_t['n']/df_t.groupby('introduction.period')['n'].transform('sum')
pr(df_t.pivot_table(index='introduction.period', columns='pathway', values='pct_period').round(1).to_string())
df_t['pct_path'] = 100*df_t['n']/df_t.groupby('pathway')['n'].transform('sum')
pr("\n% of each pathway's total occurring in 1985-2019:")
pr(df_t[df_t['introduction.period']=='1985-2019'].pivot_table(index='introduction.period', columns='pathway', values='pct_path').round(1).to_string())

# -------------------------------------------------- G. Figures (SVG)
pr(""); pr("="*78); pr("G. FIGURES (SVG)"); pr("="*78)
hs.bar_chart_svg(f"{FIG}/fig1_frequency_occurrence.svg", list(ph['habitat']), list(ph['gard_occ_pct']),
                 "Frequency style: % of plots with >=1 gardening-introduced species by habitat",
                 "% of plots with gardening", color='#4C78A8', ymax=60,
                 value_labels=[str(x) for x in ph['n_plots']])
hs.errbar_chart_svg(f"{FIG}/fig1b_dominance_share.svg", list(ph['habitat']),
                    [0 if pd.isna(x) else x for x in ph['share_mean']], [0.0]*len(ph),
                    "Dominance style: mean gardening share (n.gard/n.total) among INVADED plots (label=n_invaded)",
                    "gardening share of invaded flora", ymax=1.05,
                    value_labels=[str(x) for x in ph['n_invaded']])
hs.scatter_svg(f"{FIG}/fig2_share_vs_elevation.svg", list(inv['elevation']), list(inv['share']), list(inv['habitat']),
               "Per-plot gardening share vs elevation (invaded plots, n=191)", "elevation (m)",
               "gardening share n.gard/n.total", ymax=1.0, size=3.5, jitter=0.015)
hs.scatter_svg(f"{FIG}/fig2b_share_vs_urban.svg", list(inv['urban.2009.1000m']), list(inv['share']), list(inv['habitat']),
               "Per-plot gardening share vs urban cover 1-km (invaded plots, n=191)",
               "urban cover 2009 @ 1000 m (fraction)", "gardening share", ymax=1.0, size=3.5, jitter=0.015)
grp = df_p['has_gard'].map({1:'gardening present',0:'no gardening'})
hs.scatter_svg(f"{FIG}/fig3_map_presence.svg", list(df_p['longitude']), list(df_p['latitude']), list(grp),
               "All 632 survey plots (UTM coords): gardening species presence",
               "UTM easting (m)", "UTM northing (m)",
               colors={'gardening present':'#E45756','no gardening':'#BAB0AC'}, jitter=1500.0, size=3.0)
def orr_chart(path, labels, ors, pvals, title):
    w,h=760,380; marL=310; marB=50; marT=45; marR=80
    n=len(labels); rowh=(h-marT-marB)/n
    out=[hs.svg_header(w,h), f'<text x="{marL}" y="27" font-size="16" font-weight="bold">{title}</text>']
    x0=math.log(0.15); x1=math.log(6.0)
    def X(v): return marL + (math.log(v)-x0)/(x1-x0)*(w-marL-marR)
    for g in range(0,9):
        v=0.15*2**g; xx=X(v)
        out.append(f'<text x="{xx:.0f}" y="{h-10}" font-size="10" text-anchor="middle">{v:g}</text>')
    out.append(f'<line x1="{X(1):.0f}" y1="{marT}" x2="{X(1):.0f}" y2="{h-marB}" stroke="#999" stroke-dasharray="4,3"/>')
    out.append(f'<text x="{X(1):.0f}" y="{marT-6}" font-size="10" text-anchor="middle" fill="#999">OR=1</text>')
    for i,(lab,o_,p_) in enumerate(zip(labels,ors,pvals)):
        y=marT+i*rowh+rowh/2; xv=X(o_)
        sig="*" if p_<0.05 else ""
        out.append(f'<text x="{marL-8}" y="{y+4}" font-size="12" text-anchor="end">{lab}{sig}</text>')
        out.append(f'<circle cx="{xv:.1f}" cy="{y:.0f}" r="7" fill="#4C78A8"/>')
        out.append(f'<text x="{xv+10}" y="{y+4}" font-size="10">{o_:.2f}</text>')
    out.append(hs.svg_footer())
    with open(path,'w') as f: f.write('\n'.join(out))
orr_chart(f"{FIG}/fig4_odds_ratios.svg", list(reversed(or_df['predictor'])),
          list(reversed(or_df['OR_per_1SD'])), list(reversed(or_df['p'])),
          "Odds ratio per 1-SD increase in context variable on gardening OCCURRENCE (* p<0.05)")
pr("saved figures:", sorted(os.listdir(FIG)))
with open(f"{OUT}/console_report.txt","w") as f: f.write("\n".join(report_lines))
ctx = df_p.groupby('habitat')[['elevation','urban.2009.1000m','cropland.2009.50m','distance.road',
                               'distance.stream','annual.temperature','annual.rainfall',
                               'progressive.1993.2009.50m']].mean().round(2)
ctx.to_csv(f"{OUT}/habitat_context_profile.csv")
pr(""); pr("Habitat context profile (means):"); pr(ctx.to_string())
pr("\nDONE. outputs -> outputs/ ; figures -> figures/")
