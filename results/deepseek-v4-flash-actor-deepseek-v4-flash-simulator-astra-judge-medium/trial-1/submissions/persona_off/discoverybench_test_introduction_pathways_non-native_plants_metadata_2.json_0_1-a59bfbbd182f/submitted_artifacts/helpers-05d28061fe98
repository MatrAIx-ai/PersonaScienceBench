"""Minimal stdlib-only SVG plotting helpers (no matplotlib needed, offline env)."""
import math

def svg_header(w, h):
    return (f'<svg xmlns="http://www.w3.org/2000/svg" width="{w}" height="{h}" '
            f'viewBox="0 0 {w} {h}" font-family="DejaVu Sans,Arial,sans-serif">')

def svg_footer():
    return '</svg>'

def bar_chart_svg(path, labels, values, title, ylabel, value_labels=None,
                  color='#4C78A8', ymax=None, width=760, height=430,
                  marL=70, marB=60, marT=45, marR=20):
    """Simple horizontal-category vertical-bar chart."""
    n = len(labels)
    if ymax is None:
        ymax = max([v for v in values if v is not None] + [0]) * 1.15
    plotW = width - marL - marR
    plotH = height - marT - marB
    bw = plotW / n * 0.62
    out = [svg_header(width, height),
           f'<text x="{marL}" y="{27}" font-size="17" font-weight="bold">{title}</text>']
    # y grid
    import math as m
    for g in range(0, 6):
        gy = g/5.0*ymax
        y = marT + plotH - (gy/ymax)*plotH
        out.append(f'<line x1="{marL}" y1="{y:.1f}" x2="{width-marR}" y2="{y:.1f}" stroke="#ddd"/>')
        out.append(f'<text x="{marL-6}" y="{y+4:.1f}" font-size="11" text-anchor="end">{gy:.2f}</text>')
    out.append(f'<text x="{marL}" y="{height-14}" font-size="12">{ylabel}</text>')
    for i, (lab, v) in enumerate(zip(labels, values)):
        if v is None:
            continue
        vv = max(v, 0)
        x = marL + i*plotW/n + (plotW/n-bw)/2
        hpx = (vv/ymax)*plotH
        out.append(f'<rect x="{x:.1f}" y="{marT+plotH-hpx:.1f}" width="{bw:.1f}" height="{hpx:.1f}" fill="{color}"/>')
        tl = f'{vv:.3f}' if vv < 0.01 else f'{vv:.2f}'
        if value_labels is not None:
            tl = value_labels[i]
        out.append(f'<text x="{x+bw/2:.1f}" y="{marT+plotH-hpx-3:.1f}" font-size="10" text-anchor="middle">{tl}</text>')
        words = lab.split()
        if len(words) > 1:
            mid = m.ceil(len(words)/2)
            out.append(f'<text x="{x+bw/2:.1f}" y="{marT+plotH+15:.1f}" font-size="9" text-anchor="middle" transform="rotate(32 {x+bw/2:.1f} {marT+plotH+15:.1f})">{words[0]}</text>')
            out.append(f'<text x="{x+bw/2+3:.1f}" y="{marT+plotH+27:.1f}" font-size="9" text-anchor="middle" transform="rotate(32 {x+bw/2+3:.1f} {marT+plotH+27:.1f})">{" ".join(words[1:])}</text>')
        else:
            out.append(f'<text x="{x+bw/2:.1f}" y="{marT+plotH+15:.1f}" font-size="9" text-anchor="middle">{lab}</text>')
    out.append(svg_footer())
    with open(path, 'w') as f:
        f.write('\n'.join(out))
    return path

def scatter_svg(path, xs, ys, groups, title, xlabel, ylabel,
                colors=None, width=760, height=480, marL=70, marB=60, marT=45, marR=25,
                xlog=False, xmax=None, ymax=None, jitter=None, size=4):
    """Colored scatter with legend."""
    if colors is None:
        pal = ['#4C78A8','#F58518','#54A24B','#E45756','#72B7B2','#EDC948','#B279A2','#FF9DA6','#9D755D','#BAB0AC']
        gl = sorted(set(groups))
        colors = {g: pal[i % len(pal)] for i, g in enumerate(gl)}
    import random
    rng = random.Random(20260614)
    xmin = float(min(xs)) if xs else 0.0
    xmax_f = float(max(xs))
    if xmax is None: xmax = xmax_f
    if ymax is None: ymax = float(max(ys)) if ys else 1.0
    if ymax <= 1.0: ymax = 1.0
    plotW = width - marL - marR
    plotH = height - marT - marB
    def X(x):
        if xlog:
            import math
            x0 = 1.0
            return marL + (math.log(max(x,1)) - math.log(x0))/(math.log(xmax)-math.log(x0))*plotW
        return marL + (x - xmin)/(xmax - xmin)*plotW
    def Y(y):
        return marT + plotH - (y/ymax)*plotH
    out = [svg_header(width, height),
           f'<text x="{marL}" y="{27}" font-size="17" font-weight="bold">{title}</text>']
    # grid
    for g in range(0,6):
        gy = g/5.0*ymax
        y = Y(gy)
        out.append(f'<line x1="{marL}" y1="{y:.1f}" x2="{width-marR}" y2="{y:.1f}" stroke="#eee"/>')
        out.append(f'<text x="{marL-6}" y="{y+4:.1f}" font-size="11" text-anchor="end">{gy:.2f}</text>')
    for g in range(0,6):
        gx = xmin + g/5.0*(xmax-xmin)
        x = X(gx)
        out.append(f'<line x1="{x:.1f}" y1="{marT}" x2="{x:.1f}" y2="{marT+plotH}" stroke="#eee"/>')
        out.append(f'<text x="{x:.1f}" y="{marT+plotH+16}" font-size="11" text-anchor="middle">{gx:.0f}</text>')
    out.append(f'<text x="{marL+plotW//2}" y="{height-12}" font-size="12" text-anchor="middle">{xlabel}</text>')
    out.append(f'<text x="16" y="{marT+plotH//2}" font-size="12" text-anchor="middle" transform="rotate(-90 16 {marT+plotH//2})">{ylabel}</text>')
    seen = set()
    for x, y, g in zip(xs, ys, groups):
        jx = 0; jy = 0
        if jitter: jx = (rng.random()-0.5)*jitter; jy = (rng.random()-0.5)*jitter
        col = colors[g]
        out.append(f'<circle cx="{X(x+jx):.1f}" cy="{Y(min(y+jy,ymax)):.1f}" r="{size}" fill="{col}" fill-opacity="0.75"/>')
        if g not in seen:
            seen.add(g)
    # legend
    ly = marT + 12
    for g in sorted(seen):
        out.append(f'<rect x="{width-marR-170}" y="{ly-8}" width="14" height="14" fill="{colors[g]}"/>')
        out.append(f'<text x="{width-marR-150}" y="{ly}" font-size="11">{g}</text>')
        ly += 16
    out.append(svg_footer())
    with open(path, 'w') as f:
        f.write('\n'.join(out))
    return path

def errbar_chart_svg(path, labels, means, sds, title, ylabel, nvals=None,
                     color='#4C78A8', ymax=None, width=760, height=430,
                     marL=70, marB=60, marT=45, marR=20, value_labels=None):
    """Bar chart with error bars (mean +/- sd)."""
    import math as m
    n = len(labels)
    if ymax is None:
        ymax = max([m+sd for m,sd in zip(means,sds)] + [0.0]) * 1.15
    plotW = width - marL - marR; plotH = height - marT - marB
    bw = plotW / n * 0.62
    out = [svg_header(width, height), f'<text x="{marL}" y="{27}" font-size="17" font-weight="bold">{title}</text>']
    for g in range(0,6):
        gy = g/5.0*ymax; y = marT+plotH-(gy/ymax)*plotH
        out.append(f'<line x1="{marL}" y1="{y:.1f}" x2="{width-marR}" y2="{y:.1f}" stroke="#ddd"/>')
        out.append(f'<text x="{marL-6}" y="{y+4:.1f}" font-size="11" text-anchor="end">{gy:.2f}</text>')
    for i,(lab,mn,sd) in enumerate(zip(labels,means,sds)):
        x = marL + i*plotW/n + (plotW/n-bw)/2
        hpx = max((mn/ymax)*plotH, 0.0)
        out.append(f'<rect x="{x:.1f}" y="{marT+plotH-hpx:.1f}" width="{bw:.1f}" height="{hpx:.1f}" fill="{color}"/>')
        # error bar
        top = marT+plotH-(mn/ymax)*plotH
        eup = (sd/ymax)*plotH
        xx = x+bw/2
        out.append(f'<line x1="{xx:.1f}" y1="{top-eup:.1f}" x2="{xx:.1f}" y2="{min(top+eup,marT+plotH):.1f}" stroke="#333"/>')
        out.append(f'<line x1="{xx-4:.1f}" y1="{top-eup:.1f}" x2="{xx+4:.1f}" y2="{top-eup:.1f}" stroke="#333"/>')
        out.append(f'<line x1="{xx-4:.1f}" y1="{min(top+eup,marT+plotH):.1f}" x2="{xx+4:.1f}" y2="{min(top+eup,marT+plotH):.1f}" stroke="#333"/>')
        tl = f'{mn:.2f}\u00b1{sd:.2f}'
        if value_labels is not None:
            tl = value_labels[i]
        out.append(f'<text x="{xx:.1f}" y="{top-eup-4:.1f}" font-size="9" text-anchor="middle">{tl}</text>')
        words = lab.split()
        if len(words) > 1:
            mid = m.ceil(len(words)/2)
            out.append(f'<text x="{xx:.1f}" y="{marT+plotH+15:.1f}" font-size="9" text-anchor="middle" transform="rotate(32 {xx:.1f} {marT+plotH+15:.1f})">{words[0]}</text>')
            out.append(f'<text x="{xx+3:.1f}" y="{marT+plotH+27:.1f}" font-size="9" text-anchor="middle" transform="rotate(32 {xx+3:.1f} {marT+plotH+27:.1f})">{" ".join(words[1:])}</text>')
        else:
            out.append(f'<text x="{xx:.1f}" y="{marT+plotH+15:.1f}" font-size="9" text-anchor="middle">{lab}</text>')
    out.append(svg_footer())
    with open(path,'w') as f: f.write('\n'.join(out))
    return path
