import numpy as np, pandas as pd, scipy.stats as st
import statsmodels.api as sm

df_p = pd.read_csv("data/invaded_niche_pathways.csv", sep="\t")
df_p['has_gard']=(df_p['n.gard']>0).astype(int)
inv = df_p[df_p['n.total']>0].copy(); inv['share']=inv['n.gard']/inv['n.total']

print("="*70); print("SUPP 1. Univariate logistic for gardening OCCURRENCE (each context alone)"); print("="*70)
for c in ['elevation','urban.2009.1000m','cropland.2009.50m','distance.road','distance.stream','progressive.1993.2009.50m']:
    z=(df_p[c]-df_p[c].mean())/df_p[c].std()
    X=sm.add_constant(z)
    m=sm.GLM(df_p['has_gard'], X, family=sm.families.Binomial()).fit()
    print(f"  {c:28s} univariate coef(z1SD)={m.params.iloc[1]:+.3f}  OR={np.exp(m.params.iloc[1]):.3f}  p={m.pvalues.iloc[1]:.2e}")

print()
print("="*70); print("SUPP 2. Why urban drops out jointly in the occurrence model: urban vs elevation overlap"); print("="*70)
# corr among gardening-present plots
gp = df_p[df_p['has_gard']==1]
print(f"gardening-present plots: n={len(gp)}; mean elevation={gp['elevation'].mean():.0f}, mean urban1km={gp['urban.2009.1000m'].mean():.3f}")
# binned: fraction of plots with gardening by elevation band
df_p['elev_band']=pd.cut(df_p['elevation'], bins=[-1,200,500,900,3000])
fr = df_p.groupby('elev_band', observed=True).agg(n=('has_gard','size'), gard=('has_gard','sum'))
fr['pct']=100*fr['gard']/fr['n']
print(fr.to_string())

print()
print("="*70); print("SUPP 3. Dominance (share among invaded plots) across context terciles"); print("="*70)
for c in ['urban.2009.1000m','cropland.2009.50m','distance.road','elevation']:
    try:
        inv['q']=pd.qcut(inv[c], 3, labels=['low','mid','high'])
    except ValueError:
        inv['q']=pd.qcut(inv[c].rank(method='first'), 3, labels=['low','mid','high'])
    t=inv.groupby('q', observed=True)['share'].agg(['mean','median','count'])
    t= t.reindex([x for x in ['low','mid','high'] if x in t.index])
    print(f"-- {c}:"); print(t.round(3).to_string())
    # test low vs high tercile
    lo=inv[inv['q']=='low']['share']; hi=inv[inv['q']=='high']['share']
    u,p=st.mannwhitneyu(lo,hi, alternative='two-sided')
    print(f"   MWU low-vs-high tercile: p={p:.3f} (low med={lo.median():.2f}, high med={hi.median():.2f})")
