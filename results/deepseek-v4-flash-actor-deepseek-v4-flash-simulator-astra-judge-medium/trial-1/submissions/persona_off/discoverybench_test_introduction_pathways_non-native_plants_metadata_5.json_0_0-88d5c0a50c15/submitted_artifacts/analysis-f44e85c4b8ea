def z(s): return (s-s.mean())/s.std()
def design(oc,ub,cb):
    y=D[oc].astype(float)
    X=pd.DataFrame({'intercept':1.0,'urban':z(D[ub]),'crop':z(D[cb]),'elev':z(D['elevation']),
        'road':z(D['logdist_road']),'stream':z(D['logdist_stream']),'temp':z(D['annual_temperature']),'rain':z(D['annual_rainfall'])})
    return y,X
def logit(oc,ub,cb):
    pres=(D[oc]>0).astype(int); y,X=design(oc,ub,cb)
    m=sm.Logit(pres,X).fit(disp=0); b=m.params['urban']; se=m.bse['urban']
    return dict(or_=np.exp(b),lo=np.exp(b-1.96*se),hi=np.exp(b+1.96*se),pv=m.pvalues['urban'],rate=pres.mean())
def pois(oc,ub,cb):
    y,X=design(oc,ub,cb); res=sm.GLM(y,X,family=sm.families.Poisson()).fit()
    b=res.params['urban']; se=res.bse['urban']
    disp=np.sum(res.resid_pearson**2)/res.df_resid
    return dict(irr=np.exp(b),lo=np.exp(b-1.96*se),hi=np.exp(b+1.96*se),pv=res.pvalues['urban'],disp=disp,aic=res.aic)
def nb(oc,ub,cb):
    y,X=design(oc,ub,cb)
    try:
        r=NegativeBinomial(y,X).fit(method='nm',maxiter=3000,disp=0)
        b=r.params['urban']; se=r.bse['urban']
        return dict(irr=np.exp(b),lo=np.exp(b-1.96*se),hi=np.exp(b+1.96*se),pv=r.pvalues['urban'],aic=r.aic,alpha=r.params['alpha'])
    except Exception as e:
        return dict(err=str(e))
