    try:
        rzinb=ZeroInflatedNegativeBinomialP(y,X,X,p=2).fit(method='nm',maxiter=3000,disp=0)
        line+='| ZINB AIC=%7.1f'%rzinb.aic
    except Exception as e:
        line+='| ZINB fail'
    p(line)
