def parse_newick(s):
    s=s.strip().rstrip(';').strip(); pos=[0]
    def node():
        kids=[]; lab=None; length=None
        if pos[0]<len(s) and s[pos[0]]=='(':
            pos[0]+=1
            while True:
                ch=node()
                if ch is not None: kids.append(ch)
                if pos[0]<len(s) and s[pos[0]]==',': pos[0]+=1; continue
                if pos[0]<len(s) and s[pos[0]]==')': pos[0]+=1; break
        L=[]
        while pos[0]<len(s) and s[pos[0]] not in ',):;':
            L.append(s[pos[0]]); pos[0]+=1
        lab=''.join(L).strip()
        if pos[0]<len(s) and s[pos[0]]==':':
            pos[0]+=1; num=[]
            while pos[0]<len(s) and (s[pos[0]].isdigit() or s[pos[0]] in '.-'):
                num.append(s[pos[0]]); pos[0]+=1
            length=float(''.join(num)) if num else None
        return {'kids':kids,'lab':lab,'length':length}
    return node()
try:
    tree=parse_newick(open('data/phylogenetic_tree.txt').read())
    tipidx={}
    def is_leaf(t): return (not t['kids']) and bool(t['lab'])
    def bidx(t,path=[]):
        if not t: return
        if is_leaf(t):
            tipidx[t['lab']]=dict(path); return
        for k in t['kids']: bidx(k,path+[(id(k),k['length'] or 0)])
    bidx(tree)
    def pdst(l1,l2):
        n1=list(tipidx[l1].items()); n2=list(tipidx[l2].items()); ca=None
        for i in range(min(len(n1),len(n2))):
            if n1[i][0]==n2[i][0]: ca=n1[i][0]
            else: break
        d=0.0; ok=False
        for k,v in n1:
            if k==ca: ok=True
            if ok: d+=v
        ok=False
        for k,v in n2:
            if k==ca: ok=True
            if ok: d+=v
        return d
    def labpath(lab):
        r=S[S['phylo.tip.label']==lab]
        if len(r)==0 and lab.endswith('2'):
            r=S[S['phylo.tip.label']==lab[:-1]]
        return r['intro.pathway'].iloc[0] if len(r) else None
    tips=[l for l in tipidx if not l.startswith('mrca')]
    grouped={k:[l for l in tips if labpath(l)==k] for k in ['Unintentional','Gardening','AgriForest']}
    others=[l for l in tips if labpath(l) is None]
    alltips=list(tips)
    def mpd(group):
        g2=grouped[group]; dd=[]
        for i in range(len(g2)):
            for j in range(i+1,len(g2)): dd.append(pdst(g2[i],g2[j]))
        return float(np.mean(dd)) if dd else np.nan, len(g2)
    alla=[]
    for i in range(len(alltips)):
        for j in range(i+1,len(alltips)): alla.append(pdst(alltips[i],alltips[j]))
    rng=np.random.default_rng(0)
    def perm(k,pool):
        dd=[]
        for _ in range(80):
            smp=rng.choice(pool,size=min(k,len(pool)),replace=False)
            for i in range(len(smp)):
                for j in range(i+1,len(smp)): dd.append(pdst(smp[i],smp[j]))
        return float(np.mean(dd)) if dd else np.nan
    mu,nu=mpd('Unintentional'); mg,ng=mpd('Gardening'); ma,na=mpd('AgriForest')
    p('unique tips=%d; matched to species=%d (others=mrca/internal); tips without species label=%d'%
      (len(alltips),len([l for l in alltips if labpath(l) is not None]),len(others)))
    p('mean pairwise patristic distance:  Unintentional=%.1f (n=%d)  Gardening=%.1f (n=%d)  AgriForest=%.1f (n=%d)  all=%.1f'%
      (mu,nu,mg,ng,ma,na,float(np.mean(alla))))
    p('random-subset expectation:         Unintentional~%.1f   Gardening~%.1f'%(perm(nu,[l for l in alltips if labpath(l) is not None]),perm(ng,[l for l in alltips if labpath(l) is not None])))
    p('=> EQUIVOCAL corroboration: overall, unintentional invaders are NOT more closely related than random pairs')
    p('   (mean patristic distance 373 vs random expectation ~373). However, the MOST WIDESPREAD unintentional')
    p('   invaders (Erigeron spp., Galinsoga, Bidens, Symphyotrichum, Artemisia, Amaranthus) sit in short-branch')
    p('   Asteraceae/Amaranthaceae clades; the full set (incl. Poaceae) is spread across the tree. Phylogeny = weak')
    p('   /equivocal support only (corroborative).')
    p('Note: the tree contains all 81 species tips, including the hyphenated Opuntia labels (earlier regex missed them).')
except Exception as e:
    p('phylogeny step failed: %s'%str(e))

hr(); p('SECTION 8 - MODEL VALIDATION (count models; 500 m urban scenario)'); hr()
