"""
FINAL consolidated analysis: What types of plant introductions were influenced by urban land use?
Primary evidence: plot-level (n=632) count models from invaded_niche_pathways.csv.
Context: temporal_trends contingency table; invasion_success species traits; phylogenetic tree.
"""
import numpy as np, pandas as pd, statsmodels.api as sm, warnings
from scipy import stats
warnings.filterwarnings('ignore')
np.set_printoptions(suppress=True)
pd.set_option('display.width', 250)

OUT = {'n.gard':'Gardening','n.unint':'Unintentional','n.agfo':'AgriForest','n.total':'Total'}
CONT = ['elevation','annual.temperature','annual.rainfall','annual.radiation',
        'distance.road','distance.stream']
def z(s): return (s-s.mean())/s.std()
def star(p):
    return '***' if p<0.001 else '**' if p<0.01 else '*' if p<0.05 else 'ns'

df = pd.read_csv('data/invaded_niche_pathways.csv', sep='\t')
df['habitat_cat'] = df['habitat'].astype('category')
df['delta_urban_500m'] = df['urban.2009.500m'] - df['urban.1956.500m']
dz = df.copy()
for c in CONT: dz[c] = z(dz[c])

def build(dat, ucol, ccol, use_hab, add_delta=False):
    X = (pd.get_dummies(dat['habitat_cat'], prefix='hab', drop_first=True, dtype=float)
         if use_hab else pd.DataFrame(index=dat.index))
    cols = [ucol, ccol]
    if add_delta: cols.append('delta_urban_500m')
    for c in cols+CONT:
        X[c] = z(dat[c])
    X.insert(0,'const',1.0)
    return X.astype(float)

def nb(dat, k, ucol='urban.2009.500m', ccol='cropland.2009.500m', use_hab=False, add_delta=False):
    X = build(dat, ucol, ccol, use_hab, add_delta); y = dat[k].values.astype(int)
    res = sm.NegativeBinomial(y, X, loglike_method='nb2').fit(method='lbfgs', maxiter=2000, disp=0)
    return res, ucol

print('='*110)
print('Q: What types of plant introductions were influenced by urban land use?')
print('Plot-level (Barcelona province, n=632 plots) NB count models. IRR per +1 SD urban cover.')
print('='*110)

# ---- PRIMARY: adjusted without habitat (landscape-gradient test) ----
print('\n[1] NB count model: count ~ urban.2009.500m + cropland.2009.500m + elevation + climate + distances')
print('    (NO habitat term -> tests the total urban land-use gradient)')
rows=[]
for k,l in OUT.items():
    res,uc = nb(dz,k,use_hab=False)
    c=res.params[uc]; se=res.bse[uc]
    irr=np.exp(c); lo=np.exp(c-1.96*se); hi=np.exp(c+1.96*se); p=res.pvalues[uc]
    rows.append({'pathway':l,'spec':'no-habitat (primary)','IRR':round(irr,3),'CI_lo':round(lo,3),'CI_hi':round(hi,3),'p':p,'sig':star(p)})
    print(f'  {l:14s} IRR={irr:.3f} (95%CI {lo:.3f}-{hi:.3f})  p={p:.2e}  {star(p)}')

# ---- full habitat control ----
print('\n[2] Same but WITH habitat fixed effect (between-habitat urban signal absorbed)')
for k,l in OUT.items():
    res,uc = nb(dz,k,use_hab=True)
    c=res.params[uc]; se=res.bse[uc]
    irr=np.exp(c); lo=np.exp(c-1.96*se); hi=np.exp(c+1.96*se); p=res.pvalues[uc]
    rows.append({'pathway':l,'spec':'with-habitat','IRR':round(irr,3),'CI_lo':round(lo,3),'CI_hi':round(hi,3),'p':p,'sig':star(p)})
    print(f'  {l:14s} IRR={irr:.3f} (95%CI {lo:.3f}-{hi:.3f})  p={p:.3f}  {star(p)}')

# ---- excluding Urban habitat ----
print('\n[3] Robustness: exclude the 65 plots classified as "Urban" (no-habitat model, n=567)')
sub = dz[dz['habitat']!='Urban']
for k,l in OUT.items():
    res,uc = nb(sub,k,use_hab=False)
    c=res.params[uc]; se=res.bse[uc]
    irr=np.exp(c); lo=np.exp(c-1.96*se); hi=np.exp(c+1.96*se); p=res.pvalues[uc]
    rows.append({'pathway':l,'spec':'excl-Urban-habitat','IRR':round(irr,3),'CI_lo':round(lo,3),'CI_hi':round(hi,3),'p':p,'sig':star(p)})
    print(f'  {l:14s} IRR={irr:.3f} (95%CI {lo:.3f}-{hi:.3f})  p={p:.4f}  {star(p)}')

# ---- delta urban (urbanization change) ----
print('\n[4] Urbanization dynamics: DeltaUrban = urban.2009.500m - urban.1956.500m (no-habitat)')
for k,l in OUT.items():
    res,uc = nb(dz,k,use_hab=False,add_delta=True); uc='delta_urban_500m'
    c=res.params[uc]; se=res.bse[uc]
    irr=np.exp(c); lo=np.exp(c-1.96*se); hi=np.exp(c+1.96*se); p=res.pvalues[uc]
    rows.append({'pathway':l,'spec':'delta-urban','IRR':round(irr,3),'CI_lo':round(lo,3),'CI_hi':round(hi,3),'p':p,'sig':star(p)})
    print(f'  {l:14s} IRR={irr:.3f} (95%CI {lo:.3f}-{hi:.3f})  p={p:.3f}  {star(p)}')

# ---- scale/year robustness (no-habitat, like primary) ----
print('\n[5] Buffer/year robustness of urban IRR (no-habitat model, per SD urban cover)')
for ucol,ccol,cfg in [('urban.2009.50m','cropland.2009.50m','50m/2009'),
                      ('urban.2009.500m','cropland.2009.500m','500m/2009'),
                      ('urban.2009.1000m','cropland.2009.1000m','1000m/2009'),
                      ('urban.1993.500m','cropland.1993.500m','500m/1993'),
                      ('urban.1956.500m','cropland.1956.500m','500m/1956')]:
    line=f'  {cfg:10s}: '
    for k,l in OUT.items():
        X = build(dz,ucol,ccol,False); y=dz[k].values.astype(int)
        res = sm.NegativeBinomial(y,X,loglike_method='nb2').fit(method='lbfgs',maxiter=2000,disp=0)
        c=res.params[ucol]; se=res.bse[ucol]; p=res.pvalues[ucol]
        line += f'{l[:4]}={np.exp(c):.2f}({star(p)})  '
    print(line)

# ---- raw rank correlations ----
print('\n[6] Raw Spearman correlations (n=632): pathway count vs urban/cropland 2009, 3 buffers')
raw=[]
for k,l in OUT.items():
    ur=[stats.spearmanr(dz[k],dz[f'urban.2009.{b}m'])[0] for b in [50,500,1000]]
    cr=[stats.spearmanr(dz[k],dz[f'cropland.2009.{b}m'])[0] for b in [50,500,1000]]
    raw.append({'pathway':l,'urban_50m':round(ur[0],2),'urban_500m':round(ur[1],2),'urban_1000m':round(ur[2],2),
                'crop_50m':round(cr[0],2),'crop_500m':round(cr[1],2),'crop_1000m':round(cr[2],2)})
    print(f'  {l:14s} urban r={ur[1]:.2f} (50m {ur[0]:.2f}, 1000m {ur[2]:.2f}) | crop r={cr[1]:.2f}')

# ---- temporal context ----
print('\n[7] Temporal context: pathway x period (temporal_trends_contingency_table.csv)')
tt = pd.read_csv('data/temporal_trends_contingency_table.csv', sep='\t')
piv = tt.pivot(index='introduction.period', columns='pathway', values='n').fillna(0)
print(piv.loc[['Before 1500','1501-1900','1901-1984','1985-2019']])
chi2,pv,dof,_= stats.chi2_contingency(piv)
print(f'  chi2={chi2:.1f}, dof={dof}, p={pv:.2e}')
print('  Recent (1985-2019) shares: Gardening %.1f%%, Unintentional %.1f%%, AgriForest %.1f%%' % (
    100*piv.loc['1985-2019','Gardening']/piv.loc['1985-2019'].sum(),
    100*piv.loc['1985-2019','Unintentional']/piv.loc['1985-2019'].sum(),
    100*piv.loc['1985-2019','AgriForest']/piv.loc['1985-2019'].sum()))

# ---- species trait context ----
print('\n[8] Species-level context (invasion_success_pathways.csv): mean traits per pathway')
inv = pd.read_csv('data/invasion_success_pathways.csv')
g = inv.groupby('intro.pathway').agg(n=('Scientific_name','size'),
    mean_invaded_plots=('number.of.invaded.plots','mean'),
    mean_mrt=('mrt','mean'), mean_hab_range=('habitat.range','mean'),
    mean_inv_niche=('invaded.niche.breadth','mean')).round(2)
print(g.to_string())
with open('data/phylogenetic_tree.txt') as fh: tree=fh.read()
tips=set(t for t in [t.split(':')[0] for t in tree.replace('(',' ').replace(')',' ').replace(',',' ').split()]
         if t and not t.startswith('mrca') and not t.endswith('.tre') and '_' in t)
print('  Tree tips matched to species phylo labels: %d/%d' % (len(tips & set(inv['phylo.tip.label'])), inv['phylo.tip.label'].nunique()))

# ---- save summary ----
resdf = pd.DataFrame(rows)
resdf['p'] = resdf['p'].map(lambda x: f'{x:.2e}')
print('\n[9] SUMMARY TABLE (IRR per +1 SD urban.2009.500m, 95% CI)')
pivot = resdf.pivot(index='pathway', columns='spec', values=['IRR','sig'])
print(pivot.to_string())
resdf.to_csv('analysis/summary_urban_effects.csv', index=False)
pd.DataFrame(raw).to_csv('analysis/summary_raw_correlations.csv', index=False)
print('\nSaved: analysis/summary_urban_effects.csv, analysis/summary_raw_correlations.csv')
