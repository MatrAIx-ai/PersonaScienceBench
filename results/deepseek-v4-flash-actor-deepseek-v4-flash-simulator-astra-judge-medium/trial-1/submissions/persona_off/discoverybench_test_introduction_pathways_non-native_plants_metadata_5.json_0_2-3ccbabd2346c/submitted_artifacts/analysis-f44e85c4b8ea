"""
FINAL ANALYSIS (executed)
Question: How did urban land use affect the invasion of different types of introduced plants?
Data: 4 assets in data/. Level 1: plot-level invaded niche by pathway (n=632).
Level 2: species-level invasion success by pathway/traits (n=81). Plus temporal-pathway
context and a phylogenetic sensitivity (Newick -> Brownian-motion VCV, GLS, Moran's I).
Libraries: numpy, pandas, scipy, statsmodels (all present in runtime).
"""
import numpy as np, pandas as pd, warnings, json, re
warnings.filterwarnings('ignore')
import statsmodels.api as sm
from scipy import stats
from statsmodels.stats.outliers_influence import variance_inflation_factor

RES = {}

# 0. LOAD & QUALITY
tt  = pd.read_csv('data/temporal_trends_contingency_table.csv', sep='\t', quotechar='"')
isp = pd.read_csv('data/invasion_success_pathways.csv')
inp = pd.read_csv('data/invaded_niche_pathways.csv', sep='\t', quotechar='"')
RES['quality'] = {
  'temporal_trends': {'shape': list(tt.shape), 'na': int(tt.isna().sum().sum())},
  'invasion_success': {'shape': list(isp.shape),
                       'na_placeholder_cols': {c:int(v) for c,v in isp.isna().sum().items() if v>0},
                       'unique_phylo_tips': int(isp['phylo.tip.label'].nunique()),
                       'pathway_counts': {k:int(v) for k,v in isp['intro.pathway'].value_counts().items()}},
  'invaded_niche': {'shape': list(inp.shape), 'na': int(inp.isna().sum().sum()),
                    'n_total_consistent': bool((inp['n.total']==inp[['n.gard','n.unint','n.agfo']].sum(axis=1)).all())}}

# 1. DESIGN (plot-level); climate/elevation -> PC1 to break collinearity
df = inp.copy()
clim = df[['elevation','annual.temperature','annual.rainfall']].values
climz = (clim-clim.mean(0))/clim.std(0)
ev, evec = np.linalg.eigh(np.cov(climz, rowvar=False))
pc1 = evec[:, np.argmax(ev)].real
df['climPC1'] = climz @ pc1
RES['climate_pca'] = {'explained_var_fraction_first_PC': float(ev.max()/ev.sum())}
Xcols = ['urban.2009.1000m','cropland.2009.1000m','climPC1','annual.radiation','distance.stream',
         'distance.road','longitude','latitude']
for c in Xcols + ['progressive.1956.2009.50m','progressive.1993.2009.50m','urban.2009.50m','urban.1956.1000m']:
    df[c+'_z'] = (df[c]-df[c].mean())/df[c].std()
dum = pd.get_dummies(df['habitat'], prefix='hab', drop_first=True).astype(float)
base = pd.concat([df[[c+'_z' for c in Xcols]], dum], axis=1)
nplot = len(df)
Xc = sm.add_constant(base)
RES['VIF_plot_design'] = {c: float(variance_inflation_factor(Xc.values, i+1)) for i,c in enumerate(base.columns)}

# 2. PLOT-LEVEL GEE PATHWAY-CONTRAST MODELS (stacked 3 pathway counts per plot)
def fit_gee(uvar, binomial=False, fam_nb=False):
    rows = []
    for pw, col in [('Gardening','n.gard'),('Unintentional','n.unint'),('AgriForest','n.agfo')]:
        t = base.reset_index(drop=True).copy(); t['y']=df[col].values; t['pw']=pw; rows.append(t)
    long = pd.concat(rows, ignore_index=True)
    u = df[uvar+'_z'].values
    long[uvar+'_z'] = np.tile(u, 3)
    long['pw_G']=(long['pw']=='Gardening').astype(float); long['pw_U']=(long['pw']=='Unintentional').astype(float)
    exX = long[base.columns].copy(); exX[uvar+'_z'] = np.tile(u,3)
    exX['urb_x_G'] = exX[uvar+'_z']*long['pw_G']; exX['urb_x_U'] = exX[uvar+'_z']*long['pw_U']
    exX = sm.add_constant(exX)
    if binomial:
        fam=sm.families.Binomial(); y=(long['y']>0).astype(int)
    elif fam_nb:
        fam=sm.families.NegativeBinomial(); y=long['y']
    else:
        fam=sm.families.Poisson(); y=long['y']
    m = sm.GEE(y, exX, groups=np.tile(np.arange(nplot),3), family=fam, cov_struct=sm.cov_struct.Exchangeable())
    r = m.fit()
    return r, exX

def summarize(r, exX, uvar):
    cols=list(exX.columns); b=r.params; cov=r.cov_params()
    bm=b[uvar+'_z']; bG=b['urb_x_G']; bU=b['urb_x_U']
    def se(w):
        v=0.0
        for (a,xa) in w:
            v+=xa*xa*cov.loc[a,a]
            for (bb,xb) in w:
                if a!=bb: v+=xa*xb*cov.loc[a,bb]
        return float(np.sqrt(v))
    sA, sG, sU = se([(uvar+'_z',1)]), se([(uvar+'_z',1),('urb_x_G',1)]), se([(uvar+'_z',1),('urb_x_U',1)])
    diff=(bm+bG)-(bm+bU)
    sDiff=float(np.sqrt(cov.loc['urb_x_G','urb_x_G']+cov.loc['urb_x_U','urb_x_U']-2*cov.loc['urb_x_G','urb_x_U']))
    def pz(z): return float(2*stats.norm.sf(abs(z)))
    out = {'slope_AgriForest': float(bm), 'se_A': sA, 'p_A': pz(bm/sA),
           'slope_Gardening': float(bm+bG), 'se_G': sG, 'p_G': pz((bm+bG)/sG),
           'slope_Unintentional': float(bm+bU), 'se_U': sU, 'p_U': pz((bm+bU)/sU),
           'G_minus_U': float(diff), 'p_G_vs_U': pz(diff/sDiff),
           'p_urb_x_Gardening_vs_AgriForest': float(r.pvalues['urb_x_G']),
           'p_urb_x_Unintentional_vs_AgriForest': float(r.pvalues['urb_x_U']),
           'converged': bool(r.converged)}
    R=np.zeros((2,len(cols))); R[0,cols.index('urb_x_G')]=1; R[1,cols.index('urb_x_U')]=1
    rb=R@b; covR=R@cov@R.T
    X2=float(rb@np.linalg.inv(covR)@rb)
    out['Wald_X2_equal_slopes']=X2
    out['Wald_p_equal_slopes']=float(stats.chi2.sf(X2,2))
    return out

r, exX = fit_gee('urban.2009.1000m')
RES['plot_GEE_primary_urban2009_1000m'] = summarize(r, exX, 'urban.2009.1000m')
RES['plot_GEE_primary_dispersion_pearson_chisq_df'] = float(np.sum(r.resid_pearson**2)/r.df_resid)
RES['plot_GEE_sensitivity']={}
for mvar in ['urban.2009.50m','urban.1956.1000m','progressive.1956.2009.50m','progressive.1993.2009.50m']:
    rr, exx = fit_gee(mvar); RES['plot_GEE_sensitivity'][mvar]=summarize(rr, exx, mvar)
rr, exx = fit_gee('urban.2009.1000m', fam_nb=True)
sb=summarize(rr, exx, 'urban.2009.1000m')
RES['plot_GEE_negativebinomial_robustness']={'slopes':{'AgriForest':sb['slope_AgriForest'],'Gardening':sb['slope_Gardening'],'Unintentional':sb['slope_Unintentional']},
                                             'p_urb_x_G':sb['p_urb_x_Gardening_vs_AgriForest'],'p_urb_x_U':sb['p_urb_x_Unintentional_vs_AgriForest']}
rp, exxp = fit_gee('urban.2009.1000m', binomial=True)
sbp=summarize(rp, exxp, 'urban.2009.1000m')
RES['plot_binomial_presence_GEE_urban2009_1000m']={'slopes':{'AgriForest':sbp['slope_AgriForest'],'Gardening':sbp['slope_Gardening'],'Unintentional':sbp['slope_Unintentional']},
                                                  'p_urb_x_G':sbp['p_urb_x_Gardening_vs_AgriForest'],'p_urb_x_U':sbp['p_urb_x_Unintentional_vs_AgriForest']}

# 3. AGGREGATE n.total + unadjusted checks
RES['aggregate_n_total_gee']={}
for mvar in ['urban.2009.1000m','urban.2009.50m','progressive.1956.2009.50m']:
    exA = sm.add_constant(base.copy()); exA[mvar+'_z']=df[mvar+'_z'].values
    rA = sm.GEE(df['n.total'].values, exA, groups=np.arange(nplot), family=sm.families.Poisson(),
                cov_struct=sm.cov_struct.Independence()).fit()
    RES['aggregate_n_total_gee'][mvar]={'coef':float(rA.params[mvar+'_z']),'p':float(rA.pvalues[mvar+'_z'])}
ru = sm.GLM((df['n.total']>0).astype(int), sm.add_constant(df['urban.2009.1000m_z']), family=sm.families.Binomial()).fit(cov_type='HC1')
RES['unadjusted_total_presence_vs_urban2009_1000m']={'logit_coef':float(ru.params['urban.2009.1000m_z']),'p':float(ru.pvalues['urban.2009.1000m_z'])}

RES['univariate_pathways_urban2009_1000m']={}
for pw,col in [('Gardening','n.gard'),('Unintentional','n.unint'),('AgriForest','n.agfo')]:
    y=(df[col]>0).astype(int)
    rr=sm.GLM(y, sm.add_constant(df['urban.2009.1000m_z']), family=sm.families.Binomial()).fit(cov_type='HC1')
    rho,ps=stats.spearmanr(df['urban.2009.1000m'],df[col])
    RES['univariate_pathways_urban2009_1000m'][pw]={'logit_coef':float(rr.params['urban.2009.1000m_z']),'p':float(rr.pvalues['urban.2009.1000m_z']),
                                                    'spearman_rho':float(rho),'spearman_p':float(ps)}
bprog = df[['progressive.1956.2009.50m_z','cropland.2009.1000m_z','climPC1','annual.radiation_z','distance.stream_z','distance.road_z','longitude_z','latitude_z']].join(dum).reset_index(drop=True)
RES['progressive_presence_fullcov']={}
for pw,col in [('Gardening','n.gard'),('Unintentional','n.unint'),('AgriForest','n.agfo')]:
    rr=sm.GLM((df[col]>0).astype(int), sm.add_constant(bprog), family=sm.families.Binomial()).fit(cov_type='HC1')
    RES['progressive_presence_fullcov'][pw]={'coef':float(rr.params['progressive.1956.2009.50m_z']),'p':float(rr.pvalues['progressive.1956.2009.50m_z'])}
RES['habitat_mean_counts']=df.groupby('habitat')[['n.gard','n.unint','n.agfo','n.total']].mean().round(2).to_dict()

# 4. SPECIES-LEVEL
s = isp.copy()
pw_all = pd.get_dummies(s['intro.pathway'], prefix='pw', dtype=float).drop(columns=['pw_Gardening'])
gf_dum = pd.get_dummies(s['growth.form'], prefix='gf', drop_first=True, dtype=float)
dp_dum = pd.get_dummies(s['dispersal'], prefix='disp', drop_first=True, dtype=float)
veg = (s['vegetative']=='Yes').astype(float)
RES['species_level']={}
for resp in ['number.of.invaded.plots','area.of.occupancy.10km','habitat.range']:
    X = pd.concat([pw_all, gf_dum, dp_dum, veg, s['native.niche.breadth'], np.log(s['mrt']), np.log(s['height']+0.01)], axis=1)
    X.columns=[str(c) for c in X.columns]; ex=sm.add_constant(X).astype(float)
    r = sm.GLM(s[resp].values.astype(float), ex, family=sm.families.NegativeBinomial()).fit(cov_type='HC1')
    RES['species_level'][resp]={'U_vs_Gardening':{'coef':float(r.params['pw_Unintentional']),'se':float(r.bse['pw_Unintentional']),'p':float(r.pvalues['pw_Unintentional'])},
                                'AF_vs_Gardening':{'coef':float(r.params['pw_AgriForest']),'se':float(r.bse['pw_AgriForest']),'p':float(r.pvalues['pw_AgriForest'])}}
X = pd.concat([pw_all, gf_dum, dp_dum, veg, s['native.niche.breadth'], np.log(s['mrt']), np.log(s['height']+0.01)], axis=1)
X.columns=[str(c) for c in X.columns]; ex=sm.add_constant(X).astype(float)
r = sm.OLS(s['invaded.niche.breadth'].values.astype(float), ex).fit(cov_type='HC1')
RES['species_level']['invaded.niche.breadth']={'U_vs_Gardening':{'coef':float(r.params['pw_Unintentional']),'p':float(r.pvalues['pw_Unintentional'])},
                                               'AF_vs_Gardening':{'coef':float(r.params['pw_AgriForest']),'p':float(r.pvalues['pw_AgriForest'])}}
RES['species_desc_means']={pw:{'plots':float(s.loc[s['intro.pathway']==pw,'number.of.invaded.plots'].mean()),
                               'area10km':float(s.loc[s['intro.pathway']==pw,'area.of.occupancy.10km'].mean()),
                               'niche_breadth':float(s.loc[s['intro.pathway']==pw,'invaded.niche.breadth'].mean()),
                               'mrt':float(s.loc[s['intro.pathway']==pw,'mrt'].mean())}
                           for pw in ['Gardening','Unintentional','AgriForest']}
famFE = pd.get_dummies(s['family'], prefix='fam', drop_first=True)
X2 = pd.concat([pw_all, famFE, s['native.niche.breadth'], np.log(s['mrt']), np.log(s['height']+0.01)], axis=1)
X2.columns=[str(c) for c in X2.columns]; ex2=sm.add_constant(X2).astype(float)
r2 = sm.GLM(s['number.of.invaded.plots'].values.astype(float), ex2, family=sm.families.NegativeBinomial()).fit(cov_type='HC1')
RES['species_family_FE_sensitivity']={'U_vs_Gardening':{'coef':float(r2.params['pw_Unintentional']),'p':float(r2.pvalues['pw_Unintentional'])},
                                      'AF_vs_Gardening':{'coef':float(r2.params['pw_AgriForest']),'p':float(r2.pvalues['pw_AgriForest'])}}

# 5. PHYLOGENETIC CHECK (Newick -> BM VCV, GLS on niche breadth, Moran's I)
def parse_newick(sr):
    sr=sr.strip().rstrip(';'); toks=re.findall(r'[^(),:]+|\(|\)|,|:', sr); i=0
    def walk():
        nonlocal i
        n={'name':None,'length':None,'children':[]}
        if toks[i]=='(':
            i+=1
            while True:
                n['children'].append(walk())
                if toks[i]==',': i+=1
                else: break
            if toks[i]!=')': raise ValueError('bad newick')
            i+=1
        else:
            n['name']=toks[i].strip(); i+=1
        if i<len(toks) and toks[i]==':':
            i+=1; n['length']=float(toks[i]); i+=1
        elif i<len(toks) and toks[i] not in (':',',',')'):
            n['name']=toks[i].strip(); i+=1
            if i<len(toks) and toks[i]==':': i+=1; n['length']=float(toks[i]); i+=1
        return n
    return walk()
root = parse_newick(open('data/phylogenetic_tree.txt').read())
tips=[]; tip_depth={}; pair_depth={}
def rec(n,acc):
    here=acc+(n['length'] or 0.0)
    if not n['children']:
        tips.append(n['name']); tip_depth[n['name']]=here; return {n['name']}
    union=set()
    for c in n['children']: union|=rec(c,here)
    for a in union:
        for b in union:
            if a!=b and ((a,b) not in pair_depth or acc>pair_depth[(a,b)]):
                pair_depth[(a,b)]=acc
    return union
rec(root,0.0)
RES['tree']={'ntips':len(tips),'tip_labels_match_data': bool(set(tips)==set(isp['phylo.tip.label']))}
idx={t:i for i,t in enumerate(tips)}
V=np.zeros((len(tips),len(tips)))
for i,t1 in enumerate(tips):
    for j,t2 in enumerate(tips):
        V[i,j]= tip_depth[t1] if i==j else pair_depth.get((t1,t2), pair_depth.get((t2,t1),0.0))
s2=s.sort_values('phylo.tip.label').reset_index(drop=True)
Vsub=V[np.ix_([idx[t] for t in s2['phylo.tip.label']],[idx[t] for t in s2['phylo.tip.label']])]+0.05*np.eye(len(s2))
Xp = pd.concat([pw_all.loc[s2.index], s2['native.niche.breadth'], np.log(s2['mrt']), np.log(s2['height']+0.01)], axis=1)
Xp.columns=[str(c) for c in Xp.columns]; exP=sm.add_constant(Xp).astype(float)
yP=s2['invaded.niche.breadth'].values.astype(float)
invV=np.linalg.inv(Vsub)
betaG=np.linalg.inv(exP.T@invV@exP)@(exP.T@invV@yP)
resid=yP-exP.values@betaG; nn=len(yP); pp=exP.shape[1]
s2v=float(resid@invV@resid/(nn-pp)); covG=s2v*np.linalg.inv(exP.T@invV@exP)
seG=np.sqrt(np.diag(covG)); pG=2*stats.norm.sf(np.abs(betaG/seG))
RES['phylogenetic_GLS_niche_breadth']={c:{'coef':float(betaG[i]),'se':float(seG[i]),'p':float(pG[i])}
                                       for i,c in enumerate(exP.columns) if c.startswith('pw_')}
r_ols=sm.OLS(yP, exP).fit(cov_type='HC1')
W=Vsub.copy(); np.fill_diagonal(W,0.0)
rbv=r_ols.resid.values-r_ols.resid.values.mean()
RES['phylogenetic_Moran_I_OLS_resid']=float((nn/W.sum())*(rbv@W@rbv)/(rbv@rbv))

# 6. TEMPORAL CONTEXT
piv=tt.pivot(index='introduction.period', columns='pathway', values='n')
chi2,pchi,dof,exp=stats.chi2_contingency(piv)
RES['temporal']={'chi2':float(chi2),'p':float(pchi),'dof':int(dof),
                 'observed_1985_2019':piv.loc['1985-2019'].to_dict(),
                 'expected_1985_2019':{piv.columns[i]:float(exp[-1,i]) for i in range(len(piv.columns))}}

with open('results_summary.json','w') as f:
    json.dump(RES, f, indent=1, default=str)
print('WROTE results_summary.json')
print('PRIMARY GEE:', json.dumps(RES['plot_GEE_primary_urban2009_1000m'], indent=1))
print('SPECIES nb plots:', json.dumps(RES['species_level']['number.of.invaded.plots'], indent=1))
print('TREE:', RES['tree'], '| Moran I:', round(float(RES['phylogenetic_Moran_I_OLS_resid']),4))
