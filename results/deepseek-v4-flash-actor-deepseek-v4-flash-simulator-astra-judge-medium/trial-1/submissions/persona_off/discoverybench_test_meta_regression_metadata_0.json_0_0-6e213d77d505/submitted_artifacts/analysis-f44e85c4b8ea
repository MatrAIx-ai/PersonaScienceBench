"""Domain analysis: original vs replication effect-size gaps.
Question: For which domains do the effect size estimates tend to be LARGER in
original studies compared to replication studies?
Scale: Fisher-z (fiso/fisr) is the primary analytic scale (variance-stabilized,
SEs provided); correlation scale (ro/rr) reported for interpretation.
Domain: discipline (Cognitive/Social/Economics), with project (rpp/ee) corroboration.
Formal cross-domain comparison: inverse-variance-weighted meta-regression of the
per-study Fisher-z gap on discipline dummies (matches the 'meta-regression' dataset).
"""
import pandas as pd, numpy as np
from scipy import stats
import statsmodels.formula.api as smf

np.random.seed(0)
df = pd.read_csv('data/meta-regression_joined_data_heterogeneity_in_replication_projects.csv')
assert np.allclose(df['fiso'], np.arctanh(df['ro'])) and np.allclose(df['fisr'], np.arctanh(df['rr']))

df['d'] = df['fiso'] - df['fisr']
df['se_d'] = np.sqrt(df['se_fiso']**2 + df['se_fisr']**2)
df['w'] = 1.0/df['se_d']**2
df['d_r'] = df['ro'] - df['rr']
df['discipline'] = pd.Categorical(df['discipline'], categories=['Cognitive','Social','Economics'])
df['project_label'] = df['project.y'].map({'rpp':'Psychology (rpp)','ee':'Experimental Econ (ee)'})

def summarize(groupcol):
    out=[]
    for g,s in df.groupby(groupcol, sort=False):
        n=len(s); z=1.959964
        wm=np.average(s['d'],weights=s['w']); wse=1/np.sqrt(s['w'].sum())
        t,p2=stats.ttest_1samp(s['d'],0)
        zw,pz=stats.wilcoxon(s['d'])
        out.append(dict(domain=g,n=n,
            fz_weighted_gap=wm, fz_ci_lo=wm-z*wse, fz_ci_hi=wm+z*wse,
            r_mean_gap=s['d_r'].mean(),
            r_ci_lo=s['d_r'].mean()-z*s['d_r'].std(ddof=1)/np.sqrt(n),
            r_ci_hi=s['d_r'].mean()+z*s['d_r'].std(ddof=1)/np.sqrt(n),
            mean_ro=s['ro'].mean(), mean_rr=s['rr'].mean(),
            prop_ro_gt_rr=(s['d_r']>0).mean(),
            paired_t_p2=p2, wilcox_p2=pz,
            replicated_rate=s['replicated'].mean(), median_relative_es=s['relative_es'].median()))
    return pd.DataFrame(out)

summary = summarize('discipline')
summary.to_csv('domain_summary.csv', index=False)
print("=== Per-domain summary (discipline) ===")
print(summary.round(4).to_string(index=False))

# Coarser corroboration
print("\n=== Coarser project grouping ===")
print(summarize('project_label').round(4).to_string(index=False))

# Cross-domain: WLS meta-regression of Fz gap on discipline (PRIMARY formal test)
m = smf.wls('d ~ discipline', data=df, weights=df['w']).fit(cov_type='HC1')
print("\n=== WLS meta-regression: Fisher-z gap ~ discipline (IV weights, HC1 SE) ===")
print(m.summary2().tables[1].round(4).to_string())

# Economics vs Social contrast
tmp=df.copy(); tmp['discipline']=pd.Categorical(tmp['discipline'], categories=['Social','Economics','Cognitive'])
m2=smf.wls('d ~ discipline', data=tmp, weights=tmp['w']).fit(cov_type='HC1')
print("\n=== Contrast (ref=Social): Economics - Social, Cognitive - Social ===")
print(m2.summary2().tables[1].round(4).to_string())

# Unweighted cross-domain tests for transparency
F,pF=stats.f_oneway(*[g for _,g in df.groupby('discipline')['d']])
H,pH=stats.kruskal(*[g for _,g in df.groupby('discipline')['d']])
print(f"\nUnweighted ANOVA on Fz gap: F={F:.3f}, p={pF:.4f} | Kruskal-Wallis: H={H:.3f}, p={pH:.4f}")
print("Note: unweighted tests ignore heterogeneous precision; the IV-weighted")
print("meta-regression above is the design-appropriate cross-domain comparison.")

# Economics gap vs 0 on the weighted scale
s=df[df['discipline']=='Economics']; wm=np.average(s['d'],weights=s['w']); wse=1/np.sqrt(s['w'].sum())
print(f"\nEconomics IV-weighted Fz gap = {wm:.3f} (95% CI {wm-1.96*wse:.3f} to {wm+1.96*wse:.3f}) -> {'significantly > 0' if wm-1.96*wse>0 else 'NOT distinguishable from 0'}")

# Headline numbers for the natural-language hypothesis
print("\nHEADLINE: IV-weighted Fz gaps  | Cognitive 0.206 [0.132,0.279] | Social 0.208 [0.161,0.255] | Economics 0.013 [-0.052,0.078]")
print("Meta-regression: Economics gap is ~0.19 LOWER than Cognitive (p=0.034) and Social (p=0.026); Cognitive vs Social equal (p=0.97).")
