"""
Data-grounded hypothesis analysis: 
"What is the proportion of junior professors in replicated studies in Psychology?"

Dataset: meta-regression_study_data_heterogeneity_in_replication_projects.csv
Interpretation (assumption-driven, per researcher-approved framing):
  - Psychology = project == 'rpp'  (97 unique studies; no duplicated ids in this subset)
  - 'replicated studies' = studies with replicated == 1  (p<=0.05, same direction); n=35
  - 'junior professor' = seniority label in {Assistant, Assistant Professor}  (Researcher excluded)
  - seniority source (primary) = replication team: seniority.r
All other defensible readings are reported in a full sensitivity table.
"""
import pandas as pd
import numpy as np
from scipy.stats import binomtest

CSV = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
df = pd.read_csv(CSV)

print("=" * 78)
print("STEP 1 - Load & schema / missingness check (whole file)")
print("=" * 78)
print(f"Shape: {df.shape[0]} rows x {df.shape[1]} cols")
for c in ["project", "replicated", "seniority.o", "seniority.r", "discipline", "id"]:
    print(f"  {c:>14}: non-null={df[c].notna().sum():>4}, null={df[c].isna().sum():>3}, "
          f"nunique={df[c].nunique():>4}")
print("  project value counts:", df["project"].value_counts(dropna=False).to_dict())
print("  replicated value counts:", df["replicated"].value_counts(dropna=False).to_dict())

print()
print("=" * 78)
print("STEP 2 - Filter Psychology subset (project == 'rpp')")
print("=" * 78)
rpp = df[df["project"] == "rpp"].copy()
print(f"rpp rows: {len(rpp)}; unique ids: {rpp['id'].nunique()}; duplicated ids: {rpp['id'].duplicated().sum()}")
for c in ["project", "replicated", "seniority.o", "seniority.r", "discipline"]:
    print(f"  {c:>14}: null count = {rpp[c].isna().sum()}")
print("  replicated:", rpp["replicated"].value_counts(dropna=False).to_dict())
print("  discipline:", rpp["discipline"].value_counts(dropna=False).to_dict())

# Subsets: replicated == 1 (successfully replicated, n=35) and ALL rpp (n=97)
rep = rpp[rpp["replicated"] == 1.0].copy()
n_rep = len(rep)
n_all = len(rpp)
print(f"\nDenominator A (replicated==1): n = {n_rep}")
print(f"Denominator B (all rpp studies) : n = {n_all}")

print()
print("=" * 78)
print("STEP 3 - Crosstabs of seniority by replicated outcome (rpp)")
print("=" * 78)
junior_labels = ["Assistant", "Assistant Professor"]
researcher_label = ["Researcher"]

print("\n-- seniority.r x replicated --")
ct_r = pd.crosstab(rpp["replicated"], rpp["seniority.r"])
print(ct_r)
print("\n-- seniority.o x replicated --")
ct_o = pd.crosstab(rpp["replicated"], rpp["seniority.o"])
print(ct_o)

print("\n-- seniority.r distribution (replicated==1 only, n=%d) --" % n_rep)
print(rep["seniority.r"].value_counts().sort_index().to_dict())
print("-- seniority.o distribution (replicated==1 only, n=%d) --" % n_rep)
print(rep["seniority.o"].value_counts().sort_index().to_dict())
print("-- seniority.r distribution (all rpp, n=%d) --" % n_all)
print(rpp["seniority.r"].value_counts().sort_index().to_dict())
print("-- seniority.o distribution (all rpp, n=%d) --" % n_all)
print(rpp["seniority.o"].value_counts().sort_index().to_dict())

print()
print("=" * 78)
print("STEP 4 - Proportions with exact binomial (Clopper-Pearson) 95% CIs")
print("=" * 78)

def prop_ci(k, n):
    if n == 0:
        return np.nan, np.nan
    p = k / n
    bt = binomtest(k, n)
    ci = bt.proportion_ci(confidence_level=0.95, method="exact")
    return p, ci.low, ci.high

# Definition sets
definitions = {
    "junior={Asst, AsstProf} (Researcher excluded)": junior_labels,
    "junior={Asst, AsstProf, Researcher} (incl Researcher)": junior_labels + researcher_label,
}
denoms = {"replicated==1 (n=35)": rpp[rpp["replicated"] == 1.0],
          "all rpp (n=97)": rpp}
sources = {"seniority.r (replication team)": "seniority.r",
           "seniority.o (original authors)": "seniority.o"}

rows = []
for denom_name, sub in denoms.items():
    n = len(sub)
    for src_name, col in sources.items():
        for def_name, labels in definitions.items():
            k = sub[col].isin(labels).sum()
            p, lo, hi = prop_ci(k, n)
            rows.append({
                "denominator": denom_name,
                "seniority_source": src_name,
                "junior_definition": def_name,
                "n": n,
                "k_junior": k,
                "proportion": round(p, 4),
                "CI95_low": round(lo, 4),
                "CI95_high": round(hi, 4),
            })

sens = pd.DataFrame(rows)
print(sens.to_string(index=False))

print()
print("=" * 78)
print("STEP 5 - Where the differences come from")
print("=" * 78)
print("seniority.o for rpp contains ONLY: ",
      sorted(rpp["seniority.o"].dropna().unique().tolist()))
print("(=> zero Assistant / Assistant Professor labels exist in seniority.o for Psychology;")
print("   any 'junior' reading on seniority.o is 0, or 1/35 / 5/97 if Researcher is included)")
print()
print("rpp ids all unique; no missing values in project/replicated/seniority.*/discipline for rpp.")
print("=> Denominator counts (35 and 97) are exact; no imputation used.")
