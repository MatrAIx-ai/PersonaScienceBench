"""
DiscoveryBench — meta_regression_raw / metadata_14
Question: In which domain did both original and replication studies primarily use student
subjects (original: 82.4%, replication: 80.9%)?

Workflow (approved plan):
  1) Load study_data file.
  2) Deduplicate to the 141 unique-id study-level rows (rows where lab_id is missing =
     exactly one row per original-study id; subjects.r at study level == per-lab mode in
     all 141 ids).
  3) Per discipline, compute the % of original studies (subjects.o=='students') and the
     % of replication studies (subjects.r=='students').
  4) Row-level (927 lab-replication rows) robustness cross-check.
  5) Compare each discipline's (orig%, repl%) pair to the stated (82.4%, 80.9%).
  6) 'Primarily' = majority (>50%) on BOTH sides; figures disambiguate.
The replication_success file has no subject/discipline columns and is not used here.
"""
import pandas as pd

OUT = {}

# ---------- 1. Load ----------
df = pd.read_csv('data/meta-regression_study_data_heterogeneity_in_replication_projects.csv')
OUT['raw_rows'] = len(df)
OUT['unique_ids'] = df['id'].nunique()

# ---------- 2. Deduplicate to study level (unique id) ----------
study_level = df[df['lab_id'].isna()].copy()
assert study_level['id'].nunique() == len(study_level) == 141, "dedup unit check failed"
OUT['study_level_rows'] = len(study_level)
OUT['discipline_counts_study'] = study_level['discipline'].value_counts().to_dict()

def pct_students(s):
    """% of non-missing values equal to 'students'."""
    n = s.notna().sum()
    c = (s == 'students').sum()
    return c, n, (c / n * 100 if n else float('nan'))

# ---------- 3. Study-level proportions per discipline ----------
rows = []
for d in ['Social', 'Cognitive', 'Economics']:
    sub = study_level[study_level['discipline'] == d]
    co, no, po = pct_students(sub['subjects.o'])
    cr, nr, pr = pct_students(sub['subjects.r'])
    both = ((sub['subjects.o'] == 'students') & (sub['subjects.r'] == 'students')).sum()
    rows.append({
        'discipline': d, 'n_studies': len(sub),
        'orig_students': f"{co}/{no}", 'orig_pct': round(po, 2),
        'repl_students': f"{cr}/{nr}", 'repl_pct': round(pr, 2),
        'both_students': f"{both}/{len(sub)}", 'both_pct': round(both / len(sub) * 100, 2),
        'orig_primarily': po > 50, 'repl_primarily': pr > 50,
    })
tbl = pd.DataFrame(rows)
print("STUDY-LEVEL (141 unique original-study/replication pairs) PER DISCIPLINE")
print(tbl.to_string(index=False))
OUT['study_level_table'] = tbl
OUT['target'] = {'orig': 82.4, 'repl': 80.9}
tbl['|orig_pct-target|'] = (tbl['orig_pct'] - 82.4).abs()
tbl['|repl_pct-target|'] = (tbl['repl_pct'] - 80.9).abs()
tbl['mean_abs_dev'] = (tbl['|orig_pct-target|'] + tbl['|repl_pct-target|'])/2
print("\nDistance of each discipline's (orig%, repl%) to target (82.4%, 80.9%):")
print(tbl[['discipline','orig_pct','repl_pct','mean_abs_dev']].to_string(index=False))
OUT['deviations'] = tbl[['discipline','orig_pct','repl_pct','mean_abs_dev']]

# ---------- 4. Row-level cross-check (927 O/R-lab rows) ----------
print("\nROW-LEVEL (927 O/R-lab rows) CROSS-CHECK")
rrows = []
for d in ['Social', 'Cognitive', 'Economics']:
    sub = df[df['discipline'] == d]
    co, no, po = pct_students(sub['subjects.o'])
    cr, nr, pr = pct_students(sub['subjects.r'])
    rrows.append({'discipline': d, 'n_rows': len(sub),
                  'orig_pct': round(po,2), 'repl_pct': round(pr,2)})
rtbl = pd.DataFrame(rrows)
print(rtbl.to_string(index=False))
OUT['row_level_table'] = rtbl

# ---------- 5. Sensitivity: include the single NaN study as non-student ----------
print("\nSENSITIVITY (study-level, NaN study counted as non-student)")
srows = []
for d in ['Social', 'Cognitive', 'Economics']:
    sub = study_level[study_level['discipline'] == d]
    po = (sub['subjects.o'] == 'students').mean() * 100
    pr = (sub['subjects.r'] == 'students').mean() * 100
    srows.append({'discipline': d, 'n_excl_NAs': len(sub), 'orig_pct_NAasNonStudent': round(po,2), 'repl_pct_NAasNonStudent': round(pr,2)})
print(pd.DataFrame(srows).to_string(index=False))
OUT['sensitivity_table'] = pd.DataFrame(srows)

# ---------- 6. Verdict ----------
best = tbl.sort_values('mean_abs_dev').iloc[0]
OUT['best_match'] = best['discipline']
both_primarily = tbl[(tbl['orig_primarily']) & (tbl['repl_primarily'])]['discipline'].tolist()
OUT['domains_both_primarily'] = both_primarily
print(f"\nDomains where BOTH original & replication are majority-student: {both_primarily}")
print(f"Domain with (orig%, repl%) closest to (82.4%, 80.9%): {best['discipline']} "
      f"(mean abs deviation = {best['mean_abs_dev']:.2f} pp; orig {best['orig_pct']}%, repl {best['repl_pct']}%)")

import json
with open('analysis_output.json', 'w') as f:
    json.dump({k: (v.to_dict('records') if isinstance(v, pd.DataFrame) else v)
               for k, v in OUT.items() if k not in ('study_level_table','row_level_table','sensitivity_table')}
              | {'study_level_table': OUT['study_level_table'].to_dict('records'),
                 'row_level_table': OUT['row_level_table'].to_dict('records'),
                 'sensitivity_table': OUT['sensitivity_table'].to_dict('records')}, f, indent=2, default=str)
print("\nWrote analysis_output.json")
