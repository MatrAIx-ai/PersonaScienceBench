"""
Question: What proportion of original studies in Experimental Economics were
conducted in the United Kingdom?

Data: meta-regression_study_data_heterogeneity_in_replication_projects.csv
(study-level; original/replication columns suffixed o/r).
"""
import pandas as pd

# 1. Read the study-level file
df = pd.read_csv('data/meta-regression_study_data_heterogeneity_in_replication_projects.csv')
print("Total rows x cols:", df.shape)

# 2. Confirm Experimental Economics identification: project=='ee' <-> discipline=='Economics'
ee_by_project = df[df['project'] == 'ee']
ee_by_discipline = df[df['discipline'] == 'Economics']
print("Rows with project=='ee':", len(ee_by_project))
print("Rows with discipline=='Economics':", len(ee_by_discipline))
print("Sets identical (by id):", set(ee_by_project['id']) == set(ee_by_discipline['id']))
print("Project labels present:", sorted(df['project'].unique().tolist()))

# 3. Filter to EE (via project flag == 'ee') and deduplicate to original-study level by id
ee = ee_by_project.drop_duplicates(subset='id')
print("Unique original EE studies (denominator):", ee['id'].nunique())

# 4. Denominator and numerator
denom = ee['id'].nunique()
# Country coding check: any UK-style variants?
uk_like = df['experiment_country.o'].astype(str).str.contains(
    'united kingdom|\\buk\\b|england|scotland|britain|wales', case=False, na=False)
print("All UK-style codings in file:", sorted(df.loc[uk_like, 'experiment_country.o'].unique().tolist()))
print("Missing experiment_country.o among EE rows:", int(ee['experiment_country.o'].isna().sum()))

numerator = ee.loc[ee['experiment_country.o'] == 'United Kingdom', 'id'].nunique()
print("EE original studies conducted in the United Kingdom (numerator):", numerator)

prop = numerator / denom
print(f"PROPORTION = {numerator}/{denom} = {prop:.6f} = {100*prop:.2f}%")

# Detail listing for the answer
print("\nAll EE original studies by country:")
print(ee.groupby('experiment_country.o').size().to_string())
print("\nUK study detail:")
print(ee.loc[ee['experiment_country.o'] == 'United Kingdom',
            ['id', 'title', 'authors.o', 'pub_year', 'journal']].to_string(index=False))
