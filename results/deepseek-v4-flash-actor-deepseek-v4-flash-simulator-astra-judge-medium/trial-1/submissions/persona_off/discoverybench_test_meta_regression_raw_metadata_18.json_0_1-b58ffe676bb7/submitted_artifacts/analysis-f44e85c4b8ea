import pandas as pd

pd.set_option('display.max_columns', None)
pd.set_option('display.width', 250)

# ------------------------------------------------------------------
# 1. Data: Experimental Economics studies from study_data CSV only
# ------------------------------------------------------------------
df = pd.read_csv('data/meta-regression_study_data_heterogeneity_in_replication_projects.csv')

# Definition: Experimental Economics studies == project == 'ee'
ee = df[df['project'] == 'ee'].copy()

# Equivalence check: project==ee <-> discipline==Economics (same 18 rows)
set_ee   = set(df[df['project'] == 'ee']['id'])
set_econ = set(df[df['discipline'] == 'Economics']['id'])
equiv = (set_ee == set_econ) and (len(set_ee) == 18)
print(f"project=='ee' ids == discipline=='Economics' ids (18): {equiv}")
print(f"EE rows missing online.o/online.r: {ee['online.o'].isna().sum()} / {ee['online.r'].isna().sum()}")
print(f"Each ee id appears exactly once: {sorted(ee['id'].value_counts().unique()) == [1]}")
print()

# ------------------------------------------------------------------
# 2. Operationalization: "lab setting" == online flag == 0 (in-person)
# ------------------------------------------------------------------
N = len(ee)
lab_o  = int((ee['online.o'] == 0).sum())   # original conducted lab/in-person
lab_r  = int((ee['online.r'] == 0).sum())   # replication conducted lab/in-person
lab_pair = int(((ee['online.o'] == 0) & (ee['online.r'] == 0)).sum())  # both sides lab

# Combined "all-rows" figure: every original row + every replication row
lab_all_rows = lab_o + lab_r
n_all_rows   = 2 * N

prop_o  = lab_o / N
prop_r  = lab_r / N
prop_pair = lab_pair / N
prop_all = lab_all_rows / n_all_rows

print("=" * 60)
print("RESULTS — Experimental Economics (project=='ee', N =", N, ")")
print("=" * 60)
print(f"1) ORIGINAL side  (online.o == 0):   {lab_o}/{N} = {prop_o:.4f}  ({prop_o*100:.1f}%)")
print(f"2) REPLICATION side(online.r == 0):   {lab_r}/{N} = {prop_r:.4f}  ({prop_r*100:.1f}%)")
print(f"3) PAIR-BOTH-lab (o==0 AND r==0):     {lab_pair}/{N} = {prop_pair:.4f}  ({prop_pair*100:.1f}%)")
print(f"4) ALL-ROWS (o+r combined):           {lab_all_rows}/{n_all_rows} = {prop_all:.4f}  ({prop_all*100:.1f}%)")
print()

# ------------------------------------------------------------------
# 3. Context / validation: not used as venue indicator
# ------------------------------------------------------------------
print("Context (NOT used as the lab indicator):")
print("EE subjects.o:", dict(ee['subjects.o'].value_counts()))
print("EE subjects.r:", dict(ee['subjects.r'].value_counts()))
print("EE experiment_country.o / .r unique:", ee['experiment_country.o'].nunique(), "/", ee['experiment_country.r'].nunique())
print("EE us_lab.o / us_lab.r nonzero:", int(ee['us_lab.o'].sum()), "/", int(ee['us_lab.r'].sum()),
      "  (US-location flag; not a lab-vs-online indicator)")
print()

# ------------------------------------------------------------------
# 4. Per-study table
# ------------------------------------------------------------------
out = ee[['id','discipline','project','online.o','online.r','subjects.o','subjects.r',
          'experiment_country.o','experiment_country.r']].copy()
out['lab_original'] = (out['online.o'] == 0)
out['lab_replication'] = (out['online.r'] == 0)
print(out.to_string(index=False))

# ------------------------------------------------------------------
# 5. Save concise summary to file for the record
# ------------------------------------------------------------------
summary = pd.DataFrame({
    'population': ['original side (online.o==0)', 'replication side (online.r==0)',
                   'pair both lab (o==0 & r==0)', 'all rows combined (o+r)'],
    'lab_count': [lab_o, lab_r, lab_pair, lab_all_rows],
    'total': [N, N, N, n_all_rows],
    'proportion': [round(prop_o,4), round(prop_r,4), round(prop_pair,4), round(prop_all,4)]
})
summary.to_csv('analysis/ee_lab_setting_summary.csv', index=False)
print("\nSaved: analysis/ee_lab_setting_summary.csv")
print(summary.to_string(index=False))
