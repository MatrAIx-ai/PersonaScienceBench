"""
Average length of original papers in Experimental Economics and in Psychology.

Data: meta-regression_study_data_heterogeneity_in_replication_projects.csv (primary)
      meta-regression_replication_success_data_heterogeneity_in_replication_projects.csv (cross-check only, no length)

Group definitions (confirmed with researcher):
  - Experimental Economics = project == 'ee'   (EERP; validated 1:1 with discipline == 'Economics')
  - Psychology              = project == 'rpp'  (OSC Reproducibility Project: Psychology)
Unit of analysis: each original paper once (id is unique within ee/rpp).
Average: arithmetic mean of integer page count (length).
"""
import pandas as pd

pd.set_option('display.width', 140)
pd.set_option('display.max_columns', None)

STUDY = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
SUCCESS = "data/meta-regression_replication_success_data_heterogeneity_in_replication_projects.csv"

df = pd.read_csv(STUDY)
df2 = pd.read_csv(SUCCESS)

print("=" * 70)
print("STEP 0 — Data overview")
print("=" * 70)
print("Primary file (study data):", df.shape)
print("Second file (replication success):", df2.shape)
print("Second file has 'length'?", 'length' in df2.columns, "| has 'discipline'?", 'discipline' in df2.columns)
print("Second file project counts:\n", df2['project'].value_counts(dropna=False).to_dict())

print("\n" + "=" * 70)
print("STEP 1 — Group definition & cross-validation")
print("=" * 70)
print("Primary file project counts:\n", df['project'].value_counts(dropna=False).to_dict())
print("Primary file discipline counts:\n", df['discipline'].value_counts(dropna=False).to_dict())
print("\nCrosstab project x discipline:\n", pd.crosstab(df['project'], df['discipline'], dropna=False))

ee_proj = df[df['project'] == 'ee']
eco_disc = df[df['discipline'] == 'Economics']
print("\nproject=='ee' rows:", len(ee_proj), "| discipline=='Economics' rows:", len(eco_disc))
print("Sets identical?", set(ee_proj['id']) == set(eco_disc['id']))
print("rpp discipline composition:", df.loc[df['project'] == 'rpp', 'discipline'].value_counts().to_dict())

# Cross-check: ee (18) matches second-file 'Experimental Economics' (18)
n2_ee = (df2['project'] == 'Experimental Economics').sum()
n2_psy = (df2['project'] == 'Psychology').sum()
print(f"\nCross-check vs second file: Experimental Economics={n2_ee}, Psychology={n2_psy} "
      f"(Psychology differs: primary rpp n=97 vs second-file meta-regression subset n=73; "
      f"second file has no length column, so it cannot supply page counts).")

print("\n" + "=" * 70)
print("STEP 2 — Data quality: missing / zero / duplicates in length")
print("=" * 70)
sub = df[df['project'].isin(['ee', 'rpp'])].copy()
print("Target rows (ee+rpp):", len(sub))
print("Missing 'length':", sub['length'].isna().sum(), "| Zero 'length':", (sub['length'] == 0).sum())
print("Missing 'project':", sub['project'].isna().sum())
for proj in ['ee', 'rpp']:
    g = sub[sub['project'] == proj]
    print(f"{proj}: rows={len(g)}, unique ids={g['id'].nunique()}, unique titles={g['title'].nunique()}")

print("\n" + "=" * 70)
print("STEP 3 — Average length per group (primary computation)")
print("=" * 70)
stats = sub.groupby('project')['length'].agg(
    count='count', mean='mean', median='median', std='std', min='min', max='max')
print(stats.round(3).to_string())

print("\n" + "=" * 70)
print("STEP 4 — Sensitivity checks (dedup by id / by title)")
print("=" * 70)
for label, d in [
    ("all rows", sub),
    ("dedup by id", sub.drop_duplicates('id')),
    ("dedup by title", sub.drop_duplicates('title')),
]:
    m = d.groupby('project')['length'].agg(count='count', mean='mean')
    print(f"[{label}]")
    print(m.round(3).to_string())

print("\n" + "=" * 70)
print("STEP 5 — Supporting context (full length distribution by project)")
print("=" * 70)
print(df.groupby('project')['length'].agg(count='count', mean='mean', median='median',
                                          std='std', min='min', max='max').round(3).to_string())

# Final answers
ee_mean = sub.loc[sub['project'] == 'ee', 'length'].mean()
rpp_mean = sub.loc[sub['project'] == 'rpp', 'length'].mean()
print("\n" + "=" * 70)
print("FINAL")
print("=" * 70)
print(f"Average length of original papers in Experimental Economics: {ee_mean:.4f} pages (N={int((sub['project']=='ee').sum())})")
print(f"Average length of original papers in Psychology (RPP):        {rpp_mean:.4f} pages (N={int((sub['project']=='rpp').sum())})")
print(f"Approximate: Experimental Economics ~ {ee_mean:.1f} pages, Psychology ~ {rpp_mean:.1f} pages")
