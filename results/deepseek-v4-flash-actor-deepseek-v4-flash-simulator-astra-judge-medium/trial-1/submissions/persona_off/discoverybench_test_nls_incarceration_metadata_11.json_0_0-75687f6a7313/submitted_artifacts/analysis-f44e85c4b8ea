"""
DiscoveryBench task: "What kind of demographic disparities exist in median wealth
in 1985 among individuals who were ever incarcerated?"

Main analysis (approved plan):
- Operational definition of "ever incarcerated": ever_jailed == 1 (jailed 1985-1994).
- Primary view: as-supplied data (no deduplication); deduplicated medians reported
  as a labeled sensitivity.
- Median computed over ALL observed composite_wealth_1985 values (zeros and
  negatives included); positive-only median and zero-wealth share as sensitivity.
- Disaggregation by race, sex, race x sex; female jailed cells (n<=16) labeled
  indicative, not precise. Ever-jailed vs never-jailed reference within group.
- Framed as an association (1985 wealth of a cohort ever jailed 1985-1994),
  NOT causal.

Author: research agent. Data: data/nls_incarceration_processed.csv
"""
import pandas as pd
import numpy as np
import json

pd.set_option("display.width", 220)
pd.set_option("display.max_columns", 20)

DATA = "data/nls_incarceration_processed.csv"
W = "composite_wealth_1985"

df = pd.read_csv(DATA)
df["race"] = df["race"].replace({"hipanic": "hispanic"})  # fix documented typo

OUTPUTS = {}

def group_stats(sub, groups):
    out = sub.groupby(groups)[W].agg(
        n="size",
        median="median",
        mean="mean",
        min="min",
        max="max",
    )
    out["n_zero"] = sub.groupby(groups)[W].apply(lambda s: int((s == 0).sum()))
    out["n_neg"] = sub.groupby(groups)[W].apply(lambda s: int((s < 0).sum()))
    out["pos_median"] = sub.groupby(groups)[W].apply(
        lambda s: s[s > 0].median() if (s > 0).any() else np.nan)
    out["zero_share"] = out["n_zero"] / out["n"]
    return out.round(2)

ej = df[df["ever_jailed"] == 1]
nj = df[df["ever_jailed"] == 0]

print("=" * 100)
print("PRIMARY (as-supplied data; all observed wealth, zeros & negatives included)")
print("=" * 100)

for by in [["race"], ["sex"], ["race", "sex"]]:
    label = " x ".join(by)
    res = group_stats(ej, by)
    print(f"\n--- EVER JAILED  (n=289 total)  median wealth 1985 by {label} ---")
    print(res)
    OUTPUTS[f"ever_jailed_by_{label.replace(' ','_')}_as_supplied"] = res.to_dict("index")

print("\n--- NEVER JAILED reference, median wealth 1985 (as-supplied) ---")
for by in [["race"], ["sex"], ["race", "sex"]]:
    label = " x ".join(by)
    res = group_stats(nj, by)
    print(f"[never jailed by {label}]")
    print(res)

print("\n" + "=" * 100)
print("SENSITIVITY 1: DEDUPLICATED DATA (exact duplicates removed), median over all values")
print("=" * 100)
df_d = df.drop_duplicates()
ej_d = df_d[df_d["ever_jailed"] == 1]
print(f"rows after dedup: {len(df_d)} (from {len(df)}); ever-jailed after dedup: {len(ej_d)} (from {len(ej)})")
for by in [["race"], ["sex"]]:
    label = " x ".join(by)
    print(f"\n--- EVER JAILED (deduped) by {label} ---")
    print(group_stats(ej_d, by))
OUTPUTS["ever_jailed_by_race_deduped"] = group_stats(ej_d, ["race"]).to_dict("index")

print("\n" + "=" * 100)
print("SENSITIVITY 2: POSITIVE-ONLY MEDIAN + ZERO/ NEGATIVE SHARE (as-supplied)")
print("=" * 100)
print("Among EVER JAILED (n=289): n_zero=%d  n_neg=%d  n_pos=%d ; positive-only median = %.2f"
      % ((ej[W] == 0).sum(), (ej[W] < 0).sum(), (ej[W] > 0).sum(), ej.loc[ej[W] > 0, W].median()))

# --- key comparison table for framing the hypothesis ---
print("\n" + "=" * 100)
print("EVER-JAILED vs NEVER-JAILED median, by race and by sex (as-supplied)")
print("=" * 100)
comp = pd.DataFrame({
    "ever_jailed": ej.groupby(["race", "sex"])[W].median(),
    "ever_jailed_n": ej.groupby(["race", "sex"]).size(),
    "never_jailed": nj.groupby(["race", "sex"])[W].median(),
    "never_jailed_n": nj.groupby(["race", "sex"]).size(),
}).round(2)
comp["gap_ever_vs_never"] = (comp["never_jailed"] - comp["ever_jailed"]).round(2)
print(comp)

OUTPUTS["ever_vs_never_by_racesex"] = comp.to_dict("index")

# --- summary JSON persisted ---
def str_keys(d):
    return {str(k): (str_keys(v) if isinstance(v, dict) else v) for k, v in d.items()}

with open("analysis_outputs.json", "w") as f:
    json.dump(str_keys(OUTPUTS), f, indent=2, default=str)
print("\nSaved analysis_outputs.json")
