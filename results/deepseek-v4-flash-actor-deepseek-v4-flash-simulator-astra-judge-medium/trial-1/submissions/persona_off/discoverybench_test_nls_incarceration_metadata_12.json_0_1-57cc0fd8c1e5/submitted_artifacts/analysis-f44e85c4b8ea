"""Final analysis: incarceration and wealth of black individuals by baseline wealth tier.
DiscoveryBench nls_incarceration task. Run: python3 analysis/final_analysis.py
"""
import numpy as np
import pandas as pd
import statsmodels.api as sm

df = pd.read_csv('data/nls_incarceration_processed.csv')
bk = df[df['race'] == 'black'].copy().reset_index(drop=True)
bk['delta'] = bk['composite_wealth_1996'] - bk['composite_wealth_1985']
bk['rank96'] = bk['composite_wealth_1996'].rank(pct=True) * 100
bk['rank90'] = bk['composite_wealth_1990'].rank(pct=True) * 100
print('Black respondents:', len(bk))

def tier_stats(tiercol, label):
    print('\n' + '=' * 80)
    print('TIER DEFINITION:', label)
    print(pd.crosstab(bk[tiercol], bk['ever_jailed']))
    st = bk.groupby([tiercol, 'ever_jailed']).agg(
        n=('composite_wealth_1996', 'size'),
        med96=('composite_wealth_1996', 'median'),
        mean96=('composite_wealth_1996', 'mean'),
        med_delta=('delta', 'median'),
        mean_delta=('delta', 'mean'),
        zero96=('composite_wealth_1996', lambda s: (s == 0).mean()),
        med_rank96=('rank96', 'median')).round(1)
    print(st)
    gaps = {}
    for t in st.index.get_level_values(0).unique():
        if (t, 0) in st.index and (t, 1) in st.index:
            j0, j1 = st.loc[(t, 0)], st.loc[(t, 1)]
            gaps[t] = dict(
                n0=int(j0['n']), n1=int(j1['n']),
                med96_not=j0['med96'], med96_jailed=j1['med96'],
                med96_gap=round(j0['med96'] - j1['med96'], 0),
                mean_delta_not=j0['mean_delta'], mean_delta_jailed=j1['mean_delta'],
                mean_delta_gap=round(j0['mean_delta'] - j1['mean_delta'], 0),
                zero96_not=j0['zero96'], zero96_jailed=j1['zero96'],
                zero_rate_gap=round(j0['zero96'] - j1['zero96'], 2),
                rank_gap=round(j0['med_rank96'] - j1['med_rank96'], 1))
    g = pd.DataFrame(gaps).T
    print('\nWithin-tier gaps (never-jailed MINUS jailed):')
    print(g.round(2))
    return st, g

# ---------------- PRIMARY: black-specific tertiles ----------------
r = bk['composite_wealth_1985'].rank(method='first')
bk['t3'] = pd.cut(r, 3, labels=['low85', 'mid85', 'high85'])
st_tert, gaps_tert = tier_stats('t3', 'PRIMARY: black-specific 1985-wealth TERTILES (rank-based)')

# ---------------- REGRESSION with tier DUMMIES (low = reference) x jail ----------------
bk['j_jail'] = bk['ever_jailed']
bk['d_mid'] = (bk['t3'] == 'mid85').astype(int)
bk['d_high'] = (bk['t3'] == 'high85').astype(int)
X = pd.DataFrame({
    'const': 1.0,
    'jail': bk['j_jail'],
    'mid': bk['d_mid'],
    'high': bk['d_high'],
    'jail_mid': bk['j_jail'] * bk['d_mid'],
    'jail_high': bk['j_jail'] * bk['d_high']})

print('\n' + '=' * 80)
print('MEDIAN REGRESSION (q=0.5) with tier dummies x jail; reference = low tier, never jailed')
for out, y in [('rank96', bk['rank96']), ('delta85_96', bk['delta']), ('wealth1996', bk['composite_wealth_1996'])]:
    qr = sm.QuantReg(y, X).fit(q=0.5)
    print(f'\n-- outcome: {out}')
    print(qr.summary().tables[1])
    print('coefs:', {k: round(v, 2) for k, v in qr.params.items()})
    print('pvals:', {k: round(p, 4) for k, p in qr.pvalues.items()})

print('\n' + '=' * 80)
print('OLS on within-black 1996 percentile rank (rank96):')
ols = sm.OLS(bk['rank96'], X).fit()
print(ols.summary().tables[1])
print('coefs:', {k: round(v, 3) for k, v in ols.params.items()})
print('pvals:', {k: round(p, 4) for k, p in ols.pvalues.items()})

# ---------------- Trajectories ----------------
traj = bk.groupby(['t3', 'ever_jailed'])[['composite_wealth_1985', 'composite_wealth_1990', 'composite_wealth_1996']].median()
traj.columns = [1985, 1990, 1996]
traj.round(1).to_csv('analysis/trajectories_black.csv')
print('\nTrajectories (median composite wealth) -> analysis/trajectories_black.csv')
print(traj.round(0))
# also 1990 zero-rate trajectory
traj_zero = bk.groupby(['t3', 'ever_jailed'])[['composite_wealth_1985', 'composite_wealth_1990', 'composite_wealth_1996']].apply(lambda s: (s == 0).mean())
traj_zero.columns = [1985, 1990, 1996]
print('\nZero-share trajectory:')
print(traj_zero.round(2))
print('ASCII median trajectory:')
print(f"{'group':24s}" + ''.join(f'{y:>9d}' for y in [1985, 1990, 1996]))
for (t, j), row in traj.iterrows():
    jl = 'jailed' if j else 'not'
    grp = t + ' / ' + jl
    print(f"{grp:24s}" + ''.join(f'{v:>9.0f}' for v in [row.iloc[0], row.iloc[1], row.iloc[2]]))

# ---------------- ROBUSTNESS 1: black-specific quartiles ----------------
bk['q4'] = pd.qcut(bk['composite_wealth_1985'].rank(method='first'), 4, labels=['q1', 'q2', 'q3', 'q4'])
tier_stats('q4', 'ROBUST-1: black-specific QUARTILES')

# ---------------- ROBUSTNESS 2: all-sample quintiles ----------------
all_r = df['composite_wealth_1985'].rank(method='first')
cuts = [all_r.quantile(q) for q in [0.2, 0.4, 0.6, 0.8]]
def quint5(v):
    for i, c in enumerate(cuts):
        if v <= c:
            return f'as-q{i+1}'
    return 'as-q5'
bk_r = bk['composite_wealth_1985'].rank(method='first')
bk['q_all'] = bk_r.map(quint5)
print('\nAll-sample 1985-rank quintile cuts (ranks):', [round(c) for c in cuts])
tier_stats('q_all', 'ROBUST-2: ALL-SAMPLE quintiles (black distribution across them)')
print('Distribution of blacks across all-sample quintiles:')
print(bk['q_all'].value_counts().sort_index())

# ---------------- ROBUSTNESS 3: 1996 zero sensitivity ----------------
print('\n' + '=' * 80)
print('ROBUST-3: sensitivity to the 1996 zero share')
print(f'1996 zero share: all={ (df["composite_wealth_1996"]==0).mean():.3f}, black={ (bk["composite_wealth_1996"]==0).mean():.3f}')
print(f'1990 zero share: all={ (df["composite_wealth_1990"]==0).mean():.3f}, black={ (bk["composite_wealth_1990"]==0).mean():.3f}')
print(f'1985 zero share: all={ (df["composite_wealth_1985"]==0).mean():.3f}, black={ (bk["composite_wealth_1985"]==0).mean():.3f}')
m_all = bk.groupby('ever_jailed')['composite_wealth_1996'].median()
m_nz = bk[bk['composite_wealth_1996'] > 0].groupby('ever_jailed')['composite_wealth_1996'].median()
m90 = bk.groupby('ever_jailed')['composite_wealth_1990'].median()
print('median 1996 wealth, all rows (not/jailed):', m_all.to_dict())
print('median 1996 wealth, excluding 1996==0 (not/jailed):', m_nz.round(0).to_dict())
print('median 1990 wealth, all rows (not/jailed):', m90.to_dict())

# pooled marginal
pool = pd.DataFrame({'med96': bk.groupby('ever_jailed')['composite_wealth_1996'].median(),
                     'mean96': bk.groupby('ever_jailed')['composite_wealth_1996'].mean(),
                     'mean_delta': bk.groupby('ever_jailed')['delta'].mean(),
                     'zero96': bk.groupby('ever_jailed')['composite_wealth_1996'].apply(lambda s: (s == 0).mean()),
                     'med_rank96': bk.groupby('ever_jailed')['rank96'].median()})
print('\nPOOLED black marginal (jailed vs not):')
print(pool.round(2))
print('\nDONE')
