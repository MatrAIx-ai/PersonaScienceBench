"""Final synthesis: largest increase in median wealth among black females (1985 vs 1990 vs 1996)."""
import pandas as pd
import numpy as np

df = pd.read_csv('data/nls_incarceration_processed.csv')
weath = ['composite_wealth_1985', 'composite_wealth_1990', 'composite_wealth_1996']
years = {'composite_wealth_1985': 1985, 'composite_wealth_1990': 1990,
         'composite_wealth_1996': 1996}

bf = df[(df['race'] == 'black') & (df['sex'] == 'female')]
print("Black females analyzed (n):", len(bf))

med = bf[weath].median()
print("\nFull-population median composite wealth per wave:")
for c in weath:
    print(f"  {years[c]}: ${med[c]:,.0f}")

pair = [('composite_wealth_1985', 'composite_wealth_1990'),
        ('composite_wealth_1990', 'composite_wealth_1996')]
print("\nAbsolute and relative consecutive-wave changes (full-population median):")
for a, b in pair:
    chg = med[b] - med[a]
    rel = chg / med[a] * 100
    print(f"  {years[a]}->{years[b]}: +${chg:,.0f}  (+{rel:,.0f}% relative to {years[a]} median; "
          f"multiple = {med[b]/med[a]:,.1f}x)")

# Bootstrap 95% CI on absolute median changes
rng = np.random.default_rng(7)
def boot(a, b, n=5000):
    a = np.asarray(a); b = np.asarray(b)
    obs = np.median(b) - np.median(a)
    ds = [np.median(b[rng.integers(0, len(b), len(b))]) -
          np.median(a[rng.integers(0, len(a), len(a))]) for _ in range(n)]
    return obs, np.percentile(ds, 2.5), np.percentile(ds, 97.5)

print("\nBootstrap 95% CI on absolute median change:")
for a, b in pair:
    o, lo, hi = boot(bf[a], bf[b])
    print(f"  {years[a]}->{years[b]}: ${o:,.0f} [CI ${lo:,.0f}, ${hi:,.0f}]")

# Caveat: definition sensitivity — positive-wealth-only subset
m_pos = bf[weath].apply(lambda s: s[s > 0].median())
print("\nCaveat check — positive-wealth-only medians:")
for c in weath:
    print(f"  {years[c]}: ${m_pos[c]:,.0f}")
p_85_90 = m_pos['composite_wealth_1990'] - m_pos['composite_wealth_1985']
p_90_96 = m_pos['composite_wealth_1996'] - m_pos['composite_wealth_1990']
print(f"  change 85->90: +${p_85_90:,.0f}; change 90->96: +${p_90_96:,.0f}"
      f"  -> ordering reversed ({'90->96 larger' if p_90_96 > p_85_90 else '85->90 larger'})")

# Primary conclusion
chg1 = med['composite_wealth_1990'] - med['composite_wealth_1985']
chg2 = med['composite_wealth_1996'] - med['composite_wealth_1990']
winner = "1985 to 1990" if chg1 > chg2 else "1990 to 1996"
print(f"\nPRIMARY RESULT: largest increase in black-female median wealth occurred between {winner}.")
