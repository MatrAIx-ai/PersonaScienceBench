import pandas as pd
import numpy as np

pd.set_option('display.width', 200)
pd.set_option('display.max_columns', 50)

df = pd.read_csv("data/nls_incarceration_processed.csv")
w = df[df['race'] == 'white'].copy()
years = ["composite_wealth_1990", "composite_wealth_1996"]

def gini(x):
    x = np.sort(np.asarray(x, dtype=float))
    n = len(x)
    if n == 0 or x.sum() == 0:
        return np.nan
    cum = np.cumsum(x)
    B = cum.sum() / (n * x.sum())
    return (1 + 1/n - 2*B)

def profile(v, label):
    v = np.asarray(v, dtype=float)
    n = len(v)
    q = np.nanpercentile(v, [25, 50, 75, 90, 99])
    total = v.sum()
    top10_share = np.nan
    if total > 0:
        s = np.sort(v)[::-1]
        top10_share = s[:max(1, int(np.ceil(n*0.10)))].sum() / total
    row = {
        "n": n,
        "mean": round(v.mean(), 1),
        "median": round(np.median(v), 1),
        "mean/median": round(v.mean()/np.median(v), 3) if np.median(v) != 0 else np.nan,
        "p25": round(q[0], 1), "p50": round(q[1], 1), "p75": round(q[2], 1),
        "p90": round(q[3], 1), "p99": round(q[4], 1),
        "p90/p50": round(q[3]/q[1], 3) if q[1] != 0 else np.nan,
        "top10_share": round(top10_share, 4) if not np.isnan(top10_share) else np.nan,
        "gini": round(gini(v), 4),
        "share_zero": round((v == 0).mean(), 4),
        "share_neg": round((v < 0).mean(), 4),
    }
    return row

groups = {"white_male": w[w.sex == "male"].copy(), "white_female": w[w.sex == "female"].copy()}

print("="*100)
print("TABLE A. Dispersion/concentration profile, FULL SAMPLE (zeros & negatives included)")
print("="*100)
rows = []
for g, sub in groups.items():
    for yr in years:
        r = profile(sub[yr], f"{g} {yr}")
        r["group"] = g; r["year"] = yr[-4:]
        rows.append(r)
tA = pd.DataFrame(rows).set_index(["group", "year"])
print(tA.to_string())

print("\n" + "="*100)
print("TABLE B. Non-positive-excluded variant (wealth > 0 only)")
print("="*100)
rows = []
for g, sub in groups.items():
    for yr in years:
        v = sub[yr][sub[yr] > 0]
        r = profile(v, f"{g} {yr} {len(v)}")
        r["group"] = g; r["year"] = yr[-4:]; r["n_pos"] = len(v)
        rows.append(r)
tB = pd.DataFrame(rows).set_index(["group", "year"])
print(tB.to_string())

print("\n" + "="*100)
print("TABLE C. Paired within-group change Delta = wealth_1996 - wealth_1990")
print("="*100)
rows = []
for g, sub in groups.items():
    d = sub["composite_wealth_1996"] - sub["composite_wealth_1990"]
    rows.append({
        "group": g, "n": len(d),
        "pct_increase": round((d > 0).mean()*100, 1),
        "pct_decrease": round((d < 0).mean()*100, 1),
        "pct_unchanged": round((d == 0).mean()*100, 1),
        "mean_delta": round(d.mean(), 1),
        "median_delta": round(d.median(), 1),
        "pct_zero_1996_new": round(((sub["composite_wealth_1990"] != 0) & (sub["composite_wealth_1996"] == 0)).mean()*100, 1),
    })
tC = pd.DataFrame(rows)
print(tC.to_string(index=False))

print("\n" + "="*100)
print("TABLE D. Male-female wealth gap by year (median, mean, ratio)")
print("="*100)
m, f = groups["white_male"], groups["white_female"]
for yr in years:
    mm, fm = m[yr].median(), f[yr].median()
    mmean, fmean = m[yr].mean(), f[yr].mean()
    print(f"{yr}: median gap male-female = {mm-fm:,.0f} (male {mm:,.0f} vs female {fm:,.0f}) | "
          f"female/male median ratio = {fm/mm:.3f} | mean gap male-female = {mmean-fmean:,.0f} "
          f"(male {mmean:,.0f} vs female {fmean:,.0f})")
dmed = m["composite_wealth_1996"].median() - f["composite_wealth_1996"].median() - (m["composite_wealth_1990"].median() - f["composite_wealth_1990"].median())
print(f"Change in median gap 1990->1996: {dmed:,.0f}")
dm = m["composite_wealth_1996"].mean() - f["composite_wealth_1996"].mean() - (m["composite_wealth_1990"].mean() - f["composite_wealth_1990"].mean())
print(f"Change in mean gap 1990->1996: {dm:,.0f}")

print("\n" + "="*100)
print("TABLE E. ever_jailed covariate/robustness sub-analysis (white only)")
print("="*100)
for g, sub in groups.items():
    for jv in [0, 1]:
        s = sub[sub.ever_jailed == jv]
        if len(s) == 0:
            continue
        print(f"{g} ever_jailed={jv} (n={len(s)}): "
              f"1990 med={s['composite_wealth_1990'].median():,.0f} mean={s['composite_wealth_1990'].mean():,.0f} | "
              f"1996 med={s['composite_wealth_1996'].median():,.0f} mean={s['composite_wealth_1996'].mean():,.0f}")

print("\n" + "="*100)
print("TABLE F. Optional extra context: 1985 wealth (white groups)")
print("="*100)
for g, sub in groups.items():
    print(f"{g} composite_wealth_1985: median={sub['composite_wealth_1985'].median():,.0f} mean={sub['composite_wealth_1985'].mean():,.0f} zeros={(sub['composite_wealth_1985']==0).sum()} neg={(sub['composite_wealth_1985']<0).sum()}")
