"""
Analysis: NLSY79 incarceration & wealth.
Question: In which years did individuals with a criminal record (ever_jailed==1)
          have significantly LOWER wealth than those without (ever_jailed==0)?

Pipeline
--------
(1) Primary: one-sided Mann-Whitney U (jailed < not-jailed) per wealth year
    1985 / 1990 / 1996; Benjamini-Hochberg FDR + Holm across the 3 year-tests.
(2) Effect sizes: Hodges-Lehmann location shift (median of pairwise diffs),
     median difference w/ bootstrap 95% CI, mean difference, Cliff's delta
     (rank-biserial magnitude).
(3) Robustness: two-part decomposition (share wealth<=0 via chi2/Fisher;
     log10 wealth among positives via Welch t), IHS covariate-adjusted OLS
     (race, sex) sensitivity, and dedup sensitivity (drop full-row duplicates).
(4) Reconcile raw vs corrected p-values and across approaches.

Caveats built in: correlational (non-causal) framing; 'hipanic' spelling in data;
nominal-dollar wealth (not inflation adjusted); ever_jailed window 1985-1994.
"""
import numpy as np
import pandas as pd
from scipy import stats

RNG = np.random.default_rng(42)

df = pd.read_csv('data/nls_incarceration_processed.csv')
years_w = ['composite_wealth_1985', 'composite_wealth_1990', 'composite_wealth_1996']
years = [c.replace('composite_wealth_', '') for c in years_w]

jailed = df['ever_jailed'] == 1
n1, n0 = int(jailed.sum()), int((~jailed).sum())
print(f"Groups: ever_jailed==1 n={n1}; ever_jailed==0 n={n0}\n")

# ---------------- helpers ----------------
def mw_one_sided(a, b, alternative='less'):
    """Mann-Whitney U, H1: a < b. Returns U, p (one-sided)."""
    res = stats.mannwhitneyu(a, b, alternative=alternative, method='auto')
    return res.statistic, res.pvalue

def cliffts_delta(x, y):
    """Cliff's delta = P(x>y) - P(x<y) with large-sample handling via rank method."""
    # vectorize with ranks to avoid n1*n2 memory blowup (n1=289, n0=11724 -> 3.4M, fine)
    # but we do it via signs on smaller sample for speed:
    n, m = len(x), len(y)
    if n <= m:
        big = y
        signs = np.array([np.sign(xi - big) for xi in x])   # n x m
    else:
        big = x
        signs = np.array([np.sign(yi - big) for yi in y]).T  # n x m
    return float((signs.sum()) / (n * m))

# ---------------- (1)+(2) primary tests ----------------
rows = []
for w, y in zip(years_w, years):
    a = df.loc[jailed, w].to_numpy()
    b = df.loc[~jailed, w].to_numpy()

    U, p = mw_one_sided(a, b)

    # Hodges-Lehmann location shift (median of pairwise b - a), i.e. how much
    # higher not-jailed is; positive = jailed lower.
    diffs = (b[:, None] - a[None, :]).ravel()          # 11724 x 289
    hl = float(np.median(diffs))

    # median difference & bootstrap 95% CI of median difference (b - a)
    md = float(np.median(b) - np.median(a))
    boot = (np.median(RNG.choice(b, size=(4000, n0), replace=True), axis=1)
            - np.median(RNG.choice(a, size=(4000, n1), replace=True), axis=1))
    ci_lo, ci_hi = np.percentile(boot, [2.5, 97.5])

    mean_diff = float(b.mean() - a.mean())
    delta = cliffts_delta(a, b)   # negative means jailed lower
    rb = float(1 - 2 * U / (n1 * n0))  # rank-biserial (positive = jailed lower)

    rows.append(dict(year=int(y), U=U, p_raw=p, hl_shift=hl, med_diff=md,
                     ci_lo=ci_lo, ci_hi=ci_hi, mean_diff=mean_diff,
                     cliffts_delta=delta, rank_biserial=rb))
    print(f"Year {y}: MWU one-sided p={p:.6g} | HL shift={hl:,.0f} | "
          f"median diff (not-jailed - jailed)={md:,.0f} [{ci_lo:,.0f},{ci_hi:,.0f}] | "
          f"mean diff={mean_diff:,.0f} | Cliff's d={delta:.3f} | r_rb={rb:.3f}")

res = pd.DataFrame(rows)

# BH-FDR and Holm corrections on one-sided p-values
p = res['p_raw'].to_numpy()
# BH
order = np.argsort(p)
psort = p[order]
m = len(p)
bh = psort * m / (np.arange(1, m + 1))
bh = np.minimum.accumulate(bh[::-1])[::-1]
res['p_bh'] = np.empty(m); res.loc[order, 'p_bh'] = np.clip(bh, 0, 1)
# Holm
holm = np.empty(m)
for i, idx in enumerate(order):
    holm[idx] = max((m - i) * p[idx], 0.0)
res['p_holm'] = np.minimum.accumulate(np.maximum.accumulate(holm[::-1]))[::-1] if False else np.array(holm)
# fix monotonicity of holm (sorted by raw p): adjusted = max over j>=i of (m-j+1)*p_(j)
for i in range(m):
    res.loc[order[i], 'p_holm'] = max((m - i) * p[order[i]], res.loc[order[max(i-1,0)],'p_holm'] if i>0 else 0)

sig_any = res['p_bh'] < 0.05
print("\nMultiple-comparison corrected (across 3 years):")
print(res[['year','p_raw','p_bh','p_holm']].round(6).to_string(index=False))
print(f"\nYears significant at alpha=0.05 after BH-FDR: {list(res.loc[res['p_bh']<0.05,'year'])}")
print(f"Years significant after Holm: {list(res.loc[res['p_holm']<0.05,'year'])}")

res.to_csv('artifacts/primary_tests.csv', index=False)

# descriptive table
desc_rows = []
for w, y in zip(years_w, years):
    for lab, msk in [('jailed', jailed), ('not_jailed', ~jailed)]:
        s = df.loc[msk, w]
        desc_rows.append(dict(year=y, group=lab, n=int(msk.sum()),
                              mean=s.mean().round(1), median=s.median(),
                              q25=s.quantile(.25), q75=s.quantile(.75),
                              pct_le0=((s <= 0).mean() * 100).round(2),
                              min=s.min(), max=s.max()))
desc = pd.DataFrame(desc_rows)
print("\nDescriptives:\n", desc.to_string(index=False))
desc.to_csv('artifacts/descriptives.csv', index=False)

# ---------------- Robustness 1: two-part ----------------
print("\n=== ROBUSTNESS 1: two-part decomposition ===")
tp_rows = []
for w, y in zip(years_w, years):
    a = df.loc[jailed, w].to_numpy(); b = df.loc[~jailed, w].to_numpy()
    # Part A: share with wealth <= 0
    ta = (a <= 0).sum(); tb = (b <= 0).sum()
    tbl = np.array([[ta, n1 - ta], [tb, n0 - tb]])
    chi2, p_chi, dof, _ = stats.chi2_contingency(tbl, correction=False)
    or_, p_fish = stats.fisher_exact(tbl)  # OR of '<=0' in jailed vs not; p two-sided
    # Part B: among positives, log10 wealth, one-sided Welch t (jailed lower)
    a_pos = np.log10(a[a > 0]); b_pos = np.log10(b[b > 0])
    t_stat, p_welch = stats.ttest_ind(a_pos, b_pos, alternative='less', equal_var=False)
    tp_rows.append(dict(year=int(y), pct_le0_j=(ta/n1*100).round(2), pct_le0_nj=(tb/n0*100).round(2),
                        chi2=chi2, p_chi_le0=p_chi, p_fisher_le0=p_fish,
                        n_log_j=len(a_pos), n_log_nj=len(b_pos),
                        mean_log10_j=a_pos.mean().round(3), mean_log10_nj=b_pos.mean().round(3),
                        t_welch=t_stat, p_welch_log10=p_welch))
tp = pd.DataFrame(tp_rows)
print(tp.round(5).to_string(index=False))
tp.to_csv('artifacts/robustness_twopart.csv', index=False)

# ---------------- Robustness 2: IHS covariate-adjusted OLS ----------------
print("\n=== ROBUSTNESS 2: IHS covariate-adjusted OLS (race, sex) ===")
import statsmodels.api as sm
ihs_rows = []
X_base = pd.get_dummies(df[['race', 'sex']], drop_first=True, dtype=float)
for w, y in zip(years_w, years):
    y_ihs = np.arcsinh(df[w].to_numpy() / 1000.0)
    X = X_base.copy(); X['ever_jailed'] = df['ever_jailed'].astype(float)
    X = sm.add_constant(X)
    mod = sm.OLS(y_ihs, X).fit()
    coef = mod.params['ever_jailed']; se = mod.bse['ever_jailed']
    p_two = mod.pvalues['ever_jailed']
    p_one = p_two / 2 if coef < 0 else 1 - p_two / 2
    ihs_rows.append(dict(year=int(y), coef_everjailed=coef, se=se,
                         p_two_sided=p_two, p_one_sided_lower=p_one,
                         n=mod.nobs, r2=mod.rsquared))
ihs = pd.DataFrame(ihs_rows)
print(ihs.round(5).to_string(index=False))
ihs.to_csv('artifacts/robustness_ihs_ols.csv', index=False)

# ---------------- Robustness 3: dedup sensitivity ----------------
print("\n=== ROBUSTNESS 3: dedup sensitivity (drop full-row duplicates) ===")
dedup = df.drop_duplicates().copy()
print(f"Rows before dedup: {len(df)} -> after: {len(dedup)} "
      f"(jailed n={int((dedup.ever_jailed==1).sum())})")
d_rows = []
for w, y in zip(years_w, years):
    a = dedup.loc[dedup.ever_jailed == 1, w].to_numpy()
    b = dedup.loc[dedup.ever_jailed == 0, w].to_numpy()
    U, p = mw_one_sided(a, b)
    d_rows.append(dict(year=int(y), U=U, p_raw=p))
dres = pd.DataFrame(d_rows)
# BH on dedup
p = dres['p_raw'].to_numpy(); order = np.argsort(p); ps = p[order]; m = len(p)
bh = np.minimum.accumulate((ps * m / np.arange(1, m + 1))[::-1])[::-1]
dres['p_bh'] = np.empty(m); dres.loc[order, 'p_bh'] = np.clip(bh, 0, 1)
print(dres.round(6).to_string(index=False))
print("Years significant after BH-FDR (dedup):",
      list(dres.loc[dres['p_bh'] < 0.05, 'year']))
dres.to_csv('artifacts/robustness_dedup.csv', index=False)

# ---------------- summary reconciliation ----------------
print("\n=== RECONCILIATION ===")
print("Primary (MWU one-sided, BH-FDR p<0.05):  ", list(res.loc[res['p_bh'] < 0.05, 'year']))
print("Holm (p<0.05):                           ", list(res.loc[res['p_holm'] < 0.05, 'year']))
print("Two-part p(le0) chi2 < 0.05:             ", list(tp.loc[tp['p_chi_le0'] < 0.05, 'year']))
print("Two-part p(log10 Welch) < 0.05:          ", list(tp.loc[tp['p_welch_log10'] < 0.05, 'year']))
print("IHS OLS one-sided p < 0.05:              ", [int(y) for y, pv in zip(ihs['year'], ihs['p_one_sided_lower']) if pv < 0.05])
print("Dedup BH-FDR p<0.05:                     ", list(dres.loc[dres['p_bh'] < 0.05, 'year']))
print("\nDone.")
