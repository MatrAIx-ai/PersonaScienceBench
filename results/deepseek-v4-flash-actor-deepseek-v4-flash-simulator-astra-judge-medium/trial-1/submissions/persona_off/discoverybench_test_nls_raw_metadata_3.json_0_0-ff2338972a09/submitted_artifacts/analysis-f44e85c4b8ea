P("ASVAB by race:"); P(g19.groupby("race")["asvab"].agg(["count","mean","median"]).round(1).to_string())

def logit(d,cols):
    X=sm.add_constant(d[cols]); m=sm.Logit(d["anycoll"],X).fit(disp=False)
    return m,{c:(m.predict(X.assign(**{c:X[c]+1}))-m.predict(X)).mean() for c in cols}
def ols(d,cols):
    return sm.OLS(d["grade"],sm.add_constant(d[cols])).fit()
P(""); P("="*78); P("MODEL A: logit any-college-by-1979 (grade>=13), age>=19, n=%d"%len(cc)); P("="*78)
m0,a0=logit(cc,["black","hisp","age","female"]); m1,a1=logit(cc,["black","hisp","age","female","lninc","pared"])
m2,a2=logit(cc,["black","hisp","age","female","lninc","pared","asvab_z"])
for tag,m,ame in [("M0 race+demog",m0,a0),("M1 +SES",m1,a1),("M2 +ACADEMIC(ASVAB)",m2,a2)]:
