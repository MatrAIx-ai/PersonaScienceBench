df["lnweal85"]=np.log1p(np.maximum(df[WEAL85],0)); df["anycoll"]=((df[GRADE]>=13)&df[GRADE].notna()).astype(int)

P("="*78); P("MISSINGNESS (full sample N=%d)"%len(df)); P("="*78)
msk=df[[GRADE,INC,MOM,DAD,RACE,SEX,AGE,*ASV,WEAL85,OCC]]
P(pd.DataFrame({"n_nonnull":msk.count(),"n_missing":msk.isna().sum(),"pct_missing":(msk.isna().mean()*100).round(1)}).to_string())
