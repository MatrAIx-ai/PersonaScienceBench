cc["asvab_z"]=(cc["asvab"]-cc["asvab"].mean())/cc["asvab"].std()
P(""); P("="*78); P("DESCRIPTIVES age>=19 (base n=%d, complete-case n=%d)"%(len(g19),len(cc))); P("="*78)
