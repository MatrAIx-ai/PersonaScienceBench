    o0.params["black"],o1.params["black"],o2.params["black"],o0.params["hisp"],o1.params["hisp"],o2.params["hisp"],
    o1.params["lninc"],o2.params["lninc"],o1.params["pared"],o2.params["pared"]))

P(""); P("="*78); P("ROBUSTNESS wealth/occupation (age>=19)"); P("="*78)
rw=cc[cc["lnweal85"].notna()].copy(); r1=ols(rw,["black","hisp","age","female","lninc","pared","lnweal85"])
r2=ols(rw,["black","hisp","age","female","lninc","pared","lnweal85","asvab_z"])
P("wealth: lnweal85 %.3f->%.3f (p=%.2g/%.2g); black %.3f->%.3f; hisp %.3f->%.3f"%(
    r1.params["lnweal85"],r2.params["lnweal85"],r1.pvalues["lnweal85"],r2.pvalues["lnweal85"],
