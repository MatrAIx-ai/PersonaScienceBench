P(""); P("="*78); P("MEDIATION via ASVAB (product rule, grade)"); P("="*78)
Xa=sm.add_constant(cc[["black","hisp","age","female","lninc","pared"]]); ma=sm.OLS(cc["asvab_z"],Xa).fit()
Xb=sm.add_constant(cc[["black","hisp","age","female","lninc","pared","asvab_z"]]); mb=sm.OLS(cc["grade"],Xb).fit()
aP={"black":ma.params["black"],"hisp":ma.params["hisp"],"lninc":ma.params["lninc"],"pared":ma.params["pared"]}
P("a-path X->ASVAB: black=%.3f hisp=%.3f lninc=%.3f pared=%.3f | b-path ASVAB->grade=%.3f"%(
    aP["black"],aP["hisp"],aP["lninc"],aP["pared"],mb.params["asvab_z"]))
for name,a in aP.items():
    indirect=a*mb.params["asvab_z"]; sea=ma.bse[name]; seb=mb.bse["asvab_z"]
    se_i=np.sqrt(a**2*seb**2+mb.params["asvab_z"]**2*sea**2); z=indirect/se_i
    P("   %-6s indirect via ASVAB=%+.3f yrs (Sobel z=%+.2f, p=%.2g)"%(name,indirect,z,2*(1-sst.norm.cdf(abs(z)))))

