cc["black_a"]=cc["black"]*cc["asvab_z"]; cc["hisp_a"]=cc["hisp"]*cc["asvab_z"]
mm=sm.OLS(cc["grade"],sm.add_constant(cc[["black","hisp","age","female","lninc","pared","asvab_z","black_a","hisp_a"]])).fit()
P(""); P("="*78); P("MODERATION race x ASVAB on grade"); P("="*78)
