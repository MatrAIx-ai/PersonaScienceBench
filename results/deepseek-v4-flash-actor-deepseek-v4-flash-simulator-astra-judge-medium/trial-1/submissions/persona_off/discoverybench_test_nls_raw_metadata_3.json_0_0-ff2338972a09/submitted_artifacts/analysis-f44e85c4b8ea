    v=[fm(D)[0].params[k] for D in imps]; P("   OLS  %-10s imputed=%+.3f (SE=%.3f)"%(k,np.mean(v),np.std(v)/np.sqrt(len(v))))
for k in ["black","hisp","asvab_z_imp"]:
    v=[fm(D)[1].params[k] for D in imps]; P("   logit %-9s imputed=%+.3f (SE=%.3f)"%(k,np.mean(v),np.std(v)/np.sqrt(len(v))))
