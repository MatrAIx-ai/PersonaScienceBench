o2=ols(cc,["black","hisp","age","female","lninc","pared","asvab_z"])
for tag,m in [("M0",o0),("M1 +SES",o1),("M2 +ACADEMIC",o2)]:
    P("--- %s | R2=%.3f"%(tag,m.rsquared))
    for c in ["black","hisp","lninc","pared","asvab_z"]:
