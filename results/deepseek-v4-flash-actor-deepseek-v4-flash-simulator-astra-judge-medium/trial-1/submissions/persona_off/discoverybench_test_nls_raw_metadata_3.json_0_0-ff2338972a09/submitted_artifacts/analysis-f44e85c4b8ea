g=df[(df["age"]>=19)&df["grade"].notna()].copy(); g["asvab_z"]=(g["asvab"]-g["asvab"].mean())/g["asvab"].std()
P("n=%d; missing asvab=%.1f%% lninc=%.1f%% pared=%.1f%%"%(len(g),g["asvab"].isna().mean()*100,
    g["lninc"].isna().mean()*100,g["pared"].isna().mean()*100))
def mice(d,imp_vars,other_vars,n_imp=6,rounds=6):
    res=[]; D=d.copy()
    for v in imp_vars: D[v+"_imp"]=D[v].fillna(D[v].mean())
    for _ in range(n_imp):
        Dc=D.copy()
        for _ in range(rounds):
            for v in imp_vars:
                col=v+"_imp"; om=Dc[v].notna(); mm=Dc[v].isna()
                if om.sum()<50: continue
                y=Dc.loc[om,v]; feat=other_vars+[c+"_imp" for c in imp_vars if c!=v]
                m=sm.OLS(y,sm.add_constant(Dc.loc[om,feat])).fit()
                if mm.sum()>0:
                    Dc.loc[mm,col]=m.predict(sm.add_constant(Dc.loc[mm,feat]))+np.random.normal(0,np.sqrt(m.mse_resid),size=mm.sum())
        res.append(Dc)
    return res
imps=mice(g,["lninc","pared","asvab_z"],["black","hisp","age","female"])
def fm(D):
    cols=["black","hisp","age","female","lninc_imp","pared_imp","asvab_z_imp"]
    return sm.OLS(D["grade"],sm.add_constant(D[cols])).fit(),sm.Logit(D["anycoll"],sm.add_constant(D[cols])).fit(disp=False)
