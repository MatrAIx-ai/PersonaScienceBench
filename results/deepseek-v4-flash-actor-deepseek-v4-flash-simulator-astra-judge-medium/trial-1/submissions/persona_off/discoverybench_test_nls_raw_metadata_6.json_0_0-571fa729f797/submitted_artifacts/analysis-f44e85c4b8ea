"""
NLSY79 (metadata_6): Black advantage in college-degree-level attainment by SES.
Outcome = 'Highest grade completed, 1979' thresholds (>=13, >=14 primary, >=15, >=16).
SES primary = parental-education terciles; sensitivity = income79, wealth96.
Advantage = Black minus pooled non-Black (HISP+NBNH) rate (pp) per SES level;
NBNH-only robustness; age/sex-controlled Black x SES interaction; age>=19 sensitivity.
"""
import pandas as pd, numpy as np
import statsmodels.api as sm
import warnings; warnings.filterwarnings("ignore")
pd.set_option("display.width", 200)

df = pd.read_csv("data/nls_raw.csv")
race_map = {1:"BLACK",2:"HISP",3:"NBNH"}
df["race"] = df["Racial/ethnic cohort, 1979"].map(race_map)

g = df["Highest grade completed, 1979"].where(df["Highest grade completed, 1979"]<=20)
df["grade"] = g
for thr, tag in [(13,"GC13"),(14,"GC14"),(15,"GC15"),(16,"BA16")]:
    df[tag] = (df["grade"] >= thr).astype(float)

df["mom_ed"] = df["Highest grade completed by respondent's mother, 1979"]
df["dad_ed"] = df["Highest grade completed by respondent's father, 1979"]
df["par_ed"] = df[["mom_ed","dad_ed"]].mean(axis=1, skipna=False)
one_miss = df["par_ed"].isna()
df.loc[one_miss,"par_ed"] = df.loc[one_miss,["mom_ed","dad_ed"]].max(axis=1)  # one-parent fallback
df["inc79"]   = df["Total net family income, previous calendar year, 1979"]
df["wealth96"]= df["Family net wealth, 1996 (key data point)"]

def terciles(x): return pd.qcut(x.rank(method="first"),3,labels=["Low","Mid","High"])
df["ses_par"] = terciles(df["par_ed"]); df["ses_inc"]=terciles(df["inc79"]); df["ses_w"]=terciles(df["wealth96"])
df["black"]   = (df["race"]=="BLACK").astype(int)

def adv_tables(d, ses_col, outcome):
    tab = d.pivot_table(index=ses_col, columns="race", values=outcome, aggfunc="mean")
    n   = d.pivot_table(index=ses_col, columns="race", values=outcome, aggfunc="count")
    tot_rate = d.groupby(ses_col)[outcome].mean()
    tot_n    = d.groupby(ses_col)[outcome].size()
    nonb_rate = (tot_rate*tot_n - tab["BLACK"]*n["BLACK"])/(tot_n - n["BLACK"])
    adv_pool = tab["BLACK"] - nonb_rate            # Black minus pooled non-Black
    adv_nbnh = tab["BLACK"] - tab["NBNH"]          # Black minus NBNH-only
    return tab, n, adv_pool, adv_nbnh

def fit_interaction(d, outcome, ses_col):
    d = d.dropna(subset=[outcome, ses_col,"Age of respondent, 1979","Sex of respondent, 1979"])
    low = d[d[ses_col]=="Low"].copy(); high = d[d[ses_col]=="High"].copy()
    d2 = pd.concat([low,high])
    y = d2[outcome]
    X = d2[["black","Age of respondent, 1979","Sex of respondent, 1979"]].copy()
    X["ses_high"] = (d2[ses_col]=="High").astype(float)
    X["black_x_high"] = X["black"]*X["ses_high"]
    X = sm.add_constant(X)
    cols = ["const","black","ses_high","black_x_high","Age of respondent, 1979","Sex of respondent, 1979"]
    X = X[cols].astype(float)
    try:
        m = sm.Logit(y, X).fit(disp=0)
        return m, len(d2)
    except Exception as e:
        return None, len(d2)

print("="*100); print("PRIMARY: SES=parental-ed terciles; thresholds; complete-case (grade & par_ed & age & sex)"); print("="*100)
base = df.dropna(subset=["grade","par_ed","Age of respondent, 1979","Sex of respondent, 1979"])
print(f"analytic n = {len(base)}")
OUTCOMES = ["GC14","GC13","GC15","BA16"]
for o in OUTCOMES:
    tab, n, ap, an = adv_tables(base, "ses_par", o)
    print(f"\n--- {o} rate % by SES level x race ---")
    print((tab*100).round(2).to_string()); print("N per cell:\n"+n.to_string())
    print("Black - pooled-nonBlack adv (pp):", {k: round(v*100,2) for k,v in ap.items()})
    print("Black - NBNH-only    adv (pp):", {k: round(v*100,2) for k,v in an.items()})

print("\n"+"="*100); print("INTERACTION (logit, Low vs High, age+sex controlled): does Black advantage change with SES?"); print("="*100)
for o in ["GC14","GC13","GC15","BA16"]:
    m,nm = fit_interaction(base, o, "ses_par")
    if m is None:
        print(f"{o}: model failed (n={nm})"); continue
    c = m.params["black_x_high"]; p = m.pvalues["black_x_high"]
    flag = "SIGNIFICANT(p<0.05)" if p<0.05 else ("marginal(p<0.10)" if p<0.10 else "ns")
    print(f"{o}: black@High (rel. Low) coef={c:.4f}, p={p:.4f} [{flag}], n={nm}")

print("\n"+"="*100); print("SENSITIVITY: age>=19 subsample (de-censor the 1979 snapshot), parental-ed SES"); print("="*100)
old = base[base["Age of respondent, 1979"]>=19]
print(f"n(age>=19) = {len(old)}")
for o in ["GC13","GC14","GC15"]:
    tab,n,ap,an = adv_tables(old,"ses_par",o)
    print(f"{o}: Black-pooled adv Low/Mid/High = {[round(ap[l]*100,2) if l in ap else None for l in ['Low','Mid','High']]}"
          f" | Black-NBNH = {[round(an[l]*100,2) if l in an else None for l in ['Low','Mid','High']]}")
    m,nm = fit_interaction(old,o,"ses_par")
    if m is not None:
        print(f"    interaction black@High: coef={m.params['black_x_high']:.4f} p={m.pvalues['black_x_high']:.4f}")
    else:
        print(f"    interaction model failed (n={nm})")

print("\n"+"="*100); print("SENSITIVITY SES measures for PRIMARY outcome GC14 (inc79, wealth96)"); print("="*100)
for key,ses_col in [("inc","ses_inc"),("w","ses_w")]:
    d = df.dropna(subset=["grade",ses_col,"Age of respondent, 1979","Sex of respondent, 1979"])
    tab,n,ap,an = adv_tables(d,ses_col,"GC14")
    print(f"[{key}] n={len(d)}")
    print((tab*100).round(2).to_string())
    print("Black-pooled adv:", {k:round(v*100,2) for k,v in ap.items()}, "| Black-NBNH:", {k:round(v*100,2) for k,v in an.items()})
    m,nm = fit_interaction(d,"GC14",ses_col)
    print(f"  interaction black@High coef={m.params['black_x_high']:.4f} p={m.pvalues['black_x_high']:.4f}" if m else f"  model failed n={nm}")

print("\n"+"="*100); print("ROBUSTNESS: par_ed mean-imputation (race-mean for the 445 missing)"); print("="*100)
dfi = df.copy()
dfi["par_ed_i"] = dfi["par_ed"].fillna(dfi.groupby("race")["par_ed"].transform("mean"))
dfi["ses_par_i"] = terciles(dfi["par_ed_i"])
di = dfi.dropna(subset=["grade","Age of respondent, 1979","Sex of respondent, 1979"])
tab,n,ap,an = adv_tables(di,"ses_par_i","GC14")
print("GC14 Black-NBNH adv (imputed):", {k:round(v*100,2) for k,v in an.items()})
tabb,nb,apb,anb = adv_tables(base,"ses_par","GC14")
print("GC14 Black-NBNH adv (complete-case):", {k:round(v*100,2) for k,v in anb.items()})

print("\n"+"="*100); print("EXTRA: linear-trend interaction (black x ses_z 0/1/2) + summary table save"); print("="*100)
def trend_fit(d, outcome, ses_col):
    d = d.dropna(subset=[outcome, ses_col,"Age of respondent, 1979","Sex of respondent, 1979"]).copy()
    d["ses_z"] = d[ses_col].map({"Low":0,"Mid":1,"High":2}).astype(float)
    X = d[["black","ses_z","Age of respondent, 1979","Sex of respondent, 1979"]].copy()
    X["black_x_trend"] = X["black"]*X["ses_z"]
    X = sm.add_constant(X[["const" if False else c for c in ["black","ses_z","black_x_trend","Age of respondent, 1979","Sex of respondent, 1979"]]])
    X.columns = ["const","black","ses_z","black_x_trend","age","sex"]
    return sm.Logit(d[outcome], X).fit(disp=0)

for o in ["GC13","GC14","GC15","BA16"]:
    m = trend_fit(base, o, "ses_par")
    print(f"{o}: linear trend interaction coef={m.params['black_x_trend']:.4f}, p={m.pvalues['black_x_trend']:.4f}")

# save the key primary summary table for the record
summ = base.copy()
rows=[]; OUT=["GC13","GC14","GC15","BA16"]
for o in OUT:
    tab,n,ap,an = adv_tables(base,"ses_par",o)
    for lvl in ["Low","Mid","High"]:
        rows.append({"outcome":o,"ses_level":lvl,
            "BLACK_pct":round(tab.loc[lvl,"BLACK"]*100,2),"HISP_pct":round(tab.loc[lvl,"HISP"]*100,2),
            "NBNH_pct":round(tab.loc[lvl,"NBNH"]*100,2),
            "adv_pooled_pp":round(ap[lvl]*100,2),"adv_NBNH_pp":round(an[lvl]*100,2),
            "n_BLACK":int(n.loc[lvl,"BLACK"]),"n_NBNH":int(n.loc[lvl,"NBNH"])})
pd.DataFrame(rows).to_csv("results_summary.csv", index=False)
print("saved results_summary.csv")
