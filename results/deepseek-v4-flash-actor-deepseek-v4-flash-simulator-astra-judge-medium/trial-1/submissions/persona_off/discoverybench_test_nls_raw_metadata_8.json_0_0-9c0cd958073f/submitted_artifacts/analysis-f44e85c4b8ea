"""
NLSY79 wealth analysis - DiscoveryBench
Question: How does the median wealth of white individuals compare to that of
black and Hispanic individuals from 1985 onwards?

Design (per approved plan):
- Cohorts: 1=BLACK, 2=HISPANIC, 3=NON-BLACK NON-HISPANIC (white proxy; no finer race var)
- Wealth: Family net wealth, 1985 / 1990 / 1996, taken as given (net of debts).
  Zeros and negatives included in all medians.
- Missingness: headline = year-wise complete cases; robustness = balanced panel
  (non-missing wealth in all three years).
- Inflation: constant 1996 dollars via BLS CPI-U annual averages
  (1985=107.6, 1990=130.7, 1996=156.9).
- Inference: per-group medians, bootstrap 95% CIs (2000 resamples), Mann-Whitney U.
"""
import numpy as np
import pandas as pd
from scipy import stats

rng = np.random.default_rng(42)

df = pd.read_csv('data/nls_raw.csv', low_memory=False)
COHORT = 'Racial/ethnic cohort, 1979'
wealth_cols = {
    1985: 'Family net wealth, 1985',
    1990: 'Family net wealth, 1990',
    1996: 'Family net wealth, 1996 (key data point)',
}
CPI = {1985: 107.6, 1990: 130.7, 1996: 156.9}
BASE = 1996
GROUPS = {1: 'Black', 2: 'Hispanic', 3: 'White (non-Black non-Hispanic proxy)'}
HEAD = {1: 'Black', 2: 'Hispanic', 3: 'White*'}

# ---- helper: bootstrap median CI ----
def boot_median_ci(x, n_boot=2000, alpha=0.05):
    x = np.asarray(x, dtype=float)
    meds = np.empty(n_boot)
    for i in range(n_boot):
        meds[i] = np.median(rng.choice(x, size=len(x), replace=True))
    lo, hi = np.percentile(meds, [100*alpha/2, 100*(1-alpha/2)])
    return lo, hi

def boot_gap_ci(x, y, n_boot=2000, alpha=0.05):
    """Bootstrap CI for diff of medians (x - y)."""
    x = np.asarray(x, dtype=float); y = np.asarray(y, dtype=float)
    d = np.empty(n_boot)
    for i in range(n_boot):
        d[i] = np.median(rng.choice(x, size=len(x), replace=True)) - \
               np.median(rng.choice(y, size=len(y), replace=True))
    return np.percentile(d, [100*alpha/2, 100*(1-alpha/2)])

def to_real(series_year_df, year):
    """Constant BASE-year dollars."""
    return series_year_df * CPI[BASE] / CPI[year]

def summarize(subset, year):
    """Median (constant-dollars), bootstrap CI per group; returns dict keyed by cohort."""
    real = to_real(subset[wealth_cols[year]], year)
    out = {}
    for g in [1, 2, 3]:
        x = real[subset[COHORT] == g].dropna()
        lo, hi = boot_median_ci(x)
        out[g] = {'n': len(x), 'median': np.median(x), 'ci_lo': lo, 'ci_hi': hi,
                  'n_zero': int((subset.loc[subset[COHORT]==g, wealth_cols[year]] == 0).sum()),
                  'n_neg': int((subset.loc[subset[COHORT]==g, wealth_cols[year]] < 0).sum())}
    return out

def mannwhitney(subset, year, gx, gy):
    real = to_real(subset[wealth_cols[year]], year)
    x = real[subset[COHORT] == gx].dropna()
    y = real[subset[COHORT] == gy].dropna()
    return stats.mannwhitneyu(x, y, alternative='two-sided')

print("="*100)
print("ANALYSIS 1 (headline): year-wise complete cases, constant 1996 dollars")
print("="*100)
rows = []
gap_tracks = {'white_black': {}, 'white_hisp': {}, 'black_hisp': {}}
for year in [1985, 1990, 1996]:
    sub = df.dropna(subset=[wealth_cols[year]])
    res = summarize(sub, year)
    print(f"\n--- {year} (CPI {CPI[year]}, in {BASE} dollars) ---")
    for g in [1, 2, 3]:
        r = res[g]
        print(f"  {HEAD[g]:<36} n={r['n']:>5}  median=${r['median']:>10,.0f}  "
              f"95%CI[${r['ci_lo']:,.0f}, ${r['ci_hi']:,.0f}]  "
              f"(zeros={r['n_zero']}, neg={r['n_neg']})")
        rows.append({'year': year, 'group': HEAD[g], 'n': r['n'], 'median_1996USD': r['median']})
    # gaps (white minus group) and ratios, with bootstrap CI on the gap
    for gy, key in [(1, 'white_black'), (2, 'white_hisp')]:
        gap = res[3]['median'] - res[gy]['median']
        ratio = res[3]['median'] / res[gy]['median'] if res[gy]['median'] > 0 else np.nan
        cio = boot_gap_ci(sub.loc[sub[COHORT]==3, wealth_cols[year]],
                          sub.loc[sub[COHORT]==gy, wealth_cols[year]])
        # convert gap CI (computed in nominal dollars via raw values above? no - computed on raw) 
        # recompute properly on real dollars:
        xr = to_real(sub.loc[sub[COHORT]==3, wealth_cols[year]], year)
        yr = to_real(sub.loc[sub[COHORT]==gy, wealth_cols[year]], year)
        cio_r = boot_gap_ci(xr, yr)
        gap_tracks[key][year] = gap
        print(f"  White* - {HEAD[gy]} median gap  = ${gap:>10,.0f}  "
              f"(95%CI[${cio_r[0]:,.0f}, ${cio_r[1]:,.0f}])   ratio = {ratio:.2f}x")
    # Black - Hispanic contextual
    gap_bh = res[1]['median'] - res[2]['median']
    ratio_bh = res[1]['median'] / res[2]['median'] if res[2]['median'] > 0 else np.nan
    gap_tracks['black_hisp'][year] = gap_bh
    print(f"  Black - Hispanic median gap = ${gap_bh:>10,.0f}  (contextual)  ratio = {ratio_bh:.2f}x")
    # Mann-Whitney
    print("  Mann-Whitney U (two-sided):")
    for gx, gy, lab in [(3,1,'White*>Black'), (3,2,'White*>Hispanic'), (1,2,'Black>Hispanic')]:
        u, p = mannwhitney(sub, year, gx, gy)
        print(f"     {lab:<20} U={u:>8,.0f}  p={p:.2e}")

res_table = pd.DataFrame(rows)
print("\n\nMEDIAN TABLE (constant 1996 USD), year-wise complete cases:")
print(res_table.pivot(index='year', columns='group', values='median_1996USD').round(0).to_string())

print("\nGAP TRACKING (constant 1996 USD):")
for key, dd in gap_tracks.items():
    print(f"  {key}: { {y: round(v,0) for y, v in dd.items()} }")
    if all(y in dd for y in (1985, 1986, 1990, 1996)):
        pass
wg = gap_tracks['white_black']; wh = gap_tracks['white_hisp']
def trend(d):
    print(f"     from 1985 to 1996: absolute gap went from ${d[1985]:,.0f} to ${d[1996]:,.0f} "
          f"({'+' if d[1996]>d[1985] else ''}{((d[1996]/d[1985]-1)*100):,.0f}% ; 1996/1985 = {d[1996]/d[1985]:.2f}x)")
print("  White*-Black gap trend:"); trend(wg)
print("  White*-Hispanic gap trend:"); trend(wh)

print("\n" + "="*100)
print("ANALYSIS 2 (robustness): balanced panel - non-missing wealth in ALL three years")
print("="*100)
panel = df.dropna(subset=[wealth_cols[y] for y in wealth_cols])
print("Balanced-panel respondents:", len(panel))
print("Per-cohort n in balanced panel:", panel[COHORT].value_counts().sort_index().to_dict())
rows2 = []
for year in [1985, 1990, 1996]:
    res = summarize(panel, year)
    print(f"\n--- {year} (balanced panel, constant {BASE} USD) ---")
    for g in [1, 2, 3]:
        r = res[g]
        print(f"  {HEAD[g]:<36} n={r['n']:>5}  median=${r['median']:>10,.0f}  "
              f"95%CI[${r['ci_lo']:,.0f}, ${r['ci_hi']:,.0f}]")
        rows2.append({'year': year, 'group': HEAD[g], 'n': r['n'], 'median_1996USD': r['median']})
    for gy, lab in [(1, 'White*-Black'), (2, 'White*-Hispanic')]:
        x = to_real(panel.loc[panel[COHORT]==3, wealth_cols[year]], year)
        y = to_real(panel.loc[panel[COHORT]==gy, wealth_cols[year]], year)
        gap = np.median(x) - np.median(y)
        cio = boot_gap_ci(x, y)
        print(f"  {lab} gap = ${gap:,.0f} (95%CI[${cio[0]:,.0f}, ${cio[1]:,.0f}])  ratio = {np.median(x)/np.median(y):.2f}x")

panel_table = pd.DataFrame(rows2)
print("\n\nMEDIAN TABLE (constant 1996 USD), balanced panel:")
print(panel_table.pivot(index='year', columns='group', values='median_1996USD').round(0).to_string())

print("\nDONE.")
