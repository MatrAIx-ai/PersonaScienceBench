"""Bounded targeted search for a defensible full 0.5024 -> 0.0923 path.
Dimensions: race coding (incl. ordinal), control codings (raw/z/rescaled,
SES-quartile dummies, log family size), M0 baselines (univariate vs partial
controls), M3 specs. Sample restrictions are NOT testable: no enrollment var."""
import numpy as np, pandas as pd, statsmodels.api as sm
from itertools import product

T0, T3 = 0.5024, 0.0923
TOL0, TOL3 = 0.02, 0.01

df = pd.read_csv('data/nls_ses_processed.csv')
df['Y'] = df['BA DEGREE COMPLETED'].astype(int)
df['Female']=(df['SAMPLE_SEX']=='Female').astype(int)
df['Black']=(df['SAMPLE_RACE']=='Black').astype(int)
df['Hispanic']=(df['SAMPLE_RACE']=='Hispanic').astype(int)
df['White']=(df['SAMPLE_RACE']=='White').astype(int)
df['NonWhite']=1-df['White']
df['Famsize']=df['FAMILY SIZE OF SAMPLE']
df['Ability']=df['ABILITY: COMPOSITE OF ASVAB SCORE']
df['Percentile']=df['PERCENTILE IN CLASS']
df['SES']=df['SES']
# --- derived codings ---
def z(x): return (x-x.mean())/x.std()
df['SES_z']=z(df.SES); df['Ability_z']=z(df.Ability); df['Percentile_z']=z(df.Percentile)
df['Ability_h']=df.Ability/100.0; df['Percentile_d']=df.Percentile/10.0
df['Famsize_log']=np.log(df.Famsize); df['Famsize_z']=z(df.Famsize)
df['RaceOrd_A']=np.select([df.White==1, df.Hispanic==1, df.Black==1],[0,1,2])  # White0,Hisp1,Black2
df['RaceOrd_B']=np.select([df.Black==1, df.Hispanic==1, df.White==1],[0,1,2])  # Black0,Hisp1,White2
df['SESq']=pd.qcut(df.SES,4,labels=False)
df['SESQ2']=(df.SESq==1).astype(int); df['SESQ3']=(df.SESq==2).astype(int); df['SESQ4']=(df.SESq==3).astype(int)

def fit(cols):
    cols=list(dict.fromkeys(cols))
    X=sm.add_constant(df[cols].astype(float))
    try:
        m=sm.Logit(df['Y'],X).fit(disp=0, maxiter=100)
        return m
    except Exception:
        return None

# candidate definitions: (focus, candidate terms, label)
CANDS=[
 ('Black',['Black','Hispanic'],'RACE pair (Black/Hispanic vs White)'),
 ('Black1',['Black'],'RACE Black single'),
 ('White',['White'],'RACE White vs rest'),
 ('NonWhite',['NonWhite'],'RACE NonWhite vs White'),
 ('RaceOrd_A',['RaceOrd_A'],'RACE ordinal White0/Hisp1/Black2'),
 ('RaceOrd_B',['RaceOrd_B'],'RACE ordinal Black0/Hisp1/White2'),
 ('Hispanic',['Hispanic'],'RACE Hispanic single'),
]

# M0 baseline options: (label, extra terms)
M0B=[
 ('M0_alone',[]),
 ('M0_+Famsize',['Famsize']),
 ('M0_+Female',['Female']),
 ('M0_+Famsize+Female',['Famsize','Female']),
]
# M3 'SES + academic' specs: (label, ses-cols, acad-cols, extra-cols)
M3S=[
 ('SES_raw+Ability+Percentile',        ['SES'],            ['Ability','Percentile'],            []),
 ('SES_raw+Abilityh+Percentiled',      ['SES'],            ['Ability_h','Percentile_d'],        []),
 ('SES_z+Abilityz+Percentilez',        ['SES_z'],          ['Ability_z','Percentile_z'],        []),
 ('SES_quartiles+Ability+Percentile',  ['SESQ2','SESQ3','SESQ4'], ['Ability','Percentile'],      []),
 ('SES_raw+Ability+Percentile+Fam+Sex',['SES'],            ['Ability','Percentile'],            ['Famsize','Female']),
]

rows=[]
for cdef in CANDS:
    focus, candT, label = cdef
    for m0lbl, m0extra in M0B:
        m0cols = candT + m0extra
        for m3lbl, sesC, acadC, extra in M3S:
            m3cols = candT + sesC + acadC + extra
            m0=fit(m0cols); m3=fit(m3cols)
            if m0 is None or m3 is None: continue
            if focus not in m0.params or focus not in m3.params: continue
            c0=m0.params[focus]; c3=m3.params[focus]
            p0=m0.pvalues[focus]; p3=m3.pvalues[focus]
            rows.append(dict(cand=label, m0=m0lbl, m3=m3lbl,
                c0=c0, p0=p0, c3=c3, p3=p3,
                d0=abs(c0-T0), d3=abs(c3-T3),
                flip=(p0<0.05 and p3>0.05),
                match=(abs(c0-T0)<=TOL0 and abs(c3-T3)<=TOL3 and p0<0.05 and p3>0.05)))
R=pd.DataFrame(rows); R['sum']=R.d0+R.d3
R=R.sort_values(['match','sum'])
pd.set_option('display.width',250); pd.set_option('display.max_columns',None)
pd.set_option('display.float_format', lambda x: f'{x:,.4f}')
print('COMBOS EVALUATED:', len(R))
print('\nFULL-PATH MATCHES (M0 in 0.5024±0.02 AND M3 in 0.0923±0.01 AND sig->ns flip):')
if R.match.sum()==0:
    print('  NONE')
else:
    print(R[R.match==True][['cand','m0','m3','c0','p0','c3','p3','d0','d3','flip']].to_string(index=False))
print('\nTOP 25 closest overall:')
print(R.head(25)[['cand','m0','m3','c0','p0','c3','p3','d0','d3','flip','sum']].to_string(index=False))
R.to_csv('search_fullpath.csv', index=False)

# ---- explicit family-size failure check across all M3 specs ----
print('\nFAMILY-SIZE failure check (raw famsize, M0 alone vs each M3 spec):')
for m0lbl,m0e in [('M0_alone',[]),('M0_+Famsize',['Famsize'])]:
    for m3lbl,sesC,acadC,extra in M3S:
        if m0lbl=='M0_+Famsize': continue
        m0=fit(['Famsize']+m0e); m3=fit(['Famsize']+sesC+acadC+extra)
        if m0 and m3 and 'Famsize' in m0.params:
            c0=m0.params['Famsize']; c3=m3.params['Famsize']
            print(f"  M0={m0lbl} -> M3={m3lbl:42s}: M0={c0:+.4f}(p={m0.pvalues['Famsize']:.4f}) "
                  f"M3={c3:+.4f}(p={m3.pvalues['Famsize']:.4f}) flip_to_ns={'YES' if (m0.pvalues['Famsize']<0.05 and m3.pvalues['Famsize']>0.05) else 'NO'}")

# ---- SES failure check ----
print('\nSES failure check (M0 alone vs each M3 spec):')
for m3lbl,sesC,acadC,extra in M3S:
    if set(sesC)!={'SES'}: continue
    m0=fit(['SES']); m3=fit(['SES']+sesC+acadC+extra)
    c0=m0.params['SES']; c3=m3.params['SES']
    print(f"  M3={m3lbl:44s}: M0={c0:+.4f}(p={m0.pvalues['SES']:.4f}) M3={c3:+.4f}(p={m3.pvalues['SES']:.4f}) flip_to_ns={'YES' if (m0.pvalues['SES']<0.05 and m3.pvalues['SES']>0.05) else 'NO'}")
