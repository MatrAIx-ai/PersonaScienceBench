"""
NLS-SES: Does race (racial lines) moderate the SES -> BA degree completion relation?
DiscoveryBench episode: nls_ses

Approved plan:
  - Outcome: BA DEGREE COMPLETED (binary, rare: 2.69%)
  - Primary moderation test: race x SES interaction via LR + Wald test,
    comparing additive vs interaction logistic model
  - Primary specification (robustness-relevant): adjusted for sex, family size,
    ability (ASVAB composite), and class percentile
  - Check specification: unadjusted for ability/class percentile
  - Robustness: Firth (penalized) logistic regression on the interaction
  - Supporting output: race-specific SES ORs (per 1 SD), predicted completion
    probabilities at SES = -1, 0, +1 SD, additive race effect as context
  - No causal claims: associational, moderation/effect-modification framing
"""
import numpy as np
import pandas as pd
import statsmodels.api as sm
import statsmodels.formula.api as smf
from statsmodels.stats.anova import anova_lm
from scipy import stats

# ---------- data ----------
df = pd.read_csv('data/nls_ses_processed.csv')
df['BA'] = df['BA DEGREE COMPLETED'].astype(int)
# rename factors with short names for patsy
df = df.rename(columns={
    'SAMPLE_RACE': 'race',
    'SAMPLE_SEX': 'sex',
    'FAMILY SIZE OF SAMPLE': 'famsize',
    'ABILITY: COMPOSITE OF ASVAB SCORE': 'ability',
    'PERCENTILE IN CLASS': 'pct_class',
    'SES': 'SES',
})
# reference category = White
from patsy import Treatment
race_ref = {'SAMPLE_RACE': 'White'}

def build_matrix(df, interact, adjust):
    """Return (X, y) design matrices."""
    if adjust:
        base = ["C(race, Treatment(reference='White'))", "SES", "C(sex)",
                "famsize", "ability", "pct_class"]
    else:
        base = ["C(race, Treatment(reference='White'))", "SES", "C(sex)", "famsize"]
    if interact:
        base.append("SES:C(race, Treatment(reference='White'))")
    formula = "BA ~ " + " + ".join(base)
    y, X = smf.glm(formula, data=df, family=sm.families.Binomial()).endog, 0
    # use patsy directly
    import patsy
    y, X = patsy.dmatrices(formula, df, return_type='dataframe')
    return X, y

def fit_logit(X, y):
    """Standard maximum-likelihood logistic regression."""
    return sm.Logit(y, X).fit(disp=0)

def firth_fit(X, y, maxiter=100, tol=1e-8):
    """Firth penalized logistic regression via modified IRLS (bias-reduced MLE)."""
    X = np.asarray(X, dtype=float)
    y = np.asarray(y, dtype=float).ravel()
    n, p = X.shape
    beta = np.zeros(p)
    for it in range(maxiter):
        eta = X @ beta
        mu = 1.0 / (1.0 + np.exp(-np.clip(eta, -30, 30)))
        W = mu * (1.0 - mu)
        # hat matrix diagonal
        WX = X * W[:, None]
        XWX = X.T @ WX
        try:
            XWX_inv = np.linalg.inv(XWX)
        except np.linalg.LinAlgError:
            XWX_inv = np.linalg.pinv(XWX)
        H = (WX @ XWX_inv) * X
        h = H.sum(axis=1)
        # modified weights / adjusted response (Firth)
        wstar = W + h / 2.0
        z = eta + (y - mu + h * (0.5 - mu)) / np.clip(wstar, 1e-12, None)
        beta_new = np.linalg.solve(X.T @ (X * wstar[:, None]), X.T @ (wstar * z))
        if np.max(np.abs(beta_new - beta)) < tol:
            beta = beta_new
            break
        beta = beta_new
    # variance-covariance (penalized info matrix) and Wald stats
    eta = X @ beta
    mu = 1.0 / (1.0 + np.exp(-np.clip(eta, -30, 30)))
    W = mu * (1.0 - mu)
    WX = X * W[:, None]
    XWX = X.T @ WX
    try:
        cov = np.linalg.inv(XWX)
    except np.linalg.LinAlgError:
        cov = np.linalg.pinv(XWX)
    return beta, cov, it + 1

def wald_z(beta, cov, idx):
    b = beta[idx]
    se = np.sqrt(np.diag(cov)[idx])
    return b, se, b / se, 2 * (1 - stats.norm.cdf(abs(b / se)))

# ---------- MODELS ----------
print("=" * 78)
print("DESIGN SUMMARY")
print("=" * 78)
print("N =", len(df), "| completions =", int(df['BA'].sum()),
      "| completion rate =", round(df['BA'].mean(), 4))
print(df.groupby('race')['BA'].agg(['count', 'sum', 'mean']).round(4))
print("SES: mean=%.3f sd=%.3f" % (df['SES'].mean(), df['SES'].std()))

results = {}

for label, adjust in [("ADJUSTED (incl. ability + class percentile)", True),
                      ("UNADJUSTED (no ability/class percentile)", False)]:

    print("\n" + "=" * 78)
    print("SPECIFICATION:", label)
    print("=" * 78)

    # additive model
    Xa, ya = build_matrix(df, False, adjust)
    ma = fit_logit(Xa, ya)
    # interaction model
    Xi, yi = build_matrix(df, True, adjust)
    mi = fit_logit(Xi, yi)

    # identify interaction columns
    inter_cols = [c for c in Xi.columns if 'SES:' in c and 'race' in c]
    inter_idx = [list(Xi.columns).index(c) for c in inter_cols]

    # LR test
    lr_stat = 2 * (mi.llf - ma.llf)
    lr_p = 1 - stats.chi2.cdf(lr_stat, df=len(inter_cols))
    # Wald test on interaction coefs
    cov_i = mi.cov_params()
    b_int = mi.params[inter_cols].values
    cov_int = np.array([[cov_i.loc[i, j] for j in inter_cols] for i in inter_cols])
    try:
        wald_stat = float(b_int @ np.linalg.inv(cov_int) @ b_int)
    except np.linalg.LinAlgError:
        wald_stat = float(b_int @ np.linalg.pinv(cov_int) @ b_int)
    wald_p = 1 - stats.chi2.cdf(wald_stat, df=len(inter_cols))

    print("\n-- Interaction model (standard ML) coefficients --")
    cols = ['White/ref'] + list(Xi.columns)[1:]
    t = pd.DataFrame({
        'coef': mi.params, 'SE': mi.bse, 'p': mi.pvalues,
        'OR': np.exp(mi.params),
        'OR_low': np.exp(mi.params - 1.96 * mi.bse),
        'OR_high': np.exp(mi.params + 1.96 * mi.bse),
    }, index=Xi.columns)
    print(t.round(4).to_string())

    print("\n-- MODERATION TEST (race x SES interaction) --")
    print(f"  LR  chi2({len(inter_cols)}) = {lr_stat:.3f}, p = {lr_p:.4g}")
    print(f"  Wald chi2({len(inter_cols)}) = {wald_stat:.3f}, p = {wald_p:.4g}")

    # race-specific SES slope / OR (from interaction model)
    bSES = mi.params['SES']
    print("\n-- Race-specific SES effect (odds ratio per 1 SD SES) --")
    rows = {}
    for race in ['White', 'Black', 'Hispanic']:
        if race == 'White':
            b = bSES; se = mi.bse['SES']
        else:
            col = f'SES:C(race, Treatment(reference=\'White\'))[T.{race}]'
            b = bSES + mi.params[col]
            se = np.sqrt(mi.bse['SES']**2 + mi.bse[col]**2 +
                         2 * mi.cov_params().loc['SES', col])
        lo, hi = np.exp(np.array([b - 1.96*se, b + 1.96*se]))
        rows[race] = {'OR': np.exp(b), 'OR_low': lo, 'OR_high': hi,
                      'logOR_SE': se}
    rs = pd.DataFrame(rows).T
    print(rs.round(4).to_string())

    # additive race main effects (context)
    print("\n-- Additive race main effects (context; OR vs White) --")
    add = pd.DataFrame({
        'coef': ma.params, 'SE': ma.bse, 'p': ma.pvalues,
        'OR': np.exp(ma.params),
        'OR_low': np.exp(ma.params - 1.96*ma.bse),
        'OR_high': np.exp(ma.params + 1.96*ma.bse)}, index=ma.params.index)
    race_cols = [c for c in add.index if 'race' in c]
    print(add.loc[race_cols].round(4).to_string())

    # predicted completion probability at SES = -1,0,+1 by race (interaction model)
    print("\n-- Predicted completion probability by race at SES = -1, 0, +1 SD"
          " (other covariates at means / reference) --")
    # build prediction frame: Intercept=1, means for continuous, covariates at reference
    basex = Xi.iloc[0:1, :].copy()
    means = df[['famsize'] + (['ability', 'pct_class'] if adjust else [])].mean()
    basex.loc[0] = 0.0
    basex['Intercept'] = 1.0      # IMPORTANT: keep intercept at 1
    for col, v in means.items():
        basex[col] = v
    basex = basex.iloc[[0]]
    pred_rows = []
    for race in ['White', 'Black', 'Hispanic']:
        for ses in [-1, 0, 1]:
            xx = basex.copy()
            xx['SES'] = ses
            if race == 'White':
                for c in Xi.columns:
                    if 'race' in c:
                        xx[c] = 0
            else:
                col = 'C(race, Treatment(reference=\'White\'))[T.%s]' % race
                for c in [x for x in Xi.columns if 'race' in x]:
                    xx[c] = 1 if c == col else 0
                for c in Xi.columns:
                    if ('SES:' in c) and (c != col):
                        pass
                # interaction col for this race
                icol = 'SES:C(race, Treatment(reference=\'White\'))[T.%s]' % race
                if icol in Xi.columns:
                    xx[icol] = ses
            eta = float(np.asarray(xx)[0] @ mi.params.values)
            p = 1 / (1 + np.exp(-eta))
            pred_rows.append((race, ses, p))
    pred = pd.DataFrame(pred_rows, columns=['race', 'SES_sd', 'P(BA)'])
    print(pred.pivot(index='race', columns='SES_sd', values='P(BA)').round(4).to_string())

    results[label] = {'lr': (lr_stat, lr_p), 'wald': (wald_stat, wald_p),
                      'race_OR': rs, 'pred': pred}

    # ---------- Firth robustness on interaction ----------
    print("\n-- FIRTH (bias-reduced) logistic, interaction model --")
    bf, covf, niter = firth_fit(Xi, yi)
    frows = []
    for i, c in enumerate(Xi.columns):
        frows.append((c, bf[i], covf[i, i]**0.5, bf[i]/(covf[i, i]**0.5),
                      2*(1-stats.norm.cdf(abs(bf[i]/(covf[i, i]**0.5))))))
    fdf = pd.DataFrame(frows, columns=['term', 'coef', 'SE', 'z', 'p'])
    fdf['OR'] = np.exp(fdf['coef'])
    fdf['OR_low'] = np.exp(fdf['coef'] - 1.96*fdf['SE'])
    fdf['OR_high'] = np.exp(fdf['coef'] + 1.96*fdf['SE'])
    print("(converged in %d IRLS iterations)" % niter)
    print(fdf.round(4).to_string(index=False))

    # Firth Wald test on interaction terms
    inter_idx = [list(Xi.columns).index(c) for c in inter_cols]
    bf_int = bf[inter_idx]
    covf_int = covf[np.ix_(inter_idx, inter_idx)]
    try:
        f_wald = float(bf_int @ np.linalg.inv(covf_int) @ bf_int)
    except np.linalg.LinAlgError:
        f_wald = float(bf_int @ np.linalg.pinv(covf_int) @ bf_int)
    f_p = 1 - stats.chi2.cdf(f_wald, df=len(inter_cols))
    print(f"  Firth Wald interaction chi2({len(inter_cols)}) = {f_wald:.3f}, p = {f_p:.4g}")
    results[label]['firth_wald'] = (f_wald, f_p)

print("\n" + "=" * 78)
print("SUMMARY TABLE")
print("=" * 78)
for label, r in results.items():
    print(f"{label:55s} LR p={r['lr'][1]:.4g}  Wald p={r['wald'][1]:.4g}  "
          f"Firth-Wald p={r['firth_wald'][1]:.4g}")

# save outputs
with open('analysis/results_report.txt', 'w') as f:
    f.write("FULL MODEL OUTPUTS (see stdout above for structure)\n")
    f.write("N=%d completions=%d rate=%.4f\n" % (len(df), df['BA'].sum(), df['BA'].mean()))
    for label, r in results.items():
        f.write("\n%s\n" % label)
        f.write("  LR p=%.4g | Wald p=%.4g | Firth Wald p=%.4g\n" %
                (r['lr'][1], r['wald'][1], r['firth_wald'][1]))
        f.write("  Race-specific SES OR:\n%s\n" % r['race_OR'].round(4).to_string())
        f.write("  Predicted P(BA):\n%s\n" %
                r['pred'].pivot(index='race', columns='SES_sd', values='P(BA)').round(4).to_string())
print("\nSaved report to analysis/results_report.txt")
