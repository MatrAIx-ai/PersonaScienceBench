"""
NLS SES — Black BA-completion advantage across SES strata
Question: "At what Socioeconomic levels is the advantage in completion
rates for Black students more pronounced?"
Operationalization: per-stratum Black minus reference gap (pp) and ratio;
reference = White (primary), non-Black = White+Hispanic pooled (robustness).
Decision rule: most favorable stratum = least-negative pp gap / ratio closest to 1.
Sensitivty: re-estimate gaps conditioning on ASVAB composite + class percentile.
"""
import numpy as np
import pandas as pd
import statsmodels.api as sm
import statsmodels.formula.api as smf
from statsmodels.stats.proportion import proportion_confint, confint_proportions_2indep
from statsmodels.stats.contingency_tables import Table2x2
from scipy.stats import fisher_exact

np.random.seed(42)
df = pd.read_csv("data/nls_ses_processed.csv")
df["BA"] = df["BA DEGREE COMPLETED"].astype(int)
print(f"[DATA] n={len(df)} | BA completions={df.BA.sum()} ({df.BA.mean()*100:.2f}%) | missing={int(df.isna().sum().sum())}")

lines = []
def log(s=""):
    print(s); lines.append(s)

# ---------------------------------------------------------------- groupings
df["terc"] = pd.qcut(df.SES, 3, labels=["low","mid","high"])
df["quar"] = pd.qcut(df.SES, 4, labels=["q1","q2","q3","q4"])
df["quin"] = pd.qcut(df.SES, 5, labels=["k1","k2","k3","k4","k5"])
df["bin"]  = pd.qcut(df.SES, 2, labels=["below-median","above-median"])

# ---------------------------------------------------------------- Part A: stratified gaps
def ci_exact(k, n):
    lo, hi = proportion_confint(k, n, alpha=0.05, method="beta")
    return lo * 100, hi * 100

def ci_gap(k1, n1, k2, n2):
    # CI for difference of two proportions (p1-p2); try robust methods in order
    for method in ["score", "newcomb", "wald"]:
        try:
            lo, hi = confint_proportions_2indep(k1, n1, k2, n2, method=method, compare="diff", alpha=0.05)
            if np.isfinite(lo) and np.isfinite(hi):
                return lo * 100, hi * 100, method
        except Exception:
            continue
    return np.nan, np.nan, "n/a"

def strat_report(col, label):
    log("=" * 95)
    log(f"STRATIFIED GAP — {label} (grouping by {col})")
    log(f"{'stratum':<13}{'race':<9}{'n':>6}{'BA':>5}{'rate%':>8}{'exactCI%':>16}{'gap_pp':>9}{'gapCI_pp':>22}{'ratio':>7}{'fisher_p':>9}  sparse")
    for g in df[col].cat.categories:
        sub = df[df[col] == g]
        rows = []
        for race in ["Black", "White", "Hispanic"]:
            r = sub[sub.SAMPLE_RACE == race]
            k, n = r.BA.sum(), len(r)
            rate = k / n * 100 if n else np.nan
            lo, hi = ci_exact(k, n)
            rows.append((race, n, k, rate, lo, hi))
        bl = next(r for r in rows if r[0] == "Black")
        wh = next(r for r in rows if r[0] == "White")
        hib = [r for r in rows if r[0] == "Hispanic"][0]
        nonB_n = wh[1] + hib[1]; nonB_k = wh[2] + hib[2]
        nonB_rate = nonB_k / nonB_n * 100
        pB = bl[3]; pW = wh[3]
        gap_BW = pB - pW
        gap_BN = pB - nonB_rate
        blo, bhi = ci_exact(bl[2], bl[1])
        wlo, whi = ci_exact(wh[2], wh[1])
        glo, ghi, meth = ci_gap(bl[2], bl[1], wh[2], wh[1])
        ratio = pB / pW if pW > 0 else np.nan
        # Fisher exact Black vs White within stratum
        tbl = [[bl[2], bl[1] - bl[2]], [wh[2], wh[1] - wh[2]]]
        _, p = fisher_exact(tbl, alternative="two-sided")
        # note: expected from Table2x2 uses proportion layout? compute manually
        exp = np.outer(np.array([bl[1], wh[1]]), np.array([bl[2] + wh[2], bl[1] + wh[1] - bl[2] - wh[2]])) / (bl[1] + wh[1])
        sparse = " *" if (exp < 5).any() else "  "
        log(f"{g:<13}{'Black':<9}{bl[1]:>6}{bl[2]:>5}{pB:>8.2f}{f'[{blo:.1f},{bhi:.1f}]':>16}{gap_BW:>+9.2f}{f'({glo:.1f},{ghi:.1f})':>22}{ratio:>7.2f}{p:>9.3f}{sparse}")
        log(f"{'':<13}{'White':<9}{wh[1]:>6}{wh[2]:>5}{pW:>8.2f}{f'[{wlo:.1f},{whi:.1f}]':>16}")
        log(f"{'':<13}{'non-Bk':<9}{nonB_n:>6}{nonB_k:>5}{nonB_rate:>8.2f}{f' gapB-nonB={gap_BN:+.2f}pp':>16}")
    log("")

strat_report("terc", "SES terciles")
strat_report("quar", "SES quartiles")
strat_report("quin", "SES quintiles")
strat_report("bin",  "SES binary (above/below median)")

# ---------------------------------------------------------------- Part B: interaction (continuous SES)
log("#" * 95)
log("MODEL 1 — logistic: BA ~ SES_std * Black  (reference White; n=" + str(len(df)) + ")")
d = df.copy()
d["SES_std"] = (d.SES - d.SES.mean()) / d.SES.std()
d["Black"] = (d.SAMPLE_RACE == "Black").astype(int)
d["Hispanic"] = (d.SAMPLE_RACE == "Hispanic").astype(int)
d["ASVAB_std"] = (d["ABILITY: COMPOSITE OF ASVAB SCORE"] - d["ABILITY: COMPOSITE OF ASVAB SCORE"].mean()) / d["ABILITY: COMPOSITE OF ASVAB SCORE"].std()
d["PCT_std"] = (d["PERCENTILE IN CLASS"] - d["PERCENTILE IN CLASS"].mean()) / d["PERCENTILE IN CLASS"].std()

m1 = smf.logit("BA ~ SES_std * Black", data=d).fit(disp=0)
log(m1.summary2().tables[1].round(4).to_string())
inter_OR = np.exp(m1.params["SES_std:Black"])
log(f"\n=> Interaction (SES_std x Black) OR = {inter_OR:.3f}, p = {m1.pvalues['SES_std:Black']:.4f}")
log(f"   (OR<1 => gap widens with SES; OR>1 => gap narrows with SES)")

# Hispanic as additional control? Also model White vs Black only
log("\nMODEL 1b — logistic: BA ~ SES_std * Black + Hispanic (White reference, Hispanic controlled)")
m1b = smf.logit("BA ~ SES_std * Black + Hispanic", data=d).fit(disp=0)
log(m1b.summary2().tables[1].round(4).to_string())
log(f"\n=> Interaction (SES_std x Black) OR = {np.exp(m1b.params['SES_std:Black']):.3f}, p = {m1b.pvalues['SES_std:Black']:.4f}")

# predicted probabilities at SES percentiles (White vs Black), with CI
log("\nPredicted P(BA) at SES percentiles — White vs Black (Model 1, other race Hispanic=0)")
for q in [0.05, 0.25, 0.5, 0.75, 0.95]:
    new = pd.DataFrame({"SES_std": [df.SES.quantile(q), df.SES.quantile(q)],
                        "Black": [0, 1]})
    pr = m1.get_prediction(new)
    pp = pr.predicted * 100
    ci = pr.conf_int() * 100
    row = {"White": f"{pp[0]:.2f}% [{ci[0,0]:.2f},{ci[0,1]:.2f}]",
           "Black": f"{pp[1]:.2f}% [{ci[1,0]:.2f},{ci[1,1]:.2f}]",
           "gapB-W(pp)": f"{pp[1]-pp[0]:+.2f}"}
    log(f"  SES p{q*100:g} (SES={df.SES.quantile(q):.2f}): " + " | ".join(f"{k}={v}" for k, v in row.items()))

# ------------------------------------------------- discrete interaction (quintiles) 
log("\n" + "#" * 95)
log("MODEL 2 — discrete: BA ~ C(quin) * Black  (quintile-stratum-specific race effects)")
d2 = d.copy()
d2["quin"] = d.quin.astype(str)
m2 = smf.logit("BA ~ C(quin) * Black", data=d2).fit(disp=0)
log(m2.summary2().tables[1].round(4).to_string())
# stratum-specific Black-W white gaps from predictions
log("\nStratum-specific predicted Black-White gap (pp) and ratio (Model 2)")
quincat = [f"k{i}" for i in range(1, 6)]
res = []
for q in quincat:
    new = pd.DataFrame({"quin": [q, q], "Black": [0, 1]})
    pr = m2.get_prediction(new)
    pp = pr.predicted * 100
    res.append((q, pp[0], pp[1], pp[1] - pp[0], pp[1] / pp[0] if pp[0] > 0 else np.nan))
rdf = pd.DataFrame(res, columns=["quintile", "P_White%", "P_Black%", "gap_BW_pp", "ratio"]).round(2)
log(rdf.to_string(index=False))
log("\n=> Quintile with most favorable (least-negative) Black-White gap: %s (gap=%.2fpp)" %
    (rdf.loc[rdf.gap_BW_pp.idxmax(), "quintile"], rdf.gap_BW_pp.max()))
# interaction contrast: (gap in k5) - (gap in k1)
g_k1 = rdf.loc[rdf.quintile == "k1", "gap_BW_pp"].iloc[0]
g_k5 = rdf.loc[rdf.quintile == "k5", "gap_BW_pp"].iloc[0]
log(f"   Contrast: gap(k5) - gap(k1) = {g_k5 - g_k1:+.2f}pp (positive => gap narrows at high SES)")
# formal test of interaction k1 vs k5
log(f"   Wald test k5-vs-k1 interaction contrast: est={m2.params['C(quin)[T.k5]:Black']:+.3f} (logOR), p = {m2.pvalues['C(quin)[T.k5]:Black']:.4f}")

# ---------------------------------------------------------------- Part C: conditional sensitivity
log("\n" + "#" * 95)
log("MODEL 3 (SENSITIVITY) — logistic: BA ~ SES_std * Black + ASVAB_std + PCT_std")
log("  conditioning on academic resources (ASVAB composite, class percentile) at overall means")
m3 = smf.logit("BA ~ SES_std * Black + ASVAB_std + PCT_std", data=d).fit(disp=0)
log(m3.summary2().tables[1].round(4).to_string())
log(f"\n=> Interaction (SES_std x Black) OR = {np.exp(m3.params['SES_std:Black']):.3f}, p = {m3.pvalues['SES_std:Black']:.4f}")
log("=> Conditional Black-White gap at SES percentiles (covariates at overall mean):")
for q in [0.05, 0.25, 0.5, 0.75, 0.95]:
    new = pd.DataFrame({"SES_std": [df.SES.quantile(q), df.SES.quantile(q)],
                        "Black": [0, 1],
                        "ASVAB_std": [0, 0], "PCT_std": [0, 0]})
    pr = m3.get_prediction(new)
    pp = pr.predicted * 100
    ci = pr.conf_int() * 100
    log(f"  SES p{q*100:g}: White={pp[0]:.2f}% [{ci[0,0]:.2f},{ci[0,1]:.2f}] | "
        f"Black={pp[1]:.2f}% [{ci[1,0]:.2f},{ci[1,1]:.2f}] | gap={pp[1]-pp[0]:+.2f}pp")

# per-quintile conditional Black coefficient (adjusted log-odds gap within stratum)
log("\nPer-quintile conditional (ASVAB+PCT adjusted) Black effect — log-OR & implied pp gap at covariate means")
log("'quin:Black' |")
for q in quincat:
    sub = d2[d2.quin == q].copy()
    try:
        mm = smf.logit("BA ~ Black + ASVAB_std + PCT_std", data=sub).fit(disp=0, maxiter=100)
        b = mm.params["Black"]; se = mm.bse["Black"]
        # implied pp gap at covariate means
        base = pd.DataFrame({"Black": [0, 1], "ASVAB_std": [0, 0], "PCT_std": [0, 0]})
        pr = mm.get_prediction(base)
        pp = pr.predicted * 100
        log(f"  {q}: Black logOR={b:+.2f} (SE={se:.2f}, p={mm.pvalues['Black']:.3f}) | cond gap at means={pp[1]-pp[0]:+.2f}pp")
    except Exception as e:
        log(f"  {q}: nonconvergence -> {str(e)[:60]}")

# ---------------------------------------------------------------- Part D: synthesis
log("\n" + "#" * 95)
log("SYNTHESIS — headline numbers")
# top quintile numbers
t = df[df.quin == "k5"]
bB, wB = t[t.SAMPLE_RACE == "Black"], t[t.SAMPLE_RACE == "White"]
log(f"Top SES quintile (k5): Black {bB.BA.sum()}/{len(bB)} = {bB.BA.mean()*100:.2f}% | "
    f"White {wB.BA.sum()}/{len(wB)} = {wB.BA.mean()*100:.2f}% | gap={bB.BA.mean()*100 - wB.BA.mean()*100:+.2f}pp | ratio={bB.BA.mean()/wB.BA.mean():.2f}")
t2 = df[df.quin == "k1"]
bB2, wB2 = t2[t2.SAMPLE_RACE == "Black"], t2[t2.SAMPLE_RACE == "White"]
log(f"Bottom SES quintile (k1): Black {bB2.BA.sum()}/{len(bB2)} = {bB2.BA.mean()*100:.2f}% | "
    f"White {wB2.BA.sum()}/{len(wB2)} = {wB2.BA.mean()*100:.2f}% | gap={bB2.BA.mean()*100 - wB2.BA.mean()*100:+.2f}pp | ratio={bB2.BA.mean()/wB2.BA.mean():.2f}")
log(f"Gap narrowing bottom->top quintile: {bB2.BA.mean()*100 - wB2.BA.mean()*100:+.2f}pp -> {bB.BA.mean()*100 - wB.BA.mean()*100:+.2f}pp (change {+(bB.BA.mean()*100 - wB.BA.mean()*100) - (bB2.BA.mean()*100 - wB2.BA.mean()*100):+.2f}pp)")

# save
with open("analysis/output_report.txt", "w") as f:
    f.write("\n".join(lines))
print("\n[saved] analysis/output_report.txt")
