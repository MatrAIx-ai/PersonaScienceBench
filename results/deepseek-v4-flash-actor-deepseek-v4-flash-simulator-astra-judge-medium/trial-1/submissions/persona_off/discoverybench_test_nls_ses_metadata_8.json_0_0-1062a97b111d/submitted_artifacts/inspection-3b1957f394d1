"""Inspection of data/nls_ses_processed.csv for the DiscoveryBench question:
'Between which two races is the factor of BA degree completion -0.9568 when compared to the other?'
"""
import pandas as pd
import numpy as np
import statsmodels.api as sm
import warnings
warnings.filterwarnings("ignore")

DATA = "data/nls_ses_processed.csv"
df = pd.read_csv(DATA)

print("=" * 70)
print("1) SCHEMA / ROW COUNT / MISSING")
print("=" * 70)
cols = ["SAMPLE_RACE", "SAMPLE_SEX", "FAMILY SIZE OF SAMPLE",
        "ABILITY: COMPOSITE OF ASVAB SCORE", "BA DEGREE COMPLETED",
        "PERCENTILE IN CLASS", "SES"]
print("shape:", df.shape)
print("columns:", list(df.columns))
for c in cols:
    print(f"  {c}: missing={df[c].isna().sum()} nunique={df[c].nunique()}")

print("\n" + "=" * 70)
print("2) VALUE DISTRIBUTIONS")
print("=" * 70)
print("SAMPLE_RACE:", df["SAMPLE_RACE"].value_counts().to_dict())
print("SAMPLE_SEX :", df["SAMPLE_SEX"].value_counts().to_dict())
print("BA DEGREE COMPLETED:", df["BA DEGREE COMPLETED"].value_counts().to_dict())
ct = pd.crosstab(df["SAMPLE_RACE"], df["BA DEGREE COMPLETED"])
print("\nRace x BA cross-tab:\n", ct)
print("\nBA completion rate by race:")
print((df.assign(BA=df["BA DEGREE COMPLETED"].astype(int))
       .groupby("SAMPLE_RACE")["BA"].mean().sort_values(ascending=False).round(5)))
for c in ["FAMILY SIZE OF SAMPLE", "ABILITY: COMPOSITE OF ASVAB SCORE",
          "PERCENTILE IN CLASS", "SES"]:
    print(f"\n{c}: mean={df[c].mean():.3f} sd={df[c].std():.3f} "
          f"min={df[c].min():.3f} max={df[c].max():.3f}")

print("\n" + "=" * 70)
print("3) RACE COEFFICIENTS FOR BA DEGREE COMPLETION (logistic model)")
print("=" * 70)
d = df.copy()
d["BA"] = d["BA DEGREE COMPLETED"].astype(int)
cats = ["White", "Black", "Hispanic"]
for ref in cats:
    other = [r for r in cats if r != ref]
    dd = d.copy()
    for r in other:
        dd[f"race_{r}"] = (dd["SAMPLE_RACE"] == r).astype(int)
    X = sm.add_constant(dd[[f"race_{r}" for r in other]])
    m = sm.Logit(dd["BA"], X).fit(disp=False)
    print(f"\nReference = {ref}:")
    for r in other:
        coef, p = m.params[f"race_{r}"], m.pvalues[f"race_{r}"]
        print(f"  race_{r:8s} coef={coef:+.4f}  OR={np.exp(coef):.3f}  p={p:.2e}")

print("\n" + "=" * 70)
print("4) CONTEXT / ROBUSTNESS CHECKS (why -0.9568 ~ Black vs White)")
print("=" * 70)
# pooled 'non-White' dummy
d["NONWHITE"] = (d["SAMPLE_RACE"] != "White").astype(int)
d["race_Black"] = (d["SAMPLE_RACE"] == "Black").astype(int)
d["race_Hispanic"] = (d["SAMPLE_RACE"] == "Hispanic").astype(int)
X = sm.add_constant(d[["NONWHITE"]])
m = sm.Logit(d["BA"], X).fit(disp=False)
print(f"BA ~ nonWhite (crude): coef={m.params['NONWHITE']:+.4f} OR={np.exp(m.params['NONWHITE']):.3f}")

# family size <= 4 subsample crude log-OR
sub = d[d["FAMILY SIZE OF SAMPLE"] <= 4]
t = pd.crosstab(sub["SAMPLE_RACE"], sub["BA"])
a, fa = t.loc["Black", 1], t.loc["Black", 0]
b, fb = t.loc["White", 1], t.loc["White", 0]
lor = np.log(a * fb / (fa * b))
print(f"Black vs White log-OR among family size<=4: {lor:+.4f} (OR={a*fb/(fa*b):.3f})")

# SES-only adjustment
X = sm.add_constant(d[["SES", "race_Black", "race_Hispanic"]])
m = sm.Logit(d["BA"], X).fit(disp=False)
print(f"BA ~ race + SES (ref White): Black={m.params['race_Black']:+.4f} Hispanic={m.params['race_Hispanic']:+.4f}")
