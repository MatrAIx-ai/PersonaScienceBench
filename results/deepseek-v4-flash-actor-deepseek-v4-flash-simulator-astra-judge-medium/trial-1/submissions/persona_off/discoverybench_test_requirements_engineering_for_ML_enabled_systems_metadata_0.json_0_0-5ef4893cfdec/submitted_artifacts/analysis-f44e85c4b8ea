"""
Analysis: Which two roles have the highest proportion of association with
requirements in ML-enabled systems?

Dataset: requirements_engineering_for_ML-enabled_systems.csv (276 respondents)
Approach (approved):
  - Q8_ML_Addressing_* role columns are the measure of role<->requirements
    association ('quoted' = associated = 1, 'not quoted' = 0).
  - Rows where ALL 7 Q8 role columns equal '-77' are whole-question NA
    (survey suspended; confirmed via Status cross-tab) -> excluded.
  - Valid denominator n = 194.
  - Per-role proportion = mean(binary indicator); rank; nonparametric
    bootstrap (R=100k) 95% percentile CIs.
  - Diagnostics: rank stability, paired ordering, sensitivity checks.
"""
import pandas as pd
import numpy as np

RNG = np.random.default_rng(20261022)
path = "data/requirements_engineering_for_ML-enabled_systems.csv"
df = pd.read_csv(path)

ROLE_COLS = [
    "Q8_ML_Addressing_Project_Lead",
    "Q8_ML_Addressing_Business_Analyst",
    "Q8_ML_Addressing_Requirement_Engineer",
    "Q8_ML_Addressing_Solution_Architect",
    "Q8_ML_Addressing_Data_Scientist",
    "Q8_ML_Addressing_Developer",
    "Q8_ML_Addressing_Tester",
]
ROLE_NAMES_FULL = {
    "Q8_ML_Addressing_Project_Lead": "Project Lead / Project Manager",
    "Q8_ML_Addressing_Business_Analyst": "Business Analyst",
    "Q8_ML_Addressing_Requirement_Engineer": "Requirements Engineer",
    "Q8_ML_Addressing_Solution_Architect": "Solution Architect",
    "Q8_ML_Addressing_Data_Scientist": "Data Scientist",
    "Q8_ML_Addressing_Developer": "Developer",
    "Q8_ML_Addressing_Tester": "Tester",
    "Q8_ML_Addressing_Others": "Other roles",
}
ROLE_NAMES = {k.replace("Q8_ML_Addressing_", ""): v for k, v in ROLE_NAMES_FULL.items()}

print("=" * 78)
print("STEP 0 - Data basics")
print("=" * 78)
print(f"rows: {len(df)}, unique IDs: {df['ID'].nunique()}, columns: {df.shape[1]}")

# -77 whole-question NA check
is77 = (df[ROLE_COLS] == "-77").all(axis=1)
mixed = ((df[ROLE_COLS] == "-77").any(axis=1)).sum() - is77.sum()
print(f"rows all-'-77' across 7 Q8 role cols: {is77.sum()}; mixed -77/valid rows: {mixed}")
ct = pd.crosstab(df["Status"], is77)
print("\n'-77' (whole-question NA) x Status:\n", ct.to_string())

valid_mask = ~is77
n_valid = int(valid_mask.sum())
print(f"\nvalid (answered) respondents: {n_valid}")

# Build binary indicators
bin_df = df.loc[valid_mask, ROLE_COLS].apply(lambda s: s.eq("quoted").astype(int))
bin_df.columns = [c.replace("Q8_ML_Addressing_", "") for c in bin_df.columns]

print("\n" + "=" * 78)
print("STEP 1 - Point estimates (proportion of respondents quoting each role)")
print("=" * 78)
props = bin_df.mean()
props = props.sort_values(ascending=False)
for c, p in props.items():
    print(f"  {ROLE_NAMES[c]:42s} quoted={int(bin_df[c].sum()):3d}/n={n_valid}  pct={100*p:6.3f}%")

# STEP 2 - Bootstrap
print("\n" + "=" * 78)
print("STEP 2 - Nonparametric bootstrap 95% CIs (R=100,000, resample respondents)")
print("=" * 78)
R = 100_000
X = bin_df.values  # shape (194, 7)
idx = RNG.integers(0, n_valid, size=(R, n_valid))
boot = X[idx].mean(axis=1)  # (R,7)
lows = np.percentile(boot, 2.5, axis=0)
highs = np.percentile(boot, 97.5, axis=0)
means = X.mean(axis=0)
order = np.argsort(-means)
results = []
for i in order:
    col = bin_df.columns[i]
    results.append((col, means[i], lows[i], highs[i]))
    print(f"  {ROLE_NAMES[col]:42s} p={100*means[i]:6.3f}%  CI=[{100*lows[i]:.3f}%, {100*highs[i]:.3f}%]")

# STEP 3 - Rank stability (top-2 membership probability across resamples)
print("\n" + "=" * 78)
print("STEP 3 - Rank stability: P(role in top-2) and P(rank>=k) across resamples")
print("=" * 78)
order_boot = np.argsort(-boot, axis=1)  # (R,7) positions
top2_count = np.zeros(7)
top_all = np.zeros((7, 7))
for r in range(R):
    top2 = order_boot[r, :2]
    top2_count[top2] += 1
    for rank_k in range(1, 7):
        top_all[order_boot[r, :rank_k], rank_k - 1] += 1
for i in order:
    col = bin_df.columns[i]
    p_t2 = top2_count[i] / R
    # cumulative prob of being within top-2, top-3
    p_t3 = top_all[i, 2] / R
    print(f"  {ROLE_NAMES[col]:42s} P(top-2)={p_t2:6.3f}  P(top-3)={p_t3:6.3f}")

# STEP 4 - Paired ordering diagnostic PL vs DS
print("\n" + "=" * 78)
print("STEP 4 - Paired bootstrap ordering: Project_Lead vs Data_Scientist")
print("=" * 78)
i_pl = list(bin_df.columns).index("Project_Lead")
i_ds = list(bin_df.columns).index("Data_Scientist")
p_greater = boot[:, i_pl] > boot[:, i_ds]
p_equal = np.isclose(boot[:, i_pl], boot[:, i_ds])
print(f"  P(Project_Lead > Data_Scientist) = {p_greater.mean():.4f}")
print(f"  P(Data_Scientist > Project_Lead) = {(~p_greater & ~p_equal).mean():.4f}")
print(f"  P(equal)                         = {p_equal.mean():.4f}")

# STEP 5 - Sensitivity checks
print("\n" + "=" * 78)
print("STEP 5 - Sensitivity checks")
print("=" * 78)

# 5a. treat '-77' as 'not quoted' (denominator 276)
sens_a = df[ROLE_COLS].apply(lambda s: s.eq("quoted").astype(int))
pa = sens_a.mean().sort_values(ascending=False)
print("5a. '-77' treated as 'not quoted' (denominator=276):")
for c, p in pa.items():
    print(f"    {ROLE_NAMES[c.replace('Q8_ML_Addressing_','')]:42s} pct={100*p:6.3f}%  quoted={int(sens_a[c].sum())}/276")

# 5b. include Q8_ML_Addressing_Others (catch-all) in ranking, valid n=194
cols_with_others = ROLE_COLS + ["Q8_ML_Addressing_Others"]
valid_o = ~(df[cols_with_others] == "-77").all(axis=1)
print(f"\n5b. Including 'Others' column; rows all-'-77' over 8 cols: {(~valid_o).sum()} "
      f"(valid n={int(valid_o.sum())})")
bino = df.loc[valid_o, cols_with_others].apply(lambda s: s.eq("quoted").astype(int))
pb = bino.mean().sort_values(ascending=False)
for c, p in pb.items():
    nm = ROLE_NAMES[c.replace("Q8_ML_Addressing_", "")] if c != "Q8_ML_Addressing_Others" else "Other roles"
    print(f"    {nm:42s} pct={100*p:6.3f}%")

# 5c. restricted to respondents quoting >=1 role (n=164)
anyq = bin_df.sum(axis=1) > 0
pc = bin_df[anyq].mean().sort_values(ascending=False)
print(f"\n5c. Restricted to respondents who quoted >=1 role (n={int(anyq.sum())}):")
for c, p in pc.items():
    print(f"    {ROLE_NAMES[c]:42s} pct={100*p:6.3f}%")

# STEP 6 - quoted-values reproducibility check
print("\n" + "=" * 78)
print("STEP 6 - Are the question's quoted values reproducible from this data?")
print("=" * 78)
def nearest(target, denoms, nums):
    best = None
    for n in denoms:
        for k in nums:
            d = abs(k / n - target)
            if best is None or d < best[0]:
                best = (d, k, n, k / n)
    return best
denoms = [276, 194, int(anyq.sum())]
nums = sorted(set(bin_df.sum().tolist()) | set(sens_a.sum().tolist()) | {0, 1, 82, 164, 194, 276})
for tgt in [0.61389, 0.496]:
    d, k, n, v = nearest(tgt, denoms, nums)
    print(f"  closest to {tgt}: k={k}, n={n} -> {v:.5f} (|diff|={d:.5f})")
print("\n  Bootstrap CI width at n=194: ~+/-7pp (e.g., PL [43.8,58.2]), "
      "not +/-0.4pp as quoted.")
print("  => quoted numbers (61.389%, 49.6%; CI width ~0.4-0.9pp) are NOT")
print("     reproducible from this dataset under any tested encoding.")

# STEP 7 - summary table for the deliverable
print("\n" + "=" * 78)
print("STEP 7 - FINAL TABLE (deliverable)")
print("=" * 78)
final = pd.DataFrame({
    "Role": [ROLE_NAMES[c] for c, *_ in results],
    "quoted": [int(bin_df[c].sum()) for c, *_ in results],
    "n": n_valid,
    "proportion_pct": [round(100 * m, 3) for _, m, _, _ in results],
    "boot95_CI_pct": [f"[{100*l:.3f}, {100*h:.3f}]" for _, _, l, h in results],
    "P_top2": [round(top2_count[int(x)] / R, 5) for x in np.argsort(-means)],
    "P_top3": [round(top_all[int(x), 2] / R, 5) for x in np.argsort(-means)],
})
print(final.to_string(index=False))
