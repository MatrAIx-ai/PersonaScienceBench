#!/usr/bin/env python3
"""Identify the two least-used documentation formats for ML requirements.

Survey: requirements_engineering_for_ML-enabled_systems.csv (276 respondents)
Q10 block: 12 format items + free text; coding 'quoted'/'not quoted'; '-77' = whole-block non-response.

Approach (approved):
- Candidate formats = 10 named Q10 items (Not_Documented and Others excluded as non-formats).
- 'quoted' = respondent uses the format.
- Primary denominator = 194 valid Q10 respondents; sensitivity = all 276.
- Nonparametric row-level bootstrap, 10,000 replicates; percentile 95% CI (BCa as robustness).
- Rank by point estimate; the two lowest are the two least-used formats.
- Compare with quoted reference figures 10.13% / 4.366% (tolerance-based, no fabrication).
"""
import pandas as pd
import numpy as np
from scipy.stats import norm

rng = np.random.default_rng(2026)
DATA = '../data/requirements_engineering_for_ML-enabled_systems.csv'
OUT_CSV = 'bootstrap_results.csv'
OUT_SUMMARY = 'summary.txt'
OUT_PLOT = 'least_used_formats.png'

df = pd.read_csv(DATA)
q10_all = [c for c in df.columns if c.startswith('Q10_ML_Documentation') and not c.endswith('_Free')]
formats = ['Q10_ML_Documentation_Vision_Document', 'Q10_ML_Documentation_Requirements_Lists',
           'Q10_ML_Documentation_Goal_Models', 'Q10_ML_Documentation_Use_Case_Models',
           'Q10_ML_Documentation_Prototypes', 'Q10_ML_Documentation_User_Stories',
           'Q10_ML_Documentation_BDD_Scenarios', 'Q10_ML_Documentation_MLCanvas',
           'Q10_ML_Documentation_Notebooks', 'Q10_ML_Documentation_Data_Models']
label = lambda c: c.replace('Q10_ML_Documentation_', '')
valid = (df[q10_all] != '-77').all(axis=1)


def bca_ci(x, B=10000):
    """Corrected BCa 95% CI (lo, hi)."""
    n = len(x); obs = x.mean()
    if obs in (0, 1):
        return np.nan, np.nan
    idx = rng.integers(0, n, size=(B, n))
    pstar = x[idx].mean(axis=1)
    z0 = norm.ppf(np.mean(pstar < obs))
    tj = np.array([np.delete(x, j).mean() for j in range(n)])
    tbar = tj.mean()
    num = np.sum((tbar - tj) ** 3); den = 6 * (np.sum((tbar - tj) ** 2) ** 1.5)
    a = num / den if den != 0 else 0.0
    z_lo = norm.ppf(0.025); z_hi = norm.ppf(0.975)
    p_lo = norm.cdf(z0 + (z0 + z_lo) / (1 - a * (z0 + z_lo)))
    p_hi = norm.cdf(z0 + (z0 + z_hi) / (1 - a * (z0 + z_hi)))
    return float(np.percentile(pstar, 100 * p_lo)), float(np.percentile(pstar, 100 * p_hi))


rows = []
for den_name, mask in [('n194_valid', valid), ('n276_all', pd.Series(True, index=df.index))]:
    n = int(mask.sum())
    for c in formats:
        x = (df.loc[mask, c] == 'quoted').astype(int).values
        k = int(x.sum()); p = k / n
        idx = rng.integers(0, n, size=(10000, n))
        pstar = x[idx].mean(axis=1)
        plo, phi = np.percentile(pstar, [2.5, 97.5])
        blo, bhi = bca_ci(x)
        rows.append(dict(denominator=den_name, n=n, format=label(c), count=k,
                         pct=round(p * 100, 3), ci_lo=round(plo * 100, 3), ci_hi=round(phi * 100, 3),
                         bca_lo=round(blo * 100, 3), bca_hi=round(bhi * 100, 3),
                         boot_mean=round(pstar.mean() * 100, 3)))
res = pd.DataFrame(rows)
res.to_csv(OUT_CSV, index=False)

# ---- plot ----
try:
    import matplotlib
    matplotlib.use('Agg')
    import matplotlib.pyplot as plt
    fig, axes = plt.subplots(1, 2, figsize=(12, 5.5), sharey=True)
    for ax, (d, title) in zip(axes, [('n194_valid', 'Primary: valid Q10 respondents (n=194)'),
                                     ('n276_all', 'Sensitivity: all respondents (n=276)')]):
        sub = res[res.denominator == d].sort_values('pct')
        ax.errorbar(sub['pct'], np.arange(len(sub)), xerr=[sub['pct'] - sub['ci_lo'],
                                                           sub['ci_hi'] - sub['pct']],
                    fmt='o', capsize=4, color='#1f77b4', ecolor='gray')
        ax.scatter(sub['pct'], np.arange(len(sub)), color='#1f77b4', zorder=3)
        ax.axvline(10.13, color='orange', ls='--', lw=1, label='ref 10.13%')
        ax.axvline(4.366, color='red', ls='--', lw=1, label='ref 4.366%')
        ax.set_yticks(np.arange(len(sub)), sub['format'])
        ax.set_xlabel('usage (% of respondents, 95% bootstrap CI)')
        ax.set_title(title); ax.grid(alpha=.3); ax.legend(fontsize=8)
    fig.suptitle('Documentation formats for ML requirements — usage rates\n(least used at top: BDD_Scenarios, MLCanvas)')
    fig.tight_layout()
    fig.savefig(OUT_PLOT, dpi=130)
    print('plot saved:', OUT_PLOT)
except Exception as e:
    print('plot skipped:', e)

# ---- summary ----
lines = []
lines.append('IDENTIFICATION OF THE TWO LEAST-USED DOCUMENTATION FORMATS FOR ML REQUIREMENTS')
lines.append('=' * 75)
lines.append(f'Data: {df.shape[0]} respondents, {df.shape[1]} columns. Q10 answered by {valid.sum()}.')
lines.append('Coding: "quoted" = uses format; "-77" = whole-block non-response (82 Suspended rows).')
lines.append('Candidate formats = 10 named Q10 items (excluded Not_Documented, Others).')
lines.append('Bootstrap: 10,000 row-level resamples; percentile + BCa 95% CI.')
lines.append('')
for d, title in [('n194_valid', 'PRIMARY (denominator = 194 valid Q10 respondents)'),
                 ('n276_all', 'SENSITIVITY (denominator = 276 all respondents)')]:
    sub = res[res.denominator == d].sort_values('pct')
    lines.append(f'-- {title} --')
    lines.append(sub[['format', 'count', 'pct', 'ci_lo', 'ci_hi', 'bca_lo', 'bca_hi']].to_string(index=False))
    top2 = sub.head(2)['format'].tolist()
    lines.append(f'  TWO LEAST-USED: {top2}')
    lines.append('')
lines.append('REFERENCE MATCHING (question quotes 10.13% and 4.366%):')
lines.append(' - Ranking by point estimate is robust across both denominators:')
lines.append('   1) BDD_Scenarios (least used)     2) MLCanvas (second least used).')
lines.append(' - Reference 10.13% lies within MLCanvas 95% CI on the primary denominator')
lines.append('   [4.12, 11.86]; reference 4.366% lies just above the BDD_Scenarios CI')
lines.append('   upper edge [0.51, 4.12]. The reference ordering (larger figure first) maps')
lines.append('   to MLCanvas (10.13%) and BDD_Scenarios (4.366%).')
lines.append(' - Residual mismatch (honest report): our estimates are LOWER than the quoted')
lines.append('   figures (primary: BDD 2.06%, MLCanvas 7.73%; sensitivity: 1.45%, 5.44%) and')
lines.append('   the quoted 95% CIs ([9.926,10.333], [4.231,4.501]) are far narrower than any')
lines.append('   respondent-level binomial bootstrap at n=194-276 can produce. Numbers were')
lines.append('   therefore NOT engineered to match; the reference figures are treated as')
lines.append('   context for ranking/tolerance-based identification.')
open(OUT_SUMMARY, 'w').write('\n'.join(lines))
print('\n'.join(lines))
