"""Main estimation (final). See README-style summary at end."""
import pandas as pd
import numpy as np
import statsmodels.api as sm

pd.set_option('display.width', 200)
pd.set_option('display.max_columns', 60)

df = pd.read_csv('data/worldbank_education_gdp.csv')
year_cols = [c for c in df.columns if 'YR' in c]
years = [int(c.split()[0]) for c in year_cols]
rows = []
for _, r in df.iterrows():
    for y, c in zip(years, year_cols):
        rows.append({'group': r['Country Group'], 'code': r['Country Code'],
                     'year': y, 'series': r['Series Code'], 'value': r[c]})
panel = pd.DataFrame(rows)
piv = panel.pivot_table(index=['group', 'code', 'year'], columns='series', values='value').reset_index()
piv.columns.name = None
piv['year'] = piv['year'].astype(int)
piv = piv.sort_values(['group', 'year']).reset_index(drop=True)

EDU, INC, SEC, EXP, LF = 'NY.ADJ.AEDU.GN.ZS', 'NY.GNP.PCAP.KD', 'SE.SEC.ENRR', 'NE.EXP.GNFS.KD.ZG', 'SL.TLF.CACT.ZS'
piv['ln_inc'] = np.log(piv[INC])
piv['is_ssa'] = (piv['group'] == 'Sub-Saharan Africa').astype(int)

def run_ols(sub, label, yvar='ln_inc', extras=(), window=None, dropna_cols=None):
    d = sub.copy()
    if window:
        d = d[(d['year'] >= window[0]) & (d['year'] <= window[1])]
    cols = [EDU] + list(extras)
    keep = [yvar] + cols
    if dropna_cols: keep = keep + list(dropna_cols)
    d = d.dropna(subset=keep).sort_values('year')
    n = len(d)
    if n < (len(cols) + 2):
        print(f"  [{label}] n={n} -> TOO FEW obs, skipped"); return None
    X = sm.add_constant(d[cols].values)
    yv = d[yvar].values
    m = sm.OLS(yv, X).fit(cov_type='HC1')
    print(f"  [{label}] n={n}, window {d['year'].min()}-{d['year'].max()}, R2={m.rsquared:.3f}, df={m.df_resid}")
    for i, c in enumerate(['const'] + cols):
        print(f"      {c:22s} coef={m.params[i]:9.4f}  SE={m.bse[i]:8.4f}  p={m.pvalues[i]:.4f}")
    return m

print("="*80); print("PART C: GROUP-SPECIFIC MODELS"); print("="*80)
run_ols(piv[piv['group']=='Lower middle income'], 'LMC full 1975-2015')
run_ols(piv[piv['group']=='Lower middle income'], 'LMC window 2011-2015', window=(2011,2015))
run_ols(piv[piv['group']=='Sub-Saharan Africa'], 'SSA window 2011-2015', window=(2011,2015))
print("--- with controls (secondary enroll, exports growth, labor force) ---")
run_ols(piv[piv['group']=='Lower middle income'], 'LMC full + controls (sec,exp,lf)', extras=[SEC, EXP, LF], dropna_cols=[SEC,EXP,LF])
run_ols(piv[piv['group']=='Lower middle income'], 'LMC 2011-2015 + sec enroll', extras=[SEC], window=(2011,2015))
run_ols(piv[piv['group']=='Sub-Saharan Africa'], 'SSA 2011-2015 + sec enroll', extras=[SEC], window=(2011,2015))

print("\n"+"="*80); print("PART D: LAGGED EDUCATION EXPENDITURE (delayed returns), LMC full sample"); print("="*80)
lm = piv[piv['group']=='Lower middle income'].dropna(subset=[EDU, INC]).sort_values('year').copy()
for lag in [1,2,5]:
    d = lm.copy(); d['edu_lag'] = lm[EDU].shift(lag)
    d = d.dropna(subset=['ln_inc','edu_lag'])
    X = sm.add_constant(d['edu_lag'].values)
    m = sm.OLS(d['ln_inc'].values, X).fit(cov_type='HC1')
    print(f"  LMC ln_inc on edu(t-{lag}): n={len(d)}, coef={m.params[1]:.4f} (SE {m.bse[1]:.4f}, p={m.pvalues[1]:.4f}), R2={m.rsquared:.3f}")
d = lm.copy(); d['edu_avg5'] = lm[EDU].rolling(5, min_periods=5).mean()
d = d.dropna(subset=['ln_inc','edu_avg5'])
X = sm.add_constant(d['edu_avg5'].values)
m = sm.OLS(d['ln_inc'].values, X).fit(cov_type='HC1')
print(f"  LMC ln_inc on 5-yr avg edu: n={len(d)}, coef={m.params[1]:.4f} (SE {m.bse[1]:.4f}, p={m.pvalues[1]:.4f}), R2={m.rsquared:.3f}")

print("\n"+"="*80); print("PART E: FIRST-DIFFERENCE / AR(1) CHECKS (blunt autocorrelation)"); print("="*80)
lm['d_ln'] = lm['ln_inc'].diff(); lm['d_edu'] = lm[EDU].diff()
lm['edu_lag1'] = lm[EDU].shift(1); lm['ln_lag1'] = lm['ln_inc'].shift(1)
d = lm.dropna(subset=['d_ln','d_edu'])
X = sm.add_constant(d['d_edu'].values)
m = sm.OLS(d['d_ln'].values, X).fit(cov_type='HC1')
print(f"  LMC d_ln_inc ~ d_edu: n={len(d)}, coef={m.params[1]:.4f} (SE {m.bse[1]:.4f}, p={m.pvalues[1]:.3f}), R2={m.rsquared:.3f}")
d2 = lm.dropna(subset=['d_ln','d_edu','edu_lag1'])
Xd = sm.add_constant(d2[['d_edu','edu_lag1']].values)
m2 = sm.OLS(d2['d_ln'].values, Xd).fit(cov_type='HC1')
print(f"  LMC d_ln_inc ~ d_edu + edu(t-1): n={len(d2)}, d_edu={m2.params[1]:.4f} (p={m2.pvalues[1]:.3f}), edu_lag={m2.params[2]:.4f} (p={m2.pvalues[2]:.3f}), R2={m2.rsquared:.3f}")
d3 = lm.dropna(subset=['ln_inc','edu_lag1','ln_lag1'])
Xa = sm.add_constant(d3[['edu_lag1','ln_lag1']].values)
ma = sm.OLS(d3['ln_inc'].values, Xa).fit(cov_type='HC1')
print(f"  LMC ln_inc_t ~ edu(t-1) + ln_inc(t-1) [AR(1)]: n={len(d3)}, edu={ma.params[1]:.4f} (SE {ma.bse[1]:.4f}, p={ma.pvalues[1]:.3f}), rho={ma.params[2]:.4f}, R2={ma.rsquared:.3f}")

ss = piv[piv['group']=='Sub-Saharan Africa'].dropna(subset=[EDU, INC]).sort_values('year').copy()
ss['d_ln'] = ss['ln_inc'].diff(); ss['d_edu'] = ss[EDU].diff()
d = ss.dropna(subset=['d_ln','d_edu'])
if len(d) >= 3:
    X = sm.add_constant(d['d_edu'].values)
    m = sm.OLS(d['d_ln'].values, X).fit(cov_type='HC1')
    print(f"  SSA d_ln_inc ~ d_edu (2012-2015, n={len(d)}): coef={m.params[1]:.4f} (SE {m.bse[1]:.4f}, p={m.pvalues[1]:.3f}), R2={m.rsquared:.3f}")
else:
    print("  SSA first-diff: too few obs for inference")

print("\nALL SECTIONS COMPLETE.")
