"""Exploratory inspection of worldbank_education_gdp.csv (scoping only).
Reports structure, variable mapping, coverage, and key descriptive trends."""
import pandas as pd
import numpy as np

df = pd.read_csv('data/worldbank_education_gdp.csv')
year_cols = [c for c in df.columns if 'YR' in c]
years = [int(c.split()[0]) for c in year_cols]

print("=== STRUCTURE ===")
print("rows, cols:", df.shape)
print("groups:", df['Country Group'].unique().tolist())
print("series per group:")
for _, r in df.iterrows():
    valid = sum(pd.notna(v) for v in r[year_cols])
    print(f"  {r['Country Group'][:20]:20s} {r['Series Code']:18s} valid={valid}/{len(year_cols)}")

# Build long panel
rows_list = []
for _, r in df.iterrows():
    for y, c in zip(years, year_cols):
        rows_list.append({'group': r['Country Group'], 'code': r['Country Code'],
                          'year': y, 'series': r['Series Code'], 'value': r[c]})
panel = pd.DataFrame(rows_list)
piv = panel.pivot_table(index=['group', 'code', 'year'], columns='series', values='value').reset_index()
piv.columns.name = None

print("\n=== COVERAGE of income (GNI pc) ===")
for g in piv['group'].unique():
    inc = piv.loc[piv['group'] == g, ['year', 'NY.GNP.PCAP.KD']].dropna()
    print(f"  {g}: income years {inc['year'].min()}..{inc['year'].max()}, n={len(inc)}")

print("\n=== DESCRIPTIVE: decade-start values for key variables ===")
edu_code = 'NY.ADJ.AEDU.GN.ZS'
for g in piv['group'].unique():
    sub = piv[piv['group'] == g].set_index('year')
    print(f"  --- {g} ---")
    for yy in [1975, 1985, 1995, 2005, 2015]:
        if yy in sub.index:
            edu = sub.at[yy, edu_code]
            inc = sub.at[yy, 'NY.GNP.PCAP.KD']
            print(f"    {yy}: edu_exp(%GNI)={edu:.2f}, GNI_pc={inc:.0f}")
