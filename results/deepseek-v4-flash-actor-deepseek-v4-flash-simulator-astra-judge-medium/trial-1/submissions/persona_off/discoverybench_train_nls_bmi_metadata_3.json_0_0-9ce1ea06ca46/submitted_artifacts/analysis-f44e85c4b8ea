"""
analysis.py -- Age influence on the likelihood of taking more out of savings
than putting in (DISSAVED=1). Approved approach:
logistic regression with quadratic age + covariates; marginal predictions by
age; model-selection + robustness (log-INCOME, BMI exclusions, multinomial).
"""
import numpy as np
import pandas as pd
import statsmodels.api as sm
import statsmodels.formula.api as smf
from scipy import stats

OUT = []

def print_out(*args):
    line = " ".join(str(a) for a in args)
    print(line)
    OUT.append(line)

DF = pd.read_csv('/workspace/data/nls_bmi_processed.csv')
print_out("=" * 90)
print_out("DATA LOAD: nls_bmi_processed.csv | Rows x Cols:",
          DF.shape, "| Missing:", int(DF.isna().sum().sum()))

DF['AGE_c'] = DF['AGE'] - 28.0
DF['AGE2_c'] = (DF['AGE'] - 28.0) ** 2
DF['FEMALE'] = (DF['GENDER'] == 'FEMALE').astype(int)
DF['lgINCOME'] = np.log(DF['INCOME'] + 1.0)

def savings_cat(row):
    if row['DISSAVED'] == 1:
        return 'Dissaved'
    if row['SAMESAVE'] == 1:
        return 'Same'
    return 'SavedMore'
DF['SAVCAT'] = DF.apply(savings_cat, axis=1)

# 1. descriptive rates with Wilson CI -------------------------------------
print_out("=" * 90)
print_out("1. OBSERVED DISSAVED RATE BY AGE (95% Wilson CI)")
def wilson(k, n, z=1.96):
    if n == 0:
        return (np.nan, np.nan)
    p = k / n
    den = 1 + z**2 / n
    cen = (p + z**2 / (2 * n)) / den
    hw = z * np.sqrt(p * (1 - p) / n + z**2 / (4 * n**2)) / den
    return (cen - hw, cen + hw)

rows = []
for a in range(24, 33):
    sub = DF[DF['AGE'] == a]
    k = (sub['DISSAVED'] == 1).sum(); n = len(sub)
    lo, hi = wilson(k, n)
    rows.append((a, n, k, 100 * k / n, 100 * lo, 100 * hi))
t = pd.DataFrame(rows, columns=['AGE', 'N', 'Dissaved', 'rate_pct', 'ci_lo_pct', 'ci_hi_pct'])
print_out(t.round(2).to_string(index=False))
print_out("Overall DISSAVED rate: {:.2f}% ({}/{})".format(
    100 * DF['DISSAVED'].mean(), DF['DISSAVED'].sum(), len(DF)))

# 2. logistic models -------------------------------------------------------
print_out("=" * 90)
print_out("2. LOGISTIC MODELS (dependent = P(DISSAVED=1))")

def fmt_logit(res, name):
    b = res.params; ci = np.asarray(res.conf_int())
    tab = pd.DataFrame({
        'coef': b.round(4), 'OR': np.exp(b).round(4),
        'OR_lo95': np.exp(ci[:, 0]).round(4), 'OR_hi95': np.exp(ci[:, 1]).round(4),
        'se': res.bse.round(4), 'p': res.pvalues.round(4)})
    print_out("\n--- {} ---\nLR p={:.4g} | LogLik={:.3f} | AIC={:.3f} | BIC={:.3f} | N={}".format(
        name, res.llr_pvalue, res.llf, res.aic, res.bic, int(res.nobs)))
    print_out(tab.to_string())
    return res

m_base = smf.logit("DISSAVED ~ FEMALE + INCOME + BLACK + HISPANIC + BMI", data=DF).fit(disp=0)
m_lin = smf.logit("DISSAVED ~ AGE_c + FEMALE + INCOME + BLACK + HISPANIC + BMI", data=DF).fit(disp=0)
m_quad = smf.logit("DISSAVED ~ AGE_c + AGE2_c + FEMALE + INCOME + BLACK + HISPANIC + BMI",
                   data=DF).fit(disp=0)
m_cat = smf.logit("DISSAVED ~ C(AGE) + FEMALE + INCOME + BLACK + HISPANIC + BMI",
                  data=DF).fit(disp=0)

fmt_logit(m_lin, "LINEAR-AGE model")
fmt_logit(m_quad, "QUADRATIC-AGE model (PRIMARY)")
fmt_logit(m_cat, "CATEGORICAL-AGE model (ref=age 24)")

comp = pd.DataFrame({
    'model': ['base (no age)', 'linear age', 'quadratic age', 'categorical age'],
    'LL': [m_base.llf, m_lin.llf, m_quad.llf, m_cat.llf],
    'AIC': [m_base.aic, m_lin.aic, m_quad.aic, m_cat.aic],
    'BIC': [m_base.bic, m_lin.bic, m_quad.bic, m_cat.bic]})
print_out("\n--- Model comparison ---")
print_out(comp.round(3).to_string(index=False))

lr_lin_vs_quad = 2 * (m_quad.llf - m_lin.llf)
p_lr = 1 - stats.chi2.cdf(lr_lin_vs_quad, 1)
lr_base_vs_quad = 2 * (m_quad.llf - m_base.llf)
p_lr2 = 1 - stats.chi2.cdf(lr_base_vs_quad, 2)
print_out("\nLR linear-vs-quadratic: chi2(1) = {:.3f}, p = {:.4g}".format(lr_lin_vs_quad, p_lr))
print_out("LR no-age-vs-quadratic: chi2(2) = {:.3f}, p = {:.4g}".format(lr_base_vs_quad, p_lr2))
print_out("\nCategorical-AGE joint Wald test (all age dummies = 0):")
print_out(m_cat.wald_test_terms(scalar=True).table.round(4).to_string())

age_star = 28.0 + (-m_quad.params['AGE_c'] / (2 * m_quad.params['AGE2_c']))
print_out("\nApprox peak age of quadratic linear predictor: {:.2f}".format(age_star))

# 3. marginal predictions + AME by age (delta method) -----------------------
print_out("=" * 90)
print_out("3. AGE PROFILE: average marginal predicted P(DISSAVED=1) by AGE")
print_out("   (quadratic model, covariates at observed values, delta-method 95% CI)")

beta = m_quad.params; cov = m_quad.cov_params()

def invlogit(x):
    return 1.0 / (1.0 + np.exp(-x))

def build_X(a):
    names = list(beta.index)
    X = pd.DataFrame({
        'Intercept': 1.0,
        'AGE_c': a - 28.0,
        'AGE2_c': (a - 28.0) ** 2,
        'FEMALE': DF['FEMALE'].values,
        'INCOME': DF['INCOME'].values,
        'BLACK': DF['BLACK'].values,
        'HISPANIC': DF['HISPANIC'].values,
        'BMI': DF['BMI'].values}, index=DF.index)
    return X[names].values

def avg_pred_at_age(a):
    Xm = build_X(a)
    lp = Xm @ beta.values
    p = invlogit(lp)
    der = (p * (1 - p))[:, None] * Xm
    D = der.mean(axis=0)
    se = float(np.sqrt(D @ cov.values @ D))
    return float(p.mean()), se

profile_rows = []
for a in range(24, 33):
    phat, se = avg_pred_at_age(a)
    profile_rows.append((a, 100 * phat, 100 * (phat - 1.96 * se), 100 * (phat + 1.96 * se), se))
prof = pd.DataFrame(profile_rows, columns=['AGE', 'pred_pct', 'ci_lo_pct', 'ci_hi_pct', 'se'])
print_out(prof.round(2).to_string(index=False))

print_out("\nASCII profile (each '#' = ~1 pct point):")
for _, r in prof.iterrows():
    bar = int(round(r['pred_pct']))
    print_out("AGE {:>2d} | {:<30s} | {:>4.1f}%  [{} - {}]".format(
        int(r['AGE']), "#" * bar,
        r['pred_pct'], r['ci_lo_pct'], r['ci_hi_pct']))

print_out("\nAverage Marginal Effect of one extra year of AGE (pp change in P):")
for a in range(24, 33):
    Xm = build_X(a)
    lp = Xm @ beta.values; p = invlogit(lp)
    d_age = beta['AGE_c'] + 2 * beta['AGE2_c'] * (a - 28.0)
    ame = float((p * (1 - p) * d_age).mean())
    print_out("  AGE {:>2d}: AME = {:+.4f} (pp {:+.2f})".format(a, ame, 100 * ame))

peak_p = prof['pred_pct'].max(); peak_age = int(prof.loc[prof['pred_pct'].idxmax(), 'AGE'])
a24 = prof.loc[prof['AGE'] == 24, 'pred_pct'].iloc[0]
a30 = prof.loc[prof['AGE'] == 30, 'pred_pct'].iloc[0]
a32 = prof.loc[prof['AGE'] == 32, 'pred_pct'].iloc[0]
print_out("\nPeak predicted prob: {:.2f}% at AGE={}".format(peak_p, peak_age))
print_out("Drop peak->AGE32: {:.2f} pp | peak->AGE30: {:.2f} pp | AGE24->AGE32: {:.2f} pp".format(
    peak_p - a32, peak_p - a30, a24 - a32))

# 4. robustness --------------------------------------------------------------
print_out("=" * 90)
print_out("4. ROBUSTNESS / SENSITIVITY")

m_loginc = smf.logit(
    "DISSAVED ~ AGE_c + AGE2_c + FEMALE + lgINCOME + BLACK + HISPANIC + BMI",
    data=DF).fit(disp=0)
fmt_logit(m_loginc, "SENSITIVITY: log(INCOME+1) instead of INCOME")

for label, mask in [("exclude BMI>60", DF['BMI'] <= 60),
                    ("exclude BMI>99th pct", DF['BMI'] <= DF['BMI'].quantile(0.99)),
                    ("exclude BMI>50", DF['BMI'] <= 50)]:
    sub = DF[mask].copy()
    mm = smf.logit("DISSAVED ~ AGE_c + AGE2_c + FEMALE + INCOME + BLACK + HISPANIC + BMI",
                   data=sub).fit(disp=0)
    b = mm.params; ci = mm.conf_int()
    print_out("\nSENSITIVITY: {} (n={})".format(label, len(sub)))
    print_out("  AGE_c  coef={:+.4f} OR={:.3f} 95%[{:.3f},{:.3f}] p={:.4g}".format(
        b['AGE_c'], np.exp(b['AGE_c']), np.exp(ci.loc['AGE_c', 0]), np.exp(ci.loc['AGE_c', 1]),
        mm.pvalues['AGE_c']))
    print_out("  AGE2_c coef={:+.4f} p={:.4g} | AIC={:.2f}".format(b['AGE2_c'], mm.pvalues['AGE2_c'], mm.aic))

print_out("\n--- Multinomial robustness: SavedMore / Same / Dissaved (ref=Dissaved) ---")
# numeric encoding: 0=SavedMore, 1=Same, 2=Dissaved -> Dissaved is reference
code = {'SavedMore': 0, 'Same': 1, 'Dissaved': 2}
DF['SAVCAT_code'] = DF['SAVCAT'].map(code)
m_mn = smf.mnlogit("SAVCAT_code ~ AGE_c + AGE2_c + FEMALE + INCOME + BLACK + HISPANIC + BMI",
                   data=DF).fit(disp=0)
print_out(m_mn.summary().as_text())

m_mn_lin = smf.mnlogit("SAVCAT_code ~ AGE_c + FEMALE + INCOME + BLACK + HISPANIC + BMI",
                       data=DF).fit(disp=0)
lr_mn = 2 * (m_mn.llf - m_mn_lin.llf)
print_out("\nMultinomial LR quadratic-vs-linear age: chi2(2) = {:.3f}, p = {:.4g}".format(
    lr_mn, 1 - stats.chi2.cdf(lr_mn, 2)))
print_out("\nAverage predicted category probabilities by age from the multinomial model:")
mn_exog_names = m_mn.model.exog_names
ages_list = list(range(24, 33))
cat_names = ['SavedMore', 'Same', 'Dissaved']
cat_prob_rows = []
for a in ages_list:
    Xm = np.column_stack([
        np.ones(len(DF)),
        (a - 28.0) * np.ones(len(DF)),
        ((a - 28.0) ** 2) * np.ones(len(DF)),
        DF['FEMALE'].values, DF['INCOME'].values, DF['BLACK'].values,
        DF['HISPANIC'].values, DF['BMI'].values])
    probs = m_mn.model.predict(m_mn.params, exog=Xm)  # n x 3
    cat_prob_rows.append([a] + list(100.0 * probs.mean(axis=0)))
cp = pd.DataFrame(cat_prob_rows, columns=['AGE'] + cat_names)
print_out(cp.round(2).to_string(index=False))
print_out("(In the multinomial, Dissaved probability is tallest for ages ~25-27 and lowest at 32,\n"
          " corroborating the inverted-U / decline-with-age pattern from the binary model.)")

# 5. key numbers -------------------------------------------------------------
print_out("=" * 90)
print_out("5. KEY NUMBERS FOR FINAL HYPOTHESIS")
print_out("- Overall DISSAVED rate: {:.2f}%".format(100 * DF['DISSAVED'].mean()))
print_out("- Quadratic model: AGE_c coef={:+.4f} (p={:.4g}); AGE2_c coef={:+.4f} (p={:.4g})".format(
    m_quad.params['AGE_c'], m_quad.pvalues['AGE_c'],
    m_quad.params['AGE2_c'], m_quad.pvalues['AGE2_c']))
print_out("- Peak predicted dissaving at AGE={} | predicted range: {:.2f}% to {:.2f}%".format(
    peak_age, prof['pred_pct'].min(), prof['pred_pct'].max()))

with open('/workspace/analysis_output.txt', 'w') as f:
    f.write("\n".join(OUT))
print_out("\n[Saved full output to analysis_output.txt]")
