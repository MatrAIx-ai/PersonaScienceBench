"""NLSY79: Does increased time preference lead to higher BMI?
Validated facts: Height1981 = feet*100+inches; Weight in POUNDS (codebook says kg);
BMI = 703*lb/in^2; only savings(time-preference) wave is 1989; primary outcome BMI1992.
"""
import numpy as np, pandas as pd
import statsmodels.formula.api as smf
import json, warnings
warnings.filterwarnings('ignore')
OUT = {}
df = pd.read_csv('data/nls_raw.csv'); OUT['shape'] = list(df.shape)

ID='ID# (range 1-12686) 1979'; SAM='Sample ID, 1979 (interview)'
RACE='Racial/ethnic cohort, 1979'; SEX='Sex of respondent, 1979'
FAMSZ='Family size, 1979'; MOMED="Highest grade completed by respondent's mother, 1979"
DADED="Highest grade completed by respondent's father, 1979"; GRADE='Highest grade completed, 1979'
OC14='Occupation of adult male in household at age 14, 1979'
H81='Height of respondent, 1981'; H85='Height of respondent, 1985'
W81='Weight of respondent, 1981'; W89='Weight of respondent, 1989'; W92='Weight of respondent, 1992'
INC79='Total net family income, previous calendar year, 1979'
INC85='Total net family income, previous calendar year, 1985'
INC89='Total net family income, previous calendar year, 1989'
WTH85='Family net wealth, 1985'; WTH90='Family net wealth, 1990'
WTH96='Family net wealth, 1996 (key data point)'
DIR='Was more money put into or taken out of R/spouse savings since last interview, 1989'
PIN='Net amount respondent/spouse put into savings since last interview, 1989'
POUT='Net amount respondent/spouse took out of savings since last interview, 1989'
SENT='Ever been sentenced in any correctional institution before 1980'
CONV='Ever convicted of an illegal act in adult court before 1980'
ASV=[c for c in df.columns if c.startswith('ASVAB')]

D=pd.DataFrame(); D['id']=df[ID]; D['samid']=df[SAM]
D['age79']=df['Age of respondent, 1979']; D['age81']=df['Age of respondent at interview date, 1981']
D['age89']=df['Age of respondent at interview date, 1989']
D['male']=(df[SEX]==1).astype(int); D['black']=(df[RACE]==1).astype(int)
D['hispanic']=(df[RACE]==2).astype(int); D['othrace']=(df[RACE]==3).astype(int)
D['famsize']=df[FAMSZ]; D['momed']=df[MOMED]; D['daded']=df[DADED]
D['grade79']=df[GRADE].replace(95,np.nan); D['occ14']=df[OC14]
h81=df[H81]; h81_in=(h81//100)*12+(h81%100)
D['height_in']=df[H85].fillna(h81_in); D['h81_in']=h81_in; D['h85_in']=df[H85]
D['bmi81']=703*df[W81]/D['height_in']**2; D['bmi89']=703*df[W89]/D['height_in']**2
D['bmi92']=703*df[W92]/D['height_in']**2; D['dbmi_89_92']=D['bmi92']-D['bmi89']
for n,c in [('inc79',INC79),('inc85',INC85),('inc89',INC89)]: D['ln'+n]=np.log1p(df[c])
for n,c in [('w85',WTH85),('w90',WTH90),('w96',WTH96)]: D['ah_'+n]=np.arcsinh(df[c])
D['asvab_z']=df[ASV].mean(axis=1); D['asvab_n']=df[ASV].notna().sum(axis=1)
D['sentenced']=df[SENT].fillna(0); D['sent_miss']=df[SENT].isna().astype(int)
D['convicted']=df[CONV].fillna(0); D['conv_miss']=df[CONV].isna().astype(int)
TPMAP={1:'put_more_in',2:'took_out',3:'no_change',4:'no_savings'}
D['tp']=df[DIR]; D['tp_cat']=D['tp'].map(TPMAP)
D['pin']=df[PIN].fillna(0.0); D['pout']=df[POUT].fillna(0.0)
D['net_save']=D['pin']-D['pout']
D['lognet_save']=np.sign(D['net_save'])*np.log1p(np.abs(D['net_save']))
D['highTP']=np.where(D['tp'].isin([2,4]),1,np.where(D['tp'].isin([1,3]),0,np.nan))

OUT['n_total']=int(len(D)); OUT['n_with_dir']=int(D['tp'].notna().sum())
OUT['n_with_bmi92']=int(D['bmi92'].notna().sum())
cccols=['bmi92','tp_cat','age89','male','black','hispanic','famsize','momed','daded','grade79','asvab_z','lninc79','lninc85','lninc89','ah_w85','ah_w90','sentenced','sent_miss']
OUT['n_cc_primary']=int(D[cccols].dropna().shape[0])
OUT['bmi92_outliers']=int((D['bmi92'].notna()&((D['bmi92']<14)|(D['bmi92']>60))).sum())
OUT['weight_gt400_lb']=int((df['Weight of respondent, 1992']>400).sum())
OUT['bmi92_valid']=int((D['bmi92'].between(14,60)).sum())
CONTROLS=['age89','male','black','hispanic','famsize','momed','daded','grade79','asvab_z','lninc79','lninc85','lninc89','ah_w85','ah_w90','sentenced','sent_miss']
def fit(f,data):
    m=smf.ols(f,data=data)
    keep=np.asarray(m.data.row_labels)
    return m.fit(cov_type='cluster',cov_kwds={'groups':D.loc[keep,'samid'].to_numpy()})
def row(res,name,param):
    b=res.params[param]; se=res.bse[param]; ci=res.conf_int().loc[param]; p=res.pvalues[param]
    return {'model':name,'param':param,'n':int(res.nobs),'beta':round(float(b),3),'se':round(float(se),3),'ci95':[round(float(ci[0]),3),round(float(ci[1]),3)],'p':round(float(p),4)}
RESULTS=[]
print("PART1 features built; n_cc_primary=", OUT['n_cc_primary'])

# ------------------ PRIMARY MODEL ------------------
cc=D[['bmi92','tp_cat','highTP','age89']+CONTROLS].dropna(subset=['bmi92','tp_cat']).copy()
cats=['put_more_in','took_out','no_change','no_savings']
cc['tp_cat']=pd.Categorical(cc['tp_cat'],categories=cats)
cc['highTP']=np.where(cc['tp_cat'].isin(['took_out','no_savings']),1,0)
f_primary="bmi92 ~ C(tp_cat, Treatment(reference='put_more_in')) + "+" + ".join(CONTROLS)
r_primary=fit(f_primary,cc); OUT['primary_nobs']=int(r_primary.nobs)
REF="C(tp_cat, Treatment(reference='put_more_in'))"
for cat in ['took_out','no_change','no_savings']:
    RESULTS.append(row(r_primary,'PRIMARY BMI1992 cat(ref=put_more_in)',f'{REF}[T.{cat}]'))
f_head="bmi92 ~ highTP + "+" + ".join(CONTROLS)
r_head=fit(f_head,cc)
OUT['headline']=row(r_head,'HEADLINE BMI1992 (highTP)', 'highTP'); RESULTS.append(row(r_head,'HEADLINE BMI1992 (highTP)','highTP'))
RESULTS.append(row(fit("bmi92 ~ highTP",cc),'UNADJUSTED BMI1992 (highTP)','highTP'))

# ------------------ ROBUSTNESS ------------------
r1=fit("bmi92 ~ highTP + "+" + ".join(CONTROLS),cc[cc['tp_cat'].isin(['put_more_in','took_out'])]); RESULTS.append(row(r1,'R1 savers-vs-drawers','highTP'))
d2=D[['bmi92','lognet_save','tp_cat']+CONTROLS].dropna(subset=['bmi92','lognet_save']).copy()
r2=fit("bmi92 ~ lognet_save + "+" + ".join(CONTROLS),d2); RESULTS.append(row(r2,'R2 log(net savings) signed','lognet_save'))
d3=D[['bmi89','tp_cat','age89']+CONTROLS].dropna(subset=['bmi89','tp_cat']).copy()
d3['tp_cat']=pd.Categorical(d3['tp_cat'],categories=cats); d3['highTP']=np.where(d3['tp_cat'].isin(['took_out','no_savings']),1,0)
RESULTS.append(row(fit("bmi89 ~ highTP + "+" + ".join(CONTROLS),d3),'R3 same-wave BMI1989','highTP'))
d4=D[['dbmi_89_92','tp_cat','age89']+CONTROLS].dropna(subset=['dbmi_89_92','tp_cat']).copy()
d4['tp_cat']=pd.Categorical(d4['tp_cat'],categories=cats); d4['highTP']=np.where(d4['tp_cat'].isin(['took_out','no_savings']),1,0)
RESULTS.append(row(fit("dbmi_89_92 ~ highTP + "+" + ".join(CONTROLS),d4),'R4 dBMI 1989->1992','highTP'))
cc5=cc[D['bmi92'].between(14,60).loc[cc.index]].copy()
r5=fit(f_primary,cc5)
for cat in ['took_out','no_change','no_savings']:
    RESULTS.append(row(r5,'R5 BMI1992 cat(BMI 14-60)',f'{REF}[T.{cat}]'))
cc5['highTP']=np.where(cc5['tp_cat'].isin(['took_out','no_savings']),1,0)
RESULTS.append(row(fit("bmi92 ~ highTP + "+" + ".join(CONTROLS),cc5),'R5b BMI1992 highTP(BMI 14-60)','highTP'))
imp=D.copy(); flagcols=[]
for c in CONTROLS:
    if imp[c].isna().any():
        imp[c+'_miss']=imp[c].isna().astype(int); flagcols.append(c+'_miss'); imp[c]=imp[c].fillna(imp[c].median())
imp['tp_cat']=pd.Categorical(imp['tp_cat'],categories=cats); imp['highTP']=np.where(imp['tp_cat'].isin(['took_out','no_savings']),1,0)
d6=imp[['bmi92','tp_cat','highTP']+CONTROLS+flagcols].dropna(subset=['bmi92','tp_cat'])
f6="bmi92 ~ C(tp_cat, Treatment(reference='put_more_in')) + "+" + ".join(CONTROLS+flagcols)
r6=fit(f6,d6); RESULTS.append({'model':'R6 median-imputed+flags','param':'nobs','n':int(r6.nobs),'beta':None,'se':None,'ci95':None,'p':None})
for cat in ['took_out','no_savings']:
    RESULTS.append(row(r6,'R6 cat med-imputed',f'{REF}[T.{cat}]'))
for sex,lbl in [(0,'FEMALE'),(1,'MALE')]:
    d7=cc[cc['male']==sex].copy()
    RESULTS.append(row(fit("bmi92 ~ highTP + "+" + ".join([c for c in CONTROLS if c!='male']),d7),f'R7 {lbl}','highTP'))
cc8=cc.copy(); cc8['occ14']=D['occ14'].loc[cc.index].fillna(-99)
RESULTS.append(row(fit("bmi92 ~ highTP + occ14 + "+" + ".join(CONTROLS),cc8),'R8 +occ14 control','highTP'))
d9=D[['bmi92','age89']+CONTROLS+['ah_w96']].dropna(subset=['bmi92','ah_w85','ah_w96']).copy()
d9['wealth_acc']=d9['ah_w96']-d9['ah_w85']
ctr9=[c for c in CONTROLS if c not in ('ah_w85','ah_w90')]
RESULTS.append(row(fit("bmi92 ~ wealth_acc + "+" + ".join(ctr9),d9),'R9 wealth-accum proxy','wealth_acc'))
d10=D[['bmi81','tp_cat','age89']+CONTROLS].dropna(subset=['bmi81','tp_cat']).copy()
d10['tp_cat']=pd.Categorical(d10['tp_cat'],categories=cats); d10['highTP']=np.where(d10['tp_cat'].isin(['took_out','no_savings']),1,0)
RESULTS.append(row(fit("bmi81 ~ highTP + "+" + ".join(CONTROLS),d10),'R10 BMI1981 reverse-temporal','highTP'))

desc=cc.groupby('tp_cat',observed=True).agg(n=('bmi92','size'),bmi_mean=('bmi92','mean'),bmi_med=('bmi92','median')).round(2)
OUT['desc_bmi92_by_tp']=desc.reset_index().to_dict('records')
RES_DF=pd.DataFrame(RESULTS)
print("=== RESULT TABLE ===")
print(RES_DF.to_string(index=False))
OUT['main_cat_coefs']=RES_DF[RES_DF['model'].str.startswith('PRIMARY')].to_dict('records')
OUT['headline_summary']={k:round(float(v),4) for k,v in r_head.summary2().tables[1].loc['highTP'].items()}
with open('results_summary.json','w') as fh: json.dump(OUT,fh,indent=2,default=str)
print("\n=== KEY ==="); print("primary_nobs:",OUT['primary_nobs']); print("headline:",OUT['headline'])
print("desc:",OUT['desc_bmi92_by_tp'])
print("saved results_summary.json")
