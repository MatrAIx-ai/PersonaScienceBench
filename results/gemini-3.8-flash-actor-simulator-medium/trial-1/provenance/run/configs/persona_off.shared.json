{
  "schema_version": "0.1",
  "models": {
    "actor": {
      "model": "gcp/google/gemini-3.8-flash",
      "reasoning_effort": "medium",
      "max_tokens": 12288,
      "provider": "nvidia",
      "timeout": 600
    },
    "researcher": {
      "model": "gcp/google/gemini-3.8-flash",
      "reasoning_effort": "medium",
      "max_tokens": 8192,
      "provider": "nvidia",
      "timeout": 600
    },
    "judge": {
      "model": "gpt-6-astra",
      "reasoning_effort": "low",
      "max_tokens": 4096,
      "unsupported_parameters": "omit_and_record",
      "provider": "openai",
      "timeout": 600
    }
  },
  "actor_steps": 60,
  "researcher": {
    "mode": "grounded",
    "max_facts_per_reply": 1,
    "max_questions": 6
  },
  "persona": {
    "enabled": false
  },
  "dollar_cap": null,
  "pilot_cases_per_benchmark": 1,
  "notes": [
    "Frozen 200-question main run: 40 per source, 5 conditions, one episode each."
  ],
  "collaboration": {
    "protocol": "active_researcher",
    "max_requests": 12,
    "unrestricted_knowledge": true,
    "embody_identity": true,
    "volunteer_information": true
  },
  "collect_only": true
}
