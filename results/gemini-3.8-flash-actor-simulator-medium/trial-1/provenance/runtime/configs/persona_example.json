{
  "schema_version": "0.1",
  "models": {
    "actor": {
      "model": "openai/gpt-6-luna",
      "reasoning_effort": "none",
      "max_tokens": 12288
    },
    "researcher": {
      "model": "openai/gpt-6-luna",
      "reasoning_effort": "none",
      "max_tokens": 2048
    },
    "judge": {
      "model": "openai/gpt-6-luna",
      "reasoning_effort": "none",
      "max_tokens": 4096,
      "unsupported_parameters": "omit_and_record"
    }
  },
  "actor_steps": 20,
  "researcher": {
    "mode": "grounded",
    "max_facts_per_reply": 1,
    "max_questions": 6
  },
  "persona": {
    "id": "researcher-persona",
    "version": "2"
  },
  "dollar_cap": null,
  "pilot_cases_per_benchmark": 2,
  "notes": [
    "Example persona configuration; all unspecified settings inherit from deterministic defaults.",
    "Domain routes match exact episode.domain; task routes match the complete episode.id.",
    "Proactive means raising a clarification inside a reply, not initiating autonomous turns."
  ],
  "persona_router": {
    "version": "1",
    "defaults": {
      "role": {
        "title": "researcher",
        "seniority": "senior"
      },
      "expertise": {
        "domain": "task",
        "domain_level": "expert",
        "statistics": "intermediate",
        "coding": "novice"
      },
      "research_style": {
        "approach": "hypothesis_driven",
        "method_preference": "interpretable"
      },
      "evidence": {
        "standard": "rigorous",
        "risk_tolerance": "cautious"
      },
      "communication": {
        "verbosity": "concise",
        "technical_level": "technical",
        "tone": "collaborative"
      },
      "workflow": {
        "priority": "thoroughness",
        "compute_preference": "economical"
      },
      "interaction": {
        "initiative": "proactive",
        "feedback": "challenging"
      }
    },
    "domains": {
      "sociology": {
        "expertise": {
          "statistics": "expert"
        }
      }
    },
    "tasks": {}
  }
}
