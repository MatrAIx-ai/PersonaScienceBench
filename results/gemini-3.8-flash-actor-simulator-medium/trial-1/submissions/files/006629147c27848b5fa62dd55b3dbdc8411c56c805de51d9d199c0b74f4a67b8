import pandas as pd
import numpy as np

# Load datasets
ts = pd.read_csv('data/time_series_data.csv')
cap = pd.read_csv('data/capital.csv')
pol = pd.read_csv('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv')

# Convert numeric columns in capital.csv
num_cols = ['ZAxtSchwert', 'ZDolch', 'Zhausgr', 'ZCU_AU', 'Zamber', 'ZMonument', 'ZHort', 'ZSichel', 'ZBeil', 'ZMW', 'ZKeform', 'Zkeverz']
for col in num_cols:
    cap[col] = pd.to_numeric(cap[col].astype(str).str.replace(',', '.'))

# Focal time window: 2000 BCE to 1100 BCE (CE -2000 to -1100)
sub_ts = ts[(ts['CE'] >= -2000) & (ts['CE'] <= -1100)].copy()
sub_ts['BCE'] = -sub_ts['CE']

# 100-year centennial intervals
bins = [
    (2000, 1900, '20th c. BCE (2000-1900 BCE)'),
    (1900, 1800, '19th c. BCE (1900-1800 BCE)'),
    (1800, 1700, '18th c. BCE (1800-1700 BCE)'),
    (1700, 1600, '17th c. BCE (1700-1600 BCE)'),
    (1600, 1500, '16th c. BCE (1600-1500 BCE)'),
    (1500, 1400, '15th c. BCE (1500-1400 BCE)'),
    (1400, 1300, '14th c. BCE (1400-1300 BCE)'),
    (1300, 1200, '13th c. BCE (1300-1200 BCE)'),
    (1200, 1100, '12th c. BCE (1200-1100 BCE)')
]

results = []
for start, end, label in bins:
    # Use standard inclusive/exclusive or right-closed binning: (end, start]
    slice_df = sub_ts[(sub_ts['BCE'] <= start) & (sub_ts['BCE'] > end)]
    results.append({
        'Century / Interval': label,
        'Mean g_all': slice_df['g_all_mean'].mean(),
        'Max g_all': slice_df['g_all_mean'].max(),
        'Mean KDE': slice_df['kde_all_mean'].mean(),
        'Mean Pollen Growth Rate': slice_df['pollen_grate_100'].mean(),
        'Max Pollen Growth Rate': slice_df['pollen_grate_100'].max(),
        'Mean Pollen Openness': slice_df['pollen_inter_100'].mean()
    })

res_table = pd.DataFrame(results)
print("Centennial Summary Table:")
print(res_table.to_string(index=False))

# Capital breakdown
sub_cap = cap[(cap['BCE'] <= 2000) & (cap['BCE'] >= 1100)].copy()
sub_cap['Symbolic'] = sub_cap[['ZAxtSchwert', 'ZDolch', 'Zhausgr']].mean(axis=1)
sub_cap['Social'] = sub_cap[['ZCU_AU', 'Zamber', 'ZMonument']].mean(axis=1)
sub_cap['Cultural'] = sub_cap[['ZKeform', 'Zkeverz']].mean(axis=1)
sub_cap['Economic'] = sub_cap[['ZHort', 'ZSichel', 'ZBeil', 'ZMW']].mean(axis=1)

print("\nCapital Dimensions across 2000-1100 BCE:")
print(sub_cap[['BCE', 'group', 'Symbolic', 'Social', 'Cultural', 'Economic']].to_string(index=False))

# Save summary to csv
res_table.to_csv('centennial_growth_summary.csv', index=False)
sub_cap[['BCE', 'group', 'Symbolic', 'Social', 'Cultural', 'Economic']].to_csv('capital_summary.csv', index=False)
