import os
import glob
import pandas as pd
import numpy as np

def analyze_chip_variants(data_dir="data/CHIP_DP10_GQ20_PASS"):
    files = sorted(glob.glob(os.path.join(data_dir, "*.xlsx")))
    print(f"Total sample files found: {len(files)}")
    
    results = []
    
    for f in files:
        fname = os.path.basename(f)
        sample_id = fname.replace("230209_Exome_GRCh38_CHIP_", "").replace(".xlsx", "")
        
        # Read header at row 2 (0-indexed header=1)
        df = pd.read_excel(f, header=1)
        
        # Annotation column
        so = df["Sequence Ontology (Combined)"].astype(str)
        
        # Filtering flags
        is_intron = so.str.contains("intron", case=False, na=False)
        is_utr = so.str.contains("utr", case=False, na=False)
        is_intergenic = so.str.contains("intergenic", case=False, na=False)
        is_upstream = so.str.contains("upstream", case=False, na=False)
        
        # Combined exclusion masks
        mask_exclude_strict = is_intron | is_utr | is_intergenic | is_upstream
        mask_exclude_no_upstream = is_intron | is_utr | is_intergenic
        
        # Genotype flags
        is_het = df["Zygosity"] == "Heterozygous"
        is_hom = df["Zygosity"] == "Homozygous Variant"
        is_nonref = is_het | is_hom
        
        # Variant counts
        # 1. Primary: Non-ref variants excluding intron, UTR, intergenic, upstream
        c_primary = int((is_nonref & ~mask_exclude_strict).sum())
        
        # 2. Comparison: Non-ref variants excluding intron, UTR, intergenic (keeping upstream)
        c_no_upstream_filter = int((is_nonref & ~mask_exclude_no_upstream).sum())
        
        # 3. Comparison: Heterozygous only
        c_het_only = int((is_het & ~mask_exclude_strict).sum())
        
        # 4. Comparison: Homozygous only
        c_hom_only = int((is_hom & ~mask_exclude_strict).sum())
        
        # 5. Comparison: All rows in file (including reference alleles)
        c_all_rows = int((~mask_exclude_strict).sum())
        
        # Total unfiltered non-ref
        c_total_nonref = int(is_nonref.sum())
        
        results.append({
            "Sample_ID": sample_id,
            "Primary_CHIP_Variants": c_primary,
            "CHIP_Variants_Keep_Upstream": c_no_upstream_filter,
            "Heterozygous_Only": c_het_only,
            "Homozygous_Only": c_hom_only,
            "All_Rows_Filtered": c_all_rows,
            "Total_NonRef_Unfiltered": c_total_nonref
        })
        
    df_res = pd.DataFrame(results)
    
    # Save detailed per-sample counts
    df_res.to_csv("sample_variant_counts.csv", index=False)
    print("Saved sample_variant_counts.csv")
    
    # Summary stats
    n_samples = len(df_res)
    sum_primary = df_res["Primary_CHIP_Variants"].sum()
    mean_primary = df_res["Primary_CHIP_Variants"].mean()
    
    sum_keep_up = df_res["CHIP_Variants_Keep_Upstream"].sum()
    mean_keep_up = df_res["CHIP_Variants_Keep_Upstream"].mean()
    
    sum_het = df_res["Heterozygous_Only"].sum()
    mean_het = df_res["Heterozygous_Only"].mean()
    
    sum_hom = df_res["Homozygous_Only"].sum()
    mean_hom = df_res["Homozygous_Only"].mean()
    
    sum_all_rows = df_res["All_Rows_Filtered"].sum()
    mean_all_rows = df_res["All_Rows_Filtered"].mean()
    
    print("\n" + "="*60)
    print("ANALYSIS SUMMARY REPORT (N = 86 samples)")
    print("="*60)
    print(f"Primary Filter (Non-ref: Het + Hom; Exclude intron, UTR, intergenic/upstream):")
    print(f"  Total variants: {sum_primary}")
    print(f"  Average per sample: {mean_primary:.4f} (or {sum_primary}/{n_samples} = {mean_primary})")
    print(f"  Range: [{df_res['Primary_CHIP_Variants'].min()}, {df_res['Primary_CHIP_Variants'].max()}], Median: {df_res['Primary_CHIP_Variants'].median()}")
    print("-" * 60)
    print(f"Comparison 1 (Non-ref: Het + Hom; Keeping upstream_gene_variant):")
    print(f"  Total variants: {sum_keep_up}")
    print(f"  Average per sample: {mean_keep_up:.4f} (or {sum_keep_up}/{n_samples} = {mean_keep_up})")
    print("-" * 60)
    print(f"Comparison 2 (Heterozygous only):")
    print(f"  Total variants: {sum_het}")
    print(f"  Average per sample: {mean_het:.4f} (or {sum_het}/{n_samples} = {mean_het})")
    print("-" * 60)
    print(f"Comparison 3 (Homozygous Variant only):")
    print(f"  Total variants: {sum_hom}")
    print(f"  Average per sample: {mean_hom:.4f} (or {sum_hom}/{n_samples} = {mean_hom})")
    print("-" * 60)
    print(f"Comparison 4 (All table rows after ontology filter, including Reference):")
    print(f"  Total rows: {sum_all_rows}")
    print(f"  Average per sample: {mean_all_rows:.4f} (or {sum_all_rows}/{n_samples} = {mean_all_rows})")
    print("="*60)
    
    return mean_primary, df_res

if __name__ == "__main__":
    analyze_chip_variants()
