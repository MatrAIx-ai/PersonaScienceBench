import json
import os
import multiprocessing
import numpy as np
import pandas as pd


def simulate_case(case_params):
    case_id = case_params["case_id"]
    nx = int(case_params["nx"])
    ny = int(case_params["ny"])
    uin = float(case_params["uin"])
    re = float(case_params["re"])
    square_center = case_params["square_center"]
    cx, cy = int(square_center[0]), int(square_center[1])
    square_size = int(case_params["square_size"])
    n_steps = int(case_params["n_steps"])
    warmup_steps = int(case_params["warmup_steps"])
    sample_every = int(case_params["sample_every"])

    # Contract formulas
    nu = uin * square_size / re
    tau_s = 0.5 + 3.0 * nu
    omega_s = 1.0 / tau_s

    # TRT (Two-Relaxation-Time) collision operator
    # Symmetric relaxation time tau_s exactly matches physical kinematic viscosity nu = (tau_s - 0.5)/3.
    # Magic parameter Lambda = 1/4 guarantees optimal boundary accuracy and stability.
    tau_a = 0.5 + 0.25 / (tau_s - 0.5)
    omega_a = 1.0 / tau_a
    c1 = 0.5 * (omega_s + omega_a)
    c2 = 0.5 * (omega_s - omega_a)

    # Lattice directions and weights (D2Q9)
    w = np.array([4/9, 1/9, 1/9, 1/9, 1/9, 1/36, 1/36, 1/36, 1/36], dtype=np.float64)[:, None, None]
    ex = np.array([0, 1, 0, -1,  0, 1, -1, -1,  1], dtype=np.int32)
    ey = np.array([0, 0, 1,  0, -1, 1,  1, -1, -1], dtype=np.int32)
    opp = np.array([0, 3, 4, 1, 2, 7, 8, 5, 6], dtype=np.int32)

    # Solid obstacle mask
    half = square_size // 2
    x_min = max(0, cx - half)
    x_max = min(nx, cx - half + square_size)
    y_min = max(0, cy - half)
    y_max = min(ny, cy - half + square_size)

    solid_mask = np.zeros((ny, nx), dtype=bool)
    solid_mask[y_min:y_max, x_min:x_max] = True

    # Precompute fluid-to-solid boundary masks for half-way bounce-back momentum exchange
    f2s_mask = []
    for i in range(9):
        if i == 0:
            f2s_mask.append(None)
        else:
            mask = (~solid_mask) & np.roll(solid_mask, (-ey[i], -ex[i]), axis=(0, 1))
            f2s_mask.append(mask)

    # Deterministic initial field
    rho = np.ones((ny, nx), dtype=np.float64)
    ux = np.full((ny, nx), uin, dtype=np.float64)
    uy = np.zeros((ny, nx), dtype=np.float64)
    ux[solid_mask] = 0.0

    f = np.zeros((9, ny, nx), dtype=np.float64)
    for i in range(9):
        eu = ex[i] * ux + ey[i] * uy
        u2 = ux**2 + uy**2
        f[i] = w[i, 0, 0] * rho * (1.0 + 3.0 * eu + 4.5 * eu**2 - 1.5 * u2)

    feq = np.empty_like(f)
    f_streamed = np.empty_like(f)

    force_series = []

    for step in range(1, n_steps + 1):
        # Macroscopic variables
        rho = np.sum(f, axis=0)
        ux = (f[1] + f[5] + f[8] - (f[3] + f[6] + f[7])) / rho
        uy = (f[2] + f[5] + f[6] - (f[4] + f[7] + f[8])) / rho
        u2 = ux**2 + uy**2

        # Equilibrium distribution
        for i in range(9):
            eu = ex[i] * ux + ey[i] * uy
            feq[i] = w[i, 0, 0] * rho * (1.0 + 3.0 * eu + 4.5 * eu**2 - 1.5 * u2)

        # TRT collision
        d = f - feq
        f_out = f - c1 * d - c2 * d[opp]

        # Momentum Exchange Algorithm (MEA) force evaluation
        if step >= warmup_steps and (step - warmup_steps) % sample_every == 0:
            fx = 0.0
            fy = 0.0
            for i in range(1, 9):
                fx += 2.0 * ex[i] * np.sum(f_out[i, f2s_mask[i]])
                fy += 2.0 * ey[i] * np.sum(f_out[i, f2s_mask[i]])
            cd = fx / (0.5 * uin**2 * square_size)
            cl = fy / (0.5 * uin**2 * square_size)
            force_series.append((case_id, step, cd, cl))

        # Streaming
        for i in range(9):
            f_streamed[i] = np.roll(f_out[i], (ey[i], ex[i]), axis=(0, 1))

        # Obstacle half-way bounce-back
        for i in range(1, 9):
            f_streamed[opp[i], f2s_mask[i]] = f_out[i, f2s_mask[i]]

        # Free-slip (specular reflection) lateral walls
        # Bottom wall y = 0
        f_streamed[2, 0, :] = f_streamed[4, 0, :]
        f_streamed[5, 0, :] = f_streamed[8, 0, :]
        f_streamed[6, 0, :] = f_streamed[7, 0, :]
        # Top wall y = ny - 1
        f_streamed[4, -1, :] = f_streamed[2, -1, :]
        f_streamed[7, -1, :] = f_streamed[6, -1, :]
        f_streamed[8, -1, :] = f_streamed[5, -1, :]

        # Zou-He velocity inlet at x = 0
        rho_in = (f_streamed[0, :, 0] + f_streamed[2, :, 0] + f_streamed[4, :, 0] + 
                  2.0 * (f_streamed[3, :, 0] + f_streamed[6, :, 0] + f_streamed[7, :, 0])) / (1.0 - uin)
        f_streamed[1, :, 0] = f_streamed[3, :, 0] + (2.0/3.0) * rho_in * uin
        f_streamed[5, :, 0] = f_streamed[7, :, 0] - 0.5 * (f_streamed[2, :, 0] - f_streamed[4, :, 0]) + (1.0/6.0) * rho_in * uin
        f_streamed[8, :, 0] = f_streamed[6, :, 0] + 0.5 * (f_streamed[2, :, 0] - f_streamed[4, :, 0]) + (1.0/6.0) * rho_in * uin

        # Zero-gradient extrapolation outlet at x = nx - 1
        f_streamed[3, :, -1] = f_streamed[3, :, -2]
        f_streamed[6, :, -1] = f_streamed[6, :, -2]
        f_streamed[7, :, -1] = f_streamed[7, :, -2]

        f, f_streamed = f_streamed, f

    # Final macroscopic velocity field
    rho = np.sum(f, axis=0)
    ux = (f[1] + f[5] + f[8] - (f[3] + f[6] + f[7])) / rho
    uy = (f[2] + f[5] + f[6] - (f[4] + f[7] + f[8])) / rho
    # Solid region is a rigid no-slip obstacle
    ux[solid_mask] = 0.0
    uy[solid_mask] = 0.0

    # Centerline velocity profile at y = cy
    centerline_rows = []
    for x_idx in range(nx):
        centerline_rows.append((case_id, x_idx, float(ux[cy, x_idx])))

    # Transverse velocity profile at x_probe = min(nx - 1, cx + 2 * square_size)
    x_probe = min(nx - 1, cx + 2 * square_size)
    transverse_rows = []
    for y_idx in range(ny):
        transverse_rows.append((case_id, x_probe, y_idx, float(ux[y_idx, x_probe]), float(uy[y_idx, x_probe])))

    # Summary statistics
    cd_vals = np.array([pt[2] for pt in force_series])
    cl_vals = np.array([pt[3] for pt in force_series])
    cd_mean = float(np.mean(cd_vals))
    cl_rms = float(np.sqrt(np.mean(cl_vals**2)))

    # Convergence criterion: steady cases reach steady-state (re < 45 and force variation small)
    converged = bool(re < 45.0 and abs(cd_vals[-1] - cd_vals[-10]) < 0.05)

    summary_row = {
        "case_id": case_id,
        "nx": nx,
        "ny": ny,
        "re": re,
        "uin": uin,
        "nu": nu,
        "tau": tau_s,
        "n_steps": n_steps,
        "cd_mean": cd_mean,
        "cl_rms": cl_rms,
        "converged": converged,
    }

    return summary_row, force_series, centerline_rows, transverse_rows


def main():
    input_file = "./data/task_input.json"
    with open(input_file, "r", encoding="utf-8") as fp:
        task_data = json.load(fp)

    cases = task_data["cases"]
    task_id = task_data.get("task_id", "fluid-square-wake-2d-001")
    units = task_data.get("units", "dimensionless")

    num_processes = min(len(cases), os.cpu_count() or 1)
    with multiprocessing.Pool(processes=num_processes) as pool:
        results = pool.map(simulate_case, cases)

    summary_rows = []
    force_series_rows = []
    centerline_rows = []
    transverse_rows = []

    for s_row, f_rows, c_rows, t_rows in results:
        summary_rows.append(s_row)
        force_series_rows.extend(f_rows)
        centerline_rows.extend(c_rows)
        transverse_rows.extend(t_rows)

    os.makedirs("./results", exist_ok=True)

    # 1. fluid_summary.csv
    df_summary = pd.DataFrame(summary_rows)
    cols_summary = ["case_id", "nx", "ny", "re", "uin", "nu", "tau", "n_steps", "cd_mean", "cl_rms", "converged"]
    df_summary = df_summary[cols_summary]
    df_summary.to_csv("./results/fluid_summary.csv", index=False)

    # 2. fluid_force_series.csv
    df_force = pd.DataFrame(force_series_rows, columns=["case_id", "step", "cd", "cl"])
    df_force.to_csv("./results/fluid_force_series.csv", index=False)

    # 3. fluid_centerline.csv
    df_centerline = pd.DataFrame(centerline_rows, columns=["case_id", "x", "u"])
    df_centerline.to_csv("./results/fluid_centerline.csv", index=False)

    # 4. fluid_transverse_profile.csv
    df_transverse = pd.DataFrame(transverse_rows, columns=["case_id", "x_probe", "y", "u", "v"])
    df_transverse.to_csv("./results/fluid_transverse_profile.csv", index=False)

    # 5. fluid_report.json
    cd_mean_avg = float(np.mean(df_summary["cd_mean"]))
    report_data = {
        "task_id": task_id,
        "units": units,
        "cd_mean_avg": cd_mean_avg,
        "method_summary": (
            "D2Q9 lattice Boltzmann simulation with Two-Relaxation-Time (TRT) collision operator, "
            "exact half-way bounce-back obstacle boundary condition, momentum exchange algorithm for force evaluation, "
            "Zou-He velocity inlet, zero-gradient extrapolation outlet, and free-slip lateral walls."
        )
    }
    with open("./results/fluid_report.json", "w", encoding="utf-8") as fp:
        json.dump(report_data, fp, indent=2)

    print("Simulation complete. All deliverables generated successfully.")


if __name__ == "__main__":
    main()
