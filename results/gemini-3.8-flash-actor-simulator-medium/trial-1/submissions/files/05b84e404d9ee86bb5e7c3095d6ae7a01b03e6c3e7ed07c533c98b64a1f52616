#!/usr/bin/env python3
"""
Comprehensive Analysis Script for BixBench bix-14-q3:
"After filtering out reference variant calls and variants located in intronic, intergenic, or UTR regions
how many non-reference exonic variants remain in clonal hematopoiesis (CHIP) genes from the 86 samples analyzed?"

Outputs:
1. Matrix of variant counts across all dimensions (Total Calls vs Unique Variants).
2. Comparison between Zygosity != 'Reference' vs explicit non-reference calls (Heterozygous / Homozygous Variant).
3. Filtering breakdown by Sequence Ontology terms and gene scopes.
"""

import glob
import os
import pandas as pd

def run_analysis():
    data_dir = 'data/CHIP_DP10_GQ20_PASS'
    files = sorted(glob.glob(os.path.join(data_dir, '*.xlsx')))
    print(f"Total sample files: {len(files)}")

    # 1. Load CHIP Genes list
    chip_genes_file = 'data/230214_Schenz_et_al_2022_CHIP_Genes.xlsx'
    chip_genes_df = pd.read_excel(chip_genes_file, header=None)
    chip_genes = set([str(x).strip() for x in chip_genes_df[0].dropna()])
    print(f"Total reference CHIP genes: {len(chip_genes)}")

    # 2. Parse all sample files
    records = []
    for f in files:
        sample_name = os.path.basename(f).replace('.xlsx', '')
        df = pd.read_excel(f, header=[0, 1])

        chr_pos_col = [c for c in df.columns if c[1] == 'Chr:Pos'][0]
        ref_alt_col = [c for c in df.columns if c[1] == 'Ref/Alt'][0]
        gene_col = [c for c in df.columns if c[1] == 'Gene Names'][0]
        so_col = [c for c in df.columns if c[1] == 'Sequence Ontology (Combined)'][0]
        zyg_col = [c for c in df.columns if c[1] == 'Zygosity'][0]
        effect_col = [c for c in df.columns if c[1] == 'Effect (Combined)'][0]

        for _, row in df.iterrows():
            records.append({
                'sample': sample_name,
                'chr_pos': str(row[chr_pos_col]).strip(),
                'ref_alt': str(row[ref_alt_col]).strip(),
                'gene': str(row[gene_col]).strip(),
                'so': str(row[so_col]).strip(),
                'zygosity': row[zyg_col],
                'effect': str(row[effect_col]).strip(),
            })

    df = pd.DataFrame(records)
    print(f"Total raw records parsed across 86 files: {len(df)}")

    # SO Categories
    intronic_utr_intergenic_so = [
        'intron_variant',
        'upstream_gene_variant',
        '3_prime_UTR_variant',
        '5_prime_UTR_variant',
        '5_prime_UTR_premature_start_codon_gain_variant'
    ]

    exonic_so = [
        'missense_variant',
        'synonymous_variant',
        'frameshift_variant',
        'inframe_insertion',
        'inframe_deletion'
    ]

    def match_loose(g):
        parts = [p.strip() for p in g.split(',')]
        return any(p in chip_genes for p in parts)

    def match_strict(g):
        return g in chip_genes

    # Non-ref filtering definitions:
    # Def A: Explicit non-ref (Heterozygous or Homozygous Variant)
    # Def B: Standard pandas != 'Reference' (preserves any uncalled/NaN if present)
    zyg_defs = [
        ("Explicit Non-Ref (Heterozygous / Homozygous Variant)", df['zygosity'].isin(['Heterozygous', 'Homozygous Variant'])),
        ("Pandas != 'Reference' (Excluding 'Reference' strings)", df['zygosity'] != 'Reference')
    ]

    so_subsets = [
        ("Exonic SO only (synonymous, missense, frameshift, inframe)", lambda d: d['so'].isin(exonic_so)),
        ("Exonic + Splice Region (Excluding intronic, intergenic, UTR)", lambda d: ~d['so'].isin(intronic_utr_intergenic_so))
    ]

    gene_scopes = [
        ("All rows in CHIP files (In_CHIP == True)", lambda g: True),
        ("Reference CHIP gene list (loose/composite match)", match_loose),
        ("Reference CHIP gene list (strict exact match)", match_strict)
    ]

    print("\n" + "="*90)
    print("ANALYSIS RESULTS MATRIX")
    print("="*90)

    results_table = []

    for zyg_label, zyg_mask in zyg_defs:
        df_zyg = df[zyg_mask]
        print(f"\n>>> Zygosity Definition: {zyg_label} (Total rows: {len(df_zyg)})")
        for so_label, so_filter in so_subsets:
            df_so = df_zyg[so_filter(df_zyg)]
            print(f"  > SO Definition: {so_label} (Rows: {len(df_so)})")
            for gene_label, gene_filter in gene_scopes:
                df_final = df_so[df_so['gene'].apply(gene_filter)]
                total_calls = len(df_final)
                unique_vars = len(df_final.drop_duplicates(subset=['chr_pos', 'ref_alt']))
                results_table.append({
                    'Zygosity Definition': zyg_label,
                    'SO Definition': so_label,
                    'Gene Scope': gene_label,
                    'Total Calls': total_calls,
                    'Unique Variants': unique_vars
                })
                print(f"    - {gene_label:50s} | Total Calls: {total_calls:5d} | Unique Variants: {unique_vars:4d}")

    df_results = pd.DataFrame(results_table)
    df_results.to_csv('variant_counts_summary.csv', index=False)
    print("\nSummary saved to variant_counts_summary.csv")

if __name__ == '__main__':
    run_analysis()
