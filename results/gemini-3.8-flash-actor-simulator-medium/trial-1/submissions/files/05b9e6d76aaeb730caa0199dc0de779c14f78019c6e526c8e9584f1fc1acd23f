import sys
import os
import struct
import numpy as np
import pandas as pd
from scipy import stats

# Add system packages if needed to import olefile
if '/usr/lib/python3/dist-packages' not in sys.path:
    sys.path.append('/usr/lib/python3/dist-packages')
import olefile

def parse_xls_sheet(xls_path):
    ole = olefile.OleFileIO(xls_path)
    stream = ole.openstream('Workbook').read()

    pos = 0
    sst_data = None
    records = []
    while pos < len(stream):
        rec_type, rec_len = struct.unpack('<HH', stream[pos:pos+4])
        pos += 4
        data = stream[pos:pos+rec_len]
        pos += rec_len
        records.append((rec_type, data))
        if rec_type == 0x00FC:
            sst_data = data

    if sst_data is None:
        raise ValueError("SST record not found in XLS stream.")

    total, unique = struct.unpack('<II', sst_data[:8])
    p = 8
    strings = []
    for _ in range(unique):
        cch = struct.unpack('<H', sst_data[p:p+2])[0]
        flags = sst_data[p+2]
        p += 3
        f_high_byte = flags & 0x01
        f_ext_st = flags & 0x04
        f_rich_st = flags & 0x08
        crun = 0
        if f_rich_st:
            crun = struct.unpack('<H', sst_data[p:p+2])[0]
            p += 2
        cb_ext = 0
        if f_ext_st:
            cb_ext = struct.unpack('<I', sst_data[p:p+4])[0]
            p += 4
        if f_high_byte:
            s = sst_data[p:p+cch*2].decode('utf-16le', errors='replace')
            p += cch*2
        else:
            s = sst_data[p:p+cch].decode('latin1', errors='replace')
            p += cch
        p += crun * 4
        p += cb_ext
        strings.append(s)

    cells = {}
    for rec_type, data in records:
        if rec_type == 0x00FD:  # LABELSST
            r, c, xf, sst_idx = struct.unpack('<HHHI', data[:10])
            cells[(r, c)] = strings[sst_idx]
        elif rec_type == 0x0203:  # NUMBER
            r, c, xf = struct.unpack('<HHH', data[:6])
            val = struct.unpack('<d', data[6:14])[0]
            cells[(r, c)] = val

    max_r = max(r for r, c in cells.keys())
    max_c = max(c for r, c in cells.keys())

    header = [cells.get((1, c), f"Col_{c}") for c in range(max_c + 1)]
    sample_names = header[1:21]

    mirna_names = []
    ct_data = []

    for r in range(2, max_r + 1):
        mirna = cells.get((r, 0))
        mirna_names.append(mirna)
        row_vals = []
        for c in range(1, 21):
            val = cells.get((r, c))
            if isinstance(val, (int, float)):
                row_vals.append(float(val))
            else:
                row_vals.append(np.nan)
        ct_data.append(row_vals)

    ct_df = pd.DataFrame(ct_data, index=mirna_names, columns=sample_names)
    return ct_df

def run_analysis():
    xls_path = 'data/pone.0150501.s002.xls'
    df_ct = parse_xls_sheet(xls_path)
    total_mirnas = len(df_ct)
    print(f"Total miRNAs analyzed: {total_mirnas}")
    print(f"Patient samples: {list(df_ct.columns[:10])}")
    print(f"Control samples: {list(df_ct.columns[10:])}")

    # 1. Global mean normalization: delta Ct = Ct - sample_mean(Ct)
    sample_means = df_ct.mean(axis=0, skipna=True)
    df_deltact = df_ct.subtract(sample_means, axis=1)

    patient_cols = df_ct.columns[:10]
    control_cols = df_ct.columns[10:]

    results = []
    for mirna in df_ct.index:
        p_norm = df_deltact.loc[mirna, patient_cols].dropna().values
        c_norm = df_deltact.loc[mirna, control_cols].dropna().values

        p_raw = df_ct.loc[mirna, patient_cols].dropna().values
        c_raw = df_ct.loc[mirna, control_cols].dropna().values

        # Normalized t-tests
        t_stat_norm, p_val_norm = stats.ttest_ind(p_norm, c_norm, equal_var=True)
        t_stat_welch_norm, p_val_welch_norm = stats.ttest_ind(p_norm, c_norm, equal_var=False)
        mw_stat_norm, p_val_mw_norm = stats.mannwhitneyu(p_norm, c_norm, alternative='two-sided')

        # Raw t-tests
        t_stat_raw, p_val_raw = stats.ttest_ind(p_raw, c_raw, equal_var=True)
        t_stat_welch_raw, p_val_welch_raw = stats.ttest_ind(p_raw, c_raw, equal_var=False)

        results.append({
            'miRNA': mirna,
            'mean_patient_deltaCt': np.mean(p_norm),
            'mean_control_deltaCt': np.mean(c_norm),
            'delta_deltaCt': np.mean(p_norm) - np.mean(c_norm),
            'p_val_student_norm': p_val_norm,
            'p_val_welch_norm': p_val_welch_norm,
            'p_val_mw_norm': p_val_mw_norm,
            'p_val_student_raw': p_val_raw,
            'p_val_welch_raw': p_val_welch_raw
        })

    res_df = pd.DataFrame(results)
    res_df.to_csv('differential_expression_results.csv', index=False)

    sig_student_norm = (res_df['p_val_student_norm'] < 0.05).sum()
    pct_student_norm = (sig_student_norm / total_mirnas) * 100.0

    sig_welch_norm = (res_df['p_val_welch_norm'] < 0.05).sum()
    pct_welch_norm = (sig_welch_norm / total_mirnas) * 100.0

    sig_mw_norm = (res_df['p_val_mw_norm'] < 0.05).sum()
    pct_mw_norm = (sig_mw_norm / total_mirnas) * 100.0

    sig_student_raw = (res_df['p_val_student_raw'] < 0.05).sum()
    pct_student_raw = (sig_student_raw / total_mirnas) * 100.0

    sig_welch_raw = (res_df['p_val_welch_raw'] < 0.05).sum()
    pct_welch_raw = (sig_welch_raw / total_mirnas) * 100.0

    print("\n--- Summary of Results (Threshold: p < 0.05 before multiple testing correction) ---")
    print(f"Global mean normalized Delta Ct (Student's t-test): {sig_student_norm} / {total_mirnas} ({pct_student_norm:.2f}%)")
    print(f"Global mean normalized Delta Ct (Welch's t-test):   {sig_welch_norm} / {total_mirnas} ({pct_welch_norm:.2f}%)")
    print(f"Global mean normalized Delta Ct (Mann-Whitney U):   {sig_mw_norm} / {total_mirnas} ({pct_mw_norm:.2f}%)")
    print(f"Raw Ct (Student's t-test):                          {sig_student_raw} / {total_mirnas} ({pct_student_raw:.2f}%)")
    print(f"Raw Ct (Welch's t-test):                            {sig_welch_raw} / {total_mirnas} ({pct_welch_raw:.2f}%)")

    return pct_student_norm

if __name__ == '__main__':
    run_analysis()
