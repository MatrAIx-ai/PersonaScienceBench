import pandas as pd

def analyze_ee_uk_proportion():
    # Load dataset
    filepath = 'data/meta-regression_study_data_heterogeneity_in_replication_projects.csv'
    df = pd.read_csv(filepath)
    
    # Filter for Experimental Economics project
    ee_df = df[df['project'] == 'ee']
    total_ee = len(ee_df)
    
    # Filter for United Kingdom in original studies
    uk_ee = ee_df[ee_df['experiment_country.o'] == 'United Kingdom']
    uk_count = len(uk_ee)
    
    proportion = uk_count / total_ee
    percentage = proportion * 100
    
    print(f"Total Experimental Economics original studies: {total_ee}")
    print(f"Original studies conducted in the United Kingdom: {uk_count}")
    print(f"Proportion: {proportion:.6f} ({uk_count}/{total_ee})")
    print(f"Percentage: {percentage:.2f}%")
    print("\nStudy details:")
    for idx, row in uk_ee.iterrows():
        print(f"ID: {row['id']}, Title: {row['title']}, Authors: {row['authors.o']}, Year: {row['pub_year']}")

if __name__ == '__main__':
    analyze_ee_uk_proportion()
