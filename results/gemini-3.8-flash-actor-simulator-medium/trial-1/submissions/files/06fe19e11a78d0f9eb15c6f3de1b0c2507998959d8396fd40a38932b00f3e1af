import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf

def main():
    # Load dataset
    df_raw = pd.read_excel('data/data.xlsx')
    
    # Filter valid patient records (Sequence number 1 to 80)
    df = df_raw[df_raw['Sequence number'].notna()].copy()
    
    # Preprocess columns
    df['Age'] = pd.to_numeric(df['Age'], errors='coerce')
    df['BMI'] = pd.to_numeric(df['BMI'], errors='coerce')
    df['remission'] = (df['Efficacy'] == 'PR').astype(int)
    
    # Fit logistic regression model
    model = smf.logit('remission ~ Age + BMI + C(Gender)', data=df).fit()
    
    print(model.summary())
    
    age_coef = model.params['Age']
    age_se = model.bse['Age']
    age_pval = model.pvalues['Age']
    ci_lower, ci_upper = model.conf_int().loc['Age']
    
    print("\nResults for Age:")
    print(f"Coefficient (change in log-odds per year): {age_coef:.6f}")
    print(f"Standard Error: {age_se:.6f}")
    print(f"p-value: {age_pval:.6e}")
    print(f"95% CI: [{ci_lower:.6f}, {ci_upper:.6f}]")
    print(f"Odds Ratio: {np.exp(age_coef):.6f} (95% CI: [{np.exp(ci_lower):.6f}, {np.exp(ci_upper):.6f}])")

if __name__ == '__main__':
    main()
