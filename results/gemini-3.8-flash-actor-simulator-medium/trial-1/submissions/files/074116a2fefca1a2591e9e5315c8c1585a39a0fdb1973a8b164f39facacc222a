import pandas as pd
import numpy as np
from scipy import stats

def run_analysis():
    df = pd.read_csv('data/nls_incarceration_processed.csv')
    whites = df[df['race'] == 'white'].copy()
    
    def gini(x):
        x = np.sort(x)
        n = len(x)
        diffsum = np.sum(np.abs(x[:, None] - x[None, :]))
        return diffsum / (2 * n * np.sum(x))

    results = {}
    for year in [1990, 1996]:
        col = f'composite_wealth_{year}'
        wm = whites[whites['sex'] == 'male'][col].values
        wf = whites[whites['sex'] == 'female'][col].values
        results[year] = {
            'male': {
                'count': len(wm),
                'mean': float(np.mean(wm)),
                'median': float(np.median(wm)),
                'std': float(np.std(wm, ddof=1)),
                'p25': float(np.percentile(wm, 25)),
                'p75': float(np.percentile(wm, 75)),
                'p90': float(np.percentile(wm, 90)),
                'p95': float(np.percentile(wm, 95)),
                'iqr': float(np.percentile(wm, 75) - np.percentile(wm, 25)),
                'p90_p50': float(np.percentile(wm, 90) - np.median(wm)),
                'top10_share': float(np.sum(wm[wm >= np.percentile(wm, 90)]) / np.sum(wm)),
                'top5_share': float(np.sum(wm[wm >= np.percentile(wm, 95)]) / np.sum(wm)),
                'zero_or_neg_pct': float(np.mean(wm <= 0) * 100),
                'gini': float(gini(wm))
            },
            'female': {
                'count': len(wf),
                'mean': float(np.mean(wf)),
                'median': float(np.median(wf)),
                'std': float(np.std(wf, ddof=1)),
                'p25': float(np.percentile(wf, 25)),
                'p75': float(np.percentile(wf, 75)),
                'p90': float(np.percentile(wf, 90)),
                'p95': float(np.percentile(wf, 95)),
                'iqr': float(np.percentile(wf, 75) - np.percentile(wf, 25)),
                'p90_p50': float(np.percentile(wf, 90) - np.median(wf)),
                'top10_share': float(np.sum(wf[wf >= np.percentile(wf, 90)]) / np.sum(wf)),
                'top5_share': float(np.sum(wf[wf >= np.percentile(wf, 95)]) / np.sum(wf)),
                'zero_or_neg_pct': float(np.mean(wf <= 0) * 100),
                'gini': float(gini(wf))
            }
        }
    return results

if __name__ == '__main__':
    res = run_analysis()
    import json
    print(json.dumps(res, indent=2))
