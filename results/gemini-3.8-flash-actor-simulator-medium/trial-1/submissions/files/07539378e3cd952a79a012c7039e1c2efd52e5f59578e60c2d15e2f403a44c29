"""
Analysis of the prevalence of non-native plants introduced via gardening across habitat types.
"""
import pandas as pd
import numpy as np
from scipy import stats
import statsmodels.api as sm
import statsmodels.formula.api as smf
from itertools import combinations

# 1. Load data
df = pd.read_csv('data/invaded_niche_pathways.csv', sep='\t')

# 2. Descriptive statistics by habitat
summary = df.groupby('habitat').agg(
    n_plots=('n.gard', 'count'),
    mean_gard=('n.gard', 'mean'),
    std_gard=('n.gard', 'std'),
    median_gard=('n.gard', 'median'),
    sum_gard=('n.gard', 'sum'),
    occupied_plots=('n.gard', lambda x: (x > 0).sum()),
    prop_occupied=('n.gard', lambda x: (x > 0).mean()),
    mean_total_invaders=('n.total', 'mean'),
    sum_total_invaders=('n.total', 'sum')
).reset_index()

summary['prop_gard_of_total_invaders'] = summary['sum_gard'] / summary['sum_total_invaders']
summary = summary.sort_values(by='mean_gard', ascending=False)
summary.to_csv('habitat_gardening_summary.csv', index=False)

# 3. Non-parametric omnibus test
groups = [group['n.gard'].values for name, group in df.groupby('habitat')]
kw_stat, kw_p = stats.kruskal(*groups)

# 4. Chi-square test of presence/absence
contingency = pd.crosstab(df['habitat'], df['n.gard'] > 0)
chi2_stat, chi2_p, dof, _ = stats.chi2_contingency(contingency)

# 5. Pairwise Mann-Whitney U tests with FDR correction
habitats = df['habitat'].unique()
pairwise = []
for h1, h2 in combinations(habitats, 2):
    g1 = df[df['habitat'] == h1]['n.gard']
    g2 = df[df['habitat'] == h2]['n.gard']
    u, p = stats.mannwhitneyu(g1, g2, alternative='two-sided')
    pairwise.append({'h1': h1, 'h2': h2, 'u_stat': u, 'p_val': p})
pw_df = pd.DataFrame(pairwise)
pw_df['p_adj_fdr'] = sm.stats.multipletests(pw_df['p_val'], method='fdr_bh')[1]
pw_df.to_csv('pairwise_comparisons.csv', index=False)

# 6. Generalized Linear Models
df_clean = df.copy()
df_clean.columns = [c.replace('.', '_') for c in df_clean.columns]
glm_poisson = smf.glm('n_gard ~ C(habitat)', data=df_clean, family=sm.families.Poisson()).fit(cov_type='HC0')

print(f"Kruskal-Wallis: H = {kw_stat:.4f}, p = {kw_p:.4e}")
print(f"Chi-square: Chi2 = {chi2_stat:.4f}, p = {chi2_p:.4e}")
print("\nHabitat Summary:")
print(summary.to_string(index=False))
