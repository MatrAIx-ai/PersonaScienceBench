import pandas as pd
import numpy as np
from scipy import stats

def main():
    df = pd.read_csv('data/nls_raw.csv')
    race_col = 'Racial/ethnic cohort, 1979'
    wealth_cols = {
        1985: 'Family net wealth, 1985',
        1990: 'Family net wealth, 1990',
        1996: 'Family net wealth, 1996 (key data point)'
    }
    race_map = {1: 'Black', 2: 'Hispanic', 3: 'White (Non-Black Non-Hispanic)'}
    df['Race'] = df[race_col].map(race_map)

    print("=== Cross-Sectional Analysis ===")
    for yr, col in wealth_cols.items():
        print(f"\nYear {yr}:")
        for r in ['White (Non-Black Non-Hispanic)', 'Black', 'Hispanic']:
            vals = df[df['Race'] == r][col].dropna()
            print(f"  {r}: N={len(vals)}, Median={vals.median():,.2f}, IQR=[{vals.quantile(0.25):,.2f}, {vals.quantile(0.75):,.2f}], Mean={vals.mean():,.2f}")

    print("\n=== Balanced Panel Analysis (N=5,739) ===")
    bal = df.dropna(subset=list(wealth_cols.values()))
    for yr, col in wealth_cols.items():
        print(f"\nYear {yr}:")
        for r in ['White (Non-Black Non-Hispanic)', 'Black', 'Hispanic']:
            vals = bal[bal['Race'] == r][col]
            print(f"  {r}: N={len(vals)}, Median={vals.median():,.2f}, IQR=[{vals.quantile(0.25):,.2f}, {vals.quantile(0.75):,.2f}], Mean={vals.mean():,.2f}")

if __name__ == '__main__':
    main()
