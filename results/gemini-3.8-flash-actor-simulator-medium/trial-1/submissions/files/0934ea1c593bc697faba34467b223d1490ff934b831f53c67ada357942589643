import pandas as pd
import numpy as np

# Load capital data
cap = pd.read_csv('data/capital.csv')
for col in cap.columns:
    if col not in ['group', 'color']:
        cap[col] = cap[col].astype(str).str.replace(',', '.').astype(float)

# Filter 3400 BCE - 3000 BCE
cap_sub = cap[(cap['BCE'] <= 3400) & (cap['BCE'] >= 3000)].sort_values('BCE', ascending=False)
cap_sub['SymbolicCapital_mean'] = cap_sub[['ZAxtSchwert', 'ZDolch', 'Zhausgr']].mean(axis=1)

print("=== DISCRETE CENTURY DATA (capital.csv) ===")
print(cap_sub[['BCE', 'ZMonument', 'ZBeil', 'ZAxtSchwert', 'ZDolch', 'Zhausgr', 'SymbolicCapital_mean']])

print("\n=== CORRELATION MATRIX (capital.csv) ===")
print(cap_sub[['ZMonument', 'ZBeil', 'ZAxtSchwert', 'ZDolch', 'Zhausgr', 'SymbolicCapital_mean']].corr())

# Load continuous time series data
ts = pd.read_csv('data/time_series_data.csv')
ts_sub = ts[(ts['CE'] >= -3400) & (ts['CE'] <= -3000)].copy()
ts_sub['SymbolicCapital_mean'] = ts_sub[['HatchetSword_inter', 'Dagger_inter', 'HouseSize_inter']].mean(axis=1)

print("\n=== CONTINUOUS DATA (time_series_data.csv) ===")
print("Summary at 50-year steps:")
print(ts_sub[['CE', 'MonumentCount_inter', 'AxesCelts_inter', 'HatchetSword_inter', 'Dagger_inter', 'HouseSize_inter', 'SymbolicCapital_mean']].iloc[::50])

print("\n=== CORRELATION MATRIX (time_series_data.csv) ===")
print(ts_sub[['MonumentCount_inter', 'AxesCelts_inter', 'HatchetSword_inter', 'Dagger_inter', 'HouseSize_inter', 'SymbolicCapital_mean']].corr())
