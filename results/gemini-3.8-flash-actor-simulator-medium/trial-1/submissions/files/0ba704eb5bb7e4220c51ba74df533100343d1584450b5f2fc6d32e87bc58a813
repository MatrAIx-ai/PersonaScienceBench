import os
import pandas as pd
import numpy as np

def main():
    excel_path = 'data/Data_deposition_RNAseq_Paroxetine_2017.xlsx'
    print(f"Loading data from {excel_path}...")
    
    # Read mapping metadata
    df_meta = pd.read_excel(excel_path, sheet_name='Mapping_statistics')
    print("Metadata sample counts:")
    print(pd.crosstab(df_meta['Tissue'], df_meta['Response']))
    
    # Read NormCount sheet with header starting at row 3 (0-indexed)
    df_counts = pd.read_excel(excel_path, sheet_name='NormCount', header=3)
    
    # Comparisons corresponding to Bad Responders vs Controls:
    # Baseline blood: Comparison 2 (Col 107 start)
    # Dentate gyrus: Comparison 5 (Col 134 start)
    # Final blood: Comparison 8 (Col 161 start)
    comparisons = {
        'baseline_blood': {'comp_num': 2, 'start_col': 107},
        'dentate_gyrus': {'comp_num': 5, 'start_col': 134},
        'final_blood': {'comp_num': 8, 'start_col': 161}
    }
    
    results = []
    
    for tissue, info in comparisons.items():
        sc = info['start_col']
        c_num = info['comp_num']
        
        baseMean = pd.to_numeric(df_counts.iloc[:, sc], errors='coerce')
        baseMeanA = pd.to_numeric(df_counts.iloc[:, sc+1], errors='coerce')
        baseMeanB = pd.to_numeric(df_counts.iloc[:, sc+2], errors='coerce')
        fc = pd.to_numeric(df_counts.iloc[:, sc+3], errors='coerce')
        lfc = pd.to_numeric(df_counts.iloc[:, sc+4], errors='coerce')
        pval = pd.to_numeric(df_counts.iloc[:, sc+5], errors='coerce')
        padj = pd.to_numeric(df_counts.iloc[:, sc+6], errors='coerce')
        deg_max = df_counts.iloc[:, sc+7]
        deg_med = df_counts.iloc[:, sc+8]
        
        # Standard filter conditions
        # 1. Base criteria: baseMean > 10
        bm_mask = baseMean > 10
        
        # Significant padj < 0.05
        padj_mask = padj < 0.05
        
        # Significant pval < 0.05
        pval_mask = pval < 0.05
        
        # Directional: lfc > 0.5
        pos_lfc = lfc > 0.5
        
        # Absolute: |lfc| > 0.5
        abs_lfc = lfc.abs() > 0.5
        
        res = {
            'Tissue': tissue,
            'Comparison': f"Comparison {c_num} (bad vs ctrl)",
            'Author_DEG_Max': (deg_max.isin(['U', 'D'])).sum(),
            'Author_DEG_Median': (deg_med.isin(['U', 'D'])).sum(),
            'padj<0.05 & lfc>0.5 & bm>10 (Directional)': (padj_mask & pos_lfc & bm_mask).sum(),
            'padj<0.05 & |lfc|>0.5 & bm>10 (Bidirectional)': (padj_mask & abs_lfc & bm_mask).sum(),
            'pval<0.05 & lfc>0.5 & bm>10 (Directional)': (pval_mask & pos_lfc & bm_mask).sum(),
            'pval<0.05 & |lfc|>0.5 & bm>10 (Bidirectional)': (pval_mask & abs_lfc & bm_mask).sum(),
            'lfc>0.5 & bm>10 (no p-filter)': (pos_lfc & bm_mask).sum(),
            '|lfc|>0.5 & bm>10 (no p-filter)': (abs_lfc & bm_mask).sum()
        }
        results.append(res)
        
    df_res = pd.DataFrame(results)
    print("\n" + "="*80)
    print("DIFFERENTIAL EXPRESSION SUMMARY: BAD RESPONDERS VS CONTROLS")
    print("="*80)
    print(df_res.to_string(index=False))
    
    # Identify the tissue with highest counts
    print("\n" + "="*80)
    print("RANKINGS BY TISSUE:")
    for col in df_res.columns[2:]:
        max_tissue = df_res.loc[df_res[col].idxmax(), 'Tissue']
        max_val = df_res[col].max()
        print(f"  {col}: {max_tissue} ({max_val})")
    print("="*80)

if __name__ == '__main__':
    main()
