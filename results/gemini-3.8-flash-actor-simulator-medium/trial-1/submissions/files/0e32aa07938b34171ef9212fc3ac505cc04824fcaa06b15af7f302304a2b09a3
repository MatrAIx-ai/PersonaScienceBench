import os
import numpy as np
import pandas as pd
from scipy.stats import chi2_contingency, fisher_exact

def main():
    file_path = "data/MeRIP_RNA_result.xlsx"
    df = pd.read_excel(file_path, sheet_name="Date Formatting")
    
    print(f"Loaded {len(df)} rows from {file_path}")
    print(f"Columns: {df.columns.tolist()}\n")
    
    # 1. Primary analysis: 3x3 Contingency Table
    print("=== Primary Analysis: 3x3 Contingency Table (Chi-square test of independence) ===")
    ct3 = pd.crosstab(df['m6A'], df['DEG'])
    print("\nContingency Table (3x3):")
    print(ct3)
    
    chi2_stat, p_val_3x3, dof, expected = chi2_contingency(ct3)
    print(f"\nChi-square statistic: {chi2_stat:.6f}")
    print(f"Degrees of freedom: {dof}")
    print(f"p-value: {p_val_3x3:.4e}")
    print(f"p-value (full precision): {p_val_3x3}")
    print("\nExpected frequencies:")
    expected_df = pd.DataFrame(expected, index=ct3.index, columns=ct3.columns)
    print(expected_df)
    
    # 2. Complementary analysis: 2x2 Contingency Table (Significant vs Non-significant)
    print("\n=== Complementary Analysis: 2x2 Contingency Table ===")
    df['m6A_sig'] = df['m6A'].isin(['m6A Hyper', 'm6A Hypo'])
    df['DEG_sig'] = df['DEG'].isin(['Up', 'Down'])
    
    ct2 = pd.crosstab(df['m6A_sig'], df['DEG_sig'])
    ct2.index = ['m6A no sig', 'm6A sig']
    ct2.columns = ['no-DEGs', 'DEGs']
    print("\nContingency Table (2x2):")
    print(ct2)
    
    chi2_stat_2_yates, p_val_2_yates, dof_2, _ = chi2_contingency(ct2, correction=True)
    chi2_stat_2_no_yates, p_val_2_no_yates, _, _ = chi2_contingency(ct2, correction=False)
    odds_ratio, p_val_fisher = fisher_exact(ct2)
    
    print(f"\n2x2 Chi-square (with Yates correction): stat = {chi2_stat_2_yates:.6f}, p = {p_val_2_yates:.4e}")
    print(f"2x2 Chi-square (without Yates correction): stat = {chi2_stat_2_no_yates:.6f}, p = {p_val_2_no_yates:.4e}")
    print(f"2x2 Fisher's Exact test: odds ratio = {odds_ratio:.6f}, p = {p_val_fisher:.4e}")
    
    # Check deduplicated transcript-level (GeneID)
    print("\n=== Transcript-level (GeneID deduplication check) ===")
    df_enst = df.drop_duplicates(subset=['GeneID'])
    ct_enst = pd.crosstab(df_enst['m6A'], df_enst['DEG'])
    chi2_enst, p_enst, dof_enst, _ = chi2_contingency(ct_enst)
    print(f"Unique GeneIDs: {len(df_enst)}")
    print(f"Transcript-level 3x3 Chi-square: stat = {chi2_enst:.6f}, p = {p_enst:.4e}")

    # Output formatted string for the task
    print(f"\nTarget Primary 3x3 p-value in scientific notation: {p_val_3x3:.2e} (or {p_val_3x3:.4e})")

if __name__ == "__main__":
    main()
