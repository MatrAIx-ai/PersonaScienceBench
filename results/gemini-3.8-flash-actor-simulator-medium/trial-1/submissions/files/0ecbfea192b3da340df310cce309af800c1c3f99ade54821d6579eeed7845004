import os
import sys
import json
import math
import numpy as np
import pandas as pd

if '/usr/lib/python3/dist-packages' not in sys.path:
    sys.path.append('/usr/lib/python3/dist-packages')

R = 8.314
T_FREEZE = 273.16

def calc_esat(t_air_k):
    tc = t_air_k - T_FREEZE
    return 610.78 * math.exp(17.27 * tc / (t_air_k - 35.86))

def calc_photosynthesis_capacity(vcmax25, t_air_k, n_factor, btran):
    tc = t_air_k - T_FREEZE
    denom = 1.0 + math.exp((-2.2e5 + 710.0 * (tc + 273.16)) / (R * (tc + 273.16)))
    vcmax_t = vcmax25 * (2.4 ** ((tc - 25.0) / 10.0)) / denom
    vcmax = vcmax_t * n_factor * btran
    rd = 0.015 * vcmax
    return vcmax, rd

def calc_coupled_state(par_wm2, t_air_k, p_atm_pa, co2_pa, o2_pa, vpd_pa, rb_sm, btran, params, ci_init=None, tol=1e-5, max_iter=100):
    pathway = params.get('pathway', 'C4')
    vcmax25 = params['vcmax25']
    bb_slope = params['bb_slope']
    bb_intercept = params['bb_intercept']
    alpha_q = params['alpha_q']
    n_factor = params.get('n_factor', 1.0)

    cf = p_atm_pa / (R * t_air_k)
    vcmax, rd = calc_photosynthesis_capacity(vcmax25, t_air_k, n_factor, btran)
    esat = calc_esat(t_air_k)
    hs = min(max(1.0 - vpd_pa / esat, 0.25), 1.0)

    if par_wm2 <= 1e-6:
        a_final = -rd
        a_mol = a_final * 1e-6
        gs_final = bb_intercept
        rs_final = cf / gs_final
        cs = co2_pa - 1.37 * rb_sm * (a_mol / cf) * p_atm_pa
        ci_final = cs - 1.65 * rs_final * (a_mol / cf) * p_atm_pa
        return a_final, rs_final, ci_final, gs_final, 0

    apar = 4.6 * par_wm2
    tc = t_air_k - T_FREEZE

    if pathway == 'C4':
        wc = vcmax
        wj = alpha_q * apar
    else:
        kc = 30.0 * (2.1 ** ((tc - 25.0) / 10.0))
        ko = 30000.0 * (1.2 ** ((tc - 25.0) / 10.0))
        gamma_star = 0.5 * (kc / ko) * o2_pa * 0.21
        j_val = alpha_q * apar
        we_c3 = 0.5 * vcmax

    def step(ci_current):
        ci_safe = max(ci_current, 1e-4)
        if pathway == 'C4':
            we = 4000.0 * vcmax * ci_safe / p_atm_pa
            a_val = min(wc, wj, we) - rd
        else:
            denom_c = ci_safe + kc * (1.0 + o2_pa / ko)
            wc_c3 = vcmax * (ci_safe - gamma_star) / max(denom_c, 1e-6)
            denom_j = 4.0 * ci_safe + 8.0 * gamma_star
            wj_c3 = j_val * (ci_safe - gamma_star) / max(denom_j, 1e-6)
            a_val = min(wc_c3, wj_c3, we_c3) - rd

        a_mol = a_val * 1e-6
        cs_val = co2_pa - 1.37 * rb_sm * (a_mol / cf) * p_atm_pa
        cs_safe = max(cs_val, 1e-4)
        gs_val = max(bb_slope * a_mol * hs / cs_safe * p_atm_pa + bb_intercept, bb_intercept)
        rs_val = cf / gs_val
        ci_next_val = cs_val - 1.65 * rs_val * (a_mol / cf) * p_atm_pa
        return ci_next_val, a_val, rs_val, gs_val

    ci_curr = ci_init if ci_init is not None else 0.7 * co2_pa
    n_iterations = 0

    for iteration in range(1, max_iter + 1):
        n_iterations = iteration
        ci_next, a_curr, rs_curr, gs_curr = step(ci_curr)
        if abs(ci_next - ci_curr) < tol:
            ci_curr = ci_next
            break
        ci_curr = ci_next

    return a_curr, rs_curr, ci_curr, gs_curr, n_iterations

def run_diurnal_simulation(leaf_params, forcing_df):
    results = []
    for _, row in forcing_df.iterrows():
        t_hr = row['time_hr']
        t_air = row['t_air_K']
        p_atm = row['p_atm_Pa']
        co2 = row['co2_pa']
        o2 = row['o2_pa']
        vpd = row['vpd_Pa']
        rb = row['rb_sm']
        btran = row['btran']

        a_sun, rs_sun, ci_sun, gs_sun, _ = calc_coupled_state(
            row['par_sun_wm2'], t_air, p_atm, co2, o2, vpd, rb, btran, leaf_params
        )
        a_shade, rs_shade, ci_shade, gs_shade, _ = calc_coupled_state(
            row['par_shade_wm2'], t_air, p_atm, co2, o2, vpd, rb, btran, leaf_params
        )

        results.append({
            'time_hr': t_hr,
            'A_sun': a_sun,
            'A_shade': a_shade,
            'rs_sun': rs_sun,
            'rs_shade': rs_shade,
            'ci_sun': ci_sun,
            'ci_shade': ci_shade,
            'gs_sun': gs_sun,
            'gs_shade': gs_shade
        })
    return pd.DataFrame(results)

def run_test_cases(leaf_params, forcing_df, test_cases):
    records = []
    for tc in test_cases:
        cid = tc['case_id']
        ci_init = tc['ci_init_pa']
        f_idx = tc['forcing_index']
        row = forcing_df.iloc[f_idx]

        a_fin, rs_fin, ci_fin, _, n_iters = calc_coupled_state(
            row['par_sun_wm2'], row['t_air_K'], row['p_atm_Pa'], row['co2_pa'],
            row['o2_pa'], row['vpd_Pa'], row['rb_sm'], row['btran'],
            leaf_params, ci_init=ci_init, tol=1e-5
        )

        records.append({
            'case_id': cid,
            'ci_init_pa': ci_init,
            'ci_final_pa': ci_fin,
            'A_final': a_fin,
            'rs_final': rs_fin,
            'n_iterations': n_iters
        })
    return pd.DataFrame(records)

def plot_diurnal_cycles(fluxes_df, output_path):
    try:
        import matplotlib.pyplot as plt
        fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(10, 8), sharex=True)
        t = fluxes_df['time_hr']
        ax1.plot(t, fluxes_df['A_sun'], label='Sunlit', color='#D95F02', linewidth=2.0)
        ax1.plot(t, fluxes_df['A_shade'], label='Shaded', color='#1B9E77', linewidth=2.0, linestyle='--')
        ax1.set_ylabel('A (umol m^-2 s^-1)', fontsize=12)
        ax1.set_title('Leaf Photosynthetic Assimilation (A)', fontsize=14, fontweight='bold')
        ax1.grid(True, linestyle=':', alpha=0.6)
        ax1.legend(loc='upper right')

        ax2.plot(t, fluxes_df['rs_sun'], label='Sunlit', color='#D95F02', linewidth=2.0)
        ax2.plot(t, fluxes_df['rs_shade'], label='Shaded', color='#1B9E77', linewidth=2.0, linestyle='--')
        ax2.set_xlabel('Time (hours)', fontsize=12)
        ax2.set_ylabel('rs (s m^-1)', fontsize=12)
        ax2.set_title('Stomatal Resistance (rs)', fontsize=14, fontweight='bold')
        ax2.grid(True, linestyle=':', alpha=0.6)
        ax2.legend(loc='upper right')

        plt.tight_layout()
        plt.savefig(output_path, dpi=300)
        plt.close()
        return
    except ImportError:
        pass

    from PIL import Image, ImageDraw, ImageFont
    w, h = 1400, 950
    img = Image.new('RGB', (w, h), color='#FFFFFF')
    draw = ImageDraw.Draw(img)

    try:
        font_main = ImageFont.truetype('/usr/share/fonts/truetype/liberation/LiberationSans-Bold.ttf', 22)
        font_sub = ImageFont.truetype('/usr/share/fonts/truetype/liberation/LiberationSans-Bold.ttf', 17)
        font_axis = ImageFont.truetype('/usr/share/fonts/truetype/liberation/LiberationSans-Regular.ttf', 15)
        font_tick = ImageFont.truetype('/usr/share/fonts/truetype/liberation/LiberationSans-Regular.ttf', 13)
        font_legend = ImageFont.truetype('/usr/share/fonts/truetype/liberation/LiberationSans-Regular.ttf', 14)
    except Exception:
        font_main = font_sub = font_axis = font_tick = font_legend = ImageFont.load_default()

    title = 'Coupled Farquhar-Collatz & Ball-Berry Leaf Physiological Response'
    draw.text((w // 2 - 280, 25), title, fill='#111111', font=font_main)

    left, right = 110, w - 60
    plot_w = right - left
    p1_top, p1_bot = 90, 470
    p2_top, p2_bot = 530, 890

    t_data = fluxes_df['time_hr'].values
    t_min, t_max = float(t_data.min()), float(t_data.max())

    def draw_panel(top, bot, y1_col, y2_col, title_text, y_label, y_min_val, y_max_val):
        p_h = bot - top
        draw.rectangle([left, top, right, bot], fill='#FBFBFB', outline='#444444', width=2)
        draw.text((left + 15, top + 15), title_text, fill='#222222', font=font_sub)

        n_yticks = 6
        for i in range(n_yticks + 1):
            y_val = y_min_val + i * (y_max_val - y_min_val) / n_yticks
            py = bot - int((y_val - y_min_val) / (y_max_val - y_min_val) * p_h)
            draw.line([(left, py), (right, py)], fill='#E0E0E0', width=1)
            draw.line([(left - 5, py), (left, py)], fill='#444444', width=1)
            val_str = f'{y_val:.1f}' if abs(y_max_val - y_min_val) < 100 else f'{int(y_val)}'
            draw.text((left - 48, py - 7), val_str, fill='#333333', font=font_tick)

        for t_val in range(0, int(t_max) + 1, 12):
            px = left + int((t_val - t_min) / (t_max - t_min) * plot_w)
            draw.line([(px, top), (px, bot)], fill='#EAEAEA', width=1)
            draw.line([(px, bot), (px, bot + 5)], fill='#444444', width=1)
            if top == p2_top:
                draw.text((px - 10, bot + 8), str(t_val), fill='#333333', font=font_tick)

        draw.text((left - 85, top + p_h // 2 - 40), y_label, fill='#222222', font=font_axis)

        pts_sun = []
        pts_shade = []
        for _, r_val in fluxes_df.iterrows():
            px = left + (r_val['time_hr'] - t_min) / (t_max - t_min) * plot_w
            py_sun = bot - (r_val[y1_col] - y_min_val) / (y_max_val - y_min_val) * p_h
            py_shade = bot - (r_val[y2_col] - y_min_val) / (y_max_val - y_min_val) * p_h
            pts_sun.append((px, py_sun))
            pts_shade.append((px, py_shade))

        for i in range(len(pts_sun) - 1):
            draw.line([pts_sun[i], pts_sun[i + 1]], fill='#D95F02', width=3)
            draw.line([pts_shade[i], pts_shade[i + 1]], fill='#1B9E77', width=3)

        leg_x, leg_y = right - 220, top + 15
        draw.rectangle([leg_x, leg_y, leg_x + 200, leg_y + 60], fill='#FFFFFF', outline='#CCCCCC', width=1)
        draw.line([(leg_x + 10, leg_y + 18), (leg_x + 45, leg_y + 18)], fill='#D95F02', width=3)
        draw.text((leg_x + 55, leg_y + 10), 'Sunlit Leaf', fill='#222222', font=font_legend)
        draw.line([(leg_x + 10, leg_y + 42), (leg_x + 45, leg_y + 42)], fill='#1B9E77', width=3)
        draw.text((leg_x + 55, leg_y + 34), 'Shaded Leaf', fill='#222222', font=font_legend)

    draw_panel(p1_top, p1_bot, 'A_sun', 'A_shade', 'Assimilation Rate (A)', 'A (umol m^-2 s^-1)', -2.0, 45.0)
    draw_panel(p2_top, p2_bot, 'rs_sun', 'rs_shade', 'Stomatal Resistance (rs)', 'rs (s m^-1)', 0.0, 1200.0)
    draw.text((left + plot_w // 2 - 40, p2_bot + 30), 'Time (hours)', fill='#222222', font=font_axis)

    img.save(output_path, 'PNG')

def main():
    base_dir = os.path.dirname(os.path.abspath(__file__))
    data_dir = os.path.join(base_dir, 'data')
    results_dir = os.path.join(base_dir, 'results')
    os.makedirs(results_dir, exist_ok=True)

    with open(os.path.join(data_dir, 'leaf_params.json'), 'r', encoding='utf-8') as f:
        leaf_params = json.load(f)

    forcing_df = pd.read_csv(os.path.join(data_dir, 'forcing.csv'))

    with open(os.path.join(data_dir, 'test_cases.json'), 'r', encoding='utf-8') as f:
        test_cases = json.load(f)

    fluxes_df = run_diurnal_simulation(leaf_params, forcing_df)
    fluxes_path = os.path.join(results_dir, 'leaf_fluxes.csv')
    fluxes_df.to_csv(fluxes_path, index=False)

    conv_df = run_test_cases(leaf_params, forcing_df, test_cases)
    conv_path = os.path.join(results_dir, 'case_convergence.csv')
    conv_df.to_csv(conv_path, index=False)

    img_path = os.path.join(results_dir, 'diurnal.png')
    plot_diurnal_cycles(fluxes_df, img_path)
    print('Execution completed successfully.')

if __name__ == '__main__':
    main()
