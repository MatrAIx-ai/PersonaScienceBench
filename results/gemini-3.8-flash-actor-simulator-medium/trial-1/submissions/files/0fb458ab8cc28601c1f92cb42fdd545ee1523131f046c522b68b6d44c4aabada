import pandas as pd
import numpy as np
from scipy import stats
import statsmodels.api as sm
import statsmodels.formula.api as smf

def run_analysis():
    df = pd.read_csv('data/invaded_niche_pathways.csv', sep='\t')
    
    summary = []
    for hab, grp in df.groupby('habitat'):
        n_plots = len(grp)
        mean_gard = grp['n.gard'].mean()
        std_gard = grp['n.gard'].std()
        median_gard = grp['n.gard'].median()
        iqr_gard = grp['n.gard'].quantile(0.75) - grp['n.gard'].quantile(0.25)
        occ_rate = (grp['n.gard'] > 0).mean() * 100
        total_gard = grp['n.gard'].sum()
        total_non_native = grp['n.total'].sum()
        prop_of_total = (total_gard / total_non_native * 100) if total_non_native > 0 else 0
        
        summary.append({
            'habitat': hab,
            'N': n_plots,
            'mean_n_gard': mean_gard,
            'std_n_gard': std_gard,
            'median_n_gard': median_gard,
            'iqr_n_gard': iqr_gard,
            'occ_rate_pct': occ_rate,
            'total_gard': int(total_gard),
            'total_non_native': int(total_non_native),
            'gard_share_pct': prop_of_total
        })

    res_df = pd.DataFrame(summary).sort_values(by='mean_n_gard', ascending=False)
    
    # Non-parametric Kruskal-Wallis test across 10 habitats
    groups = [grp['n.gard'].values for _, grp in df.groupby('habitat')]
    kw_stat, kw_pval = stats.kruskal(*groups)
    
    # Macro-habitat comparison (Disturbed/Wet vs Natural/Dry)
    df['macro_group'] = df['habitat'].apply(lambda x: 'High_Gardening' if x in ['Coastal', 'Wetlands', 'Urban', 'Riparian'] else 'Low_Gardening')
    mw_stat, mw_pval = stats.mannwhitneyu(
        df[df['macro_group']=='High_Gardening']['n.gard'],
        df[df['macro_group']=='Low_Gardening']['n.gard'],
        alternative='two-sided'
    )
    
    return res_df, (kw_stat, kw_pval), (mw_stat, mw_pval)

if __name__ == '__main__':
    res_df, kw, mw = run_analysis()
    print("Habitat Summary:")
    print(res_df.to_string(index=False))
    print(f"\nKruskal-Wallis test: H = {kw[0]:.4f}, p = {kw[1]:.4e}")
    print(f"Mann-Whitney U (Disturbed/Wet vs Others): U = {mw[0]:.1f}, p = {mw[1]:.4e}")
