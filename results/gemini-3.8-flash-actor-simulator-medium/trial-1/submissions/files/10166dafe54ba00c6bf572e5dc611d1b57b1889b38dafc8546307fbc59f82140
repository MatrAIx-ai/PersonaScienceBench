"""
Coupled Farquhar-Collatz Photosynthesis and Ball-Berry Stomatal Conductance Model.

Simulates diurnal forcing and single-point test cases using CLM/Noah-MP conventions.
Outputs: results/leaf_fluxes.csv, results/case_convergence.csv, results/diurnal.png.
"""

import json
import os
import sys
import numpy as np
import pandas as pd

if '/usr/lib/python3/dist-packages' not in sys.path:
    sys.path.append('/usr/lib/python3/dist-packages')

R_GAS = 8.314462618


def calc_esat(T_air_K):
    """Tetens saturation vapor pressure (Pa)."""
    Tc = T_air_K - 273.16
    return 610.78 * np.exp(17.27 * Tc / (T_air_K - 35.86))


def calc_hs(vpd_Pa, esat_Pa):
    """Surface relative humidity bounded in [0.25, 1.0]."""
    return np.clip(1.0 - vpd_Pa / esat_Pa, 0.25, 1.0)


def calc_vcmax_and_rd(vcmax25, T_air_K, n_factor, btran):
    """CLM/Noah-MP Q10 temperature response with high-temperature inhibition."""
    Tc = T_air_K - 273.16
    Tk = Tc + 273.16
    q10 = 2.4 ** ((Tc - 25.0) / 10.0)
    inhibition = 1.0 + np.exp((-2.2e5 + 710.0 * Tk) / (R_GAS * Tk))
    vcmax_eff = (vcmax25 * q10 / inhibition) * n_factor * btran
    rd = 0.015 * vcmax_eff
    return vcmax_eff, rd


def calc_photosynthesis_c4(ci_pa, apar, vcmax, rd, p_atm):
    """C4 photosynthesis (Collatz et al. 1992)."""
    Wc = vcmax
    Wj = apar
    We = 4000.0 * vcmax * ci_pa / p_atm
    A = min(Wc, Wj, We) - rd
    return A


def calc_photosynthesis_c3(ci_pa, apar, vcmax, rd, T_air_K, o2_pa):
    """C3 photosynthesis (Farquhar et al. 1980)."""
    Tc = T_air_K - 273.16
    Kc = 30.0 * (2.1 ** ((Tc - 25.0) / 10.0))
    Ko = 30000.0 * (1.2 ** ((Tc - 25.0) / 10.0))
    gamma_star = 0.5 * (Kc / Ko) * o2_pa * 0.21
    Wc = vcmax * (ci_pa - gamma_star) / (ci_pa + Kc * (1.0 + o2_pa / Ko))
    Wj = apar * (ci_pa - gamma_star) / (4.0 * ci_pa + 8.0 * gamma_star)
    We = 0.5 * vcmax
    A = min(Wc, Wj, We) - rd
    return A


def diffusion_step(ci_pa, par, params, env):
    """One step of coupled gas diffusion & Ball-Berry system."""
    p_atm = env['p_atm_Pa']
    t_air = env['t_air_K']
    ca = env['co2_pa']
    rb = env['rb_sm']
    hs = env['hs']
    vcmax = env['vcmax']
    rd = env['rd']
    cf = p_atm / (R_GAS * t_air)

    pathway = params.get('pathway', 'C4').upper()
    apar = 4.6 * par
    j_input = params['alpha_q'] * apar

    if pathway == 'C4':
        A = calc_photosynthesis_c4(ci_pa, j_input, vcmax, rd, p_atm)
    else:
        A = calc_photosynthesis_c3(ci_pa, j_input, vcmax, rd, t_air, env['o2_pa'])

    A_mol = A * 1e-6
    cs = max(ca - 1.37 * rb * (A_mol / cf) * p_atm, 1e-3)
    gs = max(params['bb_slope'] * A_mol * (hs / cs) * p_atm + params['bb_intercept'], params['bb_intercept'] * 0.1)
    rs = cf / gs
    ci_new = cs - 1.65 * (A_mol / gs) * p_atm
    return ci_new, A, rs, gs


def solve_leaf_fluxes(par, params, env, ci_init=None, tol=1e-6, max_iter=100):
    """Coupled solver: fixed point for day, prescribed respiration for night."""
    p_atm = env['p_atm_Pa']
    t_air = env['t_air_K']
    ca = env['co2_pa']
    rb = env['rb_sm']
    rd = env['rd']
    cf = p_atm / (R_GAS * t_air)

    if par <= 1e-4:
        A = -rd
        A_mol = A * 1e-6
        gs = params['bb_intercept']
        rs = cf / gs
        cs = ca - 1.37 * rb * (A_mol / cf) * p_atm
        ci = cs - 1.65 * (A_mol / gs) * p_atm
        return ci, A, rs, gs, 0

    ci = 0.7 * ca if ci_init is None else float(ci_init)
    n_iter = 0
    for it in range(1, max_iter + 1):
        n_iter = it
        ci_next, A, rs, gs = diffusion_step(ci, par, params, env)
        if abs(ci_next - ci) < tol:
            ci = ci_next
            break
        ci = ci_next

    return ci, A, rs, gs, n_iter


def plot_diurnal(df, output_path):
    """Render diurnal figure using matplotlib if available, else Pillow."""
    try:
        import matplotlib
        matplotlib.use('Agg')
        import matplotlib.pyplot as plt
        fig, axes = plt.subplots(2, 1, figsize=(11, 7), sharex=True)
        axes[0].plot(df['time_hr'], df['A_sun'], label='Sunlit leaf ($A_{sun}$)', color='#d95f02', lw=1.8)
        axes[0].plot(df['time_hr'], df['A_shade'], label='Shaded leaf ($A_{shade}$)', color='#7570b3', lw=1.8, linestyle='--')
        axes[0].axhline(0, color='gray', linestyle=':', lw=0.8)
        axes[0].set_ylabel(r'Net Assimilation $A$ ($\mu\mathrm{mol\ CO_2\ m^{-2}\ s^{-1}}$)', fontsize=11)
        axes[0].set_title('Coupled Leaf Physiological Response: Diurnal Cycle', fontsize=13, fontweight='bold')
        axes[0].legend(loc='upper right', frameon=True, fontsize=10)
        axes[0].grid(True, linestyle='--', alpha=0.5)

        axes[1].plot(df['time_hr'], df['rs_sun'], label='Sunlit leaf ($r_{s,sun}$)', color='#d95f02', lw=1.8)
        axes[1].plot(df['time_hr'], df['rs_shade'], label='Shaded leaf ($r_{s,shade}$)', color='#7570b3', lw=1.8, linestyle='--')
        axes[1].set_ylabel(r'Stomatal Resistance $r_s$ ($\mathrm{s\ m^{-1}}$)', fontsize=11)
        axes[1].set_xlabel('Time (hours)', fontsize=11)
        axes[1].legend(loc='upper right', frameon=True, fontsize=10)
        axes[1].grid(True, linestyle='--', alpha=0.5)

        plt.tight_layout()
        plt.savefig(output_path, dpi=300)
        plt.close()
        return
    except Exception:
        pass

    # High-quality Pillow renderer fallback
    from PIL import Image, ImageDraw, ImageFont
    w, h = 1200, 800
    img = Image.new('RGB', (w, h), color=(255, 255, 255))
    draw = ImageDraw.Draw(img)
    try:
        f_title = ImageFont.truetype('/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf', 18)
        f_axis = ImageFont.truetype('/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf', 12)
        f_tick = ImageFont.truetype('/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf', 10)
        f_leg = ImageFont.truetype('/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf', 11)
    except Exception:
        f_title = f_axis = f_tick = f_leg = ImageFont.load_default()

    draw.text((w // 2 - 270, 20), "Coupled Farquhar-Collatz / Ball-Berry Diurnal Simulation", fill=(30, 30, 30), font=f_title)
    xl, xr = 100, 1140
    t_min, t_max = 0.0, 120.0
    times = df['time_hr'].values

    def draw_panel(y_top, y_bot, y_min, y_max, y_ticks, y_lbl, s1, s2, lbl1, lbl2, is_bot):
        draw.rectangle([xl, y_top, xr, y_bot], outline=(150, 150, 150), width=1)
        my = lambda v: y_bot - (v - y_min) / (y_max - y_min) * (y_bot - y_top)
        mx = lambda t: xl + (t - t_min) / (t_max - t_min) * (xr - xl)

        for yt in y_ticks:
            yp = my(yt)
            if y_top <= yp <= y_bot:
                draw.line([(xl, yp), (xr, yp)], fill=(230, 230, 230), width=1)
                draw.text((xl - 35, yp - 6), f"{yt:g}", fill=(50, 50, 50), font=f_tick)

        if y_min <= 0 <= y_max:
            draw.line([(xl, my(0.0)), (xr, my(0.0))], fill=(180, 180, 180), width=1)

        for xt in np.arange(0, 121, 12):
            xp = mx(xt)
            draw.line([(xp, y_top), (xp, y_bot)], fill=(230, 230, 230), width=1)
            if is_bot:
                draw.line([(xp, y_bot), (xp, y_bot + 5)], fill=(100, 100, 100), width=1)
                draw.text((xp - 8, y_bot + 8), str(int(xt)), fill=(50, 50, 50), font=f_tick)

        p1 = [(mx(t), my(v)) for t, v in zip(times, s1)]
        p2 = [(mx(t), my(v)) for t, v in zip(times, s2)]
        draw.line(p1, fill=(217, 95, 2), width=2)
        for i in range(len(p2) - 1):
            if (i // 2) % 2 == 0:
                draw.line([p2[i], p2[i+1]], fill=(117, 112, 179), width=2)

        draw.text((15, (y_top + y_bot) // 2 - 10), y_lbl, fill=(20, 20, 20), font=f_axis)
        lx, ly = xr - 230, y_top + 15
        draw.rectangle([lx, ly, lx + 215, ly + 55], fill=(255, 255, 255), outline=(180, 180, 180), width=1)
        draw.line([(lx + 10, ly + 16), (lx + 40, ly + 16)], fill=(217, 95, 2), width=2)
        draw.text((lx + 48, ly + 9), lbl1, fill=(30, 30, 30), font=f_leg)
        draw.line([(lx + 10, ly + 38), (lx + 25, ly + 38)], fill=(117, 112, 179), width=2)
        draw.line([(lx + 30, ly + 38), (lx + 40, ly + 38)], fill=(117, 112, 179), width=2)
        draw.text((lx + 48, ly + 31), lbl2, fill=(30, 30, 30), font=f_leg)

    draw_panel(70, 380, -5.0, 45.0, [-5, 0, 10, 20, 30, 40], "A (umol m^-2 s^-1)",
               df['A_sun'].values, df['A_shade'].values, "Sunlit (A_sun)", "Shaded (A_shade)", False)
    draw_panel(430, 740, 0.0, 1300.0, [0, 200, 400, 600, 800, 1000, 1200], "rs (s m^-1)",
               df['rs_sun'].values, df['rs_shade'].values, "Sunlit (rs_sun)", "Shaded (rs_shade)", True)
    draw.text((w // 2 - 40, 770), "Time (hours)", fill=(20, 20, 20), font=f_axis)
    img.save(output_path, "PNG")


def run_model(leaf_params_path='data/leaf_params.json',
              forcing_path='data/forcing.csv',
              test_cases_path='data/test_cases.json',
              results_dir='results'):
    """Main workflow function."""
    os.makedirs(results_dir, exist_ok=True)
    with open(leaf_params_path, 'r') as f:
        params = json.load(f)
    with open(test_cases_path, 'r') as f:
        test_cases = json.load(f)
    df_forcing = pd.read_csv(forcing_path)

    # 1. Diurnal Simulation
    records = []
    for idx, row in df_forcing.iterrows():
        t_air = row['t_air_K']
        vpd = row['vpd_Pa']
        esat = calc_esat(t_air)
        hs = calc_hs(vpd, esat)
        vcmax, rd = calc_vcmax_and_rd(params['vcmax25'], t_air, params['n_factor'], row['btran'])
        env = {
            't_air_K': t_air, 'p_atm_Pa': row['p_atm_Pa'], 'co2_pa': row['co2_pa'],
            'o2_pa': row['o2_pa'], 'rb_sm': row['rb_sm'], 'hs': hs, 'vcmax': vcmax, 'rd': rd
        }
        ci_sun, A_sun, rs_sun, gs_sun, _ = solve_leaf_fluxes(row['par_sun_wm2'], params, env)
        ci_shade, A_shade, rs_shade, gs_shade, _ = solve_leaf_fluxes(row['par_shade_wm2'], params, env)
        records.append({
            'time_hr': row['time_hr'],
            'A_sun': A_sun, 'A_shade': A_shade,
            'rs_sun': rs_sun, 'rs_shade': rs_shade,
            'ci_sun': ci_sun, 'ci_shade': ci_shade,
            'gs_sun': gs_sun, 'gs_shade': gs_shade
        })

    fluxes_df = pd.DataFrame(records)
    fluxes_csv_path = os.path.join(results_dir, 'leaf_fluxes.csv')
    fluxes_df.to_csv(fluxes_csv_path, index=False)

    # 2. Test Cases Evaluation
    case_records = []
    for case in test_cases:
        row = df_forcing.iloc[case['forcing_index']]
        t_air = row['t_air_K']
        vpd = row['vpd_Pa']
        esat = calc_esat(t_air)
        hs = calc_hs(vpd, esat)
        vcmax, rd = calc_vcmax_and_rd(params['vcmax25'], t_air, params['n_factor'], row['btran'])
        env = {
            't_air_K': t_air, 'p_atm_Pa': row['p_atm_Pa'], 'co2_pa': row['co2_pa'],
            'o2_pa': row['o2_pa'], 'rb_sm': row['rb_sm'], 'hs': hs, 'vcmax': vcmax, 'rd': rd
        }
        ci_final, A_final, rs_final, _, n_iter = solve_leaf_fluxes(
            row['par_sun_wm2'], params, env, ci_init=case['ci_init_pa'], tol=1e-6
        )
        case_records.append({
            'case_id': case['case_id'],
            'ci_init_pa': case['ci_init_pa'],
            'ci_final_pa': ci_final,
            'A_final': A_final,
            'rs_final': rs_final,
            'n_iterations': n_iter
        })

    cases_df = pd.DataFrame(case_records)
    cases_csv_path = os.path.join(results_dir, 'case_convergence.csv')
    cases_df.to_csv(cases_csv_path, index=False)

    # 3. Figure Generation
    fig_path = os.path.join(results_dir, 'diurnal.png')
    plot_diurnal(fluxes_df, fig_path)

    print("Workflow executed successfully.")
    print(f"Generated: {fluxes_csv_path}, {cases_csv_path}, {fig_path}")


if __name__ == '__main__':
    run_model()
