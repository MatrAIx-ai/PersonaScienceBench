"""
Analysis of BA Degree Completion Rates across Socioeconomic Levels and Race in the NLS Dataset.
Question: At what Socioeconomic levels is the advantage in completion rates for Black students more pronounced?
"""
import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf

def main():
    # Load dataset
    df = pd.read_csv('data/nls_ses_processed.csv')
    df.columns = [c.replace(' ', '_').replace(':', '') for c in df.columns]
    df['BA_DEGREE_COMPLETED'] = df['BA_DEGREE_COMPLETED'].astype(int)

    print("===============================================================")
    print("1. SAMPLE OVERVIEW AND DESCRIPTIVE STATISTICS")
    print("===============================================================")
    print(f"Total Sample Size: {len(df)}")
    print("\nRace Distribution:")
    race_counts = df['SAMPLE_RACE'].value_counts()
    race_props = df['SAMPLE_RACE'].value_counts(normalize=True) * 100
    for r in race_counts.index:
        print(f"  {r}: N = {race_counts[r]} ({race_props[r]:.2f}%)")

    print("\nOverall BA Completion Rate:")
    print(f"  Completed: {df['BA_DEGREE_COMPLETED'].sum()} / {len(df)} ({df['BA_DEGREE_COMPLETED'].mean()*100:.2f}%)")

    print("\nBA Completion Rate by Race:")
    race_ba = df.groupby('SAMPLE_RACE')['BA_DEGREE_COMPLETED'].agg(['count', 'sum', 'mean'])
    race_ba['mean'] = race_ba['mean'] * 100
    print(race_ba.to_string())

    print("\nSES Distribution by Race:")
    ses_stats = df.groupby('SAMPLE_RACE')['SES'].describe()
    print(ses_stats[['count', 'mean', 'std', '25%', '50%', '75%']].to_string())

    print("\n===============================================================")
    print("2. STRATIFIED ANALYSIS BY SES QUANTILES")
    print("===============================================================")
    # Quartiles
    df['ses_q4'] = pd.qcut(df['SES'], 4, labels=['Q1 (Low)', 'Q2 (Mid-Low)', 'Q3 (Mid-High)', 'Q4 (High)'])
    print("\n--- SES Quartiles ---")
    ct_q4 = df.groupby(['ses_q4', 'SAMPLE_RACE'])['BA_DEGREE_COMPLETED'].agg(['count', 'sum', 'mean']).unstack('SAMPLE_RACE')
    print(ct_q4)

    # Quintiles
    df['ses_q5'] = pd.qcut(df['SES'], 5, labels=['Quintile 1', 'Quintile 2', 'Quintile 3', 'Quintile 4', 'Quintile 5'])
    print("\n--- SES Quintiles ---")
    ct_q5 = df.groupby(['ses_q5', 'SAMPLE_RACE'])['BA_DEGREE_COMPLETED'].agg(['count', 'sum', 'mean']).unstack('SAMPLE_RACE')
    print(ct_q5)

    # Deciles
    df['ses_q10'] = pd.qcut(df['SES'], 10)
    print("\n--- SES Deciles (Top vs Bottom) ---")
    ct_q10 = df.groupby(['ses_q10', 'SAMPLE_RACE'])['BA_DEGREE_COMPLETED'].agg(['count', 'sum', 'mean']).unstack('SAMPLE_RACE')
    print(ct_q10)

    print("\n===============================================================")
    print("3. STATISTICAL MODELING: RACE x SES INTERACTION")
    print("===============================================================")

    # Model 1: Unadjusted Logit (Race * SES)
    m1 = smf.logit('BA_DEGREE_COMPLETED ~ C(SAMPLE_RACE, Treatment("White")) * SES', data=df).fit(disp=False)
    print("\n--- Model 1: Unadjusted Logit (Race * SES) ---")
    print(m1.summary().tables[1])

    # Model 2: Adjusted for Academic Resources (ASVAB Ability + Class Rank)
    m2 = smf.logit('BA_DEGREE_COMPLETED ~ C(SAMPLE_RACE, Treatment("White")) * SES + ABILITY_COMPOSITE_OF_ASVAB_SCORE + PERCENTILE_IN_CLASS', data=df).fit(disp=False)
    print("\n--- Model 2: Adjusted for Academic Resources (ASVAB + Class Rank) ---")
    print(m2.summary().tables[1])

    # Model 3: Fully Adjusted (+ Sex + Family Size)
    m3 = smf.logit('BA_DEGREE_COMPLETED ~ C(SAMPLE_RACE, Treatment("White")) * SES + ABILITY_COMPOSITE_OF_ASVAB_SCORE + PERCENTILE_IN_CLASS + SAMPLE_SEX + FAMILY_SIZE_OF_SAMPLE', data=df).fit(disp=False)
    print("\n--- Model 3: Fully Adjusted Model ---")
    print(m3.summary().tables[1])

    print("\n===============================================================")
    print("4. PREDICTED PROBABILITIES & ODDS RATIOS ACROSS SES")
    print("===============================================================")
    mean_ability = df['ABILITY_COMPOSITE_OF_ASVAB_SCORE'].mean()
    mean_rank = df['PERCENTILE_IN_CLASS'].mean()
    mean_fam = df['FAMILY_SIZE_OF_SAMPLE'].mean()

    print("\nPredicted Completion Probabilities from Model 2 (Academic Controls):")
    print("SES Level | P(Black) | P(White) | Risk Diff | Risk Ratio | Odds Ratio")
    print("-" * 65)
    for s in [-1.5, -1.0, -0.5, 0.0, 0.5, 1.0, 1.5, 2.0]:
        rw = pd.DataFrame({'SAMPLE_RACE': ['White'], 'SES': [s], 'ABILITY_COMPOSITE_OF_ASVAB_SCORE': [mean_ability], 'PERCENTILE_IN_CLASS': [mean_rank]})
        rb = pd.DataFrame({'SAMPLE_RACE': ['Black'], 'SES': [s], 'ABILITY_COMPOSITE_OF_ASVAB_SCORE': [mean_ability], 'PERCENTILE_IN_CLASS': [mean_rank]})
        pw = m2.predict(rw)[0]
        pb = m2.predict(rb)[0]
        diff = pb - pw
        rr = pb / pw
        ow = pw / (1 - pw)
        ob = pb / (1 - pb)
        or_val = ob / ow
        print(f"SES={s:4.1f}   |  {pb*100:5.2f}%  |  {pw*100:5.2f}%  |  {diff*100:+6.2f}%   |   {rr:5.2f}    |   {or_val:5.2f}")

    print("\nPredicted Completion Probabilities from Model 1 (Unadjusted):")
    print("SES Level | P(Black) | P(White) | Risk Diff | Risk Ratio | Odds Ratio")
    print("-" * 65)
    for s in [-1.5, -1.0, -0.5, 0.0, 0.5, 1.0, 1.5, 2.0]:
        rw = pd.DataFrame({'SAMPLE_RACE': ['White'], 'SES': [s]})
        rb = pd.DataFrame({'SAMPLE_RACE': ['Black'], 'SES': [s]})
        pw = m1.predict(rw)[0]
        pb = m1.predict(rb)[0]
        diff = pb - pw
        rr = pb / pw
        ow = pw / (1 - pw)
        ob = pb / (1 - pb)
        or_val = ob / ow
        print(f"SES={s:4.1f}   |  {pb*100:5.2f}%  |  {pw*100:5.2f}%  |  {diff*100:+6.2f}%   |   {rr:5.2f}    |   {or_val:5.2f}")

if __name__ == '__main__':
    main()
