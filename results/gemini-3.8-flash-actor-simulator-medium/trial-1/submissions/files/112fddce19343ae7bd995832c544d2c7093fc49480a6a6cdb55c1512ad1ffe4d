import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf
from scipy import stats

# 1. Load data
df = pd.read_csv('data/nls_ses_processed.csv')
# Rename columns for convenience
df = df.rename(columns={
    'CASE ID': 'case_id',
    'SAMPLE_RACE': 'race',
    'SAMPLE_SEX': 'sex',
    'FAMILY SIZE OF SAMPLE': 'family_size',
    'ABILITY: COMPOSITE OF ASVAB SCORE': 'asvab_ability',
    'BA DEGREE COMPLETED': 'ba_completed',
    'PERCENTILE IN CLASS': 'class_percentile',
    'SES': 'ses'
})
df['ba_completed'] = df['ba_completed'].astype(int)

print("="*60)
print("DESCRIPTIVE SUMMARY")
print("="*60)
print(f"Total N: {len(df)}")
print("\nCompletion by race:")
ct = pd.crosstab(df['race'], df['ba_completed'], margins=True)
ct['pct_completed'] = (ct[1] / ct['All']) * 100
print(ct)

print("\nSES summary by race:")
print(df.groupby('race')['ses'].describe())

# SES tertiles / quartiles and BA rate
df['ses_tertile'] = pd.qcut(df['ses'], q=3, labels=['Low', 'Medium', 'High'])
print("\nBA completion rate by Race and SES Tertile (%):")
tertile_tab = pd.crosstab(df['race'], df['ses_tertile'], values=df['ba_completed'], aggfunc='mean') * 100
print(tertile_tab)

print("\n" + "="*60)
print("1. STRATIFIED LOGISTIC REGRESSIONS (BA ~ SES)")
print("="*60)
for race in ['White', 'Black', 'Hispanic']:
    sub = df[df['race'] == race]
    mod = smf.logit('ba_completed ~ ses', data=sub).fit(disp=False)
    coef = mod.params['ses']
    se = mod.bse['ses']
    pval = mod.pvalues['ses']
    odds_ratio = np.exp(coef)
    ci_low = np.exp(coef - 1.96 * se)
    ci_high = np.exp(coef + 1.96 * se)
    print(f"Race: {race} (N={len(sub)}, BA={sub['ba_completed'].sum()})")
    print(f"  SES Coef: {coef:.4f} (SE: {se:.4f}, z: {coef/se:.3f}, p: {pval:.4e})")
    print(f"  Odds Ratio: {odds_ratio:.4f} [95% CI: {ci_low:.4f}, {ci_high:.4f}]")

print("\n" + "="*60)
print("2. STRATIFIED WITH ACADEMIC CONTROLS (BA ~ SES + asvab_ability + class_percentile + family_size + sex)")
print("="*60)
for race in ['White', 'Black', 'Hispanic']:
    sub = df[df['race'] == race]
    mod = smf.logit('ba_completed ~ ses + asvab_ability + class_percentile + family_size + C(sex)', data=sub).fit(disp=False)
    coef = mod.params['ses']
    se = mod.bse['ses']
    pval = mod.pvalues['ses']
    odds_ratio = np.exp(coef)
    ci_low = np.exp(coef - 1.96 * se)
    ci_high = np.exp(coef + 1.96 * se)
    print(f"Race: {race} (N={len(sub)}, BA={sub['ba_completed'].sum()})")
    print(f"  SES Coef: {coef:.4f} (SE: {se:.4f}, z: {coef/se:.3f}, p: {pval:.4e})")
    print(f"  Odds Ratio: {odds_ratio:.4f} [95% CI: {ci_low:.4f}, {ci_high:.4f}]")

print("\n" + "="*60)
print("3. POOLED MODERATION MODEL WITHOUT CONTROLS (BA ~ SES * Race)")
print("="*60)
m_unadj_main = smf.logit('ba_completed ~ ses + C(race, Treatment("White"))', data=df).fit(disp=False)
m_unadj_int = smf.logit('ba_completed ~ ses * C(race, Treatment("White"))', data=df).fit(disp=False)

print(m_unadj_int.summary())

# Odds ratios for interaction model
params = m_unadj_int.params
conf = m_unadj_int.conf_int()
ors = np.exp(params)
ors_ci = np.exp(conf)
ors_table = pd.DataFrame({'OR': ors, 'CI_2.5%': ors_ci[0], 'CI_97.5%': ors_ci[1], 'p-value': m_unadj_int.pvalues})
print("\nOdds Ratios (Unadjusted):")
print(ors_table)

# Likelihood Ratio Test for unadjusted interaction
lr_stat_unadj = 2 * (m_unadj_int.llf - m_unadj_main.llf)
lr_pval_unadj = stats.chi2.sf(lr_stat_unadj, df=2)
print(f"\nLRT for unadjusted race interaction: Chi2 = {lr_stat_unadj:.4f}, p = {lr_pval_unadj:.4e}")

print("\n" + "="*60)
print("4. POOLED MODERATION MODEL WITH ACADEMIC CONTROLS")
print("="*60)
m_adj_main = smf.logit('ba_completed ~ ses + C(race, Treatment("White")) + asvab_ability + class_percentile + family_size + C(sex)', data=df).fit(disp=False)
m_adj_int = smf.logit('ba_completed ~ ses * C(race, Treatment("White")) + asvab_ability + class_percentile + family_size + C(sex)', data=df).fit(disp=False)

print(m_adj_int.summary())

# Odds ratios for adjusted model
params_adj = m_adj_int.params
conf_adj = m_adj_int.conf_int()
ors_adj = np.exp(params_adj)
ors_ci_adj = np.exp(conf_adj)
ors_table_adj = pd.DataFrame({'OR': ors_adj, 'CI_2.5%': ors_ci_adj[0], 'CI_97.5%': ors_ci_adj[1], 'p-value': m_adj_int.pvalues})
print("\nOdds Ratios (Adjusted):")
print(ors_table_adj)

# Likelihood Ratio Test for adjusted interaction
lr_stat_adj = 2 * (m_adj_int.llf - m_adj_main.llf)
lr_pval_adj = stats.chi2.sf(lr_stat_adj, df=2)
print(f"\nLRT for adjusted race interaction: Chi2 = {lr_stat_adj:.4f}, p = {lr_pval_adj:.4e}")

