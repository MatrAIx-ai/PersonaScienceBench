import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf
from scipy import stats

# 1. Load data
df = pd.read_csv('data/nls_raw.csv')
print(f"Total rows in raw data: {len(df)}")

# 2. Harmonize height
# In 1981: encoded as feet * 100 + inches (e.g., 507 = 5 ft 7 in = 67 in)
h81_raw = df['Height of respondent, 1981']
h81_inches = (h81_raw // 100) * 12 + (h81_raw % 100)
# Clean implausible values
h81_inches = h81_inches.where((h81_inches >= 48) & (h81_inches <= 84))

# In 1985: encoded directly in inches
h85_inches = df['Height of respondent, 1985']
h85_inches = h85_inches.where((h85_inches >= 48) & (h85_inches <= 84))

# Combine height (prefer 1985, fallback to 1981)
df['height_in'] = h85_inches.combine_first(h81_inches)

# 3. Clean weights
for yr in [1981, 1989, 1992]:
    w_col = f'Weight of respondent, {yr}'
    clean_col = f'weight_{yr}'
    # weights above 500 or below 60 are implausible / codes (e.g. 996)
    df[clean_col] = df[w_col].where((df[w_col] >= 60) & (df[w_col] <= 500))

# 4. Calculate BMI: (weight_lbs / height_in^2) * 703
df['bmi_81'] = (df['weight_1981'] / (df['height_in'] ** 2)) * 703
df['bmi_81'] = df['bmi_81'].where((df['bmi_81'] >= 12) & (df['bmi_81'] <= 70))

df['bmi_89'] = (df['weight_1989'] / (df['height_in'] ** 2)) * 703
df['bmi_89'] = df['bmi_89'].where((df['bmi_89'] >= 12) & (df['bmi_89'] <= 70))

df['bmi_92'] = (df['weight_1992'] / (df['height_in'] ** 2)) * 703
df['bmi_92'] = df['bmi_92'].where((df['bmi_92'] >= 12) & (df['bmi_92'] <= 70))

df['delta_bmi_81_89'] = df['bmi_89'] - df['bmi_81']

# 5. Time preference proxy
# Was more money put into or taken out of R/spouse savings since last interview, 1989
# 1: PUT MORE MONEY IN (Patient / Low time preference)
# 2: TOOK MORE MONEY OUT (Impatient / Higher time preference)
# 3: NO CHANGE
# 4: NO SAVINGS (Most impatient / Highest time preference)
sav_col = 'Was more money put into or taken out of R/spouse savings since last interview, 1989'
df['time_pref_cat'] = df[sav_col]

# Covariates
df['age_89'] = df['Age of respondent at interview date, 1989']
df['sex'] = df['Sex of respondent, 1979'] # 1=Male, 2=Female
df['race'] = df['Racial/ethnic cohort, 1979'] # 1=Black, 2=Hispanic, 3=Non-black non-hispanic
df['education'] = df['Highest grade completed, 1979']
# Income: replace <=0 with 1 for log transformation
income_89 = df['Total net family income, previous calendar year, 1989']
df['log_income_89'] = np.log(np.maximum(income_89.fillna(0), 1))
df['income_missing'] = income_89.isna().astype(int)

# ASVAB Cognitive scores
df['asvab_math'] = df['ASVAB - Mathematics Knowledge Z Score (rounded), 1981']
df['asvab_word'] = df['ASVAB - Word Knowledge Z Score (rounded), 1981']

# Net wealth 1990
df['net_wealth_90'] = df['Family net wealth, 1990']

print("\n--- Descriptive Statistics for BMI across Time Preference Categories (1989) ---")
labels = {1.0: "1: Put more money in (Low time pref)",
          2.0: "2: Took more money out (Moderate time pref)",
          3.0: "3: No change",
          4.0: "4: No savings (High time pref)"}

grouped = df.groupby('time_pref_cat')['bmi_89'].agg(
    count='count',
    mean='mean',
    std='std',
    median='median',
    q25=lambda x: x.quantile(0.25),
    q75=lambda x: x.quantile(0.75)
).reset_index()
grouped['Category'] = grouped['time_pref_cat'].map(labels)
print(grouped[['Category', 'count', 'mean', 'std', 'median', 'q25', 'q75']].to_string(index=False))

# ANOVA and Kruskal-Wallis tests
subsets = [df[df['time_pref_cat'] == c]['bmi_89'].dropna() for c in [1.0, 2.0, 3.0, 4.0]]
f_val, f_pval = stats.f_oneway(*subsets)
kw_val, kw_pval = stats.kruskal(*subsets)
print(f"\nANOVA F-statistic: {f_val:.4f}, p-value: {f_pval:.4e}")
print(f"Kruskal-Wallis H-statistic: {kw_val:.4f}, p-value: {kw_pval:.4e}")

# T-test comparing Category 1 (Put money in) vs Category 4 (No savings)
t_val, t_pval = stats.ttest_ind(subsets[0], subsets[3])
print(f"T-test Cat 1 vs Cat 4: t={t_val:.4f}, p-value={t_pval:.4e}, mean diff = {subsets[3].mean() - subsets[0].mean():.3f}")

print("\n--- Descriptive Statistics for BMI change (1981 to 1989) ---")
grouped_delta = df.groupby('time_pref_cat')['delta_bmi_81_89'].agg(
    count='count', mean='mean', std='std', median='median'
).reset_index()
grouped_delta['Category'] = grouped_delta['time_pref_cat'].map(labels)
print(grouped_delta[['Category', 'count', 'mean', 'std', 'median']].to_string(index=False))

# Regressions
print("\n================== REGRESSION MODELS ==================")
# Model 1: Bivariate OLS
m1 = smf.ols('bmi_89 ~ C(time_pref_cat, Treatment(reference=1))', data=df).fit()
print("\n--- Model 1: Unadjusted OLS ---")
print(m1.summary().tables[1])

# Model 2: Adding Demographics (age, sex, race)
m2 = smf.ols('bmi_89 ~ C(time_pref_cat, Treatment(reference=1)) + age_89 + C(sex) + C(race)', data=df).fit()
print("\n--- Model 2: Demographics Adjusted ---")
print(m2.summary().tables[1])

# Model 3: Adding Socioeconomic (education, income)
m3 = smf.ols('bmi_89 ~ C(time_pref_cat, Treatment(reference=1)) + age_89 + C(sex) + C(race) + education + log_income_89', data=df).fit()
print("\n--- Model 3: Demographics + SES Adjusted ---")
print(m3.summary().tables[1])

# Model 4: Adding Cognitive ability (ASVAB)
m4 = smf.ols('bmi_89 ~ C(time_pref_cat, Treatment(reference=1)) + age_89 + C(sex) + C(race) + education + log_income_89 + asvab_math + asvab_word', data=df).fit()
print("\n--- Model 4: Full Controls (including Cognitive Ability) ---")
print(m4.summary().tables[1])

# Model 5: Longitudinal / Lagged BMI (controlling for baseline 1981 BMI)
m5 = smf.ols('bmi_89 ~ C(time_pref_cat, Treatment(reference=1)) + bmi_81 + age_89 + C(sex) + C(race) + education + log_income_89', data=df).fit()
print("\n--- Model 5: Lagged Dependent Variable Model (Controlling for Baseline BMI 1981) ---")
print(m5.summary().tables[1])

# Model 6: Modeling Delta BMI directly
m6 = smf.ols('delta_bmi_81_89 ~ C(time_pref_cat, Treatment(reference=1)) + age_89 + C(sex) + C(race) + education + log_income_89', data=df).fit()
print("\n--- Model 6: BMI Change (Delta 1981-1989) Model ---")
print(m6.summary().tables[1])

# Model 7: Robustness on 1992 BMI
m7 = smf.ols('bmi_92 ~ C(time_pref_cat, Treatment(reference=1)) + age_89 + C(sex) + C(race) + education + log_income_89', data=df).fit()
print("\n--- Model 7: Robustness Check with 1992 BMI ---")
print(m7.summary().tables[1])

