import pandas as pd
import numpy as np
from scipy import stats
import statsmodels.api as sm
import statsmodels.formula.api as smf
import json

df = pd.read_csv('data/invaded_niche_pathways.csv', sep='\t')

# 1. Detailed Summary Table
summary_rows = []
for hab, g in df.groupby('habitat'):
    n_plots = len(g)
    gard_sum = int(g['n.gard'].sum())
    gard_mean = float(g['n.gard'].mean())
    gard_std = float(g['n.gard'].std())
    gard_se = float(gard_std / np.sqrt(n_plots))
    inv_plots = int((g['n.gard'] > 0).sum())
    pct_inv = float((inv_plots / n_plots) * 100)
    tot_alien = int(g['n.total'].sum())
    pct_gard_share = float((gard_sum / tot_alien * 100) if tot_alien > 0 else 0)
    unint_sum = int(g['n.unint'].sum())
    unint_mean = float(g['n.unint'].mean())
    agfo_sum = int(g['n.agfo'].sum())
    agfo_mean = float(g['n.agfo'].mean())
    
    summary_rows.append({
        'habitat': hab,
        'plots': n_plots,
        'n_gard_sum': gard_sum,
        'n_gard_mean': round(gard_mean, 4),
        'n_gard_se': round(gard_se, 4),
        'gard_invaded_plots': inv_plots,
        'gard_incidence_pct': round(pct_inv, 2),
        'n_total_alien': tot_alien,
        'gard_share_pct': round(pct_gard_share, 2),
        'n_unint_mean': round(unint_mean, 4),
        'n_agfo_mean': round(agfo_mean, 4)
    })

res_df = pd.DataFrame(summary_rows).sort_values(by='n_gard_mean', ascending=False)
res_df.to_csv('habitat_gardening_summary.csv', index=False)
print("=== HABITAT GARDENING SUMMARY ===")
print(res_df.to_string(index=False))

# 2. Hypothesis tests
groups = [g['n.gard'].values for _, g in df.groupby('habitat')]
kw_stat, kw_p = stats.kruskal(*groups)
f_stat, f_p = stats.f_oneway(*groups)

print(f"\nKruskal-Wallis: H = {kw_stat:.4f}, p = {kw_p:.4e}")
print(f"One-way ANOVA: F = {f_stat:.4f}, p = {f_p:.4e}")

# 3. GLM
df_renamed = df.rename(columns={
    'n.gard': 'n_gard', 'n.total': 'n_total', 'n.unint': 'n_unint', 'n.agfo': 'n_agfo',
    'urban.2009.500m': 'urban_500m', 'cropland.2009.500m': 'cropland_500m',
    'distance.road': 'dist_road', 'distance.stream': 'dist_stream'
})

poisson_fit = smf.glm('n_gard ~ C(habitat, Treatment(reference="Broad-leaved forests"))',
                      data=df_renamed, family=sm.families.Poisson()).fit()

# Controlled GLM
ctrl_poisson = smf.glm('n_gard ~ C(habitat, Treatment(reference="Broad-leaved forests")) + urban_500m + dist_road',
                       data=df_renamed, family=sm.families.Poisson()).fit()

# Macro-habitat categorization
def categorize_habitat(h):
    if h in ['Coastal', 'Wetlands', 'Urban', 'Riparian']:
        return 'High-Prevalence (Aquatic/Coastal/Urban)'
    elif h == 'Croplands':
        return 'Intermediate (Agricultural)'
    else:
        return 'Low-Prevalence (Natural/Semi-natural Terrestrial)'

df_renamed['habitat_macro'] = df_renamed['habitat'].apply(categorize_habitat)
macro_sum = df_renamed.groupby('habitat_macro').agg(
    plots=('n_gard', 'count'),
    total_gard=('n_gard', 'sum'),
    mean_gard=('n_gard', 'mean'),
    invaded_plots=('n_gard', lambda x: (x > 0).sum()),
    pct_invaded=('n_gard', lambda x: (x > 0).mean() * 100),
    total_alien=('n_total', 'sum')
).reset_index()
macro_sum['gard_share_pct'] = macro_sum['total_gard'] / macro_sum['total_alien'] * 100

print("\n=== MACRO HABITAT COMPARISON ===")
print(macro_sum.to_string(index=False))

# Mann-Whitney / Kruskal between macro groups
macro_groups = [g['n_gard'].values for _, g in df_renamed.groupby('habitat_macro')]
macro_kw, macro_p = stats.kruskal(*macro_groups)
print(f"\nMacro Groups Kruskal-Wallis: H = {macro_kw:.4f}, p = {macro_p:.4e}")

