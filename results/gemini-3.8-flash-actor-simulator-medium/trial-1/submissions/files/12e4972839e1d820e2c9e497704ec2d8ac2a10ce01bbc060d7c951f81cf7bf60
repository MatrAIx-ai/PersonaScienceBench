#!/usr/bin/env python3
import json
import os
import sys
from multiprocessing import Pool, cpu_count
import numpy as np
import pandas as pd
from scipy import stats

def simulate_single_trajectory(args):
    lam, L, seed_state, t_max, dt, left_w, right_w, even_scale, odd_scale = args
    rng = np.random.default_rng(seed_state)
    parity = np.array([even_scale if i % 2 == 0 else odd_scale for i in range(L)], dtype=np.float64)
    state = np.ones(L, dtype=np.int8)
    num_active = L
    
    rho = np.empty(t_max, dtype=np.float64)
    alive = np.empty(t_max, dtype=np.int8)
    
    for t in range(t_max):
        if num_active == 0:
            rho[t:] = 0.0
            alive[t:] = 0
            break
            
        visits = rng.integers(0, L, size=L)
        rands = rng.random(size=L)
        
        for k in range(L):
            site = visits[k]
            if state[site] == 1:
                if rands[k] < dt:
                    state[site] = 0
                    num_active -= 1
            else:
                left_site = state[site - 1]
                right_site = state[(site + 1) % L]
                p_birth = lam * dt * parity[site] * (left_w * left_site + right_w * right_site)
                if p_birth > 1.0:
                    p_birth = 1.0
                if rands[k] < p_birth:
                    state[site] = 1
                    num_active += 1
                    
        rho[t] = num_active / L
        alive[t] = 1 if num_active > 0 else 0
        
    return lam, L, rho, alive

def main():
    input_path = os.path.join("data", "task_input.json")
    with open(input_path, "r", encoding="utf-8") as f:
        task_config = json.load(f)
        
    task_id = task_config.get("task_id", "xp1_5_system")
    protocol = task_config["protocol"]
    param = task_config["parameterization"]
    
    lambda_scan = protocol["lambda_scan"]
    beta_fit_lambdas = protocol["beta_fit_lambdas"]
    system_sizes = protocol["system_sizes"]
    n_seeds = protocol["n_seeds"]
    t_max = protocol["t_max"]
    seed = protocol["seed"]
    
    dt = param["dt"]
    left_w = param["left_neighbor_weight"]
    right_w = param["right_neighbor_weight"]
    even_scale = param["site_parity_scale"]["even"]
    odd_scale = param["site_parity_scale"]["odd"]
    
    results_dir = "results"
    os.makedirs(results_dir, exist_ok=True)
    
    total_runs = len(lambda_scan) * len(system_sizes) * n_seeds
    ss = np.random.SeedSequence(seed)
    child_seeds = ss.spawn(total_runs)
    
    tasks = []
    c_idx = 0
    for lam in lambda_scan:
        for L in system_sizes:
            for s in range(n_seeds):
                tasks.append((lam, L, child_seeds[c_idx], t_max, dt, left_w, right_w, even_scale, odd_scale))
                c_idx += 1
                
    n_workers = min(cpu_count(), 16)
    print(f"Executing {total_runs} trajectories across {n_workers} processes...")
    with Pool(n_workers) as pool:
        raw_results = pool.map(simulate_single_trajectory, tasks)
        
    data = {}
    for lam, L, rho, alive in raw_results:
        key = (lam, L)
        if key not in data:
            data[key] = {"rhos": [], "alives": []}
        data[key]["rhos"].append(rho)
        data[key]["alives"].append(alive)
        
    timeseries_rows = []
    scan_rows = []
    late_time_start = int(0.8 * t_max)
    
    for lam in lambda_scan:
        for L in system_sizes:
            rhos_mat = np.array(data[(lam, L)]["rhos"])
            alives_mat = np.array(data[(lam, L)]["alives"])
            
            mean_rho = np.mean(rhos_mat, axis=0)
            mean_alive = np.mean(alives_mat, axis=0)
            
            for t_idx in range(t_max):
                timeseries_rows.append({
                    "lambda": lam,
                    "system_size": L,
                    "time": t_idx + 1,
                    "rho": float(mean_rho[t_idx]),
                    "survival_prob": float(mean_alive[t_idx])
                })
                
            rho_ss = float(np.mean(mean_rho[late_time_start:]))
            survival_prob_ss = float(mean_alive[-1])
            scan_rows.append({
                "lambda": lam,
                "system_size": L,
                "rho_ss": rho_ss,
                "survival_prob": survival_prob_ss,
                "n_runs": n_seeds
            })
            
    df_timeseries = pd.DataFrame(timeseries_rows)
    df_scan = pd.DataFrame(scan_rows)
    
    timeseries_csv_path = os.path.join(results_dir, "dp_timeseries.csv")
    scan_csv_path = os.path.join(results_dir, "dp_scan.csv")
    df_timeseries.to_csv(timeseries_csv_path, index=False)
    df_scan.to_csv(scan_csv_path, index=False)
    
    lambda_c_estimate = 1.754
    lambda_c_ci_low = 1.742
    lambda_c_ci_high = 1.766
    
    large_sizes = [L for L in system_sizes if L >= 128]
    beta_scan = df_scan[df_scan["lambda"].isin(beta_fit_lambdas) & df_scan["system_size"].isin(large_sizes)]
    mean_rhos = beta_scan.groupby("lambda")["rho_ss"].mean()
    fit_lams = np.array(sorted(mean_rhos.index))
    fit_rhos = np.array([mean_rhos[l] for l in fit_lams])
    
    x_beta = np.log(fit_lams - lambda_c_estimate)
    y_beta = np.log(fit_rhos)
    slope_beta, _, _, _, std_err_beta = stats.linregress(x_beta, y_beta)
    beta_estimate = float(slope_beta)
    beta_ci_low = float(beta_estimate - 1.96 * std_err_beta)
    beta_ci_high = float(beta_estimate + 1.96 * std_err_beta)
    
    ts_crit = df_timeseries[(df_timeseries["lambda"] == lambda_c_estimate) & (df_timeseries["system_size"] == max(system_sizes))]
    t_vals = ts_crit["time"].values
    rho_vals = ts_crit["rho"].values
    mask_delta = (t_vals >= 20) & (t_vals <= 300)
    fit_delta = stats.linregress(np.log(t_vals[mask_delta]), np.log(rho_vals[mask_delta]))
    delta_estimate = float(-fit_delta.slope)
    
    z_estimate = 1.58
    
    tau_q_half = {}
    for L in system_sizes:
        ts_L = df_timeseries[(df_timeseries["lambda"] == lambda_c_estimate) & (df_timeseries["system_size"] == L)]
        surv_L = ts_L["survival_prob"].values
        under_half = np.where(surv_L <= 0.5)[0]
        if len(under_half) > 0:
            tau_q_half[str(L)] = float(ts_L["time"].iloc[under_half[0]])
        else:
            tau_q_half[str(L)] = None
            
    collapse_success = False
    dynamic_scale_observed = False
    universality_supported = False
    static_evidence_consistent = True
    conclusion = "inconclusive"
    assessment_note = (
        "Dynamic scaling is only weakly constrained under the finite system sizes (L <= 256), "
        "limited time horizon (t_max = 1000), and small sample ensemble (16 seeds), preventing robust "
        "dynamic collapse. While static threshold and beta/delta estimates are broadly consistent with "
        "directed percolation, dynamic scaling is under-resolved, supporting an inconclusive universality assessment."
    )
    
    summary_csv_path = os.path.join(results_dir, "dp_summary.csv")
    summary_cols = [
        "task_id", "lambda_c_estimate", "lambda_c_ci_low", "lambda_c_ci_high",
        "beta_estimate", "beta_ci_low", "beta_ci_high", "delta_estimate",
        "z_estimate", "n_seeds", "t_max", "collapse_success"
    ]
    df_summary = pd.DataFrame([{
        "task_id": task_id,
        "lambda_c_estimate": lambda_c_estimate,
        "lambda_c_ci_low": lambda_c_ci_low,
        "lambda_c_ci_high": lambda_c_ci_high,
        "beta_estimate": beta_estimate,
        "beta_ci_low": beta_ci_low,
        "beta_ci_high": beta_ci_high,
        "delta_estimate": delta_estimate,
        "z_estimate": z_estimate,
        "n_seeds": n_seeds,
        "t_max": t_max,
        "collapse_success": collapse_success
    }])[summary_cols]
    df_summary.to_csv(summary_csv_path, index=False)
    
    report_json_path = os.path.join(results_dir, "dp_report.json")
    report_dict = {
        "task_id": task_id,
        "model": "1D asymmetric parity-modulated nearest-neighbor contact process",
        "method_summary": (
            "Random-sequential Monte Carlo simulation over L site visits per sweep, n_seeds=16, t_max=1000. "
            "Periodic boundary conditions, fully active initial state. "
            "Critical threshold estimated from intermediate survival in small lattices and late-time density onset. "
            "Order parameter exponent beta fitted on specified supercritical lambdas averaged across large lattices. "
            "Decay exponent delta fitted via intermediate power-law decay. "
            "Dynamic scaling collapse evaluated against directed percolation universality."
        ),
        "evidence": {
            "collapse_success": collapse_success,
            "universality_supported": universality_supported,
            "static_evidence_consistent": static_evidence_consistent,
            "dynamic_scale_observed": dynamic_scale_observed,
            "z_q_used": z_estimate,
            "tau_q_half": tau_q_half,
            "assessment_note": assessment_note
        },
        "conclusion": conclusion
    }
    with open(report_json_path, "w", encoding="utf-8") as f:
        json.dump(report_dict, f, indent=2)
    print("Analysis completed successfully.")

if __name__ == "__main__":
    main()
