import pandas as pd

# Load datasets
ts = pd.read_csv('data/time_series_data.csv')
cap = pd.read_csv('data/capital.csv')

ts['BCE'] = -ts['CE']

intervals = [
    ('20th c. BCE (2000-1901 BCE)', 1901, 2000),
    ('19th c. BCE (1900-1801 BCE)', 1801, 1900),
    ('18th c. BCE (1800-1701 BCE)', 1701, 1800),
    ('17th c. BCE (1700-1601 BCE)', 1601, 1700),
    ('16th c. BCE (1600-1501 BCE)', 1501, 1600),
    ('15th c. BCE (1500-1401 BCE)', 1401, 1500),
    ('14th c. BCE (1400-1301 BCE)', 1301, 1400),
    ('13th c. BCE (1300-1201 BCE)', 1201, 1300),
    ('12th c. BCE (1200-1101 BCE)', 1101, 1200),
]

results = []
for label, start_bce, end_bce in intervals:
    sub = ts[(ts['BCE'] >= start_bce) & (ts['BCE'] <= end_bce)]
    results.append({
        'Century': label,
        'Mean g_all': sub['g_all_mean'].mean(),
        'Max g_all': sub['g_all_mean'].max(),
        'Mean Pollen Growth': sub['pollen_grate_100'].mean(),
        'Max Pollen Growth': sub['pollen_grate_100'].max(),
        'Mean KDE Density': sub['kde_all_mean'].mean()
    })

df_res = pd.DataFrame(results)
print(df_res.to_string(index=False))
