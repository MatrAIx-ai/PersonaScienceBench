import os
import pandas as pd
import numpy as np
from scipy.stats import pearsonr, spearmanr

def run_analysis():
    # File paths
    gene_info_path = 'data/GeneMetaInfo_Zenodo.csv'
    sample_annot_path = 'data/Sample_annotated_Zenodo.csv'
    counts_path = 'data/BatchCorrectedReadCounts_Zenodo.csv'

    print("Loading data...")
    df_gene = pd.read_csv(gene_info_path)
    df_sample = pd.read_csv(sample_annot_path)
    
    # 1. Identify CD4 samples
    cd4_samples = df_sample[df_sample['celltype'] == 'CD4']['sample'].tolist()
    print(f"Total samples: {len(df_sample)}")
    print(f"CD4 samples count: {len(cd4_samples)}")

    # 2. Filter protein-coding genes
    pc_mask = df_gene['gene_biotype'] == 'protein_coding'
    pc_genes = df_gene[pc_mask].copy()
    print(f"Total genes: {len(df_gene)}")
    print(f"Protein-coding genes count: {len(pc_genes)}")

    # 3. Load counts for CD4 samples
    cols_to_load = ['Unnamed: 0'] + cd4_samples
    df_counts = pd.read_csv(counts_path, usecols=cols_to_load)
    
    # Ensure row alignment with df_gene
    # We merge or align by gene ID
    gene_id_col = df_counts.columns[0]
    df_counts = df_counts.rename(columns={gene_id_col: 'Geneid'})
    
    merged = pd.merge(pc_genes[['Geneid', 'Length', 'gene_biotype']], 
                      df_counts, 
                      on='Geneid', 
                      how='inner')
    
    print(f"Merged protein-coding genes count: {len(merged)}")
    
    # Check missing values
    missing_counts = merged[cd4_samples].isna().sum().sum()
    print(f"Missing count values in CD4 columns: {missing_counts}")

    # 4. Calculate mean expression across CD4 samples
    mean_expr = merged[cd4_samples].mean(axis=1)
    lengths = merged['Length'].astype(float)

    # 5. Primary analysis: Pearson correlation between Length and mean expression
    r_primary, p_primary = pearsonr(lengths, mean_expr)
    print("\n================ PRIMARY RESULT ================")
    print(f"Pearson correlation coefficient (r): {r_primary:.6f} ({r_primary})")
    print(f"p-value: {p_primary}")
    print("================================================\n")

    # 6. Sensitivity analyses
    print("Sensitivity Analyses:")
    
    # Log2(mean + 1)
    r_log_expr, p_log_expr = pearsonr(lengths, np.log2(mean_expr + 1))
    print(f"Pearson r (Length vs log2(mean_expr + 1)): {r_log_expr:.6f} (p = {p_log_expr})")

    # Log2(Length) vs Log2(mean + 1)
    r_log_both, p_log_both = pearsonr(np.log2(lengths), np.log2(mean_expr + 1))
    print(f"Pearson r (log2(Length) vs log2(mean_expr + 1)): {r_log_both:.6f} (p = {p_log_both})")

    # Nonzero mean expression
    nonzero_mask = mean_expr > 0
    print(f"Number of protein-coding genes with mean expression > 0: {nonzero_mask.sum()} / {len(merged)}")
    r_nonzero, p_nonzero = pearsonr(lengths[nonzero_mask], mean_expr[nonzero_mask])
    print(f"Pearson r (nonzero, untransformed): {r_nonzero:.6f} (p = {p_nonzero})")

    r_nonzero_log, p_nonzero_log = pearsonr(lengths[nonzero_mask], np.log2(mean_expr[nonzero_mask]))
    print(f"Pearson r (nonzero, log2(mean_expr)): {r_nonzero_log:.6f} (p = {p_nonzero_log})")

    # Spearman rank correlation
    rho_spearman, p_spearman = spearmanr(lengths, mean_expr)
    print(f"Spearman rank correlation: {rho_spearman:.6f} (p = {p_spearman})")

    # Save summary to text file as artifact record
    with open("results_summary.txt", "w") as out:
        out.write(f"Pearson correlation coefficient (r): {r_primary}\n")
        out.write(f"p-value: {p_primary}\n")
        out.write(f"Protein-coding genes: {len(merged)}\n")
        out.write(f"CD4 samples: {len(cd4_samples)}\n")
        out.write(f"Sensitivity log2(mean+1): {r_log_expr}\n")
        out.write(f"Sensitivity log2-log2: {r_log_both}\n")
        out.write(f"Sensitivity nonzero: {r_nonzero}\n")
        out.write(f"Sensitivity Spearman: {rho_spearman}\n")

if __name__ == '__main__':
    run_analysis()
