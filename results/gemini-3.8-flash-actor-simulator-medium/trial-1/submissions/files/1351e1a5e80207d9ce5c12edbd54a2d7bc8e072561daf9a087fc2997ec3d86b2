import pandas as pd
import numpy as np
import scipy.stats as stats
import statsmodels.api as sm
import statsmodels.formula.api as smf

def run_analysis():
    # 1. Load data
    df_niche = pd.read_csv('data/invaded_niche_pathways.csv', sep='\t')
    df_succ = pd.read_csv('data/invasion_success_pathways.csv')
    df_temp = pd.read_csv('data/temporal_trends_contingency_table.csv', sep='\t')

    # Standardize column names
    df_niche.columns = [c.replace('.', '_') for c in df_niche.columns]

    print("=== SUMMARY OF PATHWAY RICHNESS PER PLOT ===")
    print(df_niche[['n_gard', 'n_unint', 'n_agfo', 'n_total']].describe())

    print("\n=== SPEARMAN CORRELATIONS WITH URBAN COVER (2009, 500m) ===")
    for p in ['n_gard', 'n_unint', 'n_agfo', 'n_total']:
        r, pval = stats.spearmanr(df_niche[p], df_niche['urban_2009_500m'])
        print(f"{p} vs urban_2009_500m: r = {r:.4f}, p = {pval:.4e}")

    print("\n=== POISSON GLMs: EFFECT OF URBAN COVER AT 500m ===")
    for p in ['n_gard', 'n_unint', 'n_agfo', 'n_total']:
        m = smf.glm(f"{p} ~ urban_2009_500m", data=df_niche, family=sm.families.Poisson()).fit()
        print(f"{p}: coef = {m.params['urban_2009_500m']:.4f}, SE = {m.bse['urban_2009_500m']:.4f}, z = {m.tvalues['urban_2009_500m']:.3f}, p = {m.pvalues['urban_2009_500m']:.4e}, AIC = {m.aic:.1f}")

    print("\n=== MULTIVARIABLE STANDARDIZED NEGATIVE BINOMIAL GLMs ===")
    predictors = ['urban_2009_500m', 'cropland_2009_500m', 'elevation', 'distance_road', 'distance_stream', 'annual_rainfall']
    for col in predictors:
        df_niche[col + '_std'] = (df_niche[col] - df_niche[col].mean()) / df_niche[col].std()

    formula = " ~ urban_2009_500m_std + cropland_2009_500m_std + elevation_std + distance_road_std + distance_stream_std + annual_rainfall_std"
    for p in ['n_gard', 'n_unint', 'n_agfo', 'n_total']:
        m_nb = smf.glm(p + formula, data=df_niche, family=sm.families.NegativeBinomial(alpha=1.0)).fit()
        urban_coef = m_nb.params['urban_2009_500m_std']
        urban_p = m_nb.pvalues['urban_2009_500m_std']
        print(f"{p} ~ urban_2009_500m_std: coef = {urban_coef:.4f}, p = {urban_p:.4e}")

    print("\n=== INVASION SUCCESS TRAITS BY PATHWAY ===")
    print(df_succ.groupby('intro.pathway')[['number.of.invaded.plots', 'area.of.occupancy.10km', 'invaded.niche.breadth', 'native.niche.breadth']].mean())

    print("\n=== GROWTH FORM DISTRIBUTION BY PATHWAY ===")
    print(pd.crosstab(df_succ['intro.pathway'], df_succ['growth.form'], normalize='index') * 100)

if __name__ == '__main__':
    run_analysis()
