import pandas as pd
import numpy as np

# Load dataset
df = pd.read_csv('data/requirements_engineering_for_ML-enabled_systems.csv')

# Documentation columns in Q10
q10_cols = [
    'Q10_ML_Documentation_Notebooks',
    'Q10_ML_Documentation_User_Stories',
    'Q10_ML_Documentation_Requirements_Lists',
    'Q10_ML_Documentation_Prototypes',
    'Q10_ML_Documentation_Use_Case_Models',
    'Q10_ML_Documentation_Data_Models',
    'Q10_ML_Documentation_Goal_Models',
    'Q10_ML_Documentation_Vision_Document',
    'Q10_ML_Documentation_MLCanvas',
    'Q10_ML_Documentation_BDD_Scenarios',
    'Q10_ML_Documentation_Others',
    'Q10_ML_Documentation_Not_Documented'
]

# Raw counts and proportions
print('=== ANALISIS DE FORMATOS DE DOCUMENTACION (Q10) ===')
for col in q10_cols:
    quoted = (df[col] == 'quoted').sum()
    not_quoted = (df[col] == 'not quoted').sum()
    neg_77 = (df[col] == '-77').sum()
    p_total = quoted / len(df) * 100
    p_valid = quoted / (quoted + not_quoted) * 100
    print(f'{col}: {quoted} citas | {p_total:.2f}% de N=276 | {p_valid:.2f}% de N=194')

# Bootstrap simulation
np.random.seed(42)
B = 300
N = 276
arr_vision = np.array([1]*28 + [0]*(N - 28))
arr_canvas = np.array([1]*12 + [0]*(N - 12))

b_vision = [np.mean(np.random.choice(arr_vision, size=N, replace=True)) for _ in range(B)]
b_canvas = [np.mean(np.random.choice(arr_canvas, size=N, replace=True)) for _ in range(B)]

m_v = np.mean(b_vision) * 100
sem_v = np.std(b_vision) / np.sqrt(B) * 100
ci_v = [m_v - 1.96 * sem_v, m_v + 1.96 * sem_v]

m_c = np.mean(b_canvas) * 100
sem_c = np.std(b_canvas) / np.sqrt(B) * 100
ci_c = [m_c - 1.96 * sem_c, m_c + 1.96 * sem_c]

print('\n=== RESULTADOS BOOTSTRAP (B=300, N=276) ===')
print(f'Vision Document: {m_v:.3f}% (95% CI [{ci_v[0]:.3f}, {ci_v[1]:.3f}])')
print(f'ML Canvas: {m_c:.3f}% (95% CI [{ci_c[0]:.3f}, {ci_c[1]:.3f}])')
