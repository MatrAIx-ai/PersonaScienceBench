import os
import pandas as pd

def main():
    excel_path = "data/Supplemental Data File 1 PostvsPre_DEG_tables_ANNOTATED by_cell_type.xlsx"
    xl = pd.ExcelFile(excel_path)
    
    results = []
    
    for sheet_name in xl.sheet_names:
        df = pd.read_excel(xl, sheet_name=sheet_name)
        
        # Standardize column names
        gene_col = df.columns[0]
        
        total_tested = len(df)
        sig_padj_05 = (df['p_val_adj'] < 0.05).sum()
        sig_padj_01 = (df['p_val_adj'] < 0.01).sum()
        sig_padj_001 = (df['p_val_adj'] < 0.001).sum()
        sig_padj_05_fc05 = ((df['p_val_adj'] < 0.05) & (df['avg_log2FC'].abs() >= 0.5)).sum()
        sig_pval_05 = (df['p_val'] < 0.05).sum()
        
        # Breakdown into upregulated and downregulated for padj < 0.05
        up_padj_05 = ((df['p_val_adj'] < 0.05) & (df['avg_log2FC'] > 0)).sum()
        down_padj_05 = ((df['p_val_adj'] < 0.05) & (df['avg_log2FC'] < 0)).sum()
        
        results.append({
            'cell_type': sheet_name,
            'total_tested': total_tested,
            'padj_lt_0.05': sig_padj_05,
            'up_padj_lt_0.05': up_padj_05,
            'down_padj_lt_0.05': down_padj_05,
            'padj_lt_0.01': sig_padj_01,
            'padj_lt_0.001': sig_padj_001,
            'padj_lt_0.05_log2FC_gte_0.5': sig_padj_05_fc05,
            'pval_lt_0.05': sig_pval_05
        })
        
    res_df = pd.DataFrame(results)
    res_df = res_df.sort_values(by='padj_lt_0.05', ascending=False).reset_index(drop=True)
    
    print("=" * 80)
    print("DIFFERENTIALLY EXPRESSED GENES (DEG) SUMMARY BY CELL TYPE (Post vs Pre AAV9)")
    print("=" * 80)
    print(res_df.to_string(index=False))
    print("=" * 80)
    
    top_cell_type = res_df.iloc[0]['cell_type']
    top_deg_count = res_df.iloc[0]['padj_lt_0.05']
    print(f"\nTop cell type with highest number of significant DEGs (padj < 0.05):")
    print(f"Cell type: {top_cell_type}")
    print(f"Significant DEGs (padj < 0.05): {top_deg_count} (Up: {res_df.iloc[0]['up_padj_lt_0.05']}, Down: {res_df.iloc[0]['down_padj_lt_0.05']})")
    
    # Save to CSV
    output_csv = "deg_summary_by_cell_type.csv"
    res_df.to_csv(output_csv, index=False)
    print(f"\nResults successfully saved to {output_csv}")

if __name__ == "__main__":
    main()
