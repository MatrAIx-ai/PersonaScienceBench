import pandas as pd
import numpy as np

def run_analysis():
    excel_path = 'data/Supplemental Data File 1 PostvsPre_DEG_tables_ANNOTATED by_cell_type.xlsx'
    xls = pd.ExcelFile(excel_path)
    
    results = []
    gene_details = {}
    
    for sheet_name in xls.sheet_names:
        df = pd.read_excel(xls, sheet_name=sheet_name)
        df.rename(columns={'Unnamed: 0': 'gene'}, inplace=True)
        
        # Primary significance threshold
        sig_mask = df['p_val_adj'] < 0.05
        
        # Subsets and counts
        total_tested = len(df)
        n_sig_adj05 = sig_mask.sum()
        n_sig_adj01 = (df['p_val_adj'] < 0.01).sum()
        n_sig_adj001 = (df['p_val_adj'] < 0.001).sum()
        n_sig_raw05 = (df['p_val'] < 0.05).sum()
        
        # Fold change thresholds among sig (p_val_adj < 0.05)
        n_fc_025 = (sig_mask & (df['avg_log2FC'].abs() >= 0.25)).sum()
        n_fc_050 = (sig_mask & (df['avg_log2FC'].abs() >= 0.50)).sum()
        n_fc_100 = (sig_mask & (df['avg_log2FC'].abs() >= 1.00)).sum()
        
        # Directionality among sig (p_val_adj < 0.05)
        n_up = (sig_mask & (df['avg_log2FC'] > 0)).sum()
        n_down = (sig_mask & (df['avg_log2FC'] < 0)).sum()
        
        results.append({
            'Cell_Type': sheet_name,
            'Total_Tested': total_tested,
            'Sig_DEGs_padj_0.05': n_sig_adj05,
            'Up_regulated': n_up,
            'Down_regulated': n_down,
            'Sig_DEGs_padj_0.01': n_sig_adj01,
            'Sig_DEGs_padj_0.001': n_sig_adj001,
            'Sig_padj05_FC0.25': n_fc_025,
            'Sig_padj05_FC0.50': n_fc_050,
            'Sig_padj05_FC1.00': n_fc_100,
            'Raw_p_0.05': n_sig_raw05
        })
        
        if n_sig_adj05 > 0:
            gene_details[sheet_name] = df[sig_mask].sort_values(by='p_val_adj')
            
    res_df = pd.DataFrame(results).sort_values(by='Sig_DEGs_padj_0.05', ascending=False).reset_index(drop=True)
    res_df['Rank'] = range(1, len(res_df) + 1)
    cols = ['Rank', 'Cell_Type', 'Sig_DEGs_padj_0.05', 'Up_regulated', 'Down_regulated', 
            'Sig_DEGs_padj_0.01', 'Sig_DEGs_padj_0.001', 'Sig_padj05_FC0.25', 'Sig_padj05_FC0.50', 'Sig_padj05_FC1.00', 'Total_Tested']
    res_df = res_df[cols]
    
    print("=== SUMMARY OF DIFFERENTIAL EXPRESSION ACROSS CELL TYPES ===")
    print(res_df.to_string(index=False))
    
    res_df.to_csv('deg_summary_by_cell_type.csv', index=False)
    
    top_cell_type = res_df.iloc[0]['Cell_Type']
    top_sig_count = res_df.iloc[0]['Sig_DEGs_padj_0.05']
    print(f"\nTop cell type with highest number of significantly DEGs (p_val_adj < 0.05): {top_cell_type} ({top_sig_count} genes)")
    
    # Detail top genes for the winning cell type
    top_genes_df = gene_details[top_cell_type]
    print(f"\nTop 15 most significant genes in {top_cell_type}:")
    print(top_genes_df[['gene', 'avg_log2FC', 'p_val', 'p_val_adj', 'pct.1', 'pct.2']].head(15).to_string(index=False))

if __name__ == '__main__':
    run_analysis()
