import pandas as pd
import statsmodels.api as sm
import statsmodels.formula.api as smf

def run_analysis():
    # Load dataset
    df = pd.read_csv('data/nls_ses_processed.csv')
    df['BA_DEGREE_COMPLETED_INT'] = df['BA DEGREE COMPLETED'].astype(int)

    print("=== Dataset Summary ===")
    print(f"Total observations: {len(df)}")
    print(f"Columns: {list(df.columns)}")
    print(f"BA degree completed counts:\n{df['BA DEGREE COMPLETED'].value_counts()}")
    print()

    # Model 1: Baseline model examining social background factors (SES, Sex, Race)
    # Testing SES effect without academic characteristics vs with academic characteristics
    
    print("=== Model Comparisons for SES and Social Background Variables ===")
    
    # Baseline models
    m1_ses_race_sex = smf.logit('BA_DEGREE_COMPLETED_INT ~ SES + C(SAMPLE_RACE) + C(SAMPLE_SEX)', data=df).fit(disp=False)
    m1_ses_race = smf.logit('BA_DEGREE_COMPLETED_INT ~ SES + C(SAMPLE_RACE)', data=df).fit(disp=False)
    m1_ses = smf.logit('BA_DEGREE_COMPLETED_INT ~ SES', data=df).fit(disp=False)
    
    print("\n[Baseline Model: SES + Race + Sex]")
    print(f"SES coefficient: {m1_ses_race_sex.params['SES']:.4f}, p-value: {m1_ses_race_sex.pvalues['SES']:.4f}")
    
    # Full models: Including academic characteristics (ABILITY and PERCENTILE IN CLASS)
    m2_full = smf.logit('BA_DEGREE_COMPLETED_INT ~ SES + C(SAMPLE_RACE) + C(SAMPLE_SEX) + Q("ABILITY: COMPOSITE OF ASVAB SCORE") + Q("PERCENTILE IN CLASS")', data=df).fit(disp=False)
    m2_no_sex = smf.logit('BA_DEGREE_COMPLETED_INT ~ SES + C(SAMPLE_RACE) + Q("ABILITY: COMPOSITE OF ASVAB SCORE") + Q("PERCENTILE IN CLASS")', data=df).fit(disp=False)
    
    print("\n[Full Model: SES + Race + Sex + Academic Characteristics]")
    print(f"SES coefficient: {m2_full.params['SES']:.4f}, p-value: {m2_full.pvalues['SES']:.4f}")
    print(m2_full.summary())
    
    print("\n[Full Model: SES + Race + Academic Characteristics]")
    print(f"SES coefficient: {m2_no_sex.params['SES']:.4f}, p-value: {m2_no_sex.pvalues['SES']:.4f}")

    # Check other variables
    print("\n=== Tracking other candidate variables ===")
    for var in ['SAMPLE_SEX', 'FAMILY SIZE OF SAMPLE']:
        print(f"\nChecking variable: {var}")
        base_f = f'BA_DEGREE_COMPLETED_INT ~ Q("{var}")'
        full_f = f'BA_DEGREE_COMPLETED_INT ~ Q("{var}") + C(SAMPLE_RACE) + Q("ABILITY: COMPOSITE OF ASVAB SCORE") + Q("PERCENTILE IN CLASS")'
        m_b = smf.logit(base_f, data=df).fit(disp=False)
        m_f = smf.logit(full_f, data=df).fit(disp=False)
        print("Base params:\n", m_b.params)
        print("Full params:\n", m_f.params)

if __name__ == '__main__':
    run_analysis()
