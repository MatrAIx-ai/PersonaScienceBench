#!/usr/bin/env python3
"""
2D XY Model Kosterlitz-Thouless Transition Simulation and Analysis.
"""
import os, json, time, zlib, struct, ctypes, subprocess
import numpy as np
from scipy.optimize import minimize_scalar

SO_PATH = os.path.join(os.path.dirname(os.path.abspath(__file__)), "sim_engine.so")
C_PATH = os.path.join(os.path.dirname(os.path.abspath(__file__)), "sim_engine.c")

if not os.path.exists(SO_PATH):
    if os.path.exists(C_PATH):
        subprocess.check_call(["gcc", "-O3", "-shared", "-fPIC", C_PATH, "-lm", "-o", SO_PATH])
    else:
        raise FileNotFoundError("sim_engine.so or sim_engine.c required.")

class RunStats(ctypes.Structure):
    _fields_ = [
        ("upsilon", ctypes.c_double),
        ("defect_density", ctypes.c_double),
        ("chi", ctypes.c_double),
        ("xi_2nd_ratio", ctypes.c_double)
    ]

lib = ctypes.CDLL(SO_PATH)
lib.run_simulation.argtypes = [
    ctypes.c_int, ctypes.c_double,
    ctypes.c_int, ctypes.c_int,
    ctypes.c_int, ctypes.c_int, ctypes.c_int,
    ctypes.c_double,
    ctypes.POINTER(ctypes.c_double),
    ctypes.c_uint64,
    ctypes.POINTER(ctypes.c_double),
    ctypes.POINTER(RunStats),
    ctypes.POINTER(ctypes.c_double),
    ctypes.c_int, ctypes.c_int,
    ctypes.c_int, ctypes.POINTER(RunStats)
]

def analyze_dataset(scan_a, scan_b, cur_obs_a, cur_obs_f, cur_obs_e, cur_obs_d):
    two_over_pi = 2.0 / np.pi
    n_a, n_b = len(scan_a), len(scan_b)
    log_L_all = np.log(scan_b)
    x_all = 1.0 / log_L_all

    size_tc = []
    for i, L in enumerate(scan_b):
        diff = cur_obs_a[i, :] - two_over_pi * scan_a
        roots = []
        for j in range(n_a - 1):
            if diff[j] * diff[j+1] <= 0:
                frac = -diff[j] / (diff[j+1] - diff[j])
                roots.append(scan_a[j] + frac * (scan_a[j+1] - scan_a[j]))
        if roots:
            size_tc.append(roots[-1])
        else:
            p = np.polyfit(scan_a[-3:], diff[-3:], 1)
            size_tc.append(-p[1] / p[0])
    size_weighted_tc = float(np.average(size_tc, weights=scan_b))

    beta_ups = cur_obs_a / scan_a[np.newaxis, :]
    fs_intercepts, fs_slopes = [], []
    for j in range(n_a):
        p = np.polyfit(x_all, beta_ups[:, j], 1)
        fs_slopes.append(float(p[0]))
        fs_intercepts.append(float(p[1]))
    fs_intercepts = np.array(fs_intercepts)
    fs_tc = None
    for j in range(n_a - 1):
        if (fs_intercepts[j] - two_over_pi) * (fs_intercepts[j+1] - two_over_pi) <= 0:
            frac = (two_over_pi - fs_intercepts[j]) / (fs_intercepts[j+1] - fs_intercepts[j])
            fs_tc = float(scan_a[j] + frac * (scan_a[j+1] - scan_a[j]))
            break
    if fs_tc is None:
        p = np.polyfit(scan_a, fs_intercepts, 1)
        fs_tc = float((two_over_pi - p[1]) / p[0])
    fs_res = float(np.interp(fs_tc, scan_a, fs_intercepts) - two_over_pi)

    dim_intercepts, dim_slopes = [], []
    for j in range(n_a):
        p = np.polyfit(x_all, cur_obs_e[:, j], 1)
        dim_slopes.append(float(p[0]))
        dim_intercepts.append(float(p[1]))
    dim_slopes = np.array(dim_slopes)
    crossings = []
    for j in range(n_a - 1):
        if dim_slopes[j] * dim_slopes[j+1] <= 0:
            frac = -dim_slopes[j] / (dim_slopes[j+1] - dim_slopes[j])
            crossings.append(float(scan_a[j] + frac * (scan_a[j+1] - scan_a[j])))
    if crossings:
        dim_tc = min(crossings, key=lambda t: abs(t - 0.893))
    else:
        p = np.polyfit(scan_a, dim_slopes, 1)
        dim_tc = float(-p[1] / p[0])
    dim_res = float(np.interp(dim_tc, scan_a, dim_slopes))

    eta_arr = cur_obs_d[:, 1]
    exp_tc = None
    for j in range(n_a - 1):
        if (eta_arr[j] - 0.25) * (eta_arr[j+1] - 0.25) <= 0:
            frac = (0.25 - eta_arr[j]) / (eta_arr[j+1] - eta_arr[j])
            exp_tc = float(scan_a[j] + frac * (scan_a[j+1] - scan_a[j]))
            break
    if exp_tc is None:
        p = np.polyfit(scan_a, eta_arr, 1)
        exp_tc = float((0.25 - p[1]) / p[0])
    exp_res = float(np.interp(exp_tc, scan_a, eta_arr) - 0.25)

    res_min_axes = [32, 50, 68]
    res_best_T, res_best_C, res_best_val, res_traces = [], [], [], []
    for l_min in res_min_axes:
        mask = scan_b >= l_min
        sub_L = scan_b[mask]
        sub_obs = cur_obs_a[mask, :]
        log_sub_L = np.log(sub_L)
        trace, Cs = [], []
        for j, T in enumerate(scan_a):
            y = sub_obs[:, j]
            norm_y = np.linalg.norm(y)
            def loss_wm(C):
                denom = 2.0 * (log_sub_L + C)
                if np.any(denom <= 0): return 1e6
                pred = (2.0 * T / np.pi) * (1.0 + 1.0 / denom)
                return np.linalg.norm(y - pred) / norm_y
            r_wm = minimize_scalar(loss_wm, bounds=(-1.5, 20.0), method="bounded")
            trace.append(float(r_wm.fun))
            Cs.append(float(r_wm.x))
        res_traces.append(trace)
        b_idx = int(np.argmin(trace))
        res_best_T.append(float(scan_a[b_idx]))
        res_best_C.append(float(Cs[b_idx]))
        res_best_val.append(float(trace[b_idx]))

    sel_res_lmin = 32
    sel_idx = res_min_axes.index(sel_res_lmin)
    pref_tc = res_best_T[sel_idx]
    pref_C = res_best_C[sel_idx]
    pref_res = res_best_val[sel_idx]
    res_spread = float(max(res_best_T) - min(res_best_T))

    resp_min_axes = [32, 50, 68]
    resp_best_T, resp_best_C, resp_best_val, resp_traces = [], [], [], []
    for l_min in resp_min_axes:
        mask = scan_b >= l_min
        sub_L = scan_b[mask]
        sub_obs = cur_obs_f[mask, :]
        log_sub_L = np.log(sub_L)
        trace, Cs = [], []
        for j, T in enumerate(scan_a):
            y = sub_obs[:, j]
            norm_y = np.linalg.norm(y)
            def loss_resp(C):
                arg = log_sub_L + C
                if np.any(arg <= 0): return 1e6
                f_L = (sub_L ** 1.75) * (arg ** 0.125)
                A = np.dot(y, f_L) / np.dot(f_L, f_L)
                return np.linalg.norm(y - A * f_L) / norm_y
            r_resp = minimize_scalar(loss_resp, bounds=(-1.5, 20.0), method="bounded")
            trace.append(float(r_resp.fun))
            Cs.append(float(r_resp.x))
        resp_traces.append(trace)
        b_idx = int(np.argmin(trace))
        resp_best_T.append(float(scan_a[b_idx]))
        resp_best_C.append(float(Cs[b_idx]))
        resp_best_val.append(float(trace[b_idx]))

    sel_resp_lmin = 32
    sel_r_idx = resp_min_axes.index(sel_resp_lmin)
    resp_tc = resp_best_T[sel_r_idx]
    resp_C = resp_best_C[sel_r_idx]
    resp_res = resp_best_val[sel_r_idx]
    resp_spread = float(max(resp_best_T) - min(resp_best_T))

    comp_estimates = [pref_tc, size_weighted_tc, fs_tc, dim_tc, exp_tc]
    consensus_tc = float(np.mean(comp_estimates))
    consensus_spread = float(max(comp_estimates) - min(comp_estimates))

    return {
        "size_transition_estimates": [float(x) for x in size_tc],
        "size_weighted_transition_estimate": size_weighted_tc,
        "finite_size_intercepts": [float(x) for x in fs_intercepts],
        "finite_size_slopes": [float(x) for x in fs_slopes],
        "finite_size_transition_estimate": fs_tc,
        "finite_size_transition_residual": fs_res,
        "dimensionless_ratio_intercepts": [float(x) for x in dim_intercepts],
        "dimensionless_ratio_slopes": [float(x) for x in dim_slopes],
        "dimensionless_ratio_transition_estimate": dim_tc,
        "dimensionless_ratio_transition_residual": dim_res,
        "exponent_transition_estimate": exp_tc,
        "exponent_transition_residual": exp_res,
        "residual_sweep_min_axis_values": res_min_axes,
        "residual_sweep_best_axis_a_values": res_best_T,
        "residual_sweep_best_offset_values": res_best_C,
        "residual_sweep_best_residual_values": res_best_val,
        "residual_sweep_traces": res_traces,
        "response_sweep_min_axis_values": resp_min_axes,
        "response_sweep_best_axis_a_values": resp_best_T,
        "response_sweep_best_offset_values": resp_best_C,
        "response_sweep_best_residual_values": resp_best_val,
        "response_sweep_traces": resp_traces,
        "selected_residual_sweep_min_axis": sel_res_lmin,
        "selected_response_sweep_min_axis": sel_resp_lmin,
        "preferred_transition_temperature": pref_tc,
        "preferred_inverse_temperature": 1.0 / pref_tc,
        "preferred_offset_value": pref_C,
        "preferred_residual_value": pref_res,
        "residual_sweep_stability_spread": res_spread,
        "response_transition_temperature": resp_tc,
        "response_offset_value": resp_C,
        "response_residual_value": resp_res,
        "response_sweep_stability_spread": resp_spread,
        "transition_component_estimates": comp_estimates,
        "consensus_transition_temperature": consensus_tc,
        "consensus_transition_spread": consensus_spread
    }

def write_png(filename, img_array):
    H, W, _ = img_array.shape
    raw_data = bytearray()
    for row in img_array:
        raw_data.append(0)
        raw_data.extend(row.tobytes())
    compressed = zlib.compress(bytes(raw_data), 6)
    def chunk(tag, data):
        return struct.pack(">I", len(data)) + tag + data + struct.pack(">I", zlib.crc32(tag + data))
    with open(filename, "wb") as f:
        f.write(b"\x89PNG\r\n\x1a\n")
        f.write(chunk(b"IHDR", struct.pack(">IIBBBBB", W, H, 8, 2, 0, 0, 0)))
        f.write(chunk(b"IDAT", compressed))
        f.write(chunk(b"IEND", b""))

def generate_overview_figure(scan_a, scan_b, probe_a, obs_a, obs_b, obs_c, obs_d, obs_e, obs_f, focus_rows):
    W, H = 1400, 900
    canvas = np.ones((H, W, 3), dtype=np.uint8) * 255
    panels = [
        {"x": 60, "y": 50, "w": 380, "h": 220},
        {"x": 510, "y": 50, "w": 380, "h": 220},
        {"x": 960, "y": 50, "w": 380, "h": 220},
        {"x": 60, "y": 330, "w": 380, "h": 220},
        {"x": 510, "y": 330, "w": 380, "h": 220},
        {"x": 960, "y": 330, "w": 380, "h": 220}
    ]
    for p in panels:
        px, py, pw, ph = p["x"], p["y"], p["w"], p["h"]
        canvas[py:py+ph, px:px+pw] = [250, 250, 252]
        canvas[py, px:px+pw] = [180, 180, 180]
        canvas[py+ph-1, px:px+pw] = [180, 180, 180]
        canvas[py:py+ph, px] = [180, 180, 180]
        canvas[py:py+ph, px+pw-1] = [180, 180, 180]

    colors = [
        [31, 119, 180], [255, 127, 14], [44, 160, 44],
        [214, 39, 40], [148, 103, 189], [140, 86, 75]
    ]

    def draw_line(x0, y0, x1, y1, color):
        dx, dy = abs(x1 - x0), abs(y1 - y0)
        sx = 1 if x0 < x1 else -1
        sy = 1 if y0 < y1 else -1
        err = dx - dy
        x, y = x0, y0
        while True:
            for tx in (-1, 0, 1):
                for ty in (-1, 0, 1):
                    if 0 <= y+ty < H and 0 <= x+tx < W: canvas[y+ty, x+tx] = color
            if x == x1 and y == y1: break
            e2 = 2 * err
            if e2 > -dy: err -= dy; x += sx
            if e2 < dx: err += dx; y += sy

    def map_pt(vx, vy, x0, x1, y0, y1, px, py, pw, ph):
        ix = int(px + (vx - x0) / (x1 - x0) * (pw - 20) + 10)
        iy = int(py + ph - 10 - (vy - y0) / (y1 - y0) * (ph - 20))
        return max(px, min(px+pw-1, ix)), max(py, min(py+ph-1, iy))

    min_x, max_x = scan_a[0], scan_a[-1]
    # P0: Upsilon
    p = panels[0]
    pt0 = map_pt(min_x, (2.0/np.pi)*min_x, min_x, max_x, 0.45, 0.75, p["x"], p["y"], p["w"], p["h"])
    pt1 = map_pt(max_x, (2.0/np.pi)*max_x, min_x, max_x, 0.45, 0.75, p["x"], p["y"], p["w"], p["h"])
    draw_line(pt0[0], pt0[1], pt1[0], pt1[1], [150, 150, 150])
    for i in range(len(scan_b)):
        pts = [map_pt(scan_a[j], obs_a[i, j], min_x, max_x, 0.45, 0.75, p["x"], p["y"], p["w"], p["h"]) for j in range(len(scan_a))]
        for k in range(len(pts)-1): draw_line(pts[k][0], pts[k][1], pts[k+1][0], pts[k+1][1], colors[i % len(colors)])

    # P1: Defects
    p = panels[1]
    max_d = float(np.max(obs_b) * 1.1)
    for i in range(len(scan_b)):
        pts = [map_pt(scan_a[j], obs_b[i, j], min_x, max_x, 0.0, max_d, p["x"], p["y"], p["w"], p["h"]) for j in range(len(scan_a))]
        for k in range(len(pts)-1): draw_line(pts[k][0], pts[k][1], pts[k+1][0], pts[k+1][1], colors[i % len(colors)])

    # P2: Chi
    p = panels[2]
    max_chi = float(np.max(obs_f) * 1.05)
    for i in range(len(scan_b)):
        pts = [map_pt(scan_a[j], obs_f[i, j], min_x, max_x, 0.0, max_chi, p["x"], p["y"], p["w"], p["h"]) for j in range(len(scan_a))]
        for k in range(len(pts)-1): draw_line(pts[k][0], pts[k][1], pts[k+1][0], pts[k+1][1], colors[i % len(colors)])

    # P3: xi_2nd / L
    p = panels[3]
    min_xi, max_xi = float(np.min(obs_e) * 0.9), float(np.max(obs_e) * 1.1)
    for i in range(len(scan_b)):
        pts = [map_pt(scan_a[j], obs_e[i, j], min_x, max_x, min_xi, max_xi, p["x"], p["y"], p["w"], p["h"]) for j in range(len(scan_a))]
        for k in range(len(pts)-1): draw_line(pts[k][0], pts[k][1], pts[k+1][0], pts[k+1][1], colors[i % len(colors)])

    # P4: G(r)
    p = panels[4]
    for idx, r_idx in enumerate(focus_rows):
        gr = obs_c[idx]
        pts = []
        for r in range(len(probe_a)):
            v = max(0.005, gr[r])
            ix = int(p["x"] + (np.log(probe_a[r]) - np.log(1.0)) / (np.log(50.0) - np.log(1.0)) * (p["w"] - 20) + 10)
            iy = int(p["y"] + p["h"] - 10 - (np.log(v) - np.log(0.005)) / (np.log(1.0) - np.log(0.005)) * (p["h"] - 20))
            pts.append((ix, iy))
        for k in range(len(pts)-1): draw_line(pts[k][0], pts[k][1], pts[k+1][0], pts[k+1][1], colors[idx % len(colors)])

    # P5: Exponent eta(T)
    p = panels[5]
    pt0 = map_pt(min_x, 0.25, min_x, max_x, 0.15, 0.35, p["x"], p["y"], p["w"], p["h"])
    pt1 = map_pt(max_x, 0.25, min_x, max_x, 0.15, 0.35, p["x"], p["y"], p["w"], p["h"])
    draw_line(pt0[0], pt0[1], pt1[0], pt1[1], [220, 50, 50])
    pts = [map_pt(obs_d[j, 0], obs_d[j, 1], min_x, max_x, 0.15, 0.35, p["x"], p["y"], p["w"], p["h"]) for j in range(len(scan_a))]
    for k in range(len(pts)-1): draw_line(pts[k][0], pts[k][1], pts[k+1][0], pts[k+1][1], [0, 0, 160])

    write_png("overview.png", canvas)

def run_all():
    print("Loading data...")
    with open("data/control_primary.json") as f:
        ctrl = json.load(f)
    scan_a = np.load("data/scan_axis_a.npy")
    scan_b = np.load("data/scan_axis_b.npy")
    probe_a = np.load("data/probe_axis_a.npy")
    states = np.load("data/state_tokens.npz")

    sp = ctrl["stage_plan"]
    focus_rows = ctrl["focus_probe_rows"]
    fit_window = ctrl["fit_window_probe"]
    n_b, n_a, n_probe = len(scan_b), len(scan_a), len(probe_a)
    n_blocks = 10

    obs_a = np.zeros((n_b, n_a))
    obs_b = np.zeros((n_b, n_a))
    obs_e = np.zeros((n_b, n_a))
    obs_f = np.zeros((n_b, n_a))
    obs_c = np.zeros((len(focus_rows), n_probe))
    all_Gr = np.zeros((n_a, n_probe))

    block_upsilon = np.zeros((n_blocks, n_b, n_a))
    block_defect = np.zeros((n_blocks, n_b, n_a))
    block_chi = np.zeros((n_blocks, n_b, n_a))
    block_xi_ratio = np.zeros((n_blocks, n_b, n_a))

    print("Running simulations...")
    for i, L in enumerate(scan_b):
        slot_key = ctrl["state_bundle"]["keys"][i]
        init_state = np.ascontiguousarray(states[slot_key], dtype=np.float64)
        is_largest = (L == ctrl["largest_axis_b_value"])
        for j, T in enumerate(scan_a):
            stats = RunStats()
            b_stats = (RunStats * n_blocks)()
            out_Gr = np.zeros(n_probe, dtype=np.float64) if is_largest else None
            Gr_ptr = out_Gr.ctypes.data_as(ctypes.POINTER(ctypes.c_double)) if is_largest else None
            seed = 20261019 + i * 1000 + j * 37
            lib.run_simulation(
                int(L), float(T),
                sp["warmup_passes"], sp["sampling_passes"],
                sp["local_stage_repeats"], sp["reflection_stage_repeats"], sp["cluster_stage_repeats"],
                sp["metropolis_proposal_width"],
                init_state.ctypes.data_as(ctypes.POINTER(ctypes.c_double)),
                seed, None, ctypes.byref(stats), Gr_ptr,
                n_probe if is_largest else 0, sp["probe_stride"],
                n_blocks, b_stats
            )
            obs_a[i, j] = stats.upsilon
            obs_b[i, j] = stats.defect_density
            obs_e[i, j] = stats.xi_2nd_ratio
            obs_f[i, j] = stats.chi
            for b in range(n_blocks):
                block_upsilon[b, i, j] = b_stats[b].upsilon
                block_defect[b, i, j] = b_stats[b].defect_density
                block_chi[b, i, j] = b_stats[b].chi
                block_xi_ratio[b, i, j] = b_stats[b].xi_2nd_ratio
            if is_largest:
                all_Gr[j] = out_Gr

    for idx, r_idx in enumerate(focus_rows):
        obs_c[idx] = all_Gr[r_idx]

    obs_d = np.zeros((n_a, 2))
    fit_mask = (probe_a >= fit_window[0]) & (probe_a <= fit_window[1])
    log_r = np.log(probe_a[fit_mask])
    for j, T in enumerate(scan_a):
        gr = all_Gr[j, fit_mask]
        pos = gr > 0
        eta_val = float(-np.polyfit(log_r[pos], np.log(gr[pos]), 1)[0]) if np.sum(pos) >= 3 else 0.25
        obs_d[j, 0] = float(T)
        obs_d[j, 1] = eta_val

    np.save("obs_matrix_a.npy", obs_a)
    np.save("obs_matrix_b.npy", obs_b)
    np.save("obs_tensor_c.npy", obs_c)
    np.save("obs_matrix_d.npy", obs_d)
    np.save("obs_matrix_e.npy", obs_e)
    np.save("obs_matrix_f.npy", obs_f)

    main_res = analyze_dataset(scan_a, scan_b, obs_a, obs_f, obs_e, obs_d)

    # Jackknife
    jk_components, jk_pref_tc, jk_pref_res, jk_resp_tc, jk_resp_res, jk_consensus = [], [], [], [], [], []
    for b in range(n_blocks):
        other = [idx for idx in range(n_blocks) if idx != b]
        jk_a = np.mean(block_upsilon[other], axis=0)
        jk_f = np.mean(block_chi[other], axis=0)
        jk_e = np.mean(block_xi_ratio[other], axis=0)
        jk_out = analyze_dataset(scan_a, scan_b, jk_a, jk_f, jk_e, obs_d)
        jk_components.append(jk_out["transition_component_estimates"])
        jk_pref_tc.append(jk_out["preferred_transition_temperature"])
        jk_pref_res.append(jk_out["preferred_residual_value"])
        jk_resp_tc.append(jk_out["response_transition_temperature"])
        jk_resp_res.append(jk_out["response_residual_value"])
        jk_consensus.append(jk_out["consensus_transition_temperature"])

    jk_components = np.array(jk_components)
    def calc_jk_err(samples):
        s = np.array(samples)
        m = np.mean(s, axis=0)
        return np.sqrt((n_blocks - 1.0) / n_blocks * np.sum((s - m)**2, axis=0))

    comp_unc = [float(u) for u in calc_jk_err(jk_components)]
    pref_tc_unc = float(calc_jk_err(jk_pref_tc))
    pref_res_unc = float(calc_jk_err(jk_pref_res))
    resp_tc_unc = float(calc_jk_err(jk_resp_tc))
    resp_res_unc = float(calc_jk_err(jk_resp_res))
    cons_tc_unc = float(calc_jk_err(jk_consensus))

    pref_T = main_res["preferred_transition_temperature"]
    ups_over_T = obs_a[-1, :] / scan_a
    stiffness_ratio = float(np.interp(pref_T, scan_a, ups_over_T))
