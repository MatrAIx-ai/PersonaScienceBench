import pandas as pd
import numpy as np
import statsmodels.api as sm
from statsmodels.miscmodels.ordinal_model import OrderedModel

def main():
    # 1. Load data
    dm = pd.read_csv('data/TASK008_BCG-CORONA_DM.csv')
    ae = pd.read_csv('data/TASK008_BCG-CORONA_AE.csv')
    mh = pd.read_csv('data/TASK008_BCG-CORONA_MH.csv')

    print("=== DATA LOADED ===")
    print(f"DM records: {len(dm)}, AE records: {len(ae)}, MH records: {len(mh)}")

    # 2. Count ongoing medical conditions (MHONGO == 'Yes')
    mh_ongo = mh[mh['MHONGO'] == 'Yes'].groupby('USUBJID').size().rename('mhongo')
    df = dm.merge(mh_ongo, on='USUBJID', how='left')
    df['mhongo'] = df['mhongo'].fillna(0).astype(int)

    print("\n=== MHONGO DISTRIBUTION (N=1000) ===")
    print(df['mhongo'].value_counts().sort_index())

    # 3. Identify COVID-19 cases in AE
    covid_terms = ['COVID-19', 'COVID-19 pneumonia', 'Asymptomatic COVID-19', 'SARS-CoV-2 test positive']
    c_ae = ae[ae['AEPT'].isin(covid_terms)].copy()
    print(f"\nCOVID AE records: {len(c_ae)}, unique subjects: {c_ae['USUBJID'].nunique()}")

    # Subject-level max severity scores
    c_max_hs = c_ae.groupby('USUBJID')['AEHS'].max().rename('covid_aehs')
    c_max_sev = c_ae.groupby('USUBJID')['AESEV'].max().rename('covid_aesev')

    df = df.merge(c_max_hs, on='USUBJID', how='left').merge(c_max_sev, on='USUBJID', how='left')

    # 4. Primary Model: Confirmed COVID-19 patients (N=197), outcome = max(AEHS)
    df_primary = df[df['covid_aehs'].notna()].copy()
    print(f"\n=== PRIMARY ANALYSIS COHORT (N={len(df_primary)}) ===")
    print("Outcome covid_aehs distribution:")
    print(df_primary['covid_aehs'].value_counts().sort_index())

    formula = 'covid_aehs ~ mhongo + C(TRTGRP, Treatment(reference="Placebo")) + C(patients_seen, Treatment(reference="1-50")) + C(expect_interact, Treatment(reference="No"))'
    
    mod_primary = OrderedModel.from_formula(
        formula,
        df_primary,
        distr='logit'
    )
    res_primary = mod_primary.fit(method='bfgs', maxiter=1000, disp=False)
    print("\n=== PRIMARY MODEL RESULTS ===")
    print(res_primary.summary())

    coef_mh = res_primary.params['mhongo']
    se_mh = res_primary.bse['mhongo']
    z_mh = res_primary.tvalues['mhongo']
    p_mh = res_primary.pvalues['mhongo']
    ci_lower_coef = res_primary.conf_int().loc['mhongo', 0]
    ci_upper_coef = res_primary.conf_int().loc['mhongo', 1]

    or_mh = np.exp(coef_mh)
    or_lower = np.exp(ci_lower_coef)
    or_upper = np.exp(ci_upper_coef)

    pct_increase = (or_mh - 1.0) * 100.0
    pct_lower = (or_lower - 1.0) * 100.0
    pct_upper = (or_upper - 1.0) * 100.0

    print(f"\nMHONGO Primary Effect:")
    print(f"  Coefficient (log-odds): {coef_mh:.4f} (SE: {se_mh:.4f}, z: {z_mh:.4f}, p: {p_mh:.4f})")
    print(f"  95% CI for coef: [{ci_lower_coef:.4f}, {ci_upper_coef:.4f}]")
    print(f"  Odds Ratio (OR): {or_mh:.4f} (95% CI: [{or_lower:.4f}, {or_upper:.4f}])")
    print(f"  Percentage Increase in Odds: {pct_increase:.2f}% (95% CI: [{pct_lower:.2f}%, {pct_upper:.2f}%])")

    # 5. Sensitivity Analysis 1: Reference group sensitivity (e.g. TRTGRP reference BCG)
    mod_prim_ref2 = OrderedModel.from_formula(
        'covid_aehs ~ mhongo + C(TRTGRP) + C(patients_seen) + C(expect_interact)',
        df_primary,
        distr='logit'
    )
    res_prim_ref2 = mod_prim_ref2.fit(method='bfgs', maxiter=1000, disp=False)
    coef_mh2 = res_prim_ref2.params['mhongo']
    or_mh2 = np.exp(coef_mh2)
    pct_inc2 = (or_mh2 - 1.0) * 100.0
    print(f"\nSensitivity 1 (Default factor ref): MHONGO coef: {coef_mh2:.4f}, OR: {or_mh2:.4f}, % increase: {pct_inc2:.2f}%")

    # 6. Sensitivity Analysis 2: Outcome = AESEV among COVID cases (N=153)
    df_sens_sev = df[df['covid_aesev'].notna()].copy()
    mod_sev = OrderedModel.from_formula(
        'covid_aesev ~ mhongo + C(TRTGRP) + C(patients_seen) + C(expect_interact)',
        df_sens_sev,
        distr='logit'
    )
    res_sev = mod_sev.fit(method='bfgs', maxiter=1000, disp=False)
    coef_sev = res_sev.params['mhongo']
    or_sev = np.exp(coef_sev)
    pct_sev = (or_sev - 1.0) * 100.0
    print(f"\nSensitivity 2 (AESEV among cases, N={len(df_sens_sev)}): MHONGO coef: {coef_sev:.4f}, OR: {or_sev:.4f}, % increase: {pct_sev:.2f}%")

    # 7. Sensitivity Analysis 3: Full cohort (N=1000, non-COVID = 0, AEHS shifted by +1)
    df_full = df.copy()
    # non-covid = 0, covid asymptomatic (0) = 1, covid mild (1) = 2, etc.
    df_full['full_aehs'] = df_full['covid_aehs'].apply(lambda x: 0 if pd.isna(x) else int(x) + 1)
    mod_full = OrderedModel.from_formula(
        'full_aehs ~ mhongo + C(TRTGRP) + C(patients_seen) + C(expect_interact)',
        df_full,
        distr='logit'
    )
    res_full = mod_full.fit(method='bfgs', maxiter=1000, disp=False)
    coef_full = res_full.params['mhongo']
    or_full = np.exp(coef_full)
    pct_full = (or_full - 1.0) * 100.0
    print(f"\nSensitivity 3 (Full cohort AEHS, N={len(df_full)}): MHONGO coef: {coef_full:.4f}, OR: {or_full:.4f}, % increase: {pct_full:.2f}%")

    # Save summary tables to CSV
    summary_df = pd.DataFrame([{
        'Model': 'Primary (COVID cases, AEHS)',
        'N': len(df_primary),
        'Coef': coef_mh,
        'SE': se_mh,
        'p_value': p_mh,
        'OR': or_mh,
        'Pct_Increase': pct_increase,
        'CI_Lower': pct_lower,
        'CI_Upper': pct_upper
    }, {
        'Model': 'Sensitivity (AESEV cases)',
        'N': len(df_sens_sev),
        'Coef': coef_sev,
        'SE': res_sev.bse['mhongo'],
        'p_value': res_sev.pvalues['mhongo'],
        'OR': or_sev,
        'Pct_Increase': pct_sev,
        'CI_Lower': (np.exp(res_sev.conf_int().loc['mhongo', 0]) - 1)*100,
        'CI_Upper': (np.exp(res_sev.conf_int().loc['mhongo', 1]) - 1)*100
    }, {
        'Model': 'Sensitivity (Full cohort)',
        'N': len(df_full),
        'Coef': coef_full,
        'SE': res_full.bse['mhongo'],
        'p_value': res_full.pvalues['mhongo'],
        'OR': or_full,
        'Pct_Increase': pct_full,
        'CI_Lower': (np.exp(res_full.conf_int().loc['mhongo', 0]) - 1)*100,
        'CI_Upper': (np.exp(res_full.conf_int().loc['mhongo', 1]) - 1)*100
    }])
    summary_df.to_csv('model_comparison_results.csv', index=False)
    print("\n=== MODEL COMPARISON TABLE ===")
    print(summary_df.to_string(index=False))

if __name__ == '__main__':
    main()
