import pandas as pd
import numpy as np

# Load data
df = pd.read_csv('data/nls_raw.csv')

# Race mapping
race_map = {1: 'Black', 2: 'Hispanic', 3: 'Non-Black Non-Hispanic (White)'}
df['Race'] = df['Racial/ethnic cohort, 1979'].map(race_map)

wealth_cols = {
    1985: 'Family net wealth, 1985',
    1990: 'Family net wealth, 1990',
    1996: 'Family net wealth, 1996 (key data point)'
}

results = []
for year, col in wealth_cols.items():
    for race in ['Non-Black Non-Hispanic (White)', 'Black', 'Hispanic']:
        s = df[df['Race'] == race][col].dropna()
        results.append({
            'Year': year,
            'Race': race,
            'N': len(s),
            'Median': s.median(),
            'Mean': s.mean(),
            'Q25': s.quantile(0.25),
            'Q75': s.quantile(0.75),
            'IQR': s.quantile(0.75) - s.quantile(0.25),
            'Pct_Zero_or_Negative': (s <= 0).mean() * 100
        })

summary_df = pd.DataFrame(results)
summary_df.to_csv('wealth_summary_stats.csv', index=False)

# Ratios and disparities
pivot_med = summary_df.pivot(index='Year', columns='Race', values='Median')
comparison = pd.DataFrame({
    'White_Median': pivot_med['Non-Black Non-Hispanic (White)'],
    'Black_Median': pivot_med['Black'],
    'Hispanic_Median': pivot_med['Hispanic'],
    'White_Black_Gap': pivot_med['Non-Black Non-Hispanic (White)'] - pivot_med['Black'],
    'White_Hispanic_Gap': pivot_med['Non-Black Non-Hispanic (White)'] - pivot_med['Hispanic'],
    'White_to_Black_Ratio': pivot_med['Non-Black Non-Hispanic (White)'] / pivot_med['Black'],
    'White_to_Hispanic_Ratio': pivot_med['Non-Black Non-Hispanic (White)'] / pivot_med['Hispanic']
})
comparison.to_csv('wealth_disparity_ratios.csv')

print("Summary Stats:")
print(summary_df)
print("\nComparison and Disparity Ratios:")
print(comparison)
