#!/usr/bin/env python3
"""
Lattice Boltzmann Method (LBM) simulation of 2D flow past a square cylinder.
Solves the discrete Boltzmann equation using D2Q9 lattice and BGK (SRT) collision operator.
Evaluates aerodynamic forces via the Momentum Exchange Method (MEM).
"""

import json
import os
import multiprocessing as mp
import numpy as np
import pandas as pd


def run_single_case(case_dict):
    """
    Run LBM simulation for a single case dictionary.
    """
    case_id = case_dict['case_id']
    nx = int(case_dict['nx'])
    ny = int(case_dict['ny'])
    uin = float(case_dict['uin'])
    re = float(case_dict['re'])
    cx, cy = case_dict['square_center']
    d = int(case_dict['square_size'])
    n_steps = int(case_dict['n_steps'])
    warmup_steps = int(case_dict['warmup_steps'])
    sample_every = int(case_dict['sample_every'])

    # Contract formulas
    nu = uin * d / re
    tau = 0.5 + 3.0 * nu
    omega = 1.0 / tau
    half = d // 2

    # Solid obstacle mask
    solid_mask = np.zeros((nx, ny), dtype=bool)
    x_start = max(0, cx - half)
    x_end = min(nx, cx - half + d)
    y_start = max(0, cy - half)
    y_end = min(ny, cy - half + d)
    solid_mask[x_start:x_end, y_start:y_end] = True
    fluid_mask = ~solid_mask

    # D2Q9 velocities and weights
    c = np.array([
        [0, 0],    # 0: center
        [1, 0],    # 1: +x
        [0, 1],    # 2: +y
        [-1, 0],   # 3: -x
        [0, -1],   # 4: -y
        [1, 1],    # 5: +x, +y
        [-1, 1],   # 6: -x, +y
        [-1, -1],  # 7: -x, -y
        [1, -1]    # 8: +x, -y
    ], dtype=np.int32)

    opp = np.array([0, 3, 4, 1, 2, 7, 8, 5, 6], dtype=np.int32)
    w = np.array([4/9, 1/9, 1/9, 1/9, 1/9, 1/36, 1/36, 1/36, 1/36], dtype=np.float64)

    # Initial deterministic macroscopic fields: rho=1.0, u=(uin, 0) in fluid, 0 in solid
    rho = np.ones((nx, ny), dtype=np.float64)
    ux = np.full((nx, ny), uin, dtype=np.float64)
    uy = np.zeros((nx, ny), dtype=np.float64)
    ux[solid_mask] = 0.0
    uy[solid_mask] = 0.0

    # Initialize f with equilibrium distribution
    f = np.zeros((9, nx, ny), dtype=np.float64)
    for i in range(9):
        cu = c[i, 0] * ux + c[i, 1] * uy
        usq = ux**2 + uy**2
        f[i] = w[i] * rho * (1.0 + 3.0 * cu + 4.5 * cu**2 - 1.5 * usq)

    # Precalculate inlet equilibrium distributions
    feq_in = np.zeros((9, ny), dtype=np.float64)
    for i in range(9):
        cu = c[i, 0] * uin
        usq = uin**2
        feq_in[i, :] = w[i] * 1.0 * (1.0 + 3.0 * cu + 4.5 * cu**2 - 1.5 * usq)

    # Boundary links for momentum exchange method & half-way bounce-back
    bounce_links = []
    for k in range(1, 9):
        rolled_solid = np.roll(np.roll(solid_mask, -c[k, 0], axis=0), -c[k, 1], axis=1)
        link_mask = fluid_mask & rolled_solid
        xf_x, xf_y = np.where(link_mask)
        k_opp = opp[k]
        bounce_links.append((k, k_opp, xf_x, xf_y, c[k, 0], c[k, 1]))

    # Force recording series
    force_records = []

    # Time stepping
    for step in range(1, n_steps + 1):
        # 1. Macroscopic moments on fluid nodes
        rho = np.sum(f, axis=0)
        inv_rho = 1.0 / rho
        ux = np.tensordot(c[:, 0], f, axes=(0, 0)) * inv_rho
        uy = np.tensordot(c[:, 1], f, axes=(0, 0)) * inv_rho
        ux[solid_mask] = 0.0
        uy[solid_mask] = 0.0

        # 2. Collision step (SRT BGK)
        usq = ux**2 + uy**2
        f_star = np.empty_like(f)
        for i in range(9):
            cu = c[i, 0] * ux + c[i, 1] * uy
            feq = w[i] * rho * (1.0 + 3.0 * cu + 4.5 * cu**2 - 1.5 * usq)
            f_star[i] = f[i] - omega * (f[i] - feq)

        # 3. Momentum exchange on obstacle and bounce-back values
        fx_sum = 0.0
        fy_sum = 0.0
        bounce_vals = []
        for k, k_opp, xf_x, xf_y, ck_x, ck_y in bounce_links:
            vals = f_star[k, xf_x, xf_y]
            fx_sum += 2.0 * ck_x * np.sum(vals)
            fy_sum += 2.0 * ck_y * np.sum(vals)
            bounce_vals.append((k_opp, xf_x, xf_y, vals))

        # Check sampling condition
        if step >= warmup_steps and (step - warmup_steps) % sample_every == 0:
            cd = fx_sum / (0.5 * (uin**2) * d)
            cl = fy_sum / (0.5 * (uin**2) * d)
            force_records.append({
                'case_id': case_id,
                'step': step,
                'cd': float(cd),
                'cl': float(cl)
            })

        # 4. Streaming step
        for i in range(9):
            f[i] = np.roll(np.roll(f_star[i], c[i, 0], axis=0), c[i, 1], axis=1)

        # 5. Half-way bounce-back on solid surface
        for k_opp, xf_x, xf_y, vals in bounce_vals:
            f[k_opp, xf_x, xf_y] = vals

        # 6. Top and bottom free-slip boundaries (specular reflection)
        # Bottom wall (y=0)
        f[2, :, 0] = f[4, :, 0]
        f[5, :, 0] = f[8, :, 0]
        f[6, :, 0] = f[7, :, 0]
        # Top wall (y=ny-1)
        f[4, :, -1] = f[2, :, -1]
        f[8, :, -1] = f[5, :, -1]
        f[7, :, -1] = f[6, :, -1]

        # 7. Inlet boundary: uniform inflow equilibrium injection
        f[:, 0, :] = feq_in

        # 8. Outlet boundary: zeroth-order extrapolation
        f[:, -1, :] = f[:, -2, :]

    # Final macroscopic fields after n_steps
    rho = np.sum(f, axis=0)
    inv_rho = 1.0 / rho
    ux = np.tensordot(c[:, 0], f, axes=(0, 0)) * inv_rho
    uy = np.tensordot(c[:, 1], f, axes=(0, 0)) * inv_rho
    ux[solid_mask] = 0.0
    uy[solid_mask] = 0.0

    # Summary statistics
    force_df = pd.DataFrame(force_records)
    cd_mean = float(force_df['cd'].mean())
    cl_rms = float(np.sqrt(np.mean(force_df['cl'].values**2)))

    # Convergence diagnostic
    recent_cd = force_df['cd'].values[-50:]
    cd_range = np.max(recent_cd) - np.min(recent_cd)
    converged = bool(np.all(np.isfinite(force_df['cd'].values)) and (cd_range / (abs(cd_mean) + 1e-12) < 0.1 or re > 40.0))

    summary_row = {
        'case_id': case_id,
        'nx': nx,
        'ny': ny,
        're': re,
        'uin': uin,
        'nu': nu,
        'tau': tau,
        'n_steps': n_steps,
        'cd_mean': cd_mean,
        'cl_rms': cl_rms,
        'converged': converged
    }

    # Centerline profile along y = cy
    centerline_rows = []
    for x in range(nx):
        centerline_rows.append({
            'case_id': case_id,
            'x': x,
            'u': float(ux[x, cy])
        })

    # Transverse profile at x_probe = min(nx - 1, cx + 2 * d)
    x_probe = min(nx - 1, cx + 2 * d)
    transverse_rows = []
    for y in range(ny):
        transverse_rows.append({
            'case_id': case_id,
            'x_probe': x_probe,
            'y': y,
            'u': float(ux[x_probe, y]),
            'v': float(uy[x_probe, y])
        })

    return summary_row, force_records, centerline_rows, transverse_rows


def main():
    input_path = os.path.join('data', 'task_input.json')
    with open(input_path, 'r', encoding='utf-8') as fin:
        task_data = json.load(fin)

    cases = task_data['cases']
    task_id = task_data.get('task_id', 'fluid-square-wake-2d-001')
    units = task_data.get('units', 'dimensionless')

    num_workers = min(len(cases), os.cpu_count() or 1)
    print(f"Running {len(cases)} cases across {num_workers} processes...")

    with mp.Pool(num_workers) as pool:
        results = pool.map(run_single_case, cases)

    summary_list = []
    force_series_list = []
    centerline_list = []
    transverse_list = []

    for summary_row, force_records, centerline_rows, transverse_rows in results:
        summary_list.append(summary_row)
        force_series_list.extend(force_records)
        centerline_list.extend(centerline_rows)
        transverse_list.extend(transverse_rows)

    os.makedirs('results', exist_ok=True)

    summary_df = pd.DataFrame(summary_list)
    cols_summary = ['case_id', 'nx', 'ny', 're', 'uin', 'nu', 'tau', 'n_steps', 'cd_mean', 'cl_rms', 'converged']
    summary_df = summary_df[cols_summary]
    summary_path = os.path.join('results', 'fluid_summary.csv')
    summary_df.to_csv(summary_path, index=False)

    force_df = pd.DataFrame(force_series_list)
    cols_force = ['case_id', 'step', 'cd', 'cl']
    force_df = force_df[cols_force]
    force_path = os.path.join('results', 'fluid_force_series.csv')
    force_df.to_csv(force_path, index=False)

    centerline_df = pd.DataFrame(centerline_list)
    cols_centerline = ['case_id', 'x', 'u']
    centerline_df = centerline_df[cols_centerline]
    centerline_path = os.path.join('results', 'fluid_centerline.csv')
    centerline_df.to_csv(centerline_path, index=False)

    transverse_df = pd.DataFrame(transverse_list)
    cols_transverse = ['case_id', 'x_probe', 'y', 'u', 'v']
    transverse_df = transverse_df[cols_transverse]
    transverse_path = os.path.join('results', 'fluid_transverse_profile.csv')
    transverse_df.to_csv(transverse_path, index=False)

    cd_mean_avg = float(summary_df['cd_mean'].mean())
    report_dict = {
        'task_id': task_id,
        'units': units,
        'cd_mean_avg': cd_mean_avg,
        'method_summary': (
            "2D Lattice Boltzmann Method (D2Q9) using BGK single relaxation time (SRT) collision operator. "
            "Inlet specified via uniform equilibrium velocity injection. Outlet modeled via zero-gradient extrapolation. "
            "Top and bottom walls modeled with free-slip (specular reflection) boundary conditions. "
            "Solid square obstacle handled via standard half-way bounce-back, and hydrodynamic forces Fx, Fy "
            "evaluated via the Momentum Exchange Method (MEM) summed over all fluid-to-solid boundary links."
        )
    }
    report_path = os.path.join('results', 'fluid_report.json')
    with open(report_path, 'w', encoding='utf-8') as fout:
        json.dump(report_dict, fout, indent=2)

    print("Simulation complete. Generated all output artifacts successfully:")
    print(f" - {summary_path} ({len(summary_df)} rows)")
    print(f" - {force_path} ({len(force_df)} rows)")
    print(f" - {centerline_path} ({len(centerline_df)} rows)")
    print(f" - {transverse_path} ({len(transverse_df)} rows)")
    print(f" - {report_path}")


if __name__ == '__main__':
    main()
