import pandas as pd
import numpy as np

# Load capital dataset
df = pd.read_csv('data/capital.csv')
for col in df.columns[3:]:
    df[col] = df[col].astype(str).str.replace(',', '.').astype(float)

features = df.columns[3:].tolist()

categories = {
    'Symbolic capital': ['ZAxtSchwert', 'ZDolch', 'Zhausgr'],
    'Social capital': ['ZCU_AU', 'Zamber', 'ZMonument'],
    'Cultural capital': ['ZKeform', 'Zkeverz'],
    'Economic capital': ['ZHort', 'ZSichel', 'ZBeil', 'ZMW']
}

# Demean / center
X = df[features].values
X_mean = np.mean(X, axis=0)
X_c = X - X_mean

# SVD
u, s, vt = np.linalg.svd(X_c, full_matrices=False)
explained_var = (s**2) / np.sum(s**2)

scores = X_c @ vt.T
df['PC1'] = scores[:, 0]
df['PC2'] = scores[:, 1]

print("=== PCA Summary (100-year slices, 4300-500 BCE) ===")
print(f"PC1 Explained Variance: {explained_var[0]*100:.2f}%")
print(f"PC2 Explained Variance: {explained_var[1]*100:.2f}%\n")

print("=== PC1 Loadings by Capital Category ===")
for cat, vars_ in categories.items():
    print(f"{cat}:")
    for v in vars_:
        idx = features.index(v)
        print(f"  {v:14s}: {vt[0, idx]:+.4f}")

mn = df[df['BCE'].between(3000, 3400)]
sg = df[df['BCE'].between(2300, 2900)]

print("\n=== Middle Neolithic (MN: 3400-3000 BCE) PC1 Scores ===")
for _, row in mn.iterrows():
    print(f"  {int(row['BCE'])} BCE: PC1 = {row['PC1']:+.4f}")
print(f"  MN Mean PC1: {mn['PC1'].mean():+.4f} (std: {mn['PC1'].std():.4f})")

print("\n=== Younger Neolithic (SG: 2900-2300 BCE) PC1 Scores ===")
for _, row in sg.iterrows():
    print(f"  {int(row['BCE'])} BCE: PC1 = {row['PC1']:+.4f}")
print(f"  SG Mean PC1: {sg['PC1'].mean():+.4f} (std: {sg['PC1'].std():.4f})")

