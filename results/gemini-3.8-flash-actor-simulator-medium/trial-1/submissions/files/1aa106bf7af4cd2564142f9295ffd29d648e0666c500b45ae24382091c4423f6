#!/usr/bin/env python3
"""
Analysis script for evaluating the Pearson correlation coefficient between
gene length and mean expression across CD14 immune cell samples for protein-coding genes.
"""

import sys
import pandas as pd
import numpy as np
from scipy.stats import pearsonr, spearmanr

def main():
    print("=== Loading Data ===")
    sample_meta_path = "data/Sample_annotated_Zenodo.csv"
    gene_meta_path = "data/GeneMetaInfo_Zenodo.csv"
    counts_path = "data/BatchCorrectedReadCounts_Zenodo.csv"

    # 1. Load sample metadata and select CD14 samples
    df_sample = pd.read_csv(sample_meta_path)
    cd14_mask = df_sample['celltype'] == 'CD14'
    cd14_samples = df_sample.loc[cd14_mask, 'sample'].tolist()
    cd14_ref_samples = df_sample.loc[cd14_mask & (df_sample['samtype'] == 'refsamp'), 'sample'].tolist()
    cd14_nonref_samples = df_sample.loc[cd14_mask & (df_sample['samtype'] == 'nonrefsamp'), 'sample'].tolist()

    print(f"Total samples annotated: {len(df_sample)}")
    print(f"Total CD14 samples: {len(cd14_samples)} (refsamp: {len(cd14_ref_samples)}, nonrefsamp: {len(cd14_nonref_samples)})")

    # 2. Load gene metadata and filter for protein-coding genes
    df_gene = pd.read_csv(gene_meta_path)
    pc_mask = df_gene['gene_biotype'] == 'protein_coding'
    df_pc_genes = df_gene.loc[pc_mask, ['Geneid', 'Length', 'gene_biotype']].copy()
    print(f"Total genes annotated: {len(df_gene)}")
    print(f"Total protein-coding genes: {len(df_pc_genes)}")

    # 3. Load read counts for CD14 samples
    usecols = ['Unnamed: 0'] + cd14_samples
    df_counts = pd.read_csv(counts_path, usecols=usecols)
    print(f"Loaded count matrix with shape: {df_counts.shape}")

    # Merge gene lengths with counts
    merged = pd.merge(df_pc_genes, df_counts, left_on='Geneid', right_on='Unnamed: 0')
    print(f"Merged dataset shape (protein-coding genes): {merged.shape}")

    gene_lengths = merged['Length'].values

    # Primary analysis: Arithmetic mean across all 132 CD14 samples
    mean_expr_all = merged[cd14_samples].mean(axis=1).values
    r_primary, p_primary = pearsonr(gene_lengths, mean_expr_all)

    print("\n" + "="*50)
    print("=== PRIMARY RESULT ===")
    print("="*50)
    print(f"Metric: Pearson correlation coefficient (r) between Gene Length and Raw Mean Expression")
    print(f"Gene subset: All protein-coding genes (n = {len(merged)})")
    print(f"Sample subset: All CD14 samples (n = {len(cd14_samples)})")
    print(f"Pearson correlation coefficient (r): {r_primary:.6f} ({r_primary})")
    print(f"p-value: {p_primary:.6e}")
    print(f"Mean gene length (bp): {np.mean(gene_lengths):.2f} (std: {np.std(gene_lengths):.2f}, min: {np.min(gene_lengths)}, max: {np.max(gene_lengths)})")
    print(f"Mean CD14 expression: {np.mean(mean_expr_all):.2f} (std: {np.std(mean_expr_all):.2f}, min: {np.min(mean_expr_all):.2f}, max: {np.max(mean_expr_all):.2f})")

    # Sensitivity Analyses
    print("\n" + "="*50)
    print("=== SENSITIVITY ANALYSES ===")
    print("="*50)

    # 1. Reference samples only
    mean_expr_ref = merged[cd14_ref_samples].mean(axis=1).values
    r_ref, p_ref = pearsonr(gene_lengths, mean_expr_ref)
    print(f"1. Reference CD14 samples only (n = {len(cd14_ref_samples)}):")
    print(f"   Pearson r = {r_ref:.6f}, p-value = {p_ref:.6e}")

    # 2. Non-reference samples only
    mean_expr_nonref = merged[cd14_nonref_samples].mean(axis=1).values
    r_nonref, p_nonref = pearsonr(gene_lengths, mean_expr_nonref)
    print(f"2. Non-reference CD14 samples only (n = {len(cd14_nonref_samples)}):")
    print(f"   Pearson r = {r_nonref:.6f}, p-value = {p_nonref:.6e}")

    # 3. Log2-transformed mean expression
    log2_mean = np.log2(mean_expr_all + 1)
    r_log2, p_log2 = pearsonr(gene_lengths, log2_mean)
    print(f"3. log2(Mean Expression + 1) across all CD14 samples:")
    print(f"   Pearson r = {r_log2:.6f}, p-value = {p_log2:.6e}")

    # 4. Mean of log2-transformed counts
    mean_log2 = np.log2(merged[cd14_samples].values + 1).mean(axis=1)
    r_mean_log2, p_mean_log2 = pearsonr(gene_lengths, mean_log2)
    print(f"4. Mean of log2(Counts + 1) across all CD14 samples:")
    print(f"   Pearson r = {r_mean_log2:.6f}, p-value = {p_mean_log2:.6e}")

    # 5. Expressed protein-coding genes only (mean > 0)
    expressed_mask = mean_expr_all > 0
    n_expressed = np.sum(expressed_mask)
    r_expressed, p_expressed = pearsonr(gene_lengths[expressed_mask], mean_expr_all[expressed_mask])
    print(f"5. Expressed protein-coding genes only (mean > 0, n = {n_expressed}):")
    print(f"   Pearson r = {r_expressed:.6f}, p-value = {p_expressed:.6e}")

    # 6. Spearman rank correlation
    rho_raw, p_rho_raw = spearmanr(gene_lengths, mean_expr_all)
    print(f"6. Spearman rank correlation (raw mean):")
    print(f"   Spearman rho = {rho_raw:.6f}, p-value = {p_rho_raw:.6e}")

    # Save summary results
    results_summary = pd.DataFrame([
        {"Analysis": "Primary: Raw mean (all 132 CD14)", "N_genes": len(merged), "Pearson_r": r_primary, "p_value": p_primary},
        {"Analysis": "Sensitivity: Raw mean (80 refsamp CD14)", "N_genes": len(merged), "Pearson_r": r_ref, "p_value": p_ref},
        {"Analysis": "Sensitivity: Raw mean (52 nonrefsamp CD14)", "N_genes": len(merged), "Pearson_r": r_nonref, "p_value": p_nonref},
        {"Analysis": "Sensitivity: log2(mean + 1)", "N_genes": len(merged), "Pearson_r": r_log2, "p_value": p_log2},
        {"Analysis": "Sensitivity: mean(log2 + 1)", "N_genes": len(merged), "Pearson_r": r_mean_log2, "p_value": p_mean_log2},
        {"Analysis": "Sensitivity: Expressed genes only (mean > 0)", "N_genes": n_expressed, "Pearson_r": r_expressed, "p_value": p_expressed},
    ])
    results_summary.to_csv("summary_results.csv", index=False)
    print("\nSummary results saved to summary_results.csv")

if __name__ == "__main__":
    main()
