import pandas as pd

# Load study dataset
data_path = 'data/meta-regression_study_data_heterogeneity_in_replication_projects.csv'
df = pd.read_csv(data_path)

def compute_metrics(subset):
    records = []
    for disc, grp in subset.groupby('discipline'):
        records.append({
            'discipline': disc,
            'n_records': len(grp),
            'n_studies': grp['id'].nunique(),
            'orig_male_mean': grp['authors_male.o'].mean(),
            'orig_male_median': grp['authors_male.o'].median(),
            'orig_pct_majority_male': (grp['authors_male.o'] > 0.5).mean() * 100,
            'orig_pct_ge50_male': (grp['authors_male.o'] >= 0.5).mean() * 100,
            'repl_male_mean': grp['authors_male.r'].mean(),
            'repl_male_median': grp['authors_male.r'].median(),
            'repl_pct_majority_male': (grp['authors_male.r'] > 0.5).mean() * 100,
            'repl_pct_ge50_male': (grp['authors_male.r'] >= 0.5).mean() * 100,
        })
    return pd.DataFrame(records)

# 1. Study-level (aggregated rows for multi-lab projects and single studies)
study_level = df[(df['aggregated'] == True) | (df['aggregated'].isna())]
stats_study = compute_metrics(study_level)

# 2. Study-level without dropped records
stats_study_nodrop = compute_metrics(study_level[study_level['drop'] == False])

# 3. Lab-level (all rows)
stats_lab = compute_metrics(df)

# 4. Lab-level without dropped records
stats_lab_nodrop = compute_metrics(df[df['drop'] == False])

print('=== 1. Study-level (N=141) ===')
print(stats_study.round(3).to_string(index=False))

print('\n=== 2. Study-level without drop (N=131) ===')
print(stats_study_nodrop.round(3).to_string(index=False))

print('\n=== 3. Lab-level (N=927) ===')
print(stats_lab.round(3).to_string(index=False))

print('\n=== 4. Lab-level without drop (N=809) ===')
print(stats_lab_nodrop.round(3).to_string(index=False))
