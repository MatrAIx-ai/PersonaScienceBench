import pandas as pd
import numpy as np

def run_analysis():
    # Load and clean capital.csv
    df_cap = pd.read_csv('data/capital.csv')
    
    # Clean numeric fields with comma decimal separators
    for col in ['ZKeform', 'Zkeverz']:
        df_cap[col] = pd.to_numeric(df_cap[col].astype(str).str.replace(',', '.'))
    
    # Sort chronologically forward (BCE decreasing from 4300 to 500)
    df_chrono = df_cap.sort_values('BCE', ascending=False).reset_index(drop=True)
    
    # Calculate step differences (intersecular change)
    df_chrono['d_ZKeform'] = df_chrono['ZKeform'].diff()
    df_chrono['d_Zkeverz'] = df_chrono['Zkeverz'].diff()
    
    results = []
    for i in range(1, len(df_chrono)):
        prev = df_chrono.iloc[i-1]
        curr = df_chrono.iloc[i]
        bce_prev = int(prev['BCE'])
        bce_curr = int(curr['BCE'])
        d_form = curr['d_ZKeform']
        d_deco = curr['d_Zkeverz']
        
        # Condition: Pottery Decoration increases significantly while Pottery Form declines simultaneously
        opp_trend = (d_deco > 0) and (d_form < 0)
        
        results.append({
            'from_BCE': bce_prev,
            'to_BCE': bce_curr,
            'period': curr['group'],
            'ZKeform_prev': prev['ZKeform'],
            'ZKeform_curr': curr['ZKeform'],
            'd_ZKeform': d_form,
            'Zkeverz_prev': prev['Zkeverz'],
            'Zkeverz_curr': curr['Zkeverz'],
            'd_Zkeverz': d_deco,
            'opposite_trends': opp_trend
        })
    
    res_df = pd.DataFrame(results)
    
    # Filter for opposite trends
    divergent_bins = res_df[res_df['opposite_trends']]
    
    print("=== DIVERGENT CENTURY BINS ===")
    print(divergent_bins.to_string())
    
    # Save processed results to CSV
    res_df.to_csv('pottery_secular_trends.csv', index=False)
    
    # Cross-reference with time_series_data.csv
    df_ts = pd.read_csv('data/time_series_data.csv')
    ts_sub = df_ts[(df_ts['CE'] >= -1900) & (df_ts['CE'] <= -1600)][
        ['CE', 'PotteryForm', 'PotteryForm_inter', 'PotteryDecoration', 'PotteryDecoration_inter']
    ]
    print("\n=== TIME SERIES CROSS VALIDATION (-1900 to -1600 CE) ===")
    print(ts_sub.dropna(how='all', subset=['PotteryForm', 'PotteryDecoration']).to_string())

if __name__ == '__main__':
    run_analysis()
