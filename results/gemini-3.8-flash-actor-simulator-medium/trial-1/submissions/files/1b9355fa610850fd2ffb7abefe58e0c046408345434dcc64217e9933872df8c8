import pandas as pd
from scipy.stats import chi2_contingency, fisher_exact

def main():
    data_path = 'data/MeRIP_RNA_result.xlsx'
    df = pd.read_excel(data_path)
    
    print(f"Loaded {len(df)} rows from {data_path}")
    
    # 1. 3x3 Contingency Table: m6A status vs DEG status
    ct3x3 = pd.crosstab(df['m6A'], df['DEG'])
    print("\n--- 3x3 Contingency Table (m6A vs DEG) ---")
    print(ct3x3)
    
    chi2_3x3, p_3x3, dof_3x3, expected_3x3 = chi2_contingency(ct3x3)
    print("\n--- 3x3 Chi-squared Test Results ---")
    print(f"Chi-square statistic: {chi2_3x3:.6f}")
    print(f"Degrees of freedom: {dof_3x3}")
    print(f"p-value: {p_3x3:.6e}")
    print(f"p-value (full precision): {p_3x3}")
    
    # 2. 2x2 Contingency Table: Significant m6A vs Significant DEG
    df['m6A_sig'] = df['m6A'] != 'm6A no sig'
    df['DEG_sig'] = df['DEG'] != 'no-DEGs'
    
    ct2x2 = pd.crosstab(df['m6A_sig'], df['DEG_sig'])
    print("\n--- 2x2 Contingency Table (Significant vs Non-significant) ---")
    print(ct2x2)
    
    chi2_2x2_yates, p_2x2_yates, dof_2x2, _ = chi2_contingency(ct2x2, correction=True)
    chi2_2x2, p_2x2, _, _ = chi2_contingency(ct2x2, correction=False)
    odds_ratio, p_fisher = fisher_exact(ct2x2)
    
    print("\n--- 2x2 Test Results ---")
    print(f"Chi-square (no correction): statistic = {chi2_2x2:.6f}, p-value = {p_2x2:.6e}")
    print(f"Chi-square (Yates correction): statistic = {chi2_2x2_yates:.6f}, p-value = {p_2x2_yates:.6e}")
    print(f"Fisher exact test: odds ratio = {odds_ratio:.6f}, p-value = {p_fisher:.6e}")

if __name__ == '__main__':
    main()
