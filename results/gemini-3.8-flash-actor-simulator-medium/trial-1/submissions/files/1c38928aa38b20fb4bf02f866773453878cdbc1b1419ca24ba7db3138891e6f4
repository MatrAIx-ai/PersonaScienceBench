"""
Analysis script for evaluating male author dominance across disciplines
in original and replication studies.
Dataset: meta-regression_study_data_heterogeneity_in_replication_projects.csv
"""

import pandas as pd
import numpy as np

def run_analysis():
    filepath = 'data/meta-regression_study_data_heterogeneity_in_replication_projects.csv'
    df = pd.read_csv(filepath)

    print("=================================================================")
    print("1. STUDY-LEVEL ANALYSIS (Deduplicated by unique study 'id', N=141)")
    print("=================================================================")
    study_df = df.groupby('id').agg({
        'discipline': 'first',
        'authors_male.o': 'first',
        'authors_male.r': 'mean'
    }).reset_index()

    study_summary = study_df.groupby('discipline').agg(
        n_studies=('id', 'count'),
        mean_authors_male_o=('authors_male.o', 'mean'),
        median_authors_male_o=('authors_male.o', 'median'),
        pct_majority_male_o=('authors_male.o', lambda x: (x > 0.5).mean() * 100),
        mean_authors_male_r=('authors_male.r', 'mean'),
        median_authors_male_r=('authors_male.r', 'median'),
        pct_majority_male_r=('authors_male.r', lambda x: (x > 0.5).mean() * 100),
        pct_both_majority_male=('id', lambda idx: ((study_df.loc[idx.index, 'authors_male.o'] > 0.5) & 
                                                  (study_df.loc[idx.index, 'authors_male.r'] > 0.5)).mean() * 100)
    ).round(4)
    print(study_summary)

    print("\n=================================================================")
    print("2. ROW-LEVEL / LAB-LEVEL ANALYSIS (All records, N=927)")
    print("=================================================================")
    row_summary = df.groupby('discipline').agg(
        n_records=('id', 'count'),
        mean_authors_male_o=('authors_male.o', 'mean'),
        median_authors_male_o=('authors_male.o', 'median'),
        pct_majority_male_o=('authors_male.o', lambda x: (x > 0.5).mean() * 100),
        mean_authors_male_r=('authors_male.r', 'mean'),
        median_authors_male_r=('authors_male.r', 'median'),
        pct_majority_male_r=('authors_male.r', lambda x: (x > 0.5).mean() * 100),
        pct_both_majority_male=('id', lambda idx: ((df.loc[idx.index, 'authors_male.o'] > 0.5) & 
                                                  (df.loc[idx.index, 'authors_male.r'] > 0.5)).mean() * 100)
    ).round(4)
    print(row_summary)

    print("\n=================================================================")
    print("3. CONCLUSION")
    print("=================================================================")
    print("In Economics, the majority of authors tend to be male for both original")
    print("and replication studies (mean male author ratio: 87.0% original, 83.7% replication;")
    print("median male author ratio: 100.0% in both; 55.6% of studies strictly >50% male in both).")

if __name__ == '__main__':
    run_analysis()
