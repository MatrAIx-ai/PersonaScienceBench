import pandas as pd
from scipy import stats

def run_analysis():
    df = pd.read_csv('data/meta-regression_study_data_heterogeneity_in_replication_projects.csv')
    
    print("=== Full Dataset Summary ===")
    summary_full = df.groupby('discipline')[['authors_male.o', 'authors_male.r']].agg(['count', 'mean', 'median', 'std'])
    print(summary_full)
    
    print("\n=== Unique Study-Level Summary ===")
    df_study = df.groupby(['id', 'discipline'], as_index=False)[['authors_male.o', 'authors_male.r']].mean()
    summary_study = df_study.groupby('discipline')[['authors_male.o', 'authors_male.r']].agg(['count', 'mean', 'median', 'std'])
    print(summary_study)
    
    print("\n=== Majority (> 0.5) Proportions (Study-Level) ===")
    for disc in ['Economics', 'Cognitive', 'Social']:
        sub = df_study[df_study['discipline'] == disc]
        pct_o = (sub['authors_male.o'] > 0.5).mean() * 100
        pct_r = (sub['authors_male.r'] > 0.5).mean() * 100
        pct_both = ((sub['authors_male.o'] > 0.5) & (sub['authors_male.r'] > 0.5)).mean() * 100
        print(f"{disc}: Orig > 50%: {pct_o:.1f}%, Rep > 50%: {pct_r:.1f}%, Both > 50%: {pct_both:.1f}%")

if __name__ == '__main__':
    run_analysis()
