"""
Ordinal Logistic Regression Analysis: Interaction between BCG Vaccination
and Prior Medical History on COVID-19 Severity, Controlling for Patient Interaction Frequency.
Study: TASK008 (BCG-CORONA trial)
"""

import os
import numpy as np
import pandas as pd
from statsmodels.miscmodels.ordinal_model import OrderedModel

def run_analysis():
    # 1. Load data
    dm_path = 'data/TASK008_BCG-CORONA_DM.csv'
    ae_path = 'data/TASK008_BCG-CORONA_AE.csv'
    mh_path = 'data/TASK008_BCG-CORONA_MH.csv'

    df_dm = pd.read_csv(dm_path)
    df_ae = pd.read_csv(ae_path)
    df_mh = pd.read_csv(mh_path)

    print(f"Loaded DM: {df_dm.shape}, AE: {df_ae.shape}, MH: {df_mh.shape}")

    # 2. Operationalize Medical History
    # MHSCAT == 'MEDICAL HISTORY' and MHORRES == 2.0 (condition present)
    med_hist = df_mh[df_mh['MHSCAT'] == 'MEDICAL HISTORY']
    subjects_with_mh = med_hist[med_hist['MHORRES'] == 2.0]['USUBJID'].unique()
    
    df_dm['prior_mh'] = df_dm['USUBJID'].isin(subjects_with_mh).astype(int)
    df_dm['bcg'] = (df_dm['TRTGRP'] == 'BCG').astype(int)

    # 3. Operationalize COVID-19 Events and Severity
    covid_mask = (
        df_ae['AEPT'].str.contains('covid|corona|sars', case=False, na=False) |
        df_ae['AELLT'].str.contains('covid|corona|sars', case=False, na=False)
    )
    covid_ae = df_ae[covid_mask].copy()

    # Subject-level maximum AEHS (WHO clinical progression scale)
    covid_max_aehs = covid_ae.groupby('USUBJID')['AEHS'].max().reset_index()
    covid_max_aehs.rename(columns={'AEHS': 'covid_aehs'}, inplace=True)

    # Subject-level maximum AESEV
    covid_max_aesev = covid_ae.dropna(subset=['AESEV']).groupby('USUBJID')['AESEV'].max().reset_index()
    covid_max_aesev.rename(columns={'AESEV': 'covid_aesev'}, inplace=True)

    # Merge into primary COVID-19 cohort (N=197)
    df_primary = df_dm.merge(covid_max_aehs, on='USUBJID', how='inner')
    print(f"\nPrimary COVID-19 positive cohort size: N = {len(df_primary)}")

    # Contingency table
    ct = pd.crosstab(df_primary['TRTGRP'], df_primary['prior_mh'], margins=True)
    print("\nContingency table (TRTGRP vs prior_mh):")
    print(ct)

    # 4. Primary Model Estimation (OrderedModel)
    formula_primary = 'covid_aehs ~ bcg * prior_mh + C(patients_seen, Treatment(reference="1-50"))'
    mod_primary = OrderedModel.from_formula(formula_primary, data=df_primary, distr='logit')
    res_primary = mod_primary.fit(method='bfgs', maxiter=2000, disp=False)

    print("\n" + "="*80)
    print("PRIMARY MODEL RESULTS (AEHS, N=197):")
    print("="*80)
    print(res_primary.summary())

    # Compile primary summary table
    params = res_primary.params
    se = res_primary.bse
    z_stat = res_primary.tvalues
    p_vals = res_primary.pvalues
    ci = res_primary.conf_int()
    or_val = np.exp(params)
    or_ci_lower = np.exp(ci[0])
    or_ci_upper = np.exp(ci[1])

    summary_primary = pd.DataFrame({
        'Coefficient': params,
        'Std_Error': se,
        'z_statistic': z_stat,
        'p_value': p_vals,
        'CI_95_lower': ci[0],
        'CI_95_upper': ci[1],
        'Odds_Ratio': or_val,
        'OR_95_lower': or_ci_lower,
        'OR_95_upper': or_ci_upper
    })

    print("\nDetailed Metrics:")
    print(summary_primary.to_string())

    inter_var = 'bcg:prior_mh'
    print("\n" + "-"*60)
    print("INTERACTION EFFECT (BCG x Prior Medical History):")
    print(f"Log-odds coefficient (beta): {params[inter_var]:.4f}")
    print(f"Standard Error:             {se[inter_var]:.4f}")
    print(f"z-statistic:                {z_stat[inter_var]:.4f}")
    print(f"p-value:                    {p_vals[inter_var]:.4f}")
    print(f"Odds Ratio (OR):            {or_val[inter_var]:.4f}")
    print(f"95% CI for OR:              [{or_ci_lower[inter_var]:.4f}, {or_ci_upper[inter_var]:.4f}]")
    print("-"*60)

    # 5. Sensitivity Analysis 1: AESEV among COVID cases (N=153)
    df_sens_sev = df_dm.merge(covid_max_aesev, on='USUBJID', how='inner')
    formula_sev = 'covid_aesev ~ bcg * prior_mh + C(patients_seen, Treatment(reference="1-50"))'
    mod_sev = OrderedModel.from_formula(formula_sev, data=df_sens_sev, distr='logit')
    res_sev = mod_sev.fit(method='bfgs', maxiter=2000, disp=False)

    print("\n" + "="*80)
    print("SENSITIVITY ANALYSIS 1: AESEV (N=153):")
    print("="*80)
    print(f"Interaction beta: {res_sev.params[inter_var]:.4f}, SE: {res_sev.bse[inter_var]:.4f}, p: {res_sev.pvalues[inter_var]:.4f}")
    print(f"OR: {np.exp(res_sev.params[inter_var]):.4f}, 95% CI: [{np.exp(res_sev.conf_int().loc[inter_var, 0]):.4f}, {np.exp(res_sev.conf_int().loc[inter_var, 1]):.4f}]")

    # 6. Sensitivity Analysis 2: Full Cohort (N=1,000)
    df_full = df_dm.merge(covid_max_aehs, on='USUBJID', how='left')
    df_full['sev_all'] = df_full['covid_aehs'].fillna(-1) + 1
    formula_full = 'sev_all ~ bcg * prior_mh + C(patients_seen, Treatment(reference="1-50"))'
    mod_full = OrderedModel.from_formula(formula_full, data=df_full, distr='logit')
    res_full = mod_full.fit(method='bfgs', maxiter=2000, disp=False)

    print("\n" + "="*80)
    print("SENSITIVITY ANALYSIS 2: FULL COHORT AEHS (N=1,000):")
    print("="*80)
    print(f"Interaction beta: {res_full.params[inter_var]:.4f}, SE: {res_full.bse[inter_var]:.4f}, p: {res_full.pvalues[inter_var]:.4f}")
    print(f"OR: {np.exp(res_full.params[inter_var]):.4f}, 95% CI: [{np.exp(res_full.conf_int().loc[inter_var, 0]):.4f}, {np.exp(res_full.conf_int().loc[inter_var, 1]):.4f}]")

if __name__ == '__main__':
    run_analysis()
