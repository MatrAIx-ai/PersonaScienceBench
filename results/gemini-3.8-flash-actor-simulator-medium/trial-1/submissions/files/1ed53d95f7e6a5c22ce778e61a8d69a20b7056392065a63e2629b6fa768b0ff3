import pandas as pd
import numpy as np
from scipy import stats

def main():
    print("Loading gene metadata...")
    meta = pd.read_csv("data/GeneMetaInfo_Zenodo.csv", index_col=0)
    print(f"Total genes in metadata: {len(meta)}")

    print("Loading batch-corrected read counts...")
    counts = pd.read_csv("data/BatchCorrectedReadCounts_Zenodo.csv", index_col=0)
    print(f"Total genes in counts matrix: {counts.shape[0]}, total samples: {counts.shape[1]}")

    # Ensure gene alignment
    assert (meta.index == counts.index).all(), "Gene IDs do not match exactly!"

    # 1. Primary analysis: Strict protein-coding genes
    pc_strict_mask = meta["gene_biotype"] == "protein_coding"
    n_pc_strict = pc_strict_mask.sum()
    print(f"Number of strictly protein-coding genes: {n_pc_strict}")

    lengths_strict = meta.loc[pc_strict_mask, "Length"].values
    mean_expr_strict = counts.loc[pc_strict_mask].mean(axis=1).values

    r_primary, p_primary = stats.pearsonr(lengths_strict, mean_expr_strict)
    print("\n--- PRIMARY RESULT ---")
    print(f"Pearson correlation coefficient (r): {r_primary:.6f}")
    print(f"p-value: {p_primary}")
    print(f"r (rounded to 4 decimal places): {r_primary:.4f}")
    print(f"r (rounded to 2 decimal places): {r_primary:.2f}")

    # 2. Alternative: Biotype contains 'protein_coding'
    pc_contains_mask = meta["gene_biotype"].str.contains("protein_coding")
    n_pc_contains = pc_contains_mask.sum()
    lengths_contains = meta.loc[pc_contains_mask, "Length"].values
    mean_expr_contains = counts.loc[pc_contains_mask].mean(axis=1).values
    r_contains, p_contains = stats.pearsonr(lengths_contains, mean_expr_contains)

    # 3. Alternative: Median expression across samples
    med_expr_strict = counts.loc[pc_strict_mask].median(axis=1).values
    r_med, p_med = stats.pearsonr(lengths_strict, med_expr_strict)

    # 4. Alternative: Average of per-sample Pearson correlations
    sample_rs = [
        stats.pearsonr(lengths_strict, counts.loc[pc_strict_mask, col].values)[0]
        for col in counts.columns
    ]
    mean_sample_r = np.mean(sample_rs)

    # 5. Alternative: Non-zero expressing protein-coding genes only
    nonzero_mask = mean_expr_strict > 0
    r_nonzero, p_nonzero = stats.pearsonr(lengths_strict[nonzero_mask], mean_expr_strict[nonzero_mask])

    print("\n--- SENSITIVITY ANALYSES ---")
    print(f"1. Biotype contains 'protein_coding' (N={n_pc_contains}): r = {r_contains:.6f} (p={p_contains})")
    print(f"2. Median expression across samples: r = {r_med:.6f} (p={p_med})")
    print(f"3. Mean of per-sample correlations: r = {mean_sample_r:.6f} (std={np.std(sample_rs):.6f})")
    print(f"4. Non-zero expressing genes only (N={nonzero_mask.sum()}): r = {r_nonzero:.6f} (p={p_nonzero})")

    # Output concise result summary
    summary = {
        "primary_pearson_r": float(r_primary),
        "primary_p_value": float(p_primary),
        "protein_coding_genes_count": int(n_pc_strict),
        "samples_count": int(counts.shape[1]),
        "r_rounded_4dp": round(float(r_primary), 4),
        "r_rounded_2dp": round(float(r_primary), 2),
    }
    print("\nSummary dictionary:", summary)

if __name__ == "__main__":
    main()
