import pandas as pd

def analyze_pottery_diversity():
    # Load capital.csv
    df_cap = pd.read_csv('data/capital.csv')
    for col in ['ZKeform', 'Zkeverz']:
        df_cap[col] = df_cap[col].astype(str).str.replace(',', '.').astype(float)
    df_cap = df_cap.sort_values(by='BCE', ascending=False).reset_index(drop=True)
    df_cap['CE'] = -df_cap['BCE']
    df_cap['delta_PotteryForm'] = df_cap['ZKeform'].diff()
    df_cap['delta_PotteryDecoration'] = df_cap['Zkeverz'].diff()

    # Find the century where Decoration increases and Form decreases
    opposing = df_cap[(df_cap['delta_PotteryDecoration'] > 0) & (df_cap['delta_PotteryForm'] < 0)]
    print('Opposing trend century identified:')
    print(opposing[['BCE', 'CE', 'group', 'ZKeform', 'Zkeverz', 'delta_PotteryForm', 'delta_PotteryDecoration']])
    return opposing

if __name__ == '__main__':
    analyze_pottery_diversity()
