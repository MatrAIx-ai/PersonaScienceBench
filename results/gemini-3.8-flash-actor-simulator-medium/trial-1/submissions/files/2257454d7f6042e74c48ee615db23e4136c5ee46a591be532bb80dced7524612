import pandas as pd
import numpy as np

def main():
    zf_path = "data/ZF_AgeRelated_CpG_noMT_Final.csv"
    df = pd.read_csv(zf_path)
    
    print(f"Loaded {zf_path} with {len(df)} rows.")
    
    # Unique sites identified by 'Pos'
    unique_sites = df['Pos'].unique()
    total_sites = len(unique_sites)
    print(f"Total unique CpG sites (Pos): {total_sites}")
    
    # Calculate min and max MethylationPercentage per site across all samples
    site_stats = df.groupby('Pos')['MethylationPercentage'].agg(['min', 'max', 'count'])
    
    # Condition: shows >90% or <10% methylation (strict inequality)
    # i.e., site has at least one sample with methylation < 10 or > 90
    shows_extreme_strict = (site_stats['min'] < 10.0) | (site_stats['max'] > 90.0)
    sites_showing_extreme_strict = shows_extreme_strict.sum()
    sites_not_showing_extreme_strict = (~shows_extreme_strict).sum()
    
    # Boundary variations: non-strict inequality (<= 10 or >= 90)
    shows_extreme_nonstrict = (site_stats['min'] <= 10.0) | (site_stats['max'] >= 90.0)
    sites_showing_extreme_nonstrict = shows_extreme_nonstrict.sum()
    sites_not_showing_extreme_nonstrict = (~shows_extreme_nonstrict).sum()
    
    print("\n--- Filtering Results (Site-level across all samples) ---")
    print(f"Strict inequality (< 10% or > 90%):")
    print(f"  Sites showing >90% or <10% methylation: {sites_showing_extreme_strict}")
    print(f"  Sites NOT showing >90% or <10% methylation (removed): {sites_not_showing_extreme_strict}")
    
    print(f"\nNon-strict inequality (<= 10% or >= 90%):")
    print(f"  Sites showing >=90% or <=10% methylation: {sites_showing_extreme_nonstrict}")
    print(f"  Sites NOT showing >=90% or <=10% methylation (removed): {sites_not_showing_extreme_nonstrict}")
    
    # Row-level counts for documentation
    rows_extreme = (df['MethylationPercentage'] < 10.0) | (df['MethylationPercentage'] > 90.0)
    print(f"\nRow-level observations:")
    print(f"  Total observations: {len(df)}")
    print(f"  Observations with <10% or >90%: {rows_extreme.sum()}")
    print(f"  Observations between 10% and 90%: {(~rows_extreme).sum()}")
    
    # If restricted to sites shared by all 20 samples (SampleShared == 20):
    df_shared20 = df[df['SampleShared'] == 20]
    site_stats20 = df_shared20.groupby('Pos')['MethylationPercentage'].agg(['min', 'max'])
    shows_extreme20 = (site_stats20['min'] < 10.0) | (site_stats20['max'] > 90.0)
    print(f"\nRestricted to fully shared sites (SampleShared == 20, {len(site_stats20)} sites):")
    print(f"  Sites showing >90% or <10%: {shows_extreme20.sum()}")
    print(f"  Sites NOT showing >90% or <10% (removed): {(~shows_extreme20).sum()}")
    
    return sites_not_showing_extreme_strict

if __name__ == "__main__":
    removed_count = main()
    print(f"\nPrimary result: {removed_count} sites are removed.")
