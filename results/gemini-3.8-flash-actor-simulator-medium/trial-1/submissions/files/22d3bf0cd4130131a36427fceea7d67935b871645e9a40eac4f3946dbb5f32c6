import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf
from scipy import stats

def run_analysis():
    # 1. Load data
    file_path = 'data/data.xlsx'
    df = pd.read_excel(file_path)
    
    # Filter to valid patient observations (Sequence number 1 to 80)
    df_valid = df.dropna(subset=['Sequence number']).copy()
    assert len(df_valid) == 80, f"Expected 80 patients, got {len(df_valid)}"
    
    # 2. Variable definitions
    # Response: Group 1.0 (PR) = 1, Group 2.0 (SD/PD) = 0
    df_valid['response'] = (df_valid['Groups'] == 1.0).astype(int)
    df_valid['BMI'] = pd.to_numeric(df_valid['BMI'], errors='raise')
    df_valid['Age'] = pd.to_numeric(df_valid['Age'], errors='raise')
    
    print("=== Cohort Description ===")
    print(f"Total valid patients: {len(df_valid)}")
    print("Efficacy distribution:")
    print(df_valid['Efficacy'].value_counts())
    print("\nGroups distribution:")
    print(df_valid['Groups'].value_counts())
    print("\nBMI summary overall:")
    print(df_valid['BMI'].describe())
    print("\nBMI summary by Treatment Response (0=SD/PD, 1=PR):")
    print(df_valid.groupby('response')['BMI'].describe())
    
    # 3. Univariate Logistic Regression
    X = sm.add_constant(df_valid['BMI'])
    y = df_valid['response']
    
    model = sm.Logit(y, X).fit()
    print("\n=== Univariate Logistic Regression Results ===")
    print(model.summary())
    
    beta_bmi = model.params['BMI']
    se_bmi = model.bse['BMI']
    z_bmi = model.tvalues['BMI']
    p_wald = model.pvalues['BMI']
    ci_lower, ci_upper = model.conf_int().loc['BMI']
    or_bmi = np.exp(beta_bmi)
    or_ci_lower = np.exp(ci_lower)
    or_ci_upper = np.exp(ci_upper)
    
    # Likelihood Ratio Test
    null_model = sm.Logit(y, np.ones((len(y), 1))).fit(disp=False)
    llr_stat = -2 * (null_model.llf - model.llf)
    p_lrt = stats.chi2.sf(llr_stat, df=1)
    
    print("\n=== Model Parameters & Hypothesis Testing ===")
    print(f"BMI Coefficient (beta): {beta_bmi:.6f}")
    print(f"Standard Error (SE):    {se_bmi:.6f}")
    print(f"Wald z-statistic:       {z_bmi:.6f}")
    print(f"Wald p-value:           {p_wald:.6f} (approx {p_wald:.4f})")
    print(f"Odds Ratio (OR):        {or_bmi:.4f} [95% CI: {or_ci_lower:.4f}, {or_ci_upper:.4f}]")
    print(f"LLR statistic:          {llr_stat:.6f}")
    print(f"LRT p-value:            {p_lrt:.6f} (approx {p_lrt:.4f})")
    
    # 4. Multivariate Logistic Regression (Sensitivity analysis)
    df_mv = df_valid.rename(columns={
        'ECOG-PS': 'ECOG_PS',
        'Child-Pugh': 'Child_Pugh',
        'Chemotherapy experience': 'Chemo',
        'HBV infection': 'HBV',
        'Family history': 'FamHist'
    })
    
    mv_model = smf.logit('response ~ BMI + Age + C(Gender) + C(ECOG_PS) + C(Child_Pugh) + C(Chemo) + C(HBV) + C(FamHist)', data=df_mv).fit(disp=False)
    print("\n=== Multivariate Logistic Regression Results ===")
    print(mv_model.summary())
    print(f"Adjusted BMI Wald p-value: {mv_model.pvalues['BMI']:.6f}")

if __name__ == '__main__':
    run_analysis()
