import pandas as pd
import numpy as np
from scipy import stats

def run_analysis():
    # 1. Load discrete 100-year epoch data
    df_cap = pd.read_csv('data/capital.csv', decimal=',')
    sub_cap = df_cap[(df_cap['BCE'] >= 3000) & (df_cap['BCE'] <= 3400)].sort_values('BCE', ascending=False)
    
    cols_cap = ['BCE', 'ZMonument', 'ZBeil', 'Zhausgr', 'ZAxtSchwert', 'ZDolch']
    df_sub = sub_cap[cols_cap].copy()
    
    # 2. Load annual interpolated data
    df_ts = pd.read_csv('data/time_series_data.csv')
    sub_ts = df_ts[(df_ts['CE'] >= -3400) & (df_ts['CE'] <= -3000)].sort_values('CE')
    cols_ts = ['CE', 'MonumentCount_inter', 'AxesCelts_inter', 'HouseSize_inter', 'HatchetSword_inter', 'Dagger_inter']
    df_sub_ts = sub_ts[cols_ts].copy()

    print("=== Century-Binned Trajectory (3400 - 3000 BCE) ===")
    print(df_sub.to_string(index=False))

    print("\n=== Pearson Correlation (100-year discrete bins) ===")
    print(df_sub[['ZMonument', 'ZBeil', 'Zhausgr', 'ZAxtSchwert', 'ZDolch']].corr(method='pearson'))

    print("\n=== Spearman Rank Correlation (100-year discrete bins) ===")
    print(df_sub[['ZMonument', 'ZBeil', 'Zhausgr', 'ZAxtSchwert', 'ZDolch']].corr(method='spearman'))

    print("\n=== Pearson Correlation (Annual Interpolated, N=401) ===")
    print(df_sub_ts[['MonumentCount_inter', 'AxesCelts_inter', 'HouseSize_inter', 'HatchetSword_inter', 'Dagger_inter']].corr(method='pearson'))

    print("\n=== Summary Diagnostics ===")
    for col in ['ZMonument', 'ZBeil', 'Zhausgr', 'ZAxtSchwert', 'ZDolch']:
        vals = df_sub[col].values
        print(f"{col}: start(3400 BCE)={vals[0]:.3f}, peak={vals.max():.3f} (at {df_sub.loc[df_sub[col]==vals.max(), 'BCE'].values[0]} BCE), end(3000 BCE)={vals[-1]:.3f}, mean={vals.mean():.3f}, std={vals.std():.3f}")

if __name__ == '__main__':
    run_analysis()
