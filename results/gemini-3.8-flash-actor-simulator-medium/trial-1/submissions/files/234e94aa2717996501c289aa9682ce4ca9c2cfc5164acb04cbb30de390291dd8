"""
Comparative Analysis: Effect of Education Expenditure on Per Capita GDP
Between Developing Countries (LMC) and Sub-Saharan Africa (SSA)
"""

import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf

def run_analysis():
    # Load dataset
    df = pd.read_csv('data/worldbank_education_gdp.csv')
    year_cols = [c for c in df.columns if '[' in c]
    
    # Reshape to long format
    long_df = df.melt(
        id_vars=['Country Group', 'Country Code', 'Series Name', 'Series Code'],
        value_vars=year_cols,
        var_name='Year',
        value_name='Value'
    )
    long_df['Year'] = long_df['Year'].apply(lambda x: int(x.split()[0]))
    pivot = long_df.pivot(
        index=['Country Group', 'Country Code', 'Year'],
        columns='Series Code',
        values='Value'
    ).reset_index()

    # Derived variables
    pivot['edu_pc'] = (pivot['NY.ADJ.AEDU.GN.ZS'] / 100.0) * pivot['NY.GNP.PCAP.KD']
    pivot['log_gdp'] = np.log(pivot['NY.GNP.PCAP.KD'])
    pivot['log_edu'] = np.log(pivot['NY.ADJ.AEDU.GN.ZS'])
    pivot['log_sec'] = np.log(pivot['SE.SEC.ENRR'])

    # Overlapping period (2011-2015) where GNI per capita is available for both groups
    p_11_15 = pivot[pivot['Year'] >= 2011].copy()

    results = {}
    for cg in ['Lower middle income', 'Sub-Saharan Africa']:
        sub = p_11_15[p_11_15['Country Group'] == cg]
        r_share = np.corrcoef(sub['NY.ADJ.AEDU.GN.ZS'], sub['NY.GNP.PCAP.KD'])[0, 1]
        r_percap = np.corrcoef(sub['edu_pc'], sub['NY.GNP.PCAP.KD'])[0, 1]
        slope_share, _ = np.polyfit(sub['NY.ADJ.AEDU.GN.ZS'], sub['NY.GNP.PCAP.KD'], 1)
        slope_percap, _ = np.polyfit(sub['edu_pc'], sub['NY.GNP.PCAP.KD'], 1)
        elasticity, _ = np.polyfit(np.log(sub['NY.ADJ.AEDU.GN.ZS']), np.log(sub['NY.GNP.PCAP.KD']), 1)
        
        results[cg] = {
            'corr_share': r_share,
            'corr_percap': r_percap,
            'slope_share': slope_share,
            'slope_percap': slope_percap,
            'elasticity': elasticity,
            'gdp_2011': sub.loc[sub['Year'] == 2011, 'NY.GNP.PCAP.KD'].values[0],
            'gdp_2015': sub.loc[sub['Year'] == 2015, 'NY.GNP.PCAP.KD'].values[0],
            'edu_pc_2011': sub.loc[sub['Year'] == 2011, 'edu_pc'].values[0],
            'edu_pc_2015': sub.loc[sub['Year'] == 2015, 'edu_pc'].values[0],
        }

    # Interaction model
    p_11_15_renamed = p_11_15.rename(columns={'Country Group': 'group'})
    interaction_model = smf.ols('log_gdp ~ log_edu * C(group, Treatment(reference="Lower middle income"))', data=p_11_15_renamed).fit()

    print("=== Comparative Analysis Summary ===")
    for cg, res in results.items():
        print(f"\nGroup: {cg}")
        print(f"  GNI pc (2011 -> 2015): ${res['gdp_2011']:.2f} -> ${res['gdp_2015']:.2f} (+{(res['gdp_2015']/res['gdp_2011'] - 1)*100:.2f}%)")
        print(f"  Edu Exp pc (2011 -> 2015): ${res['edu_pc_2011']:.2f} -> ${res['edu_pc_2015']:.2f} (+{(res['edu_pc_2015']/res['edu_pc_2011'] - 1)*100:.2f}%)")
        print(f"  Corr(Edu Share, GNI pc): {res['corr_share']:.4f}")
        print(f"  Corr(Edu pc, GNI pc): {res['corr_percap']:.4f}")
        print(f"  Linear Slope (Edu Share -> GNI pc): {res['slope_share']:.2f}")
        print(f"  Elasticity (ln Edu Share -> ln GNI pc): {res['elasticity']:.4f}")

    print("\n=== Interaction Model ===")
    print(interaction_model.summary())

if __name__ == '__main__':
    run_analysis()
