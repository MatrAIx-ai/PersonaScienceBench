import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf

def main():
    # 1. Load plot-level niche pathway data
    niche_df = pd.read_csv('data/invaded_niche_pathways.csv', sep='\t')
    niche_df.columns = [c.replace('.', '_') for c in niche_df.columns]
    
    # 2. Multi-scale & multi-temporal correlation analysis
    urban_cols = [
        'urban_1956_50m', 'urban_1993_50m', 'urban_2009_50m',
        'urban_1956_500m', 'urban_1993_500m', 'urban_2009_500m',
        'urban_1956_1000m', 'urban_1993_1000m', 'urban_2009_1000m'
    ]
    pathway_counts = ['n_total', 'n_unint', 'n_gard', 'n_agfo']
    corr_matrix = niche_df[pathway_counts + urban_cols].corr().loc[pathway_counts, urban_cols]
    
    print("=== Correlation Matrix (Pathways vs Urban Variables) ===")
    print(corr_matrix.round(3))
    
    # 3. GLM Models (Poisson) at landscape scale (1000m) controlling for environmental factors
    print("\n=== GLM Poisson Regression at 1000m (2009) ===")
    models = {}
    for y in pathway_counts:
        formula = f"{y} ~ urban_2009_1000m + elevation + distance_road + annual_temperature + annual_rainfall"
        mod = smf.glm(formula, data=niche_df, family=sm.families.Poisson()).fit()
        models[y] = mod
        print(f"\nTarget: {y}")
        print(mod.summary().tables[1])
        
    # 4. GLM comparing baseline historical urban vs urban expansion (1956 to 2009)
    print("\n=== GLM: Historical Urban (1956) vs Urban Change (1956-2009) at 1000m ===")
    niche_df['urban_change_1000m'] = niche_df['urban_2009_1000m'] - niche_df['urban_1956_1000m']
    for y in pathway_counts:
        formula = f"{y} ~ urban_1956_1000m + urban_change_1000m + elevation + distance_road"
        mod_hist = smf.glm(formula, data=niche_df, family=sm.families.Poisson()).fit()
        print(f"\nTarget: {y}")
        print(mod_hist.summary().tables[1])
        
    # 5. Species traits analysis
    species_df = pd.read_csv('data/invasion_success_pathways.csv')
    print("\n=== Species Traits Summary by Introduction Pathway ===")
    trait_summary = species_df.groupby('intro.pathway')[
        ['number.of.invaded.plots', 'area.of.occupancy.10km', 'habitat.range', 'invaded.niche.breadth', 'height']
    ].mean()
    print(trait_summary.round(3))
    
    growth_table = pd.crosstab(species_df['intro.pathway'], species_df['growth.form'], normalize='index')
    print("\n=== Growth Form Proportions by Pathway ===")
    print(growth_table.round(3))

if __name__ == '__main__':
    main()
