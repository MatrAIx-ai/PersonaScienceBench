import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf

# Load data
df = pd.read_csv('data/invaded_niche_pathways.csv', sep='\t')
df.columns = [c.replace('.', '_') for c in df.columns]

# Pathways to examine
pathways = {
    'n_gard': 'Gardening (Ornamental/Horticultural)',
    'n_unint': 'Unintentional (Accidental/Contaminants)',
    'n_agfo': 'AgriForest (Agriculture/Forestry)',
    'n_total': 'Total non-native species'
}

# 1. Univariate Poisson & Negative Binomial regressions across scales and years
results = []
scales = ['50m', '500m', '1000m']
years = ['1956', '1993', '2009']

for p_col, p_name in pathways.items():
    for yr in years:
        for sc in scales:
            u_var = f'urban_{yr}_{sc}'
            # Poisson
            m_poi = smf.glm(f'{p_col} ~ {u_var}', data=df, family=sm.families.Poisson()).fit()
            # NegBin
            try:
                m_nb = smf.glm(f'{p_col} ~ {u_var}', data=df, family=sm.families.NegativeBinomial()).fit()
                nb_coef, nb_se, nb_z, nb_p = m_nb.params[u_var], m_nb.bse[u_var], m_nb.tvalues[u_var], m_nb.pvalues[u_var]
            except Exception:
                nb_coef, nb_se, nb_z, nb_p = np.nan, np.nan, np.nan, np.nan

            results.append({
                'pathway': p_name,
                'pathway_col': p_col,
                'year': yr,
                'scale': sc,
                'variable': u_var,
                'poi_coef': m_poi.params[u_var],
                'poi_se': m_poi.bse[u_var],
                'poi_z': m_poi.tvalues[u_var],
                'poi_p': m_poi.pvalues[u_var],
                'poi_aic': m_poi.aic,
                'nb_coef': nb_coef,
                'nb_se': nb_se,
                'nb_z': nb_z,
                'nb_p': nb_p
            })

res_df = pd.DataFrame(results)
res_df.to_csv('model_results_univariate.csv', index=False)

# 2. Multivariate models controlling for environmental covariates
multi_results = []
covariates = 'elevation + distance_road + distance_stream + annual_temperature + annual_rainfall + cropland_2009_500m'

for p_col, p_name in pathways.items():
    formula = f'{p_col} ~ urban_2009_500m + {covariates}'
    m_poi = smf.glm(formula, data=df, family=sm.families.Poisson()).fit()
    m_nb = smf.glm(formula, data=df, family=sm.families.NegativeBinomial()).fit()
    
    multi_results.append({
        'pathway': p_name,
        'pathway_col': p_col,
        'poi_urban_coef': m_poi.params['urban_2009_500m'],
        'poi_urban_se': m_poi.bse['urban_2009_500m'],
        'poi_urban_p': m_poi.pvalues['urban_2009_500m'],
        'nb_urban_coef': m_nb.params['urban_2009_500m'],
        'nb_urban_se': m_nb.bse['urban_2009_500m'],
        'nb_urban_p': m_nb.pvalues['urban_2009_500m']
    })

multi_df = pd.DataFrame(multi_results)
multi_df.to_csv('model_results_multivariate.csv', index=False)

print('Univariate results head:')
print(res_df[res_df['scale'] == '500m'][['pathway_col', 'year', 'poi_coef', 'poi_p', 'nb_coef', 'nb_p']])
print('\nMultivariate results:')
print(multi_df)
