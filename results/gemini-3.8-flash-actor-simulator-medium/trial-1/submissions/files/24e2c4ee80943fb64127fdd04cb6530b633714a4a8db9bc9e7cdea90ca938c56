import pandas as pd
import numpy as np

# Load capital dataset
df = pd.read_csv('data/capital.csv')
num_cols = [c for c in df.columns if c not in ['BCE', 'group', 'color']]
for c in num_cols:
    df[c] = df[c].astype(str).str.replace(',', '.').astype(float)

# PCA via SVD on centered data
X = df[num_cols].values
X_mean = np.mean(X, axis=0)
X_c = X - X_mean
u, s, vt = np.linalg.svd(X_c, full_matrices=False)

# Orient PC1 such that metal/prestige capital is positive
if vt[0, num_cols.index('ZCU_AU')] < 0:
    vt[0] = -vt[0]

df['PC1'] = X_c @ vt[0]
explained_variance = (s**2 / (len(df) - 1)) / np.sum(s**2 / (len(df) - 1)) * 100

yba = df[df['group'] == 'YBA'][['BCE', 'PC1']]
print(yba)
