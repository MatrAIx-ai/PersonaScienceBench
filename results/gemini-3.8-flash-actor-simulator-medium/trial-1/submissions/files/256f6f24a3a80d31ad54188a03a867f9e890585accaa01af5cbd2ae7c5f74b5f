#!/usr/bin/env python3
"""
Skewness Analysis of RNA Expression Data for TCGA COAD
Episode ID: bixbench:bix-42-q2
Question: What is the skewness of the distribution of RNA expression data
          (highly/minimally right or left skewed, or approximately normal)?
"""

import sys
import numpy as np
import pandas as pd
from scipy import stats

def main():
    input_file = "data/COAD__geneExp.xls"
    print(f"Loading RNA expression data from {input_file}...")
    df = pd.read_csv(input_file, sep="\t", index_col=0)
    print(f"Matrix dimensions: {df.shape[0]} genes x {df.shape[1]} samples")

    # 1. Overall skewness (flattened matrix)
    vals = df.values.flatten()
    n_total = len(vals)
    n_zeros = (vals == 0).sum()
    pct_zeros = (n_zeros / n_total) * 100

    overall_skew = float(stats.skew(vals))
    overall_kurt = float(stats.kurtosis(vals))
    val_min = float(np.min(vals))
    val_max = float(np.max(vals))
    val_mean = float(np.mean(vals))
    val_median = float(np.median(vals))
    val_std = float(np.std(vals))

    print("\n=== Overall Distribution Statistics ===")
    print(f"Total data points: {n_total}")
    print(f"Zeros count (%): {n_zeros} ({pct_zeros:.2f}%)")
    print(f"Min: {val_min:.4f}")
    print(f"Max: {val_max:.4f}")
    print(f"Mean: {val_mean:.4f}")
    print(f"Median: {val_median:.4f}")
    print(f"Std dev: {val_std:.4f}")
    print(f"Overall Skewness: {overall_skew:.4f}")
    print(f"Overall Excess Kurtosis: {overall_kurt:.4f}")

    # 2. Sample-wise skewness (across genes within each sample)
    sample_skews = df.skew(axis=0)
    s_mean = sample_skews.mean()
    s_median = sample_skews.median()
    s_std = sample_skews.std()
    s_min = sample_skews.min()
    s_max = sample_skews.max()

    print("\n=== Sample-wise Skewness Statistics (across 328 samples) ===")
    print(f"Mean skewness: {s_mean:.4f}")
    print(f"Median skewness: {s_median:.4f}")
    print(f"Std dev: {s_std:.4f}")
    print(f"Min skewness: {s_min:.4f}")
    print(f"Max skewness: {s_max:.4f}")
    print(f"Samples with skewness > 1: {(sample_skews > 1).sum()} / {len(sample_skews)} ({(sample_skews > 1).mean()*100:.1f}%)")

    # 3. Gene-wise skewness (across samples for each gene)
    gene_skews = df.skew(axis=1)
    g_mean = gene_skews.mean()
    g_median = gene_skews.median()
    g_std = gene_skews.std()
    g_min = gene_skews.min()
    g_max = gene_skews.max()

    print("\n=== Gene-wise Skewness Statistics (across 20,502 genes) ===")
    print(f"Mean skewness: {g_mean:.4f}")
    print(f"Median skewness: {g_median:.4f}")
    print(f"Std dev: {g_std:.4f}")
    print(f"Min skewness: {g_min:.4f}")
    print(f"Max skewness: {g_max:.4f}")
    print(f"Genes with skewness > 1: {(gene_skews > 1).sum()} / {len(gene_skews)} ({(gene_skews > 1).mean()*100:.1f}%)")
    print(f"Genes with skewness > 0: {(gene_skews > 0).sum()} / {len(gene_skews)} ({(gene_skews > 0).mean()*100:.1f}%)")

    # Bulmer (1979) skewness classification:
    # skewness < -1 or > +1: highly skewed
    # -1 to -0.5 or +0.5 to +1: moderately skewed
    # -0.5 to +0.5: approximately symmetric
    classification = "highly right skewed"
    print(f"\nFinal Classification: {classification}")

if __name__ == "__main__":
    main()
