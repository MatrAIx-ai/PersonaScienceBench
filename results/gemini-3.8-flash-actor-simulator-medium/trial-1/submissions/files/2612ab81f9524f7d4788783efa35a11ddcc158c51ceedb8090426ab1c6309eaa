import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf

def main():
    # Load dataset
    excel_path = 'data/data.xlsx'
    df = pd.read_excel(excel_path, sheet_name='Sheet1')
    
    # Filter valid patients (first 80 rows, Sequence number 1 to 80)
    df_clean = df.iloc[:80].copy()
    
    # Prepare variables
    df_clean['Age'] = pd.to_numeric(df_clean['Age'])
    df_clean['BMI'] = pd.to_numeric(df_clean['BMI'])
    df_clean['Gender'] = df_clean['Gender'].astype(str)
    df_clean['y_PR'] = (df_clean['Efficacy'] == 'PR').astype(int)
    
    # Fit combined logistic regression model
    model = smf.logit('y_PR ~ Age + Gender + BMI', data=df_clean).fit()
    
    print("=" * 60)
    print("LOGISTIC REGRESSION MODEL SUMMARY")
    print("=" * 60)
    print(model.summary())
    
    # Extract results for Age
    coef_age = model.params['Age']
    se_age = model.bse['Age']
    z_age = model.tvalues['Age']
    p_value_age = model.pvalues['Age']
    ci_lower_age, ci_upper_age = model.conf_int().loc['Age']
    
    # Odds ratio
    or_age = np.exp(coef_age)
    or_ci_lower = np.exp(ci_lower_age)
    or_ci_upper = np.exp(ci_upper_age)
    
    print("\n" + "=" * 60)
    print("RESULTS FOR AGE AS PREDICTOR OF PR")
    print("=" * 60)
    print(f"Coefficient (beta):      {coef_age:.6f}")
    print(f"Standard Error (SE):     {se_age:.6f}")
    print(f"z-statistic:             {z_age:.6f}")
    print(f"p-value (exact):         {p_value_age:.8f}")
    print(f"p-value (scientific):    {p_value_age:.4e}")
    print(f"p-value (3 decimals):    {p_value_age:.3f}")
    print(f"p-value (4 decimals):    {p_value_age:.4f}")
    print(f"Odds Ratio (OR):         {or_age:.6f}")
    print(f"95% CI for OR:           [{or_ci_lower:.6f}, {or_ci_upper:.6f}]")
    print("=" * 60)
    
    return {
        'p_value': p_value_age,
        'coef': coef_age,
        'se': se_age,
        'odds_ratio': or_age,
        'ci_or': (or_ci_lower, or_ci_upper)
    }

if __name__ == '__main__':
    main()
