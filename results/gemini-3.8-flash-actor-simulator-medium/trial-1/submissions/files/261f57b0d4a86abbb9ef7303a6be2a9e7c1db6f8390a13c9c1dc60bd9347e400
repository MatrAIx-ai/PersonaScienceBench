import pandas as pd
import numpy as np
from scipy import stats
import statsmodels.api as sm
import statsmodels.formula.api as smf

df = pd.read_csv('data/nls_incarceration_processed.csv')
black = df[df['race'] == 'black'].copy()

# Stratify by 1985 wealth tertiles
# Note: composite_wealth_1985 <= 0 is lowest tier
black['wealth_tertile'] = pd.qcut(black['composite_wealth_1985'], q=3, labels=['Low', 'Middle', 'High'], duplicates='drop')

print("=== Descriptive Statistics for Black Population ===")
print("Overall sample size:", len(black))
print("Ever jailed count:", black['ever_jailed'].value_counts().to_dict())

print("\n=== Mean and Median Wealth in 1996 by Tertile and Incarceration Status ===")
for tertile in ['Low', 'Middle', 'High']:
    sub = black[black['wealth_tertile'] == tertile]
    g0 = sub[sub['ever_jailed'] == 0]['composite_wealth_1996']
    g1 = sub[sub['ever_jailed'] == 1]['composite_wealth_1996']
    u_stat, u_p = stats.mannwhitneyu(g0, g1, alternative='two-sided')
    t_stat, t_p = stats.ttest_ind(g0, g1, equal_var=False)
    print(f"\nTertile {tertile}:")
    print(f"  Non-jailed (N={len(g0)}): Mean=${g0.mean():,.2f}, Median=${g0.median():,.2f}")
    print(f"  Jailed (N={len(g1)}):     Mean=${g1.mean():,.2f}, Median=${g1.median():,.2f}")
    print(f"  Mean difference:          -${g0.mean() - g1.mean():,.2f}")
    print(f"  Median difference:        -${g0.median() - g1.median():,.2f}")
    print(f"  Mann-Whitney test: U={u_stat}, p={u_p:.4e}")
    print(f"  Welch t-test: t={t_stat:.4f}, p={t_p:.4e}")

print("\n=== Regression Analysis (OLS) ===")
# Controlling for composite_wealth_1985 continuously and interacting with ever_jailed
ols_model = smf.ols('composite_wealth_1996 ~ ever_jailed * composite_wealth_1985 + C(sex)', data=black).fit()
print(ols_model.summary().tables[1])

print("\n=== Regression Analysis with Tertiles (OLS) ===")
ols_tertiles = smf.ols('composite_wealth_1996 ~ ever_jailed * C(wealth_tertile) + C(sex)', data=black).fit()
print(ols_tertiles.summary().tables[1])

print("\n=== Wealth Change from 1985 to 1996 ===")
black['wealth_growth'] = black['composite_wealth_1996'] - black['composite_wealth_1985']
for tertile in ['Low', 'Middle', 'High']:
    sub = black[black['wealth_tertile'] == tertile]
    g0 = sub[sub['ever_jailed'] == 0]['wealth_growth']
    g1 = sub[sub['ever_jailed'] == 1]['wealth_growth']
    print(f"Tertile {tertile} Wealth Growth (1985-1996):")
    print(f"  Non-jailed: Mean=${g0.mean():,.2f}, Median=${g0.median():,.2f}")
    print(f"  Jailed:     Mean=${g1.mean():,.2f}, Median=${g1.median():,.2f}")

