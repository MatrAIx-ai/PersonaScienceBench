import os
import glob
import pandas as pd

def main():
    data_dir = "data/CHIP_DP10_GQ20_PASS"
    excel_files = sorted(glob.glob(os.path.join(data_dir, "*.xlsx")))
    print(f"Found {len(excel_files)} sample files.")

    # Load Schenz genes
    genes_path = "data/230214_Schenz_et_al_2022_CHIP_Genes.xlsx"
    schenz_df = pd.read_excel(genes_path, header=None)
    schenz_genes = set(schenz_df[0].dropna().str.strip())
    print(f"Loaded {len(schenz_genes)} Schenz CHIP genes.")

    dfs = []
    for filepath in excel_files:
        sample_name = os.path.basename(filepath).replace(".xlsx", "")
        df = pd.read_excel(filepath, header=1)
        df["Sample"] = sample_name
        dfs.append(df)

    combined_df = pd.concat(dfs, ignore_index=True)
    total_rows = len(combined_df)
    print(f"\nTotal rows in dataset: {total_rows}")

    # Zygosity value counts
    print("\nZygosity distribution across dataset:")
    print(combined_df["Zygosity"].value_counts(dropna=False))

    # Reference calls count
    ref_calls = combined_df[combined_df["Zygosity"] == "Reference"]
    num_ref_calls = len(ref_calls)
    print(f"\nNumber of Reference calls (Zygosity == 'Reference'): {num_ref_calls}")

    # Case 1: Removing strictly Zygosity == 'Reference' (keeping non-ref, i.e., Het, Hom, and NaN)
    df_no_ref = combined_df[combined_df["Zygosity"] != "Reference"]
    num_no_ref = len(df_no_ref)
    print(f"\n1. Rows remaining after removing Reference calls (df['Zygosity'] != 'Reference'): {num_no_ref}")

    # Case 2: Keeping only non-reference variant calls (Heterozygous and Homozygous Variant)
    df_variants_only = combined_df[combined_df["Zygosity"].isin(["Heterozygous", "Homozygous Variant"])]
    num_variants_only = len(df_variants_only)
    print(f"2. Rows with called variant zygosity (Heterozygous + Homozygous Variant): {num_variants_only}")

    # Unique variants
    print("\nUnique variant metrics for df_no_ref (13,047 rows):")
    unique_chr_pos_1 = df_no_ref["Chr:Pos"].nunique()
    unique_chr_pos_refalt_1 = len(df_no_ref[["Chr:Pos", "Ref/Alt"]].drop_duplicates())
    unique_var_id_1 = df_no_ref["Variant ID"].dropna().nunique()
    print(f"  - Unique Chr:Pos: {unique_chr_pos_1}")
    print(f"  - Unique (Chr:Pos, Ref/Alt): {unique_chr_pos_refalt_1}")
    print(f"  - Unique Variant ID (non-null): {unique_var_id_1}")

    print("\nUnique variant metrics for df_variants_only (11,896 rows):")
    unique_chr_pos_2 = df_variants_only["Chr:Pos"].nunique()
    unique_chr_pos_refalt_2 = len(df_variants_only[["Chr:Pos", "Ref/Alt"]].drop_duplicates())
    unique_var_id_2 = df_variants_only["Variant ID"].dropna().nunique()
    print(f"  - Unique Chr:Pos: {unique_chr_pos_2}")
    print(f"  - Unique (Chr:Pos, Ref/Alt): {unique_chr_pos_refalt_2}")
    print(f"  - Unique Variant ID (non-null): {unique_var_id_2}")

    # Schenz genes strict filtering
    df_no_ref_schenz = df_no_ref[df_no_ref["Gene Names"].isin(schenz_genes)]
    print(f"\nMetrics if filtered strictly by Schenz gene list:")
    print(f"  - Rows (Zygosity != 'Reference'): {len(df_no_ref_schenz)}")
    print(f"  - Unique (Chr:Pos, Ref/Alt): {len(df_no_ref_schenz[['Chr:Pos', 'Ref/Alt']].drop_duplicates())}")

    df_variants_schenz = df_variants_only[df_variants_only["Gene Names"].isin(schenz_genes)]
    print(f"  - Rows (Het + Hom): {len(df_variants_schenz)}")
    print(f"  - Unique (Chr:Pos, Ref/Alt): {len(df_variants_schenz[['Chr:Pos', 'Ref/Alt']].drop_duplicates())}")

if __name__ == "__main__":
    main()
