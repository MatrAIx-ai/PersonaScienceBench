import pandas as pd
import numpy as np
from scipy import stats
import statsmodels.api as sm
import statsmodels.formula.api as smf

def run_analysis():
    df = pd.read_csv('data/invaded_niche_pathways.csv', sep='\t')
    
    # Summary by habitat
    records = []
    for hab, grp in df.groupby('habitat'):
        n_plots = len(grp)
        n_pres = (grp['n.gard'] > 0).sum()
        pres_rate = n_pres / n_plots * 100.0
        mean_gard = grp['n.gard'].mean()
        std_gard = grp['n.gard'].std()
        median_gard = grp['n.gard'].median()
        q25 = grp['n.gard'].quantile(0.25)
        q75 = grp['n.gard'].quantile(0.75)
        sum_gard = grp['n.gard'].sum()
        sum_total = grp['n.total'].sum()
        gard_share_pct = (sum_gard / sum_total * 100.0) if sum_total > 0 else 0.0
        mean_total = grp['n.total'].mean()
        mean_unint = grp['n.unint'].mean()
        mean_agfo = grp['n.agfo'].mean()
        
        records.append({
            'habitat': hab,
            'n_plots': n_plots,
            'n_plots_present': n_pres,
            'presence_rate_pct': round(pres_rate, 2),
            'mean_n_gard': round(mean_gard, 3),
            'std_n_gard': round(std_gard, 3),
            'median_n_gard': median_gard,
            'q25': q25,
            'q75': q75,
            'sum_n_gard': sum_gard,
            'sum_n_total': sum_total,
            'gard_share_pct': round(gard_share_pct, 2),
            'mean_n_total': round(mean_total, 3),
            'mean_n_unint': round(mean_unint, 3),
            'mean_n_agfo': round(mean_agfo, 3)
        })
        
    summary_df = pd.DataFrame(records).sort_values('mean_n_gard', ascending=False).reset_index(drop=True)
    summary_df.to_csv('habitat_gardening_summary.csv', index=False)
    print("Summary table written to habitat_gardening_summary.csv")
    print(summary_df.to_string(index=False))
    
    # Kruskal-Wallis test
    groups = [grp['n.gard'].values for _, grp in df.groupby('habitat')]
    kw_stat, kw_p = stats.kruskal(*groups)
    print(f"\nKruskal-Wallis test on n.gard across habitats: H = {kw_stat:.4f}, p = {kw_p:.4e}")
    
    # Chi-square test on presence/absence
    ct = pd.crosstab(df['habitat'], df['n.gard'] > 0)
    chi2, p_chi2, dof, _ = stats.chi2_contingency(ct)
    print(f"Chi-square test on occurrence (n.gard > 0): chi2 = {chi2:.4f}, df = {dof}, p = {p_chi2:.4e}")
    
    # Negative binomial regression with Urban as reference
    df_nb = df.copy()
    df_nb['n_gard'] = df_nb['n.gard']
    nb_res = smf.glm('n_gard ~ C(habitat, Treatment(reference="Urban"))', data=df_nb, family=sm.families.NegativeBinomial()).fit()
    print("\nNegative Binomial GLM summary table:")
    print(nb_res.summary().tables[1])

if __name__ == '__main__':
    run_analysis()
