#!/usr/bin/env python3
r"""
Shared-mode recovery from complex response curves using joint multistart
Variable Projection (VarPro) and Non-Negative Least Squares (NNLS).

Model:
    R_m(x) = a_{0,m} + \sum_{k=1}^K a_{k,m} / (1 + (i * x * tau_k)^phi_k)
Constraints:
    tau_k > 0, 0 < phi_k <= 1, a_{k,m} >= 0, a_{0,m} >= 0.
"""

import os
import json
import numpy as np
import pandas as pd
from scipy.optimize import minimize, nnls

def load_data(data_path="data/curves.csv", meta_path="data/meta.json"):
    with open(meta_path, "r") as f:
        meta = json.load(f)
    
    df = pd.read_csv(data_path)
    curves = sorted(df["curve"].unique())
    M = len(curves)
    xs = df[df["curve"] == curves[0]]["x"].values
    N = len(xs)
    
    y_re = np.array([df[df["curve"] == m]["re"].values for m in curves])
    y_im = np.array([df[df["curve"] == m]["im"].values for m in curves])
    
    return meta, xs, y_re, y_im, M, N

def evaluate_basis(xs, taus, phis):
    """
    Computes basis functions for given taus and phis.
    basis_k(x) = 1 / (1 + (i * x * tau_k)^phi_k)
               = 1 / (1 + (x * tau_k)^phi_k * exp(i * pi / 2 * phi_k))
    """
    basis = []
    for tau, phi in zip(taus, phis):
        z = (xs * tau) ** phi * np.exp(1j * 0.5 * np.pi * phi)
        basis.append(1.0 / (1.0 + z))
    return np.array(basis) # shape (K, N)

def solve_varpro(params, K, xs, y_re, y_im, M, N):
    """
    Given non-linear parameters (log_taus, phis), solves for linear parameters (amplitudes & baselines)
    using Non-Negative Least Squares (NNLS).
    """
    log_taus = params[:K]
    phis = params[K:]
    taus = np.exp(log_taus)
    
    basis_mat = evaluate_basis(xs, taus, phis) # (K, N)
    
    # Construct design matrix for NNLS: [real(modes), 1; imag(modes), 0]
    A_re = np.vstack([basis_mat.real, np.ones((1, N))]).T # (N, K+1)
    A_im = np.vstack([basis_mat.imag, np.zeros((1, N))]).T # (N, K+1)
    A = np.vstack([A_re, A_im]) # (2N, K+1)
    
    total_rss = 0.0
    all_amps = []
    for m in range(M):
        b = np.concatenate([y_re[m], y_im[m]])
        sol, norm = nnls(A, b)
        total_rss += norm ** 2
        all_amps.append(sol)
        
    return total_rss, np.array(all_amps)

def fit_model_k(K, xs, y_re, y_im, M, N, n_starts=25, seed_offset=0):
    bounds = [(-11.0, 11.0)] * K + [(0.1, 1.0)] * K
    
    def loss_func(p):
        rss, _ = solve_varpro(p, K, xs, y_re, y_im, M, N)
        return rss

    best_loss = np.inf
    best_params = None

    for i in range(n_starts):
        np.random.seed(seed_offset + i * 17 + K * 101)
        # Log-spaced initial taus spanning the observation range
        init_log_tau = np.sort(np.random.uniform(-8.0, 8.0, K))
        init_phi = np.random.uniform(0.65, 0.95, K)
        x0 = np.concatenate([init_log_tau, init_phi])
        
        res = minimize(loss_func, x0, method="L-BFGS-B", bounds=bounds)
        if res.fun < best_loss:
            best_loss = res.fun
            best_params = res.x

    rss, all_amps = solve_varpro(best_params, K, xs, y_re, y_im, M, N)
    taus = np.exp(best_params[:K])
    phis = best_params[K:]
    
    # Sort by ascending tau
    sort_idx = np.argsort(taus)
    taus = taus[sort_idx]
    phis = phis[sort_idx]
    
    # all_amps is (M, K+1), where columns 0..K-1 are mode amplitudes, column K is baseline
    mode_amps = all_amps[:, sort_idx] # (M, K)
    baselines = all_amps[:, -1]       # (M,)
    
    n_obs = 2 * N * M
    p = 2 * K + (K + 1) * M
    aic = n_obs * np.log(rss / n_obs) + 2 * p
    bic = n_obs * np.log(rss / n_obs) + p * np.log(n_obs)
    rmse = np.sqrt(rss / n_obs)

    return {
        "K": K,
        "rss": rss,
        "rmse": rmse,
        "aic": aic,
        "bic": bic,
        "taus": taus,
        "phis": phis,
        "mode_amps": mode_amps,
        "baselines": baselines,
        "p": p
    }

def main():
    print("Loading data...")
    meta, xs, y_re, y_im, M, N = load_data()
    print(f"Data summary: M={M} curves, N={N} points per curve, x in [{xs.min():.4e}, {xs.max():.4e}]")

    print("\n--- Model Selection (K = 1 to 6) ---")
    results_by_k = {}
    for k in range(1, 7):
        print(f"Fitting K={k} with multi-start optimization...")
        res = fit_model_k(k, xs, y_re, y_im, M, N, n_starts=25)
        results_by_k[k] = res
        print(f"  K={k:d}: RSS={res['rss']:.5f}, RMSE={res['rmse']:.5f}, AIC={res['aic']:.2f}, BIC={res['bic']:.2f}")

    # Select best K by BIC
    best_k = min(results_by_k.keys(), key=lambda k: results_by_k[k]["bic"])
    print(f"\nOptimal model order selected by BIC: K = {best_k}")

    best_res = results_by_k[best_k]
    print(f"\n--- Best Model Details (K = {best_k}) ---")
    print(f"RSS: {best_res['rss']:.5f}")
    print(f"RMSE: {best_res['rmse']:.5f}")
    print(f"BIC: {best_res['bic']:.2f}")

    print("\nRecovered Shared Mode Parameters:")
    for i in range(best_k):
        amps_str = ", ".join([f"a_{m}={best_res['mode_amps'][m, i]:.4f}" for m in range(M)])
        print(f"  Mode {i+1}: tau = {best_res['taus'][i]:.5e}, phi = {best_res['phis'][i]:.4f} | Amplitudes: {amps_str}")

    print("\nPer-curve Baselines (a0):")
    for m in range(M):
        print(f"  Curve {m}: a0_{m} = {best_res['baselines'][m]:.4f}")

    # Save results/modes.csv
    os.makedirs("results", exist_ok=True)
    out_csv = "results/modes.csv"

    # CSV format:
    # columns: tau, a_0, a_1, ..., a_{M-1}
    # where tau is mode centre and a_m is that mode's amplitude in curve m
    rows = []
    for i in range(best_k):
        row = {"tau": best_res["taus"][i]}
        for m in range(M):
            row[f"a_{m}"] = best_res["mode_amps"][m, i]
        rows.append(row)

    out_df = pd.DataFrame(rows)
    out_df.to_csv(out_csv, index=False)
    print(f"\nSuccessfully wrote recovered modes to '{out_csv}':")
    print(out_df.to_string(index=False))

if __name__ == "__main__":
    main()
