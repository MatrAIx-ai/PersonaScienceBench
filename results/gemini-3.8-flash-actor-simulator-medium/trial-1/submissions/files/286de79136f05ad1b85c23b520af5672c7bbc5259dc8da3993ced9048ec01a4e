import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf

def run_analysis():
    # Load dataset
    df = pd.read_csv('data/nls_ses_processed.csv')
    df.rename(columns={
        'BA DEGREE COMPLETED': 'BA',
        'ABILITY: COMPOSITE OF ASVAB SCORE': 'ABILITY',
        'PERCENTILE IN CLASS': 'CLASS_RANK',
        'FAMILY SIZE OF SAMPLE': 'FAM_SIZE'
    }, inplace=True)
    df['BA'] = df['BA'].astype(int)

    # Discretize SES
    df['ses_tertile'] = pd.qcut(df['SES'], q=3, labels=['Low', 'Medium', 'High'])
    df['ses_quartile'] = pd.qcut(df['SES'], q=4, labels=['Q1 (Low)', 'Q2 (Low-Mid)', 'Q3 (Mid-High)', 'Q4 (High)'])
    df['ses_quintile'] = pd.qcut(df['SES'], q=5, labels=['Quintile 1', 'Quintile 2', 'Quintile 3', 'Quintile 4', 'Quintile 5'])
    df['ses_decile'] = pd.qcut(df['SES'], q=10)

    # 1. Descriptive cross-tabulation
    tertile_rates = df.groupby(['ses_tertile', 'SAMPLE_RACE'])['BA'].agg(['count', 'sum', 'mean']).unstack()
    quartile_rates = df.groupby(['ses_quartile', 'SAMPLE_RACE'])['BA'].agg(['count', 'sum', 'mean']).unstack()
    quintile_rates = df.groupby(['ses_quintile', 'SAMPLE_RACE'])['BA'].agg(['count', 'sum', 'mean']).unstack()
    decile_rates = df.groupby(['ses_decile', 'SAMPLE_RACE'])['BA'].agg(['count', 'sum', 'mean']).unstack()

    # 2. Logistic regression models
    # Base model with academic controls
    m_base = smf.logit('BA ~ C(SAMPLE_RACE, Treatment("White")) + ABILITY + CLASS_RANK', data=df).fit(disp=False)
    
    # Interaction model with academic controls
    m_int = smf.logit('BA ~ C(SAMPLE_RACE, Treatment("White")) * SES + ABILITY + CLASS_RANK', data=df).fit(disp=False)
    
    # Full model
    m_full = smf.logit('BA ~ C(SAMPLE_RACE, Treatment("White")) * SES + ABILITY + CLASS_RANK + FAM_SIZE + C(SAMPLE_SEX)', data=df).fit(disp=False)

    print('Base Model Pseudo R2:', m_base.prsquared)
    print('Interaction Model Summary:')
    print(m_int.summary())

    return {
        'tertile_rates': tertile_rates,
        'quartile_rates': quartile_rates,
        'quintile_rates': quintile_rates,
        'decile_rates': decile_rates,
        'interaction_coef': m_int.params['C(SAMPLE_RACE, Treatment("White"))[T.Black]:SES'],
        'interaction_pval': m_int.pvalues['C(SAMPLE_RACE, Treatment("White"))[T.Black]:SES']
    }

if __name__ == '__main__':
    res = run_analysis()
