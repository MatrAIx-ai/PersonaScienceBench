#!/usr/bin/env python3
"""
Single-cell RNA-seq Integrated Analysis Pipeline
Using pure NumPy and SciPy only.

Tasks:
1. Normalization & Dimensionality Reduction (PCA via SVD)
2. Unsupervised Clustering (Ward's hierarchical clustering)
3. Pseudotime Trajectory Inference (k-NN + MST Geodesic Distance via Dijkstra)
4. Marker Gene Identification & Ranking (One-vs-rest Welch's t-test)
5. Directed Transcriptional Regulatory Network (GRN) Scoring (Multivariate Ridge Regression)
"""

import json
import os
import numpy as np
from scipy import linalg, stats
from scipy.cluster.hierarchy import linkage, fcluster
from scipy.spatial.distance import cdist
from scipy.sparse import csgraph


def load_data(counts_path="data/counts.npy", system_info_path="data/system_info.json"):
    """Load count matrix and system metadata."""
    if not os.path.exists(counts_path):
        raise FileNotFoundError(f"Counts file not found: {counts_path}")
    counts = np.load(counts_path)
    
    if os.path.exists(system_info_path):
        with open(system_info_path, "r", encoding="utf-8") as f:
            system_info = json.load(f)
    else:
        system_info = {
            "n_cells": counts.shape[0],
            "n_genes": counts.shape[1],
            "n_clusters": 4,
            "n_tf_genes": 20
        }
    return counts, system_info


def normalize_counts(counts, scale_factor=1e4):
    """
    Perform library-size normalization and log1p transformation.
    norm_counts = log(1 + (counts / library_size) * scale_factor)
    """
    lib_sizes = counts.sum(axis=1, keepdims=True)
    # Avoid division by zero if any cell has 0 total counts
    lib_sizes = np.maximum(lib_sizes, 1.0)
    norm_counts = np.log1p((counts / lib_sizes) * scale_factor)
    return norm_counts


def compute_pca(norm_counts, n_pcs=10):
    """
    Compute PCA via Singular Value Decomposition (SVD).
    Returns principal component projections.
    """
    X_centered = norm_counts - norm_counts.mean(axis=0)
    # SVD decomposition: X = U @ diag(s) @ Vt
    U, s, Vt = linalg.svd(X_centered, full_matrices=False)
    pcs = U[:, :n_pcs] * s[:n_pcs]
    return pcs, s, Vt


def cluster_cells(pcs, n_clusters=4):
    """
    Perform unsupervised clustering using Ward's minimum variance criterion.
    Returns 0-indexed cluster labels as int32.
    """
    Z = linkage(pcs, method='ward')
    # fcluster returns 1-based cluster IDs; convert to 0-based
    cluster_labels = fcluster(Z, t=n_clusters, criterion='maxclust') - 1
    return cluster_labels.astype(np.int32)


def infer_pseudotime(pcs, k_neighbors=15):
    """
    Infer single-cell pseudotime via geodesic shortest path on a k-NN + MST graph.
    Combines k-nearest neighbors with Minimum Spanning Tree to ensure graph connectivity.
    Roots trajectory at the extreme cell along the primary principal component.
    """
    dist_matrix = cdist(pcs, pcs)
    n_cells = len(pcs)
    
    # Construct k-NN graph
    k_adj = np.zeros_like(dist_matrix)
    for i in range(n_cells):
        knn_indices = np.argsort(dist_matrix[i])[1:k_neighbors + 1]
        k_adj[i, knn_indices] = dist_matrix[i, knn_indices]
    k_adj_sym = np.maximum(k_adj, k_adj.T)
    
    # Construct Minimum Spanning Tree to guarantee global connectivity
    mst = csgraph.minimum_spanning_tree(dist_matrix).toarray()
    mst_sym = np.maximum(mst, mst.T)
    
    # Combined connected graph
    graph = np.maximum(k_adj_sym, mst_sym)
    
    # Root selection: cell at the negative extremity of PC1
    root_idx = int(np.argmin(pcs[:, 0]))
    
    # Dijkstra shortest path from root
    distances = csgraph.dijkstra(graph, indices=root_idx, directed=False)
    
    # Min-max scaling to [0.0, 1.0]
    min_dist = distances.min()
    max_dist = distances.max()
    if max_dist > min_dist:
        pseudotime = (distances - min_dist) / (max_dist - min_dist)
    else:
        pseudotime = np.zeros_like(distances)
        
    return pseudotime.astype(np.float64)


def identify_de_genes(norm_counts, cluster_labels, n_tf_genes=20, n_clusters=4, top_k=None):
    """
    Perform one-vs-rest differential expression analysis using Welch's t-test.
    Ranks candidate marker genes (non-TF genes) by maximum t-statistic across clusters.
    """
    n_genes = norm_counts.shape[1]
    candidate_gene_indices = np.arange(n_tf_genes, n_genes)
    
    max_t_stats = []
    for g in candidate_gene_indices:
        t_vals = []
        for k in range(n_clusters):
            in_cluster = norm_counts[cluster_labels == k, g]
            out_cluster = norm_counts[cluster_labels != k, g]
            t_stat, _ = stats.ttest_ind(in_cluster, out_cluster, equal_var=False)
            t_vals.append(t_stat)
        max_t_stats.append(np.max(t_vals))
        
    max_t_stats = np.array(max_t_stats)
    ranked_order = np.argsort(max_t_stats)[::-1]
    sorted_gene_indices = candidate_gene_indices[ranked_order].tolist()
    
    if top_k is not None:
        sorted_gene_indices = sorted_gene_indices[:top_k]
        
    return sorted_gene_indices


def compute_grn(norm_counts, n_tf_genes=20, alpha=1.0):
    """
    Compute directed TF x TF regulatory scores using multivariate Ridge regression.
    Convention: grn_scores[i, j] represents edge i -> j (i is regulator, j is target).
    Diagonal entries are set to 0.0.
    """
    tf_data = norm_counts[:, :n_tf_genes]
    
    # Standardize TF features
    tf_mean = tf_data.mean(axis=0)
    tf_std = tf_data.std(axis=0)
    tf_std[tf_std == 0] = 1.0
    tf_standardized = (tf_data - tf_mean) / tf_std
    
    grn_scores = np.zeros((n_tf_genes, n_tf_genes), dtype=np.float64)
    
    for j in range(n_tf_genes):
        # Candidate regulators are all TF genes except j
        reg_indices = [i for i in range(n_tf_genes) if i != j]
        X_j = tf_standardized[:, reg_indices]
        y_j = tf_standardized[:, j]
        
        # Ridge regression: beta = (X^T X + alpha * I)^(-1) X^T y
        XtX = X_j.T @ X_j
        Xty = X_j.T @ y_j
        reg_eye = alpha * np.eye(len(reg_indices))
        beta = np.linalg.solve(XtX + reg_eye, Xty)
        
        # Store absolute regulatory strength: grn_scores[i, j] = |beta_{i -> j}|
        for idx_in_reg, i in enumerate(reg_indices):
            grn_scores[i, j] = float(abs(beta[idx_in_reg]))
            
    # Explicitly ensure diagonal is 0.0
    np.fill_diagonal(grn_scores, 0.0)
    return grn_scores


def main():
    print("Starting single-cell RNA-seq integrated analysis pipeline...")
    
    # 1. Load inputs
    counts, system_info = load_data()
    n_cells = system_info.get("n_cells", counts.shape[0])
    n_genes = system_info.get("n_genes", counts.shape[1])
    n_clusters = system_info.get("n_clusters", 4)
    n_tf_genes = system_info.get("n_tf_genes", 20)
    
    print(f"Loaded counts matrix: shape={counts.shape}, dtype={counts.dtype}")
    print(f"Metadata: n_cells={n_cells}, n_genes={n_genes}, n_clusters={n_clusters}, n_tf_genes={n_tf_genes}")
    
    # 2. Normalization & Dimensionality Reduction
    norm_counts = normalize_counts(counts, scale_factor=1e4)
    pcs, s, Vt = compute_pca(norm_counts, n_pcs=10)
    print(f"Computed top 10 PCs. Singular values: {s[:5]}")
    
    # 3. Clustering
    clusters = cluster_cells(pcs, n_clusters=n_clusters)
    print(f"Clustering complete. Cluster sizes: {np.bincount(clusters)}")
    np.save("clusters.npy", clusters)
    
    # 4. Pseudotime Inference
    pseudotime = infer_pseudotime(pcs, k_neighbors=15)
    print(f"Pseudotime computed: min={pseudotime.min():.4f}, median={np.median(pseudotime):.4f}, max={pseudotime.max():.4f}")
    np.save("pseudotime.npy", pseudotime)
    
    # 5. Marker Gene Ranking (Differential Expression)
    # Ranks candidate marker genes (non-TF genes 20..249) by maximum one-vs-rest t-statistic
    de_gene_indices = identify_de_genes(norm_counts, clusters, n_tf_genes=n_tf_genes, n_clusters=n_clusters)
    print(f"Identified {len(de_gene_indices)} ranked candidate marker genes.")
    with open("de_genes.json", "w", encoding="utf-8") as f:
        json.dump({"gene_indices": de_gene_indices}, f, indent=2)
        
    # 6. Directed GRN Scoring
    grn_scores = compute_grn(norm_counts, n_tf_genes=n_tf_genes, alpha=1.0)
    print(f"GRN computed: shape={grn_scores.shape}, dtype={grn_scores.dtype}, mean={grn_scores.mean():.4f}, max={grn_scores.max():.4f}")
    np.save("grn_scores.npy", grn_scores)
    
    # 7. Method Choices Documentation
    method_choices = {
        "normalization": {
            "method": "CPM-like library size scaling (scale_factor=10000) followed by natural logarithm transform (log1p)",
            "justification": "Stabilizes technical variance across cells with varying sequencing depths while preserving count distribution and biological differences without introducing negative values."
        },
        "dimensionality_reduction": {
            "method": "Mean-centering followed by Singular Value Decomposition (SVD) for PCA (top 10 components)",
            "justification": "Captures the leading orthogonal axes of biological variation and denoises single-cell expression data strictly using scipy.linalg.svd."
        },
        "clustering": {
            "method": "Agglomerative hierarchical clustering using Ward's minimum variance criterion (scipy.cluster.hierarchy.linkage with method='ward')",
            "justification": "Deterministic and robust method that minimizes within-cluster variance in the low-dimensional PC space, yielding balanced and stable clusters without random seed sensitivity."
        },
        "pseudotime": {
            "method": "Geodesic shortest path on a combined k-NN (k=15) and Minimum Spanning Tree (MST) manifold graph via Dijkstra's algorithm (scipy.sparse.csgraph.dijkstra)",
            "justification": "Reconstructs continuous non-linear differentiation trajectories along the manifold; the MST guarantees global graph connectivity across sparse regions, rooted at the extreme cell along PC1."
        },
        "differential_expression": {
            "method": "One-vs-rest two-sample Welch's t-test (scipy.stats.ttest_ind with equal_var=False) evaluating expression in each cluster against the rest",
            "justification": "Welch's t-test robustly accounts for unequal sample sizes and variances across clusters. Candidate marker genes are ranked by maximum t-statistic across clusters to identify cluster-defining markers."
        },
        "grn": {
            "method": "Multivariate regularized linear regression (Ridge regression, L2 penalty alpha=1.0) predicting each target TF from candidate regulators",
            "justification": "Yields an inherently directed regulatory score matrix W where W[i, j] = |beta_{i -> j}| reflects the regulatory influence of TF i on target TF j, strictly conforming to the W[i, j] = i -> j convention with zero diagonal."
        }
    }
    with open("method_choices.json", "w", encoding="utf-8") as f:
        json.dump(method_choices, f, indent=2)
        
    print("All tasks completed successfully. Output files generated.")


if __name__ == "__main__":
    main()
