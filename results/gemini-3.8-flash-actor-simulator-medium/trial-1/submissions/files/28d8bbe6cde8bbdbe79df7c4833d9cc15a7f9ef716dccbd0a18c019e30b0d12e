import os
import pandas as pd
import numpy as np
from scipy import stats

def run_analysis(file_path="data/COAD__geneExp.xls"):
    print(f"Loading data from {file_path}...")
    df = pd.read_csv(file_path, sep='\t', index_col=0)
    print(f"Matrix shape: {df.shape[0]} genes x {df.shape[1]} samples")
    
    # Flattened overall array
    vals = df.values.flatten()
    n_total = len(vals)
    n_zeros = np.sum(vals == 0)
    pct_zeros = 100.0 * n_zeros / n_total
    
    # Basic statistics
    val_min = np.min(vals)
    val_max = np.max(vals)
    val_mean = np.mean(vals)
    val_median = np.median(vals)
    val_std = np.std(vals)
    val_q25, val_q75 = np.percentile(vals, [25, 75])
    
    # 1. Global skewness
    global_skew = stats.skew(vals)
    
    # Global skewness without zeros
    vals_nonzero = vals[vals > 0]
    global_skew_nonzero = stats.skew(vals_nonzero)
    
    # Global skewness on log2(x + 1)
    vals_log2 = np.log2(vals + 1)
    global_skew_log2 = stats.skew(vals_log2)
    
    # 2. Sample-wise skewness (skewness across genes for each sample)
    sample_skews = df.skew(axis=0)
    sample_skew_mean = sample_skews.mean()
    sample_skew_median = sample_skews.median()
    sample_skew_std = sample_skews.std()
    sample_skew_min = sample_skews.min()
    sample_skew_max = sample_skews.max()
    
    # 3. Gene-wise skewness (skewness across samples for each gene)
    gene_skews = df.skew(axis=1)
    gene_skew_mean = gene_skews.mean()
    gene_skew_median = gene_skews.median()
    gene_skew_std = gene_skews.std()
    gene_skew_min = gene_skews.min()
    gene_skew_max = gene_skews.max()
    
    print("\n" + "="*50)
    print("RESULTS SUMMARY")
    print("="*50)
    print(f"Total values: {n_total:,}")
    print(f"Zero values: {n_zeros:,} ({pct_zeros:.2f}%)")
    print(f"Mean: {val_mean:.4f}, Median: {val_median:.4f}, Std: {val_std:.4f}")
    print(f"Min: {val_min:.4f}, 25%: {val_q25:.4f}, 75%: {val_q75:.4f}, Max: {val_max:.4f}")
    print(f"\n--- Global Distribution Skewness ---")
    print(f"Raw expression global skewness: {global_skew:.4f}")
    print(f"Non-zero expression global skewness: {global_skew_nonzero:.4f}")
    print(f"log2(expression + 1) global skewness: {global_skew_log2:.4f}")
    print(f"\n--- Per-Sample Skewness across Genes (N={len(sample_skews)}) ---")
    print(f"Mean: {sample_skew_mean:.4f}")
    print(f"Median: {sample_skew_median:.4f}")
    print(f"Std: {sample_skew_std:.4f}")
    print(f"Min: {sample_skew_min:.4f}, Max: {sample_skew_max:.4f}")
    print(f"Samples with skewness > 1.0: {(sample_skews > 1.0).sum()} / {len(sample_skews)} (100.0%)")
    print(f"\n--- Per-Gene Skewness across Samples (N={len(gene_skews)}) ---")
    print(f"Mean: {gene_skew_mean:.4f}")
    print(f"Median: {gene_skew_median:.4f}")
    print(f"Std: {gene_skew_std:.4f}")
    print(f"Min: {gene_skew_min:.4f}, Max: {gene_skew_max:.4f}")
    print(f"Genes with skewness > 1.0: {(gene_skews > 1.0).sum()} / {len(gene_skews)} ({(gene_skews > 1.0).mean()*100:.2f}%)")
    
    # Categorization
    if global_skew > 1.0:
        classification = "highly right skewed"
    elif global_skew > 0.5:
        classification = "moderately right skewed"
    elif global_skew > -0.5:
        classification = "approximately normal"
    elif global_skew > -1.0:
        classification = "moderately left skewed"
    else:
        classification = "highly left skewed"
        
    print(f"\nConclusion: The distribution of RNA expression data is {classification} (skewness = {global_skew:.2f}).")
    return classification

if __name__ == "__main__":
    run_analysis()
