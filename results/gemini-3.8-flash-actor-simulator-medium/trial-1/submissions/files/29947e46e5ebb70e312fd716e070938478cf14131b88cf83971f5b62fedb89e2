import pandas as pd

# Load datasets
study_df = pd.read_csv('data/meta-regression_study_data_heterogeneity_in_replication_projects.csv')
rep_df = pd.read_csv('data/meta-regression_replication_success_data_heterogeneity_in_replication_projects.csv')

# Filter for Experimental Economics
ee_study = study_df[study_df['project'] == 'ee']
ee_rep = rep_df[rep_df['project'] == 'Experimental Economics']

total_ee = len(ee_study)
online_count = (ee_study['online.o'] == 1.0).sum()
lab_count = (ee_study['online.o'] == 0.0).sum()
proportion_lab = lab_count / total_ee

print(f'Total Experimental Economics studies: {total_ee}')
print(f'Studies conducted in lab setting: {lab_count}')
print(f'Studies conducted online: {online_count}')
print(f'Proportion of studies conducted in lab setting: {proportion_lab:.4f} ({proportion_lab * 100:.1f}%)')
print(f'US Lab distribution: {ee_study["us_lab.o"].value_counts().to_dict()}')