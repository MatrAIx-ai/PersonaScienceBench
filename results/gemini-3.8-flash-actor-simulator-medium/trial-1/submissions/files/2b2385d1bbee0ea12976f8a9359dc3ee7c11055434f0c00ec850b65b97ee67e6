import pandas as pd
import numpy as np

# Load capital data
df_cap = pd.read_csv('data/capital.csv', decimal=',')
sub_cap = df_cap[(df_cap['BCE'] >= 3000) & (df_cap['BCE'] <= 3400)].sort_values('BCE', ascending=False)

print('=== 100-year Binned Data (3400 BCE to 3000 BCE) ===')
cols = ['BCE', 'ZMonument', 'ZBeil', 'Zhausgr', 'ZAxtSchwert', 'ZDolch']
print(sub_cap[cols].to_string(index=False))

print('\n=== Correlations in 100-year Binned Data ===')
print(sub_cap[['ZMonument', 'ZBeil', 'Zhausgr', 'ZAxtSchwert']].corr())

# Time series data (interpolated)
df_ts = pd.read_csv('data/time_series_data.csv')
sub_ts = df_ts[(df_ts['CE'] >= -3400) & (df_ts['CE'] <= -3000)]
ts_cols = ['MonumentCount_inter', 'AxesCelts_inter', 'HouseSize_inter', 'HatchetSword_inter']
print('\n=== Time Series Correlations (Interpolated) ===')
print(sub_ts[ts_cols].corr())
