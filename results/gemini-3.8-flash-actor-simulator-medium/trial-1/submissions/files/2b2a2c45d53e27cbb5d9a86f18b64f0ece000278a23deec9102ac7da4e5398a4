import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf

# 1. Load Data
df = pd.read_csv('data/invaded_niche_pathways.csv', sep='\t')
df.columns = [c.replace('.', '_') for c in df.columns]

species_df = pd.read_csv('data/invasion_success_pathways.csv')
trends_df = pd.read_csv('data/temporal_trends_contingency_table.csv', sep='\t')

# 2. Summary stats across habitats
hab_summary = df.groupby('habitat')[['n_gard', 'n_unint', 'n_agfo', 'n_total']].mean()
print('=== Mean Richness by Habitat ===')
print(hab_summary.round(3))

# 3. Trait summary by pathway
trait_summary = species_df.groupby('intro.pathway').agg(
    n_species=('Scientific_name', 'count'),
    mean_plots=('number.of.invaded.plots', 'mean'),
    mean_occupancy=('area.of.occupancy.10km', 'mean'),
    mean_niche_breadth=('invaded.niche.breadth', 'mean'),
    mean_mrt=('mrt', 'mean')
)
print('\n=== Trait and Invasion Success by Pathway ===')
print(trait_summary.round(3))

# 4. Multi-scale & Temporal Poisson/NB Models
scales = ['50m', '500m', '1000m']
years = ['1956', '1993', '2009']
targets = ['n_gard', 'n_unint', 'n_agfo', 'n_total']

results = []
for tgt in targets:
    for yr in years:
        for sc in scales:
            var = f'urban_{yr}_{sc}'
            m_pois = smf.glm(f'{tgt} ~ {var}', data=df, family=sm.families.Poisson()).fit()
            m_nb = smf.negativebinomial(f'{tgt} ~ {var}', data=df).fit(disp=False)
            results.append({
                'target': tgt, 'year': yr, 'scale': sc,
                'pois_coef': m_pois.params[var], 'pois_pval': m_pois.pvalues[var], 'pois_aic': m_pois.aic,
                'nb_coef': m_nb.params[var], 'nb_pval': m_nb.pvalues[var], 'nb_aic': m_nb.aic
            })

res_df = pd.DataFrame(results)
print('\n=== Multi-scale and Temporal Model Results ===')
print(res_df.round(4).to_string())

# 5. Multivariate Models controlling for covariates
for col in ['elevation', 'distance_road', 'distance_stream', 'annual_temperature', 'annual_rainfall']:
    df[col + '_z'] = (df[col] - df[col].mean()) / df[col].std()

print('\n=== Multivariate Negative Binomial GLMs (with covariates) ===')
for tgt in ['n_unint', 'n_gard', 'n_agfo', 'n_total']:
    m = smf.glm(f'{tgt} ~ urban_2009_500m + cropland_2009_500m + elevation_z + distance_road_z',
                data=df, family=sm.families.NegativeBinomial()).fit()
    print(f'-- Response: {tgt} --')
    print(pd.DataFrame({'coef': m.params, 'pval': m.pvalues}).round(4))

# 6. Landscape dynamics (progressive vs regressive succession)
print('\n=== Landscape Succession Models (1956-2009) ===')
for tgt in ['n_unint', 'n_gard', 'n_agfo', 'n_total']:
    m_succ = smf.glm(f'{tgt} ~ progressive_1956_2009_50m + regressive_1956_2009_50m', data=df, family=sm.families.Poisson()).fit()
    print(f'-- Response: {tgt} --')
    print(pd.DataFrame({'coef': m_succ.params, 'pval': m_succ.pvalues}).round(4))

