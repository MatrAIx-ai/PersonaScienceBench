import pandas as pd
import json

def run_analysis():
    df = pd.read_csv('data/meta-regression_study_data_heterogeneity_in_replication_projects.csv')
    
    # 1. RPP primary analysis
    rpp = df[df['project'] == 'rpp']
    rpp_rep = rpp[rpp['replicated'] == 1]
    
    # Seniority.r counts and proportions
    counts_r = rpp_rep['seniority.r'].value_counts()
    props_r = rpp_rep['seniority.r'].value_counts(normalize=True)
    table_r = pd.DataFrame({'count': counts_r, 'proportion': props_r})
    
    # Seniority.o counts and proportions
    counts_o = rpp_rep['seniority.o'].value_counts()
    props_o = rpp_rep['seniority.o'].value_counts(normalize=True)
    table_o = pd.DataFrame({'count': counts_o, 'proportion': props_o})
    
    # Drop == False
    rpp_clean = rpp[(rpp['drop'] == False) & (rpp['replicated'] == 1)]
    table_clean = pd.DataFrame({
        'count': rpp_clean['seniority.r'].value_counts(),
        'proportion': rpp_clean['seniority.r'].value_counts(normalize=True)
    })
    
    print("=== RPP Replication Seniority (seniority.r) ===")
    print(table_r)
    print("\n=== RPP Original Seniority (seniority.o) ===")
    print(table_o)
    print("\n=== RPP Cleaned (drop == False) Replication Seniority ===")
    print(table_clean)

if __name__ == '__main__':
    run_analysis()
