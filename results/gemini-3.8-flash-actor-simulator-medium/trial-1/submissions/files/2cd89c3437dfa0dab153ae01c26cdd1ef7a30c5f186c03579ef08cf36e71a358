#!/usr/bin/env python3
"""
Analysis script for determining the remaining CHIP variant count after removing reference calls.
Benchmark episode: bixbench:bix-7-q3
"""

import glob
import os
import sys
import pandas as pd
import numpy as np

def main():
    data_dir = 'data/CHIP_DP10_GQ20_PASS'
    files = sorted(glob.glob(os.path.join(data_dir, '*.xlsx')))
    print(f"Total sample files found: {len(files)}")
    
    if len(files) == 0:
        print("Error: No sample files found!")
        sys.exit(1)
        
    records = []
    
    for f in files:
        sample_name = os.path.basename(f).replace('230209_Exome_GRCh38_CHIP_', '').replace('.xlsx', '')
        # Row 0 is category header, Row 1 is actual column names
        df = pd.read_excel(f, header=1)
        df['sample_id'] = sample_name
        records.append(df)
        
    all_data = pd.concat(records, ignore_index=True)
    print(f"Total records loaded across all files: {len(all_data)}")
    
    # Check In_CHIP column
    in_chip_vals = all_data['In_CHIP'].value_counts(dropna=False).to_dict()
    print(f"In_CHIP distribution: {in_chip_vals}")
    
    # Check Zygosity column
    zyg_counts = all_data['Zygosity'].value_counts(dropna=False).to_dict()
    print("Zygosity distribution across all rows:")
    for k, v in zyg_counts.items():
        print(f"  {k}: {v}")
        
    # Interpretation 1: Row-level variant calls (total call rows)
    # 1a: Drop only rows where Zygosity == 'Reference' (retaining Het, Hom, and NaN)
    df_non_ref_all = all_data[all_data['Zygosity'] != 'Reference']
    count_non_ref_calls = len(df_non_ref_all)
    
    # 1b: Retain strictly confirmed non-reference calls (Heterozygous or Homozygous Variant)
    df_alt_calls = all_data[all_data['Zygosity'].isin(['Heterozygous', 'Homozygous Variant'])]
    count_alt_calls = len(df_alt_calls)
    
    # Interpretation 2: Distinct unique genomic variants (Chr:Pos + Ref/Alt)
    unique_all = all_data.drop_duplicates(subset=['Chr:Pos', 'Ref/Alt'])
    count_unique_all = len(unique_all)
    
    # 2a: Distinct variants among all non-reference rows (Zygosity != 'Reference')
    unique_non_ref = df_non_ref_all.drop_duplicates(subset=['Chr:Pos', 'Ref/Alt'])
    count_unique_non_ref = len(unique_non_ref)
    
    # 2b: Distinct variants among confirmed alt calls (Heterozygous or Homozygous Variant)
    unique_alt = df_alt_calls.drop_duplicates(subset=['Chr:Pos', 'Ref/Alt'])
    count_unique_alt = len(unique_alt)
    
    # Interpretation 3: Distinct unique genomic positions (Chr:Pos)
    count_unique_pos_non_ref = df_non_ref_all['Chr:Pos'].nunique()
    count_unique_pos_alt = df_alt_calls['Chr:Pos'].nunique()
    
    print("\n--- Summary of Counts ---")
    print(f"Total rows before filtering: {len(all_data)}")
    print(f"Total Reference calls removed: {zyg_counts.get('Reference', 0)}")
    print(f"Remaining calls (Zygosity != 'Reference', including NaN): {count_non_ref_calls}")
    print(f"Remaining calls (Heterozygous + Homozygous Variant only): {count_alt_calls}")
    print(f"Remaining unique variants (Zygosity != 'Reference', Chr:Pos + Ref/Alt): {count_unique_non_ref}")
    print(f"Remaining unique variants (Heterozygous + Homozygous Variant, Chr:Pos + Ref/Alt): {count_unique_alt}")
    print(f"Remaining unique positions (Chr:Pos, Zygosity != 'Reference'): {count_unique_pos_non_ref}")
    print(f"Remaining unique positions (Chr:Pos, Heterozygous + Homozygous Variant): {count_unique_pos_alt}")
    
    # Inspect Trio Status matching
    trio_file = 'data/230215_Trio_Status.xlsx'
    if os.path.exists(trio_file):
        trio_df = pd.read_excel(trio_file)
        trio_df['Sample ID Str'] = trio_df['Sample ID'].astype(str).str.strip()
        print(f"\nTrio status file loaded: {len(trio_df)} samples")
        
    # Save a summary report to disk
    summary_df = pd.DataFrame([
        {'Metric': 'Total rows in dataset', 'Count': len(all_data)},
        {'Metric': 'Reference calls removed', 'Count': zyg_counts.get('Reference', 0)},
        {'Metric': 'Remaining variant call rows (Zygosity != Reference)', 'Count': count_non_ref_calls},
        {'Metric': 'Remaining variant call rows (Het + Hom only)', 'Count': count_alt_calls},
        {'Metric': 'Total unique variants in dataset (Chr:Pos + Ref/Alt)', 'Count': count_unique_all},
        {'Metric': 'Remaining unique variants (Zygosity != Reference)', 'Count': count_unique_non_ref},
        {'Metric': 'Remaining unique variants (Het + Hom only)', 'Count': count_unique_alt},
    ])
    summary_df.to_csv('variant_counts_summary.csv', index=False)
    print("\nSummary saved to variant_counts_summary.csv")

if __name__ == '__main__':
    main()
