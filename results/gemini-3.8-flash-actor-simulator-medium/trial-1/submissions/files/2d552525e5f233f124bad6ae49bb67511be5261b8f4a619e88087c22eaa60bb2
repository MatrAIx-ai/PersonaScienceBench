import gzip
import struct
import pandas as pd
import numpy as np
from scipy.stats import fisher_exact
import statsmodels.stats.multitest as smm

def read_deseq_rds(filename):
    """
    Parse DESeq2 DESeqResults S4 object from an RDS file.
    """
    data = gzip.decompress(open(filename, 'rb').read())
    
    # Extract rownames (gene identifiers)
    r_idx = data.find(b'rownames')
    pos = r_idx + 8
    flags, = struct.unpack_from('>I', data, pos)
    pos += 4
    num_rows, = struct.unpack_from('>i', data, pos)
    pos += 4
    rownames = []
    for _ in range(num_rows):
        s_flags, = struct.unpack_from('>I', data, pos)
        pos += 4
        s_len, = struct.unpack_from('>i', data, pos)
        pos += 4
        val = data[pos:pos+s_len].decode('utf-8')
        pos += s_len
        rownames.append(val)
        
    # Find the 6 REALSXP vectors of length num_rows
    target_pattern = struct.pack('>I', num_rows)
    vectors = []
    idx = 0
    while True:
        idx = data.find(target_pattern, idx)
        if idx == -1:
            break
        if idx >= 4:
            fl, = struct.unpack_from('>I', data, idx - 4)
            if (fl & 0xff) == 14:  # REALSXP
                doubles = struct.unpack_from(f'>{num_rows}d', data, idx + 4)
                vectors.append(list(doubles))
        idx += 4
        
    col_names = ['baseMean', 'log2FoldChange', 'lfcSE', 'stat', 'pvalue', 'padj']
    df = pd.DataFrame(dict(zip(col_names, vectors)), index=rownames)
    return df

# Load the three DESeq2 results
files = {
    'Strain_97': 'data/res_1vs97.rds',
    'Strain_98': 'data/res_1vs98.rds',
    'Strain_99': 'data/res_1vs99.rds'
}

dfs = {name: read_deseq_rds(fn) for name, fn in files.items()}

# Total genes in universe
total_genes = len(next(iter(dfs.values())))
print(f"Total genes in dataset: {total_genes}")

# Extract significant downregulated genes (p < 0.05 & lfc < -1.5)
down_genes = {}
for name, df in dfs.items():
    sig = df[(df['padj'] < 0.05) & (df['log2FoldChange'] < -1.5)]
    down_genes[name] = set(sig.index)
    print(f"{name}: {len(sig)} significant downregulated genes")

common_down = set.intersection(*down_genes.values())
print(f"Common downregulated genes across all three mutants: {len(common_down)}")

