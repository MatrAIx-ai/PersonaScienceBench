import numpy as np
import pandas as pd

# Load capital dataset
df = pd.read_csv('data/capital.csv', decimal=',')

capital_cols = [
    'ZAxtSchwert', 'ZDolch', 'Zhausgr', 'ZCU_AU', 'Zamber', 
    'ZMonument', 'ZHort', 'ZSichel', 'ZBeil', 'ZMW', 'ZKeform', 'Zkeverz'
]

capital_categories = {
    'ZAxtSchwert': 'Symbolic Capital (Axes & Swords)',
    'ZDolch': 'Symbolic Capital (Daggers)',
    'Zhausgr': 'Symbolic Capital (House size)',
    'ZCU_AU': 'Social Capital (Copper & Gold)',
    'Zamber': 'Social Capital (Amber)',
    'ZMonument': 'Social Capital (Monument count)',
    'ZKeform': 'Cultural Capital (Ceramic form diversity)',
    'Zkeverz': 'Cultural Capital (Ceramic decoration diversity)',
    'ZHort': 'Economic Capital (Hoards/Deposits)',
    'ZSichel': 'Economic Capital (Sickles)',
    'ZBeil': 'Economic Capital (Stone axes/Celts)',
    'ZMW': 'Economic Capital (Monument size/work)'
}

X = df[capital_cols].values
mean_vec = np.mean(X, axis=0)
X_centered = X - mean_vec

# SVD PCA
U, S, Vt = np.linalg.svd(X_centered, full_matrices=False)
eigenvalues = (S ** 2) / (len(X) - 1)
explained_var_ratio = eigenvalues / np.sum(eigenvalues)

df['PC1'] = X_centered @ Vt[0]
df['PC2'] = X_centered @ Vt[1]

print("=== PCA Summary ===")
print(f"PC1 Explained Variance: {explained_var_ratio[0]*100:.2f}%")
print(f"PC2 Explained Variance: {explained_var_ratio[1]*100:.2f}%")
print("\n=== PC1 Loadings by Capital Category ===")
for col in capital_cols:
    idx = capital_cols.index(col)
    print(f"{col:12s} ({capital_categories[col]:45s}): {Vt[0, idx]:+.4f}")

print("\n=== Period Comparisons (PC1 Mean, Std, Min, Max) ===")
summary_period = df.groupby('group', sort=False)['PC1'].agg(['count', 'mean', 'std', 'min', 'max'])
print(summary_period)

print("\n=== Middle Neolithic (MN: 3400-3000 BCE) ===")
print(df[df['group'] == 'MN'][['BCE', 'group', 'PC1', 'PC2', 'Zamber', 'ZBeil', 'ZKeform', 'Zkeverz', 'ZCU_AU', 'ZAxtSchwert', 'ZDolch']])

print("\n=== Younger Neolithic (SG: 2900-2300 BCE) ===")
print(df[df['group'] == 'SG'][['BCE', 'group', 'PC1', 'PC2', 'Zamber', 'ZBeil', 'ZKeform', 'Zkeverz', 'ZCU_AU', 'ZAxtSchwert', 'ZDolch']])
