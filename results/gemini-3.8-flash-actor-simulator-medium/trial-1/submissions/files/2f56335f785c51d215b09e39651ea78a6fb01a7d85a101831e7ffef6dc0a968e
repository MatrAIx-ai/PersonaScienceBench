import pandas as pd
import numpy as np

def run_analysis():
    # Load dataset
    df = pd.read_csv('data/requirements_engineering_for_ML-enabled_systems.csv')
    
    # Identify relevant columns for roles addressing requirements (Question 8)
    role_cols = {
        'Project Lead': 'Q8_ML_Addressing_Project_Lead',
        'Data Scientist': 'Q8_ML_Addressing_Data_Scientist',
        'Business Analyst': 'Q8_ML_Addressing_Business_Analyst',
        'Developer': 'Q8_ML_Addressing_Developer',
        'Solution Architect': 'Q8_ML_Addressing_Solution_Architect',
        'Requirements Engineer': 'Q8_ML_Addressing_Requirement_Engineer',
        'Others': 'Q8_ML_Addressing_Others',
        'Tester': 'Q8_ML_Addressing_Tester'
    }
    
    # Exclude missing / unasked responses (-77, -99)
    valid_mask = df['Q8_ML_Addressing_Project_Lead'].isin(['quoted', 'not quoted'])
    df_valid = df[valid_mask].copy()
    
    print(f"Total respondents: {len(df)}")
    print(f"Valid respondents answering Q8: {len(df_valid)}")
    print(f"Excluded missing/unasked respondents (-77): {(~valid_mask).sum()}\n")
    
    results = {}
    np.random.seed(42)
    B = 10000
    
    print("Role Association with Requirements Engineering in ML-Enabled Systems:")
    print("-" * 75)
    print(f"{'Role':<25} {'Quoted':<8} {'Total':<8} {'Proportion (%)':<15} {'95% CI':<20}")
    print("-" * 75)
    
    for role_name, col in role_cols.items():
        quoted_count = (df_valid[col] == 'quoted').sum()
        total_count = len(df_valid)
        raw_prop = (quoted_count / total_count) * 100
        
        # Bootstrap resampling
        binary_vals = (df_valid[col] == 'quoted').astype(int).values
        boot_props = [np.mean(np.random.choice(binary_vals, size=total_count, replace=True)) * 100 for _ in range(B)]
        boot_mean = np.mean(boot_props)
        ci_low, ci_high = np.percentile(boot_props, [2.5, 97.5])
        
        results[role_name] = {
            'quoted': quoted_count,
            'total': total_count,
            'raw_proportion': raw_prop,
            'boot_mean': boot_mean,
            'ci_low': ci_low,
            'ci_high': ci_high
        }
        
        print(f"{role_name:<25} {quoted_count:<8} {total_count:<8} {raw_prop:<15.3f} [{ci_low:.3f}, {ci_high:.3f}]")
    
    print("-" * 75)
    
    # Rank roles by proportion
    sorted_roles = sorted(results.items(), key=lambda x: x[1]['raw_proportion'], reverse=True)
    top_two = [sorted_roles[0][0], sorted_roles[1][0]]
    print(f"\nTop two roles with highest proportion of association: {top_two[0]} and {top_two[1]}")
    
    return results

if __name__ == '__main__':
    run_analysis()
