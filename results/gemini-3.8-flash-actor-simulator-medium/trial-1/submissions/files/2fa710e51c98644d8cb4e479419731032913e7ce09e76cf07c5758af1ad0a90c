import openpyxl
import pandas as pd
import numpy as np

def run_analysis():
    file_path = 'data/Data_deposition_RNAseq_Paroxetine_2017.xlsx'
    print(f"Loading data from {file_path}...")
    wb = openpyxl.load_workbook(file_path, read_only=True)
    sheet = wb['NormCount']

    # DESeq comparisons for Bad Responder vs Control:
    # Baseline blood: Comparison 2 (starts at col 107 in 0-based index)
    # Dentate gyrus: Comparison 5 (starts at col 134 in 0-based index)
    # Final blood: Comparison 8 (starts at col 161 in 0-based index)
    comps = {
        'baseline_blood': 107,
        'dentate_gyrus': 134,
        'final_blood': 161
    }

    records = {tissue: [] for tissue in comps}

    for r_idx, row in enumerate(sheet.iter_rows(values_only=True)):
        if r_idx < 4:
            continue
        gene = row[1]
        for tissue, start in comps.items():
            bm = row[start]
            bmA = row[start+1]
            bmB = row[start+2]
            fc = row[start+3]
            lfc = row[start+4]
            pval = row[start+5]
            padj = row[start+6]
            deg_max = row[start+7]
            deg_med = row[start+8]

            def to_float(val):
                try:
                    return float(val)
                except (ValueError, TypeError):
                    return None

            records[tissue].append({
                'gene': gene,
                'baseMean': to_float(bm),
                'baseMeanA': to_float(bmA),
                'baseMeanB': to_float(bmB),
                'foldChange': to_float(fc),
                'log2FoldChange': to_float(lfc),
                'pval': to_float(pval),
                'padj': to_float(padj),
                'deg_max': deg_max,
                'deg_med': deg_med
            })

    results = {}
    for tissue, data in records.items():
        df = pd.DataFrame(data)
        
        # Criteria 1: padj < 0.05, lfc > 0.5, baseMean > 10
        c1 = (df['padj'] < 0.05) & (df['log2FoldChange'] > 0.5) & (df['baseMean'] > 10)
        
        # Criteria 2: padj < 0.05, |lfc| > 0.5, baseMean > 10
        c2 = (df['padj'] < 0.05) & (df['log2FoldChange'].abs() > 0.5) & (df['baseMean'] > 10)
        
        # Criteria 3: padj < 0.05, baseMean > 10
        c3 = (df['padj'] < 0.05) & (df['baseMean'] > 10)
        
        # Criteria 4: no padj threshold, lfc > 0.5, baseMean > 10
        c4 = (df['log2FoldChange'] > 0.5) & (df['baseMean'] > 10)
        
        # Criteria 5: no padj threshold, |lfc| > 0.5, baseMean > 10
        c5 = (df['log2FoldChange'].abs() > 0.5) & (df['baseMean'] > 10)
        
        # Criteria 6: pval < 0.05, lfc > 0.5, baseMean > 10
        c6 = (df['pval'] < 0.05) & (df['log2FoldChange'] > 0.5) & (df['baseMean'] > 10)
        
        # Criteria 7: author's precomputed DEG (Median)
        c7 = df['deg_med'].isin(['U', 'D'])

        results[tissue] = {
            'padj<0.05, lfc>0.5, bm>10': int(c1.sum()),
            'padj<0.05, |lfc|>0.5, bm>10': int(c2.sum()),
            'padj<0.05, bm>10': int(c3.sum()),
            'lfc>0.5, bm>10': int(c4.sum()),
            '|lfc|>0.5, bm>10': int(c5.sum()),
            'pval<0.05, lfc>0.5, bm>10': int(c6.sum()),
            'precomputed_DEG_median': int(c7.sum())
        }

    df_res = pd.DataFrame(results)
    print("\nSummary Results across Tissues:")
    print(df_res.to_string())

    # Find highest tissue for the primary question criterion (padj < 0.05, lfc > 0.5, bm > 10)
    top_tissue = df_res.loc['padj<0.05, lfc>0.5, bm>10'].idxmax()
    print(f"\nTissue type with highest number of DEGs: {top_tissue}")
    return df_res

if __name__ == '__main__':
    run_analysis()
