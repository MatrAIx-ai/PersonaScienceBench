import pandas as pd
import numpy as np

# Load datasets
capital_df = pd.read_csv('data/capital.csv', decimal=',')
ts_df = pd.read_csv('data/time_series_data.csv')

# Chronological sorting for capital.csv (BCE descending = chronological forward)
capital_chrono = capital_df.sort_values('BCE', ascending=False).reset_index(drop=True)

# Compute changes
capital_chrono['delta_PotteryForm'] = capital_chrono['ZKeform'].diff()
capital_chrono['delta_PotteryDecoration'] = capital_chrono['Zkeverz'].diff()

# Find opposing trends where Decoration increases and Form declines
opposing = []
for i in range(1, len(capital_chrono)):
    start_bce = capital_chrono.loc[i-1, 'BCE']
    end_bce = capital_chrono.loc[i, 'BCE']
    d_form = capital_chrono.loc[i, 'delta_PotteryForm']
    d_deco = capital_chrono.loc[i, 'delta_PotteryDecoration']
    
    if d_deco > 0 and d_form < 0:
        opposing.append({
            'period': f'{int(start_bce)}–{int(end_bce)} BCE',
            'century': f'{int(start_bce)//100}th century BCE',
            'start_bce': int(start_bce),
            'end_bce': int(end_bce),
            'form_start': capital_chrono.loc[i-1, 'ZKeform'],
            'form_end': capital_chrono.loc[i, 'ZKeform'],
            'form_change': d_form,
            'deco_start': capital_chrono.loc[i-1, 'Zkeverz'],
            'deco_end': capital_chrono.loc[i, 'Zkeverz'],
            'deco_change': d_deco
        })

opp_df = pd.DataFrame(opposing)
print(opp_df.to_string())

# Also verify in time_series_data.csv
ts_points = ts_df[ts_df['PotteryForm'].notna()][['CE', 'calBP', 'PotteryForm', 'PotteryDecoration']].copy()
ts_points = ts_points.sort_values('CE', ascending=True).reset_index(drop=True)
ts_points['delta_form'] = ts_points['PotteryForm'].diff()
ts_points['delta_deco'] = ts_points['PotteryDecoration'].diff()
ts_opp = ts_points[(ts_points['delta_deco'] > 0) & (ts_points['delta_form'] < 0)]
print("\nFrom time_series_data.csv non-null points:")
print(ts_opp)
