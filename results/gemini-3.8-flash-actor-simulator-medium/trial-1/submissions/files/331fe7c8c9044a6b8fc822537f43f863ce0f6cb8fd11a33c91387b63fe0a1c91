import pandas as pd
from scipy import stats

# Load data
df = pd.read_csv('data/meta-regression_study_data_heterogeneity_in_replication_projects.csv')

def summarize(series, name):
    return {
        'name': name,
        'N': int(len(series)),
        'mean': round(float(series.mean()), 2),
        'median': round(float(series.median()), 2),
        'std': round(float(series.std(ddof=1)), 2),
        'min': int(series.min()),
        'max': int(series.max())
    }

# Level 1: Unique study IDs (N=141)
df_id = df.drop_duplicates(subset=['id'])
ee_id = df_id[df_id['project'] == 'ee']['length']
rpp_id = df_id[df_id['project'] == 'rpp']['length']
psych_id = df_id[df_id['discipline'].isin(['Social', 'Cognitive'])]['length']

# Level 2: Unique study Titles (N=135)
df_title = df.drop_duplicates(subset=['title'])
ee_title = df_title[df_title['project'] == 'ee']['length']
rpp_title = df_title[df_title['project'] == 'rpp']['length']
psych_title = df_title[df_title['discipline'].isin(['Social', 'Cognitive'])]['length']

# Level 3: Raw rows (N=927)
ee_raw = df[df['project'] == 'ee']['length']
rpp_raw = df[df['project'] == 'rpp']['length']
psych_raw = df[df['discipline'].isin(['Social', 'Cognitive'])]['length']

results = [
    summarize(ee_id, 'Experimental Economics (unique id)'),
    summarize(rpp_id, 'Psychology - RPP project (unique id)'),
    summarize(psych_id, 'Psychology - Social+Cognitive disciplines (unique id)'),
    summarize(ee_title, 'Experimental Economics (unique title)'),
    summarize(rpp_title, 'Psychology - RPP project (unique title)'),
    summarize(psych_title, 'Psychology - Social+Cognitive disciplines (unique title)'),
    summarize(ee_raw, 'Experimental Economics (raw rows)'),
    summarize(rpp_raw, 'Psychology - RPP project (raw rows)'),
    summarize(psych_raw, 'Psychology - Social+Cognitive disciplines (raw rows)')
]

res_df = pd.DataFrame(results)
print(res_df.to_string(index=False))
res_df.to_csv('artifacts/summary_stats.csv', index=False)
