import pandas as pd
import statsmodels.api as sm
import statsmodels.formula.api as smf

def run_analysis():
    # Load dataset
    df = pd.read_csv('data/nls_ses_processed.csv')
    df.columns = [c.replace(' ', '_').replace(':', '') for c in df.columns]
    df['BA_DEGREE_COMPLETED'] = df['BA_DEGREE_COMPLETED'].astype(int)

    print("=== Model 1: Demographics with Family Size & Race ===")
    m1 = smf.logit('BA_DEGREE_COMPLETED ~ C(SAMPLE_RACE, Treatment(reference="White")) + FAMILY_SIZE_OF_SAMPLE', data=df).fit()
    print(m1.summary())

    print("\n=== Model 2: Full Model with SES and Academic Characteristics ===")
    m2 = smf.logit('BA_DEGREE_COMPLETED ~ C(SAMPLE_RACE, Treatment(reference="White")) + SES + ABILITY_COMPOSITE_OF_ASVAB_SCORE + PERCENTILE_IN_CLASS', data=df).fit()
    print(m2.summary())

    print("\n=== Model 3: Full Model with All Background, SES, and Academic Factors ===")
    m3 = smf.logit('BA_DEGREE_COMPLETED ~ C(SAMPLE_RACE, Treatment(reference="White")) + SAMPLE_SEX + FAMILY_SIZE_OF_SAMPLE + SES + ABILITY_COMPOSITE_OF_ASVAB_SCORE + PERCENTILE_IN_CLASS', data=df).fit()
    print(m3.summary())

if __name__ == '__main__':
    run_analysis()
