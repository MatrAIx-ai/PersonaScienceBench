#!/usr/bin/env python3
"""
Analysis script to extract log2 fold change for mexG expression in ΔrhlI (strain #97) compared to wt (strain #1).
Task: bixbench:bix-46-q1
"""

import gzip
import struct
import pandas as pd
import numpy as np


def parse_deseq_rds(rds_path):
    """
    Parses a DESeqResults S4 object serialized into an RDS file.
    Extracts rownames (locus tags) and the 6 numeric statistics columns.
    """
    with gzip.open(rds_path, 'rb') as f:
        data = f.read()

    # 1. Parse rownames
    pos_rownames = data.find(b'rownames')
    if pos_rownames == -1:
        raise ValueError("Could not find 'rownames' in RDS object.")
    
    pos = pos_rownames + len(b'rownames')
    s_type, n_rows = struct.unpack('>II', data[pos:pos+8])
    
    offset = pos + 8
    rownames = []
    for _ in range(n_rows):
        flags = struct.unpack('>I', data[offset:offset+4])[0]
        if flags == 255:  # NA_STRING
            rownames.append(None)
            offset += 4
        else:
            slen = struct.unpack('>I', data[offset+4:offset+8])[0]
            s = data[offset+8:offset+8+slen].decode('utf-8')
            rownames.append(s)
            offset += 8 + slen

    # 2. Extract column data from listData
    cols = ['baseMean', 'log2FoldChange', 'lfcSE', 'stat', 'pvalue', 'padj']
    col_dict = {'gene_id': rownames}

    cur = data.find(b'listData')
    if cur == -1:
        raise ValueError("Could not find 'listData' in RDS object.")

    for col_name in cols:
        target = struct.pack('>II', 14, n_rows)  # REALSXP type 14, length n_rows
        cur = data.find(target, cur)
        if cur == -1:
            raise ValueError(f"Could not find numeric vector for column {col_name}")
        start_data = cur + 8
        end_data = start_data + n_rows * 8
        vals = struct.unpack(f'>{n_rows}d', data[start_data:end_data])
        col_dict[col_name] = vals
        cur = end_data

    df = pd.DataFrame(col_dict)
    return df, data


def main():
    # Step 1: Gene mapping from annotation CSV
    annot_path = 'data/Pseudomonas_aeruginosa_UCBPP-PA14.csv'
    df_annot = pd.read_csv(annot_path)
    mexG_annot = df_annot[df_annot['Gene Name'] == 'mexG']
    print("mexG Annotation Entry:")
    print(mexG_annot[['PGD Gene ID', 'Locus Tag', 'Gene Name', 'Product Name']])
    
    locus_tag = mexG_annot['Locus Tag'].values[0]
    print(f"\nIdentified Locus Tag for mexG: {locus_tag}")

    # Step 2: Parse DESeq2 differential expression results
    rds_path = 'data/res_1vs97.rds'
    df_res, raw_data = parse_deseq_rds(rds_path)

    # Check contrast metadata in the file
    contrast_desc_pos = raw_data.find(b'log2 fold change (MLE):')
    contrast_str = raw_data[contrast_desc_pos:contrast_desc_pos+45].decode('latin1', 'ignore')
    print(f"\nContrast metadata string: '{contrast_str}'")

    # Step 3: Query mexG expression
    mexG_res = df_res[df_res['gene_id'] == locus_tag]
    print("\nDESeq2 Results for mexG (PA14_09540):")
    print(mexG_res.to_string(index=False))

    # Verify stat consistency: stat = log2FoldChange / lfcSE
    lfc = mexG_res['log2FoldChange'].values[0]
    lfcSE = mexG_res['lfcSE'].values[0]
    stat = mexG_res['stat'].values[0]
    calc_stat = lfc / lfcSE
    print(f"\nVerification:")
    print(f"  log2FoldChange: {lfc:.8f}")
    print(f"  lfcSE:          {lfcSE:.8f}")
    print(f"  Reported stat:  {stat:.8f}")
    print(f"  Calculated stat: {calc_stat:.8f}")
    assert np.isclose(stat, calc_stat), "Stat does not match lfc / lfcSE"

    # Step 4: Round to 2 decimal places
    lfc_rounded = round(lfc, 2)
    print(f"\nFinal Result: log2 fold change rounded to 2 decimal points = {lfc_rounded:.2f}")

    return lfc_rounded


if __name__ == '__main__':
    main()
