import pandas as pd
import numpy as np

def run_pca():
    # Load dataset
    df = pd.read_csv('data/capital.csv')
    features = [
        'ZAxtSchwert', 'ZDolch', 'Zhausgr', 'ZCU_AU', 
        'Zamber', 'ZMonument', 'ZHort', 'ZSichel', 
        'ZBeil', 'ZMW', 'ZKeform', 'Zkeverz'
    ]
    feature_labels = {
        'ZAxtSchwert': 'Hatchet & Swords (Symbolic)',
        'ZDolch': 'Daggers (Symbolic)',
        'Zhausgr': 'House Size (Symbolic)',
        'ZCU_AU': 'Copper & Gold (Social)',
        'Zamber': 'Amber (Social)',
        'ZMonument': 'Monument Count (Social)',
        'ZHort': 'Depot (Economic)',
        'ZSichel': 'Sickle (Economic)',
        'ZBeil': 'Axes & Celts (Economic)',
        'ZMW': 'Monument Size (Economic)',
        'ZKeform': 'Pottery Form (Cultural)',
        'Zkeverz': 'Pottery Decoration (Cultural)'
    }

    # Convert decimal commas to floats
    for col in features:
        df[col] = df[col].astype(str).str.replace(',', '.').astype(float)

    X = df[features].values
    
    # 1. Covariance PCA (mean-centered)
    X_c = X - X.mean(axis=0)
    U, S, Vt = np.linalg.svd(X_c, full_matrices=False)
    # Standardize sign convention: Copper & Gold positive on PC1, House Size positive on PC2
    if Vt[0, 3] < 0:
        Vt[0] = -Vt[0]
    if Vt[1, 2] < 0:
        Vt[1] = -Vt[1]
    var_exp_cov = (S**2) / np.sum(S**2)

    # 2. Correlation PCA (standardized)
    X_std = (X - X.mean(axis=0)) / X.std(axis=0, ddof=1)
    U_s, S_s, Vt_s = np.linalg.svd(X_std, full_matrices=False)
    if Vt_s[0, 3] < 0:
        Vt_s[0] = -Vt_s[0]
    if Vt_s[1, 2] < 0:
        Vt_s[1] = -Vt_s[1]
    var_exp_corr = (S_s**2) / np.sum(S_s**2)

    df_results = pd.DataFrame({
        'Indicator': [feature_labels[f] for f in features],
        'Code': features,
        'PC1_loading_cov': Vt[0],
        'PC2_loading_cov': Vt[1],
        'PC1_loading_corr': Vt_s[0],
        'PC2_loading_corr': Vt_s[1]
    })

    print("=== Principal Component Analysis Results ===")
    print(f"Covariance PCA: PC1 = {var_exp_cov[0]*100:.2f}%, PC2 = {var_exp_cov[1]*100:.2f}%, Cumulative = {(var_exp_cov[0]+var_exp_cov[1])*100:.2f}%")
    print(f"Correlation PCA: PC1 = {var_exp_corr[0]*100:.2f}%, PC2 = {var_exp_corr[1]*100:.2f}%, Cumulative = {(var_exp_corr[0]+var_exp_corr[1])*100:.2f}%\n")
    print(df_results.to_string(index=False))

    return df_results, var_exp_cov, var_exp_corr

if __name__ == '__main__':
    run_pca()
