import os
import pandas as pd

def main():
    data_path = 'data/Proteomic_data .xlsx'
    sheet_name = 'Tumor vs Normal'
    
    print(f"Loading {data_path} (sheet: {sheet_name})...")
    df = pd.read_excel(data_path, sheet_name=sheet_name)
    
    # Filter for ENO1
    eno1_df = df[df['gene'].astype(str).str.upper() == 'ENO1']
    if eno1_df.empty:
        raise ValueError("ENO1 not found in dataset.")
    
    row = eno1_df.iloc[0]
    print(f"Protein ID: {row['protein']}")
    print(f"Gene: {row['gene']}")
    print(f"Gene ID: {row['gene_id']}")
    print(f"Description: {row['Description']}")
    
    normal_val = float(row['Normal'])
    tumor_val = float(row['Tumor'])
    
    print(f"Exact Normal level: {normal_val}")
    print(f"Exact Tumor level: {tumor_val}")
    
    # Round to 3 significant figures
    # In scientific notation: 7.29e7
    # In float format: 72900000
    val_3sig_sci = f"{normal_val:.3g}"
    val_3sig_float = f"{float(val_3sig_sci):.0f}"
    
    print(f"Normal level (3 significant figures, general/scientific): {val_3sig_sci}")
    print(f"Normal level (3 significant figures, integer): {val_3sig_float}")

if __name__ == '__main__':
    main()
