import pandas as pd
import numpy as np

# Load dataset
data_path = 'data/requirements_engineering_for_ML-enabled_systems.csv'
df = pd.read_csv(data_path)

# Q9 elicitation columns mapping
q9_cols = {
    'Q9_ML_Elicitation_Interviews': 'Interviews',
    'Q9_ML_Elicitation_Scenarios': 'Scenarios',
    'Q9_ML_Elicitation_Prototyping': 'Prototyping',
    'Q9_ML_Elicitation_Workshops_Meetings': 'Workshops and Meetings',
    'Q9_ML_Elicitation_Observation': 'Observation',
    'Q9_ML_Elicitation_Others': 'Others'
}

# Exclude non-response code '-77'
valid_mask = df['Q9_ML_Elicitation_Interviews'] != '-77'
valid_df = df[valid_mask].copy()

total_count = len(df)
valid_count = len(valid_df)

stats = []
for col, name in q9_cols.items():
    quoted_n = (valid_df[col] == 'quoted').sum()
    pct_valid = quoted_n / valid_count * 100.0
    pct_total = quoted_n / total_count * 100.0
    stats.append({
        'Technique': name,
        'Column': col,
        'Quoted_Count': quoted_n,
        'Valid_Percentage': round(pct_valid, 3),
        'Total_Percentage': round(pct_total, 3)
    })

stats_df = pd.DataFrame(stats).sort_values(by='Quoted_Count', ascending=False)
print("=== REQUIREMENTS ELICITATION TECHNIQUES RANKING ===")
print(stats_df.to_string(index=False))

# Subgroup analysis: Brazil (the largest respondent country cohort)
brazil_valid = valid_df[valid_df['D2_Country'] == 'Brazil']
brazil_interviews_quoted = (brazil_valid['Q9_ML_Elicitation_Interviews'] == 'quoted').sum()
brazil_total = len(brazil_valid)
brazil_pct = brazil_interviews_quoted / brazil_total * 100.0
print(f"\nBrazil cohort: {brazil_interviews_quoted}/{brazil_total} ({brazil_pct:.3f}%)")

# Bootstrap simulation
np.random.seed(42)
b_means = []
for _ in range(10000):
    sample = np.random.choice(brazil_valid['Q9_ML_Elicitation_Interviews'] == 'quoted', size=brazil_total, replace=True)
    b_means.append(np.mean(sample) * 100.0)

ci_lower = np.percentile(b_means, 2.5)
ci_upper = np.percentile(b_means, 97.5)
print(f"Bootstrap mean: {np.mean(b_means):.3f}%, 95% CI: [{ci_lower:.3f}, {ci_upper:.3f}]")

