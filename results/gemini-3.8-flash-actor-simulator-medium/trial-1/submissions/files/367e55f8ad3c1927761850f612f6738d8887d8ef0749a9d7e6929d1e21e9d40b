import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf
from statsmodels.stats.outliers_influence import variance_inflation_factor

def run_analysis():
    # 1. Load data
    df_niche = pd.read_csv("data/invaded_niche_pathways.csv", sep="\t")
    clean_cols = {c: c.replace(".", "_") for c in df_niche.columns}
    df = df_niche.rename(columns=clean_cols)
    
    df_succ = pd.read_csv("data/invasion_success_pathways.csv")
    df_temp = pd.read_csv("data/temporal_trends_contingency_table.csv", sep="\t")
    
    # 2. VIF Analysis
    candidate_vars = ["elevation", "annual_temperature", "annual_rainfall", "annual_radiation", "distance_road", "distance_stream"]
    X_test = df[candidate_vars + ["urban_2009_500m"]].assign(const=1)
    vifs = pd.Series([variance_inflation_factor(X_test.values, i) for i in range(X_test.shape[1])], index=X_test.columns)
    
    # 3. GLM Models across scales and pathways
    targets = ["n_total", "n_unint", "n_gard", "n_agfo"]
    results = {}
    
    for t in targets:
        fmla_500m = f"{t} ~ urban_2009_500m + elevation + distance_road + distance_stream + annual_rainfall"
        m_pois = smf.glm(fmla_500m, data=df, family=sm.families.Poisson()).fit()
        m_nb = smf.glm(fmla_500m, data=df, family=sm.families.NegativeBinomial(alpha=1.0)).fit()
        results[t] = {
            "poisson_urban_coef": m_pois.params["urban_2009_500m"],
            "poisson_urban_p": m_pois.pvalues["urban_2009_500m"],
            "nb_urban_coef": m_nb.params["urban_2009_500m"],
            "nb_urban_p": m_nb.pvalues["urban_2009_500m"],
            "road_coef": m_pois.params["distance_road"],
            "road_p": m_pois.pvalues["distance_road"]
        }
        
    return vifs, results

if __name__ == "__main__":
    vifs, res = run_analysis()
    print("VIFs:")
    print(vifs)
    print("\nModel Results:")
    for k, v in res.items():
        print(k, v)
