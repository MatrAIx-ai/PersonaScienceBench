import pandas as pd
import numpy as np
from scipy import stats

def run_analysis():
    df = pd.read_csv('data/nls_incarceration_processed.csv')
    jailed = df[df['ever_jailed'] == 1].copy()
    
    print(f"Total jailed respondents: {len(jailed)}")
    
    print("\n--- Racial Disparities in 1985 Wealth (ever_jailed == 1) ---")
    race_summary = jailed.groupby('race')['composite_wealth_1985'].agg(
        count='count',
        median='median',
        mean='mean',
        q25=lambda x: np.percentile(x, 25),
        q75=lambda x: np.percentile(x, 75)
    )
    print(race_summary)
    
    print("\n--- Sex Disparities in 1985 Wealth (ever_jailed == 1) ---")
    sex_summary = jailed.groupby('sex')['composite_wealth_1985'].agg(
        count='count',
        median='median',
        mean='mean',
        q25=lambda x: np.percentile(x, 25),
        q75=lambda x: np.percentile(x, 75)
    )
    print(sex_summary)
    
    print("\n--- Race x Sex Disparities in 1985 Wealth (ever_jailed == 1) ---")
    inter_summary = jailed.groupby(['race', 'sex'])['composite_wealth_1985'].agg(
        count='count',
        median='median',
        mean='mean',
        q25=lambda x: np.percentile(x, 25),
        q75=lambda x: np.percentile(x, 75)
    )
    print(inter_summary)

    # Statistical tests
    w_white = jailed[jailed['race'] == 'white']['composite_wealth_1985']
    w_black = jailed[jailed['race'] == 'black']['composite_wealth_1985']
    w_hisp = jailed[jailed['race'] == 'hipanic']['composite_wealth_1985']
    w_male = jailed[jailed['sex'] == 'male']['composite_wealth_1985']
    w_fem = jailed[jailed['sex'] == 'female']['composite_wealth_1985']

    print("\n--- Statistical Significance Tests ---")
    print("Mann-Whitney U (White vs Black):", stats.mannwhitneyu(w_white, w_black, alternative='two-sided'))
    print("Mann-Whitney U (White vs Hispanic):", stats.mannwhitneyu(w_white, w_hisp, alternative='two-sided'))
    print("Mann-Whitney U (Black vs Hispanic):", stats.mannwhitneyu(w_black, w_hisp, alternative='two-sided'))
    print("Mann-Whitney U (Male vs Female):", stats.mannwhitneyu(w_male, w_fem, alternative='two-sided'))

if __name__ == '__main__':
    run_analysis()
