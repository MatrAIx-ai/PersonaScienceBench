#!/usr/bin/env python3
"""
Analysis script for BixBench episode bix-30-q1.
Question: What percentage of miRNAs show significant differential expression
between patient and control groups before multiple testing correction?
Data: data/pone.0150501.s002.xls
"""

import sys
sys.path.append('/usr/lib/python3/dist-packages')
import struct
import numpy as np
import pandas as pd
from scipy import stats
import olefile

def load_xls_raw_data(filepath):
    """Parse BIFF8 Excel file directly using olefile."""
    ole = olefile.OleFileIO(filepath)
    wb = ole.openstream('Workbook').read()
    
    pos = 0
    sst_data = None
    records = []
    while pos < len(wb):
        rec_type, rec_len = struct.unpack_from('<HH', wb, pos)
        data = wb[pos + 4 : pos + 4 + rec_len]
        if rec_type == 0xFC:  # SST
            sst_data = data
        records.append((rec_type, data))
        pos += 4 + rec_len
    
    # Parse SST (Shared String Table)
    c_total, c_unique = struct.unpack_from('<II', sst_data, 0)
    offset = 8
    strings = []
    for _ in range(c_unique):
        cch = struct.unpack_from('<H', sst_data, offset)[0]
        flags = sst_data[offset + 2]
        offset += 3
        is_unicode = (flags & 0x01) != 0
        has_asian = (flags & 0x04) != 0
        has_rich = (flags & 0x08) != 0
        rt_runs = 0
        ext_size = 0
        if has_rich:
            rt_runs = struct.unpack_from('<H', sst_data, offset)[0]
            offset += 2
        if has_asian:
            ext_size = struct.unpack_from('<I', sst_data, offset)[0]
            offset += 4
        if is_unicode:
            s = sst_data[offset : offset + cch * 2].decode('utf-16le', errors='replace')
            offset += cch * 2
        else:
            s = sst_data[offset : offset + cch].decode('latin1', errors='replace')
            offset += cch
        if has_rich:
            offset += 4 * rt_runs
        if has_asian:
            offset += ext_size
        strings.append(s)
        
    def decode_rk(rk):
        flag_100 = (rk & 1) != 0
        flag_int = (rk & 2) != 0
        if flag_int:
            val = (rk >> 2)
            if val & 0x20000000:
                val -= 0x40000000
            val = float(val)
        else:
            b = struct.pack('<II', 0, rk & 0xFFFFFFFC)
            val = struct.unpack('<d', b)[0]
        if flag_100:
            val /= 100.0
        return val

    cells = {}
    for rt, data in records:
        if rt == 0xFD:  # LABELSST
            r, c, xf, isst = struct.unpack_from('<HHHI', data, 0)
            cells[(r, c)] = strings[isst]
        elif rt == 0x203:  # NUMBER
            r, c, xf = struct.unpack_from('<HHH', data, 0)
            val = struct.unpack_from('<d', data, 6)[0]
            cells[(r, c)] = val
        elif rt == 0x208:  # RK
            r, c, xf, rk = struct.unpack_from('<HHHI', data, 0)
            cells[(r, c)] = decode_rk(rk)

    cols = [cells.get((1, c)) for c in range(1, 21)]
    rows = []
    mirnas = []
    for r in range(2, 177):
        mirna = cells.get((r, 0))
        mirnas.append(mirna)
        row_vals = [cells.get((r, c)) for c in range(1, 21)]
        rows.append(row_vals)

    df = pd.DataFrame(rows, index=mirnas, columns=cols).replace('NAN', np.nan).astype(float)
    return df

def run_analysis():
    filepath = 'data/pone.0150501.s002.xls'
    df = load_xls_raw_data(filepath)
    print(f"Loaded dataset: {df.shape[0]} miRNAs across {df.shape[1]} samples.")
    
    p_cols = [c for c in df.columns if c.startswith('P_')]
    c_cols = [c for c in df.columns if c.startswith('C_')]
    print(f"Patient columns ({len(p_cols)}): {p_cols}")
    print(f"Control columns ({len(c_cols)}): {c_cols}")
    
    total_mirnas = len(df)
    
    # --- 1. Raw Ct values analysis ---
    res_raw = []
    for mirna, row in df.iterrows():
        p_vals = row[p_cols].dropna()
        c_vals = row[c_cols].dropna()
        t_stat, p_student = stats.ttest_ind(p_vals, c_vals, equal_var=True)
        w_stat, p_welch = stats.ttest_ind(p_vals, c_vals, equal_var=False)
        u_stat, p_mw = stats.mannwhitneyu(p_vals, c_vals)
        res_raw.append({
            'miRNA': mirna,
            'p_student': p_student,
            'p_welch': p_welch,
            'p_mw': p_mw
        })
    df_res_raw = pd.DataFrame(res_raw).set_index('miRNA')
    
    sig_raw_student = (df_res_raw['p_student'] < 0.05).sum()
    pct_raw_student = (sig_raw_student / total_mirnas) * 100
    
    sig_raw_welch = (df_res_raw['p_welch'] < 0.05).sum()
    pct_raw_welch = (sig_raw_welch / total_mirnas) * 100
    
    sig_raw_mw = (df_res_raw['p_mw'] < 0.05).sum()
    pct_raw_mw = (sig_raw_mw / total_mirnas) * 100
    
    print("\n=== Results on Raw Ct Values (before multiple testing correction, alpha = 0.05) ===")
    print(f"Two-sample Student's t-test (equal variance): {sig_raw_student}/{total_mirnas} = {pct_raw_student:.2f}% ({pct_raw_student:.4f}%)")
    print(f"Welch's t-test (unequal variance):           {sig_raw_welch}/{total_mirnas} = {pct_raw_welch:.2f}% ({pct_raw_welch:.4f}%)")
    print(f"Mann-Whitney U test:                          {sig_raw_mw}/{total_mirnas} = {pct_raw_mw:.2f}% ({pct_raw_mw:.4f}%)")
    
    # --- 2. Global Mean Normalized (Delta Ct) analysis ---
    global_mean = df.mean(axis=0)
    df_norm = df.sub(global_mean, axis=1)
    
    res_norm = []
    for mirna, row in df_norm.iterrows():
        p_vals = row[p_cols].dropna()
        c_vals = row[c_cols].dropna()
        t_stat, p_student = stats.ttest_ind(p_vals, c_vals, equal_var=True)
        w_stat, p_welch = stats.ttest_ind(p_vals, c_vals, equal_var=False)
        u_stat, p_mw = stats.mannwhitneyu(p_vals, c_vals)
        res_norm.append({
            'miRNA': mirna,
            'p_student': p_student,
            'p_welch': p_welch,
            'p_mw': p_mw
        })
    df_res_norm = pd.DataFrame(res_norm).set_index('miRNA')
    
    sig_norm_student = (df_res_norm['p_student'] < 0.05).sum()
    pct_norm_student = (sig_norm_student / total_mirnas) * 100
    
    sig_norm_welch = (df_res_norm['p_welch'] < 0.05).sum()
    pct_norm_welch = (sig_norm_welch / total_mirnas) * 100
    
    sig_norm_mw = (df_res_norm['p_mw'] < 0.05).sum()
    pct_norm_mw = (sig_norm_mw / total_mirnas) * 100
    
    print("\n=== Results on Global Mean Normalized Values (Delta Ct, alpha = 0.05) ===")
    print(f"Two-sample Student's t-test (equal variance): {sig_norm_student}/{total_mirnas} = {pct_norm_student:.2f}% ({pct_norm_student:.4f}%)")
    print(f"Welch's t-test (unequal variance):           {sig_norm_welch}/{total_mirnas} = {pct_norm_welch:.2f}% ({pct_norm_welch:.4f}%)")
    print(f"Mann-Whitney U test:                          {sig_norm_mw}/{total_mirnas} = {pct_norm_mw:.2f}% ({pct_norm_mw:.4f}%)")

if __name__ == '__main__':
    run_analysis()
