#!/usr/bin/env python3
"""
Analysis of BCG Vaccination on COVID-19 Severity using Ordinal Logistic Regression
Study: TASK008-BCG CORONA Clinical Trial
"""

import os
import sys
import numpy as np
import pandas as pd
import statsmodels.api as sm
from statsmodels.miscmodels.ordinal_model import OrderedModel

def run_analysis():
    print("=" * 80)
    print("BCG VACCINATION ON COVID-19 SEVERITY ORDINAL REGRESSION ANALYSIS")
    print("=" * 80)

    # 1. Load Data
    dm_path = "data/TASK008_BCG-CORONA_DM.csv"
    ae_path = "data/TASK008_BCG-CORONA_AE.csv"
    mh_path = "data/TASK008_BCG-CORONA_MH.csv"

    print(f"Loading data from:\n  - {dm_path}\n  - {ae_path}\n  - {mh_path}")
    dm = pd.read_csv(dm_path)
    ae = pd.read_csv(ae_path)
    mh = pd.read_csv(mh_path)

    # 2. Derive Prior Medical History Count
    # In CDISC MH table, MHSCAT == 'MEDICAL HISTORY' contains pre-existing medical conditions.
    # MHORRES == 2.0 indicates 'Yes' (condition present).
    mh_med = mh[(mh['MHSCAT'] == 'MEDICAL HISTORY') & (mh['MHORRES'] == 2.0)]
    mh_count = mh_med.groupby('USUBJID').size().rename('mh_count')

    # 3. Derive COVID-19 Events and Severity
    # Identify COVID-19 related terms in AE table
    covid_mask = ae['AEPT'].str.lower().str.contains('covid|sars|corona', na=False)
    covid_ae = ae[covid_mask].copy()

    # Patient-level maximum severity on AEHS (WHO 0-7 ordinal scale) and AESEV (1-4 CTCAE scale)
    covid_max_hs = covid_ae.groupby('USUBJID')['AEHS'].max().rename('max_aehs')
    covid_max_sev = covid_ae.groupby('USUBJID')['AESEV'].max().rename('max_aesev')

    # 4. Assemble Analytic Dataset
    df = dm.copy()
    df = df.merge(mh_count, on='USUBJID', how='left')
    df['mh_count'] = df['mh_count'].fillna(0).astype(int)

    df = df.merge(covid_max_hs, on='USUBJID', how='left')
    df = df.merge(covid_max_sev, on='USUBJID', how='left')

    # Primary outcome across full cohort (N=1000): Uninfected = 0
    df['sev_hs_all'] = df['max_aehs'].fillna(0).astype(int)
    df['sev_aesev_all'] = df['max_aesev'].fillna(0).astype(int)

    # Treatment indicator: BCG = 1, Placebo = 0
    df['bcg'] = (df['TRTGRP'] == 'BCG').astype(int)

    # Patient interaction frequency: categorical factor and numeric score (1, 2, 3)
    pif_map = {'1-50': 1, '51-100': 2, '>100': 3}
    df['patients_seen_num'] = df['patients_seen'].map(pif_map)

    print(f"\nCohort Overview:")
    print(f"Total Participants: {len(df)}")
    print(f"  - BCG Arm: {(df['TRTGRP'] == 'BCG').sum()}")
    print(f"  - Placebo Arm: {(df['TRTGRP'] == 'Placebo').sum()}")
    print(f"COVID-19 Cases Identified: {covid_ae['USUBJID'].nunique()}")
    print(f"Prior Medical History Count Distribution (0-7):")
    print(df['mh_count'].value_counts().sort_index().to_dict())
    print(f"Patients Seen Distribution:")
    print(df['patients_seen'].value_counts().to_dict())
    print(f"AEHS Severity Distribution (Full Cohort):")
    print(df['sev_hs_all'].value_counts().sort_index().to_dict())

    results_summary = []

    def fit_and_report(model_name, formula, data, target_param='bcg'):
        print("\n" + "-" * 70)
        print(f"MODEL: {model_name}")
        print(f"Formula: {formula}")
        print(f"Observations: {len(data)}")
        mod = OrderedModel.from_formula(formula, data, distr='logit')
        res = mod.fit(method='bfgs', maxiter=2000, disp=False)
        
        coef = res.params[target_param]
        se = res.bse[target_param]
        z = res.tvalues[target_param]
        pval = res.pvalues[target_param]
        ci_low = np.exp(coef - 1.96 * se)
        ci_high = np.exp(coef + 1.96 * se)
        odds_ratio = np.exp(coef)

        print(f"BCG Coef: {coef:.4f} (SE: {se:.4f}, z: {z:.4f}, p: {pval:.4f})")
        print(f"BCG Odds Ratio: {odds_ratio:.4f} (95% CI: [{ci_low:.4f}, {ci_high:.4f}])")
        print(f"Log-Likelihood: {res.llf:.2f}, AIC: {res.aic:.2f}")

        results_summary.append({
            'Model': model_name,
            'Formula': formula,
            'Cohort': f"N={len(data)}",
            'BCG_Coef': coef,
            'BCG_SE': se,
            'p_value': pval,
            'Odds_Ratio': odds_ratio,
            'CI_Lower': ci_low,
            'CI_Upper': ci_high
        })
        return res

    # ---------------------------------------------------------
    # 5. PRIMARY ANALYSES (Full Cohort N=1,000, Outcome: AEHS 0-7)
    # ---------------------------------------------------------
    # Model 1A: Primary - Categorical PIF with Covariate Interaction (mh_count * patients_seen)
    f1a = 'sev_hs_all ~ bcg + mh_count * C(patients_seen, Treatment(reference="1-50"))'
    res1a = fit_and_report("Primary Model 1A (Categorical PIF, Covariate Interaction)", f1a, df)

    # Model 1B: Primary - Numeric PIF with Covariate Interaction (mh_count * patients_seen_num)
    f1b = 'sev_hs_all ~ bcg + mh_count * patients_seen_num'
    res1b = fit_and_report("Primary Model 1B (Numeric PIF, Covariate Interaction)", f1b, df)

    # Model 2A: Full Two-Way Interactions (Categorical PIF)
    f2a = 'sev_hs_all ~ (bcg + mh_count + C(patients_seen, Treatment(reference="1-50")) )**2'
    res2a = fit_and_report("Model 2A (Categorical PIF, All Two-Way Interactions)", f2a, df)

    # Model 2B: Full Two-Way Interactions (Numeric PIF)
    f2b = 'sev_hs_all ~ (bcg + mh_count + patients_seen_num)**2'
    res2b = fit_and_report("Model 2B (Numeric PIF, All Two-Way Interactions)", f2b, df)

    # ---------------------------------------------------------
    # 6. SENSITIVITY ANALYSES
    # ---------------------------------------------------------
    # Sensitivity 1: COVID-19 Positive Cohort Only (N=197), AEHS (0-7)
    covid_df = df[df['max_aehs'].notna()].copy()
    f_sens1_cat = 'max_aehs ~ bcg + mh_count * C(patients_seen, Treatment(reference="1-50"))'
    res_s1_cat = fit_and_report("Sensitivity 1A (COVID+ Cohort N=197, AEHS, Categorical PIF)", f_sens1_cat, covid_df)

    f_sens1_num = 'max_aehs ~ bcg + mh_count * patients_seen_num'
    res_s1_num = fit_and_report("Sensitivity 1B (COVID+ Cohort N=197, AEHS, Numeric PIF)", f_sens1_num, covid_df)

    # Sensitivity 2: AESEV Outcome on Full Cohort (N=1,000, 0-4)
    f_sens2_cat = 'sev_aesev_all ~ bcg + mh_count * C(patients_seen, Treatment(reference="1-50"))'
    res_s2_cat = fit_and_report("Sensitivity 2A (Full Cohort N=1000, AESEV 0-4, Categorical PIF)", f_sens2_cat, df)

    f_sens2_num = 'sev_aesev_all ~ bcg + mh_count * patients_seen_num'
    res_s2_num = fit_and_report("Sensitivity 2B (Full Cohort N=1000, AESEV 0-4, Numeric PIF)", f_sens2_num, df)

    # Sensitivity 3: AESEV Outcome on COVID+ Cohort with non-missing AESEV (N=153)
    covid_aesev_df = df[df['max_aesev'].notna()].copy()
    f_sens3_cat = 'max_aesev ~ bcg + mh_count * C(patients_seen, Treatment(reference="1-50"))'
    res_s3_cat = fit_and_report("Sensitivity 3A (COVID+ N=153, AESEV 1-4, Categorical PIF)", f_sens3_cat, covid_aesev_df)

    # ---------------------------------------------------------
    # 7. Summary Table
    # ---------------------------------------------------------
    summary_df = pd.DataFrame(results_summary)
    summary_csv = "ordinal_regression_results.csv"
    summary_df.to_csv(summary_csv, index=False)
    print("\n" + "=" * 80)
    print("SUMMARY OF ALL MODEL SPECIFICATIONS")
    print("=" * 80)
    print(summary_df[['Model', 'Cohort', 'Odds_Ratio', 'CI_Lower', 'CI_Upper', 'p_value']].to_string(index=False))
    print(f"\nResults successfully exported to {summary_csv}")

if __name__ == "__main__":
    run_analysis()
