"""
Analysis of male author proportions across domains in original and replication studies.
Benchmark: DiscoveryBench
Question: In which domain do the majority of authors tend to be male for both original and replication studies?
"""

import pandas as pd
import numpy as np
from scipy import stats

def main():
    df = pd.read_csv('data/meta-regression_study_data_heterogeneity_in_replication_projects.csv')
    
    print(f"Total dataset shape: {df.shape}")
    print(f"Number of unique study IDs: {df['id'].nunique()}")
    print("\nDrop column distribution:")
    print(df['drop'].value_counts(dropna=False))
    
    subsets = {
        "All rows (N=927)": df,
        "Non-dropped rows (drop == False, N=809)": df[df['drop'] == False],
        "Unique studies (all, N=141)": df.drop_duplicates(subset=['id']),
        "Unique studies (non-dropped, drop == False, N=127)": df[df['drop'] == False].drop_duplicates(subset=['id'])
    }
    
    for name, data in subsets.items():
        print(f"\n==================== {name} ====================")
        summary = data.groupby('discipline').agg(
            n_obs=('id', 'count'),
            n_unique=('id', 'nunique'),
            mean_male_o=('authors_male.o', 'mean'),
            median_male_o=('authors_male.o', 'median'),
            mean_male_r=('authors_male.r', 'mean'),
            median_male_r=('authors_male.r', 'median'),
            pct_o_gt_50=('authors_male.o', lambda s: (s > 0.5).mean() * 100),
            pct_r_gt_50=('authors_male.r', lambda s: (s > 0.5).mean() * 100),
            pct_both_gt_50=('authors_male.o', lambda s: ((s > 0.5) & (data.loc[s.index, 'authors_male.r'] > 0.5)).mean() * 100)
        )
        print(summary.round(3).to_string())
    
    # Statistical tests on unique studies
    df_u = df.drop_duplicates(subset=['id'])
    econ_r = df_u[df_u['discipline'] == 'Economics']['authors_male.r']
    cog_r = df_u[df_u['discipline'] == 'Cognitive']['authors_male.r']
    soc_r = df_u[df_u['discipline'] == 'Social']['authors_male.r']
    
    econ_o = df_u[df_u['discipline'] == 'Economics']['authors_male.o']
    cog_o = df_u[df_u['discipline'] == 'Cognitive']['authors_male.o']
    soc_o = df_u[df_u['discipline'] == 'Social']['authors_male.o']
    
    print("\n==================== Statistical Significance Tests (Mann-Whitney U) ====================")
    print(f"Replication (authors_male.r) - Economics vs Cognitive: U={stats.mannwhitneyu(econ_r, cog_r).statistic}, p={stats.mannwhitneyu(econ_r, cog_r).pvalue:.5f}")
    print(f"Replication (authors_male.r) - Economics vs Social: U={stats.mannwhitneyu(econ_r, soc_r).statistic}, p={stats.mannwhitneyu(econ_r, soc_r).pvalue:.5f}")
    print(f"Original (authors_male.o) - Economics vs Cognitive: U={stats.mannwhitneyu(econ_o, cog_o).statistic}, p={stats.mannwhitneyu(econ_o, cog_o).pvalue:.5f}")
    print(f"Original (authors_male.o) - Economics vs Social: U={stats.mannwhitneyu(econ_o, soc_o).statistic}, p={stats.mannwhitneyu(econ_o, soc_o).pvalue:.5f}")

if __name__ == '__main__':
    main()
