#!/usr/bin/env python3
"""
Analysis of gene expression (log2(TPM+1)) distribution skewness across all cell lines.
Dataset: data/OmicsExpressionProteinCodingGenesTPMLogp1BatchCorrected.csv
"""

import os
import json
import numpy as np
import pandas as pd
from scipy import stats

def run_analysis():
    data_path = "data/OmicsExpressionProteinCodingGenesTPMLogp1BatchCorrected.csv"
    print(f"Loading data from {data_path}...")
    df = pd.read_csv(data_path, index_col=0)
    
    n_cell_lines, n_genes = df.shape
    total_data_points = n_cell_lines * n_genes
    print(f"Dimensions: {n_cell_lines} cell lines x {n_genes} genes ({total_data_points} values)")
    
    # 1. Global flattened expression distribution
    vals = df.values.flatten()
    global_mean = float(np.mean(vals))
    global_median = float(np.median(vals))
    global_std = float(np.std(vals))
    global_min = float(np.min(vals))
    global_max = float(np.max(vals))
    global_skew = float(stats.skew(vals, bias=False))
    global_kurt = float(stats.kurtosis(vals, bias=False))
    
    # Quantiles
    quantiles = [0.01, 0.05, 0.1, 0.25, 0.5, 0.75, 0.9, 0.95, 0.99]
    quant_vals = {f"p{int(q*100)}": float(np.percentile(vals, q*100)) for q in quantiles}
    
    # 2. Per-cell-line expression skewness (across genes for each cell line)
    cell_line_skews = stats.skew(df.values, axis=1, bias=False)
    cell_line_summary = {
        "mean": float(np.mean(cell_line_skews)),
        "std": float(np.std(cell_line_skews)),
        "median": float(np.median(cell_line_skews)),
        "min": float(np.min(cell_line_skews)),
        "max": float(np.max(cell_line_skews)),
        "q25": float(np.percentile(cell_line_skews, 25)),
        "q75": float(np.percentile(cell_line_skews, 75)),
        "fraction_positive": float(np.mean(cell_line_skews > 0))
    }
    
    # 3. Per-gene expression skewness (across cell lines for each gene)
    gene_skews = stats.skew(df.values, axis=0, bias=False)
    gene_summary = {
        "mean": float(np.mean(gene_skews)),
        "std": float(np.std(gene_skews)),
        "median": float(np.median(gene_skews)),
        "min": float(np.min(gene_skews)),
        "max": float(np.max(gene_skews)),
        "q25": float(np.percentile(gene_skews, 25)),
        "q75": float(np.percentile(gene_skews, 75)),
        "fraction_positive": float(np.mean(gene_skews > 0))
    }
    
    results = {
        "n_cell_lines": n_cell_lines,
        "n_genes": n_genes,
        "total_data_points": total_data_points,
        "global_distribution": {
            "mean": global_mean,
            "median": global_median,
            "std": global_std,
            "min": global_min,
            "max": global_max,
            "skewness": global_skew,
            "kurtosis": global_kurt,
            "quantiles": quant_vals
        },
        "per_cell_line_skewness": cell_line_summary,
        "per_gene_skewness": gene_summary
    }
    
    print("\n--- Summary Results ---")
    print(f"Global Skewness: {global_skew:.4f} (Positive / Right-skewed)")
    print(f"Global Mean: {global_mean:.4f}, Median: {global_median:.4f}")
    print(f"Per-cell-line Skewness: Mean={cell_line_summary['mean']:.4f}, Median={cell_line_summary['median']:.4f}, Range=[{cell_line_summary['min']:.4f}, {cell_line_summary['max']:.4f}]")
    print(f"Fraction of cell lines with positive skewness: {cell_line_summary['fraction_positive']*100:.1f}%")
    print(f"Per-gene Skewness: Mean={gene_summary['mean']:.4f}, Median={gene_summary['median']:.4f}, Range=[{gene_summary['min']:.4f}, {gene_summary['max']:.4f}]")
    
    with open("results.json", "w") as f:
        json.dump(results, f, indent=2)
    print("\nResults successfully saved to results.json")
    return results

if __name__ == "__main__":
    run_analysis()
