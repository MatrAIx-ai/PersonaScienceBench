def main():
    print("Loading data...")
    with open('data/task_info.json', 'r') as f:
        task_info = json.load(f)

    poses_init = np.load('data/poses_initial.npy')
    odom_df = pd.read_csv('data/odometry_edges.csv')
    loops_df = pd.read_csv('data/loop_candidates.csv')

    num_poses = int(task_info['num_poses'])
    assert len(poses_init) == num_poses, f"Pose count mismatch: {len(poses_init)} vs {num_poses}"

    odom_edges = [
        (int(r['edge_id']), int(r['from']), int(r['to']),
         float(r['dx']), float(r['dy']), float(r['dtheta']),
         float(r['sigma_trans']), float(r['sigma_rot']))
        for _, r in odom_df.iterrows()
    ]
    loop_edges = [
        (int(r['loop_id']), int(r['from']), int(r['to']),
         float(r['dx']), float(r['dy']), float(r['dtheta']),
         float(r['sigma_trans']), float(r['sigma_rot']))
        for _, r in loops_df.iterrows()
    ]
    num_loops = len(loop_edges)
    dim = (num_poses - 1) * 3

    def compute_residuals_and_jacobians(poses, loop_weights):
        rows, cols, vals = [], [], []
        b = np.zeros(dim)
        total_cost = 0.0
        odom_chi2 = 0.0
        loop_chi2s = np.zeros(num_loops)

        for eid, i, j, dx, dy, dth, sig_t, sig_r in odom_edges:
            Ti, Tj = poses[i], poses[j]
            c, s = np.cos(Ti[2]), np.sin(Ti[2])
            R_T = np.array([[c, s], [-s, c]])
            dp = np.array([Tj[0] - Ti[0], Tj[1] - Ti[1]])
            p_err = R_T @ dp - np.array([dx, dy])
            th_err = wrap_angle(Tj[2] - Ti[2] - dth)
            e = np.array([p_err[0], p_err[1], th_err])

            cov_inv = np.diag([1.0 / (sig_t**2), 1.0 / (sig_t**2), 1.0 / (sig_r**2)])
            chi2 = float(e.T @ cov_inv @ e)
            odom_chi2 += chi2
            total_cost += 0.5 * chi2

            Ji = np.array([[-c, -s, -s * dp[0] + c * dp[1]], [s, -c, -c * dp[0] - s * dp[1]], [0.0, 0.0, -1.0]])
            Jj = np.array([[c, s, 0.0], [-s, c, 0.0], [0.0, 0.0, 1.0]])

            for node_u, Ju in [(i, Ji), (j, Jj)]:
                if node_u > 0:
                    idx_u = (node_u - 1) * 3
                    b[idx_u:idx_u+3] += Ju.T @ cov_inv @ e
                    for node_v, Jv in [(i, Ji), (j, Jj)]:
                        if node_v > 0:
                            idx_v = (node_v - 1) * 3
                            block = Ju.T @ cov_inv @ Jv
                            for r_k in range(3):
                                for c_k in range(3):
                                    rows.append(idx_u + r_k)
                                    cols.append(idx_v + c_k)
                                    vals.append(block[r_k, c_k])

        for idx, (lid, i, j, dx, dy, dth, sig_t, sig_r) in enumerate(loop_edges):
            w = loop_weights[idx]
            Ti, Tj = poses[i], poses[j]
            c, s = np.cos(Ti[2]), np.sin(Ti[2])
            R_T = np.array([[c, s], [-s, c]])
            dp = np.array([Tj[0] - Ti[0], Tj[1] - Ti[1]])
            p_err = R_T @ dp - np.array([dx, dy])
            th_err = wrap_angle(Tj[2] - Ti[2] - dth)
            e = np.array([p_err[0], p_err[1], th_err])

            cov_inv = np.diag([1.0 / (sig_t**2), 1.0 / (sig_t**2), 1.0 / (sig_r**2)])
            chi2 = float(e.T @ cov_inv @ e)
            loop_chi2s[idx] = chi2
            eff_cov_inv = w * cov_inv
            total_cost += 0.5 * w * chi2

            Ji = np.array([[-c, -s, -s * dp[0] + c * dp[1]], [s, -c, -c * dp[0] - s * dp[1]], [0.0, 0.0, -1.0]])
            Jj = np.array([[c, s, 0.0], [-s, c, 0.0], [0.0, 0.0, 1.0]])

            for node_u, Ju in [(i, Ji), (j, Jj)]:
                if node_u > 0:
                    idx_u = (node_u - 1) * 3
                    b[idx_u:idx_u+3] += Ju.T @ eff_cov_inv @ e
                    for node_v, Jv in [(i, Ji), (j, Jj)]:
                        if node_v > 0:
                            idx_v = (node_v - 1) * 3
                            block = Ju.T @ eff_cov_inv @ Jv
                            for r_k in range(3):
                                for c_k in range(3):
                                    rows.append(idx_u + r_k)
                                    cols.append(idx_v + c_k)
                                    vals.append(block[r_k, c_k])

        H = sp.coo_matrix((vals, (rows, cols)), shape=(dim, dim)).tocsc()
        return H, b, total_cost, odom_chi2, loop_chi2s

    print("Evaluating initial trajectory...")
    _, _, init_cost, init_odom_chi2, init_loop_chi2s = compute_residuals_and_jacobians(poses_init, np.ones(num_loops))

    print("Stage 1: Robust Pose Graph Optimization with Dynamic Covariance Scaling (DCS)...")
    poses = poses_init.copy()
    c2 = 11.345
    weights = np.ones(num_loops)
    max_dcs_iters = 35

    for it in range(max_dcs_iters):
        H, b, cost, odom_chi2, loop_chi2s = compute_residuals_and_jacobians(poses, weights)
        H_damped = H + 1e-4 * sp.eye(dim, format='csc')
        dx = spla.spsolve(H_damped, -b)

        for k in range(1, num_poses):
            idx = (k - 1) * 3
            poses[k, 0] += dx[idx]
            poses[k, 1] += dx[idx + 1]
            poses[k, 2] = wrap_angle(poses[k, 2] + dx[idx + 2])

        for k in range(num_loops):
            chi2 = loop_chi2s[k]
            weights[k] = 1.0 if chi2 <= c2 else (2.0 * c2 / (c2 + chi2))**2

        if it % 5 == 0 or it == max_dcs_iters - 1:
            print(f"  Iter {it:2d}: Cost = {cost:10.2f}, Inliers = {(weights > 0.5).sum():2d}")

    inlier_mask = (loop_chi2s < 25.0)
    num_inliers = int(inlier_mask.sum())
    num_outliers = int((~inlier_mask).sum())
    print(f"Stage 1 converged: {num_inliers} verified inliers, {num_outliers} rejected outliers.")

    print("Stage 2: Final trajectory polishing on verified inlier constraints...")
    final_weights = np.where(inlier_mask, 1.0, 0.0)
    actual_polish_iters = 0
    for it in range(15):
        actual_polish_iters = it + 1
        H, b, cost, odom_chi2, loop_chi2s = compute_residuals_and_jacobians(poses, final_weights)
        dx = spla.spsolve(H, -b)
        for k in range(1, num_poses):
            idx = (k - 1) * 3
            poses[k, 0] += dx[idx]
            poses[k, 1] += dx[idx + 1]
            poses[k, 2] = wrap_angle(poses[k, 2] + dx[idx + 2])
        dx_norm = float(np.linalg.norm(dx))
        if dx_norm < 1e-7:
            print(f"  Polishing converged at iter {it} with dx_norm = {dx_norm:.2e}")
            break

    H, b, final_cost, final_odom_chi2, final_loop_chi2s = compute_residuals_and_jacobians(poses, final_weights)
    inlier_chi2s = final_loop_chi2s[inlier_mask]
    outlier_chi2s = final_loop_chi2s[~inlier_mask]
    inlier_chi2_sum = float(inlier_chi2s.sum())
    chi2_per_dof = (final_odom_chi2 + inlier_chi2_sum) / float(num_inliers * 3)
    disp = np.linalg.norm(poses[:, :2] - poses_init[:, :2], axis=1)

    print(f"Final cost: {final_cost:.4f}, Chi2/DoF: {chi2_per_dof:.4f}")
    print(f"Inlier max chi2: {inlier_chi2s.max():.4f}, Outlier min chi2: {outlier_chi2s.min():.4f}")

    # Save deliverables
    np.save('poses.npy', poses)
    print("Saved poses.npy")

    false_probs = []
    for k in range(num_loops):
        chi2 = float(final_loop_chi2s[k])
        if inlier_mask[k]:
            fp = float(1.0 / (1.0 + np.exp(-(chi2 - 11.345) / 2.0)))
            fp = max(0.0, min(0.05, fp))
        else:
            fp = 1.0
        false_probs.append(round(fp, 6))

    scores_df = pd.DataFrame({
        'loop_id': [loop_edges[k][0] for k in range(num_loops)],
        'false_probability': false_probs
    })
    scores_df.to_csv('loop_closure_scores.csv', index=False)
    print("Saved loop_closure_scores.csv")

    metrics = {
        'num_poses': num_poses,
        'num_odometry_edges': len(odom_edges),
        'num_loop_candidates': num_loops,
        'num_inlier_loops': num_inliers,
