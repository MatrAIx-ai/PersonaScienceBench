def wrap_angle(theta):
    return (theta + np.pi) % (2.0 * np.pi) - np.pi

def write_png(filename, img):
    H, W, _ = img.shape
    raw = b''.join(b'\x00' + img[r].tobytes() for r in range(H))
    compressed = zlib.compress(raw, level=6)
    def chunk(tag, data):
        return struct.pack('>I', len(data)) + tag + data + struct.pack('>I', zlib.crc32(tag + data))
    ihdr = struct.pack('>IIBBBBB', W, H, 8, 2, 0, 0, 0)
    with open(filename, 'wb') as f:
        f.write(b'\x89PNG\r\n\x1a\n')
        f.write(chunk(b'IHDR', ihdr))
        f.write(chunk(b'IDAT', compressed))
        f.write(chunk(b'IEND', b''))

def draw_text(canvas, text, x0, y0, color, scale=2):
    H, W, _ = canvas.shape
    curr_x = x0
    for char in text.upper():
        cols = FONT_5X7.get(char, FONT_5X7[' '])
        for col_idx, col_bits in enumerate(cols):
            for row_idx in range(7):
                if (col_bits >> row_idx) & 1:
                    px = curr_x + col_idx * scale
                    py = y0 + row_idx * scale
                    for sx in range(scale):
                        for sy in range(scale):
                            if 0 <= px + sx < W and 0 <= py + sy < H:
                                canvas[py + sy, px + sx] = color
        curr_x += (len(cols) + 1) * scale

def draw_line(canvas, x0, y0, x1, y1, color, thickness=1, dashed=False, dash_len=8):
    H, W, _ = canvas.shape
    steps = max(abs(x1 - x0), abs(y1 - y0))
    if steps == 0:
        if 0 <= x0 < W and 0 <= y0 < H: canvas[y0, x0] = color
        return
    xs, ys = np.linspace(x0, x1, steps * 2 + 1), np.linspace(y0, y1, steps * 2 + 1)
    for idx, (x, y) in enumerate(zip(xs, ys)):
        if dashed and ((idx // dash_len) % 2 == 1): continue
        ix, iy = int(round(x)), int(round(y))
        for ox in range(-thickness//2, thickness//2 + 1):
            for oy in range(-thickness//2, thickness//2 + 1):
                px, py = ix + ox, iy + oy
                if 0 <= px < W and 0 <= py < H: canvas[py, px] = color

def draw_circle(canvas, cx, cy, radius, color, fill=True):
    H, W, _ = canvas.shape
    r2, r_in2 = radius * radius, (radius - 1.5)**2
    for y in range(max(0, cy - radius), min(H, cy + radius + 1)):
        for x in range(max(0, cx - radius), min(W, cx + radius + 1)):
            d2 = (x - cx)**2 + (y - cy)**2
            if fill and d2 <= r2: canvas[y, x] = color
            elif not fill and r_in2 <= d2 <= r2: canvas[y, x] = color

