        'inlier_loop_chi2_mean': float(inlier_chi2s.mean()),
        'outlier_loop_chi2_min': float(outlier_chi2s.min()),
        'outlier_loop_chi2_mean': float(outlier_chi2s.mean()),
        'mean_trajectory_displacement_m': float(disp.mean()),
        'max_trajectory_displacement_m': float(disp.max()),
        'convergence_iterations_dcs': max_dcs_iters,
        'convergence_iterations_polish': actual_polish_iters,
        'anchor_pose_0': poses[0].tolist()
    }
    with open('metrics.json', 'w') as f:
        json.dump(metrics, f, indent=2)
    print("Saved metrics.json")

    render_diagnostics('map_diagnostics.png', poses_init, poses, loop_edges, inlier_mask)
