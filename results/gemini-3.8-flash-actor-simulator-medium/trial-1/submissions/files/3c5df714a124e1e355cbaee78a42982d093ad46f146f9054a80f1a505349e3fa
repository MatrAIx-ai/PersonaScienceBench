import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf

def run_analysis():
    df = pd.read_csv('data/nls_bmi_processed.csv')
    df['FEMALE'] = (df['GENDER'] == 'FEMALE').astype(int)
    df['INCOME_IMPUTED'] = (df['INCOME'] == df['INCOME'].iloc[0]).astype(int)
    df['BMI_IMPUTED'] = (np.isclose(df['BMI'], 25.158946)).astype(int)
    df['LOG_INCOME'] = np.log(df['INCOME'] + 1)

    print("=== 1. Descriptive stats ===")
    print("DISSAVED by AGE:")
    age_grp = df.groupby('AGE')['DISSAVED'].agg(['count', 'mean', 'sum'])
    print(age_grp)

    print("\n=== 2. Logit Models ===")
    m1 = smf.logit('DISSAVED ~ AGE', data=df).fit(disp=False)
    m2 = smf.logit('DISSAVED ~ AGE + AGE_2', data=df).fit(disp=False)
    m3 = smf.logit('DISSAVED ~ AGE + FEMALE + INCOME + BMI + BLACK + HISPANIC', data=df).fit(disp=False)
    m4 = smf.logit('DISSAVED ~ AGE + AGE_2 + FEMALE + INCOME + BMI + BLACK + HISPANIC', data=df).fit(disp=False)

    print("Model 1 (Logit - AGE):")
    print(m1.summary().tables[1])
    print("AME M1:\n", m1.get_margeff().summary())

    print("\nModel 2 (Logit - AGE + AGE_2):")
    print(m2.summary().tables[1])

    print("\nModel 3 (Logit - AGE + Controls):")
    print(m3.summary().tables[1])
    print("AME M3:\n", m3.get_margeff().summary())

    print("\nModel 4 (Logit - AGE + AGE_2 + Controls):")
    print(m4.summary().tables[1])

    print("\n=== 3. Linear Probability Models (LPM / OLS with HC1) ===")
    ols1 = smf.ols('DISSAVED ~ AGE', data=df).fit(cov_type='HC1')
    ols3 = smf.ols('DISSAVED ~ AGE + FEMALE + INCOME + BMI + BLACK + HISPANIC', data=df).fit(cov_type='HC1')
    print("OLS 1 (HC1):")
    print(ols1.summary().tables[1])
    print("OLS 3 (HC1):")
    print(ols3.summary().tables[1])

    print("\n=== 4. Odds Ratios (Model 3) ===")
    params = m3.params
    conf = m3.conf_int()
    conf['OR'] = params
    conf.columns = ['2.5%', '97.5%', 'OR']
    print(np.exp(conf))

    print("\n=== 5. Robustness: Log Income & Complete Cases ===")
    m_log = smf.logit('DISSAVED ~ AGE + FEMALE + LOG_INCOME + BMI + BLACK + HISPANIC', data=df).fit(disp=False)
    print("Log income Logit:\n", m_log.summary().tables[1])

    df_cc = df[(df['INCOME_IMPUTED'] == 0) & (df['BMI_IMPUTED'] == 0)]
    m_cc = smf.logit('DISSAVED ~ AGE + FEMALE + INCOME + BMI + BLACK + HISPANIC', data=df_cc).fit(disp=False)
    print("Complete cases (N={}):\n".format(len(df_cc)), m_cc.summary().tables[1])

if __name__ == '__main__':
    run_analysis()
