import os
import glob
import pandas as pd
import numpy as np

def main():
    sample_files = sorted(glob.glob("data/CHIP_DP10_GQ20_PASS/*.xlsx"))
    print(f"Total sample files found: {len(sample_files)}")

    # Terms to filter out: intronic, intergenic, and UTR variants
    excluded_terms = {
        'intron_variant',
        '3_prime_UTR_variant',
        '5_prime_UTR_variant',
        '5_prime_UTR_premature_start_codon_gain_variant',
        'upstream_gene_variant'
    }

    results = []

    for f in sample_files:
        sample_id = os.path.basename(f).replace("230209_Exome_GRCh38_CHIP_", "").replace(".xlsx", "")
        df = pd.read_excel(f, header=1)

        # Total rows in file
        total_rows = len(df)
        
        # Non-reference variants (Heterozygous or Homozygous Variant)
        non_ref_mask = df['Zygosity'].isin(['Heterozygous', 'Homozygous Variant'])
        total_non_ref = non_ref_mask.sum()

        # Filtering condition: remove intronic, intergenic, and UTR
        filtered_mask = ~df['Sequence Ontology (Combined)'].isin(excluded_terms)
        
        # Count 1: non-reference filtered variants
        filtered_non_ref_count = (filtered_mask & non_ref_mask).sum()

        # Count 2: all rows filtered (regardless of zygosity)
        filtered_all_rows_count = filtered_mask.sum()

        results.append({
            'sample_id': sample_id,
            'total_rows': total_rows,
            'total_non_ref': total_non_ref,
            'filtered_non_ref': filtered_non_ref_count,
            'filtered_all_rows': filtered_all_rows_count
        })

    res_df = pd.DataFrame(results)
    
    print("\n--- Summary Statistics across 86 samples ---")
    print("Non-reference CHIP variants after filtering:")
    print(f"  Mean: {res_df['filtered_non_ref'].mean():.4f}")
    print(f"  Median: {res_df['filtered_non_ref'].median()}")
    print(f"  Min: {res_df['filtered_non_ref'].min()}")
    print(f"  Max: {res_df['filtered_non_ref'].max()}")
    print(f"  Std: {res_df['filtered_non_ref'].std():.4f}")

    print("\nAll rows after filtering (regardless of Zygosity):")
    print(f"  Mean: {res_df['filtered_all_rows'].mean():.4f}")
    print(f"  Median: {res_df['filtered_all_rows'].median()}")
    print(f"  Min: {res_df['filtered_all_rows'].min()}")
    print(f"  Max: {res_df['filtered_all_rows'].max()}")
    print(f"  Std: {res_df['filtered_all_rows'].std():.4f}")

    print("\nBefore filtering (Total non-reference):")
    print(f"  Mean: {res_df['total_non_ref'].mean():.4f}")

    print("\nBefore filtering (Total rows):")
    print(f"  Mean: {res_df['total_rows'].mean():.4f}")

    # Breakdown of retained Sequence Ontology terms for non-reference
    print("\nRetained Sequence Ontology terms (mean non-ref counts):")
    so_counts = {}
    for f in sample_files:
        df = pd.read_excel(f, header=1)
        nr = df[df['Zygosity'].isin(['Heterozygous', 'Homozygous Variant'])]
        kept = nr[~nr['Sequence Ontology (Combined)'].isin(excluded_terms)]
        for term, count in kept['Sequence Ontology (Combined)'].value_counts().items():
            so_counts[term] = so_counts.get(term, 0) + count

    for term, total_c in sorted(so_counts.items(), key=lambda x: -x[1]):
        print(f"  {term}: {total_c / len(sample_files):.4f}")

    # Save summary table
    res_df.to_csv("chip_variants_summary.csv", index=False)
    print("\nDetailed sample results saved to chip_variants_summary.csv")

if __name__ == "__main__":
    main()
