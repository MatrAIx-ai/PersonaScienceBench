#!/usr/bin/env python3
"""
Calculate Pearson correlation coefficient between gene length and mean expression
(across samples) for protein-coding genes in CD4 immune cells.
"""

import pandas as pd
import numpy as np
from scipy import stats

def main():
    # 1. Load sample metadata and identify all CD4 samples
    sample_meta = pd.read_csv('data/Sample_annotated_Zenodo.csv')
    cd4_samples = sample_meta[sample_meta['celltype'] == 'CD4']['sample'].tolist()
    print(f"Total CD4 samples identified: {len(cd4_samples)}")

    # 2. Load gene metadata and filter for protein-coding genes
    gene_meta = pd.read_csv('data/GeneMetaInfo_Zenodo.csv')
    pc_genes = gene_meta[gene_meta['gene_biotype'] == 'protein_coding'][['Geneid', 'Length']].copy()
    print(f"Total protein-coding genes identified: {len(pc_genes)}")

    # 3. Load counts for CD4 samples
    counts_cols = ['Unnamed: 0'] + cd4_samples
    counts_df = pd.read_csv('data/BatchCorrectedReadCounts_Zenodo.csv', usecols=counts_cols)
    counts_df.rename(columns={'Unnamed: 0': 'Geneid'}, inplace=True)

    # Merge gene length with expression counts
    merged = pd.merge(pc_genes, counts_df, on='Geneid', how='inner').copy()
    print(f"Merged protein-coding genes in count matrix: {len(merged)}")

    # 4. Calculate mean expression across CD4 samples for each gene
    expression_matrix = merged[cd4_samples]
    mean_expr = expression_matrix.mean(axis=1)
    merged['mean_expression'] = mean_expr.values

    # 5. Pearson correlation between gene length and mean expression
    r_val, p_val = stats.pearsonr(merged['Length'], merged['mean_expression'])
    print(f"\n--- Primary Result ---")
    print(f"Pearson correlation coefficient (r): {r_val:.8f}")
    print(f"Full precision r: {r_val}")
    print(f"p-value: {p_val:.4e}")

    # 6. Diagnostics and sanity checks
    print("\n--- Diagnostics & Sanity Checks ---")
    print(f"Minimum expression value in counts: {expression_matrix.values.min()}")
    print(f"Maximum expression value in counts: {expression_matrix.values.max()}")
    print(f"Number of genes with zero expression across all CD4 samples: {(merged['mean_expression'] == 0).sum()}")

    # Non-zero expression genes
    nonzero = merged[merged['mean_expression'] > 0]
    r_nz, p_nz = stats.pearsonr(nonzero['Length'], nonzero['mean_expression'])
    print(f"Pearson r (excluding 0-mean genes, n={len(nonzero)}): {r_nz:.8f} (p = {p_nz:.4e})")

    # Log2(mean_expression + 1)
    r_log, p_log = stats.pearsonr(merged['Length'], np.log2(merged['mean_expression'] + 1))
    print(f"Pearson r with log2(mean + 1): {r_log:.8f} (p = {p_log:.4e})")

    # Spearman rank correlation
    rho, p_rho = stats.spearmanr(merged['Length'], merged['mean_expression'])
    print(f"Spearman rank correlation (rho): {rho:.8f} (p = {p_rho:.4e})")

    # CD4 refsamp subset
    cd4_refsamp = sample_meta[(sample_meta['celltype'] == 'CD4') & (sample_meta['samtype'] == 'refsamp')]['sample'].tolist()
    mean_refsamp = merged[cd4_refsamp].mean(axis=1)
    r_ref, p_ref = stats.pearsonr(merged['Length'], mean_refsamp)
    print(f"Pearson r (CD4 refsamp only, n={len(cd4_refsamp)}): {r_ref:.8f} (p = {p_ref:.4e})")

if __name__ == '__main__':
    main()
