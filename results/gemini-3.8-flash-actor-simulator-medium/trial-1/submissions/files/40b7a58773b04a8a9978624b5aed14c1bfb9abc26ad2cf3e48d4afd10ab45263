import pandas as pd
import statsmodels.api as sm
import statsmodels.formula.api as smf

def main():
    # Load dataset
    data_path = 'data/data.xlsx'
    df = pd.read_excel(data_path)
    
    # Exclude trailing empty rows
    df = df.dropna(subset=['Sequence number']).copy()
    
    # Binary outcome: PR (Partial Response) vs other responses (PD/SD)
    df['response_pr'] = (df['Efficacy'] == 'PR').astype(int)
    
    # Fit logistic regression model with BMI as the sole predictor
    model = smf.logit('response_pr ~ BMI', data=df).fit()
    
    print("=== Model Summary ===")
    print(model.summary())
    
    log_likelihood = model.llf
    aic = model.aic
    bic = model.bic
    nobs = int(model.nobs)
    
    print("\n=== Key Metrics ===")
    print(f"Sample size (N): {nobs}")
    print(f"Log-Likelihood: {log_likelihood:.6f}")
    print(f"AIC: {aic:.6f}")
    print(f"AIC (rounded to 2 decimal places): {aic:.2f}")
    print(f"AIC (rounded to 4 decimal places): {aic:.4f}")
    print(f"BIC: {bic:.6f}")

if __name__ == '__main__':
    main()
