import pandas as pd
import numpy as np
from scipy import stats
import statsmodels.api as sm
from statsmodels.formula.api import ols

df = pd.read_csv('data/meta-regression_joined_data_heterogeneity_in_replication_projects.csv')

def run_stats(sub, label):
    n = len(sub)
    ro_mean, ro_med = sub['ro'].mean(), sub['ro'].median()
    rr_mean, rr_med = sub['rr'].mean(), sub['rr'].median()
    diff_r = sub['ro'] - sub['rr']
    t_r, p_r = stats.ttest_rel(sub['ro'], sub['rr'])
    w_r, wp_r = stats.wilcoxon(sub['ro'], sub['rr'])
    pct_gt = (sub['ro'] > sub['rr']).mean() * 100
    rel_mean, rel_med = sub['relative_es'].mean(), sub['relative_es'].median()
    return {
        'Domain': label,
        'N': n,
        'Mean_ro': ro_mean,
        'Mean_rr': rr_mean,
        'Mean_diff': diff_r.mean(),
        'Pct_ro_gt_rr': pct_gt,
        't_stat': t_r,
        'p_val': p_r,
        'w_stat': w_r,
        'w_pval': wp_r,
        'Mean_rel_es': rel_mean,
        'Med_rel_es': rel_med
    }

results = []
results.append(run_stats(df, 'All Domains'))
for d in ['Cognitive', 'Social', 'Economics']:
    results.append(run_stats(df[df['discipline'] == d], f'Discipline: {d}'))
for p in ['Psychology', 'Experimental Economics']:
    results.append(run_stats(df[df['project.x'] == p], f'Project: {p}'))

res_df = pd.DataFrame(results)
print(res_df.to_string(index=False))
