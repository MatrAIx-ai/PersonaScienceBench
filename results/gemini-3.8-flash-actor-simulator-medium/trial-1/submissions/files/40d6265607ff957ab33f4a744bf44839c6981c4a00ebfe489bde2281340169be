from __future__ import annotations

from typing import Any
import numpy as np


class OptimisticDualQLearner:
    """
    Tabular, online, model-free optimistic Q-learning with dual confidence estimates:
    1. One-step bootstrapped Q-estimate with Bernstein confidence bound.
    2. Episodic trace-based multi-step return estimate with variance-sensitive bonus.

    Both estimates maintain centered first and second moments online in O(H*S*A) space,
    mitigating finite-sample burn-in and downstream target drift while maintaining
    rigorous optimism.
    """

    def __init__(self, env_spec: dict[str, Any], seed: int) -> None:
        self.H = int(env_spec["H"])
        self.S = int(env_spec["S"])
        self.A = int(env_spec["A"])
        self.rng = np.random.default_rng(seed)

        # Unified confidence bonus hyperparameters (shared across all MDP families)
        self.c_var1 = 0.12
        self.c_rem1 = 0.02
        self.c_varM = 0.15
        self.c_remM = 0.04

        # Exploration scale factor
        self.iota = float(np.log(float(self.S * self.A * self.H) + 1.0))

        # Estimate 1: One-step bootstrapped Q
        self.Q1 = np.zeros((self.H, self.S, self.A), dtype=np.float64)
        for h in range(self.H):
            self.Q1[h] = float(self.H - h)
        self.N1 = np.zeros((self.H, self.S, self.A), dtype=np.int64)
        self.mean1 = np.zeros((self.H, self.S, self.A), dtype=np.float64)
        self.m2_1 = np.zeros((self.H, self.S, self.A), dtype=np.float64)

        # Estimate 2: Multi-step episodic return Q
        self.QM = np.zeros((self.H, self.S, self.A), dtype=np.float64)
        for h in range(self.H):
            self.QM[h] = float(self.H - h)
        self.NM = np.zeros((self.H, self.S, self.A), dtype=np.int64)
        self.meanM = np.zeros((self.H, self.S, self.A), dtype=np.float64)
        self.m2_M = np.zeros((self.H, self.S, self.A), dtype=np.float64)

        # Single bounded episode trajectory trace (length <= H)
        self.trace: list[tuple[int, int, int, float, int]] = []

    def act(self, h: int, state: int) -> int:
        h_idx = h - 1
        # Combined optimistic upper bound
        q_combined = np.minimum(self.Q1[h_idx, state], self.QM[h_idx, state])
        max_q = np.max(q_combined)
        best_actions = np.flatnonzero(np.isclose(q_combined, max_q, atol=1e-8))
        return int(self.rng.choice(best_actions))

    def observe(
        self,
        h: int,
        state: int,
        action: int,
        reward: float,
        next_state: int,
        done: bool,
    ) -> None:
        h_idx = h - 1
        self.trace.append((h_idx, state, action, float(reward), next_state))

        # At the end of the episode, propagate multi-step returns and backward updates
        if done or h == self.H:
            self._process_episode_trace()

    def reset_episode(self, *args: Any, **kwargs: Any) -> None:
        self.trace.clear()

    def end_episode(self, *args: Any, **kwargs: Any) -> None:
        if self.trace:
            self._process_episode_trace()

    def _process_episode_trace(self) -> None:
        if not self.trace:
            return

        # Backward pass along the bounded episode trace
        G = 0.0
        for h_idx, state, action, reward, next_state in reversed(self.trace):
            G += reward
            H_rem = float(self.H - h_idx)

            # --- Update Estimate 2: Multi-step return ---
            self.NM[h_idx, state, action] += 1
            nM = self.NM[h_idx, state, action]
            deltaM = G - self.meanM[h_idx, state, action]
            self.meanM[h_idx, state, action] += deltaM / nM
            self.m2_M[h_idx, state, action] += deltaM * (G - self.meanM[h_idx, state, action])
            varM = max(0.0, self.m2_M[h_idx, state, action] / max(1, nM - 1))

            bM = self.c_varM * np.sqrt(varM * self.iota / nM) + self.c_remM * (H_rem * self.iota / nM)
            self.QM[h_idx, state, action] = min(H_rem, self.meanM[h_idx, state, action] + bM)

            # --- Update Estimate 1: One-step bootstrapped Q ---
            self.N1[h_idx, state, action] += 1
            n1 = self.N1[h_idx, state, action]
            alpha1 = (H_rem + 1.0) / (H_rem + n1)

            if h_idx + 1 < self.H:
                q_next = np.minimum(self.Q1[h_idx + 1, next_state], self.QM[h_idx + 1, next_state])
                next_v = float(np.max(q_next))
            else:
                next_v = 0.0

            target1 = reward + next_v
            delta1 = target1 - self.mean1[h_idx, state, action]
            self.mean1[h_idx, state, action] += delta1 / n1
            self.m2_1[h_idx, state, action] += delta1 * (target1 - self.mean1[h_idx, state, action])
            var1 = max(0.0, self.m2_1[h_idx, state, action] / max(1, n1 - 1))

            b1 = self.c_var1 * np.sqrt(var1 * self.iota / n1) + self.c_rem1 * (H_rem * self.iota / n1)
            new_q1 = (1.0 - alpha1) * self.Q1[h_idx, state, action] + alpha1 * (target1 + b1)
            self.Q1[h_idx, state, action] = min(H_rem, new_q1)

        self.trace.clear()


def make_agent(env_spec: dict[str, Any], seed: int) -> OptimisticDualQLearner:
    """Factory function required by the benchmark contract."""
    return OptimisticDualQLearner(env_spec, seed)
