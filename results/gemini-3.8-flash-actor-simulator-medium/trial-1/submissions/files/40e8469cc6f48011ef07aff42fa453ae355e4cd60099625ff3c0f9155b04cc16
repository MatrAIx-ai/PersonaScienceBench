import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf

def main():
    # Load dataset
    df = pd.read_csv('data/nls_ses_processed.csv')
    df.columns = [c.replace(' ', '_').replace(':', '') for c in df.columns]
    df['BA_DEGREE_COMPLETED'] = df['BA_DEGREE_COMPLETED'].astype(int)
    
    print("Dataset Summary:")
    print(f"Total rows: {len(df)}")
    print(f"BA completion count: {df['BA_DEGREE_COMPLETED'].sum()}")
    print()
    
    # Model 1: Baseline effect of SAMPLE_RACE
    base_formula = 'BA_DEGREE_COMPLETED ~ C(SAMPLE_RACE, Treatment(reference="White"))'
    base_model = smf.logit(base_formula, data=df).fit(disp=False)
    print("=== Baseline Model (SAMPLE_RACE only) ===")
    print(base_model.summary().tables[1])
    print()
    
    # Model 2: Full model including SES and academic characteristics
    full_formula = ('BA_DEGREE_COMPLETED ~ C(SAMPLE_RACE, Treatment(reference="White")) + '
                    'SES + ABILITY_COMPOSITE_OF_ASVAB_SCORE + PERCENTILE_IN_CLASS')
    full_model = smf.logit(full_formula, data=df).fit(disp=False)
    print("=== Full Model (SAMPLE_RACE + SES + Academic Characteristics) ===")
    print(full_model.summary().tables[1])
    print()
    
    # Comparison of other background variables:
    # 1. SAMPLE_SEX
    sex_base = smf.logit('BA_DEGREE_COMPLETED ~ C(SAMPLE_SEX)', data=df).fit(disp=False)
    sex_full = smf.logit('BA_DEGREE_COMPLETED ~ C(SAMPLE_SEX) + SES + ABILITY_COMPOSITE_OF_ASVAB_SCORE + PERCENTILE_IN_CLASS', data=df).fit(disp=False)
    print("=== SAMPLE_SEX ===")
    print(f"Base coef: {sex_base.params.iloc[1]:.4f} (p={sex_base.pvalues.iloc[1]:.4f})")
    print(f"Full coef: {sex_full.params.iloc[1]:.4f} (p={sex_full.pvalues.iloc[1]:.4f})")
    print()
    
    # 2. FAMILY SIZE OF SAMPLE
    fam_base = smf.logit('BA_DEGREE_COMPLETED ~ FAMILY_SIZE_OF_SAMPLE', data=df).fit(disp=False)
    fam_full = smf.logit('BA_DEGREE_COMPLETED ~ FAMILY_SIZE_OF_SAMPLE + SES + ABILITY_COMPOSITE_OF_ASVAB_SCORE + PERCENTILE_IN_CLASS', data=df).fit(disp=False)
    print("=== FAMILY SIZE OF SAMPLE ===")
    print(f"Base coef: {fam_base.params.iloc[1]:.4f} (p={fam_base.pvalues.iloc[1]:.4f})")
    print(f"Full coef: {fam_full.params.iloc[1]:.4f} (p={fam_full.pvalues.iloc[1]:.4f})")
    print()

if __name__ == '__main__':
    main()
