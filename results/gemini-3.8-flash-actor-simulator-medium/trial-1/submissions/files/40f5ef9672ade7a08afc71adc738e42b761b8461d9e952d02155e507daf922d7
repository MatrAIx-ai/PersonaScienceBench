#!/usr/bin/env python3
"""
Statistical test of independence between m6A methylation status
and differential expression status in bladder cancer dataset.
"""

import pandas as pd
from scipy import stats

def main():
    # 1. Load data
    file_path = 'data/MeRIP_RNA_result.xlsx'
    df = pd.read_excel(file_path)
    
    print(f"Total records analyzed: {len(df)}")
    
    # 2. Construct 3x3 contingency table
    m6A_order = ['m6A Hyper', 'm6A Hypo', 'm6A no sig']
    deg_order = ['Down', 'Up', 'no-DEGs']
    
    ct_3x3 = pd.crosstab(df['m6A'], df['DEG']).reindex(index=m6A_order, columns=deg_order)
    print("\n=== 3x3 Contingency Table ===")
    print(ct_3x3)
    
    # Pearson's Chi-square test
    chi2_stat, p_val, dof, expected = stats.chi2_contingency(ct_3x3)
    print(f"\nChi-square statistic: {chi2_stat:.4f}")
    print(f"Degrees of freedom: {dof}")
    print(f"p-value: {p_val:.16e}")
    print(f"p-value (scientific notation): {p_val:.4e}")
    
    # 3. Binary 2x2 contingency table (Significant vs Non-significant)
    df['m6A_sig'] = df['m6A'].isin(['m6A Hyper', 'm6A Hypo'])
    df['DEG_sig'] = df['DEG'].isin(['Up', 'Down'])
    ct_2x2 = pd.crosstab(df['m6A_sig'], df['DEG_sig'])
    ct_2x2 = ct_2x2.rename(index={False: 'm6A Non-sig', True: 'm6A Sig'},
                            columns={False: 'DEG Non-sig', True: 'DEG Sig'})
    
    chi2_2x2, p_2x2, dof_2x2, _ = stats.chi2_contingency(ct_2x2, correction=False)
    print("\n=== 2x2 Contingency Table ===")
    print(ct_2x2)
    print(f"2x2 Chi-square statistic: {chi2_2x2:.4f}, df: {dof_2x2}, p-value: {p_2x2:.4e}")
    
    # 4. Gene-level deduplicated table
    df_gene = df.drop_duplicates(subset=['gene_id'])
    ct_gene = pd.crosstab(df_gene['m6A'], df_gene['DEG']).reindex(index=m6A_order, columns=deg_order).fillna(0)
    chi2_gene, p_gene, dof_gene, _ = stats.chi2_contingency(ct_gene)
    print(f"\n=== Gene-level Check (N={len(df_gene)}) ===")
    print(f"Gene-level Chi-square statistic: {chi2_gene:.4f}, df: {dof_gene}, p-value: {p_gene:.4e}")

if __name__ == '__main__':
    main()
