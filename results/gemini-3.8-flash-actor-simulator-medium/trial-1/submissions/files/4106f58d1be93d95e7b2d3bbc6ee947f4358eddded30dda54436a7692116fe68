"""
Econometric and Statistical Analysis of Wealth Disparities by Incarceration Status (NLSY79)
Dataset: data/nls_incarceration_processed.csv
Variables:
  - race: Hispanic, Black, White
  - sex: Female, Male
  - ever_jailed: 1 if respondent was jailed between 1985 and 1994, 0 otherwise
  - composite_wealth_1985, composite_wealth_1990, composite_wealth_1996: composite wealth in 1985, 1990, and 1996
"""

import json
import pandas as pd
import numpy as np
import scipy.stats as stats
import statsmodels.formula.api as smf

def main():
    df = pd.read_csv('data/nls_incarceration_processed.csv')
    years = [1985, 1990, 1996]
    summary_report = {}

    print("=== NLSY INCARCERATION & WEALTH ANALYSIS ===")
    print(f"Total sample size: {len(df)}")
    print(f"Ever jailed count: {df['ever_jailed'].sum()} ({df['ever_jailed'].mean()*100:.2f}%)")
    print(f"Never jailed count: {(df['ever_jailed'] == 0).sum()} ({(df['ever_jailed'] == 0).mean()*100:.2f}%)\n")

    for yr in years:
        col = f'composite_wealth_{yr}'
        jailed = df[df['ever_jailed'] == 1][col]
        non_jailed = df[df['ever_jailed'] == 0][col]

        # Bivariate tests
        t_stat, t_pval = stats.ttest_ind(jailed, non_jailed, equal_var=False)
        u_stat, u_pval = stats.mannwhitneyu(jailed, non_jailed, alternative='two-sided')

        # OLS models
        ols_unadj = smf.ols(f'{col} ~ ever_jailed', data=df).fit(cov_type='HC3')
        ols_adj_classical = smf.ols(f'{col} ~ ever_jailed + C(race) + C(sex)', data=df).fit()
        ols_adj_hc3 = smf.ols(f'{col} ~ ever_jailed + C(race) + C(sex)', data=df).fit(cov_type='HC3')
        qreg = smf.quantreg(f'{col} ~ ever_jailed + C(race) + C(sex)', data=df).fit(q=0.5)

        summary_report[yr] = {
            'jailed_mean': jailed.mean(),
            'non_jailed_mean': non_jailed.mean(),
            'mean_diff': jailed.mean() - non_jailed.mean(),
            'jailed_median': jailed.median(),
            'non_jailed_median': non_jailed.median(),
            'median_diff': jailed.median() - non_jailed.median(),
            'welch_t_stat': t_stat,
            'welch_p_value': t_pval,
            'mann_whitney_u': u_stat,
            'mann_whitney_p_value': u_pval,
            'ols_unadj_beta': ols_unadj.params['ever_jailed'],
            'ols_unadj_p_value': ols_unadj.pvalues['ever_jailed'],
            'ols_adj_classical_p_value': ols_adj_classical.pvalues['ever_jailed'],
            'ols_adj_hc3_beta': ols_adj_hc3.params['ever_jailed'],
            'ols_adj_hc3_se': ols_adj_hc3.bse['ever_jailed'],
            'ols_adj_hc3_p_value': ols_adj_hc3.pvalues['ever_jailed'],
            'qreg_median_beta': qreg.params['ever_jailed'],
            'qreg_median_p_value': qreg.pvalues['ever_jailed'],
        }

        print(f"--- Year {yr} ---")
        print(f"Mean Wealth: Jailed = ${jailed.mean():,.2f} | Non-Jailed = ${non_jailed.mean():,.2f} | Diff = ${jailed.mean() - non_jailed.mean():,.2f}")
        print(f"Median Wealth: Jailed = ${jailed.median():,.2f} | Non-Jailed = ${non_jailed.median():,.2f}")
        print(f"Welch t-test: t = {t_stat:.4f}, p = {t_pval:.4e}")
        print(f"Mann-Whitney U test: U = {u_stat:,.1f}, p = {u_pval:.4e}")
        print(f"OLS Adjusted (HC3): beta = {ols_adj_hc3.params['ever_jailed']:,.2f}, SE = {ols_adj_hc3.bse['ever_jailed']:,.2f}, p = {ols_adj_hc3.pvalues['ever_jailed']:.4e}")
        print(f"OLS Adjusted (Classical): p = {ols_adj_classical.pvalues['ever_jailed']:.4e}")
        print(f"Median Quantile Reg (Adjusted): beta = {qreg.params['ever_jailed']:,.2f}, p = {qreg.pvalues['ever_jailed']:.4e}\n")

    with open('analysis_summary.json', 'w') as f:
        json.dump(summary_report, f, indent=2)

if __name__ == '__main__':
    main()
