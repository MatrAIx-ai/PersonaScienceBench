def draw_text(img, text, x0, y0, color=(0, 0, 0), scale=1):
    H, W, _ = img.shape
    for ch in str(text):
        cols = FONT.get(ch, FONT[' '])
        for cx, col in enumerate(cols):
            for cy in range(7):
                if (col >> cy) & 1:
                    px = x0 + cx * scale
                    py = y0 + cy * scale
                    if 0 <= py < H and 0 <= px < W:
                        img[py:min(H, py+scale), px:min(W, px+scale)] = color
        x0 += (len(cols) + 1) * scale

def draw_line(img, x0, y0, x1, y1, color=(0, 0, 0), width=1):
    H, W, _ = img.shape
    dx = abs(x1 - x0)
    dy = -abs(y1 - y0)
    sx = 1 if x0 < x1 else -1
    sy = 1 if y0 < y1 else -1
    err = dx + dy
    cx, cy = x0, y0
    
    half = width // 2
    while True:
        for ox in range(-half, half + 1):
            for oy in range(-half, half + 1):
                px, py = cx + ox, cy + oy
                if 0 <= px < W and 0 <= py < H:
                    img[py, px] = color
        if cx == x1 and cy == y1:
            break
        e2 = 2 * err
        if e2 >= dy:
            err += dy
            cx += sx
        if e2 <= dx:
            err += dx
            cy += sy

