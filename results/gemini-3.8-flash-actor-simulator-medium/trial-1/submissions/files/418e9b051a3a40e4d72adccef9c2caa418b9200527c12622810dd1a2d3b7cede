C_SOURCE = r'''
#include <stdio.h>
#include <stdlib.h>
#include <math.h>

#define PI 3.14159265358979323846

static inline double wrap_angle(double th) {
    while (th < 0.0) th += 2.0 * PI;
    while (th >= 2.0 * PI) th -= 2.0 * PI;
    return th;
}

static inline double wrap_diff(double d) {
    while (d <= -PI) d += 2.0 * PI;
    while (d > PI) d -= 2.0 * PI;
    return d;
}

typedef struct {
    unsigned long long s[2];
} prng_t;

static inline unsigned long long prng_next(prng_t *p) {
    unsigned long long s1 = p->s[0];
    const unsigned long long s0 = p->s[1];
    p->s[0] = s0;
    s1 ^= s1 << 23;
    p->s[1] = s1 ^ s0 ^ (s1 >> 18) ^ (s0 >> 5);
    return p->s[1] + s0;
}

static inline double prng_uniform(prng_t *p) {
    return (prng_next(p) >> 11) * (1.0 / 9007199254740992.0);
}

void metropolis_sweep(double *theta, int L, double beta, double delta, prng_t *p) {
    for (int y = 0; y < L; y++) {
        int y_up = (y + 1 == L) ? 0 : y + 1;
        int y_dn = (y == 0) ? L - 1 : y - 1;
        for (int x = 0; x < L; x++) {
            int x_rt = (x + 1 == L) ? 0 : x + 1;
            int x_lf = (x == 0) ? L - 1 : x - 1;
            int idx = y * L + x;
            double th_old = theta[idx];
            double th_new = wrap_angle(th_old + (prng_uniform(p) * 2.0 - 1.0) * delta);
            
            double th_rt = theta[y * L + x_rt];
            double th_lf = theta[y * L + x_lf];
            double th_up = theta[y_up * L + x];
            double th_dn = theta[y_dn * L + x];
            
            double e_old = -(cos(th_old - th_rt) + cos(th_old - th_lf) + cos(th_old - th_up) + cos(th_old - th_dn));
            double e_new = -(cos(th_new - th_rt) + cos(th_new - th_lf) + cos(th_new - th_up) + cos(th_new - th_dn));
            double de = e_new - e_old;
            
            if (de <= 0.0 || prng_uniform(p) < exp(-beta * de)) {
                theta[idx] = th_new;
            }
        }
    }
}

void reflection_sweep(double *theta, int L, prng_t *p) {
    for (int y = 0; y < L; y++) {
        int y_up = (y + 1 == L) ? 0 : y + 1;
        int y_dn = (y == 0) ? L - 1 : y - 1;
        for (int x = 0; x < L; x++) {
            int x_rt = (x + 1 == L) ? 0 : x + 1;
            int x_lf = (x == 0) ? L - 1 : x - 1;
            int idx = y * L + x;
            
            double hx = cos(theta[y * L + x_rt]) + cos(theta[y * L + x_lf]) + cos(theta[y_up * L + x]) + cos(theta[y_dn * L + x]);
            double hy = sin(theta[y * L + x_rt]) + sin(theta[y * L + x_lf]) + sin(theta[y_up * L + x]) + sin(theta[y_dn * L + x]);
            
            if (hx * hx + hy * hy > 1e-12) {
                double psi = atan2(hy, hx);
                theta[idx] = wrap_angle(2.0 * psi - theta[idx]);
            }
        }
    }
}

void wolff_update(double *theta, int L, double beta, int *queue, unsigned char *visited, prng_t *p) {
    int N = L * L;
    for (int i = 0; i < N; i++) visited[i] = 0;
    
    int seed = (int)(prng_uniform(p) * N);
    if (seed >= N) seed = N - 1;
    
    double alpha = prng_uniform(p) * 2.0 * PI;
    
    int q_head = 0, q_tail = 0;
    queue[q_tail++] = seed;
    visited[seed] = 1;
    
    while (q_head < q_tail) {
        int curr = queue[q_head++];
        int cy = curr / L;
        int cx = curr % L;
        double sigma_curr = cos(theta[curr] - alpha);
        
        int nbrs[4];
        nbrs[0] = cy * L + ((cx + 1 == L) ? 0 : cx + 1);
        nbrs[1] = cy * L + ((cx == 0) ? L - 1 : cx - 1);
        nbrs[2] = ((cy + 1 == L) ? 0 : cy + 1) * L + cx;
        nbrs[3] = ((cy == 0) ? L - 1 : cy - 1) * L + cx;
        
        for (int k = 0; k < 4; k++) {
            int nb = nbrs[k];
            if (!visited[nb]) {
                double sigma_nb = cos(theta[nb] - alpha);
                double prod = sigma_curr * sigma_nb;
                if (prod > 0.0) {
                    double prob = 1.0 - exp(-2.0 * beta * prod);
                    if (prng_uniform(p) < prob) {
                        visited[nb] = 1;
                        queue[q_tail++] = nb;
                    }
                }
            }
        }
    }
    
    for (int i = 0; i < q_tail; i++) {
        int idx = queue[i];
        theta[idx] = wrap_angle(2.0 * alpha + PI - theta[idx]);
    }
}

void measure_pass_observables(double *theta, int L, double *obs_out) {
    int N = L * L;
    double ex = 0.0, ey = 0.0;
    double sx = 0.0, sy = 0.0;
    double q_tot = 0.0;
    double M_cos = 0.0, M_sin = 0.0;
    
    double q1 = 2.0 * PI / L;
    double Fx_c = 0.0, Fx_s = 0.0;
    double Fy_c = 0.0, Fy_s = 0.0;
    double Gx_c = 0.0, Gx_s = 0.0;
    double Gy_c = 0.0, Gy_s = 0.0;
    
    for (int y = 0; y < L; y++) {
        int y_up = (y + 1 == L) ? 0 : y + 1;
        double cy = cos(q1 * y);
        double sy_val = sin(q1 * y);
        
        for (int x = 0; x < L; x++) {
            int x_rt = (x + 1 == L) ? 0 : x + 1;
            int idx = y * L + x;
            double th = theta[idx];
            double th_rt = theta[y * L + x_rt];
            double th_up = theta[y_up * L + x];
            double th_corner = theta[y_up * L + x_rt];
            
            double d_x = wrap_diff(th_rt - th);
            double d_y = wrap_diff(th_up - th);
            ex += cos(d_x);
            ey += cos(d_y);
            sx += sin(d_x);
            sy += sin(d_y);
            
            double d1 = d_x;
            double d2 = wrap_diff(th_corner - th_rt);
            double d3 = wrap_diff(th_up - th_corner);
            double d4 = wrap_diff(th - th_up);
            double circ = (d1 + d2 + d3 + d4) / (2.0 * PI);
            q_tot += fabs(round(circ));
            
            double c_th = cos(th);
            double s_th = sin(th);
            M_cos += c_th;
            M_sin += s_th;
            
            double cx = cos(q1 * x);
            double sx_val = sin(q1 * x);
            Fx_c += c_th * cx;
            Fx_s += c_th * sx_val;
            Fy_c += s_th * cx;
            Fy_s += s_th * sx_val;
            
            Gx_c += c_th * cy;
            Gx_s += c_th * sy_val;
            Gy_c += s_th * cy;
            Gy_s += s_th * sy_val;
        }
    }
    
    obs_out[0] = ex / N;
    obs_out[1] = ey / N;
    obs_out[2] = sx;
    obs_out[3] = sy;
    obs_out[4] = q_tot / N;
    obs_out[5] = M_cos;
    obs_out[6] = M_sin;
    
    double Sq1_x = (Fx_c * Fx_c + Fx_s * Fx_s + Fy_c * Fy_c + Fy_s * Fy_s) / N;
    double Sq1_y = (Gx_c * Gx_c + Gx_s * Gx_s + Gy_c * Gy_c + Gy_s * Gy_s) / N;
    obs_out[7] = 0.5 * (Sq1_x + Sq1_y);
}

void measure_radial_corr(double *theta, int L, int n_probes, double *g_out) {
    int N = L * L;
    for (int r = 1; r <= n_probes; r++) {
        double sum = 0.0;
        for (int y = 0; y < L; y++) {
            int y_shift = (y + r) % L;
            for (int x = 0; x < L; x++) {
                int x_shift = (x + r) % L;
                double th = theta[y * L + x];
                sum += cos(theta[y * L + x_shift] - th);
                sum += cos(theta[y_shift * L + x] - th);
            }
        }
        g_out[r - 1] += sum / (2.0 * N);
    }
}
'''

def get_engine():
    lib_path = os.path.join(os.path.dirname(__file__), 'libsim_engine.so')
    if not os.path.exists(lib_path):
        c_path = os.path.join(os.path.dirname(__file__), 'sim_engine.c')
        with open(c_path, 'w') as f:
            f.write(C_SOURCE)
        subprocess.run(['gcc', '-O3', '-shared', '-fPIC', c_path, '-o', lib_path, '-lm'], check=True)
    return ctypes.CDLL(lib_path)

class PRNG(ctypes.Structure):
