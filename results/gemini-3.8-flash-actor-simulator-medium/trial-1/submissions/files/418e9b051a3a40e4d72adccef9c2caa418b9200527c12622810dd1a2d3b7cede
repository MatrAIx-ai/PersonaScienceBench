        for k in range(len(temps)-1):
            xa, ya = to_pix3(temps[k], obs_chi[i, k])
            xb, yb = to_pix3(temps[k+1], obs_chi[i, k+1])
            draw_line(img, xa, ya, xb, yb, color=colors[i], width=2)
        for k in range(len(temps)):
            xa, ya = to_pix3(temps[k], obs_chi[i, k])
            img[ya-2:ya+3, xa-2:xa+3] = colors[i]
            
    # Panel 4: Second-Moment Ratio xi_2nd / L vs T
    to_pix4 = setup_panel(x_starts[0], y_starts[1], "4. Scaling Ratio xi_2nd / L", "T", "xi/L", (0.81, 0.94), (0.65, 1.15))
    for i in range(len(sizes)):
        for k in range(len(temps)-1):
            xa, ya = to_pix4(temps[k], obs_xi_ratio[i, k])
            xb, yb = to_pix4(temps[k+1], obs_xi_ratio[i, k+1])
            draw_line(img, xa, ya, xb, yb, color=colors[i], width=2)
        for k in range(len(temps)):
            xa, ya = to_pix4(temps[k], obs_xi_ratio[i, k])
            img[ya-2:ya+3, xa-2:xa+3] = colors[i]
            
    # Panel 5: Radial Correlation Profiles G(r)
    to_pix5 = setup_panel(x_starts[1], y_starts[1], "5. Radial Correlation G(r) [L=104]", "r", "G(r)", (1.0, 50.0), (0.0, 0.85))
    for row_idx in range(len(obs_tensor_c)):
        c_curve = obs_tensor_c[row_idx]
        for k in range(len(probes)-1):
            xa, ya = to_pix5(probes[k], c_curve[k])
            xb, yb = to_pix5(probes[k+1], c_curve[k+1])
            draw_line(img, xa, ya, xb, yb, color=colors[row_idx % len(colors)], width=2)
            
    # Panel 6: Weber-Minnhagen Residual Traces
    to_pix6 = setup_panel(x_starts[2], y_starts[1], "6. WM Residual Sweeps r(T)", "T", "Resid", (0.81, 0.94), (0.00, 0.12))
    for t_idx, trace in enumerate(wm_traces):
        for k in range(len(temps)-1):
            xa, ya = to_pix6(temps[k], trace[k])
            xb, yb = to_pix6(temps[k+1], trace[k+1])
            draw_line(img, xa, ya, xb, yb, color=colors[t_idx], width=2)
        for k in range(len(temps)):
            xa, ya = to_pix6(temps[k], trace[k])
            img[ya-2:ya+3, xa-2:xa+3] = colors[t_idx]
            
    # Add size legend on top right
    leg_x = 1050
    leg_y = 35
    for i, L in enumerate(sizes):
        draw_line(img, leg_x, leg_y + i*14 + 4, leg_x + 18, leg_y + i*14 + 4, color=colors[i], width=2)
        draw_text(img, f"L={L}", leg_x + 24, leg_y + i*14, color=(20, 20, 20), scale=1)
        
    save_png_rgb(filename, img)
    print(f"Generated {filename}")

# -------------------------------------------------------------
# 3. Main Workflow
# -------------------------------------------------------------
def main():
    lib = get_engine()
    
    lib.metropolis_sweep.argtypes = [ctypes.POINTER(ctypes.c_double), ctypes.c_int, ctypes.c_double, ctypes.c_double, ctypes.POINTER(PRNG)]
    lib.reflection_sweep.argtypes = [ctypes.POINTER(ctypes.c_double), ctypes.c_int, ctypes.POINTER(PRNG)]
    lib.wolff_update.argtypes = [ctypes.POINTER(ctypes.c_double), ctypes.c_int, ctypes.c_double, ctypes.POINTER(ctypes.c_int), ctypes.POINTER(ctypes.c_uint8), ctypes.POINTER(PRNG)]
    lib.measure_pass_observables.argtypes = [ctypes.POINTER(ctypes.c_double), ctypes.c_int, ctypes.POINTER(ctypes.c_double)]
    lib.measure_radial_corr.argtypes = [ctypes.POINTER(ctypes.c_double), ctypes.c_int, ctypes.c_int, ctypes.POINTER(ctypes.c_double)]

    with open('data/control_primary.json') as f_ctrl:
        ctrl = json.load(f_ctrl)

    temps = np.load('data/scan_axis_a.npy')
    sizes = np.load('data/scan_axis_b.npy')
    probes = np.load('data/probe_axis_a.npy')
    st = np.load('data/state_tokens.npz')

    stage_plan = ctrl['stage_plan']
    warmup_passes = stage_plan['warmup_passes']
    sampling_passes = stage_plan['sampling_passes']
    delta = stage_plan['metropolis_proposal_width']
    refl_repeats = stage_plan['reflection_stage_repeats']
    clust_repeats = stage_plan['cluster_stage_repeats']
    probe_stride = stage_plan['probe_stride']
    focus_rows = ctrl['focus_probe_rows']

    n_sizes = len(sizes)
    n_temps = len(temps)

    prng = PRNG()
    prng.s[0] = 7182818284
    prng.s[1] = 3141592653

    raw_records = [[[] for _ in range(n_temps)] for _ in range(n_sizes)]
    corr_records = [[] for _ in range(n_temps)]

    print(f"Executing Monte Carlo scan across {n_sizes} sizes and {n_temps} temperatures...")
    t0 = time.time()
    for i, L in enumerate(sizes):
        slot_key = ctrl['state_bundle']['keys'][i]
        initial_grid = st[slot_key].astype(np.float64).copy()
        N = int(L * L)
        queue = (ctypes.c_int * N)()
        visited = (ctypes.c_uint8 * N)()
        obs_arr = (ctypes.c_double * 8)()
        
        for j, T in enumerate(temps):
            beta = 1.0 / T
            theta = initial_grid.flatten().copy()
            
            for p in range(warmup_passes):
                lib.metropolis_sweep(theta.ctypes.data_as(ctypes.POINTER(ctypes.c_double)), L, beta, delta, ctypes.byref(prng))
                for _ in range(refl_repeats):
                    lib.reflection_sweep(theta.ctypes.data_as(ctypes.POINTER(ctypes.c_double)), L, ctypes.byref(prng))
                for _ in range(clust_repeats):
                    lib.wolff_update(theta.ctypes.data_as(ctypes.POINTER(ctypes.c_double)), L, beta, queue, visited, ctypes.byref(prng))
                    
            is_largest = (L == sizes[-1])
            g_buf = (ctypes.c_double * len(probes))()
            
            for p in range(sampling_passes):
                lib.metropolis_sweep(theta.ctypes.data_as(ctypes.POINTER(ctypes.c_double)), L, beta, delta, ctypes.byref(prng))
                for _ in range(refl_repeats):
                    lib.reflection_sweep(theta.ctypes.data_as(ctypes.POINTER(ctypes.c_double)), L, ctypes.byref(prng))
                for _ in range(clust_repeats):
                    lib.wolff_update(theta.ctypes.data_as(ctypes.POINTER(ctypes.c_double)), L, beta, queue, visited, ctypes.byref(prng))
                    
                lib.measure_pass_observables(theta.ctypes.data_as(ctypes.POINTER(ctypes.c_double)), L, obs_arr)
                rec = (obs_arr[0], obs_arr[1], obs_arr[2], obs_arr[3], obs_arr[4], obs_arr[5], obs_arr[6], obs_arr[7])
                raw_records[i][j].append(rec)
                
                if is_largest and (p % probe_stride == 0):
                    for k in range(len(probes)): g_buf[k] = 0.0
                    lib.measure_radial_corr(theta.ctypes.data_as(ctypes.POINTER(ctypes.c_double)), L, len(probes), g_buf)
                    corr_records[j].append(np.array(g_buf[:]))

    print(f"Simulation completed in {time.time() - t0:.2f} s")

    def calc_obs(pass_indices):
        obs_ups = np.zeros((n_sizes, n_temps))
        obs_vortex = np.zeros((n_sizes, n_temps))
        obs_chi = np.zeros((n_sizes, n_temps))
        obs_xi_ratio = np.zeros((n_sizes, n_temps))
        
        for i_idx, L_val in enumerate(sizes):
            N_sites = float(L_val * L_val)
            for j_idx, T_val in enumerate(temps):
                beta_val = 1.0 / T_val
                recs = [raw_records[i_idx][j_idx][p] for p in pass_indices]
                ex = np.array([r[0] for r in recs])
                ey = np.array([r[1] for r in recs])
                sx = np.array([r[2] for r in recs])
                sy = np.array([r[3] for r in recs])
                q = np.array([r[4] for r in recs])
                M2 = np.array([(r[5]**2 + r[6]**2) / N_sites for r in recs])
                Sq1 = np.array([r[7] for r in recs])
                
                var_sx = (np.mean(sx**2) - np.mean(sx)**2) / N_sites
                var_sy = (np.mean(sy**2) - np.mean(sy)**2) / N_sites
                ups = 0.5 * ((np.mean(ex) - beta_val * var_sx) + (np.mean(ey) - beta_val * var_sy))
                
                obs_ups[i_idx, j_idx] = ups
                obs_vortex[i_idx, j_idx] = np.mean(q)
                chi = np.mean(M2)
                obs_chi[i_idx, j_idx] = chi
                s_q1 = np.mean(Sq1)
                ratio = (1.0 / (2.0 * np.sin(np.pi / L_val))) * np.sqrt(max(0.0, chi / s_q1 - 1.0)) / L_val
                obs_xi_ratio[i_idx, j_idx] = ratio
                
        return obs_ups, obs_vortex, obs_chi, obs_xi_ratio

    all_passes = list(range(sampling_passes))
    obs_ups, obs_vortex, obs_chi, obs_xi_ratio = calc_obs(all_passes)

    obs_tensor_c = np.zeros((len(focus_rows), len(probes)))
    obs_matrix_d = np.zeros((n_temps, 2))

    w_min, w_max = ctrl['fit_window_probe']
    mask_fit = (probes >= w_min) & (probes <= w_max)
    log_r_fit = np.log(probes[mask_fit])

    for j, T in enumerate(temps):
        if len(corr_records[j]) > 0:
            g_arr = np.asarray(corr_records[j], dtype=np.float64)
            g_avg = np.mean(g_arr, axis=0)
        else:
            g_avg = np.zeros(len(probes))
            
        if j in focus_rows:
            f_idx = focus_rows.index(j)
            obs_tensor_c[f_idx, :] = g_avg
            
        log_g = np.log(np.maximum(g_avg[mask_fit], 1e-12))
        poly = np.polyfit(log_r_fit, log_g, 1)
        obs_matrix_d[j, 0] = T
        obs_matrix_d[j, 1] = -poly[0]

    np.save('obs_matrix_a.npy', obs_ups)
    np.save('obs_matrix_b.npy', obs_vortex)
    np.save('obs_tensor_c.npy', obs_tensor_c)
    np.save('obs_matrix_d.npy', obs_matrix_d)
    np.save('obs_matrix_e.npy', obs_xi_ratio)
    np.save('obs_matrix_f.npy', obs_chi)
    print("Saved observable matrices.")

    # -------------------------------------------------------------
    # 4. Scaling Analyses and Diagnostic Fits
    # -------------------------------------------------------------
    abscissa = [float(1.0 / np.log(float(L))) for L in sizes]

    def run_all_fits(ups_mat, chi_mat, xi_mat, eta_vec):
        wm_l_mins = [32, 50, 68]
        wm_traces = []
        wm_best_T = []
        wm_best_C = []
        wm_best_res = []

        for l_min in wm_l_mins:
            mask = sizes >= l_min
            sub_sizes = sizes[mask]
            sub_ups = ups_mat[mask, :]
            log_L = np.log(sub_sizes)
            
            trace = []
            c_list = []
            for j, T in enumerate(temps):
                target = sub_ups[:, j]
                norm_target = np.sqrt(np.sum(target**2))
                c_min = -np.min(log_L) + 0.05
                def obj(C):
                    model = (2.0 * T / np.pi) * (1.0 + 1.0 / (2.0 * (log_L + C)))
                    return np.sqrt(np.sum((target - model)**2)) / norm_target
                res = scipy.optimize.minimize_scalar(obj, bounds=(c_min, 50.0), method='bounded')
                trace.append(float(res.fun))
                c_list.append(float(res.x))
                
            wm_traces.append(trace)
            best_idx = int(np.argmin(trace))
            wm_best_T.append(float(temps[best_idx]))
            wm_best_C.append(float(c_list[best_idx]))
            wm_best_res.append(float(trace[best_idx]))

        pref_T_wm = wm_best_T[0]
        pref_C_wm = wm_best_C[0]
        pref_res_wm = wm_best_res[0]

        resp_l_mins = [32, 50, 68]
        resp_traces = []
        resp_best_T = []
        resp_best_C = []
        resp_best_res = []

        for l_min in resp_l_mins:
            mask = sizes >= l_min
            sub_sizes = sizes[mask]
            sub_chi = chi_mat[mask, :]
            log_L = np.log(sub_sizes)
            power_L = sub_sizes ** 1.75
            
            trace = []
            c_list = []
            for j, T in enumerate(temps):
                target = sub_chi[:, j]
                norm_target = np.sqrt(np.sum(target**2))
                c_min = -np.min(log_L) + 0.05
                def obj(C):
                    f = power_L * ((log_L + C) ** 0.125)
                    A = np.dot(target, f) / np.dot(f, f)
                    model = A * f
                    return np.sqrt(np.sum((target - model)**2)) / norm_target
                res = scipy.optimize.minimize_scalar(obj, bounds=(c_min, 50.0), method='bounded')
                trace.append(float(res.fun))
                c_list.append(float(res.x))
                
            resp_traces.append(trace)
            best_idx = int(np.argmin(trace))
            resp_best_T.append(float(temps[best_idx]))
            resp_best_C.append(float(c_list[best_idx]))
            resp_best_res.append(float(trace[best_idx]))

        pref_T_resp = resp_best_T[0]
        pref_C_resp = resp_best_C[0]
        pref_res_resp = resp_best_res[0]

        nk_line = 2.0 * temps / np.pi
        size_Tc = []
        for i, L in enumerate(sizes):
            diff = ups_mat[i, :] - nk_line
            cross_idx = -1
            for k in range(len(diff) - 1):
                if (diff[k] >= 0 and diff[k+1] <= 0) or (diff[k] <= 0 and diff[k+1] >= 0):
                    cross_idx = k
                    break
            if cross_idx != -1:
                t_c = temps[cross_idx] - diff[cross_idx] * (temps[cross_idx+1] - temps[cross_idx]) / (diff[cross_idx+1] - diff[cross_idx])
            else:
                poly = np.polyfit(temps, diff, 1)
                t_c = -poly[1] / poly[0]
            size_Tc.append(float(t_c))

        size_weighted_Tc = float(np.sum(sizes * np.array(size_Tc)) / np.sum(sizes))

        finite_size_intercepts = []
        finite_size_slopes = []
        for j, T in enumerate(temps):
            y = ups_mat[:, j] / T
            p = np.polyfit(abscissa, y, 1)
            finite_size_slopes.append(float(p[0]))
            finite_size_intercepts.append(float(p[1]))

        diff_int = np.array(finite_size_intercepts) - (2.0 / np.pi)
        cross_idx = -1
        for k in range(len(diff_int) - 1):
            if (diff_int[k] >= 0 and diff_int[k+1] <= 0) or (diff_int[k] <= 0 and diff_int[k+1] >= 0):
                cross_idx = k
                break
        if cross_idx != -1:
            fs_Tc = float(temps[cross_idx] - diff_int[cross_idx] * (temps[cross_idx+1] - temps[cross_idx]) / (diff_int[cross_idx+1] - diff_int[cross_idx]))
        else:
            p = np.polyfit(temps, diff_int, 1)
            fs_Tc = float(-p[1] / p[0])
        fs_res = float(np.interp(fs_Tc, temps, finite_size_intercepts) - 2.0 / np.pi)

        dim_intercepts = []
        dim_slopes = []
        for j, T in enumerate(temps):
            y = xi_mat[:, j]
            p = np.polyfit(abscissa, y, 1)
            dim_slopes.append(float(p[0]))
            dim_intercepts.append(float(p[1]))

        cross_idx = -1
        for k in range(3, len(dim_slopes) - 1):
            if (dim_slopes[k] >= 0 and dim_slopes[k+1] <= 0) or (dim_slopes[k] <= 0 and dim_slopes[k+1] >= 0):
                cross_idx = k
                break
        if cross_idx != -1:
            dim_Tc = float(temps[cross_idx] - dim_slopes[cross_idx] * (temps[cross_idx+1] - temps[cross_idx]) / (dim_slopes[cross_idx+1] - dim_slopes[cross_idx]))
        else:
            p = np.polyfit(temps, dim_slopes, 1)
            dim_Tc = float(-p[1] / p[0])
        dim_res = float(np.interp(dim_Tc, temps, dim_slopes))

        diff_eta = eta_vec - 0.25
        cross_idx = -1
        for k in range(len(diff_eta) - 1):
            if (diff_eta[k] <= 0 and diff_eta[k+1] >= 0) or (diff_eta[k] >= 0 and diff_eta[k+1] <= 0):
                cross_idx = k
                break
        if cross_idx != -1:
            eta_Tc = float(temps[cross_idx] - diff_eta[cross_idx] * (temps[cross_idx+1] - temps[cross_idx]) / (diff_eta[cross_idx+1] - diff_eta[cross_idx]))
        else:
            p = np.polyfit(temps, diff_eta, 1)
            eta_Tc = float(-p[1] / p[0])
        eta_res = float(np.interp(eta_Tc, temps, eta_vec) - 0.25)

        comp_bundle = [pref_T_wm, size_weighted_Tc, fs_Tc, dim_Tc, eta_Tc]

        return {
            'wm_traces': wm_traces, 'wm_best_T': wm_best_T, 'wm_best_C': wm_best_C, 'wm_best_res': wm_best_res,
            'pref_T_wm': pref_T_wm, 'pref_C_wm': pref_C_wm, 'pref_res_wm': pref_res_wm,
            'resp_traces': resp_traces, 'resp_best_T': resp_best_T, 'resp_best_C': resp_best_C, 'resp_best_res': resp_best_res,
            'pref_T_resp': pref_T_resp, 'pref_C_resp': pref_C_resp, 'pref_res_resp': pref_res_resp,
            'size_Tc': size_Tc, 'size_weighted_Tc': size_weighted_Tc,
            'finite_size_intercepts': finite_size_intercepts, 'finite_size_slopes': finite_size_slopes,
            'fs_Tc': fs_Tc, 'fs_res': fs_res,
            'dim_intercepts': dim_intercepts, 'dim_slopes': dim_slopes,
            'dim_Tc': dim_Tc, 'dim_res': dim_res,
            'eta_Tc': eta_Tc, 'eta_res': eta_res,
            'comp_bundle': comp_bundle
        }

    fit_res = run_all_fits(obs_ups, obs_chi, obs_xi_ratio, obs_matrix_d[:, 1])

    # -------------------------------------------------------------
    # 5. Jackknife Uncertainty Analysis
    # -------------------------------------------------------------
    B = 16
    blocks = np.array_split(np.arange(sampling_passes), B)
    jk_components = []
    jk_pref_res = []
    jk_resp_T = []
    jk_resp_res = []

    print(f"Running jackknife error analysis over {B} blocks...")
    for b in range(B):
        keep_passes = np.concatenate([blocks[k] for k in range(B) if k != b])
        jk_ups, jk_vortex, jk_chi, jk_xi = calc_obs(keep_passes)
        
        jk_eta = np.zeros(n_temps)
        for j, T in enumerate(temps):
            if len(corr_records[j]) > 0:
                step = probe_stride
                probe_passes = [p for p in keep_passes if p % step == 0]
                probe_indices = [p // step for p in probe_passes if p // step < len(corr_records[j])]
                if len(probe_indices) > 0:
                    g_arr = np.asarray([corr_records[j][idx] for idx in probe_indices], dtype=np.float64)
                    g_avg = np.mean(g_arr, axis=0)
                else:
                    g_avg = np.mean(np.asarray(corr_records[j], dtype=np.float64), axis=0)
            else:
                g_avg = np.zeros(len(probes))
            log_g = np.log(np.maximum(g_avg[mask_fit], 1e-12))
            p_fit = np.polyfit(log_r_fit, log_g, 1)
            jk_eta[j] = -p_fit[0]
            
        b_fits = run_all_fits(jk_ups, jk_chi, jk_xi, jk_eta)
        jk_components.append(b_fits['comp_bundle'])
        jk_pref_res.append(b_fits['pref_res_wm'])
        jk_resp_T.append(b_fits['pref_T_resp'])
        jk_resp_res.append(b_fits['pref_res_resp'])

    jk_comp_arr = np.array(jk_components)
    comp_means = np.mean(jk_comp_arr, axis=0)
    comp_uncertainties = np.sqrt((B - 1) / B * np.sum((jk_comp_arr - comp_means)**2, axis=0)).tolist()

    jk_pref_res_arr = np.array(jk_pref_res)
    pref_res_unc = float(np.sqrt((B - 1) / B * np.sum((jk_pref_res_arr - np.mean(jk_pref_res_arr))**2)))

    jk_resp_T_arr = np.array(jk_resp_T)
    resp_T_unc = float(np.sqrt((B - 1) / B * np.sum((jk_resp_T_arr - np.mean(jk_resp_T_arr))**2)))

    jk_resp_res_arr = np.array(jk_resp_res)
    resp_res_unc = float(np.sqrt((B - 1) / B * np.sum((jk_resp_res_arr - np.mean(jk_resp_res_arr))**2)))

    pref_T_unc = comp_uncertainties[0]
    consensus_T = float(np.mean(fit_res['comp_bundle']))
    consensus_spread = float(np.max(fit_res['comp_bundle']) - np.min(fit_res['comp_bundle']))
    consensus_unc = float(np.mean(comp_uncertainties))

    # -------------------------------------------------------------
    # 6. JSON Deliverables
    # -------------------------------------------------------------
    pref_T = fit_res['pref_T_wm']
    ups_largest = obs_ups[-1, :]
    ups_at_tc = float(np.interp(pref_T, temps, ups_largest))
    stiffness_ratio = float(ups_at_tc / pref_T)
    stiffness_jump_residual = float(stiffness_ratio - 2.0 / np.pi)
    
    eta_at_tc = float(np.interp(pref_T, temps, obs_matrix_d[:, 1]))
    
    vortex_largest = obs_vortex[-1, :]
    defect_density_span = float(vortex_largest[-1] - vortex_largest[0])
    
    dim_ratio_at_transition = float(np.interp(pref_T, temps, fit_res['dim_intercepts']))
    
    phase_summary = {
        "setting_key": str(ctrl["scan_token"]),
        "scan_axis_a_values": [float(x) for x in temps],
        "scan_axis_b_values": [int(x) for x in sizes],
        "selected_profile_indices": [int(x) for x in focus_rows],
        "selected_profile_axis_a_values": [float(temps[x]) for x in focus_rows],
        "transition_temperature_estimate": float(pref_T),
        "inverse_transition_temperature_estimate": float(1.0 / pref_T),
        "stiffness_jump_ratio_at_transition": stiffness_ratio,
        "stiffness_jump_residual": stiffness_jump_residual,
        "correlation_exponent_at_transition": eta_at_tc,
        "defect_density_span": defect_density_span,
        "dimensionless_ratio_at_transition": dim_ratio_at_transition,
        "transition_estimate_spread": consensus_spread
    }

    with open('phase_summary.json', 'w') as f_out:
        json.dump(phase_summary, f_out, indent=2)
    print("Saved phase_summary.json")

    wm_spread = float(np.max(fit_res['wm_best_T']) - np.min(fit_res['wm_best_T']))
    resp_spread = float(np.max(fit_res['resp_best_T']) - np.min(fit_res['resp_best_T']))

