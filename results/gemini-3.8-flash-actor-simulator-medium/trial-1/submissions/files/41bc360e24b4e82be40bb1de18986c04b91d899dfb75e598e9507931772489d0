import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf

def run_analysis():
    df = pd.read_csv('data/nls_ses_processed.csv')
    df['BA'] = df['BA DEGREE COMPLETED'].astype(int)

    # 1. Stratified Summary Statistics
    df['SES_tercile'] = pd.qcut(df['SES'], 3, labels=['Low', 'Medium', 'High'])
    df['SES_quartile'] = pd.qcut(df['SES'], 4, labels=['Q1_Low', 'Q2_MidLow', 'Q3_MidHigh', 'Q4_High'])
    
    raw_tercile = df.groupby(['SES_tercile', 'SAMPLE_RACE'])['BA'].agg(['count', 'sum', 'mean'])
    raw_quartile = df.groupby(['SES_quartile', 'SAMPLE_RACE'])['BA'].agg(['count', 'sum', 'mean'])

    # 2. Multivariate Logit Models
    formula_interaction = (
        'BA ~ C(SAMPLE_RACE, Treatment("White")) * SES + '
        'Q("ABILITY: COMPOSITE OF ASVAB SCORE") + '
        'Q("PERCENTILE IN CLASS") + '
        'Q("FAMILY SIZE OF SAMPLE") + '
        'C(SAMPLE_SEX)'
    )
    model_interaction = smf.logit(formula_interaction, data=df).fit()

    # 3. Stratified Models by SES Tercile
    tercile_results = {}
    for tercile, group in df.groupby('SES_tercile'):
        formula_strat = (
            'BA ~ C(SAMPLE_RACE, Treatment("White")) + '
            'Q("ABILITY: COMPOSITE OF ASVAB SCORE") + '
            'Q("PERCENTILE IN CLASS") + '
            'Q("FAMILY SIZE OF SAMPLE") + '
            'C(SAMPLE_SEX)'
        )
        m = smf.logit(formula_strat, data=group).fit(disp=False)
        tercile_results[tercile] = {
            'Black_coef': float(m.params['C(SAMPLE_RACE, Treatment("White"))[T.Black]']),
            'Black_se': float(m.bse['C(SAMPLE_RACE, Treatment("White"))[T.Black]']),
            'Black_pvalue': float(m.pvalues['C(SAMPLE_RACE, Treatment("White"))[T.Black]']),
            'Black_OR': float(np.exp(m.params['C(SAMPLE_RACE, Treatment("White"))[T.Black]']))
        }

    return raw_tercile, raw_quartile, model_interaction, tercile_results

if __name__ == '__main__':
    raw_t, raw_q, model, stratified = run_analysis()
    print("Raw Terciles:\n", raw_t)
    print("\nStratified Tercile Results:\n", stratified)
