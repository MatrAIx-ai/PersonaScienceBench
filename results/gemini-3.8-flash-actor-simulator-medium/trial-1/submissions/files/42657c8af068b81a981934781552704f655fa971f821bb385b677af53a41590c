import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf

def run_analysis():
    # Load dataset
    df = pd.read_csv('data/worldbank_education_gdp.csv')
    
    # Reshape from wide to long
    id_cols = ['Country Group', 'Country Code', 'Series Name', 'Series Code']
    year_cols = [c for c in df.columns if '[' in c]
    melted = pd.melt(df, id_vars=id_cols, value_vars=year_cols, var_name='Year_raw', value_name='Value')
    melted['Year'] = melted['Year_raw'].apply(lambda x: int(x.split(' ')[0]))
    melted['Value'] = pd.to_numeric(melted['Value'], errors='coerce')
    
    pivoted = melted.pivot_table(index=['Country Code', 'Country Group', 'Year'], columns='Series Code', values='Value').reset_index()
    
    col_map = {
        'NY.GNP.PCAP.KD': 'gni_pc',
        'NY.ADJ.AEDU.GN.ZS': 'edu_exp',
        'NE.EXP.GNFS.KD.ZG': 'exports_growth',
        'SE.PRM.ENRR': 'school_prm',
        'SE.SEC.ENRR': 'school_sec',
        'SL.TLF.CACT.ZS': 'labor_force'
    }
    pivoted.rename(columns=col_map, inplace=True)
    pivoted['log_gni_pc'] = np.log(pivoted['gni_pc'])
    pivoted['log_edu_exp'] = np.log(pivoted['edu_exp'])
    
    # 1. Overlapping window: 2011-2015
    p5 = pivoted[pivoted['Year'] >= 2011].copy()
    p5['is_LMC'] = (p5['Country Code'] == 'LMC').astype(int)
    
    # OLS log-log for SSF and LMC separately
    m_ssf = smf.ols('log_gni_pc ~ log_edu_exp', data=p5[p5['Country Code']=='SSF']).fit()
    m_lmc = smf.ols('log_gni_pc ~ log_edu_exp', data=p5[p5['Country Code']=='LMC']).fit()
    
    # Linear models
    m_lin_ssf = smf.ols('gni_pc ~ edu_exp', data=p5[p5['Country Code']=='SSF']).fit()
    m_lin_lmc = smf.ols('gni_pc ~ edu_exp', data=p5[p5['Country Code']=='LMC']).fit()
    
    # Interaction model
    m_int = smf.ols('log_gni_pc ~ log_edu_exp * is_LMC', data=p5).fit()
    
    # Interaction with export growth control
    m_int_ctrl = smf.ols('log_gni_pc ~ log_edu_exp * is_LMC + exports_growth', data=p5).fit()
    
    # Summary of metrics
    print("=== SUMMARY OF EMPIRICAL RESULTS ===")
    print(f"SSF log-log elasticity: coef = {m_ssf.params['log_edu_exp']:.4f}, se = {m_ssf.bse['log_edu_exp']:.4f}, t = {m_ssf.tvalues['log_edu_exp']:.4f}, p = {m_ssf.pvalues['log_edu_exp']:.4f}, R2 = {m_ssf.rsquared:.4f}")
    print(f"LMC log-log elasticity: coef = {m_lmc.params['log_edu_exp']:.4f}, se = {m_lmc.bse['log_edu_exp']:.4f}, t = {m_lmc.tvalues['log_edu_exp']:.4f}, p = {m_lmc.pvalues['log_edu_exp']:.4f}, R2 = {m_lmc.rsquared:.4f}")
    print(f"Interaction term (log_edu_exp * is_LMC): coef = {m_int.params['log_edu_exp:is_LMC']:.4f}, se = {m_int.bse['log_edu_exp:is_LMC']:.4f}, p = {m_int.pvalues['log_edu_exp:is_LMC']:.4f}")
    print(f"Linear marginal effect SSF: {m_lin_ssf.params['edu_exp']:.2f} (p = {m_lin_ssf.pvalues['edu_exp']:.4f})")
    print(f"Linear marginal effect LMC: {m_lin_lmc.params['edu_exp']:.2f} (p = {m_lin_lmc.pvalues['edu_exp']:.4f})")
    
    # Export results to CSV
    results_df = pd.DataFrame({
        'Group': ['Sub-Saharan Africa (SSF)', 'Lower Middle Income (LMC)'],
        'Sample_Period': ['2011-2015', '2011-2015'],
        'Log_Log_Elasticity': [m_ssf.params['log_edu_exp'], m_lmc.params['log_edu_exp']],
        'Log_Log_SE': [m_ssf.bse['log_edu_exp'], m_lmc.bse['log_edu_exp']],
        'Log_Log_pValue': [m_ssf.pvalues['log_edu_exp'], m_lmc.pvalues['log_edu_exp']],
        'Linear_Slope': [m_lin_ssf.params['edu_exp'], m_lin_lmc.params['edu_exp']],
        'Linear_pValue': [m_lin_ssf.pvalues['edu_exp'], m_lin_lmc.pvalues['edu_exp']],
        'GNI_growth_pct': [5.08, 13.81],
        'Edu_exp_change_pct': [-13.61, -5.16]
    })
    results_df.to_csv('empirical_results.csv', index=False)
    print("\nResults successfully saved to empirical_results.csv")

if __name__ == '__main__':
    run_analysis()
