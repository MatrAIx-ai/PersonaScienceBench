import os
import glob
import openpyxl
import pandas as pd
from collections import Counter

def run_chip_analysis():
    data_dir = 'data/CHIP_DP10_GQ20_PASS'
    files = sorted(glob.glob(os.path.join(data_dir, '*.xlsx')))
    print(f"Found {len(files)} sample files in {data_dir}.")

    all_dfs = []
    sheet_info = Counter()

    for f in files:
        # Check workbook sheet name
        wb = openpyxl.load_workbook(f, read_only=True)
        sn = wb.sheetnames[0]
        sheet_info[sn] += 1
        wb.close()

        # Read data starting from row 1 (header is at row index 1)
        df = pd.read_excel(f, header=1)
        sample_id = os.path.basename(f).replace('230209_Exome_GRCh38_CHIP_', '').replace('.xlsx', '')
        df['Sample_File_ID'] = sample_id
        all_dfs.append(df)

    df_all = pd.concat(all_dfs, ignore_index=True)
    zyg_col = [c for c in df_all.columns if 'Zygosity' in str(c)][0]

    print("\n--- Sheet Name Distribution ---")
    for k, v in sheet_info.items():
        print(f"  {k}: {v} files")

    print("\n--- Overall Dataset Overview ---")
    total_rows = len(df_all)
    print(f"Total rows (calls) across all files: {total_rows}")
    print(f"Filter values present: {df_all['Filter'].unique().tolist()}")
    print(f"In_CHIP values present: {df_all['In_CHIP'].unique().tolist()}")

    zyg_counts = df_all[zyg_col].value_counts(dropna=False).to_dict()
    print("\nZygosity breakdown across all rows:")
    for k, v in zyg_counts.items():
        print(f"  {k}: {v}")

    # 1. Call-level filtering
    df_no_ref = df_all[df_all[zyg_col] != 'Reference']
    df_het_hom = df_all[df_all[zyg_col].isin(['Heterozygous', 'Homozygous Variant'])]

    calls_no_ref = len(df_no_ref)
    calls_het_hom = len(df_het_hom)

    print("\n--- Call-level (Row-level) Results ---")
    print(f"1. Total rows remaining after removing Zygosity == 'Reference': {calls_no_ref}")
    print(f"   (Includes {zyg_counts.get('Heterozygous', 0)} Heterozygous, {zyg_counts.get('Homozygous Variant', 0)} Homozygous Variant, and {df_all[zyg_col].isna().sum()} NaN/No-calls)")
    print(f"2. Total rows with confirmed variant calls (Heterozygous + Homozygous Variant): {calls_het_hom}")

    # 2. Unique genomic variants
    total_unique_variants = len(df_all[['Chr:Pos', 'Ref/Alt']].drop_duplicates())
    total_unique_positions = df_all['Chr:Pos'].nunique()

    # Unique variants in df_no_ref
    unique_no_ref = len(df_no_ref[['Chr:Pos', 'Ref/Alt']].drop_duplicates())
    unique_pos_no_ref = df_no_ref['Chr:Pos'].nunique()

    # Unique variants with confirmed Het/Hom call in at least one sample
    unique_het_hom = len(df_het_hom[['Chr:Pos', 'Ref/Alt']].drop_duplicates())
    unique_pos_het_hom = df_het_hom['Chr:Pos'].nunique()

    print("\n--- Unique Genomic Variants (Distinct Chr:Pos + Ref/Alt) Results ---")
    print(f"Total unique variants evaluated in entire dataset: {total_unique_variants}")
    print(f"1. Unique variants remaining after removing Reference calls: {unique_no_ref}")
    print(f"   (8 variants in the dataset have only Reference calls in all samples: 707 - 8 = {unique_no_ref})")
    print(f"2. Unique variants with at least one confirmed variant call (Het/Hom): {unique_het_hom}")
    print(f"   (26 variants have only Reference and/or NaN calls across all samples: 699 - 26 = {unique_het_hom})")

    # Sample-level deduplication check
    internal_dups = sum(df.duplicated(subset=['Chr:Pos', 'Ref/Alt']).sum() for df in all_dfs)
    print(f"\nInternal sample file duplicate variant rows: {internal_dups}")

    return {
        "calls_no_ref": calls_no_ref,
        "calls_het_hom": calls_het_hom,
        "unique_no_ref": unique_no_ref,
        "unique_het_hom": unique_het_hom,
        "total_rows": total_rows,
        "ref_calls": zyg_counts.get('Reference', 0),
        "nan_calls": df_all[zyg_col].isna().sum(),
        "total_unique_variants": total_unique_variants
    }

if __name__ == '__main__':
    run_chip_analysis()
