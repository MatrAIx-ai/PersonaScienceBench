import pandas as pd
import numpy as np

# Load capital data
df_cap = pd.read_csv('data/capital.csv', decimal=',')
focal = df_cap[(df_cap['BCE'] >= 3000) & (df_cap['BCE'] <= 3400)].sort_values('BCE', ascending=False)

print("=== 100-Year Binned Data (3400 BCE - 3000 BCE) ===")
cols = ['BCE', 'group', 'ZMonument', 'ZBeil', 'Zhausgr', 'ZAxtSchwert', 'ZDolch']
print(focal[cols].to_string(index=False))

# Load time series data
df_ts = pd.read_csv('data/time_series_data.csv')
sub_ts = df_ts[(df_ts['CE'] >= -3400) & (df_ts['CE'] <= -3000)]

summary_stats = pd.DataFrame({
    'Metric': ['MonumentCount (ZMonument)', 'AxesCelts (ZBeil)', 'HouseSize (Zhausgr)', 'HatchetSword (ZAxtSchwert)', 'Dagger (ZDolch)'],
    'Value_3400BCE': [focal['ZMonument'].iloc[0], focal['ZBeil'].iloc[0], focal['Zhausgr'].iloc[0], focal['ZAxtSchwert'].iloc[0], focal['ZDolch'].iloc[0]],
    'Value_3200BCE_Peak': [focal[focal['BCE']==3200]['ZMonument'].values[0], focal[focal['BCE']==3200]['ZBeil'].values[0], focal[focal['BCE']==3200]['Zhausgr'].values[0], focal[focal['BCE']==3200]['ZAxtSchwert'].values[0], focal[focal['BCE']==3200]['ZDolch'].values[0]],
    'Value_3000BCE': [focal['ZMonument'].iloc[-1], focal['ZBeil'].iloc[-1], focal['Zhausgr'].iloc[-1], focal['ZAxtSchwert'].iloc[-1], focal['ZDolch'].iloc[-1]],
    'Change_3400_to_3200': [focal[focal['BCE']==3200]['ZMonument'].values[0] - focal['ZMonument'].iloc[0], focal[focal['BCE']==3200]['ZBeil'].values[0] - focal['ZBeil'].iloc[0], focal[focal['BCE']==3200]['Zhausgr'].values[0] - focal['Zhausgr'].iloc[0], focal[focal['BCE']==3200]['ZAxtSchwert'].values[0] - focal['ZAxtSchwert'].iloc[0], focal[focal['BCE']==3200]['ZDolch'].values[0] - focal['ZDolch'].iloc[0]],
    'Change_3200_to_3000': [focal['ZMonument'].iloc[-1] - focal[focal['BCE']==3200]['ZMonument'].values[0], focal['ZBeil'].iloc[-1] - focal[focal['BCE']==3200]['ZBeil'].values[0], focal['Zhausgr'].iloc[-1] - focal[focal['BCE']==3200]['Zhausgr'].values[0], focal['ZAxtSchwert'].iloc[-1] - focal[focal['BCE']==3200]['ZAxtSchwert'].values[0], focal['ZDolch'].iloc[-1] - focal[focal['BCE']==3200]['ZDolch'].values[0]],
    'Net_Change_3400_to_3000': [focal['ZMonument'].iloc[-1] - focal['ZMonument'].iloc[0], focal['ZBeil'].iloc[-1] - focal['ZBeil'].iloc[0], focal['Zhausgr'].iloc[-1] - focal['Zhausgr'].iloc[0], focal['ZAxtSchwert'].iloc[-1] - focal['ZAxtSchwert'].iloc[0], focal['ZDolch'].iloc[-1] - focal['ZDolch'].iloc[0]]
})

print("\n=== Summary Dynamics (3400-3000 BCE) ===")
print(summary_stats.to_string(index=False))

# Environmental / Pollen Context
pollen_ctx = sub_ts[sub_ts['CE'].isin([-3400, -3300, -3200, -3100, -3000])][['CE', 'pollen_inter', 'pollen_inter_100', 'kde_all_mean']]
print("\n=== Environmental & Demographic Proxy Data ===")
