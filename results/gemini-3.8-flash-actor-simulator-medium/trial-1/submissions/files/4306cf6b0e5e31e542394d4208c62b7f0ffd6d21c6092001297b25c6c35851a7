#!/usr/bin/env python3
"""
Analysis script for BixBench bix-14-q3:
"After filtering out reference variant calls and variants located in intronic,
intergenic, or UTR regions how many non-reference exonic variants remain in
clonal hematopoiesis (CHIP) genes from the 86 samples analyzed?"
"""

import os
import glob
import pandas as pd

def run_analysis():
    # 1. Load CHIP genes list
    schenz_file = "data/230214_Schenz_et_al_2022_CHIP_Genes.xlsx"
    schenz_df = pd.read_excel(schenz_file, header=None)
    schenz_genes = set(schenz_df[0].dropna().str.strip())
    print(f"Loaded {len(schenz_genes)} CHIP genes from {schenz_file}")

    # 2. Load all sample Excel files
    sample_files = sorted(glob.glob("data/CHIP_DP10_GQ20_PASS/*.xlsx"))
    print(f"Found {len(sample_files)} sample files in data/CHIP_DP10_GQ20_PASS/")

    records = []
    for f in sample_files:
        sample_id = os.path.basename(f)
        df = pd.read_excel(f, header=1)
        df["Sample_File"] = sample_id
        records.append(df)

    all_data = pd.concat(records, ignore_index=True)
    print(f"Total variant calls loaded: {len(all_data)}")

    # 3. Categorize Sequence Ontology
    exonic_so = {
        'missense_variant',
        'synonymous_variant',
        'frameshift_variant',
        'inframe_insertion',
        'inframe_deletion'
    }
    excluded_so = {
        'intron_variant',
        '3_prime_UTR_variant',
        '5_prime_UTR_variant',
        '5_prime_UTR_premature_start_codon_gain_variant',
        'upstream_gene_variant',
        'splice_region_variant'
    }

    # Helper function to check gene in Schenz list
    def in_schenz_list(gene_str):
        if pd.isna(gene_str):
            return False
        return any(g.strip() in schenz_genes for g in str(gene_str).split(','))

    all_data['in_schenz'] = all_data['Gene Names'].apply(in_schenz_list)

    # 4. Filters
    # Non-reference definitions:
    # A) Zygosity != 'Reference' (standard filter out 'Reference')
    # B) Zygosity in ['Heterozygous', 'Homozygous Variant'] (strictly non-ref called genotypes)
    mask_exonic = all_data['Sequence Ontology (Combined)'].isin(exonic_so)
    
    # Analysis 1: Filtering out 'Reference' (Zygosity != 'Reference')
    df_non_ref_ne = all_data[all_data['Zygosity'] != 'Reference']
    df_exonic_ne = df_non_ref_ne[df_non_ref_ne['Sequence Ontology (Combined)'].isin(exonic_so)]
    
    total_calls_all_ne = len(df_exonic_ne)
    unique_vars_all_ne = len(df_exonic_ne[['Chr:Pos', 'Ref/Alt']].drop_duplicates())
    
    df_exonic_schenz_ne = df_exonic_ne[df_exonic_ne['in_schenz']]
    total_calls_schenz_ne = len(df_exonic_schenz_ne)
    unique_vars_schenz_ne = len(df_exonic_schenz_ne[['Chr:Pos', 'Ref/Alt']].drop_duplicates())

    # Analysis 2: Strict genotype call (Heterozygous / Homozygous Variant)
    df_non_ref_strict = all_data[all_data['Zygosity'].isin(['Heterozygous', 'Homozygous Variant'])]
    df_exonic_strict = df_non_ref_strict[df_non_ref_strict['Sequence Ontology (Combined)'].isin(exonic_so)]
    
    total_calls_all_strict = len(df_exonic_strict)
    unique_vars_all_strict = len(df_exonic_strict[['Chr:Pos', 'Ref/Alt']].drop_duplicates())
    
    df_exonic_schenz_strict = df_exonic_strict[df_exonic_strict['in_schenz']]
    total_calls_schenz_strict = len(df_exonic_schenz_strict)
    unique_vars_schenz_strict = len(df_exonic_schenz_strict[['Chr:Pos', 'Ref/Alt']].drop_duplicates())

    print("\n" + "="*60)
    print("RESULTS SUMMARY:")
    print("="*60)
    print("1. Standard Filter (Zygosity != 'Reference'):")
    print(f"   a) Across all In_CHIP files:")
    print(f"      - Total non-reference exonic variant calls: {total_calls_all_ne}")
    print(f"      - Unique genomic variants (Chr:Pos, Ref/Alt): {unique_vars_all_ne}")
    print(f"   b) Strictly in Schenz et al. 2022 CHIP genes:")
    print(f"      - Total non-reference exonic variant calls: {total_calls_schenz_ne}")
    print(f"      - Unique genomic variants (Chr:Pos, Ref/Alt): {unique_vars_schenz_ne}")
    print("\n2. Strict Call Filter (Zygosity in ['Heterozygous', 'Homozygous Variant']):")
    print(f"   a) Across all In_CHIP files:")
    print(f"      - Total non-reference exonic variant calls: {total_calls_all_strict}")
    print(f"      - Unique genomic variants (Chr:Pos, Ref/Alt): {unique_vars_all_strict}")
    print(f"   b) Strictly in Schenz et al. 2022 CHIP genes:")
    print(f"      - Total non-reference exonic variant calls: {total_calls_schenz_strict}")
    print(f"      - Unique genomic variants (Chr:Pos, Ref/Alt): {unique_vars_schenz_strict}")
    print("="*60)

    # Save summary dataframe
    summary_data = [
        {"Filter_Condition": "Zygosity != Reference", "Gene_Scope": "All files (In_CHIP==True)", "Total_Variant_Calls": total_calls_all_ne, "Unique_Genomic_Variants": unique_vars_all_ne},
        {"Filter_Condition": "Zygosity != Reference", "Gene_Scope": "Schenz et al. 2022 CHIP genes", "Total_Variant_Calls": total_calls_schenz_ne, "Unique_Genomic_Variants": unique_vars_schenz_ne},
        {"Filter_Condition": "Zygosity in [Het, Hom]", "Gene_Scope": "All files (In_CHIP==True)", "Total_Variant_Calls": total_calls_all_strict, "Unique_Genomic_Variants": unique_vars_all_strict},
        {"Filter_Condition": "Zygosity in [Het, Hom]", "Gene_Scope": "Schenz et al. 2022 CHIP genes", "Total_Variant_Calls": total_calls_schenz_strict, "Unique_Genomic_Variants": unique_vars_schenz_strict},
    ]
    summary_df = pd.DataFrame(summary_data)
    summary_df.to_csv("results_summary.csv", index=False)
    print("Saved summary results to results_summary.csv")

if __name__ == "__main__":
    run_analysis()
