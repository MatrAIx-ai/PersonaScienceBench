#!/usr/bin/env python3
import os
import sys
import json
import numpy as np
import pandas as pd

for p in ['/usr/lib/python3/dist-packages', '/usr/local/lib/python3/dist-packages']:
    if p not in sys.path and os.path.exists(p):
        sys.path.append(p)

try:
    import matplotlib.pyplot as plt
    HAS_MPL = True
except ImportError:
    HAS_MPL = False
    from PIL import Image, ImageDraw

def run_snowpack_simulation(init_path="data/snowpack_init.json", forcing_path="data/forcing.csv", output_dir="results"):
    os.makedirs(output_dir, exist_ok=True)
    with open(init_path, "r") as f:
        init_data = json.load(f)
    forcing = pd.read_csv(forcing_path)
    n_hours = len(forcing)
    assert n_hours % 24 == 0, f"Forcing hours ({n_hours}) must be a multiple of 24"
    n_days = n_hours // 24

    sigma = 5.670374419e-8
    eps = 0.98
    alpha = 0.78
    h_turb = 15.0
    c_ice = 2100.0
    c_liq = 4182.0
    L_f = 3.34e5
    g = 9.81
    rho_fresh = 100.0
    T_f = 273.15
    S_max = 0.05
    dt = 3600.0

    c1 = 2.77e-6 * 3600.0
    c2 = 0.04
    c5 = 0.046
    eta0 = 1.0e7
    a_rho = 0.021
    b_T = 0.08

    thickness = np.array([l["thickness_m"] for l in init_data["layers"]], dtype=np.float64)
    density = np.array([l["density_kg_m3"] for l in init_data["layers"]], dtype=np.float64)
    ice_mm = np.array([l["ice_mm"] for l in init_data["layers"]], dtype=np.float64)
    liq_mm = np.array([l["liq_mm"] for l in init_data["layers"]], dtype=np.float64)
    temp_K = np.array([l["temp_K"] for l in init_data["layers"]], dtype=np.float64)

    init_swe = float(np.sum(ice_mm + liq_mm))
    snow_state = np.zeros((n_days, 3, 5), dtype=np.float64)
    summary_records = []

    history = {
        "time_hr": [], "swe": [], "depth": [], "rho_bulk": [],
        "t_surf": [], "t_layer": [[], [], []], "thick_layer": [[], [], []],
        "rho_layer": [[], [], []], "cum_precip": [], "cum_runoff": [],
        "cum_melt": [], "cum_refreeze": []
    }

    cum_precip = 0.0
    cum_runoff = 0.0
    cum_melt = 0.0
    cum_refreeze = 0.0
    day_melt = 0.0
    day_refreeze = 0.0
    day_runoff = 0.0

    for hr in range(n_hours):
        row = forcing.iloc[hr]
        t_air = float(row["t_air_K"])
        snowfall = float(row["snowfall_mm_hr"])
        rainfall = float(row["rainfall_mm_hr"])
        sw_in = float(row["sw_in_wm2"])
        lw_in = float(row["lw_in_wm2"])

        precip = snowfall + rainfall
        cum_precip += precip

        if snowfall > 0.0:
            d_thick = snowfall / rho_fresh
            thickness[0] += d_thick
            c_old = c_ice * ice_mm[0] + c_liq * liq_mm[0]
            c_new = c_ice * snowfall
            t_new = min(t_air, T_f)
            temp_K[0] = (c_old * temp_K[0] + c_new * t_new) / (c_old + c_new)
            ice_mm[0] += snowfall
            density[0] = (ice_mm[0] + liq_mm[0]) / thickness[0]

        if rainfall > 0.0:
            c_old = c_ice * ice_mm[0] + c_liq * liq_mm[0]
            c_new = c_liq * rainfall
            t_new = max(t_air, T_f)
            temp_K[0] = (c_old * temp_K[0] + c_new * t_new) / (c_old + c_new)
            liq_mm[0] += rainfall
            density[0] = (ice_mm[0] + liq_mm[0]) / thickness[0]

        k = 2.223 * ((density / 1000.0) ** 1.88)
        k = np.clip(k, 0.05, 1.5)

        k_surf = 2.0 * k[0] / thickness[0]
        K01 = 2.0 * k[0] * k[1] / (thickness[0] * k[1] + thickness[1] * k[0])
        K12 = 2.0 * k[1] * k[2] / (thickness[1] * k[2] + thickness[2] * k[1])

        t_ref = t_air
        h_rad = 4.0 * eps * sigma * (t_ref ** 3)
        H = h_turb + h_rad
        Q0 = (1.0 - alpha) * sw_in + eps * lw_in - eps * sigma * (t_ref ** 4) + h_rad * t_ref + h_turb * t_air

        ts = (Q0 + k_surf * temp_K[0]) / (H + k_surf)
        if ts > T_f:
            ts = T_f
            Fin = (1.0 - alpha) * sw_in + eps * lw_in - eps * sigma * (T_f ** 4) + h_turb * (t_air - T_f)
            dFin_dT0 = 0.0
        else:
            Fin = (k_surf / (H + k_surf)) * (Q0 - H * temp_K[0])
            dFin_dT0 = - (k_surf * H) / (H + k_surf)

        C = c_ice * ice_mm + c_liq * liq_mm
        C = np.maximum(C, 1.0)

        A = np.zeros((3, 3), dtype=np.float64)
        B = np.zeros(3, dtype=np.float64)

        A[0, 0] = C[0] / dt - dFin_dT0 + K01
        A[0, 1] = -K01
        B[0] = (C[0] / dt) * temp_K[0] + Fin - dFin_dT0 * temp_K[0]

        A[1, 0] = -K01
        A[1, 1] = C[1] / dt + K01 + K12
        A[1, 2] = -K12
        B[1] = (C[1] / dt) * temp_K[1]

        A[2, 1] = -K12
        A[2, 2] = C[2] / dt + K12
        B[2] = (C[2] / dt) * temp_K[2]

        temp_K = np.linalg.solve(A, B)

        step_melt = step_refreeze = 0.0
        for i in range(3):
            if temp_K[i] > T_f:
                excess_energy = C[i] * (temp_K[i] - T_f)
                melt_potential = excess_energy / L_f
                melt_act = min(ice_mm[i], melt_potential)
                ice_mm[i] -= melt_act
                liq_mm[i] += melt_act
                step_melt += melt_act
                thickness[i] = max(0.01, thickness[i] - melt_act / max(density[i], 200.0))
                if ice_mm[i] > 0.0:
                    temp_K[i] = T_f
                else:
                    rem_energy = excess_energy - melt_act * L_f
                    temp_K[i] = T_f + rem_energy / max(C[i], 1.0)
            elif temp_K[i] < T_f and liq_mm[i] > 0.0:
                cold_content = C[i] * (T_f - temp_K[i])
                freeze_potential = cold_content / L_f
                freeze_act = min(liq_mm[i], freeze_potential)
                ice_mm[i] += freeze_act
                liq_mm[i] -= freeze_act
                step_refreeze += freeze_act
                temp_K[i] += freeze_act * L_f / C[i]
                temp_K[i] = min(temp_K[i], T_f)

        cum_melt += step_melt
        cum_refreeze += step_refreeze
        day_melt += step_melt
        day_refreeze += step_refreeze

        step_runoff = 0.0
        for i in range(3):
            w_cap = S_max * ice_mm[i]
            if liq_mm[i] > w_cap:
                drain = liq_mm[i] - w_cap
                liq_mm[i] = w_cap
                if i < 2:
                    liq_mm[i + 1] += drain
                else:
                    step_runoff += drain

        cum_runoff += step_runoff
        day_runoff += step_runoff

        for i in range(3):
            f_settle = 1.0 if density[i] <= 150.0 else np.exp(-c5 * (density[i] - 150.0))
            rate_destruct = (c1 / 3600.0) * np.exp(-c2 * max(0.0, T_f - temp_K[i])) * f_settle

            load_mass = 0.0
            for j in range(i):
                load_mass += ice_mm[j] + liq_mm[j]
            load_mass += 0.5 * (ice_mm[i] + liq_mm[i])
            P_load = load_mass * g

            visc = eta0 * np.exp(a_rho * density[i]) * np.exp(b_T * max(0.0, T_f - temp_K[i]))
            if liq_mm[i] > 0.0:
                visc /= (1.0 + 10.0 * (liq_mm[i] / max(1e-3, ice_mm[i] + liq_mm[i])))
            rate_overburden = P_load / visc

            strain_rate = rate_destruct + rate_overburden
            thickness[i] *= max(0.01, 1.0 - strain_rate * dt)

            tot_mass = ice_mm[i] + liq_mm[i]
            if tot_mass > 0.0:
                if tot_mass / thickness[i] > 900.0:
                    thickness[i] = tot_mass / 900.0
                density[i] = tot_mass / thickness[i]

        current_swe = float(np.sum(ice_mm + liq_mm))
        current_depth = float(np.sum(thickness))
        bulk_density = current_swe / current_depth

        history["time_hr"].append(hr + 1)
        history["swe"].append(current_swe)
        history["depth"].append(current_depth)
        history["rho_bulk"].append(bulk_density)
        history["t_surf"].append(ts)
        for i in range(3):
            history["t_layer"][i].append(temp_K[i])
            history["thick_layer"][i].append(thickness[i])
            history["rho_layer"][i].append(density[i])
        history["cum_precip"].append(cum_precip)
        history["cum_runoff"].append(cum_runoff)
        history["cum_melt"].append(cum_melt)
        history["cum_refreeze"].append(cum_refreeze)

        if (hr + 1) % 24 == 0:
            day_idx = hr // 24
            for i in range(3):
                snow_state[day_idx, i, 0] = thickness[i]
                snow_state[day_idx, i, 1] = density[i]
                snow_state[day_idx, i, 2] = ice_mm[i]
                snow_state[day_idx, i, 3] = liq_mm[i]
                snow_state[day_idx, i, 4] = temp_K[i]

            summary_records.append({
                "day": int(day_idx),
                "swe_mm": float(current_swe),
                "snow_depth_m": float(current_depth),
                "melt_mm": float(day_melt),
                "refreeze_mm": float(day_refreeze),
                "runoff_mm": float(day_runoff),
                "mean_density_kg_m3": float(bulk_density)
            })
            day_melt = day_refreeze = day_runoff = 0.0

    state_path = os.path.join(output_dir, "snow_state.npy")
    np.save(state_path, snow_state)
    print(f"Saved snow state array to {state_path} with shape {snow_state.shape}")

    summary_df = pd.DataFrame(summary_records)
    summary_path = os.path.join(output_dir, "snow_summary.csv")
    summary_df.to_csv(summary_path, index=False)
    print(f"Saved daily summary to {summary_path} with {len(summary_df)} rows")

    final_swe = float(np.sum(ice_mm + liq_mm))
    mass_in = init_swe + cum_precip
    mass_out = final_swe + cum_runoff
    imbalance = mass_out - mass_in
    print("=" * 60)
    print("WATER MASS CONSERVATION VERIFICATION:")
    print(f"  Initial SWE:            {init_swe:12.6f} mm")
    print(f"  Total Precipitation:    {cum_precip:12.6f} mm")
    print(f"  Total System Input:     {mass_in:12.6f} mm")
    print(f"  Final SWE:              {final_swe:12.6f} mm")
    print(f"  Total Bottom Runoff:    {cum_runoff:12.6f} mm")
    print(f"  Total System Output:    {mass_out:12.6f} mm")
    print(f"  Water Mass Imbalance:   {imbalance:12.6e} mm")
    print("=" * 60)

    fig_path = os.path.join(output_dir, "snow_evolution.png")
    time_days = np.array(history["time_hr"]) / 24.0

    if HAS_MPL:
        fig, axes = plt.subplots(3, 2, figsize=(14, 12), sharex=True)
        axes[0, 0].plot(time_days, history["swe"], label="SWE (mm)", color="navy", lw=2)
        axes[0, 0].plot(time_days, history["cum_precip"], label="Cum. Precip (mm)", color="deepskyblue", ls="--")
        axes[0, 0].plot(time_days, history["cum_runoff"], label="Cum. Runoff (mm)", color="darkorange", ls=":")
        axes[0, 0].set_ylabel("Water Mass (mm)")
        axes[0, 0].set_title("Snow Water Equivalent (SWE) and Water Balance")
        axes[0, 0].grid(True, alpha=0.3)
        axes[0, 0].legend(loc="upper left")

        axes[0, 1].plot(time_days, history["depth"], label="Total Depth (m)", color="black", lw=2)
        axes[0, 1].plot(time_days, history["thick_layer"][0], label="Layer 0 (Top)", color="tab:blue", ls="-.")
        axes[0, 1].plot(time_days, history["thick_layer"][1], label="Layer 1 (Middle)", color="tab:green", ls="-.")
        axes[0, 1].plot(time_days, history["thick_layer"][2], label="Layer 2 (Bottom)", color="tab:red", ls="-.")
        axes[0, 1].set_ylabel("Thickness (m)")
        axes[0, 1].set_title("Snowpack Thickness and Compaction")
        axes[0, 1].grid(True, alpha=0.3)
        axes[0, 1].legend(loc="upper right")

        axes[1, 0].plot(time_days, history["rho_bulk"], label="Bulk Mean Density", color="black", lw=2)
        axes[1, 0].plot(time_days, history["rho_layer"][0], label="Layer 0 Density", color="tab:blue")
        axes[1, 0].plot(time_days, history["rho_layer"][1], label="Layer 1 Density", color="tab:green")
        axes[1, 0].plot(time_days, history["rho_layer"][2], label="Layer 2 Density", color="tab:red")
        axes[1, 0].set_ylabel("Density (kg/m$^3$)")
        axes[1, 0].set_title("Snow Density Evolution")
        axes[1, 0].grid(True, alpha=0.3)
        axes[1, 0].legend(loc="lower right")

        axes[1, 1].plot(time_days, forcing["t_air_K"], label="Air Temp", color="gray", alpha=0.4, lw=0.8)
        axes[1, 1].plot(time_days, history["t_layer"][0], label="Layer 0 Temp", color="tab:blue")
        axes[1, 1].plot(time_days, history["t_layer"][1], label="Layer 1 Temp", color="tab:green")
        axes[1, 1].plot(time_days, history["t_layer"][2], label="Layer 2 Temp", color="tab:red")
        axes[1, 1].axhline(273.15, color="red", ls="--", alpha=0.7, label="0 °C Melting Point")
        axes[1, 1].set_ylabel("Temperature (K)")
        axes[1, 1].set_title("Thermal Dynamics")
        axes[1, 1].grid(True, alpha=0.3)
        axes[1, 1].legend(loc="lower right")

        days = summary_df["day"].values
        axes[2, 0].bar(days - 0.25, summary_df["melt_mm"], width=0.25, label="Daily Melt (mm)", color="salmon")
        axes[2, 0].bar(days, summary_df["refreeze_mm"], width=0.25, label="Daily Refreeze (mm)", color="cornflowerblue")
        axes[2, 0].bar(days + 0.25, summary_df["runoff_mm"], width=0.25, label="Daily Runoff (mm)", color="orange")
        axes[2, 0].set_xlabel("Time (days)")
        axes[2, 0].set_ylabel("Daily Flux (mm/day)")
        axes[2, 0].set_title("Phase Change and Runoff Fluxes")
        axes[2, 0].grid(True, alpha=0.3)
        axes[2, 0].legend(loc="upper right")

        swe_arr = np.array(history["swe"])
        cum_runoff_arr = np.array(history["cum_runoff"])
        cum_precip_arr = np.array(history["cum_precip"])
        mass_err = (swe_arr + cum_runoff_arr) - (init_swe + cum_precip_arr)
        axes[2, 1].plot(time_days, mass_err, label="Mass Balance Residual (mm)", color="purple", lw=1.5)
        axes[2, 1].set_xlabel("Time (days)")
        axes[2, 1].set_ylabel("Error (mm)")
        axes[2, 1].set_title("Mass Conservation Residual (SWE + Runoff - Input)")
        axes[2, 1].set_ylim(-1e-12, 1e-12)
        axes[2, 1].grid(True, alpha=0.3)
        axes[2, 1].legend(loc="upper left")

        plt.tight_layout()
        plt.savefig(fig_path, dpi=200)
        plt.close()
    else:
        img = Image.new("RGB", (1400, 1050), color=(255, 255, 255))
        draw = ImageDraw.Draw(img)

        def draw_subplot(bbox, x_data, y_series, title, xlabel, ylabel, ylim=None):
            x0, y0, x1, y1 = bbox
            draw.rectangle([x0, y0, x1, y1], fill=(248, 248, 248), outline=(200, 200, 200), width=1)
            px0, py0, px1, py1 = x0 + 70, y0 + 35, x1 - 25, y1 - 40
            draw.rectangle([px0, py0, px1, py1], fill=(255, 255, 255), outline=(150, 150, 150), width=1)
            draw.text((x0 + 70, y0 + 12), title, fill=(0, 0, 0))
            draw.text((x0 + 8, py0 + (py1 - py0) // 2 - 10), ylabel, fill=(0, 0, 0))
            draw.text((px0 + (px1 - px0) // 2 - 20, py1 + 18), xlabel, fill=(0, 0, 0))

            xmin, xmax = float(np.min(x_data)), float(np.max(x_data))
            if xmax == xmin: xmax += 1.0

            if ylim is None:
                all_y = [v for _, y_vals, _ in y_series for v in y_vals]
                ymin, ymax = float(np.min(all_y)), float(np.max(all_y))
                if ymax == ymin: ymax += 1.0
                pad = 0.05 * (ymax - ymin)
                ymin, ymax = ymin - pad, ymax + pad
            else:
                ymin, ymax = ylim

            for frac in [0.0, 0.25, 0.5, 0.75, 1.0]:
                gy = py1 - frac * (py1 - py0)
                draw.line([(px0, gy), (px1, gy)], fill=(230, 230, 230), width=1)
                val = ymin + frac * (ymax - ymin)
                draw.text((x0 + 15, gy - 6), f"{val:.1f}", fill=(80, 80, 80))

                gx = px0 + frac * (px1 - px0)
                draw.line([(gx, py0), (gx, py1)], fill=(230, 230, 230), width=1)
                xval = xmin + frac * (xmax - xmin)
                draw.text((gx - 8, py1 + 4), f"{xval:.0f}", fill=(80, 80, 80))

            leg_x, leg_y = px0 + 10, py0 + 8
            for name, y_vals, color in y_series:
                pts = []
                for x, y in zip(x_data, y_vals):
                    sx = px0 + (x - xmin) / (xmax - xmin) * (px1 - px0)
                    sy = py1 - (y - ymin) / (ymax - ymin) * (py1 - py0)
                    pts.append((sx, sy))
                if len(pts) > 1:
                    draw.line(pts, fill=color, width=2)
                draw.line([(leg_x, leg_y + 5), (leg_x + 15, leg_y + 5)], fill=color, width=2)
                draw.text((leg_x + 20, leg_y), name, fill=(0, 0, 0))
                leg_x += len(name) * 7 + 35

        draw_subplot((20, 20, 680, 340), time_days,
                     [("SWE (mm)", history["swe"], (0, 0, 160)),
                      ("Cum. Precip", history["cum_precip"], (0, 120, 220)),
                      ("Cum. Runoff", history["cum_runoff"], (200, 100, 0))],
                     "Snow Water Equivalent (SWE) and Water Balance", "Time (days)", "Water (mm)")

        draw_subplot((710, 20, 1370, 340), time_days,
                     [("Total Depth (m)", history["depth"], (0, 0, 0)),
                      ("Layer 0 (Top)", history["thick_layer"][0], (30, 100, 200)),
                      ("Layer 1 (Mid)", history["thick_layer"][1], (30, 150, 50)),
                      ("Layer 2 (Bot)", history["thick_layer"][2], (200, 50, 50))],
                     "Snowpack Thickness and Compaction", "Time (days)", "Depth (m)")

        draw_subplot((20, 360, 680, 680), time_days,
                     [("Bulk Density", history["rho_bulk"], (0, 0, 0)),
                      ("Layer 0", history["rho_layer"][0], (30, 100, 200)),
                      ("Layer 1", history["rho_layer"][1], (30, 150, 50)),
                      ("Layer 2", history["rho_layer"][2], (200, 50, 50))],
                     "Snow Density Evolution (kg/m^3)", "Time (days)", "Density (kg/m3)")

        draw_subplot((710, 360, 1370, 680), time_days,
                     [("T_air", list(forcing["t_air_K"]), (140, 140, 140)),
                      ("Layer 0", history["t_layer"][0], (30, 100, 200)),
                      ("Layer 1", history["t_layer"][1], (30, 150, 50)),
                      ("Layer 2", history["t_layer"][2], (200, 50, 50))],
                     "Thermal Dynamics (K)", "Time (days)", "Temperature (K)")

        days = summary_df["day"].values
        draw_subplot((20, 700, 680, 1020), days,
                     [("Melt", summary_df["melt_mm"].values, (220, 50, 50)),
                      ("Refreeze", summary_df["refreeze_mm"].values, (50, 100, 220)),
                      ("Runoff", summary_df["runoff_mm"].values, (220, 140, 0))],
                     "Phase Change and Runoff Daily Fluxes", "Time (days)", "Flux (mm/day)")

        swe_arr = np.array(history["swe"])
        cum_runoff_arr = np.array(history["cum_runoff"])
        cum_precip_arr = np.array(history["cum_precip"])
        mass_err = (swe_arr + cum_runoff_arr) - (init_swe + cum_precip_arr)
        draw_subplot((710, 700, 1370, 1020), time_days,
                     [("Residual Error (mm)", list(mass_err), (120, 0, 180))],
                     "Mass Conservation Residual (SWE + Runoff - Precip)", "Time (days)", "Residual (mm)",
                     ylim=(-1e-12, 1e-12))

        img.save(fig_path)

    print(f"Saved diagnostic figure to {fig_path}")
    return summary_df, snow_state

if __name__ == "__main__":
    run_snowpack_simulation()
