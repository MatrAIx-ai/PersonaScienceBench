import numpy as np
import pandas as pd
import statsmodels.api as sm
from statsmodels.miscmodels.ordinal_model import OrderedModel

def main():
    # 1. Load datasets
    dm = pd.read_csv('data/TASK008_BCG-CORONA_DM.csv')
    ae = pd.read_csv('data/TASK008_BCG-CORONA_AE.csv')
    mh = pd.read_csv('data/TASK008_BCG-CORONA_MH.csv')

    print("=== DATA LOADED ===")
    print(f"DM records: {len(dm)}, Unique USUBJID: {dm['USUBJID'].nunique()}")
    print(f"AE records: {len(ae)}, Unique USUBJID: {ae['USUBJID'].nunique()}")
    print(f"MH records: {len(mh)}, Unique USUBJID: {mh['USUBJID'].nunique()}")

    # 2. Identify COVID-19 cases in AE
    covid_pts = ['COVID-19', 'COVID-19 pneumonia', 'Asymptomatic COVID-19', 'SARS-CoV-2 test positive']
    ae_covid = ae[ae['AEPT'].isin(covid_pts)].copy()
    print(f"\nCOVID AE records: {len(ae_covid)}, unique subjects: {ae_covid['USUBJID'].nunique()}")

    # Aggregate max AEHS per subject
    covid_agg = ae_covid.groupby('USUBJID').agg(
        max_AEHS=('AEHS', 'max'),
        max_AESEV=('AESEV', 'max'),
        n_covid_events=('AEHS', 'count')
    ).reset_index()

    # 3. Medical history (MHSCAT == 'MEDICAL HISTORY', MHORRES == 2.0 indicates condition presence)
    mh_med = mh[mh['MHSCAT'] == 'MEDICAL HISTORY']
    subj_with_mh = set(mh_med[mh_med['MHORRES'] == 2.0]['USUBJID'].unique())
    print(f"Subjects with prior medical history (overall): {len(subj_with_mh)} / {dm['USUBJID'].nunique()}")

    # 4. Merge analysis dataset
    df = dm.copy()
    df['prior_mh'] = df['USUBJID'].isin(subj_with_mh).astype(int)
    df['bcg'] = (df['TRTGRP'] == 'BCG').astype(int)
    df = df.merge(covid_agg, on='USUBJID', how='inner')  # Inner join for primary COVID-19 cohort

    print(f"\nPrimary COVID cohort size: {len(df)}")
    print("Outcome max_AEHS distribution:")
    print(df['max_AEHS'].value_counts().sort_index())

    # Interaction term
    df['bcg_x_prior_mh'] = df['bcg'] * df['prior_mh']

    # Patient interaction frequency dummy encoding (reference: 1-50)
    # Ensure standard order
    categories = ['1-50', '51-100', '>100']
    df['patients_seen'] = pd.Categorical(df['patients_seen'], categories=categories)
    ps_dummies = pd.get_dummies(df['patients_seen'], prefix='patients_seen', drop_first=True, dtype=int)
    dummy_cols = ps_dummies.columns.tolist()
    df = pd.concat([df, ps_dummies], axis=1)

    feature_cols = ['bcg', 'prior_mh', 'bcg_x_prior_mh'] + dummy_cols
    X = df[feature_cols]
    y = df['max_AEHS']

    print("\nPredictor matrix head:")
    print(X.head())

    # 5. Fit Primary Ordinal Logistic Regression Model
    print("\n--- Fitting Primary Ordinal Logistic Regression Model (distr='logit', method='bfgs') ---")
    mod = OrderedModel(y, X, distr='logit')
    res = mod.fit(method='bfgs', disp=False)

    print(res.summary())

    # Extract interaction parameters
    inter_coef = res.params['bcg_x_prior_mh']
    inter_se = res.bse['bcg_x_prior_mh']
    inter_pval = res.pvalues['bcg_x_prior_mh']
    inter_ci_lower = res.conf_int().loc['bcg_x_prior_mh', 0]
    inter_ci_upper = res.conf_int().loc['bcg_x_prior_mh', 1]

    inter_or = np.exp(inter_coef)
    inter_or_ci_lower = np.exp(inter_ci_lower)
    inter_or_ci_upper = np.exp(inter_ci_upper)

    print("\n================ PRIMARY RESULTS ================")
    print(f"Sample size (N): {len(df)}")
    print(f"Convergence: {res.mle_retvals['converged']}")
    print(f"Log-Likelihood: {res.llf:.4f}")
    print(f"AIC: {res.aic:.4f}")
    print(f"Interaction coef (beta): {inter_coef:.4f}")
    print(f"Interaction SE: {inter_se:.4f}")
    print(f"Interaction p-value: {inter_pval:.4f}")
    print(f"Interaction OR: {inter_or:.4f}")
    print(f"95% CI for OR: [{inter_or_ci_lower:.4f}, {inter_or_ci_upper:.4f}]")
    print("=================================================")

    # 6. Sensitivity Analyses
    print("\n=== SENSITIVITY ANALYSIS 1: Collapsing rare categories (AEHS >= 4 collapsed to 4) ===")
    y_collapsed = y.clip(upper=4)
    mod_coll = OrderedModel(y_collapsed, X, distr='logit')
    res_coll = mod_coll.fit(method='bfgs', disp=False)
    coll_coef = res_coll.params['bcg_x_prior_mh']
    coll_pval = res_coll.pvalues['bcg_x_prior_mh']
    coll_ci = res_coll.conf_int().loc['bcg_x_prior_mh']
    print(f"Collapsed AEHS interaction OR: {np.exp(coll_coef):.4f} (95% CI: [{np.exp(coll_ci[0]):.4f}, {np.exp(coll_ci[1]):.4f}], p={coll_pval:.4f})")

    print("\n=== SENSITIVITY ANALYSIS 2: Full Cohort (N = 1000), non-infected = 0 ===")
    df_full = dm.copy()
    df_full['prior_mh'] = df_full['USUBJID'].isin(subj_with_mh).astype(int)
    df_full['bcg'] = (df_full['TRTGRP'] == 'BCG').astype(int)
    df_full = df_full.merge(covid_agg[['USUBJID', 'max_AEHS']], on='USUBJID', how='left')
    # Non-covid as 0; existing asymptomatic covid is also 0 or non-covid as a separate lowest category
    df_full['severity_full'] = df_full['max_AEHS'].fillna(0)
    df_full['bcg_x_prior_mh'] = df_full['bcg'] * df_full['prior_mh']
    ps_dummies_full = pd.get_dummies(pd.Categorical(df_full['patients_seen'], categories=categories), prefix='patients_seen', drop_first=True, dtype=int)
    X_full = pd.concat([df_full[['bcg', 'prior_mh', 'bcg_x_prior_mh']], ps_dummies_full], axis=1)
    mod_full = OrderedModel(df_full['severity_full'], X_full, distr='logit')
    res_full = mod_full.fit(method='bfgs', disp=False)
    full_coef = res_full.params['bcg_x_prior_mh']
    full_pval = res_full.pvalues['bcg_x_prior_mh']
    full_ci = res_full.conf_int().loc['bcg_x_prior_mh']
    print(f"Full cohort interaction OR: {np.exp(full_coef):.4f} (95% CI: [{np.exp(full_ci[0]):.4f}, {np.exp(full_ci[1]):.4f}], p={full_pval:.4f})")

    print("\n=== SENSITIVITY ANALYSIS 3: Ordinal patients_seen (1, 2, 3) ===")
    ps_map = {'1-50': 1, '51-100': 2, '>100': 3}
    X_ord = df[['bcg', 'prior_mh', 'bcg_x_prior_mh']].copy()
    X_ord['patients_seen_num'] = df['patients_seen'].map(ps_map)
    mod_ord = OrderedModel(y, X_ord, distr='logit')
    res_ord = mod_ord.fit(method='bfgs', disp=False)
    ord_coef = res_ord.params['bcg_x_prior_mh']
    ord_pval = res_ord.pvalues['bcg_x_prior_mh']
    ord_ci = res_ord.conf_int().loc['bcg_x_prior_mh']
    print(f"Continuous/ordinal patients_seen interaction OR: {np.exp(ord_coef):.4f} (95% CI: [{np.exp(ord_ci[0]):.4f}, {np.exp(ord_ci[1]):.4f}], p={ord_pval:.4f})")

if __name__ == '__main__':
    main()
