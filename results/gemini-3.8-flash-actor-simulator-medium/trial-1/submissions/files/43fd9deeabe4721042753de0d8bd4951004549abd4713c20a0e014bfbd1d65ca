import os
import pandas as pd
import numpy as np
import statsmodels.formula.api as smf

def run_analysis():
    df = pd.read_csv('data/nls_incarceration_processed.csv')
    
    # Filter for black individuals
    black = df[df['race'] == 'black'].copy()
    
    # Stratify by 1985 baseline wealth into terciles (low, mid, high)
    black['tercile'] = pd.qcut(black['composite_wealth_1985'], q=3, labels=['low', 'mid', 'high'], duplicates='drop')
    black['delta_wealth'] = black['composite_wealth_1996'] - black['composite_wealth_1985']
    
    # Summary by stratum and incarceration status
    summary = black.groupby(['tercile', 'ever_jailed'], observed=False).agg(
        n=('composite_wealth_1996', 'count'),
        mean_wealth_1996=('composite_wealth_1996', 'mean'),
        median_wealth_1996=('composite_wealth_1996', 'median'),
        mean_delta=('delta_wealth', 'mean'),
        median_delta=('delta_wealth', 'median')
    ).reset_index()
    
    # OLS regression with interaction
    ols_res = smf.ols('composite_wealth_1996 ~ ever_jailed * C(tercile) + C(sex)', data=black).fit(cov_type='HC1')
    
    # Median regression
    q_res = smf.quantreg('composite_wealth_1996 ~ ever_jailed * C(tercile)', data=black).fit(q=0.5)
    
    # Save results to csv
    os.makedirs('outputs', exist_ok=True)
    summary.to_csv('outputs/strata_summary.csv', index=False)
    
    with open('outputs/regression_results.txt', 'w') as f:
        f.write("=== OLS Regression with HC1 Robust Standard Errors ===\n")
        f.write(str(ols_res.summary()) + "\n\n")
        f.write("=== Median (Quantile) Regression ===\n")
        f.write(str(q_res.summary()) + "\n")
        
    print("Analysis complete. Summary table:")
    print(summary)

if __name__ == '__main__':
    run_analysis()
