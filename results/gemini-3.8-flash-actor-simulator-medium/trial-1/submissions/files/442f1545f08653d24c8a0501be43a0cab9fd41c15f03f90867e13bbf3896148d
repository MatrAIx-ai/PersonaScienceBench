"""
Analysis script for evaluating Pearson correlation coefficient
between gene length and gene expression for protein-coding genes.
"""

import pandas as pd
import numpy as np
from scipy import stats

def main():
    # 1. Load gene metadata
    meta_path = "data/GeneMetaInfo_Zenodo.csv"
    meta_df = pd.read_csv(meta_path, index_col=0)
    
    # Filter for protein-coding genes
    pc_genes = meta_df[meta_df["gene_biotype"] == "protein_coding"]
    n_pc = len(pc_genes)
    print(f"Number of protein-coding genes: {n_pc}")
    
    # 2. Load batch-corrected read counts
    counts_path = "data/BatchCorrectedReadCounts_Zenodo.csv"
    counts_df = pd.read_csv(counts_path, index_col=0)
    print(f"Counts matrix dimensions: {counts_df.shape}")
    
    # 3. Align protein-coding genes with counts matrix
    common_genes = pc_genes.index.intersection(counts_df.index)
    pc_genes_subset = pc_genes.loc[common_genes]
    counts_subset = counts_df.loc[common_genes]
    
    # Gene lengths and mean expression across all 723 samples
    gene_lengths = pc_genes_subset["Length"]
    mean_expression = counts_subset.mean(axis=1)
    
    # 4. Calculate Pearson correlation coefficient
    pearson_r, p_value = stats.pearsonr(gene_lengths, mean_expression)
    
    print("\n--- Correlation Results ---")
    print(f"Pearson correlation coefficient (r): {pearson_r:.6f}")
    print(f"p-value: {p_value:.6e}")
    
    # Log2-transformed expression correlation as secondary reference
    log2_mean_expression = np.log2(mean_expression + 1)
    r_log2, p_log2 = stats.pearsonr(gene_lengths, log2_mean_expression)
    print(f"Pearson r (log2(count + 1)): {r_log2:.6f} (p = {p_log2:.6e})")
    
    # Summary stats
    print("\n--- Descriptive Statistics ---")
    print("Gene Length Summary:")
    print(gene_lengths.describe())
    print("\nMean Gene Expression Summary:")
    print(mean_expression.describe())
    
    return pearson_r, p_value

if __name__ == "__main__":
    main()
