import pandas as pd
import numpy as np

def main():
    excel_path = 'data/Data_deposition_RNAseq_Paroxetine_2017.xlsx'
    print("Loading NormCount sheet...")
    # Row 3 contains the column headers for DESeq blocks and samples
    df = pd.read_excel(excel_path, sheet_name='NormCount', header=3)
    
    comparisons = {
        'baseline_blood': {'idx': 2, 'start_col': 107},
        'dentate_gyrus': {'idx': 5, 'start_col': 134},
        'final_blood': {'idx': 8, 'start_col': 161}
    }
    
    results = []
    
    for tissue, info in comparisons.items():
        sc = info['start_col']
        gene_ids = df['GeneID']
        bm = pd.to_numeric(df.iloc[:, sc], errors='coerce')
        bma = pd.to_numeric(df.iloc[:, sc+1], errors='coerce')
        bmb = pd.to_numeric(df.iloc[:, sc+2], errors='coerce')
        fc = pd.to_numeric(df.iloc[:, sc+3], errors='coerce')
        lfc = pd.to_numeric(df.iloc[:, sc+4], errors='coerce')
        pval = pd.to_numeric(df.iloc[:, sc+5], errors='coerce')
        padj = pd.to_numeric(df.iloc[:, sc+6], errors='coerce')
        deg_max = df.iloc[:, sc+7]
        deg_med = df.iloc[:, sc+8]
        
        # Criteria variants:
        # Standard: padj < 0.05 & abs(lfc) > 0.5 & bm > 10
        c_std_abs = (padj < 0.05) & (lfc.abs() > 0.5) & (bm > 10)
        # Standard directional: padj < 0.05 & lfc > 0.5 & bm > 10
        c_std_pos = (padj < 0.05) & (lfc > 0.5) & (bm > 10)
        
        # Relaxed padj < 0.10
        c_padj10_abs = (padj < 0.10) & (lfc.abs() > 0.5) & (bm > 10)
        c_padj10_pos = (padj < 0.10) & (lfc > 0.5) & (bm > 10)
        
        # Nominal pval < 0.05
        c_pval05_abs = (pval < 0.05) & (lfc.abs() > 0.5) & (bm > 10)
        c_pval05_pos = (pval < 0.05) & (lfc > 0.5) & (bm > 10)
        
        # Pre-annotated DEG flags with bm > 10
        c_deg_max = (deg_max.isin(['U', 'D'])) & (bm > 10)
        c_deg_med = (deg_med.isin(['U', 'D'])) & (bm > 10)
        
        # Raw DEG counts
        deg_max_total = deg_max.isin(['U', 'D']).sum()
        deg_med_total = deg_med.isin(['U', 'D']).sum()
        
        results.append({
            'tissue': tissue,
            'comparison': f"Comparison {info['idx']}",
            'padj<0.05 & |lfc|>0.5 & bm>10': c_std_abs.sum(),
            'padj<0.05 & lfc>0.5 & bm>10': c_std_pos.sum(),
            'padj<0.10 & |lfc|>0.5 & bm>10': c_padj10_abs.sum(),
            'padj<0.10 & lfc>0.5 & bm>10': c_padj10_pos.sum(),
            'pval<0.05 & |lfc|>0.5 & bm>10': c_pval05_abs.sum(),
            'pval<0.05 & lfc>0.5 & bm>10': c_pval05_pos.sum(),
            'author_deg_max & bm>10': c_deg_max.sum(),
            'author_deg_med & bm>10': c_deg_med.sum(),
            'author_deg_max_total': deg_max_total,
            'author_deg_med_total': deg_med_total,
        })
        
    res_df = pd.DataFrame(results)
    print("\n--- DEG Summary Table across Tissues (Bad Responders vs Controls) ---")
    print(res_df.to_string(index=False))
    
    # Identify the highest tissue across all criteria
    print("\nRanking check:")
    for col in res_df.columns[2:]:
        max_tissue = res_df.loc[res_df[col].idxmax(), 'tissue']
        max_val = res_df[col].max()
        print(f"Criterion [{col}]: Highest is {max_tissue} ({max_val})")

if __name__ == '__main__':
    main()
