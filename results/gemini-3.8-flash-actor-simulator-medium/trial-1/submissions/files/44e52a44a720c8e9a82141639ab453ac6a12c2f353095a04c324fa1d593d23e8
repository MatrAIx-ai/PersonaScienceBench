import pandas as pd
import numpy as np

# Load dataset
df = pd.read_csv('data/requirements_engineering_for_ML-enabled_systems.csv')

# Exclude negative values (-77 indicates not answered / survey routing)
q10_cols = [c for c in df.columns if c.startswith('Q10_ML_Documentation_') and not c.endswith('_Free')]

# Valid respondents who completed Q10 (excluding routing -77)
valid_df = df[df['Q10_ML_Documentation_BDD_Scenarios'] != '-77'].copy()
n_valid = len(valid_df)
n_total = len(df)

print(f"Total survey respondents: {n_total}")
print(f"Valid respondents answering Q10 (excluding -77): {n_valid}")

results = []
for col in q10_cols:
    name = col.replace('Q10_ML_Documentation_', '')
    cnt = (valid_df[col] == 'quoted').sum()
    pct_valid = cnt / n_valid * 100
    pct_total = cnt / n_total * 100
    results.append({
        'Format': name,
        'Count': cnt,
        'Pct_Valid_N194': pct_valid,
        'Pct_Total_N276': pct_total
    })

res_df = pd.DataFrame(results).sort_values(by='Count')
print("\nDocumentation Formats usage breakdown:")
print(res_df.to_string(index=False))

# Bootstrapping analysis (10,000 iterations)
np.random.seed(42)
B = 10000
boot_results = []

for col in q10_cols:
    name = col.replace('Q10_ML_Documentation_', '')
    binary_valid = (valid_df[col] == 'quoted').astype(int).values
    binary_total = (df[col] == 'quoted').astype(int).values
    
    boot_means_valid = [np.random.choice(binary_valid, size=len(binary_valid), replace=True).mean() * 100 for _ in range(B)]
    boot_means_total = [np.random.choice(binary_total, size=len(binary_total), replace=True).mean() * 100 for _ in range(B)]
    
    ci_valid = np.percentile(boot_means_valid, [2.5, 97.5])
    ci_total = np.percentile(boot_means_total, [2.5, 97.5])
    
    boot_results.append({
        'Format': name,
        'Mean_Valid': np.mean(boot_means_valid),
        'CI_Valid_2.5': ci_valid[0],
        'CI_Valid_97.5': ci_valid[1],
        'Mean_Total': np.mean(boot_means_total),
        'CI_Total_2.5': ci_total[0],
        'CI_Total_97.5': ci_total[1]
    })

boot_df = pd.DataFrame(boot_results).sort_values(by='Mean_Valid')
print("\nBootstrapped estimates:")
print(boot_df.to_string(index=False))
