import pandas as pd
import numpy as np

# Load capital data
df = pd.read_csv('data/capital.csv')
cap_cols = ['ZAxtSchwert', 'ZDolch', 'Zhausgr', 'ZCU_AU', 'Zamber', 'ZMonument', 'ZHort', 'ZSichel', 'ZBeil', 'ZMW', 'ZKeform', 'Zkeverz']
for col in cap_cols:
    df[col] = df[col].astype(str).str.replace(',', '.').astype(float)

# Categories based on study context
categories = {
    'Symbolic': ['ZAxtSchwert', 'ZDolch', 'Zhausgr'],
    'Social': ['ZCU_AU', 'Zamber', 'ZMonument'],
    'Cultural': ['ZKeform', 'Zkeverz'],
    'Economic': ['ZHort', 'ZSichel', 'ZBeil', 'ZMW']
}

X = df[cap_cols].to_numpy(dtype=float)
X_mean = np.mean(X, axis=0)
X_centered = X - X_mean

# PCA via SVD / Covariance
cov = np.cov(X_centered, rowvar=False)
eigvals, eigvecs = np.linalg.eigh(cov)
idx = np.argsort(eigvals)[::-1]
eigvals = eigvals[idx]
eigvecs = eigvecs[:, idx]

var_ratio = eigvals / np.sum(eigvals)
loadings = eigvecs[:, 0]

# Standard convention: loadings aligned with Neolithic forms (positive Pottery Form, Axes, Amber)
if loadings[cap_cols.index('ZKeform')] < 0:
    loadings = -loadings

scores = X_centered @ loadings
df['PC1'] = scores

print(f"PC1 Explained Variance: {var_ratio[0]:.4f}")
print("\n--- PC1 Loadings ---")
for col in cap_cols:
    cat = [k for k, v in categories.items() if col in v][0]
    print(f"{col:15s} ({cat:8s}): {loadings[cap_cols.index(col)]:8.4f}")

print("\n--- Middle Neolithic (3400-3000 BCE) ---")
mn = df[df['group'] == 'MN']
print(mn[['BCE', 'PC1']])
print(f"MN Mean: {mn['PC1'].mean():.4f}, Range: [{mn['PC1'].min():.4f}, {mn['PC1'].max():.4f}]")

print("\n--- Younger Neolithic (2900-2300 BCE) ---")
sg = df[df['group'] == 'SG']
print(sg[['BCE', 'PC1']])
print(f"SG Mean: {sg['PC1'].mean():.4f}, Range: [{sg['PC1'].min():.4f}, {sg['PC1'].max():.4f}]")
