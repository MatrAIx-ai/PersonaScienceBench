import pandas as pd
import numpy as np

# Load data
df = pd.read_csv('data/nls_incarceration_processed.csv')

# Filter for black females
bf = df[(df['race'] == 'black') & (df['sex'] == 'female')].copy()

n_total = len(bf)
n_never_jailed = (bf['ever_jailed'] == 0).sum()
n_ever_jailed = (bf['ever_jailed'] == 1).sum()

# Medians
m85 = bf['composite_wealth_1985'].median()
m90 = bf['composite_wealth_1990'].median()
m96 = bf['composite_wealth_1996'].median()

# Increments
inc_85_90 = m90 - m85
inc_90_96 = m96 - m90
inc_85_96 = m96 - m85

# Annualized
ann_85_90 = inc_85_90 / 5.0
ann_90_96 = inc_90_96 / 6.0

# Percentage
pct_85_90 = (inc_85_90 / m85) * 100.0
pct_90_96 = (inc_90_96 / m90) * 100.0

# Bootstrap analysis
np.random.seed(42)
B = 5000
boot_m85 = np.zeros(B)
boot_m90 = np.zeros(B)
boot_m96 = np.zeros(B)
boot_inc_85_90 = np.zeros(B)
boot_inc_90_96 = np.zeros(B)
boot_ann_85_90 = np.zeros(B)
boot_ann_90_96 = np.zeros(B)
boot_diff_inc = np.zeros(B)
boot_diff_ann = np.zeros(B)

for i in range(B):
    sample = bf.sample(frac=1.0, replace=True)
    m85_s = sample['composite_wealth_1985'].median()
    m90_s = sample['composite_wealth_1990'].median()
    m96_s = sample['composite_wealth_1996'].median()
    
    boot_m85[i] = m85_s
    boot_m90[i] = m90_s
    boot_m96[i] = m96_s
    
    d1 = m90_s - m85_s
    d2 = m96_s - m90_s
    
    boot_inc_85_90[i] = d1
    boot_inc_90_96[i] = d2
    boot_diff_inc[i] = d1 - d2
    
    a1 = d1 / 5.0
    a2 = d2 / 6.0
    boot_ann_85_90[i] = a1
    boot_ann_90_96[i] = a2
    boot_diff_ann[i] = a1 - a2

def ci_str(arr):
    low, high = np.percentile(arr, [2.5, 97.5])
    return f"[{low:.2f}, {high:.2f}]"

print("=== SUMMARY FOR BLACK FEMALES (N = {}) ===".format(n_total))
print(f"Median 1985: ${m85:.2f} 95% CI: {ci_str(boot_m85)}")
print(f"Median 1990: ${m90:.2f} 95% CI: {ci_str(boot_m90)}")
print(f"Median 1996: ${m96:.2f} 95% CI: {ci_str(boot_m96)}")
print()
print("=== PERIOD COMPARISONS ===")
print(f"1985-1990: Cumulative Increase = ${inc_85_90:.2f} (CI: {ci_str(boot_inc_85_90)}), Annualized = ${ann_85_90:.2f}/year (CI: {ci_str(boot_ann_85_90)}), Relative = {pct_85_90:.2f}%")
print(f"1990-1996: Cumulative Increase = ${inc_90_96:.2f} (CI: {ci_str(boot_inc_90_96)}), Annualized = ${ann_90_96:.2f}/year (CI: {ci_str(boot_ann_90_96)}), Relative = {pct_90_96:.2f}%")
print()
print(f"Difference in Cumulative Increase (1985-1990 minus 1990-1996): ${inc_85_90 - inc_90_96:.2f} (CI: {ci_str(boot_diff_inc)})")
print(f"P(Inc 1985-1990 > Inc 1990-1996) = {np.mean(boot_diff_inc > 0):.4f}")
print(f"Difference in Annualized Increase (1985-1990 minus 1990-1996): ${ann_85_90 - ann_90_96:.2f} (CI: {ci_str(boot_diff_ann)})")
print(f"P(Ann 1985-1990 > Ann 1990-1996) = {np.mean(boot_diff_ann > 0):.4f}")

# Subgroup by incarceration
print()
print("=== SUBGROUP: NEVER JAILED (N = {}) ===".format(n_never_jailed))
bf_nj = bf[bf['ever_jailed'] == 0]
m85_nj = bf_nj['composite_wealth_1985'].median()
m90_nj = bf_nj['composite_wealth_1990'].median()
m96_nj = bf_nj['composite_wealth_1996'].median()
print(f"Medians: 1985=${m85_nj:.2f}, 1990=${m90_nj:.2f}, 1996=${m96_nj:.2f}")
print(f"1985-1990: +${m90_nj - m85_nj:.2f} (+${(m90_nj - m85_nj)/5:.2f}/yr)")
print(f"1990-1996: +${m96_nj - m90_nj:.2f} (+${(m96_nj - m90_nj)/6:.2f}/yr)")

print()
print("=== SUBGROUP: EVER JAILED (N = {}) ===".format(n_ever_jailed))
bf_ej = bf[bf['ever_jailed'] == 1]
m85_ej = bf_ej['composite_wealth_1985'].median()
m90_ej = bf_ej['composite_wealth_1990'].median()
m96_ej = bf_ej['composite_wealth_1996'].median()
print(f"Medians: 1985=${m85_ej:.2f}, 1990=${m90_ej:.2f}, 1996=${m96_ej:.2f}")
