import pandas as pd
import numpy as np
from scipy import stats

def run_analysis():
    # Load dataset
    df1 = pd.read_csv('data/meta-regression_study_data_heterogeneity_in_replication_projects.csv')
    df2 = pd.read_csv('data/meta-regression_replication_success_data_heterogeneity_in_replication_projects.csv')

    # 1. RPP subset analysis
    rpp_all = df1[df1['project'] == 'rpp']
    rpp_clean = rpp_all[rpp_all['drop'] == False]

    # Replicated studies in RPP (replicated == 1.0)
    rep_all = rpp_all[rpp_all['replicated'] == 1.0]
    n_rep_all = len(rep_all)
    jp_rep_all = (rep_all['seniority.r'] == 'Assistant Professor').sum()
    prop_rep_all = jp_rep_all / n_rep_all

    rep_clean = rpp_clean[rpp_clean['replicated'] == 1.0]
    n_rep_clean = len(rep_clean)
    jp_rep_clean = (rep_clean['seniority.r'] == 'Assistant Professor').sum()
    prop_rep_clean = jp_rep_clean / n_rep_clean

    # Total RPP studies
    n_rpp_all = len(rpp_all)
    jp_rpp_all = (rpp_all['seniority.r'] == 'Assistant Professor').sum()
    prop_rpp_all = jp_rpp_all / n_rpp_all

    n_rpp_clean = len(rpp_clean)
    jp_rpp_clean = (rpp_clean['seniority.r'] == 'Assistant Professor').sum()
    prop_rpp_clean = jp_rpp_clean / n_rpp_clean

    # All psychology studies
    psych = df1[df1['discipline'].isin(['Social', 'Cognitive'])]
    rep_psych = psych[psych['replicated'] == 1.0]
    jp_rep_psych = (rep_psych['seniority.r'] == 'Assistant Professor').sum()
    prop_rep_psych = jp_rep_psych / len(rep_psych)

    # Statistical tests
    # All RPP: JP vs Non-JP
    table_all = [
        [(rep_all['seniority.r'] == 'Assistant Professor').sum(), (rpp_all[rpp_all['replicated'] == 0.0]['seniority.r'] == 'Assistant Professor').sum()],
        [(rep_all['seniority.r'] != 'Assistant Professor').sum(), (rpp_all[rpp_all['replicated'] == 0.0]['seniority.r'] != 'Assistant Professor').sum()]
    ]
    odds_ratio_all, p_fish_all = stats.fisher_exact(table_all)
    chi2_all, p_chi2_all, _, _ = stats.chi2_contingency(table_all, correction=False)

    print("=== RPP Replicated Studies ===")
    print(f"All: {jp_rep_all}/{n_rep_all} ({prop_rep_all:.2%})")
    print(f"Clean (drop==False): {jp_rep_clean}/{n_rep_clean} ({prop_rep_clean:.2%})")
    print("\n=== RPP All Replication Studies ===")
    print(f"All: {jp_rpp_all}/{n_rpp_all} ({prop_rpp_all:.2%})")
    print(f"Clean (drop==False): {jp_rpp_clean}/{n_rpp_clean} ({prop_rpp_clean:.2%})")
    print(f"\nFisher exact p: {p_fish_all:.4f}, Chi2 p: {p_chi2_all:.4f}")

if __name__ == '__main__':
    run_analysis()
