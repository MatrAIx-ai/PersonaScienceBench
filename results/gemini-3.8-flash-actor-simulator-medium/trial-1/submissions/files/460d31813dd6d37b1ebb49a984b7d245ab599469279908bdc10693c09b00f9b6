import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf
from scipy.stats import chi2

def main():
    # Load data
    df = pd.read_csv('data/nls_ses_processed.csv')
    df = df.rename(columns={
        'SAMPLE_RACE': 'race',
        'SAMPLE_SEX': 'sex',
        'FAMILY SIZE OF SAMPLE': 'fam_size',
        'ABILITY: COMPOSITE OF ASVAB SCORE': 'ability',
        'BA DEGREE COMPLETED': 'ba_degree',
        'PERCENTILE IN CLASS': 'class_pct',
        'SES': 'ses'
    })
    df['ba_int'] = df['ba_degree'].astype(int)

    print("=== 1. DESCRIPTIVE STATISTICS ===")
    print(f"Total N: {len(df)}")
    print(f"Total BA completions: {df['ba_int'].sum()} ({df['ba_int'].mean():.2%})")
    
    summary = df.groupby('race').agg(
        N=('ba_int', 'count'),
        BA_count=('ba_int', 'sum'),
        BA_rate=('ba_int', 'mean'),
        SES_mean=('ses', 'mean'),
        SES_sd=('ses', 'std'),
        Ability_mean=('ability', 'mean'),
        ClassPct_mean=('class_pct', 'mean'),
        FamSize_mean=('fam_size', 'mean')
    )
    print(summary.to_string())

    print("\n=== 2. UNADJUSTED LOGISTIC REGRESSION ===")
    m_unadj_main = smf.logit('ba_int ~ ses + C(race, Treatment(reference="White"))', data=df).fit(disp=False)
    m_unadj_int = smf.logit('ba_int ~ ses * C(race, Treatment(reference="White"))', data=df).fit(disp=False)
    
    lr_unadj = 2 * (m_unadj_int.llf - m_unadj_main.llf)
    p_unadj = 1 - chi2.cdf(lr_unadj, df=2)
    print("Unadjusted Main Effects Log-Likelihood:", m_unadj_main.llf)
    print("Unadjusted Interaction Log-Likelihood:", m_unadj_int.llf)
    print(f"LR Test for Interaction: Chi2(2) = {lr_unadj:.4f}, p = {p_unadj:.4f}")
    print(m_unadj_int.summary().tables[1])

    print("\n=== 3. ADJUSTED LOGISTIC REGRESSION ===")
    m_adj_main = smf.logit('ba_int ~ ses + C(race, Treatment(reference="White")) + ability + class_pct + fam_size + C(sex)', data=df).fit(disp=False)
    m_adj_int = smf.logit('ba_int ~ ses * C(race, Treatment(reference="White")) + ability + class_pct + fam_size + C(sex)', data=df).fit(disp=False)
    
    lr_adj = 2 * (m_adj_int.llf - m_adj_main.llf)
    p_adj = 1 - chi2.cdf(lr_adj, df=2)
    print("Adjusted Main Effects Log-Likelihood:", m_adj_main.llf)
    print("Adjusted Interaction Log-Likelihood:", m_adj_int.llf)
    print(f"LR Test for Interaction: Chi2(2) = {lr_adj:.4f}, p = {p_adj:.4f}")
    print(m_adj_int.summary().tables[1])

    print("\n=== 4. RACE-STRATIFIED LOGISTIC MODELS ===")
    for r in ['White', 'Black', 'Hispanic']:
        sub = df[df['race'] == r]
        u = smf.logit('ba_int ~ ses', data=sub).fit(disp=False)
        a = smf.logit('ba_int ~ ses + ability + class_pct + fam_size + C(sex)', data=sub).fit(disp=False)
        print(f"Subgroup: {r}")
        print(f"  Unadjusted SES: beta={u.params['ses']:.4f}, SE={u.bse['ses']:.4f}, p={u.pvalues['ses']:.4f}, OR={np.exp(u.params['ses']):.3f}")
        print(f"  Adjusted SES:   beta={a.params['ses']:.4f}, SE={a.bse['ses']:.4f}, p={a.pvalues['ses']:.4f}, OR={np.exp(a.params['ses']):.3f}")

    print("\n=== 5. LINEAR PROBABILITY MODELS (HC1 ROBUST SE) ===")
    lpm_unadj = smf.ols('ba_int ~ ses * C(race, Treatment(reference="White"))', data=df).fit(cov_type='HC1')
    lpm_adj = smf.ols('ba_int ~ ses * C(race, Treatment(reference="White")) + ability + class_pct + fam_size + C(sex)', data=df).fit(cov_type='HC1')
    print("LPM Unadjusted Interaction P-values:")
    print(f"  ses:Black p = {lpm_unadj.pvalues['ses:C(race, Treatment(reference=\"White\"))[T.Black]']:.4f}")
    print(f"  ses:Hispanic p = {lpm_unadj.pvalues['ses:C(race, Treatment(reference=\"White\"))[T.Hispanic]']:.4f}")
    print("LPM Adjusted Interaction P-values:")
    print(f"  ses:Black p = {lpm_adj.pvalues['ses:C(race, Treatment(reference=\"White\"))[T.Black]']:.4f}")
    print(f"  ses:Hispanic p = {lpm_adj.pvalues['ses:C(race, Treatment(reference=\"White\"))[T.Hispanic]']:.4f}")

if __name__ == '__main__':
    main()
