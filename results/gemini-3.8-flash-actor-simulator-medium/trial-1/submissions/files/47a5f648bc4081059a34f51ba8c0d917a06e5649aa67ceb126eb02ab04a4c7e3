import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf
from scipy import stats

def run_analysis():
    # Load data
    df = pd.read_excel('data/data.xlsx')
    
    # Filter valid rows (first 80 rows corresponding to actual patients)
    df = df.iloc[:80].copy()
    
    # Verify columns and data types
    df['Age'] = pd.to_numeric(df['Age'])
    df['BMI'] = pd.to_numeric(df['BMI'])
    
    # Define binary response: Responder (PR) = 1, Non-responder (SD/PD) = 0
    # Group 1 = PR (41 patients), Group 2 = SD/PD (39 patients)
    df['response'] = (df['Efficacy'] == 'PR').astype(int)
    
    print("=== DATA SUMMARY ===")
    print(f"Total valid sample size: {len(df)}")
    print(f"Response counts:\n{df['response'].value_counts()}")
    print(f"Efficacy breakdown:\n{df['Efficacy'].value_counts()}")
    print(f"BMI summary:\n{df['BMI'].describe()}\n")
    
    # 1. Univariate Logistic Regression
    m_uni = smf.logit('response ~ BMI', data=df).fit()
    print("=== MODEL 1: UNIVARIATE LOGISTIC REGRESSION ===")
    print(m_uni.summary())
    
    bmi_coef_uni = m_uni.params['BMI']
    bmi_se_uni = m_uni.bse['BMI']
    bmi_z_uni = m_uni.tvalues['BMI']
    bmi_pval_uni = m_uni.pvalues['BMI']
    bmi_or_uni = np.exp(bmi_coef_uni)
    ci_uni = np.exp(m_uni.conf_int().loc['BMI'])
    
    print("\nUnivariate BMI metrics:")
    print(f"Coefficient: {bmi_coef_uni:.5f}")
    print(f"Std Err: {bmi_se_uni:.5f}")
    print(f"z-statistic: {bmi_z_uni:.5f}")
    print(f"p-value (Wald): {bmi_pval_uni:.5f}")
    print(f"Odds Ratio: {bmi_or_uni:.5f} (95% CI: [{ci_uni[0]:.5f}, {ci_uni[1]:.5f}])")
    
    # Likelihood Ratio Test for univariate model
    m_null = smf.logit('response ~ 1', data=df).fit()
    lr_stat = -2 * (m_null.llf - m_uni.llf)
    lr_pval = stats.chi2.sf(lr_stat, df=1)
    print(f"Likelihood Ratio Test stat: {lr_stat:.5f}, p-value: {lr_pval:.5f}\n")
    
    # 2. Multivariable Logistic Regression
    # Standardize column names for formula
    df_multi = df.copy()
    df_multi.columns = [c.replace(' ', '_').replace('-', '_') for c in df_multi.columns]
    
    # Multivariable model adjusting for all baseline covariates:
    # Age, Gender, Family_history, ECOG_PS, Child_Pugh, Chemotherapy_experience, HBV_infection
    formula_multi = (
        'response ~ BMI + Age + C(Gender) + C(Family_history) + '
        'C(ECOG_PS) + C(Child_Pugh) + C(Chemotherapy_experience) + C(HBV_infection)'
    )
    m_multi = smf.logit(formula_multi, data=df_multi).fit()
    print("=== MODEL 2: MULTIVARIABLE LOGISTIC REGRESSION ===")
    print(m_multi.summary())
    
    bmi_coef_multi = m_multi.params['BMI']
    bmi_se_multi = m_multi.bse['BMI']
    bmi_z_multi = m_multi.tvalues['BMI']
    bmi_pval_multi = m_multi.pvalues['BMI']
    bmi_or_multi = np.exp(bmi_coef_multi)
    ci_multi = np.exp(m_multi.conf_int().loc['BMI'])
    
    print("\nMultivariable BMI metrics:")
    print(f"Coefficient: {bmi_coef_multi:.5f}")
    print(f"Std Err: {bmi_se_multi:.5f}")
    print(f"z-statistic: {bmi_z_multi:.5f}")
    print(f"p-value (Wald): {bmi_pval_multi:.5f}")
    print(f"Odds Ratio: {bmi_or_multi:.5f} (95% CI: [{ci_multi[0]:.5f}, {ci_multi[1]:.5f}])")

if __name__ == '__main__':
    run_analysis()
