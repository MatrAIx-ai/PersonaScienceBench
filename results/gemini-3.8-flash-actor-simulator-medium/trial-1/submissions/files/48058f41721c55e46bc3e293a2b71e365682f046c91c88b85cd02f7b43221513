import pandas as pd

def analyze_student_subjects():
    df = pd.read_csv('data/meta-regression_study_data_heterogeneity_in_replication_projects.csv')
    
    results = {}
    for disc in ['Social', 'Cognitive', 'Economics']:
        sub = df[df['discipline'] == disc]
        n_titles = sub['title'].nunique()
        sub_title = sub.drop_duplicates(subset=['title'])
        
        o_students = (sub_title['subjects.o'] == 'students').sum()
        o_pct = (o_students / n_titles) * 100
        
        r_students = sub.groupby('title')['subjects.r'].apply(lambda s: (s == 'students').sum() >= (len(s) / 2)).sum()
        r_pct = (r_students / n_titles) * 100
        
        results[disc] = {
            'n_studies': n_titles,
            'original_students': o_students,
            'original_pct': round(o_pct, 1),
            'replication_students': r_students,
            'replication_pct': round(r_pct, 1)
        }
        print(f"Domain: {disc} | N = {n_titles} | Original: {o_students}/{n_titles} ({o_pct:.1f}%) | Replication: {r_students}/{n_titles} ({r_pct:.1f}%)")
        
    return results

if __name__ == '__main__':
    analyze_student_subjects()
