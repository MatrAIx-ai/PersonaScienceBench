import os
import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf
from scipy import stats

def main():
    # Load dataset
    data_path = 'data/data.xlsx'
    df_raw = pd.read_excel(data_path)
    
    # Filter to the valid 80 patient records (Sequence number 1 to 80)
    df = df_raw.iloc[:80].copy()
    
    # Convert data types
    df['Age'] = pd.to_numeric(df['Age'], errors='raise')
    df['BMI'] = pd.to_numeric(df['BMI'], errors='raise')
    df['Gender'] = df['Gender'].astype(str)
    
    # Binary response: 1 if PR, 0 if PD or SD
    df['PR'] = (df['Efficacy'] == 'PR').astype(int)
    
    print("Dataset Summary:")
    print(f"Number of patients: {len(df)}")
    print(f"Outcome distribution (PR=1, non-PR=0):\n{df['PR'].value_counts().to_dict()}")
    print(f"Efficacy breakdown:\n{df['Efficacy'].value_counts().to_dict()}")
    print(f"Gender breakdown:\n{df['Gender'].value_counts().to_dict()}")
    print(f"Age: mean={df['Age'].mean():.2f}, sd={df['Age'].std():.2f}, min={df['Age'].min()}, max={df['Age'].max()}")
    print(f"BMI: mean={df['BMI'].mean():.2f}, sd={df['BMI'].std():.2f}, min={df['BMI'].min()}, max={df['BMI'].max()}")
    
    # Fit multivariable logistic regression model: PR ~ Age + BMI + Gender
    # Using statsmodels formula API
    model = smf.logit('PR ~ Age + BMI + C(Gender)', data=df).fit()
    print("\n" + "="*50)
    print("Model Summary (Gender reference: Female):")
    print(model.summary())
    
    # Also test with Gender reference: Male
    model_male_ref = smf.logit('PR ~ Age + BMI + C(Gender, Treatment(reference="Male"))', data=df).fit(disp=False)
    
    # Likelihood Ratio Test for Age
    model_reduced = smf.logit('PR ~ BMI + C(Gender)', data=df).fit(disp=False)
    lr_stat = 2 * (model.llf - model_reduced.llf)
    p_lrt = stats.chi2.sf(lr_stat, df=1)
    
    age_coef = model.params['Age']
    age_se = model.bse['Age']
    age_z = model.tvalues['Age']
    age_p_wald = model.pvalues['Age']
    
    print("\n" + "="*50)
    print("Inference for Age:")
    print(f"Coefficient (beta): {age_coef:.6f}")
    print(f"Odds Ratio: {np.exp(age_coef):.6f} (95% CI: [{np.exp(age_coef - 1.96*age_se):.6f}, {np.exp(age_coef + 1.96*age_se):.6f}])")
    print(f"Standard Error: {age_se:.6f}")
    print(f"Wald z-statistic: {age_z:.6f}")
    print(f"Wald p-value: {age_p_wald:.6f} (scientific: {age_p_wald:.4e})")
    print(f"Likelihood Ratio Test statistic: {lr_stat:.6f}")
    print(f"LRT p-value: {p_lrt:.6f}")
    
    print("\nAll model coefficients:")
    for term in model.params.index:
        print(f"  {term:20s}: coef={model.params[term]:.4f}, se={model.bse[term]:.4f}, z={model.tvalues[term]:.4f}, p={model.pvalues[term]:.6f}")

if __name__ == '__main__':
    main()
