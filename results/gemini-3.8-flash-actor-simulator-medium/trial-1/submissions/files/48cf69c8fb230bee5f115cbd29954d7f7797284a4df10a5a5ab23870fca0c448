"""
Analysis of the relationship between Time Preference and Body Mass Index (BMI)
Dataset: National Longitudinal Survey of Youth 1979 (NLSY79)
"""

import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf

def main():
    # 1. Load data
    df = pd.read_csv('data/nls_raw.csv')
    print(f"Total raw sample size: {len(df)}")

    # 2. Clean Height & Weight to compute BMI
    # Height 1985 in inches (standard adult height)
    df['height_clean'] = df['Height of respondent, 1985']
    df.loc[(df['height_clean'] < 48) | (df['height_clean'] > 84), 'height_clean'] = np.nan

    # Weights in lbs across 1981, 1989, 1992
    for yr in [1981, 1989, 1992]:
        w_col = f'Weight of respondent, {yr}'
        df[f'weight_clean_{yr}'] = df[w_col]
        df.loc[(df[f'weight_clean_{yr}'] < 50) | (df[f'weight_clean_{yr}'] > 600), f'weight_clean_{yr}'] = np.nan
        df[f'bmi_{yr}'] = (df[f'weight_clean_{yr}'] / (df['height_clean'] ** 2)) * 703

    # 3. Residence and Incarceration history
    res_cols = [c for c in df.columns if 'Type of residence respondent is living in' in c]
    ever_jail = (
        (df[res_cols] == 5).any(axis=1) |
        (df['Ever been sentenced in any correctional institution before 1980'] == 1) |
        (df['Ever convicted of an illegal act in adult court before 1980'] == 1)
    )
    df['ever_incarcerated'] = ever_jail.astype(int)

    # 4. Cognitive & Academic Ability
    asvab_cols = [
        'ASVAB - Arithmetic Reasoning Z Score (rounded), 1981',
        'ASVAB - Word Knowledge Z Score (rounded), 1981',
        'ASVAB - Paragraph Comprehension Z Score (rounded), 1981',
        'ASVAB - Mathematics Knowledge Z Score (rounded), 1981'
    ]
    df['asvab_composite'] = df[asvab_cols].mean(axis=1)

    # 5. Time preference proxy from 1989 savings behavior
    savings_cat = df['Was more money put into or taken out of R/spouse savings since last interview, 1989']
    # 1: Put money in (lowest time preference / future oriented)
    # 2: Took money out (higher time preference / dissaving)
    # 3: No change (neutral)
    # 4: No savings (highest time preference / present oriented)
    df['high_time_pref'] = np.nan
    df.loc[savings_cat == 1, 'high_time_pref'] = 0
    df.loc[savings_cat == 3, 'high_time_pref'] = 1
    df.loc[savings_cat == 2, 'high_time_pref'] = 2
    df.loc[savings_cat == 4, 'high_time_pref'] = 3

    # Demographic & Socio-economic controls
    df['female'] = (df['Sex of respondent, 1979'] == 2).astype(int)
    df['black'] = (df['Racial/ethnic cohort, 1979'] == 1).astype(int)
    df['hispanic'] = (df['Racial/ethnic cohort, 1979'] == 2).astype(int)
    df['education'] = df['Highest grade completed, 1979']
    df.loc[df['education'] > 25, 'education'] = np.nan
    df['log_income_1989'] = np.log(df['Total net family income, previous calendar year, 1989'].clip(lower=1))

    # Delta BMI
    df['delta_bmi_81_89'] = df['bmi_1989'] - df['bmi_1981']
    df['delta_bmi_81_92'] = df['bmi_1992'] - df['bmi_1981']

    # Summary table
    pd.set_option('display.max_columns', 10)
    pd.set_option('display.width', 1000)
    res = df.groupby(savings_cat)[['bmi_1981', 'bmi_1989', 'bmi_1992']].agg(['mean', 'count']).round(2)
    print("\n--- Longitudinal BMI by Savings Category (1=Savers, 2=Dis-savers, 3=No change, 4=No savings) ---")
    print(res)

    # Regressions
    df_reg = df.rename(columns={'Age of respondent at interview date, 1989': 'Age_of_respondent_at_interview_date_1989'})

    # Model 1: Cross-sectional 1989
    formula_1989 = (
        'bmi_1989 ~ high_time_pref + Age_of_respondent_at_interview_date_1989 + female + black + hispanic + '
        'education + asvab_composite + log_income_1989 + ever_incarcerated'
    )
    m_1989 = smf.ols(formula_1989, data=df_reg).fit()
    print("\n--- OLS Regression Results: BMI 1989 ---")
    print(m_1989.summary().tables[1])

    # Model 2: Prospective 1992
    formula_1992 = (
        'bmi_1992 ~ high_time_pref + Age_of_respondent_at_interview_date_1989 + female + black + hispanic + '
        'education + asvab_composite + log_income_1989 + ever_incarcerated'
    )
    m_1992 = smf.ols(formula_1992, data=df_reg).fit()
    print("\n--- OLS Regression Results: BMI 1992 ---")
    print(m_1992.summary().tables[1])

    # Model 3: Longitudinal Delta BMI (1981-1989) controlling for baseline BMI
    formula_delta = (
        'delta_bmi_81_89 ~ high_time_pref + bmi_1981 + Age_of_respondent_at_interview_date_1989 + female + black + hispanic + '
        'education + asvab_composite + log_income_1989 + ever_incarcerated'
    )
    m_delta = smf.ols(formula_delta, data=df_reg).fit()
    print("\n--- OLS Regression Results: Delta BMI (1981-1989) ---")
    print(m_delta.summary().tables[1])

if __name__ == '__main__':
    main()
