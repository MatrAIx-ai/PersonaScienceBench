import pandas as pd

df = pd.read_csv('data/capital.csv')
num_cols = [c for c in df.columns if c not in ['BCE', 'group', 'color']]
for c in num_cols:
    df[c] = df[c].astype(str).str.replace(',', '.').astype(float)

symbolic = ['ZAxtSchwert', 'ZDolch', 'Zhausgr']
social = ['ZCU_AU', 'Zamber', 'ZMonument']
cultural = ['ZKeform', 'Zkeverz']
economic = ['ZHort', 'ZSichel', 'ZBeil', 'ZMW']
all_cols = symbolic + social + cultural + economic

df['summed_total_capital'] = df[all_cols].sum(axis=1)
df['summed_social_capital'] = df[social].sum(axis=1)

peak_total = df.loc[df['summed_total_capital'].idxmax()]
peak_social = df.loc[df['summed_social_capital'].idxmax()]

print('Total Summed Capital Peak:', peak_total['BCE'], 'BCE, value:', peak_total['summed_total_capital'])
print('Narrow Social Capital Peak:', peak_social['BCE'], 'BCE, value:', peak_social['summed_social_capital'])

row_1500 = df[df['BCE'] == 1500].iloc[0]
row_1400 = df[df['BCE'] == 1400].iloc[0]

changes = []
for c in all_cols:
    diff = row_1400[c] - row_1500[c]
    changes.append({'Indicator': c, '1500_BCE': row_1500[c], '1400_BCE': row_1400[c], 'Delta': diff})

df_changes = pd.DataFrame(changes).sort_values(by='Delta', ascending=False)
print('Component changes (1500 -> 1400 BCE):')
print(df_changes.to_string(index=False))
