import sys
import struct
import numpy as np
import pandas as pd
from scipy import stats

# Ensure olefile can be imported from system libraries if needed
sys.path.append('/usr/lib/python3/dist-packages')
import olefile

def parse_biff8_xls(xls_path):
    ole = olefile.OleFileIO(xls_path)
    data = ole.openstream('Workbook').read()

    # 1. Parse SST (Shared String Table)
    pos = 0
    sst_data = None
    while pos < len(data):
        rec_type, rec_len = struct.unpack_from('<HH', data, pos)
        if rec_type == 0x00fc: # SST
            sst_data = data[pos+4:pos+4+rec_len]
            break
        pos += 4 + rec_len

    strings = []
    if sst_data:
        total_str, unique_str = struct.unpack_from('<II', sst_data, 0)
        p = 8
        for _ in range(unique_str):
            char_len, flags = struct.unpack_from('<HB', sst_data, p)
            p += 3
            is_unicode = flags & 1
            has_rich = (flags & 8) != 0
            has_phonetic = (flags & 4) != 0
            rt_runs = struct.unpack_from('<H', sst_data, p)[0] if has_rich else 0
            if has_rich: p += 2
            ext_len = struct.unpack_from('<I', sst_data, p)[0] if has_phonetic else 0
            if has_phonetic: p += 4
            if is_unicode:
                s = sst_data[p:p + 2*char_len].decode('utf-16le', errors='replace')
                p += 2 * char_len
            else:
                s = sst_data[p:p + char_len].decode('latin1', errors='replace')
                p += char_len
            p += 4 * rt_runs + ext_len
            strings.append(s)

    # 2. Extract cell records
    cells = {}
    pos = 0
    while pos < len(data):
        rec_type, rec_len = struct.unpack_from('<HH', data, pos)
        rec_data = data[pos+4:pos+4+rec_len]
        if rec_type == 0x0203: # NUMBER
            row, col, xf = struct.unpack_from('<HHH', rec_data, 0)
            cells[(row, col)] = struct.unpack_from('<d', rec_data, 6)[0]
        elif rec_type == 0x00fd: # LABELSST
            row, col, xf, sst_idx = struct.unpack_from('<HHHI', rec_data, 0)
            cells[(row, col)] = strings[sst_idx]
        elif rec_type == 0x027e: # RK
            row, col, xf, rk = struct.unpack_from('<HHHI', rec_data, 0)
            val = (rk >> 2) if (rk & 2) else struct.unpack('<d', struct.pack('<II', 0, rk & 0xfffffffc))[0]
            if rk & 1: val /= 100.0
            cells[(row, col)] = val
        elif rec_type == 0x0004: # LABEL
            row, col, xf, l = struct.unpack_from('<HHHH', rec_data, 0)
            cells[(row, col)] = rec_data[8:8+l].decode('latin1', errors='replace')
        pos += 4 + rec_len

    max_row = max(r for r, c in cells.keys())
    max_col = max(c for r, c in cells.keys())
    header = ['miRNA'] + [cells.get((1, c), f'col_{c}') for c in range(1, max_col + 1)]
    rows = []
    for r in range(2, max_row + 1):
        row_vals = [cells.get((r, 0), '')]
        for c in range(1, max_col + 1):
            v = cells.get((r, c), np.nan)
            if v == 'NAN' or v == '' or v is None:
                v = np.nan
            else:
                v = float(v)
            row_vals.append(v)
        rows.append(row_vals)
    df = pd.DataFrame(rows, columns=header)
    return df

def main():
    xls_path = 'data/pone.0150501.s002.xls'
    df = parse_biff8_xls(xls_path)
    
    patient_cols = [c for c in df.columns if c.startswith('P_')]
    control_cols = [c for c in df.columns if c.startswith('C_')]
    all_sample_cols = patient_cols + control_cols
    total_mirnas = len(df)
    
    print(f"Loaded dataset: {total_mirnas} miRNAs across {len(patient_cols)} patient and {len(control_cols)} control samples.")

    # 1. Primary Baseline Analysis: Raw Ct, Student's t-test (equal variance, omitting NaNs)
    p_baseline = []
    t_baseline = []
    for _, row in df.iterrows():
        p_vals = row[patient_cols].values.astype(float)
        c_vals = row[control_cols].values.astype(float)
        res = stats.ttest_ind(p_vals, c_vals, equal_var=True, nan_policy='omit')
        t_baseline.append(res.statistic)
        p_baseline.append(res.pvalue)
    
    df['p_value_baseline_ttest'] = p_baseline
    df['t_stat_baseline_ttest'] = t_baseline
    df['is_sig_baseline'] = df['p_value_baseline_ttest'] < 0.05
    
    sig_count_baseline = df['is_sig_baseline'].sum()
    pct_baseline = (sig_count_baseline / total_mirnas) * 100.0

    print("\n" + "="*60)
    print("PRIMARY BASELINE RESULT:")
    print(f"Significant miRNAs (p < 0.05, Student's t-test, raw Ct, omit NaN): {sig_count_baseline} / {total_mirnas}")
    print(f"Percentage: {pct_baseline:.4f}% ({sig_count_baseline}/{total_mirnas})")
    print(f"Percentage (rounded 2 d.p.): {pct_baseline:.2f}%")
    print("="*60)

    # 2. Variants Analysis
    # Variant A: Welch's t-test (unequal variance, omit NaN)
    p_welch = [stats.ttest_ind(row[patient_cols].values.astype(float), row[control_cols].values.astype(float),
                               equal_var=False, nan_policy='omit').pvalue for _, row in df.iterrows()]
    sig_welch = sum(p < 0.05 for p in p_welch)
    pct_welch = (sig_welch / total_mirnas) * 100.0

    # Variant B: Mann-Whitney U test (non-parametric, omit NaN)
    p_mwu = []
    for _, row in df.iterrows():
        p_v = row[patient_cols].values.astype(float)
        c_v = row[control_cols].values.astype(float)
        p_v = p_v[~np.isnan(p_v)]
        c_v = c_v[~np.isnan(c_v)]
        p_mwu.append(stats.mannwhitneyu(p_v, c_v, alternative='two-sided').pvalue)
    sig_mwu = sum(p < 0.05 for p in p_mwu)
    pct_mwu = (sig_mwu / total_mirnas) * 100.0

    # Variant C: NaN Imputed with Ct=40.0 (LOD)
    df_imp = df[all_sample_cols].fillna(40.0)
    p_imp_ttest = [stats.ttest_ind(df_imp.loc[i, patient_cols].values, df_imp.loc[i, control_cols].values, equal_var=True).pvalue for i in range(total_mirnas)]
    sig_imp_ttest = sum(p < 0.05 for p in p_imp_ttest)
    pct_imp_ttest = (sig_imp_ttest / total_mirnas) * 100.0

    # Variant D: Strict Complete Cases (excluding 14 miRNAs with NaNs, N=161)
    df_complete = df.dropna(subset=all_sample_cols)
    p_complete = [stats.ttest_ind(row[patient_cols].values.astype(float), row[control_cols].values.astype(float), equal_var=True).pvalue for _, row in df_complete.iterrows()]
    sig_complete = sum(p < 0.05 for p in p_complete)
    pct_complete_of_161 = (sig_complete / len(df_complete)) * 100.0
    pct_complete_of_175 = (sig_complete / total_mirnas) * 100.0

    # Summary table
    print("\nCOMPARISON ACROSS METHODOLOGICAL VARIANTS:")
    summary_data = [
        {"Method": "Student's t-test (Baseline)", "Data": "Raw Ct", "NaN Handling": "Omit", "Significant": sig_count_baseline, "Total": total_mirnas, "Percentage": f"{pct_baseline:.2f}% ({pct_baseline:.4f}%)"},
        {"Method": "Welch's t-test", "Data": "Raw Ct", "NaN Handling": "Omit", "Significant": sig_welch, "Total": total_mirnas, "Percentage": f"{pct_welch:.2f}% ({pct_welch:.4f}%)"},
        {"Method": "Mann-Whitney U", "Data": "Raw Ct", "NaN Handling": "Omit", "Significant": sig_mwu, "Total": total_mirnas, "Percentage": f"{pct_mwu:.2f}% ({pct_mwu:.4f}%)"},
        {"Method": "Student's t-test (Imputed 40.0)", "Data": "Raw Ct", "NaN Handling": "Impute 40.0", "Significant": sig_imp_ttest, "Total": total_mirnas, "Percentage": f"{pct_imp_ttest:.2f}% ({pct_imp_ttest:.4f}%)"},
        {"Method": "Student's t-test (Complete Cases)", "Data": "Raw Ct", "NaN Handling": "Drop NaNs", "Significant": sig_complete, "Total": len(df_complete), "Percentage": f"{pct_complete_of_161:.2f}% (or {pct_complete_of_175:.2f}% of 175)"},
    ]
    summary_df = pd.DataFrame(summary_data)
    print(summary_df.to_string(index=False))

    # Save detailed per-miRNA test results
    df['p_welch'] = p_welch
    df['p_mwu'] = p_mwu
    df.to_csv('differential_expression_results.csv', index=False)
    print("\nDetailed results saved to 'differential_expression_results.csv'.")

if __name__ == '__main__':
    main()
