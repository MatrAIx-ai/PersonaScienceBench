import pandas as pd
import numpy as np
from statsmodels.stats.contingency_tables import mcnemar

# 1. Load data
df = pd.read_csv('data/requirements_engineering_for_ML-enabled_systems.csv')

# 2. Filter missing / non-applicable codes
# In Q9, '-77' indicates the question was skipped or not reached
valid_df = df[df['Q9_ML_Elicitation_Interviews'] != '-77'].copy()

q9_cols = [
    'Q9_ML_Elicitation_Interviews',
    'Q9_ML_Elicitation_Scenarios',
    'Q9_ML_Elicitation_Prototyping',
    'Q9_ML_Elicitation_Workshops_Meetings',
    'Q9_ML_Elicitation_Observation',
    'Q9_ML_Elicitation_Others'
]

# 3. Frequency of each technique
print(f"Total respondents: {len(df)}")
print(f"Valid respondents for Q9: {len(valid_df)}")

results = []
for col in q9_cols:
    quoted_cnt = (valid_df[col] == 'quoted').sum()
    pct_valid = quoted_cnt / len(valid_df) * 100
    results.append({
        'technique': col.replace('Q9_ML_Elicitation_', ''),
        'quoted_count': quoted_cnt,
        'valid_total': len(valid_df),
        'percentage': pct_valid
    })

res_df = pd.DataFrame(results).sort_values(by='quoted_count', ascending=False)
print("\nRanked Elicitation Techniques:")
print(res_df.to_string(index=False))

# 4. Bootstrap analysis
np.random.seed(42)
B = 10000
n = len(valid_df)
boot_indices = np.random.randint(0, n, size=(B, n))

mat = (valid_df[q9_cols].values == 'quoted').astype(int)

print("\nBootstrap Results (B=10000):")
for i, col in enumerate(q9_cols):
    tech_name = col.replace('Q9_ML_Elicitation_', '')
    boot_means = mat[:, i][boot_indices].mean(axis=1) * 100
    mean_val = np.mean(boot_means)
    ci_low = np.percentile(boot_means, 2.5)
    ci_high = np.percentile(boot_means, 97.5)
    print(f"{tech_name:20s}: Mean = {mean_val:.3f}%, 95% CI = [{ci_low:.3f}%, {ci_high:.3f}%]")

# Pairwise McNemar tests against Interviews
print("\nPairwise McNemar Tests (Interviews vs other techniques):")
int_arr = (valid_df['Q9_ML_Elicitation_Interviews'] == 'quoted').astype(int)
for col in q9_cols[1:]:
    tech_name = col.replace('Q9_ML_Elicitation_', '')
    other_arr = (valid_df[col] == 'quoted').astype(int)
    table = pd.crosstab(int_arr, other_arr)
    m_res = mcnemar(table, exact=True)
    print(f"Interviews vs {tech_name:15s}: p-value = {m_res.pvalue:.5f}")
