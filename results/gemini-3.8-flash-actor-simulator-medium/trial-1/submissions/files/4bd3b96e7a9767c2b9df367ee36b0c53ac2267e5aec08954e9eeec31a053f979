import os
import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf

def main():
    # 1. Load data
    data_path = 'data/data.xlsx'
    df_raw = pd.read_excel(data_path)
    
    # Filter valid cohort (first 80 patients where Sequence number is not null)
    df = df_raw[df_raw['Sequence number'].notnull()].copy()
    
    # Ensure correct data types
    df['Age'] = pd.to_numeric(df['Age'], errors='coerce')
    df['BMI'] = pd.to_numeric(df['BMI'], errors='coerce')
    df['Gender'] = df['Gender'].astype(str).str.strip()
    
    # 2. Define binary outcome: Remission = 1 if PR, 0 if SD or PD
    df['Remission'] = (df['Efficacy'] == 'PR').astype(int)
    
    print(f"Total cohort size: {len(df)}")
    print("Outcome distribution (Remission):")
    print(df['Remission'].value_counts())
    print("\nOriginal Efficacy breakdown:")
    print(df['Efficacy'].value_counts())
    
    # 3. Fit logistic regression models
    # Model 1: Gender with Female as reference
    formula_female_ref = 'Remission ~ Age + BMI + C(Gender, Treatment(reference="Female"))'
    model_female_ref = smf.logit(formula_female_ref, data=df).fit()
    
    print("\n" + "="*60)
    print("Logistic Regression Summary (Reference Gender: Female)")
    print("="*60)
    print(model_female_ref.summary())
    
    # Model 2: Gender with Male as reference (for completeness)
    formula_male_ref = 'Remission ~ Age + BMI + C(Gender, Treatment(reference="Male"))'
    model_male_ref = smf.logit(formula_male_ref, data=df).fit()
    
    print("\n" + "="*60)
    print("Logistic Regression Summary (Reference Gender: Male)")
    print("="*60)
    print(model_male_ref.summary())
    
    # 4. Extract detailed statistics for Age
    age_coef = model_female_ref.params['Age']
    age_se = model_female_ref.bse['Age']
    age_pvalue = model_female_ref.pvalues['Age']
    age_ci = model_female_ref.conf_int().loc['Age']
    age_or = np.exp(age_coef)
    age_or_ci = np.exp(age_ci)
    
    print("\n" + "="*60)
    print("Key Results for Age Predictor:")
    print("="*60)
    print(f"Log-odds change per year of Age (coef): {age_coef:.6f} (approx. {age_coef:.4f})")
    print(f"Standard Error: {age_se:.6f} (approx. {age_se:.4f})")
    print(f"95% Confidence Interval for Log-odds: [{age_ci[0]:.6f}, {age_ci[1]:.6f}]")
    print(f"z-statistic: {model_female_ref.tvalues['Age']:.4f}")
    print(f"p-value: {age_pvalue:.6f}")
    print(f"Odds Ratio (OR): {age_or:.6f} [95% CI: {age_or_ci[0]:.6f}, {age_or_ci[1]:.6f}]")
    
if __name__ == '__main__':
    main()
