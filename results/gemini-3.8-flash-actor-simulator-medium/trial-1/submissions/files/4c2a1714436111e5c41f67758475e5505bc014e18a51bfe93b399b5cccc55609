#!/usr/bin/env python3
"""
Analysis script for BixBench bix-29-q1:
Odds ratio of BCG vaccination on COVID-19 severity when controlling for
prior medical history count and patients interaction frequency and interaction between terms,
predicted by an ordinal regression model.
"""

import sys
import numpy as np
import pandas as pd
from scipy.stats import norm
from statsmodels.miscmodels.ordinal_model import OrderedModel

def main():
    print("=" * 80)
    print("BCG-CORONA Trial: Ordinal Regression Analysis of COVID-19 Severity")
    print("=" * 80)

    # 1. Load data
    dm = pd.read_csv("data/TASK008_BCG-CORONA_DM.csv")
    ae = pd.read_csv("data/TASK008_BCG-CORONA_AE.csv")
    mh = pd.read_csv("data/TASK008_BCG-CORONA_MH.csv")

    # 2. Extract Prior Medical History Count
    mh_med = mh[mh["MHSCAT"] == "MEDICAL HISTORY"]
    mh_yes = mh_med[mh_med["MHORRES"] == 2.0].groupby("USUBJID").size()
    dm["mh_count"] = dm["USUBJID"].map(mh_yes).fillna(0).astype(int)

    # 3. Extract COVID-19 Severity (AEHS)
    covid_ae = ae[ae["AEPT"].str.contains("covid|sars|corona", case=False, na=False)]
    covid_max_hs = covid_ae.groupby("USUBJID")["AEHS"].max()
    dm["covid_hs"] = dm["USUBJID"].map(covid_max_hs)

    # Binary BCG indicator (BCG = 1, Placebo = 0)
    dm["is_bcg"] = (dm["TRTGRP"] == "BCG").astype(int)

    # Patient interaction frequency
    # Categorical with '1-50' as reference
    dm["patients_seen"] = pd.Categorical(
        dm["patients_seen"], categories=["1-50", "51-100", ">100"], ordered=False
    )
    freq_map = {"1-50": 1, "51-100": 2, ">100": 3}
    dm["patients_freq"] = dm["patients_seen"].map(freq_map)

    # Collapsed COVID severity for infected cohort (0: asymptomatic, 1: mild, 2: moderate, 3: >=3 hospitalized/severe)
    dm["covid_hs_collapsed"] = dm["covid_hs"].apply(lambda x: min(x, 3) if pd.notna(x) else np.nan)

    # Cohort 1: Primary Cohort - Confirmed COVID-19 Cases (N = 197)
    covid_df = dm[dm["covid_hs"].notna()].copy()
    print(f"\n[Cohort 1] Primary Analysis Cohort: Confirmed COVID-19 Cases (N = {len(covid_df)})")
    print("Severity distribution (AEHS, 0-7):")
    print(covid_df["covid_hs"].value_counts().sort_index().to_string())
    print("\nCollapsed severity distribution (0, 1, 2, 3+):")
    print(covid_df["covid_hs_collapsed"].value_counts().sort_index().to_string())

    # Fit Primary Models
    print("\n" + "-" * 60)
    print("Model 1A: Primary Cohort (N=197) - Full Pairwise Interaction Model (Categorical patients_seen)")
    print("Formula: covid_hs ~ (is_bcg + mh_count + C(patients_seen))**2")
    mod_1a = OrderedModel.from_formula(
        "covid_hs ~ (is_bcg + mh_count + C(patients_seen))**2", data=covid_df, distr="logit"
    )
    res_1a = mod_1a.fit(disp=False, method="bfgs")
    print(res_1a.summary().tables[1])

    # Calculate BCG baseline odds ratio and conditional odds ratios
    params_1a = res_1a.params
    cov_1a = res_1a.cov_params()
    bcg_coef = params_1a["is_bcg"]
    bcg_se = res_1a.bse["is_bcg"]
    bcg_p = res_1a.pvalues["is_bcg"]
    bcg_or = np.exp(bcg_coef)
    ci_low = np.exp(bcg_coef - 1.96 * bcg_se)
    ci_high = np.exp(bcg_coef + 1.96 * bcg_se)
    print(f"\n[Baseline BCG Effect (patients_seen='1-50', mh_count=0)]")
    print(f"Coef: {bcg_coef:.4f}, SE: {bcg_se:.4f}, p-value: {bcg_p:.4f}")
    print(f"Odds Ratio (OR): {bcg_or:.4f} (95% CI: {ci_low:.4f} - {ci_high:.4f})")

    # Conditional Odds Ratios at different levels of covariates
    print("\n[Conditional BCG Odds Ratios across strata]")
    for ps in ["1-50", "51-100", ">100"]:
        for mhc in [0, 1, covid_df["mh_count"].mean()]:
            L = pd.Series(0.0, index=params_1a.index)
            L["is_bcg"] = 1.0
            if ps == "51-100":
                L["is_bcg:C(patients_seen)[T.51-100]"] = 1.0
            elif ps == ">100":
                L["is_bcg:C(patients_seen)[T.>100]"] = 1.0
            L["is_bcg:mh_count"] = mhc
            
            lin_comb = np.dot(L, params_1a)
            var = np.dot(L, np.dot(cov_1a, L))
            se = np.sqrt(var)
            pval = 2 * (1 - norm.cdf(abs(lin_comb / se)))
            or_v = np.exp(lin_comb)
            c_l = np.exp(lin_comb - 1.96 * se)
            c_h = np.exp(lin_comb + 1.96 * se)
            print(f"  patients_seen = {ps:>6}, mh_count = {mhc:.2f} -> OR = {or_v:.4f} (95% CI: {c_l:.4f} - {c_h:.4f}, p = {pval:.4f})")

    # Model 1B: Primary Cohort - Main Effects Model
    print("\n" + "-" * 60)
    print("Model 1B: Primary Cohort (N=197) - Main Effects Model")
    print("Formula: covid_hs ~ is_bcg + mh_count + C(patients_seen)")
    mod_1b = OrderedModel.from_formula(
        "covid_hs ~ is_bcg + mh_count + C(patients_seen)", data=covid_df, distr="logit"
    )
    res_1b = mod_1b.fit(disp=False, method="bfgs")
    print(res_1b.summary().tables[1])
    b_coef = res_1b.params["is_bcg"]
    b_se = res_1b.bse["is_bcg"]
    b_p = res_1b.pvalues["is_bcg"]
    print(f"BCG Main Effect OR: {np.exp(b_coef):.4f} (95% CI: {np.exp(b_coef - 1.96 * b_se):.4f} - {np.exp(b_coef + 1.96 * b_se):.4f}, p = {b_p:.4f})")

    # Model 1C: Primary Cohort - Collapsed Severity Model with Interactions
    print("\n" + "-" * 60)
    print("Model 1C: Primary Cohort (N=197) - Collapsed Severity (0, 1, 2, 3+) Pairwise Interaction Model")
    mod_1c = OrderedModel.from_formula(
        "covid_hs_collapsed ~ (is_bcg + mh_count + C(patients_seen))**2", data=covid_df, distr="logit"
    )
    res_1c = mod_1c.fit(disp=False, method="bfgs")
    c_coef = res_1c.params["is_bcg"]
    c_se = res_1c.bse["is_bcg"]
    c_p = res_1c.pvalues["is_bcg"]
    print(f"BCG Baseline OR (Collapsed): {np.exp(c_coef):.4f} (95% CI: {np.exp(c_coef - 1.96 * c_se):.4f} - {np.exp(c_coef + 1.96 * c_se):.4f}, p = {c_p:.4f})")

    # Model 1D: Primary Cohort - Numeric Interaction Model
    print("\n" + "-" * 60)
    print("Model 1D: Primary Cohort (N=197) - Numeric Patient Frequency Pairwise Interaction Model")
    mod_1d = OrderedModel.from_formula(
        "covid_hs ~ (is_bcg + mh_count + patients_freq)**2", data=covid_df, distr="logit"
    )
    res_1d = mod_1d.fit(disp=False, method="bfgs")
    print(res_1d.summary().tables[1])

    # Cohort 2: Sensitivity Analysis - All Participants (N = 1000)
    print("\n" + "=" * 80)
    print("[Cohort 2] Sensitivity Analysis Cohort: All Trial Participants (N = 1000)")
    print("Uninfected = 0, Infected = AEHS + 1 (1-8)")
    dm["covid_sev_all"] = dm["covid_hs"].apply(lambda x: 0 if pd.isna(x) else int(x + 1))
    
    print("\nModel 2A: All Participants (N=1000) - Pairwise Interaction Model")
    mod_2a = OrderedModel.from_formula(
        "covid_sev_all ~ (is_bcg + mh_count + C(patients_seen))**2", data=dm, distr="logit"
    )
    res_2a = mod_2a.fit(disp=False, method="bfgs")
    print(res_2a.summary().tables[1])
    a_coef = res_2a.params["is_bcg"]
    a_se = res_2a.bse["is_bcg"]
    a_p = res_2a.pvalues["is_bcg"]
    print(f"BCG Baseline OR (All cohort): {np.exp(a_coef):.4f} (95% CI: {np.exp(a_coef - 1.96 * a_se):.4f} - {np.exp(a_coef + 1.96 * a_se):.4f}, p = {a_p:.4f})")

    print("\nModel 2B: All Participants (N=1000) - Main Effects Model")
    mod_2b = OrderedModel.from_formula(
        "covid_sev_all ~ is_bcg + mh_count + C(patients_seen)", data=dm, distr="logit"
    )
    res_2b = mod_2b.fit(disp=False, method="bfgs")
    print(res_2b.summary().tables[1])
    m_coef = res_2b.params["is_bcg"]
    m_se = res_2b.bse["is_bcg"]
    m_p = res_2b.pvalues["is_bcg"]
    print(f"BCG Main Effect OR (All cohort): {np.exp(m_coef):.4f} (95% CI: {np.exp(m_coef - 1.96 * m_se):.4f} - {np.exp(m_coef + 1.96 * m_se):.4f}, p = {m_p:.4f})")

    print("\n" + "=" * 80)
    print("Analysis completed successfully.")
    print("=" * 80)

if __name__ == "__main__":
    main()
