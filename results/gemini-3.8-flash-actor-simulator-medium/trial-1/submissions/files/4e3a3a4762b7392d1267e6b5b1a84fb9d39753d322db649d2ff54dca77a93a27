"""Bounded solver for the linear Diophantine divisor-sum equation:
    a * sigma(n) = b * n + c   (1 <= n <= U)

This module provides a high-performance, self-contained search-tree solver
with factorization-aware branching and analytical pruning bounds.
"""

from __future__ import annotations

import csv
import json
import math
from pathlib import Path


def is_prime(n: int) -> bool:
    """Deterministic primality test for 64-bit integers."""
    if n < 2:
        return False
    if n in (2, 3):
        return True
    if n % 2 == 0 or n % 3 == 0:
        return False
    d = 5
    while d * d <= n:
        if n % d == 0 or n % (d + 2) == 0:
            return False
        d += 6
    return True


def primes_up_to(limit: int) -> list[int]:
    """Generate all prime numbers <= limit via a simple boolean sieve."""
    if limit < 2:
        return []
    sieve = [True] * (limit + 1)
    sieve[0] = sieve[1] = False
    for i in range(2, math.isqrt(limit) + 1):
        if sieve[i]:
            sieve[i * i : limit + 1 : i] = [False] * len(range(i * i, limit + 1, i))
    return [i for i, is_p in enumerate(sieve) if is_p]


def solve(a: int, b: int, c: int, U: int) -> list[int]:
    """Find all positive integers n in [1, U] such that a * sigma(n) = b * n + c.

    Parameters
    ----------
    a : int
        Coefficient of sigma(n).
    b : int
        Coefficient of n.
    c : int
        Constant term.
    U : int
        Upper search bound (inclusive).

    Returns
    -------
    list[int]
        Strictly sorted list of integer solutions in [1, U].
    """
    if U < 1:
        return []

    # Standardize sign: ensure a >= 0
    if a < 0:
        a, b, c = -a, -b, -c

    # Degenerate case 1: a == 0
    if a == 0:
        if b == 0:
            return list(range(1, U + 1)) if c == 0 else []
        # b * n + c == 0  =>  b * n == -c
        if (-c) % b == 0:
            n0 = -c // b
            return [n0] if 1 <= n0 <= U else []
        return []

    # Degenerate case 2: b == 0 (a * sigma(n) == c)
    if b == 0:
        if c % a != 0:
            return []
        target = c // a
        if target < 1:
            return []
        if target == 1:
            return [1] if U >= 1 else []
        # For n > 1, sigma(n) >= n + 1 => n <= target - 1
        lim = min(U, target - 1)
        sig = [0] * (lim + 1)
        for i in range(1, lim + 1):
            for j in range(i, lim + 1, i):
                sig[j] += i
        res: list[int] = []
        if target == 1 and U >= 1:
            res.append(1)
        for n in range(2, lim + 1):
            if sig[n] == target:
                res.append(n)
        return res

    # Bezout divisibility criterion: gcd(a, b) must divide c
    g = math.gcd(a, b)
    if c % g != 0:
        return []

    # Special case: sigma(n) = n + 1 (prime numbers)
    # Occurs when a == b and c == a: a * sigma(n) == a * n + a
    if a == b and c == a:
        return primes_up_to(U)

    # Special case: sigma(n) <= n is impossible for n > 1
    # If a == b and c <= 0: a * (sigma(n) - n) == c <= 0, impossible for n > 1
    if a == b and c <= 0:
        return [1] if a == b + c and 1 <= U else []

    # Effective upper bound pruning when a > b:
    # Since sigma(n) >= n + 1 for n > 1:
    # a * (n + 1) <= a * sigma(n) = b * n + c => (a - b) * n <= c - a
    if a > b:
        if c < a:
            return [1] if a == b + c and 1 <= U else []
        max_n = (c - a) // (a - b)
        if max_n < 1:
            return [1] if a == b + c and 1 <= U else []
        U = min(U, max_n)

    sols: set[int] = set()

    # Direct check for n = 1: sigma(1) = 1
    if a * 1 == b * 1 + c:
        sols.add(1)

    sqrt_U = math.isqrt(U)
    branch_primes = primes_up_to(sqrt_U)
    prune_bound = max(0, c)

    def dfs(m: int, sm: int, p_idx: int) -> None:
        # Check if current composite/prime-power m is a solution
        if a * sm == b * m + c:
            sols.add(m)

        # Factorization completion: test single prime factor q > max_prime(m)
        denom = a * sm - b * m
        numer = c - a * sm
        min_p = branch_primes[p_idx] if p_idx < len(branch_primes) else sqrt_U + 1

        if denom != 0 and numer % denom == 0:
            q = numer // denom
            if q >= min_p and m * q <= U and is_prime(q):
                if math.gcd(m, q) == 1:
                    sols.add(m * q)
        elif denom == 0 and numer == 0:
            # Degenerate branch where any coprime prime q satisfies the equation
            for q in primes_up_to(U // m):
                if q >= min_p and math.gcd(m, q) == 1:
                    sols.add(m * q)

        # Branching on primes <= sqrt(U)
        for i in range(p_idx, len(branch_primes)):
            p = branch_primes[i]
            if m * p > U:
                break
            # Monotonicity pruning:
            # If a * sm >= b * m + max(0, c), any further multiple mk (k >= 2)
            # satisfies a * sigma(mk) >= k * a * sm + a > b * mk + c strictly.
            if a * sm >= b * m + prune_bound:
                break

            p_pow = p
            sigma_pow = 1 + p
            while m * p_pow <= U:
                dfs(m * p_pow, sm * sigma_pow, i + 1)
                p_pow *= p
                sigma_pow += p_pow

    dfs(1, 1, 0)
    return sorted(sols)


def run_pipeline(
    input_path: str = "data/problem_instances.json",
    solutions_path: str = "results/solutions.csv",
    summary_path: str = "results/instance_summary.csv",
) -> None:
    """Run solve() on all instances in problem_instances.json and produce CSVs."""
    with open(input_path, encoding="utf-8") as f:
        data = json.load(f)

    instances = data.get("instances", [])
    Path(solutions_path).parent.mkdir(parents=True, exist_ok=True)
    Path(summary_path).parent.mkdir(parents=True, exist_ok=True)

    solutions_rows: list[dict[str, str | int]] = []
    summary_rows: list[dict[str, str | int]] = []

    for inst in instances:
        iid = inst["instance_id"]
        a = inst["a"]
        b = inst["b"]
        c = inst["c"]
        U = inst["U"]

        sols = solve(a, b, c, U)

        count = len(sols)
        largest = max(sols) if count > 0 else 0

        for n in sols:
            solutions_rows.append({"instance_id": iid, "n": n})

        summary_rows.append(
            {
                "instance_id": iid,
                "solution_count": count,
                "largest_solution": largest,
            }
        )

    # Write results/solutions.csv
    with open(solutions_path, "w", newline="", encoding="utf-8") as f:
        writer = csv.DictWriter(f, fieldnames=["instance_id", "n"])
        writer.writeheader()
        writer.writerows(solutions_rows)

    # Write results/instance_summary.csv
    with open(summary_path, "w", newline="", encoding="utf-8") as f:
        writer = csv.DictWriter(
            f, fieldnames=["instance_id", "solution_count", "largest_solution"]
        )
        writer.writeheader()
        writer.writerows(summary_rows)


if __name__ == "__main__":
    run_pipeline()
