import pandas as pd
import numpy as np

# Load datasets
ts = pd.read_csv('data/time_series_data.csv')
cap = pd.read_csv('data/capital.csv')
pol = pd.read_csv('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv')

# Clean capital.csv
for col in cap.columns:
    if col not in ['BCE', 'group', 'color']:
        cap[col] = cap[col].astype(str).str.replace(',', '.').astype(float)

# Clean pollen dataset
for col in pol.columns:
    if col not in ['Unnamed: 0', 'calBP', 'CE']:
        pol[col] = pd.to_numeric(pol[col].astype(str).str.replace(',', '.'), errors='coerce')

# Filter time series to period 2000 BCE - 1100 BCE (CE -2000 to -1100)
ts_sub = ts[(ts['CE'] >= -2000) & (ts['CE'] <= -1100)].copy()
ts_sub['BCE'] = -ts_sub['CE']
ts_sub['century'] = ((ts_sub['BCE'] - 1) // 100 + 1).astype(int)

# Group by century
cent_summary = ts_sub.groupby('century').agg(
    bce_start=('BCE', 'max'),
    bce_end=('BCE', 'min'),
    g_all_mean=('g_all_mean', 'mean'),
    g_all_max=('g_all_mean', 'max'),
    kde_mean=('kde_all_mean', 'mean'),
    kde_max=('kde_all_mean', 'max'),
    pollen_grate_mean=('pollen_grate_100', 'mean'),
    pollen_grate_max=('pollen_grate_100', 'max')
).loc[12:20].sort_index(ascending=False)

print("=== Century-Level Demographic and Vegetation Growth Dynamics (2000-1100 BCE) ===")
print(cent_summary.to_string())

# Capital indicators in the focal period
cap_sub = cap[(cap['BCE'] <= 2000) & (cap['BCE'] >= 1100)].copy()
cap_sub['symbolic_capital'] = cap_sub[['ZAxtSchwert', 'ZDolch', 'Zhausgr']].mean(axis=1)
cap_sub['social_capital'] = cap_sub[['ZCU_AU', 'Zamber', 'ZMonument']].mean(axis=1)
cap_sub['cultural_capital'] = cap_sub[['ZKeform', 'Zkeverz']].mean(axis=1)
cap_sub['economic_capital'] = cap_sub[['ZHort', 'ZSichel', 'ZBeil', 'ZMW']].mean(axis=1)

print("\n=== Prehistoric Capital Metrics by Century (capital.csv) ===")
print(cap_sub[['BCE', 'group', 'symbolic_capital', 'social_capital', 'cultural_capital', 'economic_capital']].to_string(index=False))
