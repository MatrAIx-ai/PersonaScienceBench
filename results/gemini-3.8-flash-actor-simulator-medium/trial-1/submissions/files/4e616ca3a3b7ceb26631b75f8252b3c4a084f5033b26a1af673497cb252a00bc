import pandas as pd
import statsmodels.formula.api as smf

# Load processed data
df = pd.read_csv('data/nls_ses_processed.csv')
df.columns = [c.replace(' ', '_').replace(':', '_') for c in df.columns]
df['BA'] = df['BA_DEGREE_COMPLETED'].astype(int)

# Encoding SAMPLE_RACE
race_order = {'Hispanic': 0, 'Black': 1, 'White': 2}
df['SAMPLE_RACE_encoded'] = df['SAMPLE_RACE'].map(race_order)

# Model 1: Controlling for SES
model1 = smf.logit('BA ~ SAMPLE_RACE_encoded + SES', data=df).fit()
print('=== Model 1: Effect of SAMPLE_RACE controlling for SES ===')
print(model1.summary())

# Model 2: Controlling for both SES and academic characteristics
model2 = smf.logit(
    'BA ~ SAMPLE_RACE_encoded + SES + ABILITY__COMPOSITE_OF_ASVAB_SCORE + PERCENTILE_IN_CLASS',
    data=df
).fit()
print('\n=== Model 2: Effect of SAMPLE_RACE controlling for both SES and academic characteristics ===')
print(model2.summary())

coef1 = model1.params['SAMPLE_RACE_encoded']
p1 = model1.pvalues['SAMPLE_RACE_encoded']
coef2 = model2.params['SAMPLE_RACE_encoded']
p2 = model2.pvalues['SAMPLE_RACE_encoded']

print(f'\nModel 1 SAMPLE_RACE coefficient: {coef1:.4f} (p = {p1:.6e})')
print(f'Model 2 SAMPLE_RACE coefficient: {coef2:.4f} (p = {p2:.4f})')
