#!/usr/bin/env python3
"""
Process-Based 3-Layer Snowpack Dynamics Model
"""
import os, sys, json
import numpy as np
import pandas as pd

if '/usr/lib/python3/dist-packages' not in sys.path:
    sys.path.append('/usr/lib/python3/dist-packages')

from PIL import Image, ImageDraw, ImageFont

C_ICE = 2100.0         # J / (kg * K)
C_LIQ = 4182.0         # J / (kg * K)
L_F = 3.34e5           # J / kg
T_F = 273.15           # K
SIGMA = 5.670374e-8    # W / (m^2 * K^4)
EMISS_SNOW = 0.98      # Snow emissivity
H_C = 12.0             # Convective heat transfer coeff, W / (m^2 * K)
RHO_ICE = 917.0        # kg / m^3
RHO_FRESH = 100.0      # kg / m^3
S_W_MAX = 0.05         # Capillary capacity fraction
GRAVITY = 9.80665      # m / s^2

# Compaction parameters (Anderson 1976 / Jordan 1991 / Niu & Yang 2007)
C1_MET = 2.778e-6      # s^-1
C2_MET = 0.04          # K^-1
ETA_0 = 3.6e6          # N * s / m^2
ETA_TEMP_COEFF = 0.08  # K^-1
ETA_RHO_COEFF = 0.021  # m^3 / kg

def run_snowpack_simulation(init_path='data/snowpack_init.json',
                            forcing_path='data/forcing.csv',
                            output_dir='results'):
    os.makedirs(output_dir, exist_ok=True)
    with open(init_path, 'r') as fp:
        init_json = json.load(fp)

    assert init_json['n_layers'] == 3, 'Expected 3 layers'
    thickness = np.array([l['thickness_m'] for l in init_json['layers']], dtype=np.float64)
    ice = np.array([l['ice_mm'] for l in init_json['layers']], dtype=np.float64)
    liq = np.array([l['liq_mm'] for l in init_json['layers']], dtype=np.float64)
    temp = np.array([l['temp_K'] for l in init_json['layers']], dtype=np.float64)
    density = (ice + liq) / thickness

    forcing_df = pd.read_csv(forcing_path)
    n_hours = len(forcing_df)
    n_days = n_hours // 24

    daily_snow_state = np.zeros((n_days, 3, 5), dtype=np.float64)
    summary_records = []

    albedo = 0.80
    swe_init = float(np.sum(ice + liq))
    cum_snowfall = 0.0
    cum_rainfall = 0.0
    cum_runoff = 0.0
    cum_melt = 0.0
    cum_refreeze = 0.0
    dt = 3600.0

    for day in range(n_days):
        day_melt = 0.0
        day_refreeze = 0.0
        day_runoff = 0.0

        for h in range(24):
            step = day * 24 + h
            row = forcing_df.iloc[step]
            snowfall_hr = float(row['snowfall_mm_hr'])
            rainfall_hr = float(row['rainfall_mm_hr'])
            t_air = float(row['t_air_K'])
            sw_in = float(row['sw_in_wm2'])
            lw_in = float(row['lw_in_wm2'])

            cum_snowfall += snowfall_hr
            cum_rainfall += rainfall_hr

            if snowfall_hr > 0.0:
                albedo = min(0.85, albedo + 0.05 * snowfall_hr)
            else:
                albedo = max(0.68, albedo - 0.00015)

            # Step A: Precipitation Addition
            if snowfall_hr > 0.0:
                dD = snowfall_hr / RHO_FRESH
                thickness[0] += dD
                t_snow = min(t_air, T_F)
                c_old = ice[0] * C_ICE + liq[0] * C_LIQ
                c_add = snowfall_hr * C_ICE
                temp[0] = (c_old * temp[0] + c_add * t_snow) / (c_old + c_add)
                ice[0] += snowfall_hr
                density[0] = (ice[0] + liq[0]) / thickness[0]

            if rainfall_hr > 0.0:
                liq[0] += rainfall_hr
                density[0] = (ice[0] + liq[0]) / thickness[0]

            # Step B: Thermal Conduction & Surface Energy Balance
            density = (ice + liq) / thickness
            k_eff = 0.021 + 2.5e-6 * (density ** 2)
            k01 = 1.0 / (0.5 * thickness[0] / k_eff[0] + 0.5 * thickness[1] / k_eff[1])
            k12 = 1.0 / (0.5 * thickness[1] / k_eff[1] + 0.5 * thickness[2] / k_eff[2])
            C_layer = ice * C_ICE + liq * C_LIQ

            h_rad = 4.0 * EMISS_SNOW * SIGMA * (temp[0] ** 3)
            q_surf0 = ((1.0 - albedo) * sw_in +
                       EMISS_SNOW * lw_in -
                       EMISS_SNOW * SIGMA * (temp[0] ** 4) +
                       H_C * (t_air - temp[0]))

            A = np.zeros((3, 3), dtype=np.float64)
            B = np.zeros(3, dtype=np.float64)

            A[0, 0] = C_layer[0] / dt + (H_C + h_rad) + k01
            A[0, 1] = -k01
            B[0] = (C_layer[0] / dt) * temp[0] + q_surf0 + (H_C + h_rad) * temp[0]

            A[1, 0] = -k01
            A[1, 1] = C_layer[1] / dt + k01 + k12
            A[1, 2] = -k12
            B[1] = (C_layer[1] / dt) * temp[1]

            A[2, 1] = -k12
            A[2, 2] = C_layer[2] / dt + k12
            B[2] = (C_layer[2] / dt) * temp[2]

            temp = np.linalg.solve(A, B)

            # Step C: Phase Change
            step_melt = np.zeros(3, dtype=np.float64)
            for i in range(3):
                C_i = ice[i] * C_ICE + liq[i] * C_LIQ
                if temp[i] > T_F:
                    q_excess = C_i * (temp[i] - T_F)
                    dm_melt = min(ice[i], q_excess / L_F)
                    ice[i] -= dm_melt
                    liq[i] += dm_melt
                    step_melt[i] += dm_melt
                    day_melt += dm_melt
                    cum_melt += dm_melt

                    q_rem = q_excess - dm_melt * L_F
                    C_i = ice[i] * C_ICE + liq[i] * C_LIQ
                    temp[i] = T_F + (q_rem / C_i if C_i > 0.0 else 0.0)

                elif temp[i] < T_F and liq[i] > 0.0:
                    q_deficit = C_i * (T_F - temp[i])
                    dm_refr = min(liq[i], q_deficit / L_F)
                    ice[i] += dm_refr
                    liq[i] -= dm_refr
                    day_refreeze += dm_refr
                    cum_refreeze += dm_refr

                    C_i = ice[i] * C_ICE + liq[i] * C_LIQ
                    temp[i] += (dm_refr * L_F / C_i if C_i > 0.0 else 0.0)

            # Step D: Liquid Water Retention & Percolation
            for i in range(3):
                max_liq = S_W_MAX * ice[i]
                if liq[i] > max_liq:
                    drain = liq[i] - max_liq
                    liq[i] = max_liq
                    if i < 2:
                        liq[i + 1] += drain
                        if temp[i + 1] < T_F:
                            C_next = ice[i + 1] * C_ICE + liq[i + 1] * C_LIQ
                            q_def = C_next * (T_F - temp[i + 1])
                            dm_refr = min(liq[i + 1], q_def / L_F)
                            ice[i + 1] += dm_refr
                            liq[i + 1] -= dm_refr
                            day_refreeze += dm_refr
                            cum_refreeze += dm_refr
                            C_next = ice[i + 1] * C_ICE + liq[i + 1] * C_LIQ
                            temp[i + 1] += (dm_refr * L_F / C_next if C_next > 0.0 else 0.0)
                    else:
                        day_runoff += drain
                        cum_runoff += drain

            # Step E: Compaction & Densification
            for i in range(3):
                cr_met = -C1_MET * np.exp(-C2_MET * max(0.0, T_F - temp[i]))
                if density[i] > 150.0:
                    cr_met *= np.exp(-0.046 * (density[i] - 150.0))

                m_above = np.sum(ice[:i] + liq[:i])
                m_self = ice[i] + liq[i]
                p_over = GRAVITY * (m_above + 0.5 * m_self)
                eta_i = (ETA_0 * (density[i] / 100.0) *
                         np.exp(ETA_TEMP_COEFF * max(0.0, T_F - temp[i])) *
                         np.exp(ETA_RHO_COEFF * (density[i] - 100.0)))
                cr_over = -p_over / eta_i

                cr_total = cr_met + cr_over
                thickness[i] = thickness[i] * max(0.05, 1.0 + cr_total * dt)

                if step_melt[i] > 0.0:
                    thickness[i] = max(0.01, thickness[i] - step_melt[i] / RHO_ICE)

                d_min = (ice[i] + liq[i]) / RHO_ICE
                if thickness[i] < d_min:
                    thickness[i] = d_min

                density[i] = (ice[i] + liq[i]) / thickness[i]

        for i in range(3):
            daily_snow_state[day, i, 0] = thickness[i]
            daily_snow_state[day, i, 1] = density[i]
            daily_snow_state[day, i, 2] = ice[i]
            daily_snow_state[day, i, 3] = liq[i]
            daily_snow_state[day, i, 4] = temp[i]

        day_swe = float(np.sum(ice + liq))
        day_depth = float(np.sum(thickness))
        day_mean_density = day_swe / day_depth

        summary_records.append({
            'day': int(day),
            'swe_mm': day_swe,
            'snow_depth_m': day_depth,
            'melt_mm': float(day_melt),
            'refreeze_mm': float(day_refreeze),
            'runoff_mm': float(day_runoff),
            'mean_density_kg_m3': day_mean_density
        })

    state_file = os.path.join(output_dir, 'snow_state.npy')
    np.save(state_file, daily_snow_state)

    summary_df = pd.DataFrame(summary_records)
    summary_file = os.path.join(output_dir, 'snow_summary.csv')
    summary_df.to_csv(summary_file, index=False)

    swe_final = float(np.sum(ice + liq))
    delta_swe = swe_final - swe_init
    total_precip = cum_snowfall + cum_rainfall
    mass_closure_error = total_precip - (delta_swe + cum_runoff)

    print("--- Water Mass Conservation Audit ---")
    print(f"Initial SWE:          {swe_init:16.6f} mm")
    print(f"Final SWE:            {swe_final:16.6f} mm")
    print(f"Delta SWE:            {delta_swe:16.6f} mm")
    print(f"Total Snowfall:       {cum_snowfall:16.6f} mm")
    print(f"Total Rainfall:       {cum_rainfall:16.6f} mm")
    print(f"Total Bottom Runoff:  {cum_runoff:16.6f} mm")
    print(f"Total Melt:           {cum_melt:16.6f} mm")
    print(f"Total Refreeze:       {cum_refreeze:16.6f} mm")
    print(f"Mass Closure Error:   {mass_closure_error:16.6e} mm")

    plot_file = os.path.join(output_dir, 'snow_evolution.png')
    generate_diagnostic_figure(summary_df, daily_snow_state, plot_file)

    return summary_df, daily_snow_state

def generate_diagnostic_figure(summary_df, daily_snow_state, output_png_path):
    width, height = 1500, 1100
    img = Image.new('RGB', (width, height), color=(255, 255, 255))
    draw = ImageDraw.Draw(img)

    font_path_bold = '/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf'
    font_path_reg = '/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf'

    font_main_title = ImageFont.truetype(font_path_bold, 24)
    font_sub_title = ImageFont.truetype(font_path_bold, 15)
    font_axis = ImageFont.truetype(font_path_reg, 12)
    font_legend = ImageFont.truetype(font_path_reg, 11)

    draw.text((width // 2 - 320, 25), "Process-Based 3-Layer Snowpack Dynamics & Mass Conservation",
              fill=(20, 30, 50), font=font_main_title)

    plots = [
        {'rect': (100, 90, 700, 520)},
        {'rect': (850, 90, 1450, 520)},
        {'rect': (100, 600, 700, 1030)},
        {'rect': (850, 600, 1450, 1030)}
    ]

    days = summary_df['day'].values
    n_days = len(days)

    def draw_axes_box(rect, title, xlabel, ylabel, y_min, y_max):
        x0, y0, x1, y1 = rect
        draw.rectangle([x0, y0, x1, y1], fill=(250, 252, 255), outline=(180, 190, 205), width=2)
        draw.text((x0 + 15, y0 + 12), title, fill=(30, 40, 60), font=font_sub_title)
        draw.text((x0 + (x1 - x0) // 2 - 40, y1 + 18), xlabel, fill=(40, 40, 40), font=font_axis)
        draw.text((x0 - 75, y0 - 15), ylabel, fill=(40, 40, 40), font=font_axis)

        n_ticks = 5
        for t in range(n_ticks + 1):
            val = y_min + (y_max - y_min) * (t / n_ticks)
            py = y1 - (val - y_min) / (y_max - y_min) * (y1 - y0)
            draw.line([(x0, py), (x1, py)], fill=(225, 230, 240), width=1)
            draw.text((x0 - 55, py - 6), f"{val:.1f}", fill=(80, 80, 80), font=font_axis)

        for d in range(0, n_days + 1, 10):
            if d > n_days - 1:
                d = n_days - 1
            px = x0 + (d / (n_days - 1)) * (x1 - x0)
            draw.line([(px, y0), (px, y1)], fill=(225, 230, 240), width=1)
            draw.text((px - 8, y1 + 4), f"{d}", fill=(80, 80, 80), font=font_axis)

    # Panel 1: Depth & SWE
    r1 = plots[0]['rect']
    depths = summary_df['snow_depth_m'].values
    swes = summary_df['swe_mm'].values
    y_min, y_max = 0.0, 1.5
    draw_axes_box(r1, "(a) Total Snow Depth & Snow Water Equivalent", "Simulation Day", "Depth (m)", y_min, y_max)

    pts_depth = [(r1[0] + (d / (n_days - 1)) * (r1[2] - r1[0]),
                  r1[3] - (depths[d] - y_min) / (y_max - y_min) * (r1[3] - r1[1])) for d in range(n_days)]
    draw.line(pts_depth, fill=(20, 100, 200), width=3)

    swe_min, swe_max = 180.0, 300.0
    pts_swe = [(r1[0] + (d / (n_days - 1)) * (r1[2] - r1[0]),
                r1[3] - (swes[d] - swe_min) / (swe_max - swe_min) * (r1[3] - r1[1])) for d in range(n_days)]
    draw.line(pts_swe, fill=(200, 50, 30), width=3)

    for val in np.linspace(swe_min, swe_max, 5):
        py = r1[3] - (val - swe_min) / (swe_max - swe_min) * (r1[3] - r1[1])
        draw.text((r1[2] + 8, py - 6), f"{val:.0f}", fill=(180, 40, 20), font=font_axis)
    draw.text((r1[2] + 12, r1[1] - 15), "SWE (mm)", fill=(180, 40, 20), font=font_axis)

    draw.line([(r1[0] + 30, r1[1] + 45), (r1[0] + 65, r1[1] + 45)], fill=(20, 100, 200), width=3)
    draw.text((r1[0] + 75, r1[1] + 38), "Snow Depth (m)", fill=(20, 100, 200), font=font_legend)
    draw.line([(r1[0] + 200, r1[1] + 45), (r1[0] + 235, r1[1] + 45)], fill=(200, 50, 30), width=3)
    draw.text((r1[0] + 245, r1[1] + 38), "SWE (mm)", fill=(200, 50, 30), font=font_legend)

    # Panel 2: Melt & Refreeze
    r2 = plots[1]['rect']
    melts = summary_df['melt_mm'].values
    refreezes = summary_df['refreeze_mm'].values
    max_flux = max(1.0, float(max(np.max(melts), np.max(refreezes)) * 1.25))
    draw_axes_box(r2, "(b) Daily Phase Change Fluxes (Melt & Refreeze)", "Simulation Day", "Flux (mm/day)", 0.0, max_flux)

    bar_w = (r2[2] - r2[0]) / n_days * 0.4
    for d in range(n_days):
        cx = r2[0] + (d / (n_days - 1)) * (r2[2] - r2[0])
        h_melt = (melts[d] / max_flux) * (r2[3] - r2[1])
        if h_melt > 0:
            draw.rectangle([cx - bar_w, r2[3] - h_melt, cx, r2[3]], fill=(220, 100, 20), outline=(180, 70, 10))
        h_refr = (refreezes[d] / max_flux) * (r2[3] - r2[1])
        if h_refr > 0:
            draw.rectangle([cx, r2[3] - h_refr, cx + bar_w, r2[3]], fill=(60, 140, 220), outline=(30, 90, 180))

    draw.rectangle([r2[0] + 30, r2[1] + 40, r2[0] + 50, r2[1] + 52], fill=(220, 100, 20))
    draw.text((r2[0] + 58, r2[1] + 38), "Melt (mm/day)", fill=(40, 40, 40), font=font_legend)
    draw.rectangle([r2[0] + 180, r2[1] + 40, r2[0] + 200, r2[1] + 52], fill=(60, 140, 220))
    draw.text((r2[0] + 208, r2[1] + 38), "Refreeze (mm/day)", fill=(40, 40, 40), font=font_legend)

    # Panel 3: Densities
    r3 = plots[2]['rect']
    rho0 = daily_snow_state[:, 0, 1]
    rho1 = daily_snow_state[:, 1, 1]
    rho2 = daily_snow_state[:, 2, 1]
    rho_mean = summary_df['mean_density_kg_m3'].values
    draw_axes_box(r3, "(c) Bulk & Individual Layer Density Evolution", "Simulation Day", "Density (kg/m3)", 80.0, 550.0)

    def draw_curve(y_arr, color, width_line=2):
        pts = [(r3[0] + (d / (n_days - 1)) * (r3[2] - r3[0]),
                r3[3] - (y_arr[d] - 80.0) / (550.0 - 80.0) * (r3[3] - r3[1])) for d in range(n_days)]
        draw.line(pts, fill=color, width=width_line)

    draw_curve(rho0, (30, 140, 180), width_line=2)
    draw_curve(rho1, (180, 130, 30), width_line=2)
    draw_curve(rho2, (150, 40, 140), width_line=2)
    draw_curve(rho_mean, (20, 20, 20), width_line=3)

    leg_items = [("Layer 0 (Top)", (30, 140, 180)),
                 ("Layer 1 (Mid)", (180, 130, 30)),
                 ("Layer 2 (Bot)", (150, 40, 140)),
                 ("Mean Density", (20, 20, 20))]
    lx = r3[0] + 20
    for label, col in leg_items:
        draw.line([(lx, r3[1] + 45), (lx + 25, r3[1] + 45)], fill=col, width=3)
        draw.text((lx + 32, r3[1] + 38), label, fill=(40, 40, 40), font=font_legend)
        lx += 135

    # Panel 4: Temperatures
    r4 = plots[3]['rect']
    t0 = daily_snow_state[:, 0, 4]
    t1 = daily_snow_state[:, 1, 4]
    t2 = daily_snow_state[:, 2, 4]
    draw_axes_box(r4, "(d) Layer Temperature Dynamics", "Simulation Day", "Temp (K)", 260.0, 275.0)

    py_freeze = r4[3] - (273.15 - 260.0) / 15.0 * (r4[3] - r4[1])
    draw.line([(r4[0], py_freeze), (r4[2], py_freeze)], fill=(200, 30, 30), width=1)
    draw.text((r4[2] - 110, py_freeze - 15), "T_f = 273.15 K", fill=(180, 20, 20), font=font_legend)

    def draw_temp_curve(y_arr, color):
        pts = [(r4[0] + (d / (n_days - 1)) * (r4[2] - r4[0]),
                r4[3] - (y_arr[d] - 260.0) / 15.0 * (r4[3] - r4[1])) for d in range(n_days)]
        draw.line(pts, fill=color, width=2)

    draw_temp_curve(t0, (30, 140, 180))
    draw_temp_curve(t1, (180, 130, 30))
    draw_temp_curve(t2, (150, 40, 140))

    lx = r4[0] + 20
    for label, col in [("Layer 0 (Top)", (30, 140, 180)),
                      ("Layer 1 (Mid)", (180, 130, 30)),
                      ("Layer 2 (Bot)", (150, 40, 140))]:
        draw.line([(lx, r4[1] + 45), (lx + 25, r4[1] + 45)], fill=col, width=3)
        draw.text((lx + 32, r4[1] + 38), label, fill=(40, 40, 40), font=font_legend)
        lx += 140

    img.save(output_png_path, format='PNG')


if __name__ == '__main__':
    run_snowpack_simulation()
