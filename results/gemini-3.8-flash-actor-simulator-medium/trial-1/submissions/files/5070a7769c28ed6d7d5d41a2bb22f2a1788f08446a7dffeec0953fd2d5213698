import sys
import os
import struct
import numpy as np
import pandas as pd
from scipy import stats

# Ensure olefile from system dist-packages can be imported if needed
if '/usr/lib/python3/dist-packages' not in sys.path:
    sys.path.append('/usr/lib/python3/dist-packages')
import olefile

def parse_xls_sheet(file_path):
    """
    Parses the BIFF8 XLS file directly using olefile and struct unpack.
    """
    ole = olefile.OleFileIO(file_path)
    stream = ole.openstream('Workbook').read()
    
    # 1. Parse Shared String Table (SST)
    pos = 0
    sst = []
    while pos < len(stream):
        rec_type, rec_len = struct.unpack('<HH', stream[pos:pos+4])
        if rec_type == 0x00FC: # SST
            data = stream[pos+4:pos+4+rec_len]
            total_str, unique_str = struct.unpack('<II', data[0:8])
            p = 8
            for _ in range(unique_str):
                cch, flags = struct.unpack('<HB', data[p:p+3])
                p += 3
                rich = bool(flags & 0x08)
                phonetic = bool(flags & 0x04)
                cRun = struct.unpack('<H', data[p:p+2])[0] if rich else 0
                if rich: p += 2
                cbExtRst = struct.unpack('<I', data[p:p+4])[0] if phonetic else 0
                if phonetic: p += 4
                is_unicode = bool(flags & 0x01)
                str_len = cch * 2 if is_unicode else cch
                s = data[p:p+str_len].decode('utf-16le' if is_unicode else 'latin1')
                p += str_len
                if rich: p += 4 * cRun
                if phonetic: p += cbExtRst
                sst.append(s)
            break
        pos += 4 + rec_len

    # 2. Parse Cells
    cells = {}
    pos = 0
    while pos < len(stream):
        rec_type, rec_len = struct.unpack('<HH', stream[pos:pos+4])
        data = stream[pos+4:pos+4+rec_len]
        if rec_type == 0x00FD: # LABELSST
            row, col, xf, sst_idx = struct.unpack('<HHHI', data)
            cells[(row, col)] = sst[sst_idx]
        elif rec_type == 0x0203: # NUMBER
            row, col, xf = struct.unpack('<HHH', data[:6])
            val = struct.unpack('<d', data[6:14])[0]
            cells[(row, col)] = val
        pos += 4 + rec_len

    headers = [cells.get((1, c)) for c in range(21)]
    patient_cols = [c for c in range(1, 11)] # P_1 to P_10
    control_cols = [c for c in range(11, 21)] # C_11 to C_20
    
    rows = []
    for r in range(2, 177):
        mirna = cells.get((r, 0))
        pat_vals = []
        for c in patient_cols:
            v = cells.get((r, c))
            pat_vals.append(np.nan if v is None or v == 'NAN' else float(v))
        ctrl_vals = []
        for c in control_cols:
            v = cells.get((r, c))
            ctrl_vals.append(np.nan if v is None or v == 'NAN' else float(v))
        rows.append({
            'miRNA': mirna,
            'patient_vals': pat_vals,
            'control_vals': ctrl_vals
        })
    return rows

def analyze_differential_expression(data_rows):
    results = []
    for entry in data_rows:
        mirna = entry['miRNA']
        p_vals = np.array(entry['patient_vals'], dtype=float)
        c_vals = np.array(entry['control_vals'], dtype=float)
        
        # Student's t-test (equal_var=True)
        t_stat_stud, p_val_stud = stats.ttest_ind(p_vals, c_vals, equal_var=True, nan_policy='omit')
        
        # Welch's t-test (equal_var=False)
        t_stat_welch, p_val_welch = stats.ttest_ind(p_vals, c_vals, equal_var=False, nan_policy='omit')
        
        # Mann-Whitney U test
        p_clean = p_vals[~np.isnan(p_vals)]
        c_clean = c_vals[~np.isnan(c_vals)]
        mwu_stat, p_val_mwu = stats.mannwhitneyu(p_clean, c_clean, alternative='two-sided')
        
        # Means and fold differences (Delta Ct)
        mean_patient = np.nanmean(p_vals)
        mean_control = np.nanmean(c_vals)
        delta_ct = mean_patient - mean_control
        
        results.append({
            'miRNA': mirna,
            'mean_patient': mean_patient,
            'mean_control': mean_control,
            'delta_ct': delta_ct,
            'student_t_stat': t_stat_stud,
            'student_p_value': p_val_stud,
            'student_significant': bool(p_val_stud < 0.05),
            'welch_t_stat': t_stat_welch,
            'welch_p_value': p_val_welch,
            'welch_significant': bool(p_val_welch < 0.05),
            'mwu_stat': mwu_stat,
            'mwu_p_value': p_val_mwu,
            'mwu_significant': bool(p_val_mwu < 0.05),
        })
        
    df_results = pd.DataFrame(results)
    return df_results

if __name__ == '__main__':
    data_path = 'data/pone.0150501.s002.xls'
    rows = parse_xls_sheet(data_path)
    df_res = analyze_differential_expression(rows)
    
    total_mirnas = len(df_res)
    student_sig_count = df_res['student_significant'].sum()
    student_pct = (student_sig_count / total_mirnas) * 100.0
    
    welch_sig_count = df_res['welch_significant'].sum()
    welch_pct = (welch_sig_count / total_mirnas) * 100.0
    
    mwu_sig_count = df_res['mwu_significant'].sum()
    mwu_pct = (mwu_sig_count / total_mirnas) * 100.0
    
    print("=" * 60)
    print("DIFFERENTIAL EXPRESSION ANALYSIS RESULTS (p < 0.05, unadjusted)")
    print("=" * 60)
    print(f"Total miRNAs analyzed: {total_mirnas}")
    print(f"Primary Test: Student's two-sample t-test (equal_var=True):")
    print(f"  Significant miRNAs: {student_sig_count} / {total_mirnas}")
    print(f"  Percentage: {student_pct:.4f}% ({student_pct:.2f}%)")
    print("-" * 60)
    print(f"Comparison: Welch's t-test (equal_var=False):")
    print(f"  Significant miRNAs: {welch_sig_count} / {total_mirnas}")
    print(f"  Percentage: {welch_pct:.4f}% ({welch_pct:.2f}%)")
    print("-" * 60)
    print(f"Comparison: Mann-Whitney U test (two-sided):")
    print(f"  Significant miRNAs: {mwu_sig_count} / {total_mirnas}")
    print(f"  Percentage: {mwu_pct:.4f}% ({mwu_pct:.2f}%)")
    print("=" * 60)
    
    output_csv = 'differential_expression_results.csv'
    df_res.to_csv(output_csv, index=False)
    print(f"Detailed results saved to {output_csv}")
