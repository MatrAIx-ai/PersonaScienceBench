"""
Analysis script investigating:
In what scenario did urban land use promote a specific type of plant invasion?
"""

import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf

def main():
    # 1. Load data
    inp = pd.read_csv('data/invaded_niche_pathways.csv', sep='\t')
    inp.columns = [c.replace('.', '_') for c in inp.columns]
    isp = pd.read_csv('data/invasion_success_pathways.csv')
    tt = pd.read_csv('data/temporal_trends_contingency_table.csv', sep='\t')

    # Historical expansion differences
    inp['urban_diff_50m'] = inp['urban_2009_50m'] - inp['urban_1956_50m']
    inp['urban_diff_500m'] = inp['urban_2009_500m'] - inp['urban_1956_500m']
    inp['urban_diff_1000m'] = inp['urban_2009_1000m'] - inp['urban_1956_1000m']

    pathways = ['n_unint', 'n_gard', 'n_agfo']
    covariates = "elevation + distance_road + distance_stream + annual_temperature + annual_rainfall"

    print("="*60)
    print("1. MULTIVARIABLE POISSON GLM WITH HC1 ROBUST STANDARD ERRORS")
    print("="*60)
    for scale in ['50m', '500m', '1000m']:
        var = f'urban_2009_{scale}'
        print(f"\n--- Landscape Scale: {scale} (Year: 2009) ---")
        for p in pathways:
            formula = f"{p} ~ {var} + {covariates}"
            m = smf.glm(formula, data=inp, family=sm.families.Poisson()).fit(cov_type='HC1')
            coef = m.params[var]
            se = m.bse[var]
            pval = m.pvalues[var]
            irr = np.exp(coef)
            ci_low = np.exp(coef - 1.96 * se)
            ci_high = np.exp(coef + 1.96 * se)
            print(f"{p:10s} | coef={coef:+.4f} (SE={se:.4f}), z={m.tvalues[var]:+.3f}, p={pval:.4e}, IRR={irr:.3f} [95% CI: {ci_low:.3f}-{ci_high:.3f}]")

    print("\n" + "="*60)
    print("2. HISTORICAL URBAN EXPANSION (1956 -> 2009) WITH HC1 ROBUST SE")
    print("="*60)
    for scale in ['500m', '1000m']:
        diff = f'urban_diff_{scale}'
        print(f"\n--- Urban Expansion at {scale} Buffer ---")
        for p in pathways:
            formula = f"{p} ~ {diff} + {covariates}"
            m = smf.glm(formula, data=inp, family=sm.families.Poisson()).fit(cov_type='HC1')
            coef = m.params[diff]
            se = m.bse[diff]
            pval = m.pvalues[diff]
            irr = np.exp(coef)
            ci_low = np.exp(coef - 1.96 * se)
            ci_high = np.exp(coef + 1.96 * se)
            print(f"{p:10s} | coef={coef:+.4f} (SE={se:.4f}), z={m.tvalues[diff]:+.3f}, p={pval:.4e}, IRR={irr:.3f} [95% CI: {ci_low:.3f}-{ci_high:.3f}]")

    print("\n" + "="*60)
    print("3. WITHIN NON-URBAN NATURAL/SEMI-NATURAL HABITATS (n=567)")
    print("="*60)
    non_urban = inp[inp['habitat'] != 'Urban']
    for p in pathways:
        formula = f"{p} ~ urban_2009_1000m + elevation + distance_road"
        m = smf.glm(formula, data=non_urban, family=sm.families.Poisson()).fit(cov_type='HC1')
        coef = m.params['urban_2009_1000m']
        se = m.bse['urban_2009_1000m']
        pval = m.pvalues['urban_2009_1000m']
        irr = np.exp(coef)
        print(f"{p:10s} | coef={coef:+.4f} (SE={se:.4f}), p={pval:.4e}, IRR={irr:.3f}")

    print("\n" + "="*60)
    print("4. SPECIES TRAITS COMPARISON (invasion_success_pathways)")
    print("="*60)
    summary_traits = isp.groupby('intro.pathway').agg(
        n_species=('Scientific_name', 'count'),
        mean_plots=('number.of.invaded.plots', 'mean'),
        median_plots=('number.of.invaded.plots', 'median'),
        pct_annual=('growth.form', lambda x: (x == 'Annual fg').mean() * 100),
        mean_height=('height', 'mean')
    )
    print(summary_traits)

if __name__ == '__main__':
    main()
