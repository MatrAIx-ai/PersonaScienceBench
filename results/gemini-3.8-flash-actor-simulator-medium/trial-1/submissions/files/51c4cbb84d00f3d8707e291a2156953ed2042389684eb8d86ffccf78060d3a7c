import pandas as pd
import numpy as np
from scipy import stats

def run_analysis():
    df = pd.read_csv('data/meta-regression_joined_data_heterogeneity_in_replication_projects.csv')
    df['delta_r'] = df['ro'] - df['rr']
    df['delta_z'] = df['fiso'] - df['fisr']

    results = []
    disciplines = ['Cognitive', 'Social', 'Economics']

    for disc in disciplines:
        sub = df[df['discipline'] == disc]
        n = len(sub)
        
        # Paired tests
        t_stat_z, p_val_z = stats.ttest_rel(sub['fiso'], sub['fisr'])
        w_stat_z, p_val_w_z = stats.wilcoxon(sub['fiso'], sub['fisr'])
        t_stat_r, p_val_r = stats.ttest_rel(sub['ro'], sub['rr'])
        w_stat_r, p_val_w_r = stats.wilcoxon(sub['ro'], sub['rr'])
        
        results.append({
            'discipline': disc,
            'n': n,
            'prop_orig_larger_pct': (sub['ro'] > sub['rr']).mean() * 100,
            'mean_ro': sub['ro'].mean(),
            'mean_rr': sub['rr'].mean(),
            'mean_delta_r': sub['delta_r'].mean(),
            'median_delta_r': sub['delta_r'].median(),
            'mean_delta_z': sub['delta_z'].mean(),
            'median_delta_z': sub['delta_z'].median(),
            'mean_relative_es': sub['relative_es'].mean(),
            'median_relative_es': sub['relative_es'].median(),
            'iqr_relative_es': [sub['relative_es'].quantile(0.25), sub['relative_es'].quantile(0.75)],
            't_stat_z': t_stat_z,
            'p_val_z': p_val_z,
            'w_stat_z': w_stat_z,
            'p_val_w_z': p_val_w_z,
            't_stat_r': t_stat_r,
            'p_val_r': p_val_r,
            'w_stat_r': w_stat_r,
            'p_val_w_r': p_val_w_r,
            'replicated_rate': sub['replicated'].mean()
        })
        
    res_df = pd.DataFrame(results)
    return df, res_df

if __name__ == '__main__':
    df, res = run_analysis()
    print(res.to_string())
