#!/usr/bin/env python3
"""
Differential Gene Expression Analysis and Binomial Exact Test
for tissue comparisons from Paroxetine 2017 RNA-seq data.

Comparisons:
1. Final vs Baseline Blood
2. Dentate gyrus vs Baseline blood
3. Dentate gyrus vs Final blood
"""

import sys
import numpy as np
import pandas as pd
from scipy import stats
from statsmodels.stats.multitest import multipletests

def main():
    excel_path = 'data/Data_deposition_RNAseq_Paroxetine_2017.xlsx'
    print(f"Loading data from {excel_path}...")
    
    # Read NormCount sheet (header is row 3, 0-indexed)
    df = pd.read_excel(excel_path, sheet_name='NormCount', header=3)
    gene_ids = df['GeneID'].values
    n_total = len(gene_ids)
    
    # 30 samples each
    bl = df.iloc[:, 2:32].values.astype(float)   # baseline blood
    dg = df.iloc[:, 32:62].values.astype(float)  # dentate gyrus
    fi = df.iloc[:, 62:92].values.astype(float)  # final blood

    print(f"Total genes loaded: {n_total}")
    print(f"Samples per tissue: baseline_blood={bl.shape[1]}, dentate_gyrus={dg.shape[1]}, final_blood={fi.shape[1]}")

    # Log2 transformation: log2(count + 1)
    log_bl = np.log2(bl + 1)
    log_dg = np.log2(dg + 1)
    log_fi = np.log2(fi + 1)

    comparisons = [
        ("Final vs Baseline Blood", log_fi, log_bl),
        ("Dentate gyrus vs Baseline blood", log_dg, log_bl),
        ("Dentate gyrus vs Final blood", log_dg, log_fi),
    ]

    results = []

    print("\n" + "="*80)
    print("DIFFERENTIAL EXPRESSION AND STATISTICAL SUMMARY")
    print("="*80)

    for name, mat_A, mat_B in comparisons:
        # Welch's t-test per gene
        tt_res = stats.ttest_ind(mat_A, mat_B, axis=1, equal_var=False)
        pvals = np.nan_to_num(tt_res.pvalue, nan=1.0)
        
        # log2 fold change (A - B)
        mean_A = np.mean(mat_A, axis=1)
        mean_B = np.mean(mat_B, axis=1)
        log2fc = mean_A - mean_B

        # FDR correction
        _, padj, _, _ = multipletests(pvals, method='fdr_bh')

        # Differentially expressed gene counts
        n_p05 = np.sum(pvals < 0.05)
        n_padj05 = np.sum(padj < 0.05)
        
        # Biologically meaningful DEG with |log2FC| > 1 (2-fold change)
        deg_fc1 = (padj < 0.05) & (np.abs(log2fc) >= 1.0)
        n_deg_fc1 = np.sum(deg_fc1)
        prop_fc1 = n_deg_fc1 / n_total

        # Binomial exact test: H0: p <= 0.05 vs H1: p > 0.05
        # Tests whether the proportion of major DEGs exceeds a 5% threshold
        binom_test = stats.binomtest(n_deg_fc1, n_total, p=0.05, alternative='greater')
        
        # Paired sign test (binomial exact test per gene across 30 pairs)
        diff = mat_A - mat_B
        pos = (diff > 0).sum(axis=1)
        neg = (diff < 0).sum(axis=1)
        valid = (pos + neg) > 0
        p_sign = np.ones(n_total)
        for i in np.where(valid)[0]:
            p_sign[i] = stats.binomtest(pos[i], pos[i] + neg[i], p=0.5).pvalue
        n_sign_p05 = np.sum(p_sign < 0.05)

        results.append({
            "Comparison": name,
            "Raw p < 0.05": n_p05,
            "FDR padj < 0.05": n_padj05,
            "DEG (|log2FC|>=1 & padj<0.05)": n_deg_fc1,
            "DEG Proportion": prop_fc1,
            "Binomial Test (p0=0.05) p-value": binom_test.pvalue,
            "Binomial Test Statistic": binom_test.statistic,
            "Paired Sign Test (p < 0.05)": n_sign_p05,
        })

        print(f"\n--- {name} ---")
        print(f"  Genes with raw p < 0.05:               {n_p05} ({n_p05/n_total:.2%})")
        print(f"  Genes with FDR padj < 0.05:            {n_padj05} ({n_padj05/n_total:.2%})")
        print(f"  DEGs with |log2FC| >= 1 & padj < 0.05: {n_deg_fc1} ({prop_fc1:.2%})")
        print(f"  Binomial exact test (H0: p <= 0.05):   statistic = {binom_test.statistic:.4f}, p-value = {binom_test.pvalue:.4e}")
        print(f"  Paired sign test significant genes:    {n_sign_p05} ({n_sign_p05/n_total:.2%})")

    res_df = pd.DataFrame(results)
    print("\n" + "="*80)
    print("COMPARATIVE TABLE:")
    print(res_df.to_string(index=False))
    print("="*80)

    # Determine comparison with negligible effects
    negligible = res_df.loc[res_df['DEG (|log2FC|>=1 & padj<0.05)'].idxmin(), 'Comparison']
    print(f"\nConclusion: The tissue comparison with negligible effects is: '{negligible}'")
    
    # Save results to TSV
    res_df.to_csv("tissue_comparison_dge_summary.tsv", sep="\t", index=False)
    print("Summary saved to tissue_comparison_dge_summary.tsv")

if __name__ == '__main__':
    main()
