#!/usr/bin/env python3
"""
Analysis of RNA expression distribution skewness for TCGA-COAD dataset.
"""

import pandas as pd
import numpy as np
from scipy import stats

def main():
    file_path = "data/COAD__geneExp.xls"
    print(f"Loading RNA expression data from {file_path}...")
    df = pd.read_csv(file_path, sep="\t", index_col=0)
    print(f"Data shape: {df.shape[0]} genes x {df.shape[1]} samples")

    # Global distribution of RNA expression
    flat_vals = df.values.flatten()
    
    mean_val = float(np.mean(flat_vals))
    median_val = float(np.median(flat_vals))
    std_val = float(np.std(flat_vals))
    min_val = float(np.min(flat_vals))
    max_val = float(np.max(flat_vals))
    q25 = float(np.percentile(flat_vals, 25))
    q75 = float(np.percentile(flat_vals, 75))
    
    global_skew = float(stats.skew(flat_vals))
    
    # Per-sample skewness
    sample_skews = df.apply(stats.skew, axis=0)
    min_sample_skew = float(sample_skews.min())
    mean_sample_skew = float(sample_skews.mean())
    median_sample_skew = float(sample_skews.median())
    max_sample_skew = float(sample_skews.max())
    
    print("\n--- Summary Statistics (Global) ---")
    print(f"Total data points: {len(flat_vals):,}")
    print(f"Min: {min_val:.4f}")
    print(f"25th percentile: {q25:.4f}")
    print(f"Median: {median_val:.4f}")
    print(f"Mean: {mean_val:.4f}")
    print(f"75th percentile: {q75:.4f}")
    print(f"Max: {max_val:.4f}")
    print(f"Standard deviation: {std_val:.4f}")
    print(f"Global Skewness: {global_skew:.4f}")
    
    print("\n--- Per-sample Skewness ---")
    print(f"Min per-sample skewness: {min_sample_skew:.4f}")
    print(f"Mean per-sample skewness: {mean_sample_skew:.4f}")
    print(f"Median per-sample skewness: {median_sample_skew:.4f}")
    print(f"Max per-sample skewness: {max_sample_skew:.4f}")
    
    if global_skew > 1:
        classification = "highly right skewed"
    elif 0.5 < global_skew <= 1:
        classification = "minimally right skewed"
    elif -0.5 <= global_skew <= 0.5:
        classification = "approximately normal"
    elif -1 <= global_skew < -0.5:
        classification = "minimally left skewed"
    else:
        classification = "highly left skewed"
        
    print(f"\nConclusion: The distribution of RNA expression data is {classification}.")

if __name__ == "__main__":
    main()
