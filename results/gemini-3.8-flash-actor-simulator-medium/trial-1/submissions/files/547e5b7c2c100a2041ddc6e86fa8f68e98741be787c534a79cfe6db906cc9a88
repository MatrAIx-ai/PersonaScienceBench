import pandas as pd
import numpy as np
import scipy.stats as stats
import statsmodels.formula.api as smf

def run_analysis():
    df = pd.read_csv('data/nls_incarceration_processed.csv')
    b = df[df['race'] == 'black'].copy()
    b['wealth_growth_85_96'] = b['composite_wealth_1996'] - b['composite_wealth_1985']
    
    # Baseline wealth tiers
    b['tier'] = pd.cut(b['composite_wealth_1985'],
                       bins=[-np.inf, 0, 5000, np.inf],
                       labels=['Zero_Debt', 'Low', 'Mod_High'])
    
    # Stratified stats
    stats_dict = {}
    for tier, group in b.groupby('tier', observed=False):
        nj = group[group['ever_jailed'] == 0]
        j = group[group['ever_jailed'] == 1]
        u96, p96 = stats.mannwhitneyu(nj['composite_wealth_1996'], j['composite_wealth_1996'])
        ug, pg = stats.mannwhitneyu(nj['wealth_growth_85_96'], j['wealth_growth_85_96'])
        stats_dict[tier] = {
            'n_never': len(nj),
            'n_jailed': len(j),
            'median_96_never': nj['composite_wealth_1996'].median(),
            'median_96_jailed': j['composite_wealth_1996'].median(),
            'mean_96_never': nj['composite_wealth_1996'].mean(),
            'mean_96_jailed': j['composite_wealth_1996'].mean(),
            'median_growth_never': nj['wealth_growth_85_96'].median(),
            'median_growth_jailed': j['wealth_growth_85_96'].median(),
            'mean_growth_never': nj['wealth_growth_85_96'].mean(),
            'mean_growth_jailed': j['wealth_growth_85_96'].mean(),
            'p_mannwhitney_1996': p96,
            'p_mannwhitney_growth': pg
        }
        
    # Regression model
    m_int = smf.ols('composite_wealth_1996 ~ ever_jailed * C(tier) + C(sex)', data=b).fit(cov_type='HC3')
    
    # DiD panel
    b['id'] = b.index
    df_85 = b[['id', 'sex', 'ever_jailed', 'tier', 'composite_wealth_1985']].copy()
    df_85['year'] = 1985
    df_85['post'] = 0
    df_85.rename(columns={'composite_wealth_1985': 'wealth'}, inplace=True)

    df_96 = b[['id', 'sex', 'ever_jailed', 'tier', 'composite_wealth_1996']].copy()
    df_96['year'] = 1996
    df_96['post'] = 1
    df_96.rename(columns={'composite_wealth_1996': 'wealth'}, inplace=True)

    panel = pd.concat([df_85, df_96], ignore_index=True)
    did = smf.ols('wealth ~ post * ever_jailed + C(sex)', data=panel).fit(cov_type='cluster', cov_kwds={'groups': panel['id']})
    
    print('Analysis completed successfully.')
    return stats_dict, m_int, did

if __name__ == '__main__':
    run_analysis()
