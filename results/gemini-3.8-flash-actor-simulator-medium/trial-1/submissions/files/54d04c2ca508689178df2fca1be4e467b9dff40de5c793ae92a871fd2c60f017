import pandas as pd
import numpy as np
import json

# Load dataset
df = pd.read_csv('data/nls_incarceration_processed.csv')

# Filter for white respondents
whites = df[df['race'] == 'white'].copy()

results = {}

for sex in ['male', 'female']:
    sub = whites[whites['sex'] == sex]
    results[sex] = {}
    for yr in ['1990', '1996']:
        w = sub[f'composite_wealth_{yr}'].values
        n = len(w)
        mean_val = float(np.mean(w))
        std_val = float(np.std(w, ddof=1))
        median_val = float(np.median(w))
        p10 = float(np.percentile(w, 10))
        p25 = float(np.percentile(w, 25))
        p75 = float(np.percentile(w, 75))
        p90 = float(np.percentile(w, 90))
        p99 = float(np.percentile(w, 99))
        iqr = float(p75 - p25)
        p90_p10 = float(p90 - p10)
        
        # Gini coefficient
        s_sorted = np.sort(w)
        index = np.arange(1, n + 1)
        gini = float((np.sum((2 * index - n - 1) * s_sorted)) / (n * np.sum(s_sorted)))
        
        # Shares
        total_wealth = float(np.sum(w))
        top10_share = float(np.sum(w[w >= p90]) / total_wealth)
        top1_share = float(np.sum(w[w >= p99]) / total_wealth)
        pct_zero = float(np.mean(w == 0) * 100)
        pct_neg = float(np.mean(w < 0) * 100)

        results[sex][yr] = {
            'sample_size': n,
            'mean': round(mean_val, 2),
            'median': round(median_val, 2),
            'std': round(std_val, 2),
            'iqr': round(iqr, 2),
            'p10': round(p10, 2),
            'p25': round(p25, 2),
            'p75': round(p75, 2),
            'p90': round(p90, 2),
            'p99': round(p99, 2),
            'p90_minus_p10': round(p90_p10, 2),
            'gini': round(gini, 4),
            'top10_share': round(top10_share, 4),
            'top1_share': round(top1_share, 4),
            'pct_zero': round(pct_zero, 2),
            'pct_neg': round(pct_neg, 2)
        }

with open('wealth_inequality_summary.json', 'w') as f:
    json.dump(results, f, indent=2)

print("Analysis executed successfully:")
print(json.dumps(results, indent=2))
