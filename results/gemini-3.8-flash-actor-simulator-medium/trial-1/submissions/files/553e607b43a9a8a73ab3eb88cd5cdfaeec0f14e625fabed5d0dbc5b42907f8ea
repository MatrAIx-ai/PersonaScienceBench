import pandas as pd
import numpy as np
from scipy import stats

df = pd.read_csv('data/nls_incarceration_processed.csv')
jailed = df[df['ever_jailed'] == 1].copy()

print("=== Overall Incarcerated Population (N = {}) ===".format(len(jailed)))
print("Median: ${:.2f}, Mean: ${:.2f}".format(jailed['composite_wealth_1985'].median(), jailed['composite_wealth_1985'].mean()))

print("\n=== By Race ===")
race_stats = jailed.groupby('race')['composite_wealth_1985'].agg(
    n='count',
    median='median',
    mean='mean',
    q25=lambda x: x.quantile(0.25),
    q75=lambda x: x.quantile(0.75)
)
print(race_stats)

print("\n=== By Sex ===")
sex_stats = jailed.groupby('sex')['composite_wealth_1985'].agg(
    n='count',
    median='median',
    mean='mean',
    q25=lambda x: x.quantile(0.25),
    q75=lambda x: x.quantile(0.75)
)
print(sex_stats)

print("\n=== Intersectional (Race x Sex) ===")
inter_stats = jailed.groupby(['race', 'sex'])['composite_wealth_1985'].agg(
    n='count',
    median='median',
    mean='mean',
    q25=lambda x: x.quantile(0.25),
    q75=lambda x: x.quantile(0.75)
)
print(inter_stats)

# Statistical tests
white_w = jailed[jailed['race'] == 'white']['composite_wealth_1985']
black_w = jailed[jailed['race'] == 'black']['composite_wealth_1985']
hisp_w = jailed[jailed['race'] == 'hipanic']['composite_wealth_1985']
male_w = jailed[jailed['sex'] == 'male']['composite_wealth_1985']
female_w = jailed[jailed['sex'] == 'female']['composite_wealth_1985']

print("\n=== Hypothesis Tests ===")
print("Kruskal-Wallis (Race):", stats.kruskal(white_w, black_w, hisp_w))
print("Mann-Whitney U (White vs Black):", stats.mannwhitneyu(white_w, black_w, alternative='two-sided'))
print("Mann-Whitney U (White vs Hispanic):", stats.mannwhitneyu(white_w, hisp_w, alternative='two-sided'))
print("Mann-Whitney U (Black vs Hispanic):", stats.mannwhitneyu(black_w, hisp_w, alternative='two-sided'))
print("Mann-Whitney U (Male vs Female):", stats.mannwhitneyu(male_w, female_w, alternative='two-sided'))
