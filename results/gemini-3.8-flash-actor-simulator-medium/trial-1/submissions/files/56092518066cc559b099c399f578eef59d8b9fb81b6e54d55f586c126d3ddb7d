import os
import pandas as pd
import numpy as np
from scipy import stats

def main():
    data_path = os.path.join("data", "COAD__geneExp.xls")
    print(f"Loading RNA expression data from {data_path}...")
    df = pd.read_csv(data_path, sep="\t", index_col=0)
    print(f"Dataset shape: {df.shape} (genes x samples)")

    # Flatten all expression values
    vals = df.values.flatten()
    print(f"Total values: {len(vals)}")
    print(f"Summary statistics:")
    print(f"  Min: {np.min(vals):.4f}")
    print(f"  Q25: {np.percentile(vals, 25):.4f}")
    print(f"  Median: {np.median(vals):.4f}")
    print(f"  Mean: {np.mean(vals):.4f}")
    print(f"  Q75: {np.percentile(vals, 75):.4f}")
    print(f"  Max: {np.max(vals):.4f}")
    print(f"  Std: {np.std(vals):.4f}")

    # Compute global skewness
    global_skew = float(stats.skew(vals, nan_policy='omit'))
    print(f"Global Fisher-Pearson skewness: {global_skew:.4f}")

    # Per-sample skewness
    sample_skew = df.skew(axis=0)
    print(f"Sample-level skewness:")
    print(f"  Mean: {sample_skew.mean():.4f}")
    print(f"  Median: {sample_skew.median():.4f}")
    print(f"  Min: {sample_skew.min():.4f}")
    print(f"  Max: {sample_skew.max():.4f}")

    # Per-gene skewness
    gene_skew = df.skew(axis=1)
    print(f"Gene-level skewness:")
    print(f"  Mean: {gene_skew.mean():.4f}")
    print(f"  Median: {gene_skew.median():.4f}")
    print(f"  Min: {gene_skew.min():.4f}")
    print(f"  Max: {gene_skew.max():.4f}")

    # Classification
    if global_skew > 1.0:
        skew_class = "Highly right-skewed"
    elif global_skew > 0.5:
        skew_class = "Minimally right-skewed"
    elif global_skew < -1.0:
        skew_class = "Highly left-skewed"
    elif global_skew < -0.5:
        skew_class = "Minimally left-skewed"
    else:
        skew_class = "Approximately normal"

    print(f"\nConclusion: The distribution of RNA expression data is {skew_class} (skewness = {global_skew:.2f}).")

if __name__ == "__main__":
    main()
