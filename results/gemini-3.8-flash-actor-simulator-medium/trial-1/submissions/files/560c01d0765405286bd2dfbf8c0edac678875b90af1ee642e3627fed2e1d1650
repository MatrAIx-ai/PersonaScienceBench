import pandas as pd
import statsmodels.api as sm
import statsmodels.formula.api as smf

def main():
    # Load dataset
    df = pd.read_excel('data/data.xlsx')
    
    # Filter valid patient records (Sequence number 1 to 80)
    df_valid = df.dropna(subset=['Sequence number']).copy()
    print(f"Total valid observations: {len(df_valid)}")
    
    # Define binary response: PR vs non-PR (SD/PD)
    df_valid['response_PR'] = (df_valid['Efficacy'] == 'PR').astype(int)
    print("Response distribution:")
    print(df_valid['response_PR'].value_counts())
    
    # Fit logistic regression model
    model = smf.logit('response_PR ~ BMI', data=df_valid).fit()
    print("\nModel Summary:")
    print(model.summary())
    
    aic = model.aic
    print(f"\nAkaike Information Criterion (AIC): {aic:.4f}")
    print(f"Full precision AIC: {aic}")
    
    return aic

if __name__ == '__main__':
    main()
