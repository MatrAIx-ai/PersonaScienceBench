"""Optimistic Q-Learning Agent with Horizon-Adaptive Bernstein Bonus and Backward Updates.

This module implements a tabular, online, model-free optimistic Q-learning variant
designed to minimize cumulative regret in finite-horizon MDPs under O(H * S * A)
storage constraints.

Key innovations:
1. Single Episode Trace Backward Updates: Trajectory transitions are buffered during
   the episode and updated in reverse order (h = H, ..., 1) upon episode termination.
   This immediately propagates reward and value updates upstream within the same episode,
   eliminating the O(H) episode delay in multi-step credit assignment.
2. Horizon-Adaptive Bernstein Confidence Bonus: Bonus scales with the remaining effective
   horizon H_eff = H - h + 1 rather than a static H, and balances transition variance
   against small-sample burn-in cost.
3. Coupled Value-Variance Moving Average: Tracks transition variance using visit-dependent
   weights aligned with Q-learning step sizes, preventing artificial inflation caused by
   non-stationary downstream value drift.
"""

from __future__ import annotations

from typing import Any
import numpy as np


class HorizonAdaptiveOptimisticQAgent:
    """Tabular model-free Q-learning agent with backward updates and adaptive Bernstein bonus."""

    def __init__(self, env_spec: dict[str, Any], seed: int, c1: float = 0.05, c2: float = 0.02) -> None:
        self.H = int(env_spec["H"])
        self.S = int(env_spec["S"])
        self.A = int(env_spec["A"])
        self.seed = int(seed)
        self.c1 = float(c1)
        self.c2 = float(c2)

        # Q and V value tables, visit counts, and first/second moment statistics
        # Total storage: O(H * S * A), strictly within benchmark limits
        self.Q = np.zeros((self.H + 1, self.S, self.A), dtype=np.float64)
        for h in range(self.H):
            self.Q[h] = float(self.H - h)

        self.V = np.zeros((self.H + 1, self.S), dtype=np.float64)
        for h in range(self.H + 1):
            self.V[h] = float(self.H - h)

        self.N = np.zeros((self.H + 1, self.S, self.A), dtype=np.int32)
        self.M1 = np.zeros((self.H + 1, self.S, self.A), dtype=np.float64)
        self.M2 = np.zeros((self.H + 1, self.S, self.A), dtype=np.float64)

        # Single bounded episode trace of length at most H
        self.trace: list[tuple[int, int, int, float, int, bool]] = []

    def act(self, h: int, state: int) -> int:
        """Select action greedily with respect to optimistic Q estimates."""
        step = h - 1
        return int(np.argmax(self.Q[step, state]))

    def observe(
        self,
        h: int,
        state: int,
        action: int,
        reward: float,
        next_state: int,
        done: bool,
    ) -> None:
        """Record transition into the bounded episode trace and update backwards when done."""
        step = h - 1
        self.trace.append((step, state, action, float(reward), int(next_state), bool(done)))
        if done or h >= self.H:
            self._process_episode_trace()

    def _process_episode_trace(self) -> None:
        """Perform reverse-order dynamic programming update along the trajectory trace."""
        if not self.trace:
            return

        for step, state, action, reward, next_state, done in reversed(self.trace):
            self.N[step, state, action] += 1
            t = self.N[step, state, action]
            H_eff = self.H - step

            # Step size adaptive to effective remaining horizon
            alpha = (H_eff + 1.0) / (H_eff + t)

            # Target continuation value
            v_next = self.V[step + 1, next_state] if not done else 0.0

            # Update moment estimates with aligned weighting
            beta = alpha
            if t == 1:
                self.M1[step, state, action] = v_next
                self.M2[step, state, action] = v_next * v_next
            else:
                self.M1[step, state, action] = (1.0 - beta) * self.M1[step, state, action] + beta * v_next
                self.M2[step, state, action] = (1.0 - beta) * self.M2[step, state, action] + beta * (v_next * v_next)

            # Empirical variance of next-state values
            var = max(0.0, self.M2[step, state, action] - self.M1[step, state, action] ** 2)

            # Exploration factor and Bernstein bonus
            iota = np.log(max(2.0, self.S * self.A * self.H * t))
            bonus = self.c1 * np.sqrt(var * iota / t) + self.c2 * H_eff * iota / t

            # Optimistic Q target clipped to theoretical remaining horizon bound
            target = reward + v_next + bonus
            self.Q[step, state, action] = min(
                float(H_eff),
                (1.0 - alpha) * self.Q[step, state, action] + alpha * target,
            )
            self.V[step, state] = max(self.Q[step, state])

        self.trace.clear()

    def end_episode(self, episode: int, episode_reward: float) -> None:
        """Called at the end of each episode if supported by the runner."""
        self._process_episode_trace()

    def reset_episode(self, episode: int, state: int) -> None:
        """Optional hook called at the start of each episode."""
        self.trace.clear()


def make_agent(env_spec: dict[str, Any], seed: int) -> HorizonAdaptiveOptimisticQAgent:
    """Agent factory required by benchmark interface."""
    return HorizonAdaptiveOptimisticQAgent(env_spec, seed)
