import pandas as pd
import numpy as np

def format_millennium(bce):
    m = (bce - 1) // 1000 + 1
    suffix = {1: '1st', 2: '2nd', 3: '3rd', 4: '4th', 5: '5th'}.get(m, f"{m}th")
    return f"{suffix} millennium BCE"

# Load capital data
cap = pd.read_csv('data/capital.csv', decimal=',')
cap['BCE'] = cap['BCE'].astype(int)
cap['Zamber'] = cap['Zamber'].astype(float)
cap['CE'] = -cap['BCE']
cap['calBP'] = 1950 + cap['BCE']

# Assign millennium BCE
cap['millennium'] = cap['BCE'].apply(format_millennium)

millennia_order = [
    '5th millennium BCE',
    '4th millennium BCE',
    '3rd millennium BCE',
    '2nd millennium BCE',
    '1st millennium BCE'
]

# Summary stats per millennium from capital.csv
cap_stats = cap.groupby('millennium')['Zamber'].agg(
    count='count',
    mean='mean',
    std='std',
    min='min',
    max='max'
).reindex(millennia_order)

# Load time series data
ts = pd.read_csv('data/time_series_data.csv')
ts['BCE'] = -ts['CE']
ts['millennium'] = ts['BCE'].apply(format_millennium)

ts_inter_stats = ts.groupby('millennium')['Amber_inter'].agg(
    count='count',
    mean='mean',
    std='std',
    min='min',
    max='max'
).reindex(millennia_order)

ts_discrete = ts.dropna(subset=['Amber']).copy()
ts_discrete_stats = ts_discrete.groupby('millennium')['Amber'].agg(
    count='count',
    mean='mean',
    std='std',
    min='min',
    max='max'
).reindex(millennia_order)

# Peak interval in capital
peak_val_cap = cap['Zamber'].max()
peak_cap_rows = cap[cap['Zamber'] == peak_val_cap]

# Peak interval in time series
peak_val_ts = ts['Amber_inter'].max()
peak_ts_rows = ts[ts['Amber_inter'] == peak_val_ts]

print("=== CAPITAL.CSV MILLENNIUM SUMMARY (100-YEAR BINS) ===")
print(cap_stats.to_string())

print("\n=== TIME_SERIES_DATA.CSV INTERPOLATED MILLENNIUM SUMMARY ===")
print(ts_inter_stats.to_string())

print("\n=== TIME_SERIES_DATA.CSV DISCRETE AMBER POINTS ===")
print(ts_discrete_stats.to_string())

print("\n=== PEAK OCCURRENCE IN CAPITAL.CSV ===")
print(peak_cap_rows[['BCE', 'CE', 'calBP', 'Zamber', 'group']].to_string(index=False))

print("\n=== PEAK OCCURRENCE IN TIME_SERIES_DATA.CSV ===")
print(f"Max Amber_inter: {peak_val_ts}")
print(f"CE Range: {peak_ts_rows['CE'].min()} to {peak_ts_rows['CE'].max()}")
print(f"BCE Range: {-peak_ts_rows['CE'].max()} to {-peak_ts_rows['CE'].min()}")
print(f"calBP Range: {peak_ts_rows['calBP'].min()} to {peak_ts_rows['calBP'].max()}")
