import pandas as pd
import numpy as np
from scipy import stats

def run_analysis():
    df = pd.read_csv('data/meta-regression_study_data_heterogeneity_in_replication_projects.csv')
    df_unique = df.drop_duplicates(subset=['title']).copy()
    
    # 1. Unique original papers
    ee_u = df_unique[df_unique['discipline'] == 'Economics']['length']
    rpp_u = df_unique[df_unique['project'] == 'rpp']['length']
    psych_comb_u = df_unique[df_unique['discipline'].isin(['Cognitive', 'Social'])]['length']
    cog_u = df_unique[df_unique['discipline'] == 'Cognitive']['length']
    soc_u = df_unique[df_unique['discipline'] == 'Social']['length']
    
    # Statistical tests (Welch t-test and Mann-Whitney U)
    t_stat_rpp, p_val_rpp = stats.ttest_ind(ee_u, rpp_u, equal_var=False)
    u_stat_rpp, u_pval_rpp = stats.mannwhitneyu(ee_u, rpp_u, alternative='two-sided')
    
    t_stat_comb, p_val_comb = stats.ttest_ind(ee_u, psych_comb_u, equal_var=False)
    u_stat_comb, u_pval_comb = stats.mannwhitneyu(ee_u, psych_comb_u, alternative='two-sided')
    
    # 2. Row level
    ee_r = df[df['discipline'] == 'Economics']['length']
    rpp_r = df[df['project'] == 'rpp']['length']
    psych_comb_r = df[df['discipline'].isin(['Cognitive', 'Social'])]['length']

    print("=== SUMMARY OF RESULTS ===")
    print(f"Experimental Economics (Unique, N={len(ee_u)}): Mean = {ee_u.mean():.2f} pages (SD = {ee_u.std():.2f}, Median = {ee_u.median():.1f})")
    print(f"Psychology - RPP (Unique, N={len(rpp_u)}): Mean = {rpp_u.mean():.2f} pages (SD = {rpp_u.std():.2f}, Median = {rpp_u.median():.1f})")
    print(f"Psychology - Combined (Unique, N={len(psych_comb_u)}): Mean = {psych_comb_u.mean():.2f} pages (SD = {psych_comb_u.std():.2f}, Median = {psych_comb_u.median():.1f})")
    print(f"  - Cognitive (Unique, N={len(cog_u)}): Mean = {cog_u.mean():.2f} pages (SD = {cog_u.std():.2f})")
    print(f"  - Social (Unique, N={len(soc_u)}): Mean = {soc_u.mean():.2f} pages (SD = {soc_u.std():.2f})")
    print(f"\nRow-level means: EE = {ee_r.mean():.2f}, RPP = {rpp_r.mean():.2f}, Psych Combined = {psych_comb_r.mean():.2f}")
    print(f"\nWelch t-test (EE vs RPP unique): t = {t_stat_rpp:.4f}, p = {p_val_rpp:.4e}")
    print(f"Welch t-test (EE vs Psych Combined unique): t = {t_stat_comb:.4f}, p = {p_val_comb:.4e}")

if __name__ == '__main__':
    run_analysis()
