import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf

# Load dataset
df = pd.read_csv('data/nls_ses_processed.csv')
df['BA'] = df['BA DEGREE COMPLETED'].astype(int)

print("=== DATA SUMMARY ===")
print(f"Total observations: {len(df)}")
print("Racial distribution:")
print(df['SAMPLE_RACE'].value_counts())

print("\n=== BA DEGREE COMPLETION BY RACE ===")
crosstab = pd.crosstab(df['SAMPLE_RACE'], df['BA DEGREE COMPLETED'], margins=True)
crosstab_pct = pd.crosstab(df['SAMPLE_RACE'], df['BA DEGREE COMPLETED'], normalize='index') * 100
summary_table = pd.concat([crosstab, crosstab_pct[True].rename('Completion Rate (%)')], axis=1)
print(summary_table)

print("\n=== BIVARIATE LOGISTIC REGRESSION (Reference: White) ===")
logit_white_ref = smf.logit('BA ~ C(SAMPLE_RACE, Treatment(reference="White"))', data=df).fit()
print(logit_white_ref.summary())

print("\n=== BIVARIATE LOGISTIC REGRESSION (Reference: Black) ===")
logit_black_ref = smf.logit('BA ~ C(SAMPLE_RACE, Treatment(reference="Black"))', data=df).fit()
print(logit_black_ref.summary())

print("\n=== BIVARIATE LOGISTIC REGRESSION (Reference: Hispanic) ===")
logit_hisp_ref = smf.logit('BA ~ C(SAMPLE_RACE, Treatment(reference="Hispanic"))', data=df).fit()
print(logit_hisp_ref.summary())

print("\n=== PAIRWISE LOG-ODDS AND ODDS RATIOS ===")
# White vs Black
n_w_comp = df[(df['SAMPLE_RACE']=='White') & (df['BA']==1)].shape[0]
n_w_nocomp = df[(df['SAMPLE_RACE']=='White') & (df['BA']==0)].shape[0]
odds_w = n_w_comp / n_w_nocomp

n_b_comp = df[(df['SAMPLE_RACE']=='Black') & (df['BA']==1)].shape[0]
n_b_nocomp = df[(df['SAMPLE_RACE']=='Black') & (df['BA']==0)].shape[0]
odds_b = n_b_comp / n_b_nocomp

n_h_comp = df[(df['SAMPLE_RACE']=='Hispanic') & (df['BA']==1)].shape[0]
n_h_nocomp = df[(df['SAMPLE_RACE']=='Hispanic') & (df['BA']==0)].shape[0]
odds_h = n_h_comp / n_h_nocomp

print(f"Black vs White: Log-Odds = {np.log(odds_b / odds_w):.4f}, Odds Ratio = {odds_b / odds_w:.4f}")
print(f"Hispanic vs White: Log-Odds = {np.log(odds_h / odds_w):.4f}, Odds Ratio = {odds_h / odds_w:.4f}")
print(f"Black vs Hispanic: Log-Odds = {np.log(odds_b / odds_h):.4f}, Odds Ratio = {odds_b / odds_h:.4f}")

# Non-white vs White
df['non_white'] = (df['SAMPLE_RACE'] != 'White').astype(int)
logit_nw = smf.logit('BA ~ non_white', data=df).fit(disp=False)
print(f"Non-White vs White: Log-Odds = {logit_nw.params['non_white']:.4f}")

# Multivariate regressions controlling for covariates
covars = ['SAMPLE_SEX', 'FAMILY SIZE OF SAMPLE', 'ABILITY: COMPOSITE OF ASVAB SCORE', 'PERCENTILE IN CLASS', 'SES']
formula_all = 'BA ~ C(SAMPLE_RACE, Treatment(reference="White")) + ' + ' + '.join([f'Q("{c}")' for c in covars])
logit_multi = smf.logit(formula_all, data=df).fit(disp=False)
print("\n=== MULTIVARIATE LOGISTIC REGRESSION ===")
print(logit_multi.params)
