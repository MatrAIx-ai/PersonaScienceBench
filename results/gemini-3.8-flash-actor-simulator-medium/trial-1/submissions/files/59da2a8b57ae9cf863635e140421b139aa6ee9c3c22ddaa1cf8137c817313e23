import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf
from scipy import stats

# 1. Load data
df = pd.read_csv('data/nls_ses_processed.csv')

# Clean column names
df.columns = [c.strip().replace(' ', '_').replace(':', '_') for c in df.columns]
df['BA_DEGREE_COMPLETED'] = df['BA_DEGREE_COMPLETED'].astype(int)

print("=== DATA SUMMARY ===")
print("Total observations:", len(df))
print("\nDegree completion by race:")
ct = pd.crosstab(df['SAMPLE_RACE'], df['BA_DEGREE_COMPLETED'], margins=True)
ct_pct = pd.crosstab(df['SAMPLE_RACE'], df['BA_DEGREE_COMPLETED'], normalize='index') * 100
summary_table = pd.concat([ct, ct_pct[1].rename('% BA Completed')], axis=1)
print(summary_table)

print("\nMean SES by Race and Degree Completion:")
print(df.groupby(['SAMPLE_RACE', 'BA_DEGREE_COMPLETED'])['SES'].agg(['count', 'mean', 'std', 'median']))

# 2. Logistic Regression Models
print("\n=== MODEL 1: Logistic Regression without interaction ===")
m1_base = smf.logit('BA_DEGREE_COMPLETED ~ SES + C(SAMPLE_RACE, Treatment(reference="White"))', data=df).fit()
print(m1_base.summary())

print("\n=== MODEL 1_int: Logistic Regression with SES x Race Interaction (Unadjusted) ===")
m1_int = smf.logit('BA_DEGREE_COMPLETED ~ SES * C(SAMPLE_RACE, Treatment(reference="White"))', data=df).fit()
print(m1_int.summary())

# LRT for interaction in unadjusted model
lr_stat_m1 = 2 * (m1_int.llf - m1_base.llf)
lr_p_m1 = stats.chi2.sf(lr_stat_m1, df=2)
print(f"LRT test for interaction in Model 1: Chi2 = {lr_stat_m1:.4f}, p = {lr_p_m1:.4f}")

# Odds ratios for m1_int
or_m1 = np.exp(m1_int.params)
ci_m1 = np.exp(m1_int.conf_int())
ci_m1.columns = ['2.5%', '97.5%']
res_or_m1 = pd.concat([or_m1.rename('OR'), ci_m1, m1_int.pvalues.rename('p-value')], axis=1)
print("\nOdds Ratios (Model 1 with interaction):")
print(res_or_m1)

print("\n=== MODEL 2: Fully Adjusted Logistic Regression (Additive) ===")
m2_base = smf.logit('BA_DEGREE_COMPLETED ~ SES + C(SAMPLE_RACE, Treatment(reference="White")) + ABILITY__COMPOSITE_OF_ASVAB_SCORE + PERCENTILE_IN_CLASS + FAMILY_SIZE_OF_SAMPLE + C(SAMPLE_SEX)', data=df).fit()
print(m2_base.summary())

print("\n=== MODEL 2_int: Fully Adjusted Logistic Regression with SES x Race Interaction ===")
m2_int = smf.logit('BA_DEGREE_COMPLETED ~ SES * C(SAMPLE_RACE, Treatment(reference="White")) + ABILITY__COMPOSITE_OF_ASVAB_SCORE + PERCENTILE_IN_CLASS + FAMILY_SIZE_OF_SAMPLE + C(SAMPLE_SEX)', data=df).fit()
print(m2_int.summary())

# LRT for interaction in adjusted model
lr_stat_m2 = 2 * (m2_int.llf - m2_base.llf)
lr_p_m2 = stats.chi2.sf(lr_stat_m2, df=2)
print(f"LRT test for interaction in Model 2 (Adjusted): Chi2 = {lr_stat_m2:.4f}, p = {lr_p_m2:.4f}")

# Wald test for interaction in adjusted model
wald_test = m2_int.wald_test('SES:C(SAMPLE_RACE, Treatment(reference="White"))[T.Black] = 0, SES:C(SAMPLE_RACE, Treatment(reference="White"))[T.Hispanic] = 0')
print("Wald test for interaction terms in Model 2:")
print(wald_test)

# Odds ratios for m2_int
or_m2 = np.exp(m2_int.params)
ci_m2 = np.exp(m2_int.conf_int())
ci_m2.columns = ['2.5%', '97.5%']
res_or_m2 = pd.concat([or_m2.rename('OR'), ci_m2, m2_int.pvalues.rename('p-value')], axis=1)
print("\nOdds Ratios (Model 2 with interaction):")
print(res_or_m2)

# 3. Stratified models by Race
print("\n=== STRATIFIED LOGISTIC REGRESSIONS BY RACE (Adjusted) ===")
for race in ['White', 'Black', 'Hispanic']:
    sub = df[df['SAMPLE_RACE'] == race]
    m_sub = smf.logit('BA_DEGREE_COMPLETED ~ SES + ABILITY__COMPOSITE_OF_ASVAB_SCORE + PERCENTILE_IN_CLASS + FAMILY_SIZE_OF_SAMPLE + C(SAMPLE_SEX)', data=sub).fit(disp=False)
    ses_coef = m_sub.params['SES']
    ses_se = m_sub.bse['SES']
    ses_pval = m_sub.pvalues['SES']
    ses_or = np.exp(ses_coef)
    ses_ci = np.exp(m_sub.conf_int().loc['SES'])
    print(f"Race: {race} (N={len(sub)}, BA={sub['BA_DEGREE_COMPLETED'].sum()}) -> SES Coef: {ses_coef:.4f} (SE: {ses_se:.4f}), OR: {ses_or:.4f} (95% CI: [{ses_ci[0]:.4f}, {ses_ci[1]:.4f}]), p-val: {ses_pval:.4f}")

# 4. Linear Probability Models (LPM / OLS with HC3)
print("\n=== LINEAR PROBABILITY MODEL (OLS with HC3) ===")
lpm_int = smf.ols('BA_DEGREE_COMPLETED ~ SES * C(SAMPLE_RACE, Treatment(reference="White")) + ABILITY__COMPOSITE_OF_ASVAB_SCORE + PERCENTILE_IN_CLASS + FAMILY_SIZE_OF_SAMPLE + C(SAMPLE_SEX)', data=df).fit(cov_type='HC3')
print(lpm_int.summary())

# Wald test for LPM interaction
wald_lpm = lpm_int.wald_test('SES:C(SAMPLE_RACE, Treatment(reference="White"))[T.Black] = 0, SES:C(SAMPLE_RACE, Treatment(reference="White"))[T.Hispanic] = 0')
print("\nWald test for LPM interaction terms:")
print(wald_lpm)

# 5. Average Marginal Effects (AME)
print("\n=== MARGINAL EFFECTS (AME) FROM LOGIT ===")
m_base_all = smf.logit('BA_DEGREE_COMPLETED ~ SES + C(SAMPLE_RACE, Treatment(reference="White")) + ABILITY__COMPOSITE_OF_ASVAB_SCORE + PERCENTILE_IN_CLASS + FAMILY_SIZE_OF_SAMPLE + C(SAMPLE_SEX)', data=df).fit(disp=False)
margeff = m_base_all.get_margeff(at='overall')
print(margeff.summary())

