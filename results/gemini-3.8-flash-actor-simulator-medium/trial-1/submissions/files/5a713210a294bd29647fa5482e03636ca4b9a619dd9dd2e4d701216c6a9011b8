#!/usr/bin/env python3
"""
Coupled Farquhar (C3) / Collatz (C4) Photosynthesis and Ball-Berry Stomatal Conductance.
"""
import os
import json
import subprocess
import numpy as np
import pandas as pd

R_GAS = 8.314

def calc_esat(t_air_k):
    tc = t_air_k - 273.16
    return 610.78 * np.exp(17.27 * tc / (tc + 237.3))

def calc_vcmax(t_air_k, vcmax25, n_factor, btran):
    tc = t_air_k - 273.16
    tk = tc + 273.16
    denom = 1.0 + np.exp((-2.2e5 + 710.0 * tk) / (R_GAS * tk))
    vcmax_t = vcmax25 * (2.4 ** ((tc - 25.0) / 10.0)) / denom
    return vcmax_t * n_factor * btran

def solve_coupled_leaf(row, par_val, params, ci_init=None, max_iter=100, tol=1e-6):
    t_air = row['t_air_K']
    tc = t_air - 273.16
    p_atm = row['p_atm_Pa']
    ca = row['co2_pa']
    o2 = row['o2_pa']
    vpd = row['vpd_Pa']
    rb = row['rb_sm']
    btran = row['btran']
    
    pathway = params.get('pathway', 'C4').upper()
    vcmax25 = params['vcmax25']
    bb_slope = params['bb_slope']
    bb_intercept = params['bb_intercept']
    alpha_q = params['alpha_q']
    n_factor = params.get('n_factor', 1.0)
    
    vcmax = calc_vcmax(t_air, vcmax25, n_factor, btran)
    rd = 0.015 * vcmax
    cf = p_atm / (R_GAS * t_air)
    esat = calc_esat(t_air)
    hs = np.clip(1.0 - vpd / esat, 0.25, 1.0)
    apar = 4.6 * par_val
    
    # Night-time regime
    if par_val <= 0.0:
        A = -rd
        A_mol = A * 1e-6
        gs = bb_intercept
        rs = cf / gs
        cs = ca - 1.37 * rb * (A_mol / cf) * p_atm
        ci = cs - 1.65 * rs * (A_mol / cf) * p_atm
        return {'A': float(A), 'rs': float(rs), 'ci': float(ci), 'gs': float(gs), 'n_iter': 0}
    
    if pathway == 'C3':
        kc25, ko25 = 30.0, 30000.0
        kc = kc25 * (2.1 ** ((tc - 25.0) / 10.0))
        ko = ko25 * (1.2 ** ((tc - 25.0) / 10.0))
        gamma_star = 0.5 * (kc / ko) * o2 * 0.21
        J = alpha_q * apar
        
    ci = ci_init if ci_init is not None else 0.7 * ca
    
    for it in range(1, max_iter + 1):
        if pathway == 'C4':
            Wc = vcmax
            Wj = alpha_q * apar
            We = 4000.0 * vcmax * ci / p_atm
            A = min(Wc, Wj, We) - rd
        else:
            Wc = vcmax * (ci - gamma_star) / (ci + kc * (1.0 + o2 / ko))
            Wj = J * (ci - gamma_star) / (4.0 * ci + 8.0 * gamma_star)
            We = 0.5 * vcmax
            A = min(Wc, Wj, We) - rd
            
        A_mol = A * 1e-6
        cs = ca - 1.37 * rb * (A_mol / cf) * p_atm
        gs = bb_slope * A_mol * hs / cs * p_atm + bb_intercept
        rs = cf / gs
        ci_next = cs - 1.65 * rs * (A_mol / cf) * p_atm
        
        if abs(ci_next - ci) < tol:
            return {'A': float(A), 'rs': float(rs), 'ci': float(ci_next), 'gs': float(gs), 'n_iter': it}
        ci = ci_next
        
    return {'A': float(A), 'rs': float(rs), 'ci': float(ci), 'gs': float(gs), 'n_iter': max_iter}

def render_plot(df_fluxes, output_png):
    try:
        import matplotlib.pyplot as plt
        fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(12, 8), sharex=True)
        ax1.plot(df_fluxes['time_hr'], df_fluxes['A_sun'], label='Sunlit leaf (A_sun)', color='#d95f02', lw=2)
        ax1.plot(df_fluxes['time_hr'], df_fluxes['A_shade'], label='Shaded leaf (A_shade)', color='#1b9e77', lw=2, linestyle='--')
        ax1.axhline(0, color='grey', lw=0.8, linestyle=':')
        ax1.set_ylabel(r'Net Assimilation, A ($\mu$mol CO$_2$ m$^{-2}$ s$^{-1}$)')
        ax1.set_title('Diurnal Leaf Physiological Response (Farquhar/Collatz - Ball-Berry)')
        ax1.legend(loc='upper right')
        ax1.grid(True, linestyle='--', alpha=0.6)
        
        ax2.plot(df_fluxes['time_hr'], df_fluxes['rs_sun'], label='Sunlit leaf (rs_sun)', color='#e7298a', lw=2)
        ax2.plot(df_fluxes['time_hr'], df_fluxes['rs_shade'], label='Shaded leaf (rs_shade)', color='#7570b3', lw=2, linestyle='--')
        ax2.set_xlabel('Simulation Time (hours)')
        ax2.set_ylabel('Stomatal Resistance, rs (s m$^{-1}$)')
        ax2.legend(loc='upper right')
        ax2.grid(True, linestyle='--', alpha=0.6)
        
        plt.tight_layout()
        plt.savefig(output_png, dpi=300)
        plt.close()
        return
    except ImportError:
        pass

    # PostScript + Ghostscript vector rendering fallback
    t = df_fluxes['time_hr'].values
    a_sun, a_sh = df_fluxes['A_sun'].values, df_fluxes['A_shade'].values
    r_sun, r_sh = df_fluxes['rs_sun'].values, df_fluxes['rs_shade'].values
    
    ps = ['%!PS-Adobe-3.0 EPSF-3.0', '%%BoundingBox: 0 0 800 600', '1 1 1 setrgbcolor', '0 0 800 600 rectfill']
    ps.append('/Helvetica-Bold findfont 16 scalefont setfont 0 0 0 setrgbcolor 160 570 moveto')
    ps.append('(Diurnal Leaf Physiological Response (Farquhar/Collatz - Ball-Berry)) show')
    
    x0, x1 = 80.0, 740.0
    def mx(val): return x0 + (val - t[0]) / (t[-1] - t[0]) * (x1 - x0)
    
    # Subplot 1 (A)
    y1_0, y1_1 = 330.0, 530.0
    a_min, a_max = -5.0, max(max(a_sun), max(a_sh)) * 1.05
    def my1(val): return y1_0 + (val - a_min) / (a_max - a_min) * (y1_1 - y1_0)
    
    # Subplot 2 (rs)
    y2_0, y2_1 = 70.0, 270.0
    r_min, r_max = 0.0, max(max(r_sun), max(r_sh)) * 1.05
    def my2(val): return y2_0 + (val - r_min) / (r_max - r_min) * (y2_1 - y2_0)
    
    # Grid & ticks
    ps.append('0.88 0.88 0.88 setrgbcolor 0.5 setlinewidth')
    for d in range(6):
        gx = mx(d * 24.0)
        ps.append(f'{gx:.1f} {y1_0:.1f} moveto {gx:.1f} {y1_1:.1f} lineto stroke')
        ps.append(f'{gx:.1f} {y2_0:.1f} moveto {gx:.1f} {y2_1:.1f} lineto stroke')
        
    for tick in np.linspace(0, 40, 5):
        ps.append(f'{x0:.1f} {my1(tick):.1f} moveto {x1:.1f} {my1(tick):.1f} lineto stroke')
    for tick in np.linspace(0, 1200, 5):
        ps.append(f'{x0:.1f} {my2(tick):.1f} moveto {x1:.1f} {my2(tick):.1f} lineto stroke')
        
    # Zero line in Subplot 1
    ps.append(f'0.5 0.5 0.5 setrgbcolor [2 2] 0 setdash {x0:.1f} {my1(0):.1f} moveto {x1:.1f} {my1(0):.1f} lineto stroke [] 0 setdash')
    
    # Frames
    ps.append(f'0 0 0 setrgbcolor 1 setlinewidth {x0:.1f} {y1_0:.1f} {x1-x0:.1f} {y1_1-y1_0:.1f} rectstroke')
    ps.append(f'{x0:.1f} {y2_0:.1f} {x1-x0:.1f} {y2_1-y2_0:.1f} rectstroke')
    
    # Labels and text
    ps.append('/Helvetica findfont 10 scalefont setfont')
    for tick in np.linspace(0, 40, 5):
        ps.append(f'{x0 - 32:.1f} {my1(tick) - 4:.1f} moveto ({int(tick)}) show')
    for tick in np.linspace(0, 1200, 5):
        ps.append(f'{x0 - 38:.1f} {my2(tick) - 4:.1f} moveto ({int(tick)}) show')
    for d in range(6):
        gx = mx(d * 24.0)
        ps.append(f'{gx - 8:.1f} {y2_0 - 15:.1f} moveto ({int(d*24)}) show')
        ps.append(f'{gx - 14:.1f} {y2_0 - 28:.1f} moveto (Day {d+1}) show')
        
    ps.append(f'350 {y2_0 - 45:.1f} moveto (Simulation Time [hours]) show')
    ps.append('gsave 22 340 moveto 90 rotate (Net Assimilation, A [umol CO2 m^-2 s^-1]) show grestore')
    ps.append('gsave 22 100 moveto 90 rotate (Stomatal Resistance, rs [s m^-1]) show grestore')
    
    # Curves
    def draw_curve(arr, yfunc, color, dashed=False):
        ps.append(f'{color} setrgbcolor 1.5 setlinewidth')
        if dashed: ps.append('[4 2] 0 setdash')
        ps.append(f'{mx(t[0]):.1f} {yfunc(arr[0]):.1f} moveto')
        for ti, val in zip(t[1:], arr[1:]):
            ps.append(f'{mx(ti):.1f} {yfunc(val):.1f} lineto')
        ps.append('stroke')
        if dashed: ps.append('[] 0 setdash')
        
    draw_curve(a_sun, my1, '0.85 0.35 0.1')
    draw_curve(a_sh, my1, '0.1 0.6 0.45', dashed=True)
    draw_curve(r_sun, my2, '0.9 0.15 0.5')
    draw_curve(r_sh, my2, '0.45 0.4 0.7', dashed=True)
    
    # Legends
    def draw_legend(ypos, l1, l2, c1, c2):
        ps.append(f'0.95 0.95 0.95 setrgbcolor 550 {ypos} 180 30 rectfill')
        ps.append(f'0 0 0 setrgbcolor 550 {ypos} 180 30 rectstroke')
        ps.append(f'{c1} setrgbcolor 560 {ypos+20} moveto 590 {ypos+20} lineto stroke')
        ps.append(f'{c2} setrgbcolor [4 2] 0 setdash 560 {ypos+8} moveto 590 {ypos+8} lineto stroke [] 0 setdash')
        ps.append(f'0 0 0 setrgbcolor /Helvetica findfont 9 scalefont setfont')
        ps.append(f'595 {ypos+17} moveto ({l1}) show 595 {ypos+5} moveto ({l2}) show')
        
    draw_legend(495, 'Sunlit leaf (A_sun)', 'Shaded leaf (A_shade)', '0.85 0.35 0.1', '0.1 0.6 0.45')
    draw_legend(235, 'Sunlit leaf (rs_sun)', 'Shaded leaf (rs_shade)', '0.9 0.15 0.5', '0.45 0.4 0.7')
    
    ps.append('showpage')
    ps_file = output_png.replace('.png', '.ps')
    with open(ps_file, 'w') as f:
        f.write('\n'.join(ps))
        
    cmd = ['gs', '-dSAFER', '-dBATCH', '-dNOPAUSE', '-dEPSCrop', '-sDEVICE=png16m', '-r200', f'-sOutputFile={output_png}', ps_file]
    subprocess.run(cmd, check=True)
    if os.path.exists(ps_file):
        os.remove(ps_file)

def main():
    os.makedirs('results', exist_ok=True)
    
    with open('data/leaf_params.json', 'r') as f:
        leaf_params = json.load(f)
    df_forcing = pd.read_csv('data/forcing.csv')
    with open('data/test_cases.json', 'r') as f:
        test_cases = json.load(f)
        
    print(f"Loaded leaf params: {leaf_params}")
    print(f"Forcing series length: {len(df_forcing)} records")
    print(f"Test cases count: {len(test_cases)}")
    
    # 1. Diurnal forcing time series
    flux_rows = []
    for _, row in df_forcing.iterrows():
        res_sun = solve_coupled_leaf(row, row['par_sun_wm2'], leaf_params)
        res_shade = solve_coupled_leaf(row, row['par_shade_wm2'], leaf_params)
        flux_rows.append({
            'time_hr': row['time_hr'],
            'A_sun': res_sun['A'],
            'A_shade': res_shade['A'],
            'rs_sun': res_sun['rs'],
            'rs_shade': res_shade['rs'],
            'ci_sun': res_sun['ci'],
            'ci_shade': res_shade['ci'],
            'gs_sun': res_sun['gs'],
            'gs_shade': res_shade['gs']
        })
        
    df_fluxes = pd.DataFrame(flux_rows)
    fluxes_path = 'results/leaf_fluxes.csv'
    df_fluxes.to_csv(fluxes_path, index=False)
    print(f"Saved leaf fluxes to {fluxes_path}")
    
    # 2. Test cases convergence
    case_rows = []
    for tc in test_cases:
        row = df_forcing.iloc[tc['forcing_index']]
        res = solve_coupled_leaf(
            row,
            row['par_sun_wm2'],
            leaf_params,
            ci_init=tc['ci_init_pa'],
            max_iter=100,
            tol=1e-6
        )
        case_rows.append({
            'case_id': tc['case_id'],
            'ci_init_pa': tc['ci_init_pa'],
            'ci_final_pa': res['ci'],
            'A_final': res['A'],
            'rs_final': res['rs'],
            'n_iterations': res['n_iter']
        })
        
    df_cases = pd.DataFrame(case_rows)
    cases_path = 'results/case_convergence.csv'
    df_cases.to_csv(cases_path, index=False)
    print(f"Saved case convergence results to {cases_path}")
    print(df_cases)
    
    # 3. Diurnal plot
    fig_path = 'results/diurnal.png'
    render_plot(df_fluxes, fig_path)
    print(f"Saved diurnal cycle plot to {fig_path}")

if __name__ == '__main__':
    main()
