import pandas as pd
import numpy as np
from scipy import stats
import statsmodels.api as sm
import statsmodels.formula.api as smf

df = pd.read_csv('data/nls_incarceration_processed.csv')

years = [1985, 1990, 1996]

print("Total sample size:", len(df))
print("Ever jailed counts:\n", df['ever_jailed'].value_counts())

for yr in years:
    col = f'composite_wealth_{yr}'
    g0 = df[df['ever_jailed'] == 0][col]
    g1 = df[df['ever_jailed'] == 1][col]
    
    m0, med0, s0 = g0.mean(), g0.median(), g0.std()
    q25_0, q75_0 = g0.quantile(0.25), g0.quantile(0.75)
    
    m1, med1, s1 = g1.mean(), g1.median(), g1.std()
    q25_1, q75_1 = g1.quantile(0.25), g1.quantile(0.75)
    
    t_stat, t_p_2sided = stats.ttest_ind(g0, g1, equal_var=False)
    mwu_stat, mwu_p = stats.mannwhitneyu(g0, g1, alternative='greater')
    
    ols_unadj = smf.ols(f'{col} ~ ever_jailed', data=df).fit()
    ols_adj = smf.ols(f'{col} ~ ever_jailed + C(race) + C(sex)', data=df).fit()
    
    print(f"\n==================== YEAR {yr} ====================")
    print(f"Never Jailed (N={len(g0)}): Mean=${m0:,.2f}, Median=${med0:,.2f}, Std=${s0:,.2f}, IQR=[${q25_0:,.2f}, ${q75_0:,.2f}]")
    print(f"Ever Jailed  (N={len(g1)}): Mean=${m1:,.2f}, Median=${med1:,.2f}, Std=${s1:,.2f}, IQR=[${q25_1:,.2f}, ${q75_1:,.2f}]")
    print(f"Mean Difference (Never - Ever): ${m0 - m1:,.2f}")
    print(f"Welch t-test: t={t_stat:.4f}, p={t_p_2sided:.4e}")
    print(f"Mann-Whitney U (Never > Ever): U={mwu_stat:.1f}, p={mwu_p:.4e}")
    print(f"Unadjusted OLS: coef={ols_unadj.params['ever_jailed']:.2f}, SE={ols_unadj.bse['ever_jailed']:.2f}, p={ols_unadj.pvalues['ever_jailed']:.4e}")
    print(f"Adjusted OLS (race, sex): coef={ols_adj.params['ever_jailed']:.2f}, SE={ols_adj.bse['ever_jailed']:.2f}, p={ols_adj.pvalues['ever_jailed']:.4e}, 95% CI=({ols_adj.conf_int().loc['ever_jailed'][0]:.2f}, {ols_adj.conf_int().loc['ever_jailed'][1]:.2f})")

