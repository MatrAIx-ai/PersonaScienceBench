import json
import pandas as pd
from statsmodels.stats.proportion import proportion_confint

def run_analysis():
    data_path = 'data/meta-regression_study_data_heterogeneity_in_replication_projects.csv'
    df = pd.read_csv(data_path)
    
    # Filter Experimental Economics original studies
    ee_df = df[(df['project'] == 'ee') & (df['discipline'] == 'Economics')].copy()
    total_ee = len(ee_df)
    
    # Identify studies conducted in the United Kingdom
    uk_ee_df = ee_df[ee_df['experiment_country.o'] == 'United Kingdom']
    uk_count = len(uk_ee_df)
    
    proportion = uk_count / total_ee
    percentage = proportion * 100.0
    
    ci_low, ci_upp = proportion_confint(uk_count, total_ee, method='wilson')
    
    uk_study = uk_ee_df.iloc[0].to_dict()
    
    country_counts = ee_df['experiment_country.o'].value_counts().to_dict()
    
    results = {
        'total_ee_original_studies': total_ee,
        'uk_conducted_studies_count': uk_count,
        'proportion': round(proportion, 6),
        'fraction': f"{uk_count}/{total_ee}",
        'percentage': round(percentage, 2),
        'wilson_95_ci': [round(ci_low, 4), round(ci_upp, 4)],
        'country_distribution': country_counts,
        'uk_study_details': {
            'id': uk_study['id'],
            'title': uk_study['title'],
            'authors': uk_study['authors.o'],
            'pub_year': int(uk_study['pub_year']),
            'journal': uk_study['journal'],
            'volume': uk_study['volume'],
            'issue': uk_study['issue'],
            'sample_size': uk_study['n.o'],
            'effect_size': uk_study['effect_size.o'],
            'p_value': uk_study['p_value.o'],
            'replicated': bool(uk_study['replicated'])
        }
    }
    
    with open('analysis_results.json', 'w') as f:
        json.dump(results, f, indent=2)
        
    print(json.dumps(results, indent=2))

if __name__ == '__main__':
    run_analysis()
