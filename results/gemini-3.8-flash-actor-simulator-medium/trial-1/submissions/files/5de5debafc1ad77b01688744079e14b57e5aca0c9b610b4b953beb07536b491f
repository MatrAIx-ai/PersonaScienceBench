import os, sys, json
import numpy as np
import pandas as pd
import scipy.constants as const

if "/usr/lib/python3/dist-packages" not in sys.path:
    sys.path.append("/usr/lib/python3/dist-packages")
from PIL import Image, ImageDraw

def kabsch_alignment(P, Q):
    p_cen = P.mean(axis=0)
    q_cen = Q.mean(axis=0)
    P_c = P - p_cen
    Q_c = Q - q_cen
    H = P_c.T @ Q_c
    U, S, Vt = np.linalg.svd(H)
    D = np.eye(3)
    if np.linalg.det(Vt.T @ U.T) < 0:
        D[2, 2] = -1.0
    R = Vt.T @ D @ U.T
    P_aligned = P_c @ R.T + q_cen
    rmsd = np.sqrt(np.mean(np.sum((P_aligned - Q) ** 2, axis=1)))
    return R, P_aligned, float(rmsd)

def rotate_basis(modes_21x15, R):
    reshaped = modes_21x15.reshape(7, 3, 15)
    return np.einsum("ij, ajk -> aik", R, reshaped).reshape(21, 15)

def main():
    os.makedirs("results", exist_ok=True)
    with open("data/system_manifest.json") as f:
        manifest = json.load(f)
    freq_scale_factor = manifest["freq_scale_factor"]
    
    with open("data/medium_response.json") as f:
        medium = json.load(f)
        
    site_table = pd.read_csv("data/site_table.csv")
    frame_order = pd.read_csv("data/frame_site_order.csv")
    driving_force_df = pd.read_csv("data/driving_force_grid.csv")
    
    order_a = frame_order[frame_order["frame_id"] == "frame_a"].sort_values("site_id")["row_index"].values
    order_b = frame_order[frame_order["frame_id"] == "frame_b"].sort_values("site_id")["row_index"].values
    
    coords_a = np.load("data/frame_a_coords.npy")[order_a]
    coords_b = np.load("data/frame_b_coords.npy")[order_b]
    
    idx_a = np.array([3 * i + c for i in order_a for c in range(3)])
    idx_b = np.array([3 * i + c for i in order_b for c in range(3)])
    hess_a = np.load("data/frame_a_hessian.npy")[np.ix_(idx_a, idx_a)]
    hess_b = np.load("data/frame_b_hessian.npy")[np.ix_(idx_b, idx_b)]
    
    masses = site_table.sort_values("site_id")["mass_amu"].values
    m_vec = np.repeat(masses, 3)
    m_half = np.sqrt(m_vec)
    
    H_a_mw = (hess_a / m_half[:, None]) / m_half[None, :]
    H_b_mw = (hess_b / m_half[:, None]) / m_half[None, :]
    
    evals_a, evecs_a = np.linalg.eigh(H_a_mw)
    evals_b, evecs_b = np.linalg.eigh(H_b_mw)
    
    L_a = evecs_a[:, 6:]
    L_b = evecs_b[:, 6:]
    w2_a = evals_a[6:]
    w2_b = evals_b[6:]
    
    freq_a_cm = freq_scale_factor * np.sqrt(w2_a)
    freq_b_cm = freq_scale_factor * np.sqrt(w2_b)
    
    # Forward: compare frame B in frame A (Target: A, Source: B)
    R_f, coords_b_aligned, rmsd_f = kabsch_alignment(coords_b, coords_a)
    dr_f = (coords_b_aligned - coords_a).flatten()
    dq_f = dr_f * m_half
    dq_proj_f = L_a @ (L_a.T @ dq_f)
    Q_f = L_a.T @ dq_f
    
    # Backward: compare frame A in frame B (Target: B, Source: A)
    R_b, coords_a_aligned, rmsd_b = kabsch_alignment(coords_a, coords_b)
    dr_b = (coords_a_aligned - coords_b).flatten()
    dq_b = dr_b * m_half
    dq_proj_b = L_b @ (L_b.T @ dq_b)
    Q_b = L_b.T @ dq_b
    
    L_b_in_a = rotate_basis(L_b, R_f)
    L_a_in_b = rotate_basis(L_a, R_b)
    
    S_f = L_a.T @ L_b_in_a
    S_b = L_b.T @ L_a_in_b
    
    mode_overlap = np.zeros((2, 15, 15), dtype=np.float64)
    mode_overlap[0] = np.abs(S_f)
    mode_overlap[1] = np.abs(S_b)
    
    Q_trans_f = L_b_in_a.T @ dq_f
    Q_trans_b = L_a_in_b.T @ dq_b
    
    transported_proj = np.zeros((2, 15, 2), dtype=np.float64)
    transported_proj[0, :, 0] = np.abs(Q_f)
    transported_proj[0, :, 1] = np.abs(Q_trans_f)
    transported_proj[1, :, 0] = np.abs(Q_b)
    transported_proj[1, :, 1] = np.abs(Q_trans_b)
    
    lam_mode_f = 0.5 * w2_a * (Q_f ** 2)
    lam_mode_b = 0.5 * w2_b * (Q_b ** 2)
    
    lam_nm_f = float(np.sum(lam_mode_f))
    lam_nm_b = float(np.sum(lam_mode_b))
    lam_4pt_f = float(0.5 * dr_f @ hess_a @ dr_f)
    lam_4pt_b = float(0.5 * dr_b @ hess_b @ dr_b)
    
    lam_inner_eff_4pt = 0.5 * (lam_4pt_f + lam_4pt_b)
    lam_inner_eff_nm = 0.5 * (lam_nm_f + lam_nm_b)
    lam_inner_eff = lam_inner_eff_nm
    
    a0 = medium["shell_0_A"]
    a1 = medium["shell_1_A"]
    span_R = medium["span_A"]
    eps_fast = medium["eps_fast"]
    eps_slow = medium["eps_slow"]
    
    c_pekar = (1.0 / eps_fast) - (1.0 / eps_slow)
    geom_factor = (1.0 / (2.0 * a0)) + (1.0 / (2.0 * a1)) - (1.0 / span_R)
    e2_over_4pieps0 = const.e / (4.0 * const.pi * const.epsilon_0 * 1e-10)
    lambda_outer = float(e2_over_4pieps0 * c_pekar * geom_factor)
    lambda_total = float(lam_inner_eff + lambda_outer)
    
    temp_K = medium["temp_K"]
    coupling_eV = medium["coupling_eV"]
    V_J = coupling_eV * const.e
    lam_total_J = lambda_total * const.e
    kB_T_J = const.k * temp_K
    kB_T_eV = const.k * temp_K / const.e
    
    rate_prefactor = (2.0 * const.pi / const.hbar) * (V_J ** 2) / np.sqrt(4.0 * const.pi * lam_total_J * kB_T_J)
    k_self_exchange = float(rate_prefactor * np.exp(- lam_total_J / (4.0 * kB_T_J)))
    
    grid_axis = driving_force_df["axis_eV"].values
    k_et = rate_prefactor * np.exp(- ((grid_axis + lambda_total) ** 2) / (4.0 * lambda_total * kB_T_eV))
    log10_k_et = np.log10(k_et)
    
    rate_curve_df = pd.DataFrame({
        "grid_id": driving_force_df["grid_id"].values,
        "axis_eV": grid_axis,
        "k_et_s_inv": k_et,
        "log10_k_et_s_inv": log10_k_et
    })
    
    idx_peak = np.argmax(k_et)
    rate_peak_grid_id = int(driving_force_df["grid_id"].iloc[idx_peak])
    rate_peak_axis_eV = float(driving_force_df["axis_eV"].iloc[idx_peak])
    rate_peak_s_inv = float(k_et[idx_peak])
    
    sorted_grid = driving_force_df.copy()
    sorted_grid["k_et"] = k_et
    sorted_grid = sorted_grid.sort_values("axis_eV", ascending=False).reset_index(drop=True)
    sorted_peak_idx = sorted_grid["k_et"].idxmax()
    
    inverted_detected = sorted_peak_idx < (len(sorted_grid) - 1)
    if inverted_detected:
        first_inv_row = sorted_grid.iloc[sorted_peak_idx + 1]
        first_inverted_grid_id = int(first_inv_row["grid_id"])
        first_inverted_axis_eV = float(first_inv_row["axis_eV"])
    else:
        first_inverted_grid_id = None
        first_inverted_axis_eV = None
        
    dominant_mode_f = int(np.argmax(lam_mode_f))
    dominant_mode_b = int(np.argmax(lam_mode_b))
    
    rigid_norm_f = float(np.linalg.norm(dq_f))
    rigid_norm_b = float(np.linalg.norm(dq_b))
    projected_norm_f = float(np.linalg.norm(dq_proj_f))
    projected_norm_b = float(np.linalg.norm(dq_proj_b))
    
    closure_err_f = float(abs(lam_4pt_f - lam_nm_f))
    closure_err_b = float(abs(lam_4pt_b - lam_nm_b))
    effective_inner_consistency = float(abs(lam_inner_eff_4pt - lam_inner_eff_nm))
    
    diagnostics = {
        "alignment_rmsd_forward_A": rmsd_f,
        "alignment_rmsd_backward_A": rmsd_b,
        "closure_error_forward_eV": closure_err_f,
        "closure_error_backward_eV": closure_err_b,
        "effective_inner_consistency_eV": effective_inner_consistency,
        "rigid_norm_forward": rigid_norm_f,
        "rigid_norm_backward": rigid_norm_b,
        "projected_norm_forward": projected_norm_f,
        "projected_norm_backward": projected_norm_b,
        "dominant_mode_forward": dominant_mode_f,
        "dominant_mode_backward": dominant_mode_b,
        "rate_peak_grid_id": rate_peak_grid_id,
        "rate_peak_axis_eV": rate_peak_axis_eV,
        "rate_peak_s_inv": rate_peak_s_inv,
        "inverted_region_detected": bool(inverted_detected),
        "first_inverted_grid_id": first_inverted_grid_id,
        "first_inverted_axis_eV": first_inverted_axis_eV
    }
    
    aligned_disp = np.stack([dq_f, dq_b], axis=0)
    vib_basis = np.stack([L_a, L_b], axis=0)
    proj_disp = np.stack([dq_proj_f, dq_proj_b], axis=0)
    
    mode_proj = np.zeros((2, 15, 3), dtype=np.float64)
    mode_proj[0, :, 0] = freq_a_cm
    mode_proj[0, :, 1] = Q_f
    mode_proj[0, :, 2] = lam_mode_f
    mode_proj[1, :, 0] = freq_b_cm
    mode_proj[1, :, 1] = Q_b
    mode_proj[1, :, 2] = lam_mode_b
    
    lambda_summary_df = pd.DataFrame([{
        "lambda_4pt_forward_eV": lam_4pt_f,
        "lambda_4pt_backward_eV": lam_4pt_b,
        "lambda_nm_forward_eV": lam_nm_f,
        "lambda_nm_backward_eV": lam_nm_b,
        "lambda_inner_effective_eV": lam_inner_eff,
        "lambda_outer_eV": lambda_outer,
        "lambda_total_eV": lambda_total,
        "k_self_exchange_s_inv": k_self_exchange
    }])
    
    np.save("results/aligned_displacement_mw.npy", aligned_disp)
    np.save("results/vibrational_basis_mw.npy", vib_basis)
    np.save("results/mode_overlap.npy", mode_overlap)
    np.save("results/projected_displacement_mw.npy", proj_disp)
    np.save("results/transported_mode_projection.npy", transported_proj)
    np.save("results/mode_projection.npy", mode_proj)
    
    lambda_summary_df.to_csv("results/lambda_summary.csv", index=False)
    rate_curve_df.to_csv("results/rate_curve.csv", index=False)
    
    with open("results/diagnostics.json", "w") as f:
        json.dump(diagnostics, f, indent=2)
        
    generate_overview(sorted_grid, (rate_peak_axis_eV, rate_peak_s_inv),
                      k_self_exchange, lambda_total, lam_mode_f, lam_mode_b,
                      dominant_mode_f, dominant_mode_b, mode_overlap[0],
                      rmsd_f, rmsd_b, lam_4pt_f, lam_4pt_b, lam_nm_f, lam_nm_b,
                      lam_inner_eff, lambda_outer, first_inverted_axis_eV)
    print("Marcus ET analysis completed successfully.")

def generate_overview(sorted_grid, rate_peak, k_self, lam_total,
                      lam_mode_f, lam_mode_b, dom_f, dom_b, S_overlap,
                      rmsd_f, rmsd_b, l4_f, l4_b, lnm_f, lnm_b,
                      l_in, l_out, first_inv_ax):
    width, height = 1400, 1050
    img = Image.new("RGB", (width, height), color=(252, 253, 255))
    draw = ImageDraw.Draw(img)
    
    draw.rectangle([0, 0, width, 70], fill=(30, 41, 59))
    draw.text((40, 24), "Solution-Phase Marcus ET Reorganization Energy & Response Overview", fill=(255, 255, 255))
    
    panels = [
        (50, 90, 680, 520, "Panel A: Marcus ET Rate Curve & Inverted Region"),
        (720, 90, 1350, 520, "Panel B: Modal Reorganization Energy Spectrum"),
        (50, 550, 680, 980, "Panel C: Cross-Frame Vibrational Mode Overlap |S_AB|"),
        (720, 550, 1350, 980, "Panel D: Reorganization Energy & Diagnostic Summary")
    ]
    
    for x1, y1, x2, y2, title in panels:
        draw.rectangle([x1, y1, x2, y2], fill=(255, 255, 255), outline=(203, 213, 225), width=2)
        draw.rectangle([x1, y1, x2, y1 + 36], fill=(241, 245, 249))
        draw.line([(x1, y1 + 36), (x2, y1 + 36)], fill=(203, 213, 225), width=1)
        draw.text((x1 + 16, y1 + 10), title, fill=(30, 41, 59))

    # Panel A: Rate curve
    ax_x1, ax_y1, ax_x2, ax_y2 = 120, 160, 640, 470
    draw.rectangle([ax_x1, ax_y1, ax_x2, ax_y2], outline=(226, 232, 240), fill=(248, 250, 252))
    
    def to_ax(x, y):
        px = ax_x1 + (x - (-1.6)) / (0.4 - (-1.6)) * (ax_x2 - ax_x1)
        py = ax_y2 - (y - 0.0) / (12.0 - 0.0) * (ax_y2 - ax_y1)
        return px, py
        
    for xv in np.arange(-1.5, 0.4, 0.5):
        gx, _ = to_ax(xv, 0)
        draw.line([(gx, ax_y1), (gx, ax_y2)], fill=(226, 232, 240), width=1)
        draw.text((gx - 15, ax_y2 + 6), f"{xv:.1f}", fill=(100, 116, 139))
    for yv in range(0, 13, 3):
        _, gy = to_ax(0, yv)
        draw.line([(ax_x1, gy), (ax_x2, gy)], fill=(226, 232, 240), width=1)
        draw.text((ax_x1 - 30, gy - 7), f"{yv}", fill=(100, 116, 139))
        
    draw.text((320, ax_y2 + 25), "Driving Force ΔG° (eV)", fill=(30, 41, 59))
    draw.text((55, ax_y1 - 20), "log10(k_ET / s^-1)", fill=(30, 41, 59))
    
    pts = [to_ax(row["axis_eV"], np.log10(row["k_et"])) for _, row in sorted_grid.sort_values("axis_eV").iterrows()]
    for i in range(len(pts) - 1):
        draw.line([pts[i], pts[i + 1]], fill=(37, 99, 235), width=3)
        
    pk_x, pk_y = to_ax(rate_peak[0], np.log10(rate_peak[1]))
    draw.ellipse([pk_x - 6, pk_y - 6, pk_x + 6, pk_y + 6], fill=(220, 38, 38), outline=(255, 255, 255), width=2)
    draw.text((pk_x - 90, pk_y - 22), f"Peak: {rate_peak[0]:.2f} eV", fill=(220, 38, 38))
    
    se_x, se_y = to_ax(0.0, np.log10(k_self))
    draw.ellipse([se_x - 5, se_y - 5, se_x + 5, se_y + 5], fill=(16, 185, 129), outline=(255, 255, 255), width=2)
    draw.text((se_x - 125, se_y - 5), f"Self-Ex: log(k)={np.log10(k_self):.2f}", fill=(16, 185, 129))
    
    # Panel B: Mode spectrum
    bx_x1, bx_y1, bx_x2, bx_y2 = 790, 160, 1310, 470
    draw.rectangle([bx_x1, bx_y1, bx_x2, bx_y2], outline=(226, 232, 240), fill=(248, 250, 252))
    
    def to_bx(m_idx, l_val):
        px = bx_x1 + 18 + m_idx * ((bx_x2 - bx_x1 - 36) / 15)
        py = bx_y2 - (l_val / 0.55) * (bx_y2 - bx_y1)
        return px, py
        
    for yv in np.arange(0.0, 0.6, 0.1):
        _, gy = to_bx(0, yv)
        draw.line([(bx_x1, gy), (bx_x2, gy)], fill=(226, 232, 240), width=1)
        draw.text((bx_x1 - 38, gy - 7), f"{yv:.1f}", fill=(100, 116, 139))
    for m in range(15):
        px, _ = to_bx(m, 0)
        draw.text((px + 6, bx_y2 + 6), str(m), fill=(100, 116, 139))
        
    draw.text((1010, bx_y2 + 25), "Normal Mode Index (0-14)", fill=(30, 41, 59))
    draw.text((735, bx_y1 - 20), "Modal λ_k (eV)", fill=(30, 41, 59))
    
    bw = 12
    for m in range(15):
        fx, fy = to_bx(m, lam_mode_f[m])
        draw.rectangle([fx, fy, fx + bw, bx_y2], fill=(37, 99, 235))
        bx, by = to_bx(m, lam_mode_b[m])
        draw.rectangle([bx + bw + 2, by, bx + 2 * bw + 2, bx_y2], fill=(220, 38, 38))
        
    draw.rectangle([bx_x2 - 180, bx_y1 + 10, bx_x2 - 165, bx_y1 + 22], fill=(37, 99, 235))
    draw.text((bx_x2 - 158, bx_y1 + 9), f"Forward (Dom: {dom_f})", fill=(30, 41, 59))
    draw.rectangle([bx_x2 - 180, bx_y1 + 28, bx_x2 - 165, bx_y1 + 40], fill=(220, 38, 38))
    draw.text((bx_x2 - 158, bx_y1 + 27), f"Backward (Dom: {dom_b})", fill=(30, 41, 59))

    # Panel C: Mode overlap heatmap
    cx_x1, cy_y1, cx_x2, cy_y2 = 130, 610, 600, 950
    side = min(cx_x2 - cx_x1, cy_y2 - cy_y1)
    cell = side / 15.0
    for i in range(15):
        for j in range(15):
            val = S_overlap[i, j]
            r = int(255 * (1.0 - 0.85 * val))
            g = int(255 * (1.0 - 0.75 * val))
            b = int(255 * (1.0 - 0.15 * val))
            draw.rectangle([cx_x1 + j * cell, cy_y1 + i * cell,
                            cx_x1 + (j + 1) * cell, cy_y1 + (i + 1) * cell],
                           fill=(r, g, b), outline=(235, 238, 245))
    draw.text((270, cy_y2 + 8), "Frame B Retained Mode Index", fill=(30, 41, 59))
    draw.text((65, cy_y1 - 20), "Frame A Mode Index", fill=(30, 41, 59))

    # Panel D: Summary Card
    dx, dy = 760, 610
    rows = [
        ("Alignment RMSD (Fwd / Bwd):", f"{rmsd_f:.4f} Å  /  {rmsd_b:.4f} Å"),
        ("Inner λ (4-Point: Fwd / Bwd):", f"{l4_f:.4f} eV  /  {l4_b:.4f} eV"),
        ("Inner λ (Normal Mode: Fwd / Bwd):", f"{lnm_f:.4f} eV  /  {lnm_b:.4f} eV"),
        ("Effective Inner λ_inner,eff:", f"{l_in:.4f} eV"),
        ("Outer Dielectric λ_outer:", f"{l_out:.4f} eV"),
        ("Total Reorganization λ_total:", f"{lam_total:.4f} eV"),
        ("Dominant Mode Index:", f"Forward: Mode {dom_f} | Backward: Mode {dom_b}"),
        ("Self-Exchange Rate k_self:", f"{k_self:.4e} s^-1"),
        ("Rate Peak (-λ_total):", f"{rate_peak[0]:.4f} eV (k = {rate_peak[1]:.3e} s^-1)"),
        ("Marcus Inverted Region:", f"Detected (First inverted: {first_inv_ax:.4f} eV)")
    ]
    cur_y = dy
    for label, val_str in rows:
        draw.text((dx, cur_y), label, fill=(100, 116, 139))
        draw.text((dx + 300, cur_y), val_str, fill=(30, 41, 59))
        draw.line([(dx, cur_y + 24), (dx + 560, cur_y + 24)], fill=(241, 245, 249), width=1)
        cur_y += 32

    img.save("results/overview.png")

if __name__ == "__main__":
    main()
