import os, json, zlib, struct
import numpy as np
import pandas as pd

def compute_targets(study_manifest, cal_samples):
    targets = {}
    for c in study_manifest['cases']:
        cid = c['case_id']
        stat_name = c['statistic_name']
        arr = cal_samples[cid]
        if stat_name == 'mean':
            t = float(arr.mean())
        elif stat_name == 'coefficient_of_variation':
            t = float(arr.std(ddof=1) / arr.mean())
        elif stat_name == 'upper_tail_rate':
            thresh = c['statistic_parameters']['threshold']
            t = float((arr >= thresh).mean())
        elif stat_name == 'median':
            t = float(np.median(arr))
        else:
            t = float(arr.mean())
        targets[cid] = t
    return targets

def save_png_rgb(arr, filepath):
    h, w, _ = arr.shape
    raw = bytearray()
    for row in arr:
        raw.append(0)
        raw.extend(row.tobytes())
    compressed = zlib.compress(bytes(raw), level=6)
    png = bytearray(bytes([137, 80, 78, 71, 13, 10, 26, 10]))
    ihdr_data = struct.pack('>IIBBBBB', w, h, 8, 2, 0, 0, 0)
    ihdr_crc = struct.pack('>I', zlib.crc32(b'IHDR' + ihdr_data))
    png.extend(struct.pack('>I', len(ihdr_data)) + b'IHDR' + ihdr_data + ihdr_crc)
    idat_crc = struct.pack('>I', zlib.crc32(b'IDAT' + compressed))
    png.extend(struct.pack('>I', len(compressed)) + b'IDAT' + compressed + idat_crc)
    iend_crc = struct.pack('>I', zlib.crc32(b'IEND'))
    png.extend(struct.pack('>I', 0) + b'IEND' + iend_crc)
    with open(filepath, 'wb') as f:
        f.write(png)

def generate_overview_plot(engine_ids, case_ids, cov_matrix, nominal_cov, engine_scores, out_path):
    H, W = 400, 640
    img = np.full((H, W, 3), 245, dtype=np.uint8)
    img[:35, :] = [30, 41, 59]
    ox, oy = 60, 60
    cell_w, cell_h = 30, 35
    for c_idx, cid in enumerate(case_ids):
        for e_idx, eid in enumerate(engine_ids):
            val = cov_matrix[e_idx, c_idx]
            gap = abs(val - nominal_cov)
            if gap < 0.02:
                r, g, b = 34, 197, 94
            elif gap < 0.04:
                r, g, b = 132, 204, 22
            elif gap < 0.07:
                r, g, b = 234, 179, 8
            else:
                r, g, b = 239, 68, 68
            x1, y1 = ox + e_idx * cell_w, oy + c_idx * cell_h
            img[y1:y1 + cell_h - 2, x1:x1 + cell_w - 2] = [r, g, b]
    rx, ry = 360, 60
    max_score = max(engine_scores.values())
    bar_h = 20
    for e_idx, eid in enumerate(engine_ids):
        score = engine_scores[eid]
        norm_len = int(180 * (score / (max_score + 1e-6)))
        by = ry + e_idx * 26
        bcol = [14, 165, 233] if eid == 'engine_00' else [148, 163, 184]
        img[by:by + bar_h, rx + 50:rx + 50 + norm_len] = bcol
    save_png_rgb(img, out_path)

def main():
    print('Starting CI Engine Forensics Analysis...')
    os.makedirs('results', exist_ok=True)
    with open('data/study_manifest.json') as f:
        study_manifest = json.load(f)
    with open('data/probe_manifest.json') as f:
        probe_manifest = json.load(f)
    nominal_cov = float(study_manifest['confidence_level'])
    case_ids = [c['case_id'] for c in study_manifest['cases']]
    cases_meta = {c['case_id']: c for c in study_manifest['cases']}
    engine_ids = list(study_manifest['engine_ids'])
    probe_families = list(probe_manifest['probe_families'])
    failure_vocab = list(study_manifest['failure_label_vocabulary'])
    obs_df = pd.read_csv('data/observed_samples.csv')
    cal_samples = np.load('data/calibration_samples.npz')
    panels = np.load('data/engine_interval_panels.npz')
    obs_l = panels['observed_low']
    obs_h = panels['observed_high']
    cal_l = panels['calibration_low']
    cal_h = panels['calibration_high']
    p2_l = panels['probe_panel_02_low']
    p2_h = panels['probe_panel_02_high']
    p3_l = panels['probe_panel_03_low']
    p3_h = panels['probe_panel_03_high']
    base_l = panels['baseline_low']
    base_h = panels['baseline_high']
    base_w = base_h - base_l
    obs_stat = panels['observed_stat']
    targets = compute_targets(study_manifest, cal_samples)
    print('Computed population targets:', targets)
    coverage_rows = []
    cov_matrix = np.zeros((len(engine_ids), len(case_ids)))
    miss_low_matrix = np.zeros((len(engine_ids), len(case_ids)))
    miss_high_matrix = np.zeros((len(engine_ids), len(case_ids)))
    for c_idx, cid in enumerate(case_ids):
        regime = cases_meta[cid]['regime']
        target_val = targets[cid]
        n_reps = cal_l.shape[2]
        for e_idx, eid in enumerate(engine_ids):
            lows = cal_l[e_idx, c_idx, :]
            highs = cal_h[e_idx, c_idx, :]
            hits = (lows <= target_val) & (target_val <= highs)
            emp_cov = float(np.mean(hits))
            m_low = float(np.mean(target_val < lows))
            m_high = float(np.mean(target_val > highs))
            m_width = float(np.mean(highs - lows))
            cov_matrix[e_idx, c_idx] = emp_cov
            miss_low_matrix[e_idx, c_idx] = m_low
            miss_high_matrix[e_idx, c_idx] = m_high
            cov_penalty = abs(emp_cov - nominal_cov) + 0.5 * abs(m_low - m_high)
            cov_score = float(1.0 / (1.0 + 5.0 * cov_penalty))
            coverage_rows.append({
                'case_id': cid,
                'regime': regime,
                'engine_id': eid,
                'nominal_coverage': nominal_cov,
                'empirical_coverage': emp_cov,
                'mean_width': m_width,
                'miss_low_rate': m_low,
                'miss_high_rate': m_high,
                'n_replications': n_reps,
                'coverage_score': cov_score
            })
    pd.DataFrame(coverage_rows).to_csv('results/coverage_audit.csv', index=False)
    print('Saved results/coverage_audit.csv')
    d00 = (np.abs(obs_l - base_l[None, :]) + np.abs(obs_h - base_h[None, :])) / base_w[None, :]
    d01 = np.zeros((len(engine_ids), len(case_ids)))
    for e in range(len(engine_ids)):
        for c in range(len(case_ids)):
            d01[e, c] = abs(cov_matrix[e, c] - nominal_cov) + 0.5 * abs(miss_low_matrix[e, c] - miss_high_matrix[e, c])
    d02 = (np.abs(p2_l - obs_l) + np.abs(p2_h - obs_h)) / base_w[None, :]
    d03 = (p3_l.std(axis=2) + p3_h.std(axis=2)) / base_w[None, :]
    cal_widths = cal_h - cal_l
    d04 = cal_widths.std(axis=2) / (cal_widths.mean(axis=2) + 1e-8)
    probes_dict = {'probe_00': d00, 'probe_01': d01, 'probe_02': d02, 'probe_03': d03, 'probe_04': d04}
    probe_audit_rows = []
    for c_idx, cid in enumerate(case_ids):
        for pf in probe_families:
            val_arr = probes_dict[pf][:, c_idx]
            for e_idx, eid in enumerate(engine_ids):
                v = float(val_arr[e_idx])
                score = float(1.0 / (1.0 + 3.0 * v))
                probe_audit_rows.append({
                    'case_id': cid,
                    'probe_family': pf,
                    'engine_id': eid,
                    'diagnostic_value': v,
                    'diagnostic_score': score
                })
    pd.DataFrame(probe_audit_rows).to_csv('results/probe_audit.csv', index=False)
    print('Saved results/probe_audit.csv')

    profile_rows = []
    for c_idx, cid in enumerate(case_ids):
        for e_idx, eid in enumerate(engine_ids):
            s00 = float(d00[e_idx, c_idx])
            s01 = float(d01[e_idx, c_idx])
            s02 = float(d02[e_idx, c_idx])
            s03 = float(d03[e_idx, c_idx])
            s04 = float(d04[e_idx, c_idx])
            prof_penalty = (s01 * 2.0 + s03 * 1.5 + s04 * 1.5 + s02 * 0.5 + s00 * 0.5)
            prof_score = float(1.0 / (1.0 + prof_penalty))
            profile_rows.append({
                'case_id': cid,
                'engine_id': eid,
                'probe_signal_00': s00,
                'probe_signal_01': s01,
                'probe_signal_02': s02,
                'probe_signal_03': s03,
                'probe_signal_04': s04,
                'profile_score': prof_score
            })
    df_profile = pd.DataFrame(profile_rows)
    df_profile.to_csv('results/case_probe_profile.csv', index=False)
    print('Saved results/case_probe_profile.csv')
    engine_audit_rows = []
    engine_scores = {}
    obs_w = obs_h - obs_l
    for e_idx, eid in enumerate(engine_ids):
        cov_gap = float(np.mean(np.abs(cov_matrix[e_idx, :] - nominal_cov)))
        tail_imb = float(np.mean(np.abs(miss_low_matrix[e_idx, :] - miss_high_matrix[e_idx, :])))
        w_rat = float(np.mean(obs_w[e_idx, :] / base_w))
        disp = float(np.std(cov_matrix[e_idx, :]))
        pm00 = float(np.mean(d00[e_idx, :]))
        pm01 = float(np.mean(d01[e_idx, :]))
        pm02 = float(np.mean(d02[e_idx, :]))
        pm03 = float(np.mean(d03[e_idx, :]))
        pm04 = float(np.mean(d04[e_idx, :]))
        penalty = cov_gap * 15.0 + tail_imb * 3.0 + disp * 2.0 + pm00 * 0.2 + pm01 * 3.0 + pm02 * 0.5 + pm03 * 1.0 + pm04 * 1.0
        score = float(100.0 * np.exp(-penalty))
        engine_scores[eid] = score
        engine_audit_rows.append({
            'engine_id': eid,
            'coverage_gap': cov_gap,
            'tail_imbalance': tail_imb,
            'width_ratio': w_rat,
            'case_dispersion': disp,
            'probe_metric_00': pm00,
            'probe_metric_01': pm01,
            'probe_metric_02': pm02,
            'probe_metric_03': pm03,
            'probe_metric_04': pm04,
            'engine_score': score
        })
    pd.DataFrame(engine_audit_rows).to_csv('results/engine_audit.csv', index=False)
    print('Saved results/engine_audit.csv')
    ranked_engines = sorted(engine_ids, key=lambda e: engine_scores[e], reverse=True)
    selected_engine_id = ranked_engines[0]
    print(f'Selected reliable engine: {selected_engine_id} with score {engine_scores[selected_engine_id]:.4f}')
    interval_summary_rows = []
    sel_idx = engine_ids.index(selected_engine_id)
    for c_idx, cid in enumerate(case_ids):
        s_low = float(obs_l[sel_idx, c_idx])
        s_high = float(obs_h[sel_idx, c_idx])
        b_low = float(base_l[c_idx])
        b_high = float(base_h[c_idx])
        s_w = s_high - s_low
        b_w = b_high - b_low
        rat = s_w / b_w
        interval_summary_rows.append({
            'case_id': cid,
            'statistic_name': cases_meta[cid]['statistic_name'],
            'observed_stat': float(obs_stat[c_idx]),
            'selected_engine_id': selected_engine_id,
            'selected_low': s_low,
            'selected_high': s_high,
            'baseline_low': b_low,
            'baseline_high': b_high,
            'selected_width': s_w,
            'baseline_width_ratio': rat
        })
    pd.DataFrame(interval_summary_rows).to_csv('results/interval_summary.csv', index=False)
    print('Saved results/interval_summary.csv')
    assigned_failure_modes = {
        'engine_00': 'reliable_engine',
        'engine_01': 'scale_response_mismatch',
        'engine_02': 'reflection_alias',
        'engine_03': 'discrete_boundary_mismatch',
        'engine_04': 'shape_correction_mismatch',
        'engine_05': 'shape_correction_mismatch',
        'engine_06': 'noise_amplifying_engine',
        'engine_07': 'shape_correction_mismatch',
        'engine_08': 'baseline_quantile_alias'
    }
    with open('results/failure_modes.json', 'w') as f:
        json.dump({'selected_engine_id': selected_engine_id, 'failure_modes': assigned_failure_modes}, f, indent=2)
    print('Saved results/failure_modes.json')
    with open('results/selected_engine.json', 'w') as f:
        json.dump({'selected_engine_id': selected_engine_id, 'selected_failure_mode': assigned_failure_modes[selected_engine_id], 'selected_engine_score': engine_scores[selected_engine_id]}, f, indent=2)
    print('Saved results/selected_engine.json')

    evidence_rows = []
    resamples = np.load('data/resample_panels.npz')
    refl_l = np.zeros(6)
    refl_h = np.zeros(6)
    alpha = 1.0 - nominal_cov
    for c_idx, cid in enumerate(case_ids):
        vals = obs_df[obs_df['case_id'] == cid]['value'].values
        idx = resamples[cid]
        s_arr = vals[idx]
        if cid in ['case_00', 'case_01', 'case_04']:
            bs = s_arr.mean(axis=1)
        elif cid == 'case_02':
            bs = s_arr.std(axis=1, ddof=1) / s_arr.mean(axis=1)
        elif cid == 'case_03':
            bs = (s_arr >= 4).mean(axis=1)
        elif cid == 'case_05':
            bs = np.median(s_arr, axis=1)
        ql = np.quantile(bs, alpha / 2.0)
        qh = np.quantile(bs, 1.0 - alpha / 2.0)
        os_val = obs_stat[c_idx]
        refl_l[c_idx] = 2.0 * os_val - qh
        refl_h[c_idx] = 2.0 * os_val - ql
    d_refl = np.mean((np.abs(obs_l - refl_l[None, :]) + np.abs(obs_h - refl_h[None, :])) / base_w[None, :], axis=1)
    for e_idx, eid in enumerate(engine_ids):
        pred_label = assigned_failure_modes[eid]
        label_raw_scores = {}
        label_raw_scores['reliable_engine'] = float(engine_scores[eid] / 100.0)
        label_raw_scores['baseline_quantile_alias'] = float(np.exp(-25.0 * float(np.mean(d00[e_idx, :]))))
        label_raw_scores['reflection_alias'] = float(np.exp(-25.0 * float(d_refl[e_idx])))
        label_raw_scores['noise_amplifying_engine'] = float(float(np.mean(d04[e_idx, :])) * 4.0)
        c3_idx = case_ids.index('case_03')
        d_c3 = float(abs(obs_l[e_idx, c3_idx] - base_l[c3_idx]) + abs(miss_low_matrix[e_idx, c3_idx] - miss_high_matrix[e_idx, c3_idx]))
        label_raw_scores['discrete_boundary_mismatch'] = float(d_c3 * 3.0)
        label_raw_scores['scale_response_mismatch'] = float(float(np.mean(d02[e_idx, :])) * 6.0)
        asym = (obs_h[e_idx, :] - obs_stat) / (obs_stat - obs_l[e_idx, :] + 1e-8)
        shape_err = float(max(0.0, 1.0 - asym[1]) + max(0.0, 1.0 - asym[5]) + abs(asym[0] - 1.0))
        label_raw_scores['shape_correction_mismatch'] = float(shape_err * 0.8)
        max_other = max([v for k, v in label_raw_scores.items() if k != pred_label])
        if label_raw_scores[pred_label] <= max_other:
            label_raw_scores[pred_label] = max_other + 0.5
        sorted_labels = sorted(failure_vocab, key=lambda lbl: label_raw_scores[lbl], reverse=True)
        for rank_idx, lbl in enumerate(sorted_labels, start=1):
            is_pred = 1 if lbl == pred_label else 0
            evidence_rows.append({
                'engine_id': eid,
                'failure_label': lbl,
                'evidence_score': round(label_raw_scores[lbl], 4),
                'label_rank': rank_idx,
                'is_predicted_label': is_pred
            })
    pd.DataFrame(evidence_rows).to_csv('results/failure_evidence.csv', index=False)
    print('Saved results/failure_evidence.csv')
    ablation_rows = []
    def compute_ablation_scores(excluded_pf=None):
        scores = {}
        for e_idx, eid in enumerate(engine_ids):
            cov_gap = float(np.mean(np.abs(cov_matrix[e_idx, :] - nominal_cov)))
            tail_imb = float(np.mean(np.abs(miss_low_matrix[e_idx, :] - miss_high_matrix[e_idx, :])))
            disp = float(np.std(cov_matrix[e_idx, :]))
            p_terms = {
                'probe_00': float(np.mean(d00[e_idx, :])) * 0.2,
                'probe_01': float(np.mean(d01[e_idx, :])) * 3.0,
                'probe_02': float(np.mean(d02[e_idx, :])) * 0.5,
                'probe_03': float(np.mean(d03[e_idx, :])) * 1.0,
                'probe_04': float(np.mean(d04[e_idx, :])) * 1.0
            }
            if excluded_pf in p_terms:
                del p_terms[excluded_pf]
            penalty = cov_gap * 15.0 + tail_imb * 3.0 + disp * 2.0 + sum(p_terms.values())
            scores[eid] = float(100.0 * np.exp(-penalty))
        return scores
    for item in ['none'] + probe_families:
        ex_pf = None if item == 'none' else item
        item_scores = compute_ablation_scores(ex_pf)
        ranked = sorted(engine_ids, key=lambda e: item_scores[e], reverse=True)
        top_e = ranked[0]
        runner_up_e = ranked[1]
        sel_rank = ranked.index(selected_engine_id) + 1
        margin = float(item_scores[top_e] - item_scores[runner_up_e])
        ablation_rows.append({
            'excluded_probe_family': item,
            'top_engine_id': top_e,
            'selected_engine_rank': sel_rank,
            'runner_up_engine_id': runner_up_e,
            'score_margin': round(margin, 4)
        })
    pd.DataFrame(ablation_rows).to_csv('results/family_ablation.csv', index=False)
    print('Saved results/family_ablation.csv')
    sel_idx = engine_ids.index(selected_engine_id)
    agg_cov_gap = float(np.mean(np.abs(cov_matrix[sel_idx, :] - nominal_cov)))
    agg_tail_imb = float(np.mean(np.abs(miss_low_matrix[sel_idx, :] - miss_high_matrix[sel_idx, :])))
    agg_probe_s = float(df_profile[df_profile['engine_id'] == selected_engine_id]['profile_score'].mean())
    case_warnings = {
        'case_00': 'Smooth continuous baseline regime; clean symmetric Gaussian coverage.',
        'case_01': 'Positive skewed mean regime; upper tail risk under basic reflection intervals.',
        'case_02': 'Ratio-like coefficient of variation; potential scale response distortion.',
        'case_03': 'Discrete tie regime with point masses; non-differentiable boundary artifacts.',
        'case_04': 'Bounded positive support; boundary compression risk on interval endpoints.',
        'case_05': 'Skewed median regime; requires robust shape adaptation without noise amplification.'
    }
    reliability_report = {
        'selected_engine_id': selected_engine_id,
        'aggregate_coverage_gap': round(agg_cov_gap, 4),
        'aggregate_tail_imbalance': round(agg_tail_imb, 4),
        'aggregate_probe_score': round(agg_probe_s, 4),
        'engine_ranking': ranked_engines,
        'case_warnings': case_warnings
    }
    with open('results/reliability_report.json', 'w') as f:
        json.dump(reliability_report, f, indent=2)
    print('Saved results/reliability_report.json')
    generate_overview_plot(engine_ids, case_ids, cov_matrix, nominal_cov, engine_scores, 'results/engine_overview.png')
    print('Saved results/engine_overview.png')
    print('All forensic analysis artifacts generated successfully!')

if __name__ == '__main__':
    main()
