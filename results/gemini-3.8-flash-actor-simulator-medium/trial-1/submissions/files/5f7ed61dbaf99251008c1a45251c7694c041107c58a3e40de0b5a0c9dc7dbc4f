import pandas as pd
import numpy as np
from scipy import stats
import statsmodels.api as sm
import statsmodels.formula.api as smf

def run_analysis():
    # 1. Load data
    df = pd.read_csv('data/invaded_niche_pathways.csv', sep='\t')
    df_temp = pd.read_csv('data/temporal_trends_contingency_table.csv', sep='\t')
    df_sp = pd.read_csv('data/invasion_success_pathways.csv')
    df.columns = [c.replace('.', '_') for c in df.columns]

    # 2. Correlations with urban variables
    urban_vars = [c for c in df.columns if 'urban' in c]
    targets = ['n_gard', 'n_unint', 'n_agfo', 'n_total']
    
    corr_results = []
    for u in urban_vars:
        for t in targets:
            rho, p_rho = stats.spearmanr(df[u], df[t])
            r, p_r = stats.pearsonr(df[u], df[t])
            corr_results.append({
                'urban_var': u,
                'pathway': t,
                'spearman_rho': rho,
                'spearman_p': p_rho,
                'pearson_r': r,
                'pearson_p': p_r
            })
    corr_df = pd.DataFrame(corr_results)
    corr_df.to_csv('urban_pathway_correlations.csv', index=False)

    # 3. Univariate and Multivariate Poisson / Robust GLMs
    glm_results = []
    for t in targets:
        # Univariate
        m_uni = smf.poisson(f'{t} ~ urban_2009_500m', data=df).fit(cov_type='HC0', disp=False)
        # Multivariate with environmental controls
        m_multi = smf.poisson(f'{t} ~ urban_2009_500m + elevation + distance_road + distance_stream + annual_temperature + annual_rainfall', data=df).fit(cov_type='HC0', disp=False)
        
        ci_u = m_uni.conf_int().loc['urban_2009_500m']
        ci_m = m_multi.conf_int().loc['urban_2009_500m']
        
        glm_results.append({
            'pathway': t,
            'uni_coef': m_uni.params['urban_2009_500m'],
            'uni_p': m_uni.pvalues['urban_2009_500m'],
            'uni_IRR': np.exp(m_uni.params['urban_2009_500m']),
            'uni_CI_lower': np.exp(ci_u[0]),
            'uni_CI_upper': np.exp(ci_u[1]),
            'multi_coef': m_multi.params['urban_2009_500m'],
            'multi_p': m_multi.pvalues['urban_2009_500m'],
            'multi_IRR': np.exp(m_multi.params['urban_2009_500m']),
            'multi_CI_lower': np.exp(ci_m[0]),
            'multi_CI_upper': np.exp(ci_m[1])
        })
    glm_df = pd.DataFrame(glm_results)
    glm_df.to_csv('urban_pathway_glm_results.csv', index=False)

    # 4. Habitat contrast
    hab_summary = df.groupby('habitat')[['n_gard', 'n_unint', 'n_agfo', 'n_total']].agg(['mean', lambda x: (x > 0).mean()])
    hab_summary.to_csv('habitat_pathway_summary.csv')

    print("Analysis finished successfully.")

if __name__ == '__main__':
    run_analysis()
