import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf

def main():
    # Load dataset
    df_raw = pd.read_excel('data/data.xlsx')
    
    # Filter to valid patient records (Sequence number 1 to 80)
    df = df_raw.iloc[:80].copy()
    df['Age'] = pd.to_numeric(df['Age'])
    
    # Primary coding: Responder (Group 1 / PR) = 1, Non-responder (Group 2 / SD or PD) = 0
    df['response_pr'] = (df['Groups'] == 1).astype(int)
    
    # Reciprocal coding: Group 2 = 1, Group 1 = 0
    df['response_grp2'] = (df['Groups'] == 2).astype(int)
    
    print("=================================================================")
    print("Logistic Regression: P(Response = 1 | Age)")
    print("where Response = 1 denotes Group 1 (Partial Response, PR, n=41)")
    print("and Response = 0 denotes Group 2 (SD/PD, n=39)")
    print("=================================================================")
    
    model1 = smf.logit('response_pr ~ Age', data=df).fit()
    print(model1.summary())
    
    age_coef = model1.params['Age']
    age_se = model1.bse['Age']
    age_z = model1.tvalues['Age']
    age_p = model1.pvalues['Age']
    ci_lower, ci_upper = model1.conf_int().loc['Age']
    odds_ratio = np.exp(age_coef)
    or_lower = np.exp(ci_lower)
    or_upper = np.exp(ci_upper)
    
    print("\nPrimary Model Results (Response = PR vs SD/PD):")
    print(f"Age Coefficient (log-odds change): {age_coef:.6f} (approx. {age_coef:.4f})")
    print(f"Standard Error: {age_se:.6f} (approx. {age_se:.4f})")
    print(f"z-statistic: {age_z:.4f}")
    print(f"p-value: {age_p:.6e} ({age_p:.4f})")
    print(f"95% CI: [{ci_lower:.6f}, {ci_upper:.6f}] (approx. [{ci_lower:.4f}, {ci_upper:.4f}])")
    print(f"Odds Ratio: {odds_ratio:.6f} (approx. {odds_ratio:.4f})")
    print(f"95% CI for OR: [{or_lower:.6f}, {or_upper:.6f}] (approx. [{or_lower:.4f}, {or_upper:.4f}])")
    
    print("\n=================================================================")
    print("Reciprocal Coding: P(Group 2 = 1 | Age)")
    print("=================================================================")
    model2 = smf.logit('response_grp2 ~ Age', data=df).fit()
    print(model2.summary())
    print(f"Age Coefficient (log-odds change): {model2.params['Age']:.6f} (approx. {model2.params['Age']:.4f})")
    print(f"Odds Ratio: {np.exp(model2.params['Age']):.6f}")

if __name__ == '__main__':
    main()
