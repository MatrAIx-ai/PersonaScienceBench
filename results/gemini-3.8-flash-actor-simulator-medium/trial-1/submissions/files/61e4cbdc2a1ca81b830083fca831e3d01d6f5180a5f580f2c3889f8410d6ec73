import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf
from scipy.stats import chi2

# 1. Load datasets
df_niche = pd.read_csv('data/invaded_niche_pathways.csv', sep='\t')
df_niche.columns = [c.replace('.', '_') for c in df_niche.columns]
df_inv = pd.read_csv('data/invasion_success_pathways.csv')
df_temp = pd.read_csv('data/temporal_trends_contingency_table.csv', sep='\t')

# 2. Habitat-level summary of introduction pathways
hab_summary = df_niche.groupby('habitat')[['n_gard', 'n_unint', 'n_agfo', 'n_total', 'elevation', 'annual_temperature', 'urban_2009_500m', 'cropland_2009_500m']].mean()
hab_summary['gard_prop'] = hab_summary['n_gard'] / hab_summary['n_total']
print("=== Habitat Pathway Summary ===")
print(hab_summary.sort_values(by='n_gard', ascending=False))

# 3. Contextual GLMs: Testing context interactions across habitats
context_vars = ['urban_2009_500m', 'urban_2009_1000m', 'elevation', 'annual_temperature', 'annual_rainfall', 'distance_road', 'distance_stream']
glm_results = []
for var in context_vars:
    m_main = smf.glm(f'n_gard ~ C(habitat) + {var}', data=df_niche, family=sm.families.Poisson()).fit()
    m_int = smf.glm(f'n_gard ~ C(habitat) * {var}', data=df_niche, family=sm.families.Poisson()).fit()
    dev_diff = m_main.deviance - m_int.deviance
    p_val = chi2.sf(dev_diff, 9)
    glm_results.append({'variable': var, 'deviance_diff': dev_diff, 'p_value': p_val, 'aic': m_int.aic})

glm_df = pd.DataFrame(glm_results)
print("\n=== Context Interaction LRT Results ===")
print(glm_df.sort_values(by='deviance_diff', ascending=False))

# 4. Elevation Threshold Analysis (<400m vs >=400m)
df_niche['low_elevation'] = df_niche['elevation'] < 400
print("\n=== Elevation Strata n_gard ===")
print(df_niche.groupby('low_elevation')['n_gard'].describe())

# 5. Urbanization Threshold Analysis (>0.1 vs <=0.1)
df_niche['high_urban'] = df_niche['urban_2009_500m'] > 0.1
print("\n=== Urbanization Strata n_gard ===")
print(df_niche.groupby('high_urban')['n_gard'].describe())

# 6. Biological Traits by Introduction Pathway
trait_summary = df_inv.groupby('intro.pathway')[['height', 'mrt', 'invaded.niche.breadth', 'habitat.range']].mean()
print("\n=== Species Trait Summary ===")
print(trait_summary)
