import pandas as pd
import numpy as np

def run_analysis():
    # Load time series dataset
    df_ts = pd.read_csv('data/time_series_data.csv')
    df_cap = pd.read_csv('data/capital.csv')

    # Filter non-null centennial observations in time series
    ts_pts = df_ts[df_ts['PotteryForm'].notnull()][['CE', 'calBP', 'PotteryForm', 'PotteryDecoration']].copy()
    ts_pts['BCE'] = -ts_pts['CE']
    ts_pts = ts_pts.sort_values('CE').reset_index(drop=True)

    # Calculate step-wise differences forward in time
    ts_pts['diff_PotteryForm'] = ts_pts['PotteryForm'].diff()
    ts_pts['diff_PotteryDecoration'] = ts_pts['PotteryDecoration'].diff()

    print("=== Centennial Archaeological Time Series Points ===")
    print(ts_pts[['CE', 'BCE', 'calBP', 'PotteryForm', 'diff_PotteryForm', 'PotteryDecoration', 'diff_PotteryDecoration']])

    # Identify event where Pottery Form diversity collapses (drops) and Pottery Decoration increases
    simultaneous_event = ts_pts[(ts_pts['diff_PotteryForm'] < 0) & (ts_pts['diff_PotteryDecoration'] > 0)]
    print("\n=== Event with Simultaneous Collapse in PotteryForm and Increase in PotteryDecoration ===")
    print(simultaneous_event)

    return simultaneous_event

if __name__ == '__main__':
    run_analysis()
