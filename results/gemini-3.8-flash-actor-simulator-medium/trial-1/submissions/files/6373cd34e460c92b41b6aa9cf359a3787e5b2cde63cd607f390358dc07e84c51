import pandas as pd
import json

# Load dataset
file_path = 'data/meta-regression_study_data_heterogeneity_in_replication_projects.csv'
df = pd.read_csv(file_path)

# Filter for Experimental Economics
ee_df = df[df['project'] == 'ee'].copy()

# Deduplicate by unique study (id or title)
ee_unique = ee_df.drop_duplicates(subset=['id']).copy()

total_ee_studies = len(ee_unique)
uk_ee_studies = len(ee_unique[ee_unique['experiment_country.o'] == 'United Kingdom'])

proportion = uk_ee_studies / total_ee_studies
percentage = proportion * 100

print(f"Total original EE studies: {total_ee_studies}")
print(f"EE studies conducted in the United Kingdom: {uk_ee_studies}")
print(f"Proportion: {proportion:.6f} (exactly {uk_ee_studies}/{total_ee_studies})")
print(f"Percentage: {percentage:.2f}%")

# List details of the UK study
uk_study = ee_unique[ee_unique['experiment_country.o'] == 'United Kingdom'].iloc[0]
print("\nUK Study Details:")
print(f"ID: {uk_study['id']}")
print(f"Title: {uk_study['title']}")
print(f"Authors: {uk_study['authors.o']}")
print(f"Journal: {uk_study['journal']} ({uk_study['pub_year']})")

# Also verify if filtering by discipline == 'Economics' yields identical results
econ_df = df[df['discipline'] == 'Economics'].drop_duplicates(subset=['id'])
assert len(econ_df) == total_ee_studies
assert len(econ_df[econ_df['experiment_country.o'] == 'United Kingdom']) == uk_ee_studies

# Save summary results
results = {
    "total_ee_studies": total_ee_studies,
    "uk_ee_studies": uk_ee_studies,
    "proportion_fraction": f"{uk_ee_studies}/{total_ee_studies}",
    "proportion_decimal": round(proportion, 4),
    "proportion_percentage": round(percentage, 2),
    "uk_study_details": {
        "id": uk_study['id'],
        "title": uk_study['title'],
        "authors": uk_study['authors.o'],
        "journal": uk_study['journal'],
        "year": int(uk_study['pub_year'])
    }
}

with open("results.json", "w") as f:
    json.dump(results, f, indent=2)

print("\nResults successfully written to results.json")
