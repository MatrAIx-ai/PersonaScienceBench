#!/usr/bin/env python3
"""
Analysis of CpG site filtering in Zebra Finch (ZF_AgeRelated_CpG_noMT_Final.csv).
Question: How many sites are removed when filtering sites that do not show >90% or <10% methylation in Zebra Finch?
"""

import os
import pandas as pd

def main():
    data_path = "data/ZF_AgeRelated_CpG_noMT_Final.csv"
    if not os.path.exists(data_path):
        raise FileNotFoundError(f"Input file not found at {data_path}")

    df = pd.read_csv(data_path)

    # Basic stats
    total_rows = len(df)
    unique_sites = df["Pos"].unique()
    n_sites = len(unique_sites)

    print(f"Total rows: {total_rows}")
    print(f"Total unique CpG sites: {n_sites}")

    # 1. All sites: Strict condition (>90% or <10%)
    strict_qualifies = df.groupby("Pos")["MethylationPercentage"].apply(
        lambda x: ((x > 90.0) | (x < 10.0)).any()
    )
    n_kept_strict = strict_qualifies.sum()
    n_removed_strict = n_sites - n_kept_strict

    # 2. All sites: Non-strict condition (>=90% or <=10%)
    nonstrict_qualifies = df.groupby("Pos")["MethylationPercentage"].apply(
        lambda x: ((x >= 90.0) | (x <= 10.0)).any()
    )
    n_kept_nonstrict = nonstrict_qualifies.sum()
    n_removed_nonstrict = n_sites - n_kept_nonstrict

    # 3. Full coverage sites only (SampleShared == 20)
    sites_shared20 = df[df["SampleShared"] == 20]["Pos"].unique()
    n_sites_shared20 = len(sites_shared20)
    df_shared20 = df[df["Pos"].isin(sites_shared20)]

    strict_qualifies_s20 = df_shared20.groupby("Pos")["MethylationPercentage"].apply(
        lambda x: ((x > 90.0) | (x < 10.0)).any()
    )
    n_kept_strict_s20 = strict_qualifies_s20.sum()
    n_removed_strict_s20 = n_sites_shared20 - n_kept_strict_s20

    nonstrict_qualifies_s20 = df_shared20.groupby("Pos")["MethylationPercentage"].apply(
        lambda x: ((x >= 90.0) | (x <= 10.0)).any()
    )
    n_kept_nonstrict_s20 = nonstrict_qualifies_s20.sum()
    n_removed_nonstrict_s20 = n_sites_shared20 - n_kept_nonstrict_s20

    print("\n--- RESULTS SUMMARY ---")
    print(f"1. All sites (N={n_sites}):")
    print(f"   Strict (>90% or <10%): Kept={n_kept_strict}, Removed={n_removed_strict}")
    print(f"   Non-strict (>=90% or <=10%): Kept={n_kept_nonstrict}, Removed={n_removed_nonstrict}")
    print(f"\n2. Fully shared sites (SampleShared == 20, N={n_sites_shared20}):")
    print(f"   Strict (>90% or <10%): Kept={n_kept_strict_s20}, Removed={n_removed_strict_s20}")
    print(f"   Non-strict (>=90% or <=10%): Kept={n_kept_nonstrict_s20}, Removed={n_removed_nonstrict_s20}")

    print(f"\nFinal Primary Answer (Strict condition across all sites): {n_removed_strict}")

if __name__ == "__main__":
    main()
