import numpy as np
import pandas as pd
import statsmodels.api as sm
import statsmodels.formula.api as smf

def run_analysis():
    # 1. Load data
    df_raw = pd.read_excel('data/data.xlsx')
    
    # 2. Preprocess data: drop trailing blank rows and keep 80 valid patient records
    df = df_raw.iloc[:80].copy()
    df['Age'] = pd.to_numeric(df['Age'], errors='coerce')
    df['is_PR'] = (df['Efficacy'] == 'PR').astype(int)
    
    print("Dataset shape:", df.shape)
    print("Outcome distribution (is_PR):")
    print(df['is_PR'].value_counts())
    print("\nAge descriptive statistics:")
    print(df['Age'].describe())
    
    # 3. Fit logistic regression model
    model = smf.logit('is_PR ~ Age', data=df).fit()
    print("\nLogistic Regression Model Summary:")
    print(model.summary())
    
    # 4. Predict probability for Age = 65
    target_age = pd.DataFrame({'Age': [65]})
    pred_prob = model.predict(target_age).iloc[0]
    
    # Also manual calculation from coefficients
    intercept = model.params['Intercept']
    coef_age = model.params['Age']
    logit_val = intercept + coef_age * 65
    manual_prob = 1 / (1 + np.exp(-logit_val))
    
    print("\n--- Results for Age 65 ---")
    print(f"Intercept (beta_0): {intercept:.6f}")
    print(f"Age coefficient (beta_1): {coef_age:.6f}")
    print(f"Logit value at Age 65: {logit_val:.6f}")
    print(f"Predicted probability (model.predict): {pred_prob:.8f}")
    print(f"Predicted probability (manual): {manual_prob:.8f}")
    print(f"Formatted decimal (4 decimal places): {pred_prob:.4f}")
    print(f"Formatted percentage (2 decimal places): {pred_prob * 100:.2f}%")

if __name__ == '__main__':
    run_analysis()
