import pandas as pd
import numpy as np
import statsmodels.formula.api as smf
from scipy import stats

def run_analysis():
    df = pd.read_csv('data/nls_ses_processed.csv')
    df.rename(columns={
        'BA DEGREE COMPLETED': 'BA_DEGREE',
        'SAMPLE_RACE': 'RACE',
        'SAMPLE_SEX': 'SEX',
        'FAMILY SIZE OF SAMPLE': 'FAMILY_SIZE',
        'ABILITY: COMPOSITE OF ASVAB SCORE': 'ABILITY',
        'PERCENTILE IN CLASS': 'PERCENTILE',
        'SES': 'SES'
    }, inplace=True)
    df['BA_DEGREE'] = df['BA_DEGREE'].astype(int)

    # 1. Descriptive stats
    desc = df.groupby('RACE').agg(
        n=('BA_DEGREE', 'count'),
        ba_completed=('BA_DEGREE', 'sum'),
        ba_rate=('BA_DEGREE', 'mean'),
        ses_mean=('SES', 'mean'),
        ses_std=('SES', 'std'),
        ses_median=('SES', 'median'),
        ability_mean=('ABILITY', 'mean'),
        percentile_mean=('PERCENTILE', 'mean')
    )

    # 2. Main-effects unadjusted model
    m_main_unadj = smf.logit('BA_DEGREE ~ SES + C(RACE)', data=df).fit(disp=False)

    # 3. Interaction unadjusted model (Black reference)
    m_int_unadj_black = smf.logit('BA_DEGREE ~ SES * C(RACE, Treatment(reference="Black"))', data=df).fit(disp=False)
    m_int_unadj_white = smf.logit('BA_DEGREE ~ SES * C(RACE, Treatment(reference="White"))', data=df).fit(disp=False)

    # LR test for unadjusted interaction
    lr_stat_unadj = 2 * (m_int_unadj_black.llf - m_main_unadj.llf)
    lr_p_unadj = stats.chi2.sf(lr_stat_unadj, df=2)

    # 4. Stratified unadjusted models
    strat_unadj = {}
    for r in ['White', 'Black', 'Hispanic']:
        sub = df[df['RACE'] == r]
        m = smf.logit('BA_DEGREE ~ SES', data=sub).fit(disp=False)
        ci = m.conf_int()
        strat_unadj[r] = {
            'coef': m.params['SES'],
            'se': m.bse['SES'],
            'p': m.pvalues['SES'],
            'or': np.exp(m.params['SES']),
            'ci_lower': np.exp(ci.loc['SES', 0]),
            'ci_upper': np.exp(ci.loc['SES', 1])
        }

    # 5. Adjusted models with academic controls (ABILITY, PERCENTILE) and background controls (FAMILY_SIZE, SEX)
    m_main_adj = smf.logit('BA_DEGREE ~ SES + C(RACE) + ABILITY + PERCENTILE + FAMILY_SIZE + C(SEX)', data=df).fit(disp=False)
    m_int_adj_black = smf.logit('BA_DEGREE ~ SES * C(RACE, Treatment(reference="Black")) + ABILITY + PERCENTILE + FAMILY_SIZE + C(SEX)', data=df).fit(disp=False)
    lr_stat_adj = 2 * (m_int_adj_black.llf - m_main_adj.llf)
    lr_p_adj = stats.chi2.sf(lr_stat_adj, df=2)

    # Stratified adjusted models
    strat_adj = {}
    for r in ['White', 'Black', 'Hispanic']:
        sub = df[df['RACE'] == r]
        m = smf.logit('BA_DEGREE ~ SES + ABILITY + PERCENTILE + FAMILY_SIZE + C(SEX)', data=sub).fit(disp=False)
        ci = m.conf_int()
        strat_adj[r] = {
            'coef': m.params['SES'],
            'se': m.bse['SES'],
            'p': m.pvalues['SES'],
            'or': np.exp(m.params['SES']),
            'ci_lower': np.exp(ci.loc['SES', 0]),
            'ci_upper': np.exp(ci.loc['SES', 1])
        }

    return {
        'desc': desc,
        'm_int_unadj_black': m_int_unadj_black,
        'lr_unadj': (lr_stat_unadj, lr_p_unadj),
        'strat_unadj': strat_unadj,
        'm_int_adj_black': m_int_adj_black,
        'lr_adj': (lr_stat_adj, lr_p_adj),
        'strat_adj': strat_adj
    }

if __name__ == '__main__':
    res = run_analysis()
    print("Execution completed successfully.")
