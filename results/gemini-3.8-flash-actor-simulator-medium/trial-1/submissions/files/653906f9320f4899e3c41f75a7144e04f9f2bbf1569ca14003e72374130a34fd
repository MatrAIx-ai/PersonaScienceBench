import pandas as pd

# Load dataset
df = pd.read_csv('data/meta-regression_study_data_heterogeneity_in_replication_projects.csv')

# Filter for Psychology replication project (RPP)
rpp = df[df['project'] == 'rpp']

# 1. Successful replications in RPP (replicated == 1)
rpp_replicated = rpp[rpp['replicated'] == 1]
total_rep = len(rpp_replicated)

print(f"=== 1. All Successful Replications in Psychology (RPP, N = {total_rep}) ===")
rep_sr = rpp_replicated['seniority.r'].value_counts()
print(rep_sr)
print("Proportions:")
print(rep_sr / total_rep)

asst_prof_count = (rpp_replicated['seniority.r'] == 'Assistant Professor').sum()
asst_count = (rpp_replicated['seniority.r'] == 'Assistant').sum()
print(f"Assistant Professor: {asst_prof_count}/{total_rep} = {asst_prof_count/total_rep:.4f} ({asst_prof_count/total_rep*100:.2f}%)")
print(f"Assistant Professor + Assistant: {(asst_prof_count + asst_count)}/{total_rep} = {(asst_prof_count + asst_count)/total_rep:.4f} ({(asst_prof_count + asst_count)/total_rep*100:.2f}%)")

# 2. Applying drop == False
rpp_nodrop_rep = rpp[(rpp['drop'] == False) & (rpp['replicated'] == 1)]
total_nodrop_rep = len(rpp_nodrop_rep)
print(f"\n=== 2. Drop == False Filter (RPP, N = {total_nodrop_rep}) ===")
asst_prof_nodrop = (rpp_nodrop_rep['seniority.r'] == 'Assistant Professor').sum()
asst_nodrop = (rpp_nodrop_rep['seniority.r'] == 'Assistant').sum()
print(f"Assistant Professor: {asst_prof_nodrop}/{total_nodrop_rep} = {asst_prof_nodrop/total_nodrop_rep:.4f} ({asst_prof_nodrop/total_nodrop_rep*100:.2f}%)")
print(f"Assistant Professor + Assistant: {(asst_prof_nodrop + asst_nodrop)}/{total_nodrop_rep} = {(asst_prof_nodrop + asst_nodrop)/total_nodrop_rep:.4f} ({(asst_prof_nodrop + asst_nodrop)/total_nodrop_rep*100:.2f}%)")

# 3. Original studies (seniority.o)
print(f"\n=== 3. Original Studies Seniority (seniority.o, N = {total_rep}) ===")
orig_so = rpp_replicated['seniority.o'].value_counts()
print(orig_so)
print("Proportions:")
print(orig_so / total_rep)
