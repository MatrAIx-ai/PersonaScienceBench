import pandas as pd
import numpy as np
from scipy.stats import pearsonr

def main():
    print("Loading sample metadata...")
    df_samples = pd.read_csv('data/Sample_annotated_Zenodo.csv')
    cd4_samples = df_samples[df_samples['celltype'] == 'CD4']['sample'].tolist()
    print(f"Total CD4 samples: {len(cd4_samples)}")

    print("Loading gene metadata...")
    df_genes = pd.read_csv('data/GeneMetaInfo_Zenodo.csv')
    pc_genes = df_genes[df_genes['gene_biotype'] == 'protein_coding'].copy()
    print(f"Total protein-coding genes: {len(pc_genes)}")

    print("Loading batch-corrected read counts...")
    # Read index and only CD4 columns to optimize memory/speed
    counts = pd.read_csv('data/BatchCorrectedReadCounts_Zenodo.csv', index_col=0, usecols=[0] + [i for i, col in enumerate(pd.read_csv('data/BatchCorrectedReadCounts_Zenodo.csv', nrows=1).columns) if col in cd4_samples])
    
    print(f"Count matrix loaded with shape: {counts.shape}")

    # Align protein-coding genes
    pc_gene_ids = pc_genes['Geneid'].values
    pc_counts = counts.loc[pc_gene_ids]
    
    # Calculate arithmetic mean expression across CD4 samples
    mean_expr = pc_counts.mean(axis=1)

    # Get gene lengths aligned to mean_expr
    gene_length_dict = dict(zip(pc_genes['Geneid'], pc_genes['Length']))
    gene_lengths = mean_expr.index.map(gene_length_dict).values

    # Calculate Pearson correlation coefficient
    corr, pval = pearsonr(gene_lengths, mean_expr.values)

    print("\n--- RESULTS ---")
    print(f"Number of protein-coding genes analyzed: {len(mean_expr)}")
    print(f"Number of CD4 samples: {len(counts.columns)}")
    print(f"Pearson correlation coefficient (r): {corr}")
    print(f"Pearson r (4 decimal places): {corr:.4f}")
    print(f"Pearson r (5 decimal places): {corr:.5f}")
    print(f"p-value: {pval}")

    # Additional summary statistics
    print("\nGene Length Summary:")
    print(pd.Series(gene_lengths).describe())
    print("\nMean Expression Summary:")
    print(mean_expr.describe())

if __name__ == '__main__':
    main()
