import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf

# Load dataset
df = pd.read_csv('data/invaded_niche_pathways.csv', sep='\t')
df.columns = [c.replace('.', '_') for c in df.columns]

# 1. Pearson correlations across pathways, scales, and years
scales = ['50m', '500m', '1000m']
years = ['1956', '1993', '2009']
pathways = ['n_unint', 'n_gard', 'n_agfo', 'n_total']

print("=== Pearson Correlation Matrix ===")
corr_matrix = df[pathways + [f'urban_{y}_{s}' for y in years for s in scales]].corr()[pathways]
print(corr_matrix.loc[[f'urban_{y}_{s}' for y in years for s in scales]])

# 2. Univariate Poisson GLMs
print("\n=== Univariate Poisson GLM Results ===")
uni_res = []
for p in pathways:
    for y in years:
        for s in scales:
            var = f'urban_{y}_{s}'
            mod = smf.glm(f'{p} ~ {var}', data=df, family=sm.families.Poisson()).fit()
            uni_res.append({
                'pathway': p, 'year': y, 'scale': s,
                'coef': mod.params[var], 'z': mod.tvalues[var],
                'p_value': mod.pvalues[var],
                'pseudo_r2': 1 - (mod.deviance / mod.null_deviance)
            })
uni_df = pd.DataFrame(uni_res)
print(uni_df.to_string(index=False))

# 3. Multivariable Poisson GLMs (controlling for cropland, elevation, road distance, climate)
print("\n=== Multivariable Poisson GLM at 500m Buffer (2009) ===")
covars = 'cropland_2009_500m + elevation + distance_road + distance_stream + annual_temperature + annual_rainfall'
for p in ['n_unint', 'n_gard', 'n_agfo']:
    m = smf.glm(f'{p} ~ urban_2009_500m + {covars}', data=df, family=sm.families.Poisson()).fit()
    print(f"\n--- Model for {p} ---")
    print(f"urban_2009_500m: coef={m.params['urban_2009_500m']:.4f}, z={m.tvalues['urban_2009_500m']:.3f}, p={m.pvalues['urban_2009_500m']:.4e}")

# 4. Multi-scale multivariable comparison for n_unint
print("\n=== Multivariable Scale Comparison for n_unint (2009) ===")
for s in scales:
    cov_s = f'cropland_2009_{s} + elevation + distance_road + distance_stream + annual_temperature + annual_rainfall'
    m = smf.glm(f'n_unint ~ urban_2009_{s} + {cov_s}', data=df, family=sm.families.Poisson()).fit()
    print(f"Scale {s}: coef={m.params[f'urban_2009_{s}']:.4f}, z={m.tvalues[f'urban_2009_{s}']:.3f}, p={m.pvalues[f'urban_2009_{s}']:.4e}, AIC={m.aic:.1f}")

