import pandas as pd
import numpy as np
import statsmodels.formula.api as smf

def run_econometric_analysis():
    df = pd.read_csv('data/worldbank_education_gdp.csv')
    years = [c for c in df.columns if '[' in c]
    yr_nums = [int(c.split(' ')[0]) for c in years]

    long_rows = []
    for idx, row in df.iterrows():
        grp = row['Country Group']
        code = row['Country Code']
        series = row['Series Name']
        for yr_col, yr in zip(years, yr_nums):
            val = row[yr_col]
            long_rows.append({
                'country': code,
                'country_group': grp,
                'series_name': series,
                'year': yr,
                'value': pd.to_numeric(val, errors='coerce')
            })

    piv = pd.DataFrame(long_rows).pivot(index=['country', 'country_group', 'year'], columns='series_name', values='value').reset_index()
    piv.columns = ['country', 'country_group', 'year', 'edu_exp', 'exports', 'gni_pc', 'labor_force', 'prim_enroll', 'sec_enroll']
    piv['ssa'] = (piv['country'] == 'SSF').astype(int)
    piv['log_gni_pc'] = np.log(piv['gni_pc'])
    piv['log_edu_exp'] = np.log(piv['edu_exp'])

    # 1. Overlapping window analysis (2011-2015)
    sub = piv[piv['year'] >= 2011].copy()

    # Model 1: Baseline Interaction
    m1 = smf.ols('log_gni_pc ~ log_edu_exp * ssa', data=sub).fit()

    # Model 2: Controlled for Exports (Proxy for Global Economic Output)
    m2 = smf.ols('log_gni_pc ~ log_edu_exp * ssa + exports', data=sub).fit()

    # Model 3: Controlled for Labor Force Participation
    m3 = smf.ols('log_gni_pc ~ log_edu_exp * ssa + labor_force', data=sub).fit()

    # Model 4: Controlled for Secondary Enrollment
    m4 = smf.ols('log_gni_pc ~ log_edu_exp * ssa + sec_enroll', data=sub).fit()

    print("=== MODEL 1: Baseline Interaction ===")
    print(m1.summary())

    print("\n=== MODEL 2: Exports Controlled ===")
    print(m2.summary())

    print("\n=== MODEL 3: Labor Force Controlled ===")
    print(m3.summary())

    print("\n=== MODEL 4: Secondary Enrollment Controlled ===")
    print(m4.summary())

    return {
        'm1': m1,
        'm2': m2,
        'm3': m3,
        'm4': m4
    }

if __name__ == '__main__':
    run_econometric_analysis()
