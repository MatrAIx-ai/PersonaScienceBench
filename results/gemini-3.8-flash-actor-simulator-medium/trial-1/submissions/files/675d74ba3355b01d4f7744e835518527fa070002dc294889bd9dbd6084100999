import pandas as pd
from scipy.stats import chi2_contingency

# Load data
file_path = "data/MeRIP_RNA_result.xlsx"
df = pd.read_excel(file_path)

# Verify shape and columns
print(f"Loaded {df.shape[0]} rows and {df.shape[1]} columns.")
print(f"Columns: {list(df.columns)}")

# Construct contingency table
contingency_table = pd.crosstab(df['m6A'], df['DEG'])
print("\nContingency Table (m6A vs DEG):")
print(contingency_table)

# Perform Pearson's Chi-squared test of independence
chi2_stat, p_value, dof, expected = chi2_contingency(contingency_table)

print("\n--- Chi-Squared Test Results ---")
print(f"Chi-square statistic: {chi2_stat}")
print(f"Degrees of freedom: {dof}")
print(f"p-value: {p_value:.6e}")
print(f"p-value (full precision): {p_value}")

# Expected frequencies table
expected_df = pd.DataFrame(expected, index=contingency_table.index, columns=contingency_table.columns)
print("\nExpected Frequencies Table:")
print(expected_df)
