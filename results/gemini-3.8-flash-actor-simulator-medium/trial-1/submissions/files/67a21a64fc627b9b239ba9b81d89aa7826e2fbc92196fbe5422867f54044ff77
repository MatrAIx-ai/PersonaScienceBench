import pandas as pd
import numpy as np

# Load datasets
study_df = pd.read_csv('data/meta-regression_study_data_heterogeneity_in_replication_projects.csv')

def summarize(series):
    return {
        'count': int(series.count()),
        'mean': round(float(series.mean()), 2),
        'std': round(float(series.std()), 2),
        'median': round(float(series.median()), 2),
        'min': float(series.min()),
        'max': float(series.max())
    }

# 1. Deduplicated at original paper level (by unique title)
unique_papers = study_df.drop_duplicates(subset=['title']).copy()

# Experimental Economics
econ = unique_papers[unique_papers['discipline'] == 'Economics']['length']

# Psychology overall (Social + Cognitive)
psych_overall = unique_papers[unique_papers['discipline'].isin(['Social', 'Cognitive'])]['length']
psych_social = unique_papers[unique_papers['discipline'] == 'Social']['length']
psych_cognitive = unique_papers[unique_papers['discipline'] == 'Cognitive']['length']
psych_rpp = unique_papers[unique_papers['project'] == 'rpp']['length']

# Clean subset (excluding drop == True)
clean_papers = study_df[~study_df['drop']].drop_duplicates(subset=['title']).copy()
clean_econ = clean_papers[clean_papers['discipline'] == 'Economics']['length']
clean_psych_overall = clean_papers[clean_papers['discipline'].isin(['Social', 'Cognitive'])]['length']
clean_psych_rpp = clean_papers[clean_papers['project'] == 'rpp']['length']

if __name__ == '__main__':
    print("Deduplicated Original Paper Length Statistics:")
    print("Experimental Economics:", summarize(econ))
    print("Psychology Overall (Social + Cognitive):", summarize(psych_overall))
    print("  - Social Psychology:", summarize(psych_social))
    print("  - Cognitive Psychology:", summarize(psych_cognitive))
    print("  - RPP Project only:", summarize(psych_rpp))
    print("\nClean Subset (drop == False):")
    print("Experimental Economics:", summarize(clean_econ))
    print("Psychology Overall:", summarize(clean_psych_overall))
    print("  - RPP Project only:", summarize(clean_psych_rpp))
