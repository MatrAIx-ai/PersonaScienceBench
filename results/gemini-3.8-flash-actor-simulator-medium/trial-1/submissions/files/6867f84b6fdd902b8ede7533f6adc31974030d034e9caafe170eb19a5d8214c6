import pandas as pd
import numpy as np
from scipy import stats
import statsmodels.api as sm
import statsmodels.formula.api as smf

# Load dataset
df = pd.read_csv('data/meta-regression_joined_data_heterogeneity_in_replication_projects.csv')

# Compute difference metrics
df['diff_r'] = df['ro'] - df['rr']
df['diff_fis'] = df['fiso'] - df['fisr']

disciplines = ['Cognitive', 'Economics', 'Social']
results = {}

for d in disciplines:
    sub = df[df['discipline'] == d]
    n = len(sub)
    ro = sub['ro']
    rr = sub['rr']
    fiso = sub['fiso']
    fisr = sub['fisr']
    rel = sub['relative_es']
    diff_r = sub['diff_r']
    diff_fis = sub['diff_fis']
    
    t_r = stats.ttest_rel(ro, rr)
    w_r = stats.wilcoxon(ro, rr)
    t_fis = stats.ttest_rel(fiso, fisr)
    w_fis = stats.wilcoxon(fiso, fisr)
    
    n_pos = (diff_r > 0).sum()
    binom_res = stats.binomtest(n_pos, n, p=0.5, alternative='greater')
    
    t_rel = stats.ttest_1samp(rel, 1.0, alternative='less')
    w_rel = stats.wilcoxon(rel - 1.0, alternative='less')
    
    results[d] = {
        'N': n,
        'ro_mean': ro.mean(), 'ro_median': ro.median(),
        'rr_mean': rr.mean(), 'rr_median': rr.median(),
        'diff_r_mean': diff_r.mean(), 'diff_r_median': diff_r.median(),
        'prop_larger': n_pos / n,
        'paired_t_r': t_r.statistic, 'paired_t_p': t_r.pvalue,
        'wilcoxon_r': w_r.statistic, 'wilcoxon_p': w_r.pvalue,
        'sign_test_p': binom_res.pvalue,
        'rel_es_mean': rel.mean(), 'rel_es_median': rel.median(),
        'test_rel_less_1_p': t_rel.pvalue
    }

print("Analysis executed successfully.")
