import pandas as pd

def analyze_ee_lab_proportion(filepath):
    df = pd.read_csv(filepath)
    ee_df = df[df['project'] == 'ee']
    total_ee = len(ee_df)
    
    # Original studies
    lab_o_count = (ee_df['online.o'] == 0).sum()
    prop_lab_o = lab_o_count / total_ee
    
    # Replication studies
    lab_r_count = (ee_df['online.r'] == 0).sum()
    prop_lab_r = lab_r_count / total_ee
    
    # Overall / combined
    same_online_count = (ee_df['same_online'] == 1).sum()
    
    print(f'Total EE studies: {total_ee}')
    print(f'Original studies conducted in lab (online.o == 0): {lab_o_count}/{total_ee} = {prop_lab_o:.4f} ({prop_lab_o * 100:.1f}%)')
    print(f'Replication studies conducted in lab (online.r == 0): {lab_r_count}/{total_ee} = {prop_lab_r:.4f} ({prop_lab_r * 100:.1f}%)')
    print(f'Same online setting: {same_online_count}/{total_ee} = {same_online_count / total_ee:.4f}')
    
    return {
        'total_ee': total_ee,
        'lab_o_count': lab_o_count,
        'prop_lab_o': prop_lab_o,
        'lab_r_count': lab_r_count,
        'prop_lab_r': prop_lab_r,
        'us_lab_o_count': int((ee_df['us_lab.o'] == 1).sum()),
        'non_us_lab_o_count': int((ee_df['us_lab.o'] == 0).sum()),
        'us_lab_r_count': int((ee_df['us_lab.r'] == 1).sum()),
        'non_us_lab_r_count': int((ee_df['us_lab.r'] == 0).sum())
    }

if __name__ == '__main__':
    results = analyze_ee_lab_proportion('data/meta-regression_study_data_heterogeneity_in_replication_projects.csv')
