import pandas as pd

def analyze_amber():
    # Load capital data
    df_capital = pd.read_csv('data/capital.csv')
    df_capital['Zamber_num'] = df_capital['Zamber'].str.replace(',', '.').astype(float)
    
    # Load time series data
    df_ts = pd.read_csv('data/time_series_data.csv')
    
    # Identify maximum values
    max_capital_amber = df_capital['Zamber_num'].max()
    peak_capital = df_capital[df_capital['Zamber_num'] == max_capital_amber]
    
    max_ts_amber = df_ts['Amber_inter'].max()
    peak_ts = df_ts[df_ts['Amber_inter'] == max_ts_amber]
    
    print(f"Max Z-score for Amber in capital.csv: {max_capital_amber}")
    print("Capital peak entries:")
    print(peak_capital[['BCE', 'group', 'Zamber_num']])
    
    print(f"\nMax Z-score for Amber in time_series_data.csv: {max_ts_amber}")
    print(f"Time range: {peak_ts['CE'].min()} to {peak_ts['CE'].max()} CE")
    print(f"BCE equivalent: {-peak_ts['CE'].max()} to {-peak_ts['CE'].min()} BCE")
    print(f"calBP range: {peak_ts['calBP'].min()} to {peak_ts['calBP'].max()} calBP")

if __name__ == '__main__':
    analyze_amber()
