import pandas as pd
import numpy as np
import json

def analyze_amber():
    # 1. Load capital.csv
    capital_df = pd.read_csv('data/capital.csv')
    numeric_cols = [c for c in capital_df.columns if c not in ['BCE', 'group', 'color']]
    for c in numeric_cols:
        capital_df[c] = capital_df[c].astype(str).str.replace(',', '.').astype(float)
    
    # 2. Load time_series_data.csv
    ts_df = pd.read_csv('data/time_series_data.csv')
    
    # Peak calculation in capital.csv
    max_zamber = capital_df['Zamber'].max()
    peak_capital = capital_df[capital_df['Zamber'] == max_zamber]
    
    # Peak calculation in time_series_data.csv
    max_amber = ts_df['Amber'].dropna().max()
    peak_ts_discrete = ts_df[ts_df['Amber'] == max_amber]
    
    max_amber_inter = ts_df['Amber_inter'].max()
    peak_ts_inter = ts_df[ts_df['Amber_inter'] == max_amber_inter]
    
    summary = {
        "max_z_score": float(max_zamber),
        "millennium_bce": "4th millennium BCE (fourth millennium BC)",
        "millennium_numeric": 4,
        "peak_interval_bce": [int(peak_capital['BCE'].max()), int(peak_capital['BCE'].min())], # [3300, 3000]
        "peak_interval_ce": [int(peak_ts_inter['CE'].min()), int(peak_ts_inter['CE'].max())], # [-3300, -3000]
        "peak_interval_calbp": [int(peak_ts_inter['calBP'].max()), int(peak_ts_inter['calBP'].min())], # [5250, 4950]
        "archaeological_culture": peak_capital['group'].unique().tolist(),
        "discrete_points_bce": [int(x) for x in peak_capital['BCE'].tolist()],
        "social_capital_context": {
            "period": "Middle Neolithic (MN)",
            "monument_count_peak_bce": int(capital_df.loc[capital_df['ZMonument'].idxmax(), 'BCE']),
            "copper_gold_at_peak": capital_df.loc[capital_df['Zamber'] == max_zamber, ['BCE', 'ZCU_AU']].to_dict(orient='records')
        }
    }
    
    with open('amber_analysis_results.json', 'w') as f:
        json.dump(summary, f, indent=2)
        
    print("Analysis successfully completed:")
    print(json.dumps(summary, indent=2))
    return summary

if __name__ == '__main__':
    analyze_amber()
