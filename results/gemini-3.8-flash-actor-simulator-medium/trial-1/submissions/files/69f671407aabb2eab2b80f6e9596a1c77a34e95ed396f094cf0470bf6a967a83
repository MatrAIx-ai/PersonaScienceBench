import pandas as pd

def run_analysis():
    df = pd.read_csv('data/nls_incarceration_processed.csv')
    bf = df[(df['race'] == 'black') & (df['sex'] == 'female')]
    
    m85 = bf['composite_wealth_1985'].median()
    m90 = bf['composite_wealth_1990'].median()
    m96 = bf['composite_wealth_1996'].median()
    
    delta_85_90 = m90 - m85
    delta_90_96 = m96 - m90
    
    annual_85_90 = delta_85_90 / 5.0
    annual_90_96 = delta_90_96 / 6.0
    
    results = {
        'total_count': len(bf),
        'median_1985': m85,
        'median_1990': m90,
        'median_1996': m96,
        'delta_1985_1990': delta_85_90,
        'delta_1990_1996': delta_90_96,
        'annual_1985_1990': annual_85_90,
        'annual_1990_1996': annual_90_96,
    }
    return results

if __name__ == '__main__':
    res = run_analysis()
    for k, v in res.items():
        print(f'{k}: {v}')
