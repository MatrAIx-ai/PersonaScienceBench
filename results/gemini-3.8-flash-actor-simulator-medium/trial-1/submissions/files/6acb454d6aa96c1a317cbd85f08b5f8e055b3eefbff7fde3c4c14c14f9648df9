import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf

def run_analysis():
    # Load dataset
    data_path = 'data/data.xlsx'
    raw_df = pd.read_excel(data_path)
    
    # Filter valid 80 patient records (Sequence number 1 to 80)
    df = raw_df.dropna(subset=['Sequence number']).copy()
    assert len(df) == 80, f"Expected 80 rows, found {len(df)}"
    
    # Binary response: 1 for PR (Partial Response), 0 for non-PR (SD/PD)
    df['response'] = (df['Efficacy'] == 'PR').astype(int)
    
    # Summary of response
    print(f"Sample size: {len(df)}")
    print(f"Response breakdown:\n{df['Efficacy'].value_counts()}\n")
    print(f"Binary response count (1=PR, 0=non-PR):\n{df['response'].value_counts()}\n")
    print(f"BMI summary:\n{df['BMI'].describe()}\n")
    
    # Fit logistic regression model using statsmodels Logit (MLE)
    logit_model = smf.logit('response ~ BMI', data=df).fit()
    
    # Also fit using GLM Binomial with Logit link for cross-validation
    glm_model = smf.glm('response ~ BMI', data=df, family=sm.families.Binomial()).fit()
    
    log_likelihood = logit_model.llf
    k = logit_model.df_model + 1  # 1 predictor + 1 intercept = 2
    aic = -2 * log_likelihood + 2 * k
    
    print("="*60)
    print("LOGISTIC REGRESSION RESULTS (Logit MLE)")
    print("="*60)
    print(logit_model.summary())
    print("\n" + "="*60)
    print("GLM BINOMIAL RESULTS")
    print("="*60)
    print(glm_model.summary())
    print("\n" + "="*60)
    print("DIAGNOSTICS AND METRICS")
    print("="*60)
    print(f"Number of observations (N): {logit_model.nobs}")
    print(f"Degrees of freedom (model): {logit_model.df_model}")
    print(f"Number of parameters (k): {k}")
    print(f"Log-Likelihood: {log_likelihood:.8f}")
    print(f"Null Log-Likelihood: {logit_model.llnull:.8f}")
    print(f"Pseudo R-squared (McFadden): {logit_model.prsquared:.6f}")
    print(f"Likelihood Ratio test p-value: {logit_model.llr_pvalue:.6f}")
    print(f"Statsmodels Logit AIC: {logit_model.aic:.10f}")
    print(f"Statsmodels GLM AIC:   {glm_model.aic:.10f}")
    print(f"Manually calculated AIC (-2*LL + 2*k): {aic:.10f}")
    
    print("\n" + "="*60)
    print("AIC FORMATTED REPORTING")
    print("="*60)
    print(f"Full precision: {aic}")
    print(f"Rounded to 4 decimal places: {aic:.4f}")
    print(f"Rounded to 3 decimal places: {aic:.3f}")
    print(f"Rounded to 2 decimal places: {aic:.2f}")
    print(f"Rounded to 1 decimal place:  {aic:.1f}")
    
    # Save output to text file as record
    with open('model_summary.txt', 'w') as f:
        f.write(str(logit_model.summary()))
        f.write(f"\nAIC: {aic}\n")

if __name__ == '__main__':
    run_analysis()
