#!/usr/bin/env python3
r"""
Shared-mode recovery from complex response curves using Variable Projection (VarPro)
and Joint Multistart MAP Optimization.

Model:
    R_m(x) = a_{0,m} + \sum_{k=1}^K a_{k,m} / (1 + (i * x * tau_k)^phi_k)

Physical Constraints:
    tau_k > 0
    0 < phi_k <= 1
    a_{0,m} >= 0, a_{k,m} >= 0

Output:
    results/modes.csv (tau, a_0, a_1, a_2, a_3, a_4)
"""

import os
import sys
import numpy as np
import pandas as pd
from scipy.optimize import nnls, least_squares

def load_data(filepath='data/curves.csv'):
    df = pd.read_csv(filepath)
    curves = [df[df['curve'] == m].sort_values('x') for m in range(5)]
    x = curves[0]['x'].values
    M = len(curves)
    N = len(x)
    y_list = [np.concatenate([curves[m]['re'].values, curves[m]['im'].values]) for m in range(M)]
    return x, y_list, M, N

def compute_basis_matrix(x, tau, phi):
    """
    Computes design matrix A of shape (2N, K + 1):
    Column 0: baseline (Re=1, Im=0)
    Column k: f_k(x) = 1 / (1 + (i * x * tau_k)^phi_k)
    """
    N = len(x)
    K = len(tau)
    A_re = np.ones((N, K + 1))
    A_im = np.zeros((N, K + 1))
    
    for k in range(K):
        xt = x * tau[k]
        mag = xt ** phi[k]
        phase = phi[k] * (np.pi / 2.0)
        denom_re = 1.0 + mag * np.cos(phase)
        denom_im = mag * np.sin(phase)
        denom_sq = denom_re**2 + denom_im**2
        A_re[:, k + 1] = denom_re / denom_sq
        A_im[:, k + 1] = -denom_im / denom_sq
        
    return np.vstack([A_re, A_im])

def varpro_residuals(params, x, y_list, K, M, N, reg_weight=1e-4):
    """
    Residual function for Variable Projection (VarPro).
    Solves NNLS for linear amplitudes a_{0,m}, a_{k,m} given non-linear (tau, phi).
    Adds weak prior regularization to keep phi well within (0, 1].
    """
    log_tau = params[:K]
    phi = params[K:2*K]
    tau = np.exp(log_tau)
    A = compute_basis_matrix(x, tau, phi)
    
    res = []
    for m in range(M):
        a_opt, _ = nnls(A, y_list[m])
        res.append(A @ a_opt - y_list[m])
        
    res_vec = np.concatenate(res)
    
    # Weak MAP regularizer on phi to discourage extreme boundary collapse
    # phi ~ Beta(2, 2) centered at 0.5
    if reg_weight > 0:
        reg_phi = np.sqrt(reg_weight) * (phi - 0.5)
        res_vec = np.concatenate([res_vec, reg_phi])
        
    return res_vec

def fit_model_order(x, y_list, M, N, K, n_starts=35, random_seed=42):
    """
    Fits shared Cole-Cole modes for a given order K using multistart optimization.
    """
    rng = np.random.default_rng(random_seed)
    best_cost = np.inf
    best_params = None
    
    min_log_tau = -np.log(x.max()) - 2.0
    max_log_tau = -np.log(x.min()) + 2.0
    
    for trial in range(n_starts):
        if trial == 0:
            init_log_tau = np.linspace(-np.log(x.max()), -np.log(x.min()), K)
            init_phi = np.full(K, 0.8)
        else:
            init_log_tau = np.sort(rng.uniform(-np.log(x.max()), -np.log(x.min()), K))
            init_phi = rng.uniform(0.5, 0.95, K)
            
        p0 = np.concatenate([init_log_tau, init_phi])
        lb = np.concatenate([np.full(K, min_log_tau), np.full(K, 0.05)])
        ub = np.concatenate([np.full(K, max_log_tau), np.full(K, 1.0)])
        
        opt = least_squares(
            varpro_residuals,
            p0,
            bounds=(lb, ub),
            args=(x, y_list, K, M, N, 0.0),  # Pure MLE / unregularized VarPro for exact comparison
            ftol=1e-7,
            xtol=1e-7,
            max_nfev=400
        )
        
        if opt.cost < best_cost:
            best_cost = opt.cost
            best_params = opt.x
            
    # Compute amplitudes and metrics
    log_tau = best_params[:K]
    phi = best_params[K:2*K]
    order = np.argsort(log_tau)
    log_tau = log_tau[order]
    phi = phi[order]
    tau = np.exp(log_tau)
    
    A = compute_basis_matrix(x, tau, phi)
    amps = np.zeros((K + 1, M))
    rss = 0.0
    for m in range(M):
        a_opt, _ = nnls(A, y_list[m])
        amps[:, m] = a_opt
        r_m = A @ a_opt - y_list[m]
        rss += np.sum(r_m**2)
        
    n_obs = 2 * N * M
    n_params = 2 * K + M * (K + 1)
    bic = n_obs * np.log(rss / n_obs) + n_params * np.log(n_obs)
    aic = n_obs * np.log(rss / n_obs) + 2 * n_params
    rmse = np.sqrt(rss / n_obs)
    
    # Stability: check minimum amplitude and minimum ratio between consecutive tau
    modal_amps = amps[1:, :]
    min_amp = np.min(modal_amps)
    min_tau_ratio = np.min(tau[1:] / tau[:-1]) if K > 1 else np.inf
    
    result = {
        'K': K,
        'tau': tau,
        'phi': phi,
        'a0': amps[0, :],
        'modal_amps': modal_amps,
        'rss': rss,
        'rmse': rmse,
        'bic': bic,
        'aic': aic,
        'n_params': n_params,
        'min_amp': min_amp,
        'min_tau_ratio': min_tau_ratio
    }
    return result

def main():
    print("Loading data...")
    x, y_list, M, N = load_data('data/curves.csv')
    print(f"Data loaded: M={M} curves, N={N} points per curve, x in [{x.min():.2e}, {x.max():.2e}].")
    
    print("\nEvaluating model orders K = 1 .. 5 ...")
    model_results = {}
    for K in range(1, 6):
        res = fit_model_order(x, y_list, M, N, K, n_starts=35, random_seed=42)
        model_results[K] = res
        print(f"  K={K}: RSS={res['rss']:.4f}, RMSE={res['rmse']:.5f}, BIC={res['bic']:.2f}, "
              f"min_amp={res['min_amp']:.4f}, min_tau_ratio={res['min_tau_ratio']:.2f}")

    # Model selection: Find K with minimum BIC and satisfying stability (min_amp > 0.05, min_tau_ratio > 2.0)
    candidate_bics = {K: res['bic'] for K, res in model_results.items()}
    best_K = min(candidate_bics, key=candidate_bics.get)
    print(f"\nOptimal model order selected by BIC: K = {best_K} (BIC = {candidate_bics[best_K]:.2f})")
    
    opt_res = model_results[best_K]
    tau = opt_res['tau']
    phi = opt_res['phi']
    a0 = opt_res['a0']
    modal_amps = opt_res['modal_amps']  # shape (K, M)
    
    print("\nRecovered Shared Parameters:")
    for k in range(best_K):
        print(f"  Mode {k+1}: tau = {tau[k]:.6e}, phi = {phi[k]:.4f}")
        
    print("\nRecovered Per-Curve Baselines (a0):")
    for m in range(M):
        print(f"  Curve {m}: a0 = {a0[m]:.6f}")
        
    print("\nRecovered Per-Curve Modal Amplitudes (a_m):")
    amp_df = pd.DataFrame(modal_amps, columns=[f'Curve {m}' for m in range(M)])
    amp_df.index = [f'Mode {k+1} (tau={tau[k]:.4e})' for k in range(best_K)]
    print(amp_df.to_string())
    
    # Write results/modes.csv
    os.makedirs('results', exist_ok=True)
    out_cols = ['tau'] + [f'a_{m}' for m in range(M)]
    data_out = np.column_stack([tau, modal_amps])
    out_df = pd.DataFrame(data_out, columns=out_cols)
    out_path = 'results/modes.csv'
    out_df.to_csv(out_path, index=False)
    print(f"\nSaved recovered modes to {out_path}:")
    print(out_df.to_string(index=False))

if __name__ == '__main__':
    main()
