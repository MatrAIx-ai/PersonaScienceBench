import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf
import json

df = pd.read_csv('data/nls_bmi_processed.csv')

# 1. Bivariate Descriptive Analysis by Age
age_stats = df.groupby('AGE')['DISSAVED'].agg(
    n='count',
    dissaved_count='sum',
    dissaved_rate='mean',
    std='std'
).reset_index()
age_stats['se'] = age_stats['std'] / np.sqrt(age_stats['n'])
age_stats['ci_lower'] = age_stats['dissaved_rate'] - 1.96 * age_stats['se']
age_stats['ci_upper'] = age_stats['dissaved_rate'] + 1.96 * age_stats['se']

# 2. Logistic Regression Models
# Model 1: Bivariate Linear Logit
m1 = smf.logit('DISSAVED ~ AGE', data=df).fit(disp=False)

# Model 2: Bivariate Quadratic Logit
m2 = smf.logit('DISSAVED ~ AGE + AGE_2', data=df).fit(disp=False)

# Model 3: Multivariable Linear Logit
m3 = smf.logit('DISSAVED ~ AGE + INCOME + C(GENDER) + BLACK + HISPANIC + BMI', data=df).fit(disp=False)

# Model 4: Multivariable Quadratic Logit
m4 = smf.logit('DISSAVED ~ AGE + AGE_2 + INCOME + C(GENDER) + BLACK + HISPANIC + BMI', data=df).fit(disp=False)

# 3. OLS (Linear Probability Models)
ols1 = smf.ols('DISSAVED ~ AGE', data=df).fit()
ols2 = smf.ols('DISSAVED ~ AGE + AGE_2', data=df).fit()
ols4 = smf.ols('DISSAVED ~ AGE + AGE_2 + INCOME + C(GENDER) + BLACK + HISPANIC + BMI', data=df).fit()

results = {
    "sample_size": len(df),
    "age_stats": age_stats.to_dict(orient='records'),
    "logit_linear": {
        "coef_age": float(m1.params['AGE']),
        "se_age": float(m1.bse['AGE']),
        "p_value_age": float(m1.pvalues['AGE']),
        "odds_ratio": float(np.exp(m1.params['AGE'])),
        "pseudo_r2": float(m1.prsquared)
    },
    "logit_quadratic": {
        "coef_age": float(m2.params['AGE']),
        "coef_age_2": float(m2.params['AGE_2']),
        "p_value_age": float(m2.pvalues['AGE']),
        "p_value_age_2": float(m2.pvalues['AGE_2']),
        "peak_age": float(-m2.params['AGE'] / (2 * m2.params['AGE_2'])),
        "pseudo_r2": float(m2.prsquared)
    },
    "logit_multivariable_linear": {
        "coef_age": float(m3.params['AGE']),
        "se_age": float(m3.bse['AGE']),
        "p_value_age": float(m3.pvalues['AGE']),
        "odds_ratio": float(np.exp(m3.params['AGE'])),
        "pseudo_r2": float(m3.prsquared)
    },
    "logit_multivariable_quadratic": {
        "coef_age": float(m4.params['AGE']),
        "coef_age_2": float(m4.params['AGE_2']),
        "p_value_age": float(m4.pvalues['AGE']),
        "p_value_age_2": float(m4.pvalues['AGE_2']),
        "peak_age": float(-m4.params['AGE'] / (2 * m4.params['AGE_2'])),
        "pseudo_r2": float(m4.prsquared)
    },
    "ols_linear": {
        "coef_age": float(ols1.params['AGE']),
        "se_age": float(ols1.bse['AGE']),
        "p_value_age": float(ols1.pvalues['AGE']),
        "r2": float(ols1.rsquared)
    }
}

with open('analysis_summary.json', 'w') as f:
    json.dump(results, f, indent=2)

print("Analysis executed successfully.")
