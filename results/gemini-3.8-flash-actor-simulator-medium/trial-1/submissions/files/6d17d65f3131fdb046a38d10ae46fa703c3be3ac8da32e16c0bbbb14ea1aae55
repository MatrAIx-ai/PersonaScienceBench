import pandas as pd
import numpy as np

def run_analysis():
    # Load dataset
    df = pd.read_csv('data/requirements_engineering_for_ML-enabled_systems.csv')

    # Documentation format columns
    doc_cols = [
        'Q10_ML_Documentation_BDD_Scenarios',
        'Q10_ML_Documentation_MLCanvas',
        'Q10_ML_Documentation_Vision_Document',
        'Q10_ML_Documentation_Goal_Models',
        'Q10_ML_Documentation_Not_Documented',
        'Q10_ML_Documentation_Data_Models',
        'Q10_ML_Documentation_Use_Case_Models',
        'Q10_ML_Documentation_Prototypes',
        'Q10_ML_Documentation_Requirements_Lists',
        'Q10_ML_Documentation_User_Stories',
        'Q10_ML_Documentation_Notebooks',
        'Q10_ML_Documentation_Others'
    ]

    # Filter out missing/negative responses (-77)
    valid_mask = ~df['Q10_ML_Documentation_Vision_Document'].astype(str).str.startswith('-')
    df_valid = df[valid_mask].copy()

    total_resp = len(df)
    valid_resp = len(df_valid)

    # Calculate frequencies
    records = []
    for col in doc_cols:
        name = col.replace('Q10_ML_Documentation_', '')
        cnt = (df_valid[col] == 'quoted').sum()
        pct_resp = (cnt / valid_resp) * 100
        records.append({
            'Format': name,
            'Quoted_Count': cnt,
            'Pct_Valid_Respondents': pct_resp
        })

    summary_df = pd.DataFrame(records).sort_values('Quoted_Count', ascending=True)

    # Bootstrapping (B = 10,000 iterations)
    np.random.seed(42)
    B = 10000
    n = valid_resp

    boot_results = {}
    for col in ['Q10_ML_Documentation_BDD_Scenarios', 'Q10_ML_Documentation_MLCanvas']:
        name = col.replace('Q10_ML_Documentation_', '')
        vals = (df_valid[col] == 'quoted').astype(float).values
        boot_means = np.empty(B)
        for b in range(B):
            idx = np.random.choice(n, size=n, replace=True)
            boot_means[b] = vals[idx].mean() * 100
        boot_results[name] = {
            'mean': float(boot_means.mean()),
            'ci_lower': float(np.percentile(boot_means, 2.5)),
            'ci_upper': float(np.percentile(boot_means, 97.5))
        }

    return {
        'total_respondents': total_resp,
        'valid_respondents': valid_resp,
        'summary': summary_df.to_dict(orient='records'),
        'bootstrap': boot_results
    }

if __name__ == '__main__':
    res = run_analysis()
    print("Valid respondents:", res['valid_respondents'])
    print("Summary:")
    for r in res['summary']:
        print(f"  {r['Format']}: {r['Quoted_Count']} ({r['Pct_Valid_Respondents']:.2f}%)")
    print("\nBootstrap results:")
    for k, v in res['bootstrap'].items():
        print(f"  {k}: mean={v['mean']:.3f}%, 95% CI=[{v['ci_lower']:.3f}, {v['ci_upper']:.3f}]")
