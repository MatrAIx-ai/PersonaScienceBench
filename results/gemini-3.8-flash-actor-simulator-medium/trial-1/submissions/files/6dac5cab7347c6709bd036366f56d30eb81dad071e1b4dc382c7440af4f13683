"""
Analysis script for bixbench:bix-51-q1.
Logistic regression model predicting efficacy PR from Age,
and calculating predicted probability for Age = 65.
"""

import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf

def main():
    # 1. Load data
    data_path = 'data/data.xlsx'
    df_raw = pd.read_excel(data_path)
    
    # Filter out empty/trailing rows (rows beyond the 80 valid patient records)
    df = df_raw.iloc[:80].copy()
    df['Age'] = pd.to_numeric(df['Age'])
    
    # 2. Define binary outcome (PR = 1, SD/PD = 0)
    df['PR'] = (df['Efficacy'] == 'PR').astype(int)
    
    print(f"Sample size: {len(df)}")
    print("Outcome distribution (PR vs Non-PR):")
    print(df['PR'].value_counts())
    print()
    
    # 3. Fit logistic regression
    model = smf.logit('PR ~ Age', data=df).fit()
    print("Logistic Regression Summary:")
    print(model.summary())
    print()
    
    # 4. Coefficients and Odds Ratios
    params = model.params
    conf = model.conf_int()
    conf['OR'] = np.exp(params)
    conf.columns = ['95% CI Lower', '95% CI Upper', 'Odds Ratio']
    print("Parameters and Odds Ratios:")
    print(conf)
    print()
    
    # 5. Predict probability for Age = 65
    pred_df = pd.DataFrame({'Age': [65]})
    pred_prob = model.predict(pred_df).iloc[0]
    
    # Linear predictor: eta = beta0 + beta1 * 65
    eta = params['Intercept'] + params['Age'] * 65
    manual_prob = 1.0 / (1.0 + np.exp(-eta))
    
    print(f"Linear predictor at Age=65: {eta:.6f}")
    print(f"Predicted probability at Age 65: {pred_prob:.6f} ({pred_prob*100:.2f}%)")

if __name__ == '__main__':
    main()
