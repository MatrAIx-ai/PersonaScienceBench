import os
import pandas as pd

excel_path = 'data/Supplemental Data File 1 PostvsPre_DEG_tables_ANNOTATED by_cell_type.xlsx'
assert os.path.exists(excel_path), f"File {excel_path} not found"

xls = pd.ExcelFile(excel_path)
results = []

for sheet_name in xls.sheet_names:
    df = pd.read_excel(excel_path, sheet_name=sheet_name)
    gene_col = df.columns[0]
    
    total_genes = len(df)
    sig_05 = df[df['p_val_adj'] < 0.05]
    sig_01 = df[df['p_val_adj'] < 0.01]
    sig_001 = df[df['p_val_adj'] < 0.001]
    
    n_sig_05 = len(sig_05)
    n_sig_01 = len(sig_01)
    n_sig_001 = len(sig_001)
    
    up_genes = len(sig_05[sig_05['avg_log2FC'] > 0])
    down_genes = len(sig_05[sig_05['avg_log2FC'] < 0])
    
    results.append({
        'Cell_Type': sheet_name,
        'Total_Reported': total_genes,
        'Significant_padj_0.05': n_sig_05,
        'Significant_padj_0.01': n_sig_01,
        'Significant_padj_0.001': n_sig_001,
        'Up_padj_0.05': up_genes,
        'Down_padj_0.05': down_genes
    })

res_df = pd.DataFrame(results)
res_df = res_df.sort_values(by='Significant_padj_0.05', ascending=False).reset_index(drop=True)

print("=== DEG Analysis Results (sorted by significant genes padj < 0.05) ===")
print(res_df.to_string(index=False))

top_cell = res_df.iloc[0]
print(f"\nTop cell type: {top_cell['Cell_Type']} with {top_cell['Significant_padj_0.05']} significant DEGs (padj < 0.05)")

# Save summary to csv
res_df.to_csv('deg_summary_by_cell_type.csv', index=False)
print("Saved summary table to deg_summary_by_cell_type.csv")
