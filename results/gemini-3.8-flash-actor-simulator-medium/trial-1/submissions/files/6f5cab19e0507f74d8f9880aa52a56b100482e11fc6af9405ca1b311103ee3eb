import pandas as pd
import numpy as np
from scipy.stats import chi2_contingency, fisher_exact

def run_analysis():
    # 1. Load data
    dm = pd.read_csv('data/TASK008_BCG-CORONA_DM.csv', encoding='latin1')
    ae = pd.read_csv('data/TASK008_BCG-CORONA_AE.csv', encoding='latin1')
    ex = pd.read_csv('data/TASK008_BCG-CORONA_EX.csv', encoding='latin1')

    print("=== DATA SUMMARY ===")
    print(f"DM records: {len(dm)} unique subjects: {dm['USUBJID'].nunique()}")
    print("DM patients_seen distribution:\n", dm['patients_seen'].value_counts())
    print("DM TRTGRP distribution:\n", dm['TRTGRP'].value_counts())
    print(f"AE records: {len(ae)}")

    # 2. Identify COVID-19 events
    covid_mask = ae['AEPT'].str.contains('COVID|Corona|SARS', case=False, na=False)
    covid_ae = ae[covid_mask].copy()
    print(f"COVID AE records: {len(covid_ae)}, unique subjects: {covid_ae['USUBJID'].nunique()}")
    print("COVID AEPT distribution:\n", covid_ae['AEPT'].value_counts())

    # Merge with DM
    m_events = pd.merge(covid_ae, dm[['USUBJID', 'patients_seen', 'TRTGRP']], on='USUBJID', suffixes=('_ae', '_dm'))
    
    # Subject-level max severity (worst-case per subject)
    subj_max = covid_ae.groupby('USUBJID').agg({
        'AESEV': 'max',
        'AEHS': 'max',
        'AESER': lambda s: 'Yes' if (s == 'Yes').any() else 'No'
    }).reset_index()
    m_subj = pd.merge(subj_max, dm, on='USUBJID')

    # Full cohort (uninfected = 0)
    m_full = pd.merge(dm, subj_max, on='USUBJID', how='left')
    m_full['AESEV_filled'] = m_full['AESEV'].fillna(0)
    m_full['AEHS_filled'] = m_full['AEHS'].fillna(0)

    groups = ['1-50', '51-100', '>100']

    results = []

    print("\n" + "="*80)
    print("1. EVENT LEVEL ANALYSIS (COVID-19 Infected Records)")
    print("="*80)
    for grp in groups:
        sub = m_events[m_events['patients_seen'] == grp]
        print(f"\n>>> PATIENT VOLUME GROUP: {grp} (Events N = {len(sub)}) <<<")

        # AESEV polychotomous
        s_sev = sub.dropna(subset=['AESEV'])
        ct = pd.crosstab(s_sev['TRTGRP_dm'], s_sev['AESEV'])
        c2, p, df, _ = chi2_contingency(ct)
        print(f"\n[AESEV raw categories] chi2 = {c2:.4f}, df = {df}, p = {p:.4f}")
        print(ct)

        # AESEV binary (>=3 vs <3)
        ct_bin = pd.crosstab(s_sev['TRTGRP_dm'], (s_sev['AESEV'] >= 3).astype(int))
        c2_u, p_u, df_b, _ = chi2_contingency(ct_bin, correction=False)
        c2_c, p_c, _, _ = chi2_contingency(ct_bin, correction=True)
        _, p_fish = fisher_exact(ct_bin)
        print(f"[AESEV binary >=3] chi2_uncorr = {c2_u:.4f}, p_uncorr = {p_u:.4f}, chi2_corr = {c2_c:.4f}, p_corr = {p_c:.4f}, Fisher p = {p_fish:.4f}")
        print(ct_bin)

        # AEHS polychotomous (WHO 8-point ordinal scale)
        ct_hs = pd.crosstab(sub['TRTGRP_dm'], sub['AEHS'])
        c2_hs, p_hs, df_hs, _ = chi2_contingency(ct_hs)
        print(f"\n[AEHS raw categories] chi2 = {c2_hs:.4f}, df = {df_hs}, p = {p_hs:.4f}")
        print(ct_hs)

        # AEHS binary (>=3 vs <3)
        ct_hs_bin = pd.crosstab(sub['TRTGRP_dm'], (sub['AEHS'] >= 3).astype(int))
        c2_hsb_u, p_hsb_u, df_hsb, _ = chi2_contingency(ct_hs_bin, correction=False)
        c2_hsb_c, p_hsb_c, _, _ = chi2_contingency(ct_hs_bin, correction=True)
        _, p_hs_fish = fisher_exact(ct_hs_bin)
        print(f"[AEHS binary >=3] chi2_uncorr = {c2_hsb_u:.4f}, p_uncorr = {p_hsb_u:.4f}, chi2_corr = {c2_hsb_c:.4f}, p_corr = {p_hsb_c:.4f}, Fisher p = {p_hs_fish:.4f}")
        print(ct_hs_bin)

    print("\n" + "="*80)
    print("2. PARTICIPANT LEVEL ANALYSIS (Worst-case max severity per subject)")
    print("="*80)
    for grp in groups:
        sub = m_subj[m_subj['patients_seen'] == grp]
        print(f"\n>>> PATIENT VOLUME GROUP: {grp} (Subjects N = {len(sub)}) <<<")

        # AESEV polychotomous
        s_sev = sub.dropna(subset=['AESEV'])
        ct = pd.crosstab(s_sev['TRTGRP'], s_sev['AESEV'])
        c2, p, df, _ = chi2_contingency(ct)
        print(f"\n[AESEV raw categories] chi2 = {c2:.4f}, df = {df}, p = {p:.4f}")
        print(ct)

        # AESEV binary (>=3 vs <3)
        ct_bin = pd.crosstab(s_sev['TRTGRP'], (s_sev['AESEV'] >= 3).astype(int))
        c2_u, p_u, df_b, _ = chi2_contingency(ct_bin, correction=False)
        _, p_fish = fisher_exact(ct_bin)
        print(f"[AESEV binary >=3] chi2_uncorr = {c2_u:.4f}, p_uncorr = {p_u:.4f}, Fisher p = {p_fish:.4f}")
        print(ct_bin)

        # AEHS polychotomous
        ct_hs = pd.crosstab(sub['TRTGRP'], sub['AEHS'])
        c2_hs, p_hs, df_hs, _ = chi2_contingency(ct_hs)
        print(f"\n[AEHS raw categories] chi2 = {c2_hs:.4f}, df = {df_hs}, p = {p_hs:.4f}")
        print(ct_hs)

        # AEHS binary (>=3 vs <3)
        ct_hs_bin = pd.crosstab(sub['TRTGRP'], (sub['AEHS'] >= 3).astype(int))
        c2_hsb_u, p_hsb_u, df_hsb, _ = chi2_contingency(ct_hs_bin, correction=False)
        _, p_hs_fish = fisher_exact(ct_hs_bin)
        print(f"[AEHS binary >=3] chi2_uncorr = {c2_hsb_u:.4f}, p_uncorr = {p_hsb_u:.4f}, Fisher p = {p_hs_fish:.4f}")
        print(ct_hs_bin)

    print("\n" + "="*80)
    print("3. FULL COHORT LEVEL ANALYSIS (Uninfected = 0)")
    print("="*80)
    for grp in groups:
        sub = m_full[m_full['patients_seen'] == grp]
        print(f"\n>>> PATIENT VOLUME GROUP: {grp} (Total Subjects N = {len(sub)}) <<<")

        # AESEV full
        ct = pd.crosstab(sub['TRTGRP'], sub['AESEV_filled'])
        c2, p, df, _ = chi2_contingency(ct)
        print(f"\n[AESEV full cohort] chi2 = {c2:.4f}, df = {df}, p = {p:.4f}")
        print(ct)

        # AEHS full
        ct_hs = pd.crosstab(sub['TRTGRP'], sub['AEHS_filled'])
        c2_hs, p_hs, df_hs, _ = chi2_contingency(ct_hs)
        print(f"\n[AEHS full cohort] chi2 = {c2_hs:.4f}, df = {df_hs}, p = {p_hs:.4f}")
        print(ct_hs)

if __name__ == '__main__':
    run_analysis()
