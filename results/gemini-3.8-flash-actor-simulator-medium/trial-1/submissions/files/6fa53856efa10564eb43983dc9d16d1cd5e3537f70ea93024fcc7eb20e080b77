"""
Econometric Analysis of Age and Dissaving Behavior (NLSY79 Sample)
Question: How does age influence the likelihood of withdrawing more money from savings than putting in?
"""

import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf
from scipy import stats

def main():
    # Load data
    df = pd.read_csv('data/nls_bmi_processed.csv')
    print("Dataset successfully loaded. Total observations:", len(df))

    # 1. Descriptive statistics by age
    age_table = df.groupby('AGE')['DISSAVED'].agg(
        total_obs='count',
        dissaved_cases='sum',
        dissaved_rate='mean'
    ).reset_index()
    age_table['dissaved_rate_pct'] = age_table['dissaved_rate'] * 100
    print("\n--- Table 1: Dissaving Rate by Age ---")
    print(age_table.to_string(index=False))

    # 2. Variable transformations & outlier indicators
    df['INCOME_IMPUTED'] = (np.isclose(df['INCOME'], 47.279064, atol=1e-4)).astype(int)
    df['BMI_IMPUTED'] = (np.isclose(df['BMI'], 25.158946, atol=1e-4)).astype(int)
    df['LOG_INCOME'] = np.log(df['INCOME'] + 1)
    df['BMI_WINSOR'] = df['BMI'].clip(df['BMI'].quantile(0.01), df['BMI'].quantile(0.99))

    # Model 1: Baseline Linear Age Logit
    m1 = smf.logit('DISSAVED ~ AGE', data=df).fit(disp=False)
    ame1 = m1.get_margeff(at='overall')
    ame1_df = ame1.summary_frame()
    print("\n--- Model 1: Baseline Bivariate Linear Model ---")
    print(f"AGE Coef: {m1.params['AGE']:.4f}, SE: {m1.bse['AGE']:.4f}, p-val: {m1.pvalues['AGE']:.4e}")
    print(f"AGE Odds Ratio: {np.exp(m1.params['AGE']):.4f} (95% CI: [{np.exp(m1.conf_int().loc['AGE', 0]):.4f}, {np.exp(m1.conf_int().loc['AGE', 1]):.4f}])")
    print(f"AGE Marginal Effect (AME): {ame1_df.loc['AGE', 'dy/dx']:.4f} (p-val: {ame1_df.loc['AGE', 'Pr(>|z|)']:.4e})")

    # Model 2: Quadratic Age Logit (AGE + AGE_2)
    m2 = smf.logit('DISSAVED ~ AGE + AGE_2', data=df).fit(disp=False)
    v2 = -m2.params['AGE'] / (2 * m2.params['AGE_2'])
    print("\n--- Model 2: Quadratic Age Model ---")
    print(f"AGE Coef: {m2.params['AGE']:.4f} (p={m2.pvalues['AGE']:.4f}), AGE_2 Coef: {m2.params['AGE_2']:.4f} (p={m2.pvalues['AGE_2']:.4f})")
    print(f"Estimated Peak / Vertex Age: {v2:.2f} years")

    # Model 3: Multivariable Controlled Linear Model
    m3 = smf.logit('DISSAVED ~ AGE + GENDER + INCOME + BLACK + HISPANIC + BMI', data=df).fit(disp=False)
    ame3 = m3.get_margeff(at='overall')
    ame3_df = ame3.summary_frame()
    print("\n--- Model 3: Multivariable Linear Model ---")
    print(f"AGE Coef: {m3.params['AGE']:.4f}, SE: {m3.bse['AGE']:.4f}, p-val: {m3.pvalues['AGE']:.4e}")
    print(f"AGE Odds Ratio: {np.exp(m3.params['AGE']):.4f} (95% CI: [{np.exp(m3.conf_int().loc['AGE', 0]):.4f}, {np.exp(m3.conf_int().loc['AGE', 1]):.4f}])")
    print(f"AGE Marginal Effect (AME): {ame3_df.loc['AGE', 'dy/dx']:.4f} (p-val: {ame3_df.loc['AGE', 'Pr(>|z|)']:.4e})")

    # Model 4: Multivariable Controlled Quadratic Model
    m4 = smf.logit('DISSAVED ~ AGE + AGE_2 + GENDER + INCOME + BLACK + HISPANIC + BMI', data=df).fit(disp=False)
    v4 = -m4.params['AGE'] / (2 * m4.params['AGE_2'])
    print("\n--- Model 4: Multivariable Quadratic Model ---")
    print(f"AGE Coef: {m4.params['AGE']:.4f} (p={m4.pvalues['AGE']:.4f}), AGE_2 Coef: {m4.params['AGE_2']:.4f} (p={m4.pvalues['AGE_2']:.4f})")
    print(f"Estimated Controlled Peak / Vertex Age: {v4:.2f} years")

    # Model fit comparisons
    lr_stat = 2 * (m4.llf - m3.llf)
    p_lr = stats.chi2.sf(lr_stat, 1)
    print(f"\nLikelihood Ratio Test (M3 vs M4): Chi2 = {lr_stat:.3f}, p = {p_lr:.4f}")

    # Robustness checks
    m_rob_winsor = smf.logit('DISSAVED ~ AGE + AGE_2 + GENDER + LOG_INCOME + BLACK + HISPANIC + BMI_WINSOR', data=df).fit(disp=False)
    print("\n--- Robustness Check: Winsorized Outliers & Log Income ---")
    print(f"AGE Coef: {m_rob_winsor.params['AGE']:.4f} (p={m_rob_winsor.pvalues['AGE']:.4f}), AGE_2 Coef: {m_rob_winsor.params['AGE_2']:.4f} (p={m_rob_winsor.pvalues['AGE_2']:.4f})")

    # Save summary tables to file
    summary_df = pd.DataFrame({
        'Model': ['Model 1 (Linear Unadjusted)', 'Model 2 (Quadratic Unadjusted)', 'Model 3 (Linear Adjusted)', 'Model 4 (Quadratic Adjusted)'],
        'AGE_coef': [m1.params['AGE'], m2.params['AGE'], m3.params['AGE'], m4.params['AGE']],
        'AGE_pval': [m1.pvalues['AGE'], m2.pvalues['AGE'], m3.pvalues['AGE'], m4.pvalues['AGE']],
        'AGE_2_coef': [np.nan, m2.params['AGE_2'], np.nan, m4.params['AGE_2']],
        'AGE_2_pval': [np.nan, m2.pvalues['AGE_2'], np.nan, m4.pvalues['AGE_2']],
        'AIC': [m1.aic, m2.aic, m3.aic, m4.aic],
        'BIC': [m1.bic, m2.bic, m3.bic, m4.bic]
    })
    summary_df.to_csv('regression_summary.csv', index=False)
    print("\nSummary table written to regression_summary.csv")

if __name__ == '__main__':
    main()
