import pandas as pd
import numpy as np
from scipy import stats

def run_analysis():
    df = pd.read_csv('data/meta-regression_study_data_heterogeneity_in_replication_projects.csv')
    
    # 1. Primary Benchmark: Unique Title
    d_title = df.drop_duplicates(subset=['title'])
    ee_title = d_title[d_title['discipline'] == 'Economics']['length']
    psy_title = d_title[d_title['discipline'] != 'Economics']['length']
    rpp_title = d_title[d_title['project'] == 'rpp']['length']
    cog_title = d_title[d_title['discipline'] == 'Cognitive']['length']
    soc_title = d_title[d_title['discipline'] == 'Social']['length']
    
    t_stat, p_val_t = stats.ttest_ind(ee_title, psy_title, equal_var=False)
    u_stat, p_val_u = stats.mannwhitneyu(ee_title, psy_title, alternative='two-sided')
    n1, n2 = len(ee_title), len(psy_title)
    s1, s2 = ee_title.std(ddof=1), psy_title.std(ddof=1)
    s_pooled = np.sqrt(((n1 - 1)*s1**2 + (n2 - 1)*s2**2) / (n1 + n2 - 2))
    cohen_d = (ee_title.mean() - psy_title.mean()) / s_pooled
    
    print("=== Paper-level (Title deduplicated) ===")
    print(f"EE: N={len(ee_title)}, Mean={ee_title.mean():.2f}, SD={ee_title.std():.2f}, Median={ee_title.median():.1f}, IQR=[{ee_title.quantile(0.25):.1f}, {ee_title.quantile(0.75):.1f}], Range=[{ee_title.min()}, {ee_title.max()}]")
    print(f"Psych (All): N={len(psy_title)}, Mean={psy_title.mean():.2f}, SD={psy_title.std():.2f}, Median={psy_title.median():.1f}, IQR=[{psy_title.quantile(0.25):.1f}, {psy_title.quantile(0.75):.1f}], Range=[{psy_title.min()}, {psy_title.max()}]")
    print(f"Psych (RPP): N={len(rpp_title)}, Mean={rpp_title.mean():.2f}, SD={rpp_title.std():.2f}, Median={rpp_title.median():.1f}")
    print(f"Welch t={t_stat:.4f}, p={p_val_t:.4e}; Mann-Whitney U={u_stat}, p={p_val_u:.4e}; Cohen's d={cohen_d:.2f}")

if __name__ == '__main__':
    run_analysis()
