import pandas as pd
import numpy as np
import statsmodels.formula.api as smf

def main():
    # Load dataset
    df = pd.read_csv('data/nls_bmi_processed.csv')
    df['MALE'] = (df['GENDER'] == 'MALE').astype(int)
    
    print('Dataset shape:', df.shape)
    print('\nEmpirical dissaving rates by age:')
    empirical = df.groupby('AGE')['DISSAVED'].agg(count='count', dissaved_count='sum', dissaved_mean='mean')
    print(empirical)
    
    # Model 1: Bivariate linear logit
    m1 = smf.logit('DISSAVED ~ AGE', data=df).fit()
    print('\n--- Model 1: Bivariate Linear Logit ---')
    print(m1.summary())
    print('Odds Ratio (AGE):', np.exp(m1.params['AGE']))
    print('95% CI (OR):', np.exp(m1.conf_int().loc['AGE']))
    print('Marginal Effect (AGE):')
    print(m1.get_margeff().summary())
    
    # Model 2: Multivariable linear logit
    m2 = smf.logit('DISSAVED ~ AGE + INCOME + BMI + MALE + BLACK + HISPANIC', data=df).fit()
    print('\n--- Model 2: Multivariable Linear Logit ---')
    print(m2.summary())
    print('Odds Ratio (AGE):', np.exp(m2.params['AGE']))
    print('95% CI (OR):', np.exp(m2.conf_int().loc['AGE']))
    print('Marginal Effect:')
    print(m2.get_margeff().summary())
    
    # Model 3: Multivariable quadratic logit
    m3 = smf.logit('DISSAVED ~ AGE + AGE_2 + INCOME + BMI + MALE + BLACK + HISPANIC', data=df).fit()
    print('\n--- Model 3: Multivariable Quadratic Logit ---')
    print(m3.summary())
    
    # Predicted probabilities across age cohorts
    eval_df = pd.DataFrame({
        'AGE': range(24, 33),
        'AGE_2': [a**2 for a in range(24, 33)],
        'INCOME': df['INCOME'].mean(),
        'BMI': df['BMI'].mean(),
        'MALE': df['MALE'].mean(),
        'BLACK': df['BLACK'].mean(),
        'HISPANIC': df['HISPANIC'].mean()
    })
    eval_df['pred_prob_linear'] = m2.predict(eval_df)
    eval_df['pred_prob_quad'] = m3.predict(eval_df)
    eval_df['empirical_rate'] = empirical['dissaved_mean'].values
    print('\nPredicted vs Empirical Rates:')
    print(eval_df[['AGE', 'empirical_rate', 'pred_prob_linear', 'pred_prob_quad']].to_string(index=False))

if __name__ == '__main__':
    main()
