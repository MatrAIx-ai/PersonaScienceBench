import pandas as pd
import numpy as np
from scipy import stats

def run_analysis():
    df = pd.read_csv('data/nls_incarceration_processed.csv')
    jailed = df[df['ever_jailed'] == 1].copy()

    # Race statistics
    race_stats = jailed.groupby('race')['composite_wealth_1985'].agg(
        count='count',
        mean='mean',
        std='std',
        q25=lambda x: x.quantile(0.25),
        median='median',
        q75=lambda x: x.quantile(0.75)
    )
    race_stats['iqr'] = race_stats['q75'] - race_stats['q25']

    # Sex statistics
    sex_stats = jailed.groupby('sex')['composite_wealth_1985'].agg(
        count='count',
        mean='mean',
        std='std',
        q25=lambda x: x.quantile(0.25),
        median='median',
        q75=lambda x: x.quantile(0.75)
    )
    sex_stats['iqr'] = sex_stats['q75'] - sex_stats['q25']

    # Cross-tabulation race x sex
    cross_stats = jailed.groupby(['race', 'sex'])['composite_wealth_1985'].agg(
        count='count',
        mean='mean',
        q25=lambda x: x.quantile(0.25),
        median='median',
        q75=lambda x: x.quantile(0.75)
    )
    cross_stats['iqr'] = cross_stats['q75'] - cross_stats['q25']

    # Hypothesis tests
    w_black = jailed[jailed['race'] == 'black']['composite_wealth_1985']
    w_white = jailed[jailed['race'] == 'white']['composite_wealth_1985']
    w_hisp = jailed[jailed['race'] == 'hipanic']['composite_wealth_1985']
    kw_race = stats.kruskal(w_black, w_white, w_hisp)

    mw_wb = stats.mannwhitneyu(w_white, w_black, alternative='two-sided')
    mw_wh = stats.mannwhitneyu(w_white, w_hisp, alternative='two-sided')
    mw_bh = stats.mannwhitneyu(w_black, w_hisp, alternative='two-sided')

    w_male = jailed[jailed['sex'] == 'male']['composite_wealth_1985']
    w_female = jailed[jailed['sex'] == 'female']['composite_wealth_1985']
    mw_sex = stats.mannwhitneyu(w_male, w_female, alternative='two-sided')

    print("=== RACE STATS ===")
    print(race_stats)
    print("\n=== SEX STATS ===")
    print(sex_stats)
    print("\n=== RACE x SEX STATS ===")
    print(cross_stats)
    print("\n=== TESTS ===")
    print(f"Kruskal-Wallis (Race): H={kw_race.statistic:.4f}, p={kw_race.pvalue:.4e}")
    print(f"Mann-Whitney (White vs Black): U={mw_wb.statistic:.1f}, p={mw_wb.pvalue:.4e}")
    print(f"Mann-Whitney (White vs Hispanic): U={mw_wh.statistic:.1f}, p={mw_wh.pvalue:.4e}")
    print(f"Mann-Whitney (Black vs Hispanic): U={mw_bh.statistic:.1f}, p={mw_bh.pvalue:.4e}")
    print(f"Mann-Whitney (Male vs Female): U={mw_sex.statistic:.1f}, p={mw_sex.pvalue:.4e}")

if __name__ == '__main__':
    run_analysis()
