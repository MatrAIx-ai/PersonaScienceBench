import numpy as np
import pandas as pd
from scipy import stats
import json

def analyze_skewness():
    data_path = 'data/OmicsExpressionProteinCodingGenesTPMLogp1BatchCorrected.csv'
    print(f'Loading data from {data_path}...')
    df = pd.read_csv(data_path, index_col=0)
    
    n_samples, n_genes = df.shape
    print(f'Dimensions: {n_samples} cell lines, {n_genes} genes')
    
    # 1. Global / Pooled distribution analysis
    vals = df.values.flatten()
    pooled_mean = float(np.mean(vals))
    pooled_median = float(np.median(vals))
    pooled_std = float(np.std(vals))
    pooled_min = float(np.min(vals))
    pooled_max = float(np.max(vals))
    pooled_skew = float(stats.skew(vals))
    pooled_kurtosis = float(stats.kurtosis(vals)) # Fisher kurtosis (normal = 0)
    
    percentiles = [1, 5, 10, 25, 50, 75, 90, 95, 99]
    pooled_quantiles = {f'p{p}': float(np.percentile(vals, p)) for p in percentiles}
    
    print('--- Global Pooled Statistics ---')
    print(f'Mean: {pooled_mean:.4f}')
    print(f'Median: {pooled_median:.4f}')
    print(f'Skewness: {pooled_skew:.4f}')
    print(f'Kurtosis: {pooled_kurtosis:.4f}')
    
    # 2. Per-gene distribution across cell lines (axis=0)
    gene_skew = df.apply(stats.skew, axis=0)
    gene_mean_skew = float(gene_skew.mean())
    gene_median_skew = float(gene_skew.median())
    gene_std_skew = float(gene_skew.std())
    gene_min_skew = float(gene_skew.min())
    gene_max_skew = float(gene_skew.max())
    pct_pos_skew = float((gene_skew > 0).mean() * 100)
    pct_gt_1_skew = float((gene_skew > 1).mean() * 100)
    
    print('--- Per-Gene (across cell lines) Statistics ---')
    print(f'Mean skewness: {gene_mean_skew:.4f}')
    print(f'Median skewness: {gene_median_skew:.4f}')
    print(f'Percent positive skewness: {pct_pos_skew:.2f}%')
    print(f'Percent skewness > 1: {pct_gt_1_skew:.2f}%')
    
    # 3. Per-cell-line distribution across genes (axis=1)
    cell_skew = df.apply(stats.skew, axis=1)
    cell_mean_skew = float(cell_skew.mean())
    cell_median_skew = float(cell_skew.median())
    cell_min_skew = float(cell_skew.min())
    cell_max_skew = float(cell_skew.max())
    cell_pct_pos = float((cell_skew > 0).mean() * 100)
    
    print('--- Per-Cell-Line (across genes) Statistics ---')
    print(f'Mean skewness: {cell_mean_skew:.4f}')
    print(f'Median skewness: {cell_median_skew:.4f}')
    print(f'Percent positive skewness: {cell_pct_pos:.2f}%')
    
    results = {
        'n_cell_lines': n_samples,
        'n_genes': n_genes,
        'total_observations': len(vals),
        'pooled': {
            'mean': pooled_mean,
            'median': pooled_median,
            'std': pooled_std,
            'min': pooled_min,
            'max': pooled_max,
            'skewness': pooled_skew,
            'excess_kurtosis': pooled_kurtosis,
            'quantiles': pooled_quantiles
        },
        'per_gene_across_cell_lines': {
            'mean_skewness': gene_mean_skew,
            'median_skewness': gene_median_skew,
            'std_skewness': gene_std_skew,
            'min_skewness': gene_min_skew,
            'max_skewness': gene_max_skew,
            'pct_positive_skew': pct_pos_skew,
            'pct_skew_gt_1': pct_gt_1_skew
        },
        'per_cell_line_across_genes': {
            'mean_skewness': cell_mean_skew,
            'median_skewness': cell_median_skew,
            'min_skewness': cell_min_skew,
            'max_skewness': cell_max_skew,
            'pct_positive_skew': cell_pct_pos
        }
    }
    
    with open('skewness_results.json', 'w') as f:
        json.dump(results, f, indent=2)
    print('Results saved to skewness_results.json')

if __name__ == '__main__':
    analyze_skewness()
