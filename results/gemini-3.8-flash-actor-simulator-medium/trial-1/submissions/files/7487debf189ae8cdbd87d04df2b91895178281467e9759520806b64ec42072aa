import pandas as pd
import numpy as np

def run_analysis():
    # Load datasets
    df_cap = pd.read_csv('data/capital.csv')
    df_ts = pd.read_csv('data/time_series_data.csv')
    
    # Process capital.csv numeric columns
    for col in ['ZKeform', 'Zkeverz']:
        df_cap[col] = df_cap[col].astype(str).str.replace(',', '.').astype(float)
        
    df_sorted = df_cap.sort_values('BCE', ascending=False).reset_index(drop=True)
    df_sorted['CE'] = -df_sorted['BCE']
    df_sorted['delta_form'] = df_sorted['ZKeform'].diff()
    df_sorted['delta_decor'] = df_sorted['Zkeverz'].diff()
    
    # Identify simultaneous divergence
    divergent_mask = (df_sorted['delta_form'] < 0) & (df_sorted['delta_decor'] > 0)
    divergent_bins = df_sorted[divergent_mask]
    
    print('=== Divergence Event Detection ===')
    print(divergent_bins[['BCE', 'CE', 'group', 'ZKeform', 'delta_form', 'Zkeverz', 'delta_decor']])
    
    # Output detailed summary around the event
    event_window = df_sorted[(df_sorted['BCE'] <= 2000) & (df_sorted['BCE'] >= 1500)]
    print('\n=== Chronological Window (2000 BCE to 1500 BCE) ===')
    print(event_window[['BCE', 'CE', 'group', 'ZKeform', 'delta_form', 'Zkeverz', 'delta_decor']])

if __name__ == '__main__':
    run_analysis()
