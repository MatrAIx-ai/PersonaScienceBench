import pandas as pd
import numpy as np

def run_analysis():
    df = pd.read_csv('data/requirements_engineering_for_ML-enabled_systems.csv')

    q8_cols = {
        'Project Lead': 'Q8_ML_Addressing_Project_Lead',
        'Data Scientist': 'Q8_ML_Addressing_Data_Scientist',
        'Business Analyst': 'Q8_ML_Addressing_Business_Analyst',
        'Developer': 'Q8_ML_Addressing_Developer',
        'Solution Architect': 'Q8_ML_Addressing_Solution_Architect',
        'Requirement Engineer': 'Q8_ML_Addressing_Requirement_Engineer',
        'Others': 'Q8_ML_Addressing_Others',
        'Tester': 'Q8_ML_Addressing_Tester'
    }

    # Filter out records where respondents did not answer Q8 (coded as negative values, e.g. -77)
    valid_mask = ~df['Q8_ML_Addressing_Project_Lead'].astype(str).str.startswith('-')
    sub_df = df[valid_mask].copy()
    n_valid = len(sub_df)

    # Binary indicators
    binary_df = pd.DataFrame()
    for role, col in q8_cols.items():
        binary_df[role] = (sub_df[col] == 'quoted').astype(int)

    # Point estimates
    point_est = {}
    for role in q8_cols:
        k = int(binary_df[role].sum())
        p = float(binary_df[role].mean() * 100)
        point_est[role] = {'count': k, 'n': n_valid, 'proportion': p}

    # Nonparametric bootstrap
    np.random.seed(42)
    B = 10000
    boot_means = {role: np.zeros(B) for role in q8_cols}

    for b in range(B):
        sample_idx = np.random.choice(n_valid, size=n_valid, replace=True)
        sample = binary_df.iloc[sample_idx]
        for role in q8_cols:
            boot_means[role][b] = sample[role].mean() * 100

    bootstrap_summary = {}
    for role in q8_cols:
        bm = boot_means[role]
        bootstrap_summary[role] = {
            'mean': float(np.mean(bm)),
            'std_err': float(np.std(bm)),
            'ci_95_lower': float(np.percentile(bm, 2.5)),
            'ci_95_upper': float(np.percentile(bm, 97.5))
        }

    # Paired differences
    diff_lead_ds = boot_means['Project Lead'] - boot_means['Data Scientist']
    diff_ds_ba = boot_means['Data Scientist'] - boot_means['Business Analyst']
    diff_lead_ba = boot_means['Project Lead'] - boot_means['Business Analyst']

    contrast_summary = {
        'Lead_vs_DS': {
            'mean_diff': float(np.mean(diff_lead_ds)),
            'ci_lower': float(np.percentile(diff_lead_ds, 2.5)),
            'ci_upper': float(np.percentile(diff_lead_ds, 97.5)),
            'p_superior': float((diff_lead_ds > 0).mean())
        },
        'DS_vs_BA': {
            'mean_diff': float(np.mean(diff_ds_ba)),
            'ci_lower': float(np.percentile(diff_ds_ba, 2.5)),
            'ci_upper': float(np.percentile(diff_ds_ba, 97.5)),
            'p_superior': float((diff_ds_ba > 0).mean())
        },
        'Lead_vs_BA': {
            'mean_diff': float(np.mean(diff_lead_ba)),
            'ci_lower': float(np.percentile(diff_lead_ba, 2.5)),
            'ci_upper': float(np.percentile(diff_lead_ba, 97.5)),
            'p_superior': float((diff_lead_ba > 0).mean())
        }
    }

    return point_est, bootstrap_summary, contrast_summary

if __name__ == '__main__':
    pe, bs, cs = run_analysis()
    print('Point estimates:', pe)
    print('Bootstrap summary:', bs)
    print('Contrast summary:', cs)
