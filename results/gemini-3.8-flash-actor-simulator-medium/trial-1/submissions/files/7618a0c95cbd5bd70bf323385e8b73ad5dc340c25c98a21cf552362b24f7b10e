import pandas as pd
from scipy.stats import pearsonr

def main():
    # 1. Load sample annotations and identify CD14 samples
    samples_df = pd.read_csv('data/Sample_annotated_Zenodo.csv')
    cd14_samples = samples_df[samples_df['celltype'] == 'CD14']['sample'].tolist()
    print(f"Total CD14 samples identified: {len(cd14_samples)}")

    # 2. Load gene metadata and filter for protein-coding genes
    gene_meta = pd.read_csv('data/GeneMetaInfo_Zenodo.csv').set_index('Geneid')
    pc_genes = gene_meta[gene_meta['gene_biotype'] == 'protein_coding']
    print(f"Total protein-coding genes: {len(pc_genes)}")

    # 3. Load batch corrected read counts
    # Read only the CD14 columns and the gene index column
    use_cols = ['Unnamed: 0'] + cd14_samples
    counts_df = pd.read_csv('data/BatchCorrectedReadCounts_Zenodo.csv', usecols=use_cols, index_col=0)
    
    # Align counts to protein-coding genes
    pc_counts = counts_df.loc[pc_genes.index]
    
    # 4. Calculate mean expression across CD14 samples
    mean_expression = pc_counts.mean(axis=1)
    gene_length = pc_genes['Length']

    # 5. Compute Pearson correlation coefficient
    corr, pval = pearsonr(gene_length, mean_expression)
    print(f"Pearson correlation coefficient: {corr:.6f}")
    print(f"P-value: {pval:.6e}")
    print(f"Detailed Pearson r: {corr}")

    # Optional: sensitivity check on non-zero expressing genes
    nonzero_mask = mean_expression > 0
    corr_nz, pval_nz = pearsonr(gene_length[nonzero_mask], mean_expression[nonzero_mask])
    print(f"Non-zero expressed genes (N={nonzero_mask.sum()}): Pearson r = {corr_nz:.6f}, p = {pval_nz:.6e}")

if __name__ == '__main__':
    main()
