import os
import pandas as pd
import numpy as np
import statsmodels.api as sm

# 1. Load data
df = pd.read_csv('data/invaded_niche_pathways.csv', sep='	')
df_succ = pd.read_csv('data/invasion_success_pathways.csv')
df_temp = pd.read_csv('data/temporal_trends_contingency_table.csv', sep='	')

print(f'Invaded niche pathways dataset: {df.shape[0]} plots, {df.shape[1]} variables.')

# 2. GLM Poisson Analysis
targets = ['n.unint', 'n.gard', 'n.agfo']
scales = ['50m', '500m', '1000m']
years = ['1956', '1993', '2009']

records = []
for target in targets:
    for scale in scales:
        for yr in years:
            col = f'urban.{yr}.{scale}'
            m = sm.GLM(df[target], sm.add_constant(df[col]), family=sm.families.Poisson()).fit()
            records.append({
                'pathway': target,
                'scale': scale,
                'year': yr,
                'coef': m.params[col],
                'std_err': m.bse[col],
                'z': m.tvalues[col],
                'p_value': m.pvalues[col]
            })

results_df = pd.DataFrame(records)
results_df.to_csv('artifacts/glm_poisson_results.csv', index=False)
print('Saved artifacts/glm_poisson_results.csv')

# 3. Multivariable model with environmental controls (2009 at 500m buffer)
covars = ['elevation', 'distance.stream', 'distance.road', 'annual.temperature', 'annual.rainfall', 'annual.radiation']
multivar_records = []
for target in targets:
    X = sm.add_constant(df[['urban.2009.500m', 'cropland.2009.500m'] + covars])
    m = sm.GLM(df[target], X, family=sm.families.Poisson()).fit()
    multivar_records.append({
        'pathway': target,
        'urban_coef': m.params['urban.2009.500m'],
        'urban_pval': m.pvalues['urban.2009.500m'],
        'crop_coef': m.params['cropland.2009.500m'],
        'crop_pval': m.pvalues['cropland.2009.500m']
    })
pd.DataFrame(multivar_records).to_csv('artifacts/multivar_controlled_results.csv', index=False)
print('Saved artifacts/multivar_controlled_results.csv')

# 4. Multi-scale model (local 50m vs landscape 500m / 1000m)
multiscale_records = []
for target in targets:
    X = sm.add_constant(df[['urban.2009.50m', 'urban.2009.500m']])
    m = sm.GLM(df[target], X, family=sm.families.Poisson()).fit()
    multiscale_records.append({
        'pathway': target,
        'local_50m_coef': m.params['urban.2009.50m'],
        'local_50m_pval': m.pvalues['urban.2009.50m'],
        'landscape_500m_coef': m.params['urban.2009.500m'],
        'landscape_500m_pval': m.pvalues['urban.2009.500m']
    })
pd.DataFrame(multiscale_records).to_csv('artifacts/multiscale_results.csv', index=False)
print('Saved artifacts/multiscale_results.csv')
