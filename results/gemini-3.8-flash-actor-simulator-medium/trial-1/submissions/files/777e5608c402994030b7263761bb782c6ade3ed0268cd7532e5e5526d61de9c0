import pandas as pd
import numpy as np
from scipy import stats

def run_analysis():
    df = pd.read_csv('data/nls_incarceration_processed.csv')
    jailed = df[df['ever_jailed'] == 1].copy()

    def calc_group_metrics(series):
        q25 = series.quantile(0.25)
        med = series.median()
        q75 = series.quantile(0.75)
        iqr = q75 - q25
        mean = series.mean()
        std = series.std()
        n = len(series)
        return pd.Series({
            'n': n,
            'mean': round(mean, 2),
            'std': round(std, 2),
            'q25': round(q25, 2),
            'median': round(med, 2),
            'q75': round(q75, 2),
            'iqr': round(iqr, 2)
        })

    print("=== SUMMARY: RACE ===")
    race_res = jailed.groupby('race')['composite_wealth_1985'].apply(calc_group_metrics).unstack()
    print(race_res)

    print("\n=== SUMMARY: SEX ===")
    sex_res = jailed.groupby('sex')['composite_wealth_1985'].apply(calc_group_metrics).unstack()
    print(sex_res)

    print("\n=== SUMMARY: RACE x SEX ===")
    racesex_res = jailed.groupby(['race', 'sex'])['composite_wealth_1985'].apply(calc_group_metrics).unstack()
    print(racesex_res)

    print("\n=== NON-PARAMETRIC TESTS ===")
    white_w = jailed[jailed['race'] == 'white']['composite_wealth_1985']
    black_w = jailed[jailed['race'] == 'black']['composite_wealth_1985']
    hisp_w = jailed[jailed['race'] == 'hipanic']['composite_wealth_1985']
    male_w = jailed[jailed['sex'] == 'male']['composite_wealth_1985']
    female_w = jailed[jailed['sex'] == 'female']['composite_wealth_1985']

    kw_race = stats.kruskal(white_w, black_w, hisp_w)
    u_wb = stats.mannwhitneyu(white_w, black_w, alternative='two-sided')
    u_wh = stats.mannwhitneyu(white_w, hisp_w, alternative='two-sided')
    u_bh = stats.mannwhitneyu(black_w, hisp_w, alternative='two-sided')
    u_sex = stats.mannwhitneyu(male_w, female_w, alternative='two-sided')

    print(f"Kruskal-Wallis (Race): H = {kw_race.statistic:.4f}, p = {kw_race.pvalue:.4f}")
    print(f"Mann-Whitney U (White vs Black): U = {u_wb.statistic}, p = {u_wb.pvalue:.4f}")
    print(f"Mann-Whitney U (White vs Hispanic): U = {u_wh.statistic}, p = {u_wh.pvalue:.4f}")
    print(f"Mann-Whitney U (Black vs Hispanic): U = {u_bh.statistic}, p = {u_bh.pvalue:.4f}")
    print(f"Mann-Whitney U (Male vs Female): U = {u_sex.statistic}, p = {u_sex.pvalue:.4f}")

if __name__ == '__main__':
    run_analysis()
