import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf

def main():
    # Load dataset
    df = pd.read_excel('data/data.xlsx')
    
    # Filter to the 80 valid patient records
    df = df.iloc[:80].copy()
    
    # Preprocess Age to float
    df['Age'] = df['Age'].astype(float)
    
    # Primary encoding: Response = 1 for PR (Groups == 1), 0 for non-response (Groups == 2: SD, PD)
    df['response'] = (df['Groups'] == 1).astype(int)
    
    # Fit simple logistic regression using statsmodels formula
    model = smf.logit('response ~ Age', data=df).fit()
    print("=== Simple Logistic Regression Results (Response = 1 for PR) ===")
    print(model.summary())
    
    age_coef = model.params['Age']
    age_se = model.bse['Age']
    age_pval = model.pvalues['Age']
    conf_int = model.conf_int().loc['Age']
    
    print("\nDetailed Age Coefficient Statistics:")
    print(f"Coefficient (change in log-odds): {age_coef:.6f}")
    print(f"Standard Error: {age_se:.6f}")
    print(f"z-statistic: {model.tvalues['Age']:.6f}")
    print(f"p-value: {age_pval:.6e}")
    print(f"95% Confidence Interval: [{conf_int[0]:.6f}, {conf_int[1]:.6f}]")
    print(f"Odds Ratio (exp(coef)): {np.exp(age_coef):.6f}")
    
    # Alternative encoding: Non-response / Group 2 = 1
    df['non_response'] = (df['Groups'] == 2).astype(int)
    model_alt = smf.logit('non_response ~ Age', data=df).fit()
    print("\n=== Alternative Logistic Regression Results (Non-Response = 1) ===")
    print(f"Coefficient for Age: {model_alt.params['Age']:.6f}")

if __name__ == '__main__':
    main()
