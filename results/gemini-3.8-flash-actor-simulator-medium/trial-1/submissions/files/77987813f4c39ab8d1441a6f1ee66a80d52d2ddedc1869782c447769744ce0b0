import os, sys, time
import numpy as np
import scipy.fft as fft

def main():
    N = 135
    dx = 1.0 / N
    M = N - 1
    CFL = 1.8797
    dt_frame = 0.1
    num_frames = 107
    save_frames = [0, 26, 52, 78, 104]

    k = np.arange(1, M + 1)
    kx, ky = np.meshgrid(k, k, indexing='ij')
    eig = 2.0 * (np.cos(kx * np.pi / (M + 1)) - 1.0) / dx**2 + 2.0 * (np.cos(ky * np.pi / (M + 1)) - 1.0) / dx**2

    def solve_poisson(w_int):
        f_hat = fft.dst(fft.dst(-w_int, type=1, axis=0), type=1, axis=1)
        psi_hat = f_hat / eig
        psi_int = fft.idst(fft.idst(psi_hat, type=1, axis=0), type=1, axis=1)
        return np.pad(psi_int, ((1, 1), (1, 1)), mode='constant', constant_values=0.0)

    def reconstruct_velocities(psi):
        ux = (psi[:, 1:] - psi[:, :-1]) / dx
        uy = -(psi[1:, :] - psi[:-1, :]) / dx
        ux[0, :] = 0.0
        ux[-1, :] = 0.0
        uy[:, 0] = 0.0
        uy[:, -1] = 0.0
        return ux, uy

    def get_node_velocities(ux, uy):
        u_node = np.zeros((N + 1, N + 1), dtype=np.float64)
        v_node = np.zeros((N + 1, N + 1), dtype=np.float64)
        u_node[:, 1:-1] = 0.5 * (ux[:, :-1] + ux[:, 1:])
        v_node[1:-1, :] = 0.5 * (uy[:-1, :] + uy[1:, :])
        return u_node, v_node

    def compute_node_vorticity(ux, uy):
        w_node = np.zeros((N + 1, N + 1), dtype=np.float64)
        w_node[1:-1, 1:-1] = (uy[1:, 1:-1] - uy[:-1, 1:-1]) / dx - (ux[1:-1, 1:] - ux[1:-1, :-1]) / dx
        return w_node

    def compute_cell_centered(ux, uy):
        uc = 0.5 * (ux[:-1, :] + ux[1:, :])
        vc = 0.5 * (uy[:, :-1] + uy[:, 1:])
        u_pad = np.pad(uc, ((0, 0), (1, 1)), mode='edge')
        v_pad = np.pad(vc, ((1, 1), (0, 0)), mode='edge')
        dvdx = (v_pad[2:, :] - v_pad[:-2, :]) / (2.0 * dx)
        dudy = (u_pad[:, 2:] - u_pad[:, :-2]) / (2.0 * dx)
        omega_cell = dvdx - dudy
        ke = 0.5 * (dx**2) * np.sum(uc**2 + vc**2)
        return float(ke), omega_cell.astype(np.float32)

    def eval_uv_and_grad(px, py, u_node, v_node):
        sx = px / dx
        sy = py / dx
        ix = np.round(sx).astype(np.int32)
        iy = np.round(sy).astype(np.int32)
        dx_rel = sx - ix
        dy_rel = sy - iy

        w0_x = 0.75 - dx_rel**2
        wm1_x = 0.5 * (0.5 - dx_rel)**2
        wp1_x = 0.5 * (0.5 + dx_rel)**2

        w0_y = 0.75 - dy_rel**2
        wm1_y = 0.5 * (0.5 - dy_rel)**2
        wp1_y = 0.5 * (0.5 + dy_rel)**2

        dw0_x = -2.0 * dx_rel / dx
        dwm1_x = (dx_rel - 0.5) / dx
        dwp1_x = (dx_rel + 0.5) / dx

        dw0_y = -2.0 * dy_rel / dx
        dwm1_y = (dy_rel - 0.5) / dx
        dwp1_y = (dy_rel + 0.5) / dx

        wx_list = [wm1_x, w0_x, wp1_x]
        wy_list = [wm1_y, w0_y, wp1_y]
        dwx_list = [dwm1_x, dw0_x, dwp1_x]
        dwy_list = [dwm1_y, dw0_y, dwp1_y]

        u = np.zeros_like(px)
        v = np.zeros_like(px)
        dudx = np.zeros_like(px)
        dudy = np.zeros_like(px)
        dvdx = np.zeros_like(px)
        dvdy = np.zeros_like(px)

        for kxi in range(3):
            wx = wx_list[kxi]
            dwx = dwx_list[kxi]
            gx = np.clip(ix + (kxi - 1), 0, N)
            for kyi in range(3):
                wy = wy_list[kyi]
                dwy = dwy_list[kyi]
                gy = np.clip(iy + (kyi - 1), 0, N)

                W = wx * wy
                dWx = dwx * wy
                dWy = wx * dwy

                un = u_node[gx, gy]
                vn = v_node[gx, gy]

                u += W * un
                v += W * vn
                dudx += dWx * un
                dudy += dWy * un
                dvdx += dWx * vn
                dvdy += dWy * vn

        return u, v, dudx, dudy, dvdx, dvdy

    def eval_uv(px, py, u_node, v_node):
        sx = px / dx
        sy = py / dx
        ix = np.round(sx).astype(np.int32)
        iy = np.round(sy).astype(np.int32)
        dx_rel = sx - ix
        dy_rel = sy - iy

        wx_list = [0.5 * (0.5 - dx_rel)**2, 0.75 - dx_rel**2, 0.5 * (0.5 + dx_rel)**2]
        wy_list = [0.5 * (0.5 - dy_rel)**2, 0.75 - dy_rel**2, 0.5 * (0.5 + dy_rel)**2]

        u = np.zeros_like(px)
        v = np.zeros_like(px)

        for kxi in range(3):
            wx = wx_list[kxi]
            gx = np.clip(ix + (kxi - 1), 0, N)
            for kyi in range(3):
                wy = wy_list[kyi]
                gy = np.clip(iy + (kyi - 1), 0, N)
                W = wx * wy
                u += W * u_node[gx, gy]
                v += W * v_node[gx, gy]
        return u, v

    def eval_scalar(px, py, field_node):
        sx = px / dx
        sy = py / dx
        ix = np.round(sx).astype(np.int32)
        iy = np.round(sy).astype(np.int32)
        dx_rel = sx - ix
        dy_rel = sy - iy

        wx_list = [0.5 * (0.5 - dx_rel)**2, 0.75 - dx_rel**2, 0.5 * (0.5 + dx_rel)**2]
        wy_list = [0.5 * (0.5 - dy_rel)**2, 0.75 - dy_rel**2, 0.5 * (0.5 + dy_rel)**2]

        val = np.zeros_like(px)
        for kxi in range(3):
            wx = wx_list[kxi]
            gx = np.clip(ix + (kxi - 1), 0, N)
            for kyi in range(3):
                wy = wy_list[kyi]
                gy = np.clip(iy + (kyi - 1), 0, N)
                val += (wx * wy) * field_node[gx, gy]
        return val

    def g2p_w_and_grad(px, py, w_node):
        sx = px / dx
        sy = py / dx
        ix = np.round(sx).astype(np.int32)
        iy = np.round(sy).astype(np.int32)
        dx_rel = sx - ix
        dy_rel = sy - iy

        w0_x = 0.75 - dx_rel**2
        wm1_x = 0.5 * (0.5 - dx_rel)**2
        wp1_x = 0.5 * (0.5 + dx_rel)**2

        w0_y = 0.75 - dy_rel**2
        wm1_y = 0.5 * (0.5 - dy_rel)**2
        wp1_y = 0.5 * (0.5 + dy_rel)**2

        dw0_x = -2.0 * dx_rel / dx
        dwm1_x = (dx_rel - 0.5) / dx
        dwp1_x = (dx_rel + 0.5) / dx

        dw0_y = -2.0 * dy_rel / dx
        dwm1_y = (dy_rel - 0.5) / dx
        dwp1_y = (dy_rel + 0.5) / dx

        wx_list = [wm1_x, w0_x, wp1_x]
        wy_list = [wm1_y, w0_y, wp1_y]
        dwx_list = [dwm1_x, dw0_x, dwp1_x]
        dwy_list = [dwm1_y, dw0_y, dwp1_y]

        part_w = np.zeros_like(px)
        grad_x = np.zeros_like(px)
        grad_y = np.zeros_like(px)

        for kxi in range(3):
            wx = wx_list[kxi]
            dwx = dwx_list[kxi]
            gx = np.clip(ix + (kxi - 1), 0, N)
            for kyi in range(3):
                wy = wy_list[kyi]
                dwy = dwy_list[kyi]
                gy = np.clip(iy + (kyi - 1), 0, N)

                W = wx * wy
                dWx = dwx * wy
                dWy = wx * dwy

                wn = w_node[gx, gy]
                part_w += W * wn
                grad_x += dWx * wn
                grad_y += dWy * wn

        return part_w, grad_x, grad_y

    def p2g_apic(px, py, part_w, Cc_x, Cc_y):
        sx = px / dx
        sy = py / dx
        ix = np.round(sx).astype(np.int32)
        iy = np.round(sy).astype(np.int32)
        dx_rel = sx - ix
        dy_rel = sy - iy

        wx_list = [0.5 * (0.5 - dx_rel)**2, 0.75 - dx_rel**2, 0.5 * (0.5 + dx_rel)**2]
        wy_list = [0.5 * (0.5 - dy_rel)**2, 0.75 - dy_rel**2, 0.5 * (0.5 + dy_rel)**2]

        grid_num = np.zeros((N + 1, N + 1), dtype=np.float64)
        grid_den = np.zeros((N + 1, N + 1), dtype=np.float64)

        for kxi in range(3):
            wx = wx_list[kxi]
            gx = np.clip(ix + (kxi - 1), 0, N)
            dpos_x = (gx * dx) - px
            for kyi in range(3):
                wy = wy_list[kyi]
                gy = np.clip(iy + (kyi - 1), 0, N)
                dpos_y = (gy * dx) - py

                W = wx * wy
                val = (part_w + Cc_x * dpos_x + Cc_y * dpos_y) * W

                np.add.at(grid_num, (gx, gy), val)
                np.add.at(grid_den, (gx, gy), W)

        mask = grid_den > 0
        grid_w = np.zeros_like(grid_num)
        grid_w[mask] = grid_num[mask] / grid_den[mask]
        return grid_w

    n_sub = 4
    sub = (np.arange(n_sub) + 0.5) / n_sub
    x_1d = (np.arange(N)[:, None] + sub[None, :]).ravel() * dx
    y_1d = (np.arange(N)[:, None] + sub[None, :]).ravel() * dx
    init_px, init_py = np.meshgrid(x_1d, y_1d, indexing='ij')
    init_px = init_px.ravel()
    init_py = init_py.ravel()

    grid_x_int, grid_y_int = np.meshgrid(np.arange(1, N) * dx, np.arange(1, N) * dx, indexing='ij')
    grid_x_int = grid_x_int.ravel()
    grid_y_int = grid_y_int.ravel()

    ux = np.load('data/initial_u_x.npy').astype(np.float64)
    uy = np.load('data/initial_u_y.npy').astype(np.float64)

    ke_history = np.zeros(num_frames + 1, dtype=np.float32)
    vorticity_history = np.zeros((len(save_frames), N, N), dtype=np.float32)

    ke0, w_cell0 = compute_cell_centered(ux, uy)
    ke_history[0] = ke0
    if 0 in save_frames:
        vorticity_history[save_frames.index(0)] = w_cell0

    w_node = compute_node_vorticity(ux, uy)
    print(f'Starting VPFM simulation: {num_frames} frames')
    print(f'Frame   0: KE = {ke0:.8e}')

    t_start = time.time()
    for frame in range(1, num_frames + 1):
        t_accum = 0.0
        while t_accum < dt_frame - 1e-12:
            max_vel = max(np.max(np.abs(ux)), np.max(np.abs(uy)))
            if max_vel < 1e-12:
                max_vel = 1e-12
            dt = min(CFL * dx / max_vel, dt_frame - t_accum)

            px = init_px.copy()
            py = init_py.copy()
            part_w, init_grad_x, init_grad_y = g2p_w_and_grad(px, py, w_node)

            T00 = np.ones_like(px)
            T01 = np.zeros_like(px)
            T10 = np.zeros_like(px)
            T11 = np.ones_like(px)

            u_node, v_node = get_node_velocities(ux, uy)
            tau = 0.5 * dt
            u1, v1 = eval_uv(grid_x_int, grid_y_int, u_node, v_node)
            x1 = np.clip(grid_x_int - 0.5 * tau * u1, 0.0, 1.0)
            y1 = np.clip(grid_y_int - 0.5 * tau * v1, 0.0, 1.0)

            u2, v2 = eval_uv(x1, y1, u_node, v_node)
            x2 = np.clip(grid_x_int - 0.5 * tau * u2, 0.0, 1.0)
            y2 = np.clip(grid_y_int - 0.5 * tau * v2, 0.0, 1.0)

            u3, v3 = eval_uv(x2, y2, u_node, v_node)
            x3 = np.clip(grid_x_int - tau * u3, 0.0, 1.0)
            y3 = np.clip(grid_y_int - tau * v3, 0.0, 1.0)

            u4, v4 = eval_uv(x3, y3, u_node, v_node)

            x_star = np.clip(grid_x_int - (tau / 6.0) * (u1 + 2.0 * u2 + 2.0 * u3 + u4), 0.0, 1.0)
            y_star = np.clip(grid_y_int - (tau / 6.0) * (v1 + 2.0 * v2 + 2.0 * v3 + v4), 0.0, 1.0)

            w_mid_flat = eval_scalar(x_star, y_star, w_node)
            w_mid_int = w_mid_flat.reshape(M, M)

            psi_mid = solve_poisson(w_mid_int)
            ux_mid, uy_mid = reconstruct_velocities(psi_mid)
            u_mid_node, v_mid_node = get_node_velocities(ux_mid, uy_mid)

            def f_step(px_c, py_c, t00, t01, t10, t11):
                u, v, dudx, dudy, dvdx, dvdy = eval_uv_and_grad(px_c, py_c, u_mid_node, v_mid_node)
                dt00 = -(dudx * t00 + dvdx * t10)
                dt01 = -(dudx * t01 + dvdx * t11)
                dt10 = -(dudy * t00 + dvdy * t10)
                dt11 = -(dudy * t01 + dvdy * t11)
                return u, v, dt00, dt01, dt10, dt11

            k1_x, k1_y, k1_00, k1_01, k1_10, k1_11 = f_step(px, py, T00, T01, T10, T11)

            px_s2 = np.clip(px + 0.5 * dt * k1_x, 0.5 * dx, 1.0 - 0.5 * dx)
            py_s2 = np.clip(py + 0.5 * dt * k1_y, 0.5 * dx, 1.0 - 0.5 * dx)
            k2_x, k2_y, k2_00, k2_01, k2_10, k2_11 = f_step(
                px_s2, py_s2,
                T00 + 0.5 * dt * k1_00, T01 + 0.5 * dt * k1_01,
                T10 + 0.5 * dt * k1_10, T11 + 0.5 * dt * k1_11
            )

            px_s3 = np.clip(px + 0.5 * dt * k2_x, 0.5 * dx, 1.0 - 0.5 * dx)
            py_s3 = np.clip(py + 0.5 * dt * k2_y, 0.5 * dx, 1.0 - 0.5 * dx)
            k3_x, k3_y, k3_00, k3_01, k3_10, k3_11 = f_step(
                px_s3, py_s3,
                T00 + 0.5 * dt * k2_00, T01 + 0.5 * dt * k2_01,
                T10 + 0.5 * dt * k2_10, T11 + 0.5 * dt * k2_11
            )

            px_s4 = np.clip(px + dt * k3_x, 0.5 * dx, 1.0 - 0.5 * dx)
            py_s4 = np.clip(py + dt * k3_y, 0.5 * dx, 1.0 - 0.5 * dx)
            k4_x, k4_y, k4_00, k4_01, k4_10, k4_11 = f_step(
                px_s4, py_s4,
                T00 + dt * k3_00, T01 + dt * k3_01,
                T10 + dt * k3_10, T11 + dt * k3_11
            )

            px = np.clip(px + (dt / 6.0) * (k1_x + 2.0 * k2_x + 2.0 * k3_x + k4_x), 0.5 * dx, 1.0 - 0.5 * dx)
            py = np.clip(py + (dt / 6.0) * (k1_y + 2.0 * k2_y + 2.0 * k3_y + k4_y), 0.5 * dx, 1.0 - 0.5 * dx)
            T00 += (dt / 6.0) * (k1_00 + 2.0 * k2_00 + 2.0 * k3_00 + k4_00)
            T01 += (dt / 6.0) * (k1_01 + 2.0 * k2_01 + 2.0 * k3_01 + k4_01)
            T10 += (dt / 6.0) * (k1_10 + 2.0 * k2_10 + 2.0 * k3_10 + k4_10)
            T11 += (dt / 6.0) * (k1_11 + 2.0 * k2_11 + 2.0 * k3_11 + k4_11)

            Cc_x = T00 * init_grad_x + T10 * init_grad_y
            Cc_y = T01 * init_grad_x + T11 * init_grad_y

            w_node_new = p2g_apic(px, py, part_w, Cc_x, Cc_y)
            psi_new = solve_poisson(w_node_new[1:N, 1:N])
            ux, uy = reconstruct_velocities(psi_new)
            w_node = compute_node_vorticity(ux, uy)

            t_accum += dt

        ke, w_cell = compute_cell_centered(ux, uy)
        ke_history[frame] = ke
        if frame in save_frames:
            vorticity_history[save_frames.index(frame)] = w_cell

        if frame % 10 == 0 or frame == num_frames:
            print(f'Frame {frame:3d}/{num_frames}: KE = {ke:.8e}, Elapsed = {time.time() - t_start:.1f}s')

    np.save('vorticity_frames.npy', vorticity_history)
    np.save('kinetic_energy.npy', ke_history)
    print('Simulation finished successfully.')

if __name__ == '__main__':
    main()
