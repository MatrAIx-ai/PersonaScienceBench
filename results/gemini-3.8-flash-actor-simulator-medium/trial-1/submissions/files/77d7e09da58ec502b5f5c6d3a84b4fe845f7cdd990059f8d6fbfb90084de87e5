import pandas as pd
import numpy as np
import statsmodels.api as sm

def main():
    df = pd.read_csv('data/nls_raw.csv')
    
    # 1. Race / Ethnicity
    df['black'] = (df['Racial/ethnic cohort, 1979'] == 1).astype(int)
    df['hispanic'] = (df['Racial/ethnic cohort, 1979'] == 2).astype(int)
    df['white'] = (df['Racial/ethnic cohort, 1979'] == 3).astype(int)
    
    # 2. Socioeconomic Status (SES)
    df['mother_ed'] = df["Highest grade completed by respondent's mother, 1979"].replace([95, -1, -2, -3, -4, -5], np.nan)
    df['father_ed'] = df["Highest grade completed by respondent's father, 1979"].replace([95, -1, -2, -3, -4, -5], np.nan)
    df['fam_income'] = df['Total net family income, previous calendar year, 1979'].replace([-1, -2, -3, -4, -5], np.nan)
    df['log_income'] = np.log(df['fam_income'].clip(lower=1))
    
    # 3. Academic Characteristics
    asvab_cols = [
        'ASVAB - Arithmetic Reasoning Z Score (rounded), 1981',
        'ASVAB - Word Knowledge Z Score (rounded), 1981',
        'ASVAB - Paragraph Comprehension Z Score (rounded), 1981',
        'ASVAB - Mathematics Knowledge Z Score (rounded), 1981'
    ]
    for col in asvab_cols:
        df[col] = df[col].replace([-1, -2, -3, -4, -5], np.nan)
    df['asvab_mean'] = df[asvab_cols].mean(axis=1)
    
    df['class_rank'] = df['Rank in class last year attended at this school, 1981'].replace([-1, -2, -3, -4, -5], np.nan)
    df['class_size'] = df['Number of students in class last year attended at this school, 1981'].replace([-1, -2, -3, -4, -5], np.nan)
    df['percentile_rank'] = 1.0 - (df['class_rank'] / df['class_size'])
    
    # 4. Education Outcome
    df['education'] = df['Highest grade completed, 1979'].replace([95, -1, -2, -3, -4, -5], np.nan)
    df['ba_deg'] = (df['education'] >= 16).astype(int)
    
    # Analysis on sample with ASVAB and SES
    cols = ['ba_deg', 'black', 'hispanic', 'mother_ed', 'father_ed', 'log_income', 'asvab_mean', 'Age of respondent, 1979', 'Sex of respondent, 1979']
    cc = df.dropna(subset=cols).copy()
    
    # Model 1: Logistic Regression without Academic Characteristics
    m1 = sm.Logit(cc['ba_deg'], sm.add_constant(cc[['black', 'hispanic', 'mother_ed', 'father_ed', 'log_income', 'Age of respondent, 1979', 'Sex of respondent, 1979']])).fit(disp=False)
    # Model 2: Logistic Regression with Academic Characteristics
    m2 = sm.Logit(cc['ba_deg'], sm.add_constant(cc[['black', 'hispanic', 'mother_ed', 'father_ed', 'log_income', 'asvab_mean', 'Age of respondent, 1979', 'Sex of respondent, 1979']])).fit(disp=False)
    
    print("Model 1 Odds Ratios (without ASVAB):")
    print(np.exp(m1.params))
    print("\nModel 2 Odds Ratios (with ASVAB):")
    print(np.exp(m2.params))

if __name__ == '__main__':
    main()
