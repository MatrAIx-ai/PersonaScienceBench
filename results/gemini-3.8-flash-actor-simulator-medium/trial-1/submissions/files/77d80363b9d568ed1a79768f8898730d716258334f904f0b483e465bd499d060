#!/usr/bin/env python3
"""
Shared-mode recovery from complex response curves using Variable Projection (VarPro).

Model:
    R_m(x) = a_{0, m} + sum_{k=1..K} a_{k, m} / (1 + (i * x * tau_k)^phi_k)

where:
    - tau_k > 0 (shared mode relaxation times)
    - 0 < phi_k <= 1 (shared Cole-Cole shape parameters)
    - a_{0, m} >= 0 (curve-specific baselines)
    - a_{k, m} >= 0 (curve-specific non-negative mode amplitudes)
"""

import os
import json
import numpy as np
import pandas as pd
from scipy.optimize import differential_evolution, minimize, lsq_linear


def load_data(curves_path="data/curves.csv", meta_path="data/meta.json"):
    df = pd.read_csv(curves_path)
    with open(meta_path, "r") as f:
        meta = json.load(f)

    curves = [df[df["curve"] == m].sort_values("x") for m in range(meta["n_curves"])]
    x = curves[0]["x"].values
    N = len(x)
    M = meta["n_curves"]

    Y = np.zeros((2 * N, M))
    for m in range(M):
        Y[:N, m] = curves[m]["re"].values
        Y[N:, m] = curves[m]["im"].values

    return x, Y, N, M, meta


def compute_design_matrix(x, taus, phis):
    """
    Construct the (2N, K+1) design matrix for linear parameters [baseline, a_1, ..., a_K].
    First N rows: Real part.
    Last N rows: Imaginary part.
    """
    N = len(x)
    K = len(taus)
    A = np.zeros((2 * N, K + 1))
    A[:N, 0] = 1.0  # Real baseline; imaginary baseline is 0

    for k in range(K):
        # z = (i * x * tau)^phi = (x * tau)^phi * exp(i * pi / 2 * phi)
        z = (x * taus[k]) ** phis[k] * np.exp(1j * np.pi / 2.0 * phis[k])
        fk = 1.0 / (1.0 + z)
        A[:N, k + 1] = fk.real
        A[N:, k + 1] = fk.imag

    return A


def fit_linear_parameters(A, Y):
    """
    Given design matrix A and observations Y, solve NNLS for each curve:
    min_{c >= 0} || A c - Y[:, m] ||^2.
    """
    K_plus_1, M = A.shape[1], Y.shape[1]
    coeffs = np.zeros((K_plus_1, M))
    resids = np.zeros_like(Y)
    total_rss = 0.0

    for m in range(M):
        res = lsq_linear(A, Y[:, m], bounds=(0, np.inf))
        coeffs[:, m] = res.x
        resids[:, m] = res.fun
        total_rss += np.sum(res.fun ** 2)

    return total_rss, coeffs, resids


def fit_varpro(x, Y, K, seed=42):
    """
    Fit K modes using Variable Projection with global differential evolution
    followed by local optimization.
    """
    N = len(x)
    bounds = [(-4.0, 4.0)] * K + [(0.1, 1.0)] * K

    def objective(p):
        log_taus = p[:K]
        phis = p[K:]
        taus = 10.0 ** log_taus
        A = compute_design_matrix(x, taus, phis)
        total_rss, _, _ = fit_linear_parameters(A, Y)
        return total_rss

    # Global optimization
    res_de = differential_evolution(
        objective, bounds, seed=seed, maxiter=50, popsize=15, polish=False
    )

    # Local refinement
    res_opt = minimize(objective, res_de.x, method="L-BFGS-B", bounds=bounds)

    log_taus = res_opt.x[:K]
    phis = res_opt.x[K:]
    taus = 10.0 ** log_taus

    # Sort modes by tau ascending
    order = np.argsort(taus)
    taus = taus[order]
    phis = phis[order]

    A = compute_design_matrix(x, taus, phis)
    rss, coeffs, resids = fit_linear_parameters(A, Y)

    return taus, phis, coeffs, resids, rss


def evaluate_model_selection(x, Y, N, M):
    print("=== Model Selection (K = 1 to 5) ===")
    n_data = 2 * N * M
    results = {}
    for K in range(1, 6):
        taus, phis, coeffs, resids, rss = fit_varpro(x, Y, K, seed=42)
        n_params = 2 * K + (K + 1) * M
        aic = n_data * np.log(rss / n_data) + 2 * n_params
        bic = n_data * np.log(rss / n_data) + n_params * np.log(n_data)
        sigma = np.sqrt(rss / n_data)
        results[K] = {
            "taus": taus,
            "phis": phis,
            "coeffs": coeffs,
            "resids": resids,
            "rss": rss,
            "n_params": n_params,
            "aic": aic,
            "bic": bic,
            "sigma": sigma,
        }
        print(
            f"K={K:1d} | RSS={rss:8.4f} | sigma={sigma:.4f} | "
            f"AIC={aic:8.1f} | BIC={bic:8.1f} | taus={taus.round(4)}"
        )
    return results


def main():
    x, Y, N, M, meta = load_data()
    print(f"Loaded data: {M} curves, {N} points each.")
    print(f"x range: [{x.min():.4e}, {x.max():.4e}]")

    # Run model selection
    selection_results = evaluate_model_selection(x, Y, N, M)

    # Select best K by minimum BIC
    best_K = min(selection_results.keys(), key=lambda k: selection_results[k]["bic"])
    best = selection_results[best_K]
    print(f"\nOptimal number of modes according to BIC: K = {best_K}")

    taus = best["taus"]
    phis = best["phis"]
    coeffs = best["coeffs"]
    resids = best["resids"]
    rss = best["rss"]

    # Diagnostics
    print("\n=== Optimal Model Fit Diagnostics (K = 4) ===")
    print(f"Residual Sum of Squares (RSS): {rss:.6f}")
    print(f"Estimated noise std (sigma): {best['sigma']:.5f}")
    print(f"BIC: {best['bic']:.2f}, AIC: {best['aic']:.2f}")

    print("\nRecovered mode centres (tau) and shapes (phi):")
    for k in range(best_K):
        print(f"  Mode {k+1}: tau = {taus[k]:.6e}, phi = {phis[k]:.4f}")

    print("\nCurve baselines (a0):")
    for m in range(M):
        print(f"  Curve {m}: baseline = {coeffs[0, m]:.4f}")

    print("\nModal Amplitudes a_{k, m}:")
    col_names = [f"a_{m}" for m in range(M)]
    amp_df = pd.DataFrame(coeffs[1:, :], columns=col_names)
    amp_df.insert(0, "tau", taus)
    amp_df.insert(1, "phi", phis)
    print(amp_df.to_string(index=False))

    # Check physical constraints
    print("\n=== Physical Constraints Verification ===")
    assert np.all(taus > 0), "Violation: tau must be positive"
    assert np.all((phis > 0) & (phis <= 1.0)), "Violation: phi must be in (0, 1]"
    assert np.all(coeffs >= 0), "Violation: amplitudes and baselines must be non-negative"
    print("All physical constraints satisfied: tau > 0, 0 < phi <= 1, a >= 0.")

    # Residual autocorrelation check
    print("\nResidual autocorrelation (lag-1):")
    for m in range(M):
        r_re = resids[:N, m]
        r_im = resids[N:, m]
        c_re = np.corrcoef(r_re[:-1], r_re[1:])[0, 1]
        c_im = np.corrcoef(r_im[:-1], r_im[1:])[0, 1]
        print(f"  Curve {m}: lag-1 corr Re = {c_re:+.3f}, Im = {c_im:+.3f}")

    # Save results/modes.csv strictly conforming to specifications:
    # columns: tau, a_0, a_1, ..., a_{M-1}
    os.makedirs("results", exist_ok=True)
    out_df = pd.DataFrame(coeffs[1:, :], columns=[f"a_{m}" for m in range(M)])
    out_df.insert(0, "tau", taus)

    output_path = "results/modes.csv"
    out_df.to_csv(output_path, index=False)
    print(f"\nSaved recovered modes to {output_path}:")
    print(out_df.to_string(index=False))


if __name__ == "__main__":
    main()
