import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf

# 1. Load dataset
data_path = 'data/nls_ses_processed.csv'
df = pd.read_csv(data_path)

# Clean column names
df.columns = [c.strip().replace(' ', '_').replace(':', '') for c in df.columns]
df['BA_DEGREE_COMPLETED'] = df['BA_DEGREE_COMPLETED'].astype(int)

print("Dataset Summary:")
print(f"Total observations: {len(df)}")
print("\nSample Race distribution:")
print(df['SAMPLE_RACE'].value_counts())

print("\nBA Degree Completion by Race:")
ct = pd.crosstab(df['SAMPLE_RACE'], df['BA_DEGREE_COMPLETED'], margins=True)
ct['Completion_Rate_%'] = (ct[1] / ct['All']) * 100
print(ct)

# 2. Logistic Regression: Race * SES with White reference
df['race_ref_white'] = pd.Categorical(df['SAMPLE_RACE'], categories=['White', 'Black', 'Hispanic'])
model_white_ref = smf.logit('BA_DEGREE_COMPLETED ~ race_ref_white * SES', data=df).fit()

print("\n" + "="*70)
print("Model 1: BA Degree Completed ~ SAMPLE_RACE * SES (Reference: White)")
print("="*70)
print(model_white_ref.summary())

# Extract coefficients, std errors, p-values, odds ratios, 95% CIs
res_df = pd.DataFrame({
    'Coefficient': model_white_ref.params,
    'Std_Error': model_white_ref.bse,
    'z_value': model_white_ref.tvalues,
    'p_value': model_white_ref.pvalues,
    'Odds_Ratio': np.exp(model_white_ref.params),
    'CI_lower': np.exp(model_white_ref.conf_int()[0]),
    'CI_upper': np.exp(model_white_ref.conf_int()[1])
})
print("\nModel 1 Exponentiated Parameters (Odds Ratios and 95% CI):")
print(res_df)

# 3. Model 2: Black Reference Group
df['race_ref_black'] = pd.Categorical(df['SAMPLE_RACE'], categories=['Black', 'White', 'Hispanic'])
model_black_ref = smf.logit('BA_DEGREE_COMPLETED ~ race_ref_black * SES', data=df).fit()

print("\n" + "="*70)
print("Model 2: BA Degree Completed ~ SAMPLE_RACE * SES (Reference: Black)")
print("="*70)
print(model_black_ref.summary())

# 4. Model 3: Hispanic Reference Group
df['race_ref_hispanic'] = pd.Categorical(df['SAMPLE_RACE'], categories=['Hispanic', 'Black', 'White'])
model_hispanic_ref = smf.logit('BA_DEGREE_COMPLETED ~ race_ref_hispanic * SES', data=df).fit()

print("\n" + "="*70)
print("Model 3: BA Degree Completed ~ SAMPLE_RACE * SES (Reference: Hispanic)")
print("="*70)
print(model_hispanic_ref.summary())

# 5. Check exact factor
black_coef = model_white_ref.params['race_ref_white[T.Black]']
print("\n" + "="*70)
print(f"Target Factor (race[T.Black] relative to White reference): {black_coef:.6f}")
print(f"Rounded to 4 decimal places: {black_coef:.4f}")
print("="*70)
