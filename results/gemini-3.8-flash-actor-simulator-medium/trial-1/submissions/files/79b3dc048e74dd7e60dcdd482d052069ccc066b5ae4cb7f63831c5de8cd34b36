import pandas as pd
import numpy as np
from statsmodels.multivariate.pca import PCA

# 1. Load capital dataset
df_cap = pd.read_csv('data/capital.csv', decimal=',')
capital_vars = [
    'ZAxtSchwert', 'ZDolch', 'Zhausgr', 'ZCU_AU', 'Zamber', 
    'ZMonument', 'ZHort', 'ZSichel', 'ZBeil', 'ZMW', 'ZKeform', 'Zkeverz'
]
var_labels = {
    'ZAxtSchwert': 'Hatchet/Sword (Symbolic)',
    'ZDolch': 'Dagger (Symbolic)',
    'Zhausgr': 'House Size (Symbolic)',
    'ZCU_AU': 'Copper and Gold (Social)',
    'Zamber': 'Amber (Social)',
    'ZMonument': 'Monument Count (Social)',
    'ZHort': 'Depot (Economic)',
    'ZSichel': 'Sickle (Economic)',
    'ZBeil': 'Axes and Celts (Economic)',
    'ZMW': 'Monument Size (Economic)',
    'ZKeform': 'Pottery Form (Cultural)',
    'Zkeverz': 'Pottery Decoration (Cultural)'
}

X = df_cap[capital_vars].astype(float)

# 2. Compute full PCA across all components using statsmodels
pca_full_std = PCA(X, ncomp=12, standardize=True, demean=True)
loadings_std = pca_full_std.loadings
var_exp_std = pca_full_std.eigenvals / np.sum(pca_full_std.eigenvals) * 100

pca_full_raw = PCA(X, ncomp=12, standardize=False, demean=True)
loadings_raw = pca_full_raw.loadings
var_exp_raw = pca_full_raw.eigenvals / np.sum(pca_full_raw.eigenvals) * 100

print(f"Standardized PCA: PC1 explains {var_exp_std.iloc[0]:.2f}% of total variance, PC2 explains {var_exp_std.iloc[1]:.2f}% (Cumulative: {var_exp_std.iloc[0]+var_exp_std.iloc[1]:.2f}%).")
print(f"Covariance PCA:   PC1 explains {var_exp_raw.iloc[0]:.2f}% of total variance, PC2 explains {var_exp_raw.iloc[1]:.2f}% (Cumulative: {var_exp_raw.iloc[0]+var_exp_raw.iloc[1]:.2f}%).")
print("\n--- PCA Loadings on Forms of Capital ---")
df_summary = pd.DataFrame({
    'Variable': [var_labels[v] for v in capital_vars],
    'PC1_Standardized': [loadings_std.loc[v, 'comp_00'] for v in capital_vars],
    'PC2_Standardized': [loadings_std.loc[v, 'comp_01'] for v in capital_vars],
    'PC1_Covariance': [loadings_raw.loc[v, 'comp_00'] for v in capital_vars],
    'PC2_Covariance': [loadings_raw.loc[v, 'comp_01'] for v in capital_vars]
})
print(df_summary.to_string(index=False))

# Symbolic capital specific findings:
print("\n--- Symbolic Capital Focus ---")
for sym in ['ZAxtSchwert', 'ZDolch', 'Zhausgr']:
    print(f"{var_labels[sym]}: PC1 = {loadings_std.loc[sym, 'comp_00']:.4f}, PC2 = {loadings_std.loc[sym, 'comp_01']:.4f}")

