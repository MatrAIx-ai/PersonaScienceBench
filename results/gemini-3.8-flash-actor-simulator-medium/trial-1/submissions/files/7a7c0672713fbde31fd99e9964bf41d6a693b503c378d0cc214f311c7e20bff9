"""
Coupled Farquhar (C3) / Collatz (C4) Photosynthesis and Ball-Berry Conductance Solver.
Outputs:
- results/leaf_fluxes.csv
- results/case_convergence.csv
- results/diurnal.png
"""
import os
import json
import zlib
import struct
import base64
import numpy as np
import pandas as pd

R_GAS = 8.31446

def calc_esat(t_air_k):
    Tc = t_air_k - 273.16
    return 610.78 * np.exp(17.269 * Tc / (Tc + 237.3))

def calc_hs(t_air_k, vpd_pa):
    es = calc_esat(t_air_k)
    return np.clip(1.0 - vpd_pa / es, 0.25, 1.0)

def calc_vcmax(t_air_k, vcmax25, n_factor, btran):
    Tc = t_air_k - 273.16
    T_k = Tc + 273.16
    denom = 1.0 + np.exp((-2.2e5 + 710.0 * T_k) / (R_GAS * T_k))
    vcmax_t = vcmax25 * (2.4 ** ((Tc - 25.0) / 10.0)) / denom
    return vcmax_t * n_factor * btran

def solve_point(ci_init, par, t_air, p_atm, co2_pa, o2_pa, vpd_pa, rb, btran, params, tol=1e-4, max_iter=100):
    Tc = t_air - 273.16
    cf = p_atm / (R_GAS * t_air)
    hs = calc_hs(t_air, vpd_pa)
    
    vcmax25 = params['vcmax25']
    n_factor = params.get('n_factor', 1.0)
    vcmax = calc_vcmax(t_air, vcmax25, n_factor, btran)
    rd = 0.015 * vcmax

    alpha_q = params['alpha_q']
    m = params['bb_slope']
    b0 = params['bb_intercept']
    pathway = params.get('pathway', 'C4').upper()

    if par < 1e-4:
        a = -rd
        a_mol = a * 1e-6
        gs = b0
        rs = cf / gs
        cs = co2_pa - 1.37 * rb * a_mol / cf * p_atm
        ci = cs - 1.65 * rs * a_mol / cf * p_atm
        return ci, a, rs, gs, 0

    apar = 4.6 * par
    if pathway == 'C4':
        wc = vcmax
        wj = alpha_q * apar
    else:
        kc = 30.0 * (2.1 ** ((Tc - 25.0) / 10.0))
        ko = 30000.0 * (1.2 ** ((Tc - 25.0) / 10.0))
        gamma_star = 0.5 * (kc / ko) * o2_pa * 0.21
        j = alpha_q * apar
        we = 0.5 * vcmax

    ci = float(ci_init)
    n_iterations = 0

    for iter_count in range(1, max_iter + 1):
        n_iterations = iter_count
        if pathway == 'C4':
            we = 4000.0 * vcmax * ci / p_atm
            a = min(wc, wj, we) - rd
        else:
            wc_val = vcmax * (ci - gamma_star) / (ci + kc * (1.0 + o2_pa / ko))
            wj_val = j * (ci - gamma_star) / (4.0 * ci + 8.0 * gamma_star)
            a = min(wc_val, wj_val, we) - rd

        a_mol = a * 1e-6
        cs = co2_pa - 1.37 * rb * a_mol / cf * p_atm
        gs = m * a_mol * hs / cs * p_atm + b0
        if gs < 1e-6:
            gs = 1e-6
        rs = cf / gs
        ci_next = cs - 1.65 * rs * a_mol / cf * p_atm

        if abs(ci_next - ci) < tol:
            ci = ci_next
            break
        ci = ci_next

    if pathway == 'C4':
        we = 4000.0 * vcmax * ci / p_atm
        a = min(wc, wj, we) - rd
    else:
        wc_val = vcmax * (ci - gamma_star) / (ci + kc * (1.0 + o2_pa / ko))
        wj_val = j * (ci - gamma_star) / (4.0 * ci + 8.0 * gamma_star)
        a = min(wc_val, wj_val, we) - rd

    a_mol = a * 1e-6
    cs = co2_pa - 1.37 * rb * a_mol / cf * p_atm
    gs = m * a_mol * hs / cs * p_atm + b0
    if gs < 1e-6:
        gs = 1e-6
    rs = cf / gs

    return ci, a, rs, gs, n_iterations

def load_font():
    b64_keys = "IC0uOigpLzAxMjM0NTY3ODlBQkNERUZHSElKS0xNTk9QUVJTVFVWV1hZWmFiY2RlZmdoaWprbG1ub3BxcnN0dXZ3eHl6Xj0s"
    b64_data = ""
    keys = base64.b64decode(b64_keys).decode('utf-8')
    raw_data = base64.b64decode(b64_data)
    font_dict = {}
    for i, ch in enumerate(keys):
        font_dict[ch] = list(raw_data[i*5:(i+1)*5])
    return font_dict

FONT_MAP = load_font()

class Canvas:
    def __init__(self, w, h, bg=(255, 255, 255)):
        self.w = w
        self.h = h
        self.buf = np.full((h, w, 3), bg, dtype=np.uint8)

    def set_pixel(self, x, y, color):
        if 0 <= x < self.w and 0 <= y < self.h:
            self.buf[y, x] = color

    def fill_rect(self, x0, y0, x1, y1, color):
        x0, x1 = max(0, min(self.w, x0)), max(0, min(self.w, x1))
        y0, y1 = max(0, min(self.h, y0)), max(0, min(self.h, y1))
        if x0 < x1 and y0 < y1:
            self.buf[y0:y1, x0:x1] = color

    def draw_line(self, x0, y0, x1, y1, color, thickness=1):
        dx, dy = abs(x1 - x0), abs(y1 - y0)
        sx = 1 if x0 < x1 else -1
        sy = 1 if y0 < y1 else -1
        err = dx - dy
        r = thickness // 2
        while True:
            for ty in range(-r, r + 1):
                for tx in range(-r, r + 1):
                    self.set_pixel(x0 + tx, y0 + ty, color)
            if x0 == x1 and y0 == y1:
                break
            e2 = 2 * err
            if e2 > -dy:
                err -= dy
                x0 += sx
            if e2 < dx:
                err += dx
                y0 += sy

    def draw_text(self, text, x, y, color=(0, 0, 0), scale=1):
        cur_x = x
        for ch in text:
            pattern = FONT_MAP.get(ch, FONT_MAP.get(' ', [0]*5))
            for col_idx, col_byte in enumerate(pattern):
                for row_idx in range(8):
                    if (col_byte >> row_idx) & 1:
                        px = cur_x + col_idx * scale
                        py = y + row_idx * scale
                        if scale == 1:
                            self.set_pixel(px, py, color)
                        else:
                            self.fill_rect(px, py, px + scale, py + scale, color)
            cur_x += (len(pattern) + 1) * scale

    def save_png(self, filename):
        raw = bytearray()
        for y in range(self.h):
            raw.append(0)
            raw.extend(self.buf[y].tobytes())

        def make_chunk(tag, data):
            c = tag + data
            return struct.pack('>I', len(data)) + c + struct.pack('>I', zlib.crc32(c) & 0xffffffff)

        ihdr = struct.pack('>IIBBBBB', self.w, self.h, 8, 2, 0, 0, 0)
        png = (b'\x89PNG\r\n\x1a\n' +
               make_chunk(b'IHDR', ihdr) +
               make_chunk(b'IDAT', zlib.compress(bytes(raw), level=6)) +
               make_chunk(b'IEND', b''))
        with open(filename, 'wb') as f:
            f.write(png)

def plot_diurnal(df_fluxes, output_path):
    w, h = 1000, 700
    canvas = Canvas(w, h, bg=(255, 255, 255))

    canvas.draw_text("Diurnal Cycle: Leaf Photosynthesis & Stomatal Resistance", 160, 25, color=(20, 20, 20), scale=2)

    x_left, x_right = 100, 930
    pw = x_right - x_left
    y1_top, y1_bot = 70, 320
    ph1 = y1_bot - y1_top
    y2_top, y2_bot = 370, 620
    ph2 = y2_bot - y2_top

    times = df_fluxes['time_hr'].values
    t_min, t_max = times.min(), times.max()

    def t_to_x(t):
        return int(x_left + (t - t_min) / (t_max - t_min) * pw)

    a_sun = df_fluxes['A_sun'].values
    a_shade = df_fluxes['A_shade'].values
    a_min, a_max = -5.0, 50.0

    def a_to_y(a):
        norm = (a - a_min) / (a_max - a_min)
        return int(y1_bot - norm * ph1)

    rs_sun = df_fluxes['rs_sun'].values
    rs_shade = df_fluxes['rs_shade'].values
    rs_min, rs_max = 0.0, 1200.0

    def rs_to_y(rs):
        norm = (rs - rs_min) / (rs_max - rs_min)
        return int(y2_bot - norm * ph2)

    canvas.fill_rect(x_left, y1_top, x_right, y1_bot, (248, 249, 250))
    canvas.fill_rect(x_left, y2_top, x_right, y2_bot, (248, 249, 250))

    for t in range(0, int(t_max) + 1, 12):
        x = t_to_x(t)
        canvas.draw_line(x, y1_top, x, y1_bot, (225, 228, 232), thickness=1)
        canvas.draw_line(x, y2_top, x, y2_bot, (225, 228, 232), thickness=1)
        canvas.draw_line(x, y2_bot, x, y2_bot + 5, (50, 50, 50), thickness=1)
        canvas.draw_text(str(t), x - 6, y2_bot + 10, color=(60, 60, 60), scale=1)

    for val in range(0, 55, 10):
        y = a_to_y(val)
        canvas.draw_line(x_left, y, x_right, y, (225, 228, 232), thickness=1)
        canvas.draw_line(x_left - 5, y, x_left, y, (50, 50, 50), thickness=1)
        canvas.draw_text(f"{val:>2}", x_left - 30, y - 4, color=(60, 60, 60), scale=1)

    for val in range(0, 1300, 200):
        y = rs_to_y(val)
        canvas.draw_line(x_left, y, x_right, y, (225, 228, 232), thickness=1)
        canvas.draw_line(x_left - 5, y, x_left, y, (50, 50, 50), thickness=1)
        canvas.draw_text(f"{val:>4}", x_left - 42, y - 4, color=(60, 60, 60), scale=1)

    for yt, yb in [(y1_top, y1_bot), (y2_top, y2_bot)]:
        canvas.draw_line(x_left, yt, x_left, yb, (50, 50, 50), thickness=2)
        canvas.draw_line(x_left, yb, x_right, yb, (50, 50, 50), thickness=2)
        canvas.draw_line(x_right, yt, x_right, yb, (180, 180, 180), thickness=1)
        canvas.draw_line(x_left, yt, x_right, yt, (180, 180, 180), thickness=1)

    canvas.draw_text("A (umol m^-2 s^-1)", x_left + 15, y1_top + 15, color=(40, 40, 40), scale=1)
    canvas.draw_text("rs (s m^-1)", x_left + 15, y2_top + 15, color=(40, 40, 40), scale=1)
    canvas.draw_text("Simulation Time (hr)", x_left + pw // 2 - 60, y2_bot + 35, color=(20, 20, 20), scale=1)

    for i in range(len(times) - 1):
        canvas.draw_line(t_to_x(times[i]), a_to_y(a_sun[i]), t_to_x(times[i+1]), a_to_y(a_sun[i+1]), (220, 50, 32), thickness=2)
        canvas.draw_line(t_to_x(times[i]), a_to_y(a_shade[i]), t_to_x(times[i+1]), a_to_y(a_shade[i+1]), (30, 100, 200), thickness=2)

    for i in range(len(times) - 1):
        canvas.draw_line(t_to_x(times[i]), rs_to_y(rs_sun[i]), t_to_x(times[i+1]), rs_to_y(rs_sun[i+1]), (220, 50, 32), thickness=2)
        canvas.draw_line(t_to_x(times[i]), rs_to_y(rs_shade[i]), t_to_x(times[i+1]), rs_to_y(rs_shade[i+1]), (30, 100, 200), thickness=2)

    canvas.draw_line(x_right - 180, y1_top + 18, x_right - 145, y1_top + 18, (220, 50, 32), thickness=3)
    canvas.draw_text("Sunlit Leaf", x_right - 135, y1_top + 14, color=(40, 40, 40), scale=1)
    canvas.draw_line(x_right - 180, y1_top + 34, x_right - 145, y1_top + 34, (30, 100, 200), thickness=3)
    canvas.draw_text("Shaded Leaf", x_right - 135, y1_top + 30, color=(40, 40, 40), scale=1)

    canvas.save_png(output_path)

def main():
    os.makedirs('results', exist_ok=True)
    
    with open('data/leaf_params.json', 'r') as f:
        leaf_params = json.load(f)
    with open('data/test_cases.json', 'r') as f:
        test_cases = json.load(f)
    forcing = pd.read_csv('data/forcing.csv')

    print(f"Loaded leaf parameters: pathway={leaf_params.get('pathway')}, vcmax25={leaf_params.get('vcmax25')}")
    print(f"Evaluating {len(test_cases)} test cases...")

    case_results = []
    for tc in test_cases:
        row = forcing.iloc[tc['forcing_index']]
        ci_init = tc['ci_init_pa']
        ci_final, a_final, rs_final, gs_final, n_iters = solve_point(
            ci_init, row['par_sun_wm2'], row['t_air_K'], row['p_atm_Pa'],
            row['co2_pa'], row['o2_pa'], row['vpd_Pa'], row['rb_sm'],
            row['btran'], leaf_params
        )
        case_results.append({
            'case_id': tc['case_id'],
            'ci_init_pa': ci_init,
            'ci_final_pa': ci_final,
            'A_final': a_final,
            'rs_final': rs_final,
            'n_iterations': n_iters
        })

    df_cases = pd.DataFrame(case_results)
    case_out_path = 'results/case_convergence.csv'
    df_cases.to_csv(case_out_path, index=False)
    print(f"Saved test case convergence results to {case_out_path}")
    print(df_cases)

    print(f"Processing {len(forcing)} forcing records...")
    flux_rows = []
    for idx, row in forcing.iterrows():
        ci_sun, a_sun, rs_sun, gs_sun, _ = solve_point(
            0.7 * row['co2_pa'], row['par_sun_wm2'], row['t_air_K'], row['p_atm_Pa'],
            row['co2_pa'], row['o2_pa'], row['vpd_Pa'], row['rb_sm'],
            row['btran'], leaf_params
        )
        ci_shade, a_shade, rs_shade, gs_shade, _ = solve_point(
            0.7 * row['co2_pa'], row['par_shade_wm2'], row['t_air_K'], row['p_atm_Pa'],
            row['co2_pa'], row['o2_pa'], row['vpd_Pa'], row['rb_sm'],
            row['btran'], leaf_params
        )
        flux_rows.append({
            'time_hr': row['time_hr'],
            'A_sun': a_sun,
            'A_shade': a_shade,
            'rs_sun': rs_sun,
            'rs_shade': rs_shade,
            'ci_sun': ci_sun,
            'ci_shade': ci_shade,
            'gs_sun': gs_sun,
            'gs_shade': gs_shade
        })

    df_fluxes = pd.DataFrame(flux_rows)
    flux_out_path = 'results/leaf_fluxes.csv'
    df_fluxes.to_csv(flux_out_path, index=False)
    print(f"Saved leaf fluxes to {flux_out_path}")

    png_out_path = 'results/diurnal.png'
    plot_diurnal(df_fluxes, png_out_path)
    print(f"Generated diurnal plot at {png_out_path}")

if __name__ == '__main__':
    main()
