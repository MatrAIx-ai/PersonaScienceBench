# Analysis script for BA degree completion / higher education progression
import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf

df = pd.read_csv('data/nls_raw.csv')

# Coding race / cohort
df['black'] = (df['Racial/ethnic cohort, 1979'] == 1).astype(int)
df['hispanic'] = (df['Racial/ethnic cohort, 1979'] == 2).astype(int)
df['female'] = (df['Sex of respondent, 1979'] == 2).astype(int)
df['age'] = df['Age of respondent, 1979']

# SES indicators
df['motheduc'] = df["Highest grade completed by respondent's mother, 1979"]
df['fatheduc'] = df["Highest grade completed by respondent's father, 1979"]
df['parent_educ_max'] = df[['motheduc', 'fatheduc']].max(axis=1)
df['ln_income'] = np.log(df['Total net family income, previous calendar year, 1979'] + 1)
df['asinh_wealth85'] = np.arcsinh(df['Family net wealth, 1985'])

# Academic characteristics
asvab_cols = ['ASVAB - Arithmetic Reasoning Z Score (rounded), 1981',
              'ASVAB - Word Knowledge Z Score (rounded), 1981',
              'ASVAB - Paragraph Comprehension Z Score (rounded), 1981',
              'ASVAB - Mathematics Knowledge Z Score (rounded), 1981']

for col in asvab_cols:
    df[col + '_std'] = (df[col] - df[col].mean()) / df[col].std()

df['asvab_composite'] = df[[c + '_std' for c in asvab_cols]].mean(axis=1)

df['class_rank_pct'] = 100.0 * (df['Number of students in class last year attended at this school, 1981'] - 
                                df['Rank in class last year attended at this school, 1981'] + 1) /                        df['Number of students in class last year attended at this school, 1981']

# Residence proxies
dorm_cols = [c for c in df.columns if 'residence' in c.lower()]
df['ever_dorm'] = (df[dorm_cols] == 3).any(axis=1).astype(int)
df['years_dorm'] = (df[dorm_cols] == 3).sum(axis=1)
df['dorm_ge2'] = (df['years_dorm'] >= 2).astype(int)
df['grade_ge13_79'] = (df['Highest grade completed, 1979'] >= 13).astype(int)

# Logistic models on main proxy
sub = df.dropna(subset=['ever_dorm', 'black', 'hispanic', 'parent_educ_max', 'ln_income', 'age', 'female', 'asvab_composite']).copy()
m1_logit = smf.logit('ever_dorm ~ black + hispanic + parent_educ_max + ln_income + age + female', data=sub).fit()
m2_logit = smf.logit('ever_dorm ~ black + hispanic + parent_educ_max + ln_income + age + female + asvab_composite', data=sub).fit()

# LPM / OLS models
m1_ols = smf.ols('ever_dorm ~ black + hispanic + parent_educ_max + ln_income + age + female', data=sub).fit(cov_type='HC1')
m2_ols = smf.ols('ever_dorm ~ black + hispanic + parent_educ_max + ln_income + age + female + asvab_composite', data=sub).fit(cov_type='HC1')

print('Logit M1 AIC:', m1_logit.aic, 'M2 AIC:', m2_logit.aic)
print('OLS M1 R2:', m1_ols.rsquared, 'M2 R2:', m2_ols.rsquared)
