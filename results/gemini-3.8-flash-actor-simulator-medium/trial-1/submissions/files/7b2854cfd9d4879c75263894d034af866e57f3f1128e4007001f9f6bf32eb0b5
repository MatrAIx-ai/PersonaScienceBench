#!/usr/bin/env python3
"""
Analysis of the independent effect of ongoing medical conditions (MHONGO)
on COVID-19 severity using ordinal regression.
Dataset: TASK008 BCG-CORONA Trial
"""

import pandas as pd
import numpy as np
from statsmodels.miscmodels.ordinal_model import OrderedModel

def main():
    # 1. Load data
    dm = pd.read_csv('data/TASK008_BCG-CORONA_DM.csv')
    ae = pd.read_csv('data/TASK008_BCG-CORONA_AE.csv')
    mh = pd.read_csv('data/TASK008_BCG-CORONA_MH.csv')

    # 2. Derive MHONGO count per participant
    mh_ongoing = mh[mh['MHONGO'] == 'Yes'].groupby('USUBJID').size().rename('MHONGO_count')
    df = dm.merge(mh_ongoing, on='USUBJID', how='left')
    df['MHONGO_count'] = df['MHONGO_count'].fillna(0).astype(int)

    # 3. Derive COVID-19 severity outcomes from adverse events
    covid_events = ae[ae['AEPT'].str.contains('COVID|SARS', case=False, na=False)].copy()
    
    # AEHS: WHO ordinal health status scale (0-7)
    max_aehs = covid_events.groupby('USUBJID')['AEHS'].max().rename('covid_severity_aehs')
    # AESEV: Adverse event severity grade (1-4)
    max_aesev = covid_events.groupby('USUBJID')['AESEV'].max().rename('covid_severity_aesev')

    df = df.merge(max_aehs, on='USUBJID', how='left')
    df = df.merge(max_aesev, on='USUBJID', how='left')

    df['covid_severity_aehs_full'] = df['covid_severity_aehs'].fillna(0).astype(int)
    df['covid_severity_aesev_full'] = df['covid_severity_aesev'].fillna(0).astype(int)

    # 4. Primary Model
    # Cumulative logit ordinal regression on full cohort (N=1000) using WHO Health Status (AEHS)
    # Controlled for BCG vaccination (TRTGRP) and patient interaction variables (patients_seen, expect_interact)
    covars = ['TRTGRP', 'patients_seen', 'expect_interact']
    X_prim = pd.get_dummies(df[['MHONGO_count'] + covars], drop_first=True, dtype=float)
    y_prim = df['covid_severity_aehs_full']

    mod_prim = OrderedModel(y_prim, X_prim, distr='logit')
    res_prim = mod_prim.fit(method='bfgs', maxiter=2000, disp=False)

    beta = res_prim.params['MHONGO_count']
    se = res_prim.bse['MHONGO_count']
    p_val = res_prim.pvalues['MHONGO_count']
    odds_ratio = np.exp(beta)
    pct_increase = (odds_ratio - 1) * 100

    ci_lower_or = np.exp(beta - 1.96 * se)
    ci_upper_or = np.exp(beta + 1.96 * se)
    ci_lower_pct = (ci_lower_or - 1) * 100
    ci_upper_pct = (ci_upper_or - 1) * 100

    print("=" * 60)
    print("ORDINAL REGRESSION RESULTS (PRIMARY MODEL)")
    print("=" * 60)
    print(res_prim.summary())
    print("\n" + "=" * 60)
    print(f"Effect of each additional ongoing medical condition (MHONGO):")
    print(f"  Log-odds coefficient (Beta): {beta:.4f} (SE: {se:.4f}, z = {beta/se:.3f}, p = {p_val:.4e})")
    print(f"  Adjusted Odds Ratio (OR):   {odds_ratio:.4f} (95% CI: [{ci_lower_or:.4f}, {ci_upper_or:.4f}])")
    print(f"  Percentage Increase in Odds: {pct_increase:.2f}% (95% CI: [{ci_lower_pct:.2f}%, {ci_upper_pct:.2f}%])")
    print("=" * 60)

    # 5. Sensitivity Models
    # Model S1: Adding work_hours
    X_s1 = pd.get_dummies(df[['MHONGO_count', 'TRTGRP', 'patients_seen', 'expect_interact', 'work_hours']], drop_first=True, dtype=float)
    res_s1 = OrderedModel(y_prim, X_s1, distr='logit').fit(method='bfgs', maxiter=2000, disp=False)
    b_s1 = res_s1.params['MHONGO_count']
    or_s1 = np.exp(b_s1)
    pct_s1 = (or_s1 - 1) * 100
    print(f"Sensitivity Model 1 (+ work_hours): OR = {or_s1:.4f}, Increase = {pct_s1:.2f}% (p = {res_s1.pvalues['MHONGO_count']:.4e})")

    # Model S2: AESEV grade (0-4)
    y_aesev = df['covid_severity_aesev_full']
    res_s2 = OrderedModel(y_aesev, X_prim, distr='logit').fit(method='bfgs', maxiter=2000, disp=False)
    b_s2 = res_s2.params['MHONGO_count']
    or_s2 = np.exp(b_s2)
    pct_s2 = (or_s2 - 1) * 100
    print(f"Sensitivity Model 2 (AESEV outcome): OR = {or_s2:.4f}, Increase = {pct_s2:.2f}% (p = {res_s2.pvalues['MHONGO_count']:.4e})")

    # Model S3: Infected subgroup (N=197)
    df_pos = df.dropna(subset=['covid_severity_aehs']).copy()
    X_pos = pd.get_dummies(df_pos[['MHONGO_count'] + covars], drop_first=True, dtype=float)
    y_pos = df_pos['covid_severity_aehs'].astype(int)
    res_s3 = OrderedModel(y_pos, X_pos, distr='logit').fit(method='bfgs', maxiter=2000, disp=False)
    b_s3 = res_s3.params['MHONGO_count']
    or_s3 = np.exp(b_s3)
    pct_s3 = (or_s3 - 1) * 100
    print(f"Sensitivity Model 3 (COVID+ cases only): OR = {or_s3:.4f}, Increase = {pct_s3:.2f}% (p = {res_s3.pvalues['MHONGO_count']:.4e})")

if __name__ == '__main__':
    main()
