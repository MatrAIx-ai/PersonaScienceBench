import os
import sys
import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf
from scipy import stats

def run_analysis():
    data_path = 'data/data.xlsx'
    df = pd.read_excel(data_path)
    
    # Filter valid rows (Sequence numbers 1 to 80)
    df = df.iloc[:80].copy()
    
    # Validate cohort size
    assert len(df) == 80, f"Expected 80 rows, got {len(df)}"
    
    # Binary response definition: Group 1 (PR, response) = 1, Group 2 (SD/PD, non-response) = 0
    df['response'] = (df['Groups'] == 1.0).astype(int)
    
    # Format Age as numeric
    df['Age'] = pd.to_numeric(df['Age'], errors='coerce')
    
    # Clean column names for formulas
    clean_cols = {col: col.replace(' ', '_').replace('-', '_') for col in df.columns}
    df = df.rename(columns=clean_cols)
    
    print("=" * 60)
    print("LOGISTIC REGRESSION ANALYSIS: BMI AND TREATMENT RESPONSE")
    print("=" * 60)
    print(f"Sample size: N = {len(df)}")
    print(f"Responders (PR, Group 1): {df['response'].sum()} ({df['response'].mean()*100:.1f}%)")
    print(f"Non-responders (SD/PD, Group 2): {len(df) - df['response'].sum()} ({(1 - df['response'].mean())*100:.1f}%)")
    print(f"BMI summary: Mean={df['BMI'].mean():.2f}, SD={df['BMI'].std():.2f}, Median={df['BMI'].median():.2f}, Range=[{df['BMI'].min():.1f}, {df['BMI'].max():.1f}]")
    print("-" * 60)
    
    # 1. Primary Model: Univariate Logistic Regression
    uni_model = smf.logit('response ~ BMI', data=df).fit()
    print("\n--- Model 1: Univariate Logistic Regression (response ~ BMI) ---")
    print(uni_model.summary())
    
    bmi_coef = uni_model.params['BMI']
    bmi_se = uni_model.bse['BMI']
    bmi_z = uni_model.tvalues['BMI']
    bmi_wald_p = uni_model.pvalues['BMI']
    bmi_or = np.exp(bmi_coef)
    ci_low, ci_high = np.exp(uni_model.conf_int().loc['BMI'])
    
    # Likelihood Ratio Test for univariate model
    null_model = smf.logit('response ~ 1', data=df).fit()
    lr_stat = -2 * (null_model.llf - uni_model.llf)
    lr_p = stats.chi2.sf(lr_stat, df=1)
    
    print("\n[Univariate Model Results for BMI]")
    print(f"Coefficient: {bmi_coef:.4f}")
    print(f"Odds Ratio: {bmi_or:.4f} (95% CI: {ci_low:.4f} - {ci_high:.4f})")
    print(f"Standard Error: {bmi_se:.4f}")
    print(f"z-statistic: {bmi_z:.4f}")
    print(f"Wald p-value: {bmi_wald_p:.6f} (rounded: {bmi_wald_p:.4f})")
    print(f"LR Test stat: {lr_stat:.4f}, LR p-value: {lr_p:.6f} (rounded: {lr_p:.4f})")
    
    # 2. Multivariable Logistic Regression
    multi_formula = ('response ~ BMI + Age + C(Gender) + C(ECOG_PS) + '
                     'C(Child_Pugh) + C(Chemotherapy_experience) + '
                     'C(HBV_infection) + C(Family_history)')
    multi_model = smf.logit(multi_formula, data=df).fit()
    print("\n--- Model 2: Multivariable Logistic Regression ---")
    print(multi_model.summary())
    
    multi_bmi_coef = multi_model.params['BMI']
    multi_bmi_se = multi_model.bse['BMI']
    multi_bmi_z = multi_model.tvalues['BMI']
    multi_bmi_wald_p = multi_model.pvalues['BMI']
    multi_bmi_or = np.exp(multi_bmi_coef)
    m_ci_low, m_ci_high = np.exp(multi_model.conf_int().loc['BMI'])
    
    print("\n[Multivariable Model Results for BMI]")
    print(f"Adjusted Coefficient: {multi_bmi_coef:.4f}")
    print(f"Adjusted Odds Ratio: {multi_bmi_or:.4f} (95% CI: {m_ci_low:.4f} - {m_ci_high:.4f})")
    print(f"Standard Error: {multi_bmi_se:.4f}")
    print(f"z-statistic: {multi_bmi_z:.4f}")
    print(f"Wald p-value (adjusted): {multi_bmi_wald_p:.6f} (rounded: {multi_bmi_wald_p:.4f})")
    
    print("\n" + "=" * 60)
    print("PRIMARY CONCLUSION:")
    print(f"Univariate logistic regression Wald p-value for BMI: {bmi_wald_p:.4f} (exact: {bmi_wald_p:.6f})")
    print(f"Univariate logistic regression LRT p-value for BMI: {lr_p:.4f} (exact: {lr_p:.6f})")
    print(f"Multivariable adjusted Wald p-value for BMI: {multi_bmi_wald_p:.4f} (exact: {multi_bmi_wald_p:.6f})")
    print("=" * 60)

if __name__ == '__main__':
    run_analysis()
