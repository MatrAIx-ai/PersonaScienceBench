import pandas as pd
import numpy as np
from statsmodels.miscmodels.ordinal_model import OrderedModel

def main():
    print("=" * 80)
    print("BCG-CORONA Trial: Ordinal Regression Analysis")
    print("Interaction between BCG Vaccination and Prior Medical History on COVID-19 Severity")
    print("=" * 80)

    # 1. Load Data
    dm_path = 'data/TASK008_BCG-CORONA_DM.csv'
    ae_path = 'data/TASK008_BCG-CORONA_AE.csv'
    mh_path = 'data/TASK008_BCG-CORONA_MH.csv'

    dm = pd.read_csv(dm_path)
    ae = pd.read_csv(ae_path)
    mh = pd.read_csv(mh_path)

    # 2. Variable Operationalization
    # BCG status: 1 = BCG, 0 = Placebo
    dm['bcg'] = (dm['TRTGRP'] == 'BCG').astype(int)

    # Medical History:
    # Any reported condition where MHORRES == 2.0 (Yes) under MHSCAT == 'MEDICAL HISTORY'
    med = mh[mh['MHSCAT'] == 'MEDICAL HISTORY']
    has_mh = med[med['MHORRES'] == 2.0]['USUBJID'].unique()
    dm['has_mh'] = dm['USUBJID'].isin(has_mh).astype(int)

    # Standardized 16 conditions
    terms = med.groupby('MHTERM')['MHORRES'].value_counts().unstack().fillna(0)
    std_terms = terms[(terms[1.0] + terms[2.0]) == 1000].index
    has_mh_std = med[(med['MHORRES'] == 2.0) & (med['MHTERM'].isin(std_terms))]['USUBJID'].unique()
    dm['has_mh_std'] = dm['USUBJID'].isin(has_mh_std).astype(int)

    # COVID-19 Severity:
    # Max AEHS across COVID-related records
    covid_ae = ae[ae['AEPT'].str.contains('COVID|SARS|corona', case=False, na=False)]
    covid_sev = covid_ae.groupby('USUBJID')['AEHS'].max().reset_index().rename(columns={'AEHS': 'covid_sev'})
    dm = dm.merge(covid_sev, on='USUBJID', how='left')

    # Primary analysis cohort: COVID-19 positive individuals
    df_covid = dm.dropna(subset=['covid_sev']).copy()
    df_covid['covid_sev'] = df_covid['covid_sev'].astype(int)

    # Patients seen
    patients_seen_cats = ['1-50', '51-100', '>100']
    df_covid['patients_seen'] = pd.Categorical(df_covid['patients_seen'], categories=patients_seen_cats, ordered=False)
    dm['patients_seen'] = pd.Categorical(dm['patients_seen'], categories=patients_seen_cats, ordered=False)

    mapping = {'1-50': 1, '51-100': 2, '>100': 3}
    df_covid['patients_seen_num'] = df_covid['patients_seen'].map(mapping).astype(float)
    dm['patients_seen_num'] = dm['patients_seen'].map(mapping).astype(float)

    print(f"\nCohort Overview:")
    print(f"Total Trial Participants: {len(dm)}")
    print(f"COVID-19 Positive Cases: {len(df_covid)}")
    print("\nOutcome Distribution (AEHS in COVID-19 cases):")
    print(df_covid['covid_sev'].value_counts().sort_index())

    print("\nCross-tabulation (BCG x Prior Medical History in COVID-19 cases):")
    ct = pd.crosstab(df_covid['bcg'].map({0: 'Placebo', 1: 'BCG'}), 
                     df_covid['has_mh'].map({0: 'No Prior MH', 1: 'Prior MH'}))
    print(ct)

    # 3. Primary Ordinal Regression Model
    print("\n" + "=" * 80)
    print("PRIMARY MODEL: COVID-19 Cases (N=197)")
    print("Formula: covid_sev ~ bcg + has_mh + bcg:has_mh + C(patients_seen, Treatment(reference='1-50'))")
    print("=" * 80)

    mod_primary = OrderedModel.from_formula(
        'covid_sev ~ bcg + has_mh + bcg:has_mh + C(patients_seen, Treatment(reference=\"1-50\"))',
        data=df_covid,
        distr='logit'
    )
    res_primary = mod_primary.fit(method='bfgs', disp=False)
    print(res_primary.summary())

    params = res_primary.params
    bse = res_primary.bse
    pvalues = res_primary.pvalues
    conf = res_primary.conf_int()

    print("\nPrimary Model Parameter Estimates:")
    for var in ['bcg', 'has_mh', 'bcg:has_mh', 'C(patients_seen, Treatment(reference="1-50"))[T.51-100]', 'C(patients_seen, Treatment(reference="1-50"))[T.>100]']:
        c = params[var]
        se = bse[var]
        p = pvalues[var]
        or_val = np.exp(c)
        ci_l = np.exp(conf.loc[var, 0])
        ci_u = np.exp(conf.loc[var, 1])
        print(f"  {var:40s}: Coef = {c:8.4f}, SE = {se:6.4f}, p = {p:6.4f}, OR = {or_val:6.4f} (95% CI: {ci_l:6.4f} - {ci_u:6.4f})")

    # 4. Sensitivity Analyses
    print("\n" + "=" * 80)
    print("SENSITIVITY ANALYSES")
    print("=" * 80)

    # Sensitivity 1: Standard 16 conditions in COVID cases
    mod_s1 = OrderedModel.from_formula(
        'covid_sev ~ bcg * has_mh_std + C(patients_seen, Treatment(reference=\"1-50\"))',
        data=df_covid,
        distr='logit'
    )
    res_s1 = mod_s1.fit(method='bfgs', disp=False)
    var = 'bcg:has_mh_std'
    c, se, p = res_s1.params[var], res_s1.bse[var], res_s1.pvalues[var]
    ci = res_s1.conf_int().loc[var]
    print(f"1. Standard MH (16 items) in COVID cases: Coef = {c:.4f}, SE = {se:.4f}, p = {p:.4f}, OR = {np.exp(c):.4f} (95% CI: {np.exp(ci[0]):.4f} - {np.exp(ci[1]):.4f})")

    # Sensitivity 2: Ordinal numeric interaction frequency in COVID cases
    mod_s2 = OrderedModel.from_formula(
        'covid_sev ~ bcg * has_mh + patients_seen_num',
        data=df_covid,
        distr='logit'
    )
    res_s2 = mod_s2.fit(method='bfgs', disp=False)
    var = 'bcg:has_mh'
    c, se, p = res_s2.params[var], res_s2.bse[var], res_s2.pvalues[var]
    ci = res_s2.conf_int().loc[var]
    print(f"2. Numeric patients_seen in COVID cases:   Coef = {c:.4f}, SE = {se:.4f}, p = {p:.4f}, OR = {np.exp(c):.4f} (95% CI: {np.exp(ci[0]):.4f} - {np.exp(ci[1]):.4f})")

    # Sensitivity 3: Full cohort (N=1000, uninfected=0)
    dm['full_sev'] = dm['covid_sev'].fillna(0).astype(int)
    mod_s3 = OrderedModel.from_formula(
        'full_sev ~ bcg * has_mh + C(patients_seen, Treatment(reference=\"1-50\"))',
        data=dm,
        distr='logit'
    )
    res_s3 = mod_s3.fit(method='bfgs', disp=False)
    var = 'bcg:has_mh'
    c, se, p = res_s3.params[var], res_s3.bse[var], res_s3.pvalues[var]
    ci = res_s3.conf_int().loc[var]
    print(f"3. Full cohort (N=1000, uninfected=0):     Coef = {c:.4f}, SE = {se:.4f}, p = {p:.4f}, OR = {np.exp(c):.4f} (95% CI: {np.exp(ci[0]):.4f} - {np.exp(ci[1]):.4f})")

    # Sensitivity 4: Full cohort with standard 16 conditions
    mod_s4 = OrderedModel.from_formula(
        'full_sev ~ bcg * has_mh_std + C(patients_seen, Treatment(reference=\"1-50\"))',
        data=dm,
        distr='logit'
    )
    res_s4 = mod_s4.fit(method='bfgs', disp=False)
    var = 'bcg:has_mh_std'
    c, se, p = res_s4.params[var], res_s4.bse[var], res_s4.pvalues[var]
    ci = res_s4.conf_int().loc[var]
    print(f"4. Full cohort + Standard MH (16 items):   Coef = {c:.4f}, SE = {se:.4f}, p = {p:.4f}, OR = {np.exp(c):.4f} (95% CI: {np.exp(ci[0]):.4f} - {np.exp(ci[1]):.4f})")

    print("\n" + "=" * 80)
    print("EXECUTION COMPLETED SUCCESSFULLY")
    print("=" * 80)

if __name__ == '__main__':
    main()
