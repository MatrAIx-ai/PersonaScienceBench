"""Analysis module for Levin context grid search policy."""

from __future__ import annotations
from collections import defaultdict, Counter
from typing import Any, Dict, List, Optional


MOVES = {
    "U": (-1, 0),
    "D": (1, 0),
    "L": (0, -1),
    "R": (0, 1),
}

OPPOSITE = {
    "U": "D",
    "D": "U",
    "L": "R",
    "R": "L",
}

ACTION_ORDER = ["U", "D", "L", "R"]


def _get_neighbor_cell(neighbors: Any, action: str) -> Optional[str]:
    """Safely extracts the neighboring cell symbol for a candidate action."""
    if isinstance(neighbors, dict):
        return neighbors.get(action)
    if isinstance(neighbors, (list, tuple)) and len(neighbors) == 4:
        idx_map = {"U": 0, "D": 1, "L": 2, "R": 3}
        idx = idx_map.get(action)
        if idx is not None and 0 <= idx < len(neighbors):
            return neighbors[idx]
    return None


class Policy:
    """Action-selection policy guided by deterministic corridor dynamics and learned turn priors."""

    def __init__(self, training_data: Optional[Dict[str, Any]] = None, config: Optional[Dict[str, Any]] = None):
        self.config = config or {}
        self.turn_counts: Dict[tuple, Counter] = defaultdict(Counter)
        self.cell_counts: Counter = Counter()

        # Calibration parameters
        self.eps = float(self.config.get("eps", 0.015))
        self.blend = float(self.config.get("blend", 0.20))

        if training_data and "levels" in training_data:
            self._fit(training_data["levels"])

    def _fit(self, levels: List[Dict[str, Any]]) -> None:
        """Extracts transition and turn frequencies from successful training trajectories."""
        for lvl in levels:
            grid = lvl.get("grid")
            sol = lvl.get("solution")
            start = lvl.get("start")
            if not grid or not sol or not start:
                continue

            h, w = len(grid), len(grid[0])
            y, x = start[0], start[1]
            prev_a = None

            for a in sol:
                cell = grid[y][x]
                self.cell_counts[cell] += 1

                legal = [
                    act
                    for act, (dy, dx) in MOVES.items()
                    if 0 <= y + dy < h and 0 <= x + dx < w and grid[y + dy][x + dx] != "#"
                ]

                if prev_a is not None and prev_a not in legal:
                    self.turn_counts[(cell, prev_a)][a] += 1

                dy, dx = MOVES.get(a, (0, 0))
                y, x = y + dy, x + dx
                prev_a = a

    def action_probs(
        self, level: Dict[str, Any], state: Dict[str, Any], legal_actions: List[str]
    ) -> Dict[str, float]:
        """Calculates nonnegative action probabilities for the given state and legal actions."""
        if not legal_actions:
            return {}

        if len(legal_actions) == 1:
            return {legal_actions[0]: 1.0}

        # Safe extraction of state observations
        state_dict = state if isinstance(state, dict) else {}
        cell = state_dict.get("cell")
        neighbors = state_dict.get("neighbors")
        prev_a = state_dict.get("previous_action")

        # Fallback for previous_action using history or history_tail
        if prev_a is None or prev_a == "":
            hist = state_dict.get("history") or state_dict.get("history_tail")
            if isinstance(hist, (list, tuple)) and len(hist) > 0:
                prev_a = hist[-1]

        # Rule 1: Goal adjacency check
        for a in legal_actions:
            if _get_neighbor_cell(neighbors, a) == "G":
                p_goal = 1.0 - 0.001 * (len(legal_actions) - 1)
                p_other = 0.001
                return {act: (p_goal if act == a else p_other) for act in legal_actions}

        # Rule 2: Start action determination (deterministic mapping)
        depth = state_dict.get("depth")
        is_start = (prev_a is None or prev_a == "") or (depth == 0)
        if is_start and cell and isinstance(cell, str) and "a" <= cell <= "t":
            fav_action = ACTION_ORDER[(ord(cell) - ord("a")) % 4]
            if fav_action in legal_actions:
                p_main = 1.0 - self.eps
                p_rem = self.eps / max(1, len(legal_actions) - 1)
                return {act: (p_main if act == fav_action else p_rem) for act in legal_actions}

        # Rule 3: Straight continuation (100% training consistency)
        if prev_a in legal_actions:
            p_main = 1.0 - self.eps
            p_rem = self.eps / max(1, len(legal_actions) - 1)
            return {act: (p_main if act == prev_a else p_rem) for act in legal_actions}

        # Rule 4: Forced turn (previous_action hit a wall or is illegal)
        rev = OPPOSITE.get(prev_a)
        non_rev = [a for a in legal_actions if a != rev]

        if not non_rev:
            # Dead end where only reversal is legal
            uniform_p = 1.0 / len(legal_actions)
            return {act: uniform_p for act in legal_actions}

        if len(non_rev) == 1:
            fav = non_rev[0]
            p_main = 1.0 - self.eps
            p_rem = self.eps / max(1, len(legal_actions) - 1)
            return {act: (p_main if act == fav else p_rem) for act in legal_actions}

        # Multiple perpendicular choices (usually 2): calibrate with smoothed empirical counts
        c_sub = self.turn_counts.get((cell, prev_a), Counter())
        tot_sub = sum(c_sub.values())

        if tot_sub > 0 and self.blend > 0:
            smoothed = {a: (c_sub.get(a, 0) + 1.0) / (tot_sub + len(non_rev)) for a in non_rev}
            tot_smooth = sum(smoothed.values())
            weights = {
                a: (1.0 - self.blend) * (1.0 / len(non_rev)) + self.blend * (smoothed[a] / tot_smooth)
                for a in non_rev
            }
        else:
            weights = {a: 1.0 / len(non_rev) for a in non_rev}

        p_non_rev_total = 1.0 - self.eps
        rev_count = len(legal_actions) - len(non_rev)
        p_rev_each = (self.eps / rev_count) if rev_count > 0 else 0.0

        probs = {}
        for act in legal_actions:
            if act in non_rev:
                probs[act] = p_non_rev_total * weights[act]
            else:
                probs[act] = p_rev_each

        # Ensure strict normalization
        total_p = sum(probs.values())
        if total_p > 0:
            return {act: val / total_p for act, val in probs.items()}
        return {act: 1.0 / len(legal_actions) for act in legal_actions}


def make_policy(training_data: Dict[str, Any], config: Optional[Dict[str, Any]] = None) -> Policy:
    """Factory function instantiating the Policy."""
    return Policy(training_data=training_data, config=config)
