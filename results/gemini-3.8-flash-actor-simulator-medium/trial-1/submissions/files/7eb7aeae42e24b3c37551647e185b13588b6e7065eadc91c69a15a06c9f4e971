import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf
from scipy import stats

def run_analysis():
    # 1. Load data
    file_path = 'data/data.xlsx'
    df = pd.read_excel(file_path)
    
    # 2. Filter valid patient observations (rows 0 to 79, N=80)
    # The subsequent rows (80-120) are empty trailing Excel artifact rows
    df = df.iloc[:80].copy()
    
    # Clean data types
    df['Age'] = df['Age'].astype(float)
    df['BMI'] = df['BMI'].astype(float)
    
    # Define binary treatment response: PR (Group 1) = 1, SD/PD (Group 2) = 0
    df['response'] = (df['Efficacy'] == 'PR').astype(int)
    
    # 3. Univariate Logistic Regression: response ~ BMI
    model_uni = smf.logit('response ~ BMI', data=df).fit(disp=False)
    
    # Extract univariate metrics
    coef_uni = model_uni.params['BMI']
    se_uni = model_uni.bse['BMI']
    z_uni = model_uni.tvalues['BMI']
    p_wald_uni = model_uni.pvalues['BMI']
    
    # Likelihood Ratio Test for univariate model
    null_model = smf.logit('response ~ 1', data=df).fit(disp=False)
    lr_stat = -2 * (null_model.llf - model_uni.llf)
    p_lrt_uni = stats.chi2.sf(lr_stat, df=1)
    
    # 4. Multivariate Logistic Regression adjusting for clinical covariates
    df_clean = df.copy()
    df_clean.columns = [c.replace(' ', '_').replace('-', '_') for c in df_clean.columns]
    formula_multi = (
        'response ~ BMI + Age + Gender + Family_history + ECOG_PS + '
        'Child_Pugh + Chemotherapy_experience + HBV_infection'
    )
    model_multi = smf.logit(formula_multi, data=df_clean).fit(disp=False)
    p_wald_multi = model_multi.pvalues['BMI']
    
    print("=" * 60)
    print("LOGISTIC REGRESSION ANALYSIS RESULTS")
    print("=" * 60)
    print("Univariate Logistic Regression (response ~ BMI):")
    print(f"  BMI Coefficient: {coef_uni:.6f}")
    print(f"  Standard Error:  {se_uni:.6f}")
    print(f"  Wald z-statistic: {z_uni:.6f}")
    print(f"  Wald p-value:    {p_wald_uni:.6f} (approx {p_wald_uni:.4f})")
    print(f"  LRT statistic:   {lr_stat:.6f}")
    print(f"  LRT p-value:     {p_lrt_uni:.6f} (approx {p_lrt_uni:.4f})")
    print("-" * 60)
    print("Multivariate Logistic Regression (adjusting for clinical covariates):")
    print(f"  BMI Wald p-value: {p_wald_multi:.6f} (approx {p_wald_multi:.4f})")
    print("=" * 60)
    print(f"Primary Answer (Univariate Wald p-value): {p_wald_uni:.4f} ({p_wald_uni:.6f})")

if __name__ == '__main__':
    run_analysis()
