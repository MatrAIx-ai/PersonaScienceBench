import time
import numpy as np
from scipy.fft import dst, idst

def main():
    total_start = time.time()
    N = 135
    dx = 1.0 / N
    dt_frame = 0.1
    CFL = 1.8797
    num_frames = 107
    
    target_vort_frames = [0, 26, 52, 78, 104]
    vorticity_frames = np.zeros((len(target_vort_frames), N, N), dtype=np.float32)
    kinetic_energy = np.zeros(num_frames + 1, dtype=np.float32)
    
    ux = np.load('data/initial_u_x.npy').astype(np.float64)
    uy = np.load('data/initial_u_y.npy').astype(np.float64)
    
    i_idx = np.arange(1, N)[:, None]
    j_idx = np.arange(1, N)[None, :]
    evals = (2.0 * (np.cos(i_idx * np.pi / N) - 1.0) + 2.0 * (np.cos(j_idx * np.pi / N) - 1.0)) / (dx**2)
    
    def solve_poisson(wn):
        b = -wn[1:-1, 1:-1]
        b_hat = dst(dst(b, type=1, axis=0), type=1, axis=1)
        psi_hat = b_hat / evals
        psi_int = idst(idst(psi_hat, type=1, axis=0), type=1, axis=1)
        psi = np.zeros((N + 1, N + 1), dtype=np.float64)
        psi[1:-1, 1:-1] = psi_int
        return psi

    def face_velocities(psi):
        u_face = (psi[:, 1:] - psi[:, :-1]) / dx
        v_face = -(psi[1:, :] - psi[:-1, :]) / dx
        return u_face, v_face

    def nodal_vorticity(u_face, v_face):
        wn = np.zeros((N + 1, N + 1), dtype=np.float64)
        wn[1:-1, 1:-1] = (v_face[1:, 1:-1] - v_face[:-1, 1:-1]) / dx - (u_face[1:-1, 1:] - u_face[1:-1, :-1]) / dx
        return wn

    def nodal_velocities(psi):
        un = np.zeros((N + 1, N + 1), dtype=np.float64)
        vn = np.zeros((N + 1, N + 1), dtype=np.float64)
        un[1:-1, 1:-1] = (psi[1:-1, 2:] - psi[1:-1, :-2]) / (2.0 * dx)
        vn[1:-1, 1:-1] = -(psi[2:, 1:-1] - psi[:-2, 1:-1]) / (2.0 * dx)
        vn[0, 1:-1] = -psi[1, 1:-1] / dx
        vn[-1, 1:-1] = psi[-2, 1:-1] / dx
        un[1:-1, 0] = psi[1:-1, 1] / dx
        un[1:-1, -1] = -psi[1:-1, -2] / dx
        return un, vn

    def get_bspline_weights(pos):
        s_x = pos[:, 0] / dx
        s_y = pos[:, 1] / dx
        bx = np.round(s_x).astype(np.int32)
        by = np.round(s_y).astype(np.int32)
        dx_rel = s_x - bx
        dy_rel = s_y - by
        
        wx = np.stack([0.5 * (0.5 - dx_rel)**2, 0.75 - dx_rel**2, 0.5 * (0.5 + dx_rel)**2], axis=-1)
        dwx = np.stack([(dx_rel - 0.5) / dx, (-2.0 * dx_rel) / dx, (0.5 + dx_rel) / dx], axis=-1)
        
        wy = np.stack([0.5 * (0.5 - dy_rel)**2, 0.75 - dy_rel**2, 0.5 * (0.5 + dy_rel)**2], axis=-1)
        dwy = np.stack([(dy_rel - 0.5) / dx, (-2.0 * dy_rel) / dx, (0.5 + dy_rel) / dx], axis=-1)
        
        return bx, by, wx, dwx, wy, dwy

    def interp_scalar_and_grad(pos, field):
        bx, by, wx, dwx, wy, dwy = get_bspline_weights(pos)
        val = np.zeros(len(pos), dtype=np.float64)
        grad_x = np.zeros(len(pos), dtype=np.float64)
        grad_y = np.zeros(len(pos), dtype=np.float64)
        
        for a in range(3):
            ix = np.clip(bx + a - 1, 0, N)
            for b in range(3):
                iy = np.clip(by + b - 1, 0, N)
                W = wx[:, a] * wy[:, b]
                Wx = dwx[:, a] * wy[:, b]
                Wy = wx[:, a] * dwy[:, b]
                f = field[ix, iy]
                val += f * W
                grad_x += f * Wx
                grad_y += f * Wy
        return val, np.stack([grad_x, grad_y], axis=-1)

    def eval_vec(pos, un, vn):
        bx, by, wx, dwx, wy, dwy = get_bspline_weights(pos)
        u_p = np.zeros(len(pos), dtype=np.float64)
        v_p = np.zeros(len(pos), dtype=np.float64)
        
        for a in range(3):
            ix = np.clip(bx + a - 1, 0, N)
            w_a = wx[:, a]
            for b in range(3):
                iy = np.clip(by + b - 1, 0, N)
                W = w_a * wy[:, b]
                u_p += un[ix, iy] * W
                v_p += vn[ix, iy] * W
                
        return np.stack([u_p, v_p], axis=-1)

    def eval_vec_and_grad(pos, un, vn):
        bx, by, wx, dwx, wy, dwy = get_bspline_weights(pos)
        u_p = np.zeros(len(pos), dtype=np.float64)
        v_p = np.zeros(len(pos), dtype=np.float64)
        ux_p = np.zeros(len(pos), dtype=np.float64)
        uy_p = np.zeros(len(pos), dtype=np.float64)
        vx_p = np.zeros(len(pos), dtype=np.float64)
        vy_p = np.zeros(len(pos), dtype=np.float64)
        
        for a in range(3):
            ix = np.clip(bx + a - 1, 0, N)
            w_a = wx[:, a]
            dw_a = dwx[:, a]
            for b in range(3):
                iy = np.clip(by + b - 1, 0, N)
                w_b = wy[:, b]
                dw_b = dwy[:, b]
                
                W = w_a * w_b
                Wx = dw_a * w_b
                Wy = w_a * dw_b
                
                u_node = un[ix, iy]
                v_node = vn[ix, iy]
                
                u_p += u_node * W
                v_p += v_node * W
                ux_p += u_node * Wx
                uy_p += u_node * Wy
                vx_p += v_node * Wx
                vy_p += v_node * Wy
                
        vel = np.stack([u_p, v_p], axis=-1)
        grad_u = np.zeros((len(pos), 2, 2), dtype=np.float64)
        grad_u[:, 0, 0] = ux_p
        grad_u[:, 0, 1] = uy_p
        grad_u[:, 1, 0] = vx_p
        grad_u[:, 1, 1] = vy_p
        return vel, grad_u

    def compute_diagnostics(u_face, v_face):
        uc = 0.5 * (u_face[:-1, :] + u_face[1:, :])
        vc = 0.5 * (v_face[:, :-1] + v_face[:, 1:])
        ke = 0.5 * (dx**2) * np.sum(uc**2 + vc**2)
        
        i_plus = np.clip(np.arange(N) + 1, 0, N - 1)
        i_minus = np.clip(np.arange(N) - 1, 0, N - 1)
        j_plus = np.clip(np.arange(N) + 1, 0, N - 1)
        j_minus = np.clip(np.arange(N) - 1, 0, N - 1)
        
        dv_dx = (vc[i_plus, :] - vc[i_minus, :]) / (2.0 * dx)
        du_dy = (uc[:, j_plus] - uc[:, j_minus]) / (2.0 * dx)
        omega = dv_dx - du_dy
        return ke, omega

    P_cell = 4
    coords = (np.arange(N * P_cell) + 0.5) * (dx / P_cell)
    px, py = np.meshgrid(coords, coords, indexing='ij')
    base_pos = np.stack([px.ravel(), py.ravel()], axis=-1)
    P = len(px.ravel())
    
    gx, gy = np.meshgrid(np.arange(N + 1) * dx, np.arange(N + 1) * dx, indexing='ij')
    grid_pts = np.stack([gx.ravel(), gy.ravel()], axis=-1)
    
    ke0, omega0 = compute_diagnostics(ux, uy)
    kinetic_energy[0] = ke0
    vorticity_frames[0] = omega0.astype(np.float32)
    print(f"Frame 0: KE = {ke0:.8e}, max|omega| = {np.abs(omega0).max():.4f}")
    
    wn = nodal_vorticity(ux, uy)
    psi = solve_poisson(wn)
    ux, uy = face_velocities(psi)
    wn = nodal_vorticity(ux, uy)
    un, vn = nodal_velocities(psi)

    for frame in range(1, num_frames + 1):
        frame_start = time.time()
        t_frame = 0.0
        substeps = 0
        
        while t_frame < dt_frame - 1e-12:
            dt_rem = dt_frame - t_frame
            u_max = max(float(np.max(np.abs(ux))), float(np.max(np.abs(uy))))
            dt = min(CFL * dx / max(u_max, 1e-12), dt_rem)
            
            tau = 0.5 * dt
            x0 = grid_pts
            k1 = eval_vec(np.clip(x0, 0.5 * dx, 1.0 - 0.5 * dx), un, vn)
            k2 = eval_vec(np.clip(x0 - 0.5 * tau * k1, 0.5 * dx, 1.0 - 0.5 * dx), un, vn)
            k3 = eval_vec(np.clip(x0 - 0.5 * tau * k2, 0.5 * dx, 1.0 - 0.5 * dx), un, vn)
            k4 = eval_vec(np.clip(x0 - tau * k3, 0.5 * dx, 1.0 - 0.5 * dx), un, vn)
            x_star = np.clip(x0 - (tau / 6.0) * (k1 + 2 * k2 + 2 * k3 + k4), 0.5 * dx, 1.0 - 0.5 * dx)
            
            wn_star_val, _ = interp_scalar_and_grad(x_star, wn)
            wn_mid = wn_star_val.reshape(N + 1, N + 1)
            wn_mid[0, :] = 0; wn_mid[-1, :] = 0; wn_mid[:, 0] = 0; wn_mid[:, -1] = 0
            
            psi_mid = solve_poisson(wn_mid)
            un_mid, vn_mid = nodal_velocities(psi_mid)
            
            w_p, init_C_c = interp_scalar_and_grad(base_pos, wn)
            
            def d_state(p_pos, p_T):
                vel, grad_u = eval_vec_and_grad(p_pos, un_mid, vn_mid)
                gu00 = grad_u[:, 0, 0]
                gu01 = grad_u[:, 1, 0]
                gu10 = grad_u[:, 0, 1]
                gu11 = grad_u[:, 1, 1]
                dT = np.empty_like(p_T)
                dT[:, 0, 0] = -(gu00 * p_T[:, 0, 0] + gu01 * p_T[:, 1, 0])
                dT[:, 0, 1] = -(gu00 * p_T[:, 0, 1] + gu01 * p_T[:, 1, 1])
                dT[:, 1, 0] = -(gu10 * p_T[:, 0, 0] + gu11 * p_T[:, 1, 0])
                dT[:, 1, 1] = -(gu10 * p_T[:, 0, 1] + gu11 * p_T[:, 1, 1])
                return vel, dT

            pos = base_pos.copy()
            T = np.zeros((P, 2, 2), dtype=np.float64)
            T[:, 0, 0] = 1.0
            T[:, 1, 1] = 1.0
            
            k1_x, k1_T = d_state(pos, T)
            x2 = np.clip(pos + 0.5 * dt * k1_x, 0.5 * dx, 1.0 - 0.5 * dx)
            T2 = T + 0.5 * dt * k1_T

            k2_x, k2_T = d_state(x2, T2)
            x3 = np.clip(pos + 0.5 * dt * k2_x, 0.5 * dx, 1.0 - 0.5 * dx)
            T3 = T + 0.5 * dt * k2_T

            k3_x, k3_T = d_state(x3, T3)
            x4 = np.clip(pos + dt * k3_x, 0.5 * dx, 1.0 - 0.5 * dx)
            T4 = T + dt * k3_T

            k4_x, k4_T = d_state(x4, T4)

            pos_new = np.clip(pos + (dt / 6.0) * (k1_x + 2 * k2_x + 2 * k3_x + k4_x), 0.5 * dx, 1.0 - 0.5 * dx)
            T_new = T + (dt / 6.0) * (k1_T + 2 * k2_T + 2 * k3_T + k4_T)
            
            Cc_x = T_new[:, 0, 0] * init_C_c[:, 0] + T_new[:, 1, 0] * init_C_c[:, 1]
            Cc_y = T_new[:, 0, 1] * init_C_c[:, 0] + T_new[:, 1, 1] * init_C_c[:, 1]
            
            bx, by, wx, dwx, wy, dwy = get_bspline_weights(pos_new)
            w_acc = np.zeros((N + 1, N + 1), dtype=np.float64)
            weight_acc = np.zeros((N + 1, N + 1), dtype=np.float64)

            for a in range(3):
                ix = np.clip(bx + a - 1, 0, N)
                w_a = wx[:, a]
                dx_node = (bx + a - 1) * dx - pos_new[:, 0]
                for b in range(3):
                    iy = np.clip(by + b - 1, 0, N)
                    w_b = wy[:, b]
                    dy_node = (by + b - 1) * dx - pos_new[:, 1]
                    
                    W = w_a * w_b
                    val = w_p + Cc_x * dx_node + Cc_y * dy_node
                    
                    flat_idx = ix * (N + 1) + iy
                    np.add.at(w_acc.ravel(), flat_idx, val * W)
                    np.add.at(weight_acc.ravel(), flat_idx, W)

            mask = weight_acc > 1e-14
            wn_new = np.zeros((N + 1, N + 1), dtype=np.float64)
            wn_new[mask] = w_acc[mask] / weight_acc[mask]
            wn_new[0, :] = 0; wn_new[-1, :] = 0; wn_new[:, 0] = 0; wn_new[:, -1] = 0

            psi_new = solve_poisson(wn_new)
            ux, uy = face_velocities(psi_new)
            wn = nodal_vorticity(ux, uy)
            un, vn = nodal_velocities(psi_new)
            
            t_frame += dt
            substeps += 1
            
        ke, omega = compute_diagnostics(ux, uy)
        kinetic_energy[frame] = ke
        
        if frame in target_vort_frames:
            target_idx = target_vort_frames.index(frame)
            vorticity_frames[target_idx] = omega.astype(np.float32)
            
        if frame % 10 == 0 or frame == num_frames:
            elapsed = time.time() - total_start
            print(f"Frame {frame:3d}/{num_frames} ({substeps} substeps, {time.time()-frame_start:.2f}s, total {elapsed:.1f}s): KE = {ke:.8e}, max|omega| = {np.abs(omega).max():.4f}")
            
    np.save('vorticity_frames.npy', vorticity_frames)
    np.save('kinetic_energy.npy', kinetic_energy)
    
    total_time = time.time() - total_start
    print(f"\nSimulation finished in {total_time:.2f} seconds.")
    print(f"Saved vorticity_frames.npy with shape {vorticity_frames.shape}, dtype {vorticity_frames.dtype}")
    print(f"Saved kinetic_energy.npy with shape {kinetic_energy.shape}, dtype {kinetic_energy.dtype}")

if __name__ == '__main__':
    main()
