"""
Analysis script for BCG vaccination status and prior medical history interaction effect
on COVID-19 severity in an ordinal regression model controlling for patient interaction frequency.
Dataset: TASK008 BCG-CORONA Trial
"""

import pandas as pd
import numpy as np
import statsmodels.api as sm
from statsmodels.miscmodels.ordinal_model import OrderedModel

def run_analysis():
    # 1. Load data
    dm = pd.read_csv('data/TASK008_BCG-CORONA_DM.csv')
    ae = pd.read_csv('data/TASK008_BCG-CORONA_AE.csv', low_memory=False)
    mh = pd.read_csv('data/TASK008_BCG-CORONA_MH.csv', low_memory=False)

    print("=== Data loaded successfully ===")
    print(f"DM records: {len(dm)}, AE records: {len(ae)}, MH records: {len(mh)}")

    # 2. Extract COVID-19 cases and peak AEHS
    covid_ae = ae[ae['AEPT'].str.contains('COVID|SARS|corona', case=False, na=False)].copy()
    max_hs = covid_ae.groupby('USUBJID')['AEHS'].max()
    print(f"Total COVID-19 confirmed participants: {len(max_hs)}")
    print("Peak AEHS distribution:")
    print(max_hs.value_counts().sort_index())

    # 3. Extract prior medical history
    mh_med = mh[mh['MHSCAT'] == 'MEDICAL HISTORY']
    mh_pos_subjs = set(mh_med[mh_med['MHORRES'] == 2.0]['USUBJID'])
    print(f"Total subjects with >= 1 prior medical condition: {len(mh_pos_subjs)}")

    # 4. Construct analysis dataset for confirmed COVID-19 cases (N=197)
    df = dm[dm['USUBJID'].isin(max_hs.index)].copy()
    df['y'] = df['USUBJID'].map(max_hs).astype(int)
    df['bcg'] = (df['TRTGRP'] == 'BCG').astype(int)
    df['prior_mh'] = df['USUBJID'].isin(mh_pos_subjs).astype(int)
    df['bcg_x_mh'] = df['bcg'] * df['prior_mh']

    # Dummy variables for patient interaction frequency (patients_seen)
    # Reference category: '1-50'
    df['patients_seen_51_100'] = (df['patients_seen'] == '51-100').astype(float)
    df['patients_seen_gt100'] = (df['patients_seen'] == '>100').astype(float)

    # 5. Fit primary ordinal logistic regression model
    X_main = df[['bcg', 'prior_mh', 'bcg_x_mh', 'patients_seen_51_100', 'patients_seen_gt100']]
    model_main = OrderedModel(df['y'], X_main, distr='logit')
    res_main = model_main.fit(method='bfgs', disp=False)

    print("\n=================== PRIMARY MODEL RESULTS ===================")
    print(res_main.summary())

    beta = res_main.params['bcg_x_mh']
    se = res_main.bse['bcg_x_mh']
    z_stat = res_main.tvalues['bcg_x_mh']
    pval = res_main.pvalues['bcg_x_mh']
    ci_low = res_main.conf_int().loc['bcg_x_mh', 0]
    ci_high = res_main.conf_int().loc['bcg_x_mh', 1]
    or_val = np.exp(beta)
    or_ci_low = np.exp(ci_low)
    or_ci_high = np.exp(ci_high)

    print("\n--- Key Interaction Term (BCG x Prior Medical History) ---")
    print(f"Beta (Coefficient): {beta:.4f}")
    print(f"Standard Error:     {se:.4f}")
    print(f"z-statistic:        {z_stat:.4f}")
    print(f"p-value:            {pval:.4f}")
    print(f"Odds Ratio (OR):    {or_val:.4f}")
    print(f"95% CI for OR:      [{or_ci_low:.4f}, {or_ci_high:.4f}]")

    # 6. Sensitivity Analysis 1: Linear/Numeric coding of patients_seen
    df['patients_seen_num'] = df['patients_seen'].map({'1-50': 0, '51-100': 1, '>100': 2}).astype(float)
    X_sens1 = df[['bcg', 'prior_mh', 'bcg_x_mh', 'patients_seen_num']]
    res_sens1 = OrderedModel(df['y'], X_sens1, distr='logit').fit(method='bfgs', disp=False)
    b1 = res_sens1.params['bcg_x_mh']
    ci1 = res_sens1.conf_int().loc['bcg_x_mh']
    print(f"\n[Sensitivity 1 - Numeric patients_seen] OR: {np.exp(b1):.4f} (95% CI: [{np.exp(ci1[0]):.4f}, {np.exp(ci1[1]):.4f}]), p = {res_sens1.pvalues['bcg_x_mh']:.4f}")

    # 7. Sensitivity Analysis 2: Control for expect_interact
    df['expect_interact_num'] = (df['expect_interact'] == 'Yes').astype(float)
    X_sens2 = df[['bcg', 'prior_mh', 'bcg_x_mh', 'expect_interact_num']]
    res_sens2 = OrderedModel(df['y'], X_sens2, distr='logit').fit(method='bfgs', disp=False)
    b2 = res_sens2.params['bcg_x_mh']
    ci2 = res_sens2.conf_int().loc['bcg_x_mh']
    print(f"[Sensitivity 2 - expect_interact] OR: {np.exp(b2):.4f} (95% CI: [{np.exp(ci2[0]):.4f}, {np.exp(ci2[1]):.4f}]), p = {res_sens2.pvalues['bcg_x_mh']:.4f}")

    # 8. Sensitivity Analysis 3: Grouped severity scale (0-1: Mild, 2: Moderate, >=3: Severe/Hospitalized)
    df['y_grouped'] = np.where(df['y'] <= 1, 0, np.where(df['y'] == 2, 1, 2))
    X_sens3 = df[['bcg', 'prior_mh', 'bcg_x_mh', 'patients_seen_51_100', 'patients_seen_gt100']]
    res_sens3 = OrderedModel(df['y_grouped'], X_sens3, distr='logit').fit(method='bfgs', disp=False)
    b3 = res_sens3.params['bcg_x_mh']
    ci3 = res_sens3.conf_int().loc['bcg_x_mh']
    print(f"[Sensitivity 3 - Grouped Severity] OR: {np.exp(b3):.4f} (95% CI: [{np.exp(ci3[0]):.4f}, {np.exp(ci3[1]):.4f}]), p = {res_sens3.pvalues['bcg_x_mh']:.4f}")

    # 9. Sensitivity Analysis 4: Full cohort (N=1000)
    df_full = dm.copy()
    df_full['y_full'] = df_full['USUBJID'].map(max_hs).fillna(-1).astype(int) + 1  # 0: No COVID, 1: Asymp, 2: Mild, ...
    df_full['bcg'] = (df_full['TRTGRP'] == 'BCG').astype(int)
    df_full['prior_mh'] = df_full['USUBJID'].isin(mh_pos_subjs).astype(int)
    df_full['bcg_x_mh'] = df_full['bcg'] * df_full['prior_mh']
    df_full['patients_seen_51_100'] = (df_full['patients_seen'] == '51-100').astype(float)
    df_full['patients_seen_gt100'] = (df_full['patients_seen'] == '>100').astype(float)
    X_sens4 = df_full[['bcg', 'prior_mh', 'bcg_x_mh', 'patients_seen_51_100', 'patients_seen_gt100']]
    res_sens4 = OrderedModel(df_full['y_full'], X_sens4, distr='logit').fit(method='bfgs', disp=False)
    b4 = res_sens4.params['bcg_x_mh']
    ci4 = res_sens4.conf_int().loc['bcg_x_mh']
    print(f"[Sensitivity 4 - Full cohort N=1000] OR: {np.exp(b4):.4f} (95% CI: [{np.exp(ci4[0]):.4f}, {np.exp(ci4[1]):.4f}]), p = {res_sens4.pvalues['bcg_x_mh']:.4f}")

    print("\n=== Analysis complete ===")

if __name__ == '__main__':
    run_analysis()
