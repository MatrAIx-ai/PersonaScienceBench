def draw_text(canvas, text, x0, y0, color=(0,0,0), scale=1):
    h, w, _ = canvas.shape
    cur_x = int(x0)
    for ch in text:
        bitmap = FONT_DIGITS.get(ch, FONT_DIGITS[' '])
        for col_idx, col_bits in enumerate(bitmap):
            for row_idx in range(7):
                if (col_bits >> row_idx) & 1:
                    for dx in range(scale):
                        for dy in range(scale):
                            px = cur_x + col_idx * scale + dx
                            py = int(y0) + row_idx * scale + dy
                            if 0 <= px < w and 0 <= py < h:
                                canvas[py, px] = color
        cur_x += (len(bitmap) + 1) * scale

def draw_line(canvas, x0, y0, x1, y1, color=(0,0,0), width=1, style='solid'):
    h, w, _ = canvas.shape
    dx, dy = abs(x1 - x0), abs(y1 - y0)
    sx = 1 if x0 < x1 else -1
    sy = 1 if y0 < y1 else -1
    err = dx - dy
    cx, cy = x0, y0
    step = 0
    while True:
        draw_it = True
        if style == 'dashed' and (step // 6) % 2 == 1:
            draw_it = False
        if draw_it:
            for wx in range(-width//2, width//2 + 1):
                for wy in range(-width//2, width//2 + 1):
                    px, py = cx + wx, cy + wy
                    if 0 <= px < w and 0 <= py < h:
                        canvas[py, px] = color
        if cx == x1 and cy == y1:
            break
        e2 = 2 * err
        if e2 > -dy:
            err -= dy
            cx += sx
        if e2 < dx:
            err += dx
            cy += sy
        step += 1

def run_all():
    with open('data/control_primary.json') as f:
        control = json.load(f)
    scan_a = np.load('data/scan_axis_a.npy')
    scan_b = np.load('data/scan_axis_b.npy')
    probe_a = np.load('data/probe_axis_a.npy')
    tokens = np.load('data/state_tokens.npz')

    n_L, n_T = len(scan_b), len(scan_a)
    focus_rows = control['focus_probe_rows']
    fit_window = control['fit_window_probe']
    stage_plan = control['stage_plan']
    warmup_passes = stage_plan['warmup_passes']
    sampling_passes = stage_plan['sampling_passes']
    prop_width = stage_plan['metropolis_proposal_width']

    np.random.seed(42)

    obs_matrix_a = np.zeros((n_L, n_T))
    obs_matrix_b = np.zeros((n_L, n_T))
    obs_tensor_c = np.zeros((len(focus_rows), len(probe_a)))
    obs_matrix_d = np.zeros((n_T, 2))
    obs_matrix_e = np.zeros((n_L, n_T))
    obs_matrix_f = np.zeros((n_L, n_T))

    n_blocks = 10
    block_size = sampling_passes // n_blocks

    samples_ex = np.zeros((n_L, n_T, sampling_passes))
    samples_ey = np.zeros((n_L, n_T, sampling_passes))
    samples_sx = np.zeros((n_L, n_T, sampling_passes))
    samples_sy = np.zeros((n_L, n_T, sampling_passes))
    samples_chi = np.zeros((n_L, n_T, sampling_passes))
    samples_fq = np.zeros((n_L, n_T, sampling_passes))
    samples_vort = np.zeros((n_L, n_T, sampling_passes))
    gr_all_T = np.zeros((n_T, len(probe_a)))
    gr_samples_L104 = np.zeros((n_T, sampling_passes, len(probe_a)))

    print("Running MCMC updates across lattice sizes and temperatures...")
    for i, L in enumerate(scan_b):
        theta = tokens[f"slot_{i:02d}"].copy()
        y_idx, x_idx = np.indices((L, L))
        mask_b = ((x_idx + y_idx) % 2 == 0)
        mask_w = ~mask_b

        for j, T in enumerate(scan_a):
            beta = 1.0 / T

            # Warmup
            for _ in range(warmup_passes):
                for m in [mask_b, mask_w]:
                    c, s_gr = np.cos(theta), np.sin(theta)
                    hx = np.roll(c, -1, 0) + np.roll(c, 1, 0) + np.roll(c, -1, 1) + np.roll(c, 1, 1)
                    hy = np.roll(s_gr, -1, 0) + np.roll(s_gr, 1, 0) + np.roll(s_gr, -1, 1) + np.roll(s_gr, 1, 1)
                    d = np.random.uniform(-prop_width, prop_width, (L, L))
                    th_new = theta + d
                    dE = -(hx * (np.cos(th_new) - c) + hy * (np.sin(th_new) - s_gr))
                    acc = (dE <= 0) | (np.random.uniform(0, 1, (L, L)) < np.exp(-dE * beta))
                    theta = np.where(m & acc, th_new, theta)

                for _ in range(2):
                    for m in [mask_b, mask_w]:
                        c, s_gr = np.cos(theta), np.sin(theta)
                        hx = np.roll(c, -1, 0) + np.roll(c, 1, 0) + np.roll(c, -1, 1) + np.roll(c, 1, 1)
                        hy = np.roll(s_gr, -1, 0) + np.roll(s_gr, 1, 0) + np.roll(s_gr, -1, 1) + np.roll(s_gr, 1, 1)
                        phi = np.arctan2(hy, hx)
                        theta = np.where(m, 2.0 * phi - theta, theta)

                for _ in range(2):
                    alpha = np.random.uniform(0, 2 * np.pi)
                    proj = np.cos(theta - alpha)
                    seed_x, seed_y = np.random.randint(0, L), np.random.randint(0, L)
                    visited = np.zeros((L, L), dtype=bool)
                    stack = [(seed_x, seed_y)]
                    visited[seed_x, seed_y] = True
                    while stack:
                        cx, cy = stack.pop()
                        p_c = proj[cx, cy]
                        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
                            nx, ny = (cx + dx) % L, (cy + dy) % L
                            if not visited[nx, ny]:
                                p_n = proj[nx, ny]
                                if p_c * p_n > 0:
                                    prob = 1.0 - np.exp(-2.0 * beta * p_c * p_n)
                                    if np.random.rand() < prob:
                                        visited[nx, ny] = True
                                        stack.append((nx, ny))
                    theta[visited] = (2 * alpha + np.pi - theta[visited]) % (2 * np.pi)

            # Sampling
            for s in range(sampling_passes):
                for m in [mask_b, mask_w]:
                    c, s_gr = np.cos(theta), np.sin(theta)
                    hx = np.roll(c, -1, 0) + np.roll(c, 1, 0) + np.roll(c, -1, 1) + np.roll(c, 1, 1)
                    hy = np.roll(s_gr, -1, 0) + np.roll(s_gr, 1, 0) + np.roll(s_gr, -1, 1) + np.roll(s_gr, 1, 1)
                    d = np.random.uniform(-prop_width, prop_width, (L, L))
                    th_new = theta + d
                    dE = -(hx * (np.cos(th_new) - c) + hy * (np.sin(th_new) - s_gr))
                    acc = (dE <= 0) | (np.random.uniform(0, 1, (L, L)) < np.exp(-dE * beta))
                    theta = np.where(m & acc, th_new, theta)

                for _ in range(2):
                    for m in [mask_b, mask_w]:
                        c, s_gr = np.cos(theta), np.sin(theta)
                        hx = np.roll(c, -1, 0) + np.roll(c, 1, 0) + np.roll(c, -1, 1) + np.roll(c, 1, 1)
                        hy = np.roll(s_gr, -1, 0) + np.roll(s_gr, 1, 0) + np.roll(s_gr, -1, 1) + np.roll(s_gr, 1, 1)
                        phi = np.arctan2(hy, hx)
                        theta = np.where(m, 2.0 * phi - theta, theta)

                for _ in range(2):
                    alpha = np.random.uniform(0, 2 * np.pi)
                    proj = np.cos(theta - alpha)
                    seed_x, seed_y = np.random.randint(0, L), np.random.randint(0, L)
                    visited = np.zeros((L, L), dtype=bool)
                    stack = [(seed_x, seed_y)]
                    visited[seed_x, seed_y] = True
                    while stack:
                        cx, cy = stack.pop()
                        p_c = proj[cx, cy]
                        for dx, dy in [(-1, 0), (1, 0), (0, -1), (0, 1)]:
                            nx, ny = (cx + dx) % L, (cy + dy) % L
                            if not visited[nx, ny]:
                                p_n = proj[nx, ny]
                                if p_c * p_n > 0:
                                    prob = 1.0 - np.exp(-2.0 * beta * p_c * p_n)
                                    if np.random.rand() < prob:
                                        visited[nx, ny] = True
                                        stack.append((nx, ny))
                    theta[visited] = (2 * alpha + np.pi - theta[visited]) % (2 * np.pi)

                dx = np.roll(theta, -1, 0) - theta
                dy = np.roll(theta, -1, 1) - theta
                samples_ex[i, j, s] = np.sum(np.cos(dx))
                samples_ey[i, j, s] = np.sum(np.cos(dy))
                samples_sx[i, j, s] = np.sum(np.sin(dx))
                samples_sy[i, j, s] = np.sum(np.sin(dy))

                wrap = lambda da: da - 2.0 * np.pi * np.round(da / (2.0 * np.pi))
                d1 = wrap(np.roll(theta, -1, 0) - theta)
                d2 = wrap(np.roll(np.roll(theta, -1, 0), -1, 1) - np.roll(theta, -1, 0))
                d3 = wrap(np.roll(theta, -1, 1) - np.roll(np.roll(theta, -1, 0), -1, 1))
                d4 = wrap(theta - np.roll(theta, -1, 1))
                q = np.round((d1 + d2 + d3 + d4) / (2.0 * np.pi))
                samples_vort[i, j, s] = np.mean(np.abs(q))

                fx = np.fft.fft2(np.cos(theta))
                fy = np.fft.fft2(np.sin(theta))
                pwr = np.abs(fx)**2 + np.abs(fy)**2
                samples_chi[i, j, s] = pwr[0, 0] / (L * L)
                samples_fq[i, j, s] = 0.25 * (pwr[1, 0] + pwr[-1, 0] + pwr[0, 1] + pwr[0, -1]) / (L * L)

                if L == scan_b[-1]:
                    corr = np.fft.ifft2(pwr).real / (L * L)
                    gr = 0.5 * (corr[0, 1:51] + corr[1:51, 0])
                    gr_samples_L104[j, s, :] = gr

        print(f"L={L} completed.")

    for i, L in enumerate(scan_b):
        for j, T in enumerate(scan_a):
            ex_m = np.mean(samples_ex[i, j])
            ey_m = np.mean(samples_ey[i, j])
            v_sx = np.var(samples_sx[i, j])
            v_sy = np.var(samples_sy[i, j])
            up = 0.5 * ((ex_m + ey_m) - (v_sx + v_sy) / T) / (L * L)
            obs_matrix_a[i, j] = up
            obs_matrix_b[i, j] = np.mean(samples_vort[i, j])

            chi_m = np.mean(samples_chi[i, j])
            fq_m = np.mean(samples_fq[i, j])
            obs_matrix_f[i, j] = chi_m
            obs_matrix_e[i, j] = 1.0 / (2.0 * np.sin(np.pi / L) * L) * np.sqrt(max(0.0, chi_m / fq_m - 1.0))

    for j in range(n_T):
        gr_all_T[j] = np.mean(gr_samples_L104[j], axis=0)

    for idx_f, r_idx in enumerate(focus_rows):
        obs_tensor_c[idx_f, :] = gr_all_T[r_idx]

    r_fit_mask = (probe_a >= fit_window[0]) & (probe_a <= fit_window[1])
    r_fit_vals = probe_a[r_fit_mask]
    for j, T in enumerate(scan_a):
        g_fit = gr_all_T[j, r_fit_mask]
        p = np.polyfit(np.log(r_fit_vals), np.log(g_fit), 1)
        obs_matrix_d[j, 0] = T
        obs_matrix_d[j, 1] = -p[0]

    np.save('obs_matrix_a.npy', obs_matrix_a)
    np.save('obs_matrix_b.npy', obs_matrix_b)
    np.save('obs_tensor_c.npy', obs_tensor_c)
    np.save('obs_matrix_d.npy', obs_matrix_d)
    np.save('obs_matrix_e.npy', obs_matrix_e)
    np.save('obs_matrix_f.npy', obs_matrix_f)

    return control, scan_a, scan_b, probe_a, obs_matrix_a, obs_matrix_b, obs_tensor_c, obs_matrix_d, obs_matrix_e, obs_matrix_f, samples_ex, samples_ey, samples_sx, samples_sy, samples_chi, samples_fq, gr_samples_L104, r_fit_vals, r_fit_mask

def analyze_and_plot(control, scan_a, scan_b, probe_a, obs_matrix_a, obs_matrix_b, obs_tensor_c, obs_matrix_d, obs_matrix_e, obs_matrix_f, samples_ex, samples_ey, samples_sx, samples_sy, samples_chi, samples_fq, gr_samples_L104, r_fit_vals, r_fit_mask):
    n_L, n_T = len(scan_b), len(scan_a)
    focus_rows = control['focus_probe_rows']
    fit_window = control['fit_window_probe']
    target = 2.0 / np.pi
    diag_x = 1.0 / np.log(scan_b)
    min_axis_candidates = [32, 50, 68]

    def compute_bundle(up_mat, chi_mat, xi_mat, eta_vals):
        size_tc = []
        for i_sz in range(n_L):
            rc = up_mat[i_sz] / scan_a
            idx_cross = None
            for idx in range(len(rc) - 1):
                if (rc[idx] - target) * (rc[idx+1] - target) <= 0:
                    idx_cross = idx
                    break
            if idx_cross is not None:
                t0, t1, y0, y1 = scan_a[idx_cross], scan_a[idx_cross+1], rc[idx_cross], rc[idx_cross+1]
                t_root = t0 + (target - y0) * (t1 - t0) / (y1 - y0)
            else:
                p_fit = np.polyfit(scan_a, rc - target, 1)
                t_root = -p_fit[1] / p_fit[0]
            size_tc.append(float(t_root))

        size_weighted_tc = float(np.sum(np.array(size_tc) * scan_b) / np.sum(scan_b))

        fs_intercepts, fs_slopes = [], []
        for j_t in range(n_T):
            y_pts = up_mat[:, j_t] / scan_a[j_t]
            slope, intercept = np.polyfit(diag_x, y_pts, 1)
            fs_intercepts.append(float(intercept))
            fs_slopes.append(float(slope))

        fs_ints = np.array(fs_intercepts)
        idx_cross = None
        for idx in range(len(fs_ints) - 1):
            if (fs_ints[idx] - target) * (fs_ints[idx+1] - target) <= 0:
                idx_cross = idx
                break
        if idx_cross is not None:
            t0, t1, y0, y1 = scan_a[idx_cross], scan_a[idx_cross+1], fs_ints[idx_cross], fs_ints[idx_cross+1]
            fs_tc = float(t0 + (target - y0) * (t1 - t0) / (y1 - y0))
        else:
            p_fit = np.polyfit(scan_a, fs_ints - target, 1)
            fs_tc = float(-p_fit[1] / p_fit[0])
        fs_residual = float(np.interp(fs_tc, scan_a, fs_ints) - target)

        dim_intercepts, dim_slopes = [], []
        for j_t in range(n_T):
            y_pts = xi_mat[:, j_t]
            slope, intercept = np.polyfit(diag_x, y_pts, 1)
            dim_intercepts.append(float(intercept))
            dim_slopes.append(float(slope))

        dim_slopes_arr = np.array(dim_slopes)
        idx_cross = None
        for idx in range(len(dim_slopes_arr) - 1):
            if dim_slopes_arr[idx] * dim_slopes_arr[idx+1] <= 0:
                idx_cross = idx
                break
        if idx_cross is not None:
            t0, t1, y0, y1 = scan_a[idx_cross], scan_a[idx_cross+1], dim_slopes_arr[idx_cross], dim_slopes_arr[idx_cross+1]
            dim_tc = float(t0 - y0 * (t1 - t0) / (y1 - y0))
        else:
            dim_tc = float(scan_a[np.argmin(np.abs(dim_slopes_arr))])
        dim_residual = float(np.interp(dim_tc, scan_a, dim_slopes_arr))

        eta_target = 0.25
        idx_cross = None
        for idx in range(len(eta_vals) - 1):
            if (eta_vals[idx] - eta_target) * (eta_vals[idx+1] - eta_target) <= 0:
                idx_cross = idx
                break
        if idx_cross is not None:
            t0, t1, y0, y1 = scan_a[idx_cross], scan_a[idx_cross+1], eta_vals[idx_cross], eta_vals[idx_cross+1]
            eta_tc = float(t0 + (eta_target - y0) * (t1 - t0) / (y1 - y0))
        else:
            p_fit = np.polyfit(scan_a, eta_vals - eta_target, 1)
            eta_tc = float(-p_fit[1] / p_fit[0])
        eta_residual = float(np.interp(eta_tc, scan_a, eta_vals) - eta_target)

        res_traces, res_best_T, res_best_C, res_best_val = [], [], [], []
        for l_min in min_axis_candidates:
            mask_l = (scan_b >= l_min)
            L_sub = scan_b[mask_l]
            trace, c_list = [], []
            for j_t, T_val in enumerate(scan_a):
                up_sub = up_mat[mask_l, j_t]
                def wm_loss(C):
                    if np.any(np.log(L_sub) + C <= 0.01):
                        return 1e6
                    mod = (2.0 * T_val / np.pi) * (1.0 + 1.0 / (2.0 * (np.log(L_sub) + C)))
                    return np.sqrt(np.sum((up_sub - mod)**2)) / np.sqrt(np.sum(up_sub**2))
                fc = opt.minimize_scalar(wm_loss, bounds=(-2.0, 30.0), method='bounded')
                trace.append(float(fc.fun))
                c_list.append(float(fc.x))
            res_traces.append(trace)
            b_idx = int(np.argmin(trace))
            if 0 < b_idx < len(trace) - 1:
                t_sub, r_sub = scan_a[b_idx-1:b_idx+2], trace[b_idx-1:b_idx+2]
                p2 = np.polyfit(t_sub, r_sub, 2)
                if p2[0] > 0:
                    t_star = -p2[1] / (2.0 * p2[0])
                    if t_sub[0] <= t_star <= t_sub[-1]:
                        res_best_T.append(float(t_star))
                        res_best_C.append(float(np.interp(t_star, scan_a, c_list)))
                        res_best_val.append(float(np.polyval(p2, t_star)))
                    else:
                        res_best_T.append(float(scan_a[b_idx]))
                        res_best_C.append(float(c_list[b_idx]))
                        res_best_val.append(float(trace[b_idx]))
                else:
                    res_best_T.append(float(scan_a[b_idx]))
                    res_best_C.append(float(c_list[b_idx]))
                    res_best_val.append(float(trace[b_idx]))
            else:
                res_best_T.append(float(scan_a[b_idx]))
                res_best_C.append(float(c_list[b_idx]))
                res_best_val.append(float(trace[b_idx]))

        resp_traces, resp_best_T, resp_best_C, resp_best_val = [], [], [], []
        for l_min in min_axis_candidates:
            mask_l = (scan_b >= l_min)
            L_sub = scan_b[mask_l]
            trace, c_list = [], []
            for j_t, T_val in enumerate(scan_a):
                chi_sub = chi_mat[mask_l, j_t]
                def resp_loss(C):
                    if np.any(np.log(L_sub) + C <= 0.01):
                        return 1e6
                    base = (L_sub**1.75) * ((np.log(L_sub) + C)**0.125)
                    A = np.dot(chi_sub, base) / np.dot(base, base)
                    if A <= 0:
                        return 1e6
                    mod = A * base
                    return np.sqrt(np.sum((chi_sub - mod)**2)) / np.sqrt(np.sum(chi_sub**2))
                fc = opt.minimize_scalar(resp_loss, bounds=(-2.0, 30.0), method='bounded')
                trace.append(float(fc.fun))
                c_list.append(float(fc.x))
            resp_traces.append(trace)
            b_idx = int(np.argmin(trace))
            if 0 < b_idx < len(trace) - 1:
                t_sub, r_sub = scan_a[b_idx-1:b_idx+2], trace[b_idx-1:b_idx+2]
                p2 = np.polyfit(t_sub, r_sub, 2)
                if p2[0] > 0:
                    t_star = -p2[1] / (2.0 * p2[0])
                    if t_sub[0] <= t_star <= t_sub[-1]:
                        resp_best_T.append(float(t_star))
                        resp_best_C.append(float(np.interp(t_star, scan_a, c_list)))
                        resp_best_val.append(float(np.polyval(p2, t_star)))
                    else:
                        resp_best_T.append(float(scan_a[b_idx]))
                        resp_best_C.append(float(c_list[b_idx]))
                        resp_best_val.append(float(trace[b_idx]))
                else:
                    resp_best_T.append(float(scan_a[b_idx]))
                    resp_best_C.append(float(c_list[b_idx]))
                    resp_best_val.append(float(trace[b_idx]))
            else:
                resp_best_T.append(float(scan_a[b_idx]))
                resp_best_C.append(float(c_list[b_idx]))
                resp_best_val.append(float(trace[b_idx]))

        sel_idx = 0
        pref_tc = res_best_T[sel_idx]
        pref_inv_tc = 1.0 / pref_tc
        pref_c = res_best_C[sel_idx]
        pref_res = res_best_val[sel_idx]
        res_spread = float(max(res_best_T) - min(res_best_T))

        resp_tc = resp_best_T[sel_idx]
        resp_c = resp_best_C[sel_idx]
        resp_res = resp_best_val[sel_idx]
        resp_spread = float(max(resp_best_T) - min(resp_best_T))

        comp_estimates = [float(pref_tc), float(size_weighted_tc), float(fs_tc), float(dim_tc), float(eta_tc)]
        consensus_tc = float(np.mean(comp_estimates))
        consensus_spread = float(max(comp_estimates) - min(comp_estimates))

        return {
            'diagnostic_abscissa_values': [float(x) for x in diag_x],
            'size_transition_estimates': [float(x) for x in size_tc],
            'size_weighted_transition_estimate': float(size_weighted_tc),
            'finite_size_intercepts': [float(x) for x in fs_intercepts],
            'finite_size_slopes': [float(x) for x in fs_slopes],
            'finite_size_transition_estimate': float(fs_tc),
            'finite_size_transition_residual': float(fs_residual),
            'dimensionless_ratio_intercepts': [float(x) for x in dim_intercepts],
            'dimensionless_ratio_slopes': [float(x) for x in dim_slopes],
            'dimensionless_ratio_transition_estimate': float(dim_tc),
            'dimensionless_ratio_transition_residual': float(dim_residual),
            'exponent_transition_estimate': float(eta_tc),
            'exponent_transition_residual': float(eta_residual),
            'residual_sweep_min_axis_values': min_axis_candidates,
            'residual_sweep_best_axis_a_values': [float(x) for x in res_best_T],
            'residual_sweep_best_offset_values': [float(x) for x in res_best_C],
            'residual_sweep_best_residual_values': [float(x) for x in res_best_val],
            'residual_sweep_traces': [[float(v) for v in tr] for tr in res_traces],
            'response_sweep_min_axis_values': min_axis_candidates,
            'response_sweep_best_axis_a_values': [float(x) for x in resp_best_T],
            'response_sweep_best_offset_values': [float(x) for x in resp_best_C],
            'response_sweep_best_residual_values': [float(x) for x in resp_best_val],
            'response_sweep_traces': [[float(v) for v in tr] for tr in resp_traces],
            'selected_residual_sweep_min_axis': min_axis_candidates[sel_idx],
            'selected_response_sweep_min_axis': min_axis_candidates[sel_idx],
            'preferred_transition_temperature': float(pref_tc),
            'preferred_inverse_temperature': float(pref_inv_tc),
            'preferred_offset_value': float(pref_c),
            'preferred_residual_value': float(pref_res),
            'residual_sweep_stability_spread': float(res_spread),
            'response_transition_temperature': float(resp_tc),
            'response_offset_value': float(resp_c),
            'response_residual_value': float(resp_res),
            'response_sweep_stability_spread': float(resp_spread),
            'transition_component_estimates': comp_estimates,
            'consensus_transition_temperature': float(consensus_tc),
            'consensus_transition_spread': float(consensus_spread)
        }

    eta_full = obs_matrix_d[:, 1]
    main_diag = compute_bundle(obs_matrix_a, obs_matrix_f, obs_matrix_e, eta_full)

    # 10 block jackknife
    n_blocks = 10
    sampling_passes = samples_ex.shape[2]
    b_sz = sampling_passes // n_blocks
    jk_comps, jk_pref_t, jk_pref_r, jk_resp_t, jk_resp_r, jk_cons_t = [], [], [], [], [], []

    for b in range(n_blocks):
        b_start, b_end = b * b_sz, (b + 1) * b_sz if b < n_blocks - 1 else sampling_passes
        mask_samp = np.ones(sampling_passes, dtype=bool)
        mask_samp[b_start:b_end] = False

        up_jk = np.zeros((n_L, n_T))
        chi_jk = np.zeros((n_L, n_T))
        xi_jk = np.zeros((n_L, n_T))
        gr_jk = np.zeros((n_T, len(probe_a)))

        for i, L in enumerate(scan_b):
            for j, T in enumerate(scan_a):
                ex_m = np.mean(samples_ex[i, j, mask_samp])
                ey_m = np.mean(samples_ey[i, j, mask_samp])
                v_sx = np.var(samples_sx[i, j, mask_samp])
                v_sy = np.var(samples_sy[i, j, mask_samp])
                up_jk[i, j] = 0.5 * ((ex_m + ey_m) - (v_sx + v_sy) / T) / (L * L)

                chi_m = np.mean(samples_chi[i, j, mask_samp])
                fq_m = np.mean(samples_fq[i, j, mask_samp])
                chi_jk[i, j] = chi_m
                xi_jk[i, j] = 1.0 / (2.0 * np.sin(np.pi / L) * L) * np.sqrt(max(0.0, chi_m / fq_m - 1.0))

        for j in range(n_T):
            gr_jk[j] = np.mean(gr_samples_L104[j, mask_samp, :], axis=0)

        eta_jk = np.zeros(n_T)
        for j in range(n_T):
            p = np.polyfit(np.log(r_fit_vals), np.log(gr_jk[j, r_fit_mask]), 1)
            eta_jk[j] = -p[0]

        d_b = compute_bundle(up_jk, chi_jk, xi_jk, eta_jk)
        jk_comps.append(d_b['transition_component_estimates'])
        jk_pref_t.append(d_b['preferred_transition_temperature'])
        jk_pref_r.append(d_b['preferred_residual_value'])
        jk_resp_t.append(d_b['response_transition_temperature'])
        jk_resp_r.append(d_b['response_residual_value'])
        jk_cons_t.append(d_b['consensus_transition_temperature'])

    factor = (n_blocks - 1.0) / n_blocks
    jk_comps = np.array(jk_comps)
    m_comps = np.mean(jk_comps, axis=0)
    comp_uncs = [float(np.sqrt(factor * np.sum((jk_comps[:, c] - m_comps[c])**2))) for c in range(5)]

    pref_t_unc = float(np.sqrt(factor * np.sum((np.array(jk_pref_t) - np.mean(jk_pref_t))**2)))
    pref_r_unc = float(np.sqrt(factor * np.sum((np.array(jk_pref_r) - np.mean(jk_pref_r))**2)))
    resp_t_unc = float(np.sqrt(factor * np.sum((np.array(jk_resp_t) - np.mean(jk_resp_t))**2)))
    resp_r_unc = float(np.sqrt(factor * np.sum((np.array(jk_resp_r) - np.mean(jk_resp_r))**2)))
    cons_unc = float(np.sqrt(factor * np.sum((np.array(jk_cons_t) - np.mean(jk_cons_t))**2)))

    diag_out = dict(main_diag)
    diag_out['jackknife_block_count'] = n_blocks
    diag_out['transition_component_uncertainties'] = comp_uncs
    diag_out['preferred_transition_uncertainty'] = pref_t_unc
    diag_out['preferred_residual_uncertainty'] = pref_r_unc
    diag_out['response_transition_uncertainty'] = resp_t_unc
    diag_out['response_residual_uncertainty'] = resp_r_unc
    diag_out['consensus_temperature_uncertainty'] = cons_unc
    diag_out['selected_profile_indices'] = [int(x) for x in focus_rows]
    diag_out['selected_profile_axis_a_values'] = [float(scan_a[idx]) for idx in focus_rows]
    diag_out['profile_fit_window'] = [int(fit_window[0]), int(fit_window[1])]

    pref_T = main_diag['preferred_transition_temperature']
    up_max_T = float(np.interp(pref_T, scan_a, obs_matrix_a[-1, :]))
    jump_ratio = float(up_max_T / pref_T)
    jump_res = float(jump_ratio - 2.0 / np.pi)
    eta_T = float(np.interp(pref_T, scan_a, obs_matrix_d[:, 1]))
    defect_span = float(obs_matrix_b[-1, -1] - obs_matrix_b[-1, 0])
    dim_ratio_T = float(np.interp(pref_T, scan_a, main_diag['dimensionless_ratio_intercepts']))

    summary_out = {
        'setting_key': control['scan_token'],
        'scan_axis_a_values': [float(x) for x in scan_a],
        'scan_axis_b_values': [int(x) for x in scan_b],
        'selected_profile_indices': [int(x) for x in focus_rows],
        'selected_profile_axis_a_values': [float(scan_a[idx]) for idx in focus_rows],
        'transition_temperature_estimate': float(pref_T),
        'inverse_transition_temperature_estimate': float(1.0 / pref_T),
        'stiffness_jump_ratio_at_transition': float(jump_ratio),
        'stiffness_jump_residual': float(jump_res),
        'correlation_exponent_at_transition': float(eta_T),
        'defect_density_span': float(defect_span),
        'dimensionless_ratio_at_transition': float(dim_ratio_T),
        'transition_estimate_spread': float(main_diag['consensus_transition_spread'])
    }

    with open('phase_fit_diagnostics.json', 'w') as f:
        json.dump(diag_out, f, indent=2)

    with open('phase_summary.json', 'w') as f:
        json.dump(summary_out, f, indent=2)

    # Render overview.png
    canvas = np.ones((800, 1000, 3), dtype=np.uint8) * 255
    draw_text(canvas, "2D XY Model Phase Transition Overview", 280, 20, (10, 10, 50), scale=2)

    panels = [
        (80, 80, 460, 380),
        (560, 80, 940, 380),
        (80, 460, 460, 750),
        (560, 460, 940, 750)
    ]

    colors = [
        (220, 50, 50), (50, 150, 50), (50, 50, 220), (200, 120, 20), (140, 40, 180)
    ]

    # Panel 1: Upsilon vs T
    px0, py0, px1, py1 = panels[0]
    draw_line(canvas, px0, py0, px0, py1, (50, 50, 50), 2)
    draw_line(canvas, px0, py1, px1, py1, (50, 50, 50), 2)
    draw_text(canvas, "Helicity Modulus Upsilon(L, T)", px0 + 40, py0 - 25, (0, 0, 0), scale=1)
    draw_text(canvas, "T", (px0 + px1)//2, py1 + 15, (0, 0, 0), scale=1)

    t_min, t_max = scan_a[0], scan_a[-1]
    up_min, up_max = 0.0, 1.0

    def t_to_x(t, x0=px0, x1=px1): return int(x0 + (t - t_min)/(t_max - t_min) * (x1 - x0))
    def up_to_y(u, y0=py0, y1=py1): return int(y1 - (u - up_min)/(up_max - up_min) * (y1 - y0))

    draw_line(canvas, t_to_x(t_min), up_to_y((2/np.pi)*t_min), t_to_x(t_max), up_to_y((2/np.pi)*t_max), (150, 150, 150), 2, style='dashed')
    draw_text(canvas, "2T/pi", t_to_x(t_max) - 40, up_to_y((2/np.pi)*t_max) - 15, (100, 100, 100), scale=1)

    for i_l, L in enumerate(scan_b):
        pts = [(t_to_x(scan_a[j]), up_to_y(obs_matrix_a[i_l, j])) for j in range(n_T)]
        for k in range(len(pts) - 1):
            draw_line(canvas, pts[k][0], pts[k][1], pts[k+1][0], pts[k+1][1], colors[i_l], 2)
        for pt in pts:
            for dx in [-2, -1, 0, 1, 2]:
                for dy in [-2, -1, 0, 1, 2]:
                    if dx*dx + dy*dy <= 4:
                        canvas[pt[1]+dy, pt[0]+dx] = colors[i_l]

    # Panel 2: chi vs T
    px0, py0, px1, py1 = panels[1]
    draw_line(canvas, px0, py0, px0, py1, (50, 50, 50), 2)
    draw_line(canvas, px0, py1, px1, py1, (50, 50, 50), 2)
    draw_text(canvas, "Susceptibility chi(L, T)", px0 + 60, py0 - 25, (0, 0, 0), scale=1)
    draw_text(canvas, "T", (px0 + px1)//2, py1 + 15, (0, 0, 0), scale=1)

    chi_max = float(np.max(obs_matrix_f)) * 1.05
    def chi_to_y(c): return int(py1 - (c / chi_max) * (py1 - py0))

    for i_l, L in enumerate(scan_b):
        pts = [(t_to_x(scan_a[j], px0, px1), chi_to_y(obs_matrix_f[i_l, j])) for j in range(n_T)]
        for k in range(len(pts) - 1):
            draw_line(canvas, pts[k][0], pts[k][1], pts[k+1][0], pts[k+1][1], colors[i_l], 2)
        for pt in pts:
            for dx in [-2, -1, 0, 1, 2]:
                for dy in [-2, -1, 0, 1, 2]:
                    if dx*dx + dy*dy <= 4:
                        canvas[pt[1]+dy, pt[0]+dx] = colors[i_l]

    # Panel 3: G(r) vs r for L=104
    px0, py0, px1, py1 = panels[2]
    draw_line(canvas, px0, py0, px0, py1, (50, 50, 50), 2)
    draw_line(canvas, px0, py1, px1, py1, (50, 50, 50), 2)
    draw_text(canvas, "Correlation G(r) for L=104", px0 + 50, py0 - 25, (0, 0, 0), scale=1)
    draw_text(canvas, "r", (px0 + px1)//2, py1 + 15, (0, 0, 0), scale=1)

    r_min_log, r_max_log = np.log(1.0), np.log(50.0)
    g_min_log, g_max_log = np.log(0.15), np.log(1.0)
    def r_to_x(r): return int(px0 + (np.log(r) - r_min_log)/(r_max_log - r_min_log) * (px1 - px0))
    def g_to_y(g): return int(py1 - (np.log(max(0.15, g)) - g_min_log)/(g_max_log - g_min_log) * (py1 - py0))

    for idx_f, r_idx in enumerate(focus_rows):
        pts = [(r_to_x(probe_a[k]), g_to_y(obs_tensor_c[idx_f, k])) for k in range(len(probe_a))]
        for k in range(len(pts) - 1):
            draw_line(canvas, pts[k][0], pts[k][1], pts[k+1][0], pts[k+1][1], colors[idx_f], 2)

    # Panel 4: xi_2nd / L vs T
    px0, py0, px1, py1 = panels[3]
    draw_line(canvas, px0, py0, px0, py1, (50, 50, 50), 2)
    draw_line(canvas, px0, py1, px1, py1, (50, 50, 50), 2)
    draw_text(canvas, "Dimensionless Ratio xi_2nd / L", px0 + 40, py0 - 25, (0, 0, 0), scale=1)
    draw_text(canvas, "T", (px0 + px1)//2, py1 + 15, (0, 0, 0), scale=1)

    xi_min_val, xi_max_val = 0.5, 1.1
    def xi_to_y(xi): return int(py1 - (xi - xi_min_val)/(xi_max_val - xi_min_val) * (py1 - py0))

    for i_l, L in enumerate(scan_b):
        pts = [(t_to_x(scan_a[j], px0, px1), xi_to_y(obs_matrix_e[i_l, j])) for j in range(n_T)]
        for k in range(len(pts) - 1):
            draw_line(canvas, pts[k][0], pts[k][1], pts[k+1][0], pts[k+1][1], colors[i_l], 2)
        for pt in pts:
            for dx in [-2, -1, 0, 1, 2]:
                for dy in [-2, -1, 0, 1, 2]:
                    if dx*dx + dy*dy <= 4:
                        canvas[pt[1]+dy, pt[0]+dx] = colors[i_l]

    save_png(canvas, 'overview.png')
    print("Saved overview.png successfully!")

