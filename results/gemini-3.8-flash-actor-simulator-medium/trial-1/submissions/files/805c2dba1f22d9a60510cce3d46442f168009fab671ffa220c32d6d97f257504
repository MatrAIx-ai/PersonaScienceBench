import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf

def main():
    # 1. Load data
    excel_path = 'data/data.xlsx'
    df = pd.read_excel(excel_path, sheet_name=0)
    
    # Filter valid rows (first 80 patients, Sequence number 1 to 80)
    df_clean = df[df['Sequence number'].notna()].copy()
    df_clean['Age'] = pd.to_numeric(df_clean['Age'])
    df_clean['BMI'] = pd.to_numeric(df_clean['BMI'])
    
    # Define binary response: PR = 1, SD/PD = 0
    df_clean['PR'] = (df_clean['Efficacy'] == 'PR').astype(int)
    
    print(f"Total valid samples: {len(df_clean)}")
    print(f"Responders (PR=1): {df_clean['PR'].sum()}")
    print(f"Non-responders (PR=0): {(df_clean['PR'] == 0).sum()}")
    
    # 2. Fit combined logistic regression model: PR ~ Age + BMI + Gender
    model = smf.logit('PR ~ Age + BMI + Gender', data=df_clean).fit()
    print("\n--- Logistic Regression Model Summary ---")
    print(model.summary())
    
    # Extract coefficients, std errors, z values, p values, CI
    results_df = pd.DataFrame({
        'coef': model.params,
        'std_err': model.bse,
        'z_value': model.tvalues,
        'p_value': model.pvalues,
        'ci_lower': model.conf_int()[0],
        'ci_upper': model.conf_int()[1],
        'odds_ratio': np.exp(model.params)
    })
    
    print("\n--- Detailed Results Table ---")
    print(results_df)
    
    age_p = model.pvalues['Age']
    print(f"\np-value for Age:")
    print(f"Exact: {age_p}")
    print(f"Rounded (4 decimals): {age_p:.4f}")
    print(f"Rounded (3 decimals): {age_p:.3f}")
    
    # Also verify with GLM (Binomial logit)
    glm_model = smf.glm('PR ~ Age + BMI + Gender', data=df_clean, family=sm.families.Binomial()).fit()
    print("\n--- GLM Binomial Summary ---")
    print(glm_model.summary())
    print(f"GLM Age p-value: {glm_model.pvalues['Age']}")

if __name__ == '__main__':
    main()
