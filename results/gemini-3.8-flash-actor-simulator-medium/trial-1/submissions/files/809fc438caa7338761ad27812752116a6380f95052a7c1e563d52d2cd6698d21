import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf

# 1. Load datasets
df_niche = pd.read_csv('data/invaded_niche_pathways.csv', sep='\t')
df_niche.columns = [c.replace('.', '_') for c in df_niche.columns]

df_species = pd.read_csv('data/invasion_success_pathways.csv')
df_temporal = pd.read_csv('data/temporal_trends_contingency_table.csv', sep='\t')

# 2. GLMs across pathways, scales, and years
results = []
for pathway in ['n_unint', 'n_gard', 'n_agfo']:
    for scale in ['50m', '500m', '1000m']:
        col = f'urban_2009_{scale}'
        m = smf.glm(f'{pathway} ~ {col}', data=df_niche, family=sm.families.Poisson()).fit()
        results.append({
            'pathway': pathway, 'scale': scale, 'year': '2009',
            'coef': m.params[col], 'se': m.bse[col], 'z': m.tvalues[col],
            'p': m.pvalues[col], 'aic': m.aic, 'pseudo_r2': 1 - m.deviance/m.null_deviance
        })

for pathway in ['n_unint', 'n_gard', 'n_agfo']:
    for year in ['1956', '1993']:
        col = f'urban_{year}_500m'
        m = smf.glm(f'{pathway} ~ {col}', data=df_niche, family=sm.families.Poisson()).fit()
        results.append({
            'pathway': pathway, 'scale': '500m', 'year': year,
            'coef': m.params[col], 'se': m.bse[col], 'z': m.tvalues[col],
            'p': m.pvalues[col], 'aic': m.aic, 'pseudo_r2': 1 - m.deviance/m.null_deviance
        })

df_res = pd.DataFrame(results)
print("=== Model Summary ===")
print(df_res.to_string())

# 3. Multivariate GLM
m_multi_unint = smf.glm(
    'n_unint ~ urban_2009_500m + cropland_2009_500m + elevation + distance_road + distance_stream',
    data=df_niche, family=sm.families.Poisson()
).fit()
print("\n=== Multivariate GLM (n_unint) ===")
print(m_multi_unint.summary().tables[1])

# 4. Non-urban spillover GLM
df_nonurban = df_niche[df_niche['habitat'] != 'Urban']
m_spill = smf.glm('n_unint ~ urban_2009_500m', data=df_nonurban, family=sm.families.Poisson()).fit()
print("\n=== Non-urban Spillover GLM ===")
print(m_spill.summary().tables[1])
