#!/usr/bin/env python3
"""
Gene Regulatory Network Inference Pipeline
Discovers directed regulatory relationships among 25 genes using:
1. Dynamic ODE Modeling with ElasticNet regularization on time-course data.
2. Perturbation Response Modeling with Ridge regression on steady-state data.
Ensembles the methods into a consensus confidence matrix, determines edge signs,
computes structural network metrics, and identifies top regulatory hub genes.
"""

import json
import numpy as np
from scipy.stats import rankdata


def fit_elasticnet(X, y, l1=0.015, l2=0.05, max_iter=2000, tol=1e-5):
    """
    Coordinate descent solver for ElasticNet regression:
    Loss = 1/(2n) ||y - X w||^2 + l1 * ||w||_1 + 0.5 * l2 * ||w||_2^2
    """
    n, p = X.shape
    w = np.zeros(p)
    norms = np.sum(X**2, axis=0) / n + l2
    residual = y.copy()
    for _ in range(max_iter):
        w_old = w.copy()
        for j in range(p):
            residual += X[:, j] * w[j]
            rho = np.dot(X[:, j], residual) / n
            if rho > l1:
                w[j] = (rho - l1) / norms[j]
            elif rho < -l1:
                w[j] = (rho + l1) / norms[j]
            else:
                w[j] = 0.0
            residual -= X[:, j] * w[j]
        if np.max(np.abs(w - w_old)) < tol:
            break
    return w


def main():
    # Load input data
    ts = np.load('data/expression_timeseries.npy')      # Shape: (5, 50, 25)
    ss = np.load('data/perturbation_steady_states.npy') # Shape: (16, 25)
    with open('data/system_info.json') as f:
        sys_info = json.load(f)

    n_genes = sys_info.get('n_genes', 25)
    dt = sys_info.get('sampling_interval', 0.612245)

    print(f"Data loaded: {n_genes} genes, 5 time series, 16 steady states.")

    # -------------------------------------------------------------
    # Method 1: Dynamic Continuous-Time ODE Regression (Time Series)
    # -------------------------------------------------------------
    # Compute numerical gradients dX/dt for each series
    X_list = []
    dX_list = []
    for s in range(ts.shape[0]):
        g = np.gradient(ts[s], dt, axis=0)
        X_list.append(ts[s])
        dX_list.append(g)

    X_all = np.vstack(X_list)   # (250, 25)
    dX_all = np.vstack(dX_list) # (250, 25)

    X_mean = X_all.mean(axis=0)
    X_std = X_all.std(axis=0) + 1e-8
    X_norm = (X_all - X_mean) / X_std

    W_ode = np.zeros((n_genes, n_genes))
    ode_r2 = []
    for i in range(n_genes):
        y = dX_all[:, i]
        y_m = y.mean()
        y_s = y.std() + 1e-8
        y_n = (y - y_m) / y_s

        w = fit_elasticnet(X_norm, y_n, l1=0.015, l2=0.05)
        W_ode[i] = w * (y_s / X_std)

        pred = (X_norm @ w) * y_s + y_m
        ss_tot = np.sum((y - y_m)**2)
        ss_res = np.sum((y - pred)**2)
        r2 = 1.0 - ss_res / (ss_tot + 1e-8)
        ode_r2.append(float(r2))

    mean_r2_ode = float(np.mean(ode_r2))
    print(f"Method 1 (Dynamic ODE) Mean R^2: {mean_r2_ode:.4f}")

    # -------------------------------------------------------------
    # Method 2: Steady-State Perturbation Response Model
    # -------------------------------------------------------------
    baseline_wt = ss[0]
    pert_diff = ss[1:] - baseline_wt # (15, 25)

    # Detect intervened target genes in each condition
    P = np.zeros((15, n_genes))
    for k in range(15):
        for j in range(n_genes):
            val = ss[k + 1, j]
            base = baseline_wt[j]
            rel_change = np.abs(val - base) / (base + 0.1)
            # Gene is perturbed if clamped to ~0, ~10, or large relative change
            if val < 0.05 or np.abs(val - 10.0) < 0.08 or rel_change > 0.85:
                P[k, j] = pert_diff[k, j]

    ridge_lambda = 5.0
    # Solve Delta X ~ P @ E  =>  E = (P^T P + lam I)^-1 P^T Delta X
    E = np.linalg.solve(P.T @ P + ridge_lambda * np.eye(n_genes), P.T @ pert_diff)
    # E[j, i] is effect of regulator j on target i.
    # By convention [i, j] is regulator j on target i:
    W_pert = E.T

    pert_pred = P @ E
    ss_tot_pert = np.sum((pert_diff - pert_diff.mean(axis=0))**2)
    ss_res_pert = np.sum((pert_diff - pert_pred)**2)
    pert_r2 = float(1.0 - ss_res_pert / (ss_tot_pert + 1e-8))
    print(f"Method 2 (Perturbation Response) R^2: {pert_r2:.4f}")

    # -------------------------------------------------------------
    # Method Combination & Ensembling
    # -------------------------------------------------------------
    diag_mask = np.eye(n_genes, dtype=bool)
    W_ode[diag_mask] = 0.0
    W_pert[diag_mask] = 0.0

    # Off-diagonal rank normalization
    ode_ranks = np.zeros((n_genes, n_genes))
    pert_ranks = np.zeros((n_genes, n_genes))
    ode_ranks[~diag_mask] = rankdata(np.abs(W_ode[~diag_mask])) / 600.0
    pert_ranks[~diag_mask] = rankdata(np.abs(W_pert[~diag_mask])) / 600.0

    w_ode, w_pert = 0.5, 0.5
    consensus_score = w_ode * ode_ranks + w_pert * pert_ranks
    consensus_score[diag_mask] = 0.0

    # Density calibration: target 15% density (90 directed edges)
    # Valid range is 5% to 40% (30 to 240 edges)
    target_density = 0.15
    n_selected_edges = int(600 * target_density)
    cutoff = np.sort(consensus_score[~diag_mask])[::-1][n_selected_edges - 1]

    inferred_network = np.where(consensus_score >= cutoff, consensus_score, 0.0)
    inferred_network[diag_mask] = 0.0

    # Strict check: ensure density is within [0.05, 0.40]
    actual_edges = int(np.sum(inferred_network > 0))
    actual_density = float(actual_edges / 600.0)
    assert 0.05 <= actual_density <= 0.40, f"Density {actual_density} outside [0.05, 0.40]"

    # -------------------------------------------------------------
    # Edge Signs Determination
    # -------------------------------------------------------------
    edge_sign_predictions = np.zeros((n_genes, n_genes), dtype=np.float64)
    for i in range(n_genes):
        for j in range(n_genes):
            if inferred_network[i, j] > 0.0:
                if W_ode[i, j] != 0.0:
                    edge_sign_predictions[i, j] = 1.0 if W_ode[i, j] > 0 else -1.0
                elif W_pert[i, j] != 0.0:
                    edge_sign_predictions[i, j] = 1.0 if W_pert[i, j] > 0 else -1.0
                else:
                    edge_sign_predictions[i, j] = 1.0
            else:
                edge_sign_predictions[i, j] = 0.0

    # -------------------------------------------------------------
    # Hub Genes & Network Metrics
    # -------------------------------------------------------------
    # Under [i, j] = j -> i convention:
    # in-degree is row sum: sum_j (net[i, j] > 0)
    # out-degree is column sum: sum_i (net[i, j] > 0)
    binary_topology = (inferred_network > 0).astype(int)
    in_degrees = np.sum(binary_topology, axis=1)   # row sum
    out_degrees = np.sum(binary_topology, axis=0)  # col sum

    # Top-2 most influential regulator genes by out-degree
    # Break ties by total regulatory strength (column sum of inferred_network)
    out_strengths = np.sum(inferred_network, axis=0)
    sorted_regulators = sorted(
        range(n_genes),
        key=lambda g: (out_degrees[g], out_strengths[g]),
        reverse=True
    )
    top_2_hubs = [int(g) for g in sorted_regulators[:2]]
    print(f"Top 2 Hub Genes identified: {top_2_hubs} (out-degrees: {[out_degrees[g] for g in top_2_hubs]})")

    # Network Metrics
    network_metrics = {
        "n_genes": int(n_genes),
        "n_edges": int(actual_edges),
        "density": float(actual_density),
        "degree_convention": "[i, j] = regulator j -> target i",
        "in_degree": {
            "mean": float(np.mean(in_degrees)),
            "std": float(np.std(in_degrees)),
            "min": int(np.min(in_degrees)),
            "max": int(np.max(in_degrees)),
            "values": [int(d) for d in in_degrees]
        },
        "out_degree": {
            "mean": float(np.mean(out_degrees)),
            "std": float(np.std(out_degrees)),
            "min": int(np.min(out_degrees)),
            "max": int(np.max(out_degrees)),
            "values": [int(d) for d in out_degrees]
        },
        "degree_statistics": {
            "in_degree_mean": float(np.mean(in_degrees)),
            "in_degree_std": float(np.std(in_degrees)),
            "out_degree_mean": float(np.mean(out_degrees)),
            "out_degree_std": float(np.std(out_degrees))
        }
    }

    # Method comparison
    method_comparison = {
        "methods": [
            {
                "name": "Dynamic Continuous-Time ODE Regression",
                "description": "Continuous-time dynamical modeling dx_i/dt = sum_j W_ij x_j - alpha_i x_i using spline/gradient finite differences with coordinate-descent ElasticNet regularization across 5 time-course experiments.",
                "mean_r2": float(round(mean_r2_ode, 4)),
                "score": float(round(mean_r2_ode, 4)),
                "weight": 0.5,
                "strengths": "Directly models temporal rate of change, effectively separating direct causal kinetics from indirect downstream cascades, and provides accurate regulatory sign determination.",
                "limitations": "Approximates non-linear transcription kinetics with a regularized linear model around observed trajectories."
            },
            {
                "name": "Steady-State Perturbation Response Model",
                "description": "Differential perturbation sensitivity modeling Delta X = P * E under 15 molecular intervention experiments with Ridge regularization.",
                "mean_r2": float(round(pert_r2, 4)),
                "score": float(round(pert_r2, 4)),
                "weight": 0.5,
                "strengths": "Directly measures the downstream effects of targeted causal interventions (knockouts and overexpressions) under equilibrium conditions.",
                "limitations": "Equilibrium measurements incorporate both direct interactions and multi-step cascade effects across 15 conditions."
            }
        ],
        "ensemble_rationale": "Rank-based consensus combination of continuous dynamical modeling and steady-state perturbation profiling provides mutual validation, mitigating time-series collinearity while filtering indirect steady-state cascades."
    }

    hub_genes_data = {
        "hub_genes": top_2_hubs
    }

    # Save all required output files
    np.save('inferred_network.npy', inferred_network.astype(np.float64))
    np.save('edge_sign_predictions.npy', edge_sign_predictions.astype(np.float64))

    with open('hub_genes.json', 'w') as f:
        json.dump(hub_genes_data, f, indent=2)

    with open('method_comparison.json', 'w') as f:
        json.dump(method_comparison, f, indent=2)

    with open('network_metrics.json', 'w') as f:
        json.dump(network_metrics, f, indent=2)

    print("All artifacts successfully generated and validated.")


if __name__ == '__main__':
    main()
