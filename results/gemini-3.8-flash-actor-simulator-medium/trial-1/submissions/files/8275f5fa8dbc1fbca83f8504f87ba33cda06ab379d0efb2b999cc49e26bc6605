#!/usr/bin/env python3
"""
Analysis of non-reference exonic variants in CHIP genes across 86 samples.
"""

import glob
import os
import pandas as pd

def main():
    # 1. Load CHIP genes list
    chip_genes_file = 'data/230214_Schenz_et_al_2022_CHIP_Genes.xlsx'
    df_chip_genes = pd.read_excel(chip_genes_file, header=None)
    chip_genes = set(df_chip_genes[0].dropna().astype(str).str.strip().unique())
    print(f"Loaded {len(chip_genes)} curated CHIP genes from {chip_genes_file}.")

    # 2. Define exonic sequence ontology categories
    exonic_so = {
        'frameshift_variant',
        'inframe_deletion',
        'inframe_insertion',
        'missense_variant',
        'synonymous_variant'
    }

    # 3. Process all 86 sample files
    sample_files = sorted(glob.glob('data/CHIP_DP10_GQ20_PASS/*.xlsx'))
    print(f"Found {len(sample_files)} sample files in data/CHIP_DP10_GQ20_PASS/.")

    total_variants_read = 0
    ref_calls_filtered = 0
    non_ref_calls = 0
    non_chip_calls_filtered = 0
    non_exonic_calls_filtered = 0

    retained_records = []

    for fpath in sample_files:
        sample_name = os.path.basename(fpath).replace('230209_Exome_GRCh38_CHIP_', '').replace('.xlsx', '')
        df = pd.read_excel(fpath, header=[0, 1])
        total_variants_read += len(df)

        # Locate key columns
        chr_pos_col = [c for c in df.columns if c[1] == 'Chr:Pos'][0]
        ref_alt_col = [c for c in df.columns if c[1] == 'Ref/Alt'][0]
        zyg_col = [c for c in df.columns if c[1] == 'Zygosity'][0]
        gene_col = [c for c in df.columns if c[1] == 'Gene Names'][0]
        so_col = [c for c in df.columns if 'Sequence Ontology' in c[1]][0]

        for idx, row in df.iterrows():
            zyg = row[zyg_col]
            if zyg == 'Reference':
                ref_calls_filtered += 1
                continue
            
            non_ref_calls += 1
            
            # Gene check (must strictly match one of the 56 CHIP genes)
            gene_val = str(row[gene_col])
            genes_in_row = [g.strip() for g in gene_val.split(',')]
            is_chip = any(g in chip_genes for g in genes_in_row)
            if not is_chip:
                non_chip_calls_filtered += 1
                continue

            # Region / sequence ontology check
            so_val = row[so_col]
            if so_val not in exonic_so:
                non_exonic_calls_filtered += 1
                continue

            # Retained exonic non-ref CHIP variant call
            retained_records.append({
                'sample': sample_name,
                'chr_pos': row[chr_pos_col],
                'ref_alt': row[ref_alt_col],
                'var_id': f"{row[chr_pos_col]}_{row[ref_alt_col]}",
                'zygosity': zyg,
                'gene': gene_val,
                'sequence_ontology': so_val
            })

    df_retained = pd.DataFrame(retained_records)
    accumulated_count = len(df_retained)
    unique_count = df_retained['var_id'].nunique()

    print("\n--- Summary of Filtering ---")
    print(f"Total variant rows processed: {total_variants_read}")
    print(f"Reference calls filtered out: {ref_calls_filtered}")
    print(f"Non-reference calls: {non_ref_calls}")
    print(f"Non-CHIP gene calls filtered out: {non_chip_calls_filtered}")
    print(f"Non-exonic / intronic / UTR calls filtered out: {non_exonic_calls_filtered}")
    print(f"\nTotal non-reference exonic variant calls (accumulated across 86 samples): {accumulated_count}")
    print(f"Distinct unique genomic variants (Chr:Pos + Ref/Alt): {unique_count}")

    print("\nBreakdown by Sequence Ontology (accumulated calls):")
    print(df_retained['sequence_ontology'].value_counts())

    print("\nTop 10 CHIP genes by variant count:")
    print(df_retained['gene'].value_counts().head(10))

    # Save retained variants table
    output_csv = 'retained_exonic_chip_variants.csv'
    df_retained.to_csv(output_csv, index=False)
    print(f"\nSaved retained variants to {output_csv}.")

if __name__ == '__main__':
    main()
