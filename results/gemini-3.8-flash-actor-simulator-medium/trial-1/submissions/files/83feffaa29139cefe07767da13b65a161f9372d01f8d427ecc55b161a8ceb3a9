#!/usr/bin/env python3
"""
Analysis of average number of CHIP variants per sample after filtering
out intronic, intergenic, and UTR variants.
"""

import glob
import os
import re
import pandas as pd
import numpy as np

def main():
    data_dir = 'data/CHIP_DP10_GQ20_PASS'
    files = sorted(glob.glob(os.path.join(data_dir, '*.xlsx')))
    if not files:
        raise FileNotFoundError(f"No Excel files found in {data_dir}")

    print(f"Found {len(files)} sample files in {data_dir}")

    results = []

    for f in files:
        df = pd.read_excel(f, header=[0, 1])
        fname = os.path.basename(f)
        sample_id = re.sub(r'^230209_Exome_GRCh38_CHIP_', '', os.path.splitext(fname)[0])

        zyg_col = [c for c in df.columns if c[1] == 'Zygosity'][0]
        so_col = [c for c in df.columns if c[1] == 'Sequence Ontology (Combined)'][0]

        # Identify actual variant calls for this sample (non-reference and non-null)
        is_variant = df[zyg_col].isin(['Heterozygous', 'Homozygous Variant'])

        # Classify sequence ontology terms
        so_series = df[so_col].astype(str)
        is_intron = so_series == 'intron_variant'
        is_utr = so_series.str.contains('UTR')
        is_upstream = so_series == 'upstream_gene_variant'

        # Option A: Exclude intronic, UTR, and upstream_gene_variant (intergenic)
        kept_intergenic_excl = is_variant & (~is_intron) & (~is_utr) & (~is_upstream)

        # Option B: Exclude intronic and UTR variants only
        kept_intron_utr_only = is_variant & (~is_intron) & (~is_utr)

        results.append({
            'file': fname,
            'sample_id': sample_id,
            'total_rows': len(df),
            'raw_variants': int(is_variant.sum()),
            'variants_filtered_strict': int(kept_intergenic_excl.sum()),
            'variants_filtered_broad': int(kept_intron_utr_only.sum())
        })

    res_df = pd.DataFrame(results)
    
    n_samples = len(res_df)
    total_strict = res_df['variants_filtered_strict'].sum()
    mean_strict = res_df['variants_filtered_strict'].mean()

    total_broad = res_df['variants_filtered_broad'].sum()
    mean_broad = res_df['variants_filtered_broad'].mean()

    print("\n--- Summary of Results ---")
    print(f"Number of samples: {n_samples}")
    print(f"Option A (filtering intron, UTR, and upstream_gene_variant as intergenic):")
    print(f"  Total variants: {total_strict}")
    print(f"  Average per sample: {mean_strict:.4f} (approx. {mean_strict:.2f})")
    print(f"Option B (filtering intron and UTR variants only):")
    print(f"  Total variants: {total_broad}")
    print(f"  Average per sample: {mean_broad:.4f} (approx. {mean_broad:.2f})")

    # Save summary table
    res_df.to_csv('chip_variants_summary.csv', index=False)
    print("Saved sample summary to chip_variants_summary.csv")

if __name__ == '__main__':
    main()
