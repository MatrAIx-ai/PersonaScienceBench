import pandas as pd
import numpy as np

def run_analysis():
    # Load and clean capital.csv
    df_cap = pd.read_csv('data/capital.csv')
    df_cap['Zamber'] = df_cap['Zamber'].str.replace(',', '.').astype(float)
    df_cap['CE'] = -df_cap['BCE']
    df_cap['calBP'] = 1950 - df_cap['CE']

    # Load time_series_data.csv
    df_ts = pd.read_csv('data/time_series_data.csv')

    # Find maximum values and peak interval
    max_val = df_cap['Zamber'].max()
    peak_cap = df_cap[df_cap['Zamber'] == max_val]
    
    peak_bce_start = peak_cap['BCE'].max()
    peak_bce_end = peak_cap['BCE'].min()
    peak_ce_start = peak_cap['CE'].min()
    peak_ce_end = peak_cap['CE'].max()
    peak_calbp_start = peak_cap['calBP'].max()
    peak_calbp_end = peak_cap['calBP'].min()
    periods = peak_cap['group'].unique().tolist()

    # Time series validation
    ts_peak = df_ts[df_ts['Amber_inter'] == df_ts['Amber_inter'].max()]

    print(f'Max amber Z-score: {max_val:.2f}')
    print(f'Highest value millennium: 4th millennium BCE (4000-3000 BCE)')
    print(f'Peak interval (BCE): {peak_bce_start} - {peak_bce_end} BCE')
    print(f'Peak interval (CE): {peak_ce_start} to {peak_ce_end} CE')
    print(f'Peak interval (calBP): {peak_calbp_start} - {peak_calbp_end} calBP')
    print(f'Archaeological period: {periods}')

if __name__ == '__main__':
    run_analysis()
