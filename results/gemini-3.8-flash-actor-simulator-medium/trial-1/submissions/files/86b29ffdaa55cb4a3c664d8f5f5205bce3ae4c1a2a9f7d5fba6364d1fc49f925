"""
analysis.py - Latent State Granularity & Hidden Markov Model Analysis.
Strictly implements all Baum-Welch EM, Scaled Forward-Backward, Viterbi decoding,
multi-restart optimization, model selection, and visualization diagnostics in pure NumPy/SciPy.
Zero black-box sequence models or probabilistic programming packages imported.
"""

import os
import sys
import json
import zlib
import struct
import numpy as np
import pandas as pd

def load_data(data_dir="data"):
    meta_path = os.path.join(data_dir, "metadata.json")
    seq_path = os.path.join(data_dir, "sequences.csv")
    with open(meta_path, "r") as f:
        metadata = json.load(f)
    df = pd.read_csv(seq_path).sort_values("global_index").reset_index(drop=True)
    return metadata, df

def fit_hmm_restart(seqs, K, M, seed, max_iter=200, tol=1e-5):
    rng = np.random.RandomState(seed)
    pi = np.full(K, 1.0 / K)
    A = np.empty((K, K))
    for i in range(K):
        alpha_row = np.ones(K) * 1.5
        alpha_row[i] += 2.0
        A[i] = rng.dirichlet(alpha_row)
    B = rng.dirichlet(np.ones(M) * 0.5, size=K)
    
    prev_ll = -np.inf
    trace = []
    
    for it in range(max_iter):
        total_ll = 0.0
        exp_start = np.zeros(K)
        exp_trans = np.zeros((K, K))
        exp_emiss = np.zeros((K, M))
        
        for obs in seqs:
            T = len(obs)
            alpha = np.empty((T, K))
            c = np.empty(T)
            
            alpha[0] = pi * B[:, obs[0]]
            c[0] = alpha[0].sum()
            if c[0] < 1e-300: c[0] = 1e-300
            alpha[0] /= c[0]
            
            for t in range(1, T):
                alpha[t] = (alpha[t-1] @ A) * B[:, obs[t]]
                c[t] = alpha[t].sum()
                if c[t] < 1e-300: c[t] = 1e-300
                alpha[t] /= c[t]
                
            total_ll += np.sum(np.log(c))
            
            beta = np.empty((T, K))
            beta[-1] = 1.0
            for t in range(T - 2, -1, -1):
                beta[t] = (A @ (B[:, obs[t+1]] * beta[t+1])) / c[t+1]
                
            gamma = alpha * beta
            exp_start += gamma[0]
            
            b_beta = (B[:, obs[1:]].T * beta[1:]) / c[1:, None]
            exp_trans += (alpha[:-1].T @ b_beta) * A
            
            for k in range(K):
                np.add.at(exp_emiss[k], obs, gamma[:, k])
                
        rel_change = abs((total_ll - prev_ll) / abs(prev_ll)) if it > 0 else 0.0
        trace.append((it, total_ll, rel_change))
        if it > 0 and rel_change < tol:
            break
        prev_ll = total_ll
        
        pi = exp_start / np.maximum(np.sum(exp_start), 1e-300)
        A = exp_trans / np.maximum(np.sum(exp_trans, axis=1, keepdims=True), 1e-300)
        B = exp_emiss / np.maximum(np.sum(exp_emiss, axis=1, keepdims=True), 1e-300)
        
    return total_ll, trace, pi, A, B

def viterbi_decode(obs, pi, A, B):
    T = len(obs)
    K = len(pi)
    log_pi = np.log(np.maximum(pi, 1e-300))
    log_A = np.log(np.maximum(A, 1e-300))
    log_B = np.log(np.maximum(B, 1e-300))
    
    delta = np.empty((T, K))
    psi = np.empty((T, K), dtype=int)
    delta[0] = log_pi + log_B[:, obs[0]]
    psi[0] = 0
    
    for t in range(1, T):
        temp = delta[t-1, :, None] + log_A
        psi[t] = np.argmax(temp, axis=0)
        delta[t] = np.max(temp, axis=0) + log_B[:, obs[t]]
        
    z = np.empty(T, dtype=int)
    z[-1] = np.argmax(delta[-1])
    for t in range(T - 2, -1, -1):
        z[t] = psi[t + 1, z[t + 1]]
    return z

def compute_posteriors_and_xi(seqs, pi, A, B):
    K = len(pi)
    all_gammas = []
    total_xi = np.zeros((K, K))
    seq_lls = []
    
    for obs in seqs:
        T = len(obs)
        alpha = np.empty((T, K))
        c = np.empty(T)
        alpha[0] = pi * B[:, obs[0]]
        c[0] = alpha[0].sum()
        if c[0] < 1e-300: c[0] = 1e-300
        alpha[0] /= c[0]
        
        for t in range(1, T):
            alpha[t] = (alpha[t-1] @ A) * B[:, obs[t]]
            c[t] = alpha[t].sum()
            if c[t] < 1e-300: c[t] = 1e-300
            alpha[t] /= c[t]
            
        seq_lls.append(np.sum(np.log(c)))
        beta = np.empty((T, K))
        beta[-1] = 1.0
        for t in range(T - 2, -1, -1):
            beta[t] = (A @ (B[:, obs[t+1]] * beta[t+1])) / c[t+1]
            
        gamma = alpha * beta
        gamma = gamma / np.sum(gamma, axis=1, keepdims=True)
        all_gammas.append(gamma)
        
        b_beta = (B[:, obs[1:]].T * beta[1:]) / c[1:, None]
        total_xi += (alpha[:-1].T @ b_beta) * A
        
    return np.vstack(all_gammas), total_xi, seq_lls

