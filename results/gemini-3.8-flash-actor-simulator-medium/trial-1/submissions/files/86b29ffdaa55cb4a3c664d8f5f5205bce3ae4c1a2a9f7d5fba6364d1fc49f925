def draw_text(canvas, text, x0, y0, color=(0, 0, 0), scale=1):
    h, w, _ = canvas.shape
    text = str(text).upper()
    curr_x = x0
    for ch in text:
        bitmap = FONT_5x7.get(ch, FONT_5x7[' '])
        for row_idx, byte_val in enumerate(bitmap):
            for col_idx in range(5):
                if (byte_val >> (7 - col_idx)) & 1:
                    for dx in range(scale):
                        for dy in range(scale):
                            px = curr_x + col_idx * scale + dx
                            py = y0 + row_idx * scale + dy
                            if 0 <= px < w and 0 <= py < h:
                                canvas[py, px] = color
        curr_x += 6 * scale

def fill_rect(canvas, x1, y1, x2, y2, color):
    h, w, _ = canvas.shape
    x1, x2 = max(0, min(x1, x2)), min(w, max(x1, x2))
    y1, y2 = max(0, min(y1, y2)), min(h, max(y1, y2))
    if x2 > x1 and y2 > y1:
        canvas[y1:y2, x1:x2] = color

def draw_line(canvas, x0, y0, x1, y1, color, thickness=1):
    h, w, _ = canvas.shape
    length = int(np.hypot(x1 - x0, y1 - y0))
    if length == 0:
        fill_rect(canvas, x0, y0, x0 + thickness, y0 + thickness, color)
        return
    xs = np.linspace(x0, x1, length * 2).astype(int)
    ys = np.linspace(y0, y1, length * 2).astype(int)
    half = thickness // 2
    for dx in range(-half, half + 1):
        for dy in range(-half, half + 1):
            valid = (xs + dx >= 0) & (xs + dx < w) & (ys + dy >= 0) & (ys + dy < h)
            canvas[ys[valid] + dy, xs[valid] + dx] = color

def save_png(filename, img_array):
    h, w, _ = img_array.shape
    raw_bytes = bytearray()
    for row in img_array:
        raw_bytes.append(0)
        raw_bytes.extend(row.tobytes())
    def chunk(tag, data):
        return struct.pack('>I', len(data)) + tag + data + struct.pack('>I', zlib.crc32(tag + data) & 0xffffffff)
    header = b'\x89PNG\r\n\x1a\n'
    ihdr = chunk(b'IHDR', struct.pack('>IIBBBBB', w, h, 8, 2, 0, 0, 0))
    idat = chunk(b'IDAT', zlib.compress(bytes(raw_bytes), level=9))
    iend = chunk(b'IEND', b'')
    with open(filename, 'wb') as f:
        f.write(header + ihdr + idat + iend)
