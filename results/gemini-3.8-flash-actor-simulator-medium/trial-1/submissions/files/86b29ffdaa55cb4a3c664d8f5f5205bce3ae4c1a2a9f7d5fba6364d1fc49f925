def run_analysis():
    print("=== Step 1: Loading observation sequences and metadata ===")
    metadata, df = load_data("data")
    alphabet = {item["symbol"]: item["label"] for item in metadata["alphabet"]}
    M = len(alphabet)
    N_obs = len(df)
    
    seq_groups = [g["symbol"].values for _, g in df.groupby("sequence_id", sort=False)]
    print(f"Loaded {len(seq_groups)} sequences, total observations: {N_obs}, alphabet size: {M}")
    
    candidates = [2, 3, 4, 5, 6, 7, 8]
    print(f"Evaluating candidate granularities: {candidates}")
    
    cand_records = []
    models_dict = {}
    
    for K in candidates:
        print(f"--- Fitting candidate K={K} ---")
        best_ll = -np.inf
        best_model = None
        restarts_traces = []
        
        for r in range(6):
            seed = 100 * K + r * 17 + 3
            ll, trace, pi, A, B = fit_hmm_restart(seq_groups, K, M, seed)
            restarts_traces.append((r, trace))
            if ll > best_ll:
                best_ll = ll
                best_model = (ll, pi, A, B, trace)
                
        n_free = (K - 1) + K * (K - 1) + K * (M - 1)
        bic = -2 * best_ll + n_free * np.log(N_obs)
        cand_records.append({
            "candidate": K,
            "n_free_values": n_free,
            "objective": best_ll,
            "criterion": bic,
            "chosen": False
        })
        models_dict[K] = (best_model, restarts_traces)
        print(f"K={K}: Best Log-Likelihood={best_ll:.2f}, BIC={bic:.2f}, Free params={n_free}")
        
    cand_df = pd.DataFrame(cand_records)
    best_cand_idx = cand_df['criterion'].idxmin()
    chosen_K = cand_df.loc[best_cand_idx, 'candidate']
    cand_df.loc[best_cand_idx, 'chosen'] = True
    print(f"\n===> Selected optimal granularity: K={chosen_K} (BIC minimum: {cand_df.loc[best_cand_idx, 'criterion']:.2f})")
    
    os.makedirs("results", exist_ok=True)
    
    # 1. candidate_summary.csv
    cand_df.to_csv("results/candidate_summary.csv", index=False)
    print("Wrote results/candidate_summary.csv")
    
    (chosen_ll, chosen_pi, chosen_A, chosen_B, chosen_best_trace), chosen_restarts = models_dict[chosen_K]
    
    # 2. matrix_a.csv
    matrix_a_rows = []
    for r in range(chosen_K):
        for c in range(chosen_K):
            matrix_a_rows.append({"row": r, "column": c, "value": chosen_A[r, c]})
    pd.DataFrame(matrix_a_rows).to_csv("results/matrix_a.csv", index=False)
    print("Wrote results/matrix_a.csv")
    
    # 3. matrix_b.csv
    matrix_b_rows = []
    for r in range(chosen_K):
        for m in range(M):
            matrix_b_rows.append({
                "row": r,
                "symbol": m,
                "symbol_label": alphabet[m],
                "value": chosen_B[r, m]
            })
    pd.DataFrame(matrix_b_rows).to_csv("results/matrix_b.csv", index=False)
    print("Wrote results/matrix_b.csv")
    
    # 4. vector_a.csv
    vector_a_rows = [{"row": r, "value": chosen_pi[r]} for r in range(chosen_K)]
    pd.DataFrame(vector_a_rows).to_csv("results/vector_a.csv", index=False)
    print("Wrote results/vector_a.csv")
    
    # 5. fit_trace.csv
    fit_trace_rows = []
    for r_idx, (_, trace) in enumerate(chosen_restarts):
        for step, obj, rel_chg in trace:
            fit_trace_rows.append({
                "run": r_idx,
                "step": step,
                "objective": obj,
                "relative_change": rel_chg
            })
    pd.DataFrame(fit_trace_rows).to_csv("results/fit_trace.csv", index=False)
    print("Wrote results/fit_trace.csv")
    
    # Posteriors and expected transitions
    all_gammas, total_xi, seq_lls = compute_posteriors_and_xi(seq_groups, chosen_pi, chosen_A, chosen_B)
    
    # 6. local_weights.npy
    np.save("results/local_weights.npy", all_gammas)
    print(f"Wrote results/local_weights.npy (shape: {all_gammas.shape})")
    
    # 7. neighbor_summary.csv
    total_weight = total_xi.sum()
    row_weights = total_xi.sum(axis=1, keepdims=True)
    neighbor_rows = []
    for r in range(chosen_K):
        for c in range(chosen_K):
            w = total_xi[r, c]
            jf = w / total_weight
            cv = w / row_weights[r, 0]
            neighbor_rows.append({
                "row": r,
                "column": c,
                "weight": w,
                "joint_fraction": jf,
                "conditional_value": cv
            })
    pd.DataFrame(neighbor_rows).to_csv("results/neighbor_summary.csv", index=False)
    print("Wrote results/neighbor_summary.csv")
    
    # 8. local_assignments.csv
    assignment_rows = []
    seq_viterbi_dict = {}
    for s_meta, obs in zip(metadata["sequence_summaries"], seq_groups):
        s_id = s_meta["sequence_id"]
        start_gidx = s_meta["first_global_index"]
        z_seq = viterbi_decode(obs, chosen_pi, chosen_A, chosen_B)
        seq_viterbi_dict[s_id] = z_seq
        for pos, (sym, lbl) in enumerate(zip(obs, z_seq)):
            assignment_rows.append({
                "sequence_id": s_id,
                "position": pos,
                "global_index": start_gidx + pos,
                "label": int(lbl)
            })
    assignments_df = pd.DataFrame(assignment_rows)
    assignments_df.to_csv("results/local_assignments.csv", index=False)
    print("Wrote results/local_assignments.csv")
    
    # 9. stream_diagnostics.csv
    stream_rows = []
    curr_idx = 0
    for s_meta, s_ll in zip(metadata["sequence_summaries"], seq_lls):
        s_id = s_meta["sequence_id"]
        n_pos = s_meta["n_positions"]
        gamma_s = all_gammas[curr_idx : curr_idx + n_pos]
        curr_idx += n_pos
        
        eps = 1e-12
        gamma_safe = np.maximum(gamma_s, eps)
        ent = -np.sum(gamma_safe * np.log(gamma_safe), axis=1)
        mean_ent = float(ent.mean())
        
        s_labels = assignments_df[assignments_df["sequence_id"] == s_id]["label"].values
        _, counts = np.unique(s_labels, return_counts=True)
        dominant_frac = float(counts.max() / n_pos)
        
        stream_rows.append({
            "sequence_id": s_id,
            "n_positions": n_pos,
            "mean_objective": float(s_ll / n_pos),
            "weight_entropy_mean": mean_ent,
            "dominant_label_fraction": dominant_frac
        })
    pd.DataFrame(stream_rows).to_csv("results/stream_diagnostics.csv", index=False)
    print("Wrote results/stream_diagnostics.csv")
    
    # 10. diagnostics.png
    chosen_traces_list = [trace for _, trace in chosen_restarts]
    generate_diagnostics_image(
        "results/diagnostics.png",
        cand_df,
        chosen_traces_list,
        chosen_A,
        chosen_B,
        seq_viterbi_dict
    )
    print("Wrote results/diagnostics.png")
    print("\n=== Analysis completed successfully. All 10 artifacts generated. ===")

