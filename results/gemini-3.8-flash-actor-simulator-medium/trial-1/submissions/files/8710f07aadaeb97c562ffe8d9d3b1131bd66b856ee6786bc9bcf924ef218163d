import pandas as pd
import numpy as np
from scipy import stats

# 1. Load sample metadata and identify CD14 samples
sample_meta = pd.read_csv('data/Sample_annotated_Zenodo.csv')
cd14_samples = sample_meta[sample_meta['celltype'] == 'CD14']['sample'].tolist()
print(f"Number of CD14 samples identified: {len(cd14_samples)}")

# 2. Load gene metadata and filter for protein-coding genes
gene_meta = pd.read_csv('data/GeneMetaInfo_Zenodo.csv')
pc_gene_meta = gene_meta[gene_meta['gene_biotype'] == 'protein_coding'].copy()
print(f"Number of protein-coding genes identified: {len(pc_gene_meta)}")

# Ensure Geneid is string and index by Geneid
pc_gene_meta.set_index('Geneid', inplace=True)

# 3. Load batch-corrected read counts for CD14 samples
# The first column is the gene identifier
counts = pd.read_csv('data/BatchCorrectedReadCounts_Zenodo.csv', index_col=0)

# Filter for protein-coding genes and CD14 sample columns
counts_pc_cd14 = counts.loc[pc_gene_meta.index, cd14_samples]
print(f"Counts subset shape: {counts_pc_cd14.shape}")

# 4. Compute mean expression across CD14 samples for each protein-coding gene
mean_expression = counts_pc_cd14.mean(axis=1)

# Align with gene length
gene_lengths = pc_gene_meta['Length']

# Double-check alignment
assert (mean_expression.index == gene_lengths.index).all()

# 5. Compute Pearson correlation coefficient
corr, p_value = stats.pearsonr(gene_lengths, mean_expression)

print(f"Pearson correlation coefficient (r): {corr}")
print(f"p-value: {p_value}")

# Summary stats
print(f"Length summary: min={gene_lengths.min()}, max={gene_lengths.max()}, mean={gene_lengths.mean():.2f}, median={gene_lengths.median():.2f}")
print(f"Mean expression summary: min={mean_expression.min():.2f}, max={mean_expression.max():.2f}, mean={mean_expression.mean():.2f}, median={mean_expression.median():.2f}")

# Also check log2 transformed out of curiosity / diagnostics
corr_log, p_log = stats.pearsonr(np.log10(gene_lengths), np.log10(mean_expression + 1))
print(f"Log10 Pearson correlation: {corr_log}")

corr_spearman, p_spearman = stats.spearmanr(gene_lengths, mean_expression)
print(f"Spearman correlation: {corr_spearman}")
