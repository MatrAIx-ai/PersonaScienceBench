import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf

# Load dataset
df = pd.read_csv('data/invaded_niche_pathways.csv', sep='\t')
df.columns = [c.replace('.', '_') for c in df.columns]

# Pathway definitions
pathways = {
    'n_gard': 'Gardening / Ornamental',
    'n_unint': 'Unintentional / Accidental',
    'n_agfo': 'AgriForest / Agriculture & Forestry',
    'n_total': 'Total Non-native Flora'
}

scales = ['50m', '500m', '1000m']
years = ['1956', '1993', '2009']

print("=== STATISTICAL SUMMARY OF INTRODUCTION PATHWAYS VS URBAN COVER ===")
for p, name in pathways.items():
    print(f"\nPathway: {name} ({p})")
    for scale in scales:
        u_col = f'urban_2009_{scale}'
        rho = df[p].corr(df[u_col], method='spearman')
        m_poi = smf.glm(f'{p} ~ {u_col}', data=df, family=sm.families.Poisson()).fit()
        m_nb = smf.glm(f'{p} ~ {u_col}', data=df, family=sm.families.NegativeBinomial()).fit()
        print(f"  Scale {scale:5s} | Spearman rho = {rho:.3f} | Poisson coef = {m_poi.params[u_col]:.3f} (p = {m_poi.pvalues[u_col]:.2e}) | NegBin coef = {m_nb.params[u_col]:.3f} (p = {m_nb.pvalues[u_col]:.2e})")

# Multivariable Poisson GLM controlling for cropland, elevation, road distance, and stream distance
print("\n=== MULTIVARIABLE GLM (urban_2009_1000m + cropland_2009_1000m + elevation + distance_road + distance_stream) ===")
for p, name in pathways.items():
    formula = f'{p} ~ urban_2009_1000m + cropland_2009_1000m + elevation + distance_road + distance_stream'
    res = smf.glm(formula, data=df, family=sm.families.Poisson()).fit()
    print(f"{name:35s}: urban coef = {res.params['urban_2009_1000m']:+.3f}, z = {res.tvalues['urban_2009_1000m']:+.2f}, p = {res.pvalues['urban_2009_1000m']:.4e}")
