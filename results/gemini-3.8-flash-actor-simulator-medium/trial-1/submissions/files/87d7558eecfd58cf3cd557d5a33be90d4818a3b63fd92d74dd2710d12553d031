from __future__ import annotations

from typing import Any
import numpy as np


class LowRegretOptimisticQAgent:
    """Tabular, online, model-free optimistic Q-learning agent.

    Incorporates:
    1. Bounded episode trace (length H) with reverse-chronological value propagation
       to eliminate downstream target lag within episodes.
    2. Centered running variance estimation tracking deviations from an adaptive
       continuation baseline, mitigating spurious target drift burn-in.
    3. Horizon-indexed Bernstein-style confidence bonus with visit-dependent learning rates.
    4. Strict value clamping within the remaining-horizon bounds [0, H - h + 1].
    5. O(H * S * A) storage with zero transition-model or next-state count tensors.
    """

    def __init__(self, env_spec: dict[str, Any], seed: int) -> None:
        self.H = int(env_spec["H"])
        self.S = int(env_spec["S"])
        self.A = int(env_spec["A"])
        self.K = int(env_spec.get("K", 1000))
        self.rng = np.random.default_rng(seed)

        # Hyperparameters (single shared algorithm configuration across all cases)
        self.c_var = 0.2
        self.c_bonus = 0.01
        self.beta = 0.2
        self.iota = float(np.log(self.S * self.A * self.H * self.K + 1.0))

        # Horizon-indexed tabular storage (1-indexed h: h = 1, ..., H)
        # Dimensions are O(H * S * A)
        self.Q = np.zeros((self.H + 2, self.S, self.A), dtype=np.float64)
        for h in range(1, self.H + 1):
            self.Q[h] = float(self.H - h + 1)

        self.V = np.zeros((self.H + 2, self.S), dtype=np.float64)
        for h in range(1, self.H + 1):
            self.V[h] = float(self.H - h + 1)

        self.N = np.zeros((self.H + 2, self.S, self.A), dtype=np.int32)

        # Baseline continuation value and running variance for centered Bernstein bonus
        self.baseline = np.zeros((self.H + 2, self.S, self.A), dtype=np.float64)
        for h in range(1, self.H + 1):
            self.baseline[h] = float(self.H - h)

        self.var = np.zeros((self.H + 2, self.S, self.A), dtype=np.float64)

        # Bounded single-episode trace (at most H steps)
        self.trace: list[tuple[int, int, int, float, int, bool]] = []

    def reset_episode(self, episode: int, state: int | None = None) -> None:
        self.trace.clear()

    def act(self, h: int, state: int) -> int:
        q_vals = self.Q[h, state]
        max_q = np.max(q_vals)
        best_actions = np.flatnonzero(np.isclose(q_vals, max_q, atol=1e-8))
        if len(best_actions) == 1:
            return int(best_actions[0])
        return int(self.rng.choice(best_actions))

    def observe(
        self,
        h: int,
        state: int,
        action: int,
        reward: float,
        next_state: int,
        done: bool,
    ) -> None:
        self.trace.append((h, state, action, float(reward), next_state, done))

        if done or h >= self.H:
            # Reverse-chronological trajectory sweep along the bounded episode trace
            for hh, ss, aa, rr, ns, d in reversed(self.trace):
                self.N[hh, ss, aa] += 1
                t = self.N[hh, ss, aa]
                alpha = (self.H + 1.0) / (self.H + t)

                # Target continuation value using freshly updated downstream estimates
                target_v = self.V[hh + 1, ns] if not d else 0.0

                # Adaptive centered variance estimation to remove target-drift artifact
                diff = target_v - self.baseline[hh, ss, aa]
                lr_stat = max(self.beta, alpha)
                self.baseline[hh, ss, aa] += lr_stat * diff
                self.var[hh, ss, aa] = (1.0 - lr_stat) * self.var[hh, ss, aa] + lr_stat * (diff ** 2)

                # Bernstein exploration bonus
                v_est = max(0.0, self.var[hh, ss, aa])
                bonus = self.c_var * np.sqrt(v_est * self.iota / t) + self.c_bonus * (self.H * self.iota / t)

                # Bellman update
                target = rr + target_v + bonus
                self.Q[hh, ss, aa] = (1.0 - alpha) * self.Q[hh, ss, aa] + alpha * target

                # Value clamping within valid remaining horizon range [0, H - h + 1]
                max_valid = float(self.H - hh + 1)
                self.Q[hh, ss, aa] = min(max_valid, max(0.0, self.Q[hh, ss, aa]))
                self.V[hh, ss] = np.max(self.Q[hh, ss])

            self.trace.clear()


def make_agent(env_spec: dict[str, Any], seed: int) -> LowRegretOptimisticQAgent:
    return LowRegretOptimisticQAgent(env_spec, seed)
