#!/usr/bin/env python3
"""
Analysis script for BixBench bix-46-q1:
Log2 fold change for mexG in ΔrhlI (strain #97) compared to wt (strain #1).
"""

import gzip
import struct
import pandas as pd
import numpy as np

def find_mexg_locus_tag(annotation_path: str) -> str:
    df_annot = pd.read_csv(annotation_path)
    mexg_rows = df_annot[df_annot['Gene Name'] == 'mexG']
    if mexg_rows.empty:
        raise ValueError("mexG not found in annotation file.")
    locus_tag = mexg_rows['Locus Tag'].values[0]
    return locus_tag

def parse_deseq_rds(rds_path: str):
    """
    Parses a DESeqResults RDS file from DESeq2.
    Extracts rownames (locus tags) and columns: baseMean, log2FoldChange, lfcSE, stat, pvalue, padj.
    """
    with open(rds_path, 'rb') as f:
        data = gzip.decompress(f.read())
    
    # Check header
    if data[:2] != b'X\n':
        raise ValueError("Unsupported format, expected XDR binary RDS format (X\\n).")
    
    # 1. Parse rownames
    # rownames is a STRSXP located in the attributes pairlist
    pos_rownames = data.find(b'rownames')
    if pos_rownames == -1:
        raise ValueError("rownames slot not found.")
    
    # Read STRSXP header after 'rownames'
    # 'rownames' has 8 bytes. Next is STRSXP flags (4 bytes) and length (4 bytes).
    p = pos_rownames + 8
    flags = struct.unpack('>i', data[p:p+4])[0]
    p += 4
    if (flags & 0xff) != 16:  # STRSXP
        raise ValueError(f"Expected STRSXP (16), got {flags & 0xff}")
    num_rows = struct.unpack('>i', data[p:p+4])[0]
    p += 4
    
    rownames = []
    for _ in range(num_rows):
        cf = struct.unpack('>i', data[p:p+4])[0]
        p += 4
        ctype = cf & 0xff
        if ctype == 9:  # CHARSXP
            slen = struct.unpack('>i', data[p:p+4])[0]
            p += 4
            s = data[p:p+slen].decode('latin1')
            p += slen
            rownames.append(s)
        else:
            raise ValueError(f"Unexpected SEXP type in STRSXP: {ctype}")
    
    # 2. Find REALSXP columns (baseMean, log2FoldChange, lfcSE, stat, pvalue, padj)
    # In DESeqResults listData, each column is a REALSXP (type 14 = 0x0e) of length num_rows.
    target_len_bytes = num_rows.to_bytes(4, 'big')
    # Search for all occurrences of target_len_bytes preceded by REALSXP type (flags & 0xff == 14)
    # After listData offset
    pos_listdata = data.find(b'listData')
    if pos_listdata == -1:
        raise ValueError("listData slot not found.")
    
    col_offsets = []
    curr = pos_listdata
    while True:
        curr = data.find(target_len_bytes, curr)
        if curr == -1:
            break
        # Check if preceding 4 bytes has SEXP type 14
        if curr >= 4:
            flags = struct.unpack('>I', data[curr-4:curr])[0]
            if (flags & 0xff) == 14:
                col_offsets.append(curr + 4)
        curr += 1
    
    if len(col_offsets) < 6:
        raise ValueError(f"Expected at least 6 numeric columns of length {num_rows}, found {len(col_offsets)}")
    
    # The 6 DESeqResults columns are in order: baseMean, log2FoldChange, lfcSE, stat, pvalue, padj
    col_names = ['baseMean', 'log2FoldChange', 'lfcSE', 'stat', 'pvalue', 'padj']
    df_dict = {'locus_tag': rownames}
    
    for name, offset in zip(col_names, col_offsets[:6]):
        values = struct.unpack(f'>{num_rows}d', data[offset:offset + num_rows * 8])
        df_dict[name] = values
        
    df = pd.DataFrame(df_dict)
    return df

def main():
    annot_file = 'data/Pseudomonas_aeruginosa_UCBPP-PA14.csv'
    rds_file = 'data/res_1vs97.rds'
    
    locus_tag = find_mexg_locus_tag(annot_file)
    print(f"Gene mexG corresponds to Locus Tag: {locus_tag}")
    
    df_results = parse_deseq_rds(rds_file)
    print(f"Successfully loaded DESeq results with {len(df_results)} rows.")
    
    mexg_data = df_results[df_results['locus_tag'] == locus_tag].iloc[0]
    
    print("\n--- mexG Expression Statistics in Strain #97 (ΔrhlI) vs Strain #1 (wt) ---")
    for col in ['baseMean', 'log2FoldChange', 'lfcSE', 'stat', 'pvalue', 'padj']:
        print(f"  {col}: {mexg_data[col]}")
        
    l2fc = mexg_data['log2FoldChange']
    lfc_se = mexg_data['lfcSE']
    stat = mexg_data['stat']
    
    # Consistency check
    calculated_stat = l2fc / lfc_se
    print(f"\nConsistency Check:")
    print(f"  Reported stat:   {stat:.8f}")
    print(f"  Calculated stat: {calculated_stat:.8f}")
    assert np.isclose(stat, calculated_stat, rtol=1e-5), "Wald stat does not match log2FC / lfcSE!"
    print("  Assertion passed: stat == log2FC / lfcSE")
    
    rounded_l2fc = round(l2fc, 2)
    print(f"\nFinal log2 fold change rounded to 2 decimal places: {rounded_l2fc:.2f}")

if __name__ == '__main__':
    main()
