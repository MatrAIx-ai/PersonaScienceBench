import pandas as pd
import numpy as np
from scipy.stats import chi2_contingency

def main():
    print("=================================================================")
    print("TASK008 BCG-CORONA: COVID-19 Severity by Patient Volume Group")
    print("=================================================================\n")

    # Load datasets
    dm = pd.read_csv('data/TASK008_BCG-CORONA_DM.csv', encoding='latin1')
    ae = pd.read_csv('data/TASK008_BCG-CORONA_AE.csv', encoding='latin1')

    print(f"DM records: {len(dm)}, AE records: {len(ae)}")
    print("Patient volume categories in DM (patients_seen):")
    print(dm['patients_seen'].value_counts())
    print("\nTreatment groups in DM (TRTGRP):")
    print(dm['TRTGRP'].value_counts())

    # 1. AEPT == 'COVID-19' (Strict Definition)
    covid_strict = ae[ae['AEPT'] == 'COVID-19']
    m_strict = pd.merge(covid_strict, dm, on='USUBJID', suffixes=('_ae', '_dm'))
    print(f"\nTotal COVID-19 records (AEPT == 'COVID-19'): {len(m_strict)}")

    print("\n" + "="*60)
    print("ANALYSIS 1: Strict COVID-19 (AEPT == 'COVID-19') by AEHS (>2 vs <=2)")
    print("="*60)
    for p_grp in ['1-50', '51-100', '>100']:
        sub = m_strict[m_strict['patients_seen'] == p_grp].dropna(subset=['AEHS'])
        sub['severe'] = sub['AEHS'] > 2
        ct = pd.crosstab(sub['TRTGRP_dm'], sub['severe'])
        chi2, p, dof, ex = chi2_contingency(ct, correction=False)
        chi2_c, p_c, _, _ = chi2_contingency(ct, correction=True)
        print(f"\nGroup: {p_grp} (N = {len(sub)})")
        print(ct)
        print(f"Chi-square (uncorrected): {chi2:.4f}, p-value: {p:.5f}")
        print(f"Chi-square (Yates): {chi2_c:.4f}, p-value: {p_c:.5f}")
        if p < 0.05:
            print(">>> STATISTICALLY SIGNIFICANT (p < 0.05) <<<")

    print("\n" + "="*60)
    print("ANALYSIS 2: Strict COVID-19 (AEPT == 'COVID-19') by AESEV (Raw 1,2,3,4)")
    print("="*60)
    for p_grp in ['1-50', '51-100', '>100']:
        sub = m_strict[m_strict['patients_seen'] == p_grp].dropna(subset=['AESEV'])
        ct = pd.crosstab(sub['TRTGRP_dm'], sub['AESEV'])
        chi2, p, dof, ex = chi2_contingency(ct, correction=False)
        print(f"\nGroup: {p_grp} (N = {len(sub)})")
        print(ct)
        print(f"Chi-square: {chi2:.4f}, df: {dof}, p-value: {p:.5f}")
        if p < 0.05:
            print(">>> STATISTICALLY SIGNIFICANT (p < 0.05) <<<")

    print("\n" + "="*60)
    print("ANALYSIS 3: Broad COVID (AEPT contains covid) by AESEV (>2 vs <=2)")
    print("="*60)
    covid_broad = ae[ae['AEPT'].str.contains('covid', case=False, na=False)]
    m_broad = pd.merge(covid_broad, dm, on='USUBJID', suffixes=('_ae', '_dm'))
    for p_grp in ['1-50', '51-100', '>100']:
        sub = m_broad[m_broad['patients_seen'] == p_grp].dropna(subset=['AESEV'])
        sub['severe'] = sub['AESEV'] > 2
        ct = pd.crosstab(sub['TRTGRP_dm'], sub['severe'])
        chi2, p, dof, ex = chi2_contingency(ct, correction=False)
        print(f"\nGroup: {p_grp} (N = {len(sub)})")
        print(ct)
        print(f"Chi-square: {chi2:.4f}, p-value: {p:.5f}")
        if p < 0.05:
            print(">>> STATISTICALLY SIGNIFICANT (p < 0.05) <<<")

    print("\n" + "="*60)
    print("ANALYSIS 4: Subject-level Maximum AEHS for Strict COVID-19")
    print("="*60)
    subj_strict = covid_strict.groupby('USUBJID')['AEHS'].max().reset_index()
    m_subj = pd.merge(subj_strict, dm, on='USUBJID')
    for p_grp in ['1-50', '51-100', '>100']:
        sub = m_subj[m_subj['patients_seen'] == p_grp].dropna(subset=['AEHS'])
        sub['severe'] = sub['AEHS'] > 2
        ct = pd.crosstab(sub['TRTGRP'], sub['severe'])
        chi2, p, dof, ex = chi2_contingency(ct, correction=False)
        print(f"\nGroup: {p_grp} (N = {len(sub)})")
        print(ct)
        print(f"Chi-square: {chi2:.4f}, p-value: {p:.5f}")
        if p < 0.05:
            print(">>> STATISTICALLY SIGNIFICANT (p < 0.05) <<<")

if __name__ == '__main__':
    main()
