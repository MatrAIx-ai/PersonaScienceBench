import pandas as pd
import statsmodels.api as sm
import statsmodels.formula.api as smf

def main():
    # Load data
    df_raw = pd.read_excel('data/data.xlsx')
    
    # Filter to the 80 valid patient records (Sequence number 1 to 80)
    df = df_raw.dropna(subset=['Sequence number']).copy()
    
    # Ensure types
    df['Age'] = pd.to_numeric(df['Age'])
    df['BMI'] = pd.to_numeric(df['BMI'])
    df['Gender'] = df['Gender'].astype(str)
    
    # Binary response: 1 for PR (Partial Response), 0 for non-PR (SD, PD)
    df['PR'] = (df['Efficacy'] == 'PR').astype(int)
    
    # Fit logistic regression model combining BMI, Age, and Gender
    model = smf.logit('PR ~ BMI + Age + C(Gender)', data=df).fit()
    
    print("=== Logistic Regression Model Summary ===")
    print(model.summary())
    
    age_coef = model.params['Age']
    age_se = model.bse['Age']
    age_z = model.tvalues['Age']
    age_pval = model.pvalues['Age']
    
    print("\n=== Age Predictor Statistics ===")
    print(f"Coefficient (Beta): {age_coef:.6f}")
    print(f"Standard Error:     {age_se:.6f}")
    print(f"z-statistic:        {age_z:.6f}")
    print(f"p-value:            {age_pval:.6f}")
    print(f"p-value (scientific): {age_pval:.4e}")
    print(f"Odds Ratio:         {pow(2.718281828459045, age_coef):.6f}")

if __name__ == '__main__':
    main()
