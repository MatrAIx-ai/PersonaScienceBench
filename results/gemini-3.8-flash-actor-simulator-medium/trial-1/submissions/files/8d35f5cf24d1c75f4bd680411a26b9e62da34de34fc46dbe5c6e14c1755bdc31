import pandas as pd
import numpy as np
from scipy.stats import pearsonr

def main():
    # 1. Load sample metadata and select CD14 samples
    print("Loading sample metadata...")
    samples_df = pd.read_csv('data/Sample_annotated_Zenodo.csv')
    cd14_samples = samples_df[samples_df['celltype'] == 'CD14']['sample'].tolist()
    print(f"Total CD14 samples identified: {len(cd14_samples)}")

    # 2. Load gene metadata and select protein-coding genes
    print("Loading gene metadata...")
    gene_df = pd.read_csv('data/GeneMetaInfo_Zenodo.csv')
    pc_mask = gene_df['gene_biotype'] == 'protein_coding'
    pc_genes = gene_df[pc_mask].copy()
    print(f"Total protein-coding genes identified: {len(pc_genes)}")

    # 3. Load batch-corrected read counts for CD14 samples
    print("Loading batch-corrected read counts...")
    use_cols = ['Unnamed: 0'] + cd14_samples
    counts_df = pd.read_csv('data/BatchCorrectedReadCounts_Zenodo.csv', usecols=use_cols)
    
    # Ensure alignment of genes
    counts_pc = counts_df[pc_mask].copy()
    assert (counts_pc['Unnamed: 0'].values == pc_genes['Geneid'].values).all(), "Gene IDs do not match!"

    # 4. Calculate mean expression across CD14 samples
    print("Calculating mean expression across CD14 samples...")
    mean_expression = counts_pc[cd14_samples].mean(axis=1)
    pc_genes['mean_expression'] = mean_expression.values

    # 5. Compute Pearson correlation coefficients
    length = pc_genes['Length'].values
    mean_expr = pc_genes['mean_expression'].values

    # Primary analysis: Raw mean expression vs Gene length
    r_primary, p_primary = pearsonr(length, mean_expr)
    print(f"\n--- Primary Result ---")
    print(f"Pearson r (raw mean expression vs Length): {r_primary:.6f}")
    print(f"p-value: {p_primary:.6e}")
    print(f"Exact Pearson r: {r_primary}")

    # Additional sensitivity analyses
    # A. log2(mean_expression + 1) vs Length
    log_mean_expr = np.log2(mean_expr + 1)
    r_log_expr, p_log_expr = pearsonr(length, log_mean_expr)
    print(f"\n--- Sensitivity Analysis A: log2(mean_expr + 1) vs Length ---")
    print(f"Pearson r: {r_log_expr:.6f}, p-value: {p_log_expr:.6e}")

    # B. log2(mean_expression + 1) vs log2(Length)
    log_length = np.log2(length)
    r_log_both, p_log_both = pearsonr(log_length, log_mean_expr)
    print(f"\n--- Sensitivity Analysis B: log2(mean_expr + 1) vs log2(Length) ---")
    print(f"Pearson r: {r_log_both:.6f}, p-value: {p_log_both:.6e}")

    # C. Non-zero mean expression genes only
    nonzero_mask = mean_expr > 0
    r_nonzero, p_nonzero = pearsonr(length[nonzero_mask], mean_expr[nonzero_mask])
    print(f"\n--- Sensitivity Analysis C: Non-zero expressed genes (n={nonzero_mask.sum()}) ---")
    print(f"Pearson r: {r_nonzero:.6f}, p-value: {p_nonzero:.6e}")

    # Summary statistics
    print("\n--- Summary Statistics ---")
    print(f"Gene length: min={length.min()}, median={np.median(length)}, mean={length.mean():.2f}, max={length.max()}")
    print(f"Mean expression: min={mean_expr.min():.4f}, median={np.median(mean_expr):.4f}, mean={mean_expr.mean():.2f}, max={mean_expr.max():.2f}")

    return r_primary, p_primary

if __name__ == '__main__':
    main()
