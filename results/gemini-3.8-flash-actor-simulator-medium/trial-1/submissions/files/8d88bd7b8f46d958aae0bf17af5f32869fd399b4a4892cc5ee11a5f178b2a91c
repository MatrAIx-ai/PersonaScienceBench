import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf

def main():
    # Load data
    df = pd.read_csv('data/nls_ses_processed.csv')
    df.columns = [c.replace(' ', '_').replace(':', '') for c in df.columns]
    df['BA_DEGREE_COMPLETED'] = df['BA_DEGREE_COMPLETED'].astype(int)

    # Descriptive statistics
    df['SES_tertile'] = pd.qcut(df['SES'], 3, labels=['Low', 'Medium', 'High'])
    df['SES_quartile'] = pd.qcut(df['SES'], 4, labels=['Q1_Low', 'Q2_MediumLow', 'Q3_MediumHigh', 'Q4_High'])

    print("=== Descriptive Statistics: Completion Rate by SES Tertile ===")
    tertile_stats = df.groupby(['SES_tertile', 'SAMPLE_RACE'], observed=False)['BA_DEGREE_COMPLETED'].agg(['count', 'sum', 'mean'])
    print(tertile_stats)

    print("\n=== Model 1: Race * SES (Unadjusted) ===")
    m1 = smf.logit('BA_DEGREE_COMPLETED ~ C(SAMPLE_RACE, Treatment(reference="White")) * SES', data=df).fit(disp=False)
    print(m1.summary().tables[1])

    print("\n=== Model 2: Race * SES + Academic Controls (ASVAB + Class Rank) ===")
    m2 = smf.logit('BA_DEGREE_COMPLETED ~ C(SAMPLE_RACE, Treatment(reference="White")) * SES + ABILITY_COMPOSITE_OF_ASVAB_SCORE + PERCENTILE_IN_CLASS', data=df).fit(disp=False)
    print(m2.summary().tables[1])

    print("\n=== Model 3: Race * SES + Academic + Demographic Controls ===")
    m3 = smf.logit('BA_DEGREE_COMPLETED ~ C(SAMPLE_RACE, Treatment(reference="White")) * SES + ABILITY_COMPOSITE_OF_ASVAB_SCORE + PERCENTILE_IN_CLASS + C(SAMPLE_SEX) + FAMILY_SIZE_OF_SAMPLE', data=df).fit(disp=False)
    print(m3.summary().tables[1])

    print("\n=== Odds Ratios and Marginal Probabilities across SES (Model 2) ===")
    mean_ability = df['ABILITY_COMPOSITE_OF_ASVAB_SCORE'].mean()
    mean_rank = df['PERCENTILE_IN_CLASS'].mean()
    for s in [-1.5, -1.0, -0.5, 0.0, 0.5, 1.0, 1.5]:
        pw = m2.predict(pd.DataFrame({'SAMPLE_RACE': ['White'], 'SES': [s], 'ABILITY_COMPOSITE_OF_ASVAB_SCORE': [mean_ability], 'PERCENTILE_IN_CLASS': [mean_rank]})).iloc[0]
        pb = m2.predict(pd.DataFrame({'SAMPLE_RACE': ['Black'], 'SES': [s], 'ABILITY_COMPOSITE_OF_ASVAB_SCORE': [mean_ability], 'PERCENTILE_IN_CLASS': [mean_rank]})).iloc[0]
        log_or = m2.params['C(SAMPLE_RACE, Treatment(reference="White"))[T.Black]'] + m2.params['C(SAMPLE_RACE, Treatment(reference="White"))[T.Black]:SES'] * s
        print(f"SES={s:+4.1f} | P(White)={pw:.4f} | P(Black)={pb:.4f} | P(Black)-P(White)={pb-pw:+.4f} | OR(Black/White)={np.exp(log_or):.2f}")

if __name__ == '__main__':
    main()
