import pandas as pd
import numpy as np

def run_pca():
    df = pd.read_csv('data/capital.csv', decimal=',')
    feature_cols = ['ZAxtSchwert', 'ZDolch', 'Zhausgr', 'ZCU_AU', 'Zamber', 
                    'ZMonument', 'ZHort', 'ZSichel', 'ZBeil', 'ZMW', 'ZKeform', 'Zkeverz']

    X = df[feature_cols].values.astype(float)
    mean_vec = np.mean(X, axis=0)
    Xc = X - mean_vec
    cov_mat = np.cov(Xc, rowvar=False)
    eigenvals, eigenvecs = np.linalg.eigh(cov_mat)
    idx = np.argsort(eigenvals)[::-1]
    eigenvals = eigenvals[idx]
    eigenvecs = eigenvecs[:, idx]

    PC_scores = Xc @ eigenvecs

    if eigenvecs[np.argmax(np.abs(eigenvecs[:, 0])), 0] < 0:
        eigenvecs[:, 0] *= -1
        PC_scores[:, 0] *= -1

    df['PC1'] = PC_scores[:, 0]
    df['PC2'] = PC_scores[:, 1]
    
    explained_var = eigenvals / np.sum(eigenvals)
    return df, feature_cols, eigenvecs, explained_var

if __name__ == '__main__':
    df, cols, loadings, var = run_pca()
    print("PCA completed successfully.")
