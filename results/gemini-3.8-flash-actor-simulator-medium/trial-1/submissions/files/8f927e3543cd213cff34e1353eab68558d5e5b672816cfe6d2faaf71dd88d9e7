# Analysis of NLSY79: Socioeconomic Status, Race, Academic Characteristics, and BA Degree Completion
import pandas as pd
import numpy as np

def run_analysis():
    df = pd.read_csv('data/nls_raw.csv')
    # Race cohorts: 1=Black, 2=Hispanic, 3=Non-Black Non-Hispanic
    df['black'] = (df['Racial/ethnic cohort, 1979'] == 1).astype(int)
    df['hispanic'] = (df['Racial/ethnic cohort, 1979'] == 2).astype(int)
    df['white'] = (df['Racial/ethnic cohort, 1979'] == 3).astype(int)

    # Academic variables
    asvab_cols = [
        'ASVAB - Arithmetic Reasoning Z Score (rounded), 1981',
        'ASVAB - Word Knowledge Z Score (rounded), 1981',
        'ASVAB - Paragraph Comprehension Z Score (rounded), 1981',
        'ASVAB - Mathematics Knowledge Z Score (rounded), 1981'
    ]
    df['asvab_composite'] = df[asvab_cols].mean(axis=1)
    df['class_rank_pct'] = (df['Number of students in class last year attended at this school, 1981'] - df['Rank in class last year attended at this school, 1981']) / df['Number of students in class last year attended at this school, 1981']

    # SES variables
    df['mother_ed'] = df["Highest grade completed by respondent's mother, 1979"]
    df['father_ed'] = df["Highest grade completed by respondent's father, 1979"]
    df['fam_inc_79'] = df['Total net family income, previous calendar year, 1979']
    df['fam_wealth_85'] = df['Family net wealth, 1985']

    # Mediation & Correlation Analysis
    sub = df[['black', 'hispanic', 'mother_ed', 'father_ed', 'fam_inc_79', 'fam_wealth_85', 'asvab_composite', 'class_rank_pct']].dropna()
    print('Sample size with complete SES & Academic data:', len(sub))
    print('Correlation matrix:')
    print(sub.corr())

if __name__ == '__main__':
    run_analysis()
