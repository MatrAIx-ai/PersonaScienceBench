import numpy as np
import pandas as pd

# Load capital dataset with comma decimal
df = pd.read_csv('data/capital.csv', decimal=',')

feature_cols = [
    'ZAxtSchwert', 'ZDolch', 'Zhausgr', 'ZCU_AU', 'Zamber', 
    'ZMonument', 'ZHort', 'ZSichel', 'ZBeil', 'ZMW', 'ZKeform', 'Zkeverz'
]

labels = {
    'ZAxtSchwert': 'Hatchet & Swords',
    'ZDolch': 'Daggers',
    'Zhausgr': 'House Size',
    'ZCU_AU': 'Copper & Gold',
    'Zamber': 'Amber',
    'ZMonument': 'Monument Count',
    'ZHort': 'Depot / Hoard',
    'ZSichel': 'Sickle',
    'ZBeil': 'Axes & Celts',
    'ZMW': 'Monument Size',
    'ZKeform': 'Pottery Form',
    'Zkeverz': 'Pottery Decoration'
}

categories = {
    'ZAxtSchwert': 'Symbolic',
    'ZDolch': 'Symbolic',
    'Zhausgr': 'Symbolic',
    'ZCU_AU': 'Social',
    'Zamber': 'Social',
    'ZMonument': 'Social',
    'ZKeform': 'Cultural',
    'Zkeverz': 'Cultural',
    'ZHort': 'Economic',
    'ZSichel': 'Economic',
    'ZBeil': 'Economic',
    'ZMW': 'Economic'
}

# Standardized PCA
X = df[feature_cols].values.astype(float)
X_mean = np.mean(X, axis=0)
X_std = np.std(X, axis=0)
X_z = (X - X_mean) / X_std

cov = np.cov(X_z, rowvar=False)
eigvals, eigvecs = np.linalg.eigh(cov)
idx = np.argsort(eigvals)[::-1]
eigvals = eigvals[idx]
eigvecs = eigvecs[:, idx]
var_exp = eigvals / np.sum(eigvals)

# Sign convention: PC1 aligned positively with wealth & metalwork (Copper/Gold, Hatchet/Sword)
if eigvecs[0, 0] < 0:
    eigvecs[:, 0] = -eigvecs[:, 0]
# PC2 aligned positively with monumental & residential structures (House Size, Monument Size)
if eigvecs[2, 1] < 0:
    eigvecs[:, 1] = -eigvecs[:, 1]

results = pd.DataFrame({
    'Variable': feature_cols,
    'Description': [labels[c] for c in feature_cols],
    'Category': [categories[c] for c in feature_cols],
    'PC1_Loading': np.round(eigvecs[:, 0], 4),
    'PC2_Loading': np.round(eigvecs[:, 1], 4)
})

results.to_csv('pca_results.csv', index=False)
print("PCA execution completed successfully. Results saved to pca_results.csv.")
