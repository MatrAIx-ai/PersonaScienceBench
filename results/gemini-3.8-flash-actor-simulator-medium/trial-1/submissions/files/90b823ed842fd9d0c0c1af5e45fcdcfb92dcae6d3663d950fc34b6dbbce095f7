import pandas as pd
import numpy as np

# Load the datasets
cap_path = 'data/capital.csv'
ts_path = 'data/time_series_data.csv'

df_cap = pd.read_csv(cap_path, decimal=',')
df_ts = pd.read_csv(ts_path)

# Verify alignment between time_series_data and capital.csv
df_ts_pts = df_ts[df_ts['PotteryForm'].notnull()].copy()
df_ts_pts['BCE'] = -df_ts_pts['CE']

merged = pd.merge(df_cap, df_ts_pts[['BCE', 'PotteryForm', 'PotteryDecoration']], on='BCE', how='inner')
np.testing.assert_allclose(merged['ZKeform'], merged['PotteryForm'], atol=1e-5)
np.testing.assert_allclose(merged['Zkeverz'], merged['PotteryDecoration'], atol=1e-5)

# Sort chronologically (forward in time: from older to younger BCE)
cap_chrono = df_cap.sort_values('BCE', ascending=False).reset_index(drop=True)
cap_chrono['d_ZKeform'] = cap_chrono['ZKeform'].diff()
cap_chrono['d_Zkeverz'] = cap_chrono['Zkeverz'].diff()

print("Full step changes across 100-year bins:")
summary_rows = []
for i in range(1, len(cap_chrono)):
    bce_start = int(cap_chrono.loc[i-1, 'BCE'])
    bce_end = int(cap_chrono.loc[i, 'BCE'])
    grp_start = cap_chrono.loc[i-1, 'group']
    grp_end = cap_chrono.loc[i, 'group']
    f_start = cap_chrono.loc[i-1, 'ZKeform']
    f_end = cap_chrono.loc[i, 'ZKeform']
    df_val = cap_chrono.loc[i, 'd_ZKeform']
    d_start = cap_chrono.loc[i-1, 'Zkeverz']
    d_end = cap_chrono.loc[i, 'Zkeverz']
    dd_val = cap_chrono.loc[i, 'd_Zkeverz']
    
    simultaneous = (df_val < 0) and (dd_val > 0)
    summary_rows.append({
        'Interval_BCE': f"{bce_start}-{bce_end}",
        'Period_Transition': f"{grp_start}->{grp_end}",
        'PotteryForm_Start': f_start,
        'PotteryForm_End': f_end,
        'Delta_PotteryForm': df_val,
        'PotteryDecoration_Start': d_start,
        'PotteryDecoration_End': d_end,
        'Delta_PotteryDecoration': dd_val,
        'Simultaneous_Collapse_Increase': simultaneous
    })

res_df = pd.DataFrame(summary_rows)
print(res_df[res_df['Simultaneous_Collapse_Increase']])

target_event = res_df[res_df['Simultaneous_Collapse_Increase']].iloc[0]
print("\nTarget Event Identified:")
print(target_event)

