import os
import pandas as pd
import numpy as np
from scipy.stats import chi2_contingency

def main():
    # Load data
    dm = pd.read_csv('data/TASK008_BCG-CORONA_DM.csv', encoding='latin1')
    ae = pd.read_csv('data/TASK008_BCG-CORONA_AE.csv', encoding='latin1')

    print("=== DATA OVERVIEW ===")
    print(f"DM records: {len(dm)}, unique USUBJID: {dm['USUBJID'].nunique()}")
    print(f"AE records: {len(ae)}, unique USUBJID: {ae['USUBJID'].nunique()}")
    print("DM Treatment group counts:")
    print(dm['TRTGRP'].value_counts())
    print("DM Patient volume counts:")
    print(dm['patients_seen'].value_counts())
    print("\nPatient volume by treatment group in DM:")
    print(pd.crosstab(dm['patients_seen'], dm['TRTGRP']))

    # Filter COVID-19 cases
    covid_ae = ae[ae['AEPT'].str.contains('COVID', case=False, na=False)].copy()
    print(f"\nCOVID-19 AE records: {len(covid_ae)}, unique infected subjects: {covid_ae['USUBJID'].nunique()}")
    print("COVID-19 AE terms:")
    print(covid_ae['AEPT'].value_counts())

    # Merge with DM to get patients_seen
    merged_ev = pd.merge(covid_ae, dm[['USUBJID', 'patients_seen']], on='USUBJID', how='inner')

    # Subject-level max severity
    subj_inf = covid_ae.groupby('USUBJID').agg({
        'AESEV': 'max',
        'AEHS': 'max',
        'AESER': lambda x: 'Yes' if 'Yes' in x.values else 'No'
    }).reset_index()
    merged_subj = pd.merge(subj_inf, dm[['USUBJID', 'TRTGRP', 'patients_seen']], on='USUBJID', how='inner')

    pv_groups = ['1-50', '51-100', '>100']

    print("\n================================================================================")
    print("1. SUBJECT-LEVEL ANALYSIS: COVID HEALTH STATUS (AEHS) - AMBULATORY vs HOSPITALIZED")
    print("================================================================================")
    # AEHS: 0-2 = Ambulatory (mild/moderate), >=3 = Hospitalized/Severe
    for pv in pv_groups:
        sub = merged_subj[merged_subj['patients_seen'] == pv].dropna(subset=['AEHS'])
        sub['Severity_Cat'] = sub['AEHS'].apply(lambda x: 'Hospitalized (>=3)' if x >= 3 else 'Ambulatory (0-2)')
        ct = pd.crosstab(sub['Severity_Cat'], sub['TRTGRP'])
        print(f"\n--- Patient Volume Group: {pv} ---")
        print(ct)
        if ct.shape == (2, 2):
            chi2_nc, p_nc, dof_nc, _ = chi2_contingency(ct, correction=False)
            chi2_c, p_c, dof_c, _ = chi2_contingency(ct, correction=True)
            print(f"Pearson Chi-square (uncorrected): stat = {chi2_nc:.4f}, dof = {dof_nc}, p = {p_nc:.5f}")
            print(f"Yates-corrected Chi-square:        stat = {chi2_c:.4f}, dof = {dof_c}, p = {p_c:.5f}")
        else:
            print("Cannot compute 2x2 chi-square (degenerate table).")

    print("\n================================================================================")
    print("2. SUBJECT-LEVEL ANALYSIS: FULL ORDINAL AEHS SCALE")
    print("================================================================================")
    for pv in pv_groups:
        sub = merged_subj[merged_subj['patients_seen'] == pv].dropna(subset=['AEHS'])
        ct = pd.crosstab(sub['AEHS'], sub['TRTGRP'])
        print(f"\n--- Patient Volume Group: {pv} ---")
        print(ct)
        if ct.shape[0] > 1 and ct.shape[1] > 1:
            chi2, p, dof, _ = chi2_contingency(ct, correction=False)
            print(f"Pearson Chi-square: stat = {chi2:.4f}, dof = {dof}, p = {p:.5f}")

    print("\n================================================================================")
    print("3. SUBJECT-LEVEL ANALYSIS: AESEV (1, 2, 3, 4)")
    print("================================================================================")
    for pv in pv_groups:
        sub = merged_subj[merged_subj['patients_seen'] == pv].dropna(subset=['AESEV'])
        ct = pd.crosstab(sub['AESEV'], sub['TRTGRP'])
        print(f"\n--- Patient Volume Group: {pv} ---")
        print(ct)
        if ct.shape[0] > 1 and ct.shape[1] > 1:
            chi2, p, dof, _ = chi2_contingency(ct, correction=False)
            print(f"Pearson Chi-square: stat = {chi2:.4f}, dof = {dof}, p = {p:.5f}")

    print("\n================================================================================")
    print("4. SUBJECT-LEVEL ANALYSIS: AESEV BINARY (MILD-MOD 1-2 vs SEVERE 3-4)")
    print("================================================================================")
    for pv in pv_groups:
        sub = merged_subj[merged_subj['patients_seen'] == pv].dropna(subset=['AESEV'])
        sub['Severity_Cat'] = sub['AESEV'].apply(lambda x: 'Severe (3-4)' if x >= 3 else 'Mild-Mod (1-2)')
        ct = pd.crosstab(sub['Severity_Cat'], sub['TRTGRP'])
        print(f"\n--- Patient Volume Group: {pv} ---")
        print(ct)
        if ct.shape == (2, 2):
            chi2_nc, p_nc, dof_nc, _ = chi2_contingency(ct, correction=False)
            chi2_c, p_c, dof_c, _ = chi2_contingency(ct, correction=True)
            print(f"Pearson Chi-square (uncorrected): stat = {chi2_nc:.4f}, dof = {dof_nc}, p = {p_nc:.5f}")
            print(f"Yates-corrected Chi-square:        stat = {chi2_c:.4f}, dof = {dof_c}, p = {p_c:.5f}")

    print("\n================================================================================")
    print("5. EVENT-LEVEL ANALYSIS: AESEV BINARY (1-2 vs 3-4)")
    print("================================================================================")
    for pv in pv_groups:
        sub = merged_ev[merged_ev['patients_seen'] == pv].dropna(subset=['AESEV']).copy()
        sub['Severity_Cat'] = sub['AESEV'].apply(lambda x: 'Severe (3-4)' if x >= 3 else 'Mild-Mod (1-2)')
        ct = pd.crosstab(sub['Severity_Cat'], sub['TRTGRP'])
        print(f"\n--- Patient Volume Group: {pv} ---")
        print(ct)
        if ct.shape == (2, 2):
            chi2_nc, p_nc, dof_nc, _ = chi2_contingency(ct, correction=False)
            chi2_c, p_c, dof_c, _ = chi2_contingency(ct, correction=True)
            print(f"Pearson Chi-square (uncorrected): stat = {chi2_nc:.4f}, dof = {dof_nc}, p = {p_nc:.5f}")
            print(f"Yates-corrected Chi-square:        stat = {chi2_c:.4f}, dof = {dof_c}, p = {p_c:.5f}")

    print("\n================================================================================")
    print("6. EXACT COVID-19 ONLY (AEPT == 'COVID-19'): SUBJECT-LEVEL AEHS (0-2 vs >=3)")
    print("================================================================================")
    exact_cov = ae[ae['AEPT'] == 'COVID-19'].groupby('USUBJID')['AEHS'].max().reset_index()
    exact_m = pd.merge(exact_cov, dm[['USUBJID', 'TRTGRP', 'patients_seen']], on='USUBJID', how='inner')
    for pv in pv_groups:
        sub = exact_m[exact_m['patients_seen'] == pv].dropna(subset=['AEHS']).copy()
        sub['Severity_Cat'] = sub['AEHS'].apply(lambda x: 'Hospitalized (>=3)' if x >= 3 else 'Ambulatory (0-2)')
        ct = pd.crosstab(sub['Severity_Cat'], sub['TRTGRP'])
        print(f"\n--- Patient Volume Group: {pv} ---")
        print(ct)
        if ct.shape == (2, 2):
            chi2_nc, p_nc, dof_nc, _ = chi2_contingency(ct, correction=False)
            chi2_c, p_c, dof_c, _ = chi2_contingency(ct, correction=True)
            print(f"Pearson Chi-square (uncorrected): stat = {chi2_nc:.4f}, dof = {dof_nc}, p = {p_nc:.5f}")
            print(f"Yates-corrected Chi-square:        stat = {chi2_c:.4f}, dof = {dof_c}, p = {p_c:.5f}")

if __name__ == '__main__':
    main()
