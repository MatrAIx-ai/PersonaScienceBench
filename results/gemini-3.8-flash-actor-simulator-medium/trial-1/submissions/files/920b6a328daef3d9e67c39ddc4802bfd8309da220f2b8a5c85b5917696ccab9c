import pandas as pd
import numpy as np
from scipy.stats import skew, kurtosis
import json

def main():
    data_path = 'data/OmicsExpressionProteinCodingGenesTPMLogp1BatchCorrected.csv'
    print(f"Loading data from {data_path}...")
    df = pd.read_csv(data_path, index_col=0)
    print(f"Matrix shape: {df.shape[0]} cell lines x {df.shape[1]} genes")

    # Overall / Pooled distribution across all cell lines and genes
    vals = df.values.flatten()
    vals_clean = vals[~np.isnan(vals)]
    
    overall_mean = float(np.mean(vals_clean))
    overall_median = float(np.median(vals_clean))
    overall_std = float(np.std(vals_clean, ddof=1))
    overall_skew = float(skew(vals_clean))
    overall_kurt = float(kurtosis(vals_clean))
    overall_min = float(np.min(vals_clean))
    overall_max = float(np.max(vals_clean))
    q25 = float(np.percentile(vals_clean, 25))
    q75 = float(np.percentile(vals_clean, 75))

    # Per-cell-line distribution (across genes)
    cell_line_skews = skew(df.values, axis=1, nan_policy='omit')
    cl_mean_skew = float(np.mean(cell_line_skews))
    cl_median_skew = float(np.median(cell_line_skews))
    cl_min_skew = float(np.min(cell_line_skews))
    cl_max_skew = float(np.max(cell_line_skews))
    cl_pct_positive = float(np.mean(cell_line_skews > 0) * 100)

    # Per-gene distribution (across cell lines)
    gene_skews = skew(df.values, axis=0, nan_policy='omit')
    gene_mean_skew = float(np.nanmean(gene_skews))
    gene_median_skew = float(np.nanmedian(gene_skews))
    gene_min_skew = float(np.nanmin(gene_skews))
    gene_max_skew = float(np.nanmax(gene_skews))
    gene_pct_positive = float(np.nanmean(gene_skews > 0) * 100)

    results = {
        "dataset": {
            "num_cell_lines": df.shape[0],
            "num_genes": df.shape[1],
            "total_observations": int(len(vals_clean))
        },
        "pooled_distribution": {
            "mean": overall_mean,
            "median": overall_median,
            "std": overall_std,
            "min": overall_min,
            "max": overall_max,
            "q25": q25,
            "q75": q75,
            "skewness": overall_skew,
            "kurtosis": overall_kurt,
            "characteristic": "positively skewed (right-skewed)"
        },
        "per_cell_line_distribution": {
            "mean_skewness": cl_mean_skew,
            "median_skewness": cl_median_skew,
            "min_skewness": cl_min_skew,
            "max_skewness": cl_max_skew,
            "pct_positive": cl_pct_positive
        },
        "per_gene_distribution": {
            "mean_skewness": gene_mean_skew,
            "median_skewness": gene_median_skew,
            "min_skewness": gene_min_skew,
            "max_skewness": gene_max_skew,
            "pct_positive": gene_pct_positive
        }
    }

    print("\n--- Summary Results ---")
    print(f"Overall Skewness: {overall_skew:.4f} (Positively / Right-skewed)")
    print(f"Mean: {overall_mean:.4f}, Median: {overall_median:.4f}")
    print(f"Per-cell line mean skewness: {cl_mean_skew:.4f} (100% positive)")
    print(f"Per-gene median skewness: {gene_median_skew:.4f}, mean skewness: {gene_mean_skew:.4f}")

    with open("analysis/skewness_results.json", "w") as f:
        json.dump(results, f, indent=2)
    print("Results saved to analysis/skewness_results.json")

if __name__ == "__main__":
    main()
