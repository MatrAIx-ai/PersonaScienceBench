#!/usr/bin/env python3
"""
Analysis of the interaction effect between BCG vaccination status and prior medical history
on COVID-19 severity, controlling for patient interaction frequency using an ordinal regression model.

Benchmark: BixBench (bix-29-q3)
Trial: TASK008 BCG-CORONA
"""

import sys
import pandas as pd
import numpy as np
import statsmodels.api as sm
from statsmodels.miscmodels.ordinal_model import OrderedModel

def main():
    print("=" * 70)
    print("BCG-CORONA Trial: Ordinal Regression Analysis of COVID-19 Severity")
    print("=" * 70)

    # 1. Load data
    dm = pd.read_csv("data/TASK008_BCG-CORONA_DM.csv")
    ae = pd.read_csv("data/TASK008_BCG-CORONA_AE.csv")
    mh = pd.read_csv("data/TASK008_BCG-CORONA_MH.csv")

    print(f"Loaded datasets: DM (N={len(dm)}), AE (N={len(ae)}), MH (N={len(mh)})")

    # 2. Extract Prior Medical History (MHSCAT == 'MEDICAL HISTORY', MHORRES == 2.0)
    med_mh = mh[mh['MHSCAT'] == 'MEDICAL HISTORY']
    has_prior_mh_subjs = set(med_mh[med_mh['MHORRES'] == 2.0]['USUBJID'].unique())

    # 3. Extract COVID-19 Cases and Severity (AEHS)
    # Identification of COVID-19 adverse events
    covid_ae = ae[ae['AEPT'].str.contains('covid|corona|sars', case=False, na=False)].copy()
    print(f"Total COVID-19 AE records: {len(covid_ae)}")
    
    # Maximum health status (AEHS) per subject during the COVID episode
    covid_subj_sev = covid_ae.groupby('USUBJID')['AEHS'].max().reset_index()
    print(f"Unique COVID-19 positive subjects: {len(covid_subj_sev)}")

    # 4. Merge demographic, treatment, baseline history, and severity
    df = dm.copy()
    df['prior_mh'] = df['USUBJID'].isin(has_prior_mh_subjs).astype(int)
    df['bcg'] = (df['TRTGRP'] == 'BCG').astype(int)
    df['interaction'] = df['bcg'] * df['prior_mh']

    # Filter to COVID-19 cases (Primary analysis cohort)
    df_covid = df.merge(covid_subj_sev, on='USUBJID', how='inner')

    print("\n--- COVID-19 Patient Cohort Summary ---")
    ct = pd.crosstab(df_covid['bcg'], df_covid['prior_mh'], margins=True)
    ct.index = ['Placebo (0)', 'BCG (1)', 'Total']
    ct.columns = ['No Prior MH (0)', 'Prior MH (1)', 'Total']
    print("Contingency Table (BCG vs Prior Medical History):")
    print(ct)

    print("\nDistribution of COVID-19 Severity (AEHS):")
    print(df_covid['AEHS'].value_counts().sort_index())

    # 5. Fit Primary Model: Ordered Logit with Categorical patients_seen
    # Dummy encoding for patients_seen (reference: '1-50')
    df_covid_cat = pd.get_dummies(df_covid, columns=['patients_seen'], drop_first=True, dtype=float)
    
    covariates_cat = ['bcg', 'prior_mh', 'interaction', 'patients_seen_51-100', 'patients_seen_>100']
    X_cat = df_covid_cat[covariates_cat]
    y_cat = df_covid_cat['AEHS']

    mod_cat = OrderedModel(y_cat, X_cat, distr='logit')
    res_cat = mod_cat.fit(method='bfgs', disp=False)

    print("\n" + "=" * 70)
    print("PRIMARY MODEL RESULTS (Categorical patient interaction frequency)")
    print("=" * 70)
    print(res_cat.summary())

    coef_int = res_cat.params['interaction']
    se_int = res_cat.bse['interaction']
    pval_int = res_cat.pvalues['interaction']
    ci_int = res_cat.conf_int().loc['interaction']
    or_int = np.exp(coef_int)
    or_ci_low = np.exp(ci_int[0])
    or_ci_high = np.exp(ci_int[1])

    print("\n--- Primary Interaction Effect Summary ---")
    print(f"Interaction Coefficient (beta): {coef_int:.4f}")
    print(f"Standard Error:                 {se_int:.4f}")
    print(f"z-value:                        {res_cat.tvalues['interaction']:.4f}")
    print(f"p-value:                        {pval_int:.4f}")
    print(f"Odds Ratio (OR):                {or_int:.4f}")
    print(f"95% Confidence Interval for OR: [{or_ci_low:.4f}, {or_ci_high:.4f}]")

    # 6. Sensitivity Analysis 1: Ordinal numeric patient interaction frequency
    mapping = {'1-50': 1, '51-100': 2, '>100': 3}
    df_covid['patients_seen_num'] = df_covid['patients_seen'].map(mapping)
    X_ord = df_covid[['bcg', 'prior_mh', 'interaction', 'patients_seen_num']]
    mod_ord = OrderedModel(df_covid['AEHS'], X_ord, distr='logit')
    res_ord = mod_ord.fit(method='bfgs', disp=False)

    coef_ord = res_ord.params['interaction']
    ci_ord = res_ord.conf_int().loc['interaction']
    print("\n" + "=" * 70)
    print("SENSITIVITY ANALYSIS 1 (Ordinal numeric patient interaction frequency)")
    print("=" * 70)
    print(f"Interaction Coefficient: {coef_ord:.4f}, p-value: {res_ord.pvalues['interaction']:.4f}")
    print(f"Odds Ratio (OR):         {np.exp(coef_ord):.4f}, 95% CI: [{np.exp(ci_ord[0]):.4f}, {np.exp(ci_ord[1]):.4f}]")

    # 7. Sensitivity Analysis 2: Full trial cohort (N = 1000)
    df_all = df.merge(covid_subj_sev, on='USUBJID', how='left')
    df_all['AEHS_all'] = df_all['AEHS'].fillna(0).astype(int)
    df_all_cat = pd.get_dummies(df_all, columns=['patients_seen'], drop_first=True, dtype=float)
    X_all = df_all_cat[['bcg', 'prior_mh', 'interaction', 'patients_seen_51-100', 'patients_seen_>100']]
    y_all = df_all_cat['AEHS_all']

    mod_all = OrderedModel(y_all, X_all, distr='logit')
    res_all = mod_all.fit(method='bfgs', disp=False)
    coef_all = res_all.params['interaction']
    ci_all = res_all.conf_int().loc['interaction']
    print("\n" + "=" * 70)
    print("SENSITIVITY ANALYSIS 2 (Full cohort N=1000, uninfected = 0)")
    print("=" * 70)
    print(f"Interaction Coefficient: {coef_all:.4f}, p-value: {res_all.pvalues['interaction']:.4f}")
    print(f"Odds Ratio (OR):         {np.exp(coef_all):.4f}, 95% CI: [{np.exp(ci_all[0]):.4f}, {np.exp(ci_all[1]):.4f}]")

    return {
        "or_primary": or_int,
        "ci_primary": (or_ci_low, or_ci_high),
        "pval_primary": pval_int,
        "coef_primary": coef_int,
        "se_primary": se_int
    }

if __name__ == '__main__':
    main()
