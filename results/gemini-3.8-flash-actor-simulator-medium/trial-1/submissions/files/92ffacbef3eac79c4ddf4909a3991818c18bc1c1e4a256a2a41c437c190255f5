import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf

def main():
    # 1. Load data
    df_raw = pd.read_excel('data/data.xlsx', sheet_name='Sheet1')
    
    # 2. Filter to valid 80 patients (drop trailing empty rows/artifacts)
    df = df_raw.iloc[:80].copy()
    
    # Verify and cast Age
    df['Age'] = pd.to_numeric(df['Age'], errors='raise')
    
    # Encode target variable: PR = 1, SD/PD = 0
    df['is_PR'] = (df['Efficacy'] == 'PR').astype(int)
    
    # Check counts
    print("Dataset shape:", df.shape)
    print("PR counts:\n", df['is_PR'].value_counts())
    print("\nAge summary:\n", df['Age'].describe())
    
    # 3. Fit logistic regression model: logit(P(PR)) = Intercept + beta * Age
    model = smf.logit('is_PR ~ Age', data=df).fit()
    print("\nModel Summary:")
    print(model.summary())
    
    # 4. Predict probability for Age = 65
    new_data = pd.DataFrame({'Age': [65.0]})
    pred_res = model.get_prediction(new_data)
    pred_summary = pred_res.summary_frame()
    
    prob = pred_summary['predicted'][0]
    ci_lower = pred_summary['ci_lower'][0]
    ci_upper = pred_summary['ci_upper'][0]
    
    # Manual calculation check:
    intercept = model.params['Intercept']
    slope = model.params['Age']
    logit_val = intercept + slope * 65.0
    prob_manual = 1.0 / (1.0 + np.exp(-logit_val))
    
    print("\n--- Predictions for Age = 65 ---")
    print(f"Logit: {logit_val:.6f}")
    print(f"Predicted probability (model): {prob:.6f} ({prob*100:.2f}%)")
    print(f"Predicted probability (manual): {prob_manual:.6f}")
    print(f"95% CI: [{ci_lower:.6f}, {ci_upper:.6f}] ({ci_lower*100:.2f}% - {ci_upper*100:.2f}%)")
    
    # Save results to a text file for record
    with open('model_results.txt', 'w') as f:
        f.write(model.summary().as_text())
        f.write("\n\nPrediction for Age 65:\n")
        f.write(f"Probability: {prob:.6f} ({prob*100:.2f}%)\n")
        f.write(f"95% CI: [{ci_lower:.6f}, {ci_upper:.6f}]\n")

if __name__ == '__main__':
    main()
