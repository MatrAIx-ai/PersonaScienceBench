# Analysis script for NLS SES BA completion study
import pandas as pd
import statsmodels.formula.api as smf

def run_analysis():
    df = pd.read_csv('data/nls_ses_processed.csv')
    df.columns = [c.replace(' ', '_').replace(':', '') for c in df.columns]
    df['BA'] = df['BA_DEGREE_COMPLETED'].astype(int)

    # 1. Full sample Logit models
    print('--- Full Sample Models ---')
    m_base = smf.logit('BA ~ SES', data=df).fit(disp=False)
    m_full = smf.logit('BA ~ SES + C(SAMPLE_RACE) + ABILITY_COMPOSITE_OF_ASVAB_SCORE + PERCENTILE_IN_CLASS', data=df).fit(disp=False)
    print(f'Base SES coef: {m_base.params["SES"]:.4f}, p: {m_base.pvalues["SES"]:.4e}')
    print(f'Full SES coef: {m_full.params["SES"]:.4f}, p: {m_full.pvalues["SES"]:.4f}')

    # 2. Female Stratified Logit models
    print('\n--- Female Stratified Models ---')
    sub_fem = df[df['SAMPLE_SEX'] == 'Female']
    m_fem_base = smf.logit('BA ~ SES + C(SAMPLE_RACE)', data=sub_fem).fit(disp=False)
    m_fem_full = smf.logit('BA ~ SES + C(SAMPLE_RACE) + ABILITY_COMPOSITE_OF_ASVAB_SCORE + PERCENTILE_IN_CLASS', data=sub_fem).fit(disp=False)
    print(f'Female Base SES coef: {m_fem_base.params["SES"]:.4f}, p: {m_fem_base.pvalues["SES"]:.4f}')
    print(f'Female Full SES coef: {m_fem_full.params["SES"]:.4f}, p: {m_fem_full.pvalues["SES"]:.4f}')

    # 3. Probit baseline model
    print('\n--- Probit Baseline Model ---')
    m_probit = smf.probit('BA ~ SES + FAMILY_SIZE_OF_SAMPLE', data=df).fit(disp=False)
    print(f'Probit SES coef: {m_probit.params["SES"]:.4f}, p: {m_probit.pvalues["SES"]:.4e}')

if __name__ == '__main__':
    run_analysis()
