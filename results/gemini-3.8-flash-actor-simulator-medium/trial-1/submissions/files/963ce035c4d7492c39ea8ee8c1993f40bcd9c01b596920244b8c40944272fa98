import pandas as pd
import numpy as np

def run_analysis():
    # Load datasets
    ts = pd.read_csv('data/time_series_data.csv')
    cap = pd.read_csv('data/capital.csv', decimal=',')
    pol = pd.read_csv('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv', decimal=',')

    ts['BCE'] = -ts['CE']
    ts_sub = ts[(ts['BCE'] >= 1100) & (ts['BCE'] <= 2000)].copy()
    ts_sub['century'] = ((ts_sub['BCE'] - 1) // 100 + 1).astype(int)

    # 1. Growth metrics in time_series_data
    century_stats = ts_sub.groupby('century').agg(
        mean_g_all=('g_all_mean', 'mean'),
        max_g_all=('g_all_mean', 'max'),
        mean_pollen_grate=('pollen_grate_100', 'mean'),
        max_pollen_grate=('pollen_grate_100', 'max'),
        mean_kde_all=('kde_all_mean', 'mean'),
        start_kde=('kde_all_mean', 'first'),
        end_kde=('kde_all_mean', 'last')
    ).sort_index(ascending=False)

    print("Century Growth Statistics (20th to 12th century BCE):")
    print(century_stats)

    # Peak individual years
    peak_g_year = ts_sub.loc[ts_sub['g_all_mean'].idxmax(), 'BCE']
    peak_g_val = ts_sub['g_all_mean'].max()
    peak_pol_year = ts_sub.loc[ts_sub['pollen_grate_100'].idxmax(), 'BCE']
    peak_pol_val = ts_sub['pollen_grate_100'].max()

    print(f"\nPeak KDE growth rate: {peak_g_val:.6f} at {peak_g_year} BCE (15th c. BCE)")
    print(f"Peak Pollen openness growth rate: {peak_pol_val:.6f} at {peak_pol_year} BCE (15th c. BCE)")

    # 2. Capital analysis
    csub = cap[(cap['BCE'] >= 1100) & (cap['BCE'] <= 2000)].copy()
    csub['symbolic'] = csub[['ZAxtSchwert', 'ZDolch', 'Zhausgr']].mean(axis=1)
    csub['social'] = csub[['ZCU_AU', 'Zamber', 'ZMonument']].mean(axis=1)
    csub['cultural'] = csub[['ZKeform', 'Zkeverz']].mean(axis=1)
    csub['economic'] = csub[['ZHort', 'ZSichel', 'ZBeil', 'ZMW']].mean(axis=1)
    csub['total_capital'] = csub[['symbolic', 'social', 'cultural', 'economic']].mean(axis=1)

    print("\nCapital.csv Metrics:")
    print(csub[['BCE', 'group', 'symbolic', 'social', 'cultural', 'economic', 'total_capital']])

if __name__ == '__main__':
    run_analysis()
