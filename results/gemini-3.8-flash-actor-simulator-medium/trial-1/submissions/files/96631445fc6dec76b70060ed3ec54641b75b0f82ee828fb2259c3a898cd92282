import pandas as pd
import numpy as np

# Load capital dataset
df_cap = pd.read_csv('data/capital.csv')
for col in ['ZKeform', 'Zkeverz']:
    df_cap[col] = pd.to_numeric(df_cap[col].astype(str).str.replace(',', '.'))

df_cap = df_cap.sort_values(by='BCE', ascending=False).reset_index(drop=True)
df_cap['CE'] = -df_cap['BCE']
df_cap['calBP'] = 1950 - df_cap['CE']
df_cap['delta_Form'] = df_cap['ZKeform'].diff()
df_cap['delta_Deco'] = df_cap['Zkeverz'].diff()

print("=== Chronological Changes in Pottery Form and Pottery Decoration Diversity ===")
target_rows = df_cap[(df_cap['BCE'] <= 2000) & (df_cap['BCE'] >= 1500)]
print(target_rows[['BCE', 'CE', 'calBP', 'group', 'ZKeform', 'delta_Form', 'Zkeverz', 'delta_Deco']])

print("\n=== Identification of Opposite Trends (Form Collapse & Decoration Increase) ===")
opp = df_cap[(df_cap['delta_Form'] < 0) & (df_cap['delta_Deco'] > 0)]
print(opp[['BCE', 'CE', 'calBP', 'group', 'ZKeform', 'delta_Form', 'Zkeverz', 'delta_Deco']])
