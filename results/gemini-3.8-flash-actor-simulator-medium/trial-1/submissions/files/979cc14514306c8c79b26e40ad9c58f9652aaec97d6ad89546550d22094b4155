#!/usr/bin/env python3
import os, sys, json
import numpy as np
import pandas as pd
import scipy.sparse as sp
import scipy.sparse.linalg as spla
import contextlib

for p in ['/usr/lib/python3/dist-packages', '/usr/local/lib/python3/dist-packages']:
    if os.path.isdir(p) and p not in sys.path:
        sys.path.append(p)

def wrap_angle(theta):
    return (theta + np.pi) % (2.0 * np.pi) - np.pi

def compute_relative_residual(xi, xj, z, sig):
    c, s = np.cos(xi[2]), np.sin(xi[2])
    dx, dy = xj[0] - xi[0], xj[1] - xi[1]
    px, py = c * dx + s * dy, -s * dx + c * dy
    dth = wrap_angle(xj[2] - xi[2])
    return np.array([(px - z[0]) / sig[0], (py - z[1]) / sig[1], wrap_angle(dth - z[2]) / sig[2]])

def compute_jacobians(xi, xj, sig):
    c, s = np.cos(xi[2]), np.sin(xi[2])
    dx, dy = xj[0] - xi[0], xj[1] - xi[1]
    px, py = c * dx + s * dy, -s * dx + c * dy
    st, sr = sig[0], sig[2]
    Ji = np.array([[-c/st, -s/st, py/st], [s/st, -c/st, -px/st], [0.0, 0.0, -1.0/sr]])
    Jj = np.array([[c/st, s/st, 0.0], [-s/st, c/st, 0.0], [0.0, 0.0, 1.0/sr]])
    return Ji, Jj

def solve_robust_pgo(poses_init, odo_df, loops_df, phi_thresh=11.3449, max_dcs_iter=25, max_refine_iter=15):
    N = len(poses_init)
    edges_odo = [(int(r['from']), int(r['to']), np.array([r['dx'], r['dy'], r['dtheta']]), np.array([r['sigma_trans'], r['sigma_trans'], r['sigma_rot']])) for _, r in odo_df.iterrows()]
    edges_loop = [(int(r['from']), int(r['to']), np.array([r['dx'], r['dy'], r['dtheta']]), np.array([r['sigma_trans'], r['sigma_trans'], r['sigma_rot']]), int(r['loop_id'])) for _, r in loops_df.iterrows()]
    num_loops = len(edges_loop)
    poses = poses_init.copy()
    loop_weights = np.ones(num_loops, dtype=float)

    for outer in range(max_dcs_iter):
        chi2_loops = np.zeros(num_loops, dtype=float)
        for i, j, z, sig, lid in edges_loop:
            r = compute_relative_residual(poses[i], poses[j], z, sig)
            chi2_loops[lid] = float(np.sum(r**2))
        new_weights = np.minimum(1.0, (2.0 * phi_thresh) / (phi_thresh + chi2_loops))**2

        rows, cols, data = [], [], []
        rhs = np.zeros(3 * N, dtype=float)
        for i, j, z, sig in edges_odo:
            r = compute_relative_residual(poses[i], poses[j], z, sig)
            Ji, Jj = compute_jacobians(poses[i], poses[j], sig)
            for r_idx in range(3):
                rhs[3*i+r_idx] -= np.dot(Ji[:, r_idx], r)
                rhs[3*j+r_idx] -= np.dot(Jj[:, r_idx], r)
                for c_idx in range(3):
                    rows.extend([3*i+r_idx, 3*i+r_idx, 3*j+r_idx, 3*j+r_idx])
                    cols.extend([3*i+c_idx, 3*j+c_idx, 3*i+c_idx, 3*j+c_idx])
                    data.extend([np.dot(Ji[:, r_idx], Ji[:, c_idx]), np.dot(Ji[:, r_idx], Jj[:, c_idx]),
                                 np.dot(Jj[:, r_idx], Ji[:, c_idx]), np.dot(Jj[:, r_idx], Jj[:, c_idx])])

        for i, j, z, sig, lid in edges_loop:
            w = new_weights[lid]
            if w < 1e-8: continue
            sw = np.sqrt(w)
            r_w = sw * compute_relative_residual(poses[i], poses[j], z, sig)
            Ji_w, Jj_w = sw * compute_jacobians(poses[i], poses[j], sig)[0], sw * compute_jacobians(poses[i], poses[j], sig)[1]
            for r_idx in range(3):
                rhs[3*i+r_idx] -= np.dot(Ji_w[:, r_idx], r_w)
                rhs[3*j+r_idx] -= np.dot(Jj_w[:, r_idx], r_w)
                for c_idx in range(3):
                    rows.extend([3*i+r_idx, 3*i+r_idx, 3*j+r_idx, 3*j+r_idx])
                    cols.extend([3*i+c_idx, 3*j+c_idx, 3*i+c_idx, 3*j+c_idx])
                    data.extend([np.dot(Ji_w[:, r_idx], Ji_w[:, c_idx]), np.dot(Ji_w[:, r_idx], Jj_w[:, c_idx]),
                                 np.dot(Jj_w[:, r_idx], Ji_w[:, c_idx]), np.dot(Jj_w[:, r_idx], Jj_w[:, c_idx])])

        H = sp.coo_matrix((data, (rows, cols)), shape=(3*N, 3*N)).tocsr()
        H_free = H[3:, 3:] + 1e-4 * sp.eye(3 * (N - 1))
        dx_free = spla.spsolve(H_free, rhs[3:])
        dx = np.zeros(3 * N, dtype=float)
        dx[3:] = dx_free
        poses[:, :2] += dx.reshape((N, 3))[:, :2]
        poses[:, 2] = wrap_angle(poses[:, 2] + dx.reshape((N, 3))[:, 2])

        w_diff = np.max(np.abs(new_weights - loop_weights))
        loop_weights = new_weights
        if np.linalg.norm(dx) < 1e-5 and w_diff < 1e-4: break

    inlier_mask = loop_weights > 0.5
    refine_step = 0.0
    refine_iters = 0
    for it in range(max_refine_iter):
        rows, cols, data = [], [], []
        rhs = np.zeros(3 * N, dtype=float)
        for i, j, z, sig in edges_odo:
            r = compute_relative_residual(poses[i], poses[j], z, sig)
            Ji, Jj = compute_jacobians(poses[i], poses[j], sig)
            for r_idx in range(3):
                rhs[3*i+r_idx] -= np.dot(Ji[:, r_idx], r)
                rhs[3*j+r_idx] -= np.dot(Jj[:, r_idx], r)
                for c_idx in range(3):
                    rows.extend([3*i+r_idx, 3*i+r_idx, 3*j+r_idx, 3*j+r_idx])
                    cols.extend([3*i+c_idx, 3*j+c_idx, 3*i+c_idx, 3*j+c_idx])
                    data.extend([np.dot(Ji[:, r_idx], Ji[:, c_idx]), np.dot(Ji[:, r_idx], Jj[:, c_idx]),
                                 np.dot(Jj[:, r_idx], Ji[:, c_idx]), np.dot(Jj[:, r_idx], Jj[:, c_idx])])
        for i, j, z, sig, lid in edges_loop:
            if not inlier_mask[lid]: continue
            r = compute_relative_residual(poses[i], poses[j], z, sig)
            Ji, Jj = compute_jacobians(poses[i], poses[j], sig)
            for r_idx in range(3):
                rhs[3*i+r_idx] -= np.dot(Ji[:, r_idx], r)
                rhs[3*j+r_idx] -= np.dot(Jj[:, r_idx], r)
                for c_idx in range(3):
                    rows.extend([3*i+r_idx, 3*i+r_idx, 3*j+r_idx, 3*j+r_idx])
                    cols.extend([3*i+c_idx, 3*j+c_idx, 3*i+c_idx, 3*j+c_idx])
                    data.extend([np.dot(Ji[:, r_idx], Ji[:, c_idx]), np.dot(Ji[:, r_idx], Jj[:, c_idx]),
                                 np.dot(Jj[:, r_idx], Ji[:, c_idx]), np.dot(Jj[:, r_idx], Jj[:, c_idx])])
        H = sp.coo_matrix((data, (rows, cols)), shape=(3*N, 3*N)).tocsr()
        dx_free = spla.spsolve(H[3:, 3:], rhs[3:])
        dx = np.zeros(3 * N, dtype=float)
        dx[3:] = dx_free
        poses[:, :2] += dx.reshape((N, 3))[:, :2]
        poses[:, 2] = wrap_angle(poses[:, 2] + dx.reshape((N, 3))[:, 2])
        refine_step = float(np.linalg.norm(dx))
        refine_iters = it + 1
        if refine_step < 1e-9: break

    final_loop_chi2 = np.zeros(num_loops, dtype=float)
    for i, j, z, sig, lid in edges_loop:
        r = compute_relative_residual(poses[i], poses[j], z, sig)
        final_loop_chi2[lid] = float(np.sum(r**2))

    final_odo_chi2 = np.zeros(len(edges_odo), dtype=float)
    for idx, (i, j, z, sig) in enumerate(edges_odo):
        r = compute_relative_residual(poses[i], poses[j], z, sig)
        final_odo_chi2[idx] = float(np.sum(r**2))

    false_probs = 1.0 / (1.0 + np.exp(-(final_loop_chi2 - phi_thresh) / 2.0))
    diagnostics = {
        'num_poses': int(N),
        'num_odometry_edges': int(len(edges_odo)),
        'num_loop_candidates': int(num_loops),
        'num_inlier_loops': int(np.sum(inlier_mask)),
        'num_outlier_loops': int(np.sum(~inlier_mask)),
        'odometry_chi2_mean': float(np.mean(final_odo_chi2)),
        'odometry_chi2_max': float(np.max(final_odo_chi2)),
        'inlier_loop_chi2_mean': float(np.mean(final_loop_chi2[inlier_mask])),
        'inlier_loop_chi2_max': float(np.max(final_loop_chi2[inlier_mask])),
        'outlier_loop_chi2_min': float(np.min(final_loop_chi2[~inlier_mask])),
        'outlier_loop_chi2_mean': float(np.mean(final_loop_chi2[~inlier_mask])),
        'refinement_iterations': int(refine_iters),
        'refinement_step_norm': float(refine_step),
        'world_frame_anchor': [float(poses[0, 0]), float(poses[0, 1]), float(poses[0, 2])]
    }
    return poses, final_loop_chi2, false_probs, inlier_mask, diagnostics


@contextlib.contextmanager
def suppress_c_stderr():
    sys.stderr.flush()
    try:
        null_fd = os.open(os.devnull, os.O_RDWR)
        save_fd = os.dup(2)
        os.dup2(null_fd, 2)
        os.close(null_fd)
        try:
            yield
        finally:
            sys.stderr.flush()
            os.dup2(save_fd, 2)
            os.close(save_fd)
    except Exception:
        yield

def _render_cairo_or_pil(poses_init, poses_opt, odo_df, loops_df, inlier_mask, output_path):
    try:
        import cairo
        has_cairo = True
    except ImportError:
        has_cairo = False

    width, height = 1400, 1100
    all_x = np.concatenate([poses_init[:, 0], poses_opt[:, 0]])
    all_y = np.concatenate([poses_init[:, 1], poses_opt[:, 1]])
    x_min, x_max = float(np.min(all_x)), float(np.max(all_x))
    y_min, y_max = float(np.min(all_y)), float(np.max(all_y))

    margin = 80
    data_w = max(x_max - x_min, 1.0)
    data_h = max(y_max - y_min, 1.0)

    scale = min((width - 2 * margin) / data_w, (height - 2 * margin) / data_h)
    plot_w, plot_h = data_w * scale, data_h * scale
    offset_x = margin + ((width - 2 * margin) - plot_w) / 2.0
    offset_y = margin + ((height - 2 * margin) - plot_h) / 2.0

    def to_screen(x, y):
        u = offset_x + (x - x_min) * scale
        v = (height - offset_y) - (y - y_min) * scale
        return u, v

    if has_cairo:
        surface = cairo.ImageSurface(cairo.FORMAT_ARGB32, width, height)
        ctx = cairo.Context(surface)
        ctx.set_source_rgb(0.98, 0.98, 0.99)
        ctx.paint()

        ctx.set_line_width(0.8)
        ctx.set_source_rgba(0.85, 0.85, 0.90, 0.7)
        for gx in np.arange(np.floor(x_min / 5) * 5, x_max + 5, 5):
            u1, v1 = to_screen(gx, y_min); u2, v2 = to_screen(gx, y_max)
            ctx.move_to(u1, v1); ctx.line_to(u2, v2); ctx.stroke()
        for gy in np.arange(np.floor(y_min / 5) * 5, y_max + 5, 5):
            u1, v1 = to_screen(x_min, gy); u2, v2 = to_screen(x_max, gy)
            ctx.move_to(u1, v1); ctx.line_to(u2, v2); ctx.stroke()

        # Dead reckoning
        ctx.set_source_rgba(0.55, 0.55, 0.60, 0.7)
        ctx.set_line_width(1.8)
        ctx.set_dash([6.0, 4.0])
        u0, v0 = to_screen(poses_init[0, 0], poses_init[0, 1])
        ctx.move_to(u0, v0)
        for p in poses_init[1:]:
            u, v = to_screen(p[0], p[1])
            ctx.line_to(u, v)
        ctx.stroke()
        ctx.set_dash([])

        # Rejected loops
        ctx.set_source_rgba(0.85, 0.15, 0.15, 0.8)
        ctx.set_line_width(2.0)
        ctx.set_dash([4.0, 4.0])
        for _, row in loops_df.iterrows():
            lid = int(row['loop_id'])
            if not inlier_mask[lid]:
                ui, vi = to_screen(poses_opt[int(row['from']), 0], poses_opt[int(row['from']), 1])
                uj, vj = to_screen(poses_opt[int(row['to']), 0], poses_opt[int(row['to']), 1])
                ctx.move_to(ui, vi); ctx.line_to(uj, vj); ctx.stroke()
        ctx.set_dash([])

        # Accepted loops
        ctx.set_source_rgba(0.05, 0.70, 0.30, 0.9)
        ctx.set_line_width(2.5)
        for _, row in loops_df.iterrows():
            lid = int(row['loop_id'])
            if inlier_mask[lid]:
                ui, vi = to_screen(poses_opt[int(row['from']), 0], poses_opt[int(row['from']), 1])
                uj, vj = to_screen(poses_opt[int(row['to']), 0], poses_opt[int(row['to']), 1])
                ctx.move_to(ui, vi); ctx.line_to(uj, vj); ctx.stroke()

        # Optimized trajectory
        ctx.set_source_rgba(0.10, 0.25, 0.65, 0.95)
        ctx.set_line_width(2.5)
        u0, v0 = to_screen(poses_opt[0, 0], poses_opt[0, 1])
        ctx.move_to(u0, v0)
        for p in poses_opt[1:]:
            u, v = to_screen(p[0], p[1])
            ctx.line_to(u, v)
        ctx.stroke()

        # Markers
        u_start, v_start = to_screen(poses_opt[0, 0], poses_opt[0, 1])
        ctx.set_source_rgb(0.1, 0.8, 0.2); ctx.arc(u_start, v_start, 7.0, 0, 2*np.pi); ctx.fill()
        ctx.set_source_rgb(0.0, 0.4, 0.1); ctx.set_line_width(2.0); ctx.arc(u_start, v_start, 7.0, 0, 2*np.pi); ctx.stroke()

        u_end, v_end = to_screen(poses_opt[-1, 0], poses_opt[-1, 1])
        ctx.set_source_rgb(0.9, 0.4, 0.1); ctx.arc(u_end, v_end, 7.0, 0, 2*np.pi); ctx.fill()
        ctx.set_source_rgb(0.5, 0.2, 0.0); ctx.set_line_width(2.0); ctx.arc(u_end, v_end, 7.0, 0, 2*np.pi); ctx.stroke()

        # Title & Legend
        ctx.select_font_face('Sans', cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_BOLD)
        ctx.set_font_size(22); ctx.set_source_rgb(0.1, 0.15, 0.3)
        ctx.move_to(margin, 45); ctx.show_text('Mobile Robot Trajectory & Loop Closure Consistency Analysis')

        ctx.select_font_face('Sans', cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_NORMAL)
        ctx.set_font_size(13); ctx.set_source_rgb(0.3, 0.35, 0.45)
        ctx.move_to(margin, 65)
        ctx.show_text(f'Poses: {len(poses_opt)} | Inlier Loops: {np.sum(inlier_mask)} | Rejected Loops: {np.sum(~inlier_mask)}')

        leg_x, leg_y = width - 360, 25
        ctx.set_source_rgba(1.0, 1.0, 1.0, 0.90); ctx.rectangle(leg_x, leg_y, 335, 115); ctx.fill()
        ctx.set_source_rgba(0.7, 0.7, 0.75, 0.8); ctx.set_line_width(1.0); ctx.rectangle(leg_x, leg_y, 335, 115); ctx.stroke()

        entries = [
            ('Optimized Trajectory', (0.10, 0.25, 0.65), False, 2.5),
            ('Initial Odometry (Dead Reckoning)', (0.55, 0.55, 0.60), True, 2.0),
            (f'Accepted Loops ({np.sum(inlier_mask)})', (0.05, 0.70, 0.30), False, 2.5),
            (f'Rejected False Loops ({np.sum(~inlier_mask)})', (0.85, 0.15, 0.15), True, 2.0),
        ]
        for idx, (label, col, dashed, lw) in enumerate(entries):
            ey = leg_y + 22 + idx * 24
            ctx.set_source_rgb(*col); ctx.set_line_width(lw)
            if dashed: ctx.set_dash([4.0, 3.0])
            else: ctx.set_dash([])
            ctx.move_to(leg_x + 15, ey); ctx.line_to(leg_x + 55, ey); ctx.stroke()
            ctx.set_dash([])
            ctx.select_font_face('Sans', cairo.FONT_SLANT_NORMAL, cairo.FONT_WEIGHT_NORMAL)
            ctx.set_font_size(12); ctx.set_source_rgb(0.15, 0.15, 0.2)
            ctx.move_to(leg_x + 65, ey + 4); ctx.show_text(label)

        surface.write_to_png(output_path)
    else:
        from PIL import Image, ImageDraw
        img = Image.new('RGB', (width, height), color=(250, 250, 252))
        draw = ImageDraw.Draw(img)
        pts_init = [to_screen(p[0], p[1]) for p in poses_init]
        draw.line(pts_init, fill=(140, 140, 150), width=2)
        for _, row in loops_df.iterrows():
            lid = int(row['loop_id'])
            col = (20, 180, 70) if inlier_mask[lid] else (220, 40, 40)
            lw = 3 if inlier_mask[lid] else 2
            p1 = to_screen(poses_opt[int(row['from']), 0], poses_opt[int(row['from']), 1])
            p2 = to_screen(poses_opt[int(row['to']), 0], poses_opt[int(row['to']), 1])
            draw.line([p1, p2], fill=col, width=lw)
        pts_opt = [to_screen(p[0], p[1]) for p in poses_opt]
        draw.line(pts_opt, fill=(25, 60, 160), width=3)
        img.save(output_path)


def render_map_diagnostics(*args, **kwargs):
    with suppress_c_stderr():
        _render_cairo_or_pil(*args, **kwargs)

def main():
    print('Starting Mobile Robot Map Consistency Analysis...')
    poses_initial = np.load('data/poses_initial.npy')
    odo_df = pd.read_csv('data/odometry_edges.csv')
    loops_df = pd.read_csv('data/loop_candidates.csv')

    poses_opt, final_chi2, false_probs, inlier_mask, diagnostics = solve_robust_pgo(
        poses_initial, odo_df, loops_df
    )

    np.save('poses.npy', poses_opt)
    scores_df = pd.DataFrame({
        'loop_id': loops_df['loop_id'].astype(int),
        'false_probability': np.round(false_probs, 6)
    })
    scores_df.to_csv('loop_closure_scores.csv', index=False)

    with open('metrics.json', 'w') as f:
        json.dump(diagnostics, f, indent=2)

    render_map_diagnostics(poses_initial, poses_opt, odo_df, loops_df, inlier_mask, 'map_diagnostics.png')
    print('Optimization and artifact generation completed successfully.')

if __name__ == '__main__':
    main()
