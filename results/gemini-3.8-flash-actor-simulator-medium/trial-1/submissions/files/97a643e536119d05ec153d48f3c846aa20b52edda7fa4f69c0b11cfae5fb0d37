import pandas as pd
import numpy as np

def run_analysis():
    # Load dataset
    df = pd.read_csv('data/requirements_engineering_for_ML-enabled_systems.csv')
    
    # Filter out missing/NA responses (-77, -99)
    q8_cols = {
        'Project Lead': 'Q8_ML_Addressing_Project_Lead',
        'Data Scientist': 'Q8_ML_Addressing_Data_Scientist',
        'Business Analyst': 'Q8_ML_Addressing_Business_Analyst',
        'Developer': 'Q8_ML_Addressing_Developer',
        'Solution Architect': 'Q8_ML_Addressing_Solution_Architect',
        'Requirements Engineer': 'Q8_ML_Addressing_Requirement_Engineer',
        'Tester': 'Q8_ML_Addressing_Tester',
        'Others': 'Q8_ML_Addressing_Others'
    }
    
    valid_df = df[~df['Q8_ML_Addressing_Project_Lead'].isin(['-77', '-99', -77, -99])].copy()
    N = len(valid_df)
    
    print(f"Total valid respondents for requirements addressing (Q8): {N}")
    
    np.random.seed(42)
    B = 10000
    
    summary = []
    for role, col in q8_cols.items():
        quoted_binary = (valid_df[col] == 'quoted').astype(int).values
        k = quoted_binary.sum()
        prop = k / N
        
        # Bootstrap resampling
        boot_samples = np.random.choice(quoted_binary, size=(B, N), replace=True)
        boot_props = boot_samples.mean(axis=1)
        boot_mean = boot_props.mean() * 100
        boot_ci_low, boot_ci_high = np.percentile(boot_props, [2.5, 97.5]) * 100
        
        summary.append({
            'Role': role,
            'Quoted_Count': k,
            'Total_N': N,
            'Observed_Pct': prop * 100,
            'Bootstrap_Mean_Pct': boot_mean,
            '95_CI_Low': boot_ci_low,
            '95_CI_High': boot_ci_high
        })
        
    res_df = pd.DataFrame(summary).sort_values(by='Observed_Pct', ascending=False)
    print("\nSummary of Role Associations with Requirements:")
    print(res_df.to_string(index=False))
    
    # Check top two roles
    top_two = res_df.iloc[:2]['Role'].tolist()
    print(f"\nTop two roles associated with requirements: {top_two[0]} and {top_two[1]}")
    return res_df

if __name__ == '__main__':
    run_analysis()
