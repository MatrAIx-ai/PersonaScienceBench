
import pandas as pd
import numpy as np

# Load data
df = pd.read_csv("data/nls_raw.csv")

# Race mapping
race_map = {1: "Black", 2: "Hispanic", 3: "White"}
df["Race"] = df["Racial/ethnic cohort, 1979"].map(race_map)

years = ["1985", "1990", "1996"]
wealth_cols = {
    "1985": "Family net wealth, 1985",
    "1990": "Family net wealth, 1990",
    "1996": "Family net wealth, 1996 (key data point)"
}

print("================================================================================")
print("TABLE 1: Family Net Wealth Distribution by Race (1985, 1990, 1996)")
print("================================================================================")
res_list = []
for yr in years:
    wcol = wealth_cols[yr]
    for r in ["White", "Black", "Hispanic"]:
        sub = df[df["Race"] == r][wcol].dropna()
        res_list.append({
            "Year": yr,
            "Race": r,
            "N": len(sub),
            "Median": np.median(sub),
            "Mean": np.mean(sub),
            "P25": np.percentile(sub, 25),
            "P75": np.percentile(sub, 75),
            "IQR": np.percentile(sub, 75) - np.percentile(sub, 25),
            "Pct_Zero_or_Neg": (sub <= 0).mean() * 100
        })

res_df = pd.DataFrame(res_list)
print(res_df.to_string(index=False))

print("\n================================================================================")
print("TABLE 2: Absolute and Relative Wealth Disparities (White vs Black, White vs Hispanic)")
print("================================================================================")
gap_list = []
for yr in years:
    w_med = res_df[(res_df["Year"] == yr) & (res_df["Race"] == "White")]["Median"].values[0]
    b_med = res_df[(res_df["Year"] == yr) & (res_df["Race"] == "Black")]["Median"].values[0]
    h_med = res_df[(res_df["Year"] == yr) & (res_df["Race"] == "Hispanic")]["Median"].values[0]
    
    gap_list.append({
        "Year": yr,
        "White Median": w_med,
        "Black Median": b_med,
        "Hispanic Median": h_med,
        "White-Black Gap ($)": w_med - b_med,
        "White/Black Ratio": w_med / b_med,
        "White-Hispanic Gap ($)": w_med - h_med,
        "White/Hispanic Ratio": w_med / h_med
    })

gap_df = pd.DataFrame(gap_list)
print(gap_df.to_string(index=False))

print("\n================================================================================")
print("TABLE 3: Asset Ownership Rates and Values by Asset Category")
print("================================================================================")

asset_types = {
    "Residential Property": {
        "1985": "Market value of residential property respondent/spouse own, 1985",
        "1990": "Market value of residential property respondent/spouse own, 1990",
        "1996": "Market value of residential property respondent/spouse own, 1996"
    },
    "Vehicles": {
        "1985": "Market Value of vehicles respondent/spouse own, 1985",
        "1990": "Market Value of vehicles respondent/spouse own, 1990",
        "1996": "Market Value of vehicles respondent/spouse own, 96"
    },
    "Farm/Business": {
        "1985": "Total market value of farm, business, and other property, 1985",
        "1990": "Total market value of farm, business, and other property, 1990",
        "1996": "Total market value of farm, business, and other property, 1996"
    },
    "Items > $500": {
        "1985": "Total market value of items over $500, 1985",
        "1990": "Total market value of items over $500, 1990",
        "1996": "Total market value of items over $500, 1996"
    }
}

asset_rows = []
for yr in years:
    wcol = wealth_cols[yr]
    for cat, cols in asset_types.items():
        col = cols[yr]
        for r in ["White", "Black", "Hispanic"]:
            sub = df[df["Race"] == r]
            w_valid = sub[wcol].dropna()
            n_w = len(w_valid)
            
            # Asset ownership among wealth respondents
            asset_s = sub.loc[w_valid.index, col]
            owners = asset_s[asset_s > 0]
            rate = len(owners) / n_w * 100
            med_val = owners.median() if len(owners) > 0 else 0
            mean_val = owners.mean() if len(owners) > 0 else 0
            
            asset_rows.append({
                "Year": yr,
                "Asset Category": cat,
                "Race": r,
                "Ownership Rate (%)": rate,
                "Median Value if Owned ($)": med_val,
                "Mean Value if Owned ($)": mean_val
            })

asset_df = pd.DataFrame(asset_rows)
print(asset_df.to_string(index=False))
