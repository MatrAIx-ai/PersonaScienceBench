#!/usr/bin/env python3
"""
Analysis of the independent effect of ongoing medical conditions (MHONGO)
on COVID-19 severity using ordinal logistic regression.

Dataset: TASK008 BCG-CORONA
Control variables:
  - BCG vaccination status (TRTGRP: BCG vs Placebo)
  - Patient interaction variables (patients_seen, expect_interact)
Outcome:
  - Primary: Maximum WHO Clinical Progression / Health Status scale (AEHS) per COVID-positive subject
Sensitivity analyses:
  - Episode-level AEHS (all COVID-19 adverse events)
  - Subject-level AESEV (clinical severity)
  - Full cohort (all participants)
"""

import pandas as pd
import numpy as np
from statsmodels.miscmodels.ordinal_model import OrderedModel

def run():
    # 1. Load data
    dm = pd.read_csv('data/TASK008_BCG-CORONA_DM.csv')
    ae = pd.read_csv('data/TASK008_BCG-CORONA_AE.csv')
    mh = pd.read_csv('data/TASK008_BCG-CORONA_MH.csv')

    # 2. Count ongoing medical conditions (MHONGO == 'Yes') per subject
    mh_ongo = mh[mh['MHONGO'] == 'Yes'].groupby('USUBJID').size().rename('mhongo')
    dm = dm.merge(mh_ongo, on='USUBJID', how='left')
    dm['mhongo'] = dm['mhongo'].fillna(0)

    # 3. Identify COVID-19 events in AE
    covid_ae = ae[ae['AEPT'].str.contains('COVID|corona|SARS', case=False, na=False)].copy()

    # 4. Primary Model: Maximum AEHS per COVID-positive participant
    subj_covid = covid_ae.groupby('USUBJID')['AEHS'].max().reset_index()
    df_primary = dm.merge(subj_covid, on='USUBJID', how='inner')

    formula = 'AEHS ~ mhongo + C(TRTGRP) + C(patients_seen) + C(expect_interact)'
    model_primary = OrderedModel.from_formula(formula, df_primary, distr='logit')
    res_primary = model_primary.fit(method='bfgs', disp=False)

    beta = res_primary.params['mhongo']
    se = res_primary.bse['mhongo']
    pval = res_primary.pvalues['mhongo']
    or_val = np.exp(beta)
    pct_inc = (or_val - 1.0) * 100.0
    ci_lower_or = np.exp(beta - 1.96 * se)
    ci_upper_or = np.exp(beta + 1.96 * se)
    ci_lower_pct = (ci_lower_or - 1.0) * 100.0
    ci_upper_pct = (ci_upper_or - 1.0) * 100.0

    print("=" * 70)
    print("PRIMARY MODEL RESULTS (Subject-level max AEHS among COVID cases)")
    print("=" * 70)
    print(f"Number of observations: {len(df_primary)}")
    print(res_primary.summary())
    print("\n" + "-" * 70)
    print(f"MHONGO coefficient (Beta): {beta:.4f}")
    print(f"Standard Error:           {se:.4f}")
    print(f"p-value:                  {pval:.4f}")
    print(f"Odds Ratio (OR):          {or_val:.4f} (95% CI: {ci_lower_or:.4f} to {ci_upper_or:.4f})")
    print(f"Percentage Increase:      {pct_inc:.2f}% (95% CI: {ci_lower_pct:.2f}% to {ci_upper_pct:.2f}%)")
    print("-" * 70)

    # 5. Sensitivity Analyses
    print("\n" + "=" * 70)
    print("SENSITIVITY ANALYSES")
    print("=" * 70)

    # 5.1 Episode-level
    df_ep = dm.merge(covid_ae[['USUBJID', 'AEHS']], on='USUBJID', how='inner')
    res_ep = OrderedModel.from_formula(formula, df_ep, distr='logit').fit(method='bfgs', disp=False)
    b_ep = res_ep.params['mhongo']
    pct_ep = (np.exp(b_ep) - 1.0) * 100.0
    print(f"1. Episode-level COVID records (N = {len(df_ep)}):")
    print(f"   Beta = {b_ep:.4f}, OR = {np.exp(b_ep):.4f}, Percentage Increase = {pct_ep:.2f}%")

    # 5.2 AESEV per subject
    subj_sev = covid_ae.dropna(subset=['AESEV']).groupby('USUBJID')['AESEV'].max().reset_index()
    df_sev = dm.merge(subj_sev, on='USUBJID', how='inner')
    res_sev = OrderedModel.from_formula('AESEV ~ mhongo + C(TRTGRP) + C(patients_seen) + C(expect_interact)', df_sev, distr='logit').fit(method='bfgs', disp=False)
    b_sev = res_sev.params['mhongo']
    pct_sev = (np.exp(b_sev) - 1.0) * 100.0
    print(f"2. Max AESEV per subject (N = {len(df_sev)}):")
    print(f"   Beta = {b_sev:.4f}, OR = {np.exp(b_sev):.4f}, Percentage Increase = {pct_sev:.2f}%")

    # 5.3 Full cohort (N=1000)
    df_full = dm.merge(subj_covid, on='USUBJID', how='left')
    df_full['AEHS_0'] = df_full['AEHS'].fillna(0)
    res_full = OrderedModel.from_formula('AEHS_0 ~ mhongo + C(TRTGRP) + C(patients_seen) + C(expect_interact)', df_full, distr='logit').fit(method='bfgs', disp=False)
    b_full = res_full.params['mhongo']
    pct_full = (np.exp(b_full) - 1.0) * 100.0
    print(f"3. Full Cohort (N = {len(df_full)}, non-COVID coded as 0):")
    print(f"   Beta = {b_full:.4f}, OR = {np.exp(b_full):.4f}, Percentage Increase = {pct_full:.2f}%")
    print("=" * 70)

if __name__ == '__main__':
    run()
