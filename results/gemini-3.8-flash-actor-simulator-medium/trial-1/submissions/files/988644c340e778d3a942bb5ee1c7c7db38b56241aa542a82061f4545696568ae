#!/usr/bin/env python3
"""
Analysis script for BixBench episode bix-22-q4:
Pearson correlation coefficient between gene length and mean expression (across samples)
for protein-coding genes in CD14 immune cells.
"""

import pandas as pd
import numpy as np
import scipy.stats as stats

def main():
    gene_meta_path = "data/GeneMetaInfo_Zenodo.csv"
    counts_path = "data/BatchCorrectedReadCounts_Zenodo.csv"
    sample_annot_path = "data/Sample_annotated_Zenodo.csv"

    print("Loading sample annotations...")
    df_sample = pd.read_csv(sample_annot_path)
    cd14_samples = df_sample[df_sample["celltype"] == "CD14"]["sample"].tolist()
    print(f"Total samples: {len(df_sample)}")
    print(f"CD14 samples identified: {len(cd14_samples)}")

    print("\nLoading gene metadata...")
    df_gene = pd.read_csv(gene_meta_path)
    print(f"Total genes in metadata: {len(df_gene)}")
    
    # Filter for protein-coding genes
    pc_mask = df_gene["gene_biotype"] == "protein_coding"
    df_gene_pc = df_gene[pc_mask].copy()
    print(f"Protein-coding genes: {len(df_gene_pc)}")

    print("\nLoading batch-corrected counts for CD14 samples...")
    cols_to_load = ["Unnamed: 0"] + cd14_samples
    df_counts = pd.read_csv(counts_path, usecols=cols_to_load)
    df_counts.rename(columns={"Unnamed: 0": "Geneid"}, inplace=True)
    print(f"Loaded counts matrix shape: {df_counts.shape}")

    # Merge on Geneid to ensure exact matching and ordering
    df_merged = pd.merge(df_gene_pc[["Geneid", "Length", "gene_biotype"]], 
                         df_counts, 
                         on="Geneid", 
                         how="inner").copy()
    print(f"Merged protein-coding genes matrix shape: {df_merged.shape}")

    # Calculate mean expression across CD14 samples for each gene
    mean_expr = df_merged[cd14_samples].mean(axis=1)
    df_merged["mean_expression"] = mean_expr

    # Summary statistics
    print("\n--- Summary Statistics ---")
    print("Gene Length:")
    print(df_merged["Length"].describe())
    print("\nMean Expression across CD14 samples:")
    print(df_merged["mean_expression"].describe())

    # Pearson correlation calculation
    r, pval = stats.pearsonr(df_merged["Length"], df_merged["mean_expression"])
    print("\n--- Primary Pearson Correlation (Gene Length vs Mean Expression) ---")
    print(f"Pearson correlation coefficient (r): {r:.8f}")
    print(f"p-value: {pval:.8e}")
    print(f"Pearson r (standard precision): {r}")

    # Sensitivity check: log2(expression + 1)
    r_log, pval_log = stats.pearsonr(df_merged["Length"], np.log2(df_merged["mean_expression"] + 1))
    print(f"\nSensitivity Check - Pearson r with log2(mean_expression + 1): {r_log:.8f} (p-value: {pval_log:.8e})")

    # Save summary results
    results_summary = {
        "metric": "Pearson correlation coefficient",
        "celltype": "CD14",
        "n_samples": len(cd14_samples),
        "n_genes": len(df_merged),
        "pearson_r": r,
        "p_value": pval
    }
    pd.DataFrame([results_summary]).to_csv("results_summary.csv", index=False)
    print("\nResults successfully saved to results_summary.csv")

if __name__ == "__main__":
    main()
