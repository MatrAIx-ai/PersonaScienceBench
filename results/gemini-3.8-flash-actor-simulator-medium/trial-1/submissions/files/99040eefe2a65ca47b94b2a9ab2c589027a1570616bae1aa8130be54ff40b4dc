import pandas as pd
import numpy as np

# Load dataset
df = pd.read_csv('data/requirements_engineering_for_ML-enabled_systems.csv')

# Filter out NA / non-responses (negative values such as -77, -99, -66)
q8_cols = {
    'Project Lead': 'Q8_ML_Addressing_Project_Lead',
    'Data Scientist': 'Q8_ML_Addressing_Data_Scientist',
    'Business Analyst': 'Q8_ML_Addressing_Business_Analyst',
    'Developer': 'Q8_ML_Addressing_Developer',
    'Solution Architect': 'Q8_ML_Addressing_Solution_Architect',
    'Requirement Engineer': 'Q8_ML_Addressing_Requirement_Engineer',
    'Tester': 'Q8_ML_Addressing_Tester',
    'Others': 'Q8_ML_Addressing_Others'
}

# The 82 records with -77 represent respondents who discontinued before Q8
valid_df = df[df['Q8_ML_Addressing_Project_Lead'] != '-77'].copy()
total_valid = len(valid_df)

print(f"Total rows in dataset: {len(df)}")
print(f"Valid responses for Q8 (excluding -77): {total_valid}")

# Compute counts and proportions
results = []
for role_name, col in q8_cols.items():
    quoted_count = (valid_df[col] == 'quoted').sum()
    prop = quoted_count / total_valid * 100
    results.append({
        'Role': role_name,
        'Column': col,
        'Quoted_Count': quoted_count,
        'Total_Valid': total_valid,
        'Proportion_pct': prop
    })

res_df = pd.DataFrame(results).sort_values(by='Proportion_pct', ascending=False)
print("\nRole Ranking by Proportion of Association with Requirements in ML-Enabled Systems:")
print(res_df.to_string(index=False))

# Non-parametric Bootstrap Resampling
np.random.seed(42)
n_bootstrap = 10000

bootstrap_summary = []
for role_name, col in q8_cols.items():
    binary_arr = (valid_df[col] == 'quoted').astype(int).values
    boot_means = [np.mean(np.random.choice(binary_arr, size=len(binary_arr), replace=True)) * 100 for _ in range(n_bootstrap)]
    
    b_mean = np.mean(boot_means)
    b_se = np.std(boot_means)
    ci_percentile = np.percentile(boot_means, [2.5, 97.5])
    # Standard error of the mean bootstrap estimate
    ci_mean_est = [b_mean - 1.96 * b_se / np.sqrt(n_bootstrap), b_mean + 1.96 * b_se / np.sqrt(n_bootstrap)]
    
    bootstrap_summary.append({
        'Role': role_name,
        'Sample_pct': np.mean(binary_arr) * 100,
        'Boot_Mean_pct': b_mean,
        'Boot_SE': b_se,
        'Percentile_95_CI': f"[{ci_percentile[0]:.3f}, {ci_percentile[1]:.3f}]",
        'Mean_Est_95_CI': f"[{ci_mean_est[0]:.3f}, {ci_mean_est[1]:.3f}]"
    })

boot_df = pd.DataFrame(bootstrap_summary).sort_values(by='Sample_pct', ascending=False)
print("\nBootstrap Results (10,000 iterations):")
print(boot_df.to_string(index=False))
