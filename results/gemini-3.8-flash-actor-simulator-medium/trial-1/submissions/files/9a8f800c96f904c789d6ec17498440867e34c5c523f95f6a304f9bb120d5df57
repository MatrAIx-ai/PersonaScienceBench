#!/usr/bin/env python3
"""
Gene Regulatory Network Inference Pipeline
Infers directed regulatory relationships among 25 genes using:
1. Continuous-time ODE modeling with regularized regression and stability selection.
2. Discrete-time Vector Autoregression (VAR) with stability selection.
3. Consensus integration, density thresholding, hub identification, and topological characterization.
"""

import os
import json
import numpy as np

def fista_lasso_multi(X, Y, alpha, max_iter=1000, tol=1e-6):
    """
    Vectorized FISTA (Fast Iterative Shrinkage-Thresholding Algorithm) for multi-response Lasso.
    Solves min_B 0.5 * ||Y - X B||_F^2 + alpha * ||B||_1
    """
    N, P = X.shape
    K = Y.shape[1]
    
    X_mean = np.mean(X, axis=0, keepdims=True)
    X_std = np.std(X, axis=0, keepdims=True)
    X_std[X_std == 0] = 1.0
    X_norm = (X - X_mean) / X_std
    
    Y_mean = np.mean(Y, axis=0, keepdims=True)
    Y_norm = Y - Y_mean
    
    s = np.linalg.svd(X_norm, compute_uv=False)
    L = (s[0]**2) / N
    step = 1.0 / (L * N)
    thresh = alpha / L
    
    B = np.zeros((P, K))
    B_prev = np.zeros((P, K))
    t = 1.0
    XT = X_norm.T
    
    for it in range(max_iter):
        V = B + ((t - 1.0) / (t + 2.0)) * (B - B_prev)
        grad = XT @ (X_norm @ V - Y_norm)
        B_new = V - step * grad
        B_new = np.sign(B_new) * np.maximum(0, np.abs(B_new) - thresh)
        if np.max(np.abs(B_new - B)) < tol:
            break
        B_prev = B
        B = B_new
        t += 1.0
        
    B_unscaled = B / X_std.T
    intercept = Y_mean - X_mean @ B_unscaled
    return B_unscaled.T, intercept # shape (K, P)

def run_stability_selection(X, Y, alphas=[0.02, 0.04, 0.06], n_boot=50, sub_ratio=0.8, seed=42):
    """
    Performs stability selection by subsampling data across multiple regularization parameters.
    """
    np.random.seed(seed)
    N = X.shape[0]
    sub_size = int(N * sub_ratio)
    K = Y.shape[1]
    P = X.shape[1]
    
    freq = np.zeros((K, P))
    signed_accum = np.zeros((K, P))
    total_runs = n_boot * len(alphas)
    
    for b in range(n_boot):
        idx = np.random.choice(N, sub_size, replace=False)
        X_sub, Y_sub = X[idx], Y[idx]
        for a in alphas:
            B, _ = fista_lasso_multi(X_sub, Y_sub, alpha=a)
            freq += (B != 0)
            signed_accum += np.sign(B)
            
    freq /= total_runs
    signed_accum /= total_runs
    return freq, signed_accum

def compute_r2(Y_true, Y_pred):
    ss_res = np.sum((Y_true - Y_pred)**2, axis=0)
    ss_tot = np.sum((Y_true - np.mean(Y_true, axis=0))**2, axis=0)
    return float(np.mean(1.0 - ss_res / np.maximum(ss_tot, 1e-12)))

def main():
    print("Loading data...")
    system_info_path = "data/system_info.json"
    ts_path = "data/expression_timeseries.npy"
    ss_path = "data/perturbation_steady_states.npy"
    
    with open(system_info_path, "r") as f:
        system_info = json.load(f)
        
    ts = np.load(ts_path)
    ss = np.load(ss_path)
    
    n_series, n_time, n_genes = ts.shape
    dt = system_info.get("sampling_interval", 0.612245)
    
    print(f"Data shape: {ts.shape}, {n_genes} genes, dt={dt}")
    
    # 1. Prepare data for Method 1: Continuous-time ODE model
    X_ode_list = []
    Y_ode_list = []
    for r in range(n_series):
        X_ode_list.append(ts[r])
        Y_ode_list.append(np.gradient(ts[r], dt, axis=0))
    X_ode = np.vstack(X_ode_list)
    Y_ode = np.vstack(Y_ode_list)
    
    # 2. Prepare data for Method 2: Discrete-time VAR model
    X_var_list = []
    Y_var_list = []
    for r in range(n_series):
        X_var_list.append(ts[r, :-1])
        Y_var_list.append((ts[r, 1:] - ts[r, :-1]) / dt)
    X_var = np.vstack(X_var_list)
    Y_var = np.vstack(Y_var_list)
    
    print("Executing Method 1: Continuous ODE Lasso Stability Selection...")
    freq_ode, signed_ode = run_stability_selection(X_ode, Y_ode, seed=42)
    B_ode_full, c_ode_full = fista_lasso_multi(X_ode, Y_ode, alpha=0.035)
    r2_ode = compute_r2(Y_ode, X_ode @ B_ode_full.T + c_ode_full)
    
    print("Executing Method 2: Discrete VAR(1) Lasso Stability Selection...")
    freq_var, signed_var = run_stability_selection(X_var, Y_var, seed=42)
    B_var_full, c_var_full = fista_lasso_multi(X_var, Y_var, alpha=0.035)
    r2_var = compute_r2(Y_var, X_var @ B_var_full.T + c_var_full)
    
    # Zero self-regulation diagonals on confidence matrices
    np.fill_diagonal(freq_ode, 0.0)
    np.fill_diagonal(freq_var, 0.0)
    np.fill_diagonal(signed_ode, 0.0)
    np.fill_diagonal(signed_var, 0.0)
    
    # Check inter-method correlation
    off_diag_mask = ~np.eye(n_genes, dtype=bool)
    inter_corr = float(np.corrcoef(freq_ode[off_diag_mask], freq_var[off_diag_mask])[0, 1])
    print(f"Method 1 Mean R2: {r2_ode:.4f}, Mean Stability: {float(np.mean(freq_ode[off_diag_mask])):.4f}")
    print(f"Method 2 Mean R2: {r2_var:.4f}, Mean Stability: {float(np.mean(freq_var[off_diag_mask])):.4f}")
    print(f"Inter-method off-diagonal correlation: {inter_corr:.4f}")
    
    # Consensus combination
    freq_comb = 0.5 * (freq_ode + freq_var)
    signed_comb = 0.5 * (signed_ode + signed_var)
    
    # Thresholding for required off-diagonal density (5% to 40%)
    # Target density ~ 8.8% (53 high-confidence edges)
    threshold = 0.45
    inferred_network = np.where(freq_comb >= threshold, freq_comb, 0.0).astype(np.float64)
    np.fill_diagonal(inferred_network, 0.0)
    
    n_off_diag = n_genes * (n_genes - 1) # 600
    n_edges = int(np.sum(inferred_network > 0.0))
    density = float(n_edges / n_off_diag)
    print(f"Inferred network: {n_edges} edges, off-diagonal density: {density*100:.2f}%")
    assert 0.05 <= density <= 0.40, f"Density {density} outside 5%-40% bounds!"
    
    # Edge sign predictions (+1, -1, 0)
    edge_sign_predictions = np.zeros((n_genes, n_genes), dtype=np.float64)
    nonzero_mask = inferred_network > 0.0
    edge_sign_predictions[nonzero_mask] = np.sign(signed_comb[nonzero_mask])
    # Ensure zero entries in inferred_network have 0 sign
    edge_sign_predictions[~nonzero_mask] = 0.0
    
    # Degree calculations (under [target, source] convention: row sum = in-degree, col sum = out-degree)
    exact_nonzero_topology = (inferred_network > 0.0).astype(int)
    in_degrees = np.sum(exact_nonzero_topology, axis=1)   # row sum
    out_degrees = np.sum(exact_nonzero_topology, axis=0)  # col sum
    
    # Identify top 2 regulator hub genes (highest out-degree)
    hub_order = np.argsort(out_degrees)[::-1]
    top_2_hubs = [int(hub_order[0]), int(hub_order[1])]
    print(f"Top 2 Hub Genes (Regulators): {top_2_hubs} (Out-degrees: {[int(out_degrees[g]) for g in top_2_hubs]})")
    
    # Save artifacts
    np.save("inferred_network.npy", inferred_network)
    np.save("edge_sign_predictions.npy", edge_sign_predictions)
    
    hub_genes_data = {
        "hub_genes": top_2_hubs
    }
    with open("hub_genes.json", "w") as f:
        json.dump(hub_genes_data, f, indent=2)
        
    method_comparison_data = {
        "methods": [
            {
                "name": "Continuous ODE Lasso Stability Selection",
                "description": "Continuous-time dynamical model dx/dt = A x + c estimated via finite differences and regularized Lasso across multi-alpha stability subsampling.",
                "mean_r2": round(r2_ode, 4),
                "stability": round(float(np.mean(freq_ode[off_diag_mask])), 4),
                "strengths": "Directly models physical continuous rate of change and accounts for multivariate confounding.",
                "limitations": "Susceptible to noise in numerical derivative estimation."
            },
            {
                "name": "Discrete VAR(1) Lasso Stability Selection",
                "description": "Discrete-time vector autoregressive model (x(t+dt) - x(t))/dt = B x(t) + c capturing multi-step transition dynamics with stability selection.",
                "mean_r2": round(r2_var, 4),
                "stability": round(float(np.mean(freq_var[off_diag_mask])), 4),
                "strengths": "Robust against derivative approximation artifacts; directly reflects single-lag prediction capability.",
                "limitations": "Assumes discrete linear lag-1 transitions; can attenuate fast transient dynamics."
            }
        ],
        "inter_method_correlation": round(inter_corr, 4)
    }
    with open("method_comparison.json", "w") as f:
        json.dump(method_comparison_data, f, indent=2)
        
    network_metrics_data = {
        "n_edges": n_edges,
        "density": round(density, 6),
        "in_degree": {
            "mean": round(float(np.mean(in_degrees)), 4),
            "std": round(float(np.std(in_degrees)), 4),
            "median": float(np.median(in_degrees)),
            "min": int(np.min(in_degrees)),
            "max": int(np.max(in_degrees)),
            "values": [int(d) for d in in_degrees]
        },
        "out_degree": {
            "mean": round(float(np.mean(out_degrees)), 4),
            "std": round(float(np.std(out_degrees)), 4),
            "median": float(np.median(out_degrees)),
            "min": int(np.min(out_degrees)),
            "max": int(np.max(out_degrees)),
            "values": [int(d) for d in out_degrees]
        },
        "degree_statistics": {
            "mean_degree": round(float(np.mean(in_degrees)), 4),
            "max_in_degree": int(np.max(in_degrees)),
            "max_out_degree": int(np.max(out_degrees)),
            "hub_genes": top_2_hubs
        }
    }
    with open("network_metrics.json", "w") as f:
        json.dump(network_metrics_data, f, indent=2)
        
    print("All artifacts successfully generated.")

if __name__ == "__main__":
    main()
