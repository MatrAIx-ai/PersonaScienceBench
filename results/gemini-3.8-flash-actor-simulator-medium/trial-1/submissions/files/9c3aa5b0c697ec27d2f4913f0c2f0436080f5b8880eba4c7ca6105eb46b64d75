import pandas as pd
import numpy as np
import scipy.stats as stats
import statsmodels.api as sm
import statsmodels.formula.api as smf

# Load datasets
invaded = pd.read_csv('data/invaded_niche_pathways.csv', sep='\t')
temporal = pd.read_csv('data/temporal_trends_contingency_table.csv', sep='\t')
success = pd.read_csv('data/invasion_success_pathways.csv')

# Clean column names
invaded.columns = [c.replace('.', '_') for c in invaded.columns]
invaded['has_gard'] = (invaded['n_gard'] > 0).astype(int)
invaded['has_unint'] = (invaded['n_unint'] > 0).astype(int)
invaded['has_alien'] = (invaded['n_total'] > 0).astype(int)
invaded['prop_gard'] = np.where(invaded['n_total'] > 0, invaded['n_gard'] / invaded['n_total'], np.nan)

# 1. Habitat Summary
habitat_summary = invaded.groupby('habitat').agg(
    plots=('n_total', 'count'),
    plots_invaded=('has_alien', 'sum'),
    pct_invaded=('has_alien', lambda x: 100 * x.mean()),
    plots_gard=('has_gard', 'sum'),
    pct_gard_occupied=('has_gard', lambda x: 100 * x.mean()),
    mean_n_gard=('n_gard', 'mean'),
    std_n_gard=('n_gard', 'std'),
    mean_n_unint=('n_unint', 'mean'),
    mean_n_agfo=('n_agfo', 'mean'),
    mean_n_total=('n_total', 'mean'),
    sum_gard=('n_gard', 'sum'),
    sum_unint=('n_unint', 'sum'),
    sum_agfo=('n_agfo', 'sum'),
    sum_total=('n_total', 'sum'),
    mean_prop_gard_invaded=('prop_gard', 'mean')
)
habitat_summary['overall_prop_gard'] = habitat_summary['sum_gard'] / habitat_summary['sum_total']
print("=== HABITAT SUMMARY ===")
print(habitat_summary.round(3).to_string())

# 2. Broad Habitat Categories
def broad_cat(h):
    if h in ['Coastal', 'Wetlands', 'Riparian']:
        return 'Aquatic/Littoral'
    elif h in ['Urban', 'Croplands']:
        return 'Anthropogenic'
    elif h in ['Broad-leaved forests', 'Coniferous forests']:
        return 'Forested'
    else:
        return 'Harsh/Open Natural'

invaded['broad_habitat'] = invaded['habitat'].apply(broad_cat)
broad_table = invaded.groupby('broad_habitat')[['n_gard', 'n_unint', 'n_agfo', 'n_total']].sum()
broad_table['gard_share'] = broad_table['n_gard'] / broad_table['n_total']
broad_table['unint_share'] = broad_table['n_unint'] / broad_table['n_total']
print("\n=== BROAD HABITAT TABLE ===")
print(broad_table.round(3))

# Chi-Square Test
chi2, p_val, dof, _ = stats.chi2_contingency(broad_table[['n_gard', 'n_unint']])
print(f"\nChi-Square Test (Gard vs Unint across broad habitats): chi2={chi2:.2f}, p={p_val:.2e}")

# 3. Environmental Models
# Logistic for gardening presence across landscape
m_presence = smf.logit('has_gard ~ elevation + annual_temperature + distance_stream + distance_road + urban_2009_500m + cropland_2009_500m', data=invaded).fit(disp=False)
print("\n=== LOGISTIC MODEL: GARDENING OCCUPANCY ===")
print(m_presence.summary())

# GLM Binomial for relative proportion among invaded plots
inv_subset = invaded[invaded['n_total'] > 0].copy()
glm_relative = smf.glm('prop_gard ~ elevation + urban_2009_500m + cropland_2009_500m + distance_stream + distance_road',
                       data=inv_subset, family=sm.families.Binomial(), var_weights=inv_subset['n_total']).fit()
print("\n=== GLM BINOMIAL: RELATIVE GARDENING PROPORTION ===")
print(glm_relative.summary())

# Trait comparisons
print("\n=== TRAITS BY PATHWAY ===")
print(success.groupby('intro.pathway')[['height', 'invaded.niche.breadth', 'native.niche.breadth', 'mrt']].mean().round(3))
print(pd.crosstab(success['intro.pathway'], success['growth.form']))
