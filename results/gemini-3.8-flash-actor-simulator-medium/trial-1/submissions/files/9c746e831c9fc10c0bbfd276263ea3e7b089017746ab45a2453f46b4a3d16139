import pandas as pd
import numpy as np

# Load data
df = pd.read_csv('data/meta-regression_study_data_heterogeneity_in_replication_projects.csv')

# Unique studies by ID
df_id = df.drop_duplicates(subset=['id'])

# Function to get summary statistics
def summary_stats(df_subset, name):
    s = df_subset['length']
    return {
        'Group': name,
        'N': int(s.count()),
        'Mean': round(float(s.mean()), 2),
        'SD': round(float(s.std()), 2),
        'Median': round(float(s.median()), 2),
        'Min': int(s.min()),
        'Max': int(s.max())
    }

results = []
# Economics
results.append(summary_stats(df_id[df_id['discipline'] == 'Economics'], 'Experimental Economics (ee)'))

# Psychology overall (Cognitive + Social)
results.append(summary_stats(df_id[df_id['discipline'].isin(['Cognitive', 'Social'])], 'Psychology (Cognitive + Social, All)'))

# Psychology subdisciplines
results.append(summary_stats(df_id[df_id['discipline'] == 'Cognitive'], '  - Cognitive Psychology'))
results.append(summary_stats(df_id[df_id['discipline'] == 'Social'], '  - Social Psychology'))

# Psychology by projects
results.append(summary_stats(df_id[df_id['project'] == 'rpp'], 'Psychology (RPP project only)'))
results.append(summary_stats(df_id[df_id['project'] == 'ml1'], 'Many Labs 1 (ml1)'))
results.append(summary_stats(df_id[df_id['project'] == 'ml3'], 'Many Labs 3 (ml3)'))

res_df = pd.DataFrame(results)
print(res_df.to_string(index=False))
