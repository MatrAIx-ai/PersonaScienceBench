import pandas as pd

# Load dataset
data_path = 'data/meta-regression_study_data_heterogeneity_in_replication_projects.csv'
df = pd.read_csv(data_path)

# Filter for Experimental Economics project
ee_df = df[df['project'] == 'ee']

# Count total studies and studies conducted in the United Kingdom
total_studies = len(ee_df)
uk_studies = (ee_df['experiment_country.o'] == 'United Kingdom').sum()
proportion = uk_studies / total_studies
percentage = proportion * 100

print(f"Total Experimental Economics studies: {total_studies}")
print(f"Studies conducted in the United Kingdom: {uk_studies}")
print(f"Proportion: {proportion:.6f}")
print(f"Percentage: {percentage:.2f}%")

# Country breakdown
country_counts = ee_df['experiment_country.o'].value_counts()
print("\nCountry breakdown:")
print(country_counts)
