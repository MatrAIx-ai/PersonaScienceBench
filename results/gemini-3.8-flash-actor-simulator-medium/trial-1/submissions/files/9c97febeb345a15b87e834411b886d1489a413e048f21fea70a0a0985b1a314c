import gzip
import struct
import pandas as pd

def parse_rds(file_path):
    """
    Parse an R serialization (version 3) RDS file containing DESeqResults.
    """
    with gzip.open(file_path, 'rb') as f:
        buf = f.read()

    offset = 23

    def read_item(depth=0):
        nonlocal offset
        if offset >= len(buf):
            return None
        start_off = offset
        flags = struct.unpack('>I', buf[offset:offset+4])[0]
        offset += 4
        
        sxp_type = flags & 0xff
        has_attr = bool(flags & (1 << 9))
        has_tag = bool(flags & (1 << 10))
        
        if sxp_type == 254: return None
        if sxp_type == 255: return f'REF({flags >> 8})'
        if sxp_type == 253: return 'GLOBALENV'
        if sxp_type == 252: return 'BASEENV'
        if sxp_type == 251: return 'EMPTYENV'
        if sxp_type == 250: return 'BCMISCSXP'
        if sxp_type == 249: return 'MISSINGARG'
        
        tag = None
        if has_tag:
            tag = read_item(depth+1)
            
        val = None
        if sxp_type == 1:
            pname = read_item(depth+1)
            val = f'SYM({pname})'
        elif sxp_type in (2, 6):
            car = read_item(depth+1)
            cdr = read_item(depth+1)
            val = {'type': 'pairlist' if sxp_type == 2 else 'lang', 'tag': tag, 'car': car, 'cdr': cdr}
        elif sxp_type == 9:
            length = struct.unpack('>i', buf[offset:offset+4])[0]
            offset += 4
            val = buf[offset:offset+length].decode('utf-8', errors='replace')
            offset += length
        elif sxp_type == 10:
            length = struct.unpack('>i', buf[offset:offset+4])[0]
            offset += 4
            val = struct.unpack(f'>{length}i', buf[offset:offset+length*4])
            offset += length * 4
        elif sxp_type == 16:
            length = struct.unpack('>i', buf[offset:offset+4])[0]
            offset += 4
            val = [read_item(depth+1) for _ in range(length)]
        elif sxp_type == 14:
            length = struct.unpack('>i', buf[offset:offset+4])[0]
            offset += 4
            val = struct.unpack(f'>{length}d', buf[offset:offset+length*8])
            offset += length * 8
        elif sxp_type == 13:
            length = struct.unpack('>i', buf[offset:offset+4])[0]
            offset += 4
            val = struct.unpack(f'>{length}i', buf[offset:offset+length*4])
            offset += length * 4
        elif sxp_type == 19:
            length = struct.unpack('>i', buf[offset:offset+4])[0]
            offset += 4
            val = [read_item(depth+1) for _ in range(length)]
        elif sxp_type == 25:
            val = {'type': 'S4'}
        else:
            raise ValueError(f'Unknown type {sxp_type} at {start_off}')

        if has_attr:
            attrs = read_item(depth+1)
            if isinstance(val, dict):
                val['attrs'] = attrs
            else:
                val = {'val': val, 'attrs': attrs}

        return val

    res = read_item()

    def pl_to_dict(pl):
        d = {}
        cur = pl
        while cur and isinstance(cur, dict) and cur.get('type') == 'pairlist':
            tag = cur.get('tag')
            car = cur.get('car')
            d[tag] = car
            cur = cur.get('cdr')
        return d

    slots = pl_to_dict(res['attrs'])
    rownames = slots['SYM(rownames)']
    list_data = slots['REF(7)']
    col_names = pl_to_dict(list_data['attrs'])['REF(8)']
    cols = list_data['val']

    df = pd.DataFrame({col: list(data) for col, data in zip(col_names, cols)}, index=rownames)
    return df

def main():
    # 1. Map mexG to Locus Tag
    annot_df = pd.read_csv('data/Pseudomonas_aeruginosa_UCBPP-PA14.csv')
    mexg_match = annot_df[annot_df['Gene Name'] == 'mexG']
    if mexg_match.empty:
        raise ValueError("mexG not found in annotation file")
    locus_tag = mexg_match.iloc[0]['Locus Tag']
    print(f"mexG Locus Tag: {locus_tag}")

    # 2. Parse res_1vs97.rds
    res_df = parse_rds('data/res_1vs97.rds')
    print(f"Parsed DESeqResults: shape {res_df.shape}")

    # 3. Extract log2FoldChange
    row = res_df.loc[locus_tag]
    lfc = row['log2FoldChange']
    rounded_lfc = round(lfc, 2)
    print(f"Results for {locus_tag} (mexG):")
    print(row)
    print(f"\nFinal log2 fold change (rounded to 2 decimal places): {rounded_lfc:.2f}")

if __name__ == '__main__':
    main()
