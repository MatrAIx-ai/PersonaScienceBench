#!/usr/bin/env python3
"""
Analysis script for BixBench episode bix-22-q2:
Calculate Pearson correlation coefficient between gene length and mean expression
(across samples) for protein-coding genes in CD4 immune cells.
"""

import pandas as pd
import numpy as np
from scipy import stats

def main():
    # 1. Load sample annotations and identify CD4 samples
    sample_df = pd.read_csv('data/Sample_annotated_Zenodo.csv')
    cd4_samples = sample_df[sample_df['celltype'] == 'CD4']['sample'].tolist()
    print(f"Identified {len(cd4_samples)} CD4 cell samples.")

    # 2. Load gene metadata and filter for protein-coding genes
    gene_df = pd.read_csv('data/GeneMetaInfo_Zenodo.csv')
    pc_genes = gene_df[gene_df['gene_biotype'] == 'protein_coding'].copy()
    print(f"Identified {len(pc_genes)} protein-coding genes.")

    # 3. Load batch-corrected read counts
    counts_df = pd.read_csv('data/BatchCorrectedReadCounts_Zenodo.csv')
    gene_col = counts_df.columns[0]

    # Index by gene ID
    counts_indexed = counts_df.set_index(gene_col)
    pc_genes_indexed = pc_genes.set_index('Geneid')

    # Subset CD4 samples for protein-coding genes
    counts_cd4 = counts_indexed.loc[pc_genes_indexed.index, cd4_samples]

    # 4. Compute mean expression across CD4 samples
    mean_expr = counts_cd4.mean(axis=1)
    gene_length = pc_genes_indexed['Length']

    # 5. Compute Pearson correlation
    r, pval = stats.pearsonr(gene_length, mean_expr)
    print("\n--- Results ---")
    print(f"Pearson correlation coefficient (r): {r:.6f}")
    print(f"p-value: {pval:.4e}")
    print(f"Pearson r (full precision): {r}")

    # Diagnostics
    print("\n--- Diagnostics ---")
    print(f"Gene length: min={gene_length.min()}, max={gene_length.max()}, mean={gene_length.mean():.2f}, median={gene_length.median():.2f}")
    print(f"Mean expression: min={mean_expr.min():.4f}, max={mean_expr.max():.4f}, mean={mean_expr.mean():.4f}, median={mean_expr.median():.4f}")
    zero_count = (mean_expr == 0).sum()
    print(f"Zero-expression genes count: {zero_count} ({zero_count / len(mean_expr) * 100:.2f}%)")

    # Additional sensitivity diagnostics
    r_nonzero, p_nonzero = stats.pearsonr(gene_length[mean_expr > 0], mean_expr[mean_expr > 0])
    print(f"Pearson r (excluding 0-expression genes, n={(mean_expr > 0).sum()}): {r_nonzero:.6f} (p={p_nonzero:.4e})")

    spearman_rho, spearman_pval = stats.spearmanr(gene_length, mean_expr)
    print(f"Spearman correlation coefficient (rho): {spearman_rho:.6f} (p={spearman_pval:.4e})")

if __name__ == '__main__':
    main()
