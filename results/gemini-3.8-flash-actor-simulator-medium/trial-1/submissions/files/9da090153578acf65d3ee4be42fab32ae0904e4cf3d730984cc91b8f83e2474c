import pandas as pd
import numpy as np

# Load the dataset
df = pd.read_csv('data/requirements_engineering_for_ML-enabled_systems.csv')

# Q10 documentation formats columns
q10_cols = [
    'Q10_ML_Documentation_Not_Documented',
    'Q10_ML_Documentation_Vision_Document',
    'Q10_ML_Documentation_Requirements_Lists',
    'Q10_ML_Documentation_Goal_Models',
    'Q10_ML_Documentation_Use_Case_Models',
    'Q10_ML_Documentation_Prototypes',
    'Q10_ML_Documentation_User_Stories',
    'Q10_ML_Documentation_BDD_Scenarios',
    'Q10_ML_Documentation_MLCanvas',
    'Q10_ML_Documentation_Notebooks',
    'Q10_ML_Documentation_Data_Models',
    'Q10_ML_Documentation_Others'
]

# Filtering out negative missing values (-77 indicates drop-out before Q10)
valid_mask = df['Q10_ML_Documentation_Not_Documented'] != '-77'
df_valid = df[valid_mask].copy()

print(f"Total respondents: {len(df)}")
print(f"Valid respondents answering Q10: {len(df_valid)}")
print(f"Excluded non-responses (-77): {len(df) - len(df_valid)}")

results = []
for col in q10_cols:
    format_name = col.replace('Q10_ML_Documentation_', '')
    cnt = (df_valid[col] == 'quoted').sum()
    pct_valid = cnt / len(df_valid) * 100
    pct_all = cnt / len(df) * 100
    results.append({
        'column': col,
        'format': format_name,
        'count': cnt,
        'pct_of_valid_respondents': pct_valid,
        'pct_of_all_respondents': pct_all
    })

results_df = pd.DataFrame(results).sort_values('count', ascending=True)
print("\nDocumentation Formats ranked by usage frequency:")
print(results_df.to_string(index=False))

# Bootstrap simulation
np.random.seed(42)
B = 10000
boot_results = []
for idx, row in results_df.iterrows():
    col = row['column']
    arr_valid = (df_valid[col] == 'quoted').values.astype(float)
    boot_means = [np.mean(np.random.choice(arr_valid, size=len(arr_valid), replace=True)) * 100 for _ in range(B)]
    mean_boot = np.mean(boot_means)
    ci_lower = np.percentile(boot_means, 2.5)
    ci_upper = np.percentile(boot_means, 97.5)
    boot_results.append({
        'format': row['format'],
        'boot_mean': mean_boot,
        'ci_lower': ci_lower,
        'ci_upper': ci_upper
    })

boot_df = pd.DataFrame(boot_results)
print("\nBootstrap Results (10,000 iterations):")
print(boot_df.to_string(index=False))
