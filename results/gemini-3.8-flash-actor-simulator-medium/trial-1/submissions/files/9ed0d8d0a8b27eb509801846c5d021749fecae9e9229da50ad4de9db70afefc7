import numpy as np
import json

def _identify_roles(params, meta):
    D = meta["width"]
    D_aux = meta["aux_width"]
    H_q = meta["parts_a"]

    table_keys = [k for k in params.keys() if k.startswith("table")]
    assert len(table_keys) == 2
    if params[table_keys[0]][0].mean() > 0.5:
        cos_key, sin_key = table_keys[0], table_keys[1]
    else:
        cos_key, sin_key = table_keys[1], table_keys[0]

    wv_keys = [k for k in params.keys() if k.startswith("vector") and params[k].shape == (D,)]
    assert len(wv_keys) == 3
    gamma_key = [k for k in wv_keys if params[k].mean() > 0.5][0]
    biases_wv = [k for k in wv_keys if params[k].mean() <= 0.5]
    if params[biases_wv[0]].std() > params[biases_wv[1]].std():
        bq_key, bo_key = biases_wv[0], biases_wv[1]
    else:
        bq_key, bo_key = biases_wv[1], biases_wv[0]

    sq_keys = [k for k in params.keys() if k.startswith("matrix") and params[k].shape == (D, D)]
    assert len(sq_keys) == 2
    if params[sq_keys[0]].std() > params[sq_keys[1]].std():
        Wq_key, Wo_key = sq_keys[0], sq_keys[1]
    else:
        Wq_key, Wo_key = sq_keys[1], sq_keys[0]

    kvv_keys = [k for k in params.keys() if k.startswith("vector") and params[k].shape == (D_aux,)]
    assert len(kvv_keys) == 3
    bg_key = [k for k in kvv_keys if params[k].mean() > 0.3][0]
    biases_kv = [k for k in kvv_keys if params[k].mean() <= 0.3]
    if params[biases_kv[0]].std() < params[biases_kv[1]].std():
        bk_key, bv_key = biases_kv[0], biases_kv[1]
    else:
        bk_key, bv_key = biases_kv[1], biases_kv[0]

    kvm_keys = [k for k in params.keys() if k.startswith("matrix") and params[k].shape == (D, D_aux)]
    assert len(kvm_keys) == 3
    Wg_key = [k for k in kvm_keys if params[k].std() < 0.08][0]
    other_kv = [k for k in kvm_keys if params[k].std() >= 0.08]
    kurt0 = np.mean(((params[other_kv[0]] - params[other_kv[0]].mean()) / params[other_kv[0]].std())**4)
    kurt1 = np.mean(((params[other_kv[1]] - params[other_kv[1]].mean()) / params[other_kv[1]].std())**4)
    if kurt0 < kurt1:
        Wk_key, Wv_key = other_kv[0], other_kv[1]
    else:
        Wk_key, Wv_key = other_kv[1], other_kv[0]

    hv_keys = [k for k in params.keys() if k.startswith("vector") and params[k].shape == (H_q,)]
    assert len(hv_keys) == 1
    vh_key = hv_keys[0]

    return {
        "W_q": Wq_key, "b_q": bq_key,
        "W_k": Wk_key, "b_k": bk_key,
        "W_v": Wv_key, "b_v": bv_key,
        "W_g": Wg_key, "b_g": bg_key,
        "W_o": Wo_key, "b_o": bo_key,
        "gamma": gamma_key,
        "v_head": vh_key,
        "cos_t": cos_key,
        "sin_t": sin_key,
    }

def _sigmoid(z):
    return 1.0 / (1.0 + np.exp(-z))

def sequence_operator_forward(x, segment_ids, params, meta, return_cache=False):
    key_map = _identify_roles(params, meta)

    W_q, b_q = params[key_map["W_q"]], params[key_map["b_q"]]
    W_k, b_k = params[key_map["W_k"]], params[key_map["b_k"]]
    W_v, b_v = params[key_map["W_v"]], params[key_map["b_v"]]
    W_g, b_g = params[key_map["W_g"]], params[key_map["b_g"]]
    W_o, b_o = params[key_map["W_o"]], params[key_map["b_o"]]
    gamma, v_head = params[key_map["gamma"]], params[key_map["v_head"]]
    cos_t, sin_t = params[key_map["cos_t"]], params[key_map["sin_t"]]

    eps = meta["epsilon"]
    span = meta["span"]
    rep = meta["repeat_factor"]
    d = meta["part_width"]
    H_q, H_kv = meta["parts_a"], meta["parts_b"]
    B, L, D = x.shape

    s = np.mean(x**2, axis=-1, keepdims=True)
    r = 1.0 / np.sqrt(s + eps)
    x_hat = x * r
    x_norm = x_hat * gamma

    Q = x_norm @ W_q + b_q
    K = x_norm @ W_k + b_k
    V_raw = x_norm @ W_v + b_v
    G = x_norm @ W_g + b_g
    sig_G = _sigmoid(G)
    V = V_raw * sig_G

    Q_h = Q.reshape(B, L, H_q, d)
    K_h = K.reshape(B, L, H_kv, d)
    V_h = V.reshape(B, L, H_kv, d)

    c0, s0 = cos_t[None, :, None, 0], sin_t[None, :, None, 0]
    c1, s1 = cos_t[None, :, None, 1], sin_t[None, :, None, 1]

    Q_rot = Q_h.copy()
    Q_rot[..., 0] = Q_h[..., 0] * c0 - Q_h[..., 1] * s0
    Q_rot[..., 1] = Q_h[..., 0] * s0 + Q_h[..., 1] * c0
    Q_rot[..., 2] = Q_h[..., 2] * c1 - Q_h[..., 3] * s1
    Q_rot[..., 3] = Q_h[..., 2] * s1 + Q_h[..., 3] * c1

    K_rot = K_h.copy()
    K_rot[..., 0] = K_h[..., 0] * c0 - K_h[..., 1] * s0
    K_rot[..., 1] = K_h[..., 0] * s0 + K_h[..., 1] * c0
    K_rot[..., 2] = K_h[..., 2] * c1 - K_h[..., 3] * s1
    K_rot[..., 3] = K_h[..., 2] * s1 + K_h[..., 3] * c1

    K_rep = np.repeat(K_rot, rep, axis=2)
    V_rep = np.repeat(V_h, rep, axis=2)

    Q_heads = np.swapaxes(Q_rot, 1, 2)
    K_heads = np.swapaxes(K_rep, 1, 2)
    V_heads = np.swapaxes(V_rep, 1, 2)

    scores = np.matmul(Q_heads, np.swapaxes(K_heads, -1, -2)) / np.sqrt(d)
    dist = (np.arange(L)[:, None] - np.arange(L)[None, :]).astype(scores.dtype)
    alibi = v_head[None, :, None, None] * dist[None, None, :, :]
    logits = scores - alibi

    i_idx, j_idx = np.arange(L)[:, None], np.arange(L)[None, :]
    causal = (j_idx <= i_idx)
    same_seg = (segment_ids[:, :, None] == segment_ids[:, None, :])
    span_mask = (i_idx - j_idx < span)
    mask = causal[None, :, :] & same_seg & span_mask[None, :, :]

    logits_masked = np.where(mask[:, None, :, :], logits, -1e9)
    logits_max = np.max(logits_masked, axis=-1, keepdims=True)
    exp_logits = np.exp(logits_masked - logits_max)
    exp_logits = np.where(mask[:, None, :, :], exp_logits, 0.0)
    attn_weights = exp_logits / np.sum(exp_logits, axis=-1, keepdims=True)

    ctx_heads = np.matmul(attn_weights, V_heads)
    ctx = np.swapaxes(ctx_heads, 1, 2).reshape(B, L, D)
    output = ctx @ W_o + b_o

    if not return_cache:
        return output

    cache = {
        "x": x, "segment_ids": segment_ids, "key_map": key_map,
        "x_hat": x_hat, "r": r, "x_norm": x_norm,
        "Q": Q, "K": K, "V_raw": V_raw, "G": G, "sig_G": sig_G, "V": V,
        "Q_h": Q_h, "K_h": K_h, "V_h": V_h,
        "Q_rot": Q_rot, "K_rot": K_rot, "K_rep": K_rep, "V_rep": V_rep,
        "Q_heads": Q_heads, "K_heads": K_heads, "V_heads": V_heads,
        "dist": dist, "mask": mask, "attn_weights": attn_weights,
        "ctx_heads": ctx_heads, "ctx": ctx,
        "cos_t": cos_t, "sin_t": sin_t,
    }
    return output, cache

def sequence_operator_backward(sensitivity, cache, params, meta):
    key_map = cache["key_map"]
    W_o, W_q = params[key_map["W_o"]], params[key_map["W_q"]]
    W_k, W_v = params[key_map["W_k"]], params[key_map["W_v"]]
    W_g, gamma = params[key_map["W_g"]], params[key_map["gamma"]]
    cos_t, sin_t = cache["cos_t"], cache["sin_t"]

    rep = meta["repeat_factor"]
    d = meta["part_width"]
    H_q, H_kv = meta["parts_a"], meta["parts_b"]
    B, L, D = cache["x"].shape

    d_out = sensitivity
    d_W_o = np.matmul(cache["ctx"].reshape(-1, D).T, d_out.reshape(-1, D))
    d_b_o = np.sum(d_out, axis=(0, 1))
    d_ctx = d_out @ W_o.T

    d_ctx_heads = np.swapaxes(d_ctx.reshape(B, L, H_q, d), 1, 2)
    attn_weights = cache["attn_weights"]
    V_heads = cache["V_heads"]
    d_attn_weights = np.matmul(d_ctx_heads, np.swapaxes(V_heads, -1, -2))
    d_V_heads = np.matmul(np.swapaxes(attn_weights, -1, -2), d_ctx_heads)

    sum_dP_P = np.sum(d_attn_weights * attn_weights, axis=-1, keepdims=True)
    d_logits = attn_weights * (d_attn_weights - sum_dP_P)
    d_logits = np.where(cache["mask"][:, None, :, :], d_logits, 0.0)

    d_alibi = -d_logits
    d_v_head = np.sum(d_alibi * cache["dist"][None, None, :, :], axis=(0, 2, 3))

    d_scores = d_logits
    d_Q_heads = np.matmul(d_scores, cache["K_heads"]) / np.sqrt(d)
    d_K_heads = np.matmul(np.swapaxes(d_scores, -1, -2), cache["Q_heads"]) / np.sqrt(d)

    d_Q_rot = np.swapaxes(d_Q_heads, 1, 2)
    d_K_rep = np.swapaxes(d_K_heads, 1, 2)
    d_V_rep = np.swapaxes(d_V_heads, 1, 2)

    d_K_rot = np.sum(d_K_rep.reshape(B, L, H_kv, rep, d), axis=3)
    d_V_h = np.sum(d_V_rep.reshape(B, L, H_kv, rep, d), axis=3)

    c0, s0 = cos_t[None, :, None, 0], sin_t[None, :, None, 0]
    c1, s1 = cos_t[None, :, None, 1], sin_t[None, :, None, 1]

    d_Q_h = d_Q_rot.copy()
    d_Q_h[..., 0] = d_Q_rot[..., 0] * c0 + d_Q_rot[..., 1] * s0
    d_Q_h[..., 1] = -d_Q_rot[..., 0] * s0 + d_Q_rot[..., 1] * c0
    d_Q_h[..., 2] = d_Q_rot[..., 2] * c1 + d_Q_rot[..., 3] * s1
    d_Q_h[..., 3] = -d_Q_rot[..., 2] * s1 + d_Q_rot[..., 3] * c1

    d_K_h = d_K_rot.copy()
    d_K_h[..., 0] = d_K_rot[..., 0] * c0 + d_K_rot[..., 1] * s0
    d_K_h[..., 1] = -d_K_rot[..., 0] * s0 + d_K_rot[..., 1] * c0
    d_K_h[..., 2] = d_K_rot[..., 2] * c1 + d_K_rot[..., 3] * s1
    d_K_h[..., 3] = -d_K_rot[..., 2] * s1 + d_K_rot[..., 3] * c1

    Q_h = cache["Q_h"]
    dQ_c0 = np.sum(d_Q_rot[..., 0] * Q_h[..., 0] + d_Q_rot[..., 1] * Q_h[..., 1], axis=(0, 2))
    dQ_s0 = np.sum(-d_Q_rot[..., 0] * Q_h[..., 1] + d_Q_rot[..., 1] * Q_h[..., 0], axis=(0, 2))
    dQ_c1 = np.sum(d_Q_rot[..., 2] * Q_h[..., 2] + d_Q_rot[..., 3] * Q_h[..., 3], axis=(0, 2))
    dQ_s1 = np.sum(-d_Q_rot[..., 2] * Q_h[..., 3] + d_Q_rot[..., 3] * Q_h[..., 2], axis=(0, 2))

    K_h = cache["K_h"]
    dK_c0 = np.sum(d_K_rot[..., 0] * K_h[..., 0] + d_K_rot[..., 1] * K_h[..., 1], axis=(0, 2))
    dK_s0 = np.sum(-d_K_rot[..., 0] * K_h[..., 1] + d_K_rot[..., 1] * K_h[..., 0], axis=(0, 2))
    dK_c1 = np.sum(d_K_rot[..., 2] * K_h[..., 2] + d_K_rot[..., 3] * K_h[..., 3], axis=(0, 2))
    dK_s1 = np.sum(-d_K_rot[..., 2] * K_h[..., 3] + d_K_rot[..., 3] * K_h[..., 2], axis=(0, 2))

    d_cos_t = np.zeros_like(cos_t)
    d_cos_t[:, 0] = dQ_c0 + dK_c0
    d_cos_t[:, 1] = dQ_c1 + dK_c1

    d_sin_t = np.zeros_like(sin_t)
    d_sin_t[:, 0] = dQ_s0 + dK_s0
    d_sin_t[:, 1] = dQ_s1 + dK_s1

    dQ = d_Q_h.reshape(B, L, H_q * d)
    dK = d_K_h.reshape(B, L, H_kv * d)
    dV = d_V_h.reshape(B, L, H_kv * d)

    sig_G = cache["sig_G"]
    V_raw = cache["V_raw"]
    dV_raw = dV * sig_G
    dG = dV * V_raw * sig_G * (1.0 - sig_G)

    x_norm_flat = cache["x_norm"].reshape(-1, D)
    d_W_q = np.matmul(x_norm_flat.T, dQ.reshape(-1, H_q * d))
    d_b_q = np.sum(dQ, axis=(0, 1))

    d_W_k = np.matmul(x_norm_flat.T, dK.reshape(-1, H_kv * d))
    d_b_k = np.sum(dK, axis=(0, 1))

    d_W_v = np.matmul(x_norm_flat.T, dV_raw.reshape(-1, H_kv * d))
    d_b_v = np.sum(dV_raw, axis=(0, 1))

    d_W_g = np.matmul(x_norm_flat.T, dG.reshape(-1, H_kv * d))
    d_b_g = np.sum(dG, axis=(0, 1))

    d_x_norm = (dQ @ W_q.T) + (dK @ W_k.T) + (dV_raw @ W_v.T) + (dG @ W_g.T)

    d_gamma = np.sum(d_x_norm * cache["x_hat"], axis=(0, 1))
    d_x_hat = d_x_norm * gamma

    r = cache["r"]
    x_hat = cache["x_hat"]
    sum_dxhat_xhat = np.sum(d_x_hat * x_hat, axis=-1, keepdims=True)
    dx = r * (d_x_hat - (1.0 / D) * x_hat * sum_dxhat_xhat)

    grads = {}
    grads["x"] = dx
    grads[key_map["W_q"]] = d_W_q
    grads[key_map["b_q"]] = d_b_q
    grads[key_map["W_k"]] = d_W_k
    grads[key_map["b_k"]] = d_b_k
    grads[key_map["W_v"]] = d_W_v
    grads[key_map["b_v"]] = d_b_v
    grads[key_map["W_g"]] = d_W_g
    grads[key_map["b_g"]] = d_b_g
    grads[key_map["W_o"]] = d_W_o
    grads[key_map["b_o"]] = d_b_o
    grads[key_map["gamma"]] = d_gamma
    grads[key_map["v_head"]] = d_v_head
    grads[key_map["cos_t"]] = d_cos_t
    grads[key_map["sin_t"]] = d_sin_t

    return grads

def sequence_operator_hvp(x, segment_ids, params, meta, sensitivity, direction):
    h = 1e-4

    def _get_grad(shift):
        if shift == 0.0:
            _, cache = sequence_operator_forward(x, segment_ids, params, meta, return_cache=True)
            return sequence_operator_backward(sensitivity, cache, params, meta)
        x_s = x + shift * direction["x"]
        params_s = {k: params[k] + shift * direction[k] for k in params}
        _, cache = sequence_operator_forward(x_s, segment_ids, params_s, meta, return_cache=True)
        return sequence_operator_backward(sensitivity, cache, params_s, meta)

    g_2h = _get_grad(2.0 * h)
    g_h = _get_grad(h)
    g_mh = _get_grad(-h)
    g_m2h = _get_grad(-2.0 * h)

    hvp = {}
    for k in g_h:
        hvp[k] = (-g_2h[k] + 8.0 * g_h[k] - 8.0 * g_mh[k] + g_m2h[k]) / (12.0 * h)

    return hvp
