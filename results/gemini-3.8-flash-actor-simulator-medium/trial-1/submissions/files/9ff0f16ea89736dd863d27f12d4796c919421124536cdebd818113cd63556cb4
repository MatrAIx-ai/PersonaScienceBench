import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf

def main():
    df = pd.read_csv('data/nls_ses_processed.csv')
    df.columns = [c.replace(' ', '_').replace(':', '') for c in df.columns]
    df['BA_DEGREE_COMPLETED'] = df['BA_DEGREE_COMPLETED'].astype(int)

    # 1. Logit Baseline
    m1 = smf.logit('BA_DEGREE_COMPLETED ~ SES * C(SAMPLE_RACE, Treatment(reference="White"))', data=df).fit(disp=False)
    
    # 2. Logit Full
    m2 = smf.logit('BA_DEGREE_COMPLETED ~ SES * C(SAMPLE_RACE, Treatment(reference="White")) + ABILITY_COMPOSITE_OF_ASVAB_SCORE + PERCENTILE_IN_CLASS + C(SAMPLE_SEX) + FAMILY_SIZE_OF_SAMPLE', data=df).fit(disp=False)
    
    # 3. LPM Baseline
    lpm1 = smf.ols('BA_DEGREE_COMPLETED ~ SES * C(SAMPLE_RACE, Treatment(reference="White"))', data=df).fit(cov_type='HC1')
    
    # 4. LPM Full
    lpm2 = smf.ols('BA_DEGREE_COMPLETED ~ SES * C(SAMPLE_RACE, Treatment(reference="White")) + ABILITY_COMPOSITE_OF_ASVAB_SCORE + PERCENTILE_IN_CLASS + C(SAMPLE_SEX) + FAMILY_SIZE_OF_SAMPLE', data=df).fit(cov_type='HC1')
    
    print("Baseline Logit Interaction (SES:Black): coef =", m1.params['SES:C(SAMPLE_RACE, Treatment(reference="White"))[T.Black]'], "p =", m1.pvalues['SES:C(SAMPLE_RACE, Treatment(reference="White"))[T.Black]'])
    print("Full Logit Interaction (SES:Black): coef =", m2.params['SES:C(SAMPLE_RACE, Treatment(reference="White"))[T.Black]'], "p =", m2.pvalues['SES:C(SAMPLE_RACE, Treatment(reference="White"))[T.Black]'])
    print("Baseline LPM Interaction (SES:Black): coef =", lpm1.params['SES:C(SAMPLE_RACE, Treatment(reference="White"))[T.Black]'], "p =", lpm1.pvalues['SES:C(SAMPLE_RACE, Treatment(reference="White"))[T.Black]'])
    print("Full LPM Interaction (SES:Black): coef =", lpm2.params['SES:C(SAMPLE_RACE, Treatment(reference="White"))[T.Black]'], "p =", lpm2.pvalues['SES:C(SAMPLE_RACE, Treatment(reference="White"))[T.Black]'])

if __name__ == '__main__':
    main()
