import pandas as pd

# Load capital dataset
df_cap = pd.read_csv('data/capital.csv', decimal=',')

# Calculate Social Capital (Copper/Gold, Amber, Monument Count)
social_cols = ['ZCU_AU', 'Zamber', 'ZMonument']
df_cap['social_capital'] = df_cap[social_cols].sum(axis=1)

# Calculate Total Summed Capital (all 12 indicators)
all_cols = ['ZAxtSchwert', 'ZDolch', 'Zhausgr', 'ZCU_AU', 'Zamber', 'ZMonument', 
            'ZHort', 'ZSichel', 'ZBeil', 'ZMW', 'ZKeform', 'Zkeverz']
df_cap['total_capital'] = df_cap[all_cols].sum(axis=1)

print("Peak Social Capital:")
print(df_cap[['BCE', 'group', 'social_capital', 'total_capital'] + social_cols].sort_values(by='social_capital', ascending=False).head(5))

print("\nPeak Total Capital:")
print(df_cap[['BCE', 'group', 'social_capital', 'total_capital']].sort_values(by='total_capital', ascending=False).head(5))

# Changes from 1500 BCE to 1400 BCE
diff = df_cap[df_cap['BCE'] == 1400][all_cols].values - df_cap[df_cap['BCE'] == 1500][all_cols].values
diff_df = pd.DataFrame(diff, columns=all_cols, index=['Change_1500_to_1400_BCE'])
print("\nComponent Changes (1500 BCE to 1400 BCE):")
print(diff_df.T)
