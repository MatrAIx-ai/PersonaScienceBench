import pandas as pd
import sys

def main():
    csv_file = 'data/ZF_AgeRelated_CpG_noMT_Final.csv'
    df = pd.read_csv(csv_file)
    print("=" * 60)
    print("Zebra Finch Methylation Filtering Analysis")
    print("=" * 60)
    print(f"Total rows in dataset: {len(df)}")
    total_sites = df['Pos'].nunique()
    print(f"Total unique CpG sites (by Pos): {total_sites}")

    # Baseline calculation:
    # A site "shows >90% or <10% methylation" if at least one sample has
    # MethylationPercentage > 90 or MethylationPercentage < 10.
    # Therefore, sites that DO NOT show >90% or <10% methylation are those
    # where min >= 10 and max <= 90 across all samples.
    # These non-extreme sites are the ones removed.
    
    grp = df.groupby('Pos')['MethylationPercentage']
    min_meth = grp.min()
    max_meth = grp.max()
    mean_meth = grp.mean()
    sample_count = grp.count()

    # Baseline (Strict inequalities >90 and <10):
    shows_gt90_lt10 = (max_meth > 90) | (min_meth < 10)
    sites_removed_strict = (~shows_gt90_lt10).sum()
    sites_kept_strict = shows_gt90_lt10.sum()

    print("\n--- Baseline Criteria (All 1,140 sites, strict inequalities >90 and <10) ---")
    print(f"Sites showing >90% or <10% methylation: {sites_kept_strict}")
    print(f"Sites removed (not showing >90% or <10% methylation): {sites_removed_strict}")

    # Inclusive inequalities (>=90 and <=10):
    shows_ge90_le10 = (max_meth >= 90) | (min_meth <= 10)
    sites_removed_inclusive = (~shows_ge90_le10).sum()
    sites_kept_inclusive = shows_ge90_le10.sum()

    print("\n--- Diagnostic: Inclusive Boundaries (>=90 and <=10) ---")
    print(f"Sites showing >=90% or <=10% methylation: {sites_kept_inclusive}")
    print(f"Sites removed (not showing >=90% or <=10% methylation): {sites_removed_inclusive}")

    # Subset with SampleShared == 20 (sites detected across all 20 samples):
    df_shared20 = df[df['SampleShared'] == 20]
    grp20 = df_shared20.groupby('Pos')['MethylationPercentage']
    total_shared20 = df_shared20['Pos'].nunique()
    min20 = grp20.min()
    max20 = grp20.max()
    shows_strict_20 = (max20 > 90) | (min20 < 10)
    removed_strict_20 = (~shows_strict_20).sum()

    print("\n--- Diagnostic: Shared Across All 20 Samples (846 sites) ---")
    print(f"Total sites with SampleShared == 20: {total_shared20}")
    print(f"Sites showing >90% or <10% methylation: {shows_strict_20.sum()}")
    print(f"Sites removed (not showing >90% or <10%): {removed_strict_20}")

    # Mean methylation across samples:
    shows_mean_strict = (mean_meth > 90) | (mean_meth < 10)
    print("\n--- Diagnostic: Mean Methylation Criteria ---")
    print(f"Sites with mean methylation >90% or <10%: {shows_mean_strict.sum()}")
    print(f"Sites removed if using mean methylation: {(~shows_mean_strict).sum()}")

    # Row-level diagnostic:
    row_shows_strict = (df['MethylationPercentage'] > 90) | (df['MethylationPercentage'] < 10)
    print("\n--- Diagnostic: Row-level Observation Criteria ---")
    print(f"Rows showing >90% or <10%: {row_shows_strict.sum()}")
    print(f"Rows not showing >90% or <10%: {(~row_shows_strict).sum()}")

    print("\n" + "=" * 60)
    print(f"FINAL ANSWER: {sites_removed_strict}")
    print("=" * 60)

if __name__ == '__main__':
    main()
