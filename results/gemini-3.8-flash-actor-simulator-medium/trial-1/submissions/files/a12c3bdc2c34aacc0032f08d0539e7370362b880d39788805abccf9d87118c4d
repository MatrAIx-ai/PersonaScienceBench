import pandas as pd
import numpy as np
import statsmodels.api as sm

# 1. Load dataset
data_path = 'data/nls_ses_processed.csv'
df = pd.read_csv(data_path)

# 2. Variable preparation
df['BA'] = df['BA DEGREE COMPLETED'].astype(int)
df['Black'] = (df['SAMPLE_RACE'] == 'Black').astype(int)
df['Hispanic'] = (df['SAMPLE_RACE'] == 'Hispanic').astype(int)
df['White'] = (df['SAMPLE_RACE'] == 'White').astype(int)
df['Female'] = (df['SAMPLE_SEX'] == 'Female').astype(int)
df['Male'] = (df['SAMPLE_SEX'] == 'Male').astype(int)

# 3. Fit Model Specifications
models = {}

# Baseline models
# Model A: Raw race differences (White reference)
X_a = sm.add_constant(df[['Black', 'Hispanic']])
models['Model_Race_Only'] = sm.Logit(df['BA'], X_a).fit(disp=False)

# Model B: Social background (Race, Sex, Family Size)
X_b = sm.add_constant(df[['Black', 'Hispanic', 'Female', 'FAMILY SIZE OF SAMPLE']])
models['Model_Social_Background'] = sm.Logit(df['BA'], X_b).fit(disp=False)

# Model C: Expanded Model with SES and Academic Characteristics (Ability & Class Percentile)
X_c = sm.add_constant(df[['Black', 'Hispanic', 'SES', 'ABILITY: COMPOSITE OF ASVAB SCORE', 'PERCENTILE IN CLASS']])
models['Model_Expanded_SES_Academic'] = sm.Logit(df['BA'], X_c).fit(disp=False)

# Model D: Full Model with Social Background, SES, and Academic Characteristics
X_d = sm.add_constant(df[['Black', 'Hispanic', 'Female', 'FAMILY SIZE OF SAMPLE', 'SES', 'ABILITY: COMPOSITE OF ASVAB SCORE', 'PERCENTILE IN CLASS']])
models['Model_Full'] = sm.Logit(df['BA'], X_d).fit(disp=False)

# Summary table
results = []
for name, m in models.items():
    for var in m.params.index:
        results.append({
            'Model': name,
            'Variable': var,
            'Coefficient': m.params[var],
            'Std_Error': m.bse[var],
            'Z_stat': m.tvalues[var],
            'P_value': m.pvalues[var]
        })

res_df = pd.DataFrame(results)
res_df.to_csv('regression_results.csv', index=False)
print("Analysis complete. Saved regression_results.csv.")
print("\nExpanded Model Coefficients:")
print(res_df[res_df['Model'] == 'Model_Expanded_SES_Academic'])
