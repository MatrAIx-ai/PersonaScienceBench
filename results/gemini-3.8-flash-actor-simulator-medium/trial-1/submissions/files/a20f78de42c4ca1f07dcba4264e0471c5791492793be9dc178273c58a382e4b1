import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf

def run_analysis():
    df = pd.read_csv('data/nls_raw.csv')
    
    # 1. BA indicator
    df['ba'] = (df['Highest grade completed, 1979'] >= 16).astype(int)
    
    # 2. Race indicators
    df['black'] = (df['Racial/ethnic cohort, 1979'] == 1).astype(int)
    df['hispanic'] = (df['Racial/ethnic cohort, 1979'] == 2).astype(int)
    df['white'] = (df['Racial/ethnic cohort, 1979'] == 3).astype(int)
    
    # 3. Demographics & ASVAB
    df['age'] = df['Age of respondent, 1979']
    df['female'] = (df['Sex of respondent, 1979'] == 2).astype(int)
    asvab_cols = [
        'ASVAB - Arithmetic Reasoning Z Score (rounded), 1981',
        'ASVAB - Word Knowledge Z Score (rounded), 1981',
        'ASVAB - Paragraph Comprehension Z Score (rounded), 1981',
        'ASVAB - Mathematics Knowledge Z Score (rounded), 1981'
    ]
    df['asvab'] = df[asvab_cols].mean(axis=1)
    
    # 4. SES measures
    df['mother_ed'] = df["Highest grade completed by respondent's mother, 1979"]
    df['father_ed'] = df["Highest grade completed by respondent's father, 1979"]
    df['parent_ed'] = df[['mother_ed', 'father_ed']].mean(axis=1)
    df['income'] = df['Total net family income, previous calendar year, 1979']
    
    df['z_peduc'] = (df['parent_ed'] - df['parent_ed'].mean()) / df['parent_ed'].std()
    df['z_inc'] = (df['income'] - df['income'].mean()) / df['income'].std()
    
    # Broad SES (available components)
    df['ses_broad'] = df[['z_peduc', 'z_inc']].mean(axis=1)
    df['ses_broad_tercile'] = pd.qcut(df['ses_broad'].dropna(), 3, labels=['Low', 'Medium', 'High'])
    df['ses_broad_quartile'] = pd.qcut(df['ses_broad'].dropna(), 4, labels=['Q1', 'Q2', 'Q3', 'Q4'])
    
    # Strict SES (complete cases on both components)
    df['ses_strict'] = (df['z_peduc'] + df['z_inc']) / 2.0
    df['ses_strict_tercile'] = pd.qcut(df['ses_strict'].dropna(), 3, labels=['Low', 'Medium', 'High'])
    
    # Subset Black and White
    df_bw = df[df['black'].isin([0, 1]) & (df['hispanic'] == 0)].copy()
    
    print("=== Broad SES Terciles (Black vs White) ===")
    for t in ['Low', 'Medium', 'High']:
        sub = df_bw[df_bw['ses_broad_tercile'] == t]
        b = sub[sub['black'] == 1]['ba']
        w = sub[sub['white'] == 1]['ba']
        diff = b.mean() - w.mean()
        ratio = b.mean() / w.mean() if w.mean() > 0 else np.nan
        print(f"{t}: Black={b.sum()}/{len(b)} ({b.mean()*100:.3f}%), White={w.sum()}/{len(w)} ({w.mean()*100:.3f}%), Diff={diff*100:+.3f}%, Ratio={ratio:.2f}")
        
    print("\n=== Strict SES Terciles (Black vs White) ===")
    for t in ['Low', 'Medium', 'High']:
        sub = df_bw[df_bw['ses_strict_tercile'] == t]
        b = sub[sub['black'] == 1]['ba']
        w = sub[sub['white'] == 1]['ba']
        diff = b.mean() - w.mean()
        ratio = b.mean() / w.mean() if w.mean() > 0 else np.nan
        print(f"{t}: Black={b.sum()}/{len(b)} ({b.mean()*100:.3f}%), White={w.sum()}/{len(w)} ({w.mean()*100:.3f}%), Diff={diff*100:+.3f}%, Ratio={ratio:.2f}")

    print("\n=== Regression Models ===")
    m_ols = smf.ols('ba ~ black * ses_broad + age + female', data=df_bw).fit()
    print("LPM black:ses_broad interaction:", m_ols.params.get('black:ses_broad'))
    
    m_logit = smf.logit('ba ~ black + ses_broad + age + female', data=df_bw).fit(disp=False)
    print("Logit black coef (OR):", np.exp(m_logit.params['black']))

if __name__ == '__main__':
    run_analysis()
