#!/usr/bin/env python3
"""
Comprehensive Analysis Script for BixBench bix-14-q3:
Filter non-reference exonic variants in clonal hematopoiesis (CHIP) genes across 86 samples.
"""

import os
import glob
import pandas as pd

def run_analysis():
    genes_file = 'data/230214_Schenz_et_al_2022_CHIP_Genes.xlsx'
    chip_genes_df = pd.read_excel(genes_file, header=None)
    chip_genes_set = set(chip_genes_df[0].dropna().astype(str).str.strip())
    print(f"Loaded {len(chip_genes_set)} CHIP genes from {genes_file}")

    sample_files = sorted(glob.glob('data/CHIP_DP10_GQ20_PASS/*.xlsx'))
    print(f"Found {len(sample_files)} sample files in data/CHIP_DP10_GQ20_PASS/")

    exonic_so = {
        'missense_variant',
        'synonymous_variant',
        'frameshift_variant',
        'inframe_insertion',
        'inframe_deletion'
    }

    # Counters
    # 1. Strict non-ref (Heterozygous or Homozygous Variant) + CHIP gene filtered
    strict_chip_calls = 0
    strict_chip_unique = set()
    so_counts_strict = {}
    gene_counts_strict = {}

    # 2. Filtering by Zygosity != 'Reference' (including NaN) + CHIP gene filtered
    notref_chip_calls = 0
    notref_chip_unique = set()

    # 3. Strict non-ref (Het/Hom) + all file records
    strict_all_calls = 0
    strict_all_unique = set()

    # 4. Zygosity != 'Reference' + all file records
    notref_all_calls = 0
    notref_all_unique = set()

    for fpath in sample_files:
        df = pd.read_excel(fpath, header=[0, 1])
        zyg_col = [c for c in df.columns if c[1] == 'Zygosity'][0]
        so_col = [c for c in df.columns if c[1] == 'Sequence Ontology (Combined)'][0]
        gene_col = [c for c in df.columns if c[1] == 'Gene Names'][0]
        chr_pos_col = ('Variant Info', 'Chr:Pos')
        ref_alt_col = ('Variant Info', 'Ref/Alt')

        for _, row in df.iterrows():
            zyg = row[zyg_col]
            so = row[so_col]
            gene_entry = str(row[gene_col])
            gene_list = [g.strip() for g in gene_entry.split(',')]
            is_chip = any(g in chip_genes_set for g in gene_list)
            var_id = (row[chr_pos_col], row[ref_alt_col])

            is_exonic = so in exonic_so
            is_het_hom = zyg in ['Heterozygous', 'Homozygous Variant']
            is_not_ref = zyg != 'Reference'  # True for Het, Hom, and NaN

            if is_exonic:
                if is_het_hom:
                    strict_all_calls += 1
                    strict_all_unique.add(var_id)
                    if is_chip:
                        strict_chip_calls += 1
                        strict_chip_unique.add(var_id)
                        so_counts_strict[so] = so_counts_strict.get(so, 0) + 1
                        for g in gene_list:
                            if g in chip_genes_set:
                                gene_counts_strict[g] = gene_counts_strict.get(g, 0) + 1

                if is_not_ref:
                    notref_all_calls += 1
                    notref_all_unique.add(var_id)
                    if is_chip:
                        notref_chip_calls += 1
                        notref_chip_unique.add(var_id)

    print("\n" + "="*50)
    print("DETAILED RESULTS:")
    print("="*50)
    print("1. Primary Interpretation (Strict Non-Reference: Het/Hom, 56 CHIP genes):")
    print(f"   - Total non-reference exonic calls (sample-level): {strict_chip_calls}")
    print(f"   - Unique non-reference exonic variants (genomic-level): {len(strict_chip_unique)}")

    print("\n2. Pandas Filter Interpretation (Zygosity != 'Reference', 56 CHIP genes):")
    print(f"   - Total non-reference exonic calls (sample-level): {notref_chip_calls}")
    print(f"   - Unique non-reference exonic variants (genomic-level): {len(notref_chip_unique)}")

    print("\n3. Broad Gene Interpretation (Strict Het/Hom, all records in CHIP folder):")
    print(f"   - Total non-reference exonic calls (sample-level): {strict_all_calls}")
    print(f"   - Unique non-reference exonic variants (genomic-level): {len(strict_all_unique)}")

    print("\n4. Broad Gene Interpretation (Zygosity != 'Reference', all records in CHIP folder):")
    print(f"   - Total non-reference exonic calls (sample-level): {notref_all_calls}")
    print(f"   - Unique non-reference exonic variants (genomic-level): {len(notref_all_unique)}")

    print("\nSequence Ontology breakdown for strict CHIP calls:")
    for so, count in sorted(so_counts_strict.items(), key=lambda x: -x[1]):
        print(f"   {so}: {count}")

    print("\nTop 10 CHIP genes by strict exonic call count:")
    for gene, count in sorted(gene_counts_strict.items(), key=lambda x: -x[1])[:10]:
        print(f"   {gene}: {count}")

    return {
        'strict_chip_calls': strict_chip_calls,
        'strict_chip_unique': len(strict_chip_unique),
        'notref_chip_calls': notref_chip_calls,
        'notref_chip_unique': len(notref_chip_unique)
    }

if __name__ == '__main__':
    run_analysis()
