#!/usr/bin/env python3
"""
Logistic regression analysis predicting efficacy PR using age as the sole predictor.
"""
import os
import numpy as np
import pandas as pd
import statsmodels.api as sm

def main():
    data_path = os.path.join(os.path.dirname(__file__), 'data', 'data.xlsx')
    raw_df = pd.read_excel(data_path)
    
    # Filter to valid patient cohort (valid sequence number 1 to 80)
    df = raw_df[raw_df['Sequence number'].notnull()].copy()
    df['Age'] = pd.to_numeric(df['Age'], errors='coerce')
    
    # Verify cohort size
    assert len(df) == 80, f"Expected 80 records, got {len(df)}"
    assert not df['Age'].isnull().any(), "Found missing Age values in cohort"
    
    # Code binary outcome: Efficacy PR = 1, SD/PD = 0
    df['PR'] = (df['Efficacy'] == 'PR').astype(int)
    
    # Summary of cohort
    print(f"Cohort size: {len(df)}")
    print(f"PR cases: {df['PR'].sum()} ({df['PR'].mean()*100:.2f}%)")
    print(f"Non-PR cases: {(1 - df['PR']).sum()} ({(1 - df['PR']).mean()*100:.2f}%)")
    print(f"Age summary (overall): mean={df['Age'].mean():.2f}, sd={df['Age'].std():.2f}, min={df['Age'].min()}, max={df['Age'].max()}")
    print(f"Age summary (PR): mean={df.loc[df['PR']==1, 'Age'].mean():.2f}, sd={df.loc[df['PR']==1, 'Age'].std():.2f}")
    print(f"Age summary (Non-PR): mean={df.loc[df['PR']==0, 'Age'].mean():.2f}, sd={df.loc[df['PR']==0, 'Age'].std():.2f}")
    
    # Fit logistic regression model: logit(P(PR)) = beta0 + beta1 * Age
    X = sm.add_constant(df['Age'])
    y = df['PR']
    
    logit_model = sm.Logit(y, X).fit()
    print("\n--- Logistic Regression Model Summary ---")
    print(logit_model.summary())
    
    # Parameters and standard errors
    beta0 = logit_model.params['const']
    beta1 = logit_model.params['Age']
    se_beta0 = logit_model.bse['const']
    se_beta1 = logit_model.bse['Age']
    p_beta0 = logit_model.pvalues['const']
    p_beta1 = logit_model.pvalues['Age']
    
    # Odds ratio for age
    or_age = np.exp(beta1)
    or_ci = np.exp(logit_model.conf_int().loc['Age'].values)
    
    # Predicted probability at age 65
    target_age = 65
    target_X = np.array([1, target_age])
    linear_pred = np.dot(target_X, logit_model.params)
    pred_prob = 1.0 / (1.0 + np.exp(-linear_pred))
    
    # Delta method / prediction summary from statsmodels
    pred_res = logit_model.get_prediction(pd.DataFrame({'const': [1], 'Age': [target_age]}))
    pred_summary = pred_res.summary_frame()
    ci_lower = pred_summary['ci_lower'].values[0]
    ci_upper = pred_summary['ci_upper'].values[0]
    
    print("\n--- Model Parameters ---")
    print(f"Intercept (beta0): {beta0:.6f} (SE: {se_beta0:.6f}, p: {p_beta0:.6e})")
    print(f"Slope (beta1, Age): {beta1:.6f} (SE: {se_beta1:.6f}, p: {p_beta1:.6e})")
    print(f"Odds Ratio per year of age: {or_age:.4f} (95% CI: [{or_ci[0]:.4f}, {or_ci[1]:.4f}])")
    
    print("\n--- Prediction at Age 65 ---")
    print(f"Linear predictor (log-odds) at age 65: {linear_pred:.6f}")
    print(f"Predicted probability (decimal): {pred_prob:.6f}")
    print(f"Predicted probability (percentage): {pred_prob * 100:.2f}%")
    print(f"95% Confidence Interval for predicted probability: [{ci_lower:.6f}, {ci_upper:.6f}] ({ci_lower*100:.2f}% - {ci_upper*100:.2f}%)")

if __name__ == '__main__':
    main()
