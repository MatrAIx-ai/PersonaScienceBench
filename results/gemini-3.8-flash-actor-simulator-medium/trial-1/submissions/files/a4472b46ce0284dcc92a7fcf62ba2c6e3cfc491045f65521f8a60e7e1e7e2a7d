import pandas as pd
import numpy as np
from scipy import stats

def main():
    print("Loading datasets...")
    meta_path = "data/GeneMetaInfo_Zenodo.csv"
    counts_path = "data/BatchCorrectedReadCounts_Zenodo.csv"
    samples_path = "data/Sample_annotated_Zenodo.csv"
    
    df_meta = pd.read_csv(meta_path)
    df_counts = pd.read_csv(counts_path)
    df_samples = pd.read_csv(samples_path)
    
    print(f"GeneMetaInfo shape: {df_meta.shape}")
    print(f"BatchCorrectedReadCounts shape: {df_counts.shape}")
    print(f"Sample annotations shape: {df_samples.shape}")
    
    # Check alignment
    gene_id_col = "Geneid"
    counts_id_col = "Unnamed: 0"
    
    # 1. Primary Analysis: gene_biotype == 'protein_coding'
    pc_mask = df_meta["gene_biotype"] == "protein_coding"
    pc_meta = df_meta[pc_mask].copy()
    print(f"\nNumber of protein-coding genes (exact match): {len(pc_meta)}")
    
    # Merge or align counts
    df_counts_indexed = df_counts.set_index(counts_id_col)
    pc_counts = df_counts_indexed.loc[pc_meta[gene_id_col]]
    
    # Calculate gene expression across samples (mean and sum across all 723 samples)
    mean_expr = pc_counts.mean(axis=1)
    sum_expr = pc_counts.sum(axis=1)
    gene_length = pc_meta["Length"].values
    
    r_mean, p_mean = stats.pearsonr(gene_length, mean_expr.values)
    r_sum, p_sum = stats.pearsonr(gene_length, sum_expr.values)
    
    print(f"\n--- Primary Analysis Results ---")
    print(f"Pearson r (Length vs Mean Expression): {r_mean:.8f}")
    print(f"p-value: {p_mean:.4e}")
    print(f"Pearson r (Length vs Sum Expression):  {r_sum:.8f}")
    print(f"p-value: {p_sum:.4e}")
    
    # 2. Sensitivity Checks
    print(f"\n--- Sensitivity Checks ---")
    
    # A. Composite biotypes (contains 'protein_coding')
    pc_contains_mask = df_meta["gene_biotype"].str.contains("protein_coding", na=False)
    pc_contains_meta = df_meta[pc_contains_mask].copy()
    pc_contains_counts = df_counts_indexed.loc[pc_contains_meta[gene_id_col]]
    r_contains, p_contains = stats.pearsonr(pc_contains_meta["Length"].values, pc_contains_counts.mean(axis=1).values)
    print(f"Contains 'protein_coding' (n={len(pc_contains_meta)}): r = {r_contains:.8f}, p = {p_contains:.4e}")
    
    # B. Median expression across samples
    median_expr = pc_counts.median(axis=1)
    r_median, p_median = stats.pearsonr(gene_length, median_expr.values)
    print(f"Median expression: r = {r_median:.8f}, p = {p_median:.4e}")
    
    # C. Log2-transformed expression: log2(mean_expr + 1)
    log_expr = np.log2(mean_expr.values + 1)
    r_log, p_log = stats.pearsonr(gene_length, log_expr)
    print(f"Length vs log2(Mean Expression + 1): r = {r_log:.8f}, p = {p_log:.4e}")
    
    # D. Log2 Length vs log2(Mean Expression + 1)
    log_len = np.log2(gene_length)
    r_loglog, p_loglog = stats.pearsonr(log_len, log_expr)
    print(f"log2(Length) vs log2(Mean Expression + 1): r = {r_loglog:.8f}, p = {p_loglog:.4e}")
    
    # E. Cell-type specific Pearson r
    print("\nCell-type specific correlations (mean expression within cell type):")
    for ct in df_samples["celltype"].unique():
        ct_samples = df_samples[df_samples["celltype"] == ct]["sample"].tolist()
        ct_mean = pc_counts[ct_samples].mean(axis=1)
        r_ct, p_ct = stats.pearsonr(gene_length, ct_mean.values)
        print(f"  {ct:6s} (n={len(ct_samples)}): r = {r_ct:.8f}, p = {p_ct:.4e}")
        
    return r_mean, p_mean

if __name__ == "__main__":
    main()
