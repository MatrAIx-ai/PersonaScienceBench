import pandas as pd

def main():
    # Load dataset
    df = pd.read_csv('data/meta-regression_study_data_heterogeneity_in_replication_projects.csv')
    
    # Filter Experimental Economics studies
    ee_df = df[(df['discipline'] == 'Economics') | (df['project'] == 'ee')]
    
    total_ee = len(ee_df)
    lab_o_count = (ee_df['online.o'] == 0).sum()
    prop_lab_o = lab_o_count / total_ee
    
    lab_r_count = (ee_df['online.r'] == 0).sum()
    prop_lab_r = lab_r_count / total_ee

    print(f"Total Experimental Economics studies: {total_ee}")
    print(f"Original studies conducted in lab setting (online.o == 0): {lab_o_count}/{total_ee} ({prop_lab_o * 100:.1f}%)")
    print(f"Replication studies conducted in lab setting (online.r == 0): {lab_r_count}/{total_ee} ({prop_lab_r * 100:.1f}%)")
    
if __name__ == '__main__':
    main()
