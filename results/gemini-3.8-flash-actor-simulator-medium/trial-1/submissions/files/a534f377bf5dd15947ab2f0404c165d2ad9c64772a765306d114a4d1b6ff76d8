"""
2D Leapfrog Vortex Simulation using Vortex Particle Flow Map (VPFM) Method.
"""

import time
import numpy as np
import scipy.fft

def main():
    N = 135
    dx = 1.0 / N
    inv_dx = float(N)
    total_frames = 107
    dt_frame = 0.1
    CFL = 1.8797
    
    vorticity_record_frames = [0, 26, 52, 78, 104]
    
    k = np.arange(1, N)
    lambda_x = 2.0 * (np.cos(k * np.pi / N) - 1.0) / (dx**2)
    lambda_2d = lambda_x[:, None] + lambda_x[None, :]

    def solve_poisson(omega_interior):
        rhs_hat = scipy.fft.dstn(-omega_interior, type=1)
        psi_hat = rhs_hat / lambda_2d
        psi_int = scipy.fft.idstn(psi_hat, type=1)
        return np.pad(psi_int, ((1, 1), (1, 1)), mode='constant', constant_values=0)

    def reconstruct_velocities(psi):
        ux = (psi[:, 1:] - psi[:, :-1]) * inv_dx
        uy = -(psi[1:, :] - psi[:-1, :]) * inv_dx
        ux[0, :] = 0.0
        ux[-1, :] = 0.0
        uy[:, 0] = 0.0
        uy[:, -1] = 0.0
        
        u_node = np.zeros((N + 1, N + 1), dtype=np.float32)
        v_node = np.zeros((N + 1, N + 1), dtype=np.float32)
        u_node[:, 1:-1] = (psi[:, 2:] - psi[:, :-2]) * (0.5 * inv_dx)
        v_node[1:-1, :] = -(psi[2:, :] - psi[:-2, :]) * (0.5 * inv_dx)
        
        omega_node = np.zeros((N + 1, N + 1), dtype=np.float32)
        omega_node[1:N, 1:N] = (uy[1:N, 1:N] - uy[0:N-1, 1:N]) * inv_dx - (ux[1:N, 1:N] - ux[1:N, 0:N-1]) * inv_dx
        return ux.astype(np.float32), uy.astype(np.float32), u_node, v_node, omega_node

    sub = (np.arange(4) + 0.5) / 4.0
    cx = np.arange(N)
    sub_x, sub_y = np.meshgrid(sub, sub, indexing='ij')
    cell_x, cell_y = np.meshgrid(cx, cx, indexing='ij')
    px = ((cell_x[:, :, None, None] + sub_x[None, None, :, :]) * dx).ravel().astype(np.float32)
    py = ((cell_y[:, :, None, None] + sub_y[None, None, :, :]) * dx).ravel().astype(np.float32)
    init_particles = np.stack([px, py], axis=-1)
    num_particles = len(px)

    grid_i, grid_j = np.meshgrid(np.arange(1, N), np.arange(1, N), indexing='ij')
    grid_nodes = np.stack([(grid_i * dx).ravel().astype(np.float32), (grid_j * dx).ravel().astype(np.float32)], axis=-1)

    def eval_spline(pos, field):
        sx = pos[:, 0] * inv_dx
        sy = pos[:, 1] * inv_dx
        base_i = np.clip(np.round(sx).astype(np.int32), 1, N - 1)
        base_j = np.clip(np.round(sy).astype(np.int32), 1, N - 1)
        fx = sx - base_i
        fy = sy - base_j
        
        wx = np.stack([0.5 * (0.5 - fx)**2, 0.75 - fx**2, 0.5 * (0.5 + fx)**2], axis=1)
        wy = np.stack([0.5 * (0.5 - fy)**2, 0.75 - fy**2, 0.5 * (0.5 + fy)**2], axis=1)
        dwx = np.stack([(fx - 0.5) * inv_dx, -2.0 * fx * inv_dx, (fx + 0.5) * inv_dx], axis=1)
        dwy = np.stack([(fy - 0.5) * inv_dx, -2.0 * fy * inv_dx, (fy + 0.5) * inv_dx], axis=1)
        
        val = np.zeros(len(pos), dtype=np.float32)
        grad_x = np.zeros(len(pos), dtype=np.float32)
        grad_y = np.zeros(len(pos), dtype=np.float32)
        
        f_flat = field.ravel()
        idx_y_all = [np.clip(base_j + (b - 1), 0, N) for b in range(3)]
        for a in range(3):
            idx_x = np.clip(base_i + (a - 1), 0, N)
            row_offset = idx_x * (N + 1)
            w_a = wx[:, a]
            dw_a = dwx[:, a]
            for b in range(3):
                flat_idx = row_offset + idx_y_all[b]
                w_b = wy[:, b]
                dw_b = dwy[:, b]
                W = w_a * w_b
                pts = f_flat[flat_idx]
                val += W * pts
                grad_x += (dw_a * w_b) * pts
                grad_y += (w_a * dw_b) * pts
        return val, grad_x, grad_y

    def eval_vel(pos, u_node, v_node):
        sx = pos[:, 0] * inv_dx
        sy = pos[:, 1] * inv_dx
        base_i = np.clip(np.round(sx).astype(np.int32), 1, N - 1)
        base_j = np.clip(np.round(sy).astype(np.int32), 1, N - 1)
        fx = sx - base_i
        fy = sy - base_j
        
        wx = np.stack([0.5 * (0.5 - fx)**2, 0.75 - fx**2, 0.5 * (0.5 + fx)**2], axis=1)
        wy = np.stack([0.5 * (0.5 - fy)**2, 0.75 - fy**2, 0.5 * (0.5 + fy)**2], axis=1)
        dwx = np.stack([(fx - 0.5) * inv_dx, -2.0 * fx * inv_dx, (fx + 0.5) * inv_dx], axis=1)
        dwy = np.stack([(fy - 0.5) * inv_dx, -2.0 * fy * inv_dx, (fy + 0.5) * inv_dx], axis=1)
        
        u_val = np.zeros(len(pos), dtype=np.float32)
        v_val = np.zeros(len(pos), dtype=np.float32)
        dudx = np.zeros(len(pos), dtype=np.float32)
        dudy = np.zeros(len(pos), dtype=np.float32)
        dvdx = np.zeros(len(pos), dtype=np.float32)
        dvdy = np.zeros(len(pos), dtype=np.float32)
        
        u_flat = u_node.ravel()
        v_flat = v_node.ravel()
        idx_y_all = [np.clip(base_j + (b - 1), 0, N) for b in range(3)]
        for a in range(3):
            idx_x = np.clip(base_i + (a - 1), 0, N)
            row_offset = idx_x * (N + 1)
            w_a = wx[:, a]
            dw_a = dwx[:, a]
            for b in range(3):
                flat_idx = row_offset + idx_y_all[b]
                w_b = wy[:, b]
                dw_b = dwy[:, b]
                W = w_a * w_b
                dWx = dw_a * w_b
                dWy = w_a * dw_b
                u_pts = u_flat[flat_idx]
                v_pts = v_flat[flat_idx]
                u_val += W * u_pts
                v_val += W * v_pts
                dudx += dWx * u_pts
                dudy += dWy * u_pts
                dvdx += dWx * v_pts
                dvdy += dWy * v_pts
        return u_val, v_val, dudx, dudy, dvdx, dvdy

    def compute_cell_vorticity(ux, uy):
        u_cell = 0.5 * (ux[:-1, :] + ux[1:, :])
        v_cell = 0.5 * (uy[:, :-1] + uy[:, 1:])
        i_idx = np.arange(N)
        j_idx = np.arange(N)
        ip1 = np.clip(i_idx + 1, 0, N - 1)
        im1 = np.clip(i_idx - 1, 0, N - 1)
        jp1 = np.clip(j_idx + 1, 0, N - 1)
        jm1 = np.clip(j_idx - 1, 0, N - 1)
        dv_dx = (v_cell[ip1, :] - v_cell[im1, :]) / (2.0 * dx)
        du_dy = (u_cell[:, jp1] - u_cell[:, jm1]) / (2.0 * dx)
        return (dv_dx - du_dy).astype(np.float32)

    def compute_kinetic_energy(ux, uy):
        u_cell = 0.5 * (ux[:-1, :] + ux[1:, :])
        v_cell = 0.5 * (uy[:, :-1] + uy[:, 1:])
        return float(0.5 * (dx**2) * np.sum(u_cell**2 + v_cell**2))

    ux_raw = np.load('data/initial_u_x.npy').astype(np.float32)
    uy_raw = np.load('data/initial_u_y.npy').astype(np.float32)

    kinetic_energy = np.zeros(total_frames + 1, dtype=np.float32)
    vorticity_frames = np.zeros((len(vorticity_record_frames), N, N), dtype=np.float32)

    kinetic_energy[0] = compute_kinetic_energy(ux_raw, uy_raw)
    vorticity_frames[0] = compute_cell_vorticity(ux_raw, uy_raw)
    print(f"Frame 0: KE = {kinetic_energy[0]:.7f}")

    curlu = (uy_raw[1:N, 1:N] - uy_raw[0:N-1, 1:N]) * inv_dx - (ux_raw[1:N, 1:N] - ux_raw[1:N, 0:N-1]) * inv_dx
    psi = solve_poisson(curlu)
    ux, uy, u_node, v_node, omega_node = reconstruct_velocities(psi)

    start_time = time.time()
    vort_record_idx = 1

    for frame in range(1, total_frames + 1):
        t_frame_elapsed = 0.0
        substeps = 0
        
        while t_frame_elapsed < dt_frame - 1e-9:
            remaining = dt_frame - t_frame_elapsed
            max_vel = max(float(np.max(np.abs(ux))), float(np.max(np.abs(uy))))
            dt_cfl = CFL * dx / max(max_vel, 1e-6)
            dt = min(dt_cfl, remaining)
            if remaining - dt < 1e-4 * dt:
                dt = remaining
            
            # Midpoint velocity via semi-Lagrangian RK4
            h = 0.5 * dt
            u1, v1, _, _, _, _ = eval_vel(grid_nodes, u_node, v_node)
            pos1 = np.clip(grid_nodes - 0.5 * h * np.stack([u1, v1], axis=-1), 0.5 * dx, 1.0 - 0.5 * dx)
            u2, v2, _, _, _, _ = eval_vel(pos1, u_node, v_node)
            pos2 = np.clip(grid_nodes - 0.5 * h * np.stack([u2, v2], axis=-1), 0.5 * dx, 1.0 - 0.5 * dx)
            u3, v3, _, _, _, _ = eval_vel(pos2, u_node, v_node)
            pos3 = np.clip(grid_nodes - h * np.stack([u3, v3], axis=-1), 0.5 * dx, 1.0 - 0.5 * dx)
            u4, v4, _, _, _, _ = eval_vel(pos3, u_node, v_node)
            pos_back = np.clip(grid_nodes - (h / 6.0) * np.stack([u1 + 2*u2 + 2*u3 + u4, v1 + 2*v2 + 2*v3 + v4], axis=-1), 0.5 * dx, 1.0 - 0.5 * dx)
            
            omega_mid_val, _, _ = eval_spline(pos_back, omega_node)
            psi_mid = solve_poisson(omega_mid_val.reshape((N - 1, N - 1)))
            _, _, u_node_mid, v_node_mid, _ = reconstruct_velocities(psi_mid)
            
            # Particles G2P and T reinitialization
            particles_p = init_particles.copy()
            wp, init_Cc_x, init_Cc_y = eval_spline(particles_p, omega_node)
            
            T00 = np.ones(num_particles, dtype=np.float32)
            T01 = np.zeros(num_particles, dtype=np.float32)
            T10 = np.zeros(num_particles, dtype=np.float32)
            T11 = np.ones(num_particles, dtype=np.float32)
            
            # Forward RK4 advection and flow map evolution
            u_p1, v_p1, dudx1, dudy1, dvdx1, dvdy1 = eval_vel(particles_p, u_node_mid, v_node_mid)
            dT00_1 = -(dudx1 * T00 + dvdx1 * T10)
            dT01_1 = -(dudx1 * T01 + dvdx1 * T11)
            dT10_1 = -(dudy1 * T00 + dvdy1 * T10)
            dT11_1 = -(dudy1 * T01 + dvdy1 * T11)
            
            pos_p2 = np.clip(particles_p + 0.5 * dt * np.stack([u_p1, v_p1], axis=-1), 0.5 * dx, 1.0 - 0.5 * dx)
            T00_2 = T00 + 0.5 * dt * dT00_1
            T01_2 = T01 + 0.5 * dt * dT01_1
            T10_2 = T10 + 0.5 * dt * dT10_1
            T11_2 = T11 + 0.5 * dt * dT11_1
            u_p2, v_p2, dudx2, dudy2, dvdx2, dvdy2 = eval_vel(pos_p2, u_node_mid, v_node_mid)
            dT00_2 = -(dudx2 * T00_2 + dvdx2 * T10_2)
            dT01_2 = -(dudx2 * T01_2 + dvdx2 * T11_2)
            dT10_2 = -(dudy2 * T00_2 + dvdy2 * T10_2)
            dT11_2 = -(dudy2 * T01_2 + dvdy2 * T11_2)
            
            pos_p3 = np.clip(particles_p + 0.5 * dt * np.stack([u_p2, v_p2], axis=-1), 0.5 * dx, 1.0 - 0.5 * dx)
            T00_3 = T00 + 0.5 * dt * dT00_2
            T01_3 = T01 + 0.5 * dt * dT01_2
            T10_3 = T10 + 0.5 * dt * dT10_2
            T11_3 = T11 + 0.5 * dt * dT11_2
            u_p3, v_p3, dudx3, dudy3, dvdx3, dvdy3 = eval_vel(pos_p3, u_node_mid, v_node_mid)
            dT00_3 = -(dudx3 * T00_3 + dvdx3 * T10_3)
            dT01_3 = -(dudx3 * T01_3 + dvdy3 * T11_3)
            dT10_3 = -(dudy3 * T00_3 + dvdy3 * T10_3)
            dT11_3 = -(dudy3 * T01_3 + dvdy3 * T11_3)
            
            pos_p4 = np.clip(particles_p + dt * np.stack([u_p3, v_p3], axis=-1), 0.5 * dx, 1.0 - 0.5 * dx)
            T00_4 = T00 + dt * dT00_3
            T01_4 = T01 + dt * dT01_3
            T10_4 = T10 + dt * dT10_3
            T11_4 = T11 + dt * dT11_3
            u_p4, v_p4, dudx4, dudy4, dvdx4, dvdy4 = eval_vel(pos_p4, u_node_mid, v_node_mid)
            dT00_4 = -(dudx4 * T00_4 + dvdx4 * T10_4)
            dT01_4 = -(dudx4 * T01_4 + dvdy4 * T11_4)
            dT10_4 = -(dudy4 * T00_4 + dvdy4 * T10_4)
            dT11_4 = -(dudy4 * T01_4 + dvdy4 * T11_4)
            
            particles_p = np.clip(particles_p + (dt / 6.0) * np.stack([u_p1 + 2*u_p2 + 2*u_p3 + u_p4, v_p1 + 2*v_p2 + 2*v_p3 + v_p4], axis=-1), 0.5 * dx, 1.0 - 0.5 * dx)
            T00_new = T00 + (dt / 6.0) * (dT00_1 + 2*dT00_2 + 2*dT00_3 + dT00_4)
            T01_new = T01 + (dt / 6.0) * (dT01_1 + 2*dT01_2 + 2*dT01_3 + dT01_4)
            T10_new = T10 + (dt / 6.0) * (dT10_1 + 2*dT10_2 + 2*dT10_3 + dT10_4)
            T11_new = T11 + (dt / 6.0) * (dT11_1 + 2*dT11_2 + 2*dT11_3 + dT11_4)
            
            # APIC P2G transfer
            Cc_x = T00_new * init_Cc_x + T10_new * init_Cc_y
            Cc_y = T01_new * init_Cc_x + T11_new * init_Cc_y
            
            sx = particles_p[:, 0] * inv_dx
            sy = particles_p[:, 1] * inv_dx
            base_i = np.clip(np.round(sx).astype(np.int32), 1, N - 1)
            base_j = np.clip(np.round(sy).astype(np.int32), 1, N - 1)
            fx = sx - base_i
            fy = sy - base_j
            
            wx = np.stack([0.5 * (0.5 - fx)**2, 0.75 - fx**2, 0.5 * (0.5 + fx)**2], axis=1)
            wy = np.stack([0.5 * (0.5 - fy)**2, 0.75 - fy**2, 0.5 * (0.5 + fy)**2], axis=1)
            
            grid_vort = np.zeros((N + 1, N + 1), dtype=np.float32)
            grid_wt = np.zeros((N + 1, N + 1), dtype=np.float32)
            gv_flat = grid_vort.ravel()
            gw_flat = grid_wt.ravel()
            
            idx_y_all = [np.clip(base_j + (b - 1), 0, N) for b in range(3)]
            for a in range(3):
                idx_x = np.clip(base_i + (a - 1), 0, N)
                row_offset = idx_x * (N + 1)
                w_a = wx[:, a]
                dx_node = (idx_x * dx) - particles_p[:, 0]
                for b in range(3):
                    idx_y = idx_y_all[b]
                    w_b = wy[:, b]
                    dy_node = (idx_y * dx) - particles_p[:, 1]
                    W = w_a * w_b
                    v_contrib = (wp + Cc_x * dx_node + Cc_y * dy_node) * W
                    flat_idx = row_offset + idx_y
                    np.add.at(gv_flat, flat_idx, v_contrib)
                    np.add.at(gw_flat, flat_idx, W)
            
            valid_wt = gw_flat > 1e-10
            gv_flat[valid_wt] /= gw_flat[valid_wt]
            gv_flat[~valid_wt] = 0.0
            grid_vort[0, :] = 0.0
            grid_vort[-1, :] = 0.0
            grid_vort[:, 0] = 0.0
            grid_vort[:, -1] = 0.0
            
            # Poisson solve & velocity reconstruction
            psi_new = solve_poisson(grid_vort[1:N, 1:N])
            ux, uy, u_node, v_node, omega_node = reconstruct_velocities(psi_new)
            
            t_frame_elapsed += dt
            substeps += 1
        
        ke = compute_kinetic_energy(ux, uy)
        kinetic_energy[frame] = ke
        
        if frame in vorticity_record_frames:
            vorticity_frames[vort_record_idx] = compute_cell_vorticity(ux, uy)
            vort_record_idx += 1
        
        if frame % 10 == 0 or frame == total_frames:
            elapsed = time.time() - start_time
            print(f"Frame {frame}/{total_frames} (substeps: {substeps}): KE = {ke:.7f}, max_vel = {max_vel:.4f}, time = {elapsed:.1f}s")

    np.save('vorticity_frames.npy', vorticity_frames)
    np.save('kinetic_energy.npy', kinetic_energy)
    print("Simulation completed successfully!")
    print(f"Saved vorticity_frames.npy with shape {vorticity_frames.shape}, dtype {vorticity_frames.dtype}")
    print(f"Saved kinetic_energy.npy with shape {kinetic_energy.shape}, dtype {kinetic_energy.dtype}")

if __name__ == '__main__':
    main()
