import pandas as pd
import numpy as np

# Load dataset
data_path = 'data/requirements_engineering_for_ML-enabled_systems.csv'
df = pd.read_csv(data_path)

# Columns of interest: Q8_ML_Addressing_*
q8_cols = [c for c in df.columns if c.startswith('Q8_ML_Addressing_') and not c.endswith('_Free')]

# Filter out non-responses (-77)
# Exactly 82 rows have -77 across all Q8 fields
valid_mask = df['Q8_ML_Addressing_Project_Lead'] != '-77'
valid_df = df[valid_mask].copy()

# Map 'quoted' to 1 and 'not quoted' to 0
role_data = {}
for col in q8_cols:
    role_name = col.replace('Q8_ML_Addressing_', '')
    role_data[role_name] = (valid_df[col] == 'quoted').astype(int).values

# Compute proportions
print("Summary of Roles addressing ML Requirements (N = 194):")
proportions = {}
for role, vals in role_data.items():
    p = np.mean(vals)
    cnt = np.sum(vals)
    proportions[role] = p
    print(f"{role:22s}: {cnt:3d}/{len(vals)} = {p*100:6.2f}%")

# Sort roles by proportion
sorted_roles = sorted(proportions.items(), key=lambda x: x[1], reverse=True)
print("\nRanking of roles by proportion:")
for rank, (role, p) in enumerate(sorted_roles, 1):
    print(f"{rank}. {role:22s}: {p*100:.2f}%")

# Bootstrap analysis
np.random.seed(42)
B = 10000
boot_results = {}
for role, vals in role_data.items():
    boot_samples = np.random.choice(vals, size=(B, len(vals)), replace=True)
    boot_props = np.mean(boot_samples, axis=1) * 100
    mean_p = np.mean(boot_props)
    ci_lower = np.percentile(boot_props, 2.5)
    ci_upper = np.percentile(boot_props, 97.5)
    boot_results[role] = {
        'mean': mean_p,
        'ci_95': (ci_lower, ci_upper)
    }

print("\nBootstrap 95% Confidence Intervals (B = 10,000):")
for role, res in sorted(boot_results.items(), key=lambda x: x[1]['mean'], reverse=True):
    print(f"{role:22s}: Mean = {res['mean']:.3f}%, 95% CI = [{res['ci_95'][0]:.3f}%, {res['ci_95'][1]:.3f}%]")

# Completed surveys subset (Status starts with Completed, N = 188)
completed_df = df[df['Status'].str.startswith('Completed')].copy()
print(f"\nSubset of Completed Surveys (N = {len(completed_df)}):")
for col in q8_cols:
    role_name = col.replace('Q8_ML_Addressing_', '')
    vals = (completed_df[col] == 'quoted').astype(int).values
    p = np.mean(vals) * 100
    print(f"{role_name:22s}: {np.sum(vals):3d}/{len(vals)} = {p:.3f}%")
