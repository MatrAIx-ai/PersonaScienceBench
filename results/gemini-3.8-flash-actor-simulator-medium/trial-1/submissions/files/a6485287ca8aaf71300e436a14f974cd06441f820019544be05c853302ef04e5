import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf

# Load the dataset
file_path = 'data/data.xlsx'
df = pd.read_excel(file_path)

# Filter to the 80 valid patient records (Sequence number 1 to 80)
df = df.iloc[:80].copy()

# Ensure types
df['Age'] = pd.to_numeric(df['Age'])
df['BMI'] = pd.to_numeric(df['BMI'])

# Define Remission: PR = 1 (remission), SD/PD = 0 (non-remission)
df['Remission'] = (df['Efficacy'] == 'PR').astype(int)

print("Data Summary:")
print(f"Total valid samples: {len(df)}")
print(f"Remission (PR=1): {df['Remission'].sum()}")
print(f"Non-remission (SD/PD=0): {(df['Remission'] == 0).sum()}")
print(df.groupby('Remission')[['Age', 'BMI']].mean())
print(pd.crosstab(df['Remission'], df['Gender']))

# Fit logistic regression using statsmodels formula
# Remission ~ Age + BMI + C(Gender)
model = smf.logit("Remission ~ Age + BMI + C(Gender, Treatment(reference='Female'))", data=df).fit()
print("\n--- Model Summary (Female as ref) ---")
print(model.summary())

# Also verify with Male as ref to ensure Age coefficient is identical
model_male_ref = smf.logit("Remission ~ Age + BMI + C(Gender, Treatment(reference='Male'))", data=df).fit()
print("\n--- Model Summary (Male as ref) ---")
print(model_male_ref.summary())

# Extract age coefficient metrics
age_coef = model.params['Age']
age_se = model.bse['Age']
age_pval = model.pvalues['Age']
age_ci_lower, age_ci_upper = model.conf_int().loc['Age']
age_or = np.exp(age_coef)
age_or_ci_lower = np.exp(age_ci_lower)
age_or_ci_upper = np.exp(age_ci_upper)

print("\n--- Key Results for Age ---")
print(f"Log-odds change per year (Coefficient): {age_coef:.6f}")
print(f"Standard Error (SE): {age_se:.6f}")
print(f"p-value: {age_pval:.6e}")
print(f"95% CI for log-odds: [{age_ci_lower:.6f}, {age_ci_upper:.6f}]")
print(f"Odds Ratio (OR): {age_or:.6f}")
print(f"95% CI for OR: [{age_or_ci_lower:.6f}, {age_or_ci_upper:.6f}]")
