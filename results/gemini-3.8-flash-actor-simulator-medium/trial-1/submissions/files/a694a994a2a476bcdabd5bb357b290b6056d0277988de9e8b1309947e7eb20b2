class BitmapPlotter:
    def __init__(self, width: int, height: int, bg=(255, 255, 255)):
        self.w = width
        self.h = height
        self.buf = bytearray(bg * (width * height))

    def set_pixel(self, x: int, y: int, color):
        if 0 <= x < self.w and 0 <= y < self.h:
            idx = (y * self.w + x) * 3
            self.buf[idx:idx+3] = bytes(color)

    def draw_line(self, x0: int, y0: int, x1: int, y1: int, color, width: int = 1):
        dx = abs(x1 - x0)
        dy = abs(y1 - y0)
        sx = 1 if x0 < x1 else -1
        sy = 1 if y0 < y1 else -1
        err = dx - dy
        while True:
            for wx in range(-width // 2, width // 2 + 1):
                for wy in range(-width // 2, width // 2 + 1):
                    self.set_pixel(x0 + wx, y0 + wy, color)
            if x0 == x1 and y0 == y1:
                break
            e2 = 2 * err
            if e2 > -dy:
                err -= dy
                x0 += sx
            if e2 < dx:
                err += dx
                y0 += sy

    def draw_text(self, text: str, x: int, y: int, color=(0, 0, 0), scale: int = 2):
        cur_x = x
        for ch in text:
            glyph = FONT_3X5.get(ch, FONT_3X5.get(' '))
            for row_idx, row in enumerate(glyph):
                for col_idx, pixel in enumerate(row):
                    if pixel == '1':
                        for sx in range(scale):
                            for sy in range(scale):
                                self.set_pixel(cur_x + col_idx * scale + sx,
                                               y + row_idx * scale + sy,
                                               color)
            cur_x += (len(glyph[0]) + 1) * scale

    def to_png_bytes(self) -> bytes:
        header = b'\x89PNG\r\n\x1a\n'
        def chunk(tag, data):
            return (struct.pack('>I', len(data)) + tag + data +
                    struct.pack('>I', zlib.crc32(tag + data) & 0xffffffff))
        ihdr = chunk(b'IHDR', struct.pack('>IIBBBBB', self.w, self.h, 8, 2, 0, 0, 0))
        raw_lines = []
        for y in range(self.h):
            raw_lines.append(b'\x00' + self.buf[y * self.w * 3:(y + 1) * self.w * 3])
        idat = chunk(b'IDAT', zlib.compress(b''.join(raw_lines), 9))
        iend = chunk(b'IEND', b'')
        return header + ihdr + idat + iend

def render_diurnal_plot(flux_df: pd.DataFrame, output_path: str):
    width, height = 1100, 800
    plotter = BitmapPlotter(width, height, bg=(255, 255, 255))
    left, right = 90, 1040
    plot_w = right - left
    p1_top, p1_bot = 60, 380
    p1_h = p1_bot - p1_top
    p2_top, p2_bot = 440, 740
    p2_h = p2_bot - p2_top

    plotter.draw_text('DIURNAL LEAF PHYSIOLOGICAL RESPONSE (FARQUHAR-COLLATZ / BALL-BERRY)',
                      left + 30, 20, color=(20, 20, 20), scale=2)

    times = flux_df['time_hr'].values

    def draw_panel(top, bot, y_min, y_max, y_label, y_ticks):
        plotter.draw_line(left, top, right, top, (200, 200, 200), width=1)
        plotter.draw_line(left, bot, right, bot, (80, 80, 80), width=1)
        plotter.draw_line(left, top, left, bot, (80, 80, 80), width=1)
        plotter.draw_line(right, top, right, bot, (200, 200, 200), width=1)

        for t in range(0, 121, 24):
            x = int(left + (t / 120.0) * plot_w)
            plotter.draw_line(x, top, x, bot, (230, 230, 230), width=1)
            plotter.draw_line(x, bot, x, bot + 5, (80, 80, 80), width=1)
            if bot == p2_bot:
                plotter.draw_text(f'{t}h', x - 10, bot + 10, (60, 60, 60), scale=2)

        for val, label in y_ticks:
            y = int(bot - ((val - y_min) / (y_max - y_min)) * (bot - top))
            if top <= y <= bot:
                plotter.draw_line(left, y, right, y, (230, 230, 230), width=1)
                plotter.draw_line(left - 5, y, left, y, (80, 80, 80), width=1)
                plotter.draw_text(label, left - 45, y - 5, (60, 60, 60), scale=2)

        plotter.draw_text(y_label, left + 10, top + 10, (20, 20, 20), scale=2)

    a_min, a_max = -5.0, 45.0
    a_ticks = [(-5.0, '-5'), (0.0, '0'), (10.0, '10'), (20.0, '20'), (30.0, '30'), (40.0, '40')]
    draw_panel(p1_top, p1_bot, a_min, a_max, 'A (umol CO2 m^-2 s^-1)', a_ticks)

    plotter.draw_line(right - 220, p1_top + 15, right - 180, p1_top + 15, (220, 50, 32), width=3)
    plotter.draw_text('Sunlit A', right - 170, p1_top + 10, (220, 50, 32), scale=2)
    plotter.draw_line(right - 220, p1_top + 35, right - 180, p1_top + 35, (0, 114, 178), width=3)
    plotter.draw_text('Shaded A', right - 170, p1_top + 30, (0, 114, 178), scale=2)

    a_sun = flux_df['A_sun'].values
    a_shade = flux_df['A_shade'].values
    for i in range(len(times) - 1):
        x0 = int(left + (times[i] / 120.0) * plot_w)
        x1 = int(left + (times[i + 1] / 120.0) * plot_w)
        y0_sun = int(p1_bot - ((a_sun[i] - a_min) / (a_max - a_min)) * p1_h)
        y1_sun = int(p1_bot - ((a_sun[i + 1] - a_min) / (a_max - a_min)) * p1_h)
        plotter.draw_line(x0, y0_sun, x1, y1_sun, (220, 50, 32), width=2)

        y0_shd = int(p1_bot - ((a_shade[i] - a_min) / (a_max - a_min)) * p1_h)
        y1_shd = int(p1_bot - ((a_shade[i + 1] - a_min) / (a_max - a_min)) * p1_h)
        plotter.draw_line(x0, y0_shd, x1, y1_shd, (0, 114, 178), width=2)

    rs_min, rs_max = 100.0, 1100.0
    rs_ticks = [(200.0, '200'), (400.0, '400'), (600.0, '600'), (800.0, '800'), (1000.0, '1000')]
    draw_panel(p2_top, p2_bot, rs_min, rs_max, 'rs (s m^-1)', rs_ticks)
    plotter.draw_text('Time (hours)', left + plot_w // 2 - 50, p2_bot + 30, (20, 20, 20), scale=2)

    plotter.draw_line(right - 220, p2_top + 15, right - 180, p2_top + 15, (230, 140, 20), width=3)
    plotter.draw_text('Sunlit rs', right - 170, p2_top + 10, (230, 140, 20), scale=2)
    plotter.draw_line(right - 220, p2_top + 35, right - 180, p2_top + 35, (0, 158, 115), width=3)
    plotter.draw_text('Shaded rs', right - 170, p2_top + 30, (0, 158, 115), scale=2)

    rs_sun = flux_df['rs_sun'].values
    rs_shade = flux_df['rs_shade'].values
    for i in range(len(times) - 1):
        x0 = int(left + (times[i] / 120.0) * plot_w)
        x1 = int(left + (times[i + 1] / 120.0) * plot_w)
        y0_sun = int(p2_bot - ((rs_sun[i] - rs_min) / (rs_max - rs_min)) * p2_h)
        y1_sun = int(p2_bot - ((rs_sun[i + 1] - rs_min) / (rs_max - rs_min)) * p2_h)
        plotter.draw_line(x0, y0_sun, x1, y1_sun, (230, 140, 20), width=2)

        y0_shd = int(p2_bot - ((rs_shade[i] - rs_min) / (rs_max - rs_min)) * p2_h)
        y1_shd = int(p2_bot - ((rs_shade[i + 1] - rs_min) / (rs_max - rs_min)) * p2_h)
        plotter.draw_line(x0, y0_shd, x1, y1_shd, (0, 158, 115), width=2)

    png_bytes = plotter.to_png_bytes()
    with open(output_path, 'wb') as f:
        f.write(png_bytes)

def main():
    os.makedirs('results', exist_ok=True)
    with open('data/leaf_params.json') as f:
        leaf_params = json.load(f)
    with open('data/test_cases.json') as f:
        test_cases = json.load(f)
    forcing_df = pd.read_csv('data/forcing.csv')

    flux_rows = []
    for _, row in forcing_df.iterrows():
        sun_res = solve_point(row, leaf_params, float(row['par_sun_wm2']))
        shd_res = solve_point(row, leaf_params, float(row['par_shade_wm2']))
        flux_rows.append({
            'time_hr': float(row['time_hr']),
            'A_sun': sun_res['A'],
            'A_shade': shd_res['A'],
            'rs_sun': sun_res['rs'],
            'rs_shade': shd_res['rs'],
            'ci_sun': sun_res['ci'],
            'ci_shade': shd_res['ci'],
            'gs_sun': sun_res['gs'],
            'gs_shade': shd_res['gs']
        })

    flux_df = pd.DataFrame(flux_rows)
    flux_csv_path = os.path.join('results', 'leaf_fluxes.csv')
    flux_df.to_csv(flux_csv_path, index=False)
    print(f'Wrote {len(flux_df)} rows to {flux_csv_path}')

    case_rows = []
    for c in test_cases:
        row = forcing_df.iloc[c['forcing_index']]
        ci_init = float(c['ci_init_pa'])
        res = solve_point(row, leaf_params, float(row['par_sun_wm2']), ci_init=ci_init)
        case_rows.append({
            'case_id': c['case_id'],
            'ci_init_pa': ci_init,
            'ci_final_pa': res['ci'],
            'A_final': res['A'],
            'rs_final': res['rs'],
            'n_iterations': res['n_iterations']
        })

    conv_df = pd.DataFrame(case_rows)
    conv_csv_path = os.path.join('results', 'case_convergence.csv')
    conv_df.to_csv(conv_csv_path, index=False)
    print(f'Wrote {len(conv_df)} test cases to {conv_csv_path}')

    diurnal_png_path = os.path.join('results', 'diurnal.png')
    render_diurnal_plot(flux_df, diurnal_png_path)
    print(f'Generated diurnal plot at {diurnal_png_path}')

if __name__ == '__main__':
    main()
