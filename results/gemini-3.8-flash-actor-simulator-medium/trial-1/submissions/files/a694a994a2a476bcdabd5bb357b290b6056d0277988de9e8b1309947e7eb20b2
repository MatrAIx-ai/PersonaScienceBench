import json, math, os, struct, zlib
import numpy as np, pandas as pd

R_GAS = 8.31446

def calc_esat(Tc: float) -> float:
    return 610.78 * math.exp(17.27 * Tc / (Tc + 237.3))

def calc_vcmax_t(vcmax25: float, Tc: float, R: float = R_GAS) -> float:
    T_kelvin = Tc + 273.16
    q10_factor = 2.4 ** ((Tc - 25.0) / 10.0)
    inhibition = 1.0 + math.exp((-2.2e5 + 710.0 * T_kelvin) / (R * T_kelvin))
    return vcmax25 * q10_factor / inhibition

def solve_point(row, leaf_params: dict, par_val: float, ci_init: float = None, tol: float = 1e-6, max_iter: int = 100):
    t_air_k = float(row['t_air_K'])
    Tc = t_air_k - 273.16
    patm = float(row['p_atm_Pa'])
    ca = float(row['co2_pa'])
    rb = float(row['rb_sm'])
    btran = float(row['btran'])
    vpd = float(row['vpd_Pa'])
    o2 = float(row['o2_pa'])

    vcmax25 = float(leaf_params['vcmax25'])
    bb_slope = float(leaf_params['bb_slope'])
    bb_intercept = float(leaf_params['bb_intercept'])
    alpha_q = float(leaf_params['alpha_q'])
    n_factor = float(leaf_params.get('n_factor', 1.0))
    pathway = leaf_params.get('pathway', 'C4').upper()

    vcmax_t = calc_vcmax_t(vcmax25, Tc)
    vcmax = vcmax_t * n_factor * btran
    Rd = 0.015 * vcmax
    cf = patm / (R_GAS * t_air_k)

    esat = calc_esat(Tc)
    hs = max(0.25, min(1.0, 1.0 - vpd / esat))

    if par_val <= 0.0:
        A = -Rd
        gs = bb_intercept
        rs = cf / gs
        A_mol = A * 1e-6
        cs = ca - 1.37 * rb * (A_mol / cf) * patm
        ci = cs - 1.65 * rs * (A_mol / cf) * patm
        return {'A': A, 'gs': gs, 'rs': rs, 'ci': ci, 'n_iterations': 0}

    apar = 4.6 * par_val
    ci = 0.7 * ca if ci_init is None else ci_init

    if pathway == 'C3':
        kc = 30.0 * (2.1 ** ((Tc - 25.0) / 10.0))
        ko = 30000.0 * (1.2 ** ((Tc - 25.0) / 10.0))
        gamma_star = 0.5 * (kc / ko) * o2 * 0.21
        J = alpha_q * apar
        We = 0.5 * vcmax

    for it in range(1, max_iter + 1):
        if pathway == 'C4':
            Wc = vcmax
            Wj = alpha_q * apar
            We = 4000.0 * vcmax * ci / patm
            A = min(Wc, Wj, We) - Rd
        else:
            denom_c = ci + kc * (1.0 + o2 / ko)
            Wc = vcmax * (ci - gamma_star) / denom_c if denom_c > 0 else 0.0
            denom_j = 4.0 * ci + 8.0 * gamma_star
            Wj = J * (ci - gamma_star) / denom_j if denom_j > 0 else 0.0
            A = min(Wc, Wj, We) - Rd

        A_mol = A * 1e-6
        cs = ca - 1.37 * rb * (A_mol / cf) * patm
        gs = bb_slope * A_mol * (hs / cs) * patm + bb_intercept
        gs = max(bb_intercept, gs)
        rs = cf / gs
        ci_new = cs - 1.65 * rs * (A_mol / cf) * patm

        if abs(ci_new - ci) < tol:
            return {'A': A, 'gs': gs, 'rs': rs, 'ci': ci_new, 'n_iterations': it}
        ci = ci_new

    return {'A': A, 'gs': gs, 'rs': rs, 'ci': ci, 'n_iterations': max_iter}

