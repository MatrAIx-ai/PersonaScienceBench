#!/usr/bin/env python3
"""
Analysis script to calculate the average number of CHIP variants per sample
after filtering out intronic, intergenic, and UTR variants.
"""

import os
import glob
from collections import Counter
import openpyxl
import pandas as pd

def main():
    data_dir = 'data/CHIP_DP10_GQ20_PASS'
    files = sorted(glob.glob(os.path.join(data_dir, '*.xlsx')))
    num_samples = len(files)
    print(f"Total sample files processed: {num_samples}")

    records = []
    per_sample_stats = []

    for f in files:
        fname = os.path.basename(f)
        sample_id = fname.replace('.xlsx', '').split('CHIP_')[-1]
        
        wb = openpyxl.load_workbook(f, data_only=True)
        ws = wb.active
        rows = list(ws.iter_rows(values_only=True))
        h0 = rows[0]
        h1 = rows[1]
        
        zyg_idx = h1.index('Zygosity')
        so_idx = h1.index('Sequence Ontology (Combined)')
        eff_idx = h1.index('Effect (Combined)')
        gene_idx = h1.index('Gene Names')
        vaf_idx = h1.index('Variant Allele Freq')
        
        sample_variants = 0
        sample_filtered_primary = 0
        sample_so_counts = Counter()
        
        for r in rows[2:]:
            zyg = r[zyg_idx]
            if zyg in ('Heterozygous', 'Homozygous Variant'):
                sample_variants += 1
                so = r[so_idx]
                sample_so_counts[so] += 1
                records.append({
                    'sample_id': sample_id,
                    'file': fname,
                    'chr_pos': r[0],
                    'ref_alt': r[1],
                    'zygosity': zyg,
                    'so': so,
                    'effect': r[eff_idx],
                    'gene': r[gene_idx],
                    'vaf': r[vaf_idx]
                })
        
        # Primary filter exclusions
        excluded_so_primary = {
            'intron_variant',
            'upstream_gene_variant',
            '3_prime_UTR_variant',
            '5_prime_UTR_variant',
            '5_prime_UTR_premature_start_codon_gain_variant'
        }
        
        primary_count = sum(count for so, count in sample_so_counts.items() if so not in excluded_so_primary)
        
        per_sample_stats.append({
            'sample_id': sample_id,
            'total_variants': sample_variants,
            'primary_retained': primary_count,
            'so_counts': dict(sample_so_counts)
        })

    df_variants = pd.DataFrame(records)
    print(f"Total carrier variant rows across all files: {len(df_variants)}")

    print("\nOverall Sequence Ontology counts across all carrier variants:")
    overall_so = df_variants['so'].value_counts()
    for so, count in overall_so.items():
        print(f"  {so:46}: {count:5d}")

    # Primary calculation
    excluded_primary = {
        'intron_variant',
        'upstream_gene_variant',
        '3_prime_UTR_variant',
        '5_prime_UTR_variant',
        '5_prime_UTR_premature_start_codon_gain_variant'
    }
    primary_df = df_variants[~df_variants['so'].isin(excluded_primary)]
    primary_total = len(primary_df)
    primary_avg = primary_total / num_samples

    print("\n================ PRIMARY CALCULATION ================")
    print(f"Filtered out terms: {sorted(list(excluded_primary))}")
    print(f"Retained variant counts by Sequence Ontology:")
    for so, count in primary_df['so'].value_counts().items():
        print(f"  {so:46}: {count:5d}")
    print(f"Total retained variants: {primary_total}")
    print(f"Denominator (samples): {num_samples}")
    print(f"Primary Average per sample: {primary_avg:.6f} (rounded: {primary_avg:.2f})")

    # Alternative interpretations
    # Alt 1: Retaining premature start codon gain (only intron_variant, upstream_gene_variant, 3_prime_UTR_variant, 5_prime_UTR_variant filtered)
    alt1_excluded = {'intron_variant', 'upstream_gene_variant', '3_prime_UTR_variant', '5_prime_UTR_variant'}
    alt1_df = df_variants[~df_variants['so'].isin(alt1_excluded)]
    alt1_total = len(alt1_df)
    alt1_avg = alt1_total / num_samples

    # Alt 2: Retaining premature start codon gain and upstream_gene_variant (only intron_variant, 3_prime_UTR_variant, 5_prime_UTR_variant filtered)
    alt2_excluded = {'intron_variant', '3_prime_UTR_variant', '5_prime_UTR_variant'}
    alt2_df = df_variants[~df_variants['so'].isin(alt2_excluded)]
    alt2_total = len(alt2_df)
    alt2_avg = alt2_total / num_samples

    # Alt 3: Retaining upstream_gene_variant, but filtering premature start codon gain
    alt3_excluded = {'intron_variant', '3_prime_UTR_variant', '5_prime_UTR_variant', '5_prime_UTR_premature_start_codon_gain_variant'}
    alt3_df = df_variants[~df_variants['so'].isin(alt3_excluded)]
    alt3_total = len(alt3_df)
    alt3_avg = alt3_total / num_samples

    # Alt 4: Non-synonymous / protein-altering variants only
    # Retaining missense, frameshift, inframe insertion, inframe deletion
    alt4_df = df_variants[df_variants['so'].isin({'missense_variant', 'frameshift_variant', 'inframe_insertion', 'inframe_deletion'})]
    alt4_total = len(alt4_df)
    alt4_avg = alt4_total / num_samples

    # Alt 5: Non-synonymous + splice region
    alt5_df = df_variants[df_variants['so'].isin({'missense_variant', 'frameshift_variant', 'inframe_insertion', 'inframe_deletion', 'splice_region_variant'})]
    alt5_total = len(alt5_df)
    alt5_avg = alt5_total / num_samples

    print("\n============ ALTERNATIVE BOUNDARY CALCULATIONS ============")
    print(f"Alt 1 (retaining premature start codon gain): Total={alt1_total}, Mean={alt1_avg:.6f} ({alt1_avg:.2f})")
    print(f"Alt 2 (retaining premature start codon gain & upstream): Total={alt2_total}, Mean={alt2_avg:.6f} ({alt2_avg:.2f})")
    print(f"Alt 3 (retaining upstream only): Total={alt3_total}, Mean={alt3_avg:.6f} ({alt3_avg:.2f})")
    print(f"Alt 4 (strictly protein-altering: missense/frameshift/indels): Total={alt4_total}, Mean={alt4_avg:.6f} ({alt4_avg:.2f})")
    print(f"Alt 5 (protein-altering + splice_region): Total={alt5_total}, Mean={alt5_avg:.6f} ({alt5_avg:.2f})")

    # Save summary table
    summary_df = pd.DataFrame([
        {"Interpretation": "Primary (filter intron, upstream, 3'UTR, 5'UTR, 5'UTR-premature-start)", "Retained Variants": primary_total, "Samples": num_samples, "Average per Sample": round(primary_avg, 4)},
        {"Interpretation": "Alt 1 (retain 5'UTR premature start codon gain)", "Retained Variants": alt1_total, "Samples": num_samples, "Average per Sample": round(alt1_avg, 4)},
        {"Interpretation": "Alt 2 (retain 5'UTR premature start codon gain & upstream)", "Retained Variants": alt2_total, "Samples": num_samples, "Average per Sample": round(alt2_avg, 4)},
        {"Interpretation": "Alt 3 (retain upstream only)", "Retained Variants": alt3_total, "Samples": num_samples, "Average per Sample": round(alt3_avg, 4)},
        {"Interpretation": "Alt 4 (strictly protein-altering: missense, frameshift, indels)", "Retained Variants": alt4_total, "Samples": num_samples, "Average per Sample": round(alt4_avg, 4)},
        {"Interpretation": "Alt 5 (protein-altering + splice_region)", "Retained Variants": alt5_total, "Samples": num_samples, "Average per Sample": round(alt5_avg, 4)},
    ])
    summary_df.to_csv("chip_variants_summary.csv", index=False)
    print("\nSummary saved to chip_variants_summary.csv")

if __name__ == '__main__':
    main()
