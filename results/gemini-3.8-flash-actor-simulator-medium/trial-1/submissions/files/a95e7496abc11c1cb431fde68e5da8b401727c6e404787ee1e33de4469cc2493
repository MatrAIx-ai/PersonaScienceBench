import pandas as pd
import numpy as np

# Load capital dataset
cap = pd.read_csv('data/capital.csv', decimal=',')
features = [
    'ZAxtSchwert', 'ZDolch', 'Zhausgr', 'ZCU_AU', 'Zamber',
    'ZMonument', 'ZHort', 'ZSichel', 'ZBeil', 'ZMW', 'ZKeform', 'Zkeverz'
]

capital_categories = {
    'Symbolic capital': ['ZAxtSchwert', 'ZDolch', 'Zhausgr'],
    'Social capital': ['ZCU_AU', 'Zamber', 'ZMonument'],
    'Cultural capital': ['ZKeform', 'Zkeverz'],
    'Economic capital': ['ZHort', 'ZSichel', 'ZBeil', 'ZMW']
}

def compute_pca(df):
    X = df[features].values.astype(float)
    X_cent = X - X.mean(axis=0)
    U, S, Vt = np.linalg.svd(X_cent, full_matrices=False)
    if Vt[0, features.index('ZCU_AU')] < 0:
        Vt[0] = -Vt[0]
    var_exp = (S**2) / (len(X) - 1)
    explained_variance_ratio = var_exp / var_exp.sum()
    scores = X_cent @ Vt[0]
    out = df[['BCE', 'group']].copy()
    out['PC1'] = scores
    return Vt[0], explained_variance_ratio, out

vt39, var_ratio39, res39 = compute_pca(cap)
loadings39 = pd.Series(vt39, index=features)

print(f"PC1 Explained Variance: {var_ratio39[0]*100:.2f}%")
print("\nPC1 Loadings:")
print(loadings39.to_string())

print("\nSummary Statistics for PC1 across groups:")
print(res39.groupby('group')['PC1'].agg(['count', 'mean', 'std', 'median', 'min', 'max']))

res39.to_csv('pca_results.csv', index=False)
print("\nResults successfully saved to pca_results.csv")
