import os
import sys
import json
import numpy as np
import pandas as pd

for p in ['/usr/lib/python3/dist-packages', '/usr/local/lib/python3/dist-packages']:
    if p not in sys.path:
        sys.path.append(p)
from PIL import Image, ImageDraw, ImageFont

def simulate_snowpack(init_path='data/snowpack_init.json', forcing_path='data/forcing.csv', out_dir='results'):
    os.makedirs(out_dir, exist_ok=True)
    with open(init_path, 'r') as f:
        init_data = json.load(f)
        
    layers = init_data['layers']
    thickness = np.array([l['thickness_m'] for l in layers], dtype=np.float64)
    density = np.array([l['density_kg_m3'] for l in layers], dtype=np.float64)
    ice = np.array([l['ice_mm'] for l in layers], dtype=np.float64)
    liq = np.array([l['liq_mm'] for l in layers], dtype=np.float64)
    temp = np.array([l['temp_K'] for l in layers], dtype=np.float64)
    
    rho_w = 1000.0
    c_ice = 2100.0
    c_w = 4180.0
    L_f = 3.34e5
    sigma = 5.670374419e-8
    T_melt = 273.15
    emissivity = 0.98
    h_turb = 12.0
    g = 9.81
    s_r = 0.05
    
    forcing_df = pd.read_csv(forcing_path)
    n_steps = len(forcing_df)
    n_days = n_steps // 24
    if n_steps % 24 != 0:
        raise ValueError("Forcing length not multiple of 24")
        
    initial_swe = float(np.sum(ice + liq))
    initial_depth = float(np.sum(thickness))
    
    snow_state = np.zeros((n_days, 3, 5), dtype=np.float64)
    summary_records = []
    
    dt_hour = 3600.0
    N_sub = 10
    dt_sub = dt_hour / N_sub
    
    alpha = 0.82
    cum_snowfall = 0.0
    cum_rainfall = 0.0
    cum_runoff = 0.0
    
    for day in range(n_days):
        day_melt = 0.0
        day_refreeze = 0.0
        day_runoff = 0.0
        
        for hr in range(24):
            step = day * 24 + hr
            row = forcing_df.iloc[step]
            t_air = float(row['t_air_K'])
            snowfall = float(row['snowfall_mm_hr'])
            rainfall = float(row['rainfall_mm_hr'])
            sw_in = float(row['sw_in_wm2'])
            lw_in = float(row['lw_in_wm2'])
            
            cum_snowfall += snowfall
            cum_rainfall += rainfall
            
            # 1. Precipitation
            if snowfall > 0.0:
                rho_new = max(60.0, min(120.0, 67.92 + 51.25 * np.exp((t_air - T_melt) / 2.59)))
                d_snow = snowfall / rho_new
                t_snow = min(t_air, T_melt)
                c_old = c_ice * ice[0] + c_w * liq[0]
                c_new = c_ice * snowfall
                temp[0] = (c_old * temp[0] + c_new * t_snow) / (c_old + c_new)
                ice[0] += snowfall
                thickness[0] += d_snow
                density[0] = (ice[0] + liq[0]) / thickness[0]
                alpha = 0.84
            else:
                alpha = max(0.65, alpha - (0.84 - 0.65) / (200.0 * 24.0))
                
            if rainfall > 0.0:
                t_rain = max(t_air, T_melt)
                c_old = c_ice * ice[0] + c_w * liq[0]
                c_rain = c_w * rainfall
                temp[0] = (c_old * temp[0] + c_rain * t_rain) / (c_old + c_rain)
                liq[0] += rainfall
                density[0] = (ice[0] + liq[0]) / thickness[0]
                
            # 2. Conduction & Phase Transitions
            for _ in range(N_sub):
                k = np.maximum(0.04, 0.024 - 1.23e-4 * density + 2.5e-6 * (density**2))
                k_01 = (thickness[0] + thickness[1]) / (thickness[0] / k[0] + thickness[1] / k[1])
                k_12 = (thickness[1] + thickness[2]) / (thickness[1] / k[1] + thickness[2] / k[2])
                d_01 = 0.5 * (thickness[0] + thickness[1])
                d_12 = 0.5 * (thickness[1] + thickness[2])
                F_01 = k_01 * (temp[0] - temp[1]) / d_01
                F_12 = k_12 * (temp[1] - temp[2]) / d_12
                
                Q_surf = (1.0 - alpha) * sw_in + emissivity * (lw_in - sigma * (temp[0]**4)) + h_turb * (t_air - temp[0])
                c_p = c_ice * ice + c_w * liq
                temp[0] += (Q_surf - F_01) / c_p[0] * dt_sub
                temp[1] += (F_01 - F_12) / c_p[1] * dt_sub
                temp[2] += (F_12) / c_p[2] * dt_sub
                
                for i in range(3):
                    if temp[i] > T_melt:
                        q_exc = c_p[i] * (temp[i] - T_melt)
                        dm = min(ice[i], q_exc / L_f)
                        ice[i] -= dm
                        liq[i] += dm
                        temp[i] = T_melt
                        day_melt += dm
                        if ice[i] + dm > 0.0:
                            thickness[i] *= max(0.1, 1.0 - dm / (ice[i] + dm))
                    elif temp[i] < T_melt and liq[i] > 0.0:
                        q_cld = c_p[i] * (T_melt - temp[i])
                        dr = min(liq[i], q_cld / L_f)
                        liq[i] -= dr
                        ice[i] += dr
                        temp[i] += dr * L_f / c_p[i]
                        temp[i] = min(temp[i], T_melt)
                        day_refreeze += dr

            # 3. Drainage & Runoff
            for i in range(2):
                liq_max = s_r * ice[i]
                if liq[i] > liq_max:
                    excess = liq[i] - liq_max
                    liq[i] = liq_max
                    liq[i+1] += excess
            liq_max_base = s_r * ice[2]
            if liq[2] > liq_max_base:
                excess = liq[2] - liq_max_base
                liq[2] = liq_max_base
                day_runoff += excess
                cum_runoff += excess
                
            # 4. Compaction
            for i in range(3):
                f_T = np.exp(-0.04 * (T_melt - temp[i]))
                f_rho = np.exp(-0.046 * max(0.0, density[i] - 100.0))
                cr_destruct = 2.778e-6 * f_T * f_rho
                m_above = np.sum(ice[:i] + liq[:i]) + 0.5 * (ice[i] + liq[i])
                p_over = g * m_above
                eta = 1.0e7 * np.exp(0.021 * density[i]) * np.exp(0.08 * (T_melt - temp[i]))
                cr_overburden = p_over / eta
                cr_tot = cr_destruct + cr_overburden
                strain = 1.0 - np.exp(-cr_tot * dt_hour)
                thickness[i] *= (1.0 - strain)
                m_tot = ice[i] + liq[i]
                density[i] = m_tot / thickness[i]
                if density[i] > 550.0:
                    density[i] = 550.0
                    thickness[i] = m_tot / 550.0
                    
            # Strict Mass Conservation Check
            current_swe = float(np.sum(ice + liq))
            residual = (current_swe - initial_swe) - (cum_snowfall + cum_rainfall - cum_runoff)
            assert abs(residual) < 1e-10, f"Mass balance violation at step {step}"

        # End of Day State
        day_swe = float(np.sum(ice + liq))
        day_depth = float(np.sum(thickness))
        day_mean_density = float(day_swe / day_depth)
        
        for i in range(3):
            snow_state[day, i, :] = [thickness[i], density[i], ice[i], liq[i], temp[i]]
            
        summary_records.append({
            'day': int(day),
            'swe_mm': day_swe,
            'snow_depth_m': day_depth,
            'melt_mm': float(day_melt),
            'refreeze_mm': float(day_refreeze),
            'runoff_mm': float(day_runoff),
            'mean_density_kg_m3': day_mean_density
        })

    # Save artifacts
    np.save(os.path.join(out_dir, 'snow_state.npy'), snow_state)
    summary_df = pd.DataFrame(summary_records)
    summary_df.to_csv(os.path.join(out_dir, 'snow_summary.csv'), index=False)
    generate_diagnostic_figure(snow_state, summary_df, os.path.join(out_dir, 'snow_evolution.png'))
    print("All outputs generated successfully!")
    return snow_state, summary_df

def generate_diagnostic_figure(snow_state, summary_df, output_png):
    days = summary_df['day'].values
    n_days = len(days)
    
    W, H = 1400, 1600
    img = Image.new('RGB', (W, H), color=(255, 255, 255))
    draw = ImageDraw.Draw(img)
    
    font_bold = '/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf'
    font_reg = '/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf'
    
    f_title = ImageFont.truetype(font_bold, 24)
    f_sub = ImageFont.truetype(font_bold, 16)
    f_axis = ImageFont.truetype(font_bold, 13)
    f_tick = ImageFont.truetype(font_reg, 11)
    f_leg = ImageFont.truetype(font_reg, 12)
    
    draw.text((W // 2 - 320, 25), "3-Layer Snowpack Dynamics: Compaction, Thermal & Hydrological Evolution", fill=(20, 20, 20), font=f_title)
    
    panels = [
        (120, 80, 1300, 330),
        (120, 380, 1300, 630),
        (120, 680, 1300, 930),
        (120, 980, 1300, 1230),
        (120, 1280, 1300, 1530)
    ]
    
    def draw_panel_box(p_idx, title, y_label, y_min, y_max, y_ticks):
        x0, y0, x1, y1 = panels[p_idx]
        draw.rectangle([x0, y0, x1, y1], outline=(180, 180, 180), width=1, fill=(250, 250, 252))
        draw.text((x0, y0 - 25), title, fill=(30, 30, 30), font=f_sub)
        draw.text((x0 - 90, (y0 + y1) // 2 - 10), y_label, fill=(40, 40, 40), font=f_axis)
        
        for y_val in y_ticks:
            y_pos = y1 - (y_val - y_min) / (y_max - y_min) * (y1 - y0)
            draw.line([(x0, y_pos), (x1, y_pos)], fill=(225, 225, 230), width=1)
            tick_str = f"{y_val:.1f}" if isinstance(y_val, float) else f"{y_val}"
            draw.text((x0 - 45, y_pos - 7), tick_str, fill=(80, 80, 80), font=f_tick)
            
        for d in range(0, 70, 10):
            x_pos = x0 + (d / (n_days - 1)) * (x1 - x0)
            draw.line([(x_pos, y0), (x_pos, y1)], fill=(225, 225, 230), width=1)
            draw.text((x_pos - 8, y1 + 6), f"{d}", fill=(80, 80, 80), font=f_tick)
            
        if p_idx == len(panels) - 1:
            draw.text(((x0 + x1) // 2 - 20, y1 + 25), "Simulation Day", fill=(40, 40, 40), font=f_axis)
            
    def map_pts(p_idx, xs, ys, y_min, y_max):
        x0, y0, x1, y1 = panels[p_idx]
        pts = []
        for x, y in zip(xs, ys):
            px = x0 + (x / (n_days - 1)) * (x1 - x0)
            py = y1 - (y - y_min) / (y_max - y_min) * (y1 - y0)
            pts.append((px, py))
        return pts

    colors = [(31, 119, 180), (44, 160, 44), (148, 103, 189)]
    layer_names = ["Layer 0 (Top)", "Layer 1 (Middle)", "Layer 2 (Base)"]

    # Panel 0: Snow Depth & SWE
    draw_panel_box(0, "(a) Total Snowpack Depth & Snow Water Equivalent (SWE)", "Depth (m)", 0.5, 1.5, [0.6, 0.8, 1.0, 1.2, 1.4])
    pts_depth = map_pts(0, days, summary_df['snow_depth_m'].values, 0.5, 1.5)
    for i in range(len(pts_depth) - 1):
        draw.line([pts_depth[i], pts_depth[i+1]], fill=(31, 119, 180), width=3)
        
    x0, y0, x1, y1 = panels[0]
    draw.text((x1 + 15, (y0 + y1) // 2 - 10), "SWE (mm)", fill=(214, 39, 40), font=f_axis)
    for swe_val in [200, 220, 240, 260, 280, 300]:
        y_pos = y1 - (swe_val - 180.0) / (300.0 - 180.0) * (y1 - y0)
        draw.text((x1 + 10, y_pos - 7), f"{swe_val}", fill=(214, 39, 40), font=f_tick)
    pts_swe = map_pts(0, days, summary_df['swe_mm'].values, 180.0, 300.0)
    for i in range(len(pts_swe) - 1):
        draw.line([pts_swe[i], pts_swe[i+1]], fill=(214, 39, 40), width=3)
        
    draw.line([(950, 100), (990, 100)], fill=(31, 119, 180), width=3)
    draw.text((1000, 93), "Snow Depth (m)", fill=(31, 119, 180), font=f_leg)
    draw.line([(1140, 100), (1180, 100)], fill=(214, 39, 40), width=3)
    draw.text((1190, 93), "SWE (mm)", fill=(214, 39, 40), font=f_leg)

    # Panel 1: Melt, Refreeze, Runoff
    draw_panel_box(1, "(b) Daily Hydrological Fluxes: Melt, Refreeze & Runoff", "Flux (mm/d)", 0.0, 3.0, [0.0, 0.5, 1.0, 1.5, 2.0, 2.5, 3.0])
    pts_melt = map_pts(1, days, summary_df['melt_mm'].values, 0.0, 3.0)
    pts_refr = map_pts(1, days, summary_df['refreeze_mm'].values, 0.0, 3.0)
    for i in range(len(pts_melt) - 1):
        draw.line([pts_melt[i], pts_melt[i+1]], fill=(255, 127, 14), width=3)
        draw.line([pts_refr[i], pts_refr[i+1]], fill=(44, 160, 44), width=2)
    draw.line([(950, 400), (990, 400)], fill=(255, 127, 14), width=3)
    draw.text((1000, 393), "Melt (mm/d)", fill=(255, 127, 14), font=f_leg)
    draw.line([(1110, 400), (1150, 400)], fill=(44, 160, 44), width=2)
    draw.text((1160, 393), "Refreeze (mm/d)", fill=(44, 160, 44), font=f_leg)

    # Panel 2: Layer Bulk Densities
    draw_panel_box(2, "(c) Layer Bulk Densities (Compaction Dynamics)", "Density (kg/m³)", 80.0, 480.0, [100, 200, 300, 400])
    for l_idx in range(3):
        pts_dens = map_pts(2, days, snow_state[:, l_idx, 1], 80.0, 480.0)
        for i in range(len(pts_dens) - 1):
            draw.line([pts_dens[i], pts_dens[i+1]], fill=colors[l_idx], width=2)
        draw.line([(900 + l_idx * 130, 700), (930 + l_idx * 130, 700)], fill=colors[l_idx], width=2)
        draw.text((935 + l_idx * 130, 693), layer_names[l_idx], fill=colors[l_idx], font=f_leg)

    # Panel 3: Layer Thicknesses
    draw_panel_box(3, "(d) Layer Thicknesses Evolution", "Thickness (m)", 0.0, 0.8, [0.0, 0.2, 0.4, 0.6, 0.8])
    for l_idx in range(3):
        pts_th = map_pts(3, days, snow_state[:, l_idx, 0], 0.0, 0.8)
        for i in range(len(pts_th) - 1):
            draw.line([pts_th[i], pts_th[i+1]], fill=colors[l_idx], width=2)
        draw.line([(900 + l_idx * 130, 1000), (930 + l_idx * 130, 1000)], fill=colors[l_idx], width=2)
        draw.text((935 + l_idx * 130, 993), layer_names[l_idx], fill=colors[l_idx], font=f_leg)

    # Panel 4: Layer Temperatures
    draw_panel_box(4, "(e) Layer Temperatures (Daily End-of-Day Snapshot)", "Temp (°C)", -12.0, 2.0, [-12.0, -8.0, -4.0, 0.0])
    pts_zero = map_pts(4, [0, n_days - 1], [0.0, 0.0], -12.0, 2.0)
    draw.line([pts_zero[0], pts_zero[1]], fill=(120, 120, 120), width=1)
    for l_idx in range(3):
        temps_C = snow_state[:, l_idx, 4] - 273.15
        pts_t = map_pts(4, days, temps_C, -12.0, 2.0)
        for i in range(len(pts_t) - 1):
            draw.line([pts_t[i], pts_t[i+1]], fill=colors[l_idx], width=2)
        draw.line([(900 + l_idx * 130, 1300), (930 + l_idx * 130, 1300)], fill=colors[l_idx], width=2)
        draw.text((935 + l_idx * 130, 1293), layer_names[l_idx], fill=colors[l_idx], font=f_leg)

    img.save(output_png, 'PNG')

if __name__ == '__main__':
    simulate_snowpack()
