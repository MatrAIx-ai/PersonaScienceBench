# Analysis of median wealth changes among Black females across survey waves
import pandas as pd

def run_analysis():
    df = pd.read_csv('data/nls_incarceration_processed.csv')
    bf = df[(df['race'] == 'black') & (df['sex'] == 'female')]
    
    # Overall medians
    med_85 = bf['composite_wealth_1985'].median()
    med_90 = bf['composite_wealth_1990'].median()
    med_96 = bf['composite_wealth_1996'].median()
    
    diff_85_90 = med_90 - med_85
    diff_90_96 = med_96 - med_90
    
    ann_85_90 = diff_85_90 / 5
    ann_90_96 = diff_90_96 / 6
    
    print(f'Overall Black Females (N={len(bf)}):')
    print(f'1985 Median Wealth: {med_85}')
    print(f'1990 Median Wealth: {med_90}')
    print(f'1996 Median Wealth: {med_96}')
    print(f'1985-1990: Absolute = {diff_85_90}, Annualized = {ann_85_90:.2f}/yr')
    print(f'1990-1996: Absolute = {diff_90_96}, Annualized = {ann_90_96:.2f}/yr')
    
    # Stratified by incarceration status
    for status, grp in bf.groupby('ever_jailed'):
        label = 'Never Jailed' if status == 0 else 'Ever Jailed'
        m85 = grp['composite_wealth_1985'].median()
        m90 = grp['composite_wealth_1990'].median()
        m96 = grp['composite_wealth_1996'].median()
        print(f'{label} (N={len(grp)}): 1985={m85}, 1990={m90}, 1996={m96}')

if __name__ == '__main__':
    run_analysis()