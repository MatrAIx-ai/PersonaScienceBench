import pandas as pd

def analyze_pottery_trends():
    df = pd.read_csv('data/capital.csv', decimal=',')
    df['CE'] = -df['BCE']
    df = df.sort_values('CE').reset_index(drop=True)

    df['d_Form'] = df['ZKeform'].diff()
    df['d_Dec'] = df['Zkeverz'].diff()

    opposite_trends = df[(df['d_Dec'] > 0) & (df['d_Form'] < 0)]
    print("Century intervals with opposite trends (Pottery Decoration increasing, Pottery Form declining):")
    for idx, row in opposite_trends.iterrows():
        prev_row = df.iloc[idx - 1]
        print(f"Interval: {int(prev_row['BCE'])} BCE - {int(row['BCE'])} BCE (CE {int(prev_row['CE'])} to {int(row['CE'])})")
        print(f"  Period: {prev_row['group']} -> {row['group']}")
        print(f"  Pottery Form (ZKeform): {prev_row['ZKeform']:.2f} -> {row['ZKeform']:.2f} (change: {row['d_Form']:+.2f})")
        print(f"  Pottery Decoration (Zkeverz): {prev_row['Zkeverz']:.2f} -> {row['Zkeverz']:.2f} (change: {row['d_Dec']:+.2f})")

if __name__ == '__main__':
    analyze_pottery_trends()
