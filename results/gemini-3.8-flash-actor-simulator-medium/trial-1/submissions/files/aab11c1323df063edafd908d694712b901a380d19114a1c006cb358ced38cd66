import pandas as pd
import numpy as np

# Load capital dataset
df_cap = pd.read_csv('data/capital.csv')
num_cols = [c for c in df_cap.columns if c not in ['BCE', 'group', 'color']]
for c in num_cols:
    df_cap[c] = df_cap[c].astype(str).str.replace(',', '.').astype(float)

# Category definitions based on theoretical archaeology context
social_caps = ['ZCU_AU', 'Zamber', 'ZMonument']
symbolic_caps = ['ZAxtSchwert', 'ZDolch', 'Zhausgr']
cultural_caps = ['ZKeform', 'Zkeverz']
economic_caps = ['ZHort', 'ZSichel', 'ZBeil', 'ZMW']
all_caps = symbolic_caps + social_caps + cultural_caps + economic_caps

df_cap['sum_social_capital'] = df_cap[social_caps].sum(axis=1)
df_cap['sum_all_capital'] = df_cap[all_caps].sum(axis=1)

print("Peak of specific social capital (ZCU_AU + Zamber + ZMonument):")
print(df_cap.sort_values(by='sum_social_capital', ascending=False)[['BCE', 'group', 'sum_social_capital', 'ZCU_AU', 'Zamber', 'ZMonument']].head(5))

print("\nPeak of total capital (all 12 indicators):")
print(df_cap.sort_values(by='sum_all_capital', ascending=False)[['BCE', 'group', 'sum_all_capital', 'ZCU_AU', 'Zamber', 'ZMonument']].head(5))

# Check time series data consistency
df_ts = pd.read_csv('data/time_series_data.csv')
sc_ts_cols = ['CopperGold_inter', 'Amber_inter', 'MonumentCount_inter']
df_ts['sum_social_capital_inter'] = df_ts[sc_ts_cols].sum(axis=1)
all_ts_cols = [c + '_inter' for c in ['HatchetSword', 'Dagger', 'HouseSize', 'CopperGold', 'Amber', 'MonumentCount', 'Depot', 'Sickle', 'AxesCelts', 'MonumentSize', 'PotteryForm', 'PotteryDecoration']]
df_ts['sum_all_capital_inter'] = df_ts[all_ts_cols].sum(axis=1)

peak_sc_ts = df_ts.loc[df_ts['sum_social_capital_inter'].idxmax()]
peak_all_ts = df_ts.loc[df_ts['sum_all_capital_inter'].idxmax()]
print(f"\nTime series max social capital: CE = {peak_sc_ts['CE']} (BCE {abs(peak_sc_ts['CE'])}), value = {peak_sc_ts['sum_social_capital_inter']:.4f}")
print(f"Time series max total capital: CE = {peak_all_ts['CE']} (BCE {abs(peak_all_ts['CE'])}), value = {peak_all_ts['sum_all_capital_inter']:.4f}")
