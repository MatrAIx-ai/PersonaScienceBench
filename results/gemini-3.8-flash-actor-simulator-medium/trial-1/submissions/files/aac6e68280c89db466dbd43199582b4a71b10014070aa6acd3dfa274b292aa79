import pandas as pd
import numpy as np
from scipy import stats

def gini_coef(wealth):
    wealth = np.sort(np.array(wealth, dtype=float))
    n = len(wealth)
    index = np.arange(1, n + 1)
    return (np.sum((2 * index - n - 1) * wealth)) / (n * np.sum(wealth))

def run_analysis():
    df = pd.read_csv('data/nls_incarceration_processed.csv')
    wm = df[(df['race'] == 'white') & (df['sex'] == 'male')]
    wf = df[(df['race'] == 'white') & (df['sex'] == 'female')]
    
    records = []
    for name, group in [('White Males', wm), ('White Females', wf)]:
        for yr in [1990, 1996]:
            col = f'composite_wealth_{yr}'
            vals = group[col]
            p10 = vals.quantile(0.10)
            p25 = vals.quantile(0.25)
            p50 = vals.quantile(0.50)
            p75 = vals.quantile(0.75)
            p90 = vals.quantile(0.90)
            p99 = vals.quantile(0.99)
            g = gini_coef(vals)
            top10_share = vals[vals >= p90].sum() / vals.sum()
            top1_share = vals[vals >= p99].sum() / vals.sum()
            records.append({
                'Group': name,
                'Year': yr,
                'N': len(vals),
                'Mean': vals.mean(),
                'Median': p50,
                'SD': vals.std(),
                'IQR': p75 - p25,
                'P10': p10,
                'P90': p90,
                'P90/P50': p90 / p50 if p50 != 0 else np.nan,
                'Gini': g,
                'Top10_Share': top10_share,
                'Top1_Share': top1_share,
                'Zero_Pct': (vals == 0).mean() * 100,
                'Neg_Pct': (vals < 0).mean() * 100
            })
    res_df = pd.DataFrame(records)
    res_df.to_csv('wealth_inequality_metrics.csv', index=False)
    print(res_df.to_string())

if __name__ == '__main__':
    run_analysis()
