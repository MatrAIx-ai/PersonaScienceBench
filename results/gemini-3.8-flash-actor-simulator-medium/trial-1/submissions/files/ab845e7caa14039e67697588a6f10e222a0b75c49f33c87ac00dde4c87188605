import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf

def run_analysis():
    df = pd.read_csv('data/nls_raw.csv')

    # Data preparation
    df['educ'] = df['Highest grade completed, 1979'].copy()
    df.loc[df['educ'] > 20, 'educ'] = np.nan

    # Target: BA completion (>= 16) and College Attendance (>= 13)
    df['ba_completion'] = (df['educ'] >= 16).astype(float)
    df.loc[df['educ'].isna(), 'ba_completion'] = np.nan

    df['college_any'] = (df['educ'] >= 13).astype(float)
    df.loc[df['educ'].isna(), 'college_any'] = np.nan

    # Demographics
    df['race'] = df['Racial/ethnic cohort, 1979'].map({1: 'Black', 2: 'Hispanic', 3: 'White'})
    df['age'] = df['Age of respondent, 1979']
    df['female'] = (df['Sex of respondent, 1979'] == 2).astype(int)

    # Parental education
    df['mother_educ'] = df["Highest grade completed by respondent's mother, 1979"].copy()
    df.loc[df['mother_educ'] > 20, 'mother_educ'] = np.nan

    df['father_educ'] = df["Highest grade completed by respondent's father, 1979"].copy()
    df.loc[df['father_educ'] > 20, 'father_educ'] = np.nan

    df['parent_educ'] = df[['mother_educ', 'father_educ']].mean(axis=1)

    # Family Income
    df['family_income'] = df['Total net family income, previous calendar year, 1979'].copy()
    df['log_income'] = np.log(df['family_income'].clip(lower=0) + 1)

    # Standardized SES composite
    income_z = (df['log_income'] - df['log_income'].mean()) / df['log_income'].std()
    parent_educ_z = (df['parent_educ'] - df['parent_educ'].mean()) / df['parent_educ'].std()
    df['ses_composite'] = (income_z + parent_educ_z) / 2.0
    df['ses_composite'] = (df['ses_composite'] - df['ses_composite'].mean()) / df['ses_composite'].std()

    # Academic cognitive scores (ASVAB)
    asvab_cols = [
        'ASVAB - Arithmetic Reasoning Z Score (rounded), 1981',
        'ASVAB - Word Knowledge Z Score (rounded), 1981',
        'ASVAB - Paragraph Comprehension Z Score (rounded), 1981',
        'ASVAB - Mathematics Knowledge Z Score (rounded), 1981'
    ]
    for c in asvab_cols:
        df[c + '_z'] = (df[c] - df[c].mean()) / df[c].std()

    df['asvab_composite'] = df[[c + '_z' for c in asvab_cols]].mean(axis=1)
    df['asvab_composite'] = (df['asvab_composite'] - df['asvab_composite'].mean()) / df['asvab_composite'].std()

    # Class rank percentile
    df['class_rank_pct'] = 1.0 - (df['Rank in class last year attended at this school, 1981'] / df['Number of students in class last year attended at this school, 1981'])
    df.loc[(df['class_rank_pct'] < 0) | (df['class_rank_pct'] > 1), 'class_rank_pct'] = np.nan

    # Estimation Subsample A
    sub_a = df.dropna(subset=['ba_completion', 'college_any', 'race', 'ses_composite', 'asvab_composite', 'age', 'female']).copy()

    # Models for BA Completion
    m1_ba = smf.logit('ba_completion ~ C(race, Treatment(reference="White")) + ses_composite + age + female', data=sub_a).fit(disp=False)
    m2_ba = smf.logit('ba_completion ~ C(race, Treatment(reference="White")) + ses_composite + asvab_composite + age + female', data=sub_a).fit(disp=False)

    m1_ba_ols = smf.ols('ba_completion ~ C(race, Treatment(reference="White")) + ses_composite + age + female', data=sub_a).fit()
    m2_ba_ols = smf.ols('ba_completion ~ C(race, Treatment(reference="White")) + ses_composite + asvab_composite + age + female', data=sub_a).fit()

    # Models for College Attendance
    m1_col = smf.logit('college_any ~ C(race, Treatment(reference="White")) + ses_composite + age + female', data=sub_a).fit(disp=False)
    m2_col = smf.logit('college_any ~ C(race, Treatment(reference="White")) + ses_composite + asvab_composite + age + female', data=sub_a).fit(disp=False)

    print("Analysis complete.")

if __name__ == '__main__':
    run_analysis()
