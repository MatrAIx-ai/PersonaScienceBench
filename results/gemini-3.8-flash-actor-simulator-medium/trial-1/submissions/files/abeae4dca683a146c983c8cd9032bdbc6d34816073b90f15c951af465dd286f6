import pandas as pd
import numpy as np

# Load capital dataset with comma decimal format
df = pd.read_csv('data/capital.csv', decimal=',')

# Define capital features according to domain categories
features = [
    'ZAxtSchwert', 'ZDolch', 'Zhausgr',
    'ZCU_AU', 'Zamber', 'ZMonument',
    'ZHort', 'ZSichel', 'ZBeil', 'ZMW',
    'ZKeform', 'Zkeverz'
]

capital_categories = {
    'ZAxtSchwert': 'Symbolic Capital (Hatchets & Swords)',
    'ZDolch': 'Symbolic Capital (Daggers)',
    'Zhausgr': 'Symbolic Capital (House Size)',
    'ZCU_AU': 'Social Capital (Copper & Gold)',
    'Zamber': 'Social Capital (Amber)',
    'ZMonument': 'Social Capital (Monument Count)',
    'ZHort': 'Economic Capital (Hoards/Depots)',
    'ZSichel': 'Economic Capital (Sickles)',
    'ZBeil': 'Economic Capital (Axes & Celts)',
    'ZMW': 'Economic Capital (Monument Size)',
    'ZKeform': 'Cultural Capital (Pottery Form Diversity)',
    'Zkeverz': 'Cultural Capital (Pottery Decoration Diversity)'
}

X = df[features].values

# Centered PCA (Covariance Matrix)
X_mean = X.mean(axis=0)
X_c = X - X_mean
U, S, Vt = np.linalg.svd(X_c, full_matrices=False)

# Ensure consistent sign orientation (positive loading on prestige metals: Copper/Gold)
if Vt[0, features.index('ZCU_AU')] < 0:
    Vt = -Vt
    U = -U

pc_scores = U * S
df['PC1'] = pc_scores[:, 0]
df['PC2'] = pc_scores[:, 1]

# Standardized PCA (Correlation Matrix) for robustness
X_std = (X - X_mean) / X.std(axis=0, ddof=1)
U_std, S_std, Vt_std = np.linalg.svd(X_std, full_matrices=False)
if Vt_std[0, features.index('ZCU_AU')] < 0:
    Vt_std = -Vt_std
    U_std = -U_std
df['PC1_std'] = (U_std * S_std)[:, 0]

# Variance explained
var_explained = (S**2) / np.sum(S**2)

# Loadings table
loadings = pd.DataFrame({
    'Feature': features,
    'Category': [capital_categories[f] for f in features],
    'PC1_Loading_Cov': Vt[0],
    'PC1_Loading_Corr': Vt_std[0]
})
loadings.to_csv('pc1_loadings.csv', index=False)

# YBA Horizon comparison
yba_df = df[df['group'] == 'YBA'][['BCE', 'PC1', 'PC1_std'] + features].copy()
yba_df.to_csv('yba_pc1_summary.csv', index=False)

print("Analysis executed successfully.")
