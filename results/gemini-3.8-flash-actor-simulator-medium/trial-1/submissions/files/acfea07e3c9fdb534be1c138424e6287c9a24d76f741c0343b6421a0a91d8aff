"""
Analysis of the independent effect of ongoing medical conditions (MHONGO)
on COVID-19 severity using ordinal logistic regression.
Task: bix-29-q2 (BCG-CORONA trial dataset)
"""

import os
import pandas as pd
import numpy as np
from statsmodels.miscmodels.ordinal_model import OrderedModel

def run_analysis():
    # 1. Load datasets
    dm_path = 'data/TASK008_BCG-CORONA_DM.csv'
    ae_path = 'data/TASK008_BCG-CORONA_AE.csv'
    mh_path = 'data/TASK008_BCG-CORONA_MH.csv'

    dm = pd.read_csv(dm_path)
    ae = pd.read_csv(ae_path)
    mh = pd.read_csv(mh_path)

    print("Data shapes:")
    print(f"  DM: {dm.shape}")
    print(f"  AE: {ae.shape}")
    print(f"  MH: {mh.shape}")

    # 2. Derive count of ongoing medical conditions (MHONGO)
    mh_ongo = mh[mh['MHONGO'] == 'Yes'].groupby('USUBJID').size().rename('MHONGO_count')
    df = dm.merge(mh_ongo, on='USUBJID', how='left')
    df['MHONGO_count'] = df['MHONGO_count'].fillna(0).astype(int)

    # 3. Filter COVID-19 adverse events and determine max severity per subject
    covid_pt_terms = [
        'COVID-19',
        'COVID-19 pneumonia',
        'Asymptomatic COVID-19',
        'SARS-CoV-2 test positive'
    ]
    ae_covid = ae[ae['AEPT'].isin(covid_pt_terms)].copy()

    # Max WHO Health Status (AEHS) and CTCAE severity (AESEV)
    max_aehs = ae_covid.groupby('USUBJID')['AEHS'].max().rename('max_AEHS')
    max_aesev = ae_covid.groupby('USUBJID')['AESEV'].max().rename('max_AESEV')
    covid_subj = max_aehs.to_frame().join(max_aesev)

    df_covid = df.merge(covid_subj, on='USUBJID', how='inner')
    print(f"\nDocumented COVID-19 cases: {len(df_covid)} subjects")
    print("Distribution of max_AEHS in COVID-19 cases:")
    print(df_covid['max_AEHS'].value_counts().sort_index())

    # 4. Primary Ordinal Logistic Regression Model
    formula_primary = (
        'max_AEHS ~ MHONGO_count + '
        'C(TRTGRP, Treatment("Placebo")) + '
        'C(patients_seen, Treatment("1-50")) + '
        'C(expect_interact, Treatment("No"))'
    )
    model_primary = OrderedModel.from_formula(formula_primary, data=df_covid, distr='logit')
    res_primary = model_primary.fit(method='bfgs', maxiter=2000, disp=False)

    print("\n" + "="*50)
    print("PRIMARY ORDINAL LOGISTIC REGRESSION MODEL RESULTS")
    print("="*50)
    print(res_primary.summary())

    coef = res_primary.params['MHONGO_count']
    se = res_primary.bse['MHONGO_count']
    pval = res_primary.pvalues['MHONGO_count']
    ci_low = coef - 1.96 * se
    ci_high = coef + 1.96 * se

    odds_ratio = np.exp(coef)
    or_low = np.exp(ci_low)
    or_high = np.exp(ci_high)

    pct_increase = (odds_ratio - 1) * 100
    pct_low = (or_low - 1) * 100
    pct_high = (or_high - 1) * 100

    print("\nKey Effect Estimates for MHONGO (per additional condition):")
    print(f"  Coefficient (log-odds): {coef:.4f} (SE: {se:.4f}, p = {pval:.4f})")
    print(f"  Odds Ratio (OR):        {odds_ratio:.4f} (95% CI: [{or_low:.4f}, {or_high:.4f}])")
    print(f"  Percentage Increase:    {pct_increase:.2f}% (95% CI: [{pct_low:.2f}%, {pct_high:.2f}%])")

    # 5. Sensitivity Analyses
    print("\n" + "="*50)
    print("SENSITIVITY ANALYSES")
    print("="*50)

    # Sens 1: patients_seen as ordinal score (1, 2, 3)
    ps_map = {'1-50': 1, '51-100': 2, '>100': 3}
    df_covid['patients_seen_ord'] = df_covid['patients_seen'].map(ps_map)
    f_s1 = 'max_AEHS ~ MHONGO_count + C(TRTGRP, Treatment("Placebo")) + patients_seen_ord + C(expect_interact, Treatment("No"))'
    res_s1 = OrderedModel.from_formula(f_s1, data=df_covid, distr='logit').fit(method='bfgs', maxiter=2000, disp=False)
    c1 = res_s1.params['MHONGO_count']
    print(f"1. patients_seen as ordinal trend: OR = {np.exp(c1):.4f}, Pct Increase = {(np.exp(c1)-1)*100:.2f}%")

    # Sens 2: AESEV outcome (n=153 non-missing)
    df_aesev = df_covid.dropna(subset=['max_AESEV'])
    f_s2 = 'max_AESEV ~ MHONGO_count + C(TRTGRP, Treatment("Placebo")) + C(patients_seen, Treatment("1-50")) + C(expect_interact, Treatment("No"))'
    res_s2 = OrderedModel.from_formula(f_s2, data=df_aesev, distr='logit').fit(method='bfgs', maxiter=2000, disp=False)
    c2 = res_s2.params['MHONGO_count']
    print(f"2. Using AESEV (CTCAE grade, n={len(df_aesev)}): OR = {np.exp(c2):.4f}, Pct Increase = {(np.exp(c2)-1)*100:.2f}%")

    # Sens 3: Full cohort (N=1000)
    df_all = df.merge(covid_subj, on='USUBJID', how='left')
    df_all['full_sev'] = df_all['max_AEHS'].fillna(-1) + 1
    f_s3 = 'full_sev ~ MHONGO_count + C(TRTGRP, Treatment("Placebo")) + C(patients_seen, Treatment("1-50")) + C(expect_interact, Treatment("No"))'
    res_s3 = OrderedModel.from_formula(f_s3, data=df_all, distr='logit').fit(method='bfgs', maxiter=2000, disp=False)
    c3 = res_s3.params['MHONGO_count']
    print(f"3. Full trial cohort (N=1000, uninfected=0): OR = {np.exp(c3):.4f}, Pct Increase = {(np.exp(c3)-1)*100:.2f}%")

    return {
        'coef': coef,
        'odds_ratio': odds_ratio,
        'pct_increase': pct_increase,
        'ci': (pct_low, pct_high)
    }

if __name__ == '__main__':
    run_analysis()
