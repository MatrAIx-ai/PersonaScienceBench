import pandas as pd
import numpy as np
from scipy import stats

def main():
    df = pd.read_csv('data/nls_raw.csv')
    race_map = {1: 'Black', 2: 'Hispanic', 3: 'White'}
    df['race'] = df['Racial/ethnic cohort, 1979'].map(race_map)

    wealth_cols = {
        1985: 'Family net wealth, 1985',
        1990: 'Family net wealth, 1990',
        1996: 'Family net wealth, 1996 (key data point)'
    }
    cpi_factor = {1985: 156.9 / 107.6, 1990: 156.9 / 130.7, 1996: 1.0}

    print("=== SUMMARY METRICS ===")
    for yr, col in wealth_cols.items():
        factor = cpi_factor[yr]
        print(f"\n--- Year {yr} ---")
        for r in ['White', 'Black', 'Hispanic']:
            s = df[df['race'] == r][col].dropna()
            med_nom = s.median()
            iqr_nom = s.quantile(0.75) - s.quantile(0.25)
            med_real = med_nom * factor
            iqr_real = iqr_nom * factor
            print(f"{r:8s} (N={len(s):4d}): Median Nom=${med_nom:10.1f}, IQR Nom=${iqr_nom:10.1f} | Real96 Med=${med_real:10.1f}, IQR=${iqr_real:10.1f}")

        w_s = df[df['race'] == 'White'][col].dropna()
        b_s = df[df['race'] == 'Black'][col].dropna()
        h_s = df[df['race'] == 'Hispanic'][col].dropna()

        kw = stats.kruskal(w_s, b_s, h_s)
        mw_wb = stats.mannwhitneyu(w_s, b_s)
        mw_wh = stats.mannwhitneyu(w_s, h_s)
        print(f"Kruskal-Wallis: H={kw.statistic:.2f}, p={kw.pvalue:.2e}")
        print(f"White/Black Ratio: {w_s.median()/b_s.median():.2f}, Gap Nom: ${w_s.median()-b_s.median():.1f}, MW p={mw_wb.pvalue:.2e}")
        print(f"White/Hispanic Ratio: {w_s.median()/h_s.median():.2f}, Gap Nom: ${w_s.median()-h_s.median():.1f}, MW p={mw_wh.pvalue:.2e}")

if __name__ == '__main__':
    main()
