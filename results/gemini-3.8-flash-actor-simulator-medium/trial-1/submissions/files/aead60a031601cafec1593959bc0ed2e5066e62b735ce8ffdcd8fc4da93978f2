import pandas as pd
import numpy as np

# Load capital dataset
df_cap = pd.read_csv('data/capital.csv', decimal=',')
for col in ['ZAxtSchwert', 'ZDolch', 'Zhausgr', 'ZCU_AU', 'Zamber', 'ZMonument', 'ZHort', 'ZSichel', 'ZBeil', 'ZMW', 'ZKeform', 'Zkeverz']:
    df_cap[col] = df_cap[col].astype(float)

df_cap['SocialCapital'] = df_cap['ZCU_AU'] + df_cap['Zamber'] + df_cap['ZMonument']

# Load continuous time series
df_ts = pd.read_csv('data/time_series_data.csv')
df_ts['SocialCapital_inter'] = df_ts['CopperGold_inter'] + df_ts['Amber_inter'] + df_ts['MonumentCount_inter']

# Identify peak
peak_bce = df_cap.loc[df_cap['SocialCapital'] == df_cap['SocialCapital'].max()]
print("Peak in capital.csv:")
print(peak_bce[['BCE', 'group', 'ZCU_AU', 'Zamber', 'ZMonument', 'SocialCapital']])

print("\nPrevious interval (1500 BCE):")
print(df_cap.loc[df_cap['BCE'] == 1500, ['BCE', 'group', 'ZCU_AU', 'Zamber', 'ZMonument', 'SocialCapital']])

print("\nPeak interval changes (1500 BCE -> 1400 BCE):")
row_1500 = df_cap.loc[df_cap['BCE'] == 1500].iloc[0]
row_1400 = df_cap.loc[df_cap['BCE'] == 1400].iloc[0]
for col in ['ZCU_AU', 'ZMonument', 'Zamber', 'SocialCapital']:
    diff = row_1400[col] - row_1500[col]
    print(f"  {col}: {row_1500[col]:.3f} -> {row_1400[col]:.3f} (change: {diff:+.3f})")

print("\nSubsequent interval (1200 BCE):")
print(df_cap.loc[df_cap['BCE'] == 1200, ['BCE', 'group', 'ZCU_AU', 'Zamber', 'ZMonument', 'SocialCapital']])
