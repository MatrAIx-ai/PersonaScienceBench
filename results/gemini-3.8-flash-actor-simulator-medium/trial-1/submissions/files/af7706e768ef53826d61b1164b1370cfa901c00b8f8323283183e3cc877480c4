import pandas as pd
import numpy as np

# Load datasets
niche_df = pd.read_csv('data/invaded_niche_pathways.csv', sep='\t')
temporal_df = pd.read_csv('data/temporal_trends_contingency_table.csv', sep='\t')
species_df = pd.read_csv('data/invasion_success_pathways.csv')

# 1. Summary of gardening pathway by habitat
hab_summary = niche_df.groupby('habitat').agg(
    plots=('n.gard', 'count'),
    mean_n_gard=('n.gard', 'mean'),
    std_n_gard=('n.gard', 'std'),
    prop_plots_with_gard=('n.gard', lambda x: (x > 0).mean()),
    sum_gard=('n.gard', 'sum'),
    sum_unint=('n.unint', 'sum'),
    sum_agfo=('n.agfo', 'sum'),
    sum_total=('n.total', 'sum'),
    mean_elevation=('elevation', 'mean'),
    mean_temp=('annual.temperature', 'mean'),
    mean_urban_500m=('urban.2009.500m', 'mean')
)

hab_summary['pct_gard_of_total'] = 100.0 * hab_summary['sum_gard'] / hab_summary['sum_total']
hab_summary['pct_unint_of_total'] = 100.0 * hab_summary['sum_unint'] / hab_summary['sum_total']
hab_summary['pct_agfo_of_total'] = 100.0 * hab_summary['sum_agfo'] / hab_summary['sum_total']

print("=== HABITAT SUMMARY ===")
print(hab_summary.sort_values(by='mean_n_gard', ascending=False).to_string())

# 2. Correlation with environmental and landscape factors
corrs = niche_df[['n.gard', 'n.unint', 'n.total', 'elevation', 'annual.temperature', 
                  'urban.2009.500m', 'cropland.2009.500m', 'distance.stream', 'distance.road']].corr()
print("\n=== CORRELATIONS WITH N.GARD ===")
print(corrs['n.gard'].to_string())

# 3. Temporal trends
print("\n=== TEMPORAL CONTINGENCY TABLE ===")
print(temporal_df.to_string())

# 4. Species functional traits by pathway
traits_summary = species_df.groupby('intro.pathway').agg(
    n_species=('Scientific_name', 'count'),
    mean_plots=('number.of.invaded.plots', 'mean'),
    median_plots=('number.of.invaded.plots', 'median'),
    mean_mrt=('mrt', 'mean'),
    mean_height=('height', 'mean')
)
print("\n=== SPECIES TRAITS SUMMARY ===")
print(traits_summary.to_string())
