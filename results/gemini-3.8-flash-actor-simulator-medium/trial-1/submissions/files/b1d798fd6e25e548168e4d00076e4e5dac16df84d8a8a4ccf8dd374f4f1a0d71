import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf

def run_analysis():
    # Load dataset
    df = pd.read_csv('data/nls_raw.csv')
    
    # Coding race cohorts
    df['black'] = (df['Racial/ethnic cohort, 1979'] == 1).astype(int)
    df['hispanic'] = (df['Racial/ethnic cohort, 1979'] == 2).astype(int)
    df['white'] = (df['Racial/ethnic cohort, 1979'] == 3).astype(int)
    
    # Educational outcomes
    # BA degree completion (grade >= 16)
    df['ba'] = np.where(df['Highest grade completed, 1979'].isna(), np.nan, (df['Highest grade completed, 1979'] >= 16).astype(float))
    # Higher education / college entry (grade >= 13)
    df['some_college'] = np.where(df['Highest grade completed, 1979'].isna(), np.nan, (df['Highest grade completed, 1979'] >= 13).astype(float))
    # Years of completed education
    df['grade'] = np.where(df['Highest grade completed, 1979'] > 20, np.nan, df['Highest grade completed, 1979'])
    
    # Incarceration status
    df['incarcerated'] = ((df['Ever been sentenced in any correctional institution before 1980'] == 1) | 
                          (df['Ever convicted of an illegal act in adult court before 1980'] == 1) |
                          (df['Type of residence respondent is living in, 1981'] == 5)).astype(int)
    
    # Academic performance (ASVAB and class rank)
    asvab_cols = [
        'ASVAB - Arithmetic Reasoning Z Score (rounded), 1981',
        'ASVAB - Word Knowledge Z Score (rounded), 1981',
        'ASVAB - Paragraph Comprehension Z Score (rounded), 1981',
        'ASVAB - Mathematics Knowledge Z Score (rounded), 1981'
    ]
    df['asvab'] = df[asvab_cols].mean(axis=1)
    
    # Time preference / savings behavior
    df['savings_positive'] = (df['Was more money put into or taken out of R/spouse savings since last interview, 1989'] == 1).astype(float)
    
    # Parental SES
    df['parent_ed'] = df[['Highest grade completed by respondent\'s mother, 1979', 
                           'Highest grade completed by respondent\'s father, 1979']].max(axis=1)
    df['income_79'] = df['Total net family income, previous calendar year, 1979']
    
    # Non-black non-hispanic vs black subsample
    df_bw = df[df['Racial/ethnic cohort, 1979'].isin([1, 3])].copy()
    
    # SES indicators
    df_bw['ses_tertile'] = pd.qcut(df_bw['income_79'].dropna(), q=3, labels=['Low', 'Medium', 'High'])
    df_bw['income_std'] = (df_bw['income_79'] - df_bw['income_79'].mean()) / df_bw['income_79'].std()
    df_bw['ped_std'] = (df_bw['parent_ed'] - df_bw['parent_ed'].mean()) / df_bw['parent_ed'].std()
    df_bw['ses_index'] = df_bw[['income_std', 'ped_std']].mean(axis=1)
    
    rename_dict = {
        'Age of respondent, 1979': 'age',
        'Sex of respondent, 1979': 'sex'
    }
    df_bw = df_bw.rename(columns=rename_dict)
    
    print("=== SUMMARY STATISTICS ===")
    print(f"Total Black respondents: {(df_bw['black']==1).sum()}")
    print(f"Total Non-Black Non-Hispanic respondents: {(df_bw['black']==0).sum()}")
    
    print("\n=== BA DEGREE COMPLETION BY SES TERTILE ===")
    tert_ba = df_bw.groupby(['ses_tertile', 'black'], observed=False)['ba'].agg(['count', 'sum', 'mean'])
    print(tert_ba)
    
    print("\n=== SOME COLLEGE (>=13) BY SES TERTILE ===")
    tert_sc = df_bw.groupby(['ses_tertile', 'black'], observed=False)['some_college'].agg(['count', 'sum', 'mean'])
    print(tert_sc)
    
    print("\n=== OLS REGRESSION: HIGHER EDUCATION ON BLACK * SES ===")
    m_ols_sc = smf.ols('some_college ~ black * ses_index + age + C(sex) + asvab + incarcerated + savings_positive', data=df_bw).fit()
    print(m_ols_sc.summary().tables[1])
    
    print("\n=== LOGIT REGRESSION: HIGHER EDUCATION ON BLACK * SES ===")
    m_logit_sc = smf.logit('some_college ~ black * ses_index + age + C(sex) + asvab + incarcerated + savings_positive', data=df_bw).fit()
    print(m_logit_sc.summary().tables[1])
    
    print("\n=== OLS REGRESSION: BA DEGREE ON BLACK * SES ===")
    m_ols_ba = smf.ols('ba ~ black * ses_index + age + C(sex) + asvab + incarcerated + savings_positive', data=df_bw).fit()
    print(m_ols_ba.summary().tables[1])

if __name__ == '__main__':
    run_analysis()
