"""Model-free tabular optimistic Q-learning with variance-stabilized credit assignment.

This module implements an online finite-horizon optimistic Q-learning variant
designed to minimize cumulative regret while strictly abiding by the O(H*S*A)
space complexity constraint.

Core methodological mechanisms:
1. Online Welford variance tracking of the Bellman target r + V_{h+1}(s') to
   maintain centered second-moment empirical confidence bounds (Bernstein bonus).
2. Episodic trace credit propagation: a bounded O(H) episode trace is maintained
   and updated in reverse Bellman order (backward pass from step H down to 1),
   immediately propagating downstream credit without multi-episode lag.
3. Convex combination of 1-step bootstrap target and empirical Monte Carlo return
   from the observed trajectory, drastically mitigating target drift burn-in.
4. Strict horizon-indexed value clipping within [0, H - h + 1].
"""

from __future__ import annotations

from typing import Any
import numpy as np


class OptimisticTraceBernsteinAgent:
    """Tabular optimistic Q-learning agent with episodic trace and Bernstein confidence."""

    def __init__(
        self,
        env_spec: dict[str, Any],
        seed: int,
        c_sigma: float = 0.10,
        c_hoeff: float = 0.05,
        lam: float = 0.25,
    ) -> None:
        self.H = int(env_spec["H"])
        self.S = int(env_spec["S"])
        self.A = int(env_spec["A"])
        self.rng = np.random.default_rng(int(seed))

        # Hyperparameters for optimism and target fusion
        self.c_sigma = float(c_sigma)
        self.c_hoeff = float(c_hoeff)
        self.lam = float(lam)

        # Tabular storage: strictly O(H * S * A)
        # Indexed by stage h in {1, ..., H}
        self.Q = np.zeros((self.H + 1, self.S, self.A), dtype=np.float64)
        for h in range(1, self.H + 1):
            self.Q[h].fill(float(self.H - h + 1.0))

        self.N = np.zeros((self.H + 1, self.S, self.A), dtype=np.int64)
        self.mean_target = np.zeros((self.H + 1, self.S, self.A), dtype=np.float64)
        self.m2_target = np.zeros((self.H + 1, self.S, self.A), dtype=np.float64)

        # Bounded episode trace: strictly O(H)
        self.trace: list[tuple[int, int, int, float, int, bool]] = []

    def act(self, h: int, state: int) -> int:
        """Select action optimistically with uniform tie-breaking among maximal Q values."""
        q_vals = self.Q[h, state]
        max_q = float(np.max(q_vals))
        best_actions = np.where(np.abs(q_vals - max_q) < 1e-9)[0]
        if len(best_actions) == 1:
            return int(best_actions[0])
        return int(self.rng.choice(best_actions))

    def observe(
        self,
        h: int,
        state: int,
        action: int,
        reward: float,
        next_state: int,
        done: bool,
    ) -> None:
        """Record transition and perform backward trace credit assignment upon episode termination."""
        self.trace.append((int(h), int(state), int(action), float(reward), int(next_state), bool(done)))
        if done or h >= self.H:
            self._flush_episode_trace()

    def _flush_episode_trace(self) -> None:
        """Process observed trajectory backwards to update value functions with fresh downstream targets."""
        trace_len = len(self.trace)
        if trace_len == 0:
            return

        # Compute empirical return-to-go along the visited path: G_i = sum_{j=i}^{T-1} r_j
        returns = [0.0] * trace_len
        running_g = 0.0
        for i in reversed(range(trace_len)):
            running_g += self.trace[i][3]
            returns[i] = running_g

        # Backward Bellman updates along the visited trajectory
        for i in reversed(range(trace_len)):
            th, ts, ta, tr, tnext, tdone = self.trace[i]
            self.N[th, ts, ta] += 1
            t = int(self.N[th, ts, ta])

            # Theoretical visit-dependent learning rate alpha_t = (H + 1) / (H + t)
            alpha = (self.H + 1.0) / (self.H + float(t))

            # Downstream continuation value from stage th + 1
            if tdone or th >= self.H:
                v_next = 0.0
            else:
                v_next = float(np.max(self.Q[th + 1, tnext]))
                v_next = min(float(self.H - th), max(0.0, v_next))

            target_1step = tr + v_next

            # Online Welford update for empirical target variance
            delta = target_1step - self.mean_target[th, ts, ta]
            self.mean_target[th, ts, ta] += delta / float(t)
            delta2 = target_1step - self.mean_target[th, ts, ta]
            self.m2_target[th, ts, ta] += delta * delta2
            var = (self.m2_target[th, ts, ta] / float(t - 1)) if t > 1 else 1.0
            var = max(0.0, var)

            # Convex combination between 1-step bootstrap and empirical multi-step return
            target_fused = (1.0 - self.lam) * target_1step + self.lam * returns[i]

            # Bernstein confidence bonus
            iota = float(np.log(max(2.0, float(t))))
            bonus = self.c_sigma * np.sqrt(var * iota / float(t)) + self.c_hoeff * float(
                self.H - th + 1.0
            ) * iota / float(t)

            target = target_fused + bonus
            max_bound = float(self.H - th + 1.0)
            updated_val = (1.0 - alpha) * self.Q[th, ts, ta] + alpha * target
            self.Q[th, ts, ta] = min(max_bound, max(0.0, updated_val))

        self.trace.clear()


def make_agent(env_spec: dict[str, Any], seed: int) -> OptimisticTraceBernsteinAgent:
    """Instantiate a low-regret optimistic Q-learning agent."""
    return OptimisticTraceBernsteinAgent(env_spec, seed)
