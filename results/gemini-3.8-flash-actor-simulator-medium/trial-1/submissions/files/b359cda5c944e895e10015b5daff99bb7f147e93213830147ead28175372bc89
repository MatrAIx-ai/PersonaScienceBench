import pandas as pd
import numpy as np

# Load dataset
df = pd.read_csv('data/nls_incarceration_processed.csv')

# Filter for black females
bf = df[(df['race'] == 'black') & (df['sex'] == 'female')].copy()

print(f"Total Black Females: {len(bf)}")
print(f"Subgroups by ever_jailed:\n{bf['ever_jailed'].value_counts()}\n")

wealth_cols = ['composite_wealth_1985', 'composite_wealth_1990', 'composite_wealth_1996']
years = [1985, 1990, 1996]

def compute_stats(data, group_name="All Black Females"):
    stats = {}
    stats['Group'] = group_name
    stats['N'] = len(data)
    for col, yr in zip(wealth_cols, years):
        stats[f'Median_{yr}'] = data[col].median()
        stats[f'Mean_{yr}'] = data[col].mean()
        stats[f'IQR_{yr}'] = data[col].quantile(0.75) - data[col].quantile(0.25)
        stats[f'Q25_{yr}'] = data[col].quantile(0.25)
        stats[f'Q75_{yr}'] = data[col].quantile(0.75)
    
    # 1985-1990
    med_diff_85_90 = stats['Median_1990'] - stats['Median_1985']
    stats['Diff_85_90'] = med_diff_85_90
    stats['Annual_85_90'] = med_diff_85_90 / 5.0
    stats['Pct_85_90'] = (med_diff_85_90 / stats['Median_1985'] * 100) if stats['Median_1985'] != 0 else np.nan

    # 1990-1996
    med_diff_90_96 = stats['Median_1996'] - stats['Median_1990']
    stats['Diff_90_96'] = med_diff_90_96
    stats['Annual_90_96'] = med_diff_90_96 / 6.0
    stats['Pct_90_96'] = (med_diff_90_96 / stats['Median_1990'] * 100) if stats['Median_1990'] != 0 else np.nan

    # Overall 1985-1996
    med_diff_85_96 = stats['Median_1996'] - stats['Median_1985']
    stats['Diff_85_96'] = med_diff_85_96
    stats['Annual_85_96'] = med_diff_85_96 / 11.0
    stats['Pct_85_96'] = (med_diff_85_96 / stats['Median_1985'] * 100) if stats['Median_1985'] != 0 else np.nan

    return stats

res_all = compute_stats(bf, "All Black Females")
res_never = compute_stats(bf[bf['ever_jailed'] == 0], "Never Jailed Black Females")
res_jailed = compute_stats(bf[bf['ever_jailed'] == 1], "Ever Jailed Black Females")

df_results = pd.DataFrame([res_all, res_never, res_jailed])
print("Comprehensive Analysis Results:")
print(df_results.to_string())

# Print out clear summary table
print("\n" + "="*50)
print("SUMMARY TABLE:")
for res in [res_all, res_never, res_jailed]:
    print(f"\n--- {res['Group']} (N = {res['N']}) ---")
    print(f"1985 Median Wealth: ${res['Median_1985']:,.2f} (Mean: ${res['Mean_1985']:,.2f})")
    print(f"1990 Median Wealth: ${res['Median_1990']:,.2f} (Mean: ${res['Mean_1990']:,.2f})")
    print(f"1996 Median Wealth: ${res['Median_1996']:,.2f} (Mean: ${res['Mean_1996']:,.2f})")
    print(f"1985-1990 Increase: Total = ${res['Diff_85_90']:,.2f}, Annualized = ${res['Annual_85_90']:,.2f}/yr, Pct = {res['Pct_85_90']:.2f}%")
    print(f"1990-1996 Increase: Total = ${res['Diff_90_96']:,.2f}, Annualized = ${res['Annual_90_96']:,.2f}/yr, Pct = {res['Pct_90_96']:.2f}%")
