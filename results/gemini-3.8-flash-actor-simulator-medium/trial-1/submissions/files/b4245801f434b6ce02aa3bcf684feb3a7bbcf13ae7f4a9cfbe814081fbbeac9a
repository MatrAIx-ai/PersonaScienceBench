#!/usr/bin/env python3
"""
Analysis script for BixBench bix-9-q5:
Differential expression comparison across tissues for bad responders vs controls.
Dataset: data/Data_deposition_RNAseq_Paroxetine_2017.xlsx
"""

import sys
import pandas as pd
import numpy as np

def run_analysis(file_path="data/Data_deposition_RNAseq_Paroxetine_2017.xlsx"):
    print(f"Loading data from {file_path}...")
    df = pd.read_excel(file_path, sheet_name="NormCount", header=None)

    # Tissue comparisons:
    # Comparison 2: baseline_blood (Control vs bad_responder)
    # Comparison 5: dentate_gyrus (Control vs bad_responder)
    # Comparison 8: final_blood (Control vs bad_responder)
    comparisons = {
        "baseline_blood": {
            "comp_idx": 2,
            "base_col": 107,
            "display_name": "Baseline blood"
        },
        "dentate_gyrus": {
            "comp_idx": 5,
            "base_col": 134,
            "display_name": "Dentate gyrus"
        },
        "final_blood": {
            "comp_idx": 8,
            "base_col": 161,
            "display_name": "Final blood"
        }
    }

    results = []

    for tissue_key, info in comparisons.items():
        base_col = info["base_col"]
        gene_ids = df.iloc[4:, 1]
        base_mean = pd.to_numeric(df.iloc[4:, base_col], errors="coerce")
        base_mean_a = pd.to_numeric(df.iloc[4:, base_col + 1], errors="coerce")
        base_mean_b = pd.to_numeric(df.iloc[4:, base_col + 2], errors="coerce")
        fc = pd.to_numeric(df.iloc[4:, base_col + 3], errors="coerce")
        lfc = pd.to_numeric(df.iloc[4:, base_col + 4], errors="coerce")
        pval = pd.to_numeric(df.iloc[4:, base_col + 5], errors="coerce")
        padj = pd.to_numeric(df.iloc[4:, base_col + 6], errors="coerce")
        max_deg = df.iloc[4:, base_col + 7]
        med_deg = df.iloc[4:, base_col + 8]

        # Criteria:
        # Criterion 1: padj < 0.05, basemean > 10, lfc > 0.5 (strictly upregulated)
        c1 = (padj < 0.05) & (base_mean > 10) & (lfc > 0.5)

        # Criterion 2: padj < 0.05, basemean > 10, |lfc| > 0.5 (bidirectional DEG)
        c2 = (padj < 0.05) & (base_mean > 10) & (lfc.abs() > 0.5)

        # Criterion 3: Author Max DEG, basemean > 10, lfc > 0.5
        c3 = (max_deg == "U") & (base_mean > 10) & (lfc > 0.5)

        # Criterion 4: Author Median DEG, basemean > 10, lfc > 0.5
        c4 = (med_deg == "U") & (base_mean > 10) & (lfc > 0.5)

        # Criterion 5: padj < 0.1, basemean > 10, lfc > 0.5
        c5 = (padj < 0.1) & (base_mean > 10) & (lfc > 0.5)

        # Criterion 6: No padj cutoff, basemean > 10, lfc > 0.5
        c6 = (base_mean > 10) & (lfc > 0.5)

        results.append({
            "Tissue": info["display_name"],
            "Key": tissue_key,
            "Comparison": f"Comparison {info['comp_idx']}",
            "N_genes_padj005_lfc05_bm10": int(c1.sum()),
            "N_genes_padj005_abslfc05_bm10": int(c2.sum()),
            "N_genes_MaxDEG_lfc05_bm10": int(c3.sum()),
            "N_genes_MedDEG_lfc05_bm10": int(c4.sum()),
            "N_genes_padj010_lfc05_bm10": int(c5.sum()),
            "N_genes_unadjusted_lfc05_bm10": int(c6.sum())
        })

    res_df = pd.DataFrame(results)
    print("\n--- Summary of Differentially Expressed Genes by Tissue ---")
    print(res_df.to_string(index=False))

    # Identify tissue with maximum DEG
    max_tissue = res_df.loc[res_df["N_genes_padj005_lfc05_bm10"].idxmax(), "Tissue"]
    max_key = res_df.loc[res_df["N_genes_padj005_lfc05_bm10"].idxmax(), "Key"]
    print(f"\nConclusion: Tissue with highest number of DEGs is: {max_tissue} ({max_key})")

    return res_df

if __name__ == "__main__":
    run_analysis()
