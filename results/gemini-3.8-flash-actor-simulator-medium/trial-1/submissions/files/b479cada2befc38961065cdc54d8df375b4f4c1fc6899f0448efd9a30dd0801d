"""Analysis script to determine the proportion of studies in Experimental Economics conducted in a lab setting."""
import pandas as pd
import json

def analyze_lab_proportion():
    # Load study metadata dataset
    study_file = 'data/meta-regression_study_data_heterogeneity_in_replication_projects.csv'
    df = pd.read_csv(study_file)
    
    # Filter for Experimental Economics studies
    ee_df = df[df['project'] == 'ee'].copy()
    
    # Check original studies
    n_original = len(ee_df)
    n_orig_online = int(ee_df['online.o'].sum())
    n_orig_lab = int((ee_df['online.o'] == 0).sum())
    prop_orig_lab = n_orig_lab / n_original if n_original > 0 else 0
    
    # Check replication studies
    n_replication = len(ee_df)
    n_rep_online = int(ee_df['online.r'].sum())
    n_rep_lab = int((ee_df['online.r'] == 0).sum())
    prop_rep_lab = n_rep_lab / n_replication if n_replication > 0 else 0
    
    # Pooled analysis
    n_total = n_original + n_replication
    n_total_lab = n_orig_lab + n_rep_lab
    prop_total_lab = n_total_lab / n_total if n_total > 0 else 0
    
    # US Lab distribution
    us_lab_orig = ee_df['us_lab.o'].value_counts().to_dict()
    us_lab_rep = ee_df['us_lab.r'].value_counts().to_dict()
    
    # Experiment country distribution
    countries_orig = ee_df['experiment_country.o'].value_counts().to_dict()
    countries_rep = ee_df['experiment_country.r'].value_counts().to_dict()
    
    results = {
        'n_study_pairs': len(ee_df),
        'original_studies': {
            'total': n_original,
            'lab_count': n_orig_lab,
            'online_count': n_orig_online,
            'lab_proportion': prop_orig_lab,
            'us_lab_breakdown': us_lab_orig,
            'countries': countries_orig
        },
        'replication_studies': {
            'total': n_replication,
            'lab_count': n_rep_lab,
            'online_count': n_rep_online,
            'lab_proportion': prop_rep_lab,
            'us_lab_breakdown': us_lab_rep,
            'countries': countries_rep
        },
        'pooled_studies': {
            'total': n_total,
            'lab_count': n_total_lab,
            'lab_proportion': prop_total_lab
        }
    }
    
    print(json.dumps(results, indent=2))
    return results

if __name__ == '__main__':
    analyze_lab_proportion()
