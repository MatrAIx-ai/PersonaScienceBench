import pandas as pd
import numpy as np

# Load data
df_cap = pd.read_csv('data/capital.csv')
for col in df_cap.columns:
    if col not in ['BCE', 'group', 'color']:
        df_cap[col] = df_cap[col].astype(str).str.replace(',', '.').astype(float)

# Filter 3400 BCE to 3000 BCE
period = df_cap[(df_cap['BCE'] <= 3400) & (df_cap['BCE'] >= 3000)].sort_values('BCE', ascending=False).reset_index(drop=True)

print("=== CAPITAL METRICS (3400 - 3000 BCE) ===")
cols_to_show = ['BCE', 'ZAxtSchwert', 'ZDolch', 'Zhausgr', 'ZMonument', 'ZBeil', 'ZHort', 'ZCU_AU', 'Zamber', 'ZMW', 'ZKeform', 'Zkeverz']
print(period[cols_to_show].to_string())

# Capital groups defined by researcher:
# Symbolic Capital: ZAxtSchwert (Hatchet/Sword), ZDolch (Dagger), Zhausgr (House Size)
# Social Capital: ZCU_AU (Copper/Gold), Zamber (Amber), ZMonument (Monument Count)
# Cultural Capital: ZKeform (Pottery Form), Zkeverz (Pottery Decoration)
# Economic Capital: ZHort (Depot), ZSichel (Sickle), ZBeil (Axes & Celts), ZMW (Monument Size)

# Correlation matrix
print("\n=== CORRELATION MATRIX (3400 - 3000 BCE) ===")
corr = period[['ZMonument', 'ZBeil', 'ZAxtSchwert', 'ZDolch', 'Zhausgr', 'ZHort', 'ZCU_AU', 'Zamber', 'ZKeform', 'Zkeverz', 'ZMW']].corr()
print(corr[['ZMonument', 'ZBeil']].to_string())

# Pollen and population proxy from time_series_data
df_ts = pd.read_csv('data/time_series_data.csv')
pollen_sub = df_ts[df_ts['CE'].isin([-3400, -3300, -3200, -3100, -3000])][['CE', 'pollen_inter', 'pollen_inter_100', 'pollen_grate_100', 'kde_all_mean']].sort_values('CE', ascending=True)
pollen_sub['BCE'] = -pollen_sub['CE']
print("\n=== POLLEN OPENNESS & KDE METRICS ===")
print(pollen_sub[['BCE', 'pollen_inter', 'pollen_inter_100', 'pollen_grate_100', 'kde_all_mean']].to_string(index=False))

