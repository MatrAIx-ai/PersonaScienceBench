import pandas as pd

def main():
    # Load dataset
    filepath = 'data/meta-regression_study_data_heterogeneity_in_replication_projects.csv'
    df = pd.read_csv(filepath)
    
    # Filter Experimental Economics studies
    ee = df[df['project'] == 'ee']
    n_total = len(ee)
    
    # Lab setting is indicated by non-online setting (online.o == 0 / online.r == 0)
    n_lab_orig = int((ee['online.o'] == 0).sum())
    prop_lab_orig = n_lab_orig / n_total
    
    n_lab_repl = int((ee['online.r'] == 0).sum())
    prop_lab_repl = n_lab_repl / n_total
    
    us_lab_orig = int((ee['us_lab.o'] == 1).sum())
    non_us_lab_orig = int((ee['us_lab.o'] == 0).sum())
    
    print(f"Total Experimental Economics studies: {n_total}")
    print(f"Original studies in lab setting: {n_lab_orig}/{n_total} (proportion: {prop_lab_orig:.4f}, {prop_lab_orig*100:.1f}%)")
    print(f"Replication studies in lab setting: {n_lab_repl}/{n_total} (proportion: {prop_lab_repl:.4f}, {prop_lab_repl*100:.1f}%)")
    print(f"Original US lab vs non-US lab: {us_lab_orig} vs {non_us_lab_orig}")

if __name__ == '__main__':
    main()
