#!/usr/bin/env python3
"""
Analysis script for BixBench bix-22-q6:
When examining protein-coding genes only, what is the pearson correlation coefficient
between gene length and gene expression?
"""

import os
import sys
import numpy as np
import pandas as pd
from scipy import stats

def main():
    meta_path = "data/GeneMetaInfo_Zenodo.csv"
    counts_path = "data/BatchCorrectedReadCounts_Zenodo.csv"
    sample_path = "data/Sample_annotated_Zenodo.csv"

    print("Loading gene metadata...")
    df_meta = pd.read_csv(meta_path)
    print(f"Total genes in metadata: {len(df_meta)}")

    # Filter for protein-coding genes
    pc_mask = df_meta["gene_biotype"] == "protein_coding"
    df_pc_meta = df_meta[pc_mask].copy()
    print(f"Number of protein-coding genes: {len(df_pc_meta)}")

    # Load counts table
    print("Loading batch-corrected read counts...")
    df_counts = pd.read_csv(counts_path)
    print(f"Counts matrix shape: {df_counts.shape}")

    # Verify gene alignment
    gene_col = df_counts.columns[0]
    sample_cols = df_counts.columns[1:]
    assert (df_meta["Geneid"] == df_counts[gene_col]).all(), "Gene IDs do not match perfectly!"

    # Extract protein-coding counts and lengths
    pc_counts = df_counts.loc[pc_mask, sample_cols].values
    pc_lengths = df_pc_meta["Length"].values

    print(f"Protein-coding length stats - Min: {pc_lengths.min()}, Max: {pc_lengths.max()}, "
          f"Mean: {pc_lengths.mean():.2f}, Median: {np.median(pc_lengths):.2f}")

    # 1. Baseline Primary Analysis: Mean across all samples
    mean_expr = pc_counts.mean(axis=1)
    sum_expr = pc_counts.sum(axis=1)
    r_mean, p_mean = stats.pearsonr(pc_lengths, mean_expr)
    r_sum, p_sum = stats.pearsonr(pc_lengths, sum_expr)

    # 2. Robustness Variant A: Median across all samples
    median_expr = np.median(pc_counts, axis=1)
    r_median, p_median = stats.pearsonr(pc_lengths, median_expr)

    # 3. Robustness Variant B: log2(mean_expr + 1) vs Length
    log2_mean_expr = np.log2(mean_expr + 1)
    r_log_mean, p_log_mean = stats.pearsonr(pc_lengths, log2_mean_expr)

    # 4. Robustness Variant C: log2(mean_expr + 1) vs log2(Length)
    log2_lengths = np.log2(pc_lengths)
    r_log_log, p_log_log = stats.pearsonr(log2_lengths, log2_mean_expr)

    # 5. Robustness Variant D: Mean of per-sample Pearson correlations
    per_sample_rs = [stats.pearsonr(pc_lengths, pc_counts[:, i])[0] for i in range(pc_counts.shape[1])]
    mean_sample_r = np.mean(per_sample_rs)

    # Summary report
    print("\n" + "="*50)
    print("CORRELATION ANALYSIS RESULTS:")
    print("="*50)
    print(f"Baseline (Length vs Mean Expression Count): r = {r_mean:.6f} (p-value = {p_mean:.4e})")
    print(f"Invariant check (Length vs Sum Expression Count): r = {r_sum:.6f} (p-value = {p_sum:.4e})")
    print(f"Variant A (Length vs Median Expression Count): r = {r_median:.6f} (p-value = {p_median:.4e})")
    print(f"Variant B (Length vs log2(Mean Expression + 1)): r = {r_log_mean:.6f} (p-value = {p_log_mean:.4e})")
    print(f"Variant C (log2(Length) vs log2(Mean Expression + 1)): r = {r_log_log:.6f} (p-value = {p_log_log:.4e})")
    print(f"Variant D (Average of per-sample r across {len(per_sample_rs)} samples): r = {mean_sample_r:.6f}")
    print("="*50)

    # Save results to a summary file as well
    with open("correlation_results.txt", "w") as out:
        out.write(f"Baseline Pearson r (Length vs Mean Count): {r_mean:.6f}\n")
        out.write(f"P-value: {p_mean}\n")
        out.write(f"Number of protein-coding genes: {len(df_pc_meta)}\n")
        out.write(f"Variant Length vs Median Count: {r_median:.6f}\n")
        out.write(f"Variant Length vs log2(Mean Count + 1): {r_log_mean:.6f}\n")
        out.write(f"Variant log2(Length) vs log2(Mean Count + 1): {r_log_log:.6f}\n")
        out.write(f"Variant Mean of sample-level correlations: {mean_sample_r:.6f}\n")

if __name__ == "__main__":
    main()
