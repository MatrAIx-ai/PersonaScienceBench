import pandas as pd
import numpy as np

# Load proteomic data
file_path = 'data/Proteomic_data .xlsx'
sheet_name = 'Tumor vs Normal'
df = pd.read_excel(file_path, sheet_name=sheet_name)

# Locate ENO1
eno1_rows = df[df['gene'] == 'ENO1']
print(f"Number of ENO1 entries: {len(eno1_rows)}")
print(eno1_rows[['protein', 'Description', 'gene', 'Normal', 'Tumor', 'FC', 'log2FC', 'p.value']])

# Extract normal level
normal_val = eno1_rows['Normal'].values[0]
print(f"Raw Normal value: {normal_val}")

# Round to 3 significant figures
# In scientific notation:
sci_3sig = f"{normal_val:.3g}"
# In float / integer representation:
val_3sig = float(f"{normal_val:.3g}")
print(f"Formatted (3 sig figs, scientific/general): {sci_3sig}")
print(f"Formatted (3 sig figs, numeric standard): {val_3sig:.0f}")

with open('result.txt', 'w') as f:
    f.write(f"Raw: {normal_val}\n")
    f.write(f"3_sig_figs: {sci_3sig}\n")
    f.write(f"3_sig_figs_int: {val_3sig:.0f}\n")

