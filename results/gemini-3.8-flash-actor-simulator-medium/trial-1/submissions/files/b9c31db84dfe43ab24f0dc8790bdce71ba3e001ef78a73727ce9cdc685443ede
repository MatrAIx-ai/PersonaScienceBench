import pandas as pd
import numpy as np
from scipy import stats

# Load data
df = pd.read_csv('data/meta-regression_joined_data_heterogeneity_in_replication_projects.csv')

def summarize_domain(sub, name):
    n = len(sub)
    ro = sub['ro']
    rr = sub['rr']
    fiso = sub['fiso']
    fisr = sub['fisr']
    rel_es = sub['relative_es']
    
    diff_r = ro - rr
    diff_fis = fiso - fisr
    prop_gt = (diff_r > 0).mean()
    
    t_stat_r, p_val_r = stats.ttest_rel(ro, rr)
    w_stat_r, p_val_w = stats.wilcoxon(ro, rr)
    
    return {
        'Domain': name,
        'N': n,
        'Original_r_mean': ro.mean(),
        'Replication_r_mean': rr.mean(),
        'Diff_r_mean': diff_r.mean(),
        'Diff_r_median': diff_r.median(),
        'Prop_ro_gt_rr': prop_gt,
        'p_val_paired_t': p_val_r,
        'p_val_wilcoxon': p_val_w,
        'Mean_relative_es': rel_es.mean(),
        'Median_relative_es': rel_es.median()
    }

results = []
results.append(summarize_domain(df, 'All Domains'))
for disc in ['Cognitive', 'Social', 'Economics']:
    results.append(summarize_domain(df[df['discipline'] == disc], f'Discipline: {disc}'))
for proj in ['Psychology', 'Experimental Economics']:
    results.append(summarize_domain(df[df['project.x'] == proj], f'Project: {proj}'))

res_df = pd.DataFrame(results)
print(res_df.to_string(index=False))
res_df.to_csv('domain_effect_size_comparison.csv', index=False)
