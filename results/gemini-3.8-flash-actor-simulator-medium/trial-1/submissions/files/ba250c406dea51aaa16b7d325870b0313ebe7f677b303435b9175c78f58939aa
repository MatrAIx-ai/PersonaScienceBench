import pandas as pd
import numpy as np

def run_analysis():
    filepath = "data/Proteomic_data .xlsx"
    df = pd.read_excel(filepath, sheet_name="Tumor vs Normal")
    
    # Filter for ENO1
    eno1_row = df[df['gene'] == 'ENO1']
    if eno1_row.empty:
        raise ValueError("ENO1 not found in dataset")
    
    row = eno1_row.iloc[0]
    normal_val = float(row['Normal'])
    tumor_val = float(row['Tumor'])
    ratio_val = float(row['Ratio'])
    
    print("ENO1 Entry:")
    print(f"  Protein: {row['protein']}")
    print(f"  Description: {row['Description']}")
    print(f"  Gene ID: {row['gene_id']}")
    print(f"  Normal: {normal_val}")
    print(f"  Tumor: {tumor_val}")
    print(f"  Ratio: {ratio_val}")
    
    # Rounding to 3 significant figures
    # 72896133.2946858 -> 7.29e7 -> 72900000
    sig3_scientific = f"{normal_val:.3g}"
    sig3_float = float(sig3_scientific)
    sig3_int = int(sig3_float)
    
    print("\nCalculations:")
    print(f"  Raw value: {normal_val}")
    print(f"  3 sig figs (scientific): {sig3_scientific}")
    print(f"  3 sig figs (standard integer): {sig3_int}")
    print(f"  Formatted with standard exponential: {normal_val:.2e}")
    
    return normal_val, sig3_int, sig3_scientific

if __name__ == "__main__":
    run_analysis()
