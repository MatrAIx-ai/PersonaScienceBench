import pandas as pd
import numpy as np
from scipy.stats import pearsonr

def main():
    print("Loading data...")
    meta = pd.read_csv("data/GeneMetaInfo_Zenodo.csv", index_col=0)
    counts = pd.read_csv("data/BatchCorrectedReadCounts_Zenodo.csv", index_col=0)
    samples = pd.read_csv("data/Sample_annotated_Zenodo.csv")

    print(f"Total genes in meta: {len(meta)}")
    print(f"Total samples in counts: {counts.shape[1]}")
    print(f"Total samples in metadata: {len(samples)}")

    # Filter protein-coding genes strictly
    pc_mask = meta["gene_biotype"] == "protein_coding"
    meta_pc = meta[pc_mask]
    counts_pc = counts.loc[meta_pc.index]
    lengths = meta_pc["Length"]

    print(f"Protein-coding genes: {len(meta_pc)}")

    # 1. Primary Analysis: Mean raw counts across all samples
    mean_counts = counts_pc.mean(axis=1)
    r_primary, p_primary = pearsonr(lengths, mean_counts)
    print(f"\n--- Primary Analysis ---")
    print(f"Pearson r (Length vs Mean Raw Expression): {r_primary:.6f} (approx: {r_primary:.4f})")
    print(f"p-value: {p_primary:.4e}")

    # 2. Sum raw counts
    sum_counts = counts_pc.sum(axis=1)
    r_sum, p_sum = pearsonr(lengths, sum_counts)
    print(f"Pearson r (Length vs Sum Raw Expression): {r_sum:.6f}")

    # 3. Median raw counts
    median_counts = counts_pc.median(axis=1)
    r_med, p_med = pearsonr(lengths, median_counts)
    print(f"Pearson r (Length vs Median Raw Expression): {r_med:.6f}")

    # 4. Sensitivity: CPM normalized
    lib_sizes = counts.sum(axis=0)
    cpm = (counts_pc / lib_sizes) * 1e6
    mean_cpm = cpm.mean(axis=1)
    r_cpm, p_cpm = pearsonr(lengths, mean_cpm)
    print(f"\n--- Sensitivity Analysis ---")
    print(f"Pearson r (Length vs Mean CPM): {r_cpm:.6f} (approx: {r_cpm:.4f})")
    print(f"p-value: {p_cpm:.4e}")

    # 5. Sensitivity: Log2 transformed
    log2_mean_counts = np.log2(mean_counts + 1)
    r_log, p_log = pearsonr(lengths, log2_mean_counts)
    print(f"Pearson r (Length vs log2(Mean+1)): {r_log:.6f} (approx: {r_log:.4f})")
    print(f"p-value: {p_log:.4e}")

    log2_lengths = np.log2(lengths)
    r_loglog, p_loglog = pearsonr(log2_lengths, log2_mean_counts)
    print(f"Pearson r (log2(Length) vs log2(Mean+1)): {r_loglog:.6f} (approx: {r_loglog:.4f})")

    # 6. Mean per-sample correlation
    sample_rs = [pearsonr(lengths, counts_pc[col])[0] for col in counts_pc.columns]
    print(f"Per-sample Pearson r (raw counts): mean = {np.mean(sample_rs):.6f}, std = {np.std(sample_rs):.6f}, min = {np.min(sample_rs):.6f}, max = {np.max(sample_rs):.6f}")

    # Save summary table
    results = pd.DataFrame([
        {"Method": "Mean Raw Read Counts", "Pearson_r": r_primary, "p_value": p_primary},
        {"Method": "Sum Raw Read Counts", "Pearson_r": r_sum, "p_value": p_sum},
        {"Method": "Median Raw Read Counts", "Pearson_r": r_med, "p_value": p_med},
        {"Method": "Mean CPM", "Pearson_r": r_cpm, "p_value": p_cpm},
        {"Method": "log2(Mean Raw + 1)", "Pearson_r": r_log, "p_value": p_log},
        {"Method": "log2(Length) vs log2(Mean Raw + 1)", "Pearson_r": r_loglog, "p_value": p_loglog},
        {"Method": "Per-sample Mean r (Raw)", "Pearson_r": np.mean(sample_rs), "p_value": np.nan}
    ])
    results.to_csv("correlation_results_summary.csv", index=False)
    print("\nSummary saved to correlation_results_summary.csv")

if __name__ == "__main__":
    main()
