import pandas as pd
import numpy as np
from scipy import stats
import statsmodels.api as sm
import statsmodels.formula.api as smf

df = pd.read_csv('data/nls_incarceration_processed.csv')

print("=== DATASET OVERVIEW ===")
print(f"Total observations: {len(df)}")
print(f"ever_jailed counts:\n{df['ever_jailed'].value_counts()}")
print(f"race counts:\n{df['race'].value_counts()}")
print(f"sex counts:\n{df['sex'].value_counts()}")

years = [1985, 1990, 1996]

results = []

for yr in years:
    col = f'composite_wealth_{yr}'
    g0 = df[df['ever_jailed'] == 0][col]
    g1 = df[df['ever_jailed'] == 1][col]
    
    # Descriptives
    mean_0, std_0, med_0, q25_0, q75_0 = g0.mean(), g0.std(), g0.median(), g0.quantile(0.25), g0.quantile(0.75)
    mean_1, std_1, med_1, q25_1, q75_1 = g1.mean(), g1.std(), g1.median(), g1.quantile(0.25), g1.quantile(0.75)
    
    # Statistical tests
    # Welch's t-test (unequal variances)
    welch = stats.ttest_ind(g1, g0, equal_var=False)
    # Student's t-test
    student = stats.ttest_ind(g1, g0, equal_var=True)
    # Mann-Whitney U test (one-sided: g1 < g0, and two-sided)
    mwu_two = stats.mannwhitneyu(g1, g0, alternative='two-sided')
    mwu_less = stats.mannwhitneyu(g1, g0, alternative='less')
    
    # Median test
    med_test = stats.median_test(g1, g0)
    
    # Linear regressions
    # 1. Unadjusted OLS
    ols_raw = smf.ols(f'{col} ~ ever_jailed', data=df).fit(cov_type='HC3')
    # 2. Adjusted OLS (race + sex)
    ols_adj = smf.ols(f'{col} ~ ever_jailed + C(race) + C(sex)', data=df).fit(cov_type='HC3')
    # Also standard OLS non-robust
    ols_raw_homo = smf.ols(f'{col} ~ ever_jailed', data=df).fit()
    ols_adj_homo = smf.ols(f'{col} ~ ever_jailed + C(race) + C(sex)', data=df).fit()
    
    results.append({
        'year': yr,
        'mean_0': mean_0, 'std_0': std_0, 'med_0': med_0, 'iqr_0': q75_0 - q25_0,
        'mean_1': mean_1, 'std_1': std_1, 'med_1': med_1, 'iqr_1': q75_1 - q25_1,
        'diff_mean': mean_1 - mean_0,
        'welch_t': welch.statistic, 'welch_p': welch.pvalue,
        'student_t': student.statistic, 'student_p': student.pvalue,
        'mwu_stat': mwu_two.statistic, 'mwu_p': mwu_two.pvalue,
        'mwu_less_p': mwu_less.pvalue,
        'med_test_p': med_test[1],
        'raw_coef': ols_raw.params['ever_jailed'],
        'raw_p_hc3': ols_raw.pvalues['ever_jailed'],
        'raw_ci_hc3': (ols_raw.conf_int().loc['ever_jailed', 0], ols_raw.conf_int().loc['ever_jailed', 1]),
        'raw_p_homo': ols_raw_homo.pvalues['ever_jailed'],
        'adj_coef': ols_adj.params['ever_jailed'],
        'adj_p_hc3': ols_adj.pvalues['ever_jailed'],
        'adj_ci_hc3': (ols_adj.conf_int().loc['ever_jailed', 0], ols_adj.conf_int().loc['ever_jailed', 1]),
        'adj_p_homo': ols_adj_homo.pvalues['ever_jailed'],
        'adj_model': ols_adj
    })

print("\n=== SUMMARY TABLE ===")
for r in results:
    print(f"--- Year {r['year']} ---")
    print(f"Non-jailed: Mean=${r['mean_0']:,.2f} (SD=${r['std_0']:,.2f}), Median=${r['med_0']:,.2f} (IQR=${r['iqr_0']:,.2f})")
    print(f"Jailed:     Mean=${r['mean_1']:,.2f} (SD=${r['std_1']:,.2f}), Median=${r['med_1']:,.2f} (IQR=${r['iqr_1']:,.2f})")
    print(f"Mean Difference: ${r['diff_mean']:,.2f}")
    print(f"Welch's t-test: t = {r['welch_t']:.4f}, p = {r['welch_p']:.4e}")
    print(f"Mann-Whitney U: U = {r['mwu_stat']:.1f}, two-sided p = {r['mwu_p']:.4e}, less p = {r['mwu_less_p']:.4e}")
    print(f"Median test p-value: {r['med_test_p']:.4e}")
    print(f"Unadjusted OLS: coef = {r['raw_coef']:,.2f}, HC3 p = {r['raw_p_hc3']:.4e}, Homo p = {r['raw_p_homo']:.4e}")
    print(f"Adjusted OLS (Race + Sex): coef = {r['adj_coef']:,.2f}, HC3 95% CI = [{r['adj_ci_hc3'][0]:,.2f}, {r['adj_ci_hc3'][1]:,.2f}], HC3 p = {r['adj_p_hc3']:.4e}, Homo p = {r['adj_p_homo']:.4e}")
    print()

for r in results:
    print(f"\nDetailed Adjusted Model for {r['year']}:")
    print(r['adj_model'].summary())
