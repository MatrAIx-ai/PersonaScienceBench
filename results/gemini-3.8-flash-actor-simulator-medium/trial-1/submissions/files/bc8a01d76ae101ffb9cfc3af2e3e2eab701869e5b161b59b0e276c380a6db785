"""
Analysis of plant introduction pathways influenced by urban land use.
Dataset: invaded_niche_pathways.csv, invasion_success_pathways.csv, temporal_trends_contingency_table.csv
"""

import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf
from scipy import stats

def run_analysis():
    # 1. Load data
    inv_df = pd.read_csv('data/invaded_niche_pathways.csv', sep='\t')
    succ_df = pd.read_csv('data/invasion_success_pathways.csv')
    temp_df = pd.read_csv('data/temporal_trends_contingency_table.csv', sep='\t')

    # Rename dot notation for formulas
    inv_df.columns = [c.replace('.', '_') for c in inv_df.columns]

    print("=================================================================")
    print("1. DESCRIPTIVE STATISTICS ACROSS INTRODUCTION PATHWAYS")
    print("=================================================================")
    pathways = ['n_gard', 'n_unint', 'n_agfo']
    pathway_names = {
        'n_gard': 'Gardening / Ornamental',
        'n_unint': 'Unintentional / Accidental',
        'n_agfo': 'AgriForest (Agriculture & Forestry)'
    }

    desc = inv_df[pathways + ['n_total']].describe().T
    desc['zero_pct'] = [(inv_df[c] == 0).mean() * 100 for c in desc.index]
    print(desc[['count', 'mean', 'std', 'min', '50%', 'max', 'zero_pct']])

    print("\n=================================================================")
    print("2. HABITAT-SPECIFIC INVASION BY PATHWAY")
    print("=================================================================")
    hab_summary = inv_df.groupby('habitat')[pathways + ['n_total', 'urban_2009_500m']].agg(['mean', 'sum'])
    print(hab_summary)

    print("\n=================================================================")
    print("3. CORRELATIONS BETWEEN URBAN LAND USE AND PATHWAYS")
    print("=================================================================")
    urban_vars = [
        'urban_1956_50m', 'urban_1993_50m', 'urban_2009_50m',
        'urban_1956_500m', 'urban_1993_500m', 'urban_2009_500m',
        'urban_1956_1000m', 'urban_1993_1000m', 'urban_2009_1000m'
    ]
    corr_matrix = inv_df[pathways + ['n_total'] + urban_vars].corr().loc[pathways + ['n_total'], urban_vars]
    print(corr_matrix.round(4))

    print("\n=================================================================")
    print("4. GENERALIZED LINEAR MODELS (GLM - POISSON & NEGATIVE BINOMIAL)")
    print("=================================================================")
    # Univariate models
    uni_results = []
    for p in pathways:
        for u in ['urban_2009_50m', 'urban_2009_500m', 'urban_2009_1000m']:
            # Poisson
            mod_p = smf.glm(f"{p} ~ {u}", data=inv_df, family=sm.families.Poisson()).fit()
            disp = mod_p.pearson_chi2 / mod_p.df_resid
            # Negative Binomial
            mod_nb = smf.glm(f"{p} ~ {u}", data=inv_df, family=sm.families.NegativeBinomial()).fit()
            uni_results.append({
                'pathway': pathway_names[p],
                'urban_scale': u,
                'poi_coef': mod_p.params[u],
                'poi_se': mod_p.bse[u],
                'poi_pval': mod_p.pvalues[u],
                'poi_dispersion': disp,
                'nb_coef': mod_nb.params[u],
                'nb_se': mod_nb.bse[u],
                'nb_pval': mod_nb.pvalues[u],
                'nb_IRR': np.exp(mod_nb.params[u])
            })
    uni_df = pd.DataFrame(uni_results)
    print(uni_df.to_string(index=False))

    print("\n=================================================================")
    print("5. MULTIVARIATE ADJUSTED MODELS (CONTROLLING FOR CROPLAND & ENVIRONMENT)")
    print("=================================================================")
    multi_results = []
    covariates = "cropland_2009_500m + elevation + distance_road + distance_stream + annual_temperature + annual_rainfall"
    for p in pathways:
        f = f"{p} ~ urban_2009_500m + {covariates}"
        mod_p = smf.glm(f, data=inv_df, family=sm.families.Poisson()).fit()
        mod_nb = smf.glm(f, data=inv_df, family=sm.families.NegativeBinomial()).fit()
        
        # Binary logistic model (presence/absence)
        inv_df[f"{p}_bin"] = (inv_df[p] > 0).astype(int)
        f_logit = f"{p}_bin ~ urban_2009_500m + {covariates}"
        mod_logit = smf.logit(f_logit, data=inv_df).fit(disp=False)

        multi_results.append({
            'pathway': pathway_names[p],
            'nb_urban_coef': mod_nb.params['urban_2009_500m'],
            'nb_urban_se': mod_nb.bse['urban_2009_500m'],
            'nb_urban_pval': mod_nb.pvalues['urban_2009_500m'],
            'nb_urban_IRR': np.exp(mod_nb.params['urban_2009_500m']),
            'logit_coef': mod_logit.params['urban_2009_500m'],
            'logit_OR': np.exp(mod_logit.params['urban_2009_500m']),
            'logit_pval': mod_logit.pvalues['urban_2009_500m']
        })
    multi_df = pd.DataFrame(multi_results)
    print(multi_df.to_string(index=False))

    print("\n=================================================================")
    print("6. TEMPORAL TRENDS IN URBAN LAND COVER INFLUENCE (1956, 1993, 2009)")
    print("=================================================================")
    temporal_res = []
    for yr in ['1956', '1993', '2009']:
        u = f"urban_{yr}_500m"
        c = f"cropland_{yr}_500m"
        covs = f"{c} + elevation + distance_road + distance_stream"
        for p in pathways:
            mod = smf.glm(f"{p} ~ {u} + {covs}", data=inv_df, family=sm.families.NegativeBinomial()).fit()
            temporal_res.append({
                'year': yr,
                'pathway': pathway_names[p],
                'coef': mod.params[u],
                'se': mod.bse[u],
                'pval': mod.pvalues[u],
                'IRR': np.exp(mod.params[u])
            })
    print(pd.DataFrame(temporal_res).to_string(index=False))

    print("\n=================================================================")
    print("7. FUNCTIONAL TRAIT COMPARISON ACROSS PATHWAYS (SPECIES LEVEL)")
    print("=================================================================")
    trait_summary = succ_df.groupby('intro.pathway').agg({
        'Scientific_name': 'count',
        'height': ['mean', 'median'],
        'mrt': ['mean', 'median'],
        'invaded.niche.breadth': ['mean', 'median'],
        'native.niche.breadth': ['mean', 'median'],
        'number.of.invaded.plots': ['mean', 'median'],
        'habitat.range': ['mean', 'median']
    })
    print(trait_summary.round(3))

    # Growth form counts
    print("\nGrowth form counts:")
    print(pd.crosstab(succ_df['intro.pathway'], succ_df['growth.form'], margins=True))

    # Dispersal mode counts
    print("\nDispersal mode counts:")
    print(pd.crosstab(succ_df['intro.pathway'], succ_df['dispersal'], margins=True))

if __name__ == '__main__':
    run_analysis()
