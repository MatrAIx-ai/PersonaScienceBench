import pandas as pd
import statsmodels.api as sm
import statsmodels.formula.api as smf

def main():
    # Load dataset
    df = pd.read_excel('data/data.xlsx')
    
    # Filter valid 80 patient records (rows 0 to 79)
    df = df.iloc[:80].copy()
    
    # Define binary response: PR = 1, PD/SD = 0
    df['efficacy_PR'] = (df['Efficacy'] == 'PR').astype(int)
    
    # Fit logistic regression model with BMI as the sole predictor
    model = smf.logit('efficacy_PR ~ BMI', data=df).fit()
    
    print("Model Summary:")
    print(model.summary())
    
    aic = model.aic
    print("\nLog-Likelihood:", model.llf)
    print("Number of parameters (k):", model.df_model + 1)
    print("Exact AIC:", aic)
    print("AIC rounded to 2 decimal places:", round(aic, 2))
    print("AIC rounded to 4 decimal places:", round(aic, 4))

if __name__ == '__main__':
    main()
