import pandas as pd
import statsmodels.api as sm
import statsmodels.formula.api as smf

def run_analysis():
    # Load dataset
    df = pd.read_excel('data/data.xlsx')
    
    # Filter valid patient records (first 80 patients)
    df_clean = df.iloc[:80].copy()
    
    # Cast types
    df_clean['Age'] = pd.to_numeric(df_clean['Age'])
    df_clean['BMI'] = pd.to_numeric(df_clean['BMI'])
    
    # Define remission: PR (Partial Remission / Group 1) vs non-remission (SD / PD / Group 2)
    df_clean['remission'] = (df_clean['Efficacy'] == 'PR').astype(int)
    
    # Fit logistic regression model
    model = smf.logit('remission ~ Age + BMI + C(Gender)', data=df_clean).fit()
    
    print("Logistic Regression Results:")
    print(model.summary())
    
    age_coef = model.params['Age']
    age_se = model.bse['Age']
    age_p = model.pvalues['Age']
    age_ci_lower, age_ci_upper = model.conf_int().loc['Age']
    
    print("\n--- Age Predictor Analysis ---")
    print(f"Change in log-odds of remission per year increase in age: {age_coef:.6f}")
    print(f"Standard Error: {age_se:.6f}")
    print(f"95% Confidence Interval: [{age_ci_lower:.6f}, {age_ci_upper:.6f}]")
    print(f"p-value: {age_p:.6e}")
    print(f"Odds Ratio: {pd.np.exp(age_coef) if hasattr(pd, 'np') else __import__('numpy').exp(age_coef):.6f}")

    return age_coef, model

if __name__ == '__main__':
    run_analysis()
