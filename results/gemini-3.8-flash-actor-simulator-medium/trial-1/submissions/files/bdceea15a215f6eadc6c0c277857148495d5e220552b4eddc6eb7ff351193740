import pandas as pd
import numpy as np

def analyze_pottery_diversity():
    # Load capital dataset
    df_cap = pd.read_csv('data/capital.csv')
    for col in ['ZKeform', 'Zkeverz']:
        df_cap[col] = df_cap[col].astype(str).str.replace(',', '.').astype(float)
    
    # Sort chronological (earliest to latest)
    df_cap_sorted = df_cap.sort_values('BCE', ascending=False).reset_index(drop=True)
    df_cap_sorted['d_form'] = df_cap_sorted['ZKeform'].diff()
    df_cap_sorted['d_dec'] = df_cap_sorted['Zkeverz'].diff()

    # Identify centuries where form collapses and decoration increases
    collapse_and_increase = df_cap_sorted[(df_cap_sorted['d_form'] < 0) & (df_cap_sorted['d_dec'] > 0)]
    
    # Also verify in time_series_data
    df_ts = pd.read_csv('data/time_series_data.csv')
    ts_pts = df_ts[['CE', 'PotteryForm', 'PotteryDecoration']].dropna()
    
    return df_cap_sorted, collapse_and_increase, ts_pts

if __name__ == '__main__':
    df, target, ts = analyze_pottery_diversity()
    print('Identified event:')
    print(target[['BCE', 'group', 'ZKeform', 'd_form', 'Zkeverz', 'd_dec']])
