import pandas as pd
import numpy as np

# 1. Load data
ts = pd.read_csv('data/time_series_data.csv')
ts['BCE'] = -ts['CE']

cap = pd.read_csv('data/capital.csv', decimal=',')

pol = pd.read_csv('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv', decimal=',')
pol['BCE'] = -pol['CE']

# Capital categorization
symbolic_cols = ['ZAxtSchwert', 'ZDolch', 'Zhausgr']
social_cols = ['ZCU_AU', 'Zamber', 'ZMonument']
cultural_cols = ['ZKeform', 'Zkeverz']
economic_cols = ['ZHort', 'ZSichel', 'ZBeil', 'ZMW']

cap['Symbolic'] = cap[symbolic_cols].mean(axis=1)
cap['Social'] = cap[social_cols].mean(axis=1)
cap['Cultural'] = cap[cultural_cols].mean(axis=1)
cap['Economic'] = cap[economic_cols].mean(axis=1)

# Century Bins
bins = [
    (2000, 1900, '20th c. BCE (2000–1900 BCE)'),
    (1900, 1800, '19th c. BCE (1900–1800 BCE)'),
    (1800, 1700, '18th c. BCE (1800–1700 BCE)'),
    (1700, 1600, '17th c. BCE (1700–1600 BCE)'),
    (1600, 1500, '16th c. BCE (1600–1500 BCE)'),
    (1500, 1400, '15th c. BCE (1500–1400 BCE)'),
    (1400, 1300, '14th c. BCE (1400–1300 BCE)'),
    (1300, 1200, '13th c. BCE (1300–1200 BCE)'),
    (1200, 1100, '12th c. BCE (1200–1100 BCE)')
]

rows = []
for b_start, b_end, label in bins:
    sub_ts = ts[(ts['BCE'] <= b_start) & (ts['BCE'] > b_end)]
    g_avg = sub_ts['g_all_mean'].mean()
    g_max = sub_ts['g_all_mean'].max()
    kde_avg = sub_ts['kde_all_mean'].mean()
    p_grate_avg = sub_ts['pollen_grate_100'].mean()
    p_grate_max = sub_ts['pollen_grate_100'].max()
    p_open_avg = sub_ts['pollen_inter'].mean()

    # Capital at start and end
    c_start = cap[cap['BCE'] == b_start]
    c_end = cap[cap['BCE'] == b_end]
    
    rows.append({
        'Century_Bin': label,
        'g_all_mean_avg': g_avg,
        'g_all_mean_max': g_max,
        'kde_all_mean_avg': kde_avg,
        'pollen_grate_100_avg': p_grate_avg,
        'pollen_grate_100_max': p_grate_max,
        'pollen_openness_avg': p_open_avg,
        'Symbolic_end': c_end['Symbolic'].values[0] if len(c_end) else np.nan,
        'Social_end': c_end['Social'].values[0] if len(c_end) else np.nan,
        'Economic_end': c_end['Economic'].values[0] if len(c_end) else np.nan,
        'CopperGold_end': c_end['ZCU_AU'].values[0] if len(c_end) else np.nan,
    })

summary_df = pd.DataFrame(rows)
summary_df.to_csv('century_summary.csv', index=False)
print(summary_df.to_string())
