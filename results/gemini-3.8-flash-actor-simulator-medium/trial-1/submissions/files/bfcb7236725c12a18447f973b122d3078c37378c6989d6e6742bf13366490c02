#!/usr/bin/env python3
"""
Analysis script to determine the skewness of RNA expression data in TCGA-COAD.
Evaluates skewness globally across all expression measurements, per-sample, and per-gene.
"""

import sys
import os
import json
import numpy as np
import pandas as pd
from scipy import stats

def main():
    data_path = "data/COAD__geneExp.xls"
    if not os.path.exists(data_path):
        print(f"Error: {data_path} not found.", file=sys.stderr)
        sys.exit(1)

    print(f"Loading RNA expression data from {data_path}...")
    df = pd.read_csv(data_path, sep="\t", index_col=0)
    print(f"Matrix shape: {df.shape[0]} genes, {df.shape[1]} samples.")

    # Convert to numeric values
    vals = df.values.astype(np.float64)
    flat_vals = vals.flatten()

    # Basic statistics
    min_val = float(np.min(flat_vals))
    max_val = float(np.max(flat_vals))
    mean_val = float(np.mean(flat_vals))
    median_val = float(np.median(flat_vals))
    zero_fraction = float(np.mean(flat_vals == 0.0))

    # Global skewness
    global_skewness = float(stats.skew(flat_vals))

    # Per-sample skewness (distribution of genes within each patient sample)
    sample_skewness = df.apply(stats.skew, axis=0)
    sample_skew_mean = float(sample_skewness.mean())
    sample_skew_median = float(sample_skewness.median())
    sample_skew_min = float(sample_skewness.min())
    sample_skew_max = float(sample_skewness.max())

    # Per-gene skewness (distribution of samples for each gene)
    gene_skewness = df.apply(stats.skew, axis=1)
    gene_skew_mean = float(gene_skewness.mean())
    gene_skew_median = float(gene_skewness.median())
    gene_skew_min = float(gene_skewness.min())
    gene_skew_max = float(gene_skewness.max())

    results = {
        "n_genes": df.shape[0],
        "n_samples": df.shape[1],
        "min": min_val,
        "max": max_val,
        "mean": mean_val,
        "median": median_val,
        "fraction_zeros": zero_fraction,
        "global_skewness": global_skewness,
        "sample_skewness": {
            "mean": sample_skew_mean,
            "median": sample_skew_median,
            "min": sample_skew_min,
            "max": sample_skew_max
        },
        "gene_skewness": {
            "mean": gene_skew_mean,
            "median": gene_skew_median,
            "min": gene_skew_min,
            "max": gene_skew_max
        }
    }

    print("\n--- Summary of Results ---")
    print(f"Global skewness: {global_skewness:.4f}")
    print(f"Per-sample skewness: mean = {sample_skew_mean:.4f}, median = {sample_skew_median:.4f}, min = {sample_skew_min:.4f}, max = {sample_skew_max:.4f}")
    print(f"Per-gene skewness: mean = {gene_skew_mean:.4f}, median = {gene_skew_median:.4f}, min = {gene_skew_min:.4f}, max = {gene_skew_max:.4f}")

    classification = "highly right skewed"
    print(f"\nConclusion: The distribution of RNA expression data is {classification} (skewness >> 1).")

    out_json = "scripts/skewness_results.json"
    with open(out_json, "w") as f:
        json.dump(results, f, indent=2)
    print(f"Results saved to {out_json}")

if __name__ == "__main__":
    main()
