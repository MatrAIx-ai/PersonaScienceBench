import pandas as pd
import numpy as np
from scipy import stats

def compute_inequality_metrics():
    df = pd.read_csv('data/nls_incarceration_processed.csv')
    white = df[df['race'] == 'white'].copy()
    
    results = {}
    for sex in ['male', 'female']:
        sub = white[white['sex'] == sex]
        w90 = sub['composite_wealth_1990']
        w96 = sub['composite_wealth_1996']
        
        # Gini calculation
        def gini(s):
            s_arr = np.sort(s.values)
            n = len(s_arr)
            index = np.arange(1, n + 1)
            return (np.sum((2 * index - n - 1) * s_arr)) / (n * np.sum(s_arr))
        
        metrics = {
            'N': len(sub),
            '1990_mean': w90.mean(),
            '1996_mean': w96.mean(),
            'mean_diff': w96.mean() - w90.mean(),
            'mean_pct_change': (w96.mean() - w90.mean()) / w90.mean() * 100,
            '1990_median': w90.median(),
            '1996_median': w96.median(),
            'median_diff': w96.median() - w90.median(),
            'median_pct_change': (w96.median() - w90.median()) / w90.median() * 100,
            '1990_std': w90.std(),
            '1996_std': w96.std(),
            '1990_iqr': w90.quantile(0.75) - w90.quantile(0.25),
            '1996_iqr': w96.quantile(0.75) - w96.quantile(0.25),
            '1990_p90': w90.quantile(0.90),
            '1996_p90': w96.quantile(0.90),
            '1990_p95': w90.quantile(0.95),
            '1996_p95': w96.quantile(0.95),
            '1990_gini': gini(w90),
            '1996_gini': gini(w96),
            '1990_zero_pct': (w90 == 0).mean() * 100,
            '1996_zero_pct': (w96 == 0).mean() * 100,
            '1990_top10_share': w90[w90 >= w90.quantile(0.90)].sum() / w90.sum() * 100,
            '1996_top10_share': w96[w96 >= w96.quantile(0.90)].sum() / w96.sum() * 100,
        }
        results[sex] = metrics
        
    return results

if __name__ == '__main__':
    res = compute_inequality_metrics()
    for k, v in res.items():
        print(f"=== {k} ===")
        for m, val in v.items():
            print(f"  {m}: {val:.2f}")
