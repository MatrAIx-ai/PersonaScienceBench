import pandas as pd
import statsmodels.api as sm
import statsmodels.formula.api as smf

def run_analysis():
    # 1. Load data
    df = pd.read_excel('data/data.xlsx')
    
    # 2. Filter out trailing empty rows (Sequence number not null)
    df = df[df['Sequence number'].notna()].copy()
    
    # 3. Clean types
    df['Age'] = pd.to_numeric(df['Age'], errors='raise')
    df['BMI'] = pd.to_numeric(df['BMI'], errors='raise')
    df['is_PR'] = (df['Efficacy'] == 'PR').astype(int)
    
    # 4. Multivariable logistic regression
    # Model: is_PR ~ Age + BMI + Gender
    model = smf.logit('is_PR ~ Age + BMI + C(Gender)', data=df).fit(disp=False)
    
    print("=== LOGISTIC REGRESSION SUMMARY ===")
    print(model.summary())
    
    age_coef = model.params['Age']
    age_se = model.bse['Age']
    age_z = model.tvalues['Age']
    age_p = model.pvalues['Age']
    
    print("\n=== AGE PREDICTOR RESULTS ===")
    print(f"Coefficient (beta): {age_coef:.6f}")
    print(f"Standard Error:     {age_se:.6f}")
    print(f"z-statistic:        {age_z:.6f}")
    print(f"p-value (exact):    {age_p:.8e}")
    print(f"p-value (decimal):  {age_p:.6f}")
    print(f"p-value (rounded 4):{age_p:.4f}")
    print(f"p-value (rounded 3):{age_p:.3f}")

    # Likelihood Ratio Test for Age
    model_reduced = smf.logit('is_PR ~ BMI + C(Gender)', data=df).fit(disp=False)
    lr_stat = 2 * (model.llf - model_reduced.llf)
    from scipy import stats
    lr_p = stats.chi2.sf(lr_stat, df=1)
    print(f"\nLikelihood Ratio Test for Age:")
    print(f"LR chi2 statistic:  {lr_stat:.6f}")
    print(f"LR p-value:         {lr_p:.8e}")

if __name__ == '__main__':
    run_analysis()
