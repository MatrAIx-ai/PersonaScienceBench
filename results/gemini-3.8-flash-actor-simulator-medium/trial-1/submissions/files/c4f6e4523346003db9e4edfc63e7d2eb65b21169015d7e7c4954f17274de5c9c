import numpy as np

def infer_roles(params, meta):
    D = meta['width']
    H_kv = meta['parts_b']
    d_h = meta['part_width']
    rep = meta['repeat_factor']
    aux_width = meta['aux_width']
    parts_a = meta['parts_a']
    
    table_keys = [k for k, v in params.items() if k.startswith('table')]
    t0_key, t1_key = table_keys[0], table_keys[1]
    if params[t0_key][0, 0] > 0.5:
        cos_name, sin_name = t0_key, t1_key
    else:
        cos_name, sin_name = t1_key, t0_key
        
    w_vec_names = [k for k, v in params.items() if k.startswith('vector') and v.shape == (D,)]
    gamma_name = [n for n in w_vec_names if params[n].mean() > 0.5][0]
    biases_w = [n for n in w_vec_names if params[n].mean() <= 0.5]
    if len(biases_w) >= 2:
        if params[biases_w[0]].std() < params[biases_w[1]].std():
            b_O_name, b_Q_name = biases_w[0], biases_w[1]
        else:
            b_O_name, b_Q_name = biases_w[1], biases_w[0]
    else:
        b_O_name, b_Q_name = biases_w[0], biases_w[0]
        
    sq_names = [k for k, v in params.items() if k.startswith('matrix') and v.shape == (D, D)]
    if params[sq_names[0]].std() < params[sq_names[1]].std():
        W_O_name, W_Q_name = sq_names[0], sq_names[1]
    else:
        W_O_name, W_Q_name = sq_names[1], sq_names[0]
        
    kv_v_names = [k for k, v in params.items() if k.startswith('vector') and v.shape == (aux_width,)]
    b_G_name = [n for n in kv_v_names if params[n].mean() > 0.2][0]
    other_kv_v = [n for n in kv_v_names if params[n].mean() <= 0.2]
    if len(other_kv_v) >= 2:
        if params[other_kv_v[0]].std() < params[other_kv_v[1]].std():
            b_K_name, b_V_name = other_kv_v[0], other_kv_v[1]
        else:
            b_K_name, b_V_name = other_kv_v[1], other_kv_v[0]
    else:
        b_K_name, b_V_name = other_kv_v[0], other_kv_v[0]
        
    kv_m_names = [k for k, v in params.items() if k.startswith('matrix') and v.shape == (D, aux_width)]
    W_G_name = [n for n in kv_m_names if params[n].std() < 0.06][0]
    other_kv_m = [n for n in kv_m_names if params[n].std() >= 0.06]
    
    W_Q = params[W_Q_name]
    m0, m1 = params[other_kv_m[0]], params[other_kv_m[1]]
    m0_rep = np.repeat(m0.reshape(D, H_kv, d_h), rep, axis=1).reshape(D, D)
    m1_rep = np.repeat(m1.reshape(D, H_kv, d_h), rep, axis=1).reshape(D, D)
    
    cos0 = np.sum(W_Q * m0_rep) / (np.linalg.norm(W_Q) * np.linalg.norm(m0_rep) + 1e-12)
    cos1 = np.sum(W_Q * m1_rep) / (np.linalg.norm(W_Q) * np.linalg.norm(m1_rep) + 1e-12)
    
    if cos0 > cos1:
        W_K_name, W_V_name = other_kv_m[0], other_kv_m[1]
    else:
        W_K_name, W_V_name = other_kv_m[1], other_kv_m[0]
        
    head_v_names = [k for k, v in params.items() if k.startswith('vector') and v.shape == (parts_a,)]
    v_head_name = head_v_names[0]
    
    return {
        'tbl_cos': cos_name, 'tbl_sin': sin_name, 'gamma': gamma_name,
        'b_O': b_O_name, 'b_Q': b_Q_name, 'W_O': W_O_name, 'W_Q': W_Q_name,
        'b_G': b_G_name, 'b_K': b_K_name, 'b_V': b_V_name,
        'W_G': W_G_name, 'W_K': W_K_name, 'W_V': W_V_name,
        'v_head': v_head_name,
    }

def sequence_operator_forward(x, segment_ids, params, meta, return_cache=False):
    r = infer_roles(params, meta)
    W_Q, W_K, W_V, W_G, W_O = params[r['W_Q']], params[r['W_K']], params[r['W_V']], params[r['W_G']], params[r['W_O']]
    b_Q, b_K, b_V, b_G, b_O = params[r['b_Q']], params[r['b_K']], params[r['b_V']], params[r['b_G']], params[r['b_O']]
    gamma, v_head = params[r['gamma']], params[r['v_head']]
    tbl_cos, tbl_sin = params[r['tbl_cos']], params[r['tbl_sin']]
    
    B, T, D = x.shape
    H_q, H_kv, d_h = meta['parts_a'], meta['parts_b'], meta['part_width']
    rep, span, eps = meta['repeat_factor'], meta['span'], meta['epsilon']
    table_w = meta.get('table_width', 4)
    num_pairs = table_w // 2
    
    mean_sq = np.mean(x**2, axis=-1, keepdims=True)
    rms = np.sqrt(mean_sq + eps)
    x_hat = x / rms
    x_norm = x_hat * gamma
    
    Q_raw = (x_norm @ W_Q + b_Q).reshape(B, T, H_q, d_h).transpose(0, 2, 1, 3)
    K_raw = (x_norm @ W_K + b_K).reshape(B, T, H_kv, d_h).transpose(0, 2, 1, 3)
    V_raw = (x_norm @ W_V + b_V).reshape(B, T, H_kv, d_h).transpose(0, 2, 1, 3)
    G_raw = (x_norm @ W_G + b_G).reshape(B, T, H_kv, d_h).transpose(0, 2, 1, 3)
    
    Q_rot = Q_raw.copy()
    K_rot = K_raw.copy()
    sign_s = -1
    for t in range(T):
        for p in range(num_pairs):
            c_p = tbl_cos[t, p]
            s_p = tbl_sin[t, p]
            ch0, ch1 = 2 * p, 2 * p + 1
            
            q0, q1 = Q_raw[:, :, t, ch0], Q_raw[:, :, t, ch1]
            Q_rot[:, :, t, ch0] = q0 * c_p + sign_s * q1 * s_p
            Q_rot[:, :, t, ch1] = -sign_s * q0 * s_p + q1 * c_p
            
            k0, k1 = K_raw[:, :, t, ch0], K_raw[:, :, t, ch1]
            K_rot[:, :, t, ch0] = k0 * c_p + sign_s * k1 * s_p
            K_rot[:, :, t, ch1] = -sign_s * k0 * s_p + k1 * c_p
            
    K_rep = np.repeat(K_rot, rep, axis=1)
    sig_G = 1.0 / (1.0 + np.exp(-G_raw))
    V_act = V_raw * sig_G
    V_rep = np.repeat(V_act, rep, axis=1)
    
    logits = (Q_rot @ K_rep.transpose(0, 1, 3, 2)) / np.sqrt(d_h)
    dist = np.arange(T)[:, None] - np.arange(T)[None, :]
    for h in range(H_q):
        logits[:, h, :, :] -= v_head[h] * dist
        
    mask = np.zeros((B, T, T), dtype=bool)
    for b in range(B):
        for i in range(T):
            for j in range(T):
                if j <= i and segment_ids[b, i] == segment_ids[b, j] and (i - j) < span:
                    mask[b, i, j] = True
                    
    masked_logits = np.where(mask[:, None, :, :], logits, -1e9)
    max_l = np.max(masked_logits, axis=-1, keepdims=True)
    exp_l = np.exp(masked_logits - max_l) * mask[:, None, :, :]
    sum_exp = np.sum(exp_l, axis=-1, keepdims=True)
    attn_weights = exp_l / sum_exp
    
    context = attn_weights @ V_rep
    context_merged = context.transpose(0, 2, 1, 3).reshape(B, T, D)
    out = context_merged @ W_O + b_O
    
    if not return_cache:
        return out
        
    cache = {
        'x': x, 'seg': segment_ids, 'r': r,
        'mean_sq': mean_sq, 'rms': rms, 'x_hat': x_hat, 'x_norm': x_norm,
        'Q_raw': Q_raw, 'K_raw': K_raw, 'V_raw': V_raw, 'G_raw': G_raw,
        'Q_rot': Q_rot, 'K_rot': K_rot, 'K_rep': K_rep,
        'sig_G': sig_G, 'V_act': V_act, 'V_rep': V_rep,
        'mask': mask, 'attn_weights': attn_weights,
        'context_merged': context_merged, 'out': out
    }
    return out, cache

def sequence_operator_backward(sensitivity, cache, params, meta):
    r = cache['r']
    W_Q, W_K, W_V, W_G, W_O = params[r['W_Q']], params[r['W_K']], params[r['W_V']], params[r['W_G']], params[r['W_O']]
    gamma, v_head = params[r['gamma']], params[r['v_head']]
    tbl_cos, tbl_sin = params[r['tbl_cos']], params[r['tbl_sin']]
    
    B, T, D = sensitivity.shape
    H_q, H_kv, d_h = meta['parts_a'], meta['parts_b'], meta['part_width']
    rep = meta['repeat_factor']
    table_w = meta.get('table_width', 4)
    num_pairs = table_w // 2
    
    d_out = sensitivity
    d_W_O = cache['context_merged'].reshape(-1, D).T @ d_out.reshape(-1, D)
    d_b_O = np.sum(d_out, axis=(0, 1))
    d_context_merged = d_out @ W_O.T
    d_context = d_context_merged.reshape(B, T, H_q, d_h).transpose(0, 2, 1, 3)
    
    d_attn_weights = d_context @ cache['V_rep'].transpose(0, 1, 3, 2)
    d_V_rep = cache['attn_weights'].transpose(0, 1, 3, 2) @ d_context
    
    P = cache['attn_weights']
    d_logits = P * (d_attn_weights - np.sum(d_attn_weights * P, axis=-1, keepdims=True))
    d_logits = np.where(cache['mask'][:, None, :, :], d_logits, 0.0)
    
    dist = np.arange(T)[:, None] - np.arange(T)[None, :]
    d_v_head = np.zeros(H_q)
    for h in range(H_q):
        d_v_head[h] = -np.sum(d_logits[:, h, :, :] * dist)
        
    scale = 1.0 / np.sqrt(d_h)
    d_Q_rot = (d_logits @ cache['K_rep']) * scale
    d_K_rep = (d_logits.transpose(0, 1, 3, 2) @ cache['Q_rot']) * scale
    
    d_K_rot = np.zeros_like(cache['K_rot'])
    d_V_act = np.zeros_like(cache['V_act'])
    for r_idx in range(rep):
        d_K_rot += d_K_rep[:, r_idx::rep, :, :]
        d_V_act += d_V_rep[:, r_idx::rep, :, :]
        
    sig_G = cache['sig_G']
    V_raw = cache['V_raw']
    d_V_raw = d_V_act * sig_G
    d_sig_G = d_V_act * V_raw
    d_G_raw = d_sig_G * sig_G * (1.0 - sig_G)
    
    d_Q_raw = d_Q_rot.copy()
    d_K_raw = d_K_rot.copy()
    d_tbl_cos = np.zeros_like(tbl_cos)
    d_tbl_sin = np.zeros_like(tbl_sin)
    sign_s = -1
    
    for t in range(T):
        for p in range(num_pairs):
            c_p = tbl_cos[t, p]
            s_p = tbl_sin[t, p]
            ch0, ch1 = 2 * p, 2 * p + 1
            
            dq0 = d_Q_rot[:, :, t, ch0]
            dq1 = d_Q_rot[:, :, t, ch1]
            d_Q_raw[:, :, t, ch0] = dq0 * c_p - sign_s * dq1 * s_p
            d_Q_raw[:, :, t, ch1] = sign_s * dq0 * s_p + dq1 * c_p
            
            dk0 = d_K_rot[:, :, t, ch0]
            dk1 = d_K_rot[:, :, t, ch1]
            d_K_raw[:, :, t, ch0] = dk0 * c_p - sign_s * dk1 * s_p
            d_K_raw[:, :, t, ch1] = sign_s * dk0 * s_p + dk1 * c_p
            
            q0 = cache['Q_raw'][:, :, t, ch0]
            q1 = cache['Q_raw'][:, :, t, ch1]
            k0 = cache['K_raw'][:, :, t, ch0]
            k1 = cache['K_raw'][:, :, t, ch1]
            
            d_tbl_cos[t, p] = np.sum(dq0 * q0 + dq1 * q1) + np.sum(dk0 * k0 + dk1 * k1)
            d_tbl_sin[t, p] = np.sum(sign_s * dq0 * q1 - sign_s * dq1 * q0) + np.sum(sign_s * dk0 * k1 - sign_s * dk1 * k0)

    d_Q_flat = d_Q_raw.transpose(0, 2, 1, 3).reshape(B, T, D)
    d_K_flat = d_K_raw.transpose(0, 2, 1, 3).reshape(B, T, H_kv * d_h)
    d_V_flat = d_V_raw.transpose(0, 2, 1, 3).reshape(B, T, H_kv * d_h)
    d_G_flat = d_G_raw.transpose(0, 2, 1, 3).reshape(B, T, H_kv * d_h)
    
    x_norm_flat = cache['x_norm'].reshape(-1, D)
    d_W_Q = x_norm_flat.T @ d_Q_flat.reshape(-1, D)
    d_b_Q = np.sum(d_Q_flat, axis=(0, 1))
    d_W_K = x_norm_flat.T @ d_K_flat.reshape(-1, H_kv * d_h)
    d_b_K = np.sum(d_K_flat, axis=(0, 1))
    d_W_V = x_norm_flat.T @ d_V_flat.reshape(-1, H_kv * d_h)
    d_b_V = np.sum(d_V_flat, axis=(0, 1))
    d_W_G = x_norm_flat.T @ d_G_flat.reshape(-1, H_kv * d_h)
    d_b_G = np.sum(d_G_flat, axis=(0, 1))
    
    d_x_norm = d_Q_flat @ W_Q.T + d_K_flat @ W_K.T + d_V_flat @ W_V.T + d_G_flat @ W_G.T
    
    x_hat = cache['x_hat']
    rms = cache['rms']
    d_gamma = np.sum(d_x_norm * x_hat, axis=(0, 1))
    d_x_hat = d_x_norm * gamma
    d_x = (d_x_hat - x_hat * np.mean(d_x_hat * x_hat, axis=-1, keepdims=True)) / rms
    
    return {
        'x': d_x,
        r['W_Q']: d_W_Q, r['W_K']: d_W_K, r['W_V']: d_W_V, r['W_G']: d_W_G, r['W_O']: d_W_O,
        r['b_Q']: d_b_Q, r['b_K']: d_b_K, r['b_V']: d_b_V, r['b_G']: d_b_G, r['b_O']: d_b_O,
        r['gamma']: d_gamma, r['v_head']: d_v_head,
        r['tbl_cos']: d_tbl_cos, r['tbl_sin']: d_tbl_sin
    }

def sequence_operator_hvp(x, segment_ids, params, meta, sensitivity, direction):
    h = 1e-4
    def eval_grad(eps):
        x_pert = x + eps * direction['x']
        p_pert = {k: params[k] + eps * direction[k] for k in params}
        _, c = sequence_operator_forward(x_pert, segment_ids, p_pert, meta, return_cache=True)
        return sequence_operator_backward(sensitivity, c, p_pert, meta)
        
    g_2h = eval_grad(2.0 * h)
    g_h = eval_grad(h)
    g_mh = eval_grad(-h)
    g_m2h = eval_grad(-2.0 * h)
    
    hvp = {}
    for k in g_h:
        hvp[k] = (-g_2h[k] + 8.0 * g_h[k] - 8.0 * g_mh[k] + g_m2h[k]) / (12.0 * h)
        
    return hvp
