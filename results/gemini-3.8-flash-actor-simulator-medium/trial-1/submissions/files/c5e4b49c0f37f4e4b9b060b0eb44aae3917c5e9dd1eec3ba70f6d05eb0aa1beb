import pandas as pd
import numpy as np
from scipy import stats

def main():
    df = pd.read_csv('data/meta-regression_joined_data_heterogeneity_in_replication_projects.csv')
    
    results = []
    groups = [
        ('All Studies (Overall)', df),
        ('Cognitive Psychology', df[df['discipline'] == 'Cognitive']),
        ('Social Psychology', df[df['discipline'] == 'Social']),
        ('Experimental Economics', df[df['discipline'] == 'Economics']),
        ('Psychology (RPP)', df[df['project.x'] == 'Psychology']),
        ('Economics (EE)', df[df['project.x'] == 'Experimental Economics'])
    ]
    
    for name, sub in groups:
        n = len(sub)
        ro_m, ro_sd, ro_med = sub['ro'].mean(), sub['ro'].std(), sub['ro'].median()
        rr_m, rr_sd, rr_med = sub['rr'].mean(), sub['rr'].std(), sub['rr'].median()
        diff_r = sub['ro'] - sub['rr']
        diff_r_m, diff_r_med = diff_r.mean(), diff_r.median()
        
        fiso_m, fisr_m = sub['fiso'].mean(), sub['fisr'].mean()
        diff_f_m = (sub['fiso'] - sub['fisr']).mean()
        
        rel_m, rel_med = sub['relative_es'].mean(), sub['relative_es'].median()
        count_gt = (sub['ro'] > sub['rr']).sum()
        pct_gt = count_gt / n * 100
        
        t_stat, p_val = stats.ttest_rel(sub['ro'], sub['rr'])
        w_stat, w_pval = stats.wilcoxon(sub['ro'], sub['rr'])
        
        t_rel, p_rel = stats.ttest_1samp(sub['relative_es'], 1.0)
        
        results.append({
            'Group': name,
            'N': n,
            'ro_mean': ro_m,
            'rr_mean': rr_m,
            'ro_median': ro_med,
            'rr_median': rr_med,
            'diff_mean': diff_r_m,
            'rel_es_mean': rel_m,
            'rel_es_median': rel_med,
            'count_ro_gt_rr': count_gt,
            'pct_ro_gt_rr': pct_gt,
            'paired_t': t_stat,
            'paired_p': p_val,
            'wilcoxon_w': w_stat,
            'wilcoxon_p': w_pval,
            'rel_1samp_p': p_rel
        })
        
    res_df = pd.DataFrame(results)
    print(res_df.to_string(index=False))
    res_df.to_csv('effect_size_domain_comparison.csv', index=False)

if __name__ == '__main__':
    main()
