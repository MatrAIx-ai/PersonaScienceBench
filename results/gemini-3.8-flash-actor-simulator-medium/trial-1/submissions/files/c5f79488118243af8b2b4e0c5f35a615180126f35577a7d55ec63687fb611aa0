import pandas as pd
import numpy as np

def run_analysis():
    excel_path = 'data/Data_deposition_RNAseq_Paroxetine_2017.xlsx'
    print(f"Loading data from {excel_path}...")
    
    # Load NormCount sheet (header is at row index 3, i.e. 4th row)
    df = pd.read_excel(excel_path, sheet_name='NormCount', header=3)
    
    # Tissue comparisons for bad responders vs controls:
    # Comparison 2: baseline_blood (starts at 0-indexed column 107 in raw sheet, i.e. baseMean.1 in df)
    # Comparison 5: dentate_gyrus (starts at column 134 in raw sheet)
    # Comparison 8: final_blood (starts at column 161 in raw sheet)
    
    tissue_comparisons = {
        'baseline_blood': {
            'comp_num': 2,
            'start_col': 98 + 1 * 9 # col 107
        },
        'dentate_gyrus': {
            'comp_num': 5,
            'start_col': 98 + 4 * 9 # col 134
        },
        'final_blood': {
            'comp_num': 8,
            'start_col': 98 + 7 * 9 # col 161
        }
    }
    
    results = []
    
    for tissue, info in tissue_comparisons.items():
        c = info['start_col']
        baseMean = pd.to_numeric(df.iloc[:, c], errors='coerce')
        lfc = pd.to_numeric(df.iloc[:, c + 4], errors='coerce')
        pval = pd.to_numeric(df.iloc[:, c + 5], errors='coerce')
        padj = pd.to_numeric(df.iloc[:, c + 6], errors='coerce')
        max_deg = df.iloc[:, c + 7]
        med_deg = df.iloc[:, c + 8]
        
        # Criteria definitions:
        # 1. Standard: padj < 0.05 & lfc > 0.5 & baseMean > 10
        count_up_padj = int(((padj < 0.05) & (lfc > 0.5) & (baseMean > 10)).sum())
        
        # 2. Bidirectional: padj < 0.05 & |lfc| > 0.5 & baseMean > 10
        count_bi_padj = int(((padj < 0.05) & (lfc.abs() > 0.5) & (baseMean > 10)).sum())
        
        # 3. Downregulated: padj < 0.05 & lfc < -0.5 & baseMean > 10
        count_down_padj = int(((padj < 0.05) & (lfc < -0.5) & (baseMean > 10)).sum())
        
        # 4. pval < 0.05 & lfc > 0.5 & baseMean > 10
        count_up_pval = int(((pval < 0.05) & (lfc > 0.5) & (baseMean > 10)).sum())
        count_bi_pval = int(((pval < 0.05) & (lfc.abs() > 0.5) & (baseMean > 10)).sum())
        
        # 5. Precomputed DEG columns
        count_med_deg = int((med_deg.isin(['U', 'D'])).sum())
        count_med_deg_up = int((med_deg == 'U').sum())
        count_max_deg = int((max_deg.isin(['U', 'D'])).sum())
        count_max_deg_up = int((max_deg == 'U').sum())
        
        results.append({
            'Tissue': tissue,
            'Comparison': f"Comparison {info['comp_num']}",
            'Up (padj<0.05, lfc>0.5, bm>10)': count_up_padj,
            'Down (padj<0.05, lfc<-0.5, bm>10)': count_down_padj,
            'Total (|lfc|>0.5, padj<0.05, bm>10)': count_bi_padj,
            'Up (pval<0.05, lfc>0.5, bm>10)': count_up_pval,
            'Total (|lfc|>0.5, pval<0.05, bm>10)': count_bi_pval,
            'Precomputed Median DEG (Total)': count_med_deg,
            'Precomputed Median DEG (Up)': count_med_deg_up,
            'Precomputed Max DEG (Total)': count_max_deg,
            'Precomputed Max DEG (Up)': count_max_deg_up,
        })
        
    res_df = pd.DataFrame(results)
    print("\n=== Differentially Expressed Genes (Bad Responders vs Controls) ===")
    print(res_df.to_string(index=False))
    
    # Identify winner
    winner_up = res_df.loc[res_df['Up (padj<0.05, lfc>0.5, bm>10)'].idxmax(), 'Tissue']
    winner_total = res_df.loc[res_df['Total (|lfc|>0.5, padj<0.05, bm>10)'].idxmax(), 'Tissue']
    print(f"\nTissue with highest number of significantly DEG (lfc > 0.5 and basemean > 10): {winner_up}")
    print(f"Tissue with highest number of significantly DEG (|lfc| > 0.5 and basemean > 10): {winner_total}")

if __name__ == '__main__':
    run_analysis()
