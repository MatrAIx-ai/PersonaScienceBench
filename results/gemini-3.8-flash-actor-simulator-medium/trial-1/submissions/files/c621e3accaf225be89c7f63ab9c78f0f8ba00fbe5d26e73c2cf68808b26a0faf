#!/usr/bin/env python3
import os
import sys
import json
import numpy as np
import pandas as pd

if '/usr/lib/python3/dist-packages' not in sys.path:
    sys.path.append('/usr/lib/python3/dist-packages')

try:
    from PIL import Image, ImageDraw, ImageFont
    HAS_PIL = True
except ImportError:
    HAS_PIL = False

def create_diagnostic_plot(days, swe_s, depth_s, density_s, states, melt_s, refr_s, runoff_s, out_path):
    if not HAS_PIL:
        return
    w, h = 1400, 1000
    img = Image.new('RGB', (w, h), (255, 255, 255))
    draw = ImageDraw.Draw(img)

    f_reg = '/usr/share/fonts/truetype/liberation/LiberationSans-Regular.ttf'
    f_bld = '/usr/share/fonts/truetype/liberation/LiberationSans-Bold.ttf'
    if os.path.exists(f_reg) and os.path.exists(f_bld):
        t_font = ImageFont.truetype(f_bld, 20)
        s_font = ImageFont.truetype(f_bld, 14)
        l_font = ImageFont.truetype(f_reg, 12)
        k_font = ImageFont.truetype(f_reg, 10)
    else:
        t_font = s_font = l_font = k_font = ImageFont.load_default()

    draw.text((w // 2 - 220, 20), 'Three-Layer Snowpack Dynamics Simulation', fill=(20, 20, 20), font=t_font)

    boxes = [
        (90, 80, 630, 480),
        (770, 80, 1310, 480),
        (90, 560, 630, 940),
        (770, 560, 1310, 940)
    ]

    def setup_box(b, title, xl, yl):
        draw.rectangle(b, outline=(200, 200, 200), width=1)
        draw.text((b[0] + 10, b[1] - 25), title, fill=(30, 30, 30), font=s_font)
        draw.text(((b[0] + b[2]) // 2 - 20, b[3] + 25), xl, fill=(40, 40, 40), font=l_font)
        draw.text((b[0] - 65, (b[1] + b[3]) // 2 - 10), yl, fill=(40, 40, 40), font=l_font)

    def draw_grid(b, x_min, x_max, y_min, y_max, nx=6, ny=5, fmt='{:.1f}'):
        for i in range(nx + 1):
            vx = x_min + i * (x_max - x_min) / nx
            px = b[0] + (vx - x_min) / (x_max - x_min) * (b[2] - b[0])
            draw.line([(px, b[1]), (px, b[3])], fill=(240, 240, 240), width=1)
            draw.line([(px, b[3]), (px, b[3] + 5)], fill=(120, 120, 120), width=1)
            draw.text((px - 8, b[3] + 8), f'{int(vx)}', fill=(80, 80, 80), font=k_font)
        for j in range(ny + 1):
            vy = y_min + j * (y_max - y_min) / ny
            py = b[3] - (vy - y_min) / (y_max - y_min) * (b[3] - b[1])
            draw.line([(b[0], py), (b[2], py)], fill=(240, 240, 240), width=1)
            draw.line([(b[0] - 5, py), (b[0], py)], fill=(120, 120, 120), width=1)
            draw.text((b[0] - 45, py - 6), fmt.format(vy), fill=(80, 80, 80), font=k_font)

    def to_xy(vx, vy, b, x_min, x_max, y_min, y_max):
        px = b[0] + (vx - x_min) / (x_max - x_min) * (b[2] - b[0])
        py = b[3] - (vy - y_min) / (y_max - y_min) * (b[3] - b[1])
        return float(px), float(py)

    xmin, xmax = float(days[0]), float(days[-1])

    # Panel 1: SWE & Snow Depth
    b1 = boxes[0]
    setup_box(b1, 'Snowpack Water Equivalent & Depth', 'Day', 'SWE (mm)')
    y1_min, y1_max = 180.0, 300.0
    draw_grid(b1, xmin, xmax, y1_min, y1_max, nx=6, ny=5, fmt='{:.0f}')
    pts_swe = [to_xy(days[i], swe_s[i], b1, xmin, xmax, y1_min, y1_max) for i in range(len(days))]
    for i in range(len(pts_swe) - 1):
        draw.line([pts_swe[i], pts_swe[i + 1]], fill=(31, 119, 180), width=3)

    yd_min, yd_max = 0.5, 1.5
    for j in range(6):
        vd = yd_min + j * (yd_max - yd_min) / 5
        py = b1[3] - (vd - yd_min) / (yd_max - yd_min) * (b1[3] - b1[1])
        draw.text((b1[2] + 8, py - 6), f'{vd:.1f}', fill=(23, 190, 207), font=k_font)
    draw.text((b1[2] + 35, (b1[1] + b1[3]) // 2 - 15), 'Depth (m)', fill=(23, 190, 207), font=l_font)
    pts_d = [to_xy(days[i], depth_s[i], b1, xmin, xmax, yd_min, yd_max) for i in range(len(days))]
    for i in range(len(pts_d) - 1):
        draw.line([pts_d[i], pts_d[i + 1]], fill=(23, 190, 207), width=3)

    draw.line([(b1[0] + 20, b1[1] + 20), (b1[0] + 50, b1[1] + 20)], fill=(31, 119, 180), width=3)
    draw.text((b1[0] + 55, b1[1] + 13), 'SWE (mm)', fill=(31, 119, 180), font=k_font)
    draw.line([(b1[0] + 140, b1[1] + 20), (b1[0] + 170, b1[1] + 20)], fill=(23, 190, 207), width=3)
    draw.text((b1[0] + 175, b1[1] + 13), 'Depth (m)', fill=(23, 190, 207), font=k_font)

    # Panel 2: Density Evolution
    b2 = boxes[1]
    setup_box(b2, 'Bulk & Layer Density Compaction', 'Day', 'Density (kg/m³)')
    y2_min, y2_max = 80.0, 420.0
    draw_grid(b2, xmin, xmax, y2_min, y2_max, nx=6, ny=5, fmt='{:.0f}')
    c_lay = [(31, 119, 180), (255, 127, 14), (44, 160, 44)]
    for l_idx in range(3):
        pts_lay = [to_xy(days[i], states[i, l_idx, 1], b2, xmin, xmax, y2_min, y2_max) for i in range(len(days))]
        for i in range(len(pts_lay) - 1):
            draw.line([pts_lay[i], pts_lay[i + 1]], fill=c_lay[l_idx], width=2)
    pts_m = [to_xy(days[i], density_s[i], b2, xmin, xmax, y2_min, y2_max) for i in range(len(days))]
    for i in range(len(pts_m) - 1):
        draw.line([pts_m[i], pts_m[i + 1]], fill=(30, 30, 30), width=3)

    lx = b2[0] + 15
    draw.line([(lx, b2[1] + 20), (lx + 25, b2[1] + 20)], fill=(30, 30, 30), width=3)
    draw.text((lx + 30, b2[1] + 13), 'Mean Density', fill=(30, 30, 30), font=k_font)
    draw.line([(lx + 120, b2[1] + 20), (lx + 145, b2[1] + 20)], fill=c_lay[0], width=2)
    draw.text((lx + 150, b2[1] + 13), 'Layer 0 (Top)', fill=c_lay[0], font=k_font)
    draw.line([(lx + 240, b2[1] + 20), (lx + 265, b2[1] + 20)], fill=c_lay[1], width=2)
    draw.text((lx + 270, b2[1] + 13), 'Layer 1 (Mid)', fill=c_lay[1], font=k_font)
    draw.line([(lx + 360, b2[1] + 20), (lx + 385, b2[1] + 20)], fill=c_lay[2], width=2)
    draw.text((lx + 390, b2[1] + 13), 'Layer 2 (Bot)', fill=c_lay[2], font=k_font)

    # Panel 3: Temperature Dynamics
    b3 = boxes[2]
    setup_box(b3, 'Layer Temperature Dynamics', 'Day', 'Temp (°C)')
    y3_min, y3_max = -12.0, 2.0
    draw_grid(b3, xmin, xmax, y3_min, y3_max, nx=6, ny=7, fmt='{:.1f}')
    p0y = b3[3] - (0.0 - y3_min) / (y3_max - y3_min) * (b3[3] - b3[1])
    draw.line([(b3[0], p0y), (b3[2], p0y)], fill=(150, 150, 150), width=1)
    for l_idx in range(3):
        pts_t = [to_xy(days[i], states[i, l_idx, 4] - 273.15, b3, xmin, xmax, y3_min, y3_max) for i in range(len(days))]
        for i in range(len(pts_t) - 1):
            draw.line([pts_t[i], pts_t[i + 1]], fill=c_lay[l_idx], width=2)

    # Panel 4: Fluxes
    b4 = boxes[3]
    setup_box(b4, 'Daily Melt, Refreeze & Runoff Fluxes', 'Day', 'Flux (mm/day)')
    y4_min, y4_max = 0.0, max(15.0, float(np.max(melt_s)) * 1.2)
    draw_grid(b4, xmin, xmax, y4_min, y4_max, nx=6, ny=5, fmt='{:.1f}')
    dx = (b4[2] - b4[0]) / len(days)
    for i in range(len(days)):
        px = b4[0] + i * dx
        mh = (melt_s[i] / (y4_max - y4_min)) * (b4[3] - b4[1])
        draw.rectangle([px, b4[3] - mh, px + dx * 0.45, b4[3]], fill=(220, 50, 50))
        rh = (refr_s[i] / (y4_max - y4_min)) * (b4[3] - b4[1])
        draw.rectangle([px + dx * 0.45, b4[3] - rh, px + dx * 0.9, b4[3]], fill=(70, 130, 180))

    pts_run = [to_xy(days[i], runoff_s[i], b4, xmin, xmax, y4_min, y4_max) for i in range(len(days))]
    for i in range(len(pts_run) - 1):
        draw.line([pts_run[i], pts_run[i + 1]], fill=(30, 30, 30), width=2)

    lx = b4[0] + 15
    draw.rectangle([lx, b4[1] + 16, lx + 12, b4[1] + 24], fill=(220, 50, 50))
    draw.text((lx + 16, b4[1] + 13), 'Daily Melt (mm)', fill=(220, 50, 50), font=k_font)
    draw.rectangle([lx + 130, b4[1] + 16, lx + 142, b4[1] + 24], fill=(70, 130, 180))
    draw.text((lx + 146, b4[1] + 13), 'Daily Refreeze (mm)', fill=(70, 130, 180), font=k_font)
    draw.line([(lx + 280, b4[1] + 20), (lx + 300, b4[1] + 20)], fill=(30, 30, 30), width=2)
    draw.text((lx + 305, b4[1] + 13), 'Daily Runoff (mm)', fill=(30, 30, 30), font=k_font)

    img.save(out_path)
    print(f'Diagnostic figure successfully saved to: {out_path}')

def run_snow_model(init_path='data/snowpack_init.json', forcing_path='data/forcing.csv', out_dir='results'):
    os.makedirs(out_dir, exist_ok=True)

    with open(init_path, 'r') as f:
        init_data = json.load(f)

    thickness = np.array([l['thickness_m'] for l in init_data['layers']], dtype=np.float64)
    density = np.array([l['density_kg_m3'] for l in init_data['layers']], dtype=np.float64)
    ice = np.array([l['ice_mm'] for l in init_data['layers']], dtype=np.float64)
    liq = np.array([l['liq_mm'] for l in init_data['layers']], dtype=np.float64)
    temp = np.array([l['temp_K'] for l in init_data['layers']], dtype=np.float64)

    forcing = pd.read_csv(forcing_path)
    n_hours = len(forcing)
    n_days = n_hours // 24

    SIGMA = 5.670374e-8
    C_ICE = 2102.0
    C_LIQ = 4182.0
    L_FUS = 3.337e5
    T_FREEZE = 273.15
    GRAV = 9.81

    EMISSIVITY = 0.98
    H_TURB = 12.0
    G_BOT = 0.5
    T_GROUND = 273.15
    THETA_RET = 0.05
    ALBEDO_FRESH = 0.82
    ALBEDO_MIN = 0.68
    ALBEDO_DECAY = 0.002

    C1 = 2.778e-6
    C2 = 0.04
    C3 = 0.046
    RHO_THRESH = 150.0
    ETA0 = 3.6e7
    A_ETA = 0.023
    B_ETA = 0.10

    dt = 3600.0
    albedo = ALBEDO_FRESH

    daily_states = np.zeros((n_days, 3, 5), dtype=np.float64)
    daily_summaries = []

    cum_snowfall = 0.0
    cum_rainfall = 0.0
    cum_melt = 0.0
    cum_refreeze = 0.0
    cum_runoff = 0.0

    day_melt = 0.0
    day_refreeze = 0.0
    day_runoff = 0.0

    init_swe = float(np.sum(ice + liq))

    for hour in range(n_hours):
        row = forcing.iloc[hour]
        t_air = float(row['t_air_K'])
        p_snow = float(row['snowfall_mm_hr'])
        p_rain = float(row['rainfall_mm_hr'])
        sw_in = float(row['sw_in_wm2'])
        lw_in = float(row['lw_in_wm2'])

        cum_snowfall += p_snow
        cum_rainfall += p_rain

        # 1. Snowfall deposition
        if p_snow > 0:
            rho_fresh = max(60.0, min(150.0, 50.0 + 1.7 * max(0.0, t_air - 258.16) ** 1.5))
            d_thick = p_snow / rho_fresh
            t_snow = min(t_air, T_FREEZE)

            h_old = ice[0] * C_ICE * (temp[0] - T_FREEZE)
            h_new = p_snow * C_ICE * (t_snow - T_FREEZE)
            ice[0] += p_snow
            thickness[0] += d_thick
            c_tot = ice[0] * C_ICE + liq[0] * C_LIQ
            temp[0] = T_FREEZE + (h_old + h_new) / c_tot
            density[0] = (ice[0] + liq[0]) / thickness[0]
            albedo = ALBEDO_FRESH
        else:
            albedo = max(ALBEDO_MIN, albedo - ALBEDO_DECAY)

        # 2. Rainfall deposition
        if p_rain > 0:
            liq[0] += p_rain
            density[0] = (ice[0] + liq[0]) / thickness[0]

        # 3. Energy balance & heat conduction
        k_snow = 0.026 + 2.5e-6 * (density ** 2)
        g_01 = 1.0 / (thickness[0] / (2.0 * k_snow[0]) + thickness[1] / (2.0 * k_snow[1]))
        g_12 = 1.0 / (thickness[1] / (2.0 * k_snow[1]) + thickness[2] / (2.0 * k_snow[2]))
        g_bot = G_BOT

        c_cap = np.maximum(ice * C_ICE + liq * C_LIQ, 1e4)

        dq_dt = - (4.0 * EMISSIVITY * SIGMA * (temp[0] ** 3) + H_TURB)
        q0 = (1.0 - albedo) * sw_in + EMISSIVITY * lw_in - EMISSIVITY * SIGMA * (temp[0] ** 4) + H_TURB * (t_air - temp[0])

        A = np.zeros((3, 3))
        b = np.zeros(3)

        A[0, 0] = c_cap[0] / dt - dq_dt + g_01
        A[0, 1] = -g_01
        b[0] = (c_cap[0] / dt - dq_dt) * temp[0] + q0

        A[1, 0] = -g_01
        A[1, 1] = c_cap[1] / dt + g_01 + g_12
        A[1, 2] = -g_12
        b[1] = (c_cap[1] / dt) * temp[1]

        A[2, 1] = -g_12
        A[2, 2] = c_cap[2] / dt + g_12 + g_bot
        b[2] = (c_cap[2] / dt) * temp[2] + g_bot * T_GROUND

        temp = np.linalg.solve(A, b)

        # 4. Phase changes (Melt & Refreeze)
        step_melt = 0.0
        step_refreeze = 0.0

        for i in range(3):
            if temp[i] > T_FREEZE and ice[i] > 0.0:
                q_excess = c_cap[i] * (temp[i] - T_FREEZE)
                m_melt = min(ice[i], q_excess / L_FUS)
                ice[i] -= m_melt
                liq[i] += m_melt
                step_melt += m_melt
                d_melt = m_melt / density[i]
                thickness[i] = max(0.01, thickness[i] - d_melt)
                density[i] = (ice[i] + liq[i]) / thickness[i]
                temp[i] = T_FREEZE
            elif temp[i] > T_FREEZE:
                temp[i] = T_FREEZE

            if temp[i] < T_FREEZE and liq[i] > 0.0:
                q_cold = c_cap[i] * (T_FREEZE - temp[i])
                m_refr = min(liq[i], q_cold / L_FUS)
                ice[i] += m_refr
                liq[i] -= m_refr
                step_refreeze += m_refr
                temp[i] += (m_refr * L_FUS) / c_cap[i]
                temp[i] = min(temp[i], T_FREEZE)
                density[i] = (ice[i] + liq[i]) / thickness[i]

        cum_melt += step_melt
        cum_refreeze += step_refreeze
        day_melt += step_melt
        day_refreeze += step_refreeze

        # 5. Liquid water retention and drainage
        step_runoff = 0.0
        for i in range(3):
            w_cap = THETA_RET * ice[i]
            if liq[i] > w_cap:
                drain = liq[i] - w_cap
                liq[i] = w_cap
                if i < 2:
                    liq[i + 1] += drain
                else:
                    step_runoff += drain

        cum_runoff += step_runoff
        day_runoff += step_runoff

        for i in range(3):
            density[i] = (ice[i] + liq[i]) / thickness[i]

        # 6. Compaction dynamics
        m_over = 0.0
        for i in range(3):
            cr = C1 * np.exp(-C2 * (T_FREEZE - temp[i])) * np.exp(-C3 * max(0.0, density[i] - RHO_THRESH))
            m_layer = ice[i] + liq[i]
            p_over = (m_over + 0.5 * m_layer) * GRAV
            m_over += m_layer
            eta = ETA0 * np.exp(A_ETA * density[i]) * np.exp(B_ETA * (T_FREEZE - temp[i]))
            co = p_over / eta

            if liq[i] > 0.01 * ice[i]:
                factor = 1.0 + 2.0 * min(1.0, liq[i] / max(1.0, ice[i]))
                cr *= factor
                co *= factor

            comp_rate = cr + co
            frac_comp = min(0.05, comp_rate * dt)
            thickness[i] *= (1.0 - frac_comp)

            if density[i] > 600.0:
                thickness[i] = (ice[i] + liq[i]) / 600.0
            density[i] = (ice[i] + liq[i]) / thickness[i]

        # 7. Daily snapshot
        if (hour + 1) % 24 == 0:
            day_idx = hour // 24
            swe_now = float(np.sum(ice + liq))
            depth_now = float(np.sum(thickness))
            mean_density = swe_now / depth_now if depth_now > 0 else 0.0

            for i in range(3):
                daily_states[day_idx, i] = [thickness[i], density[i], ice[i], liq[i], temp[i]]

            daily_summaries.append({
                'day': int(day_idx),
                'swe_mm': swe_now,
                'snow_depth_m': depth_now,
                'melt_mm': float(day_melt),
                'refreeze_mm': float(day_refreeze),
                'runoff_mm': float(day_runoff),
                'mean_density_kg_m3': mean_density
            })

            day_melt = 0.0
            day_refreeze = 0.0
            day_runoff = 0.0

    state_file = os.path.join(out_dir, 'snow_state.npy')
    np.save(state_file, daily_states)
    print(f'Saved daily state array: {state_file} (shape {daily_states.shape}, dtype {daily_states.dtype})')

    summary_df = pd.DataFrame(daily_summaries)
    summary_file = os.path.join(out_dir, 'snow_summary.csv')
    summary_df.to_csv(summary_file, index=False)
    print(f'Saved daily summary: {summary_file} ({len(summary_df)} rows)')

    final_swe = float(np.sum(ice + liq))
    mass_err = (final_swe - init_swe) - (cum_snowfall + cum_rainfall - cum_runoff)

    print('--- Simulation Diagnostics ---')
    print(f'Total Days: {n_days}')
    print(f'Initial SWE: {init_swe:.4f} mm, Final SWE: {final_swe:.4f} mm')
    print(f'Total Snowfall: {cum_snowfall:.4f} mm, Total Rainfall: {cum_rainfall:.4f} mm')
    print(f'Total Melt: {cum_melt:.4f} mm, Total Refreeze: {cum_refreeze:.4f} mm')
    print(f'Total Runoff: {cum_runoff:.4f} mm')
    print(f'Mass balance error: {mass_err:.6e} mm')

    fig_file = os.path.join(out_dir, 'snow_evolution.png')
    create_diagnostic_plot(
        days=summary_df['day'].values,
        swe_s=summary_df['swe_mm'].values,
        depth_s=summary_df['snow_depth_m'].values,
        density_s=summary_df['mean_density_kg_m3'].values,
        states=daily_states,
        melt_s=summary_df['melt_mm'].values,
        refr_s=summary_df['refreeze_mm'].values,
        runoff_s=summary_df['runoff_mm'].values,
        out_path=fig_file
    )

if __name__ == '__main__':
    run_snow_model()
