import pandas as pd

def main():
    df = pd.read_csv('data/meta-regression_study_data_heterogeneity_in_replication_projects.csv')
    
    summary = {}
    for disc, g in df.groupby('discipline'):
        n_titles = g['title'].nunique()
        stud_o = sum((group['subjects.o'] == 'students').any() for _, group in g.groupby('title'))
        stud_r = sum((group['subjects.r'] == 'students').any() for _, group in g.groupby('title'))
        summary[disc] = {
            'total_studies': n_titles,
            'original_students_count': stud_o,
            'original_students_pct': round(stud_o / n_titles * 100, 1),
            'replication_students_count': stud_r,
            'replication_students_pct': round(stud_r / n_titles * 100, 1),
        }
    
    print("Discipline Subject Summary:")
    for disc, stats in summary.items():
        print(f"Discipline: {disc}")
        print(f"  Total Studies: {stats['total_studies']}")
        print(f"  Original with Student Subjects: {stats['original_students_count']} ({stats['original_students_pct']}%)")
        print(f"  Replication with Student Subjects: {stats['replication_students_count']} ({stats['replication_students_pct']}%)")

if __name__ == '__main__':
    main()
