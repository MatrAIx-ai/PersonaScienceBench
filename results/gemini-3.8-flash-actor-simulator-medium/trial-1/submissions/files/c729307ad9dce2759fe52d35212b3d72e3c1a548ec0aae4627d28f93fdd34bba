import pandas as pd
import json

def run_analysis():
    df = pd.read_csv('data/meta-regression_study_data_heterogeneity_in_replication_projects.csv')
    
    # RPP subset
    rpp = df[df['project'] == 'rpp']
    rpp_nodrop = rpp[rpp['drop'] == False]
    
    # Replicated counts
    rpp_rep_all = rpp[rpp['replicated'] == 1]
    rpp_rep_nodrop = rpp_nodrop[rpp_nodrop['replicated'] == 1]
    
    # Assistant Professor counts
    ap_r_all = int((rpp_rep_all['seniority.r'] == 'Assistant Professor').sum())
    ap_r_nodrop = int((rpp_rep_nodrop['seniority.r'] == 'Assistant Professor').sum())
    
    ap_o_all = int((rpp_rep_all['seniority.o'] == 'Assistant Professor').sum())
    ap_o_nodrop = int((rpp_rep_nodrop['seniority.o'] == 'Assistant Professor').sum())
    
    results = {
        "rpp_replicated_total_all": len(rpp_rep_all),
        "rpp_replicated_total_nodrop": len(rpp_rep_nodrop),
        "prop_junior_prof_replication_team_all": ap_r_all / len(rpp_rep_all),
        "prop_junior_prof_replication_team_nodrop": ap_r_nodrop / len(rpp_rep_nodrop),
        "prop_junior_prof_original_authors_all": ap_o_all / len(rpp_rep_all),
        "prop_junior_prof_original_authors_nodrop": ap_o_nodrop / len(rpp_rep_nodrop),
        "seniority_r_counts_all": {str(k): int(v) for k, v in rpp.groupby('replicated')['seniority.r'].value_counts().items()},
        "seniority_o_counts_all": {str(k): int(v) for k, v in rpp.groupby('replicated')['seniority.o'].value_counts().items()},
    }
    
    print(json.dumps(results, indent=2))
    return results

if __name__ == '__main__':
    run_analysis()
