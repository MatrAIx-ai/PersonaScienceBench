import pandas as pd
import numpy as np
from scipy import stats
from statsmodels.stats.contingency_tables import mcnemar

def main():
    # 1. Load data
    df = pd.read_csv('data/requirements_engineering_for_ML-enabled_systems.csv')
    print(f"Total dataset rows: {len(df)}, columns: {len(df.columns)}")

    # 2. Extract Q9 elicitation columns
    q9_cols = {
        'Q9_ML_Elicitation_Interviews': 'Interviews',
        'Q9_ML_Elicitation_Scenarios': 'Scenarios',
        'Q9_ML_Elicitation_Prototyping': 'Prototyping',
        'Q9_ML_Elicitation_Workshops_Meetings': 'Workshops/Meetings',
        'Q9_ML_Elicitation_Observation': 'Observation',
        'Q9_ML_Elicitation_Others': 'Others'
    }

    # 3. Clean negative sentinel values (-77 indicates missing/unanswered in Q9)
    valid_df = df[df['Q9_ML_Elicitation_Interviews'] != '-77'].copy()
    n_valid = len(valid_df)
    print(f"Valid respondents answering Q9 (excluding -77): {n_valid}")

    # 4. Binary encoding
    summary_data = []
    for col, name in q9_cols.items():
        quoted_cnt = (valid_df[col] == 'quoted').sum()
        pct_valid = quoted_cnt / n_valid * 100
        pct_total = quoted_cnt / len(df) * 100
        summary_data.append({
            'variable': col,
            'technique': name,
            'quoted_count': quoted_cnt,
            'pct_valid': pct_valid,
            'pct_total': pct_total
        })

    summary_df = pd.DataFrame(summary_data).sort_values(by='quoted_count', ascending=False)
    print("\n--- Requirements Elicitation Techniques Ranking ---")
    print(summary_df.to_string(index=False))

    # 5. Bootstrap confidence intervals (B=10000)
    np.random.seed(42)
    B = 10000
    print(f"\n--- Bootstrap 95% Confidence Intervals (B={B}) ---")
    for _, row in summary_df.iterrows():
        col = row['variable']
        name = row['technique']
        arr = (valid_df[col] == 'quoted').astype(int).values
        boot_means = np.random.choice(arr, size=(B, n_valid), replace=True).mean(axis=1) * 100
        ci_low = np.percentile(boot_means, 2.5)
        ci_high = np.percentile(boot_means, 97.5)
        print(f"{name:<20}: Mean = {boot_means.mean():.2f}%, 95% CI = [{ci_low:.2f}%, {ci_high:.2f}%]")

    # 6. Statistical significance: Paired McNemar tests between Interviews and competitors
    print("\n--- Statistical Significance (Interviews vs Others) ---")
    interviews_arr = (valid_df['Q9_ML_Elicitation_Interviews'] == 'quoted')
    for col, name in q9_cols.items():
        if col == 'Q9_ML_Elicitation_Interviews':
            continue
        comp_arr = (valid_df[col] == 'quoted')
        ct = pd.crosstab(interviews_arr, comp_arr)
        res = mcnemar(ct, exact=False, correction=True)
        print(f"Interviews vs {name:<20}: McNemar stat = {res.statistic:.4f}, p-value = {res.pvalue:.4e}")

if __name__ == '__main__':
    main()
