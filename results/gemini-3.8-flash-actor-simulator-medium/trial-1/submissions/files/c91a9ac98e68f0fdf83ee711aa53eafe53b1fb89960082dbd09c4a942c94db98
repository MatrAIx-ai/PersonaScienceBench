#!/usr/bin/env python3
"""
Analysis script for BixBench bix-46-q1:
Determine the log2 fold change for mexG expression in ΔrhlI (strain #97) compared to wt (strain #1).
"""

import gzip
import struct
import pandas as pd


def parse_rds(filepath):
    """
    Parse an R serialized object (RDS version 3 / 2) into Python objects.
    """
    with gzip.open(filepath, 'rb') as f:
        buf = f.read()

    pos = 0

    # Read RDS header
    magic = buf[pos:pos+2]
    pos += 2
    if magic != b'X\n':
        raise ValueError(f"Unsupported RDS magic: {magic}")

    version, r_ver, min_ver = struct.unpack('>III', buf[pos:pos+12])
    pos += 12

    if version == 3:
        enc_len = struct.unpack('>I', buf[pos:pos+4])[0]
        pos += 4
        enc = buf[pos:pos+enc_len]
        pos += enc_len

    ref_table = []

    def read_item():
        nonlocal pos
        p = pos
        flags = struct.unpack('>I', buf[pos:pos+4])[0]
        pos += 4
        stype = flags & 255
        has_attr = bool(flags & 0x200)
        has_tag = bool(flags & 0x400)

        # 254 is NILVALUE_SXP (NULL)
        if stype == 254 or stype == 0:
            return None

        # 255 is REFSXP
        if stype == 255:
            ref_idx = (flags >> 8)
            if ref_idx == 0:
                ref_idx = struct.unpack('>i', buf[pos:pos+4])[0]
                pos += 4
            return ref_table[ref_idx - 1]

        # 1: SYMSXP (symbol)
        if stype == 1:
            item = {'type': 'symbol'}
            ref_table.append(item)
            item['name'] = read_item()
            return item

        # 9: CHARSXP (character string)
        if stype == 9:
            length = struct.unpack('>i', buf[pos:pos+4])[0]
            pos += 4
            if length == -1:
                s = None
            else:
                s = buf[pos:pos+length].decode('utf-8', errors='replace')
                pos += length
            ref_table.append(s)
            return s

        # 2: LISTSXP (pairlist)
        if stype == 2:
            item = {'type': 'pairlist'}
            ref_table.append(item)
            item['attr'] = read_item() if has_attr else None
            item['tag'] = read_item() if has_tag else None
            item['car'] = read_item()
            item['cdr'] = read_item()
            return item

        # 25: S4SXP (S4 object)
        if stype == 25:
            item = {'type': 'S4'}
            ref_table.append(item)
            item['attr'] = read_item() if has_attr else None
            return item

        # 10: LGLSXP, 13: INTSXP, 14: REALSXP
        if stype in (10, 13, 14):
            length = struct.unpack('>i', buf[pos:pos+4])[0]
            pos += 4
            stride = 8 if stype == 14 else 4
            fmt = f'>{length}d' if stype == 14 else f'>{length}i'
            vals = struct.unpack(fmt, buf[pos:pos+stride*length])
            pos += stride * length
            item = {'type': stype, 'vals': vals}
            ref_table.append(item)
            item['attr'] = read_item() if has_attr else None
            return item

        # 16: STRSXP (string vector)
        if stype == 16:
            length = struct.unpack('>i', buf[pos:pos+4])[0]
            pos += 4
            item = {'type': 'str', 'vals': []}
            ref_table.append(item)
            item['vals'] = [read_item() for _ in range(length)]
            item['attr'] = read_item() if has_attr else None
            return item

        # 19: VECSXP (generic list)
        if stype == 19:
            length = struct.unpack('>i', buf[pos:pos+4])[0]
            pos += 4
            item = {'type': 'list', 'vals': []}
            ref_table.append(item)
            item['vals'] = [read_item() for _ in range(length)]
            item['attr'] = read_item() if has_attr else None
            return item

        raise ValueError(f'Unhandled stype {stype} at pos {p}')

    return read_item()


def main():
    # Step 1: Map mexG to locus tag
    anno_path = 'data/Pseudomonas_aeruginosa_UCBPP-PA14.csv'
    anno_df = pd.read_csv(anno_path)
    mexg_match = anno_df[anno_df['Gene Name'] == 'mexG']
    if mexg_match.empty:
        raise ValueError("mexG not found in genome annotation")
    locus_tag = mexg_match['Locus Tag'].values[0]
    product_name = mexg_match['Product Name'].values[0]
    print(f"Gene Name: mexG")
    print(f"Locus Tag: {locus_tag}")
    print(f"Product: {product_name}")

    # Step 2: Parse RDS differential expression results
    rds_path = 'data/res_1vs97.rds'
    res_obj = parse_rds(rds_path)

    # Extract rownames (genes)
    curr = res_obj['attr']
    rownames = None
    while curr:
        car = curr.get('car')
        if isinstance(car, dict) and car.get('type') == 'str' and len(car.get('vals', [])) == 5828:
            rownames = car['vals']
            break
        curr = curr.get('cdr')

    if rownames is None:
        raise ValueError("Could not find rownames in DESeqResults object")

    # Extract columns
    cols = None
    curr = res_obj['attr']
    while curr:
        car = curr.get('car')
        if isinstance(car, dict) and car.get('type') == 'list' and len(car.get('vals', [])) == 6:
            if len(car['vals'][0]['vals']) == 5828:
                cols = car['vals']
                break
        curr = curr.get('cdr')

    if cols is None:
        raise ValueError("Could not find data columns in DESeqResults object")

    colnames = ['baseMean', 'log2FoldChange', 'lfcSE', 'stat', 'pvalue', 'padj']
    df = pd.DataFrame({col: cols[i]['vals'] for i, col in enumerate(colnames)}, index=rownames)

    # Step 3: Extract statistics for mexG (PA14_09540)
    mexg_stats = df.loc[locus_tag]
    print("\n--- mexG (PA14_09540) Differential Expression Results ---")
    for col in colnames:
        print(f"  {col}: {mexg_stats[col]}")

    log2fc_raw = mexg_stats['log2FoldChange']
    log2fc_rounded = round(log2fc_raw, 2)
    print(f"\nRaw log2FoldChange: {log2fc_raw}")
    print(f"Rounded log2FoldChange (2 decimal places): {log2fc_rounded}")

    # Save summary table
    summary_df = pd.DataFrame([{
        'Gene Name': 'mexG',
        'Locus Tag': locus_tag,
        'Product Name': product_name,
        'baseMean': mexg_stats['baseMean'],
        'log2FoldChange': log2fc_raw,
        'log2FoldChange_rounded': log2fc_rounded,
        'lfcSE': mexg_stats['lfcSE'],
        'stat': mexg_stats['stat'],
        'pvalue': mexg_stats['pvalue'],
        'padj': mexg_stats['padj']
    }])
    summary_df.to_csv('mexG_results.csv', index=False)
    print("\nSummary saved to mexG_results.csv")


if __name__ == '__main__':
    main()
