import pandas as pd
from scipy.stats import chi2_contingency, fisher_exact

def run_analysis():
    # Load clinical trial datasets
    dm = pd.read_csv('data/TASK008_BCG-CORONA_DM.csv')
    ae = pd.read_csv('data/TASK008_BCG-CORONA_AE.csv')

    # Merge demographic and adverse event data on subject ID and treatment group
    merged = pd.merge(ae, dm[['USUBJID', 'patients_seen', 'TRTGRP']], on=['USUBJID', 'TRTGRP'], how='inner')

    # Filter COVID-19 adverse events
    covid_terms = ['COVID-19', 'COVID-19 pneumonia', 'Asymptomatic COVID-19', 'SARS-CoV-2 test positive']
    covid = merged[merged['AEPT'].isin(covid_terms)].dropna(subset=['AESEV']).copy()

    # Define binary severity: Mild/Moderate (1-2) vs Severe/Life-threatening (3-4)
    covid['sev_bin'] = covid['AESEV'].apply(lambda x: 'Mild/Moderate (1-2)' if x in [1, 2] else 'Severe/Life-threatening (3-4)')

    groups = ['1-50', '51-100', '>100']
    summary_records = []

    print("========================================================================")
    print("TASK008 BCG-CORONA: COVID-19 Severity Analysis by Patient Volume Group")
    print("========================================================================")

    for pvg in groups:
        sub = covid[covid['patients_seen'] == pvg]
        ct = pd.crosstab(sub['TRTGRP'], sub['sev_bin'])

        chi2_nc, p_nc, dof, exp = chi2_contingency(ct, correction=False)
        chi2_c, p_c, _, _ = chi2_contingency(ct, correction=True)
        odds, p_fish = fisher_exact(ct)

        exp_df = pd.DataFrame(exp, index=ct.index, columns=ct.columns)

        print(f"\n--- Patient Volume Group: {pvg} (N = {len(sub)}) ---")
        print("Observed Frequencies:")
        print(ct)
        print("\nExpected Frequencies:")
        print(exp_df.round(2))
        print(f"\nChi-Square (uncorrected): chi2 = {chi2_nc:.4f}, df = {dof}, p = {p_nc:.5f}")
        print(f"Chi-Square (Yates-corrected): chi2 = {chi2_c:.4f}, df = {dof}, p = {p_c:.5f}")
        print(f"Fisher's Exact Test: p = {p_fish:.5f}")

        is_significant = p_nc < 0.05
        print(f"Statistically significant (p < 0.05): {is_significant}")

        summary_records.append({
            'patient_volume_group': pvg,
            'N': len(sub),
            'chi2_uncorrected': chi2_nc,
            'df': dof,
            'p_uncorrected': p_nc,
            'chi2_corrected': chi2_c,
            'p_corrected': p_c,
            'fisher_p': p_fish,
            'significant_p_lt_005': is_significant
        })

    summary_df = pd.DataFrame(summary_records)
    summary_df.to_csv('severity_analysis_summary.csv', index=False)
    print("\nSummary Results Table:")
    print(summary_df.to_string(index=False))

    sig_groups = summary_df.loc[summary_df['significant_p_lt_005'], 'patient_volume_group'].tolist()
    print(f"\nIdentified group with p < 0.05: {sig_groups}")

if __name__ == '__main__':
    run_analysis()
