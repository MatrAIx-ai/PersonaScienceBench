import time
import numpy as np
import scipy.fft

def get_cc_vel(ux, uy):
    return 0.5 * (ux[:-1, :] + ux[1:, :]), 0.5 * (uy[:, :-1] + uy[:, 1:])

def get_cc_vorticity(u_cc, v_cc, dx):
    N = u_cc.shape[0]
    ip = np.clip(np.arange(N) + 1, 0, N - 1)
    im = np.clip(np.arange(N) - 1, 0, N - 1)
    jp = np.clip(np.arange(N) + 1, 0, N - 1)
    jm = np.clip(np.arange(N) - 1, 0, N - 1)
    return (v_cc[ip, :] - v_cc[im, :]) / (2.0 * dx) - (u_cc[:, jp] - u_cc[:, jm]) / (2.0 * dx)

def get_ke(u_cc, v_cc, dx):
    return 0.5 * (dx**2) * np.sum(u_cc**2 + v_cc**2)

def interp_multi(fields, px, py, dx, N):
    gx = px / dx - 0.5; gy = py / dx - 0.5
    i0 = np.clip(np.floor(gx).astype(int), 0, N - 2)
    j0 = np.clip(np.floor(gy).astype(int), 0, N - 2)
    fx = gx - i0; fy = gy - j0
    w00 = (1.0 - fx) * (1.0 - fy); w10 = fx * (1.0 - fy)
    w01 = (1.0 - fx) * fy; w11 = fx * fy
    return [w00 * f[i0, j0] + w10 * f[i0+1, j0] + w01 * f[i0, j0+1] + w11 * f[i0+1, j0+1] for f in fields]

def main():
    t_start = time.time()
    N = 135
    dx = 1.0 / N
    CFL = 1.8797
    dt_frame = 0.1
    total_frames = 107
    target_frames = [0, 26, 52, 78, 104]

    ux = np.load('data/initial_u_x.npy').astype(np.float64)
    uy = np.load('data/initial_u_y.npy').astype(np.float64)

    k = np.arange(1, N)
    eig_x = 2.0 * (np.cos(k * np.pi / N) - 1.0) / (dx**2)
    eig_y = 2.0 * (np.cos(k * np.pi / N) - 1.0) / (dx**2)
    eig_grid = eig_x[:, None] + eig_y[None, :]

    def solve_poisson(omega_int):
        psi_hat = scipy.fft.dstn(-omega_int, type=1) / eig_grid
        psi_int = scipy.fft.idstn(psi_hat, type=1)
        psi = np.zeros((N + 1, N + 1), dtype=np.float64)
        psi[1:-1, 1:-1] = psi_int
        return psi

    ke_arr = np.zeros(total_frames + 1, dtype=np.float32)
    vort_arr = np.zeros((len(target_frames), N, N), dtype=np.float32)

    u_cc, v_cc = get_cc_vel(ux, uy)
    ke_arr[0] = get_ke(u_cc, v_cc, dx)
    vort_arr[0] = get_cc_vorticity(u_cc, v_cc, dx).astype(np.float32)
    print(f'Frame   0/{total_frames}: KE = {ke_arr[0]:.8e}')

    omega_node = np.zeros((N + 1, N + 1), dtype=np.float64)
    omega_node[1:-1, 1:-1] = (uy[1:, 1:-1] - uy[:-1, 1:-1]) / dx - (ux[1:-1, 1:] - ux[1:-1, :-1]) / dx

    sub = (np.arange(4) + 0.5) / 4.0
    cx = np.arange(N); cy = np.arange(N)
    init_px = (cx[:, None, None, None] + sub[None, None, :, None]).repeat(N, axis=1).repeat(4, axis=3).ravel() * dx
    init_py = (cy[None, :, None, None] + sub[None, None, None, :]).repeat(N, axis=0).repeat(4, axis=2).ravel() * dx
    Np = len(init_px)

    ix_p = np.clip(np.floor(init_px / dx + 0.5).astype(int), 1, N - 1)
    iy_p = np.clip(np.floor(init_py / dx + 0.5).astype(int), 1, N - 1)
    fx_p = init_px / dx - ix_p; fy_p = init_py / dx - iy_p
    wx_p = np.stack([0.5 * (0.5 - fx_p)**2, 0.75 - fx_p**2, 0.5 * (0.5 + fx_p)**2], axis=-1)
    wy_p = np.stack([0.5 * (0.5 - fy_p)**2, 0.75 - fy_p**2, 0.5 * (0.5 + fy_p)**2], axis=-1)
    dwx_p = np.stack([fx_p - 0.5, -2.0 * fx_p, fx_p + 0.5], axis=-1) / dx
    dwy_p = np.stack([fy_p - 0.5, -2.0 * fy_p, fy_p + 0.5], axis=-1) / dx

    ix_int, iy_int = np.meshgrid(np.arange(1, N), np.arange(1, N), indexing='ij')
    nx = ix_int * dx; ny = iy_int * dx

    ip = np.clip(np.arange(N) + 1, 0, N - 1); im = np.clip(np.arange(N) - 1, 0, N - 1)
    jp = np.clip(np.arange(N) + 1, 0, N - 1); jm = np.clip(np.arange(N) - 1, 0, N - 1)
    c_min = 0.5 * dx; c_max = 1.0 - 0.5 * dx

    for frame_idx in range(1, total_frames + 1):
        t_rem = dt_frame
        while t_rem > 1e-12:
            u_cc, v_cc = get_cc_vel(ux, uy)
            max_u = max(float(np.max(np.sqrt(u_cc**2 + v_cc**2))), 1e-6)
            dt_sub = min(CFL * dx / max_u, t_rem)

            # 1. Midpoint velocity
            h_mid = 0.5 * dt_sub
            u1, v1 = interp_multi([u_cc, v_cc], nx, ny, dx, N)
            x2 = np.clip(nx - 0.5 * h_mid * u1, c_min, c_max); y2 = np.clip(ny - 0.5 * h_mid * v1, c_min, c_max)
            u2, v2 = interp_multi([u_cc, v_cc], x2, y2, dx, N)
            x3 = np.clip(nx - 0.5 * h_mid * u2, c_min, c_max); y3 = np.clip(ny - 0.5 * h_mid * v2, c_min, c_max)
            u3, v3 = interp_multi([u_cc, v_cc], x3, y3, dx, N)
            x4 = np.clip(nx - h_mid * u3, c_min, c_max); y4 = np.clip(ny - h_mid * v3, c_min, c_max)
            u4, v4 = interp_multi([u_cc, v_cc], x4, y4, dx, N)

            xb = np.clip(nx - (h_mid / 6.0) * (u1 + 2*u2 + 2*u3 + u4), c_min, c_max)
            yb = np.clip(ny - (h_mid / 6.0) * (v1 + 2*v2 + 2*v3 + v4), c_min, c_max)

            gxb = xb / dx; gyb = yb / dx
            i0b = np.clip(np.floor(gxb).astype(int), 0, N - 1); j0b = np.clip(np.floor(gyb).astype(int), 0, N - 1)
            fxb = gxb - i0b; fyb = gyb - j0b
            om_mid = ((1.0 - fxb) * (1.0 - fyb) * omega_node[i0b, j0b] +
                      fxb * (1.0 - fyb) * omega_node[i0b+1, j0b] +
                      (1.0 - fxb) * fyb * omega_node[i0b, j0b+1] +
                      fxb * fyb * omega_node[i0b+1, j0b+1])

            psi_mid = solve_poisson(om_mid)
            ux_mid = (psi_mid[:, 1:] - psi_mid[:, :-1]) / dx
            uy_mid = -(psi_mid[1:, :] - psi_mid[:-1, :]) / dx
            ux_mid[0, :] = 0.0; ux_mid[-1, :] = 0.0
            uy_mid[:, 0] = 0.0; uy_mid[:, -1] = 0.0

            u_m_cc, v_m_cc = get_cc_vel(ux_mid, uy_mid)
            ux_cc = (u_m_cc[ip, :] - u_m_cc[im, :]) / (2.0 * dx)
            uy_cc = (u_m_cc[:, jp] - u_m_cc[:, jm]) / (2.0 * dx)
            vx_cc = (v_m_cc[ip, :] - v_m_cc[im, :]) / (2.0 * dx)
            vy_cc = (v_m_cc[:, jp] - v_m_cc[:, jm]) / (2.0 * dx)
            f_mid = [u_m_cc, v_m_cc, ux_cc, uy_cc, vx_cc, vy_cc]

            # 2. Reinitialize particles & G2P with gradient
            px = init_px.copy(); py = init_py.copy()
            om_p = np.zeros(Np); init_Cc_x = np.zeros(Np); init_Cc_y = np.zeros(Np)
            for a in range(3):
                for b in range(3):
                    gv = omega_node[ix_p + a - 1, iy_p + b - 1]
                    om_p += wx_p[:, a] * wy_p[:, b] * gv
                    init_Cc_x += dwx_p[:, a] * wy_p[:, b] * gv
                    init_Cc_y += wx_p[:, a] * dwy_p[:, b] * gv

            # 3. RK4 advection and T-matrix evolution
            T00 = np.ones(Np); T01 = np.zeros(Np); T10 = np.zeros(Np); T11 = np.ones(Np)
            def p_stage(x, y, t00, t01, t10, t11):
                u, v, dux, duy, dvx, dvy = interp_multi(f_mid, x, y, dx, N)
                G00 = -dux; G01 = -dvx; G10 = -duy; G11 = -dvy
                return u, v, G00*t00 + G01*t10, G00*t01 + G01*t11, G10*t00 + G11*t10, G10*t01 + G11*t11

            ku1, kv1, kT00_1, kT01_1, kT10_1, kT11_1 = p_stage(px, py, T00, T01, T10, T11)
            x2 = np.clip(px + 0.5*dt_sub*ku1, c_min, c_max); y2 = np.clip(py + 0.5*dt_sub*kv1, c_min, c_max)
            ku2, kv2, kT00_2, kT01_2, kT10_2, kT11_2 = p_stage(x2, y2, T00+0.5*dt_sub*kT00_1, T01+0.5*dt_sub*kT01_1, T10+0.5*dt_sub*kT10_1, T11+0.5*dt_sub*kT11_1)
            x3 = np.clip(px + 0.5*dt_sub*ku2, c_min, c_max); y3 = np.clip(py + 0.5*dt_sub*kv2, c_min, c_max)
            ku3, kv3, kT00_3, kT01_3, kT10_3, kT11_3 = p_stage(x3, y3, T00+0.5*dt_sub*kT00_2, T01+0.5*dt_sub*kT01_2, T10+0.5*dt_sub*kT10_2, T11+0.5*dt_sub*kT11_2)
            x4 = np.clip(px + dt_sub*ku3, c_min, c_max); y4 = np.clip(py + dt_sub*kv3, c_min, c_max)
            ku4, kv4, kT00_4, kT01_4, kT10_4, kT11_4 = p_stage(x4, y4, T00+dt_sub*kT00_3, T01+dt_sub*kT01_3, T10+dt_sub*kT10_3, T11+dt_sub*kT11_3)

            px_new = np.clip(px + (dt_sub / 6.0) * (ku1 + 2*ku2 + 2*ku3 + ku4), c_min, c_max)
            py_new = np.clip(py + (dt_sub / 6.0) * (kv1 + 2*kv2 + 2*kv3 + kv4), c_min, c_max)
            T00_new = T00 + (dt_sub / 6.0) * (kT00_1 + 2*kT00_2 + 2*kT00_3 + kT00_4)
            T01_new = T01 + (dt_sub / 6.0) * (kT01_1 + 2*kT01_2 + 2*kT01_3 + kT01_4)
            T10_new = T10 + (dt_sub / 6.0) * (kT10_1 + 2*kT10_2 + 2*kT10_3 + kT10_4)
            T11_new = T11 + (dt_sub / 6.0) * (kT11_1 + 2*kT11_2 + 2*kT11_3 + kT11_4)

            Cc_x = T00_new * init_Cc_x + T10_new * init_Cc_y
            Cc_y = T01_new * init_Cc_x + T11_new * init_Cc_y

            # 4. APIC P2G transfer
            ix_n = np.clip(np.floor(px_new / dx + 0.5).astype(int), 1, N - 1)
            iy_n = np.clip(np.floor(py_new / dx + 0.5).astype(int), 1, N - 1)
            fx_n = px_new / dx - ix_n; fy_n = py_new / dx - iy_n
            wx_n = np.stack([0.5 * (0.5 - fx_n)**2, 0.75 - fx_n**2, 0.5 * (0.5 + fx_n)**2], axis=-1)
            wy_n = np.stack([0.5 * (0.5 - fy_n)**2, 0.75 - fy_n**2, 0.5 * (0.5 + fy_n)**2], axis=-1)

            om_accum = np.zeros((N + 1, N + 1)); w_accum = np.zeros((N + 1, N + 1))
            for a in range(3):
                for b in range(3):
                    nx_a = np.clip(ix_n + a - 1, 0, N); ny_b = np.clip(iy_n + b - 1, 0, N)
                    dx_n = nx_a * dx - px_new; dy_n = ny_b * dx - py_new
                    w = wx_n[:, a] * wy_n[:, b]
                    aff = om_p + Cc_x * dx_n + Cc_y * dy_n
                    np.add.at(om_accum, (nx_a, ny_b), w * aff)
                    np.add.at(w_accum, (nx_a, ny_b), w)

            mask = w_accum > 0
            om_new = np.zeros((N + 1, N + 1))
            om_new[mask] = om_accum[mask] / w_accum[mask]

            # 5. Consistency update
            psi_new = solve_poisson(om_new[1:-1, 1:-1])
            ux = (psi_new[:, 1:] - psi_new[:, :-1]) / dx
            uy = -(psi_new[1:, :] - psi_new[:-1, :]) / dx
            ux[0, :] = 0.0; ux[-1, :] = 0.0
            uy[:, 0] = 0.0; uy[:, -1] = 0.0
            omega_node[1:-1, 1:-1] = (uy[1:, 1:-1] - uy[:-1, 1:-1]) / dx - (ux[1:-1, 1:] - ux[1:-1, :-1]) / dx

            t_rem -= dt_sub

        u_cc, v_cc = get_cc_vel(ux, uy)
        ke_arr[frame_idx] = get_ke(u_cc, v_cc, dx)
        if frame_idx in target_frames:
            t_idx = target_frames.index(frame_idx)
            vort_arr[t_idx] = get_cc_vorticity(u_cc, v_cc, dx).astype(np.float32)
        if frame_idx % 10 == 0 or frame_idx in target_frames:
            print(f'Frame {frame_idx:3d}/{total_frames}: KE = {ke_arr[frame_idx]:.8e}, elapsed: {time.time()-t_start:.1f}s')

    np.save('vorticity_frames.npy', vort_arr)
    np.save('kinetic_energy.npy', ke_arr)
    print(f'Done in {time.time()-t_start:.1f}s. Saved vorticity_frames.npy {vort_arr.shape} and kinetic_energy.npy {ke_arr.shape}')

if __name__ == '__main__':
    main()
