# PCA Analysis of Capital Forms in hundred-year time slices
import pandas as pd
import numpy as np

# Load capital dataset
df = pd.read_csv('data/capital.csv')
features = ['ZAxtSchwert', 'ZDolch', 'Zhausgr', 'ZCU_AU', 'Zamber', 'ZMonument', 
            'ZHort', 'ZSichel', 'ZBeil', 'ZMW', 'ZKeform', 'Zkeverz']

# Convert European decimal format to float
for col in features:
    df[col] = df[col].astype(str).str.replace(',', '.').astype(float)

# 1. PCA on full dataset (4300 - 500 BCE)
X = df[features].values
X_c = X - X.mean(axis=0)
cov = np.cov(X_c, rowvar=False)
eigvals, eigvecs = np.linalg.eigh(cov)
idx = np.argsort(eigvals)[::-1]
eigvals = eigvals[idx]
eigvecs = eigvecs[:, idx]

df['PC1'] = X_c @ eigvecs[:, 0]
df['PC2'] = X_c @ eigvecs[:, 1]

# Output results for YBA period (1100 - 500 BCE)
yba = df[df['BCE'] <= 1100][['BCE', 'group', 'PC1', 'PC2']]
print('YBA slices (PC1, PC2):')
print(yba.to_string(index=False))

# Loadings
loadings = pd.Series(eigvecs[:, 0], index=features)
print('\nPC1 Loadings:')
print(loadings.sort_values())
