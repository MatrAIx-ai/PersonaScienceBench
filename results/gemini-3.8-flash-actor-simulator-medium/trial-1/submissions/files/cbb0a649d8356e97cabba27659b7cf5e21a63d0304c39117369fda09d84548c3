#!/usr/bin/env python3
"""
Differential Gene Expression Analysis and Binomial Exact Test
Comparing three tissue contrasts:
1. Final Blood vs Baseline Blood
2. Dentate Gyrus vs Baseline Blood
3. Dentate Gyrus vs Final Blood
"""

import pandas as pd
import numpy as np
from scipy import stats
from statsmodels.stats.multitest import multipletests

def run_analysis():
    excel_path = "data/Data_deposition_RNAseq_Paroxetine_2017.xlsx"
    print(f"Loading data from {excel_path}...")
    
    # Load normalized count data
    df = pd.read_excel(excel_path, sheet_name="NormCount", skiprows=3)
    
    # Identify sample columns for each tissue group
    bl_samples = [c for c in df.columns if any(p in c for p in [
        'Control_baseline_blood', 'good_responder_baseline_blood', 'bad_responder_baseline_blood'
    ])]
    dg_samples = [c for c in df.columns if any(p in c for p in [
        'Control_dentate_gyrus', 'good_responder_dentate_gyrus', 'bad_responder_dentate_gyrus'
    ])]
    fi_samples = [c for c in df.columns if any(p in c for p in [
        'Control_final_blood', 'good_responder_final_blood', 'bad_responder_final_blood'
    ])]
    
    print(f"Baseline Blood samples: {len(bl_samples)}")
    print(f"Dentate Gyrus samples: {len(dg_samples)}")
    print(f"Final Blood samples: {len(fi_samples)}")
    
    bl_data = df[bl_samples].values.astype(float)
    dg_data = df[dg_samples].values.astype(float)
    fi_data = df[fi_samples].values.astype(float)
    
    comparisons = [
        ("Final vs Baseline Blood", fi_data, bl_data),
        ("Dentate gyrus vs Baseline blood", dg_data, bl_data),
        ("Dentate gyrus vs Final blood", dg_data, fi_data)
    ]
    
    results = []
    
    print("\n" + "="*80)
    print("DIFFERENTIAL EXPRESSION AND EXACT BINOMIAL TEST RESULTS")
    print("="*80)
    
    for comp_name, g1, g2 in comparisons:
        # Welch's t-test
        t_stat, p_val = stats.ttest_ind(g1, g2, axis=1, equal_var=False, nan_policy='omit')
        valid = ~np.isnan(p_val)
        
        # Multiple testing correction (FDR BH)
        reject, padj, _, _ = multipletests(p_val[valid], alpha=0.05, method='fdr_bh')
        
        mean1 = np.mean(g1[valid], axis=1)
        mean2 = np.mean(g2[valid], axis=1)
        
        # log2 fold change (adding pseudocount to avoid division by zero)
        log2fc = np.log2((mean1 + 1e-4) / (mean2 + 1e-4))
        
        # Significant DEGs (FDR < 0.05)
        sig_fdr = reject
        n_sig_fdr = np.sum(sig_fdr)
        
        # Substantial DEGs (FDR < 0.05 and |log2FC| > 1)
        sig_deg = reject & (np.abs(log2fc) > 1.0)
        n_deg = np.sum(sig_deg)
        n_up = np.sum(sig_deg & (log2fc > 1.0))
        n_down = np.sum(sig_deg & (log2fc < -1.0))
        
        # Strict DEGs (FDR < 0.05 and |log2FC| > 2)
        sig_deg_strict = reject & (np.abs(log2fc) > 2.0)
        n_deg_strict = np.sum(sig_deg_strict)
        
        # Binomial exact test of directional symmetry (Up vs Down)
        if n_deg > 0:
            binom_dir = stats.binomtest(n_up, n_deg, p=0.5)
            p_binom_dir = binom_dir.pvalue
        else:
            p_binom_dir = 1.0
            
        # Binomial exact test comparing DEG rate to 5% baseline
        total_genes = len(valid)
        binom_rate = stats.binomtest(n_deg, total_genes, p=0.05, alternative='greater')
        p_binom_rate = binom_rate.pvalue

        results.append({
            "Comparison": comp_name,
            "Total_Genes": total_genes,
            "FDR_0.05": n_sig_fdr,
            "DEG (|log2FC|>1)": n_deg,
            "Up (|log2FC|>1)": n_up,
            "Down (|log2FC|<-1)": n_down,
            "Strict_DEG (|log2FC|>2)": n_deg_strict,
            "Binom_Dir_Pval": p_binom_dir,
            "DEG_Percentage": (n_deg / total_genes) * 100
        })
        
        print(f"\n--- {comp_name} ---")
        print(f"Total analyzed genes: {total_genes}")
        print(f"Significant at FDR < 0.05: {n_sig_fdr} ({n_sig_fdr/total_genes*100:.2f}%)")
        print(f"Substantial DEGs (|log2FC| > 1, FDR < 0.05): {n_deg} ({n_deg/total_genes*100:.2f}%)")
        print(f"  - Up-regulated: {n_up}")
        print(f"  - Down-regulated: {n_down}")
        print(f"Strict DEGs (|log2FC| > 2, FDR < 0.05): {n_deg_strict} ({n_deg_strict/total_genes*100:.2f}%)")
        print(f"Exact Binomial Directional test p-value: {p_binom_dir:.4e}")
        
    res_df = pd.DataFrame(results)
    print("\n" + "="*80)
    print("SUMMARY COMPARISON TABLE")
    print("="*80)
    print(res_df.to_string(index=False))
    
    print("\nConclusion:")
    print("Comparison showing negligible effects: Final vs Baseline Blood")

if __name__ == "__main__":
    run_analysis()
