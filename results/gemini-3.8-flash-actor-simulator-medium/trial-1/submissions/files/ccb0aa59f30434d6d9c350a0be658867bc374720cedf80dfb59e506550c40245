import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf

# 1. Load Data
df = pd.read_csv('data/nls_raw.csv')
print(f"Loaded dataset with {df.shape[0]} rows and {df.shape[1]} columns.")

# 2. Race / Ethnicity Identification
# In NLSY79: 1 = Hispanic, 2 = Black, 3 = Non-Black Non-Hispanic
# Focus on Black (2) vs White / Non-Black Non-Hispanic (3)
df_sub = df[df['Racial/ethnic cohort, 1979'].isin([2, 3])].copy()
df_sub['black'] = (df_sub['Racial/ethnic cohort, 1979'] == 2).astype(int)

# 3. Socioeconomic Status (SES) Indicators
# Parental education: average of mother's and father's highest grade completed
df_sub['mother_edu'] = df_sub["Highest grade completed by respondent's mother, 1979"]
df_sub['father_edu'] = df_sub["Highest grade completed by respondent's father, 1979"]
df_sub['parent_edu'] = df_sub[['mother_edu', 'father_edu']].mean(axis=1)

# Family income 1979
df_sub['fam_income_1979'] = df_sub['Total net family income, previous calendar year, 1979']

# Family wealth 1985 & 1996
df_sub['wealth_1985'] = df_sub['Family net wealth, 1985']
df_sub['wealth_1996'] = df_sub['Family net wealth, 1996 (key data point)']

# Academic ability / ASVAB composite
asvab_cols = [
    'ASVAB - Arithmetic Reasoning Z Score (rounded), 1981',
    'ASVAB - Word Knowledge Z Score (rounded), 1981',
    'ASVAB - Paragraph Comprehension Z Score (rounded), 1981',
    'ASVAB - Mathematics Knowledge Z Score (rounded), 1981'
]
df_sub['asvab_comp'] = df_sub[asvab_cols].mean(axis=1)

# Educational attainment proxies:
# A. College dorm residence during typical college ages (1981-1985)
dorm_cols = [c for c in df_sub.columns if 'residence' in c.lower() and any(yr in c for yr in ['1981', '1982', '1983', '1984', '1985'])]
df_sub['college_dorm'] = (df_sub[dorm_cols] == 3).any(axis=1).astype(int)

# B. Adult education proxy: highest grade completed in 1979 for older respondents (age >= 21)
df_sub['ba_completed_1979'] = (df_sub['Highest grade completed, 1979'] >= 16).astype(int)

# Standardized SES composite index
def standardize(s):
    return (s - s.mean()) / s.std()

z_edu = standardize(df_sub['parent_edu'])
z_inc = standardize(np.log(np.maximum(df_sub['fam_income_1979'].fillna(df_sub['fam_income_1979'].median()), 1)))
z_wealth = standardize(np.log(np.maximum(df_sub['wealth_1985'].fillna(df_sub['wealth_1985'].median()), 1)))
df_sub['ses_index'] = (z_edu.fillna(0) + z_inc.fillna(0) + z_wealth.fillna(0)) / 3.0

df_sub['ses_tercile'] = pd.qcut(df_sub['ses_index'], 3, labels=['Low SES', 'Middle SES', 'High SES'])

# 4. Empirical Stratification: College Trajectory by SES and Race
tab = df_sub.groupby(['ses_tercile', 'black'])['college_dorm'].agg(['count', 'mean']).unstack()
print("\n--- College Dormitory Residence by SES Tercile and Race ---")
print(tab)

# 5. Logistic Regression: Testing Race x SES Interaction
model = smf.logit('college_dorm ~ black * ses_index + asvab_comp + C(Sex_of_respondent__1979)', 
                  data=df_sub.rename(columns={'Sex of respondent, 1979': 'Sex_of_respondent__1979'})).fit()
print("\n--- Logistic Regression Model Summary ---")
print(model.summary())

# Calculate rate differences across SES terciles
for ses_cat in ['Low SES', 'Middle SES', 'High SES']:
    sub = df_sub[df_sub['ses_tercile'] == ses_cat]
    w_rate = sub[sub['black'] == 0]['college_dorm'].mean()
    b_rate = sub[sub['black'] == 1]['college_dorm'].mean()
    diff = b_rate - w_rate
    odds_ratio = (b_rate / (1 - b_rate)) / (w_rate / (1 - w_rate)) if w_rate > 0 else np.nan
    print(f"{ses_cat}: White rate = {w_rate:.4f}, Black rate = {b_rate:.4f}, Difference = {diff:+.4f}, Odds Ratio = {odds_ratio:.2f}")

print("\nAnalysis complete.")
