"""
Analysis of Urban Land Use Scenarios and Plant Invasion Pathways
Dataset: Barcelona Province / Catalonia non-native flora
"""

import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf

def run_analysis():
    # Load dataset
    df = pd.read_csv('data/invaded_niche_pathways.csv', sep='\t')
    df.columns = [c.replace('.', '_') for c in df.columns]

    print("=== 1. Summary Statistics of Invasion Richness by Pathway ===")
    pathways = ['n_unint', 'n_gard', 'n_agfo', 'n_total']
    summary = df[pathways].describe().T[['mean', 'std', 'min', '50%', 'max']]
    print(summary)

    print("\n=== 2. Mean Invasion Richness across Habitat Types ===")
    hab_summary = df.groupby('habitat')[pathways].mean()
    print(hab_summary)

    print("\n=== 3. Univariate Poisson & Negative Binomial GLMs across Scales and Years ===")
    urban_vars = [
        'urban_1956_50m', 'urban_1993_50m', 'urban_2009_50m',
        'urban_1956_500m', 'urban_1993_500m', 'urban_2009_500m',
        'urban_1956_1000m', 'urban_1993_1000m', 'urban_2009_1000m'
    ]

    records = []
    for p in pathways:
        for u in urban_vars:
            p_mod = smf.glm(f"{p} ~ {u}", data=df, family=sm.families.Poisson()).fit()
            try:
                nb_mod = smf.negativebinomial(f"{p} ~ {u}", data=df).fit(disp=False)
                nb_b = nb_mod.params[u]
                nb_z = nb_mod.tvalues[u]
                nb_p = nb_mod.pvalues[u]
                nb_aic = nb_mod.aic
            except Exception:
                nb_b, nb_z, nb_p, nb_aic = np.nan, np.nan, np.nan, np.nan

            records.append({
                'pathway': p,
                'urban_var': u,
                'poisson_coef': p_mod.params[u],
                'poisson_z': p_mod.tvalues[u],
                'poisson_p': p_mod.pvalues[u],
                'nb_coef': nb_b,
                'nb_z': nb_z,
                'nb_p': nb_p,
                'nb_aic': nb_aic
            })
    res_df = pd.DataFrame(records)
    print(res_df.to_string())

    print("\n=== 4. Multivariable GLMs Controlling for Topoclimatic & Anthropogenic Covariates ===")
    for col in ['elevation', 'distance_road', 'distance_stream', 'annual_temperature', 'annual_rainfall', 'annual_radiation']:
        df[col + '_z'] = (df[col] - df[col].mean()) / df[col].std()

    covars_z = 'elevation_z + distance_road_z + distance_stream_z + annual_temperature_z + annual_rainfall_z + annual_radiation_z'

    for p in ['n_unint', 'n_gard', 'n_agfo']:
        print(f"\n--- Multivariable Models for {p} ---")
        for u in ['urban_2009_50m', 'urban_2009_500m', 'urban_2009_1000m']:
            m = smf.negativebinomial(f"{p} ~ {u} + {covars_z}", data=df).fit(disp=False)
            print(f"{u:18s}: coef={m.params[u]:.4f}, z={m.tvalues[u]:.2f}, p={m.pvalues[u]:.4e}, AIC={m.aic:.1f}")

    print("\n=== 5. Combined Urban and Cropland Landscape Models (500m) ===")
    for p in ['n_unint', 'n_gard', 'n_agfo']:
        m = smf.negativebinomial(f"{p} ~ urban_2009_500m + cropland_2009_500m + {covars_z}", data=df).fit(disp=False)
        print(f"Target: {p}")
        print(f"  urban_2009_500m:    coef={m.params['urban_2009_500m']:.4f}, p={m.pvalues['urban_2009_500m']:.4e}")
        print(f"  cropland_2009_500m: coef={m.params['cropland_2009_500m']:.4f}, p={m.pvalues['cropland_2009_500m']:.4e}")

if __name__ == '__main__':
    run_analysis()
