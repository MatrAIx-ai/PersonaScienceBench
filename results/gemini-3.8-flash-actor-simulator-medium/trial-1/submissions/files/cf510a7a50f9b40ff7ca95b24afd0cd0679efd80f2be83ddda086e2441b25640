import json
import os
import time
import numpy as np
import pandas as pd

def run_simulation():
    start_time = time.time()
    input_path = os.path.join("data", "task_input.json")
    with open(input_path, "r", encoding="utf-8") as f:
        task_data = json.load(f)

    task_id = task_data.get("task_id", "fluid-square-wake-2d-001")
    units = task_data.get("units", "dimensionless")
    cases = task_data["cases"]

    results_dir = "results"
    os.makedirs(results_dir, exist_ok=True)

    # D2Q9 lattice parameters
    c = np.array([
        [0, 0],   # 0
        [1, 0],   # 1: +x
        [0, 1],   # 2: +y
        [-1, 0],  # 3: -x
        [0, -1],  # 4: -y
        [1, 1],   # 5: +x, +y
        [-1, 1],  # 6: -x, +y
        [-1, -1], # 7: -x, -y
        [1, -1]   # 8: +x, -y
    ], dtype=int)

    opp = np.array([0, 3, 4, 1, 2, 7, 8, 5, 6], dtype=int)
    w = np.array([4/9, 1/9, 1/9, 1/9, 1/9, 1/36, 1/36, 1/36, 1/36], dtype=float)

    summary_records = []
    force_records = []
    centerline_records = []
    transverse_records = []

    for case_idx, case in enumerate(cases):
        case_id = case["case_id"]
        nx = int(case["nx"])
        ny = int(case["ny"])
        uin = float(case["uin"])
        re = float(case["re"])
        square_center = case["square_center"]
        square_size = int(case["square_size"])
        n_steps = int(case["n_steps"])
        warmup_steps = int(case["warmup_steps"])
        sample_every = int(case["sample_every"])

        cx, cy = int(square_center[0]), int(square_center[1])
        half = square_size // 2

        nu = uin * square_size / re
        tau = 0.5 + 3.0 * nu
        omega = 1.0 / tau

        # Solid mask
        x_min = max(0, cx - half)
        x_max = min(nx, cx - half + square_size)
        y_min = max(0, cy - half)
        y_max = min(ny, cy - half + square_size)

        solid = np.zeros((ny, nx), dtype=bool)
        solid[y_min:y_max, x_min:x_max] = True

        # Precompute boundary links where fluid neighbor in direction c_i is solid
        link_mask = [((~solid) & np.roll(solid, shift=(-c[i, 1], -c[i, 0]), axis=(0, 1))) for i in range(9)]
        link_idx = [np.where(link_mask[i]) for i in range(9)]

        # Deterministic initial field
        rho = np.ones((ny, nx), dtype=float)
        ux = np.full((ny, nx), uin, dtype=float)
        uy = np.zeros((ny, nx), dtype=float)
        ux[solid] = 0.0
        uy[solid] = 0.0

        f = np.zeros((9, ny, nx), dtype=float)
        u2 = ux * ux + uy * uy
        for i in range(9):
            cu = c[i, 0] * ux + c[i, 1] * uy
            f[i] = w[i] * rho * (1.0 + 3.0 * cu + 4.5 * cu * cu - 1.5 * u2)

        # Inflow equilibrium profile
        u2_in = uin * uin
        feq_in = np.zeros(9, dtype=float)
        for i in range(9):
            cu = c[i, 0] * uin
            feq_in[i] = w[i] * 1.0 * (1.0 + 3.0 * cu + 4.5 * cu * cu - 1.5 * u2_in)

        f_post = np.zeros((9, ny, nx), dtype=float)

        print(f"[{case_idx+1}/{len(cases)}] Running case {case_id}: Re={re}, uin={uin}, nu={nu:.6f}, tau={tau:.6f}, steps={n_steps}...")
        t_case_start = time.time()

        case_sampled_cd = []
        case_sampled_cl = []

        for step in range(1, n_steps + 1):
            # Macroscopic variables
            rho = np.sum(f, axis=0)
            ux = (f[1] - f[3] + f[5] - f[6] - f[7] + f[8]) / rho
            uy = (f[2] - f[4] + f[5] + f[6] - f[7] - f[8]) / rho
            ux[solid] = 0.0
            uy[solid] = 0.0
            rho[solid] = 1.0

            # Collision
            u2 = ux * ux + uy * uy
            for i in range(9):
                cu = c[i, 0] * ux + c[i, 1] * uy
                feq_val = w[i] * rho * (1.0 + 3.0 * cu + 4.5 * cu * cu - 1.5 * u2)
                f_post[i] = f[i] - (f[i] - feq_val) * omega

            # Momentum exchange on solid boundary
            Fx = 0.0
            Fy = 0.0
            for i in range(1, 9):
                val = f_post[i][link_idx[i]]
                Fx += 2.0 * c[i, 0] * np.sum(val)
                Fy += 2.0 * c[i, 1] * np.sum(val)

            cd = Fx / (0.5 * uin * uin * square_size)
            cl = Fy / (0.5 * uin * uin * square_size)

            # 1. Stream all directions FIRST
            for i in range(9):
                f[i] = np.roll(f_post[i], shift=(c[i, 1], c[i, 0]), axis=(0, 1))

            # 2. Apply bounce-back on links AFTER all streaming is complete
            for i in range(1, 9):
                f[opp[i]][link_idx[i]] = f_post[i][link_idx[i]]

            # 3. Apply inflow Dirichlet equilibrium
            for i in range(9):
                f[i, :, 0] = feq_in[i]

            # 4. Outflow: zero-gradient extrapolation
            f[:, :, -1] = f[:, :, -2]

            # Sampling: exclude warmup_steps, sample steps satisfying (step - warmup_steps) % sample_every == 0
            if step >= warmup_steps and (step - warmup_steps) % sample_every == 0:
                force_records.append({
                    "case_id": case_id,
                    "step": step,
                    "cd": cd,
                    "cl": cl
                })
                case_sampled_cd.append(cd)
                case_sampled_cl.append(cl)

        t_case_end = time.time()
        print(f"  Completed in {t_case_end - t_case_start:.2f} s. Samples collected: {len(case_sampled_cd)}")

        # Final macroscopic fields
        rho = np.sum(f, axis=0)
        ux = (f[1] - f[3] + f[5] - f[6] - f[7] + f[8]) / rho
        uy = (f[2] - f[4] + f[5] + f[6] - f[7] - f[8]) / rho
        ux[solid] = 0.0
        uy[solid] = 0.0

        # Statistics
        cd_arr = np.array(case_sampled_cd)
        cl_arr = np.array(case_sampled_cl)
        cd_mean = float(np.mean(cd_arr))
        cl_rms = float(np.sqrt(np.mean(cl_arr ** 2)))
        converged = bool(cl_rms < 1e-2)

        summary_records.append({
            "case_id": case_id,
            "nx": nx,
            "ny": ny,
            "re": re,
            "uin": uin,
            "nu": nu,
            "tau": tau,
            "n_steps": n_steps,
            "cd_mean": cd_mean,
            "cl_rms": cl_rms,
            "converged": converged
        })

        # Centerline: horizontal line at y = cy, x in [0, nx-1]
        for x in range(nx):
            centerline_records.append({
                "case_id": case_id,
                "x": x,
                "u": float(ux[cy, x])
            })

        # Transverse profile at x_probe = min(nx - 1, square_center_x + 2 * square_size)
        x_probe = min(nx - 1, cx + 2 * square_size)
        for y in range(ny):
            transverse_records.append({
                "case_id": case_id,
                "x_probe": x_probe,
                "y": y,
                "u": float(ux[y, x_probe]),
                "v": float(uy[y, x_probe])
            })

    # Write summary CSV
    df_summary = pd.DataFrame(summary_records)
    summary_cols = ["case_id", "nx", "ny", "re", "uin", "nu", "tau", "n_steps", "cd_mean", "cl_rms", "converged"]
    df_summary = df_summary[summary_cols]
    summary_path = os.path.join(results_dir, "fluid_summary.csv")
    df_summary.to_csv(summary_path, index=False)

    # Write force series CSV
    df_force = pd.DataFrame(force_records)
    force_cols = ["case_id", "step", "cd", "cl"]
    df_force = df_force[force_cols]
    force_path = os.path.join(results_dir, "fluid_force_series.csv")
    df_force.to_csv(force_path, index=False)

    # Write centerline CSV
    df_centerline = pd.DataFrame(centerline_records)
    centerline_cols = ["case_id", "x", "u"]
    df_centerline = df_centerline[centerline_cols]
    centerline_path = os.path.join(results_dir, "fluid_centerline.csv")
    df_centerline.to_csv(centerline_path, index=False)

    # Write transverse profile CSV
    df_transverse = pd.DataFrame(transverse_records)
    transverse_cols = ["case_id", "x_probe", "y", "u", "v"]
    df_transverse = df_transverse[transverse_cols]
    transverse_path = os.path.join(results_dir, "fluid_transverse_profile.csv")
    df_transverse.to_csv(transverse_path, index=False)

    # Write report JSON
    cd_mean_avg = float(df_summary["cd_mean"].mean())
    report_data = {
        "task_id": task_id,
        "units": units,
        "cd_mean_avg": cd_mean_avg,
        "method_summary": (
            "D2Q9 single-relaxation-time (BGK) lattice Boltzmann method for flow past a 2D square obstacle. "
            "Link-based half-way bounce-back boundary condition on the obstacle surface with exact momentum exchange "
            "evaluation for hydrodynamic drag (cd) and lift (cl). Inflow specified via Dirichlet equilibrium distribution "
            "at u = (uin, 0), zero-gradient extrapolation at outlet, and periodic boundary conditions in the transverse y direction."
        )
    }
    report_path = os.path.join(results_dir, "fluid_report.json")
    with open(report_path, "w", encoding="utf-8") as f:
        json.dump(report_data, f, indent=2)

    total_time = time.time() - start_time
    print(f"\nAll simulations completed in {total_time:.2f} s.")
    print(f"Generated:")
    print(f"  {summary_path}: {len(df_summary)} rows")
    print(f"  {force_path}: {len(df_force)} rows")
    print(f"  {centerline_path}: {len(df_centerline)} rows")
    print(f"  {transverse_path}: {len(df_transverse)} rows")
    print(f"  {report_path}")

if __name__ == "__main__":
    run_simulation()
