import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf

# Load the dataset
excel_path = "data/data.xlsx"
df = pd.read_excel(excel_path)

# Filter valid rows (Sequence numbers 1 to 80)
df = df.iloc[:80].copy()

# Preprocess Age
df['Age'] = pd.to_numeric(df['Age'])

# Define Response: 1 for Responders (PR / Group 1), 0 for Non-responders (SD/PD / Group 2)
df['Response'] = (df['Efficacy'] == 'PR').astype(int)

# Fit simple logistic regression model using statsmodels Logit
model = smf.logit('Response ~ Age', data=df).fit()

print("="*60)
print("LOGISTIC REGRESSION MODEL RESULTS")
print("="*60)
print(model.summary())

coef_age = model.params['Age']
se_age = model.bse['Age']
p_val = model.pvalues['Age']
ci_lower, ci_upper = model.conf_int().loc['Age']
odds_ratio = np.exp(coef_age)
or_ci_lower = np.exp(ci_lower)
or_ci_upper = np.exp(ci_upper)

print("\n" + "="*60)
print("AGE COEFFICIENT DETAILS")
print("="*60)
print(f"Coefficient (change in log-odds): {coef_age:.6f} (raw: {coef_age})")
print(f"Standard Error: {se_age:.6f}")
print(f"z-statistic: {model.tvalues['Age']:.4f}")
print(f"p-value: {p_val:.6e}")
print(f"95% CI for coef: [{ci_lower:.6f}, {ci_upper:.6f}]")
print(f"Odds Ratio (OR): {odds_ratio:.6f}")
print(f"95% CI for OR: [{or_ci_lower:.6f}, {or_ci_upper:.6f}]")
