import pandas as pd
import numpy as np

def run_analysis():
    cap = pd.read_csv('data/capital.csv', decimal=',')
    features = ['ZAxtSchwert', 'ZDolch', 'Zhausgr', 'ZCU_AU', 'Zamber', 'ZMonument', 'ZHort', 'ZSichel', 'ZBeil', 'ZMW', 'ZKeform', 'Zkeverz']
    X = cap[features].values.astype(float)

    # Standardized PCA
    mean = np.mean(X, axis=0)
    std = np.std(X, axis=0, ddof=1)
    X_std = (X - mean) / std
    U, S, Vt = np.linalg.svd(X_std, full_matrices=False)
    if Vt[0, features.index('ZCU_AU')] < 0:
        Vt[0] = -Vt[0]
    scores_corr = X_std @ Vt.T

    # Covariance PCA
    X_cov = X - mean
    U_cov, S_cov, Vt_cov = np.linalg.svd(X_cov, full_matrices=False)
    if Vt_cov[0, features.index('ZCU_AU')] < 0:
        Vt_cov[0] = -Vt_cov[0]
    scores_cov = X_cov @ Vt_cov.T

    cap['PC1_corr'] = scores_corr[:, 0]
    cap['PC2_corr'] = scores_corr[:, 1]
    cap['PC1_cov'] = scores_cov[:, 0]
    cap['PC2_cov'] = scores_cov[:, 1]

    yba = cap[cap['group'] == 'YBA']
    print(yba[['BCE', 'PC1_corr', 'PC2_corr', 'PC1_cov', 'PC2_cov']])

if __name__ == '__main__':
    run_analysis()
