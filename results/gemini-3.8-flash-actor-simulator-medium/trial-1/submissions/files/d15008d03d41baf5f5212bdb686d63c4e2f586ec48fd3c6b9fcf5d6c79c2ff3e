import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf

def main():
    df = pd.read_csv('data/nls_ses_processed.csv')
    df.columns = [c.replace(' ', '_').replace(':', '') for c in df.columns]
    df['BA'] = df['BA_DEGREE_COMPLETED'].astype(int)
    df['is_black'] = (df['SAMPLE_RACE'] == 'Black').astype(int)
    
    # Quantiles
    df['SES_tertile'] = pd.qcut(df['SES'], 3, labels=['Low', 'Medium', 'High'])
    df['SES_quartile'] = pd.qcut(df['SES'], 4, labels=['Q1_Low', 'Q2_MidLow', 'Q3_MidHigh', 'Q4_High'])
    
    # 1. Raw rates by tertile
    print("=== Raw BA Completion Rates by SES Tertile ===")
    t_table = df.groupby(['SES_tertile', 'SAMPLE_RACE'])['BA'].agg(['count', 'sum', 'mean'])
    t_table['percent'] = t_table['mean'] * 100
    print(t_table)
    
    # 2. Raw rates by quartile
    print("\n=== Raw BA Completion Rates by SES Quartile ===")
    q_table = df.groupby(['SES_quartile', 'SAMPLE_RACE'])['BA'].agg(['count', 'sum', 'mean'])
    q_table['percent'] = q_table['mean'] * 100
    print(q_table)
    
    # 3. Controlled Logistic Regression with Race * SES interaction
    print("\n=== Controlled Logistic Regression (White reference) ===")
    m_race = smf.logit(
        'BA ~ C(SAMPLE_RACE, Treatment("White")) * SES + ABILITY_COMPOSITE_OF_ASVAB_SCORE + PERCENTILE_IN_CLASS',
        data=df
    ).fit(disp=False)
    print(m_race.summary())
    
    # 4. Stratified by SES Quartiles
    print("\n=== Stratified Logistic Regressions by SES Quartile (Black vs White) ===")
    for q in ['Q1_Low', 'Q2_MidLow', 'Q3_MidHigh', 'Q4_High']:
        sub = df[df['SES_quartile'] == q]
        m = smf.logit(
            'BA ~ C(SAMPLE_RACE, Treatment("White")) + ABILITY_COMPOSITE_OF_ASVAB_SCORE + PERCENTILE_IN_CLASS',
            data=sub
        ).fit(disp=False)
        coef = m.params['C(SAMPLE_RACE, Treatment("White"))[T.Black]']
        se = m.bse['C(SAMPLE_RACE, Treatment("White"))[T.Black]']
        pval = m.pvalues['C(SAMPLE_RACE, Treatment("White"))[T.Black]']
        print(f"{q}: coef = {coef:+.4f}, SE = {se:.4f}, p = {pval:.4f}, OR = {np.exp(coef):.4f}")

if __name__ == '__main__':
    main()
