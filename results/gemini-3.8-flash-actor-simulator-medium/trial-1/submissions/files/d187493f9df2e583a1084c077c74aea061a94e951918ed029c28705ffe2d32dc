import numpy as np
import pandas as pd
from statsmodels.miscmodels.ordinal_model import OrderedModel

def run_analysis():
    # 1. Load datasets
    dm = pd.read_csv('data/TASK008_BCG-CORONA_DM.csv')
    ae = pd.read_csv('data/TASK008_BCG-CORONA_AE.csv')
    mh = pd.read_csv('data/TASK008_BCG-CORONA_MH.csv')

    # 2. Extract ongoing medical conditions (MHONGO == 'Yes')
    mh_ongo = mh[mh['MHONGO'] == 'Yes']
    mh_count = mh_ongo.groupby('USUBJID').size().reindex(dm['USUBJID'], fill_value=0).rename('mh_count')
    dm['mh_count'] = dm['USUBJID'].map(mh_count)

    def prepare_X(df):
        X = pd.DataFrame(index=df.index)
        X['mh_count'] = df['mh_count'].astype(float)
        # BCG vaccination status (Placebo as ref)
        X['trt_BCG'] = (df['TRTGRP'] == 'BCG').astype(float)
        # Patient interaction variables (1-50 as ref, No as ref)
        X['pts_51_100'] = (df['patients_seen'] == '51-100').astype(float)
        X['pts_gt100'] = (df['patients_seen'] == '>100').astype(float)
        X['expect_Yes'] = (df['expect_interact'] == 'Yes').astype(float)
        return X

    # -------------------------------------------------------------
    # Scenario 1 (Primary): Full cohort (N=1000)
    # Patients without COVID = 0, patients with COVID = severity level
    # -------------------------------------------------------------
    cov_broad = ae[ae['AEPT'].str.contains('COVID|SARS', case=False, na=False)]
    max_hs_broad = cov_broad.groupby('USUBJID')['AEHS'].max()

    # Model 1A: Broad COVID, severity = AEHS + 1 for COVID (asymptomatic=1, mild=2, ...), 0 for no COVID
    dm_1A = dm.copy()
    dm_1A['severity'] = 0
    for uid, hs in max_hs_broad.items():
        dm_1A.loc[dm_1A['USUBJID'] == uid, 'severity'] = int(hs) + 1

    X_1A = prepare_X(dm_1A)
    mod_1A = OrderedModel(dm_1A['severity'], X_1A, distr='logit')
    res_1A = mod_1A.fit(method='bfgs', disp=False)

    # Model 1B: Broad COVID, severity = AEHS for COVID (asymptomatic merged with 0), 0 for no COVID
    dm_1B = dm.copy()
    dm_1B['severity'] = 0
    for uid, hs in max_hs_broad.items():
        dm_1B.loc[dm_1B['USUBJID'] == uid, 'severity'] = int(hs)

    X_1B = prepare_X(dm_1B)
    mod_1B = OrderedModel(dm_1B['severity'], X_1B, distr='logit')
    res_1B = mod_1B.fit(method='bfgs', disp=False)

    # Model 1C: Strict AEPT == 'COVID-19', severity = AEHS, 0 for no COVID
    cov_strict = ae[ae['AEPT'] == 'COVID-19']
    max_hs_strict = cov_strict.groupby('USUBJID')['AEHS'].max()
    dm_1C = dm.copy()
    dm_1C['severity'] = 0
    for uid, hs in max_hs_strict.items():
        dm_1C.loc[dm_1C['USUBJID'] == uid, 'severity'] = int(hs)

    X_1C = prepare_X(dm_1C)
    mod_1C = OrderedModel(dm_1C['severity'], X_1C, distr='logit')
    res_1C = mod_1C.fit(method='bfgs', disp=False)

    # -------------------------------------------------------------
    # Scenario 2: COVID-19 positive cases only
    # -------------------------------------------------------------
    # Model 2A: Broad COVID (N=197)
    dm_2A = dm.merge(max_hs_broad.rename('severity'), on='USUBJID', how='inner')
    X_2A = prepare_X(dm_2A)
    mod_2A = OrderedModel(dm_2A['severity'].astype(int), X_2A, distr='logit')
    res_2A = mod_2A.fit(method='bfgs', disp=False)

    # Model 2B: Strict COVID (N=189)
    dm_2B = dm.merge(max_hs_strict.rename('severity'), on='USUBJID', how='inner')
    X_2B = prepare_X(dm_2B)
    mod_2B = OrderedModel(dm_2B['severity'].astype(int), X_2B, distr='logit')
    res_2B = mod_2B.fit(method='bfgs', disp=False)

    models = [
        ('1A: Full cohort (N=1000, broad COVID, no-COVID=0, COVID=AEHS+1)', res_1A),
        ('1B: Full cohort (N=1000, broad COVID, no-COVID=0, COVID=AEHS)', res_1B),
        ('1C: Full cohort (N=1000, strict COVID-19, no-COVID=0, COVID=AEHS)', res_1C),
        ('2A: COVID cases only (N=197, broad COVID, AEHS)', res_2A),
        ('2B: COVID cases only (N=189, strict COVID-19, AEHS)', res_2B),
    ]

    print("=" * 80)
    print("BCG-CORONA ORDINAL LOGISTIC REGRESSION RESULTS")
    print("=" * 80)
    for name, res in models:
        beta = res.params['mh_count']
        se = res.bse['mh_count']
        pval = res.pvalues['mh_count']
        odds_ratio = np.exp(beta)
        pct_increase = (odds_ratio - 1) * 100
        ci_lower = np.exp(beta - 1.96 * se)
        ci_upper = np.exp(beta + 1.96 * se)
        pct_lower = (ci_lower - 1) * 100
        pct_upper = (ci_upper - 1) * 100
        print(f"\n--- {name} ---")
        print(f"  beta (mh_count): {beta:.4f} (SE: {se:.4f}, z: {beta/se:.3f}, p: {pval:.4e})")
        print(f"  Odds Ratio (OR): {odds_ratio:.4f} [95% CI: {ci_lower:.4f} - {ci_upper:.4f}]")
        print(f"  Percentage increase in odds: {pct_increase:.2f}% [95% CI: {pct_lower:.2f}% - {pct_upper:.2f}%]")

    return res_1A, res_1B, res_2A

if __name__ == '__main__':
    run_analysis()
