import os, json, zlib, struct, numpy as np, pandas as pd, scipy.constants as const

def kabsch_align(P, Q):
    p_c, q_c = np.mean(P, axis=0), np.mean(Q, axis=0)
    P_c, Q_c = P - p_c, Q - q_c
    H = P_c.T @ Q_c
    U, S, Vt = np.linalg.svd(H)
    d = np.linalg.det(Vt.T @ U.T)
    V = Vt.T
    if d < 0:
        V[:, -1] *= -1
    R = V @ U.T
    P_al = P_c @ R.T + q_c
    rmsd = float(np.sqrt(np.mean(np.sum((P_al - Q)**2, axis=1))))
    return P_al, R, rmsd

def write_png(path, df_r, lka, lkb, peak_ax):
    W, H = 800, 500
    img = np.ones((H, W, 3), dtype=np.uint8) * 255
    def f_rect(x0, y0, x1, y1, col):
        x0, x1 = max(0, min(x0, x1)), min(W, max(x0, x1))
        y0, y1 = max(0, min(y0, y1)), min(H, max(y0, y1))
        img[y0:y1, x0:x1] = col

    def line(x0, y0, x1, y1, col):
        dx, dy = abs(x1 - x0), abs(y1 - y0)
        sx, sy = (1 if x0 < x1 else -1), (1 if y0 < y1 else -1)
        err = dx - dy
        x, y = x0, y0
        while True:
            if 0 <= x < W and 0 <= y < H: img[y, x] = col
            if x == x1 and y == y1: break
            e2 = 2 * err
            if e2 > -dy: err -= dy; x += sx
            if e2 < dx: err += dx; y += sy

    f_rect(50, 40, 750, 230, [245, 245, 248])
    sdf = df_r.sort_values('axis_eV')
    xmin, xmax = sdf['axis_eV'].min(), sdf['axis_eV'].max()
    ymin, ymax = max(0, sdf['log10_k_et_s_inv'].min() - 0.5), sdf['log10_k_et_s_inv'].max() + 0.5
    pts = [(int(50 + (r['axis_eV'] - xmin)/(xmax - xmin)*700), int(230 - (r['log10_k_et_s_inv'] - ymin)/(ymax - ymin)*190)) for _, r in sdf.iterrows()]
    for i in range(len(pts)-1): line(pts[i][0], pts[i][1], pts[i+1][0], pts[i+1][1], [30, 100, 200])
    for px, py in pts: f_rect(px-2, py-2, px+3, py+3, [200, 30, 30])
    ppx = int(50 + (peak_ax - xmin)/(xmax - xmin)*700)
    line(ppx, 40, ppx, 230, [0, 180, 0])

    f_rect(50, 280, 750, 470, [245, 245, 248])
    ml = max(np.max(lka), np.max(lkb)) * 1.15
    bw = 700 / (15 * 2.5)
    for m in range(15):
        mc = 50 + 10 + m * (2.5 * bw)
        ha = int((lka[m] / ml) * 170)
        f_rect(int(mc), 470 - ha, int(mc + bw), 470, [30, 100, 200])
        hb = int((lkb[m] / ml) * 170)
        f_rect(int(mc + bw + 1), 470 - hb, int(mc + 2*bw + 1), 470, [240, 120, 20])

    raw = bytearray()
    for row in range(H): raw.append(0); raw.extend(img[row].tobytes())
    def chk(tag, data): return struct.pack('>I', len(data)) + tag + data + struct.pack('>I', zlib.crc32(tag + data) & 0xffffffff)
    out = bytearray(b'\x89PNG\r\n\x1a\n')
    out.extend(chk(b'IHDR', struct.pack('>IIBBBBB', W, H, 8, 2, 0, 0, 0)))
    out.extend(chk(b'IDAT', zlib.compress(bytes(raw), 9)))
    out.extend(chk(b'IEND', b''))
    with open(path, 'wb') as f: f.write(out)

def main():
    os.makedirs('results', exist_ok=True)
    df_s = pd.read_csv('data/site_table.csv').sort_values('site_id')
    masses = df_s['mass_amu'].values
    df_o = pd.read_csv('data/frame_site_order.csv')
    with open('data/system_manifest.json') as f: mf = json.load(f)
    with open('data/medium_response.json') as f: mr = json.load(f)
    df_g = pd.read_csv('data/driving_force_grid.csv')
    f_sc = mf.get('freq_scale_factor', 521.4708983725066)

    oa = df_o[df_o['frame_id'] == 'frame_a'].sort_values('site_id')['row_index'].values
    ob = df_o[df_o['frame_id'] == 'frame_b'].sort_values('site_id')['row_index'].values
    ca = np.load('data/frame_a_coords.npy')[oa]
    cb = np.load('data/frame_b_coords.npy')[ob]
    ia = np.concatenate([np.arange(3*r, 3*r+3) for r in oa])
    ib = np.concatenate([np.arange(3*r, 3*r+3) for r in ob])
    ha = np.load('data/frame_a_hessian.npy')[np.ix_(ia, ia)]
    hb = np.load('data/frame_b_hessian.npy')[np.ix_(ib, ib)]

    m21 = np.repeat(masses, 3)
    sm = np.sqrt(m21)

    ba, Rf, rmsd_f = kabsch_align(cb, ca)
    ab, Rb, rmsd_b = kabsch_align(ca, cb)
    dxf = (ba - ca).ravel()
    dxb = (ab - cb).ravel()
    dqf = dxf * sm
    dqb = dxb * sm
    np.save('results/aligned_displacement_mw.npy', np.stack([dqf, dqb], axis=0))

    ha_mw = ha / (sm[:, None] * sm[None, :])
    hb_mw = hb / (sm[:, None] * sm[None, :])
    va, ea = np.linalg.eigh(ha_mw)
    vb, eb = np.linalg.eigh(hb_mw)
    La, Lb = ea[:, 6:], eb[:, 6:]
    wa2, wb2 = va[6:], vb[6:]
    np.save('results/vibrational_basis_mw.npy', np.stack([La, Lb], axis=0))

    qpf = La @ (La.T @ dqf)
    qpb = Lb @ (Lb.T @ dqb)
    np.save('results/projected_displacement_mw.npy', np.stack([qpf, qpb], axis=0))

    qrf, qrb = dqf - qpf, dqb - qpb
    r_norm_f, r_norm_b = float(np.linalg.norm(qrf)), float(np.linalg.norm(qrb))
    p_norm_f, p_norm_b = float(np.linalg.norm(qpf)), float(np.linalg.norm(qpb))

    U_Rf = np.kron(np.eye(7), Rf)
    U_Rb = np.kron(np.eye(7), Rb)
    np.save('results/mode_overlap.npy', np.stack([np.abs(La.T @ (U_Rf @ Lb)), np.abs(Lb.T @ (U_Rb @ La))], axis=0))

    Qa, Qb = La.T @ dqf, Lb.T @ dqb
    f_cma = f_sc * np.sqrt(wa2)
    f_cmb = f_sc * np.sqrt(wb2)
    lka = 0.5 * wa2 * (Qa**2)
    lkb = 0.5 * wb2 * (Qb**2)
    np.save('results/mode_projection.npy', np.stack([np.column_stack([f_cma, Qa, lka]), np.column_stack([f_cmb, Qb, lkb])], axis=0))

    dom_f, dom_b = int(np.argmax(lka)), int(np.argmax(lkb))

    Qtf = (U_Rf @ Lb).T @ dqf
    Qtb = (U_Rb @ La).T @ dqb
    ltf = 0.5 * wb2 * (Qtf**2)
    ltb = 0.5 * wa2 * (Qtb**2)
    np.save('results/transported_mode_projection.npy', np.stack([np.column_stack([np.abs(Qtf), ltf]), np.column_stack([np.abs(Qtb), ltb])], axis=0))

    l_nm_f, l_nm_b = float(np.sum(lka)), float(np.sum(lkb))
    l_4p_f = float(0.5 * dqf @ ha_mw @ dqf)
    l_4p_b = float(0.5 * dqb @ hb_mw @ dqb)
    cl_f, cl_b = float(abs(l_4p_f - l_nm_f)), float(abs(l_4p_b - l_nm_b))
    eff_in_c = float(abs(l_nm_f - l_nm_b))
    l_in_eff = float(0.5 * (l_nm_f + l_nm_b))

    e, hbar, kB, eps0 = const.e, const.hbar, const.k, const.epsilon_0
    v_eV_A = (e**2)/(4*np.pi*eps0)/e * 1e10
    fc = (1.0/(2*mr['shell_0_A']) + 1.0/(2*mr['shell_1_A']) - 1.0/mr['span_A'])
    dc = (1.0/mr['eps_fast'] - 1.0/mr['eps_slow'])
    l_out = float(v_eV_A * fc * dc)
    l_tot = float(l_in_eff + l_out)

    VJ = mr['coupling_eV'] * e
    l_tot_J = l_tot * e
    T = mr['temp_K']
    pref = float((2*np.pi/hbar) * (VJ**2) / np.sqrt(4*np.pi*l_tot_J*kB*T))
    k_self = float(pref * np.exp(-l_tot_J / (4*kB*T)))

    pd.DataFrame([{
        'lambda_4pt_forward_eV': l_4p_f, 'lambda_4pt_backward_eV': l_4p_b,
        'lambda_nm_forward_eV': l_nm_f, 'lambda_nm_backward_eV': l_nm_b,
        'lambda_inner_effective_eV': l_in_eff, 'lambda_outer_eV': l_out,
        'lambda_total_eV': l_tot, 'k_self_exchange_s_inv': k_self
    }]).to_csv('results/lambda_summary.csv', index=False)

    ax_eV = df_g['axis_eV'].values
    dGJ = ax_eV * e
    actJ = ((dGJ + l_tot_J)**2)/(4*l_tot_J)
    ket = pref * np.exp(-actJ / (kB * T))
    df_r = pd.DataFrame({'grid_id': df_g['grid_id'].values, 'axis_eV': ax_eV, 'k_et_s_inv': ket, 'log10_k_et_s_inv': np.log10(ket)})
    df_r.to_csv('results/rate_curve.csv', index=False)

    pk_idx = int(np.argmax(ket))
    pk_gid = int(df_g.loc[pk_idx, 'grid_id'])
    pk_ax = float(df_g.loc[pk_idx, 'axis_eV'])
    pk_val = float(ket[pk_idx])

    sdf = df_r.sort_values('axis_eV', ascending=False).reset_index(drop=True)
    spos = int(sdf['k_et_s_inv'].idxmax())
    inv_det = bool(spos < len(sdf) - 1)
    if inv_det:
        inv_row = sdf.iloc[spos + 1]
        inv_gid = int(inv_row['grid_id'])
        inv_ax = float(inv_row['axis_eV'])
    else:
        inv_gid, inv_ax = None, None

    diag = {
        'alignment_rmsd_forward_A': rmsd_f, 'alignment_rmsd_backward_A': rmsd_b,
        'closure_error_forward_eV': cl_f, 'closure_error_backward_eV': cl_b,
        'effective_inner_consistency_eV': eff_in_c,
        'rigid_norm_forward': r_norm_f, 'rigid_norm_backward': r_norm_b,
        'projected_norm_forward': p_norm_f, 'projected_norm_backward': p_norm_b,
        'dominant_mode_forward': dom_f, 'dominant_mode_backward': dom_b,
        'rate_peak_grid_id': pk_gid, 'rate_peak_axis_eV': pk_ax, 'rate_peak_s_inv': pk_val,
        'inverted_region_detected': inv_det,
        'first_inverted_grid_id': inv_gid, 'first_inverted_axis_eV': inv_ax
    }
    with open('results/diagnostics.json', 'w') as f: json.dump(diag, f, indent=2)

    write_png('results/overview.png', df_r, lka, lkb, pk_ax)
    print('Done.')

if __name__ == '__main__': main()
