import gzip
import struct
import pandas as pd

def parse_annotation(annotation_path):
    df_annot = pd.read_csv(annotation_path)
    mexg_rows = df_annot[df_annot['Gene Name'] == 'mexG']
    if mexg_rows.empty:
        raise ValueError("Gene mexG not found in annotation file.")
    locus_tag = mexg_rows['Locus Tag'].values[0]
    return locus_tag

def parse_rds_deseq_results(rds_path):
    with gzip.open(rds_path, 'rb') as f:
        data = f.read()

    # Find rownames in data
    rn_pos = data.find(b'rownames')
    if rn_pos == -1:
        raise ValueError("Rownames not found in RDS.")
    
    # STRSXP header is after 'rownames'
    # STRSXP format: 4 bytes flags (type 16), 4 bytes length
    str_header_pos = rn_pos + 8
    str_type = struct.unpack('>I', data[str_header_pos:str_header_pos+4])[0] & 0xFF
    assert str_type == 16, f"Expected STRSXP (16), got {str_type}"
    n_rows = struct.unpack('>i', data[str_header_pos+4:str_header_pos+8])[0]
    
    # Parse rownames
    cur_pos = str_header_pos + 8
    rownames = []
    for _ in range(n_rows):
        charsxp_flags = struct.unpack('>I', data[cur_pos:cur_pos+4])[0]
        str_len = struct.unpack('>i', data[cur_pos+4:cur_pos+8])[0]
        cur_pos += 8
        s_val = data[cur_pos:cur_pos+str_len].decode('utf-8', errors='replace')
        rownames.append(s_val)
        cur_pos += str_len
    
    # Find REALSXP vectors of length n_rows
    # Type 14 is REALSXP
    reals = []
    pos = 0
    while pos < len(data) - 8:
        val = struct.unpack('>I', data[pos:pos+4])[0]
        if (val & 0xFF) == 14:
            vec_len = struct.unpack('>i', data[pos+4:pos+8])[0]
            if vec_len == n_rows:
                reals.append(pos)
                pos += 8 + n_rows * 8 - 1
        pos += 1
    
    col_names = ['baseMean', 'log2FoldChange', 'lfcSE', 'stat', 'pvalue', 'padj']
    assert len(reals) == 6, f"Expected 6 REALSXP columns, found {len(reals)}"
    
    res_dict = {}
    for col_name, offset in zip(col_names, reals):
        vals = struct.unpack(f'>{n_rows}d', data[offset+8:offset+8+n_rows*8])
        res_dict[col_name] = vals
        
    df_res = pd.DataFrame(res_dict, index=rownames)
    return df_res

def main():
    annotation_path = 'data/Pseudomonas_aeruginosa_UCBPP-PA14.csv'
    rds_path = 'data/res_1vs97.rds'
    
    locus_tag = parse_annotation(annotation_path)
    print(f"Identified locus tag for mexG: {locus_tag}")
    
    df_res = parse_rds_deseq_results(rds_path)
    print(f"Loaded DESeq results with shape: {df_res.shape}")
    
    if locus_tag not in df_res.index:
        raise KeyError(f"{locus_tag} not found in DESeq results index.")
    
    row = df_res.loc[locus_tag]
    log2fc = row['log2FoldChange']
    rounded_log2fc = round(log2fc, 2)
    
    print("\nmexG expression statistics (ΔrhlI [strain #97] vs wt [strain #1]):")
    print(f"  baseMean:       {row['baseMean']:.4f}")
    print(f"  log2FoldChange: {log2fc:.6f}")
    print(f"  lfcSE:          {row['lfcSE']:.6f}")
    print(f"  stat:           {row['stat']:.6f}")
    print(f"  pvalue:         {row['pvalue']:.4e}")
    print(f"  padj:           {row['padj']:.4e}")
    print(f"\nFinal Answer (rounded to 2 decimal points): {rounded_log2fc:.2f}")

if __name__ == '__main__':
    main()
