import pandas as pd
import numpy as np
from scipy import stats
import statsmodels.api as sm
import statsmodels.formula.api as smf

def main():
    # Load dataset
    df = pd.read_csv('data/nls_incarceration_processed.csv')
    black_df = df[df['race'] == 'black'].copy()
    
    # Stratification by 1985 baseline wealth
    def get_tier(w):
        if w <= 0:
            return 'Low (<= $0)'
        elif w <= 5000:
            return 'Middle ($1 - $5,000)'
        else:
            return 'High (> $5,000)'
            
    black_df['wealth_tier_1985'] = black_df['composite_wealth_1985'].apply(get_tier)
    black_df['wealth_change'] = black_df['composite_wealth_1996'] - black_df['composite_wealth_1985']
    black_df['ihs_wealth_96'] = np.arcsinh(black_df['composite_wealth_1996'])
    
    # Tier ordering
    tier_order = ['Low (<= $0)', 'Middle ($1 - $5,000)', 'High (> $5,000)']
    black_df['wealth_tier_1985'] = pd.Categorical(black_df['wealth_tier_1985'], categories=tier_order, ordered=True)
    
    # 1. Descriptive stats
    summary_list = []
    for tier in tier_order:
        sub = black_df[black_df['wealth_tier_1985'] == tier]
        for jailed in [0, 1]:
            s = sub[sub['ever_jailed'] == jailed]
            summary_list.append({
                'tier': tier,
                'ever_jailed': jailed,
                'count': len(s),
                'median_85': s['composite_wealth_1985'].median(),
                'mean_85': s['composite_wealth_1985'].mean(),
                'median_90': s['composite_wealth_1990'].median(),
                'mean_90': s['composite_wealth_1990'].mean(),
                'median_96': s['composite_wealth_1996'].median(),
                'mean_96': s['composite_wealth_1996'].mean(),
                'median_change': s['wealth_change'].median(),
                'mean_change': s['wealth_change'].mean(),
                'p75_96': np.percentile(s['composite_wealth_1996'], 75)
            })
    sum_df = pd.DataFrame(summary_list)
    sum_df.to_csv('artifacts/summary_by_tier.csv', index=False)
    print("=== Wealth Summary by Tier and Incarceration Status ===")
    print(sum_df.to_string(index=False))
    
    # 2. Non-parametric tests
    mwu_results = []
    for tier in tier_order:
        sub = black_df[black_df['wealth_tier_1985'] == tier]
        w0 = sub[sub['ever_jailed'] == 0]['composite_wealth_1996']
        w1 = sub[sub['ever_jailed'] == 1]['composite_wealth_1996']
        stat, pval = stats.mannwhitneyu(w0, w1, alternative='two-sided')
        mwu_results.append({
            'tier': tier,
            'U_stat': stat,
            'p_value': pval,
            'w0_median': w0.median(),
            'w1_median': w1.median()
        })
    mwu_df = pd.DataFrame(mwu_results)
    mwu_df.to_csv('artifacts/mann_whitney_tests.csv', index=False)
    print("\n=== Mann-Whitney U Test (1996 Wealth) ===")
    print(mwu_df.to_string(index=False))
    
    # 3. Regression models
    m1 = smf.ols('composite_wealth_1996 ~ C(wealth_tier_1985, Treatment(reference="Low (<= $0)")) * ever_jailed + C(sex)', data=black_df).fit(cov_type='HC3')
    m2 = smf.ols('wealth_change ~ C(wealth_tier_1985, Treatment(reference="Low (<= $0)")) * ever_jailed + C(sex)', data=black_df).fit(cov_type='HC3')
    
    with open('artifacts/regression_results.txt', 'w') as f:
        f.write("=== Model 1: 1996 Wealth (OLS with HC3) ===\n")
        f.write(str(m1.summary()))
        f.write("\n\n=== Model 2: Wealth Change 1985-1996 (OLS with HC3) ===\n")
        f.write(str(m2.summary()))
    print("\nAnalysis completed and artifacts generated.")

if __name__ == '__main__':
    main()
