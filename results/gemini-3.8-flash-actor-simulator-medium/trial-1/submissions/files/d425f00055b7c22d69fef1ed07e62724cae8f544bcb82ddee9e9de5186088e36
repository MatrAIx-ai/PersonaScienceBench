import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf

def run_analysis():
    df = pd.read_csv('data/nls_ses_processed.csv')
    df.columns = [c.replace(' ', '_').replace(':', '') for c in df.columns]
    df['BA'] = df['BA_DEGREE_COMPLETED'].astype(int)

    # 1. Target Interaction Model (RACE * SES)
    formula_target = 'BA ~ C(SAMPLE_RACE, Treatment(reference="White")) * SES'
    res_target = smf.logit(formula_target, data=df).fit(disp=False)
    print("=== Target Logistic Regression Model (RACE * SES) ===")
    print(res_target.summary())
    
    # 2. Pairwise White vs Black subset model
    sub = df[df['SAMPLE_RACE'].isin(['White', 'Black'])].copy()
    res_sub = smf.logit(formula_target, data=sub).fit(disp=False)
    print("\n=== Pairwise White vs Black Model ===")
    print(res_sub.summary())

    # 3. Model comparison across covariates
    models = {
        'Unadjusted (Bivariate)': 'BA ~ C(SAMPLE_RACE, Treatment(reference="White"))',
        'SES Main Effect': 'BA ~ C(SAMPLE_RACE, Treatment(reference="White")) + SES',
        'Academic Measures (ASVAB + Class Rank)': 'BA ~ C(SAMPLE_RACE, Treatment(reference="White")) + ABILITY_COMPOSITE_OF_ASVAB_SCORE + PERCENTILE_IN_CLASS',
        'Academic + SES': 'BA ~ C(SAMPLE_RACE, Treatment(reference="White")) + ABILITY_COMPOSITE_OF_ASVAB_SCORE + PERCENTILE_IN_CLASS + SES',
        'Full Model (Main Effects)': 'BA ~ C(SAMPLE_RACE, Treatment(reference="White")) + SES + ABILITY_COMPOSITE_OF_ASVAB_SCORE + PERCENTILE_IN_CLASS + FAMILY_SIZE_OF_SAMPLE + SAMPLE_SEX',
        'RACE * SES Interaction (Focal Model)': 'BA ~ C(SAMPLE_RACE, Treatment(reference="White")) * SES',
    }

    print("\n=== Model Comparison Summary ===")
    for name, f in models.items():
        res = smf.logit(f, data=df).fit(disp=False)
        black_coef = res.params.get('C(SAMPLE_RACE, Treatment(reference="White"))[T.Black]', np.nan)
        black_pval = res.pvalues.get('C(SAMPLE_RACE, Treatment(reference="White"))[T.Black]', np.nan)
        print(f"{name:40s} | Black vs White Coef: {black_coef:8.4f} (p = {black_pval:.4e}) | Pseudo R2: {res.prsquared:.4f}")

if __name__ == '__main__':
    run_analysis()
