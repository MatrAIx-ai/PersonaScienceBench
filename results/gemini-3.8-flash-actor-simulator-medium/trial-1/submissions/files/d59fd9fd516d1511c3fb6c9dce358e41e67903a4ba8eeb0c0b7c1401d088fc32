import pandas as pd
import statsmodels.api as sm
import statsmodels.formula.api as smf

df = pd.read_csv("data/nls_ses_processed.csv")
df["BA"] = df["BA DEGREE COMPLETED"].astype(int)

print("=== DESCRIPTIVE STATISTICS ===")
print(df[["BA", "SES", "FAMILY SIZE OF SAMPLE", "ABILITY: COMPOSITE OF ASVAB SCORE", "PERCENTILE IN CLASS"]].describe())

print("\n=== BASELINE LOGIT MODEL ===")
m_logit_base = smf.logit("BA ~ SES + C(SAMPLE_SEX) + C(SAMPLE_RACE)", data=df).fit()
print(m_logit_base.summary())

print("\n=== FULL LOGIT MODEL (WITH RACE AND ACADEMIC CHARACTERISTICS) ===")
m_logit_full = smf.logit("BA ~ SES + C(SAMPLE_RACE) + Q(\"ABILITY: COMPOSITE OF ASVAB SCORE\") + Q(\"PERCENTILE IN CLASS\")", data=df).fit()
print(m_logit_full.summary())

print("\n=== FULL LOGIT MODEL (WITH SEX, RACE, AND ACADEMIC CHARACTERISTICS) ===")
m_logit_full2 = smf.logit("BA ~ SES + C(SAMPLE_SEX) + C(SAMPLE_RACE) + Q(\"ABILITY: COMPOSITE OF ASVAB SCORE\") + Q(\"PERCENTILE IN CLASS\")", data=df).fit()
print(m_logit_full2.summary())

print("\n=== PROBIT BASELINE ===")
m_probit_base = smf.probit("BA ~ SES + Q(\"FAMILY SIZE OF SAMPLE\")", data=df).fit()
print(m_probit_base.summary())
