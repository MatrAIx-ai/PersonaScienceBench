#!/usr/bin/env python3
"""
Analysis of gene expression (log2(TPM+1)) skewness across cell lines in
OmicsExpressionProteinCodingGenesTPMLogp1BatchCorrected.csv.
"""

import sys
import numpy as np
import pandas as pd
from scipy import stats

def main():
    data_path = 'data/OmicsExpressionProteinCodingGenesTPMLogp1BatchCorrected.csv'
    print(f"Loading gene expression data from {data_path}...")
    df = pd.read_csv(data_path, index_col=0)
    
    n_cell_lines, n_genes = df.shape
    total_data_points = n_cell_lines * n_genes
    print(f"Dataset shape: {n_cell_lines} cell lines x {n_genes} genes ({total_data_points} observations)")
    
    # Check for missing values
    n_missing = df.isna().sum().sum()
    print(f"Total missing values: {n_missing}")
    
    # 1. Global distribution analysis
    vals = df.values.flatten()
    if n_missing > 0:
        vals = vals[~np.isnan(vals)]
        
    global_mean = float(np.mean(vals))
    global_median = float(np.median(vals))
    global_std = float(np.std(vals))
    global_min = float(np.min(vals))
    global_max = float(np.max(vals))
    global_skew = float(stats.skew(vals, bias=False)) # Sample skewness / Fisher-Pearson
    global_skew_biased = float(stats.skew(vals, bias=True))
    
    # Percentiles
    p25 = float(np.percentile(vals, 25))
    p75 = float(np.percentile(vals, 75))
    iqr = p75 - p25
    
    print("\n--- GLOBAL DISTRIBUTION METRICS ---")
    print(f"Mean: {global_mean:.6f}")
    print(f"Median: {global_median:.6f}")
    print(f"Std Dev: {global_std:.6f}")
    print(f"Min: {global_min:.6f}")
    print(f"Max: {global_max:.6f}")
    print(f"25th percentile (Q1): {p25:.6f}")
    print(f"75th percentile (Q3): {p75:.6f}")
    print(f"IQR: {iqr:.6f}")
    print(f"Skewness (Fisher-Pearson, unbiased): {global_skew:.6f}")
    print(f"Skewness (Fisher-Pearson, biased): {global_skew_biased:.6f}")
    
    # 2. Per cell-line skewness (distribution across genes within each cell line)
    cell_line_skews = df.apply(lambda row: stats.skew(row, bias=False), axis=1)
    print("\n--- PER-CELL-LINE SKEWNESS METRICS ---")
    print(f"Mean cell line skewness: {cell_line_skews.mean():.6f}")
    print(f"Median cell line skewness: {cell_line_skews.median():.6f}")
    print(f"Std cell line skewness: {cell_line_skews.std():.6f}")
    print(f"Min cell line skewness: {cell_line_skews.min():.6f}")
    print(f"Max cell line skewness: {cell_line_skews.max():.6f}")
    print(f"Percentage of cell lines with positive skewness: {(cell_line_skews > 0).mean() * 100:.2f}%")
    
    # 3. Per gene skewness (distribution across cell lines for each gene)
    gene_skews = df.apply(lambda col: stats.skew(col, bias=False), axis=0)
    print("\n--- PER-GENE SKEWNESS METRICS ---")
    print(f"Mean gene skewness: {gene_skews.mean():.6f}")
    print(f"Median gene skewness: {gene_skews.median():.6f}")
    print(f"Std gene skewness: {gene_skews.std():.6f}")
    print(f"Min gene skewness: {gene_skews.min():.6f}")
    print(f"Max gene skewness: {gene_skews.max():.6f}")
    print(f"Percentage of genes with positive skewness: {(gene_skews > 0).mean() * 100:.2f}%")
    
    # Summary statement
    print("\n--- SUMMARY CONCLUSION ---")
    characteristic = "positively skewed (right-skewed)" if global_skew > 0 else "negatively skewed (left-skewed)"
    print(f"The gene expression distribution is {characteristic} with a skewness of {global_skew:.4f} (overall) and mean cell-line skewness of {cell_line_skews.mean():.4f}.")

if __name__ == '__main__':
    main()
