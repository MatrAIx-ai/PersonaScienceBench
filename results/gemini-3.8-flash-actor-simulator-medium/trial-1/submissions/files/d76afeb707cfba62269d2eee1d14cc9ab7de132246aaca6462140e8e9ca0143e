import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf

# Load data
df = pd.read_csv('data/nls_bmi_processed.csv')

print("=== Sample Overview ===")
print(f"Total observations: {len(df)}")
print(f"Age range: {df['AGE'].min()} - {df['AGE'].max()}")
print(f"Overall dissaving rate: {df['DISSAVED'].mean():.4f}")

print("\n=== Dissaving Rate by Age ===")
age_table = df.groupby('AGE')['DISSAVED'].agg(['count', 'sum', 'mean'])
age_table['rate_pct'] = age_table['mean'] * 100
print(age_table)

print("\n=== Logistic Regression: Linear Age ===")
model_linear = smf.logit('DISSAVED ~ AGE', data=df).fit()
print(model_linear.summary())
or_linear = np.exp(model_linear.params['AGE'])
ci_linear = np.exp(model_linear.conf_int().loc['AGE'])
print(f"Odds Ratio for AGE: {or_linear:.4f} (95% CI: [{ci_linear[0]:.4f}, {ci_linear[1]:.4f}])")

print("\n=== Logistic Regression: Quadratic Age ===")
model_quad = smf.logit('DISSAVED ~ AGE + AGE_2', data=df).fit()
print(model_quad.summary())
vertex = -model_quad.params['AGE'] / (2 * model_quad.params['AGE_2'])
print(f"Estimated Peak Dissaving Age (Vertex): {vertex:.2f} years")

print("\n=== Multivariate Logistic Regression: Fully Adjusted ===")
model_full = smf.logit('DISSAVED ~ AGE + C(GENDER) + INCOME + BMI + BLACK + HISPANIC', data=df).fit()
print(model_full.summary())
or_full = np.exp(model_full.params['AGE'])
ci_full = np.exp(model_full.conf_int().loc['AGE'])
print(f"Adjusted Odds Ratio for AGE: {or_full:.4f} (95% CI: [{ci_full[0]:.4f}, {ci_full[1]:.4f}])")

print("\n=== Multivariate Logistic Regression: Quadratic Fully Adjusted ===")
model_full_quad = smf.logit('DISSAVED ~ AGE + AGE_2 + C(GENDER) + INCOME + BMI + BLACK + HISPANIC', data=df).fit()
print(model_full_quad.summary())
vertex_full = -model_full_quad.params['AGE'] / (2 * model_full_quad.params['AGE_2'])
print(f"Adjusted Peak Dissaving Age (Vertex): {vertex_full:.2f} years")
