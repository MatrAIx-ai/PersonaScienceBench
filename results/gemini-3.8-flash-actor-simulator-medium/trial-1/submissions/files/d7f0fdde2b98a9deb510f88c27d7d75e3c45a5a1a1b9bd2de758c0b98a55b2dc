import pandas as pd
import numpy as np
from scipy import stats

# Load data
df = pd.read_csv('data/invaded_niche_pathways.csv', sep='\t')

# Calculate metrics across 10 habitat types
records = []
for hab, grp in df.groupby('habitat'):
    n = len(grp)
    mean_g = grp['n.gard'].mean()
    std_g = grp['n.gard'].std()
    med_g = grp['n.gard'].median()
    occ_g = (grp['n.gard'] > 0).mean() * 100
    sum_g = grp['n.gard'].sum()
    sum_tot = grp['n.total'].sum()
    share_g = (sum_g / sum_tot * 100) if sum_tot > 0 else 0.0
    mean_tot = grp['n.total'].mean()
    occ_tot = (grp['n.total'] > 0).mean() * 100
    records.append({
        'habitat': hab,
        'plots': n,
        'mean_gard': round(mean_g, 3),
        'std_gard': round(std_g, 3),
        'median_gard': med_g,
        'occupancy_gard_pct': round(occ_g, 2),
        'sum_gard': int(sum_g),
        'sum_total': int(sum_tot),
        'gard_share_pct': round(share_g, 2),
        'mean_total': round(mean_tot, 3),
        'occupancy_total_pct': round(occ_tot, 2)
    })

res = pd.DataFrame(records).sort_values(by='mean_gard', ascending=False)
res.to_csv('habitat_gardening_summary.csv', index=False)
print("Summary table:")
print(res.to_string(index=False))

# Statistical tests
groups = [grp['n.gard'].values for _, grp in df.groupby('habitat')]
kw_stat, kw_p = stats.kruskal(*groups)
print(f"\nKruskal-Wallis: H = {kw_stat:.3f}, p = {kw_p:.4e}")

contingency = pd.crosstab(df['habitat'], df['n.gard'] > 0)
chi2_stat, chi2_p, dof, _ = stats.chi2_contingency(contingency)
print(f"Chi-square test of occupancy: chi2 = {chi2_stat:.3f}, p = {chi2_p:.4e}, df = {dof}")
