import pandas as pd
import numpy as np

def main():
    file_path = "data/Proteomic_data .xlsx"
    df = pd.read_excel(file_path, sheet_name="Tumor vs Normal")
    
    # Query for ENO1
    eno1_df = df[df["gene"] == "ENO1"]
    
    if len(eno1_df) != 1:
        raise ValueError(f"Expected 1 row for ENO1, found {len(eno1_df)}")
    
    row = eno1_df.iloc[0]
    protein_id = row["protein"]
    gene = row["gene"]
    normal_val = float(row["Normal"])
    tumor_val = float(row["Tumor"])
    
    # Round to 3 significant figures
    # Using format specification or float rounding
    rounded_sci = f"{normal_val:.3g}"
    rounded_float = float(f"{normal_val:.3g}")
    rounded_int = int(rounded_float)
    
    print(f"Gene: {gene}")
    print(f"Protein: {protein_id}")
    print(f"Description: {row['Description']}")
    print(f"Exact Normal Level: {normal_val}")
    print(f"Normal Level (3 sig figs, scientific): {rounded_sci}")
    print(f"Normal Level (3 sig figs, integer): {rounded_int}")
    print(f"Tumor Level: {tumor_val}")
    print(f"Reported Ratio: {row['Ratio']}")
    print(f"Calculated Tumor/Normal: {tumor_val / normal_val:.4f}")

if __name__ == "__main__":
    main()
