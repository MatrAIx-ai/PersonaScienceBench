import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf

df = pd.read_csv('data/nls_incarceration_processed.csv')
b = df[df['race'] == 'black'].copy()

# Define baseline economic strata based on 1985 wealth:
# Low: <= $0
# Mid: $1 - $5,000
# High: > $5,000
def get_stratum(w):
    if w <= 0:
        return '1_Low (<=0)'
    elif w <= 5000:
        return '2_Mid (1-5k)'
    else:
        return '3_High (>5k)'

b['stratum'] = b['composite_wealth_1985'].apply(get_stratum)
b['wealth_change_85_96'] = b['composite_wealth_1996'] - b['composite_wealth_1985']
b['wealth_change_85_90'] = b['composite_wealth_1990'] - b['composite_wealth_1985']
b['wealth_change_90_96'] = b['composite_wealth_1996'] - b['composite_wealth_1990']

print("=== SAMPLE SIZES ===")
print(pd.crosstab(b['stratum'], b['ever_jailed'], margins=True))

print("\n=== DESCRIPTIVE TRAJECTORIES: MEANS ===")
mean_traj = b.groupby(['stratum', 'ever_jailed'])[['composite_wealth_1985', 'composite_wealth_1990', 'composite_wealth_1996', 'wealth_change_85_96']].mean()
print(mean_traj.round(2))

print("\n=== DESCRIPTIVE TRAJECTORIES: MEDIANS ===")
med_traj = b.groupby(['stratum', 'ever_jailed'])[['composite_wealth_1985', 'composite_wealth_1990', 'composite_wealth_1996', 'wealth_change_85_96']].median()
print(med_traj.round(2))

print("\n=== OVERALL BLACK RESPONDENTS (UNSTRATIFIED) ===")
print("Means:")
print(b.groupby('ever_jailed')[['composite_wealth_1985', 'composite_wealth_1990', 'composite_wealth_1996', 'wealth_change_85_96']].mean().round(2))
print("Medians:")
print(b.groupby('ever_jailed')[['composite_wealth_1985', 'composite_wealth_1990', 'composite_wealth_1996', 'wealth_change_85_96']].median().round(2))

print("\n=== REGRESSION MODELS ===")
# Model 1: OLS on 1996 wealth with stratum interaction and sex control
ols_1996 = smf.ols('composite_wealth_1996 ~ C(stratum, Treatment(reference="1_Low (<=0)")) * ever_jailed + C(sex)', data=b).fit()
print("\n--- OLS: 1996 Wealth on Stratum * ever_jailed + sex ---")
print(ols_1996.summary())

# Model 2: OLS on wealth change (1985 to 1996)
ols_change = smf.ols('wealth_change_85_96 ~ C(stratum, Treatment(reference="1_Low (<=0)")) * ever_jailed + C(sex)', data=b).fit()
print("\n--- OLS: Wealth Change (85-96) on Stratum * ever_jailed + sex ---")
print(ols_change.summary())

# Model 3: Median regression (Quantile regression q=0.5) on 1996 wealth
qreg_1996 = smf.quantreg('composite_wealth_1996 ~ C(stratum, Treatment(reference="1_Low (<=0)")) * ever_jailed + C(sex)', data=b).fit(q=0.5)
print("\n--- Quantile (Median) Regression: 1996 Wealth ---")
print(qreg_1996.summary())

# Model 4: Median regression on wealth change (85-96)
qreg_change = smf.quantreg('wealth_change_85_96 ~ C(stratum, Treatment(reference="1_Low (<=0)")) * ever_jailed + C(sex)', data=b).fit(q=0.5)
print("\n--- Quantile (Median) Regression: Wealth Change (85-96) ---")
print(qreg_change.summary())

# Model 5: Continuous baseline wealth interaction
ols_cont = smf.ols('composite_wealth_1996 ~ composite_wealth_1985 * ever_jailed + C(sex)', data=b).fit()
print("\n--- OLS: Continuous Interaction ---")
print(ols_cont.summary())

