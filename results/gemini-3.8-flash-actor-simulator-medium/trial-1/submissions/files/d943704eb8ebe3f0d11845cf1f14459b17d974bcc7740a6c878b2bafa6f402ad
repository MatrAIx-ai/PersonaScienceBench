import pandas as pd
import numpy as np
from scipy import stats
import statsmodels.api as sm
import statsmodels.formula.api as smf

df = pd.read_csv('data/nls_incarceration_processed.csv')
years = ['1985', '1990', '1996']

results = []
for y in years:
    col = f'composite_wealth_{y}'
    g0 = df[df['ever_jailed'] == 0][col]
    g1 = df[df['ever_jailed'] == 1][col]
    
    t_stat, t_pval = stats.ttest_ind(g1, g0, equal_var=False)
    u_stat, u_pval = stats.mannwhitneyu(g1, g0, alternative='two-sided')
    ols_unadj = smf.ols(f'{col} ~ ever_jailed', data=df).fit(cov_type='HC3')
    ols_adj_hc3 = smf.ols(f'{col} ~ ever_jailed + C(race) + C(sex)', data=df).fit(cov_type='HC3')
    ols_adj_ols = smf.ols(f'{col} ~ ever_jailed + C(race) + C(sex)', data=df).fit()
    
    results.append({
        'year': y,
        'mean_jailed_0': g0.mean(),
        'mean_jailed_1': g1.mean(),
        'median_jailed_0': g0.median(),
        'median_jailed_1': g1.median(),
        'welch_t': t_stat,
        'welch_p': t_pval,
        'mwu_u': u_stat,
        'mwu_p': u_pval,
        'ols_ctrl_hc3_coef': ols_adj_hc3.params['ever_jailed'],
        'ols_ctrl_hc3_se': ols_adj_hc3.bse['ever_jailed'],
        'ols_ctrl_hc3_p': ols_adj_hc3.pvalues['ever_jailed'],
        'ols_ctrl_classical_p': ols_adj_ols.pvalues['ever_jailed']
    })

res_df = pd.DataFrame(results)
print(res_df.to_string(index=False))
