import pandas as pd

def analyze():
    df = pd.read_csv('data/meta-regression_study_data_heterogeneity_in_replication_projects.csv')
    ee_df = df[df['project'] == 'ee']
    total_ee = len(ee_df)
    uk_ee = ee_df[ee_df['experiment_country.o'] == 'United Kingdom']
    uk_count = len(uk_ee)
    prop = uk_count / total_ee
    
    print(f"Total Experimental Economics original studies: {total_ee}")
    print(f"Original studies conducted in the UK: {uk_count}")
    print(f"Proportion conducted in the UK: {prop:.4f} ({prop*100:.2f}%)")
    print("\nStudy details for UK:")
    print(uk_ee[['id', 'title', 'authors.o', 'pub_year', 'journal', 'experiment_country.o']])

if __name__ == '__main__':
    analyze()
