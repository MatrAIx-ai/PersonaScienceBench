import pandas as pd

# Load dataset
df = pd.read_csv('data/meta-regression_study_data_heterogeneity_in_replication_projects.csv')

# Filter for Psychology replication project (RPP)
rpp = df[df['project'] == 'rpp']
rpp_rep1 = rpp[rpp['replicated'] == 1]
rpp_rep0 = rpp[rpp['replicated'] == 0]

print("=== 1. Primary Analysis: RPP & Replicated (replicated == 1) ===")
n_rep1 = len(rpp_rep1)
counts_rep1_r = rpp_rep1['seniority.r'].value_counts()
prop_rep1_r = rpp_rep1['seniority.r'].value_counts(normalize=True)
print(f"Total replicated studies (N): {n_rep1}")
for cat, cnt in counts_rep1_r.items():
    p = prop_rep1_r[cat]
    print(f"  {cat}: {cnt} ({p:.4f} or {p*100:.2f}%)")

print("\n=== 2. Sensitivity Analysis: All RPP Studies (N = 97) ===")
n_all = len(rpp)
counts_all_r = rpp['seniority.r'].value_counts()
prop_all_r = rpp['seniority.r'].value_counts(normalize=True)
for cat, cnt in counts_all_r.items():
    p = prop_all_r[cat]
    print(f"  {cat}: {cnt} ({p:.4f} or {p*100:.2f}%)")

print("\n=== 3. Contrast: RPP Non-replicated Studies (replicated == 0, N = 62) ===")
counts_rep0_r = rpp_rep0['seniority.r'].value_counts()
prop_rep0_r = rpp_rep0['seniority.r'].value_counts(normalize=True)
for cat, cnt in counts_rep0_r.items():
    p = prop_rep0_r[cat]
    print(f"  {cat}: {cnt} ({p:.4f} or {p*100:.2f}%)")

print("\n=== 4. Original Authors (seniority.o) in RPP ===")
print("RPP Replicated == 1 (N = 35):")
print(rpp_rep1['seniority.o'].value_counts())
print("\nRPP Total (N = 97):")
print(rpp['seniority.o'].value_counts())
