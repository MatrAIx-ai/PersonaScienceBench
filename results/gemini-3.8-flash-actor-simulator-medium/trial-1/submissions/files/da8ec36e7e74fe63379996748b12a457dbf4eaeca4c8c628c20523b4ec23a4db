import pandas as pd
import statsmodels.formula.api as smf

def main():
    # Load processed data
    df = pd.read_csv('data/nls_ses_processed.csv')
    df.columns = [c.replace(' ', '_').replace(':', '') for c in df.columns]
    df['BA_DEGREE_COMPLETED'] = df['BA_DEGREE_COMPLETED'].astype(int)

    # Logistic regression of BA completion on race interacted with SES
    formula = 'BA_DEGREE_COMPLETED ~ C(SAMPLE_RACE, Treatment(reference="White")) * SES'
    model = smf.logit(formula, data=df).fit()

    print(model.summary())
    
    coef_black = model.params['C(SAMPLE_RACE, Treatment(reference="White"))[T.Black]']
    se_black = model.bse['C(SAMPLE_RACE, Treatment(reference="White"))[T.Black]']
    p_black = model.pvalues['C(SAMPLE_RACE, Treatment(reference="White"))[T.Black]']
    
    print("\nIdentified contrast:")
    print(f"Comparison: Black vs White (reference)")
    print(f"Logit coefficient (factor): {coef_black:.4f} (exact: {coef_black})")
    print(f"Standard error: {se_black:.4f}")
    print(f"p-value: {p_black:.4e}")

if __name__ == '__main__':
    main()
