import pandas as pd

def main():
    # Load Zebra Finch data
    df = pd.read_csv('data/ZF_AgeRelated_CpG_noMT_Final.csv')
    
    # Total unique sites
    total_sites = df['Pos'].nunique()
    print(f"Total unique CpG sites: {total_sites}")
    
    # Identify sites that show > 90% or < 10% methylation in at least one sample
    site_extreme = df.groupby('Pos')['MethylationPercentage'].apply(
        lambda x: ((x > 90) | (x < 10)).any()
    )
    
    sites_kept = site_extreme.sum()
    sites_removed = (~site_extreme).sum()
    
    print(f"Sites showing >90% or <10% methylation in at least one sample (kept): {sites_kept}")
    print(f"Sites removed: {sites_removed}")
    
    # Complementary checks:
    # Non-strict inequality (>=90 or <=10)
    site_extreme_inclusive = df.groupby('Pos')['MethylationPercentage'].apply(
        lambda x: ((x >= 90) | (x <= 10)).any()
    )
    print(f"Sites removed (non-strict >=90 or <=10): {(~site_extreme_inclusive).sum()}")
    
    # Row-level check
    row_extreme = (df['MethylationPercentage'] > 90) | (df['MethylationPercentage'] < 10)
    print(f"Total rows: {len(df)}")
    print(f"Rows kept: {row_extreme.sum()}, Rows removed: {(~row_extreme).sum()}")
    
    return sites_removed

if __name__ == '__main__':
    main()
