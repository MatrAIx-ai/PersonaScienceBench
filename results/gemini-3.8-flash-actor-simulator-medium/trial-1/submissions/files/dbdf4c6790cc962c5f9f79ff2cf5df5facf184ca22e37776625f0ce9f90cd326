import pandas as pd
import numpy as np
from statsmodels.miscmodels.ordinal_model import OrderedModel

def run_analysis():
    # 1. Load data
    dm = pd.read_csv('data/TASK008_BCG-CORONA_DM.csv')
    ae = pd.read_csv('data/TASK008_BCG-CORONA_AE.csv')
    mh = pd.read_csv('data/TASK008_BCG-CORONA_MH.csv')

    # 2. Prior medical history count
    # Count positive conditions (MHORRES == 2.0) in MEDICAL HISTORY category per subject
    mh_med = mh[(mh['MHSCAT'] == 'MEDICAL HISTORY') & (mh['MHORRES'] == 2.0)]
    mh_counts = mh_med.groupby('USUBJID').size().reindex(dm['USUBJID'], fill_value=0).rename('med_hist_count')

    # 3. COVID-19 Severity
    # Extract COVID-19 events and compute subject-level maximum health status (AEHS) and adverse event severity (AESEV)
    covid = ae[ae['AEPT'].str.contains('COVID|corona|sars', case=False, na=False)]
    subj_aehs = covid.groupby('USUBJID')['AEHS'].max().rename('covid_severity_hs')
    subj_aesev = covid.groupby('USUBJID')['AESEV'].max().rename('covid_severity_ev')

    # Merge into primary analytical dataset
    df = dm.merge(mh_counts, on='USUBJID').merge(subj_aehs, on='USUBJID', how='left').merge(subj_aesev, on='USUBJID', how='left')

    # Binary indicator for BCG treatment (Placebo = 0, BCG = 1)
    df['bcg'] = (df['TRTGRP'] == 'BCG').astype(int)

    # Full cohort severity: uninfected subjects have severity score 0
    df['sev_hs_all'] = df['covid_severity_hs'].fillna(0).astype(int)

    # Numeric encoding of patient interaction frequency
    seen_map = {'1-50': 1, '51-100': 2, '>100': 3}
    df['patients_seen_num'] = df['patients_seen'].map(seen_map)

    results = {}

    print("================================================================================")
    print("PRIMARY MODEL: Full Cohort (N=1000), WHO AEHS Scale (0-7), Categorical Covariates")
    print("Formula: sev_hs_all ~ bcg + C(patients_seen, Treatment('1-50')) * med_hist_count")
    print("================================================================================")
    mod_prim = OrderedModel.from_formula(
        "sev_hs_all ~ bcg + C(patients_seen, Treatment('1-50')) * med_hist_count",
        data=df,
        distr='logit'
    )
    res_prim = mod_prim.fit(disp=False, method='bfgs')
    print(res_prim.summary())
    
    coef_prim = res_prim.params['bcg']
    se_prim = res_prim.bse['bcg']
    pval_prim = res_prim.pvalues['bcg']
    ci_prim = res_prim.conf_int().loc['bcg']
    or_prim = np.exp(coef_prim)
    ci_or_prim = np.exp(ci_prim)
    
    print("\n--- Primary Model Results for BCG ---")
    print(f"Log-odds coefficient: {coef_prim:.4f} (SE: {se_prim:.4f})")
    print(f"Odds Ratio (OR): {or_prim:.4f}")
    print(f"95% CI: [{ci_or_prim[0]:.4f}, {ci_or_prim[1]:.4f}]")
    print(f"p-value: {pval_prim:.4f}")
    
    results['primary'] = {
        'coef': coef_prim, 'se': se_prim, 'or': or_prim,
        'ci_lower': ci_or_prim[0], 'ci_upper': ci_or_prim[1], 'pvalue': pval_prim
    }

    print("\n================================================================================")
    print("SECONDARY MODEL: COVID-Positive Cases Only (N=197)")
    print("Formula: covid_severity_hs ~ bcg + C(patients_seen, Treatment('1-50')) * med_hist_count")
    print("================================================================================")
    df_cov = df[df['covid_severity_hs'].notna()].copy()
    mod_cov = OrderedModel.from_formula(
        "covid_severity_hs ~ bcg + C(patients_seen, Treatment('1-50')) * med_hist_count",
        data=df_cov,
        distr='logit'
    )
    res_cov = mod_cov.fit(disp=False, method='bfgs')
    print(res_cov.summary())
    
    coef_cov = res_cov.params['bcg']
    se_cov = res_cov.bse['bcg']
    pval_cov = res_cov.pvalues['bcg']
    ci_cov = res_cov.conf_int().loc['bcg']
    or_cov = np.exp(coef_cov)
    ci_or_cov = np.exp(ci_cov)
    
    print("\n--- COVID-Positive Only Model Results for BCG ---")
    print(f"Log-odds coefficient: {coef_cov:.4f} (SE: {se_cov:.4f})")
    print(f"Odds Ratio (OR): {or_cov:.4f}")
    print(f"95% CI: [{ci_or_cov[0]:.4f}, {ci_or_cov[1]:.4f}]")
    print(f"p-value: {pval_cov:.4f}")

    results['covid_only'] = {
        'coef': coef_cov, 'se': se_cov, 'or': or_cov,
        'ci_lower': ci_or_cov[0], 'ci_upper': ci_or_cov[1], 'pvalue': pval_cov
    }

    print("\n================================================================================")
    print("MODEL WITH NUMERIC PATIENTS SEEN: Full Cohort (N=1000)")
    print("Formula: sev_hs_all ~ bcg + patients_seen_num * med_hist_count")
    print("================================================================================")
    mod_num = OrderedModel.from_formula(
        "sev_hs_all ~ bcg + patients_seen_num * med_hist_count",
        data=df,
        distr='logit'
    )
    res_num = mod_num.fit(disp=False, method='bfgs')
    coef_num = res_num.params['bcg']
    se_num = res_num.bse['bcg']
    pval_num = res_num.pvalues['bcg']
    ci_num = res_num.conf_int().loc['bcg']
    or_num = np.exp(coef_num)
    ci_or_num = np.exp(ci_num)
    print(f"BCG OR: {or_num:.4f} (95% CI: [{ci_or_num[0]:.4f}, {ci_or_num[1]:.4f}], p={pval_num:.4f})")

    results['numeric_seen'] = {
        'coef': coef_num, 'se': se_num, 'or': or_num,
        'ci_lower': ci_or_num[0], 'ci_upper': ci_or_num[1], 'pvalue': pval_num
    }

    print("\n================================================================================")
    print("FULL FACTORIAL / ALL 2-WAY INTERACTIONS: Full Cohort (N=1000)")
    print("Formula: sev_hs_all ~ (bcg + patients_seen_num + med_hist_count)**2")
    print("================================================================================")
    mod_all2 = OrderedModel.from_formula(
        "sev_hs_all ~ (bcg + patients_seen_num + med_hist_count)**2",
        data=df,
        distr='logit'
    )
    res_all2 = mod_all2.fit(disp=False, method='bfgs')
    coef_all2 = res_all2.params['bcg']
    se_all2 = res_all2.bse['bcg']
    pval_all2 = res_all2.pvalues['bcg']
    ci_all2 = res_all2.conf_int().loc['bcg']
    or_all2 = np.exp(coef_all2)
    ci_or_all2 = np.exp(ci_all2)
    print(f"BCG OR: {or_all2:.4f} (95% CI: [{ci_or_all2[0]:.4f}, {ci_or_all2[1]:.4f}], p={pval_all2:.4f})")

    results['all_interactions'] = {
        'coef': coef_all2, 'se': se_all2, 'or': or_all2,
        'ci_lower': ci_or_all2[0], 'ci_upper': ci_or_all2[1], 'pvalue': pval_all2
    }

    return results

if __name__ == '__main__':
    run_analysis()
