import pandas as pd
import numpy as np

def run_analysis():
    # 1. Load capital dataset
    df_cap = pd.read_csv('data/capital.csv')
    for col in df_cap.columns[3:]:
        df_cap[col] = df_cap[col].astype(str).str.replace(',', '.').astype(float)

    # Classification of capitals
    social_cols = ['ZCU_AU', 'Zamber', 'ZMonument']
    symbolic_cols = ['ZAxtSchwert', 'ZDolch', 'Zhausgr']
    cultural_cols = ['ZKeform', 'Zkeverz']
    economic_cols = ['ZHort', 'ZSichel', 'ZBeil', 'ZMW']
    all_capital_cols = social_cols + symbolic_cols + cultural_cols + economic_cols

    df_cap['social_capital'] = df_cap[social_cols].sum(axis=1)
    df_cap['symbolic_capital'] = df_cap[symbolic_cols].sum(axis=1)
    df_cap['cultural_capital'] = df_cap[cultural_cols].sum(axis=1)
    df_cap['economic_capital'] = df_cap[economic_cols].sum(axis=1)
    df_cap['total_capital'] = df_cap[all_capital_cols].sum(axis=1)

    # 2. Load time series dataset
    df_ts = pd.read_csv('data/time_series_data.csv')
    ts_social_cols = ['CopperGold_inter', 'Amber_inter', 'MonumentCount_inter']
    ts_all_cols = [
        'HatchetSword_inter', 'Dagger_inter', 'HouseSize_inter',
        'CopperGold_inter', 'Amber_inter', 'MonumentCount_inter',
        'Depot_inter', 'Sickle_inter', 'AxesCelts_inter',
        'MonumentSize_inter', 'PotteryForm_inter', 'PotteryDecoration_inter'
    ]
    df_ts['social_capital'] = df_ts[ts_social_cols].sum(axis=1)
    df_ts['total_capital'] = df_ts[ts_all_cols].sum(axis=1)

    # 3. Peak analysis
    print("=== Peak of Social Capital ===")
    max_social = df_cap['social_capital'].max()
    peak_social_rows = df_cap[df_cap['social_capital'] == max_social]
    print(peak_social_rows[['BCE', 'group', 'social_capital', 'ZCU_AU', 'Zamber', 'ZMonument']])

    print("\n=== Peak of Total Capital ===")
    max_total = df_cap['total_capital'].max()
    peak_total_rows = df_cap[df_cap['total_capital'] == max_total]
    print(peak_total_rows[['BCE', 'group', 'total_capital', 'social_capital', 'symbolic_capital', 'economic_capital', 'cultural_capital']])

    print("\n=== Changes from 1500 BCE to 1400 BCE (OBA Peak Formation) ===")
    row_1500 = df_cap[df_cap['BCE'] == 1500].iloc[0]
    row_1400 = df_cap[df_cap['BCE'] == 1400].iloc[0]
    
    delta = row_1400[all_capital_cols] - row_1500[all_capital_cols]
    delta_df = pd.DataFrame({
        '1500 BCE': row_1500[all_capital_cols],
        '1400 BCE': row_1400[all_capital_cols],
        'Absolute Change (Δ)': delta
    }).sort_values(by='Absolute Change (Δ)', ascending=False)
    print(delta_df)

    print("\n=== Changes from 1400 BCE to 1300 BCE ===")
    row_1300 = df_cap[df_cap['BCE'] == 1300].iloc[0]
    delta_1300 = row_1300[all_capital_cols] - row_1400[all_capital_cols]
    delta_df_1300 = pd.DataFrame({
        '1400 BCE': row_1400[all_capital_cols],
        '1300 BCE': row_1300[all_capital_cols],
        'Absolute Change (Δ)': delta_1300
    })
    print(delta_df_1300)

    # Output detailed table to CSV
    df_cap.to_csv('processed_capital_analysis.csv', index=False)
    print("\nAnalysis complete. Output saved to processed_capital_analysis.csv.")

if __name__ == '__main__':
    run_analysis()
