import pandas as pd

# Load dataset
df = pd.read_csv('data/meta-regression_study_data_heterogeneity_in_replication_projects.csv')

results = []
for disc in ['Social', 'Cognitive', 'Economics']:
    sub = df[df['discipline'] == disc]
    n_studies = sub['title'].nunique()
    
    # Original student usage per study
    stud_o = sub.groupby('title')['subjects.o'].agg(lambda s: (s == 'students').any()).sum()
    pct_o = (stud_o / n_studies) * 100
    
    # Replication student usage per study
    stud_r = sub.groupby('title')['subjects.r'].agg(lambda s: (s == 'students').any()).sum()
    pct_r = (stud_r / n_studies) * 100
    
    results.append({
        'discipline': disc,
        'n_studies': n_studies,
        'original_students': stud_o,
        'pct_original': round(pct_o, 1),
        'replication_students': stud_r,
        'pct_replication': round(pct_r, 1)
    })

res_df = pd.DataFrame(results)
print(res_df.to_string(index=False))
