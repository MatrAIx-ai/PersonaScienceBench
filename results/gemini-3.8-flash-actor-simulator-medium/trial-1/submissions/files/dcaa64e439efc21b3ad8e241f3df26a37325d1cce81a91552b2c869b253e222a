import pandas as pd
import numpy as np
from scipy import stats

def run_analysis():
    df = pd.read_csv('data/nls_incarceration_processed.csv')
    jailed = df[df['ever_jailed'] == 1].copy()
    
    print("=== SUMMARY OF 1985 MEDIAN WEALTH AMONG EVER-INCARCERATED INDIVIDUALS ===")
    overall_median = jailed['composite_wealth_1985'].median()
    overall_mean = jailed['composite_wealth_1985'].mean()
    print(f"Overall (N={len(jailed)}): Median = ${overall_median:,.2f}, Mean = ${overall_mean:,.2f}\n")
    
    print("--- By Race ---")
    race_stats = jailed.groupby('race')['composite_wealth_1985'].agg(
        count='count',
        median='median',
        mean='mean',
        q25=lambda x: x.quantile(0.25),
        q75=lambda x: x.quantile(0.75)
    ).reindex(['white', 'black', 'hipanic'])
    print(race_stats)
    
    print("\n--- By Sex ---")
    sex_stats = jailed.groupby('sex')['composite_wealth_1985'].agg(
        count='count',
        median='median',
        mean='mean',
        q25=lambda x: x.quantile(0.25),
        q75=lambda x: x.quantile(0.75)
    ).reindex(['male', 'female'])
    print(sex_stats)
    
    print("\n--- Intersectional (Race x Sex) ---")
    inter_stats = jailed.groupby(['race', 'sex'])['composite_wealth_1985'].agg(
        count='count',
        median='median',
        mean='mean',
        q25=lambda x: x.quantile(0.25),
        q75=lambda x: x.quantile(0.75)
    )
    print(inter_stats)
    
    # Statistical tests
    w = jailed[jailed['race'] == 'white']['composite_wealth_1985']
    b = jailed[jailed['race'] == 'black']['composite_wealth_1985']
    h = jailed[jailed['race'] == 'hipanic']['composite_wealth_1985']
    m = jailed[jailed['sex'] == 'male']['composite_wealth_1985']
    f = jailed[jailed['sex'] == 'female']['composite_wealth_1985']
    
    print("\n--- Non-parametric Significance Tests ---")
    print(f"Kruskal-Wallis (Race): stat = {stats.kruskal(w, b, h).statistic:.4f}, p = {stats.kruskal(w, b, h).pvalue:.4f}")
    print(f"Mann-Whitney U (White vs Black): stat = {stats.mannwhitneyu(w, b).statistic:.4f}, p = {stats.mannwhitneyu(w, b).pvalue:.4f}")
    print(f"Mann-Whitney U (White vs Hispanic): stat = {stats.mannwhitneyu(w, h).statistic:.4f}, p = {stats.mannwhitneyu(w, h).pvalue:.4f}")
    print(f"Mann-Whitney U (Black vs Hispanic): stat = {stats.mannwhitneyu(b, h).statistic:.4f}, p = {stats.mannwhitneyu(b, h).pvalue:.4f}")
    print(f"Mann-Whitney U (Male vs Female): stat = {stats.mannwhitneyu(m, f).statistic:.4f}, p = {stats.mannwhitneyu(m, f).pvalue:.4f}")

if __name__ == '__main__':
    run_analysis()
