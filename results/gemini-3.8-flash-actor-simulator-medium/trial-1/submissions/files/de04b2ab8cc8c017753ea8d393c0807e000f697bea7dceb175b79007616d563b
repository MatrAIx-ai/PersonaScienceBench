    return meta, df

def fit_hmm(obs_list, K, V=32, max_iter=200, tol=1e-6, seed=42):
    rng = np.random.default_rng(seed)
    pi = rng.dirichlet(np.ones(K) * 2.0)
    A = np.array([rng.dirichlet(np.ones(K) + (np.arange(K) == i) * 4.0) for i in range(K)])
    B = rng.dirichlet(np.ones(V) * 0.5, size=K)
    trace = []
    prev_ll = None
    for step in range(max_iter):
        exp_pi, exp_A, exp_B = np.zeros(K), np.zeros((K, K)), np.zeros((K, V))
        total_ll = 0.0
        for obs in obs_list:
            T = len(obs)
            alpha, c = np.zeros((T, K)), np.zeros(T)
            alpha[0] = pi * B[:, obs[0]]
            c[0] = max(np.sum(alpha[0]), 1e-300)
            alpha[0] /= c[0]
            for t in range(1, T):
                alpha[t] = (alpha[t - 1] @ A) * B[:, obs[t]]
                c[t] = max(np.sum(alpha[t]), 1e-300)
                alpha[t] /= c[t]
            total_ll += np.sum(np.log(c))
            beta = np.zeros((T, K))
            beta[-1] = 1.0
            for t in range(T - 2, -1, -1):
                beta[t] = (A @ (B[:, obs[t + 1]] * beta[t + 1])) / c[t + 1]
            gamma = alpha * beta
            gamma /= np.sum(gamma, axis=1, keepdims=True)
            exp_pi += gamma[0]
            for v in range(V):
                m = (obs == v)
                if np.any(m): exp_B[:, v] += np.sum(gamma[m], axis=0)
            M1 = alpha[:-1] / c[1:, None]
            M2 = B[:, obs[1:]].T * beta[1:]
            exp_A += A * (M1.T @ M2)
        rel_change = 0.0 if step == 0 else (total_ll - prev_ll) / abs(prev_ll)
        trace.append((step, total_ll, rel_change))
        if prev_ll is not None and abs(total_ll - prev_ll) < tol * (abs(prev_ll) + 1e-12):
            break
        prev_ll = total_ll
        pi = np.clip(exp_pi / np.sum(exp_pi), 1e-12, None); pi /= np.sum(pi)
        A = np.clip(exp_A / np.sum(exp_A, axis=1, keepdims=True), 1e-12, None); A /= np.sum(A, axis=1, keepdims=True)
        B = np.clip(exp_B / np.sum(exp_B, axis=1, keepdims=True), 1e-12, None); B /= np.sum(B, axis=1, keepdims=True)
    return {'K': K, 'll': total_ll, 'pi': pi, 'A': A, 'B': B, 'trace': trace, 'seed': seed}

def viterbi_decode(pi, A, B, obs):
    T, K = len(obs), len(pi)
    log_pi = np.log(np.maximum(pi, 1e-300))
    log_A = np.log(np.maximum(A, 1e-300))
    log_B = np.log(np.maximum(B, 1e-300))
    viterbi_table = np.zeros((T, K))
    backpointer = np.zeros((T, K), dtype=int)
    viterbi_table[0] = log_pi + log_B[:, obs[0]]
    for t in range(1, T):
        trans_prob = viterbi_table[t - 1][:, None] + log_A
        backpointer[t] = np.argmax(trans_prob, axis=0)
        viterbi_table[t] = np.max(trans_prob, axis=0) + log_B[:, obs[t]]
    best_path = np.zeros(T, dtype=int)
    best_path[-1] = np.argmax(viterbi_table[-1])
    for t in range(T - 2, -1, -1):
        best_path[t] = backpointer[t + 1, best_path[t + 1]]
    return best_path

def compute_posteriors_and_transitions(pi, A, B, obs):
    T, K = len(obs), len(pi)
    alpha, c = np.zeros((T, K)), np.zeros(T)
    alpha[0] = pi * B[:, obs[0]]
    c[0] = max(np.sum(alpha[0]), 1e-300)
    alpha[0] /= c[0]
    for t in range(1, T):
        alpha[t] = (alpha[t - 1] @ A) * B[:, obs[t]]
        c[t] = max(np.sum(alpha[t]), 1e-300)
        alpha[t] /= c[t]
    seq_ll = np.sum(np.log(c))
    beta = np.zeros((T, K))
    beta[-1] = 1.0
    for t in range(T - 2, -1, -1):
        beta[t] = (A @ (B[:, obs[t + 1]] * beta[t + 1])) / c[t + 1]
    gamma = alpha * beta
    gamma /= np.sum(gamma, axis=1, keepdims=True)
    M1 = alpha[:-1] / c[1:, None]
    M2 = B[:, obs[1:]].T * beta[1:]
    xi_sum = A * (M1.T @ M2)
    return seq_ll, gamma, xi_sum

def generate_diagnostics_image(candidate_records, chosen_K, df_trace, A, B, full_local_weights, df_assignments):
    H, W = 1000, 1400
    canvas = np.ones((H, W, 3), dtype=np.uint8) * 255
    draw_rect(canvas, 0, 0, W, 50, color=(35, 45, 60))
    draw_text(canvas, "LATENT MARKOV REGIME DIAGNOSTICS & MODEL SELECTION", 30, 15, color=(255, 255, 255), scale=2)
    
    # P1: BIC/AIC
    draw_rect(canvas, 50, 70, 600, 270, color=(248, 250, 252))
    draw_rect(canvas, 50, 70, 600, 270, color=(200, 210, 220), fill=False)
    draw_text(canvas, "1. Information Criteria (BIC & AIC vs K)", 70, 85, color=(20, 20, 20), scale=2)
    cands = [r['candidate'] for r in candidate_records]
    bics = [r['criterion'] for r in candidate_records]
    aics = [r['aic'] for r in candidate_records]
    min_crit, max_crit = min(min(bics), min(aics)), max(max(bics), max(aics))
    def map_p1(c, val):
        px = 120 + int((c - min(cands)) / (max(cands) - min(cands)) * 480)
        py = 300 - int((val - min_crit) / (max_crit - min_crit + 1e-9) * 180)
        return px, py
    for i in range(len(cands) - 1):
        x1, y1 = map_p1(cands[i], bics[i])
        x2, y2 = map_p1(cands[i+1], bics[i+1])
        draw_line(canvas, x1, y1, x2, y2, color=(31, 119, 180), thickness=3)
        x1a, y1a = map_p1(cands[i], aics[i])
        x2a, y2a = map_p1(cands[i+1], aics[i+1])
        draw_line(canvas, x1a, y1a, x2a, y2a, color=(255, 127, 14), thickness=2)
    for c, b in zip(cands, bics):
        px, py = map_p1(c, b)
        draw_rect(canvas, px-4, py-4, 9, 9, color=(20, 80, 160))
        draw_text(canvas, f"{c}", px-3, 312, color=(50, 50, 50), scale=1)
    draw_text(canvas, "BIC (Blue, min at K=6)", 70, 115, color=(31, 119, 180), scale=1)
    draw_text(canvas, "AIC (Orange)", 250, 115, color=(255, 127, 14), scale=1)
    draw_text(canvas, f"Chosen: K={chosen_K} (BIC = {bics[cands.index(chosen_K)]:.1f})", 380, 115, color=(180, 20, 20), scale=1)

    # P2: Marginal LL Gain
    draw_rect(canvas, 720, 70, 600, 270, color=(248, 250, 252))
    draw_rect(canvas, 720, 70, 600, 270, color=(200, 210, 220), fill=False)
    draw_text(canvas, "2. Marginal Fit Gain (Delta Log-Likelihood)", 740, 85, color=(20, 20, 20), scale=2)
    objs = [r['objective'] for r in candidate_records]
    mg = [objs[i] - objs[i-1] for i in range(1, len(objs))]
    max_mg = max(mg)
    for idx, (c, g) in enumerate(zip(cands[1:], mg)):
        bx = 790 + idx * 80
        bh = int(g / max_mg * 160)
        by = 290 - bh
        col = (46, 160, 67) if c != chosen_K else (180, 40, 40)
        draw_rect(canvas, bx, by, 50, bh, color=col)
        draw_text(canvas, f"K={c}", bx+10, 305, color=(50, 50, 50), scale=1)
        draw_text(canvas, f"+{int(g)}", bx+5, by-15, color=(20, 20, 20), scale=1)

    # P3: Fit Traces
    draw_rect(canvas, 50, 370, 600, 270, color=(248, 250, 252))
    draw_rect(canvas, 50, 370, 600, 270, color=(200, 210, 220), fill=False)
    draw_text(canvas, f"3. Fit Traces (5 Restarts for K={chosen_K})", 70, 385, color=(20, 20, 20), scale=2)
    runs = sorted(df_trace['run'].unique())
    min_ll, max_ll = df_trace['objective'].min(), df_trace['objective'].max()
    max_step = df_trace['step'].max()
    colors_run = [(31, 119, 180), (255, 127, 14), (44, 160, 44), (214, 39, 40), (148, 103, 189)]
    for r_idx in runs:
        sub = df_trace[df_trace['run'] == r_idx].sort_values('step')
        steps = sub['step'].values
        lls = sub['objective'].values
        col = colors_run[r_idx % len(colors_run)]
        for s in range(len(steps) - 1):
            x1 = 120 + int(steps[s] / max_step * 480)
            y1 = 600 - int((lls[s] - min_ll) / (max_ll - min_ll + 1e-9) * 180)
            x2 = 120 + int(steps[s+1] / max_step * 480)
            y2 = 600 - int((lls[s+1] - min_ll) / (max_ll - min_ll + 1e-9) * 180)
            draw_line(canvas, x1, y1, x2, y2, color=col, thickness=2)
        draw_text(canvas, f"Run {r_idx}", 100 + r_idx * 90, 415, color=col, scale=1)

    # P4: Matrix A
    draw_rect(canvas, 720, 370, 600, 270, color=(248, 250, 252))
    draw_rect(canvas, 720, 370, 600, 270, color=(200, 210, 220), fill=False)
    draw_text(canvas, f"4. Latent Transition Matrix A ({chosen_K}x{chosen_K})", 740, 385, color=(20, 20, 20), scale=2)
    cell_w, cell_h = 45, 32
    ox, oy = 870, 420
    for i in range(chosen_K):
        draw_text(canvas, f"S{i}", ox - 35, oy + i * cell_h + 10, color=(50, 50, 50), scale=1)
        for j in range(chosen_K):
            if i == 0:
                draw_text(canvas, f"S{j}", ox + j * cell_w + 12, oy - 18, color=(50, 50, 50), scale=1)
            val = A[i, j]
            c_val = int(255 - val * 220)
            color = (c_val, c_val, 255)
            draw_rect(canvas, ox + j * cell_w, oy + i * cell_h, cell_w - 2, cell_h - 2, color=color)
            t_col = (255, 255, 255) if val > 0.45 else (20, 20, 20)
            draw_text(canvas, f"{val:.2f}", ox + j * cell_w + 4, oy + i * cell_h + 10, color=t_col, scale=1)

    # P5: Matrix B
    draw_rect(canvas, 50, 670, 600, 270, color=(248, 250, 252))
    draw_rect(canvas, 50, 670, 600, 270, color=(200, 210, 220), fill=False)
    draw_text(canvas, "5. Latent Emission Matrix B (6 States x 32 Symbols)", 70, 685, color=(20, 20, 20), scale=2)
    ox5, oy5 = 120, 730
    sym_w, state_h = 15, 30
    max_b = np.max(B)
    for i in range(chosen_K):
        draw_text(canvas, f"S{i}", ox5 - 35, oy5 + i * state_h + 10, color=(50, 50, 50), scale=1)
        for v in range(32):
            val = B[i, v] / (max_b + 1e-9)
            r_c = int(255 - val * 180)
            g_c = int(240 - val * 60)
            b_c = int(200 - val * 180)
            draw_rect(canvas, ox5 + v * sym_w, oy5 + i * state_h, sym_w - 1, state_h - 2, color=(r_c, g_c, b_c))
    draw_text(canvas, "Symbols 0 ........................................ 31", ox5, oy5 + chosen_K * state_h + 10, color=(80, 80, 80), scale=1)

    # P6: Posterior State Trajectory
    draw_rect(canvas, 720, 670, 600, 270, color=(248, 250, 252))
    draw_rect(canvas, 720, 670, 600, 270, color=(200, 210, 220), fill=False)
    draw_text(canvas, "6. Posterior Weights & Viterbi Path (seq_00 segment)", 740, 685, color=(20, 20, 20), scale=2)
    ox6, oy6 = 780, 730
    n_seg = 120
    seg_w = full_local_weights[:n_seg]
    seg_lbl = df_assignments.iloc[:n_seg]['label'].values
    step_w = 4
    for t in range(n_seg):
        for k in range(chosen_K):
            w_val = seg_w[t, k]
            rc = int(w_val * 255)
            gc = int(w_val * 180)
            bc = int(w_val * 60)
            draw_rect(canvas, ox6 + t * step_w, oy6 + (chosen_K - 1 - k) * state_h, step_w, state_h - 1, color=(rc, gc, bc))
        v_k = seg_lbl[t]
        py = oy6 + (chosen_K - 1 - v_k) * state_h + state_h // 2
        draw_rect(canvas, ox6 + t * step_w, py - 2, step_w, 4, color=(0, 255, 255))
    for k in range(chosen_K):
        draw_text(canvas, f"S{k}", ox6 - 35, oy6 + (chosen_K - 1 - k) * state_h + 8, color=(50, 50, 50), scale=1)
    draw_text(canvas, "Cyan line: Viterbi optimal sequence path", ox6 + 50, oy6 + chosen_K * state_h + 12, color=(0, 160, 180), scale=1)

    write_png('results/diagnostics.png', canvas)
    print("Saved results/diagnostics.png")

def main():
    os.makedirs('results', exist_ok=True)
    meta, df = load_data()
    seq_ids = sorted(df['sequence_id'].unique())
    obs_list = [df[df['sequence_id'] == sid].sort_values('position')['symbol'].values for sid in seq_ids]
    N_tot, V = len(df), 32
    candidates = [2, 3, 4, 5, 6, 7, 8]
    candidate_records = []
    best_candidate_models = {}
    
    print("Evaluating candidate state counts K in 2..8...")
    seeds_eval = [42, 101, 777]
    for K in candidates:
        n_free = (K - 1) + K * (K - 1) + K * (V - 1)
        best_m = None
        for s in seeds_eval:
            m = fit_hmm(obs_list, K, V=V, max_iter=150, tol=1e-6, seed=s)
            if best_m is None or m['ll'] > best_m['ll']:
                best_m = m
        best_candidate_models[K] = best_m
        bic = -2.0 * best_m['ll'] + n_free * np.log(N_tot)
        aic = -2.0 * best_m['ll'] + 2.0 * n_free
        candidate_records.append({
            'candidate': K, 'n_free_values': n_free,
            'objective': best_m['ll'], 'criterion': bic, 'aic': aic
        })
        print(f"K={K:2d} | Params={n_free:3d} | LogLik={best_m['ll']:10.2f} | BIC={bic:10.2f}")
        
    best_bic_idx = np.argmin([r['criterion'] for r in candidate_records])
    chosen_K = candidate_records[best_bic_idx]['candidate']
    print(f"\nChosen K={chosen_K} with minimum BIC = {candidate_records[best_bic_idx]['criterion']:.2f}")
    
    # 1. results/candidate_summary.csv
    df_cand = pd.DataFrame(candidate_records)
    df_cand['chosen'] = (df_cand['candidate'] == chosen_K)
    df_cand[['candidate', 'n_free_values', 'objective', 'criterion', 'chosen']].to_csv('results/candidate_summary.csv', index=False)
    print("Saved results/candidate_summary.csv")
    
    # Restarts for chosen K
    print(f"\nRunning 5 independent restarts for chosen K={chosen_K}...")
    chosen_seeds = [11, 23, 37, 51, 79]
    restart_models, fit_trace_rows = [], []
    for r_idx, s in enumerate(chosen_seeds):
        m = fit_hmm(obs_list, chosen_K, V=V, max_iter=200, tol=1e-7, seed=s)
        restart_models.append(m)
        for step, obj, rel_ch in m['trace']:
            fit_trace_rows.append({
                'run': r_idx, 'step': step, 'objective': obj, 'relative_change': rel_ch
            })
            
    # 5. results/fit_trace.csv
    df_trace = pd.DataFrame(fit_trace_rows)
    df_trace.to_csv('results/fit_trace.csv', index=False)
    print("Saved results/fit_trace.csv")
    
    best_chosen = max(restart_models, key=lambda m: m['ll'])
    pi, A, B = best_chosen['pi'], best_chosen['A'], best_chosen['B']
    
    # 2. results/matrix_a.csv
    rows_a = [{'row': i, 'column': j, 'value': float(A[i, j])} for i in range(chosen_K) for j in range(chosen_K)]
    pd.DataFrame(rows_a).to_csv('results/matrix_a.csv', index=False)
    print("Saved results/matrix_a.csv")
    
    # 3. results/matrix_b.csv
    symbol_labels = {item['symbol']: item['label'] for item in meta['alphabet']}
    rows_b = [{'row': i, 'symbol': v, 'symbol_label': symbol_labels.get(v, f"sym_{v:02d}"), 'value': float(B[i, v])}
              for i in range(chosen_K) for v in range(V)]
    pd.DataFrame(rows_b).to_csv('results/matrix_b.csv', index=False)
    print("Saved results/matrix_b.csv")
    
    # 4. results/vector_a.csv
    rows_v = [{'row': i, 'value': float(pi[i])} for i in range(chosen_K)]
    pd.DataFrame(rows_v).to_csv('results/vector_a.csv', index=False)
    print("Saved results/vector_a.csv")
    
    # 6, 7, 8, 9
    full_local_weights = np.zeros((N_tot, chosen_K), dtype=float)
    total_transition_weights = np.zeros((chosen_K, chosen_K), dtype=float)
    local_assignment_rows, stream_diag_rows = [], []
    
    for sid in seq_ids:
        sub = df[df['sequence_id'] == sid].sort_values('position')
        obs = sub['symbol'].values
        positions = sub['position'].values
        global_indices = sub['global_index'].values
        T = len(obs)
        seq_ll, gamma, xi_sum = compute_posteriors_and_transitions(pi, A, B, obs)
        viterbi_path = viterbi_decode(pi, A, B, obs)
        full_local_weights[global_indices] = gamma
        total_transition_weights += xi_sum
        for p, g, lbl in zip(positions, global_indices, viterbi_path):
            local_assignment_rows.append({
                'sequence_id': sid, 'position': int(p), 'global_index': int(g), 'label': int(lbl)
            })
        eps = 1e-12
        seq_entropies = -np.sum(gamma * np.log(gamma + eps), axis=1)
        mean_entropy = float(np.mean(seq_entropies))
        _, counts = np.unique(viterbi_path, return_counts=True)
        dominant_frac = float(np.max(counts) / T)
        stream_diag_rows.append({
            'sequence_id': sid, 'n_positions': int(T),
            'mean_objective': float(seq_ll / T),
            'weight_entropy_mean': float(mean_entropy),
            'dominant_label_fraction': float(dominant_frac)
        })
        
    # 6. results/local_weights.npy
    np.save('results/local_weights.npy', full_local_weights)
    print("Saved results/local_weights.npy")
    
    # 7. results/neighbor_summary.csv
    total_transitions = np.sum(total_transition_weights)
    rows_neighbor = []
    for i in range(chosen_K):
        row_sum = np.sum(total_transition_weights[i])
        for j in range(chosen_K):
            w = total_transition_weights[i, j]
            jf = w / total_transitions
            cv = w / row_sum if row_sum > 0 else 0.0
            rows_neighbor.append({
                'row': i, 'column': j, 'weight': float(w),
                'joint_fraction': float(jf), 'conditional_value': float(cv)
            })
    pd.DataFrame(rows_neighbor).to_csv('results/neighbor_summary.csv', index=False)
    print("Saved results/neighbor_summary.csv")
    
    # 8. results/local_assignments.csv
    df_assign = pd.DataFrame(local_assignment_rows).sort_values('global_index').reset_index(drop=True)
    df_assign.to_csv('results/local_assignments.csv', index=False)
    print("Saved results/local_assignments.csv")
    
    # 9. results/stream_diagnostics.csv
    pd.DataFrame(stream_diag_rows).to_csv('results/stream_diagnostics.csv', index=False)
    print("Saved results/stream_diagnostics.csv")
    
    # 10. results/diagnostics.png
    generate_diagnostics_image(candidate_records, chosen_K, df_trace, A, B, full_local_weights, df_assign)
    print("\nAll 10 required artifacts generated successfully.")

if __name__ == '__main__':
    main()
