def draw_text(canvas, text, x0, y0, color=(0, 0, 0), scale=1):
    H, W, _ = canvas.shape
    cur_x = x0
    for char in text:
        bitmap = FONT_5X7.get(char, FONT_5X7.get('?', [0x00]*5))
        for col_idx, col_val in enumerate(bitmap):
            for row_idx in range(7):
                if (col_val >> row_idx) & 1:
                    px = cur_x + col_idx * scale
                    py = y0 + row_idx * scale
                    if 0 <= py < H and 0 <= px < W:
                        canvas[py:py+scale, px:px+scale] = color
        cur_x += (len(bitmap) + 1) * scale

def draw_line(canvas, x0, y0, x1, y1, color=(0, 0, 0), thickness=1):
    H, W, _ = canvas.shape
    pts = max(abs(x1 - x0), abs(y1 - y0), 1) * 2
    xs = np.linspace(x0, x1, pts)
    ys = np.linspace(y0, y1, pts)
    for x, y in zip(xs, ys):
        ix, iy = int(round(x)), int(round(y))
        for dy in range(-thickness//2, thickness//2 + 1):
            for dx in range(-thickness//2, thickness//2 + 1):
                if 0 <= iy+dy < H and 0 <= ix+dx < W:
                    canvas[iy+dy, ix+dx] = color

def draw_rect(canvas, x0, y0, w, h, color=(0, 0, 0), fill=True):
    H, W, _ = canvas.shape
    x1, y1 = min(x0 + w, W), min(y0 + h, H)
    x0, y0 = max(x0, 0), max(y0, 0)
    if fill:
        canvas[y0:y1, x0:x1] = color
    else:
        canvas[y0:y1, x0] = color
        canvas[y0:y1, x1-1] = color
        canvas[y0, x0:x1] = color
        canvas[y1-1, x0:x1] = color

def write_png(filename, img_array):
    H, W, _ = img_array.shape
    raw_data = bytearray()
    for y in range(H):
        raw_data.append(0)
        raw_data.extend(img_array[y].tobytes())
    compressed = zlib.compress(raw_data, level=6)
    def chunk(tag, data):
        c = tag + data
        return struct.pack('>I', len(data)) + c + struct.pack('>I', zlib.crc32(c))
    png = bytearray(b'\x89PNG\r\n\x1a\n')
    ihdr = struct.pack('>IIBBBBB', W, H, 8, 2, 0, 0, 0)
    png.extend(chunk(b'IHDR', ihdr))
    png.extend(chunk(b'IDAT', compressed))
    png.extend(chunk(b'IEND', b''))
    with open(filename, 'wb') as f:
        f.write(png)

