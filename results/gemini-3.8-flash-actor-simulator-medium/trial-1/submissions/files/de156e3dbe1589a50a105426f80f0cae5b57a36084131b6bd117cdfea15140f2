"""
Analysis of NLSY79: Effects of SES, Race, and Academic Characteristics on BA Completion and Educational Attainment.
"""

import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf

def run_analysis():
    # 1. Load data
    df = pd.read_csv('data/nls_raw.csv')
    
    # 2. Variable construction and cleaning
    # Outcome: Highest grade completed and BA indicator (>= 16)
    # Recode special code 95 (ungraded/other) as missing
    df['educ'] = df['Highest grade completed, 1979'].replace(95, np.nan)
    df['ba'] = (df['educ'] >= 16).astype(float)
    df.loc[df['educ'].isnull(), 'ba'] = np.nan
    
    # Race/ethnicity indicators (Reference: Non-Black Non-Hispanic = 3)
    df['black'] = (df['Racial/ethnic cohort, 1979'] == 1).astype(int)
    df['hispanic'] = (df['Racial/ethnic cohort, 1979'] == 2).astype(int)
    
    # Demographics
    df['female'] = (df['Sex of respondent, 1979'] == 2).astype(int)
    df['age_1979'] = df['Age of respondent, 1979']
    
    # Socioeconomic Status (SES)
    df['mom_educ'] = df["Highest grade completed by respondent's mother, 1979"].replace(95, np.nan)
    df['dad_educ'] = df["Highest grade completed by respondent's father, 1979"].replace(95, np.nan)
    df['parent_educ'] = df[['mom_educ', 'dad_educ']].max(axis=1)
    
    df['fam_income_1979'] = df['Total net family income, previous calendar year, 1979']
    df['log_income_1979'] = np.log(df['fam_income_1979'].replace(0, np.nan))
    
    # Academic Characteristics
    asvab_cols = [
        'ASVAB - Arithmetic Reasoning Z Score (rounded), 1981',
        'ASVAB - Word Knowledge Z Score (rounded), 1981',
        'ASVAB - Paragraph Comprehension Z Score (rounded), 1981',
        'ASVAB - Mathematics Knowledge Z Score (rounded), 1981'
    ]
    df['afqt'] = df[asvab_cols].mean(axis=1)
    df['afqt_std'] = (df['afqt'] - df['afqt'].mean()) / df['afqt'].std()
    
    # High school class rank percentile
    df['class_rank_pct'] = (df['Number of students in class last year attended at this school, 1981'] - 
                            df['Rank in class last year attended at this school, 1981'] + 1) / \
                            df['Number of students in class last year attended at this school, 1981'] * 100
    df['class_rank_pct'] = df['class_rank_pct'].clip(0, 100)
    df['class_rank_std'] = (df['class_rank_pct'] - df['class_rank_pct'].mean()) / df['class_rank_pct'].std()
    
    # Secondary SES: 1985 net wealth
    df['ihs_wealth_1985'] = np.arcsinh(df['Family net wealth, 1985'] / 1000.0)
    
    print("=== DATA SUMMARY ===")
    print(f"Total respondents: {len(df)}")
    print(f"BA graduates (grade >= 16): {df['ba'].sum():.0f} ({df['ba'].mean()*100:.2f}%)")
    print(f"Valid AFQT respondents: {df['afqt_std'].notnull().sum()}")
    print(f"Valid Class Rank respondents: {df['class_rank_pct'].notnull().sum()}")
    
    # --- Sample 1: AFQT Sample (N = 8,654) ---
    sub1 = df.dropna(subset=['ba', 'black', 'hispanic', 'female', 'parent_educ', 'log_income_1979', 'age_1979', 'afqt_std']).copy()
    print(f"\n--- SAMPLE 1: AFQT Sample (N = {len(sub1)}) ---")
    
    # Model 1A: BA Logit without Academic Controls
    m1a = smf.logit('ba ~ black + hispanic + female + parent_educ + log_income_1979 + age_1979', data=sub1).fit(disp=False)
    # Model 1B: BA Logit with AFQT
    m1b = smf.logit('ba ~ black + hispanic + female + parent_educ + log_income_1979 + age_1979 + afqt_std', data=sub1).fit(disp=False)
    
    print("Model 1A (No Academic Controls):")
    res1a = pd.DataFrame({'Coef': m1a.params, 'SE': m1a.bse, 'p': m1a.pvalues, 'OR': np.exp(m1a.params)})
    print(res1a.round(4))
    
    print("\nModel 1B (With AFQT Standardized Score):")
    res1b = pd.DataFrame({'Coef': m1b.params, 'SE': m1b.bse, 'p': m1b.pvalues, 'OR': np.exp(m1b.params)})
    print(res1b.round(4))
    
    # OLS for Educational Attainment (Sample 1)
    ols1a = smf.ols('educ ~ black + hispanic + female + parent_educ + log_income_1979 + age_1979', data=sub1).fit()
    ols1b = smf.ols('educ ~ black + hispanic + female + parent_educ + log_income_1979 + age_1979 + afqt_std', data=sub1).fit()
    
    print("\nOLS Attainment 1A:")
    print(pd.DataFrame({'Coef': ols1a.params, 'SE': ols1a.bse, 'p': ols1a.pvalues}).round(4))
    print("\nOLS Attainment 1B (+ AFQT):")
    print(pd.DataFrame({'Coef': ols1b.params, 'SE': ols1b.bse, 'p': ols1b.pvalues}).round(4))
    
    # --- Sample 2: Dual Academic Controls (AFQT + Class Rank, N = 4,105) ---
    sub2 = df.dropna(subset=['ba', 'black', 'hispanic', 'female', 'parent_educ', 'log_income_1979', 'age_1979', 'afqt_std', 'class_rank_std']).copy()
    print(f"\n--- SAMPLE 2: AFQT + Class Rank Sample (N = {len(sub2)}) ---")
    
    m2a = smf.logit('ba ~ black + hispanic + female + parent_educ + log_income_1979 + age_1979', data=sub2).fit(disp=False)
    m2b = smf.logit('ba ~ black + hispanic + female + parent_educ + log_income_1979 + age_1979 + afqt_std + class_rank_std', data=sub2).fit(disp=False)
    
    print("Model 2A (No Academic Controls):")
    print(pd.DataFrame({'Coef': m2a.params, 'SE': m2a.bse, 'p': m2a.pvalues, 'OR': np.exp(m2a.params)}).round(4))
    print("\nModel 2B (With AFQT + Class Rank):")
    print(pd.DataFrame({'Coef': m2b.params, 'SE': m2b.bse, 'p': m2b.pvalues, 'OR': np.exp(m2b.params)}).round(4))
    
    ols2a = smf.ols('educ ~ black + hispanic + female + parent_educ + log_income_1979 + age_1979', data=sub2).fit()
    ols2b = smf.ols('educ ~ black + hispanic + female + parent_educ + log_income_1979 + age_1979 + afqt_std + class_rank_std', data=sub2).fit()
    
    print("\nOLS Attainment 2A:")
    print(pd.DataFrame({'Coef': ols2a.params, 'SE': ols2a.bse, 'p': ols2a.pvalues}).round(4))
    print("\nOLS Attainment 2B (+ AFQT + Class Rank):")
    print(pd.DataFrame({'Coef': ols2b.params, 'SE': ols2b.bse, 'p': ols2b.pvalues}).round(4))

if __name__ == '__main__':
    run_analysis()
