import os
import glob
import pandas as pd
import numpy as np

def run_analysis():
    data_dir = 'data/CHIP_DP10_GQ20_PASS'
    files = sorted(glob.glob(os.path.join(data_dir, '*.xlsx')))
    print(f"Total files found: {len(files)}")
    
    records = []
    
    for f in files:
        fname = os.path.basename(f)
        df_raw = pd.read_excel(f, header=None)
        
        # Row 0 col 4 contains Sample Role and ID, e.g. "Proband (179-P1)"
        sample_meta = str(df_raw.iloc[0, 4])
        
        # Row 1 contains standardized column names
        cols = df_raw.iloc[1].tolist()
        
        # Data rows start from row 2
        df_data = df_raw.iloc[2:].copy()
        df_data.columns = cols
        
        # Add metadata
        df_data['Source_File'] = fname
        df_data['Sample_Meta'] = sample_meta
        
        records.append(df_data)
        
    df_all = pd.concat(records, ignore_index=True)
    total_calls = len(df_all)
    print(f"Total calls (rows) across all files: {total_calls}")
    
    chr_pos_col = 'Chr:Pos'
    ref_alt_col = 'Ref/Alt'
    zyg_col = 'Zygosity'
    
    # Clean string values while preserving None / NaN
    df_all[zyg_col] = df_all[zyg_col].apply(lambda x: str(x).strip() if pd.notna(x) else np.nan)
    
    # Unique variant identifier
    df_all['Variant_ID'] = df_all[chr_pos_col].astype(str) + '_' + df_all[ref_alt_col].astype(str)
    
    # Counts
    zyg_counts = df_all[zyg_col].value_counts(dropna=False).to_dict()
    nan_count = int(df_all[zyg_col].isna().sum())
    
    print("\n--- Zygosity Distribution across all calls ---")
    for k, v in zyg_counts.items():
        print(f"  {k}: {v}")
        
    total_unique_variants = df_all['Variant_ID'].nunique()
    print(f"\nTotal unique genomic variants in dataset: {total_unique_variants}")
    
    # 1. Base filter: Zygosity != 'Reference' (including NaN)
    df_not_ref = df_all[df_all[zyg_col] != 'Reference']
    calls_not_ref = len(df_not_ref)
    unique_vars_not_ref = df_not_ref['Variant_ID'].nunique()
    
    # 2. Strict non-reference filter: Zygosity in ['Heterozygous', 'Homozygous Variant']
    df_het_hom = df_all[df_all[zyg_col].isin(['Heterozygous', 'Homozygous Variant'])]
    calls_het_hom = len(df_het_hom)
    unique_vars_het_hom = df_het_hom['Variant_ID'].nunique()
    
    # 3. Only Reference
    df_ref = df_all[df_all[zyg_col] == 'Reference']
    calls_ref = len(df_ref)
    unique_vars_ref = df_ref['Variant_ID'].nunique()
    
    # 4. NaN / Missing Zygosity
    df_nan = df_all[df_all[zyg_col].isna()]
    calls_nan = len(df_nan)
    unique_vars_nan = df_nan['Variant_ID'].nunique()
    
    print("\n--- Analysis Results ---")
    print(f"1. Total calls before filtering: {total_calls}")
    print(f"   - Reference calls: {calls_ref} ({unique_vars_ref} unique variants)")
    print(f"   - Heterozygous calls: {zyg_counts.get('Heterozygous', 0)}")
    print(f"   - Homozygous Variant calls: {zyg_counts.get('Homozygous Variant', 0)}")
    print(f"   - NaN (missing/multiallelic) calls: {calls_nan} ({unique_vars_nan} unique variants)")
    print()
    print(f"2. After removing 'Reference' calls (Zygosity != 'Reference'):")
    print(f"   - Remaining calls / rows: {calls_not_ref}")
    print(f"   - Remaining unique variants: {unique_vars_not_ref}")
    print()
    print(f"3. Strict variant calls (Heterozygous + Homozygous Variant):")
    print(f"   - Remaining calls / rows: {calls_het_hom}")
    print(f"   - Remaining unique variants: {unique_vars_het_hom}")
    
    summary_df = pd.DataFrame([
        {
            'Category': 'Total dataset (all calls)',
            'Call_Count (Rows)': total_calls,
            'Unique_Variants (Chr:Pos_Ref/Alt)': total_unique_variants
        },
        {
            'Category': 'Reference calls',
            'Call_Count (Rows)': calls_ref,
            'Unique_Variants (Chr:Pos_Ref/Alt)': unique_vars_ref
        },
        {
            'Category': 'Remaining after removing Reference (Zygosity != Reference)',
            'Call_Count (Rows)': calls_not_ref,
            'Unique_Variants (Chr:Pos_Ref/Alt)': unique_vars_not_ref
        },
        {
            'Category': 'Strict Non-Reference (Heterozygous + Homozygous Variant)',
            'Call_Count (Rows)': calls_het_hom,
            'Unique_Variants (Chr:Pos_Ref/Alt)': unique_vars_het_hom
        },
        {
            'Category': 'NaN / Missing Zygosity (Multiallelic loci)',
            'Call_Count (Rows)': calls_nan,
            'Unique_Variants (Chr:Pos_Ref/Alt)': unique_vars_nan
        }
    ])
    
    summary_df.to_csv('variant_counts_summary.csv', index=False)
    print("\nSaved summary to variant_counts_summary.csv")

if __name__ == '__main__':
    run_analysis()
