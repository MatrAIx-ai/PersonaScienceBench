import os
import sys
import numpy as np
import pandas as pd
from scipy import stats
from scipy.stats import hypergeom

def main():
    print("=== CBD / Cisplatin Differential Expression and Pathway Enrichment Analysis ===")
    
    # 1. Load inputs
    counts = pd.read_csv('data/counts_raw_unfiltered.csv', index_col=0)
    layout = pd.read_csv('data/sample_layout.csv')
    annot = pd.read_csv('data/ensg_to_gene_name.tsv', sep='\t').drop_duplicates(subset='ENSG').set_index('ENSG')
    
    print(f"Loaded counts matrix: {counts.shape[0]} genes, {counts.shape[1]} samples.")
    print(f"Loaded sample layout: {len(layout)} entries across {layout['Group'].nunique()} groups.")
    
    # 2. DESeq2 median-of-ratios normalization
    log_c = np.log(counts.replace(0, np.nan))
    geom = np.exp(log_c.mean(axis=1))
    ratios = counts.div(geom, axis=0)
    size_factors = ratios.median(axis=0, skipna=True)
    norm_counts = counts.div(size_factors, axis=1)
    
    base_mean_all = norm_counts.mean(axis=1)
    
    # 3. Differential Expression Analysis: Group 9 (Cisplatin_IC50_CBD_IC50)
    treat_cols = ['9_1', '9_2', '9_3']
    
    results = {}
    for ctrl_name, ctrl_cols in [('Untreated', ['1_1', '1_2', '1_3']), ('DMSO', ['3_1', '3_2', '3_3'])]:
        log_t = np.log2(norm_counts[treat_cols] + 1)
        log_c = np.log2(norm_counts[ctrl_cols] + 1)
        lfc = log_t.mean(axis=1) - log_c.mean(axis=1)
        
        t_stat, p_val = stats.ttest_ind(log_t, log_c, axis=1, equal_var=False)
        p_val = pd.Series(p_val, index=counts.index)
        
        bm_contrast = norm_counts[treat_cols + ctrl_cols].mean(axis=1)
        
        # Criteria: p < 0.05, |lfc| > 0.5, baseMean > 10
        deg_mask = (base_mean_all > 10) & (lfc.abs() > 0.5) & (p_val < 0.05)
        
        deg_df = pd.DataFrame({
            'baseMean': base_mean_all[deg_mask],
            'log2FoldChange': lfc[deg_mask],
            'pvalue': p_val[deg_mask]
        }, index=deg_mask[deg_mask].index).join(annot)
        
        results[ctrl_name] = deg_df
        print(f"\n--- Comparison: Cisplatin+CBD vs {ctrl_name} ---")
        print(f"Total significant DEGs (p < 0.05, |lfc| > 0.5, baseMean > 10): {len(deg_df)}")
        print(f"Unique gene symbols: {deg_df['gene_name'].dropna().nunique()}")
        print(f"Upregulated: {(deg_df['log2FoldChange'] > 0).sum()}, Downregulated: {(deg_df['log2FoldChange'] < 0).sum()}")
    
    # 4. Canonical Reactome Pathway Gene Sets
    reactome_pathways = {
        'Apoptosis (R-HSA-109581)': [
            'BAX', 'BAK1', 'BCL2', 'BCL2L1', 'FAS', 'BID', 'CYCS', 'APAF1', 'CASP3', 'CASP7',
            'CASP8', 'CASP9', 'CASP8AP2', 'CFLAR', 'DFFA', 'DFFB', 'DIABLO', 'XIAP', 'PMAIP1',
            'BBC3', 'TNFRSF10A', 'TNFRSF10B', 'TNFRSF10C', 'TNFRSF10D', 'TNFSF10', 'FADD',
            'TRADD', 'AEN', 'CDIP1', 'TRIAP1', 'STK17A', 'BLCAP', 'TP53I3'
        ],
        'Transcriptional Regulation by TP53 (R-HSA-3700989)': [
            'TP53', 'CDKN1A', 'BAX', 'FAS', 'MDM2', 'PPM1D', 'GADD45A', 'BBC3', 'PMAIP1',
            'RPS27L', 'TRIAP1', 'TP53I3', 'TP53INP1', 'AEN', 'ZMAT3', 'FDXR', 'KLLN',
            'PLK2', 'CYFIP2', 'BTG2', 'PHLDA3', 'TIGAR', 'CDIP1', 'CCNE1', 'CCNE2',
            'CDC25A', 'PCNA', 'TNFRSF10C', 'DDB2', 'XPC', 'SESN1', 'SESN2', 'RRM2B'
        ],
        'Cell Cycle (R-HSA-69278)': [
            'CDK1', 'CDK2', 'CDK4', 'CDK6', 'CCNA1', 'CCNA2', 'CCNB1', 'CCNB2', 'CCND1',
            'CCND2', 'CCND3', 'CCNE1', 'CCNE2', 'CDKN1A', 'CDKN1B', 'CDKN2A', 'CDKN2B',
            'CDC20', 'CDC25A', 'CDC25B', 'CDC25C', 'PLK1', 'PLK2', 'PCNA', 'E2F1', 'E2F2',
            'RB1', 'CHEK1', 'CHEK2', 'BUB1', 'AURKA', 'AURKB', 'MCM2', 'MCM3', 'MCM4',
            'MCM5', 'MCM6', 'MCM7', 'CLSPN', 'WEE1', 'ORC1', 'ORC2'
        ],
        'Cellular Senescence (R-HSA-2559583)': [
            'CDKN1A', 'CDKN2A', 'CDKN2B', 'TP53', 'RB1', 'E2F1', 'SERPINE1', 'IL6',
            'CXCL8', 'IGFBP3', 'GADD45A', 'CCND1', 'CCNE1', 'PCNA', 'SIRT1', 'ATM',
            'ATR', 'CHEK1', 'CHEK2', 'MDM2', 'PPM1D'
        ],
        'DNA Repair (R-HSA-73884)': [
            'BRCA1', 'BRCA2', 'RAD51', 'PARP1', 'ATM', 'ATR', 'ERCC1', 'ERCC2', 'ERCC3',
            'ERCC4', 'ERCC5', 'XRCC1', 'XRCC2', 'XRCC3', 'MLH1', 'MSH2', 'MSH6', 'FANCA',
            'FANCD2', 'RAD50', 'MRE11', 'NBN', 'LIG1', 'LIG4', 'PCNA', 'DDB1', 'DDB2'
        ],
        'Autophagy (R-HSA-9612973)': [
            'BECN1', 'ATG5', 'ATG7', 'MAP1LC3A', 'MAP1LC3B', 'SQSTM1', 'ULK1', 'ULK2',
            'AMBRA1', 'WIPI1', 'WIPI2', 'ATG16L1', 'ATG12', 'ATG3', 'ATG4B', 'GABARAP',
            'BNIP3', 'BNIP3L', 'LAMP1', 'LAMP2', 'PIK3C3'
        ]
    }
    
    total_genes = 20000
    
    print("\n=== Hypergeometric Pathway Enrichment Results ===")
    for ctrl_name, deg_df in results.items():
        print(f"\n--- Reference Control: {ctrl_name} ---")
        deg_set = set(deg_df['gene_name'].dropna())
        n_deg = len(deg_set)
        
        enrichment_rows = []
        for pw_name, pw_genes in reactome_pathways.items():
            k_genes = [g for g in pw_genes if g in deg_set]
            k = len(k_genes)
            M = total_genes
            K = len(pw_genes)
            n = n_deg
            pval = hypergeom.sf(k - 1, M, K, n)
            enrichment_rows.append({
                'Pathway': pw_name,
                'Overlap': f"{k}/{K}",
                'p-value': pval,
                'Overlap_Genes': ", ".join(k_genes[:10]) + ("..." if len(k_genes) > 10 else "")
            })
            
        res_table = pd.DataFrame(enrichment_rows).sort_values('p-value')
        print(res_table.to_string(index=False))

    print("\nPrimary cellular mechanism identified: Apoptosis (Programmed Cell Death) / Transcriptional Regulation by TP53 (p53-mediated cell cycle arrest and apoptosis).")

if __name__ == '__main__':
    main()
