#!/usr/bin/env python3
"""
Analysis script for BixBench bix-7-q2:
"What is the average number of CHIP variants per sample after filtering out intronic, intergenic, and UTR variants?"
"""

import os
import glob
import pandas as pd
import numpy as np

def run_analysis():
    input_pattern = 'data/CHIP_DP10_GQ20_PASS/*.xlsx'
    files = sorted(glob.glob(input_pattern))
    print(f"Found {len(files)} sample files in {input_pattern}")

    # Excluded Sequence Ontology terms based on task requirements:
    # Intronic: intron_variant
    # UTR: 3_prime_UTR_variant, 5_prime_UTR_variant, 5_prime_UTR_premature_start_codon_gain_variant
    # Intergenic / Non-coding flanking: upstream_gene_variant
    exclude_so = {
        'intron_variant',
        '3_prime_UTR_variant',
        '5_prime_UTR_variant',
        '5_prime_UTR_premature_start_codon_gain_variant',
        'upstream_gene_variant'
    }

    # Biological variant definition for each individual sample:
    # Genotypes carrying an alternate allele: Heterozygous or Homozygous Variant
    valid_zygosity = {'Heterozygous', 'Homozygous Variant'}

    per_sample_records = []

    for f in files:
        sample_name = os.path.basename(f).replace('230209_Exome_GRCh38_CHIP_', '').replace('.xlsx', '')
        # Read Excel skipping super-header row 0 so row 1 provides standard column names
        df = pd.read_excel(f, header=1)

        # 1. Total cohort candidate rows evaluated for this sample
        n_total_rows = len(df)

        # 2. Variants where the sample possesses the alternate allele
        df_variant = df[df['Zygosity'].isin(valid_zygosity)]
        n_variants_prefilter = len(df_variant)

        # 3. Variants after filtering out intronic, intergenic, and UTR variants
        df_filtered = df_variant[~df_variant['Sequence Ontology (Combined)'].isin(exclude_so)]
        n_variants_postfilter = len(df_filtered)

        # Breakdown by functional consequence
        so_counts = df_filtered['Sequence Ontology (Combined)'].value_counts().to_dict()

        per_sample_records.append({
            'sample_id': sample_name,
            'total_rows': n_total_rows,
            'prefilter_variants': n_variants_prefilter,
            'filtered_variants': n_variants_postfilter,
            'synonymous': so_counts.get('synonymous_variant', 0),
            'missense': so_counts.get('missense_variant', 0),
            'splice_region': so_counts.get('splice_region_variant', 0),
            'frameshift': so_counts.get('frameshift_variant', 0),
            'inframe_insertion': so_counts.get('inframe_insertion', 0),
            'inframe_deletion': so_counts.get('inframe_deletion', 0)
        })

    df_summary = pd.DataFrame(per_sample_records)
    output_csv = 'chip_filtered_variants_per_sample.csv'
    df_summary.to_csv(output_csv, index=False)
    print(f"Summary saved to {output_csv}")

    total_filtered = df_summary['filtered_variants'].sum()
    n_samples = len(df_summary)
    mean_val = df_summary['filtered_variants'].mean()
    std_val = df_summary['filtered_variants'].std()
    median_val = df_summary['filtered_variants'].median()
    min_val = df_summary['filtered_variants'].min()
    max_val = df_summary['filtered_variants'].max()

    print("\n--- Summary Statistics ---")
    print(f"Number of samples: {n_samples}")
    print(f"Total filtered CHIP variants across cohort: {total_filtered}")
    print(f"Average filtered CHIP variants per sample: {mean_val:.6f} (~{mean_val:.2f})")
    print(f"Standard deviation: {std_val:.4f}")
    print(f"Median: {median_val:.1f}")
    print(f"Range: [{min_val}, {max_val}]")

    print("\n--- Category Totals across Cohort (Post-filtering) ---")
    for cat in ['synonymous', 'missense', 'splice_region', 'frameshift', 'inframe_insertion', 'inframe_deletion']:
        cat_total = df_summary[cat].sum()
        print(f"  {cat}: {cat_total} (mean per sample: {cat_total / n_samples:.4f})")

    return mean_val

if __name__ == '__main__':
    run_analysis()
