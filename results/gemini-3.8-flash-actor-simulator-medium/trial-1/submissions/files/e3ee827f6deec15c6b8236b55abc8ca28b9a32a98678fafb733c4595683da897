import pandas as pd
import numpy as np

# Load dataset
df = pd.read_csv('data/nls_incarceration_processed.csv')

# Filter for black females
bf = df[(df['race'] == 'black') & (df['sex'] == 'female')]

# Calculate medians
median_1985 = bf['composite_wealth_1985'].median()
median_1990 = bf['composite_wealth_1990'].median()
median_1996 = bf['composite_wealth_1996'].median()

# Calculate increases
diff_85_90 = median_1990 - median_1985
diff_90_96 = median_1996 - median_1990

annual_85_90 = diff_85_90 / 5.0
annual_90_96 = diff_90_96 / 6.0

pct_85_90 = (diff_85_90 / median_1985) * 100
pct_90_96 = (diff_90_96 / median_1990) * 100

print(f"Sample size (Black Females): {len(bf)}")
print(f"1985 Median Wealth: ${median_1985:,.2f}")
print(f"1990 Median Wealth: ${median_1990:,.2f}")
print(f"1996 Median Wealth: ${median_1996:,.2f}")
print(f"1985-1990 Increase: ${diff_85_90:,.2f} ({pct_85_90:.1f}%, ${annual_85_90:,.2f}/yr)")
print(f"1990-1996 Increase: ${diff_90_96:,.2f} ({pct_90_96:.1f}%, ${annual_90_96:,.2f}/yr)")

if diff_85_90 > diff_90_96:
    print("Largest increase in median wealth occurred between 1985 and 1990.")
else:
    print("Largest increase in median wealth occurred between 1990 and 1996.")
