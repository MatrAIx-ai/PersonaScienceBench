import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf

def main():
    # Load dataset
    df = pd.read_csv('data/nls_ses_processed.csv')
    df['ba'] = df['BA DEGREE COMPLETED'].astype(int)
    
    # 1. Baseline Model with demographic controls (Race + Sex + Family Size)
    # Reference: White
    m_base = smf.logit(
        'ba ~ C(SAMPLE_RACE, Treatment(reference="White")) + SAMPLE_SEX + Q("FAMILY SIZE OF SAMPLE")',
        data=df
    ).fit(disp=False)
    
    # 2. Intermediate Model with academic resources before full SES adjustment
    m_inter = smf.logit(
        'ba ~ C(SAMPLE_RACE, Treatment(reference="White")) + SAMPLE_SEX + Q("FAMILY SIZE OF SAMPLE") + Q("ABILITY: COMPOSITE OF ASVAB SCORE") + Q("PERCENTILE IN CLASS")',
        data=df
    ).fit(disp=False)
    
    # 3. Full Model: Race + SES + Academic Characteristics (ASVAB + Percentile)
    m_full = smf.logit(
        'ba ~ C(SAMPLE_RACE, Treatment(reference="White")) + SES + Q("ABILITY: COMPOSITE OF ASVAB SCORE") + Q("PERCENTILE IN CLASS")',
        data=df
    ).fit(disp=False)
    
    # 4. Full Model with all demographic and background controls
    m_full_all = smf.logit(
        'ba ~ C(SAMPLE_RACE, Treatment(reference="White")) + SAMPLE_SEX + Q("FAMILY SIZE OF SAMPLE") + SES + Q("ABILITY: COMPOSITE OF ASVAB SCORE") + Q("PERCENTILE IN CLASS")',
        data=df
    ).fit(disp=False)

    print("=== BASELINE MODEL ===")
    print(m_base.summary())
    
    print("\n=== INTERMEDIATE MODEL (Academic without SES) ===")
    print(m_inter.summary())
    
    print("\n=== FULL MODEL (Race + SES + Academic) ===")
    print(m_full.summary())
    
    print("\n=== FULL MODEL ALL CONTROLS ===")
    print(m_full_all.summary())

if __name__ == '__main__':
    main()
