import os
import json
import numpy as np
import pandas as pd
from scipy import stats

def main():
    data_path = "data/OmicsExpressionProteinCodingGenesTPMLogp1BatchCorrected.csv"
    print(f"Loading gene expression data from {data_path}...")
    df = pd.read_csv(data_path, index_col=0)
    print(f"Data shape: {df.shape[0]} cell lines x {df.shape[1]} genes")
    
    # 1. Global distribution metrics
    vals = df.values.flatten()
    n_points = len(vals)
    global_mean = float(np.mean(vals))
    global_median = float(np.median(vals))
    global_std = float(np.std(vals))
    global_min = float(np.min(vals))
    global_max = float(np.max(vals))
    global_skew = float(stats.skew(vals))
    
    print("\n--- Global Distribution Metrics ---")
    print(f"Total values: {n_points}")
    print(f"Mean: {global_mean:.4f}")
    print(f"Median: {global_median:.4f}")
    print(f"Std: {global_std:.4f}")
    print(f"Range: [{global_min:.4f}, {global_max:.4f}]")
    print(f"Global Skewness (Fisher-Pearson): {global_skew:.4f}")
    
    # 2. Per-cell-line skewness (across genes within each cell line)
    cell_line_skews = df.apply(stats.skew, axis=1)
    cl_mean = float(cell_line_skews.mean())
    cl_median = float(cell_line_skews.median())
    cl_min = float(cell_line_skews.min())
    cl_max = float(cell_line_skews.max())
    cl_pct_positive = float((cell_line_skews > 0).mean() * 100)
    
    print("\n--- Per-Cell-Line Skewness ---")
    print(f"Mean cell line skewness: {cl_mean:.4f}")
    print(f"Median cell line skewness: {cl_median:.4f}")
    print(f"Range: [{cl_min:.4f}, {cl_max:.4f}]")
    print(f"Percentage of cell lines with positive skewness: {cl_pct_positive:.1f}%")

    # 3. Per-gene skewness (across cell lines for each gene)
    gene_skews = df.apply(stats.skew, axis=0)
    gene_mean = float(gene_skews.mean())
    gene_median = float(gene_skews.median())
    gene_min = float(gene_skews.min())
    gene_max = float(gene_skews.max())
    gene_pct_positive = float((gene_skews > 0).mean() * 100)
    
    print("\n--- Per-Gene Skewness ---")
    print(f"Mean gene skewness: {gene_mean:.4f}")
    print(f"Median gene skewness: {gene_median:.4f}")
    print(f"Range: [{gene_min:.4f}, {gene_max:.4f}]")
    print(f"Percentage of genes with positive skewness: {gene_pct_positive:.1f}%")

    results = {
        "global_skewness": global_skew,
        "global_mean": global_mean,
        "global_median": global_median,
        "characteristic": "positively skewed (right-skewed)",
        "per_cell_line": {
            "mean_skewness": cl_mean,
            "median_skewness": cl_median,
            "min_skewness": cl_min,
            "max_skewness": cl_max,
            "pct_positive": cl_pct_positive
        },
        "per_gene": {
            "mean_skewness": gene_mean,
            "median_skewness": gene_median,
            "min_skewness": gene_min,
            "max_skewness": gene_max,
            "pct_positive": gene_pct_positive
        }
    }

    with open("skewness_results.json", "w") as f:
        json.dump(results, f, indent=2)
    print("\nResults successfully saved to skewness_results.json")

if __name__ == "__main__":
    main()
