import pandas as pd
import numpy as np
from statsmodels.miscmodels.ordinal_model import OrderedModel

def main():
    print("=" * 80)
    print("BCG-CORONA CLINICAL TRIAL: ORDINAL REGRESSION ANALYSIS OF COVID-19 SEVERITY")
    print("=" * 80)

    # 1. Load data
    dm = pd.read_csv('data/TASK008_BCG-CORONA_DM.csv')
    ae = pd.read_csv('data/TASK008_BCG-CORONA_AE.csv')
    mh = pd.read_csv('data/TASK008_BCG-CORONA_MH.csv')

    print(f"Loaded DM: {dm.shape}, AE: {ae.shape}, MH: {mh.shape}")

    # 2. Extract COVID-19 severity from AE
    # Confirmed COVID-19 terms
    covid_ae = ae[ae['AEPT'].str.contains('COVID|SARS', case=False, na=False)].copy()
    print(f"Total COVID-related AE records: {len(covid_ae)}")
    print(f"Unique subjects with COVID-19: {covid_ae['USUBJID'].nunique()}")
    
    # Max AEHS (WHO ordinal scale 0-7) per subject
    covid_sev_aehs = covid_ae.groupby('USUBJID')['AEHS'].max().rename('covid_severity')
    print("\nCOVID-19 Severity (max AEHS) distribution in infected subjects:")
    print(covid_sev_aehs.value_counts().sort_index())

    # 3. Extract Medical History Count (mh_count)
    # Pre-existing conditions with positive status (MHORRES == 2.0)
    mh_pos = mh[(mh['MHSCAT'] == 'MEDICAL HISTORY') & (mh['MHORRES'] == 2.0)].groupby('USUBJID').size().rename('mh_count')
    
    # 4. Prepare analytical dataset: COVID-19 confirmed cohort (N=197)
    df_covid = dm.merge(covid_sev_aehs, on='USUBJID', how='inner')
    df_covid = df_covid.merge(mh_pos, on='USUBJID', how='left')
    df_covid['mh_count'] = df_covid['mh_count'].fillna(0).astype(int)

    # Coding variables
    # BCG: 1 = BCG, 0 = Placebo
    df_covid['bcg'] = (df_covid['TRTGRP'] == 'BCG').astype(float)
    
    # Patients seen: ordinal encoding ('1-50': 1, '51-100': 2, '>100': 3)
    df_covid['ps_ord'] = df_covid['patients_seen'].map({'1-50': 1, '51-100': 2, '>100': 3}).astype(float)
    
    # Interaction between control terms: mh_count * ps_ord
    df_covid['inter_mh_ps'] = df_covid['mh_count'] * df_covid['ps_ord']

    print(f"\nAnalytical COVID Cohort size: N = {len(df_covid)}")
    print("TRTGRP breakdown:")
    print(df_covid['TRTGRP'].value_counts())
    print("patients_seen breakdown:")
    print(df_covid['patients_seen'].value_counts())
    print("mh_count summary:")
    print(df_covid['mh_count'].describe())

    # 5. Fit Primary Model:
    # COVID severity ~ bcg + mh_count + ps_ord + (mh_count * ps_ord)
    print("\n" + "=" * 80)
    print("PRIMARY MODEL: COVID Severity ~ BCG + mh_count + patients_seen + (mh_count * patients_seen)")
    print("=" * 80)
    X_prim = df_covid[['bcg', 'mh_count', 'ps_ord', 'inter_mh_ps']]
    y_prim = df_covid['covid_severity']

    model_prim = OrderedModel(y_prim, X_prim, distr='logit')
    res_prim = model_prim.fit(method='bfgs', maxiter=1000, disp=False)
    print(res_prim.summary())

    beta_bcg = res_prim.params['bcg']
    se_bcg = res_prim.bse['bcg']
    z_bcg = res_prim.tvalues['bcg']
    p_bcg = res_prim.pvalues['bcg']
    ci_bcg = res_prim.conf_int().loc['bcg']

    or_bcg = np.exp(beta_bcg)
    or_ci_low = np.exp(ci_bcg[0])
    or_ci_high = np.exp(ci_bcg[1])

    print("\n" + "-" * 50)
    print("PRIMARY MODEL RESULTS FOR BCG VACCINATION:")
    print(f"Log-Odds Coefficient (beta): {beta_bcg:.4f}")
    print(f"Standard Error:             {se_bcg:.4f}")
    print(f"Z-statistic:                {z_bcg:.4f}")
    print(f"p-value:                    {p_bcg:.4f}")
    print(f"Odds Ratio (OR):            {or_bcg:.4f} (approx {or_bcg:.2f})")
    print(f"95% Confidence Interval:    [{or_ci_low:.4f}, {or_ci_high:.4f}]")
    print("-" * 50)

    # 6. Fit Secondary / Sensitivity Models:
    print("\n" + "=" * 80)
    print("SENSITIVITY ANALYSES")
    print("=" * 80)

    # Model S1: No interaction term
    X_s1 = df_covid[['bcg', 'mh_count', 'ps_ord']]
    res_s1 = OrderedModel(y_prim, X_s1, distr='logit').fit(method='bfgs', maxiter=1000, disp=False)
    print(f"Model S1 (Main effects only):")
    print(f"  BCG beta = {res_s1.params['bcg']:.4f}, SE = {res_s1.bse['bcg']:.4f}, p = {res_s1.pvalues['bcg']:.4f}")
    print(f"  OR = {np.exp(res_s1.params['bcg']):.4f}, 95% CI = [{np.exp(res_s1.conf_int().loc['bcg'][0]):.4f}, {np.exp(res_s1.conf_int().loc['bcg'][1]):.4f}]")
    print(f"  AIC = {res_s1.aic:.2f}")

    # Model S2: Dummy variables for patients_seen with interaction
    df_covid['ps_51_100'] = (df_covid['patients_seen'] == '51-100').astype(float)
    df_covid['ps_gt100'] = (df_covid['patients_seen'] == '>100').astype(float)
    df_covid['mh_x_ps_51_100'] = df_covid['mh_count'] * df_covid['ps_51_100']
    df_covid['mh_x_ps_gt100'] = df_covid['mh_count'] * df_covid['ps_gt100']
    X_s2 = df_covid[['bcg', 'mh_count', 'ps_51_100', 'ps_gt100', 'mh_x_ps_51_100', 'mh_x_ps_gt100']]
    res_s2 = OrderedModel(y_prim, X_s2, distr='logit').fit(method='bfgs', maxiter=1000, disp=False)
    print(f"\nModel S2 (Categorical patients_seen + interaction):")
    print(f"  BCG beta = {res_s2.params['bcg']:.4f}, SE = {res_s2.bse['bcg']:.4f}, p = {res_s2.pvalues['bcg']:.4f}")
    print(f"  OR = {np.exp(res_s2.params['bcg']):.4f}, 95% CI = [{np.exp(res_s2.conf_int().loc['bcg'][0]):.4f}, {np.exp(res_s2.conf_int().loc['bcg'][1]):.4f}]")
    print(f"  AIC = {res_s2.aic:.2f}")

    # Model S3: Interaction bcg * ps_ord
    df_covid['inter_bcg_ps'] = df_covid['bcg'] * df_covid['ps_ord']
    X_s3 = df_covid[['bcg', 'mh_count', 'ps_ord', 'inter_bcg_ps']]
    res_s3 = OrderedModel(y_prim, X_s3, distr='logit').fit(method='bfgs', maxiter=1000, disp=False)
    print(f"\nModel S3 (Interaction BCG * patients_seen):")
    print(f"  BCG beta = {res_s3.params['bcg']:.4f}, SE = {res_s3.bse['bcg']:.4f}, p = {res_s3.pvalues['bcg']:.4f}")
    print(f"  Interaction beta = {res_s3.params['inter_bcg_ps']:.4f}, p = {res_s3.pvalues['inter_bcg_ps']:.4f}")
    print(f"  AIC = {res_s3.aic:.2f}")

    # Model S4: Full Cohort (N=1000) with non-infected coded as severity 0
    df_full = dm.merge(covid_sev_aehs, on='USUBJID', how='left').fillna({'covid_severity': 0})
    df_full = df_full.merge(mh_pos, on='USUBJID', how='left').fillna({'mh_count': 0})
    df_full['bcg'] = (df_full['TRTGRP'] == 'BCG').astype(float)
    df_full['ps_ord'] = df_full['patients_seen'].map({'1-50': 1, '51-100': 2, '>100': 3}).astype(float)
    df_full['inter_mh_ps'] = df_full['mh_count'] * df_full['ps_ord']
    X_s4 = df_full[['bcg', 'mh_count', 'ps_ord', 'inter_mh_ps']]
    y_s4 = df_full['covid_severity']
    res_s4 = OrderedModel(y_s4, X_s4, distr='logit').fit(method='bfgs', maxiter=1000, disp=False)
    print(f"\nModel S4 (Full Cohort N=1000, non-infected=0):")
    print(f"  BCG beta = {res_s4.params['bcg']:.4f}, SE = {res_s4.bse['bcg']:.4f}, p = {res_s4.pvalues['bcg']:.4f}")
    print(f"  OR = {np.exp(res_s4.params['bcg']):.4f}, 95% CI = [{np.exp(res_s4.conf_int().loc['bcg'][0]):.4f}, {np.exp(res_s4.conf_int().loc['bcg'][1]):.4f}]")
    print(f"  AIC = {res_s4.aic:.2f}")

if __name__ == '__main__':
    main()
