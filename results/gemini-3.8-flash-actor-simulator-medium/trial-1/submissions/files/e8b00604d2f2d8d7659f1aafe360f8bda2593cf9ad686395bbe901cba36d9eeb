import pandas as pd
import numpy as np
import statsmodels.api as sm

# Load and reshape
df = pd.read_csv('data/worldbank_education_gdp.csv')
year_cols = [c for c in df.columns if '[' in c]
years = [int(c.split(' ')[0]) for c in year_cols]

records = []
for code in ['LMC', 'SSF']:
    sub = df[df['Country Code'] == code]
    d = {'country': code, 'year': years}
    for _, row in sub.iterrows():
        var_name = row['Series Code']
        vals = pd.to_numeric(row[year_cols], errors='coerce').values
        d[var_name] = vals
    records.append(pd.DataFrame(d))

panel = pd.concat(records, ignore_index=True)
panel = panel.rename(columns={
    'NY.GNP.PCAP.KD': 'gni_pc',
    'NY.ADJ.AEDU.GN.ZS': 'edu_exp',
    'NE.EXP.GNFS.KD.ZG': 'exports_growth',
    'SE.PRM.ENRR': 'prm_enroll',
    'SE.SEC.ENRR': 'sec_enroll',
    'SL.TLF.CACT.ZS': 'labor_force'
})

panel['log_gni'] = np.log(panel['gni_pc'])
panel['log_edu'] = np.log(panel['edu_exp'])

# 2011-2015 Window (Overlapping period)
p11 = panel[panel['year'] >= 2011].copy().sort_values(['country', 'year']).reset_index(drop=True)
p11['is_ssf'] = (p11['country'] == 'SSF').astype(int)
p11['edu_x_ssf'] = p11['edu_exp'] * p11['is_ssf']
p11['log_edu_x_ssf'] = p11['log_edu'] * p11['is_ssf']

# 1. Baseline Level Models (2011-2015)
# Semi-log
m1_semi = sm.OLS(p11['log_gni'], sm.add_constant(p11[['edu_exp', 'is_ssf', 'edu_x_ssf']])).fit()
# Log-log
m1_log = sm.OLS(p11['log_gni'], sm.add_constant(p11[['log_edu', 'is_ssf', 'log_edu_x_ssf']])).fit()

# 2. Level Model with Exports Growth control
m2 = sm.OLS(p11['log_gni'], sm.add_constant(p11[['edu_exp', 'is_ssf', 'edu_x_ssf', 'exports_growth']])).fit()

# 3. Dynamic AR(1) Model (Autoregression)
p11['lag_log_gni'] = p11.groupby('country')['log_gni'].shift(1)
p11['lag_edu'] = p11.groupby('country')['edu_exp'].shift(1)
p11['lag_log_edu'] = p11.groupby('country')['log_edu'].shift(1)
p11['lag_edu_x_ssf'] = p11['lag_edu'] * p11['is_ssf']

dyn_sample = p11.dropna(subset=['lag_log_gni']).copy()
m3_dyn = sm.OLS(dyn_sample['log_gni'], sm.add_constant(dyn_sample[['lag_log_gni', 'edu_exp', 'is_ssf', 'edu_x_ssf']])).fit()

# 4. First-Difference / Growth Model
p11['d_log_gni'] = p11.groupby('country')['log_gni'].diff()
p11['d_edu'] = p11.groupby('country')['edu_exp'].diff()
p11['d_edu_x_ssf'] = p11['d_edu'] * p11['is_ssf']

diff_sample = p11.dropna(subset=['d_log_gni']).copy()
m4_diff = sm.OLS(diff_sample['d_log_gni'], sm.add_constant(diff_sample[['d_edu', 'is_ssf', 'd_edu_x_ssf']])).fit()

# 5. Instrumental Variables (2SLS) addressing endogeneity using lagged education expenditure
# First stage: edu_exp on lag_edu, is_ssf, lag_edu_x_ssf
iv_sample = p11.dropna(subset=['lag_edu']).copy()
fs = sm.OLS(iv_sample['edu_exp'], sm.add_constant(iv_sample[['lag_edu', 'is_ssf', 'lag_edu_x_ssf']])).fit()
iv_sample['pred_edu'] = fs.fittedvalues
iv_sample['pred_edu_x_ssf'] = iv_sample['pred_edu'] * iv_sample['is_ssf']
# Second stage: log_gni on pred_edu, is_ssf, pred_edu_x_ssf
m5_iv = sm.OLS(iv_sample['log_gni'], sm.add_constant(iv_sample[['pred_edu', 'is_ssf', 'pred_edu_x_ssf']])).fit()

print("==================== MODEL 1: SEMI-LOG (2011-2015) ====================")
print(m1_semi.summary().tables[1])
print(f"R2: {m1_semi.rsquared:.4f}, N: {m1_semi.nobs}")
print(f"Developing (LMC) effect: {m1_semi.params['edu_exp']:.4f} (p={m1_semi.pvalues['edu_exp']:.4f})")
print(f"Sub-Saharan Africa (SSF) effect: {m1_semi.params['edu_exp'] + m1_semi.params['edu_x_ssf']:.4f}")

print("\n==================== MODEL 1b: LOG-LOG (2011-2015) ====================")
print(m1_log.summary().tables[1])
print(f"R2: {m1_log.rsquared:.4f}, N: {m1_log.nobs}")
print(f"Developing (LMC) elasticity: {m1_log.params['log_edu']:.4f} (p={m1_log.pvalues['log_edu']:.4f})")
print(f"Sub-Saharan Africa (SSF) elasticity: {m1_log.params['log_edu'] + m1_log.params['log_edu_x_ssf']:.4f}")

print("\n==================== MODEL 2: WITH EXPORTS CONTROL ====================")
print(m2.summary().tables[1])

print("\n==================== MODEL 3: DYNAMIC AR(1) ====================")
print(m3_dyn.summary().tables[1])

print("\n==================== MODEL 4: FIRST-DIFFERENCE ====================")
print(m4_diff.summary().tables[1])

print("\n==================== MODEL 5: 2SLS (IV FOR ENDOGENEITY) ====================")
print(m5_iv.summary().tables[1])
print(f"Developing (LMC) IV effect: {m5_iv.params['pred_edu']:.4f}")
print(f"SSF IV effect: {m5_iv.params['pred_edu'] + m5_iv.params['pred_edu_x_ssf']:.4f}")

