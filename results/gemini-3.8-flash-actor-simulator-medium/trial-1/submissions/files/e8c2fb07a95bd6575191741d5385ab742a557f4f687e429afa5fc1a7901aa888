import pandas as pd
import numpy as np
import statsmodels.api as sm

def main():
    # 1. Load data
    data_path = "data/data.xlsx"
    df = pd.read_excel(data_path)
    
    # 2. Filter valid patient observations (rows 1-80)
    df_clean = df.iloc[:80].copy()
    df_clean["Age"] = df_clean["Age"].astype(float)
    
    # Binary outcome: 1 if Efficacy == 'PR', 0 otherwise
    df_clean["PR"] = (df_clean["Efficacy"] == "PR").astype(int)
    
    # 3. Fit logistic regression model
    X = sm.add_constant(df_clean["Age"])
    y = df_clean["PR"]
    model = sm.Logit(y, X).fit()
    
    print("=== Logistic Regression Model Summary ===")
    print(model.summary())
    
    # 4. Predict probability for Age = 65
    b0 = model.params["const"]
    b1 = model.params["Age"]
    age_target = 65.0
    logit_val = b0 + b1 * age_target
    prob_65 = 1 / (1 + np.exp(-logit_val))
    
    # Prediction using statsmodels
    pred = model.predict([1, age_target])[0]
    
    # 95% Confidence interval
    cov = model.cov_params()
    var_logit = cov.loc["const", "const"] + (age_target**2)*cov.loc["Age", "Age"] + 2*age_target*cov.loc["const", "Age"]
    se_logit = np.sqrt(var_logit)
    ci_lower = 1 / (1 + np.exp(-(logit_val - 1.96 * se_logit)))
    ci_upper = 1 / (1 + np.exp(-(logit_val + 1.96 * se_logit)))
    
    print("\n=== Prediction for Age = 65 ===")
    print(f"Logit value: {logit_val:.4f}")
    print(f"Predicted Probability: {prob_65:.4f} ({prob_65 * 100:.2f}%)")
    print(f"95% CI: [{ci_lower:.4f}, {ci_upper:.4f}] ({ci_lower * 100:.2f}% - {ci_upper * 100:.2f}%)")

if __name__ == "__main__":
    main()
