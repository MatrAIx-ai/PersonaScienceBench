#!/usr/bin/env python3
"""
Statistical test of independence between m6A methylation status and differential expression status
in the bladder cancer dataset (data/MeRIP_RNA_result.xlsx).
"""

import pandas as pd
from scipy import stats

def main():
    # Load dataset
    filepath = 'data/MeRIP_RNA_result.xlsx'
    df = pd.read_excel(filepath)
    print(f"Loaded dataset: {filepath} with shape {df.shape}")

    # Inspect variables
    print("\nValue counts for m6A methylation status:")
    print(df['m6A'].value_counts())

    print("\nValue counts for differential expression status (DEG):")
    print(df['DEG'].value_counts())

    # 1. Primary Test: 3x3 Contingency Table
    ct_3x3 = pd.crosstab(df['m6A'], df['DEG'])
    print("\n--- 3x3 Contingency Table (m6A vs DEG) ---")
    print(ct_3x3)

    chi2_3x3, p_3x3, dof_3x3, expected_3x3 = stats.chi2_contingency(ct_3x3)
    print("\n--- Pearson's Chi-square Test of Independence (3x3 Table) ---")
    print(f"Chi-square statistic: {chi2_3x3:.4f}")
    print(f"Degrees of freedom:   {dof_3x3}")
    print(f"p-value (scientific): {p_3x3:.2e}")
    print(f"p-value (extended):   {p_3x3:.6e}")
    print(f"Full float p-value:   {p_3x3}")

    # 2. Binary 2x2 Contingency Table (Significant vs Non-significant)
    m6A_sig = df['m6A'].isin(['m6A Hyper', 'm6A Hypo'])
    deg_sig = df['DEG'].isin(['Up', 'Down'])
    ct_2x2 = pd.crosstab(m6A_sig, deg_sig)
    ct_2x2.index = ['m6A Not Sig', 'm6A Sig']
    ct_2x2.columns = ['DEG Not Sig', 'DEG Sig']

    print("\n--- 2x2 Contingency Table (Binary: Sig vs Non-Sig) ---")
    print(ct_2x2)

    chi2_2x2_yates, p_2x2_yates, dof_2x2, _ = stats.chi2_contingency(ct_2x2, correction=True)
    chi2_2x2_raw, p_2x2_raw, _, _ = stats.chi2_contingency(ct_2x2, correction=False)
    odds_ratio, p_fisher = stats.fisher_exact(ct_2x2)

    print("\n--- Tests on 2x2 Table ---")
    print(f"Chi-square (Yates correction) p-value: {p_2x2_yates:.2e} (statistic: {chi2_2x2_yates:.4f})")
    print(f"Chi-square (no correction) p-value:    {p_2x2_raw:.2e} (statistic: {chi2_2x2_raw:.4f})")
    print(f"Fisher's exact test p-value:           {p_fisher:.2e} (odds ratio: {odds_ratio:.4f})")

    print("\nPrimary Result for Submission:")
    print(f"p-value = {p_3x3:.2e} (or {p_3x3:.4e})")

if __name__ == '__main__':
    main()
