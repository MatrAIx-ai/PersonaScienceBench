import json, os, sys
if '/usr/lib/python3/dist-packages' not in sys.path:
    sys.path.append('/usr/lib/python3/dist-packages')
import numpy as np, pandas as pd, scipy.constants as const
from scipy.linalg import block_diag
from PIL import Image, ImageDraw

def kabsch_align(P, Q):
    p_c, q_c = P.mean(axis=0), Q.mean(axis=0)
    P_c, Q_c = P - p_c, Q - q_c
    H = P_c.T @ Q_c
    U, S, Vt = np.linalg.svd(H)
    d = np.linalg.det(Vt.T @ U.T)
    R = Vt.T @ np.diag([1.0, 1.0, np.sign(d)]) @ U.T
    P_aligned = P_c @ R.T + q_c
    rmsd = float(np.sqrt(np.mean(np.sum((P_aligned - Q) ** 2, axis=1))))
    return P_aligned, R, rmsd
def main():
    data_dir, results_dir = 'data', 'results'
    os.makedirs(results_dir, exist_ok=True)

    with open(os.path.join(data_dir, 'system_manifest.json')) as f:
        manifest = json.load(f)
    with open(os.path.join(data_dir, 'medium_response.json')) as f:
        medium = json.load(f)

    sites = pd.read_csv(os.path.join(data_dir, 'site_table.csv')).sort_values('site_id').reset_index(drop=True)
    order = pd.read_csv(os.path.join(data_dir, 'frame_site_order.csv'))
    grid = pd.read_csv(os.path.join(data_dir, 'driving_force_grid.csv'))

    n_sites = len(sites)
    masses = sites['mass_amu'].values.astype(np.float64)
    m_vec = np.repeat(masses, 3)
    sqrt_m = np.sqrt(m_vec)

    freq_factor = float(manifest.get('freq_scale_factor', 521.4708983725066))
    n_null = int(manifest.get('null_rank', 6))
    n_res = int(manifest.get('resolved_rank', 15))

    ord_a = order[order['frame_id'] == 'frame_a'].sort_values('site_id').reset_index(drop=True)
    ord_b = order[order['frame_id'] == 'frame_b'].sort_values('site_id').reset_index(drop=True)

    coords_a = np.load(os.path.join(data_dir, 'frame_a_coords.npy'))[ord_a['row_index'].values]
    coords_b = np.load(os.path.join(data_dir, 'frame_b_coords.npy'))[ord_b['row_index'].values]

    raw_ha = np.load(os.path.join(data_dir, 'frame_a_hessian.npy'))
    raw_hb = np.load(os.path.join(data_dir, 'frame_b_hessian.npy'))

    p_a, p_b = [], []
    for sid in range(n_sites):
        ra = ord_a.loc[ord_a['site_id'] == sid, 'row_index'].values[0]
        p_a.extend([ra * 3, ra * 3 + 1, ra * 3 + 2])
        rb = ord_b.loc[ord_b['site_id'] == sid, 'row_index'].values[0]
        p_b.extend([rb * 3, rb * 3 + 1, rb * 3 + 2])

    ha = raw_ha[np.ix_(p_a, p_a)]
    hb = raw_hb[np.ix_(p_b, p_b)]

    inv_sqrt = 1.0 / np.outer(sqrt_m, sqrt_m)
    ha_mw, hb_mw = ha * inv_sqrt, hb * inv_sqrt

    va, wa = np.linalg.eigh(ha_mw)
    vb, wb = np.linalg.eigh(hb_mw)

    ia, ib = np.argsort(va)[n_null:], np.argsort(vb)[n_null:]
    w_a_sq, w_b_sq = va[ia], vb[ib]
    L_a, L_b = wa[:, ia], wb[:, ib]

    vibrational_basis_mw = np.zeros((2, 21, n_res), dtype=np.float64)
    vibrational_basis_mw[0], vibrational_basis_mw[1] = L_a, L_b
    np.save(os.path.join(results_dir, 'vibrational_basis_mw.npy'), vibrational_basis_mw)
    b_in_a, R_fwd, rmsd_fwd = kabsch_align(coords_b, coords_a)
    a_in_b, R_bwd, rmsd_bwd = kabsch_align(coords_a, coords_b)

    dr_fwd = (b_in_a - coords_a).flatten()
    dq_fwd = dr_fwd * sqrt_m
    dr_bwd = (a_in_b - coords_b).flatten()
    dq_bwd = dr_bwd * sqrt_m

    aligned_disp = np.zeros((2, 21), dtype=np.float64)
    aligned_disp[0], aligned_disp[1] = dq_fwd, dq_bwd
    np.save(os.path.join(results_dir, 'aligned_displacement_mw.npy'), aligned_disp)

    Q_fwd = L_a.T @ dq_fwd
    dq_proj_fwd = L_a @ Q_fwd
    Q_bwd = L_b.T @ dq_bwd
    dq_proj_bwd = L_b @ Q_bwd

    proj_disp = np.zeros((2, 21), dtype=np.float64)
    proj_disp[0], proj_disp[1] = dq_proj_fwd, dq_proj_bwd
    np.save(os.path.join(results_dir, 'projected_displacement_mw.npy'), proj_disp)

    rigid_norm_fwd = float(np.linalg.norm(dq_fwd))
    rigid_norm_bwd = float(np.linalg.norm(dq_bwd))
    proj_norm_fwd = float(np.linalg.norm(dq_proj_fwd))
    proj_norm_bwd = float(np.linalg.norm(dq_proj_bwd))

    R_fwd_21 = block_diag(*([R_fwd] * n_sites))
    R_bwd_21 = block_diag(*([R_bwd] * n_sites))

    S_fwd = np.abs(L_a.T @ R_fwd_21 @ L_b)
    S_bwd = np.abs(L_b.T @ R_bwd_21 @ L_a)

    mode_overlap = np.zeros((2, n_res, n_res), dtype=np.float64)
    mode_overlap[0], mode_overlap[1] = S_fwd, S_bwd
    np.save(os.path.join(results_dir, 'mode_overlap.npy'), mode_overlap)

    trans_fwd = np.column_stack([np.abs(Q_fwd), np.abs((R_fwd_21 @ L_b).T @ dq_fwd)])
    trans_bwd = np.column_stack([np.abs(Q_bwd), np.abs((R_bwd_21 @ L_a).T @ dq_bwd)])
    trans_mode = np.zeros((2, n_res, 2), dtype=np.float64)
    trans_mode[0], trans_mode[1] = trans_fwd, trans_bwd
    np.save(os.path.join(results_dir, 'transported_mode_projection.npy'), trans_mode)
    freq_a = freq_factor * np.sqrt(np.maximum(w_a_sq, 0.0))
    freq_b = freq_factor * np.sqrt(np.maximum(w_b_sq, 0.0))
    lam_m_fwd = 0.5 * w_a_sq * (Q_fwd ** 2)
    lam_m_bwd = 0.5 * w_b_sq * (Q_bwd ** 2)

    mode_proj = np.zeros((2, n_res, 3), dtype=np.float64)
    mode_proj[0] = np.column_stack([freq_a, Q_fwd, lam_m_fwd])
    mode_proj[1] = np.column_stack([freq_b, Q_bwd, lam_m_bwd])
    np.save(os.path.join(results_dir, 'mode_projection.npy'), mode_proj)

    dom_fwd, dom_bwd = int(np.argmax(lam_m_fwd)), int(np.argmax(lam_m_bwd))

    lam_4pt_fwd = float(0.5 * dr_fwd @ ha @ dr_fwd)
    lam_4pt_bwd = float(0.5 * dr_bwd @ hb @ dr_bwd)
    lam_nm_fwd = float(np.sum(lam_m_fwd))
    lam_nm_bwd = float(np.sum(lam_m_bwd))

    closure_fwd = float(np.abs(lam_4pt_fwd - lam_nm_fwd))
    closure_bwd = float(np.abs(lam_4pt_bwd - lam_nm_bwd))

    lam_in_eff = float(0.5 * (lam_nm_fwd + lam_nm_bwd))
    lam_in_eff_4pt = float(0.5 * (lam_4pt_fwd + lam_4pt_bwd))
    eff_in_cons = float(np.abs(lam_in_eff_4pt - lam_in_eff))

    a0, a1 = float(medium['shell_0_A']), float(medium['shell_1_A'])
    R_span = float(medium['span_A'])
    eps_f, eps_s = float(medium['eps_fast']), float(medium['eps_slow'])
    V_DA, T_K = float(medium['coupling_eV']), float(medium['temp_K'])

    coulomb = (const.e / (4.0 * const.pi * const.epsilon_0)) * 1e10
    lam_out = float(coulomb * (0.5/a0 + 0.5/a1 - 1.0/R_span) * (1.0/eps_f - 1.0/eps_s))
    lam_tot = float(lam_in_eff + lam_out)

    kB_eV = float(const.k / const.e)
    hbar_eV = float(const.hbar / const.e)
    prefactor = (2.0 * np.pi / hbar_eV) * (V_DA ** 2) / np.sqrt(4.0 * np.pi * lam_tot * kB_eV * T_K)
    k_self = float(prefactor * np.exp(-lam_tot / (4.0 * kB_eV * T_K)))

    pd.DataFrame([{
        'lambda_4pt_forward_eV': lam_4pt_fwd,
        'lambda_4pt_backward_eV': lam_4pt_bwd,
        'lambda_nm_forward_eV': lam_nm_fwd,
        'lambda_nm_backward_eV': lam_nm_bwd,
        'lambda_inner_effective_eV': lam_in_eff,
        'lambda_outer_eV': lam_out,
        'lambda_total_eV': lam_tot,
        'k_self_exchange_s_inv': k_self
    }]).to_csv(os.path.join(results_dir, 'lambda_summary.csv'), index=False)

    g_ids = grid['grid_id'].values
    dG = grid['axis_eV'].values.astype(np.float64)
    act = ((dG + lam_tot) ** 2) / (4.0 * lam_tot * kB_eV * T_K)
    k_vals = prefactor * np.exp(-act)
    log10_k = np.log10(k_vals)

    pd.DataFrame({
        'grid_id': g_ids,
        'axis_eV': dG,
        'k_et_s_inv': k_vals,
        'log10_k_et_s_inv': log10_k
    }).to_csv(os.path.join(results_dir, 'rate_curve.csv'), index=False)

    pk_idx = int(np.argmax(k_vals))
    pk_grid_id = int(g_ids[pk_idx])
    pk_axis = float(dG[pk_idx])
    pk_s_inv = float(k_vals[pk_idx])

    sort_order = np.argsort(-dG)
    s_axis, s_k, s_ids = dG[sort_order], k_vals[sort_order], g_ids[sort_order]
    s_pk = int(np.argmax(s_k))
    inv_detected = bool(s_pk < len(s_k) - 1)
    first_inv_id = int(s_ids[s_pk + 1]) if inv_detected else None
    first_inv_axis = float(s_axis[s_pk + 1]) if inv_detected else None

    diag = {
        'alignment_rmsd_forward_A': rmsd_fwd,
        'alignment_rmsd_backward_A': rmsd_bwd,
        'closure_error_forward_eV': closure_fwd,
        'closure_error_backward_eV': closure_bwd,
        'effective_inner_consistency_eV': eff_in_cons,
        'rigid_norm_forward': rigid_norm_fwd,
        'rigid_norm_backward': rigid_norm_bwd,
        'projected_norm_forward': proj_norm_fwd,
        'projected_norm_backward': proj_norm_bwd,
        'dominant_mode_forward': dom_fwd,
        'dominant_mode_backward': dom_bwd,
        'rate_peak_grid_id': pk_grid_id,
        'rate_peak_axis_eV': pk_axis,
        'rate_peak_s_inv': pk_s_inv,
        'inverted_region_detected': inv_detected,
        'first_inverted_grid_id': first_inv_id,
        'first_inverted_axis_eV': first_inv_axis
    }
    with open(os.path.join(results_dir, 'diagnostics.json'), 'w') as f:
        json.dump(diag, f, indent=2)

    create_overview(os.path.join(results_dir, 'overview.png'), dG, log10_k, lam_m_fwd, lam_m_bwd, pk_axis)
def create_overview(filepath, dG, log10_k, lam_fwd, lam_bwd, pk_axis):
    w, h = 1000, 700
    img = Image.new('RGB', (w, h), color=(255, 255, 255))
    draw = ImageDraw.Draw(img)
    draw.text((40, 20), 'Marcus Electron Transfer Reorganization & Rate Analysis', fill=(20, 20, 20))

    p1_l, p1_t, p1_r, p1_b = 80, 70, 920, 340
    draw.rectangle([p1_l, p1_t, p1_r, p1_b], outline=(180, 180, 180), width=1)

    s_idx = np.argsort(dG)
    x_d, y_d = dG[s_idx], log10_k[s_idx]
    x_min, x_max = -1.6, 0.4
    y_min, y_max = float(np.floor(np.min(y_d)) - 1), float(np.ceil(np.max(y_d)) + 1)

    def to_p1(x, y):
        px = p1_l + (x - x_min) / (x_max - x_min) * (p1_r - p1_l)
        py = p1_b - (y - y_min) / (y_max - y_min) * (p1_b - p1_t)
        return px, py

    for x_val in np.linspace(-1.5, 0.3, 7):
        px, _ = to_p1(x_val, y_min)
        draw.line([(px, p1_t), (px, p1_b)], fill=(240, 240, 240), width=1)
        draw.text((px - 15, p1_b + 5), f'{x_val:.1f}', fill=(100, 100, 100))

    for y_val in np.arange(y_min, y_max + 1, 5):
        _, py = to_p1(x_min, y_val)
        draw.line([(p1_l, py), (p1_r, py)], fill=(240, 240, 240), width=1)
        draw.text((p1_l - 35, py - 6), f'{int(y_val)}', fill=(100, 100, 100))

    pts = [to_p1(x, y) for x, y in zip(x_d, y_d)]
    for i in range(len(pts) - 1):
        draw.line([pts[i], pts[i + 1]], fill=(31, 119, 180), width=3)
    for pt in pts:
        draw.ellipse([pt[0] - 2, pt[1] - 2, pt[0] + 2, pt[1] + 2], fill=(31, 119, 180))

    pk_x, pk_y = to_p1(pk_axis, np.max(y_d))
    draw.ellipse([pk_x - 5, pk_y - 5, pk_x + 5, pk_y + 5], fill=(214, 39, 40), outline=(0, 0, 0))
    draw.text((pk_x + 10, pk_y - 10), f'Rate Peak: dG = {pk_axis:.3f} eV', fill=(214, 39, 40))

    draw.text((p1_l + 15, p1_t + 15), 'log10(k_ET [s^-1]) vs Driving Force dG [eV]', fill=(0, 0, 0))
    draw.text((p1_l + 15, p1_t + 35), '<- Inverted Region | Normal Region ->', fill=(120, 120, 120))

    p2_l, p2_t, p2_r, p2_b = 80, 410, 920, 640
    draw.rectangle([p2_l, p2_t, p2_r, p2_b], outline=(180, 180, 180), width=1)

    n_m = len(lam_fwd)
    max_l = max(np.max(lam_fwd), np.max(lam_bwd)) * 1.15

    def to_p2(idx, val, offset=0):
        bw = (p2_r - p2_l) / (n_m + 1)
        bx = p2_l + (idx + 0.6) * bw + offset
        by = p2_b - (val / max_l) * (p2_b - p2_t)
        return bx, by, bw * 0.35

    for m in range(n_m):
        bxf, byf, bw = to_p2(m, lam_fwd[m], offset=-12)
        draw.rectangle([bxf, byf, bxf + bw, p2_b], fill=(44, 160, 44), outline=(0, 0, 0))
        bxb, byb, bw = to_p2(m, lam_bwd[m], offset=2)
        draw.rectangle([bxb, byb, bxb + bw, p2_b], fill=(255, 127, 14), outline=(0, 0, 0))
        draw.text((bxf + 5, p2_b + 5), str(m), fill=(80, 80, 80))

    draw.text((p2_l + 15, p2_t + 15), 'Mode Reorganization Energy lambda_k [eV] by Resolved Mode Index (0 to 14)', fill=(0, 0, 0))
    draw.rectangle([p2_r - 220, p2_t + 15, p2_r - 205, p2_t + 27], fill=(44, 160, 44))
    draw.text((p2_r - 200, p2_t + 13), 'Forward (PES A)', fill=(0, 0, 0))
    draw.rectangle([p2_r - 220, p2_t + 35, p2_r - 205, p2_t + 47], fill=(255, 127, 14))
    draw.text((p2_r - 200, p2_t + 33), 'Backward (PES B)', fill=(0, 0, 0))

    img.save(filepath)

if __name__ == '__main__':
    main()
