import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf

def main():
    # Load dataset
    df = pd.read_csv('data/nls_ses_processed.csv')
    df.columns = [c.replace(' ', '_').replace(':', '') for c in df.columns]
    df['BA'] = df['BA_DEGREE_COMPLETED'].astype(int)

    print("=== DATASET SUMMARY ===")
    print(f"Total observations: {len(df)}")
    print(f"BA Degree Completed: {df['BA'].sum()} ({df['BA'].mean()*100:.2f}%)")
    
    # 1. Baseline Model
    probit_base = smf.probit('BA ~ SES + FAMILY_SIZE_OF_SAMPLE', data=df).fit(disp=False)
    print("\n=== BASELINE MODEL (Probit: BA ~ SES + FAMILY_SIZE_OF_SAMPLE) ===")
    print(probit_base.summary().tables[1])
    
    logit_race_only = smf.logit('BA ~ SES + C(SAMPLE_RACE)', data=df).fit(disp=False)
    print("\n=== BASELINE MODEL (Logit: BA ~ SES + SAMPLE_RACE) ===")
    print(logit_race_only.summary().tables[1])

    # 2. Controlled Model
    logit_controlled = smf.logit('BA ~ SES + C(SAMPLE_RACE) + ABILITY_COMPOSITE_OF_ASVAB_SCORE + PERCENTILE_IN_CLASS', data=df).fit(disp=False)
    print("\n=== CONTROLLED MODEL (Logit: BA ~ SES + Race + Academic Characteristics) ===")
    print(logit_controlled.summary().tables[1])

    # Probit Controlled Model
    probit_controlled = smf.probit('BA ~ SES + C(SAMPLE_RACE) + ABILITY_COMPOSITE_OF_ASVAB_SCORE + PERCENTILE_IN_CLASS', data=df).fit(disp=False)
    print("\n=== CONTROLLED MODEL (Probit: BA ~ SES + Race + Academic Characteristics) ===")
    print(probit_controlled.summary().tables[1])

if __name__ == '__main__':
    main()
