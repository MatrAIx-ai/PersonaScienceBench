import pandas as pd

df = pd.read_csv('data/meta-regression_study_data_heterogeneity_in_replication_projects.csv')

print("=== 1. All Observations Level ===")
for disc in ['Social', 'Cognitive', 'Economics']:
    sub = df[df['discipline'] == disc]
    o_pct = (sub['subjects.o'] == 'students').mean() * 100
    r_pct = (sub['subjects.r'] == 'students').mean() * 100
    print(f"{disc} (N={len(sub)}): Original={o_pct:.2f}%, Replication={r_pct:.2f}%")

print("\n=== 2. Deduplicated Study ID Level ===")
dedup = df.drop_duplicates('id')
for disc in ['Social', 'Cognitive', 'Economics']:
    sub = dedup[dedup['discipline'] == disc]
    o_pct = (sub['subjects.o'] == 'students').mean() * 100
    r_pct = (sub['subjects.r'] == 'students').mean() * 100
    print(f"{disc} (N={len(sub)}): Original={o_pct:.2f}%, Replication={r_pct:.2f}%")

print("\n=== 3. Analytic Sample with Valid relative_es (N=68 in Social) ===")
es_valid = dedup.dropna(subset=['relative_es'])
for disc in ['Social', 'Cognitive', 'Economics']:
    sub = es_valid[es_valid['discipline'] == disc]
    o_cnt = (sub['subjects.o'] == 'students').sum()
    r_cnt = (sub['subjects.r'] == 'students').sum()
    print(f"{disc} (N={len(sub)}): Original={o_cnt}/{len(sub)} ({o_cnt/len(sub)*100:.2f}%), Replication={r_cnt}/{len(sub)} ({r_cnt/len(sub)*100:.2f}%)")
