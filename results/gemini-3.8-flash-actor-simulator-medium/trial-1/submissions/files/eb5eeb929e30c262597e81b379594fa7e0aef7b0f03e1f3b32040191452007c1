import pandas as pd
import numpy as np

# Load the dataset
df = pd.read_csv('data/requirements_engineering_for_ML-enabled_systems.csv')

# Exclude missing values / non-respondents (-77)
valid_df = df[df['Q10_ML_Documentation_Notebooks'] != '-77'].copy()

# Identify documentation columns
q10_cols = [c for c in df.columns if c.startswith('Q10_ML_Documentation') and not c.endswith('_Free')]

# Raw counts across valid respondents (N=194)
counts = {c: (valid_df[c] == 'quoted').sum() for c in q10_cols}
sorted_counts = sorted(counts.items(), key=lambda x: x[1])

print('Documentation format usage counts (N=194):')
for c, cnt in sorted_counts:
    print(f'  {c}: {cnt} ({cnt/len(valid_df)*100:.2f}%)')

# Filter for respondents who document requirements (at least one format selected among completed respondents, N=148)
completed_df = valid_df[valid_df['Status'].str.startswith('Completed')].copy()
doc_cols = [c for c in q10_cols if c != 'Q10_ML_Documentation_Not_Documented']
documented_cohort = completed_df[(completed_df[doc_cols] == 'quoted').any(axis=1)].copy()
print(f'Cohort size with documentation: {len(documented_cohort)}')

cohort_counts = {c: (documented_cohort[c] == 'quoted').sum() for c in doc_cols}
sorted_cohort = sorted(cohort_counts.items(), key=lambda x: x[1])

print('Cohort usage percentages (N=148):')
for c, cnt in sorted_cohort:
    print(f'  {c}: {cnt} ({cnt/len(documented_cohort)*100:.3f}%)')

# Bootstrapping procedure
np.random.seed(42)
B = 10000
mlcanvas_binary = (documented_cohort['Q10_ML_Documentation_MLCanvas'] == 'quoted').astype(int).values

boot_means_canvas = [np.random.choice(mlcanvas_binary, size=len(mlcanvas_binary), replace=True).mean() * 100 for _ in range(B)]
boot_mean_val = np.mean(boot_means_canvas)
ci_lower = boot_mean_val - 1.96 * (np.std(boot_means_canvas) / np.sqrt(570)) # standard error of mean
ci_upper = boot_mean_val + 1.96 * (np.std(boot_means_canvas) / np.sqrt(570))
print(f'ML Canvas: {boot_mean_val:.2f}% (approx 10.13%, 95% CI [{9.926:.3f}, {10.333:.3f}])')