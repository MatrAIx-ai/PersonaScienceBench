import os
import pandas as pd

def run_analysis(file_path):
    print(f"Loading data from {file_path}...")
    xl = pd.ExcelFile(file_path)
    
    results = []
    for sheet_name in xl.sheet_names:
        df = pd.read_excel(file_path, sheet_name=sheet_name)
        total_genes = len(df)
        sig_deg_005 = (df['p_val_adj'] < 0.05).sum()
        sig_deg_001 = (df['p_val_adj'] < 0.01).sum()
        sig_deg_010 = (df['p_val_adj'] < 0.10).sum()
        sig_raw_005 = (df['p_val'] < 0.05).sum()
        
        results.append({
            'cell_type': sheet_name,
            'total_genes_tested': total_genes,
            'sig_deg_padj_0.05': sig_deg_005,
            'sig_deg_padj_0.01': sig_deg_001,
            'sig_deg_padj_0.10': sig_deg_010,
            'sig_deg_pval_0.05': sig_raw_005
        })
    
    res_df = pd.DataFrame(results)
    res_df = res_df.sort_values(by='sig_deg_padj_0.05', ascending=False).reset_index(drop=True)
    return res_df

if __name__ == '__main__':
    data_path = 'data/Supplemental Data File 1 PostvsPre_DEG_tables_ANNOTATED by_cell_type.xlsx'
    df_results = run_analysis(data_path)
    print("\n--- Summary of Differentially Expressed Genes by Cell Type ---")
    print(df_results.to_string(index=False))
    
    top_cell_type = df_results.iloc[0]['cell_type']
    top_deg_count = df_results.iloc[0]['sig_deg_padj_0.05']
    print(f"\nTop cell type with highest significant DEGs (padj < 0.05): {top_cell_type} with {top_deg_count} DEGs.")
