import pandas as pd
import numpy as np

# Load the proteomic dataset
file_path = "data/Proteomic_data .xlsx"
df = pd.read_excel(file_path, sheet_name="Tumor vs Normal")

# Filter for ENO1
eno1_row = df[df["gene"] == "ENO1"]

if eno1_row.empty:
    raise ValueError("ENO1 not found in dataset")

normal_val = eno1_row["Normal"].values[0]
print(f"Raw Normal level for ENO1: {normal_val}")

# Round to 3 significant figures
def round_to_3_sig_figs(val):
    return float(f"{val:.3g}")

sig_figs_val = round_to_3_sig_figs(normal_val)
print(f"Rounded to 3 significant figures (float): {sig_figs_val}")
print(f"Rounded to 3 significant figures (int representation): {int(sig_figs_val)}")

# Save result to a file if needed
with open("result.txt", "w") as f:
    f.write(f"{int(sig_figs_val)}\n")

