import json, math, os, sys
import numpy as np
from scipy.interpolate import PchipInterpolator
from scipy.signal import find_peaks
from scipy.ndimage import gaussian_filter1d

if '/usr/lib/python3/dist-packages' not in sys.path:
    sys.path.append('/usr/lib/python3/dist-packages')
from PIL import Image, ImageDraw, ImageFont

def main():
    with open('data/parameters.json', 'r') as f:
        params = json.load(f)

    coords_ref = np.load('data/target_coords.npy')
    N = int(params['n_beads'])
    friction = float(params['friction'])
    dt = float(params['dt_reduced'])
    temperature_list = [float(T) for T in params['temperature_list']]
    n_steps_per_T = int(params['n_steps_per_T'])
    cutoff = float(params['contact_cutoff'])
    min_seq_sep = int(params['min_seq_separation'])
    save_interval = int(params['save_interval'])

    assert coords_ref.shape == (N, 3), f'Expected ({N}, 3), got {coords_ref.shape}'
    K = len(temperature_list)

    native_pairs = []
    non_native_pairs = []
    for i in range(N):
        for j in range(i + min_seq_sep, N):
            d0 = np.linalg.norm(coords_ref[i] - coords_ref[j])
            if d0 < cutoff:
                native_pairs.append((i, j, d0))
            else:
                non_native_pairs.append((i, j))

    for i in range(N - 3):
        non_native_pairs.append((i, i + 3))

    M = len(native_pairs)
    print(f'Identified {M} native contact pairs (|i-j| >= {min_seq_sep}, d0 < {cutoff})')

    nat_i = np.array([p[0] for p in native_pairs], dtype=int)
    nat_j = np.array([p[1] for p in native_pairs], dtype=int)
    nat_d0 = np.array([p[2] for p in native_pairs], dtype=float)

    non_i = np.array([p[0] for p in non_native_pairs], dtype=int)
    non_j = np.array([p[1] for p in non_native_pairs], dtype=int)

    b_i = np.arange(N - 1)
    b_j = np.arange(1, N)
    b_d0 = np.linalg.norm(coords_ref[b_i] - coords_ref[b_j], axis=1)

    a_i = np.arange(N - 2)
    a_j = np.arange(2, N)
    a_d0 = np.linalg.norm(coords_ref[a_i] - coords_ref[a_j], axis=1)

    kb = 100.0
    ka = 20.0
    eps = 1.15
    sigma_rep = 3.8
    eps_rep = 1.0

    def compute_forces_and_energy(pos):
        forces = np.zeros_like(pos)
        E_tot = 0.0

        dr_b = pos[b_i] - pos[b_j]
        d_b = np.linalg.norm(dr_b, axis=1, keepdims=True)
        diff_b = d_b - b_d0[:, None]
        E_tot += 0.5 * kb * np.sum(diff_b**2)
        f_b = -kb * diff_b * (dr_b / d_b)
        np.add.at(forces, b_i, f_b)
        np.add.at(forces, b_j, -f_b)

        dr_a = pos[a_i] - pos[a_j]
        d_a = np.linalg.norm(dr_a, axis=1, keepdims=True)
        diff_a = d_a - a_d0[:, None]
        E_tot += 0.5 * ka * np.sum(diff_a**2)
        f_a = -ka * diff_a * (dr_a / d_a)
        np.add.at(forces, a_i, f_a)
        np.add.at(forces, a_j, -f_a)

        dr_nat = pos[nat_i] - pos[nat_j]
        d_nat = np.linalg.norm(dr_nat, axis=1, keepdims=True)
        ratio = nat_d0[:, None] / d_nat
        r10 = ratio**10
        r12 = ratio**12
        E_tot += eps * np.sum(5.0 * r12 - 6.0 * r10)
        f_mag = 60.0 * eps * (r12 - r10) / d_nat
        f_nat = f_mag * (dr_nat / d_nat)
        np.add.at(forces, nat_i, f_nat)
        np.add.at(forces, nat_j, -f_nat)

        dr_non = pos[non_i] - pos[non_j]
        d_non = np.linalg.norm(dr_non, axis=1, keepdims=True)
        mask = (d_non < sigma_rep)
        if np.any(mask):
            dr_m = dr_non[mask[:, 0]]
            d_m = d_non[mask]
            ratio_m = sigma_rep / d_m
            r12_m = ratio_m**12
            E_tot += eps_rep * np.sum(r12_m)
            f_mag_m = 12.0 * eps_rep * r12_m[:, None] / d_m[:, None]
            f_non = f_mag_m * (dr_m / d_m[:, None])
            np.add.at(forces, non_i[mask[:, 0]], f_non)
            np.add.at(forces, non_j[mask[:, 0]], -f_non)

        return forces, E_tot

    c1 = np.exp(-friction * dt)
    c2 = np.sqrt(1.0 - c1**2)
    np.random.seed(42)

    n_ckpt = n_steps_per_T // save_interval
    order_param_traj = np.zeros((K, n_ckpt), dtype=np.float64)
    energy_traj = np.zeros((K, n_ckpt), dtype=np.float64)
    native_contact_prob = np.zeros((K, M), dtype=np.float64)

    final_coords_lowest_T = None

    print(f'Running production simulations for {K} temperatures ({n_steps_per_T} steps each)...')
    for k, T in enumerate(temperature_list):
        r = coords_ref.copy()
        v = np.random.randn(*r.shape) * np.sqrt(T)
        f, E = compute_forces_and_energy(r)

        ckpt_idx = 0
        contact_presence_sum = np.zeros(M, dtype=np.float64)

        for step in range(1, n_steps_per_T + 1):
            v += 0.5 * dt * f
            r += 0.5 * dt * v
            v = c1 * v + c2 * np.sqrt(T) * np.random.randn(*r.shape)
            r += 0.5 * dt * v
            f, E = compute_forces_and_energy(r)
            v += 0.5 * dt * f

            if step % save_interval == 0:
                d_nat = np.linalg.norm(r[nat_i] - r[nat_j], axis=1)
                q_vals = 1.0 / (1.0 + np.exp(5.0 * (d_nat - cutoff)))
                q_mean = np.mean(q_vals)
                order_param_traj[k, ckpt_idx] = q_mean
                energy_traj[k, ckpt_idx] = E
                contact_presence_sum += (d_nat < cutoff).astype(np.float64)
                ckpt_idx += 1

        native_contact_prob[k] = contact_presence_sum / n_ckpt

        if k == 0:
            final_coords_lowest_T = r.copy()

        print(f'  T={T:.4f}: <Q> = {np.mean(order_param_traj[k]):.4f}, <E> = {np.mean(energy_traj[k]):.2f}, Cv = {np.var(energy_traj[k]) / (T**2):.2f}')

    np.save('final_coords.npy', final_coords_lowest_T)
    np.save('order_parameter_trajectory.npy', order_param_traj)
    np.save('native_contact_probability.npy', native_contact_prob)

    bins_Q = np.linspace(0.0, 1.0, 51)
    bin_centers_Q = 0.5 * (bins_Q[:-1] + bins_Q[1:])
    q_histograms = np.zeros((K, 50), dtype=np.float64)
    for k in range(K):
        hist, _ = np.histogram(order_param_traj[k], bins=bins_Q, density=True)
        q_histograms[k] = hist
    np.save('order_parameter_histograms.npy', q_histograms)

    mean_Q_by_T = [float(np.mean(order_param_traj[k])) for k in range(K)]
    var_Q_by_T = [float(np.var(order_param_traj[k])) for k in range(K)]
    mean_E_by_T = [float(np.mean(energy_traj[k])) for k in range(K)]
    var_E_by_T = [float(np.var(energy_traj[k])) for k in range(K)]
    Cv_direct_by_T = [float(var_E_by_T[k] / (temperature_list[k]**2)) for k in range(K)]

    q_e_corr_by_T = []
    for k in range(K):
        q_k = order_param_traj[k]
        e_k = energy_traj[k]
        std_q = np.std(q_k)
        std_e = np.std(e_k)
        if std_q > 1e-12 and std_e > 1e-12:
            corr = float(np.corrcoef(q_k, e_k)[0, 1])
        else:
            corr = 0.0
        q_e_corr_by_T.append(corr)

    temp_observables = {
        'temperatures': temperature_list,
        'mean_order_parameter_by_T': mean_Q_by_T,
        'var_order_parameter_by_T': var_Q_by_T,
        'mean_energy_by_T': mean_E_by_T,
        'var_energy_by_T': var_E_by_T,
        'heat_capacity_direct_by_T': Cv_direct_by_T,
        'q_energy_correlation_by_T': q_e_corr_by_T
    }
    with open('temperature_observables.json', 'w') as f:
        json.dump(temp_observables, f, indent=2)

    n_fine = 200
    T_fine = np.linspace(temperature_list[0], temperature_list[-1], n_fine)
    pchip_cv = PchipInterpolator(temperature_list, Cv_direct_by_T)
    Cv_fine = pchip_cv(T_fine)
    heat_capacity_curve = np.vstack([T_fine, Cv_fine])
    np.save('heat_capacity_curve.npy', heat_capacity_curve)
    peak_heat_capacity = float(np.max(Cv_fine))

    idx = -1
    for i in range(K - 1):
        if (mean_Q_by_T[i] - 0.5) * (mean_Q_by_T[i+1] - 0.5) <= 0:
            idx = i
            break
    if idx == -1:
        idx = min(range(K - 1), key=lambda i: abs(mean_Q_by_T[i] - 0.5))

    T_a, T_b = temperature_list[idx], temperature_list[idx+1]
    Q_a, Q_b = mean_Q_by_T[idx], mean_Q_by_T[idx+1]
    w = (0.5 - Q_a) / (Q_b - Q_a) if abs(Q_b - Q_a) > 1e-12 else 0.5
    w = float(np.clip(w, 0.0, 1.0))
    T_star = float(T_a + w * (T_b - T_a))

    p_star = (1.0 - w) * q_histograms[idx] + w * q_histograms[idx+1]
    p_star_smooth = gaussian_filter1d(p_star, sigma=1.0)
    p_star_smooth = np.maximum(p_star_smooth, 1e-12)
    p_star_smooth /= np.sum(p_star_smooth * (bins_Q[1] - bins_Q[0]))

    F_star = -np.log(p_star_smooth)
    F_star -= np.min(F_star)

    trans_fe_profile = np.vstack([bin_centers_Q, F_star])
    np.save('transition_free_energy_profile.npy', trans_fe_profile)

    peaks, _ = find_peaks(p_star_smooth, distance=4, prominence=0.03)
    if len(peaks) == 0:
        peaks = [np.argmax(p_star_smooth)]

    if len(peaks) >= 2:
        sorted_by_height = sorted(peaks, key=lambda p: p_star_smooth[p], reverse=True)[:2]
        sorted_by_height.sort()
        q_modes = [float(bin_centers_Q[p]) for p in sorted_by_height]
        mode_sep = float(abs(q_modes[1] - q_modes[0]))
        p1, p2 = sorted_by_height[0], sorted_by_height[1]
        barrier = float(np.max(F_star[p1:p2+1]) - max(F_star[p1], F_star[p2]))
    else:
        q_modes = [float(bin_centers_Q[peaks[0]])]
        mode_sep = 0.0
        barrier = 0.0

    q_bins_20 = np.linspace(0.0, 1.0, 21)
    z_bins_20 = np.linspace(-3.0, 3.0, 21)
    joint_histograms = np.zeros((K, 20, 20), dtype=np.float64)

    for k in range(K):
        q_data = order_param_traj[k]
        e_data = energy_traj[k]
        std_e = np.std(e_data)
        if std_e > 1e-12:
            z_data = (e_data - np.mean(e_data)) / std_e
        else:
            z_data = np.zeros_like(e_data)
        h2d, _, _ = np.histogram2d(q_data, z_data, bins=[q_bins_20, z_bins_20])
        h_sum = np.sum(h2d)
        if h_sum > 0:
            h2d /= h_sum
        joint_histograms[k] = h2d

    np.save('q_energy_joint_histograms.npy', joint_histograms)

    ref_adj = set(zip(nat_i, nat_j))
    final_adj = set()
    for i in range(N):
        for j in range(i + min_seq_sep, N):
            if np.linalg.norm(final_coords_lowest_T[i] - final_coords_lowest_T[j]) < cutoff:
                final_adj.add((i, j))

    inter = len(ref_adj.intersection(final_adj))
    union = len(ref_adj.union(final_adj))
    jaccard = float(inter / union) if union > 0 else 1.0

    transition_analysis = {
        'transition_temperature': T_star,
        'peak_heat_capacity': peak_heat_capacity,
        'order_parameter_at_transition_mean': 0.5,
        'order_parameter_at_transition_modes': q_modes,
        'mode_separation': mode_sep,
        'free_energy_barrier_kT': barrier,
        'reference_contact_jaccard': jaccard,
        'warnings': []
    }
    with open('transition_analysis.json', 'w') as f:
        json.dump(transition_analysis, f, indent=2)

    create_visualization(
        coords_ref=coords_ref,
        final_coords=final_coords_lowest_T,
        nat_pairs=native_pairs,
        temperatures=temperature_list,
        bins_Q=bins_Q,
        q_histograms=q_histograms,
        T_fine=T_fine,
        Cv_fine=Cv_fine,
        T_star=T_star,
        bin_centers_Q=bin_centers_Q,
        F_star=F_star,
        q_modes=q_modes,
        out_filename='visualization.png'
    )
    print('All tasks completed successfully!')

def create_visualization(coords_ref, final_coords, nat_pairs, temperatures,
                         bins_Q, q_histograms, T_fine, Cv_fine, T_star,
                         bin_centers_Q, F_star, q_modes, out_filename='visualization.png'):
    W, H = 1400, 1000
    img = Image.new('RGB', (W, H), color=(250, 252, 255))
    draw = ImageDraw.Draw(img)

    try:
        font_large = ImageFont.truetype('/usr/share/fonts/truetype/liberation/LiberationSans-Bold.ttf', 24)
        font_medium = ImageFont.truetype('/usr/share/fonts/truetype/liberation/LiberationSans-Bold.ttf', 18)
        font_small = ImageFont.truetype('/usr/share/fonts/truetype/liberation/LiberationSans-Regular.ttf', 14)
    except Exception:
        font_large = ImageFont.load_default()
        font_medium = ImageFont.load_default()
        font_small = ImageFont.load_default()

    draw.text((40, 20), 'Go-Model Stochastic Dynamics & Folding Transition Analysis', fill=(20, 30, 60), font=font_large)

    panels = [
        (40, 70, 680, 500, 'Panel 1: Final Lowest-T Folded Conformation (N=20 beads)'),
        (720, 70, 1360, 500, 'Panel 2: Native Contact Order Parameter Histograms P(Q)'),
        (40, 530, 680, 960, 'Panel 3: Fluctuation-Based Heat Capacity Response Curve Cv(T)'),
        (720, 530, 1360, 960, 'Panel 4: Shifted Free Energy Profile F(Q) at T*')
    ]

    for x0, y0, x1, y1, title in panels:
        draw.rectangle([x0, y0, x1, y1], fill=(255, 255, 255), outline=(210, 220, 230), width=2)
        draw.text((x0 + 15, y0 + 12), title, fill=(30, 40, 70), font=font_medium)

    p1_box = (80, 120, 640, 470)
    xy_final = final_coords[:, :2].copy()
    min_x, max_x = np.min(xy_final[:, 0]), np.max(xy_final[:, 0])
    min_y, max_y = np.min(xy_final[:, 1]), np.max(xy_final[:, 1])
    scale_x = (p1_box[2] - p1_box[0] - 60) / (max_x - min_x + 1e-6)
    scale_y = (p1_box[3] - p1_box[1] - 60) / (max_y - min_y + 1e-6)
    scale = min(scale_x, scale_y)
    cx = 0.5 * (p1_box[0] + p1_box[2])
    cy = 0.5 * (p1_box[1] + p1_box[3])
    mid_x = 0.5 * (min_x + max_x)
    mid_y = 0.5 * (min_y + max_y)

    pts = []
    for i in range(len(final_coords)):
        px = cx + (xy_final[i, 0] - mid_x) * scale
        py = cy - (xy_final[i, 1] - mid_y) * scale
        pts.append((px, py))

    for i, j, _ in nat_pairs:
        d = np.linalg.norm(final_coords[i] - final_coords[j])
        if d < 8.8797:
            draw.line([pts[i], pts[j]], fill=(180, 230, 180), width=2)

    for i in range(len(final_coords) - 1):
        draw.line([pts[i], pts[i+1]], fill=(60, 90, 150), width=4)

    r_bead = 8
    for i, (px, py) in enumerate(pts):
        color = (230, 60, 60) if (i == 0 or i == len(final_coords)-1) else (50, 120, 220)
        draw.ellipse([px - r_bead, py - r_bead, px + r_bead, py + r_bead], fill=color, outline=(20, 40, 80), width=2)
        draw.text((px - 3, py - 6), str(i+1), fill=(255, 255, 255), font=font_small)

    draw.text((p1_box[0], p1_box[3] + 5), 'Blue: Backbone beads | Red: Termini | Green: Native contacts', fill=(80, 90, 110), font=font_small)

    p2_box = (770, 130, 1310, 460)
    draw.line([(p2_box[0], p2_box[3]), (p2_box[2], p2_box[3])], fill=(120, 130, 140), width=2)
    draw.line([(p2_box[0], p2_box[1]), (p2_box[0], p2_box[3])], fill=(120, 130, 140), width=2)

    colors_T = [(31, 119, 180), (44, 160, 44), (255, 127, 14), (214, 39, 40), (148, 103, 189), (140, 86, 75)]
    max_h = max(np.max(q_histograms), 1.0)
    centers = bin_centers_Q
    w_px = p2_box[2] - p2_box[0]
    h_px = p2_box[3] - p2_box[1]

    for k in range(len(temperatures)):
        poly = []
        for i in range(len(centers)):
            px = p2_box[0] + centers[i] * w_px
            py = p2_box[3] - (q_histograms[k, i] / max_h) * h_px
            poly.append((px, py))
        for j in range(len(poly) - 1):
            draw.line([poly[j], poly[j+1]], fill=colors_T[k], width=2)
        leg_x = p2_box[2] - 170
        leg_y = p2_box[1] + 10 + k * 20
        draw.line([(leg_x, leg_y + 8), (leg_x + 25, leg_y + 8)], fill=colors_T[k], width=3)
        draw.text((leg_x + 35, leg_y), f'T = {temperatures[k]:.3f}', fill=(50, 60, 70), font=font_small)

    draw.text((p2_box[0] + w_px//2 - 40, p2_box[3] + 10), 'Order Parameter Q', fill=(40, 50, 60), font=font_small)
    draw.text((p2_box[0] - 45, p2_box[1] + h_px//2), 'P(Q)', fill=(40, 50, 60), font=font_small)

    p3_box = (100, 590, 640, 910)
    draw.line([(p3_box[0], p3_box[3]), (p3_box[2], p3_box[3])], fill=(120, 130, 140), width=2)
    draw.line([(p3_box[0], p3_box[1]), (p3_box[0], p3_box[3])], fill=(120, 130, 140), width=2)

    w3_px = p3_box[2] - p3_box[0]
    h3_px = p3_box[3] - p3_box[1]
    t_min, t_max = T_fine[0], T_fine[-1]
    cv_max = np.max(Cv_fine) * 1.15
    cv_min = 0.0

    poly3 = []
    for i in range(len(T_fine)):
        px = p3_box[0] + ((T_fine[i] - t_min) / (t_max - t_min)) * w3_px
        py = p3_box[3] - ((Cv_fine[i] - cv_min) / (cv_max - cv_min)) * h3_px
        poly3.append((px, py))
    for j in range(len(poly3) - 1):
        draw.line([poly3[j], poly3[j+1]], fill=(180, 50, 50), width=3)

    px_star = p3_box[0] + ((T_star - t_min) / (t_max - t_min)) * w3_px
    draw.line([(px_star, p3_box[1]), (px_star, p3_box[3])], fill=(40, 120, 200), width=2)
    draw.text((px_star + 5, p3_box[1] + 20), f'T* = {T_star:.4f}', fill=(40, 100, 180), font=font_small)

    draw.text((p3_box[0] + w3_px//2 - 50, p3_box[3] + 12), 'Temperature T (reduced)', fill=(40, 50, 60), font=font_small)
    draw.text((p3_box[0] - 55, p3_box[1] + h3_px//2), 'Cv(T)', fill=(40, 50, 60), font=font_small)

    p4_box = (770, 590, 1310, 910)
    draw.line([(p4_box[0], p4_box[3]), (p4_box[2], p4_box[3])], fill=(120, 130, 140), width=2)
    draw.line([(p4_box[0], p4_box[1]), (p4_box[0], p4_box[3])], fill=(120, 130, 140), width=2)

    w4_px = p4_box[2] - p4_box[0]
    h4_px = p4_box[3] - p4_box[1]
    f_max = min(np.max(F_star), 8.0)
    f_min = 0.0

    poly4 = []
    for i in range(len(bin_centers_Q)):
        px = p4_box[0] + bin_centers_Q[i] * w4_px
        val = min(F_star[i], f_max)
        py = p4_box[3] - ((val - f_min) / (f_max - f_min)) * h4_px
        poly4.append((px, py))
    for j in range(len(poly4) - 1):
        draw.line([poly4[j], poly4[j+1]], fill=(60, 40, 150), width=3)

    for m in q_modes:
        pm_x = p4_box[0] + m * w4_px
        draw.line([(pm_x, p4_box[1]), (pm_x, p4_box[3])], fill=(200, 80, 40), width=1)
        draw.text((pm_x - 15, p4_box[1] + 15), f'Q={m:.2f}', fill=(180, 70, 30), font=font_small)

    draw.text((p4_box[0] + w4_px//2 - 40, p4_box[3] + 12), 'Order Parameter Q', fill=(40, 50, 60), font=font_small)
    draw.text((p4_box[0] - 65, p4_box[1] + h4_px//2), 'F(Q) / kBT*', fill=(40, 50, 60), font=font_small)

    img.save(out_filename, 'PNG')
    print(f'Saved visualization to {out_filename}')

if __name__ == '__main__':
    main()
