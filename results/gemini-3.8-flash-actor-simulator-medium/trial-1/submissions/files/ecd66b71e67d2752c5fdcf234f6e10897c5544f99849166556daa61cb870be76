import pandas as pd
import numpy as np

def main():
    # Load the Zebra Finch dataset
    file_path = 'data/ZF_AgeRelated_CpG_noMT_Final.csv'
    df = pd.read_csv(file_path)

    # 1. Basic dataset overview
    total_rows = len(df)
    unique_sites = df['Pos'].unique()
    total_sites = len(unique_sites)
    
    print(f"Total observations (rows): {total_rows}")
    print(f"Total unique CpG sites: {total_sites}")

    # 2. Per-site analysis of MethylationPercentage
    # Group by site ('Pos')
    site_groups = df.groupby('Pos')['MethylationPercentage']
    
    # Check strict condition (>90% or <10%)
    # Sites that show >90% or <10% in at least one sample
    shows_gt90_or_lt10 = site_groups.apply(lambda s: ((s > 90.0) | (s < 10.0)).any())
    num_shows_strict = shows_gt90_or_lt10.sum()
    num_removed_strict = total_sites - num_shows_strict

    # Check non-strict condition (>=90% or <=10%)
    shows_ge90_or_le10 = site_groups.apply(lambda s: ((s >= 90.0) | (s <= 10.0)).any())
    num_shows_nonstrict = shows_ge90_or_le10.sum()
    num_removed_nonstrict = total_sites - num_shows_nonstrict

    print("\n--- Filtering Results (Strict: >90% or <10%) ---")
    print(f"Sites showing >90% or <10% methylation in at least one sample: {num_shows_strict}")
    print(f"Sites removed (not showing >90% or <10% methylation): {num_removed_strict}")

    print("\n--- Filtering Results (Non-Strict: >=90% or <=10%) ---")
    print(f"Sites showing >=90% or <=10% methylation in at least one sample: {num_shows_nonstrict}")
    print(f"Sites removed (not showing >=90% or <=10% methylation): {num_removed_nonstrict}")

    # Mean methylation across samples for each site
    site_means = site_groups.mean()
    print("\n--- Site Mean Methylation Stats ---")
    print(f"Min site mean: {site_means.min():.2f}%")
    print(f"Max site mean: {site_means.max():.2f}%")

if __name__ == '__main__':
    main()
