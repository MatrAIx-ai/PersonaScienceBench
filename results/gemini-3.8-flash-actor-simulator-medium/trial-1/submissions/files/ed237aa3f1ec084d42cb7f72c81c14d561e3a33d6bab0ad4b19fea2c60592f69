import pandas as pd
import numpy as np

def run_analysis():
    # 1. Load capital.csv containing 100-year step cultural capital data
    df = pd.read_csv('data/capital.csv', decimal=',')
    df = df.sort_values('BCE', ascending=False).reset_index(drop=True)
    
    # 2. Extract Pottery Form and Decoration
    df_pottery = df[['BCE', 'group', 'ZKeform', 'Zkeverz']].copy()
    df_pottery.rename(columns={
        'ZKeform': 'PotteryForm',
        'Zkeverz': 'PotteryDecoration'
    }, inplace=True)
    
    # 3. Calculate step differences (value at t - value at t-100)
    df_pottery['d_PotteryForm'] = df_pottery['PotteryForm'].diff()
    df_pottery['d_PotteryDecoration'] = df_pottery['PotteryDecoration'].diff()
    
    # 4. Filter intervals with opposite growth trends
    # Specifically: PotteryDecoration increases (>0) and PotteryForm decreases (<0)
    df_pottery['Deco_Up_Form_Down'] = (df_pottery['d_PotteryDecoration'] > 0) & (df_pottery['d_PotteryForm'] < 0)
    
    # Save results to csv
    df_pottery.to_csv('pottery_diversity_trends.csv', index=False)
    
    opposite_rows = df_pottery[df_pottery['Deco_Up_Form_Down']]
    print("Opposite trend intervals found:")
    print(opposite_rows[['BCE', 'group', 'PotteryForm', 'PotteryDecoration', 'd_PotteryForm', 'd_PotteryDecoration']])
    
    return df_pottery

if __name__ == '__main__':
    run_analysis()
