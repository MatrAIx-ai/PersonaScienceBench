#!/usr/bin/env python3
"""
Analysis script for BixBench bix-57-q1:
Percentage of gap characters relative to total alignment positions across all alignments after aligning with MAFFT (--auto).
"""

import os
import sys
import glob
import shutil
import subprocess
import json

def read_fasta(filepath):
    """Read a FASTA file and return a dictionary of {header: sequence}."""
    sequences = {}
    current_header = None
    current_seq = []
    with open(filepath, 'r') as f:
        for line in f:
            line = line.strip()
            if not line:
                continue
            if line.startswith('>'):
                if current_header is not None:
                    sequences[current_header] = ''.join(current_seq)
                current_header = line[1:]
                current_seq = []
            else:
                current_seq.append(line)
        if current_header is not None:
            sequences[current_header] = ''.join(current_seq)
    return sequences

def check_mafft():
    """Check if mafft is available in PATH or common paths."""
    mafft_bin = shutil.which('mafft')
    if mafft_bin:
        return mafft_bin
    common_paths = [
        '/usr/bin/mafft',
        '/usr/local/bin/mafft',
        '/bin/mafft',
        '/opt/mafft/bin/mafft'
    ]
    for p in common_paths:
        if os.path.isfile(p) and os.access(p, os.X_OK):
            return p
    return None

def align_with_mafft(mafft_bin, input_faa, output_aln):
    """Run mafft --auto input_faa > output_aln"""
    cmd = [mafft_bin, '--auto', input_faa]
    with open(output_aln, 'w') as out_f:
        res = subprocess.run(cmd, stdout=out_f, stderr=subprocess.PIPE, text=True)
    if res.returncode != 0:
        raise RuntimeError(f"MAFFT failed on {input_faa}: {res.stderr}")

def analyze_alignment(aln_file, orig_file):
    """
    Validate alignment and compute gap statistics.
    Returns dict of metrics.
    """
    aln_seqs = read_fasta(aln_file)
    orig_seqs = read_fasta(orig_file)
    
    # Validation 1: Same number of sequences
    assert len(aln_seqs) == len(orig_seqs), f"Sequence count mismatch in {aln_file}"
    
    # Validation 2: Aligned sequences all have identical length
    aln_lengths = [len(s) for s in aln_seqs.values()]
    assert len(set(aln_lengths)) == 1, f"Unequal alignment lengths in {aln_file}: {aln_lengths}"
    aln_len = aln_lengths[0]
    
    # Validation 3: Removing gaps gives original sequences
    for h, s in aln_seqs.items():
        assert h in orig_seqs, f"Header {h} not found in original"
        degapped = s.replace('-', '').replace('.', '')
        assert degapped == orig_seqs[h], f"Sequence mismatch after degapping for {h}"
        
    num_seqs = len(aln_seqs)
    total_positions = num_seqs * aln_len
    gap_count = sum(s.count('-') + s.count('.') for s in aln_seqs.values())
    residue_count = sum(len(s) for s in orig_seqs.values())
    
    assert total_positions == gap_count + residue_count, "Sanity check failed: total != gaps + residues"
    gap_percentage = (gap_count / total_positions) * 100.0 if total_positions > 0 else 0.0
    
    return {
        'file': os.path.basename(orig_file),
        'num_seqs': num_seqs,
        'aln_length': aln_len,
        'total_positions': total_positions,
        'residue_count': residue_count,
        'gap_count': gap_count,
        'gap_percentage': gap_percentage
    }

def main():
    print("=" * 70)
    print("MAFFT MSA & Gap Percentage Analysis Pipeline")
    print("=" * 70)
    
    data_dir = os.path.join(os.path.dirname(__file__), '..', 'data')
    input_files = sorted(glob.glob(os.path.join(data_dir, '*.faa')))
    print(f"Found {len(input_files)} input FASTA files in {data_dir}.")
    
    # Input summary
    total_orig_residues = 0
    total_orig_seqs = 0
    for f in input_files:
        seqs = read_fasta(f)
        total_orig_seqs += len(seqs)
        total_orig_residues += sum(len(s) for s in seqs.values())
    print(f"Input validation: Total files = {len(input_files)}, Total sequences = {total_orig_seqs}, Total residues = {total_orig_residues}")
    
    mafft_bin = check_mafft()
    if not mafft_bin:
        print("\n[DIAGNOSTIC NOTICE]")
        print("MAFFT executable ('mafft') is NOT present in the system environment.")
        print("System investigation details:")
        print("  - PATH checked: " + os.environ.get('PATH', ''))
        print("  - apt-get / dpkg: /var directory not mounted; root filesystem is read-only.")
        print("  - Network: sandbox environment has network isolation (--unshare-net).")
        print("  - User privileges: unprivileged non-root user (capabilities dropped).")
        print("Please ensure MAFFT is installed or made available in PATH.")
        return 1
        
    print(f"\nUsing MAFFT binary: {mafft_bin}")
    out_dir = os.path.join(os.path.dirname(__file__), '..', 'aligned_outputs')
    os.makedirs(out_dir, exist_ok=True)
    
    results = []
    for f in input_files:
        base = os.path.basename(f)
        out_aln = os.path.join(out_dir, base.replace('.faa', '_aligned.faa'))
        print(f"Aligning {base} -> {os.path.basename(out_aln)} ...")
        align_with_mafft(mafft_bin, f, out_aln)
        metrics = analyze_alignment(out_aln, f)
        results.append(metrics)
        print(f"  Done: L={metrics['aln_length']}, Gaps={metrics['gap_count']}/{metrics['total_positions']} ({metrics['gap_percentage']:.2f}%)")
        
    # Aggregate statistics
    total_positions_all = sum(r['total_positions'] for r in results)
    total_gaps_all = sum(r['gap_count'] for r in results)
    total_residues_all = sum(r['residue_count'] for r in results)
    
    micro_avg_gap_pct = (total_gaps_all / total_positions_all) * 100.0
    macro_avg_gap_pct = sum(r['gap_percentage'] for r in results) / len(results)
    
    print("\n" + "=" * 70)
    print("SUMMARY RESULTS ACROSS ALL 10 ALIGNMENTS")
    print("=" * 70)
    print(f"{'Filename':<20} {'Seqs':<6} {'Len':<6} {'Total Pos':<12} {'Residues':<10} {'Gaps':<8} {'Gap %':<8}")
    print("-" * 70)
    for r in results:
        print(f"{r['file']:<20} {r['num_seqs']:<6} {r['aln_length']:<6} {r['total_positions']:<12} {r['residue_count']:<10} {r['gap_count']:<8} {r['gap_percentage']:<8.2f}")
    print("-" * 70)
    print(f"{'POOLED TOTAL':<20} {total_orig_seqs:<6} {'-':<6} {total_positions_all:<12} {total_residues_all:<10} {total_gaps_all:<8} {micro_avg_gap_pct:<8.2f}")
    print("=" * 70)
    print(f"Micro-average (Pooled Gap Percentage) : {micro_avg_gap_pct:.4f}% ({micro_avg_gap_pct:.2f}%)")
    print(f"Macro-average (Mean of File Percentages): {macro_avg_gap_pct:.4f}% ({macro_avg_gap_pct:.2f}%)")
    
    # Save output json
    summary_path = os.path.join(out_dir, 'gap_statistics_summary.json')
    with open(summary_path, 'w') as jf:
        json.dump({
            'per_file_metrics': results,
            'total_positions': total_positions_all,
            'total_gaps': total_gaps_all,
            'total_residues': total_residues_all,
            'micro_average_gap_percentage': micro_avg_gap_pct,
            'macro_average_gap_percentage': macro_avg_gap_pct
        }, jf, indent=2)
    print(f"\nDetailed metrics saved to: {summary_path}")
    return 0

if __name__ == '__main__':
    sys.exit(main())
