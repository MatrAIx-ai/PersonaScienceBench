import pandas as pd
import numpy as np
from scipy import stats

def run_analysis():
    df = pd.read_csv('data/nls_raw.csv')

    race_map = {1: 'Black', 2: 'Hispanic', 3: 'White'}
    df['race'] = df['Racial/ethnic cohort, 1979'].map(race_map)

    wealth_cols = {
        1985: 'Family net wealth, 1985',
        1990: 'Family net wealth, 1990',
        1996: 'Family net wealth, 1996 (key data point)'
    }

    records = []
    for year, col in wealth_cols.items():
        for race in ['White', 'Black', 'Hispanic']:
            sub = df[df['race'] == race][col].dropna()
            sub_pos = sub[sub >= 0]
            records.append({
                'year': year,
                'race': race,
                'n_valid': len(sub),
                'median': sub.median(),
                'mean': sub.mean(),
                'std': sub.std(),
                'p25': sub.quantile(0.25),
                'p75': sub.quantile(0.75),
                'iqr': sub.quantile(0.75) - sub.quantile(0.25),
                'pct_negative': (sub < 0).mean() * 100,
                'n_nonneg': len(sub_pos),
                'median_nonneg': sub_pos.median(),
                'mean_nonneg': sub_pos.mean()
            })

    res_df = pd.DataFrame(records)
    res_df.to_csv('wealth_summary_by_race.csv', index=False)
    print("=== Wealth Summary by Race and Year ===")
    print(res_df.to_string(index=False))

    print("\n=== Pairwise Comparisons and Tests ===")
    for year, col in wealth_cols.items():
        w = df[df['race'] == 'White'][col].dropna()
        b = df[df['race'] == 'Black'][col].dropna()
        h = df[df['race'] == 'Hispanic'][col].dropna()
        
        mw_wb = stats.mannwhitneyu(w, b, alternative='two-sided')
        mw_wh = stats.mannwhitneyu(w, h, alternative='two-sided')
        mw_bh = stats.mannwhitneyu(b, h, alternative='two-sided')
        
        print(f"\nYear {year}:")
        print(f"  White median: ${w.median():,.1f} | Black median: ${b.median():,.1f} | Hispanic median: ${h.median():,.1f}")
        print(f"  Ratio White/Black:    {w.median()/b.median():.2f}x | Diff: ${w.median() - b.median():,.1f} | MWU p: {mw_wb.pvalue:.2e}")
        print(f"  Ratio White/Hispanic: {w.median()/h.median():.2f}x | Diff: ${w.median() - h.median():,.1f} | MWU p: {mw_wh.pvalue:.2e}")
        print(f"  Ratio Black/Hispanic: {b.median()/h.median():.2f}x | Diff: ${b.median() - h.median():,.1f} | MWU p: {mw_bh.pvalue:.2e}")

if __name__ == '__main__':
    run_analysis()
