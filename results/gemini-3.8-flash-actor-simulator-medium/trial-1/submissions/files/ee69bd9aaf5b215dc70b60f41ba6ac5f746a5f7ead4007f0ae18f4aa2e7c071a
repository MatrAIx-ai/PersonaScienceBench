import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf

def run_analysis():
    # 1. Load data
    df = pd.read_csv('data/nls_raw.csv')
    print(f"Total raw observations: {len(df)}")

    # 2. Variable construction
    # Race: 2 = Black, 3 = Non-Black Non-Hispanic
    df['black'] = (df['Racial/ethnic cohort, 1979'] == 2).astype(int)
    df['white'] = (df['Racial/ethnic cohort, 1979'] == 3).astype(int)

    # BA degree completion (Highest grade completed >= 16)
    df['ba'] = (df['Highest grade completed, 1979'] >= 16).astype(int)

    # Parental education (max of mother and father)
    df['m_edu'] = df['Highest grade completed by respondent\'s mother, 1979']
    df['f_edu'] = df['Highest grade completed by respondent\'s father, 1979']
    df['p_edu'] = df[['m_edu', 'f_edu']].max(axis=1)

    # Family income in 1979
    df['income'] = df['Total net family income, previous calendar year, 1979']
    df['log_income'] = np.log1p(df['income'])

    # Standardized components of SES
    df['p_edu_z'] = (df['p_edu'] - df['p_edu'].mean()) / df['p_edu'].std()
    df['income_z'] = (df['income'] - df['income'].mean()) / df['income'].std()
    df['ses'] = df[['p_edu_z', 'income_z']].mean(axis=1)

    # Cognitive ability (ASVAB composite)
    asvab_cols = [c for c in df.columns if 'ASVAB' in c]
    for c in asvab_cols:
        df[c + '_z'] = (df[c] - df[c].mean()) / df[c].std()
    df['afqt'] = df[[c + '_z' for c in asvab_cols]].mean(axis=1)

    # 3. Analytic sample: Black and White respondents, age >= 20
    sub = df[df['Racial/ethnic cohort, 1979'].isin([2, 3]) & (df['Age of respondent, 1979'] >= 20)].dropna(subset=['ses', 'ba', 'afqt']).copy()
    print(f"Analytic sample size (age >= 20, Black & White with non-missing covariates): {len(sub)}")
    print(f"Black respondents: {sub['black'].sum()}, White respondents: {(1 - sub['black']).sum()}")
    print(f"Total BA completions: {sub['ba'].sum()} (Black: {sub[sub['black']==1]['ba'].sum()}, White: {sub[sub['black']==0]['ba'].sum()})")

    # 4. Stratified SES analysis
    sub['ses_tertile'] = pd.qcut(sub['ses'], 3, labels=['Low', 'Medium', 'High'])
    strat = sub.groupby(['ses_tertile', 'black'])['ba'].agg(['count', 'sum', 'mean']).unstack()
    print("\n--- Empirical BA Completion Rates by SES Tertile ---")
    print(strat)

    # 5. Logistic Regression Model: BA ~ Black * SES + AFQT
    logit_mod = smf.logit('ba ~ black * ses + afqt', data=sub).fit(disp=False)
    print("\n--- Logistic Regression Model 1: Composite SES ---")
    print(logit_mod.summary())

    # 6. Logistic Regression Model: BA ~ Black * log_income + AFQT
    logit_inc = smf.logit('ba ~ black * log_income + afqt', data=sub).fit(disp=False)
    print("\n--- Logistic Regression Model 2: Family Income ---")
    print(logit_inc.summary())

    # 7. Linear Probability Model (OLS): BA ~ Black * SES + AFQT
    ols_mod = smf.ols('ba ~ black * ses + afqt', data=sub).fit()
    print("\n--- Linear Probability Model (OLS) ---")
    print(ols_mod.summary())

    # 8. Predicted probabilities across SES gradient
    print("\n--- Predicted BA Completion Probabilities across SES (at mean AFQT) ---")
    ses_levels = [-1.5, -1.0, -0.5, 0.0, 0.5, 1.0, 1.5]
    for s_val in ses_levels:
        p_w = logit_mod.predict(pd.DataFrame({'black': [0], 'ses': [s_val], 'afqt': [0]}))[0]
        p_b = logit_mod.predict(pd.DataFrame({'black': [1], 'ses': [s_val], 'afqt': [0]}))[0]
        diff = p_b - p_w
        ratio = p_b / p_w if p_w > 0 else np.nan
        print(f"SES = {s_val:+4.1f} | White P(BA): {p_w:.4f} | Black P(BA): {p_b:.4f} | Diff: {diff:+7.4f} | Black/White Ratio: {ratio:.2f}x")

if __name__ == '__main__':
    run_analysis()
