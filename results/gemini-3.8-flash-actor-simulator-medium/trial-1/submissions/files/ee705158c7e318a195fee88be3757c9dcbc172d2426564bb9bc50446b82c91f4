import pandas as pd
import numpy as np
from scipy.stats import chi2_contingency, fisher_exact

# Load datasets
dm = pd.read_csv('data/TASK008_BCG-CORONA_DM.csv')
ae = pd.read_csv('data/TASK008_BCG-CORONA_AE.csv')

# Identify COVID-19 events
covid_terms = ['COVID-19', 'COVID-19 pneumonia', 'Asymptomatic COVID-19', 'SARS-CoV-2 test positive']
covid_ae = ae[ae['AEPT'].isin(covid_terms)].copy()

print("======================================================================")
print("TOTAL SAMPLE SUMMARY:")
print(f"Total DM subjects: {len(dm)}")
print(f"BCG subjects: {(dm['TRTGRP'] == 'BCG').sum()}, Placebo subjects: {(dm['TRTGRP'] == 'Placebo').sum()}")
print("Distribution of patients_seen:")
print(dm['patients_seen'].value_counts())
print(f"Total COVID-19 AE records: {len(covid_ae)}")
print(f"Unique COVID-19 infected subjects: {covid_ae['USUBJID'].nunique()}")
print("======================================================================\n")

# Merge DM and AE for COVID-19 cases
# 1. Event-level merged
event_m = pd.merge(dm[['USUBJID', 'TRTGRP', 'patients_seen']], covid_ae, on=['USUBJID', 'TRTGRP'])

# 2. Subject-level max severity merged
subj_max = covid_ae.groupby('USUBJID').agg({
    'AESEV': 'max',
    'AEHS': 'max',
    'AESER': lambda x: 'Yes' if 'Yes' in x.values else 'No'
}).reset_index()
subj_m = pd.merge(dm[['USUBJID', 'TRTGRP', 'patients_seen']], subj_max, on='USUBJID')

# Define test scenarios
# Scenario A: AEHS (WHO Health Status / Clinical Scale)
# - Multiclass (0, 1, 2, 3, 4, 5, 6, 7)
# - Dichotomized: Mild/Moderate (0, 1, 2) vs Severe/Hospitalized (>=3)
# Scenario B: AESEV (Adverse Event Severity / Intensity)
# - Multiclass (1, 2, 3, 4)
# - Dichotomized: Mild/Moderate (1, 2) vs Severe (3, 4)

def run_tests_for_definition(df, group_col, trt_col, outcome_col, title, is_binary=False):
    print(f"----------------------------------------------------------------------")
    print(f"ANALYSIS: {title}")
    print(f"----------------------------------------------------------------------")
    for grp in ['1-50', '51-100', '>100']:
        sub = df[df[group_col] == grp].dropna(subset=[outcome_col])
        ct = pd.crosstab(sub[trt_col], sub[outcome_col])
        ct_pct = pd.crosstab(sub[trt_col], sub[outcome_col], normalize='index') * 100
        print(f"\n>>> Subgroup: patients_seen = {grp} (Total N = {len(sub)}) <<<")
        print("Contingency Table (Counts):")
        print(ct)
        print("\nRow Percentages (%):")
        print(ct_pct.round(1))
        
        if ct.shape[0] > 1 and ct.shape[1] > 1:
            chi2_uncorr = chi2_contingency(ct, correction=False)
            print(f"\nPearson Chi-Square (uncorrected): stat = {chi2_uncorr.statistic:.4f}, df = {chi2_uncorr.dof}, p = {chi2_uncorr.pvalue:.5f}")
            if is_binary and ct.shape == (2, 2):
                chi2_corr = chi2_contingency(ct, correction=True)
                print(f"Yates Continuity Corrected Chi-Square: stat = {chi2_corr.statistic:.4f}, df = {chi2_corr.dof}, p = {chi2_corr.pvalue:.5f}")
                fe_res = fisher_exact(ct)
                print(f"Fisher's Exact Test: odds_ratio = {fe_res.statistic:.4f}, p = {fe_res.pvalue:.5f}")
        else:
            print("Cannot compute chi-square (insufficient dimensions).")

# 1. Event-level AEHS >= 3
event_m['AEHS_severe'] = event_m['AEHS'] >= 3
run_tests_for_definition(event_m, 'patients_seen', 'TRTGRP', 'AEHS_severe', 
                         'Event-level AEHS Dichotomized (Hospitalized/Severe >=3 vs Ambulatory <3)', is_binary=True)

# 2. Subject-level AEHS >= 3
subj_m['AEHS_severe'] = subj_m['AEHS'] >= 3
run_tests_for_definition(subj_m, 'patients_seen', 'TRTGRP', 'AEHS_severe', 
                         'Subject-level AEHS Dichotomized (Hospitalized/Severe >=3 vs Ambulatory <3)', is_binary=True)

# 3. Event-level AESEV >= 3
event_m['AESEV_severe'] = event_m['AESEV'] >= 3
run_tests_for_definition(event_m, 'patients_seen', 'TRTGRP', 'AESEV_severe', 
                         'Event-level AESEV Dichotomized (Severe/Life-threatening >=3 vs Mild/Moderate <3)', is_binary=True)

# 4. Subject-level AESEV >= 3
subj_m['AESEV_severe'] = subj_m['AESEV'] >= 3
run_tests_for_definition(subj_m, 'patients_seen', 'TRTGRP', 'AESEV_severe', 
                         'Subject-level AESEV Dichotomized (Severe/Life-threatening >=3 vs Mild/Moderate <3)', is_binary=True)

# 5. Full multiclass tests
run_tests_for_definition(event_m, 'patients_seen', 'TRTGRP', 'AEHS', 
                         'Event-level AEHS Multiclass (0-7)', is_binary=False)
run_tests_for_definition(subj_m, 'patients_seen', 'TRTGRP', 'AEHS', 
                         'Subject-level AEHS Multiclass (0-7)', is_binary=False)
run_tests_for_definition(event_m, 'patients_seen', 'TRTGRP', 'AESEV', 
                         'Event-level AESEV Multiclass (1-4)', is_binary=False)
run_tests_for_definition(subj_m, 'patients_seen', 'TRTGRP', 'AESEV', 
                         'Subject-level AESEV Multiclass (1-4)', is_binary=False)

