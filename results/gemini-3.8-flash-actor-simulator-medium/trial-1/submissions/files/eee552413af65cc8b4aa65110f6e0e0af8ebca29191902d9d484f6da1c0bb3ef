import pandas as pd
import numpy as np

# Load dataset
df = pd.read_csv('data/requirements_engineering_for_ML-enabled_systems.csv')

# Exclude negative NA values in Q9 elicitation
q9_cols = [c for c in df.columns if c.startswith('Q9_ML_Elicitation_') and not c.endswith('_Free')]

# Summary of techniques
summary = []
for col in q9_cols:
    tech = col.replace('Q9_ML_Elicitation_', '')
    quoted = (df[col] == 'quoted').sum()
    not_quoted = (df[col] == 'not quoted').sum()
    na_count = (df[col].astype(str).str.startswith('-')).sum()
    valid = quoted + not_quoted
    pct = quoted / valid * 100 if valid > 0 else 0
    summary.append({
        'variable': col,
        'technique': tech,
        'quoted': quoted,
        'not_quoted': not_quoted,
        'na_excluded': na_count,
        'valid_total': valid,
        'pct_valid': pct
    })

res = pd.DataFrame(summary).sort_values(by='quoted', ascending=False)
print(res.to_string(index=False))

# Save summary
res.to_csv('elicitation_techniques_summary.csv', index=False)