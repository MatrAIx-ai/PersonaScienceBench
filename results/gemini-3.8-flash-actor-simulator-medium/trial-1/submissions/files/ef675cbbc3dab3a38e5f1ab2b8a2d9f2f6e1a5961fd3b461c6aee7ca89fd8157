#!/usr/bin/env python3
"""
Latent state fitting of categorical streams with pure NumPy/SciPy.
"""

import os
import sys
import json
import math
import struct
import zlib
import numpy as np
import pandas as pd


def load_data(meta_p="data/metadata.json", seq_p="data/sequences.csv"):
    with open(meta_p, "r") as f:
        meta = json.load(f)
    df = pd.read_csv(seq_p)
    return meta, df


def run_em_single(seq_symbols, one_hots, K, n_symbols, rng, max_iter=75, tol=1e-5):
    pi = rng.dirichlet(np.ones(K) * 2.0)
    A = np.array([rng.dirichlet(np.ones(K) + (np.arange(K) == i) * 3.0) for i in range(K)])
    B = rng.dirichlet(np.ones(n_symbols) * 0.2, size=K)

    prev_ll = -1e30
    trace = []

    for it in range(max_iter):
        total_ll = 0.0
        xi_sum = np.zeros((K, K))
        b_sum = np.zeros((K, n_symbols))
        pi_sum = np.zeros(K)

        for s, O in zip(seq_symbols, one_hots):
            T = len(s)
            b_seq = B[:, s]
            alpha = np.empty((T, K))
            c = np.empty(T)

            alpha[0] = pi * b_seq[:, 0]
            c[0] = max(np.sum(alpha[0]), 1e-300)
            alpha[0] /= c[0]

            for t in range(1, T):
                alpha[t] = (alpha[t - 1] @ A) * b_seq[:, t]
                c[t] = max(np.sum(alpha[t]), 1e-300)
                alpha[t] /= c[t]

            total_ll += np.sum(np.log(c))

            beta = np.empty((T, K))
            beta[-1] = 1.0
            for t in range(T - 2, -1, -1):
                beta[t] = A @ (b_seq[:, t + 1] * beta[t + 1])
                beta[t] /= c[t + 1]

            gamma = alpha * beta
            gamma /= np.sum(gamma, axis=1, keepdims=True)

            pi_sum += gamma[0]
            b_sum += gamma.T @ O

            tmp = (beta[1:] * b_seq[:, 1:].T) / c[1:, None]
            xi_sum += (alpha[:-1].T @ tmp) * A

        rel_change = 0.0 if it == 0 else abs(total_ll - prev_ll) / abs(prev_ll)
        trace.append((it, total_ll, rel_change))

        if it > 0 and rel_change < tol:
            break
        prev_ll = total_ll

        pi = pi_sum / len(seq_symbols)
        pi /= np.sum(pi)

        row_xi = np.sum(xi_sum, axis=1, keepdims=True)
        A = np.where(row_xi > 0, xi_sum / row_xi, 1.0 / K)

        row_b = np.sum(b_sum, axis=1, keepdims=True)
        B = np.where(row_b > 0, b_sum / row_b, 1.0 / n_symbols)

    return total_ll, pi, A, B, trace, xi_sum

def compute_posteriors_and_viterbi(seq_symbols, pi, A, B):
    K = len(pi)
    gamma_all = []
    seq_lls = []
    viterbi_all = []

    log_pi = np.log(np.maximum(pi, 1e-300))
    log_A = np.log(np.maximum(A, 1e-300))

    for s in seq_symbols:
        T = len(s)
        b_seq = B[:, s]
        alpha = np.empty((T, K))
        c = np.empty(T)

        alpha[0] = pi * b_seq[:, 0]
        c[0] = max(np.sum(alpha[0]), 1e-300)
        alpha[0] /= c[0]

        for t in range(1, T):
            alpha[t] = (alpha[t - 1] @ A) * b_seq[:, t]
            c[t] = max(np.sum(alpha[t]), 1e-300)
            alpha[t] /= c[t]

        seq_lls.append(np.sum(np.log(c)))

        beta = np.empty((T, K))
        beta[-1] = 1.0
        for t in range(T - 2, -1, -1):
            beta[t] = A @ (b_seq[:, t + 1] * beta[t + 1])
            beta[t] /= c[t + 1]

        gamma = alpha * beta
        gamma /= np.sum(gamma, axis=1, keepdims=True)
        gamma_all.append(gamma)

        # Viterbi decoding in log-space
        v_log = np.empty((T, K))
        ptr = np.empty((T, K), dtype=int)
        log_B = np.log(np.maximum(b_seq, 1e-300))

        v_log[0] = log_pi + log_B[:, 0]
        for t in range(1, T):
            trans_probs = v_log[t - 1, :, None] + log_A
            ptr[t] = np.argmax(trans_probs, axis=0)
            v_log[t] = trans_probs[ptr[t], np.arange(K)] + log_B[:, t]

        path = np.empty(T, dtype=int)
        path[-1] = np.argmax(v_log[-1])
        for t in range(T - 2, -1, -1):
            path[t] = ptr[t + 1, path[t + 1]]
        viterbi_all.append(path)

    return gamma_all, seq_lls, viterbi_all

def create_diagnostics_plot(cand_df, best_trace_list, A_matrix, output_path="results/diagnostics.png"):
    width, height = 800, 500
    canvas = np.full((height, width, 3), 250, dtype=np.uint8)

    def fill_rect(x0, y0, x1, y1, color):
        x0, y0 = max(0, int(x0)), max(0, int(y0))
        x1, y1 = min(width - 1, int(x1)), min(height - 1, int(y1))
        if x1 >= x0 and y1 >= y0:
            canvas[y0:y1+1, x0:x1+1] = color

    def draw_line(x0, y0, x1, y1, color):
        x0, y0, x1, y1 = int(x0), int(y0), int(x1), int(y1)
        dx, dy = abs(x1 - x0), abs(y1 - y0)
        sx, sy = (1 if x0 < x1 else -1), (1 if y0 < y1 else -1)
        err = dx - dy
        while True:
            if 0 <= x0 < width and 0 <= y0 < height:
                canvas[y0, x0] = color
            if x0 == x1 and y0 == y1:
                break
            e2 = 2 * err
            if e2 > -dy:
                err -= dy
                x0 += sx
            if e2 < dx:
                err += dx
                y0 += sy

    # Header
    fill_rect(10, 10, width - 10, 45, (35, 50, 75))

    # Panel 1: BIC curve
    fill_rect(20, 60, 380, 260, (255, 255, 255))
    fill_rect(20, 60, 380, 85, (230, 235, 245))
    ks = cand_df["candidate"].values
    bics = cand_df["criterion"].values
    b_min, b_max = np.min(bics), np.max(bics)
    pad = (b_max - b_min) * 0.1 if b_max > b_min else 1.0
    b_min -= pad
    b_max += pad

    p1_x0, p1_y0, p1_w, p1_h = 50, 100, 300, 130
    draw_line(p1_x0, p1_y0 + p1_h, p1_x0 + p1_w, p1_y0 + p1_h, (160, 160, 160))
    draw_line(p1_x0, p1_y0, p1_x0, p1_y0 + p1_h, (160, 160, 160))

    coords = []
    for k_v, bic_v in zip(ks, bics):
        x = p1_x0 + (k_v - np.min(ks)) / (np.max(ks) - np.min(ks)) * p1_w
        y = p1_y0 + p1_h - (bic_v - b_min) / (b_max - b_min) * p1_h
        coords.append((x, y))

    for i in range(len(coords) - 1):
        draw_line(coords[i][0], coords[i][1], coords[i+1][0], coords[i+1][1], (50, 100, 200))
    for (x, y), ch in zip(coords, cand_df["chosen"]):
        c = (220, 30, 30) if ch else (50, 100, 200)
        fill_rect(x - 3, y - 3, x + 3, y + 3, c)

    # Panel 2: Restarts
    fill_rect(410, 60, 780, 260, (255, 255, 255))
    fill_rect(410, 60, 780, 85, (230, 235, 245))
    p2_x0, p2_y0, p2_w, p2_h = 440, 100, 300, 130
    draw_line(p2_x0, p2_y0 + p2_h, p2_x0 + p2_w, p2_y0 + p2_h, (160, 160, 160))
    draw_line(p2_x0, p2_y0, p2_x0, p2_y0 + p2_h, (160, 160, 160))

    all_objs = [step[1] for run in best_trace_list for step in run]
    o_min, o_max = min(all_objs), max(all_objs)
    max_steps = max(len(run) for run in best_trace_list)
    colors = [(40, 150, 80), (50, 100, 200), (200, 120, 30), (140, 50, 180), (220, 40, 40)]
    for r_idx, run in enumerate(best_trace_list):
        col = colors[r_idx % len(colors)]
        prev_p = None
        for s_idx, obj_v, _ in run:
            x = p2_x0 + (s_idx / max(1, max_steps - 1)) * p2_w
            y = p2_y0 + p2_h - ((obj_v - o_min) / max(1e-9, o_max - o_min)) * p2_h
            if prev_p is not None:
                draw_line(prev_p[0], prev_p[1], x, y, col)
            prev_p = (x, y)

    # Panel 3: Heatmap of A
    fill_rect(20, 280, 380, 480, (255, 255, 255))
    fill_rect(20, 280, 380, 305, (230, 235, 245))
    K = A_matrix.shape[0]
    cell_w, cell_h = 45, 24
    gx0, gy0 = 50, 320
    for i in range(K):
        for j in range(K):
            v = A_matrix[i, j]
            r = int(255 - v * 220)
            g = int(255 - v * 180)
            b = int(255 - v * 80)
            fill_rect(gx0 + j*cell_w, gy0 + i*cell_h, gx0 + (j+1)*cell_w - 2, gy0 + (i+1)*cell_h - 2, (r, g, b))

    # Panel 4: Decorative summary card
    fill_rect(410, 280, 780, 480, (255, 255, 255))
    fill_rect(410, 280, 780, 305, (230, 235, 245))
    for idx, col_box in enumerate([(40, 150, 80), (50, 100, 200), (200, 120, 30), (140, 50, 180)]):
        fill_rect(440, 330 + idx*32, 455, 345 + idx*32, col_box)
        fill_rect(470, 335 + idx*32, 750, 340 + idx*32, (200, 210, 225))

    raw_data = bytearray()
    for y in range(height):
        raw_data.append(0)
        raw_data.extend(canvas[y].tobytes())
    compressed = zlib.compress(bytes(raw_data), level=7)

    def chunk(tag, data):
        return struct.pack(">I", len(data)) + tag + data + struct.pack(">I", zlib.crc32(tag + data) & 0xffffffff)

    png_bytes = bytearray(b"\x89PNG\r\n\x1a\n")
    ihdr = struct.pack(">IIBBBBB", width, height, 8, 2, 0, 0, 0)
    png_bytes.extend(chunk(b"IHDR", ihdr))
    png_bytes.extend(chunk(b"IDAT", compressed))
    png_bytes.extend(chunk(b"IEND", b""))

    os.makedirs(os.path.dirname(output_path), exist_ok=True)
    with open(output_path, "wb") as f:
        f.write(png_bytes)
    print(f"Diagnostics image written to {output_path} ({len(png_bytes)} bytes)")

def main():
    os.makedirs("results", exist_ok=True)
    metadata, df_seqs = load_data()

    seq_groups = [grp for _, grp in df_seqs.groupby("sequence_id")]
    seq_ids = [grp["sequence_id"].iloc[0] for grp in seq_groups]
    seq_symbols = [grp["symbol"].values for grp in seq_groups]
    n_total_obs = len(df_seqs)
    n_symbols = 32

    one_hots = [np.eye(n_symbols)[s] for s in seq_symbols]

    candidates = [2, 3, 4, 5, 6, 7, 8]
    candidate_records = []
    print("Evaluating candidate granularities...")

    best_candidate_models = {}

    for K in candidates:
        n_free = (K - 1) + K * (K - 1) + K * (n_symbols - 1)
        best_ll = -1e30
        best_model = None

        for seed in [17, 42, 101]:
            rng = np.random.default_rng(seed)
            ll, pi, A, B, trace, xi_sum = run_em_single(seq_symbols, one_hots, K, n_symbols, rng)
            if ll > best_ll:
                best_ll = ll
                best_model = (pi, A, B, trace, xi_sum)

        bic = -2.0 * best_ll + n_free * math.log(n_total_obs)
        best_candidate_models[K] = (best_ll, bic, best_model)
        print(f"Candidate K={K:2d} | Free={n_free:3d} | LogLik={best_ll:10.2f} | BIC={bic:10.2f}")

    chosen_K = min(candidates, key=lambda k: best_candidate_models[k][1])
    print(f"\nOptimal candidate selected: K = {chosen_K} (BIC = {best_candidate_models[chosen_K][1]:.2f})")

    for K in candidates:
        n_free = (K - 1) + K * (K - 1) + K * (n_symbols - 1)
        ll, bic, _ = best_candidate_models[K]
        candidate_records.append({
            "candidate": K,
            "n_free_values": n_free,
            "objective": ll,
            "criterion": bic,
            "chosen": bool(K == chosen_K)
        })

    cand_df = pd.DataFrame(candidate_records)
    cand_df.to_csv("results/candidate_summary.csv", index=False)
    print("Saved results/candidate_summary.csv")

    print(f"\nRunning 5 independent restarts for chosen K={chosen_K}...")
    n_restarts = 5
    fit_trace_records = []
    best_chosen_ll = -1e30
    best_chosen_model = None
    all_restart_traces = []

    for run_idx in range(n_restarts):
        seed = 42 + run_idx * 137
        rng = np.random.default_rng(seed)
        ll, pi, A, B, trace, xi_sum = run_em_single(seq_symbols, one_hots, chosen_K, n_symbols, rng, max_iter=80, tol=1e-5)
        all_restart_traces.append(trace)

        for step, obj, rel_ch in trace:
            fit_trace_records.append({
                "run": run_idx,
                "step": step,
                "objective": obj,
                "relative_change": rel_ch
            })

        if ll > best_chosen_ll:
            best_chosen_ll = ll
            best_chosen_model = (pi, A, B, xi_sum)

    fit_trace_df = pd.DataFrame(fit_trace_records)
    fit_trace_df.to_csv("results/fit_trace.csv", index=False)
    print("Saved results/fit_trace.csv")

    chosen_pi, chosen_A, chosen_B, chosen_xi_sum = best_chosen_model

    # 1. results/matrix_a.csv
    matrix_a_records = []
    for r in range(chosen_K):
        for c in range(chosen_K):
            matrix_a_records.append({
                "row": r,
                "column": c,
                "value": chosen_A[r, c]
            })
    pd.DataFrame(matrix_a_records).to_csv("results/matrix_a.csv", index=False)
    print("Saved results/matrix_a.csv")

    # 2. results/matrix_b.csv
    matrix_b_records = []
    for r in range(chosen_K):
        for s in range(n_symbols):
            matrix_b_records.append({
                "row": r,
                "symbol": s,
                "symbol_label": f"sym_{s:02d}",
                "value": chosen_B[r, s]
            })
    pd.DataFrame(matrix_b_records).to_csv("results/matrix_b.csv", index=False)
    print("Saved results/matrix_b.csv")

    # 3. results/vector_a.csv
    vector_a_records = []
    for r in range(chosen_K):
        vector_a_records.append({
            "row": r,
            "value": chosen_pi[r]
        })
    pd.DataFrame(vector_a_records).to_csv("results/vector_a.csv", index=False)
    print("Saved results/vector_a.csv")

    gamma_all, seq_lls, viterbi_all = compute_posteriors_and_viterbi(seq_symbols, chosen_pi, chosen_A, chosen_B)

    # 4. results/local_weights.npy
    local_weights_array = np.vstack(gamma_all)
    local_weights_array /= np.sum(local_weights_array, axis=1, keepdims=True)
    np.save("results/local_weights.npy", local_weights_array.astype(float))
    print(f"Saved results/local_weights.npy with shape {local_weights_array.shape}")

    # 5. results/neighbor_summary.csv
    total_transitions = np.sum(chosen_xi_sum)
    row_transitions = np.sum(chosen_xi_sum, axis=1, keepdims=True)
    neighbor_records = []
    for r in range(chosen_K):
        for c in range(chosen_K):
            w = chosen_xi_sum[r, c]
            jf = w / total_transitions if total_transitions > 0 else 0.0
            cv = w / row_transitions[r, 0] if row_transitions[r, 0] > 0 else 1.0 / chosen_K
            neighbor_records.append({
                "row": r,
                "column": c,
                "weight": w,
                "joint_fraction": jf,
                "conditional_value": cv
            })
    pd.DataFrame(neighbor_records).to_csv("results/neighbor_summary.csv", index=False)
    print("Saved results/neighbor_summary.csv")

    # 6. results/local_assignments.csv
    local_assignment_records = []
    global_idx = 0
    for seq_id, seq_viterbi in zip(seq_ids, viterbi_all):
        for pos, lbl in enumerate(seq_viterbi):
            local_assignment_records.append({
                "sequence_id": seq_id,
                "position": pos,
                "global_index": global_idx,
                "label": int(lbl)
            })
            global_idx += 1
    pd.DataFrame(local_assignment_records).to_csv("results/local_assignments.csv", index=False)
    print("Saved results/local_assignments.csv")

    # 7. results/stream_diagnostics.csv
    stream_diag_records = []
    for seq_id, gamma_seq, s_ll, v_seq in zip(seq_ids, gamma_all, seq_lls, viterbi_all):
        n_pos = len(v_seq)
        mean_obj = s_ll / n_pos
        ent_pos = -np.sum(gamma_seq * np.log(np.maximum(gamma_seq, 1e-15)), axis=1)
        mean_ent = float(np.mean(ent_pos))
        counts = np.bincount(v_seq, minlength=chosen_K)
        dom_frac = float(np.max(counts) / n_pos)

        stream_diag_records.append({
            "sequence_id": seq_id,
            "n_positions": n_pos,
            "mean_objective": mean_obj,
            "weight_entropy_mean": mean_ent,
            "dominant_label_fraction": dom_frac
        })
    pd.DataFrame(stream_diag_records).to_csv("results/stream_diagnostics.csv", index=False)
    print("Saved results/stream_diagnostics.csv")

    # 8. results/diagnostics.png
    create_diagnostics_plot(cand_df, all_restart_traces, chosen_A, "results/diagnostics.png")

    print("\nAll tasks completed successfully!")


if __name__ == "__main__":
    main()
