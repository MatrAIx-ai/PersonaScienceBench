import os
import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf

def main():
    data_path = 'data/data.xlsx'
    df = pd.read_excel(data_path)
    
    # Filter valid 80 patient observations
    df_valid = df.iloc[:80].copy()
    
    # Define binary target: PR (Partial Response) = 1, others (SD, PD) = 0
    df_valid['target'] = (df_valid['Efficacy'] == 'PR').astype(int)
    
    # Ensure BMI is numeric
    df_valid['BMI'] = pd.to_numeric(df_valid['BMI'])
    
    # Logistic regression using statsmodels Logit
    logit_model = smf.logit('target ~ BMI', data=df_valid).fit()
    print("--- Logit Model Summary ---")
    print(logit_model.summary())
    
    # Also verify with GLM Binomial
    glm_model = smf.glm('target ~ BMI', data=df_valid, family=sm.families.Binomial()).fit()
    print("\n--- GLM Model Summary ---")
    print(glm_model.summary())
    
    aic = logit_model.aic
    log_likelihood = logit_model.llf
    k = len(logit_model.params)
    calculated_aic = 2 * k - 2 * log_likelihood
    
    print(f"\nNumber of observations: {logit_model.nobs}")
    print(f"Log-Likelihood: {log_likelihood:.6f}")
    print(f"Degrees of freedom / parameters (k): {k}")
    print(f"Model AIC (exact): {aic:.6f}")
    print(f"Model AIC (rounded to 4 decimal places): {aic:.4f}")
    print(f"Model AIC (rounded to 2 decimal places): {round(aic, 2)}")
    print(f"Formula check 2k - 2*LL: {calculated_aic:.6f}")
    
    # Coefficients
    print("\nCoefficients:")
    print(f"Intercept: {logit_model.params['Intercept']:.6f} (p-value: {logit_model.pvalues['Intercept']:.4f})")
    print(f"BMI: {logit_model.params['BMI']:.6f} (p-value: {logit_model.pvalues['BMI']:.4f})")
    
    return aic

if __name__ == '__main__':
    main()
