#!/usr/bin/env python3
r"""
Shared-mode recovery from complex response curves.
Fits the Cole-Cole relaxation model:
    R_m(x) = a_{0, m} + \sum_{k=1}^K a_{k, m} / (1 + (i * x * tau_k)^phi_k)
jointly across all curves with physical constraints:
    tau_k > 0, 0 < phi_k <= 1, a_{0, m} >= 0, a_{k, m} >= 0.
r"""

import os
import json
import numpy as np
import pandas as pd
from scipy.optimize import nnls, minimize, differential_evolution


def load_data(curves_path="data/curves.csv", meta_path="data/meta.json"):
    df = pd.read_csv(curves_path)
    with open(meta_path, "r") as f:
        meta = json.load(f)

    curves = [df[df["curve"] == c].sort_values("x") for c in range(meta["n_curves"])]
    x = curves[0]["x"].values
    y_re = np.array([c["re"].values for c in curves])
    y_im = np.array([c["im"].values for c in curves])

    return x, y_re, y_im, meta


def build_design_matrix(x, log_taus, phis):
    r"""
    Constructs the real design matrix [Re(A); Im(A)] for variable projection.
    Column 0 is baseline (1 + 0j).
    Columns 1..K correspond to mode terms 1 / (1 + (i * x * tau_k)^phi_k).
    r"""
    N = len(x)
    K = len(log_taus)
    taus = np.exp(log_taus)

    A = np.zeros((2 * N, 1 + K))
    A[:N, 0] = 1.0  # Real part of baseline
    A[N:, 0] = 0.0  # Imaginary part of baseline

    for k in range(K):
        tau = taus[k]
        phi = phis[k]
        denom = 1.0 + (x * tau) ** phi * np.exp(1j * phi * np.pi / 2.0)
        mode = 1.0 / denom
        A[:N, 1 + k] = mode.real
        A[N:, 1 + k] = mode.imag

    return A


def evaluate_model(params, x, y_re, y_im, K):
    r"""
    Evaluates total RSS and per-curve amplitudes using NNLS.
    r"""
    log_taus = params[:K]
    phis = params[K:]
    A = build_design_matrix(x, log_taus, phis)

    n_curves = len(y_re)
    coeffs = np.zeros((n_curves, 1 + K))
    total_rss = 0.0

    for m in range(n_curves):
        ym = np.concatenate([y_re[m], y_im[m]])
        c, rnorm = nnls(A, ym)
        coeffs[m] = c
        total_rss += rnorm ** 2

    return total_rss, coeffs


def select_order_and_fit(x, y_re, y_im, candidate_k=[1, 2, 3, 4, 5]):
    n_curves, N = y_re.shape
    n_data = n_curves * 2 * N
    results = {}

    print("--- Candidate Model Order Evaluation ---")
    for K in candidate_k:
        bounds = [(-8.0, 8.0)] * K + [(0.1, 1.0)] * K
        de_res = differential_evolution(
            lambda p: evaluate_model(p, x, y_re, y_im, K)[0],
            bounds,
            seed=42,
            maxiter=250,
            popsize=15,
            tol=1e-5,
        )
        opt = minimize(
            lambda p: evaluate_model(p, x, y_re, y_im, K)[0],
            de_res.x,
            method="L-BFGS-B",
            bounds=bounds,
        )
        rss, coeffs = evaluate_model(opt.x, x, y_re, y_im, K)
        n_params = 2 * K + n_curves * (1 + K)
        bic = n_data * np.log(rss / n_data) + n_params * np.log(n_data)
        sigma = np.sqrt(rss / n_data)
        results[K] = {
            "params": opt.x,
            "rss": rss,
            "bic": bic,
            "sigma": sigma,
            "coeffs": coeffs,
        }
        print(f"K = {K}: RSS = {rss:.4f}, sigma = {sigma:.4f}, BIC = {bic:.2f}")

    best_k = min(candidate_k, key=lambda k: results[k]["bic"])
    print(f"\nOptimal model order selected by BIC: K = {best_k}")
    return best_k, results[best_k]


def main():
    x, y_re, y_im, meta = load_data()
    n_curves = meta["n_curves"]

    best_k, best_fit = select_order_and_fit(x, y_re, y_im, candidate_k=[1, 2, 3, 4, 5])

    opt_params = best_fit["params"]
    taus = np.exp(opt_params[:best_k])
    phis = opt_params[best_k:]
    coeffs = best_fit["coeffs"]

    # Sort modes by tau ascending
    sort_idx = np.argsort(taus)
    taus_sorted = taus[sort_idx]
    phis_sorted = phis[sort_idx]
    # coeffs columns: 0 is a0; 1..K are mode amplitudes
    mode_amplitudes = coeffs[:, 1 + sort_idx]  # shape: (n_curves, K)

    print("\n--- Recovered Modes ---")
    for k in range(best_k):
        amps = [f"a_{m}={mode_amplitudes[m, k]:.4f}" for m in range(n_curves)]
        print(f"Mode {k+1}: tau = {taus_sorted[k]:.6e}, phi = {phis_sorted[k]:.4f} | " + ", ".join(amps))

    # Prepare modes dataframe
    # Format: tau, a_0, a_1, ..., a_{M-1}
    df_dict = {"tau": taus_sorted}
    for m in range(n_curves):
        df_dict[f"a_{m}"] = mode_amplitudes[m, :]

    modes_df = pd.DataFrame(df_dict)

    os.makedirs("results", exist_ok=True)
    out_path = "results/modes.csv"
    modes_df.to_csv(out_path, index=False)
    print(f"\nSaved recovered modes to {out_path}:")
    print(modes_df.to_string(index=False))


if __name__ == "__main__":
    main()
