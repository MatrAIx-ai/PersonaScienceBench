#!/usr/bin/env python3
"""
Differential gene expression analysis and binomial exact test for three tissue comparisons:
1. Final vs Baseline Blood
2. Dentate gyrus vs Baseline blood
3. Dentate gyrus vs Final blood
"""

import sys
import numpy as np
import pandas as pd
from scipy import stats
from statsmodels.stats.multitest import multipletests

def main():
    excel_path = 'data/Data_deposition_RNAseq_Paroxetine_2017.xlsx'
    print(f"Loading data from {excel_path}...")
    
    # Read normalized expression counts
    df = pd.read_excel(excel_path, sheet_name='NormCount', skiprows=3)
    gene_ids = df['GeneID'].values
    
    # Identify sample columns
    bl_cols = [c for c in df.columns[2:92] if 'baseline_blood' in c]
    dg_cols = [c for c in df.columns[2:92] if 'dentate_gyrus' in c]
    fi_cols = [c for c in df.columns[2:92] if 'final_blood' in c]
    
    print(f"Sample counts: baseline_blood={len(bl_cols)}, dentate_gyrus={len(dg_cols)}, final_blood={len(fi_cols)}")
    
    # Extract matrices
    X_bl = df[bl_cols].values.astype(float)
    X_dg = df[dg_cols].values.astype(float)
    X_fi = df[fi_cols].values.astype(float)
    
    # Log2-transformed expression (log2(count + 1))
    log_bl = np.log2(X_bl + 1)
    log_dg = np.log2(X_dg + 1)
    log_fi = np.log2(X_fi + 1)
    
    comparisons = [
        ("Final vs Baseline Blood", log_fi, log_bl),
        ("Dentate gyrus vs Baseline blood", log_dg, log_bl),
        ("Dentate gyrus vs Final blood", log_dg, log_fi),
    ]
    
    summary_records = []
    
    for name, mat1, mat2 in comparisons:
        print(f"\n--- Running DEG Analysis for: {name} ---")
        
        # Paired t-test (matched mice) and independent Welch's t-test
        t_stat, p_val = stats.ttest_rel(mat1, mat2, axis=1)
        mean_diff = np.mean(mat1 - mat2, axis=1) # log2 fold difference
        
        # Filter valid genes
        valid = ~np.isnan(p_val)
        p_val_valid = p_val[valid]
        mean_diff_valid = mean_diff[valid]
        total_valid = len(p_val_valid)
        
        # Multiple testing correction (Benjamini-Hochberg FDR)
        rej_bh, padj_bh, _, _ = multipletests(p_val_valid, alpha=0.05, method='fdr_bh')
        
        # Definition 1: Biologically meaningful DEGs (padj < 0.05 and |log2FC| > 1)
        deg_lfc1 = rej_bh & (np.abs(mean_diff_valid) > 1.0)
        k_lfc1 = int(np.sum(deg_lfc1))
        prop_lfc1 = k_lfc1 / total_valid
        
        # Definition 2: Strict DEGs (padj < 0.05 and |log2FC| > 2)
        deg_lfc2 = rej_bh & (np.abs(mean_diff_valid) > 2.0)
        k_lfc2 = int(np.sum(deg_lfc2))
        prop_lfc2 = k_lfc2 / total_valid
        
        # Binomial exact tests testing whether proportion of DEGs exceeds or is less than 5%
        btest_greater = stats.binomtest(k_lfc1, total_valid, p=0.05, alternative='greater')
        btest_less = stats.binomtest(k_lfc1, total_valid, p=0.05, alternative='less')
        
        # Welch's t-test for cross-validation
        t_ind, p_ind = stats.ttest_ind(mat1, mat2, axis=1, equal_var=False)
        rej_ind, padj_ind, _, _ = multipletests(p_ind[valid], alpha=0.05, method='fdr_bh')
        deg_ind_lfc1 = rej_ind & (np.abs(mean_diff_valid) > 1.0)
        k_ind_lfc1 = int(np.sum(deg_ind_lfc1))
        
        summary_records.append({
            "Comparison": name,
            "Total_Genes_Tested": total_valid,
            "DEGs_padj0.05_lfc1": k_lfc1,
            "Prop_DEGs_lfc1": prop_lfc1,
            "DEGs_padj0.05_lfc2": k_lfc2,
            "Prop_DEGs_lfc2": prop_lfc2,
            "DEGs_Welch_lfc1": k_ind_lfc1,
            "Binom_p_greater_5pct": btest_greater.pvalue,
            "Binom_p_less_5pct": btest_less.pvalue,
            "Conclusion": "Negligible effects" if prop_lfc1 < 0.05 else "Strong effects"
        })
        
        print(f"Total genes tested: {total_valid}")
        print(f"Significant DEGs (padj < 0.05 & |log2FC| > 1): {k_lfc1} ({prop_lfc1:.2%})")
        print(f"Significant DEGs (padj < 0.05 & |log2FC| > 2): {k_lfc2} ({prop_lfc2:.2%})")
        print(f"Binomial test p-value (alternative='less than 5%'): {btest_less.pvalue:.4e}")
        print(f"Binomial test p-value (alternative='greater than 5%'): {btest_greater.pvalue:.4e}")
        
    df_summary = pd.DataFrame(summary_records)
    print("\n=== SUMMARY TABLE ===")
    print(df_summary.to_string(index=False))
    
    # Save summary
    df_summary.to_csv("tissue_comparison_deg_summary.csv", index=False)
    print("\nResults successfully saved to tissue_comparison_deg_summary.csv")

if __name__ == "__main__":
    main()
