"""
Hidden Binary-Grid Time Evolution (Ising Domain Growth)
Implementation of Model A dynamics on a 2D square lattice,
computing observables, spatial correlations, dynamical scaling collapse,
power-law growth exponent fitting, and diagnostic visualizations.
"""

import os
import json
import zlib
import struct
import numpy as np
from scipy.interpolate import interp1d
from scipy.stats import linregress

def load_inputs(param_path="data/parameters.json", state_path="data/initial_state.npy"):
    with open(param_path, "r") as f:
        params = json.load(f)
    initial_state = np.load(state_path)
    return params, initial_state

def compute_spatial_correlations(state, max_r):
    L = state.shape[0]
    f = np.fft.fft2(state)
    corr2d = np.fft.ifft2(np.abs(f) ** 2).real / (L * L)
    
    corr_x = corr2d[0, :].copy()
    corr_y = corr2d[:, 0].copy()
    corr_axes = np.stack([corr_x, corr_y], axis=0)
    corr_axis_avg = 0.5 * (corr_x + corr_y)

    y, x = np.ogrid[:L, :L]
    dx = np.minimum(x, L - x)
    dy = np.minimum(y, L - y)
    r = np.sqrt(dx ** 2 + dy ** 2)
    r_int = np.round(r).astype(int)
    
    c_rad = np.zeros(max_r, dtype=np.float64)
    for ri in range(max_r):
        mask = (r_int == ri)
        if np.any(mask):
            c_rad[ri] = corr2d[mask].mean()
            
    return c_rad, corr_axis_avg, corr_axes

def measure_characteristic_length(c_rad):
    for ri in range(len(c_rad) - 1):
        if c_rad[ri] >= 0.5 and c_rad[ri + 1] < 0.5:
            frac = (0.5 - c_rad[ri]) / (c_rad[ri + 1] - c_rad[ri])
            return float(ri + frac)
    return float(len(c_rad) - 1.0)

def compute_energy_per_spin(state):
    nn = (np.roll(state, 1, 0) + np.roll(state, -1, 0) +
          np.roll(state, 1, 1) + np.roll(state, -1, 1))
    return float(-0.5 * np.mean(state * nn))

def save_png(filename, width, height, canvas):
    raw = bytearray()
    for y in range(height):
        raw.append(0)
        raw.extend(canvas[y].tobytes())
        
    def chunk(tag, data):
        return struct.pack('>I', len(data)) + tag + data + struct.pack('>I', zlib.crc32(tag + data) & 0xffffffff)

    ihdr = struct.pack('>IIBBBBB', width, height, 8, 2, 0, 0, 0)
    idat = zlib.compress(bytes(raw))
    
    with open(filename, 'wb') as f:
        f.write(bytes([0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a]))
        f.write(chunk(b'IHDR', ihdr))
        f.write(chunk(b'IDAT', idat))
        f.write(chunk(b'IEND', b''))

def generate_figure(snapshot_states, seriesA, seriesB, stackC, snapshot_times,
                    metaA, metaB, x_eval, rescaled_curves):
    width, height = 1200, 900
    canvas = np.full((height, width, 3), 255, dtype=np.uint8)
    
    def draw_rect(x1, y1, x2, y2, color):
        x1, x2 = max(0, min(x1, x2)), min(width, max(x1, x2))
        y1, y2 = max(0, min(y1, y2)), min(height, max(y1, y2))
        canvas[y1:y2, x1:x2] = color
        
    def draw_polyline(pts, color, thickness=2):
        for i in range(len(pts) - 1):
            xa, ya = int(pts[i][0]), int(pts[i][1])
            xb, yb = int(pts[i+1][0]), int(pts[i+1][1])
            dx, dy = abs(xb - xa), abs(yb - ya)
            sx = 1 if xa < xb else -1
            sy = 1 if ya < yb else -1
            err = dx - dy
            cx, cy = xa, ya
            while True:
                for tx in range(-thickness//2, thickness//2 + 1):
                    for ty in range(-thickness//2, thickness//2 + 1):
                        px, py = cx + tx, cy + ty
                        if 0 <= px < width and 0 <= py < height:
                            canvas[py, px] = color
                if cx == xb and cy == yb:
                    break
                e2 = 2 * err
                if e2 > -dy:
                    err -= dy
                    cx += sx
                if e2 < dx:
                    err += dx
                    cy += sy

    # Header bar
    draw_rect(0, 0, width, 50, (40, 50, 70))
    
    # 4 Snapshots across top
    snap_box_w, snap_box_h = 180, 180
    start_y = 70
    colors_spins = {1: np.array([220, 60, 60], dtype=np.uint8),
                    -1: np.array([60, 100, 220], dtype=np.uint8)}
    
    for i in range(min(4, len(snapshot_states))):
        t_val, s_mat = snapshot_states[i]
        start_x = 40 + i * (snap_box_w + 50)
        grid_l = s_mat.shape[0]
        step_sz = snap_box_w // grid_l
        for gy in range(grid_l):
            for gx in range(grid_l):
                c = colors_spins[s_mat[gy, gx]]
                draw_rect(start_x + gx * step_sz, start_y + gy * step_sz,
                          start_x + (gx + 1) * step_sz, start_y + (gy + 1) * step_sz, c)
        draw_rect(start_x - 1, start_y - 1, start_x + snap_box_w + 1, start_y, (0, 0, 0))
        draw_rect(start_x - 1, start_y + snap_box_h, start_x + snap_box_w + 1, start_y + snap_box_h + 1, (0, 0, 0))
        draw_rect(start_x - 1, start_y - 1, start_x, start_y + snap_box_h + 1, (0, 0, 0))
        draw_rect(start_x + snap_box_w, start_y - 1, start_x + snap_box_w + 1, start_y + snap_box_h + 1, (0, 0, 0))

    # Plot 1: Energy vs time (seriesA)
    p1_x1, p1_y1, p1_x2, p1_y2 = 60, 310, 560, 570
    draw_rect(p1_x1, p1_y1, p1_x2, p1_y2, (245, 245, 248))
    times_log = np.log10(seriesA[0])
    t_min, t_max = np.min(times_log), np.max(times_log)
    e_min, e_max = np.min(seriesA[1]), np.max(seriesA[1])
    pts_e = [(p1_x1 + (t_val - t_min) / (t_max - t_min) * (p1_x2 - p1_x1),
              p1_y2 - (e_val - e_min) / (e_max - e_min) * (p1_y2 - p1_y1))
             for t_val, e_val in zip(times_log, seriesA[1])]
    draw_polyline(pts_e, (30, 80, 200), thickness=2)
    
    # Plot 2: Domain Growth L(t) (seriesB)
    p2_x1, p2_y1, p2_x2, p2_y2 = 640, 310, 1140, 570
    draw_rect(p2_x1, p2_y1, p2_x2, p2_y2, (245, 245, 248))
    L_log = np.log10(seriesB[1])
    l_min, l_max = np.min(L_log), np.max(L_log)
    pts_l = [(p2_x1 + (t_val - t_min) / (t_max - t_min) * (p2_x2 - p2_x1),
              p2_y2 - (l_val - l_min) / (l_max - l_min) * (p2_y2 - p2_y1))
             for t_val, l_val in zip(times_log, L_log)]
    draw_polyline(pts_l, (200, 30, 30), thickness=2)
    
    # Fit line on Plot 2
    fit_t_log = np.log10(np.array(metaB["fit_range"]))
    fit_L_val = np.log10(metaB["amplitude"] * (10.0 ** fit_t_log) ** metaB["exponent"])
    pts_fit = [
        (p2_x1 + (fit_t_log[0] - t_min) / (t_max - t_min) * (p2_x2 - p2_x1),
         p2_y2 - (fit_L_val[0] - l_min) / (l_max - l_min) * (p2_y2 - p2_y1)),
        (p2_x1 + (fit_t_log[1] - t_min) / (t_max - t_min) * (p2_x2 - p2_x1),
         p2_y2 - (fit_L_val[1] - l_min) / (l_max - l_min) * (p2_y2 - p2_y1))
    ]
    draw_polyline(pts_fit, (0, 0, 0), thickness=2)

    # Plot 3: Stack C correlations
    p3_x1, p3_y1, p3_x2, p3_y2 = 60, 620, 560, 870
    draw_rect(p3_x1, p3_y1, p3_x2, p3_y2, (245, 245, 248))
    colors = [(20, 100, 200), (50, 160, 100), (200, 140, 20), (200, 40, 40), (140, 40, 180), (80, 80, 80)]
    for idx, c_curve in enumerate(stackC):
        pts_c = [(p3_x1 + r_idx / (len(c_curve) - 1) * (p3_x2 - p3_x1),
                  p3_y2 - (c_val - (-0.2)) / (1.2 - (-0.2)) * (p3_y2 - p3_y1))
                 for r_idx, c_val in enumerate(c_curve)]
        draw_polyline(pts_c, colors[idx % len(colors)], thickness=2)
        
    # Plot 4: Data Collapse
    p4_x1, p4_y1, p4_x2, p4_y2 = 640, 620, 1140, 870
    draw_rect(p4_x1, p4_y1, p4_x2, p4_y2, (245, 245, 248))
    for idx, rescaled in enumerate(rescaled_curves):
        pts_sc = [(p4_x1 + xi / (len(rescaled) - 1) * (p4_x2 - p4_x1),
                   p4_y2 - (y_val - (-0.2)) / (1.2 - (-0.2)) * (p4_y2 - p4_y1))
                  for xi, y_val in enumerate(rescaled)]
        draw_polyline(pts_sc, colors[idx % len(colors)], thickness=2)

    save_png("figure.png", width, height, canvas)

def run_simulation():
    params, initial_state = load_inputs()
    
    grid_size = int(params["grid_size"])
    control_T = float(params["control"])
    n_steps = int(params["n_steps"])
    max_r = int(params["max_r"])
    seed = int(params["dynamics_seed"])
    
    snapshot_times = [float(t) for t in params["snapshot_times"]]
    measurement_times = [float(t) for t in params["measurement_times"]]
    snapshot_set = set(snapshot_times)
    measurement_set = set(measurement_times)
    
    inv_T = 1.0 / control_T
    rng = np.random.default_rng(seed)
    
    state = initial_state.copy()
    
    mask_A = np.zeros((grid_size, grid_size), dtype=bool)
    mask_A[0::2, 0::2] = True
    mask_A[1::2, 1::2] = True
    mask_B = ~mask_A
    
    n_snapshots = len(snapshot_times)
    stackC = np.zeros((n_snapshots, max_r), dtype=np.float64)
    stackD = np.zeros((n_snapshots, grid_size), dtype=np.float64)
    stackE = np.zeros((n_snapshots, 2, grid_size), dtype=np.float64)
    snapshot_states = []
    
    n_measurements = len(measurement_times)
    meas_times_recorded = []
    meas_energies = []
    meas_lengths = []
    
    snap_idx_map = {t: i for i, t in enumerate(snapshot_times)}
    
    print(f"Starting simulation: L={grid_size}, T={control_T:.4f}, n_steps={n_steps}...")
    
    for step in range(1, n_steps + 1):
        for mask in (mask_A, mask_B):
            nn = (np.roll(state, 1, 0) + np.roll(state, -1, 0) +
                  np.roll(state, 1, 1) + np.roll(state, -1, 1))
            dE = 2 * state[mask] * nn[mask]
            p_acc = np.exp(-dE * inv_T)
            accept = (dE <= 0) | (rng.random(mask.sum()) < p_acc)
            sub = state[mask]
            sub[accept] = -sub[accept]
            state[mask] = sub
            
        t_step = float(step)
        
        if t_step in measurement_set:
            c_rad, _, _ = compute_spatial_correlations(state, max_r)
            l_val = measure_characteristic_length(c_rad)
            e_val = compute_energy_per_spin(state)
            meas_times_recorded.append(t_step)
            meas_energies.append(e_val)
            meas_lengths.append(l_val)
            
        if t_step in snapshot_set:
            c_rad, c_axis, c_axes = compute_spatial_correlations(state, max_r)
            s_idx = snap_idx_map[t_step]
            stackC[s_idx] = c_rad
            stackD[s_idx] = c_axis
            stackE[s_idx] = c_axes
            snapshot_states.append((t_step, state.copy()))
            
    print("Simulation complete.")
    
    seriesA = np.zeros((2, n_measurements), dtype=np.float64)
    seriesA[0, :] = np.array(meas_times_recorded, dtype=np.float64)
    seriesA[1, :] = np.array(meas_energies, dtype=np.float64)
    
    seriesB = np.zeros((2, n_measurements), dtype=np.float64)
    seriesB[0, :] = np.array(meas_times_recorded, dtype=np.float64)
    seriesB[1, :] = np.array(meas_lengths, dtype=np.float64)
    
    t_fit_min = 10.0
    t_fit_max = 700.0
    fit_mask = (seriesB[0] >= t_fit_min) & (seriesB[0] <= t_fit_max)
    log_t = np.log(seriesB[0, fit_mask])
    log_L = np.log(seriesB[1, fit_mask])
    
    reg = linregress(log_t, log_L)
    fitted_exponent = float(reg.slope)
    fitted_std_error = float(reg.stderr)
    fitted_amplitude = float(np.exp(reg.intercept))
    fitted_r2 = float(reg.rvalue ** 2)
    
    metadataB = {
        "exponent": fitted_exponent,
        "exponent_std_error": fitted_std_error,
        "amplitude": fitted_amplitude,
        "fit_range": [t_fit_min, t_fit_max],
        "r_squared": fitted_r2,
        "notes": [
            "Linear regression of log(L) vs log(t) within the coarsening scaling regime [10.0, 700.0].",
            "Consistent with Allen-Cahn / Lifshitz-Allen-Cahn curvature-driven growth law (exponent ~ 0.5 with finite-size corrections)."
        ]
    }
    
    scaling_snapshots = [t for t in snapshot_times if t <= 750.0]
    scaling_indices = [snap_idx_map[t] for t in scaling_snapshots]
    collapse_lengths = [measure_characteristic_length(stackC[i]) for i in scaling_indices]
    
    x_min, x_max = 0.1, 1.8
    n_eval_points = grid_size
    x_eval = np.linspace(x_min, x_max, n_eval_points)
    r_arr = np.arange(max_r, dtype=np.float64)
    
    rescaled_curves = []
    for c_curve, L_scale in zip(stackC[scaling_indices], collapse_lengths):
        f_interp = interp1d(r_arr / L_scale, c_curve, kind="linear", fill_value="extrapolate")
        rescaled_curves.append(f_interp(x_eval))
        
    rescaled_curves = np.array(rescaled_curves)
    mean_rescaled = np.mean(rescaled_curves, axis=0)
    std_rescaled = np.std(rescaled_curves, axis=0)
    rms_spread = float(np.sqrt(np.mean(std_rescaled ** 2)))
    range_y = float(np.ptp(mean_rescaled))
    rel_rms_spread = float(rms_spread / range_y) if range_y > 0 else float(rms_spread)
    
    total_var = float(np.var(rescaled_curves))
    residual_var = float(np.mean(np.var(rescaled_curves, axis=0)))
    collapse_quality = float(np.clip(1.0 - residual_var / total_var, 0.0, 1.0))
    
    metadataA = {
        "collapse_check_applicable": True,
        "collapse_quality": collapse_quality,
        "collapse_relative_rms_spread": rel_rms_spread,
        "collapse_dimension": 2,
        "collapse_snapshot_times": scaling_snapshots,
        "collapse_lengths": collapse_lengths,
        "collapse_x_range": [x_min, x_max],
        "collapse_grid_size": n_eval_points,
        "notes": [
            "Evaluated dynamical scaling collapse C(r, t) = f(r / L(t)) across scaling-regime snapshots.",
            "Later snapshots (t >= 2965) exhibit finite-size saturation as domains reach system boundaries."
        ]
    }
    
    np.save("seriesA.npy", seriesA)
    np.save("seriesB.npy", seriesB)
    np.save("stackC.npy", stackC)
    np.save("stackD.npy", stackD)
    np.save("stackE.npy", stackE)
    
    with open("metadataA.json", "w") as f:
        json.dump(metadataA, f, indent=2)
        
    with open("metadataB.json", "w") as f:
        json.dump(metadataB, f, indent=2)
        
    print("All numeric artifacts saved.")
    
    generate_figure(snapshot_states, seriesA, seriesB, stackC, snapshot_times,
                    metadataA, metadataB, x_eval, rescaled_curves)
    print("Diagnostic figure saved.")

if __name__ == "__main__":
    run_simulation()
