import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf

# 1. Load data
excel_path = 'data/data.xlsx'
df = pd.read_excel(excel_path)

# Filter the 80 valid patient rows (Sequence number 1 to 80)
df_clean = df[df['Sequence number'].notnull()].copy()
df_clean['Age'] = df_clean['Age'].astype(float)

# Treatment response: PR (Group 1) = 1, SD/PD (Group 2) = 0
df_clean['response'] = (df_clean['Groups'] == 1.0).astype(int)

# Verify counts
print("Response counts:")
print(df_clean['response'].value_counts())

# 2. Fit simple logistic regression model
# logit(P(response = 1)) = beta_0 + beta_1 * Age
model = smf.logit('response ~ Age', data=df_clean).fit()

print("\nModel Summary:")
print(model.summary())

# Extract coefficient, std err, z-score, p-value, 95% CI
coef_age = model.params['Age']
se_age = model.bse['Age']
pval_age = model.pvalues['Age']
ci_lower, ci_upper = model.conf_int().loc['Age']

print(f"\nAge Coefficient (log-odds change): {coef_age:.6f}")
print(f"Standard Error: {se_age:.6f}")
print(f"P-value: {pval_age:.6f}")
print(f"95% CI: [{ci_lower:.6f}, {ci_upper:.6f}]")
print(f"Odds Ratio: {np.exp(coef_age):.6f}")

# Also check statsmodels with GLM binomial
glm_model = smf.glm('response ~ Age', data=df_clean, family=sm.families.Binomial()).fit()
print("\nGLM Binomial Summary:")
print(glm_model.summary())
print(f"GLM Age Coefficient: {glm_model.params['Age']:.6f}")
