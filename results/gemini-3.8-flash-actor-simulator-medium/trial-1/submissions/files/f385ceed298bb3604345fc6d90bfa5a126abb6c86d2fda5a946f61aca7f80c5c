#!/usr/bin/env python3
"""
Logistic Regression Analysis of Remission in HCC Cohort
Episode: bixbench:bix-51-q4
Question: What is the change in log-odds of remission for each year increase in
patient age, when using a logistic regression model that includes age, BMI, and
gender as predictors?
"""

import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf
from statsmodels.stats.outliers_influence import variance_inflation_factor

def main():
    # Load dataset
    filepath = 'data/data.xlsx'
    df_raw = pd.read_excel(filepath, sheet_name='Sheet1')

    # Subset valid patient cohort (Sequence numbers 1 to 80)
    df = df_raw[df_raw['Sequence number'].notna()].copy()
    df['Age'] = pd.to_numeric(df['Age'])
    df['BMI'] = pd.to_numeric(df['BMI'])
    df['Gender'] = df['Gender'].astype(str).str.strip()
    
    # Define binary Remission outcome: PR (Partial Remission/Response) = 1, SD/PD = 0
    df['Remission'] = (df['Efficacy'] == 'PR').astype(int)

    print(f"Cohort sample size: N = {len(df)}")
    print("Efficacy breakdown:")
    print(df['Efficacy'].value_counts())
    print("\nRemission outcome distribution (1=PR, 0=SD/PD):")
    print(df['Remission'].value_counts())

    # Fit multivariable logistic regression using statsmodels Logit
    # Reference category for Gender: Female
    formula = 'Remission ~ Age + BMI + C(Gender, Treatment(reference="Female"))'
    model = smf.logit(formula, data=df).fit()

    print("\n" + "="*60)
    print("LOGISTIC REGRESSION MODEL SUMMARY")
    print("="*60)
    print(model.summary())

    # Extract Age coefficient and metrics
    age_coef = model.params['Age']
    age_se = model.bse['Age']
    age_z = model.tvalues['Age']
    age_pval = model.pvalues['Age']
    ci = model.conf_int().loc['Age']
    age_ci_lower, age_ci_upper = ci[0], ci[1]
    
    # Odds ratio
    age_or = np.exp(age_coef)
    age_or_ci_lower = np.exp(age_ci_lower)
    age_or_ci_upper = np.exp(age_ci_upper)

    print("\n" + "="*60)
    print("PRIMARY ESTIMATE FOR AGE")
    print("="*60)
    print(f"Change in log-odds of remission per 1-year increase in age: {age_coef:.6f}")
    print(f"Standard Error: {age_se:.6f}")
    print(f"z-statistic: {age_z:.4f}")
    print(f"p-value: {age_pval:.6f}")
    print(f"95% Confidence Interval for log-odds change: [{age_ci_lower:.6f}, {age_ci_upper:.6f}]")
    print(f"Odds Ratio (per year): {age_or:.4f} (95% CI: [{age_or_ci_lower:.4f}, {age_or_ci_upper:.4f}])")

    # Diagnostics
    print("\n" + "="*60)
    print("MODEL DIAGNOSTICS")
    print("="*60)
    print(f"Convergence status: {model.mle_retvals['converged']}")
    print(f"Number of iterations: {model.mle_retvals['iterations']}")
    print(f"Log-Likelihood: {model.llf:.4f}")
    print(f"Null Log-Likelihood: {model.llnull:.4f}")
    print(f"Pseudo R-squared (McFadden): {model.prsquared:.4f}")
    print(f"Likelihood Ratio test p-value: {model.llr_pvalue:.6f}")

    # Check VIF
    X_vif = sm.add_constant(pd.DataFrame({
        'Age': df['Age'],
        'BMI': df['BMI'],
        'Gender_Male': (df['Gender'] == 'Male').astype(float)
    }))
    vifs = {X_vif.columns[i]: variance_inflation_factor(X_vif.values, i) for i in range(1, X_vif.shape[1])}
    print("Variance Inflation Factors (VIF):")
    for var, vif in vifs.items():
        print(f"  {var}: {vif:.4f}")

if __name__ == '__main__':
    main()
