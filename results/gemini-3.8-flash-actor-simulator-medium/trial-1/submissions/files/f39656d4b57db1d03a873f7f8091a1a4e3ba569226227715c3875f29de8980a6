import pandas as pd
import numpy as np

# Load capital dataset
df = pd.read_csv('data/capital.csv')

# Clean comma decimal numbers
for col in df.columns:
    if col not in ['BCE', 'group', 'color']:
        df[col] = df[col].astype(str).str.replace(',', '.').astype(float)

features = [c for c in df.columns if c.startswith('Z')]
X = df[features].values

# SVD convention aligns PC1 positively with late Bronze Age
X_c = X - np.mean(X, axis=0)
U, S, Vt = np.linalg.svd(X_c, full_matrices=False)
exp_var_c = (S**2) / np.sum(S**2)
loadings_c = pd.DataFrame(Vt[:2].T, index=features, columns=['PC1', 'PC2'])

X_s = (X - np.mean(X, axis=0)) / np.std(X, axis=0, ddof=1)
U_s, S_s, Vt_s = np.linalg.svd(X_s, full_matrices=False)
exp_var_s = (S_s**2) / np.sum(S_s**2)
loadings_s = pd.DataFrame(Vt_s[:2].T, index=features, columns=['PC1', 'PC2'])

print("--- Explained Variance Ratio ---")
print("Centered:     PC1 = {:.2%}, PC2 = {:.2%}".format(exp_var_c[0], exp_var_c[1]))
print("Standardized: PC1 = {:.2%}, PC2 = {:.2%}".format(exp_var_s[0], exp_var_s[1]))

symbolic = ['Zhausgr', 'ZDolch', 'ZAxtSchwert']
print("\n--- Symbolic Capital Components Loadings (Centered) ---")
print(loadings_c.loc[symbolic])

print("\n--- Symbolic Capital Components Loadings (Standardized) ---")
print(loadings_s.loc[symbolic])

print("\n--- All Variables Loadings (Centered) ---")
print(loadings_c)
