# Longitudinal Analysis of Time Preference and BMI using NLSY79
import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf

# Load raw data
df = pd.read_csv('data/nls_raw.csv')

# 1. Height and Weight Cleaning
# 1981 height is in feet * 100 + inches; 1985 height is in inches
h81 = df['Height of respondent, 1981']
h81_in = (h81 // 100) * 12 + (h81 % 100)
h85_in = df['Height of respondent, 1985']
height = h85_in.combine_first(h81_in).where(lambda x: (x >= 48) & (x <= 84))

# Weights are recorded in pounds (filter refusal codes >= 500)
w81 = df['Weight of respondent, 1981'].where(lambda x: (x > 50) & (x < 500))
w89 = df['Weight of respondent, 1989'].where(lambda x: (x > 50) & (x < 500))
w92 = df['Weight of respondent, 1992'].where(lambda x: (x > 50) & (x < 500))

# BMI calculation: (weight / height^2) * 703
df['bmi81'] = (w81 / (height ** 2)) * 703
df['bmi89'] = (w89 / (height ** 2)) * 703
df['bmi92'] = (w92 / (height ** 2)) * 703
df['delta_bmi89'] = df['bmi89'] - df['bmi81']
df['delta_bmi92'] = df['bmi92'] - df['bmi81']

# 2. Time Preference Proxy: 1989 Savings Behavior
cat_map = {1.0: 'Put_more_in', 2.0: 'Took_out', 3.0: 'No_change', 4.0: 'No_savings'}
df['savings_behavior'] = df['Was more money put into or taken out of R/spouse savings since last interview, 1989'].map(cat_map)
df['high_time_pref'] = np.where(df['savings_behavior'].isin(['Took_out', 'No_savings']), 1,
                                np.where(df['savings_behavior'] == 'Put_more_in', 0, np.nan))

# 3. Confounders
df['age89'] = df['Age of respondent at interview date, 1989']
df['female'] = (df['Sex of respondent, 1979'] == 2).astype(int)
df['race_black'] = (df['Racial/ethnic cohort, 1979'] == 1).astype(int)
df['race_hispanic'] = (df['Racial/ethnic cohort, 1979'] == 2).astype(int)

df['mom_edu'] = df["Highest grade completed by respondent's mother, 1979"].where(lambda x: (x >= 0) & (x <= 20))
df['dad_edu'] = df["Highest grade completed by respondent's father, 1979"].where(lambda x: (x >= 0) & (x <= 20))
df['family_size79'] = df['Family size, 1979']

inc89 = df['Total net family income, previous calendar year, 1989'].where(lambda x: (x >= 0) & (x <= 1000000))
df['log_income89'] = np.log(inc89.clip(lower=1))

# Incarceration status
res_cols = [c for c in df.columns if 'Type of residence' in c]
jail_res = (df[res_cols] == 5.0).any(axis=1)
sentenced = (df['Ever been sentenced in any correctional institution before 1980'] == 1.0)
df['ever_incarcerated'] = (jail_res | sentenced).astype(int)

# Academic performance: ASVAB Composite Standardized Score
asvab_cols = [
    'ASVAB - Arithmetic Reasoning Z Score (rounded), 1981',
    'ASVAB - Word Knowledge Z Score (rounded), 1981',
    'ASVAB - Paragraph Comprehension Z Score (rounded), 1981',
    'ASVAB - Mathematics Knowledge Z Score (rounded), 1981'
]
df['asvab_comp'] = df[asvab_cols].mean(axis=1)
df['asvab_std'] = (df['asvab_comp'] - df['asvab_comp'].mean()) / df['asvab_comp'].std()

# School Rank Percentile
rank = df['Rank in class last year attended at this school, 1981']
class_size = df['Number of students in class last year attended at this school, 1981']
df['class_rank_pct'] = np.where((rank.notnull()) & (class_size.notnull()) & (class_size >= rank) & (class_size > 0),
                                1.0 - (rank / class_size), np.nan)

# Secondary proxy: Family net wealth 1990
wealth90 = df['Family net wealth, 1990'].where(lambda x: (x > -500000) & (x < 2000000))
df['wealth90_10k'] = wealth90 / 10000.0

# Print model summaries
formula_base = ' + age89 + female + race_black + race_hispanic + log_income89 + mom_edu + dad_edu + family_size79 + asvab_std + ever_incarcerated'

m1 = smf.ols('bmi89 ~ C(savings_behavior, Treatment(reference="Put_more_in"))', data=df).fit(cov_type='HC1')
m2 = smf.ols('bmi89 ~ C(savings_behavior, Treatment(reference="Put_more_in"))' + formula_base, data=df).fit(cov_type='HC1')
m3 = smf.ols('bmi89 ~ C(savings_behavior, Treatment(reference="Put_more_in")) + bmi81' + formula_base, data=df).fit(cov_type='HC1')
m4 = smf.ols('delta_bmi89 ~ C(savings_behavior, Treatment(reference="Put_more_in"))' + formula_base, data=df).fit(cov_type='HC1')
m5 = smf.ols('bmi92 ~ C(savings_behavior, Treatment(reference="Put_more_in")) + bmi81' + formula_base, data=df).fit(cov_type='HC1')
m6 = smf.ols('bmi89 ~ C(savings_behavior, Treatment(reference="Put_more_in")) + bmi81 + class_rank_pct' + formula_base, data=df).fit(cov_type='HC1')
m7 = smf.ols('bmi89 ~ high_time_pref + bmi81' + formula_base, data=df).fit(cov_type='HC1')

print('All models estimated successfully.')
