import os
import glob
import re
import pandas as pd

def run_analysis():
    # 1. Load canonical CHIP gene list
    chip_genes_file = 'data/230214_Schenz_et_al_2022_CHIP_Genes.xlsx'
    df_chip_genes = pd.read_excel(chip_genes_file, header=None)
    chip_genes_set = set(df_chip_genes[0].dropna().astype(str).str.strip())
    print(f"Loaded {len(chip_genes_set)} canonical CHIP genes from {chip_genes_file}.")

    # 2. Find all variant files
    files = sorted(glob.glob('data/CHIP_DP10_GQ20_PASS/*.xlsx'))
    print(f"Found {len(files)} sample Excel files.")
    assert len(files) == 86, f"Expected 86 files, found {len(files)}"

    all_dfs = []
    for f in files:
        sample_name = re.search(r'230209_Exome_GRCh38_CHIP_(.+)\.xlsx', os.path.basename(f)).group(1)
        df = pd.read_excel(f, header=1)
        df['Sample_ID'] = sample_name
        all_dfs.append(df)

    cohort_df = pd.concat(all_dfs, ignore_index=True)
    print(f"Total variant calls loaded: {len(cohort_df)}")

    # 3. Zygosity inspection
    print("\n--- Zygosity Breakdown (all rows) ---")
    print(cohort_df['Zygosity'].value_counts(dropna=False))

    # Filter out reference calls and uncalled (NaN)
    non_ref_df = cohort_df[cohort_df['Zygosity'].isin(['Heterozygous', 'Homozygous Variant'])].copy()
    print(f"\nNon-reference variant calls (Heterozygous / Homozygous Variant): {len(non_ref_df)}")

    # 4. Gene matching function
    def matches_chip_genes(gene_name_val):
        if not isinstance(gene_name_val, str):
            return False
        # split by comma or semicolon
        symbols = [s.strip() for s in re.split(r'[,;]', gene_name_val)]
        return any(sym in chip_genes_set for sym in symbols)

    non_ref_df['is_canonical_chip'] = non_ref_df['Gene Names'].apply(matches_chip_genes)

    print("\n--- Canonical CHIP Gene Matching ---")
    print(f"Non-reference calls matching canonical CHIP genes: {non_ref_df['is_canonical_chip'].sum()}")
    print(f"Non-reference calls NOT matching canonical CHIP genes: {(~non_ref_df['is_canonical_chip']).sum()}")

    # Non-canonical genes breakdown
    non_canonical = non_ref_df[~non_ref_df['is_canonical_chip']]
    print("\nNon-canonical genes in dataset:")
    print(non_canonical['Gene Names'].value_counts())

    # 5. Sequence Ontology breakdown
    print("\n--- Sequence Ontology breakdown for canonical CHIP non-ref calls ---")
    chip_non_ref = non_ref_df[non_ref_df['is_canonical_chip']].copy()
    print(chip_non_ref['Sequence Ontology (Combined)'].value_counts(dropna=False))

    exonic_ontologies = {
        'synonymous_variant',
        'missense_variant',
        'frameshift_variant',
        'inframe_insertion',
        'inframe_deletion'
    }

    excluded_ontologies = {
        'intron_variant',
        'upstream_gene_variant',
        '3_prime_UTR_variant',
        '5_prime_UTR_variant',
        '5_prime_UTR_premature_start_codon_gain_variant',
        'splice_region_variant'
    }

    exonic_chip_non_ref = chip_non_ref[chip_non_ref['Sequence Ontology (Combined)'].isin(exonic_ontologies)]
    print(f"\nFinal count of strictly exonic non-reference variants in canonical CHIP genes: {len(exonic_chip_non_ref)}")

    print("\nBreakdown of strictly exonic variants in canonical CHIP genes by Sequence Ontology:")
    print(exonic_chip_non_ref['Sequence Ontology (Combined)'].value_counts())

    print("\nBreakdown of strictly exonic variants by Zygosity:")
    print(exonic_chip_non_ref['Zygosity'].value_counts())

    print("\nExonic variants contributed by non-canonical genes (MMACHC, MMAB, SF3B2):")
    non_can_exonic = non_canonical[non_canonical['Sequence Ontology (Combined)'].isin(exonic_ontologies)]
    print(non_can_exonic['Gene Names'].value_counts())
    print(f"Total non-canonical exonic non-reference variants: {len(non_can_exonic)}")

    # Splice region variants in canonical CHIP genes
    splice_chip_non_ref = chip_non_ref[chip_non_ref['Sequence Ontology (Combined)'] == 'splice_region_variant']
    print(f"\nSplice region variants in canonical CHIP genes (all intronic offsets): {len(splice_chip_non_ref)}")

    return len(exonic_chip_non_ref)

if __name__ == '__main__':
    run_analysis()
