"""
Empirical Analysis: Does Increased Time Preference Lead to Higher BMI?
Data: National Longitudinal Survey of Youth 1979 (NLSY79)
"""

import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf

def main():
    # 1. Load raw data
    df = pd.read_csv('data/nls_raw.csv')
    print(f"Total initial observations: {len(df)}")

    # 2. Harmonize height and weight
    feet_81 = df['Height of respondent, 1981'] // 100
    inch_81 = df['Height of respondent, 1981'] % 100
    h81_in = (feet_81 * 12 + inch_81).where((feet_81 * 12 + inch_81 >= 48) & (feet_81 * 12 + inch_81 <= 84))
    h85_in = df['Height of respondent, 1985'].where((df['Height of respondent, 1985'] >= 48) & (df['Height of respondent, 1985'] <= 84))
    df['height_in'] = h85_in.combine_first(h81_in)

    # Clean weight
    df['w81'] = df['Weight of respondent, 1981'].where((df['Weight of respondent, 1981'] >= 60) & (df['Weight of respondent, 1981'] <= 500))
    df['w89'] = df['Weight of respondent, 1989'].replace(996, np.nan).where((df['Weight of respondent, 1989'] >= 60) & (df['Weight of respondent, 1989'] <= 500))

    # Compute BMI
    df['bmi_1981'] = (df['w81'] / (df['height_in']**2)) * 703
    df['bmi_1989'] = (df['w89'] / (df['height_in']**2)) * 703
    df['delta_bmi'] = df['bmi_1989'] - df['bmi_1981']
    df['overweight_1989'] = (df['bmi_1989'] >= 25.0).astype(float).where(df['bmi_1989'].notna())
    df['obese_1989'] = (df['bmi_1989'] >= 30.0).astype(float).where(df['bmi_1989'].notna())

    # Time preference proxy
    savings_raw = df['Was more money put into or taken out of R/spouse savings since last interview, 1989']
    df['savings_cat'] = savings_raw.map({1.0: '1_PutIn', 2.0: '2_TookOut', 3.0: '3_NoChange', 4.0: '4_NoSavings'})

    # Covariates
    df['age_89'] = df['Age of respondent at interview date, 1989']
    df['female'] = (df['Sex of respondent, 1979'] == 2).astype(float)
    df['race_cat'] = df['Racial/ethnic cohort, 1979'].map({1: '1_Black', 2: '2_Hispanic', 3: '3_NonBlackNonHisp'})
    df['educ'] = df['Highest grade completed, 1979']
    df['fam_size'] = df['Family size, 1979']
    df['log_income_89'] = np.log(df['Total net family income, previous calendar year, 1989'].clip(lower=100))

    asvab_cols = [
        'ASVAB - Arithmetic Reasoning Z Score (rounded), 1981',
        'ASVAB - Word Knowledge Z Score (rounded), 1981',
        'ASVAB - Paragraph Comprehension Z Score (rounded), 1981',
        'ASVAB - Mathematics Knowledge Z Score (rounded), 1981'
    ]
    df['asvab_comp'] = df[asvab_cols].mean(axis=1)

    # Core regressions
    # 1. Baseline OLS
    m1 = smf.ols("bmi_1989 ~ C(savings_cat, Treatment('1_PutIn')) + age_89 + female + C(race_cat, Treatment('3_NonBlackNonHisp'))", data=df).fit(cov_type='HC1')
    
    # 2. Extended OLS
    m2 = smf.ols("bmi_1989 ~ C(savings_cat, Treatment('1_PutIn')) + age_89 + female + C(race_cat, Treatment('3_NonBlackNonHisp')) + educ + fam_size + log_income_89 + asvab_comp", data=df).fit(cov_type='HC1')

    # 3. Dynamic Lagged Model (controlling for BMI 1981)
    m3 = smf.ols("bmi_1989 ~ C(savings_cat, Treatment('1_PutIn')) + bmi_1981 + age_89 + female + C(race_cat, Treatment('3_NonBlackNonHisp')) + educ + fam_size + log_income_89 + asvab_comp", data=df).fit(cov_type='HC1')

    # 4. First Difference Model (Delta BMI)
    m4 = smf.ols("delta_bmi ~ C(savings_cat, Treatment('1_PutIn')) + age_89 + female + C(race_cat, Treatment('3_NonBlackNonHisp')) + educ + fam_size + log_income_89 + asvab_comp", data=df).fit(cov_type='HC1')

    # 5. Logit Overweight & Obesity
    m5a = smf.logit("overweight_1989 ~ C(savings_cat, Treatment('1_PutIn')) + age_89 + female + C(race_cat, Treatment('3_NonBlackNonHisp')) + educ + fam_size + log_income_89 + asvab_comp", data=df).fit(disp=False)
    m5b = smf.logit("obese_1989 ~ C(savings_cat, Treatment('1_PutIn')) + age_89 + female + C(race_cat, Treatment('3_NonBlackNonHisp')) + educ + fam_size + log_income_89 + asvab_comp", data=df).fit(disp=False)

    print("All models successfully estimated.")

if __name__ == '__main__':
    main()
