#!/usr/bin/env python3
"""
analysis.py: End-to-end recovery of shared relaxation modes from complex response curves.

Model:
    R_m(x) = a0_m + sum_{k=1..K} a_{k,m} / (1 + (i * x * tau_k)^phi_k)

Shared parameters:
    tau_k > 0, 0 < phi_k <= 1 (k = 1..K)
Curve-specific parameters:
    a0_m >= 0, a_{k,m} >= 0 (m = 0..M-1)

Method:
    Variable Projection (VarPro) with global optimization (Differential Evolution)
    and local refinement (L-BFGS-B). Model order K selected via BIC.
"""

import os
import sys
import numpy as np
import pandas as pd
from scipy.optimize import differential_evolution, minimize, lsq_linear

def load_data(csv_path="data/curves.csv"):
    df = pd.read_csv(csv_path)
    curve_ids = sorted(df['curve'].unique())
    M = len(curve_ids)
    x = df[df['curve'] == curve_ids[0]].sort_values('x')['x'].values
    N = len(x)

    y_vecs = []
    for cid in curve_ids:
        sub = df[df['curve'] == cid].sort_values('x')
        y_vecs.append(np.concatenate([sub['re'].values, sub['im'].values]))

    return x, y_vecs, M, N

def compute_basis(x, tau, phi):
    """
    Constructs stacked real and imaginary design matrix A:
    A in R^{(2N) x (K+1)}, first column for baseline a0, subsequent K columns for modes.
    """
    K = len(tau)
    N = len(x)
    xt = x[:, None] * tau[None, :]
    phase = (np.pi / 2.0) * phi[None, :]
    denom = 1.0 + (xt ** phi[None, :]) * (np.cos(phase) + 1j * np.sin(phase))
    f = 1.0 / denom

    A_re = np.column_stack([np.ones((N, 1)), f.real])
    A_im = np.column_stack([np.zeros((N, 1)), f.imag])
    return np.vstack([A_re, A_im])

def fit_amplitudes(A, y_vec):
    """
    Solve min ||A c - y||^2 s.t. c >= 0.
    Returns c (coefficients [a0, a1, ..., aK]) and residual sum of squares.
    """
    K_plus_1 = A.shape[1]
    res = lsq_linear(A, y_vec, bounds=(0.0, np.inf))
    rss = 2.0 * res.cost
    return res.x, rss

def objective(params, x, y_vecs, K):
    log_tau = params[:K]
    phi = params[K:]
    tau = 10.0 ** log_tau
    A = compute_basis(x, tau, phi)

    total_rss = 0.0
    for y_vec in y_vecs:
        _, rss = fit_amplitudes(A, y_vec)
        total_rss += rss
    return total_rss

def fit_model_for_k(K, x, y_vecs, maxiter=50, popsize=12, seed=42):
    bounds = [(-4.0, 4.0)] * K + [(0.1, 1.0)] * K
    de_res = differential_evolution(
        lambda p: objective(p, x, y_vecs, K),
        bounds=bounds,
        seed=seed,
        maxiter=maxiter,
        popsize=popsize,
        polish=True
    )
    # Refine with L-BFGS-B
    loc_res = minimize(
        lambda p: objective(p, x, y_vecs, K),
        de_res.x,
        method='L-BFGS-B',
        bounds=bounds
    )
    return loc_res.x, loc_res.fun

def main():
    print("Loading data...")
    x, y_vecs, M, N = load_data("data/curves.csv")
    n_data = 2 * N * M
    print(f"Loaded {M} curves with {N} points each ({n_data} total response measurements).")

    print("\n--- Model Order Selection (K=1..5) ---")
    results_by_k = {}
    best_bic = np.inf
    best_k = None

    for K in [1, 2, 3, 4, 5]:
        params, rss = fit_model_for_k(K, x, y_vecs, maxiter=50, popsize=12, seed=42)
        n_params = 2 * K + (K + 1) * M
        bic = n_data * np.log(rss / n_data) + n_params * np.log(n_data)
        sigma = np.sqrt(rss / (n_data - n_params))
        results_by_k[K] = {
            'params': params,
            'rss': rss,
            'bic': bic,
            'sigma': sigma,
            'n_params': n_params
        }
        print(f"K={K:d}: RSS = {rss:8.4f}, residual sigma = {sigma:6.4f}, BIC = {bic:8.2f}")
        if bic < best_bic:
            best_bic = bic
            best_k = K

    print(f"\nOptimal model order selected by BIC: K = {best_k}")

    # For the selected K, run fine polish if needed
    opt_params = results_by_k[best_k]['params']
    final_rss = results_by_k[best_k]['rss']

    log_tau_opt = opt_params[:best_k]
    phi_opt = opt_params[best_k:]
    tau_opt = 10.0 ** log_tau_opt

    # Sort modes by descending tau
    sort_idx = np.argsort(tau_opt)[::-1]
    tau_sorted = tau_opt[sort_idx]
    phi_sorted = phi_opt[sort_idx]

    A_opt = compute_basis(x, tau_sorted, phi_sorted)

    baselines = np.zeros(M)
    amplitudes = np.zeros((best_k, M))

    for m in range(M):
        c, _ = fit_amplitudes(A_opt, y_vecs[m])
        baselines[m] = c[0]
        amplitudes[:, m] = c[1:]

    print("\nRecovered Shared Parameters:")
    for k in range(best_k):
        print(f"  Mode {k+1}: tau = {tau_sorted[k]:.6e}, phi = {phi_sorted[k]:.4f}")

    print("\nRecovered Per-Curve Baselines (a0):")
    for m in range(M):
        print(f"  Curve {m}: a0 = {baselines[m]:.4f}")

    print("\nRecovered Modal Amplitudes (rows: modes, cols: curves):")
    for k in range(best_k):
        row_str = ", ".join([f"{amplitudes[k, m]:.4f}" for m in range(M)])
        print(f"  Mode {k+1} (tau={tau_sorted[k]:.4e}): [{row_str}]")

    # Save results/modes.csv
    os.makedirs("results", exist_ok=True)
    out_csv = "results/modes.csv"

    # Columns: tau, a_0, a_1, ..., a_{M-1}
    col_names = ["tau"] + [f"a_{m}" for m in range(M)]
    data_rows = []
    for k in range(best_k):
        row = [tau_sorted[k]] + list(amplitudes[k, :])
        data_rows.append(row)

    modes_df = pd.DataFrame(data_rows, columns=col_names)
    modes_df.to_csv(out_csv, index=False)
    print(f"\nSaved mode recovery results to {out_csv}")
    print(modes_df.to_string(index=False))

if __name__ == "__main__":
    main()
