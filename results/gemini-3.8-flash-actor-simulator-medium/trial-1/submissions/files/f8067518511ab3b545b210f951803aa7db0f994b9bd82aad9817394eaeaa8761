import pandas as pd
import numpy as np
import json

df = pd.read_csv('data/nls_incarceration_processed.csv')

def gini(x):
    x = np.array(x, dtype=float)
    n = len(x)
    s = np.sort(x)
    index = np.arange(1, n + 1)
    return float((2 * np.sum(index * s) - (n + 1) * np.sum(s)) / (n * np.sum(s)))

results = {}
for sex in ['female', 'male']:
    sub = df[(df['race'] == 'white') & (df['sex'] == sex)]
    results[sex] = {}
    for yr in ['1990', '1996']:
        w = sub[f'composite_wealth_{yr}']
        results[sex][yr] = {
            'N': int(len(w)),
            'mean': round(float(w.mean()), 2),
            'median': round(float(w.median()), 2),
            'std': round(float(w.std()), 2),
            'iqr': round(float(w.quantile(0.75) - w.quantile(0.25)), 2),
            'p10': round(float(w.quantile(0.10)), 2),
            'p25': round(float(w.quantile(0.25)), 2),
            'p50': round(float(w.quantile(0.50)), 2),
            'p75': round(float(w.quantile(0.75)), 2),
            'p90': round(float(w.quantile(0.90)), 2),
            'p99': round(float(w.quantile(0.99)), 2),
            'p90_p50': round(float(w.quantile(0.90) / w.quantile(0.50)), 2),
            'mean_to_med': round(float(w.mean() / w.median()), 2),
            'gini': round(gini(w), 4),
            'zero_pct': round(float((w == 0).mean() * 100), 2),
            'neg_pct': round(float((w < 0).mean() * 100), 2),
            'pos_pct': round(float((w > 0).mean() * 100), 2),
            'top10_share_pct': round(float(w[w >= w.quantile(0.90)].sum() / w.sum() * 100), 2),
            'top20_share_pct': round(float(w[w >= w.quantile(0.80)].sum() / w.sum() * 100), 2)
        }

with open('inequality_summary.json', 'w') as f:
    json.dump(results, f, indent=2)

print("Analysis executed successfully.")
print(json.dumps(results, indent=2))
