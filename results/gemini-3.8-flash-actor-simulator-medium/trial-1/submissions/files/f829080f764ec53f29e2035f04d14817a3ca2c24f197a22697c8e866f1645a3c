import pandas as pd

def run_analysis():
    data_path = 'data/meta-regression_study_data_heterogeneity_in_replication_projects.csv'
    df = pd.read_csv(data_path)
    
    disciplines = ['Social', 'Cognitive', 'Economics']
    summary_rows = []
    
    for disc in disciplines:
        sub = df[df['discipline'] == disc]
        # Study-level deduplication by original title
        u = sub.drop_duplicates(subset=['title'], keep='last')
        n_studies = len(u)
        
        orig_stud_cnt = (u['subjects.o'] == 'students').sum()
        orig_stud_pct = (orig_stud_cnt / n_studies) * 100
        
        rep_stud_cnt = (u['subjects.r'] == 'students').sum()
        rep_stud_pct = (rep_stud_cnt / n_studies) * 100
        
        summary_rows.append({
            'Discipline': disc,
            'Unique Studies (N)': n_studies,
            'Original Students (N)': orig_stud_cnt,
            'Original Students (%)': round(orig_stud_pct, 1),
            'Replication Students (N)': rep_stud_cnt,
            'Replication Students (%)': round(rep_stud_pct, 1)
        })
        
    summary_df = pd.DataFrame(summary_rows)
    print(summary_df.to_string(index=False))
    return summary_df

if __name__ == '__main__':
    run_analysis()
