import pandas as pd
import numpy as np
import scipy.stats as stats
import statsmodels.api as sm
import statsmodels.formula.api as smf

def main():
    # 1. Load data
    file_path = 'data/data.xlsx'
    df_raw = pd.read_excel(file_path)
    
    # Filter valid 80 rows (dropping empty trailing Excel rows 80-120)
    df = df_raw.iloc[:80].copy()
    
    # Clean column names
    df.columns = [c.strip().replace(' ', '_').replace('-', '_') for c in df.columns]
    
    # 2. Preprocess variables
    df['Age'] = df['Age'].astype(float)
    # Binary treatment response: Group 1 (PR, responders) = 1, Group 2 (SD/PD, non-responders) = 0
    df['response'] = (df['Groups'] == 1.0).astype(int)
    
    print(f"Cohort size: {len(df)}")
    print(f"Responders (PR, Group 1): {df['response'].sum()}")
    print(f"Non-responders (PD/SD, Group 2): {(1 - df['response']).sum()}")
    print(f"BMI summary: mean={df['BMI'].mean():.2f}, std={df['BMI'].std():.2f}, min={df['BMI'].min():.1f}, max={df['BMI'].max():.1f}")
    
    # 3. Univariable Logistic Regression: response ~ BMI
    model_uni = smf.logit('response ~ BMI', data=df).fit()
    print("\n=== Univariable Logistic Regression ===")
    print(model_uni.summary())
    
    bmi_coef = model_uni.params['BMI']
    bmi_se = model_uni.bse['BMI']
    bmi_z = model_uni.tvalues['BMI']
    bmi_wald_pval = model_uni.pvalues['BMI']
    odds_ratio = np.exp(bmi_coef)
    ci_lower, ci_upper = np.exp(model_uni.conf_int().loc['BMI'])
    
    # Likelihood Ratio Test (LRT)
    null_model = smf.logit('response ~ 1', data=df).fit(disp=False)
    lrt_stat = -2 * (null_model.llf - model_uni.llf)
    lrt_pval = stats.chi2.sf(lrt_stat, df=1)
    
    print(f"\nBMI Wald test statistic (z): {bmi_z:.4f}")
    print(f"BMI Wald p-value: {bmi_wald_pval:.6f} (rounded 3 decimals: {bmi_wald_pval:.3f}, 4 decimals: {bmi_wald_pval:.4f})")
    print(f"BMI Odds Ratio (95% CI): {odds_ratio:.4f} ({ci_lower:.4f} - {ci_upper:.4f})")
    print(f"LRT statistic: {lrt_stat:.4f}, LRT p-value: {lrt_pval:.6f} (rounded 3 decimals: {lrt_pval:.3f})")
    
    # 4. Multivariable Logistic Regression (for robustness)
    formula_multi = (
        'response ~ BMI + Age + C(Gender) + C(Family_history) + '
        'C(ECOG_PS) + C(Child_Pugh) + C(Chemotherapy_experience) + C(HBV_infection)'
    )
    model_multi = smf.logit(formula_multi, data=df).fit(disp=False)
    print("\n=== Multivariable Logistic Regression ===")
    print(model_multi.summary())
    print(f"Multivariable BMI Wald p-value: {model_multi.pvalues['BMI']:.6f} (rounded: {model_multi.pvalues['BMI']:.3f})")

if __name__ == '__main__':
    main()
