import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf
from scipy import stats

def run_analysis():
    # Load dataset
    df = pd.read_csv('data/invaded_niche_pathways.csv', sep='\t')
    df.columns = [c.replace('.', '_') for c in df.columns]
    
    pathways = ['n_gard', 'n_unint', 'n_agfo']
    urban_vars = [c for c in df.columns if c.startswith('urban_')]
    
    # 1. Univariate models
    uni_res = []
    for p in pathways:
        for u in urban_vars:
            poi = smf.glm(f'{p} ~ {u}', data=df, family=sm.families.Poisson()).fit()
            nb = smf.glm(f'{p} ~ {u}', data=df, family=sm.families.NegativeBinomial()).fit()
            uni_res.append({
                'pathway': p,
                'urban_var': u,
                'poi_coef': poi.params[u],
                'poi_se': poi.bse[u],
                'poi_p': poi.pvalues[u],
                'poi_aic': poi.aic,
                'nb_coef': nb.params[u],
                'nb_se': nb.bse[u],
                'nb_p': nb.pvalues[u],
                'nb_aic': nb.aic
            })
    uni_df = pd.DataFrame(uni_res)
    uni_df.to_csv('univariate_models_summary.csv', index=False)
    print("Univariate models exported successfully.")
    
    # 2. Hurdle models (Presence/Absence Logistic Regression)
    hurdle_res = []
    for p in pathways:
        df[f'{p}_pres'] = (df[p] > 0).astype(int)
        for u in ['urban_2009_50m', 'urban_2009_500m', 'urban_2009_1000m']:
            logit = smf.logit(f'{p}_pres ~ {u}', data=df).fit(disp=False)
            hurdle_res.append({
                'pathway': p,
                'urban_var': u,
                'logit_coef': logit.params[u],
                'logit_se': logit.bse[u],
                'logit_p': logit.pvalues[u],
                'pseudo_r2': logit.prsquared,
                'aic': logit.aic
            })
    hurdle_df = pd.DataFrame(hurdle_res)
    hurdle_df.to_csv('hurdle_step1_summary.csv', index=False)
    print("Hurdle step 1 exported successfully.")

    # 3. Multivariate Models controlling for covariates
    multi_res = []
    covs = 'elevation + distance_road + distance_stream'
    for p in pathways:
        nb_full = smf.glm(f'{p} ~ urban_2009_500m + {covs}', data=df, family=sm.families.NegativeBinomial()).fit()
        logit_full = smf.logit(f'{p}_pres ~ urban_2009_500m + {covs}', data=df).fit(disp=False)
        for var in ['Intercept', 'urban_2009_500m', 'elevation', 'distance_road', 'distance_stream']:
            multi_res.append({
                'pathway': p,
                'variable': var,
                'nb_coef': nb_full.params[var],
                'nb_se': nb_full.bse[var],
                'nb_p': nb_full.pvalues[var],
                'logit_coef': logit_full.params[var],
                'logit_se': logit_full.bse[var],
                'logit_p': logit_full.pvalues[var]
            })
    multi_df = pd.DataFrame(multi_res)
    multi_df.to_csv('multivariate_models_summary.csv', index=False)
    print("Multivariate models exported successfully.")

if __name__ == '__main__':
    run_analysis()
