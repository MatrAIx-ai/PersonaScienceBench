import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf
from scipy import stats

# 1. Load data
df = pd.read_csv('data/nls_raw.csv')
print(f"Total raw observations: {len(df)}")

# 2. Process Height
# 1981 height is in FII format (Feet * 100 + Inches)
h1981_in = (df['Height of respondent, 1981'] // 100) * 12 + (df['Height of respondent, 1981'] % 100)
# 1985 height is in inches
h1985_in = df['Height of respondent, 1985']

# Adult height: use 1985 when available, fallback to 1981
df['height_in'] = h1985_in.fillna(h1981_in)
# Valid biological height range: 48 to 84 inches (4 to 7 feet)
df.loc[(df['height_in'] < 48) | (df['height_in'] > 84), 'height_in'] = np.nan

# 3. Process Weight & BMI
# Clean weights: remove known missing/error codes (e.g. >= 900 lbs, or < 60 lbs)
for yr in [1981, 1989, 1992]:
    w_col = f'Weight of respondent, {yr}'
    clean_w = df[w_col].copy()
    clean_w.loc[(clean_w < 60) | (clean_w > 600)] = np.nan
    df[f'weight_{yr}'] = clean_w
    # BMI = 703 * weight_lbs / (height_in ** 2)
    bmi = 703 * clean_w / (df['height_in'] ** 2)
    # Biological plausibility: 14 to 65
    bmi.loc[(bmi < 14) | (bmi > 65)] = np.nan
    df[f'bmi_{yr}'] = bmi

print("BMI summary statistics:")
for yr in [1981, 1989, 1992]:
    b = df[f'bmi_{yr}'].dropna()
    print(f"BMI {yr}: N={len(b)}, mean={b.mean():.2f}, sd={b.std():.2f}, median={b.median():.2f}, IQR={b.quantile(0.75)-b.quantile(0.25):.2f}")

# 4. Operationalize Time Preference (Savings Behavior 1989)
# 1: PUT MORE MONEY IN (Patient / Low Time Preference) - Reference
# 2: TOOK MORE MONEY OUT (Moderate-High Time Preference)
# 3: NO CHANGE (Moderate Time Preference)
# 4: NO SAVINGS (High Time Preference / Impatient)
sav_col = 'Was more money put into or taken out of R/spouse savings since last interview, 1989'
df['savings_cat'] = df[sav_col]

# Net savings continuous metric
# Net amount put in minus net amount taken out
put_in = df['Net amount respondent/spouse put into savings since last interview, 1989'].fillna(0)
took_out = df['Net amount respondent/spouse took out of savings since last interview, 1989'].fillna(0)
df['net_savings_1989'] = np.nan
# For those with valid savings_cat
valid_sav = df['savings_cat'].notnull()
df.loc[valid_sav & (df['savings_cat'] == 1), 'net_savings_1989'] = put_in
df.loc[valid_sav & (df['savings_cat'] == 2), 'net_savings_1989'] = -took_out
df.loc[valid_sav & (df['savings_cat'] == 3), 'net_savings_1989'] = 0
df.loc[valid_sav & (df['savings_cat'] == 4), 'net_savings_1989'] = 0

# Binary proxy: High Time Preference (No savings or took out = 1, vs put in/no change = 0)
df['high_time_pref'] = np.where(df['savings_cat'].isin([2, 4]), 1, np.where(df['savings_cat'].isin([1, 3]), 0, np.nan))

# Also define ordinal Time Preference index (1 = Put in, 2 = No change, 3 = Took out, 4 = No savings)
df['time_pref_scale'] = df['savings_cat'].map({1: 1, 3: 2, 2: 3, 4: 4})

# 5. Controls
df['age_1989'] = df['Age of respondent at interview date, 1989']
df['sex'] = df['Sex of respondent, 1979'] # 1: Male, 2: Female
df['female'] = (df['sex'] == 2).astype(int)
df['race'] = df['Racial/ethnic cohort, 1979'] # 1: Black, 2: Hispanic, 3: Non-Black/Non-Hispanic
df['education'] = df['Highest grade completed, 1979']
df['income_1989'] = df['Total net family income, previous calendar year, 1989']
df['log_income_1989'] = np.log(df['income_1989'].clip(lower=100))

# ASVAB cognitive score composite (average of available z-scores)
asvab_cols = [
    'ASVAB - Arithmetic Reasoning Z Score (rounded), 1981',
    'ASVAB - Word Knowledge Z Score (rounded), 1981',
    'ASVAB - Paragraph Comprehension Z Score (rounded), 1981',
    'ASVAB - Mathematics Knowledge Z Score (rounded), 1981'
]
df['asvab_composite'] = df[asvab_cols].mean(axis=1)

# Incarceration indicator: any residence == 5 (jail) up to 1989, or sentenced/convicted before 1980
res_cols_to_89 = [f'Type of residence respondent is living in, {yr}' for yr in range(1981, 1990)]
jail_any = (df[res_cols_to_89] == 5).any(axis=1)
sentenced = (df['Ever been sentenced in any correctional institution before 1980'] == 1)
convicted = (df['Ever convicted of an illegal act in adult court before 1980'] == 1)
df['ever_incarcerated'] = (jail_any | sentenced | convicted).astype(int)

# Family size
df['family_size'] = df['Family size, 1979']

# Wealth 1985 (prior to 1989 savings)
df['net_wealth_1985'] = df['Family net wealth, 1985']

print(f"\nIncarceration flag count: {df['ever_incarcerated'].sum()}")

# 6. Statistical Comparisons by Savings Category
print("\n--- Descriptive comparison: BMI by 1989 Savings Category ---")
for cat, desc in [(1, '1: Put More In'), (2, '2: Took Out'), (3, '3: No Change'), (4, '4: No Savings')]:
    sub89 = df.loc[df['savings_cat'] == cat, 'bmi_1989'].dropna()
    sub92 = df.loc[df['savings_cat'] == cat, 'bmi_1992'].dropna()
    print(f"Group {desc}:")
    print(f"  1989 BMI: N={len(sub89)}, Mean={sub89.mean():.3f} (SD={sub89.std():.3f}), Median={sub89.median():.3f}")
    print(f"  1992 BMI: N={len(sub92)}, Mean={sub92.mean():.3f} (SD={sub92.std():.3f}), Median={sub92.median():.3f}")

# ANOVA and Kruskal-Wallis
groups_89 = [df.loc[df['savings_cat'] == c, 'bmi_1989'].dropna() for c in [1, 2, 3, 4]]
f_val_89, f_p_89 = stats.f_oneway(*groups_89)
kw_val_89, kw_p_89 = stats.kruskal(*groups_89)
print(f"\nANOVA 1989: F={f_val_89:.4f}, p={f_p_89:.4e}")
print(f"Kruskal-Wallis 1989: H={kw_val_89:.4f}, p={kw_p_89:.4e}")

groups_92 = [df.loc[df['savings_cat'] == c, 'bmi_1992'].dropna() for c in [1, 2, 3, 4]]
f_val_92, f_p_92 = stats.f_oneway(*groups_92)
kw_val_92, kw_p_92 = stats.kruskal(*groups_92)
print(f"ANOVA 1992: F={f_val_92:.4f}, p={f_p_92:.4e}")
print(f"Kruskal-Wallis 1992: H={kw_val_92:.4f}, p={kw_p_92:.4e}")

# 7. Regressions: OLS BMI 1989
print("\n=================== MODEL 1: OLS BMI 1989 (Categorical Time Preference) ===================")
m1 = smf.ols('bmi_1989 ~ C(savings_cat, Treatment(reference=1)) + age_1989 + female + C(race) + education + log_income_1989 + asvab_composite + ever_incarcerated', data=df).fit()
print(m1.summary())

print("\n=================== MODEL 2: ANCOVA BMI 1989 controlling for Baseline BMI 1981 ===================")
m2 = smf.ols('bmi_1989 ~ bmi_1981 + C(savings_cat, Treatment(reference=1)) + age_1989 + female + C(race) + education + log_income_1989 + asvab_composite + ever_incarcerated', data=df).fit()
print(m2.summary())

print("\n=================== MODEL 3: Longitudinal OLS BMI 1992 ===================")
m3 = smf.ols('bmi_1992 ~ C(savings_cat, Treatment(reference=1)) + age_1989 + female + C(race) + education + log_income_1989 + asvab_composite + ever_incarcerated', data=df).fit()
print(m3.summary())

print("\n=================== MODEL 4: Longitudinal ANCOVA BMI 1992 controlling for Baseline BMI 1981 ===================")
m4 = smf.ols('bmi_1992 ~ bmi_1981 + C(savings_cat, Treatment(reference=1)) + age_1989 + female + C(race) + education + log_income_1989 + asvab_composite + ever_incarcerated', data=df).fit()
print(m4.summary())

print("\n=================== MODEL 5: Ordinal Time Preference Scale on BMI 1989 & 1992 ===================")
m5a = smf.ols('bmi_1989 ~ time_pref_scale + age_1989 + female + C(race) + education + log_income_1989 + asvab_composite + ever_incarcerated', data=df).fit()
print("Model 5a (1989, Ordinal Scale):")
print(m5a.summary().tables[1])

m5b = smf.ols('bmi_1989 ~ bmi_1981 + time_pref_scale + age_1989 + female + C(race) + education + log_income_1989 + asvab_composite + ever_incarcerated', data=df).fit()
print("\nModel 5b (1989 ANCOVA, Ordinal Scale):")
print(m5b.summary().tables[1])

m5c = smf.ols('bmi_1992 ~ bmi_1981 + time_pref_scale + age_1989 + female + C(race) + education + log_income_1989 + asvab_composite + ever_incarcerated', data=df).fit()
print("\nModel 5c (1992 ANCOVA, Ordinal Scale):")
print(m5c.summary().tables[1])

print("\n=================== MODEL 6: Binary High Time Preference (No Savings / Dissaving vs Saving) ===================")
m6a = smf.ols('bmi_1989 ~ bmi_1981 + high_time_pref + age_1989 + female + C(race) + education + log_income_1989 + asvab_composite + ever_incarcerated', data=df).fit()
print("Model 6a (1989 ANCOVA Binary):")
print(m6a.summary().tables[1])

m6b = smf.ols('bmi_1992 ~ bmi_1981 + high_time_pref + age_1989 + female + C(race) + education + log_income_1989 + asvab_composite + ever_incarcerated', data=df).fit()
print("\nModel 6b (1992 ANCOVA Binary):")
print(m6b.summary().tables[1])

