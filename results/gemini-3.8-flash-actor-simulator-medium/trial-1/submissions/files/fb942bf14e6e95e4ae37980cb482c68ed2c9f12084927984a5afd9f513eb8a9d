import glob
import os
import re
import pandas as pd

def run_analysis():
    data_dir = "data/CHIP_DP10_GQ20_PASS"
    files = sorted(glob.glob(os.path.join(data_dir, "*.xlsx")))
    print(f"Found {len(files)} sample files in {data_dir}.")

    all_dfs = []
    for f in files:
        sample_name = os.path.basename(f).replace("230209_Exome_GRCh38_CHIP_", "").replace(".xlsx", "")
        # Read file with header at row 1 (0-indexed row 1 is the column names)
        df = pd.read_excel(f, header=1)
        zyg_col = [c for c in df.columns if "Zygosity" in str(c)][0]
        
        df_sub = df[["Chr:Pos", "Ref/Alt", zyg_col, "In_CHIP", "Gene Names"]].copy()
        df_sub.rename(columns={zyg_col: "Zygosity"}, inplace=True)
        df_sub["Sample"] = sample_name
        all_dfs.append(df_sub)

    combined_df = pd.concat(all_dfs, ignore_index=True)
    total_calls = len(combined_df)
    print(f"Total genotype records across all samples: {total_calls}")

    # Unique variants defined by Chr:Pos and Ref/Alt
    combined_df["Variant_Key"] = combined_df["Chr:Pos"].astype(str) + "_" + combined_df["Ref/Alt"].astype(str)
    total_unique_variants = combined_df["Variant_Key"].nunique()
    print(f"Total unique candidate CHIP variants across all samples: {total_unique_variants}")

    # Breakdown of zygosity calls
    zyg_counts = combined_df["Zygosity"].value_counts(dropna=False)
    print("\nGlobal Zygosity distribution across all records:")
    for k, v in zyg_counts.items():
        print(f"  {k}: {v} ({v / total_calls * 100:.2f}%)")

    num_ref_calls = (combined_df["Zygosity"] == "Reference").sum()
    num_het_calls = (combined_df["Zygosity"] == "Heterozygous").sum()
    num_hom_calls = (combined_df["Zygosity"] == "Homozygous Variant").sum()
    num_nan_calls = combined_df["Zygosity"].isna().sum()

    # 1. Calls remaining after removing Reference calls
    # Strict removal of Zygosity == 'Reference':
    remaining_calls_with_nan = total_calls - num_ref_calls
    # Remaining calls with actual alternative genotype (Het + Hom):
    remaining_calls_alt_only = num_het_calls + num_hom_calls

    print("\n--- Call-level (Record-level) Metrics ---")
    print(f"Total records before filtering: {total_calls}")
    print(f"Reference calls removed (Zygosity == 'Reference'): {num_ref_calls}")
    print(f"Records remaining after removing Reference calls (including NaN uncalled): {remaining_calls_with_nan}")
    print(f"Records remaining with confirmed alternative calls (Heterozygous + Homozygous Variant): {remaining_calls_alt_only}")

    # 2. Unique variant-level Metrics
    # How many unique variants have at least one non-reference call?
    df_no_ref = combined_df[combined_df["Zygosity"] != "Reference"]
    unique_variants_no_ref = df_no_ref["Variant_Key"].nunique()

    # How many unique variants have at least one confirmed alternative allele call (Het or Hom)?
    df_alt = combined_df[combined_df["Zygosity"].isin(["Heterozygous", "Homozygous Variant"])]
    unique_variants_alt = df_alt["Variant_Key"].nunique()

    # Variants with only Reference calls
    var_summary = combined_df.groupby("Variant_Key")["Zygosity"].value_counts(dropna=False).unstack(fill_value=0)
    has_het = var_summary.get("Heterozygous", 0) > 0
    has_hom = var_summary.get("Homozygous Variant", 0) > 0
    has_alt = has_het | has_hom
    num_vars_no_alt = (~has_alt).sum()

    print("\n--- Unique Genomic Variant-level Metrics ---")
    print(f"Total unique variants evaluated in cohort: {total_unique_variants}")
    print(f"Unique variants with at least one alternative call (Het or Hom): {unique_variants_alt}")
    print(f"Unique variants with no alternative calls in any sample (only Ref and/or NaN): {num_vars_no_alt}")
    print(f"Unique variants with at least one non-Reference record (including NaN): {unique_variants_no_ref}")

    print("\n--- Summary Answers ---")
    print(f"Variant-level answer: {unique_variants_alt} unique CHIP variants remain after removing reference calls.")
    print(f"Call-level answer: {remaining_calls_with_nan} calls remain (or {remaining_calls_alt_only} confirmed alt calls).")

if __name__ == "__main__":
    run_analysis()
