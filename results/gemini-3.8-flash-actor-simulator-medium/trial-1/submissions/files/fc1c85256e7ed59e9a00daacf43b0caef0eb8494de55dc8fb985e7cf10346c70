import pandas as pd
import numpy as np
from scipy import stats
import statsmodels.formula.api as smf

df = pd.read_csv('data/nls_incarceration_processed.csv')

years = ['1985', '1990', '1996']
print("=== NLS INCARCERATION WEALTH ANALYSIS ===")
for y in years:
    col = f'composite_wealth_{y}'
    g0 = df[df['ever_jailed'] == 0][col]
    g1 = df[df['ever_jailed'] == 1][col]
    
    ttest = stats.ttest_ind(g0, g1, equal_var=False)
    mwu = stats.mannwhitneyu(g0, g1, alternative='two-sided')
    ols_unadj = smf.ols(f'{col} ~ ever_jailed', data=df).fit()
    ols_adj = smf.ols(f'{col} ~ ever_jailed + C(race) + C(sex)', data=df).fit()
    q_unadj = smf.quantreg(f'{col} ~ ever_jailed', df).fit(q=0.5)
    q_adj = smf.quantreg(f'{col} ~ ever_jailed + C(race) + C(sex)', df).fit(q=0.5)
    
    print(f"\n--- YEAR {y} ---")
    print(f"Group 0 (No jail): N={len(g0)}, Mean={g0.mean():.2f}, Median={g0.median():.2f}")
    print(f"Group 1 (Jailed):  N={len(g1)}, Mean={g1.mean():.2f}, Median={g1.median():.2f}")
    print(f"Welch t-test: t={ttest.statistic:.4f}, p={ttest.pvalue:.4e}")
    print(f"Mann-Whitney U: U={mwu.statistic:.1f}, p={mwu.pvalue:.4e}")
    print(f"OLS unadjusted: beta={ols_unadj.params['ever_jailed']:.2f}, SE={ols_unadj.bse['ever_jailed']:.2f}, 95% CI=[{ols_unadj.conf_int().loc['ever_jailed'][0]:.2f}, {ols_unadj.conf_int().loc['ever_jailed'][1]:.2f}], p={ols_unadj.pvalues['ever_jailed']:.4e}")
    print(f"OLS adjusted (race, sex): beta={ols_adj.params['ever_jailed']:.2f}, SE={ols_adj.bse['ever_jailed']:.2f}, 95% CI=[{ols_adj.conf_int().loc['ever_jailed'][0]:.2f}, {ols_adj.conf_int().loc['ever_jailed'][1]:.2f}], p={ols_adj.pvalues['ever_jailed']:.4e}")
    print(f"Quantreg unadjusted: beta={q_unadj.params['ever_jailed']:.2f}, p={q_unadj.pvalues['ever_jailed']:.4e}")
    print(f"Quantreg adjusted (race, sex): beta={q_adj.params['ever_jailed']:.2f}, p={q_adj.pvalues['ever_jailed']:.4e}")
