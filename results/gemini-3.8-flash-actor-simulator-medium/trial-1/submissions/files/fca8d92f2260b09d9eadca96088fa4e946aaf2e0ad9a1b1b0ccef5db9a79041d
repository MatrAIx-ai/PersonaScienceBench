"""
Comparative analysis of education expenditure effects on per capita GDP/GNI:
Lower Middle Income Countries (LMC) vs Sub-Saharan Africa (SSF).
"""

import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf

def load_and_preprocess(filepath='data/worldbank_education_gdp.csv'):
    df = pd.read_csv(filepath)
    id_vars = ['Country Group', 'Country Code', 'Series Name', 'Series Code']
    melted = df.melt(id_vars=id_vars, var_name='Year', value_name='Value')
    melted['Year'] = melted['Year'].apply(lambda x: int(x.split()[0]))
    melted['Value'] = pd.to_numeric(melted['Value'].replace('..', np.nan), errors='coerce')
    
    panel = melted.pivot(index=['Country Group', 'Country Code', 'Year'], 
                         columns='Series Code', values='Value').reset_index()
    rename_dict = {
        'NY.GNP.PCAP.KD': 'gni_pc',
        'NY.ADJ.AEDU.GN.ZS': 'edu_exp_pct',
        'NE.EXP.GNFS.KD.ZG': 'exports_growth',
        'SE.PRM.ENRR': 'prm_enroll',
        'SE.SEC.ENRR': 'sec_enroll',
        'SL.TLF.CACT.ZS': 'labor_force'
    }
    panel = panel.rename(columns=rename_dict)
    panel['is_ssa'] = (panel['Country Code'] == 'SSF').astype(int)
    panel['log_gni_pc'] = np.log(panel['gni_pc'])
    panel['log_edu_exp'] = np.log(panel['edu_exp_pct'])
    panel['log_prm_enroll'] = np.log(panel['prm_enroll'])
    panel['log_sec_enroll'] = np.log(panel['sec_enroll'])
    panel['edu_exp_pc'] = (panel['edu_exp_pct'] / 100.0) * panel['gni_pc']
    panel['log_edu_exp_pc'] = np.log(panel['edu_exp_pc'])
    return panel

def main():
    panel = load_and_preprocess()
    
    # 1. 2011-2015 joint window models
    sub = panel[(panel['Year'] >= 2011) & (panel['Year'] <= 2015)].copy()
    
    m_semilog = smf.ols('log_gni_pc ~ edu_exp_pct * is_ssa', data=sub).fit()
    m_loglog = smf.ols('log_gni_pc ~ log_edu_exp * is_ssa', data=sub).fit()
    m_lin = smf.ols('gni_pc ~ edu_exp_pct * is_ssa', data=sub).fit()
    m_ctrl = smf.ols('log_gni_pc ~ edu_exp_pct * is_ssa + exports_growth', data=sub).fit()
    m_real_pc = smf.ols('log_gni_pc ~ log_edu_exp_pc * is_ssa', data=sub).fit()
    m_real_lin = smf.ols('gni_pc ~ edu_exp_pc * is_ssa', data=sub).fit()
    
    print("=== Joint Window Regressions (2011-2015) ===")
    print("Semi-log:\n", m_semilog.summary().tables[1])
    print("\nLog-Log:\n", m_loglog.summary().tables[1])
    print("\nReal Per Capita Spending Elasticity:\n", m_real_pc.summary().tables[1])
    
    # 2. Transmission channel (1975-2015)
    m_sec = smf.ols('sec_enroll ~ edu_exp_pct * is_ssa', data=panel).fit()
    m_prm = smf.ols('prm_enroll ~ edu_exp_pct * is_ssa', data=panel).fit()
    print("\n=== Secondary Enrollment Transmission (1975-2015) ===")
    print(m_sec.summary().tables[1])
    
    # 3. LMC Long run human capital to GNI
    lmc = panel[panel['Country Code'] == 'LMC']
    m_lmc_growth = smf.ols('log_gni_pc ~ log_sec_enroll', data=lmc).fit()
    print("\n=== LMC Long-run Secondary Enrollment to GNI ===")
    print(m_lmc_growth.summary().tables[1])

if __name__ == '__main__':
    main()
