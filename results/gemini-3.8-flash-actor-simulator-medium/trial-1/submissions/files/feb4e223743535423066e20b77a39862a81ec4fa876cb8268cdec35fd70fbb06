import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf

def main():
    # Load data
    df_raw = pd.read_excel('data/data.xlsx')
    
    # Filter valid patients
    df = df_raw[df_raw['Sequence number'].notna()].copy()
    df['Age'] = df['Age'].astype(float)
    df['Sequence number'] = df['Sequence number'].astype(int)
    
    print(f"Number of valid observations: {len(df)}")
    
    # 1. Primary Model:
    # Camrelizumab treatment response:
    # Responders (PR, Group 1) = 1, Non-responders (SD + PD, Group 2) = 0
    df['response'] = (df['Groups'] == 1.0).astype(int)
    
    X = sm.add_constant(df['Age'])
    y = df['response']
    
    model = sm.Logit(y, X).fit()
    print("\n--- Primary Logistic Regression Model (Response = PR = 1 vs SD+PD = 0) ---")
    print(model.summary())
    
    age_coef = model.params['Age']
    age_se = model.bse['Age']
    age_pval = model.pvalues['Age']
    age_ci = model.conf_int().loc['Age']
    or_val = np.exp(age_coef)
    or_ci = np.exp(age_ci)
    
    print(f"\nAge Coefficient (log-odds): {age_coef:.6f}")
    print(f"Age Standard Error: {age_se:.6f}")
    print(f"Age z-statistic: {model.tvalues['Age']:.6f}")
    print(f"Age p-value: {age_pval:.6e}")
    print(f"95% CI: [{age_ci[0]:.6f}, {age_ci[1]:.6f}]")
    print(f"Odds Ratio (OR): {or_val:.6f}")
    print(f"OR 95% CI: [{or_ci[0]:.6f}, {or_ci[1]:.6f}]")

    # 2. Alternative Model: Group 2 = 1, Group 1 = 0
    df['response_alt'] = (df['Groups'] == 2.0).astype(int)
    model_alt = sm.Logit(df['response_alt'], X).fit()
    print("\n--- Alternative Coding (Group 2 = 1 vs Group 1 = 0) ---")
    print(f"Age Coefficient: {model_alt.params['Age']:.6f}")
    print(f"Age p-value: {model_alt.pvalues['Age']:.6e}")
    
    # 3. Alternative Definition: Disease Control (PR + SD = 1 vs PD = 0)
    df['dcr'] = (df['Efficacy'].isin(['PR', 'SD'])).astype(int)
    model_dcr = sm.Logit(df['dcr'], X).fit()
    print("\n--- Alternative Endpoint (DCR: PR+SD = 1 vs PD = 0) ---")
    print(f"Age Coefficient: {model_dcr.params['Age']:.6f}")
    print(f"Age p-value: {model_dcr.pvalues['Age']:.6e}")

if __name__ == '__main__':
    main()
