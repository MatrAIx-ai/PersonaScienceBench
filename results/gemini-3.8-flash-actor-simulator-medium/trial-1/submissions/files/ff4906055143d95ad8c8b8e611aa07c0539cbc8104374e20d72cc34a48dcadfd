import os
import numpy as np
import pandas as pd
from scipy.stats import pearsonr, spearmanr

def main():
    sample_file = "data/Sample_annotated_Zenodo.csv"
    gene_file = "data/GeneMetaInfo_Zenodo.csv"
    counts_file = "data/BatchCorrectedReadCounts_Zenodo.csv"

    print("Loading sample metadata...")
    df_samples = pd.read_csv(sample_file)
    cd4_samples = df_samples[df_samples["celltype"] == "CD4"]["sample"].tolist()
    print(f"Identified {len(cd4_samples)} CD4 samples.")

    print("Loading gene metadata...")
    df_genes = pd.read_csv(gene_file)
    df_pc_genes = df_genes[df_genes["gene_biotype"] == "protein_coding"][["Geneid", "Length"]].copy()
    print(f"Identified {len(df_pc_genes)} protein-coding genes.")

    print("Loading read counts for CD4 samples...")
    usecols = ["Unnamed: 0"] + cd4_samples
    df_counts = pd.read_csv(counts_file, usecols=usecols)
    df_counts.rename(columns={"Unnamed: 0": "Geneid"}, inplace=True)

    print("Merging gene lengths with counts...")
    df_merged = pd.merge(df_pc_genes, df_counts, on="Geneid")
    print(f"Merged dataset shape: {df_merged.shape}")

    # Calculate mean expression across CD4 samples
    cd4_count_matrix = df_merged[cd4_samples].values
    mean_expr = np.mean(cd4_count_matrix, axis=1)
    gene_length = df_merged["Length"].values

    # Compute Pearson correlation
    pearson_r, p_val = pearsonr(gene_length, mean_expr)
    print("\n=== Primary Result ===")
    print(f"Pearson correlation coefficient (r): {pearson_r:.6f}")
    print(f"Pearson correlation p-value: {p_val:.4e}")
    print(f"Rounded to 4 decimal places: {pearson_r:.4f}")
    print(f"Rounded to 3 decimal places: {pearson_r:.3f}")
    print(f"Rounded to 2 decimal places: {pearson_r:.2f}")

    # Additional sensitivity checks
    spearman_rho, spearman_p = spearmanr(gene_length, mean_expr)
    print("\n=== Sensitivity Checks ===")
    print(f"Spearman rho: {spearman_rho:.6f} (p = {spearman_p:.4e})")

    log_mean = np.log2(mean_expr + 1)
    r_log, p_log = pearsonr(gene_length, log_mean)
    print(f"Pearson r with log2(mean + 1): {r_log:.6f} (p = {p_log:.4e})")

if __name__ == "__main__":
    main()
