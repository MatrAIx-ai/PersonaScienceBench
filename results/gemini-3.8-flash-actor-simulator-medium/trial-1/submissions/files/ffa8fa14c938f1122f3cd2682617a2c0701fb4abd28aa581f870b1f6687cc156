import pandas as pd
import numpy as np

def run_pca_analysis():
    # Load capital data
    df = pd.read_csv('data/capital.csv')
    features = [
        'ZAxtSchwert', 'ZDolch', 'Zhausgr', 'ZCU_AU', 'Zamber', 
        'ZMonument', 'ZHort', 'ZSichel', 'ZBeil', 'ZMW', 'ZKeform', 'Zkeverz'
    ]
    for col in features:
        df[col] = df[col].astype(str).str.replace(',', '.').astype(float)

    X = df[features].values
    
    # 1. Standardized PCA (Correlation matrix PCA)
    X_s = (X - np.mean(X, axis=0)) / np.std(X, axis=0, ddof=1)
    U_s, S_s, Vt_s = np.linalg.svd(X_s, full_matrices=False)
    eig_s = (S_s ** 2) / (len(df) - 1)
    var_exp_s = eig_s / np.sum(eig_s)
    loadings_s = pd.DataFrame(Vt_s[:2].T, index=features, columns=['PC1', 'PC2'])

    # 2. Covariance PCA (Centered only)
    X_c = X - np.mean(X, axis=0)
    U_c, S_c, Vt_c = np.linalg.svd(X_c, full_matrices=False)
    eig_c = (S_c ** 2) / (len(df) - 1)
    var_exp_c = eig_c / np.sum(eig_c)
    loadings_c = pd.DataFrame(Vt_c[:2].T, index=features, columns=['PC1', 'PC2'])

    # Map capital types
    types = {
        'ZAxtSchwert': 'Symbolic',
        'ZDolch': 'Symbolic',
        'Zhausgr': 'Symbolic',
        'ZCU_AU': 'Social',
        'Zamber': 'Social',
        'ZMonument': 'Social',
        'ZHort': 'Economic',
        'ZSichel': 'Economic',
        'ZBeil': 'Economic',
        'ZMW': 'Economic',
        'ZKeform': 'Cultural',
        'Zkeverz': 'Cultural'
    }
    loadings_s['Capital_Type'] = [types[f] for f in features]
    loadings_c['Capital_Type'] = [types[f] for f in features]

    print("=== Standardized PCA (Correlation Matrix) ===")
    print("Explained variance ratio: PC1 =", f"{var_exp_s[0]*100:.2f}%,", "PC2 =", f"{var_exp_s[1]*100:.2f}%")
    print(loadings_s)

    print("\n=== Covariance PCA (Centered Z-scores) ===")
    print("Explained variance ratio: PC1 =", f"{var_exp_c[0]*100:.2f}%,", "PC2 =", f"{var_exp_c[1]*100:.2f}%")
    print(loadings_c)

    # Specific extract for Symbolic Capital
    symbolic_keys = ['ZAxtSchwert', 'ZDolch', 'Zhausgr']
    print("\n=== Symbolic Capital Loadings (Standardized) ===")
    print(loadings_s.loc[symbolic_keys])

    # Save summary tables to CSV
    loadings_s.to_csv('pca_loadings_standardized.csv')
    loadings_c.to_csv('pca_loadings_covariance.csv')

if __name__ == '__main__':
    run_pca_analysis()
