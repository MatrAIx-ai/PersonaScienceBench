import pandas as pd

excel_path = "data/Supplemental Data File 1 PostvsPre_DEG_tables_ANNOTATED by_cell_type.xlsx"
xl = pd.ExcelFile(excel_path)

records = []

for sheet in xl.sheet_names:
    df = xl.parse(sheet)
    # Ensure correct columns
    assert 'p_val_adj' in df.columns
    assert 'avg_log2FC' in df.columns
    assert 'Unnamed: 0' in df.columns
    
    total_genes = len(df)
    unique_genes = df['Unnamed: 0'].nunique()
    
    sig_005 = (df['p_val_adj'] < 0.05).sum()
    sig_001 = (df['p_val_adj'] < 0.01).sum()
    sig_0001 = (df['p_val_adj'] < 0.001).sum()
    sig_005_fc05 = ((df['p_val_adj'] < 0.05) & (df['avg_log2FC'].abs() >= 0.5)).sum()
    
    records.append({
        'cell_type': sheet,
        'total_tested': total_genes,
        'unique_genes': unique_genes,
        'sig_adj_p_0.05': sig_005,
        'sig_adj_p_0.01': sig_001,
        'sig_adj_p_0.001': sig_0001,
        'sig_0.05_abs_log2FC_0.5': sig_005_fc05
    })

res_df = pd.DataFrame(records)
res_df_sorted = res_df.sort_values(by='sig_adj_p_0.05', ascending=False).reset_index(drop=True)

print("=== DEG Summary by Cell Type (Sorted by p_val_adj < 0.05) ===")
print(res_df_sorted.to_string(index=False))

res_df_sorted.to_csv("deg_summary_by_cell_type.csv", index=False)
