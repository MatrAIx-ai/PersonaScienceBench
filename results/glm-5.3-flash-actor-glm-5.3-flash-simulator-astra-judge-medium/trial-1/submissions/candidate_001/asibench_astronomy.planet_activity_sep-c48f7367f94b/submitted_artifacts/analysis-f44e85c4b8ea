"""
ASIBench astronomy.planet_activity_sep — recover latent per-case summary and
predict future component-A-only values.

Model (reference_epoch_day = 0.0 from input_0.json):
  obs_0(t) = b1*sin(2*pi*t/P_A) + b2*cos(2*pi*t/P_A)          # component A (fundamental)
           + c1*sin(2*pi*t/P_B) + c2*cos(2*pi*t/P_B)          # component B fundamental
           + c3*sin(4*pi*t/P_B) + c4*cos(4*pi*t/P_B)          # component B first harmonic
           + offset
Weighted linear least squares (weights 1/err); (P_A, P_B) from a global 2-D
coarse grid + multi-start nested refinement + Nelder-Mead polish.
component_a_present rule (pre-declared, applied to obs_0 only):
    Delta chi2 (B-only -> joint) >= 4.6  AND  A amplitude SNR >= 3.
obs_1 / obs_2 are fitted independently as a non-blocking cross-check only.
"""
import csv, json
from collections import defaultdict
import numpy as np
from scipy.signal import lombscargle
from scipy.optimize import minimize

TWO_PI = 2.0 * np.pi

meta = json.load(open('data/input_0.json'))
REF_EPOCH = float(meta['reference_epoch_day'])
CASES = list(meta['case_order'])

rows1 = list(csv.DictReader(open('data/input_1.csv')))
data = defaultdict(dict)   # data[case][channel] = (t, y, err)
for r in rows1:
    t = float(r['time_day'])
    for ch in ('obs_0', 'obs_1', 'obs_2'):
        data[r['case_id']][ch] = data[r['case_id']].get(ch, [[], [], []])
        data[r['case_id']][ch][0].append(t)
        data[r['case_id']][ch][1].append(float(r[ch]))
        data[r['case_id']][ch][2].append(float(r[ch + '_err']))
for c in data:
    for ch in data[c]:
        data[c][ch] = tuple(np.array(v) for v in data[c][ch])

targets = [(r['case_id'], r['time_day']) for r in csv.DictReader(open('data/input_2.csv'))]

# ------------------------------------------------------------------ model tools
def design(t, PA, PB):
    return np.column_stack([
        np.sin(TWO_PI * t / PA), np.cos(TWO_PI * t / PA),
        np.sin(TWO_PI * t / PB), np.cos(TWO_PI * t / PB),
        np.sin(2.0 * TWO_PI * t / PB), np.cos(2.0 * TWO_PI * t / PB),
        np.ones_like(t)])

def design_bonly(t, PB):
    return np.column_stack([
        np.sin(TWO_PI * t / PB), np.cos(TWO_PI * t / PB),
        np.sin(2.0 * TWO_PI * t / PB), np.cos(2.0 * TWO_PI * t / PB),
        np.ones_like(t)])

def wls(X, y, w):
    Xw = X * w[:, None]
    beta, *_ = np.linalg.lstsq(Xw, y * w, rcond=None)
    r = y * w - Xw @ beta
    return beta, float(r @ r)

def joint_chi2(t, y, w, PA, PB):
    return wls(design(t, PA, PB), y, w)[1]

def bonly_chi2(t, y, w, PB):
    return wls(design_bonly(t, PB), y, w)[1]

def refine_2d(t, y, w, PA0, PB0, hwA, hwB, rounds=4, npts=31):
    PAc, PBc, best = PA0, PB0, joint_chi2(t, y, w, PA0, PB0)
    hA, hB = hwA, hwB
    for _ in range(rounds):
        loc = [(joint_chi2(t, y, w, a, b), a, b)
               for a in np.linspace(PAc - hA, PAc + hA, npts)
               for b in np.linspace(PBc - hB, PBc + hB, npts)]
        loc.sort()
        best, PAc, PBc = loc[0]
        hA /= 6.0; hB /= 6.0
    return best, PAc, PBc

def polish(t, y, w, PA, PB):
    def f(p):
        a, b = p
        if not (1.5 <= a <= 600.0 and 1.5 <= b <= 600.0) or abs(a - b) < 1e-9:
            return 1e12
        return joint_chi2(t, y, w, a, b)
    r = minimize(f, [PA, PB], method='Nelder-Mead',
                 options={'xatol': 1e-7, 'fatol': 1e-9, 'maxiter': 6000})
    return float(r.fun), float(r.x[0]), float(r.x[1])

def refine_1d(func, x0, hw, rounds=6, npts=41):
    xc, hc, best = x0, hw, func(x0)
    for _ in range(rounds):
        vals = [(func(x), x) for x in np.linspace(xc - hc, xc + hc, npts)]
        vals.sort()
        best, xc = vals[0]
        hc /= 6.0
    return best, xc

def profile_sigma(func2d, p0, q0, axis, span=0.08, npts=81, dchi=1.0):
    def clamp(x, lo=1.5, hi=600.0):
        return min(max(x, lo), hi)
    if axis == 'PA':
        prof = lambda x: refine_1d(lambda q: func2d(x, clamp(q)), clamp(q0), 0.03 * clamp(q0))[0]
    else:
        prof = lambda x: refine_1d(lambda p: func2d(clamp(p), x), clamp(p0), 0.03 * clamp(p0))[0]
    xs = np.linspace(p0 * (1 - span), p0 * (1 + span), npts)
    cs = np.array([prof(x) for x in xs])
    cmin = cs.min(); imin = int(np.argmin(cs))
    lo, hi = xs[0], xs[-1]
    for i in range(imin, npts - 1):          # walk right: crossing between i and i+1
        if cs[i + 1] - cmin > dchi:
            e0, e1 = cs[i] - cmin, cs[i + 1] - cmin
            fr = (dchi - e0) / (e1 - e0)
            hi = xs[i] + fr * (xs[i + 1] - xs[i]); break
    for i in range(imin, 0, -1):             # walk left: crossing between i-1 and i
        if cs[i - 1] - cmin > dchi:
            e0, e1 = cs[i] - cmin, cs[i - 1] - cmin
            fr = (dchi - e0) / (e1 - e0)
            lo = xs[i] - fr * (xs[i] - xs[i - 1]); break
    return 0.5 * (hi - lo)


def jackknife_diagnostic(case, t, y, er, PA, PB):
    """Leave-one-cluster-out stability of the A component (phase consistency)."""
    TWO = 2.0 * np.pi
    gaps = np.where(np.diff(t) > 10)[0]
    idx = np.split(np.arange(len(t)), gaps + 1)
    w_full = 1.0 / er
    ph, am = [], []
    for k in range(len(idx)):
        sel = np.concatenate([idx[j] for j in range(len(idx)) if j != k])
        X = np.column_stack([np.sin(TWO*t[sel]/PA), np.cos(TWO*t[sel]/PA),
                             np.sin(TWO*t[sel]/PB), np.cos(TWO*t[sel]/PB),
                             np.sin(2*TWO*t[sel]/PB), np.cos(2*TWO*t[sel]/PB),
                             np.ones_like(t[sel])])
        ww = w_full[sel]
        Xw = X*ww[:, None]
        beta, *_ = np.linalg.lstsq(Xw, y[sel]*ww, rcond=None)
        cov = np.linalg.pinv(Xw.T @ Xw)
        a = float(np.hypot(beta[0], beta[1]))
        s = np.sqrt(np.diag(cov))
        sa = float(np.sqrt((beta[0]**2*s[0]**2 + beta[1]**2*s[1]**2
                            + 2*beta[0]*beta[1]*cov[0, 1]) / a**2))
        am.append((a, sa)); ph.append(np.arctan2(beta[1], beta[0]))
    R = float(abs(np.exp(1j*np.array(ph)).mean()))
    print(f'        jackknife (drop 1 of {len(idx)} clusters): A amp '
          f'{[f"{a:.2f}+-{s:.2f}" for a, s in am]} phases '
          f'{[f"{np.degrees(p):.0f}d" for p in ph]} deg; phase consistency R={R:.3f}')

def fmt(v):
    return f'{float(v):.12g}'

# ------------------------------------------------------- per-channel analysis
def analyze_channel(case, ch, verbose=True):
    t, y, er = data[case][ch]
    w = 1.0 / er
    n = len(t)
    chi2_const = float(((y - y.mean()) * w) @ ((y - y.mean()) * w))

    Pgrid = np.geomspace(1.5, 600.0, 300)
    coarse = []
    for PA in Pgrid:
        for PB in Pgrid:
            coarse.append((joint_chi2(t, y, w, PA, PB), PA, PB))
    coarse.sort()

    # multi-start: duplicate only if BOTH coordinates are within 3%
    starts = []
    for c, a, b in coarse:
        if c > 8 * coarse[0][0]:
            break
        if all(not (abs(a - s[1]) / s[1] < 0.03 and abs(b - s[2]) / s[2] < 0.03) for s in starts):
            starts.append((c, a, b))
        if len(starts) >= 25:
            break
    rel_step = np.log(600 / 1.5) / 299
    refined = []
    for c, a, b in starts:
        rc, ra, rb = refine_2d(t, y, w, a, b, hwA=3 * a * rel_step, hwB=3 * b * rel_step)
        rc, ra, rb = polish(t, y, w, ra, rb)
        refined.append((rc, ra, rb))
    refined.sort()
    chi2j, PA, PB = refined[0]

    X = design(t, PA, PB)
    beta, chi2j = wls(X, y, w)
    Xw = X * w[:, None]
    cov = np.linalg.pinv(Xw.T @ Xw)
    sig = np.sqrt(np.diag(cov))
    b1, b2, c1, c2, c3, c4, off = beta
    ampA = float(np.hypot(b1, b2))
    sig_ampA = float(np.sqrt((b1**2 * sig[0]**2 + b2**2 * sig[1]**2
                              + 2 * b1 * b2 * cov[0, 1]) / ampA**2))

    cb0, PB_b = refine_1d(lambda p: bonly_chi2(t, y, w, p), PB, hw=2.0)
    dchi2 = cb0 - chi2j
    amp_snr = ampA / sig_ampA
    present = bool((dchi2 >= 4.6) and (amp_snr >= 3.0))

    if amp_snr < 6.0:
        jackknife_diagnostic(case, t, y, er, PA, PB)
    res = y - X @ beta
    f = np.linspace(1 / 600, 0.5, 40000)
    pw = lombscargle(t, res * w, f, normalize=False)
    i = int(np.argmax(pw)); floor = float(np.percentile(pw, 90))

    out = dict(n=n, chi2_const=chi2_const, chi2=chi2j, red=chi2j / (n - 7),
               PA=PA, PB=PB, sig_PA=profile_sigma(lambda a, b: joint_chi2(t, y, w, a, b), PA, PB, 'PA'),
               sig_PB=profile_sigma(lambda a, b: joint_chi2(t, y, w, a, b), PA, PB, 'PB'),
               beta=beta, sig=sig, ampA=ampA, sig_ampA=sig_ampA, amp_snr=amp_snr,
               dchi2=dchi2, PB_b=PB_b, present=present,
               res_peak_P=1 / f[i], res_peak_ratio=pw[i] / max(floor, 1e-12),
               refined=refined)
    if verbose:
        print(f'  [{ch}] n={n} red_chi2={out["red"]:.3f} PA={PA:.5f}+-{out["sig_PA"]:.5f} '
              f'PB={PB:.5f}+-{out["sig_PB"]:.5f} Aamp={ampA:.3f}+-{sig_ampA:.3f} '
              f'(SNR={amp_snr:.2f}) dChi2(A)={dchi2:.2f} present={int(present)} '
              f'| res peak P={out["res_peak_P"]:.2f}d ratio={out["res_peak_ratio"]:.1f} '
              f'| off={off:.4f}+-{sig[6]:.4f}')
        print(f'        minima: ' + ', '.join(f'({a:.3f},{b:.3f})c={c:.1f}' for c, a, b in refined[:4]))
    return out

# ---------------------------------------------------------------- main analysis
summary_rows = []
print('=== primary channel obs_0 (deliverable) ===')
for case in CASES:
    print(f'--- {case}')
    r0 = analyze_channel(case, 'obs_0')
    report_cross = []
    for ch in ('obs_1', 'obs_2'):
        print(f'  cross-check {case} {ch}:')
        rx = analyze_channel(case, ch, verbose=True)
        report_cross.append((ch, rx))

    present = r0['present']
    b1, b2 = (r0['beta'][0], r0['beta'][1]) if present else (0.0, 0.0)
    summary_rows.append({
        'case_id': case,
        'component_a_present': int(present),
        'component_a_period_day': r0['PA'] if present else 0.0,
        'component_a_basis1_u0': b1,
        'component_a_basis2_u0': b2,
        'component_b_period_day': r0['PB'],
        'component_b_basis1_u0': r0['beta'][2],
        'component_b_basis2_u0': r0['beta'][3],
        'component_b_basis3_u0': r0['beta'][4],
        'component_b_basis4_u0': r0['beta'][5],
        'offset_u0': r0['beta'][6],
    })

sum_cols = ['case_id', 'component_a_present', 'component_a_period_day',
            'component_a_basis1_u0', 'component_a_basis2_u0',
            'component_b_period_day', 'component_b_basis1_u0', 'component_b_basis2_u0',
            'component_b_basis3_u0', 'component_b_basis4_u0', 'offset_u0']
with open('signal_summary.csv', 'w', newline='') as fh:
    wr = csv.writer(fh)
    wr.writerow(sum_cols)
    for row in summary_rows:
        wr.writerow([row['case_id'], row['component_a_present']] + [fmt(row[c]) for c in sum_cols[2:]])

coef = {r['case_id']: r for r in summary_rows}
with open('target_predictions.csv', 'w', newline='') as fh:
    wr = csv.writer(fh)
    wr.writerow(['case_id', 'time_day', 'component_a_value_u0'])
    for case, tstr in targets:
        r = coef[case]
        if r['component_a_present']:
            tt = float(tstr) - REF_EPOCH
            val = (r['component_a_basis1_u0'] * np.sin(TWO_PI * tt / r['component_a_period_day'])
                   + r['component_a_basis2_u0'] * np.cos(TWO_PI * tt / r['component_a_period_day']))
        else:
            val = 0.0
        wr.writerow([case, tstr, fmt(val)])

print('\nWrote signal_summary.csv and target_predictions.csv')
