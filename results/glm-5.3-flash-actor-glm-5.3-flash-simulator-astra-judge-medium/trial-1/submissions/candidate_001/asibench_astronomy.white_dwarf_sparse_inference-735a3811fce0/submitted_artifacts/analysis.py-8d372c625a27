"""
Sparse/Noisy Compact-Star Sequence Reconstruction
=================================================
1. M-R: weighted least-squares Nauenberg/Chandrasekhar family
   R = A*sqrt[(Mch/M)^(2/3) - (M/Mch)^(2/3)];
   2-param (A, Mch) vs 3-param (free exponent) compared by leave-one-out CV.
   mass_limit_solar = fitted M_ch.
2. Profiles: per-fragment Lane-Emden polytrope fits
   rho/rho_c = theta(x*xi1)^n, m(x) = -x^2 theta'(x*xi1)/theta'(xi1)
   (same theta^n -> single_family_consistency); smooth n(M) (linear primary,
   quadratic sensitivity band) -> profiles at 0.6/1.0/1.3 Msun.
3. Consistency checks: chi2/dof, monotonicity, boundary conditions.

NOTE: matplotlib is unavailable in this offline environment, so the required
PNG is produced by a small self-contained pure-numpy rasterizer (miniplot)
embedded below; all scientific computation uses numpy/scipy only.
"""
import json, zlib, struct
import numpy as np
import pandas as pd
from scipy.integrate import solve_ivp
from scipy.optimize import curve_fit, minimize_scalar

DATA, OUT = "data", "results"
mr = pd.read_csv(f"{DATA}/mr_observations.csv")
pf = pd.read_csv(f"{DATA}/profile_fragments.csv")
targets = json.load(open(f"{DATA}/query_targets.json"))

M_obs, R_obs = mr.mass_solar_obs.values, mr.radius_km_obs.values
sM, sR = mr.sigma_mass_solar.values, mr.sigma_radius_km.values
eval_masses = np.array(targets["mr_eval_masses_solar"])
prof_masses = np.array(targets["profile_target_masses_solar"])
xgrid = np.array(targets["radius_fraction_grid"])

# ------------------------------------------------------------- M-R: Nauenberg
def nauenberg2(M, A, Mch):
    return A * np.sqrt((Mch / M) ** (2 / 3) - (M / Mch) ** (2 / 3))

def nauenberg3(M, A, Mch, a):
    return A * np.sqrt((Mch / M) ** a - (M / Mch) ** a)

p2, _ = curve_fit(nauenberg2, M_obs, R_obs, p0=[7575.0, 1.44],
                  sigma=sR, absolute_sigma=True, maxfev=20000)
p3, _ = curve_fit(nauenberg3, M_obs, R_obs, p0=[p2[0], p2[1], 2 / 3],
                  sigma=sR, absolute_sigma=True, maxfev=20000)
chi2_2 = float(np.sum(((R_obs - nauenberg2(M_obs, *p2)) / sR) ** 2))
chi2_3 = float(np.sum(((R_obs - nauenberg3(M_obs, *p3)) / sR) ** 2))

def loo(model, p0):
    sq = []
    for i in range(len(M_obs)):
        mask = np.arange(len(M_obs)) != i
        try:
            pi, _ = curve_fit(model, M_obs[mask], R_obs[mask], p0=p0,
                              sigma=sR[mask], absolute_sigma=True, maxfev=20000)
            sq.append(((R_obs[i] - model(M_obs[i], *pi)) / sR[i]) ** 2)
        except Exception:
            sq.append(np.nan)
    return float(np.nanmean(np.array(sq)))

loo2m, loo3m = loo(nauenberg2, [7575.0, 1.44]), loo(nauenberg3, [p2[0], p2[1], 2/3])
use3 = loo3m < loo2m
model = nauenberg3 if use3 else nauenberg2
pfit = p3 if use3 else p2
model_name = ("3-parameter generalized Nauenberg (free exponent); adopted: "
              f"lower LOO-CV mean chi2 ({loo3m:.3f} < {loo2m:.3f})"
              if use3 else
              "2-parameter Nauenberg; adopted: LOO-CV mean chi2 "
              f"{loo2m:.3f} (2-par) vs {loo3m:.3f} (3-par)")
A_fit, Mch_fit = pfit[0], pfit[1]
chi2_fit, dof = (chi2_3, len(M_obs) - 3) if use3 else (chi2_2, len(M_obs) - 2)

rng = np.random.default_rng(42)
boot = []
for _ in range(400):
    Mb = M_obs + rng.normal(0, sM)
    Rb = R_obs + rng.normal(0, sR)
    try:
        boot.append(curve_fit(model, Mb, Rb, p0=pfit, sigma=sR,
                              absolute_sigma=True, maxfev=20000)[0][1])
    except Exception:
        pass
boot = np.array(boot)
Mch_mean, Mch_std = float(boot.mean()), float(boot.std())

# ------------------------------------------------------- Lane-Emden polytropes
def profile_for_n(n, grid=None):
    def eq(xi, y):
        return [y[1], -2.0 / xi * y[1] - (y[0] ** n if y[0] > 0 else 0.0)]
    def ev(xi, y):
        return y[0]
    ev.terminal, ev.direction = True, -1
    s = solve_ivp(eq, [1e-10, 50.0], [1.0, 0.0], events=ev,
                  rtol=1e-11, atol=1e-14, dense_output=True, max_step=0.005)
    xi1 = float(s.t_events[0][0])
    thp1 = float(s.sol(np.array([xi1]))[1][0])
    xi = np.asarray(xgrid if grid is None else grid) * xi1
    y = s.sol(xi)
    rho = np.clip(y[0], 0.0, None) ** n
    m = (xi ** 2) * y[1] / (xi1 ** 2 * thp1)   # = 1 at x = 1 exactly
    return rho, m, xi1

frag_fits = {}
for fid, g in pf.groupby("fragment_id"):
    x = g.radius_fraction.values
    rho, m = g.density_fraction_obs.values, g.enclosed_mass_fraction_obs.values
    sd, sm = g.sigma_density_fraction.values, g.sigma_enclosed_mass_fraction.values
    okd, okm = ~np.isnan(rho), ~np.isnan(m)

    def chi2_n(n):
        r, mi, _ = profile_for_n(n)
        rd = np.interp(x[okd], xgrid, r) - rho[okd]
        rm = np.interp(x[okm], xgrid, mi) - m[okm]
        return float(np.sum((rd / sd[okd]) ** 2) + np.sum((rm / sm[okm]) ** 2))

    res = minimize_scalar(chi2_n, bounds=(0.5, 5.0), method="bounded",
                          options={"xatol": 1e-5})
    nbest = float(res.x)
    lo = float(minimize_scalar(lambda nv: abs(chi2_n(nv) - res.fun - 1.0),
                               bounds=(0.5, nbest), method="bounded").x)
    hi = float(minimize_scalar(lambda nv: abs(chi2_n(nv) - res.fun - 1.0),
                               bounds=(nbest, 5.0), method="bounded").x)
    npts = int(okd.sum() + okm.sum())
    frag_fits[fid] = dict(mass=float(g.target_mass_solar.iloc[0]), n=nbest,
                          n_lo=lo, n_hi=hi, chi2=float(res.fun), dof=npts - 1,
                          chi2_dof=float(res.fun / (npts - 1)))

fms = np.array([frag_fits[k]["mass"] for k in sorted(frag_fits)])
fns = np.array([frag_fits[k]["n"] for k in sorted(frag_fits)])
ferr = np.maximum(np.array([frag_fits[k]["n_hi"] for k in sorted(frag_fits)]) - fns,
                  fns - np.array([frag_fits[k]["n_lo"] for k in sorted(frag_fits)]))
clin = np.polyfit(fms, fns, 1, w=1 / ferr)
cquad = np.polyfit(fms, fns, 2, w=1 / ferr)
n_of_M_lin = lambda M: np.polyval(clin, M)
n_of_M_quad = lambda M: np.polyval(cquad, M)

# ------------------------------------------------------------- generate output
radii_eval = model(eval_masses, *pfit)
radii_summary = {f"radius_at_{t}": float(model(m, *pfit))
                 for t, m in [("0p6Msun_km", 0.6), ("1p0Msun_km", 1.0),
                              ("1p2Msun_km", 1.2), ("1p3Msun_km", 1.3)]}
pd.DataFrame({"mass_solar": eval_masses, "radius_km": radii_eval}).to_csv(
    f"{OUT}/mr_reconstruction.csv", index=False)

dens, encl = [], []
for m in prof_masses:
    r, mm, _ = profile_for_n(float(n_of_M_lin(m)))
    dens.append(r); encl.append(mm)
dens, encl = np.clip(np.array(dens), 0.0, 1.0), np.clip(np.array(encl), 0.0, 1.0)
np.savez(f"{OUT}/profiles_reconstruction.npz",
         density_fraction=dens, enclosed_mass_fraction=encl)

int_check = {}
xf = np.linspace(0.0, 1.0, 200001)          # fine grid for the consistency check
for i, m in enumerate(prof_masses):
    rf, mf, _ = profile_for_n(float(n_of_M_lin(m)), xf)
    dx = np.diff(xf)
    intg = np.concatenate([[0], np.cumsum(3 * xf[1:] ** 2 * rf[1:] * dx)])
    int_check[str(m)] = float(np.max(np.abs(intg / intg[-1] - mf)))

summary = {
    "mass_limit_solar": float(Mch_fit), **radii_summary,
    "diagnostics": {
        "mr_model_adopted": model_name,
        "mr_chi2_dof": float(chi2_fit / dof),
        "loo_mean_chi2_2param": float(loo2m), "loo_mean_chi2_3param": float(loo3m),
        "mass_limit_bootstrap_mean": float(Mch_mean),
        "mass_limit_bootstrap_std": float(Mch_std),
        "mass_limit_2param_fit": float(p2[1]), "mass_limit_3param_fit": float(p3[1]),
        "mr_A_km": float(A_fit),
        "mr_exponent": float(pfit[2]) if use3 else 2/3,
        "profile_fits": {str(k): v for k, v in frag_fits.items()},
        "n_of_M_linear_coeffs": [float(c) for c in clin],
        "n_of_M_quadratic_coeffs": [float(c) for c in cquad],
        "n_at_1p3_linear": float(n_of_M_lin(1.3)),
        "n_at_1p3_quadratic": float(n_of_M_quad(1.3)),
        "note_1p3_uncertainty": ("the 1.3 Msun profile is the least constrained "
                                 "output; linear vs quadratic n(M) gives the "
                                 "sensitivity band"),
        "integral_consistency_max_abs_dev": int_check,
        "npz_layout": (f"shape (3,{len(xgrid)}), rows ordered by profile_target_masses_solar; radius_fraction grid copied verbatim from query_targets.json"),
        "noise_assumption": "independent Gaussian with reported per-point sigmas",
        "plot_note": "PNG generated by embedded pure-numpy rasterizer (no matplotlib in env)",
    },
}
json.dump(summary, open(f"{OUT}/summary.json", "w"), indent=2)

checks = {
    "mr_radius_monotone_decreasing": bool(np.all(np.diff(radii_eval) < 0)),
    "mr_all_radii_positive": bool(np.all(radii_eval > 0)),
    "mr_eval_masses_below_limit": bool(np.all(eval_masses < Mch_fit)),
    "profiles_density_monotone_decreasing": bool(np.all(np.diff(dens, axis=1) <= 1e-9)),
    "profiles_density_in_0_1": bool((dens >= -1e-12).all() and (dens <= 1 + 1e-9).all()),
    "profiles_encl_monotone_increasing": bool(np.all(np.diff(encl, axis=1) >= -1e-9)),
    "profiles_encl_in_0_1": bool((encl >= -1e-12).all() and (encl <= 1 + 1e-9).all()),
    "profiles_center_density_is_1": bool(np.allclose(dens[:, 0], 1.0)),
    "profiles_surface_density_below_1e-4": bool(np.all(dens[:, -1] <= 1e-4)),
    "profiles_encl_endpoints_0_and_1": bool(np.allclose(encl[:, 0], 0.0)
                                            and np.allclose(encl[:, -1], 1.0)),
    "integral_consistency_fine_grid_max_dev_lt_1e-5": bool(all(v < 1e-6 for v in int_check.values())),
    "fragment_chi2_dof_all_below_3": bool(all(d["chi2_dof"] < 3 for d in frag_fits.values())),
}
print(json.dumps({"summary": summary, "checks": checks}, indent=2, default=str))

