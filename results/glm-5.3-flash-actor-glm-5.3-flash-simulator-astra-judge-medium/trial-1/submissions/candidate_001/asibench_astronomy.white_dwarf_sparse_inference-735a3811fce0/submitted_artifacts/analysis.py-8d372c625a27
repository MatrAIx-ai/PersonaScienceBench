class Canvas:
    def __init__(self, w, h, bg=(255, 255, 255)):
        self.w, self.h = w, h
        self.a = np.zeros((h, w, 3), dtype=np.uint8)
        self.a[:] = bg

    def setpix(self, x, y, c):
        if 0 <= int(x) < self.w and 0 <= int(y) < self.h:
            self.a[int(y), int(x)] = c

    def fill_rect(self, x0, y0, w, h, c):
        x0, y0 = int(x0), int(y0)
        self.a[max(0,y0):y0+int(h), max(0,x0):x0+int(w)] = c

    def thick_line(self, x0, y0, x1, y1, c, t=1):
        n = int(max(abs(x1-x0), abs(y1-y0))) + 1
        xs = np.linspace(x0, x1, n); ys = np.linspace(y0, y1, n)
        for dx in range(-(t//2), t//2 + 1):
            for dy in range(-(t//2), t//2 + 1):
                for xx, yy in zip(xs + dx, ys + dy):
                    self.setpix(xx, yy, c)

    def disk(self, x, y, r, c):
        for dy in range(-r, r + 1):
            for dx in range(-r, r + 1):
                if dx*dx + dy*dy <= r*r:
                    self.setpix(x + dx, y + dy, c)

    def text(self, x, y, s, scale=2, c=(0, 0, 0)):
        cx = x
        for ch in str(s).upper():
            g = FONT.get(ch)
            if g is None:
                cx += 6 * scale; continue
            for r, row in enumerate(g):
                for k, bit in enumerate(row):
                    if bit == 'X':
                        self.fill_rect(cx + k*scale, y + r*scale, scale, scale, c)
            cx += (len(g[0]) + 1) * scale
        return cx

    def text_width(self, s, scale=2):
        return sum((len(FONT.get(ch, FONT[' '])[0]) + 1) * scale
                   for ch in str(s).upper())

    def save_png(self, path):
        raw = b''.join(b'\x00' + row.tobytes() for row in self.a)
        def chunk(tag, data):
            c = struct.pack('>I', len(data)) + tag + data
            return c + struct.pack('>I', zlib.crc32(tag + data) & 0xffffffff)
        png = (b'\x89PNG\r\n\x1a\n'
               + chunk(b'IHDR', struct.pack('>IIBBBBB', self.w, self.h, 8, 2, 0, 0, 0))
               + chunk(b'IDAT', zlib.compress(raw, 9))
               + chunk(b'IEND', b''))
        open(path, 'wb').write(png)

class Axes:
    def __init__(self, cv, x0, y0, w, h, xlim, ylim):
        self.cv, self.x0, self.y0, self.w, self.h = cv, x0, y0, w, h
        self.xlim, self.ylim = xlim, ylim

    def px(self, x, y):
        fx = (x - self.xlim[0]) / (self.xlim[1] - self.xlim[0])
        fy = (y - self.ylim[0]) / (self.ylim[1] - self.ylim[0])
        return self.x0 + fx * self.w, self.y0 + (1 - fy) * self.h

    def plot(self, xs, ys, c, t=2):
        xs = np.asarray(xs); ys = np.asarray(ys)
        pts = [self.px(x, y) for x, y in zip(xs, ys)]
        for (a, b), (a2, b2) in zip(pts[:-1], pts[1:]):
            self.cv.thick_line(a, b, a2, b2, c, t)

    def scatter(self, x, y, c, r=3):
        px, py = self.px(x, y)
        self.cv.disk(px, py, r, c)

    def verrorbar(self, x, y, ye, c):
        (px, py0), (_, py1) = self.px(x, y - ye), self.px(x, y + ye)
        self.cv.thick_line(px, py0, px, py1, c, 1)
        self.cv.thick_line(px - 4, py0, px + 4, py0, c, 1)
        self.cv.thick_line(px - 4, py1, px + 4, py1, c, 1)

    def frame(self, xticks, yticks, xlab, ylab, c=(0, 0, 0)):
        cv = self.cv
        cv.thick_line(self.x0, self.y0 + self.h, self.x0 + self.w, self.y0 + self.h, c, 2)
        cv.thick_line(self.x0, self.y0, self.x0, self.y0 + self.h, c, 2)
        for v in xticks:
            px, py = self.px(v, self.ylim[0])
            cv.thick_line(px, py, px, py + 6, c, 1)
            s = f"{v:g}"
            cv.text(px - cv.text_width(s, 2) / 2, py + 10, s, 2)
        for v in yticks:
            px, py = self.px(self.xlim[0], v)
            cv.thick_line(px - 6, py, px, py, c, 1)
            s = f"{v:g}"
            cv.text(px - 10 - cv.text_width(s, 2), py - 7, s, 2)
        cv.text(self.x0 + self.w/2 - cv.text_width(xlab, 2)/2,
                self.y0 + self.h + 12, xlab, 2, c)
        cv.text(self.x0, self.y0 - 16, ylab, 2, c)

