"""Pilot: N=800, IP3=0.28 uM, 20 s, 2 replicates. Scale checks vs example trace
(format reference only) + timing + conservation."""
import time
import numpy as np
import simulate as S

t0 = time.time()
tr, po, ce = S.run_group([0.28], 800, 2, 20.0, seed=S.SEED_BASE + 999)
el = time.time() - t0
print(f"pilot wall time: {el:.2f} s for 20 s x 2 reps (N=800)")
print(f"-> projected full grid (60 traj x 120 s): ~{el*6*5/60:.1f} min")
print(f"conservation drift: {ce.max():.3e}")
print(f"p_open (20 s avg): {po}")
for r in range(tr.shape[0]):
    x = tr[r]
    isi = S.isis_of_trace(x, S.DT_OUT)
    print(f"rep{r}: min={x.min():.4f} max={x.max():.4f} mean={x.mean():.4f} "
          f"n_ISIs={isi.size} ISIs={np.round(isi,2)}")

ex = np.load('data/example_trajectory.npy')
print("\nexample trace (format reference): min %.4f max %.4f mean %.4f" %
      (ex.min(), ex.max(), ex.mean()))
