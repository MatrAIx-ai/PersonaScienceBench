def main():
    t_wall = time.time()
    n_ip3, n_N = len(IP3_LEVELS), len(CHANNEL_COUNTS)
    traces = {}
    p_open_by_N = {}
    cons_all = []
    for ji, N in enumerate(CHANNEL_COUNTS):
        t0 = time.time()
        pfile = f"_partial_group{ji}.npz"
        if os.path.exists(pfile):                      # checkpoint/resume
            _d = np.load(pfile)
            tr, po, ce = _d["tr"], _d["po"], _d["ce"]
            print(f"[run] N={N}: restored from checkpoint", flush=True)
        else:
            tr, po, ce = run_group(IP3_LEVELS, N, N_REP, T_OBS, SEED_BASE + 101 * ji)
            np.savez(pfile, tr=tr, po=po, ce=ce)
        for ii in range(n_ip3):
            traces[f"ip3{ii}_N{ji}"] = np.ascontiguousarray(
                tr[ii * N_REP:(ii + 1) * N_REP], dtype=np.float64)
        p_open_by_N[ji] = po.reshape(n_ip3, N_REP)
        cons_all.append(ce)
        print(f"[run] N={N}: {time.time()-t0:.1f} s; cons drift {ce.max():.3e}; "
              f"p_open [{po.min():.4f}, {po.max():.4f}]", flush=True)

    for ji in range(n_N):                              # clean checkpoints
        try:
            os.remove(f"_partial_group{ji}.npz")
        except OSError:
            pass

    np.savez("ca_traces.npz", **traces)

    jbig = n_N - 1
    period, fallback_used = [], []
    for ii in range(n_ip3):
        p, fb = period_stat(traces[f"ip3{ii}_N{jbig}"], DT_OUT)
        period.append(p)
        fallback_used.append(fb)
    cv = [cv_stat(traces[f"ip3{CR_IP3_IDX_USED}_N{ji}"], DT_OUT) for ji in range(n_N)]
    p_open = [float(p_open_by_N[jbig][ii].mean()) for ii in range(n_ip3)]
    cons_max = float(max(ce.max() for ce in cons_all))

    mf_open = [meanfield_run(p, T_OBS, DT_OUT)[1] for p in IP3_LEVELS]

    summary = {
        "ip3_levels": IP3_LEVELS,
        "channel_counts": CHANNEL_COUNTS,
        "period_vs_ip3": period,
        "cv_isi_vs_N": cv,
        "p_open_vs_ip3": p_open,
        "conservation_error_max": cons_max,
        "cr_ip3_idx_used": CR_IP3_IDX_USED,
    }
    with open("summary_stats.json", "w") as fh:
        json.dump(summary, fh, indent=2)

    panels = build_panels(traces, IP3_LEVELS, CHANNEL_COUNTS, period, cv, p_open,
                          rep_ip3_idx=2, rep_N_idx=jbig, mf_open=mf_open)
    renderer = make_figure(panels, "calcium_summary.png")

    print("\n=== summary_stats.json ===")
    print(json.dumps(summary, indent=2))
    print("period fallback (autocorrelation) used at ip3 indices:",
          [i for i, f in enumerate(fallback_used) if f])
    print(f"figure renderer: {renderer}")
    print(f"total wall time: {time.time()-t_wall:.1f} s")


if __name__ == "__main__":
    main()
