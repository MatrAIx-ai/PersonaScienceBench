def _fill_rect(img, x, y, w, h, color):
    H, W, _ = img.shape
    xa, xb = max(0, int(x)), min(W, int(x + w))
    ya, yb = max(0, int(y)), min(H, int(y + h))
    if xa < xb and ya < yb:
        img[ya:yb, xa:xb] = color


def _line(img, x0, y0, x1, y1, color):
    x0, y0, x1, y1 = int(round(x0)), int(round(y0)), int(round(x1)), int(round(y1))
    dx, dy = abs(x1 - x0), -abs(y1 - y0)
    sx = 1 if x0 < x1 else -1
    sy = 1 if y0 < y1 else -1
    err = dx + dy
    H, W, _ = img.shape
    while True:
        if 0 <= x0 < W and 0 <= y0 < H:
            img[y0, x0] = color
        if x0 == x1 and y0 == y1:
            break
        e2 = 2 * err
        if e2 >= dy:
            err += dy
            x0 += sx
        if e2 <= dx:
            err += dx
            y0 += sy


def _char_bmp(ch):
    return _FONT.get(ch.upper(), _FONT[" "])


def _text_w(s, scale=2):
    return len(s) * 6 * scale if s else 0


def _draw_text(img, x, y, s, scale=2, color=(10, 10, 10), align="left"):
    if s is None:
        return
    s = str(s)
    w = _text_w(s, scale)
    if align == "center":
        x -= w // 2
    elif align == "right":
        x -= w
    cx = int(x)
    for ch in s:
        g = _char_bmp(ch)
        for r in range(7):
            for cc in range(5):
                if g[r][cc] == "#":
                    _fill_rect(img, cx + cc * scale, y + r * scale, scale, scale, color)
        cx += 6 * scale


def _draw_text_rot(img, x, y_bottom, s, scale=2, color=(10, 10, 10)):
    """Vertical text, reading bottom-to-top (rotated 90 deg CCW)."""
    ycur = int(y_bottom)
    for ch in str(s):
        g = _char_bmp(ch)
        for r in range(5):
            for cc in range(7):
                if g[6 - cc][r] == "#":
                    _fill_rect(img, x + r * scale, ycur - (cc + 1) * scale,
                               scale, scale, color)
        ycur -= 8 * scale


def _nice_ticks(lo, hi, n=5):
    if hi <= lo:
        hi = lo + 1.0
    raw = (hi - lo) / max(n, 1)
    mag = 10.0 ** math.floor(math.log10(raw))
    step = mag
    for mlt in (1, 2, 2.5, 5, 10):
        if mlt * mag >= raw:
            step = mlt * mag
            break
    t0 = math.ceil(lo / step) * step
    ticks = []
    t = t0
    while t <= hi + 1e-9:
        ticks.append(t)
        t += step
    return ticks


def _draw_panel(img, x0, y0, w, h, p):
    black = (10, 10, 10)
    scale = 2
    allx, ally = [], []
    for xv, yv, _, _ in p["series"]:
        xv = np.asarray(xv, dtype=float)
        yv = np.asarray(yv, dtype=float)
        ok = np.isfinite(yv) & np.isfinite(xv)
        allx.append(xv[ok])
        ally.append(yv[ok])
    if sum(a.size for a in allx) == 0:
        allx = [np.array([0.0, 1.0])]
        ally = [np.array([0.0, 1.0])]
    X = np.concatenate(allx)
    Y = np.concatenate(ally)
    if p.get("logx"):
        X = np.log10(np.maximum(X, 1e-12))
    xlo, xhi = float(X.min()), float(X.max())
    ylo, yhi = float(Y.min()), float(Y.max())
    if xhi <= xlo:
        xhi = xlo + 1.0
    if yhi <= ylo:
        yhi = ylo + 1.0
    pad_x, pad_y = 0.04 * (xhi - xlo), 0.06 * (yhi - ylo)
    xlo, xhi, ylo, yhi = xlo - pad_x, xhi + pad_x, ylo - pad_y, yhi + pad_y

    def tx(v):
        if p.get("logx"):
            v = math.log10(max(v, 1e-12))
        return x0 + (v - xlo) / (xhi - xlo) * (w - 1)

    def ty(v):
        return y0 + h - 1 - (v - ylo) / (yhi - ylo) * (h - 1)

    _line(img, x0, y0, x0 + w - 1, y0, black)
    _line(img, x0, y0 + h - 1, x0 + w - 1, y0 + h - 1, black)
    _line(img, x0, y0, x0, y0 + h - 1, black)
    _line(img, x0 + w - 1, y0, x0 + w - 1, y0 + h - 1, black)

    xt = p["xticks"] if p.get("logx") else _nice_ticks(xlo, xhi, 6)
    for tv in xt:
        xx = tx(tv)
        if x0 <= xx <= x0 + w - 1:
            _line(img, xx, y0 + h - 1, xx, y0 + h - 1 + 5, black)
            lbl = str(tv) if p.get("logx") else ("%g" % tv)
            _draw_text(img, xx, y0 + h - 1 + 8, lbl, scale, black, align="center")
    for tv in _nice_ticks(ylo, yhi, 5):
        yy = ty(tv)
        if y0 <= yy <= y0 + h - 1:
            _line(img, x0 - 5, yy, x0, yy, black)
            _draw_text(img, x0 - 8, yy - 7 * scale // 2, "%g" % tv, scale, black,
                       align="right")

    for xv, yv, style, _lbl in p["series"]:
        xv = np.asarray(xv, dtype=float)
        yv = np.asarray(yv, dtype=float)
        ok = np.isfinite(yv) & np.isfinite(xv)
        xv, yv = xv[ok], yv[ok]
        if xv.size == 0:
            continue
        color = _COLOR.get(style[0], _COLOR["k"])
        dashed = "--" in style
        markers = style.endswith("o")
        pxs = np.clip(np.array([tx(v) for v in xv]), x0, x0 + w - 1)
        pys = np.clip(np.array([ty(v) for v in yv]), y0, y0 + h - 1)
        for m in range(pxs.size - 1):
            if dashed and m % 2 == 1:
                continue
            _line(img, pxs[m], pys[m], pxs[m + 1], pys[m + 1], color)
        if markers:
            for m in range(pxs.size):
                _fill_rect(img, pxs[m] - 2, pys[m] - 2, 5, 5, color)

    _draw_text(img, x0 + w // 2, y0 - 9 * scale - 4, p["title"], scale, black,
               align="center")
    _draw_text(img, x0 + w // 2, y0 + h - 1 + 9 * scale, p["xlabel"], scale, black,
               align="center")
    _draw_text_rot(img, x0 - 9 * scale - 14, y0 + h - 1, p["ylabel"], scale, black)

    labeled = [s for s in p["series"] if s[3]]
    if len(labeled) > 1:
        labels = [s[3] for s in labeled]
        lw = max(_text_w(l, scale) for l in labels) + 70
        lh = 10 * scale * len(labels) + 4
        lx = x0 + w - 8 - lw
        ly = y0 + 8
        _fill_rect(img, lx, ly, lw, lh, (255, 255, 255))
        for bx, by, ex, ey in ((lx, ly, lx + lw, ly), (lx, ly + lh - 1, lx + lw,
                                                    ly + lh - 1),
                               (lx, ly, lx, ly + lh - 1),
                               (lx + lw - 1, ly, lx + lw - 1, ly + lh - 1)):
            _line(img, bx, by, ex, ey, (180, 180, 180))
        for m, (xv, yv, style, lbl) in enumerate(labeled):
            yy = ly + 5 * scale + m * 10 * scale
            color = _COLOR.get(style[0], _COLOR["k"])
            dashed = "--" in style
            for q in range(18):
                if not (dashed and q % 2 == 1):
                    _line(img, lx + 6 + q * 2, yy + 3 * scale,
                          lx + 7 + q * 2, yy + 3 * scale, color)
            _draw_text(img, lx + 50, yy, lbl, scale, black)


def render_panels_fallback(panels, path, W=1400, H=1000):
    img = np.full((H, W, 3), 255, np.uint8)
    left, right, top, bottom = 130, 40, 70, 100
    hgap, vgap = 70, 110
    pw = (W - left - right - hgap) // 2
    ph = (H - top - bottom - vgap) // 2
    for pi, p in enumerate(panels):
        r, cc = divmod(pi, 2)
        x0 = left + cc * (pw + hgap)
        y0 = top + r * (ph + vgap)
        _draw_panel(img, x0, y0, pw, ph, p)
    _draw_text(img, W // 2, 10,
               "IP3R (De Young-Keizer) stochastic channel simulations",
               3, (10, 10, 10), align="center")
    write_png(path, img)


def write_png(path, img):
    """Minimal PNG encoder for the uint8 RGB fallback figure."""
    h, w, _ = img.shape
    raw = b"".join(b"\x00" + img[m].tobytes() for m in range(h))

    def chunk(tag, data):
        return (struct.pack(">I", len(data)) + tag + data +
                struct.pack(">I", zlib.crc32(tag + data) & 0xFFFFFFFF))

    sig = b"\x89PNG\r\n\x1a\n"
    ihdr = struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0)
    with open(path, "wb") as fh:
        fh.write(sig + chunk(b"IHDR", ihdr) +
                 chunk(b"IDAT", zlib.compress(raw, 6)) + chunk(b"IEND", b""))


def make_figure(panels, path):
    try:
        render_panels_mpl(panels, path)
        return "matplotlib"
    except Exception as exc:
        print(f"[figure] matplotlib unavailable ({exc!r}); using NumPy PNG fallback")
        render_panels_fallback(panels, path)
        return "numpy-fallback"


