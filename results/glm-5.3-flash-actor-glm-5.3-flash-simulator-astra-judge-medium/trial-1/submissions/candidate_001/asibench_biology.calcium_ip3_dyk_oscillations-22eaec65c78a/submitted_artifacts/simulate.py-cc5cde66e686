# ----------------------------------------------------------------------------
with open("data/system_info.json") as _fh:
    SYS = json.load(_fh)
with open("data/scan_spec.json") as _fh:
    SPEC = json.load(_fh)

_BI = SYS["receptor_kinetics"]["binding_interactions"]
_A = {r["idx"]: float(r["forward_rate"]) for r in _BI}
_KD = {r["idx"]: float(r["equilibrium_kd"]) for r in _BI}
A1, A2, A3, A4, A5 = _A[1], _A[2], _A[3], _A[4], _A[5]
D1, D2, D3, D4, D5 = (_A[m] * _KD[m] for m in (1, 2, 3, 4, 5))

_C = SYS["compartment"]
C1 = float(_C["volume_ratio_lumen_to_cyt"])          # V_lumen / V_cytosol
C0 = float(_C["total_free_ca_micromolar"])           # total free Ca (cyt-normalized)

_F = SYS["channel_flux_and_pump"]
V1 = float(_F["max_channel_flux_rate_per_second"])   # 6.0 s^-1
V2 = float(_F["lumen_leak_rate_per_second"])         # 0.11 s^-1
VMAX = float(_F["reuptake_vmax_micromolar_per_second"])  # 0.9 uM/s
KM = float(_F["reuptake_km_micromolar"])             # 0.1 uM

CA_INIT = float(SYS["initial_conditions_hint"]["ca_cyt_initial_micromolar"])

IP3_LEVELS = [float(x) for x in SPEC["ip3_levels_micromolar"]]
CHANNEL_COUNTS = [int(n) for n in SPEC["channel_counts"]]
N_REP = int(SPEC["n_replicates"])
T_OBS = float(SPEC["T_obs_seconds"])
DT_OUT = float(SPEC["dt_out_seconds"])
N_SAMPLES = int(round(T_OBS / DT_OUT))

DT_INT = 1.0e-3          # hybrid integration step (s)
SEED_BASE = 987654321    # reproducible stochastic runs
CR_IP3_IDX_USED = 0      # lowest ligand level for the CV-of-ISI statistic

OPEN_STATE = 3           # s = 4k + 2j + i = 3  <=>  i=1, j=1, k=0


# ----------------------------------------------------------------------------
# 8-state subunit generator (used for exact stationary initialization and for
# the mean-field diagnostic curve)
# ----------------------------------------------------------------------------
def qmat(ip3, c):
    """Generator Q of the 8-state subunit CTMC (rows = source states)."""
    Q = np.zeros((8, 8))
    for s in range(8):
        i, j, k = s & 1, (s >> 1) & 1, s >> 2
        if k == 0:
            Q[s, s ^ 1] += A1 * ip3 if i == 0 else D1
        else:
            Q[s, s ^ 1] += A3 * ip3 if i == 0 else D3
        Q[s, s ^ 2] += A5 * c if j == 0 else D5
        if i == 0:
            Q[s, s ^ 4] += A4 * c if k == 0 else D4
        else:
            Q[s, s ^ 4] += A2 * c if k == 0 else D2
        Q[s, s] = -Q[s].sum()
    return Q


def stat8(ip3, c):
    """Exact stationary distribution of the 8-state subunit CTMC."""
    Q = qmat(ip3, c)
    M = Q.T.copy()
    M[-1, :] = 1.0
    b = np.zeros(8)
    b[-1] = 1.0
    return np.linalg.solve(M, b)


# ----------------------------------------------------------------------------
# Hybrid stochastic kernel: one vectorized batch = (n_ip3 levels x n_replicates)
# trajectories sharing the same channel count N.
# ----------------------------------------------------------------------------
def run_group(ip3_levels, N, n_rep, T_obs, seed):
    """Simulate len(ip3_levels)*n_rep trajectories of N-channel cells.

    Returns (traces [B, n_samples] cytosolic uM,
             p_open  [B] time-averaged open fraction,
             cons_err[B] worst relative conservation drift per trajectory).
    """
    B = len(ip3_levels) * n_rep
    ip3 = np.repeat(np.asarray(ip3_levels, dtype=np.float64), n_rep)
    NS = 3 * N
    rng = np.random.default_rng(seed)

    n_samples = int(round(T_obs / DT_OUT))
    steps = int(round(T_obs / DT_INT))
    every = steps // n_samples
    assert every * n_samples == steps, "T_obs/dt_out grid mismatch"

    # --- initial conditions ---------------------------------------------------
    c = np.full(B, CA_INIT)
    lum = (C0 - c) / C1
    # subunits sampled from their exact stationary distribution at (IP3, c_init)
    P = np.stack([stat8(p, CA_INIT) for p in ip3])          # (B, 8)
    cum = np.cumsum(P, axis=1)
    u0 = rng.random((B, NS))
    s0 = (u0[:, :, None] >= cum[:, None, :]).sum(axis=2).clip(0, 7).astype(np.int8)
    i_s = (s0 & 1).astype(np.int8)
    j_s = ((s0 >> 1) & 1).astype(np.int8)
    k_s = (s0 >> 2).astype(np.int8)

    def open_fraction(i_s, j_s, k_s):
        # channel conducts iff ALL THREE of its subunits are in state s = 3
        op = (i_s == 1) & (j_s == 1) & (k_s == 0)
        return op.reshape(B, N, 3).all(axis=2).sum(axis=1) / float(N)

    f_open = open_fraction(i_s, j_s, k_s)

    # i-flip tables do not depend on c -> precompute once
    Ri0 = A1 * ip3 + D1
    Ri1 = A3 * ip3 + D3
    EI = np.exp(-DT_INT * np.stack([Ri0, Ri1], axis=1))      # (B, 2)
    PI = np.stack([A1 * ip3 / Ri0, A3 * ip3 / Ri1], axis=1)  # (B, 2)
    row = np.arange(B)[:, None]

    out = np.empty((B, n_samples), dtype=np.float64)
    fsum = np.zeros(B)
    M0 = c + C1 * lum
    cons_err = np.zeros(B)
    rec = 0

    dt2, dt6 = DT_INT / 2.0, DT_INT / 6.0
    km2 = KM * KM

    for step in range(steps):
        if step % every == 0:
            out[:, rec] = c
            rec += 1
            M = c + C1 * lum
            cons_err = np.maximum(cons_err, np.abs(M - M0) / M0)

        # --- 1. RK4 for (c, lumen) with frozen channel flux -------------------
        f = f_open
        vf = C1 * (V1 * f + V2)

        def J(cc, ll):
            return vf * (ll - cc) - VMAX * cc * cc / (km2 + cc * cc)

        q1 = J(c, lum)
        q2 = J(c + dt2 * q1, lum - dt2 * q1 / C1)
        q3 = J(c + dt2 * q2, lum - dt2 * q2 / C1)
        q4 = J(c + DT_INT * q3, lum - DT_INT * q3 / C1)
        dq = dt6 * (q1 + 2.0 * (q2 + q3) + q4)
        c = np.maximum(c + dq, 0.0)
        lum = np.maximum(lum - dq / C1, 0.0)

        # --- 2. exact two-state update per flip type --------------------------
        # flip i (uses current k)
        Eg = EI[row, k_s]
        Pg = PI[row, k_s]
        i_s = (rng.random((B, NS)) < (Pg + (i_s - Pg) * Eg)).astype(np.int8)

        # flip j (depends on c)
        Rj = A5 * c + D5
        Pj = A5 * c / Rj
        Ej = np.exp(-Rj * DT_INT)
        j_s = (rng.random((B, NS)) <
               (Pj[:, None] + (j_s - Pj[:, None]) * Ej[:, None])).astype(np.int8)

        # flip k (uses updated i)
        Rk0 = A4 * c + D4
        Rk1 = A2 * c + D2
        Pk = np.stack([A4 * c / Rk0, A2 * c / Rk1], axis=1)
        Ek = np.exp(-DT_INT * np.stack([Rk0, Rk1], axis=1))
        Eg2 = Ek[row, i_s]
        Pg2 = Pk[row, i_s]
        k_s = (rng.random((B, NS)) < (Pg2 + (k_s - Pg2) * Eg2)).astype(np.int8)

        # --- 3. open fraction (all three subunits in state 3) -----------------
        f_open = open_fraction(i_s, j_s, k_s)
        fsum += f_open

    p_open = fsum / steps
    return out, p_open, cons_err


# ----------------------------------------------------------------------------
# Statistics: peak-to-peak period, CV of ISI
# ----------------------------------------------------------------------------
def isis_of_trace(x, dt_out):
    """Inter-spike intervals (s) of one trace via peak-to-peak spacing."""
    rng = float(x.max() - x.min())
    if rng <= 1e-12:
        return np.empty(0)
    pk, _ = find_peaks(x, prominence=0.3 * rng, distance=30)  # 3 s min spacing
    return np.diff(pk) * dt_out


def acf_period(x, dt_out):
    """Fallback period: first local maximum of the autocorrelation for lags in
    [5, 60] s. Flagged as a fallback by the caller."""
    y = x - x.mean()
    n = y.size
    ac = np.correlate(y, y, "full")[n - 1:]
    if ac[0] <= 0:
        return None
    ac = ac / ac[0]
    lo = int(round(5.0 / dt_out))
    hi = min(int(round(60.0 / dt_out)), n - 1)
    seg = ac[lo:hi]
    for m in range(1, seg.size - 1):
        if seg[m] >= seg[m - 1] and seg[m] > seg[m + 1] and seg[m] > 0.05:
            return (lo + m) * dt_out
    m = int(np.argmax(seg))
    return (lo + m) * dt_out if seg[m] > 0.05 else None


def period_stat(traces, dt_out):
    """Mean peak-to-peak period (s) pooled across replicates. Returns
    (value or None, used_fallback)."""
    pools = [isis_of_trace(traces[r], dt_out) for r in range(traces.shape[0])]
    isi = np.concatenate(pools) if pools else np.empty(0)
    if isi.size >= 1:
        return float(isi.mean()), False
    vals = [acf_period(traces[r], dt_out) for r in range(traces.shape[0])]
    vals = [v for v in vals if v is not None]
    if vals:
        return float(np.mean(vals)), True
    return None, True


def cv_stat(traces, dt_out):
    """Coefficient of variation of ISIs pooled across replicates (None if
    fewer than two intervals are available)."""
    pools = [isis_of_trace(traces[r], dt_out) for r in range(traces.shape[0])]
    isi = np.concatenate(pools) if pools else np.empty(0)
    if isi.size >= 2 and isi.mean() > 0:
        return float(isi.std(ddof=1) / isi.mean())
    return None


def meanfield_run(ip3, T_obs, dt_out):
    """Deterministic mean-field reference: dynamic 8-state occupancies coupled
    to the Ca balance (Li-Rinzel analogue). Returns (c_trace, mean open frac)."""
    dt = 1.0e-3
    n = int(round(T_obs / dt))
    ns = int(round(T_obs / dt_out))
    every = n // ns
    x = stat8(ip3, CA_INIT)
    c = CA_INIT
    out = np.empty(ns)
    rec = 0
    km2 = KM * KM
    for step in range(n):
        if step % every == 0 and rec < ns:
            out[rec] = c
            rec += 1

        def F(xx, cc):
            dx = qmat(ip3, max(cc, 1e-12)).T @ xx
            ll = (C0 - cc) / C1
            J = C1 * (V1 * xx[3] ** 3 + V2) * (ll - cc) - VMAX * cc * cc / (km2 + cc * cc)
            return dx, J

        k1x, k1c = F(x, c)
        k2x, k2c = F(x + dt / 2 * k1x, c + dt / 2 * k1c)
        k3x, k3c = F(x + dt / 2 * k2x, c + dt / 2 * k2c)
        k4x, k4c = F(x + dt * k3x, c + dt * k3c)
        x = x + dt / 6 * (k1x + 2 * k2x + 2 * k3x + k4x)
        c = c + dt / 6 * (k1c + 2 * k2c + 2 * k3c + k4c)
        x = np.maximum(x, 0)
        x = x / x.sum()
        c = max(c, 0.0)
    return out, float(x[3] ** 3)


