def build_panels(traces, ip3_levels, channel_counts, period, cv, p_open,
                 rep_ip3_idx, rep_N_idx, mf_open):
    """Panel specifications shared by both renderers."""
    t = np.arange(N_SAMPLES) * DT_OUT
    key = f"ip3{rep_ip3_idx}_N{rep_N_idx}"
    mf_c, _ = meanfield_run(ip3_levels[rep_ip3_idx], T_OBS, DT_OUT)

    panels = [
        {
            "title": f"Representative trace: IP3={ip3_levels[rep_ip3_idx]:g} uM, "
                     f"N={channel_counts[rep_N_idx]}",
            "xlabel": "time (s)",
            "ylabel": "Ca_cyt (uM)",
            "series": [
                (t, traces[key][0], "k-", "stochastic"),
                (t, mf_c, "r--", "mean-field"),
            ],
        },
        {
            "title": "Period vs IP3 (largest N=%d)" % channel_counts[-1],
            "xlabel": "IP3 (uM)",
            "ylabel": "period (s)",
            "series": [(ip3_levels, _clean(period), "bo-", "peak-to-peak mean")],
        },
        {
            "title": "CV of ISI vs N (IP3=%g uM)" % ip3_levels[CR_IP3_IDX_USED],
            "xlabel": "N (channels, log scale)",
            "ylabel": "CV of ISI",
            "logx": True,
            "xticks": channel_counts,
            "series": [(channel_counts, _clean(cv), "bo-", "CV of ISI")],
        },
        {
            "title": "Open probability vs IP3 (largest N=%d)" % channel_counts[-1],
            "xlabel": "IP3 (uM)",
            "ylabel": "p_open",
            "series": [
                (ip3_levels, p_open, "bo-", "simulated (time-avg)"),
                (ip3_levels, mf_open, "rs--", "mean-field p3^3"),
            ],
        },
    ]
    return panels


def _clean(vals):
    return [v if v is not None else np.nan for v in vals]


def render_panels_mpl(panels, path):
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt
    from matplotlib.ticker import ScalarFormatter

    fig, axes = plt.subplots(2, 2, figsize=(13, 9))
    for ax, p in zip(axes.ravel(), panels):
        for xv, yv, style, label in p["series"]:
            xv = np.asarray(xv, dtype=float)
            yv = np.asarray(yv, dtype=float)
            ok = np.isfinite(yv) & np.isfinite(xv)
            if ok.sum() == 0:
                continue
            ax.plot(xv[ok], yv[ok], style, label=label, markersize=4, linewidth=1.4)
        ax.set_title(p["title"], fontsize=10)
        ax.set_xlabel(p["xlabel"])
        ax.set_ylabel(p["ylabel"])
        if p.get("logx"):
            ax.set_xscale("log")
            ax.set_xticks(p["xticks"])
            ax.xaxis.set_major_formatter(ScalarFormatter())
        ax.legend(fontsize=8, loc="best")
    fig.tight_layout()
    fig.savefig(path, dpi=110)
    plt.close(fig)


