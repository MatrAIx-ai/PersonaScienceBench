oA = np.dstack(np.unravel_index(np.argsort(
    -np.where(np.eye(n_g, dtype=bool), -1.0, scoreA).ravel()), (n_g, n_g)))[0][:50]
oB = np.dstack(np.unravel_index(np.argsort(
