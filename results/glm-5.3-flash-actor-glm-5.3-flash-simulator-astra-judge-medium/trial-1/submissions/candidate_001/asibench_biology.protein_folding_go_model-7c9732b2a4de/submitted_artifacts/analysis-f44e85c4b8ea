W_CANVAS, H_CANVAS = 1600, 1100
canvas = np.full((H_CANVAS, W_CANVAS, 3), 255, dtype=np.uint8)

def set_px(xx, yy, col):
    if 0 <= yy < H_CANVAS and 0 <= xx < W_CANVAS:
        canvas[yy, xx] = col

def draw_line(x0, y0, x1, y1, col, thick=1, dash=0):
    dx, dy = x1 - x0, y1 - y0
    n = int(max(abs(dx), abs(dy))) + 1
    for i in range(n + 1):
        if dash and (i // max(1, dash)) % 2:
            continue
        xx = int(round(x0 + dx * i / n)); yy = int(round(y0 + dy * i / n))
        for ox in range(thick):
            for oy in range(thick):
                set_px(xx + ox, yy + oy, col)

def draw_disc(cx, cy, r, col):
    for yy in range(int(cy - r), int(cy + r) + 1):
        for xx in range(int(cx - r), int(cx + r) + 1):
            if (xx - cx) ** 2 + (yy - cy) ** 2 <= r * r:
                set_px(xx, yy, col)

def draw_text(x0, y0, text, scale=2, col=(0, 0, 0)):
    cx = x0
    for ch in text:
        g = FONT.get(ch.upper(), FONT[' '])
        for rr in range(5):
            for cc in range(3):
                if g[rr * 3 + cc] == '1':
                    for ox in range(scale):
                        for oy in range(scale):
                            set_px(cx + cc * scale + ox, y0 + rr * scale + oy, col)
        cx += 4 * scale

# viridis LUT (16 anchors)
_V = np.array([
 [68,1,84],[72,40,120],[62,74,137],[49,104,142],[38,130,142],[31,158,137],
 [53,183,121],[109,205,89],[180,222,44],[253,231,37]], float)
def viridis(t):
    t = np.clip(t, 0, 1)
    return np.array([np.interp(t, np.linspace(0, 1, len(_V)), _V[:, k])
                     for k in range(3)], dtype=np.uint8)

PAL = [(31,119,180),(255,127,14),(44,160,44),(214,39,40),(148,103,189),
       (140,86,75),(227,119,194)]
RED = (214, 39, 40); BLK = (0, 0, 0); GRAY = (128, 128, 128)

class Panel:
    def __init__(self, x0, y0, w, h, xlim, ylim):
        self.x0, self.y0, self.w, self.h = x0, y0, w, h
        self.xlim, self.ylim = xlim, ylim
        draw_line(x0, y0, x0 + w, y0, BLK, 2)
        draw_line(x0, y0 + h, x0 + w, y0 + h, BLK, 2)
        draw_line(x0, y0, x0, y0 + h, BLK, 2)
        draw_line(x0 + w, y0, x0 + w, y0 + h, BLK, 2)
    def map(self, xd, yd):
        fx = (xd - self.xlim[0]) / (self.xlim[1] - self.xlim[0])
        fy = (yd - self.ylim[0]) / (self.ylim[1] - self.ylim[0])
        return self.x0 + fx * self.w, self.y0 + self.h - fy * self.h
    def xticks(self, vals, fmt='%.2f', scale=2):
        for v in vals:
            px, py = self.map(v, self.ylim[0])
            draw_line(px, self.y0 + self.h, px, self.y0 + self.h + 6, BLK, 1)
            s = fmt % v
            draw_text(int(px) - 3 * len(s) * scale, self.y0 + self.h + 9, s,
                      scale, BLK)
    def yticks(self, vals, fmt='%.2f', scale=2):
        for v in vals:
