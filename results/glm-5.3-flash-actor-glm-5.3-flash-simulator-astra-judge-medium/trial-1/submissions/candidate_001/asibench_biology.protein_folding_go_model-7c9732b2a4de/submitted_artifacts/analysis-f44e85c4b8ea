# ---- PNG encoder ----
def write_png(path, rgb):
    hgt, wid, _ = rgb.shape
    raw = b''.join(b'\x00' + rgb[i].tobytes() for i in range(hgt))
    def chunk(typ, data):
        return (struct.pack('>I', len(data)) + typ + data +
                struct.pack('>I', zlib.crc32(typ + data) & 0xffffffff))
    png = (b'\x89PNG\r\n\x1a\n' +
           chunk(b'IHDR', struct.pack('>IIBBBBB', wid, hgt, 8, 2, 0, 0, 0)) +
           chunk(b'IDAT', zlib.compress(raw, 6)) + chunk(b'IEND', b''))
    with open(path, 'wb') as fh:
        fh.write(png)

write_png('visualization.png', canvas)
print('visualization.png written (%dx%d px, rasterized without matplotlib)'
      % (W_CANVAS, H_CANVAS))
