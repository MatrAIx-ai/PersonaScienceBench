def write_png_fallback(path, title, labels, values):
    """Render a bar chart to PNG with numpy+zlib only (no matplotlib needed)."""
    W, H = 1100, 560
    img = np.full((H, W, 3), 255, dtype=np.uint8)

    def draw_text(x, y, text, scale=2, color=(20, 20, 20)):
        for ch in text:
            g = GL.get(ch.upper(), GL[' '])
            for r in range(7):
                for c in range(5):
                    if g[r][c] == '1':
                        img[y + r * scale:y + (r + 1) * scale,
                            x + c * scale:x + (c + 1) * scale] = color
            x += 6 * scale

    draw_text(30, 24, title, scale=3)
    x0, y0, x1, y1 = 90, 480, 1050, 90
    img[y0:y1, x0] = 120
    img[y0, x0:x1] = 120
    n = len(labels)
    bw_px = (x1 - x0 - 40) / n
    best = labels[int(np.argmax(values))]
    for i, (lab, v) in enumerate(zip(labels, values)):
        h = int(v * (y0 - y1 - 40))
        bx = int(x0 + 20 + i * bw_px + bw_px * 0.15)
        bwid = int(bw_px * 0.7)
        img[y0 - h:y0, bx:bx + bwid] = (30, 140, 60) if lab == best else (60, 110, 200)
        draw_text(bx - 6, y0 + 8, lab, scale=2)
        draw_text(bx - 6, y0 - h - 22, f"{v:.3f}", scale=2)
    raw = b"".join(b"\x00" + img[y].tobytes() for y in range(H))

    def chunk(tag, data):
        c = struct.pack(">I", len(data)) + tag + data
        return c + struct.pack(">I", zlib.crc32(tag + data) & 0xFFFFFFFF)

    png = (b"\x89PNG\r\n\x1a\n"
           + chunk(b"IHDR", struct.pack(">IIBBBBB", W, H, 8, 2, 0, 0, 0))
           + chunk(b"IDAT", zlib.compress(raw, 6))
           + chunk(b"IEND", b""))
    with open(path, "wb") as fh:
        fh.write(png)


