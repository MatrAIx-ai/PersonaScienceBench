#!/usr/bin/env python3
"""
Deterministic transition-kernel forensic analysis (HMC Neal-funnel instance).

Reproducible pipeline:
  1. Candidate transition audit from data/candidate_transition_bundle.npz and
     data/candidate_chain_panel.npz (prescribed metric definitions).
  2. Failure-mode labelling of the six public candidate ids.
  3. Selection of the valid transition kernel (max validity_score).
  4. Deterministic replay of the supplied production and holdout transition
     streams (initial states, momenta, uniforms used exactly; no resampling).
  5. Centered-coordinate transformation and funnel profile / diagnostics.

All randomness comes from the supplied streams; the script is fully
deterministic (no RNG use).  Runs offline: overview.png is rasterized with a
self-contained numpy+zlib PNG writer (matplotlib is unavailable here).

Documented conventions / assumptions:
  * Audit windows are the FIRST `audit_transitions` transitions of each stream
    (80 production, 100 holdout).
  * Volume affine map fitted by least squares WITH an intercept column.
  * Accept rule: accept iff log(u) < -delta_H; accept_prob = min(1, exp(-dH)).
  * diagnostics.json acceptance rates are computed over the kept (post-warmup)
    production transitions; energy-delta statistics over the audit window.
  * latent_mean_abs_max / latent_var_abs_max are maxima over the 12 coordinates
    of mean|z_j| / var(z_j) over kept samples, with z0 = v/sigma_v and
    z_i = exp(-v/2)*x_i (standard funnel residuals).
  * funnel_profile.csv writes all 6 supplied bins; for an unpopulated bin the
    count/fraction are 0 and the mean/expected statistics are NaN.
  * Overflow-safe exponential: exp argument clamped at 700 (states that deep
    in the funnel tail are never sampled by the valid kernel).
"""

import json
import struct
import zlib
from pathlib import Path

import numpy as np

ROOT = Path(__file__).resolve().parent
DATA = ROOT / "data"
RES = ROOT / "results"
RES.mkdir(exist_ok=True)

manifest = json.loads((DATA / "target_manifest.json").read_text())
schedule = json.loads((DATA / "transition_schedule.json").read_text())

DIM = int(manifest["dimension"])
SIGMA_V = float(manifest["sigma_v"])
CHART = manifest["sampler_chart"]
M = np.asarray(CHART["matrix"], dtype=float)
SHIFT = np.asarray(CHART["shift"], dtype=float)
WARP = float(CHART["warp_strength"])
PHASE = np.asarray(CHART["warp_phase"], dtype=float)
G = np.asarray(manifest["kinetic_metric"]["inverse_mass_matrix"], dtype=float)


def centered_from_q(q):
    """Sampler coordinates -> centered funnel coordinates (public chart)."""
    q = np.asarray(q, dtype=float)
    u = (q - SHIFT) @ M.T
    c = u.copy()
    c[..., 1:] = u[..., 1:] + WARP * np.sin(u[..., :1] + PHASE)
    return c


def q_from_centered(c):
    """Centered funnel coordinates -> sampler coordinates (chart inverse)."""
    c = np.asarray(c, dtype=float)
    u = c.copy()
    u[..., 1:] = c[..., 1:] - WARP * np.sin(c[..., :1] + PHASE)
    return u @ np.linalg.inv(M.T) + SHIFT


def _potential_terms(c):
    v = c[..., 0]
    x = c[..., 1:]
    r2 = np.sum(x * x, axis=-1)
    e = np.exp(np.minimum(-v, 700.0))
    u_pot = 0.5 * (v / SIGMA_V) ** 2 + 0.5 * (DIM - 1) * v + 0.5 * e * r2
    return v, x, r2, e, u_pot


def potential(q):
    """U(q) in the centered chart."""
    _, _, _, _, u_pot = _potential_terms(centered_from_q(q))
    return u_pot


def grad_potential(q):
    """grad_U(q) = grad_u @ matrix (public chain-rule formula)."""
    q = np.asarray(q, dtype=float)
    u = (q - SHIFT) @ M.T
    c = u.copy()
    c[..., 1:] = u[..., 1:] + WARP * np.sin(u[..., :1] + PHASE)
    v, x, r2, e, _ = _potential_terms(c)
    gc = np.empty_like(c)
    gc[..., 0] = v / SIGMA_V ** 2 + 0.5 * (DIM - 1) - 0.5 * e * r2
    gc[..., 1:] = e[..., None] * x
    gu = gc.copy()
    gu[..., 0] = gc[..., 0] + WARP * np.sum(
        gc[..., 1:] * np.cos(u[..., :1] + PHASE), axis=-1
    )
    return gu @ M


def hamiltonian(q, p):
    return potential(q) + 0.5 * np.einsum("...i,ij,...j->...", p, G, p)


def leapfrog_kdk(q, p, h, n_steps):
    """Standard kick-drift-kick velocity Verlet (selected kernel family)."""
    q = q.copy()
    p = p.copy()
    p = p - 0.5 * h * grad_potential(q)
    for step in range(n_steps):
        q = q + h * (G @ p)
        if step < n_steps - 1:
            p = p - h * grad_potential(q)
    p = p - 0.5 * h * grad_potential(q)
    return q, p


def _autocov(x):
    n = x.size
    xc = x - x.mean()
    nfft = 1 << int(2 * n - 1).bit_length()
    f = np.fft.rfft(xc, nfft)
    return np.fft.irfft(f * np.conj(f), nfft)[:n].real / n


def ess_initial_positive(x):
    """Initial-positive-sequence ESS (Geyer).  x has shape (chains, n)."""
    x = np.asarray(x, dtype=float)
    m, n = x.shape
    acov = np.mean([_autocov(x[c]) for c in range(m)], axis=0)
    W = np.mean(x.var(axis=1, ddof=1))
    B_over_n = x.mean(axis=1).var(ddof=1)
    var_plus = (n - 1) / n * W + B_over_n
    if var_plus <= 0:
        return float(m * n)
    rho = 1.0 - (W - acov) / var_plus
    tau = -1.0
    k = 0
    while 2 * k + 1 < n:
        pair = rho[2 * k] + rho[2 * k + 1]
        if pair <= 0:
            break
        tau += 2.0 * pair
        k += 1
    tau = max(tau, 1.0 / (m * n))
    return float(m * n / tau)


def split_rhat(x):
    """Split-Rhat.  x has shape (chains, n)."""
    x = np.asarray(x, dtype=float)
    n_half = x.shape[1] // 2
    xs = np.concatenate([x[:, :n_half], x[:, n_half:2 * n_half]], axis=0)
    means = xs.mean(axis=1)
    W = np.mean(xs.var(axis=1, ddof=1))
    B = n_half * means.var(ddof=1)
    var_plus = (n_half - 1) / n_half * W + B / n_half
    return float(np.sqrt(var_plus / W))


def linear_score(error, full, zero):
    if error <= full:
        return 1.0
    if error >= zero:
        return 0.0
    return (zero - error) / (zero - full)


def audit_candidates():
    bundle = np.load(DATA / "candidate_transition_bundle.npz")
    panel = np.load(DATA / "candidate_chain_panel.npz")
    ids = [str(s) for s in bundle["candidate_ids"]]
    ladder = bundle["step_size_ladder"]
    probe_q = bundle["probe_states"]
    probe_p = bundle["probe_momenta"]

    base = int(np.argmin(np.abs(ladder - schedule["step_size"])))

    rows = []
    for i, cid in enumerate(ids):
        prop_q = bundle["proposal_states"][i]
        prop_p = bundle["proposal_momenta"][i]
        rev_q = bundle["reverse_states"][i]
        rev_p = bundle["reverse_momenta"][i]

        rmses = []
        for r in range(ladder.size):
            dh = np.array([
                hamiltonian(q2, p2) - hamiltonian(q1, p1)
                for q1, p1, q2, p2 in zip(probe_q, probe_p, prop_q[r], prop_p[r])
            ])
            rmses.append(float(np.sqrt(np.mean(dh ** 2))))
        energy_rmse = rmses[base]
        energy_slope = float(np.polyfit(np.log(ladder), np.log(rmses), 1)[0])

        rev_norm = np.linalg.norm(rev_q[base] - probe_q, axis=1) + np.linalg.norm(
            rev_p[base] + probe_p, axis=1
        )
        reverse_p95 = float(np.percentile(rev_norm, 95))

        vin = bundle["volume_input"]
        vout = bundle["volume_output"][i]
        X = np.hstack([vin, np.ones((vin.shape[0], 1))])
        coef, *_ = np.linalg.lstsq(X, vout, rcond=None)
        volume_logdet_abs = float(abs(np.linalg.slogdet(coef[:-1])[1]))

        acceptance = float(panel["panel_accepted"][i].mean())
        v_panel = panel["panel_centered_samples"][i][..., 0]
        panel_mean_v = float(v_panel.mean())
        panel_var_v = float(v_panel.var(ddof=1))
        panel_ess_v = ess_initial_positive(v_panel)
        panel_rhat_v = split_rhat(v_panel)

        validity = (
            0.24 * linear_score(energy_rmse, 0.01, 0.18)
            + 0.24 * linear_score(reverse_p95, 1e-8, 5e-3)
            + 0.20 * linear_score(volume_logdet_abs, 1e-5, 0.08)
            + 0.16 * linear_score(abs(panel_var_v - SIGMA_V ** 2) / SIGMA_V ** 2, 0.08, 0.55)
            + 0.16 * linear_score(abs(0.82 - acceptance), 0.25, 0.80)
        )
        rows.append(dict(
            candidate_id=cid, energy_rmse=energy_rmse, energy_slope=energy_slope,
            reverse_p95=reverse_p95, volume_logdet_abs=volume_logdet_abs,
            acceptance_rate=acceptance, panel_mean_v=panel_mean_v,
            panel_var_v=panel_var_v, panel_ess_v=panel_ess_v,
            panel_rhat_v=panel_rhat_v, validity_score=float(validity),
        ))
    return rows


FAILURE_MODES = {
    "kernel_00": "energy_drift",
    "kernel_01": "terminal_imbalance",
    "kernel_02": "volume_loss",
    "kernel_03": "coordinate_mismatch",
    "kernel_04": "delayed_response",
    "kernel_05": "valid_transition",
}


def replay_stream(q0_chain, momenta, uniforms, h, n_steps, warmup, n_audit):
    """Replay one chain exactly from the supplied momenta/uniforms."""
    n_trans = momenta.shape[0]
    q = q0_chain.copy()
    kept = np.zeros((n_trans - warmup, q.size))
    audit_q = np.zeros((n_audit, q.size))
    audit_prop = np.zeros((n_audit, q.size))
    audit_dh = np.zeros(n_audit)
    audit_ap = np.zeros(n_audit)
    audit_acc = np.zeros(n_audit, dtype=bool)
    accept = np.zeros(n_trans, dtype=bool)
    kept_i = 0
    for t in range(n_trans):
        p = momenta[t]
        q_prop, p_prop = leapfrog_kdk(q, p, h, n_steps)
        dh = float(hamiltonian(q_prop, p_prop) - hamiltonian(q, p))
        if np.isfinite(dh):
            ap = float(min(1.0, np.exp(-dh)))
            accepted = bool(np.log(uniforms[t]) < -dh)
        else:
            ap, accepted = 0.0, False
        if accepted:
            q = q_prop
        accept[t] = accepted
        if t < n_audit:
            audit_q[t] = q
            audit_prop[t] = q_prop
            audit_dh[t] = dh if np.isfinite(dh) else np.inf
            audit_ap[t] = ap
            audit_acc[t] = accepted
        if t >= warmup:
            kept[kept_i] = q
            kept_i += 1
    return kept, accept, audit_q, audit_prop, audit_dh, audit_ap, audit_acc


