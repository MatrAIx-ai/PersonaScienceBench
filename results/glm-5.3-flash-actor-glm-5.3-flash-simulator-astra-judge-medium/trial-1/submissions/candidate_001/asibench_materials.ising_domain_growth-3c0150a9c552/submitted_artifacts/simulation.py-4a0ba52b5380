# ----------------------------------------------------------------- dynamics
def make_prob_table(temp):
    # dE = 2*s*nb with nb in {-4,-2,0,2,4}  ->  dE in {-8,-4,0,4,8};
    # lookup index = dE//2 + 4 so prob_table[dE//2+4] = exp(-dE/T) for dE > 0.
    pt = np.ones(9)
    for d in (-8, -4, 0, 4, 8):
        pt[d // 2 + 4] = 1.0 if d <= 0 else float(np.exp(-d / temp))
    return pt


def sweep(state, temp, rng, prob_table):
    """One full checkerboard Metropolis sweep (two sublattice passes)."""
    ii, jj = np.indices(state.shape)
    par = (ii + jj) % 2
    for parity in (0, 1):
        nb = (np.roll(state, 1, 0) + np.roll(state, -1, 0)
              + np.roll(state, 1, 1) + np.roll(state, -1, 1))
        dE = 2 * state * nb                      # values in {-8,-4,0,4,8}
        accept = (dE <= 0) | (rng.random(state.shape) < prob_table[dE // 2 + 4])
        state = np.where((par == parity) & accept, -state, state)
    return state


def wall_density(state):
    rho_h = np.mean(state != np.roll(state, -1, 1))
    rho_v = np.mean(state != np.roll(state, -1, 0))
    return 0.5 * (rho_h + rho_v)


def energy_per_site(state):
    bonds = (np.sum(state * np.roll(state, 1, 0))
             + np.sum(state * np.roll(state, 1, 1)))
    return -bonds / state.size


def correlation(state, max_r):
    """Direction-averaged (radially binned) circular correlation C(r)."""
    s = state.astype(np.float64)
    f = np.fft.fft2(s)
    ac = np.fft.ifft2(f * np.conj(f)).real / s.size   # ac[d] = <s(x)s(x+d)>
    n0, n1 = s.shape
    dx = np.arange(n0); dx = np.where(dx <= n0 // 2, dx, dx - n0)
    dy = np.arange(n1); dy = np.where(dy <= n1 // 2, dy, dy - n1)
    DX, DY = np.meshgrid(dx, dy, indexing="ij")
    dist = np.sqrt(DX.astype(float) ** 2 + DY.astype(float) ** 2)
    C = np.zeros(max_r)
    for r in range(max_r):
        sel = (dist >= r - 0.5) & (dist < r + 0.5) if r > 0 else (dist < 0.5)
        if np.any(sel):
            C[r] = ac[sel].mean()
    return C


def domain_length(rho, grid):
    """Domain length L = 1/rho (inverse domain-wall density).

    During coarsening this tracks the growing domain size; once the finite
    system equilibrates, rho measures the equilibrium thermal-droplet density
    and L saturates near 1/rho_eq.  The guard keeps L finite for rho -> 0.
    """
    return float(1.0 / max(rho, 1.0 / (grid * grid)))


def collapse(curves, lengths, m2s, r_max):
    """Family-Vicsek collapse of the connected correlation vs x = r/L(t).

    y(r,t) = (C(r,t) - m(t)^2) / (1 - m(t)^2) is the connected, normalised
    correlation; each curve is interpolated onto a 200-point grid over the
    common overlap x in [0, min_i((r_max-1)/L_i)].
    """
    Ls = np.asarray(lengths, float)
    if len(Ls) < 2 or not np.all(np.isfinite(Ls)) or np.any(Ls <= 0):
        return None
    x_max = min((r_max - 1) / Li for Li in Ls)
    if not np.isfinite(x_max) or x_max <= 0:
        return None
    xg = np.linspace(0.0, x_max, 200)
    ys = np.array([np.interp(xg, np.arange(r_max) / Li,
                             (np.asarray(c, float) - m2) / max(1.0 - m2, 1e-12))
                   for c, Li, m2 in zip(curves, Ls, m2s)])
    master = ys.mean(axis=0)
    denom = np.sqrt(np.mean(master ** 2))
    rel = float(np.sqrt(np.mean((ys - master) ** 2)) / denom) if denom > 0 else np.inf
    quality = float(np.clip(1.0 - rel, 0.0, 1.0))
    return {"x": xg, "ys": ys, "master": master, "rel": rel,
            "quality": quality, "x_range": [0.0, float(x_max)]}


