"""Validation harness for analysis.py (not part of the submission artifact)."""
import json, math, heapq, collections
import analysis
from analysis import make_policy, ACTIONS, OPPOSITE

OFFS = {"U": (-1, 0), "D": (1, 0), "L": (0, -1), "R": (0, 1)}

td = json.load(open("data/training_levels.json"))
pe = json.load(open("data/public_eval_levels.json"))
policy = make_policy(td, None)
print("learned: cont_rate=%.4f cont_eps=%.4f" % (policy.cont_rate, policy.cont_eps))
for p in "UDLR":
    print("  turn prior", p, {k: round(v, 3) for k, v in policy.turn_prior.get(p, {}).items()})
print("  first prior", {k: round(v, 3) for k, v in policy.first_prior.items()})

# ------------------------------------------------------------------ #
# (a) trajectory replay with synthetic scorer-style observations
# ------------------------------------------------------------------ #
def state_for(level, r, c, prev, hist, legal):
    g = level["grid"]; H, W = len(g), len(g[0])
    nb = {}
    for a in ACTIONS:
        dr, dc = OFFS[a]
        rr, cc = r + dr, c + dc
        nb[a] = g[rr][cc] if 0 <= rr < H and 0 <= cc < W else "#"
    mask = [1 if a in legal else 0 for a in ACTIONS]
    depth = len(hist)
    return {
        "cell": g[r][c],
        "neighbors": nb,
        "previous_action": prev,
        "history": list(hist),
        "history_tail": list(hist[-4:]),
        "run_length_bucket": min(4, len(hist) - len(hist.lstrip()) if False else sum(
            1 for i in range(len(hist) - 1, -1, -1) if i == 0 or hist[i] == hist[i - 1])),
        "depth": depth,
        "depth_mod": depth % 4,
        "depth_phase": depth // 8,
        "legal_mask": mask,
        "legal_actions": list(legal),
    }

stats = collections.Counter(); mass = {"continue": [], "forced": [], "branch": [], "first": []}
fails = []
for lev in td["levels"]:
    g = lev["grid"]; H, W = len(g), len(g[0]); goal = tuple(lev["goal"])
    r, c = lev["start"]; prev = None; hist = []
    for a in lev["solution"]:
        legal = [x for x in ACTIONS
                 if 0 <= r + OFFS[x][0] < H and 0 <= c + OFFS[x][1] < W
                 and g[r + OFFS[x][0]][c + OFFS[x][1]] != "#"]
        st = state_for(lev, r, c, prev, hist, legal)
        probs = policy.action_probs({"id": lev["id"]}, st, legal)
        assert abs(sum(probs.values()) - 1) < 1e-9
        assert set(probs) <= set(legal)
        pred = max(probs, key=probs.get)
        kind = ("first" if prev is None else
                "continue" if a == prev else
                "forced" if OPPOSITE[prev] not in legal else "branch")
        stats[kind + "_total"] += 1
        stats[kind + "_ok"] += int(pred == a)
        mass[kind].append(probs[a])
        if pred != a:
            fails.append((lev["id"], prev, a, legal, round(probs[a], 3)))
        prev = a; hist.append(a); r += OFFS[a][0]; c += OFFS[a][1]
tot = sum(stats[k + "_total"] for k in ("continue", "forced", "branch", "first"))
ok = sum(stats[k + "_ok"] for k in ("continue", "forced", "branch", "first"))
print("\n(a) replay: argmax-accuracy overall %d/%d = %.4f" % (ok, tot, ok / tot))
for k in ("first", "continue", "forced", "branch"):
    t, o = stats[k + "_total"], stats[k + "_ok"]
    m = mass[k]
    m_sorted = sorted(m)
    q = lambda f: m_sorted[int(f * (len(m_sorted) - 1))] if m_sorted else float("nan")
    print("   %-8s n=%-5d argmax-acc=%.4f  mass-on-true mean=%.3f median=%.3f p10=%.3f" %
          (k, t, o / t if t else float("nan"), sum(m) / len(m) if m else float("nan"), q(0.5), q(0.1)))
print("   first mismatches are expected (no information at cold start); first n=%d" % stats["first_total"])

# ------------------------------------------------------------------ #
# (b) expansion-count simulation on the 4 public levels
# ------------------------------------------------------------------ #
def astar(level, lam):
    g = level["grid"]; goal = tuple(level["goal"]); start = tuple(level["start"])
    H, W = len(g), len(g[0])
    def legal(r, c):
        return [x for x in ACTIONS
                if 0 <= r+OFFS[x][0] < H and 0 <= c+OFFS[x][1] < W
                and g[r+OFFS[x][0]][c+OFFS[x][1]] != "#"]
    def h(rc): return abs(rc[0]-goal[0]) + abs(rc[1]-goal[1])
    heap = []; counter = 0
    heapq.heappush(heap, (lam*h(start), 0.0, counter, start, None))
    bestg = {start: 0.0}; expansions = 0
    while heap:
        f, cost, _, stt, prev = heapq.heappop(heap)
        expansions += 1
        if stt == goal: return expansions
        probs = policy.action_probs({}, {"previous_action": prev}, legal(stt[0], stt[1]))
        for a, pr in probs.items():
            ns = (stt[0]+OFFS[a][0], stt[1]+OFFS[a][1])
            nc = cost - math.log(pr)
            if bestg.get(ns, float("inf")) > nc:
                bestg[ns] = nc; counter += 1
                heapq.heappush(heap, (nc + lam*h(ns), nc, counter, ns, a))
    return None

def bfs_unguided(level):
    g = level["grid"]; goal = tuple(level["goal"]); start = tuple(level["start"])
    H, W = len(g), len(g[0])
    def legal(r, c):
        return [x for x in ACTIONS
                if 0 <= r+OFFS[x][0] < H and 0 <= c+OFFS[x][1] < W
                and g[r+OFFS[x][0]][c+OFFS[x][1]] != "#"]
    heap = []; counter = 0
    heapq.heappush(heap, (0.0, counter, start, None))
    bestg = {start: 0.0}; expansions = 0
    while heap:
        cost, _, stt, prev = heapq.heappop(heap)
        expansions += 1
        if stt == goal: return expansions
        probs = policy.action_probs({}, {"previous_action": prev}, legal(stt[0], stt[1]))
        for a, pr in probs.items():
            ns = (stt[0]+OFFS[a][0], stt[1]+OFFS[a][1])
            nc = cost - math.log(pr)
            if bestg.get(ns, float("inf")) > nc:
                bestg[ns] = nc; counter += 1
                heapq.heappush(heap, (nc, counter, ns, a))
    return None

def dfs(level):
    g = level["grid"]; goal = tuple(level["goal"]); start = tuple(level["start"])
    H, W = len(g), len(g[0])
    def legal(r, c):
        return [x for x in ACTIONS
                if 0 <= r+OFFS[x][0] < H and 0 <= c+OFFS[x][1] < W
                and g[r+OFFS[x][0]][c+OFFS[x][1]] != "#"]
    visited = set(); expansions = 0
    def rec(stt, prev):
        nonlocal expansions
        if stt == goal: return True
        if stt in visited: return False
        visited.add(stt); expansions += 1
        probs = policy.action_probs({}, {"previous_action": prev}, legal(stt[0], stt[1]))
        for a, _ in sorted(probs.items(), key=lambda kv: -kv[1]):
            ns = (stt[0]+OFFS[a][0], stt[1]+OFFS[a][1])
            if ns not in visited and rec(ns, a): return True
        return False
    rec(start, None)
    return expansions

print("\n(b) expansion simulation on public levels (budget = %d)" % pe["budget"])
for name, fn in (("weighted A* lam=1", lambda l: astar(l, 1.0)),
                 ("weighted A* lam=2", lambda l: astar(l, 2.0)),
                 ("pure A* (h only)", lambda l: astar(l, 1e-4)),
                 ("unguided best-first", bfs_unguided),
                 ("DFS (policy order)", dfs)):
    res = [(lev["id"], fn(lev)) for lev in pe["levels"]]
    worst = max(e for _, e in res)
    print("   %-20s %s  worst=%d %s" % (name, res, worst, "OK" if worst <= pe["budget"] else "OVER"))

# reference: oracle (goal-aware greedy) under the same regimes
def oracle_bf(level):
    g = level["grid"]; goal = tuple(level["goal"]); start = tuple(level["start"])
    H, W = len(g), len(g[0])
    def legal(r, c):
        return [x for x in ACTIONS
                if 0 <= r+OFFS[x][0] < H and 0 <= c+OFFS[x][1] < W
                and g[r+OFFS[x][0]][c+OFFS[x][1]] != "#"]
    heap = []; counter = 0
    heapq.heappush(heap, (0.0, counter, start, None))
    bestg = {start: 0.0}; expansions = 0
    while heap:
        cost, _, stt, prev = heapq.heappop(heap)
        expansions += 1
        if stt == goal: return expansions
        lgl = legal(stt[0], stt[1])
        if prev is not None and prev in lgl:
            probs = {prev: 1.0}
        else:
            cand = {a: 1.0 for a in lgl if prev is None or a != OPPOSITE.get(prev)} or {OPPOSITE[prev]: 1.0}
            best = min(cand, key=lambda a: abs(stt[0]+OFFS[a][0]-goal[0]) + abs(stt[1]+OFFS[a][1]-goal[1]))
            probs = {a: (1.0 if a == best else 0.1) for a in cand}
        for a, p in probs.items():
            ns = (stt[0]+OFFS[a][0], stt[1]+OFFS[a][1])
            nc = cost - math.log(p)
            if bestg.get(ns, float("inf")) > nc:
                bestg[ns] = nc; counter += 1
                heapq.heappush(heap, (nc, counter, ns, a))
    return expansions

tr_o = [oracle_bf(l) for l in td["levels"]]
print("   [reference] oracle best-first on training: mean=%.1f max=%d over95=%d" %
      (sum(tr_o)/len(tr_o), max(tr_o), sum(1 for x in tr_o if x > 95)))

