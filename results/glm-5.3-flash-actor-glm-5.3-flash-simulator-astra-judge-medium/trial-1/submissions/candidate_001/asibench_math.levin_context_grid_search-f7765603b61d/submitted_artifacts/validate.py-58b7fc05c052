print("\n(c) smoke tests")
tests = [
    ({}, {}, ["U", "D", "L", "R"]),
    ({}, {}, []),
    ({}, {"previous_action": None}, ["U", "R"]),
    ({}, {"legal_mask": [0, 1, 1, 1]}, None),
    ({}, {"legal_mask": "0110"}, None),
    ({}, {"legal_mask": 0b0011}, None),
    ({}, {"legal_actions": ["U", "D"]}, None),
    ({}, {"neighbors": {"U": "a", "D": "#", "L": "b", "R": "c"}}, None),
    ({}, {"neighbors": ["a", "#", "b", "c"]}, None),
    ({}, {"neighbors": {"up": "a", "down": "#", "left": "b", "right": "c"},
          "previous_action": "L"}, None),
    ({}, {"previous_action": "U", "history": ["U", "D", "U"], "legal_actions": ["D", "L", "R"]}, None),
    ({}, {"previous_action": "up", "history_tail": ["up"], "legal_actions": ["left", "right", "down"]}, None),
    ({}, {"previous_action": 0, "action_order": ["U", "D", "L", "R"], "legal_actions": [0, 1, 2, 3]}, None),
    ({}, None, ["U", "D", "L", "R"]),
    ({}, {"previous_action": "U", "history_tail": None, "legal_mask": [1, 1, 0, 0]}, None),
]
allok = True
for lv, st, la in tests:
    try:
        pr = policy.action_probs(lv, st, la)
        s = sum(pr.values())
        okp = all(isinstance(v, float) and math.isfinite(v) and v >= 0 for v in pr.values())
        print("   %-70s -> %s  sum=%.4f finite+nonneg=%s" %
              (str(st)[:68] + (", la=%s" % la if la is not None else ""),
               {k: round(v, 3) for k, v in pr.items()}, s, okp))
        allok &= okp and (abs(s - 1) < 1e-6 or not pr)
    except Exception as exc:
        allok = False
        print("   EXCEPTION", st, la, exc)
print("   all smoke tests passed:", allok)
