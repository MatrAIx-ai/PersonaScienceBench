#!/usr/bin/env python3
"""
Complete computational study of the semilinear screened Poisson equation
    -Delta_M u + alpha*u + beta*u^3 = h
on a torus point cloud (theta, phi) in [0,2pi)^2, using a purely LOCAL
meshfree discretization (generalized moving least squares, GMLS) in the
parameter domain with the analytic diagonal torus metric.

Pipeline (all artifacts written under results/):
  Phase 1: GMLS discretization + convergence validation on f = sin(3t)cos(2p)
  Phase 2: damped Newton solver for the semilinear system + diagnostics
  Phase 3: point-cloud noise robustness, parameter sensitivity, linear-vs-nonlinear
  Phase 4: solution structure analysis and scientific interpretation

Numerical choices (fixed after a tuning study):
  polynomial degree l = 6 (from data/parameters.json), dim = 28 monomials
  stencil size k = 280 = 10*dim nearest neighbors (self included)
  weight w(s) = (1 - s^2)^6, s = param-distance / stencil radius rho_i
  (configuration chosen by a tuning study: it is the accurate
   degree-6 configuration whose discrete Laplacian spectrum stays
   below alpha, i.e. lambda_max(L)=0.69 < alpha=7.13, so the Newton
   matrix -L + diag(alpha + 3 beta u^2) is positive definite)
  local stabilization: SVD pseudo-inverse (rcond = 1e-8) of the weighted
    design matrix - used consistently for every operator build
  neighbor search: KD-tree on the 4D periodic embedding
    (cos t, sin t, cos p, sin p); its chord distance is a monotone function
    of the minimum-image parameter distance for offsets <= pi, so
    periodicity is respected; polynomial offsets use minimum-image wrap.
"""
import json
import os
import numpy as np
import scipy.sparse as sp
import scipy.sparse.linalg as spla
from scipy.sparse.linalg import splu, gmres, eigs
from scipy.sparse.csgraph import reverse_cuthill_mckee
from scipy.spatial import cKDTree

# ----------------------------------------------------------------- setup ---
PARAMS = json.load(open('data/parameters.json'))
R, Rr = PARAMS['R'], PARAMS['r']
ALPHA, BETA = PARAMS['alpha'], PARAMS['beta']
DEGREE = int(PARAMS['l'])
N = int(PARAMS['N'])
DIM = (DEGREE + 1) * (DEGREE + 2) // 2
K_STENCIL = 10 * DIM           # 280
WEXP = 6                       # weight exponent, w(s) = (1-s^2)^WEXP
RCOND = 1e-8                   # SVD truncation for local fits
CHUNK = 256

PTS = np.loadtxt('data/points_2d.csv', delimiter=',')
TH, PH = PTS[:, 0].copy(), PTS[:, 1].copy()
H = np.loadtxt('data/h_2d.csv')
assert PTS.shape == (N, 2) and H.shape == (N,), (PTS.shape, H.shape)

os.makedirs('results/discretization', exist_ok=True)
os.makedirs('results/solver', exist_ok=True)
os.makedirs('results/robustness', exist_ok=True)
os.makedirs('results/analysis', exist_ok=True)

def wrap(x):
    """minimum image mapping to [-pi, pi)"""
    return (x + np.pi) % (2.0 * np.pi) - np.pi

def monomial_terms(degree):
    """all (a,b) with a+b <= degree"""
    return [(a, b) for a in range(degree + 1) for b in range(degree + 1 - a)]

# ------------------------------------------------- GMLS operator builder ---
def build_gmls_rows(th, ph, degree=DEGREE, k=K_STENCIL, wexp=WEXP,
                    rcond=RCOND, chunk=CHUNK):
    """
    For every point, build GMLS weights for the three parameter-space
    derivative functionals d/dtheta, d2/dtheta2, d2/dphi2, using a
    degree-`degree` polynomial least-squares fit over its k nearest
    neighbors (periodic-aware).  Returns (idx, c_th, c_thth, c_phph, rho).
    """
    n = len(th)
    Q = np.column_stack([np.cos(th), np.sin(th), np.cos(ph), np.sin(ph)])
    _, idxq = cKDTree(Q).query(Q, k=k + 1)
    idx = np.column_stack([np.arange(n), idxq[:, 1:k]])  # self + (k-1) nearest
    terms = monomial_terms(degree)
    c_th = np.empty((n, k)); c_thth = np.empty((n, k)); c_phph = np.empty((n, k))
    rho = np.empty(n)
    for s0 in range(0, n, chunk):
        s1 = min(n, s0 + chunk); m = s1 - s0
        ii = idx[s0:s1]
        dth = wrap(th[ii] - th[s0:s1, None])
        dph = wrap(ph[ii] - ph[s0:s1, None])
        rr = np.sqrt(dth**2 + dph**2)
        rho_loc = rr.max(axis=1)
        X = dth / rho_loc[:, None]; Y = dph / rho_loc[:, None]
        Wd = np.where(rr / rho_loc[:, None] < 1.0,
                      (1.0 - (rr / rho_loc[:, None])**2)**wexp, 0.0)
        Wd[:, 0] = 1.0                       # the center point itself
        Psi = np.stack([X**a * Y**b for a, b in terms], axis=2)  # (m,k,d)
        Aw = Wd[:, :, None] * Psi
        U, S, Vt = np.linalg.svd(Aw, full_matrices=False)
        Sinv = np.where(S > S[:, 0:1] * rcond,
                        1.0 / np.where(S > S[:, 0:1] * rcond, S, 1.0), 0.0)
        # derivative functionals evaluated at the fit center (per-point rho)
        is_th   = np.array([(a == 1 and b == 0) for a, b in terms])
        is_thth = np.array([(a == 2 and b == 0) for a, b in terms])
        is_phph = np.array([(a == 0 and b == 2) for a, b in terms])
        g_th   = np.where(is_th[None, :], 1.0 / rho_loc[:, None], 0.0)
        g_thth = np.where(is_thth[None, :], 2.0 / rho_loc[:, None]**2, 0.0)
        g_phph = np.where(is_phph[None, :], 2.0 / rho_loc[:, None]**2, 0.0)
        def weights(g):
            t = np.einsum('med,md->me', Vt, g)        # Vt @ g, pointwise
            y = np.einsum('mke,me->mk', U, t * Sinv)  # U @ (Sinv * t)
            return Wd * y
        c_th[s0:s1] = weights(g_th)
        c_thth[s0:s1] = weights(g_thth)
        c_phph[s0:s1] = weights(g_phph)
        rho[s0:s1] = rho_loc
    return idx, c_th, c_thth, c_phph, rho

def assemble_operator(th, idx, c_th, c_thth, c_phph):
    """
    Combine parameter-space derivative stencils with the analytic metric
    factors of the torus Laplace-Beltrami operator evaluated pointwise:
        Delta_M = (1/r^2) d2/dtheta2
                  - sin(theta)/(r (R + r cos(theta))) d/dtheta
                  + 1/(R + r cos(theta))^2 d2/dphi2
    """
    n, k = idx.shape
    data = (c_thth / Rr**2
            + (-np.sin(th) / (Rr * (R + Rr * np.cos(th))))[:, None] * c_th
            + (1.0 / (R + Rr * np.cos(th))**2)[:, None] * c_phph)
    rows = np.repeat(np.arange(n), k)
    L = sp.csr_matrix((data.ravel(), (rows, idx.ravel())), shape=(n, n))
    return L

def build_operator(th, ph):
    idx, c_th, c_thth, c_phph, rho = build_gmls_rows(th, ph)
    L = assemble_operator(th, idx, c_th, c_thth, c_phph)
    return L, idx, (c_th, c_thth, c_phph), rho

# --------------------------------------------- analytic Laplacian checks ---
def exact_lap_test(t, p):
    """Exact Laplace-Beltrami of f = sin(3 theta) cos(2 phi)."""
    f = np.sin(3.0 * t) * np.cos(2.0 * p)
    return ((-9.0 / Rr**2) * f
            - 4.0 * f / (R + Rr * np.cos(t))**2
            - 3.0 * np.sin(t) * np.cos(3.0 * t) * np.cos(2.0 * p)
              / (Rr * (R + Rr * np.cos(t))))

def verify_exact_formula():
    """Cross-check the expanded formula against the divergence form
    (1/sqrt(g)) d/dth (sqrt(g) g^thth dth f) + (1/sqrt(g)) d/dph (...) by
    2nd-order periodic finite differences on a fine grid."""
    m = 720
    g = np.linspace(0, 2 * np.pi, m, endpoint=False); dl = 2 * np.pi / m
    tg, pg = np.meshgrid(g, g, indexing='ij')
    fg = np.sin(3 * tg) * np.cos(2 * pg)
    ftt = (np.roll(fg, -1, 0) - 2 * fg + np.roll(fg, 1, 0)) / dl**2
    fpp = (np.roll(fg, -1, 1) - 2 * fg + np.roll(fg, 1, 1)) / dl**2
    ft = (np.roll(fg, -1, 0) - np.roll(fg, 1, 0)) / (2 * dl)
    sg = Rr * (R + Rr * np.cos(tg))                       # sqrt(g)
    lap_div = (np.roll(sg / Rr**2 * ft, -1, 0) - np.roll(sg / Rr**2 * ft, 1, 0)) \
              / (2 * dl * sg) + fpp / (R + Rr * np.cos(tg))**2
    err = np.abs(lap_div - exact_lap_test(tg, pg)).max()
    print(f"  [check] expanded vs divergence-form Laplacian (FD): max|diff| = {err:.2e}")
    return err

# ------------------------------------------------------------ NL solver ----
class LinPre:
    """Reusable exact factorization of J0 = -L + alpha*I (RCM-ordered),
    used as (i) initial-guess solver for the linear problem and
    (ii) left preconditioner for the Newton-Krylov (GMRES) inner solves."""
    def __init__(self, L, alpha):
        self.L = L
        self.p = reverse_cuthill_mckee(L, symmetric_mode=False)
        J0 = (-L + sp.eye(L.shape[0]) * alpha).tocsc()
        self.lu = splu(J0[self.p][:, self.p], permc_spec='NATURAL')
    def solve(self, b):
        y = self.lu.solve(b[self.p])
        x = np.empty(len(b)); x[self.p] = y
        return x

def solve_nonlinear(L, alpha, beta, h, pre=None, max_iter=40, rtol=1e-12):
    """
    Damped inexact Newton (Newton-Krylov) with Armijo backtracking.
    Jacobian J(u) = -L + diag(alpha + 3 beta u^2).  Inner linear solves use
    GMRES left-preconditioned with the fixed factorization of J0 = -L+alpha I;
    if the inner solve or the line search fails, an exact RCM-ordered splu
    solve of the current J is used instead.  Initial guess: the exact solution
    of the linear part (beta=0), which is available from the same factorization.
    """
    n = L.shape[0]
    if pre is None:
        pre = LinPre(L, alpha)
    def resid(u):
        return -L @ u + alpha * u + beta * u**3 - h
    u = pre.solve(h)                    # exact solution of the linear part
    F = resid(u)
    r0 = np.linalg.norm(F)
    res_hist = [r0]; step_hist = [0.0]; backtrack_count = 0
    tol_final = rtol * r0
    for it in range(1, max_iter + 1):
        J = (-L + sp.diags(alpha + 3.0 * beta * u**2)).tocsc()
        b = -F
        Mop = spla.LinearOperator((n, n), matvec=pre.solve, dtype=float)
        sn, info = gmres(J, b, M=Mop, rtol=1e-12, restart=60, maxiter=40)
        used_exact = False
        if info != 0 or not np.all(np.isfinite(sn)):
            luJ = splu(J[pre.p][:, pre.p], permc_spec='NATURAL')
            sn = np.empty(n); sn[pre.p] = luJ.solve(b[pre.p])
            del luJ
            used_exact = True
        s = sn
        # Armijo backtracking on ||F||_2
        t = 1.0; bt = 0; r_cur = np.linalg.norm(F)
        ok = False
        while True:
            u_new = u + t * s
            r_new = np.linalg.norm(resid(u_new))
            if r_new <= (1.0 - 1e-4 * t) * r_cur:
                ok = True; break
            t *= 0.5; bt += 1
            if bt > 40 or t < 1e-12:
                break
        if not ok:                      # exact direction as last resort
            luJ = splu(J[pre.p][:, pre.p], permc_spec='NATURAL')
            s = np.empty(n); s[pre.p] = luJ.solve(b[pre.p])
            del luJ
            used_exact = True
            t = 1.0; bt += 1
            u_new = u + t * s
            r_new = np.linalg.norm(resid(u_new))
            if r_new <= (1.0 - 1e-4) * r_cur:
                ok = True
        backtrack_count += bt
        if not ok:
            break                       # no progress possible; stop honestly
        u = u + t * s
        F = resid(u)
        res_hist.append(np.linalg.norm(F))
        step_hist.append(t * np.linalg.norm(s))
        r = res_hist[-1]
        if r <= tol_final:
            break
        if it >= 3 and r > 0.9 * res_hist[-2] and r < 1e-8 * r0:
            break                       # stagnation at the round-off floor
        if step_hist[-1] < 1e-14 * max(1.0, np.abs(u).max()):
            break
    # empirical Newton convergence order from terminal residual ratios
    order = None
    rr = np.array(res_hist)
    floor = 1e-13 * r0
    ps = []
    for i in range(2, len(rr)):
        if rr[i] > floor and rr[i-1] > floor and rr[i-2] > floor \
           and rr[i] < rr[i-1] < rr[i-2]:
            ps.append(np.log(rr[i]/rr[i-1]) / np.log(rr[i-1]/rr[i-2]))
    if ps:
        order = float(np.median(ps[-4:]))
    diag = dict(iterations=len(res_hist) - 1, residual_history=res_hist,
                step_size_history=step_hist, backtrack_count=backtrack_count,
                convergence_order_estimate=order, final_residual=float(res_hist[-1]))
    return u, diag

# ------------------------------------------------------ Phase 1: validation -
print("=== Phase 1: discretization + convergence validation ===", flush=True)
fd_err = verify_exact_formula()
f_test = np.sin(3.0 * TH) * np.cos(2.0 * PH)
ex_test = exact_lap_test(TH, PH)

rng = np.random.default_rng(42)
perm = rng.permutation(N)
dens_fracs = [1.0, 0.5, 0.25, 0.125, 0.0625]
ns = [N, N // 2, N // 4, N // 8, N // 16]
density_results = []
errs_rms = []
for frac, n in zip(dens_fracs, ns):
    sel = perm[:n]
    idx, c_th, c_thth, c_phph, rho = build_gmls_rows(TH[sel], PH[sel])
    L = assemble_operator(TH[sel], idx, c_th, c_thth, c_phph)
    e = L @ f_test[sel] - ex_test[sel]
    density_results.append(dict(density=float(n / N), n_points=int(n),
                                max_error=float(np.abs(e).max()),
                                rms_error=float(np.sqrt((e**2).mean()))))
    errs_rms.append(np.sqrt((e**2).mean()))
    print(f"  density {frac:6.4f}  n={n:6d}  max_err={np.abs(e).max():.3e}  "
          f"rms_err={errs_rms[-1]:.3e}", flush=True)

h_eff = np.sqrt(4.0 * np.pi**2 * R * Rr / (np.pi * np.array(ns, dtype=float)))
slope_rms = float(np.polyfit(np.log(h_eff), np.log(errs_rms), 1)[0])
errs_max = [d['max_error'] for d in density_results]
slope_max = float(np.polyfit(np.log(h_eff), np.log(errs_max), 1)[0])
print(f"  fitted order: rms -> {slope_rms:.3f}, max -> {slope_max:.3f} "
      f"(theory l-1 = {DEGREE-1})", flush=True)

print("  building full-density operator ...", flush=True)
L_full, idx_full, (c_th, c_thth, c_phph), rho_full = build_operator(TH, PH)
print(f"  operator: {L_full.nnz} nonzeros, |L@1|_inf = "
      f"{np.abs(L_full @ np.ones(N)).max():.2e}", flush=True)
P3 = np.column_stack([(R + Rr * np.cos(TH)) * np.cos(PH),
                      (R + Rr * np.cos(TH)) * np.sin(PH),
                      Rr * np.sin(TH)])
rng2 = np.random.default_rng(7)
stencil_pts = rng2.choice(N, size=10, replace=False)
stencil_validation = []
for i in stencil_pts:
    nb = idx_full[i]
    row = (c_thth[i] / Rr**2
           + (-np.sin(TH[i]) / (Rr * (R + Rr * np.cos(TH[i])))) * c_th[i]
           + c_phph[i] / (R + Rr * np.cos(TH[i]))**2)
    diam = float(np.linalg.norm(P3[nb] - P3[i], axis=1).max())
    stencil_validation.append(dict(point_index=int(i), theta=float(TH[i]),
                                   phi=float(PH[i]),
                                   stencil_weights=[float(w) for w in row],
                                   weight_sum=float(row.sum()),
                                   stencil_diameter=diam))
wsums = np.array([s['weight_sum'] for s in stencil_validation])
wabs = np.concatenate([np.abs(s['stencil_weights']) for s in stencil_validation])
print(f"  stencil sample: |weight_sum| max = {np.abs(wsums).max():.2e}, "
      f"max|w| = {wabs.max():.1f}, diameters "
      f"{min(s['stencil_diameter'] for s in stencil_validation):.3f}"
      f"-{max(s['stencil_diameter'] for s in stencil_validation):.3f}", flush=True)

json.dump(dict(test_function="sin(3*theta)*cos(2*phi)",
               polynomial_degree=int(DEGREE),
               estimated_convergence_order=float(slope_rms),
               density_results=density_results),
          open('results/discretization/convergence_test.json', 'w'), indent=2)
json.dump(stencil_validation,
          open('results/discretization/stencil_validation.json', 'w'), indent=2)

# ------------------------------------------------- Phase 2: nonlinear solve -
print("=== Phase 2: nonlinear solve (damped Newton-Krylov) ===", flush=True)
pre0 = LinPre(L_full, ALPHA)   # reused by main, linear and beta-perturbation runs
u_nl, diag = solve_nonlinear(L_full, ALPHA, BETA, H, pre=pre0)
print(f"  iterations={diag['iterations']} backtracks={diag['backtrack_count']} "
      f"final_residual={diag['final_residual']:.3e} "
      f"order~{diag['convergence_order_estimate']}", flush=True)
print("  residual history:", ["%.2e" % v for v in diag['residual_history']], flush=True)

json.dump(diag, open('results/solver/solver_diagnostics.json', 'w'), indent=2)
with open('results/solver/convergence_plot_data.csv', 'w') as fh:
    fh.write("iteration,log10_residual_norm,log10_step_norm\n")
    for it, (rv, sv) in enumerate(zip(diag['residual_history'],
                                      diag['step_size_history'])):
        fh.write(f"{it},{np.log10(rv):.6f},{np.log10(max(sv, 1e-300)):.6f}\n")

np.savetxt('results/u_pred.csv', u_nl, fmt='%.16e', delimiter=',')
print("  Phase 2 done", flush=True)

# ------------------------------------------- Phase 3: robustness studies ----
print("=== Phase 3: robustness ===", flush=True)
u_lin = pre0.solve(H)                      # beta = 0: exact linear solve
np.savetxt('results/robustness/linear_vs_nonlinear.csv',
           np.column_stack([u_lin, u_nl]), fmt='%.16e', delimiter=',')
nl_diff = u_nl - u_lin
nl_threshold = 0.05 * float(np.abs(u_nl).max())
nl_frac = float(np.mean(np.abs(nl_diff) > nl_threshold))
i_max_nl = int(np.argmax(np.abs(nl_diff)))
print(f"  linear-vs-nonlinear: max|diff|={np.abs(nl_diff).max():.4f} "
      f"mean|diff|={np.abs(nl_diff).mean():.4f} "
      f"fraction>{nl_threshold:.3f}: {nl_frac:.3f}", flush=True)

noise_sigmas = [0.01, 0.05, 0.15]   # rad; fractions of 2pi: 1.6e-3, 8e-3, 2.4e-2
u_scale = float(np.abs(u_nl).max())
noise_results = []
for lv, sig in enumerate(noise_sigmas, start=1):
    rn = np.random.default_rng(100 + lv)
    th_n = (TH + rn.normal(0.0, sig, N)) % (2 * np.pi)
    ph_n = (PH + rn.normal(0.0, sig, N)) % (2 * np.pi)
    L_n, _, _, _ = build_operator(th_n, ph_n)
    u_n, _ = solve_nonlinear(L_n, ALPHA, BETA, H)
    ch = float(np.abs(u_n - u_nl).max())
    noise_results.append(dict(noise_sigma=float(sig), solution_change_linf=ch,
                              relative_change=ch / u_scale))
    print(f"  noise sigma={sig:.3f} rad ({sig/2/np.pi:.2e} of 2pi): "
          f"Linf change={ch:.4e}, relative={ch/u_scale:.3e}", flush=True)
    del L_n
json.dump(dict(noise_results=noise_results),
          open('results/robustness/point_cloud_sensitivity.json', 'w'), indent=2)

pert_results = {}
for name, (fa, fb) in dict(alpha_p10=(1.10, 1.0), alpha_m10=(0.90, 1.0),
                           alpha_p20=(1.20, 1.0), alpha_m20=(0.80, 1.0),
                           beta_p10=(1.0, 1.10), beta_m10=(1.0, 0.90),
                           beta_p20=(1.0, 1.20), beta_m20=(1.0, 0.80)).items():
    a_p, b_p = fa * ALPHA, fb * BETA
    if abs(fa - 1.0) < 1e-12:
        u_p, _ = solve_nonlinear(L_full, a_p, b_p, H, pre=pre0)
    else:
        u_p, _ = solve_nonlinear(L_full, a_p, b_p, H)   # new factorization for new alpha
    ch = float(np.abs(u_p - u_nl).max())
    pert_results[name] = dict(alpha=float(a_p), beta=float(b_p),
                              solution_change_linf=ch, relative_change=ch / u_scale)
    print(f"  {name}: alpha={a_p:.4f} beta={b_p:.4f} "
          f"Linf change={ch:.4e} relative={ch/u_scale:.3e}", flush=True)
json.dump(dict(perturbation_results=pert_results),
          open('results/robustness/parameter_sensitivity.json', 'w'), indent=2)
print("  Phase 3 done", flush=True)

# ------------------------------------------------- Phase 4: analysis --------
print("=== Phase 4: solution analysis ===", flush=True)
u = u_nl
i_max, i_min = int(np.argmax(u)), int(np.argmin(u))
feat = dict(max_value=float(u[i_max]),
            max_location_theta=float(TH[i_max]),
            max_location_phi=float(PH[i_max]),
            min_value=float(u[i_min]),
            min_location_theta=float(TH[i_min]),
            min_location_phi=float(PH[i_min]),
            mean_value=float(u.mean()), std_value=float(u.std()),
            nonlinear_contribution_fraction=nl_frac,
            regions_of_interest=[])

NB = 96
def binned(vals, nb=NB):
    ii = np.minimum((TH / (2 * np.pi) * nb).astype(int), nb - 1)
    jj = np.minimum((PH / (2 * np.pi) * nb).astype(int), nb - 1)
    flat = ii * nb + jj
    ssum = np.bincount(flat, weights=vals, minlength=nb * nb)
    cnt = np.bincount(flat, minlength=nb * nb)
    return np.where(cnt > 0, ssum / np.maximum(cnt, 1), np.nan).reshape(nb, nb)
U = binned(u); Uh = binned(H); Unl = binned(nl_diff)
def sym_err(Uu, transform):
    V = transform(Uu)
    ok = np.isfinite(Uu) & np.isfinite(V)
    return (float(np.abs(Uu[ok] - V[ok]).max()),
            float(np.abs(Uu[ok] - V[ok]).std()))
syms = {}
for name, tf in [("phi_reflection", lambda A: A[:, ::-1]),
                 ("theta_reflection", lambda A: A[::-1, :]),
                 ("phi_translation_pi", lambda A: np.roll(A, NB // 2, axis=1)),
                 ("theta_translation_pi", lambda A: np.roll(A, NB // 2, axis=0))]:
    e_u, s_u = sym_err(U, tf); e_h, s_h = sym_err(Uh, tf)
