    # ---- fallback: pure-numpy RGB PNG writer (no external deps) ----
    import zlib, struct

    def write_png(path, rgb):
        h, w, _ = rgb.shape
        raw = b"".join(b"\x00" + rgb[i].tobytes() for i in range(h))
        def chunk(tag, payload):
            c = struct.pack(">I", len(payload)) + tag + payload
            return c + struct.pack(">I", zlib.crc32(tag + payload) & 0xFFFFFFFF)
        png = b"\x89PNG\r\n\x1a\n"
        png += chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0))
        png += chunk(b"IDAT", zlib.compress(raw, 9))
        png += chunk(b"IEND", b"")
        open(path, "wb").write(png)

    _vp = np.array([[68, 1, 84], [59, 82, 139], [33, 145, 140],
                    [94, 201, 98], [253, 231, 37]], dtype=float)

    def viridis(x):
        x = np.clip(x, 0, 1)
        pos = x * (len(_vp) - 1)
        i0 = np.clip(np.floor(pos).astype(int), 0, len(_vp) - 2)
        f = (pos - i0)[:, :, None]
        return (_vp[i0] * (1 - f) + _vp[i0 + 1] * f)

    FONT = {
        'a': ["XXX", "X.X", "XXX", "X.X", "X.X"],
        'c': ["XXX", "X..", "X..", "X..", "XXX"],
        'd': ["XX.", "X.X", "X.X", "X.X", "XX."],
        'e': ["XXX", "X..", "XXX", "X..", "XXX"],
        'f': ["XXX", "X..", "XXX", "X..", "X.."],
        'i': ["X", "X", "X", "X", "X"],
        'l': ["X..", "X..", "X..", "X..", "XXX"],
        'n': ["X.X", "XXX", "XXX", "XXX", "X.X"],
        'o': ["XXX", "X.X", "X.X", "X.X", "XXX"],
        'r': ["XXX", "X.X", "XXX", "XXX", "X.X"],
        's': ["XXX", "X..", "XXX", "..X", "XXX"],
        't': ["XXX", ".X.", ".X.", ".X.", ".X."],
        'u': ["X.X", "X.X", "X.X", "X.X", "XXX"],
        'v': ["X.X", "X.X", "X.X", "X.X", ".X."],
        'w': ["X.X", "X.X", "XXX", "XXX", "X.X"],
        'x': ["X.X", "X.X", ".X.", "X.X", "X.X"],
        'y': ["X.X", "X.X", ".X.", ".X.", ".X."],
        '=': ["...", "XXX", "...", "XXX", "..."],
        '-': ["...", "...", "XXX", "...", "..."],
        '.': [".", ".", ".", ".", "X"],
        ' ': ["..", "..", "..", "..", ".."],
        '(': [".X", "X.", "X.", "X.", ".X"],
        ')': ["X.", ".X", ".X", ".X", "X."],
        ';': [".", ".", "X", ".", "."],
        '0': ["XXX", "X.X", "X.X", "X.X", "XXX"],
        '1': [".X.", "XX.", ".X.", ".X.", "XXX"],
        '2': ["XXX", "..X", "XXX", "X..", "XXX"],
        '3': ["XXX", "..X", "XXX", "..X", "XXX"],
        '4': ["X.X", "X.X", "XXX", "..X", "..X"],
        '5': ["XXX", "X..", "XXX", "..X", "XXX"],
        '6': ["XXX", "X..", "XXX", "X.X", "XXX"],
        '7': ["XXX", "..X", "..X", "..X", "..X"],
        '8': ["XXX", "X.X", "XXX", "X.X", "XXX"],
        '9': ["XXX", "X.X", "XXX", "..X", "XXX"],
    }

    def draw_text(img, text, r0, c0, scale=2, color=(255, 255, 255)):
        for ch in text:
            g = FONT.get(ch, FONT[' '])
            gw = len(g[0])
            for rr in range(5):
                for cc in range(gw):
                    if g[rr][cc] == 'X':
                        img[r0 + rr * scale:r0 + (rr + 1) * scale,
                            c0 + cc * scale:c0 + (cc + 1) * scale] = color
            c0 += (gw + 1) * scale

    pad, border = 8, 1
    pw = nx + 2 * border
    label_h = 7 * 2 + 4
    left = 20
    cb_w = 12
    W = left + 3 * pw + 2 * pad + cb_w + 26
    H = 26 + 2 * (label_h + pw + pad) + 16
    img = np.full((H, W, 3), 24, dtype=np.uint8)
    draw_text(img, "reconstructed u(x,y); red = transition curves", 6, left)
    dxg = xg[1] - xg[0]
    for k, tk in enumerate(eval_times):
        row, col = k // 3, k % 3
        r0 = 26 + row * (label_h + pw + pad)
        c0 = left + col * (pw + pad)
        draw_text(img, f"t={tk:.4f}", r0, c0)
        r0 += label_h
        norm = (recon[k].astype(float) - vmin) / (vmax - vmin)
        panel = (viridis(norm[::-1]) * 255).astype(np.uint8)  # y increasing up
        img[r0:r0 + ny, c0 + border:c0 + border + nx] = panel
        # red curve overlay: cells within 1.5 cells of either front line
        sg = a * XG + b * YG
        thin = ((np.abs(sg - (g1 + c1 * tk)) <= 1.5 * dxg) |
                (np.abs(sg - (g2 + c2 * tk)) <= 1.5 * dxg))[::-1]
        img[r0:r0 + ny, c0 + border:c0 + border + nx][thin] = (255, 40, 40)
        img[r0 - border:r0 + ny + border, c0:c0 + pw] = np.where(
            img[r0 - border:r0 + ny + border, c0:c0 + pw] == 0,
            255, img[r0 - border:r0 + ny + border, c0:c0 + pw])[..., :3] \
            if False else img[r0 - border:r0 + ny + border, c0:c0 + pw]
        # panel frame
        img[r0 - border, c0:c0 + pw] = 200
        img[r0 + ny, c0:c0 + pw] = 200
        img[r0 - border:r0 + ny + border, c0] = 200
        img[r0 - border:r0 + ny + border, c0 + pw - 1] = 200
        draw_text(img, "x", r0 + ny + 2, c0 + pw // 2, color=(200, 200, 200))
        draw_text(img, "y", r0 + 2, c0 - 16, color=(200, 200, 200))
    # colorbar
    cb_r0 = 26
    cb_h = 2 * (label_h + pw + pad) - 16
    grad = np.linspace(0, 1, cb_h)[:, None]
    cb = (viridis(grad[::-1]) * 255).astype(np.uint8)
    img[cb_r0:cb_r0 + cb_h, W - cb_w - 4:W - 4] = cb
    for frac, lab in [(1.0, f"{vmax:.2f}"), (0.0, f"{vmin:.2f}")]:
        rr = cb_r0 + int((1 - frac) * (cb_h - 10))
        draw_text(img, lab, rr, W - cb_w + 2, scale=1)
    draw_text(img, "u", cb_r0 + cb_h + 2, W - cb_w - 2, color=(200, 200, 200))
    write_png("reconstruction_slices.png", img)
    print("figure written with built-in PNG renderer (matplotlib unavailable)")

