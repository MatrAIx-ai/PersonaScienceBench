    for arr in (c_chk[f"t_{k}"], n_chk[f"t_{k}"], s_chk[f"t_{k}"]):
        assert arr.dtype == np.float32
    assert np.allclose(np.linalg.norm(n_chk[f"t_{k}"], axis=1), 1.0, atol=1e-6)
    # curves lie on the fitted front lines and inside the box
    pts = c_chk[f"t_{k}"].astype(np.float64)
    sval = a * pts[:, 0] + b * pts[:, 1]
    sexp = np.where(np.arange(len(pts)) < 100, g1 + c1 * eval_times[k],
                    g2 + c2 * eval_times[k])
    assert np.max(np.abs(sval - sexp)) < 1e-4
    assert pts[:, 0].min() >= x_min - 1e-4 and pts[:, 0].max() <= x_max + 1e-4
    assert pts[:, 1].min() >= y_min - 1e-4 and pts[:, 1].max() <= y_max + 1e-4
