"""Low-regret optimistic Q-learning for hidden finite-horizon episodic MDPs.

Design (single shared configuration, no case branching):

- Horizon-indexed, model-free optimistic Q-learning with per-visit online
  updates. Storage is O(H*S*A) scalars only: visit counts N, windowed target
  means M, and windowed target second moments V2. No transition model, no
  next-state counts, no next-state enumeration, no replay, no posterior
  sampling, no episode trace.

- Anti-drift core (the research element): targets are the *mean-only* child
  values max_a M[h+1, s', a'], so confidence bonuses never enter the targets
  and target drift is bounded by mean movement. On top of that, both the mean
  and the second moment of the sampled targets are maintained over a bounded
  recent window W (visit-dependent exponential forgetting with effective count
  min(n, W)). Samples collected while downstream Q estimates were still
  immature are discarded instead of accumulating stale optimism, which removes
  the finite-sample burn-in cost of direct confidence estimation while
  preserving optimism.

- Explicit optimism/confidence mechanism: empirical-Bernstein-style bonus
      b = c1 * sqrt(2 * vhat * L / n_eff) + c2 * b_rem * L / (n - 1)
  where vhat is the windowed empirical variance of the sampled targets
  (t = reward + child value), n_eff = min(n, W), b_rem bounds the remaining
  return range, and L = log(3*S*A*H*K). Action selection is greedy on
  Qhat = M + b, with optimistic initialization (H-h+1)*rmax for unvisited
  cells. If rewards or continuations are stochastic (variance > 0), the sqrt
  term adapts automatically; if they are deterministic it vanishes.

- Safety: act/observe are exception-free, actions are plain ints in
  {0,...,A-1}, and all Q/value estimates are clipped to the valid
  remaining-horizon range [rem*rmin, rem*rmax] at all times.
"""

from __future__ import annotations

import math

import numpy as np

# Shared configuration (tuned once on the public calibration suite; identical
# constants for every MDP).
C1 = 1.0          # sqrt (empirical-variance) term multiplier
C2 = 0.1          # range/bias term multiplier
WINDOW_MULT = 5   # forgetting window W = clip(WINDOW_MULT * S * A, 30, 120)
WINDOW_MIN = 30
WINDOW_MAX = 120
LOG_SCALE = 1.0   # multiplier inside the log factor


class OptimisticQAgent:
    def __init__(self, env_spec: dict, seed: int):
        self.S = int(env_spec.get("S", 1))
        self.A = int(env_spec.get("A", 1))
        self.H = int(env_spec.get("H", 1))
        self.K = max(int(env_spec.get("K", 1000)), 1)
        rr = env_spec.get("reward_range") or [0.0, 1.0]
        self.rmin = float(rr[0])
        self.rmax = float(rr[1])
        self.rng = np.random.default_rng(int(seed) % (2**32))  # tie-breaking only
        self.W = int(min(WINDOW_MAX, max(WINDOW_MIN, WINDOW_MULT * self.S * self.A)))
        H, S, A = self.H, self.S, self.A

        # optimistic value of an unvisited Q entry at level h (1-indexed):
        # maximum possible remaining return
        self.opt_q = np.array([(H - h + 1) * self.rmax for h in range(1, H + 1)] + [0.0])
        # maximum possible continuation value entering a target at level h
        self.opt_child = np.array([(H - h) * self.rmax for h in range(1, H + 1)] + [0.0])

        self.N = np.zeros((H, S, A))          # visit counts
        self.M = np.zeros((H, S, A))          # windowed mean of targets t = r + V_child
        self.V2 = np.zeros((H, S, A))         # windowed second moment of targets
        self.log_factor = LOG_SCALE * math.log(max(3.0, 3.0 * S * A * H * self.K))

    # ------------------------------------------------------------------
    def _vhat(self, i, s, a) -> float:
        v = self.V2[i, s, a] - self.M[i, s, a] ** 2
        return v if v > 0.0 else 0.0

    def _bonus(self, i, s, a) -> float:
        n = self.N[i, s, a]
        if n <= 0:
            return 0.0  # unvisited cells use optimistic initialization instead
        L = self.log_factor
        n_eff = min(n, self.W)
        b = C1 * math.sqrt(2.0 * self._vhat(i, s, a) * L / n_eff)
        # range bound on the target: continuation span + reward span
        b_rem = self.opt_child[i] + (self.rmax - self.rmin)
        b += C2 * b_rem * L / max(n - 1, 1)
        return b

    def _child_value(self, i_next, s_next) -> float:
        """Mean-only optimistic-free continuation value used inside targets."""
        if i_next >= self.H:
            return 0.0
        return float(self.M[i_next, s_next].max())

    # ------------------------------------------------------------------
    def act(self, h: int, state: int) -> int:
        try:
            i = int(h) - 1
            s = int(state)
            if i < 0 or i >= self.H or s < 0 or s >= self.S:
                return 0
            q = self.M[i, s] + np.array([self._bonus(i, s, a) for a in range(self.A)])
            unvisited = self.N[i, s] <= 0
            if unvisited.any():
                q = np.where(unvisited, self.opt_q[i], q)
            lo = (self.H - i) * self.rmin
            hi = (self.H - i) * self.rmax
            q = np.clip(q, lo, hi)
            return int(np.argmax(q))
        except Exception:
            return 0

    def observe(self, h, state, action, reward, next_state, done) -> None:
        try:
            i = int(h) - 1
            s = int(state)
            a = int(action)
            if i < 0 or i >= self.H or s < 0 or s >= self.S or a < 0 or a >= self.A:
                return
            r = float(reward)
            ns = int(next_state)
            child = 0.0 if done else self._child_value(i + 1, ns)
            t = r + child
            n = self.N[i, s, a] + 1
            self.N[i, s, a] = n
            rate = 1.0 / min(n, self.W)  # bounded-memory (windowed) online update
            m = self.M[i, s, a]
            self.M[i, s, a] = m + (t - m) * rate
            v2 = self.V2[i, s, a]
            self.V2[i, s, a] = v2 + (t * t - v2) * rate
            lo = (self.H - i) * self.rmin
            hi = (self.H - i) * self.rmax
            self.M[i, s, a] = min(max(self.M[i, s, a], lo), hi)
        except Exception:
            pass

    # optional hooks (official runner calls them when present)
    def reset_episode(self, episode, state) -> None:
        pass

    def end_episode(self, episode, episode_reward) -> None:
        pass


def make_agent(env_spec: dict, seed: int) -> OptimisticQAgent:
    return OptimisticQAgent(env_spec, seed)
