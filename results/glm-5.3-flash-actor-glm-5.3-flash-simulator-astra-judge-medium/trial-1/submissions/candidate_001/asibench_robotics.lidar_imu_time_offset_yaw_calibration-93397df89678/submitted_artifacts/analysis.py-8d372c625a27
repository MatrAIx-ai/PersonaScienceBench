def _save_png(path, img):
    h, w, _ = img.shape
    raw = b"".join(b"\x00" + img[y].tobytes() for y in range(h))

    def chunk(tag, data):
        return (struct.pack(">I", len(data)) + tag + data
                + struct.pack(">I", zlib.crc32(tag + data) & 0xFFFFFFFF))

    png = (b"\x89PNG\r\n\x1a\n"
           + chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0))
           + chunk(b"IDAT", zlib.compress(raw, 6))
           + chunk(b"IEND", b""))
    with open(path, "wb") as f:
        f.write(png)


def _nice_ticks(lo, hi, n=6):
    span = hi - lo
    if span <= 0:
        span = 1.0
    raw = span / n
    mag = 10.0 ** np.floor(np.log10(raw))
    norm = raw / mag
    step = mag * (1 if norm <= 1 else 2 if norm <= 2 else 5 if norm <= 5 else 10)
    lo_t = np.ceil(lo / step) * step
    ticks = np.arange(lo_t, hi + 0.5 * step, step)
    return ticks, step


def _fmt(v, step):
    dec = max(0, int(np.ceil(-np.log10(step)))) if step < 1 else 0
    return f"{v:.{dec}f}" if dec else f"{v:g}"


def _text(img, x, y, s, color, scale=2):
    x, y = int(round(x)), int(round(y))
    cx = x
    for ch in s.upper():
        g = FONT.get(ch, FONT[' '])
        for r, row in enumerate(g):
            for cc, bit in enumerate(row):
                if bit == '1':
                    y0 = max(y + r * scale, 0); y1 = min(y + (r + 1) * scale, img.shape[0])
                    x0 = max(cx + cc * scale, 0); x1 = min(cx + (cc + 1) * scale, img.shape[1])
                    if y1 > y0 and x1 > x0:
                        img[y0:y1, x0:x1] = color
        cx += 6 * scale


def _line(img, x0, y0, x1, y1, color, lw=1):
    n = int(max(abs(x1 - x0), abs(y1 - y0))) * 2 + 3
    xs = np.linspace(x0, x1, n)
    ys = np.linspace(y0, y1, n)
    for k in range(-(lw // 2), lw // 2 + 1):
        xi = np.clip(np.round(xs).astype(int), 0, img.shape[1] - 1)
        yi = np.clip(np.round(ys + k).astype(int), 0, img.shape[0] - 1)
        img[yi, xi] = color


def _disk(img, xc, yc, r, color):
    x0 = max(int(round(xc)) - r, 0); x1 = min(int(round(xc)) + r, img.shape[1] - 1)
    y0 = max(int(round(yc)) - r, 0); y1 = min(int(round(yc)) + r, img.shape[0] - 1)
    if x1 < x0 or y1 < y0:
        return
    yy, xx = np.mgrid[y0:y1 + 1, x0:x1 + 1]
    m = (xx - xc) ** 2 + (yy - yc) ** 2 <= r * r
    img[y0:y1 + 1, x0:x1 + 1][m] = color



class RasterPanel:
    """Single axes panel drawn into a numpy RGB canvas (no matplotlib)."""

    def __init__(self, img, px, py, pw, ph, xlim, ylim, title="", xlabel="",
                 ylabel=""):
        self.img = img
        self.px, self.py, self.pw, self.ph = px, py, pw, ph
        self.xlim, self.ylim = xlim, ylim
        c_box = (40, 40, 40)
        _line(img, px, py, px + pw, py, c_box, 1)
        _line(img, px, py + ph, px + pw, py + ph, c_box, 1)
        _line(img, px, py, px, py + ph, c_box, 1)
        _line(img, px + pw, py, px + pw, py + ph, c_box, 1)
        # x ticks
        ticks, step = _nice_ticks(*xlim)
        for tv in ticks:
            xp = self._mx(tv)
            _line(img, xp, py + ph, xp, py + ph + 5, c_box, 1)
            lbl = _fmt(tv, step)
            _text(img, xp - 3 * len(lbl), py + ph + 9, lbl, c_box, 2)
        # y ticks
        ticks_y, step_y = _nice_ticks(*ylim)
        for tv in ticks_y:
            yp = self._my(tv)
            _line(img, px - 5, yp, px, yp, c_box, 1)
            lbl = _fmt(tv, step_y)
            _text(img, px - 12 - 6 * len(lbl), yp - 5, lbl, c_box, 2)
        if title:
            _text(img, px, py - 26, title, (10, 10, 10), 2)
        if xlabel:
            _text(img, px + pw // 2 - 3 * len(xlabel), py + ph + 30, xlabel,
                  (10, 10, 10), 2)
        if ylabel:
            _text(img, px, py - 44, "Y: " + ylabel, (90, 90, 90), 2)

    def _mx(self, x):
        a, b = self.xlim
        return self.px + (x - a) / (b - a) * self.pw

    def _my(self, y):
        a, b = self.ylim
        return self.py + self.ph - (y - a) / (b - a) * self.ph

    def _clip_mask(self, xi, yi):
        return ((xi >= self.px) & (xi <= self.px + self.pw)
                & (yi >= self.py) & (yi <= self.py + self.ph))

    def line(self, xs, ys, color, lw=1):
        xs = np.asarray(xs, float); ys = np.asarray(ys, float)
        n = max(len(xs) * 2, 2000)
        xs = np.interp(np.linspace(0, len(xs) - 1, n), np.arange(len(xs)), xs)
        ys = np.interp(np.linspace(0, len(ys) - 1, n), np.arange(len(ys)), ys)
        xi = np.round(self._mx(xs)).astype(int)
        yi = np.round(self._my(ys)).astype(int)
        for k in range(-(lw // 2), lw // 2 + 1):
            xk = np.clip(xi, 0, self.img.shape[1] - 1)
            yk = np.clip(yi + k, 0, self.img.shape[0] - 1)
            m = self._clip_mask(xk, yk)
            self.img[yk[m], xk[m]] = color

    def points(self, xs, ys, color, r=1):
        xs = np.asarray(xs, float); ys = np.asarray(ys, float)
        for x, y in zip(xs, ys):
            xp, yp = self._mx(x), self._my(y)
            if self.px <= xp <= self.px + self.pw and self.py <= yp <= self.py + self.ph:
                _disk(self.img, xp, yp, r, color)

    def hline(self, y, color, lw=1):
        self.line([self.xlim[0], self.xlim[1]], [y, y], color, lw)

    def vline(self, x, color, lw=1):
        self.line([x, x], [self.ylim[0], self.ylim[1]], color, lw)

    def band(self, x0, x1, y0, y1, color):
        xa, xb = sorted([self._mx(x0), self._mx(x1)])
        ya, yb = sorted([self._my(y0), self._my(y1)])
        xa = int(np.clip(xa, self.px, self.px + self.pw))
        xb = int(np.clip(xb, self.px, self.px + self.pw))
        ya = int(np.clip(ya, self.py, self.py + self.ph))
        yb = int(np.clip(yb, self.py, self.py + self.ph))
        self.img[ya:yb, xa:xb] = color

    def bars(self, cats, hs, color):
        for c, h in zip(cats, hs):
            xp = self._mx(c)
            w = max(8, int(0.5 * self.pw / max(len(cats), 1)))
            y0 = int(round(self._my(0.0))); y1 = int(round(self._my(h)))
            xa = int(np.clip(round(xp - w), self.px, self.px + self.pw))
            xb = int(np.clip(round(xp + w), self.px, self.px + self.pw))
            self.img[min(y1, y0):max(y1, y0), xa:xb] = color

    def text_at(self, x, y, s, color, scale=2):
        _text(self.img, self._mx(x), self._my(y), s, color, scale)

    def legend(self, entries, loc="tr"):
        # entries: list of (label, color, kind) kind in {'line','dot'}
        wpx = max(6 * len(l) + 40 for l, _, _ in entries) + 10
        hpx = 18 * len(entries) + 10
        if loc == "tr":
            x0 = self.px + self.pw - wpx - 8; y0 = self.py + 8
        else:
            x0 = self.px + 8; y0 = self.py + 8
        self.img[y0:y0 + hpx, x0:x0 + wpx] = (255, 255, 255)
        for j, (lbl, col, kind) in enumerate(entries):
            yy = y0 + 12 + 18 * j
            if kind == "dot":
                _disk(self.img, x0 + 12, yy, 3, col)
            else:
                _line(self.img, x0 + 2, yy, x0 + 24, yy, col, 2)
            _text(self.img, x0 + 30, yy - 5, lbl, (20, 20, 20), 2)


def make_canvas(W=2480, H=2360):
    return np.full((H, W, 3), 255, dtype=np.uint8)


