def _glyph(ch):
    g = (FONT.get(ch, FONT[" "]) + "." * 35)[:35]
    return [g[r * 5:(r + 1) * 5] for r in range(7)]


def _draw_text(img, x, y, s, color, scale=2):
    for ch in s.upper():
        g = _glyph(ch)
        for r in range(7):
            for c in range(5):
                if g[r][c] == "#":
                    img[y + r * scale:y + (r + 1) * scale,
                        x + c * scale:x + (c + 1) * scale] = color
        x += 6 * scale


def _line(img, x0, y0, x1, y1, color):
    n = int(max(abs(x1 - x0), abs(y1 - y0))) + 1
    if n <= 0:
        return
    xs = (x0 + (x1 - x0) * np.arange(n) / max(n - 1, 1)).astype(int)
    ys = (y0 + (y1 - y0) * np.arange(n) / max(n - 1, 1)).astype(int)
    ok = (xs >= 0) & (xs < img.shape[1]) & (ys >= 0) & (ys < img.shape[0])
    img[ys[ok], xs[ok]] = color


def _write_png(path, img):
    h, w, _ = img.shape
    raw = np.concatenate([np.zeros((h, 1), np.uint8), img.reshape(h, 3 * w)], axis=1).tobytes()
    def chunk(tag, data):
        c = tag + data
        return len(data).to_bytes(4, "big") + c + (zlib.crc32(c) & 0xFFFFFFFF).to_bytes(4, "big")
    png = (b"\x89PNG\r\n\x1a\n"
           + chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0))
           + chunk(b"IDAT", zlib.compress(raw, 6))
           + chunk(b"IEND", b""))
    with open(path, "wb") as f:
        f.write(png)


def make_plot_numpy(poses0, x, Elc, d2, acc):
    W, H = 1700, 860
    img = np.full((H, W, 3), 255, np.uint8)
    GRAY, BLUE, GREEN, RED, BLACK, LGRAY = (190, 190, 190), (31, 119, 180), (44, 160, 44), (214, 39, 40), (0, 0, 0), (225, 225, 225)

    # ---- panel 1: trajectory ----
    x0, y0, x1, y1 = 70, 90, 790, 780
    pts = np.vstack([poses0[:, :2], x[:, :2]])
    lo = pts.min(0); hi = pts.max(0)
    span = np.maximum(hi - lo, 1e-6) * 1.05
    ctr = (lo + hi) / 2
    half = span / 2
    sc = min((x1 - x0), (y1 - y0)) / max(half[0] * 2, half[1] * 2)
    def to_px(px, py):
        return (int(x0 + (px - (ctr[0] - half[0])) * sc),
                int(y1 - (py - (ctr[1] - half[1])) * sc))
    _line(img, x0, y1, x1, y1, BLACK); _line(img, x0, y0, x0, y1, BLACK)
    for k in range(len(poses0) - 1):
        a, b = to_px(*poses0[k, :2]), to_px(*poses0[k + 1, :2])
        _line(img, a[0], a[1], b[0], b[1], GRAY)
    for k in range(len(x) - 1):
        a, b = to_px(*x[k, :2]), to_px(*x[k + 1, :2])
        _line(img, a[0], a[1], b[0], b[1], BLUE)
    for k in range(Elc.n):
        a, b = to_px(x[Elc.i[k], 0], x[Elc.i[k], 1]), to_px(x[Elc.j[k], 0], x[Elc.j[k], 1])
        _line(img, a[0], a[1], b[0], b[1], GREEN if acc[k] else RED)
    _draw_text(img, x0, 20, "TRAJECTORY: GRAY=INITIAL  BLUE=OPTIMIZED", BLACK)
    _draw_text(img, x0, 40, "GREEN=ACCEPTED LOOP  RED=FALSE LOOP", BLACK)
    _draw_text(img, x0, y1 + 10, "X [M]", BLACK)
    _draw_text(img, 10, y0, "Y [M]", BLACK)

    # ---- panel 2: sorted loop chi2, log scale ----
    p0, q0, p1, q1 = 880, 90, 1640, 780
    _line(img, p0, q1, p1, q1, BLACK); _line(img, p0, q0, p0, q1, BLACK)
    order = np.argsort(d2)
    lo_c, hi_c = max(np.log10(max(d2.min(), 1e-2)), -2), np.log10(max(d2.max(), 20))
    def ypix(v):
        return int(q1 - (np.log10(max(v, 1e-2)) - lo_c) / (hi_c - lo_c) * (q1 - q0))
    bw = (p1 - p0 - 10) / Elc.n
    for r, k in enumerate(order):
        xa = int(p0 + 5 + r * bw); xb = int(p0 + 5 + (r + 1) * bw)
        yy = ypix(d2[k])
        col = GREEN if acc[k] else RED
        img[max(yy, q0):q1, xa:xb] = col
    ythr = ypix(chi2dist.ppf(0.99, df=3))
    for xx in range(p0, p1, 6):
        _line(img, xx, ythr, min(xx + 3, p1), ythr, BLACK)
    for dec in range(int(np.floor(lo_c)), int(np.ceil(hi_c)) + 1):
        v = 10.0 ** dec
        yy = ypix(v)
        if q0 <= yy <= q1:
            _line(img, p0, yy, p0 + 4, yy, BLACK)
            _draw_text(img, p0 - 52, yy - 7, ("1E%d" % dec) if dec != 0 else "1", BLACK, scale=1)
    _draw_text(img, p0, 20, "LOOP CHI2 (SORTED, LOG SCALE)", BLACK)
    _draw_text(img, p0, 40, "GREEN=ACCEPTED RED=FALSE DASHED=CHI2_3 99PCT=11.345", BLACK)
    _draw_text(img, p0, q1 + 10, "LOOP_ID SORTED BY CHI2", BLACK)

    _write_png("map_diagnostics.png", img)


