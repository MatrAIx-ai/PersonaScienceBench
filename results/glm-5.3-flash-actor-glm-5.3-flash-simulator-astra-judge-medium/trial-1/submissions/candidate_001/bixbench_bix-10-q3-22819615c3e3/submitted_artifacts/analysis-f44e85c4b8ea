"""
TASK008 BCG-CORONA: Chi-square analysis of COVID-19 severity (AESEV, subject-level max)
by treatment arm (BCG vs Placebo) within each patient-volume group (patients_seen).

Plan (approved):
- DM = analysis frame (1 row/subject). AE aggregated to subject level: worst (max) AESEV
  among the subject's COVID-19 AE rows (AEPT contains 'COVID-19').
- Main test per patients_seen group: chi-square on 4-level severity x arm.
  Fisher's exact on collapsed 2x2 (severe {3,4} vs mild/moderate {1,2}) wherever any
  expected count < 5 (also shown for all groups for robustness).
- Unadjusted p-values are headline; Holm-adjusted p-values in footnote.
- Subjects with missing COVID-AE severity excluded from main tables.
- Sensitivity check: AECAT == 'RTI' (all respiratory infections) instead of COVID-only.
- EX used only as arm-assignment sanity check (encoding: iso-8859-1).
"""
import pandas as pd
import numpy as np
from scipy.stats import chi2_contingency, fisher_exact
from itertools import combinations

DATA = 'data'
dm = pd.read_csv(f'{DATA}/TASK008_BCG-CORONA_DM.csv')                      # utf-8, clean
ae = pd.read_csv(f'{DATA}/TASK008_BCG-CORONA_AE.csv')                      # utf-8, clean
ex = pd.read_csv(f'{DATA}/TASK008_BCG-CORONA_EX.csv', encoding='iso-8859-1')

SEV_LAB = {1.0: 'Mild(1)', 2.0: 'Moderate(2)', 3.0: 'Severe(3)', 4.0: 'Life-threatening(4)'}
SEV_ORDER = ['Mild(1)', 'Moderate(2)', 'Severe(3)', 'Life-threatening(4)']

# --- EX sanity check: drug per arm consistent? ---
chk = ex.groupby('TRTGRP')['EXDRUG'].unique()
print('EX sanity check (drug by arm):')
for arm, drugs in chk.items():
    print(f'  {arm}: {list(drugs)}')

def severity_by_subject(ae_subset):
    """Subject-level worst AESEV among filtered AE rows, merged with DM covariates."""
    s = (ae_subset.groupby(['USUBJID', 'TRTGRP'])['AESEV'].max().reset_index())
    s = s.merge(dm[['USUBJID', 'patients_seen']], on='USUBJID', how='left')
    s['sevcat'] = s['AESEV'].map(SEV_LAB)
    return s

def holm(pv):
    pv = np.asarray(pv, dtype=float)
    m = len(pv)
    order = np.argsort(pv)
    adj = np.maximum.accumulate(np.minimum(pv[order] * (m - np.arange(m)), 1.0))
    out = np.empty(m); out[order] = adj
    return out

def run_tables(subjects, label):
    print(f'\n{"="*70}\n{label}\n{"="*70}')
    pvals_chi, pvals_fish, methods = [], [], []
    for grp in ['1-50', '51-100', '>100']:
        g = subjects[subjects['patients_seen'] == grp]
        print(f'\n--- Patient volume group: {grp} (COVID-AE subjects n={len(g)}) ---')
        tab = pd.crosstab(g['sevcat'], g['TRTGRP']).reindex(SEV_ORDER).fillna(0).astype(int)
        tab = tab[[c for c in ['BCG', 'Placebo'] if c in tab.columns]]
        print('4-level severity x arm cell counts:')
        print(tab.to_string())
        obs = tab.values
        # main: chi-square on 4-level table (drop all-zero rows to avoid degenerate table)
        keep = obs.sum(axis=1) > 0
        obs_k = obs[keep]
        if obs_k.shape[0] < 2:
            print('  Chi-square not estimable (<2 non-empty severity rows).')
            pvals.append(np.nan); methods.append('not estimable')
        else:
            chi2, p, dof, exp = chi2_contingency(obs_k)
            min_exp = exp.min()
            print(f'  Chi-square(4-level): chi2={chi2:.4f}, dof={dof}, p={p:.6f}, '
                  f'min expected={min_exp:.2f}')
            if min_exp < 5:
                print('  -> Sparse cells (expected <5): Fisher fallback below.')
            pvals_chi.append(p); methods.append('chi-square(4-level)')
        # Fisher exact on collapsed 2x2: severe {3,4} vs mild/moderate {1,2}
        g2 = g[g['sevcat'].notna()].copy()
        g2['collapsed'] = np.where(g2['AESEV'] >= 3, 'Severe(3-4)', 'Mild/Mod(1-2)')
        tab2 = pd.crosstab(g2['collapsed'], g2['TRTGRP']).reindex(
            ['Mild/Mod(1-2)', 'Severe(3-4)']).fillna(0).astype(int)
        tab2 = tab2[[c for c in ['BCG', 'Placebo'] if c in tab2.columns]]
        print('Collapsed 2x2 (Mild/Mod vs Severe) cell counts:')
        print(tab2.to_string())
        OR, pf = fisher_exact(tab2.values)
        chi2c, pc, dofc, expc = chi2_contingency(tab2.values)
        print(f'  Fisher exact 2x2: OR={OR:.4f}, p={pf:.6f} (min expected={expc.min():.2f}); '
              f'chi2 2x2 p={pc:.6f}')
        pvals_fish.append(pf); methods[-1] += ' + Fisher(2x2)'
    print('\nSummary (unadjusted headline; Holm over the 3 group-level tests):')
    for grp, pc, pf, meth in zip(['1-50', '51-100', '>100'], pvals_chi, pvals_fish, methods):
        print(f'  {grp}: chi2(4-level) p={pc:.6f}, Fisher(2x2) p={pf:.6f} [{meth}]')
    h_fish = holm(pvals_fish)
    h_chi = holm(pvals_chi)
    print('  Holm-adjusted: ' + ', '.join(
        f"{g}: Fisher {hf:.6f} / chi2 {hc:.6f}"
        for g, hf, hc in zip(['1-50', '51-100', '>100'], h_fish, h_chi)))
    return pvals_fish

# --- Main analysis: COVID-19 AEs only, subject-level worst AESEV ---
cov = ae[ae['AEPT'].str.contains('COVID', case=False, na=False)]
print(f'\nCOVID-19 AE rows: {len(cov)}; subjects: {cov.USUBJID.nunique()}')
subj = severity_by_subject(cov)
print(f'Subjects with COVID AE: {len(subj)}; missing AESEV: {subj.sevcat.isna().sum()} '
      '(excluded from main tables)')
p_main = run_tables(subj[subj['sevcat'].notna()], 'MAIN: COVID-19 AEs, subject-max AESEV, '
                    '4-level severity x arm (missing severity excluded)')

# --- Sensitivity: all RTI-category AEs ---
rti = ae[ae['AECAT'] == 'RTI']
subj_rti = severity_by_subject(rti)
print(f'\nSensitivity RTI rows: {len(rti)}; subjects: {rti.USUBJID.nunique()}; '
      f'missing AESEV: {subj_rti.sevcat.isna().sum()}')
p_sens = run_tables(subj_rti[subj_rti['sevcat'].notna()],
                    'SENSITIVITY: AECAT==RTI, subject-max AESEV (missing excluded)')

# --- Headline significance flags ---
print('\n' + '='*70)
print('HEADLINE (unadjusted p<0.05):')
for grp, p in zip(['1-50', '51-100', '>100'], p_main):
    print(f'  {grp}: p={p:.6f} -> {"SIGNIFICANT" if (not np.isnan(p) and p<0.05) else "not significant"}')
