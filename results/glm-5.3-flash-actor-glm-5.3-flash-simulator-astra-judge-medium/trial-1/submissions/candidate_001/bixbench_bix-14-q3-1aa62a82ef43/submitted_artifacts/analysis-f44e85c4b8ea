#!/usr/bin/env python3
"""
Count non-reference exonic variants in CHIP genes across 86 samples
(bixbench:bix-14-q3).

Approved filters:
  1. Zygosity in {Heterozygous, Homozygous Variant}   (excludes 'Reference' calls
     and blank-zygosity no-calls)
  2. Sequence Ontology (Combined) in {synonymous_variant, missense_variant,
     inframe_insertion, inframe_deletion, frameshift_variant}
     (excludes intron_variant, 5'/3' UTR variants incl.
      5_prime_UTR_premature_start_codon_gain_variant, splice_region_variant,
      upstream_gene_variant)
  3. Gene Names intersects the 56-gene CHIP list (comma-separated lists are split;
     e.g. 'TET2,TET2-AS1' -> TET2). The In_CHIP vendor column is over-inclusive
     (True even for MMAB/MMACHC/SF3B2 rows) and is reported but NOT used as filter.
  4. Within-sample dedup on (Chr:Pos, Ref/Alt, Gene Names).

Outputs:
  PRIMARY   : non-reference exonic CHIP-gene variant rows summed across 86 samples
  SECONDARY : cohort-level unique (Chr:Pos, Ref/Alt, Gene) variant-gene combinations
"""
import openpyxl, glob, os, collections, json
import pandas as pd

GENE_FILE = 'data/230214_Schenz_et_al_2022_CHIP_Genes.xlsx'
VAR_DIR   = 'data/CHIP_DP10_GQ20_PASS'
OUT_CSV   = 'analysis/per_sample_chip_exonic_variants.csv'
OUT_JSON  = 'analysis/chip_exonic_summary.json'

wb = openpyxl.load_workbook(GENE_FILE, read_only=True)
chip_genes = sorted({str(r[0]).strip().upper() for r in wb['Sheet1'].iter_rows(values_only=True) if r[0]})
assert len(chip_genes) == 56, len(chip_genes)

EXONIC_SO = {'synonymous_variant', 'missense_variant', 'inframe_insertion',
             'inframe_deletion', 'frameshift_variant'}
NONREF_ZYG = {'Heterozygous', 'Homozygous Variant'}
HEADER_ROW = 2   # subheader row (1-indexed); row 1 holds merged group headers incl. sample label

files = sorted(glob.glob(os.path.join(VAR_DIR, '*.xlsx')))
assert len(files) == 86, len(files)

schema_check = set()
per_sample, dedup_dropped, gene_mismatch_rows = [], collections.Counter(), collections.Counter()
zyg_excluded = collections.Counter()
unique_cohort = set()
so_breakdown_kept = collections.Counter()
gene_totals = collections.Counter()
inchip_overinclusive = collections.Counter()

for f in files:
    wb = openpyxl.load_workbook(f, read_only=False)
    ws = wb[wb.sheetnames[0]]
    schema_check.add(tuple(c.value for c in ws[HEADER_ROW]))
    sample_label = ws.cell(row=1, column=5).value or ''
    m = os.path.basename(f)
    sample_id = m.replace('230209_Exome_GRCh38_CHIP_', '').replace('.xlsx', '')
    assert sample_label.endswith('(' + sample_id + ')'), (sample_label, m)

    rows = list(ws.iter_rows(min_row=HEADER_ROW + 1, values_only=True))
    kept, seen = 0, set()
    for r in rows:
        pos, ra, zyg, gene, so = r[0], r[1], r[4], r[12], r[13]
        inc = r[29]
        if zyg not in NONREF_ZYG:                       # filter 1
            zyg_excluded['Reference' if zyg == 'Reference' else 'blank/no-call'] += 1
            continue
        genes = [g.strip().upper() for g in str(gene).split(',')] if gene else []
        chip_hits = [g for g in genes if g in chip_genes]
        if not chip_hits:                               # filter 3
            gene_mismatch_rows[str(gene)] += 1
            if str(inc) == 'True':                      # vendor flag over-inclusive
                inchip_overinclusive[str(gene)] += 1
            continue
        if so not in EXONIC_SO:                         # filter 2
            continue
        key = (pos, ra, str(gene))                      # filter 4 (within-sample dedup)
        if key in seen:
            dedup_dropped[m] += 1
            continue
        seen.add(key)
        unique_cohort.add(key)
        so_breakdown_kept[so] += 1
        for g in chip_hits:
            gene_totals[g] += 1
        kept += 1
    per_sample.append({'file': m, 'sample_id': sample_id, 'sample_label': sample_label,
                       'total_variant_rows': len(rows), 'kept_exonic_nonref': kept})
    wb.close()

df = pd.DataFrame(per_sample)
df.to_csv(OUT_CSV, index=False)
total = int(df.kept_exonic_nonref.sum())
summary = {
    'n_samples': len(files),
    'identical_schema_across_all_files': len(schema_check) == 1,
    'chip_genes_in_list': len(chip_genes),
    'total_variant_rows_all_files': int(df.total_variant_rows.sum()),
    'excluded_reference_zygosity_rows': zyg_excluded['Reference'],
    'excluded_blank_nocall_rows': zyg_excluded['blank/no-call'],
    'excluded_rows_gene_not_in_56gene_list': dict(gene_mismatch_rows),
    'of_which_In_CHIP_vendor_flag_True_but_gene_absent_from_list': dict(inchip_overinclusive),
    'dedup_rows_dropped_within_sample': int(sum(dedup_dropped.values())),
    'files_with_dedup_drops': len(dedup_dropped),
    'kept_by_SO': dict(so_breakdown_kept),
    'kept_by_gene': dict(gene_totals.most_common()),
    'PRIMARY_total_nonreference_exonic_CHIP_variant_rows_86_samples': total,
    'SECONDARY_unique_variant_gene_combinations_cohort_level': len(unique_cohort),
    'per_sample_min': int(df.kept_exonic_nonref.min()),
    'per_sample_max': int(df.kept_exonic_nonref.max()),
}
with open(OUT_JSON, 'w') as fh:
    json.dump(summary, fh, indent=2)
print(json.dumps(summary, indent=2))
print('\nPer-sample table:')
print(df.to_string(index=False))
