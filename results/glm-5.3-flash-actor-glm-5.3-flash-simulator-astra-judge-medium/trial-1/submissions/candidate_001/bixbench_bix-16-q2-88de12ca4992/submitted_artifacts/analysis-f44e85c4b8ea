"""
BixBench bix-16-q2: Skewness of the log2(TPM+1) gene-expression distribution
across all cell lines (DepMap expression, batch-corrected).

Inputs : data/OmicsExpressionProteinCodingGenesTPMLogp1BatchCorrected.csv
         (data/Model.csv used only to confirm ModelID keying; CRISPRGeneEffect.csv
          is tangential and is deliberately NOT loaded.)
Method : Pool all cell-line x gene values into one distribution and compute the
         Fisher-Pearson skewness g1 (biased) and the bias-corrected sample G1.
         Secondary: per-gene (column-wise) skewness summary.
"""
import numpy as np
import pandas as pd
from scipy import stats

CSV = "data/OmicsExpressionProteinCodingGenesTPMLogp1BatchCorrected.csv"

# ---- load (index_col=0 keeps the ModelID column OUT of the numeric values) ----
df = pd.read_csv(CSV, index_col=0)
print(f"matrix: {df.shape[0]} cell lines x {df.shape[1]} genes")
assert df.index.str.startswith("ACH-").all(), "first column must be ModelID"

vals = df.to_numpy(dtype=np.float64)
assert np.isfinite(vals).all(), "non-finite values found"   # guard: no NaN/inf

# ---- degenerate gene columns ----
col_min = vals.min(axis=0)
col_max = vals.max(axis=0)
zero_var = col_max == col_min
print(f"zero-variance (degenerate) gene columns: {int(zero_var.sum())}")

# ---- pooled distribution ----
pooled = vals.ravel()
mean = pooled.mean(); median = np.median(pooled); std = pooled.std(ddof=1)
g1 = stats.skew(pooled, bias=True)      # Fisher-Pearson coefficient
G1 = stats.skew(pooled, bias=False)     # bias-corrected sample skewness
print(f"\nPOOLED distribution (n={pooled.size:,} values):")
print(f"  mean={mean:.6f}  median={median:.6f}  std(ddof=1)={std:.6f}")
print(f"  min={pooled.min():.6f}  max={pooled.max():.6f}")
print(f"  skewness g1 (Fisher-Pearson, biased) = {g1:.6f}")
print(f"  skewness G1 (bias-corrected sample)  = {G1:.6f}")

# quartiles for shape context
q = np.percentile(pooled, [1, 25, 50, 75, 99])
print("  percentiles p1/p25/p50/p75/p99:", np.round(q, 4).tolist())

# ---- per-gene (column-wise) skewness, secondary view ----
gene_sk = stats.skew(vals, axis=0, bias=True)
print(f"\nPER-GENE skewness (n_genes={gene_sk.size}):")
print(f"  median={np.median(gene_sk):.4f}  q1={np.percentile(gene_sk,25):.4f} "
      f"q3={np.percentile(gene_sk,75):.4f}  min={gene_sk.min():.4f}  max={gene_sk.max():.4f}")
print(f"  fraction of genes with skew>0: {np.mean(gene_sk>0):.4f}")
