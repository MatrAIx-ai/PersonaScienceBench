#!/usr/bin/env python3
"""BixBench bix-22-q2: Pearson correlation between gene length and mean expression
in CD4 immune cells (protein-coding genes)."""
import pandas as pd
import numpy as np
from scipy import stats

META = 'data/GeneMetaInfo_Zenodo.csv'
COUNTS = 'data/BatchCorrectedReadCounts_Zenodo.csv'
ANNOT = 'data/Sample_annotated_Zenodo.csv'

# --- Load with first column explicitly used as the key (avoid column shifting) ---
meta = pd.read_csv(META, index_col=0)
meta.index.name = 'Geneid'
counts = pd.read_csv(COUNTS, index_col=0)
counts.index.name = 'Geneid'
annot = pd.read_csv(ANNOT)

print("meta:", meta.shape, "counts:", counts.shape, "annot:", annot.shape)

# --- (a) Identify CD4 samples and subset counts ---
cd4_samples = annot.loc[annot['celltype'] == 'CD4', 'sample'].tolist()
print(f"CD4 samples (annotation): {len(cd4_samples)}")
missing = set(cd4_samples) - set(counts.columns)
extra = set(c for c in counts.columns if 'CD4' in c) - set(cd4_samples)
assert not missing and not extra, (missing, extra)
cd4 = counts[cd4_samples]                      # 59453 x 151
print(f"CD4 counts subset: {cd4.shape}")

# --- (b) Mean expression across CD4 samples ---
mean_raw = cd4.mean(axis=1)                    # mean raw (batch-corrected) count
mean_log = np.log2(cd4 + 1).mean(axis=1)       # sensitivity: mean of log2(count+1)
all_zero = (cd4.sum(axis=1) == 0)

# --- (c) Join to Length, filter to exactly 'protein_coding' ---
joined = pd.DataFrame({
    'mean_raw': mean_raw, 'mean_log': mean_log, 'all_zero': all_zero
}).join(meta[['Length', 'gene_biotype']], how='inner')
pc = joined[joined['gene_biotype'] == 'protein_coding']
print(f"Inner join size: {len(joined)}; protein_coding (exact): {len(pc)}")

# --- (d) Pearson correlations ---
def corr(col):
    r, p = stats.pearsonr(pc[col], pc['Length'])
    return r, p

r_raw, p_raw = corr('mean_raw')
r_log, p_log = corr('mean_log')
pc_nz = pc[~pc['all_zero']]
r_raw_nz, _ = stats.pearsonr(pc_nz['mean_raw'], pc_nz['Length'])
r_log_nz, _ = stats.pearsonr(pc_nz['mean_log'], pc_nz['Length'])

print(f"\nPRIMARY: r(mean raw count, Length) = {r_raw:.4f} (p={p_raw:.3e}), n genes={len(pc)}, n samples={len(cd4_samples)}")
print(f"SENSITIVITY log2(count+1) mean: r = {r_log:.4f}")
print(f"SENSITIVITY excluding all-zero genes: n={len(pc_nz)}, r_raw={r_raw_nz:.4f}, r_log={r_log_nz:.4f}")
print(f"All-zero protein-coding genes excluded from primary: {(pc['all_zero']).sum()}")
print(f"Length range: {pc['Length'].min()}–{pc['Length'].max()}; mean raw expr range: {pc['mean_raw'].min():.2f}–{pc['mean_raw'].max():.2f}")

results = pd.DataFrame([
    {'variant': 'primary_raw_mean', 'pearson_r': r_raw, 'p_value': p_raw, 'n_genes': len(pc), 'n_samples': len(cd4_samples)},
    {'variant': 'log2_mean', 'pearson_r': r_log, 'p_value': p_log, 'n_genes': len(pc), 'n_samples': len(cd4_samples)},
    {'variant': 'raw_mean_excl_allzero', 'pearson_r': r_raw_nz, 'p_value': np.nan, 'n_genes': len(pc_nz), 'n_samples': len(cd4_samples)},
    {'variant': 'log2_mean_excl_allzero', 'pearson_r': r_log_nz, 'p_value': np.nan, 'n_genes': len(pc_nz), 'n_samples': len(cd4_samples)},
])
results.to_csv('artifacts/results_bix22q2.csv', index=False)
print("\nSaved artifacts/results_bix22q2.csv")
