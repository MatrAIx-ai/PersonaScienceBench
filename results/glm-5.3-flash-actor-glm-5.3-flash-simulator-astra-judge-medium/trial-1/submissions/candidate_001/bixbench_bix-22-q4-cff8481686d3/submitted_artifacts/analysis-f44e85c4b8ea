"""
Pearson correlation between gene length and mean expression (across samples)
for protein-coding genes in CD14 immune cells.

BixBench episode: bixbench:bix-22-q4
Inputs:
  data/GeneMetaInfo_Zenodo.csv            (Geneid, Chr, Length, gene_biotype)
  data/BatchCorrectedReadCounts_Zenodo.csv (rows = genes, cols = 723 samples)
  data/Sample_annotated_Zenodo.csv        (sample, samp, samtype, celltype, batch, sex)

Design (approved by researcher):
  PRIMARY  : Pearson r between Length and RAW mean of the supplied
             BatchCorrectedReadCounts across the 132 CD14 samples,
             protein-coding genes (exact biotype match 'protein_coding'),
             all-zero genes retained.
  Variant A: per-sample CPM depth-normalized mean, same gene set.
  Variant B: log2(CPM mean + 1).
  Sensitivity 1: exclude 1,849 all-zero protein-coding genes (raw-mean primary).
  Sensitivity 2: additionally include the 12 mixed-biotype rows containing a
             'protein_coding' token.
Join invariants are asserted at runtime. No TPM/length normalization of
expression is applied (would mechanically bias the length-expression relation).
"""
import numpy as np
import pandas as pd

OUT = []

def log(msg):
    print(msg)
    OUT.append(msg)

# ---------------------------------------------------------------- load
meta = pd.read_csv("data/GeneMetaInfo_Zenodo.csv")
counts = pd.read_csv("data/BatchCorrectedReadCounts_Zenodo.csv")
annot = pd.read_csv("data/Sample_annotated_Zenodo.csv")

log(f"meta:   {meta.shape[0]} rows x {meta.shape[1]} cols, missing={int(meta.isna().sum().sum())}")
log(f"counts: {counts.shape[0]} rows x {counts.shape[1]} cols, missing={int(counts.isna().sum().sum())}")
log(f"annot:  {annot.shape[0]} rows x {annot.shape[1]} cols, missing={int(annot.isna().sum().sum())}")

# ---------------------------------------------------------------- join invariants
counts = counts.rename(columns={"Unnamed: 0": "Geneid"})
assert meta["Geneid"].is_unique and counts["Geneid"].is_unique
assert annot["sample"].is_unique
gene_ids_meta = set(meta["Geneid"])
gene_ids_counts = set(counts["Geneid"])
assert gene_ids_meta == gene_ids_counts, "gene ID sets differ!"
sample_cols = [c for c in counts.columns if c != "Geneid"]
assert set(sample_cols) == set(annot["sample"]), "sample ID sets differ!"
assert (meta["Length"] > 0).all() and meta["Length"].notna().all()
log("INVARIANTS OK: gene IDs 59,453/59,453 identical; sample sets identical (723); "
    "Length>0 everywhere; no missing values.")

# ---------------------------------------------------------------- CD14 subset (celltype authoritative)
cd14_samples = annot.loc[annot["celltype"] == "CD14", "sample"].tolist()
log(f"CD14 samples from annotation (celltype=='CD14'): {len(cd14_samples)} "
    f"(note: only {sum(s.endswith('CD14') for s in cd14_samples)} end in literal 'CD14'; "
    f"{sum(not s.endswith('CD14') for s in cd14_samples)} have _1/_2 visit suffixes)")
cd = counts.set_index("Geneid").loc[:, cd14_samples]          # 59453 x 132
assert cd.shape == (len(meta), len(cd14_samples))
log(f"CD14 count matrix: {cd.shape[0]} genes x {cd.shape[1]} samples; "
    f"total counts = {int(cd.to_numpy().sum()):,}")

# ---------------------------------------------------------------- gene set: protein_coding
exact_pc = meta.loc[meta["gene_biotype"] == "protein_coding", "Geneid"]
mixed_pc = meta.loc[meta["gene_biotype"].str.contains("protein_coding")
                    & (meta["gene_biotype"] != "protein_coding"), "Geneid"]
log(f"protein_coding (exact match): {len(exact_pc)} genes; "
    f"mixed-biotype rows containing a protein_coding token: {len(mixed_pc)}")

# ---------------------------------------------------------------- expression metrics
sub = cd.loc[exact_pc]                                        # 19942 x 132
lib = cd.sum(axis=0)                                          # per-sample library size
cpm = cd.div(lib, axis=1) * 1e6
cpm_pc = cpm.loc[exact_pc]

mean_raw = sub.mean(axis=1)
mean_cpm = cpm_pc.mean(axis=1)
mean_log2 = np.log2(mean_cpm + 1.0)                            # log2(mean CPM + 1)
length = meta.set_index("Geneid").loc[exact_pc, "Length"]

all_zero = (sub == 0).all(axis=1)
log(f"all-zero protein-coding genes across CD14: {int(all_zero.sum())}")

def pearson(x, y):
    return float(np.corrcoef(x, y)[0, 1])

r_primary = pearson(length, mean_raw)
r_cpm     = pearson(length, mean_cpm)
r_log2    = pearson(length, mean_log2)
r_nozero  = pearson(length[~all_zero], mean_raw[~all_zero])

# sensitivity 2: include the 12 mixed-biotype protein-coding-token genes
genes_all = pd.Index(exact_pc).union(pd.Index(mixed_pc))
sub_all = cd.loc[genes_all]
mean_raw_all = sub_all.mean(axis=1)
length_all = meta.set_index("Geneid").loc[genes_all, "Length"]
r_mixed = pearson(length_all, mean_raw_all)
all_zero_all = (sub_all == 0).all(axis=1)
r_mixed_nozero = pearson(length_all[~all_zero_all], mean_raw_all[~all_zero_all])

# ---------------------------------------------------------------- report
log("")
log("================ RESULTS ================")
log(f"PRIMARY  | raw mean of supplied counts | all 19,942 PC genes | r = {r_primary:.4f}")
log(f"Variant A| CPM-normalized mean         | all 19,942 PC genes | r = {r_cpm:.4f}")
log(f"Variant B| log2(mean CPM + 1)          | all 19,942 PC genes | r = {r_log2:.4f}")
log(f"Sens. 1  | raw mean, 1,849 all-zero genes EXCLUDED          | r = {r_nozero:.4f}")
log(f"Sens. 2  | raw mean, incl. 12 mixed-biotype token rows     | r = {r_mixed:.4f}")
log(f"Sens. 2b | raw mean, mixed rows, all-zero excluded         | r = {r_mixed_nozero:.4f}")
log("")
log(f"Spread across variants: min r = {min(r_primary, r_cpm, r_log2, r_nozero, r_mixed):.4f}, "
    f"max r = {max(r_primary, r_cpm, r_log2, r_nozero, r_mixed):.4f}")

# quick shape diagnostics for the primary variant
log("")
log("Primary-variant diagnostics:")
log(f"  Length:      mean {length.mean():.0f}, median {length.median():.0f}, range {length.min()}-{length.max()}")
log(f"  mean_raw:    median {mean_raw.median():.2f}, max {mean_raw.max():.1f}, skew "
    f"{float(pd.Series(mean_raw).skew()):.2f}")
log(f"  Pearson n = {len(length)} gene pairs")

with open("analysis/results_summary.txt", "w") as f:
    f.write("\n".join(OUT) + "\n")
log("\nSummary written to analysis/results_summary.txt")
