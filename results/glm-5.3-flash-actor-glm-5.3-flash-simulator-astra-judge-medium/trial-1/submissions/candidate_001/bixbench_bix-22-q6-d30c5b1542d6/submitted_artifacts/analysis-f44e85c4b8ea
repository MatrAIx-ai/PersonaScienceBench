"""
BixBench bix-22-q6: Pearson correlation between gene length and gene expression
for protein-coding genes.

Primary result (literal reading, per researcher approval):
  scipy.stats.pearsonr(Length, mean_expression) on exact 'protein_coding' genes,
  expression = cross-sample mean of BatchCorrectedReadCounts, all 723 samples
  equally weighted, no transform.

Sensitivity variants (log transforms, all-zero exclusion, CPM normalization)
reported alongside but are NOT the primary answer.
"""
import numpy as np
import pandas as pd
from scipy import stats

meta = pd.read_csv('data/GeneMetaInfo_Zenodo.csv', index_col=0)
counts = pd.read_csv('data/BatchCorrectedReadCounts_Zenodo.csv', index_col=0)

# --- exact protein_coding filter ---
pc_mask = meta['gene_biotype'] == 'protein_coding'
genes = meta.index[pc_mask]
lengths = meta.loc[genes, 'Length'].astype(float)
expr = counts.loc[genes].mean(axis=1)  # cross-sample mean, equal weights

print(f"n protein_coding genes (exact match): {len(genes)}")
print(f"samples used: {counts.shape[1]} (all, equally weighted)")

def report(label, x, y):
    r, p = stats.pearsonr(x, y)
    print(f"{label:<55s} r = {r: .5f}  p = {p:.3e}  n = {len(x)}")
    return r, p

print("\n--- PRIMARY (no transform, all protein_coding genes) ---")
r_primary, p_primary = report("pearsonr(Length, mean_expression)", lengths.values, expr.values)

print("\n--- SENSITIVITY VARIANTS ---")
report("log2(Length) vs log2(mean_expr + 1)", np.log2(lengths.values), np.log2(expr.values + 1))
report("log2(Length) vs mean_expr (log length only)", np.log2(lengths.values), expr.values)
report("Length vs log2(mean_expr + 1)", lengths.values, np.log2(expr.values + 1))

nz = expr.values > 0
report("no transform, exclude all-zero genes", lengths.values[nz], expr.values[nz])
report("log2 both, exclude all-zero genes", np.log2(lengths.values[nz]), np.log2(expr.values[nz] + 1))

# CPM-normalized per-sample, then per-gene mean
lib = counts.sum(axis=0)
cpm_mean = (counts.loc[genes] / lib * 1e6).mean(axis=1)
report("Length vs mean CPM (per-sample normalized)", lengths.values, cpm_mean.values)
report("log2(Length) vs log2(mean CPM + 1)", np.log2(lengths.values), np.log2(cpm_mean.values + 1))

print(f"\nPRIMARY ANSWER: r = {r_primary:.4f} (p = {p_primary:.3e}, n = {len(genes)})")
