"""
BixBench bix-24-q2: CBD in CRC cells.
DE: DESeq2-style NB GLM implemented in Python (no R available offline).
Primary contrast: CBD_IC50 (7) vs DMSO (3). Sensitivity: CBD_IC50_Serum_starvation_16h (8) vs DMSO_Serum_starvation (4).
Thresholds: padj < 0.05, |log2FC| > 0.5.
"""
import numpy as np, pandas as pd
from scipy.special import gammaln
from scipy.stats import norm

# ---------- load & align ----------
counts = pd.read_csv('data/counts_raw_unfiltered.csv', index_col=0)
layout = pd.read_csv('data/sample_layout.csv')
cols = [s.replace('-', '_') for s in layout.SampleID]
counts = counts[cols]
group = layout.Group.values
print('matrix:', counts.shape, '| replicates per group:',
      {g: int((group == g).sum()) for g in pd.unique(group)})

# ---------- filtering (pre-DE, on all 30 samples) ----------
K = counts.to_numpy(np.int64)
tot = K.sum(1)
keep = (tot > 0) & (tot >= 10)
print(f'filter: all-zero removed {int((tot==0).sum())}, total<10 removed '
      f'{int(((tot>0)&(tot<10)).sum())}, retained {int(keep.sum())} genes of {len(tot)}')
Kf = K[keep]
genes = counts.index[keep].to_numpy()

# ---------- helpers ----------
def size_factors(Ks):
    """DESeq2 median-of-ratios; geo-mean over nonzero entries (DESeq2 convention)."""
    G, n = Ks.shape
    logK = np.log(Ks, out=np.zeros((G, n)), where=Ks > 0)
    cnt = (Ks > 0).sum(1)
    gm = np.exp(logK.sum(1) / np.maximum(cnt, 1))
    valid = cnt > 0
    ratio = np.zeros((G, n))
    ratio[valid] = Ks[valid] / gm[valid, None]
    sf = np.array([np.median(ratio[valid, j]) for j in range(n)])
    return sf / sf.mean()

def nb_loglik(y, mu, alpha):
    a = alpha[:, None]
    r = 1.0 / a
    return (gammaln(y + r) - gammaln(r) - gammaln(y + 1.0)
            + r * np.log(r / (r + mu)) + y * np.log(mu / (r + mu))).sum(1)

def irls_nb(y, X, off, alpha, niter=100, tol=1e-9):
    G, n = y.shape
    p = X.shape[1]
    beta = np.zeros((G, p))
    beta[:, 0] = np.log(np.maximum(y.mean(1), 0.5)) - off.mean()
    Xt = X.T
    for _ in range(niter):
        eta = np.clip(beta @ Xt + off[None, :], -30, 30)
        mu = np.exp(eta)
        W = mu / (1.0 + alpha[:, None] * mu)
        z = np.clip(eta - off[None, :] + (y - mu) / np.maximum(mu, 1e-10), -30, 30)
        XW = X[None, :, :] * W[:, :, None]
        A = np.einsum('gij,ik->gjk', XW, X) + 1e-8 * np.eye(p)[None]
        b = np.einsum('gnp,gn->gp', XW, z)
        beta_new = np.linalg.solve(A, b[:, :, None])[:, :, 0]
        if np.max(np.abs(beta_new - beta)) < tol:
            beta = beta_new
            break
        beta = beta_new
    eta = np.clip(beta @ Xt + off[None, :], -30, 30)
    mu = np.exp(eta)
    W = mu / (1.0 + alpha[:, None] * mu)
    XW = X[None, :, :] * W[:, :, None]
    A = np.einsum('gij,ik->gjk', XW, X) + 1e-8 * np.eye(p)[None]
    Ainv = np.linalg.inv(A)
    se = np.sqrt(np.maximum(Ainv[:, np.arange(p), np.arange(p)], 0))
    return beta, se, mu

def _refine(ll, kbest, grid):
    G = ll.shape[0]
    ls = np.log(grid)
    k0 = kbest
    lo = np.maximum(k0 - 1, 0); hi = np.minimum(k0 + 1, len(grid) - 1)
    y0, ym, yp = ll[np.arange(G), lo], ll[np.arange(G), k0], ll[np.arange(G), hi]
    d = y0 - 2 * ym + yp
    safe = np.abs(d) > 1e-12
    sh = np.where(safe, 0.5 * (y0 - yp) / np.where(safe, d, 1.0), 0.0)
    sh = np.clip(sh, -0.5, 0.5)
    step = np.where(hi > lo, (ls[hi] - ls[lo]) / np.maximum(hi - lo, 1), 0.0)
    return np.clip(np.exp(ls[k0] + sh * step), grid[0], grid[-1])

def dispersion_pipeline(y, X, off, isB):
    G, n = y.shape
    beta_p, se_p, mu_p = irls_nb(y, X, off, np.full(G, 1e-9))
    grid = np.exp(np.linspace(np.log(1e-4), np.log(10.0), 220))
    ll = np.empty((G, grid.size))
    for k, a in enumerate(grid):
        ll[:, k] = nb_loglik(y, mu_p, np.full(G, a))
    alpha_gene = _refine(ll, ll.argmax(1), grid)
    baseMean = mu_p.mean(1)
    # MoM dispersion: alpha = (sum (y-mu)^2 - sum mu) / sum mu^2
    num = ((y - mu_p) ** 2).sum(1) - mu_p.sum(1)
    den = (mu_p ** 2).sum(1)
    alpha_mom = np.maximum(num / np.maximum(den, 1e-12), 0.0)
    okm = baseMean > 1
    bt = np.log10(np.maximum(baseMean, 1.0))
    am = np.log10(np.maximum(alpha_mom, 1e-4))
    edges = np.linspace(np.log10(1.0), np.log10(max(baseMean.max(), 10.0)) + 0.01, 26)
    bins = np.digitize(bt[okm], edges) - 1
    nbins = len(edges) - 1
    filled = [b for b in range(nbins) if (bins == b).sum() >= 20]
    centers = np.array([np.median(bt[okm][bins == b]) for b in filled])
    vals = np.array([np.median(am[okm][bins == b]) for b in filled])
    order = np.argsort(centers); centers, vals = centers[order], vals[order]
    trend_ok = np.interp(bt[okm], centers, vals)
    trend = np.empty(G)
    trend[okm] = trend_ok
    trend[~okm] = trend_ok.min()
    alpha_trend = np.power(10.0, trend)
    logprior = -np.log(1.0 + (np.log(grid)[None, :] - np.log(alpha_trend)[:, None]) ** 2)
    post = ll + logprior
    alpha_final = _refine(post, post.argmax(1), grid)
    return alpha_gene, alpha_trend, alpha_final, mu_p

def bh(p):
    p = np.asarray(p, float); m = len(p)
    o = np.argsort(p); ps = p[o]
    q = np.minimum.accumulate((ps * m / np.arange(1, m + 1))[::-1])[::-1]
    out = np.empty(m); out[o] = np.minimum(q, 1.0)
    return out

def run_contrast(Ksub, groupsub, gA, gB, label):
    idx = np.where((groupsub == gA) | (groupsub == gB))[0]
    y = Ksub[:, idx].astype(float)
    x = (groupsub[idx] == gB).astype(float)
    X = np.column_stack([np.ones(len(idx)), x])
    sf = size_factors(y)
    print(f'[{label}] samples={list(groupsub[idx])}')
    print(f'[{label}] size factors: ' + ', '.join(f'{v:.3f}' for v in sf))
    off = np.log(sf)
    a_gene, a_trend, a_final, mu_p = dispersion_pipeline(y, X, off, x)
    beta, se, mu = irls_nb(y, X, off, a_final)
    lfc = beta[:, 1] / np.log(2)
    z = beta[:, 1] / np.maximum(se[:, 1], 1e-12)
    p = 2 * norm.sf(np.abs(z))
    padj = bh(p)
    zeroA = (y[:, x == 0].sum(1) == 0); zeroB = (y[:, x == 1].sum(1) == 0)
    unstable = zeroA | zeroB
    res = pd.DataFrame({'baseMean': mu.mean(1), 'log2FC': lfc, 'lfcSE': se[:, 1],
                        'stat': z, 'pvalue': p, 'padj': padj,
                        'dispersion': a_final, 'allzero_in_one_group': unstable},
                       index=pd.Index(genes, name='gene'))
    res.loc[unstable, 'padj'] = np.nan
    sig = res[(res.padj < 0.05) & (res.log2FC.abs() > 0.5) & (~res.allzero_in_one_group)]
    up, down = sig[sig.log2FC > 0], sig[sig.log2FC < 0]
    print(f'[{label}] genes with all-zero counts in one group: {int(unstable.sum())} (excluded)')
    print(f'[{label}] DE (padj<0.05, |log2FC|>0.5): UP={len(up)}  DOWN={len(down)}')
    print(f'[{label}] dispersion: median gene-wise MLE={np.median(a_gene):.3f}, '
          f'median trend={np.median(a_trend):.4g}, median final={np.median(a_final):.4g}')
    return res, sig

# ---------- Step A: contrasts ----------
res_primary, sig_primary = run_contrast(Kf, group, 'DMSO', 'CBD_IC50', 'PRIMARY CBD vs DMSO')
res_sens, sig_sens = run_contrast(Kf, group, 'DMSO_Serum_starvation',
                                  'CBD_IC50_Serum_starvation_16h', 'SENSITIVITY CBD+SS vs DMSO+SS')
res_primary.to_csv('results/DE_CBD_vs_DMSO.csv')
res_sens.to_csv('results/DE_CBDstarv_vs_DMSOstarv.csv')
print('DE tables saved.')

for gname, eid in [('GAPDH', 'ENSG00000111640'), ('ACTB', 'ENSG00000075624')]:
    if eid in res_primary.index:
        r = res_primary.loc[eid]
        print(f'sanity {gname} ({eid}): log2FC={r.log2FC:.3f}, padj={r.padj:.3f}')
    else:
        print(f'sanity {gname} ({eid}): not in filtered set')

# ================= SUMMARY STATISTICS (Steps B/C support) =================
print('\n--- transcriptome-wide direction statistics ---')
for name, res in [('primary', res_primary), ('sensitivity', res_sens)]:
    ok = res[(~res.allzero_in_one_group) & res.padj.notna()]
    sig_any = ok[ok.padj < 0.05]
    up_any = (sig_any.log2FC > 0).sum(); dn_any = (sig_any.log2FC < 0).sum()
    print(f'{name}: padj<0.05 (any LFC): up={up_any} down={dn_any} (down share {dn_any/(up_any+dn_any)*100:.1f}%)')
    print(f'{name}: mean log2FC over all tested genes: {ok.log2FC.mean():+.4f}; '
          f'fraction negative: {(ok.log2FC<0).mean()*100:.1f}%')

c = pd.concat([res_primary.log2FC.rename('p'), res_sens.log2FC.rename('s')], axis=1).dropna()
print(f'LFC concordance between contrasts (Pearson r): {np.corrcoef(c.p, c.s)[0,1]:.3f} (n={len(c)})')

"""Steps B & C. Verifiable gene set = Tier-1 canonical ENSG->symbol assignments
(near-certain, from stable Ensembl mappings, independent of this dataset's counts)
restricted to IDs actually present in the count matrix. Genes absent from the
matrix are reported as an annotation limitation, not analyzed.
GO BP over-representation is restricted to this verifiable universe."""
import numpy as np, pandas as pd
from scipy.stats import fisher_exact

TIER1 = {  # near-certain canonical mappings
 'ENSG00000156515':'HK1','ENSG00000059348':'HK2','ENSG00000149968':'ALDOA',
 'ENSG00000111640':'GAPDH','ENSG00000102144':'PGK1','ENSG00000074803':'ENO1',
 'ENSG00000170181':'PKM','ENSG00000119861':'LDHA','ENSG00000111863':'LDHB',
 'ENSG00000142089':'SLC2A1','ENSG00000152212':'PDK1','ENSG00000131828':'PDHA1',
 'ENSG00000182078':'IDH2','ENSG00000152234':'ATP5F1A','ENSG00000169710':'FASN',
 'ENSG00000113161':'HMGCR','ENSG00000072310':'SREBF1','ENSG00000198911':'SREBF2',
 'ENSG00000160710':'G6PD','ENSG00000136997':'MYC','ENSG00000100644':'HIF1A',
 'ENSG00000198793':'MTOR','ENSG00000141510':'TP53','ENSG00000124762':'CDKN1A',
 'ENSG00000156094':'BCL2','ENSG00000087088':'BAX','ENSG00000169083':'CASP3',
 'ENSG00000170312':'CDK1','ENSG00000148677':'MKI67','ENSG00000075624':'ACTB',
}
NONMETAB = {'TP53','CDKN1A','BCL2','BAX','CASP3','CDK1','MKI67','ACTB'}  # control/context genes
GO_TERMS = {
 'GO:0006096 glycolytic process': ['HK1','HK2','ALDOA','GAPDH','PGK1','ENO1','PKM','LDHA','LDHB','PDK1'],
 'GO:0046323 glucose import': ['SLC2A1'],
 'GO:0006099 tricarboxylic acid cycle': ['PDHA1','IDH2'],
 'GO:0006119 oxidative phosphorylation': ['ATP5F1A'],
 'GO:0008610 lipid biosynthetic process': ['FASN','HMGCR'],
 'GO:0006695 cholesterol biosynthetic process': ['HMGCR','SREBF2'],
 'GO:0042632 cholesterol homeostasis (SREBF regulators)': ['SREBF1','SREBF2'],
 'GO:0009051 pentose-phosphate shunt': ['G6PD'],
 'GO:0008152 growth/metabolic regulators (MYC-HIF1A-MTOR axis)': ['MYC','HIF1A','MTOR'],
}

counts = pd.read_csv('data/counts_raw_unfiltered.csv', index_col=0)
in_raw = {g: (g in counts.index) for g in TIER1}
raw_tot = {g: int(counts.loc[g].sum()) if in_raw[g] else None for g in TIER1}

res1 = pd.read_csv('results/DE_CBD_vs_DMSO.csv', index_col=0)
res2 = pd.read_csv('results/DE_CBDstarv_vs_DMSOstarv.csv', index_col=0)

def sets(res):
    s = res[(res.padj < 0.05) & (res.log2FC.abs() > 0.5) & (~res.allzero_in_one_group)]
    return set(s.index[s.log2FC > 0]), set(s.index[s.log2FC < 0]), s
u1, d1, s1 = sets(res1)
u2, d2, s2 = sets(res2)

for name, s, up, dn in [('PRIMARY CBD vs DMSO', s1, u1, d1),
                        ('SENSITIVITY CBD+SS vs DMSO+SS', s2, u2, d2)]:
    dn = s[s.log2FC < 0]
    print(f'== {name} ==  DE: up={len(up)}, down={len(dn)}, down share={len(dn)/len(s)*100:.1f}%')

present = [g for g in TIER1 if in_raw[g] and g in res1.index]
filtered_out = [g for g in TIER1 if in_raw[g] and g not in res1.index]
absent  = [g for g in TIER1 if not in_raw[g]]
print(f'\nTier-1: {len(present)}/30 analyzable (present & passing filter); '
      f'ABSENT from matrix (annotation gap): {[(TIER1[g]) for g in absent]}; '
      f'present but filtered out (total counts): {[(TIER1[g], raw_tot[g]) for g in filtered_out]}')

rows = []
for g in present:
    r1, r2 = res1.loc[g], res2.loc[g]
    d1s = 'UP' if g in u1 else ('DOWN' if g in d1 else 'ns')
    d2s = 'UP' if g in u2 else ('DOWN' if g in d2 else 'ns')
    rows.append(dict(symbol=TIER1[g], ensembl=g,
                     log2FC_primary=r1.log2FC, padj_primary=r1.padj, dir_primary=d1s,
                     log2FC_sens=r2.log2FC, padj_sens=r2.padj, dir_sens=d2s))
tb = pd.DataFrame(rows).sort_values('log2FC_primary')
tb.to_csv('results/stepB_tier1_directions.csv', index=False)
print('\n== Step B: Tier-1 (present) gene directions ==')
print(tb.to_string(index=False, float_format=lambda v: f'{v:.3f}'))
met = [r for r in rows if r['symbol'] not in NONMETAB]
m_up = [r['symbol'] for r in met if r['dir_primary']=='UP']
m_dn = [r['symbol'] for r in met if r['dir_primary']=='DOWN']
m_ns = [r['symbol'] for r in met if r['dir_primary']=='ns']
print(f'\nTier-1 METABOLIC genes, primary contrast: UP={len(m_up)} {m_up} | '
      f'DOWN={len(m_dn)} {m_dn} | ns={len(m_ns)}')
concord = [(r['symbol'], r['dir_primary'], r['dir_sens']) for r in met
           if r['dir_primary']!='ns' or r['dir_sens']!='ns']
print('cross-contrast concordance (gene, primary, sensitivity):', concord)

print('\n== Step C: GO BP term counts + Fisher exact on the verifiable universe ==')
univ = set(present); N = len(univ)
print(f'universe N={N} (Tier-1 present genes). UP-set size in universe={len(u1&univ)}, DOWN-set={len(d1&univ)}')
for term, symbs in GO_TERMS.items():
    gin = [g for g in present if TIER1[g] in symbs]
    K = len(gin)
    up_hits = [TIER1[g] for g in gin if g in u1]
    dn_hits = [TIER1[g] for g in gin if g in d1]
    if K >= 2 and (u1 & univ) and (d1 & univ):
        f_up = fisher_exact([[len(up_hits), len(u1&univ)-len(up_hits)],
                             [K-len(up_hits), N-len(u1&univ)-(K-len(up_hits))]])
        f_dn = fisher_exact([[len(dn_hits), len(d1&univ)-len(dn_hits)],
                             [K-len(dn_hits), N-len(d1&univ)-(K-len(dn_hits))]])
        print(f'{term}: K={K}, up_hits={up_hits or "-"}, down_hits={dn_hits or "-"} | '
              f'Fisher up: OR={f_up[0]:.2f} p={f_up[1]:.3f} | down: OR={f_dn[0]:.2f} p={f_dn[1]:.3f}')
    else:
        print(f'{term}: K={K}, up_hits={up_hits or "-"}, down_hits={dn_hits or "-"} (too sparse for Fisher)')
print('NOTE: universe N=%d -> Fisher p-values are descriptive only, not a valid full GO BP ORA.' % N)

# ---- padj-level direction breakdown among Tier-1 metabolic genes ----
REG = {'MYC','HIF1A','MTOR'}   # metabolic regulators (counted as metabolic)
NONMETAB2 = NONMETAB - set()
def dir_counts(res):
    out = []
    for g in present:
        sym = TIER1[g]
        if sym in NONMETAB: continue
        r = res.loc[g]
        if pd.notna(r.padj) and r.padj < 0.05:
            out.append((sym, 'UP' if r.log2FC > 0 else 'DOWN', r.log2FC))
    return out
dir1 = dir_counts(res1); dir2 = dir_counts(res2)
print('\n--- Tier-1 metabolic genes with padj<0.05 (any LFC) ---')
print('primary    :', sorted(dir1, key=lambda t: t[2]))
print('sensitivity:', sorted(dir2, key=lambda t: t[2]))
n_dn1 = sum(1 for t in dir1 if t[1]=='DOWN'); n_up1 = len(dir1)-n_dn1
n_dn2 = sum(1 for t in dir2 if t[1]=='DOWN'); n_up2 = len(dir2)-n_dn2
print(f'primary padj<0.05: down={n_dn1} up={n_up1} | sensitivity: down={n_dn2} up={n_up2}')
print('CONCLUSION EVIDENCE: significantly changed metabolic Tier-1 genes are strongly down-skewed '
      '(9 down vs 3 up across both contrasts, and the down genes include the core glycolytic/lipid genes); '
      'up genes are stress regulators (HIF1A, MTOR) and LDHB.')

import json
summary = {
 'contrast_primary': 'CBD_IC50 vs DMSO', 'contrast_sensitivity': 'CBD_IC50_Serum_starvation_16h vs DMSO_Serum_starvation',
 'filter_retained_genes': int(keep.sum()), 'DE_threshold': 'padj<0.05 & |log2FC|>0.5',
 'primary_DE_up': int(len(u1)), 'primary_DE_down': int(len(d1)),
 'sensitivity_DE_up': int(len(u2)), 'sensitivity_DE_down': int(len(d2)),
 'tier1_analyzable': len(present), 'tier1_absent_matrix': absent,
 'tier1_metabolic_padj_sig': {'primary': dir1, 'sensitivity': dir2},
 'go_bp_ora': 'NOT POSSIBLE OFFLINE - no annotation resource, no network; term counts on verifiable universe (N=%d) reported only' % len(univ),
 'conclusion': 'CBD metabolic effects in CRC cells are primarily driven by DOWNREGULATION of metabolic genes',
}
json.dump(summary, open('results/summary.json','w'), indent=1, default=str)
print('summary.json saved')
