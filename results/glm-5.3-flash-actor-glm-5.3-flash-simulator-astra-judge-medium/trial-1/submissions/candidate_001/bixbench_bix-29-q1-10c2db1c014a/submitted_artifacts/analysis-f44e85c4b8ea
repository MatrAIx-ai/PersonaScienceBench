"""
TASK008 BCG-CORONA: Ordinal (proportional-odds) regression of BCG vaccination
on derived COVID-19 severity, controlling for prior medical history count and
patients interaction frequency, and their interaction.
"""
import numpy as np
import pandas as pd
import statsmodels.api as sm
from statsmodels.miscmodels.ordinal_model import OrderedModel

RNG_SEED = 0
DATA = "data"

dm = pd.read_csv(f"{DATA}/TASK008_BCG-CORONA_DM.csv")
ae = pd.read_csv(f"{DATA}/TASK008_BCG-CORONA_AE.csv")
mh = pd.read_csv(f"{DATA}/TASK008_BCG-CORONA_MH.csv")

# ---------------- Covariates ----------------
CHECKLIST = ['Tuberculosis','Hypertension','Diabetes Mellitus',
             'Chronic Obstructive Pulmonary Disease','Asthma','Other lung disease',
             'Cardiovascular disease','Cerebrovascular disease','Kidney disease',
             'Liver disease','Cancer','Organ or bone marrow transplantation',
             'Primary immunodeficiency','Neutropenia or lymphopenia',
             'Current respiratory tract infection','Allergy','Hay fever','chronic sinusitis']

mhchk = mh[(mh.MHSCAT == 'MEDICAL HISTORY') & (mh.MHTERM.isin(CHECKLIST))]
other = mh[(mh.MHSCAT == 'MEDICAL HISTORY') &
           (mh.MHTERM.astype(str).str.startswith('Other:'))]

def mh_count(include_other=True):
    src = pd.concat([mhchk, other]) if include_other else mhchk
    pos = src[src.MHORRES == 2]           # 2 = Yes (validated), 1 = No, NaN -> No
    c = pos.groupby('USUBJID').size().reindex(dm.USUBJID).fillna(0).astype(int)
    c.index.name = 'USUBJID'
    return c

cnt_full = mh_count(True)     # 18 checklist + Other  (PRIMARY)
cnt_18   = mh_count(False)    # 18 checklist only     (sensitivity)

# ---------------- Outcome ----------------
SEV_MAP = {1.0:1, 2.0:2, 3.0:3, 4.0:4}
OUT_MAP = {'Resolved':1,'Resolved_':1,'Improved':1,'Unchanged':2,'Worse':3,'Fatal':4}

cov = ae[ae.AEPT.astype(str).str.contains('COVID', case=False, na=False)].copy()
cov['lev'] = [SEV_MAP[s] if pd.notna(s) else OUT_MAP.get(o, np.nan)
              for s, o in zip(cov.AESEV, cov.AEOUT)]
subj_max = cov.groupby('USUBJID')['lev'].max()          # NaN if all rows imputable-fail
imputed  = cov[cov.AESEV.isna()].USUBJID.unique()       # subjects contributing AEOUT-derived level
aeout_only = sorted(set(cov[cov.AESEV.isna()].USUBJID) -
                    set(cov[cov.AESEV.notna()].USUBJID)) # subjects relying ONLY on fallback

def make_df(cnt):
    df = dm[['USUBJID','TRTGRP','Age','SEX','patients_seen']].copy()
    df['BCG'] = (df.TRTGRP == 'BCG').astype(int)
    df['mh_count'] = df.USUBJID.map(cnt)
    df['sev'] = df.USUBJID.map(subj_max).fillna(0).astype(int)
    df['ps'] = pd.Categorical(df.patients_seen, categories=['1-50','51-100','>100'], ordered=True)
    return df

df = make_df(cnt_full)
print("== PRIMARY DATASET ==")
print("N =", len(df), "| outcome distribution:\n", df.sev.value_counts().sort_index().to_dict())
print("mh_count: mean %.3f range %d-%d" % (df.mh_count.mean(), df.mh_count.min(), df.mh_count.max()))
print("AEOUT-only (fallback) subjects:", len(aeout_only))

PATS_COLS = ['ps_51-100', 'ps_>100']   # created below

def design(d):
    X = pd.DataFrame(index=d.index)
    X['BCG'] = d.BCG
    X['mh_count'] = d.mh_count
    X['ps_51_100'] = (d.ps == '51-100').astype(int)
    X['ps_gt100']  = (d.ps == '>100').astype(int)
    X['mh_x_ps51_100'] = d.mh_count * X['ps_51_100']
    X['mh_x_ps_gt100'] = d.mh_count * X['ps_gt100']
    return X

def fit_ordered(d, ycol='sev', extra=None, report=""):
    y = d[ycol].astype(int)
    X = design(d)
    if extra is not None:
        X = pd.concat([X, extra], axis=1)
    mod = OrderedModel(y, X, distr='logit')
    res = mod.fit(method='bfgs', disp=False)
    b, se = res.params[X.columns], res.bse[X.columns]
    tab = pd.DataFrame({'coef': b, 'OR': np.exp(b),
                        'CI_lo': np.exp(b - 1.96*se), 'CI_hi': np.exp(b + 1.96*se),
                        'p': 2*(1-norm_cdf(np.abs(b/se)))}, index=X.columns)
    print(f"\n--- {report} ---  (n={len(d)}, levels={sorted(y.unique())})")
    print(tab.round(4).to_string())
    print("BCG OR (vs Placebo, higher severity) = %.3f  (95%% CI %.3f-%.3f, p=%.4g)"
          % (tab.loc['BCG','OR'], tab.loc['BCG','CI_lo'], tab.loc['BCG','CI_hi'], tab.loc['BCG','p']))
    return res, tab

def norm_cdf(x):
    from scipy.stats import norm
    return norm.cdf(x)

res, tab = fit_ordered(df, report="PRIMARY: sev(0-4) ~ BCG + mh_count + patients_seen + mh_count x patients_seen")

# ---------------- Sensitivity 1: exclude 'Other' MH rows ----------------
df18 = make_df(cnt_18)
fit_ordered(df18, report="SENS-1: mh_count excludes 'Other' conditions")

# ---------------- Sensitivity 2: drop zero class (COVID subjects only) ----------------
dfc = df[df.sev > 0].copy()
fit_ordered(dfc, report="SENS-2: zero class dropped (COVID subjects only, levels 1-4)")

# ---------------- Sensitivity 3: complete-case AESEV (drop fallback-only subjects) ----------------
dfcc = df[~df.USUBJID.isin(aeout_only)].copy()
print("\nSENS-3 drops %d AEOUT-fallback-only subjects" % len(aeout_only))
fit_ordered(dfcc, report="SENS-3: complete-case AESEV (fallback subjects excluded)")

# ---------------- Sensitivity 4: adjust for Age band + SEX ----------------
age_c = df.Age.replace({'10-19':'<=39','20-29':'<=39','30-39':'<=39',
                        '40-49':'40-59','50-59':'40-59',
                        '60-69':'60+','70-79':'60+'})
print("Collapsed Age bands:", age_c.value_counts().to_dict())
age_d = pd.get_dummies(age_c, prefix='age', drop_first=True).astype(float)
sex_d = (df.SEX == 2).astype(float).rename('sex_2')
fit_ordered(df, extra=pd.concat([age_d, sex_d], axis=1),
            report="SENS-4: additionally adjusted for collapsed Age band + SEX")

# ---------------- Sensitivity 5: BCG x covariate interactions ----------------
Xi = design(df)
Xi['BCG_x_mh'] = df.BCG * df.mh_count
Xi['BCG_x_ps51_100'] = df.BCG * Xi['ps_51_100']
Xi['BCG_x_ps_gt100'] = df.BCG * Xi['ps_gt100']
mod = OrderedModel(df.sev.astype(int), Xi, distr='logit')
resi = mod.fit(method='bfgs', disp=False)
se_i = resi.bse[Xi.columns]
bi = resi.params[Xi.columns]
print("\n--- SENS-5: BCG x covariate interaction model ---")
print(pd.DataFrame({'coef': bi, 'OR': np.exp(bi), 'CI_lo': np.exp(bi-1.96*se_i),
                    'CI_hi': np.exp(bi+1.96*se_i),
                    'p': 2*(1-norm_cdf(np.abs(bi/se_i)))}, index=Xi.columns).round(4).to_string())

# ---------------- Proportional-odds sanity check ----------------
# cutpoint-wise binary logits: P(sev > k) for k = 0..3
print("\n--- Proportional-odds check: BCG log-OR by cumulative cutpoint ---")
X0 = design(df)
rows = []
for k in [0, 1, 2, 3]:
    yk = (df.sev.values > k).astype(int)
    if yk.min() == yk.max():
        rows.append((k, np.nan, np.nan, np.nan, (yk==1).sum())); continue
    lr = sm.Logit(yk, sm.add_constant(X0.values)).fit(disp=False)
    b_bcg, se_bcg = lr.params[1], lr.bse[1]
    rows.append((k, b_bcg, np.exp(b_bcg), 2*(1-norm_cdf(abs(b_bcg/se_bcg))), (yk==1).sum()))
po = pd.DataFrame(rows, columns=['cutpoint_k (sev>k)', 'BCG logOR', 'BCG OR', 'p', 'n_events'])
print(po.round(3).to_string(index=False))
print("PO satisfied if BCG log-ORs are similar across cutpoints.")

print("\nPrimary BCG OR final: %.3f (95%% CI %.3f-%.3f, p=%.4g), BCG vs Placebo, higher severity"
      % (tab.loc['BCG','OR'], tab.loc['BCG','CI_lo'], tab.loc['BCG','CI_hi'], tab.loc['BCG','p']))
