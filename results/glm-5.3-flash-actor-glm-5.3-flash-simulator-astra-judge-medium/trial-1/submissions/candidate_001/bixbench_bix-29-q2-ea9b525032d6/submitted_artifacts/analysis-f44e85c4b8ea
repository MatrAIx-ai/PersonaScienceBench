"""
BixBench bix-29-q2 — Independent effect of each additional ongoing medical
condition (MHONGO) on the odds of higher COVID-19 severity, controlling for
BCG vaccination status (TRTGRP) and patient interaction variables
(patients_seen, expect_interact), via proportional-odds ordinal regression.

PRIMARY outcome : subject-level max AESEV among RTI-category AEs,
                  0 = no RTI/COVID-19 AE -> 5 ordered levels 0-4.
                  Subjects with RTI AEs but unknown AESEV are EXCLUDED.
Sensitivities   : unknown-AESEV imputed (AESER='Yes'->3 else 1);
                  COVID-19-AE-only outcome (collapsed and full);
                  collapsed upper tail (3-4 -> 'severe'); + age/sex.
"""
import numpy as np
import pandas as pd
import statsmodels.api as smapi
from statsmodels.miscmodels.ordinal_model import OrderedModel

DATA = "data/"
dm = pd.read_csv(DATA + "TASK008_BCG-CORONA_DM.csv", low_memory=False)
ae = pd.read_csv(DATA + "TASK008_BCG-CORONA_AE.csv", low_memory=False)
mh = pd.read_csv(DATA + "TASK008_BCG-CORONA_MH.csv", low_memory=False)

# ---------- 1) Ongoing-condition count, deduped ----------
o = mh[mh.MHONGO == "Yes"].copy()
o["term_norm"] = (o["MHTERM"].astype(str).str.strip().str.lower()
                  .str.replace(r"^other:", "", regex=True))
raw_cnt = o.groupby("USUBJID").size()
dedup_cnt = o.groupby("USUBJID")["term_norm"].nunique()
print(f"[dedupe] subjects with >=1 ongoing condition: {raw_cnt.shape[0]}; "
      f"affected by dedupe (had duplicate terms): {int((raw_cnt != dedup_cnt).sum())}")
print(f"[dedupe] Yes-rows before dedupe: {int(raw_cnt.sum())}; after: {int(dedup_cnt.sum())}")
n_ongoing = dedup_cnt.reindex(dm.USUBJID, fill_value=0).rename("n_ongoing")

# ---------- 2) Subject-level severity outcomes ----------
rti = ae[ae.AECAT == "RTI"]
rti_cnt = rti.groupby("USUBJID").size()
sev_na = rti.groupby("USUBJID").AESEV.apply(lambda s: s.isna().all())
ser_yes = set(rti.loc[rti.AESER == "Yes", "USUBJID"])
out = pd.DataFrame(index=dm.USUBJID)
out["has_rti"] = rti_cnt.reindex(out.index, fill_value=0)
out["max_sev"] = rti.groupby("USUBJID").AESEV.max().reindex(out.index)
# PRIMARY: 0 if no RTI AE; NaN if RTI AE with unknown severity (excluded)
out["y_rti"] = np.where(out.has_rti == 0, 0, out.max_sev)
unknown = (out.has_rti > 0) & out.max_sev.isna()
print(f"[outcome] RTI subjects: {int((out.has_rti>0).sum())}; unknown AESEV among "
      f"them: {int(unknown.sum())} (AESER='Yes' -> 3: "
      f"{int(sum(u in ser_yes for u in out.index[unknown]))})")
# Sensitivity: impute unknowns (AESER Yes -> 3, else 1)
out["y_rti_imputed"] = out.y_rti.copy()
out.loc[unknown, "y_rti_imputed"] = [3 if u in ser_yes else 1
                                     for u in out.index[unknown]]
print("[outcome] primary y_rti dist:", out.y_rti.value_counts(dropna=False).sort_index().to_dict())
print("[outcome] imputed  y_rti dist:", out.y_rti_imputed.value_counts(dropna=False).sort_index().to_dict())

cov_ae = ae[ae.AEPT.astype(str).str.contains("COVID|SARS-CoV-2", case=False, na=False)]
cs = cov_ae.groupby("USUBJID").AESEV.max()
out["y_covid"] = np.where(cov_ae.groupby("USUBJID").size().reindex(out.index, fill_value=0) > 0,
                          cs.reindex(out.index), 0)
print("[outcome] COVID-only dist:", out.y_covid.value_counts(dropna=False).sort_index().to_dict())

# ---------- 3) Model frame ----------
df = dm.set_index("USUBJID").join(out).join(n_ongoing)
df["bcg"] = (df.TRTGRP == "BCG").astype(int)
df["ps_ord"] = df.patients_seen.map({"1-50": 0, "51-100": 1, ">100": 2})
df["exp_int"] = (df.expect_interact == "Yes").astype(int)
df["age_mid"] = df.Age.map({"10-19": 15, "20-29": 25, "30-39": 35, "40-49": 45,
                            "50-59": 55, "60-69": 65, "70-79": 75})
df["female"] = (df.SEX == 2).astype(int)
COVS = ["n_ongoing", "bcg", "ps_ord", "exp_int"]

def fit_ordered(frame, ycol, extra, label, collapse=False):
    keep = COVS + extra + [ycol]
    d, y = frame[keep].copy(), frame[ycol].astype(float).copy()
    if collapse:
        y = y.clip(upper=3)          # collapse 3-4 into one 'severe' level
    ok = y.notna() & d.drop(columns=[ycol]).notna().all(axis=1)
    d, y = d.loc[ok, COVS + extra], y[ok].astype(int)
    r = OrderedModel(y, d, distr="logit").fit(method="bfgs", disp=False)
    b = r.params["n_ongoing"]
    ci = r.conf_int().loc["n_ongoing"]
    pct, lo, hi = (np.exp([b, ci[0], ci[1]]) - 1) * 100
    print(f"\n=== {label} ===  n={len(y)}, outcome levels={sorted(set(y))}")
    print(r.summary(title=label))
    print(f">>> n_ongoing: beta={b:.4f}  OR={np.exp(b):.4f}  "
          f"odds increase = {pct:.1f}%  (95% CI {lo:.1f}% to {hi:.1f}%)  "
          f"p={r.pvalues['n_ongoing']:.3g}")
    return pct, lo, hi, r, len(y)

res = {}
res["primary"] = fit_ordered(df.dropna(subset=["y_rti"]), "y_rti", [],
    "PRIMARY: RTI-max AESEV 0-4, unknown-severity subjects excluded")
res["primary_collapse"] = fit_ordered(df.dropna(subset=["y_rti"]), "y_rti", [],
    "Sensitivity: PRIMARY collapsed (0-4 -> 0,1,2,severe=3)", collapse=True)
res["imputed"] = fit_ordered(df.dropna(subset=["y_rti_imputed"]), "y_rti_imputed", [],
    "Sensitivity: unknown AESEV imputed (AESER='Yes'->3 else 1)")
res["covid_only"] = fit_ordered(df, "y_covid", [],
    "Sensitivity: COVID-19-AE-only outcome (0-4)")
res["covid_collapse"] = fit_ordered(df, "y_covid", [],
    "Sensitivity: COVID-only collapsed (0,1,2,severe=3)", collapse=True)
res["age_sex"] = fit_ordered(df.dropna(subset=["y_rti"]), "y_rti", ["age_mid", "female"],
    "Sensitivity: PRIMARY + age (band midpoint) and sex")

# ---------- 4) Proportional-odds diagnostic ----------
print("\n=== PO diagnostic: cut-specific binary logits (primary sample) ===")
d = df.loc[df.y_rti.notna(), COVS]
y = df.y_rti.dropna().astype(int)
for c in [0, 1, 2, 3]:
    yy = (y > c).astype(int)
    if yy.nunique() < 2:
        print(f"  cut {c}: degenerate (single class)"); continue
    m = smapi.Logit(yy, smapi.add_constant(d[COVS])).fit(disp=False)
    print(f"  cut {c} (>{c}): beta_n_ongoing={m.params['n_ongoing']:+.4f} "
          f"OR={np.exp(m.params['n_ongoing']):.3f} p={m.pvalues['n_ongoing']:.3f}")

print("\n=== SUMMARY: odds increase per additional ongoing condition ===")
for k, v in res.items():
    print(f"{k:18s}: {v[0]:6.1f}%  (95% CI {v[1]:.1f}% to {v[2]:.1f}%), n={v[4]}")
