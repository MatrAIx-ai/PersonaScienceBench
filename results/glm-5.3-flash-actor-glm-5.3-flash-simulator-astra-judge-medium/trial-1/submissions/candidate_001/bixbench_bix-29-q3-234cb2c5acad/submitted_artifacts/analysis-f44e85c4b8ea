"""
BixBench bix-29-q3: Interaction effect of BCG vaccination status x prior medical history
on COVID-19 severity, from a proportional-odds ordinal logistic regression controlling
for patient interaction frequency (DM.patients_seen).

Design decisions (approved):
- Outcome: subject-level max AESEV among COVID-related AEs (AEPT matching COVID|SARS),
  ordered 1<2<3<4 (ordering supported by AEOUT/AESER/AEDEATH patterns).
- Primary design (a): only subjects with >=1 COVID-related AE and non-missing severity.
- prior_history: any MHORRES==2 among the 17 chronic-condition checklist terms
  (excluding 'Current respiratory tract infection') or a free-text 'Other:<condition>' row.
- patients_seen coded 1-50->1, 51-100->2, >100->3.
- Estimator: statsmodels OrderedModel (logit link, proportional odds).
- Sensitivities: (b) add 806 no-COVID subjects as bottom level 0; (ii) expect_interact
  replaces patients_seen. Proportional-odds check via per-cutpoint binary logits.
"""
import numpy as np
import pandas as pd
import statsmodels.api as sm
from scipy.stats import norm
from statsmodels.miscmodels.ordinal_model import OrderedModel
import warnings

rng_seed = 20240117

dm = pd.read_csv('data/TASK008_BCG-CORONA_DM.csv')
ae = pd.read_csv('data/TASK008_BCG-CORONA_AE.csv', low_memory=False)
mh = pd.read_csv('data/TASK008_BCG-CORONA_MH.csv', low_memory=False)

# ---------------- subject-level covariates ----------------
cov = dm[['USUBJID', 'TRTGRP', 'patients_seen', 'expect_interact']].copy()
cov['BCG'] = (cov['TRTGRP'] == 'BCG').astype(int)
cov['patients_seen_n'] = cov['patients_seen'].map({'1-50': 1, '51-100': 2, '>100': 3})
cov['expect_interact_n'] = (cov['expect_interact'] == 'Yes').astype(int)

# prior medical history: chronic checklist terms (exclude current RTI) + free-text Other
CHECKLIST = ['Tuberculosis', 'Hypertension', 'Diabetes Mellitus',
             'Chronic Obstructive Pulmonary Disease', 'Other lung disease', 'Asthma',
             'Cardiovascular disease', 'Cerebrovascular disease', 'Kidney disease',
             'Liver disease', 'Cancer', 'Organ or bone marrow transplantation',
             'Primary immunodeficiency', 'Neutropenia or lymphopenia', 'Allergy',
             'Hay fever', 'chronic sinusitis']
sub = mh[mh.MHSCAT == 'MEDICAL HISTORY']
hist_rows = sub[(sub.MHTERM.isin(CHECKLIST)) |
                (sub.MHTERM.astype(str).str.startswith('Other') & (sub.MHTERM != 'Other lung disease'))]
n_yes = hist_rows.assign(y=(hist_rows.MHORRES == 2)).groupby('USUBJID').y.sum()
hist_flag = pd.DataFrame({'prior_history': (n_yes > 0).astype(int)}).reset_index()
hist_flag['n_conditions'] = n_yes.values
cov = cov.merge(hist_flag, on='USUBJID', how='left')
cov['prior_history'] = cov['prior_history'].fillna(0).astype(int)
print('prior_history prevalence:', cov.prior_history.mean().round(3),
      '| mean #conditions:', cov.n_conditions.mean().round(2))

# COVID severity outcome
covid = ae[ae.AEPT.astype(str).str.contains('COVID|SARS', case=False, na=False)].copy()
sev = covid.groupby('USUBJID').AESEV.max().rename('severity')
df = cov.merge(sev, on='USUBJID', how='left')

# ---------------- cell counts ----------------
df['hist'] = df.prior_history
print('\n--- Cell counts: BCG x prior_history (all subjects) ---')
print(pd.crosstab(df.TRTGRP, df.prior_history))
a = df[df.severity.notna()].copy()
print('\n--- Design (a) cell counts: BCG x prior_history x severity ---')
print(pd.crosstab([a.TRTGRP, a.prior_history], a.severity))
print('Design (a) N =', len(a))

# ---------------- model fitting ----------------
def fit_ordered(dat, formula_cols, outcome, label):
    d = dat.dropna(subset=formula_cols + [outcome]).copy()
    y = d[outcome].astype(int)
    X = d[formula_cols].astype(float)
    X['BCG_x_hist'] = X['BCG'] * X['prior_history']
    with warnings.catch_warnings():
        warnings.simplefilter('ignore')
        mod = OrderedModel(y, X, distr='logit')
        res = mod.fit(method='bfgs', disp=False)
    print(f'\n===== {label} (N={len(d)}, levels={sorted(y.unique())}) =====')
    tbl = pd.DataFrame({'coef': res.params, 'SE': res.bse,
                        'z': res.params / res.bse,
                        'p': 2 * norm.sf(abs(res.params / res.bse))})
    tbl['OR'] = np.exp(tbl['coef'])
    tbl['OR_lo'] = np.exp(tbl['coef'] - 1.96 * tbl['SE'])
    tbl['OR_hi'] = np.exp(tbl['coef'] + 1.96 * tbl['SE'])
    print(tbl.round(4).to_string())
    return res, tbl

cols_primary = ['BCG', 'prior_history', 'patients_seen_n']
res_a, tbl_a = fit_ordered(a, cols_primary, 'severity',
                           'PRIMARY design (a): max COVID AESEV 1-4, patients_seen control')
ia = tbl_a.loc['BCG_x_hist']
print(f"\n>> PRIMARY interaction OR = {ia['OR']:.3f} "
      f"(95% CI {ia['OR_lo']:.3f}-{ia['OR_hi']:.3f}), Wald p = {ia['p']:.4f}")

# sensitivity (b): add no-COVID subjects as level 0; COVID subjects with all-NaN
# severity are dropped (NOT mapped to 0, which would misclassify them as no-COVID)
covid_subj = set(covid.USUBJID)
b = df.copy()
drop = [u for u in b.USUBJID if u in covid_subj and pd.isna(b.loc[b.USUBJID == u, 'severity'].iloc[0])]
b = b[~b.USUBJID.isin(drop)].copy()
b['severity_b'] = b.severity.fillna(0).astype(int)
print(f'Sensitivity (b): dropped {len(drop)} COVID subjects with missing severity')
res_b, tbl_b = fit_ordered(b, cols_primary, 'severity_b',
                           'SENSITIVITY (b): 0=no COVID added as bottom level, COVID-missing-severity dropped')
ib = tbl_b.loc['BCG_x_hist']
print(f">> Sensitivity (b) interaction OR = {ib['OR']:.3f} (95% CI {ib['OR_lo']:.3f}-{ib['OR_hi']:.3f}), p = {ib['p']:.4f}")

# sensitivity (ii): expect_interact instead of patients_seen
res_c, tbl_c = fit_ordered(a, ['BCG', 'prior_history', 'expect_interact_n'], 'severity',
                           'SENSITIVITY (ii): expect_interact control (design a)')
ic = tbl_c.loc['BCG_x_hist']
print(f">> Sensitivity (ii) interaction OR = {ic['OR']:.3f} (95% CI {ic['OR_lo']:.3f}-{ic['OR_hi']:.3f}), p = {ic['p']:.4f}")

# ---------------- proportional-odds check: per-cutpoint binary logits ----------------
print('\n--- Proportional-odds check: separate binary logits per cutpoint (design a) ---')
for k in sorted(a.severity.unique())[:-1]:
    d = a.copy(); d['y_bin'] = (d.severity > k).astype(int)
    X = sm.add_constant(d[['BCG', 'prior_history', 'patients_seen_n']].astype(float))
    X['BCG_x_hist'] = d.BCG * d.prior_history
    m = sm.Logit(d.y_bin, X).fit(disp=False)
    orint = np.exp(m.params['BCG_x_hist'])
    print(f"cutpoint severity>{k}: interaction coef={m.params['BCG_x_hist']:+.3f}, "
          f"OR={orint:.3f}, p={m.pvalues['BCG_x_hist']:.4f}, N={int(m.nobs)}")

# thin-cell caution
cell = a.groupby(['TRTGRP', 'prior_history']).size()
print('\nCell sizes (design a):'); print(cell.to_string())
print('Severity distribution within thinnest BCG cells:')
print(pd.crosstab([a.TRTGRP, a.prior_history], a.severity).to_string())
