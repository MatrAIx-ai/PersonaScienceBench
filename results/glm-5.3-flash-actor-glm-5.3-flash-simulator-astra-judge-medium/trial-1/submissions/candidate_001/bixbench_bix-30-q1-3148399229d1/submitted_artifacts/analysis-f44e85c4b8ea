"""Differential expression of 175 serum miRNAs: DM1 patients vs controls (Table S1, pone.0150501.s002.xls).

Primary question: percentage of miRNAs with p < 0.05 BEFORE multiple-testing correction.
Primary test: two-sided Welch t-test on Ct values, pairwise deletion of 'NAN' cells,
minimum 3 valid values per group. Denominator = all 175 features (no filtering).
Secondary (NOT the asked answer): (a) global-mean-normalized sensitivity percentage,
(b) count with BH-FDR < 0.05. Also flags 'NAN'-affected miRNAs crossing p < 0.05.
"""
import importlib.util, csv, math
from scipy import stats

spec = importlib.util.spec_from_file_location('xls_reader', 'work/xls_reader.py')
xl = importlib.util.module_from_spec(spec); spec.loader.exec_module(xl)

# ---------- 1. Parse workbook ----------
streams = xl.read_cfb('data/pone.0150501.s002.xls')
sheets, cells = xl.parse_biff(streams['Workbook'])
assert sheets == ['AW DATA'], sheets
c = cells[0]
title = c[(0, 0)].strip()
header = [c.get((1, cc)) for cc in range(21)]
samples = header[1:]
group = ['patient' if s.startswith('P_') else 'control' for s in samples]
n_pat = group.count('patient'); n_ctl = group.count('control')
assert (n_pat, n_ctl) == (10, 10), (n_pat, n_ctl)

rows = []
for r in range(2, 177):
    mir = c[(r, 0)].strip()
    p_vals, c_vals, n_nan = [], [], 0
    for cc in range(1, 21):
        v = c.get((r, cc))
        if isinstance(v, str) and v.strip().upper() == 'NAN':
            n_nan += 1
            continue
        (p_vals if group[cc - 1] == 'patient' else c_vals).append(float(v))
    rows.append(dict(mir=mir, p=p_vals, c=c_vals, n_nan=n_nan))
assert len(rows) == 175 and all(len(x['p']) + len(x['c']) + x['n_nan'] == 20 for x in rows)
print(f'Title: {title}')
print(f'Samples: {n_pat} patient (P_*), {n_ctl} control (C_*); features: {len(rows)}')
print(f"NAN cells total: {sum(x['n_nan'] for x in rows)} across {sum(1 for x in rows if x['n_nan'])} miRNAs")

# ---------- 2. Welch t-test on raw Ct (primary) ----------
def bh(pvals):
    n = len(pvals); order = sorted(range(n), key=lambda i: pvals[i])
    q = [0.0] * n; prev = 1.0
    for rank in range(n - 1, -1, -1):
        i = order[rank]
        val = pvals[i] * n / (rank + 1)
        prev = min(prev, val); q[i] = prev
    return q

res = []
for x in rows:
    t, p = stats.ttest_ind(x['p'], x['c'], equal_var=False)
    mean_p = sum(x['p']) / len(x['p'])
    mean_c = sum(x['c']) / len(x['c'])
    res.append(dict(mir=x['mir'],
                    mean_p=mean_p, mean_c=mean_c,
                    n_p=len(x['p']), n_c=len(x['c']), n_nan=x['n_nan'],
                    t=t, p=p, log2fc=mean_c - mean_p))  # log2FC>0 -> higher in patients (lower Ct)
qs = bh([r['p'] for r in res])
for r, q in zip(res, qs): r['q'] = q

# ---------- 3. Secondary: global-mean-normalized sensitivity ----------
gm = []  # per-sample global mean Ct
for cc in range(1, 21):
    vals = [c[(r, cc)] for r in range(2, 177) if isinstance(c.get((r, cc)), (int, float))]
    gm.append(sum(vals) / len(vals))
res2 = []
for i, x in enumerate(rows):
    pv = [float(c[(r0, cc)]) - gm[cc - 1]
          for r0 in [2 + i] for cc in range(1, 21)
          if isinstance(c.get((r0, cc)), (int, float)) and group[cc - 1] == 'patient']
    cv = [float(c[(r0, cc)]) - gm[cc - 1]
          for r0 in [2 + i] for cc in range(1, 21)
          if isinstance(c.get((r0, cc)), (int, float)) and group[cc - 1] == 'control']
    t, p = stats.ttest_ind(pv, cv, equal_var=False)
    res2.append(dict(mir=x['mir'], p=p))

# ---------- 4. Headline + secondary metrics ----------
n_sig = sum(1 for r in res if r['p'] < 0.05)
pct = 100.0 * n_sig / len(res)
n_fdr = sum(1 for r in res if r['q'] < 0.05)
n_sig2 = sum(1 for r in res2 if r['p'] < 0.05)
pct2 = 100.0 * n_sig2 / len(res2)
nan_set = {r['mir'] for r in res if r['n_nan'] > 0}
nan_sig = [(r['mir'], r['n_nan'], r['p']) for r in res if r['mir'] in nan_set and r['p'] < 0.05]

print('\n================ PRIMARY RESULT (asked answer) ================')
print(f'miRNAs with Welch t-test p < 0.05: {n_sig} / {len(res)} = {pct:.2f}% (before multiple-testing correction)')

print('\n--- Secondary, NOT the asked answer ---')
print(f'(a) Global-mean-normalized sensitivity: {n_sig2} / {len(res2)} = {pct2:.2f}% at p < 0.05')
print(f'(b) miRNAs with BH-FDR q < 0.05: {n_fdr}')
print(f"(c) 'NAN'-affected miRNAs (14) crossing p < 0.05: {len(nan_sig)}")
for mir, nn, p in nan_sig:
    print(f'      {mir} (NAN cells: {nn}, p = {p:.2e})')

# ---------- 5. Full results table ----------
with open('work/de_results.tsv', 'w', newline='') as f:
    w = csv.writer(f, delimiter='\t')
    w.writerow(['miRNA', 'mean_Ct_patient', 'mean_Ct_control', 'n_patient', 'n_control',
                'n_NAN_cells', 'log2FC_pat_vs_ctl_Ct', 'welch_t', 'p_value',
                'BH_q_value', 'p_lt_0.05', 'q_lt_0.05', 'p_global_mean_norm'])
    w.writerow(['#NOTE', 'lower Ct = higher expression', '', '', '', '', '', '', '', '', '', '', ''])
    for r, r2 in zip(res, res2):
        w.writerow([r['mir'], f"{r['mean_p']:.4f}", f"{r['mean_c']:.4f}", r['n_p'], r['n_c'],
                    r['n_nan'], f"{r['log2fc']:.4f}", f"{r['t']:.4f}", f"{r['p']:.6g}",
                    f"{r['q']:.6g}", int(r['p'] < 0.05), int(r['q'] < 0.05), f"{r2['p']:.6g}"])
print('\nFull table written to work/de_results.tsv (177 lines)')

print('\nTop 15 most significant miRNAs (raw Ct, Welch):')
for r in sorted(res, key=lambda r: r['p'])[:15]:
    print(f"  {r['mir']:<16} log2FC_Ct={r['log2fc']:+.3f}  p={r['p']:.3e}  q={r['q']:.3e}"
          f"  n={r['n_p']}/{r['n_c']}  NAN={r['n_nan']}")

# consistency check between both methods
sig1 = {r['mir'] for r in res if r['p'] < 0.05}
sig2 = {r['mir'] for r in res2 if r['p'] < 0.05}
print(f'\nOverlap of p<0.05 sets (raw vs normalized): {len(sig1 & sig2)} shared, '
      f'{len(sig1 - sig2)} only raw, {len(sig2 - sig1)} only normalized')
