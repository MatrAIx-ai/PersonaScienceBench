"""Minimal OLE2 (CFB) + BIFF8 reader sufficient for inspection of a small .xls file."""
import struct, sys

def read_cfb(path):
    data = open(path,'rb').read()
    assert data[:8] == b'\xd0\xcf\x11\xe0\xa1\xb1\x1a\xe1', 'not OLE2'
    sector_size = 1 << struct.unpack('<H', data[30:32])[0]
    mini_cutoff = struct.unpack('<I', data[56:60])[0]
    num_fat = struct.unpack('<I', data[44:48])[0]
    dir_start = struct.unpack('<I', data[48:52])[0]
    mini_cutoff = struct.unpack('<I', data[56:60])[0]
    mini_fat_start = struct.unpack('<I', data[60:64])[0]

    def sectors(start, size=None):
        out, s, n = [], start, 0
        while s not in (0xFFFFFFFE, 0xFFFFFFFF) and s < len(data)//sector_size + 1:
            out.append(s); s = fat[s]; n += 1
            if size and n >= (size + sector_size - 1)//sector_size: break
        return out

    # header DIFAT: up to 109 entries; if num_fat>109 the 109th points to DIFAT sectors
    difat = [struct.unpack('<I', data[0x4C+4*i : 0x50+4*i])[0] for i in range(min(109, num_fat))]
    fat_secs = [s for s in difat[:108] if s < 0xFFFFFFFA]
    nxt = difat[108] if num_fat > 109 else 0xFFFFFFFF
    while nxt < 0xFFFFFFFA:
        blk = data[512+nxt*sector_size : 512+(nxt+1)*sector_size]
        ents = list(struct.unpack('<%dI' % (sector_size//4), blk))
        fat_secs += [s for s in ents[:-1] if s < 0xFFFFFFFA]
        nxt = ents[-1]
    fat = []
    for fs in fat_secs:
        off = 512 + fs*sector_size
        fat += list(struct.unpack('<%dI' % (sector_size//4), data[off:off+sector_size]))

    def read_chain(start, maxlen=None):
        b = b''.join(data[512+s*sector_size : 512+(s+1)*sector_size] for s in sectors(start, maxlen))
        return b[:maxlen] if maxlen else b

    # directory entries
    dirdata = read_chain(dir_start)
    entries = []
    for i in range(len(dirdata)//128):
        e = dirdata[i*128:(i+1)*128]
        nlen = struct.unpack('<H', e[64:66])[0]
        name = e[:max(0,nlen-2)].decode('utf-16-le', 'ignore')
        etype = e[66]; start = struct.unpack('<I', e[116:120])[0]
        size = struct.unpack('<I', e[120:124])[0]
        entries.append((name, etype, start, size))

    streams = {}
    minifat_raw = read_chain(mini_fat_start)
    minifat = list(struct.unpack('<%dI' % (len(minifat_raw)//4), minifat_raw)) if minifat_raw else []
    root = [e for e in entries if e[1]==5][0]
    ministream = read_chain(root[2]) if root[2] not in (0xFFFFFFFE,0xFFFFFFFF) else b''

    def read_stream(name, etype, start, size):
        if size < mini_cutoff and etype != 5:
            chain, s = [], start
            while s not in (0xFFFFFFFE,0xFFFFFFFF):
                chain.append(s); s = minifat[s]
            b = b''.join(ministream[s*64:(s+1)*64] for s in chain)
            return b[:size]
        return read_chain(start, size)

    for name, etype, start, size in entries:
        if etype in (1,5) or not name: continue
        streams[name] = read_stream(name, etype, start, size)
    return streams

def parse_biff(workbook):
    pos, sst, sheets, cells = 0, [], [], {}   # cells: (sheetidx) -> {(r,c): value}
    cur = None
    codepage = 'cp1252'
    while pos < len(workbook) - 4:
        rec, ln = struct.unpack('<HH', workbook[pos:pos+4])
        body = workbook[pos+4:pos+4+ln]; pos += 4+ln
        if rec == 0x0085:  # BOUNDSHEET
            lb = struct.unpack('<I', body[:4])[0] & 0xFF  # grbit low bits: visibility; type at byte 5
            stype = body[5]
            if stype == 0:  # worksheet
                name = xlstr(body[6:], 'latin1', compressed_only=True)
                sheets.append(name)
        elif rec == 0x0042:  # CODEPAGE
            codepage = 'cp%d' % struct.unpack('<H', body[:2])[0]
        elif rec == 0x00FC:  # SST
            total, unique = struct.unpack('<II', body[:8])
            p = 8
            for _ in range(unique):
                n = struct.unpack('<H', body[p:p+2])[0]; p += 2
                flags = body[p]; p += 1
                s, text = p, ''
                if flags & 0x01:  # unicode
                    raw = body[p:p+2*n]; text = raw.decode('utf-16-le','ignore'); p += 2*n
                    p += 0
                else:
                    text = body[p:p+n].decode('latin1','ignore'); p += n
                # skip rich/farEast continuation runs (grbit bits 2,3)
                if flags & 0x08: p += 4
                if flags & 0x04: p += 2
                # continuation records
                while p < len(body) and body[p:p+1] and False: pass
                sst.append(text)
            # NOTE: continuation (0x3C) records may follow; handled crudely below
        elif rec == 0x003C:  # CONT after SST
            pass
        elif rec == 0x00FD:  # LABELSST
            r, c, _, sidx = struct.unpack('<HHHI', body[:10])
            cells.setdefault(cur, {})[(r,c)] = sst[sidx] if sidx < len(sst) else None
        elif rec == 0x0203:  # NUMBER
            r, c = struct.unpack('<HH', body[:4])
            cells.setdefault(cur, {})[(r,c)] = struct.unpack('<d', body[6:14])[0]
        elif rec == 0x027E:  # RK
            r, c, rk = struct.unpack('<HHi', body[:8])
            cells.setdefault(cur, {})[(r,c)] = rk_value(rk)
        elif rec == 0x00BD:  # MULRK
            r, fc = struct.unpack('<HH', body[:4])
            n = (len(body)-6)//6
            for i in range(n):
                rk = struct.unpack('<i', body[4+6*i:8+6*i])[0]
                cells.setdefault(cur, {})[(r, fc+i)] = rk_value(rk)
        elif rec == 0x0204:  # LABEL (non-sst)
            r, c = struct.unpack('<HH', body[:4])
            cells.setdefault(cur, {})[(r,c)] = xlstr(body[6:], codepage)
        elif rec == 0x0006:  # FORMULA
            r, c = struct.unpack('<HH', body[:4])
            v = struct.unpack('<d', body[6:14])[0]
            if body[12:14] == b'\xff\xff':  # special value
                v = None
            cells.setdefault(cur, {})[(r,c)] = v
        elif rec == 0x0809:  # BOF
            if body[4:6] in (b'\x10\x00', b'\x00\x01', b'\x20\x04'):  # worksheet BOF subtypes
                pass
            cur = len(sheets)-1 if len(sheets) else cur
        elif rec == 0x000A:  # EOF
            pass
    return sheets, cells

def rk_value(rk):
    if rk & 0x02:
        v = float(rk >> 2)
    else:
        v = struct.unpack('<d', struct.pack('<I', rk & 0xFFFFFFFC) + b'\x00'*4)[0]
    if rk & 0x01: v /= 100
    return v

def xlstr(b, cp, compressed_only=False):
    if not b: return ''
    n = b[0]
    flags = b[1]
    if flags & 0x01:
        return b[3:3+2*n].decode('utf-16-le','ignore')
    return b[3:3+n].decode(cp,'ignore')

if __name__ == '__main__':
    streams = read_cfb(sys.argv[1])
    print('streams:', {k: len(v) for k,v in streams.items()})
    wb = streams.get('Workbook') or streams.get('Book')
    sheets, cells = parse_biff(wb)
    print('sheets:', sheets)
    for si, name in enumerate(sheets):
        c = cells.get(si, {})
        if not c: continue
        maxr = max(k[0] for k in c); maxc = max(k[1] for k in c)
        print(f'--- sheet {si} "{name}": {maxr+1} rows x {maxc+1} cols, {len(c)} populated cells')
        for r in range(min(6, maxr+1)):
            row = [repr(c.get((r,cc)))[:28] for cc in range(min(8, maxc+1))]
            print(' row', r, row)
        print(' last row:', [repr(c.get((maxr,cc)))[:28] for cc in range(min(8, maxc+1))])
