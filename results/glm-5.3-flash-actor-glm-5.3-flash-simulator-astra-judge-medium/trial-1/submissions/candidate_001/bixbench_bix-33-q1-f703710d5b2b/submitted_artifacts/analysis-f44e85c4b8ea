"""Formal analysis for BixBench bix-33-q1:
Which immune cell type has the highest number of significantly
differentially expressed genes after AAV9 mini-dystrophin treatment?

Source of truth: Supplemental Data File 1 (Post vs Pre DEG tables, one
sheet per cell type). Criterion (approved): p_val_adj < 0.05, no log2FC or
pct cutoff (primary); |avg_log2FC| > 0.25 reported as a sensitivity check.
"""
import openpyxl

XLSX = "data/Supplemental Data File 1 PostvsPre_DEG_tables_ANNOTATED by_cell_type.xlsx"
ALPHA = 0.05        # primary criterion: adjusted p-value threshold
FC_CUT = 0.25       # sensitivity check only

wb = openpyxl.load_workbook(XLSX, read_only=True)
rows_out = []
for sheet in wb.sheetnames:
    ws = wb[sheet]
    it = ws.iter_rows(values_only=True)
    hdr = next(it)
    assert list(hdr[1:]) == ["p_val", "avg_log2FC", "pct.1", "pct.2", "p_val_adj"], hdr
    genes, n_sig, n_sig_fc, n_up, n_down = [], 0, 0, 0, 0
    for r in it:
        if r[0] is None:
            continue
        gene = str(r[0]); genes.append(gene)
        padj, lfc = r[5], r[2]
        if isinstance(padj, (int, float)) and padj < ALPHA:
            n_sig += 1
            if lfc > 0: n_up += 1
            elif lfc < 0: n_down += 1
            if isinstance(lfc, (int, float)) and abs(lfc) > FC_CUT:
                n_sig_fc += 1
    assert len(genes) == len(set(genes)), f"duplicate genes in {sheet}"
    rows_out.append((sheet, len(genes), n_sig, n_sig_fc, n_up, n_down))

print(f"Criterion: p_val_adj < {ALPHA} (primary); sensitivity: |avg_log2FC| > {FC_CUT}")
print(f"{'cell_type':20s} {'total_rows':>10s} {'sig_adj<0.05':>12s} {'sig&|FC|>0.25':>13s} {'up':>6s} {'down':>6s}")
for sheet, n, s, sfc, up, dn in rows_out:
    print(f"{sheet:20s} {n:10d} {s:12d} {sfc:13d} {up:6d} {dn:6d}")

total_rows = sum(r[1] for r in rows_out)
total_sig = sum(r[2] for r in rows_out)
print(f"TOTAL rows {total_rows}; TOTAL significant (adj<0.05) {total_sig}")

ranked = sorted(rows_out, key=lambda r: -r[2])
print("\nRanked top 5 by significant DEG count (adj<0.05):")
for i, (sheet, n, s, sfc, up, dn) in enumerate(ranked[:5], 1):
    print(f"{i}. {sheet}: {s} significant DEGs ({n} tabulated rows); {up} up / {dn} down; sensitivity |FC|>0.25: {sfc}")

winner = ranked[0]
runner_up = ranked[1]
assert winner[2] > runner_up[2], "tie for first place!"
print(f"\nFINAL ANSWER: {winner[0]} — highest number of significant DEGs "
      f"({winner[2]} of {winner[1]} tabulated genes at p_val_adj < {ALPHA}; "
      f"{winner[2]} also pass |avg_log2FC|>{FC_CUT}). Runner-up: {runner_up[0]} ({runner_up[2]}).")

# sanity check: sensitivity check never changes the ranking
same = all(r[2] == r[3] for r in rows_out)
print(f"Sensitivity check identical to primary counts for all cell types: {same}")
