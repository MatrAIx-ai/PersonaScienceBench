"""BixBench bix-37-q2: Base protein level of ENO1 in normal samples.

Reads the proteomic data sheet 'Tumor vs Normal', locates the unique ENO1 row,
reports the exact 'Normal' value, rounds to 3 significant figures, and
cross-checks against the file's own Ratio/FC/log2FC columns.
"""
import math
import pandas as pd

SRC = "data/Proteomic_data .xlsx"
SHEET = "Tumor vs Normal"

df = pd.read_excel(SRC, sheet_name=SHEET)
print(f"Sheet '{SHEET}': {df.shape[0]} proteins x {df.shape[1]} columns")

# --- 1) Locate ENO1 (unique row) ---
eno1 = df[df["gene"].astype(str).str.upper() == "ENO1"]
assert len(eno1) == 1, f"Expected exactly one ENO1 row, got {len(eno1)}"
row = eno1.iloc[0]
assert row["protein"] == "P06733" and int(row["gene_id"]) == 2023
print("\nENO1 row:")
print(eno1[["protein", "Description", "gene", "gene_id", "Normal", "Tumor",
            "Ratio", "FC", "log2FC", "p.value", "adj.Pval"]].to_string(index=False))

# --- 2) Exact Normal value and 3-significant-figure rounding ---
normal_val = float(row["Normal"])
print(f"\nExact Normal value        : {normal_val!r}")


def round_sig(x: float, sig: int = 3) -> float:
    return round(x, -int(math.floor(math.log10(abs(x)))) + (sig - 1))


rounded = round_sig(normal_val, 3)
print(f"Rounded to 3 sig figures  : {rounded:.3g}  (= {rounded:.2e})")

# --- 3) Verification cross-checks against the file's own statistics ---
tumor_val = float(row["Tumor"])
ratio_check = tumor_val / normal_val
log2fc_check = math.log2(ratio_check)
print(f"\nCross-checks:")
print(f"  Tumor/Normal computed = {ratio_check:.6f}  (file Ratio = {row['Ratio']}, FC = {row['FC']})")
print(f"  log2(Tumor/Normal)    = {log2fc_check:.4f} (file log2FC = {row['log2FC']})")
assert abs(ratio_check - float(row["Ratio"])) < 0.01
assert abs(log2fc_check - float(row["log2FC"])) < 0.01
print("  -> Internal consistency confirmed; row and Normal-column interpretation verified.")

# Neighboring enolase genes present but excluded (separate genes)
print("\nRelated enolase rows (for completeness, excluded from answer):")
print(df[df["Description"].str.contains("enolase", case=False, na=False)]
      [["protein", "gene", "Normal", "Tumor"]].to_string(index=False))

print(f"\nFINAL ANSWER: {rounded:.2e} (3 s.f.); exact value {normal_val}")
