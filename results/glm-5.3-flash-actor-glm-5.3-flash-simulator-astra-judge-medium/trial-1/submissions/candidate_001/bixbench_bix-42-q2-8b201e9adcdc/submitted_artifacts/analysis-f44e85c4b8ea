# BixBench bix-42-q2: Skewness of the RNA expression (COAD geneExp) distribution.
# Primary: pooled matrix, raw (linear) scale. Sensitivity: log2(x+1), per-sample, tumor-only.
# Visual evidence: quantile table + ASCII histogram (matplotlib unavailable in env).
import numpy as np, pandas as pd, scipy.stats as st

ge = pd.read_csv('data/COAD__geneExp.xls', sep='\t', index_col=0)
v = ge.values.astype(float)
print("Matrix: %d genes x %d samples; NaNs=%d; zeros=%d (%.1f%%); negatives=%d"
      % (ge.shape[0], ge.shape[1], np.isnan(v).sum(), (v==0).sum(),
         100*(v==0).mean(), (v<0).sum()))

def ascii_hist(vals, label, xmax=None, bins=24, width=60):
    if xmax is None: xmax = np.percentile(vals, 99.5)
    h, edges = np.histogram(np.clip(vals, 0, xmax), bins=bins, range=(0, xmax))
    bar = (h/h.max()*width).astype(int)
    print("\nASCII histogram [%s], range 0..%.0f:" % (label, xmax))
    for i in range(bins):
        print("  %9.0f-%-9.0f |%s %d" % (edges[i], edges[i+1], '#'*bar[i], h[i]))
    print("  (values above %.0f truncated for display)" % xmax)

def report(vals, label):
    vals = np.asarray(vals, float); vals = vals[np.isfinite(vals)]
    g1 = st.skew(vals, bias=False)
    p2 = 3*(vals.mean()-np.median(vals))/vals.std(ddof=1)
    q = np.percentile(vals, [0,25,50,75,90,95,99,100])
    print("\n== %s (n=%d) ==" % (label, vals.size))
    print("g1 (adjusted Fisher-Pearson moment skewness): %.3f" % g1)
    print("Pearson 2nd coefficient 3(mean-median)/sd   : %.3f" % p2)
    print("mean=%.2f  median=%.2f  sd=%.2f" % (vals.mean(), np.median(vals), vals.std(ddof=1)))
    print("quantile table min/Q1/median/Q3/P90/P95/P99/max: %s" % np.round(q,2).tolist())
    print("mean >> median (mean/median ratio = %.1f) with Q3-Q2 span > Q2-Q1: right tail dominant"
          % (vals.mean()/np.median(vals)))
    return g1, p2, q

vals = v.ravel()
g1, p2, _ = report(vals, "POOLED all values (raw scale) - PRIMARY")
ascii_hist(vals, "raw")

lv = np.log2(vals+1.0)
g1l, p2l, _ = report(lv, "SENSITIVITY: pooled log2(x+1)")
ascii_hist(lv, "log2(x+1)")

tumor = [c for c in ge.columns if '-01A-' in c or '-01B-' in c]
print("\nTumor samples (01A/01B): %d of %d" % (len(tumor), ge.shape[1]))
report(v[:, [ge.columns.get_loc(c) for c in tumor]].ravel(), "ROBUSTNESS: tumor-only pooled (raw)")

ssk = st.skew(v, axis=0, nan_policy='omit', bias=False)
print("\nPer-sample raw skew: median %.2f, IQR %.2f-%.2f, min %.2f, max %.2f; all>0.5: %s"
      % (np.median(ssk), np.percentile(ssk,25), np.percentile(ssk,75), ssk.min(), ssk.max(),
         bool((ssk>0.5).all())))

print("\nCONCLUSION: The RNA expression distribution is HIGHLY RIGHT-SKEWED "
      "(pooled g1=%.1f; Pearson-2nd=%.2f; mean %.0f >> median %.0f; extreme right tail to %.0f). "
      "After log2(x+1) it becomes ~symmetric/slightly left (g1=%.2f) - sensitivity only."
      % (g1, p2, vals.mean(), np.median(vals), vals.max(), g1l))
