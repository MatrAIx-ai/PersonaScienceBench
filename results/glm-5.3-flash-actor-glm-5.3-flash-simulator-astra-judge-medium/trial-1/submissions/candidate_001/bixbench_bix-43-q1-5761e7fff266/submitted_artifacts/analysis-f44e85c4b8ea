"""BixBench bix-43-q1: DE analysis stage (CBD+cisplatin Group 9 vs DMSO Group 3).
Enrichment stage intentionally NOT executed: gseapy / Enrichr unreachable (see log)."""
import numpy as np, pandas as pd
import statsmodels.api as sm
from statsmodels.stats.multitest import multipletests

LOG = []
def log(msg):
    print(msg); LOG.append(msg)

# ---------------- 1. Load inputs ----------------
counts = pd.read_csv('data/counts_raw_unfiltered.csv', index_col=0)
layout = pd.read_csv('data/sample_layout.csv')
log(f"counts loaded: {counts.shape[0]} genes x {counts.shape[1]} samples")

col2sid = {c: c.replace('_', '-') for c in counts.columns}
assert all(col2sid[c] in set(layout.SampleID) for c in counts.columns)
layout = layout.set_index('SampleID').loc[[col2sid[c] for c in counts.columns]]
assert (layout.Group.values[:3]=='Untreated').all() and (layout.Group.values[6:9]=='DMSO').all()
assert (layout.Group.values[24:27]=='Cisplatin_IC50_CBD_IC50').all()

combo_cols = [c for c in counts.columns if layout.loc[col2sid[c],'Group']=='Cisplatin_IC50_CBD_IC50']  # Group 9
dmso_cols  = [c for c in counts.columns if layout.loc[col2sid[c],'Group']=='DMSO']                     # Group 3
log(f"Group 9 (CBD+cisplatin) columns: {combo_cols}; Group 3 (DMSO) columns: {dmso_cols}")

# ---------------- 2. Preprocessing ----------------
n0 = counts.shape[0]
counts = counts.loc[counts.sum(axis=1) > 0]           # drop all-zero rows
n1 = counts.shape[0]
log(f"drop all-zero rows: {n0} -> {n1}")

m = pd.read_csv('data/ensg_to_gene_name.tsv', sep='\t').drop_duplicates('ENSG')
mapped = counts.index.map(m.set_index('ENSG').gene_name)
n_unmapped = int(pd.isna(mapped).sum())
log(f"ENSGs absent from ensg_to_gene_name.tsv (dropped): {n_unmapped}")
keep = ~pd.isna(mapped)
counts = counts[keep]; mapped = mapped[keep]
counts.index = mapped
counts = counts.groupby(level=0).sum()                # sum-collapse
n2 = counts.shape[0]
log(f"after sum-collapse to gene names: {n2} genes")

lib = counts[combo_cols + dmso_cols].sum(axis=0)
cpm = counts[combo_cols + dmso_cols].div(lib, axis=1) * 1e6
mask = (cpm >= 1).sum(axis=1) >= 3
counts = counts.loc[mask]
n3 = counts.shape[0]
log(f"CPM>=1 in >=3 of 6 samples: {n2} -> {n3}")

# ---------------- 3. DESeq2-style median-of-ratios size factors (all 30 samples) ----------------
lr = np.log(counts.replace(0, np.nan))
geom = lr.mean(axis=1)                                 # geometric mean of nonzero log counts
sf = {c: float(np.exp((lr[c] - geom).dropna().median())) for c in counts.columns}
sf = pd.Series(sf); sf /= sf.mean()
log(f"size factors: min={sf.min():.3f} max={sf.max():.3f}")
norm = counts.div(sf, axis=1)

# ---------------- 4. NB GLM (Wald) per gene, Group 9 vs Group 3 ----------------
y = norm[combo_cols + dmso_cols].values
mean_, var_ = y.mean(axis=1), y.var(axis=1, ddof=1)
ok = mean_ > 0
alpha_mm = np.clip((var_[ok] - mean_[ok]) / mean_[ok]**2, 0, None)
alpha = float(np.median(alpha_mm))
log(f"dispersion (MoM alpha, median): {alpha:.4f}")

X = np.column_stack([np.ones(6), np.array([1.0]*3 + [0.0]*3)])
offset = np.log(sf[combo_cols + dmso_cols].values)
res = []
for gene in counts.index:
    yy = counts.loc[gene, combo_cols + dmso_cols].values.astype(float)
    if yy.sum() == 0:
        continue
    try:
        fit = sm.GLM(yy, X, family=sm.families.NegativeBinomial(alpha=alpha), offset=offset).fit()
        res.append((gene, fit.params[1]/np.log(2), fit.pvalues[1]))
    except Exception:
        pass
de = pd.DataFrame(res, columns=['gene','log2FC','pvalue']).set_index('gene')
de['padj'] = multipletests(de.pvalue, method='fdr_bh')[1]
de = de.sort_values('pvalue')
log(f"genes tested by NB GLM: {len(de)}")
sig = de[(de.padj < 0.05) & (de.log2FC.abs() >= 1)]
up, dn = sig[sig.log2FC > 0], sig[sig.log2FC < 0]
log(f"significant (padj<0.05 & |LFC|>=1): {len(sig)} ({len(up)} up, {len(dn)} down)")
log(f"padj<0.05 only: {(de.padj<0.05).sum()}; |LFC|>=1 only: {(de.log2FC.abs()>=1).sum()}")
log("top 10 by padj:\n" + de.head(10).to_string())

de.to_csv('results/de_group9_vs_group3.csv')
sig.to_csv('results/sig_genes_padj05_lfc1.csv')
de['rank'] = np.sign(de.log2FC) * -np.log10(de.pvalue.clip(lower=1e-300))
de[['rank']].to_csv('results/prerank_input.csv')
with open('results/analysis_log.txt','w') as f:
    f.write("\n".join(LOG) + "\nENRICHMENT STAGE NOT EXECUTED: gseapy/Enrichr unreachable in this environment.\n")
print("STAGE DONE — enrichment blocked pending gseapy/Enrichr availability")
