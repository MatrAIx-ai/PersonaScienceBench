"""
BixBench bix-46-q1 analysis:
log2 fold change of mexG in ΔrhlI (strain #97) vs wt (strain #1).

Environment has no R runtime and no pyreadr/rdata; the RDS files (R
serialization format v3, XDR big-endian, gzip-compressed) are parsed with a
minimal pure-Python parser (rds_parser.py) validated by fully consuming both
input files byte-for-byte and recovering coherent DESeq2 object structure.
"""
import csv
import numpy as np
import rds_parser as rp

DATA = '/workspace/data'
ANNOT = DATA + '/Pseudomonas_aeruginosa_UCBPP-PA14.csv'

def unwrap(x):
    while isinstance(x, tuple) and x[0] == 'ATTR':
        x = x[1]
    return x

def load_deseq_results(path):
    """Parse a DESeqResults RDS -> (gene rownames, column names, columns)."""
    obj, r, info = rp.load(path)
    assert info['consumed'] == info['total'], 'incomplete parse'
    assert isinstance(obj, tuple) and obj[0] == 'S4', 'expected S4 object'
    slots = rp.pairlist_dict(obj[1])
    klass = unwrap(slots['class'])
    assert 'DESeqResults' in klass, klass
    genes = [s for s in unwrap(slots['rownames'])]
    ldraw = slots['listData']
    cols = [s for s in unwrap(rp.pairlist_dict(ldraw[2])['names'])]
    assert cols == ['baseMean', 'log2FoldChange', 'lfcSE', 'stat', 'pvalue', 'padj'], cols
    nrows = int(unwrap(slots['nrows'])[0])
    assert nrows == len(genes) == len(unwrap(ldraw[1])[0])
    data = [unwrap(c) for c in ldraw[1]]
    return genes, cols, data, nrows

# ---- 1. Map gene name 'mexG' -> locus tag via the annotation CSV ----
with open(ANNOT) as fh:
    rows = list(csv.DictReader(fh))
hits = [r for r in rows if (r['Gene Name'] or '').strip().lower() == 'mexg']
assert len(hits) == 1, 'expected unique mexG annotation, got %d' % len(hits)
locus = hits[0]['Locus Tag'].strip()
print('mexG annotation: Locus Tag = %s (PGD Gene ID %s, %s, %s:%s-%s)' %
      (locus, hits[0]['PGD Gene ID'], hits[0]['Feature Type'],
       hits[0]['Chromosome/Plasmid Name'], hits[0]['Start'], hits[0]['End']))

# ---- 2. Load res_1vs97.rds (DESeqResults, "Strain 97 vs 1") ----
genes, cols, data, nrows = load_deseq_results(DATA + '/res_1vs97.rds')
print('res_1vs97.rds: DESeqResults, %d rows, columns %s' % (nrows, cols))
print('comparison direction per mcols description: "log2 fold change (MLE): Strain 97 vs 1"'
      ' -> numerator = strain #97 (drhlI), denominator = wt (#1)')

idx = genes.index(locus)
assert genes.count(locus) == 1
print('mexG (%s) found at row index %d of %d' % (locus, idx, nrows))

row = {c: (data[j][idx] if isinstance(data[j], np.ndarray) else data[j][idx])
       for j, c in enumerate(cols)}
print('mexG row:')
for c in cols:
    print('  %-14s %r' % (c, row[c]))

lfc_raw = float(row['log2FoldChange'])
lfc_rounded = round(lfc_raw, 2)
print('\nlog2FoldChange (mexG, unshrunken MLE, strain 97 vs 1) = %r' % lfc_raw)
print('rounded to 2 decimals: %r' % lfc_rounded)

# ---- 3. Context: res_1vs98 (strain 98 vs 1) is not needed for the answer ----
g98, c98, d98, n98 = load_deseq_results(DATA + '/res_1vs98.rds')
i98 = g98.index(locus)
print('\ncontext only, res_1vs98.rds (Strain 98 vs 1) mexG log2FoldChange = %r (unused)' %
      float(d98[1][i98]))

# ---- NA check ----
nas = {c: int(np.sum(~np.isfinite(v))) for c, v in zip(cols, data) if isinstance(v, np.ndarray)}
print('\nNA counts per column (res_1vs97):', nas)
assert nas['log2FoldChange'] == 0

with open('/workspace/work/result.txt', 'w') as fh:
    fh.write('mexG locus: %s\n' % locus)
    fh.write('log2FoldChange raw: %.10f\n' % lfc_raw)
    fh.write('log2FoldChange rounded (2 dp): %.2f\n' % lfc_rounded)
    fh.write('direction: strain 97 (drhlI) vs wt (1); negative = lower in drhlI\n')
    fh.write('value type: unshrunken MLE (no LFC shrinkage; priorInfo empty)\n')
