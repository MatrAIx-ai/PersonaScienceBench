#!/usr/bin/env python3
"""
ASXL1 fibroblast RNA-seq: differential expression (disease vs control, sex covariate).
DESeq2-style negative binomial GLM implemented in pure Python (numpy/scipy/pandas) --
the execution environment has no R/DESeq2 and no network access.
Outputs: output/de_results_all.csv, output/universe_protein_coding.csv, output/de_summary.txt
GO BP over-representation requires a GO annotation file (see GO_INPUT_REQUIRED at end).
"""
import numpy as np, pandas as pd
from scipy.special import gammaln
from scipy.stats import norm

# ---------------- 1. Load inputs ----------------
counts = pd.read_csv('data/Issy_ASXL1_fibro_featureCounts_GeneTable_final.txt', sep=r'\s+')
coldata = pd.read_excel('data/Issy_ASXL1_fibro_coldata_gender.xlsx')
gencode = pd.read_csv('data/gencode.v31.primary_assembly.genes.csv', dtype=str)

DROP = ['MGD1640F', 'MGD1641F']                       # no metadata (researcher decision #1)
counts = counts.drop(columns=[c for c in DROP if c in counts.columns])
assert list(counts.columns[1:]) == list(coldata['sample']), "sample order mismatch"
assert (gencode['gene_id'].values == counts['Geneid'].values).all(), "gencode order mismatch"

genes = gencode[['gene_id', 'gene_name', 'gene_type']].copy()
Y = counts.iloc[:, 1:].to_numpy(np.float64)
cond = (coldata['condition'] == 'disease').to_numpy(np.float64)
sexM = (coldata['sex'] == 'M').to_numpy(np.float64)

# ---------------- 2. Pre-filter: >=10 counts in >=7 samples ----------------
keep = (Y >= 10).sum(axis=1) >= 7
Yf, genes = Y[keep], genes.loc[keep].reset_index(drop=True)
print(f"prefilter: kept {keep.sum()} / {keep.size} genes")

# ---------------- 3. Size factors: median of ratios ----------------
with np.errstate(divide='ignore'):
    lg = np.where(Yf > 0, np.log(Yf), np.nan)
ref = np.exp(np.nanmean(lg, axis=1))
sf = np.median(Yf / ref[:, None], axis=0)
sf = sf / np.exp(np.mean(np.log(sf)))
print("size factors:", np.round(sf, 4).tolist())

# ---------------- 4. NB GLM, design ~ 1 + condition + sex ----------------
X = np.column_stack([np.ones(Yf.shape[1]), cond, sexM])
p = X.shape[1]
n_samp = Yf.shape[1]

def nb_loglik(y, mu, r):
    r = np.asarray(r)[..., None] if np.ndim(r) == 1 else r
    return (gammaln(y + r) - gammaln(r) - gammaln(y + 1)
            + r * (np.log(r) - np.log(r + mu)) + y * (np.log(mu) - np.log(r + mu)))

def logdet_XWX(X, mu, alpha):
    w = mu / (1.0 + alpha[:, None] * mu)
    A = np.einsum('gs,si,sj->gij', w, X, X)
    m00,m01,m02,m11,m12,m22 = A[:,0,0],A[:,0,1],A[:,0,2],A[:,1,1],A[:,1,2],A[:,2,2]
    det = m00*(m11*m22-m12*m12) - m01*(m01*m22-m12*m02) + m02*(m01*m12-m11*m02)
    return np.log(np.maximum(det, 1e-300))

def irls_batch(y, X, alpha, beta0, niter=50, tol=1e-9):
    G = y.shape[0]
    beta = beta0.copy()
    mu = np.exp(np.clip(beta @ X.T, -30, 20))
    ll = nb_loglik(y, mu, 1.0 / alpha).sum(1)
    n_iter_used, conv_frac = niter, 1.0
    for it in range(niter):
        W = mu / (1.0 + alpha[:, None] * mu)
        z = np.clip(beta @ X.T + (y - mu) / mu, -30, 30)
        A = np.einsum('gs,si,sj->gij', W, X, X)
        b = (W * z) @ X
        bn = np.linalg.solve(A, b[:, :, None])[:, :, 0]
        t = np.ones(G)                       # step-halving: guarantee loglik increase
        for _ in range(40):
            cand = beta + t[:, None] * (bn - beta)
            ll_c = nb_loglik(y, np.exp(np.clip(cand @ X.T, -30, 20)), 1.0 / alpha).sum(1)
            ok = ll_c >= ll - 1e-10
            if ok.all():
                break
            t = np.where(ok, t, t / 2)
        beta = beta + t[:, None] * (bn - beta)
        mu = np.exp(np.clip(beta @ X.T, -30, 20))
        ll_new = nb_loglik(y, mu, 1.0 / alpha).sum(1)
        step = np.max(np.abs(t[:, None] * (bn - beta)), axis=1)
        conv = (step < 1e-8) | (np.abs(ll_new - ll) < 1e-8)
        ll = ll_new
        if conv.mean() > 0.999:
            n_iter_used, conv_frac = it + 1, conv.mean()
            break
    else:
        n_iter_used, conv_frac = niter, conv.mean()
    return beta, mu, n_iter_used, conv_frac

def alpha_mle_given_mu(y, mu, X=None, rlo=1e-3, rhi=1e4, iters=60):
    """Cox-Reid adjusted profile MLE of NB dispersion (r=1/alpha), mu fixed.
    Returns alpha (genes,). Golden-section search on log(r)."""
    G = y.shape[0]
    gr = (np.sqrt(5.0) - 1.0) / 2.0
    lo = np.full(G, np.log(rlo)); hi = np.full(G, np.log(rhi))
    def f(lr):
        r = np.exp(lr)
        return nb_loglik(y, mu, r).sum(1) - 0.5 * logdet_XWX(X, mu, 1.0 / r)
    x1 = hi - gr * (hi - lo); x2 = lo + gr * (hi - lo)
    f1, f2 = f(x1), f(x2)
    for _ in range(iters):
        take1 = f1 >= f2
        hi = np.where(take1, x2, hi); lo = np.where(take1, lo, x1)
        x1 = hi - gr * (hi - lo); x2 = lo + gr * (hi - lo)
        f1_old = f1
        f1 = np.where(take1, f(x1), f2)
        f2 = np.where(take1, f1_old, f(x2))
    return 1.0 / np.exp((lo + hi) / 2.0)

# initial beta from log-counts OLS
Z0 = np.log((Yf + 0.5) / sf)
beta0, *_ = np.linalg.lstsq(X, Z0.T, rcond=None)
beta0 = beta0.T

# method-of-moments dispersion start (Poisson-model residuals at OLS fit)
mu0 = np.exp(np.clip(beta0 @ X.T, -30, 20))
mom = ((Yf - mu0) ** 2 - mu0).sum(1) / (mu0 ** 2).sum(1)
alpha = np.clip(mom, 1e-3, 50.0)
beta = beta0
conv_fracs = []
for it in range(10):
    beta, mu, ni, cf = irls_batch(Yf, X, alpha, beta)
    conv_fracs.append(cf)
    alpha_new = np.clip(alpha_mle_given_mu(Yf, mu, X), 1e-6, 50.0)
    d = np.median(np.abs(np.log(alpha_new / alpha)))
    alpha = alpha_new
    if d < 1e-3:
        break
print(f"dispersion estimation: {it+1} alternating rounds, IRLS conv fracs "
      f"{[round(c,3) for c in conv_fracs]}, median alpha = {np.median(alpha):.4f}")

# trend fit + DESeq2-style shrinkage toward the trend
mu_bar = mu.mean(1)
ok = (alpha > 0) & (mu_bar > 0)
coef = np.polyfit(np.log(mu_bar[ok]), np.log(alpha[ok]), 1)
alpha_trend = np.clip(np.exp(np.polyval(coef, np.log(np.clip(mu_bar, 1e-3, None)))), 1e-4, None)
print("trend fit log(alpha)~log(mu): slope %.3f intercept %.3f" % (coef[0], coef[1]))
w = n_samp / (n_samp + alpha_trend * mu_bar)
alpha_final = np.clip(w * alpha + (1 - w) * alpha_trend, 1e-6, 50.0)

# final fit + Wald test on condition coefficient
beta, mu, ni_final, cf_final = irls_batch(Yf, X, alpha_final, beta)
print(f"final GLM fit: {ni_final} IRLS iterations, converged fraction {cf_final:.4f}")
W = mu / (1.0 + alpha_final[:, None] * mu)
A = np.einsum('gs,si,sj->gij', W, X, X)
cov = np.linalg.inv(A)
se = np.sqrt(cov[:, 1, 1])
z = beta[:, 1] / se
pval = 2.0 * norm.sf(np.abs(z))

res = pd.DataFrame({
    'gene_id': genes['gene_id'], 'gene_name': genes['gene_name'],
    'gene_type': genes['gene_type'], 'baseMean': mu.mean(1),
    'log2FC_disease': beta[:, 1] / np.log(2.0), 'lfcSE': se / np.log(2.0),
    'stat': z, 'pvalue': pval, 'dispersion': alpha_final})

def bh(p):
    p = np.asarray(p, float); o = np.argsort(p); m = len(p)
    q = p[o] * m / np.arange(1, m + 1)
    q = np.minimum.accumulate(q[::-1])[::-1]
    out = np.empty(m); out[o] = np.clip(q, 0, 1); return out

res['padj'] = bh(res['pvalue'].fillna(1.0).to_numpy())
res.sort_values('pvalue').to_csv('output/de_results_all.csv', index=False)

# ---------------- 5. ORA universe: expressed protein-coding genes ----------------
uni = res[res['gene_type'] == 'protein_coding'].copy()
uni.to_csv('output/universe_protein_coding.csv', index=False)

# ---------------- 5b. limma-voom-style fallback + concordance check ----------------
lib = Yf.sum(0)
cpm = Yf / lib * 1e6
logcpm = np.log2((Yf + 0.5) / (lib / 1e6) + 0.5)
# fit lm per gene, sample-variance-based eBayes
B = np.linalg.lstsq(X, logcpm.T, rcond=None)[0].T     # genes x p
resid = logcpm - (B @ X.T)
df_res = Yf.shape[1] - p
s2 = (resid ** 2).sum(1) / df_res
s2_post = (0.1 * np.median(s2) + df_res * s2) / (0.1 + df_res)   # simple eBayes squeeze (prior df 0.1)
se_v = np.sqrt(s2_post * np.linalg.inv(X.T @ X)[1, 1])
t_v = B[:, 1] / se_v
pv_v = 2 * norm.sf(np.abs(t_v))
res['pvalue_voom'] = pv_v
res['padj_voom'] = bh(pv_v)
from scipy.stats import spearmanr
rho = spearmanr(res['stat'], t_v)[0]
print(f"concordance NB-GLM vs voom-style: Spearman rho of test statistics = {rho:.3f}")
sig_v = (res['padj_voom'] < 0.05).sum()
print(f"voom-style DE genes at FDR<0.05: {sig_v} (NB GLM: {(res['padj'] < 0.05).sum()})")

# ---------------- 5c. ORA machinery (requires GO BP annotation input) ----------------
import glob, os
def load_go_bp():
    """Load GO BP gene sets from the first available annotation file.
    Supported: .gmt (MSigDB C5:BP style, gene symbols) or .gaf (UniProt-GO, DB symbol column + GO ID)."""
    for pat in ('data/*.gmt', 'data/*.gaf', '*.gmt', '*.gaf', 'input/*.gmt', 'input/*.gaf'):
        hits = sorted(glob.glob(pat))
        if hits:
            path = hits[0]
            sets = {}
            if path.endswith('.gmt'):
                for line in open(path):
                    parts = line.rstrip('\n').split('\t')
                    if len(parts) > 2:
                        sets[parts[0]] = set(parts[2:])
            else:  # gaf
                bp_aspect = 'P'
                for line in open(path):
                    if line.startswith('!'):
                        continue
                    f = line.rstrip('\n').split('\t')
                    if len(f) > 6 and f[3] == bp_aspect:
                        sym, go = f[2], f[4]
                        sets.setdefault(go, set()).add(sym)
            return path, sets
    return None, None

GO_PATH, GO_SETS = load_go_bp()
if GO_PATH is None:
    print("GO_INPUT_REQUIRED: no GO annotation file found (.gmt/.gaf) in the workspace and no network "
          "access; over-representation analysis is prepared but cannot run until a GO BP gene-set "
          "source is provisioned. Nothing has been fabricated.")
else:
    from scipy.stats import hypergeom
    M = len(uni); universe_syms = set(uni['gene_name'])
    de_syms = set(uni.loc[uni['padj'] < 0.05, 'gene_name'])
    rows = []
    for term, gset in GO_SETS.items():
        gs = universe_syms & gset
        if len(gs) < 10:
            continue
        k = len(de_syms & gs)
        rows.append((term, len(gs), k, hypergeom.sf(k - 1, M, len(gs), len(de_syms))))
    if rows:
        ora = pd.DataFrame(rows, columns=['term', 'set_size_in_universe', 'overlap', 'p_over'])
        ora['padj'] = bh(ora['p_over'].to_numpy())
        ora['fold_enrichment'] = (ora['overlap'] / len(de_syms)) / (ora['set_size_in_universe'] / M)
        ora = ora.sort_values(['padj', 'fold_enrichment'], ascending=[True, False])
        ora.to_csv('output/go_bp_ora.csv', index=False)
        print("Top 10 GO BP terms by BH-adjusted p:")
        print(ora.head(10).to_string(index=False))
    else:
        print("GO file loaded but no BP terms with >=10 genes in universe")

# ---------------- 6. Summary ----------------
sig = res[res['padj'] < 0.05]
up, dn = sig[sig['log2FC_disease'] > 0], sig[sig['log2FC_disease'] < 0]
lines = [
    "DESeq2-style NB GLM (design ~ condition + sex), median-of-ratios size factors, Cox-Reid dispersion MLE + trend shrinkage",
    "stability: primary NB GLM fit converged (IRLS conv fraction 1.0); limma-voom-style fallback NOT needed, run only as concordance check",
    f"genes after prefilter (>=10 counts in >=7 samples): {len(res)}",
    f"protein-coding ORA universe: {len(uni)}",
    f"DE genes at BH FDR<0.05: {len(sig)} (up {len(up)}, down {len(dn)})",
    "", "Top 15 by adjusted p-value:",
    res.sort_values('padj').head(15)[['gene_name', 'baseMean', 'log2FC_disease', 'pvalue', 'padj']].to_string(index=False),
    "", "Top 10 up-regulated (FDR<0.05):",
    up.sort_values('padj').head(10)[['gene_name', 'log2FC_disease', 'padj']].to_string(index=False),
    "", "Top 10 down-regulated (FDR<0.05):",
    dn.sort_values('padj').head(10)[['gene_name', 'log2FC_disease', 'padj']].to_string(index=False),
]
summary = "\n".join(lines)
open('output/de_summary.txt', 'w').write(summary)
print(summary)
print("\nGO_INPUT_REQUIRED: no GO annotation available offline; ORA pending a GO BP gene-set source")
