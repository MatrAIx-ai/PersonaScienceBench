#!/usr/bin/env python3
"""
bixbench:bix-5-q4 — Which is the most enriched process in the ASXL1-mutated fibroblasts?

Offline pipeline (no internet, no R in the runner; DESeq2-style method re-implemented in Python):
 1. Raw gene counts (featureCounts; GENCODE v31 versioned Ensembl IDs) + coldata
    (condition: disease = ASXL1-mutant / control; sex).
 2. Drop counts-only samples without metadata: MGD1640F, MGD1641F.
 3. DESeq2 median-of-ratios size factors.
 4. Detected-gene filter (background): >=10 raw counts in >=4 samples.
 5. Per-gene negative-binomial GLM (log link, statsmodels), Wald test on condition
    coefficient; dispersion = trended (binned median) method-of-moments estimate,
    as in edgeR's trended dispersion. Design ~ sex + condition (primary, per plan);
    ~ condition run as the pre-agreed fallback/stability check.
 6. BH FDR; upregulated = padj<0.05 & log2FC>0 (also LFC>=1 set).
 7. Enrichment of upregulated genes (see enrichment script).
"""
import numpy as np, pandas as pd, statsmodels.api as sm
from scipy import stats
from statsmodels.stats.multitest import multipletests as mt
import json, warnings
warnings.filterwarnings("ignore")

COUNTS = "data/Issy_ASXL1_fibro_featureCounts_GeneTable_final.txt"
COLDATA = "data/Issy_ASXL1_fibro_coldata_gender.xlsx"

counts = pd.read_csv(COUNTS, sep=r"\s+", index_col=0).astype(int)
coldata = pd.read_excel(COLDATA, sheet_name="Sheet1").set_index("sample")
shared = [s for s in counts.columns if s in coldata.index]
dropped = [s for s in counts.columns if s not in coldata.index]
counts = counts[shared]; coldata = coldata.loc[shared]
print("counts:", counts.shape, "| coldata:", coldata.shape, "| dropped:", dropped)

logc = np.log(counts.replace(0, np.nan))
ref = logc.mean(axis=1, skipna=True)
size_factors = np.exp(logc.sub(ref, axis=0).median(axis=0, skipna=True).fillna(0.0))
size_factors /= size_factors.mean()
print("size factors:", dict(zip(shared, size_factors.round(3).values)))

detected = counts.index[(counts >= 10).sum(axis=1) >= 4]
print("detected genes (background):", len(detected), "of", counts.shape[0])
cnt = counts.loc[detected]
norm = cnt.div(size_factors, axis=1)

# --- trended dispersion: genewise method-of-moments alpha, median per expression bin ---
mu_g = norm.mean(axis=1); var_g = norm.var(axis=1, ddof=1)
alpha_g = np.maximum((var_g - mu_g) / mu_g**2, 0.0)
bins = pd.qcut(mu_g, 50, duplicates="drop")
alpha_trend = alpha_g.groupby(bins, observed=True).median().reindex(bins).values
alpha_trend = np.maximum(alpha_trend, 1e-4)

cond = (coldata["condition"] == "disease").astype(float).rename("disease")
sexM = (coldata["sex"] == "M").astype(float).rename("sexM")

def nbglm(X_df, tag):
    X = sm.add_constant(X_df, has_constant="add")
    co, se_, p, conv = [], [], [], []
    for i, g in enumerate(cnt.index):
        y = cnt.loc[g].values.astype(float)
        try:
            fit = sm.GLM(y, X, family=sm.families.NegativeBinomial(alpha=alpha_trend[i])).fit(maxiter=100)
            z = fit.params["disease"] / fit.bse["disease"]
            co.append(fit.params["disease"]); se_.append(fit.bse["disease"])
            p.append(2 * stats.norm.sf(abs(z))); conv.append(bool(fit.converged))
        except Exception:
            co.append(np.nan); se_.append(np.nan); p.append(1.0); conv.append(False)
    co = np.array(co); se_ = np.array(se_); p = np.array(p); conv = np.array(conv)
    padj = mt(p, method="fdr_bh")[1]
    l2 = co * np.log2(np.e)
    print(f"[{tag}] fit failures: {(~conv).sum()}/{len(conv)}; padj<0.05: {(padj<0.05).sum()} "
          f"(up {((padj<0.05)&(l2>0)).sum()}, down {((padj<0.05)&(l2<0)).sum()})")
    return l2, padj, conv

l2_full, padj_full, conv_full = nbglm(pd.concat([sexM, cond], axis=1), "~ sex + condition")
l2_red, padj_red, _ = nbglm(cond.to_frame(), "~ condition")
sig_full = set(cnt.index[padj_full < 0.05]); sig_red = set(cnt.index[padj_red < 0.05])
lfc_corr = pd.Series(l2_full).corr(pd.Series(l2_red))
print("design stability: |sig overlap|:", len(sig_full & sig_red), "of", len(sig_full), "/", len(sig_red),
      "; LFC corr:", round(lfc_corr, 3))

up = np.where((padj_full < 0.05) & (l2_full > 0))[0]
up1 = np.where((padj_full < 0.05) & (l2_full >= 1))[0]
down = np.where((padj_full < 0.05) & (l2_full < 0))[0]

genc = pd.read_csv("data/gencode.v31.primary_assembly.genes.csv", index_col=0, low_memory=False)
sym = genc.drop_duplicates("gene_id").set_index("gene_id")["gene_name"]
sym.index = [s.split(".")[0] for s in sym.index]
def to_sym(ids): return [sym.get(g.split(".")[0], g) for g in ids]
names = np.array(to_sym(cnt.index))

res = pd.DataFrame({"gene_id": cnt.index, "gene_name": names, "log2FC": l2_full,
                    "padj": padj_full, "converged": conv_full})
res.to_csv("results/de_results.tsv", sep="\t", index=False)
pd.DataFrame({"gene_name": names[up], "log2FC": l2_full[up], "padj": padj_full[up]}).to_csv(
    "results/up_genes.tsv", sep="\t", index=False)
pd.DataFrame({"gene_name": names[up1], "log2FC": l2_full[up1], "padj": padj_full[up1]}).to_csv(
    "results/up_genes_lfc1.tsv", sep="\t", index=False)
pd.DataFrame({"gene_name": names[down], "log2FC": l2_full[down], "padj": padj_full[down]}).to_csv(
    "results/down_genes.tsv", sep="\t", index=False)
open("results/detected_background.txt", "w").write("\n".join(to_sym(detected)))

top = pd.DataFrame({"gene": names[up][:40], "log2FC": l2_full[up][:40].round(2),
                    "padj": padj_full[up][:40]})
print("\nTop 40 upregulated:"); print(top.to_string(index=False))
print("\nTop 25 downregulated:")
print(pd.DataFrame({"gene": names[down][:25], "log2FC": l2_full[down][:25].round(2),
                    "padj": padj_full[down][:25]}).to_string(index=False))

json.dump({"n_samples_used": len(shared), "dropped": dropped,
           "n_detected_background": int(len(detected)),
           "n_up": int(len(up)), "n_up_lfc1": int(len(up1)), "n_down": int(len(down)),
           "lfc_corr_full_vs_reduced": float(lfc_corr),
           "n_fit_failures_full": int((~conv_full).sum())},
          open("results/de_summary.json", "w"), indent=2)

# ================= STAGE 2: functional enrichment =================

import pandas as pd, numpy as np, re
from scipy import stats
from statsmodels.stats.multitest import multipletests as mt

hg = pd.read_csv("data/HGNC_05-09-19.txt", sep="\t", low_memory=False)
ens = hg["Ensembl ID(supplied by Ensembl)"].astype(str).str.split("|").str[0]
name = dict(zip(ens, hg["Approved name"].astype(str)))
for s, n in zip(hg["Approved symbol"].astype(str), hg["Approved name"].astype(str)):
    name.setdefault(s, n)

bg = set(open("results/detected_background.txt").read().split("\n")); bg.discard("")
up = [g for g in pd.read_csv("results/up_genes.tsv", sep="\t").gene_name if g in bg]
up1 = [g for g in pd.read_csv("results/up_genes_lfc1.tsv", sep="\t").gene_name if g in bg]
down = [g for g in pd.read_csv("results/down_genes.tsv", sep="\t").gene_name if g in bg]

def symre(g, pat): return re.search(pat, g, re.I) is not None
def nmre(g, pat): return re.search(pat, name.get(g, ""), re.I) is not None

def set_adhesion(g):
    return (symre(g, r"^(CDH\d|PCDH|NCAM|NRCAM|CNTN\d|CNTNAP|LSAMP|NTM|DSCAM|CADM|SDC|EPHB?|EFNB?|SEMA[3-7]|PLXN|ROBO|ICAM|VCAM|JAM[23]?|ESAM|CEACAM|CLDN|OCLN|TJP|NECTIN|PVRL|NECTIN|SIGLEC|SELECTIN|SEL[PL])") or
            nmre(g, r"adhesion|cadherin|protocadherin|contactin|ephrin|semaphorin|netrin|integrin|nectin|claudin"))
def set_ecm(g):
    return (symre(g, r"^(COL\d|LAMA|LAMB|LAMC|FN1|FBLN|ELN|FBN|MMP|ADAMTS|TIMP|LOX|LOXL|THBS|SPARC|POSTN|DCN|LUM|ACAN|VWA|HSPG|ITGA|ITGB|TENM|NTM2|FREM|LAMA)") or
            nmre(g, r"collagen|laminin|fibronectin|proteoglycan|matrix metalloproteinase"))
def set_epi(g):
    return (symre(g, r"^(KRT\d|KRTAP|IVL|FLG|LOR|SBSN|SBSNP|CRCT1|TGM\d|SPRR|CALML5|SHROOM|KRTDAP|DMKN|SFN|SPINK|EPCAM|TACSTD|MAL|KRTCAP)") or
            nmre(g, r"keratin|keratinocyte|epidermal|cornified"))
def set_ion(g):
    return (symre(g, r"^(SCN|KCN|KCN[A-Z]|CACNA|CLC[A-Z]|TRP[A-Z]|TRPC|TRPV|TRPA|TRPM|P2RX|P2RY|GLRA|GRIA|GABR|CHRN|CHRNB|CHRNA|HVCN|SLC\d)" ) or
            nmre(g, r"channel|transporter|potassium|sodium|calcium channel"))
def set_gpcr(g):
    return (symre(g, r"^(GPR|OR[0-9]|TAAR|VN1R|OPN|ADGR|GNG|GN[ABQ]|RGS|ARR)" ) or
            nmre(g, r"G-protein coupled receptor"))
def set_syn(g):
    return (symre(g, r"^(SYT|SNAP|STX|VAMP|SV2|SYP|SYN|SHANK|DLG|GRIN|GRIK|GABR|ROCK|PAK|ARC|EGR|FOS|JUN|MAPK)" ) or
            nmre(g, r"synaptic|synapse|neurotransmitter|dendritic"))
def set_mito(g):
    return symre(g, r"^(MT-|NDUF|SDH|UQC|COX\d|ATP5|TOMM|TIMM|MRP|MRPL|MRPS|PPARGC1|PGC1)")
def set_chrom(g):
    return symre(g, r"^(HIST|H2A|H2B|H3F|H4F|H1F|KDM|KMT|SETD|EZH|SUZ|EED|DNMT|TET[12]|BRD|BAF|SMARC|CHD[1-9]|HDAC|SIRT|EP[34]00|CREBBP|EP300|KAT)")
def set_transl(g):
    return symre(g, r"^(RPL|RPS|EIF|EEF|NPM|NOP|NOL|RIO|WDR)")
def set_imm(g):
    return (symre(g, r"^(IFIT|IFI\d|OAS\d|MX\d|ISG|IFN|IL\d|CCL|CXCL|TLR|HLA-|B2M|IRF|STAT|JAK|NFKB|TNF|CASP|GBP|TRIM)" ) or
            nmre(g, r"interleukin|interferon|chemokine|immune"))
def set_dev(g):
    return (symre(g, r"^(HOX|DLX|PAX|SOX|FOX|GLI|WNT|BMP|TGF|FGF|SHH|IHH|NOTCH|MEIS|PBX|GATA|NKX|ONECUT|LHX|OTX|EMX|ZIC|MSX|BHLH|NEURO)" ) or
            nmre(g, r"development|morphogenesis|differentiation"))
def set_lipid(g):
    return symre(g, r"^(FASN|SCD|ACAC|ACAA|ACSL|FABP|FAT|LPIN|DGAT|ELOVL|CYP\d+|HMGCR|SQLE|FDFT1|DHCR|NSDHL|MSMO|LSS|CYP51)")
def set_rna(g):
    return symre(g, r"^(SNRP|SRSF|RBM|HNRNP|SF3|U2AF|PTBP|NOVA|ELAV|MATR|SNRNP|LSM)")

CLASSES = {
 "cell adhesion (GO:0007155 class)": set_adhesion,
 "extracellular matrix organization (GO:0030198 class)": set_ecm,
 "epithelial cell differentiation / keratinization (GO:0030855 class)": set_epi,
 "ion transport / channel activity (GO:0006811 class)": set_ion,
 "G-protein coupled receptor signaling (GO:0007186 class)": set_gpcr,
 "synaptic signaling (GO:0099536 class)": set_syn,
 "mitochondrial respiration / oxidative phosphorylation (GO:0006119 class)": set_mito,
 "chromatin modification (GO:0016569 class)": set_chrom,
 "translation (GO:0006412 class)": set_transl,
 "immune response (GO:0006955 class)": set_imm,
 "anatomical structure development (GO:0048856 class)": set_dev,
 "lipid metabolic process (GO:0006629 class)": set_lipid,
 "RNA splicing/processing (GO:0008380 class)": set_rna,
}

def run(genelist, label):
    S = set(genelist)
    rows = []
    for cname, fn in CLASSES.items():
        hit = sum(1 for g in bg if fn(g)); upn = sum(1 for g in S if fn(g))
        if hit == 0: continue
        _, p = stats.fisher_exact([[upn, len(S)-upn], [hit-upn, len(bg)-len(S)-(hit-upn)]], alternative="greater")
        rows.append((cname, upn, hit, round(upn/hit,2), p))
    df = pd.DataFrame(rows, columns=["process_class","n_up_hits","n_bg_genes","ratio","p"]).sort_values("p")
    df["padj"] = mt(df.p, method="fdr_bh")[1]
    print(f"\n=== {label}  (n={len(S)}) ===")
    print(df.to_string(index=False))
    return df

d_up = run(up, "UP genes (padj<0.05, log2FC>0)")
d_up1 = run(up1, "UP genes (padj<0.05, log2FC>=1)")
d_dn = run(down, "DOWN genes (padj<0.05, log2FC<0)  [sensitivity check]")

d_up.to_csv("results/enrichment_up.tsv", sep="\t", index=False)
d_up1.to_csv("results/enrichment_up_lfc1.tsv", sep="\t", index=False)
d_dn.to_csv("results/enrichment_down.tsv", sep="\t", index=False)

print("\nTop 25 UP genes annotated to the winning class:")
win = CLASSES[d_up.iloc[0]["process_class"]]
print(sorted([g for g in up if win(g)])[:25])
