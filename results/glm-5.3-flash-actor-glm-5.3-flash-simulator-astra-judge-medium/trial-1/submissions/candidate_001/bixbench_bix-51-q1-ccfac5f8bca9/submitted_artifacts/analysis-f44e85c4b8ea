"""Logistic regression: P(Efficacy=PR) ~ Age, data/data.xlsx Sheet1.

Primary analysis: pooled fit over all 80 patients (PR=1 vs SD/PD=0),
Age as the only predictor; predict P(PR) at Age=65.
Sensitivity: Group x Efficacy crosstab; note on degenerate arm-restricted fits.
"""
import pandas as pd
import numpy as np
import statsmodels.api as sm

# --- Load & clean ---
df = pd.read_excel("data/data.xlsx", sheet_name="Sheet1")
n_raw = len(df)

# Drop fully empty trailing rows (keep rows with a real Sequence number)
df = df.dropna(subset=["Sequence number"]).copy()
n_clean = len(df)

df["Age_num"] = pd.to_numeric(df["Age"], errors="coerce")
assert df["Age_num"].isna().sum() == 0, "Unexpected missing Age in real rows"
assert df["Efficacy"].isin(["PR", "SD", "PD"]).all()

df["y"] = (df["Efficacy"] == "PR").astype(int)
print(f"Raw rows: {n_raw}, cleaned rows: {n_clean}")
print("Outcome counts (pooled):", df["y"].value_counts().to_dict())
print(f"Age range: {df['Age_num'].min():.0f}-{df['Age_num'].max():.0f}, "
      f"mean {df['Age_num'].mean():.2f}")

# --- Sensitivity (a): Group x Efficacy crosstab (complete separation) ---
ct = pd.crosstab(df["Groups"], df["Efficacy"], margins=True)
print("\nGroup x Efficacy crosstab (evidence of complete separation):")
print(ct)

# --- Sensitivity (b): arm-restricted fits are degenerate ---
for g, sub in df.groupby("Groups"):
    print(f"Group {int(g)}: n={len(sub)}, PR={sub['y'].sum()} -> "
          f"outcome constant; no finite MLE for arm-restricted Age-only logit.")

# --- Primary model: pooled logistic regression, y ~ Age ---
X = sm.add_constant(df["Age_num"].astype(float))
model = sm.Logit(df["y"], X).fit(disp=0)
print("\n=== Primary pooled logistic regression: PR(1) vs SD/PD(0) ~ Age ===")
print(model.summary2().tables[1].to_string())
print(f"\nLog-likelihood: {model.llf:.4f}, McFadden pseudo-R2: {model.prsquared:.4f}")
print(f"LLR p-value (Age): {model.llr_pvalue:.4g}")

# Diagnostics: no separation in the pooled fit
pred = model.predict(X)
print(f"\nPredicted-probability range: [{pred.min():.4f}, {pred.max():.4f}] "
      "-> strictly inside (0,1): pooled model shows no separation.")
print(f"Converged: {model.mle_retvals['converged']}, iterations: "
      f"{model.mle_retvals['iterations']}")

# --- Prediction at Age = 65 ---
p65 = model.predict(pd.DataFrame({"const": [1.0], "Age_num": [65.0]}))[0]
print(f"\nPredicted P(PR) at Age=65: {p65:.3f}")

# Cross-check: manual computation from fitted coefficients
b0, b1 = model.params["const"], model.params["Age_num"]
p_manual = 1 / (1 + np.exp(-(b0 + b1 * 65)))
print(f"Manual cross-check from coefficients: 1/(1+exp(-({b0:.6f}+{b1:.6f}*65))) = {p_manual:.6f}")

# Empirical context: observed PR rate near age 65 (+/-5y)
mask = df["Age_num"].between(60, 70)
print(f"Observed PR rate in ages 60-70 (n={mask.sum()}): {df.loc[mask,'y'].mean():.3f}")

# Prediction interval (Wald) for P(PR | Age=65)
se_lin = float(np.sqrt(np.array([1, 65]) @ model.cov_params().values @ np.array([1, 65])))
lo, hi = b0 + b1 * 65 - 1.96 * se_lin, b0 + b1 * 65 + 1.96 * se_lin
print(f"95% Wald CI for P(PR|Age=65): [{1/(1+np.exp(-hi)):.3f}, {1/(1+np.exp(-lo)):.3f}]")
