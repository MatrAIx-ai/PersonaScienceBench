"""
BixBench bix-51-q2: AIC of logistic regression of treatment response (efficacy PR)
on BMI as sole predictor.
Data: data/data.xlsx, Sheet1.
Response coding: PR = 1 (response), SD/PD = 0 (non-response).
Sample: complete cases on BMI & Efficacy (n = 80).
AIC = -2*logLik + 2k, k = 2 (intercept + BMI).
"""
import pandas as pd
import numpy as np
import statsmodels.api as sm
import statsmodels

print("statsmodels version:", statsmodels.__version__)
print("pandas version:", pd.__version__)

# 1) Load
df = pd.read_excel("/workspace/data/data.xlsx", sheet_name="Sheet1")
print("Raw rows read (excl. header):", len(df))

# 2) Drop fully blank trailing rows via complete-case filter on model variables
model_df = df.dropna(subset=["BMI", "Efficacy"]).copy()
n = len(model_df)
print("Final sample size (complete cases):", n)

# 3) Binary response: PR = 1, SD/PD = 0
model_df["response"] = (model_df["Efficacy"] == "PR").astype(int)
resp_counts = model_df["response"].value_counts().to_dict()
print("Response split (1=PR, 0=SD/PD):", resp_counts)
print("Efficacy stored value counts:", model_df["Efficacy"].value_counts().to_dict())

# 4) Sanity: BMI summary
print("BMI summary: min=%.1f max=%.1f mean=%.4f sd=%.4f missing=%d"
      % (model_df["BMI"].min(), model_df["BMI"].max(),
         model_df["BMI"].mean(), model_df["BMI"].std(), model_df["BMI"].isna().sum()))

# 5) Fit univariate logistic regression: response ~ BMI
y = model_df["response"].values
X = sm.add_constant(model_df["BMI"].values, prepend=True)
logit = sm.Logit(y, X)
res = logit.fit(disp=0)
print("Converged:", res.mle_retvals["converged"])
print("Iterations:", res.mle_retvals.get("iterations"))

# 6) Separation diagnostics
bmi_1 = model_df.loc[model_df["response"] == 1, "BMI"]
bmi_0 = model_df.loc[model_df["response"] == 0, "BMI"]
print("BMI range PR (y=1): [%.1f, %.1f]" % (bmi_1.min(), bmi_1.max()))
print("BMI range non-PR (y=0): [%.1f, %.1f]" % (bmi_0.min(), bmi_0.max()))
print("Ranges overlap (no complete separation):",
      bool(bmi_1.min() <= bmi_0.max() and bmi_0.min() <= bmi_1.max()))
pred = res.predict(X)
print("Fitted probability range: [%.4f, %.4f] (0/1 extremes would indicate separation)"
      % (pred.min(), pred.max()))

# 7) Coefficients and log-likelihood
print(res.summary())
print("Coefficients (const, BMI):", res.params.tolist())
print("Log-likelihood (llf): %.10f" % res.llf)

# 8) AIC: statsmodels .aic and manual cross-check (-2*llf + 2k, k=2)
k = res.params.shape[0]
aic_sm = res.aic
aic_manual = -2 * res.llf + 2 * k
print("k (parameters):", k)
print("AIC (statsmodels Logit .aic): %.10f" % aic_sm)
print("AIC (manual -2*llf + 2k):    %.10f" % aic_manual)
print("Match:", np.isclose(aic_sm, aic_manual))
print("FINAL AIC: %.4f" % aic_sm)
