"""BixBench bix-51-q3: Combined logistic regression (BMI, age, gender) on PR."""
import numpy as np
import pandas as pd
import statsmodels.api as sm

# 1) Load Sheet1, coerce numerics, drop padding rows
df = pd.read_excel('/workspace/data/data.xlsx', sheet_name='Sheet1')
df['Age'] = pd.to_numeric(df['Age'], errors='coerce')
n_raw = len(df)
df = df.dropna(subset=['Sequence number', 'Groups', 'Efficacy', 'Age', 'Gender', 'BMI'])
n_model = len(df)
print(f"Raw rows: {n_raw}; complete-case rows for model: {n_model}")
print("Efficacy distribution:\n", df['Efficacy'].value_counts())

# 2) Outcome and design matrix: PR=1 vs non-PR (SD/PD)=0
y = (df['Efficacy'] == 'PR').astype(int)
X = pd.DataFrame({
    'BMI': df['BMI'].astype(float),
    'Age': df['Age'].astype(float),
    'Gender_Male': (df['Gender'] == 'Male').astype(int),  # Female = reference
})
X = sm.add_constant(X)

# 3) Primary model: continuous BMI
model = sm.Logit(y, X).fit(disp=0)
print("\n=== PRIMARY MODEL: BMI continuous, Age continuous, Gender (ref=Female) ===")
print(model.summary())
tbl = pd.DataFrame({
    'coef': model.params, 'se': model.bse, 'z': model.tvalues,
    'p': model.pvalues, 'OR': np.exp(model.params),
    'OR_CI_low': np.exp(model.conf_int()[0]), 'OR_CI_high': np.exp(model.conf_int()[1]),
})
print(tbl.round(6).to_string())
p_age = float(model.pvalues['Age'])
print(f"\nPRIMARY ANSWER - Age Wald p-value: {p_age:.4f}")
print(f"Age coef: {model.params['Age']:.4f}, SE: {model.bse['Age']:.4f}, "
      f"OR: {np.exp(model.params['Age']):.4f}")

# 4) Sensitivity: BMI dichotomized at median
med = df['BMI'].median()
Xs = X.copy()
Xs['BMI'] = (df['BMI'] > med).astype(int)
ms = sm.Logit(y, Xs).fit(disp=0)
print(f"\n=== SENSITIVITY MODEL: BMI dichotomized at median ({med}) ===")
tbls = pd.DataFrame({'coef': ms.params, 'se': ms.bse, 'p': ms.pvalues, 'OR': np.exp(ms.params)})
print(tbls.round(6).to_string())
print(f"\nSENSITIVITY - Age Wald p-value: {ms.pvalues['Age']:.4f} "
      f"(primary continuous-BMI p: {p_age:.4f})")

# Diagnostics
print("\nConcordance (primary):", round(model.prsquared, 4), "= McFadden pseudo-R2")
print("Outcome counts: PR =", int(y.sum()), ", non-PR =", int((1-y).sum()))
