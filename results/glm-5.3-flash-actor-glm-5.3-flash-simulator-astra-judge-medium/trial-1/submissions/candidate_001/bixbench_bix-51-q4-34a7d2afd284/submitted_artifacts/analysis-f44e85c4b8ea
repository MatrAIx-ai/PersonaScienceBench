"""
BixBench bix-51-q4: Logistic regression of remission on Age, BMI, Gender.

Outcome mapping (inferred from the data): remission = 1 if Efficacy == 'PR',
0 if Efficacy in {'SD','PD'}. Efficacy maps 1:1 onto Groups (all Group-1
patients are PR; all Group-2 patients are SD/PD), which supports this coding.

Model: remission ~ Age (continuous, per year) + BMI (continuous)
        + Gender dummy (Female = 1, Male = reference).
"""
import numpy as np
import pandas as pd
import statsmodels.api as sm

df = pd.read_excel("data/data.xlsx", sheet_name="Sheet1")

# Keep only real patient rows: drop fully empty rows and stray whitespace rows
df = df.dropna(how="all")
df = df[df["Sequence number"].notna()].copy()
print(f"Analytic sample size: {len(df)}")

# Complete-case check on modeled variables
model_vars = ["Efficacy", "Age", "BMI", "Gender"]
print("Missing per modeled variable:\n", df[model_vars].isna().sum(), sep="")
assert df[model_vars].notna().all().all(), "Unexpected missing data in model variables"

# Outcome: remission = PR
y = (df["Efficacy"] == "PR").astype(int)
print(f"\nRemission (PR) count: {y.sum()} / {len(y)} ({y.mean():.1%})")
print(pd.crosstab(df["Gender"], y, margins=True))

# Predictors
X = pd.DataFrame({
    "Age": pd.to_numeric(df["Age"], errors="raise").astype(float),
    "BMI": df["BMI"].astype(float),
    "Gender_Female": (df["Gender"] == "Female").astype(float),  # Male = reference
})
X = sm.add_constant(X)
print("\nPredictor summary:\n", X.describe().to_string(), sep="")

# Logistic regression (ML, unpenalized)
model = sm.Logit(y, X).fit(disp=0)
print("\n=== Logistic regression results ===")
print(model.summary())

ci = model.conf_int()
params = model.params
res = pd.DataFrame({
    "coef (log-odds)": params,
    "std err": model.bse,
    "z": model.tvalues,
    "p-value": model.pvalues,
    "2.5% CI": ci[0],
    "97.5% CI": ci[1],
    "OR": np.exp(params),
    "OR 2.5%": np.exp(ci[0]),
    "OR 97.5%": np.exp(ci[1]),
})
print("\n", res.to_string(), sep="")

b_age = params["Age"]
se_age = model.bse["Age"]
lo, hi = ci.loc["Age"]
print(f"\n>>> Age coefficient (log-odds change per 1-year increase): {b_age:.4f}")
print(f">>> SE: {se_age:.4f}")
print(f">>> 95% CI: ({lo:.4f}, {hi:.4f})")
print(f">>> OR per year: {np.exp(b_age):.4f} (95% CI {np.exp(lo):.4f}–{np.exp(hi):.4f})")
print(f">>> p-value: {model.pvalues['Age']:.4g}")
print(f">>> Model pseudo-R2: {model.prsquared:.4f}; LLR p-value: {model.llr_pvalue:.4g}")

# Sensitivity: alternative outcome mapping remission = non-PD (PR or SD)
y_alt = (df["Efficacy"] != "PD").astype(int)
m_alt = sm.Logit(y_alt, X).fit(disp=0)
print(f"\n[Sensitivity check: remission = non-PD] Age coef = {m_alt.params['Age']:.4f} "
      f"(SE {m_alt.bse['Age']:.4f}, 95% CI {tuple(np.round(m_alt.conf_int().loc['Age'],4))})")

# Save results table
res.to_csv("analysis/logit_results.csv")
