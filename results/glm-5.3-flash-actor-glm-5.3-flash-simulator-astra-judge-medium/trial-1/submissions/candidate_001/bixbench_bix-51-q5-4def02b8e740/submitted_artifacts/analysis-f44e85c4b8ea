"""
BixBench bix-51-q5 — Logistic regression p-value for BMI ~ treatment response.
PRIMARY (researcher-approved): univariate logit, outcome = response
(PR=1 vs SD+PD=0), predictor = BMI (continuous); report Wald p-value of BMI.
Sensitivity analyses are report-only. Author: analysis agent. Date: 2026-10-20.
"""
import pandas as pd
import numpy as np
import statsmodels.api as sm
from scipy.stats import chi2

# ---------- Load & preprocess ----------
raw = pd.read_excel('data/data.xlsx', sheet_name='Sheet1')
print(f"Raw shape: {raw.shape}")

df = raw.apply(lambda c: c.map(lambda v: v.strip() if isinstance(v, str) else str(v).strip()
                               if isinstance(v, (int, np.integer)) and not isinstance(v, bool) else v))
df = df.replace({'': np.nan, ' ': np.nan}).dropna(how='all').reset_index(drop=True)
print(f"Shape after dropping blank rows: {df.shape}")

# ---------- Verification (researcher caution #3) ----------
assert df.shape[0] == 80, "Expected exactly 80 data rows"
seq = df['Sequence number'].astype(float)
assert sorted(seq) == list(range(1, 81)), "Sequence must be exactly 1..80"
assert df.drop(columns=['Toxic and side effect']).notna().all().all(), "Unexpected missing"
print("Verified: n=80, Sequence 1..80 unique & complete, no missing in analytical columns.")

df['Age'] = pd.to_numeric(df['Age'])
df['Groups'] = pd.to_numeric(df['Groups']).astype(int)

ct = pd.crosstab(df['Groups'], df['Efficacy'])
print("\nGroups x Efficacy crosstab AFTER preprocessing (separation check):")
print(ct)
# ---------- Primary model ----------
df['response'] = (df['Efficacy'] == 'PR').astype(int)
print(f"\nResponders(PR)={df['response'].sum()}, Non-responders(SD+PD)={(1-df['response']).sum()}")

sep_ct = pd.crosstab(df['Groups'], df['response'])
sep = (sep_ct.sum(axis=1) - sep_ct.max(axis=1) == 0).all()
print("Perfect separation Groups x response (Group1 all PR=1, Group2 all PR=0):", sep)
assert sep, "Expected perfect separation of response by Groups after preprocessing" 

X = sm.add_constant(df['BMI'])
primary = sm.Logit(df['response'], X).fit(disp=0)
print("\n=== PRIMARY: logit(response ~ BMI) ===")
print(primary.summary2().tables[1])
p_primary = primary.pvalues['BMI']
or_primary = np.exp(primary.params['BMI'])
print(f"BMI coef={primary.params['BMI']:.4f}, OR/unit={or_primary:.3f}, Wald p={p_primary:.4g}")

lr_stat = 2 * (primary.llf - primary.llnull)
lr_p = chi2.sf(lr_stat, 1)
print(f"LR-test cross-check: stat={lr_stat:.3f}, p={lr_p:.4g} (matches statsmodels LLR p={primary.llr_pvalue:.4g})")

# ---------- Sensitivity (report-only) ----------
res = {}
y1 = (df['Efficacy'] != 'PD').astype(int)                      # S1
res['S1 PR+SD=1 vs PD=0, BMI continuous'] = sm.Logit(y1, X).fit(disp=0).pvalues['BMI']

bmi23 = (df['BMI'] >= 23).astype(int)                          # S2
m2 = sm.Logit(df['response'], sm.add_constant(bmi23.rename('BMI_ge23'))).fit(disp=0)
res['S2 BMI>=23 vs <23'] = m2.pvalues['BMI_ge23']

uw = (df['BMI'] < 18.5).astype(int)                            # S3
m3 = sm.Logit(df['response'], sm.add_constant(uw.rename('BMI_underw'))).fit(disp=0)
res['S3 BMI<18.5 vs rest'] = m3.pvalues['BMI_underw']

# S4: multivariable WITHOUT Groups (Groups perfectly separates outcome)
Xd = pd.DataFrame({'BMI': df['BMI'], 'Age': df['Age'],
                   'ECOG2': (df['ECOG-PS'].astype(str) == '2').astype(int),
                   'CPB': (df['Child-Pugh'] == 'B').astype(int),
                   'HBV': (df['HBV infection'] == 'Yes').astype(int),
                   'Male': (df['Gender'] == 'Male').astype(int),
                   'FH': (df['Family history'] == 'Yes').astype(int),
                   'Chemo': (df['Chemotherapy experience'] == 'Yes').astype(int)})
for c in Xd.columns:
    print(f"  S4 coding check {c}: unique={sorted(Xd[c].unique())}")
m4 = sm.Logit(df['response'], sm.add_constant(Xd)).fit(disp=0)
res['S4 multivariable (no Groups), BMI'] = m4.pvalues['BMI']
print(f"S4 BMI: coef={m4.params['BMI']:.4f}, OR={np.exp(m4.params['BMI']):.3f}, p={m4.pvalues['BMI']:.4g}")

print("\n=== SENSITIVITY SUMMARY (report-only) ===")
for k, v in res.items():
    print(f"{k}: p = {v:.4g}")

diverge = any(abs(v - p_primary) > 0.05 for v in res.values())
print(f"\nMaterial divergence between primary and any sensitivity (>0.05): {diverge}")

# ---------- Final ----------
print("\n================ FINAL ================")
print(f"Primary univariate logit(response[PR=1 vs SD+PD=0] ~ BMI), n=80")
print(f"PRIMARY ANSWER: BMI Wald p-value = {p_primary:.3g}")

with open('analysis/results.txt', 'w') as f:
    f.write(f"PRIMARY BMI Wald p-value (logit response[PR=1 vs SD+PD=0] ~ BMI, n=80): {p_primary:.6g}\n")
    f.write(f"OR per BMI unit: {or_primary:.6g}; LR-test p: {lr_p:.6g}\n")
    for k, v in res.items():
        f.write(f"{k}: {v:.6g}\n")
