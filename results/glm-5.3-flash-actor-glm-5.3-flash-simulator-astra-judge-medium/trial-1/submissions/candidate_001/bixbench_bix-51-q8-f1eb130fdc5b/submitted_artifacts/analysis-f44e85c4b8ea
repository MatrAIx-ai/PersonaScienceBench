"""
BixBench bix-51-q8 — Simple logistic regression: camrelizumab treatment response ~ age.

PRIMARY (per approved plan): outcome = responder (Efficacy == 'PR') vs non-responder
(SD/PD); predictor = Age (continuous, years); N = 80 complete cases.
SENSITIVITY: Firth-penalized logistic of the same outcome on Age + Groups (Group 1 ref),
documenting the complete-separation property of these data.
"""
import warnings
import numpy as np
import pandas as pd
import statsmodels.api as sm
from scipy.optimize import minimize

# ---------- 1. Load and clean ----------
df = pd.read_excel('data/data.xlsx', sheet_name='Sheet1')
n_raw = df.shape[0]
d = df.dropna(how='all').copy()                       # drop 40 fully empty rows
d = d[d['Sequence number'].notna()].copy()            # drop stray 81st row (blank Age, no data)
d['Age'] = pd.to_numeric(d['Age'], errors='coerce')
d['respond'] = (d['Efficacy'] == 'PR').astype(float)  # ORR-style binary outcome
d['group2'] = (d['Groups'] == 2).astype(float)        # Group 1 = reference
cc = d[['respond', 'Age', 'group2']].dropna()
y = cc['respond'].values; N = len(cc)
age = cc['Age'].values
print(f"Raw rows: {n_raw}; analytic N (complete cases): {N}")
print(f"Responders (PR): {int(y.sum())}/{N}  |  Age: {age.min()}-{age.max()} yr, mean {age.mean():.2f}")
print(f"Groups x Efficacy:\n{pd.crosstab(d['Groups'], d['Efficacy']).to_string()}")

# ---------- 2. PRIMARY: ML Logit(respond ~ Age) ----------
X = sm.add_constant(age, has_constant='add')
with warnings.catch_warnings():
    warnings.simplefilter('ignore')
    m = sm.Logit(y, X).fit(disp=0)
b_age, se_age, p_age = m.params[1], m.bse[1], m.pvalues[1]
or_age = np.exp(b_age); ci = np.exp(m.conf_int()[1])
print("\n=== PRIMARY: respond ~ Age (statsmodels Logit, N=%d) ===" % N)
print(f"Age coefficient (log-odds per year): {b_age:.6f}  SE: {se_age:.6f}  z: {m.tvalues[1]:.3f}  p: {p_age:.4g}")
print(f"OR per year: {or_age:.4f}  (95% CI {ci[0]:.4f}-{ci[1]:.4f})")
print(f"Intercept: {m.params[0]:.4f}; converged: {m.mle_retvals['converged']}; LL {m.llf:.3f}; pseudo-R2 {m.prsquared:.4f}")

# ---------- 3. Independent cross-checks ----------
sd = age.std(ddof=0); z = (age - age.mean()) / sd
def negll(beta, Xb, yv):
    eta = np.clip(Xb @ beta, -500, 500)
    return -np.sum(yv * eta - np.logaddexp(0, eta))
def grad(beta, Xb, yv):
    mu = 1 / (1 + np.exp(-np.clip(Xb @ beta, -500, 500)))
    return -(Xb.T @ (yv - mu))
r = minimize(negll, x0=np.zeros(2), args=(np.column_stack([np.ones(N), z]), y),
             jac=grad, method='BFGS', options={'gtol': 1e-10, 'maxiter': 500})
b_sp = r.x[1] / sd; a_sp = r.x[0] - r.x[1] * age.mean() / sd
beta = np.zeros(2)
for it in range(1, 201):
    eta = np.clip(X @ beta, -500, 500); mu = 1 / (1 + np.exp(-eta)); W = mu * (1 - mu)
    step = np.linalg.solve(X.T @ (X * W[:, None]), X.T @ (y - mu)); beta += step
    if np.max(np.abs(step)) < 1e-12: break
print("\n=== Cross-checks (Age coef) ===")
print(f"SciPy BFGS (scaled predictor, analytic gradient): {b_sp:.6f} (max |grad| {np.max(np.abs(r.jac)):.1e})")
print(f"Manual Newton-Raphson IRLS ({it} iters):            {beta[1]:.6f}")
print(f"|diff| vs statsmodels: SciPy {abs(b_sp-b_age):.2e}, IRLS {abs(beta[1]-b_age):.2e}")

# ---------- 4. Separation diagnostic + SENSITIVITY: Firth-penalized Age + Groups ----------
print("\n=== Separation diagnostic ===")
print("PR occurs ONLY in Group 1 (41/41) and never in Group 2 (0/39); under any binary "
      "collapse treating PR as response, Efficacy is perfectly collinear with Groups, "
      "so respond ~ Age + Groups has no finite ML estimate (statsmodels emits "
      "PerfectSeparationWarning and does not converge: e.g., params (~22, 0.08, ~-53)).")
with warnings.catch_warnings():
    warnings.simplefilter('ignore')
    X2 = sm.add_constant(cc[['Age', 'group2']].values, has_constant='add')
    m2 = sm.Logit(y, X2).fit(disp=0, maxiter=100)
print(f"Documenting failed ML fit params: {np.round(m2.params, 3)} (converged={m2.mle_retvals['converged']})")

def firth_logit(Xb, yv, tol=1e-10, maxiter=500):
    beta = np.zeros(Xb.shape[1])
    for k in range(1, maxiter + 1):
        mu = 1 / (1 + np.exp(-np.clip(Xb @ beta, -500, 500)))
        W = mu * (1 - mu)
        XtWX_inv = np.linalg.pinv(Xb.T @ (Xb * W[:, None]))
        hdiag = np.einsum('ij,jk,ik->i', Xb * W[:, None], XtWX_inv, Xb)
        step = XtWX_inv @ (Xb.T @ (yv - mu + hdiag * (0.5 - mu)))
        beta += step
        if np.max(np.abs(step)) < tol:
            return beta, k
    raise RuntimeError("Firth IRLS did not converge")

Xf = np.column_stack([np.ones(N), age, cc['group2'].values])
bf, kf = firth_logit(Xf, y)
mu = 1 / (1 + np.exp(-np.clip(Xf @ bf, -500, 500))); Wf = mu * (1 - mu)
se_f = np.sqrt(np.diag(np.linalg.inv(Xf.T @ (Xf * Wf[:, None]))))
b1f, _ = firth_logit(X, y)
print("\n=== SENSITIVITY: Firth-penalized logistic ===")
print(f"respond ~ Age + Groups (Group 1 ref): Age coef {bf[1]:.6f} (SE {se_f[1]:.6f}, "
      f"OR {np.exp(bf[1]):.4f}); Groups(=2) coef {bf[2]:.6f}")
print(f"respond ~ Age only (Firth):           Age coef {b1f[1]:.6f} (vs ML {b_age:.6f})")

# ---------- 5. Summary ----------
print("\n=== SUMMARY ===")
print(f"PRIMARY   respond ~ Age (ML):            Age coef = {b_age:.4f} log-odds/yr "
      f"(SE {se_age:.4f}, p = {p_age:.3g}, OR = {or_age:.4f})")
print(f"SENSIT.   respond ~ Age + Groups (Firth): Age coef = {bf[1]:.4f} log-odds/yr")
