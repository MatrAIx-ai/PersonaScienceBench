"""
BixBench bix-52-q7: Zebra Finch CpG methylation filtering analysis.

Question: How many sites are removed when filtering sites that do not show
>90% or <10% methylation in Zebra Finch?

Locked interpretation (researcher-approved):
  PRIMARY (literal reading): REMOVED set = sites that do NOT show >90% AND do
  NOT show <10% methylation, i.e., middle-range values
  (10 <= MethylationPercentage <= 90, strict outer boundaries).
  ALTERNATIVE: REMOVED set = extreme sites (MethylationPercentage > 90 OR < 10).
Both computed at row level (site x sample records) and unique-site level.
No coverage/read-count thresholds; no per-site averaging; JD and
chromosome-length files unused.
"""
import pandas as pd

zf = pd.read_csv("data/ZF_AgeRelated_CpG_noMT_Final.csv")

n_rows = len(zf)
n_sites = zf["Pos"].nunique()
m = zf["MethylationPercentage"]

# sanity checks on inputs
assert n_sites == zf[["Chromosome", "StartPosition", "EndPosition"]].drop_duplicates().shape[0]
assert zf.duplicated(subset=["Pos", "Sample"]).sum() == 0
assert m.between(0, 100).all()

# --- Direction A: PRIMARY, literal reading (middle-range removed) ---
middle = (m <= 90) & (m >= 10)          # strict boundaries: exactly 90/10 included
rows_removed_A = int(middle.sum())
rows_retained_A = n_rows - rows_removed_A
# site-level: removed if NO sample row of the site is extreme
site_extreme_any = zf.groupby("Pos")["MethylationPercentage"].apply(
    lambda s: ((s > 90) | (s < 10)).any())
sites_removed_A = int((~site_extreme_any).sum())
sites_retained_A = int(site_extreme_any.sum())

# --- Direction B: ALTERNATIVE (extremes removed) ---
extreme = (m > 90) | (m < 10)
rows_removed_B = int(extreme.sum())
site_removed_B = int(site_extreme_any.sum())

# boundary diagnostics
n_eq90 = int((m == 90).sum())
n_eq10 = int((m == 10).sum())

print(f"Input: {n_rows} rows, {n_sites} unique Pos, "
      f"{zf['Sample'].nunique()} samples; MethylationPercentage scale 0-100 "
      f"(min {m.min()}, max {m.max()})")
print(f"Boundary rows: exactly 90% = {n_eq90}, exactly 10% = {n_eq10}")
print()
print("PRIMARY (literal reading; middle range removed, strict boundaries):")
print(f"  Row-level (site x sample records) removed: {rows_removed_A} "
      f"(retained {rows_retained_A})")
print(f"  Unique-site level removed: {sites_removed_A} of {n_sites} "
      f"(retained {sites_retained_A})")
print()
print("ALTERNATIVE (extremes removed):")
print(f"  Row-level removed: {rows_removed_B} "
      f"({int((m > 90).sum())} rows >90%, {int((m < 10).sum())} rows <10%)")
print(f"  Unique-site level removed: {site_removed_B} of {n_sites}")
print()
print("Complementarity check:",
      rows_removed_A + rows_removed_B == n_rows,
      sites_removed_A + site_removed_B == n_sites)

results = {
    "n_rows": n_rows, "n_sites": n_sites,
    "rows_removed_literal": rows_removed_A, "sites_removed_literal": sites_removed_A,
    "rows_removed_extremes": rows_removed_B, "sites_removed_extremes": site_removed_B,
    "rows_eq90": n_eq90, "rows_eq10": n_eq10,
}
pd.Series(results).to_csv("zf_filter_results.csv")
