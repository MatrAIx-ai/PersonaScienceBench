#!/usr/bin/env python3
"""
Gap-percentage analysis for BixBench bix-57-q1 (FALLBACK ALIGNER - NOT MAFFT).

MAFFT is absent from this offline runner (verified: no binary on PATH, no
filesystem copy, no network, no apt sources). Per researcher-approved plan,
this script uses a pure-Python progressive multiple aligner:

  - pairwise Needleman-Wunsch (Gotoh affine gaps) with BLOSUM62
  - guide ordering by pairwise identity (nearest-neighbor progression)
  - profile-profile consolidation with sum-of-pairs column scoring
    and affine gap penalties at the profile level

Gap definition: '-' is the ONLY gap character. All other non-canonical
characters ('.', 'X', '?', '*', whitespace) are counted and reported as
non-gap, non-canonical so nothing is silently dropped.

PRIMARY metric  : pooled % = total '-' cells / total cells (rows x cols,
                  summed over all 10 alignments) * 100
SECONDARY (diag): per-alignment gap % and their unweighted mean
"""
import glob, os, shutil, subprocess
from collections import Counter

# ---------------------------------------------------------------- MAFFT check
def mafft_check():
    path = shutil.which("mafft")
    if path:
        try:
            v = subprocess.run([path, "--version"], capture_output=True, text=True)
            return path, (v.stderr or v.stdout).strip().splitlines()[0]
        except Exception:
            return path, "version unknown"
    for root in ("/usr/bin", "/usr/local/bin", "/usr/lib/mafft", "/opt"):
        if os.path.isdir(root):
            for f in os.listdir(root):
                if "mafft" in f.lower():
                    return os.path.join(root, f), "found outside PATH"
    return None, None

MAFFT, MAFFT_VER = mafft_check()
print(f"[env] MAFFT available: {MAFFT is not None}", end="")
print(f" ({MAFFT_VER})" if MAFFT else " -> running FALLBACK aligner (NOT MAFFT --auto)")

# ------------------------------------------------------------- scoring matrix
B62 = """A  R  N  D  C  Q  E  G  H  I  L  K  M  F  P  S  T  W  Y  V  B  Z  X  *
A  4 -1 -2 -2  0 -1 -1  0 -2 -1 -1 -1 -1 -2 -1  1  0 -3 -2  0 -2 -1  0 -4
R -1  5  0 -2 -3  1  0 -2  0 -3 -2  2 -1 -3 -2 -1 -1 -3 -2 -3 -1  0 -1 -4
N -2  0  6  1 -3  0  0  0  1 -3 -3  0 -2 -3 -2  1  0 -4 -2 -3  3  0 -1 -4
D -2 -2  1  6 -3  0  2 -1 -1 -3 -4 -1 -3 -3 -1  0 -1 -4 -2 -3  1  1 -1 -4
C  0 -3 -3 -3  9 -3 -4 -3 -3 -1 -1 -3 -1 -2 -3 -1 -1 -2 -2 -1 -3 -3 -2 -4
Q -1  1  0  0 -3  5  2 -2  0 -3 -2  1  0 -3 -1  0 -1 -2 -1 -2  0  3 -1 -4
E -1  0  0  2 -4  2  5 -2  0 -3 -3  1 -2 -3 -1  0 -1 -3 -2 -2  1  4 -1 -4
G  0 -2  0 -1 -3 -2 -2  6 -2 -4 -4 -2 -3 -3 -2  0 -2 -2 -3 -3 -1 -2 -1 -4
H -2  0  1 -1 -3  0  0 -2  8 -3 -3 -1 -2 -1 -2 -1 -2 -2  2 -3  0  0 -1 -4
