* -4 -4 -4 -4 -4 -4 -4 -4 -4 -4 -4 -4 -4 -4 -4 -4 -4 -4 -4 -4 -4 -4 -4  1"""
_lines = B62.strip().splitlines()
_order = _lines[0].split()          # header row (amino-acid order)
assert len(_order) == 24, _order
SUB = {}
for line in _lines[1:]:
    parts = line.split()
    assert len(parts) == 25, f"bad BLOSUM62 row: {line!r}"
    SUB[parts[0]] = dict(zip(_order, map(int, parts[1:])))
assert set(SUB) == set(_order), sorted(SUB)

GAP = "-"
GO, GE = -11.0, -1.0
def sub(a, b):
    return float(SUB.get(a, SUB["X"]).get(b, -1))

# --------------------------------------------------------- pairwise alignment
def nw_affine(s1, s2):
    """Gotoh affine-gap global alignment; returns (score, a1, a2)."""
    n, m = len(s1), len(s2)
    NEG = float("-inf")
    M = [[NEG]*(m+1) for _ in range(n+1)]
    X = [[NEG]*(m+1) for _ in range(n+1)]   # gap in s2 (consume s1)
    Y = [[NEG]*(m+1) for _ in range(n+1)]   # gap in s1 (consume s2)
    PM = [[None]*(m+1) for _ in range(n+1)]
    PX = [[None]*(m+1) for _ in range(n+1)]
    PY = [[None]*(m+1) for _ in range(n+1)]
    M[0][0] = 0.0
    for i in range(1, n+1):
        X[i][0] = GO + GE*i
        PX[i][0] = "X" if i > 1 else "M"
    for j in range(1, m+1):
        Y[0][j] = GO + GE*j
        PY[0][j] = "Y" if j > 1 else "M"
    for i in range(1, n+1):
        for j in range(1, m+1):
            d = sub(s1[i-1], s2[j-1])
            best, bp = max((M[i-1][j-1], "M"), (X[i-1][j-1], "X"), (Y[i-1][j-1], "Y"))
            M[i][j] = best + d
            PM[i][j] = bp
            X[i][j], PX[i][j] = max((M[i-1][j] + GO + GE, "M"),
                                    (X[i-1][j] + GE, "X"),
                                    (Y[i-1][j] + GO + GE, "Y"))
            Y[i][j], PY[i][j] = max((M[i][j-1] + GO + GE, "M"),
                                    (Y[i][j-1] + GE, "Y"),
                                    (X[i][j-1] + GO + GE, "X"))
    score, state = max((M[n][m], "M"), (X[n][m], "X"), (Y[n][m], "Y"))
    a1, a2 = [], []
    i, j, st = n, m, state
    while i > 0 or j > 0:
        if st == "M":
            a1.append(s1[i-1]); a2.append(s2[j-1]); ns = PM[i][j]; i -= 1; j -= 1
        elif st == "X":
            a1.append(s1[i-1]); a2.append(GAP); ns = PX[i][j]; i -= 1
        else:
            a1.append(GAP); a2.append(s2[j-1]); ns = PY[i][j]; j -= 1
        st = ns if ns else "M"
    return score, "".join(reversed(a1)), "".join(reversed(a2))

def identity(a, b):
    m = sum(1 for x, y in zip(a, b) if x == y and x != GAP)
    d = sum(1 for x, y in zip(a, b) if x != GAP and y != GAP)
    return m / d if d else 0.0

def col_res(c):
    return sum(1 for ch in c if ch != GAP)

def align_profiles(pa, pb):
    """Profile-profile progressive alignment (affine gaps at column level)."""
    L1, L2 = len(pa[0]), len(pb[0])
    colsA = [tuple(s[i] for s in pa) for i in range(L1)]
    colsB = [tuple(s[i] for s in pb) for i in range(L2)]
    nA, nB = len(pa), len(pb)
    NEG = float("-inf")
    M = [[NEG]*(L2+1) for _ in range(L1+1)]
    X = [[NEG]*(L2+1) for _ in range(L1+1)]
    Y = [[NEG]*(L2+1) for _ in range(L1+1)]
    PM = [[None]*(L2+1) for _ in range(L1+1)]
    PX = [[None]*(L2+1) for _ in range(L1+1)]
    PY = [[None]*(L2+1) for _ in range(L1+1)]
    M[0][0] = 0.0
    # prefix sums of residue counts per column (for boundary gap costs)
    pna = [0.0]*(L1+1)
    for i in range(1, L1+1):
        pna[i] = pna[i-1] + col_res(colsA[i-1])
    pnb = [0.0]*(L2+1)
    for j in range(1, L2+1):
        pnb[j] = pnb[j-1] + col_res(colsB[j-1])
    for i in range(1, L1+1):
        X[i][0] = GO + GE*pna[i]          # one gap run opened against all i A-columns
        PX[i][0] = "X" if i > 1 else "M"
    for j in range(1, L2+1):
        Y[0][j] = GO + GE*pnb[j]
        PY[0][j] = "Y" if j > 1 else "M"
    for i in range(1, L1+1):
        ca = colsA[i-1]
        na = col_res(ca)
        for j in range(1, L2+1):
            cb = colsB[j-1]
            sc = 0.0
            for a in ca:
                for b in cb:
                    if a == GAP and b == GAP:
                        continue
                    elif a == GAP or b == GAP:
                        sc += GE
                    else:
                        sc += sub(a, b)
            best, bp = max((M[i-1][j-1], "M"), (X[i-1][j-1], "X"), (Y[i-1][j-1], "Y"))
            M[i][j] = best + sc
            PM[i][j] = bp
            # X: consume A column (na residues) against a gap in B
            X[i][j], PX[i][j] = max((M[i-1][j] + GO + GE*na, "M"),
                                    (X[i-1][j] + GE*na, "X"),
                                    (Y[i-1][j] + GO + GE*na, "Y"))
            nb = col_res(cb)
            Y[i][j], PY[i][j] = max((M[i][j-1] + GO + GE*nb, "M"),
                                    (Y[i][j-1] + GE*nb, "Y"),
                                    (X[i][j-1] + GO + GE*nb, "X"))
    score, state = max((M[L1][L2], "M"), (X[L1][L2], "X"), (Y[L1][L2], "Y"))
    i, j, st = L1, L2, state
    acols, bcols = [], []
    while i > 0 or j > 0:
        if st == "M":
            acols.append(colsA[i-1]); bcols.append(colsB[j-1]); ns = PM[i][j]; i -= 1; j -= 1
        elif st == "X":
            acols.append(colsA[i-1]); bcols.append(tuple(GAP*nB)); ns = PX[i][j]; i -= 1
        else:
            acols.append(tuple(GAP*nA)); bcols.append(colsB[j-1]); ns = PY[i][j]; j -= 1
        st = ns if ns else "M"
    acols.reverse(); bcols.reverse()
    rows = []
    for ca, cb in zip(acols, bcols):
        rows.append("".join(ca) + "".join(cb))
    columns = list(zip(*rows))
    return ["".join(c) for c in columns]

def align_file(seqs):
    """Full progressive MSA: nearest-neighbor guide by pairwise identity."""
    k = len(seqs)
    if k == 1:
        return list(seqs)
    pw = {}
    for i in range(k):
        for j in range(i+1, k):
            s, a, b = nw_affine(seqs[i], seqs[j])
            pw[(i, j)] = (identity(a, b), a, b)
    (i0, j0), _ = max(pw.items(), key=lambda kv: kv[1][0])
    prof = [pw[(i0, j0)][1], pw[(i0, j0)][2]]
    order = [i0, j0]                    # row r of prof corresponds to seqs[order[r]]
    in_prof = {i0, j0}
    while len(in_prof) < k:
        best_x, best_id = None, -1.0
        for x in range(k):
            if x in in_prof:
                continue
            ids = [pw[(min(x, m), max(x, m))][0] for m in in_prof]
            v = sum(ids) / len(ids)
            if v > best_id:
                best_id, best_x = v, x
        prof = align_profiles(prof, [seqs[best_x]])
        order.append(best_x)
        in_prof.add(best_x)
    # restore original sequence order
    perm = sorted(range(k), key=lambda r: order[r])
    return [prof[r] for r in perm]

# ------------------------------------------------------------------ FASTA I/O
def read_fasta(path):
    seqs = []
    name, buf = None, []
    with open(path) as fh:
        for line in fh:
            line = line.rstrip("\n").rstrip("\r")
            if line.startswith(">"):
                if name is not None:
                    seqs.append("".join(buf))
                name = line[1:].strip()
                buf = []
            elif line.strip():
                buf.append(line.strip())
    if name is not None:
        seqs.append("".join(buf))
    return seqs

CANON = set("ACDEFGHIKLMNPQRSTVWY")

# ------------------------------------------------------------------ main pass
files = sorted(glob.glob("data/*.faa"))
print(f"[env] files found: {len(files)}")
strategy = ("fallback progressive MSA: Gotoh-affine NW pairwise (BLOSUM62, "
            "gap open -11, extend -1) + nearest-neighbor guide ordering by "
            "pairwise identity + sum-of-pairs profile-profile consolidation")
print(f"[strategy] {strategy}\n")

results = []
tot_cells = tot_gaps = tot_noncanon = 0
noncanon_counter = Counter()

for path in files:
    raw_seqs = [s.upper() for s in read_fasta(path)]
    raw_n = len(raw_seqs)
    for s in raw_seqs:
        bad = set(s) - CANON
        assert not bad, f"unexpected raw char {bad} in {path}"
    prof = align_file(raw_seqs)
    # --- assertions ---
    assert len(prof) == raw_n, f"{path}: sequence count changed {raw_n}->{len(prof)}"
    L = len(prof[0])
    assert all(len(p) == L for p in prof), f"{path}: ragged alignment"
    assert [p.replace(GAP, "") for p in prof] == raw_seqs, \
        f"{path}: alignment does not preserve sequences"
    # --- counting ---
    gaps = sum(p.count(GAP) for p in prof)
    cells = raw_n * L
    noncanon = Counter()
    for p in prof:
        for ch in p:
            if ch != GAP and ch not in CANON:
                noncanon[ch] += 1
    pct = 100.0 * gaps / cells
    results.append((os.path.basename(path), raw_n, L, cells, gaps, pct, dict(noncanon)))
    # save alignment for independent verification
    os.makedirs("analysis/aligned", exist_ok=True)
    with open(f"analysis/aligned/{os.path.basename(path)}.aln.faa", "w") as out:
        for r, p in enumerate(prof):
            out.write(f">seq{r}\n{p}\n")
    tot_cells += cells
    tot_gaps += gaps
    noncanon_counter.update(noncanon)
    tot_noncanon += sum(noncanon.values())

print(f"{'file':22s} {'nseq':>4s} {'cols':>6s} {'cells':>8s} {'gaps':>8s} {'gap%':>7s}  noncanon")
for name, n, L, cells, gaps, pct, nc in results:
    print(f"{name:22s} {n:4d} {L:6d} {cells:8d} {gaps:8d} {pct:6.2f}%  {nc if nc else '-'}")

pooled = 100.0 * tot_gaps / tot_cells
per_file_mean = sum(r[5] for r in results) / len(results)
print("\n--- SUMMARY ---")
print(f"alignments: {len(results)}   total sequences: {sum(r[1] for r in results)}")
print(f"total cells (rows x cols, all alignments): {tot_cells}")
print(f"total '-' cells: {tot_gaps}")
print(f"non-canonical non-gap chars total: {tot_noncanon} {dict(noncanon_counter)}")
print(f"PRIMARY   pooled gap % = {pooled:.4f}%  ({tot_gaps}/{tot_cells})")
print(f"SECONDARY mean of per-alignment gap % = {per_file_mean:.4f}%  (diagnostic only)")
