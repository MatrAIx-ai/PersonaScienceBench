#!/usr/bin/env python3
"""
BixBench bix-7-q2: Average number of CHIP variants per sample after filtering
out intronic, intergenic, and UTR variants.

Locked choices (researcher-approved):
  1) Variant = row with Zygosity in {Heterozygous, Homozygous Variant};
     exclude Zygosity == 'Reference' and Zygosity == None (no-call) rows.
  2) Filter = drop rows whose 'Sequence Ontology (Combined)' term is one of:
     intron_variant, 3_prime_UTR_variant, 5_prime_UTR_variant,
     5_prime_UTR_premature_start_codon_gain_variant, intergenic_variant.
     RETAIN splice_region_variant and upstream_gene_variant (primary answer).
     Multi-term annotations: excluded if ANY term matches (none exist in data).
  3) Denominator = all 86 workbooks in data/CHIP_DP10_GQ20_PASS.
"""
import openpyxl, os, re, statistics, csv

DATA = "data/CHIP_DP10_GQ20_PASS"
EXCLUDE = {"intron_variant", "3_prime_UTR_variant", "5_prime_UTR_variant",
           "5_prime_UTR_premature_start_codon_gain_variant", "intergenic_variant"}
EXCLUDE_SPLICE = EXCLUDE | {"splice_region_variant"}   # sensitivity variant of the filter
VARIANT_ZYGOSITY = {"Heterozygous", "Homozygous Variant"}

results = []
splice_excluded_counts = []
for fp in sorted(os.listdir(DATA)):
    wb = openpyxl.load_workbook(os.path.join(DATA, fp), data_only=True)
    ws = wb[wb.sheetnames[0]]
    rows = list(ws.iter_rows(values_only=True))
    hdr = rows[1]
    assert hdr[4] == "Zygosity" and hdr[13] == "Sequence Ontology (Combined)", hdr[4:14]
    sample_id = fp.replace("230209_Exome_GRCh38_CHIP_", "").replace(".xlsx", "")
    n_total = n_var = n_kept = n_kept_splice = 0
    for r in rows[2:]:
        n_total += 1
        if r[4] not in VARIANT_ZYGOSITY:      # excludes 'Reference' and None
            continue
        n_var += 1
        terms = [t.strip() for t in str(r[13]).split(",")] if r[13] else []
        if not any(t in EXCLUDE for t in terms):
            n_kept += 1
        if not any(t in EXCLUDE_SPLICE for t in terms):
            n_kept_splice += 1
    results.append((sample_id, n_total, n_var, n_kept, n_kept_splice))
    splice_excluded_counts.append(n_kept_splice)

with open("output/per_sample_variant_counts.csv", "w", newline="") as f:
    w = csv.writer(f)
    w.writerow(["sample", "data_rows", "variants_raw", "variants_after_filter",
                "variants_after_filter_excluding_splice_region"])
    w.writerows(results)

kept = [r[3] for r in results]
print(f"Samples analyzed: {len(results)}")
print(f"Total variant rows (pre-filter): {sum(r[2] for r in results)}")
print(f"Total variants after filter:     {sum(r[3] for r in results)}")
print(f"PRIMARY  mean = {statistics.mean(kept):.2f}")
print(f"         median = {statistics.median(kept):.1f}, "
      f"min = {min(kept)}, max = {max(kept)}")
print(f"SENSITIVITY (also excluding splice_region_variant): "
      f"mean = {statistics.mean(splice_excluded_counts):.2f}, "
      f"median = {statistics.median(splice_excluded_counts):.1f}")
print("\nPer-sample kept counts:")
for sid, _, _, k, _ in results:
    print(f"  {sid:12s} {k}")
