"""
BixBench bix-7-q3: How many CHIP variants remain after removing reference calls?
Parses all 86 per-sample variant workbooks in data/CHIP_DP10_GQ20_PASS/,
drops rows where the per-sample Zygosity == 'Reference' (homozygous-reference
calls), and reports:
  1) PRIMARY   : number of unique CHIP variants (Chr:Pos + Ref/Alt, each mapping
                 to exactly one gene) with >=1 non-reference (carrier) call.
  2) SECONDARY : total per-sample non-reference variant calls.
Sensitivity: rows with missing Zygosity (no-calls) are excluded from both
counts and reported separately.
"""
import glob, os, re
import pandas as pd

DATA_DIR = "data/CHIP_DP10_GQ20_PASS"
OUT_DIR = "results"
os.makedirs(OUT_DIR, exist_ok=True)

files = sorted(glob.glob(f"{DATA_DIR}/*.xlsx"))
assert len(files) == 86, f"expected 86 variant files, found {len(files)}"

records = []
per_file_rows = []
for fp in files:
    sample = os.path.basename(fp).replace("230209_Exome_GRCh38_CHIP_", "").replace(".xlsx", "")
    raw = pd.read_excel(fp, sheet_name=0, header=None)
    sub = [str(x) for x in raw.iloc[1].tolist()]          # row 1 = sub-headers
    df = raw.iloc[2:].copy()                               # row 2+ = data
    df.columns = sub
    df["Sample"] = sample
    df["SourceFile"] = os.path.basename(fp)
    records.append(df)

    ref = int((df["Zygosity"] == "Reference").sum())
    het = int((df["Zygosity"] == "Heterozygous").sum())
    hom = int((df["Zygosity"] == "Homozygous Variant").sum())
    nanc = int(df["Zygosity"].isna().sum())
    per_file_rows.append(dict(Sample=sample, TotalRows=len(df), Reference=ref,
                              Heterozygous=het, HomozygousVariant=hom,
                              NoCall=nanc, NonReference=het + hom))

alldf = pd.concat(records, ignore_index=True)

# --- remove reference calls -------------------------------------------------
nonref = alldf[alldf["Zygosity"].isin(["Heterozygous", "Homozygous Variant"])].copy()
nonref["VariantKey"] = nonref["Chr:Pos"].astype(str) + "|" + nonref["Ref/Alt"].astype(str)

unique_variants = nonref["VariantKey"].nunique()
unique_var_gene = nonref.groupby("VariantKey")["Gene Names"].first().reset_index()
assert (nonref.groupby("VariantKey")["Gene Names"].nunique() == 1).all(), \
    "a variant maps to more than one gene"
unique_genes = unique_var_gene["Gene Names"].nunique()

per_sample_total = len(nonref)
n_total = len(alldf)
n_ref = int((alldf["Zygosity"] == "Reference").sum())
n_nocall = int(alldf["Zygosity"].isna().sum())

# raw unique variants in the dataset (any zygosity)
alldf["VariantKey"] = alldf["Chr:Pos"].astype(str) + "|" + alldf["Ref/Alt"].astype(str)
raw_unique = alldf["VariantKey"].nunique()

# variants that appear ONLY as NaN-zygosity rows (no reference or carrier call anywhere)
ref_keys = set(alldf.loc[alldf["Zygosity"] == "Reference", "VariantKey"])
nan_keys = set(alldf.loc[alldf["Zygosity"].isna(), "VariantKey"])
# variants whose EVERY occurrence in the dataset is a NaN-zygosity (no-call) row
nanonly = sorted(nan_keys - set(nonref["VariantKey"]) - ref_keys)
nanonly_detail = (alldf[alldf["VariantKey"].isin(nanonly)]
                  .loc[:, ["VariantKey", "Gene Names", "HGVS c. (Clinically Relevant)",
                           "HGVS p. (Clinically Relevant)", "Sample"]]
                  .drop_duplicates().to_string(index=False))

per_file = pd.DataFrame(per_file_rows)
per_file.to_csv(f"{OUT_DIR}/per_sample_breakdown.csv", index=False)
unique_var_gene.to_csv(f"{OUT_DIR}/unique_nonreference_variants.csv", index=False)

summary = f"""SUMMARY
=======
Input: {len(files)} per-sample workbooks, {n_total:,} data rows total
  Reference calls removed : {n_ref:,}
  Non-reference calls     : {per_sample_total:,} (Heterozygous {int((nonref['Zygosity']=='Heterozygous').sum()):,} + Homozygous Variant {int((nonref['Zygosity']=='Homozygous Variant').sum()):,})
  No-call rows (NaN zygosity, excluded from both counts): {n_nocall:,}

PRIMARY ANSWER  - unique CHIP variants with >=1 non-reference call: {unique_variants}
  (unique variant-gene pairs: {len(unique_var_gene)}; unique genes among them: {unique_genes})
  Raw unique variants in the dataset (any zygosity): {raw_unique}
SECONDARY ANSWER - per-sample non-reference variant calls: {per_sample_total:,}

NOTE - variants appearing ONLY with NaN zygosity (2):
{nanonly_detail}
"""
print(summary)
with open(f"{OUT_DIR}/summary.txt", "w") as fh:
    fh.write(summary)
print("\nPer-sample breakdown (first 10 rows):")
print(per_file.head(10).to_string(index=False))
print(f"\nArtifacts written: {OUT_DIR}/summary.txt, per_sample_breakdown.csv, unique_nonreference_variants.csv")
