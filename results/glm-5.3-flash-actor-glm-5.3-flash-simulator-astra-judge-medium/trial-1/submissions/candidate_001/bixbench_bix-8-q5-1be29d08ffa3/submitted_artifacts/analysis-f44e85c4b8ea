"""
BixBench bix-8-q5: Test independence between m6A methylation status and
differential expression status in the bladder cancer MeRIP-seq dataset.

Primary analysis (per researcher-approved plan):
- Unit: row-level (transcript-level), all 12,754 rows of the MeRIP file.
- Binarize pre-computed status columns: m6A sig (Hyper/Hypo) vs no-sig;
  DEG (Up/Down) vs no-DEGs.
- Headline test: Pearson chi-square with Yates continuity correction.
- Cross-check: Fisher's exact test (two-sided).
- Sensitivity check (labeled, non-headline): gene-level collapse (n=3,117),
  gene significant if ANY transcript row is significant.
Proteomics file intentionally excluded (not needed for this question).
"""
import pandas as pd
import numpy as np
from scipy.stats import chi2_contingency, fisher_exact

MERIP = "data/MeRIP_RNA_result.xlsx"

df = pd.read_excel(MERIP, sheet_name="Date Formatting")
assert df.shape == (12754, 13), f"unexpected shape {df.shape}"
assert df.isna().sum().sum() == 0, "unexpected missing values"

m6_sig = df["m6A"] != "m6A no sig"          # Hyper or Hypo
deg = df["DEG"] != "no-DEGs"                # Up or Down

# ---- Row-level 2x2 contingency table (PRIMARY) ----
table = pd.crosstab(m6_sig.rename("m6A status"), deg.rename("DEG status"))
table = table.reindex(index=[False, True], columns=[False, True])  # rows: no-sig, sig; cols: no-DEG, DEG
print("Row-level 2x2 contingency table (n = %d):" % len(df))
print(table.to_string())

chi2, p_chi2, dof, expected = chi2_contingency(table.values, correction=True)
odds, p_fisher = fisher_exact(table.values)
print(f"\nChi-square (Yates continuity correction): stat = {chi2:.6f}, dof = {dof}, "
      f"p = {p_chi2:.6e}")
print(f"Minimum expected cell count: {expected.min():.2f}")
print(f"Fisher's exact (two-sided): odds ratio = {odds:.6f}, p = {p_fisher:.6e}")
print(f"\nHEADLINE p-value (chi-square w/ Yates), scientific notation: {p_chi2:.2e}")
print(f"Cross-check p-value (Fisher's exact), scientific notation: {p_fisher:.2e}")

# ---- Direction-resolved breakdown (context only) ----
print("\nDirection-resolved 3x3 breakdown (context):")
print(pd.crosstab(df["m6A"], df["DEG"]).to_string())

# ---- Gene-level sensitivity check ----
gene = df.groupby("gene_id").agg(
    m6A_any=("m6A", lambda s: (s != "m6A no sig").any()),
    DEG_any=("DEG", lambda s: (s != "no-DEGs").any()),
)
gtable = pd.crosstab(gene["m6A_any"], gene["DEG_any"]).reindex(index=[False, True], columns=[False, True])
print(f"\nGene-level 2x2 sensitivity check (n = {len(gene)} genes; sig if ANY transcript sig):")
print(gtable.to_string())
g_chi2, g_p, g_dof, _ = chi2_contingency(gtable.values, correction=True)
g_odds, g_pfisher = fisher_exact(gtable.values)
print(f"Gene-level chi-square (Yates): stat = {g_chi2:.6f}, dof = {g_dof}, p = {g_p:.6e}")
print(f"Gene-level Fisher's exact: p = {g_pfisher:.6e}")

print("\nDONE")
