#!/usr/bin/env python3
"""
analysis.py -- BixBench bix-9-q5
Per-tissue differential expression: bad responders vs controls.
Data: data/Data_deposition_RNAseq_Paroxetine_2017.xlsx (NormCount sheet).
Primary: DESeq2-equivalent NB GLM (log link, gene-wise MoM dispersion with
edgeR-style shrinkage toward a common dispersion, Wald test, BH FDR).
Filters: baseMean > 10, log2FC > 0.5 (primary; |lfc|>0.5 sensitivity), padj<0.05.
Cross-check: the workbook's 9 embedded DESeq1 comparison blocks.
"""
import json
import numpy as np
import openpyxl
from scipy.stats import norm

XLSX = 'data/Data_deposition_RNAseq_Paroxetine_2017.xlsx'

# ---------------------------------------------------------------- load data
print('Loading workbook ...', flush=True)
wb = openpyxl.load_workbook(XLSX, read_only=True)
ws = wb['NormCount']
rows = list(ws.iter_rows(min_row=4, max_row=25406, values_only=True))
hdr, data = rows[0], rows[1:]
genes = [str(r[1]) for r in data]
assert len(set(genes)) == len(genes)

groups = {'Control': list(range(2, 12)), 'good_responder': list(range(12, 22)),
          'bad_responder': list(range(22, 32))}
tissue_cols = {
    'baseline_blood': {g: cols for g, cols in groups.items()},
    'dentate_gyrus':  {g: [c + 30 for c in cols] for g, cols in groups.items()},
    'final_blood':    {g: [c + 60 for c in cols] for g, cols in groups.items()},
}
for t, d in tissue_cols.items():
    for g, cols in d.items():
        for c in cols:
            assert str(hdr[c]).startswith(f'{g}_{t}'), (t, g, hdr[c])
print('Header layout verified: 3 tissues x 3 groups x 10 samples, 25402 genes.')

def col_to_np(cols):
    return np.array([[float(r[c]) for c in cols] for r in data], dtype=np.float64)

# ------------------------------------------------- embedded DESeq cross-check
emb = {}
for k in range(9):
    s = 98 + 9 * k
    num = lambda x: x if isinstance(x, (int, float)) else np.nan
    emb[k + 1] = {
        'baseMean': np.array([num(r[s]) for r in data], float),
        'lfc':      np.array([num(r[s + 4]) for r in data], float),
        'padj':     np.array([num(r[s + 6]) for r in data], float),
        'DEG2':     np.array([r[s + 8] for r in data]),
    }
print('Embedded DESeq blocks extracted (9 comparisons).')

# ---------------------------------------------------------- NB GLM machinery
def irls_nb(Y, X, alpha, tol=1e-8, maxit=100):
    """Vectorized IRLS for log-link NB GLM. Y: genes x n, X: n x p, alpha: genes."""
    G, n = Y.shape
    p = X.shape[1]
    B = np.zeros((G, p))
    B[:, 0] = np.log(np.maximum(Y.mean(axis=1), 0.1))
    for j in range(1, p):
        col = X[:, j].astype(bool)
        B[:, j] = np.log(np.maximum(Y[:, col].mean(axis=1), 0.1))
    for _ in range(maxit):
        eta = np.maximum(B @ X.T, -20.0)
        mu = np.exp(eta)
        W = mu / (1.0 + alpha[:, None] * mu)
        z = eta + (Y - mu) / mu
        WX = X[None, :, :] * W[:, :, None]                 # G x n x p
        XtWX = np.einsum('gni,nj->gij', WX, X)
        XtWz = np.einsum('gni,gn->gi', WX, z)
        XtWX += np.eye(p)[None] * 1e-10
        B_new = np.linalg.solve(XtWX, XtWz[:, :, None])[:, :, 0]
        done = np.max(np.abs(B_new - B) / (1.0 + np.abs(B))) < tol
        B = B_new
        if done:
            break
    eta = np.maximum(B @ X.T, -20.0)
    mu = np.exp(eta)
    W = mu / (1.0 + alpha[:, None] * mu)
    XtWX = np.einsum('gni,nj->gij', X[None, :, :] * W[:, :, None], X) + np.eye(p)[None] * 1e-10
    return B, mu, np.linalg.inv(XtWX)

def estimate_dispersion(Y, mu, p, prior_df=5.0):
    """Method-of-moments dispersion per gene, shrunk toward a robust common
    value estimated from well-expressed genes only (sparse genes inflate the
    pooled MoM, so they are excluded from the common estimate)."""
    G, n = Y.shape
    num = ((Y - mu) ** 2).sum(axis=1) - (n - p) / n * mu.sum(axis=1)
    den = (mu ** 2).sum(axis=1)
    alpha_raw = np.maximum(num / np.maximum(den, 1e-12), 1e-8)
    bm = Y.mean(axis=1)
    informative = bm > 50.0
    alpha_common = float(np.median(alpha_raw[informative])) if informative.sum() > 100 else float(np.median(alpha_raw))
    alpha_common = max(alpha_common, 1e-4)
    df = n - p
    alpha_shrunk = (df * alpha_raw + prior_df * alpha_common) / (df + prior_df)
    return np.maximum(alpha_shrunk, 1e-8), alpha_common

def bh(pvals):
    p = np.asarray(pvals, float)
    valid = ~np.isnan(p)
    q = np.ones_like(p)
    pv = p[valid]; m = len(pv)
    order = np.argsort(pv)
    ranked = pv[order] * m / (np.arange(m) + 1)
    ranked = np.minimum.accumulate(ranked[::-1])[::-1]
    out = np.empty(m)
    out[order] = np.minimum(ranked, 1.0)
    q[valid] = out
    return q

# ------------------------------------------------------------ run per tissue
results = {}
for tissue, d in tissue_cols.items():
    ctrl = col_to_np(d['Control']); bad = col_to_np(d['bad_responder']); good = col_to_np(d['good_responder'])
    Y = np.hstack([ctrl, bad, good])                                    # genes x 30
    n = Y.shape[1]
    # cell-means coding: cols = [control, bad, good]; contrast = b_bad - b_control
    X = np.zeros((n, 3)); X[0:10, 0] = 1.0; X[10:20, 1] = 1.0; X[20:30, 2] = 1.0
    B0, mu0, _ = irls_nb(Y, X, np.full(Y.shape[0], 1e-8))               # init fit
    alpha, alpha_common = estimate_dispersion(Y, mu0, 3)
    B, mu, cov = irls_nb(Y, X, alpha)                                   # final NB fit
    L = np.array([-1.0, 1.0, 0.0])                                      # bad - control
    lfc = B @ L
    var = np.einsum('i,gij,j->g', L, cov, L)
    se = np.sqrt(np.maximum(var, 1e-18))
    pval = 2.0 * norm.sf(np.abs(lfc / se))
    baseMean = np.hstack([ctrl, bad]).mean(axis=1)                      # mean over the 20 contrast samples
    pval = np.where(baseMean > 0, pval, np.nan)                         # untestable all-zero genes
    padj = bh(pval)
    # sensitivity: BH computed within the baseMean>10 gene set only
    sel10 = baseMean > 10
    padj_10 = np.full_like(padj, np.nan)
    padj_10[sel10] = bh(pval[sel10])
    results[tissue] = dict(baseMean=baseMean, lfc=lfc, pval=pval, padj=padj, padj10=padj_10,
                           alpha=alpha, alpha_common=alpha_common)
    results[tissue]['sig_up'] = (baseMean > 10) & (lfc > 0.5) & (padj < 0.05)
    results[tissue]['sig_abs'] = (baseMean > 10) & (np.abs(lfc) > 0.5) & (padj < 0.05)
    results[tissue]['sig_up_10'] = (baseMean > 10) & (lfc > 0.5) & (padj_10 < 0.05)
    results[tissue]['sig_abs_10'] = (baseMean > 10) & (np.abs(lfc) > 0.5) & (padj_10 < 0.05)
    print(f'{tissue}: common disp={alpha_common:.4f}, median tagwise disp={np.median(alpha):.3f}, '
          f'sig(lfc>0.5)={int(results[tissue]["sig_up"].sum())}, '
          f'sig(|lfc|>0.5)={int(results[tissue]["sig_abs"].sum())}', flush=True)

# ------------------------------------------------- embedded block validation
def corr(a, b):
    m = ~np.isnan(a) & ~np.isnan(b)
    a, b = a[m], b[m]
    return float(np.corrcoef(a, b)[0, 1]) if a.std() > 0 and b.std() > 0 else np.nan

print('\nBlock-mapping validation (Pearson r: my bad-vs-control log2FC vs each embedded block):')
mapping = {}
for tissue in tissue_cols:
    my = results[tissue]['lfc']
    scores = sorted(((corr(my, emb[k]['lfc']), k) for k in emb), reverse=True)
    mapping[tissue] = scores[0][1]
    print(f'  {tissue}: best = Comparison{scores[0][1]} (r={scores[0][0]:.3f}); '
          f'runner-up Comparison{scores[1][1]} (r={scores[1][0]:.3f})')

print('\nEmbedded DESeq1 bad-vs-control counts (inferred blocks):')
emb_counts = {}
for tissue, blk in mapping.items():
    e = emb[blk]
    bm, l, q = e['baseMean'], e['lfc'], e['padj']
    ok = ~np.isnan(q) & ~np.isnan(l) & ~np.isnan(bm)
    v_abs = ok & (q < 0.05) & (np.abs(l) > 0.5) & (bm > 10)
    v_up = ok & (q < 0.05) & (l > 0.5) & (bm > 10)
    deg2 = int((e['DEG2'] == 'U').sum() + (e['DEG2'] == 'D').sum())
    emb_counts[tissue] = dict(block=blk, DEG2col=deg2, abs=int(v_abs.sum()), up=int(v_up.sum()))
    print(f'  {tissue} (block {blk}): DEG2-column={deg2}, |lfc|>.5={int(v_abs.sum())}, lfc>+.5={int(v_up.sum())}')

# --------------------------------------------------------------- summary
print('\n================ SUMMARY ================')
summary = {}
for variant, key in [('lfc>0.5 (up in bad)', 'sig_up'), ('|lfc|>0.5', 'sig_abs'),
                     ('lfc>0.5, BH within bm>10', 'sig_up_10'), ('|lfc|>0.5, BH within bm>10', 'sig_abs_10')]:
    counts = {t: int(results[t][key].sum()) for t in tissue_cols}
    rank = sorted(counts.items(), key=lambda kv: -kv[1])
    summary[variant] = dict(counts=counts, top=rank[0][0])
    print(f'{variant}: {counts}  -> ranking {rank}  -> TOP: {rank[0][0]}')
print('Embedded DESeq1 bad-vs-control (DEG2 col):',
      {t: emb_counts[t]['DEG2col'] for t in tissue_cols})

# overlap of my significant gene sets with the embedded DESeq1 DEG sets
print('\nOverlap with embedded DESeq1 significant sets (same filter):')
overlaps = {}
for tissue, blk in mapping.items():
    e = emb[blk]
    ok = ~np.isnan(e['padj']) & ~np.isnan(e['lfc']) & ~np.isnan(e['baseMean'])
    theirs = set(np.array(genes)[ok & (e['padj'] < 0.05) & (np.abs(e['lfc']) > 0.5) & (e['baseMean'] > 10)])
    mine = set(np.array(genes)[results[tissue]['sig_abs']])
    inter = len(mine & theirs)
    overlaps[tissue] = dict(mine=len(mine), theirs=len(theirs), overlap=inter,
                            jaccard=round(inter / len(mine | theirs), 3) if mine | theirs else None)
    print(f'  {tissue}: mine={len(mine)}, paper-set={len(theirs)}, overlap={inter}, '
          f'jaccard={overlaps[tissue]["jaccard"]}')

# CSV of significant genes for the top tissue (|lfc| variant)
top = max(tissue_cols, key=lambda t: int(results[t]['sig_abs'].sum()))
order = np.where(results[top]['sig_abs'])[0][np.argsort(results[top]['padj'][results[top]['sig_abs']])]
with open(f'out/significant_genes_{top}.csv', 'w') as f:
    f.write('GeneID,baseMean,log2FC(bad-vs-control),padj\n')
    for i in order:
        f.write(f'{genes[i]},{results[top]["baseMean"][i]:.2f},{results[top]["lfc"][i]:.4f},'
                f'{results[top]["padj"][i]:.3g}\n')
print(f'\nWrote out/significant_genes_{top}.csv ({len(order)} genes)')

out = {}
for t in tissue_cols:
    r = results[t]
    out[t] = {'baseMean': r['baseMean'].tolist(), 'lfc': r['lfc'].tolist(),
              'padj': r['padj'].tolist(),
              'sig_up': int(r['sig_up'].sum()), 'sig_abs': int(r['sig_abs'].sum())}
out['embedded_crosscheck'] = emb_counts
out['block_mapping'] = mapping
out['summary'] = summary
out['overlaps'] = overlaps
with open('out/results.json', 'w') as f:
    json.dump(out, f)
np.savez_compressed('out/full_results.npz',
                    **{f'{t}__{k}': v for t in tissue_cols for k, v in results[t].items()})
print('\nSaved out/results.json and out/full_results.npz')
