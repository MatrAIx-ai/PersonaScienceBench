"""Full solution: detect the century in which Diversity of Pottery Form collapses
while Diversity of Pottery Decoration simultaneously increases.

Method (approved plan, refined after first execution):
1. Load time_series_data.csv; extract century-mark z-series for PotteryForm /
   PotteryDecoration (raw columns, 100-year bins; _inter at the same marks verified equal).
2. Compute per-century changes (diff) and z-score the changes across each series.
3. Collapse century = Form DECLINE EVENT: z-scored change z_dForm <= -1 (level-based
   flagging alone is rejected: it would mislabel the post-collapse plateau 1600-500 BCE
   as 'collapse' even though Form is unchanged there).
   Increase century = Decoration RISE EVENT: z_dDecor >= +1.
4. Require coincidence of both events within the same century bin; rank coincidences
   by combined event magnitude.
5. Cross-check the winner against (a) the annual interpolated series and
   (b) capital.csv ZKeform/Zkeverz.
"""
import pandas as pd
import numpy as np

# ---------- 1. Load ----------
ts = pd.read_csv('data/time_series_data.csv', index_col=0)
cap = pd.read_csv('data/capital.csv', decimal=',')

raw = ts[ts.PotteryForm.notna()][['CE', 'PotteryForm', 'PotteryDecoration']].copy()
raw['BCE'] = (-raw.CE.astype(int))
raw = raw.sort_values('CE').reset_index(drop=True)   # oldest -> youngest

marks = raw.CE.values
same_form = np.allclose(ts.loc[ts.CE.isin(marks)].sort_values('CE').PotteryForm_inter.values, raw.PotteryForm.values, atol=1e-9)
same_decor = np.allclose(ts.loc[ts.CE.isin(marks)].sort_values('CE').PotteryDecoration_inter.values, raw.PotteryDecoration.values, atol=1e-9)
print("Century-mark raw == _inter (Form, Decor):", same_form, same_decor)

# ---------- 2. Changes + z-scores ----------
raw['dForm'] = raw.PotteryForm.diff()
raw['dDecor'] = raw.PotteryDecoration.diff()
raw['z_dForm'] = (raw.dForm - raw.dForm.mean()) / raw.dForm.std(ddof=0)
raw['z_dDecor'] = (raw.dDecor - raw.dDecor.mean()) / raw.dDecor.std(ddof=0)

# ---------- 3./4. Events + coincidence ----------
collapse = raw[raw.z_dForm <= -1]
increase = raw[raw.z_dDecor >= 1]
coincident = sorted(set(collapse.BCE) & set(increase.BCE))
print("\nCollapse (decline-event) centuries BCE:", [int(b) for b in collapse.BCE])
print("Increase (rise-event) centuries BCE:  ", [int(b) for b in increase.BCE])
print("Coincident centuries BCE:", [int(b) for b in coincident])

raw['event_score'] = (-raw.z_dForm) + raw.z_dDecor
winner = int(raw[raw.BCE.isin(coincident)].sort_values('event_score', ascending=False).BCE.iloc[0])
row = raw[raw.BCE == winner].iloc[0]
prev = raw[raw.BCE == winner + 100].iloc[0]
print(f"\nWINNER: {winner} BCE (18th century BCE, 1800-1701 BCE convention)")
print(f"  Form:        {prev.PotteryForm:+.2f} -> {row.PotteryForm:+.2f}  (change {row.dForm:+.2f}, z={row.z_dForm:+.2f})")
print(f"  Decoration:  {prev.PotteryDecoration:+.2f} -> {row.PotteryDecoration:+.2f}  (change {row.dDecor:+.2f}, z={row.z_dDecor:+.2f})")

# ---------- 5a. Cross-check: annual interpolated series ----------
tsi = ts[['CE', 'PotteryForm_inter', 'PotteryDecoration_inter']].copy()
tsi['BCE'] = -tsi.CE.astype(int)
w = tsi[tsi.BCE == winner]
pre = tsi[(tsi.BCE > winner) & (tsi.BCE <= winner + 100)]    # older century
post = tsi[(tsi.BCE >= winner - 100) & (tsi.BCE < winner)]   # younger century
print(f"\nAnnual _inter around {winner} BCE:")
print(f"  Form_inter:  mean {winner+100}-{winner} BCE = {pre.PotteryForm_inter.mean():.2f}; "
      f"within {winner} BCE century = {w.PotteryForm_inter.mean():.2f}; {winner}-{winner-100} BCE = {post.PotteryForm_inter.mean():.2f}")
print(f"  Decor_inter: mean {winner+100}-{winner} BCE = {pre.PotteryDecoration_inter.mean():.2f}; "
      f"within {winner} BCE century = {w.PotteryDecoration_inter.mean():.2f}; {winner}-{winner-100} BCE = {post.PotteryDecoration_inter.mean():.2f}")

# ---------- 5b. Cross-check: capital.csv ----------
cj = cap.set_index('BCE')
ckf, ckv = cj.loc[winner, 'ZKeform'], cj.loc[winner, 'Zkeverz']
match = abs(ckf - row.PotteryForm) < 1e-9 and abs(ckv - row.PotteryDecoration) < 1e-9
print(f"\ncapital.csv at BCE {winner}: ZKeform={ckf:.2f} Zkeverz={ckv:.2f} -> identical to ts: {match}")
print(f"capital.csv at BCE {winner+100}: ZKeform={cj.loc[winner+100,'ZKeform']:.2f} Zkeverz={cj.loc[winner+100,'Zkeverz']:.2f}")
print("NOTE: capital.csv rows BCE 4300/4200 duplicate the CE -500 values and lie outside the "
      "time_series_data range; they are excluded from the signal (data-quality flag only).")

# ---------- Auditable window table (BCE 2000..1200) ----------
win = raw[(raw.BCE <= 2000) & (raw.BCE >= 1200)]
print("\nAuditable century window BCE 2000..1200 (youngest at bottom):")
print(win[['BCE', 'PotteryForm', 'dForm', 'z_dForm', 'PotteryDecoration', 'dDecor', 'z_dDecor']]
      .sort_values('BCE', ascending=False).round(2).to_string(index=False))
