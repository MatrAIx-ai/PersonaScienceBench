"""Initial inspection only (no full solution): ranges, counts, alignment, missingness."""
import pandas as pd

ts = pd.read_csv('data/time_series_data.csv', index_col=0)
cap = pd.read_csv('data/capital.csv', decimal=',')
pol = pd.read_csv('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv', index_col=0, decimal=',')

print("TS shape", ts.shape, "| CE", ts.CE.min(), "..", ts.CE.max(), "| calBP", ts.calBP.min(), "..", ts.calBP.max())
print("CE step:", ts.CE.diff().value_counts().to_dict())
for c in ['PotteryForm', 'PotteryForm_inter', 'PotteryDecoration', 'PotteryDecoration_inter']:
    nn = ts[c].dropna()
    print(f"{c}: n={len(nn)} missing={ts[c].isna().sum()} CE of non-null {ts.CE[nn.index].min()}..{ts.CE[nn.index].max()} range [{nn.min():.2f},{nn.max():.2f}]")
print("Missing counts:", {c: int(ts[c].isna().sum()) for c in ts.columns if ts[c].isna().any()})

print("\nCAP shape", cap.shape, "| BCE", cap.BCE.min(), "..", cap.BCE.max(), "| step", cap.BCE.diff().value_counts().to_dict())
print("CAP missing:", {c: int(cap[c].isna().sum()) for c in cap.columns if cap[c].isna().any()})
j = ts[ts.PotteryForm.notna()].set_index('CE')
for b in [4300, 4200, 4000, 3000, 1000, 500]:
    r = cap[cap.BCE == b].iloc[0]
    ce = -b
    if ce in j.index:
        ok = abs(r.ZKeform - j.loc[ce, 'PotteryForm']) < 1e-6 and abs(r.Zkeverz - j.loc[ce, 'PotteryDecoration']) < 1e-6
        print(f"capital BCE {b} vs ts CE {ce}: cap=({r.ZKeform:.2f},{r.Zkeverz:.2f}) ts=({j.loc[ce,'PotteryForm']:.2f},{j.loc[ce,'PotteryDecoration']:.2f}) match={ok}")
    else:
        print(f"capital BCE {b} -> CE {ce}: outside ts range")

print("\nPOLLEN shape", pol.shape, "| calBP", pol.calBP.min(), "..", pol.calBP.max(), "| CE", pol.CE.min(), "..", pol.CE.max())
print("calBP step:", pol.calBP.diff().value_counts().to_dict())
for c in pol.columns[3:]:
    nn = pol[c].notna()
    print(f"{c}: n={nn.sum()} missing={(~nn).sum()} CE of non-null {pol.CE[nn].min()}..{pol.CE[nn].max()}")

# Century-level pottery signal
raw = ts[ts.PotteryForm.notna()][['CE', 'PotteryForm', 'PotteryDecoration']].copy()
raw['BCE'] = -raw.CE
raw['dForm'] = raw.PotteryForm.diff()
raw['dDecor'] = raw.PotteryDecoration.diff()
print("\nLargest Form drops:"); print(raw.sort_values('dForm').head(4)[['BCE','PotteryForm','dForm','PotteryDecoration','dDecor']].to_string(index=False))
print("Largest Decoration rises:"); print(raw.sort_values('dDecor', ascending=False).head(4)[['BCE','PotteryForm','dForm','PotteryDecoration','dDecor']].to_string(index=False))
