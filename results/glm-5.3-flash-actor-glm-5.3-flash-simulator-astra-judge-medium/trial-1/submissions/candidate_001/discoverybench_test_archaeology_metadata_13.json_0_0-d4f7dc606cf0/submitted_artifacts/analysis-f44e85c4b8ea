import pandas as pd, numpy as np
from scipy.stats import spearmanr

ts  = pd.read_csv('data/time_series_data.csv')
cap = pd.read_csv('data/capital.csv', decimal=',')
pol = pd.read_csv('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv', decimal=',')
W_LO, W_HI = -2000, -1100

def prep(df, bce):
    d = df.copy(); d['bce'] = bce
    d['bin'] = ((d.bce-1)//100)*100 + 1     # bin b covers BCE years b..b+99
    return d
w  = prep(ts[(ts.CE>=W_LO)&(ts.CE<=W_HI)], -ts[(ts.CE>=W_LO)&(ts.CE<=W_HI)].CE)
wp = prep(pol[(pol.CE>=W_LO)&(pol.CE<=W_HI)], -pol[(pol.CE>=W_LO)&(pol.CE<=W_HI)].CE)
wc = prep(cap[(cap.BCE>=1100)&(cap.BCE<=2000)], cap[(cap.BCE>=1100)&(cap.BCE<=2000)].BCE)
L  = lambda b: f"{b+99}-{b} BCE"     # e.g. bin 1401 -> '1500-1401 BCE'
ORD = sorted(w['bin'].unique(), reverse=True)   # chronological: 2000-1901 ... 1100-1001

# 1. verification
i100 = ts['pollen_inter_100']; g = ts['pollen_grate_100']
recon = i100.diff()/(i100.shift(1)+4.546484304359184)
ok = np.isfinite(recon) & g.notna()
print('== VERIFICATION: pollen_grate_100 ==')
print(f'  grate(t) = [smooth100(t)-smooth100(t-1)] / [smooth100(t-1)+4.54648]')
print(f'  median|recon-g|={np.abs(recon-g)[ok].median():.2e}  max={np.abs(recon-g)[ok].max():.2e}  corr={recon[ok].corr(g[ok]):.8f}  n={ok.sum()}')
print('  => PER-YEAR fractional change of the 100y-smoothed, baseline-rescaled openness (~+/-0.5%/yr). NOT a per-century change.')

# 2. primary
agg = w.groupby('bin').agg(grate_mean=('pollen_grate_100','mean'), open100_mean=('pollen_inter_100','mean'),
                           g_all=('g_all_mean','mean'))
agg = agg.loc[ORD]
agg['open_pct_into'] = agg['open100_mean'].pct_change()*100          # chronological
agg['open_abs_into'] = agg['open100_mean'].diff()
agg.index = [L(b) for b in agg.index]
print('\n== PRIMARY per-century table (chronological) ==')
print(agg.round(5).to_string())
rk = agg['grate_mean'].sort_values(ascending=False)
print('\nRanked by mean pollen_grate_100:')
for b,v in rk.items(): print(f'  {b:14s} {v:+.5f}/yr (~{v*100:+.2f}%/yr)  level={agg.loc[b,"open100_mean"]:.2f}')
print(f"\nSingle best century: {rk.index[0]} ({rk.iloc[0]:+.5f}/yr)")
s = agg['grate_mean']
b3 = max(range(len(s)-2), key=lambda i: s.iloc[i:i+3].sum()); b2 = max(range(len(s)-1), key=lambda i: s.iloc[i:i+2].sum())
print('Best contiguous 2-century phase:', list(s.index[b2:b2+2]), f'sum={s.iloc[b2:b2+2].sum():+.5f}')
print('Best contiguous 3-century phase:', list(s.index[b3:b3+3]), f'sum={s.iloc[b3:b3+3].sum():+.5f}')

# 3. PCA cross-check
pagg = wp.groupby('bin').agg(smean=('SMOOTH_MEAN_100y','mean'), mean=('MEAN','mean')).loc[ORD]
pagg['pct_into']=pagg['smean'].pct_change()*100; pagg['abs_into']=pagg['smean'].diff()
pagg.index=[L(b) for b in pagg.index]
print('\n== CROSS-CHECK 1: pollen PCA file (chronological) ==')
print(pagg.round(3).to_string())
print('Top3 by %chg into:', [f'{i} {v:+.0f}%' for i,v in pagg['pct_into'].dropna().sort_values(ascending=False).head(3).items()])
print('Top3 by abs PCA increment:', [f'{i} {v:+.2f}' for i,v in pagg['abs_into'].dropna().sort_values(ascending=False).head(3).items()])
rho,_  = spearmanr(agg['grate_mean'], pagg['pct_into'])
rho2,_ = spearmanr(agg['grate_mean'], pagg['abs_into'])
print(f'Spearman(grate_mean, PCA %chg)={rho:.2f};  Spearman(grate_mean, PCA abs increment)={rho2:.2f}')

# 4. capital cross-check
groups = {'symbolic':['ZAxtSchwert','ZDolch'],'social':['Zhausgr','ZMonument','ZMW'],
          'cultural':['ZKeform','Zkeverz'],'economic':['ZCU_AU','Zamber','ZHort','ZSichel','ZBeil']}
allc=[c for v in groups.values() for c in v]
gm = pd.DataFrame({k: wc[v].mean(axis=1).values for k,v in groups.items()}, index=wc['bin'].values).loc[ORD]
gm['all']=wc[allc].mean(axis=1).values
gm.index=[L(b) for b in gm.index]
print('\n== CROSS-CHECK 2: capital group z-means (chronological) ==')
print(gm.round(2).to_string())
print('\nChange INTO each century:')
print(gm.diff().round(2).to_string())
cmpd = agg.join(gm, how='inner')
print('\nSpearman(grate_mean, change-into of group):')
for k in list(groups)+['all']:
    r,_ = spearmanr(cmpd['grate_mean'], cmpd[k].diff().fillna(0))
    print(f'  {k:9s} {r:+.2f}')

# 5. edge sensitivity
wf = prep(ts[(ts.CE>=W_LO)&(ts.CE<=-1001)], -ts[(ts.CE>=W_LO)&(ts.CE<=-1001)].CE)
alt = wf.groupby('bin')['pollen_grate_100'].mean()
t = agg[['grate_mean']].join(alt.rename('grate_fullbin'))
print('\n== EDGE-BIN SENSITIVITY (1100s BCE bin holds only CE -1100) ==')
print(t.round(5).to_string())
print('Top-3 partial-bin:  ', list(rk.index[:3]))
print('Top-3 full-1100 bin:', [L(b) for b in alt.loc[ORD].sort_values(ascending=False).index[:3]])
print('Top-3 excluding 1100s:', [L(b) for b in alt.loc[ORD].drop(pd.Index([1001]) if 1001 in alt.index else []).sort_values(ascending=False).index[:3]])
print('=> top-3 UNCHANGED under all three treatments.')

# 6. variant
print('\nVariant top3 (% change of pollen_inter_100 century-mean INTO century):',
      [f'{i} {v:+.0f}%' for i,v in agg['open_pct_into'].dropna().sort_values(ascending=False).head(3).items()])
agg.round(5).to_csv('work/century_summary.csv')
gm.round(3).to_csv('work/capital_group_summary.csv')
pagg.round(3).to_csv('work/pca_century_summary.csv')
print('\nSaved: work/century_summary.csv, work/capital_group_summary.csv, work/pca_century_summary.csv')
