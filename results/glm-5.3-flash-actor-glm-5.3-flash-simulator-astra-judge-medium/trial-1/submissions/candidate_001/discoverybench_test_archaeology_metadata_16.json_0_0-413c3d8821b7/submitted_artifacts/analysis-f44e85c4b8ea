"""
PCA on the forms of capital (capital.csv) in 100-year time slices.
Question: How are the Middle Neolithic (3400-3000 BCE) and Younger Neolithic
(2900-2300 BCE) characterized in terms of PC1?
Method (approved): pooled-fit PCA on all 39 century rows, 12 Z-variables
re-standardized on the pooled table, numpy SVD, global mechanical sign
convention (PC1 oriented so the latest periods OBA+YBA have positive mean
score), century-slice projections, pollen-openness overlay as context.
"""
import numpy as np, pandas as pd

pd.set_option("display.width", 250)
np.set_printoptions(precision=3, suppress=True)

# ---------- load ----------
cap = pd.read_csv("data/capital.csv", decimal=",")
cap = cap.drop(columns=["group", "color"])           # metadata dropped after load
ZCOLS = [c for c in cap.columns if c.startswith("Z")]
assert len(ZCOLS) == 12 and cap[ZCOLS].isna().sum().sum() == 0

# ---------- pooled re-standardization ----------
mu = cap[ZCOLS].mean()
sd = cap[ZCOLS].std(ddof=0)
X = ((cap[ZCOLS] - mu) / sd).to_numpy()
print("Pooled means (raw Z):"); print(mu.round(3).to_string())
print("Pooled stds  (raw Z):"); print(sd.round(3).to_string())

# ---------- PCA via SVD ----------
Xc = X - X.mean(axis=0)
U, S, Vt = np.linalg.svd(Xc, full_matrices=False)
eig = S**2 / (len(Xc) - 1)                # eigenvalues of covariance matrix
expl = eig / eig.sum()
scores_all = Xc @ Vt.T                    # PC scores per row
loadings = pd.DataFrame(Vt.T[:, :4], index=ZCOLS,
                        columns=[f"PC{i+1}" for i in range(4)])
print("\nEigenvalues / variance explained (first 6):")
for i in range(6):
    print(f"  PC{i+1}: eig={eig[i]:.3f}  explained={expl[i]*100:.1f}%")
print("Ratio PC2/PC1 eigenvalues: %.3f  (near 1 => degenerate axis)" % (eig[1]/eig[1-0]))
print("Ratio PC2/PC1 = %.3f, PC3/PC2 = %.3f" % (eig[1]/eig[0], eig[2]/eig[1]))

# ---------- mechanical sign convention ----------
bce = cap["BCE"].to_numpy()
latest = bce <= 1600                       # OBA+YBA rows (latest periods)
flip = -1 if scores_all[latest, 0].mean() < 0 else 1
scores_all[:, 0] *= flip
loadings *= flip
print("\nSign convention: PC1 flipped by %+d so mean PC1 of latest-period rows "
      "(BCE<=1600, OBA+YBA) is positive (mean=%.3f)" % (flip, scores_all[latest,0].mean()))
print("\nLoadings (PC1-PC4):"); print(loadings.round(3).to_string())

cap["PC1"] = scores_all[:, 0]
cap["PC2"] = scores_all[:, 1]

# ---------- period windows ----------
MN = cap[(cap.BCE >= 3000) & (cap.BCE <= 3400)]      # 5 slices
YN = cap[(cap.BCE >= 2300) & (cap.BCE <= 2900)]      # 7 slices
print("\n=== Full century PC1 trajectory (BCE descending) ===")
print(cap[["BCE","PC1","PC2"]].round(3).to_string(index=False))

def trend(w, name):
    w = w.sort_values("BCE", ascending=False)   # oldest -> youngest
    print(f"\n{name}: n={len(w)}  start({w.BCE.iloc[0]} BCE)={w.PC1.iloc[0]:.3f} "
          f"end({w.BCE.iloc[-1]} BCE)={w.PC1.iloc[-1]:.3f}  "
          f"delta={w.PC1.iloc[-1]-w.PC1.iloc[0]:+.3f}  mean={w.PC1.mean():.3f}  "
          f"min={w.PC1.min():.3f} max={w.PC1.max():.3f}")
trend(MN, "Middle Neolithic 3400-3000 BCE")
trend(YN, "Younger Neolithic 2900-2300 BCE")

# ---------- stability: leave-one-out loading correlation on PC1 ----------
print("\nLeave-one-out stability of PC1 loadings (corr with full-sample PC1):")
cors = []
for i in range(len(Xc)):
    Xs = np.delete(Xc, i, axis=0)
    _, _, V = np.linalg.svd(Xs, full_matrices=False)
    v = V[0] * flip
    v *= np.sign(np.dot(v, Vt[0]*flip) or 1)   # align sign
    c = np.corrcoef(v, Vt[0]*flip)[0,1]
    cors.append(c)
print("  min=%.3f  mean=%.3f" % (min(cors), np.mean(cors)))

# ---------- pollen openness overlay ----------
pol = pd.read_csv("data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv", decimal=",")
pol["BCE"] = -pol["CE"]
def overlay(w, name):
    sub = pol[(pol.BCE >= w.BCE.min()) & (pol.BCE <= w.BCE.max())]
    m = sub.groupby("BCE")[["MEAN","SMOOTH_MEAN_100y"]].mean().reset_index()
    m.columns = ["BCE","pollen_MEAN","pollen_SMOOTH100"]
    print(f"\n{name} pollen openness overlay:")
    print(m.round(3).to_string(index=False))
    print("  pollen_MEAN start->end: %.2f -> %.2f (delta %+.2f)" %
          (m.pollen_MEAN.iloc[0], m.pollen_MEAN.iloc[-1],
           m.pollen_MEAN.iloc[-1]-m.pollen_MEAN.iloc[0]))
overlay(MN, "MN 3400-3000")
overlay(YN, "YN 2900-2300")

# correlation of PC1 with pollen MEAN over the two windows combined
both = pd.concat([MN, YN])
pv = pol.groupby("BCE")[["MEAN"]].mean()
both2 = both.merge(pv, left_on="BCE", right_index=True, how="left")
print("\nPearson r (PC1 vs pollen MEAN) across the 12 MN+YN slices: %.3f"
      % both2[["PC1","MEAN"]].corr().iloc[0,1])
pm = pol.groupby("BCE")[["MEAN","SMOOTH_MEAN_100y"]].mean()
full = cap.merge(pm, left_on="BCE", right_index=True, how="left")
print("Pearson r (PC1 vs pollen MEAN) full 39 rows: %.3f"
      % full[["PC1","MEAN"]].corr().iloc[0,1])

# ---------- save outputs ----------
cap[["BCE","PC1","PC2"]].round(4).to_csv("output/pc_scores.csv", index=False)
loadings.round(4).to_csv("output/pc_loadings.csv")
