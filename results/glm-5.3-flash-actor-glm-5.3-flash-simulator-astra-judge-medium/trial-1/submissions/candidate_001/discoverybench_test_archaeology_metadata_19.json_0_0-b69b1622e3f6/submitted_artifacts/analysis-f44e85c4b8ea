"""
PCA on 'forms of capital' indicators in 100-year time slices (capital.csv).
Question: PC1 at 1100 BCE vs PC1 at 1000-500 BCE (Younger Bronze Age).
PCA via eigendecomposition of the correlation matrix (sklearn unavailable; equivalent).
"""
import pandas as pd
import numpy as np

# ---------- Load ----------
cap = pd.read_csv('data/capital.csv', decimal=',').sort_values('BCE', ascending=False).reset_index(drop=True)
VARS = ['ZAxtSchwert','ZDolch','Zhausgr','ZCU_AU','Zamber','ZMonument','ZHort',
        'ZSichel','ZBeil','ZMW','ZKeform','Zkeverz']
X = cap[VARS]

# ---------- Condition 1: variance check ----------
print("=== Variance check (full 39-row table) ===")
v = X.var(ddof=1)
print(v.round(6).to_string())
zero_var = v[v < 1e-10].index.tolist()
print("Excluded (zero/near-zero variance):", zero_var if zero_var else "NONE")
keep = [c for c in VARS if c not in zero_var]

def pca_corr(Zmat, names):
    """PCA via SVD of the standardized data matrix (rank-deficient safe).
    Eigenvalue_i = s_i^2/(n-1); total variance = p (correlation PCA)."""
    n, p = Zmat.shape
    U, s, Vt = np.linalg.svd(Zmat, full_matrices=False)
    eig = s**2 / (n - 1)                      # eigenvalues of correlation matrix
    ncomp = min(n, p)
    scores = U[:, :ncomp] * s[:ncomp]
    loadings = Vt[:ncomp].T * np.sqrt(np.maximum(eig[:ncomp], 0))[None, :]
    evr = eig[:ncomp] / p
    return scores, pd.DataFrame(loadings, index=names), evr

# ---------- Primary PCA: full 39-row table, correlation-matrix equivalent ----------
Z = ((X[keep] - X[keep].mean()) / X[keep].std(ddof=1)).values
scores, loadings, evr = pca_corr(Z, keep)
scores, loadings = scores[:, 0], loadings[0]

# Sign convention: orient PC1 so loading on ZHort (and ZCU_AU) is positive
# => higher PC1 = more capital (hoards / wealth / prestige goods high)
if loadings['ZHort'] < 0:
    scores, loadings = -scores, -loadings
print(f"\n=== Primary PCA (full 39-row table, {len(keep)} vars, PC1 var explained = {evr[0]:.1%}) ===")
print("Sign convention: PC1 flipped so ZHort loading > 0 (higher PC1 = more capital).")
print("\nPC1 loadings:")
print(loadings.sort_values(ascending=False).round(3).to_string())

out = cap[['BCE','group']].copy(); out['PC1'] = scores
yba = out[out.group=='YBA']
p1100 = yba[yba.BCE==1100].PC1.iloc[0]
later = yba[yba.BCE<=1000].PC1
print("\n=== PC1 by century slice (YBA) ===")
print(yba.round(3).to_string(index=False))
print(f"\nPC1(1100 BCE) = {p1100:.3f}")
print(f"1000-500 BCE: mean = {later.mean():.3f}, min = {later.min():.3f}, max = {later.max():.3f}")
print(f"Difference (1100 minus mean of 1000-500 BCE) = {p1100 - later.mean():+.3f}")
print("1100 vs each later slice: " + ", ".join(
    f"{b}: {p1100 - yba[yba.BCE==b].PC1.iloc[0]:+.3f}" for b in [1000,900,800,700,600,500]))

# ---------- Sensitivity: YBA-only PCA ----------
print("\n=== Sensitivity: YBA-only PCA (rows 1100..500 BCE) ===")
Xy = X.loc[cap.group=='YBA', keep]
vy = Xy.var(ddof=1)
drop_yba = vy[vy < 1e-10].index.tolist()
print("Excluded in YBA-only variant (zero variance within YBA rows):", drop_yba if drop_yba else "NONE")
Xy = Xy[[c for c in keep if c not in drop_yba]]
Zy = ((Xy - Xy.mean()) / Xy.std(ddof=1)).values
sy, ly, evry = pca_corr(Zy, Xy.columns.tolist())
sy, ly = sy[:, 0], ly[0]
if ly['ZHort'] < 0: sy, ly = -sy, -ly
print(f"PC1 var explained = {evry[0]:.1%}; ZHort loading sign fixed positive.")
yba2 = yba.copy(); yba2['PC1_yba_only'] = sy
print(yba2[['BCE','PC1','PC1_yba_only']].round(3).to_string(index=False))
p1100y = yba2[yba2.BCE==1100].PC1_yba_only.iloc[0]
laty = yba2[yba2.BCE<=1000].PC1_yba_only
print(f"YBA-only: PC1(1100) = {p1100y:.3f}; later mean = {laty.mean():.3f}; diff = {p1100y-laty.mean():+.3f}")
print(f"Comparison {'HOLDS (same direction)' if (p1100-later.mean())*(p1100y-laty.mean())>0 else 'FLIPS'} between variants.")

out.to_csv('pc1_by_century.csv', index=False)
loadings.round(4).to_csv('pc1_loadings.csv')
print("\nSaved: pc1_by_century.csv, pc1_loadings.csv")
