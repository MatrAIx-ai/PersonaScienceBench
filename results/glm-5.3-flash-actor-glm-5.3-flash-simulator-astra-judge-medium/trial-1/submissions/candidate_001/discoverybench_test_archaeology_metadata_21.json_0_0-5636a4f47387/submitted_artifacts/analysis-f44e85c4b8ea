"""PCA on forms-of-capital indicators in 100-year time slices (DiscoveryBench archaeology episode).

Primary: capital.csv (39 100-year BCE slices, 12 Z indicators).
Robustness: time_series_data.csv *_inter columns aggregated to the same 100-year bins.
"""
import numpy as np
import pandas as pd

np.set_printoptions(precision=3, suppress=True)
pd.set_option("display.width", 200)

CAP_COLS = {
    "ZAxtSchwert": "HatchetsSwords", "ZDolch": "Daggers", "Zhausgr": "HouseSize",
    "ZCU_AU": "CopperGold", "Zamber": "Amber", "ZMonument": "MonumentCount",
    "ZHort": "Depots", "ZSichel": "Sickles", "ZBeil": "AxesCelts",
    "ZMW": "MonumentSize", "ZKeform": "PotteryForm", "Zkeverz": "PotteryDecoration",
}

def pca_corr(X: pd.DataFrame, label: str):
    """Correlation-based PCA via SVD on standardized columns."""
    Z = (X - X.mean()) / X.std(ddof=0)
    U, S, Vt = np.linalg.svd(Z.values, full_matrices=False)
    eig = S**2 / (len(Z) - 1)
    expl = eig / eig.sum()
    load = pd.DataFrame(Vt[:3].T, index=X.columns, columns=["PC1", "PC2", "PC3"])
    # Reporting-only sign fix: make the dominant all-capital direction positive on PC1
    if load["PC1"].sum() < 0:
        load.iloc[:, 0] *= -1
        U[:, 0] *= -1
    scores = pd.DataFrame(U[:, :3] * S[:3], index=Z.index, columns=["PC1", "PC2", "PC3"])
    print(f"\n===== {label} =====")
    print(f"n observations = {len(Z)}, n variables = {len(Z.columns)}")
    print("Eigenvalues (first 5):", np.round(eig[:5], 3))
    print("Variance explained % (first 5):", np.round(100*expl[:5], 1))
    print("Cumulative PC1+PC2 = %.1f%%" % (100*expl[:2].sum()))
    print("\nLoadings (eigenvector coefficients), reporting sign fixed so PC1 sums positive:")
    print(load.round(3).to_string())
    print("\nCommunalities (PC1^2+PC2^2):")
    print((load[["PC1","PC2"]]**2).sum(axis=1).round(3).to_string())
    return load, expl, eig, scores

# ---------- Primary: capital.csv ----------
cap = pd.read_csv("data/capital.csv", decimal=",")
cap = cap.rename(columns=CAP_COLS).drop(columns=["group", "color"]).set_index("BCE")
print("capital.csv parsed — shape:", cap.shape, "| any NaN:", cap.isna().any().any())
print("\nUnique value rows (deduplicated):")
dup = cap.reset_index().drop_duplicates(subset=CAP_COLS.values()).set_index("BCE")
print("unique rows:", len(dup), "| BCE boundaries:", dup.index.tolist())

load39, expl39, eig39, sc39 = pca_corr(cap, "PRIMARY: capital.csv, all 39 100-year slices")
loadU,  explU,  eigU,  scU  = pca_corr(dup[CAP_COLS.values()], "DEDUPLICATED: unique period-level rows")

print("\n-- Sensitivity: max |loading| difference between 39-slice and deduplicated PCA --")
print((load39 - loadU.reindex(load39.index)).abs().max().round(4).to_string())

# ---------- Robustness: time_series _inter columns in 100-year bins ----------
ts = pd.read_csv("data/time_series_data.csv")
inter_cols = {f"{en}_inter": pretty for en, pretty in [
    ("HatchetSword","HatchetsSwords"),("Dagger","Daggers"),("HouseSize","HouseSize"),
    ("CopperGold","CopperGold"),("Amber","Amber"),("MonumentCount","MonumentCount"),
    ("Depot","Depots"),("Sickle","Sickles"),("AxesCelts","AxesCelts"),
    ("MonumentSize","MonumentSize"),("PotteryForm","PotteryForm"),
    ("PotteryDecoration","PotteryDecoration")] for _ in [0]}
tsb = ts.copy()
tsb["BCE"] = -(tsb["CE"] // 100) * 100          # bin: floor to 100-year BCE slice
agg = tsb.groupby("BCE")[list(inter_cols)].mean().rename(columns=inter_cols)
# keep the same slice range as capital.csv
agg = agg[(agg.index >= 500) & (agg.index <= 4300)]
print("\nRobustness aggregation: bins =", len(agg), "| BCE range:", agg.index.min(), "to", agg.index.max())
loadR, explR, eigR, scR = pca_corr(agg, "ROBUSTNESS: time_series _inter, 100-year bin means")

print("\n-- Robustness vs primary: PC1/PC2 loading correlation --")
for pc in ["PC1", "PC2"]:
    r = np.corrcoef(load39[pc], loadR.loc[load39.index, pc])[0, 1]
    print(f"  {pc}: r = {r:.3f}")

# ---------- Symbolic trio detail ----------
print("\n===== SYMBOLIC TRIO SUMMARY (primary, 39 slices) =====")
trio = ["HatchetsSwords", "Daggers", "HouseSize"]
print(load39.loc[trio].round(3).to_string())
print("\nPC1 sorted loadings (all 12):")
print(load39["PC1"].sort_values(ascending=False).round(3).to_string())
print("\nPC2 sorted loadings (all 12):")
print(load39["PC2"].sort_values(ascending=False).round(3).to_string())

# scores context: where do high-capital vs low-capital slices sit
sc39o = sc39.join(cap.index.to_series().rename("BCE"))
print("\nScores, first and last 3 slices:")
print(sc39o.iloc[[0,1,2,-3,-2,-1]].round(2).to_string())
print("\nCorrelation of PC1 score with BCE:", round(np.corrcoef(sc39o.BCE, sc39o.PC1)[0,1], 3))
print("Correlation of PC2 score with BCE:", round(np.corrcoef(sc39o.BCE, sc39o.PC2)[0,1], 3))
