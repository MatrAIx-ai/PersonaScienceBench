"""Analysis: monuments & axes vs symbolic capital, 3400-3000 BCE."""
import pandas as pd, numpy as np
from scipy.stats import pearsonr, spearmanr

# --- Load ---
cap = pd.read_csv('data/capital.csv', decimal=',')
ts  = pd.read_csv('data/time_series_data.csv', index_col=0)
pol = pd.read_csv('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv',
                  decimal=',', index_col=0)

# --- Window: 3400-3000 BCE, 5 bins (endpoints inclusive) ---
w = cap[(cap.BCE >= 3000) & (cap.BCE <= 3400)].sort_values('BCE', ascending=False)
print("=== Window bins (capital.csv) ===")
print(w[['BCE','group','ZAxtSchwert','ZDolch','Zhausgr','ZMonument','ZBeil','ZMW']].to_string(index=False))

# --- Symbolic capital aggregate ---
sym_cols = ['ZAxtSchwert','ZDolch','Zhausgr']
w = w.assign(SymbolicCapital=w[sym_cols].mean(axis=1))
print("\n=== Symbolic capital (mean of ZAxtSchwert, ZDolch, Zhausgr) ===")
print(w[['BCE','SymbolicCapital']].to_string(index=False))

# --- Pollen openness: average smoothed/interpolated MEAN over each 100-yr bin ---
polw = pol[(pol.CE <= -3000) & (pol.CE >= -3400)]
def bin_mean(ce):
    lo, hi = -ce, -ce + 99          # e.g. BCE 3400 -> CE -3400..-3301
    s = polw[(polw.CE <= -lo) & (polw.CE > -hi)]['SMOOTH_MEAN_100y']
    return s.mean() if len(s) else np.nan
w['PollenOpenness'] = [-bin_mean(b) for b in (-w.BCE)]  # BCE sign fix
# simpler: map directly
w['PollenOpenness'] = [polw[(polw.CE >= -(b)) & (polw.CE < -(b-100))]['SMOOTH_MEAN_100y'].mean()
                       for b in w.BCE]
print("\n=== Pollen openness (SMOOTH_MEAN_100y binned means) ===")
print(w[['BCE','PollenOpenness']].to_string(index=False))

# --- Trends (slope vs time in BCE, positive = rising forward in time) ---
print("\n=== Linear slopes (per 100 yr, forward in time) ===")
t = 3400 - w.BCE.values  # years forward from 3400 BCE (positive = rising forward in time)
for c in sym_cols + ['SymbolicCapital','ZMonument','ZBeil','ZMW','PollenOpenness']:
    slope = np.polyfit(t, w[c].values, 1)[0] * 100
    print(f"{c:16s} {slope:+.3f}")

# --- Correlations (n=5, descriptive only) ---
print("\n=== Pearson & Spearman (n=5, descriptive) ===")
pairs = [('SymbolicCapital','ZMonument'), ('SymbolicCapital','ZBeil'),
         ('Zhausgr','ZMonument'),         ('Zhausgr','ZBeil'),
         ('ZAxtSchwert','ZMonument'),     ('ZAxtSchwert','ZBeil'),
         ('ZDolch','ZMonument'),          ('ZDolch','ZBeil'),
         ('SymbolicCapital','PollenOpenness'),
         ('ZMonument','ZBeil'),           ('PollenOpenness','ZMonument'),
         ('PollenOpenness','ZBeil')]
for a, b in pairs:
    x, y = w[a].values, w[b].values
    r = pearsonr(x, y)[0]; rho = spearmanr(x, y)[0]
    print(f"{a:16s} vs {b:12s}  Pearson r={r:+.3f}   Spearman rho={rho:+.3f}")

# --- Cross-check vs ts interpolated columns ---
tsW = ts[(ts.CE >= -3400) & (ts.CE <= -3000)]
pts = tsW[tsW.CE % 100 == 0]
sym_ts = pts[['HatchetSword','Dagger','HouseSize']].mean(axis=1).values
print("\n=== Cross-check: ts raw 100-yr points vs capital.csv (max abs diff) ===")
print("Symbolic mean diff:", np.max(np.abs(sym_ts - w.SymbolicalCapital.values
      if 'SymbolicalCapital' in w else sym_ts - w['SymbolicCapital'].values)))
for cc, tc in [('ZMonument','MonumentCount'), ('ZBeil','AxesCelts')]:
    print(f"{cc} vs {tc}: max diff = {np.max(np.abs(w[cc].values - pts[tc].values)):.2e}")

# --- Save binned table ---
w[['BCE','group','ZAxtSchwert','ZDolch','Zhausgr','SymbolicCapital',
   'ZMonument','ZBeil','ZMW','PollenOpenness']].to_csv(
    'outputs/window_bins_3400_3000BCE.csv', index=False)
print("\nSaved: outputs/window_bins_3400_3000BCE.csv")
