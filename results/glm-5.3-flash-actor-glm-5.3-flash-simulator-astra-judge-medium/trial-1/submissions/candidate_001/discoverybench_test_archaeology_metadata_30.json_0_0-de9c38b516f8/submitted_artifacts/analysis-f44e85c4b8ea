"""
DiscoveryBench: archaeology/metadata_30
Question: In which century do Diversity in Pottery Decoration and Diversity in
Pottery Form show opposite growth trends for the first time, with Pottery
Decoration increasing significantly and Pottery Form declining simultaneously?

Method (researcher-approved):
  - Chronological-first scan (4300 BCE -> 500 BCE) over the 37 century bins.
  - Century-to-century change: dDec(t) = Dec(t) - Dec(t-100y), dForm likewise.
  - "Significant increase" = dDec >= +0.5 z-units (sensitivity: > 1 SD of the
    series' own historical century-to-century changes). NOTE: this is a stated
    deterministic threshold, NOT a formal statistical test (z-scores, no error model).
  - "Declining" = dForm < 0 (simultaneous).
  - Triangulation: 100-year smoothed derivative of the annual _inter series.
  - Cross-validation against capital.csv century values.
"""
import pandas as pd, numpy as np, json

OUT = {}

# ---------------- Load primary data ----------------
ts = pd.read_csv('data/time_series_data.csv', index_col=0)
cent = ts[ts['PotteryDecoration'].notna()][
    ['CE','calBP','PotteryDecoration','PotteryDecoration_inter','PotteryForm','PotteryForm_inter']
].reset_index(drop=True)
cent['BCE'] = -cent['CE']
cent['dDec']  = cent['PotteryDecoration'].diff()
cent['dForm'] = cent['PotteryForm'].diff()
sd_dec, sd_form = cent['dDec'].std(), cent['dForm'].std()
OUT['n_century_bins'] = int(len(cent))
OUT['CE_range'] = [int(cent.CE.min()), int(cent.CE.max())]
OUT['sd_of_changes'] = {'PotteryDecoration': round(sd_dec,4), 'PotteryForm': round(sd_form,4)}

# ---------------- Century-change scan, both threshold variants ----------------
def scan(dec_thr, form_rule):
    m = (cent.dDec >= dec_thr) & (cent.dForm < 0)
    return cent[m][['CE','BCE','PotteryDecoration','PotteryForm','dDec','dForm']]

thr_main   = scan(0.5, 'dForm<0')                       # main: dDec >= +0.5
thr_sens   = scan(sd_dec, 'dForm<0')                    # sensitivity: dDec > 1 SD (=0.43)
thr_any    = scan(-1e9, 'dForm<0')                      # extreme sensitivity: ANY rise + decline

print("=== Century bins: Pottery Decoration rises AND Pottery Form falls ===")
print("-- threshold dDec >= +0.5 z-units --")
print(thr_main.to_string(index=False))
print(f"-- threshold dDec >= 1 SD of changes ({sd_dec:.3f}) --")
print(thr_first := thr_sens.to_string(index=False))
print("-- extreme sensitivity: ANY Decoration rise + Form decline --")
print(thr_any.to_string(index=False))

first = thr_main.iloc[0]
OUT['first_bin_main_threshold'] = {
    'CE': int(first.CE), 'BCE': int(first.BCE),
    'Dec_before': float(cent.loc[cent.CE==first.CE-100,'PotteryDecoration'].iloc[0]),
    'Dec_at': float(first.PotteryDecoration), 'dDec': float(first.dDec),
    'Form_before': float(cent.loc[cent.CE==first.CE-100,'PotteryForm'].iloc[0]),
    'Form_at': float(first.PotteryForm), 'dForm': float(first.dForm)}
OUT['bins_qualifying_main'] = thr_main[['CE','dDec','dForm']].to_dict('records')
OUT['bins_qualifying_sens'] = thr_sens[['CE','dDec','dForm']].to_dict('records')
OUT['bins_qualifying_any_rise'] = thr_any[['CE','dDec','dForm']].to_dict('records')

# Full table of all century changes for traceability
cent_out = cent[['CE','BCE','PotteryDecoration','PotteryForm','dDec','dForm']].copy()
cent_out.round(3).to_csv('analysis/century_change_table.csv', index=False)
print("\nFull century-change table saved: analysis/century_change_table.csv")

# ---------------- Triangulation: 100y smoothed derivative on annual _inter ----------------
ts2 = ts.sort_values('CE').reset_index(drop=True)
for col in ['PotteryDecoration_inter','PotteryForm_inter']:
    ts2[col+'_d1'] = ts2[col].diff()
    ts2[col+'_d1_100'] = ts2[col+'_d1'].rolling(100, min_periods=1).mean()
ann = ts2.dropna(subset=['PotteryDecoration_inter_d1_100','PotteryForm_inter_d1_100'])
cross = ann[(ann.PotteryDecoration_inter_d1_100 > 0) & (ann.PotteryForm_inter_d1_100 < 0)]
print(f"\n=== Annual smoothed-derivative check (100y rolling mean of year-over-year change) ===")
print("Years where smoothed dDec>0 AND smoothed dForm<0:",
      f"CE {int(cross.CE.min())} .. {int(cross.CE.max())}" if len(cross) else "none")
print(cross.groupby((cross.CE//100*100)).size().to_string())
OUT['annual_smoothed_check'] = {'first_year_CE': int(cross.CE.min()),
                                'first_year_BCE': int(-cross.CE.min()),
                                'last_year_CE': int(cross.CE.max())}
# smoothed derivatives at the candidate bin year
cand = ts2[ts2.CE==-1700]
OUT['smoothed_deriv_at_1700BCE'] = {'dDec_100': float(cand.PotteryDecoration_inter_d1_100.iloc[0]),
                                    'dForm_100': float(cand.PotteryForm_inter_d1_100.iloc[0])}
print(f"Smoothed derivatives at CE -1700: dDec_100={OUT['smoothed_deriv_at_1700BCE']['dDec_100']:.4f}, "
      f"dForm_100={OUT['smoothed_deriv_at_1700BCE']['dForm_100']:.4f}")

# ---------------- Cross-validation with capital.csv ----------------
cap = pd.read_csv('data/capital.csv', decimal=',')
cap = cap.rename(columns={'Zkeverz':'PotteryDecoration','ZKeform':'PotteryForm'})
cap['CE'] = -cap['BCE']
merged = cent.merge(cap[['CE','PotteryDecoration','PotteryForm','group']], on='CE',
                    suffixes=('_ts','_cap'))
mismatch_dec = (merged.PotteryDecoration_ts - merged.PotteryDecoration_cap).abs().max()
mismatch_form = (merged.PotteryForm_ts - merged.PotteryForm_cap).abs().max()
print(f"\n=== capital.csv cross-validation ===")
print(f"Overlapping bins: {len(merged)}; max |diff| Decoration={mismatch_dec:.6f}, Form={mismatch_form:.6f}")
grp = merged[merged.CE.isin([ -1800,-1700])][['CE','group','PotteryDecoration_cap','PotteryForm_cap']]
print(grp.to_string(index=False))
OUT['capital_crossval'] = {'overlap_bins': int(len(merged)),
    'max_abs_diff_Dec': float(mismatch_dec), 'max_abs_diff_Form': float(mismatch_form),
    'group_at_1800BCE': merged.loc[merged.CE==-1800,'group'].iloc[0],
    'group_at_1700BCE': merged.loc[merged.CE==-1700,'group'].iloc[0]}

# ---------------- Century-naming handling ----------------
OUT['century_naming'] = {
    'bin_label': '1700 BCE bin (CE -1700, calBP 3200)',
    'bin_spans': '1700-1601 BCE',
    'conventional_name': '17th century BCE',
    'transition_century': '18th century BCE (1800-1701 BCE, i.e., 1800 BCE -> 1700 BCE bins)'}

print("\n=== RESULT SUMMARY ===")
print(json.dumps(OUT, indent=2, default=str))
json.dump(OUT, open('analysis/result_summary.json','w'), indent=2, default=str)
