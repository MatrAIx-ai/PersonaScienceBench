"""Summed social capital peak century analysis (DiscoveryBench: archaeology/metadata_9).

Steps:
1. Load capital.csv (authoritative century-binned z-scores, comma decimals).
2. Primary sum S(t) = ZCU_AU + Zamber + ZMonument per century; report full series; find peak.
3. Sensitivity variants: ReLU sum, all-12-component sum, min-max normalized sum,
   and 1-year interpolated cross-check from time_series_data.csv.
4. Component deltas into the peak window (peak+2 .. peak-3 BCE vs preceding 5 centuries).
5. Pollen openness context (SMOOTH_MEAN_100y from pollen file) over the same window
   (assumption: higher PC1 = more open landscape).
"""
import pandas as pd
import numpy as np

OUT = "outputs"
CAP = ["ZAxtSchwert","ZDolch","Zhausgr","ZCU_AU","Zamber","ZMonument",
       "ZHort","ZSichel","ZBeil","ZMW","ZKeform","Zkeverz"]
ENGLISH = {"ZAxtSchwert":"HatchetSword","ZDolch":"Dagger","Zhausgr":"HouseSize",
           "ZCU_AU":"CopperGold","Zamber":"Amber","ZMonument":"MonumentCount",
           "ZHort":"Depot","ZSichel":"Sickle","ZBeil":"AxesCelts","ZMW":"MonumentSize",
           "ZKeform":"PotteryForm","Zkeverz":"PotteryDecoration"}

# ---------- 1. Load ----------
cap = pd.read_csv("data/capital.csv", decimal=",")
ts  = pd.read_csv("data/time_series_data.csv")
pol = pd.read_csv("data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv", decimal=",")
cap = cap.sort_values("BCE", ascending=False).reset_index(drop=True)  # oldest -> youngest

# ---------- 2. Primary summed social capital ----------
cap["sum3"] = cap[["ZCU_AU","Zamber","ZMonument"]].sum(axis=1)
peak_bce = int(cap.loc[cap["sum3"].idxmax(), "BCE"])
series = cap[["BCE","group","ZCU_AU","Zamber","ZMonument","sum3"]]
series.to_csv(f"{OUT}/summed_social_capital_by_century.csv", index=False)
print("="*70)
print("FULL SERIES: summed social capital (ZCU_AU+Zamber+ZMonument) by century BCE")
print(series.to_string(index=False))
print(f"\nPEAK century: {peak_bce} BCE (max sum3 = {cap['sum3'].max():.3f}); "
      f"ties at: {sorted(cap.loc[cap['sum3']==cap['sum3'].max(),'BCE'].tolist())} BCE")

# ---------- 3. Sensitivity variants ----------
cap["sum3_relu"]  = cap[["ZCU_AU","Zamber","ZMonument"]].clip(lower=0).sum(axis=1)
cap["sum12"]      = cap[CAP].sum(axis=1)
rng = cap["sum3"].max() - cap["sum3"].min()
cap["sum3_norm"]  = (cap["sum3"] - cap["sum3"].min()) / rng

# 1-year interpolated cross-check from time_series_data.csv
ts = ts.sort_values("CE").reset_index(drop=True)
ts["sum3_inter"] = ts[["CopperGold_inter","Amber_inter","MonumentCount_inter"]].sum(axis=1)
i = ts["sum3_inter"].idxmax()
# century label: value at CE = -c is the century BCE c; the interpolated maximum falls
# inside the plateau between the two identical century nodes
ce_peak = int(ts.loc[i, "CE"])

variant_rows = []
for name, col in [("Primary sum (ZCU_AU+Zamber+ZMonument)","sum3"),
                  ("ReLU sum (negatives clipped to 0)","sum3_relu"),
                  ("All-12-component sum","sum12"),
                  ("Min-max normalized sum","sum3_norm")]:
    b = int(cap.loc[cap[col].idxmax(), "BCE"])
    ties = sorted(cap.loc[cap[col]==cap[col].max(),"BCE"].tolist())
    variant_rows.append({"variant":name,"peak_century_BCE":b,"peak_value":round(float(cap[col].max()),3),
                         "tied_centuries_BCE":str(ties)})
tsmax = -ce_peak if ts.loc[i,"CE"] < 0 else ce_peak
variant_rows.append({"variant":"1-y interpolated sum (time_series_data.csv)",
                     "peak_century_BCE":tsmax,
                     "peak_value":round(float(ts.loc[i,"sum3_inter"]),3),
                     "tied_centuries_BCE":"(interpolated plateau 1400-1300 BCE)"})
variants = pd.DataFrame(variant_rows)
variants.to_csv(f"{OUT}/sensitivity_variants.csv", index=False)
print("\n" + "="*70)
print("SENSITIVITY VARIANTS")
print(variants.to_string(index=False))

# ---------- 4. Component deltas into the peak window ----------
pre   = cap[(cap.BCE > peak_bce) & (cap.BCE <= peak_bce + 500)]   # 5 centuries before peak (older)
peakw = cap[(cap.BCE <= peak_bce) & (cap.BCE >= peak_bce - 200)]  # peak and 2 younger centuries
deltas = pd.DataFrame({
    "component":[ENGLISH[c] for c in CAP],
    "mean_pre_peak_z":[round(pre[c].mean(),3) for c in CAP],
    "mean_peak_window_z":[round(peakw[c].mean(),3) for c in CAP],
})
deltas["delta_z"] = (deltas["mean_peak_window_z"] - deltas["mean_pre_peak_z"]).round(3)
deltas["direction"] = np.where(deltas.delta_z > 0.05, "increase",
                       np.where(deltas.delta_z < -0.05, "decrease", "no change"))
deltas = deltas.sort_values("delta_z", ascending=False)
deltas.to_csv(f"{OUT}/component_deltas_into_peak.csv", index=False)
print("\n" + "="*70)
print(f"COMPONENT DELTAS: peak window = {peak_bce}..{peak_bce-200} BCE vs preceding 5 centuries "
      f"({peak_bce+500}..{peak_bce+100} BCE)")
print(deltas.to_string(index=False))

print("\nRequested social-capital components, century-by-century around the peak:")
focus = cap[(cap.BCE <= peak_bce+300) & (cap.BCE >= peak_bce-300)][
    ["BCE","group","ZCU_AU","Zamber","ZMonument","ZAxtSchwert","ZHort","Zhausgr"]]
focus.columns = ["BCE","group","CopperGold","Amber","MonumentCount","HatchetSword","Depot","HouseSize"]
print(focus.to_string(index=False))

# ---------- 5. Pollen openness context ----------
pol_ce = pol.set_index("CE")
win_ce = range(-(peak_bce+300), -(peak_bce-300)+1)
pol_win = pol_ce.loc[[c for c in win_ce if c in pol_ce.index]]
pol_pre = pol_ce.loc[[c for c in range(-(peak_bce+800), -(peak_bce+300)) if c in pol_ce.index]]
ctx = pd.DataFrame({
    "window":["preceding 8 centuries (2200-1500 BCE)" if peak_bce==1400 else "preceding",
              "peak window (1700-1100 BCE)" if peak_bce==1400 else "peak"],
    "mean_SMOOTH_MEAN_100y":[round(pol_pre.SMOOTH_MEAN_100y.mean(),3),
                             round(pol_win.SMOOTH_MEAN_100y.mean(),3)],
    "mean_MEAN_interpolated":[round(pol_pre.MEAN.mean(),3), round(pol_win.MEAN.mean(),3)],
})
ctx["delta"] = (ctx["mean_SMOOTH_MEAN_100y"].diff()).round(3)
ctx.to_csv(f"{OUT}/pollen_openness_context.csv", index=False)
print("\n" + "="*70)
print("POLLEN OPENNESS CONTEXT (SMOOTH_MEAN_100y; assumption: higher PC1 = more open)")
print(ctx.to_string(index=False))

print("\nPeak-century series and variant table saved to outputs/.")
