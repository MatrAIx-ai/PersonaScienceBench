"""
Prevalence of gardening-introduced non-native plants by habitat type.
Primary data: invaded_niche_pathways.csv (tab-separated plot-level table, Barcelona province).
Supporting context: temporal_trends_contingency_table.csv (Catalonia, temporal pathway trends).
"""
import csv, math
from collections import defaultdict, Counter

def read_tsv(path):
    with open(path, newline='') as f:
        return list(csv.DictReader(f, delimiter='\t'))

plots = read_tsv('data/invaded_niche_pathways.csv')
for r in plots:
    for k in ('n.gard','n.unint','n.agfo','n.total'):
        r[k] = int(r[k])
assert all(r['n.gard']+r['n.unint']+r['n.agfo']==r['n.total'] for r in plots), "count consistency failed"

HAB_ORDER = ['Urban','Coastal','Wetlands','Riparian','Croplands','Meadows','Scrublands',
             'Broad-leaved forests','Coniferous forests','Rock outcrops']

def summarize(rows):
    d = defaultdict(lambda: dict(nplots=0, gard=0, total=0, shares=[], gard_plots=0))
    for r in rows:
        h = r['habitat']; s = d[h]
        s['nplots'] += 1
        s['gard'] += r['n.gard']; s['total'] += r['n.total']
        if r['n.total'] > 0:
            s['shares'].append(r['n.gard']/r['n.total'])
        if r['n.gard'] > 0:
            s['gard_plots'] += 1
    return d

def table(d, incidence_denominator='all'):
    out = []
    for h in HAB_ORDER:
        s = d[h]
        pooled = s['gard']/s['total'] if s['total'] else float('nan')
        mean_share = sum(s['shares'])/len(s['shares']) if s['shares'] else float('nan')
        denom = s['nplots'] if incidence_denominator=='all' else max(len(s['shares']),1)
        incidence = s['gard_plots']/denom
        out.append(dict(habitat=h, n_plots=s['nplots'], plots_with_natives_or_invaded=s['nplots']-sum(1 for _ in []),
                        sum_n_gard=s['gard'], sum_n_total=s['total'],
                        occurrence_share=pooled, mean_plot_share=mean_share,
                        incidence_all_plots=incidence,
                        incidence_invaded_plots=s['gard_plots']/max(len(s['shares']),1)))
    return out

# ---- Main metrics (all 632 plots) ----
main = table(summarize(plots))

# ---- Sensitivity: exclude zero-total (never-invaded) plots ----
sens = table(summarize([r for r in plots if r['n.total']>0]), incidence_denominator='invaded')

def rank(rows, key):
    return [r['habitat'] for r in sorted(rows, key=lambda r: -(r[key] if r[key]==r[key] else -1))]

rank_occ_main = rank(main,'occurrence_share'); rank_occ_sens = rank(sens,'occurrence_share')
rank_inc_main = rank(main,'incidence_all_plots'); rank_inc_sens = rank(sens,'incidence_invaded_plots')

print("=== Ranked table (pooled occurrence share, all plots) ===")
for i,r in enumerate(sorted(main,key=lambda r:-r['occurrence_share']),1):
    print(f"{i:2d} {r['habitat']:22s} plots={r['n_plots']:3d} gard={r['sum_n_gard']:3d} tot={r['sum_n_total']:3d} "
          f"occShare={r['occurrence_share']:.3f} meanPlotShare={r['mean_plot_share']:.3f} incidence={r['incidence_all_plots']:.3f}")

print("\n=== Sensitivity (plots with n.total>0 only) ===")
for i,r in enumerate(sorted(sens,key=lambda r:-r['occurrence_share']),1):
    print(f"{i:2d} {r['habitat']:22s} plots={r['n_plots']:3d} gard={r['sum_n_gard']:3d} tot={r['sum_n_total']:3d} "
          f"occShare={r['occurrence_share']:.3f} meanPlotShare={r['mean_plot_share']:.3f} incidence={r['incidence_invaded_plots']:.3f}")

print("\nrank occurrence_share main :",rank_occ_main)
print("rank occurrence_share sens  :",rank_occ_sens)
print("rank incidence main         :",rank_inc_main)
print("rank incidence sens         :",rank_inc_sens)
# Spearman-like agreement between main/sens rankings
def tau(a,b):
    n=len(a); c=0;t=0
    for i in range(n):
        for j in range(i+1,n):
            di=a.index(b[i])-a.index(b[j]) if False else (a.index(a[i])-a.index(a[j]))-(a.index(b[i])-a.index(b[j]))
            t+=1; c+= (di==0)
    return c/t
print("rank agreement (pairs concordant) occ:",tau(rank_occ_main,rank_occ_sens),
      " incidence:",tau(rank_inc_main,rank_inc_sens))

# ---- Minimal supportive test: chi-square on pooled pathway x habitat table ----
obs=[]; labels=[]
for h in HAB_ORDER:
    s=summarize(plots)[h]
    row=[s['gard'], s['total']-s['gard']]
    if sum(row)>0: obs.append(row); labels.append(h)
tot=[sum(c) for c in zip(*obs)]
def chisq(mat):
    rs=[sum(r) for r in mat]; cs=[sum(c) for c in zip(*mat)]; N=sum(rs)
    x=0.0
    for i,r in enumerate(mat):
        for j,v in enumerate(r):
            e=rs[i]*cs[j]/N
            x+=(v-e)**2/e
    # df and p-value via survival chi2 sf using regularized upper incomplete gamma
    df=(len(mat)-1)*(len(mat[0])-1)
    return x, df
x,df = chisq(obs)
try:
    from scipy.stats import chi2, chi2_contingency
    st,p,dof,exp = chi2_contingency(obs)
    print(f"\nChi-square pathway x habitat (10 habitats x gardening/non-gardening): X2={st:.2f}, df={dof}, p={p:.3e}")
    print("min expected count:",exp.min().round(2), "-> caveat if <5")
except ImportError:
    print(f"\nChi-square X2={x:.2f}, df={df} (scipy unavailable; p-value not computed)")

# ---- Temporal context ----
trends = read_tsv('data/temporal_trends_contingency_table.csv')
per=defaultdict(dict)
for r in trends:
    per[r['introduction.period']][r['pathway']]=int(r['n'])
print("\n=== Temporal context (Catalonia; gardening share of introductions per period) ===")
for period in ['Before 1500','1501-1900','1901-1984','1985-2019']:
    d=per[period]; T=sum(d.values())
    print(f"{period:12s} gard={d['Gardening']:3d}/{T:3d} = {d['Gardening']/T:.2f}")

# ---- Save ranked table artifact ----
with open('outputs/habitat_gardening_prevalence.csv','w',newline='') as f:
    w=csv.DictWriter(f,fieldnames=list(main[0].keys()))
    w.writeheader()
    for r in sorted(main,key=lambda r:-r['occurrence_share']):
        w.writerow({k:(round(v,4) if isinstance(v,float) else v) for k,v in r.items()})
print("\nSaved outputs/habitat_gardening_prevalence.csv")
