"""
Gardening pathway prevalence across habitat types - DiscoveryBench analysis.
Question: In what context does the gardening pathway for introducing non-native
plants show different prevalence styles across habitat types?

Primary data : data/invaded_niche_pathways.csv (632 plots, 10 habitats)
Secondary     : data/temporal_trends_contingency_table.csv (temporal context)
Cross-check   : data/invasion_success_pathways.csv (species-level pathway counts)
Unused        : data/phylogenetic_tree.txt (no plot<->species join key; declared unused)
"""
import numpy as np
import pandas as pd
from scipy import stats
import statsmodels.api as sm
import statsmodels.formula.api as smf

pd.set_option("display.width", 200)

# ---------------------------------------------------------------- load
niche = pd.read_csv("data/invaded_niche_pathways.csv", sep="\t")
temporal = pd.read_csv("data/temporal_trends_contingency_table.csv", sep="\t")
species = pd.read_csv("data/invasion_success_pathways.csv")

print("=" * 80)
print("STEP 0 - integrity checks")
print("=" * 80)
assert (niche[["n.gard", "n.unint", "n.agfo"]].sum(axis=1) == niche["n.total"]).all()
assert niche.isna().sum().sum() == 0
print(f"632 rows x {niche.shape[1]} cols; count identity holds for all rows; 0 NAs")
# patsy-safe column names (dots are invalid in formulas)
niche = niche.rename(columns={c: c.replace(".", "_") for c in niche.columns})
G, U, A, T = "n_gard", "n_unint", "n_agfo", "n_total"
print("plots per habitat:", niche.habitat.value_counts().to_dict())

# ---------------------------------------------------------------- (i) habitat x pathway table
print()
print("=" * 80)
print("STEP i - habitat x pathway prevalence table (the two 'prevalence styles')")
print("=" * 80)

rows = []
for h, g in niche.groupby("habitat"):
    n_plots = len(g)
    rows.append({
        "habitat": h,
        "n_plots": n_plots,
        "pct_plots_gardening": 100 * (g[G] > 0).mean(),      # style A: incidence
        "mean_n_gard": g[G].mean(),                          # style A': abundance
        "share_gardening": 100 * g[G].sum() / g[T].sum(),   # style B
        "share_unintentional": 100 * g[U].sum() / g[T].sum(),
        "share_agfo": 100 * g[A].sum() / g[T].sum(),
        "pct_plots_any_nonnative": 100 * (g[T] > 0).mean(),
        "sum_n_gard": g[G].sum(),
        "sum_n_total": g[T].sum(),
    })
def wilson(k, n, z=1.96):
    p = k / n
    d = 1 + z**2 / n
    c = (p + z**2/(2*n)) / d
    h = z*np.sqrt(p*(1-p)/n + z**2/(4*n**2)) / d
    return 100*max(0, c-h), 100*min(1, c+h)

tab = pd.DataFrame(rows)
tab[["gard_ci_lo", "gard_ci_hi"]] = [
    list(wilson(round(r.pct_plots_gardening/100*r.n_plots), r.n_plots))
    for r in tab.itertuples()]
tab = tab.sort_values("pct_plots_gardening", ascending=False)
print(tab.round(2).to_string(index=False))
tab.round(2).to_csv("habitat_gardening_prevalence_table.csv", index=False)
print("\n95% Wilson CIs on gardening incidence (%) computed for all habitats")

# ---------------------------------------------------------------- (ii) among-habitat tests
print()
print("=" * 80)
print("STEP ii - among-habitat tests of gardening incidence + count model")
print("=" * 80)

ct = pd.crosstab(niche.habitat, niche[G] > 0)
chi2, p_chi, dof, exp = stats.chi2_contingency(ct)
print(f"chi2 contingency (incidence x habitat): chi2={chi2:.2f}, dof={dof}, p={p_chi:.2e}")
print("min expected cell count:", round(exp.min(), 2), "(>5 required for asymptotic chi2)")
# sparse cells -> permutation Monte-Carlo on the binary incidence vector
labels = niche.habitat.to_numpy()
inc = (niche[G] > 0).astype(int).to_numpy()
obs_var = np.var([inc[labels == h].mean() for h in np.unique(labels)])
rng = np.random.default_rng(42)
B = 100_000
perm_stats = np.empty(B)
for b in range(B):
    p = rng.permutation(inc)
    m = [p[labels == h].mean() for h in np.unique(labels)]
    perm_stats[b] = np.var(m)
p_perm = (np.sum(perm_stats >= obs_var - 1e-12) + 1) / (B + 1)
print(f"Monte-Carlo permutation test (B={B}, var-of-habitat-means statistic): p={p_perm:.5f}")

# count model: Poisson with robust SE, then negative binomial
niche["gard_any"] = (niche[G] > 0).astype(int)
pois = smf.glm("n_gard ~ C(habitat)", data=niche,
               family=sm.families.Poisson()).fit(cov_type="HC1")
print("\nPoisson GLM for n.gard ~ habitat (robust SE):")
print(pois.summary().tables[1].as_text()[:2000])
lr_pois = smf.glm("n_gard ~ C(habitat)", data=niche,
                  family=sm.families.Poisson()).fit()
nb = smf.glm("n_gard ~ C(habitat)", data=niche,
             family=sm.families.NegativeBinomial(alpha=1.0)).fit(cov_type="HC1")
print("\nNegative-binomial GLM (alpha=1) habitat-only deviance:", round(nb.deviance,1))
print(f"Poisson residual deviance = {lr_pois.deviance:.1f} (LR test vs intercept-only p = {stats.chi2.sf(2*(lr_pois.llf - lr_pois.llnull), 9):.2e}); overdispersion = {lr_pois.pearson_chi2 / lr_pois.df_resid:.2f}")

# ---------------------------------------------------------------- (iii) covariate / context models
print()
print("=" * 80)
print("STEP iii - context models (elevation, urban/cropland cover, 1956-2009 change)")
print("=" * 80)

cov = ["elevation",
       "urban_2009_50m", "cropland_2009_50m",
       "urban_2009_500m", "cropland_2009_500m",
       "progressive_1956_2009_50m", "regressive_1956_2009_50m", "no_changes_1956_2009_50m"]
print("correlations among covariates:")
print(niche[cov].corr().round(2).to_string())

# logistic: incidence of gardening ~ habitat + covariates
m_ctx = smf.logit("gard_any ~ C(habitat) + elevation + urban_2009_50m + cropland_2009_50m"
                  " + urban_2009_500m + cropland_2009_500m"
                  " + progressive_1956_2009_50m + regressive_1956_2009_50m",
                  data=niche).fit(disp=0)
print("\nLogit gardening-incidence ~ habitat + covariates  (coef / p):")
ctx = pd.DataFrame({"coef": m_ctx.params, "p": m_ctx.pvalues})
print(ctx.round(4).to_string())
print("pseudo R2:", round(1 - m_ctx.llf / m_ctx.llnull, 4))
# NOTE: Rock outcrops = perfect separation (0/57 gardening plots) -> its coefficient (-85.9)
# diverges and its Wald p is meaningless; inference on other levels is unaffected.
print("Rock outcrops gardening plots: 0/57 -> perfect separation; that level's Wald p unreliable")

# habitat-only vs habitat+covariates comparison (does context absorb habitat effect?)
m_hab = smf.logit("gard_any ~ C(habitat)", data=niche).fit(disp=0)
print(f"habitat-only logit: LR test of habitat = chi2 {2*(m_hab.llf-m_hab.llnull):.1f} (df=9), p={stats.chi2.sf(2*(m_hab.llf-m_hab.llnull),9):.2e}")
print(f"habitat+covariates logit: LR test of covariates beyond habitat = chi2 {2*(m_ctx.llf-m_hab.llf):.1f} (df=8), p={stats.chi2.sf(2*(m_ctx.llf-m_hab.llf),8):.2e}")

# reduced model without habitat: pure landscape-context model
m_cov_only = smf.logit("gard_any ~ elevation + urban_2009_50m + cropland_2009_50m"
                       " + urban_2009_500m + cropland_2009_500m"
                       " + progressive_1956_2009_50m + regressive_1956_2009_50m",
                       data=niche).fit(disp=0)
print("\nCovariates-only logit (no habitat term) coef/p:")
print(pd.DataFrame({"coef": m_cov_only.params, "p": m_cov_only.pvalues}).round(4).to_string())
print("pseudo R2:", round(1 - m_cov_only.llf / m_cov_only.llnull, 4))

# does urban context also shift the COMPOSITION (share) toward gardening?
share_tab = tab[["habitat", "share_gardening", "share_unintentional", "share_agfo"]]
print("\nPathway share by habitat (ordered by gardening share):")
print(share_tab.sort_values("share_gardening", ascending=False).round(1).to_string(index=False))

# ---------------------------------------------------------------- secondary context
print()
print("=" * 80)
print("SECONDARY - temporal trends and species-level cross-check")
print("=" * 80)
piv = temporal.pivot_table(index="pathway", columns="introduction.period", values="n")
tot = temporal.groupby("introduction.period")["n"].sum()
share = (100 * piv / tot).round(1)
print("pathway share (%) per period:")
print(share.to_string())
print("\nspecies-level pathway counts (invasion_success_pathways.csv):")
print(species["intro.pathway"].value_counts().to_string(),
      "-> Gardening is most frequent:", int((species["intro.pathway"] == "Gardening").sum()), "/ 81 species")
print("phylogenetic_tree.txt: declared unused (no plot<->species linkage possible).")

print()
print("DONE - key numbers saved to habitat_gardening_prevalence_table.csv")
