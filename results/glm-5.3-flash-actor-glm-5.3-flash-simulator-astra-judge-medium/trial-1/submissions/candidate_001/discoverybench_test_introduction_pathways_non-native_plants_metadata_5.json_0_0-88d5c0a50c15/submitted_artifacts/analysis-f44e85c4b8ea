"""
DiscoveryBench: introduction_pathways_non-native_plants
Question: "In what scenario did urban land use promote a specific type of plant invasion?"

Workflow
  Part 1  Plot-level pathway composition (invaded_niche_pathways.csv, 632 plots)
          - binomial GLMs per pathway (Gardening / Unintentional / AgriForest)
          - urban cover (2009) and urbanization trajectory (progressive/regressive change,
            1956-2009 and 1993-2009 steps), controlling for habitat, elevation, climate, distances
          - scenario contrasts (trajectory x urban groups)
          - buffer-scale comparison (50/500/1000 m)
  Part 2  Species-level (invasion_success_pathways.csv, 81 spp -> dedup to 77)
          - traits by pathway; invasion success (number.of.invaded.plots) vs pathway+traits
  Part 3  Temporal context (contingency table)
"""
import numpy as np, pandas as pd, statsmodels.api as sm, statsmodels.formula.api as smf
from scipy import stats
import json, warnings
warnings.filterwarnings('ignore')

OUT = {}

# ---------------------------------------------------------------- Part 3: temporal
tt = pd.read_csv('data/temporal_trends_contingency_table.csv', sep='\t')
tt['prop'] = tt.groupby('introduction.period')['n'].transform(lambda x: x/x.sum())
OUT['temporal_counts'] = tt.pivot(index='introduction.period', columns='pathway', values='n').to_dict('index')
OUT['temporal_props']  = tt.pivot(index='introduction.period', columns='pathway', values='prop').round(3).to_dict('index')
ct = tt.pivot(index='introduction.period', columns='pathway', values='n')
chi2, p, dof, _ = stats.chi2_contingency(ct)
OUT['temporal_chi2'] = {'chi2': round(chi2,1), 'df': dof, 'p': float(p)}

# ---------------------------------------------------------------- Part 1: plot level
pl = pd.read_csv('data/invaded_niche_pathways.csv', sep='\t')
pl.columns = [c.replace('.','_') for c in pl.columns]          # sanitize names
pl['log_stream'] = np.log1p(pl['distance_stream'])
pl['log_road']   = np.log1p(pl['distance_road'])
pl['has_urban']  = (pl['urban_2009_500m'] > 0.05).astype(int)
pl['traj_56']    = np.select(
    [pl['progressive_1956_2009_50m'] >= 0.5, pl['regressive_1956_2009_50m'] >= 0.5],
    ['progressive','regressive'], default='no_change')
pl['traj_93']    = np.select(
    [pl['progressive_1993_2009_50m'] >= 0.5, pl['regressive_1993_2009_50m'] >= 0.5],
    ['progressive','regressive'], default='no_change')
pl['hab'] = pl['habitat'].str.replace(' ','_',regex=False)

CONF = 'C(hab) + elevation + annual_temperature + annual_rainfall + log_stream + log_road'
paths = {'Gardening':'n_gard','Unintentional':'n_unint','AgriForest':'n_agfo'}

def binom_glm(resp, data, formula):
    d = data.loc[data['n_total'] > 0].copy()
    d['succ'] = d[resp]; d['fail'] = d['n_total'] - d[resp]
    return smf.glm('succ + fail ~ ' + formula, data=d, family=sm.families.Binomial()).fit()

# 1a. main models: urban 2009 (500 m) + progressive & regressive trajectory 1956-2009
res_main = {}
for pw, col in paths.items():
    m = binom_glm(col, pl, f'urban_2009_500m + progressive_1956_2009_50m + regressive_1956_2009_50m + {CONF}')
    res_main[pw] = {k: {'coef': round(m.params[k],3), 'p': float(m.pvalues[k])}
                    for k in ['urban_2009_500m','progressive_1956_2009_50m','regressive_1956_2009_50m']}
    res_main[pw]['n_plots'] = int(m.nobs)
OUT['binomial_main_500m'] = res_main

# 1b. buffer-scale comparison: urban_2009 coefficient across scales, per pathway
scales = {}
for pw, col in paths.items():
    scales[pw] = {}
    for b in ['50m','500m','1000m']:
        m = binom_glm(col, pl, f'urban_2009_{b} + {CONF}')
        scales[pw][b] = {'coef': round(m.params[f'urban_2009_{b}'],3),
                         'p': float(m.pvalues[f'urban_2009_{b}']), 'aic': round(m.aic,1)}
OUT['scale_comparison'] = scales

# 1c. scenario contrasts: trajectory category x urban presence
for step in ['56','93']:
    g = pl.groupby(['traj_'+step,'has_urban']).apply(
        lambda d: pd.Series({'n_plots': len(d),
                             'n_total': int(d['n_total'].sum()),
                             'prop_gard': round(d['n_gard'].sum()/max(d['n_total'].sum(),1),3),
                             'prop_unint': round(d['n_unint'].sum()/max(d['n_total'].sum(),1),3),
                             'prop_agfo': round(d['n_agfo'].sum()/max(d['n_total'].sum(),1),3)}),
        include_groups=False)
    OUT[f'scenario_means_{step}'] = g.reset_index().to_dict('records')

# 1d. formal interaction model for Gardening: trajectory factor x urban presence
m1 = binom_glm('n_gard', pl, f'C(traj_56, Treatment("no_change"))*has_urban + {CONF}')
OUT['gardening_interaction_1956_2009'] = {k: {'coef': round(m1.params[k],3), 'p': float(m1.pvalues[k])}
    for k in m1.params.index if 'traj' in k or 'has_urban' in k}
m2 = binom_glm('n_gard', pl, f'C(traj_93, Treatment("no_change"))*has_urban + {CONF}')
OUT['gardening_interaction_1993_2009'] = {k: {'coef': round(m2.params[k],3), 'p': float(m2.pvalues[k])}
    for k in m2.params.index if 'traj' in k or 'has_urban' in k}

# 1e. both temporal steps jointly (which step carries the progressive-urbanization signal)
m3 = binom_glm('n_gard', pl, 'urban_2009_500m + progressive_1956_2009_50m + progressive_1993_2009_50m + ' + CONF)
OUT['gardening_both_steps'] = {k: {'coef': round(m3.params[k],3), 'p': float(m3.pvalues[k])}
    for k in ['urban_2009_500m','progressive_1956_2009_50m','progressive_1993_2009_50m']}

# 1f. habitat-specific Gardening response to urban cover (top habitats with urban plots)
hs = pl[pl['n_total']>0].groupby('hab').apply(
    lambda d: pd.Series({'n_plots': len(d),
                         'urban_2009_500m': round(d['urban_2009_500m'].mean(),3),
                         'n_gard': int(d['n_gard'].sum()),
                         'prop_gard': round(d['n_gard'].sum()/d['n_total'].sum(),3),
                         'n_unint': int(d['n_unint'].sum()),
                         'prop_unint': round(d['n_unint'].sum()/d['n_total'].sum(),3)}),
    include_groups=False).sort_values('prop_gard', ascending=False)
OUT['habitat_composition'] = hs.reset_index().to_dict('records')

# ---------------------------------------------------------------- Part 2: species level
sp = pd.read_csv('data/invasion_success_pathways.csv')
OUT['n_species_raw'] = len(sp)
# documented dedup rule: among duplicated Scientific_name rows keep the one with the
# larger number.of.invaded.plots (ties -> first occurrence)
sp = sp.sort_values(['Scientific_name','number.of.invaded.plots'], ascending=[True,False])
sp_d = sp.drop_duplicates('Scientific_name', keep='first').copy()
OUT['n_species_dedup'] = len(sp_d)

tr = {}
for pw in ['Gardening','Unintentional','AgriForest']:
    d = sp_d[sp_d['intro.pathway']==pw]
    tr[pw] = {'n': len(d),
              'median_mrt': float(d['mrt'].median()),
              'median_invaded_niche_breadth': float(d['invaded.niche.breadth'].median()),
              'median_plots': float(d['number.of.invaded.plots'].median()),
              'mean_height_m': round(float(d['height'].mean()),2),
              'pct_perennial_fg': round((d['growth.form']=='Perennial fg').mean(),2),
              'pct_shrub_tree': round((d['growth.form']=='Shrub/tree').mean(),2),
              'pct_vegetative': round((d['vegetative']=='Yes').mean(),2)}
OUT['traits_by_pathway'] = tr
g = sp_d[sp_d['intro.pathway']=='Gardening']; u = sp_d[sp_d['intro.pathway']=='Unintentional']
for v in ['mrt','invaded.niche.breadth','number.of.invaded.plots']:
    w, p = stats.mannwhitneyu(g[v], u[v])
    OUT.setdefault('wilcoxon_gard_vs_unint', {})[v] = {'U': float(w), 'p': float(p),
        'median_gard': float(g[v].median()), 'median_unint': float(u[v].median())}

# invasion success model: plots ~ Gardening pathway + traits
sp_d['is_gard'] = (sp_d['intro.pathway']=='Gardening').astype(int)
sp_d['log_mrt'] = np.log(sp_d['mrt'])
sp_d['growth3'] = sp_d['growth.form'].str.replace(' ','_',regex=False)
nb = smf.glm('number_of_invaded_plots ~ is_gard + log_mrt + invaded_niche_breadth + habitat_range + C(growth3)',
             data=sp_d.rename(columns={'number.of.invaded.plots':'number_of_invaded_plots',
                                       'invaded.niche.breadth':'invaded_niche_breadth',
                                       'habitat.range':'habitat_range'}),
             family=sm.families.Poisson()).fit()
OUT['success_model_poisson'] = {k: {'coef': round(nb.params[k],3), 'p': float(nb.pvalues[k])}
    for k in ['is_gard','log_mrt','invaded_niche_breadth','habitat_range']}
nb2 = smf.glm('number_of_invaded_plots ~ is_gard*log_mrt + is_gard*invaded_niche_breadth + C(growth3)',
             data=sp_d.rename(columns={'number.of.invaded.plots':'number_of_invaded_plots',
                                       'invaded.niche.breadth':'invaded_niche_breadth'}),
             family=sm.families.Poisson()).fit()
OUT['success_model_interactions'] = {k: {'coef': round(nb2.params[k],3), 'p': float(nb2.pvalues[k])}
    for k in nb2.params.index if 'is_gard' in k}

OUT['top10_invaders'] = sp_d.nlargest(10,'number.of.invaded.plots')[
    ['Scientific_name','intro.pathway','growth.form','number.of.invaded.plots','mrt','invaded.niche.breadth']
    ].to_dict('records')

with open('output/results.json','w') as f:
    json.dump(OUT, f, indent=1, default=str)
print(json.dumps(OUT, indent=1, default=str))
