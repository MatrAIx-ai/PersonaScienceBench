"""Supplementary robustness checks for the urban x pathway question."""
import numpy as np, pandas as pd, statsmodels.formula.api as smf, statsmodels.api as sm, json, warnings
warnings.filterwarnings('ignore')
OUT={}
pl = pd.read_csv('data/invaded_niche_pathways.csv', sep='\t')
pl.columns=[c.replace('.','_') for c in pl.columns]
pl['log_stream']=np.log1p(pl['distance_stream']); pl['log_road']=np.log1p(pl['distance_road'])
pl['traj_56']=np.select([pl['progressive_1956_2009_50m']>=0.5, pl['regressive_1956_2009_50m']>=0.5],
                        ['progressive','regressive'],'no_change')
pl['hab']=pl['habitat'].str.replace(' ','_',regex=False)
CONF='C(hab) + elevation + annual_temperature + annual_rainfall + log_stream + log_road'

# S1: presence/absence logistic per pathway (all 632 plots; robust to low counts)
for pw in ['gard','unint','agfo']:
    pl[f'pres_{pw}']=(pl[f'n_{pw}']>0).astype(int)
    m=smf.glm(f'pres_{pw} ~ urban_2009_500m + progressive_1956_2009_50m + regressive_1956_2009_50m + {CONF}', data=pl, family=sm.families.Binomial()).fit()
    OUT[f'logit_{pw}']={k:{'OR':round(np.exp(m.params[k]),2),'p':float(m.pvalues[k])}
        for k in ['urban_2009_500m','progressive_1956_2009_50m','regressive_1956_2009_50m']}

# S2: Gardening presence ~ progressive 1956-2009 and 1993-2009 jointly
m=smf.glm('pres_gard ~ urban_2009_500m + progressive_1956_2009_50m + progressive_1993_2009_50m + '+CONF, data=pl, family=sm.families.Binomial()).fit()
OUT['logit_gard_both_steps']={k:{'coef':round(m.params[k],3),'p':float(m.pvalues[k])}
    for k in ['urban_2009_500m','progressive_1956_2009_50m','progressive_1993_2009_50m']}

# S3: habitat-stratified Gardening presence vs progressive urbanization (habitats with enough plots)
strata={}
for h in ['Wetlands','Coastal','Riparian','Urban','Croplands','Coniferous_forests','Broad-leaved_forests']:
    d=pl[(pl['hab']==h)]
    if d['pres_gard'].sum()>=5 and d['progressive_1956_2009_50m'].std()>0:
        try:
            mm=smf.glm('pres_gard ~ progressive_1956_2009_50m', data=d, family=sm.families.Binomial()).fit()
            strata[h]={'coef':round(mm.params['progressive_1956_2009_50m'],3),'p':float(mm.pvalues['progressive_1956_2009_50m']),'n':len(d)}
        except Exception as e: strata[h]={'error':str(e)}
OUT['habitat_stratified_progressive_gard']=strata

# S4: pooled scenario contrast for Gardening share (weighted), 1956-2009 step
pooled = pl.groupby('traj_56').apply(lambda d: pd.Series({
    'n_plots':len(d),'n_total':int(d['n_total'].sum()),
    'prop_gard':round(d['n_gard'].sum()/max(d['n_total'].sum(),1),3),
    'pres_gard_rate':round(d['pres_gard'].mean(),3)}), include_groups=False)
OUT['pooled_scenario_1956_2009']=pooled.reset_index().to_dict('records')

# S5: species-level -- do Gardening invaders differ in dispersal/vegetative; top Gardening invaders
sp=pd.read_csv('data/invasion_success_pathways.csv').sort_values(['Scientific_name','number.of.invaded.plots'],ascending=[True,False]).drop_duplicates('Scientific_name')
OUT['gard_top5']=sp[sp['intro.pathway']=='Gardening'].nlargest(5,'number.of.invaded.plots')[
    ['Scientific_name','number.of.invaded.plots','mrt','invaded.niche.breadth','growth.form']].to_dict('records')
json.dump(OUT, open('output/results_supplement.json','w'), indent=1, default=str)
print(json.dumps(OUT, indent=1, default=str))
