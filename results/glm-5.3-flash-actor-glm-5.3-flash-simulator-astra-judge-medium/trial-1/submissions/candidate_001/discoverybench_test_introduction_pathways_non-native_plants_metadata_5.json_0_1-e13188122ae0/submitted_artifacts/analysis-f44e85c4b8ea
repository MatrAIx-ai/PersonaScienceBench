"""Analysis: What types of plant introductions were influenced by urban land use?
Region: Catalonia (introductions) / Barcelona province (invaded plots).
Part A: temporal trends (chi-square). Part B: plot-level pathway composition vs urban cover.
Part C: species-level trait comparison by pathway. Output: results.json + console."""
import json, math
import numpy as np, pandas as pd
from scipy import stats
import statsmodels.api as sm
import statsmodels.formula.api as smf

D='/workspace/data/'
out={}

# ---------- Part A: temporal trends ----------
t=pd.read_csv(D+'temporal_trends_contingency_table.csv',sep='\t')
order=['Before 1500','1501-1900','1901-1984','1985-2019']
piv=t.pivot(index='introduction.period',columns='pathway',values='n')\
     [['AgriForest','Gardening','Unintentional']].loc[order]
shares=(piv.div(piv.sum(axis=1),axis=0)*100).round(1)
chi2,p,dof,exp=stats.chi2_contingency(piv)
resid=(piv-exp)/np.sqrt(exp)
print("=== PART A: temporal trends ===")
print(piv); print("\nShares (%):"); print(shares)
print(f"Chi2={chi2:.1f}, df={dof}, p={p:.2e}")
print("Pearson residuals:"); print(resid.round(2))
out['A']={'counts':piv.to_dict(),'shares_pct':shares.to_dict(),
          'chi2':round(chi2,1),'p':float(p),'df':dof,'pearson_residuals':resid.round(2).to_dict()}

# ---------- Part B: plot-level ----------
n=pd.read_csv(D+'invaded_niche_pathways.csv',sep='\t')
n.columns=[c.replace('.','_') for c in n.columns]
n=n.rename(columns={'n_gard':'n_gard'})
inv=n[n['n_total']>0].copy()
inv['habitat']=inv['habitat'].str.replace(' ','_').str.replace('-','_')
print(f"\n=== PART B: {len(inv)} invaded plots (of {len(n)}) ===")
for pw in ['gard','unint','agfo']:
    inv['p_'+pw]=inv['n_'+pw]/inv['n_total']
    inv['n_'+pw]=inv['n_'+pw].astype(int)
inv['n_total']=inv['n_total'].astype(int)
inv['dom_gard']=(inv['n_gard']>inv['n_unint']+inv['n_agfo']).astype(int)

# Spearman correlations: pathway proportion & richness vs urban cover (year x scale)
print("\nSpearman rho (p-value) of pathway proportion / richness vs urban cover:")
corr={}
for scale in ['50m','500m','1000m']:
    for yr in ['1956','1993','2009']:
        col=f'urban_{yr}_{scale}'
        row={}
        for pw in ['gard','unint','agfo']:
            rho,pv=stats.spearmanr(inv[col],inv['p_'+pw])
            row[pw]=[round(rho,3),round(pv,4)]
        rho,pv=stats.spearmanr(inv[col],inv['n_total'])
        row['n_total']=[round(rho,3),round(pv,4)]
        corr[f'{yr}_{scale}']=row
        print(f"{col:>18}: gard {row['gard']}  unint {row['unint']}  agfo {row['agfo']}  n_total {row['n_total']}")
out['B_spearman']=corr

# Main model: binomial logistic GLM of pathway PRESENCE in plot vs urban cover.
# NOTE: count-based binomial GLMs (n_pw out of n_total) suffered quasi-complete
# separation (|coef| > 1e6, non-identifiable) driven by extreme zero patterns;
# presence/absence logistic GLMs with z-scored covariates converge cleanly and
# are used for adjusted inference, with Spearman correlations and binned
# pathway shares as unadjusted/robust corroboration.
for z in ['urban_2009_500m','elevation','annual_temperature']:
    inv['z_'+z]=(inv[z]-inv[z].mean())/inv[z].std()
for pw in ['gard','unint','agfo']:
    inv['has_'+pw]=(inv['n_'+pw]>0).astype(int)

print("\nLogistic GLM: P(pathway present) ~ urban_2009_500m (z) + elevation (z) + temperature (z)")
res_path={}
for pw in ['gard','unint','agfo']:
    try:
        mm=smf.logit(f'has_{pw} ~ z_urban_2009_500m + z_elevation + z_annual_temperature',data=inv).fit(disp=0)
        b=mm.params['z_urban_2009_500m']; pv=mm.pvalues['z_urban_2009_500m']
        res_path[pw]={'coef_per_SD_urban':round(b,3),'OR_per_SD':round(math.exp(b),2),
                      'p':round(pv,4),'converged':bool(mm.mle_retvals['converged'])}
        print(f"  {pw}: coef={b:.3f}, OR={math.exp(b):.2f}, p={pv:.4f}, converged={mm.mle_retvals['converged']}")
    except Exception as e:
        res_path[pw]={'error':str(e)[:80]}
out['B_logit_presence']=res_path

# Omnibus: pooled pathway counts across urban-cover bins (2009, 500 m) chi-square
inv['urban_bin']=pd.cut(inv['urban_2009_500m'],[-0.01,0.001,0.25,0.5,1.0],
                        labels=['0%','>0-25%','25-50%','>50%'])
pool=inv.groupby('urban_bin',observed=True)[['n_gard','n_unint','n_agfo']].sum()
chi2b,pb,dofb,_=stats.chi2_contingency(pool.T)
print("\nPooled pathway composition x urban bin (2009, 500 m):"); print(pool)
print(f"Chi2={chi2b:.1f}, df={dofb}, p={pb:.4f}")
out['B_pooled_chisq']={'table':pool.to_dict(),'chi2':round(chi2b,1),'p':round(pb,4),'df':dofb}

# Binned pathway shares (descriptive, robust to model form)
binshare=inv.groupby('urban_bin',observed=True).apply(lambda d: pd.Series({
 'plots':len(d),'aliens':int(d['n_total'].sum()),
 'p_gard':round(d['n_gard'].sum()/max(d['n_total'].sum(),1),3),
 'p_unint':round(d['n_unint'].sum()/max(d['n_total'].sum(),1),3),
 'p_agfo':round(d['n_agfo'].sum()/max(d['n_total'].sum(),1),3)}),include_groups=False)
print("\nPathway shares by urban-cover bin (2009, 500 m):"); print(binshare.to_string())
out['B_bins_500m']=binshare.to_dict()
binshare2=inv.assign(ub=pd.cut(inv['urban_2009_1000m'],[-0.01,0.001,0.25,0.5,1.0],
    labels=['0%','>0-25%','25-50%','>50%'])).groupby('ub',observed=True).apply(lambda d: pd.Series({
 'plots':len(d),'aliens':int(d['n_total'].sum()),
 'p_gard':round(d['n_gard'].sum()/max(d['n_total'].sum(),1),3),
 'p_unint':round(d['n_unint'].sum()/max(d['n_total'].sum(),1),3),
 'p_agfo':round(d['n_agfo'].sum()/max(d['n_total'].sum(),1),3)}),include_groups=False)
print("\nPathway shares by urban-cover bin (2009, 1000 m):"); print(binshare2.to_string())
out['B_bins_1000m']=binshare2.to_dict()

# GLM diagnostics for the presence models
md=smf.logit('has_gard ~ z_urban_2009_500m + z_elevation + z_annual_temperature',data=inv).fit(disp=0)
from statsmodels.stats.outliers_influence import variance_inflation_factor
X=sm.add_constant(inv[['z_urban_2009_500m','z_elevation','z_annual_temperature']])
vifs={X.columns[i]:round(variance_inflation_factor(X.values,i),2) for i in range(1,X.shape[1])}
pred=(md.predict()>0.5).astype(int)
acc=(pred==inv['has_gard']).mean()
print(f"\nDiagnostics (Gardening presence model): converged={md.mle_retvals['converged']}, "
      f"pseudo-R2={md.prsquared:.3f}, accuracy={acc:.2f}, VIFs={vifs}, n={int(md.nobs)}")
out['B_diag']={'pseudoR2_gard':round(md.prsquared,3),'accuracy_gard':round(acc,3),'VIFs':vifs}

# Scale sensitivity (compact): presence-logit coefficient of urban_2009_* at 50/500/1000 m
print("\nScale sensitivity (logit coef on z-scored urban_2009_*):")
sens={}
for scale in ['50m','500m','1000m']:
    col='z_urban_2009_'+scale
    inv[col]=(inv['urban_2009_'+scale]-inv['urban_2009_'+scale].mean())/inv['urban_2009_'+scale].std()
    row={}
    for pw in ['gard','unint','agfo']:
        try:
            mm2=smf.logit(f'has_{pw} ~ {col} + z_elevation + z_annual_temperature',data=inv).fit(disp=0)
            row[pw]=[round(mm2.params[col],3),round(mm2.pvalues[col],4)]
        except Exception as e:
            row[pw]=['err',str(e)[:40]]
    sens[scale]=row
    print(f"  {scale}: {row}")
out['B_scale_sens']=sens

# Supplementary (cheap): Poisson richness model + full-flora check including empty plots
m2=smf.glm('n_total ~ urban_2009_500m + elevation + annual_temperature',data=inv,
           family=sm.families.Poisson()).fit()
b=m2.params['urban_2009_500m']; pv=m2.pvalues['urban_2009_500m']
print(f"\nSupplementary Poisson n_total ~ urban_2009_500m (invaded plots): coef={b:.3f}, IRR(+10%)={math.exp(b*0.1):.2f}, p={pv:.4f}")
m3=smf.glm('n_total ~ urban_2009_500m + elevation + annual_temperature',data=n,
           family=sm.families.Poisson()).fit()
b3=m3.params['urban_2009_500m']; pv3=m3.pvalues['urban_2009_500m']
print(f"Supplementary Poisson n_total ~ urban_2009_500m (ALL 632 plots): coef={b3:.3f}, IRR(+10%)={math.exp(b3*0.1):.2f}, p={pv3:.4f}")
out['B_poisson_total']={'invaded':{'coef':round(b,3),'IRR_per_+10pct':round(math.exp(b*0.1),2),'p':round(pv,4)},
                        'all_plots':{'coef':round(b3,3),'IRR_per_+10pct':round(math.exp(b3*0.1),2),'p':round(pv3,4)}}

# Landscape-change variables (cheap check): Spearman vs pathway proportions
chg={}
for c in ['progressive_1956_2009_50m','regressive_1956_2009_50m','no_changes_1956_2009_50m']:
    row={}
    for pw in ['gard','unint','agfo']:
        rho,pv=stats.spearmanr(inv[c],inv['p_'+pw])
        row[pw]=[round(rho,3),round(pv,4)]
    chg[c]=row
print("\nLandscape-change (1956-2009 @50m) vs pathway proportions (Spearman):")
for k,v in chg.items(): print(f"  {k}: {v}")
out['B_change_corr']=chg

# Habitat table
hb=inv.groupby('habitat').apply(lambda d: pd.Series({
    'plots':len(d),'aliens':int(d['n_total'].sum()),
    'p_gard':round(d['n_gard'].sum()/max(d['n_total'].sum(),1),3),
    'p_unint':round(d['n_unint'].sum()/max(d['n_total'].sum(),1),3),
    'p_agfo':round(d['n_agfo'].sum()/max(d['n_total'].sum(),1),3),
    'urban_2009_500m_mean':round(d['urban_2009_500m'].mean(),3)}),include_groups=False
    ).sort_values('urban_2009_500m_mean',ascending=False)
print("\nHabitat table (sorted by mean urban cover 2009 @500m):"); print(hb.to_string())
out['B_habitat']=hb.to_dict()

# ---------- Part C: species-level ----------
sp=pd.read_csv(D+'invasion_success_pathways.csv')
sp.columns=[c.replace('.','_') for c in sp.columns]
sp=sp[sp['duplicated']!='TRUE'].copy()
print(f"\n=== PART C: {len(sp)} species (dedup) ===")
g=sp.groupby('intro_pathway')[['number_of_invaded_plots','area_of_occupancy_10km',
   'habitat_range','invaded_niche_breadth','mrt']].mean().round(2)
print(g)
out['C_means']=g.to_dict()
kw={}
for v in ['invaded_niche_breadth','number_of_invaded_plots','habitat_range','mrt']:
    grp=[r[v].values for _,r in sp.groupby('intro_pathway')]
    H,pv=stats.kruskal(*grp)
    kw[v]=[round(H,2),round(pv,4)]
    print(f"Kruskal-Wallis {v}: H={H:.2f}, p={pv:.4f}")
out['C_kruskal']=kw
ct=pd.crosstab(sp['intro_pathway'],sp['growth_form'])
print("\nGrowth form x pathway:"); print(ct.to_string())
out['C_growthform']=ct.to_dict()
woody=lambda d: d['growth_form'].str.contains('tree|shrub',case=False,na=False).mean()
out['C_woody_share']={pw:round(woody(sp[sp['intro_pathway']==pw]),2) for pw in ['Gardening','Unintentional','AgriForest']}
print("Woody (tree/shrub) share by pathway:",out['C_woody_share'])
fam=sp.groupby('family').size().sort_values(ascending=False).head(8)
print("Top families:",fam.to_dict()); out['C_top_families']=fam.to_dict()

json.dump(out,open('/workspace/analysis/results.json','w'),indent=1,default=str)
print("\nSaved /workspace/analysis/results.json")
