"""
Urban land use and invasion pathways of non-native plants (Catalonia / Barcelona province).
Steps: A) temporal pathway trends  B) plot-level urban effects on pathway counts
       C) species-level invasion success by pathway  D) phylogenetic signal + PGLS  E) synthesis.
"""
import numpy as np, pandas as pd, scipy.stats as st, scipy.optimize as opt
import statsmodels.api as sm, json, itertools, warnings
warnings.filterwarnings("ignore")

R = {}

# ---------- STEP A: temporal trends ----------
tt = pd.read_csv("data/temporal_trends_contingency_table.csv", sep="\t")
piv = tt.pivot(index="introduction.period", columns="pathway", values="n")
piv = piv[["AgriForest","Gardening","Unintentional"]].loc[
    ["Before 1500","1501-1900","1901-1984","1985-2019"]]
chi2, p, dof, _ = st.chi2_contingency(piv)
props = piv.div(piv.sum(1), 0)
R["A"] = {"table": piv.to_dict(), "row_props": props.round(3).to_dict(),
          "chi2": round(chi2,1), "p": float(p),
          "gardening_prop": props["Gardening"].round(3).tolist(),
          "agriforest_prop": props["AgriForest"].round(3).tolist()}
print("== STEP A =="); print(piv); print(props.round(2)); print(f"chi2={chi2:.1f} p={p:.2e}")

# ---------- STEP B: plot-level models ----------
pl = pd.read_csv("data/invaded_niche_pathways.csv", sep="\t")
CTRL = ["elevation","annual.temperature","annual.rainfall","distance.road","distance.stream"]
def z(s): return (s - s.mean()) / s.std()

# B1: total invader richness (NB GLM, all 632 plots) + radius sensitivity
R["B_nb_total"] = {}
for u in ["1000m","500m","50m"]:
    X = pl[["n.total"]].copy()
    X["urban"] = z(pl[f"urban.2009.{u}"]); X["cropland"] = z(pl[f"cropland.2009.{u}"])
    X["expansion"] = z(pl["progressive.1956.2009.50m"])  # urban+cropland expansion (50m only)
    X["reduction"] = z(pl["regressive.1956.2009.50m"])
    for c in CTRL: X[c] = z(pl[c])
    nb = sm.GLM(X["n.total"], sm.add_constant(X.drop(columns="n.total")),
                family=sm.families.NegativeBinomial(alpha=1.0)).fit()
    R["B_nb_total"][u] = {v: {"coef": round(nb.params[v],3), "p": float(nb.pvalues[v])}
                          for v in ["urban","cropland","expansion","reduction"]}
print("== B1 NB total richness =="); print(json.dumps(R["B_nb_total"], indent=1))

# B2: pathway composition (binomial GLM on plots with >=1 invader, n=191)
inv = pl[pl["n.total"] > 0].copy()
X = pd.DataFrame({"urban": z(inv["urban.2009.1000m"]), "cropland": z(inv["cropland.2009.1000m"]),
                  "expansion": z(inv["progressive.1956.2009.50m"]),
                  "reduction": z(inv["regressive.1956.2009.50m"])})
for c in CTRL: X[c] = z(inv[c])
# Poisson with log(n.total) offset: models pathway share of the invader community.
# (Binomial GLM suffered quasi-complete separation for Gardening/Unintentional; the
#  offset-Poisson rate-ratio model is stable and interpretable. Robust (HC1) SEs.)
R["B_binomial"] = {}
Xoff = sm.add_constant(X).copy(); Xoff["exposure"] = np.log(inv["n.total"].values)
for pw, col in [("Gardening","n.gard"),("Unintentional","n.unint"),("AgriForest","n.agfo")]:
    m = sm.GLM(inv[col], Xoff.drop(columns="exposure"), family=sm.families.Poisson(),
               offset=Xoff["exposure"]).fit(cov_type="HC1")
    R["B_binomial"][pw] = {v: {"coef": round(m.params[v],3), "RR": round(float(np.exp(m.params[v])),2),
                               "p": float(m.pvalues[v])} for v in ["urban","cropland","expansion","reduction"]}
    print(f"-- {pw} (Poisson+offset, n={len(inv)}) --"); print(pd.DataFrame(R["B_binomial"][pw]).T)

# B3: mean counts by habitat and urban context
pl["urban_hi"] = (pl["urban.2009.1000m"] > pl["urban.2009.1000m"].median()).astype(int)
hb = pl.groupby("habitat")[["n.gard","n.unint","n.agfo","n.total"]].mean().round(2)
uh = pl.groupby("urban_hi")[["n.gard","n.unint","n.agfo","n.total"]].mean().round(2)
R["B_habitat"] = hb.to_dict(); R["B_urbanhi"] = uh.to_dict()
print("== by habitat =="); print(hb); print("== urban above/below median (1000m) =="); print(uh)

# B4: Moran's I of NB-total residuals (5 km inverse-weight neighbourhood, 199 perms)
res = nb.resid_response
coords = pl[["longitude","latitude"]].values
D = np.sqrt(((coords[:,None,:]-coords[None,:,:])**2).sum(-1))
W = (D < 5000).astype(float); np.fill_diagonal(W, 0)
I = (len(pl)/W.sum()) * (res @ W @ res) / (res @ res)
rng = np.random.default_rng(1)
perm = np.array([ (len(pl)/W.sum())*((s:=rng.permutation(res)) @ W @ s)/(s @ s) for _ in range(199)])
R["B_morans"] = {"I": round(float(I),3), "p_perm": float((np.sum(perm>=I)+1)/200)}
print(f"Moran's I residual = {I:.3f}, perm p = {R['B_morans']['p_perm']}")

# ---------- STEP C: species-level invasion success ----------
sp = pd.read_csv("data/invasion_success_pathways.csv")
sp_d = sp.drop_duplicates("Scientific_name", keep="first").copy()
dropped = sp.loc[~sp.index.isin(sp_d.index), "Scientific_name"].tolist()
R["C_n"] = {"raw": len(sp), "dedup": len(sp_d), "dropped": dropped}
print(f"== STEP C == dedup {len(sp)} -> {len(sp_d)}; dropped: {dropped}")
R["C_group"] = {}
for y in ["number.of.invaded.plots","area.of.occupancy.10km","invaded.niche.breadth","mrt"]:
    g = [sp_d.loc[sp_d["intro.pathway"]==pw, y] for pw in ["Gardening","Unintentional","AgriForest"]]
    kw = st.kruskal(*g)
    R["C_group"][y] = {"medians": {pw: round(float(np.median(gi)),2)
                       for pw,gi in zip(["Gardening","Unintentional","AgriForest"],g)},
                       "kw_H": round(float(kw.statistic),2), "p": float(kw.pvalue)}
    print(y, R["C_group"][y])
# NB model: number.of.invaded.plots ~ pathway + mrt (reference rotated)
sd = pd.DataFrame({"y": sp_d["number.of.invaded.plots"], "mrt_z": z(sp_d["mrt"])})
dum = pd.get_dummies(sp_d["intro.pathway"]).astype(float)
R["C_nb"] = {}
for ref in ["Gardening","Unintentional","AgriForest"]:
    cols = [c for c in dum.columns if c != ref]
    m = sm.GLM(sd["y"], sm.add_constant(sd[["mrt_z"]].join(dum[cols])),
               family=sm.families.NegativeBinomial(alpha=1.0)).fit()
    R["C_nb"][ref] = {"vs_%s"%ref: {c: {"coef": round(m.params[c],3), "p": float(m.pvalues[c])} for c in cols},
                      "mrt": {"coef": round(m.params["mrt_z"],3), "p": float(m.pvalues["mrt_z"])}}
print(json.dumps(R["C_nb"], indent=1))

# ---------- STEP D: phylogeny (manual Newick parser) ----------
def parse_newick(s):
    s = s.strip().rstrip(";"); pos = 0
    def node():
        nonlocal pos
        children = []
        if s[pos] == "(":
            pos += 1
            while True:
                children.append(node())
                if s[pos] == ",": pos += 1
                else: break
            pos += 1
        name = ""
        while pos < len(s) and s[pos] not in ",():":
            name += s[pos]; pos += 1
        bl = 0.0
        if pos < len(s) and s[pos] == ":":
            pos += 1; num = ""
            while pos < len(s) and (s[pos].isdigit() or s[pos] in ".eE+-"):
                num += s[pos]; pos += 1
            bl = float(num)
        return {"name": name.strip(), "bl": bl, "children": children}
    return node()
tree = parse_newick(open("data/phylogenetic_tree.txt").read())
nodes, parent, blen = [], {}, {}
def collect(n_, par):
    nodes.append(n_); parent[id(n_)] = par
    for c in n_["children"]: blen[id(c)] = c["bl"]; collect(c, n_)
collect(tree, None)
tips = {n_["name"]: n_ for n_ in nodes if not n_["children"]}
tipnames = list(tips)
sp_d = sp_d.set_index("phylo.tip.label").reindex(tipnames).dropna(subset=["intro.pathway"]).reset_index()
R["D"] = {"tips": len(tips), "species_used": len(sp_d)}
def path_ids(name):
    p, cur = [], tips[name]
    while cur is not None: p.append(id(cur)); cur = parent[id(cur)]
    return p
def pairdist(a, b):
    pa, pb = path_ids(a), path_ids(b); setb = set(pb)
    for x in pa:
        if x in setb:
            d = 0.0
            cur = tips[a]
            while id(cur) != x: d += blen[id(cur)]; cur = parent[id(cur)]
            cur = tips[b]
            while id(cur) != x: d += blen[id(cur)]; cur = parent[id(cur)]
            return d
    return np.nan
used_tips = sp_d["phylo.tip.label"].tolist()
n = len(used_tips)
Dm = np.array([[0.0 if a==b else pairdist(a,b) for b in used_tips] for a in used_tips])
R["D"]["max_pair_dist"] = round(float(Dm[np.triu_indices(n,1)].max()),1)
maxd = Dm[np.triu_indices(n,1)].max()
Cm = 1.0 - Dm/maxd          # cophenetic similarity, diagonal 1, off-diag in [0,1]
def lam_fit(x, C):
    xz = (x - x.mean()) / x.std()
    def nll(lam):
        V_ = lam*C + (1-lam)*np.eye(len(x)) + np.eye(len(x))*1e-8
        Vi = np.linalg.inv(V_)
        mu = (Vi.sum(1)/Vi.sum()) @ xz
        r = xz - mu
        s, ld = np.linalg.slogdet(V_)
        return 0.5*(len(x)*np.log(2*np.pi) + ld + r @ Vi @ r)
    res = opt.minimize_scalar(nll, bounds=(1e-6,1.0), method="bounded")
    return res.x, nll(1e-6), res.fun
R["D"]["lambda"] = {}
for y in ["number.of.invaded.plots","invaded.niche.breadth","mrt"]:
    x = sp_d[y].values.astype(float)
    lam, nll0, nllL = lam_fit(x, Cm)
    lr = max(2*(nll0 - nllL), 0.0)
    R["D"]["lambda"][y] = {"lambda": round(float(lam),3), "LR": round(float(lr),2),
                           "p": float(st.chi2.sf(lr,1))}
    print(f"lambda {y}: {lam:.3f} (LR={lr:.2f}, p={R['D']['lambda'][y]['p']:.3f})")
lab = np.asarray(sp_d["intro.pathway"].values)
iu = np.triu_indices(n,1)
same = (lab[:,None] == lab[None,:])[iu]
wdist = Dm[iu]
within = wdist[same].mean()
rng = np.random.default_rng(42)
perm_stat = np.array([ (lambda L: wdist[(L[:,None]==L[None,:])[iu]].mean())(rng.permutation(lab)) for _ in range(999)])
p_low = float(np.mean(perm_stat <= within)); p_high = float(np.mean(perm_stat >= within))
p_two = max(min(p_low, p_high) * 2, 2/1000)  # floor at permutation resolution
R["D"]["pathway_signal"] = {"mean_within_dist": round(float(within),1),
    "null_mean": round(float(perm_stat.mean()),1),
    "p_two_sided": p_two, "p_lower_tail": p_low}
print("pathway phylo clustering:", R["D"]["pathway_signal"])
lam_y = R["D"]["lambda"]["number.of.invaded.plots"]["lambda"]
if lam_y > 0.2:
    V = lam_y*Cm + (1-lam_y)*np.eye(n) + np.eye(n)*1e-8
    Xm = pd.get_dummies(sp_d["intro.pathway"], drop_first=True).astype(float)
    Xm["mrt_z"] = z(sp_d["mrt"]); Xm = sm.add_constant(Xm)
    gls = sm.GLS(sp_d["number.of.invaded.plots"].values.astype(float), Xm, sigma=V).fit()
    R["D"]["pgls"] = {"lambda_used": lam_y,
        "coefs": {c: {"coef": round(gls.params[c],3), "p": float(gls.pvalues[c])}
                  for c in gls.params.index if c != "const"}}
    print("PGLS:", json.dumps(R["D"]["pgls"], indent=1))
else:
    R["D"]["pgls"] = {"note": f"lambda={lam_y:.3f} ~ 0: no phylogenetic signal in invasion success; PGLS unnecessary, Step C results stand."}
    print(R["D"]["pgls"]["note"])

json.dump(R, open("output/results.json","w"), indent=1, default=float)
print("\nSaved output/results.json")
