"""
Main analysis: Do original-study effect sizes tend to be larger than replication
effect sizes, and in which domains (disciplines / replication projects)?

Data: meta-regression_joined_data_heterogeneity_in_replication_projects.csv
Each row = one original-replication pair.
Primary comparison: |fisr| vs |fiso| on the Fisher-z scale (absolute values handle
the 18 sign-flipped replication effects; magnitude framing carried as assumption).
"""
import numpy as np
import pandas as pd
from scipy import stats

pd.set_option('display.width', 160)
df = pd.read_csv('data/meta-regression_joined_data_heterogeneity_in_replication_projects.csv')

# ---- derived quantities ----
df['abs_fiso'] = df['fiso'].abs()
df['abs_fisr'] = df['fisr'].abs()
df['d_abs'] = df['abs_fisr'] - df['abs_fiso']      # primary: |rep| - |orig| (negative => orig larger)
df['d_signed'] = df['fisr'] - df['fiso']           # secondary: signed difference
df['orig_larger_abs'] = df['d_abs'] < 0

print('=' * 100)
print('N =', len(df), ' rows (one original-replication pair per row)')
print('=' * 100)

def group_report(g, name):
    n = len(g)
    out = {
        'group': name, 'n': n,
        'mean |fiso|': g['abs_fiso'].mean(), 'mean |fisr|': g['abs_fisr'].mean(),
        'mean(|fisr|-|fiso|)': g['d_abs'].mean(),
        'median(|fisr|-|fiso|)': g['d_abs'].median(),
        'mean relative_es': g['relative_es'].mean(),
        'median relative_es': g['relative_es'].median(),
        '% pairs |fisr|<|fiso|': 100 * g['orig_larger_abs'].mean(),
        'mean(fisr-fiso)': g['d_signed'].mean(),
        'median(fisr-fiso)': g['d_signed'].median(),
        '% fisr<fiso (signed)': 100 * (g['d_signed'] < 0).mean(),
    }
    # paired tests on |fisr|-|fiso|
    w = stats.wilcoxon(g['abs_fisr'], g['abs_fiso'])
    t = stats.ttest_rel(g['abs_fisr'], g['abs_fiso'])
    out['wilcoxon_W'] = w.statistic; out['wilcoxon_p'] = w.pvalue
    out['t_stat'] = t.statistic; out['t_p'] = t.pvalue
    return out

rows = []
for disc in ['Cognitive', 'Social', 'Economics']:
    rows.append(group_report(df[df.discipline == disc], disc))
rows.append(group_report(df[df['project.x'] == 'Psychology'], 'Psychology (project)'))
rows.append(group_report(df[df['project.x'] == 'Experimental Economics'], 'Exp. Economics (project)'))
rows.append(group_report(df, 'ALL'))
rep = pd.DataFrame(rows).set_index('group')
print('\n--- (a)+(b)+(d) Per-domain descriptives and paired tests ---')
print(rep.round(4).to_string())

# ---- (c) random-effects meta-analysis of signed z difference per discipline ----
# d_i = fisr - fiso ; var = se_fisr^2 + se_fiso^2 (independent-errors approx.)
def dl_meta(d, v):
    """DerSimonian-Laird random-effects pooled estimate, CI, I^2."""
    d, v = np.asarray(d, float), np.asarray(v, float)
    w_fe = 1 / v
    d_fe = (w_fe * d).sum() / w_fe.sum()
    Q = (w_fe * (d - d_fe) ** 2).sum()
    k = len(d)
    dfree = k - 1
    tau2 = max(0.0, (Q - dfree) / (w_fe.sum() - (w_fe ** 2).sum() / w_fe.sum())) if dfree > 0 else 0.0
    w_re = 1 / (v + tau2)
    pooled = (w_re * d).sum() / w_re.sum()
    se = np.sqrt(1 / w_re.sum())
    z = pooled / se
    p = 2 * stats.norm.sf(abs(z))
    I2 = max(0.0, (Q - dfree) / Q) * 100 if Q > 0 else 0.0
    return pooled, se, pooled - 1.96 * se, pooled + 1.96 * se, z, p, tau2, I2, k

meta_rows = []
for disc in ['Cognitive', 'Social', 'Economics']:
    g = df[df.discipline == disc]
    pooled, se, lo, hi, z, p, tau2, I2, k = dl_meta(g['d_signed'], g['se_fisr']**2 + g['se_fiso']**2)
    meta_rows.append([disc, k, pooled, se, lo, hi, z, p, tau2, I2])
for proj in ['Psychology', 'Experimental Economics']:
    g = df[df['project.x'] == proj]
    pooled, se, lo, hi, z, p, tau2, I2, k = dl_meta(g['d_signed'], g['se_fisr']**2 + g['se_fiso']**2)
    meta_rows.append([proj + ' (project)', k, pooled, se, lo, hi, z, p, tau2, I2])
g = df
pooled, se, lo, hi, z, p, tau2, I2, k = dl_meta(g['d_signed'], g['se_fisr']**2 + g['se_fiso']**2)
meta_rows.append(['ALL', k, pooled, se, lo, hi, z, p, tau2, I2])
meta = pd.DataFrame(meta_rows, columns=['group', 'k', 'pooled_d', 'se', 'CI_lo', 'CI_hi',
                                        'z', 'p', 'tau2', 'I2_pct']).set_index('group')
print('\n--- (c) Random-effects (DL) meta-analysis of signed Fisher-z difference (fisr - fiso) ---')
print('d < 0 => original effect larger. var_i = se_fisr^2 + se_fiso^2 (independent-errors approx.)')
print(meta.round(4).to_string())

# ---- (e) Eitam/Hassin sensitivity: rerun key descriptives with/without that row ----
mask = df['study'].str.contains('Eitam')
print('\n--- (e) Eitam/Hassin row:', df.loc[mask, ['study','ro','rr','fiso','fisr','relative_es']].to_string(index=False), '---')
df2 = df[~mask]
sens_rows = []
for disc in ['Cognitive', 'Social', 'Economics']:
    for label, d in [('with', df), ('without', df2)]:
        g = d[d.discipline == disc]
        w = stats.wilcoxon(g['abs_fisr'], g['abs_fiso'])
        sens_rows.append([disc, label, len(g), g['d_abs'].mean(), g['d_abs'].median(),
                          100 * g['orig_larger_abs'].mean(), w.pvalue])
sens = pd.DataFrame(sens_rows, columns=['discipline', 'data', 'n', 'mean|fisr|-|fiso|',
                                        'median|fisr|-|fiso|', '%|fisr|<|fiso|', 'wilcoxon_p']).set_index(['discipline', 'data'])
print(sens.round(4).to_string())

# raw relative_es comparison sanity (rr/ro check) and sign-flip count per domain for the write-up
print('\nSign-flipped replications (ro>0, rr<0) by discipline:')
print(df.loc[df.rr < 0, 'discipline'].value_counts().to_string())
print('\nrelative_es > 1 (replication larger on correlation scale) by discipline:')
print(df.loc[df.relative_es > 1, 'discipline'].value_counts().to_string())
