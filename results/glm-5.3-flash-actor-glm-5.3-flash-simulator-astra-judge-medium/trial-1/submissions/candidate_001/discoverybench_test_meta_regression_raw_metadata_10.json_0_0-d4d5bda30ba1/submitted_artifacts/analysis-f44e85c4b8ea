"""Analysis: Proportion of junior professors among replicated studies in Psychology.

Data: meta-regression_study_data_heterogeneity_in_replication_projects.csv
Locked choices (researcher-approved):
  - Filter to project == "rpp" (Psychology replication project)
  - Denominator: all replicated studies (replicated == 1), n = 35
  - Headline: junior professor = "Assistant Professor" (strict)
  - Secondary: broad definition (Assistant OR Assistant Professor); drop==False sensitivity
"""
import pandas as pd
import math

DATA = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
df = pd.read_csv(DATA)
print(f"Dataset 1: {df.shape[0]} rows x {df.shape[1]} cols")

# Step 1: Psychology project == 'rpp'
rpp = df[df["project"] == "rpp"].copy()
print(f"\nPsychology (project=='rpp'): {len(rpp)} studies")
print(f"replicated distribution: {rpp['replicated'].value_counts(dropna=False).to_dict()}")

# Step 2: replicated studies
rep = rpp[rpp["replicated"] == 1].copy()
n = len(rep)
print(f"\nDenominator (replicated studies in Psychology): n = {n}")

# Step 3: seniority.r distribution among replicated studies
print("\nseniority.r distribution among replicated rpp studies:")
dist = rep["seniority.r"].value_counts()
for k, v in dist.items():
    print(f"  {k}: {v} ({v/n:.1%})")
assert rep["seniority.r"].isna().sum() == 0, "unexpected missing seniority.r"

def wilson(k, n, z=1.96):
    p = k / n
    denom = 1 + z**2 / n
    center = (p + z**2 / (2 * n)) / denom
    half = z * math.sqrt(p * (1 - p) / n + z**2 / (4 * n**2)) / denom
    return center - half, center + half

def report(name, k):
    p = k / n
    lo, hi = wilson(k, n)
    print(f"{name}: {k}/{n} = {p:.1%} (95% Wilson CI {lo:.1%}-{hi:.1%})")

print("\n=== Headline estimate ===")
k_strict = (rep["seniority.r"] == "Assistant Professor").sum()
report("Strict: seniority.r == 'Assistant Professor'", k_strict)

print("\n=== Secondary definitions ===")
k_broad = rep["seniority.r"].isin(["Assistant", "Assistant Professor"]).sum()
report("Broad: 'Assistant' OR 'Assistant Professor'", k_broad)

rep2 = rep[rep["drop"] == False]
n2 = len(rep2)
ks = (rep2["seniority.r"] == "Assistant Professor").sum()
kb = rep2["seniority.r"].isin(["Assistant", "Assistant Professor"]).sum()
print(f"Sensitivity (drop==False, n={n2}): strict {ks}/{n2} = {ks/n2:.1%}; "
      f"broad {kb}/{n2} = {kb/n2:.1%}")

# Denominator-equivalence check: non-missing seniority denominator
print(f"\nMissing seniority.r in replicated rpp subset: "
      f"{rep['seniority.r'].isna().sum()} -> non-missing denominator also n={n}")

print("\n=== Summary ===")
print(f"Headline proportion of junior professors (Assistant Professor) among "
      f"replicated Psychology studies: {k_strict}/{n} = {k_strict/n:.1%}")
print(f"Broad definition (Assistant or Assistant Professor): {k_broad}/{n} = {k_broad/n:.1%}")
