"""Which domain did both original and replication studies primarily use student subjects?

Data: meta-regression study-level file (four replication projects).
Unit-of-analysis variants are computed explicitly to audit the quoted
82.4% (original) / 80.9% (replication) student shares.
"""
import pandas as pd

A_PATH = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
a = pd.read_csv(A_PATH)
a["aggregated_bool"] = a["aggregated"].astype(str) == "True"

# ---------- Unit-of-analysis variants ----------
# Variant 1: study level, prefer aggregated==True row, else first row per id
agg_rows = a[a["aggregated_bool"]]
first_rows = a[~a["id"].isin(agg_rows["id"])].drop_duplicates("id", keep="first")
study = pd.concat([agg_rows, first_rows]).sort_index()

# Variant 2: study level, first row per id (no aggregated preference)
study_first = a.drop_duplicates("id", keep="first")

# Variant 3: lab level (all rows)
lab = a.copy()

# Variant 4: study level restricted to drop==False (meta-regression sample)
study_nodrop = study[study["drop"] == False]

# Variant 5: lab level restricted to drop==False
lab_nodrop = lab[lab["drop"] == False]

def shares(df, subject_col):
    s = df[subject_col]
    students = (s == "students").sum()
    denom_nonmiss = s.notna().sum()
    denom_all = len(df)
    return students, denom_nonmiss, denom_all

def pct(x):
    return round(100 * x, 1) if pd.notna(x) else None

print("=" * 80)
print("OVERALL student-subject shares under candidate definitions")
print("=" * 80)
print(f"{'variant':32s} {'orig stud/denom':>20s} {'orig %':>8s} {'repl stud/denom':>20s} {'repl %':>8s}")
variants = {
    "study_agg_pref": study,
    "study_first_row": study_first,
    "lab_level_all": lab,
    "study_agg_pref_dropFalse": study_nodrop,
    "lab_level_dropFalse": lab_nodrop,
}
for name, df in variants.items():
    so, dno, da = shares(df, "subjects.o")
    sr, dnr, dr = shares(df, "subjects.r")
    print(f"{name:32s} {so:>8d}/{dno:<11d} {pct(so/dno):>7.1f}% {sr:>8d}/{dnr:<11d} {pct(sr/dnr):>7.1f}%")

print()
print("Quoted figures: original 82.4%, replication 80.9%")
print()

# ---------- Discipline-level shares, all variants ----------
def discipline_table(df, label):
    rows = []
    for disc, g in df.groupby("discipline"):
        so, dno, da = shares(g, "subjects.o")
        sr, dnr, dr = shares(g, "subjects.r")
        rows.append({
            "discipline": disc, "n_units": len(g),
            "o_students": so, "o_denom_nonmiss": dno,
            "o_pct": pct(so / dno),
            "r_students": sr, "r_denom_nonmiss": dnr,
            "r_pct": pct(sr / dnr),
        })
    t = pd.DataFrame(rows)
    print(f"--- {label} ---")
    print(t.to_string(index=False))
    print()
    return t

print("=" * 80)
print("STUDENT SHARES BY DISCIPLINE (all variants)")
print("=" * 80)
tabs = {}
for name, df in variants.items():
    tabs[name] = discipline_table(df, name)

# ---------- Sensitivity: 16 ids with conflicting subjects.r ----------
print("=" * 80)
print("SENSITIVITY: conflicting subjects.r across labs (16 ids)")
print("=" * 80)
conflict_ids = a.groupby("id")["subjects.r"].nunique()
conflict_ids = conflict_ids[conflict_ids > 1].index
sub = a[a["id"].isin(conflict_ids)]

def pair_label_any(g):
    return pd.Series({
        "any_students": (g["subjects.r"] == "students").any(),
        "majority_students": (g["subjects.r"] == "students").mean() > 0.5,
        "first_row_students": g.iloc[0]["subjects.r"] == "students",
    })
rules = sub.groupby("id").apply(pair_label_any)
print("rule                          n_ids_labelled_students  pct")
for c in ["any_students", "majority_students", "first_row_students"]:
    print(f"{c:28s} {rules[c].sum():>8d}                 {pct(rules[c].mean()):.1f}%")
print()

# Rebuild study-level subjects.r under each rule and recompute overall + Social shares
base = study_first.set_index("id")
for c in ["any_students", "majority_students"]:
    sr = base["subjects.r"].copy()
    sr.loc[rules.index] = rules[c].map({True: "students", False: "not-students"})
    overall = (sr == "students").mean()
    soc = (sr[base["discipline"] == "Social"] == "students").mean()
    print(f"rule={c:18s} overall r_students={pct(overall):.1f}%  Social r_students={pct(soc):.1f}%")
print()

# ---------- Final answer grounding ----------
print("=" * 80)
print("FINAL GROUNDING (study level, aggregated-row preferred)")
print("=" * 80)
final = tabs["study_agg_pref"]
final["combined_min"] = final[["o_pct", "r_pct"]].min(axis=1)
print(final.to_string(index=False))
print()
print("Interpretation: Economics numerically has the highest shares but covers only the 18")
print("ee-project studies and its shares (94.4%/100.0%) are far from the quoted 82.4%/80.9%.")
print("The quoted pair is matched most closely by the Social discipline (largest domain,")
print("74/141 O/R pairs): original 83.8% (62/74), replication 81.1% (60/74); at lab level")
print("Social gives 82.2% (548/667) and 78.6% (524/667). Both shares are dominant (>80%)")
print("and the replication share 81.1% is within 0.2pp of the quoted 80.9%.")
best = final.sort_values("combined_min", ascending=False).iloc[0]
print(f"\nHighest-shares domain (audit): {best['discipline']} "
      f"(original {best['o_pct']}%, replication {best['r_pct']}%; "
      f"counts {best['o_students']}/{best['o_denom_nonmiss']} and {best['r_students']}/{best['r_denom_nonmiss']})")
print("Domain consistent with the quoted 82.4%/80.9% pair and dominant in both: Social")

# ---------- Additional candidate definitions & distance to quoted figures ----------
print("=" * 80)
print("CANDIDATE DEFINITIONS vs QUOTED (82.4% original, 80.9% replication)")
print("=" * 80)
cands = {
    "overall_lab_inclNA": (round(100 * (lab["subjects.o"] == "students").mean(), 1),
                           round(100 * (lab["subjects.r"] == "students").mean(), 1)),
    "overall_lab_exclNA": (79.6, 80.3),
    "overall_study_inclNA": (round(100 * (study["subjects.o"] == "students").mean(), 1),
                             round(100 * (study["subjects.r"] == "students").mean(), 1)),
    "Social_study_inclNA": (83.8, 81.1),
    "Social_lab_inclNA": (82.2, 78.6),
    "Cognitive_study": (75.5, 81.6),
    "Economics_study": (94.4, 100.0),
}
for k, (o, r) in sorted(cands.items(), key=lambda kv: abs(kv[1][0] - 82.4) + abs(kv[1][1] - 80.9)):
    print(f"{k:24s} o={o:5.1f}% r={r:5.1f}%  dist={abs(o-82.4)+abs(r-80.9):.1f}")
print()
print("NOTE: no candidate reproduces 82.4/80.9 exactly. Closest = Social (study level,")
print("missing counted in denominator): 83.8% / 81.1% -> distance 1.6. Economics has the")
print("HIGHEST shares (94.4%/100%) but n=18 (ee project only) and is far from the quoted pair.")
print()
print("FINAL ANSWER: Social")
