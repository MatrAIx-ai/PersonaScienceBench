"""Proportion of Experimental Economics (EE) original studies conducted in the United Kingdom."""
import csv, json
from collections import Counter

STUDY_CSV = 'data/meta-regression_study_data_heterogeneity_in_replication_projects.csv'
SUCCESS_CSV = 'data/meta-regression_replication_success_data_heterogeneity_in_replication_projects.csv'

def load(path):
    with open(path, newline='', encoding='utf-8') as f:
        return list(csv.DictReader(f))

rows = load(STUDY_CSV)
ee = [r for r in rows if r['project'].strip().lower() == 'ee']

# Step 1: EE subset structure
n_ee = len(ee)
n_ids = len({r['id'] for r in ee})
n_titles = len({r['title'] for r in ee})
dup_titles = {t: c for t, c in Counter(r['title'] for r in ee).items() if c > 1}

# Step 2: UK numerator (trimmed, case-insensitive exact match)
def is_uk(v):
    return v.strip().lower() == 'united kingdom'

uk_rows = [r for r in ee if is_uk(r['experiment_country.o'])]
n_uk = len(uk_rows)

# Step 3: proportion over all EE original studies
prop = n_uk / n_ee

# Step 4: audit artifact — per-study country listing
per_study = [{'id': r['id'], 'title': r['title'],
              'experiment_country.o': r['experiment_country.o'],
              'experiment_country.r': r['experiment_country.r'],
              'is_uk_original': is_uk(r['experiment_country.o'])}
             for r in ee]

# Cross-check: dataset 2 EE row count (count-only consistency note)
rows2 = load(SUCCESS_CSV)
n_ee_ds2 = sum(1 for r in rows2 if r['project'].strip().lower() == 'experimental economics')

result = {
    'n_ee_rows_dataset1': n_ee,
    'n_unique_ee_ids': n_ids,
    'n_unique_ee_titles': n_titles,
    'duplicate_titles': dup_titles,
    'missing_country_rows_ee': sum(1 for r in ee if not r['experiment_country.o'].strip()),
    'n_uk_originals': n_uk,
    'uk_study_ids': [r['id'] for r in uk_rows],
    'proportion_uk': prop,
    'proportion_uk_pct': round(prop * 100, 2),
    'crosscheck_dataset2_experimental_economics_rows': n_ee_ds2,
    'country_distribution_ee': dict(Counter(r['experiment_country.o'].strip() for r in ee)),
    'per_study_listing': per_study,
}

with open('analysis/uk_proportion_ee_result.json', 'w', encoding='utf-8') as f:
    json.dump(result, f, indent=2, ensure_ascii=False)

# Console audit listing
print(f"EE rows: {n_ee} | unique ids: {n_ids} | unique titles: {n_titles} | duplicate titles: {dup_titles or 'none'}")
print(f"Missing/blank country rows in EE: {result['missing_country_rows_ee']}")
print(f"UK originals: {n_uk} (ids: {result['uk_study_ids']})")
print(f"Proportion UK = {n_uk}/{n_ee} = {prop:.4f} = {result['proportion_uk_pct']}%")
print(f"Cross-check: dataset2 'Experimental Economics' rows = {n_ee_ds2} (vs {n_ee} EE rows in dataset1)")
print("\nPer-study country listing (EE):")
for s in per_study:
    print(f"  {s['id']:6s} | orig={s['experiment_country.o']:15s} | repl={s['experiment_country.r']:15s} | {s['title'][:55]}")
