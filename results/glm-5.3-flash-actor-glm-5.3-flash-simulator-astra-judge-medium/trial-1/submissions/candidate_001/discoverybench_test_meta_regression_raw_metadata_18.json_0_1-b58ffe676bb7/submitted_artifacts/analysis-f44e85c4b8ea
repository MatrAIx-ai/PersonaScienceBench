"""Proportion of Experimental Economics (EE) original studies conducted in a lab setting.

Operationalization: the dataset has no explicit 'lab' column; a study is treated as
lab-based if online.o == 0 (the dataset encodes whether the original experiment was
conducted online). 'Lab' is therefore an inference, not a directly encoded field.
"""
import math
import pandas as pd

DATA = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
df = pd.read_csv(DATA)
ee = df[df["project"] == "ee"]

# --- Unit of analysis: unique original studies (distinct id values) ---
n_ids = ee["id"].nunique()
assert len(ee) == n_ids, "unexpected duplicate ids in ee subset"

online_o = ee["online.o"]
n_nonmissing = int(online_o.notna().sum())
n_lab = int((online_o == 0).sum())
n_online = int((online_o == 1).sum())
n_missing = int(online_o.isna().sum())
prop = n_lab / n_nonmissing

# Wilson 95% CI for a proportion
z = 1.959963985
den = 1 + z**2 / n_nonmissing
center = (prop + z**2 / (2 * n_nonmissing)) / den
half = z * math.sqrt(prop * (1 - prop) / n_nonmissing + z**2 / (4 * n_nonmissing**2)) / den
ci = (max(0.0, center - half), min(1.0, center + half))

# --- Robustness checks ---
online_r = ee["online.r"]
lab_r = int((online_r == 0).sum()); miss_r = int(online_r.isna().sum())
row_level_prop = (ee["online.o"] == 0).sum() / len(ee)  # row level == study level here

summary = pd.DataFrame({
    "metric": [
        "EE rows", "unique original studies (id)", "lab (online.o == 0)",
        "online (online.o == 1)", "online.o missing", "proportion lab (originals)",
        "Wilson 95% CI lower", "Wilson 95% CI upper",
        "lab replications (online.r == 0)", "online.r missing",
        "row-level proportion lab (== study-level)", "subjects.o students",
        "subjects.o community", "subjects.o missing", "subjects.o 'online' type",
    ],
    "value": [
        len(ee), n_ids, n_lab, n_online, n_missing, f"{prop:.4f}",
        f"{ci[0]:.4f}", f"{ci[1]:.4f}",
        lab_r, miss_r, f"{row_level_prop:.4f}",
        int((ee["subjects.o"] == "students").sum()),
        int((ee["subjects.o"] == "community").sum()),
        int(ee["subjects.o"].isna().sum()),
        int((ee["subjects.o"] == "online").sum()),
    ],
})
print(summary.to_string(index=False))
print()
print(f"ANSWER: {n_lab}/{n_nonmissing} = {prop:.0%} of Experimental Economics original studies "
      f"were conducted in a lab setting (inferred from online.o == 0).")
