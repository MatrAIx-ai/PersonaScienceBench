"""Average page length of original papers: Experimental Economics (ee) vs Psychology (rpp).

Data: meta-regression_study_data_heterogeneity_in_replication_projects.csv
Choices (researcher-approved):
  - Psychology = project=='rpp', deduplicated to unique original papers by title (95 papers).
  - Experimental Economics = project=='ee' (18 rows = 18 unique papers, no dedup needed).
  - Keep drop==True rows (drop refers to replication-analysis exclusions, not the original paper).
  - Statistic: arithmetic mean of `length` (pages); median reported as robustness note.
"""
import pandas as pd

CSV = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
d = pd.read_csv(CSV)

# --- Experimental Economics: project=='ee', one row per original paper ---
ee = d[d.project == "ee"]
ee_n = ee["title"].nunique()
ee_mean = ee["length"].mean()
ee_median = ee["length"].median()

# --- Psychology: project=='rpp', dedup by title to unique original papers ---
rpp = d[d.project == "rpp"]
rpp_dedup = rpp.groupby("title", as_index=False)["length"].first()
rpp_n = len(rpp_dedup)
rpp_mean = rpp_dedup["length"].mean()
rpp_median = rpp_dedup["length"].median()

# --- Sensitivity checks (not headline) ---
# (a) exclude the 7 rpp rows flagged drop==True
rpp_kept = rpp[rpp["drop"] != True]
rpp_kept_dedup = rpp_kept.groupby("title", as_index=False)["length"].first()
rpp_excl_drop_mean = rpp_kept_dedup["length"].mean()
rpp_excl_drop_n = len(rpp_kept_dedup)
# (b) discipline-based Psychology variant (Social/Cognitive, unique titles across ml1/ml3/rpp)
disc = d[d.discipline.isin(["Social", "Cognitive"])]
disc_dedup = disc.groupby("title", as_index=False)["length"].first()
disc_mean = disc_dedup["length"].mean()
disc_n = len(disc_dedup)

print(f"Experimental Economics (ee): mean = {ee_mean:.2f} pages (median {ee_median:.1f}), n = {ee_n} unique papers")
print(f"Psychology (rpp, dedup by title): mean = {rpp_mean:.2f} pages (median {rpp_median:.1f}), n = {rpp_n} unique papers")
print(f"Difference (ee - rpp): {ee_mean - rpp_mean:.2f} pages; ratio ee/rpp = {ee_mean / rpp_mean:.2f}x")
print(f"Sensitivity A - rpp excluding drop==True rows: mean = {rpp_excl_drop_mean:.2f} (n = {rpp_excl_drop_n})")
print(f"Sensitivity B - discipline-based Psychology (Social+Cognitive, unique titles): mean = {disc_mean:.2f} (n = {disc_n})")
