"""
Question: In which domain do the majority of authors tend to be male for both
original and replication studies?

Data: meta-regression_study_data_heterogeneity_in_replication_projects.csv (File 1 only).
The second CSV (replication_success_data) contains only effect estimates / p-values /
sample sizes and has NO author-gender or discipline columns, so it cannot contribute
to this question and is excluded (no forced join).

Operationalization:
- Male-majority study  : authors_male.{o,r} > 0.5 (exactly 0.5 = evenly mixed, not majority).
- Pair qualifies       : BOTH authors_male.o > 0.5 AND authors_male.r > 0.5 for the same O/R pair.
- Domain               : discipline (Social / Cognitive / Economics).
- Primary unit         : id level (one row per O/R pair; mean authors_male.r across labs,
                         authors_male.o and discipline are constant within id).
- Sensitivity units    : (a) row level (lab-weighted), (b) median instead of mean,
                         (c) >= 0.5 threshold instead of > 0.5.
"""
import pandas as pd

PATH = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
d = pd.read_csv(PATH)
print(f"Loaded {PATH}: {d.shape[0]} rows, {d.shape[1]} cols, {d['id'].nunique()} unique O/R pairs")

def summarize(df, label, thr="gt"):
    """Per-discipline summary for a given unit of analysis."""
    op = (lambda s: s > 0.5) if thr == "gt" else (lambda s: s >= 0.5)
    out = df.groupby("discipline").apply(
        lambda g: pd.Series({
            "n_pairs": g["id"].nunique(),
            "mean_o": g["authors_male.o"].mean(),
            "mean_r": g["authors_male.r"].mean(),
            "frac_o_majority": op(g["authors_male.o"]).mean(),
            "frac_r_majority": op(g["authors_male.r"]).mean(),
            "frac_BOTH_majority": (op(g["authors_male.o"]) & op(g["authors_male.r"])).mean(),
        }),
        include_groups=False,
    )
    out.index.name = "discipline"
    print(f"\n=== {label} (threshold: {'>' if thr=='gt' else '>='} 0.5) ===")
    print(out.round(3).to_string())
    return out

# --- Primary: id-level collapse ---
id_lvl = (d.groupby("id")
            .agg(discipline=("discipline", "first"),
                 authors_male_o=("authors_male.o", "first"),
                 authors_male_r=("authors_male.r", "mean"),   # mean across labs
                 project=("project", "first"))
            .reset_index()
            .rename(columns={"authors_male_o": "authors_male.o",
                             "authors_male_r": "authors_male.r"}))
print(f"\nId-level table: {id_lvl.shape[0]} rows (O/R pairs)")
primary = summarize(id_lvl, "PRIMARY: id-level (one row per O/R pair)")

# --- Sensitivity A: row level (lab-weighted) ---
sensA = summarize(d, "SENSITIVITY A: row-level (lab-weighted)")

# --- Sensitivity B: id-level, >= 0.5 threshold ---
sensB = summarize(id_lvl, "SENSITIVITY B: id-level, >= 0.5 threshold", thr="ge")

# --- Sensitivity C: id-level, medians instead of means ---
med = (d.groupby("id")
         .agg(discipline=("discipline", "first"),
              med_o=("authors_male.o", "median"),
              med_r=("authors_male.r", "median")))
med_out = med.groupby("discipline").agg(
    n_pairs=("med_o", "size"),
    median_o=("med_o", "median"),
    median_r=("med_r", "median"),
).round(3)
print("\n=== SENSITIVITY C: per-discipline medians (id-level) ===")
print(med_out.to_string())

# --- Winner under each view ---
print("\n=== Conclusion check ===")
views = {"PRIMARY id-level >0.5": primary,
         "SENS-A row-level >0.5": sensA,
         "SENS-B id-level >=0.5": sensB}
for name, t in views.items():
    top_both = t["frac_BOTH_majority"].idxmax()
    both_means_gt = t[(t["mean_o"] > 0.5) & (t["mean_r"] > 0.5)].index.tolist()
    print(f"{name}: highest BOTH>0.5 share = {top_both} "
          f"({t.loc[top_both,'frac_BOTH_majority']:.3f}); disciplines with BOTH means > 0.5: {both_means_gt}")

print("\nEconomics base size (id-level pairs):",
      int(primary.loc["Economics", "n_pairs"]),
      "of", int(primary["n_pairs"].sum()), "total pairs")

id_lvl.to_csv("analysis/id_level_pairs.csv", index=False)
