"""
Analysis: Demographic disparities in median 1985 wealth among the ever-incarcerated
Dataset: data/nls_incarceration_processed.csv (NLSY79 cohort extract)
"""
import pandas as pd
import numpy as np

df = pd.read_csv('data/nls_incarceration_processed.csv')
W = 'composite_wealth_1985'

# ---------- 1. Overall structure & data quality ----------
print("="*70)
print("1. STRUCTURE")
print("="*70)
print(f"Rows: {len(df)}, Columns: {df.shape[1]}")
print(df.dtypes)
print("Missing values per column:\n", df.isna().sum())

# ---------- 2. Distributions ----------
print("\n" + "="*70)
print("2. DISTRIBUTIONS")
print("="*70)
for c in ['race','sex','ever_jailed']:
    print(f"\n{c}:\n{df[c].value_counts()}")

# ---------- 3. Wealth diagnostics ----------
print("\n" + "="*70)
print("3. WEALTH 1985 DIAGNOSTICS")
print("="*70)
w = df[W]
print(w.describe().round(1))
print(f"zeros: {(w==0).sum()} ({(w==0).mean()*100:.1f}%), negatives: {(w<0).sum()} ({(w<0).mean()*100:.1f}%)")

# ---------- 4. Core analysis: medians among ever_jailed==1 ----------
print("\n" + "="*70)
print("4. MEDIAN 1985 WEALTH, EVER JAILED (n=%d) vs NEVER JAILED (n=%d)" %
      ((df.ever_jailed==1).sum(), (df.ever_jailed==0).sum()))
print("="*70)

def cell_stats(sub):
    return pd.Series({
        'n': len(sub),
        'median': sub[W].median(),
        'mean': sub[W].mean().round(0),
        'pct_zero': (sub[W]==0).mean()*100,
        'pct_neg': (sub[W]<0).mean()*100,
        'pct_zeroneg': (sub[W]<=0).mean()*100,
    })

for label, sub in [('EVER JAILED', df[df.ever_jailed==1]),
                   ('NEVER JAILED', df[df.ever_jailed==0]),
                   ('FULL SAMPLE', df)]:
    print(f"\n--- {label}: race x sex ---")
    print(sub.groupby(['race','sex']).apply(cell_stats, include_groups=False).round(1))

    print(f"\n--- {label}: race only ---")
    print(sub.groupby('race').apply(cell_stats, include_groups=False).round(1))

    print(f"\n--- {label}: sex only ---")
    print(sub.groupby('sex').apply(cell_stats, include_groups=False).round(1))

    print(f"{label} overall median: {sub[W].median()}")

# ---------- 5. Jailed vs never-jailed gap per race x sex cell ----------
print("\n" + "="*70)
print("5. JAILED-VS-NEVER GAP PER CELL (median difference and ratio)")
print("="*70)
rows = []
for (r, s), sub in df.groupby(['race','sex']):
    m_j = sub.loc[sub.ever_jailed==1, W]
    m_n = sub.loc[sub.ever_jailed==0, W]
    rows.append({'race': r, 'sex': s, 'n_jailed': len(m_j), 'n_never': len(m_n),
                 'median_jailed': m_j.median(), 'median_never': m_n.median(),
                 'diff': m_j.median()-m_n.median(),
                 'ratio': (m_j.median()/m_n.median()) if m_n.median()!=0 else np.nan})
gap = pd.DataFrame(rows)
print(gap.round(2))

# ---------- 6. Key disparity contrasts among the ever-incarcerated ----------
print("\n" + "="*70)
print("6. KEY CONTRASTS WITHIN EVER JAILED")
print("="*70)
j = df[df.ever_jailed==1]
med = j.groupby(['race','sex'])[W].median()
def med_of(r, s): return j.loc[(j.race==r)&(j.sex==s), W].median()
pairs = [
    ('white male vs black male', med_of('white','male'), med_of('black','male')),
    ('white male vs hispanic male', med_of('white','male'), med_of('hipanic','male')),
    ('black male vs black female', med_of('black','male'), med_of('black','female')),
    ('white male vs white female', med_of('white','male'), med_of('white','female')),
]
for name, a, b in pairs:
    print(f"{name}: {a:,.0f} vs {b:,.0f}  (gap = {a-b:,.0f})")
male = j[j.sex=='male']
print(f"\nAmong jailed MEN: white median {male[male.race=='white'][W].median():,.0f}, "
      f"black {male[male.race=='black'][W].median():,.0f}, "
      f"hispanic {male[male.race=='hipanic'][W].median():,.0f}")
print(f"Overall jailed median {j[W].median():,.0f} vs never {df[df.ever_jailed==0][W].median():,.0f}")

# save tables
gap.to_csv('outputs/jailed_vs_never_gaps.csv', index=False)
j.groupby(['race','sex']).apply(cell_stats, include_groups=False).round(2).to_csv('outputs/ever_jailed_cell_stats.csv')
df[df.ever_jailed==0].groupby(['race','sex']).apply(cell_stats, include_groups=False).round(2).to_csv('outputs/never_jailed_cell_stats.csv')
print("\nSaved: outputs/jailed_vs_never_gaps.csv, outputs/ever_jailed_cell_stats.csv, outputs/never_jailed_cell_stats.csv")
