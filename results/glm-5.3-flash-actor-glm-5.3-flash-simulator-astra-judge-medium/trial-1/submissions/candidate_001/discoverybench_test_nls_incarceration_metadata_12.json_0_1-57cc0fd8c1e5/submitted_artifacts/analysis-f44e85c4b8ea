"""NLSY79 incarceration x wealth analysis: black respondents by baseline (1985) wealth tier.

Primary contrast: within baseline-1985 composite-wealth quartile, jailed vs non-jailed
1985->1996 wealth trajectory, summarized by medians (primary), means, and a
within-tier difference-in-differences (DiD). Secondary: jailed/non-jailed ratios.
1990 reported descriptively only (jailing year unknown -> ambiguous timing).
"""
import pandas as pd, numpy as np

W = ['composite_wealth_1985', 'composite_wealth_1990', 'composite_wealth_1996']
df = pd.read_csv('data/nls_incarceration_processed.csv')

# ---- 0. data hygiene: flag extreme values, do not drop ----------------------
for c in W:
    lo, hi = df[c].quantile([.001, .999])
    ext = df[(df[c] < min(lo, -200000)) | (df[c] > hi * 1.5)]
    print(f'OUTLIER FLAG {c}: 0.1%/99.9% pct = {lo:,.0f}/{hi:,.0f}; flagged rows: {len(ext)}')
    if len(ext): print(ext[['race','ever_jailed']+W].to_string(index=False))

b = df[df.race == 'black'].copy()          # 'hipanic' label quirk noted; out of scope
TIERS = {'quartiles': ['Q1_low', 'Q2', 'Q3', 'Q4_high'],
         'tertiles':  ['T1_low', 'T2', 'T3_high']}
for tag, q in [('quartiles', 4), ('tertiles', 3)]:
    b['tier_' + tag] = pd.qcut(b.composite_wealth_1985.rank(method='first'), q, labels=TIERS[tag])

def cell_stats(d, tiercol, labels):
    rows = []
    for t in labels:
        for j in [0, 1]:
            g = d[(d[tiercol] == t) & (d.ever_jailed == j)]
            rows.append(dict(tier=t, jailed=j, n=len(g),
                med1985=g.composite_wealth_1985.median(), med1990=g.composite_wealth_1990.median(),
                med1996=g.composite_wealth_1996.median(),
                mean1985=g.composite_wealth_1985.mean(), mean1996=g.composite_wealth_1996.mean(),
                med_dchange=(g.composite_wealth_1996 - g.composite_wealth_1985).median(),
                mean_dchange=(g.composite_wealth_1996 - g.composite_wealth_1985).mean(),
                frac_zero96=(g.composite_wealth_1996 <= 0).mean()))
    return pd.DataFrame(rows)

def did(tab, stat):
    piv = tab.pivot(index='tier', columns='jailed', values=stat)
    piv['DiD'] = piv[1] - piv[0]
    m96 = tab.pivot(index='tier', columns='jailed', values='med1996')
    piv['ratio_med96_j_over_nj'] = (m96[1] / m96[0].replace(0, np.nan)).round(2)
    return piv

for tag in ['quartiles', 'tertiles']:
    lab = TIERS[tag]
    tab = cell_stats(b, 'tier_' + tag, lab)
    print(f'\n===== {tag.upper()} : cell-level stats (black respondents, n={len(b)}) =====')
    print(tab.round(2).to_string(index=False))
    for stat, l in [('med_dchange', 'MEDIAN 1985->1996 change'), ('mean_dchange', 'MEAN 1985->1996 change')]:
        print(f'\n--- Within-tier DiD on {l} ({tag}) ---')
        print(did(tab, stat).round(2).to_string())

# ---- winsorized robustness (1%/99%), quartiles ------------------------------
bw = b.copy()
for c in W:
    lo, hi = bw[c].quantile([.01, .99]); bw[c + '_w'] = bw[c].clip(lo, hi)
bw['dchange_w'] = bw.composite_wealth_1996_w - bw.composite_wealth_1985_w
print('\n===== ROBUSTNESS: 1%/99% winsorized, quartiles =====')
print(bw.groupby(['tier_quartiles', 'ever_jailed']).dchange_w
        .agg(n='size', median_change='median', mean_change='mean').round(0).to_string())
piv = bw.pivot_table(index='tier_quartiles', columns='ever_jailed',
                     values='dchange_w', aggfunc='median')
print('\nWinsorized median-change DiD (jailed - non-jailed):'); print((piv[1] - piv[0]).round(0).to_string())

# ---- whole-black-sample summary ---------------------------------------------
print('\n===== ALL black respondents by ever_jailed (n jailed=%d, non=%d) =====' %
      ((b.ever_jailed == 1).sum(), (b.ever_jailed == 0).sum()))
print(b.groupby('ever_jailed')[W].agg(['median', 'mean']).round(0).to_string())
chg = b.assign(d=b.composite_wealth_1996 - b.composite_wealth_1985)
print('\n1985->1996 change by ever_jailed:'); print(chg.groupby('ever_jailed').d.agg(['median','mean']).round(0).to_string())
print('\nShare with wealth_1996 <= 0: jailed %.2f vs non-jailed %.2f' %
      (b[b.ever_jailed==1].composite_wealth_1996.le(0).mean(),
       b[b.ever_jailed==0].composite_wealth_1996.le(0).mean()))
print('\nShare with wealth_1985 <= 0 (baseline check): jailed %.2f vs non-jailed %.2f' %
      (b[b.ever_jailed==1].composite_wealth_1985.le(0).mean(),
       b[b.ever_jailed==0].composite_wealth_1985.le(0).mean()))
