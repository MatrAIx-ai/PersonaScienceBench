"""Median wealth growth among black females, NLSY79 processed data.
Primary metric: dollar change in median wealth between consecutive waves.
All respondents retained; wealth>0 sensitivity check reported alongside."""
import pandas as pd

df = pd.read_csv('data/nls_incarceration_processed.csv')
YEARS = ['1985', '1990', '1996']
COLS = [f'composite_wealth_{y}' for y in YEARS]

# (1) Black female subgroup
sub = df[(df['race'] == 'black') & (df['sex'] == 'female')]
medians = {y: sub[f'composite_wealth_{y}'].median() for y in YEARS}
print(f"Black females: n={len(sub)} (of {len(df[df.race=='black'])} black, {len(df)} total)")
print("\nMedian composite wealth, black females:")
for y in YEARS:
    print(f"  {y}: ${medians[y]:,.0f}")
d1 = medians['1990'] - medians['1985']
d2 = medians['1996'] - medians['1990']
p1 = 100 * d1 / abs(medians['1985'])
p2 = 100 * d2 / abs(medians['1990'])
print(f"1985->1990: ${d1:,.0f}  ({p1:+.1f}%)")
print(f"1990->1996: ${d2:,.0f}  ({p2:+.1f}%)")

# (2) Context: all race x sex subgroups
print("\nCONTEXT - medians and interval changes by race x sex subgroup:")
rows = []
for r in sorted(df['race'].unique()):
    for s in sorted(df['sex'].unique()):
        g = df[(df['race'] == r) & (df['sex'] == s)]
        m = [g[c].median() for c in COLS]
        rows.append({
            'subgroup': f'{r}/{s}', 'n': len(g),
            'median_1985': m[0], 'median_1990': m[1], 'median_1996': m[2],
            'chg_1985_1990_$': m[1] - m[0], 'chg_1990_1996_$': m[2] - m[1],
            'chg_1985_1990_%': 100 * (m[1] - m[0]) / abs(m[0]),
            'chg_1990_1996_%': 100 * (m[2] - m[1]) / abs(m[1]),
        })
ctx = pd.DataFrame(rows)
print(ctx.to_string(index=False,
      float_format=lambda x: f'{x:,.1f}'))

# (3) Sensitivity: positive wealth only
print("\nSENSITIVITY - black females with composite_wealth > 0 only:")
sp = {}
for y in YEARS:
    sv = sub[f'composite_wealth_{y}']
    sv = sv[sv > 0]
    sp[y] = sv.median()
    print(f"  {y}: n={len(sv)}, median=${sv.median():,.0f}")
sd1 = sp['1990'] - sp['1985']
sd2 = sp['1996'] - sp['1990']
print(f"1985->1990: ${sd1:,.0f}  ({100*sd1/sp['1985']:+.1f}%)")
print(f"1990->1996: ${sd2:,.0f}  ({100*sd2/sp['1990']:+.1f}%)")
print("Caveat: excluding wealth<=0 flips the largest-interval ranking to 1990->1996 in dollars.")

# Save outputs
with open('outputs/results.txt', 'w') as f:
    f.write("Black females medians: " + str(medians) + "\n")
    f.write(f"1985->1990: +${d1:,.0f} ({p1:+.1f}%)\n1990->1996: +${d2:,.0f} ({p2:+.1f}%)\n")
    f.write("\nContext table:\n" + ctx.to_string(index=False) + "\n")
    f.write(f"\nPositive-wealth sensitivity: medians {sp}; "
            f"1985->1990 +${sd1:,.0f}; 1990->1996 +${sd2:,.0f} (ranking flips)\n")
ctx.to_csv('outputs/subgroup_context.csv', index=False)
