"""
NLSY79 incarceration/wealth: change in wealth inequality for white males and
white females, 1990 -> 1996. Primary framing: within-group dispersion.
Negative & zero wealth retained; sensitivity for the 1990 min outlier
(-866,400) via winsorizing (top 1%) and removal, plus positive-only Gini.
ever_jailed: descriptive only (white male n=57, white female n=12).
Assumption: composite wealth in nominal USD (no deflator available).
"""
import numpy as np
import pandas as pd

pd.set_option("display.width", 160)
df = pd.read_csv("data/nls_incarceration_processed.csv")

WHITE = df[df.race == "white"].copy()
GROUPS = [("white male", WHITE[WHITE.sex == "male"]),
          ("white female", WHITE[WHITE.sex == "female"])]
YEARS = ["1990", "1996"]


def gini_full(x):
    """Gini on full distribution (valid with zeros/negatives):
    G = mean|x_i - x_j| / (2 * mean|x|)."""
    x = np.asarray(x, dtype=float)
    mad = np.abs(x[:, None] - x[None, :]).sum() / (len(x) ** 2)
    return mad / (2 * np.abs(x).mean())


def gini_positive(x):
    x = np.asarray(x, dtype=float)
    x = x[x > 0]
    if len(x) < 2:
        return np.nan
    mad = np.abs(x[:, None] - x[None, :]).sum() / (len(x) ** 2)
    return mad / (2 * x.mean())


def stats(s, gini_fn=gini_full):
    s = np.asarray(s, dtype=float)
    n = len(s)
    mean, med = s.mean(), np.median(s)
    sd = s.std(ddof=1)
    p10, p50, p90 = np.percentile(s, [10, 50, 90])
    top_share = s[s >= p90].sum() / s.sum()
    out = dict(n=n, neg=int((s < 0).sum()), zero=int((s == 0).sum()),
               mean=mean, median=med, sd=sd,
               cv=sd / mean if mean > 0 else np.nan,
               p90=p90, p50=p50, p10=p10,
               p90_over_p50=p90 / p50 if p50 != 0 else np.nan,
               p50_over_p10=p50 / p10 if p10 > 0 else np.nan,  # undefined when P10=0
               top_decile_share=top_share, gini=gini_fn(s))
    return out


def table(sub, gini_fn=gini_full, label=""):
    rows = {}
    for name, _ in GROUPS:
        sex = "male" if "male" in name and "female" not in name else "female"
        g = sub[sub.sex == sex]
        for y in YEARS:
            rows[f"{name} {y}"] = stats(g[f"composite_wealth_{y}"], gini_fn)
    t = pd.DataFrame(rows).T
    print(f"\n=== {label} ===")
    print(t.round(4).to_string())
    return t


# ---------- Primary: full distribution (negatives & zeros kept) ----------
print("Sample sizes / counts (diagnostics):")
for name, g in GROUPS:
    print(f"  {name}: n={len(g)}, "
          f"jailed n={int(g.ever_jailed.sum())}")
print(f"  1990 min = {df.composite_wealth_1990.min():,} "
      f"(n at that value: {(df.composite_wealth_1990 == df.composite_wealth_1990.min()).sum()})")

primary = table(WHITE, gini_full, "PRIMARY: full distribution (negatives & zeros kept), nominal USD")

# ---------- Sensitivity 1: remove single worst 1990 outlier ----------
w_sens = WHITE.copy()
mask = w_sens.composite_wealth_1990 == df.composite_wealth_1990.min()
w_sens = w_sens[~mask]
print(f"\nRemoved 1990 outlier rows (white subsample): {int(mask.sum())}; remaining n={len(w_sens)}")
sens_drop = table(w_sens, gini_full, "SENSITIVITY A: 1990 minimum outlier (-866,400) removed")

# ---------- Sensitivity 2: winsorize top 1% per group-year ----------
w_win = WHITE.copy()
for name, g in GROUPS:
    for y in YEARS:
        col = f"composite_wealth_{y}"
        hi = np.percentile(g[col], 99)
        w_win[col] = w_win[col].astype(float)
        w_win.loc[w_win.index.isin(g.index), col] = g[col].clip(upper=hi)
sens_win = table(w_win, gini_full, "SENSITIVITY B: top 1% winsorized per group-year (negatives kept)")

# ---------- Sensitivity 3: positive-only Gini ----------
table(WHITE, gini_positive, "SENSITIVITY C: Gini on positive wealth only")

# ---------- ever_jailed: descriptive only ----------
print("\n=== DESCRIPTIVE ONLY: ever_jailed breakdown (SMALL n, NOT a primary comparison) ===")
rows = []
for name, g in GROUPS:
    for y in YEARS:
        for j, sub in [("jailed", g[g.ever_jailed == 1]), ("never", g[g.ever_jailed == 0])]:
            s = sub[f"composite_wealth_{y}"]
            rows.append(dict(group=name, jailed=j, year=y, n=len(s),
                             mean=round(s.mean(), 0), median=s.median(),
                             sd=round(s.std(ddof=1), 0)))
jd = pd.DataFrame(rows)
print(jd.to_string(index=False))
print("CAVEAT: jailed white males n=57, jailed white females n=12 -> estimates are "
      "highly unstable; ever_jailed (1985-1994) also overlaps the 1990-1996 window, "
      "so no causal reading is intended.")

# ---------- Delta table (1990 -> 1996) ----------
print("\n=== CHANGE 1990 -> 1996 (primary) ===")
for name, g in GROUPS:
    a = stats(g.composite_wealth_1990); b = stats(g.composite_wealth_1996)
    print(f"{name}:")
    for k in ["mean", "median", "sd", "gini", "p90_over_p50", "top_decile_share"]:
        av, bv = a[k], b[k]
        if pd.isna(av) or pd.isna(bv):
            print(f"  {k}: {av} -> {bv} (undefined)")
        else:
            print(f"  {k}: {av:,.3f} -> {bv:,.3f}  (change {bv-av:+,.3f})")

primary.to_csv("outputs/primary_stats_white_1990_1996.csv")
sens_drop.to_csv("outputs/sensitivity_outlier_removed.csv")
sens_win.to_csv("outputs/sensitivity_winsorized.csv")
jd.to_csv("outputs/ever_jailed_descriptive.csv", index=False)
print("\nSaved: outputs/primary_stats_white_1990_1996.csv, "
      "outputs/sensitivity_outlier_removed.csv, outputs/sensitivity_winsorized.csv, "
      "outputs/ever_jailed_descriptive.csv")
