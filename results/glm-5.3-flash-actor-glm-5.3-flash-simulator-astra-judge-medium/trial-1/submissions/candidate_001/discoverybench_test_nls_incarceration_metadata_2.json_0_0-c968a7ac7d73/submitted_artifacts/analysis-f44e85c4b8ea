"""
Analysis: wealth (net worth) vs criminal record (ever_jailed, jailed 1985-1994)
Dataset: data/nls_incarceration_processed.csv (NLSY79 processed extract)

Plan (approved):
- Per-year comparisons (1985, 1990, 1996): Welch t-test + Mann-Whitney U
- Unadjusted + adjusted (race + sex, HC-robust SE OLS); quantile (median) regression robustness
- Original data values are never modified; 'hipanic' is only mapped for display labels.
"""
import pandas as pd
import numpy as np
from scipy import stats
import statsmodels.formula.api as smf

df = pd.read_csv('data/nls_incarceration_processed.csv')
years = ['1985', '1990', '1996']
cols = [f'composite_wealth_{y}' for y in years]
assert df.isna().sum().sum() == 0, "unexpected missing values"

print("=" * 78)
print("GROUP DESCRIPTIVES (ever_jailed 0 vs 1)")
print("=" * 78)
rows = []
for y, c in zip(years, cols):
    g0, g1 = df.loc[df.ever_jailed == 0, c], df.loc[df.ever_jailed == 1, c]
    rows.append({
        'year': y, 'n_jailed': len(g1), 'n_not': len(g0),
        'mean_jailed': g1.mean(), 'mean_not': g0.mean(),
        'median_jailed': g1.median(), 'median_not': g0.median(),
        'p25_jailed': g1.quantile(.25), 'p75_jailed': g1.quantile(.75),
        'p25_not': g0.quantile(.25), 'p75_not': g0.quantile(.75),
        'sd_jailed': g1.std(), 'sd_not': g0.std(),
    })
desc = pd.DataFrame(rows)
print(desc.to_string(index=False, float_format=lambda x: f'{x:,.0f}'))

print()
print("=" * 78)
print("UNADJUSTED TESTS: Welch t-test (unequal var) + Mann-Whitney U")
print("=" * 78)
res = []
for y, c in zip(years, cols):
    g0, g1 = df.loc[df.ever_jailed == 0, c], df.loc[df.ever_jailed == 1, c]
    t, tp = stats.ttest_ind(g1, g0, equal_var=False)
    u, up = stats.mannwhitneyu(g1, g0, alternative='less')  # H1: jailed < not
    # two-sided MWU for reference
    u2, up2 = stats.mannwhitneyu(g1, g0, alternative='two-sided')
    res.append({'year': y, 'welch_t': t, 'welch_p_2sided': tp,
                'MWU_U': u, 'MWU_p_1sided_less': up, 'MWU_p_2sided': up2,
                'mean_diff': g1.mean() - g0.mean()})
print(pd.DataFrame(res).to_string(index=False, float_format=lambda x: f'{x:,.4g}'))

print()
print("=" * 78)
print("ADJUSTED MODELS per year: wealth ~ ever_jailed + C(race) + C(sex)")
print("OLS with HC3-robust SE, and median (quantile) regression")
print("=" * 78)
for y, c in zip(years, cols):
    d = df.copy()
    m = smf.ols(f'{c} ~ ever_jailed + C(race) + C(sex)', data=d).fit(cov_type='HC3')
    ci = m.conf_int().loc['ever_jailed']
    print(f"\n--- {y}: OLS (HC3) ---")
    print(f"  ever_jailed coef = {m.params['ever_jailed']:,.1f}  "
          f"95% CI [{ci[0]:,.1f}, {ci[1]:,.1f}]  p = {m.pvalues['ever_jailed']:.3g}")
    print(f"  R2 = {m.rsquared:.4f}")
    med = smf.quantreg(f'{c} ~ ever_jailed + C(race) + C(sex)', data=d).fit(q=0.5)
    print(f"  median regression: ever_jailed coef = {med.params['ever_jailed']:,.1f}  "
          f"p = {med.pvalues['ever_jailed']:.3g}")

print()
print("=" * 78)
print("SENSITIVITY: winsorized (1%/99%) Welch t-test + rank-transform")
print("=" * 78)
for y, c in zip(years, cols):
    lo, hi = df[c].quantile([.01, .99])
    w = df[c].clip(lo, hi)
    t, tp = stats.ttest_ind(w[df.ever_jailed == 1], w[df.ever_jailed == 0], equal_var=False)
    print(f"  {y}: winsorized Welch t = {t:,.3f}, p = {tp:.3g}")

print()
print("=" * 78)
print("STRATUM COUNTS + STRATIFIED MEANS (flag underpowered cells)")
print("=" * 78)
ct = df.groupby(['race', 'sex', 'ever_jailed']).size().unstack(fill_value=0)
ct.columns = ['not_jailed', 'jailed']
print(ct.to_string())
print("\nStratified wealth medians (jailed vs not) — interpret small cells with caution:")
strat = df.groupby(['race', 'sex', 'ever_jailed'])[cols].median().unstack()
print(strat.to_string(float_format=lambda x: f'{x:,.0f}'))

print()
print("=" * 78)
print("VERDICT SUMMARY at alpha = 0.05")
print("=" * 78)
for y, c in zip(years, cols):
    g0, g1 = df.loc[df.ever_jailed == 0, c], df.loc[df.ever_jailed == 1, c]
    _, tp = stats.ttest_ind(g1, g0, equal_var=False)
    _, up = stats.mannwhitneyu(g1, g0, alternative='less')
    d = df.copy()
    m = smf.ols(f'{c} ~ ever_jailed + C(race) + C(sex)', data=d).fit(cov_type='HC3')
    med = smf.quantreg(f'{c} ~ ever_jailed + C(race) + C(sex)', data=d).fit(q=0.5)
    print(f"{y}: unadj t p={tp:.3g} | MWU(less) p={up:.3g} | "
          f"adj OLS p={m.pvalues['ever_jailed']:.3g} | median-reg p={med.pvalues['ever_jailed']:.3g}")

desc.to_csv('analysis/group_descriptives.csv', index=False)
pd.DataFrame(res).to_csv('analysis/unadjusted_tests.csv', index=False)
print("\nSaved: analysis/group_descriptives.csv, analysis/unadjusted_tests.csv")
