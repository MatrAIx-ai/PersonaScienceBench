"""
NLSY79 analysis: Does considering academic characteristics alter the
effects of SES and race on BA-track college attendance?

Outcome note (stated up front): 'BA degree completion' is NOT observed in
nls_raw.csv. The only attainable outcome proxy is BA-track college
attendance = ever reported living in a DORM/FRATERNITY/SORORITY residence
(type 3) in any wave 1981-1996. All results are about this proxy.
"""
import numpy as np
import pandas as pd
import statsmodels.api as sm
import statsmodels.formula.api as smf
import json, sys

pd.set_option('display.width', 200)

df = pd.read_csv('data/nls_raw.csv')

# ---------------------------------------------------------------- outcome
res_cols = [c for c in df.columns if c.startswith('Type of residence')]
df['dorm_ever'] = (df[res_cols] == 3).any(axis=1).astype(int)

# ---------------------------------------------------------------- SES
# income topcodes -> winsorize at cap
inc = df['Total net family income, previous calendar year, 1979'].copy()
inc_top = 75001.0
inc = inc.clip(upper=inc_top)
df['log_income_79'] = np.log(inc.replace(0, np.nan) + 1)

med = df["Highest grade completed by respondent's mother, 1979"]
fad = df["Highest grade completed by respondent's father, 1979"]

def z(s):
    return (s - s.mean()) / s.std()

# standardized SES composite: z(mother edu)+z(father edu)+z(log income), mean of available
ses = pd.concat([z(med), z(fad), z(df['log_income_79'])], axis=1)
ses_missing = ses.isna().sum(axis=1)
df['ses_comp'] = ses.mean(axis=1, skipna=True)
df['ses_comp'] = (df['ses_comp'] - df['ses_comp'].mean()) / df['ses_comp'].std()
df['ses_missing_n'] = ses_missing

# ---------------------------------------------------------------- academic
asv_cols = ['ASVAB - Arithmetic Reasoning Z Score (rounded), 1981',
            'ASVAB - Word Knowledge Z Score (rounded), 1981',
            'ASVAB - Paragraph Comprehension Z Score (rounded), 1981',
            'ASVAB - Mathematics Knowledge Z Score (rounded), 1981']
az = df[asv_cols].apply(z)
df['asvab_comp'] = az.mean(axis=1, skipna=True)
df['asvab_comp'] = (df['asvab_comp'] - df['asvab_comp'].mean()) / df['asvab_comp'].std()
df['asvab_n'] = df[asv_cols].notna().sum(axis=1)

r = df['Rank in class last year attended at this school, 1981']
n = df['Number of students in class last year attended at this school, 1981']
df['rank_pct'] = 1 - r / n   # empirically confirmed: rank 1 = top (corr +0.50 with ASVAB)

df['hgc79'] = df['Highest grade completed, 1979']

# ---------------------------------------------------------------- controls
df['female'] = (df['Sex of respondent, 1979'] == 2).astype(int)
df['age79'] = df['Age of respondent, 1979']
df['black'] = (df['Racial/ethnic cohort, 1979'] == 1).astype(int)
df['hisp'] = (df['Racial/ethnic cohort, 1979'] == 2).astype(int)

# ---------------------------------------------------------------- samples
MODEL_VARS = ['ses_comp', 'black', 'hisp', 'female', 'age79',
              'asvab_comp', 'rank_pct', 'hgc79']
cc = df.dropna(subset=MODEL_VARS).copy()
print(f'Complete-case analytic sample: n={len(cc)}, outcome prevalence (dorm_ever)={cc.dorm_ever.mean():.4f}')

# ------------------------------------------------- descriptives on cc sample
desc = {}
desc['outcome_prevalence_by_race'] = cc.groupby(['black','hisp']).dorm_ever.agg(['mean','count']).to_dict('index')
cc['ses_t3'] = pd.qcut(cc['ses_comp'], 3, labels=['low','mid','high'])
desc['outcome_prevalence_by_ses_tercile'] = cc.groupby('ses_t3', observed=True).dorm_ever.agg(['mean','count']).round(4).to_dict('index')
desc['correlations'] = cc[['asvab_comp','rank_pct','hgc79','ses_comp','black','hisp','dorm_ever']].corr().round(3).to_dict()
print('\nDorm-attendance prevalence by race:')
print(pd.Series(desc['outcome_prevalence_by_race']).apply(lambda d: (round(d['mean'],4), d['count'])))
print('\nBy SES tercile:'); print(pd.DataFrame(desc['outcome_prevalence_by_ses_t3'] if 'ses_t3' in desc else desc['outcome_prevalence_by_ses_tercile']))
print('\nCorrelations (cc sample):'); print(cc[['asvab_comp','rank_pct','hgc79','ses_comp','black','hisp','dorm_ever']].corr().round(3))

CTRL = 'female + age79'
f0 = f'dorm_ever ~ ses_comp + black + hisp + {CTRL}'
f1 = f'dorm_ever ~ ses_comp + black + hisp + asvab_comp + rank_pct + hgc79 + {CTRL}'
f2 = f'dorm_ever ~ ses_comp + black + hisp + asvab_comp + rank_pct + hgc79 + ses_comp:asvab_comp + black:asvab_comp + hisp:asvab_comp + {CTRL}'

FOCUS = ['ses_comp', 'black', 'hisp', 'asvab_comp', 'rank_pct', 'hgc79']

def attenuation(mod0, mod1, names, labels):
    rows = []
    for nm, lb in zip(names, labels):
        b1 = mod1.params[nm]
        if nm not in mod0.params.index:
            rows.append({'term': lb, 'beta_M0': None, 'se_M0': None,
                         'beta_M1': round(b1, 4), 'se_M1': round(mod1.bse[nm], 4),
                         'pct_change_beta': None})
            continue
        b0 = mod0.params[nm]
        att = np.nan if b0 == 0 else 100 * (b0 - b1) / b0
        rows.append({'term': lb,
                     'beta_M0': round(b0, 4), 'se_M0': round(mod0.bse[nm], 4),
                     'beta_M1': round(b1, 4), 'se_M1': round(mod1.bse[nm], 4),
                     'pct_change_beta': round(att, 1)})
    return pd.DataFrame(rows)

results = {}

for model_type in ['logit', 'lpm']:
    print(f'\n================ {model_type.upper()} (complete case, n={len(cc)}) ================')
    m0 = smf.logit(f0, data=cc).fit(disp=0) if model_type=='logit' else smf.ols(f0, data=cc).fit(cov_type='HC1')
    m1 = smf.logit(f1, data=cc).fit(disp=0) if model_type=='logit' else smf.ols(f1, data=cc).fit(cov_type='HC1')
    m2 = smf.logit(f2, data=cc).fit(disp=0) if model_type=='logit' else smf.ols(f2, data=cc).fit(cov_type='HC1')
    att = attenuation(m0, m1, FOCUS,
        ['SES composite','Black (vs nonB-nonH)','Hispanic (vs nonB-nonH)','ASVAB composite','Class-rank percentile','HGC 1979'])
    print(att.to_string(index=False))
    for nm, lb in [('ses_comp','SES'),('black','Black'),('hisp','Hispanic')]:
        or0, or1 = np.exp(m0.params[nm]), np.exp(m1.params[nm])
        print(f'  OR shift {lb}: {or0:.3f} -> {or1:.3f}' if model_type=='logit' else f'  LPM coef {lb}: {m0.params[nm]:.4f} -> {m1.params[nm]:.4f}')
    print('\nM2 (with interactions) key terms:')
    key2 = FOCUS + ['ses_comp:asvab_comp','black:asvab_comp','hisp:asvab_comp']
    print(m2.params.reindex(key2).round(4).to_string())
    print('M2 p-vals:'); print(m2.pvalues.reindex(key2).round(4).to_string())
    print(f'M0/M1/M2 pseudo-R2 or R2: '
          f'{(1 - m0.llf/m0.llnull) if model_type=="logit" else m0.rsquared:.3f} / '
          f'{(1 - m1.llf/m1.llnull) if model_type=="logit" else m1.rsquared:.3f} / '
          f'{(1 - m2.llf/m2.llnull) if model_type=="logit" else m2.rsquared:.3f}')
    results[model_type] = {
        'attenuation': att.to_dict('records'),
        'M0_params': m0.params.round(4).to_dict(), 'M1_params': m1.params.round(4).to_dict(),
        'M2_params': m2.params.round(4).to_dict(), 'M2_pvals': m2.pvalues.round(4).to_dict(),
        'n': int(len(cc))}

# ------------------------------------------------- sensitivity: wealth
print('\n--- Sensitivity: add log family net wealth 1985 (complete case incl. wealth) ---')
ccw = cc.dropna(subset=['Family net wealth, 1985']).copy()
ccw['log_wealth85'] = np.log(ccw['Family net wealth, 1985'].clip(lower=1) + 1)
m0w = smf.logit(f0 + ' + log_wealth85', data=ccw).fit(disp=0)
m1w = smf.logit(f1 + ' + log_wealth85', data=ccw).fit(disp=0)
print(attenuation(m0w, m1w, FOCUS,
    ['SES composite','Black','Hispanic','ASVAB','rank_pct','HGC79']).to_string(index=False),
    f'(n={len(ccw)}, outcome={ccw.dorm_ever.mean():.3f})')

# ------------------------------------------------- sensitivity: missing indicator (full sample)
print('\n--- Sensitivity: missing-indicator imputation, full N=12,686 ---')
full = df.copy()
for v in ['ses_comp','asvab_comp','rank_pct','hgc79','log_income_79']:
    full[f'{v}_miss'] = full[v].isna().astype(int)
    full[v] = full[v].fillna(full[v].median())
    full[v] = (full[v] - full[v].mean()) / full[v].std()
f0s = 'dorm_ever ~ ses_comp + black + hisp + female + age79'
f1s = 'dorm_ever ~ ses_comp + black + hisp + asvab_comp + rank_pct + hgc79 + female + age79 + ' + \
      ' + '.join([f'{v}_miss' for v in ['ses_comp','asvab_comp','rank_pct','hgc79']])
m0s = smf.logit(f0s, data=full).fit(disp=0)
m1s = smf.logit(f1s, data=full).fit(disp=0)
print(attenuation(m0s, m1s, FOCUS,
    ['SES composite','Black','Hispanic','ASVAB','rank_pct','HGC79']).to_string(index=False),
    f'(n={len(full)}, outcome={full.dorm_ever.mean():.3f})')

def _stringify_keys(o):
    if isinstance(o, dict):
        return {str(k): _stringify_keys(v) for k, v in o.items()}
    if isinstance(o, list):
        return [_stringify_keys(x) for x in o]
    return o

with open('outputs/results.json','w') as fh:
    json.dump({'descriptives': _stringify_keys(desc), 'models': results}, fh, indent=2, default=str)
print('\nSaved outputs/results.json')
