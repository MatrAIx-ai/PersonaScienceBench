"""
NLSY79 analysis: How is the advantage in BA-track (college-enrollment) attainment
for Black students related to SES levels?

Outcome proxy (per approved binding condition): EVER recorded in a
DORM/FRATERNITY/SORORITY residence (code 3) in 1981, 1982, or 1983 =
college-enrollment / BA-track attainment. No post-1979 education variable
exists in the file, so literal BA completion cannot be measured.
"""
import numpy as np
import pandas as pd
import statsmodels.formula.api as smf
from scipy import stats

df = pd.read_csv("data/nls_raw.csv")
n_total = len(df)

RENAME = {
    "Racial/ethnic cohort, 1979": "race",
    "Sex of respondent, 1979": "sex",
    "Age of respondent, 1979": "age79",
    "Highest grade completed by respondent's mother, 1979": "mom_ed",
    "Highest grade completed by respondent's father, 1979": "dad_ed",
    "Highest grade completed, 1979": "hgc79",
    "Total net family income, previous calendar year, 1979": "inc79",
    "Family net wealth, 1985": "wea85",
    "Type of residence respondent is living in, 1981": "res1981",
    "Type of residence respondent is living in, 1982": "res1982",
    "Type of residence respondent is living in, 1983": "res1983",
}
df = df.rename(columns=RENAME)
for c in ["mom_ed", "dad_ed", "hgc79"]:
    df.loc[df[c] >= 90, c] = np.nan          # NLSY sentinel codes -> missing

# ------------------------------------------------------------------ outcome
for y in (1981, 1982, 1983):
    df[f"dorm{y}"] = (df[f"res{y}"] == 3).astype(int)
df["dorm_waves"] = df[["dorm1981", "dorm1982", "dorm1983"]].sum(axis=1)
df["colEnroll"] = (df["dorm_waves"] > 0).astype(int)

print("=" * 78)
print("PROXY STRENGTH: residence code 3 (DORM/FRAT/SORORITY) counts & persistence")
for y in (1981, 1982, 1983):
    print(f"  code 3 in {y}: {df[f'dorm{y}'].sum()} respondents")
pos = df[df["colEnroll"] == 1]
print(f"  proxy-positive total (any wave): {len(pos)}")
print("  number of waves positive among proxy-positive:")
print("   ", pos["dorm_waves"].value_counts().sort_index().to_dict())
n_multi = (pos["dorm_waves"] > 1).sum()
print(f"  positive in MORE THAN ONE wave (persistence): {n_multi} "
      f"({100*n_multi/len(pos):.1f}% of proxy-positive)")
p13 = df.groupby("colEnroll")["hgc79"].apply(lambda s: (s >= 13).mean().round(3))
print(f"  share with >=13 grades by 1979: proxy+ {p13[1]}, proxy- {p13[0]} (construct check)")

# ------------------------------------------------------------------ SES
df["par_ed_max"] = df[["mom_ed", "dad_ed"]].max(axis=1)
df["log_inc79"] = np.log1p(df["inc79"].clip(lower=0))
df["z_ed"] = (df["par_ed_max"] - df["par_ed_max"].mean()) / df["par_ed_max"].std()
df["z_inc"] = (df["log_inc79"] - df["log_inc79"].mean()) / df["log_inc79"].std()
df["ses_raw"] = df[["z_ed", "z_inc"]].mean(axis=1, skipna=False)
ses_complete = df["ses_raw"].notna()
print("=" * 78)
print(f"COMPLETE-CASE SES: {ses_complete.sum()} / {n_total} "
      f"({100*ses_complete.mean():.1f}%) retained")
d = df[ses_complete].copy()
t1, t2 = d["ses_raw"].quantile([1/3, 2/3])
d["sesT"] = pd.cut(d["ses_raw"], [-np.inf, t1, t2, np.inf],
                   labels=["Low", "Mid", "High"])

def gap_table(data, sesc, levels=("Low", "Mid", "High")):
    rows = []
    for lev in levels:
        sub = data[data[sesc] == lev]
        b, w, h = (sub[sub.race == k]["colEnroll"] for k in (1, 3, 2))
        gap = b.mean() - w.mean()
        if len(b) == 0 or len(w) == 0:
            rows.append(dict(SES=lev, nBlack=len(b), nWhite=len(w), nHisp=len(h),
                             pctBlack=np.nan, pctWhite=np.nan, pctHisp=np.nan,
                             gap_pp=np.nan, z=np.nan, p=np.nan))
            continue
        se = np.sqrt(b.var()/len(b) + w.var()/len(w))
        z = gap / se
        rows.append(dict(SES=lev, nBlack=len(b), nWhite=len(w), nHisp=len(h),
                         pctBlack=round(100*b.mean(), 1), pctWhite=round(100*w.mean(), 1),
                         pctHisp=round(100*h.mean(), 1),
                         gap_pp=round(100*gap, 1), z=round(z, 2),
                         p=round(2*stats.norm.sf(abs(z)), 4)))
    return pd.DataFrame(rows)

print("=" * 78)
print("PRIMARY GAP TABLE (composite SES tertiles; Black vs non-Black/non-Hispanic)")
gt = gap_table(d, "sesT")
print(gt.to_string(index=False))
gt.to_csv("outputs/gap_table_primary.csv", index=False)

# ------------------------------------------------------------------ logistic
dd = d[d.race.isin([1, 3])].copy()
dd["black"] = (dd.race == 1).astype(int)
dd["female"] = (dd.sex == 2).astype(int)
m_add = smf.logit("colEnroll ~ black + C(sesT) + female + age79", data=dd).fit(disp=0)
m_int = smf.logit("colEnroll ~ black * C(sesT) + female + age79", data=dd).fit(disp=0)
lr = 2 * (m_int.llf - m_add.llf)
print("=" * 78)
print(f"LOGISTIC (primary, Black vs non-Black/non-Hispanic, n={len(dd)}):")
print(f"  additive logL={m_add.llf:.1f}; interaction logL={m_int.llf:.1f}")
print(f"  LRT race x SES tertile (2 df): LR={lr:.2f}, p={stats.chi2.sf(lr, 2):.4f}")
for k in ["black", "black:C(sesT)[T.Mid]", "black:C(sesT)[T.High]"]:
    print(f"    {k}: OR={np.exp(m_int.params[k]):.2f}, p={m_int.pvalues[k]:.4f}")
m_int.summary2().tables[1].to_csv("outputs/logit_interaction_primary.csv")

# ------------------------------------------------------------------ sensitivities
print("=" * 78)
print("SENSITIVITY 1: income-only quartiles (1979 income alone)")
d["incQ"] = pd.qcut(d["log_inc79"], 4, labels=["Q1", "Q2", "Q3", "Q4"])
gt_inc = gap_table(d, "incQ", levels=("Q1", "Q2", "Q3", "Q4"))
print(gt_inc.to_string(index=False))
gt_inc.to_csv("outputs/gap_table_income_quartiles.csv", index=False)
di = d[d.race.isin([1, 3])].copy()
di["black"] = (di.race == 1).astype(int); di["female"] = (di.sex == 2).astype(int)
ma = smf.logit("colEnroll ~ black + C(incQ) + female + age79", data=di).fit(disp=0)
mi = smf.logit("colEnroll ~ black * C(incQ) + female + age79", data=di).fit(disp=0)
lr_i = 2 * (mi.llf - ma.llf)
print(f"  LRT race x income-quartile (3 df): LR={lr_i:.2f}, p={stats.chi2.sf(lr_i, 3):.4f}")

print("=" * 78)
print("SENSITIVITY 2: wealth-added SES (log net wealth 1985 added; NONRANDOM SUBSET)")
dw = df.copy()
dw["log_wea85"] = np.sign(dw["wea85"]) * np.log1p(dw["wea85"].abs())  # signed log keeps negative net worth
dw["z_wea"] = (dw["log_wea85"] - dw["log_wea85"].mean()) / dw["log_wea85"].std()
dw["ses_w"] = dw[["z_ed", "z_inc", "z_wea"]].mean(axis=1, skipna=False)
dw = dw[dw["ses_w"].notna()]
print(f"  subset n={len(dw)} ({100*len(dw)/n_total:.1f}% of full file) - selection warning")
tw1, tw2 = dw["ses_w"].quantile([1/3, 2/3])
dw["sesW"] = pd.cut(dw["ses_w"], [-np.inf, tw1, tw2, np.inf], labels=["Low", "Mid", "High"])
gt_w = gap_table(dw, "sesW")
print(gt_w.to_string(index=False))
gt_w.to_csv("outputs/gap_table_wealth_variant.csv", index=False)

print("=" * 78)
print("SENSITIVITY 3: winsorized top-1% income")
d2 = df.copy()
cap = d2["inc79"].dropna().quantile(0.99)
d2["z_inc_w"] = ((np.log1p(d2["inc79"].clip(0, cap)) - np.log1p(d2["inc79"].clip(0, cap)).mean())
                 / np.log1p(d2["inc79"].clip(0, cap)).std())
d2["ses_wins"] = d2[["z_ed", "z_inc_w"]].mean(axis=1)
d2 = d2[d2["ses_wins"].notna()]
q1, q2 = d2["ses_wins"].quantile([1/3, 2/3])
d2["sesWz"] = pd.cut(d2["ses_wins"], [-np.inf, q1, q2, np.inf], labels=["Low", "Mid", "High"])
gtz = gap_table(d2, "sesWz")
print(gtz.to_string(index=False))
gtz.to_csv("outputs/gap_table_winsorized.csv", index=False)

print("=" * 78)
print("SENSITIVITY 4: missing-SES indicator category (no listwise deletion)")
dm = df.copy()
dm["ses_miss"] = dm["ses_raw"].isna()
t1m, t2m = dm.loc[~dm["ses_miss"], "ses_raw"].quantile([1/3, 2/3])
dm["sesC"] = "Missing"
dm.loc[~dm["ses_miss"], "sesC"] = pd.cut(dm.loc[~dm["ses_miss"], "ses_raw"],
    [-np.inf, t1m, t2m, np.inf], labels=["Low", "Mid", "High"]).astype(str)
rows = []
for lev in ["Low", "Mid", "High", "Missing"]:
    sub = dm[dm["sesC"] == lev]
    b, w = sub[sub.race == 1]["colEnroll"], sub[sub.race == 3]["colEnroll"]
    rows.append(dict(SES=lev, nBlack=len(b), nWhite=len(w),
                     pctBlack=round(100*b.mean(), 1), pctWhite=round(100*w.mean(), 1),
                     gap_pp=round(100*(b.mean()-w.mean()), 1)))
gtm = pd.DataFrame(rows)
print(gtm.to_string(index=False))
gtm.to_csv("outputs/gap_table_missingcat.csv", index=False)

print("=" * 78)
print("HISPANIC COHORT SEPARATELY (composite SES tertiles, primary sample)")
hisp = d[d.race == 2]
print(f"  Hispanic overall enrollment rate: {100*hisp.colEnroll.mean():.1f}% (n={len(hisp)})")
for lev in ["Low", "Mid", "High"]:
    hh = hisp[hisp["sesT"] == lev]
    print(f"  {lev}: {100*hh.colEnroll.mean():.1f}% (n={len(hh)})")
print(f"  Black overall: {100*d[d.race==1].colEnroll.mean():.1f}% (n={(d.race==1).sum()}); "
      f"nonBlack/nonHisp: {100*d[d.race==3].colEnroll.mean():.1f}% (n={(d.race==3).sum()})")
print("=" * 78)
print(f"TOTAL ROWS {n_total}; complete-case primary n={len(d)} "
      f"({100*len(d)/n_total:.1f}%); primary logistic n={len(dd)}")
