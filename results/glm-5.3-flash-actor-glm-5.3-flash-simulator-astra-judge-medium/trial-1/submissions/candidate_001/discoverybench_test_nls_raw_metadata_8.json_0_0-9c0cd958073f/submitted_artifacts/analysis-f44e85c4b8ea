"""NLSY79: median family net wealth by racial/ethnic cohort, 1985/1990/1996.
Approach approved by researcher: per-wave medians on non-missing wealth,
zeros and negatives retained; gaps as ratios and dollar differences; no imputation."""
import pandas as pd, numpy as np

df = pd.read_csv('data/nls_raw.csv')
W = {'1985':'Family net wealth, 1985','1990':'Family net wealth, 1990',
     '1996':'Family net wealth, 1996 (key data point)'}
LABEL = {1:'Black', 2:'Hispanic', 3:'white (non-Black non-Hispanic)'}  # proxy label kept visible

# Table 1: per-wave medians by cohort
rows=[]
for y,c in W.items():
    df['_cohort'] = df['Racial/ethnic cohort, 1979'].map(LABEL)
    for lab,sub in df.groupby('_cohort'):
        v = sub[c].dropna()
        rows.append({'year':int(y),'cohort':lab,'valid_N':len(v),
            'median':v.median(),'share_neg':(v<0).mean(),'share_zero':(v==0).mean()})
tab = pd.DataFrame(rows).sort_values(['year','cohort'])

# Table 2: white-vs-Black and white-vs-Hispanic gaps
gap_rows=[]
for y,c in W.items():
    med = {lab: df.loc[df['Racial/ethnic cohort, 1979']==r, c].median() for r,lab in LABEL.items()}
    for comp in ['Black','Hispanic']:
        gap_rows.append({'year':int(y),'comparison':f'white vs {comp}',
            'ratio_white_to_group':med['white (non-Black non-Hispanic)']/med[comp],
            'dollar_diff':med['white (non-Black non-Hispanic)']-med[comp]})
gaps = pd.DataFrame(gap_rows)

print(tab.to_string(index=False,
    formatters={'median':'{:,.0f}'.format,'share_neg':'{:.1%}'.format,
                'share_zero':'{:.1%}'.format}))
print('\n--- Gaps ---')
print(gaps.to_string(index=False, formatters={
    'ratio_white_to_group':'{:.2f}x'.format,'dollar_diff':'{:,.0f}'.format}))

# Persistence check: valid N per wave vs 1979 cohort size
print('\nAttrition: valid N / 1979 cohort size')
for r,lab in LABEL.items():
    n0 = (df['Racial/ethnic cohort, 1979']==r).sum()
    ns = [int(df.loc[df['Racial/ethnic cohort, 1979']==r, c].notna().sum()) for c in W.values()]
    print(f'  {lab}: {ns} of {n0}')
