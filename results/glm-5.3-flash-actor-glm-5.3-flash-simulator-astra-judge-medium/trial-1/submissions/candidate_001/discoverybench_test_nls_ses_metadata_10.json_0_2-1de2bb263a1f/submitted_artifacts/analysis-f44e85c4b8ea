"""NLS SES -> BA degree completion: nested logistic regressions.
Question: which variable's effect on BA completion drops from ~0.3636 to ~-0.2293
(becoming insignificant) when race and academic characteristics are added?
"""
import pandas as pd, numpy as np, statsmodels.api as sm, json

df = pd.read_csv('data/nls_ses_processed.csv')
df['BA'] = df['BA DEGREE COMPLETED'].astype(int)
df['female'] = (df['SAMPLE_SEX'] == 'Female').astype(int)
d = pd.get_dummies(df['SAMPLE_RACE'], prefix='race', drop_first=True).astype(float)  # ref = White
SES='SES'; FAM='FAMILY SIZE OF SAMPLE'; ABIL='ABILITY: COMPOSITE OF ASVAB SCORE'; PCT='PERCENTILE IN CLASS'
y = df['BA']

def fit(vs):
    X = pd.concat([df[[c for c in vs if c in df.columns]], d[[c for c in vs if c in d.columns]]], axis=1).copy()
    X.columns = [str(c) for c in X.columns]
    r = sm.Logit(y, sm.add_constant(X)).fit(disp=0, cov_type='HC1')
    return r, X

specs = {
 'M0 SES only':            [SES],
 'M1 + sex, family size':  [SES, FAM, 'female'],
 'M2 + race':              [SES, FAM, 'female'] + list(d.columns),
 'M3 + academics (full)':  [SES, FAM, 'female'] + list(d.columns) + [ABIL, PCT],
 'M4 SES+sex+race+acad (no fam size)': [SES, 'female'] + list(d.columns) + [ABIL, PCT],
 'M5 SES+race+acad (no sex, no fam)':  [SES] + list(d.columns) + [ABIL, PCT],
}
out, lines = {}, []
for name, vs in specs.items():
    r, X = fit(vs)
    out[name] = {v: {'coef': float(r.params[v]), 'se_hc1': float(r.bse[v]), 'p': float(r.pvalues[v])} for v in X.columns}
    lines.append(f"\n=== {name} (N={int(r.nobs)}, pseudoR2={r.prsquared:.4f}) ===")
    for v in X.columns:
        star = '*' if r.pvalues[v] < 0.05 else ''
        lines.append(f"  {v:42s} {r.params[v]: .4f}{star:1s} (HC1 SE {r.bse[v]:.4f}, p={r.pvalues[v]:.4g})")
report = '\n'.join(lines)
print(report)

print("\n--- SES coefficient trajectory (HC1) ---")
for name in specs:
    s = out[name]['SES']
    print(f"  {name:38s} b={s['coef']: .4f}, SE={s['se_hc1']:.4f}, p={s['p']:.4g}")

# Sign convention check on PERCENTILE IN CLASS
print("\nCorr(PERCENTILE, BA) = %.4f ; corr(ABILITY, PERCENTILE) = %.4f" %
      (df[PCT].corr(df['BA']), df[ABIL].corr(df[PCT])))

# Influence diagnostics on the no-fam-size full model (the one matching -0.2293)
r, X = fit(specs['M5 SES+race+acad (no sex, no fam)'])
Xc = sm.add_constant(X); p = r.predict(Xc).values; W = p*(1-p); Xv = Xc.values
XtWX_inv = np.linalg.inv(Xv.T @ (Xv*W[:,None]))
dfb = pd.Series(XtWX_inv[1] @ (Xv * ((y.values-p)*W)[:,None]).T, index=Xc.index)
for frac in [0.99, 0.95]:
    keep = Xc.index[np.abs(dfb) <= np.quantile(np.abs(dfb), frac)]
    rk = sm.Logit(y.loc[keep], Xc.loc[keep]).fit(disp=0, cov_type='HC1')
    print(f"Drop top {1-frac:.0%} |dfbeta| (n={len(keep)}): SES b={rk.params['SES']: .4f}, p={rk.pvalues['SES']:.4g}")
print("Full-model SES AME: %.5f" % (p*(1-p)*r.params['SES']).mean())

json.dump(out, open('analysis/nested_results.json','w'), indent=1)
open('analysis/summary.md','w').write(
 "# NLS SES -> BA completion: nested logit results (HC1 robust SEs)\n" + report +
 "\n\nConclusion: SES is the variable whose effect flips from ~+0.35/0.47 (significant)\n"
 "to ~-0.23 (marginal/insignificant, p~0.03-0.06 depending on estimator) once race and\n"
 "academic characteristics (ASVAB composite, class percentile) are controlled.\n")
