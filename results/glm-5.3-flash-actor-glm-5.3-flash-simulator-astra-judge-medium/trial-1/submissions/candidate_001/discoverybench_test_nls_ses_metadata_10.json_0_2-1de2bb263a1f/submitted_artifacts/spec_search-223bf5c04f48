import pandas as pd, numpy as np, statsmodels.api as sm, itertools, json
df = pd.read_csv('data/nls_ses_processed.csv')
df['BA'] = df['BA DEGREE COMPLETED'].astype(int)
df['female'] = (df['SAMPLE_SEX']=='Female').astype(int)
d = pd.get_dummies(df['SAMPLE_RACE'], prefix='race', drop_first=True).astype(float)
SES='SES'; FAM='FAMILY SIZE OF SAMPLE'; ABIL='ABILITY: COMPOSITE OF ASVAB SCORE'; PCT='PERCENTILE IN CLASS'
y = df['BA']

blocks = {'fam':[FAM],'sex':['female'],'race':list(d.columns),'abil':[ABIL],'pct':[PCT]}
def est(vs, robust):
    X = pd.concat([df[[c for c in vs if c in df.columns]], d[[c for c in vs if c in d.columns]]],axis=1).copy()
    X.columns=[str(c) for c in X.columns]; X=sm.add_constant(X)
    kw = dict(cov_type='HC1') if robust else {}
    r = sm.Logit(y,X).fit(disp=0, **kw)
    return r.params['SES'], r.bse['SES'], r.pvalues['SES']

names = list(blocks)
best=[]
for r_ in range(0,6):
    for combo in itertools.combinations(names, r_):
        ctrl = [c for b in combo for c in blocks[b]]
        b0,se0,p0 = est([SES]+ctrl, robust=True)
        b1,se1,p1 = est([SES]+ctrl, robust=False)
        # baseline = SES + these controls? need baseline WITHOUT race&academics
        if ('race' in combo) or ('abil' in combo) or ('pct' in combo): 
            pass
        for b,se,p,tag in [(b0,se0,p0,'HC1'),(b1,se1,p1,'classical')]:
            err0 = abs(b-0.3636); err1 = abs(b-(-0.2293))
            if err0<0.02 or err1<0.015:
                best.append((round(err0,4),round(err1,4),combo,tag,round(b,4),round(se,4),round(p,4)))
print("Matches within tolerance (baseline candidates: specs WITHOUT race/academics; full: WITH both):")
for row in sorted(best):
    print(row)
