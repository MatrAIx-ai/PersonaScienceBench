"""
SES -> BA degree completion: does the association differ by race?
Data: data/nls_ses_processed.csv (NLS-style processed extract)
"""
import numpy as np, pandas as pd, statsmodels.api as sm

import scipy.stats as st

RNG = 20261019
df = pd.read_csv('data/nls_ses_processed.csv', index_col=0)
df['ba'] = df['BA DEGREE COMPLETED'].astype(int)
df['black'] = (df['SAMPLE_RACE']=='Black').astype(float)
df['hisp']  = (df['SAMPLE_RACE']=='Hispanic').astype(float)
df['male']  = (df['SAMPLE_SEX']=='Male').astype(float)
df['ses_z'] = (df['SES']-df['SES'].mean())/df['SES'].std()
df['asvab_z'] = (df['ABILITY: COMPOSITE OF ASVAB SCORE']-df['ABILITY: COMPOSITE OF ASVAB SCORE'].mean())/df['ABILITY: COMPOSITE OF ASVAB SCORE'].std()
df['pctl'] = df['PERCENTILE IN CLASS']/100.0
df['fam'] = df['FAMILY SIZE OF SAMPLE']
# SES standardized WITHIN race (robustness: removes between-group scale/location differences)
df['ses_wz'] = df.groupby('SAMPLE_RACE')['SES'].transform(lambda s: (s-s.mean())/s.std())
df['ses_z:black'] = df['ses_z']*df['black']
df['ses_z:hisp'] = df['ses_z']*df['hisp']
df['ses_wz:black'] = df['ses_wz']*df['black']
df['ses_wz:hisp'] = df['ses_wz']*df['hisp']

out = []
def log(s):
    print(s); out.append(str(s))

log("="*80); log("SECTION 0. DATA SUMMARY"); log("="*80)
log(f"n = {len(df)}, BA events = {df['ba'].sum()} "
    f"(White {df.loc[df.SAMPLE_RACE=='White','ba'].sum()}, "
    f"Black {df.loc[df.SAMPLE_RACE=='Black','ba'].sum()}, "
    f"Hispanic {df.loc[df.SAMPLE_RACE=='Hispanic','ba'].sum()}); missing = 0 everywhere")
log(df.groupby('SAMPLE_RACE')['ba'].agg(['count','sum','mean']).round(4).to_string())

def fit(formula_cols, name, m='logit'):
    X = sm.add_constant(df[formula_cols])
    y = df['ba']
    if m=='logit':
        mod = sm.Logit(y, X).fit(disp=0, cov_type='HC1')
    else:
        mod = sm.OLS(y, X).fit(cov_type='HC1')
    log(f"\n--- {name} ({m.upper()}, HC1 robust SEs) ---")
    tbl = pd.DataFrame({'coef': mod.params, 'OR': np.exp(mod.params) if m=='logit' else np.nan,
                        'SE': mod.bse, 'z': mod.params/mod.bse, 'p': mod.pvalues})
    log(tbl.round(4).to_string())
    log(f"pseudo-R2/loglik: {getattr(mod,'prsquared',float('nan')):.4f} / {mod.llf:.1f}; n={int(mod.nobs)}")
    return mod

# ---------- SECTION 1: headline models ----------
log("\n"+"="*80); log("SECTION 1. LOGIT MODELS: BA ~ SES * RACE"); log("="*80)
base = ['ses_z','black','hisp','ses_z:black','ses_z:hisp']
m1 = fit(base, "M1: SES x race, no controls")
m2 = fit(base+['male','fam'], "M2: M1 + sex + family size  (HEADLINE)")
m3 = fit(base+['male','fam','asvab_z','pctl'], "M3: M2 + ASVAB z + class percentile (NET-OF-ACADEMIC-RESOURCES comparison, labeled; ability/rank treated as part of SES pathway)")

# LRT for joint significance of the two interactions (nested M2)
X0 = sm.add_constant(df[['ses_z','black','hisp','male','fam']])
X1 = sm.add_constant(df[base+['male','fam']])
f0 = sm.Logit(df['ba'], X0).fit(disp=0); f1 = sm.Logit(df['ba'], X1).fit(disp=0)
LR = 2*(f1.llf-f0.llf); pLR = st.chi2.sf(LR, 2)
log(f"\nLRT (M1 vs M2 restricted, SES x race interactions jointly = 0): LR = {LR:.2f}, df=2, p = {pLR:.4f}")

# ---------- SECTION 2: marginal predicted probabilities by race ----------
log("\n"+"="*80); log("SECTION 2. MARGINAL PREDICTED PROBABILITIES BY RACE (M2, HC1)"); log("="*80)
def ame_by_race(mod):
    """Average marginal effect of +1 SD SES (ses_z) within each race, with delta-method SE."""
    res = {}
    for r,mask in [('White', df.SAMPLE_RACE=='White'), ('Black', df.SAMPLE_RACE=='Black'), ('Hispanic', df.SAMPLE_RACE=='Hispanic')]:
        sub = df[mask]
        Xs = sm.add_constant(sub[['ses_z','black','hisp','ses_z:black','ses_z:hisp','male','fam']+[c for c in ['asvab_z','pctl'] if c in sub]], has_constant='add')
        # ensure column order matches model
        Xs = Xs[mod.params.index]
        pr1 = mod.predict(Xs); Xs2 = Xs.copy(); Xs2['ses_z'] = Xs2['ses_z']+1.0
        pr2 = mod.predict(Xs2)
        d = pr2-pr1
        # delta method
        j = mod.params.index.get_loc('ses_z')
        k = mod.params.index.get_loc('ses_z:black'); k2 = mod.params.index.get_loc('ses_z:hisp')
        p = pr1.values if hasattr(pr1,'values') else np.asarray(pr1)
        w = mod.params.values
        b = mod.bse.values
        # gradient of mean predicted prob wrt [ses_z, ses_z:black, ses_z:hisp]
        g = np.zeros((3, len(sub)))
        if r=='White':
            g[0] = p*(1-p)
        elif r=='Black':
            g[0] = p*(1-p); g[1] = p*(1-p)
        else:
            g[0] = p*(1-p); g[2] = p*(1-p)
        V = mod.cov_params().values
        idx = [j,k,k2]
        grad_mean = g.mean(axis=1)
        var = V[np.ix_(idx,idx)]
        se = np.sqrt(grad_mean @ var @ grad_mean)
        res[r] = (d.mean(), se, d.mean()-1.96*se, d.mean()+1.96*se, len(sub))
    return res
log("AME of +1 SD SES on P(BA), mean over within-race sample (delta-method SE, HC1 covariance):")
for r,(est,se,lo,hi,n) in ame_by_race(m2).items():
    log(f"  {r:9s}: dP = {est*100:6.2f} pp per +1SD SES  [95% CI {lo*100:6.2f}, {hi*100:6.2f}]  (n={n})")
log("\nAME from M3 (net of ability/class rank), same method:")
for r,(est,se,lo,hi,n) in ame_by_race(m3).items():
    log(f"  {r:9s}: dP = {est*100:6.2f} pp per +1SD SES  [95% CI {lo*100:6.2f}, {hi*100:6.2f}]  (n={n})")

# predicted P(BA) at SES 25th/50th/75th percentiles by race
log("\nPredicted P(BA) at SES percentiles (M2, averaging over each race's own covariates):")
ses25, ses50, ses75 = df['SES'].quantile([.25,.5,.75])
def pred_at(mod, r, ses_val):
    sub = df[df.SAMPLE_RACE==r].copy()
    sub['SES']=ses_val
    sub['ses_z']=(ses_val-df['SES'].mean())/df['SES'].std()
    Xs = sm.add_constant(sub[mod.params.index.difference(['const'])], has_constant='add')
    Xs = Xs[mod.params.index]
    return mod.predict(Xs).mean()
rows=[]
for r in ['White','Black','Hispanic']:
    rows.append([r]+[100*pred_at(m2,r,s) for s in [ses25,ses50,ses75]])
log(pd.DataFrame(rows, columns=['race','P(BA)|SES p25','p50','p75']).round(2).to_string(index=False))
log(f"(SES p25/p50/p75 = {ses25:.2f}/{ses50:.2f}/{ses75:.2f} on raw SES scale)")

# ---------- SECTION 3: robustness ----------
log("\n"+"="*80); log("SECTION 3. ROBUSTNESS CHECKS"); log("="*80)

# 3a. Linear probability model
lpm = fit(base+['male','fam'], "R1: Linear probability model, M2 spec", m='ols')

# 3b. SES nonlinearity (quadratic + spline-ish: add ses_z^2 and ses_z^3)
df['ses2']=df['ses_z']**2; df['ses3']=df['ses_z']**3
m2q = fit(base+['ses2','ses3','male','fam'], "R2a: cubic in SES (does interaction survive flexible SES?)")

# 3c. SES standardized within race
m2w = fit(['ses_wz','black','hisp','ses_wz:black','ses_wz:hisp','male','fam'],
          "R2b: SES standardized WITHIN race (removes cross-group scale/location differences)")

# 3d. Firth penalized logit (hand-coded, Newton with Firth correction, profile-free Wald using unpen covariance)
def firth_logit(X, y, maxiter=200, tol=1e-10):
    n,p = X.shape
    X = np.asarray(X, float); y = np.asarray(y, float)
    b = np.zeros(p)
    for it in range(maxiter):
        eta = X@b; pr = 1/(1+np.exp(-eta))
        W = pr*(1-pr)
        # Firth correction term
        XW = X*W[:,None]
        H = X.T@XW
        h = np.einsum('ij,jk,ik->i', X, np.linalg.pinv(H), XW)  # hat diag
        U = X.T@(y - pr) + 0.5*np.einsum('ij,jk,ik->i', X, np.linalg.pinv(H), (1-2*pr)[:,None]*X).sum(axis=0) if False else None
        # standard Firth: U = X'(y-p) + h*(0.5-p) summed  => X'[(y-p)+h*(0.5-p)]
        U = X.T@((y-pr) + h*(0.5-pr))
        step = np.linalg.solve(H, U)
        b_new = b + step
        if np.max(np.abs(step)) < tol: b = b_new; break
        b = b_new
    # covariance: inverse of negative Hessian at solution (information, unpenalized approx w/ Firth adj)
    eta = X@b; pr = 1/(1+np.exp(-eta)); W = pr*(1-pr)
    XW = X*W[:,None]; H = X.T@XW
    V = np.linalg.pinv(H)
    return b, V, it+1
Xf = sm.add_constant(df[base+['male','fam']]).values
bf, Vf, it = firth_logit(Xf, df['ba'].values)
log(f"\n--- R3: Firth penalized logit, M2 spec (converged in {it} iters) ---")
names = sm.add_constant(df[base+['male','fam']]).columns
tf = pd.DataFrame({'coef': bf, 'OR': np.exp(bf), 'SE': np.sqrt(np.diag(Vf))}, index=names)
tf['z'] = tf['coef']/tf['SE']; tf['p'] = 2*st.norm.sf(np.abs(tf['z']))
log(tf.round(4).to_string())

# 3e. Stratified per-race fits + cross-equation Wald tests (HC1)
log("\n--- R4: Per-race stratified logits (M2 covariates within race) ---")
coefs={}; Vcs={}
for r in ['White','Black','Hispanic']:
    sub = df[df.SAMPLE_RACE==r]
    X = sm.add_constant(sub[['ses_z','male','fam']]); yv = sub['ba']
    mod = sm.Logit(yv, X).fit(disp=0, cov_type='HC1')
    coefs[r]=mod.params; Vcs[r]=mod.cov_params()
    log(f"  {r:9s}: SES coef = {mod.params['ses_z']:+.4f} (OR {np.exp(mod.params['ses_z']):.3f}), SE = {mod.bse['ses_z']:.4f}, p = {mod.pvalues['ses_z']:.4f}, n={len(sub)}, events={yv.sum()}")
def wald_eq(r1, r2):
    d = coefs[r1]['ses_z']-coefs[r2]['ses_z']
    V = Vcs[r1].loc['ses_z','ses_z']+Vcs[r2].loc['ses_z','ses_z']
    W = d*d/V
    return W, st.chi2.sf(W,1)
for a,b in [('White','Black'),('White','Hispanic'),('Black','Hispanic')]:
    W,p = wald_eq(a,b)
    log(f"  Wald test SES coef {a} == {b}: chi2(1) = {W:.2f}, p = {p:.4f}")

# 3f. bootstrap of the interaction contrast (M2): dP(SES+1SD) minority - White
log("\n--- R5: Bootstrap (1000 reps, seed fixed) of racial contrast in AME of +1SD SES (M2 spec) ---")
rng = np.random.default_rng(RNG)
B=1000; res=np.full((B,2), np.nan)
cols=['ses_z','black','hisp','ses_z:black','ses_z:hisp','male','fam']
def ames(mb, d2):
    a = {}
    for r in ['White','Black','Hispanic']:
        sub = d2[d2.SAMPLE_RACE==r]
        if len(sub)<100 or sub['ba'].sum()<5:
            a[r]=np.nan; continue
        Xs = sm.add_constant(sub[cols], has_constant='add')[mb.params.index]
        p1 = mb.predict(Xs); Xs2=Xs.copy(); Xs2['ses_z']+=1.0; p2=mb.predict(Xs2)
        a[r]=(p2-p1).mean()
    return a
for b_ in range(B):
    idx = rng.choice(len(df), len(df), replace=True)
    d2 = df.iloc[idx]
    try:
        Xb = sm.add_constant(d2[cols], has_constant='add'); mb = sm.Logit(d2['ba'], Xb).fit(disp=0)
        a = ames(mb, d2)
        res[b_,0] = a['Black']-a['White'] if not np.isnan(a['Black']) else np.nan
        res[b_,1] = a['Hispanic']-a['White'] if not np.isnan(a['Hispanic']) else np.nan
    except Exception:
        pass
for j,r in enumerate(['Black','Hispanic']):
    dd = res[:,j][~np.isnan(res[:,j])]
    log(f"  AME contrast ({r} minus White): bootstrap 95% CI = "
        f"[{np.percentile(dd,2.5)*100:.2f}, {np.percentile(dd,97.5)*100:.2f}] pp, nvalid={len(dd)}")

log("\n"+"="*80); log("END OF ANALYSIS"); log("="*80)
with open('outputs/analysis_report.txt','w') as f: f.write("\n".join(out))
print("\nsaved outputs/analysis_report.txt")
