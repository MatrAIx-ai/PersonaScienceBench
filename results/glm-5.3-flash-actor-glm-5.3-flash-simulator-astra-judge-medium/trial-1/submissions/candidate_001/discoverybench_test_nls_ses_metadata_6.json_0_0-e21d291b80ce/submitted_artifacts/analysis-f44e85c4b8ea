"""NLS SES analysis: at which SES levels is the Black-vs-other BA completion-rate gap most/least pronounced?"""
import pandas as pd, numpy as np
from math import sqrt

df = pd.read_csv('data/nls_ses_processed.csv')
df['Black'] = (df['SAMPLE_RACE'] == 'Black').astype(int)
df['BA'] = df['BA DEGREE COMPLETED'].astype(int)

def wilson_ci(k, n, z=1.96):
    if n == 0: return (np.nan, np.nan)
    p = k / n
    d = 1 + z**2 / n
    c = (p + z**2 / (2*n)) / d
    h = z * sqrt(p*(1-p)/n + z**2/(4*n**2)) / d
    return (c - h, c + h)

def bin_analysis(k, label):
    df['bin'] = pd.qcut(df['SES'], k, labels=False, duplicates='drop')
    edges = df.groupby('bin')['SES'].agg(['min','max','count']).round(3)
    print(f"\n===== {label}: {k} equal-frequency SES bins =====")
    print("SES bin ranges / n:")
    print(edges.to_string())
    rows = []
    for b, g in df.groupby('bin'):
        blk = g[g['Black']==1]; oth = g[g['Black']==0]
        wr = g[g['SAMPLE_RACE']=='White']; hs = g[g['SAMPLE_RACE']=='Hispanic']
        def stat(sub):
            n = len(sub); kk = sub['BA'].sum()
            lo, hi = wilson_ci(kk, n)
            return kk, n, kk/n, lo, hi
        bk, bn, bp, blo, bhi = stat(blk)
        ok, on, op, olo, ohi = stat(oth)
        wk, wn, wp, wlo, whi = stat(wr)
        hk, hn, hp, hlo, hhi = stat(hs)
        gap = bp - op
        # bootstrap CI for gap
        rng = np.random.default_rng(0)
        boots = []
        bi = g['Black'].values; ba = g['BA'].values
        for _ in range(2000):
            idx = rng.integers(0, len(g), len(g))
            bb = ba[idx][bi[idx]==1]; ob = ba[idx][bi[idx]==0]
            if len(bb) and len(ob): boots.append(bb.mean() - ob.mean())
        glo, ghi = np.percentile(boots, [2.5, 97.5])
        rows.append(dict(bin=b, ses_lo=edges.loc[b,'min'], ses_hi=edges.loc[b,'max'],
            n_black=bn, ba_black=bp*100, ci_black=(round(blo*100,2), round(bhi*100,2)),
            n_other=on, ba_other=op*100, ci_other=(round(olo*100,2), round(ohi*100,2)),
            ba_white=wp*100, ba_hispanic=hp*100,
            gap_pp=gap*100, gap_ci=(round(glo*100,2), round(ghi*100,2)),
            ratio=(bp/op) if op > 0 else np.nan))
    t = pd.DataFrame(rows)
    t['ba_black'] = t['ba_black'].round(2); t['ba_other'] = t['ba_other'].round(2)
    t['ba_white'] = t['ba_white'].round(2); t['ba_hispanic'] = t['ba_hispanic'].round(2)
    t['gap_pp'] = t['gap_pp'].round(2); t['ratio'] = t['ratio'].round(2)
    cols = ['bin','ses_lo','ses_hi','n_black','ba_black','ci_black','n_other','ba_other','ci_other',
            'ba_white','ba_hispanic','gap_pp','gap_ci','ratio']
    print(t[cols].to_string(index=False))
    t2 = t.assign(abs_gap=t['gap_pp'].abs()).sort_values('abs_gap', ascending=False)
    print("Ranking by |gap| (most pronounced first):", t2['bin'].tolist())
    return t

res = {}
for k, lab in [(5,'PRIMARY quintiles'), (4,'ROBUSTNESS quartiles'), (3,'ROBUSTNESS terciles')]:
    res[k] = bin_analysis(k, lab)

# sex stratification (quintiles)
print("\n===== SEX-STRATIFIED (quintiles) =====")
df['bin'] = pd.qcut(df['SES'], 5, labels=False)
for sex, g in df.groupby('SAMPLE_SEX'):
    print(f"-- {sex} --")
    r = []
    for b, gb in g.groupby('bin'):
        blk = gb[gb['Black']==1]['BA']; oth = gb[gb['Black']==0]['BA']
        r.append((b, len(gb), blk.mean()*100, oth.mean()*100, (blk.mean()-oth.mean())*100))
    for row in r:
        print(f"  bin {row[0]}: n={row[1]}, Black={row[2]:.2f}%, other={row[3]:.2f}%, gap={row[4]:+.2f}pp")

# logistic regression with SES x Black interaction
print("\n===== LOGISTIC REGRESSION: BA ~ SES + Black + SES*Black =====")
try:
    import statsmodels.api as sm
    X = df[['SES','Black']].copy()
    X['SES_x_Black'] = X['SES'] * X['Black']
    X = sm.add_constant(X)
    m = sm.GLM(df['BA'], X, family=sm.families.Binomial()).fit()
    print(m.summary2().tables[1].round(4).to_string())
except Exception as e:
    print("statsmodels unavailable:", e)

# Black vs White only and Black vs Hispanic only, quintiles
print("\n===== COMPARATOR SPLIT (quintiles): Black vs White / vs Hispanic gaps =====")
df['bin'] = pd.qcut(df['SES'], 5, labels=False)
for b, g in df.groupby('bin'):
    blk = g[g['Black']==1]['BA'].mean()*100
    wht = g[g['SAMPLE_RACE']=='White']['BA'].mean()*100
    hsp = g[g['SAMPLE_RACE']=='Hispanic']['BA'].mean()*100
    print(f"  bin {b}: Black={blk:.2f}, White={wht:.2f} (gap {blk-wht:+.2f}pp), Hispanic={hsp:.2f} (gap {blk-hsp:+.2f}pp)")
