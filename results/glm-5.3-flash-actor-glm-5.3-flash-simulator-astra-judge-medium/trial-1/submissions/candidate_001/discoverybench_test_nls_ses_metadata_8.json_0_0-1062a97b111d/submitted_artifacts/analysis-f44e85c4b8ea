"""NLS SES analysis: identify which two races differ in BA completion by factor -0.9568."""
import pandas as pd, numpy as np, statsmodels.api as sm

df = pd.read_csv('data/nls_ses_processed.csv')
print(f"Rows: {len(df)}, Columns: {df.shape[1]}, Missing: {df.isna().sum().sum()}")
print("Race:", df['SAMPLE_RACE'].value_counts().to_dict())
print("Sex:", df['SAMPLE_SEX'].value_counts().to_dict())

y = df['BA DEGREE COMPLETED'].astype(int)
d = pd.get_dummies(df['SAMPLE_RACE'])  # White is first alphabetically -> natural reference
SES = df['SES']

# --- Raw crosstab ---
ct = pd.crosstab(df['SAMPLE_RACE'], y)
ct.columns = ['BA=0','BA=1']
ct['BA rate'] = (ct['BA=1']/(ct['BA=0']+ct['BA=1'])).round(4)
print("\nRace x BA crosstab:\n", ct)

# --- Model 1: race-only logit (ref = White) ---
X1 = sm.add_constant(d[['Black','Hispanic']].astype(float))
m1 = sm.Logit(y, X1).fit(disp=0)
# --- Model 2: race + SES (ref = White) ---
X2 = sm.add_constant(pd.concat([d[['Black','Hispanic']], SES], axis=1).astype(float))
m2 = sm.Logit(y, X2).fit(disp=0)
# --- Model 3: race + SES + race x SES interactions (ref = White) ---
X3 = sm.add_constant(pd.DataFrame({
    'Black': d['Black'], 'Hispanic': d['Hispanic'], 'SES': SES,
    'Black x SES': d['Black']*SES, 'Hispanic x SES': d['Hispanic']*SES}).astype(float))
m3 = sm.Logit(y, X3).fit(disp=0)

for name, m in [('Model 1: race only', m1), ('Model 2: race + SES', m2), ('Model 3: race + SES + race x SES', m3)]:
    print(f"\n=== {name} ===")
    out = pd.DataFrame({'coef': m.params, 'std err': m.bse, 'z': m.tvalues, 'p': m.pvalues})
    print(out.round(4))

b = m3.params['Black']
print(f"\nTarget check (Model 3, Black vs White at SES=0): {b:.5f} -> rounds to {round(b,4)}")
print(f"exp(coef) = odds ratio: {np.exp(b):.4f}")
print(f"Match to -0.9568: {abs(b - (-0.9568)) < 5e-5}")

# Gap at high SES for the interaction caveat
b_int = m3.params['Black x SES']
print(f"Black x SES interaction: {b_int:.4f}; implied Black-vs-White log-odds gap at SES=+1 SD: {b + b_int:.4f}")
