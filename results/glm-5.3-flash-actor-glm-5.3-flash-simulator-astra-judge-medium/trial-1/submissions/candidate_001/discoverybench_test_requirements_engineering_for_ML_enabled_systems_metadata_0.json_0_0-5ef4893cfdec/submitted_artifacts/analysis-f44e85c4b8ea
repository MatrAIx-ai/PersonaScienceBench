"""
Which two roles have the highest proportion of association with requirements
in ML-enabled systems?

Data: requirements_engineering_for_ML-enabled_systems.csv (survey, 276 rows).
Q8_ML_Addressing_* columns are binary indicators: 'quoted' / 'not quoted',
with -77 sentinels on the 82 Suspended rows (non-responses -> excluded).
Definition: proportion associated = quoted / (quoted + not quoted) per role.
Inference: nonparametric respondent-level bootstrap, B=10,000, percentile CIs.
"""
import numpy as np
import pandas as pd

RNG = np.random.default_rng(20261019)
B = 10_000

Q8 = ['Q8_ML_Addressing_Project_Lead',
      'Q8_ML_Addressing_Business_Analyst',
      'Q8_ML_Addressing_Requirement_Engineer',
      'Q8_ML_Addressing_Solution_Architect',
      'Q8_ML_Addressing_Data_Scientist',
      'Q8_ML_Addressing_Developer',
      'Q8_ML_Addressing_Tester']
LABEL = {'Q8_ML_Addressing_Project_Lead': 'Project Lead / Project Manager',
         'Q8_ML_Addressing_Business_Analyst': 'Business Analyst',
         'Q8_ML_Addressing_Requirement_Engineer': 'Requirements Engineer',
         'Q8_ML_Addressing_Solution_Architect': 'Solution Architect',
         'Q8_ML_Addressing_Data_Scientist': 'Data Scientist',
         'Q8_ML_Addressing_Developer': 'Developer',
         'Q8_ML_Addressing_Tester': 'Test Manager / Tester'}

df = pd.read_csv('data/requirements_engineering_for_ML-enabled_systems.csv')
print(f'rows x cols: {df.shape[0]} x {df.shape[1]}')

# --- exclusions: drop rows whose Q8 block is entirely -77 (== Suspended rows)
mask77 = (df[Q8] == '-77').any(axis=1)
print('rows with -77 in Q8 block:', mask77.sum(),
      '| Status of those rows:', df.loc[mask77, 'Status'].unique().tolist())
d = df[~mask77].copy()
n = len(d)
print('usable n =', n)

# binary matrix: 1 = quoted, 0 = not quoted
X = (d[Q8] == 'quoted').astype(int).to_numpy()          # n x 7
counts = X.sum(axis=0)
props = counts / n

rows = []
boot = np.empty((B, len(Q8)))
for j, c in enumerate(Q8):
    boot[:, j] = X[RNG.integers(0, n, (B, n)), j].mean(axis=1)
    lo, hi = np.percentile(boot[:, j], [2.5, 97.5])
    rows.append({'role': LABEL[c], 'quoted': int(counts[j]), 'n': n,
                 'prop_%': round(100 * props[j], 2),
                 'ci_lo_%': round(100 * lo, 2), 'ci_hi_%': round(100 * hi, 2),
                 'boot_SE_%': round(100 * boot[:, j].std(ddof=1), 2)})
res = pd.DataFrame(rows).sort_values('prop_%', ascending=False)
print('\n=== Main analysis (n=194) ===')
print(res.to_string(index=False))

# --- paired bootstrap: P(Project Lead > Data Scientist)
i_lead = Q8.index('Q8_ML_Addressing_Project_Lead')
i_ds = Q8.index('Q8_ML_Addressing_Data_Scientist')
p_lead_gt_ds = (boot[:, i_lead] > boot[:, i_ds]).mean()
print(f'\nP(Project Lead > Data Scientist | paired bootstrap) = {p_lead_gt_ds:.3f}')

# rank-stability across bootstrap replicates: how often is {Lead, Scientist} the top-2 set?
order = boot.argsort(axis=1)[:, ::-1]          # descending role indices
top2 = np.sort(order[:, :2], axis=1)
stable = (top2 == np.sort([i_lead, i_ds])).all(axis=1).mean()
print(f'P(top-2 set == {{Project Lead, Data Scientist}}) = {stable:.3f}')

# --- sensitivity variants ---
def variant(name, sub):
    x = (sub[Q8] == 'quoted').astype(int)
    m = x.mean().sort_values(ascending=False) * 100
    top = ', '.join(f'{LABEL[c].split(" /")[0]}={v:.2f}%' for c, v in m.head(2).items())
    print(f'{name:<38} n={len(sub):>3}  top-2: {top}')

print('\n=== Sensitivity ===')
variant('main (all non-sentinel)', d)
variant('Completed (31) only', d[d['Status'] == 'Completed (31)'])
variant('Completed + after-break', d[d['Status'] != 'Suspended (22)'])
variant('exclude D4_Role == 0', d[d['D4_Role'] != '0'])
variant('only respondents quoting >=1 role',
        d[(d[Q8] == 'quoted').any(axis=1)])

# bootstrap CI for the near-tie under Completed-only (the variant where they tie exactly)
dc = d[d['Status'] == 'Completed (31)']
Xc = (dc[Q8] == 'quoted').astype(int).to_numpy()
nc = len(dc)
bc = np.column_stack([Xc[RNG.integers(0, nc, (B, nc)), j].mean(axis=1) for j in range(len(Q8))])
print(f"\nCompleted-only paired bootstrap P(Lead > Scientist) = "
      f"{(bc[:, i_lead] > bc[:, i_ds]).mean():.3f}")
res.to_csv('q8_role_proportions_bootstrap.csv', index=False)
print('\nSaved table -> q8_role_proportions_bootstrap.csv')
