"""
Requirements Engineering for ML-enabled Systems - Q9 elicitation techniques analysis.
Question: Which elicitation technique is most commonly used by respondents, with
69.399% (95% CI [69.062, 69.735]) referenced as a benchmark anchor?

Coding decisions (per study context):
  'quoted'     -> technique used
  'not quoted' -> technique not used
  -77 / -99 / -66, negative Duration -> non-response sentinels, excluded
"""
import numpy as np
import pandas as pd

SEED = 42
N_BOOT = 10_000
CSV = "data/requirements_engineering_for_ML-enabled_systems.csv"

Q9 = ["Q9_ML_Elicitation_Interviews", "Q9_ML_Elicitation_Scenarios",
      "Q9_ML_Elicitation_Prototyping", "Q9_ML_Elicitation_Workshops_Meetings",
      "Q9_ML_Elicitation_Observation", "Q9_ML_Elicitation_Others"]
SHORT = {c: c.replace("Q9_ML_Elicitation_", "") for c in Q9}

df = pd.read_csv(CSV)
print(f"Loaded {CSV}: {df.shape[0]} rows x {df.shape[1]} cols")
print("Status:", df["Status"].value_counts().to_dict())
print("Duration: min=%s max=%s (negative -> non-response)" % (df["Duration"].min(), df["Duration"].max()))

def make_sub(exclude_suspended=False):
    """Valid-analysis frame: Q9 answered (not -77). Optionally drop ALL suspended."""
    s = df[df["Q9_ML_Elicitation_Interviews"] != "-77"].copy()
    if exclude_suspended:
        s = s[~s["Status"].str.startswith("Suspended")]
    return s

def weights(sub, wcol):
    if wcol is None:
        return np.ones(len(sub))
    w = pd.to_numeric(sub[wcol], errors="coerce").where(lambda x: x >= 0)  # -99 -> NA
    return w.fillna(0).to_numpy()

def prop_table(sub, wcol):
    w = weights(sub, wcol)
    W = w.sum()
    rows = []
    for c in Q9:
        x = (sub[c] == "quoted").astype(float).to_numpy()
        p = w.dot(x) / W
        rows.append((SHORT[c], int((sub[c] == "quoted").sum()), p))
    return rows, w

def bootstrap(sub, wcol, rng):
    """Cluster (respondent-level) bootstrap, consistent within each scheme."""
    w = weights(sub, wcol)
    X = np.column_stack([(sub[c] == "quoted").astype(float).to_numpy() for c in Q9])
    n = len(sub)
    boots = np.empty((N_BOOT, len(Q9)))
    for b in range(N_BOOT):
        idx = rng.integers(0, n, n)
        wb = w[idx]
        boots[b] = wb.dot(X[idx]) / wb.sum()
    return boots

rng = np.random.default_rng(SEED)
schemes = [("unweighted (N=194)", None, make_sub(False)),
           ("D7-weighted (total ML projects)", "D7_Total_ML_Projects", make_sub(False)),
           ("D8-weighted (deployed projects)", "D8_ML_Production", make_sub(False))]

results = {}
for name, wcol, sub in schemes:
    rows, w = prop_table(sub, wcol)
    boots = bootstrap(sub, wcol, rng)
    lo, hi = np.percentile(boots, [2.5, 97.5], axis=0)
    print(f"\n=== Scheme: {name}  (sum of weights = {w.sum():.0f}, n = {len(sub)}) ===")
    print(f"{'Technique':<20}{'quoted':>7}{'point %':>10}{'95% CI low':>12}{'95% CI high':>13}")
    for (t, q, p), l, h in zip(rows, lo, hi):
        print(f"{t:<20}{q:>7}{100*p:>10.3f}{100*l:>12.3f}{100*h:>13.3f}")
    results[name] = pd.DataFrame({"technique": [r[0] for r in rows],
                                  "quoted": [r[1] for r in rows],
                                  "point_pct": [100*r[2] for r in rows],
                                  "ci_low": [100*l for l in lo],
                                  "ci_high": [100*h for h in hi],
                                  "scheme": name})

res = pd.concat(results.values(), ignore_index=True)
first = res.loc[res.groupby("scheme")["point_pct"].idxmax()][["scheme", "technique", "point_pct"]]
print("\n=== Rank-1 technique per scheme ===")
print(first.to_string(index=False))

# distance to benchmark anchor 69.399%
ANCHOR = 69.399
res["dist_to_anchor"] = (res["point_pct"] - ANCHOR).abs()
best = res.nsmallest(3, "dist_to_anchor")
print("\n=== Closest reported proportions to benchmark anchor 69.399% ===")
print(best[["scheme", "technique", "point_pct", "dist_to_anchor"]].to_string(index=False))

# ---- Sensitivity check (a): exclude all 88 suspended vs keep the 6 who answered
sub_excl = make_sub(exclude_suspended=True)
rows_a, _ = prop_table(sub_excl, None)
print(f"\n=== Sensitivity (a): excluding ALL suspended (valid N = {len(sub_excl)}) ===")
for t, q, p in rows_a:
    print(f"{t:<20}{q:>7}{100*p:>10.3f}")

# ---- Sensitivity check (b): add Others_Free mentions
sub_b = make_sub(False)
free = sub_b["Q9_ML_Elicitation_Others_Free"].astype(str).str.strip()
has_free = ((free != "-99") & (free != "-66") & (free != "nan") & (free != "") &
            (free.str.lower() != "i don't know"))
print(f"\n=== Sensitivity (b): Others_Free mentions (n with text = {has_free.sum()}) ===")
for c in Q9:
    base = (sub_b[c] == "quoted")
    if c == "Q9_ML_Elicitation_Others":
        adj = base | has_free
    else:
        adj = base
    print(f"{SHORT[c]:<20} base={base.sum():>3}  (+free)={adj.sum():>3}  "
          f"base%={100*base.mean():.2f}  adj%={100*adj.mean():.2f}")

# ---- Project-expanded (pair-level) check: replicate rows by D7 / D8 project counts
print("\n=== Project-expanded datasets (one row per respondent-project pair) ===")
for wcol, label in [("D7_Total_ML_Projects", "D7-expanded"), ("D8_ML_Production", "D8-expanded")]:
    sub = make_sub(False)
    w = weights(sub, wcol).astype(int)
    idx = np.repeat(np.arange(len(sub)), w)
    exp = sub.iloc[idx].reset_index(drop=True)
    print(f"{label}: {len(exp)} project rows")
    for c in Q9:
        print(f"   {SHORT[c]:<20} quoted% = {100*(exp[c]=='quoted').mean():.3f}")
    # naive (non-cluster) bootstrap CI for Interviews on expanded data
    x = (exp["Q9_ML_Elicitation_Interviews"] == "quoted").astype(float).to_numpy()
    nb = np.array([x[rng.integers(0, len(x), len(x))].mean() for _ in range(N_BOOT)])
    lo, hi = np.percentile(nb, [2.5, 97.5])
    print(f"   Interviews naive bootstrap 95% CI: [{100*lo:.3f}, {100*hi:.3f}]")

res.to_csv("analysis/q9_proportions_bootstrap.csv", index=False)
print("\nSaved table -> analysis/q9_proportions_bootstrap.csv")
