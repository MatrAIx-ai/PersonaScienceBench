"""
DiscoveryBench: requirements_engineering_for_ML-enabled_systems
Question: Which two documentation formats are the least used for requirements in
ML-enabled system projects (with reported target percentages 10.13% and 4.366%
after bootstrapping)?

Workflow:
  1. Load data; restrict to Q10_ML_Documentation_* columns.
  2. Exclude the 82 respondents carrying the -77 skip sentinel in Q10
     (these align with Status == 'Suspended'); valid n = 194.
  3. Usage measure: binary indicator ('quoted') / 194, per format.
  4. Bootstrap: resample the 194 valid respondents with replacement,
     B = 10,000, seed = 42, percentile CI (2.5 / 97.5).
  5. Reconciliation pass: test alternative aggregations against the
     target percentages 10.13% [9.926, 10.333] and 4.366% [4.231, 4.501].
"""
import itertools
import numpy as np
import pandas as pd

SEED, B = 42, 10000
T1, T1CI = 10.13, (9.926, 10.333)
T2, T2CI = 4.366, (4.231, 4.501)

df = pd.read_csv('data/requirements_engineering_for_ML-enabled_systems.csv')
q10 = [c for c in df.columns if c.startswith('Q10_ML_Documentation') and not c.endswith('_Free')]
labels = {c: c.replace('Q10_ML_Documentation_', '').replace('_', ' ') for c in q10}

# ---- valid respondents: drop rows with -77 sentinel anywhere in Q10 ----
sentinel = df[q10].apply(lambda r: (r == '-77').any(), axis=1)
print(f"rows total={len(df)}  skip-sentinel(-77) rows={sentinel.sum()}  valid n={(~sentinel).sum()}")
valid = df.loc[~sentinel, q10]
n = len(valid)

# binary usage matrix: 1 = 'quoted'
X = (valid == 'quoted').astype(int).to_numpy()
counts = X.sum(axis=0)
props = counts / n

print(f"\n{'format':<20}{'quoted':>7}{'rate(%)':>10}")
for c, k, p in sorted(zip(q10, counts, props), key=lambda t: t[1]):
    print(f"{labels[c]:<20}{k:>7}{100*p:>10.3f}")

# ---- bootstrap percentile CIs ----
rng = np.random.default_rng(SEED)
idx = rng.integers(0, n, size=(B, n))
boot = X[idx].mean(axis=1) * 100          # B x 12, in percent
lo, hi = np.percentile(boot, [2.5, 97.5], axis=0)
print("\nBootstrap (B=10000, percentile, seed=42), rates in %:")
res = pd.DataFrame({'format': [labels[c] for c in q10], 'quoted': counts,
                    'rate_pct': props * 100, 'ci_lo': lo, 'ci_hi': hi}
                   ).sort_values('rate_pct').reset_index(drop=True)
print(res.to_string(index=False, float_format=lambda v: f"{v:.3f}"))

# ================= RECONCILIATION PASS =================
print("\n" + "=" * 70)
print("RECONCILIATION PASS vs targets 10.13% [9.926,10.333] / 4.366% [4.231,4.501]")
print("=" * 70)

def match(x, t, ci):
    return abs(x - t) < 0.05 and ci[0] <= t <= ci[1]

# (a) denominator 276, -77 treated as non-use
X_all = (df[q10] == 'quoted').astype(int).to_numpy()
p_a = X_all.mean(axis=0) * 100
print("\n(a) denominator 276 (-77 as non-use):")
for c, v in sorted(zip(q10, p_a), key=lambda t: t[1])[:5]:
    print(f"   {labels[c]:<20}{v:.3f}%")
print("   -> two lowest:", [labels[c] for c, _ in sorted(zip(q10, p_a), key=lambda t: t[1])[:2]])

# (b) quoted / total quoted selections (416)
tot = counts.sum()
print(f"\n(b) quoted / total quoted selections (total={tot}):")
p_b = counts / tot * 100
for c, v in sorted(zip(q10, p_b), key=lambda t: t[1])[:5]:
    print(f"   {labels[c]:<20}{v:.3f}%")
print("   closest to 10.13%:", sorted(zip([labels[c] for c in q10], p_b), key=lambda t: abs(t[1]-T1))[:2])
print("   closest to 4.366%:", sorted(zip([labels[c] for c in q10], p_b), key=lambda t: abs(t[1]-T2))[:2])

# (c) per-format denominators implied by 'not quoted' (i.e., n=194) already used;
#     also try denominator = respondents who quoted >=1 format
any_use = (X.sum(axis=1) > 0).sum()
print(f"\n(c) denominator = respondents quoting >=1 format: {any_use}")
p_c = counts / any_use * 100
for c, v in sorted(zip(q10, p_c), key=lambda t: t[1])[:5]:
    print(f"   {labels[c]:<20}{v:.3f}%")

# (d) inverse-frequency weighting: each respondent contributes 1/k if they quote k formats
k = X.sum(axis=1)
w = np.where(k > 0, 1.0 / np.maximum(k, 1), 0.0)
p_d = (X * w[:, None]).sum(axis=0) / n * 100
print("\n(d) inverse-frequency-weighted usage (respondent weight 1/#formats-quoted):")
for c, v in sorted(zip(q10, p_d), key=lambda t: t[1])[:5]:
    print(f"   {labels[c]:<20}{v:.3f}%")

# (e) exhaustive small-fraction search: does ANY a/b with b in plausible denominators
#     reproduce both targets?
denoms = [n, len(df), any_use, tot, 164, 188, 148, 12 * n, tot + 82]
print("\n(e) exhaustive fraction check (counts 1..80 / plausible denominators):")
hits1, hits2 = [], []
for b in denoms:
    for a in range(1, 81):
        r = 100 * a / b
        if abs(r - T1) < 0.005: hits1.append((a, b, r))
        if abs(r - T2) < 0.005: hits2.append((a, b, r))
print("   fractions near 10.13%:", hits1)
print("   fractions near 4.366%:", hits2)

# (f) bootstrap MEANS of the two candidate rates vs target CIs
print("\n(f) bootstrap mean/CI of candidate rates vs target CIs:")
for c in ['Q10_ML_Documentation_BDD_Scenarios', 'Q10_ML_Documentation_MLCanvas',
          'Q10_ML_Documentation_Others', 'Q10_ML_Documentation_Goal_Models',
          'Q10_ML_Documentation_Vision_Document', 'Q10_ML_Documentation_Prototypes']:
    j = q10.index(c)
    print(f"   {labels[c]:<20} mean={boot[:, j].mean():.3f}%  CI=[{lo[j]:.3f},{hi[j]:.3f}]")

# (g) can ANY pair of formats' bootstrap CIs contain the target CIs?
print("\n(g) formats whose bootstrap CI overlaps the target CIs:")
for j, c in enumerate(q10):
    if lo[j] <= T1CI[1] and hi[j] >= T1CI[0]:
        print(f"   10.13% in CI of {labels[c]}: [{lo[j]:.3f},{hi[j]:.3f}]")
    if lo[j] <= T2CI[1] and hi[j] >= T2CI[0]:
        print(f"   4.366% in CI of {labels[c]}: [{lo[j]:.3f},{hi[j]:.3f}]")

res.to_csv('output/q10_usage_bootstrap.csv', index=False)
print("\nSaved output/q10_usage_bootstrap.csv")
