"""
Effect of education expenditure on per capita income: SSA vs Lower Middle Income (LMC).
Data-grounded associational analysis. Outcome: GNI per capita (constant 2015 US$), NY.GNP.PCAP.KD.
Treatment: Adjusted savings: education expenditure (% of GNI), NY.ADJ.AEDU.GN.ZS.
"""
import numpy as np, pandas as pd, statsmodels.api as sm
import io, re, warnings
warnings.filterwarnings("ignore")

# ---------- 1. Load & tidy ----------
raw = pd.read_csv("data/worldbank_education_gdp.csv")
year_cols = [c for c in raw.columns if "[YR" in c]
years = [int(re.search(r"\d{4}", c).group()) for c in year_cols]
long = raw.melt(id_vars=["Country Code", "Series Code"], value_vars=year_cols,
                var_name="ycol", value_name="value")
long["year"] = long["ycol"].str.extract(r"(\d{4})").astype(int)
long["value"] = pd.to_numeric(long["value"], errors="coerce")
wide = long.pivot_table(index=["Country Code", "year"], columns="Series Code",
                        values="value", aggfunc="first").reset_index()
wide = wide.rename(columns={
    "Country Code": "group",
    "NY.GNP.PCAP.KD": "gni_pc",
    "NY.ADJ.AEDU.GN.ZS": "edu_exp",
    "NE.EXP.GNFS.KD.ZG": "exports_gr",
    "SE.PRM.ENRR": "prim_enr",
    "SE.SEC.ENRR": "sec_enr",
    "SL.TLF.CACT.ZS": "lfp"})
wide["log_gni"] = np.log(wide["gni_pc"])
wide["LMC"] = (wide["group"] == "LMC").astype(int)
wide["t"] = wide["year"] - 1975
wide["lag_edu"] = wide.groupby("group")["edu_exp"].shift(1)
wide["lag_sec"] = wide.groupby("group")["sec_enr"].shift(1)
wide["lag_exp"] = wide.groupby("group")["exports_gr"].shift(1)
wide["lag_lfp"] = wide.groupby("group")["lfp"].shift(1)

def ols(df, y, X_cols, hac_lags=2):
    d = df.dropna(subset=[y] + X_cols)
    X = sm.add_constant(d[X_cols])
    m = sm.OLS(d[y], X).fit()
    mh = sm.OLS(d[y], X).fit(cov_type="HAC", cov_kwds={"maxlags": hac_lags})
    return d, m, mh

def ar1_gls(df, y, X_cols):
    d = df.dropna(subset=[y] + X_cols)
    X = sm.add_constant(d[X_cols])
    return sm.GLSAR(d[y], X, rho=1).iterative_fit(maxiter=10)

def slope_report(m, names):
    # group-specific slopes for spec: <treat>, LMC, <treat>:LMC
    treat = names[0]
    inter = treat + ":LMC"
    b, V = m.params, m.cov_params()
    beta = b[treat]
    gam = b[inter] if inter in b.index else 0.0
    gvar = V.loc[inter, inter] if inter in b.index else 0.0
    cov_bg = V.loc[treat, inter] if inter in b.index else 0.0
    b_lmc = beta + gam
    v_lmc = V.loc[treat, treat] + gvar + 2 * cov_bg
    se_ssa, se_lmc = np.sqrt(V.loc[treat, treat]), np.sqrt(v_lmc)
    b_lmc = beta + gam
    v_lmc = V.loc[treat, treat] + gvar + 2 * cov_bg
    # Wald test gamma = 0
    w = gam**2 / gvar if gvar > 0 else np.nan
    from scipy import stats as st
    p = 1 - st.chi2.cdf(w, 1) if np.isfinite(w) else np.nan
    return dict(beta_SSA=beta, se_SSA=se_ssa, beta_LMC=b_lmc, se_LMC=se_lmc,
                gamma=gam, se_gamma=np.sqrt(gvar), wald_chi2=w, wald_p=p)

rows = []
def show(label, d):
    print(f"\n=== {label}  (N={len(d)}) ===")
    print(d[["group", "year", "log_gni", "lag_edu"]].round(3).to_string(index=False))

print("#### DESCRIPTIVES ####")
print(wide.groupby("group")[["edu_exp", "gni_pc", "sec_enr", "prim_enr"]].describe().round(2).T)

# ---------- 2. Branch (a): 2011-2015 overlap, income equation ----------
ov = wide[(wide["year"] >= 2011) & (wide["year"] <= 2015)].copy()
ov["lag_edu:LMC"] = ov["lag_edu"] * ov["LMC"]
X_a = ["lag_edu", "LMC", "lag_edu:LMC"]
d_a, m_a, mh_a = ols(ov, "log_gni", X_a)
show("Branch (a) 2011-2015 overlap, log GNI pc on lagged edu exp + LMC + interaction", d_a)
print(m_a.summary().tables[1])
print("Group slopes / gamma test (HAC SEs):", {k: round(v, 4) if isinstance(v, float) else v
      for k, v in slope_report(mh_a, X_a).items()})

# with one control (lagged secondary enrollment) — df-limited sensitivity
X_ac = ["lag_edu", "LMC", "lag_edu:LMC", "lag_sec"]
_, m_ac, mh_ac = ols(ov, "log_gni", X_ac)
print("\n-- with lag_sec control --")
print(m_ac.summary().tables[1])
print("Group slopes / gamma (HAC):", {k: round(v, 4) if isinstance(v, float) else v
      for k, v in slope_report(mh_ac, X_ac).items()})

# first-difference version of branch (a)
ov_fd = ov.copy()
for g in ["SSF", "LMC"]:
    idx = ov_fd["group"] == g
    ov_fd.loc[idx, "d_log_gni"] = ov_fd.loc[idx, "log_gni"].diff()
    ov_fd.loc[idx, "d_lag_edu"] = ov_fd.loc[idx, "lag_edu"].diff()
ov_fd["d_lag_edu:LMC"] = ov_fd["d_lag_edu"] * ov_fd["LMC"]
d_afd, m_afd, mh_afd = ols(ov_fd.dropna(), "d_log_gni", ["d_lag_edu", "LMC", "d_lag_edu:LMC"])
print("\n-- first differences (2011-2015) --")
print(m_afd.summary().tables[1])
print("Group slopes / gamma (HAC):", {k: round(v, 4) if isinstance(v, float) else v
      for k, v in slope_report(mh_afd, ["d_lag_edu", "LMC", "d_lag_edu:LMC"]).items()})

# AR(1) variant of branch (a)
m_ar = ar1_gls(ov, "log_gni", X_a)
print("\n-- GLS AR(1) branch (a) --")
print(pd.DataFrame({"coef": m_ar.params, "se": m_ar.bse}).round(4))

# ---------- 3. LMC income effect, full window ----------
lmc = wide[wide["group"] == "LMC"].copy()
lmc["trend"] = lmc["t"]
lmc_no_crisis = lmc[~lmc["year"].isin([2008, 2009, 2010])]
res_lmc = {}
for label, df_, cols in [
    ("1975-2015 bivariate + trend", lmc, ["lag_edu", "trend"]),
    ("1991-2015 + controls (lag_sec, lag_exp, lag_lfp) + trend",
     lmc, ["lag_edu", "trend", "lag_sec", "lag_exp", "lag_lfp"]),
    ("1991-2015 + controls, excl. 2008-2010",
     lmc_no_crisis, ["lag_edu", "trend", "lag_sec", "lag_exp", "lag_lfp"]),
    ("1975-2015 bivariate, excl. 2008-2010", lmc_no_crisis, ["lag_edu", "trend"])]:
    _, m, mh = ols(df_, "log_gni", cols)
    res_lmc[label] = (m.params["lag_edu"], mh.bse["lag_edu"], m.rsquared, len(m.model.data.orig_exog))
    print(f"\nLMC log_gni ~ {label}: beta_lag_edu = {m.params['lag_edu']:.4f} "
          f"(HAC se {mh.bse['lag_edu']:.4f}, p={mh.pvalues['lag_edu']:.3f}), R2={m.rsquared:.3f}, N={len(m.model.data.orig_exog)}")

# FD version (LMC, full window)
lmc_fd = lmc.copy()
lmc_fd["d_log_gni"] = lmc_fd["log_gni"].diff()
lmc_fd["d_edu"] = lmc_fd["edu_exp"].diff()
_, m_fd, mh_fd = ols(lmc_fd.dropna(), "d_log_gni", ["d_edu"])
print(f"LMC FD: d_log_gni ~ d_edu: beta = {m_fd.params['d_edu']:.4f} (HAC se {mh_fd.bse['d_edu']:.4f}, p={mh_fd.pvalues['d_edu']:.3f}), N={len(m_fd.model.data.orig_exog)}")

# ---------- 4. Branch (b): enrollment channel, both groups, full window ----------
for outcome in ["sec_enr", "prim_enr"]:
    for window, tag in [((1975, 2015), "1975-2015"), ((1991, 2015), "1991-2015 balanced")]:
        w = wide[(wide["year"] >= window[0]) & (wide["year"] <= window[1])].copy()
        w["g_trend"] = w["t"] * w["LMC"]; w["trend"] = w["t"]
        w["lag_edu:LMC"] = w["lag_edu"] * w["LMC"]
        cols = ["lag_edu", "LMC", "lag_edu:LMC", "trend", "g_trend"]
        if tag.startswith("1991"): cols += ["lag_exp", "lag_lfp"]
        d, m, mh = ols(w, outcome, cols)
        r = slope_report(mh, cols)
        print(f"\nEnrollment channel [{outcome}] [{tag}]: beta_SSA={r['beta_SSA']:.4f}(se {r['se_SSA']:.4f}) "
              f"beta_LMC={r['beta_LMC']:.4f}(se {r['se_LMC']:.4f}) gamma={r['gamma']:.4f} "
              f"(Wald chi2={r['wald_chi2']:.2f}, p={r['wald_p']:.3f}), N={len(d)}, R2={m.rsquared:.3f}")

# FD enrollment channel
w = wide.copy()
w["d_sec"] = w.groupby("group")["sec_enr"].diff()
w["d_lag_edu_fd"] = w.groupby("group")["lag_edu"].diff()
w["d_lag_edu_fd:LMC"] = w["d_lag_edu_fd"] * w["LMC"]
d, m, mh = ols(w.dropna(subset=["d_sec", "d_lag_edu_fd", "LMC", "d_lag_edu_fd:LMC"]),
               "d_sec", ["d_lag_edu_fd", "LMC", "d_lag_edu_fd:LMC"])
r = slope_report(mh, ["d_lag_edu_fd", "LMC", "d_lag_edu_fd:LMC"])
print(f"\nEnrollment channel [d_sec_enr] [FD 1975-2015]: beta_SSA={r['beta_SSA']:.4f}(se {r['se_SSA']:.4f}) "
      f"beta_LMC={r['beta_LMC']:.4f}(se {r['se_LMC']:.4f}) gamma={r['gamma']:.4f} "
      f"(Wald p={r['wald_p']:.3f}), N={len(d)}, R2={m.rsquared:.3f}")

# ---------- 5. Raw correlations for context ----------
print("\n#### RAW within-group correlations (lagged edu exp vs outcome) ####")
for g in ["SSF", "LMC"]:
    for outcome, win in [("log_gni", (2011, 2015)), ("log_gni", (1975, 2015)),
                         ("sec_enr", (1975, 2015)), ("prim_enr", (1975, 2015))]:
        s = wide[(wide["group"] == g) & wide["year"].between(*win)].dropna(subset=["lag_edu", outcome])
        if len(s) > 2:
            c = np.corrcoef(s["lag_edu"], s[outcome])[0, 1]
            print(f"{g}: corr(lag_edu, {outcome}) {win}: r={c:.3f} (n={len(s)})")
