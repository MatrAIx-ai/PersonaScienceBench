"""
Age and the likelihood of withdrawing more from savings than putting in (NLSY79).
Primary contrast: DISSAVED=1 (dissavers) vs DISSAVED=0 & SAMESAVE=0 (net savers);
the no-change/no-savings group (SAMESAVE=1) is excluded from the primary sample.
Full-sample model run as robustness.
"""
import numpy as np
import pandas as pd
import statsmodels.api as sm

df = pd.read_csv('data/nls_bmi_processed.csv')
n0 = len(df)

# ---------- feature engineering ----------
df['FEMALE'] = (df['GENDER'] == 'FEMALE').astype(int)
df['LOGINC'] = np.log(df['INCOME'] + 1.0)
df['AGE_C'] = df['AGE'] - df['AGE'].mean()
df['AGE_C2'] = df['AGE_C'] ** 2
df['IMPUTED_INC'] = (df['INCOME'] == df['INCOME'].mean()).astype(int)

# BMI extremes: winsorize at 1st/99th pct for sensitivity model
lo, hi = df['BMI'].quantile([0.01, 0.99])
df['BMI_W'] = df['BMI'].clip(lo, hi)

# ---------- samples ----------
primary = df[(df.DISSAVED == 1) | ((df.DISSAVED == 0) & (df.SAMESAVE == 0))].copy()
print(f"Full sample n={n0}; primary sample n={len(primary)} "
      f"(dissavers {int(primary.DISSAVED.sum())} vs net savers {int(((primary.DISSAVED==0)&(primary.SAMESAVE==0)).sum())}); "
      f"excluded no-change/no-savings rows n={n0-len(primary)}")

CTRL = ['LOGINC', 'FEMALE', 'BLACK', 'HISPANIC', 'BMI']

def fit(data, cols, label, age_key='AGE'):
    X = sm.add_constant(data[cols]); y = data['DISSAVED']
    m = sm.Logit(y, X).fit(disp=0)
    ors = np.exp(m.params); ci = np.exp(m.conf_int())
    return {
        'model': label, 'n': int(m.nobs),
        'age_or': round(ors[age_key], 4),
        'age_lo': round(ci.loc[age_key, 0], 4), 'age_hi': round(ci.loc[age_key, 1], 4),
        'age_p': round(m.pvalues[age_key], 5),
        'age2_or': round(ors.get('AGE_C2', np.nan), 4) if 'AGE_C2' in ors else '',
        'age2_p': round(m.pvalues['AGE_C2'], 4) if 'AGE_C2' in m.pvalues else '',
        'pseudo_r2': round(m.prsquared, 4),
    }, m

rows, models = [], {}
rows.append(fit(primary, ['AGE'], 'M1 unadjusted AGE-only (primary sample)')[0])
rows.append(fit(primary, ['AGE'] + CTRL, 'M2 adjusted (primary sample)')[0])
mm, mmobj = fit(primary, ['AGE_C', 'AGE_C2'] + CTRL, 'M3 adjusted + centered AGE^2 (primary sample)', age_key='AGE_C')
# report AGE OR on original scale for M3: since AGE_C=AGE-mean, same OR
rows.append(mm)
rows.append(fit(df, ['AGE'] + CTRL, 'M4 adjusted FULL sample (robustness)')[0])
rows.append(fit(primary[primary.IMPUTED_INC == 0], ['AGE'] + CTRL,
                'M5 adjusted, mean-imputed incomes EXCLUDED')[0])
rows.append(fit(primary, ['AGE'] + ['LOGINC', 'FEMALE', 'BLACK', 'HISPANIC', 'BMI_W'],
                'M6 adjusted, BMI winsorized 1st/99th')[0])
rows.append(fit(df[df.IMPUTED_INC == 0], ['AGE'] + CTRL,
                'M7 adjusted FULL sample, imputed incomes excluded (robustness)')[0])
tab = pd.DataFrame(rows)
print('\n=== MODEL TABLE (AGE odds ratio, 95% CI) ===')
print(tab.to_string(index=False))
tab.to_csv('output/model_table.csv', index=False)

# ---------- descriptives ----------
g1 = df.groupby('AGE')['DISSAVED'].agg(['mean', 'sum', 'count'])
g1['mean'] = (g1['mean'] * 100).round(2)
print('\n=== Withdrawal rate by single year of age (full sample) ===')
print((g1['mean'] / 100).round(4).to_string(), '\n  n per age:', g1['count'].to_dict())

df['AGE_BAND'] = np.where(df.AGE <= 25, '24-25', np.where(df.AGE <= 27, '26-27',
                np.where(df.AGE <= 29, '28-29', np.where(df.AGE <= 31, '30-31', '32'))))
g2 = df.groupby('AGE_BAND')['DISSAVED'].agg(['mean', 'count']).reindex(
    ['24-25', '26-27', '28-29', '30-31', '32'])
print('\n=== Withdrawal rate by 2-year age band (secondary descriptive) ===')
for b, r in g2.iterrows():
    print(f"  {b}: {r['mean']*100:.2f}%  (n={int(r['count'])})")
g2.assign(rate=g2['mean'].round(4)).to_csv('output/age_band_rates.csv')

# predicted probability trajectory from M2 (holding covariates at sample means)
m2 = sm.Logit(primary['DISSAVED'], sm.add_constant(primary[['AGE'] + CTRL])).fit(disp=0)
grid = pd.DataFrame({'AGE': range(24, 33)})
for c in CTRL: grid[c] = primary[c].mean()
Xg = grid[['AGE'] + CTRL].copy(); Xg.insert(0, 'const', 1.0)
pred = m2.predict(Xg)
print('\nAdjusted predicted P(DISSAVED=1) at covariate means, by age:')
for a, p in zip(grid.AGE, pred): print(f"  age {a}: {p*100:.1f}%")
m2.summary2().tables[1].round(4).to_csv('output/M2_full_coefficients.csv')

# ---------- imputation-artifact diagnostics ----------
print('\n=== IMPUTATION-ARTIFACT DIAGNOSTICS ===')
bmi_mode = df.BMI.value_counts().index[0]
both = int(((df.IMPUTED_INC==1) & (np.isclose(df.BMI, bmi_mode))).sum())
print('Mean-imputed rows (INCOME == sample mean): %d (%.1f%%); of these, %d also have BMI == modal value %.6f'
      % (df.IMPUTED_INC.sum(), 100*df.IMPUTED_INC.mean(), both, bmi_mode))
print('Rows with modal BMI total: %d' % int(np.isclose(df.BMI, bmi_mode).sum()))
print('Imputed share by age:'); print(df.groupby('AGE').IMPUTED_INC.mean().round(3).to_string())
print('DISSAVED rate, imputed vs observed rows: %.3f vs %.3f'
      % (df[df.IMPUTED_INC==1].DISSAVED.mean(), df[df.IMPUTED_INC==0].DISSAVED.mean()))
r, mo = fit(primary[primary.IMPUTED_INC==0], ['AGE'], 'M8 unadjusted AGE-only, observed-income rows only')
print('Unadjusted AGE OR among observed-income rows: OR=%.4f CI=(%.4f,%.4f) p=%.4g n=%d'
      % (r['age_or'], r['age_lo'], r['age_hi'], r['age_p'], r['n']))
rows.append(r)
rows.append(fit(df, ['AGE'] + CTRL + ['IMPUTED_INC'], 'M9 adjusted FULL sample + imputation flag')[0])
tab = pd.DataFrame(rows)
print('\n=== FINAL MODEL TABLE (AGE odds ratio, 95% CI) ===')
print(tab.to_string(index=False))
tab.to_csv('output/model_table.csv', index=False)

# ---------- SVG plot (no plotting library available) ----------
def bar_svg(rates, ns, title, fname, ylabel='Withdrawal rate (DISSAVED=1)'):
    W, H, L, B, T, R = 900, 460, 70, 60, 60, 20
    pw, ph = W - L - R, H - B - T
    ymax = 0.30
    bw = pw / len(rates) * 0.6
    parts = [f'<svg xmlns="http://www.w3.org/2000/svg" width="{W}" height="{H}" font-family="Helvetica">']
    parts.append(f'<text x="{W/2}" y="25" text-anchor="middle" font-size="16" font-weight="bold">{title}</text>')
    for f in np.arange(0, ymax + 0.001, 0.05):
        y = B - ph * f / ymax
        parts.append(f'<line x1="{L}" y1="{y:.1f}" x2="{W-R}" y2="{y:.1f}" stroke="#ddd"/>')
        parts.append(f'<text x="{L-8}" y="{y+4:.1f}" text-anchor="end" font-size="11">{f*100:.0f}%</text>')
    for i, (lab, r, n) in enumerate(zip(list(rates.index), rates, ns)):
        x = L + pw * (i + 0.5) / len(rates)
        h = ph * r / ymax
        parts.append(f'<rect x="{x-bw/2:.1f}" y="{B-h:.1f}" width="{bw:.1f}" height="{h:.1f}" fill="#4878a8"/>')
        parts.append(f'<text x="{x:.1f}" y="{B-h-6:.1f}" text-anchor="middle" font-size="11" font-weight="bold">{r*100:.1f}%</text>')
        parts.append(f'<text x="{x:.1f}" y="{B+18:.1f}" text-anchor="middle" font-size="12">{lab}</text>')
        parts.append(f'<text x="{x:.1f}" y="{B+32:.1f}" text-anchor="middle" font-size="10" fill="#666">n={n}</text>')
    parts.append(f'<text x="18" y="{B-ph/2:.0f}" font-size="12" transform="rotate(-90 18 {B-ph/2:.0f})" text-anchor="middle">{ylabel}</text>')
    parts.append('</svg>')
    open(fname, 'w').write('\n'.join(parts))

bar_svg(g1['mean'] / 100, g1['count'].tolist(),
        'Share who took more out of savings than put in, by age (NLSY79, n=12,686)',
        'output/age_banded_withdrawal_rates.svg')
b2 = g2['mean'] / 100
bar_svg(b2, g2['count'].tolist(),
        'Withdrawal rate by 2-year age band (secondary descriptive)',
        'output/age_band_withdrawal_rates_2yr.svg')
print('\nSVG plots written: output/age_banded_withdrawal_rates.svg, output/age_band_withdrawal_rates_2yr.svg')
