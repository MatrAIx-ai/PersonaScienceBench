"""
NLSY79: Does increased time preference relate to higher BMI?
Time preference is NOT directly measured -> proxies:
  P1 (primary): 1989 savings behavior (1=put more in vs 2=took more out; 3/4 kept as separate cats)
  P2 (co-primary secondary): family net wealth trajectory 1985->1990 (grew vs declined)
Outcome: BMI. Units assumption: weights are pounds (median 140-165 lbs; metadata label 'kg'
would give implausible median BMI ~48). Height 1981 is FEET-INCHES coded (e.g., 507=5'07").
"""
import numpy as np, pandas as pd
import statsmodels.formula.api as smf

df = pd.read_csv('data/nls_raw.csv')
df.columns = [c.strip() for c in df.columns]
df = df.rename(columns={
  "Highest grade completed, 1979": 'edu79',
  "Highest grade completed by respondent's mother, 1979": 'medu79',
  "Highest grade completed by respondent's father, 1979": 'fedu79'})

K = dict(
  h81='Height of respondent, 1981', h85='Height of respondent, 1985',
  w81='Weight of respondent, 1981', w89='Weight of respondent, 1989', w92='Weight of respondent, 1992',
  nw85='Family net wealth, 1985', nw90='Family net wealth, 1990', nw96='Family net wealth, 1996 (key data point)',
  savcat='Was more money put into or taken out of R/spouse savings since last interview, 1989',
  put='Net amount respondent/spouse put into savings since last interview, 1989',
  out='Net amount respondent/spouse took out of savings since last interview, 1989',
  inc89='Total net family income, previous calendar year, 1989',
  inc85='Total net family income, previous calendar year, 1985',
  sex='Sex of respondent, 1979', race='Racial/ethnic cohort, 1979',
  age79='Age of respondent, 1979', age89='Age of respondent at interview date, 1989',
  asvar='ASVAB - Arithmetic Reasoning Z Score (rounded), 1981',
  asvwk='ASVAB - Word Knowledge Z Score (rounded), 1981',
  asvpc='ASVAB - Paragraph Comprehension Z Score (rounded), 1981',
  asvmk='ASVAB - Mathematics Knowledge Z Score (rounded), 1981')

# ---- height / weight / BMI ----
h = df[K['h81']]
h_in_81 = ((h // 100) * 12 + (h % 100)).where(h.between(400, 611))
h_in_85 = df[K['h85']].where(df[K['h85']].between(48, 84))
df['height_in'] = h_in_85.fillna(h_in_81)   # primary height for 1989 BMI: 1985 (closest), fallback 1981

def lbs_to_bmi(w_series, h_in):
    kg = w_series.where(w_series <= 400) * 0.453592   # exclude >400 lbs outliers
    return (kg / (h_in * 0.0254) ** 2).where(lambda x: x.between(12, 70))

df['bmi89'] = lbs_to_bmi(df[K['w89']], df['height_in'])
df['bmi81'] = lbs_to_bmi(df[K['w81']], h_in_81)
df['bmi92'] = lbs_to_bmi(df[K['w92']], df['height_in'])
df['obese89'] = df['bmi89'].ge(30).astype(float).where(df['bmi89'].notna())

n_excl = int((df[K['w89']] > 400).sum() + (df[K['w92']] > 400).sum())
print(f'weight values >400 lbs excluded (1989+1992): {n_excl}')
print('BMI89: n=%d mean=%.2f sd=%.2f median=%.2f' % (
  df['bmi89'].notna().sum(), df['bmi89'].mean(), df['bmi89'].std(), df['bmi89'].median()))

# ---- proxies ----
df['sav_cat'] = df[K['savcat']].map({1:'put_in',2:'took_out',3:'no_change',4:'no_savings'})
for v in ['put','out']:
    df[v+'_log'] = np.log1p(df[K[v]].where(df[K[v]] < 99999))    # sentinel codes -> NaN
# net flow: put in (cat 1) recorded in 'put'; took out (cat 2) recorded in 'out' (never both)
put_v = df[K['put']].where(df[K['put']] < 99999)
out_v = df[K['out']].where(df[K['out']] < 99999)
df['put_net'] = np.where(df[K['savcat']] == 1, put_v, np.where(df[K['savcat']] == 2, -out_v, np.nan))
both = df[[K['nw85'],K['nw90']]].notna().all(axis=1)
df['wealth_grew'] = np.where(both, (df[K['nw90']] > df[K['nw85']]).astype(float), np.nan)
df['wealth_chg_log'] = np.where(both,
    np.log1p(df[K['nw90']].clip(lower=0)) - np.log1p(df[K['nw85']].clip(lower=0)), np.nan)

# ---- controls ----
df['female'] = (df[K['sex']] == 2).astype(int)
df['race_hisp'] = (df[K['race']] == 2).astype(int)
df['race_other'] = (df[K['race']] == 3).astype(int)
df['asvab_avg'] = df[[K['asvar'],K['asvwk'],K['asvpc'],K['asvmk']]].mean(axis=1)
df['log_inc89'] = np.log1p(df[K['inc89']].clip(lower=0))
df['age89'] = df[K['age89']].where(df[K['age89']].between(20, 60))
for v in ['edu79','medu79','fedu79']:
    df[v] = df[v].where(df[v].between(0, 20))
df['famsize'] = df['Family size, 1979'].where(df['Family size, 1979'].between(1, 20))

ctrl_full = ['female','race_hisp','race_other','age89','log_inc89','edu79','asvab_avg','medu79','fedu79','famsize']
ctrl = ['female','race_hisp','race_other','age89','log_inc89','edu79']

def show(k, m, d):
    print(f'\n### {k}   N={int(m.nobs)}')
    for t in m.params.index:
        if any(s in t for s in ('sav','wealth','put')):
            star = '***' if m.pvalues[t]<0.001 else '**' if m.pvalues[t]<0.01 else '*' if m.pvalues[t]<0.05 else ''
            ci = m.conf_int().loc[t]
            print(f'  {t:34s} b={m.params[t]:8.3f} se={m.bse[t]:.3f} p={m.pvalues[t]:.4g} '
                  f'CI[{ci[0]:.2f},{ci[1]:.2f}] {star}')
    if hasattr(m,'prsquared'): print(f'  pseudo-R2={m.prsquared:.4f}')
    else: print(f'  R2={m.rsquared:.4f}')

R = {}
d1 = df.dropna(subset=['bmi89','sav_cat']+ctrl_full).copy()
d1 = pd.get_dummies(d1, columns=['sav_cat'], drop_first=False).astype({c:float for c in d1.columns if c.startswith('sav_cat_')})
R['M1_savcat4_bmi89'] = smf.ols('bmi89 ~ sav_cat_put_in + sav_cat_no_change + sav_cat_no_savings + ' + ' + '.join(ctrl_full), data=d1).fit(cov_type='HC1')

d2 = df[(df['sav_cat'].isin(['put_in','took_out']))].dropna(subset=['bmi89']+ctrl_full).copy()
d2['saved'] = (d2['sav_cat']=='put_in').astype(float)
R['M2_sav12_bmi89'] = smf.ols('bmi89 ~ saved + ' + ' + '.join(ctrl_full), data=d2).fit(cov_type='HC1')

d3 = df.dropna(subset=['bmi89','wealth_grew']+ctrl_full).copy()
R['M3_wealthgrew_bmi89'] = smf.ols('bmi89 ~ wealth_grew + ' + ' + '.join(ctrl_full), data=d3).fit(cov_type='HC1')
R['M10_wealthchg_bmi89'] = smf.ols('bmi89 ~ wealth_chg_log + ' + ' + '.join(ctrl_full), data=d3.dropna(subset=['wealth_chg_log'])).fit(cov_type='HC1')

d2s = d2.dropna(subset=['obese89'])
R['M4_sav12_obese_logit'] = smf.logit('obese89 ~ saved + ' + ' + '.join(ctrl), data=d2s).fit(disp=0)
d3s = d3.dropna(subset=['obese89'])
R['M5_wealthgrew_obese_logit'] = smf.logit('obese89 ~ wealth_grew + ' + ' + '.join(ctrl), data=d3s).fit(disp=0)

d6 = df.dropna(subset=['bmi89','put_net']+ctrl).copy()
R['M6_putnet_bmi89'] = smf.ols('bmi89 ~ I(put_net/1000) + ' + ' + '.join(ctrl), data=d6).fit(cov_type='HC1')

db = df[df['sav_cat'].isin(['put_in','took_out'])].dropna(subset=ctrl).copy()
db['saved'] = (db['sav_cat']=='put_in').astype(float)
R['M7_sav12_bmi81'] = smf.ols('bmi81 ~ saved + ' + ' + '.join(ctrl), data=db.dropna(subset=['bmi81'])).fit(cov_type='HC1')
R['M8_sav12_bmi92'] = smf.ols('bmi92 ~ saved + ' + ' + '.join(ctrl), data=db.dropna(subset=['bmi92'])).fit(cov_type='HC1')

for k, m in R.items():
    show(k, m, None)

print('\nRaw BMI89 means by savings category:')
print(df.groupby('sav_cat')['bmi89'].agg(['count','mean','std']).round(2).to_string())
print('\nRaw BMI89 means by wealth grew 1985->1990:')
print(df.groupby('wealth_grew')['bmi89'].agg(['count','mean','std']).round(2).to_string())
print('\nObesity rate by savings cat (among valid BMI):')
print(df.groupby('sav_cat')['obese89'].agg(['count','mean']).round(3).to_string())
print('\nAnalysis frames: bmi89 valid=%d | +sav_cat=%d | +wealth_grew=%d | sav 1v2=%d' % (
  df['bmi89'].notna().sum(), df[['bmi89','sav_cat']].notna().all(axis=1).sum(),
  df[['bmi89','wealth_grew']].notna().all(axis=1).sum(),
  (df[['bmi89','sav_cat']].notna().all(axis=1) & df['sav_cat'].isin(['put_in','took_out'])).sum()))
