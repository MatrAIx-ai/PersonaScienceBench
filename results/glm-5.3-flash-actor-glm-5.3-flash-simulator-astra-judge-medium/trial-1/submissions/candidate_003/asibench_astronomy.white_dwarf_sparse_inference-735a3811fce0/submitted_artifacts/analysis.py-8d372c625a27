#!/usr/bin/env python3
"""
Sparse/Noisy Compact-Star Sequence Reconstruction
=================================================
Reconstructs a physically self-consistent cold, non-rotating compact-star
(white-dwarf-like) sequence from sparse noisy M-R observations and partial
internal profile fragments, then predicts the holdout quantities.

Physical model: Chandrasekhar model -- zero-temperature fully degenerate
electron gas (special-relativistic EoS) in Newtonian hydrostatic equilibrium.

    P(x) = Kp * f(x),  f(x) = x(2x^2-3)*sqrt(1+x^2)+3*asinh(x),  f'(x) = 8x^4/sqrt(1+x^2)
    rho(x) = mue * m_u * (8*pi/3) * (x*m_e*c/h)^3
    dP/dr = -G m rho / r^2,   dm/dr = 4*pi*r^2*rho
    surface: rho/rho_c = surface_threshold (=1e-4, from physics_manifest.json)

Dimensionless form (structure independent of the EoS scales):
    rho_bar = (x/x_c)^3, P_bar = f(x)/f(x_c)
    dphi/dxi = xi^2*rho_bar, dP_bar/dxi = -phi*rho_bar/xi^2
    M = 4*pi*(Kp*f_c/(4*pi*G))^(3/2) * rho_c^-2 * phi_s
    R = sqrt(Kp*f_c/(4*pi*G)) / rho_c * xi_s

Two-parameter family fitted jointly to M-R data and profile fragments:
    kappa : overall degeneracy-pressure scale (P -> kappa*P)
    mue   : electron molecular weight (sets NR->relativistic transition density)
M = C0*kappa^(3/2)*mue^-2*F(x_c), R = CR0*kappa^(1/2)*mue^-1*G(x_c).
kappa=1, mue=2 recovers the standard carbon/oxygen white-dwarf model.

Fitting: joint weighted least squares with the reported per-point sigmas.
Stage A: 1-parameter (mue, kappa=1). Stage B: 2-parameter (kappa, mue).
Model selection by total chi2 and per-fragment residual structure.

Note: matplotlib is unavailable in this runtime, so the required PNG is
rendered by a self-contained PIL rasterizer written out and executed with
the system python3 (which provides Pillow).
"""
import json
import os
import subprocess
import numpy as np
import pandas as pd
from scipy.integrate import solve_ivp
from scipy.optimize import brentq, least_squares
from scipy.interpolate import interp1d

G     = 6.67430e-11
C_LIGHT = 2.99792458e8
H_PLANCK = 6.62607015e-34
M_ELECTRON = 9.1093837015e-31
M_AMU = 1.66053906660e-27
M_SUN = 1.98892e30
KP = np.pi * M_ELECTRON**4 * C_LIGHT**5 / (3.0 * H_PLANCK**3)
N0 = 8.0 * np.pi / 3.0 * (M_ELECTRON * C_LIGHT / H_PLANCK)**3

DATA = "data"
mr = pd.read_csv(os.path.join(DATA, "mr_observations.csv"))
pf = pd.read_csv(os.path.join(DATA, "profile_fragments.csv"))
with open(os.path.join(DATA, "query_targets.json")) as fh:
    targets = json.load(fh)
with open(os.path.join(DATA, "physics_manifest.json")) as fh:
    manifest = json.load(fh)

THR = float(manifest["surface_threshold"])
assert manifest["mass_unit"] == "solar_mass" and manifest["radius_unit"] == "km"

EVAL_MASSES = np.array(targets["mr_eval_masses_solar"])
PROFILE_MASSES = np.array(targets["profile_target_masses_solar"])
U_GRID = np.array(targets["radius_fraction_grid"])

def f_x(x):
    return x * (2.0 * x**2 - 3.0) * np.sqrt(1.0 + x * x) + 3.0 * np.arcsinh(x)

def fp_x(x):
    return 8.0 * x**4 / np.sqrt(1.0 + x * x)

def integrate_xc(xc, n_u=2001, rtol=1e-9):
    """Dimensionless Chandrasekhar integration, center -> rho_bar = THR.
    Returns (xi_s, phi_s, u_grid, rho_bar(u), m/m_total(u))."""
    fc = f_x(xc)

    def rhs(xi, y):
        phi, x = y
        x = max(x, 1e-300)
        rbar = (x / xc) ** 3
        return [xi * xi * rbar,
                -phi * rbar / (xi * xi) * fc / fp_x(x)]

    def event(xi, y):
        return (y[1] / xc) ** 3 - THR
    event.terminal = True
    event.direction = -1

    sol = solve_ivp(rhs, [1e-5, 80.0], [1e-5**3 / 3.0, xc * (1.0 - 1e-9)],
                    events=event, rtol=rtol, atol=[1e-14, 1e-14],
                    dense_output=True, max_step=0.05)
    if sol.status != 1:
        raise RuntimeError(f"integration failed for xc={xc}: {sol.message}")
    xi_s = float(sol.t_events[0][0])
    phi_s = float(sol.y_events[0][0][0])
    u = np.linspace(0.0, 1.0, n_u)
    xi = u * xi_s
    x = np.clip(sol.sol(xi)[1], 1e-300, None)
    rbar = (x / xc) ** 3
    mfrac = sol.sol(xi)[0] / phi_s
    rbar[0], mfrac[0] = 1.0, 0.0          # exact center values
    rbar[-1], mfrac[-1] = THR, 1.0        # exact surface values (threshold)
    return xi_s, phi_s, u, rbar, mfrac

XC_GRID = np.geomspace(0.002, 1e5, 400)
_rows = [integrate_xc(xc) for xc in XC_GRID]
F_TAB = np.array([f_x(x0)**1.5 * x0**-6.0 * r[1] for x0, r in zip(XC_GRID, _rows)])
G_TAB = np.array([np.sqrt(f_x(x0)) * x0**-3.0 * r[0] for x0, r in zip(XC_GRID, _rows)])
U_TAB = np.array([r[2] for r in _rows])
RB_TAB = np.array([r[3] for r in _rows])
MF_TAB = np.array([r[4] for r in _rows])
LNXC = np.log(XC_GRID)
F_I = interp1d(LNXC, np.log(F_TAB), kind='cubic')
G_I = interp1d(LNXC, np.log(G_TAB), kind='cubic')

C0  = 4.0 * np.pi * (KP / (4.0 * np.pi * G))**1.5 / (M_AMU * N0)**2 / M_SUN
CR0 = np.sqrt(KP / (4.0 * np.pi * G)) / (M_AMU * N0) / 1e3

class ChandrasekharModel:
    def __init__(self, mue, kappa=1.0):
        self.mue = float(mue)
        self.kappa = float(kappa)
        self.Mscale = C0 * kappa**1.5 / mue**2
        self.Rscale = CR0 * np.sqrt(kappa) / mue

    def xc_for_M(self, M):
        t = np.log(M / self.Mscale)                    # t = ln F(x_c) target
        lnF_lo, lnF_hi = np.log(F_TAB[0]), np.log(F_TAB[-1])
        if t <= lnF_lo:
            return float(XC_GRID[0])
        if t >= lnF_hi:
            return float(XC_GRID[-1])
        lo, hi = float(LNXC[0]), float(LNXC[-1])       # brentq searches in ln x_c
        return float(np.exp(brentq(lambda l: float(F_I(l)) - t, lo, hi, xtol=1e-12)))

    def radius_of_mass(self, M):
        xc = self.xc_for_M(M)
        return float(self.Rscale * np.exp(float(G_I(np.log(xc)))))

    def mass_limit(self):
        return self.Mscale * float(F_TAB[-1])

    def profile(self, M, u_query):
        xc = self.xc_for_M(M)
        j = min(max(np.searchsorted(XC_GRID, xc), 1), len(XC_GRID) - 1)
        w = (np.log(xc) - LNXC[j - 1]) / (LNXC[j] - LNXC[j - 1])
        r1 = np.interp(u_query, U_TAB[j - 1], RB_TAB[j - 1]); m1 = np.interp(u_query, U_TAB[j - 1], MF_TAB[j - 1])
        r2 = np.interp(u_query, U_TAB[j],     RB_TAB[j]);     m2 = np.interp(u_query, U_TAB[j],     MF_TAB[j])
        return (1.0 - w) * r1 + w * r2, (1.0 - w) * m1 + w * m2

def residuals(params, two_param, mr, pf):
    if two_param:
        model = ChandrasekharModel(np.exp(params[1]), np.exp(params[0]))
    else:
        model = ChandrasekharModel(np.exp(params[0]), kappa=1.0)
    res = [(model.radius_of_mass(M) - R) / sR
           for M, R, sR in zip(mr.mass_solar_obs, mr.radius_km_obs, mr.sigma_radius_km)]
    for _, g in pf.groupby("fragment_id"):
        Mt = float(g.target_mass_solar.iloc[0])
        uq = g.radius_fraction.values
        rm, mm = model.profile(Mt, uq)
        d, sd = g.density_fraction_obs.values, g.sigma_density_fraction.values
        e, se = g.enclosed_mass_fraction_obs.values, g.sigma_enclosed_mass_fraction.values
        for i in range(len(g)):
            if not np.isnan(d[i]):
                res.append((rm[i] - d[i]) / sd[i])
            if not np.isnan(e[i]):
                res.append((mm[i] - e[i]) / se[i])
    return np.array(res)

def per_group_chi2(res, mr, pf):
    n_mr = len(mr)
    out = {"mr": float(np.sum(res[:n_mr] ** 2))}
    off = n_mr
    frs = {}
    for fid, g in pf.groupby("fragment_id"):
        n = len(g)
        seg = res[off:off + n]; off += n
        frs[int(fid)] = {"chi2": float(np.sum(seg ** 2)), "n": n,
                         "mean": float(np.mean(seg)), "mass": float(g.target_mass_solar.iloc[0])}
    out["fragments"] = frs
    return out

print("=" * 70)
print("Stage A: 1-parameter Chandrasekhar family (kappa = 1)")
fitsA = [least_squares(residuals, [s], args=(False, mr, pf), bounds=([0.3], [3.0]))
         for s in (np.log(1.8), np.log(2.0), np.log(2.3))]
resA = min(fitsA, key=lambda f: float(np.sum(f.fun ** 2)))
mueA = float(np.exp(resA.x[0])); chi2A = float(np.sum(resA.fun ** 2))
diagA = per_group_chi2(resA.fun, mr, pf)
print(f"  mue = {mueA:.5f}   total chi2 = {chi2A:.2f} / {resA.fun.size} pts")
print("  MR chi2 = %.2f/14 ; fragments: " % diagA["mr"] +
      ", ".join(f"M={v['mass']}: {v['chi2']:.2f}/{v['n']} (mean {v['mean']:+.2f})"
                for v in diagA["fragments"].values()))

print("Stage B: 2-parameter family (kappa, mue) -- joint M-R + profiles")
starts = [[0.0, np.log(2.0)], [np.log(0.7), np.log(2.3)], [np.log(1.4), np.log(1.8)]]
fitsB = [least_squares(residuals, s, args=(True, mr, pf), bounds=([-4, 0.3], [4, 3.5])) for s in starts]
resB = min(fitsB, key=lambda f: float(np.sum(f.fun ** 2)))
kappaB, mueB = float(np.exp(resB.x[0])), float(np.exp(resB.x[1]))
chi2B = float(np.sum(resB.fun ** 2))
diagB = per_group_chi2(resB.fun, mr, pf)
print(f"  kappa = {kappaB:.5f}, mue = {mueB:.5f}   total chi2 = {chi2B:.2f} / {resB.fun.size} pts")
print("  MR chi2 = %.2f/14 ; fragments: " % diagB["mr"] +
      ", ".join(f"M={v['mass']}: {v['chi2']:.2f}/{v['n']} (mean {v['mean']:+.2f})"
                for v in diagB["fragments"].values()))
delta = chi2A - chi2B
adopt_B = delta > 25.0
print(f"  Delta chi2 (A->B) = {delta:.1f} for 1 extra parameter -> "
      f"{'ADOPT Stage B' if adopt_B else 'keep Stage A'}")

if adopt_B:
    model = ChandrasekharModel(mueB, kappaB)
    fit = resB; pnames = ["log_kappa", "log_mue"]; diag = diagB
else:
    model = ChandrasekharModel(mueA, 1.0)
    fit = resA; pnames = ["log_mue"]; diag = diagA

J = np.asarray(fit.jac, dtype=float)
n_dof = fit.fun.size - len(fit.x)
chi2red = float(np.sum(fit.fun ** 2)) / n_dof
cov = np.linalg.inv(J.T @ J) * max(chi2red, 1.0)
perr = np.sqrt(np.diag(cov))
print("  fitted parameters: " +
      ", ".join(f"{n}={v:.5f}+-{e:.5f}" for n, v, e in zip(pnames, fit.x, perr)))

def _model_at(p):
    if len(p) == 2:
        return ChandrasekharModel(np.exp(p[1]), np.exp(p[0]))
    return ChandrasekharModel(np.exp(p[0]), 1.0)

def prop_sigma_R(M):
    """1-sigma radius uncertainty from the parameter covariance (finite diff)."""
    p0 = fit.x.copy()
    g = np.zeros(len(p0))
    for i in range(len(p0)):
        h = max(1e-5, abs(p0[i]) * 1e-4)
        pp = p0.copy(); pp[i] += h
        pm = p0.copy(); pm[i] -= h
        g[i] = (_model_at(pp).radius_of_mass(M) - _model_at(pm).radius_of_mass(M)) / (2 * h)
    return float(np.sqrt(g @ cov @ g))

mass_limit = model.mass_limit()
print(f"  model maximum stable mass (turn-off): {mass_limit:.4f} Msun")
if mass_limit < EVAL_MASSES.max():
    print("  *** CONSISTENCY WARNING: fitted turn-off mass below eval-grid endpoint ***")
else:
    print(f"  turn-off mass is {mass_limit - EVAL_MASSES.max():.3f} Msun above the "
          f"eval-grid endpoint ({EVAL_MASSES.max():.2f}); no consistency warning.")

# sigma_M consistency: radius shift from the mass uncertainty vs sigma_R
from numpy import interp as _ip
dRdM = np.array([(model.radius_of_mass(M + 0.005) - model.radius_of_mass(max(M - 0.005, 0.01))) / 0.010
                 for M in mr.mass_solar_obs])
sigM_effect = np.abs(dRdM) * mr.sigma_mass_solar.values
ratio = np.max(sigM_effect / mr.sigma_radius_km.values)
print(f"  sigma_M consistency: |dR/dM|*sigma_M = {sigM_effect.min():.1f}..{sigM_effect.max():.1f} km"
      f" vs sigma_R = {mr.sigma_radius_km.min():.1f}..{mr.sigma_radius_km.max():.1f} km"
      f" (max ratio {ratio:.2f} at the steepest end of the curve);"
      f" -> {"no bias; extra scatter only" if ratio < 1 else "comparable to sigma_R at the high-mass end; no bias, treated as extra scatter (no 2-D chi2, per plan)"}")
eval_R = np.array([model.radius_of_mass(M) for M in EVAL_MASSES])
eval_sig = np.array([prop_sigma_R(M) for M in EVAL_MASSES])
mono_ok = bool(np.all(np.diff(eval_R) < 0))
print(f"  R(M) strictly decreasing over the 24 holdout masses: {mono_ok}")

summary_radii = {}
for key, M in [("radius_at_0p6Msun_km", 0.6), ("radius_at_1p0Msun_km", 1.0),
               ("radius_at_1p2Msun_km", 1.2), ("radius_at_1p3Msun_km", 1.3)]:
    summary_radii[key] = model.radius_of_mass(M)
    print(f"  {key} = {summary_radii[key]:.2f} +- {prop_sigma_R(M):.2f} km")
if len(cov) == 2:
    grad_lim = np.array([1.5, -2.0])
    sig_lim = mass_limit * float(np.sqrt(grad_lim @ cov @ grad_lim))
else:
    sig_lim = mass_limit * 2.0 * float(perr[0])
print(f"  mass_limit_solar = {mass_limit:.4f} +- {sig_lim:.4f} Msun")

profiles = {}
for M in PROFILE_MASSES:
    r_prof, m_prof = model.profile(M, U_GRID)
    r_prof[0], r_prof[-1] = 1.0, THR
    m_prof[0], m_prof[-1] = 0.0, 1.0
    profiles[M] = (r_prof, m_prof)
    ok_mono = bool(np.all(np.diff(r_prof) <= 1e-12) and np.all(np.diff(m_prof) >= -1e-12))
    print(f"  profile M={M}: monotone rho/m = {ok_mono}; center=({r_prof[0]:.4f},{m_prof[0]:.4f}); "
          f"surface=({r_prof[-1]:.2e},{m_prof[-1]:.4f})")

os.makedirs("results", exist_ok=True)
pd.DataFrame({"mass_solar": EVAL_MASSES, "radius_km": eval_R}).to_csv(
    "results/mr_reconstruction.csv", index=False)
np.savez("results/profiles_reconstruction.npz",
         density_fraction=np.vstack([profiles[M][0] for M in PROFILE_MASSES]),
         enclosed_mass_fraction=np.vstack([profiles[M][1] for M in PROFILE_MASSES]))
summary = {"mass_limit_solar": mass_limit,
           "radius_at_0p6Msun_km": summary_radii["radius_at_0p6Msun_km"],
           "radius_at_1p0Msun_km": summary_radii["radius_at_1p0Msun_km"],
           "radius_at_1p2Msun_km": summary_radii["radius_at_1p2Msun_km"],
           "radius_at_1p3Msun_km": summary_radii["radius_at_1p3Msun_km"]}
with open("results/summary.json", "w") as fh:
    json.dump(summary, fh, indent=2)

# ------------------------------------------------------------------ plot
# matplotlib is unavailable in this runtime; the required PNG is rendered
# by this self-contained PIL rasterizer executed with the system python3.
RENDERER = r'''
import json, math, sys
from PIL import Image, ImageDraw, ImageFont
spec = json.load(open(sys.argv[1]))
W, H = spec["width"], spec["height"]
img = Image.new("RGB", (W, H), (255, 255, 255))
d = ImageDraw.Draw(img)
FONT = ImageFont.load_default()

def blend(c, alpha=0.15, base=(255, 255, 255)):
    return tuple(int(alpha * c[i] + (1 - alpha) * base[i]) for i in range(3))

def nice_ticks(lo, hi, n=5):
    span = hi - lo
    raw = span / max(n - 1, 1)
    mag = 10 ** int(math.floor(math.log10(raw)))
    step = mag
    for mult in (1, 2, 2.5, 5, 10):
        if raw <= mult * mag:
            step = mult * mag
            break
    t0 = math.ceil(lo / step) * step
    ticks = []; t = t0
    while t <= hi + 1e-9 * span:
        ticks.append(t); t += step
    return ticks, step

def fmt(v, step):
    if step >= 1:
        return f"{v:.0f}"
    dec = max(0, -int(math.floor(math.log10(step))) + 1)
    return f"{v:.{dec}f}"

def liang_barsky(x0, y0, x1, y1, L, T, R, B):
    dx, dy = x1 - x0, y1 - y0
    p = [-dx, dx, -dy, dy]
    q = [x0 - L, R - x0, y0 - T, B - y0]
    u0, u1 = 0.0, 1.0
    for pi, qi in zip(p, q):
        if pi == 0:
            if qi < 0: return None
        else:
            t = qi / pi
            if pi < 0: u0 = max(u0, t)
            else: u1 = min(u1, t)
            if u0 > u1: return None
    return (x0 + u0 * dx, y0 + u0 * dy, x0 + u1 * dx, y0 + u1 * dy)

for P in spec["panels"]:
    L, T, R, B = P["rect"]
    xr, yr = P["xrange"], P["yrange"]
    def TX(x): return L + (x - xr[0]) / (xr[1] - xr[0]) * (R - L)
    def TY(y): return B - (y - yr[0]) / (yr[1] - yr[0]) * (B - T)
    d.rectangle([L, T, R, B], outline=(80, 80, 80), width=1)
    xt, xs = nice_ticks(xr[0], xr[1]); yt, ys = nice_ticks(yr[0], yr[1])
    for tv in xt:
        px = TX(tv)
        d.line([(px, T), (px, B)], fill=(225, 225, 225), width=1)
        d.line([(px, B), (px, B + 5)], fill=(80, 80, 80), width=1)
        lbl = fmt(tv, xs)
        d.text((px - d.textlength(lbl, font=FONT) / 2, B + 7), lbl, fill=(0, 0, 0), font=FONT)
    for tv in yt:
        py = TY(tv)
        d.line([(L, py), (R, py)], fill=(225, 225, 225), width=1)
        d.line([(L - 5, py), (L, py)], fill=(80, 80, 80), width=1)
        lbl = fmt(tv, ys)
        d.text((L - 7 - d.textlength(lbl, font=FONT), py - 6), lbl, fill=(0, 0, 0), font=FONT)
    for it in P["items"]:
        typ = it["type"]; col = tuple(it["color"])
        if typ == "fill":
            poly = [(TX(x), TY(y)) for x, y in zip(it["x"], it["y"])]
            poly += [(TX(x), TY(y)) for x, y in zip(reversed(it["x2"]), reversed(it["y2"]))]
            d.polygon(poly, fill=blend(col, it.get("alpha", 0.15)))
        elif typ == "line":
            pts = list(zip(it["x"], it["y"]))
            dash = it.get("dash", 0)
            for k in range(len(pts) - 1):
                seg = liang_barsky(TX(pts[k][0]), TY(pts[k][1]),
                                   TX(pts[k + 1][0]), TY(pts[k + 1][1]), L, T, R, B)
                if seg is None: continue
                if dash and k % 2 == 1: continue
                d.line([seg[:2], seg[2:]], fill=col, width=it.get("lw", 2))
        elif typ == "errorbar":
            for x, y, ex, ey in zip(it["x"], it["y"],
                                    it.get("ex", [None] * len(it["x"])),
                                    it.get("ey", [None] * len(it["x"]))):
                px, py = TX(x), TY(y)
                if not (L - 20 <= px <= R + 20 and T - 20 <= py <= B + 20): continue
                if ey:
                    d.line([(px, TY(y - ey)), (px, TY(y + ey))], fill=col, width=1)
                    d.line([(px - 3, TY(y - ey)), (px + 3, TY(y - ey))], fill=col, width=1)
                    d.line([(px - 3, TY(y + ey)), (px + 3, TY(y + ey))], fill=col, width=1)
                if ex:
                    d.line([(TX(x - ex), py), (TX(x + ex), py)], fill=col, width=1)
                    d.line([(TX(x - ex), py - 3), (TX(x - ex), py + 3)], fill=col, width=1)
                    d.line([(TX(x + ex), py - 3), (TX(x + ex), py + 3)], fill=col, width=1)
        elif typ == "points":
            for x, y in zip(it["x"], it["y"]):
                px, py = TX(x), TY(y)
                if L <= px <= R and T <= py <= B:
                    r = it.get("ms", 3)
                    if it.get("marker") == "v":
                        d.polygon([(px, py + r), (px - r, py - r), (px + r, py - r)], fill=col)
                    else:
                        d.ellipse([px - r, py - r, px + r, py + r], fill=col)
        elif typ == "vline":
            seg = liang_barsky(TX(it["x"]), T, TX(it["x"]), B, L, T, R, B)
            if seg: d.line([seg[:2], seg[2:]], fill=col, width=it.get("lw", 1))
        elif typ == "hline":
            seg = liang_barsky(L, TY(it["y"]), R, TY(it["y"]), L, T, R, B)
            if seg: d.line([seg[:2], seg[2:]], fill=col, width=1)
    d.text(((L + R) / 2 - d.textlength(P["title"], font=FONT) / 2, T - 16),
           P["title"], fill=(0, 0, 0), font=FONT)
    xl = P["xlabel"]
    d.text(((L + R) / 2 - d.textlength(xl, font=FONT) / 2, B + 22), xl, fill=(0, 0, 0), font=FONT)
    yl = P["ylabel"]
    ti = Image.new("RGB", (int(d.textlength(yl, font=FONT)) + 4, 12), (255, 255, 255))
    ImageDraw.Draw(ti).text((2, 0), yl, fill=(0, 0, 0), font=FONT)
    ti = ti.rotate(90, expand=True)
    img.paste(ti, (L - 40, int((T + B) / 2 - ti.size[1] / 2)))
    leg = P.get("legend") or []
    if leg:
        lh = 13
        wmax = max(d.textlength(t, font=FONT) for _, _, t in leg) + 26
        loc = P.get("legend_loc", "upper right")
        if loc == "upper right": bx, by = R - wmax - 6, T + 6
        elif loc == "lower left": bx, by = L + 6, B - 6 - lh * len(leg)
        else: bx, by = L + 6, T + 6
        d.rectangle([bx, by, bx + wmax, by + lh * len(leg) + 4],
                    fill=(255, 255, 255), outline=(180, 180, 180))
        for i, (col, style, t) in enumerate(leg):
            cy = by + lh * i + lh / 2 + 2
            if style == "line":
                d.line([(bx + 4, cy), (bx + 20, cy)], fill=tuple(col), width=2)
            elif style == "dash":
                d.line([(bx + 4, cy), (bx + 20, cy)], fill=tuple(col), width=2)
                d.line([(bx + 8, cy), (bx + 11, cy)], fill=(255, 255, 255), width=2)
                d.line([(bx + 14, cy), (bx + 17, cy)], fill=(255, 255, 255), width=2)
            elif style == "point":
                d.ellipse([bx + 10, cy - 3, bx + 16, cy + 3], fill=tuple(col))
            d.text((bx + 24, cy - 6), t, fill=(0, 0, 0), font=FONT)

d.text((int(W / 2 - d.textlength(spec["suptitle"], font=FONT) / 2), 8),
       spec["suptitle"], fill=(0, 0, 0), font=FONT)
img.save(spec["out"])
