'''

def _line(x, y, color, lw=2, dash=False):
    return {"type": "line", "x": [float(v) for v in x], "y": [float(v) for v in y],
            "color": color, "lw": lw, "dash": 1 if dash else 0}

def _pts(x, y, color, ms=3, marker="o"):
    return {"type": "points", "x": [float(v) for v in x], "y": [float(v) for v in y],
            "color": color, "ms": ms, "marker": marker}

BLUE = (31, 119, 180); RED = (214, 39, 40); BLACK = (20, 20, 20)
FRAGC = [(44, 160, 44), (255, 127, 14), (148, 103, 189)]
HOLDC = [(178, 34, 34), (230, 145, 56), (139, 69, 19)]
panels = []

# --- panel 1: M-R reconstruction
Mdense = np.geomspace(0.05, min(mass_limit * 0.9995, EVAL_MASSES.max()), 250)
Rdense = [model.radius_of_mass(M) for M in Mdense]
yl_all = list(mr.radius_km_obs) + Rdense + list(eval_R)
skeys = ["radius_at_0p6Msun_km", "radius_at_1p0Msun_km", "radius_at_1p2Msun_km", "radius_at_1p3Msun_km"]
items = [
    {"type": "fill", "x": list(EVAL_MASSES), "x2": list(EVAL_MASSES),
     "y": list(eval_R - eval_sig), "y2": list(eval_R + eval_sig), "color": BLUE, "alpha": 0.18},
    _line(Mdense, Rdense, BLUE, 2),
    {"type": "errorbar", "x": list(mr.mass_solar_obs), "y": list(mr.radius_km_obs),
     "ex": list(mr.sigma_mass_solar), "ey": list(mr.sigma_radius_km), "color": BLACK},
    _pts(mr.mass_solar_obs, mr.radius_km_obs, BLACK, 3),
    _pts(EVAL_MASSES, eval_R, BLUE, 2),
    _pts([0.6, 1.0, 1.2, 1.3], [summary_radii[k] for k in skeys], RED, 5, "v"),
    {"type": "vline", "x": float(mass_limit), "color": RED, "lw": 1},
]
leg = [(BLACK, "point", "M-R observations"), (BLUE, "line", "reconstructed sequence"),
       (BLUE, "point", "holdout predictions"),
       (blend := tuple(int(0.18 * c + 0.82 * w) for c, w in zip(BLUE, (255, 255, 255))),
        "point", "holdout +/-1 sigma (param. unc.)"),
       (RED, "point", "summary radii 0.6/1.0/1.2/1.3"),
       (RED, "line", f"mass limit {mass_limit:.3f} Msun")]
panels.append({"rect": [70, 40, 760, 520], "xrange": [0.18, 1.43],
               "yrange": [min(yl_all) * 0.9, max(yl_all) * 1.05],
               "title": "Mass-radius reconstruction", "xlabel": "M [Msun]", "ylabel": "R [km]",
               "items": items, "legend": leg, "legend_loc": "upper right"})

# --- panels 2 and 3: normalized profiles
uu = list(np.linspace(0, 1, 400))
frag_masses = sorted(pf.target_mass_solar.unique())
for col, (title, ylab, obs, sig) in enumerate([
        ("Normalized density profiles", "rho/rho_c", "density_fraction_obs", "sigma_density_fraction"),
        ("Enclosed-mass profiles", "m/M", "enclosed_mass_fraction_obs", "sigma_enclosed_mass_fraction")]):
    x0 = 880 if col == 0 else 70
    y0 = 40 if col == 0 else 590
    items = []
    for (fid, g), c in zip(pf.groupby("fragment_id"), FRAGC):
        Mt = float(g.target_mass_solar.iloc[0])
        dv = g[obs].values; sv = g[sig].values; uqv = list(g.radius_fraction.values)
        msk = [not np.isnan(v) for v in dv]
        rm, mm = model.profile(Mt, np.array(uu))
        items.append(_line(uu, rm if col == 0 else mm, c, 2))
        items.append({"type": "errorbar", "x": [u for u, m_ in zip(uqv, msk) if m_],
                      "y": [float(v) for v, m_ in zip(dv, msk) if m_],
                      "ey": [float(v) for v, m_ in zip(sv, msk) if m_], "ex": [], "color": BLACK})
        items.append(_pts([u for u, m_ in zip(uqv, msk) if m_],
                          [float(v) for v, m_ in zip(dv, msk) if m_], c, 3))
    for M, c in zip(PROFILE_MASSES, HOLDC):
        rm, mm = model.profile(M, np.array(uu))
        items.append(_line(uu, rm if col == 0 else mm, c, 2, dash=True))
    leg = [(BLACK, "point", "fragment observations")]
    leg += [(c, "line", f"model M={M}") for c, M in zip(FRAGC, frag_masses)]
    leg += [(c, "dash", f"holdout M={M}") for c, M in zip(HOLDC, PROFILE_MASSES)]
    panels.append({"rect": [x0, y0, x0 + 660, y0 + 460 if col == 0 else y0 + 440],
                   "xrange": [0.0, 1.0], "yrange": [-0.05, 1.08], "title": title,
                   "xlabel": "r/R", "ylabel": ylab, "items": items, "legend": leg,
                   "legend_loc": "lower left"})

# --- panel 4: weighted residuals
rr = [float(v) for v in fit.fun]
items = []
offs = [0, 14, 25, 36]
names = ["M-R residuals (sigma)", "fragment 0 (M=0.36)", "fragment 1 (M=0.84)", "fragment 2 (M=1.16)"]
cols4 = [BLUE, FRAGC[0], FRAGC[1], FRAGC[2]]
for i, v in enumerate(rr):
    j = 0
    while j + 1 < len(offs) and i >= offs[j + 1]: j += 1
    items.append({"type": "line", "x": [float(i - 0.35), float(i + 0.35)], "y": [0.0, v],
                  "color": cols4[j], "lw": 3, "dash": 0})
items.append({"type": "hline", "y": 0.0, "color": (0, 0, 0)})
items.append({"type": "hline", "y": 1.0, "color": (150, 150, 150)})
items.append({"type": "hline", "y": -1.0, "color": (150, 150, 150)})
leg = [(cols4[j], "line", names[j]) for j in range(4)]
panels.append({"rect": [880, 590, 1540, 1030], "xrange": [0, len(rr)], "yrange": [-3.5, 3.5],
               "title": f"Fit residuals (total chi2 = {float(np.sum(np.array(rr)**2)):.1f} / {len(rr)})",
               "xlabel": "observation index", "ylabel": "weighted residual (sigma)",
               "items": items, "legend": leg, "legend_loc": "lower left"})

spec = {"width": 1600, "height": 1080, "panels": panels,
        "suptitle": (f"Compact-star sequence reconstruction - Chandrasekhar degenerate family "
                     f"(kappa={model.kappa:.3f}, mu_e={model.mue:.3f})"),
        "out": "results/reconstruction_plot.png"}
with open("_plot_spec.json", "w") as fh:
    json.dump(spec, fh)
with open("_render_plot.py", "w") as fh:
    fh.write(RENDERER)
r = subprocess.run(["/usr/bin/python3", "_render_plot.py", "_plot_spec.json"],
                   capture_output=True, text=True)
print(r.stdout.strip()); print(r.stderr.strip())
if r.returncode != 0:
