def draw_text(img, x, y, text, color, scale=1):
    for k, ch in enumerate(text):
        g = FONT5x7.get(ch, FONT5x7[' ']).split()
        for r in range(7):
            for c in range(5):
                if g[r][c] == '1':
                    y0, x0 = y + r*scale, x + k*6*scale + c*scale
                    img[y0:y0+scale, x0:x0+scale] = color

def draw_line(img, x0, y0, x1, y1, color, thick=1):
    n = int(max(abs(x1-x0), abs(y1-y0))) + 1
    xs = np.round(np.linspace(x0, x1, n)).astype(int)
    ys = np.round(np.linspace(y0, y1, n)).astype(int)
    h, w = img.shape[:2]; t = thick // 2
    ok = (xs >= -t) & (xs < w+t) & (ys >= -t) & (ys < h+t)
    xs, ys = xs[ok], ys[ok]
    img[np.clip(ys,0,h-1), np.clip(xs,0,w-1)] = color

def draw_disc(img, xc, yc, r, color):
    h, w = img.shape[:2]
    for dy in range(-r, r+1):
        dx = int(np.sqrt(max(r*r - dy*dy, 0)))
        y = yc + dy
        if 0 <= y < h:
            img[y, max(xc-dx,0):min(xc+dx+1,w)] = color

def _panel(img, x0, y0, x1, y1, title):
    draw_line(img, x0, y0, x1, y0, (0,0,0)); draw_line(img, x0, y1, x1, y1, (0,0,0))
    draw_line(img, x0, y0, x0, y1, (0,0,0)); draw_line(img, x1, y0, x1, y1, (0,0,0))
    draw_text(img, x0+6, y0-16, title, (0,0,0), scale=1)

def _xticks(img, x0, x1, ytick, vmin, vmax, n=5, scale=1, fmt="{:.2f}"):
    for i in range(n):
        v = vmin + (vmax-vmin)*i/(n-1); xp = int(round(x0 + (x1-x0)*i/(n-1)))
        draw_line(img, xp, ytick, xp, ytick+4, (0,0,0))
        s = fmt.format(v)
        draw_text(img, xp - 3*len(s), ytick+7, s, (0,0,0), scale=scale)

def _yticks(img, y0, y1, xtick, vmin, vmax, n=4, scale=1, fmt="{:.1f}"):
    for i in range(n):
        v = vmin + (vmax - vmin) * i / (n - 1)
        yp = int(round(y1 - (y1 - y0) * i / (n - 1)))
        draw_line(img, xtick - 4, yp, xtick, yp, (0, 0, 0))
        t = fmt.format(v)
        draw_text(img, xtick - 8 - 6*len(t)*scale, yp - 3, t, (0, 0, 0), scale=scale)

