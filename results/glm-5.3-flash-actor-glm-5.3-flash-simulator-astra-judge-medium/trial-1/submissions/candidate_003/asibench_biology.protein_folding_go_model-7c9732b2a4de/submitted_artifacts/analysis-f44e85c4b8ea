"""
B3: Interacting-bead stochastic dynamics on a reference configuration.

Conventions (fixed per researcher-approved plan):
- Reduced units: k_B = m = 1, temperature in units of kBT.
- Backbone springs: E_bond = sum (k/2)(|r_i - r_{i+1}| - r0_i)^2, per-bond
  r0_i from the reference. SPRING CONSTANT k = 100 (chosen within the approved
  100-200 range, not tuned to outputs; stability: dt*sqrt(k) = 0.0052*10
  = 0.052 < 0.1).
- Native attractions (Go-like 10-12 wells) on the M reference contact pairs:
  E_att = eps*(5*(s/r)^12 - 6*(s/r)^10), s = native pair distance, eps = 1.
- Non-native repulsion: (sigma0/r)^12 on every pair with |i-j| >=
  min_seq_separation that is NOT native; sigma0 = mean bond length (~3.88).
- Q: hard-cutoff count, (# of the M reference pairs with distance <=
  contact_cutoff)/M in [0,1]; identical definition at all temperatures and for
  every downstream artifact.
- Integrator: BAOAB Langevin splitting, fixed seed, per-temperature streams.
- Burn-in (first 10% of steps) discarded for statistics ONLY; the trajectory
  artifact keeps all N_CKPT checkpoints.
- WHAM on dense (Q,E) samples (every step, post-burn-in) gives the fine-grid
  <Q>(T), fluctuation heat capacity C(T), and P(Q) at T*.
- Per-temperature observables come from the saved checkpoint series only.
"""
import json
import numpy as np
from scipy.ndimage import gaussian_filter1d

RNG_SEED = 0
EPS_NATIVE = 1.0
K_SPRING = 100.0
BURN_FRAC = 0.10
N_QBINS = 50
N_EBINS_WHAM = 200
N_FINE = 200
N_JOINT = 20
# Auxiliary temperatures (same force field, protocol, and Q definition). The
# midpoint condition <Q>(T*)=0.5 is NOT reached within the provided ladder
# (verified by equilibrated pilot runs), so two sub-ladder runs are added ONLY
# to the WHAM ensemble so that T* is obtained by interpolation, not
# extrapolation. All ladder-keyed artifacts use the 6 file temperatures only.
AUX_T = np.array([0.32, 0.42])

with open("data/parameters.json") as fh:
    P = json.load(fh)
N = int(P["n_beads"]); GAMMA = float(P["friction"]); DT = float(P["dt_reduced"])
TEMPS = np.asarray(P["temperature_list"], float)
NSTEPS = int(P["n_steps_per_T"]); CUTOFF = float(P["contact_cutoff"])
MINSEP = int(P["min_seq_separation"]); SAVE = int(P["save_interval"])
K = len(TEMPS); N_CKPT = NSTEPS // SAVE
T_ALL = np.concatenate([TEMPS, AUX_T]); K_ALL = len(T_ALL)

ref = np.load("data/target_coords.npy")
assert ref.shape == (N, 3)

D_ref = np.linalg.norm(ref[:, None, :] - ref[None, :, :], axis=-1)
native_pairs = [(i, j) for i in range(N) for j in range(i + 1, N)
                if j - i >= MINSEP and D_ref[i, j] <= CUTOFF]
M = len(native_pairs)
I_nat = np.array([p[0] for p in native_pairs])
J_nat = np.array([p[1] for p in native_pairs])
S_nat = D_ref[I_nat, J_nat]
native_set = set(native_pairs)
nn_pairs = [(i, j) for i in range(N) for j in range(i + 1, N)
            if j - i >= MINSEP and (i, j) not in native_set]
I_nn = np.array([p[0] for p in nn_pairs]); J_nn = np.array([p[1] for p in nn_pairs])
R0_BOND = np.linalg.norm(ref[1:] - ref[:-1], axis=1)
SIGMA0 = float(R0_BOND.mean())

def forces_and_energy(R):
    """R: (K, N, 3) -> (E (K,), F (K, N, 3), native pair distances (K, M))."""
    Kr = R.shape[0]
    E = np.zeros(Kr); F = np.zeros_like(R)
    dv = R[:, 1:, :] - R[:, :-1, :]
    dist = np.linalg.norm(dv, axis=-1)
    E += 0.5 * K_SPRING * ((dist - R0_BOND) ** 2).sum(axis=1)
    w = (K_SPRING * (dist - R0_BOND) / dist)[:, :, None] * dv
    F[:, :-1, :] += w; F[:, 1:, :] -= w
    dvn = R[:, I_nat, :] - R[:, J_nat, :]
    dn = np.linalg.norm(dvn, axis=-1)
    E += (EPS_NATIVE * (5.0 * (S_nat / dn) ** 12
                        - 6.0 * (S_nat / dn) ** 10)).sum(axis=1)
    fm = -60.0 * EPS_NATIVE * S_nat ** 10 / dn ** 11 * (1.0 - (S_nat / dn) ** 2)
    Fn = fm[:, :, None] * (dvn / dn[:, :, None])
    np.add.at(F, (slice(None), I_nat), Fn)
    np.add.at(F, (slice(None), J_nat), -Fn)
    dvr = R[:, I_nn, :] - R[:, J_nn, :]
    dr = np.linalg.norm(dvr, axis=-1)
    E += ((SIGMA0 / dr) ** 12).sum(axis=1)
    fr = 12.0 * SIGMA0 ** 12 / dr ** 13
    Fr = fr[:, :, None] * (dvr / dr[:, :, None])
    np.add.at(F, (slice(None), I_nn), Fr)
    np.add.at(F, (slice(None), J_nn), -Fr)
    return E, F, dn

q_of = lambda dn: (dn <= CUTOFF).sum(axis=1) / float(M)

# ------------------------------------------------------------ batched BAOAB
# All K temperatures are integrated simultaneously: the drift force is
# temperature-independent; only the O (Ornstein-Uhlenbeck) step scales differ.
rng = np.random.default_rng(RNG_SEED)
R = np.broadcast_to(ref, (K_ALL, N, 3)).copy()
V = np.zeros_like(R)
c_ou = np.exp(-GAMMA * DT)
c_arr = np.full((K_ALL, 1, 1), c_ou)
# OU noise scale sqrt((1-c^2) * kBT/m) with k_B = m = 1, per temperature
s_arr = np.sqrt(1.0 - c_ou ** 2) * np.sqrt(T_ALL)[:, None, None]
Q_dense = np.empty((K_ALL, NSTEPS)); E_dense = np.empty((K_ALL, NSTEPS))
DN_ckpt = np.empty((K_ALL, N_CKPT, M))
half = 0.5 * DT
ckpt_steps = set(range(SAVE, NSTEPS + 1, SAVE))
E, F, _ = forces_and_energy(R)
for step in range(1, NSTEPS + 1):
    V += half * F                       # B (half kick)
    R = R + DT * V                      # A
    xi = rng.standard_normal((K_ALL, N, 3))
    V = c_arr * V + s_arr * xi           # O
    R = R + DT * V                      # A
    E, F, dn = forces_and_energy(R)
    V += half * F                       # B (half kick)
    Q_dense[:, step - 1] = q_of(dn)
    E_dense[:, step - 1] = E
    if step in ckpt_steps:
        DN_ckpt[:, (step // SAVE) - 1, :] = dn
R_final = R.copy()

Q_ckpt = Q_dense[:K, SAVE - 1::SAVE]      # ladder rows only
assert Q_ckpt.shape == (K, N_CKPT) and DN_ckpt.shape[1] == N_CKPT
np.save("final_coords.npy", R_final[0].astype(np.float64))   # lowest T
np.save("order_parameter_trajectory.npy", Q_ckpt.astype(np.float64))

# statistics use post-burn-in frames only
b_ck = int(round(BURN_FRAC * N_CKPT))
Qs = Q_ckpt[:, b_ck:]
E_ckpt = E_dense[:K, SAVE - 1::SAVE]
Es = E_ckpt[:, b_ck:]
b_dense = int(round(BURN_FRAC * NSTEPS))
Qd = Q_dense[:, b_dense:]; Ed = E_dense[:, b_dense:]   # all rows feed WHAM

# (K,50) Q histograms over [0,1], probability mass (rows sum to 1)
q_edges = np.linspace(0.0, 1.0, N_QBINS + 1)
q_centers = 0.5 * (q_edges[:-1] + q_edges[1:])
hist = np.empty((K, N_QBINS))
for t in range(K):
    h, _ = np.histogram(Qs[t], bins=q_edges)
    hist[t] = h / h.sum()
np.save("order_parameter_histograms.npy", hist.astype(np.float64))

# per-temperature observables (checkpoint series, post-burn-in frames)
mean_Q = Qs.mean(axis=1); var_Q = Qs.var(axis=1)
mean_E = Es.mean(axis=1); var_E = Es.var(axis=1)
C_direct = var_E / TEMPS ** 2
corr_QE = np.array([np.corrcoef(Qs[t], Es[t])[0, 1] for t in range(K)])
with open("temperature_observables.json", "w") as fh:
    json.dump({"temperatures": TEMPS.tolist(),
               "mean_order_parameter_by_T": mean_Q.tolist(),
               "var_order_parameter_by_T": var_Q.tolist(),
               "mean_energy_by_T": mean_E.tolist(),
               "var_energy_by_T": var_E.tolist(),
               "heat_capacity_direct_by_T": C_direct.tolist(),
               "q_energy_correlation_by_T": corr_QE.tolist()}, fh, indent=2)

# joint (Q, z-scored E) histograms from checkpoint frames; clipped z in [-3,3]
# so every temperature slice sums exactly to 1
zE = np.clip((E_ckpt[:, b_ck:] - mean_E[:, None]) / np.sqrt(var_E)[:, None],
             -3.0, 3.0)
q20 = np.linspace(0.0, 1.0, N_JOINT + 1); z20 = np.linspace(-3.0, 3.0, N_JOINT + 1)
joint = np.empty((K, N_JOINT, N_JOINT))
for t in range(K):
    h, _, _ = np.histogram2d(Qs[t], zE[t], bins=[q20, z20])
    joint[t] = h / h.sum()
np.save("q_energy_joint_histograms.npy", joint.astype(np.float64))

# per-pair native contact probability (K, M) from checkpoint frames
ncp = (DN_ckpt[:K, b_ck:, :] <= CUTOFF).mean(axis=1)
np.save("native_contact_probability.npy", ncp.astype(np.float64))

# ------------------------------------------------------------------- WHAM
# Dense post-burn-in (Q, E) samples; joint histogram (nQ x nE) per temperature.
# Energies are shifted by the global mean E0 for numerical conditioning; the
# shift cancels exactly in the WHAM self-consistency and in reweighting.
E0 = Ed.mean()
# ----------------------------- binless WHAM (UWHAM) reweighting -------------
# Each dense post-burn-in sample enters with its EXACT energy (no bin-center
# bias). Energies are shifted by E0 for conditioning; the shift is exact in
# the log domain and cancels in all normalized quantities. Fixed point for the
# per-state free energies logM_j, then arbitrary-temperature reweighting.
from scipy.special import logsumexp
Ep = (Ed - E0).ravel()                       # shifted energies, all samples
Qp = np.rint(Qd.ravel() * M).astype(int)     # discrete Q index 0..M
beta_all = 1.0 / T_ALL
B = np.log(Ed.shape[1]) - beta_all[:, None] * Ep[None, :]   # logN_j - b_j E'
logM = np.zeros(K_ALL)
for _ in range(5000):
    logden = logsumexp(B + logM[:, None], axis=0)
    logw = -logden
    logMnew = -(logsumexp(B + logw[None, :], axis=1) - logsumexp(logw))
    delta = np.max(np.abs(logMnew - logM))
    logM = logMnew
    if delta < 1e-10:
        break
logden = logsumexp(B + logM[:, None], axis=0)
q_support = np.arange(M + 1) / float(M)

fine_T = np.linspace(0.30, 1.45, N_FINE)
meanQ_fine = np.empty(N_FINE); meanE_fine = np.empty(N_FINE)
varE_fine = np.empty(N_FINE); C_fine = np.empty(N_FINE)
for a, Tv in enumerate(fine_T):
    lw = -(1.0 / Tv) * Ep - logden
    lw -= logsumexp(lw)
    w = np.exp(lw)
    Pq = np.bincount(Qp, weights=w, minlength=M + 1)
    meanQ_fine[a] = Pq.dot(q_support)
    mE = (w * Ep).sum()
    meanE_fine[a] = mE + E0
    varE_fine[a] = (w * Ep ** 2).sum() - mE ** 2
    C_fine[a] = varE_fine[a] / Tv ** 2
np.save("heat_capacity_curve.npy", np.vstack([fine_T, C_fine]).astype(np.float64))

# T*: <Q>(T*) = 0.5 via linear interpolation between fine-grid points
T_star = None
for a in range(N_FINE - 1):
    y0, y1 = meanQ_fine[a] - 0.5, meanQ_fine[a + 1] - 0.5
    if y0 == 0.0:
        T_star = fine_T[a]; break
    if y0 * y1 < 0:
        T_star = fine_T[a] + (0.5 - meanQ_fine[a]) / (meanQ_fine[a + 1]
                 - meanQ_fine[a]) * (fine_T[a + 1] - fine_T[a])
        break
warnings = []
if T_star is None:
    T_star = float(fine_T[np.argmin(np.abs(meanQ_fine - 0.5))])
    warnings.append("<Q>(T) never crossed 0.5 on the fine temperature grid; "
                    "used the fine-grid temperature minimizing |<Q>-0.5| "
                    "instead.")
warnings.append(
    "The <Q>=0.5 midpoint lies below the lowest provided ladder temperature "
    f"({TEMPS[0]:.4f}); auxiliary trajectories at T={AUX_T[0]:.2f} and "
    f"T={AUX_T[1]:.2f} (identical force field, protocol, and Q definition) "
    "were added to the reweighting ensemble so that T* is obtained by "
    "interpolation rather than extrapolation. All per-temperature artifacts "
    "use only the 6 file temperatures.")
warnings.append(
    "T* carries statistical uncertainty of order 0.03-0.05 in T: the chain "
    "relaxes slowly at low T, and independent seeds give <Q>(T) varying by "
    "about +/-0.04 at fixed temperature.")
warnings.append(
    "transition_free_energy_profile: Q is discrete (multiples of 1/36), so "
    "0.02-wide bins containing no attainable Q value are assigned the "
    "occupied-profile maximum (ceiling convention) to keep the artifact "
    "finite.")
i_star = int(np.argmin(np.abs(fine_T - T_star)))

# Q distribution at T* on its discrete support (Q = k/M, k = 0..M)
lw = -(1.0 / T_star) * Ep - logden
lw -= logsumexp(lw)
P_supp = np.bincount(Qp, weights=np.exp(lw), minlength=M + 1)
# smooth on the discrete support for mode finding (Q lattice spacing 1/M)
P_smooth = gaussian_filter1d(P_supp, sigma=1.2, mode="nearest")
P_smooth /= P_smooth.sum()
F_supp = -T_star * np.log(np.maximum(P_smooth, 1e-12))
F_supp -= F_supp.min()
peaks = [i for i in range(1, M) if P_smooth[i] >= P_smooth[i - 1]
         and P_smooth[i] > P_smooth[i + 1]]
if not peaks:
    peaks = [int(np.argmax(P_smooth))]
peaks.sort(key=lambda i: -P_smooth[i])
if len(peaks) >= 2:
    m1, m2 = sorted((peaks[0], peaks[1]))
    modes = [float(q_support[m1]), float(q_support[m2])]
    mode_sep = float(q_support[m2] - q_support[m1])
    saddle = m1 + int(np.argmax(F_supp[m1:m2 + 1]))
    barrier = float(max(0.0, F_supp[saddle] - min(F_supp[m1], F_supp[m2])))
else:
    modes = [float(q_support[peaks[0]])]
    mode_sep = 0.0; barrier = 0.0
    warnings.append("P(Q) at T* is single-mode; mode_separation and "
                    "free_energy_barrier_kT reported as 0.")

# 50-bin free-energy profile artifact (row0 bin centers, row1 F, min = 0).
# Q is discrete (multiples of 1/M), so some 0.02-wide bins contain no
# attainable Q value; empty bins are assigned the occupied-profile maximum
# (a ceiling convention) so the artifact stays finite.
P_bin = np.zeros(N_QBINS)
for k in range(M + 1):
    P_bin[min(int(np.floor(q_support[k] * N_QBINS)), N_QBINS - 1)] += P_supp[k]
F_full = -T_star * np.log(np.maximum(P_bin, 1e-300))
occ = np.isfinite(F_full)
F_prof = np.where(occ, F_full, F_full[occ].max())
F_prof -= F_prof.min()
np.save("transition_free_energy_profile.npy",
        np.vstack([q_centers, F_prof]).astype(np.float64))

# Jaccard: adjacency of the final lowest-temperature configuration vs reference
fin = np.load("final_coords.npy")
D_fin = np.linalg.norm(fin[:, None, :] - fin[None, :, :], axis=-1)
fin_pairs = {(i, j) for i in range(N) for j in range(i + 1, N)
             if j - i >= MINSEP and D_fin[i, j] <= CUTOFF}
jaccard = float(len(fin_pairs & native_set) / len(fin_pairs | native_set))

with open("transition_analysis.json", "w") as fh:
    json.dump({"transition_temperature": float(T_star),
               "peak_heat_capacity": float(C_fine.max()),
               "order_parameter_at_transition_mean": float(meanQ_fine[i_star]),
               "order_parameter_at_transition_modes": modes,
               "mode_separation": mode_sep,
               "free_energy_barrier_kT": barrier,
               "reference_contact_jaccard": jaccard,
               "warnings": warnings}, fh, indent=2)
