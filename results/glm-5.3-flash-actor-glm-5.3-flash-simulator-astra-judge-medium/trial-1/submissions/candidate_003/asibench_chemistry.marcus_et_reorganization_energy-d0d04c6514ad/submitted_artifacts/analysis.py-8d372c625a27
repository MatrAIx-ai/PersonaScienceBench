                if bits & (1 << (4 - col)):
                    rect(x + col * scale, y + r * scale,
                         x + col * scale + scale - 1,
                         y + r * scale + scale - 1, c)
        x += 6 * scale


def fmt(v, nd=3):
    s = f"{v:.{nd}g}"
    return s.replace('e-', 'E-')


class Panel:
    """Simple cartesian axes on the shared canvas (pixel coords, y down)."""

    def __init__(self, x0, y0, x1, y1, xlim, ylim, title=''):
        self.x0, self.y0, self.x1, self.y1 = x0, y0, x1, y1
        self.xl, self.yl = xlim, ylim
        line(x0, y1, x1, y1, BLACK)          # x axis
        line(x0, y0, x0, y1, BLACK)          # y axis
        if title:
            text(x0, y0 - 24, title, BLACK, 2)

    def px(self, X, Y):
        fx = (np.asarray(X) - self.xl[0]) / (self.xl[1] - self.xl[0])
        fy = (np.asarray(Y) - self.yl[0]) / (self.yl[1] - self.yl[0])
        return self.x0 + fx * (self.x1 - self.x0), self.y1 - fy * (self.y1 - self.y0)

    def xtick(self, v, label):
        x, _ = self.px(v, self.yl[0])
        line(x, self.y1, x, self.y1 + 5, BLACK)
        text(int(x) - 3 * len(label), self.y1 + 8, label, BLACK, 1)

    def ytick(self, v, label):
        _, y = self.px(self.xl[0], v)
        line(self.x0 - 5, y, self.x0, y, BLACK)
        text(self.x0 - 8 - 6 * len(label), int(y) - 3, label, BLACK, 1)

    def xlabel(self, s):
        text((self.x0 + self.x1) // 2 - 3 * len(s), self.y1 + 22, s)

    def ylabel(self, s):
        for i, ch in enumerate(s.upper()):
            text(self.x0 - 52, (self.y0 + self.y1) // 2 - 3 * len(s) + 6 * i, ch)


