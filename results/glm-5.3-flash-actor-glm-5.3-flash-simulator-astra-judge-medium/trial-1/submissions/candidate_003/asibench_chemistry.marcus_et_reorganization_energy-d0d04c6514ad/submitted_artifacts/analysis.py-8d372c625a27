def put(x, y, c):
    if 0 <= x < W_IMG and 0 <= y < H_IMG:
        img[y, x] = c


def line(x0, y0, x1, y1, c, dashed=False):
    n = int(max(abs(x1 - x0), abs(y1 - y0))) + 1
    for i in range(n + 1):
        t = i / max(n, 1)
        if dashed and (i // 6) % 2:
            continue
        put(int(round(x0 + t * (x1 - x0))), int(round(y0 + t * (y1 - y0))), c)


def rect(x0, y0, x1, y1, c):
    for y in range(min(y0, y1), max(y0, y1) + 1):
        img[y, min(x0, x1):max(x0, x1) + 1] = c


