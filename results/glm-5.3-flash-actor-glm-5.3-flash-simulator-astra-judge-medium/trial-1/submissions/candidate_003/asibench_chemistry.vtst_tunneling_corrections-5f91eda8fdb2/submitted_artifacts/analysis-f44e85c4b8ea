    'Y':["10001","10001","01010","00100","00100","00100","00100"],
    'Z':["11111","00001","00010","00100","01000","10000","11111"],
    '.':["00000","00000","00000","00000","00000","01100","01100"],
    '-':["00000","00000","00000","01110","00000","00000","00000"],
    '(':["00010","00100","01000","01000","01000","00100","00010"],
    ')':["01000","00100","00010","00010","00010","00100","01000"],
    '+':["00000","00100","00100","11111","00100","00100","00000"],
    '/':["00001","00010","00010","00100","01000","01000","10000"],
    '^':["00100","01010","10001","00000","00000","00000","00000"],
    '=':["00000","00000","11111","00000","11111","00000","00000"],
    ':':["00000","01100","01100","00000","01100","01100","00000"],
    ' ':["00000","00000","00000","00000","00000","00000","00000"],
    }

    def _text(img, x, y, s, scale=2, color=(30, 30, 30)):
        cx = x
        for ch in s:
            g = FONT.get(ch.upper(), FONT[' '])
            for r in range(7):
                for c in range(5):
                    if g[r][c] == '#':
                        img[y + r * scale:y + (r + 1) * scale,
                            cx + c * scale:cx + (c + 1) * scale] = color
            cx += 6 * scale

    def _line(img, x0, y0, x1, y1, color, dash=0):
        n = int(max(abs(x1 - x0), abs(y1 - y0))) + 1
        xs = np.linspace(x0, x1, n).astype(int)
        ys = np.linspace(y0, y1, n).astype(int)
        if dash:
            keep = (np.arange(n) // dash) % 2 == 0
            xs, ys = xs[keep], ys[keep]
        img[ys, xs] = color

    def _marker(img, x, y, kind, color, r=5):
        if kind == 'o':
            for dy in range(-r, r + 1):
                w = int(np.sqrt(max(r * r - dy * dy, 0)))
                img[y + dy, x - w:x + w + 1] = color
        elif kind == 's':
            img[y - r:y + r + 1, x - r:x + r + 1] = color
        else:  # triangle
            for i, dy in enumerate(range(-r, r + 1)):
                half = r - abs(dy)
                img[y + dy, x - half:x + half + 1] = color

    W, H = 1500, 1000
    L, Rp, Tm, B = 130, 150, 90, 100
    img = np.full((H, W, 3), 255, np.uint8)
    BLK, RED, GRY = (20, 20, 20), (200, 30, 60), (150, 150, 150)

    Tvals = rate_constants["T_K"].to_numpy()
    y_loc = rate_constants["log10_k_local_s_inv"].to_numpy()
    y_opt = rate_constants["log10_k_optimized_s_inv"].to_numpy()
    y_enh = rate_constants["log10_k_enhanced_s_inv"].to_numpy()
    enh = rate_constants["enhancement_factor"].to_numpy()

    x0, x1 = 150.0, 1000.0
    ylo, yhi = -3.0, 11.0
    zlo, zhi = 0.0, 0.06   # log10(enhancement) right-axis window
    def X(t): return int(L + (t - x0) / (x1 - x0) * (W - Rp - L))
    def Y1(v): return int((H - B) - (v - ylo) / (yhi - ylo) * (H - B - Tm))
    def Y2(v): return int((H - B) - (v - zlo) / (zhi - zlo) * (H - B - Tm))

    # frame + grid
    img[Tm:H - B, L:W - Rp] = 255
    for v in range(-2, 12, 2):
        _line(img, L, Y1(v), W - Rp, Y1(v), (230, 230, 230))
    for t in (200, 400, 600, 800):
        _line(img, X(t), Tm, X(t), H - B, (235, 235, 235))
    _line(img, L, Tm, L, H - B, BLK); _line(img, L, H - B, W - Rp, H - B, BLK)
    _line(img, W - Rp, Tm, W - Rp, H - B, BLK); _line(img, L, Tm, W - Rp, Tm, BLK)
    # ticks + labels
    for t in (200, 400, 600, 800, 1000):
        _line(img, X(t), H - B, X(t), H - B + 6, BLK)
        _text(img, X(t) - 18, H - B + 12, f"{t:g}", 2, BLK)
    for v in range(-2, 12, 2):
        _line(img, L - 6, Y1(v), L, Y1(v), BLK)
        _text(img, L - 60, Y1(v) - 7, f"{v:d}", 2, BLK)
    for z, lab in ((np.log10(1.07), "1.07"), (np.log10(1.10), "1.10"), (np.log10(1.13), "1.13")):
        _line(img, W - Rp, Y2(z), W - Rp + 6, Y2(z), RED)
        _text(img, W - Rp + 12, Y2(z) - 7, lab, 2, RED)
    # crossover line
    _line(img, X(Tc_light), Tm, X(Tc_light), H - B, GRY, dash=6)
    _text(img, X(Tc_light) - 90, Tm + 8, f"CROSSOVER T = {Tc_light:.0f} K", 2, (90, 90, 90))
    # curves
    def _curve(yv, Ymap, color, kind):
        for i in range(len(Tvals) - 1):
            _line(img, X(Tvals[i]), Ymap(yv[i]), X(Tvals[i + 1]), Ymap(yv[i + 1]), color)
        for i in range(len(Tvals)):
            _marker(img, X(Tvals[i]), Ymap(yv[i]), kind, color)
    _curve(y_loc, Y1, (30, 60, 200), 'o')
    _curve(y_opt, Y1, (20, 130, 60), 's')
    _curve(y_enh, Y1, (170, 80, 0), '^')
    _curve(np.log10(enh), Y2, RED, 'o')
    # legend
    lx, ly = L + 420, H - B - 170
    img[ly - 8:ly + 108, lx - 12:lx + 420] = (250, 250, 250)
    for k, (kind, col, txt) in enumerate([
            ('o', (30, 60, 200), "LOCAL (CONVENTIONAL SADDLE)"),
            ('s', (20, 130, 60), "OPTIMIZED (VARIATIONAL)"),
            ('^', (170, 80, 0), "ENHANCED (+ TUNNELING)"),
            ('o', RED, "ENHANCEMENT FACTOR (ENH/LOCAL, RIGHT AXIS)")]):
        yy = ly + k * 26
        _marker(img, lx, yy, kind, col, 5)
        _text(img, lx + 16, yy - 7, txt, 2, BLK)
    # titles / axis labels
    _text(img, (L + W - Rp) // 2 - 380, 28,
          "RATE ESTIMATES AND ENHANCEMENT FACTOR VS TEMPERATURE", 2, BLK)
    _text(img, (L + W - Rp) // 2 - 30, H - B + 45, "T (K)", 2, BLK)
    ylab = "LOG10 K (S^-1)"
    for i, ch in enumerate(ylab):
        _text(img, 55, Tm + 100 + i * 26, ch, 2, BLK)
    rlab = "ENHANCEMENT FACTOR"
    for i, ch in enumerate(rlab):
        _text(img, W - 45, Tm + 120 + i * 26, ch, 2, (200, 30, 60))

    raw = b''.join(b'\x00' + img[i].tobytes() for i in range(H))
    def _chunk(tag, data):
        return (struct.pack('>I', len(data)) + tag + data +
                struct.pack('>I', zlib.crc32(tag + data) & 0xffffffff))
    png = (b'\x89PNG\r\n\x1a\n' + _chunk(b'IHDR', struct.pack('>IIBBBBB', W, H, 8, 2, 0, 0, 0))
           + _chunk(b'IDAT', zlib.compress(raw, 6)) + _chunk(b'IEND', b''))
    open(f"{OUT}/rate_plot.png", "wb").write(png)
    print("rate_plot.png written via numpy fallback rasterizer")
