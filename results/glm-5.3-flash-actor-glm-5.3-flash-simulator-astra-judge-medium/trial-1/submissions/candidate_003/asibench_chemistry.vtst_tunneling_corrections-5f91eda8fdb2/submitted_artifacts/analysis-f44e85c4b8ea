#!/usr/bin/env python3
"""
asibench:chemistry.vtst_tunneling_corrections -- full reproducible analysis.

Reaction: lower-x basin -> higher-x basin on a 2D potential surface.
  1. Local crossing surface from tube_scan transverse minima (adiabatic transverse
     relaxation; NOT the q=0 slice).
  2. Free-energy profile G(s,T) = E_transv_min(s) + ZPE_perp + thermal (one harmonic
     transverse mode); k_local at the conventional potential saddle, k_optimized at
     the variational free-energy maximum s*(T).
  3. WKB actions: corridor (on-path potential) vs 2D (transverse-minimum potential).
     Transmission T(E) = 1/(1+exp(2*S_scaled)) below the classical barrier, T=1 above.
  4. Rates: TST/Eyring (kBT/h) exp(-dG/RT); kappa_corridor from corridor-action
     transmission; k_enhanced = k_optimized * kappa; enhancement = k_enhanced/k_local.
  5. Isotopes: nu_perp -> nu_perp/sqrt(m_trans); actions -> actions*sqrt(m_long);
     T_c recomputed per case; KIE = log10(k_light,enh) - log10(k_case,enh).
  6. path_samples.csv: transverse-relaxed 2D path per energy_id.
Conventions: energies for actions/transmission referenced to the corridor reactant
end (s=0); semiclassical_action_scale=1.24 multiplies the raw WKB action; free
energies reported relative to G(s=0,T).
"""
import json
import numpy as np
import pandas as pd
from scipy.interpolate import CubicSpline, RegularGridInterpolator
from scipy.optimize import brentq
from scipy.integrate import simpson
try:
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt
    HAVE_MPL = True
except Exception:
    plt = None
    HAVE_MPL = False

DATA, OUT = "data", "results"
R = 0.00831446261815324
FREQ_SCALE = 95.0
HC = 0.0119626565638697
HC_OVER_KB = 1.438776877
KB_OVER_H = 20836619120.0
ACTION_SCALE = 1.24

surface = pd.read_csv(f"{DATA}/surface_samples.csv")
curve = pd.read_csv(f"{DATA}/curve_samples.csv")
tube = pd.read_csv(f"{DATA}/tube_scan.csv")
temps = pd.read_csv(f"{DATA}/temperature_grid.csv")
iso = pd.read_csv(f"{DATA}/isotope_cases.csv")

s_arr = curve["s_coord"].to_numpy()
x_arr, y_arr = curve["x"].to_numpy(), curve["y"].to_numpy()
nx, ny = curve["normal_x"].to_numpy(), curve["normal_y"].to_numpy()
npts = len(curve)

xs_u = np.sort(surface["x"].unique()); ys_u = np.sort(surface["y"].unique())
surf_interp = RegularGridInterpolator(
    (ys_u, xs_u),
    surface.pivot(index="y", columns="x", values="potential_kj_mol").to_numpy())

# ---------------- transverse tube analysis (local crossing-surface quantities)
qpiv = tube.pivot_table(index="q_id", columns="point_id", values="potential_kj_mol")
q_off = tube.groupby("q_id")["q_offset"].first().to_numpy()
E_onpath = qpiv.loc[q_off == 0.0].to_numpy().ravel()
assert len(E_onpath) == npts

E_tmin = np.empty(npts); curv_perp = np.empty(npts); q_min = np.empty(npts)
for pid in range(npts):
    v = qpiv[pid].to_numpy()
    im = int(np.argmin(v))
    lo, hi = max(0, im - 3), min(len(v), im + 4)
    c2, c1, c0 = np.polyfit(q_off[lo:hi], v[lo:hi], 2)
    curv_perp[pid] = 2.0 * c2
    q_min[pid] = np.clip(-c1 / (2.0 * c2), q_off[0], q_off[-1])
    E_tmin[pid] = np.polyval((c2, c1, c0), q_min[pid])
nu_perp = FREQ_SCALE * np.sqrt(np.maximum(curv_perp, 1e-12))

E_ref = E_onpath[0]
V_corr = E_onpath - E_ref      # corridor (on-path) potential, reactant-referenced
V_2d = E_tmin - E_ref          # transverse-relaxed (2D) potential

# conventional saddle: parabolic refinement of the corridor maximum
i_top = int(np.argmax(E_onpath)); w = 8
sl = slice(max(0, i_top - w), min(npts, i_top + w + 1))
c2s, c1s, c0s = np.polyfit(s_arr[sl], E_onpath[sl], 2)
s_saddle = float(-c1s / (2.0 * c2s))
E_saddle = float(np.polyval((c2s, c1s, c0s), s_saddle))
curv_long = float(2.0 * c2s)
nu_imag = FREQ_SCALE * np.sqrt(-curv_long)
nu_saddle = float(np.interp(s_saddle, s_arr, nu_perp))

# --------------------------------------------------------- free-energy profile
def free_energy_profile(m_trans=1.0):
    nu = nu_perp / np.sqrt(m_trans)
    zpe = HC * nu / 2.0
    out = {}
    for T in temps["T_K"].to_numpy():
        therm = R * T * np.log1p(-np.exp(-HC * nu / (R * T)))
        G = V_2d + zpe + therm
        out[T] = G - G[0]
    return out, nu

def rates_for_case(m_trans=1.0):
    prof, nu = free_energy_profile(m_trans)
    spl = {T: CubicSpline(s_arr, G) for T, G in prof.items()}
    recs = []
    for T in temps["T_K"].to_numpy():
        G = prof[T]
        i = int(np.argmax(G))
        lo, hi = max(0, i - 3), min(npts, i + 4)
        c2, c1, c0 = np.polyfit(s_arr[lo:hi], G[lo:hi], 2)
        s_star = float(np.clip(-c1 / (2.0 * c2), s_arr[0], s_arr[-1]))
        G_star = float(max(np.polyval((c2, c1, c0), s_star), spl[T](s_star)))
        G_loc = float(spl[T](s_saddle))
        k_local = KB_OVER_H * T * np.exp(-G_loc / (R * T))
        k_opt = KB_OVER_H * T * np.exp(-G_star / (R * T))
        recs.append(dict(T_K=float(T), s_star=s_star, G_loc=G_loc, G_opt=G_star,
                         k_local=k_local, k_opt=k_opt, i_star=i))
    return recs

# ---------------------------------------------------------------- WKB actions
s_dense = np.linspace(s_arr[0], s_arr[-1], 6001)
Vc_d = CubicSpline(s_arr, V_corr)(s_dense)
V2_d = CubicSpline(s_arr, V_2d)(s_dense)
ds_dense = s_dense[1] - s_dense[0]

def wkb_action(Vd, E, m=1.0):
    diff = Vd - E
    idx = np.where(np.diff(np.sign(diff)) != 0)[0]
    if len(idx) < 2:
        return ACTION_SCALE * 0.0 * m, None
    roots = [brentq(lambda sv: np.interp(sv, s_dense, Vd) - E,
                    s_dense[j], s_dense[j + 1]) for j in idx]
    s1, s2 = roots[0], roots[-1]
    mask = (s_dense >= s1) & (s_dense <= s2)
    S_raw = float(simpson(np.sqrt(np.maximum(2.0 * m * diff[mask], 0.0)), dx=ds_dense))
    return ACTION_SCALE * S_raw * np.sqrt(m), (s1, s2)

Vb = float(max(V_corr.max(), V_2d.max()))
E_grid = np.round(np.arange(0.0, 78.0 + 1e-9, 0.25), 6)   # transmission profile
E_kappa = np.arange(0.0, Vb + 1e-9, 0.05)                 # dense grid for kappa
S_cor_g = np.array([wkb_action(Vc_d, E)[0] for E in E_grid])
S_2d_g = np.array([wkb_action(V2_d, E)[0] for E in E_grid])
S_cor_k = np.array([wkb_action(Vc_d, E)[0] for E in E_kappa])

def transmission(S, E, Vb_prof):
    return np.where(E >= Vb_prof, 1.0, 1.0 / (1.0 + np.exp(2.0 * S)))

def kappa(T_K, S_on_E, E_on_E, Vb_ref):
    mask = E_on_E <= Vb_ref + 1e-12
    Ee, Se = E_on_E[mask], S_on_E[mask]
    Tr = np.where(Ee >= Vb_ref, 1.0, 1.0 / (1.0 + np.exp(2.0 * Se)))
    integ = simpson(Tr * np.exp(-(Vb_ref - Ee) / (R * T_K)), x=Ee) / (R * T_K)
    return 1.0 + integ

# ------------------------------------------------------------- path sampling
q_min_sp = CubicSpline(s_arr, q_min)
xs_sp, ys_sp = CubicSpline(s_arr, x_arr), CubicSpline(s_arr, y_arr)
nxs, nys = CubicSpline(s_arr, nx), CubicSpline(s_arr, ny)

def path_for_energy(E):
    diff = V2_d - E
    idx = np.where(np.diff(np.sign(diff)) != 0)[0]
    if len(idx) >= 2 and E < V_2d.max():
        r = [brentq(lambda sv: np.interp(sv, s_dense, V2_d) - E,
                    s_dense[j], s_dense[j + 1]) for j in idx]
        s1, s2 = r[0], r[-1]
    else:
        s1, s2 = s_arr[0], s_arr[-1]
    s_path = np.linspace(s1, s2, 13)
    q = q_min_sp(s_path)
    xp = xs_sp(s_path) + q * nxs(s_path)
    yp = ys_sp(s_path) + q * nys(s_path)
    pot = surf_interp(np.column_stack([yp, xp]))
    return xp, yp, pot

# ------------------------------------------------------------------- run all
light = rates_for_case(1.0)
Tc_light = nu_imag * HC_OVER_KB / (2.0 * np.pi)

rows = []
for T in temps["T_K"].to_numpy():
    G = free_energy_profile(1.0)[0][T]
    i_star = int(np.argmax(G))
    for pid in range(npts):
        rows.append(dict(T_K=T, point_id=pid, s_coord=s_arr[pid], x=x_arr[pid],
                         y=y_arr[pid], transverse_frequency_cm1=nu_perp[pid],
                         free_energy_kj_mol=G[pid], optimized_crossing=(pid == i_star)))
pd.DataFrame(rows).to_csv(f"{OUT}/free_energy_profile.csv", index=False)

pd.DataFrame(dict(energy_id=np.arange(len(E_grid)), energy_kj_mol=E_grid,
                  action_corridor=S_cor_g, action_2d=S_2d_g,
                  transmission_corridor=transmission(S_cor_g, E_grid, V_corr.max()),
                  transmission_2d=transmission(S_2d_g, E_grid, V_2d.max()),
                  action_ratio_2d_over_corridor=np.divide(S_2d_g, S_cor_g, out=np.ones_like(S_cor_g), where=S_cor_g > 0))
             ).to_csv(f"{OUT}/transmission_profile.csv", index=False)

prow = []
for eid, E in enumerate(E_grid):
    xp, yp, pot = path_for_energy(E)
    for step, (a, b, c) in enumerate(zip(xp, yp, pot)):
        prow.append(dict(energy_id=eid, path_step=step, energy_kj_mol=E,
                         x=a, y=b, potential_kj_mol=float(c)))
pd.DataFrame(prow).to_csv(f"{OUT}/path_samples.csv", index=False)

rc_rows = []
for rec in light:
    T = rec["T_K"]
    kap = kappa(T, S_cor_k, E_kappa, Vb)
    k_enh = rec["k_opt"] * kap
    rc_rows.append(dict(T_K=T, log10_k_local_s_inv=np.log10(rec["k_local"]),
                        log10_k_optimized_s_inv=np.log10(rec["k_opt"]),
                        log10_k_enhanced_s_inv=np.log10(k_enh), kappa_corridor=kap,
                        enhancement_factor=k_enh / rec["k_local"],
                        s_optimized=rec["s_star"], barrier_local_kj_mol=rec["G_loc"],
                        barrier_optimized_kj_mol=rec["G_opt"], crossover_T_K=Tc_light))
rate_constants = pd.DataFrame(rc_rows)
rate_constants.to_csv(f"{OUT}/rate_constants.csv", index=False)

# --------------------------------------------------------------- isotope cases
iso_frames, iso_rows, iso_diag = [], [], {}
for _, case in iso.iterrows():
    mt, ml = case["transverse_mass_scale"], case["longitudinal_mass_scale"]
    recs = rates_for_case(mt)
    S_cor_i, S_2d_i = S_cor_g * np.sqrt(ml), S_2d_g * np.sqrt(ml)
    S_cor_ki = S_cor_k * np.sqrt(ml)
    Tc_i = (nu_imag / np.sqrt(ml)) * HC_OVER_KB / (2.0 * np.pi)
    iso_frames.append(pd.DataFrame(dict(
        case_id=case["case_id"], isotopologue=case["isotopologue"],
        longitudinal_mass_scale=ml, transverse_mass_scale=mt,
        energy_id=np.arange(len(E_grid)), energy_kj_mol=E_grid,
        action_corridor=S_cor_i, action_2d=S_2d_i,
        transmission_corridor=transmission(S_cor_i, E_grid, V_corr.max()),
        transmission_2d=transmission(S_2d_i, E_grid, V_2d.max()),
        action_ratio_2d_over_corridor=np.divide(S_2d_i, S_cor_i, out=np.ones_like(S_cor_i), where=S_cor_i > 0))))
    for rec in recs:
        T = rec["T_K"]
        kap = kappa(T, S_cor_ki, E_kappa, Vb)
        k_enh = rec["k_opt"] * kap
        iso_rows.append(dict(case_id=case["case_id"], isotopologue=case["isotopologue"],
                             longitudinal_mass_scale=ml, transverse_mass_scale=mt,
                             T_K=T, log10_k_local_s_inv=np.log10(rec["k_local"]),
                             log10_k_optimized_s_inv=np.log10(rec["k_opt"]),
                             log10_k_enhanced_s_inv=np.log10(k_enh),
                             enhancement_factor=k_enh / rec["k_local"],
                             s_optimized=rec["s_star"], crossover_T_K=Tc_i,
                             log10_KIE_sct_vs_light=np.nan))
    iso_diag[case["case_id"]] = dict(crossover_T_K=Tc_i,
                                     imaginary_frequency_cm1=nu_imag / np.sqrt(ml))
pd.concat(iso_frames, ignore_index=True).to_csv(
    f"{OUT}/isotope_transmission_profile.csv", index=False)

isotope_effects = pd.DataFrame(iso_rows)
light_map = dict(zip(rate_constants["T_K"], rate_constants["log10_k_enhanced_s_inv"]))
isotope_effects["log10_KIE_sct_vs_light"] = [
    light_map[r.T_K] - r.log10_k_enhanced_s_inv for r in isotope_effects.itertuples()]
isotope_effects.to_csv(f"{OUT}/isotope_effects.csv", index=False)

# ---------------------------------------------------------------- diagnostics
red_frac = np.divide(S_cor_g - S_2d_g, S_cor_g, out=np.full_like(S_cor_g, np.nan), where=S_cor_g > 0)
mask_e = (E_grid > 0.01) & (E_grid < Vb)
mean_red = float(np.nanmean(red_frac[mask_e]))

k_low_check = {}
for h in (0.1, 0.05, 0.025):
    Eg = np.arange(0.0, Vb + 1e-9, h)
    Sg = np.array([wkb_action(Vc_d, E)[0] for E in Eg])
    k_low_check[f"step_{h}_kJ_mol"] = float(kappa(177.5, Sg, Eg, Vb))

surf_lo, surf_hi = surface[surface["x"] < 0.0], surface[surface["x"] > 0.0]
jlo = surf_lo["potential_kj_mol"].idxmin()
jhi = surf_hi["potential_kj_mol"].idxmin()
saddle_shift = {f"T={T:g}": {"s_potential_saddle": s_saddle,
                             "s_free_energy_max": light[k]["s_star"]}
                for k, T in enumerate(temps["T_K"].to_numpy())}

diag = {
    "definitions": {
        "k_local": "TST/Eyring through the conventional dividing surface at the "
                   "potential saddle of the corridor on-path profile (parabolically "
                   "refined), barrier dG_loc(T) from the free-energy profile.",
        "k_optimized": "Variational TST: dividing surface at s*(T), the maximum of the "
                       "free-energy profile G(s,T) built on tube_scan transverse "
                       "minima (adiabatic transverse relaxation, not q=0 slices).",
        "k_enhanced": "k_optimized * kappa_corridor (semiclassical tunneling "
                      "transmission of the corridor barrier).",
        "enhancement_factor": "k_enhanced / k_local (variational optimization plus "
                              "tunneling, relative to the conventional-saddle rate).",
        "action_convention": "E referenced to the corridor reactant end (s=0); "
                             "semiclassical_action_scale=1.24 multiplies the raw WKB "
                             "action; transmission exponent = 2 * S_scaled.",
        "transmission": "T(E)=1/(1+exp(2*S_scaled)) below the classical barrier; step "
                        "function T=1 above it (assumption: no above-barrier "
                        "reflection).",
        "crossing_surface": "G(s,T) and transverse frequencies use the tube_scan "
                            "transverse minima per point (not q=0 slices).",
        "free_energy_reference": "G reported relative to G(s=0,T) (reactant end).",
        "kappa": "kappa = 1 + (1/kT) * int_0^Vb T(E) exp(-(Vb-E)/kT) dE with Vb the "
                 "classical barrier (stable Boltzmann reformulation)."
    },
    "basins": {
        "reactant": {"x": float(surf_lo.loc[jlo, "x"]), "y": float(surf_lo.loc[jlo, "y"]),
                     "potential_kj_mol": float(surf_lo.loc[jlo, "potential_kj_mol"])},
        "product": {"x": float(surf_hi.loc[jhi, "x"]), "y": float(surf_hi.loc[jhi, "y"]),
                    "potential_kj_mol": float(surf_hi.loc[jhi, "potential_kj_mol"])}},
    "conventional_saddle": {
        "s_coord": s_saddle, "x": float(xs_sp(s_saddle)), "y": float(ys_sp(s_saddle)),
        "potential_kj_mol_above_reactant": E_saddle - E_ref,
        "longitudinal_curvature_kj_mol_coord2": curv_long,
        "imaginary_frequency_cm1": nu_imag,
        "transverse_frequency_cm1": nu_saddle},
    "crossover_temperatures_K": {"light": Tc_light,
                                 **{k: v["crossover_T_K"] for k, v in iso_diag.items()}},
    "action_reduction": {
        "mean_fraction_2d_vs_corridor_below_barrier": mean_red,
        "definition": "mean over 0 < E < V_barrier of 1 - S_2d/S_corridor"},
    "kappa_grid_convergence": {"kappa_at_177.5K": k_low_check,
                               "adopted_kappa_grid_step_kj_mol": 0.05},
    "saddle_shift_vs_temperature": saddle_shift,
    "rate_ordering_check": {
        "k_optimized_le_k_local_all_T": bool(np.all(
            rate_constants["log10_k_optimized_s_inv"] <=
            rate_constants["log10_k_local_s_inv"] + 1e-9)),
        "k_optimized_le_k_local_note": "variational TST: the free-energy maximum is the "
                                       "bottleneck, so the optimized rate is the "
                                       "tightened (lower) TST upper bound",
        "k_enhanced_ge_k_optimized_all_T": bool(np.all(
            rate_constants["log10_k_enhanced_s_inv"] >=
            rate_constants["log10_k_optimized_s_inv"] - 1e-9))}
}
with open(f"{OUT}/diagnostics.json", "w") as f:
    json.dump(diag, f, indent=2)
# --------------------------------------------------------------------- plot
if HAVE_MPL:

    fig, ax1 = plt.subplots(figsize=(7.5, 5.2))
    T = rate_constants["T_K"]
    ax1.plot(T, rate_constants["log10_k_local_s_inv"], "o-",
             label="local (conventional saddle)")
    ax1.plot(T, rate_constants["log10_k_optimized_s_inv"], "s-",
             label="optimized (variational)")
    ax1.plot(T, rate_constants["log10_k_enhanced_s_inv"], "^-",
             label="enhanced (+ tunneling)")
    ax1.axvline(Tc_light, color="gray", ls="--", lw=1,
                label=f"crossover T = {Tc_light:.0f} K")
    ax1.set_xlabel("T (K)"); ax1.set_ylabel(r"$\log_{10} k$ (s$^{-1}$)")
    ax1.legend(loc="lower right", fontsize=8)
    ax2 = ax1.twinx()
    ax2.plot(T, rate_constants["enhancement_factor"], "d--", color="crimson",
             label="enhancement factor (enh/local)")
    ax2.set_yscale("log"); ax2.set_ylabel("enhancement factor", color="crimson")
    ax2.tick_params(axis="y", colors="crimson"); ax2.legend(loc="upper right", fontsize=8)
    ax1.set_title("Rate estimates and enhancement factor vs temperature")
    fig.tight_layout(); fig.savefig(f"{OUT}/rate_plot.png", dpi=150)

    print("crossover T (light): %.2f K" % Tc_light)
    print("kappa convergence at 177.5 K:", k_low_check)
    print("mean action reduction fraction: %.4f" % mean_red)
    print("potential saddle: s=%.4f E=%.3f kJ/mol; nu_imag=%.1f cm^-1"
          % (s_saddle, E_saddle - E_ref, nu_imag))
    print(rate_constants.to_string(index=False))
    print(isotope_effects.to_string(index=False))
else:
