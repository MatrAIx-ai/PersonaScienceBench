#!/usr/bin/env python3
"""
Deterministic confidence-interval engine forensics analysis.

Inputs (data/): study_manifest.json, probe_manifest.json, observed_samples.csv,
resample_panels.npz, calibration_samples.npz, calibration_resample_panels.npz,
engine_interval_panels.npz.  Outputs: all artifacts under results/.

Design decisions (fixed before computing):
  * Per-case coverage target = mean of the 108 replication-level statistics
    (committed primary estimator).  A pooled-sample variant is computed and
    printed as a sensitivity check only -- it never feeds the audit.
  * Engine/case mapping is read from the engine_ids / case_ids key arrays in
    engine_interval_panels.npz; row order is never used to identify an engine.
  * probe_02 / probe_03 use the dedicated probe arrays; probe_00 / probe_01 /
    probe_04 are constructed diagnostics (formulas inline below).  All
    diagnostics are finite severity measures (larger = worse).
  * Ranking tie-break is deterministic: (score, engine_id) ascending.
"""

import json
import numpy as np
import pandas as pd

DATA = "data"
OUT = "results"

def statistic(values, name, params):
    if name == "mean":
        return float(np.mean(values))
    if name == "median":
        return float(np.median(values))
    if name == "coefficient_of_variation":
        return float(np.std(values, ddof=params.get("std_ddof", 1)) / np.mean(values))
    if name == "upper_tail_rate":
        assert params["comparison"] == ">="
        return float(np.mean(values >= params["threshold"]))
    raise ValueError(name)

def mm(x):
    """min-max normalise penalties to [0,1] (larger = worse)."""
    x = np.asarray(x, dtype=float)
    lo, hi = x.min(), x.max()
    return np.zeros_like(x) if hi - lo <= 0 else (x - lo) / (hi - lo)

manifest = json.load(open(f"{DATA}/study_manifest.json"))
probe_manifest = json.load(open(f"{DATA}/probe_manifest.json"))
ALPHA = 1.0 - manifest["confidence_level"]
CASES = manifest["cases"]
ENGINES = list(manifest["engine_ids"])
LABELS = list(manifest["failure_label_vocabulary"])
nE, nC = len(ENGINES), len(CASES)

obs = pd.read_csv(f"{DATA}/observed_samples.csv")
panels = np.load(f"{DATA}/resample_panels.npz")
cal_samp = np.load(f"{DATA}/calibration_samples.npz")
eng = np.load(f"{DATA}/engine_interval_panels.npz")

npz_engines = [str(e) for e in eng["engine_ids"]]
npz_cases = [str(c) for c in eng["case_ids"]]
assert npz_engines == ENGINES and npz_cases == [c["case_id"] for c in CASES]

obs_low, obs_high = eng["observed_low"], eng["observed_high"]      # (9,6)
cal_low, cal_high = eng["calibration_low"], eng["calibration_high"]# (9,6,108)
p2_low, p2_high = eng["probe_panel_02_low"], eng["probe_panel_02_high"]
p3_low, p3_high = eng["probe_panel_03_low"], eng["probe_panel_03_high"]
bl_base, bh_base = eng["baseline_low"], eng["baseline_high"]       # (6,)

# ------------------------------------------------- reproduce baseline CIs ---
alpha = ALPHA / 2.0
baseline_low = np.zeros(nC); baseline_high = np.zeros(nC)
observed_stat = np.zeros(nC)
for c, case in enumerate(CASES):
    cid = case["case_id"]
    vals = obs[obs.case_id == cid].sort_values("observation_id")["value"].to_numpy()
    assert len(vals) == case["n_observations"]
    observed_stat[c] = statistic(vals, case["statistic_name"],
                                 case["statistic_parameters"])
    assert abs(observed_stat[c] - eng["observed_stat"][c]) < 1e-12
    bs = np.array([statistic(vals[idx], case["statistic_name"],
                             case["statistic_parameters"]) for idx in panels[cid]])
    assert len(bs) == case["n_observed_bootstrap"]
    lo, hi = np.quantile(bs, [alpha, 1.0 - alpha])
    baseline_low[c], baseline_high[c] = lo, hi
    assert abs(lo - bl_base[c]) < 1e-9 and abs(hi - bh_base[c]) < 1e-9, cid

# ------------------------------------------------------- coverage targets ---
rep_stats, targets, pooled_targets = [], [], []
for c, case in enumerate(CASES):
    reps = cal_samp[case["case_id"]]
    assert reps.shape == (case["n_calibration_replications"], case["n_observations"])
    rs = np.array([statistic(r, case["statistic_name"],
                             case["statistic_parameters"]) for r in reps])
    rep_stats.append(rs)
    targets.append(rs.mean())                                  # primary (A1)
    pooled_targets.append(statistic(reps.ravel(), case["statistic_name"],
                                    case["statistic_parameters"]))
targets = np.array(targets); pooled_targets = np.array(pooled_targets)
print("[sensitivity] |rep-mean target - pooled target| per case:",
      np.round(np.abs(targets - pooled_targets), 5).tolist())

# ------------------------------------------------------- coverage metrics ---
# Pairing: calibration_low[e,c,r] is the interval issued for calibration
# replication r of case c; coverage = fraction of reps whose replication-level
# target estimate lies inside that replication's interval.
emp_cov = np.zeros((nE, nC)); miss_low = np.zeros((nE, nC)); miss_high = np.zeros((nE, nC))
mean_width = (cal_high - cal_low).mean(axis=2)
nominal = manifest["confidence_level"]
for c in range(nC):
    t = targets[c]
    emp_cov[:, c] = ((t >= cal_low[:, c, :]) & (t <= cal_high[:, c, :])).mean(axis=1)
    miss_low[:, c] = (t < cal_low[:, c, :]).mean(axis=1)
    miss_high[:, c] = (t > cal_high[:, c, :]).mean(axis=1)

coverage_rows = []
for c, case in enumerate(CASES):
    for e in range(nE):
        cov_pen = abs(emp_cov[e, c] - nominal)
        coverage_score = max(0.0, 1.0 - cov_pen - 0.5 * abs(miss_low[e, c] - miss_high[e, c]))
        coverage_rows.append({
            "case_id": case["case_id"], "regime": case["regime"],
            "engine_id": ENGINES[e], "nominal_coverage": nominal,
            "empirical_coverage": emp_cov[e, c], "mean_width": mean_width[e, c],
            "miss_low_rate": miss_low[e, c], "miss_high_rate": miss_high[e, c],
            "n_replications": CASES[c]["n_calibration_replications"],
            "coverage_score": coverage_score})
pd.DataFrame(coverage_rows).to_csv(f"{OUT}/coverage_audit.csv", index=False)

# --------------------------------------------------------- probe families ---
# Constructed diagnostic formulas (finite, larger = worse severity):
#  probe_00  width consistency: | log( observed_width / median(cal_width) ) |
#  probe_01  endpoint centring (aliasing) deviation:
#            | ((low+high)/2 - stat) - ((baseline_low+baseline_high)/2 - stat) |
#  probe_02  perturbation response: |p2_low-obs_low| + |p2_high-obs_high|
#  probe_03  sub-panel dispersion: std_over_6_subpanels(low) + std(high)
#  probe_04  worst-side calibration miss rate: max(miss_low, miss_high)
probe = np.zeros((5, nE, nC))
for c, case in enumerate(CASES):
    ow = obs_high[:, c] - obs_low[:, c]
    med_cw = np.median(cal_high[:, c, :] - cal_low[:, c, :], axis=1)
    probe[0, :, c] = np.abs(np.log(ow / med_cw))
    asym_e = (obs_low[:, c] + obs_high[:, c]) / 2.0 - observed_stat[c]
    asym_b = (bl_base[c] + bh_base[c]) / 2.0 - observed_stat[c]
    probe[1, :, c] = np.abs(asym_e - asym_b)
    probe[2, :, c] = np.abs(p2_low[:, c] - obs_low[:, c]) + np.abs(p2_high[:, c] - obs_high[:, c])
    probe[3, :, c] = p3_low[:, c].std(axis=1) + p3_high[:, c].std(axis=1)
    probe[4, :, c] = np.maximum(miss_low[:, c], miss_high[:, c])
assert np.all(np.isfinite(probe))

probe_rows = []
for f in range(5):
    for c, case in enumerate(CASES):
        col, norm = probe[f, :, c], mm(probe[f, :, c])
        for e in range(nE):
            probe_rows.append({
                "case_id": case["case_id"],
                "probe_family": probe_manifest["probe_families"][f],
                "engine_id": ENGINES[e],
                "diagnostic_value": float(col[e]),
                "diagnostic_score": float(norm[e])})
pd.DataFrame(probe_rows).to_csv(f"{OUT}/probe_audit.csv", index=False)

probe_norm = np.stack([mm(probe[f]) for f in range(5)])   # normalise per family
profile_rows = []
for c, case in enumerate(CASES):
    for e in range(nE):
        profile_rows.append({
            "case_id": case["case_id"], "engine_id": ENGINES[e],
            **{f"probe_signal_{f:02d}": float(probe[f, e, c]) for f in range(5)},
            "profile_score": float(probe_norm[:, e, c].mean())})
pd.DataFrame(profile_rows).to_csv(f"{OUT}/case_probe_profile.csv", index=False)

# ------------------------------------------------------------ engine audit --
width_ratio_pc = (obs_high - obs_low) / (bh_base - bl_base)
cov_gap_pc = np.abs(emp_cov - nominal)
tail_imb_pc = np.abs(miss_low - miss_high)

audit = pd.DataFrame({"engine_id": ENGINES})
audit["coverage_gap"] = cov_gap_pc.mean(axis=1)
audit["tail_imbalance"] = tail_imb_pc.mean(axis=1)
audit["width_ratio"] = width_ratio_pc.mean(axis=1)
audit["case_dispersion"] = cov_gap_pc.std(axis=1, ddof=1)
for f in range(5):
    audit[f"probe_metric_{f:02d}"] = probe[f].mean(axis=1)

penalty_cols = ["coverage_gap", "tail_imbalance", "case_dispersion"] + \
               [f"probe_metric_{f:02d}" for f in range(5)]
penalties = np.column_stack([mm(audit[c].to_numpy()) for c in penalty_cols] +
                            [mm(np.abs(np.log(audit["width_ratio"].to_numpy())))])
audit["engine_score"] = penalties.mean(axis=1)
audit.to_csv(f"{OUT}/engine_audit.csv", index=False)

order = sorted(range(nE), key=lambda e: (audit["engine_score"][e], ENGINES[e]))
ranking = [ENGINES[e] for e in order]
selected_idx, selected_id = order[0], ENGINES[order[0]]
print("engine ranking (most -> least reliable):", ranking)
print("selected engine:", selected_id)

for i in range(nE):   # structural-similarity transparency (no engine relies on row order)
    for j in range(i + 1, nE):
        dlo, dhi = np.abs(obs_low[i] - obs_low[j]).max(), np.abs(obs_high[i] - obs_high[j]).max()
        dw = np.abs((obs_high[i]-obs_low[i]) - (obs_high[j]-obs_low[j])).max()
        if dlo < 1e-9 and dhi < 1e-9:
            print(f"[note] engines {ENGINES[i]}/{ENGINES[j]}: observed intervals exactly equal")
        elif dw < 1e-9:
            print(f"[note] engines {ENGINES[i]}/{ENGINES[j]}: identical widths but "
                  f"endpoints shifted by up to {max(dlo, dhi):.4f} (centring signature)")

# ------------------------------------------------------- failure evidence ---
# Evidence scores: min-max normalised across engines, larger = more evidence.
# reliable_engine uses the inverted composite penalty.  Per engine the label
# with the highest evidence wins; ties broken by vocabulary order.
inv_score = 1.0 - mm(audit["engine_score"].to_numpy())
base_dist = np.array([
    ((np.abs(obs_low[e] - bl_base) + np.abs(obs_high[e] - bh_base)) /
     (bh_base - bl_base)).mean() for e in range(nE)])
discrete_raw = (cov_gap_pc[:, 3] +
                (np.abs(obs_low[:, 3] - bl_base[3]) +
                 np.abs(obs_high[:, 3] - bh_base[3])) / (bh_base[3] - bl_base[3]))
evidence = {
    "reliable_engine": mm(inv_score),
    "baseline_quantile_alias": mm(1.0 - mm(base_dist)),
    "reflection_alias": mm(probe[1].mean(axis=1)),
    "discrete_boundary_mismatch": mm(discrete_raw),
    "shape_correction_mismatch": mm(np.abs(np.log(width_ratio_pc.mean(axis=1)))),
    "scale_response_mismatch": mm(probe[2].mean(axis=1)),
    "noise_amplifying_engine": mm(probe[3].mean(axis=1)),
}
ev_rows, predicted = [], {}
for e in range(nE):
    scores = {lab: float(evidence[lab][e]) for lab in LABELS}
    ranked = sorted(LABELS, key=lambda l: (-scores[l], LABELS.index(l)))
    predicted[ENGINES[e]] = ranked[0]
    for lab in LABELS:
        ev_rows.append({
            "engine_id": ENGINES[e], "failure_label": lab,
            "evidence_score": scores[lab], "label_rank": ranked.index(lab) + 1,
            "is_predicted_label": int(lab == ranked[0])})
pd.DataFrame(ev_rows).to_csv(f"{OUT}/failure_evidence.csv", index=False)

json.dump({"selected_engine_id": selected_id,
           "failure_modes": {eid: predicted[eid] for eid in ENGINES}},
          open(f"{OUT}/failure_modes.json", "w"), indent=2)
json.dump({"selected_engine_id": selected_id,
           "selected_failure_mode": predicted[selected_id],
           "selected_engine_score": float(audit["engine_score"][selected_idx])},
          open(f"{OUT}/selected_engine.json", "w"), indent=2)

# ------------------------------------------------------- interval summary ---
summary_rows = []
for c, case in enumerate(CASES):
    sw = obs_high[selected_idx][c] - obs_low[selected_idx][c]
    summary_rows.append({
        "case_id": case["case_id"], "statistic_name": case["statistic_name"],
        "observed_stat": observed_stat[c], "selected_engine_id": selected_id,
        "selected_low": obs_low[selected_idx][c],
        "selected_high": obs_high[selected_idx][c],
        "baseline_low": bl_base[c], "baseline_high": bh_base[c],
        "selected_width": sw,
        "baseline_width_ratio": sw / (bh_base[c] - bl_base[c])})
pd.DataFrame(summary_rows).to_csv(f"{OUT}/interval_summary.csv", index=False)

# -------------------------------------------------------- family ablation ---
def combined_score(exclude_family=None):
    cols = list(penalty_cols)
    if exclude_family is not None:
        f = probe_manifest["probe_families"].index(exclude_family)
        cols = [c for c in cols if c != f"probe_metric_{f:02d}"]
    pens = np.column_stack([mm(audit[c].to_numpy()) for c in cols] +
                           [mm(np.abs(np.log(audit["width_ratio"].to_numpy())))])
    return pens.mean(axis=1)

ablation_rows = []
for fam in ["none"] + probe_manifest["probe_families"]:
    sc = combined_score(None if fam == "none" else fam)
    o = sorted(range(nE), key=lambda e: (sc[e], ENGINES[e]))
    ablation_rows.append({
        "excluded_probe_family": fam,
        "top_engine_id": ENGINES[o[0]],
        "selected_engine_rank": o.index(selected_idx) + 1,
        "runner_up_engine_id": ENGINES[o[1]],
        "score_margin": max(float(sc[o[1]] - sc[o[0]]), 0.0)})
pd.DataFrame(ablation_rows).to_csv(f"{OUT}/family_ablation.csv", index=False)

# ------------------------------------------------------ reliability report --
case_warnings = {}
for c, case in enumerate(CASES):
    w = []
    if cov_gap_pc[selected_idx, c] > 0.03:
        w.append(f"empirical_coverage_{emp_cov[selected_idx, c]:.3f}"
                 f"_deviates_from_nominal_{nominal:.4f}")
    if tail_imb_pc[selected_idx, c] > 0.10:
        w.append(f"tail_imbalance_{tail_imb_pc[selected_idx, c]:.3f}")
    if abs(width_ratio_pc[selected_idx, c] - 1.0) > 0.10:
        w.append(f"observed_width_ratio_{width_ratio_pc[selected_idx, c]:.3f}")
    case_warnings[case["case_id"]] = w
json.dump({"selected_engine_id": selected_id,
           "aggregate_coverage_gap": float(audit["coverage_gap"][selected_idx]),
           "aggregate_tail_imbalance": float(audit["tail_imbalance"][selected_idx]),
           "aggregate_probe_score": float(probe_norm[:, selected_idx, :].mean()),
           "engine_ranking": ranking,
           "case_warnings": case_warnings},
          open(f"{OUT}/reliability_report.json", "w"), indent=2)

