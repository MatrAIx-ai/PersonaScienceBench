W, H = 1240, 900
img = np.full((H, W, 3), 255, dtype=np.uint8)

def rect(x0, y0, x1, y1, color):
    img[max(y0,0):min(y1,H), max(x0,0):min(x1,W)] = color

def text(x, y, s, color=(20,20,20), scale=2):
    for ch in s.upper():
        g = FONT.get(ch, FONT[' '])
        for r, bits in enumerate(g):
            for b in range(5):
                if bits >> (4 - b) & 1:
                    rect(x + b*scale, y + r*scale, x + (b+1)*scale,
                         y + (r+1)*scale, color)
        x += 6*scale

def draw_bars(x0, y0, w, h, vals, title, colors=None, hline_val=None, fmt="{:.3f}"):
    text(x0, y0-22, title, scale=2)
    vmax = max(vals.max(), 1e-12)
    n = len(vals)
    bw = int(w / n * 0.62)
    gap = (w - bw*n) / max(n-1, 1)
    for i, v in enumerate(vals):
        bh = int(v / vmax * (h-30))
        col = colors[i] if colors is not None else (70,110,180)
        rect(x0 + int(i*(bw+gap)), y0 + h - bh, x0 + int(i*(bw+gap)) + bw,
             y0 + h, col)
        text(x0 + int(i*(bw+gap)) - 6, y0 + h + 8, ENGINES[i][-2:],
             color=(60,60,60), scale=2)
        text(x0 + int(i*(bw+gap)) - 14, y0 + h - bh - 16, fmt.format(v),
             color=(60,60,60), scale=2)
    if hline_val is not None:
        yh = y0 + h - int(hline_val / vmax * (h-30))
        for xx in range(x0, x0+w, 12):
            rect(xx, yh, xx+7, yh+2, (200,30,40))
        text(x0 + w - 150, yh - 20, "NOMINAL", color=(200,30,40), scale=2)

