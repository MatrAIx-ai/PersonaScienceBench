# ---- minimal PNG writer (8-bit RGB, no compression filters beyond 0) ----
def write_png(path, arr):
    hgt, wid = arr.shape[:2]
    raw = b"".join(b"\x00" + arr[y].tobytes() for y in range(hgt))
    def chunk(tag, data):
        c = tag + data
        return len(data).to_bytes(4, "big") + c + zlib.crc32(c).to_bytes(4, "big")
    ihdr = (wid).to_bytes(4,"big") + (hgt).to_bytes(4,"big") + bytes([8, 2, 0, 0, 0])
    png = b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", ihdr) + \
          chunk(b"IDAT", zlib.compress(raw, 6)) + chunk(b"IEND", b"")
    open(path, "wb").write(png)

