def _chunk(tag, data):
    return struct.pack(">I", len(data)) + tag + data + struct.pack(">I", zlib.crc32(tag + data) & 0xFFFFFFFF)

def write_png(path, rgb):
    h, w, _ = rgb.shape
    raw = b"".join(b"\x00" + rgb[i].tobytes() for i in range(h))
    png = (b"\x89PNG\r\n\x1a\n"
           + _chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0))
           + _chunk(b"IDAT", zlib.compress(raw, 9)) + _chunk(b"IEND", b""))
    Path(path).write_bytes(png)


class Canvas:
    def __init__(self, w, h, bg=(255, 255, 255)):
        self.w, self.h = w, h
        self.img = np.zeros((h, w, 3), dtype=np.uint8)
        self.img[:, :] = bg

    def px(self, x, y, c):
        if 0 <= x < self.w and 0 <= y < self.h:
            self.img[y, x] = c

    def rect(self, x0, y0, x1, y1, c):
        for y in range(max(0, y0), min(self.h, y1 + 1)):
            self.img[y, max(0, x0):min(self.w, x1 + 1)] = c

    def line(self, x0, y0, x1, y1, c):
        n = max(abs(x1 - x0), abs(y1 - y0)) + 1
        for i in range(n):
            x = round(x0 + (x1 - x0) * i / (n - 1)) if n > 1 else x0
            y = round(y0 + (y1 - y0) * i / (n - 1)) if n > 1 else y0
            self.px(x, y, c)

    def text(self, x, y, s, c=(0, 0, 0), scale=2):
        cx = x
        for ch in s.upper():
            g = FONT.get(ch, FONT[' '])
            for r in range(5):
                for col in range(3):
                    if g[r * 3 + col] == '1':
                        self.rect(cx + col * scale, y + r * scale,
                                  cx + col * scale + scale - 1, y + r * scale + scale - 1, c)
            cx += 4 * scale
        return cx

    def to_uint8(self):
        return self.img


def panel_frame(cv, x0, y0, w, h, title):
    cv.rect(x0, y0, x0 + w - 1, y0, (60, 60, 60))
    cv.rect(x0, y0 + h - 1, x0 + w - 1, y0 + h - 1, (60, 60, 60))
    cv.rect(x0, y0, x0, y0 + h - 1, (60, 60, 60))
    cv.rect(x0 + w - 1, y0, x0 + w - 1, y0 + h - 1, (60, 60, 60))
    cv.text(x0 + 6, y0 + 6, title, scale=2)


def bar_panel(cv, x0, y0, w, h, title, labels, values, chosen_idx=None,
              fmt="{:.0f}"):
    panel_frame(cv, x0, y0, w, h, title)
    pad, top = 40, 30
    vmin, vmax = min(values), max(values)
    span = (vmax - vmin) or 1.0
    bw = (w - 2 * pad) / len(values)
    for i, v in enumerate(values):
        bh = int((v - vmin) / span * (h - top - 40)) + 2
        x = int(x0 + pad + i * bw + bw * 0.15)
        col = (30, 90, 200) if (chosen_idx is None or i != chosen_idx) else (200, 60, 30)
        cv.rect(x, y0 + h - 40 - bh, x + int(bw * 0.7), y0 + h - 41, col)
        if labels is not None:
            cv.text(x - 2, y0 + h - 34, str(labels[i])[-3:], scale=1)
    cv.text(x0 + pad, y0 + h - 20, fmt.format(vmin), scale=1)
    cv.text(x0 + w - pad - 6 * len(fmt.format(vmax)), y0 + h - 20, fmt.format(vmax), scale=1)


def line_panel(cv, x0, y0, w, h, title, xs, series, fmt="{:.3f}"):
    panel_frame(cv, x0, y0, w, h, title)
    pad, top = 46, 30
    allv = [v for _, s in series for v in s]
    vmin, vmax = min(allv), max(allv)
    span = (vmax - vmin) or 1.0
    def X(x): return int(x0 + pad + (x - xs[0]) / (xs[-1] - xs[0]) * (w - pad - 20))
    def Y(v): return int(y0 + h - 40 - (v - vmin) / span * (h - top - 60))
    colors = [(30, 90, 200), (200, 60, 30)]
    for si, (_, s) in enumerate(series):
        for i in range(len(s) - 1):
            cv.line(X(xs[i]), Y(s[i]), X(xs[i + 1]), Y(s[i + 1]), colors[si % 2])
        for i in range(len(s)):
            cv.rect(X(xs[i]) - 2, Y(s[i]) - 2, X(xs[i]) + 2, Y(s[i]) + 2, colors[si % 2])
    cv.text(x0 + pad, y0 + h - 24, fmt.format(vmin), scale=1)
    cv.text(x0 + w - 60, y0 + h - 24, fmt.format(vmax), scale=1)
    for i in range(len(xs)):
        cv.text(X(xs[i]) - 4, y0 + h - 12, str(xs[i]), scale=1)


def heat_panel(cv, x0, y0, w, h, title, M, fmt="{:.2f}"):
    panel_frame(cv, x0, y0, w, h, title)
    pad, top = 46, 34
    cw = (w - pad - 16) // M.shape[1]; ch = (h - top - 26) // M.shape[0]
    for i in range(M.shape[0]):
        for j in range(M.shape[1]):
            v = float(M[i, j])
            col = (int(255 * (1 - v)), int(255 * (1 - v)), 255 - int(200 * (1 - v)))
            cv.rect(x0 + pad + j * cw, y0 + top + i * ch,
                    x0 + pad + (j + 1) * cw - 1, y0 + top + (i + 1) * ch - 1, col)
        cv.text(x0 + 10, y0 + top + i * ch + ch // 2, str(i), scale=1)
        cv.text(x0 + pad + i * cw + 2, y0 + top - 12, str(i), scale=1)


