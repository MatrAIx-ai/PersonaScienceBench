"""
Stable latent state fitting for long categorical streams.

Model: discrete latent Markov chain ("rows") with categorical emissions.
  vector_a  : stationary distribution over rows (reported; pi0 kept internally)
  matrix_a  : K x K row-stochastic latent transition matrix
  matrix_b  : K x 32 emission distributions
Fitting: Baum-Welch EM implemented from scratch in log-space (NumPy/SciPy only).
An order-free mixture baseline (emission-only latent class model) is also fit,
so the order-dependent claim is tested rather than assumed.
"""
import json
import struct
import zlib
from pathlib import Path

import numpy as np
import pandas as pd
from scipy.cluster.vq import kmeans2

RNG_GLOBAL_SEED = 20260119
DATA = Path("data")
OUT = Path("results")
OUT.mkdir(exist_ok=True)

meta = json.loads((DATA / "metadata.json").read_text())
df = pd.read_csv(DATA / "sequences.csv").sort_values("global_index").reset_index(drop=True)
S = 32
assert sorted(df.symbol.unique()) == list(range(S))
symbol_label_of = dict(zip(df.symbol, df.symbol_label))

streams = []
for sid, g in df.groupby("sequence_id", sort=True):
    streams.append((sid, g.sort_values("position").symbol.to_numpy()))
N_TOTAL = len(df)
print(f"[data] {len(streams)} streams, {N_TOTAL} observations, alphabet {S}", flush=True)


def lse(a, axis=None):
    m = np.max(a, axis=axis, keepdims=True)
    m = np.where(np.isfinite(m), m, 0.0)
    out = np.log(np.sum(np.exp(a - m), axis=axis, keepdims=True)) + m
    return np.squeeze(out, axis=axis) if axis is not None else out.item()


def normalize_rows(m, floor=0.0):
    m = m + floor
    return m / m.sum(axis=-1, keepdims=True)


def stationary_distribution(A):
    p = np.full(A.shape[0], 1.0 / A.shape[0])
    for _ in range(10000):
        p_new = p @ A
        if np.max(np.abs(p_new - p)) < 1e-14:
            p = p_new
            break
        p = p_new
    return p / p.sum()


def forward_backward(log_pi0, log_A, log_B, obs):
    T, K = len(obs), log_pi0.shape[0]
    lb = log_B[:, obs]
    la = np.empty((T, K))
    la[0] = log_pi0 + lb[:, 0]
    lAt = np.ascontiguousarray(log_A.T)
    for t in range(1, T):
        m = (la[t - 1][:, None] + lAt).max(axis=0)
        la[t] = m + np.log(np.exp(la[t - 1][:, None] + lAt - m[None, :]).sum(axis=0)) + lb[:, t]
    ll = lse(la[-1])
    lbeta = np.empty((T, K))
    lbeta[-1] = 0.0
    for t in range(T - 2, -1, -1):
        x = log_A + (lbeta[t + 1] + lb[:, t + 1])[None, :]
        lbeta[t] = x.max(axis=1) + np.log(np.exp(x - x.max(axis=1)[:, None]).sum(axis=1))
    log_gamma = la + lbeta
    log_gamma -= lse(log_gamma, axis=1)[:, None]
    lg = (la[:-1][:, :, None] + log_A[None, :, :]
          + (lbeta[1:] + lb[:, 1:].T)[:, None, :])
    lg2 = lse(lse(lg, axis=2), axis=1)
    lg = lg - lg2[:, None, None]
    xi = np.exp(lg).sum(axis=0)
    return ll, log_gamma, xi


def em_hmm(streams_obs, K, seed, init="random", max_iter=120, tol=1e-4,
           pseudocount=0.01):
    rng = np.random.default_rng(seed)
    if init == "random":
        pi0 = rng.dirichlet(np.ones(K))
        A = normalize_rows(rng.dirichlet(np.ones(K) * 0.5, size=K), floor=1e-3)
        B = normalize_rows(rng.dirichlet(np.ones(S) * 0.5, size=K), floor=1e-3)
    else:  # segment init: cluster fixed windows by symbol histogram
        W = 50
        wins, bounds = [], []
        for obs in streams_obs:
            n0 = 0
            for s in range(0, len(obs) - W + 1, W):
                wins.append(np.bincount(obs[s:s + W], minlength=S) / W)
                n0 += 1
            bounds.append(n0)
        wins = np.array(wins)
        cent, lab = kmeans2(wins, K, minit="++", seed=seed)
        B = np.zeros((K, S)); cnt = np.zeros(K)
        for k in range(K):
            m = lab == k
            cnt[k] = m.sum()
            B[k] = wins[m].sum(axis=0) if m.any() else wins.mean(axis=0)
        B = normalize_rows(B, floor=0.01)
        C = np.full((K, K), 0.5); ofs = 0
        for nw in bounds:
            sl = lab[ofs:ofs + nw].astype(int); ofs += nw
            C += np.bincount(sl[:-1] * K + sl[1:], minlength=K * K).reshape(K, K)
        A = normalize_rows(C)
        pi0 = normalize_rows(cnt + 0.5)
    log_pi0, log_A, log_B = np.log(pi0), np.log(A), np.log(B)
    ll_old, trace = -np.inf, []
    for it in range(max_iter):
        LL = 0.0
        gam_sum, xi_sum, n0 = np.zeros((K, S)), np.zeros((K, K)), np.zeros(K)
        for obs in streams_obs:
            ll, lg, xi = forward_backward(log_pi0, log_A, log_B, obs)
            LL += ll
            g = np.exp(lg)
            for k in range(K):  # bincount: safe with repeated symbols
                gam_sum[k] += np.bincount(obs, weights=g[:, k], minlength=S)
            xi_sum += xi
            n0 += g[0]
        pi0 = normalize_rows(n0 + 1e-6)
        A = normalize_rows(xi_sum, floor=pseudocount / K)
        B = normalize_rows(gam_sum, floor=pseudocount)
        log_pi0, log_A, log_B = np.log(pi0), np.log(A), np.log(B)
        rel = (LL - ll_old) / max(abs(ll_old), 1e-12) if ll_old > -np.inf else 1.0
        trace.append((LL, rel))
        if it > 2 and abs(rel) < tol:
            break
        ll_old = LL
    LL, gammas, seq_ll = 0.0, [], []
    for obs in streams_obs:
        ll, lg, _ = forward_backward(log_pi0, log_A, log_B, obs)
        LL += ll; gammas.append(np.exp(lg)); seq_ll.append(ll)
    return {"K": K, "LL": LL, "pi0": np.exp(log_pi0), "A": np.exp(log_A),
            "B": np.exp(log_B), "gammas": gammas, "trace": trace,
            "seq_ll": seq_ll, "seed": seed, "init": init}


def em_mixture(obs_all, K, seed, max_iter=500, tol=1e-9, pseudocount=0.01):
    rng = np.random.default_rng(seed)
    B = normalize_rows(rng.dirichlet(np.ones(S) * 0.5, size=K), floor=1e-3)
    w = np.full(K, 1.0 / K)
    onehot = np.zeros((S, len(obs_all)))
    onehot[obs_all, np.arange(len(obs_all))] = 1.0
    ll_old, trace = -np.inf, []
    for it in range(max_iter):
        logp = np.log(w)[:, None] + np.log(B)[:, obs_all]
        logg = logp - lse(logp, axis=0)[None, :]
        LL = lse(logp, axis=0).sum()
        g = np.exp(logg)
        w = normalize_rows(g.sum(axis=1) + 1e-8)
        B = normalize_rows(g @ onehot.T, floor=pseudocount)
        rel = (LL - ll_old) / max(abs(ll_old), 1e-12) if ll_old > -np.inf else 1.0
        trace.append((LL, rel))
        if it > 2 and abs(rel) < tol:
            break
        ll_old = LL
    return {"K": K, "LL": LL, "w": w, "B": B, "trace": trace, "seed": seed}


HMM_GRID = [2, 3, 4, 5, 6, 8, 10, 12, 16]
MIX_GRID = [2, 3, 4, 5, 6, 8]
HMM_RESTARTS = 8
MIX_RESTARTS = 4
obs_list = [s for _, s in streams]

candidates, hmm_fits, trace_store = [], {}, {}
for K in HMM_GRID:
    best, traces = None, []
    for r in range(HMM_RESTARTS):
        init = "segment" if r == 0 else "random"
        f = em_hmm(obs_list, K, seed=RNG_GLOBAL_SEED + 1000 * K + r, init=init)
        traces.append(f["trace"])
        if best is None or f["LL"] > best["LL"]:
            best = f
        print(f"[hmm K={K} restart {r} init={init}] LL={f['LL']:.2f}", flush=True)
    hmm_fits[K] = best
    trace_store[K] = traces
    nfree = (K - 1) + K * (K - 1) + K * (S - 1)
    candidates.append({"candidate": f"hmm_k{K}", "model": "hmm", "K": K,
                       "n_free_values": nfree, "objective": best["LL"],
                       "criterion": -2 * best["LL"] + nfree * np.log(N_TOTAL)})
for K in MIX_GRID:
    best = None
    for r in range(MIX_RESTARTS):
        f = em_mixture(np.concatenate(obs_list), K,
                       seed=RNG_GLOBAL_SEED + 7000 + 31 * K + r)
        if best is None or f["LL"] > best["LL"]:
            best = f
    nfree = (K - 1) + K * (S - 1)
    candidates.append({"candidate": f"mix_k{K}", "model": "mixture", "K": K,
                       "n_free_values": nfree, "objective": best["LL"],
                       "criterion": -2 * best["LL"] + nfree * np.log(N_TOTAL)})
    print(f"[mix K={K}] LL={best['LL']:.2f}", flush=True)
cand_df = pd.DataFrame(candidates)


def model_diagnostics(f):
    K = f["K"]
    G = np.concatenate(f["gammas"], axis=0)
    mass = G.mean(axis=0)
    ent = -(G * np.log(np.clip(G, 1e-300, None))).sum(axis=1)
    tvB = max(np.abs(f["B"][i] - f["B"][j]).sum() / 2
              for i in range(K) for j in range(i + 1, K))
    nxt = f["A"] @ f["B"]  # P(next symbol | current row)
    tvN = max(np.abs(nxt[i] - nxt[j]).sum() / 2
              for i in range(K) for j in range(i + 1, K))
    return {"K": K, "min_row_mass": float(mass.min()),
            "n_low_rows": int((mass < 0.01).sum()),
            "mean_weight_entropy": float(ent.mean()),
            "frac_unconfident": float((G.max(axis=1) < 0.8).mean()),
            "min_pair_TV_emission": float(tvB), "min_pair_TV_ordering": float(tvN)}


diag_rows = []
for K in HMM_GRID:
    f = hmm_fits[K]
    d = model_diagnostics(f)
    d["candidate"] = f"hmm_k{K}"
    d["objective"] = f["LL"]
    d["criterion"] = -2 * f["LL"] + ((K - 1) + K * (K - 1) + K * (S - 1)) * np.log(N_TOTAL)
    diag_rows.append(d)
diag_df = pd.DataFrame(diag_rows).sort_values("K").reset_index(drop=True)
diag_df["dLL_vs_prev"] = diag_df["objective"].diff()
print("\n[per-K diagnostics]\n" + diag_df.to_string(index=False), flush=True)


def heldout_oneshot_ll(f):
    """Refit on first 80% of each stream; mean one-step predictive log-prob on last 20%."""
    K = f["K"]
    lp, lA, lB = np.log(f["pi0"]), np.log(f["A"]), np.log(f["B"])
    total_ll, total_n = 0.0, 0
    for obs in obs_list:
        cut = int(0.8 * len(obs))
        tr, te = obs[:cut], obs[cut:]
        for it in range(30):
            L = 0.0
            gs, xs, n0 = np.zeros((K, S)), np.zeros((K, K)), np.zeros(K)
            l2, lg, xi = forward_backward(lp, lA, lB, tr)
            g = np.exp(lg)
            for k in range(K):
                gs[k] += np.bincount(tr, weights=g[:, k], minlength=S)
            xs += xi; n0 += g[0]
            lp = np.log(normalize_rows(n0 + 1e-6))
            lA = np.log(normalize_rows(xs, floor=0.01 / K))
            lB = np.log(normalize_rows(gs, floor=0.01))
        la = lp + lB[:, tr[0]]
        for t in range(cut, len(obs)):
            pred = lse(la[:, None] + lA, axis=0)
            total_ll += lse(pred + lB[:, te[t - cut]])
            la = pred + lB[:, te[t - cut]]
            total_n += 1
    return total_ll / total_n


diag_df["heldout_oneshot_ll"] = [heldout_oneshot_ll(hmm_fits[K]) for K in diag_df["K"]]
print("\n[held-out one-step]\n" + diag_df[["candidate", "objective", "criterion",
      "heldout_oneshot_ll"]].to_string(index=False), flush=True)

# Choice rule (documented): among candidates with min row posterior mass >= 1%
# and pairwise row-emission TV >= 0.05 (nontrivial, non-redundant rows), pick
# the lowest BIC; then confirm with marginal gains, uncertainty, held-out score.
elig = diag_df[(diag_df.min_row_mass >= 0.01) & (diag_df.min_pair_TV_emission >= 0.05)]
src = elig if len(elig) else diag_df
chosen_row = src.loc[src.criterion.idxmin()]
K_CHOSEN = int(chosen_row["K"])
print(f"\n[choice] K = {K_CHOSEN} ({chosen_row['candidate']})", flush=True)


best = hmm_fits[K_CHOSEN]
stat = stationary_distribution(best["A"])
perm = np.argsort(-stat, kind="stable")   # canonical labels: descending stationary weight
A_new = best["A"][np.ix_(perm, perm)]
B_new = best["B"][perm]
stat_new = stat[perm]
pi0_new = best["pi0"][perm]
gammas_new = [g[:, perm] for g in best["gammas"]]

assert np.isfinite(A_new).all() and np.allclose(A_new.sum(1), 1, atol=1e-8)
assert np.isfinite(B_new).all() and np.allclose(B_new.sum(1), 1, atol=1e-8)
assert np.isfinite(stat_new).all() and abs(stat_new.sum() - 1) < 1e-8
print("[check] matrix_a/matrix_b rows sum to 1, vector_a sums to 1: OK", flush=True)

cand_out = cand_df[["candidate", "n_free_values", "objective", "criterion"]].copy()
cand_out["chosen"] = (cand_out.candidate == chosen_row["candidate"]).astype(int)
cand_out.to_csv(OUT / "candidate_summary.csv", index=False)

pd.DataFrame([(i, j, A_new[i, j]) for i in range(K_CHOSEN) for j in range(K_CHOSEN)],
             columns=["row", "column", "value"]).to_csv(OUT / "matrix_a.csv", index=False)
pd.DataFrame([(k, s, symbol_label_of[s], B_new[k, s]) for k in range(K_CHOSEN)
              for s in range(S)],
             columns=["row", "symbol", "symbol_label", "value"]).to_csv(
    OUT / "matrix_b.csv", index=False)
pd.DataFrame({"row": range(K_CHOSEN), "value": stat_new}).to_csv(
    OUT / "vector_a.csv", index=False)

# fit_trace: all independent restarts of the chosen K (cached traces, fixed seeds)
rows = []
for r, tr_r in enumerate(trace_store[K_CHOSEN]):
    for step, (o, rel) in enumerate(tr_r):
        rows.append({"run": r, "step": step, "objective": o, "relative_change": rel})
pd.DataFrame(rows).to_csv(OUT / "fit_trace.csv", index=False)

G_all = np.concatenate(gammas_new, axis=0)  # rows in global_index order
np.save(OUT / "local_weights.npy", G_all.astype(np.float64))
labels = G_all.argmax(axis=1)
pd.DataFrame({"sequence_id": df.sequence_id, "position": df.position,
              "global_index": df.global_index, "label": labels}).to_csv(
    OUT / "local_assignments.csv", index=False)

pd.DataFrame([(i, j, A_new[i, j], stat_new[i] * A_new[i, j], A_new[i, j])
              for i in range(K_CHOSEN) for j in range(K_CHOSEN)],
             columns=["row", "column", "weight", "joint_fraction",
                      "conditional_value"]).to_csv(OUT / "neighbor_summary.csv", index=False)

sd = []
for (sid, obs), g, sll in zip(streams, gammas_new, best["seq_ll"]):
    ent = -(g * np.log(np.clip(g, 1e-300, None))).sum(axis=1).mean()
    lab_seq = g.argmax(axis=1)
    dom = np.bincount(lab_seq, minlength=K_CHOSEN).max() / len(lab_seq)
    sd.append({"sequence_id": sid, "n_positions": len(obs),
               "mean_objective": sll / len(obs), "weight_entropy_mean": ent,
               "dominant_label_fraction": dom})
pd.DataFrame(sd).to_csv(OUT / "stream_diagnostics.csv", index=False)
print("[check] stream diagnostics:\n" + pd.DataFrame(sd).to_string(index=False), flush=True)

np.savez(OUT / "_fit_context.npz",
         A=A_new, B=B_new, stat=stat_new,
         cand_names=np.array(cand_df.candidate, dtype=object),
         cand_obj=cand_df.objective.to_numpy(), cand_bic=cand_df.criterion.to_numpy(),
         cand_model=np.array(cand_df.model, dtype=object),
         dK=diag_df.K.to_numpy(), dObj=diag_df.objective.to_numpy(),
         dBIC=diag_df.criterion.to_numpy(), dLL=diag_df.dLL_vs_prev.to_numpy(),
         dMass=diag_df.min_row_mass.to_numpy(), dEnt=diag_df.mean_weight_entropy.to_numpy(),
         dUnc=diag_df.frac_unconfident.to_numpy(), dTVB=diag_df.min_pair_TV_emission.to_numpy(),
         dTVN=diag_df.min_pair_TV_ordering.to_numpy(), dHO=diag_df.heldout_oneshot_ll.to_numpy(),
         K=K_CHOSEN)
print("[done] core outputs written", flush=True)


