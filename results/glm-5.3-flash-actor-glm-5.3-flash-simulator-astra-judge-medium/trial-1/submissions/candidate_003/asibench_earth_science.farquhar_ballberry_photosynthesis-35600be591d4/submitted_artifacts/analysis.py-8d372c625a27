def main():
    with open("data/leaf_params.json") as f:
        params = json.load(f)
    forcing = pd.read_csv("data/forcing.csv")
    with open("data/test_cases.json") as f:
        cases = json.load(f)

    os.makedirs("results", exist_ok=True)

    # ---- 1. Time series over all forcing rows (sunlit and shaded) ----------
    rows = []
    for _, row in forcing.iterrows():
        sun = coupled_fixed_point(row, params, ci_init=row["co2_pa"], sunlit=True)
        shd = coupled_fixed_point(row, params, ci_init=row["co2_pa"], sunlit=False)
        rows.append({
            "time_hr": row["time_hr"],
            "A_sun": sun["A"], "A_shade": shd["A"],
            "rs_sun": sun["rs"], "rs_shade": shd["rs"],
            "ci_sun": sun["ci"], "ci_shade": shd["ci"],
            "gs_sun": sun["gs"], "gs_shade": shd["gs"],
        })
    fluxes = pd.DataFrame(rows, columns=[
        "time_hr", "A_sun", "A_shade", "rs_sun", "rs_shade",
        "ci_sun", "ci_shade", "gs_sun", "gs_shade"])
    fluxes.to_csv("results/leaf_fluxes.csv", index=False)

    # ---- 2. Single-point cases (iterate from supplied ci_init) -------------
    # forcing_index is 0-based (documented assumption).
    case_rows = []
    for case in cases:
        frow = forcing.iloc[case["forcing_index"]].to_dict()
        sol = coupled_fixed_point(frow, params,
                                  ci_init=case["ci_init_pa"], sunlit=True)
        assert sol["converged"], f"{case['case_id']} did not converge"
        case_rows.append({
            "case_id": case["case_id"],
            "ci_init_pa": case["ci_init_pa"],
            "ci_final_pa": sol["ci"],
            "A_final": sol["A"],
            "rs_final": sol["rs"],
            "n_iterations": sol["n_iterations"],
        })
    case_df = pd.DataFrame(case_rows)
    case_df.to_csv("results/case_convergence.csv", index=False)

    # ---- 3. Diurnal figure --------------------------------------------------
    make_figure(fluxes)

    # ---- 4. Diagnostics ------------------------------------------------------
    print("=== leaf_fluxes.csv diagnostics ===")
    print("rows:", len(fluxes), " NaNs:", int(fluxes.isna().sum().sum()),
          " all finite:", bool(np.isfinite(fluxes.to_numpy()).all()))
    dark = (forcing["par_sun_wm2"] == 0).to_numpy()
    print("night rows:", int(dark.sum()),
          " A_sun night range: [%.6f, %.6f]" % (
              fluxes.A_sun[dark].min(), fluxes.A_sun[dark].max()))
    for c in ["A_sun", "A_shade", "rs_sun", "rs_shade", "ci_sun", "ci_shade",
              "gs_sun", "gs_shade"]:
        print("  %-8s [%.4f, %.4f]" % (c, fluxes[c].min(), fluxes[c].max()))
    resid_max = max(
        coupled_fixed_point(r, params, ci_init=r["co2_pa"], sunlit=s)["residual"]
        for _, r in forcing.iterrows() for s in (True, False))
    print("max |residual| over all time-series solves: %.3e Pa" % resid_max)
    print("\n=== case_convergence.csv ===")
    print(case_df.to_string(index=False))
    print("\nplot backend:", "matplotlib" if HAS_MPL else "PIL fallback")


if __name__ == "__main__":
    main()
