"""
Process-based 3-layer snowpack model (Anderson/Niu-style bulk scheme).

Fixed 3-layer snowpack driven by hourly forcing:
* surface energy balance: (1-alpha)*SW_in + eps*(LW_in - sigma*Ts^4) plus
  bulk-aerodynamic sensible/latent heat (assumed u=2 m/s, RH=80%, neutral);
* interlayer heat conduction with k(rho) (Sturm et al. 1997), fixed ground
  temperature (273.15 K) at the bottom boundary;
* melt/refreeze with latent heat, porosity-based liquid water retention
  (irreducible saturation 0.057), cascade drainage, bottom runoff;
* density: destructive metamorphism toward 250 kg/m3 + overburden
  compaction via a temperature-dependent viscosity;
* snowfall merged into the top layer (layer count fixed at 3).

Mass conservation: snowfall + rain + deposition = dSWE + runoff + sublimation;
the closure residual is printed and annotated on the figure.
"""
import json
import numpy as np
import pandas as pd

RHO_I, RHO_W = 917.0, 1000.0
CI, CW = 2100.0, 4186.0
LF, LS = 334000.0, 2.84e6
SIGMA, KAPPA = 5.670374e-8, 0.98
CP_AIR, R_AIR, G, T0 = 1005.0, 287.05, 9.81, 273.15

WIND, RH, CH = 2.0, 0.80, 1.5e-3          # assumed (absent from forcing)
ALB_MAX, ALB_MIN = 0.85, 0.55
TAU_COLD, TAU_WARM = 10.0, 3.0            # albedo decay days (cold/warm)
T_GROUND = 273.15
RHO_MAX, RHO_DM_MAX, RHO_DM_LIMIT = 550.0, 250.0, 260.0
C_DM, ETA0, A_ETA = 1.0e-6, 5.0e10, 0.08
S_IRR = 0.057                              # irreducible liquid saturation
DT_HOUR = 3600.0


def snow_thermal_conductivity(rho):
    r = np.clip(rho / 1000.0, 0.01, 0.6)
    return np.clip(0.138 - 1.01 * r + 3.233 * r ** 2, 0.02, 2.5)


def q_sat(T, p, over_ice=True):
    tc = T - T0
    e = 6.1115 * np.exp(22.452 * tc / (272.55 + tc)) if over_ice else \
        6.1121 * np.exp(17.502 * tc / (240.97 + tc))
    return 0.622 * max(e, 1e-6) / (p - 0.378 * max(e, 1e-6))


def lwc_max_of(rho, dz):
    return S_IRR * max(1.0 - rho / RHO_I, 0.0) * dz * 1000.0  # mm w.e.


class Snowpack:
    def __init__(self, init):
        L = init["layers"]
        self.n = init["n_layers"]
        self.ice = np.array([l["ice_mm"] for l in L], float)
        self.liq = np.array([l["liq_mm"] for l in L], float)
        self.temp = np.array([l["temp_K"] for l in L], float)
        rho_in = np.array([l["density_kg_m3"] for l in L], float)
        # thickness from mass and density: mass (kg/m2) = mm w.e. numerically,
        # dz = mass / rho  (reproduces the init file exactly; liq = 0 there)
        self.dz = np.array([self.ice[i] / rho_in[i] + self.liq[i] / 1000.0
                            for i in range(self.n)])
        self.rho = (self.ice + self.liq) / self.dz
        self.albedo, self.snow_age = ALB_MAX, 0.0

    def heat_capacity(self):
        return CI * self.ice + CW * self.liq          # J/m2/K

    def swe(self):
        return float(self.ice.sum() + self.liq.sum())

    def sync_thickness(self):
        self.dz = np.maximum((self.ice + self.liq) / self.rho, 1e-4)
        self.rho = (self.ice + self.liq) / self.dz

    def add_precip(self, snow_mm, rain_mm, t_air):
        if snow_mm > 0:
            rho_new = float(np.clip(100.0 + 5.0 * (T0 - t_air), 60.0, 200.0))
            e_old = self.heat_capacity()[0] * (self.temp[0] - T0)
            self.ice[0] += snow_mm
            e_new = e_old + CI * snow_mm * (min(t_air, T0) - T0)
            self.dz[0] += snow_mm / rho_new
            self.rho[0] = (self.ice[0] + self.liq[0]) / self.dz[0]
            self.temp[0] = T0 + e_new / self.heat_capacity()[0]
            self.snow_age, self.albedo = 0.0, ALB_MAX
        if rain_mm > 0:
            e_old = self.heat_capacity()[0] * (self.temp[0] - T0)
            self.liq[0] += rain_mm
            e_new = e_old + CW * rain_mm * (min(t_air, T0 + 1.0) - T0)
            self.temp[0] = T0 + e_new / self.heat_capacity()[0]
            self.sync_thickness()

    def surface_fluxes(self, t_air, p_atm, sw_in, lw_in):
        ts = self.temp[0]
        swnet = (1.0 - self.albedo) * sw_in
        lwnet = KAPPA * (lw_in - SIGMA * ts ** 4)
        rho_a = p_atm / (R_AIR * t_air)
        h = rho_a * CP_AIR * CH * WIND * (t_air - ts)
        qa = RH * q_sat(t_air, p_atm, over_ice=(t_air < T0))
        qs = q_sat(ts, p_atm, over_ice=(ts < T0))
        le = rho_a * LS * CH * WIND * (qa - qs)       # + = deposition
        return swnet + lwnet + h + le, (swnet, lwnet, h, le)

    def apply_surface(self, net, subl, depo, dt):
        """Vapour exchange then net energy on the top layer."""
        if subl > 0:
            m = min(subl, self.liq[0])
            self.liq[0] -= m
            rem = subl - m
            if rem > 0 and self.ice[0] > 0:
                take = min(rem, self.ice[0])
                e = self.heat_capacity()[0] * (self.temp[0] - T0) - CI * take * (self.temp[0] - T0)
                self.ice[0] -= take
                self.temp[0] = T0 + e / self.heat_capacity()[0]
        if depo > 0:
            e_old = self.heat_capacity()[0] * (self.temp[0] - T0)
            self.ice[0] += depo
            self.temp[0] = T0 + e_old / self.heat_capacity()[0]
        self.sync_thickness()
        e = self.heat_capacity()[0] * (self.temp[0] - T0) + net * dt
        self.temp[0] = T0 + e / self.heat_capacity()[0]

    def conduction(self, dt):
        k = snow_thermal_conductivity(self.rho)
        e_gain = np.zeros(self.n)
        for i in range(self.n - 1):
            kh = 2.0 * k[i] * k[i + 1] / (k[i] + k[i + 1])
            f = kh * (self.temp[i + 1] - self.temp[i]) / (0.5 * (self.dz[i] + self.dz[i + 1]))
            e_gain[i] += f * dt
            e_gain[i + 1] -= f * dt
        e_gain[-1] += k[-1] * (T_GROUND - self.temp[-1]) / (0.5 * self.dz[-1]) * dt
        return e_gain

    def phase_change(self, i):
        melt = refz = 0.0
        cap = self.heat_capacity()[i]
        if self.temp[i] > T0:
            excess = cap * (self.temp[i] - T0)
            melt = min(self.ice[i], excess / LF)
            self.ice[i] -= melt
            self.liq[i] += melt
            self.temp[i] = T0
        if self.temp[i] < T0 and self.liq[i] > 0:
            deficit = cap * (T0 - self.temp[i])
            refz = min(self.liq[i], deficit / LF)
            self.liq[i] -= refz
            self.ice[i] += refz
            residual = max(deficit - refz * LF, 0.0)
            self.temp[i] = T0 - residual / self.heat_capacity()[i]
        return melt, refz

    def drainage(self):
        runoff = 0.0
        for i in range(self.n):
            ex = max(self.liq[i] - lwc_max_of(self.rho[i], self.dz[i]), 0.0)
            if ex > 0:
                self.liq[i] -= ex
                if i < self.n - 1:
                    self.liq[i + 1] += ex
                else:
                    runoff = ex
        self.sync_thickness()
        return runoff

    def compact(self, dt):
        new_rho = self.rho.copy()
        overburden = 0.0
        for i in range(self.n):
            p = G * overburden
            overburden += self.ice[i] + self.liq[i]
            r, t = self.rho[i], self.temp[i]
            if r < RHO_DM_LIMIT:
                new_rho[i] += max(C_DM * (RHO_DM_MAX - r) * np.exp(-A_ETA * (T0 - t)) * dt, 0.0)
            new_rho[i] += r * p / (ETA0 * np.exp(A_ETA * (T0 - t))) * dt
        self.rho = np.clip(new_rho, 30.0, RHO_MAX)
        self.sync_thickness()

    def age_albedo(self, t_air):
        tau = TAU_COLD if t_air < T0 else TAU_WARM
        self.snow_age += 1.0 / 24.0
        self.albedo = ALB_MIN + (ALB_MAX - ALB_MIN) * np.exp(-self.snow_age / tau)


