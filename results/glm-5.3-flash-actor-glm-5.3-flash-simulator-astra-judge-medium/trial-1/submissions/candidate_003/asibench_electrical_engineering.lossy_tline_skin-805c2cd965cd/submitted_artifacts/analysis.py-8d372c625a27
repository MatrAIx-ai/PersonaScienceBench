#!/usr/bin/env python3
"""
Transmission-Line Target Prediction (task B3, lossy_tline_skin)
===============================================================

Predict the intrinsic frequency-domain transfer functions H(f) and received pulse
waveforms for three target lines, using the eight calibration lines.

Method (physically-parametric surrogate, validated by leave-one-out)
--------------------------------------------------------------------
Each calibration transfer function is decomposed as

    H_i(f) = exp(-alpha_i(f) * L_i) * exp(+j*phi_i(f)),  phasor convention exp(+j*w*t)

with

    alpha_i(f) = A_i + B_i*sqrt(f) + D_i*f + E_i*f^1.5            [Np/m]
    phi_i(f)   = -w*( L_i*sqrt(L_csv*C_i) + tau_c_i ) - b_i*L_i*sqrt(w) + r_glob(f)

where
  * L_i*sqrt(L_csv*C_i) is the nominal per-line delay from the provided per-length
    L, C (verified: after removing a *global* system delay tau_c ~ 0.40 ns, the
    per-meter delay of every calibration line equals sqrt(L_csv*C) to <1e-3);
  * tau_c is a length-independent reference-plane/system delay with a weak smooth
    length dependence, modelled as tau_c(L) = p0 + p1*L + p2*L^2 (LOO error 2.5 ps);
  * b_i*sqrt(w) is the skin-effect phase dispersion; per-meter coefficient scales
    as (c0 + c1*roughness)/sqrt(w_um) + c2 (LOO rel. error ~6%);
  * r_glob(f) is the residual phase shape, statistically identical for all
    calibration lines (cross-correlation > 0.99): a global frequency-only correction.

Scaling laws fitted across the 8 calibration lines:
    B_i*sqrt(w_um) = const (+-2.5%)  -> skin loss ~ 1/sqrt(width)
    D_i = d0 + d1*roughness          -> superlinear roughness loss
    E_i = e0*roughness               -> f^1.5 roughness term
    A_i = const                      -> small residual loss term
Targets are strict interpolations in (width, roughness, length).

Conventions / assumptions
-------------------------
  * exp(+j*omega*t) phasor convention (confirmed by data: delay -> phase = -w*tau).
  * |H(0)| = 1 (0 dB), phi(0) = 0: calibration |H(0)| ~= 1 for every line (the
    +/-0.1 dB DC values are inconsistent with any DC-loss model -> DC-bin noise;
    the f=0 bin carries no pulse energy).
  * group_delay_s = -d(phase_rad)/d(omega) via numpy.gradient on the same grid --
    numerically identical (3e-13 rel.) to the convention of calibration_transfer.csv.
  * phase_rad is assembled analytically from model components (never unwrapped from
    a principal value): single continuous branch, phi(0)=0, monotonically decreasing.
  * Metric definitions (applied identically to input and output):
      - FWHM: linear interpolation of half-maximum crossings around the peak.
      - peak_delay_s = output_peak_time_s - input_peak_time_s.
      - fwhm_broadening_ratio = output_fwhm_s / input_fwhm_s.
      - energy_ratio = int(v_out^2 dt) / int(v_in^2 dt).
      - tail_asymmetry = (E_after - E_before)/(E_after + E_before), E_after/E_before
        being the energies within +/-2*FWHM(output) around the output peak
        (0 for a symmetric pulse, >0 for a trailing dispersive tail).

Outputs: results/target_transfer.csv, results/target_waveforms.csv,
         results/pulse_metrics.csv (+ results/loo_validation.txt).
"""

import os
import numpy as np
import pandas as pd

DATA = "data"
OUT = "results"
PULSE_BAND_HZ = 5.0e9      # pulse energy ~100% contained below ~5 GHz

os.makedirs(OUT, exist_ok=True)

freq = pd.read_csv(f"{DATA}/frequency_grid.csv")["frequency_hz"].values
omega = 2.0 * np.pi * freq
cal_lines = pd.read_csv(f"{DATA}/calibration_lines.csv")
cal_tr = pd.read_csv(f"{DATA}/calibration_transfer.csv")
tgt_lines = pd.read_csv(f"{DATA}/target_lines.csv")
pulse = pd.read_csv(f"{DATA}/input_pulse.csv")

t = pulse["time_s"].values
v_in = pulse["input_v"].values
N = len(v_in)
V_IN = np.fft.rfft(v_in)
fpos = freq[1:]
sqw = np.sqrt(omega[1:])
band = fpos <= PULSE_BAND_HZ

# --------------------------------------- per-line decomposition of calibration data
DEC = {}
_cmeta = cal_lines.set_index("line_id")
for lid in cal_lines["line_id"]:
    row = _cmeta.loc[lid]
    d = cal_tr[cal_tr.line_id == lid].sort_values("frequency_hz")
    assert np.allclose(d.frequency_hz.values, freq), f"frequency grid mismatch: {lid}"
    L, C, Lc = float(row.length_m), float(row.capacitance_f_per_m), float(row.inductance_h_per_m)
    mag = 10.0 ** (d.magnitude_db.values / 20.0)
    alpha = -np.log(mag) / L                    # Np/m (f=0 row anomalous, excluded from fits)
    phi = d.phase_rad.values
    Bm = np.vstack([omega[1:], sqw, np.ones(len(omega) - 1)]).T
    (a_i, b_i, c_i), *_ = np.linalg.lstsq(Bm, -phi[1:], rcond=None)
    r_res = phi[1:] + Bm @ np.array([a_i, b_i, c_i])
    Pm = np.vstack([np.ones(len(fpos)), np.sqrt(fpos), fpos, fpos ** 1.5]).T
    (A_i, B_i, D_i, E_i), *_ = np.linalg.lstsq(Pm, alpha[1:], rcond=None)
    DEC[lid] = dict(L=L, C=C, Lc=Lc, w=float(row.trace_width_um),
                    rough=float(row.roughness_index),
                    tau_c=a_i - L * np.sqrt(Lc * C), b_pm=b_i / L, r=r_res,
                    A=A_i, B=B_i, D=D_i, E=E_i, alpha=alpha, phi=phi, mag=mag)

LINES = list(DEC)


# ----------------------------------------------------------------- scaling-law fits
def fit_scaling(train):
    m = {}
    y = np.array([DEC[l]["tau_c"] for l in train])
    Lt = np.array([DEC[l]["L"] for l in train])
    X = np.vstack([np.ones(len(y)), Lt, Lt ** 2]).T
    m["tau_c"], *_ = np.linalg.lstsq(X, y, rcond=None)          # tau_c = p0+p1*L+p2*L^2
    yb = np.array([DEC[l]["b_pm"] for l in train])
    ws = np.sqrt([DEC[l]["w"] for l in train])
    rs = np.array([DEC[l]["rough"] for l in train])
    X = np.vstack([1 / ws, rs / ws, np.ones(len(yb))]).T
    m["bpm"], *_ = np.linalg.lstsq(X, yb, rcond=None)           # (c0+c1*rough)/sqrt(w)+c2
    m["A"] = float(np.mean([DEC[l]["A"] for l in train]))
    m["B"] = float(np.mean([DEC[l]["B"] * np.sqrt(DEC[l]["w"]) for l in train]))
    yD = np.array([DEC[l]["D"] for l in train])
    X = np.vstack([np.ones(len(yD)), rs]).T
    m["D"], *_ = np.linalg.lstsq(X, yD, rcond=None)             # D = d0 + d1*rough
    m["E"] = float(np.mean([DEC[l]["E"] / DEC[l]["rough"] for l in train]))
    m["r_glob"] = np.mean([DEC[l]["r"] for l in train], axis=0)
    return m


def predict_alpha(model, w_um, rough):
    B = model["B"] / np.sqrt(w_um)
    D = model["D"][0] + model["D"][1] * rough
    E = model["E"] * rough
    return model["A"] + B * np.sqrt(fpos) + D * fpos + E * fpos ** 1.5


def predict_phase(model, L, w_um, rough, C, Lc):
    tau_c = model["tau_c"][0] + model["tau_c"][1] * L + model["tau_c"][2] * L ** 2
    b = (model["bpm"][0] + model["bpm"][1] * rough) / np.sqrt(w_um) + model["bpm"][2]
    phi = np.zeros(len(freq))
    phi[1:] = -(omega[1:] * (L * np.sqrt(Lc * C) + tau_c) + b * L * sqw) + model["r_glob"]
    return phi


def build_transfer(alpha_pm, phi, L):
    H = np.ones(len(freq), dtype=complex)
    H[1:] = np.exp(-alpha_pm * L) * np.exp(1j * phi[1:])
    return H


# ----------------------------------------------------------------- waveform utilities
def waveform(H):
    return np.fft.irfft(V_IN * H, n=N)


def pulse_metrics(v):
    """FWHM (linear half-max interpolation), peak time, energy, tail asymmetry."""
    i0 = int(np.argmax(v))
    pk = v[i0]
    half = pk / 2.0
    li = i0
    while li > 0 and v[li] >= half:
        li -= 1
    ri = i0
    while ri < len(v) - 1 and v[ri] >= half:
        ri += 1
    t_left = t[li] + (half - v[li]) * (t[li + 1] - t[li]) / (v[li + 1] - v[li])
    t_right = t[ri] + (half - v[ri]) * (t[ri + 1] - t[ri]) / (v[ri + 1] - v[ri])
    fwhm = t_right - t_left
    energy = float(np.trapezoid(v ** 2, t))
    win = 2.0 * fwhm
    m_aft = (t >= t[i0]) & (t <= t[i0] + win)
    m_bef = (t >= t[i0] - win) & (t <= t[i0])
    e_aft = float(np.trapezoid(v[m_aft] ** 2, t[m_aft]))
    e_bef = float(np.trapezoid(v[m_bef] ** 2, t[m_bef]))
    tail = (e_aft - e_bef) / (e_aft + e_bef) if (e_aft + e_bef) > 0 else 0.0
    return dict(peak_time=t[i0], fwhm=fwhm, energy=energy, tail=tail)


# ----------------------------------------------------------------- LOO validation
def loo_validation():
    rows = []
    for held in LINES:
        train = [l for l in LINES if l != held]
        mdl = fit_scaling(train)
        d = DEC[held]
        alpha_p = predict_alpha(mdl, d["w"], d["rough"])
        phi_p = predict_phase(mdl, d["L"], d["w"], d["rough"], d["C"], d["Lc"])
        H_p = build_transfer(alpha_p, phi_p, d["L"])
        H_t = np.ones(len(freq), dtype=complex)
        H_t[1:] = d["mag"][1:] * np.exp(1j * d["phi"][1:])
        dbe = 20 * np.log10(np.abs(H_p[1:])) - 20 * np.log10(d["mag"][1:])
        phie = phi_p[1:] - d["phi"][1:]
        wt = np.abs(V_IN[1:]) ** 2
        wt = wt / wt.sum()
        v_t, v_p = waveform(H_t), waveform(H_p)
        mt, mp = pulse_metrics(v_t), pulse_metrics(v_p)
        rows.append(dict(
            held_line=held,
            mag_rms_dB_pulse_band=np.sqrt(np.mean(dbe[band] ** 2)),
            mag_max_abs_dB_full_band=np.max(np.abs(dbe)),
            phase_rms_rad_energy_weighted=np.sqrt(np.sum(wt * phie ** 2)),
            peak_time_err_ps=(mp["peak_time"] - mt["peak_time"]) * 1e12,
            fwhm_rel_err=(mp["fwhm"] - mt["fwhm"]) / mt["fwhm"],
            energy_ratio_rel_err=(mp["energy"] - mt["energy"]) / mt["energy"],
            tail_asym_err=mp["tail"] - mt["tail"],
            waveform_rms_rel=np.sqrt(np.mean((v_p - v_t) ** 2)) / np.max(np.abs(v_t)),
        ))
    return pd.DataFrame(rows)


loo_df = loo_validation()
loo_txt = loo_df.to_string(index=False, float_format=lambda x: f"{x:.5g}")
means = loo_df.select_dtypes(float).abs().mean()
summary = "Leave-one-out mean absolute errors:\n" + \
          "\n".join(f"  {k}: {v:.5g}" for k, v in means.items())
print("=" * 78)
print("LEAVE-ONE-OUT VALIDATION (model fitted on 7 lines, held-out line predicted)")
print("=" * 78)
print(loo_txt)
print(summary)
with open(f"{OUT}/loo_validation.txt", "w") as fh:
    fh.write("Leave-one-out validation (per held-out calibration line)\n")
    fh.write(loo_txt + "\n\n" + summary + "\n")

# ----------------------------------------------------------------- final model + targets
MODEL = fit_scaling(LINES)

tr_rows, wf_rows, met_rows = [], [], []
in_met = pulse_metrics(v_in)
print("\nInput pulse: FWHM = %.6g s, peak = %.6g V at t = %.6g s"
      % (in_met["fwhm"], v_in.max(), in_met["peak_time"]))

for _, row in tgt_lines.iterrows():
    tid = row["line_id"]
    L = float(row.length_m)
    w_um = float(row.trace_width_um)
    rough = float(row.roughness_index)
    C = float(row.capacitance_f_per_m)
    Lc = float(row.inductance_h_per_m)

    alpha_pm = predict_alpha(MODEL, w_um, rough)
    phi = predict_phase(MODEL, L, w_um, rough, C, Lc)
    H = build_transfer(alpha_pm, phi, L)          # single H used for BOTH outputs

    magnitude_db = 20.0 * np.log10(np.abs(H))
    attenuation = -np.log(np.abs(H)) / L
    attenuation[attenuation == 0.0] = 0.0     # avoid negative zero at DC
    group_delay = -np.gradient(phi, omega)        # exactly -dphi/domega

    tr_rows.append(pd.DataFrame({
        "target_id": tid,
        "frequency_hz": freq,
        "magnitude_db": magnitude_db,
        "phase_rad": phi,
        "group_delay_s": group_delay,
        "attenuation_np_per_m": attenuation,
    }))

    v_out = waveform(H)
    wf_rows.append(pd.DataFrame({
        "target_id": tid,
        "time_s": t,
        "input_v": v_in,
        "output_v": v_out,
    }))

    m = pulse_metrics(v_out)
    met_rows.append(dict(
        target_id=tid,
        input_fwhm_s=in_met["fwhm"],
        output_fwhm_s=m["fwhm"],
        fwhm_broadening_ratio=m["fwhm"] / in_met["fwhm"],
        peak_delay_s=m["peak_time"] - in_met["peak_time"],
        output_peak_time_s=m["peak_time"],
        energy_ratio=m["energy"] / in_met["energy"],
        tail_asymmetry=m["tail"],
    ))
    i5 = np.searchsorted(freq, 5e9)
    print(f"{tid}: L={L:.2f} m, w={w_um:.0f} um, rough={rough:.2f} | "
          f"loss@5GHz={magnitude_db[i5]:.2f} dB, peak@{m['peak_time']*1e9:.3f} ns, "
          f"FWHM={m['fwhm']*1e12:.1f} ps, E_ratio={m['energy']/in_met['energy']:.4f}, "
          f"tail={m['tail']:.4f}")

pd.concat(tr_rows, ignore_index=True).to_csv(f"{OUT}/target_transfer.csv", index=False)
pd.concat(wf_rows, ignore_index=True).to_csv(f"{OUT}/target_waveforms.csv", index=False)
pd.DataFrame(met_rows).to_csv(f"{OUT}/pulse_metrics.csv", index=False)

print("\nWritten: results/target_transfer.csv, results/target_waveforms.csv, "
      "results/pulse_metrics.csv (+ results/loo_validation.txt)")
