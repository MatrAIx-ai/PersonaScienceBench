"""
B3: Hidden Binary-Grid Time Evolution
=====================================
Inferred model: 2D Ising model (J = 1) quenched from an uncorrelated random
state (T = infinity) to T = control = 2.0236 k_B/J, below the 2D Ising critical
temperature Tc = 2/ln(1+sqrt(2)) ~= 2.2692.  Domain coarsening then proceeds
under model-A (non-conserved order parameter) single-spin-flip dynamics.

Dynamics: checkerboard (two-sublattice, deterministic-scan) Metropolis updates
with periodic boundaries.  Time unit = 1 Monte Carlo sweep (one attempted
update of every spin).  RNG: a single np.random.default_rng(dynamics_seed);
draw order is fixed and documented: for each sweep, first sublattice 0 then
sublattice 1, each drawing one uniform (grid_size, grid_size) array.
NOTE: this is a sublattice-parallel scheme, not random-sequential; the growth
amplitude is scheme-dependent while the growth exponent is robust.

The diagnostic figure is rendered with matplotlib when available; if
matplotlib is absent, an equivalent PNG is written by a minimal built-in
renderer (numpy + stdlib zlib/struct only), so the artifact contract always
holds.
"""
import json
import zlib
import struct
import numpy as np

# ----------------------------------------------------------------- inputs ----
with open("data/parameters.json") as fh:
    P = json.load(fh)

L      = int(P["grid_size"])
T      = float(P["control"])          # interpreted as k_B * T / J with J = 1
NSTEP  = int(P["n_steps"])
NSNAP  = int(P["n_snapshots"])
NMEAS  = int(P["n_measurements"])
snap_t = [int(round(t)) for t in P["snapshot_times"]]
meas_t = [int(round(t)) for t in P["measurement_times"]]
MAXR   = int(P["max_r"])
SEED   = int(P["dynamics_seed"])

s = np.load("data/initial_state.npy").astype(np.int8)
assert s.shape == (L, L)

rng = np.random.default_rng(SEED)

def acc_prob_vec(dE):
    """Vectorised Metropolis acceptance: dE <= 0 -> 1; dE > 0 -> exp(-dE/T)."""
    return np.where(dE <= 0, 1.0, np.exp(-np.minimum(dE, 8) / T))

_j, _i = np.meshgrid(np.arange(L), np.arange(L), indexing="ij")
_chess = (_i + _j) & 1                     # checkerboard sublattice labels

def sweep(state):
    """One checkerboard Metropolis sweep; RNG order: sublattice 0 then 1."""
    for par in (0, 1):                     # fixed order, documented
        nb = (np.roll(state, 1, 0) + np.roll(state, -1, 0) +
              np.roll(state, 1, 1) + np.roll(state, -1, 1))
        dE = 2 * state * nb                # dE = 2*J*s_i*sum(neighbors), J = 1
        u = rng.random((L, L))             # one uniform array per sublattice update
        flip = (_chess == par) & ((dE <= 0) | (u < acc_prob_vec(dE)))
        state = np.where(flip, -state, state)
    return state

def energy_per_spin(state):
    return float(-(state * (np.roll(state, 1, 0) + np.roll(state, 1, 1))).sum()) / (L * L)

def magnetization(state):
    return float(state.mean())

# --------------------------------------------- correlation instrumentation ---
_coords = np.arange(L)
_dX = np.where(_coords <= L // 2, _coords, _coords - L)
DX, DY = np.meshgrid(_dX, _dX, indexing="ij")
RADIUS = np.rint(np.sqrt(DX ** 2 + DY ** 2)).astype(int)
shell_masks = [RADIUS == r for r in range(1, MAXR + 1)]

def _connected_norm(c_raw, m2):
    """Connected, normalised correlation: (C(r) - m^2) / (1 - m^2), so that the
    r -> infinity plateau (m^2) maps to 0 and C(0) = 1.  This is the standard
    coarsening diagnostic: the raw C(r) of a phase-ordered finite system sits on
    the m^2 plateau and carries no domain-scale information."""
    denom = 1.0 - m2
    if denom < 1e-9:                       # fully ordered state: no domain signal
        return np.zeros_like(c_raw)
    return (c_raw - m2) / denom

def radial_corr(state):
    """Raw angularly averaged C(r,t), r = 1..max_r, via 2-D FFT minimal-image
    shells (includes the m(t)^2 long-range plateau)."""
    F = np.fft.fft2(state.astype(np.float64))
    G = np.fft.ifft2(F * np.conj(F)).real / (L * L)
    return np.array([G[m].mean() for m in shell_masks])

def axial_corr(state):
    """Raw C_x(r), C_y(r) for r = 0..L-1 (periodic)."""
    cx = np.array([(state * np.roll(state, -r, axis=1)).mean() for r in range(L)])
    cy = np.array([(state * np.roll(state, -r, axis=0)).mean() for r in range(L)])
    return cx, cy

def length_from_corr(c_raw):
    """Domain length: L = first r where the raw correlation C(r) crosses half
    its self-value C(0) = 0.5 (linear interpolation).  If C(r) never drops
    below 0.5 within max_r the correlation sits on the m^2 plateau of a single
    dominant domain: the snapshot is flagged saturated and L is reported as
    max_r (a censored lower bound)."""
    r = np.arange(1, MAXR + 1)
    below = np.where(c_raw < 0.5)[0]
    if len(below) == 0:
        return float(MAXR), True
    i = below[0]
    if i == 0:
        return float(r[0]), False
    r0, r1, c0, c1 = r[i - 1], r[i], c_raw[i - 1], c_raw[i]
    return float(r0 + (0.5 - c0) * (r1 - r0) / (c1 - c0)), False


# --------------------------------------------------------------- main loop ---
snap_set, meas_set = set(snap_t), set(meas_t)
snapshots, seriesA, seriesB = {}, [], []
dense_t, dense_L, dense_sat = [], [], []
for t in range(1, NSTEP + 1):
    s = sweep(s)
    if t in meas_set:
        seriesA.append((float(t), abs(magnetization(s))))
        seriesB.append((float(t), energy_per_spin(s)))
        _cl = length_from_corr(radial_corr(s))
        dense_t.append(float(t)); dense_L.append(_cl[0]); dense_sat.append(_cl[1])
    if t in snap_set:
        snapshots[t] = s.copy()

assert len(seriesA) == NMEAS and len(snapshots) == NSNAP

# ------------------------------------------------------------------ stacks ---
stackC = np.stack([radial_corr(snapshots[t]) for t in snap_t])            # [6, 50]
stackD = np.stack([snapshots[t].mean(axis=0) for t in snap_t])            # [6, 100]
axc = [axial_corr(snapshots[t]) for t in snap_t]
stackE = np.transpose(np.stack([[c[0] for c in axc],
                                [c[1] for c in axc]]), (1, 0, 2)).astype(np.float64)  # [6, 2, 100]

# ------------------------------------------------- length scale + collapse ---
m2_snap = [float(snapshots[t].mean()) ** 2 for t in snap_t]

Ls, saturated = [], []
for k in range(NSNAP):
    Lv, sat = length_from_corr(stackC[k])
    Ls.append(Lv); saturated.append(sat)

use = [k for k in range(NSNAP) if not saturated[k]]    # exclude saturated snapshots
x_lo = max(1.0 / Ls[k] for k in use) if use else 0.0
xgrid = np.linspace(x_lo, 1.0, 60)
gcurves = [_connected_norm(stackC[k], m2_snap[k]) for k in use]
curves = np.array([np.interp(xgrid, np.arange(1, MAXR + 1) / Ls[k], g_)
                   for g_ in gcurves])
if len(use) >= 2:
    master = curves.mean(axis=0)
    rms = float(np.sqrt(((curves - master) ** 2).mean()))
    rng_span = float(master.max() - master.min())
    rel_rms = rms / rng_span if rng_span > 0 else None
    quality = float(np.clip(1.0 - rel_rms, 0.0, 1.0)) if rel_rms is not None else None
    applicable, collapse_grid = True, L
else:
    rel_rms = quality = None
    applicable, collapse_grid = False, 0

# figure renderer availability (decided before notes are finalised)
try:
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt
    RENDERER = "matplotlib"
except ImportError:
    RENDERER = "builtin-png"

# --------------------------------------------------------- metadata and fit ---
tt = np.array(snap_t, dtype=float); LL = np.array(Ls, dtype=float)
fit_idx = [k for k in range(NSNAP) if not saturated[k]]

def ols_fit(idxs):
    """OLS of log L = log A + z log t with manually computed standard error."""
    x = np.log(tt[idxs]); y = np.log(LL[idxs]); n = len(idxs)
    xm, ym = x.mean(), y.mean()
    sxx = ((x - xm) ** 2).sum(); sxy = ((x - xm) * (y - ym)).sum()
    z = float(sxy / sxx); a = float(ym - z * xm)
    yhat = a + z * x
    ss_res = float(((y - yhat) ** 2).sum())
    ss_tot = float(((y - ym) ** 2).sum())
    r2 = 1 - ss_res / ss_tot if ss_tot > 0 else float("nan")
    var_z = ss_res / (n - 2) / sxx if n > 2 else float("nan")
    return z, float(np.sqrt(var_z)), float(np.exp(a)), float(r2)

if len(fit_idx) >= 3:
    z_all, se_all, A_all, r2_all = ols_fit(fit_idx)
    inner = [k for k in fit_idx if k != 0]
    if len(inner) >= 3:
        z_in, se_in, A_in, r2_in = ols_fit(inner)
        if r2_in > r2_all:
            fit_idx, (z, se, A, r2) = inner, (z_in, se_in, A_in, r2_in)
            fit_note = ("earliest snapshot excluded from the fit "
                        "(transient bends the power law; improves r_squared).")
        else:
            z, se, A, r2 = z_all, se_all, A_all, r2_all
            fit_note = "all non-saturated snapshots included in the fit."
    else:
        z, se, A, r2 = z_all, se_all, A_all, r2_all
        fit_note = "all non-saturated snapshots included in the fit."
else:
    z = se = A = r2 = float("nan")
    fit_note = "insufficient non-saturated snapshots for a fit."

fit_range = [float(tt[fit_idx].min()), float(tt[fit_idx].max())]

# robustness check: dense length series at all measurement times (raw definition),
# restricted to the pre-saturation window
_dt = np.array([t for t, sv in zip(dense_t, dense_sat) if not sv])
_dL = np.array([v for v, sv in zip(dense_L, dense_sat) if not sv])
if len(_dt) >= 4:
    _x = np.log(_dt); _y = np.log(_dL); _n = len(_x)
    _xm, _ym = _x.mean(), _y.mean()
    _sxx = ((_x - _xm) ** 2).sum(); _sxy = ((_x - _xm) * (_y - _ym)).sum()
    _z = float(_sxy / _sxx); _a = float(_ym - _z * _xm)
    _yh = _a + _z * _x
    _ssr = float(((_y - _yh) ** 2).sum())
    _r2d = float(1 - _ssr / ((_y - _ym) ** 2).sum())
    _sed = float(np.sqrt(_ssr / (_n - 2) / _sxx))
    dense_txt = ("dense-series robustness check: L(t) at all %d measurement times "
                 "(same raw definition) over the pre-saturation window t in [%d, %d] "
                 "gives z = %.4f +/- %.4f (r_squared = %.4f)." %
                 (_n, _dt[0], _dt[-1], _z, _sed, _r2d))
else:
    dense_txt = "dense measurement-time length series too short for a robustness fit."
sat_note = ("late-time length scale reaches within 10% of max_r (finite-size "
            "saturation); affected snapshots flagged and excluded from collapse/fit."
            if any(saturated) else
            "no snapshot shows finite-size saturation (L(t) stays well below max_r = %d)." % MAXR)

notesA = [
    "Model: 2D Ising (J=1), checkerboard (two-sublattice, deterministic-scan) "
    "Metropolis single-spin-flip dynamics, periodic boundaries; time unit = 1 MC sweep.",
    "control interpreted as reduced temperature k_B*T/J = 2.0236 < Tc = 2/ln(1+sqrt(2)) "
    "= 2.2692 (T/Tc = 0.892), i.e. a subcritical quench -> domain coarsening.",
    "Update scheme is sublattice-parallel, not random-sequential; the growth amplitude "
    "is scheme-dependent while the growth exponent is robust to this choice.",
    "All stochastic updates drawn from np.random.default_rng(dynamics_seed); fixed draw "
    "order: per sweep, sublattice 0 then sublattice 1, one uniform (grid_size, grid_size) array each.",
    "stackC = RAW angularly averaged correlation C(r,t) = <s(x)s(x+r)>, r = 1..max_r, "
    "from 2-D FFT with minimal-image shells; stackE = raw axial correlations along "
    "x and y, r = 0..grid_size-1. The raw correlation of a phase-ordered finite "
    "system carries the m(t)^2 long-range plateau, so the connected normalised form "
    "g(r,t) = (C(r,t) - m(t)^2) / (1 - m(t)^2) is derived internally for the "
    "domain-scale diagnostics (g(0,t) = 1 by construction).",
    "Length scale L(t) = first r where the RAW correlation C(r,t) crosses 0.5 "
    "(half-height definition, linear interpolation).",
    "Finite-size check: " + sat_note,
    "Saturation criterion: a snapshot is flagged saturated when its raw correlation "
    "never drops below 0.5 within max_r, i.e. the system has coarsened into a single "
    "dominant domain and the true length scale exceeds the resolvable window "
    "(reported L = max_r is then a censored lower bound).",
    "Definition sensitivity: a connected-correlation crossing "
    "(g = (C - m^2)/(1 - m^2), g = 0.5) gives a similar length at early times but "
    "becomes noise-dominated once m(t)^2 is appreciable (division by 1 - m(t)^2 "
    "amplifies thermal-droplet correlations), so the raw half-height definition "
    "is used throughout.",
    "Collapse curves: connected g(r,t) vs x = r/L(t) interpolated onto a common grid "
    "[%.3f, %.3f]; relative RMS spread = RMS deviation about the mean master curve "
    "divided by the master curve's dynamic range; collapse_quality = 1 - relative_rms_spread, "
    "clipped to [0,1]." % (xgrid[0], xgrid[-1]),
    "stackD = column-averaged magnetization profile m(x) per snapshot.",
    "Figure renderer used: %s (matplotlib when available)." % RENDERER,
]
metadataA = {
    "collapse_check_applicable": bool(applicable),
    "collapse_quality": quality,
    "collapse_relative_rms_spread": rel_rms,
    "collapse_dimension": 2,
    "collapse_snapshot_times": [float(snap_t[k]) for k in use] if applicable else [],
    "collapse_lengths": [float(Ls[k]) for k in use] if applicable else [],
    "collapse_x_range": [float(xgrid[0]), float(xgrid[-1])] if applicable else [0.0, 0.0],
    "collapse_grid_size": int(collapse_grid),
    "notes": notesA,
}

fit_range_s = "[%.1f, %.1f]" % (fit_range[0], fit_range[1])
notesB = [
    "Fit: log L(t) = log A + z log t via ordinary least squares on the snapshot "
    "length scales L(t) (raw half-height crossing definition) from stackC.",
    "Fit range %s uses only non-saturated snapshots: %s" % (fit_range_s, fit_note),
    dense_txt,
    "The fit uses the same length values reported in metadataA.collapse_lengths, "
    "keeping the two metadata files mutually consistent.",
    "Model-A (non-conserved order parameter) coarsening predicts z = 1/2; deviations "
    "reflect finite-time/finite-size corrections and the L-definition threshold.",
    "Amplitude is scheme-dependent (checkerboard Metropolis), exponent is robust.",
    "RNG: np.random.default_rng(dynamics_seed), fixed documented draw order.",
]
metadataB = {
    "exponent": z,
    "exponent_std_error": se,
    "amplitude": A,
    "fit_range": fit_range,
    "r_squared": r2,
    "notes": notesB,
}

# ------------------------------------------------------------------ outputs --
np.save("seriesA.npy", np.array(seriesA, dtype=np.float64).T)   # [2, 170]
np.save("seriesB.npy", np.array(seriesB, dtype=np.float64).T)   # [2, 170]
np.save("stackC.npy", stackC.astype(np.float64))
np.save("stackD.npy", stackD.astype(np.float64))
np.save("stackE.npy", stackE.astype(np.float64))
with open("metadataA.json", "w") as fh:
    json.dump(metadataA, fh, indent=2)
with open("metadataB.json", "w") as fh:
    json.dump(metadataB, fh, indent=2)

# ------------------------------------------------------- data for the figure --
sa = np.array(seriesA); sb = np.array(seriesB)
r_axis = np.arange(1, MAXR + 1)
fi = np.array(fit_idx, dtype=int)
resid = np.log(LL[fi]) - (np.log(A) + z * np.log(tt[fi]))

if RENDERER == "matplotlib":
    fig = plt.figure(figsize=(14, 12))
    gs = fig.add_gridspec(3, 6, height_ratios=[1.1, 1.0, 1.0],
                          hspace=0.55, wspace=0.5)
    for k, t in enumerate(snap_t):
        axm = fig.add_subplot(gs[0, k])
        axm.imshow(snapshots[t], cmap="gray", vmin=-1, vmax=1)
        axm.set_title("t = %d" % t, fontsize=9)
        axm.set_xticks([]); axm.set_yticks([])
    axA = fig.add_subplot(gs[1, 0:2]); axB = fig.add_subplot(gs[1, 2:4])
    axC = fig.add_subplot(gs[1, 4:6]); axX = fig.add_subplot(gs[2, 0:2])
    axF = fig.add_subplot(gs[2, 2:4]); axR = fig.add_subplot(gs[2, 4:6])
    axA.loglog(sa[0], sa[1], ".-"); axA.set_xlabel("t"); axA.set_ylabel("|m|")
    axA.set_title("seriesA: |magnetization|", fontsize=10)
    axB.semilogx(sb[0], sb[1], ".-"); axB.set_xlabel("t"); axB.set_ylabel("E/N")
    axB.set_title("seriesB: energy per spin", fontsize=10)
    for k, t in enumerate(snap_t):
        axC.plot(r_axis, stackC[k], label="t=%d" % t)
    axC.set_xlabel("r"); axC.set_ylabel("C(r,t)")
    axC.set_title("radial correlation", fontsize=10); axC.legend(fontsize=7)
    for k in use:
        axX.plot(r_axis / Ls[k], _connected_norm(stackC[k], m2_snap[k]), ".")
    axX.set_xlabel("r / L(t)"); axX.set_ylabel("C(r,t)")
    ttl = "collapse (quality = %.3f)" % quality if quality is not None else "collapse"
    axX.set_title(ttl, fontsize=10)
    axF.loglog(tt, LL, "o", label="L(t)")
    xx = np.logspace(np.log10(fit_range[0]), np.log10(fit_range[1]), 50)
    axF.loglog(xx, A * xx ** z, "-", label="fit: z = %.3f +/- %.3f" % (z, se))
    axF.set_xlabel("t"); axF.set_ylabel("L(t)"); axF.legend(fontsize=8)
    axF.set_title("domain growth", fontsize=10)
    axR.axhline(0, color="k", lw=0.5)
    axR.plot(tt[fi], resid, "o")
    axR.set_xlabel("t"); axR.set_ylabel("log L residual")
    axR.set_title("fit residuals (r^2 = %.4f)" % r2, fontsize=10)
    fig.suptitle("B3: 2D Ising quench, T = %.4f (checkerboard Metropolis), seed = %d"
                 % (T, SEED), fontsize=12)
    fig.savefig("figure.png", dpi=130, bbox_inches="tight")
else:
    _render_fallback = True   # see built-in renderer below

if RENDERER != "matplotlib":
    # ------- minimal built-in renderer: numpy raster + stdlib zlib/struct PNG --
    _F = {  # 3x5 bitmap font, 15 bits per glyph, rows top->bottom, MSB left
        '0':0b111101101101111,'1':0b010110010010111,'2':0b111001111100111,
        '3':0b111001011001111,'4':0b101101111001001,'5':0b111100111001111,
        '6':0b111100111101111,'7':0b111001001010010,'8':0b111101111101111,
        '9':0b111101111001111,'A':0b010101111101101,'B':0b110101110101110,
        'C':0b011100100100011,'D':0b110101101101110,'E':0b111100111100111,
        'F':0b111100111100100,'G':0b011100101101011,'H':0b101101111101101,
        'I':0b111010010010111,'J':0b001001001101010,'K':0b101110100110101,
        'L':0b100100100100111,'M':0b101111111101101,'N':0b110101101101101,
        'O':0b111101101101111,'P':0b111101111100100,'Q':0b111101101111001,
        'R':0b111101110101101,'S':0b011100010001110,'T':0b111010010010010,
        'U':0b101101101101111,'V':0b101101101101010,'W':0b101101111111101,
        'X':0b101101010101101,'Y':0b101101010010010,'Z':0b111001010100111,
        '=':0b000111000111000,'-':0b000000111000000,'.':0b000000000000010,
        '/':0b001001010100100,'(':0b010100100100010,')':0b010001001001010,
        '+':0b000010111010000,',':0b000000000010100,':':0b000010000010000,
        '^':0b010101000000000,'%':0b101001010100101,'|':0b010010010010010,
        ' ':0b000000000000000}
    def _txt(img, x, y, s, sc=2, col=(0, 0, 0)):
        for ch in s.upper():
            g = _F.get(ch, _F[' '])
            for rr in range(5):
                for cc in range(3):
                    if (g >> (14 - 3 * rr - cc)) & 1:
                        yy = y + rr * sc; xx = x + cc * sc
                        img[yy:yy + sc, xx:xx + sc] = col
            x += 4 * sc
    def _line(img, x0, y0, x1, y1, col):
        n = int(max(abs(x1 - x0), abs(y1 - y0))) + 1
        xs = np.round(np.linspace(x0, x1, n)).astype(int)
        ys = np.round(np.linspace(y0, y1, n)).astype(int)
        ok = (ys >= 0) & (ys < img.shape[0]) & (xs >= 0) & (xs < img.shape[1])
        img[ys[ok], xs[ok]] = col
    def _rect(img, x0, y0, x1, y1, col):
        _line(img, x0, y0, x1, y0, col); _line(img, x1, y0, x1, y1, col)
        _line(img, x0, y1, x1, y1, col); _line(img, x0, y0, x0, y1, col)

    PAL = [(30, 60, 220), (200, 30, 30), (30, 150, 60), (200, 30, 200),
           (235, 130, 20), (110, 40, 180)]
    W, H = 1560, 1240
    img = np.full((H, W, 3), 255, np.uint8)
    _txt(img, 20, 8, "B3: 2D ISING QUENCH  T=%.4f  CHECKERBOARD METROPOLIS  SEED=%d  "
         "L(T) VALUES: %s" % (T, SEED, ",".join("%.1f" % v for v in Ls)), 2, (0, 0, 0))
    # row 1: the six sampled states
    for k, t in enumerate(snap_t):
        g = np.where(snapshots[t] > 0, 235, 25).astype(np.uint8)
        big = np.kron(g, np.ones((2, 2), np.uint8))
        x0 = 30 + k * 250; y0 = 50
        img[y0:y0 + 200, x0:x0 + 200] = np.stack([big] * 3, -1)
        _txt(img, x0 + 60, y0 + 208, "T=%d" % t, 2, (0, 0, 0))

    def _panel(x0, y0, x1, y1, series, logx, logy, title, xlab, ylab, hline=None):
        ax0, ay0, ax1, ay1 = x0 + 55, y0 + 14, x1 - 12, y1 - 34
        kept = []
        for xs_, ys_, col_ in series:
            m_ = np.ones(len(xs_), bool)
            if logx: m_ &= np.asarray(xs_) > 0
            if logy: m_ &= np.asarray(ys_) > 0
            kept.append((np.asarray(xs_, float)[m_], np.asarray(ys_, float)[m_], col_))
        kept = [k for k in kept if len(k[0])]
        if not kept:
            kept = [([1.0], [1.0], (0, 0, 0))]
        series = kept
        allx = np.concatenate([sv[0] for sv in series])
        ally = np.concatenate([sv[1] for sv in series])
        fx = np.log10 if logx else (lambda v: v)
        fy = np.log10 if logy else (lambda v: v)
        xmin, xmax = fx(allx).min(), fx(allx).max()
        ymin, ymax = fy(ally).min(), fy(ally).max()
        if xmax - xmin < 1e-12: xmax = xmin + 1
        if ymax - ymin < 1e-12: ymax = ymin + 1
        px = 0.05 * (xmax - xmin); py = 0.08 * (ymax - ymin)
        xmin -= px; xmax += px; ymin -= py; ymax += py
        if hline is not None:
            ymin = min(ymin, fy(hline) - py); ymax = max(ymax, fy(hline) + py)
        def mx(v): return ax0 + (fx(v) - xmin) / (xmax - xmin) * (ax1 - ax0)
        def my(v): return ay1 - (fy(v) - ymin) / (ymax - ymin) * (ay1 - ay0)
        _rect(img, ax0, ay0, ax1, ay1, (0, 0, 0))
        for v, side in ((xmin, 0), (0.5 * (xmin + xmax), 1), (xmax, 2)):
            xv = 10 ** v if logx else v
            xx_ = int(round(ax0 + side * (ax1 - ax0) / 2)) if side != 0 or True else 0
            xx_ = int(round(ax0 + (v - xmin) / (xmax - xmin) * (ax1 - ax0)))
            _line(img, xx_, ay1, xx_, ay1 + 4, (0, 0, 0))
            _txt(img, xx_ - 8, ay1 + 8, "%.3g" % xv, 1, (0, 0, 0))
        for v, side in ((ymin, 0), (0.5 * (ymin + ymax), 1), (ymax, 2)):
            yv = 10 ** v if logy else v
            yy_ = int(round(ay1 - (v - ymin) / (ymax - ymin) * (ay1 - ay0)))
            _line(img, ax0 - 4, yy_, ax0, yy_, (0, 0, 0))
            _txt(img, ax0 - 40, yy_ - 3, "%.3g" % yv, 1, (0, 0, 0))
        _txt(img, int((ax0 + ax1) / 2 - 6 * len(xlab)), y1 - 12, xlab, 2, (0, 0, 0))
        _txt(img, x0 + 4, y0 + 2, title, 2, (0, 0, 0))
        if hline is not None:
            _line(img, ax0, int(round(my(hline))), ax1, int(round(my(hline))), (0, 0, 0))
        for xs, ys, col in series:
            pts = list(zip(xs, ys))
            for (xa, ya), (xb, yb) in zip(pts[:-1], pts[1:]):
                _line(img, int(round(mx(xa))), int(round(my(ya))),
                      int(round(mx(xb))), int(round(my(yb))), col)
            for xa, ya in pts:
                xx_, yy_ = int(round(mx(xa))), int(round(my(ya)))
                img[max(yy_ - 1, 0):yy_ + 2, max(xx_ - 1, 0):xx_ + 2] = col

    # row 2
    _panel(30, 300, 520, 570, [(sa[0], sa[1], PAL[0])], True, True,
           "SERIESA: |MAGNETIZATION|", "T", "|M|")
    _panel(550, 300, 1040, 570, [(sb[0], sb[1], PAL[1])], True, False,
           "SERIESB: ENERGY PER SPIN", "T", "E/N")
    _panel(1070, 300, 1540, 570,
           [(r_axis.astype(float), stackC[k], PAL[k]) for k in range(NSNAP)],
           False, False, "RADIAL CORRELATION", "R", "C(R,T)")
    # row 3
    _panel(30, 610, 520, 880,
           [(r_axis.astype(float) / Ls[k],
             _connected_norm(stackC[k], m2_snap[k]), PAL[k]) for k in use],
           False, False,
           ("COLLAPSE: G(R,T) VS R/L(T)  (Q=%.3f)" % quality
            if quality is not None else "COLLAPSE: G(R,T) VS R/L(T)"), "R/L(T)", "C")
    xx = np.logspace(np.log10(fit_range[0]), np.log10(fit_range[1]), 60)
    _panel(550, 610, 1040, 880,
           [(tt, LL, PAL[0]), (xx, A * xx ** z, (0, 0, 0))], True, True,
           "DOMAIN GROWTH: Z=%.3f+/-%.3f" % (z, se), "T", "L(T)")
    _panel(1070, 610, 1540, 880, [(tt[fi], resid, PAL[1])], True, False,
           "FIT RESIDUALS (R^2=%.4f)" % r2, "T", "LOG L RES", hline=0.0)
    # PNG encoding (stdlib zlib/struct only)
    raw = b"".join(b"\x00" + img[y].tobytes() for y in range(H))
    def _chunk(tag, data):
        return (struct.pack(">I", len(data)) + tag + data +
                struct.pack(">I", zlib.crc32(tag + data) & 0xFFFFFFFF))
    with open("figure.png", "wb") as fh:
        fh.write(b"\x89PNG\r\n\x1a\n" +
                 _chunk(b"IHDR", struct.pack(">IIBBBBB", W, H, 8, 2, 0, 0, 0)) +
                 _chunk(b"IDAT", zlib.compress(raw, 6)) + _chunk(b"IEND", b""))

