"""
Shared-mode recovery from complex response curves.

Model:  R_m(x) = a0_m + sum_{k=1..K} a_{mk} / (1 + (i*x*tau_k)^phi_k)
  - (tau_k, phi_k) shared across the 5 curves; a0_m and a_{mk} >= 0 per curve.
  - Noise: complex Gaussian, equal variance on re/im (justified by inspection:
    residual stds re 0.054-0.072 vs im 0.054-0.071) -> unweighted LS on the
    stacked re/im residuals is the maximum-likelihood fit.

Method: variable projection. For fixed (tau, phi) the per-curve linear
parameters [a0_m, a_m1..a_mK] are solved exactly with bounded linear least
squares (a0 free, amplitudes >= 0, scipy.optimize.lsq_linear); the profiled
SSE is minimized over the 2K nonlinear parameters (log10 tau, phi) with
scipy.optimize.least_squares under multistart. K selected by BIC with a
held-out-likelihood cross-check and an amplitude-negligibility guard.
Stability: perturbed refits + tau clustering, bootstrap over grid points,
leave-one-curve-out refits.

Outputs: results/modes.csv (header "tau,a_0,...,a_4", modes sorted by tau
ascending), plus a diagnostic report on stdout and results/fit_report.txt.
"""
import os
import numpy as np
from scipy.optimize import lsq_linear, least_squares

RNG = np.random.default_rng(42)
DATA = "data/curves.csv"
OUT_DIR = "results"
PHI_LO, PHI_HI = 0.05, 1.0
U_LO, U_HI = -5.0, 4.0          # bounds on log10(tau)
HALF_PI = np.pi / 2

# ----------------------------------------------------------------- data
def load_data(path=DATA):
    d = np.genfromtxt(path, delimiter=",", names=True)
    cids = sorted(int(c) for c in np.unique(d["curve"]))
    x = None
    X = {}
    for c in cids:
        s = d[d["curve"].astype(int) == c]
        X[c] = (s["x"], s["re"], s["im"])
        if x is None:
            x = s["x"]
        assert np.allclose(s["x"], x), "grids differ between curves"
    return cids, x, X

# ------------------------------------------------------- model machinery
def mode_columns(x, u, phi):
    """Real design columns for one mode: returns (Ref, Imf)."""
    zt = (x * 10.0**u) ** phi
    c = np.cos(phi * HALF_PI)
    s = np.sin(phi * HALF_PI)
    D = 1.0 + 2.0 * zt * c + zt * zt
    return (1.0 + zt * c) / D, -zt * s / D

def design(x, params, K):
    """Return (A_re, A_im): re block [1, Re f_1..Re f_K];
    im block [Im f_1..Im f_K] (no a0 column: Im(a0)=0)."""
    u = params[:K]; phi = params[K:]
    re_cols = [np.ones_like(x)]
    im_cols = [np.zeros_like(x)]   # a0 slot unused for im (kept for alignment)
    for k in range(K):
        r, i = mode_columns(x, u[k], phi[k])
        re_cols.append(r); im_cols.append(i)
    return np.column_stack(re_cols), np.column_stack(im_cols)

def solve_linear(A_re, A_im, yre, yim):
    """Bounded LS: a0 free, mode amplitudes >= 0. Returns [a0, a_1..a_K]."""
    K = A_re.shape[1] - 1
    A2 = np.vstack([A_re, A_im])
    y2 = np.concatenate([yre, yim])
    lb = np.concatenate([[-np.inf], np.zeros(K)])
    ub = np.full(K + 1, np.inf)
    sol = lsq_linear(A2, y2, bounds=(lb, ub), method="trf", tol=1e-12)
    return sol.x

def make_point_residual(x, yre, yim, K, active):
    def resid(params):
        A_re, A_im = design(x, params, K)
        out = []
        for m in active:
            a = solve_linear(A_re, A_im, yre[m], yim[m])
            out.append(A_re @ a - yre[m])
            out.append(A_im @ a - yim[m])
        return np.concatenate(out)
    return resid

def fit_once(x, yre, yim, K, u0, phi0, active, max_nfev=400):
    p0 = np.concatenate([np.clip(u0, U_LO, U_HI), np.clip(phi0, PHI_LO, PHI_HI)])
    p0[:K] = np.sort(p0[:K])                  # keep taus ordered
    lo = np.concatenate([np.full(K, U_LO), np.full(K, PHI_LO)])
    hi = np.concatenate([np.full(K, U_HI), np.full(K, PHI_HI)])
    res = least_squares(make_point_residual(x, yre, yim, K, active), p0,
                        bounds=(lo, hi), xtol=1e-10, ftol=1e-10,
                        gtol=1e-10, max_nfev=max_nfev)
    return res

def random_start(K, rng, seeded=None):
    if seeded is not None:
        s = list(np.array(seeded)[:K])
        while len(s) < K:                      # pad if K exceeds seed list
            s.append(rng.uniform(U_LO + 0.5, U_HI - 0.5))
        u = np.sort(np.array(s)) + rng.normal(0, 0.4, K)
    else:
        grid = np.arange(U_LO + 0.5, U_HI - 0.5, 0.5)
        u = rng.choice(grid, size=K, replace=False) + rng.normal(0, 0.15, K)
    phi = rng.uniform(0.3, 1.0, K)
    return np.sort(u), phi

def multistart_fit(x, yre, yim, K, active, n_starts, rng, seed_taus=None):
    best = None
    for i in range(n_starts):
        if i == 0 and seed_taus is not None:
            s = list(np.array(seed_taus)[:K])
            while len(s) < K:
                s.append(rng.uniform(U_LO + 0.5, U_HI - 0.5))
            u0 = np.sort(np.array(s))
            phi0 = np.full(K, 0.6)
        elif seed_taus is not None and i < n_starts // 3:
            u0, phi0 = random_start(K, rng, seeded=seed_taus)
        else:
            u0, phi0 = random_start(K, rng)
        try:
            r = fit_once(x, yre, yim, K, u0, phi0, active)
        except Exception:
            continue
        if best is None or r.cost < best.cost:
            best = r
    return best

def extract(x, yre, yim, params, K, curves):
    """Per-curve amplitudes and fitted model for given nonlinear params."""
    A_re, A_im = design(x, params, K)
    amps, models = {}, {}
    for m in curves:
        a = solve_linear(A_re, A_im, yre[m], yim[m])
        amps[m] = a
        models[m] = (A_re @ a, A_im @ a)   # (predicted re, predicted im)
    return amps, models

# ------------------------------------------------------------------ main
def main():
    cids, x, X = load_data()
    curves = cids
    yre = {m: X[m][1] for m in curves}
    yim = {m: X[m][2] for m in curves}
    n_pts = len(x)
    N = len(curves) * n_pts * 2                 # real datapoints

    # |im| hump-based seeds (from inspection): x_peak ~ 0.03, ~0.8, ~50, ~320
    seed_taus = np.log10(np.array([1/0.032, 1/0.8, 1/50.0, 1/320.0, 1/0.008]))

    report = []
    def rep(s):
        print(s); report.append(s)

    rep("=" * 72)
    rep("K selection: multistart variable-projection fits, BIC + held-out check")
    rep("=" * 72)

    idx_all = np.arange(n_pts)
    tr = idx_all[idx_all % 2 == 0]
    ho = idx_all[idx_all % 2 == 1]

    results = {}
    starts_budget = {1: 40, 2: 60, 3: 80, 4: 120, 5: 120, 6: 80}
    for K in range(1, 7):
        ns = starts_budget[K]
        r_full = multistart_fit(x, yre, yim, K, curves, ns, RNG, seed_taus)
        amps, models = extract(x, yre, yim, r_full.x, K, curves)
        sse = 2.0 * r_full.cost
        p = 2 * K + len(curves) * (K + 1)
        bic = N * np.log(sse / N) + p * np.log(N)

        r_tr = multistart_fit(x[tr], {m: yre[m][tr] for m in curves},
                              {m: yim[m][tr] for m in curves},
                              K, curves, max(20, ns // 3), RNG, seed_taus)
        amps_tr, _ = extract(x[tr], {m: yre[m][tr] for m in curves},
                             {m: yim[m][tr] for m in curves}, r_tr.x, K, curves)
        sse_ho = 0.0
        A_re_ho, A_im_ho = design(x[ho], r_tr.x, K)
        for m in curves:
            sse_ho += (np.sum((A_re_ho @ amps_tr[m] - yre[m][ho])**2)
                       + np.sum((A_im_ho @ amps_tr[m] - yim[m][ho])**2))

        amin = min(np.max(amps[m][1:]) for m in curves)
        taus = 10.0 ** np.sort(r_full.x[:K])
        order = np.argsort(r_full.x[:K])
        phis = r_full.x[K:][order]
        results[K] = dict(sse=sse, bic=bic, sse_ho=sse_ho, params=r_full.x,
                          amps=amps, amin=amin, tau=taus, phi=phis)
        rep(f"K={K}: SSE={sse:.4f}  p={p}  BIC={bic:.2f}  held-out SSE={sse_ho:.4f}  "
            f"min max-amplitude={amin:.3g}")
        rep("      taus = " + ", ".join(f"{t:.4g}" for t in taus))
        rep("      phis = " + ", ".join(f"{q:.3f}" for q in phis))

    K_bic = min(results, key=lambda k: results[k]["bic"])
    rep("")
    rep(f"BIC-optimal K = {K_bic}")
    for k in range(K_bic, 1, -1):
        if results[k]["amin"] < 0.02 * max(np.max(results[k]["amps"][m][1:]) for m in curves):
            rep(f"K={k} has a negligible-amplitude mode -> fall back to K={k-1}")
            K_bic = k - 1
        else:
            break
    rep(f"K after amplitude-negligibility guard = {K_bic}")
    K = K_bic
    best = results[K]
    taus, phis, amps = best["tau"], best["phi"], best["amps"]

    rep("")
    rep("BIC / held-out comparison table")
    rep("K    SSE         BIC        held-out SSE")
    for k in sorted(results):
        rep(f"{k}   {results[k]['sse']:11.4f}  {results[k]['bic']:9.2f}  {results[k]['sse_ho']:11.4f}")

    sigma = np.sqrt(best["sse"] / N)
    rep("")
    rep(f"Final fit (K={K}): residual sigma = {sigma:.4f} (equal re/im assumed)")

    # ------------------------- stability: perturbed refits
    rep("")
    rep("Stability: 100 perturbed refits around best solution")
    u_best, phi_best = np.log10(taus), phis
    sols = []
    for i in range(100):
        u0 = u_best + RNG.normal(0, 0.3, K)
        phi0 = np.clip(phi_best + RNG.normal(0, 0.1, K), PHI_LO, PHI_HI)
        try:
            r = fit_once(x, yre, yim, K, u0, phi0, curves)
            sols.append((r.cost, r.x.copy()))
        except Exception:
            pass
    sols.sort(key=lambda t: t[0])
    sse_best = 2 * sols[0][0]
    good = [s for s in sols if 2 * s[0] <= 1.05 * sse_best]
    rep(f"converged: {len(sols)}, within 5% of best SSE: {len(good)}")
    tau_samples = 10.0 ** np.array([np.sort(s[1][:K]) for s in good])
    tau_med = np.median(tau_samples, axis=0)
    tau_spread = (np.percentile(tau_samples, 84, axis=0)
                  - np.percentile(tau_samples, 16, axis=0)) / 2
    rep("tau (best vs median of stable solutions +/- 1-sigma spread):")
    for k in range(K):
        rep(f"  mode {k+1}: tau_best={taus[k]:.4g}  tau_median={tau_med[k]:.4g} "
            f"+/- {tau_spread[k]:.3g}  (rel. spread {tau_spread[k]/tau_med[k]*100:.1f}%)")
    phi_samples = np.array([[s[1][K:][list(np.argsort(s[1][:K])).index(k)] for k in range(K)]
                            for s in good])
    phi_med = np.median(phi_samples, axis=0)
    rep("phi (best vs median of stable solutions): " +
        ", ".join(f"{phis[k]:.3f}/{phi_med[k]:.3f}" for k in range(K)))
    n_hi = np.sum(phi_samples > 0.995, axis=0)
    n_lo = np.sum(phi_samples < 0.055, axis=0)
    rep(f"phi boundary activity across {len(good)} stable solutions "
        f"(count at phi=1 / phi=0.05 per mode): {list(n_hi)} / {list(n_lo)}")

    if sse_best < best["sse"]:
        rep("perturbed refit found better SSE -> adopting it")
        best_params = sols[0][1]
        order = np.argsort(best_params[:K])
        taus, phis = 10.0 ** best_params[:K][order], best_params[K:][order]
        u_best, phi_best = np.log10(taus), phis
        amps, models = extract(x, yre, yim, best_params, K, curves)
        sse = sse_best
        sigma = np.sqrt(sse / N)
        rep(f"updated residual sigma = {sigma:.4f}")

    # ------------------------- bootstrap tau CIs
    rep("")
    rep("Bootstrap over grid points (30 resamples), refit from best solution")
    btaus = []
    for b in range(30):
        idx = np.sort(RNG.integers(0, n_pts, n_pts))
        xb = x[idx]
        yreb = {m: yre[m][idx] for m in curves}
        yimb = {m: yim[m][idx] for m in curves}
        try:
            r = fit_once(xb, yreb, yimb, K, u_best, phi_best, curves, max_nfev=200)
            btaus.append(10.0 ** np.sort(r.x[:K]))
        except Exception:
            pass
    btaus = np.array(btaus)
    rep(f"bootstrap runs: {len(btaus)}")
    for k in range(K):
        q = np.percentile(btaus[:, k], [16, 50, 84])
        rep(f"  mode {k+1}: tau median={q[1]:.4g}  68% CI [{q[0]:.4g}, {q[2]:.4g}]")

    # ------------------------- leave-one-curve-out
    rep("")
    rep("Leave-one-curve-out refits (shared tau, phi re-estimated without each curve)")
    taus_sorted = np.sort(taus)
    for m_out in curves:
        act = [c for c in curves if c != m_out]
        r = fit_once(x, yre, yim, K, u_best, phi_best, act)
        t_loo = 10.0 ** np.sort(r.x[:K])
        rel = np.max(np.abs(t_loo - taus_sorted) / taus_sorted)
        rep(f"  drop curve {m_out}: taus = " + ", ".join(f"{t:.4g}" for t in t_loo) +
            f"  (max rel. dev: {rel*100:.1f}%)")

    # ------------------------- final table / outputs
    order = np.argsort(np.log10(taus))
    taus_s, phis_s = taus[order], phis[order]
    amps_sorted = {m: amps[m][[0] + [1 + j for j in order]] for m in curves}

    rep("")
    rep(f"FINAL MODE SET (K={K}), tau ascending")
    rep("tau        phi     " + "  ".join(f"a_{m}(curve {m})" for m in curves))
    for k in range(K):
        rep(f"{taus_s[k]:.5g}  {phis_s[k]:.3f}  " +
            "  ".join(f"{amps_sorted[m][1+k]:8.4f}" for m in curves))
    rep("Per-curve baselines a0: " + ", ".join(f"{amps[m][0]:.4f}" for m in curves))

    rep("")
    rep("Per-curve residual sigma:")
    for m in curves:
        pre, pim = models[m]
        r2 = np.sum((pre - yre[m])**2) + np.sum((pim - yim[m])**2)
        rep(f"  curve {m}: sigma = {np.sqrt(r2 / (2*n_pts)):.4f}")

    os.makedirs(OUT_DIR, exist_ok=True)
    with open(os.path.join(OUT_DIR, "modes.csv"), "w") as f:
        f.write("tau," + ",".join(f"a_{m}" for m in curves) + "\n")
        for k in range(K):
            row = [taus_s[k]] + [amps_sorted[m][1 + k] for m in curves]
            f.write(",".join(f"{v:.6g}" for v in row) + "\n")

    with open(os.path.join(OUT_DIR, "fit_report.txt"), "w") as f:
        f.write("\n".join(report) + "\n")
    rep("")
    rep("Done. Outputs: results/modes.csv, results/fit_report.txt")

if __name__ == "__main__":
    main()
