"""Model-free optimistic Q-learning with drift-robust Bernstein bonuses.

Design: horizon-indexed Q table (optimistic init) + a lagged reference copy
Qref (EMA per episode). Targets for the *variance statistics* are computed
against Qref, so the empirical variance of y = r + max_a' Qref(h+1, s', a')
is not inflated by the drift of the actively learned Q table (the burn-in
problem of plain UCB-B / naive UCB-Q). Bonus: Bernstein
    b = c_var * sqrt(2 * sigma2 * L / n_eff) + c_tail * cap * L / n_eff
with sigma2 = EW variance of yref (clipped by Popoviciu bound), per (h,s,a).
Storage: O(H*S*A) scalars only (N, m1, m2, Q, Qref). No transition model,
no next-state counts, no replay, no episode trace.
"""
from __future__ import annotations

import math

CONFIG = {
    "eta": 0.2,        # Qref EMA rate per episode (lagged reference copy)
    "ew": 0.15,        # EW rate for target moments (0 -> running moments)
    "c_log": 0.6,      # scale of the log term L
    "c_var": 1.0,      # scale of the sqrt-variance (Bernstein) term
    "c_tail": 0.1,     # scale of the tail term cap*L/n
    "p_anneal": 0.5,   # bonus annealing exponent: mult = (K/(ep+K))**p
    "biu": 0,          # 1 -> fold bonus into the Q update (optimistic Q-learn)
}


def make_agent(env_spec, seed):
    return _Agent(env_spec, seed)


class _Agent:
    __slots__ = ("S", "A", "H", "K", "SA", "HSA", "caps", "Q", "Qref", "N",
                 "m1", "m2", "L", "mult", "ep", "ew", "eta", "c_var",
                 "c_tail", "p_ann", "biu", "inv_ew", "Hf", "Lbase")

    def __init__(self, env_spec, seed):
        cfg = CONFIG
        S = int(env_spec.get("S", 1))
        A = int(env_spec.get("A", 1))
        H = int(env_spec.get("H", 1))
        K = int(env_spec.get("K", 1))
        if S < 1: S = 1
        if A < 1: A = 1
        if H < 1: H = 1
        if K < 1: K = 1
        rr = env_spec.get("reward_range")
        rmax = 1.0
        if isinstance(rr, (list, tuple)) and len(rr) >= 2:
            try:
                rmax = float(rr[1])
            except Exception:
                rmax = 1.0
        if not (rmax > 0.0):
            rmax = 1.0
        self.S, self.A, self.H, self.K = S, A, H, K
        SA = S * A
        self.SA, self.HSA = SA, H * SA
        caps = [0.0] * (H + 1)
        for h in range(1, H + 1):
            caps[h] = (H - h + 1) * rmax
        self.caps = caps
        Q = []
        for h in range(1, H + 1):
            Q.extend([caps[h]] * SA)      # optimistic initialization
        self.Q = Q
        self.Qref = list(Q)
        self.N = [0] * self.HSA
        self.m1 = [0.0] * self.HSA
        self.m2 = [0.0] * self.HSA
        self.L = cfg["c_log"] * (math.log(S * A * H * K + 2.0) + 1.0)
        self.mult = 1.0
        self.ep = 0
        self.ew = float(cfg["ew"])
        self.eta = float(cfg["eta"])
        self.c_var = float(cfg["c_var"])
        self.c_tail = float(cfg["c_tail"])
        self.p_ann = float(cfg["p_anneal"])
        self.biu = bool(cfg["biu"])
        self.inv_ew = (1.0 / self.ew) if self.ew > 0.0 else 0.0
        self.Hf = float(H)

    def act(self, h, state):
        S = self.S; A = self.A; H = self.H
        if h < 1 or h > H or state < 0 or state >= S:
            return 0
        SA = self.SA
        row = (h - 1) * SA + state * A
        cap = self.caps[h]
        Q = self.Q; N = self.N; m1 = self.m1; m2 = self.m2
        L = self.L
        cv = self.c_var; ct = self.c_tail
        mult = self.mult
        ew = self.ew; inv_ew = self.inv_ew
        best_v = -1.0
        best_a = 0
        for a in range(A):
            i = row + a
            n = N[i]
            if n == 0:
                v = cap
            else:
                var = m2[i] - m1[i] * m1[i]
                if var < 0.0:
                    var = 0.0
                vmax = 0.25 * cap * cap
                if var > vmax:
                    var = vmax
                ne = n if (ew <= 0.0 or n < inv_ew) else inv_ew
                b = cv * math.sqrt(2.0 * var * L / ne) + ct * cap * L / ne
                v = Q[i] + mult * b
                if v > cap:
                    v = cap
                elif v < 0.0:
                    v = 0.0
            if v > best_v:
                best_v = v
                best_a = a
        return best_a

    def observe(self, h, state, action, reward, next_state, done):
        S = self.S; A = self.A; H = self.H; SA = self.SA
        if h < 1 or h > H:
            return
        if state < 0 or state >= S or action < 0 or action >= A:
            return
        row = (h - 1) * SA + state * A
        i = row + action
        n = self.N[i]
        self.N[i] = n + 1
        n1 = n + 1
        r = float(reward)
        last = bool(done) or h >= H
        Q = self.Q; Qref = self.Qref
        cap = self.caps[h]
        if last:
            y = r
            yref = r
        else:
            ns = int(next_state)
            if ns < 0 or ns >= S:
                ns = 0
            nr = h * SA + ns * A
            mq = Q[nr]
            mr = Qref[nr]
            for a2 in range(1, A):
                j = nr + a2
                qj = Q[j]
                if qj > mq:
                    mq = qj
                rj = Qref[j]
                if rj > mr:
                    mr = rj
            y = r + mq
            yref = r + mr
        if y > cap:
            y = cap
        elif y < 0.0:
            y = 0.0
        if yref > cap:
            yref = cap
        elif yref < 0.0:
            yref = 0.0
        alpha = (self.Hf + 1.0) / (self.Hf + n1)
        if self.biu:
            # bonus folded into the update (optimistic Q-learning style)
            var = self.m2[i] - self.m1[i] * self.m1[i]
            if var < 0.0:
                var = 0.0
            vmax = 0.25 * cap * cap
            if var > vmax:
                var = vmax
            ne = n1 if (self.ew <= 0.0 or n1 < self.inv_ew) else self.inv_ew
            b = self.c_var * math.sqrt(2.0 * var * self.L / ne) \
                + self.c_tail * cap * self.L / ne
            qb = Q[i] + self.mult * b
            if qb > cap:
                qb = cap
            Q[i] = (1.0 - alpha) * Q[i] + alpha * qb
        else:
            Q[i] = (1.0 - alpha) * Q[i] + alpha * y
        # target statistics (against the lagged Qref) for the variance bonus
        if self.ew > 0.0:
            if n == 0:
                self.m1[i] = yref
                self.m2[i] = yref * yref
            else:
                aew = self.ew
                self.m1[i] += aew * (yref - self.m1[i])
                self.m2[i] += aew * (yref * yref - self.m2[i])
        else:
            self.m1[i] += (yref - self.m1[i]) / n1
            self.m2[i] += (yref * yref - self.m2[i]) / n1
        if last:
            self.ep += 1
            ep = self.ep
            self.mult = (self.K / (ep + self.K)) ** self.p_ann
            eta = self.eta
            for j in range(self.HSA):
                Qref[j] += (Q[j] - Qref[j]) * eta

    # optional official hooks (no-ops; episode handling is done in observe)
    def reset_episode(self, episode, state):
        return None

    def end_episode(self, episode, episode_reward):
        return None
