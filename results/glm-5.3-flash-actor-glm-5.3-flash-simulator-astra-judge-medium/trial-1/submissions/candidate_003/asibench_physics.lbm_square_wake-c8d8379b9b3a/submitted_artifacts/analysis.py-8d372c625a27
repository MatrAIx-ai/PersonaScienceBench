#!/usr/bin/env python3
"""
LBM (D2Q9 BGK, halfway bounce-back) simulation of flow past a square solid
region in a rectangular lattice domain, driven solely by ./data/task_input.json.

Outputs (exact contract):
  ./results/fluid_summary.csv            case_id,nx,ny,re,uin,nu,tau,n_steps,cd_mean,cl_rms,converged
  ./results/fluid_force_series.csv       case_id,step,cd,cl
  ./results/fluid_centerline.csv         case_id,x,u
  ./results/fluid_transverse_profile.csv case_id,x_probe,y,u,v
  ./results/fluid_report.json            task_id, units, cd_mean_avg, method_summary

Conventions (per task contract and researcher-approved adjudications):
- nu = uin*square_size/re ; reported tau = 0.5 + 3*nu
- Solid mask: x in [cx-half, cx-half+size), y in [cy-half, cy-half+size), clipped.
- Deterministic IC: rho=1, u=(uin,0) everywhere, f = feq(rho,u). No hidden settling.
- Exactly n_steps updates per case; samples at 0-based completed-update index
  s in {warmup_steps, warmup_steps+sample_every, ...} with s < n_steps.
- Instantaneous momentum-exchange force at each sampled step;
  cd_mean = arithmetic mean of cd samples; cl_rms = RMS of cl samples.
- cd = Fx/(0.5*uin^2*size), cl = Fy/(0.5*uin^2*size).
- Boundaries: fixed-velocity equilibrium inlet (u=uin, rho=1) at x=0; outflow
  (copy upstream column) at x=nx-1; no-slip halfway bounce-back walls at y=0, ny-1.
- Solid no-slip via halfway bounce-back on all fluid->solid links.
- Fallback (pre-approved): if BGK blows up (NaN/Inf or runaway velocity), that
  case is re-run from the same deterministic IC with TRT using the contract tau
  as the even relaxation and Lambda=3/16; reported tau unchanged; documented in
  fluid_report.json method_summary.
Only numpy, pandas and the standard library are used.
"""
import json
import time
from pathlib import Path

import numpy as np
import pandas as pd

INPUT_PATH = Path("./data/task_input.json")
RESULTS_DIR = Path("./results")

# D2Q9 velocities: 0 rest, 1..4 axis, 5..8 diagonal
EX = np.array([0, 1, 0, -1, 0, 1, -1, -1, 1], dtype=np.int64)
EY = np.array([0, 0, 1, 0, -1, 1, 1, -1, -1], dtype=np.int64)
W = np.array([4.0 / 9.0, 1.0 / 9.0, 1.0 / 9.0, 1.0 / 9.0, 1.0 / 9.0,
              1.0 / 36.0, 1.0 / 36.0, 1.0 / 36.0, 1.0 / 36.0])
OPP = np.array([0, 3, 4, 1, 2, 7, 8, 5, 6])  # opposite direction index

UMAX_BLOWUP = 0.45  # Ma ~ 0.75: runaway velocity -> genuine numerical blow-up


def equilibrium(rho, ux, uy):
    """feq for all 9 directions; rho,ux,uy are (ny,nx) arrays."""
    usq = 1.5 * (ux * ux + uy * uy)
    feq = np.empty((9, rho.shape[0], rho.shape[1]), dtype=np.float64)
    for i in range(9):
        cu = 3.0 * (EX[i] * ux + EY[i] * uy)
        feq[i] = W[i] * rho * (1.0 + cu + 0.5 * cu * cu - usq)
    return feq


def solid_mask(nx, ny, center, size):
    cx, cy = int(center[0]), int(center[1])
    half = size // 2
    x0, x1 = max(0, cx - half), min(nx, cx - half + size)
    y0, y1 = max(0, cy - half), min(ny, cy - half + size)
    m = np.zeros((ny, nx), dtype=bool)
    m[y0:y1, x0:x1] = True
    return m


def build_masks(solid):
    """Per-direction masks: fluid nodes whose neighbor along direction i is solid."""
    fluid = ~solid
    f2s = {}
    for i in range(1, 9):
        nb = np.roll(solid, shift=(-EY[i], -EX[i]), axis=(0, 1))
        f2s[i] = fluid & nb
    return f2s


def collide_bgk(f, rho, ux, uy, omega):
    feq = equilibrium(rho, ux, uy)
    return f - omega * (f - feq)


def collide_trt(f, rho, ux, uy, omega_p, omega_m):
    feq = equilibrium(rho, ux, uy)
    fneq = f - feq
    fpost = f.copy()
    for i in range(1, 9):
        j = OPP[i]
        if i < j:
            fp = 0.5 * (fneq[i] + fneq[j])   # symmetric part
            fm = 0.5 * (fneq[i] - fneq[j])   # antisymmetric part
            fpost[i] = f[i] - omega_p * fp - omega_m * fm
            fpost[j] = f[j] - omega_p * fp + omega_m * fm
    return fpost


def stream_and_boundaries(fpost, solid, uin):
    """Pull-streaming + halfway bounce-back (solid & lateral walls) + inlet/outlet."""
    ny, nx = solid.shape
    fn = np.empty_like(fpost)
    for i in range(9):
        # pull: fn[i][y,x] = fpost[i][y-ey, x-ex]
        fn[i] = np.roll(fpost[i], shift=(EY[i], EX[i]), axis=(0, 1))
    # halfway bounce-back on fluid->solid links: arriving direction j at node x,
    # whose source node (x - e_j) is solid, equals reflected fpost[opp(j)](x)
    for j in range(1, 9):
        src_solid = np.roll(solid, shift=(EY[j], EX[j]), axis=(0, 1))
        fn[j][src_solid] = fpost[OPP[j]][src_solid]
    # no-slip lateral walls. With pull-streaming, an arrival j at row 0 with
    # ey[j]=+1 would come from row -1 (outside): reflect it. At row ny-1 the
    # arrivals with ey[j]=-1 come from row ny (outside): reflect them.
    for j in range(1, 9):
        if EY[j] == +1:
            fn[j][0, :] = fpost[OPP[j]][0, :]
        elif EY[j] == -1:
            fn[j][-1, :] = fpost[OPP[j]][-1, :]
    # inlet x=0: fixed-velocity equilibrium (Dirichlet), rho=1, u=(uin,0)
    ny_ = solid.shape[0]
    feq_in = equilibrium(np.ones((ny_, 1)), np.full((ny_, 1), uin), np.zeros((ny_, 1)))
    fn[:, :, 0] = feq_in[:, :, 0]
    # outlet x=nx-1: outflow (copy upstream column of populations)
    fn[:, :, nx - 1] = fn[:, :, nx - 2]
    return fn


def momentum_exchange_force(fpost, f2s):
    """Force on the solid from halfway bounce-back: F = sum_links 2*f_i*c_i."""
    fx = 0.0
    fy = 0.0
    for i in range(1, 9):
        m = f2s[i]
        if not m.any():
            continue
        contrib = 2.0 * fpost[i][m]
        fx += EX[i] * contrib.sum()
        fy += EY[i] * contrib.sum()
    return fx, fy


def run_case(case, scheme="bgk"):
    nx, ny = int(case["nx"]), int(case["ny"])
    uin = float(case["uin"])
    re = float(case["re"])
    size = int(case["square_size"])
    n_steps = int(case["n_steps"])
    warmup = int(case["warmup_steps"])
    sample_every = int(case["sample_every"])

    nu = uin * size / re
    tau = 0.5 + 3.0 * nu
    omega_p = 1.0 / tau
    if scheme == "trt":
        Lambda = 3.0 / 16.0
        tau_m = 0.5 + Lambda / (tau - 0.5)
        omega_m = 1.0 / tau_m
    else:
        omega_m = None

    solid = solid_mask(nx, ny, case["square_center"], size)
    f2s = build_masks(solid)
    fluid = ~solid

    # deterministic initial field: uniform flow, rho=1, f=feq. No pre-settling.
    ux0 = np.full((ny, nx), uin)
    uy0 = np.zeros((ny, nx))
    rho0 = np.ones((ny, nx))
    f = equilibrium(rho0, ux0, uy0)

    denom = 0.5 * uin * uin * size
    sample_steps = []
    cd_s, cl_s = [], []
    blowup = False
    t0 = time.time()

    for step in range(n_steps):  # 0-based update index; s = completed updates
        rho = f.sum(axis=0)
        ux = (f[1] - f[3] + f[5] - f[6] - f[7] + f[8]) / rho
        uy = (f[2] - f[4] + f[5] + f[6] - f[7] - f[8]) / rho
        ux[~fluid] = 0.0
        uy[~fluid] = 0.0

        if scheme == "bgk":
            fpost = collide_bgk(f, rho, ux, uy, omega_p)
        else:
            fpost = collide_trt(f, rho, ux, uy, omega_p, omega_m)

        # instantaneous momentum-exchange force on the solid (post-collision pops)
        fx, fy = momentum_exchange_force(fpost, f2s)

        f = stream_and_boundaries(fpost, solid, uin)

        if not np.isfinite(f).all():
            blowup = True
            break

        s = step
        if s >= warmup and (s - warmup) % sample_every == 0 and s < n_steps:
            sample_steps.append(s)
            cd_s.append(fx / denom)
            cl_s.append(fy / denom)

        # blow-up guard: runaway velocity (not physical shedding)
        umax = np.sqrt(ux[fluid] ** 2 + uy[fluid] ** 2).max()
        if not np.isfinite(umax) or umax > UMAX_BLOWUP:
            blowup = True
            break

    elapsed = time.time() - t0

    if blowup and scheme == "bgk":
        return None, elapsed  # signal caller to retry with TRT

    # final macroscopic fields for profile outputs
    rho_f = f.sum(axis=0)
    ux_f = (f[1] - f[3] + f[5] - f[6] - f[7] + f[8]) / rho_f
    uy_f = (f[2] - f[4] + f[5] + f[6] - f[7] - f[8]) / rho_f
    ux_f[solid] = 0.0
    uy_f[solid] = 0.0

    cd_arr = np.asarray(cd_s, dtype=np.float64)
    cl_arr = np.asarray(cl_s, dtype=np.float64)
    cd_mean = float(cd_arr.mean())
    cl_rms = float(np.sqrt((cl_arr ** 2).mean()))
    half = len(cd_arr) // 2
    m1, m2 = cd_arr[:half].mean(), cd_arr[half:].mean()
    rel_drift = abs(m1 - m2) / max(abs(cd_mean), 1e-12)
    converged = bool(np.isfinite(cd_arr).all() and np.isfinite(cl_arr).all()
                     and rel_drift < 0.05)

    info = {
        "nu": nu, "tau": tau, "cd_mean": cd_mean, "cl_rms": cl_rms,
        "converged": converged, "rel_drift": rel_drift,
        "n_samples": len(cd_arr), "scheme": scheme, "elapsed": elapsed,
        "max_abs_cl": float(np.abs(cl_arr).max()),
        "cd_std": float(cd_arr.std()),
    }
    series = (np.asarray(sample_steps, dtype=np.int64), cd_arr, cl_arr)
    return (info, series, ux_f, uy_f, solid, rho_f), elapsed


def main():
    raw = INPUT_PATH.read_bytes()
    text = raw.decode("utf-8-sig")
    data = json.loads(text)

    task_id = data["task_id"]
    units = data.get("units", "dimensionless")
    cases = data["cases"]

    summary_rows, series_rows, center_rows, prof_rows = [], [], [], []
    method_notes, diagnostics = [], []

    for case in cases:
        cid = case["case_id"]
        res, el = run_case(case, scheme="bgk")
        used_scheme = "D2Q9 BGK"
        if res is None:  # pre-approved TRT fallback on genuine BGK blow-up
            res, el = run_case(case, scheme="trt")
            used_scheme = "D2Q9 TRT (Lambda=3/16; BGK diverged)"
        info, (steps, cds, cls), ux_f, uy_f, solid, rho_f = res
        nx, ny = int(case["nx"]), int(case["ny"])
        size = int(case["square_size"])
        cx, cy = case["square_center"]

        summary_rows.append({
            "case_id": cid, "nx": nx, "ny": ny, "re": float(case["re"]),
            "uin": float(case["uin"]), "nu": info["nu"], "tau": info["tau"],
            "n_steps": int(case["n_steps"]), "cd_mean": info["cd_mean"],
            "cl_rms": info["cl_rms"], "converged": info["converged"],
        })
        for s, cd, cl in zip(steps, cds, cls):
            series_rows.append({"case_id": cid, "step": int(s),
                                "cd": float(cd), "cl": float(cl)})

        cy_row = int(cy)
        for x in range(nx):
            center_rows.append({"case_id": cid, "x": x, "u": float(ux_f[cy_row, x])})

        x_probe = min(nx - 1, int(cx) + 2 * size)
        for y in range(ny):
            prof_rows.append({"case_id": cid, "x_probe": x_probe, "y": y,
                              "u": float(ux_f[y, x_probe]), "v": float(uy_f[y, x_probe])})

        method_notes.append(f"{cid}: {used_scheme}")
        diagnostics.append(
            f"{cid}: scheme={used_scheme} nu={info['nu']:.6g} tau={info['tau']:.6f} "
            f"samples={info['n_samples']} cd_mean={info['cd_mean']:.6f} "
            f"cd_std={info['cd_std']:.3e} cl_rms={info['cl_rms']:.6f} "
            f"max|cl|={info['max_abs_cl']:.4f} rel_cd_drift={info['rel_drift']:.4f} "
            f"converged={info['converged']} mean_rho={rho_f[~solid].mean():.6f} "
            f"runtime={el:.1f}s")
        print(diagnostics[-1], flush=True)

    RESULTS_DIR.mkdir(parents=True, exist_ok=True)
    pd.DataFrame(summary_rows,
                 columns=["case_id", "nx", "ny", "re", "uin", "nu", "tau",
                          "n_steps", "cd_mean", "cl_rms", "converged"]
                 ).to_csv(RESULTS_DIR / "fluid_summary.csv", index=False)
    pd.DataFrame(series_rows,
                 columns=["case_id", "step", "cd", "cl"]
                 ).to_csv(RESULTS_DIR / "fluid_force_series.csv", index=False)
    pd.DataFrame(center_rows, columns=["case_id", "x", "u"]
                 ).to_csv(RESULTS_DIR / "fluid_centerline.csv", index=False)
    pd.DataFrame(prof_rows, columns=["case_id", "x_probe", "y", "u", "v"]
                 ).to_csv(RESULTS_DIR / "fluid_transverse_profile.csv", index=False)

    cd_means = [r["cd_mean"] for r in summary_rows]
    trt_used = [n for n in method_notes if "TRT" in n]
    report = {
        "task_id": task_id,
        "units": units,
        "cd_mean_avg": float(np.mean(cd_means)),
        "method_summary": (
            "D2Q9 lattice-Boltzmann BGK (single relaxation time, omega=1/tau with "
            "tau=0.5+3*uin*square_size/re), halfway bounce-back no-slip on the square "
            "solid mask x in [cx-half, cx-half+size) x y in [cy-half, cy-half+size) "
            "(clipped to the domain) and on the top/bottom channel walls; "
            "fixed-velocity equilibrium inlet (u=uin, rho=1) at x=0; outflow "
            "(population copy from upstream column) at x=nx-1. Deterministic IC "
            "rho=1, u=(uin,0), f=feq everywhere; exactly n_steps updates per case "
            "with no extra settling; instantaneous momentum-exchange force "
            "F=sum_links 2*f_i*c_i sampled at 0-based steps s in {warmup, "
            "warmup+sample_every, ...} with s<n_steps; cd=Fx/(0.5*uin^2*size), "
            "cl=Fy/(0.5*uin^2*size); cd_mean=mean of samples, cl_rms=RMS of samples; "
            "converged = finite samples and <5% relative drift of mean cd between "
            "sampling-window halves (informational flag only). "
            + ("No numerical blow-up occurred; BGK used for all cases."
               if not trt_used else "Fallback (pre-approved): " + "; ".join(trt_used))
        ),
    }
    with open(RESULTS_DIR / "fluid_report.json", "w") as fh:
        json.dump(report, fh, indent=2)

    print("\n".join(diagnostics))
    print(f"cd_mean_avg = {report['cd_mean_avg']:.6f}")
    print("All outputs written to ./results")


if __name__ == "__main__":
    main()
