#!/usr/bin/env python3
"""
Multi-Sensor Motion Record Audit
================================
Joint calibration of a planar IMU/gyro + lidar scan-match record:

  gyro_bias_rad_s   b : constant additive bias of the z-gyro  [rad/s]
  time_offset_s   tau : constant clock offset between lidar and IMU time bases.
                        Convention: a lidar interval [t0, t1] (lidar clock)
                        corresponds to IMU-clock interval [t0 + tau, t1 + tau].
  yaw_extrinsic_rad psi : constant yaw mounting offset between the lidar frame
                        and the body/IMU frame.  Convention (sensor-to-body):
                        a vector in the lidar frame maps to the body frame via
                        v_b = Rz(psi) v_l, i.e. angle(dp_l) = dtheta/2 - psi.

Estimation uses ONLY rows with split == 'train' (700 of 854).  The 154
'heldout' rows are used exclusively for validation residuals (residuals.csv)
and diagnostics.

Models
------
Yaw channel (per scan match i):
    dyaw_i = Theta(t1_i + tau) - Theta(t0_i + tau) - b*dt_i + eps_i
    Theta(t) = integral of gyro omega from 0 to t (cumulative trapezoid),
    eps_i ~ N(0, sigma_yaw^2), sigma_yaw = 0.006 (file metadata).
Translation channel (per scan match i):
    Rz(psi) * dp_l,i  should equal  Lhat_i * [cos(dtheta_i/2), sin(dtheta_i/2)]
    (unicycle chord), dtheta_i = calibrated gyro-implied yaw change,
    Lhat_i = |dp_l,i|; closed-form weighted orthogonal Procrustes over psi.

residual_trans_m definition (documented as required):
    || Rz(psi)*dp_l - Lhat*[cos(dtheta/2), sin(dtheta/2)] ||_2
    i.e. the 2-D norm of the mismatch between the measured lidar relative
    translation (rotated into the body frame with the calibrated extrinsic)
    and the chord predicted from the calibrated gyro heading change.  A
    single-axis gyro cannot constrain the along-track component, so this is
    effectively the calibrated cross-track (chord-geometry) mismatch, metres.
"""
import json
import numpy as np
from scipy.optimize import minimize_scalar
from scipy.stats import f as fdist


def load():
    g = np.genfromtxt(f"data/imu_gyro.csv", delimiter=",", names=True)
    l = np.genfromtxt("data/lidar_scan_matches.csv", delimiter=",",
                      names=True, dtype=None, encoding=None)
    seg = np.genfromtxt("data/segment_windows.csv", delimiter=",", names=True)
    info = json.load(open("data/task_info.json"))
    return g, l, seg, info


def make_theta(g):
    """W(t) = int_0^t omega dt' with cumulative trapezoid + linear interpolation."""
    t = g["imu_time_s"]; w = g["omega_z_rad_s"]
    c = np.concatenate([[0.0], np.cumsum(0.5 * (w[1:] + w[:-1]) * np.diff(t))])
    i0 = int(np.searchsorted(t, 0.0))
    th0 = c[i0] + 0.5 * (w[i0] + w[min(i0 + 1, len(t) - 1)]) * (0.0 - t[i0])
    slope = (w[1:] - w[:-1]) / np.diff(t)   # local slope of linear interpolant
    def W(q):
        # exact integral of the piecewise-linear interpolant from 0 to q
        q = np.asarray(q, float)
        i = np.clip(np.searchsorted(t, q) - 1, 0, len(t) - 2)
        dq = q - t[i]
        return c[i] + w[i] * dq + 0.5 * slope[i] * dq**2 - th0
    return W


def wrap(a):
    return (a + np.pi) % (2.0 * np.pi) - np.pi


def fit_psi(dx, dy, dtheta):
    """Orthogonal Procrustes: minimise sum || Rz(psi) a_i - b_i ||^2 with
    a_i = dp_l (lidar frame), b_i = Lhat_i*u(dtheta_i/2).  Returns psi,
    per-scan residual vectors, rss, a, b."""
    a = np.column_stack([dx, dy])
    L = np.hypot(dx, dy)
    u = np.column_stack([np.cos(dtheta / 2.0), np.sin(dtheta / 2.0)])
    b = L[:, None] * u
    c = float(np.sum(a * b))                       # sum a.b
    s = float(np.sum(a[:, 0] * b[:, 1] - a[:, 1] * b[:, 0]))  # sum a x b
    psi = np.arctan2(s, c)
    R = np.array([[np.cos(psi), -np.sin(psi)], [np.sin(psi), np.cos(psi)]])
    evec = a @ R.T - b
    return psi, evec, float(np.sum(evec**2)), a, b


RENDER_SRC = r"""# renderer: draws the six diagnostics panels with Pillow (system python3.14)
