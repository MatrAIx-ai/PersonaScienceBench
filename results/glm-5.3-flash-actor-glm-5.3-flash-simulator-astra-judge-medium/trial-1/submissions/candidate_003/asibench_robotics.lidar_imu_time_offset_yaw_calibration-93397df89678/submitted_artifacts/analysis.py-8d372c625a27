def main():
    g, lid, seg, info = load()
    SIG_YAW = float(lid["sigma_yaw_rad"][0])
    SIG_TRANS = float(lid["sigma_trans_m"][0])
    W = make_theta(g)
    gt, gw = g["imu_time_s"], g["omega_z_rad_s"]

    split = lid["split"]
    tr = split == "train"; ho = split == "heldout"
    scan_id = lid["scan_id"].astype(int)
    t0, t1 = lid["t0_lidar_s"], lid["t1_lidar_s"]
    dt = t1 - t0
    dyaw = lid["dyaw_lidar_rad"]
    dx, dy = lid["dx_lidar_m"], lid["dy_lidar_m"]
    n_tr = int(tr.sum())

    # segment membership of every scan
    seg_id_of = np.full(len(lid), -1)
    for k in range(len(seg)):
        m = (t0 >= seg["t0_lidar_s"][k]) & (t0 < seg["t1_lidar_s"][k])
        seg_id_of[m] = int(seg["segment_id"][k])
    segs = seg["segment_id"].astype(int)

    # ---------------- 1. yaw channel: profile fit of (tau, b) on TRAIN rows
    def ss_fn(tau):
        I = W(t1 + tau) - W(t0 + tau)
        b = np.dot(I[tr] - dyaw[tr], dt[tr]) / np.dot(dt[tr], dt[tr])
        r = dyaw[tr] - (I[tr] - b * dt[tr])
        return float(r @ r), b, r

    res = minimize_scalar(lambda x: ss_fn(x)[0], bounds=(-0.05, 0.05),
                          method="bounded", options={"xatol": 1e-12})
    tau = float(res.x); _, b, r_yaw_tr, ss_yaw = *ss_fn(tau), None
    ss_yaw, b, r_yaw_tr = ss_fn(tau)
    s2_yaw = ss_yaw / (n_tr - 2)

    h = 1e-6
    f0, f1, f2 = ss_fn(tau)[0], ss_fn(tau + h)[0], ss_fn(tau - h)[0]
    d2 = (f1 - 2 * f0 + f2) / h**2
    se_tau = float(np.sqrt(2.0 * s2_yaw / d2))
    se_b = float(np.sqrt(s2_yaw / np.dot(dt[tr], dt[tr])))

    # ------------- residual-structure audit on TRAIN rows only
    seg_mean = {int(s): float(np.mean(r_yaw_tr[seg_id_of[tr] == s])) for s in segs}
    rss1 = float(np.sum(r_yaw_tr**2))
    rss2 = sum(float(np.sum((r_yaw_tr[seg_id_of[tr] == s] - seg_mean[int(s)])**2))
               for s in segs)
    df1, df2 = n_tr - 2, n_tr - 2 - (len(segs) - 1)
    F = ((rss1 - rss2) / (df1 - df2)) / (rss2 / df2)
    p_seg = float(fdist.sf(F, df1 - df2, df2))
    ac = [float(np.corrcoef(r_yaw_tr[:-k], r_yaw_tr[k:])[0, 1]) for k in (1, 2, 3, 5, 10)]
    iw0 = gw[np.clip(np.searchsorted(gt, t0[tr] + tau), 0, len(gt) - 1)]
    iw1 = gw[np.clip(np.searchsorted(gt, t1[tr] + tau), 0, len(gt) - 1)]
    X = np.column_stack([np.ones(n_tr), iw0, iw1])  # dt is constant -> collinear with intercept
    coef, *_ = np.linalg.lstsq(X, r_yaw_tr, rcond=None)
    structure = {
        "global_mean": float(np.mean(r_yaw_tr)),
        "global_std": float(np.std(r_yaw_tr, ddof=1)),
        "per_segment_mean": seg_mean,
        "per_segment_offset_F": float(F), "per_segment_offset_p": p_seg,
        "autocorr_lag1_2_3_5_10": ac,
        "covariate_regression_const_omega0_omega1": [float(x) for x in coef],
        "decision": "homogeneous noise model retained" if p_seg >= 0.01
                    else "per-segment offsets supported (p<0.01)",
    }
    use_seg_offsets = p_seg < 0.01
    if use_seg_offsets:                      # profile offsets out, refit tau,b
        c_hat = np.zeros(len(lid))
        for s in segs:
            c_hat[tr & (seg_id_of == s)] = seg_mean[int(s)]
        def ss2(x):
            I = W(t1 + x) - W(t0 + x)
            y = dyaw[tr] - I[tr] - c_hat[tr]
            bb = np.dot(y, dt[tr]) / np.dot(dt[tr], dt[tr])
            rr = y - bb * dt[tr]
            return float(rr @ rr), bb, rr
        res2 = minimize_scalar(lambda x: ss2(x)[0], bounds=(-0.05, 0.05),
                               method="bounded", options={"xatol": 1e-12})
        tau = float(res2.x)
        ss_yaw, b, r_yaw_tr = ss2(tau)
        s2_yaw = ss_yaw / (n_tr - 2 - (len(segs) - 1))
        f0, f1, f2 = ss2(tau)[0], ss2(tau + h)[0], ss2(tau - h)[0]
        d2 = (f1 - 2 * f0 + f2) / h**2
        se_tau = float(np.sqrt(2.0 * s2_yaw / d2))
        se_b = float(np.sqrt(s2_yaw / np.dot(dt[tr], dt[tr])))
    dth_cal = (W(t1 + tau) - W(t0 + tau)) - b * dt    # calibrated dyaw model

    # ------------- 2. translation channel: Procrustes fit of psi on TRAIN rows
    psi, evec_tr, rss_tr, a_tr, b_tr = fit_psi(dx[tr], dy[tr], dth_cal[tr])
    psi, evec_tr, rss_tr, a_tr, b_tr = fit_psi(dx[tr], dy[tr], dth_cal[tr])  # refined
    s2_trans = rss_tr / (n_tr - 1)          # rotation removes 1 dof (mean angle)
    se_psi = float(np.sqrt(s2_trans / np.sum(a_tr**2)))
    r_trans_tr = np.hypot(evec_tr[:, 0], evec_tr[:, 1])

    # ---------------- 3. held-out residuals (validation only)
    dth_ho = dth_cal[ho]
    r_yaw_ho = wrap(dyaw[ho] - dth_ho)
    _, evec_ho, _, a_ho, b_ho = fit_psi(dx[ho], dy[ho], dth_ho)
    r_trans_ho = np.hypot(evec_ho[:, 0], evec_ho[:, 1])

    # ---------------- 4. per-segment observability scores (train rows only)
    # Fisher-style per-scan information for each parameter, normalized by the
    # max over segments, combined with the task's own parameter weights.
    # Larger score = more useful for constraining the reported quantities.
    w_sens = (gw[np.clip(np.searchsorted(gt, t1 + tau), 0, len(gt) - 1)]
              - gw[np.clip(np.searchsorted(gt, t0 + tau), 0, len(gt) - 1)])
    I_tau = np.array([np.mean(w_sens[tr & (seg_id_of == s)]**2) for s in segs]) / SIG_YAW**2
    I_b = np.array([np.mean(dt[tr & (seg_id_of == s)]**2) for s in segs]) / SIG_YAW**2
    I_p = np.array([np.mean((dx[tr & (seg_id_of == s)]**2 + dy[tr & (seg_id_of == s)]**2))
                    for s in segs]) / SIG_TRANS**2
    nrm = lambda v: v / v.max()
    pw = info["scoring"]["parameter_weights"]
    wsum = pw["time_offset_s"] + pw["gyro_bias_rad_s"] + pw["yaw_extrinsic_rad"]
    score = (pw["time_offset_s"] * nrm(I_tau) + pw["gyro_bias_rad_s"] * nrm(I_b)
             + pw["yaw_extrinsic_rad"] * nrm(I_p)) / wsum
    order = np.argsort(-score)

    # ---------------- 5. outputs
    with open("calibration.csv", "w") as f:
        f.write("gyro_bias_rad_s,time_offset_s,yaw_extrinsic_rad\n")
        f.write("%.10f,%.10f,%.10f\n" % (b, tau, psi))

    with open("observability.csv", "w") as f:
        f.write("segment_id,t0_lidar_s,t1_lidar_s,observability_score\n")
        for k, s in enumerate(segs):
            f.write("%d,%.6f,%.6f,%.10f\n" % (s, seg["t0_lidar_s"][k],
                    seg["t1_lidar_s"][k], score[k]))

    ho_rows = np.where(ho)[0]
    ho_rows = ho_rows[np.argsort(scan_id[ho_rows])]
    with open("residuals.csv", "w") as f:
        f.write("scan_id,residual_yaw_rad,residual_trans_m\n")
        for i in ho_rows:
            j = int(np.where(scan_id[ho] == scan_id[i])[0][0])
            f.write("%d,%.10f,%.10f\n" % (scan_id[i], r_yaw_ho[j], r_trans_ho[j]))

    # ---------------- 6. diagnostics figure
    # matplotlib is unavailable in this offline environment and Pillow's C
    # extension is built for the system python3.14 (which lacks numpy), so the
    # panels are rasterized by shelling out to python3.14 with Pillow, using
    # plot data serialized from this numpy/scipy process.
    import subprocess, sys, shutil, os, tempfile
    th_of = W
    tm = np.linspace(gt[0], gt[-1], 4000)
    taus = np.linspace(-0.03, 0.03, 241)
    costs = [ss_fn(x)[0] for x in taus]
    step = max(1, len(gt) // 2400)
    plot_data = {
        "title": "Calibration diagnostics | b=%.6f rad/s, tau=%.6f s, psi=%.6f rad"
                 % (b, tau, psi),
        "gyro_t": gt[::step].tolist(), "gyro_w": gw[::step].tolist(),
        "seg_t0": seg["t0_lidar_s"].tolist(), "seg_t1": seg["t1_lidar_s"].tolist(),
        "head_t": tm.tolist(), "head_th": th_of(tm).tolist(),
        "lid_t": (t0[tr] + tau).tolist(),
        "lid_cum": (np.cumsum(dyaw[tr]) - dyaw[tr] / 2).tolist(),
        "ryt": t0[tr].tolist(), "ryv": r_yaw_tr.tolist(),
        "rht": t0[ho].tolist(), "rhv": r_yaw_ho.tolist(),
        "s_yaw": float(np.sqrt(s2_yaw)),
        "hist_edges": np.linspace(-0.025, 0.025, 51).tolist(),
        "hist_tr": np.histogram(r_yaw_tr, bins=np.linspace(-0.025, 0.025, 51), density=True)[0].tolist(),
        "hist_ho": np.histogram(r_yaw_ho, bins=np.linspace(-0.025, 0.025, 51), density=True)[0].tolist(),
        "dth_tr": dth_cal[tr].tolist(), "rt_tr": r_trans_tr.tolist(),
        "dth_ho": dth_ho.tolist(), "rt_ho": r_trans_ho.tolist(),
        "sig_trans": SIG_TRANS,
        "taus": taus.tolist(), "costs": np.log10(np.array(costs) + 1e-12).tolist(),
        "tau_hat": float(tau),
    }
    fd, jpath = tempfile.mkstemp(suffix=".json"); os.close(fd)
    with open(jpath, "w") as f:
        json.dump(plot_data, f)
    py314 = shutil.which("python3.14") or "/usr/bin/python3.14"
    try:
        subprocess.run([py314, "-c", RENDER_SRC, jpath], check=True)
    finally:
        os.remove(jpath)

    # ---------------- 7. metrics.json (self-describing; schema not specified)
    rms = lambda v: float(np.sqrt(np.mean(v**2)))
    metrics = {
        "schema_note": "Self-describing metrics file; task_info.json does not specify a schema for metrics.json.",
        "method": {
            "fit_rows": "split=='train' only (n=%d); heldout (n=%d) used only for residuals.csv and diagnostics" % (n_tr, int(ho.sum())),
