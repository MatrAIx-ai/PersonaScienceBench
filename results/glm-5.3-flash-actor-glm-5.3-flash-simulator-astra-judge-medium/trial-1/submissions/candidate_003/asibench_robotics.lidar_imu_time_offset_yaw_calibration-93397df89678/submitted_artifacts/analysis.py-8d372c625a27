        dr.line([x0 - 5, py, x0, py], fill="black")
        lab = "%.3g" % tv
        dr.text((x0 - 8 - dr.textlength(lab, font=FS), py - 7), lab, fill="black", font=FS)

BLUE, RED, GREY = (40, 90, 200), (210, 50, 50), (150, 150, 150)
gt, gw = D["gyro_t"], D["gyro_w"]
xr = (min(gt), max(gt))

r = setup(0, 0, "Gyro stream (alternating segment windows shaded)", "IMU time [s]", "omega_z [rad/s]")
yr = (min(gw) - 0.02, max(gw) + 0.02)
for k in range(len(D["seg_t0"])):
    if k % 2 == 0:
        a = mp(D["seg_t0"][k], 0, r, xr, yr)[0]; b2 = mp(D["seg_t1"][k], 0, r, xr, yr)[0]
        dr.rectangle([a, r[1], b2, r[3]], fill=(246, 246, 246))
curve(r, gt, gw, xr, yr, (30, 60, 160), 1)
