#!/usr/bin/env python3
"""
Deterministic target-tracking audit from data/measurements.npz.

Data structure (established by inspection):
  Y    float64 (95, 2)  : channel 0 = range (strictly positive, U-shaped),
                          channel 1 = bearing in (-pi, pi]
  t    float64 (95, )   : uniform grid, dt = 1.0
  mask bool    (95, 2)  : valid-observation flags (NaN in Y exactly where mask is False)

Estimator: bootstrap particle filter (N = 1200 <= 1500), fixed seed, log-domain weights.
State (6-D): [x, y, vx, vy, beta_b, beta_r]
  - (x, y, vx, vy): Cartesian target state in the sensor frame (sensor at origin).
  - beta_b: slowly drifting additive bearing bias (random walk).
  - beta_r: slowly drifting additive range bias (random walk).
Motion: constant velocity + switching process noise (2-mode Markov chain per particle:
nominal / maneuver) plus a small i.i.d. "kick" probability per particle per step, so that
sharp regime changes (the encounter around t=32..54) can be captured by weight competition.
Measurement likelihood: per-channel, skipped entirely when the channel is masked.
  range   : r_meas = hypot(x, y) + beta_r + nu_r        (mixture Gaussian / wide tail)
  bearing : th_meas = atan2(y, x) + beta_b + nu_theta   (mixture WRAPPED normal / wide tail)
Angle wrapping: all bearing innovations are wrapped to (-pi, pi]; wrap events are counted
on the OBSERVATIONS with the criterion |consecutive bearing difference| > pi.

DIAGNOSTIC PROXIES (documented): the true state trajectory is NOT public, therefore
  rmse_pos = RMS position-equivalent measurement residual
             (range residual; bearing residual x predicted range), 0.0 fallback
             when no channel is available at a step.
  rmse_vel = dynamics-consistency velocity proxy
             ( || v_est(t) - (p_est(t) - p_est(t-1)) / dt || ; ||v_est(0)|| at t=0 ).
  nees     = NEES-style proxy implemented as the normalized innovation squared (NIS)
             of the available channels against the predicted measurement covariance
             (0.0 fallback when no channel is available at a step).
These are filter-internal consistency/fit proxies, NOT true tracking errors.

No replacement observations are generated anywhere: masked channels are skipped in the
likelihood, never filled.
"""

import json
import os

import numpy as np
import pandas as pd

try:
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt
    HAVE_MPL = True
except Exception:
    HAVE_MPL = False

# ----------------------------------------------------------------------------
# Configuration
# ----------------------------------------------------------------------------
SEED = 42
N_PARTICLES = 1200          # <= 1500 (contract cap)
DT = 1.0

SIG_R0 = 0.08               # nominal range noise std
SIG_B0 = 0.02               # nominal bearing noise std
TAIL_SCALE = 15.0           # wide-tail multiplier for the outlier mixture
MIX_MAIN = 0.9              # Gaussian mixture weight of the main component

Q_POS_NOM = 0.01            # nominal per-step position noise std
Q_VEL_NOM = 0.01            # nominal per-step velocity noise std
Q_POS_MAN = 0.06            # maneuver-mode per-step position noise std
Q_VEL_MAN = 0.10            # maneuver-mode per-step velocity noise std
KICK_PROB = 0.02            # i.i.d. per-particle probability of a strong kick
Q_POS_KICK = 0.35
Q_VEL_KICK = 0.35

Q_BETA_B = 0.002            # per-step bearing-bias random-walk std
Q_BETA_R = 0.010            # per-step range-bias random-walk std

P_ENTER = 0.05              # nominal -> maneuver switching probability
P_EXIT = 0.30               # maneuver -> nominal switching probability

ESS_RESAMPLE = 0.5          # resample when ESS < fraction of N
ESS_INFLATE = 0.15          # trigger mild sigma inflation below this ESS fraction
INFLATE_STEP = 1.5
INFLATE_MAX = 4.0

COV_FLOOR = 1e-8            # covariance floor for degenerate particle spreads
W_CLAMP = 1e-300            # clamp for normalized weights (keeps logs finite)

RNG = np.random.default_rng(SEED)
RESULT_DIR = "results"


def wrap(a):
    """Wrap angles to (-pi, pi]."""
    return (a + np.pi) % (2.0 * np.pi) - np.pi


def logsumexp(a):
    m = np.max(a)
    return m + np.log(np.sum(np.exp(a - m)))


def log_normal(x, sigma):
    return -0.5 * (x / sigma) ** 2 - np.log(sigma) - 0.5 * np.log(2.0 * np.pi)


def log_mixture(d, sigma):
    """log density of MIX_MAIN*N(0,sigma) + (1-MIX_MAIN)*N(0,TAIL_SCALE*sigma)."""
    main = np.log(MIX_MAIN) + log_normal(d, sigma)
    tail = np.log(1.0 - MIX_MAIN) + log_normal(d, TAIL_SCALE * sigma)
    return np.logaddexp(main, tail)


def log_wrapped_mixture(d, sigma):
    """log density of a wrapped normal mixture (3-term wrap sum is ample here)."""
    total = None
    for k in (-1.0, 0.0, 1.0):
        lk = log_mixture(d + 2.0 * np.pi * k, sigma)
        total = lk if total is None else np.logaddexp(total, lk)
    return total


# ----------------------------------------------------------------------------
# Load data
# ----------------------------------------------------------------------------
data = np.load("data/measurements.npz", allow_pickle=True)
Y = np.asarray(data["Y"], dtype=float)
t = np.asarray(data["t"], dtype=float)
mask = np.asarray(data["mask"], dtype=bool)
n_steps = len(t)

assert Y.shape == (n_steps, 2) and mask.shape == (n_steps, 2)
assert np.all(np.isfinite(t)) and np.all(np.diff(t) > 0)

r_meas = np.where(mask[:, 0], Y[:, 0], np.nan)
b_meas = np.where(mask[:, 1], Y[:, 1], np.nan)
b_unwrapped = np.unwrap(np.where(mask[:, 1], b_meas, np.nan))

# Angle-wrap events counted on the OBSERVATIONS: |consecutive bearing diff| > pi.
bv = b_meas[mask[:, 1]]
wrap_events = int(np.sum(np.abs(np.diff(bv)) > np.pi))

# ----------------------------------------------------------------------------
# Particle filter
# ----------------------------------------------------------------------------
# Initial particle cloud around the first implied (range, bearing) fix.
r0, b0 = Y[0, 0], Y[0, 1]
p0 = np.array([r0 * np.cos(b0), r0 * np.sin(b0)])

particles = np.empty((N_PARTICLES, 6))
particles[:, 0] = p0[0] + Q_POS_KICK * RNG.standard_normal(N_PARTICLES)
particles[:, 1] = p0[1] + Q_POS_KICK * RNG.standard_normal(N_PARTICLES)
particles[:, 2] = 0.02 + 0.08 * RNG.standard_normal(N_PARTICLES)   # vx prior
particles[:, 3] = 0.00 + 0.08 * RNG.standard_normal(N_PARTICLES)   # vy prior
particles[:, 4] = 0.00 + 0.05 * RNG.standard_normal(N_PARTICLES)   # beta_b
particles[:, 5] = 0.00 + 0.15 * RNG.standard_normal(N_PARTICLES)   # beta_r

log_w = np.full(N_PARTICLES, -np.log(N_PARTICLES))
maneuver = np.zeros(N_PARTICLES, dtype=bool)

inflate = 1.0
est_hist = np.full((n_steps, 4), np.nan)
cov_hist = np.full((n_steps, 4), np.nan)
ess_hist = np.full(n_steps, np.nan)
resampled_hist = np.zeros(n_steps, dtype=int)
entropy_hist = np.full(n_steps, np.nan)
maxlw_hist = np.full(n_steps, np.nan)
minlw_hist = np.full(n_steps, np.nan)
bres_mean_hist = np.full(n_steps, np.nan)
bres_std_hist = np.full(n_steps, np.nan)
rmse_pos_hist = np.full(n_steps, np.nan)
rmse_vel_hist = np.full(n_steps, np.nan)
nees_hist = np.full(n_steps, np.nan)
n_resample_total = 0
max_weight_seen = 0.0

for k in range(n_steps):
    # ---------------- prediction ----------------
    pos_std = np.where(maneuver, Q_POS_MAN, Q_POS_NOM)
    vel_std = np.where(maneuver, Q_VEL_MAN, Q_VEL_NOM)

    particles[:, 0] += particles[:, 2] * DT + pos_std * RNG.standard_normal(N_PARTICLES)
    particles[:, 1] += particles[:, 3] * DT + pos_std * RNG.standard_normal(N_PARTICLES)
    particles[:, 2] += vel_std * RNG.standard_normal(N_PARTICLES)
    particles[:, 3] += vel_std * RNG.standard_normal(N_PARTICLES)
    particles[:, 4] += Q_BETA_B * RNG.standard_normal(N_PARTICLES)
    particles[:, 5] += Q_BETA_R * RNG.standard_normal(N_PARTICLES)

    # mode switching (Markov chain) + small i.i.d. kick fraction
    u = RNG.random(N_PARTICLES)
    enter = (~maneuver) & (u < P_ENTER)
    exitm = maneuver & (u > 1.0 - P_EXIT)
    maneuver = (maneuver & ~exitm) | enter
    kick = RNG.random(N_PARTICLES) < KICK_PROB
    if np.any(kick):
        particles[kick, 0] += Q_POS_KICK * RNG.standard_normal(int(kick.sum()))
        particles[kick, 1] += Q_POS_KICK * RNG.standard_normal(int(kick.sum()))
        particles[kick, 2] += Q_VEL_KICK * RNG.standard_normal(int(kick.sum()))
        particles[kick, 3] += Q_VEL_KICK * RNG.standard_normal(int(kick.sum()))

    # ---------------- predicted measurements ----------------
    r_pred = np.hypot(particles[:, 0], particles[:, 1])
    th_pred = np.arctan2(particles[:, 1], particles[:, 0])

    sig_r = SIG_R0 * inflate
    sig_b = SIG_B0 * inflate

    # ---------------- per-channel likelihood (masked channels skipped) --------
    ll = np.zeros(N_PARTICLES)
    ch_available = 0
    innov_r = None
    innov_b = None

    if mask[k, 0]:
        d_r = r_meas[k] - (r_pred + particles[:, 5])
        ll = ll + log_mixture(d_r, sig_r)
        ch_available += 1
        innov_r = d_r
    if mask[k, 1]:
        d_b = wrap(b_meas[k] - (th_pred + particles[:, 4]))
        ll = ll + log_wrapped_mixture(d_b, sig_b)
        ch_available += 1
        innov_b = d_b

    log_w = log_w + ll
    log_w -= logsumexp(log_w)
    w = np.exp(log_w)
    w = np.maximum(w, W_CLAMP)
    w /= w.sum()
    log_w = np.log(w)

    # ---------------- weighted statistics ----------------
    ess = 1.0 / np.sum(w ** 2)
    ess_hist[k] = ess
    entropy_hist[k] = -np.sum(w * np.log(w))
    maxlw_hist[k] = np.max(log_w)
    minlw_hist[k] = np.min(log_w)
    max_weight_seen = max(max_weight_seen, float(np.max(w)))

    mean = w @ particles[:, :4]
    centered = particles[:, :4] - mean
    cov = (centered * w[:, None]).T @ centered
    denom = max(1.0 - np.sum(w ** 2), 1e-3)
    cov = cov / denom
    cov = cov + np.eye(4) * COV_FLOOR
    est_hist[k] = mean
    cov_hist[k] = np.clip(np.diag(cov), COV_FLOOR, None)

    # ---------------- diagnostic proxies ----------------
    res_pos = []
    nis_terms = []
    if mask[k, 0]:
        dr = float(np.sum(w * innov_r))
        res_pos.append(dr)
        var_r = float(np.sum(w * (innov_r - dr) ** 2)) + sig_r ** 2
        nis_terms.append(dr ** 2 / max(var_r, 1e-12))
    if mask[k, 1]:
        db = float(np.sum(w * innov_b))
        r_ref = float(np.sum(w * r_pred))
        res_pos.append(db * r_ref)
        var_b = float(np.sum(w * (innov_b - db) ** 2)) + sig_b ** 2
        nis_terms.append(db ** 2 / max(var_b, 1e-12))
        bres_mean_hist[k] = db
        bres_std_hist[k] = float(np.sqrt(max(var_b - sig_b ** 2, 0.0)))
    else:
        # documented finite fallback: bearing channel unavailable at this step
        bres_mean_hist[k] = 0.0
        bres_std_hist[k] = 0.0

    rmse_pos_hist[k] = float(np.sqrt(np.mean(np.square(res_pos)))) if res_pos else 0.0
    nees_hist[k] = float(np.mean(nis_terms)) if nis_terms else 0.0

    if k == 0:
        rmse_vel_hist[k] = float(np.hypot(mean[2], mean[3]))
    else:
        v_dyn = mean[2:4] - (mean[0:2] - est_hist[k - 1, 0:2]) / DT
        rmse_vel_hist[k] = float(np.hypot(v_dyn[0], v_dyn[1]))

    # ---------------- resampling ----------------
    do_resample = ess < ESS_RESAMPLE * N_PARTICLES
    resampled_hist[k] = int(do_resample)
    if do_resample:
        positions = (RNG.random() + np.arange(N_PARTICLES)) / N_PARTICLES
        idx = np.searchsorted(np.cumsum(w), positions)
        idx = np.clip(idx, 0, N_PARTICLES - 1)
        particles = particles[idx].copy()
        maneuver = maneuver[idx].copy()
        log_w = np.full(N_PARTICLES, -np.log(N_PARTICLES))
        n_resample_total += 1

    # mild adaptive sigma inflation instead of lowering the resample threshold
    if ess < ESS_INFLATE * N_PARTICLES:
        inflate = min(inflate * INFLATE_STEP, INFLATE_MAX)
    else:
        inflate = max(1.0, inflate / 1.2)

# ----------------------------------------------------------------------------
# Finiteness assertions before writing anything
# ----------------------------------------------------------------------------
def assert_finite(name, arr):
    if not np.all(np.isfinite(arr)):
        raise RuntimeError(f"non-finite values produced in {name}")


assert_finite("state estimates", est_hist)
assert_finite("covariances", cov_hist)
for arr in (ess_hist, entropy_hist, maxlw_hist, minlw_hist, bres_mean_hist,
            bres_std_hist, rmse_pos_hist, rmse_vel_hist, nees_hist):
    assert_finite("diagnostics", arr)

# ----------------------------------------------------------------------------
# state_estimates.csv
# ----------------------------------------------------------------------------
state_df = pd.DataFrame({
    "t": t,
    "px": est_hist[:, 0],
    "py": est_hist[:, 1],
    "vx": est_hist[:, 2],
    "vy": est_hist[:, 3],
    "cov_px": cov_hist[:, 0],
    "cov_py": cov_hist[:, 1],
    "cov_vx": cov_hist[:, 2],
    "cov_vy": cov_hist[:, 3],
})
state_df.to_csv(os.path.join(RESULT_DIR, "state_estimates.csv"), index=False)

# ----------------------------------------------------------------------------
# filter_diagnostics.csv
# ----------------------------------------------------------------------------
diag_df = pd.DataFrame({
    "t": t,
    "rmse_pos": rmse_pos_hist,
    "rmse_vel": rmse_vel_hist,
    "nees": nees_hist,
    "ess": ess_hist,
    "resampled": resampled_hist,
    "weight_entropy": entropy_hist,
    "max_log_weight": maxlw_hist,
    "min_log_weight": minlw_hist,
    "bearing_residual_mean": bres_mean_hist,
    "bearing_residual_std": bres_std_hist,
})
diag_df.to_csv(os.path.join(RESULT_DIR, "filter_diagnostics.csv"), index=False)

# ----------------------------------------------------------------------------
# summary.json
# ----------------------------------------------------------------------------
steps_with_channels = rmse_pos_hist > 0.0
if not np.any(steps_with_channels):
    steps_with_channels = np.ones(n_steps, dtype=bool)

summary = {
    "pos_rmse": float(np.mean(rmse_pos_hist[steps_with_channels])),
    "vel_rmse": float(np.mean(rmse_vel_hist)),
    "mean_nees": float(np.mean(nees_hist[steps_with_channels])),
    "median_nees": float(np.median(nees_hist[steps_with_channels])),
    "ess_min": float(np.min(ess_hist)),
    "ess_mean": float(np.mean(ess_hist)),
    "resampling_count": int(n_resample_total),
    "weight_degeneracy_detected": bool(np.min(ess_hist) < 0.1 * N_PARTICLES
                                       or max_weight_seen > 0.99),
    "used_log_weights": True,
    "angle_wrapping_detected": bool(wrap_events > 0),
    "angle_wrap_event_count": wrap_events,
}
assert all(np.isfinite(v) for v in summary.values() if isinstance(v, float))
with open(os.path.join(RESULT_DIR, "summary.json"), "w") as fh:
    json.dump(summary, fh, indent=2)

# ----------------------------------------------------------------------------
# overview.png  (matplotlib if available, otherwise a stdlib-only renderer)
# ----------------------------------------------------------------------------
OVERVIEW_PATH = os.path.join(RESULT_DIR, "overview.png")
valid_both = mask[:, 0] & mask[:, 1]
implied = np.column_stack([r_meas * np.cos(b_unwrapped),
                           r_meas * np.sin(b_unwrapped)])
r_pred_mean = np.hypot(est_hist[:, 0], est_hist[:, 1])
pred_b_unwrap = np.unwrap(np.where(mask[:, 1],
                                   np.arctan2(est_hist[:, 1], est_hist[:, 0]),
                                   np.nan))

if HAVE_MPL:
    fig, axes = plt.subplots(2, 2, figsize=(13, 10))

    ax = axes[0, 0]
    ax.plot(implied[valid_both, 0], implied[valid_both, 1], ".", ms=4,
            color="0.6", label="implied by measurements (r, theta)")
    ax.plot(est_hist[:, 0], est_hist[:, 1], "-", color="tab:red", lw=1.5,
            label="PF estimate")
    ax.plot(est_hist[0, 0], est_hist[0, 1], "g^", label="start")
    ax.plot(est_hist[-1, 0], est_hist[-1, 1], "bv", label="end")
    ax.set_xlabel("x"); ax.set_ylabel("y")
    ax.set_title("Estimated trajectory vs measurement-implied positions")
    ax.legend(fontsize=8); ax.set_aspect("equal", adjustable="datalim")

    ax = axes[0, 1]
    ax.plot(t, r_meas, ".", color="tab:blue", ms=4, label="range observations")
    ax.plot(t, r_pred_mean, "-", color="tab:red", lw=1.2, label="PF predicted range")
    ax.set_xlabel("t"); ax.set_ylabel("range")
    ax.set_title("Range channel (gap t=22..31 skipped, not filled)")
    ax.legend(fontsize=8)

    ax = axes[1, 0]
    ax.plot(t, b_unwrapped, ".", color="tab:purple", ms=4,
            label="bearing observations (unwrapped)")
    ax.plot(t, pred_b_unwrap, "-", color="tab:red", lw=1.2,
            label="PF predicted bearing (unwrapped)")
    ax.set_xlabel("t"); ax.set_ylabel("unwrapped bearing [rad]")
    ax.set_title("Bearing channel: one +/-pi wrap at t=5->6; gap t=55..63 skipped")
    ax.legend(fontsize=8)

    ax = axes[1, 1]
    ax2 = ax.twinx()
    ax.plot(t, ess_hist, "-", color="tab:green", label="ESS")
    ax.axhline(0.5 * N_PARTICLES, ls="--", color="0.5", lw=0.8)
    ax.set_xlabel("t"); ax.set_ylabel("ESS", color="tab:green")
    ax2.plot(t, nees_hist, "-", color="tab:orange", label="NIS (NEES proxy)")
    ax2.set_ylabel("NIS proxy", color="tab:orange")
    ax.set_title("ESS / resampling and normalized-innovation proxy")

    fig.suptitle("Particle-filter target tracking audit (N=1200, seed=42)", fontsize=13)
    fig.tight_layout(rect=[0, 0, 1, 0.96])
    fig.savefig(OVERVIEW_PATH, dpi=130)
    plt.close(fig)
else:
    # ------------------- stdlib-only fallback renderer -------------------------
    import struct as _struct
    import zlib as _zlib

    _FONT = {
