    BLACK = (0, 0, 0); GRAY = (150, 150, 150)
    RED = (204, 26, 26); BLUE = (30, 60, 200); PURPLE = (130, 40, 170)
    GREEN = (20, 140, 60); ORANGE = (235, 130, 20)

    _W, _H = 1600, 1200
    img = np.full((_H, _W, 3), 255, dtype=np.uint8)

    def _blit(x, y, col):
        if 0 <= int(y) < _H and 0 <= int(x) < _W:
            img[int(y), int(x)] = col

    def _dot(x, y, col, rad=2):
        cx, cy = int(round(x)), int(round(y))
        for yy in range(cy - rad, cy + rad + 1):
            for xx in range(cx - rad, cx + rad + 1):
                _blit(xx, yy, col)

    def _line(x0, y0, x1, y1, col):
        x0, y0, x1, y1 = int(x0), int(y0), int(x1), int(y1)
        dx = abs(x1 - x0); dy = -abs(y1 - y0)
        sx = 1 if x0 < x1 else -1; sy = 1 if y0 < y1 else -1
        err = dx + dy
        while True:
            _blit(x0, y0, col)
            if x0 == x1 and y0 == y1:
                break
            e2 = 2 * err
            if e2 >= dy:
                err += dy; x0 += sx
            if e2 <= dx:
                err += dx; y0 += sy

    def _text(x, y, s, col, scale=2):
        cx = int(x)
        for ch in str(s).upper():
            g = _FONT.get(ch, _FONT[' '])
            for r in range(7):
                row = g[r]
                for c in range(5):
                    if row[c] == 'X':
                        ys = int(y) + r * scale; xs = cx + c * scale
                        img[max(0, ys):min(_H, ys + scale),
                            max(0, xs):min(_W, xs + scale)] = col
            cx += 6 * scale

    def _fmt(v, step):
        if step >= 1:
            return f"{v:.0f}"
        dec = max(0, int(np.ceil(-np.log10(step))))
        return f"{v:.{dec}f}"

    def _ticks(lo, hi, n=5):
        span = hi - lo
        if not np.isfinite(span) or span <= 0:
            span = 1.0
        raw = span / max(n, 1)
        mag = 10.0 ** np.floor(np.log10(raw))
        step = mag
        for m in (1, 2, 5, 10):
            if raw <= m * mag:
                step = m * mag
                break
        t0 = np.ceil(lo / step) * step
        return np.arange(t0, hi + step * 1e-6, step), step

    def _panel(px0, py0, px1, py1, title, series, xlabel, ylabel, legend,
               equal=False, y2series=None, y2label=None):
        allx = np.concatenate([np.asarray(s[0], dtype=float) for s in series])
        ally = np.concatenate([np.asarray(s[1], dtype=float) for s in series])
        ok = np.isfinite(allx) & np.isfinite(ally)
        allx, ally = allx[ok], ally[ok]
        lx0, lx1 = allx.min(), allx.max()
        ly0, ly1 = ally.min(), ally.max()
        padx = 0.05 * (lx1 - lx0 if lx1 > lx0 else 1.0)
        pady = 0.08 * (ly1 - ly0 if ly1 > ly0 else 1.0)
        lx0, lx1, ly0, ly1 = lx0 - padx, lx1 + padx, ly0 - pady, ly1 + pady
        ax0, ay0 = px0 + 90, py0 + 70
        ax1, ay1 = px1 - 20, py1 - 70
        if equal:
            xr, yr = lx1 - lx0, ly1 - ly0
            sx_, sy_ = xr / max(ax1 - ax0, 1), yr / max(ay1 - ay0, 1)
            if sx_ > sy_:
                c = 0.5 * (ly0 + ly1); half = 0.5 * yr * (sx_ / sy_)
                ly0, ly1 = c - half, c + half
            else:
                c = 0.5 * (lx0 + lx1); half = 0.5 * xr * (sy_ / sx_)
                lx0, lx1 = c - half, c + half

        def mx(x):
            return ax0 + (x - lx0) / (lx1 - lx0) * (ax1 - ax0)

        def my(y):
            return ay1 - (y - ly0) / (ly1 - ly0) * (ay1 - ay0)

        _line(ax0, ay0, ax1, ay0, BLACK); _line(ax1, ay0, ax1, ay1, BLACK)
        _line(ax0, ay1, ax1, ay1, BLACK); _line(ax0, ay0, ax0, ay1, BLACK)

        ts, st = _ticks(lx0, lx1)
        for v in ts:
            X = mx(v)
            _line(X, ay1, X, ay1 + 5, BLACK)
            _text(X - 3 * len(_fmt(v, st)), ay1 + 10, _fmt(v, st), BLACK, 1)
        _text(0.5 * (ax0 + ax1) - 6 * len(xlabel), py1 - 40, xlabel, BLACK, 2)

        ts, st = _ticks(ly0, ly1)
        for v in ts:
            Yp = my(v)
            _line(ax0 - 5, Yp, ax0, Yp, BLACK)
            lab = _fmt(v, st)
            _text(ax0 - 12 - 6 * len(lab), Yp - 5, lab, BLACK, 1)
        _text(ax0 + 4, py0 + 32, "Y-AXIS: " + ylabel, BLACK, 1)

        _text(0.5 * (ax0 + ax1) - 6 * len(title), py0 + 6, title, BLACK, 2)

        ly = py0 + 46
        for col, lab in legend:
            _dot(ax0 + 12, ly + 4, col, 3)
            _text(ax0 + 22, ly, lab, BLACK, 1)
            ly += 13

        for xs, ys, col, mode in series:
            xs = np.asarray(xs, dtype=float); ys = np.asarray(ys, dtype=float)
            okm = np.isfinite(xs) & np.isfinite(ys)
            xs, ys = xs[okm], ys[okm]
            if mode == 'line':
                for i in range(len(xs) - 1):
                    _line(mx(xs[i]), my(ys[i]), mx(xs[i + 1]), my(ys[i + 1]), col)
            else:
                for X, Yp in zip(xs, ys):
                    _dot(mx(X), my(Yp), col, 2)

        if y2series is not None:
            ys2 = np.asarray(y2series[1], dtype=float)
            ok2 = np.isfinite(ys2)
            y2lo, y2hi = np.min(ys2[ok2]), np.max(ys2[ok2])
            _text(ax1 - 230, py0 + 32, "2ND AXIS: " + y2label, BLACK, 1)
            for i in range(len(ys2) - 1):
                if not (np.isfinite(ys2[i]) and np.isfinite(ys2[i + 1])):
                    continue
                u0 = (ys2[i] - y2lo) / max(y2hi - y2lo, 1e-12)
                u1 = (ys2[i + 1] - y2lo) / max(y2hi - y2lo, 1e-12)
                _line(mx(y2series[0][i]), ay1 - u0 * (ay1 - ay0),
                      mx(y2series[0][i + 1]), ay1 - u1 * (ay1 - ay0), ORANGE)

    _text(0.5 * _W - 6 * 33, 14,
          "PARTICLE-FILTER TARGET-TRACKING AUDIT (N=1200, SEED=42)", BLACK, 2)

    _panel(20, 50, 790, 590,
           "TRAJECTORY: IMPLIED (GRAY) VS PF ESTIMATE (RED)",
           [(implied[:, 0], implied[:, 1], GRAY, 'dot'),
            (est_hist[:, 0], est_hist[:, 1], RED, 'line')],
           "X", "Y",
           [(GRAY, "IMPLIED BY (R,THETA)"), (RED, "PF ESTIMATE")], equal=True)

    _panel(810, 50, 1580, 590, "RANGE CHANNEL (GAP T=22..31 SKIPPED, NOT FILLED)",
           [(t, r_meas, BLUE, 'dot'), (t, r_pred_mean, RED, 'line')],
           "T", "RANGE",
           [(BLUE, "OBSERVATIONS"), (RED, "PF PREDICTED RANGE")])

    _panel(20, 610, 790, 1150,
           "BEARING UNWRAPPED: WRAP AT T=5>6, GAP T=55..63 SKIPPED",
           [(t, b_unwrapped, PURPLE, 'dot'), (t, pred_b_unwrap, RED, 'line')],
           "T", "BEARING RAD",
           [(PURPLE, "OBSERVATIONS"), (RED, "PF PREDICTED")])

    ess_arr = np.asarray(ess_hist, dtype=float)
    nis_arr = np.asarray(nees_hist, dtype=float)
    nis_scale = 1000.0 / max(np.nanmax(nis_arr), 1e-9)
    _panel(810, 610, 1580, 1150,
           "ESS AND NIS (NEES-STYLE PROXY) VS T",
           [(t, ess_arr, GREEN, 'line')],
           "T", f"ESS  (NIS X {nis_scale:.3g})",
           [(GREEN, "ESS (THRESHOLD N/2)"), (ORANGE, "NIS PROXY, 2ND AXIS")],
           y2series=(t, nis_arr), y2label="NIS")

    raw = np.zeros((_H, 1 + _W * 3), dtype=np.uint8)
    raw[:, 0] = 0
    raw[:, 1:] = img.reshape(_H, _W * 3)
    comp = _zlib.compress(raw.tobytes(), 6)

    def _chunk(typ, payload):
        return (_struct.pack(">I", len(payload)) + typ + payload
                + _struct.pack(">I", _zlib.crc32(typ + payload) & 0xFFFFFFFF))

    ihdr = _struct.pack(">IIBBBBB", _W, _H, 8, 2, 0, 0, 0)
    with open(OVERVIEW_PATH, "wb") as fh:
        fh.write(b"\x89PNG\r\n\x1a\n")
        fh.write(_chunk(b"IHDR", ihdr))
        fh.write(_chunk(b"IDAT", comp))
        fh.write(_chunk(b"IEND", b""))

