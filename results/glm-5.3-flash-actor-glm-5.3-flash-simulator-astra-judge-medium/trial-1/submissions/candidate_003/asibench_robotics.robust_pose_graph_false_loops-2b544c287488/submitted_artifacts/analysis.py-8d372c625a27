    txt(px0, py0 + ph + 105, "gray = initial dead-reckoned path   blue = optimized trajectory", 11)
    txt(px0, py0 + ph + 85, "loop edges colored by false_probability: green < 0.5 (accepted), "
        "red >= 0.5 (rejected), orange = borderline", 11)
    txt(px0, py0 + ph + 65, "faint = loop drawn on initial poses, solid = on final poses; "
        "black square = anchor pose 0", 11)
    txt(px0 + pw / 2, 30, f"x range [{xmin:.1f}, {xmax:.1f}] m", 11, align="center")
    ops.append("gsave")
    txt(px0 - 40, py0 + ph / 2, "y [m]", 11, align="center")

    # ================= right panel: chi2 histogram (log bins) ================
    hx0, hy0, hw, hh = 880.0, 110.0, 560.0, 480.0
    lo = max(float(chi2_all.min()), 1e-3)
    hi = float(chi2_all.max()) * 1.3
    nb = 25
    binedges = np.logspace(np.log10(lo), np.log10(hi), nb + 1)
    cnt_a = np.histogram(chi2_all[keep], bins=binedges)[0] if keep.any() else np.zeros(nb)
    cnt_r = np.histogram(chi2_all[~keep], bins=binedges)[0] if (~keep).any() else np.zeros(nb)
    hmax = max(float((cnt_a + cnt_r).max()), 1.0)

    def x_of(chi2v):
        t = (np.log10(chi2v) - np.log10(lo)) / (np.log10(hi) - np.log10(lo))
        return hx0 + t * hw
    bw = hw / nb
    for b in range(nb):
        xa = hx0 + b * bw
        ha = cnt_a[b] / hmax * (hh - 10)
        hr = cnt_r[b] / hmax * (hh - 10)
        if hr > 0:
            rect(xa, hy0, bw * 0.48, hr, RED)
        if ha > 0:
            rect(xa + bw * 0.5, hy0, bw * 0.48, ha, GREEN)
    line(hx0, hy0, hx0 + hw, hy0, BLACK, 1.5)
    line(hx0, hy0, hx0, hy0 + hh, BLACK, 1.5)
    dec = [d for d in range(int(np.floor(np.log10(lo))), int(np.ceil(np.log10(hi))) + 1)
           if lo <= 10 ** d <= hi]
    for d in dec:
        xt = x_of(10 ** d)
        line(xt, hy0, xt, hy0 - 6, BLACK, 1.0)
        txt(xt, hy0 - 24, f"1e{d}", 10, align="center")
    txt(hx0 + hw / 2, hy0 - 50, "whitened loop residual chi2 (3 dof), log axis", 12, align="center")
    if keep.any() and (~keep).any():
        txt(hx0, hy0 + hh + 45, f"green = accepted (max chi2 {chi2_all[keep].max():.2f})    "
            f"red = rejected (min chi2 {chi2_all[~keep].min():.2f})", 11)
    else:
        txt(hx0, hy0 + hh + 45, "green = accepted   red = rejected", 11)
    txt(hx0, hy0 + hh + 25, f"EM mixture: outlier weight pi_out = {pi_out:.3f}, "
        f"outlier scale lambda = {lam:.1f}", 11)
    txt(hx0, hy0 + hh + 70, "Loop-candidate residual separation", 13)
    ops.append("grestore")

    import tempfile, shutil
    # ghostscript is sandboxed away from the workspace in this runtime, so the
    # PS is rendered and converted inside a temp dir, then copied back.
    with tempfile.TemporaryDirectory() as td:
        ps_path = os.path.join(td, "map_diagnostics.ps")
        png_path = os.path.join(td, "map_diagnostics.png")
        with open(ps_path, "w") as f:
            f.write("%!PS\n%%BoundingBox: 0 0 1500 720\n")
            f.write(f"%%PageBoundingBox: 0 0 {PW:.0f} {PH:.0f}\n1 1 1 setrgbcolor "
                    f"0 0 {PW:.0f} {PH:.0f} rectfill\n")
            f.write("\n".join(ops) + "\nshowpage\n")
        r = subprocess.run(
            ["gs", "-dNOPAUSE", "-dBATCH", "-sDEVICE=png16m", "-r72",
             "-dDEVICEWIDTHPOINTS=1500", "-dDEVICEHEIGHTPOINTS=720",
             "-sOutputFile=" + png_path, ps_path],
            capture_output=True, text=True, cwd=td)
        if r.returncode != 0:
            raise RuntimeError(f"ghostscript failed: {r.stderr[-500:]}")
        shutil.copy(png_path, "map_diagnostics.png")
    PLOT_BACKEND = "ghostscript(ps->png)"

metrics["plot_backend"] = PLOT_BACKEND
with open("metrics.json", "w") as f:
    json.dump(metrics, f, indent=2)

print("PLOT_BACKEND:", PLOT_BACKEND)
print("converged:", conv_final, "| final cost:", round(cost_final, 4))
print("accepted:", int(keep.sum()), "rejected:", int((~keep).sum()),
      "| pi_out:", round(pi_out, 3), "| lam:", round(lam, 1))
print("odom chi2: max", round(float(odom_chi2.max()), 3),
      "mean", round(float(odom_chi2.mean()), 3))
if keep.any() and (~keep).any():
    print("accepted chi2 max:", round(float(chi2_all[keep].max()), 3),
          "| rejected chi2 min:", round(float(chi2_all[~keep].min()), 3))
print("p_false per loop:", np.round(p_false, 3).tolist())
