    poly([m2p(p) for p in P0[:, :2]], GRAYC, 1.5)       # dead-reckoned path
    poly([m2p(p) for p in P_out[:, :2]], BLUEC, 1.8)    # optimized path
    for k, (i, j, _) in enumerate(loop_edges):          # final-frame loops
        a, b = m2p(P_out[i, :2]), m2p(P_out[j, :2])
        line(a[0], a[1], b[0], b[1], loop_col(p_false[k]), 1.6)
