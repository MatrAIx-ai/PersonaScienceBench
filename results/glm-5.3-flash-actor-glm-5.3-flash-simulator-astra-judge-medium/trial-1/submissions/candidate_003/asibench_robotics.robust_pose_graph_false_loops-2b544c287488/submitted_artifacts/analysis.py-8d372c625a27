    ax.hist(chi2_all[keep], bins=bins, color="tab:green", alpha=0.75, label="accepted (p_false<0.5)")
    ax.hist(chi2_all[~keep], bins=bins, color="tab:red", alpha=0.75, label="rejected (p_false>=0.5)")
    if keep.any():
