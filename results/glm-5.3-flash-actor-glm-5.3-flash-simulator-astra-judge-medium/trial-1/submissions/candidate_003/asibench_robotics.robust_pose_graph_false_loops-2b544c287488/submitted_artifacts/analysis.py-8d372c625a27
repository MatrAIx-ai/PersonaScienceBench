        ops.append(f"{x:.2f} {y:.2f} moveto ({esc(s)}) show")

    def line(x1, y1, x2, y2, c, wdt=1.0):
        col(c)
        ops.append(f"{wdt:.1f} setlinewidth {x1:.2f} {y1:.2f} moveto {x2:.2f} {y2:.2f} lineto stroke")

    def poly(pts, c, wdt=1.0):
        if len(pts) < 2:
            return
        col(c); ops.append(f"{wdt:.1f} setlinewidth")
        ops.append(f"{pts[0][0]:.2f} {pts[0][1]:.2f} moveto")
        for p in pts[1:]:
            ops.append(f"{p[0]:.2f} {p[1]:.2f} lineto")
        ops.append("stroke")

    def rect(x, y, w, h, c):
        col(c)
        ops.append(f"{x:.2f} {y:.2f} moveto {w:.2f} 0 rlineto 0 {h:.2f} rlineto "
                   f"{-w:.2f} 0 rlineto closepath fill")

    PW, PH = 1500.0, 720.0
