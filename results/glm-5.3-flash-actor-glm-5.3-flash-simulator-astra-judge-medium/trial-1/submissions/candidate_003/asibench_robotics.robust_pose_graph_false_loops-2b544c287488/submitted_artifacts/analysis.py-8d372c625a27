else:
    import subprocess, os

    def esc(s):
        return s.replace("\\", "\\\\").replace("(", "\\(").replace(")", "\\)")

    ops = []

    def col(c):
        ops.append(f"{c[0]:.3f} {c[1]:.3f} {c[2]:.3f} setrgbcolor")

    def txt(x, y, s, size=12, c=BLACK, align="left"):
