        ax.plot([P0[i, 0], P0[j, 0]], [P0[i, 1], P0[j, 1]], "-", color=col, lw=0.6, alpha=0.3)
        ax.plot([P_out[i, 0], P_out[j, 0]], [P_out[i, 1], P_out[j, 1]], "-", color=col, lw=1.0, alpha=0.9)
