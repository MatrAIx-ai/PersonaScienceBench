"""BixBench bix-10-q3: COVID-19 severity by BCG vs placebo within patients_seen groups.
Primary: subject-level max AESEV over COVID-spectrum AE rows; 2x2 chi-square (1-2 vs 3-4)
with Yates; kx2 uncorrected secondary; Fisher exact when expected<5. Sensitivities as pre-declared.
"""
import numpy as np, pandas as pd
from scipy import stats

dm = pd.read_csv('data/TASK008_BCG-CORONA_DM.csv')
ae = pd.read_csv('data/TASK008_BCG-CORONA_AE.csv', encoding='latin-1')
BANDS = ['1-50', '51-100', '>100']

covid_any = ae[ae.AEPT.str.contains('COVID|SARS-CoV', case=False, na=False)].copy()
covid_strict = covid_any[covid_any.AEPT == 'COVID-19'].copy()

def build(kind, term_filter, nan_category=False):
    """Return subject-level dataframe: USUBJID, TRTGRP, patients_seen, severity label."""
    df = term_filter.copy()
    if kind == 'subject':
        g = df.groupby('USUBJID')
        sev = g.AESEV.max()
        out = pd.DataFrame({'TRTGRP': g.TRTGRP.first(), 'sev': sev}).reset_index()
    else:  # event-level
        out = df[['USUBJID', 'TRTGRP', 'AESEV']].rename(columns={'AESEV': 'sev'})
    out = out.merge(dm[['USUBJID', 'patients_seen']], on='USUBJID', how='left')
    if nan_category:
        out['cat'] = np.where(out.sev.isna(), 'not_graded',
                      np.where(out.sev <= 2, 'mild_mod', 'sev_plus'))
        cats = ['mild_mod', 'sev_plus', 'not_graded']
    else:
        out = out.dropna(subset=['sev'])
        out['cat'] = np.where(out.sev <= 2, 'mild_mod', 'sev_plus')
        cats = ['mild_mod', 'sev_plus']
    return out, cats

def run_tests(table, label, band):
    """table: DataFrame rows=severity cat, cols=TRTGRP."""
    print(f'\n=== {label} | band {band} ===')
    print('Cell table (rows=severity, cols=BCG/Placebo):')
    print(table.to_string())
    flat = np.asarray(table)
    if flat.shape == (2, 2):
        a, b, c, d = flat[0,0], flat[0,1], flat[1,0], flat[1,1]
        expected = stats.contingency.expected_freq(flat)
        print('Expected counts:', np.round(expected,2).tolist())
        fisher_needed = (expected < 5).any()
        chi2, p, dof, _ = stats.chi2_contingency(flat, correction=True)
        print(f'Chi-square (Yates): chi2={chi2:.4f}, df={dof}, p={p:.4f}  -> p<0.05: {p<0.05}')
        chi2nc, pnc, _, _ = stats.chi2_contingency(flat, correction=False)
        print(f'Chi-square (no correction): chi2={chi2nc:.4f}, p={pnc:.4f} -> p<0.05: {pnc<0.05}')
        if fisher_needed:
            odds, pf = stats.fisher_exact(flat)
            print(f'Fisher exact (expected<5 present): p={pf:.4f} -> p<0.05: {pf<0.05}')
        else:
            _, pf = stats.fisher_exact(flat)
            print(f'Fisher exact: p={pf:.4f} -> p<0.05: {pf<0.05}')
    else:
        # kx2 test on rows with data; drop all-zero rows/columns
        t = flat.copy()
        t = t[:, t.sum(axis=0) > 0]
        t = t[t.sum(axis=1) > 0]
        if t.shape[0] < 2 or (stats.contingency.expected_freq(t) < 5).any():
            print('kx2 chi-square NOT valid/meaningful: <2 levels or expected<5 in a cell '
                  f'(shape {t.shape}, min expected {stats.contingency.expected_freq(t).min():.2f})')
            return
        chi2, p, dof, _ = stats.chi2_contingency(t, correction=False)
        print(f'kx2 Chi-square (no correction): chi2={chi2:.4f}, df={dof}, p={p:.4f} -> p<0.05: {p<0.05}')

def analyze(out, cats, label, event_level=False):
    print('\n' + '#'*70)
    print('##', label, f'(n subjects={out.USUBJID.nunique()}, n rows={len(out)})')
    by_band_p = []
    for band in BANDS:
        sub = out[out.patients_seen == band]
        if len(sub) == 0:
            print(f'\n=== {label} | band {band} === no COVID subjects'); continue
        tab = pd.crosstab(sub.cat, sub.TRTGRP).reindex(index=cats, columns=['BCG','Placebo'], fill_value=0)
        run_tests(tab, label, band)
    # secondary kx2 (4-level or with not_graded)
    if not event_level:
        levels = ['1','2','3','4'] if 'not_graded' not in cats else None
        if levels:
            print(f'\n--- {label}: secondary kx2 (severity 1/2/3/4 x TRTGRP) ---')
            for band in BANDS:
                sub = out[out.patients_seen == band].dropna(subset=['sev']).copy()
                sub['lvl'] = sub.sev.astype(int).astype(str)
                if len(sub)==0:
                    print(f'  band {band}: no graded subjects'); continue
                tab = pd.crosstab(sub.lvl, sub.TRTGRP).reindex(index=levels, columns=['BCG','Placebo'], fill_value=0)
                run_tests(tab, label+' kx2', band)

# (1) Primary analysis
out_p, cats_p = build('subject', covid_any, nan_category=False)
analyze(out_p, cats_p, 'PRIMARY: subject-level max AESEV, COVID-spectrum terms, NaN excluded (n=148)')

# (2) Sensitivities
out_s, cats_s = build('subject', covid_strict, nan_category=False)
analyze(out_s, cats_s, 'SENSITIVITY 1: strict AEPT=="COVID-19" only')

out_n, cats_n = build('subject', covid_any, nan_category=True)
analyze(out_n, cats_n, 'SENSITIVITY 2: NaN AESEV kept as "not graded" category')

out_e, cats_e = build('event', covid_any, nan_category=False)
print('\n' + '#'*70); print('## SENSITIVITY 3: event-level severity (one row per COVID AE, graded only)')
for band in BANDS:
    sub = out_e[out_e.patients_seen == band]
    if len(sub)==0: continue
    tab = pd.crosstab(sub.cat, sub.TRTGRP).reindex(index=cats_e, columns=['BCG','Placebo'], fill_value=0)
    run_tests(tab, 'SENSITIVITY 3 (event-level)', band)

# SENSITIVITY 4 = kx2 4-level, already printed inside analyze() of primary & others
print('\nDone.')
