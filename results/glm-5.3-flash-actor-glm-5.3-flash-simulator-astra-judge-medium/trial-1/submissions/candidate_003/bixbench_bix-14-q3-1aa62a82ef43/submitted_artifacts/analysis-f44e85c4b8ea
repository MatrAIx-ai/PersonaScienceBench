#!/usr/bin/env python3
"""
CHIP exonic non-reference variant count across 86 samples (CHIP_DP10_GQ20_PASS).

Main scenario (approved):
  - drop Zygosity == 'Reference' (reference variant calls)
  - drop rows with blank Zygosity AND blank DP/GQ/VAF  -> no genotype call at all
  - drop rows with blank Zygosity but DP/GQ present    -> no annotated genotype (alt scenario keeps them)
  - region from 'Sequence Ontology (Combined)':
        keep    : missense_variant, synonymous_variant, inframe_insertion,
                  inframe_deletion, frameshift_variant, splice_region_variant (main)
        drop    : intron_variant, 3'/5'UTR terms, upstream_gene_variant,
                  intergenic_variant (no-op: term absent in data)
  - gene: any comma-token of 'Gene Names' in the 56-gene CHIP list (overlap rule)
  - dedupe within sample on (Chr:Pos, Ref/Alt); cross-sample duplicates counted separately
"""
import openpyxl, glob, os
from collections import Counter, defaultdict

DATA = "data/CHIP_DP10_GQ20_PASS"
GENE_FILE = "data/230214_Schenz_et_al_2022_CHIP_Genes.xlsx"
TRIO_FILE = "data/230215_Trio_Status.xlsx"
OUT = "artifacts/chip_exonic_counts.csv"

CHIP = {r[0] for r in openpyxl.load_workbook(GENE_FILE)["Sheet1"].iter_rows(values_only=True) if r[0]}

# column indices (0-based) in the 33-column sheet
C_POS, C_REFALT, C_ZYG, C_DP, C_GQ, C_VAF, C_GENES, C_SO, C_FILTER = 0, 1, 4, 7, 8, 9, 12, 13, 19

KEEP_SO  = {"synonymous_variant","missense_variant","inframe_insertion","inframe_deletion",
            "frameshift_variant","splice_region_variant"}          # splice_region: main=keep
DROP_SO  = {"intron_variant","3_prime_UTR_variant","5_prime_UTR_variant",
            "5_prime_UTR_premature_start_codon_gain_variant","upstream_gene_variant",
            "intergenic_variant"}                                   # intergenic = no-op

STRICT_EXONIC = {"synonymous_variant","missense_variant","inframe_insertion",
                 "inframe_deletion","frameshift_variant"}

def so_exonic(so, keep_splice=True, keep_upstream=False):
    """Region classification from the 'Sequence Ontology (Combined)' term."""
    if so in DROP_SO:
        # upstream_gene_variant: excluded by default (not exonic); kept only in Alt C
        return keep_upstream and so == "upstream_gene_variant"
    if so in STRICT_EXONIC:
        return True
    if so == "splice_region_variant":
        return keep_splice          # main: keep as exonic; Alt B: exclude
    return False                    # any unannotated/unknown term -> not exonic

def classify(row, keep_splice=True, keep_upstream=False):
    """Return (call_status, is_exonic, is_chip).
    call_status: True = non-reference variant call, False = reference/no-call,
                 None = blank zygosity with DP/GQ present (ambiguous class)."""
    zyg = row[C_ZYG]
    if zyg == "Reference":
        return False, None, None
    if zyg is None:
        if row[C_DP] is None and row[C_GQ] is None and row[C_VAF] is None:
            return False, None, None      # no genotype, no coverage evidence
        return None, None, None           # ambiguous: DP/GQ present, no genotype/VAF
    is_ex = so_exonic(str(row[C_SO]).strip(), keep_splice, keep_upstream)
    genes = {g.strip() for g in str(row[C_GENES]).split(",")}
    return True, is_ex, bool(genes & CHIP)

def load_all():
    per_sample = {}
    audit = Counter()
    for f in sorted(glob.glob(os.path.join(DATA, "*.xlsx"))):
        sample = os.path.basename(f).replace("230209_Exome_GRCh38_CHIP_","").replace(".xlsx","")
        ws = openpyxl.load_workbook(f).active
        rows = list(ws.iter_rows(values_only=True))[2:]   # skip 2 header rows
        per_sample[sample] = rows
        for r in rows:
            audit["total"] += 1
            audit[f"zyg={r[C_ZYG]}"] += 1
            audit[f"so={r[C_SO]}"] += 1
            if r[C_FILTER] != "PASS": audit["filter_not_PASS"] += 1
    return per_sample, audit

def count(per_sample, keep_splice=True, keep_upstream=False, keep_blank_zyg=False):
    total = 0
    per_sample_counts = {}
    gene_counter = Counter()
    for sample, rows in per_sample.items():
        seen, n = set(), 0
        for r in rows:
            status, exonic, is_chip = classify(r, keep_splice, keep_upstream)
            if status is None:                     # blank-zyg with DP/GQ
                if not keep_blank_zyg:
                    continue
                exonic = so_exonic(str(r[C_SO]).strip(), keep_splice, keep_upstream)
                is_chip = bool({g.strip() for g in str(r[C_GENES]).split(",")} & CHIP)
            if status is False or not exonic or not is_chip:
                continue
            key = (r[C_POS], r[C_REFALT])
            if key in seen:
                continue
            seen.add(key); n += 1
            for g in {g.strip() for g in str(r[C_GENES]).split(",")} & CHIP:
                gene_counter[g] += 1
        per_sample_counts[sample] = n
        total += n
    return total, per_sample_counts, gene_counter


if __name__ == "__main__":
    per_sample, audit = load_all()
    print("== AUDIT ==")
    print("files:", len(per_sample), "| data rows:", audit["total"])
    for k,v in sorted(audit.items()):
        if k.startswith(("zyg=","so=","filter")): print(f"  {k}: {v}")

    # trio cross-check
    trio = {str(r[0]).strip(): r[1] for r in list(openpyxl.load_workbook(TRIO_FILE)["Sheet1"].iter_rows(values_only=True))[1:]}
    file_ids = {s.split("-")[0].split("SRR")[0] if not s.startswith("SRR") else s for s in per_sample}
    n_trio_ids = len(trio)
    print("\n== TRIO CHECK ==  trio rows:", n_trio_ids, "| status values:",
          {k.strip(): v for k,v in Counter(trio.values()).items()})

    results = {}
    print("\n== MAIN SCENARIO ==")
    t, per, genes = count(per_sample)
    results["main"] = (t, per, genes)
    print("non-reference exonic CHIP variants (per-sample occurrences):", t)
    print("samples contributing:", sum(1 for v in per.values() if v>0), "| per-sample min/median/max:",
          min(per.values()), sorted(per.values())[len(per)//2], max(per.values()))
    print("unique (Chr:Pos,Ref/Alt) sites:", None)
    print("top genes:", genes.most_common(10))

    print("\n== ALTERNATIVES (each vs main, one change at a time) ==")
    tA, _, _ = count(per_sample, keep_blank_zyg=True)
    print(f"Alt A  + include blank-zygosity rows with DP/GQ: {tA}  (delta {tA-t:+d})")
    tB, _, _ = count(per_sample, keep_splice=False)
    print(f"Alt B  - exclude splice_region_variant:        {tB}  (delta {tB-t:+d})")
    tC, _, _ = count(per_sample, keep_upstream=True)
    print(f"Alt C  + keep upstream_gene_variant:           {tC}  (delta {tC-t:+d})")

    # unique sites in main
    sites = set()
    for sample, rows in per_sample.items():
        seen = set()
        for r in rows:
            is_call, exonic, is_chip = classify(r)
            if is_call is True and exonic and is_chip:
                seen.add((r[C_POS], r[C_REFALT]))
        sites |= seen
    print("\nmain scenario unique variant sites across all samples:", len(sites))

    # INDEPENDENT CROSS-CHECK of the main total (straight filter, no classify())
    chk = 0
    for sample, rows in per_sample.items():
        seen = set()
        for r in rows:
            if r[C_ZYG] in ("Heterozygous", "Homozygous Variant") \
               and str(r[C_SO]).strip() in STRICT_EXONIC | {"splice_region_variant"} \
               and {g.strip() for g in str(r[C_GENES]).split(",")} & CHIP:
                seen.add((r[C_POS], r[C_REFALT]))
        chk += len(seen)
    print("independent recomputation of main total:", chk, "| match:", chk == t)
    shared = 0
    occ = Counter()
    for sample, rows in per_sample.items():
        seen = set()
        for r in rows:
            is_call, exonic, is_chip = classify(r)
            if is_call is True and exonic and is_chip:
                seen.add((r[C_POS], r[C_REFALT]))
        for k in seen: occ[k]+=1
    print("sites present in >1 sample:", sum(1 for v in occ.values() if v>1))

    # per-sample CSV artifact
    with open(OUT, "w") as fh:
        fh.write("sample,nonref_exonic_chip_variants\n")
        for s in sorted(per): fh.write(f"{s},{per[s]}\n")
    print("\nper-sample table written to", OUT)
