"""
BixBench bix-16-q2: skewness of gene expression log2(TPM+1) distribution
across all cell lines in the dataset.

Headline statistic: adjusted Fisher-Pearson standardized moment coefficient
(skewness G1), scipy.stats.skew(..., bias=False), computed on ALL pooled
elements of the expression matrix (1673 cell lines x 19138 genes).

NOTE: matplotlib is unavailable in this environment (no network), so the
supporting histogram is rendered as a text histogram in the script output.
"""
import numpy as np
import pandas as pd
from scipy import stats

EXPR = "data/OmicsExpressionProteinCodingGenesTPMLogp1BatchCorrected.csv"

df = pd.read_csv(EXPR, index_col=0)
arr = df.to_numpy(dtype=np.float64)
n = arr.size
print(f"matrix: {df.shape[0]} cell lines x {df.shape[1]} genes = {n:,} values")

# descriptives
desc = {
    "min": arr.min(), "max": arr.max(),
    "mean": arr.mean(), "median": float(np.median(arr)),
    "std": arr.std(ddof=1),
}
q = np.percentile(arr, [1, 5, 25, 50, 75, 95, 99])
desc["quantiles(1,5,25,50,75,95,99%)"] = np.round(q, 4).tolist()
for k, v in desc.items():
    print(f"  {k}: {v}")

# headline: adjusted Fisher-Pearson G1 (bias=False)
skew_adj = stats.skew(arr.ravel(), bias=False)
skew_pop = stats.skew(arr.ravel(), bias=True)
print(f"HEADLINE skewness (scipy.stats.skew, bias=False, adjusted G1): {skew_adj:.6f}")
print(f"secondary  skewness (bias=True, population g1): {skew_pop:.6f}")

# sensitivity: per-gene and per-cell-line skew distributions
gene_skews = stats.skew(arr, axis=0, bias=False)
line_skews = stats.skew(arr, axis=1, bias=False)
print(f"secondary  per-gene skewness: median={np.median(gene_skews):.4f}, "
      f"IQR=[{np.percentile(gene_skews,25):.4f}, {np.percentile(gene_skews,75):.4f}]")
print(f"secondary  per-cell-line skewness: median={np.median(line_skews):.4f}, "
      f"IQR=[{np.percentile(line_skews,25):.4f}, {np.percentile(line_skews,75):.4f}]")

# supporting text histogram (equal-width bins across the data range)
counts, edges = np.histogram(arr, bins=40)
scale = counts.max()
print("\nHistogram of all pooled log2(TPM+1) values (40 equal-width bins):")
lo = edges[0]
width = np.diff(edges)[0]
for c, e in zip(counts, edges[1:]):
    bar = "#" * int(round(60 * c / scale))
    print(f"  [{e-width:+7.3f}, {e:+7.3f}) {c:>9,} {bar}")

# machine-readable summary
pd.Series({
    "n_cell_lines": df.shape[0], "n_genes": df.shape[1], "n_values": n,
    "skew_bias_false": skew_adj, "skew_bias_true": skew_pop,
    "median_per_gene_skew": np.median(gene_skews),
    "median_per_cellline_skew": np.median(line_skews),
    "mean": desc["mean"], "median": desc["median"], "std": desc["std"],
    "min": desc["min"], "max": desc["max"],
}).to_csv("skewness_summary.csv")
print("\nsaved: skewness_summary.csv")
