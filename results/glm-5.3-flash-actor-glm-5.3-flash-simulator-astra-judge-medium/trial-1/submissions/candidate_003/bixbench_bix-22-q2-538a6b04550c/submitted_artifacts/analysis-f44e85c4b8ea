"""
Pearson correlation between gene length and mean expression (across samples)
for protein-coding genes in CD4 immune cells.

Inputs:
  data/GeneMetaInfo_Zenodo.csv          (,Geneid,Chr,Length,gene_biotype)
  data/BatchCorrectedReadCounts_Zenodo.csv  (unnamed gene-ID column + sample columns)
  data/Sample_annotated_Zenodo.csv      (sample,samp,samtype,celltype,batch,sex)

PRIMARY: Pearson r between Length and mean of raw BatchCorrectedReadCounts
         across all 151 CD4 samples, protein-coding genes (exact biotype match),
         with two-sided p-value.
SENSITIVITY: log2(mean+1); log2(x+1) before averaging; excluding zero-variance genes.
"""
import re
import numpy as np
import pandas as pd
from scipy import stats

META = "data/GeneMetaInfo_Zenodo.csv"
COUNTS = "data/BatchCorrectedReadCounts_Zenodo.csv"
ANNOT = "data/Sample_annotated_Zenodo.csv"

# ---------------- Load ----------------
meta = pd.read_csv(META, index_col=0)
counts = pd.read_csv(COUNTS, index_col=0)
annot = pd.read_csv(ANNOT)

# ---------------- Asserts (alignment / coverage) ----------------
assert meta["Geneid"].is_unique, "Duplicate Geneid in metadata"
assert counts.index.is_unique, "Duplicate gene IDs in counts matrix"
assert counts.index.equals(pd.Index(meta["Geneid"])), "Counts rows not 1:1 with meta Geneid (order+content)"
assert counts.shape[1] == 723, f"Expected 723 sample columns, got {counts.shape[1]}"
assert annot["sample"].is_unique, "Duplicate sample in annotation"
assert set(annot["sample"]) == set(counts.columns), "Annotation/matrix sample coverage mismatch (bidirectional)"
assert annot["celltype"].notna().all() and meta["Length"].notna().all(), "Unexpected NaNs"

# ---------------- CD4 selection: annotation join, cross-checked by suffix parse ----------------
cd4_samples = annot.loc[annot["celltype"] == "CD4", "sample"].tolist()
cd4_suffix = [c for c in counts.columns if re.search(r"CD4(_\d+)?$", c)]
assert set(cd4_samples) == set(cd4_suffix), "Suffix-parse and annotation CD4 sets disagree"
print(f"CD4 samples: {len(cd4_samples)} (annotation join == suffix parse: OK)")

# ---------------- Protein-coding filter (exact match; compound strings excluded) ----------------
n_compound = int(meta["gene_biotype"].str.contains("protein_coding").sum()
                 - (meta["gene_biotype"] == "protein_coding").sum())
pc = meta[meta["gene_biotype"] == "protein_coding"]
print(f"protein_coding (exact match): {len(pc)} genes; compound-biotype rows excluded: {n_compound}")

counts_pc = counts.loc[pc.index, cd4_samples]
lengths = pc["Length"].to_numpy(dtype=float)

# ---------------- Mean expression per gene over CD4 samples ----------------
mean_raw = counts_pc.mean(axis=1).to_numpy()
mean_log2_after = np.log2(mean_raw + 1.0)                       # log2(mean+1)
mean_log2_before = np.log2(counts_pc.to_numpy(dtype=float) + 1).mean(axis=1)  # log2(x+1) then mean
zero_var_mask = counts_pc.std(axis=1).to_numpy() == 0
print(f"zero-variance (zero-mean) protein-coding genes across CD4: {int(zero_var_mask.sum())}")

# ---------------- Correlations ----------------
def pearson(x, y):
    r, p = stats.pearsonr(x, y)
    return r, p

variants = {
    "PRIMARY: raw mean CD4 counts vs Length": pearson(lengths, mean_raw),
    "Sensitivity: log2(mean+1) vs Length": pearson(lengths, mean_log2_after),
    "Sensitivity: mean of log2(x+1) vs Length": pearson(lengths, mean_log2_before),
    "Sensitivity: raw, zero-variance genes excluded": pearson(lengths[~zero_var_mask], mean_raw[~zero_var_mask]),
}

print("\n--- Results (n = %d protein-coding genes) ---" % len(pc))
print(f"{'Variant':<48}{'Pearson r':>12}{'p-value':>14}")
for name, (r, p) in variants.items():
    print(f"{name:<48}{r:>12.4f}{p:>14.3e}")

r_primary, p_primary = variants["PRIMARY: raw mean CD4 counts vs Length"]
print(f"\nFINAL ANSWER (primary): Pearson r = {r_primary:.4f}, p-value = {p_primary:.3e}")
