"""
BixBench bix-22-q4: Pearson correlation between gene length and mean expression
across CD14 samples, for protein-coding genes.

Locked decisions:
- Samples: exactly the annotation rows with celltype == "CD14" (asserted to equal
  all count-matrix columns containing "CD14").
- Genes: gene_biotype == "protein_coding" (strict).
- Expression: per-gene arithmetic mean of the supplied batch-corrected counts,
  as-is (no CPM/TPM, no low-expression filtering, no exclusions).
- Primary statistic: Pearson r between raw Length and raw mean expression.
- Secondary (sensitivity only): Pearson r on log2-transformed values. Genes with
  zero mean expression are excluded from the log-log check only (log undefined);
  a +1 pseudocount variant is also reported. Primary result uses all 19,942 genes.
"""
import numpy as np
import pandas as pd
from scipy import stats

META = "data/GeneMetaInfo_Zenodo.csv"
COUNTS = "data/BatchCorrectedReadCounts_Zenodo.csv"
ANN = "data/Sample_annotated_Zenodo.csv"

# ---- Load ----
meta = pd.read_csv(META)
counts = pd.read_csv(COUNTS, index_col=0)
ann = pd.read_csv(ANN)
print(f"[load] meta {meta.shape}, counts {counts.shape}, ann {ann.shape}")

# ---- Join check: metadata covers all count-matrix genes, 1:1 ----
assert counts.index.is_unique and not counts.index.isna().any()
assert set(counts.index) == set(meta["Geneid"]), "gene ID sets differ"
assert (meta.iloc[:, 0] == meta["Geneid"]).all(), "Unnamed first col != Geneid"
print(f"[join] OK: {len(meta)} meta genes == {counts.shape[0]} matrix genes, 1:1")

# ---- Sample selection: CD14 ----
cd14_samples = ann.loc[ann["celltype"] == "CD14", "sample"].tolist()
cols_with_cd14 = [c for c in counts.columns if "CD14" in c]
assert sorted(cd14_samples) == sorted(cols_with_cd14), "CD14 set mismatch"
assert len(cd14_samples) == 132, f"expected 132 CD14 samples, got {len(cd14_samples)}"
cd14_cols = [c for c in counts.columns if c in set(cd14_samples)]
assert len(cd14_cols) == 132
print(f"[samples] OK: {len(cd14_cols)} CD14 samples, set equals all 'CD14' matrix columns")

# ---- Gene filter: protein_coding ----
pc = meta[meta["gene_biotype"] == "protein_coding"]
print(f"[genes] protein_coding: {len(pc)} of {len(meta)}")

# ---- Mean expression across CD14 samples (as-is counts) ----
mean_expr = counts.loc[pc["Geneid"], cd14_cols].mean(axis=1)
lengths = pc.set_index("Geneid")["Length"]

df = pd.DataFrame({"Length": lengths, "mean_expr": mean_expr}).dropna()
n = len(df)
print(f"[pairs] n = {n} genes with both length and mean expression")

# Sanity: no NA / zero lengths / duplicates expected
assert df["Length"].isna().sum() == 0 and (df["Length"] > 0).all()
print(f"[sanity] no NAs; min length = {df['Length'].min()}; "
      f"zero-length genes = {(df['Length']==0).sum()}")
n_zero_expr = int((df["mean_expr"] == 0).sum())
print(f"[sanity] genes with zero mean CD14 expression (kept in primary): {n_zero_expr}")

# ---- Primary: Pearson r, raw values (all protein-coding genes) ----
r, p = stats.pearsonr(df["Length"], df["mean_expr"])
print(f"\nPRIMARY  Pearson r (Length vs mean CD14 expression, protein-coding): r = {r:.6f}")
print(f"         full precision: {r:.16g}   p-value = {p:.3e}   n = {n}")

# ---- Secondary: log-log sensitivity ----
pos = df[df["mean_expr"] > 0]
r_log, p_log = stats.pearsonr(np.log2(pos["Length"]), np.log2(pos["mean_expr"]))
print(f"\nSENSITIVITY (secondary) log2-log2 Pearson r, genes with mean_expr>0 "
      f"(n={len(pos)}): r = {r_log:.6f} (p = {p_log:.3e})")
print(f"         full precision: {r_log:.16g}")

r_log1, p_log1 = stats.pearsonr(np.log2(df["Length"]), np.log2(df["mean_expr"] + 1))
print(f"SENSITIVITY (secondary) log2(Length) vs log2(mean_expr+1), all n={n}: "
      f"r = {r_log1:.6f} (p = {p_log1:.3e})")
print(f"         full precision: {r_log1:.16g}")

# Save results for the record
out = pd.DataFrame({"statistic": ["pearson_r_raw_primary", "pearson_r_log2_drop_zero",
                                  "pearson_r_log2_pseudocount", "n_genes_primary"],
                    "value": [r, r_log, r_log1, n]})
out.to_csv("analysis/results.csv", index=False)
print("\n[done] results saved to analysis/results.csv")
