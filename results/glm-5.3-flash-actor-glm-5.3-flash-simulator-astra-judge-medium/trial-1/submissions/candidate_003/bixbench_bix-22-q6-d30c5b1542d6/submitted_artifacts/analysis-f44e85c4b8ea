"""
Pearson correlation between gene length and gene expression, protein-coding genes only.
Inputs: data/GeneMetaInfo_Zenodo.csv, data/BatchCorrectedReadCounts_Zenodo.csv, data/Sample_annotated_Zenodo.csv
"""
import numpy as np
import pandas as pd

meta = pd.read_csv('data/GeneMetaInfo_Zenodo.csv')
counts = pd.read_csv('data/BatchCorrectedReadCounts_Zenodo.csv', index_col=0)
samples = pd.read_csv('data/Sample_annotated_Zenodo.csv')

# --- alignment checks ---
assert (meta['Geneid'].values == counts.index.values).all(), "row order mismatch"
assert list(counts.columns) == list(samples['sample']), "column/sample mismatch"
assert meta['Geneid'].is_unique and counts.index.is_unique

meta = meta.set_index('Geneid')
X = counts.astype(float)

# --- sanity check: Length=8 gene ---
short = meta[meta['Length'] == 8]
print("Genes with Length == 8:")
print(short.to_string())

# --- biotype filters ---
pc_exact = meta['gene_biotype'] == 'protein_coding'
pc_sub = meta['gene_biotype'].str.contains('protein_coding', regex=False)
print(f"\nPC exact: {pc_exact.sum()}, PC substring: {pc_sub.sum()}")

def pearson(x, y):
    x = np.asarray(x, float); y = np.asarray(y, float)
    return np.corrcoef(x, y)[0, 1]

# --- expression metrics ---
lib = X.sum(axis=0)                       # per-sample totals
cpm = X.div(lib, axis=1) * 1e6
expr_meanlogcpm = np.log2(cpm + 1).mean(axis=1)   # PRIMARY: mean of log2(CPM+1)
expr_logmeancpm = np.log2(cpm.mean(axis=1) + 1)   # log2(mean CPM + 1)
expr_rawmean = X.mean(axis=1)                     # raw mean counts
allzero = (X == 0).all(axis=1)

# per-sample correlation of Length vs raw counts, averaged over samples
def per_sample_corr(mask):
    sub_idx = meta.index[mask]
    rs = []
    for s in X.columns:
        rs.append(pearson(meta.loc[sub_idx, 'Length'], X.loc[sub_idx, s]))
    return np.mean(rs), np.median(rs), len(rs)

results = []
def add(label, mask, x, y, extra=""):
    results.append((label, int(mask.sum()), extra, pearson(x[mask], y[mask])))

L = meta['Length']

# PRIMARY
add("PRIMARY: mean(log2(CPM+1)), exact PC, all genes", pc_exact, L, expr_meanlogcpm)
# sensitivity variants
add("log2(mean CPM + 1), exact PC, all genes", pc_exact, L, expr_logmeancpm)
add("raw mean counts (all genes), exact PC", pc_exact, L, expr_rawmean)
nz = expr_rawmean > 0
add("raw mean counts (nonzero-expression genes only), exact PC", pc_exact & nz, L, expr_rawmean)
add("mean(log2(CPM+1)), substring PC filter", pc_sub, L, expr_meanlogcpm)
add("mean(log2(CPM+1)), exact PC, drop all-zero genes", pc_exact & ~allzero, L, expr_meanlogcpm)
add("raw mean counts (nonzero), substring PC filter", pc_sub & nz, L, expr_rawmean)
add("mean(log2(CPM+1)), exact PC, drop Length==8 gene", pc_exact & (meta['Length'] > 8), L, expr_meanlogcpm)

rs, med, n = per_sample_corr(pc_exact)
results.append(("mean of per-sample Pearson r (raw counts), exact PC", int(pc_exact.sum()), f"n_samples={n}, median_r={med:.4f}", rs))

res = pd.DataFrame(results, columns=['definition', 'n_genes', 'extra', 'pearson_r'])
print("\n=== RESULTS ===")
print(res.to_string(index=False, float_format=lambda v: f"{v:.4f}"))

# diagnostics on primary
sub = pc_exact
x = L[sub]; y = expr_meanlogcpm[sub]
print("\nPrimary diagnostics:")
print(f"  n={sub.sum()}, r={pearson(x,y):.4f}")
print(f"  Length range in PC set: {x.min()}-{x.max()}, median {x.median():.0f}")
print(f"  expr range: {y.min():.3f}-{y.max():.3f}, median {y.median():.3f}")
# spearman for monotonicity context
print(f"  Spearman rho = {pd.Series(x).corr(pd.Series(y), method='spearman'):.4f}")
res.to_csv('analysis/results_correlation.csv', index=False)
print("\nSaved results table to analysis/results_correlation.csv")
