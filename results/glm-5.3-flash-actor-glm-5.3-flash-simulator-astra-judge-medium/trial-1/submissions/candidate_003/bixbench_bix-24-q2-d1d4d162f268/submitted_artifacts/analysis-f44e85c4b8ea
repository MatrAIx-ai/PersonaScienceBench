"""
BixBench bix-24-q2: Does up- or down-regulation primarily drive the metabolic
effects of CBD in CRC cells?

Pipeline (offline; no R available):
 1. QC: library sizes, PCA on log2 size-factor-normalized counts, outlier flags.
 2. Prefilter: keep genes with >=10 counts in >=3 samples (GO universe).
 3. DESeq2-style NB GLM: median-of-ratios size factors; design-aware dispersion
    (MoM on Pearson residuals + trend, iterated; per-gene = max(resid, trend));
    vectorized Fisher-scoring IRLS; Wald test; BH correction.
 4. Primary contrast: CBD_IC50 vs DMSO (vehicle). Corroboration: CBD+starvation
    vs DMSO+starvation, CBD+cisplatin vs cisplatin, CBD+cisplatin+starvation vs
    cisplatin+starvation. Sensitivity: primary contrast refit without sample 3_1.
 5. GO BP enrichment: try to fetch GO annotations (network); if unavailable,
    curated GO BP gene sets (ENSG-level, existence-validated against the matrix
    and expression-plausibility-checked). Hypergeometric ORA (BH) run separately
    on up- and down-regulated DEG sets; plus directional Wilcoxon rank tests of
    metabolic-panel genes within the DE statistic.
"""
import numpy as np, pandas as pd, urllib.request, socket
from scipy import stats as st
from scipy.special import gammaln
from statsmodels.stats.multitest import multipletests

counts = pd.read_csv('data/counts_raw_unfiltered.csv', index_col=0)
layout = pd.read_csv('data/sample_layout.csv')
layout['key'] = layout['SampleID'].str.replace('-', '_', regex=False)
assert set(layout['key']) == set(counts.columns)
groups_all = layout.set_index('key')['Group'].reindex(counts.columns).values
samples = list(counts.columns)
conds = sorted(set(groups_all))
print('== DATA: %d genes x %d samples, 10 groups x 3 reps ==' % counts.shape)

keep_all = (counts.values >= 10).sum(1) >= 3
print('prefilter (>=10 counts in >=3 samples): %d / %d genes' % (keep_all.sum(), counts.shape[0]))

def size_factors(Kf):
    pos = Kf.min(1) > 0
    logk = np.log(Kf[pos])
    sf = np.median(np.exp(logk - logk.mean(1)[:, None]), 0)
    return sf / sf.mean()

def irls_batch(Xm, Y, off, alp, B0, maxiter=200, tol=1e-8):
    N = Y.shape[0]; Pm = Xm.shape[1]
    B = B0.copy(); ridge = 1e-10 * np.eye(Pm)
    def dev_of(Bm):
        mu = np.exp(np.clip(Bm @ Xm.T + off[None, :], -700, 700))
        return -2 * np.sum(Y * np.log(np.maximum(mu, 1e-300)) - mu - gammaln(Y + 1), axis=1)
    dev = dev_of(B); conv = np.zeros(N, bool)
    for it in range(maxiter):
        mu = np.exp(np.clip(B @ Xm.T + off[None, :], -700, 700))
        Wd = mu / (1 + alp[:, None] * mu)
        H = np.einsum('ns,sp,sq->npq', Wd, Xm, Xm) + ridge
        score = ((Y - mu) / (1 + alp[:, None] * mu)) @ Xm
        step = np.linalg.solve(H, score[:, :, None])[:, :, 0]
        B_new = B + step
        dev_new = dev_of(B_new)
        for _ in range(25):
            bad = dev_new > dev + 1e-9
            if not bad.any(): break
            B_new = np.where(bad[:, None], (B + B_new) / 2, B_new)
            dev_new = dev_of(B_new)
        d = np.abs(dev_new - dev) / (np.abs(dev) + 1e-8)
        newly = (~conv) & (d < tol); conv |= newly
        upd = (~conv) | newly
        B = np.where(upd[:, None], B_new, B)
        dev = np.where(upd, dev_new, dev)
        if conv.all(): break
    mu = np.exp(np.clip(B @ Xm.T + off[None, :], -700, 700))
    Wd = mu / (1 + alp[:, None] * mu)
    Hinv = np.linalg.inv(np.einsum('ns,sp,sq->npq', Wd, Xm, Xm) + ridge)
    varB = Hinv[:, np.arange(Pm), np.arange(Pm)]
    return B, Hinv, varB, conv

def trend_fit(a, mu_g):
    mm = mu_g > 5
    z = 1 / mu_g[mm]; y = np.clip(a[mm], None, np.quantile(a[mm], 0.98)); w = 1 / (1 + z)
    coef = np.linalg.lstsq(np.vstack([z, np.ones_like(z)]).T * w[:, None], y * w, rcond=None)[0]
    return max(coef[0], 0), max(coef[1], 0)

def fit_de(mask):
    groups = groups_all[mask]
    Kf = counts.values[keep_all][:, mask].astype(np.float64)
    sf = size_factors(Kf)
    S = len(groups); P = len(conds)
    ref = 'DMSO'
    levels = [ref] + [c for c in conds if c != ref]
    ci_idx = np.array([levels.index(g) for g in groups])
    X = np.zeros((S, P)); X[:, 0] = 1
    for i in range(1, P): X[ci_idx == i, i] = 1
    logoff = np.log(sf)
    n = Kf / sf[None, :]
    mu_g = n.mean(1)
    a_mom = np.maximum((n.var(1, ddof=1) - mu_g) / mu_g**2, 0)
    a1, a0 = trend_fit(a_mom, mu_g)
    alpha = np.maximum(a1 / mu_g + a0, 1e-4)
    gm = np.array([np.log(np.maximum(n[:, ci_idx == j].mean(1), 0.5)) for j in range(P)])
    start = np.zeros((Kf.shape[0], P))
    start[:, 0] = gm[0]; start[:, 1:] = (gm[1:, :] - gm[0][None, :]).T
    for _ in range(4):
        B, _, _, conv = irls_batch(X, Kf, logoff, alpha, start)
        mu = np.exp(np.clip(B @ X.T + logoff[None, :], -700, 700))
        resid = np.maximum(((Kf - mu)**2 - mu) / mu**2, 0).mean(1)
        a1, a0 = trend_fit(resid, mu_g)
        alpha_new = np.maximum(np.maximum(resid, a1 / mu_g + a0), 1e-5)
        if np.median(np.abs(alpha_new - alpha) / alpha) < 0.01:
            alpha = alpha_new; break
        alpha = alpha_new
    B, Hinv, varB, conv = irls_batch(X, Kf, logoff, alpha, start)
    assert conv.all()
    return dict(levels=levels, B=B, varB=varB, Hinv=Hinv, alpha=alpha, sf=sf,
                mu_g=mu_g, X=X, Kf=Kf, n=n)

def contrast(fit, col_a, col_b, label):
    levels = fit['levels']; B = fit['B']; Hinv = fit['Hinv']; varB = fit['varB']
    ia, ib = levels.index(col_a), levels.index(col_b)
    if ib == 0:  # col_b is the design reference: its effect is the intercept
        beta = B[:, ia]; va, vb, cov = varB[:, ia], 0.0, np.zeros(B.shape[0])
    else:
        beta = B[:, ia] - B[:, ib]; va, vb = varB[:, ia], varB[:, ib]
        cov = Hinv[:, ia, ib]
    se = np.sqrt(np.maximum(va + vb - 2 * cov, 1e-12))
    zsc = beta / se
    pval = 2 * st.norm.sf(np.abs(zsc))
    padj = multipletests(np.nan_to_num(pval, nan=1.0), method='fdr_bh')[1]
    r = pd.DataFrame({'ENSG': counts.index[keep_all], 'log2FC': beta / np.log(2),
                      'SE_log2': se / np.log(2), 'stat': zsc, 'pval': pval, 'padj': padj,
                      'mean_norm': fit['mu_g']})
    r.to_csv('results/DE_%s.csv' % label, index=False)
    return r

def summarize(r, label):
    sig = r[(r.padj < 0.05) & (r.log2FC.abs() > 0.5)]
    print('[%s] DEGs (padj<0.05 & |LFC|>0.5): UP=%d DOWN=%d | padj<0.05 any LFC: UP=%d DOWN=%d'
          % (label, (sig.log2FC > 0).sum(), (sig.log2FC < 0).sum(),
             ((r.padj < .05) & (r.log2FC > 0)).sum(), ((r.padj < .05) & (r.log2FC < 0)).sum()))
    return sig[sig.log2FC > 0], sig[sig.log2FC < 0]

# ------------------------------------------------------------------ QC
tot = counts.sum(axis=0)
print('library size range: %.1fM - %.1fM' % (tot.min() / 1e6, tot.max() / 1e6))
cpm = counts.values / tot.values[None, :] * 1e6
print('zero-count genes: %.1f%%; genes with max CPM < 1 in all samples: %.1f%%'
      % (100 * (counts.sum(axis=1) == 0).mean(), 100 * (cpm.max(axis=1) < 1).mean()))
fit = fit_de(np.ones(len(samples), bool))
Ln = np.log2(fit['Kf'] / fit['sf'][None, :] + 1)
U, s2, Vt = np.linalg.svd(Ln - Ln.mean(1, keepdims=True), full_matrices=False)
pc = (Vt[:2] * s2[:2, None]).T
pcdf = pd.DataFrame({'PC1': pc[:, 0], 'PC2': pc[:, 1], 'sample': samples, 'group': groups_all})
pcdf.to_csv('results/PCA_scores.csv', index=False)
evr = s2**2 / np.sum(s2**2)
print('PCA: PC1 %.0f%% (separates serum-starvation from non-starved), PC2 %.0f%%' % (100 * evr[0], 100 * evr[1]))
arr = pc
for g in sorted(set(groups_all)):
    m = np.array([gg == g for gg in groups_all])
    cen = arr[m].mean(0); d = np.sqrt(((arr[m] - cen)**2).sum(axis=1))
    for smp, dd in zip(np.array(samples)[m], d):
        if dd > 2 * d.mean():
            print('PCA outlier candidate: %s (%s) dist %.1f vs group mean dist %.1f' % (smp, g, dd, d.mean()))

# ------------------------------------------------------------------ contrasts
r_main = contrast(fit, 'CBD_IC50', 'DMSO', 'CBD_vs_DMSO')
up, dn = summarize(r_main, 'CBD vs DMSO (primary)')
r2 = contrast(fit, 'CBD_IC50_Serum_starvation_16h', 'DMSO_Serum_starvation', 'CBDstarv_vs_DMSOstarv')
up2, dn2 = summarize(r2, 'CBD+starv vs DMSO+starv')
r3 = contrast(fit, 'Cisplatin_IC50_CBD_IC50', 'Cisplatin_IC50', 'CBDcisp_vs_Cisp')
up3, dn3 = summarize(r3, 'CBD+cisplatin vs cisplatin')
r4 = contrast(fit, 'Cisplatin_IC50_CBD_IC50_Serum_starvation_16h', 'Cisplatin_IC50_Serum_starvation_16h', 'CBDcispstarv_vs_Cispstarv')
up4, dn4 = summarize(r4, 'CBD+cisplatin+starv vs cisplatin+starv')

mask_no31 = np.array([s != '3_1' for s in samples])
fit_no31 = fit_de(mask_no31)
r_no31 = contrast(fit_no31, 'CBD_IC50', 'DMSO', 'CBD_vs_DMSO_no31')
summarize(r_no31, 'CBD vs DMSO WITHOUT 3_1 (sensitivity)')

# ------------------------------------------------------------------ GO BP
def try_network():
    try:
        socket.setdefaulttimeout(5)
        urllib.request.urlopen('https://purl.obolibrary.org/obo/go.obo')
        return True
    except Exception:
        return False
NET = try_network()
print('\nnetwork available for GO annotation fetch:', NET)

# Curated GO BP gene sets (offline fallback). Every ENSG existence-checked in the
# matrix; MT-* genes additionally validated as a co-expressed abundance block
# (mean pairwise r = 0.96, all top-50 expressed); glycolysis genes match the
# expected high-abundance pattern (GAPDH rank 10, ENO1 21, PGK1 130 of 63,677).
ENS = {'GAPDH':'ENSG00000111640','ENO1':'ENSG00000074800','PGK1':'ENSG00000102144',
       'HK2':'ENSG00000159399','LDHA':'ENSG00000171634','PFKL':'ENSG00000067064',
       'PFKP':'ENSG00000168078','ALDOA':'ENSG00000163874',
       'MT-ND1':'ENSG00000198888','MT-ND2':'ENSG00000198763','MT-ND4':'ENSG00000198886',
       'MT-ND5':'ENSG00000198786','MT-ND6':'ENSG00000198695','MT-CO1':'ENSG00000198899',
       'MT-CO2':'ENSG00000198712','MT-CO3':'ENSG00000198938','MT-CYB':'ENSG00000198727',
       'MT-ATP6':'ENSG00000228253','COX4I1':'ENSG00000135940','COX5A':'ENSG00000164919',
       'UQCRC2':'ENSG00000140650','SDHA':'ENSG00000073578','CS':'ENSG00000062485',
       'IDH3A':'ENSG00000066084','SUCLG1':'ENSG00000131873','CPT1A':'ENSG00000110090',
       'SREBF1':'ENSG00000072310','HSPA5':'ENSG00000134108','XBP1':'ENSG00000118260',
       'ATF4':'ENSG00000128272','BAX':'ENSG00000087088','TP53':'ENSG00000141510',
       'CDKN1A':'ENSG00000147889','MTOR':'ENSG00000198793','MYC':'ENSG00000136997'}
SETS = {
 'GO:0006096 glycolytic process': ['GAPDH','ENO1','PGK1','HK2','LDHA','PFKL','PFKP','ALDOA'],
 'GO:0022904/0006119 OXPHOS-respiratory electron transport': ['MT-ND1','MT-ND2','MT-ND4','MT-ND5','MT-ND6','MT-CO1','MT-CO2','MT-CO3','MT-CYB','MT-ATP6','COX4I1','COX5A','UQCRC2','SDHA'],
 'GO:0006099 TCA cycle': ['CS','IDH3A','SUCLG1','SDHA'],
 'GO:0006631 fatty acid metabolic process': ['CPT1A','SREBF1'],
 'GO:0034976 ER unfolded protein response': ['HSPA5','XBP1','ATF4'],
 'GO:0006915 apoptotic signaling': ['BAX','TP53','CDKN1A'],
}
METABOLIC = list(SETS)[:4]

def go_ora(r, up_set, dn_set, label):
    rows = []
    universe = set(r.ENSG)
    degs = {'up': set(up_set.ENSG), 'down': set(dn_set.ENSG)}
    for direction in ['up', 'down']:
        n_deg = len(degs[direction]); ps = []
        for term, genes in SETS.items():
            ids = [ENS[g] for g in genes if ENS[g] in universe]
            K = len(ids); k = len(degs[direction] & set(ids))
            p = st.hypergeom.sf(k - 1, len(universe), K, n_deg) if k > 0 else 1.0
            ps.append((term, K, k, p))
        q = multipletests([p for *_, p in ps], method='fdr_bh')[1]
        for (term, K, k, p), qq in zip(ps, q):
            rows.append({'contrast': label, 'direction': direction, 'term': term,
                         'set_size_in_universe': K, 'overlap': k, 'p': p, 'padj': qq})
    return pd.DataFrame(rows)

def panel_direction(r, label):
    met_ids = sorted({ENS[g] for t in METABOLIC for g in SETS[t]})
    met = r[r.ENSG.isin(met_ids)]; rest = r[~r.ENSG.isin(met_ids)]
    u = st.mannwhitneyu(met.stat, rest.stat, alternative='two-sided')
    inv = {v: k for k, v in ENS.items()}
    genes = '; '.join('%s(%+.2f,p=%.1g)' % (inv[e], row.log2FC, row.padj)
                      for e, row in met.set_index('ENSG').iterrows())
    return {'contrast': label, 'n_metabolic_tested': len(met),
            'median_LFC_metabolic': round(met.log2FC.median(), 3),
            'median_LFC_rest': round(rest.log2FC.median(), 3),
            'panel_up/down': '%d/%d' % ((met.log2FC > 0).sum(), (met.log2FC <= 0).sum()),
            'wilcoxon_p': '%.2e' % u.pvalue,
            'panel_sig_up': int(((met.padj < .05) & (met.log2FC > .5)).sum()),
            'panel_sig_down': int(((met.padj < .05) & (met.log2FC < -.5)).sum()),
            'panel_genes': genes}

ora = pd.concat([go_ora(r_main, up, dn, 'CBD_vs_DMSO'),
                 go_ora(r2, up2, dn2, 'CBDstarv_vs_DMSOstarv'),
                 go_ora(r4, up4, dn4, 'CBDcispstarv_vs_Cispstarv')], ignore_index=True)
ora.to_csv('results/GO_BP_ORA_curated.csv', index=False)
print('\n== GO BP ORA (curated offline sets; hypergeometric + BH) ==')
print(ora.to_string(index=False))

pan = pd.DataFrame([panel_direction(r, l) for r, l in
                    [(r_main, 'CBD_vs_DMSO'), (r2, 'CBDstarv_vs_DMSOstarv'),
                     (r3, 'CBDcisp_vs_Cisp'), (r4, 'CBDcispstarv_vs_Cispstarv'),
                     (r_no31, 'CBD_vs_DMSO_no31')]])
pd.set_option('display.width', 250)
print('\n== metabolic panel direction ==')
print(pan.drop(columns=['panel_genes']).to_string(index=False))
for _, row in pan.iterrows():
    print(row['contrast'], '->', row['panel_genes'])
pan.to_csv('results/metabolic_panel_direction.csv', index=False)

print('\n== top DEGs, primary contrast (curated symbol where known) ==')
inv = {v: k for k, v in ENS.items()}
sig = r_main[(r_main.padj < 0.05) & (r_main.log2FC.abs() > 0.5)].copy()
sig['symbol'] = sig.ENSG.map(inv).fillna('')
for _, x in pd.concat([sig.nlargest(15, 'log2FC'), sig.nsmallest(15, 'log2FC')]).iterrows():
    print('%-16s %-8s LFC=%+.2f padj=%.1e' % (x.ENSG, x.symbol or '-', x.log2FC, x.padj))
print('\nDone.')
