"""
TASK008_BCG-CORONA: Ordinal regression of BCG vaccination on COVID-19 severity,
controlling for prior medical history count and patients interaction frequency
(plus an interaction term). Produces OR (exp(beta_BCG)) with 95% CI.

Primary model decisions (approved by researcher):
- Population: all 1000 subjects; severity 0 = no COVID-19 AE recorded,
  1-4 = max AESEV across the subject's COVID-19 AE rows.
- AESEV missing -> imputed from AEHS via empirical map (1->1, 2->2, 3-4->3, 5-7->4).
- pmh_count = # checklist items (MHSCAT=='MEDICAL HISTORY') with MHORRES==2
  (derived assumption: 1=No, 2=Yes).
- patients interaction frequency = DM.patients_seen, ordinal coded 1-50=1, 51-100=2, >100=3.
- Interaction: BCG x patients_seen (ordinal).
- Library: statsmodels OrderedModel, logit link. TRTGRP: BCG=1/Placebo=0.
"""
import numpy as np
import pandas as pd
import statsmodels.api as sm
from statsmodels.miscmodels.ordinal_model import OrderedModel

DATA = "data"
dm = pd.read_csv(f"{DATA}/TASK008_BCG-CORONA_DM.csv")
ae = pd.read_csv(f"{DATA}/TASK008_BCG-CORONA_AE.csv")
mh = pd.read_csv(f"{DATA}/TASK008_BCG-CORONA_MH.csv")

# ---------- Outcome: COVID-19 severity per subject ----------
def aehs_to_aesev(aehs):
    if pd.isna(aehs): return np.nan
    if aehs <= 1: return 1.0
    if aehs <= 2: return 2.0
    if aehs <= 4: return 3.0
    return 4.0

cov = ae[ae["AEPT"].astype(str).str.contains("covid", case=False, na=False)].copy()
cov["AESEV_raw"] = cov["AESEV"]
cov["AESEV_imp"] = cov.apply(
    lambda r: r["AESEV"] if pd.notna(r["AESEV"]) else aehs_to_aesev(r["AEHS"]), axis=1)
print("COVID AE rows:", len(cov), "| subjects:", cov.USUBJID.nunique())
print("AESEV missing before imp:", cov.AESEV_raw.isna().sum(),
      "| after AEHS-based imp:", cov.AESEV_imp.isna().sum())

sev_all = cov.groupby("USUBJID")["AESEV_imp"].max()   # max severity per subject
sev_cc  = cov.groupby("USUBJID")["AESEV_raw"].max()   # complete-case (no imputation)
sev_cc  = sev_cc.dropna()  # subjects whose COVID AESEV is entirely missing are not complete cases

base = dm[["TRTGRP","USUBJID","VISITNAM","Age","RACE","education","work_hours",
           "patients_seen","expect_interact"]].copy()
base["BCG"] = (base["TRTGRP"] == "BCG").astype(int)
base["patients_seen_num"] = base["patients_seen"].map({"1-50":1, "51-100":2, ">100":3})

# ---------- Covariate: prior medical history count ----------
mhed = mh[mh["MHSCAT"] == "MEDICAL HISTORY"]
pmh = mhed[mhed["MHORRES"] == 2].groupby("USUBJID").size()
base["pmh_count"] = base["USUBJID"].map(pmh).fillna(0).astype(int)

# ---------- Assemble analysis datasets ----------
def build(sev, label):
    d = base.copy()
    d["severity"] = d["USUBJID"].map(sev).fillna(0.0).astype(int)
    print(f"\n[{label}] severity distribution:\n", d.severity.value_counts().sort_index().to_dict())
    print(f"[{label}] crosstab severity x BCG:\n", pd.crosstab(d.severity, d.BCG))
    return d

d_primary = build(sev_all, "primary: all 1000, imputed")
d_cc      = build(sev_cc,  "complete-case: all 1000, no imputation (NaN severity dropped)")
d_cc = d_cc[d_cc["USUBJID"].isin(sev_cc.index)].copy()
d_covid = base[base["USUBJID"].isin(sev_all.index)].copy()
d_covid["severity"] = d_covid["USUBJID"].map(sev_all).astype(int)
d_covid_cc = base[base["USUBJID"].isin(sev_cc.index)].copy()
d_covid_cc["severity"] = d_covid_cc["USUBJID"].map(sev_cc).astype(int)
print("\n[covid-only] n =", len(d_covid), "| [covid-only complete-case] n =", len(d_covid_cc))

# ---------- Ordinal regression ----------
def fit_ordered(d, formula_terms, label):
    """formula_terms: list of (name, series) numeric columns."""
    X = pd.concat([s.rename(n) for n, s in formula_terms], axis=1)
    ok = X.notna().all(axis=1) & d["severity"].notna()
    X, y = X[ok], d.loc[ok, "severity"]
    try:
        mod = OrderedModel(y, X, distr="logit")
        res = mod.fit(method="bfgs", disp=False, maxiter=500)
        b = res.params
        se = res.bse
        rows = {}
        for name in X.columns:
            rows[name] = dict(coef=b[name], OR=np.exp(b[name]),
                              lo=np.exp(b[name] - 1.96 * se[name]),
                              hi=np.exp(b[name] + 1.96 * se[name]),
                              p=res.pvalues[name])
        print(f"\n=== {label} (n={ok.sum()}) ===")
        print(pd.DataFrame(rows).round(4).to_string())
        print("converged:", res.mle_retvals.get("converged", "n/a"),
              "| severities present:", sorted(y.unique()))
        return pd.DataFrame(rows), res
    except Exception as e:
        print(f"\n=== {label} (n={ok.sum()}) === FIT FAILED: {e}")
        return None, None

PS = ("patients_seen", d_primary["patients_seen_num"])
results = {}

# Primary: all 1000, imputed, BCG + pmh_count + patients_seen + BCG x patients_seen
def terms(d, inter):
    t = [("BCG", d["BCG"]), ("pmh_count", d["pmh_count"].astype(float)),
         ("patients_seen", d["patients_seen_num"].astype(float))]
    if inter == "BCGxPS":
        t.append(("BCGxPS", (d["BCG"] * d["patients_seen_num"]).astype(float)))
    elif inter == "BCGxPMH":
        t.append(("BCGxPMH", (d["BCG"] * d["pmh_count"]).astype(float)))
    elif inter == "PMHxPS":
        t.append(("PMHxPS", (d["pmh_count"] * d["patients_seen_num"]).astype(float)))
    return t

res_primary, m_primary = fit_ordered(d_primary, terms(d_primary, "BCGxPS"),
                                     "PRIMARY: all 1000, imp, BCG+PMH+PS+BCGxPS")
results["primary"] = res_primary

# Sensitivity (a): COVID-only
res_covid, _ = fit_ordered(d_covid, terms(d_covid, "BCGxPS"),
                           "SENS a: COVID-only (n=194), imp, BCGxPS")
results["covid_only"] = res_covid

# Sensitivity (a2): COVID-only complete-case
res_covid_cc, _ = fit_ordered(d_covid_cc, terms(d_covid_cc, "BCGxPS"),
                              "SENS a2: COVID-only complete-case, BCGxPS")
results["covid_only_cc"] = res_covid_cc

# Sensitivity (b): complete-case (no imputation), all subjects with observed severity
res_cc, _ = fit_ordered(d_cc, terms(d_cc, "BCGxPS"),
                        "SENS b: all subjects, complete-case AESEV, BCGxPS")
results["cc"] = res_cc

# Sensitivity (c): alternative interactions (all 1000, imputed)
for inter in ["BCGxPMH", "PMHxPS"]:
    r, _ = fit_ordered(d_primary, terms(d_primary, inter),
                       f"SENS c: all 1000, imp, interaction={inter}")
    results[f"alt_{inter}"] = r

# ---------- Marginal OR for BCG from primary model (interaction-adjusted) ----------
if m_primary is not None:
    b = m_primary.params
    print("\nPrimary model: OR(BCG) at patients_seen=1 (reference):",
          round(np.exp(b["BCG"]), 4))
    for ps in [2, 3]:
        print(f"  OR(BCG) at patients_seen={ps}: exp(beta_BCG + {ps-1}*beta_BCGxPS) =",
              round(np.exp(b["BCG"] + (ps - 1) * b["BCGxPS"]), 4))
    # Average marginal OR (mean over observed patients_seen):
    lo = np.exp(b["BCG"] + (d_primary["patients_seen_num"] - 1) * b["BCGxPS"])
    print("  Average OR(BCG) over observed patients_seen:", round(np.exp(b['BCG'] + (d_primary['patients_seen_num']-1)*b['BCGxPS']).mean(), 4))

# ---------- Summary table ----------
print("\n\n=========== SUMMARY: OR for BCG (95% CI) ===========")
rows = []
for k, tbl in results.items():
    if tbl is not None and "BCG" in [str(c) for c in tbl.columns]:
        rows.append(dict(model=k, OR=tbl.loc["OR","BCG"], CI_lo=tbl.loc["lo","BCG"],
                         CI_hi=tbl.loc["hi","BCG"], p=tbl.loc["p","BCG"]))
summ = pd.DataFrame(rows).round(4)
print(summ.to_string(index=False))
summ.to_csv("analysis/TASK008_OR_summary.csv", index=False)
