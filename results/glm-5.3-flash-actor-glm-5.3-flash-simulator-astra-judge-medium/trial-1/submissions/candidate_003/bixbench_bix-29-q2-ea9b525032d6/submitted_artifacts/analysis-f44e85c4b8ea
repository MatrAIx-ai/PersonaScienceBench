"""
TASK008 BCG-CORONA: independent effect of each additional ongoing medical
condition (MHONGO) on COVID-19 severity (ordinal), controlling for BCG
vaccination status (TRTGRP) and patient-interaction variables.

Severity operationalization (no direct severity variable exists in inputs):
max AESEV (1-4) among a subject's COVID-19 adverse events.

Primary model: subjects with >=1 COVID-19 AE, complete-case on AESEV.
Pre-declared sensitivities:
  (a) all 1000 subjects, no-COVID-AE subjects assigned lowest severity category
  (b) outcome = max AEHS (0-7) among COVID-19 AEs
  (c) binary any ongoing condition vs none
  (d) predictor = total conditions reported (MHORRES=2 rows incl. MHONGO='No')
"""
import pandas as pd, numpy as np
import statsmodels.api as sm
from statsmodels.miscmodels.ordinal_model import OrderedModel

DATA = 'data'
dm = pd.read_csv(f'{DATA}/TASK008_BCG-CORONA_DM.csv')
mh = pd.read_csv(f'{DATA}/TASK008_BCG-CORONA_MH.csv', low_memory=False)
ae = pd.read_csv(f'{DATA}/TASK008_BCG-CORONA_AE.csv', low_memory=False)

# ---------- patient-level frame ----------
pat = dm[['USUBJID','TRTGRP','SEX','Age','RACE','education','work_hours',
          'patients_seen','expect_interact']].copy()
pat['bcg'] = (pat.TRTGRP == 'BCG').astype(int)
pat['expect_interact'] = (pat.expect_interact == 'Yes').astype(int)
ps_map = {'1-50': 1, '51-100': 2, '>100': 3}
pat['patients_seen_n'] = pat.patients_seen.map(ps_map)

# ongoing-condition counts
cnt_ongoing = mh[mh.MHONGO == 'Yes'].groupby('USUBJID').size().rename('n_ongoing')
cnt_total = mh[(mh.MHSPID == 4) & (mh.MHORRES == 2.0)].groupby('USUBJID').size().rename('n_total')
pat = pat.merge(cnt_ongoing, on='USUBJID', how='left').merge(cnt_total, on='USUBJID', how='left')
pat[['n_ongoing','n_total']] = pat[['n_ongoing','n_total']].fillna(0).astype(int)
pat['any_ongoing'] = (pat.n_ongoing > 0).astype(int)

# COVID-19 AE severity per subject
cov = ae[ae.AEPT.astype(str).str.contains('covid', case=False, na=False)]
pat = pat.merge(cov.groupby('USUBJID').AESEV.max().rename('covid_aesev'), on='USUBJID', how='left')
pat = pat.merge(cov.groupby('USUBJID').AEHS.max().rename('covid_aehs'), on='USUBJID', how='left')

print("=== Cohort counts ===")
print("subjects total:", len(pat), "| subjects with COVID-19 AE:", cov.USUBJID.nunique(),
      "| complete-case (covid AE + AESEV):", pat.covid_aesev.notna().sum())
print("\nPrimary outcome distribution (max COVID AESEV):")
print(pat.covid_aesev.value_counts().sort_index())
cc = pat[pat.covid_aesev.notna()]
print("\nPrimary cohort n_ongoing distribution:")
print(cc.n_ongoing.value_counts().sort_index())
print("\nPrimary cohort by bcg:")
print(cc.groupby('bcg').agg(n=('USUBJID','size'), mean_ongoing=('n_ongoing','mean'),
                             mean_sev=('covid_aesev','mean')).round(3))

COVS = ['bcg','patients_seen_n','expect_interact']

def fit_ordered(df, outcome, predictors, label):
    d = df[[outcome] + predictors].dropna()
    res = OrderedModel(d[outcome], d[predictors], distr='logit').fit(method='bfgs', disp=False)
    rows = []
    for p in predictors:
        b = res.params[p]; se = res.bse[p]; pval = res.pvalues[p]
        ci = res.conf_int().loc[p]
        rows.append(dict(var=p, beta=b, OR=np.exp(b), pct_odds=(np.exp(b)-1)*100,
                         OR_lo=np.exp(ci[0]), OR_hi=np.exp(ci[1]), p=pval))
    tbl = pd.DataFrame(rows).set_index('var')
    print(f"\n--- {label} (n={len(d)}) ---")
    print(tbl.round(4).to_string())
    print("thresholds:", np.round(res.params[len(predictors):],4).tolist())
    return res, tbl

res1, tbl1 = fit_ordered(pat[pat.covid_aesev.notna()], 'covid_aesev',
                         ['n_ongoing'] + COVS,
                         "PRIMARY: max COVID-19 AESEV ~ n_ongoing + BCG + patients_seen + expect_interact")

d = pat.copy(); d['sev_a'] = d.covid_aesev.fillna(1.0)
res_a, _ = fit_ordered(d, 'sev_a', ['n_ongoing'] + COVS,
                       "SENS-A: all subjects, no-COVID-AE = lowest category")

res_b, _ = fit_ordered(pat[pat.covid_aehs.notna()], 'covid_aehs', ['n_ongoing'] + COVS,
                       "SENS-B: max COVID-19 AEHS (0-7)")

res_c, _ = fit_ordered(pat[pat.covid_aesev.notna()], 'covid_aesev',
                       ['any_ongoing'] + COVS, "SENS-C: any ongoing (0/1)")

res_d, _ = fit_ordered(pat[pat.covid_aesev.notna()], 'covid_aesev',
                       ['n_total'] + COVS, "SENS-D: total reported conditions")

print("\n--- Proportional-odds check (primary): cutpoint-wise binary logits ---")
d0 = pat[pat.covid_aesev.notna()]
X = sm.add_constant(d0[['n_ongoing','bcg','patients_seen_n','expect_interact']])
for cut in sorted(d0.covid_aesev.unique())[:-1]:
    y = (d0.covid_aesev > cut).astype(int)
    m = sm.Logit(y, X).fit(disp=False)
    print(f"cut {cut}: beta(n_ongoing)={m.params['n_ongoing']:.4f} (p={m.pvalues['n_ongoing']:.4f})")

mn = sm.MNLogit(d0.covid_aesev, X).fit(disp=False)
print("\nMNLogit beta(n_ongoing) per category (ref=1):")
print(mn.params.loc['n_ongoing'].round(4).to_string())

print("\nPrimary fit: llf=%.3f, McFadden pseudo-R2=%.4f, n=%d" %
      (res1.llf, 1 - res1.llf/res1.llnull, res1.model.endog.shape[0]))

b = res1.params['n_ongoing']; ci = res1.conf_int().loc['n_ongoing']
print("\n>>> PRIMARY RESULT: OR/additional ongoing condition = %.4f -> %+.1f%% odds "
      "(95%% CI %.1f%% to %.1f%%), p=%.4f" %
      (np.exp(b), (np.exp(b)-1)*100, (np.exp(ci[0])-1)*100, (np.exp(ci[1])-1)*100,
       res1.pvalues['n_ongoing']))
