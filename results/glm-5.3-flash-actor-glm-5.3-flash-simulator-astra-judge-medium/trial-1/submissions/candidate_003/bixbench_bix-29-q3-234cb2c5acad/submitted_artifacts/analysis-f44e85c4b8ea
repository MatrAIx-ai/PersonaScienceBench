"""
TASK008 BCG-CORONA: interaction of BCG vaccination status x prior medical history
on COVID-19 severity (ordinal regression, proportional-odds logit), controlling
for patient interaction frequency (DM.patients_seen).

Decisions fixed by the researcher:
(i)   Outcome = max AESEV (1-4) over COVID-specific AEs; subjects w/o COVID AE -> 0;
      subjects whose COVID AEs all have NaN AESEV -> excluded and reported.
(ii)  mh_flag = any of the 18 fixed MH items with MHORRES==2, EXCLUDING
      'Current respiratory tract infection' (sensitivity: including it).
(iii) patients_seen as ordinal {1-50:1, 51-100:2, >100:3} (sensitivity: factor).
(iv)  Main model: severity ~ bcg * mh_flag + patients_seen  (proportional-odds logit).
      Sensitivities: +Age,SEX; RTI-based outcome; expect_interact covariate;
      patients_seen as factor.
"""
import numpy as np, pandas as pd, statsmodels.api as sm
from statsmodels.miscmodels.ordinal_model import OrderedModel
import scipy.stats as st

pd.set_option('display.width', 220)

DM_F = 'data/TASK008_BCG-CORONA_DM.csv'
AE_F = 'data/TASK008_BCG-CORONA_AE.csv'
MH_F = 'data/TASK008_BCG-CORONA_MH.csv'

dm = pd.read_csv(DM_F)
ae = pd.read_csv(AE_F, low_memory=False)
mh = pd.read_csv(MH_F, low_memory=False)

# ---------------------------------------------------------------- derived vars
dm = dm.copy()
dm['bcg'] = (dm['TRTGRP'] == 'BCG').astype(int)
dm['pat_seen_ord'] = dm['patients_seen'].map({'1-50': 1, '51-100': 2, '>100': 3})
dm['expect_interact_f'] = (dm['expect_interact'] == 'Yes').astype(int)
age_mid = {'10-19': 14.5, '20-29': 24.5, '30-39': 34.5, '40-49': 44.5,
           '50-59': 54.5, '60-69': 64.5, '70-79': 74.5}
dm['age_mid'] = dm['Age'].map(age_mid)
dm['sex_binary'] = (dm['SEX'] == 1).astype(int)   # SEX==1 coded as 1 (n=296)

FIXED_TERMS = ['Tuberculosis', 'Hypertension', 'Diabetes Mellitus',
               'Chronic Obstructive Pulmonary Disease', 'Asthma',
               'Other lung disease', 'Cardiovascular disease',
               'Cerebrovascular disease', 'Kidney disease', 'Liver disease',
               'Cancer', 'Organ or bone marrow transplantation',
               'Primary immunodeficiency', 'Neutropenia or lymphopenia',
               'Current respiratory tract infection', 'Allergy',
               'Hay fever', 'chronic sinusitis']

med = mh[(mh['MHSCAT'] == 'MEDICAL HISTORY') & (mh['MHTERM'].isin(FIXED_TERMS))].copy()
# wide table: per subject x term, MHORRES (1=No, 2=Yes [inferred])
wide = med.pivot_table(index='USUBJID', columns='MHTERM', values='MHORRES', aggfunc='first')

def mh_flag(term_set):
    sub = wide[[c for c in term_set if c in wide.columns]]
    return (sub == 2).any(axis=1).astype(int)

dm = dm.merge(mh_flag([t for t in FIXED_TERMS if t != 'Current respiratory tract infection'])
              .rename('mh_flag').to_frame(), left_on='USUBJID', right_index=True, how='left')
dm['mh_flag_sens_rti'] = dm['USUBJID'].map(mh_flag(FIXED_TERMS))
assert dm['mh_flag'].notna().all()

# COVID-specific AE outcome
COVID_PTS = ['COVID-19', 'COVID-19 pneumonia', 'Asymptomatic COVID-19',
             'SARS-CoV-2 test positive']
cov = ae[ae['AEPT'].isin(COVID_PTS)]
cov_sev = cov.groupby('USUBJID')['AESEV'].max()          # NaN if all missing
cov_any = cov.groupby('USUBJID').size()

def build_outcome(ae_source_pts, label):
    ev = ae[ae['AEPT'].isin(ae_source_pts)]
    g = ev.groupby('USUBJID')['AESEV']
    mx, cnt = g.max(), g.size()
    out = dm[['USUBJID']].copy()
    out['ev_n'] = out['USUBJID'].map(cnt).fillna(0).astype(int)
    out['sev_max'] = out['USUBJID'].map(mx)
    # no events -> 0 ; events but all NaN severity -> drop
    out['outcome'] = out['sev_max'].fillna(0)
    drop = out.loc[out['ev_n'] > 0, 'USUBJID'][out['sev_max'].isna()]
    return out, set(drop)

out_covid, drop_covid = build_outcome(COVID_PTS, 'covid')

# RTI outcome: max AESEV over AECAT=='RTI' (all respiratory AEs), only subjects with events
rti_ev = ae[ae['AECAT'] == 'RTI']
rti_g = rti_ev.groupby('USUBJID')['AESEV']
rti_max, rti_n = rti_g.max(), rti_g.size()
out_rti = dm[['USUBJID']].copy()
out_rti['ev_n'] = out_rti['USUBJID'].map(rti_n).fillna(0).astype(int)
out_rti['sev_max'] = out_rti['USUBJID'].map(rti_max)

dm = dm.merge(out_covid[['USUBJID', 'outcome', 'ev_n']].rename(
    columns={'outcome': 'severity', 'ev_n': 'covid_ev_n'}), on='USUBJID')

print('=== Outcome construction (COVID-specific) ===')
print('Subjects with >=1 COVID AE:', len(cov_any), '| all-NaN severity (dropped):', len(drop_covid))
print('Severity level counts (all 1000, level 0 = no COVID-19 illness):')
print(dm['severity'].value_counts().sort_index().to_string())
print('By TRTGRP x mh_flag:')
print(pd.crosstab([dm.TRTGRP, dm.mh_flag], dm.severity))

# ---------------------------------------------------------------- model helpers
def fit_po(df, na_cols, fml):
    d = df.dropna(subset=na_cols).copy()
    mod = OrderedModel.from_formula(fml, data=d, distr='logit')
    res = mod.fit(method='bfgs', disp=False)
    return res, d

def coef_table(res):
    params = res.params
    ci = res.conf_int()
    t = pd.DataFrame({
        'coef': params,
        'se': res.bse,
        'p': res.pvalues,
        'lo95': ci[0] if isinstance(ci, tuple) else ci.iloc[:, 0],
        'hi95': ci[1] if isinstance(ci, tuple) else ci.iloc[:, 1],
    })
    t['OR'] = np.exp(t['coef'])
    t['OR_lo'] = np.exp(t['lo95'])
    t['OR_hi'] = np.exp(t['hi95'])
    return t[['coef', 'se', 'OR', 'OR_lo', 'OR_hi', 'p']]

def interaction_row(res, term='bcg:mh_flag'):
    t = coef_table(res)
    if term not in t.index:
        for ix in t.index:
            if 'bcg' in ix and 'mh_flag' in ix:
                term = ix; break
    r = t.loc[term]
    return dict(term=term, OR=r['OR'], lo=r['OR_lo'], hi=r['OR_hi'], p=r['p'])

# proportional-odds diagnostic (Wald-type test analogous to Brant):
# fit binary logits Y>k for each cut and test equality of each covariate's
# coefficients across cuts.
def po_check(d, design, ycol='severity'):
    y = d[ycol].astype(int)
    cuts = sorted(y.unique())
    cuts = [c for c in cuts if c < max(cuts)]
    rows = []; used_cuts = []
    for k in cuts:
        b = (y > k).astype(int)
        if b.sum() < 5 or b.sum() > len(b) - 5:
            print(f'  cut {k}: {int(b.sum())} events -> too sparse, skipped')
            continue
        X = sm.add_constant(design, prepend=False)
        try:
            m = sm.Logit(b, X).fit(disp=False, maxiter=200)
        except Exception as e:
            print(f'  cut {k}: logit not estimable ({type(e).__name__}) - possible separation')
            continue
        if not m.mle_retvals['converged']:
            m = sm.Logit(b, X).fit(method='lbfgs', disp=False, maxiter=500)
        rows.append(m); used_cuts.append(k)
    print('  cuts used:', used_cuts)
    names = rows[0].params.index
    if len(rows) < 2:
        print('  <2 estimable cuts: proportional-odds check not feasible')
        return pd.DataFrame()
    out = {}
    for p in names:
        b = np.array([m.params[p] for m in rows])
        V = np.diag([m.bse[p] ** 2 for m in rows])
        # Wald test of equality across cuts
        J = len(rows)
        C = np.zeros((J - 1, J)); 
        for j in range(J - 1):
            C[j, j] = 1; C[j, j + 1] = -1
        w = C @ b
        Vc = C @ V @ C.T
        chi2 = float(w @ np.linalg.pinv(Vc) @ w)
        out[p] = (chi2, J - 1, float(st.chi2.sf(chi2, J - 1)))
    return pd.DataFrame(out, index=['chi2', 'df', 'p']).T

results = {}
print('\n=== MAIN MODEL: severity ~ bcg * mh_flag + patients_seen (ordinal) ===')
rhs = ['bcg', 'mh_flag', 'pat_seen_ord', 'bcg:mh_flag']
res_main, d_main = fit_po(dm, ['severity','pat_seen_ord'], 'severity ~ bcg * mh_flag + pat_seen_ord')
print(f'n = {len(d_main)}')
print(coef_table(res_main).round(4).to_string())
results['main'] = interaction_row(res_main)
print('\nProportional-odds check (Wald equality of coefficients across cuts):')
design_main = d_main[['bcg','mh_flag','pat_seen_ord']].assign(inter=d_main.bcg*d_main.mh_flag)
print(po_check(d_main, design_main).round(4).to_string())

# ---- sensitivity 1: + Age, SEX
print('\n=== SENSITIVITY A: + age_mid + sex_binary ===')
rhs_a = rhs + ['age_mid', 'sex_binary']
res_a, d_a = fit_po(dm, ['severity','pat_seen_ord','age_mid'], 'severity ~ bcg * mh_flag + pat_seen_ord + age_mid + sex_binary')
print(f'n = {len(d_a)}')
print(coef_table(res_a).round(4).to_string())
results['sens_age_sex'] = interaction_row(res_a)

# ---- sensitivity 2: patients_seen as factor
print('\n=== SENSITIVITY B: patients_seen as factor ===')
rhs_b = ['bcg', 'mh_flag', 'C(pat_seen_ord)', 'bcg:mh_flag']
res_b, d_b = fit_po(dm, ['severity','pat_seen_ord'], 'severity ~ bcg * mh_flag + C(pat_seen_ord)')
print(f'n = {len(d_b)}')
print(coef_table(res_b).round(4).to_string())
results['sens_pat_factor'] = interaction_row(res_b)

# ---- sensitivity 3: mh_flag including Current RTI
print('\n=== SENSITIVITY C: mh_flag includes Current RTI ===')
d_c = dm.copy(); d_c['mh_flag'] = d_c['mh_flag_sens_rti']
res_c, d_c2 = fit_po(d_c, ['severity','pat_seen_ord'], 'severity ~ bcg * mh_flag + pat_seen_ord')
print(f'n = {len(d_c2)}')
print(coef_table(res_c).round(4).to_string())
results['sens_mh_rti'] = interaction_row(res_c)

# ---- sensitivity 4: expect_interact as additional covariate
print('\n=== SENSITIVITY D: + expect_interact ===')
rhs_d = rhs + ['expect_interact_f']
res_d, d_d = fit_po(dm, ['severity','pat_seen_ord'], 'severity ~ bcg * mh_flag + pat_seen_ord + expect_interact_f')
print(f'n = {len(d_d)}')
print(coef_table(res_d).round(4).to_string())
results['sens_expect'] = interaction_row(res_d)

# ---- sensitivity 5: RTI-based outcome among subjects with RTI events (no level 0)
print('\n=== SENSITIVITY E: outcome = max RTI AESEV, subjects with RTI AEs only ===')
d_e = dm.drop(columns=[c for c in ['severity','covid_ev_n'] if c in dm.columns])
d_e = d_e.merge(out_rti[['USUBJID', 'ev_n', 'sev_max']], on='USUBJID')
d_e = d_e[d_e['ev_n'] > 0]
n_rti_subj = len(d_e)
d_e = d_e.dropna(subset=['sev_max']).rename(columns={'sev_max': 'severity'})
res_e, d_e2 = fit_po(d_e, ['severity','pat_seen_ord'], 'severity ~ bcg * mh_flag + pat_seen_ord')
print(f'n = {len(d_e2)} of {n_rti_subj} RTI subjects (dropped all-NaN RTI severity: {n_rti_subj - len(d_e2)})')
print('Outcome level counts:', d_e2['severity'].value_counts().sort_index().to_dict())
print(coef_table(res_e).round(4).to_string())
results['sens_rti_outcome'] = interaction_row(res_e)

# ---------------------------------------------------------------- summary
print('\n================ SUMMARY: BCG x medical-history interaction OR ================')
summ = pd.DataFrame(results).T[['OR', 'lo', 'hi', 'p']].round(4)
summ.index = ['MAIN: COVID outcome, min. spec', '+Age+SEX', 'patients_seen as factor',
              'mh_flag incl. Current RTI', '+expect_interact', 'RTI-based outcome (n=RTI subj)']
print(summ.to_string())
summ.to_csv('results_interaction_OR.csv')
coef_table(res_main).round(5).to_csv('main_model_coefficients.csv')
