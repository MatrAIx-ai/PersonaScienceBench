"""BixBench bix-3-q5 — Paroxetine RNA-seq (Mueller et al. 2017 data deposition).

Question: after differential gene expression analysis on three tissue comparisons
(Final vs Baseline blood, Dentate gyrus vs Baseline blood, Dentate gyrus vs Final blood)
and a binomial exact test with a 5% threshold, which tissue comparison shows
negligible effects?

Pipeline
  1. Load workbook; verify NormCount sample headers == Mapping_statistics Code (90/90).
  2. Verify the embedded per-tissue Max/Median summary columns reproduce group
     statistics of the normalized counts (parsing validation).
  3. Identify the 9 embedded 'DESeq, Comparison N, exclude outliers' blocks:
     for every block, correlate its log2FoldChange with log2(meanB/meanA) for ALL
     ordered candidate group pairs (3 Response strata x 3 tissues + whole-tissue
     groups). Verified outcome: every block is a WITHIN-tissue Response comparison;
     none is a tissue comparison -> the three tissue comparisons must be computed.
  4. Differential expression for the three tissue comparisons on the normalized
     counts: per-gene Welch t-test on log2(count+1) (30 vs 30 samples; Response
     strata balanced 10/10/10 in each tissue), Benjamini-Hochberg padj,
     DEG 'success' = padj < 0.05 AND |log2FC| > 1 (FDR 5% + twofold change).
  5. Binomial exact test per comparison: K DEGs out of n tested genes,
     H0: P(success) = 0.05, one-sided (greater). Negligible effect = H0 NOT rejected
     (DEG share does not significantly exceed 5%).
  6. Sanity check per Response stratum; sensitivity to dropping nonstandard gene IDs
     ('a','l7Rn6','rp9') and the case-insensitive duplicate ('H2-t9' vs 'H2-T9').
"""
import re
import pickle
from collections import defaultdict
import itertools

import numpy as np
import pandas as pd
from scipy import stats

XLSX = 'data/Data_deposition_RNAseq_Paroxetine_2017.xlsx'
P0 = 0.05      # binomial null share of DEGs
LFC_T = 1.0    # minimum |log2FC| for a DEG (2-fold change)
ALPHA = 0.05   # FDR cutoff defining a DEG 'success'

log = lambda *a: print(*a, flush=True)

# ============================ 1. Load ============================
raw = pd.read_excel(XLSX, sheet_name='NormCount', header=None)
hdr = [str(x) for x in raw.iloc[3].tolist()]
data = raw.iloc[4:].copy().reset_index(drop=True)
data.columns = range(raw.shape[1])
gene_ids = data[1].astype(str)
log(f"[load] genes: {len(gene_ids)}")

lower = gene_ids.str.lower()
ci_dup_ids = sorted(gene_ids[lower.duplicated(keep=False)].unique())
odd_ids = [g for g in ['a', 'l7Rn6', 'rp9'] if (gene_ids == g).any()]
log(f"[load] case-insensitive duplicate GeneIDs: {ci_dup_ids}")
log(f"[load] nonstandard trailing GeneIDs: {odd_ids}")

counts = data.iloc[:, 2:92].apply(pd.to_numeric, errors='coerce')
counts.columns = hdr[2:92]
names = hdr[2:92]

ms = pd.read_excel(XLSX, sheet_name='Mapping_statistics')
assert names == ms['Code'].astype(str).tolist()
log("[validate] NormCount headers == Mapping_statistics 'Code' (90/90): OK")
log(f"[validate] normalized counts: fractional cells={(counts.values % 1 != 0).sum()}, "
    f"NaN={counts.isna().sum().sum()}, negatives={(counts.values < 0).sum()}")

pat = re.compile(r'(Control|good_responder|bad_responder)_(baseline_blood|dentate_gyrus|final_blood)(\d+)$')
groups = {}
for n in names:
    r, t, rep = pat.match(n).groups()
    groups.setdefault((r, t), []).append(n)
assert all(len(v) == 10 for v in groups.values())
for (r, t), v in sorted(groups.items()):
    log(f"[samples] {r:15s} {t:14s}: {len(v)} samples")
gm = {k: counts[v].mean(axis=1) for k, v in groups.items()}

tissues = ['baseline_blood', 'dentate_gyrus', 'final_blood']
def tissue_of(x):
    for t in tissues:
        if x.endswith(t):
            return t
    raise ValueError(x)

tiss_cols = {t: [c for (r, tt), v in groups.items() if tt == t for c in v] for t in tissues}
tiss_median = {t: counts[tiss_cols[t]].median(axis=1) for t in tissues}
for i, t in enumerate(tissues):     # embedded Max (cols 92-94) / Median (95-97)
    mx = pd.to_numeric(data[92 + i], errors='coerce')
    md = pd.to_numeric(data[95 + i], errors='coerce')
    log(f"[validate] embedded Max/Median [{t}]: "
        f"Max MAE={(mx - counts[tiss_cols[t]].max(axis=1)).abs().mean():.4g}, "
        f"Median MAE={(md - tiss_median[t]).abs().mean():.4g}")

# ============ 2. Identification of the 9 embedded DESeq blocks ============
blocks = []
for b in range(9):
    s = 98 + 9 * b
    assert str(raw.iloc[0, s]).startswith('DESeq, Comparison'), raw.iloc[0, s]
    blk = {'label': f'Comparison {b + 1}',
           'baseMean':  pd.to_numeric(data[s], errors='coerce'),
           'baseMeanA': pd.to_numeric(data[s + 1], errors='coerce'),
           'baseMeanB': pd.to_numeric(data[s + 2], errors='coerce'),
           'log2FC':    pd.to_numeric(data[s + 4], errors='coerce'),
           'pval':      pd.to_numeric(data[s + 5], errors='coerce'),
           'padj':      pd.to_numeric(data[s + 6], errors='coerce')}
    blk['n'] = int(blk['padj'].notna().sum())
    blk['K'] = int((blk['padj'] < ALPHA).sum())
    blocks.append(blk)

cands = {f'ALL_{t}': counts[tiss_cols[t]].mean(axis=1) for t in tissues}
cands.update({f'{r}_{t}': m for (r, t), m in gm.items()})
keys = sorted(cands)

log("\n[block identification] best-matching group pair per DESeq block "
    "(corr of block log2FC with log2(meanB/meanA); all ordered candidate pairs tested)")
block_rows = []
for i, blk in enumerate(blocks):
    l2 = blk['log2FC'].values
    rows = []
    for A, B in itertools.permutations(keys, 2):
        ratio = np.log2(cands[B].clip(lower=0.5).values / cands[A].clip(lower=0.5).values)
        ok = np.isfinite(ratio) & np.isfinite(l2)
        rows.append((np.corrcoef(l2[ok], ratio[ok])[0, 1], A, B))
    rows.sort(reverse=True)
    block_rows.append(rows)
    r0, A0, B0 = rows[0]
    log(f"  {blk['label']}: best pair = {A0} vs {B0} (r={r0:.3f}); "
        f"n_tested={blk['n']}, K(padj<0.05)={blk['K']} ({blk['K']/blk['n']:.2%})")

log("\n[block identification] strongest CROSS-TISSUE pair per block (contrast):")
for i, rows in enumerate(block_rows):
    cross = sorted((x for x in rows if tissue_of(x[1]) != tissue_of(x[2])), reverse=True)
    log(f"  {blocks[i]['label']}: best cross-tissue = {cross[0][1]} vs {cross[0][2]} "
        f"(r={cross[0][0]:.3f}) vs best within-tissue r={rows[0][0]:.3f}")
log("  => every block is a WITHIN-tissue Response comparison; no embedded block "
    "represents any of the three tissue comparisons.")

# ============ 3. Differential expression: three tissue comparisons ============
log2c = np.log2(counts + 1.0)

def bh(p):
    p = np.asarray(p, float)
    n = len(p)
    o = np.argsort(p)
    q = np.minimum.accumulate((p[o] * n / np.arange(1, n + 1))[::-1])[::-1]
    out = np.empty(n)
    out[o] = np.clip(q, 0, 1)
    return out

def tissue_de(colsA, colsB):
    xA = log2c[colsA].values
    xB = log2c[colsB].values
    t, p = stats.ttest_ind(xB, xA, axis=1, equal_var=False, nan_policy='omit')
    lfc = xB.mean(axis=1) - xA.mean(axis=1)
    ok = np.isfinite(p)
    padj = np.full(len(p), np.nan)
    padj[ok] = bh(p[ok])
    return lfc, p, padj, ok

def binom_p(K, n, p0=P0):
    return stats.binomtest(int(K), int(n), p0, alternative='greater').pvalue

comparisons = [('final_blood', 'baseline_blood', 'Final blood vs Baseline blood'),
               ('dentate_gyrus', 'baseline_blood', 'Dentate gyrus vs Baseline blood'),
               ('dentate_gyrus', 'final_blood', 'Dentate gyrus vs Final blood')]

log("\n[tissue DE] Welch t-test on log2(normalized counts+1), 30 vs 30, BH padj; "
    "DEG = padj<0.05 & |log2FC|>1")
res = {}
for A, B, label in comparisons:
    lfc, p, padj, ok = tissue_de(tiss_cols[A], tiss_cols[B])
    n = int(ok.sum())
    K0 = int((padj[ok] < ALPHA).sum())
    K = int(((padj[ok] < ALPHA) & (np.abs(lfc[ok]) > LFC_T)).sum())
    res[label] = {'n': n, 'K': K, 'share': K / n, 'binom_p': binom_p(K, n),
                  'ok': ok, 'padj': padj, 'lfc': lfc, 'K_nofilter': K0}
    log(f"  {label:38s}: n={n}, K(padj<0.05 only)={K0} ({K0/n:.2%}), "
        f"K(padj<0.05 & |lfc|>1)={K} ({K/n:.2%}), binom p={res[label]['binom_p']:.3e}")

# ============ 4. Sanity check: per Response stratum ============
log("\n[sanity: per Response stratum] same pipeline within each stratum (10 vs 10)")
for r in ['Control', 'good_responder', 'bad_responder']:
    cols_r = {t: [c for (rr, tt), v in groups.items() if rr == r and tt == t for c in v]
              for t in tissues}
    for A, B, label in comparisons:
        lfc, p, padj, ok = tissue_de(cols_r[A], cols_r[B])
        n = int(ok.sum()); K = int(((padj[ok] < ALPHA) & (np.abs(lfc[ok]) > LFC_T)).sum())
        log(f"  {r:15s} {label:38s}: n={n}, K={K}, share={K/n:.4f}, binom p={binom_p(K,n):.3e}")

# ============ 5. Sensitivity: odd / duplicate gene IDs ============
drop_mask = gene_ids.isin(odd_ids) | (lower.duplicated(keep='first') & (lower != gene_ids))
drop_idx = gene_ids[drop_mask].index.tolist()
log(f"\n[sensitivity] dropping {len(drop_idx)} rows: {gene_ids[drop_mask].tolist()}")
for A, B, label in comparisons:
    d = res[label]
    ok = d['ok'].copy(); ok[drop_idx] = False
    n = int(ok.sum())
    K = int(((d['padj'][ok] < ALPHA) & (np.abs(d['lfc'][ok]) > LFC_T)).sum())
    p = binom_p(K, n)
    same = (p < ALPHA) == (d['binom_p'] < ALPHA)
    log(f"  {label:38s}: n={n}, K={K}, share={K/n:.4f}, binom p={p:.3e} "
        f"(main p={d['binom_p']:.3e}, verdict unchanged: {same})")

# ============ 6. Final ============
log("\n" + "=" * 34 + " FINAL " + "=" * 34)
for A, B, label in comparisons:
    d = res[label]
    verdict = ('DEG share significantly EXCEEDS 5% -> effect present'
               if d['binom_p'] < ALPHA else
               'DEG share does NOT significantly exceed 5% -> NEGLIGIBLE EFFECT')
    log(f"{label}: n={d['n']}, K={d['K']}, DEG share={d['share']:.4f}, "
        f"binom p={d['binom_p']:.3e} -> {verdict}")

with open('analysis/state.pkl', 'wb') as f:
    pickle.dump({'results': {k: {kk: vv for kk, vv in v.items() if kk in ('n', 'K', 'share', 'binom_p')}
                             for k, v in res.items()},
                 'best_pairs': [(rows[0][1], rows[0][2], rows[0][0]) for rows in block_rows],
                 'ci_dups': ci_dup_ids, 'odd': odd_ids}, f)
log("[state] saved analysis/state.pkl")
