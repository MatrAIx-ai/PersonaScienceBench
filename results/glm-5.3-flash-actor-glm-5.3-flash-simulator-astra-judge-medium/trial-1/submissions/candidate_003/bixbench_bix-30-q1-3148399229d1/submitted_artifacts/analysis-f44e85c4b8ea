#!/usr/bin/env python3
"""
Differential expression of serum miRNAs, DM1 patients vs healthy controls.
Data: data/pone.0150501.s002.xls (PLOS ONE e0150501, Table S1 — Ct values).

FIXED ASSUMPTION (approved by researcher): sample-name prefixes encode groups —
  P_1..P_10  = patients (DM1, myotonic dystrophy type 1)
  C_11..C_20 = healthy controls
Supported by the in-sheet title: "Ct values for 175 miRNAs in DM1 and
healthy controls serum". No separate metadata row exists in the file.

Primary analysis: Welch two-sample t-test on ΔCt, where
  ΔCt(miRNA, sample) = Ct(miRNA, sample) − mean Ct(sample)   [global normalization]
Ct is already a log2-scale quantity, so no extra log transform is applied.
Lower ΔCt = higher expression; log2FC reported as mean(ΔCt_control) − mean(ΔCt_patient)
(positive = up-regulated in patients).
Significance BEFORE multiple-testing correction: p < 0.05 (two-sided).
Primary denominator: all 175 miRNAs in the table.
Sensitivity analyses: Welch on raw Ct; Wilcoxon rank-sum on ΔCt.
"""
import sys, math
sys.path.insert(0, 'work')
from xls_reader import load_table
from scipy import stats

XLS = 'data/pone.0150501.s002.xls'
ALPHA = 0.05          # significance threshold BEFORE multiple-testing correction
MIN_N_PER_GROUP = 3   # minimum valid values per group after pairwise NAN removal

# ---------- load ----------
ids, samples, vals = load_table(XLS)
n_samp = len(samples)
p_idx = [i for i, s in enumerate(samples) if s.startswith('P_')]
c_idx = [i for i, s in enumerate(samples) if s.startswith('C_')]
print(f'samples: {n_samp}  patients(P_): {len(p_idx)}  controls(C_): {len(c_idx)}')
print(f'miRNA rows loaded: {len(ids)}')

# numeric coercion: 'NAN' (and any non-numeric) -> None
def to_num(v):
    if isinstance(v, (int, float)):
        return float(v)
    return None
num = [[to_num(v) for v in row] for row in vals]

n_nan = sum(1 for row in num for v in row if v is None)
print(f'missing ("NAN") cells: {n_nan} of {len(ids)*n_samp}')

# ---------- global (sample-level) normalization: ΔCt ----------
sample_means = []
for j in range(n_samp):
    col = [num[i][j] for i in range(len(ids)) if num[i][j] is not None]
    sample_means.append(sum(col) / len(col))
print('per-sample mean Ct (normalizers): '
      + ', '.join(f'{s}={m:.2f}' for s, m in zip(samples, sample_means)))

dct = [[(num[i][j] - sample_means[j]) if num[i][j] is not None else None
        for j in range(n_samp)] for i in range(len(ids))]

# ---------- per-miRNA tests ----------
def paired_clean(a_idx, b_idx, matrix, i):
    """indices with valid values in BOTH... actually pairwise per group independently"""
    a = [matrix[i][j] for j in a_idx if matrix[i][j] is not None]
    b = [matrix[i][j] for j in b_idx if matrix[i][j] is not None]
    return a, b

results = []
for i, mid in enumerate(ids):
    row = {}
    # primary: Welch t-test on ΔCt
    a, b = paired_clean(p_idx, c_idx, dct, i)          # a=patients, b=controls
    t_p = t_raw = t_w = p_p = p_raw = p_w = float('nan')
    l2fc = float('nan')
    if len(a) >= MIN_N_PER_GROUP and len(b) >= MIN_N_PER_GROUP:
        t_p, p_p = stats.ttest_ind(a, b, equal_var=False)
        l2fc = (sum(b)/len(b)) - (sum(a)/len(a))       # + = up in patients
        # sensitivity 1: Welch on raw Ct
        ra = [num[i][j] for j in p_idx if num[i][j] is not None]
        rb = [num[i][j] for j in c_idx if num[i][j] is not None]
        t_raw, p_raw = stats.ttest_ind(ra, rb, equal_var=False)
        # sensitivity 2: Wilcoxon rank-sum on ΔCt
        if len(set(a)) > 1 or len(set(b)) > 1:
            t_w, p_w = stats.mannwhitneyu(a, b, alternative='two-sided')
    row = dict(id=mid, n_p=len(a), n_c=len(b), p_p=p_p, p_raw=p_raw,
               p_w=p_w, l2fc=l2fc, mean_p=sum(a)/len(a) if a else float('nan'),
               mean_c=sum(b)/len(b) if b else float('nan'))
    results.append(row)

tested = [r for r in results if not math.isnan(r['p_p'])]
print(f'\n=== PRIMARY: Welch t-test on ΔCt (global normalization), p < {ALPHA} uncorrected ===')
print(f'miRNAs in table: {len(results)}')
print(f'miRNAs testable (>= {MIN_N_PER_GROUP} valid values per group after NAN removal): {len(tested)}')
sig = [r for r in results if not math.isnan(r['p_p']) and r['p_p'] < ALPHA]
sig_tested = [r for r in tested if r['p_p'] < ALPHA]
print(f'significant (p<0.05): {len(sig)} of {len(results)}  =  {100*len(sig)/len(results):.1f}% of all 175')
print(f'significant as % of testable: {100*len(sig_tested)/len(tested):.1f}% ({len(sig_tested)}/{len(tested)})')

up = [r for r in sig if r['l2fc'] > 0]; dn = [r for r in sig if r['l2fc'] < 0]
print(f'direction among significant: up in patients {len(up)}, down in patients {len(dn)}')
print('top significant (by p):')
for r in sorted(sig, key=lambda r: r['p_p'])[:10]:
    print(f"  {r['id']:<16} p={r['p_p']:.3e}  log2FC(pat/cnt)={r['l2fc']:+.2f}  "
          f"meanΔCt p={r['mean_p']:.2f} c={r['mean_c']:.2f}  n={r['n_p']}/{r['n_c']}")

# ---------- sensitivity ----------
sig_raw = [r for r in tested if not math.isnan(r['p_raw']) and r['p_raw'] < ALPHA]
sig_w   = [r for r in tested if not math.isnan(r['p_w']) and r['p_w'] < ALPHA]
print(f'\n=== SENSITIVITY (among {len(tested)} testable) ===')
print(f'Welch on raw Ct:    significant {len(sig_raw)} ({100*len(sig_raw)/len(tested):.1f}%)')
print(f'Wilcoxon on ΔCt:    significant {len(sig_w)} ({100*len(sig_w)/len(tested):.1f}%)')
# concordance of the primary call set
both_raw = len([r for r in sig_tested if r['p_raw'] < ALPHA])
both_w   = len([r for r in sig_tested if r['p_w'] < ALPHA])
print(f'primary sig also sig by raw-Ct Welch: {both_raw}/{len(sig_tested)}')
print(f'primary sig also sig by Wilcoxon:     {both_w}/{len(sig_tested)}')

# ---------- final answer ----------
print('\n=== FINAL ANSWER ===')
print(f'Percentage of miRNAs with significant differential expression (p < 0.05, Welch t-test '
      f'on global-normalized ΔCt, BEFORE multiple-testing correction): '
      f'{len(sig)}/{len(results)} = {100*len(sig)/len(results):.1f}% of all 175 miRNAs.')
print(f'Of the {len(tested)} miRNAs with sufficient data after pairwise NAN removal '
      f'(>= {MIN_N_PER_GROUP} per group): {len(sig_tested)}/{len(tested)} = '
      f'{100*len(sig_tested)/len(tested):.1f}%.')
