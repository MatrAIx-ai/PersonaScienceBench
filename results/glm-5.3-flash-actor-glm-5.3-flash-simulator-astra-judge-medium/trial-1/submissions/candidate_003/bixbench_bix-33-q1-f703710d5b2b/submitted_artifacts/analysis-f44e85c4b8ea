#!/usr/bin/env python3
"""
Analysis: Which immune cell type has the highest number of significantly
differentially expressed genes (Post-AAV vs Pre-AAV) after AAV9 mini-dystrophin
treatment?

Self-contained: uses ONLY the workbook
  data/Supplemental Data File 1 PostvsPre_DEG_tables_ANNOTATED by_cell_type.xlsx
(25 worksheets, one per cell type; columns: gene, p_val, avg_log2FC, pct.1,
 pct.2, p_val_adj).

Primary significance criterion: p_val_adj < 0.05 (Benjamini-Hochberg adjusted).
Sensitivity checks:
  (a) p_val_adj < 0.05 AND |avg_log2FC| >= 0.25   (expected: no change; tables
      are pre-filtered at Seurat's logfc.threshold = 0.25)
  (b) stricter FC cutoffs: |avg_log2FC| >= 0.5 and >= 1.0
  (c) up/down direction breakdown for the top cell types
  (d) counts by raw p_val < 0.05 as well as p_val_adj < 0.05
Tie check at the top of the ranking is reported explicitly.
"""
import pandas as pd

XLSX = "data/Supplemental Data File 1 PostvsPre_DEG_tables_ANNOTATED by_cell_type.xlsx"

xl = pd.ExcelFile(XLSX, engine="openpyxl")
assert len(xl.sheet_names) == 25, f"expected 25 sheets, found {len(xl.sheet_names)}"

rows = []
for sheet in xl.sheet_names:
    df = xl.parse(sheet).rename(columns={"Unnamed: 0": "gene"})
    assert list(df.columns) == ["gene", "p_val", "avg_log2FC", "pct.1", "pct.2", "p_val_adj"], sheet
    assert df["p_val"].notna().all() and df["p_val_adj"].notna().all(), f"NaNs in {sheet}"
    assert not df["gene"].duplicated().any(), f"duplicate genes in {sheet}"
    rows.append({
        "cell_type": sheet,
        "n_rows_tested": len(df),
        "sig_pval": int((df["p_val"] < 0.05).sum()),
        "sig_padj": int((df["p_val_adj"] < 0.05).sum()),
        "sig_padj_fc025": int(((df["p_val_adj"] < 0.05) & (df["avg_log2FC"].abs() >= 0.25)).sum()),
        "sig_padj_fc05":  int(((df["p_val_adj"] < 0.05) & (df["avg_log2FC"].abs() >= 0.5)).sum()),
        "sig_padj_fc10":  int(((df["p_val_adj"] < 0.05) & (df["avg_log2FC"].abs() >= 1.0)).sum()),
        "up_padj":   int(((df["p_val_adj"] < 0.05) & (df["avg_log2FC"] > 0)).sum()),
        "down_padj": int(((df["p_val_adj"] < 0.05) & (df["avg_log2FC"] < 0)).sum()),
        "min_abs_log2fc_in_table": float(df["avg_log2FC"].abs().min()),
    })

res = pd.DataFrame(rows).sort_values("sig_padj", ascending=False).reset_index(drop=True)
res.insert(0, "rank", res.index + 1)

print("=" * 110)
print("RANKING: significant DEGs per cell type (Post-AAV vs Pre-AAV), p_val_adj < 0.05 (primary criterion)")
print("=" * 110)
show = res[["rank", "cell_type", "n_rows_tested", "sig_padj", "sig_padj_fc025",
            "sig_padj_fc05", "sig_padj_fc10", "up_padj", "down_padj", "sig_pval",
            "min_abs_log2fc_in_table"]]
print(show.to_string(index=False,
      formatters={"min_abs_log2fc_in_table": "{:.3f}".format}))

print()
print("SENSITIVITY CHECKS")
print("-" * 110)
same = (res["sig_padj"] == res["sig_padj_fc025"]).all()
print(f"(a) p_val_adj<0.05 + |avg_log2FC|>=0.25 identical to primary counts everywhere: {same}")
print(f"    min |avg_log2FC| across ALL rows of ALL sheets = "
      f"{res['min_abs_log2fc_in_table'].min():.4f}  (tables pre-filtered at 0.25)")
print(f"(d) raw p_val<0.05 vs p_val_adj<0.05 differ per cell type where p_val>padj; "
      f"top by raw p_val: "
      f"{res.sort_values('sig_pval', ascending=False).iloc[0]['cell_type']} "
      f"({res.sort_values('sig_pval', ascending=False).iloc[0]['sig_pval']})")

top = res.iloc[0]
ties = res[res["sig_padj"] == res["sig_padj"].max()]
print()
print("TOP RESULT / TIE CHECK")
print("-" * 110)
print(f"Highest count: {top['cell_type']} with {top['sig_padj']} significant DEGs "
      f"(p_val_adj < 0.05), of which {top['up_padj']} up and {top['down_padj']} down "
      f"in Post-AAV vs Pre-AAV.")
print(f"Ties at the top: {len(ties)} cell type(s) share the maximum count "
      f"({', '.join(ties['cell_type']) if len(ties) > 1 else 'none — unique leader'}).")
runner = res.iloc[1]
print(f"Runner-up: {runner['cell_type']} ({runner['sig_padj']}); "
      f"margin = {top['sig_padj'] - runner['sig_padj']} genes.")
print()
print("Direction breakdown for top 5 (p_val_adj<0.05):")
print(res.head(5)[["cell_type", "sig_padj", "up_padj", "down_padj",
                   "sig_padj_fc05", "sig_padj_fc10"]].to_string(index=False))

res.to_csv("outputs/deg_counts_by_cell_type.csv", index=False)
print()
print("Saved: outputs/deg_counts_by_cell_type.csv")
