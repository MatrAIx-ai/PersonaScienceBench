"""BixBench bix-37-q2: Base protein level of ENO1 in normal samples (proteomics)."""
import openpyxl

WB = "data/Proteomic_data .xlsx"
SHEET = "Tumor vs Normal"

wb = openpyxl.load_workbook(WB, read_only=True)
ws = wb[SHEET]

rows = ws.iter_rows(values_only=True)
header = [str(h).strip() if h is not None else "" for h in next(rows)]
col = {name: i for i, name in enumerate(header)}
print("Header:", header)

matches = []
n_data = 0
for rnum, row in enumerate(rows, start=2):  # worksheet row number (header = row 1)
    if all(v is None for v in row):
        continue
    n_data += 1
    gene = str(row[col["gene"]]).strip().upper() if row[col["gene"]] is not None else ""
    if gene == "ENO1":
        matches.append((rnum, row))

print(f"Data rows: {n_data}")
print(f"Exact gene == ENO1 matches: {len(matches)}")

# Cross-checks and value extraction
for rnum, row in matches:
    uniprot, desc, gene, gene_id = row[col["protein"]], row[col["Description"]], row[col["gene"]], row[col["gene_id"]]
    normal, tumor = row[col["Normal"]], row[col["Tumor"]]
    ratio, fc, log2fc = row[col["Ratio"]], row[col["FC"]], row[col["log2FC"]]
    assert uniprot == "P06733", f"UniProt mismatch: {uniprot}"
    assert str(gene_id) == "2023", f"Entrez ID mismatch: {gene_id}"
    assert "Alpha-enolase" in desc and "GN=ENO1" in desc, f"Description mismatch: {desc}"
    print(f"\nWorksheet row {rnum}:")
    print(f"  protein={uniprot}  gene={gene}  gene_id={gene_id}")
    print(f"  Description={desc}")
    print(f"  Normal (verbatim) = {normal!r}")
    print(f"  Tumor  (verbatim) = {tumor!r}")
    print(f"  Ratio={ratio}  FC={fc}  log2FC={log2fc}")
    # scale sanity: linear intensity check Normal * FC ~ Tumor
    print(f"  Sanity: Normal * FC = {normal * fc:.6g} vs Tumor = {tumor:.6g} -> consistent linear scale")

assert len(matches) == 1, "Expected exactly one ENO1 row"
normal_value = matches[0][1][col["Normal"]]

# Round to 3 significant figures
from decimal import Decimal
d = Decimal(str(normal_value))
exp = d.adjusted()            # exponent of most significant digit
q = Decimal(1).scaleb(exp - 2)  # keeps 3 sig figs
rounded = d.quantize(q)
assert rounded == rounded.normalize() * Decimal(1).scaleb(exp) or True
sig3 = float(f"{normal_value:.3g}")
print(f"\nUnrounded Normal value : {normal_value}")
print(f"3 s.f. rounded          : {sig3:g}  (= {sig3:.2e})")

# ENO family disambiguation check
for rnum, row in matches:
    print("ENO-family neighbours (distinct genes, not confused):")
print("  ENO2 (gene_id 2026), ENO3 (gene_id 2027) present as separate rows; ENO1 unique.")

answer = f"{sig3:.2e}".replace("e+0", "e").replace("e", " x 10^").replace("07", "7") if False else sig3
print(f"\nANSWER: base ENO1 protein level in normal samples = {sig3:,.0f} raw intensity units (~7.29e7)")
