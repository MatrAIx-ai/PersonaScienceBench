"""Skewness of TCGA COAD RNA expression distribution (BixBench bix-42-q2)."""
import numpy as np
import pandas as pd
from scipy import stats

# ---- Load expression matrix (tab-separated text despite .xls extension) ----
g = pd.read_csv("data/COAD__geneExp.xls", sep="\t")
print("Expression matrix:", g.shape, "(genes x [GeneSymbol + samples])")
vals = g.iloc[:, 1:].apply(pd.to_numeric, errors="coerce").to_numpy(dtype=float)
print("NaN count after coercion:", int(np.isnan(vals).sum()))
print("Value range: min=%.4f max=%.2f" % (np.nanmin(vals), np.nanmax(vals)))
print("Fraction exact zeros: %.3f" % np.mean(vals == 0))

# ---- Primary: Fisher-Pearson standardized skewness g1 on pooled raw values ----
pooled = vals.ravel()
pooled = pooled[~np.isnan(pooled)]
g1_raw = stats.skew(pooled, bias=False)
print("\nPOOLED RAW VALUES: n=%d, mean=%.2f, median=%.2f" % (pooled.size, pooled.mean(), np.median(pooled)))
print("Percentiles 50/75/90/99/99.9:", np.round(np.percentile(pooled, [50, 75, 90, 99, 99.9]), 2))
print("Skewness g1 (raw): %.4f" % g1_raw)

# ---- Sensitivity: log2(x+1) ----
g1_log = stats.skew(np.log2(pooled + 1.0), bias=False)
print("Skewness g1 (log2(x+1)): %.4f" % g1_log)

# ---- Per-sample skewness ----
sk_samples = np.array([stats.skew(vals[:, j], bias=False) for j in range(vals.shape[1])])
print("\nPER-SAMPLE skewness: median=%.4f, IQR=[%.4f, %.4f], min=%.4f, max=%.4f"
      % (np.median(sk_samples), *np.percentile(sk_samples, [25, 75]), sk_samples.min(), sk_samples.max()))
print("  frac positive: %.3f" % np.mean(sk_samples > 0))

# ---- Per-gene skewness and gene-wise means ----
sk_genes = np.array([stats.skew(vals[i, :], bias=False) for i in range(vals.shape[0])])
gene_means = np.nanmean(vals, axis=1)
print("\nPER-GENE skewness: median=%.4f, frac positive=%.3f" % (np.median(sk_genes), np.mean(sk_genes > 0)))
print("Skewness of gene-wise MEANS: %.4f (log2(x+1) means: %.4f)"
      % (stats.skew(gene_means, bias=False), stats.skew(np.log2(gene_means + 1.0), bias=False)))

# ---- Histogram evidence (ASCII) ----
print("\nHistogram of raw pooled values (log-spaced bins):")
bins = np.logspace(0, np.log10(pooled.max() + 1), 12)
h, edges = np.histogram(pooled, bins=bins)
for c, e in zip(h, edges):
    print("  bin<%12.1f : %8d %s" % (e, c, "#" * min(60, int(60 * c / h.max()))))

print("\nHistogram of log2(x+1) pooled values:")
lb = np.linspace(0, np.log2(pooled.max() + 1), 13)
h2, _ = np.histogram(np.log2(pooled + 1.0), bins=lb)
for i, c in enumerate(h2):
    print("  log2 bin %4.1f-%4.1f : %8d %s" % (lb[i], lb[i+1], c, "#" * min(60, int(60 * c / h2.max()))))
