#!/usr/bin/env python3
"""
BixBench bix-43-q2: DESeq2-style differential expression (Python fallback)
CBD/cisplatin combination (Group 9, Cisplatin_IC50_CBD_IC50, n=3) vs DMSO (Group 3, n=3).
DEG filter: raw p<0.05, |log2FC|>0.5, baseMean>10 (mean of size-factor-normalized counts).
Enrichment (Reactome_2022 "p53-mediated cell cycle gene regulation" odds ratio) requires
gseapy/Enrichr access, which is unavailable in this runtime (no gseapy, no network, no
cached GMT); the DEG set and 2x2 scaffold are produced here, the OR itself left undefined
per researcher directive (no fabricated gene-set membership).
"""
import json
import numpy as np
import pandas as pd
from scipy import stats
import statsmodels.api as sm

DATA = "/workspace/data"
OUT = "/workspace/results"
COMBO_COLS = ["9_1", "9_2", "9_3"]   # Cisplatin_IC50_CBD_IC50
CONTROL_COLS = ["3_1", "3_2", "3_3"] # DMSO

diag = {}

# ---------------- load ----------------
counts = pd.read_csv(f"{DATA}/counts_raw_unfiltered.csv", index_col=0)
layout = pd.read_csv(f"{DATA}/sample_layout.csv")
layout["sample_col"] = layout["SampleID"].str.replace("-", "_", regex=False)
assert set(counts.columns) == set(layout["sample_col"]), "column/SampleID mismatch"
assert counts.dtypes.eq(np.int64).all() and (counts.to_numpy() >= 0).all()

y = counts[COMBO_COLS + CONTROL_COLS].to_numpy(dtype=np.float64)  # genes x 6, combo first
cond = np.array([1] * 3 + [0] * 3)
X = sm.add_constant(cond)
diag["n_genes_total"] = int(y.shape[0])

# ---------------- size factors (DESeq2 median-of-ratios) ----------------
gm = stats.gmean(y, axis=1)                       # geometric mean per gene
valid = gm > 0
ratios = np.divide(y[valid], gm[valid, None])
sf = np.median(ratios, axis=0)
sf = sf / sf.mean()                                # DESeq2 rescales to mean 1
diag["size_factors"] = dict(zip(COMBO_COLS + CONTROL_COLS, [round(float(s), 6) for s in sf]))
norm = y / sf                                      # normalized counts

baseMean = norm.mean(axis=1)
diag["n_genes_baseMean_gt10"] = int((baseMean > 10).sum())

# ---------------- dispersion: gene-wise MOM + parametric trend (DESeq2-like) ----------------
mu_c, v_c = norm[:, :3].mean(axis=1), norm[:, :3].var(axis=1, ddof=1)
mu_t, v_t = norm[:, 3:].mean(axis=1), norm[:, 3:].var(axis=1, ddof=1)
mu = (mu_c * 3 + mu_t * 3) / 6.0
v_pool = (v_c * 2 + v_t * 2) / 4.0
mom = (v_pool - mu) / np.maximum(mu, 1e-8) ** 2
mom = np.clip(mom, 1e-8, None)
mom[~np.isfinite(mom)] = 1e-8

sel = (baseMean > 10) & np.isfinite(mom) & (mu > 0)
xs = 1.0 / mu[sel]
A = np.vstack([xs, np.ones_like(xs)]).T
coef, *_ = np.linalg.lstsq(A, mom[sel], rcond=None)
a1, a0 = max(coef[0], 0.0), max(coef[1], 0.0)
trend = a1 / np.maximum(mu, 1e-8) + a0
trend = np.clip(trend, 1e-8, None)
disp = np.clip(np.where(mom > trend, mom, trend), 1e-8, None)
diag["dispersion_trend"] = {"a1_over_mu": a1, "a0": a0,
                            "median_final_disp_tested": float(np.median(disp[sel]))}

# ---------------- NB GLM Wald test per gene (baseMean>10 only) ----------------
tested_idx = np.where(baseMean > 10)[0]
rows = []
zero_group = 0
log_sf = np.log(sf)
for i in tested_idx:
    yi = y[i]
    if (yi[:3] == 0).all() or (yi[3:] == 0).all():
        zero_group += 1
        rows.append((i, np.nan, np.nan, np.nan, np.nan, np.nan))
        continue
    try:
        fam = sm.families.NegativeBinomial(alpha=disp[i], link=sm.families.links.Log())
        r = sm.GLM(yi, X, family=fam, offset=log_sf).fit(maxiter=100, tol=1e-10)
        beta, se = r.params[1], r.bse[1]
        z = beta / se if se > 0 else np.inf
        rows.append((i, baseMean[i], beta / np.log(2), se, z, min(2 * stats.norm.sf(abs(z)), 1.0)))
    except Exception:
        rows.append((i, baseMean[i], np.nan, np.nan, np.nan, np.nan))

res = pd.DataFrame(rows, columns=["row_idx", "baseMean", "lfc", "se", "z", "pvalue"])
res["ENSG"] = counts.index[res["row_idx"]].values
n_valid = int(res["pvalue"].notna().sum())

# BH adjustment over tested genes with valid p
pv = res["pvalue"].dropna().to_numpy()
order = np.argsort(pv)
padj = np.empty_like(pv)
m = len(pv)
padj[order] = np.minimum.accumulate((pv[order] * m / (np.arange(m) + 1))[::-1])[::-1]
res.loc[res["pvalue"].notna(), "padj"] = np.clip(padj, 0, 1)

res = res.drop(columns=["row_idx", "se", "z"]).sort_values("pvalue", na_position="last").reset_index(drop=True)

# ---------------- DEG selection ----------------
sig_raw = (res["pvalue"] < 0.05) & (res["lfc"].abs() > 0.5) & (res["baseMean"] > 10)
sig_adj = (res["padj"] < 0.05) & (res["lfc"].abs() > 0.5) & (res["baseMean"] > 10)
degs = res[sig_raw].copy()
diag["n_tested"] = n_valid
diag["n_skipped_allzero_group"] = zero_group
diag["n_failed_fit"] = int(res["pvalue"].isna().sum() - zero_group)
diag["n_degs_raw_p"] = int(sig_raw.sum())
diag["n_degs_up_raw_p"] = int((sig_raw & (res["lfc"] > 0)).sum())
diag["n_degs_down_raw_p"] = int((sig_raw & (res["lfc"] < 0)).sum())
diag["n_degs_bh_adj_p"] = int(sig_adj.sum())

# ---------------- symbol mapping + dedup ----------------
mp = pd.read_csv(f"{DATA}/ensg_to_gene_name.tsv", sep="\t").drop_duplicates("ENSG")
res_out = res.merge(mp, on="ENSG", how="left")
res_out.to_csv(f"{OUT}/de_results_all_tested_genes.csv", index=False)
degs_out = res_out[sig_raw.reindex(res.index).fillna(False).to_numpy()].copy()

bg_syms = res_out.loc[res_out["gene_name"].notna(), "gene_name"].drop_duplicates()
deg_syms = degs_out.loc[degs_out["gene_name"].notna(), "gene_name"].drop_duplicates()
diag["background_symbols_baseMean_gt10"] = int(bg_syms.shape[0])
diag["deg_symbols_raw_p"] = int(deg_syms.shape[0])
degs_out.to_csv(f"{OUT}/degs_p_lt0.05_lfc_gt0.5_baseMean_gt10.csv", index=False)
res_out[sig_adj.reindex(res.index).fillna(False).to_numpy()].to_csv(
    f"{OUT}/degs_bh_padj_lt0.05_lfc_gt0.5_baseMean_gt10.csv", index=False)

enrich = {
    "library": "Reactome_2022",
    "term": "p53-mediated cell cycle gene regulation",
    "status": "BLOCKED: gseapy not installed, PyPI/Enrichr network unreachable (DNS failures for "
              "pypi.org, rest.enrichrdb.com, maayanlab.cloud), and no cached GMT/gene-set file "
              "exists on this system. Per directive, gene-set membership was NOT fabricated; the "
              "odds ratio is left undefined pending an accessible gene-set source.",
    "odds_ratio": None,
    "contingency_table": None,
    "background_universe": {
        "definition": "all genes with baseMean>10 tested in the Group9-vs-Group3 comparison, "
                      "mapped to symbols via ensg_to_gene_name.tsv, deduplicated",
        "n_symbols": diag["background_symbols_baseMean_gt10"],
        "list_file": "background_symbols_baseMean_gt10.txt"},
    "deg_set": {"definition": "raw p<0.05, |log2FC|>0.5, baseMean>10, symbol-mapped, deduplicated",
                "n_symbols": diag["deg_symbols_raw_p"],
                "list_file": "deg_symbols_p_lt0.05_lfc_gt0.5_baseMean_gt10.txt"},
}
bg_syms.to_csv(f"{OUT}/background_symbols_baseMean_gt10.txt", index=False, header=False)
deg_syms.to_csv(f"{OUT}/deg_symbols_p_lt0.05_lfc_gt0.5_baseMean_gt10.txt", index=False, header=False)

diag["top20_degs"] = res_out.head(20)[["ENSG", "gene_name", "baseMean", "lfc", "pvalue", "padj"]].to_dict("records")
with open(f"{OUT}/diagnostics.json", "w") as f:
    json.dump({"diagnostics": diag, "enrichment": enrich}, f, indent=2, default=str)

print(json.dumps({k: v for k, v in diag.items() if k != "top20_degs"}, indent=2))
print("\nTop 20 DEGs by p:")
print(res_out.head(20).to_string(index=False))
print("\nENRICHMENT STATUS:", enrich["status"])

# ---------------- odds-ratio reconstruction scaffold (companion section) ----------------
# The Reactome_2022 "p53-mediated cell cycle gene regulation" gene set could not be obtained
# in this environment (no gseapy, no network, no cached GMT). Membership was NOT fabricated.
# The odds ratio is fully reconstructible once a source for the set exists:
#
#   Let S = genes in the Reactome_2022 set "p53-mediated cell cycle gene regulation" (symbols),
#       B = background_symbols_baseMean_gt10.txt  (15,543 symbols, baseMean>10, symbol-mapped),
#       D = deg_symbols_p_lt0.05_lfc_gt0.5_baseMean_gt10.txt (947 DEG symbols,
#           raw p<0.05, |log2FC|>0.5, baseMean>10, Group 9 vs Group 3).
#
#   a = |D ∩ S|      (in-set DEGs)          b = |B ∩ S| − a   (in-set background)
#   c = |D| − a      (out-of-set DEGs)      d = |B ∩ S̄| − c  (out-of-set background)
#
#   odds_ratio = (a * d) / (b * c)
#
# The OR is intentionally left undefined here.
OR_FORMULA_NOTE = (
    "odds_ratio = (a*d)/(b*c) with a=|DEGs ∩ set|, b=|background ∩ set|−a, "
    "c=|DEGs|−a, d=|background ∖ set|−c; set S pending an accessible Reactome_2022 source "
    "(lists: results/background_symbols_baseMean_gt10.txt [15,543 symbols], "
    "results/deg_symbols_p_lt0.05_lfc_gt0.5_baseMean_gt10.txt [947 symbols]). "
    "Dual DEG reporting: raw p<0.05 -> 992 genes / 947 symbols; BH padj<0.05 -> 366 genes. "
    "Caveat: DESeq2-style Python approximation (no DESeq2/R available); the odds ratio was "
    "NOT fabricated and remains undefined."
)
with open(f"{OUT}/odds_ratio_reconstruction.txt", "w") as f:
    f.write(OR_FORMULA_NOTE + "\n")
enrich["odds_ratio_formula_note"] = OR_FORMULA_NOTE
with open(f"{OUT}/diagnostics.json", "w") as f:
    json.dump({"diagnostics": diag, "enrichment": enrich}, f, indent=2, default=str)
print("\nODDS-RATIO RECONSTRUCTION NOTE WRITTEN:", OR_FORMULA_NOTE)
