"""
BixBench bix-43-q5 analysis
===========================
Question: primary cellular mechanism enriched (gseapy.enrichr, Reactome_2022)
in CBD/cisplatin combination treatment, using all DE genes
(p<0.05, |log2FC|>0.5, baseMean>10).

Environment note: this sandbox has no network access and no gseapy/pydeseq2/R.
pyDESeq2 therefore cannot be imported; we implement the DESeq2 algorithm
(median-of-ratios size factors, method-of-moments dispersion with a fitted
mean-dispersion trend, negative-binomial GLM with log2 link, Wald test, BH
adjustment) directly in NumPy/SciPy. The gseapy.enrichr call with
Reactome_2022 is attempted and its failure recorded.
"""
import numpy as np, pandas as pd, scipy.stats as st, json, sys, traceback

COUNTS = "/workspace/data/counts_raw_unfiltered.csv"
LAYOUT = "/workspace/data/sample_layout.csv"
MAPF   = "/workspace/data/ensg_to_gene_name.tsv"

# ---------------- load data ----------------
counts = pd.read_csv(COUNTS, index_col=0)
layout = pd.read_csv(LAYOUT)
# counts columns "1_1"; layout SampleID "1-1" -> normalize to "1_1"
layout["col"] = layout["SampleID"].str.replace("-", "_", regex=False)
assert set(layout["col"]) == set(counts.columns), "sample name mismatch"
groups = dict(zip(layout["col"], layout["Group"]))

def run_contrast(case_cols, ctrl_cols, label):
    sub = counts[case_cols + ctrl_cols].to_numpy(dtype=np.float64)
    # ---- median-of-ratios size factors (DESeq2) ----
    allpos = (sub > 0).all(axis=1)
    if allpos.sum() >= 1000:                       # standard DESeq2: genes with gm>0
        gm = np.exp(np.log(sub[allpos]).mean(axis=1))
        sf = np.median(sub[allpos] / gm[:, None], axis=0)
    else:                                          # poscounts fallback
        gm = np.exp(np.log(sub + 0.5).mean(axis=1))
        sf = np.median(sub / gm[:, None], axis=0)
    sf = sf / sf.mean()
    norm = sub / sf

    baseMean_all = norm.mean(axis=1)
    keep = baseMean_all > 10
    y = sub[keep]; m = baseMean_all[keep]
    G, n = y.shape
    print(f"[{label}] genes tested (baseMean>10): {G}", flush=True)

    # ---- dispersion: method of moments + log-binned median trend ----
    var_ = norm[keep].var(axis=1, ddof=1)
    alpha_mom = (var_ - mean_) / mean_**2 if False else (var_ - m) / m**2
    alpha_mom = np.maximum(alpha_mom, 1e-8)
    lb = np.log10(m + 1)
    bins = np.quantile(lb, np.linspace(0, 1, 31))
    bins[0] -= 1e-9; bins[-1] += 1e-9
    idx = np.digitize(lb, bins) - 1
    med = np.full(30, np.nan)
    for b in range(30):
        sel = idx == b
        if sel.sum() > 0:
            med[b] = np.median(alpha_mom[sel])
    okm = ~np.isnan(med)
    centers = 10 ** (0.5 * (bins[:-1][okm] + bins[1:][okm])) - 1
    medv = med[okm]
    alpha_trend = np.interp(m + 1, centers, medv, left=medv[0], right=medv[-1])
    alpha = np.clip(np.maximum(alpha_mom, alpha_trend), 1e-8, 1e3)

    # ---- NB GLM (log2 link), vectorized IRLS, Wald test ----
    X = np.ones((n, 2))
    X[:, 1] = [1.0] * len(case_cols) + [0.0] * len(ctrl_cols)  # case=1, ctrl=0
    yv = y + 0.5 * sf[None, :]
    eta = np.log2((yv / sf[None, :]).mean(axis=1))[:, None] * np.ones((1, n))
    ln2 = np.log(2.0)
    beta = np.zeros((G, 2))
    for it in range(60):
        mu = sf[None, :] * 2.0 ** eta
        W = mu / (1.0 + alpha[:, None] * mu)
        z = eta + (y - mu) / (mu * ln2)
        wx = W[:, :, None] * X[None, :, :]
        A = np.einsum("gni,nj->gij", wx, X) + 1e-6 * np.eye(2)
        b = np.einsum("gni,gn->gi", wx, z)
        det = A[:, 0, 0] * A[:, 1, 1] - A[:, 0, 1] * A[:, 1, 0]
        b1 = (A[:, 1, 1] * b[:, 0] - A[:, 0, 1] * b[:, 1]) / det
        b2 = (A[:, 0, 0] * b[:, 1] - A[:, 1, 0] * b[:, 0]) / det
        new = np.clip(np.stack([b1, b2], axis=1), -30, 30)
        step = np.abs(new - beta).max()
        beta = new
        eta = np.clip(beta[:, 0][:, None] + beta[:, 1][:, None] * X[:, 1][None, :], -30, 30)
        if step < 1e-8:
            break
    var_b1 = A[:, 1, 1] / det
    se = np.sqrt(np.maximum(var_b1, 1e-12))
    lfc = beta[:, 1]
    zstat = lfc / se
    pval = 2.0 * st.norm.sf(np.abs(zstat))

    # ---- Benjamini-Hochberg over tested genes ----
    order = np.argsort(pval)
    ranked = pval[order] * G / (np.arange(G) + 1)
    padj_sorted = np.minimum.accumulate(ranked[::-1])[::-1]
    padj = np.empty(G); padj[order] = np.minimum(padj_sorted, 1.0)

    res = pd.DataFrame({
        "ENSG": counts.index[keep], "baseMean": m,
        "log2FC": lfc, "lfcSE": se, "stat": zstat,
        "pvalue": pval, "padj": padj,
        "mean_case": norm[keep][:, :len(case_cols)].mean(axis=1),
        "mean_ctrl": norm[keep][:, len(case_cols):].mean(axis=1),
    })
    de = res[(res.pvalue < 0.05) & (res.log2FC.abs() > 0.5)]
    print(f"[{label}] DE genes (p<0.05, |lfc|>0.5, baseMean>10): {len(de)} "
          f"(up {int((de.log2FC>0).sum())}, down {int((de.log2FC<0).sum())})", flush=True)
    return res, de, sf

case = [c for c in counts.columns if c.startswith("9_")]
ctrlD = [c for c in counts.columns if c.startswith("3_")]
ctrlU = [c for c in counts.columns if c.startswith("1_")]

resD, deD, sfD = run_contrast(case, ctrlD, "Combo vs DMSO")
resU, deU, sfU = run_contrast(case, ctrlU, "Combo vs Untreated")

resD.to_csv("/workspace/results_combo_vs_DMSO.csv", index=False)
resU.to_csv("/workspace/results_combo_vs_Untreated.csv", index=False)
print("size factors (DMSO contrast):", np.round(sfD, 3).tolist())

# ---------------- ENSG -> symbol mapping ----------------
mp = pd.read_csv(MAPF, sep="\t").drop_duplicates("ENSG")
name_by_ensg = dict(zip(mp.ENSG, mp.gene_name))

def to_symbols(de, label):
    ens = de.ENSG.to_numpy()
    sym = [name_by_ensg.get(e) for e in ens]
    agg = (pd.DataFrame({"ENSG": ens, "gene_name": sym, "expr": de.baseMean.to_numpy()})
             .dropna(subset=["gene_name"])
             .sort_values("expr", ascending=False)
             .drop_duplicates("gene_name"))   # aggregate duplicate symbols: keep highest-expression ENSG
    genes = sorted(agg.gene_name.unique())
    with open(f"/workspace/de_genes_{label}.txt", "w") as f:
        f.write("\n".join(genes))
    print(f"[{label}] DE genes: {len(ens)}, unmapped ENSG: {sum(s is None for s in sym)}, "
          f"unique symbols: {len(genes)}", flush=True)
    return genes

genesD = to_symbols(deD, "combo_vs_DMSO")
genesU = to_symbols(deU, "combo_vs_Untreated")

# ---------------- gseapy.enrichr attempt (Reactome_2022) ----------------
enrichr_status = {}
try:
    import gseapy
    enr = gseapy.enrichr(gene_list=genesD, gene_sets="Reactome_2022",
                         organism="Ensembl", outdir="/workspace/enrichr_out")
    enr.res2d.to_csv("/workspace/enrichr_combo_vs_DMSO.csv", index=False)
    enrichr_status["ok"] = True
except Exception as e:
    enrichr_status["ok"] = False
    enrichr_status["error"] = f"{type(e).__name__}: {e}"
    traceback.print_exc()
with open("/workspace/enrichr_attempt.json", "w") as f:
    json.dump(enrichr_status, f, indent=2)

print("\n=== SUMMARY ===")
print("gseapy.enrichr Reactome_2022:", enrichr_status)
print("Top 10 genes by padj (Combo vs DMSO):")
print(resD.sort_values("padj").head(10).to_string(index=False))
