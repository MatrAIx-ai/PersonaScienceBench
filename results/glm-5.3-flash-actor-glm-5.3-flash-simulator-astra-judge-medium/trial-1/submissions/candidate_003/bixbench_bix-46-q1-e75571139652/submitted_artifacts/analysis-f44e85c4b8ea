#!/usr/bin/env python3
"""
BixBench bix-46-q1 analysis:
What is the log2 fold change value rounded to 2 decimal points for mexG expression
in ΔrhlI (strain #97) compared to wt (strain #1)?

Method:
1. Parse data/res_1vs97.rds (gzip-compressed R serialization v3; a DESeq2
   'DESeqResults' S4 object) with a self-contained minimal RDS reader
   (no R runtime available in this environment).
2. Confirm the object's comparison is 'Strain 97 vs 1' via its mcols descriptions.
3. Map mexG -> locus tag from data/Pseudomonas_aeruginosa_UCBPP-PA14.csv (unique
   exact gene-name match) and assert that locus tag exists in the result rownames.
4. Extract the log2FoldChange (MLE) value for that row; report full precision and
   the value rounded to 2 decimals (half-up and banker's).
"""
import csv, gzip, math, os, struct, sys
from decimal import Decimal, ROUND_HALF_UP

HERE = os.path.dirname(os.path.abspath(__file__))
def p(*a): return os.path.join(HERE, *a)

# ---------------------------------------------------------------- RDS parser --
NILSXP, SYMSXP, LISTSXP, CLOSXP, ENVSXP, PROMSXP, LANGSXP = 0,1,2,3,4,5,6
CHARSXP, LGLSXP, INTSXP, REALSXP, CPLXSXP, STRSXP = 9,10,13,14,15,16
VECSXP, EXPRSXP, RAWSXP, S4SXP = 19,20,24,25
REFSXP, NILVALUE_SXP, GLOBALENV_SXP, UNBOUNDVALUE_SXP, MISSINGARG_SXP = 255,254,253,252,251
PAIRLIST_TYPES = (LISTSXP, LANGSXP, PROMSXP)
VEC_TYPES = (LGLSXP, INTSXP, REALSXP, CPLXSXP, STRSXP, VECSXP, EXPRSXP)

class RDSReader:
    def __init__(self, buf):
        self.b = buf; self.i = 2  # skip 'X\n' magic
        self.ref_table = []
    def i32(self):
        v = struct.unpack_from('>i', self.b, self.i)[0]; self.i += 4; return v
    def f64(self):
        v = struct.unpack_from('>d', self.b, self.i)[0]; self.i += 8; return v
    def item(self):
        return self._item(self.i32())
    def _item(self, hdr):
        typ = hdr & 255
        has_attr = (hdr >> 9) & 1
        has_tag = (hdr >> 10) & 1
        if typ == REFSXP:
            idx = hdr >> 8
            if idx == 0: idx = self.i32()
            return self._resolve(idx)
        if typ in (NILSXP, NILVALUE_SXP): return None
        if typ == GLOBALENV_SXP: return '<GLOBALENV>'
        if typ == UNBOUNDVALUE_SXP: return '<UNBOUND>'
        if typ == MISSINGARG_SXP: return '<MISSING>'
        if typ in PAIRLIST_TYPES:
            nodes = []; first = True
            h, t, ha, ht = hdr, typ, has_attr, has_tag
            while True:
                if not first:
                    h = self.i32(); t = h & 255
                    if t in (NILSXP, NILVALUE_SXP): break
                    ha = (h >> 9) & 1; ht = (h >> 10) & 1
                    if t == REFSXP:
                        idx = h >> 8
                        if idx == 0: idx = self.i32()
                        nodes.append({'tag': None, 'car': self._resolve(idx), 'attrs': None})
                        continue
                tag = self.item() if ht else None
                nattrs = self.item() if ha else None
                car = self.item()
                nodes.append({'tag': tag, 'car': car, 'attrs': nattrs})
                first = False
            return nodes
        if typ == SYMSXP:
            name = self.item()
            ent = ('SYM', name)
            self.ref_table.append(ent)
            return ent
        if typ == S4SXP:
            attrs = self.item() if has_attr else None
            return {'value': '<S4>', 'attrs': attrs}
        if typ == CLOSXP:
            self.item(); self.item(); self.item()
            attrs = self.item() if has_attr else None
            return {'value': '<CLOSURE>', 'attrs': attrs}
        if typ == ENVSXP:
            self.ref_table.append('<ENV>')
            self.i32()
            self.item(); self.item(); self.item(); self.item()
            return {'value': '<ENV>', 'attrs': attrs if has_attr else None} if False else {'value': '<ENV>', 'attrs': None}
        if typ == CHARSXP:
            n = self.i32()
            if n < 0: return None
            s = self.b[self.i:self.i+n]; self.i += n
            return s.decode('utf-8', 'replace')
        if typ == RAWSXP:
            n = self.i32(); self.i += n
            return {'value': '<RAW>', 'attrs': None}
        if typ in VEC_TYPES:
            n = self.i32()
            if typ == REALSXP:   vals = [self.f64() for _ in range(n)]
            elif typ == CPLXSXP: vals = [complex(self.f64(), self.f64()) for _ in range(n)]
            elif typ in (INTSXP, LGLSXP): vals = [self.i32() for _ in range(n)]
            else: vals = [self.item() for _ in range(n)]
            attrs = self.item() if has_attr else None
            if attrs is not None: return {'value': vals, 'attrs': attrs}
            return vals
        raise ValueError(f'unhandled SEXP type {typ} at offset {self.i}')
    def _resolve(self, idx):
        if 1 <= idx <= len(self.ref_table): return self.ref_table[idx-1]
        return f'<UNRESOLVED {idx}>'

def load_rds(path):
    raw = gzip.open(path, 'rb').read()
    assert raw[:2] == b'X\n', 'expected R serialization v3 magic'
    r = RDSReader(raw)
    ver, wv, rv = r.i32(), r.i32(), r.i32()
    n_enc = r.i32(); r.i += n_enc           # native encoding string (e.g. 'UTF-8')
    obj = r.item()
    assert r.i == len(raw), f'incomplete parse: {r.i}/{len(raw)} bytes'
    return ver, wv, rv, obj, r

def unwrap(v): return v['value'] if isinstance(v, dict) else v
def slot(obj, name):
    for n in obj['attrs']:
        t = n['tag']
        nm = t[1] if isinstance(t, tuple) and t[0] == 'SYM' else (
             t[2][1] if isinstance(t, tuple) and t[2][0] == 'SYM' else None)
        if nm == name: return n['car']
    return None

# ---------------------------------------------------------------- analysis ----
def main():
    # --- 1. parse the DESeq2 results object -----------------------------------
    ver, wv, rv, obj, r = load_rds(p('data', 'res_1vs97.rds'))
    print(f'[parse] res_1vs97.rds: R serialization v{ver}, writer {hex(wv)}, '
          f'fully consumed {r.i}/{len(r.b)} bytes')
    cls = unwrap(slot(obj, 'class'))
    print(f'[schema] class: {cls}')
    assert cls == ['DESeqResults'], cls

    rownames = unwrap(slot(obj, 'rownames'))
    listdata = unwrap(slot(obj, 'listData'))
    colnames = unwrap(slot(slot(obj, 'listData'), 'names'))
    em = slot(obj, 'elementMetadata')
    emld = unwrap(slot(em, 'listData'))
    descriptions = unwrap(emld[1])
    types = unwrap(emld[0])
    print(f'[schema] nrows={len(rownames)}; columns={colnames}')
    print(f'[schema] mcols type={types}')
    print(f'[schema] mcols description={descriptions}')
    assert colnames == ['baseMean', 'log2FoldChange', 'lfcSE', 'stat', 'pvalue', 'padj']
    assert descriptions[1] == 'log2 fold change (MLE): Strain 97 vs 1'
    print("[check] comparison confirmed: 'Strain 97 vs 1' (ΔrhlI #97 vs wt #1)")

    # --- 2. map mexG -> locus tag via the annotation CSV ----------------------
    with open(p('data', 'Pseudomonas_aeruginosa_UCBPP-PA14.csv'), newline='') as f:
        rows = list(csv.DictReader(f))
    hits = [rw for rw in rows if rw['Gene Name'].strip() == 'mexG']
    print(f'[csv] exact gene-name matches for mexG: {len(hits)}')
    assert len(hits) == 1, 'expected a unique mexG annotation row'
    hit = hits[0]
    locus = hit['Locus Tag'].strip()
    print(f"[csv] mexG -> Locus Tag={locus}, PGD Gene ID={hit['PGD Gene ID']}, "
          f"CDS {hit['Chromosome/Plasmid Name']}:{hit['Start']}-{hit['End']} ({hit['Strand']})")

    # --- 3. locate the row and extract log2FoldChange -------------------------
    assert locus in rownames, f'{locus} missing from result rownames'
    idx = rownames.index(locus)
    print(f'[match] {locus} (mexG) found in rownames at index {idx}')

    lfc_col = unwrap(listdata[1])
    assert colnames[1] == 'log2FoldChange'
    val = lfc_col[idx]
    print(f'[extract] log2FoldChange (MLE) for {locus} (mexG), full precision: {val!r}')
    assert math.isfinite(val)

    half_up = Decimal(repr(val)).quantize(Decimal('0.01'), rounding=ROUND_HALF_UP)
    bankers = round(val, 2)
    print(f'[round] half-up 2dp: {half_up}')
    print(f'[round] banker (Python round) 2dp: {bankers}')
    if Decimal(repr(bankers)) != half_up:
        print('[round] NOTE: half-up and banker results differ')

    # sanity: same row across other columns
    baseMean = unwrap(listdata[0])[idx]
    padj = unwrap(listdata[5])[idx]
    print(f'[context] baseMean={baseMean!r}, padj={padj!r} for {locus}')

    # --- 4. confirm res_1vs98.rds is a different comparison (excluded) --------
    ver2, _, _, obj2, r2 = load_rds(p('data', 'res_1vs98.rds'))
    em2 = slot(obj2, 'elementMetadata')
    emld2 = unwrap(slot(em2, 'listData'))
    print(f'[excluded] res_1vs98.rds comparison: {unwrap(emld2[1])[1]!r} (not used here)')

    # --- 5. final answer -------------------------------------------------------
    print()
    print('ANSWER (log2FC of mexG / PA14_09540, ΔrhlI #97 vs wt #1, rounded to 2 dp):')
    print(f'  full precision : {val!r}')
    print(f'  rounded 2 dp   : {half_up}')

if __name__ == '__main__':
    main()
