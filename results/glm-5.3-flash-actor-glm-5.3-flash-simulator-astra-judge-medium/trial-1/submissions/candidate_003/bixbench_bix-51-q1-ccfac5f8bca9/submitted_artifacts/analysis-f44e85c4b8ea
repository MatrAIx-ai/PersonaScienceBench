"""
BixBench bix-51 Q1: Predicted probability of efficacy PR at age 65 (treatment group).

Data: data/data.xlsx, Sheet1. Real cohort = 80 patients (Sequence 1-80);
40 fully blank rows and one stray whitespace-only row are dropped.
Outcome: Efficacy == 'PR' -> 1, else (SD/PD) -> 0.
Treatment group: Groups == 1 (n=41). Predictor: Age (years).

Fits:
  1) Plain (unpenalized) statsmodels Logit, treatment group  -> separation check
  2) Firth-penalized logistic regression, treatment group    -> PRIMARY headline estimate
  3) Plain pooled Logit on all 80 patients                   -> sensitivity analysis
"""
import json
import numpy as np
import pandas as pd
import statsmodels.api as sm

RNG_SEED = 0
DATA = "data/data.xlsx"
TARGET_AGE = 65

# ---------- load & clean ----------
df = pd.read_excel(DATA, sheet_name="Sheet1")
df = df.dropna(how="all")                       # drop 40 blank rows
df = df[~(df["Age"].astype(str).str.strip() == "")]  # drop stray ' ' row
assert len(df) == 80, f"expected 80 real patients, got {len(df)}"

df["Age_num"] = pd.to_numeric(df["Age"], errors="coerce")
assert df["Age_num"].notna().all(), "non-numeric Age among real patients"
df["PR"] = (df["Efficacy"].str.strip() == "PR").astype(int)

treat = df[df["Groups"] == 1].copy()
n_t = len(treat)

results = {"n_total": int(len(df)), "n_treatment": int(n_t),
           "treat_PR_count": int(treat["PR"].sum()),
           "treat_age_min": float(treat["Age_num"].min()),
           "treat_age_max": float(treat["Age_num"].max()),
           "treat_age_mean": float(treat["Age_num"].mean()),
           "treat_age_median": float(treat["Age_num"].median())}

# ---------- 1) plain statsmodels Logit, treatment group ----------
X_t = sm.add_constant(treat["Age_num"].astype(float))
y_t = treat["PR"].astype(float)
plain_status = "converged"
try:
    fit_plain = sm.Logit(y_t, X_t).fit(disp=0, maxiter=100)
    plain_conv = bool(fit_plain.mle_retvals.get("converged", False))
    b_plain = fit_plain.params.to_dict()
    p_plain = float(fit_plain.predict(pd.DataFrame({"const": [1.0], "Age_num": [TARGET_AGE]}))[0])
except Exception as e:  # PerfectSeparation etc.
    plain_status = f"FAILED: {type(e).__name__}: {e}"
    b_plain, p_plain = None, None
results["plain_logit_treatment"] = {"status": plain_status, "mle_converged": plain_conv,
                                    "coefficients": b_plain, "pred_at_65": p_plain}

# ---------- 2) Firth-penalized logistic regression (treatment group) ----------
def firth_logit(X, y, tol=1e-10, max_iter=500):
    X = np.asarray(X, float); y = np.asarray(y, float)
    n, p = X.shape
    beta = np.zeros(p)
    for _ in range(max_iter):
        eta = X @ beta
        mu = 1.0 / (1.0 + np.exp(-eta))
        W = mu * (1 - mu)
        XtWX = X.T @ (X * W[:, None])
        try:
            XtWX_inv = np.linalg.pinv(XtWX)
        except np.linalg.LinAlgError:
            XtWX_inv = np.linalg.pinv(XtWX + np.eye(p) * 1e-12)
        # hat-matrix diagonal (leverage) h_i
        XW = X * np.sqrt(W)[:, None]
        Hdiag = np.sum((XW @ XtWX_inv) * XW, axis=1)
        # Firth-modified score: X'(y-mu) + sum_i h_i*(1/2 - mu_i)*x_i
        U = X.T @ (y - mu) + X.T @ (Hdiag * (0.5 - mu))
        step = XtWX_inv @ U
        beta = beta + step
        if np.max(np.abs(step)) < tol:
            break
    return beta

Xf = X_t.values
bf = firth_logit(Xf, y_t.values)
eta65 = bf[0] + bf[1] * TARGET_AGE
p_firth = 1.0 / (1.0 + np.exp(-eta65))
results["firth_treatment"] = {"intercept": float(bf[0]), "age_coef": float(bf[1]),
                              "pred_at_65": float(p_firth)}

# ---------- 3) pooled two-group sensitivity fit ----------
X_p = sm.add_constant(df["Age_num"].astype(float))
fit_pool = sm.Logit(df["PR"].astype(float), X_p).fit(disp=0, maxiter=100)
p_pool = float(fit_pool.predict(pd.DataFrame({"const": [1.0], "Age_num": [TARGET_AGE]}))[0])
results["pooled_logit_sensitivity"] = {
    "coefficients": {k: float(v) for k, v in fit_pool.params.items()},
    "pred_at_65": p_pool, "converged": bool(fit_pool.mle_retvals.get("converged", True))}

with open("analysis/results.json", "w") as f:
    json.dump(results, f, indent=2)
print(json.dumps(results, indent=2))
