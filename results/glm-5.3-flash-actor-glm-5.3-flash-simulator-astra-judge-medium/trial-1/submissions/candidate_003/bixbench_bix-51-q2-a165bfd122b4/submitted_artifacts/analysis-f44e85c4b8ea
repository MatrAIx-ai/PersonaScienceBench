# -*- coding: utf-8 -*-
"""
BixBench bix-51-q2: AIC of logistic regression response ~ BMI.

Question: What is the Akaike Information Criterion (AIC) for the logistic
regression model that uses BMI as the sole predictor of treatment response
(efficacy PR)?

Data notes (fixed at inspection/approval):
- data/data.xlsx, Sheet1: 121 rows x 12 columns, but only rows with
  Sequence number 1-80 are populated. Rows 81-121 are empty artifacts of the
  Excel sheet range and are DROPPED (not treated as missing observations).
- Efficacy is categorical (RECIST-style): PR=41, PD=22, SD=17 among n=80.
  Binary treatment response is defined as 1 = PR, 0 = PD/SD.
  INACTIVE VARIANT (not used): alternatively one could exclude SD and model
  PR vs PD; this is not the primary convention and was rejected by the
  researcher.
- BMI is float64 with no missing values among the 80 valid rows; no outliers
  (range 18.0-25.9, mean 21.96, SD 2.38). Full sample n=80 is used; Groups is
  NOT a model term (question requires BMI as the sole predictor).
- The Age column contains 81 non-null values; the one extraneous value outside
  rows 1-80 is ignored (Age is not part of the model anyway).
- AIC is computed from the maximum-likelihood fit:
  AIC = -2*logLik + 2k with k = 2 (intercept + BMI).
  Cross-validation: statsmodels .aic vs manual -2*llf + 4.
"""
import numpy as np
import pandas as pd
import statsmodels.api as sm

SRC = 'data/data.xlsx'
df = pd.read_excel(SRC, sheet_name='Sheet1')

# Keep only populated data rows (Sequence number 1-80); drop empty sheet rows
sub = df[df['Efficacy'].notna() & df['Sequence number'].notna()].copy()
n = len(sub)
assert n == 80, f"expected 80 valid rows, got {n}"
assert sub['BMI'].notna().all(), "unexpected missing BMI"

# Response: 1 = PR, 0 = PD/SD
y = (sub['Efficacy'].str.strip().eq('PR')).astype(int).to_numpy()
X = sm.add_constant(sub['BMI'].to_numpy(float), has_constant='add')

model = sm.GLM(y, X, family=sm.families.Binomial())
res = model.fit()

llf = res.llf
k = res.params.shape[0]          # 2: intercept + BMI
aic_sm = res.aic
aic_manual = -2.0 * llf + 2.0 * k

print(f"n                      = {n}")
print(f"response coding        = 1:PR ({y.sum()}), 0:PD+SD ({(1-y).sum()})")
print(f"intercept              = {res.params[0]:.6f} (SE {res.bse[0]:.6f}, p={res.pvalues[0]:.4g})")
print(f"BMI coefficient        = {res.params[1]:.6f} (SE {res.bse[1]:.6f}, p={res.pvalues[1]:.4g})")
print(f"log-likelihood (ML)    = {llf:.6f}")
print(f"k (params)             = {k}")
print(f"AIC (statsmodels .aic) = {aic_sm:.6f}")
print(f"AIC (manual -2LL+2k)   = {aic_manual:.6f}")
assert abs(aic_sm - aic_manual) < 1e-8, "AIC mismatch between methods"
print(f"\nFINAL ANSWER: AIC = {aic_sm:.6f}  (~{aic_sm:.2f})")
