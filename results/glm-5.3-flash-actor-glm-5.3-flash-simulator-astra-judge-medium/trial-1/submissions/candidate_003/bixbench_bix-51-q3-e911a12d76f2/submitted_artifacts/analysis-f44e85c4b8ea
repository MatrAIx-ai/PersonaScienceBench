"""BixBench bix-51-q3: Logistic regression PR ~ BMI + Age + Gender.

Combined logistic regression: BMI, age, gender -> p-value for age predicting
partial response (PR).
"""
import pandas as pd
import numpy as np
import statsmodels.api as sm
from statsmodels.genmod.families import Binomial
from statsmodels.genmod.generalized_linear_model import GLM

# ---- Load & clean ----
df = pd.read_excel('data/data.xlsx', sheet_name='Sheet1')
n_raw = len(df)
df = df.dropna(how='all')                      # drop 41 empty trailing rows
df = df[pd.to_numeric(df['Sequence number'], errors='coerce').notna()]
df['Age'] = pd.to_numeric(df['Age'], errors='coerce')
n = len(df)

# ---- Construct outcome and predictors ----
df['PR'] = (df['Efficacy'] == 'PR').astype(int)   # 1 = PR, 0 = SD/PD
X = df[['BMI', 'Age', 'Gender']].copy()
X['GenderFemale'] = (df['Gender'] == 'Female').astype(int)  # reference: Male

missing = X.isna().sum() + df['PR'].isna().sum()
assert missing.sum() == 0, f"Unexpected missingness: {missing}"
assert n == 80

print(f"Rows loaded: {n_raw}; analysis n = {n}")
print("PR counts:", df['PR'].value_counts().to_dict())

# ---- Fit combined logistic regression ----
Xc = sm.add_constant(X[['BMI', 'Age', 'GenderFemale']])
model = GLM(df['PR'].values, Xc, family=Binomial())
res = model.fit()
print("Converged:", res.converged)

null = GLM(df['PR'].values, np.ones((n, 1)), family=Binomial()).fit()
llf_null, llf = null.llf, res.llf
print(f"Null LL: {llf_null:.4f}; Model LL: {llf:.4f}; McFadden pseudo-R2: {1 - llf/llf_null:.4f}")

print("\n=== Full model summary: PR ~ BMI + Age + GenderFemale (ref = Male) ===")
print(res.summary().as_text())

# ---- Coefficient table with OR and 95% CI ----
ci = res.conf_int()
tab = pd.DataFrame({
    'coef': res.params, 'SE': res.bse, 'z': res.tvalues, 'p_value': res.pvalues,
    'OR': np.exp(res.params),
    'CI2.5_OR': np.exp(ci.iloc[:, 0]), 'CI97.5_OR': np.exp(ci.iloc[:, 1]),
}, index=res.params.index)
print("\n=== Coefficient table ===")
print(tab.round(6).to_string())

age_p = res.pvalues['Age']
print(f"\n>>> ANSWER: p-value for AGE in combined model = {age_p:.4f}")
print(f">>> Age coef = {res.params['Age']:.6f}, SE = {res.bse['Age']:.6f}, "
      f"OR = {np.exp(res.params['Age']):.4f}, "
      f"95% CI [{np.exp(ci.loc['Age', 0]):.4f}, {np.exp(ci.loc['Age', 1]):.4f}]")

# sanity: identical fit via Logit class (ML logistic regression)
res2 = sm.Logit(df['PR'].values, Xc).fit(disp=0)
assert np.isclose(res2.pvalues['Age'], age_p), "GLM/Logit p-value mismatch!"
print("Cross-check with sm.Logit: same age p-value =", f"{res2.pvalues['Age']:.6g}")

# Descriptives for context
print("\n--- BMI by PR ---")
print(df.groupby('PR')['BMI'].agg(['mean', 'min', 'max']).round(3).to_string())
print("--- Age by PR ---")
print(df.groupby('PR')['Age'].agg(['mean', 'min', 'max']).round(3).to_string())
print("--- Gender x PR ---")
print(pd.crosstab(df['Gender'], df['PR']).to_string())

# simple bivariate p-values for context
for v in ['BMI', 'Age', 'GenderFemale']:
    m = GLM(df['PR'].values, sm.add_constant(X[[v]]), family=Binomial()).fit()
    print(f"Bivariate {v}: coef={m.params[v]:.4f}, p={m.pvalues[v]:.4f}")
