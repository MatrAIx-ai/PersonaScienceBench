"""BixBench bix-51-q4: logistic regression of remission on age, BMI, gender."""
import pandas as pd
import statsmodels.formula.api as smf

# 1. Load and clean
df = pd.read_excel('data/data.xlsx', sheet_name='Sheet1')
df = df[df['Sequence number'].notna()].copy()      # drop rows 80-120 artifacts
df['Age'] = pd.to_numeric(df['Age'], errors='coerce')
df['BMI'] = pd.to_numeric(df['BMI'], errors='coerce')
print(f"Real patients: n={len(df)}")

# 2. Outcome: remission = PR (1) vs SD/PD (0)
df['remission'] = (df['Efficacy'] == 'PR').astype(int)
print("Remission counts:", df['remission'].value_counts().to_dict())

# 3. Complete-case on model variables
model_df = df[['remission', 'Age', 'BMI', 'Gender']].dropna()
print(f"Complete cases: n={len(model_df)}")

# 4. Logistic regression: remission ~ Age + BMI + C(Gender), Female reference
model = smf.logit('remission ~ Age + BMI + C(Gender, Treatment(reference="Female"))',
                  data=model_df)
fit = model.fit(disp=0)
print("\nConverged:", fit.mle_retvals['converged'], "| iterations:", fit.mle_retvals['iterations'])
print(f"Pseudo R-squared: {fit.prsquared:.4f} | LLR p-value: {fit.llr_pvalue:.4f}")
print("\nCoefficient table:")
print(fit.summary2().tables[1].to_string())

# Odds ratios with 95% CI
ci = fit.conf_int()
ci.columns = ['2.5%', '97.5%']
or_tab = pd.DataFrame({'coef': fit.params, 'OR': fit.params.apply(lambda b: np.exp(b)) if False else __import__('numpy').exp(fit.params)})
or_tab['2.5% OR'] = __import__('numpy').exp(ci['2.5%'])
or_tab['97.5% OR'] = __import__('numpy').exp(ci['97.5%'])
print("\nOdds ratios:")
print(or_tab.to_string())

# 5. Sensitivity: remission = PR + SD (disease control)
df['remission_dc'] = df['Efficacy'].isin(['PR', 'SD']).astype(int)
alt = smf.logit('remission_dc ~ Age + BMI + C(Gender, Treatment(reference="Female"))',
                data=df[['remission_dc', 'Age', 'BMI', 'Gender']].dropna()).fit(disp=0)
print(f"\nSENSITIVITY (remission = PR+SD): Age coef = {alt.params['Age']:.6f}, "
      f"SE = {alt.bse['Age']:.6f}, p = {alt.pvalues['Age']:.4f}, "
      f"OR = {__import__('numpy').exp(alt.params['Age']):.4f}, converged = {alt.mle_retvals['converged']}")
