"""
BixBench bix-51-q5: Logistic regression p-value for BMI vs treatment response.

Data: data/data.xlsx (Sheet1). Cleaning: 40 fully-empty rows + 1 separator row
(index 120, Age=' ') dropped -> 80 patients.
Primary model (per researcher approval):
  response = 1 if Efficacy=='PR' else 0 (SD/PD)  [ORR convention]
  Logit(response ~ BMI), Wald z-test p-value for BMI coefficient.
Robustness: LR test for BMI coefficient.
Sensitivity: alternative binarizations (PR+SD vs PD; PR vs PD dropping SD).
"""
import numpy as np
import pandas as pd
import statsmodels.api as sm
from scipy import stats

RNG = "primary: PR vs SD/PD; Wald z-test"

df_raw = pd.read_excel("data/data.xlsx", sheet_name="Sheet1")
n_raw = len(df_raw)
df = df_raw.dropna(how="all").copy()          # drop 40 empty rows
df = df[df["Age"].astype(str).str.strip() != ""]  # drop separator row (Age=' ')
n_clean = len(df)
assert n_clean == 80, f"expected 80 patients, got {n_clean}"
assert df["BMI"].notna().all() and df["Efficacy"].notna().all()

def fit_logit(y, x):
    x = x.loc[y.index] if hasattr(y, "index") else x
    X = sm.add_constant(x)
    m = sm.Logit(np.asarray(y, float), X).fit(disp=0)
    b = m.params["BMI"]; se = m.bse["BMI"]; p_wald = m.pvalues["BMI"]
    orr_, lo, hi = np.exp(b), np.exp(b - 1.96 * se), np.exp(b + 1.96 * se)
    # LR test: drop BMI, compare deviances
    m0 = sm.Logit(np.asarray(y, float), np.ones((len(y), 1))).fit(disp=0)
    lr = 2 * (m.llf - m0.llf); p_lr = stats.chi2.sf(lr, 1)
    return dict(beta=b, se=se, OR=orr_, CI=(lo, hi), p_wald=p_wald, p_lr=p_lr, n=len(y))

def report(name, y):
    r = fit_logit(y, df["BMI"])
    print(f"\n[{name}]  n={r['n']}, responders(1)={int(np.sum(y))}, non-responders(0)={int(len(y)-np.sum(y))}")
    print(f"  beta(BMI)={r['beta']:.6f}  SE={r['se']:.6f}  OR={r['OR']:.4f}  "
          f"95% CI=({r['CI'][0]:.4f}, {r['CI'][1]:.4f})")
    print(f"  Wald z p-value = {r['p_wald']:.6g}")
    print(f"  LR-test p-value = {r['p_lr']:.6g}")
    return r

eff = df["Efficacy"].str.strip()

print(f"rows raw={n_raw}, cleaned={n_clean}")
print("Efficacy counts:", eff.value_counts().to_dict())

primary = report("PRIMARY  response = PR=1 vs SD/PD=0 (ORR)", (eff == "PR").astype(int))
sens1 = report("SENS-1  response = (PR or SD)=1 vs PD=0", eff.isin(["PR", "SD"]).astype(int))
sens2 = report("SENS-2  response = PR=1 vs PD=0 (SD dropped)", (eff == "PR").astype(int)[eff.isin(["PR", "PD"])])

print("\n--- PRIMARY ANSWER ---")
print(f"Logit(response ~ BMI), Wald p-value for BMI = {primary['p_wald']:.6g}")
print(f"(beta={primary['beta']:.4f}, SE={primary['se']:.4f}, OR={primary['OR']:.4f}, "
      f"95% CI {primary['CI'][0]:.4f}-{primary['CI'][1]:.4f}; LR p={primary['p_lr']:.6g})")

out = {"primary": primary, "sens_PRSD_vs_PD": sens1, "sens_PR_vs_PD": sens2}
pd.Series({k: {kk: (vv if not isinstance(vv, tuple) else list(vv)) for kk, vv in v.items()}
           for k, v in out.items()}).to_json("results.json")
print("\nsaved results.json")
