"""
BixBench bix-51-q8: Simple logistic regression of treatment response (Efficacy) on Age.
Plan (approved):
  - Load data/data.xlsx Sheet1, keep the 80 patient rows (drop all-empty rows and the
    whitespace ' ' Age artifact row), coerce Age to numeric.
  - Binary outcome: PR = 1 (response), SD/PD = 0 (non-response)  [ORR-style coding].
  - Univariate logistic regression: Efficacy_binary ~ Age (statsmodels sm.Logit).
    Age coefficient = change in log-odds of response per +1 year of age.
  - Separation diagnostic: Age + Groups model has no finite MLE (Efficacy is perfectly
    determined by Groups), documenting why the univariate model is the "simple" model.
"""
import numpy as np
import pandas as pd
import statsmodels.api as sm

df = pd.read_excel("data/data.xlsx", sheet_name="Sheet1")

# --- keep only patient rows; drop fully empty rows and the whitespace Age artifact ---
d = df.dropna(how="all")
d = d[pd.to_numeric(d["Age"], errors="coerce").notna()].copy()
d["Age"] = pd.to_numeric(d["Age"], errors="coerce")
print(f"Analytic N = {len(d)} (dropped {len(df) - len(d)} empty/artifact rows)")
assert len(d) == 80, "expected 80 patients"
assert d[["Groups", "Efficacy", "Age"]].isna().sum().sum() == 0, "no missing in key vars"

# --- outcome coding: PR=1, SD/PD=0 ---
d["response"] = (d["Efficacy"] == "PR").astype(int)
print("Outcome counts:", d["response"].value_counts().to_dict(),
      "| Groups x response:", pd.crosstab(d["Groups"], d["response"]).to_dict())
assert d.groupby("Groups")["response"].nunique().eq(1).all(), \
    "check: Efficacy perfectly determined by Groups"

# --- univariate logistic regression: response ~ Age ---
X = sm.add_constant(d["Age"].astype(float))
y = d["response"]
fit = sm.Logit(y, X).fit(disp=0)
b_age = fit.params["Age"]
or_age = np.exp(b_age)
ci = np.exp(fit.conf_int().loc["Age"])
print("\n=== Univariate logistic regression: response(PR=1) ~ Age (years) ===")
print(fit.summary())
print(f"Age coefficient (log-odds per +1 year): {b_age:.6f}")
print(f"SE: {fit.bse['Age']:.6f} | z: {fit.tvalues['Age']:.4f} | p: {fit.pvalues['Age']:.6g}")
print(f"OR = exp(beta) = {or_age:.6f} | 95% CI OR: [{ci[0]:.4f}, {ci[1]:.4f}]")
print(f"LLR p-value: {fit.llr_pvalue:.6g} | pseudo R2: {fit.prsquared:.4f}")

# --- separation diagnostic: Age + Groups (no finite MLE expected) ---
print("\n=== Separation diagnostic: response ~ Age + Groups ===")
X2 = sm.add_constant(d[["Age"]].assign(Groups=d["Groups"]).astype(float))
fit2 = sm.Logit(y, X2).fit(disp=0, maxiter=200)
print(fit2.summary())
print("Perfectly separated coefficient (Groups):",
      f"{fit2.params['Groups']:.3e} -> |coef| ~ 1e9 indicates no finite MLE (complete separation).")
