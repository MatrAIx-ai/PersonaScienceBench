"""
BixBench bix-52-q7: How many sites are removed when filtering sites that do
not show >90% or <10% methylation in Zebra Finch?

Data: ZF_AgeRelated_CpG_noMT_Final.csv (one row = one CpG site x one sample).
Removal rule per question's strict inequalities: a measurement/site is REMOVED
if NOT (m > 90 OR m < 10)  <=>  10 <= m <= 90.
Units: percent (verified m == 100*CountMethylated/Coverage).

Variants:
  A: unique Pos removed if ANY  row for that Pos is in [10, 90]
  B: unique Pos removed if ALL  rows for that Pos are in [10, 90]
  C: row-level count ("site x sample" measurements removed)
  D: unique Pos removed if MEAN MethylationPercentage over its rows in [10, 90]
"""
import pandas as pd

df = pd.read_csv("data/ZF_AgeRelated_CpG_noMT_Final.csv")
n_rows, n_sites = len(df), df["Pos"].nunique()
mid = (df.MethylationPercentage >= 10) & (df.MethylationPercentage <= 90)

# --- boundary sanity: exact 10.0 / 90.0 ---
exact10 = (df.MethylationPercentage == 10.0).sum()
exact90 = (df.MethylationPercentage == 90.0).sum()

# --- Variant C: row-level ---
removed_C = int(mid.sum())
kept_C = int((~mid).sum())

# --- Variant A: any row in [10,90] -> remove site ---
removed_A = int(df.loc[mid, "Pos"].nunique())
kept_A = n_sites - removed_A

# --- Variant B: all rows in [10,90] -> remove site ---
per_site_mid = df.groupby("Pos")["MethylationPercentage"].agg(["min", "max", "mean", "size"])
removed_B = int(((per_site_mid["max"] <= 90) & (per_site_mid["min"] >= 10)).sum())
kept_B = n_sites - removed_B

# --- Variant D: mean methylation per site ---
removed_D = int(((per_site_mid["mean"] >= 10) & (per_site_mid["mean"] <= 90)).sum())
kept_D = n_sites - removed_D

print(f"ZF rows (site x sample measurements): {n_rows}")
print(f"ZF unique sites (Pos):                {n_sites}")
print(f"Rows exactly at m == 10.0: {exact10}; exactly at m == 90.0: {exact90}")
print(f"Rows with methylation exactly 0 or 100: {(df.MethylationPercentage==0).sum()} / {(df.MethylationPercentage==100).sum()}")
print()
print(f"Variant C (row-level, 'site x sample' measurements removed): {removed_C} removed, {kept_C} kept")
print(f"Variant A (unique Pos; ANY sample in [10,90] -> remove):     {removed_A} removed, {kept_A} kept")
print(f"Variant B (unique Pos; ALL samples in [10,90] -> remove):    {removed_B} removed, {kept_B} kept")
print(f"Variant D (unique Pos; MEAN methylation in [10,90] -> remove): {removed_D} removed, {kept_D} kept")
print()
print("Per-site mean distribution summary:")
print(per_site_mid["mean"].describe().to_string())

import json
json.dump({"rows": n_rows, "unique_sites": n_sites,
           "removed": {"A_any": removed_A, "B_all": removed_B,
                       "C_rowlevel": removed_C, "D_mean": removed_D},
           "boundary_rows_exact_10": int(exact10), "boundary_rows_exact_90": int(exact90)},
          open("out/zf_filter_counts.json", "w"), indent=2)
print("\nSaved out/zf_filter_counts.json")
