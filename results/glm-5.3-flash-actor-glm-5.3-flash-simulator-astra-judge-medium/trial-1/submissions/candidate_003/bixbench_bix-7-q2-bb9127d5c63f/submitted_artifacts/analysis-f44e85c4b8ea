"""
BixBench bix-7-q2: Average number of CHIP variants per sample after filtering
out intronic, intergenic, and UTR variants.

Data: 86 per-sample variant workbooks in data/CHIP_DP10_GQ20_PASS/, plus two
metadata workbooks (CHIP gene panel; trio status).

Approved definitions (researcher-approved):
- A "CHIP variant" for a sample = a row with Zygosity in {Heterozygous,
  Homozygous Variant}. 'Reference' rows (homozygous reference) and
  Zygosity=None no-call rows are excluded. The Zygosity label is trusted
  even for the single Reference row with a nonzero VAF.
- Filtering removes variants whose 'Sequence Ontology (Combined)' term is
  intronic, intergenic, or UTR: intron_variant, 3_prime_UTR_variant,
  5_prime_UTR_variant, 5_prime_UTR_premature_start_codon_gain_variant.
  (No intergenic_variant exists in the data; splice_region_variant and
  upstream_gene_variant are KEPT.)
- Average over all 86 samples (each workbook = one sample).
- Sensitivity alternatives reported alongside the primary figure.
"""
import openpyxl, glob, re, json, collections

DATA_GLOB = 'data/CHIP_DP10_GQ20_PASS/*.xlsx'

# Column indices (0-based) in row 2 of each workbook
COL = {'Chr:Pos': 0, 'Zygosity': 4, 'Variant Allele Freq': 9, 'Gene Names': 12,
       'Sequence Ontology (Combined)': 13, 'Filter': 19, 'In_CHIP': 29}

VARIANT_ZYGOSITY = {'Heterozygous', 'Homozygous Variant'}

# Approved exclusion list: intronic + intergenic + UTR variants
EXCLUDE_SO = {
    'intron_variant',                                 # intronic
    # 'intergenic_variant': absent from the dataset (verified by census)
    '3_prime_UTR_variant',                            # UTR
    '5_prime_UTR_variant',                            # UTR
    '5_prime_UTR_premature_start_codon_gain_variant', # UTR (researcher decision 1)
}
# Alternative exclusion sets for sensitivity reporting only
EXCLUDE_SO_LOOSE_UTR = EXCLUDE_SO - {'5_prime_UTR_premature_start_codon_gain_variant'}
EXCLUDE_SO_PLUS_SPLICE = EXCLUDE_SO | {'splice_region_variant'}
EXCLUDE_SO_PLUS_SPLICE_UP = EXCLUDE_SO_PLUS_SPLICE | {'upstream_gene_variant'}

def load_rows(path):
    """Load data rows (row 3+) from a per-sample workbook.

    Note: openpyxl read_only mode misreports sheet dimensions on these files
    (ws.iter_rows yields only ~1 row for 85/86 files), so workbooks are loaded
    in normal mode and dimensions are validated.
    """
    wb = openpyxl.load_workbook(path)  # NOT read_only (see note above)
    ws = wb[wb.sheetnames[0]]
    rows = list(ws.iter_rows(values_only=True))
    hdr2 = rows[1]
    for name, idx in COL.items():
        assert hdr2[idx] == name, f'{path}: column {idx} = {hdr2[idx]!r} != {name!r}'
    wb.close()
    return rows[2:]

def sample_id(path):
    fid = re.search(r'CHIP_([^/]+?)\.xlsx$', path).group(1)
    m = re.match(r'^(\d+)-', fid)
    return m.group(1) if m else fid  # '179-P1' -> '179'; 'SRR...' verbatim

def count_variants(path, exclude_so):
    kept = 0
    for r in load_rows(path):
        zyg = r[COL['Zygosity']]
        so = r[COL['Sequence Ontology (Combined)']]
        if zyg in VARIANT_ZYGOSITY and so not in exclude_so:
            kept += 1
    return kept

def main():
    files = sorted(glob.glob(DATA_GLOB))
    assert len(files) == 86, len(files)
    results = {}
    for f in files:
        sid = sample_id(f)
        assert sid not in results, f'duplicate sample {sid}'
        results[sid] = {
            'primary':        count_variants(f, EXCLUDE_SO),
            'alt_loose_utr':  count_variants(f, EXCLUDE_SO_LOOSE_UTR),
            'alt_plus_splice':count_variants(f, EXCLUDE_SO_PLUS_SPLICE),
            'alt_splice_up':  count_variants(f, EXCLUDE_SO_PLUS_SPLICE_UP),
        }

    def summarise(key):
        vals = {s: d[key] for s, d in results.items()}
        v = list(vals.values())
        return {'n_samples': len(v), 'mean': sum(v)/len(v),
                'min': min(v), 'max': max(v),
                'median': sorted(v)[len(v)//2]}

    summary = {k: summarise(k) for k in
               ['primary', 'alt_loose_utr', 'alt_plus_splice', 'alt_splice_up']}

    # --- auxiliary diagnostics for the report ---
    zyg_counter = collections.Counter(); so_counter = collections.Counter()
    so_counter_var = collections.Counter()
    for f in files:
        for r in load_rows(f):
            zyg_counter[r[COL['Zygosity']]] += 1
            so = r[COL['Sequence Ontology (Combined)']]
            so_counter[so] += 1
            if r[COL['Zygosity']] in VARIANT_ZYGOSITY:
                so_counter_var[so] += 1

    out = {'per_sample': results, 'summary': summary,
           'zygosity_census': dict(zyg_counter),
           'so_census_all_rows': dict(so_counter),
           'so_census_variant_rows': dict(so_counter_var),
           'excluded_so_primary': sorted(EXCLUDE_SO)}
    with open('analysis/results.json', 'w') as fh:
        json.dump(out, fh, indent=2)

    print('=== Executed analysis: CHIP variants per sample (bix-7-q2) ===')
    print(f'Samples (workbooks): {summary["primary"]["n_samples"]}')
    print(f'Zygosity census (all 57k rows): {dict(zyg_counter)}')
    print('\nSO term census (variant rows, Heterozygous/Homozygous Variant only):')
    for t, c in so_counter_var.most_common():
        print(f'  {c:6d}  {t}')
    print('\nExcluded SO terms (primary):', sorted(EXCLUDE_SO))
    print('\n--- PRIMARY (approved definition) ---')
    s = summary['primary']
    print(f"Average CHIP variants per sample after filtering out intronic, "
          f"intergenic, and UTR variants: {s['mean']:.2f} "
          f"(per-sample range {s['min']}-{s['max']}, median {s['median']})")
    print('\n--- Sensitivity alternatives (labeled, not primary) ---')
    s = summary['alt_loose_utr']
    print(f"Alt 1: 3'/5' UTR dropped but 5'UTR-start-codon-gain kept: {s['mean']:.2f} (range {s['min']}-{s['max']})")
    s = summary['alt_plus_splice']
    print(f"Alt 2: primary + splice_region_variant also dropped:      {s['mean']:.2f} (range {s['min']}-{s['max']})")
    s = summary['alt_splice_up']
    print(f"Alt 3: Alt 2 + upstream_gene_variant also dropped:        {s['mean']:.2f} (range {s['min']}-{s['max']})")

if __name__ == '__main__':
    main()
