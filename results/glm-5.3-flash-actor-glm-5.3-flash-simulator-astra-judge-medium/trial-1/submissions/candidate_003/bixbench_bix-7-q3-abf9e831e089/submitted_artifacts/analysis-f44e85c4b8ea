"""
BixBench bix-7-q3: How many CHIP variants remain after removing reference calls?

Dataset: 86 per-sample XLSX exports in data/CHIP_DP10_GQ20_PASS/ (2-row header:
row 1 = band headers incl. sample label, row 2 = column names). All rows are
already Filter=PASS with DP>=11 and GQ>=21 and lie within the CHIP panel
(In_CHIP=True on every row), so no further gene/quality filtering applies.

Method (approved by researcher):
  - A "reference call" is a row with Zygosity == 'Reference' (explicitly called
    hom-ref genotype). No external reference-variant list exists.
  - NaN-Zygosity rows (1,151) are no-calls (no VAF/genotype exported) and are
    excluded; they are neither reference nor alternate calls.
  - Counting is at the sample-call (row) level: retained rows = Zygosity in
    {'Heterozygous', 'Homozygous Variant'}.
  - Sensitivity view: unique (Chr:Pos, Ref/Alt) variants among retained rows
    (Variant ID is NOT used for uniqueness; it is missing on many rows).
Outputs: Zygosity value counts (verification), row-level retained count,
unique-variant count; written to analysis/chip_variant_counts.csv.
"""
import glob
import collections
import pandas as pd

DATA_GLOB = "data/CHIP_DP10_GQ20_PASS/*.xlsx"
ALT_ZYGOSITY = {"Heterozygous", "Homozygous Variant"}

files = sorted(glob.glob(DATA_GLOB))
assert len(files) == 86, f"expected 86 files, found {len(files)}"

zyg_counts = collections.Counter()
retained_rows = 0
unique_variants = set()
per_file = []

for f in files:
    # header=1 -> row 2 of the workbook is the column-name row
    df = pd.read_excel(f, header=1)
    vc = df["Zygosity"].value_counts(dropna=False)
    zyg_counts.update({("nan" if pd.isna(k) else k): int(v) for k, v in vc.items()})
    keep = df[df["Zygosity"].isin(ALT_ZYGOSITY)]
    retained_rows += len(keep)
    unique_variants.update(zip(keep["Chr:Pos"], keep["Ref/Alt"].astype(str)))
    per_file.append({
        "file": f.split("/")[-1],
        "rows_total": len(df),
        "reference": int((df["Zygosity"] == "Reference").sum()),
        "heterozygous": int((df["Zygosity"] == "Heterozygous").sum()),
        "homozygous_variant": int((df["Zygosity"] == "Homozygous Variant").sum()),
        "no_call_nan": int(df["Zygosity"].isna().sum()),
        "retained_nonref": len(keep),
    })

summary = pd.DataFrame(per_file)
summary.to_csv("analysis/chip_variant_counts.csv", index=False)

total_rows = sum(zyg_counts.values())
print("=" * 70)
print("VERIFICATION: Zygosity value counts across all 86 files")
for k, v in sorted(zyg_counts.items(), key=lambda x: str(x[0])):
    print(f"  {str(k):20s} {v:>7d}  ({v/total_rows:6.2%})")
print(f"  {'TOTAL':20s} {total_rows:>7d}")
assert sum(zyg_counts.values()) == total_rows
assert zyg_counts["nan"] == 1151

print("=" * 70)
print(f"(a) Retained non-reference CHIP variant calls (row-level): {retained_rows:,}")
print(f"      = Heterozygous ({zyg_counts['Heterozygous']:,}) + "
      f"Homozygous Variant ({zyg_counts['Homozygous Variant']:,})")
print(f"(b) Unique (Chr:Pos, Ref/Alt) variants among retained rows: {len(unique_variants):,}")
print("=" * 70)
print("Sanity checks:")
print(f"  files processed: {len(files)}")
print(f"  reference rows removed: {zyg_counts['Reference']:,}")
print(f"  NaN no-call rows excluded: {zyg_counts['nan']:,}")
print(f"  retained + ref + nocall = {retained_rows + zyg_counts['Reference'] + zyg_counts['nan']:,} (should equal {total_rows:,})")
assert retained_rows + zyg_counts["Reference"] + zyg_counts["nan"] == total_rows
