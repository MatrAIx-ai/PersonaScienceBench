"""
Independence test: m6A methylation status vs differential expression status
Bladder cancer MeRIP-seq/RNA-seq dataset (data/MeRIP_RNA_result.xlsx, sheet "Date Formatting")

Primary test (approved): Pearson chi-square on collapsed 2x2 over all 12,754 transcript rows
    rows:    m6A significant (Hyper+Hypo)  vs  m6A no sig
    columns: DEG (Up+Down)                 vs  no-DEGs
Sensitivity checks: Fisher's exact, Yates-corrected chi-square (clearly labeled, not headline).
"""
import pandas as pd
import numpy as np
from scipy.stats import chi2_contingency, fisher_exact

df = pd.read_excel('data/MeRIP_RNA_result.xlsx', sheet_name='Date Formatting')
assert df['m6A'].notna().all() and df['DEG'].notna().all()
assert len(df) == 12754

# Collapsed binary statuses
m6A_status = np.where(df['m6A'].isin(['m6A Hyper', 'm6A Hypo']), 'm6A sig', 'm6A no sig')
DEG_status = np.where(df['DEG'].isin(['Up', 'Down']), 'DEG', 'no-DEGs')

# 2x2 contingency table (rows: m6A status, cols: DEG status)
obs = pd.crosstab(pd.Series(m6A_status, name='m6A status'),
                  pd.Series(DEG_status, name='DEG status'))
obs = obs.loc[['m6A sig', 'm6A no sig'], ['DEG', 'no-DEGs']]
print("Observed 2x2 contingency table:")
print(obs.to_string())
print("Row totals:", obs.sum(axis=1).to_dict(), " Col totals:", obs.sum(axis=0).to_dict())

# ---- PRIMARY: Pearson chi-square (no Yates correction) ----
chi2, p, dof, exp = chi2_contingency(obs.values, correction=False)
exp_df = pd.DataFrame(exp, index=obs.index, columns=obs.columns)
print("\n--- PRIMARY TEST: Pearson chi-square of independence ---")
print("Expected counts under independence:")
print(exp_df.round(2).to_string())
print(f"chi-square statistic = {chi2:.6f}")
print(f"degrees of freedom   = {dof}")
print(f"p-value              = {p:.6e}")

# ---- Sensitivity checks (not headline) ----
chi2_yates, p_yates, dof_y, _ = chi2_contingency(obs.values, correction=True)
odds, p_fisher = fisher_exact(obs.values)
print("\n--- SENSITIVITY CHECKS (not headline) ---")
print(f"Yates-corrected chi-square: stat={chi2_yates:.6f}, dof={dof_y}, p={p_yates:.6e}")
print(f"Fisher's exact (2x2):       odds ratio={odds:.6f}, p={p_fisher:.6e}")

# Appendix note (NOT part of deliverable): restricted Hyper/Hypo x Up/Down table
sub = df[df['m6A'].isin(['m6A Hyper', 'm6A Hypo']) & df['DEG'].isin(['Up', 'Down'])]
obs_r = pd.crosstab(sub['m6A'], sub['DEG']).loc[['m6A Hyper', 'm6A Hypo'], ['Up', 'Down']]
_, p_r, _, exp_r = chi2_contingency(obs_r.values, correction=False)
print("\n--- APPENDIX NOTE (excluded from deliverable) ---")
print("Restricted Hyper/Hypo x Up/Down observed:")
print(obs_r.to_string())
print(f"(min expected count = {exp_r.min():.2f}" + (" < 5; Fisher's exact required here)" if exp_r.min() < 5 else "; expected counts adequate)"))

# Gene-level caveat check (transcripts vs unique genes)
print(f"\nCaveat check: {len(df)} transcript rows map to {df['gene_id'].nunique()} unique ENSG genes.")

# Final answer line
print(f"\nFINAL ANSWER (headline, Pearson chi-square): p = {p:.3e}")
