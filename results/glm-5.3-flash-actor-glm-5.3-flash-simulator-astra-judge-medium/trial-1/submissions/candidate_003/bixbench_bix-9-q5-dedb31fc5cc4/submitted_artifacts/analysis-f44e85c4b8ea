#!/usr/bin/env python3
"""
BixBench bix-9-q5: In which tissue type do bad responders show the highest number
of significantly differentially expressed (lfc>0.5 and basemean>10) genes compared
to controls?

Data: data/Data_deposition_RNAseq_Paroxetine_2017.xlsx
  - NormCount sheet: DESeq2-normalized counts for 90 samples (3 groups x 3 tissues x 10)
    plus 9 precomputed DESeq2 comparison blocks (labeled 'DESeq, Comparison N,
    exclude outliers'), each with baseMean, baseMeanA, baseMeanB, foldChange,
    log2FoldChange, pval, padj, and DEG flag columns.
  - Bad_responder vs Control comparisons (verified by matching baseMeanA/baseMeanB
    to group means of the normalized counts):
      Comp2 = bad vs Control, baseline_blood
      Comp5 = bad vs Control, dentate_gyrus
      Comp8 = bad vs Control, final_blood

Criteria (agreed): padj < 0.05 (Benjamini-Hochberg, already applied by DESeq2),
|log2FoldChange| > 0.5, baseMean > 10. NA/inf/missing padj -> non-significant.
"""
import pandas as pd
import numpy as np

XLSX = "data/Data_deposition_RNAseq_Paroxetine_2017.xlsx"
nc = pd.read_excel(XLSX, sheet_name="NormCount", header=3)
n_genes = len(nc)

# Comparison blocks start at 0-based column 98, 9 columns each:
# [baseMean, baseMeanA, baseMeanB, foldChange, log2FoldChange, pval, padj, DEG, DEG]
BLOCK0 = 98
comparisons = {  # block index (1-based) -> tissue, as verified during inspection
    2: "baseline_blood",
    5: "dentate_gyrus",
    8: "final_blood",
}

rows = []
for comp, tissue in comparisons.items():
    b0 = BLOCK0 + (comp - 1) * 9
    baseMean = nc.iloc[:, b0].to_numpy(dtype=float)
    lfc = nc.iloc[:, b0 + 4].to_numpy(dtype=float)
    padj = nc.iloc[:, b0 + 6].to_numpy(dtype=float)

    ok_padj = np.isfinite(padj) & (padj < 0.05)          # NA/inf -> non-significant
    sig_abs = ok_padj & (np.abs(lfc) > 0.5) & (baseMean > 10)
    sig_pos = ok_padj & (lfc > 0.5) & (baseMean > 10)    # strictly positive lfc (sensitivity)

    up = int((sig_abs & (lfc > 0)).sum())
    down = int((sig_abs & (lfc < 0)).sum())
    rows.append({
        "comparison": f"Comp{comp}: bad_responder vs Control",
        "tissue": tissue,
        "genes_tested_with_baseMean>10": int((baseMean > 10).sum()),
        "n_sig_absLFC": int(sig_abs.sum()),
        "up": up,
        "down": down,
        "n_sig_lfc>0.5_only (sensitivity)": int(sig_pos.sum()),
    })

res = pd.DataFrame(rows).set_index("tissue")
print(f"Genes in NormCount: {n_genes}")
print("\nSignificant DE genes (padj<0.05, |log2FC|>0.5, baseMean>10), bad responders vs controls:")
print(res.to_string())

best = res["n_sig_absLFC"].idxmax()
print(f"\nANSWER: {best} (highest count: {res.loc[best, 'n_sig_absLFC']} genes)")

# save results table
res.to_csv("bad_vs_control_DEG_counts.csv")
