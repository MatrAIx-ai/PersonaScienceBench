"""
Formal analysis: in which century did Diversity in Pottery Form collapse
while Diversity in Pottery Decoration simultaneously increased?

Unit of analysis: 100-year bins [CE_k, CE_k+99] (native resolution of raw z data).
Collapse:  dz <= -1.0 vs previous bin, level < 0 and < -1 z, sustained >= 3 centuries.
Increase:  dz >= +1.0 vs previous bin, level > 0 (and/or > mean of prev 3 bins),
           sustained >= 3 centuries.
Simultaneity: same century bin is both a collapse and an increase bin.
"""
import pandas as pd, numpy as np

ts = pd.read_csv('data/time_series_data.csv')
cap = pd.read_csv('data/capital.csv', decimal=',')

# ---------- century bins from raw z data ----------
raw = ts.dropna(subset=['PotteryForm'])[['CE','PotteryForm','PotteryDecoration']].copy()
raw['bin'] = (raw.CE // 100) * 100
raw = raw.sort_values('bin').reset_index(drop=True)
assert (raw.bin.diff().dropna() == 100).all(), "bins not contiguous"
n = len(raw)

def detect(series, dz, level_fn, sustain, rising):
    """Return list of event bins for one series under given thresholds."""
    ev = []
    v = series.values
    for i in range(1, n):
        d = v[i] - v[i-1]
        lvl_ok = (v[i] > 0) if rising else (v[i] < 0)
        ok = (d >= dz and lvl_ok) if rising else (d <= -dz and lvl_ok)
        if not ok:
            continue
        # sustainability: plateau held for `sustain` subsequent bins
        if i + sustain <= n and len(set(v[i:i+sustain+1])) == 1:
            ev.append((int(raw.bin[i]), round(float(v[i-1]),3), round(float(v[i]),3)))
    return ev

print("="*80)
print("A. MAIN ANALYSIS (approved thresholds: |dz|>=1.0, level crossing 0, sustain>=3)")
print("="*80)
collapse = detect(raw.PotteryForm,    1.0, None, 3, rising=False)
increase = detect(raw.PotteryDecoration, 1.0, None, 3, rising=True)
print("Collapse bins (PotteryForm)  [bin, z_prev, z_event]:", collapse)
print("Increase bins (PotteryDecoration) [bin, z_prev, z_event]:", increase)
sim = sorted(set(b for b,_,_ in collapse) & set(b for b,_,_ in increase))
print("SIMULTANEOUS bins (same bin both events):", sim)
assert len(sim) == 1, "expected unique simultaneous bin"

# interval-overlap fallback criterion
c_int = {b: (b, b+299) for b,_,_ in collapse}   # event + sustain window
i_int = {b: (b, b+299) for b,_,_ in increase}
ov = [c for c in c_int if any(i_int[s][0] <= c_int[c][1] and c_int[c][0] <= i_int[s][1] for s in i_int)]
print("Overlapping-interval fallback pairs (collapse_bin, increase_bin):",
      [(c, s) for c in c_int for s in i_int if c_int[c][0] <= i_int[s][1] and i_int[s][0] <= c_int[c][1]])

b = sim[0]
i_ev = raw.index[raw.bin == b][0]
print(f"\nEvent bin {b}..{b+99} (={-b}..{-b-99} BCE):")
print(f"  PotteryForm:      {raw.PotteryForm[i_ev-1]:+.2f} -> {raw.PotteryForm[i_ev]:+.2f} (dz={raw.PotteryForm[i_ev]-raw.PotteryForm[i_ev-1]:+.2f})")
print(f"  PotteryDecoration:{raw.PotteryDecoration[i_ev-1]:+.2f} -> {raw.PotteryDecoration[i_ev]:+.2f} (dz={raw.PotteryDecoration[i_ev]-raw.PotteryDecoration[i_ev-1]:+.2f})")
print(f"  Form plateau at {raw.PotteryForm[i_ev]:+.2f} lasts {int(raw.bin.iloc[-1]//100*100 - b)//100 + 1} centuries (to bin {int(raw.bin.iloc[-1])}).")
nxt = raw[(raw.bin > b) & (raw.PotteryDecoration != raw.PotteryDecoration[i_ev])]
print(f"  Decor later moves {raw.PotteryDecoration[i_ev]:+.2f} -> {nxt.PotteryDecoration.iloc[0]:+.2f} at bin {int(nxt.bin.iloc[0])}, while form stays flat at {raw.PotteryForm[i_ev]:+.2f} -> NOT simultaneous.")

print()
print("="*80)
print("B. SENSITIVITY (threshold grid)")
print("="*80)
rows = []
for dz in (1.0, 1.5):
    for sus in (3, 5):
        c = {x[0] for x in detect(raw.PotteryForm, dz, None, sus, False)}
        i_ = {x[0] for x in detect(raw.PotteryDecoration, dz, None, sus, True)}
        rows.append(dict(dz=dz, sustain=sus, collapse=sorted(c), increase=sorted(i_),
                         simultaneous=sorted(c & i_)))
print(pd.DataFrame(rows).to_string(index=False))

print()
print("="*80)
print("C. ROLLING-MEAN CROSS-CHECK on annual _inter series (window=100y)")
print("="*80)
ts = ts.sort_values('CE').reset_index(drop=True)
ts['PF_r100']  = ts.PotteryForm_inter.rolling(100, center=True).mean()
ts['PD_r100']  = ts.PotteryDecoration_inter.rolling(100, center=True).mean()
rb = ts.dropna(subset=['PF_r100']).copy()
rb['bin'] = (rb.CE // 100) * 100
ann = rb.groupby('bin')[['PF_r100','PD_r100']].mean()
dPF  = ann.PF_r100.diff()
dPD  = ann.PD_r100.diff()
print("Largest decade-to-decade... (century-step) changes in rolling means:")
print("  PotteryForm drops:");  print(dPF.nsmallest(3).round(3).to_string())
print("  PotteryDecoration rises:"); print(dPD.nlargest(3).round(3).to_string())
ev_bin_r = int(dPF.idxmin())
print(f"  -> biggest form drop in rolling means at bin {ev_bin_r}; "
      f"decor change there = {dPD.loc[ev_bin_r]:+.3f} (rise: {dPD.loc[ev_bin_r] > 0})")
# annual-resolution check: first year where smoothed form falls below 0 / decoration above 0
form_neg  = ts.loc[ts.PF_r100 < 0,  'CE'].min()
dec_pos   = ts.loc[ts.PD_r100 > 0.5, 'CE'].min()
print(f"  first CE with rolling-form < 0: {form_neg}; first CE with rolling-decor > +0.5: {dec_pos}")

print()
print("="*80)
print("D. ALL 37 BINS (z form / z decor / dz-form / dz-decor) — event inventory")
print("="*80)
tab = raw.copy()
tab['d_form'] = tab.PotteryForm.diff().round(2)
tab['d_dec']  = tab.PotteryDecoration.diff().round(2)
tab = tab.rename(columns={'bin':'bin_CE_start','PotteryForm':'z_form','PotteryDecoration':'z_dec'})
print(tab.to_string(index=False))
tab.to_csv('pottery_bins_table.csv', index=False)

print()
print("="*80)
print("E. CONTROL: capital.csv vs time_series_data.csv alignment (already inspected)")
print("="*80)
cap['CE'] = -cap.BCE
m = ts.set_index('CE').reindex(cap.CE)
print("max|PotteryForm - ZKeform| =", np.nanmax(np.abs(m.PotteryForm.values - cap.ZKeform.values)))
print("max|PotteryDecoration - Zkeverz| =", np.nanmax(np.abs(m.PotteryDecoration.values - cap.Zkeverz.values)))

print()
print("EVENT BIN -> calendar naming: bin starts CE -1700 = 1700 BCE; years 1700-1601 BCE = 17th century BCE.")
