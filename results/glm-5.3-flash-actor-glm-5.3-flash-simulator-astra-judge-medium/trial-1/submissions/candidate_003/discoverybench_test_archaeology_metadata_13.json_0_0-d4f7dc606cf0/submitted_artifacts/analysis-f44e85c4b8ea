# -*- coding: utf-8 -*-
"""
Growth-phase analysis for 2000-1100 BCE (DiscoveryBench archaeology, metadata_13).
Century bins (astronomical years): 20th c. BCE = CE [-2000,-1901] ... 12th c. BCE = CE [-1200,-1100];
the single year CE=-1100 is assigned to the 12th century per agreed convention.
Primary growth metrics: pollen_grate_100 (openness growth) and KDE growth
(g_all_mean as provided + annual log-growth of kde_all_mean).
12 standardized Z series = supporting evidence. SMOOTH_MEAN_100y level = context only.
"""
import pandas as pd, numpy as np

ts = pd.read_csv('data/time_series_data.csv', index_col=0)
po = pd.read_csv('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv', index_col=0, decimal=',')

print("== SANITY CHECKS ==")
m = ts[['CE','pollen_inter']].merge(po[['CE','MEAN','Belau_PC1_inter']], on='CE').dropna()
print("(b) corr(pollen_inter, Belau_PC1_inter) = %.4f (n=%d) -> same series, positive sign, no inversion"
      % (m['pollen_inter'].corr(m['Belau_PC1_inter']), len(m)))
rp = ts.dropna(subset=['pollen'])[['pollen','pollen_inter']]
print("(c) raw pollen vs interpolation: max abs dev = %.2e" % (rp['pollen']-rp['pollen_inter']).abs().max())
zcols = ['HatchetSword','Dagger','HouseSize','CopperGold','Amber','MonumentCount','Depot','Sickle',
         'AxesCelts','MonumentSize','PotteryForm','PotteryDecoration']
w0 = ts[(ts.CE>=-2000)&(ts.CE<=-1100)]
dev = max((w0[w0[c].notna()][c]-w0[w0[c].notna()][c+'_inter']).abs().max() for c in zcols)
print("(c) raw centennial Z vs *_inter: max abs dev over 12 series = %.2e" % dev)
print("(a) corr(pollen_grate_100, pollen_inter_100.diff()) in window = %.4f -> grate ~ annual change of the"
      % w0['pollen_grate_100'].corr(w0['pollen_inter_100'].diff()))
print("    100-year smoothed openness (not the raw 1y series); values ~1e-3 = raw units per year, not %.")

w = ts[(ts.CE >= -2000) & (ts.CE <= -1100)].copy()
w['cent_n'] = (-w['CE'] - 1)//100 + 1
w.loc[w['CE'] == -1100, 'cent_n'] = 12

Z = [c+'_inter' for c in zcols]

def agg(g):
    kde = g['kde_all_mean'].values
    return pd.Series({
        'pollen_rate_yr': g['pollen_grate_100'].mean(),          # mean annual pollen growth
        'pollen_cum': g['pollen_grate_100'].sum(),               # cumulative pollen change over century
        'g_all_mean': g['g_all_mean'].mean(),                    # provided KDE growth rate (mean)
        'g_all_cum': g['g_all_mean'].sum(),                      # cumulative KDE growth
        'kde_log_yr': np.diff(np.log(kde)).mean(),               # mean annual log growth of KDE
        'kde_log_tot': np.log(kde[-1]/kde[0]),                   # (end/start) over century
        'Z_delta_yr': np.mean([g[c].diff().mean() for c in Z]),  # supporting: mean annual delta of 12 std. Z series
        'openness_level': g['pollen_inter_100'].mean(),          # context only
    })

pd.set_option('display.width', 250)
tab = w.groupby('cent_n').apply(agg, include_groups=False)
tab['label'] = [f"{int(i)}th c. BCE" for i in tab.index]
print("\n== MAIN CENTURY TABLE (2000-1100 BCE, astronomical bins) ==")
print(tab.round(6).to_string())

print("\n== RANKINGS (primary metrics first) ==")
for col in ['pollen_cum','pollen_rate_yr','g_all_cum','g_all_mean','kde_log_tot','kde_log_yr','Z_delta_yr']:
    order = tab[col].sort_values(ascending=False)
    pairs = ", ".join("%s (%+.4f)" % (tab.loc[i,'label'], v) for i,v in order.items())
    print(f"{col}: {pairs}")

print("\n== SENSITIVITY: alternative bins [-1999..-1900] ... [-1199..-1100] (right-inclusive) ==")
w['alt'] = (-w['CE'] - 1100)//100 + 11   # 11 = CE[-1100..-1199] ... 20 = CE[-1900..-1999]
tab2 = w.groupby('alt').apply(agg, include_groups=False)
tab2['label'] = [f"{int(i)}th c. BCE" for i in tab2.index]
print(tab2[['pollen_cum','g_all_cum','kde_log_tot','Z_delta_yr']].round(6).to_string())
for col in ['pollen_cum','g_all_cum','kde_log_tot','Z_delta_yr']:
    order = tab2[col].sort_values(ascending=False)
    print(f"[alt] {col}: " + ", ".join("%s (%+.4f)" % (tab2.loc[i,'label'], v) for i,v in order.items()))

print("\n== Supporting: raw centennial Z levels (mean of 12 indicators) ==")
raw = w0[w0['HatchetSword'].notna()][['CE']+zcols].set_index('CE')
raw['meanZ'] = raw[zcols].mean(axis=1)
print(raw[['meanZ']].round(3).T.to_string())
print("century-to-century change of raw meanZ:")
print(raw['meanZ'].diff().dropna().round(3).to_string())

print("\n== Context: openness level (pollen_inter_100) start/end per century ==")
ctx = w.groupby('cent_n')['pollen_inter_100'].agg(['first','last','mean']).round(3)
print(ctx.to_string())

tab.to_csv('century_growth_table.csv')
tab2.to_csv('century_growth_table_alt_bins.csv')
print("\nSaved: century_growth_table.csv, century_growth_table_alt_bins.csv")
