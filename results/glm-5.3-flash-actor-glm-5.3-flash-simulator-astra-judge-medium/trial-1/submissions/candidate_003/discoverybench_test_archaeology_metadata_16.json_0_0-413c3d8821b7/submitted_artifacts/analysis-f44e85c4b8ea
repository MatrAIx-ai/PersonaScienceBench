import pandas as pd
import numpy as np

df = pd.read_csv('data/capital.csv', decimal=',')
Zcols = [c for c in df.columns if c.startswith('Z')]
X = df[Zcols].values

def pca_np(A, k=3):
    A = A - A.mean(0)
    U, S, Vt = np.linalg.svd(A, full_matrices=False)
    var = S**2 / (len(A)-1)
    ratio = var / var.sum()
    return Vt[:k], ratio[:k]

def run(scope_mask, label):
    Vt, ratio = pca_np(X[scope_mask])
    scores = (X - X[scope_mask].mean(0)) @ Vt[0]
    if Vt[0].mean() < 0:
        Vt[0] *= -1; scores *= -1
    load = pd.Series(Vt[0], index=Zcols)
    out = pd.DataFrame({'BCE': df.BCE, 'group': df.group, 'PC1': scores})
    print(f'=== {label} ===')
    print('var explained PC1/PC2/PC3:', np.round(ratio, 3))
    print('loadings PC1:'); print(load.round(3).to_string())
    print('sanity OBA/YBA mean PC1:', round(out[out.group.isin(['OBA','YBA'])].PC1.mean(),3))
    return out, load, ratio[0]

out_all, load_all, ev_all = run(np.ones(len(df), bool), 'FULL SERIES (all 39 slices)')
neo = df.BCE.between(2300, 4300).values
out_neo, load_neo, ev_neo = run(neo, 'NEOLITHIC ONLY (EN+MN+SG, n=%d)' % neo.sum())

for name, o in [('full', out_all), ('neolithic', out_neo)]:
    sub = o[o.BCE.between(2300, 3400)]
    print(f'--- {name}: MN (3400-3000) ---')
    print(sub[sub.group=='MN'].round(3).to_string(index=False))
    print(f'--- {name}: SG/YN (2900-2300) ---')
    print(sub[sub.group=='SG'].round(3).to_string(index=False))
    mn, sg = sub[sub.group=='MN'].PC1.mean(), sub[sub.group=='SG'].PC1.mean()
    print('MN mean:', round(mn,3), 'SG mean:', round(sg,3), 'SG-MN diff:', round(sg-mn,3))

out_all.round(3).to_csv('analysis/pc1_scores_full.csv', index=False)
out_neo.round(3).to_csv('analysis/pc1_scores_neolithic.csv', index=False)
pd.DataFrame({'full': load_all, 'neolithic': load_neo}).round(3).to_csv('analysis/pc1_loadings.csv')
print('saved CSVs; ev_full=%.3f ev_neo=%.3f' % (ev_all, ev_neo))
