import pandas as pd
import numpy as np

# --- Load data ---
c = pd.read_csv('data/capital.csv', decimal=',')
zcols = ['ZAxtSchwert','ZDolch','Zhausgr','ZCU_AU','Zamber','ZMonument',
         'ZHort','ZSichel','ZBeil','ZMW','ZKeform','Zkeverz']
capital_form = {
    'symbolic':  ['ZAxtSchwert','ZDolch','ZCU_AU','Zamber','ZHort'],
    'social':    ['Zhausgr','ZMonument','ZMW'],
    'cultural':  ['ZKeform','Zkeverz'],
    'economic':  ['ZSichel','ZBeil'],
}
assert sorted(zcols) == sorted([x for v in capital_form.values() for x in v]), "grouping mismatch"

X = c[zcols].values.astype(float)
# Correlation-matrix PCA: standardize each column to zero mean / unit variance.
# capital.csv already holds Z-scores; StandardScaler-style rescaling preserves
# proportionality, and unit-variance scaling => PCA of the correlation matrix.
Xs = (X - X.mean(axis=0)) / X.std(axis=0, ddof=0)
print("After (re)standardization: column means ~0, stds ~1 -> PCA on correlation matrix")
print("max |mean| = %.2e, max |std-1| = %.2e" % (np.abs(Xs.mean(0)).max(), np.abs(Xs.std(0)-1).max()))

# Full SVD (equivalent to sklearn PCA(svd_solver='full'))
U, S, Vt = np.linalg.svd(Xs, full_matrices=False)
expl = (S**2) / (S**2).sum()
print("\nExplained variance ratios, first 4 PCs: %s" % np.round(expl[:4], 4))

# --- Fix sign: positive loading on ZCU_AU ---
cu_idx = zcols.index('ZCU_AU')
loadings = Vt[0].copy()
sign = 1.0 if loadings[cu_idx] > 0 else -1.0
loadings *= sign
scores = (Xs @ loadings)          # PC1 scores (note: scores = U*S since Xs = U S Vt)
PC2_load = Vt[1] * (1.0 if Vt[1][cu_idx] > 0 else -1.0)
PC2_scores = Xs @ PC2_load
print("Sign fixed so that ZCU_AU loading > 0 (sign factor = %+.0f)" % sign)

# --- Loadings table ---
load_df = pd.DataFrame({'variable': zcols, 'PC1_loading': np.round(loadings, 3)})
load_df['capital_form'] = ['symbolic' if v in capital_form['symbolic'] else
                           'social' if v in capital_form['social'] else
                           'cultural' if v in capital_form['cultural'] else 'economic'
                           for v in zcols]
print("\n--- PC1 loadings grouped by form of capital (PC1 explains %.1f%% of variance) ---"
      % (100*expl[0]))
print(load_df.sort_values('capital_form').to_string(index=False))
sq = load_df.assign(sq=load_df.PC1_loading**2)
print("\nShare of PC1 squared loadings by capital form:")
print((sq.groupby('capital_form').sq.sum() / sq.sq.sum()).round(3).sort_values(ascending=False).to_string())

# --- Scores table ---
c['PC1'] = scores
c['PC2'] = PC2_scores
yba = c[c.group == 'YBA'].sort_values('BCE')
print("\n--- YBA (Younger Bronze Age) PC1 scores ---")
print(yba[['BCE','group','PC1','PC2']].round(3).to_string(index=False))

base = yba[yba.BCE == 1100].PC1.iloc[0]
subs = yba[(yba.BCE >= 500) & (yba.BCE <= 1000)].sort_values('BCE')
print("\n--- Comparison: PC1 at 1100 BCE vs each later horizon (1000-500 BCE) ---")
for _, r in subs.iterrows():
    print(f"1100 vs {int(r.BCE)}: base={base:.3f}, later={r.PC1:.3f}, diff={base - r.PC1:+.3f}")
mean_subs = subs.PC1.mean()
print(f"\nMean PC1 1000-500 BCE: {mean_subs:.3f}; PC1 at 1100 BCE: {base:.3f}; diff = {base - mean_subs:+.3f}")
print(f"Std PC1 1000-500: {subs.PC1.std(ddof=1):.3f} -> 1100 lies {(base-mean_subs)/subs.PC1.std(ddof=1):.2f} SD above the later-horizon mean")

print("\nFull-series PC1 context: min %.3f, max %.3f, mean %.3f, std %.3f" %
      (c.PC1.min(), c.PC1.max(), c.PC1.mean(), c.PC1.std()))
print("Rank of 1100 BCE PC1 in full series (1 = highest): %d of %d" %
      (int(c.PC1.rank(ascending=False)[c.BCE==1100].iloc[0]), len(c)))
print("\nContext rows around the transition (OBA -> YBA):")
print(c[c.BCE.isin([1300,1200,1100,1000])][['BCE','group','PC1']].round(3).to_string(index=False))

# --- Decomposition of the 1100-vs-later difference into variable contributions ---
sub_mean = Xs[c.BCE.isin(range(500, 1001))].mean(axis=0)
row1100 = Xs[c.BCE == 1100][0]
contrib = (row1100 - sub_mean) * loadings
cd = pd.DataFrame({'variable': zcols,
                   'contribution_to_PC1_diff': np.round(contrib, 3)})
cd['capital_form'] = load_df.capital_form
print("\n--- Variable contributions to PC1 diff (1100 minus mean 1000-500) ---")
print(cd.sort_values('contribution_to_PC1_diff', ascending=False).to_string(index=False))
print("Sum of contributions = %.3f (must equal the PC1 diff)" % contrib.sum())
print("\nContribution share by capital form:")
cd['abs'] = cd.contribution_to_PC1_diff.abs()
print((cd.groupby('capital_form').contribution_to_PC1_diff.sum()).round(3).sort_values(ascending=False).to_string())

# --- Robustness: leave-one-century-out PCA ---
loo = []
for i in range(len(c)):
    mask = np.ones(len(c), bool); mask[i] = False
    Xi = X[mask]
    Xi_s = (Xi - Xi.mean(0)) / Xi.std(0, ddof=0)
    U2, S2, Vt2 = np.linalg.svd(Xi_s, full_matrices=False)
    l2 = Vt2[0] * (1.0 if Vt2[0][cu_idx] > 0 else -1.0)
    s_all = (Xs @ l2)
    loo.append(s_all[c.BCE==1100][0] - s_all[c.BCE.isin(range(500,1001))].mean())
print("\nRobustness (leave-one-century-out): diff 1100 vs mean(1000-500): mean=%.3f, range=[%.3f, %.3f]"
      % (np.mean(loo), np.min(loo), np.max(loo)))

# --- Save outputs ---
load_df.sort_values('capital_form').to_csv('output/pc1_loadings.csv', index=False)
yba[['BCE','group','PC1','PC2']].round(4).to_csv('output/yba_pc1_scores.csv', index=False)
c[['BCE','group','PC1','PC2']].round(4).to_csv('output/all_pc1_scores.csv', index=False)
