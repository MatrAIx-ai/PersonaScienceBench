import pandas as pd
import numpy as np

# Corrected grouping per study context (interpretive layer only; PCA numbers unchanged)
c = pd.read_csv('data/capital.csv', decimal=',')
zcols = ['ZAxtSchwert','ZDolch','Zhausgr','ZCU_AU','Zamber','ZMonument',
         'ZHort','ZSichel','ZBeil','ZMW','ZKeform','Zkeverz']
capital_form = {
    'symbolic':  ['ZAxtSchwert','ZDolch','Zhausgr'],
    'social':    ['ZCU_AU','Zamber','ZMonument'],
    'cultural':  ['ZKeform','Zkeverz'],
    'economic':  ['ZHort','ZSichel','ZBeil','ZMW'],
}

X = c[zcols].values.astype(float)
Xs = (X - X.mean(0)) / X.std(0, ddof=0)
U, S, Vt = np.linalg.svd(Xs, full_matrices=False)
loadings = Vt[0] * (1.0 if Vt[0][zcols.index('ZCU_AU')] > 0 else -1.0)
expl = (S**2)/(S**2).sum()

def form(v):
    for k, lst in capital_form.items():
        if v in lst: return k

ld = pd.DataFrame({'variable': zcols, 'PC1_loading': loadings})
ld['capital_form'] = [form(v) for v in zcols]
print("--- PC1 loadings by CORRECTED capital form (PC1 var expl %.1f%%) ---" % (100*expl[0]))
print(ld.sort_values('capital_form').round(3).to_string(index=False))
sq = ld.assign(sq=ld.PC1_loading**2)
shares = (sq.groupby('capital_form').sq.sum() / sq.sq.sum()).sort_values(ascending=False)
print("\nSquared-loading share by form (corrected):")
print((100*shares).round(1).to_string())

# contributions to 1100 vs mean(1000-500)
sub_mean = Xs[c.BCE.isin(range(500,1001))].mean(0)
row1100 = Xs[c.BCE==1100][0]
contrib = pd.Series((row1100 - sub_mean) * loadings, index=zcols)
print("\n--- Contributions to PC1 diff (1100 minus mean 1000-500) by CORRECTED form ---")
for k, lst in capital_form.items():
    print(f"{k}: total = {contrib[lst].sum():+.3f}   " +
          ", ".join(f"{v} {contrib[v]:+.3f}" for v in lst))
print("Sum check: %+.3f (PC1 diff = %+.3f)" % (contrib.sum(), loadings @ (row1100-sub_mean)))

# rewrite loadings artifact with corrected grouping
ld.assign(PC1_loading=ld.PC1_loading.round(3)).sort_values('capital_form') \
  .to_csv('output/pc1_loadings.csv', index=False)
print("\nUpdated output/pc1_loadings.csv with corrected grouping.")
