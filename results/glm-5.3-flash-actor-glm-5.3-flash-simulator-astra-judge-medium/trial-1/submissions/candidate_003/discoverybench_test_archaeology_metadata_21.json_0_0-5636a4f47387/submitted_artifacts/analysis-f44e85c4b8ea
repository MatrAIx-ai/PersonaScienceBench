"""PCA on forms of capital (capital.csv), 39 hundred-year time slices.
Correlation-matrix PCA, sign fixed so Zhausgr loads positive on PC1.
Sensitivities: 37-row subset (BCE<=4100), PCA without ZSichel."""
import pandas as pd, numpy as np

cap = pd.read_csv('data/capital.csv', decimal=',')
zcols = ['ZAxtSchwert','ZDolch','Zhausgr','ZCU_AU','Zamber','ZMonument',
         'ZHort','ZSichel','ZBeil','ZMW','ZKeform','Zkeverz']

def pca(X, labels=zcols):
    C = np.corrcoef(X, rowvar=False)
    w, V = np.linalg.eigh(C)
    order = np.argsort(w)[::-1]
    w, V = w[order], V[:, order]
    # sign: Zhausgr (index 2) positive on PC1
    if V[2, 0] < 0:
        V = -V
    # also fix PC2 sign: Zhausgr positive on PC2 if nonzero, else first strong var
    if abs(V[2, 1]) > 1e-8 and V[2, 1] < 0:
        V[:, 1] = -V[:, 1]
    load = V * np.sqrt(w)          # loadings = correlations of vars with PCs
    scores = (X - X.mean(0)) / X.std(0, ddof=1) @ V
    return w, load, scores

def report(X, df, tag, labels=zcols):
    w, load, scores = pca(X, zcols)
    evr = w / X.shape[1]
    print(f'\n===== {tag} =====')
    print('Eigenvalues (correlation PCA):', np.round(w, 3))
    print('Variance explained PC1..PC4: %s' % np.round(evr[:4]*100, 1))
    L = pd.DataFrame(load[:, :3], index=labels, columns=['PC1','PC2','PC3'])
    print(L.round(3).to_string())
    S = pd.DataFrame({'BCE': df.BCE.values, 'group': df.group.values,
                      'PC1': scores[:,0], 'PC2': scores[:,1], 'PC3': scores[:,2]})
    print('\nScores by period group:')
    print(S.groupby('group')[['PC1','PC2']].agg(['mean','min','max']).round(2).to_string())
    print('\nScores (all slices, chronological):')
    print(S.round(2).to_string())
    return L, S, evr

X39 = cap[zcols].values
L39, S39, evr39 = report(X39, cap, 'MAIN: 39 rows, all 12 vars')

# Sensitivity 1: 37 rows (BCE <= 4100, matching ts raw points)
cap37 = cap[cap.BCE <= 4100]
L37, S37, evr37 = report(cap37[zcols].values, cap37, 'SENS 1: 37 rows (BCE<=4100), all 12 vars')

# Sensitivity 2: without ZSichel
cols10 = [c for c in zcols if c != 'ZSichel']
L10, S10, evr10 = report(cap[cols10].values, cap, 'SENS 2: 39 rows, 11 vars (no ZSichel)', labels=cols10)

# Sensitivity 3: SVD-based PCA sanity check (sklearn-style, correlation == standardized covariance)
Z = (X39 - X39.mean(0)) / X39.std(0, ddof=1)
U, sv, Vt = np.linalg.svd(Z, full_matrices=False)
print('\nSENS 3: SVD cross-check singular values^2/(n-1):', np.round(sv**2/(len(Z)-1), 3))

# Supporting diagnostics: correlations among variables (main gradient structure)
C = np.corrcoef(X39, rowvar=False)
Cdf = pd.DataFrame(C, index=zcols, columns=zcols)
print('\nCorrelation matrix (39 rows):')
print(Cdf.round(2).to_string())
sym = ['Zhausgr','ZDolch','ZAxtSchwert']
print('\nMean |r| of each variable with the other 11:')
print(Cdf.apply(lambda col: col.drop(col.name).abs().mean()).round(3).sort_values(ascending=False).to_string())
