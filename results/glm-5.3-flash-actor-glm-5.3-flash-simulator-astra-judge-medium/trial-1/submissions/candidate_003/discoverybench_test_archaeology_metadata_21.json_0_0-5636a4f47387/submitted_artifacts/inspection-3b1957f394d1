"""Initial data inspection: capital.csv & time_series_data.csv (no PCA computed)."""
import pandas as pd, numpy as np

cap = pd.read_csv('data/capital.csv', decimal=',')
ts = pd.read_csv('data/time_series_data.csv', index_col=0)

print('=== capital.csv ===')
print('shape:', cap.shape)
print('BCE range:', cap.BCE.min(), '-', cap.BCE.max(), '| unique BCE:', cap.BCE.nunique())
print('missing per column:'); print(cap.isna().sum().to_string())
print(cap.groupby('group').BCE.agg(['min','max','count']))
zcols = [c for c in cap.columns if c.startswith('Z')]
print('\nZ-column whole-series stats (standardization check):')
print(cap[zcols].agg(['mean','std']).T.to_string())

print('\n=== time_series_data.csv ===')
print('shape:', ts.shape)
print('CE range:', ts.CE.min(), ts.CE.max(), '| calBP:', ts.calBP.min(), ts.calBP.max())
raw = [c for c in ts.columns if c in ('HatchetSword','Dagger','HouseSize','CopperGold','Amber',
        'MonumentCount','Depot','Sickle','AxesCelts','MonumentSize','PotteryForm','PotteryDecoration')]
for c in raw:
    s = ts[c].dropna()
    ces = sorted(ts.loc[ts[c].notna(),'CE'].tolist())
    print(f'{c}: n_raw={len(s)} at CE {ces[0]}..{ces[-1]} (all x100: {all(abs(v)%100==0 for v in ces)}), std={s.std():.4f}')
print('\nNaN counts raw vs _inter (example):',
      ts.HatchetSword.isna().sum(), ts.HatchetSword_inter.isna().sum())
print('inter==raw at raw points:', np.allclose(ts.HatchetSword.dropna(), ts.HatchetSword_inter[ts.HatchetSword.notna()]))
print('yearly _inter stats (HatchetSword): mean=%.4f std=%.4f' %
      (ts.HatchetSword_inter.mean(), ts.HatchetSword_inter.std(ddof=0)))
print('within-window constancy check CE -4050..-4040 HouseSize_inter unique:', ts.loc[(ts.CE>=-4050)&(ts.CE<=-4040),'HouseSize_inter'].round(6).unique()[:3])
print('\nCross-file match at shared points:')
m = cap.set_index(-cap.BCE); m2 = ts[ts.CE.isin(m.index)].set_index('CE')
pairs = [('ZAxtSchwert','HatchetSword'),('ZDolch','Dagger'),('Zhausgr','HouseSize'),
         ('ZCU_AU','CopperGold'),('Zamber','Amber'),('ZMonument','MonumentCount'),
         ('ZHort','Depot'),('ZSichel','Sickle'),('ZBeil','AxesCelts'),
         ('ZMW','MonumentSize'),('ZKeform','PotteryForm'),('Zkeverz','PotteryDecoration')]
for a,b in pairs:
    print(f'  {a} == {b}:', np.allclose(m.loc[m2.index,a], m2[b]))
print('capital rows absent from ts (BCE):', sorted(set(cap.BCE) - set(-ts.CE)))
