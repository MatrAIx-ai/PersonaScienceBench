"""
Analysis: monuments & axes vs elements of symbolic capital, 3400-3000 BCE.
DiscoveryBench episode discoverybench:test/archaeology/metadata_23.json/0/0
Descriptive only (n = 5 century bins). No significance claims.
"""
import pandas as pd, numpy as np, json, itertools

OUT = {}

# ---------- load ----------
ts = pd.read_csv('data/time_series_data.csv', index_col=0)
cap = pd.read_csv('data/capital.csv')
for c in cap.columns[3:]:
    cap[c] = cap[c].astype(str).str.replace(',', '.').astype(float)

# consistency check: capital.csv vs time_series raw bins
mapd = {'ZAxtSchwert':'HatchetSword','ZDolch':'Dagger','Zhausgr':'HouseSize',
        'ZCU_AU':'CopperGold','Zamber':'Amber','ZMonument':'MonumentCount',
        'ZHort':'Depot','ZSichel':'Sickle','ZBeil':'AxesCelts','ZMW':'MonumentSize',
        'ZKeform':'PotteryForm','Zkeverz':'PotteryDecoration'}
tsb = ts[ts.CE <= 0].copy(); tsb['BCE'] = -tsb.CE
m = cap.merge(tsb, on='BCE')
assert len(m) == 37
maxdiff = {k: float((m[k]-m[v]).abs().max()) for k, v in mapd.items()}
OUT['capital_vs_timeseries_max_abs_diff'] = maxdiff
assert all(v == 0.0 for v in maxdiff.values()), "capital.csv != time_series raw bins"

# ---------- in-window bin table ----------
wCE = [-3400, -3300, -3200, -3100, -3000]
cols = ['MonumentCount','AxesCelts','MonumentSize','HatchetSword','Dagger','HouseSize',
        'Amber','CopperGold','Depot','PotteryForm']
b = ts[ts.CE.isin(wCE)].set_index('CE').loc[wCE, cols]
b.insert(0, 'group', ['MN']*5)
OUT['bin_table'] = b.round(4).to_dict(orient='index')
print("=== Century-bin table, 3400-3000 BCE (Z values, primary) ===")
print(b.round(3).to_string())

# ---------- bin-to-bin direction-of-change concordance ----------
d = b.drop(columns=['group']).diff().dropna()  # 4 steps
def concordance(a, bcol):
    steps = []
    for ce in d.index:
        da, db = d.loc[ce, a], d.loc[ce, bcol]
        s = 'same' if da*db > 0 else ('opposite' if da*db < 0 else 'flat/zero')
        steps.append({'to_BCE': -ce, 'delta_'+a: round(da,3), 'delta_'+bcol: round(db,3), 'relation': s})
    n_same = sum(s['relation']=='same' for s in steps)
    n_opp  = sum(s['relation']=='opposite' for s in steps)
    return steps, n_same, n_opp

print("\n=== Direction-of-change concordance (4 bin-to-bin steps) ===")
conc = {}
for pair in [('MonumentCount','HouseSize'), ('AxesCelts','HouseSize'),
             ('MonumentCount','AxesCelts'), ('MonumentCount','MonumentSize'),
             ('AxesCelts','MonumentSize'), ('HouseSize','MonumentSize')]:
    steps, ns, no = concordance(*pair)
    conc[f'{pair[0]}_vs_{pair[1]}'] = {'same_direction_steps': ns, 'opposite_direction_steps': no, 'steps': steps}
    print(f"{pair[0]} vs {pair[1]}: {ns} same / {no} opposite of 4 steps")
    for s in steps:
        print(f"   -> {s['to_BCE']}: d{pair[0]}={s['delta_'+pair[0]]:+.2f} d{pair[1]}={s['delta_'+pair[1]]:+.2f} [{s['relation']}]")
OUT['concordance'] = conc

# ---------- correlations on 5-bin trajectories (descriptive) ----------
print("\n=== Pearson r on 5-bin trajectories (descriptive, n=5) ===")
r = {}
for pair in [('MonumentCount','HouseSize'), ('AxesCelts','HouseSize'),
             ('MonumentCount','AxesCelts'), ('MonumentCount','MonumentSize'),
             ('AxesCelts','MonumentSize'), ('HouseSize','MonumentSize'),
             ('MonumentCount','Amber'), ('AxesCelts','CopperGold'),
             ('MonumentCount','Depot'), ('MonumentCount','PotteryForm')]:
    r[f'{pair[0]}_vs_{pair[1]}'] = round(float(np.corrcoef(b[pair[0]], b[pair[1]])[0,1]), 3)
    print(f"  r({pair[0]}, {pair[1]}) = {r[f'{pair[0]}_vs_{pair[1]}']:+.3f}")
OUT['pearson_r_5bins'] = r

# AxesCelts outlier sensitivity: drop the -3200 bin (n=4)
b4 = b.drop(index=-3200)
r4 = {f'{a}_vs_{c}': round(float(np.corrcoef(b4[a], b4[c])[0,1]),3)
      for a,c in [('MonumentCount','HouseSize'),('AxesCelts','HouseSize'),
                  ('MonumentCount','AxesCelts'),('MonumentCount','MonumentSize')]}
print("\nSensitivity: Pearson r excluding the -3200 outlier bin (n=4):")
for k,v in r4.items(): print(f"  r({k}) = {v:+.3f}")
OUT['pearson_r_4bins_excl_3200'] = r4

# ---------- annual _inter trajectories (shape only) ----------
wi = ts[(ts.CE>=-3400)&(ts.CE<=-3000)]
shapes = {}
for c in ['MonumentCount_inter','AxesCelts_inter','MonumentSize_inter','HouseSize_inter']:
    s = wi.set_index('CE')[c]
    shapes[c] = {'start': round(s.iloc[0],3), 'min': round(s.min(),3), 'at_min_CE': int(s.idxmin()),
                 'max': round(s.max(),3), 'at_max_CE': int(s.idxmax()), 'end': round(s.iloc[-1],3)}
OUT['annual_inter_shape'] = shapes

# ---------- pollen (secondary / exploratory) ----------
pol = pd.read_csv('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv', index_col=0)
for c in pol.columns:
    if c not in ('calBP', 'CE'):
        pol[c] = pol[c].astype(str).str.replace(',', '.').astype(float)
pw = pol[(pol.CE>=-3400)&(pol.CE<=-3000)][['CE','MEAN','SMOOTH_MEAN_100y']].set_index('CE')
# join onto bins (nearest annual row at each century mark)
bins_pol = pw.reindex(wCE, method='nearest')
tbl = b[['MonumentCount','AxesCelts','HouseSize']].join(bins_pol)
rp = {f'MonumentCount_vs_MEAN': round(float(np.corrcoef(tbl.MonumentCount, tbl.MEAN)[0,1]),3),
      f'AxesCelts_vs_MEAN': round(float(np.corrcoef(tbl.AxesCelts, tbl.MEAN)[0,1]),3),
      f'HouseSize_vs_MEAN': round(float(np.corrcoef(tbl.HouseSize, tbl.MEAN)[0,1]),3)}
print("\n=== Pollen openness PC1 MEAN at bin marks (secondary/exploratory) ===")
print(tbl.round(3).to_string())
print("Pearson r (n=5, descriptive):", rp)
raw_counts = {'Belau_raw_in_window': int(pol[(pol.CE>=-3400)&(pol.CE<=-3000)].Belau_PC1.notna().sum()),
              'Woserin_raw_in_window': int(pol[(pol.CE>=-3400)&(pol.CE<=-3000)].Woserin_PC1.notna().sum())}
OUT['pollen'] = {'bin_table_with_MEAN': tbl.round(4).to_dict(orient='index'),
                 'pearson_r_5bins': rp, 'raw_samples_in_window': raw_counts,
                 'sign_convention': 'ASSUMED: higher PC1 = more open landscape; not documented in file — direction ambiguous, keep exploratory'}

with open('artifacts/analysis_results.json','w') as f:
    json.dump(OUT, f, indent=2)
print("\nSaved -> artifacts/analysis_results.json")
