import pandas as pd, numpy as np

# --- Primary basis: raw 100-year bins (capital.csv), decimal comma ---
cap = pd.read_csv('data/capital.csv', decimal=',')
cap = cap[~cap.BCE.isin([4200, 4100])]          # drop padding rows duplicating the BCE 4300 value
cap = cap.sort_values('BCE', ascending=False).reset_index(drop=True)  # old -> young
print(f"bins after dropping padding rows: {len(cap)}, BCE {cap.BCE.max()} -> {cap.BCE.min()}")

# Cross-check vs raw points in time_series_data.csv
ts = pd.read_csv('data/time_series_data.csv')
raw = ts.dropna(subset=['PotteryForm'])[['CE','PotteryForm','PotteryDecoration']].copy()
raw['BCE'] = -raw['CE']
m = cap.merge(raw, on='BCE', suffixes=('_cap','_ts'))
print(f"cross-check bins matched: {len(m)}, "
      f"Form identical: {(m.ZKeform==m.PotteryForm).all()}, "
      f"Deco identical: {(m.Zkeverz==m.PotteryDecoration).all()}")

cap['dForm'] = cap['ZKeform'].diff()
cap['dDeco'] = cap['Zkeverz'].diff()
cap['from_BCE'] = cap['BCE'].shift(1)

print("\n--- Century-binned first differences (old -> young), transitions with dDeco>0 & dForm<0 ---")
opp = cap[(cap.dForm < 0) & (cap.dDeco > 0)]
print(opp[['from_BCE','BCE','group','ZKeform','Zkeverz','dForm','dDeco']].to_string(index=False))

print("\n--- Significance sweep: |dForm|>=thr AND |dDeco|>=thr, earliest hit ---")
for thr in [0.25, 0.5, 0.75, 1.0]:
    sel = opp[(opp.dForm.abs() >= thr) & (opp.dDeco.abs() >= thr)]
    hits = [f"{int(r.from_BCE)}->{int(r.BCE)} BCE (dForm={r.dForm:+.2f}, dDeco={r.dDeco:+.2f})"
            for r in sel.itertuples()]
    print(f"|dz|>={thr}: {len(sel)} hit(s); earliest: {hits[0] if hits else 'none'}")

print("\ndForm stats:", cap.dForm.describe().round(3).to_dict())
print("dDeco stats:", cap.dDeco.describe().round(3).to_dict())
print("SD-based check: |dForm|=1.87 =", round(1.87/cap.dForm.std(),1), "SD of dForm;",
      "|dDeco|=1.45 =", round(1.45/cap.dDeco.std(),1), "SD of dDeco")

# --- Robustness note (non-primary): 100-year bins resampled from the 1-year _inter series ---
ts_bin = ts[ts.CE % 100 == 0].copy()   # 100-year sampling of interpolated series = raw bins
ts_bin['dF'] = ts_bin['PotteryForm_inter'].diff()
ts_bin['dD'] = ts_bin['PotteryDecoration_inter'].diff()
sel_i = ts_bin[(ts_bin.dF < 0) & (ts_bin.dD > 0) & (ts_bin.dF.abs() >= 0.5) & (ts_bin.dD.abs() >= 0.5)]
r = sel_i.iloc[0]
print(f"\nRobustness (_inter resampled to 100y, thr 0.5): earliest CE {int(r.CE)} "
      f"(dF={r.dF:+.2f}, dD={r.dD:+.2f}) -> transition into {-r.CE} BCE (identical to primary)")
# yearly diffs spread the same jump: max yearly dD in CE -1800..-1699
seg = ts[(ts.CE >= -1800) & (ts.CE < -1699)]
print(f"same jump at 1-y resolution: cumulative dForm {seg.PotteryForm_inter.iloc[-1]-seg.PotteryForm_inter.iloc[0]:+.2f}, "
      f"cumulative dDeco {seg.PotteryDecoration_inter.iloc[-1]-seg.PotteryDecoration_inter.iloc[0]:+.2f} "
      f"(max single-year steps only {seg.PotteryForm_inter.diff().abs().max():.3f} / {seg.PotteryDecoration_inter.diff().abs().max():.3f})")

# --- Decisive transition, neighbourhood ---
nb = cap[(cap.BCE <= 2200) & (cap.BCE >= 1400)][['BCE','group','ZKeform','Zkeverz','dForm','dDeco']]
print("\nNeighbourhood of the transition:\n", nb.to_string(index=False))

# --- Fill-value plateau diagnostics ---
mn = cap.ZKeform.min()
plateau = cap[cap.ZKeform == mn]
segs = (plateau.sort_values('BCE').BCE.diff() > 100).sum() + 1
print(f"\nFill-value plateau: Form == {mn} (series minimum) in {len(plateau)}/{len(cap)} bins, "
      f"{segs} contiguous segment(s): BCE {int(plateau.BCE.min())}..{int(plateau.BCE.max())}")
pre = cap[cap.BCE >= 1800]
print(f"Pre-transition Form: mean {pre.ZKeform.mean():.2f}, range [{pre.ZKeform.min():.2f},{pre.ZKeform.max():.2f}]; "
      f"post-1700 Form constant at {mn}: {(cap[cap.BCE<=1700].ZKeform==mn).all()}")
