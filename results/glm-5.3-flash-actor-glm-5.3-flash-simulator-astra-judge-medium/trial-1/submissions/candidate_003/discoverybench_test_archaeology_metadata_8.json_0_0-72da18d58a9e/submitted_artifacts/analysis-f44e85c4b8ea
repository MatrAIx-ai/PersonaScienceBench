"""Amber peak analysis: millennium and time interval of the maximum Z value.

Inputs: data/time_series_data.csv (Amber, Amber_inter), data/capital.csv (Zamber).
Method: raw century-bin Z values; find global max and plateau of consecutive
maximal bins; cross-check the two tables bin-by-bin. Linear interpolation
(Amber_inter) is checked but cannot exceed node values.
"""
import pandas as pd

TS_PATH = 'data/time_series_data.csv'
CAP_PATH = 'data/capital.csv'

# --- Load (capital.csv uses ',' as decimal separator) ---
ts = pd.read_csv(TS_PATH, index_col=0)
cap = pd.read_csv(CAP_PATH, decimal=',')

# --- Axis / sign sanity checks ---
assert ((ts.CE + ts.calBP) == 1950).all(), 'CE+calBP must equal 1950'
assert (ts.CE <= 0).all(), 'CE column here is BCE x (-1): all values must be <= 0'

# --- Raw amber century series ---
raw = ts.dropna(subset=['Amber'])[['CE', 'calBP', 'Amber']]
assert raw.CE.diff().dropna().eq(100).all(), 'raw Amber must be regular 100-year bins'

vmax = raw.Amber.max()
peak_bins = raw[raw.Amber == vmax]
ce_lo, ce_hi = peak_bins.CE.min(), peak_bins.CE.max()          # CE = -BCE
bce_lo, bce_hi = -ce_hi, -ce_lo                                # plateau in BCE years
# 4th millennium BCE = 4000-3001 BCE; millennium of the EARLIEST peak bin (3300 BCE)
bce_earliest = -ce_lo                                          # 3300 BCE
millennium_start = ((bce_earliest - 1) // 1000) * 1000 + 1     # 3300 BCE -> 3001
millennium_end = millennium_start + 999
millennium_ordinal = millennium_start // 1000 + 1              # 4th millennium BCE
caveat = ('note: the last plateau bin (label 3000 BCE) sits on the 4th/3rd millennium '
          'boundary depending on the bin-edge convention')

# --- Amber_inter check: does interpolation create a higher max? ---
assert ts.Amber_inter.max() <= vmax + 1e-12
inter_plateau = ts[ts.Amber_inter == vmax].CE
assert inter_plateau.min() == ce_lo and inter_plateau.max() == ce_hi

# --- Cross-check against capital.csv (Zamber) ---
cap['CE_eq'] = -cap.BCE
merged = cap.merge(raw.rename(columns={'CE': 'CE_eq'}), on='CE_eq', suffixes=('_cap', '_ts'))
mism = merged[abs(merged.Zamber - merged.Amber) > 1e-9]
assert mism.empty, f'Zamber vs Amber mismatches: {len(mism)}'
cap_peak = cap[cap.Zamber == cap.Zamber.max()].BCE.sort_values().tolist()

print(f'Rows time_series={len(ts)}, raw amber bins={len(raw)}, capital rows={len(cap)}')
print(f'Raw Amber: min={raw.Amber.min()}, max={vmax}')
print(f'Peak plateau (time_series): CE {ce_lo}..{ce_hi} -> {bce_lo}-{bce_hi} BCE '
      f'({len(peak_bins)} century bins: {sorted(peak_bins.CE.tolist(), reverse=True)})')
print(f'Peak plateau (capital.csv): BCE {cap_peak} ({len(cap_peak)} bins)')
print(f'Millennium: {millennium_ordinal}-th millennium BCE '
      f'({millennium_end}-{millennium_start} BCE); {caveat}')
grp = cap[cap.BCE.isin(cap_peak)].group.unique().tolist()
print(f'Archaeological group at peak: {grp}')
print(f'Amber_inter max {ts.Amber_inter.max():.4f} equals raw max -> interpolation adds no higher peak')
print(f'Cross-check Zamber vs Amber: {len(merged)} shared bins, {len(mism)} mismatches')
