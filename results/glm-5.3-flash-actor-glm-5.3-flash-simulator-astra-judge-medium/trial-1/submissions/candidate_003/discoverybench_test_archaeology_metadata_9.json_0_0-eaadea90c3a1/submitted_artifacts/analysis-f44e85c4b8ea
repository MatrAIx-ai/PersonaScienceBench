# -*- coding: utf-8 -*-
"""
DiscoveryBench: archaeology / social capital peak analysis.
Question: In which century did summed social capital peak, and which individual
social capital components increase at that time?

Primary data : data/capital.csv          (100-yr bins, BCE 4300..500)
Validation   : data/time_series_data.csv (annual; raw Z at century anchors, *_inter annual)
Context      : data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv (landscape openness)
"""
import pandas as pd, numpy as np, json, sys

pd.set_option('display.width', 200)
R = {}   # results dict

# ---------------------------------------------------------------- load
cap = pd.read_csv('data/capital.csv', decimal=',')
ts  = pd.read_csv('data/time_series_data.csv')
pol = pd.read_csv('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv', decimal=',')

COMP = {'ZAxtSchwert':'HatchetSword','ZDolch':'Dagger','Zhausgr':'HouseSize',
        'ZCU_AU':'CopperGold','Zamber':'Amber','ZMonument':'MonumentCount',
        'ZHort':'Depot','ZSichel':'Sickle','ZBeil':'AxesCelts','ZMW':'MonumentSize',
        'ZKeform':'PotteryForm','Zkeverz':'PotteryDecoration'}
SOCIAL = ['ZCU_AU','Zamber','ZMonument']          # Copper&Gold + Amber + MonumentCount

# sanity: alignment capital BCE <-> ts CE = -BCE (verified in exploratory pass; assert again)
m = cap[cap.BCE.isin([-ts.CE.unique()])].sort_values('BCE')
for bce in m.BCE:
    rts = ts[ts.CE==-bce].iloc[0]
    for a,b in COMP.items():
        assert np.isclose(float(m[m.BCE==bce][a].iloc[0]), rts[b]), (bce,a)
R['alignment'] = 'all 37 overlapping century bins of capital.csv identical to ts raw Z at CE=-BCE'

# ---------------------------------------------------------------- primary metric (capital.csv)
cap['SOCIAL_sum']   = cap[SOCIAL].sum(axis=1)
cap['SOCIAL_mean']  = cap[SOCIAL].mean(axis=1)

print('='*80); print('A. PRIMARY: capital.csv, SOCIAL = ZCU_AU + Zamber + ZMonument')
print(cap[['BCE','group','ZCU_AU','Zamber','ZMonument','SOCIAL_sum']].round(2).to_string(index=False))

rank = cap.sort_values('SOCIAL_sum', ascending=False)
peak_bin = int(rank.iloc[0].BCE)
R['peak_bin_BCE'] = peak_bin
R['peak_value'] = round(float(rank.iloc[0].SOCIAL_sum),3)
print('\nTop-5 bins by SOCIAL_sum:')
print(rank[['BCE','group','ZCU_AU','Zamber','ZMonument','SOCIAL_sum','SOCIAL_mean']].head(5).round(3).to_string(index=False))

# plateau vs single bin: is the top value shared by adjacent bin(s)?
top_val = cap.SOCIAL_sum.max()
plateau = cap.loc[cap.SOCIAL_sum == top_val, 'BCE'].tolist()
adj = [b for b in cap.BCE if abs(b-peak_bin)==100 and cap.loc[cap.BCE==b,'SOCIAL_sum'].iloc[0] >= top_val - 1e-9]
near = cap[cap.BCE.isin([peak_bin-100, peak_bin+100])][['BCE','SOCIAL_sum']]
R['plateau_bins'] = plateau
print(f'\nPeak bin = {peak_bin} BCE; exact-tie bins (plateau) = {plateau}')
print('Neighbour bins:'); print(near.round(3).to_string(index=False))
print('Second distinct value below plateau:', cap.SOCIAL_sum[cap.SOCIAL_sum<top_val].max().round(2),
      'at bins', cap.loc[cap.SOCIAL_sum==cap.SOCIAL_sum[cap.SOCIAL_sum<top_val].max(),'BCE'].tolist())

# ---------------------------------------------------------------- B. leave-one-out (sum AND mean)
print('\n'+'='*80); print('B. LEAVE-ONE-OUT robustness (sum and mean)')
loo = {}
for drop in SOCIAL:
    keep = [c for c in SOCIAL if c!=drop]
    s = cap[keep].sum(axis=1); mn = cap[keep].mean(axis=1)
    p_sum = int(cap.loc[s.idxmax(),'BCE']); p_mean = int(cap.loc[mn.idxmax(),'BCE'])
    top3s = cap.assign(_s=s).nlargest(3,'_s')[['BCE','_s']]
    loo[drop] = {'peak_sum': p_sum, 'peak_mean': p_mean,
                 'top3_sum': [(int(r.BCE), round(r['_s'],2)) for _,r in top3s.iterrows()]}
    print(f'  drop {drop:12s}: peak(sum)={p_sum} BCE  peak(mean)={p_mean} BCE  top3={loo[drop]["top3_sum"]}')
R['leave_one_out'] = loo
print('  -> scenario WITHOUT Amber:', loo['Zamber']['peak_sum'], 'BCE by sum;',
      loo['Zamber']['peak_mean'], 'BCE by mean')

# ---------------------------------------------------------------- C. growing components (dZ)
print('\n'+'='*80); print('C. dZ of all 12 capitals entering the peak (windows)')
def W(lo,hi): return cap[(cap.BCE>=lo)&(cap.BCE<=hi)]
pre, peak, post = W(1500,1600), W(1200,1400), W(900,1100)
rows=[]
for c in list(COMP):
    d_pre_peak  = peak[c].mean() - pre[c].mean()
    d_peak_post = post[c].mean() - peak[c].mean()
    rows.append({'var':c,'pre(1500-1600)':pre[c].mean().round(2),
                 'peak(1200-1400)':peak[c].mean().round(2),
                 'post(900-1100)':post[c].mean().round(2),
                 'dZ_pre->peak':round(d_pre_peak,2),'dZ_peak->post':round(d_peak_post,2),
                 'corr_with_SOCIAL':round(cap[c].corr(cap.SOCIAL_sum),2)})
d = pd.DataFrame(rows).sort_values('dZ_pre->peak', ascending=False)
print(d.to_string(index=False))
R['dZ_table'] = d.to_dict('records')
R['growing_into_peak'] = [r['var'] for r in R['dZ_table'] if r['dZ_pre->peak'] > 0.3]
print('\nComponents growing INTO the peak (dZ_pre->peak > +0.3):', R['growing_into_peak'])
# per-bin dZ 1500->1400 exactly
print('\nPer-bin change 1500 -> 1400 (BCE):')
for c in SOCIAL:
    print(f'  {c:12s}: {float(cap[cap.BCE==1500][c].iloc[0]):+.2f} -> {float(cap[cap.BCE==1400][c].iloc[0]):+.2f}  (dZ={float(cap[cap.BCE==1400][c].iloc[0])-float(cap[cap.BCE==1500][c].iloc[0]):+.2f})')

# ---------------------------------------------------------------- D. validation via time_series_data.csv
print('\n'+'='*80); print('D. VALIDATION: time_series_data.csv')
cent = ts[ts.CE % 100 == 0].copy()                      # raw century anchors
cent['SOCIAL_raw'] = cent[['CopperGold','Amber','MonumentCount']].sum(axis=1)
ann = ts.copy()
ann['SOCIAL_inter'] = ann[['CopperGold_inter','Amber_inter','MonumentCount_inter']].sum(axis=1)
# annual _inter aggregated back to century means with two bin conventions
ann['bin_floor'] = (ann.CE // 100 * 100).astype(int)          # label = bin start (CE negative)
ann['bin_round'] = (np.round(ann.CE / 100) * 100).astype(int) # label = nearest century anchor
agg_floor = ann.groupby('bin_floor').SOCIAL_inter.mean()
agg_round = ann.groupby('bin_round').SOCIAL_inter.mean()
print('Raw century anchors:   peak CE =', int(cent.loc[cent.SOCIAL_raw.idxmax(),'CE']),
      ' value =', round(cent.SOCIAL_raw.max(),3), ' (BCE =', -int(cent.loc[cent.SOCIAL_raw.idxmax(),'CE']), ')')
print('Annual _inter, bin floor convention:  peak BCE =', -int(agg_floor.idxmax()), ' value =', round(agg_floor.max(),3),
      ' top3 =', [(-int(k), round(v,2)) for k,v in agg_floor.nlargest(3).items()])
print('Annual _inter, bin round convention:  peak BCE =', -int(agg_round.idxmax()), ' value =', round(agg_round.max(),3),
      ' top3 =', [(-int(k), round(v,2)) for k,v in agg_round.nlargest(3).items()])
print('Annual _inter, single best year:      peak CE =', int(ann.loc[ann.SOCIAL_inter.idxmax(),'CE']),
      ' value =', round(ann.SOCIAL_inter.max(),3))
R['validation'] = {'raw_anchor_peak_BCE': -int(cent.loc[cent.SOCIAL_raw.idxmax(),'CE']),
                   'inter_floor_peak_BCE': -int(agg_floor.idxmax()),
                   'inter_round_peak_BCE': -int(agg_round.idxmax()),
                   'single_year_peak_BCE': -int(ann.loc[ann.SOCIAL_inter.idxmax(),'CE'])}

# rolling smoothing robustness on capital.csv (2- and 3-bin centred windows, ordered by BCE)
cc = cap.sort_values('BCE').reset_index(drop=True)
for w in (3,5):
    sm = cc.SOCIAL_sum.rolling(w, center=True, min_periods=1).mean()
    print(f'Rolling {w}-bin smoothing of SOCIAL_sum: peak BCE =', int(cc.loc[sm.idxmax(),"BCE"]),
          ' value =', round(sm.max(),3))
    R[f'rolling{w}_peak_BCE'] = int(cc.loc[sm.idxmax(),'BCE'])

# ---------------------------------------------------------------- E. pollen openness: empirical sign + trajectory
print('\n'+'='*80); print('E. POLLEN OPENNESS (empirical sign determination)')
# pc1 from dedicated file: MEAN of interpolated Belau/Woserin PC1, smoothed
pol['MEANf'] = pd.to_numeric(pol['MEAN'], errors='coerce')
pol['SM100'] = pd.to_numeric(pol['SMOOTH_MEAN_100y'], errors='coerce')
pol['BCE'] = -pol.CE
# ts side: pollen_inter etc.
ts['BCE'] = -ts.CE

# (1) sign test: correlation of openness with settlement/activity KDE (occupation intensity).
# If landscape openness tracks human activity, corr(pollen_openness, kde) should be positive when sign is right.
for col,src in [('pollen_inter','ts'),('pollen_inter_100','ts'),('SM100','pol'),('MEANf','pol')]:
    df = ts[['BCE','kde_all_detrend','kde_all_mean']].merge(
         (pol[['BCE',col]] if src=='pol' else ts[['BCE',col]]), on='BCE', how='inner').dropna()
    r_det = df[col].corr(df.kde_all_detrend); r_mean = df[col].corr(df.kde_all_mean)
    print(f'  {col:18s} (src={src}) n={len(df):4d}  corr(openness, kde_detrend)={r_det:+.2f}  corr(openness, kde_mean)={r_mean:+.2f}')
    R[f'sign_corr_{col}'] = round(r_det,2)
# (2) direction over the whole record: openness rises into the (later, denser) occupation phases?
early = pol[(pol.BCE>=4300)&(pol.BCE<=3400)].SM100.mean()
late  = pol[(pol.BCE<=900)&(pol.BCE>=500)].SM100.mean()
print(f'  SMOOTH_MEAN_100y: mean 4300-3400 BCE = {early:.2f}  vs  900-500 BCE = {late:.2f}'
      f'  -> openness {"INCREASES" if late>early else "DECREASES"} over record; high PC1 = more open if corr with kde > 0')
# (3) openness in the peak window vs before
for lab, lo, hi in [('pre-peak 1700-1500',1700,1500), ('peak 1400-1100',1400,1100), ('post 900-500',900,500)]:
    v = pol[(pol.BCE<=lo)&(pol.BCE>=hi)].SM100.mean()
    v2 = ts[(ts.BCE<=lo)&(ts.BCE>=hi)].pollen_inter_100.mean()
    print(f'  window {lab}: pollen-file SMOOTH_MEAN_100y = {v:.2f} | ts pollen_inter_100 = {v2:.2f}')
    R[f'pollen_{lab.split()[0]}'] = round(v,2)
print('  pollen_grate_100 in peak window (mean rate):',
      round(ts[(ts.BCE<=1400)&(ts.BCE>=1100)].pollen_grate_100.mean(),5))
print('  pollen_grate_100 in pre window  (mean rate):',
      round(ts[(ts.BCE<=1700)&(ts.BCE>=1500)].pollen_grate_100.mean(),5))

# ---------------------------------------------------------------- summary
print('\n'+'='*80); print('SUMMARY JSON')
print(json.dumps(R, indent=1, default=str))
with open('analysis/results.json','w') as f: json.dump(R, f, indent=1, default=str)

# ---------------------------------------------------------------- F. pollen sign: cross-series agreement + kde timing (appendix)
print('\n'+'='*80); print('F. POLLEN SIGN APPENDIX (empirical)')
ts['BCE']=-ts.CE
df = ts[['BCE','pollen_inter']].merge(pol[['BCE','MEANf']],on='BCE',how='inner').dropna()
print('corr(ts pollen_inter, pol MEAN) =', round(df.pollen_inter.corr(df.MEANf),3), '-> same underlying series (Belau+Woserin mean)')
df2 = ts[['BCE','pollen_inter_100']].merge(pol[['BCE','SM100']],on='BCE',how='inner').dropna()
print('corr(ts pollen_inter_100, pol SMOOTH_MEAN_100y) =', round(df2.pollen_inter_100.corr(df2.SM100),3))
k = ts.assign(c=(ts.BCE//100)*100).groupby('c').kde_all_mean.mean()
print('kde_all_mean top centuries:', [(int(i), round(v,6)) for i,v in k.nlargest(5).items()])
for lo,hi,lab in [(4300,3400,'EN/MN'),(3300,2400,'SG'),(2300,1400,'LN/OBA'),(1400,500,'BA')]:
    sub_t = ts[(ts.BCE<=lo)&(ts.BCE>=hi)]
    print(f'  {lab:8s} BCE {lo}-{hi}: kde={sub_t.kde_all_mean.mean():.2e}  openness(pollen_inter)={sub_t.pollen_inter.mean():+.2f}')
cap['S']=cap[['ZCU_AU','Zamber','ZMonument']].sum(axis=1)
mm = cap.merge(pol.groupby('BCE',as_index=False).SM100.mean(),on='BCE')
print('corr(SOCIAL_sum, openness SM100) over 39 century bins =', round(mm.S.corr(mm.SM100),3))
print('openness level: pre-peak(1700-1500)=1.15 vs peak(1400-1100)=1.84 vs post(900-500)=4.43 (SM100 means)')
print('CONCLUSION sign: PC1 rises monotonically through the occupation record and tracks the two-site mean;')
print('adopting the standard Feeser et al. (2019) interpretation, higher PC1 = more open landscape;')
print('direct correlation with settlement KDE is weak (r~+0.17 detrended), so the sign claim is stated as interpretation, not proof.')
