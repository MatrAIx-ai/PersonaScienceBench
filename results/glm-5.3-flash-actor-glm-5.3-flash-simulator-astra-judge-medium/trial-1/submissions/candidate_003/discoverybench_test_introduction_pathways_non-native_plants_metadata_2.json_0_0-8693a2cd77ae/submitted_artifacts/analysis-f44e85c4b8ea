    pv.append((h,fisher_2x2(g,t-g,rest_g,rest_og)))
mtot=len(pv); ranked=sorted(pv,key=lambda x:x[1]); bh={}
# proper BH step-up: q_i = p_(i)*m/i, then cumulative minimum from the largest i downward
qs=[p*mtot/(i+1) for i,(h,p) in enumerate(ranked)]
run_min=qs[-1]; bh[ranked[-1][0]]=run_min
for i in range(mtot-2,-1,-1):
    run_min=min(run_min,qs[i]); bh[ranked[i][0]]=run_min
