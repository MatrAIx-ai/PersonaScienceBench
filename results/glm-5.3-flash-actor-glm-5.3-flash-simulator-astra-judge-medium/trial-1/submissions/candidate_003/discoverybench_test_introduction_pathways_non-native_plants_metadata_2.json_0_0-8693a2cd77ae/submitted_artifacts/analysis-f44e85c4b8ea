# Wilson CIs + Fisher exact 2x2 per habitat (gardening vs rest)
def fisher_2x2(a,b,c,d):
    n_=a+b+c+d; r1=a+b; c1=a+c
    def lg(k): return math.lgamma(k+1)
    def pmf(x):
        # C(c1,x)*C(n-c1, r1-x)/C(n, r1)
        return math.exp(lg(c1)-lg(x+1)-lg(c1-x+1)+lg(n_-c1)-lg(r1-x+1)-lg(n_-c1-r1+x+1)+lg(r1)+lg(n_-r1)-lg(n_))
    lo=max(0,c1-(n_-r1)); hi=min(c1,r1)
    p_obs=min(pmf(x) for x in range(lo,hi+1))
    return min(sum(pmf(x) for x in range(lo,hi+1) if pmf(x)<=p_obs*(1+1e-7)),1.0)
z=1.959964; z2=z**2
