    if t==0: print(f"{h:<24s} 0/0"); continue
    ph=g/t; den=1+z2/t; ctr=(ph+z2/(2*t))/den
    hw=z*math.sqrt(ph*(1-ph)/t+z2/(4*t*t))/den
    flag=" <-- SPARSE (<=8 records): unstable" if t<=8 else ""
    print(f"{h:<24s} {g:>3d}/{t:<4d} share={ph:.2f} CI=[{max(ctr-hw,0):.2f},{min(ctr+hw,1):.2f}]  Fisher p={pv[[x[0] for x in pv].index(h)][1]:.2e}  BH-q={bh[h]:.2e}{flag}")

