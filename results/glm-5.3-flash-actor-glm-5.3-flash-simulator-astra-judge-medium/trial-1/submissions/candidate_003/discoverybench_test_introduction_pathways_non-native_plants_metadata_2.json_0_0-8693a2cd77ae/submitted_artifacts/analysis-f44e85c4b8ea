# ---- Global permutation test of independence (habitat totals fixed) ----
def chisq(tab):
    rows=[sum(r) for r in tab]; cols=[sum(tab[i][j] for i in range(len(tab))) for j in range(3)]
    n=sum(rows); s=0.0
    for i in range(len(tab)):
        for j in range(3):
            e=rows[i]*cols[j]/n
            if e>0: s+=(tab[i][j]-e)**2/e
    return s
pool=[]
for i,h in enumerate(HABS):
    pool+=['Gardening']*table[i][0]+['Unintentional']*table[i][1]+['AgriForest']*table[i][2]
sizes=[sum(table[i]) for i in range(len(HABS))]
obs=chisq(table)
cnt=0; B=10000
for _ in range(B):
    random.shuffle(pool); idx=0; pt=[]
    for s in sizes:
        seg=pool[idx:idx+s]; idx+=s
        pt.append([seg.count('Gardening'),seg.count('Unintentional'),seg.count('AgriForest')])
    if chisq(pt)>=obs-1e-9: cnt+=1
print(f"\nGlobal test (pathway x habitat): Pearson chi2={obs:.2f}, df=18; Monte-Carlo p ({B} perms, habitat margins fixed) = {cnt/B:.4f}")

# ---- Firth logistic regression (handles separation) ----
def loglik_pen(X,y,n,beta):
    s=0.0
    eta=[min(700,max(-700,sum(b*x for b,x in zip(beta,row)))) for row in X]
    for e,yi,ni in zip(eta,y,n):
        s += yi*e - ni*math.log1p(math.exp(e)) - (ni-yi)*math.log1p(math.exp(-e))
    # penalty 0.5*log|X'WX|
    p=len(X[0])
    eta=[sum(b*x for b,x in zip(beta,row)) for row in X]
    mu=[1/(1+math.exp(-min(500,max(-500,e)))) for e in eta]
    W=[m*(1-m)*ni for m,ni in zip(mu,n)]
    XtWX=[[sum(wi*row[a]*row[b] for row,wi in zip(X,W)) for b in range(p)] for a in range(p)]
    # logdet via Cholesky
    L=[[0.0]*p for _ in range(p)]
    try:
        for a in range(p):
            for b in range(a+1):
                ssum=XtWX[a][b]-sum(L[a][k]*L[b][k] for k in range(b))
                if a==b:
                    if ssum<=1e-12: return -1e18
                    L[a][b]=math.sqrt(ssum)
                else: L[a][b]=ssum/L[b][b]
        s += sum(math.log(L[a][a]) for a in range(p))
    except ValueError:
        return -1e18
    return s

def firth(X,y,n,iters=200):
    p=len(X[0]); beta=[0.0]*p
    cur=loglik_pen(X,y,n,beta)
    for _ in range(iters):
        eta=[min(30,max(-30,sum(b*x for b,x in zip(beta,row)))) for row in X]
        mu=[1/(1+math.exp(-e)) for e in eta]
        W=[m*(1-m)*ni for m,ni in zip(mu,n)]
        XtWX=[[sum(wi*row[a]*row[b] for row,wi in zip(X,W)) for b in range(p)] for a in range(p)]
        M=[XtWX[a][:]+[1.0 if a==b else 0.0 for b in range(p)] for a in range(p)]
        for a in range(p):
            piv=max(range(a,p),key=lambda r:abs(M[r][a])); M[a],M[piv]=M[piv],M[a]
            d=M[a][a] or 1e-12; M[a]=[v/d for v in M[a]]
            for r in range(p):
                if r!=a:
                    f=M[r][a]; M[r]=[vr-f*va for vr,va in zip(M[r],M[a])]
        inv=[M[a][p:] for a in range(p)]
        h=[sum(W[i]*sum(X[i][a]*sum(inv[a][b]*X[i][b] for b in range(p)) for a in range(p)) for a in range(p)) for i in range(len(X))]
        U=[sum((y[i]-mu[i])*X[i][a] for i in range(len(X))) + 0.5*sum(h[i]*(1-2*mu[i])*X[i][a] for i in range(len(X))) for a in range(p)]
        step=[sum(inv[a][b]*U[b] for b in range(p)) for a in range(p)]
        t=1.0
        for _ in range(50):
            cand=[b+t*s for b,s in zip(beta,step)]
            ll=loglik_pen(X,y,n,cand)
            if ll>=cur-1e-12: break
            t/=2
        beta=cand; cur=ll
        if max(abs(t*s) for s in step)<1e-8: break
    ses=[math.sqrt(max(inv[a][a],0)) for a in range(p)]
    return beta,ses

def run_glm(y,n,label,ref='Croplands'):
    levels=[ref]+[h for h in HABS if h!=ref]
    X=[[1.0]+[1.0 if lv==h else 0.0 for h in levels[1:]] for lv in levels]
    y=[y[h] for h in levels]; n=[n[h] for h in levels]
    beta,ses=firth(X,y,n)
    print(f"\n{label} (Firth logistic, ref={ref}):")
    print(f"{'term':<24s}{'est(logOR)':>11s}{'SE':>7s}{'OR':>8s}{'95%CI OR':>20s}{'z':>7s}")
    for a in range(len(levels)):
        nm='Intercept:'+ref if a==0 else levels[a]
        lo,hi=beta[a]-1.96*ses[a],beta[a]+1.96*ses[a]
        print(f"{nm:<24s}{beta[a]:>11.3f}{ses[a]:>7.3f}{math.exp(beta[a]):>8.2f}  [{math.exp(lo):.2f},{math.exp(hi):.2f}]{beta[a]/ses[a]:>7.2f}")
    return levels

