"""
DiscoveryBench: introduction_pathways_non-native_plants
Question: In what context does the gardening pathway for introducing non-native
plants show different prevalence styles across habitat types?

Approved plan:
 - Core evidence: invaded_niche_pathways.csv (per-plot pathway counts x habitat)
   (a) absolute Gardening counts + plots occupied
   (b) Gardening share of n.total conditional on n.total>0
   (c) per-plot Gardening counts given presence
 - Support: invasion_success_pathways.csv species-level trait contrast
   (Gardening vs Unintentional); duplicated=TRUE rows dropped (4 rows).
 - Secondary: temporal_trends_contingency_table.csv temporal context.
 - phylogenetic_tree.txt intentionally unused (no habitat/pathway info).
"""
import csv, statistics, json

# ---------- Load core file (tab-separated, quoted) ----------
with open('data/invaded_niche_pathways.csv') as f:
    plots = list(csv.DictReader(f, delimiter='\t'))
print(f"invaded_niche_pathways.csv: {len(plots)} plots x {len(plots[0])} cols")
assert all(int(r['n.gard'])+int(r['n.unint'])+int(r['n.agfo'])==int(r['n.total']) for r in plots)

# ---------- Per-habitat aggregation ----------
HAB_ORDER = ['Urban','Croplands','Riparian','Wetlands','Coastal','Meadows',
             'Coniferous forests','Scrublands','Broad-leaved forests','Rock outcrops']
rows_out = []
for h in HAB_ORDER:
    sub = [r for r in plots if r['habitat'] == h]
    nplots = len(sub)
    gard = sum(int(r['n.gard']) for r in sub)
    unint = sum(int(r['n.unint']) for r in sub)
    agfo = sum(int(r['n.agfo']) for r in sub)
    tot = sum(int(r['n.total']) for r in sub)
    pos = [r for r in sub if int(r['n.total']) > 0]
    npos = len(pos)
    share = gard / tot if tot else float('nan')          # (b) conditional share
    gpp = [int(r['n.gard']) for r in pos]                # (c) per-plot gard given presence
    rows_out.append(dict(habitat=h, plots=nplots, plots_occupied=npos,
                         occupancy_pct=100*npos/nplots,
                         gard=gard, unint=unint, agfo=agfo, total=tot,
                         gard_share_pct=100*share if tot else None,
                         gard_per_occupied_plot=(statistics.mean(gpp) if gpp else None),
                         gard_median_per_occupied=(statistics.median(gpp) if gpp else None),
                         max_gard_per_plot=max(int(r['n.gard']) for r in sub)))

# ---------- Print main table ----------
hdr = (f"{'habitat':22s} {'plots':>5s} {'occ':>4s} {'occ%':>6s} {'gard':>5s} "
       f"{'unint':>5s} {'agfo':>4s} {'tot':>5s} {'gard%':>6s} {'g/occ':>6s} {'medg':>5s} {'maxg':>4s}")
print("\n=== Per-habitat pathway table (core evidence) ===")
print(hdr)
for r in rows_out:
    gs = f"{r['gard_share_pct']:6.1f}" if r['gard_share_pct'] is not None else '   n/a'
    gpo = f"{r['gard_per_occupied_plot']:6.2f}" if r['gard_per_occupied_plot'] is not None else '   n/a'
    gm  = f"{r['gard_median_per_occupied']:5.1f}" if r['gard_median_per_occupied'] is not None else '  n/a'
    print(f"{r['habitat']:22s} {r['plots']:5d} {r['plots_occupied']:4d} {r['occupancy_pct']:6.1f} "
          f"{r['gard']:5d} {r['unint']:5d} {r['agfo']:4d} {r['total']:5d} {gs} {gpo} {gm} {r['max_gard_per_plot']:4d}")

grand_gard = sum(r['gard'] for r in rows_out)
grand_tot  = sum(r['total'] for r in rows_out)
print(f"\nGrand total: Gardening {grand_gard}/{grand_tot} = {100*grand_gard/grand_tot:.1f}% of all per-plot non-native records")

# ---------- Style classification ----------
print("\n=== Style contrast (conditional on n.total>0) ===")
abs_style  = [r for r in rows_out if r['gard'] >= 20]
dom_style  = [r for r in rows_out if r['gard_share_pct'] is not None and r['gard_share_pct'] >= 50 and r['gard'] < 20]
print("Absolute-flux habitats (gard>=20 records):", [r['habit at'] if False else r['habitat'] for r in abs_style])
print("Conditional-dominance habitats (share>=50%, small flux):", [r['habitat'] for r in dom_style])
print("Gardening-absent/marginal: Rock outcrops (0 records); Scrublands (2 records)")

# ---------- Support: species-level traits ----------
with open('data/invasion_success_pathways.csv') as f:
    species = list(csv.DictReader(f))
n_before = len(species)
species = [r for r in species if r['duplicated'] != 'TRUE']
print(f"\n=== invasion_success_pathways.csv ===")
print(f"rows {n_before} -> {len(species)} after dropping duplicated=TRUE rows "
      f"(Eucalyptus camaldulensis, Opuntia ficus-indica, Oxalis debilis, Populus deltoides; "
      f"conflicting intro.pathway across duplicates). habitat.range NOT equated with habitat categories.")
from collections import Counter
print("pathway counts (dedup):", dict(Counter(r['intro.pathway'] for r in species)))
def stats(metric, pw):
    vals = [float(r[metric]) for r in species if r['intro.pathway'] == pw]
    return (statistics.median(vals), statistics.mean(vals), len(vals))
for metric in ['number.of.invaded.plots','habitat.range','invaded.niche.breadth','mrt']:
    line = f"{metric:24s}"
    for pw in ['Gardening','Unintentional','AgriForest']:
        med, mean, n = stats(metric, pw)
        line += f"  {pw}: med {med:.2f} / mean {mean:.2f} (n={n})"
    print(line)

# ---------- Temporal context (secondary) ----------
with open('data/temporal_trends_contingency_table.csv') as f:
    temp = list(csv.DictReader(f, delimiter='\t'))
print("\n=== temporal_trends_contingency_table.csv (secondary context) ===")
periods = []
for p in dict.fromkeys(r['introduction.period'] for r in temp):
    sub = [int(r['n']) for r in temp if r['introduction.period'] == p]
    g = [int(r['n']) for r in temp if r['introduction.period'] == p and r['pathway'] == 'Gardening'][0]
    tot = sum(sub)
    periods.append((p, g, tot, 100*g/tot))
    print(f"{p:12s} Gardening {g:4d}/{tot:4d} = {100*g/tot:5.1f}%")

# ---------- Sensitivity: occupancy ----------
print("\n=== Sensitivity: occupancy (zero-total plots, effort unverifiable) ===")
print(f"Zero-total plots overall: {sum(1 for r in plots if int(r['n.total'])==0)}/{len(plots)}")
for r in rows_out:
    print(f"  {r['habitat']:22s} occupied {r['plots_occupied']}/{r['plots']} ({r['occupancy_pct']:.1f}%)")

# ---------- Save outputs ----------
with open('outputs/per_habitat_gardening_table.csv','w',newline='') as f:
    w = csv.DictWriter(f, fieldnames=list(rows_out[0].keys()))
    w.writeheader(); w.writerows(rows_out)
summary = dict(per_habitat=rows_out,
               grand=dict(gard=grand_gard, total=grand_tot,
                          share_pct=100*grand_gard/grand_tot),
               temporal=[dict(period=p, gard=g, total=t, share_pct=s) for p,g,t,s in periods])
with open('outputs/summary.json','w') as f:
    json.dump(summary, f, indent=2)
print("\nSaved: outputs/per_habitat_gardening_table.csv, outputs/summary.json")
