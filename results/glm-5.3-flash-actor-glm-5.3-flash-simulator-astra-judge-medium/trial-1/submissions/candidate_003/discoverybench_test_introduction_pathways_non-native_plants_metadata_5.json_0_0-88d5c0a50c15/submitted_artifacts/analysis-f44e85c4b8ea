"""
Urban land use and the type of plant invasion (Catalonia / Barcelona province).
Core test (researcher-approved): interaction urban x introduction pathway at plot level
(invaded_niche_pathways.csv), primary exposure = urban.2009.50m; buffers 50/500/1000 m and
years 1956/1993/2009 only as pre-declared sensitivity. Steps 4-6 are confirmatory.
"""
import itertools, math, re
import numpy as np
import pandas as pd
import statsmodels.api as sm
import statsmodels.formula.api as smf
from scipy import stats

pd.set_option('display.width', 200)
OUT = open('outputs/analysis_results.txt', 'w')
def say(*a):
    s = ' '.join(str(x) for x in a)
    print(s); OUT.write(s + '\n')

# ---------------------------------------------------------------- load
D = pd.read_csv('data/invaded_niche_pathways.csv', sep='\t')
S = pd.read_csv('data/invasion_success_pathways.csv')
T = pd.read_csv('data/temporal_trends_contingency_table.csv', sep='\t')
T['introduction.period'] = pd.Categorical(T['introduction.period'],
    categories=['Before 1500','1501-1900','1901-1984','1985-2019'], ordered=True)
D['plot'] = np.arange(len(D))

say("="*70); say("STEP 1. DESCRIPTIVES")
say("plots:", len(D), "| pathway totals:", {c:int(D[c].sum()) for c in ['n.gard','n.unint','n.agfo','n.total']},
    "| plots with n.total>0:", int((D['n.total']>0).sum()))
share_hab = D.groupby('habitat')[['n.gard','n.unint','n.agfo','n.total']].sum()
share_hab['gard_share'] = share_hab['n.gard']/share_hab['n.total'].replace(0,np.nan)
share_hab['unint_share'] = share_hab['n.unint']/share_hab['n.total'].replace(0,np.nan)
say("\nPathway counts and shares by habitat:")
say(share_hab.round(3).to_string())
say("\nMean urban/cropland by habitat (2009):")
say(D.groupby('habitat')[['urban.2009.50m','urban.2009.500m','urban.2009.1000m','cropland.2009.50m']].mean().round(3).to_string())
urb = D['urban.2009.50m']
q75 = urb.quantile(0.75)
hi, lo = urb >= q75, urb < q75
say(f"\nHigh-urban plots (urban.2009.50m >= {q75:.2f}, n={hi.sum()}): mean n.gard={D.loc[hi,'n.gard'].mean():.3f}, "
    f"n.unint={D.loc[hi,'n.unint'].mean():.3f}, n.agfo={D.loc[hi,'n.agfo'].mean():.3f}, n.total={D.loc[hi,'n.total'].mean():.3f}")
say(f"Rest (n={lo.sum()}): mean n.gard={D.loc[lo,'n.gard'].mean():.3f}, "
    f"n.unint={D.loc[lo,'n.unint'].mean():.3f}, n.agfo={D.loc[lo,'n.agfo'].mean():.3f}, n.total={D.loc[lo,'n.total'].mean():.3f}")
for c in ['n.gard','n.unint','n.agfo']:
    u, p = stats.mannwhitneyu(D.loc[hi,c], D.loc[lo,c], alternative='two-sided')
    say(f"MWU {c} hi vs lo urban: U={u:.0f}, p={p:.4g}")

# ---------------------------------------------------------------- core model
say("\n" + "="*70)
say("STEP 3 (CORE). Plot-level counts x pathway interaction, exposure urban.2009.50m")
COV = ['urban.2009.50m','cropland.2009.50m','elevation','distance.road']
def make_long(u, c_):
    l2 = D.melt(id_vars=['plot','habitat',u,c_,'elevation'], value_vars=['n.gard','n.unint','n.agfo'],
                var_name='pathway', value_name='count')
    l2 = l2.rename(columns={u:'urban', c_:'cropland'})
    l2['pathway'] = pd.Categorical(l2['pathway'].str.replace('n.','',regex=False),
                                   categories=['gard','unint','agfo'])
    return l2
F = 'count ~ C(pathway) * (urban + cropland + elevation) + C(habitat)'
long = make_long('urban.2009.50m','cropland.2009.50m')
pois = smf.glm(F, data=long, family=sm.families.Poisson()).fit(
    cov_type='cluster', cov_kwds={'groups': long['plot']})
pear = (pois.resid_pearson**2).sum()/pois.df_resid
say(f"Poisson GLM (cluster-robust by plot): Pearson chi2/df = {pear:.2f} (>>1 => overdispersion)")
main, fam = pois, "Poisson (cluster-robust)"
if pear > 2:
    try:
        nb = smf.negativebinomial(F, data=long).fit(cov_type='cluster',
            cov_kwds={'groups': long['plot']}, maxiter=500, disp=0)
        main, fam = nb, "NegativeBinomial (cluster-robust)"
    except Exception as e:
        say("NB failed:", e)
say("Main model family:", fam)
for term in ['C(pathway)[T.unint]:urban','C(pathway)[T.agfo]:urban','urban']:
    if term in main.params.index:
        b, se, p = main.params[term], main.bse[term], main.pvalues[term]
        say(f"  {term:34s} b={b:+.4f}  IRR={math.exp(b):.3f}  se={se:.4f}  p={p:.4g}")
say("\nFull coefficient table (p<0.1 shown):")
tbl = pd.DataFrame({'coef': main.params, 'se': main.bse, 'p': main.pvalues})
say(tbl[tbl.p < 0.1].round(4).to_string())
say("AIC:", round(main.aic,1))
names = list(main.params.index)
def contrast(m, c):
    nm = list(m.params.index); w = np.zeros(len(nm))
    for t, v in c.items(): w[nm.index(t)] = v
    est = float(w @ m.params.values); se = float(np.sqrt(w @ m.cov_params().values @ w))
    return est, se, 2*stats.norm.sf(abs(est/se))
c1 = contrast(main, {'urban': 1.0, 'C(pathway)[T.unint]:urban': -1.0})
c2 = contrast(main, {'urban': 1.0, 'C(pathway)[T.agfo]:urban': -1.0})
say(f"\nContrast urban effect Gardening - Unintentional: b={c1[0]:+.4f} (se {c1[1]:.4f}), p={c1[2]:.4g}")
say(f"Contrast urban effect Gardening - AgriForest:    b={c2[0]:+.4f} (se {c2[1]:.4f}), p={c2[2]:.4g}")

say("\nHurdle component — probability of presence per pathway (logit, urban.2009.50m):")
for p_ in ['n.gard','n.unint','n.agfo']:
    D['y'] = (D[p_]>0).astype(int)
    m = smf.logit('y ~ urban + cropland + elevation + C(habitat)', method='bfgs',
                  data=D.rename(columns={'urban.2009.50m':'urban','cropland.2009.50m':'cropland'})).fit(disp=0, maxiter=500)
    b, p = m.params['urban'], m.pvalues['urban']
    say(f"  {p_:8s} OR={math.exp(b):.2f}  b={b:+.3f}  p={p:.4g}")

# ---------------------------------------------------------------- sensitivity
say("\n" + "="*70)
say("SENSITIVITY. Urban effect per pathway across buffers x years (Poisson, cluster-robust)")
rows = []
for yr, buf in itertools.product(['1956','1993','2009'], ['50m','500m','1000m']):
    u = f'urban.{yr}.{buf}'; c_ = f'cropland.{yr}.{buf}'
    l2 = make_long(u, c_)
    m = smf.glm(F, data=l2, family=sm.families.Poisson()).fit(
        cov_type='cluster', cov_kwds={'groups': l2['plot']})
    nm = list(m.params.index)
    def cont(t, m=m, nm=nm):
        w = np.zeros(len(nm)); w[nm.index('urban')] = 1; w[nm.index(t)] = -1
        se = float(np.sqrt(w @ m.cov_params().values @ w)); est = float(w @ m.params.values)
        return 2*stats.norm.sf(abs(est/se))
    rows.append({'var': u, 'b_gard': m.params['urban'], 'p_gard': m.pvalues['urban'],
                 'b_g-u': m.params['urban']-m.params['C(pathway)[T.unint]:urban'],
                 'p_g-u': cont('C(pathway)[T.unint]:urban'),
                 'b_g-a': m.params['urban']-m.params['C(pathway)[T.agfo]:urban'],
                 'p_g-a': cont('C(pathway)[T.agfo]:urban')})
sens = pd.DataFrame(rows)
say(sens.round(4).to_string(index=False))
say("Direction stability of gard-vs-unint contrast: ",
    int((sens['b_g-u']>0).sum()), "/ 9 positive;",
    " significant at 0.05:", int((sens['p_g-u']<0.05).sum()), "/ 9")

# ---------------------------------------------------------------- STEP 4. change categories & urban delta
say("\n" + "="*70)
say("STEP 4 (confirmatory). Landscape change 1956-2009 / 1993-2009 (50m)")
D = D.rename(columns={'progressive.1956.2009.50m':'progressive1956','regressive.1956.2009.50m':'regressive1956',
                      'progressive.1993.2009.50m':'progressive1993','regressive.1993.2009.50m':'regressive1993'})
for cc in ['n.gard','n.unint','n.agfo']: D[cc.replace('.','_')] = D[cc]
D['urban.delta.50m'] = D['urban.2009.50m'] - D['urban.1956.50m']
D['cropland.delta.50m'] = D['cropland.2009.50m'] - D['cropland.1956.50m']
for tgt, lab in [('n_gard','Gardening'), ('n_unint','Unintentional'), ('n_agfo','AgriForest')]:
    m = smf.glm(f'{tgt} ~ progressive1956 + regressive1956 + C(habitat) + elevation',
                data=D, family=sm.families.Poisson()).fit(cov_type='cluster', cov_kwds={'groups': D['plot']})
    say(f"  {lab:14s} b(progressive)={m.params['progressive1956']:+.3f} "
        f"(p={m.pvalues['progressive1956']:.3g}), b(regressive)={m.params['regressive1956']:+.3f} "
        f"(p={m.pvalues['regressive1956']:.3g})")
say("Urban-increase specific (delta urban 1956-2009, controlling delta cropland):")
for tgt, lab in [('n_gard','Gardening'), ('n_unint','Unintentional'), ('n_agfo','AgriForest')]:
    m = smf.glm(f'{tgt} ~ urban_delta + cropland_delta + C(habitat) + elevation',
                data=D.rename(columns={'urban.delta.50m':'urban_delta','cropland.delta.50m':'cropland_delta'}),
                family=sm.families.Poisson()).fit(cov_type='cluster', cov_kwds={'groups': D['plot']})
    say(f"  {lab:14s} b(delta urban)={m.params['urban_delta']:+.3f} (p={m.pvalues['urban_delta']:.3g}), "
        f"b(delta cropland)={m.params['cropland_delta']:+.3f} (p={m.pvalues['cropland_delta']:.3g})")

# ---------------------------------------------------------------- STEP 5. species level + phylogeny
say("\n" + "="*70)
say("STEP 5 (confirmatory). Species-level invasion success by pathway (n=81 rows)")
S['log.plots'] = np.log1p(S['number.of.invaded.plots'])
for v in ['number.of.invaded.plots','area.of.occupancy.10km','invaded.niche.breadth','habitat.range','mrt']:
    groups = [S.loc[S['intro.pathway']==p_, v] for p_ in ['Gardening','Unintentional','AgriForest']]
    H, p = stats.kruskal(*groups)
    med = {p_: round(float(S.loc[S['intro.pathway']==p_, v].median()),2) for p_ in ['Gardening','Unintentional','AgriForest']}
    say(f"  {v:28s} KW H={H:.2f}, p={p:.3g} | medians {med}")

def parse_newick(s):
    s = s.strip().rstrip(';'); pos = 0
    def node():
        nonlocal pos
        children = []
        if s[pos] == '(':
            pos += 1
            while True:
                children.append(node())
                if s[pos] == ',': pos += 1
                else: pos += 1; break
        st = pos
        while pos < len(s) and s[pos] not in '(),:;': pos += 1
        label = s[st:pos]; length = 0.0
        if pos < len(s) and s[pos] == ':':
            pos += 1; st = pos
            while pos < len(s) and s[pos] not in '(),;': pos += 1
            length = float(s[st:pos])
        return {'children': children, 'label': label, 'length': length}
    return node()
tree = parse_newick(open('data/phylogenetic_tree.txt').read())
tips, paths = [], {}
def walk(nd, path):
    path = path + [(id(nd), path[-1][1] + nd['length'] if path else nd['length'])]
    if not nd['children']:
        tips.append(nd['label']); paths[nd['label']] = dict(path)
    for ch in nd['children']: walk(ch, path)
walk(tree, [])
labels = [t for t in tips if t in set(S['phylo.tip.label'])]
say(f"\nTips matched to species table: {len(labels)} (of {len(tips)} tree tips)")
idx = {t:i for i,t in enumerate(labels)}
V = np.zeros((len(labels), len(labels)))
for a, b in itertools.combinations_with_replacement(labels, 2):
    pa, pb = paths[a], paths[b]
    d = max(d for k, d in pa.items() if k in pb)
    V[idx[a], idx[b]] = V[idx[b], idx[a]] = d
V += np.eye(len(V))*1e-6
Ssub = S[S['phylo.tip.label'].isin(idx)].set_index('phylo.tip.label').loc[labels]
Xp = pd.get_dummies(Ssub['intro.pathway'], drop_first=True).astype(float)
Xp.insert(0, 'const', 1.0)
Xp['mrt'] = (Ssub['mrt'] - Ssub['mrt'].mean())/Ssub['mrt'].std()
for resp, lab in [('log.plots','log1p(#invaded plots)'), ('invaded.niche.breadth','invaded niche breadth')]:
    gl = sm.GLS(Ssub[resp].astype(float).values, Xp.values, sigma=V).fit()
    say(f"\nPGLS (phylo GLS) {lab} ~ pathway + mrt:")
    for n_, coef, pv, sv in zip(list(Xp.columns), gl.params, gl.pvalues, gl.bse):
        if n_ != 'const':
            say(f"  {n_:14s} b={coef:+.3f} (se {sv:.3f}), p={pv:.4g}")
say("(PGLS exploratory: tree includes Open-Tree backbone nodes; V = root-to-MRCA depth.)")

# ---------------------------------------------------------------- STEP 6. temporal trends
say("\n" + "="*70)
say("STEP 6 (context). Temporal trends in introduction pathways (Catalonia)")
T['prop'] = T.groupby('introduction.period')['n'].transform(lambda x: x/x.sum())
say(T.pivot(index='introduction.period', columns='pathway', values='n').to_string())
say("\nProportions per period:")
say(T.pivot(index='introduction.period', columns='pathway', values='prop').round(3).to_string())
ct = T.pivot(index='introduction.period', columns='pathway', values='n').values
chi2, p, dof, _ = stats.chi2_contingency(ct)
say(f"Chi-square pathway x period: chi2={chi2:.1f}, dof={dof}, p={p:.3g}")
gd = T.pivot(index='introduction.period', columns='pathway', values='prop')['Gardening'].values
say(f"Gardening share: {gd[0]:.3f} (Before 1500) -> {gd[1]:.3f} -> {gd[2]:.3f} -> {gd[3]:.3f} (1985-2019)")
OUT.close()
print("\nDONE")
