"""
What types of plant introductions were influenced by urban land use?
Pathway composition (Gardening / Unintentional / AgriForest) vs. urban land use,
Barcelona province plots (invaded_niche_pathways.csv, 632 plots, 481 records).
Approach (researcher-approved):
  - Multinomial logistic regression, baseline = Unintentional, cluster-robust SE by plot.
  - Model A: presence-only plots (n=191, 481 records).
  - Model B: all 632 plots, 4-category MNLogit with 'Absent' category.
  - Sensitivity: 3 years (1956/1993/2009) x 3 buffers (50/500/1000 m).
  - Model C: landscape-change covariates (progressive/regressive, 1956-2009, 50 m).
  - Temporal contingency table as corroboration; phylogenetic note only.
"""
import numpy as np, pandas as pd, statsmodels.api as sm
from scipy import stats
pd.set_option('display.width', 220)

inp = pd.read_csv('data/invaded_niche_pathways.csv', sep='\t')
assert (inp['n.gard'] + inp['n.unint'] + inp['n.agfo'] == inp['n.total']).all()

PATHS = ['Unintentional', 'Gardening', 'AgriForest']   # 0 = baseline
COUNT = {'Gardening': 'n.gard', 'Unintentional': 'n.unint', 'AgriForest': 'n.agfo'}

def expand(df, include_absent):
    rows = []
    for i, r in df.iterrows():
        for lab, col in COUNT.items():
            rows += [{'plot': i, 'pathway': lab, 'habitat': r['habitat'],
                      'urban': r['urban.2009.50m'], 'cropland': r['cropland.2009.50m'],
                      'elev_km': r['elevation']/1000., 'rain_m': r['annual.rainfall']/1000.,
                      'dist_road_km': r['distance.road']/1000.}]*int(r[col])
        if include_absent and r['n.total'] == 0:
            rows.append({'plot': i, 'pathway': 'Absent', 'habitat': r['habitat'],
                         'urban': r['urban.2009.50m'], 'cropland': r['cropland.2009.50m'],
                         'elev_km': r['elevation']/1000., 'rain_m': r['annual.rainfall']/1000.,
                         'dist_road_km': r['distance.road']/1000.})
    return pd.DataFrame(rows)

CATS = PATHS + ['Absent']
def fit_mnl(recs, urban_col=None, cropland_col=None, extra=None):
    d = recs.copy()
    if urban_col: d['urban'] = inp.loc[d['plot'], urban_col].values
    if cropland_col: d['cropland'] = inp.loc[d['plot'], cropland_col].values
    if extra:
        for c in extra: d[c] = inp.loc[d['plot'], c].values
    X = pd.get_dummies(d[['urban','cropland','elev_km','rain_m','dist_road_km','habitat'] +
                         (extra or [])], columns=['habitat'], drop_first=True).astype(float)
    X = sm.add_constant(X)
    y = pd.Categorical(d['pathway'], categories=CATS)
    res = sm.MNLogit(y, X).fit(method='lbfgs', maxiter=2000, disp=0,
                               cov_type='cluster', cov_kwds={'groups': d['plot']})
    obs = [c for c in CATS[1:] if (d['pathway'] == c).any()]
    return res, obs

def show(res, colnames, label, vars_):
    print(f"\n{label}  (converged={res.mle_retvals['converged']}, pseudoR2={res.prsquared:.3f}, "
          f"n_records={res.nobs:.0f})")
    for j, cat in enumerate(colnames):
        for v in vars_:
            if v in res.params.index:
                print(f"  {cat:>12} vs Unintentional | {v:28s} coef={res.params.loc[v, j]:+.3f} "
                      f"OR={np.exp(res.params.loc[v, j]):.2f} p={res.pvalues.loc[v, j]:.4f}")

# ---------------- descriptives ----------------
print("="*100); print("DESCRIPTIVES (invaded_niche_pathways)")
tot = {k: int(inp[c].sum()) for k, c in COUNT.items()}
print("records per pathway:", tot, "| total", int(inp['n.total'].sum()),
      "| plots with records:", int((inp['n.total']>0).sum()))
pres = inp[inp['n.total']>0]
print("mean urban cover 2009/50m: plots with records %.3f vs empty plots %.3f" %
      (pres['urban.2009.50m'].mean(), inp[inp['n.total']==0]['urban.2009.50m'].mean()))
print("mean urban cover 1956/50m: %.3f vs %.3f" %
      (pres['urban.1956.50m'].mean(), inp[inp['n.total']==0]['urban.1956.50m'].mean()))
pres2 = pres.copy()
pres2['dom'] = pres2[['n.gard','n.unint','n.agfo']].idxmax(axis=1).map(
    {'n.gard':'Gardening','n.unint':'Unintentional','n.agfo':'AgriForest'})
pres2['uq'] = pd.qcut(pres2['urban.2009.50m'].rank(method='first'), 3, labels=['low','mid','high'])
ct = pd.crosstab(pres2['uq'], pres2['dom'])
chi2, pchi, dof, _ = stats.chi2_contingency(ct)
print("\nDominant pathway x urban tercile (presence-only):\n", ct)
print(f"chi2={chi2:.2f}, dof={dof}, p={pchi:.4f}")
print("Habitats containing any non-native record:",
      sorted(pres['habitat'].unique()))

# raw record-level urban means (diagnostic)
print("\nMean urban.2009.50m of plots contributing records, by pathway:")
recA_dbg = expand(pres, False)
print(recA_dbg.groupby('pathway')['urban'].agg(['count','mean','median']).round(3).to_string())
print("\nMean urban by tercile for Gardening-vs-Unint check (records):")
print(pd.crosstab(recA_dbg['pathway'], recA_dbg['urban'].rank(method='first').pipe(
    lambda x: pd.qcut(x, 3, labels=['low','mid','high']))).to_string())

# ---------------- Model A ----------------
recA, colA = expand(pres, False), PATHS[1:]
print("\n" + "="*100)
resA, colsA = fit_mnl(recA)
show(resA, colsA, "MODEL A: presence-only (191 plots, 481 records), urban.2009.50m",
     ['urban','cropland'])

# quadratic urban term (presence-only): is the association non-monotonic?
dA = recA.copy(); dA['urban2'] = inp.loc[dA['plot'],'urban.2009.50m'].values**2
X = sm.add_constant(pd.get_dummies(dA[['urban','urban2','cropland','elev_km','rain_m','dist_road_km','habitat']],
                                    columns=['habitat'], drop_first=True).astype(float))
y = pd.Categorical(dA['pathway'], categories=CATS)
resQ = sm.MNLogit(y, X).fit(method='lbfgs', maxiter=2000, disp=0, cov_type='cluster', cov_kwds={'groups': dA['plot']})
show(resQ, colsA, "MODEL A-quad: presence-only with urban + urban^2 (2009/50m)", ['urban','urban2'])

# ---------------- Model B ----------------
print("\n" + "="*100)
recB = expand(inp, True)
resB, colsB = fit_mnl(recB)
show(resB, colsB, "MODEL B: all 632 plots (4-category incl. Absent), urban.2009.50m",
     ['urban','cropland'])

# ---------------- sensitivity ----------------
print("\n" + "="*100)
print("SENSITIVITY: urban coef (Gardening vs Unintentional) across year x buffer")
rows = []
for yr in ['1956','1993','2009']:
    for b in ['50m','500m','1000m']:
        u, c = f'urban.{yr}.{b}', f'cropland.{yr}.{b}'
        rA, cA = fit_mnl(recA, u, c)
        rB, cB = fit_mnl(recB, u, c)
        for nm, r, cols in [('A presence-only', rA, cA), ('B all-plots', rB, cB)]:
            j = cols.index('Gardening')
            rows.append({'model': nm, 'year': yr, 'buffer': b,
                         'coef_gard_vs_unint': r.params.loc['urban', j],
                         'OR': np.exp(r.params.loc['urban', j]),
                         'p': r.pvalues.loc['urban', j]})
sens = pd.DataFrame(rows)
print(sens.to_string(index=False, float_format=lambda x: f"{x:.4f}"))
a = sens[sens.model=='A presence-only']['coef_gard_vs_unint']
b = sens[sens.model=='B all-plots']['coef_gard_vs_unint']
print(f"positive in {int((a>0).sum())}/9 (A) and {int((b>0).sum())}/9 (B); "
      f"significant p<0.05 in {int((sens[sens.model=='A presence-only'].p<0.05).sum())}/9 (A), "
      f"{int((sens[sens.model=='B all-plots'].p<0.05).sum())}/9 (B)")

# ---------------- Model C: landscape change ----------------
print("\n" + "="*100)
resC, colsC = fit_mnl(recA, extra=['progressive.1956.2009.50m','regressive.1956.2009.50m'])
show(resC, colsC, "MODEL C: presence-only, landscape change 1956-2009 50m (plus urban/cropland 2009)",
     ['urban','cropland','progressive.1956.2009.50m','regressive.1956.2009.50m'])
resC2, _ = fit_mnl(recA, urban_col=None, cropland_col=None,
                   extra=['progressive.1956.2009.50m','regressive.1956.2009.50m','urban.2009.50m'])
show(resC2, colsC, "MODEL C2: presence-only, change cols only (no cropland col)",
     ['urban','progressive.1956.2009.50m','regressive.1956.2009.50m'])

# ---------------- temporal corroboration ----------------
print("\n" + "="*100)
print("TEMPORAL CONTINGENCY TABLE (Catalonia-wide, corroboration only)")
tt = pd.read_csv('data/temporal_trends_contingency_table.csv', sep='\t')
piv = tt.pivot(index='introduction.period', columns='pathway', values='n')[['AgriForest','Gardening','Unintentional']]
piv['Gardening.share'] = piv['Gardening']/piv.sum(axis=1)
print(piv.to_string(float_format=lambda x: f"{x:.3f}"))

# ---------------- phylo note ----------------
print("\n" + "="*100)
print("PHYLO NOTE (secondary)")
isp = pd.read_csv('data/invasion_success_pathways.csv')
print("species per pathway:", isp['intro.pathway'].value_counts().to_dict())
print("distinct families per pathway:", isp.groupby('intro.pathway')['family'].nunique().to_dict())

# ---------------- save ----------------
with pd.ExcelWriter('outputs/results.xlsx') as w:
    ct.to_excel(w, sheet_name='dom_pathway_x_urban_tercile')
    pd.DataFrame({'contrast': [f'{c} vs Unint' for c in colsA for _ in range(2)],
                  'var': ['urban','cropland']*len(colsA),
                  'coef': [resA.params.loc[v, j] for j in range(len(colsA)) for v in ['urban','cropland']],
                  'p': [resA.pvalues.loc[v, j] for j in range(len(colsA)) for v in ['urban','cropland']]}
                 ).to_excel(w, sheet_name='modelA', index=False)
    sens.to_excel(w, sheet_name='sensitivity_urban', index=False)
    piv.to_excel(w, sheet_name='temporal_shares')
recA_dbg.groupby('pathway')['urban'].agg(['count','mean','median']).round(4).to_excel(w, sheet_name='urban_by_pathway')
print("\nSaved outputs/results.xlsx")
