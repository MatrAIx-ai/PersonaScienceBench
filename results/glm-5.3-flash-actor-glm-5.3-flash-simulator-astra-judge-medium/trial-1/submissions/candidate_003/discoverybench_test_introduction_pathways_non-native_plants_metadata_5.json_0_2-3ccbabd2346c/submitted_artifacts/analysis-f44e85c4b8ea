"""
Urban land use vs introduction pathway of non-native plants (Barcelona province / Catalonia).
Primary test: long-format count GLM, count ~ pathway * urban.2009.500m + controls,
cluster-robust SE by plot. AgriForest is the reference pathway so Gardening:urban and
Unintentional:urban are contrasts vs AgriForest.
"""
import numpy as np
import pandas as pd
import statsmodels.api as sm
import statsmodels.formula.api as smf
from scipy import stats
from statsmodels.stats.outliers_influence import variance_inflation_factor

pd.set_option("display.width", 220)
pd.set_option("display.max_columns", 50)

tt  = pd.read_csv("data/temporal_trends_contingency_table.csv", sep="\t")
isv = pd.read_csv("data/invasion_success_pathways.csv")
inv = pd.read_csv("data/invaded_niche_pathways.csv", sep="\t")

# rename dotted columns to underscore names for patsy formulas
inv.columns = [c.replace(".", "_") for c in inv.columns]

CONTROLS = ["elevation", "annual_temperature", "annual_rainfall",
            "distance_road", "distance_stream"]
HAB = "C(habitat)"

def long_format(df, urban_col, crop_col):
    d = pd.melt(df, id_vars=["habitat"] + CONTROLS + [urban_col, crop_col],
                value_vars=["n_gard", "n_unint", "n_agfo"],
                var_name="pathway_raw", value_name="count")
    d["pathway"] = d["pathway_raw"].map(
        {"n_gard": "Gardening", "n_unint": "Unintentional", "n_agfo": "AgriForest"})
    d["pathway"] = pd.Categorical(d["pathway"],
                                  categories=["AgriForest", "Gardening", "Unintentional"],
                                  ordered=True)
    return d

def fit_long(df, urban_col, crop_col, family="poisson"):
    d = long_format(df, urban_col, crop_col)
    f = ("count ~ C(pathway) * " + urban_col + " + " + crop_col + " + "
         + HAB + " + " + " + ".join(CONTROLS))
    if family == "poisson":
        mod = smf.glm(f, data=d, family=sm.families.Poisson())
        res = mod.fit(cov_type="cluster", cov_kwds={"groups": d.index // 3})
    else:  # negative binomial
        mod = smf.glm(f, data=d, family=sm.families.NegativeBinomial(alpha=1.0))
        res = mod.fit(cov_type="cluster", cov_kwds={"groups": d.index // 3})
    return res, d, f

print("=" * 100)
print("SECTION 0: overdispersion diagnostic (n.total)")
print("=" * 100)
m, v = inv["n_total"].mean(), inv["n_total"].var()
print(f"n_total mean={m:.3f}, variance={v:.3f}, var/mean={v/m:.2f}  (>1 => overdispersion)")

print()
print("=" * 100)
print("SECTION 1: PRIMARY long-format model (Poisson GLM, cluster-robust by plot)")
print("           count ~ C(pathway) * urban_2009_500m + cropland_2009_500m + habitat + controls")
print("=" * 100)
res_p, d_long, f = fit_long(inv, "urban_2009_500m", "cropland_2009_500m", "poisson")
print("formula:", f)
print(f"n obs = {int(res_p.nobs)},  deviance = {res_p.deviance:.1f}, "
      f"df_resid = {res_p.df_resid}")
print(res_p.summary().tables[1])

print("\nKey interaction contrasts (vs AgriForest reference):")
key = ["C(pathway)[T.Gardening]:urban_2009_500m",
       "C(pathway)[T.Unintentional]:urban_2009_500m",
       "urban_2009_500m"]
for k in key:
    if k in res_p.params.index:
        print(f"  {k:55s} beta = {res_p.params[k]: .4f}  "
              f"SE = {res_p.bse[k]:.4f}  z = {res_p.tvalues[k]: .2f}  p = {res_p.pvalues[k]:.4g}")

print("\nRobustness: Negative-binomial long model, same formula")
res_nb, _, _ = fit_long(inv, "urban_2009_500m", "cropland_2009_500m", "nb")
for k in key:
    if k in res_nb.params.index:
        print(f"  {k:55s} beta = {res_nb.params[k]: .4f}  "
              f"SE = {res_nb.bse[k]:.4f}  z = {res_nb.tvalues[k]: .2f}  p = {res_nb.pvalues[k]:.4g}")

print()
print("=" * 100)
print("SECTION 2: SUPPORTING per-pathway count GLMs (urban_2009_500m), Poisson, cluster-robust")
print("=" * 100)
rows = []
for pw, col in [("Gardening", "n_gard"), ("Unintentional", "n_unint"), ("AgriForest", "n_agfo")]:
    f2 = (f"{col} ~ urban_2009_500m + cropland_2009_500m + " + HAB +
          " + " + " + ".join(CONTROLS))
    r = smf.glm(f2, data=inv, family=sm.families.Poisson()).fit(
        cov_type="HC1")
    rows.append({"pathway": pw, "n_occurrence_plots": int((inv[col] > 0).sum()),
                 "total_count": int(inv[col].sum()),
                 "urban_beta": r.params["urban_2009_500m"],
                 "urban_SE": r.bse["urban_2009_500m"],
                 "urban_p": r.pvalues["urban_2009_500m"],
                 "urban_IRR": np.exp(r.params["urban_2009_500m"])})
    print(f"\n-- {pw} ({col}) --")
    print(f"   urban_2009_500m beta = {r.params['urban_2009_500m']:.4f} "
          f"(SE {r.bse['urban_2009_500m']:.4f}, p = {r.pvalues['urban_2009_500m']:.4g}); "
          f"IRR = {np.exp(r.params['urban_2009_500m']):.3f}")
    print(f"   cropland_2009_500m beta = {r.params['cropland_2009_500m']:.4f} "
          f"(p = {r.pvalues['cropland_2009_500m']:.4g})")
per_pathway = pd.DataFrame(rows)
print("\n", per_pathway.round(4).to_string(index=False))

print()
print("=" * 100)
print("SECTION 3: AgriForest robustness — presence/absence logistic (all three pathways)")
print("=" * 100)
for pw, col in [("Gardening", "n_gard"), ("Unintentional", "n_unint"), ("AgriForest", "n_agfo")]:
    inv[f"pres_{col}"] = (inv[col] > 0).astype(int)
    f3 = (f"pres_{col} ~ urban_2009_500m + cropland_2009_500m + " + HAB +
          " + " + " + ".join(CONTROLS))
    r = smf.glm(f3, data=inv, family=sm.families.Binomial()).fit(cov_type="HC1")
    print(f"-- {pw}: presence ~ urban_2009_500m ... "
          f"beta = {r.params['urban_2009_500m']: .4f} (SE {r.bse['urban_2009_500m']:.4f}, "
          f"p = {r.pvalues['urban_2009_500m']:.4g}), OR = {np.exp(r.params['urban_2009_500m']):.3f}")

print()
print("=" * 100)
print("SECTION 4: SENSITIVITY GRID — interaction coefficients across buffers/years")
print("           (long model, Poisson + cluster-robust; Gardening:urban and Unintentional:urban vs AgriForest)")
print("=" * 100)
grid_rows = []
for buf in ["50m", "500m", "1000m"]:
    for yr in ["1956", "1993", "2009"]:
        u, c = f"urban_{yr}_{buf}", f"cropland_{yr}_{buf}"
        r, _, _ = fit_long(inv, u, c, "poisson")
        for pw in ["Gardening", "Unintentional"]:
            k = f"C(pathway)[T.{pw}]:{u}"
            grid_rows.append({"buffer": buf, "year": yr, "contrast": f"{pw}:urban vs AgriForest",
                              "beta": r.params[k], "SE": r.bse[k],
                              "z": r.tvalues[k], "p": r.pvalues[k],
                              "urban_main_beta": r.params[u]})
grid = pd.DataFrame(grid_rows)
print(grid.round(4).to_string(index=False))

print()
print("=" * 100)
print("SECTION 5: VIF check (numeric predictors of the primary design)")
print("=" * 100)
X = inv[["urban_2009_500m", "cropland_2009_500m", "elevation",
         "annual_temperature", "annual_rainfall", "distance_road", "distance_stream"]].copy()
X = sm.add_constant(X)
vif = pd.DataFrame({"term": X.columns,
                    "VIF": [variance_inflation_factor(X.values, i) for i in range(X.shape[1])]})
print(vif.round(2).to_string(index=False))
print(f"\nPearson r(urban_2009_500m, cropland_2009_500m) = "
      f"{inv['urban_2009_500m'].corr(inv['cropland_2009_500m']):.3f}")

print()
print("=" * 100)
print("SECTION 6: Landscape-change models (compositional shares, 50 m buffers)")
print("           count ~ C(pathway) * (progressive + regressive) + controls")
print("=" * 100)
for per in ["1956_2009", "1993_2009"]:
    prog, regr = f"progressive_{per}_50m", f"regressive_{per}_50m"
    d = pd.melt(inv, id_vars=["habitat"] + CONTROLS + [prog, regr],
                value_vars=["n_gard", "n_unint", "n_agfo"],
                var_name="pathway_raw", value_name="count")
    d["pathway"] = pd.Categorical(
        d["pathway_raw"].map({"n_gard": "Gardening", "n_unint": "Unintentional", "n_agfo": "AgriForest"}),
        categories=["AgriForest", "Gardening", "Unintentional"], ordered=True)
    f4 = f"count ~ C(pathway) * ({prog} + {regr}) + {HAB} + " + " + ".join(CONTROLS)
    r = smf.glm(f4, data=d, family=sm.families.Poisson()).fit(
        cov_type="cluster", cov_kwds={"groups": d.index // 3})
    print(f"\n-- period {per} --")
    for pw in ["Gardening", "Unintentional"]:
        for term in [prog, regr]:
            k = f"C(pathway)[T.{pw}]:{term}"
            if k in r.params.index:
                print(f"   {k:60s} beta = {r.params[k]: .4f} (p = {r.pvalues[k]:.4g})")

print()
print("=" * 100)
print("SECTION 7: Species-level supporting analysis (invasion_success, de-duplicated to 77 species)")
print("           CONVENTION: drop the four '2'-suffixed duplicated-tip rows; keep the original")
print("           species row, so counts equal the recorded number.of.invaded.plots.")
print("=" * 100)
sp = isv[~isv["duplicated"]].copy()
print(f"rows kept: {len(sp)} (81 - 4 duplicated tips)")
traits_num = ["number_of_invaded_plots", "invaded_niche_breadth", "mrt",
              "native_niche_breadth", "habitat_range"]
sp.columns = [c.replace(".", "_") for c in sp.columns]
for t in traits_num:
    groups = [sp.loc[sp["intro_pathway"] == pw, t] for pw in ["Gardening", "Unintentional", "AgriForest"]]
    H, p = stats.kruskal(*groups)
    med = sp.groupby("intro_pathway")[t].median()
    print(f"  {t:26s} Kruskal-Wallis H = {H:6.2f}, p = {p:.4g} | "
          f"medians G/U/A = {med.get('Gardening'):.2f}/{med.get('Unintentional'):.2f}/{med.get('AgriForest'):.2f}")
print("\n  growth.form x intro.pathway (counts, 77 species):")
print(pd.crosstab(sp["growth_form"], sp["intro_pathway"]).to_string())
chi2, pchi, dof, _ = stats.chi2_contingency(pd.crosstab(sp["growth_form"], sp["intro_pathway"]))
print(f"  chi-square = {chi2:.2f}, df = {dof}, p = {pchi:.4g}")
print("\n  dispersal x intro.pathway (counts, 77 species):")
print(pd.crosstab(sp["dispersal"], sp["intro_pathway"]).to_string())
chi2, pchi, dof, _ = stats.chi2_contingency(pd.crosstab(sp["dispersal"], sp["intro_pathway"]))
print(f"  chi-square = {chi2:.2f}, df = {dof}, p = {pchi:.4g}")

print()
print("=" * 100)
print("SECTION 8: Temporal context (introduction shares per period)")
print("=" * 100)
piv = tt.pivot(index="introduction.period", columns="pathway", values="n")
piv["total"] = piv.sum(axis=1)
for c in ["AgriForest", "Gardening", "Unintentional"]:
    piv[f"{c}_share"] = piv[c] / piv["total"]
print(piv.round(3).to_string())

print()
print("=" * 100)
print("SECTION 9: Descriptive means of pathway counts by habitat and urban tertile")
print("=" * 100)
inv["urban_tertile"] = pd.qcut(inv["urban_2009_500m"], 3,
                               labels=["low(<=0.00)", "mid", "high"])
print(inv.groupby("urban_tertile", observed=True)[["n_gard", "n_unint", "n_agfo", "n_total"]].mean().round(3).to_string())
print()
print(inv.groupby("habitat")[["n_gard", "n_unint", "n_agfo", "n_total"]].mean().round(3).to_string())

# save key outputs
grid.to_csv("results/sensitivity_grid.csv", index=False)
per_pathway.to_csv("results/per_pathway_models.csv", index=False)
vif.to_csv("results/vif.csv", index=False)
res_p.summary().tables[1].as_csv() and open("results/primary_model_coefs.csv","w").write(res_p.summary().tables[1].as_csv())
print("\nSaved: results/sensitivity_grid.csv, results/per_pathway_models.csv, results/vif.csv, results/primary_model_coefs.csv")
