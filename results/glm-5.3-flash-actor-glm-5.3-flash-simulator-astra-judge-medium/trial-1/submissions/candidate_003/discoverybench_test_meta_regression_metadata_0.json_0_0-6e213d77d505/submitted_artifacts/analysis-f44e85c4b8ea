"""
Analysis: For which domains (Social, Cognitive, Economics) are original-study
effect size estimates larger than replication estimates?

Data: meta-regression_joined_data_heterogeneity_in_replication_projects.csv
(merge of data.csv + RProjects.csv; heterogeneity-in-replication-projects meta-regression dataset)

Primary scale: Fisher-z (fiso/fisr). "Larger" = larger absolute magnitude.
|fiso|>|fisr| and fiso>fisr coincide for 100% of rows (verified below), because
every original effect is positive and replication |fisher-z| never exceeds the
original when positive.
"""
import pandas as pd
import numpy as np

rng = np.random.default_rng(42)
DATA = 'data/meta-regression_joined_data_heterogeneity_in_replication_projects.csv'

df = pd.read_csv(DATA, na_values=['NA', ''])

# ---------- 0. Data hygiene ----------
n_rows, n_cols = df.shape
dup_rows = df.duplicated().sum()
dup_study = df['study'].duplicated().sum()
key_na = df[['study','ro','rr','fiso','fisr','se_fiso','se_fisr','discipline']].isna().sum().sum()
print(f"rows={n_rows}, cols={n_cols}, duplicate rows={dup_rows}, duplicate studies={dup_study}, "
      f"missing key cells={key_na}")

# scale consistency
assert (df['fiso'] - np.arctanh(df['ro'])).abs().max() < 1e-9
assert (df['fisr'] - np.arctanh(df['rr'])).abs().max() < 1e-9
print("scale check OK: fiso=atanh(ro), fisr=atanh(rr) (max dev < 1e-9)")

# algebraic vs absolute comparison coincide?
mismatch = ((df['fiso'] > df['fisr']) != (df['fiso'].abs() > df['fisr'].abs())).sum()
print(f"rows where algebraic != absolute comparison: {mismatch}")

# relative_es anomaly
re_exp = df['rr'] / df['ro']
anom = df[(df['relative_es'] - re_exp).abs() > 1e-6]
print("\nrelative_es anomalies (relative_es != rr/ro):")
print(anom[['study','discipline','ro','rr','relative_es']].assign(rr_over_ro=re_exp[anom.index].round(3)).to_string(index=False))
print("-> 1 row: 'B Eitam, RR Hassin, Y Schul': relative_es=-0.472 vs rr/ro=+0.472 (sign flip, magnitude identical). Documented, not trusted as source of truth.")

# ---------- (a) per-discipline descriptives with bootstrap CIs ----------
df['d_fis'] = df['fiso'] - df['fisr']
df['d_r'] = df['ro'] - df['rr']
df['abs_orig_larger'] = df['fiso'].abs() > df['fisr'].abs()

def boot_ci(x, stat, B=20000):
    x = np.asarray(x, float)
    idx = rng.integers(0, len(x), size=(B, len(x)))
    s = stat(x[idx], axis=1)
    return np.percentile(s, [2.5, 97.5])

def analyse(frame, dcol, label):
    rows = []
    for dom, g in frame.groupby('discipline'):
        d = g[dcol].values
        m_lo, m_hi = boot_ci(d, np.mean)
        md_lo, md_hi = boot_ci(d, np.median)
        rows.append({
            'domain': dom, 'n': len(g),
            'mean_d': np.mean(d), 'mean_d_CI': f"[{m_lo:.3f}, {m_hi:.3f}]",
            'median_d': np.median(d), 'median_d_CI': f"[{md_lo:.3f}, {md_hi:.3f}]",
            'pct_abs_orig_larger': 100*np.mean(g['abs_orig_larger']),
        })
    out = pd.DataFrame(rows).set_index('domain').round(3)
    print(f"\n=== (a) {label}: d = original - replication by discipline ===")
    print(out.to_string())
    return out

tab_fis = analyse(df, 'd_fis', 'Fisher-z scale (primary)')

# ---------- (b) pairwise between-domain comparisons ----------
from itertools import combinations
print("\n=== (b) pairwise comparisons of d (Fisher-z) between domains ===")
res_b = []
doms = sorted(df['discipline'].unique())
for a, b in combinations(doms, 2):
    xa = df.loc[df['discipline'] == a, 'd_fis'].values
    xb = df.loc[df['discipline'] == b, 'd_fis'].values
    # Mann-Whitney U (two-sided, no normality assumption)
    try:
        from scipy.stats import mannwhitneyu
        u, p_mw = mannwhitneyu(xa, xb, alternative='two-sided')
    except ImportError:
        u, p_mw = np.nan, np.nan
    # permutation test on mean difference
    obs = xa.mean() - xb.mean()
    pool = np.concatenate([xa, xb]); na = len(xa)
    perms = np.array([pool[rng.permutation(len(pool))] for _ in range(20000)])
    pdiff = perms[:, :na].mean(axis=1) - perms[:, na:].mean(axis=1)
    p_perm = (np.abs(pdiff) >= abs(obs)).mean()
    # bootstrap CI of the mean difference
    diff_boot = []
    for _ in range(20000):
        da = rng.choice(xa, na); db = rng.choice(xb, len(xb))
        diff_boot.append(da.mean() - db.mean())
    lo, hi = np.percentile(diff_boot, [2.5, 97.5])
    res_b.append({'comparison': f"{a} vs {b}", 'mean_diff': obs,
                  'boot95CI': f"[{lo:.3f}, {hi:.3f}]",
                  'MWU_p': p_mw, 'perm_p': p_perm})
res_b = pd.DataFrame(res_b).set_index('comparison')
print(res_b.round(4).to_string())

# one-way ANOVA-style omnibus permutation (F on group means) - optional robustness
groups = [df.loc[df['discipline'] == g, 'd_fis'].values for g in doms]
def fstat(gs):
    allv = np.concatenate(gs); k = len(gs)
    gm = allv.mean(); num = sum(len(g)*(g.mean()-gm)**2 for g in gs)
    den = sum(((g-g.mean())**2).sum() for g in gs)
    return (num/(k-1)) / (den/(len(allv)-k))
F0 = fstat(groups)
pool = np.concatenate(groups); sizes = [len(g) for g in groups]
Fperm = []
for _ in range(20000):
    p = rng.permutation(pool); Fperm.append(fstat([p[:sizes[0]], p[sizes[0]:sizes[0]+sizes[1]], p[sizes[0]+sizes[1]:]]))
p_omni = (np.array(Fperm) >= F0).mean()
print(f"omnibus permutation F-test: F={F0:.3f}, p={p_omni:.3f}")

# ---------- (c) SE-weighted variant ----------
print("\n=== (c) SE-weighted mean of d (weights = 1/(se_fiso^2 + se_fisr^2)) vs unweighted ===")
df['w'] = 1.0 / (df['se_fiso']**2 + df['se_fisr']**2)
rows_c = []
for dom, g in df.groupby('discipline'):
    w = g['w'].values; d = g['d_fis'].values
    wm = np.sum(w*d)/np.sum(w)
    # bootstrap CI for weighted mean
    idx = rng.integers(0, len(g), size=(20000, len(g)))
    wb, db = w[idx], d[idx]
    wmb = (wb*db).sum(axis=1)/wb.sum(axis=1)
    lo, hi = np.percentile(wmb, [2.5, 97.5])
    rows_c.append({'domain': dom, 'n': len(g),
                   'unweighted_mean_d': g['d_fis'].mean(),
                   'unweighted_median_d': g['d_fis'].median(),
                   'weighted_mean_d': wm, 'weighted_mean_d_CI': f"[{lo:.3f}, {hi:.3f}]"})
tab_c = pd.DataFrame(rows_c).set_index('domain')
print(tab_c.round(3).to_string())

# ---------- (d) sensitivity analyses ----------
print("\n=== (d1) sensitivity: correlation scale (d = ro - rr) ===")
analyse(df, 'd_r', 'correlation scale (robustness)')

print("\n=== (d2) sensitivity: relative_es-based check (excluding / fixing B Eitam row) ===")
df['rel_clean'] = np.where(df.index == anom.index[0], re_exp, df['relative_es'])
for variant, rel in [('relative_es as given (with anomaly)', df['relative_es']),
                     ('relative_es with B Eitam sign fixed', df['rel_clean'])]:
    # larger original = relative_es < 1 (replication smaller than original); sign flips => rel<0 also 'smaller in magnitude'
    rows = []
    for dom, g in df.groupby('discipline'):
        r = rel[g.index]
        rows.append({'domain': dom, 'n': len(g),
                     'median_relES': r.median(),
                     'pct_relES_below_1': 100*np.mean(r < 1),
                     'pct_negative_relES': 100*np.mean(r < 0)})
    print(f"-- {variant}")
    print(pd.DataFrame(rows).set_index('domain').round(3).to_string())

print("\n=== (d3) sensitivity: excluding sign-flipped replications (rr<0, n=18) ===")
same_sign = df[np.sign(df['ro']) == np.sign(df['rr'])]
analyse(same_sign, 'd_fis', 'Fisher-z, sign-flips excluded')

# ---------- summary numbers for the write-up ----------
print("\n=== summary ===")
print(f"overall: n={len(df)}, mean d={df['d_fis'].mean():.3f}, median d={df['d_fis'].median():.3f}, "
      f"pct |orig|>|repl|={100*df['abs_orig_larger'].mean():.1f}%")
for dom, g in df.groupby('discipline'):
    print(f"{dom}: n={len(g)}, median d={g['d_fis'].median():.3f}, mean d={g['d_fis'].mean():.3f}, "
          f"pct |orig|>|repl|={100*g['abs_orig_larger'].mean():.1f}%, "
          f"mean |fis| orig={g['fiso'].abs().mean():.3f}, repl={g['fisr'].abs().mean():.3f}")
