"""Proportion of junior professors among replication studies in Psychology (RPP).

Primary definition (approved by researcher):
  - unit      : row of meta-regression_study_data_heterogeneity_in_replication_projects.csv
  - project   : 'rpp' (Psychology); no duplicate ids within rpp
  - exclusions: drop == TRUE removed
  - junior    : seniority.r in {Assistant Professor, Assistant}
  - primary   : denominator = all rpp rows (drop=FALSE), i.e. composition of replication studies
  - sensitivity: replicated=1 denominator; +Researcher; with/without drop
"""
import csv, collections, json

P1 = 'data/meta-regression_study_data_heterogeneity_in_replication_projects.csv'
P2 = 'data/meta-regression_replication_success_data_heterogeneity_in_replication_projects.csv'
JUNIOR = {'Assistant Professor', 'Assistant'}
JUNIOR_EXT = JUNIOR | {'Researcher'}

rows = list(csv.DictReader(open(P1)))
rpp_all = [r for r in rows if r['project'] == 'rpp']

# --- data quality checks on the rpp subset (per researcher request) ---
ids = [r['id'] for r in rpp_all]
dupes = {k: v for k, v in collections.Counter(ids).items() if v > 1}
na = {c: sum(1 for r in rpp_all if r[c].strip() == '') for c in ('id', 'seniority.r', 'replicated', 'project')}
print('rpp rows:', len(rpp_all), '| duplicate ids:', dupes, '| NA counts:', na)

def share(sub, junior_set):
    n = len(sub)
    k = sum(1 for r in sub if r['seniority.r'] in junior_set)
    return k, n, (k / n if n else float('nan'))

results = {}
for drop_label, keep in [('without drop=TRUE', False), ('with drop=TRUE (raw)', True)]:
    pool = rpp_all if keep else [r for r in rpp_all if r['drop'] != 'TRUE']
    rep1 = [r for r in pool if r['replicated'] == '1']
    results[drop_label] = {
        'all_rpp_junior': share(pool, JUNIOR),
        'all_rpp_junior+researcher': share(pool, JUNIOR_EXT),
        'replicated1_junior': share(rep1, JUNIOR),
        'replicated1_junior+researcher': share(rep1, JUNIOR_EXT),
        'n_all': len(pool), 'n_replicated1': len(rep1),
    }

print(json.dumps(results, indent=2))

# seniority.r composition of the primary denominator
pool = [r for r in rpp_all if r['drop'] != 'TRUE']
comp = collections.Counter(r['seniority.r'] for r in pool)
print('primary denominator seniority.r composition:', dict(comp))

# --- cross-check with second CSV (Psychology rows) ---
rows2 = list(csv.DictReader(open(P2)))
psy2 = [r for r in rows2 if r['project'] == 'Psychology']
ids2 = [r['study'] for r in psy2]
dup2 = {k: v for k, v in collections.Counter(ids2).items() if v > 1}
print('success-data Psychology rows:', len(psy2), '| unique study:', len(set(ids2)), '| dup study keys:', dup2)

k, n, p = results['without drop=TRUE']['all_rpp_junior']
print(f"\nPRIMARY: {k}/{n} = {p:.1%} junior professors (Assistant Professor + Assistant) "
      f"among rpp replication studies (drop=TRUE excluded)")
