"""
Question: In which domain did both original and replication studies primarily
use student subjects (original: 82.4%, replication: 80.9%)?

Unit of analysis: one row per unique O/R pair (id).
- ml1/ml3: use the aggregated=True row per id (verified: exactly one per id);
  subjects.r per aggregated row equals the per-lab majority.
- rpp/ee: single row per id.
Decision rule (approved): candidate domain = discipline where 'students' is the
modal subject category in BOTH subjects.o and subjects.r AND whose student
shares minimize the discrepancy to the quoted (82.4%, 80.9%).
"""
import pandas as pd

CSV = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
TARGET_O, TARGET_R = 0.824, 0.809

def load_pair_level(drop_filter=False):
    df = pd.read_csv(CSV)
    if drop_filter:
        df = df[~(df["drop"] == True)]          # noqa: E712
    aggr = df[df["aggregated"] == True]          # noqa: E712
    rest = df[df["aggregated"].isna() | (df["aggregated"] == False)]  # noqa: E712
    one = pd.concat([aggr, rest]).drop_duplicates("id")
    return one

def modal_students(s):
    vc = s.dropna().value_counts()
    return (vc.idxmax() == "students") if len(vc) else None

def discipline_table(one, label):
    print(f"\n=== {label} ===")
    rows = []
    for d, g in one.groupby("discipline"):
        o_share = (g["subjects.o"] == "students").mean()
        r_share = (g["subjects.r"] == "students").mean()
        rows.append({
            "discipline": d, "n_pairs": len(g),
            "students_o": (g["subjects.o"] == "students").sum(),
            "students_o_pct": round(100 * o_share, 1),
            "students_r": (g["subjects.r"] == "students").sum(),
            "students_r_pct": round(100 * r_share, 1),
            "students_modal_o": modal_students(g["subjects.o"]),
            "students_modal_r": modal_students(g["subjects.r"]),
            "dist_to_target": round(abs(o_share - TARGET_O) + abs(r_share - TARGET_R), 4),
        })
    tab = pd.DataFrame(rows)
    print(tab.to_string(index=False))
    eligible = tab[tab.students_modal_o & tab.students_modal_r]
    cand = eligible.loc[eligible.dist_to_target.idxmin(), "discipline"]
    print(f"Candidate (min |o-82.4|+|r-80.9| among modal-students disciplines): {cand}")
    return tab, cand

# ---------- Main analysis (pair level, drop rows kept) ----------
one = load_pair_level()
tab, cand = discipline_table(one, "MAIN: pair level (n=%d pairs), drop rows kept" % len(one))

# NA sensitivity: exclude the pair missing subjects
one_na = one.dropna(subset=["subjects.o", "subjects.r"])
print(f"\nNA-excluded variant: n={len(one_na)}; overall students.o="
      f"{(one_na['subjects.o']=='students').mean():.3f}, students.r="
      f"{(one_na['subjects.r']=='students').mean():.3f}")
discipline_table(one_na, "Pair level, NA pair excluded")

# ---------- Sensitivity 1: raw rows (lab-level) ----------
raw = pd.read_csv(CSV)
tab_raw, cand_raw = discipline_table(raw, "SENSITIVITY: raw lab-level rows (n=%d)" % len(raw))

# ---------- Sensitivity 2: subjects.r per-lab majority ----------
maj = raw.groupby("id")["subjects.r"].agg(
    lambda s: s.dropna().value_counts().idxmax() if s.dropna().size else None)
one_maj = one.copy()
one_maj["subjects.r"] = one_maj["id"].map(maj)
discipline_table(one_maj, "SENSITIVITY: subjects.r = per-lab majority")

# ---------- Sensitivity 3: exclude drop=True ----------
one_nd = load_pair_level(drop_filter=True)
discipline_table(one_nd, "SENSITIVITY: pair level, drop=True rows excluded (n=%d ids)" % len(one_nd))

# ---------- Stratified summary by project (context only, not the answer) ----------
print("\n=== Stratified by project (pair level, main analysis) ===")
for p, g in one.groupby("project"):
    print(p, "n=%d" % len(g),
          "o=%.3f" % (g["subjects.o"] == "students").mean(),
          "r=%.3f" % (g["subjects.r"] == "students").mean())

# ---------- Final ----------
print("\n=== FINAL ===")
g = one[one["discipline"] == cand]
print(f"Answer: {cand}; students.o={100*(g['subjects.o']=='students').mean():.1f}% "
      f"({(g['subjects.o']=='students').sum()}/{len(g)}), "
      f"students.r={100*(g['subjects.r']=='students').mean():.1f}% "
      f"({(g['subjects.r']=='students').sum()}/{len(g)}); "
      f"sensitivity candidates across variants: {cand_raw}")
