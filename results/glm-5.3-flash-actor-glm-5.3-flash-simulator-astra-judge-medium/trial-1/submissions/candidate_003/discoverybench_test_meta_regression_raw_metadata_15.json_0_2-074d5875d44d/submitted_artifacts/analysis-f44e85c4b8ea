"""Analysis: proportion of original studies in Experimental Economics (project == 'ee')
conducted in the United Kingdom, from meta-regression_study_data dataset."""
import pandas as pd, json

df = pd.read_csv('data/meta-regression_study_data_heterogeneity_in_replication_projects.csv')

# (1) Filter project == 'ee', exclude drop == True
ee = df[(df['project'] == 'ee') & (df['drop'] != True)].copy()

# (2) Unit of analysis: unique id (one O/R pair = one original study)
n_unique_ids = ee['id'].nunique()
n_unique_titles = ee['title'].nunique()

# (3) Normalize experiment_country.o (variant mapping as safety net)
def norm(c):
    if pd.isna(c): return None
    s = str(c).strip().lower()
    m = {'uk':'United Kingdom','united kingdom':'United Kingdom',
         'great britain':'United Kingdom','england':'United Kingdom'}
    return m.get(s, str(c).strip())
ee['country_norm'] = ee['experiment_country.o'].map(norm)
variants = sorted(set(str(v).strip() for v in ee['experiment_country.o'].dropna()))

# (4) Numerator / denominator
missing = int(ee['country_norm'].isna().sum())
uk_ids = ee.loc[ee['country_norm'] == 'United Kingdom', 'id'].tolist()
num, denom = len(uk_ids), n_unique_ids
prop = num / denom

# (5) Sensitivity: missing-as-not-UK and by-rows counting
by_rows = int((ee['country_norm'] == 'United Kingdom').sum()) / len(ee)

dist = ee['country_norm'].value_counts()
uk_detail = ee[ee['country_norm'] == 'United Kingdom'][
    ['id','title','authors.o','pub_year','journal','experiment_country.o','online.o']]

result = {
    "ee_rows": int(len(ee)), "unique_ids": int(n_unique_ids),
    "unique_titles": int(n_unique_titles), "raw_country_variants": variants,
    "missing_country": missing, "uk_count": num, "denominator": denom,
    "proportion": round(prop, 4), "proportion_pct": round(prop*100, 1),
    "sensitivity_missing_as_not_uk": round(num/(denom+missing), 4),
    "sensitivity_by_rows": round(by_rows, 4),
    "country_distribution": dist.to_dict(),
    "uk_study_ids": uk_ids,
}
print(json.dumps(result, indent=2))
print("\nUK study:\n", uk_detail.to_string(index=False))
print("\nus_lab.o cross-check (UK study us_lab.o should be 0):",
      int(ee.loc[ee['country_norm']=='United Kingdom','us_lab.o'].iloc[0]))

json.dump(result, open('ee_uk_analysis.json','w'), indent=2)
