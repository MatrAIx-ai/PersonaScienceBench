"""
Question: What proportion of studies in Experimental Economics were conducted
in a lab setting?

Definition (approved): lab := online flag == 0 (online.o == 0 for original
studies). Count original studies only (project == 'ee'), one row per id,
no deduplication needed (lab_id is NaN in EE; drop is False for all rows).
"""
import pandas as pd

DATA = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
DATA2 = "data/meta-regression_replication_success_data_heterogeneity_in_replication_projects.csv"

df = pd.read_csv(DATA)
ee = df[df["project"] == "ee"].copy()

# --- Evidence: subset size, uniqueness, exclusions -------------------------
print(f"Total rows in file: {len(df)}")
print(f"EE (project=='ee') rows: {len(ee)}")
print(f"EE unique ids: {ee['id'].nunique()}")
print(f"EE rows with drop==True: {int(ee['drop'].sum())} (excluded)")

# --- online.o / online.r value counts and missing counts -------------------
for col in ["online.o", "online.r"]:
    vc = ee[col].value_counts(dropna=False).to_dict()
    missing = int(ee[col].isna().sum())
    print(f"{col}: value counts {vc}, missing {missing}")

# --- Proportion of EE studies in a lab setting -----------------------------
n_ee = len(ee)
n_lab_original = int((ee["online.o"] == 0).sum())
n_lab_repl = int((ee["online.r"] == 0).sum())
prop_original = n_lab_original / n_ee
prop_repl = n_lab_repl / n_ee
print(f"\nOriginal studies (online.o == 0 => lab): {n_lab_original}/{n_ee} = {prop_original:.2%}")
print(f"Robustness - replications (online.r == 0 => lab): {n_lab_repl}/{n_ee} = {prop_repl:.2%}")

# --- Sanity check against second CSV ---------------------------------------
df2 = pd.read_csv(DATA2)
n2 = int((df2["project"] == "Experimental Economics").sum())
print(f"\nSecond CSV 'Experimental Economics' rows: {n2} "
      f"(matches EE subset: {n2 == n_ee})")
