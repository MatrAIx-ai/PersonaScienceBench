import pandas as pd

df = pd.read_csv("data/meta-regression_study_data_heterogeneity_in_replication_projects.csv")

res = {}
for proj in ["ee", "rpp"]:
    sub = df[df["project"] == proj]
    n = sub["id"].nunique()
    assert len(sub) == n, "unexpected duplicates"
    lengths = sub["length"].dropna()
    res[proj] = dict(N=n, mean=round(lengths.mean(), 2), median=float(lengths.median()),
                     sd=round(lengths.std(), 2), min=int(lengths.min()), max=int(lengths.max()))
    print(f"{proj}: N={n}  mean={lengths.mean():.2f}  median={lengths.median():.0f}  "
          f"sd={lengths.std():.2f}  min={lengths.min()}  max={lengths.max()}")

print(f"\nDifference in means (ee - rpp): {res['ee']['mean'] - res['rpp']['mean']:.2f} pages")
print(f"Ratio ee/rpp: {res['ee']['mean'] / res['rpp']['mean']:.2f}")
