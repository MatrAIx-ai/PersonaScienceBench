"""
Hypothesis analysis: In which domain do the majority of authors tend to be male
for both original and replication studies?

Data: data/meta-regression_study_data_heterogeneity_in_replication_projects.csv
Unit of analysis: one row per unique O/R pair (`id`), 141 pairs.
  - ml1/ml3: keep the aggregated=True row (pooled replication team ratio)
  - ee/rpp : keep the single row
Primary rule : majority male = authors_male ratio > 0.5 (strict)
Sensitivity  : >= 0.5 ("at least half")
Criterion    : BOTH .o and .r sides majority-male (conjunction), per discipline.
"""
import pandas as pd

CSV = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
df = pd.read_csv(CSV)
print(f"Loaded raw file: {df.shape[0]} rows x {df.shape[1]} cols")

# ---- Step 1: dedup to one row per O/R pair -------------------------------
agg_rows = df[df["aggregated"] == True]          # ml1/ml3 pooled rows (26)
single_rows = df[df["aggregated"].isna()]        # ee/rpp single rows (115)
assert agg_rows["id"].nunique() == agg_rows.shape[0], "aggregated rows not unique per id"
assert not (set(agg_rows.id) & set(single_rows.id)), "id overlap between dedup groups"
pairs = pd.concat([agg_rows, single_rows], ignore_index=True)
print(f"Deduped to {len(pairs)} unique O/R pairs "
      f"(ml1/ml3 aggregated: {len(agg_rows)}, ee/rpp single: {len(single_rows)})")
assert pairs["id"].nunique() == len(pairs)

# Sanity: drop=True rows are all redundant lab-level rows, none in the pair set
print(f"drop=True rows in pair set: {pairs['drop'].sum()} (expected 0)")

# ---- Step 2: majority-male flags under both rules ------------------------
for rule, op in [("strict (>0.5)", lambda s: s > 0.5), ("at-least-half (>=0.5)", lambda s: s >= 0.5)]:
    pairs[f"mm_o_{op}"] = None  # placeholder to avoid confusion; computed below
pairs["mm_o_strict"] = pairs["authors_male.o"] > 0.5
pairs["mm_r_strict"] = pairs["authors_male.r"] > 0.5
pairs["mm_o_half"]   = pairs["authors_male.o"] >= 0.5
pairs["mm_r_half"]   = pairs["authors_male.r"] >= 0.5
pairs["both_strict"] = pairs["mm_o_strict"] & pairs["mm_r_strict"]
pairs["both_half"]   = pairs["mm_o_half"] & pairs["mm_r_half"]

# Tie diagnostics at exactly 0.5
ties_o = (pairs["authors_male.o"] == 0.5).sum()
ties_r = (pairs["authors_male.r"] == 0.5).sum()
ties_both = ((pairs["authors_male.o"] == 0.5) | (pairs["authors_male.r"] == 0.5)).sum()
print(f"\nTies at 0.5 among the 141 pairs: o-side={ties_o}, r-side={ties_r}, either side={ties_both}")

# ---- Step 3: per-discipline summary --------------------------------------
def summarize(flag):
    g = pairs.groupby("discipline").agg(
        pairs=("id", "size"),
        both=("both_" + flag, "sum"),
        o_only=("mm_o_" + flag, "sum"),
        r_only=("mm_r_" + flag, "sum"),
    )
    g["both_share"] = (g["both"] / g["pairs"]).round(3)
    g["o_share"] = (g["o_only"] / g["pairs"]).round(3)
    g["r_share"] = (g["r_only"] / g["pairs"]).round(3)
    total = pd.Series({
        "pairs": len(pairs),
        "both": pairs["both_" + flag].sum(),
        "o_only": pairs["mm_o_" + flag].sum(),
        "r_only": pairs["mm_r_" + flag].sum(),
    })
    total["both_share"] = round(total["both"] / total["pairs"], 3)
    total["o_share"] = round(total["o_only"] / total["pairs"], 3)
    total["r_share"] = round(total["r_only"] / total["pairs"], 3)
    return g, total

for label, flag in [("PRIMARY RULE: strict majority (ratio > 0.5)", "strict"),
                    ("SENSITIVITY RULE: at least half (ratio >= 0.5)", "half")]:
    g, total = summarize(flag)
    print(f"\n===== {label} =====")
    print(g[["pairs", "both", "both_share", "o_only", "o_share", "r_only", "r_share"]].to_string())
    print(f"ALL DISCIPLINES: pairs={total.pairs}, both={total.both} ({total.both_share}), "
          f"o={total.o_only} ({total.o_share}), r={total.r_only} ({total.r_share})")
    winner = g["both_share"].idxmax()
    print(f"Winning discipline: {winner} (both_share={g['both_share'].max()})")

# ---- Step 4: detailed breakdown for the narrative ------------------------
print("\n===== Detail: strict rule, both-sides flag by discipline x project =====")
print(pd.crosstab(pairs["discipline"], pairs["both_strict"]).to_string())
print("\nPairs per discipline x project:")
print(pd.crosstab(pairs["discipline"], pairs["project"]).to_string())

print("\n===== Economics (ee) pair-level detail, strict rule =====")
ee = pairs[pairs["discipline"] == "Economics"]
print(ee[["id", "n_authors.o", "authors_male.o", "n_authors.r", "authors_male.r",
          "mm_o_strict", "mm_r_strict", "both_strict"]].to_string())

print("\n===== Cognitive strict-rule margin detail =====")
cog = pairs[pairs["discipline"] == "Cognitive"]
print("Cognitive: both=%d/%d, o-only=%d, r-only=%d" % (
    cog["both_strict"].sum(), len(cog), cog["mm_o_strict"].sum(), cog["mm_r_strict"].sum()))

print("\n===== Social strict-rule margin detail =====")
soc = pairs[pairs["discipline"] == "Social"]
print("Social: both=%d/%d, o-only=%d, r-only=%d" % (
    soc["both_strict"].sum(), len(soc), soc["mm_o_strict"].sum(), soc["mm_r_strict"].sum()))

# ---- Step 5: save pair-level table as supporting artifact ----------------
out = pairs[["id", "discipline", "project", "n_authors.o", "authors_male.o",
             "n_authors.r", "authors_male.r", "mm_o_strict", "mm_r_strict",
             "both_strict", "mm_o_half", "mm_r_half", "both_half"]]
out.to_csv("analysis/pair_level_gender_majority.csv", index=False)
print("\nSaved pair-level table -> analysis/pair_level_gender_majority.csv")

# ---- Step 6: robustness — exclude drop=True pairs -------------------------
# The pair set contains 10 drop=True rows (3 ml1 aggregated, 7 rpp single rows,
# all Social). Rerun excluding them to confirm the ranking is unchanged.
p2 = pairs[~pairs["drop"]].copy()
p2["both_strict_nodrop"] = (p2["authors_male.o"] > 0.5) & (p2["authors_male.r"] > 0.5)
g2 = p2.groupby("discipline")["both_strict_nodrop"].agg(["size", "sum"])
g2["share"] = (g2["sum"] / g2["size"]).round(3)
print("\n===== ROBUSTNESS: strict rule, drop=True pairs excluded (n=%d) =====" % len(p2))
print(g2.to_string())
print("Overall both share (drop excluded):", round(p2["both_strict_nodrop"].mean(), 3))
print("Winner unchanged vs. full pair set:",
      g2["share"].idxmax() == pairs.groupby('discipline').both_strict.sum().div(
          pairs.groupby('discipline').size()).idxmax())
