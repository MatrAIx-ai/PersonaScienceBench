"""NLSY79 incarceration & wealth (1985): demographic disparities in median wealth
among ever-incarcerated individuals. DiscoveryBench full-workflow deliverable."""
import pandas as pd
import itertools

W = "composite_wealth_1985"
df = pd.read_csv("data/nls_incarceration_processed.csv")

# ---------- diagnostics ----------
print("DIAGNOSTICS:", {
    "rows": len(df), "missing": int(df.isna().sum().sum()),
    "ever_jailed_1": int((df.ever_jailed == 1).sum()),
    "w1985_neg": int((df[W] < 0).sum()), "w1985_zero": int((df[W] == 0).sum()),
    "w1985_min": int(df[W].min()), "w1985_max": int(df[W].max()),
})
print("race values (note 'hipanic' typo kept as-is):", df.race.unique().tolist())

def cell_stats(d):
    g = d.groupby(["race", "sex"])[W].agg(
        n="count", med="median", mean="mean",
        zero_share=lambda x: (x == 0).mean(), neg_share=lambda x: (x < 0).mean())
    g["label"] = g.index.get_level_values(0) + " " + g.index.get_level_values(1)
    return g.reset_index(drop=True)

def pairwise(rows):
    lines = []
    for a, b in itertools.combinations(rows, 2):
        for src, tgt in ((a, b), (b, a)):
            gap = tgt.med - src.med
            if src.med > 0:
                lines.append(f"{tgt.label} vs {src.label}: gap ${gap:,.0f}, ratio {tgt.med/src.med:.2f}")
            else:
                lines.append(f"{tgt.label} vs {src.label}: gap ${gap:,.0f}, ratio n/a (reference median = $0)")
    return lines

# ---------- main analysis: ever_jailed == 1 ----------
ev = df[df.ever_jailed == 1]
main = cell_stats(ev).sort_values("med", ascending=False)
print("\n=== TABLE: ever_jailed=1, race x sex, median wealth 1985 ===")
print(main[["label", "n", "med", "mean", "zero_share", "neg_share"]]
      .round({"zero_share": 3, "neg_share": 3}).to_string(index=False))
print(f"\nAll ever-incarcerated: n={len(ev)}, median=${ev[W].median():,.0f}")

# reference group: white male
ref = main[main.label == "white male"].iloc[0]
print("\n=== GAPS vs reference (white male, median $" f"{ref.med:,.0f}) ===")
for r in main.itertuples():
    gap = r.med - ref.med
    if r.label == "white male":
        print(f"{r.label}: reference; median ${r.med:,.0f} (n={r.n})")
    elif ref.med > 0:
        print(f"{r.label}: median ${r.med:,.0f} (n={r.n}); gap ${gap:,.0f}; ratio {r.med/ref.med:.2f}")
    else:
        print(f"{r.label}: median ${r.med:,.0f} (n={r.n}); gap ${gap:,.0f}; ratio n/a (ref median $0)")

print("\n=== PAIRWISE COMPARISONS (all cell pairs) ===")
for line in pairwise(list(main.itertuples())):
    print(line)

# ---------- background: never-incarcerated ----------
nev = df[df.ever_jailed == 0]
bg = cell_stats(nev)
print("\n=== BACKGROUND: ever_jailed=0 medians 1985 ===")
print(bg[["label", "n", "med"]].sort_values("med", ascending=False).to_string(index=False))
print(f"pooled never-incarcerated: median=${nev[W].median():,.0f} (n={len(nev)})")

# ---------- sensitivity: full-row dedup ----------
dd = df.drop_duplicates()
evd = dd[dd.ever_jailed == 1]
ddm = cell_stats(evd)
print("\n=== SENSITIVITY: medians after full-row dedup ===")
print(ddm[["label", "n", "med"]].sort_values("med", ascending=False).to_string(index=False))
merged = main.merge(ddm[["label", "med"]], on="label", suffixes=("", "_dedup"))
merged["delta"] = merged.med_dedup - merged.med
print("max abs change in median after dedup: $", f"{merged.delta.abs().max():,.0f}")

# ---------- male subgroups (headline comparison) ----------
print("\n=== MALE subgroups (ever_jailed=1) ===")
print(ev[ev.sex == "male"].groupby("race")[W].agg(["count", "median"]).to_string())
print("\n=== FEMALE subgroups (ever_jailed=1) ===")
print(ev[ev.sex == "female"].groupby("race")[W].agg(["count", "median"]).to_string())
