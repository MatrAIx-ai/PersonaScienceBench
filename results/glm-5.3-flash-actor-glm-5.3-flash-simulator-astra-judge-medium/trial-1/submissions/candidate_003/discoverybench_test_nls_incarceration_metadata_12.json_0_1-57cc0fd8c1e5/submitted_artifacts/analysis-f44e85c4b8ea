"""
NLSY79 incarceration & wealth among black respondents, by baseline-wealth tier.
Question: How does incarceration affect the wealth of black individuals based on
their income levels?  (Associational analysis; ever_jailed = jailed 1985-1994.)

Primary tier scheme (baseline = composite_wealth_1985, black sample):
  negative | zero | positive-low | positive-high
Sensitivity: quartiles of 1985 wealth.
Levels winsorized at the 1st/99th percentile of the black sample per wave
(counts affected reported); raw extreme negatives flagged, not silently dropped.
"""
import numpy as np
import pandas as pd
from scipy import stats

pd.set_option("display.width", 200)
WAVES = ["1985", "1990", "1996"]
COLS = [f"composite_wealth_{w}" for w in WAVES]

df = pd.read_csv("data/nls_incarceration_processed.csv")
black = df[df.race == "black"].copy()

# ---- winsorization (black sample, per wave) --------------------------------
wins_counts = {}
for c in COLS:
    lo, hi = black[c].quantile([0.01, 0.99])
    wins_counts[c] = int(((black[c] < lo) | (black[c] > hi)).sum())
    black[c + "_w"] = black[c].clip(lo, hi)
print("=== Winsorization (1st/99th pct of black sample) ===")
print(pd.Series(wins_counts).to_string(), f"of n={len(black)} rows per wave")
neg_extreme = {
    c: (int((black[c] < black[c].quantile(0.01)).sum()), float(black[c].min()))
    for c in COLS
}
print("\n=== Extreme negatives below the 1st pct (flagged, kept in raw stats) ===")
print(pd.DataFrame(neg_extreme, index=["n_below_p1", "min_value"]).to_string())

# ---- tiers -----------------------------------------------------------------
pos_median = black.loc[black.composite_wealth_1985 > 0, "composite_wealth_1985"].median()

def tiers_primary(v):
    if v < 0:  return "negative"
    if v == 0: return "zero"
    return "pos-low" if v < pos_median else "pos-high"

black["tier"] = black.composite_wealth_1985.apply(tiers_primary)
TIER_ORDER = ["negative", "zero", "pos-low", "pos-high"]

print(f"\n=== Primary tiers (n black={len(black)}; median of positive 1985 wealth = {pos_median:,.0f}) ===")
print(black.tier.value_counts().reindex(TIER_ORDER).to_string())

# ---- within-tier x sex: jailed vs not, changes & 1996 levels ---------------
def rel_change(row, base, end):
    return np.nan if row[base] <= 0 else (row[end] - row[base]) / abs(row[base])

black["chg_85_90"] = black.composite_wealth_1990_w - black.composite_wealth_1985_w
black["chg_85_96"] = black.composite_wealth_1996_w - black.composite_wealth_1985_w
black["rel_85_90"] = black.apply(lambda r: rel_change(r, "composite_wealth_1985", "composite_wealth_1990_w"), axis=1)
black["rel_85_96"] = black.apply(lambda r: rel_change(r, "composite_wealth_1985", "composite_wealth_1996_w"), axis=1)

def cell_stats(g):
    out = {}
    for label, sub in [("not_jailed", g[g.ever_jailed == 0]), ("jailed", g[g.ever_jailed == 1])]:
        out[(label, "n")] = len(sub)
        for m in ["chg_85_90", "chg_85_96", "composite_wealth_1996_w"]:
            out[(label, m)] = sub[m].median() if len(sub) else np.nan
            out[(label, m + "_wmean")] = sub[m].mean() if len(sub) else np.nan
        for m in ["rel_85_90", "rel_85_96"]:
            out[(label, m)] = sub[m].median() if len(sub) else np.nan
    # Mann-Whitney on changes and 1996 level when both cells >= 5
    for m in ["chg_85_90", "chg_85_96", "composite_wealth_1996_w"]:
        a = g.loc[g.ever_jailed == 1, m]; b = g.loc[g.ever_jailed == 0, m]
        out[("test", m)] = (stats.mannwhitneyu(a, b, alternative="two-sided").pvalue
                            if len(a) >= 5 and len(b) >= 5 else np.nan)
    return pd.Series(out)

rows = []
for sex in ["male", "female"]:
    for t in TIER_ORDER:
        s = cell_stats(black[(black.sex == sex) & (black.tier == t)])
        s.name = (sex, t); rows.append(s)
cell_tbl = pd.DataFrame(rows)
print("\n=== Jailed vs not-jailed by tier x sex (black respondents) ===")
print("Columns: n, medians and winsorized means of change 85-90, change 85-96, 1996 level (wins.),")
print("         median relative change 85-90 / 85-96 (positive-baseline rows only), MWU p (if both n>=5).")
print(cell_tbl.round(3).to_string())

# ---- pooled within-tier (both sexes), sex-adjusted OLS ---------------------
print("\n=== Pooled within-tier comparison + sex-adjusted OLS on winsorized change 1985->1996 ===")
import statsmodels.api as sm
for t in TIER_ORDER:
    g = black[black.tier == t]
    print(f"\nTier {t}: jailed n={int(g.ever_jailed.sum())} / {len(g)}")
    print(g.groupby("ever_jailed")[["chg_85_90", "chg_85_96", "composite_wealth_1996_w"]].median().round(0).to_string())
    X = sm.add_constant(pd.DataFrame({"jailed": g.ever_jailed.astype(float),
                                      "male": (g.sex == "male").astype(float)}))
    m = sm.OLS(g.chg_85_96, X, missing="drop").fit(cov_type="HC3")
    print(f"  OLS chg_85_96 ~ jailed + male: jailed coef = {m.params['jailed']:,.0f} "
          f"(p={m.pvalues['jailed']:.3f}), n={int(m.nobs)}")

# ---- DiD-style & cross-tier interaction ------------------------------------
print("\n=== DiD-style jail gap in change (jailed minus not-jailed median change) ===")
did = {}
for t in TIER_ORDER:
    g = black[black.tier == t]
    for end, chg in [("1990", "chg_85_90"), ("1996", "chg_85_96")]:
        j = g.loc[g.ever_jailed == 1, chg].median(); n = g.loc[g.ever_jailed == 0, chg].median()
        did[(t, end)] = (j - n) if (len(g[g.ever_jailed == 1]) >= 3) else np.nan
print(pd.DataFrame(did, index=["jail_gap_median"]).T.round(0).to_string())

# interaction: OLS on change with tier x jailed, sex-adjusted, positive tiers + zero
print("\n=== Cross-tier interaction (is the jail penalty larger at lower baseline wealth?) ===")
sub = black[black.tier.isin(["zero", "pos-low", "pos-high"])].copy()
sub["jailed"] = sub.ever_jailed.astype(float)
sub["male"] = (sub.sex == "male").astype(float)
for t in ["zero", "pos-low"]:
    sub[f"jx{t}"] = sub.jailed * (sub.tier == t)
X = sm.add_constant(sub[["jailed", "male", "jxzero", "jxpos-low"]].rename(columns={"jxpos-low": "jxposlow"}))
m = sm.OLS(sub.chg_85_96, X, missing="drop").fit(cov_type="HC3")
print(m.summary().tables[1])

# relative changes among positive-baseline tiers
print("\n=== Median relative change 1985->1996, positive-baseline rows only ===")
print(black[black.composite_wealth_1985 > 0]
      .groupby(["tier", "ever_jailed"])["rel_85_96"].median().round(3).to_string())

# ---- sensitivity: quartiles of 1985 wealth ----------------------------------
print("\n=== SENSITIVITY: 1985-wealth quartiles (degenerate ties at 0 noted) ===")
black["q4"] = pd.qcut(black.composite_wealth_1985, 4, duplicates="drop")
qt = black.groupby(["q4", "ever_jailed"], observed=True).agg(
    n=("ever_jailed", "size"), med_chg_96=("chg_85_96", "median"), med_lvl96=("composite_wealth_1996_w", "median"))
print(qt.round(0).to_string())

# headline jailed counts per tier per sex
print("\n=== Jailed vs not-jailed counts per tier x sex ===")
print(black.groupby(["tier", "sex"])["ever_jailed"].agg(["size", "sum"]).to_string())
