import pandas as pd

df = pd.read_csv('data/nls_incarceration_processed.csv')
bf = df[(df['race'] == 'black') & (df['sex'] == 'female')].copy()
years = [1985, 1990, 1996]
cols = [f'composite_wealth_{y}' for y in years]

print(f"Subgroup black+female: n={len(bf)} (of {len(df)} rows; race levels: "
      f"{dict(df['race'].value_counts())} -- note data typo 'hipanic' for hispanic, excluded from filter)")

med = {y: bf[f'composite_wealth_{y}'].median() for y in years}
print("\nMedians (all valid obs, zeros & negatives kept):")
for y in years:
    print(f"  {y}: median=${med[y]:,.0f}")

print("\nPairwise increases (absolute $ difference of medians):")
abs_inc = {}
for a, b in [(1985, 1990), (1990, 1996), (1985, 1996)]:
    d = med[b] - med[a]
    pct = 100 * d / med[a] if med[a] else float('nan')
    abs_inc[(a, b)] = d
    print(f"  {a}->{b}: +${d:,.0f}  ({pct:+.1f}% relative)")

best_abs = max([(1985,1990), (1990,1996)], key=lambda p: abs_inc[p])
print(f"\nMax absolute increase interval: between {best_abs[0]} and {best_abs[1]} "
      f"(+${abs_inc[best_abs]:,.0f})")

# Sensitivity check: exclude zeros
print("\n--- Sensitivity check: zeros excluded (treated as possible hidden missing) ---")
med_nz = {y: bf.loc[bf[f'composite_wealth_{y}'] != 0, f'composite_wealth_{y}'].median() for y in years}
for y in years:
    nz = (bf[f'composite_wealth_{y}'] == 0).sum()
    print(f"  {y}: median=${med_nz[y]:,.0f} (zeros excluded: {nz})")
for a, b in [(1985, 1990), (1990, 1996)]:
    print(f"  {a}->{b}: +${med_nz[b]-med_nz[a]:,.0f} "
          f"({100*(med_nz[b]-med_nz[a])/med_nz[a]:+.1f}% relative)")

# Sensitivity check: only positive (exclude zeros AND negatives)
med_pos = {y: bf.loc[bf[f'composite_wealth_{y}'] > 0, f'composite_wealth_{y}'].median() for y in years}
print("\n--- Sensitivity check: strictly positive only ---")
for a, b in [(1985, 1990), (1990, 1996)]:
    print(f"  {a}->{b}: median ${med_pos[a]:,.0f} -> ${med_pos[b]:,.0f}, "
          f"+${med_pos[b]-med_pos[a]:,.0f} ({100*(med_pos[b]-med_pos[a])/med_pos[a]:+.1f}% relative)")

print("\n--- Relative (percent) increases of median, all obs ---")
for a, b in [(1985, 1990), (1990, 1996)]:
    print(f"  {a}->{b}: {100*(med[b]-med[a])/med[a]:+.1f}%")
