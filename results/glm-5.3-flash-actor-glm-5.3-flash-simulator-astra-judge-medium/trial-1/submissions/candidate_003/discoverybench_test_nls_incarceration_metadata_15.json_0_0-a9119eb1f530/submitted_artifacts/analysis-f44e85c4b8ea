"""
NLSY79: изменение богатства и неравенства у белых мужчин и женщин, 1990 -> 1996.
Решения исследователя:
 (1) неравенство = сдвиг уровней + рассеяние (median, IQR, p90/p10, Gini) + гендерный разрыв;
 (2) сценарий A: 0 = истинный ноль; сценарий B (чувствительность): 0 = missing, исключён;
     сценарий C: сопоставимая панель (не-ноль в оба года) для устойчивости разрыва;
 (3) ever_jailed — только описательный срез (n=12/57);
 (5) winsorized mean (1/99) + бутстрап-ДИ медиан (B=2000, seed=202601);
 (6) отрицательные значения не обрезаются.
"""
import numpy as np
import pandas as pd

rng = np.random.default_rng(202601)
B = 2000
df = pd.read_csv("data/nls_incarceration_processed.csv")
w = df[df["race"] == "white"].copy()
c90, c96 = "composite_wealth_1990", "composite_wealth_1996"

def winsorize(x, lo=1, hi=99):
    x = np.asarray(x, float)
    a, b = np.percentile(x, [lo, hi])
    return np.clip(x, a, b)

def gini(x):
    x = np.sort(np.asarray(x, float)); n = len(x); s = x.sum()
    if n == 0 or s == 0: return np.nan
    i = np.arange(1, n + 1)
    # = mean|x_i - x_j| / (2*mean); определение корректно и при отрицательных
    return (2 * (i * x).sum() - (n + 1) * s) / (n * s)

def stats(x):
    x = np.asarray(x, float)
    q = np.percentile(x, [10, 25, 50, 75, 90])
    return dict(n=len(x), mean=x.mean(), mean_w=winsorize(x).mean(),
                p10=q[0], p25=q[1], median=q[2], p75=q[3], p90=q[4],
                iqr=q[3] - q[1], p90p10=q[4] / q[0] if q[0] > 0 else np.nan,
                gini=gini(x), neg_share=(x < 0).mean(), zero_share=(x == 0).mean())

def boot_med_ci(x):
    x = np.asarray(x, float)
    idx = rng.integers(0, len(x), (B, len(x)))
    meds = np.median(x[idx], axis=1)
    return np.percentile(meds, [2.5, 97.5])

def boot_gap_ci(m, f):
    m = np.asarray(m, float); f = np.asarray(f, float)
    mi = rng.integers(0, len(m), (B, len(m)))
    fi = rng.integers(0, len(f), (B, len(f)))
    d = np.median(f[fi], axis=1) - np.median(m[mi], axis=1)
    return np.percentile(d, [2.5, 97.5])

def build(subsets, scen):
    rows = []
    for sex in ["male", "female"]:
        for year, col in [(1990, c90), (1996, c96)]:
            x = subsets[sex][year]
            s = stats(x); s.update(scenario=scen, sex=sex, year=year)
            s["med_ci_lo"], s["med_ci_hi"] = boot_med_ci(x)
            rows.append(s)
    return pd.DataFrame(rows)

def gap_table(subsets, scen):
    rows = []
    for year in [1990, 1996]:
        m, f = subsets["male"][year], subsets["female"][year]
        gm, gf = stats(m), stats(f)
        lo, hi = boot_gap_ci(m, f)
        rows.append(dict(scenario=scen, year=year, median_gap=gf["median"] - gm["median"],
                         gap_ci_lo=lo, gap_ci_hi=hi,
                         mean_gap_w=gf["mean_w"] - gm["mean_w"],
                         gini_male=gm["gini"], gini_female=gf["gini"],
                         p90p10_male=gm["p90p10"], p90p10_female=gf["p90p10"]))
    return pd.DataFrame(rows)

def subsets_zero(sub):
    return {s: {y: sub[(sub.sex == s)][c].values for y, c in [(1990, c90), (1996, c96)]} for s in ["male", "female"]}

def subsets_nonzero(sub):
    return {s: {y: sub[(sub.sex == s) & (sub[c] != 0)][c].values for y, c in [(1990, c90), (1996, c96)]} for s in ["male", "female"]}

comp = w[(w[c90] != 0) & (w[c96] != 0)]
base = build(subsets_zero(w), "A_base_zero_is_zero")
gaps = gap_table(subsets_zero(w), "A_base_zero_is_zero")
sens = build(subsets_nonzero(w), "B_zero_is_missing")
gaps_b = gap_table(subsets_nonzero(w), "B_zero_is_missing")
comp_df = build(subsets_nonzero(comp), "C_consistent_panel")
gaps_c = gap_table(subsets_nonzero(comp), "C_consistent_panel")

jail_rows = []
for sex in ["male", "female"]:
    for j in [0, 1]:
        sub = w[(w.sex == sex) & (w.ever_jailed == j)]
        if len(sub) == 0: continue
        jail_rows.append(dict(sex=sex, ever_jailed=j, n=len(sub),
                              med90=sub[c90].median(), med96=sub[c96].median(),
                              mean90_w=winsorize(sub[c90]).mean(),
                              mean96_w=winsorize(sub[c96]).mean()))
jail = pd.DataFrame(jail_rows)

pd.set_option("display.width", 260)
def show(t, name):
    print(f"\n===== {name} =====")
    cols = ["scenario","sex","year","n","mean","mean_w","median","p25","p75","p10","p90","iqr","p90p10","gini","neg_share","zero_share","med_ci_lo","med_ci_hi"]
    print(t[[c for c in cols if c in t.columns]].round(3).to_string(index=False))

show(base, "СЦЕНАРИЙ A: базовый (0 = истинный ноль)")
print("\n--- Разрыв female-male, A ---"); print(gaps.round(3).to_string(index=False))
show(sens, "СЦЕНАРИЙ B: чувствительность (0 = missing, исключён)")
print("\n--- Разрыв female-male, B ---"); print(gaps_b.round(3).to_string(index=False))
show(comp_df, "СЦЕНАРИЙ C: сопоставимая панель (не-ноль в оба года)")
print("\n--- Разрыв female-male, C ---"); print(gaps_c.round(3).to_string(index=False))
print("\n===== ever_jailed срез (описательный; jailed: n=12 female, n=57 male) =====")
print(jail.round(1).to_string(index=False))

import pickle
with open("artifacts/results.pkl", "wb") as fh:
    pickle.dump(dict(base=base, gaps=gaps, sens=sens, gaps_b=gaps_b,
                     comp=comp_df, gaps_c=gaps_c, jail=jail), fh)
base.to_csv("artifacts/results_scenario_A.csv", index=False)
sens.to_csv("artifacts/results_scenario_B.csv", index=False)
comp_df.to_csv("artifacts/results_scenario_C.csv", index=False)
print("\nSaved: artifacts/results.pkl + 3 csv")
