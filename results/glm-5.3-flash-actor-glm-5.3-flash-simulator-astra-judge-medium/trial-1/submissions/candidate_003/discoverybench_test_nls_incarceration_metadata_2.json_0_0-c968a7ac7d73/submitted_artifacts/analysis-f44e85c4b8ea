"""
NLSY79 incarceration & wealth: is wealth of ever-jailed individuals significantly
lower in 1985 / 1990 / 1996?

Pipeline:
 1. Welch t-test + Mann-Whitney U on sign-log transformed composite wealth (3 years)
 2. OLS: wealth ~ ever_jailed + C(race) + C(sex) on sign-log wealth (3 years)
 3. Holm-Bonferroni correction across the 3 year-comparisons (alpha = 0.05)
 4. Sensitivity checks: raw (untransformed) Welch t-test and MWU on winsorized data
"""
import numpy as np
import pandas as pd
from scipy import stats
import statsmodels.formula.api as smf

OUT = []

def log(msg):
    OUT.append(msg)
    print(msg)

df = pd.read_csv("data/nls_incarceration_processed.csv")
log(f"n = {len(df)}, ever_jailed=1: {(df.ever_jailed==1).sum()}, =0: {(df.ever_jailed==0).sum()}")
log(f"jailed group: male {df[df.ever_jailed==1].sex.value_counts().to_dict()}, race {df[df.ever_jailed==1].race.value_counts().to_dict()}")

YEARS = ["1985", "1990", "1996"]
COLS = [f"composite_wealth_{y}" for y in YEARS]

def sign_log(s):
    return np.sign(s) * np.log1p(np.abs(s))

def winsorize(s, p=0.01):
    lo, hi = s.quantile(p), s.quantile(1 - p)
    return s.clip(lo, hi)

results = {}
for y, c in zip(YEARS, COLS):
    sl = sign_log(df[c])
    g0, g1 = sl[df.ever_jailed == 0], sl[df.ever_jailed == 1]
    t = stats.ttest_ind(g0, g1, equal_var=False)
    u = stats.mannwhitneyu(g0, g1, alternative="two-sided")
    d = (g0.mean() - g1.mean()) / np.sqrt((g0.var(ddof=1) + g1.var(ddof=1)) / 2)

    m = smf.ols(f"sl ~ ever_jailed + C(race) + C(sex)",
                data=df.assign(sl=sl)).fit()
    b, p_ols, ci = m.params["ever_jailed"], m.pvalues["ever_jailed"], m.conf_int().loc["ever_jailed"]

    # sensitivity: raw untransformed Welch
    r0, r1 = df[c][df.ever_jailed == 0], df[c][df.ever_jailed == 1]
    t_raw = stats.ttest_ind(r0, r1, equal_var=False)
    # sensitivity: winsorized (1%) sign-log
    wl = sign_log(winsorize(df[c]))
    w0, w1 = wl[df.ever_jailed == 0], wl[df.ever_jailed == 1]
    t_w = stats.ttest_ind(w0, w1, equal_var=False)
    u_w = stats.mannwhitneyu(w0, w1, alternative="two-sided")

    results[y] = dict(t_p=t.pvalue, mwu_p=u.pvalue, d=d,
                      ols_b=b, ols_p=p_ols, ci=ci,
                      raw_p=t_raw.pvalue, wins_p=t_w.pvalue, wins_mwu=u_w.pvalue,
                      med0=r0.median(), med1=r1.median(),
                      mean0=r0.mean(), mean1=r1.mean())
    log(f"\n--- {y} ---")
    log(f"  means: jailed {r1.mean():,.0f} vs not {r0.mean():,.0f}; medians: {r1.median():,.0f} vs {r0.median():,.0f}")
    log(f"  Welch t (sign-log): p={t.pvalue:.3e}; MWU p={u.pvalue:.3e}; Cohen's d={d:.3f}")
    log(f"  OLS sl ~ jailed+race+sex: b={b:.3f} (95% CI [{ci[0]:.3f},{ci[1]:.3f}]), p={p_ols:.3e}")
    log(f"  Sensitivity raw Welch p={t_raw.pvalue:.3e}; winsorized sign-log Welch p={t_w.pvalue:.3e}, MWU p={u_w.pvalue:.3e}")

# Holm-Bonferroni over the 3 primary OLS p-values and over 3 Welch p-values
def holm(pvals):
    order = np.argsort(pvals)
    m = len(pvals); adj = np.empty(m)
    prev = 0.0
    for rank, idx in enumerate(order):
        v = min(1.0, (m - rank) * pvals[idx])
        v = max(v, prev); adj[idx] = v; prev = v
    return adj

holm_ols = holm([results[y]["ols_p"] for y in YEARS])
holm_t = holm([results[y]["t_p"] for y in YEARS])
log("\n--- Holm-Bonferroni (alpha=0.05, 3 comparisons) ---")
for i, y in enumerate(YEARS):
    log(f"  {y}: Welch p_adj={holm_t[i]:.3e} {'SIG' if holm_t[i]<0.05 else 'n.s.'} | OLS p_adj={holm_ols[i]:.3e} {'SIG' if holm_ols[i]<0.05 else 'n.s.'}")

log("\n--- Median gap (jailed minus not-jailed), raw dollars ---")
for y in YEARS:
    r = results[y]
    log(f"  {y}: median gap {r['med1']-r['med0']:,.0f}; mean gap {r['mean1']-r['mean0']:,.0f}")

with open("outputs/analysis_log.txt", "w") as f:
    f.write("\n".join(OUT))
