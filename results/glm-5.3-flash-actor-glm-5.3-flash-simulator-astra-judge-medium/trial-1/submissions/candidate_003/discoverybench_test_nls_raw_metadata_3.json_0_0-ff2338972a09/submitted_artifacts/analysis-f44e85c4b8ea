"""
NLSY79 (DiscoveryBench): How does the consideration of academic characteristics
alter the effects of SES and race on BA-degree completion?

DATA-GROUNDED CAVEAT: no post-1979 education variable exists in the schema, so true
BA completion is unobservable. Primary outcome = 'Highest grade completed 1979' >= 13
(post-secondary schooling proxy), measured among respondents AT RISK of that outcome
(ages 18-22 in 1979; for ages 14-17 the outcome is structurally impossible: 1/5582).
hg>=16 (true BA proxy) has only 37-39 events -> powerless, not modeled.
"""
import pandas as pd, numpy as np, statsmodels.api as sm, json, warnings
from statsmodels.imputation.mice import MICEData
from scipy import stats
warnings.filterwarnings("ignore")

df = pd.read_csv("data/nls_raw.csv")
C = list(df.columns)
d = pd.DataFrame({
    "age": df[C[1]], "mom": df[C[3]], "dad": df[C[4]], "hg": df[C[5]], "race": df[C[7]],
    "sex": df[C[8]], "famsize": df[C[9]], "inc": df[C[10]], "rank": df[C[17]], "cls": df[C[18]],
    "asv_ar": df[C[19]], "asv_wk": df[C[20]], "asv_pc": df[C[21]], "asv_mk": df[C[22]]})
d.loc[d.hg == 95, "hg"] = np.nan                     # sentinel 95 -> missing
d = d[d.hg.notna()].reset_index(drop=True)
d["y"] = (d.hg >= 13).astype(int)                    # PRIMARY outcome
d["log_inc"] = np.log1p(d.inc.clip(lower=0))         # zeros = true zeros (sensitivity drops them)
d["zero_inc"] = (d.inc == 0).astype(int)

def z(s): return (s - s.mean()) / s.std(ddof=0)

def make_ses(frame):
    comp = pd.DataFrame({"a": z(frame.log_inc), "b": z(frame.mom),
                         "c": z(frame.dad), "e": z(-frame.famsize)})
    ind = pd.DataFrame({"ses_miss_inc": comp.a.isna().astype(int),
                        "ses_miss_mom": comp.b.isna().astype(int),
                        "ses_miss_dad": comp.c.isna().astype(int)})
    ses = comp.fillna(0.0).mean(axis=1)
    return ses, ind

def make_acad(frame):
    a = ["asv_ar", "asv_wk", "asv_pc", "asv_mk"]
    Z = pd.DataFrame({("z" + c): z(frame[c]) for c in a})
    amiss = pd.DataFrame({"asv_miss": Z.isna().all(axis=1).astype(int)})
    rank_pct = 100 * (1 - frame["rank"] / frame["cls"])
    rmiss = pd.DataFrame({"rank_miss": rank_pct.isna().astype(int)})
    log_cls = np.log(frame["cls"]); cmiss = pd.DataFrame({"cls_miss": log_cls.isna().astype(int)})
    out = pd.concat([Z.fillna(0.0), amiss, rank_pct.fillna(0.0).rename("rank_pct"), rmiss,
                     log_cls.fillna(log_cls.mean()).rename("log_cls"), cmiss], axis=1)
    return out

# sample restricted to at-risk ages 18-22 for primary models
s = d[d.age >= 18].reset_index(drop=True).copy()
s["female"] = (s.sex == 2).astype(int)
s["black"], s["hisp"] = (s.race == 1).astype(int), (s.race == 2).astype(int)
for a in range(18, 23): s[f"age{a}"] = (s.age == a).astype(int)
s["ses"], s_ind = make_ses(s); s = pd.concat([s, s_ind], axis=1)
acad = make_acad(s); s = pd.concat([s, acad], axis=1)
n_ev = s.y.sum()
print(f"PRIMARY SAMPLE ages 18-22: n={len(s)}, events(hg>=13)={n_ev} ({n_ev/len(s):.1%})")
print("hg>=16 events in primary sample:", (s.hg >= 16).sum(), "(sensitivity not modeled: powerless)")

base = ["black", "hisp", "female", "age18", "age19", "age20", "age21", "age22",
        "ses_miss_inc", "ses_miss_mom", "ses_miss_dad", "zero_inc", "ses"]
acad_cols = ["zasv_ar", "zasv_wk", "zasv_pc", "zasv_mk", "rank_pct", "log_cls",
             "asv_miss", "rank_miss", "cls_miss"]
keys = ["ses", "black", "hisp"]

def fit(cols, data):
    X = sm.add_constant(data[cols], has_constant="add")
    return sm.GLM(data["y"], X, family=sm.families.Binomial()).fit()

def tab(m, ks=keys):
    return {k: {"b": round(float(m.params[k]), 4), "se": round(float(m.bse[k]), 4),
                "OR": round(float(np.exp(m.params[k])), 3),
                "p": float(f"{m.pvalues[k]:.3g}")} for k in ks}

tabs, atts = {}, {}
def atten(t1, t2, label):
    rows = [{"var": k, "b_M1": t1[k]["b"], "b_M2": t2[k]["b"],
             "OR_M1": t1[k].get("OR", round(float(np.exp(t1[k]["b"])), 3)),
             "OR_M2": t2[k].get("OR", round(float(np.exp(t2[k]["b"])), 3)),
             "pct_change_logodds": round(100 * (t2[k]["b"] - t1[k]["b"]) / abs(t1[k]["b"]), 1)}
            for k in keys]
    a = pd.DataFrame(rows); atts[label] = a
    print(f"\n=== {label} ===\n{a.to_string(index=False)}")

m1 = fit(base, s); m2 = fit(base + acad_cols, s)
tabs["M1_primary"] = tab(m1); tabs["M2_primary"] = tab(m2)
print("\nM1 (SES+race+sex+age), primary:\n", pd.DataFrame(tabs["M1_primary"]).T.to_string())
print("\nM2 (M1 + 4 ASVAB z + rank pct + class size), primary:\n", pd.DataFrame(tabs["M2_primary"]).T.to_string())
atten(tabs["M1_primary"], tabs["M2_primary"], "ATTENUATION primary (ages 18-22, missing-indicator, n=%d)" % len(s))

# ASVAB composite variant (mean of 4 z) to reduce multicollinearity
s["asv_mean"] = s[["zasv_ar", "zasv_wk", "zasv_pc", "zasv_mk"]].mean(axis=1)
m2c = fit(base + ["asv_mean", "rank_pct", "log_cls", "asv_miss", "rank_miss", "cls_miss"], s)
tabs["M2_primary_composite"] = tab(m2c)
print("\nM2-composite (single ASVAB mean z):\n", pd.DataFrame(tabs["M2_primary_composite"]).T.to_string())

# ---------- complete cases within 18-22 ----------
cc_cols = ["log_inc", "mom", "dad", "famsize", "y", "black", "hisp", "female", "age",
           "asv_ar", "asv_wk", "asv_pc", "asv_mk", "rank", "cls"]
cc = s[s[cc_cols].notna().all(axis=1)].copy()
cc["ses"] = (z(cc.log_inc) + z(cc.mom) + z(cc.dad) + z(-cc.famsize)) / 4
for c in ["asv_ar", "asv_wk", "asv_pc", "asv_mk"]: cc["z" + c] = z(cc[c])
cc["rank_pct"] = z(100 * (1 - cc["rank"] / cc["cls"])); cc["log_cls"] = z(np.log(cc.cls))
for c in ["asv_ar","asv_wk","asv_pc","asv_mk"]: cc["z"+c] = z(cc[c])
bc = ["black", "hisp", "female", "age18", "age19", "age20", "age21", "age22", "ses"]
ac = ["zasv_ar", "zasv_wk", "zasv_pc", "zasv_mk", "rank_pct", "log_cls"]
m1c, m2c2 = fit(bc, cc), fit(bc + ac, cc)
tabs["M1_cc"], tabs["M2_cc"] = tab(m1c), tab(m2c2)
print(f"\nComplete cases 18-22: n={len(cc)}, events={cc.y.sum()}")
atten(tabs["M1_cc"], tabs["M2_cc"], "ATTENUATION complete-case 18-22")

# ---------- multiple imputation (MICE m=5) within 18-22 ----------
iv = ["log_inc", "mom", "dad", "famsize", "asv_ar", "asv_wk", "asv_pc", "asv_mk",
      "rank", "cls", "y", "female", "age", "zero_inc"]
mice = MICEData(s[iv].copy(), perturbation_method="boot"); mice.update_all(10)
res = []
for i in range(5):
    im = mice.data
    g = pd.DataFrame(index=s.index)
    g["ses"] = (z(im.log_inc) + z(im.mom) + z(im.dad) + z(-im.famsize)) / 4
    g["zasv_ar"], g["zasv_wk"], g["zasv_pc"], g["zasv_mk"] = [z(im[c]) for c in iv[4:8]]
    g["rank_pct"] = z(100 * (1 - im["rank"] / im["cls"]))
    g["log_cls"] = z(np.log(im.cls.clip(lower=1)))
    for c in ["black", "hisp", "female", "age18", "age19", "age20", "age21", "age22", "y"]:
        g[c] = s[c]
    m1i = fit(bc, g); m2i = fit(bc + ac, g)
    res.append((m1i.params[keys], m1i.bse[keys], m2i.params[keys], m2i.bse[keys]))
    mice.update_all(1)
def rubin(P, S):
    P = pd.concat(P, axis=1); S = pd.concat(S, axis=1)
    b = P.mean(axis=1); v = (S ** 2).mean(axis=1) + (1 + 1 / len(P.columns)) * P.var(axis=1, ddof=1)
    return b, np.sqrt(v)
b1, se1 = rubin([r[0] for r in res], [r[1] for r in res])
b2, se2 = rubin([r[2] for r in res], [r[3] for r in res])
tabs["M1_MI"] = {k: {"b": round(b1[k], 4), "se": round(se1[k], 4)} for k in keys}
tabs["M2_MI"] = {k: {"b": round(b2[k], 4), "se": round(se2[k], 4)} for k in keys}
atten(tabs["M1_MI"], tabs["M2_MI"], "ATTENUATION multiple imputation (m=5), 18-22")

# ---------- sensitivity: income zeros excluded ----------
sz = s[s.zero_inc == 0].copy()
sesz, indem = make_ses(sz); sz["ses"] = sesz; sz = pd.concat([sz, indem], axis=1)
bz = [c for c in base if c != "zero_inc"]
m1z, m2z = fit(bz, sz), fit(bz + acad_cols, sz)
atten(tab(m1z), tab(m2z), f"SENSITIVITY income zeros excluded (n={len(sz)})")

# ---------- sensitivity: full sample, continuous age ----------
f = d.copy(); f["female"] = (f.sex == 2).astype(int)
f["black"], f["hisp"] = (f.race == 1).astype(int), (f.race == 2).astype(int)
f["age_c"] = f.age - 18; f["age_c2"] = f.age_c ** 2
f["ses"], fi = make_ses(f); f = pd.concat([f, fi], axis=1)
fa = make_acad(f); f = pd.concat([f, fa], axis=1)
bf = ["black", "hisp", "female", "age_c", "age_c2", "ses_miss_inc", "ses_miss_mom",
      "ses_miss_dad", "zero_inc", "ses"]
f1, f2 = fit(bf, f), fit(bf + acad_cols, f)
atten(tab(f1), tab(f2), f"SENSITIVITY full sample 14-22, continuous age (n={len(f)})")

# ---------- interaction ----------
s["ses_x_black"], s["ses_x_hisp"] = s.ses * s.black, s.ses * s.hisp
mi = fit(base + acad_cols + ["ses_x_black", "ses_x_hisp"], s)
lr = 2 * (mi.llf - m2.llf)
print("\nInteraction SES x race (M2): LRT chi2=%.2f df=2 p=%.4f | ses_x_black b=%.3f p=%.3f, ses_x_hisp b=%.3f p=%.3f"
      % (lr, stats.chi2.sf(lr, 2), mi.params["ses_x_black"], mi.pvalues["ses_x_black"],
         mi.params["ses_x_hisp"], mi.pvalues["ses_x_hisp"]))

# ---------- diagnostics ----------
print("\nMissingness (primary sample 18-22):")
print(s[["log_inc", "mom", "dad", "asv_ar", "rank_pct", "log_cls"]].isna().mean().round(3).to_string())
mb = s.assign(m=s.asv_ar.isna()).groupby("race").m.agg(["mean", "size"])
mb.index = ["Black", "Hispanic", "NonBlackNH"]
print("\nASVAB missingness by race (18-22):\n", mb.round(3).to_string())
print("\nCorr(SES, mean ASVAB z) = %.2f" % s.assign(_m=s[["asv_ar","asv_wk","asv_pc","asv_mk"]].mean(axis=1))[["ses","_m"]].corr().iloc[0,1])
print("Mean ASVAB z by race:", s.groupby("race")[["asv_ar","asv_wk","asv_pc","asv_mk"]].mean().mean(axis=1).round(2).to_dict())
print("Mean SES by race:", s.groupby("race").ses.mean().round(2).to_dict())
print("Outcome rate by race:", s.groupby("race").y.mean().round(3).to_dict())
ASVsub = s[["asv_ar","asv_wk","asv_pc","asv_mk"]].corr().round(2)
print("\nASVAB subscale correlations:\n", ASVsub.to_string())

for lbl, m in [("M1_primary", m1), ("M2_primary", m2)]:
    t = pd.DataFrame({"b": m.params.round(4), "se": m.bse.round(4), "p": m.pvalues.round(4)})
    print(f"\n{lbl} full coefficients:\n{t.to_string()}")

with open("output/results.json", "w") as fh:
    json.dump(tabs, fh, indent=1)
pd.concat(atts, names=["analysis"]).to_csv("output/attenuation_all.csv")
print("\nSaved: output/results.json, output/attenuation_all.csv")
