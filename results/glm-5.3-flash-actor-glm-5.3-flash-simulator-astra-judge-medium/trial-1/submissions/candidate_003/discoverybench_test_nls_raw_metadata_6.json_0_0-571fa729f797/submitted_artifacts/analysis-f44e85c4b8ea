"""
NLSY79 extract (nls_raw.csv): SES level vs the Black-vs-non-Black gap in early
college-track attainment.

Outcome caveat: the file has NO degree-attainment variable and no post-1979
education variable, so 'Highest grade completed, 1979' >= 13 ("post-secondary
schooling completed by 1979") is used as the primary BA-track proxy and >= 12
as a consistency check. Measured at ages 14-22; NOT observed BA completion.
"""
import numpy as np
import pandas as pd
import statsmodels.formula.api as smf

COLS = {
    'ID# (range 1-12686) 1979': 'id',
    'Age of respondent, 1979': 'age79',
    'Age of respondent at interview date, 1981': 'age81',
    'Highest grade completed, 1979': 'grade79',
    "Highest grade completed by respondent's mother, 1979": 'mgrade',
    "Highest grade completed by respondent's father, 1979": 'fgrade',
    'Racial/ethnic cohort, 1979': 'race',
    'Sex of respondent, 1979': 'sex',
    'Family size, 1979': 'famsize',
    'Total net family income, previous calendar year, 1979': 'income',
}

df = pd.read_csv('data/nls_raw.csv').rename(columns=COLS)

# invalid codes -> NaN (0 and 95 in grade fields)
for c in ['grade79', 'mgrade', 'fgrade']:
    df[c] = df[c].mask(~df[c].between(1, 20))

df['par_grade'] = df[['mgrade', 'fgrade']].max(axis=1)   # parental education

# SES composite: pooled percentile ranks, pairwise-complete mean of components
comp = pd.DataFrame({
    'inc': np.log1p(df['income'].clip(lower=0)).rank(pct=True),
    'ped': df['par_grade'].rank(pct=True),
    'fsz': (-df['famsize']).rank(pct=True),   # family size reversed
})
df['ses_raw'] = comp.mean(axis=1)                              # primary
df['ses_cc_raw'] = comp.mean(axis=1)                           # + complete-case filter
df['ses_mi_raw'] = comp.fillna(comp.median()).mean(axis=1)     # median-imputed

for raw, terc in [('ses_raw', 'ses_terc'), ('ses_cc_raw', 'ses_cc_terc'),
                  ('ses_mi_raw', 'ses_mi_terc')]:
    df[terc] = pd.qcut(df[raw], q=3, labels=['Low', 'Mid', 'High'], duplicates='drop')

# outcomes
df['coll13'] = df['grade79'].ge(13).astype(float)   # primary outcome A
df['coll12'] = df['grade79'].ge(12).astype(float)   # consistency outcome B
df.loc[df['grade79'].isna(), ['coll13', 'coll12']] = np.nan

df['black'] = (df['race'] == 1).astype(float)        # primary: Black(1) vs pooled(2+3)
df['black_vs_other3'] = (df['race'] == 1).astype(float)
df.loc[df['race'] == 2, 'black_vs_other3'] = np.nan  # sensitivity: exclude Hispanic
df['male'] = (df['sex'] == 1).astype(float)

def wilson(k, n, z=1.96):
    if n == 0: return (np.nan, np.nan)
    p, den = k/n, 1 + z**2/n
    ctr = (p + z**2/(2*n)) / den
    half = z*np.sqrt(p*(1-p)/n + z**2/(4*n**2)) / den
    return (max(0., ctr-half), min(1., ctr+half))

def gap_table(d, outcome, ses_col='ses_terc', race_col='black'):
    rows = []
    for ses in ['Low', 'Mid', 'High']:
        s = d[d[ses_col] == ses]
        rb = s.loc[s[race_col] == 1, outcome].dropna()
        rn = s.loc[s[race_col] == 0, outcome].dropna()
        pB, pN = rb.mean(), rn.mean()
        gap = pN - pB
        rr = pB / pN if pN > 0 else np.nan
        se_g = np.sqrt(pB*(1-pB)/len(rb) + pN*(1-pN)/len(rn))
        ci_g = (gap-1.96*se_g, gap+1.96*se_g)
        se_log = (np.sqrt((1-pB)/(len(rb)*pB) + (1-pN)/(len(rn)*pN))
                  if pB > 0 and pN > 0 else np.nan)
        ci_r = ((np.exp(np.log(rr)-1.96*se_log), np.exp(np.log(rr)+1.96*se_log))
                if np.isfinite(se_log) else (np.nan, np.nan))
        rows.append({'SES': ses, 'n_Black': len(rb), 'n_NonBlack': len(rn),
                     'rate_Black': pB, 'rate_Black_CI': f"[{wilson(len(rb)*pB if pB==pB else 0, len(rb))[0]:.3f},{wilson(len(rb)*pB, len(rb))[1]:.3f}]" if pB==pB else '',
                     'rate_NonBlack': pN,
                     'gap_NonBlack_minus_Black': gap, 'gap_CI': f"[{ci_g[0]:+.3f},{ci_g[1]:+.3f}]",
                     'RR_Black_vs_NonBlack': rr, 'RR_CI': f"[{ci_r[0]:.3f},{ci_r[1]:.3f}]"})
    return pd.DataFrame(rows)

def logit_run(outcome, ses_terc, race_col, subset=None, label=''):
    d = (df if subset is None else df[subset]).dropna(
        subset=[outcome, ses_terc, race_col, 'male', 'age79']).copy()
    d['ses_ord'] = d[ses_terc].map({'Low': 0, 'Mid': 1, 'High': 2}).astype(float)
    m = smf.logit(f'{outcome} ~ {race_col} + ses_ord + {race_col}:ses_ord + male + age79',
                  data=d).fit(disp=0)
    ia, ip = m.params[f'{race_col}:ses_ord'], m.pvalues[f'{race_col}:ses_ord']
    coefs = m.summary2().tables[1][['Coef.', 'P>|z|']].round(4)
    print(f'--- {label} (n={int(m.nobs)}) ---')
    print(coefs.to_string())
    print(f'interaction {race_col}:ses_ord coef={ia:+.4f} p={ip:.4g} -> '
          f'{"gap NARROWS with SES" if ia < 0 else "gap WIDENS with SES"}\n')
    return ia, ip

old = df['age79'] >= 19

print('='*100)
print('SECTION 1: PRIMARY — outcome A (grade>=13 by 1979), composite SES terciles,')
print('Black vs non-Black pooled, FULL SAMPLE')
print('='*100)
t13_full = gap_table(df.dropna(subset=['ses_terc', 'coll13']), 'coll13')
print(t13_full.round(4).to_string(index=False))

print('\n' + '='*100)
print('SECTION 2: CONSISTENCY — outcome B (grade>=12 by 1979), FULL SAMPLE')
print('='*100)
t12_full = gap_table(df.dropna(subset=['ses_terc', 'coll12']), 'coll12')
print(t12_full.round(4).to_string(index=False))

print('\n' + '='*100)
print(f'SECTION 3: AGE SENSITIVITY — ages >= 19 in 1979 (n={int(old.sum())}, Black n={int(df.loc[old,"black"].sum())})')
print('='*100)
t13_old = gap_table(df[old].dropna(subset=['ses_terc', 'coll13']), 'coll13')
print('Outcome A (>=13):'); print(t13_old.round(4).to_string(index=False))
t12_old = gap_table(df[old].dropna(subset=['ses_terc', 'coll12']), 'coll12')
print('Outcome B (>=12):'); print(t12_old.round(4).to_string(index=False))

print('\n' + '='*100)
print('SECTION 4: SES SENSITIVITY (outcome A, full sample)')
print('='*100)
t13_cc = gap_table(df.dropna(subset=['ses_cc_terc', 'coll13']), 'coll13', ses_col='ses_cc_terc')
print('Complete-case SES:'); print(t13_cc.round(4).to_string(index=False))
t13_mi = gap_table(df.dropna(subset=['ses_mi_terc', 'coll13']), 'coll13', ses_col='ses_mi_terc')
print('Median-imputed SES:'); print(t13_mi.round(4).to_string(index=False))

print('\n' + '='*100)
print('SECTION 5: RACE-DEFINITION SENSITIVITY — Black vs non-Black non-Hispanic only (outcome A)')
print('='*100)
t13_r3 = gap_table(df.dropna(subset=['ses_terc', 'coll13', 'black_vs_other3']),
                   'coll13', race_col='black_vs_other3')
print(t13_r3.round(4).to_string(index=False))

print('\n' + '='*100)
print('SECTION 6: LOGISTIC REGRESSIONS — race + ses_ord + race:ses_ord + male + age79')
print('='*100)
specs = [
    ('A full primary',  logit_run('coll13', 'ses_terc', 'black', label='Outcome A (>=13), full sample, primary')),
    ('B full',          logit_run('coll12', 'ses_terc', 'black', label='Outcome B (>=12), full sample')),
    ('A ages>=19',      logit_run('coll13', 'ses_terc', 'black', subset=old, label='Outcome A (>=13), ages>=19')),
    ('B ages>=19',      logit_run('coll12', 'ses_terc', 'black', subset=old, label='Outcome B (>=12), ages>=19')),
    ('A complete-case', logit_run('coll13', 'ses_cc_terc', 'black', label='Outcome A, complete-case SES')),
    ('A median-imputed',logit_run('coll13', 'ses_mi_terc', 'black', label='Outcome A, median-imputed SES')),
    ('A Black-vs-NBNH', logit_run('coll13', 'ses_terc', 'black_vs_other3', label='Outcome A, Black vs non-Black non-Hispanic')),
]
print('='*100)
print('SECTION 7: INTERACTION-STABILITY SUMMARY')
print('='*100)
stab = pd.DataFrame([(k, v[0], v[1]) for k, v in specs],
                    columns=['spec', 'interaction_coef_black_x_ses', 'p_value'])
print(stab.round(4).to_string(index=False))

print('\nOverall outcome rates by race (rows with non-missing SES & outcome):')
base = df.dropna(subset=['ses_terc'])
print(base.groupby('black')[['coll13', 'coll12']].agg(['mean', 'count']).round(4).to_string())
print('\nSES composition check (Black share per tercile):')
print(pd.crosstab(base['ses_terc'], base['black'], normalize='index').round(3).to_string())
print('\nSES missingness: ses_terc missing %.1f%% of rows' % (100*df['ses_terc'].isna().mean()))

with pd.ExcelWriter('results_tables.xlsx') as xw:
    t13_full.to_excel(xw, sheet_name='A_full_primary')
    t12_full.to_excel(xw, sheet_name='B_full')
    t13_old.to_excel(xw, sheet_name='A_ages19plus')
    t12_old.to_excel(xw, sheet_name='B_ages19plus')
    t13_cc.to_excel(xw, sheet_name='A_completecase_SES')
    t13_mi.to_excel(xw, sheet_name='A_medianimputed_SES')
    t13_r3.to_excel(xw, sheet_name='A_Black_vs_NBNH')
    stab.to_excel(xw, sheet_name='interaction_summary')
print('\nSaved: results_tables.xlsx')
