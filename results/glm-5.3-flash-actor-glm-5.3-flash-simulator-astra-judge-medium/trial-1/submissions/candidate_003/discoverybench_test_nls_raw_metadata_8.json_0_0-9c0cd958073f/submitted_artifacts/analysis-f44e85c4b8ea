"""NLSY79: median family net wealth by racial/ethnic cohort, 1985/1990/1996."""
import pandas as pd
import numpy as np

df = pd.read_csv('/workspace/data/nls_raw.csv')
RACE = 'Racial/ethnic cohort, 1979'
WEALTH = ['Family net wealth, 1985', 'Family net wealth, 1990',
          'Family net wealth, 1996 (key data point)']
YEARS = [1985, 1990, 1996]
LABEL = {1: 'BLACK', 2: 'HISPANIC', 3: 'NON-BLACK NON-HISPANIC (white proxy)'}

def medians(frame):
    rows = []
    for c, y in zip(WEALTH, YEARS):
        for g, lab in LABEL.items():
            v = frame.loc[frame[RACE] == g, c].dropna()
            rows.append({
                'year': y, 'group': lab, 'n': len(v),
                'median': v.median(),
                'mean': v.mean(),
                'p25': v.quantile(.25), 'p75': v.quantile(.75),
                'pct_negative': 100 * (v < 0).mean(),
                'pct_zero': 100 * (v == 0).mean(),
            })
    return pd.DataFrame(rows)

def gaps(m):
    out = []
    for y in YEARS:
        my = m[m.year == y].set_index('group')
        w = my.loc['NON-BLACK NON-HISPANIC (white proxy)', 'median']
        for mino in ['BLACK', 'HISPANIC']:
            v = my.loc[mino, 'median']
            out.append({'year': y, 'comparison': f'white vs {mino}',
                        'white_median': w, 'minority_median': v,
                        'gap_$': w - v, 'ratio_white/minority': w / v})
    return pd.DataFrame(out)

print('=' * 70)
print('A) FULL SAMPLE: medians by year x race (non-NaN only; negatives=real debts kept)')
m_full = medians(df)
print(m_full.round(1).to_string(index=False))

print('=' * 70)
print('B) GAPS white vs black / Hispanic (full sample)')
g_full = gaps(m_full)
print(g_full.round(2).to_string(index=False))

print('=' * 70)
print('C) SENSITIVITY: balanced panel (wealth non-missing in all 3 years)')
panel = df.dropna(subset=WEALTH)
print('panel n =', len(panel))
m_panel = medians(panel)
print(m_panel.round(1).to_string(index=False))
g_panel = gaps(m_panel)
print(g_panel.round(2).to_string(index=False))

print('=' * 70)
print('D) attrition check: share of each group retained in 1996 vs 1985 baseline')
for g, lab in LABEL.items():
    base = df.loc[df[RACE] == g, WEALTH[0]].notna().sum()
    keep = df.loc[df[RACE] == g, WEALTH[2]].notna().sum()
    print(f'{lab}: 1985 n={base} -> 1996 n={keep} (retained {100*keep/base:.1f}%)')

print('=' * 70)
print('E) top-value check (possible top-codes; does not affect medians)')
for c in WEALTH:
    v = df[c].dropna()
    print(c, 'top5:', sorted(v.nlargest(5).tolist()))

m_full.to_csv('/workspace/outputs/medians_full.csv', index=False)
g_full.to_csv('/workspace/outputs/gaps_full.csv', index=False)
m_panel.to_csv('/workspace/outputs/medians_panel.csv', index=False)
g_panel.to_csv('/workspace/outputs/gaps_panel.csv', index=False)
print('\nSaved: outputs/medians_full.csv, gaps_full.csv, medians_panel.csv, gaps_panel.csv')
