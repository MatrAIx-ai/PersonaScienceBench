"""
NLS SES & BA completion — nested logistic analysis (DiscoveryBench task).
Question: which variable's effect on BA completion drops from 0.5024 to 0.0923
(becoming insignificant) when SES and academic characteristics are added?
"""
import pandas as pd, numpy as np, statsmodels.api as sm, json, warnings
warnings.filterwarnings('ignore')

df = pd.read_csv('data/nls_ses_processed.csv', index_col=0)
y = df['BA DEGREE COMPLETED'].astype(int)
A = 'ABILITY: COMPOSITE OF ASVAB SCORE'; P = 'PERCENTILE IN CLASS'
F = 'FAMILY SIZE OF SAMPLE'; SES = 'SES'
R = pd.get_dummies(df['SAMPLE_RACE'], drop_first=True, dtype=float)   # ref = Black
S = pd.get_dummies(df['SAMPLE_SEX'], drop_first=True, dtype=float)    # Male

sd = {c: df[c].std() for c in [F, SES, A, P]}

def fit(num_cols, sub=None, drop_race=None):
    d = df if sub is None else sub
    yy = d['BA DEGREE COMPLETED'].astype(int)
    X = pd.DataFrame(index=d.index)
    if drop_race is None:
        X = pd.concat([X, pd.get_dummies(d['SAMPLE_RACE'], drop_first=True, dtype=float)], axis=1)
    else:  # binary White vs non-White
        X['White'] = (d['SAMPLE_RACE'] == 'White').astype(float)
    X = pd.concat([X, pd.get_dummies(d['SAMPLE_SEX'], drop_first=True, dtype=float)], axis=1)
    for c in num_cols: X[c] = d[c]
    X = sm.add_constant(X)
    m = sm.Logit(yy, X).fit(disp=0)
    return m

def tab(m, scale_factors=None):
    t = m.summary2().tables[1][['Coef.', 'Std.Err.', 'P>|z|']].copy()
    if scale_factors:
        for v in t.index:
            if v in scale_factors: t.loc[v, 'Coef.'] *= scale_factors[v]
    t['Coef.'] = t['Coef.'].round(4); t['Std.Err.'] = t['Std.Err.'].round(4)
    t['P>|z|'] = t['P>|z|'].round(4)
    return t

lines = []
def say(s=''): print(s); lines.append(s)

# ---------- Main nested sequence ----------
models = {
 'M1 social background (race, sex, family size)': fit([F]),
 'M2 = M1 + SES': fit([F, SES]),
 'M3 full = M2 + ability + class percentile': fit([F, SES, A, P]),
}
say('='*80)
for name, m in models.items():
    say(f'\n--- {name}  (n={int(m.nobs)}, pseudo R2={m.prsquared:.4f}) ---')
    say(tab(m).to_string())

# standardized-scale version of M1 and M3
z = df[[F, SES, A, P]].copy()
for c in z.columns: z[c] = (z[c] - z[c].mean()) / z[c].std()
def fit_z(cols):
    X = pd.concat([R, S] + [z[[c]] for c in cols], axis=1)
    return sm.Logit(y, sm.add_constant(X)).fit(disp=0)
say('\n--- Standardized-scale M1 (family size z-scored) ---')
say(tab(fit_z([F]), {'FAMILY SIZE OF SAMPLE': 1.0}).to_string())
say('\n--- Standardized-scale M3 (all continuous predictors z-scored) ---')
say(tab(fit_z([F, SES, A, P])).to_string())

# ---------- Robustness ----------
say('\n' + '='*80 + '\nROBUSTNESS CHECKS')
checks = [
 ('R1: binary race (White vs non-White), M1 vs M3', fit([F], drop_race='3cat'), fit([F, SES, A, P], drop_race='3cat')),
 ('R2: full model EXCLUDING family size (M1 vs M3)', fit([]), fit([SES, A, P])),
 ('R3: White+Black subsample (drop Hispanic), M1 vs M3', fit([F], sub=df[df.SAMPLE_RACE != 'Hispanic']),
   fit([F, SES, A, P], sub=df[df.SAMPLE_RACE != 'Hispanic'])),
 ('R4: M3 with SES+ability only (no percentile)', fit([F, SES, A]), None),
 ('R5: M3 with SES+percentile only (no ability)', fit([F, SES, P]), None),
]
for name, m1, m2 in checks:
    say(f'\n--- {name} ---')
    say(tab(m1).to_string())
    if m2 is not None: say('-- full model: --'); say(tab(m2).to_string())

# ---------- Identification summary ----------
say('\n' + '='*80)
say('IDENTIFICATION SUMMARY (candidate variables, M1 -> M3 logit coefficients):')
m1, m3 = models['M1 social background (race, sex, family size)'], models['M3 full = M2 + ability + class percentile']
t1, t3 = m1.summary2().tables[1], m3.summary2().tables[1]
for v in t1.index:
    if v == 'const': continue
    say(f"  {v:38s} {t1.loc[v,'Coef.']:8.4f} (p={t1.loc[v,'P>|z|']:.4f})  ->  "
        f"{t3.loc[v,'Coef.']:8.4f} (p={t3.loc[v,'P>|z|']:.4f})")

with open('output/results_log.txt', 'w') as f:
    f.write('\n'.join(lines))
print('\nSaved output/results_log.txt')
