"""
Full analysis: Is the SES -> BA-completion relation moderated by race?
Data: data/nls_ses_processed.csv (NLS background/academic-resources file).

Primary test: logistic GLM  BA ~ SES * race + sex + family_size + ability + percentile
- joint 2-df LRT of the SES x race interactions
- race-specific SES odds ratios (simple slopes) with 95% CIs (delta method)
- predicted-probability display
Sensitivities: Firth penalized logistic (rare events), within-race standardized SES,
probability-scale (AME) view, pooled marginal SES effect.
"""
import warnings
import numpy as np
import pandas as pd
import statsmodels.api as sm
from scipy import stats

warnings.filterwarnings("ignore")
np.random.seed(0)
pd.set_option("display.width", 220)

RACE_REF = "White"          # reference category
SES_SD_FULL = None          # filled below

# ---------------------------------------------------------------- load / prep
df = pd.read_csv("data/nls_ses_processed.csv", index_col=0)
df["BA"] = df["BA DEGREE COMPLETED"].astype(int)
df["MALE"] = (df["SAMPLE_SEX"] == "Male").astype(float)
SES_SD_FULL = df["SES"].std()
print(f"n = {len(df)}, BA events = {df['BA'].sum()} ({df['BA'].mean():.4f})")
print(f"SES full-sample SD = {SES_SD_FULL:.4f}")
print(f"events by race: {df.groupby('SAMPLE_RACE')['BA'].sum().to_dict()}")

# scaled controls for numerical stability (SES kept on raw units)
df["ABIL1k"] = df["ABILITY: COMPOSITE OF ASVAB SCORE"] / 1000.0
df["PCTL10"] = df["PERCENTILE IN CLASS"] / 10.0

def design(frame, ses_col="SES", interact=True):
    X = pd.DataFrame(index=frame.index)
    X["SES"] = frame[ses_col]
    for r in ["Hispanic", "Black"]:           # White = reference
        X[f"race_{r}"] = (frame["SAMPLE_RACE"] == r).astype(float)
    X["MALE"] = frame["MALE"]
    X["FAMSIZE"] = frame["FAMILY SIZE OF SAMPLE"]
    X["ABIL1k"] = frame["ABIL1k"]
    X["PCTL10"] = frame["PCTL10"]
    if interact:
        for r in ["Hispanic", "Black"]:
            X[f"SESx{r}"] = frame[ses_col] * X[f"race_{r}"]
    return sm.add_constant(X, has_constant="add")

y = df["BA"].values

# ---------------------------------------------------------------- main model
X = design(df)
main = sm.GLM(y, X, family=sm.families.Binomial()).fit()
print("\n=== MAIN MODEL: BA ~ SES*race + sex + famsize + ability + percentile ===")
print(main.summary().tables[1])

# joint 2-df LRT of interactions
Xr = design(df, interact=False)
red = sm.GLM(y, Xr, family=sm.families.Binomial()).fit()
lr = 2 * (main.llf - red.llf)
p_lr = stats.chi2.sf(lr, df=2)
print(f"\nJoint LRT of SES x race interactions: chi2(2) = {lr:.3f}, p = {p_lr:.4g}")

# race-specific simple slopes (SES coefficient per race) + delta-method CIs
V = main.cov_params()
names = list(main.params.index)
print("\n=== Race-specific SES effect (log-odds per 1 SES unit) ===")
slope_rows = []
for r in ["White", "Black", "Hispanic"]:
    if r == "White":
        vec = pd.Series(0.0, index=names); vec["SES"] = 1.0
    else:
        vec = pd.Series(0.0, index=names); vec["SES"] = 1.0; vec[f"SESx{r}"] = 1.0
    b = float(vec @ main.params)
    se = float(np.sqrt(vec @ V @ vec))
    lo, hi = b - 1.96 * se, b + 1.96 * se
    slope_rows.append(dict(race=r, beta=b, se=se,
                           OR_unit=np.exp(b),
                           OR_per_SD=np.exp(b * SES_SD_FULL),
                           CI_or_unit=(np.exp(lo), np.exp(hi))))
    print(f"{r:>9}: beta={b:+.3f} (SE {se:.3f})  OR/unit={np.exp(b):.2f} "
          f"[{np.exp(lo):.2f},{np.exp(hi):.2f}]  OR/SD={np.exp(b*SES_SD_FULL):.2f}")

# joint Wald test of the two interaction terms
R = np.zeros((2, len(names)))
for j, r in enumerate(["Hispanic", "Black"]):
    R[j, names.index(f"SESx{r}")] = 1.0
w = R @ main.params
wWald = float(w @ np.linalg.solve(R @ V @ R.T, w))
print(f"Joint Wald chi2(2) = {wWald:.3f}, p = {stats.chi2.sf(wWald, 2):.4g}")

# pooled/marginal SES effect
pooled = sm.GLM(y, Xr, family=sm.families.Binomial()).fit()
b = pooled.params["SES"]; se = pooled.bse["SES"]
print(f"\nPooled model (no interaction) SES slope: {b:.3f} (SE {se:.3f}), "
      f"OR/unit={np.exp(b):.2f} [{np.exp(b-1.96*se):.2f},{np.exp(b+1.96*se):.2f}], "
      f"p={pooled.pvalues['SES']:.3g}")
# average marginal effect of +1 SD SES on P(BA), averaging over race mix
p0 = main.predict(X); p1 = main.predict(X.assign(SES=X["SES"] + SES_SD_FULL))
print(f"Average marginal effect of +1 SD SES: {np.mean(p1-p0)*100:.2f} percentage points "
      f"(mean predicted P(BA) {p0.mean()*100:.2f}% -> {p1.mean()*100:.2f}%)")

# ------------------------------------------------- predicted probabilities
print("\n=== Predicted P(BA) by race across SES (covariates at sample means) ===")
grid = np.linspace(-2, 2.2, 9)  # stay within observed SES range
Xg = design(pd.DataFrame({
    "SES": np.tile(grid, 3),
    "SAMPLE_RACE": np.repeat(["White", "Black", "Hispanic"], len(grid)),
    "MALE": df["MALE"].mean(), "FAMILY SIZE OF SAMPLE": df["FAMILY SIZE OF SAMPLE"].mean(),
    "ABIL1k": df["ABIL1k"].mean(), "PCTL10": df["PCTL10"].mean()}))
pred = main.predict(Xg).values.reshape(3, -1)
print("SES:    " + "  ".join(f"{g:5.2f}" for g in grid))
for i, r in enumerate(["White", "Black", "Hispanic"]):
    print(f"{r:>9}: " + "  ".join(f"{v*100:5.2f}" for v in pred[i]) + "   (%)")

# ------------------------------------------------- Firth penalized logistic
def firth_logit(Xm, yv, tol=1e-8, maxit=500):
    """Firth (1993) penalized-likelihood logistic regression via modified-score IRLS."""
    n, k = Xm.shape
    Xd = np.asarray(Xm, float); yd = np.asarray(yv, float)
    beta = np.zeros(k)
    # cold start with MLE-ish ridge start
    for it in range(maxit):
        eta = Xd @ beta
        p = 1 / (1 + np.exp(-eta))
        w = np.clip(p * (1 - p), 1e-10, None)
        XtW = Xd.T * w
        I = XtW @ Xd
        Iinv = np.linalg.pinv(I)
        # modified score: U* = X'(y - p) + 0.5 * X' (h * (1 - 2p))
        h = np.einsum("ij,jk,ik->i", Xd, Iinv, Xd) * w
        U = Xd.T @ (yd - p) + 0.5 * Xd.T @ (h * (1 - 2 * p))
        step = Iinv @ U
        # step halving
        ll = lambda b: np.sum(yd * (Xd @ b) - np.log1p(np.exp(np.clip(Xd @ b, -500, 500))))
        t = 1.0; b_new = beta + t * step
        while ll(b_new) < ll(beta) and t > 1e-10:
            t /= 2; b_new = beta + t * step
        if np.max(np.abs(b_new - beta)) < tol:
            beta = b_new; break
        beta = b_new
    eta = Xd @ beta; p = 1 / (1 + np.exp(-eta))
    w = np.clip(p * (1 - p), 1e-10, None)
    I = (Xd.T * w) @ Xd
    Iinv = np.linalg.pinv(I)
    h = np.einsum("ij,jk,ik->i", Xd, Iinv, Xd) * w
    # Firth covariance: inverse of modified information I - 0.5*sum... use plain I (conservative enough)
    return beta, Iinv, it

Xm = X.values
print("\n=== FIRTH PENALIZED LOGISTIC (rare-event sensitivity), same model ===")
bf, Vf, it = firth_logit(Xm, y)
print(f"converged in {it} iterations")
fnames = list(X.columns)
for nme, bv, sef in zip(fnames, bf, np.sqrt(np.diag(Vf))):
    z = bv / sef
    print(f"  {nme:>12}: {bv:+8.3f} (SE {sef:.3f}) z={z:+.2f}  OR={np.exp(bv):6.2f}")
print("Race-specific SES slopes (Firth):")
for r in ["White", "Black", "Hispanic"]:
    vec = np.zeros(len(fnames)); vec[fnames.index("const")] = 0
    vec[fnames.index("SES")] = 1.0
    if r != "White":
        vec[fnames.index(f"SESx{r}")] = 1.0
    b = float(vec @ bf); se = float(np.sqrt(vec @ Vf @ vec))
    print(f"  {r:>9}: beta={b:+.3f} (SE {se:.3f}) OR/unit={np.exp(b):.2f} "
          f"[{np.exp(b-1.96*se):.2f},{np.exp(b+1.96*se):.2f}] OR/SD={np.exp(b*SES_SD_FULL):.2f}")

# ------------------------------------- within-race standardized SES sensitivity
print("\n=== SENSITIVITY: SES standardized WITHIN race ===")
df["SESz"] = df.groupby("SAMPLE_RACE")["SES"].transform(
    lambda s: (s - s.mean()) / s.std())
Xz = design(df, ses_col="SESz")
mz = sm.GLM(y, Xz, family=sm.families.Binomial()).fit()
Xzr = design(df, ses_col="SESz", interact=False)
rz = sm.GLM(y, Xzr, family=sm.families.Binomial()).fit()
lrz = 2 * (mz.llf - rz.llf)
print(f"Joint LRT of SESz x race: chi2(2) = {lrz:.3f}, p = {stats.chi2.sf(lrz,2):.4g}")
Vz = mz.cov_params()
for r in ["White", "Black", "Hispanic"]:
    vec = pd.Series(0.0, index=Xz.columns)
    vec["SES"] = 1.0  # design() names the SES column "SES" regardless of ses_col
    if r != "White": vec[f"SESx{r}"] = 1.0
    b = float(vec @ mz.params); se = float(np.sqrt(vec @ Vz @ vec))
    print(f"  {r:>9}: beta={b:+.3f} (SE {se:.3f}) OR/1SD-within-race={np.exp(b):.2f} "
          f"[{np.exp(b-1.96*se):.2f},{np.exp(b+1.96*se):.2f}]")

# ------------------------------------------------- probability-scale contrast
print("\n=== Probability-scale view: dP(BA) for +1 SD SES (main model) ===")
for r in ["White", "Black", "Hispanic"]:
    Xr_ = X.copy()
    Xr_["race_Hispanic"] = float(r == "Hispanic"); Xr_["race_Black"] = float(r == "Black")
    Xr_["SESxHispanic"] = Xr_["SES"] * Xr_["race_Hispanic"]
    Xr_["SESxBlack"] = Xr_["SES"] * Xr_["race_Black"]
    p0 = main.predict(Xr_); p1 = main.predict(Xr_.assign(SES=Xr_["SES"] + SES_SD_FULL))
    d = p1 - p0
    print(f"  {r:>9}: mean dP = {d.mean()*100:.2f} pp (range {d.min()*100:.2f}..{d.max()*100:.2f})")

print("\nDone.")
