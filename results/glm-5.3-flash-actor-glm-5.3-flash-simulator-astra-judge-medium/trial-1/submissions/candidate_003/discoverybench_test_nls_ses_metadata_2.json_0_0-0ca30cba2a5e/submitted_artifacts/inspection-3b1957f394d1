"""First-look inspection of data/nls_ses_processed.csv (read-only; no full analysis)."""
import pandas as pd
import numpy as np
import statsmodels.api as sm

pd.set_option("display.width", 200)

df = pd.read_csv("data/nls_ses_processed.csv", index_col=0)
print("shape:", df.shape)
print("\ndtypes:\n", df.dtypes)
print("\nmissingness:\n", df.isna().sum())

print("\n--- categorical distributions ---")
for c in ["SAMPLE_RACE", "SAMPLE_SEX", "BA DEGREE COMPLETED"]:
    print(c, dict(df[c].value_counts(dropna=False)))

print("\n--- numeric summary ---")
num = ["FAMILY SIZE OF SAMPLE", "ABILITY: COMPOSITE OF ASVAB SCORE",
       "PERCENTILE IN CLASS", "SES"]
print(df[num].describe().T.round(3))
for c in num:
    print(f"{c}: negatives={(df[c] < 0).sum()}, min={df[c].min():.3f}, max={df[c].max():.3f}")

df["BA"] = df["BA DEGREE COMPLETED"].astype(int)
print("\n--- BA completion rate ---")
print("overall:", round(df["BA"].mean(), 4))
print(df.groupby("SAMPLE_RACE")["BA"].agg(["mean", "count", "sum"]).round(4))

print("\n--- mean SES by BA status within race ---")
print(df.groupby(["SAMPLE_RACE", "BA"])["SES"].mean().round(3))

print("\n--- per-race logistic slope of BA on SES ---")
for r, g in df.groupby("SAMPLE_RACE"):
    res = sm.GLM(g["BA"].values, sm.add_constant(g[["SES"]].values),
                 family=sm.families.Binomial()).fit()
    b = res.params[1]
    print(f"{r}: slope={b:.3f} OR/unit={np.exp(b):.2f} n={len(g)} events={g['BA'].sum()}")

print("\n--- pooled SES x race model ---")
X = pd.get_dummies(df["SAMPLE_RACE"], prefix="race", drop_first=True).astype(float)
X["SES"] = df["SES"]
for c in [c for c in X.columns if c != "SES"]:
    X["SESx" + c] = df["SES"] * X[c]
X = sm.add_constant(X)
res = sm.GLM(df["BA"].values, X, family=sm.families.Binomial()).fit()
print(res.summary().tables[1])
print("\nCASE ID unique:", df["CASE ID"].is_unique)
