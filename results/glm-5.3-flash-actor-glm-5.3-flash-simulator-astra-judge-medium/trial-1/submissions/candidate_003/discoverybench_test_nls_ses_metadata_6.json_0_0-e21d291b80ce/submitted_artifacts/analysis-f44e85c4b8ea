import pandas as pd, numpy as np, itertools, json

df = pd.read_csv('data/nls_ses_processed.csv')
df['BA'] = df['BA DEGREE COMPLETED'].astype(int)

def or_ha(a, b, c, d):  # a=exposed events, b=exposed nonevents, c=control events, d=control nonevents
    return ((a+0.5)*(d+0.5))/((b+0.5)*(c+0.5))

def se_logor_ha(a,b,c,d):
    return np.sqrt(1/(a+0.5)+1/(b+0.5)+1/(c+0.5)+1/(d+0.5))

results = {}
for q, name in [(3, 'tercile'), (4, 'quartile')]:
    bins = [f'{name[0].upper()}{i+1}' for i in range(q)]
    df['bin'] = pd.qcut(df['SES'], q, labels=bins)
    rows = []
    for b in bins:
        sub = df[df['bin'] == b]
        for ref in ['White', 'Hispanic']:
            # Black vs ref
            bk = sub[sub['SAMPLE_RACE'] == 'Black']; ot = sub[sub['SAMPLE_RACE'] == ref]
            a, bnn = bk['BA'].sum(), (1-bk['BA']).sum()
            c, d = ot['BA'].sum(), (1-ot['BA']).sum()
            OR = or_ha(a, bnn, c, d)
            se = se_logor_ha(a, bnn, c, d)
            rows.append(dict(bin=b, N_Black=len(bk), N_ref=len(ot), ref=ref,
                rate_Black=bk['BA'].mean(), rate_ref=ot['BA'].mean(),
                pp=(bk['BA'].mean()-ot['BA'].mean())*100,
                OR=OR, lo=np.exp(np.log(OR)-1.96*se), hi=np.exp(np.log(OR)+1.96*se)))
    results[name] = pd.DataFrame(rows)
    print(f'===== {name.upper()}S =====')
    print(results[name].round(4).to_string(index=False))

# Logistic regressions
try:
    import statsmodels.formula.api as smf
    df['bin3'] = pd.qcut(df['SES'], 3, labels=['T1','T2','T3'])
    df['Black'] = (df['SAMPLE_RACE']=='Black').astype(int)
    df['Hisp'] = (df['SAMPLE_RACE']=='Hispanic').astype(int)
    df['Female'] = (df['SAMPLE_SEX']=='Female').astype(int)
    abl = 'ABILITY: COMPOSITE OF ASVAB SCORE'.replace(': ','_').replace(' ','_')
    df[abl] = df['ABILITY: COMPOSITE OF ASVAB SCORE']
    df['PCTL'] = df['PERCENTILE IN CLASS']

    for label, extra in [('unadjusted',''), ('adjusted', f' + {abl} + PCTL + Female')]:
        for contrast, term in [('Black','Black'), ('Hispanic','Hisp')]:
            m = smf.logit(f'BA ~ {term} * C(bin3, Treatment(reference="T1"))' + extra, data=df).fit(disp=0)
            print(f'--- {label} logit, {contrast} vs White, interaction ORs (ref T1) ---')
            for k, v in m.params.items():
                if '*' in k and contrast in k:
                    print(f'  {k}: OR={np.exp(v):.3f} p={m.pvalues[k]:.3f}')
            # average marginal effect of race within each bin (AME-style: predicted prob diff)
            print('  predicted BA prob for race within bins (others at observed):')
            for b in ['T1','T2','T3']:
                d0, d1 = df[df['bin3']==b].copy(), df[df['bin3']==b].copy()
                d0[term] = 0; d1[term] = 1
                p0, p1 = m.predict(d0).mean(), m.predict(d1).mean()
                print(f'    {b}: {contrast} {p1*100:.2f}% vs White {p0*100:.2f}%  diff {100*(p1-p0):+.2f} pp')
except ImportError:
    print('statsmodels unavailable')

# Fisher exact p-values for Black vs White by tercile
from scipy.stats import fisher_exact
df['bin3'] = pd.qcut(df['SES'], 3, labels=['T1','T2','T3'])
for b in ['T1','T2','T3']:
    sub = df[df['bin3']==b]
    tab = [[sub[sub.SAMPLE_RACE=='Black'].BA.sum(), (sub.SAMPLE_RACE=='Black').sum()-sub[sub.SAMPLE_RACE=='Black'].BA.sum()],
           [sub[sub.SAMPLE_RACE=='White'].BA.sum(), (sub.SAMPLE_RACE=='White').sum()-sub[sub.SAMPLE_RACE=='White'].BA.sum()]]
    print(f'Fisher {b} Black vs White p={fisher_exact(tab)[1]:.4f}')

# --- interaction coefficients + quartile robustness (added after first run) ---
import statsmodels.formula.api as smf
df['Black'] = (df['SAMPLE_RACE']=='Black').astype(int)
df['Female'] = (df['SAMPLE_SEX']=='Female').astype(int)
df['ASVAB'] = df['ABILITY: COMPOSITE OF ASVAB SCORE']
df['PCTL'] = df['PERCENTILE IN CLASS']
for label, extra in [('unadjusted',''),('adjusted',' + ASVAB + PCTL + Female')]:
    m = smf.logit(f'BA ~ Black * C(bin3, Treatment(reference="T1"))' + extra, data=df).fit(disp=0)
    print(f'--- {label}: interaction ORs Black x tercile (ref T1, White) ---')
    for k,v in m.params.items():
        if 'Black:' in k:
            print(f'  {k}: OR={np.exp(v):.3f} p={m.pvalues[k]:.3f}')
df['bin4'] = pd.qcut(df['SES'], 4, labels=['Q1','Q2','Q3','Q4'])
m4 = smf.logit('BA ~ Black * C(bin4, Treatment(reference="Q1")) + ASVAB + PCTL + Female', data=df).fit(disp=0)
print('--- adjusted quartile robustness: AME Black vs White per quartile ---')
for b in ['Q1','Q2','Q3','Q4']:
    d0, d1 = df[df['bin4']==b].copy(), df[df['bin4']==b].copy()
    d0['Black']=0; d1['Black']=1
    print(f'  {b}: diff {100*(m4.predict(d1).mean()-m4.predict(d0).mean()):+.2f} pp')
