import pandas as pd, numpy as np, statsmodels.api as sm
from itertools import combinations

df = pd.read_csv('data/nls_ses_processed.csv', index_col=0)
y = df['BA DEGREE COMPLETED'].astype(int)
races = ['Black', 'Hispanic', 'White']
TARGET = -0.9568
TOL = 0.005

specs = [
    ('race only', []),
    ('race+SES', ['SES']),
    ('race+ASVAB', ['ABILITY: COMPOSITE OF ASVAB SCORE']),
    ('race+PCTILE', ['PERCENTILE IN CLASS']),
    ('race+SES+ASVAB+PCTILE', ['SES', 'ABILITY: COMPOSITE OF ASVAB SCORE', 'PERCENTILE IN CLASS']),
    ('+FAMSIZE', ['SES', 'ABILITY: COMPOSITE OF ASVAB SCORE', 'PERCENTILE IN CLASS', 'FAMILY SIZE OF SAMPLE']),
    ('+SEX', ['SES', 'ABILITY: COMPOSITE OF ASVAB SCORE', 'PERCENTILE IN CLASS', 'SAMPLE_SEX']),
    ('+FAM+SEX', ['SES', 'ABILITY: COMPOSITE OF ASVAB SCORE', 'PERCENTILE IN CLASS', 'FAMILY SIZE OF SAMPLE', 'SAMPLE_SEX']),
]

def build(ref, covs, std):
    cols = {}
    for r in races:
        if r != ref:
            cols['race:' + r] = (df['SAMPLE_RACE'] == r).astype(float)
    for c in covs:
        if c == 'SAMPLE_SEX':
            cols['SEX_Male'] = (df['SAMPLE_SEX'] == 'Male').astype(float)
        else:
            v = df[c].astype(float)
            if std:
                v = (v - v.mean()) / v.std()
            cols[c if len(c) < 20 else 'ASVAB'] = v
    return sm.add_constant(pd.DataFrame(cols, index=df.index))

hits = []
rows = []
for spec, covs in specs:
    std_options = [False] if not covs else [False, True]
    for std in std_options:
        for ref in races:
            D = build(ref, covs, std)
            res = sm.Logit(y, D).fit(disp=0)
            p = res.params
            # coefficient of each race relative to this ref (0 for ref itself)
            def coef(r):
                if r == ref:
                    return 0.0
                key = [k for k in D.columns if k.startswith('race:') and k.endswith(r)]
                return p[key[0]] if key else None
            for other in races:
                if other == ref:
                    continue
                co, cr = coef(other), coef(ref)
                if co is None or cr is None:
                    continue
                val = co - cr
                tag = spec + (' [z]' if std else '')
                match = abs(val - TARGET) <= TOL
                if match:
                    hits.append((tag, other, ref, val))
                rows.append((tag, other, ref, val, 'MATCH' if match else ''))

print(f"{'spec':<24}{'contrast':<22}{'logodds':>10}  flag")
for tag, other, ref, val, flag in rows:
    print(f"{tag:<24}{other + ' vs ' + ref:<22}{val:>10.4f}  {flag}")

print()
print('Matches within +/-0.005 of -0.9568:')
if hits:
    for tag, other, ref, val in hits:
        print(f'  {tag} | {other} vs {ref}: {val:.6f} (dev {val - TARGET:+.5f})')
else:
    # report closest
    best = min(rows, key=lambda r: abs(r[3] - TARGET))
    print('  none; closest:', best[0], best[1], 'vs', best[2], f'{best[3]:.4f} (dev {best[3]-TARGET:+.4f})')

# also check odds-ratio scale flagging and closest overall
print()
print('Closest 5 contrasts overall:')
for r in sorted(rows, key=lambda r: abs(r[3] - TARGET))[:5]:
    print(f'  {r[0]} | {r[1]} vs {r[2]}: {r[3]:.6f} (dev {r[3]-TARGET:+.5f})')
