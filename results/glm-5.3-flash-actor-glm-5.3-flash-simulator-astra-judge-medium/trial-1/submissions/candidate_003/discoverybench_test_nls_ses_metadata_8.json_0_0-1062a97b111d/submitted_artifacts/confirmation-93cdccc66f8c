import pandas as pd, numpy as np, statsmodels.api as sm

df = pd.read_csv('data/nls_ses_processed.csv', index_col=0)
y = df['BA DEGREE COMPLETED'].astype(int)

cols = {
    'race:Black': (df['SAMPLE_RACE'] == 'Black').astype(float),
    'race:Hispanic': (df['SAMPLE_RACE'] == 'Hispanic').astype(float),
    'SES': df['SES'].astype(float),
    'race:Black x SES': (df['SAMPLE_RACE'] == 'Black').astype(float) * df['SES'].astype(float),
    'race:Hispanic x SES': (df['SAMPLE_RACE'] == 'Hispanic').astype(float) * df['SES'].astype(float),
}
D = sm.add_constant(pd.DataFrame(cols, index=df.index))
res = sm.Logit(y, D).fit(disp=0)
print('MODEL: Logit(BA) ~ C(race) + SES + C(race)*SES   [reference = White]')
print(res.summary2().tables[1].round(6).to_string())
print()
bB = res.params['race:Black']; bH = res.params['race:Hispanic']
print(f"Black    vs White (at SES main effect): {bB:.6f}")
print(f"Hispanic vs White (at SES main effect): {bH:.6f}")
print(f"Black    vs Hispanic:                   {bB-bH:.6f}")
print(f"Odds ratios: Black vs White = {np.exp(bB):.4f}, Hispanic vs White = {np.exp(bH):.4f}")
print(f"Target -0.9568 match: Black vs White dev = {bB - (-0.9568):+.6f}")

# contrast table artifact across all specs
rows = []
COVS = ['SES', 'ABILITY: COMPOSITE OF ASVAB SCORE', 'PERCENTILE IN CLASS', 'FAMILY SIZE OF SAMPLE', 'SAMPLE_SEX']
def design(frame, ref, covs):
    c = {}
    for r in races0:
        if r != ref: c['race:' + r] = (frame['SAMPLE_RACE'] == r).astype(float)
    for x in covs:
        if x == 'SAMPLE_SEX': c['SEX_Male'] = (frame['SAMPLE_SEX'] == 'Male').astype(float)
        else: c[x] = frame[x].astype(float)
    return sm.add_constant(pd.DataFrame(c, index=frame.index))
races0 = ['Black', 'Hispanic', 'White']
for k in range(6):
    for covs in [()] + [c for kk in range(1,6) for c in __import__('itertools').combinations(COVS, kk)] if k==0 else [c for c in __import__('itertools').combinations(COVS, k)]:
        for ref in races0:
            Dm = design(df, ref, list(covs))
            r = sm.Logit(y, Dm).fit(disp=0)
            b = {x: 0.0 for x in races0}
            for x in races0:
                if x == ref: continue
                key = [k2 for k2 in Dm.columns if k2.startswith('race:') and k2.endswith(x)]
                b[x] = r.params[key[0]]
            for o in races0:
                if o == ref: continue
                rows.append({'spec': 'logit ' + ('+'.join(c[:6] for c in covs) or 'race only'),
                             'contrast': f'{o} vs {ref}', 'logodds': round(b[o]-b[ref], 6),
                             'odds_ratio': round(np.exp(b[o]-b[ref]), 4)})
# interaction spec rows
rows.append({'spec': 'logit race*SES (uncentered)', 'contrast': 'Black vs White',
             'logodds': round(bB, 6), 'odds_ratio': round(np.exp(bB), 4)})
rows.append({'spec': 'logit race*SES (uncentered)', 'contrast': 'Hispanic vs White',
             'logodds': round(bH, 6), 'odds_ratio': round(np.exp(bH), 4)})
rows.append({'spec': 'logit race*SES (uncentered)', 'contrast': 'Black vs Hispanic',
             'logodds': round(bB-bH, 6), 'odds_ratio': round(np.exp(bB-bH), 4)})
tab = pd.DataFrame(rows)
tab['dev_from_-0.9568'] = (tab['logodds'] - (-0.9568)).round(6)
tab.to_csv('contrast_table.csv', index=False)
print()
print('contrast_table.csv written:', tab.shape[0], 'rows')
best = tab.iloc[(tab['dev_from_-0.9568'].abs()).argmin()]
print('closest row:', best.to_dict())
