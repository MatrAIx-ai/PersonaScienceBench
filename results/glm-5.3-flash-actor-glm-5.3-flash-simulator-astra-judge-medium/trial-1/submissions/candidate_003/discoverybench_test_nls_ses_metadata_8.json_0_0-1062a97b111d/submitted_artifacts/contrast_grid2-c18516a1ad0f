import pandas as pd, numpy as np, statsmodels.api as sm
from itertools import combinations

df = pd.read_csv('data/nls_ses_processed.csv', index_col=0)
y = df['BA DEGREE COMPLETED'].astype(int)
races = ['Black', 'Hispanic', 'White']
TARGET = -0.9568
TOL = 0.005
COVS = ['SES', 'ABILITY: COMPOSITE OF ASVAB SCORE', 'PERCENTILE IN CLASS', 'FAMILY SIZE OF SAMPLE', 'SAMPLE_SEX']
short = {'SES':'SES','ABILITY: COMPOSITE OF ASVAB SCORE':'ASVAB','PERCENTILE IN CLASS':'PCT','FAMILY SIZE OF SAMPLE':'FAM','SAMPLE_SEX':'SEX'}

def design(frame, ref, covs):
    cols = {}
    for r in races:
        if r != ref:
            cols['race:' + r] = (frame['SAMPLE_RACE'] == r).astype(float)
    for c in covs:
        if c == 'SAMPLE_SEX':
            cols['SEX_Male'] = (frame['SAMPLE_SEX'] == 'Male').astype(float)
        else:
            cols[c] = frame[c].astype(float)
    return sm.add_constant(pd.DataFrame(cols, index=frame.index))

def race_coefs(res, D, ref):
    out = {r: 0.0 for r in races}
    for r in races:
        if r == ref: continue
        key = [k for k in D.columns if k.startswith('race:') and k.endswith(r)]
        if key: out[r] = res.params[key[0]]
    return out

hits = []
rows = []

# 1) all covariate subsets, three-race logit
for k in range(6):
    for covs in combinations(COVS, k):
        for ref in races:
            D = design(df, ref, covs)
            res = sm.Logit(y, D).fit(disp=0)
            b = race_coefs(res, D, ref)
            for other in races:
                if other == ref: continue
                val = b[other] - b[ref]
                tag = 'logit ' + ('+'.join(short[c] for c in covs) or 'none')
                rows.append((tag, other, ref, val))
                if abs(val - TARGET) <= TOL: hits.append((tag, other, ref, val, '3race-logit'))

# 2) pairwise two-race-only logit fits
for a, b_ in combinations(races, 2):
    sub = df[df['SAMPLE_RACE'].isin([a, b_])]
    ys = sub['BA DEGREE COMPLETED'].astype(int)
    for k in range(6):
        for covs in combinations(COVS, k):
            cols = {'race:' + b_ if False else 'race:' + b_: (sub['SAMPLE_RACE'] == b_).astype(float)}
            cols = {'race:' + b_: (sub['SAMPLE_RACE'] == b_).astype(float)} if False else {}
            cols['race:' + b_] = (sub['SAMPLE_RACE'] == b_).astype(float)
            for c in covs:
                if c == 'SAMPLE_SEX': cols['SEX_Male'] = (sub['SAMPLE_SEX'] == 'Male').astype(float)
                else: cols[c] = sub[c].astype(float)
            D = sm.add_constant(pd.DataFrame(cols, index=sub.index))
            res = sm.Logit(ys, D).fit(disp=0)
            for other, ref in [(b_, a), (a, b_)]:
                val = res.params['race:' + other] if other != a else -res.params['race:' + b_]
                if other == a: val = -res.params['race:' + b_]
                tag = 'pairlogit ' + ('+'.join(short[c] for c in covs) or 'none') + f' [{a}/{b_}]'
                rows.append((tag, other, ref, val))
                if abs(val - TARGET) <= TOL: hits.append((tag, other, ref, val, 'pair-logit'))

# 3) linear probability model (OLS), all subsets, three-race
for k in range(6):
    for covs in combinations(COVS, k):
        for ref in races:
            D = design(df, ref, covs)
            res = sm.OLS(y.astype(float), D).fit()
            b = race_coefs(res, D, ref)
            for other in races:
                if other == ref: continue
                val = b[other] - b[ref]
                tag = 'LPM ' + ('+'.join(short[c] for c in covs) or 'none')
                rows.append((tag, other, ref, val))
                if abs(val - TARGET) <= TOL: hits.append((tag, other, ref, val, 'LPM'))

# 4) probit, race only and main specs (index-function scale differs; check anyway)
for covs in [(), ('SES',), ('SES','ABILITY: COMPOSITE OF ASVAB SCORE','PERCENTILE IN CLASS')]:
    for ref in races:
        D = design(df, ref, list(covs))
        res = sm.Probit(y, D).fit(disp=0)
        b = race_coefs(res, D, ref)
        for other in races:
            if other == ref: continue
            val = b[other] - b[ref]
            tag = 'probit ' + ('+'.join(short[c] for c in covs) or 'none')
            rows.append((tag, other, ref, val))
            if abs(val - TARGET) <= TOL: hits.append((tag, other, ref, val, 'probit'))

print('total fits/contrasts evaluated:', len(rows))
print()
print('Matches within +/-0.005 of -0.9568:')
if hits:
    for tag, other, ref, val, fam in hits:
        print(f'  [{fam}] {tag} | {other} vs {ref}: {val:.6f} (dev {val-TARGET:+.5f})')
else:
    best = min(rows, key=lambda r: abs(r[3] - TARGET))
    print('  none. Closest overall:')
    for r in sorted(rows, key=lambda r: abs(r[3] - TARGET))[:8]:
        print(f'    {r[0]} | {r[1]} vs {r[2]}: {r[3]:.6f} (dev {r[3]-TARGET:+.5f})')
