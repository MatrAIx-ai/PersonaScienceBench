import pandas as pd, numpy as np, statsmodels.api as sm
from itertools import combinations

df = pd.read_csv('data/nls_ses_processed.csv', index_col=0)
y = df['BA DEGREE COMPLETED'].astype(int)
races = ['Black', 'Hispanic', 'White']
TARGET = -0.9568
TOL = 0.005
COVS = ['SES', 'ABILITY: COMPOSITE OF ASVAB SCORE', 'PERCENTILE IN CLASS', 'FAMILY SIZE OF SAMPLE', 'SAMPLE_SEX']
short = {'SES':'SES','ABILITY: COMPOSITE OF ASVAB SCORE':'ASVAB','PERCENTILE IN CLASS':'PCT','FAMILY SIZE OF SAMPLE':'FAM','SAMPLE_SEX':'SEX'}
rows, hits = [], []

def design(frame, ref, covs, extra=None):
    cols = {}
    for r in races:
        if r != ref:
            cols['race:' + r] = (frame['SAMPLE_RACE'] == r).astype(float)
    for c in covs:
        if c == 'SAMPLE_SEX': cols['SEX_Male'] = (frame['SAMPLE_SEX'] == 'Male').astype(float)
        else: cols[c] = frame[c].astype(float)
    if extra is not None:
        for name, v in extra.items(): cols[name] = v
    return sm.add_constant(pd.DataFrame(cols, index=frame.index))

# A) sex-stratified: all covariate subsets (minus SEX), within Female and Male subsamples
for sex in ['Female', 'Male']:
    sub = df[df['SAMPLE_SEX'] == sex]
    ys = sub['BA DEGREE COMPLETED'].astype(int)
    cov2 = [c for c in COVS if c != 'SAMPLE_SEX']
    for k in range(5):
        for covs in combinations(cov2, k):
            for ref in races:
                D = design(sub, ref, covs)
                res = sm.Logit(ys, D).fit(disp=0)
                b = {r: 0.0 for r in races}
                for r in races:
                    if r == ref: continue
                    key = [k2 for k2 in D.columns if k2.startswith('race:') and k2.endswith(r)]
                    b[r] = res.params[key[0]]
                for other in races:
                    if other == ref: continue
                    val = b[other] - b[ref]
                    tag = f'logit[{sex}] ' + ('+'.join(short[c] for c in covs) or 'none')
                    rows.append((tag, other, ref, val))
                    if abs(val - TARGET) <= TOL: hits.append((tag, other, ref, val))

# B) interaction models: race * SES, race * ASVAB, race * PCTILE (main effects of each race + centered covariate)
for cov in ['SES', 'ABILITY: COMPOSITE OF ASVAB SCORE', 'PERCENTILE IN CLASS', 'FAMILY SIZE OF SAMPLE']:
    v = df[cov].astype(float); v = (v - v.mean()) / v.std()
    for ref in races:
        D = design(df, ref, [cov])
        for r in races:
            if r != ref:
                D['raceX'] = D['race:' + r] * v
                D = D.rename(columns={'raceX': 'racex:' + r})
        res = sm.Logit(y, D).fit(disp=0)
        b = {r: 0.0 for r in races}
        for r in races:
            if r == ref: continue
            b[r] = res.params['race:' + r]
        for other in races:
            if other == ref: continue
            val = b[other] - b[ref]
            tag = 'logit race*' + short[cov]
            rows.append((tag, other, ref, val))
            if abs(val - TARGET) <= TOL: hits.append((tag, other, ref, val))

# C) average marginal effect scale (AME) for race dummies, key specs
for covs in [(), ('SES',), ('SES','ABILITY: COMPOSITE OF ASVAB SCORE','PERCENTILE IN CLASS')]:
    for ref in races:
        D = design(df, ref, list(covs))
        res = sm.Logit(y, D).fit(disp=0)
        ame = res.get_margeff(at='overall').summary_frame()
        b = {r: 0.0 for r in races}
        for r in races:
            if r == ref: continue
            key = [k for k in D.columns if k.startswith('race:') and k.endswith(r)]
            b[r] = ame.loc['race:' + r, 'dy/dx'] * 100  # percent points? keep raw too
        for other in races:
            if other == ref: continue
            for scale, mult in [('AME', 1.0), ('AME*100', 100.0)]:
                val = (b[other] - b[ref]) * mult
                tag = 'AME ' + ('+'.join(short[c] for c in covs) or 'none')
                rows.append((tag + f' [{scale}]', other, ref, val))
                if abs(val - TARGET) <= TOL: hits.append((tag + f' [{scale}]', other, ref, val))

print('fits/contrasts:', len(rows))
print('Matches within +/-0.005 of -0.9568:')
if hits:
    for tag, other, ref, val in hits:
        print(f'  {tag} | {other} vs {ref}: {val:.6f} (dev {val-TARGET:+.5f})')
else:
    print('  none. Closest:')
    for r in sorted(rows, key=lambda r: abs(r[3] - TARGET))[:6]:
        print(f'    {r[0]} | {r[1]} vs {r[2]}: {r[3]:.6f} (dev {r[3]-TARGET:+.5f})')
