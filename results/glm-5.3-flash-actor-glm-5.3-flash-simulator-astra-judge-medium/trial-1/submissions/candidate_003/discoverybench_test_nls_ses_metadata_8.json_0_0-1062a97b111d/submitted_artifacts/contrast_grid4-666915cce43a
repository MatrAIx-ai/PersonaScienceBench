import pandas as pd, numpy as np, statsmodels.api as sm

df = pd.read_csv('data/nls_ses_processed.csv', index_col=0)
y = df['BA DEGREE COMPLETED'].astype(int)
races = ['Black', 'Hispanic', 'White']
TARGET = -0.9568
rows = []

def fit_interaction(interact_cov, center, base_covs):
    v = df[interact_cov].astype(float)
    if center == 'mean': v = v - v.mean()
    elif center == 'sd': v = (v - v.mean()) / v.std()
    elif center == 'none': pass
    out = []
    for ref in races:
        cols = {}
        for r in races:
            if r != ref: cols['race:' + r] = (df['SAMPLE_RACE'] == r).astype(float)
        for c in base_covs:
            if c == 'SAMPLE_SEX': cols['SEX_Male'] = (df['SAMPLE_SEX'] == 'Male').astype(float)
            else: cols[c] = df[c].astype(float)
        cols['IV'] = v
        for r in list(cols):
            if r.startswith('race:'): cols[r + '*IV'] = cols[r] * v
        D = sm.add_constant(pd.DataFrame(cols, index=df.index))
        res = sm.Logit(y, D).fit(disp=0)
        b = {r: 0.0 for r in races}
        for r in races:
            if r == ref: continue
            b[r] = res.params['race:' + r]
        for other in races:
            if other == ref: continue
            out.append((res, b[other] - b[ref], other, ref, b))
    return out

# race*SES with centering variants and varying base covariates
for center in ['none', 'mean', 'sd']:
    for base in [[], ['ABILITY: COMPOSITE OF ASVAB SCORE'], ['PERCENTILE IN CLASS'],
                 ['ABILITY: COMPOSITE OF ASVAB SCORE', 'PERCENTILE IN CLASS']]:
        for res, val, other, ref, b in fit_interaction('SES', center, base):
            rows.append((f'race*SES({center})+' + '+'.join(x[:4] for x in base), other, ref, val))
# race*other covariates, mean-centered
for cov in ['ABILITY: COMPOSITE OF ASVAB SCORE', 'PERCENTILE IN CLASS', 'FAMILY SIZE OF SAMPLE']:
    for res, val, other, ref, b in fit_interaction(cov, 'mean', ['SES']):
        rows.append(('race*' + cov[:6] + '+SES', other, ref, val))

print(f"{'spec':<32}{'contrast':<22}{'logodds':>10}  dev")
for tag, other, ref, val in sorted(rows, key=lambda r: abs(r[3] - TARGET)):
    dev = val - TARGET
    flag = ' <<< MATCH' if abs(dev) <= 0.005 else ''
    print(f"{tag:<32}{other + ' vs ' + ref:<22}{val:>10.4f}  {dev:+.4f}{flag}")
