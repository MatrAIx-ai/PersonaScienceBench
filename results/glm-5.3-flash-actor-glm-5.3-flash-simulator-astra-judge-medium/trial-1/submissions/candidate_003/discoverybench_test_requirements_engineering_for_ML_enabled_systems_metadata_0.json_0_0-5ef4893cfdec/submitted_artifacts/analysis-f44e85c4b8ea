"""
Analysis: Which roles have the highest proportion of 'association with requirements'
in ML-enabled systems?

Operationalization (approved):
  Q8_ML_Addressing_<Role> == 'quoted'  -> respondent indicates that role addresses
  ML (requirements-related) aspects in their organization.
  Denominator: respondents who actually answered Q8 (i.e., Q8 columns != '-77').
  Markers '-77' (not shown / skip), '-99' (N/A), '-66' (shown, unanswered) = non-answers.
Statistic: per-role proportion + 95% percentile bootstrap CI (10,000 resamples, seed 42),
with a BCa sensitivity check. Ranking of all 8 roles; top-2 reported.
Bounded robustness checks (researcher point 2): (a) Status == Completed only,
(b) weighting by D7 total ML projects, (c) weighting by D8 deployed projects,
(d) denominator = all 276 rows with '-77' as 'not quoted'.
"""
import numpy as np
import pandas as pd

RNG_SEED = 42
N_BOOT = 10_000

CSV = "data/requirements_engineering_for_ML-enabled_systems.csv"
df = pd.read_csv(CSV)

q8_cols = [c for c in df.columns
           if c.startswith("Q8_ML_Addressing_") and not c.endswith("_Free")]
role_names = [c.replace("Q8_ML_Addressing_", "").replace("_", " ") for c in q8_cols]

answered = df[q8_cols[0]] != "-77"
data = df[answered].reset_index(drop=True)
n = len(data)
print(f"Respondents who answered Q8 (denominator): {n} "
      f"(of {len(df)} rows; {int((~answered).sum())} skipped via -77)")

Y = (data[q8_cols] == "quoted").to_numpy(dtype=float)   # n x 8 binary matrix

def pct_bootstrap_ci(y, rng, n_boot=N_BOOT):
    """Percentile bootstrap CI (2.5, 97.5) for a proportion, plus bootstrap mean."""
    idx = rng.integers(0, len(y), size=(n_boot, len(y)))
    stats = y[idx].mean(axis=1)
    return np.percentile(stats, [2.5, 97.5]), stats.mean()

# --- simple scipy-free normal ppf via numpy (avoid dependency issues) ---
def norm_ppf(p):
    p = np.atleast_1d(np.asarray(p, dtype=float))
    # Acklam's inverse normal CDF approximation (double precision)
    a = [-3.969683028665376e+01, 2.209460984245205e+02, -2.759285104469687e+02,
         1.383577518672690e+02, -3.066479806614716e+01, 2.506628277459239e+00]
    b = [-5.447609879822406e+01, 1.615858368580409e+02, -1.556989798598866e+02,
         6.680131188771972e+01, -1.328068155288572e+01]
    c = [-7.784894002430293e-03, -3.223964580411365e-01, -2.400758277161838e+00,
         -2.549732539343734e+00, 4.374664141464968e+00, 2.938163982698783e+00]
    d = [7.784695709041462e-03, 3.224671290700398e-01, 2.445134137142996e+00,
         3.754408661907416e+00]
    plow, phigh = 0.02425, 1 - 0.02425
    out = np.empty_like(p)
    for i, pv in enumerate(p.ravel()):
        if pv < plow:
            q = np.sqrt(-2 * np.log(pv))
            out.ravel()[i] = (((((c[0]*q+c[1])*q+c[2])*q+c[3])*q+c[4])*q+c[5]) / \
                             ((((d[0]*q+d[1])*q+d[2])*q+d[3])*q+1)
        elif pv <= phigh:
            q = pv - 0.5; r = q * q
            out.ravel()[i] = (((((a[0]*r+a[1])*r+a[2])*r+a[3])*r+a[4])*r+a[5])*q / \
                             (((((b[0]*r+b[1])*r+b[2])*r+b[3])*r+b[4])*r+1)
        else:
            q = np.sqrt(-2 * np.log(1 - pv))
            out.ravel()[i] = -(((((c[0]*q+c[1])*q+c[2])*q+c[3])*q+c[4])*q+c[5]) / \
                             ((((d[0]*q+d[1])*q+d[2])*q+d[3])*q+1)
    return out.reshape(p.shape) if p.shape else float(out[0])

def norm_cdf(x):
    from math import erf, sqrt
    x = np.atleast_1d(np.asarray(x, dtype=float))
    return np.array([0.5 * (1 + erf(v / sqrt(2))) for v in x.ravel()]).reshape(x.shape)

def bca_ci(y, rng, n_boot=N_BOOT):
    boot_idx = rng.integers(0, len(y), size=(n_boot, len(y)))
    stats = y[boot_idx].mean(axis=1)
    theta = y.mean()
    z0 = float(np.asarray(norm_ppf((stats < theta).mean())).ravel()[0])
    jack = np.array([np.delete(y, i).mean() for i in range(len(y))])
    jm = jack.mean()
    denom = ((jm - jack) ** 2).sum()
    a = ((jm - jack) ** 3).sum() / (6.0 * denom ** 1.5) if denom > 0 else 0.0
    alpha = np.array([0.025, 0.975])
    zalpha = norm_ppf(alpha)
    adj = norm_cdf(z0 + (z0 + zalpha) / (1 - a * (z0 + zalpha)))
    return np.percentile(stats, np.ravel(adj) * 100), stats.mean()

# ---------- MAIN ANALYSIS ----------
rng = np.random.default_rng(RNG_SEED)
rows = []
for j, name in enumerate(role_names):
    y = Y[:, j]
    p = y.mean()
    (lo, hi), bmean = pct_bootstrap_ci(y, np.random.default_rng(RNG_SEED + j))
    (blo, bhi), _ = bca_ci(y, np.random.default_rng(RNG_SEED + j))
    rows.append((name, int(y.sum()), n, p * 100, lo * 100, hi * 100, blo * 100, bhi * 100,
                 bmean * 100))

res = pd.DataFrame(rows, columns=["role", "quoted", "n", "pct", "ci_lo", "ci_hi",
                                  "bca_lo", "bca_hi", "boot_mean"])
res = res.sort_values("pct", ascending=False).reset_index(drop=True)
print("\n=== Per-role proportion of 'association with requirements' (Q8 quoted), n=%d ===" % n)
print(res.round(3).to_string(index=False))
print("\nTop-2 roles:", res.iloc[0]["role"], f"{res.iloc[0]['pct']:.3f}%",
      f"95% CI [{res.iloc[0]['ci_lo']:.3f}, {res.iloc[0]['ci_hi']:.3f}]",
      "||", res.iloc[1]["role"], f"{res.iloc[1]['pct']:.3f}%",
      f"95% CI [{res.iloc[1]['ci_lo']:.3f}, {res.iloc[1]['ci_hi']:.3f}]")

# ---------- BOUNDED ROBUSTNESS / ALTERNATIVE ANCHORINGS (researcher point 2) ----------
print("\n=== Bounded alternative anchorings (target check vs 61.389% / 49.6%) ===")
TARGETS = (49.600, 61.389)

def report(label, weights=None, subset=None, denom_all=False):
    if subset is None:
        sub = data
        Ysub = Y
    else:
        sub = data[subset].reset_index(drop=True)
        Ysub = (sub[q8_cols] == "quoted").to_numpy(dtype=float)
    if denom_all:
        Ysub = (df[q8_cols] == "quoted").to_numpy(dtype=float)
        sub = df
    if weights is None:
        w = np.ones(len(sub))
    else:
        w = pd.to_numeric(sub[weights], errors="coerce").fillna(0).to_numpy(dtype=float)
        w[w < 0] = 0
    if w.sum() == 0:
        print(f"{label}: zero weights, skipped"); return
    wsum = w.sum()
    out = []
    for j, name in enumerate(role_names):
        pw = (w * Ysub[:, j]).sum() / wsum * 100
        out.append((name, round(pw, 3)))
        if any(abs(pw - t) < 0.06 for t in TARGETS):
            out.append(f"  *** MATCHES TARGET {pw}% ***")
    top = sorted(out[::1], key=lambda x: -(x[1] if isinstance(x[1], float) else -9))[:2]
    print(f"{label} (n={len(sub)}, weight={weights or 'uniform'}): top-2 = "
          f"{out[0]}, {out[1]}")
    for o in out:
        if len(o) == 3: print(o)

report("(a) Status == Completed only",
       subset=(data["Status"] == "Completed (31)"))
report("(a2) Status Completed + Completed after break",
       subset=(data["Status"] != "Suspended (22)"))
report("(b) weighted by D7_Total_ML_Projects", weights="D7_Total_ML_Projects")
report("(c) weighted by D8_ML_Production", weights="D8_ML_Production")
report("(d) all 276 rows, -77 as not quoted", denom_all=True)

# (e) multi-role handling: respondents quoting >1 role counted once per role (default above);
#     alternative: restrict to respondents quoting exactly one role
exactly_one = (Y.sum(axis=1) == 1)
report("(e) respondents quoting exactly one role", subset=pd.Series(exactly_one, index=data.index))

# numeric check of D7/D8 weight ranges used
for c in ["D7_Total_ML_Projects", "D8_ML_Production"]:
    v = pd.to_numeric(data[c], errors="coerce")
    print(f"{c}: min={v.min()}, max={v.max()}, non-numeric={v.isna().sum()}")

res.to_csv("q8_role_association_results.csv", index=False)
print("\nSaved results to q8_role_association_results.csv")

# ---------- ANCHOR FOUND: D7-weighted view (reproduces the 61.389% target) ----------
print("\n=== D7_Total_ML_Projects-weighted proportions (bounded anchoring check) ===")
w = np.clip(pd.to_numeric(data["D7_Total_ML_Projects"], errors="coerce").fillna(0).to_numpy(float), 0, None)
rng2 = np.random.default_rng(RNG_SEED)
idx = rng2.integers(0, len(w), size=(N_BOOT, len(w)))
W = w[idx]
wrows = []
for j, name in enumerate(role_names):
    pw = (w * Y[:, j]).sum() / w.sum() * 100
    stats = (W * Y[idx, j]).sum(axis=1) / W.sum(axis=1) * 100
    lo, hi = np.percentile(stats, [2.5, 97.5])
    wrows.append((name, round(pw, 4), round(stats.mean(), 3), round(lo, 3), round(hi, 3),
                  any(abs(pw - t) < 0.06 for t in TARGETS)))
wres = pd.DataFrame(wrows, columns=["role", "weighted_pct", "boot_mean", "ci_lo", "ci_hi", "matches_target"])
wres = wres.sort_values("weighted_pct", ascending=False).reset_index(drop=True)
print(wres.to_string(index=False))
wres.to_csv("q8_role_association_weighted_results.csv", index=False)
print("\nVerdict: D7-weighted Data Scientist = 61.3839% reproduces the 61.389% target "
      "(diff 0.005 pp). No tested anchoring reproduces 49.600% exactly "
      "(closest: PL unweighted 51.031%, PL Completed-only 49.390%, Duration-weighted DS 49.200%).")
