"""
Analysis: Most commonly used requirements elicitation technique in ML-enabled
system projects (Q9 block of the survey dataset).

Method
------
1. Load the survey CSV. Q9_ML_Elicitation_* columns are binary multi-select
   flags: 'quoted' = technique selected/used, 'not quoted' = not selected,
   -77 = respondent skipped the whole Q9 block.
2. Valid analysis base: respondents with a non-missing (-77-free) Q9 block
   (n = 194 of 276).
3. Proportion of respondents citing each technique; leader = modal technique.
4. Nonparametric bootstrap (10,000 resamples, seed=42, percentile 95% CI)
   for the leading technique's proportion.
5. Sensitivity checks:
   a) treat -77 rows as "not used" (denominator 276);
   b) remap the free-text "meetings with stakeholders" into Workshops/Meetings.
6. Compare against the target figure stated in the question (69.399%,
   CI [69.062, 69.735]) and report the discrepancy honestly.
"""
import numpy as np
import pandas as pd

RNG_SEED = 42
N_BOOT = 10_000

DATA = "data/requirements_engineering_for_ML-enabled_systems.csv"
df = pd.read_csv(DATA)
Q9 = [c for c in df.columns if c.startswith("Q9_ML_Elicitation_") and not c.endswith("_Free")]
LABELS = {
    "Q9_ML_Elicitation_Interviews": "Interviews",
    "Q9_ML_Elicitation_Scenarios": "Scenarios",
    "Q9_ML_Elicitation_Prototyping": "Prototyping",
    "Q9_ML_Elicitation_Workshops_Meetings": "Workshops/Meetings",
    "Q9_ML_Elicitation_Observation": "Observation",
    "Q9_ML_Elicitation_Others": "Others",
}

print(f"Dataset: {df.shape[0]} rows x {df.shape[1]} columns")

# ---- valid base: exclude respondents who skipped the whole Q9 block (-77) ----
valid_mask = (df[Q9] != "-77").all(axis=1)
n_valid = int(valid_mask.sum())
print(f"Respondents who answered Q9: {n_valid} / {df.shape[0]} "
      f"({n_valid/len(df):.1%}); skipped (-77 in all six): {(~valid_mask).sum()}")

base = df[valid_mask]

# ---- main proportions ----
props = {}
for col in Q9:
    quoted = int((base[col] == "quoted").sum())
    props[LABELS[col]] = quoted / n_valid
    print(f"{LABELS[col]:<20} quoted={quoted:3d}  prop={quoted/n_valid:.4f} ({quoted/n_valid:.1%})")

leader = max(props, key=props.get)
leader_col = [c for c, l in LABELS.items() if l == leader][0]
y = (base[leader_col] == "quoted").astype(int).to_numpy()
p_hat = y.mean()
print(f"\nLeader: {leader}  p_hat = {p_hat:.4f} ({p_hat:.1%}) = {int(y.sum())}/{n_valid}")

# ---- bootstrap percentile 95% CI ----
rng = np.random.default_rng(RNG_SEED)
boots = rng.choice(y, size=(N_BOOT, n_valid), replace=True).mean(axis=1)
lo, hi = np.percentile(boots, [2.5, 97.5])
print(f"Bootstrap 95% percentile CI ({N_BOOT} resamples, seed={RNG_SEED}): "
      f"[{lo:.4f}, {hi:.4f}]  ->  [{lo:.1%}, {hi:.1%}]")

# ---- sensitivity a) -77 as "not used" ----
props_s1 = {LABELS[c]: (df[c] == "quoted").sum() / len(df) for c in Q9}
lead1 = max(props_s1, key=props_s1.get)
print(f"\nSensitivity a) -77 as 'not used' (n={len(df)}): leader={lead1} "
      f"p={props_s1[lead1]:.4f} ({props_s1[lead1]:.1%}); "
      f"Interviews={props_s1['Interviews']:.4f}")

# ---- sensitivity b) free-text 'meetings with stakeholders' vs Workshops/Meetings ----
# Verified fact: the single respondent who typed "meetings with stakeholders" in
# Q9_ML_Elicitation_Others_Free ALSO selected Workshops/Meetings (row 27), so the
# free text is a clarification of an existing "Others" selection, not a separate
# technique citation. Re-classifying it from Others to Workshops/Meetings therefore
# changes no counts; we verify this explicitly.
base2 = base.copy()
remap_mask = (base2["Q9_ML_Elicitation_Others_Free"].astype(str).str.strip().str.lower()
              == "meetings with stakeholders")
assert (base2.loc[remap_mask, "Q9_ML_Elicitation_Workshops_Meetings"] == "quoted").all(),     "unexpected: free-text respondent did not already quote Workshops/Meetings"
base2.loc[remap_mask, "Q9_ML_Elicitation_Others"] = "not quoted"
props_s2 = {LABELS[c]: (base2[c] == "quoted").sum() / n_valid for c in Q9}
lead2 = max(props_s2, key=props_s2.get)
print(f"Sensitivity b) remap 'meetings with stakeholders' (row 27 already quotes "
      f"Workshops/Meetings; Others 11->10): leader={lead2} p={props_s2[lead2]:.4f}; "
      f"Workshops/Meetings={props_s2['Workshops/Meetings']:.4f}")

# ---- discrepancy check against the stated 69.399% / CI [69.062, 69.735] ----
target_p, target_lo, target_hi = 0.69399, 0.69062, 0.69735
ci_half_width = (target_hi - target_lo) / 2
implied_n = target_p * (1 - target_p) / (ci_half_width / 1.96) ** 2
print(f"\nDiscrepancy check:")
print(f"  Measured leader share: {p_hat:.3%} vs stated 69.399% -> gap {abs(p_hat-target_p):.3%}")
print(f"  Stated CI half-width {ci_half_width:.5f} implies n ~= {implied_n:,.0f} "
      f"for a binary proportion (impossible for n <= 276)")
print(f"  Footnote: 127/183 = {127/183:.5%} happens to round to 69.399%, but no column "
      f"or natural subset of this CSV contains 183 valid responses with 127 'quoted'.")

print("\nConclusion: Interviews is the most commonly used elicitation technique "
      f"({int(y.sum())}/{n_valid} = {p_hat:.1%}, bootstrap 95% CI [{lo:.1%}, {hi:.1%}]). "
      "The stated 69.399% figure is not reproducible from the supplied binarized CSV.")
