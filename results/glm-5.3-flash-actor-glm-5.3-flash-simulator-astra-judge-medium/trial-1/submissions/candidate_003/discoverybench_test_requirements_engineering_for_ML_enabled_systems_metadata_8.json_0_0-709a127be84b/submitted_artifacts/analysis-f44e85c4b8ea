"""Q10_ML_Documentation_*: least-used documentation formats for requirements in ML-enabled systems.
Fixed choices (approved plan): 'indicating so' = 'quoted'; denominator = 194 valid respondents
(rows with Q10 block answered, sentinel -77 excluded); Not_Documented excluded from ranking;
bootstrap 10,000 resamples, seed=42, percentile 95% CI (+BCa sensitivity).
"""
import numpy as np, pandas as pd
from scipy import stats

RNG = np.random.default_rng(42)
CSV = 'data/requirements_engineering_for_ML-enabled_systems.csv'

df = pd.read_csv(CSV)
q10_all = [c for c in df.columns if c.startswith('Q10_ML_Documentation')]
free_cols = [c for c in q10_all if c.endswith('_Free')]
fmt_cols = [c for c in q10_all if c not in free_cols]

# ---------- Step 1: tidy ----------
m77_any = (df[fmt_cols] == '-77').any(axis=1)
m77_all = (df[fmt_cols] == '-77').all(axis=1)
assert (m77_any == m77_all).all(), 'mixed -77 rows found'
assert not df[fmt_cols].isin(['-99']).any().any(), 'unexpected -99 in Q10'
assert set(np.unique(df[fmt_cols].values.ravel())) <= {'quoted', 'not quoted', '-77'}
valid = df.loc[~m77_any].copy()
N = len(valid)
use = {c: (valid[c] == 'quoted').to_numpy() for c in fmt_cols}
print(f'[1] tidy OK: rows={len(df)}, -77 rows excluded={int(m77_any.sum())}, valid N={N}, '
      f'no mixed rows, no -99, only quoted/not quoted/-77 present')
print(f'    ID duplicates: {df["ID"].duplicated().sum()}')

# ---------- Others_Free content ----------
free_txt = valid.loc[valid['Q10_ML_Documentation_Others'] == 'quoted',
                     ['ID', 'Q10_ML_Documentation_Others_Free']]
print('[4] Others_Free values among those who quoted "Others":')
print(free_txt.to_string(index=False))

# ---------- Step 2+3: proportions + bootstrap ----------
FORMATS = [c for c in fmt_cols if c != 'Q10_ML_Documentation_Not_Documented']
SHORT = {c: c.replace('Q10_ML_Documentation_', '') for c in fmt_cols}
B = 10_000

def boot_ci(k, n, rng, kind='percentile'):
    """k successes out of n; bootstrap proportion CI."""
    if kind == 'percentile':
        idx = rng.integers(0, n, size=(B, n))          # resample respondent rows conceptually
        # equivalent Bernoulli resampling since statistic depends only on k/n
        stats_ = rng.binomial(n, k / n, size=B) / n
    else:  # BCa via jackknife on binary vector
        pass
    return stats_

def bca_ci(x, rng, alpha=0.05):
    """BCa CI for mean of binary vector x (respondent-level resampling)."""
    n = len(x); theta = x.mean()
    idx = rng.integers(0, n, size=(B, n))
    t = x[idx].mean(axis=1)
    # jackknife
    jack = np.array([np.delete(x, i).mean() for i in range(n)])
    a = ((jack.mean() - jack) ** 3).sum() / (6 * (((jack.mean() - jack) ** 2).sum()) ** 1.5)
    z0 = stats.norm.ppf(np.mean(t < theta))
    zl, zu = stats.norm.ppf(alpha / 2), stats.norm.ppf(1 - alpha / 2)
    def adj(z): return stats.norm.cdf(z0 + (z0 + z) / (1 - a * (z0 + z)))
    lo = np.quantile(t, adj(zl)); hi = np.quantile(t, adj(zu))
    return lo, hi

rng_p = np.random.default_rng(42)
rng_b = np.random.default_rng(43)
rows = []
for c in FORMATS:
    x = use[c].astype(float)
    k = int(x.sum()); p = k / N
    b = rng_p.binomial(N, p, size=B) / N
    lo, hi = np.quantile(b, [0.025, 0.975])
    blo, bhi = bca_ci(x, rng_b)
    rows.append(dict(format=SHORT[c], quoted=k, n=N, pct=100 * p,
                     ci_lo=100 * lo, ci_hi=100 * hi,
                     bca_lo=100 * blo, bca_hi=100 * bhi))
res = pd.DataFrame(rows).sort_values(['pct', 'format']).reset_index(drop=True)
print('\n[2/3] Proportions + bootstrap CIs (denominator N=%d valid), pct of respondents indicating so' % N)
print(res.round(3).to_string(index=False))

# ---------- Step 4: two smallest + CI overlap + tie-break ----------
s = res.sort_values(['pct', 'ci_hi', 'format']).reset_index(drop=True)
top2, third = s.iloc[:2], s.iloc[2]
print('\n[4] Two smallest (primary denominator N=%d):' % N)
print(top2.round(3).to_string(index=False))
t2 = top2.iloc[0]; t1 = top2.iloc[1]
ov12 = not (t1.ci_hi < t2.ci_lo or t2.ci_hi < t1.ci_lo)
ov23 = not (third.ci_hi < t1.ci_lo or t1.ci_hi < third.ci_lo)
print(f'    CI overlap 1st vs 2nd: {ov12}; 2nd vs 3rd ({third.format}): {ov23}')
print(f'    tie-break rule: sort by (pct, ci_hi, format) -> applied: {list(top2.format)}')

# ---------- Step 5: sensitivity ----------
def fractions(denom_df, formats):
    n = len(denom_df); out = {}
    for c in formats:
        out[SHORT[c]] = 100 * (denom_df[c] == 'quoted').sum() / n
    return out, n

sens = {}
sens['N=194 valid (primary)'], _ = fractions(valid, FORMATS)
sens['N=276 all rows (-77 as not-quoted)'], _ = fractions(df.assign(**{c: df[c].where(df[c] != '-77', 'not quoted') for c in fmt_cols}), FORMATS)
doc = valid[valid['Q10_ML_Documentation_Not_Documented'] != 'quoted']
sens['N=164 documenters only'], _ = fractions(doc, FORMATS)
sens['incl. Not_Documented, N=194'], _ = fractions(valid, fmt_cols)
sens_df = pd.DataFrame(sens).round(3)
print('\n[5] Sensitivity: point estimates (%%) under alternative denominators')
print(sens_df.to_string())
print('\n    Two smallest per scenario:')
for name, series in sens_df.items():
    two = series.sort_values().index[:2].tolist()
    print(f'    {name:42s} -> {two}')

# reconciliation with anchors
anchors = {'anchor1_pct': 10.13, 'anchor1_ci': (9.926, 10.333),
           'anchor2_pct': 4.366, 'anchor2_ci': (4.231, 4.501)}
print('\n[5b] Reconciliation with anchors 10.13%% [9.926,10.333] and 4.366%% [4.231,4.501]:')
print(f'    primary pair: {list(top2.format)} = {t2.pct:.3f}% / {t1.pct:.3f}%')
print(f'    primary CI widths: {t2.ci_hi-t2.ci_lo:.3f} pp / {t1.ci_hi-t1.ci_lo:.3f} pp '
      f'vs anchor widths {anchors["anchor1_ci"][1]-anchors["anchor1_ci"][0]:.3f} / '
      f'{anchors["anchor2_ci"][1]-anchors["anchor2_ci"][0]:.3f} pp')
nearest = {}
for name, series in sens_df.items():
    vals = series.sort_values()
    nearest[name] = (vals.index[0], round(vals.iloc[0], 3), vals.index[1], round(vals.iloc[1], 3))
for k, v in nearest.items(): print('    %-42s two smallest: %s' % (k, v))

res.to_csv('outputs/q10_fractions_and_ci.csv', index=False)
sens_df.to_csv('outputs/q10_sensitivity.csv')
print('\nSaved: outputs/q10_fractions_and_ci.csv, outputs/q10_sensitivity.csv')
