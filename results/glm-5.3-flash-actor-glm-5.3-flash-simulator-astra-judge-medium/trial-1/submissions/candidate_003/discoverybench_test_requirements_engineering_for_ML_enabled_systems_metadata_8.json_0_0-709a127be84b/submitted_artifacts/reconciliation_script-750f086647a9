"""Focused reconciliation pass for anchors 10.13% / 4.366% (no changes to primary analysis)."""
import numpy as np, pandas as pd

df = pd.read_csv('data/requirements_engineering_for_ML-enabled_systems.csv')
q10 = [c for c in df.columns if c.startswith('Q10_ML_Documentation')]
fmt = [c for c in q10 if not c.endswith('_Free')]
m77 = (df[fmt] == '-77').all(axis=1)
v = df.loc[~m77]

print('=== (1) Mention-based shares ===')
qcounts = {c: (v[c]=='quoted').sum() for c in fmt}
tot_all = sum(qcounts.values())
print('total quoted mentions (12 cols incl Not_Documented):', tot_all)
for excl_name, cols in [('all 12', fmt),
                        ('excl Not_Documented (11)', [c for c in fmt if c!='Q10_ML_Documentation_Not_Documented']),
                        ('excl Not_Documented and Others (10)', [c for c in fmt if c not in ('Q10_ML_Documentation_Not_Documented','Q10_ML_Documentation_Others')])]:
    t = sum(qcounts[c] for c in cols)
    print(f'-- denominator {t} ({excl_name}):')
    for c in cols:
        p = 100*qcounts[c]/t
        if 3.5 < p < 12 or qcounts[c] in (4,15,42):
            print(f'   {c:45s} {qcounts[c]:3d}  {p:.4f}%')

print()
print('=== (2) Per-format valid denominators in Q10 ===')
for c in fmt:
    nv = (v[c]!='-77').sum() if False else ((df[c]!='-77') & ~m77).sum()
    nv2 = (df[c]!='-77').sum()
    print(f'{c:45s} valid={nv} (incl -77 rows: {nv2})')
fv = v['Q10_ML_Documentation_Others_Free']
print('Others_Free non-null among valid:', fv.notna().sum(), ' values:', sorted(set(fv.dropna()) - {'-99'}))

print()
print('=== (3) D7-weighted shares (excluding D7=-99) ===')
d7 = pd.to_numeric(v['D7_Total_ML_Projects'], errors='coerce')
mask = (d7 != -99) & d7.notna()
w = d7[mask]
print('respondents with valid D7:', mask.sum(), ' weight sum:', w.sum())
for c in fmt:
    k = ((v[c]=='quoted') & mask).sum()
    print(f'{c:45s} {100*k/w.sum():.4f}%  (k={k})')

print()
print('=== (4) Scan other multi-select blocks for 10.13% / 4.366% ===')
blocks = ['D10_ML_Management_Framework','D12_ML_Project_Context','D13_ML_Programming_Language',
          'D14_ML_Purpose','D15_ML_Algorithms','Q8_ML_Addressing','Q9_ML_Elicitation',
          'Q11_ML_NFRs','Q12_ML_Most_Difficult_Activity','Q13_Model_Deploy_Approach',
          'Q15_Model_Deploy_Production','Q16_Model_Monitor_Aspects']
targets = [10.13, 4.366]
TOL = 0.06  # pp
hits = []
for b in blocks:
    cols = [c for c in df.columns if c.startswith(b) and not c.endswith('_Free')]
    if not cols: continue
    vals = set(df[cols].values.ravel())
    scale = 'quoted/not' if vals <= {'quoted','not quoted','-77','-99','Yes','No'} else f'OTHER: {sorted(vals)[:8]}'
    # denominator: rows not -77 across block
    mb = (df[cols]=='-77').all(axis=1)
    sub = df.loc[~mb]
    n = len(sub)
    for c in cols:
        s = (sub[c]=='quoted').sum()
        if s==0: continue
        for den_name, den in [('block_valid n=%d'%n, n), ('all n=276', 276)]:
            p = 100*s/den
            for t in targets:
                if abs(p-t) < TOL:
                    hits.append((c, s, den_name, p, t))
    print(f'{b:32s} cols={len(cols):2d} block_valid={n:3d}  {scale}')
print()
print('HITS within +-0.06pp:')
for h in hits: print('  ', h)
if not hits: print('   none')

