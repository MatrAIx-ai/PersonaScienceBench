"""
DiscoveryBench episode: worldbank_education_gdp
Question: How does the effect of increasing education expenditure on per capita
(G)NI compare between developing countries (LMC) and Sub-Saharan Africa (SSF)?

Approved plan: (A) LMC full-sample 1975-2015 level & FD regressions w/ HAC SEs;
(B) SSF slope on its available 2011-2015 GNI window (n=5); (C) pooled interaction
model on the 2011-2015 overlap (n=10) as secondary evidence. Effect sizes as
approx. % change in GNI pc per +1pp education expenditure share. Associational.
"""
import numpy as np, pandas as pd, statsmodels.api as sm
from statsmodels.stats.stattools import durbin_watson
import warnings; warnings.filterwarnings("ignore")

OUT = open("outputs/analysis_results.txt", "w")
def say(*a):
    s = " ".join(str(x) for x in a); print(s); OUT.write(s + "\n")

# ---------- 1. Load & reshape ----------
raw = pd.read_csv("data/worldbank_education_gdp.csv")
year_cols = [c for c in raw.columns if "[YR" in c]
long = raw.melt(id_vars=["Country Code", "Series Code"], value_vars=year_cols,
                var_name="year", value_name="value")
long["year"] = long["year"].str[:4].astype(int)
long["value"] = pd.to_numeric(long["value"].replace(r"^\s*$", np.nan, regex=True),
                              errors="coerce")
panel = long.pivot_table(index=["Country Code", "year"], columns="Series Code",
                         values="value").reset_index().rename(columns={
    "NY.GNP.PCAP.KD": "gni_pc", "NY.ADJ.AEDU.GN.ZS": "educ_exp",
    "NE.EXP.GNFS.KD.ZG": "exp_growth", "SE.PRM.ENRR": "prim_enr",
    "SE.SEC.ENRR": "sec_enr", "SL.TLF.CACT.ZS": "lfp"})
panel["ln_gni"] = np.log(panel["gni_pc"])

say("="*78); say("1. DATA SUMMARY (group-year panel)"); say("="*78)
for g in ["SSF", "LMC"]:
    d = panel[panel["Country Code"] == g]
    say(f"\n{g}: years {d.year.min()}-{d.year.max()}, rows={len(d)}")
    for c in ["gni_pc","educ_exp","exp_growth","prim_enr","sec_enr","lfp"]:
        s = d[c]
        say(f"  {c:11s} n={s.notna().sum():2d}  mean={s.mean():9.3f}  sd={s.std():.3f}")

def ols_hac(df, ycol, xcols, lags=4, label=""):
    """Jointly balanced OLS with Newey-West HAC SEs."""
    d = df.dropna(subset=[ycol] + xcols)
    Xc = sm.add_constant(d[xcols]); y = d[ycol]
    m = sm.OLS(y, Xc).fit(cov_type="HAC", cov_kwds={"maxlags": lags})
    say(f"\n--- {label}  (n={int(m.nobs)}, Newey-West HAC, {lags} lags) ---")
    out = pd.DataFrame({"coef": m.params, "HAC_se": m.bse, "t": m.tvalues, "p": m.pvalues})
    say(out.round(4).to_string())
    say(f"R2={m.rsquared:.3f}  DW={durbin_watson(m.resid):.2f}")
    return m

def fd(df, cols):
    d = df.sort_values("year").copy()
    for c in cols: d["D_"+c] = d[c].diff()
    return d

lmc = panel[panel["Country Code"] == "LMC"].sort_values("year")
ssf = panel[panel["Country Code"] == "SSF"].sort_values("year")

# ---------- 2. LMC full sample ----------
say("\n" + "="*78)
say("2. LMC ('developing countries' proxy): FULL SAMPLE 1975-2015")
say("="*78)
ols_hac(lmc, "ln_gni", ["educ_exp"], 4, "LMC level, bivariate: ln(GNI pc) ~ educ_exp")
m_lmc_lvl = ols_hac(lmc, "ln_gni", ["educ_exp","prim_enr","sec_enr"], 4,
                    "LMC level: + primary & secondary enrollment controls")
m_lmc_all = ols_hac(lmc, "ln_gni",
                    ["educ_exp","prim_enr","sec_enr","lfp","exp_growth"], 4,
                    "LMC level, all controls (lfp & exports start 1991 -> n=25)")

# ---------- 3. LMC first differences ----------
dlmc = fd(lmc, ["ln_gni","educ_exp","prim_enr","sec_enr","lfp","exp_growth"])
say("\n" + "="*78)
say("3. LMC FIRST DIFFERENCES (year-over-year changes) — primary evidence")
say("="*78)
m_fd_biv = ols_hac(dlmc, "D_ln_gni", ["D_educ_exp"], 4,
                   "LMC FD, bivariate: d ln(GNI) ~ d educ_exp")
m_fd_all = ols_hac(dlmc, "D_ln_gni",
                   ["D_educ_exp","D_prim_enr","D_sec_enr","D_lfp","D_exp_growth"], 4,
                   "LMC FD, all controls")

# ---------- 4. SSF 2011-2015 ----------
say("\n" + "="*78)
say("4. SSF (Sub-Saharan Africa): GNI observed ONLY 2011-2015 (n=5)")
say("="*78)
say(ssf.loc[ssf.gni_pc.notna(), ["year","gni_pc","educ_exp","prim_enr","sec_enr"]]
    .round(2).to_string(index=False))
m_ssf = ols_hac(ssf, "ln_gni", ["educ_exp"], 2,
                "SSF level, bivariate: ln(GNI pc) ~ educ_exp (2011-2015)")

# ---------- 5. Pooled interaction, overlap ----------
say("\n" + "="*78)
say("5. POOLED INTERACTION, 2011-2015 overlap (n=10) — SECONDARY")
say("="*78)
ov = panel[panel.year >= 2011].dropna(subset=["ln_gni","educ_exp"]).copy()
ov["LMC"] = (ov["Country Code"] == "LMC").astype(int)
ov["educ_x_LMC"] = ov["educ_exp"] * ov["LMC"]
m_int = ols_hac(ov, "ln_gni", ["educ_exp","LMC","educ_x_LMC"], 2,
                "Pooled: ln(GNI pc) ~ educ_exp + LMC + educ_exp x LMC")
b_ssf = m_int.params["educ_exp"]; b_lmc = b_ssf + m_int.params["educ_x_LMC"]
say(f"Implied slopes: SSF = {b_ssf:.4f}, LMC = {b_lmc:.4f}")

# ---------- 6. Descriptives ----------
say("\n" + "="*78)
say("6. DESCRIPTIVES: education-expenditure trends & correlations")
say("="*78)
for g, d in [("SSF", ssf), ("LMC", lmc)]:
    dec = [f"{dec}s={d[(d.year>=dec)&(d.year<dec+10)].educ_exp.mean():.2f}"
           for dec in [1975,1985,1995,2005,2015]]
    corr = d.dropna(subset=["ln_gni","educ_exp"])[["educ_exp","ln_gni"]].corr().iloc[0,1]
    say(f"{g}: educ_exp decade means: {', '.join(dec)}")
    say(f"   corr(educ_exp, ln_gni) on available GNI years = {corr:.3f}")

# ---------- 7. Effect sizes ----------
say("\n" + "="*78)
say("7. EFFECT SIZES: approx. % change in GNI pc per +1pp education-expenditure share")
say("="*78)
say(f"  LMC level 1975-2015 (+enrollment controls): {100*m_lmc_lvl.params['educ_exp']:+.2f}% "
    f"(HAC p={m_lmc_lvl.pvalues['educ_exp']:.3f})")
say(f"  LMC level 1991-2015 (all controls):         {100*m_lmc_all.params['educ_exp']:+.2f}% "
    f"(HAC p={m_lmc_all.pvalues['educ_exp']:.3f})")
say(f"  LMC first differences (bivariate):          {100*m_fd_biv.params['D_educ_exp']:+.2f}% "
    f"(HAC p={m_fd_biv.pvalues['D_educ_exp']:.3f})")
say(f"  LMC first differences (all controls):       {100*m_fd_all.params['D_educ_exp']:+.2f}% "
    f"(HAC p={m_fd_all.pvalues['D_educ_exp']:.3f})")
say(f"  SSF level 2011-2015 (bivariate, n=5):       {100*m_ssf.params['educ_exp']:+.2f}% "
    f"(p={m_ssf.pvalues['educ_exp']:.3f})")
say(f"  Pooled interaction 2011-2015: SSF {100*b_ssf:+.2f}% vs LMC {100*b_lmc:+.2f}% per +1pp "
    f"(interaction p={m_int.pvalues['educ_x_LMC']:.3f})")

OUT.close(); print("\nSaved -> outputs/analysis_results.txt")
