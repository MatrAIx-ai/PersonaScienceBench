"""
NLSY79 (1989): How does age relate to the likelihood of DISSAVED=1
(withdrawing more from savings than putting in)?

Primary analysis: de-duplicated file (exact duplicate rows dropped).
Contrasts: (a) raw file (artifact-contaminated, documented), (c) dedup +
excluding rows with both INCOME and BMI at the exact median (inferred
median-imputation diagnosis, NOT a documented flag).
"""
import numpy as np
import pandas as pd
import statsmodels.api as sm
import statsmodels.formula.api as smf
from scipy import stats

CSV = "data/nls_bmi_processed.csv"
OUT = "analysis/results.txt"

df = pd.read_csv(CSV)
imp_inc = df.INCOME.value_counts().idxmax()  # repeated constant == column mean -> mean imputation
imp_bmi = df.BMI.value_counts().idxmax()
n_raw = len(df)

dup_mask = df.duplicated(keep="first")
imputed_mask = (df.INCOME == imp_inc) & (df.BMI == imp_bmi)

datasets = {
    "(a) RAW (artifact-contaminated)": df.copy(),
    "(b) DEDUP (primary)": df[~dup_mask].copy(),
    "(c) DEDUP + excl both-mean-imputed": df[~dup_mask & ~imputed_mask].copy(),
}

def winsor(s, lo=0.01, hi=0.99):
    return s.clip(s.quantile(lo), s.quantile(hi))

lines = []
def w(x=""):
    lines.append(str(x))
    print(x)

w("=" * 78)
w("AGE AND THE LIKELIHOOD OF DISSAVED=1 - NLSY79 1989 (cross-sectional)")
w("=" * 78)
w(f"Raw rows: {n_raw} | exact duplicate rows: {dup_mask.sum()} | "
  f"rows with INCOME&BMI at mean-imputed constant (inferred imputed): {imputed_mask.sum()}")
w(f"Mean-imputed INCOME constant: {imp_inc:.6f} (n={ (df.INCOME==imp_inc).sum() }); "
  f"mean-imputed BMI constant: {imp_bmi:.6f} (n={ (df.BMI==imp_bmi).sum() })")
w("NOTE: imputation is INFERRED from exact equality with the column mean, not a documented flag.")
w()

for name, d in datasets.items():
    d = d.copy()
    d["FEMALE"] = (d.GENDER == "FEMALE").astype(int)
    d["log_income"] = np.log1p(d.INCOME)
    d["BMI_w"] = winsor(d.BMI)
    w("-" * 78)
    w(f"DATASET {name}  (n = {len(d)}, DISSAVED rate = {d.DISSAVED.mean():.4f})")
    w("-" * 78)

    # single-year-age rates with 95% CI (Wilson)
    w("\nDISSAVED rate by single-year age (95% Wilson CI):")
    for age, g in d.groupby("AGE"):
        p = g.DISSAVED.mean()
        n_ = len(g)
        z = 1.96
        den = 1 + z**2 / n_
        ctr = (p + z**2 / (2 * n_)) / den
        hw = z * np.sqrt(p * (1 - p) / n_ + z**2 / (4 * n_**2)) / den
        w(f"  age {age}: n={n_:5d}  rate={p:.3f}  [{p-hw:.3f}, {p+hw:.3f}]")

    # Main logistic model: AGE + AGE_2 + controls
    m_quad = smf.logit(
        "DISSAVED ~ AGE + AGE_2 + log_income + FEMALE + BLACK + HISPANIC + BMI_w",
        data=d).fit(disp=0)
    m_lin = smf.logit(
        "DISSAVED ~ AGE + log_income + FEMALE + BLACK + HISPANIC + BMI_w",
        data=d).fit(disp=0)

    w("\nMain logistic model (linear in AGE, controls: log_income, FEMALE, BLACK, HISPANIC, BMI_w):")
    w(m_lin.summary2().tables[1].round(4).to_string())
    orr = np.exp(m_lin.params["AGE"])
    ci = np.exp(m_lin.conf_int().loc["AGE"])
    w(f"  AGE OR per year = {orr:.4f} (95% CI {ci[0]:.4f}-{ci[1]:.4f}), p = {m_lin.pvalues['AGE']:.4g}")

    # LRT: linear vs quadratic
    lr = 2 * (m_quad.llf - m_lin.llf)
    p_lr = stats.chi2.sf(lr, 1)
    w("\nQuadratic test (AGE + AGE_2 model):")
    w(f"  AGE_2 coef = {m_quad.params['AGE_2']:.6f} (p={m_quad.pvalues['AGE_2']:.4g}); "
      f"LRT linear-vs-quadratic: chi2(1)={lr:.3f}, p={p_lr:.4g}")

    # Secondary outcome: SAMESAVE
    m_same = smf.logit(
        "SAMESAVE ~ AGE + log_income + FEMALE + BLACK + HISPANIC + BMI_w",
        data=d).fit(disp=0)
    ors = np.exp(m_same.params["AGE"])
    cis = np.exp(m_same.conf_int().loc["AGE"])
    w(f"\nSecondary outcome SAMESAVE: AGE OR/year = {ors:.4f} (95% CI {cis[0]:.4f}-{cis[1]:.4f}), "
      f"p = {m_same.pvalues['AGE']:.4g}")

    # Multinomial robustness: 0=save/put-in, 1=dissave, 2=no-change/no-savings
    d["outcome3"] = np.select([d.DISSAVED == 1, d.SAMESAVE == 1], [1, 2], default=0)
    mn = smf.mnlogit(
        "outcome3 ~ AGE + log_income + FEMALE + BLACK + HISPANIC + BMI_w",
        data=d).fit(disp=0)
    w("\nMultinomial robustness (base = saved/put in; alt 1 = dissave, alt 2 = no change/no savings):")
    for k in [1, 2]:
        eq = mn.params.columns[k - 1]  # positional: base=0, equations ordered by outcome value
        ork = np.exp(mn.params[eq]["AGE"])
        b_ = mn.params[eq]["AGE"]; se_ = mn.bse[eq]["AGE"]
        cik = np.exp((b_ - 1.96 * se_, b_ + 1.96 * se_))
        lbl = "dissave-vs-save" if k == 1 else "nochange-vs-save"
        w(f"  {lbl} AGE OR = {ork:.4f} (95% CI {cik[0]:.4f}-{cik[1]:.4f}), "
          f"p = {mn.pvalues[eq]['AGE']:.4g}")
    w()

with open(OUT, "w") as f:
    f.write("\n".join(lines))
print("\nSaved:", OUT)
