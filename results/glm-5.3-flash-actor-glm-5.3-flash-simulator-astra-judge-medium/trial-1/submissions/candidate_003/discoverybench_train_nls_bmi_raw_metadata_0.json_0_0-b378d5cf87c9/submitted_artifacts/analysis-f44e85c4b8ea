"""
NLSY79: Is higher time preference (present-oriented financial behavior) associated with higher BMI?
Primary spec: BMI 1989 (Height 1985 x Weight 1989) ~ time-preference proxy + covariates (HC1 robust OLS).
"""
import pandas as pd, numpy as np, json
import statsmodels.api as sm

df = pd.read_csv('data/nls_raw.csv')
LB_PER_KG = 1/0.45359237

def g(frag):
    m = [c for c in df.columns if frag in c]
    assert len(m) == 1, (frag, m)
    return m[0]

C = dict(
    w81=g('Weight of respondent, 1981'), w89=g('Weight of respondent, 1989'), w92=g('Weight of respondent, 1992'),
    h81=g('Height of respondent, 1981'), h85=g('Height of respondent, 1985'),
    dir89=g('Was more money put into or taken out of R/spouse savings since last interview, 1989'),
    put89=g('Net amount respondent/spouse put into savings since last interview, 1989'),
    took89=g('Net amount respondent/spouse took out of savings since last interview, 1989'),
    w85=g('Family net wealth, 1985'), w90=g('Family net wealth, 1990'), w96=g('Family net wealth, 1996 (key data point)'),
    inc79=g('Total net family income, previous calendar year, 1979'),
    inc85=g('Total net family income, previous calendar year, 1985'),
    inc89=g('Total net family income, previous calendar year, 1989'),
    age79=g('Age of respondent, 1979'), sex=g('Sex of respondent, 1979'), race=g('Racial/ethnic cohort, 1979'),
    fam=g('Family size, 1979'), med=g("Highest grade completed by respondent's mother, 1979"),
    fed=g("Highest grade completed by respondent's father, 1979"), educ=g('Highest grade completed, 1979'),
    asv='ASVAB - Arithmetic Reasoning Z Score (rounded), 1981',
    sent=g('Ever been sentenced in any correctional institution before 1980'),
)

# ---------- cleaning ----------
def sign_log(x):  # sign-preserving transform for wealth (can be negative)
    return np.sign(x) * np.log1p(np.abs(x))

df['h81_in'] = 12*np.floor(df[C['h81']]/100) + (df[C['h81']] % 100)   # FII decode
h85 = df[C['h85']].where(df[C['h85']].between(45, 90))
w81 = df[C['w81']].where((df[C['w81']] > 40) & (df[C['w81']] < 700) & (df[C['w81']] != 996))
w89 = df[C['w89']].where((df[C['w89']] > 40) & (df[C['w89']] < 700) & (df[C['w89']] != 996))
w92 = df[C['w92']].where((df[C['w92']] > 40) & (df[C['w92']] < 700) & (df[C['w92']] != 996))

bmi = lambda w_lb, h_in: (w_lb*0.45359237) / (h_in*0.0254)**2
df['bmi89'] = bmi(w89, h85).where(lambda s: s.between(15, 60))
df['bmi81'] = bmi(w81, df['h81_in']).where(lambda s: s.between(15, 60))
df['bmi92'] = bmi(w92, h85).where(lambda s: s.between(15, 60))

# exposures
df['dissaved'] = (df[C['dir89']] == 2).astype(float).where(df[C['dir89']].notna())
df['nosavings'] = (df[C['dir89']] == 4).astype(float).where(df[C['dir89']].notna())
put_c = df[C['put89']].where(df[C['put89']] < 1e6)
took_c = df[C['took89']].where(df[C['took89']] < 1e6)
net = (put_c.fillna(0) - took_c.fillna(0)).where(put_c.notna() | took_c.notna())
df['netflow'] = net.where(net.notna())
q99 = df['netflow'].quantile(0.99)
df['netflow_w'] = df['netflow'].clip(upper=q99, lower=df['netflow'].quantile(0.01))
_r = df['netflow_w'].dropna().rank(method='first')
df['netflow_q'] = pd.qcut(_r, 5, labels=False).reindex(df.index)
sg85, sg90, sg96 = sign_log(df[C['w85']]), sign_log(df[C['w90']]), sign_log(df[C['w96']])
df['dlogwealth_85_90'] = sg90 - sg85
df['logwealth96'] = sg96

# covariates
df['male'] = (df[C['sex']] == 1).astype(float)
df['black'] = (df[C['race']] == 1).astype(float); df['hisp'] = (df[C['race']] == 2).astype(float)
df['med_c'] = df[C['med']].where(df[C['med']] <= 20); df['fed_c'] = df[C['fed']].where(df[C['fed']] <= 20)
df['educ_c'] = df[C['educ']].where(df[C['educ']] <= 20)
df['asvab'] = df[C['asv']]
df['logincome79'] = np.log1p(df[C['inc79']].clip(upper=75001))
df['logincome89'] = np.log1p(df[C['inc89']])
rescols = [c for c in df.columns if c.startswith('Type of residence')]
df['everjail'] = ((df[rescols] == 5).any(axis=1) | (df[C['sent']] == 1)).astype(float)

COV = ['male', 'black', 'hisp', C['age79'], C['fam'], 'med_c', 'fed_c', 'educ_c', 'asvab', 'logincome79', 'everjail']

def fit(outcome, exposures, data, extra=None):
    d = data[[outcome] + exposures + COV + (extra or [])].dropna()
    X = sm.add_constant(d[exposures + COV + (extra or [])])
    m = sm.OLS(d[outcome], X).fit(cov_type='HC1')
    return m, d

rows, store = [], {}
def report(label, outcome, exposures, data, extra=None):
    m, d = fit(outcome, exposures, data, extra)
    store[label] = (m, len(d))
    for k in exposures:
        rows.append(dict(spec=label, n=len(d), term=k, b=m.params[k], se=m.bse[k], p=m.pvalues[k],
                         lo=m.conf_int().loc[k,0], hi=m.conf_int().loc[k,1]))
    print(f"\n== {label}  (n={len(d)})  R2={m.rsquared:.4f}")
    for k in exposures:
        print(f"   {k:22s} b={m.params[k]: .3f}  se={m.bse[k]: .3f}  p={m.pvalues[k]:.4g}  CI[{m.conf_int().loc[k,0]:.3f},{m.conf_int().loc[k,1]:.3f}]")
    return m, d

print("="*100); print("PRIMARY: BMI 1989")
m1, d1 = report('A1 dissaved vs rest (BMI89)', 'bmi89', ['dissaved'], df)
m2, d2 = report('A2 4-level savings dir (BMI89)', 'bmi89', ['dissaved', 'nosavings'], df)
df['netflow_w10k'] = df['netflow_w'] / 1e4
m3, d3 = report('A3 net savings flow per $10k winsorized (BMI89)', 'bmi89', ['netflow_w10k'], df)
m4, d4 = report('A4 net flow quintiles (BMI89)', 'bmi89', ['netflow_q'], df)
m5, d5 = report('A5 wealth growth 1985->1990 (BMI89)', 'bmi89', ['dlogwealth_85_90'], df)
m6, d6 = report('A6 log wealth 1996 (BMI89)', 'bmi89', ['logwealth96'], df)

print("\n" + "="*100); print("SECONDARY outcomes")
report('B1 dissaved -> BMI1992', 'bmi92', ['dissaved'], df)
report('B2 wealth growth -> BMI1992', 'bmi92', ['dlogwealth_85_90'], df)
report('B3 dissaved -> dBMI 81->89', 'bmi89', ['dissaved'], df.assign(dbmi=df['bmi89']-df['bmi81']), extra=['bmi81'])
report('B4 wealth growth -> dBMI 81->89', 'bmi89', ['dlogwealth_85_90'], df.assign(dbmi=df['bmi89']-df['bmi81']), extra=['bmi81'])

print("\n" + "="*100); print("ROBUSTNESS: obesity (BMI>=30) logit, HC1")
for lbl, ex in [('L1 dissaved -> obese', ['dissaved']), ('L2 wealth growth -> obese', ['dlogwealth_85_90'])]:
    d = df[['bmi89'] + ex + COV].dropna(); d['obese'] = (d['bmi89'] >= 30).astype(float)
    lg = sm.Logit(d['obese'], sm.add_constant(d[ex + COV])).fit(disp=0, cov_type='HC1')
    orr = np.exp(lg.params[ex[0]])
    print(f"   {lbl} n={len(d)}  OR={orr:.3f}  p={lg.pvalues[ex[0]]:.4g}  CI[{np.exp(lg.conf_int().loc[ex[0],0]):.3f},{np.exp(lg.conf_int().loc[ex[0],1]):.3f}]")

print("\n" + "="*100); print("SENSITIVITY: + contemporaneous income 1989 (collider check)")
df['li89'] = df['logincome89']
report('S1 dissaved + income1989', 'bmi89', ['dissaved'], df, extra=['li89'])
report('S2 wealth growth + income1989', 'bmi89', ['dlogwealth_85_90'], df, extra=['li89'])

print("\n" + "="*100); print("SENSITIVITY: median+missing-indicator imputation of covariates (exposure/outcome kept complete-case)")
def imputed_fit(label, outcome, exposure):
    d0 = df[[outcome, exposure] + COV].dropna(subset=[outcome, exposure]).copy()
    X = d0[COV].copy()
    for c in COV:
        if X[c].isna().any():
            X[c + '_mi'] = X[c].isna().astype(float); X[c] = X[c].fillna(X[c].median())
    X[exposure] = d0[exposure]
    m = sm.OLS(d0[outcome], sm.add_constant(X)).fit(cov_type='HC1')
    print(f"   {label} n={len(d0)}  {exposure}: b={m.params[exposure]:.3f} se={m.bse[exposure]:.3f} p={m.pvalues[exposure]:.4g}")
    rows.append(dict(spec=label, n=len(d0), term=exposure, b=m.params[exposure], se=m.bse[exposure], p=m.pvalues[exposure],
                     lo=m.conf_int().loc[exposure,0], hi=m.conf_int().loc[exposure,1]))
imputed_fit('I1 dissaved (imputed covars)', 'bmi89', 'dissaved')
imputed_fit('I2 wealth growth (imputed covars)', 'bmi89', 'dlogwealth_85_90')

print("\n" + "="*100); print("SAMPLE/ATTRITION + BALANCE DIAGNOSTICS")
base = df[df['bmi89'].notna()]
specs = {'A1 dissaved': d1, 'A5 wealth growth': d5, 'A6 log wealth 96': d6}
summ = {}
for lbl, d in specs.items():
    summ[lbl] = dict(n=len(d), pct_male=round(100*d['male'].mean(),1), pct_black=round(100*d['black'].mean(),1),
                     mean_age79=round(d[C['age79']].mean(),1), mean_edu=round(d['educ_c'].mean(),1),
                     mean_bmi89=round(d['bmi89'].mean(),2), mean_loginc79=round(d['logincome79'].mean(),2))
print(pd.DataFrame(summ).T.to_string())
print("\nFull-sample descriptives: BMI89 mean=%.2f sd=%.2f (n=%d); dissaved share=%.1f%% (n=%d); dir89 counts=%s" % (
    df['bmi89'].mean(), df['bmi89'].std(), df['bmi89'].notna().sum(),
    100*df['dissaved'].mean(), df['dissaved'].notna().sum(),
    df[C['dir89']].value_counts().sort_index().to_dict()))
print("netflow_w median=%.0f, IQR=[%.0f, %.0f]; dlogwealth 85-90 mean=%.3f sd=%.3f" % (
    df['netflow_w'].median(), df['netflow_w'].quantile(.25), df['netflow_w'].quantile(.75),
    df['dlogwealth_85_90'].mean(), df['dlogwealth_85_90'].std()))

res = pd.DataFrame(rows)
res.to_csv('nls_bmi_results.csv', index=False)
print("\nSaved coefficient table -> nls_bmi_results.csv")
