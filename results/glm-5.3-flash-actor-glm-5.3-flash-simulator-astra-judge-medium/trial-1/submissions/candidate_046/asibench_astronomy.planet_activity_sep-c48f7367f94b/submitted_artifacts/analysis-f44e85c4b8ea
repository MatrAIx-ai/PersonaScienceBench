"""
Recover latent summary (component A sinusoid, component B fundamental + first
harmonic, offset) for each case from obs_0 (primary channel) and predict
future component-A-only values.

Model (phases referenced strictly to reference_epoch_day from input_0.json):
  obs_0(t) = offset
           + b1*sin(2*pi*t/PB) + b2*cos(2*pi*t/PB)          (B fundamental)
           + b3*sin(4*pi*t/PB) + b4*cos(4*pi*t/PB)          (B first harmonic)
           + a1*sin(2*pi*t/PA) + a2*cos(2*pi*t/PA)          (component A)

Method:
  1) Coarse 2D chi2 grid scan over (PB, PA) with weighted linear least squares.
  2) Local 2D refinement of both periods.
  3) Component-A detection: Monte-Carlo calibration of max Delta-chi2 over the
     PA grid under the null "no A" (white noise, same sampling/errors).
     Conservative rule: component_a_present = 1 only if empirical p < 0.01.
  4) If A absent: B-only weighted fit (PB refined alone) supplies the summary.
  5) Predictions: A-only value a1*sin(2*pi*t/PA)+a2*cos(2*pi*t/PA) (0 if absent).
"""
import csv, json
import numpy as np
from collections import defaultdict

# ---------------- load ----------------
meta = json.load(open('data/input_0.json'))
cases_order = meta['case_order']
ref = meta['reference_epoch_day']

obs = defaultdict(list)
with open('data/input_1.csv') as f:
    for row in csv.DictReader(f):
        if row['case_id'] in cases_order:
            obs[row['case_id']].append((float(row['time_day']), float(row['obs_0']),
                                        float(row['obs_0_err'])))
targets = []
with open('data/input_2.csv') as f:
    for row in csv.DictReader(f):
        targets.append((row['case_id'], row['time_day']))  # keep exact strings/order

def design(t, PB, PA=None):
    cols = [np.ones_like(t),
            np.sin(2*np.pi*(t-ref)/PB), np.cos(2*np.pi*(t-ref)/PB),
            np.sin(4*np.pi*(t-ref)/PB), np.cos(4*np.pi*(t-ref)/PB)]
    if PA is not None:
        cols += [np.sin(2*np.pi*(t-ref)/PA), np.cos(2*np.pi*(t-ref)/PA)]
    return np.vstack(cols).T

def wfit(t, y, e, PB, PA=None):
    X = design(t, PB, PA); w = 1.0/e**2
    beta = np.linalg.lstsq(X*w[:, None], y*w, rcond=None)[0]
    r = y - X @ beta
    return beta, float(np.sum(w*r**2))

def refine2d(t, y, e, PB, PA, dpb=0.3, dpa=0.5, n=61, iters=3):
    for _ in range(iters):
        PBs = np.linspace(PB-dpb, PB+dpb, n)
        PAs = np.linspace(PA-dpa, PA+dpa, n)
        best = (np.inf, PB, PA)
        for pb in PBs:
            for pa in PAs:
                if abs(pa-pb) < 0.3:
                    continue
                _, c = wfit(t, y, e, pb, pa)
                if c < best[0]:
                    best = (c, pb, pa)
        _, PB, PA = best
        dpb /= (n-1)*2.2; dpa /= (n-1)*2.2
    return PB, PA, best[0]

summary_rows = []
pred_rows = []
diagnostics = {}

for cid in cases_order:
    arr = np.array(obs[cid]); t, y, e = arr[:, 0], arr[:, 1], arr[:, 2]
    n = len(t)

    # ---- 1) coarse 2D scan ----
    PBs = np.arange(4.0, 120.0, 0.25)
    PAs = np.arange(2.0, 300.0, 0.5)
    C = np.full((len(PBs), len(PAs)), np.inf)
    for i, pb in enumerate(PBs):
        for j, pa in enumerate(PAs):
            if abs(pa-pb) < 0.6 or abs(pa-2*pb) < 0.6:
                continue
            C[i, j] = wfit(t, y, e, pb, pa)[1]
    i0, j0 = np.unravel_index(np.argmin(C), C.shape)
    PB, PA = PBs[i0], PAs[j0]

    # ---- 2) refinement ----
    PB, PA, cF = refine2d(t, y, e, PB, PA)
    betaF, cF = wfit(t, y, e, PB, PA)

    # ---- 3) MC calibration for component A ----
    PAg = np.arange(2.0, 120.0, 0.5)
    PAg = PAg[np.abs(PAg-PB) > 0.6]
    cB0 = wfit(t, y, e, PB)[1]
    dchi_obs = cB0 - min(wfit(t, y, e, PB, pa)[1] for pa in PAg)
    rng = np.random.default_rng(12345)
    nmc = 800
    mc = np.empty(nmc)
    PAmc = PAg[::3]
    for k in range(nmc):
        yn = rng.normal(0.0, e)
        cBm = wfit(t, yn, e, PB)[1]
        mc[k] = cBm - min(wfit(t, yn, e, PB, pa)[1] for pa in PAmc)
    pval = float(np.mean(mc >= dchi_obs))
    present = int(pval < 0.01)

    # ---- 4) final coefficients ----
    if present:
        beta, cfin = betaF, cF
        PA_out = PA
    else:
        # B-only: refine PB alone at high resolution
        bestB = (np.inf, PB)
        for pb in np.linspace(PB-0.05, PB+0.05, 1001):
            _, c = wfit(t, y, e, pb)
            if c < bestB[0]:
                bestB = (c, pb)
        _, PB = bestB
        beta, cfin = wfit(t, y, e, PB)
        PA_out = 0.0

    offset = beta[0]
    b1, b2, b3, b4 = beta[1], beta[2], beta[3], beta[4]
    a1, a2 = (beta[5], beta[6]) if present else (0.0, 0.0)
    PA_rep = PA_out if present else 0.0

    summary_rows.append([cid, present, PA_rep, a1, a2, PB, b1, b2, b3, b4, offset])
    diagnostics[cid] = dict(PB=PB, PA=PA, dchiA=dchi_obs, pval=pval, present=present,
                            chi2_full=cF, chi2red=cfin/(n-(7 if present else 5)), n=n)

    # ---- 5) predictions (component A only) ----
    for (pcid, tstr) in targets:
        if pcid != cid:
            continue
        tt = float(tstr)
        if present:
            val = a1*np.sin(2*np.pi*(tt-ref)/PA) + a2*np.cos(2*np.pi*(tt-ref)/PA)
        else:
            val = 0.0
        pred_rows.append([pcid, tstr, val])

# ---------------- write CSVs ----------------
def fmt(x):
    if isinstance(x, str):
        return x
    return repr(float(x))

with open('signal_summary.csv', 'w', newline='') as f:
    wcsv = csv.writer(f)
    wcsv.writerow(['case_id','component_a_present','component_a_period_day',
                   'component_a_basis1_u0','component_a_basis2_u0','component_b_period_day',
                   'component_b_basis1_u0','component_b_basis2_u0','component_b_basis3_u0',
                   'component_b_basis4_u0','offset_u0'])
    for r in summary_rows:
        wcsv.writerow([r[0], int(r[1])] + [fmt(v) for v in r[2:]])

with open('target_predictions.csv', 'w', newline='') as f:
    wcsv = csv.writer(f)
    wcsv.writerow(['case_id','time_day','component_a_value_u0'])
    for r in pred_rows:
        wcsv.writerow([r[0], r[1], fmt(r[2])])

# ---------------- report ----------------
print('=== diagnostics ===')
for cid, d in diagnostics.items():
    print(cid, {k: (round(v, 5) if isinstance(v, float) else v) for k, v in d.items()})
print('\n=== signal_summary.csv ===')
print(open('signal_summary.csv').read())
print('=== target_predictions.csv (first/last rows) ===')
lines = open('target_predictions.csv').read().splitlines()
print('\n'.join(lines[:5])); print('...'); print('\n'.join(lines[-4:]))
print('rows summary=%d, rows predictions=%d' % (len(summary_rows), len(pred_rows)))
