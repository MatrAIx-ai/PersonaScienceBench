 '>':[8,4,2,1,2,4,8],'+':[0,4,4,31,4,4,0],':':[0,6,6,0,6,6,0],
 '[':[14,8,8,8,8,8,14],']':[14,2,2,2,2,2,14],'_':[0,0,0,0,0,0,31],
 '*':[0,21,14,31,14,21,0]}

def _glyph_bits(ch):
    return _G.get(ch.upper(), _G[' '])

class Canvas:
    def __init__(self, w, h, bg=(255, 255, 255)):
        self.w, self.h = w, h
        self.img = np.empty((h, w, 3), np.float64)
        self.img[:] = np.asarray(bg, float)

    def seg(self, x0, y0, x1, y1, color, w=1.6, dash=None):
        x0, y0, x1, y1 = map(float, (x0, y0, x1, y1))
        dx, dy = x1 - x0, y1 - y0
        L = np.hypot(dx, dy)
        if L < 1e-9:
            return
        pad = w + 2
        xa, xb = int(max(0, np.floor(min(x0, x1) - pad))), int(min(self.w - 1, np.ceil(max(x0, x1) + pad)))
        ya, yb = int(max(0, np.floor(min(y0, y1) - pad))), int(min(self.h - 1, np.ceil(max(y0, y1) + pad)))
        if xa > xb or ya > yb:
            return
        px = np.arange(xa, xb + 1) + 0.5
        py = np.arange(ya, yb + 1) + 0.5
        PX, PY = np.meshgrid(px, py)
        t = np.clip(((PX - x0) * dx + (PY - y0) * dy) / L**2, 0.0, 1.0)
        d = np.hypot(PX - (x0 + t * dx), PY - (y0 + t * dy))
        cov = np.clip(w / 2 + 0.5 - d, 0.0, 1.0)
        if dash is not None:
            s = t * L
            per = dash[0] + dash[1]
            cov *= ((s % per) < dash[0]).astype(float)
        m = cov > 0
        if not m.any():
            return
        self.img[ya:yb + 1, xa:xb + 1][m] = (
            self.img[ya:yb + 1, xa:xb + 1][m] * (1 - cov[m][:, None])
            + np.asarray(color, float) * cov[m][:, None])

    def disk(self, x, y, r, color, ring=False, ringw=1.2):
        x, y = float(x), float(y)
        xa, xb = int(max(0, np.floor(x - r - 2))), int(min(self.w - 1, np.ceil(x + r + 2)))
        ya, yb = int(max(0, np.floor(y - r - 2))), int(min(self.h - 1, np.ceil(y + r + 2)))
        if xa > xb or ya > yb:
            return
        px = np.arange(xa, xb + 1) + 0.5
        py = np.arange(ya, yb + 1) + 0.5
        PX, PY = np.meshgrid(px, py)
        d = np.hypot(PX - x, PY - y)
        cov = np.clip(r + 0.5 - d, 0, 1) if not ring else np.clip(ringw / 2 + 0.6 - np.abs(d - r), 0, 1)
        m = cov > 0
        if not m.any():
            return
        self.img[ya:yb + 1, xa:xb + 1][m] = (
            self.img[ya:yb + 1, xa:xb + 1][m] * (1 - cov[m][:, None])
            + np.asarray(color, float) * cov[m][:, None])

    def rect_fill(self, x0, y0, x1, y1, color, alpha=1.0):
        xa, xb = int(max(0, x0)), int(min(self.w - 1, x1))
        ya, yb = int(max(0, y0)), int(min(self.h - 1, y1))
        if xa > xb or ya > yb:
            return
        self.img[ya:yb + 1, xa:xb + 1] = (
            self.img[ya:yb + 1, xa:xb + 1] * (1 - alpha) + np.asarray(color, float) * alpha)

    def text(self, x, y, s, color=(0, 0, 0), scale=2, center=False, rot=0):
        """Draw string with 5x7 bitmap font at pixel (x,y) (top-left), scale s.
        rot=90 draws text running upward (used for y-axis labels)."""
        bit = _glyph_bits
        if rot == 90:
            total = len(s) * 6 * scale
            cx = x - total / 2.0
            for ch in s:
                rows = bit(ch)
                arr = np.zeros((7, 5))
                for r in range(7):
                    for c in range(5):
                        arr[r, c] = (rows[r] >> (4 - c)) & 1
                arr = np.rot90(arr, k=1)  # rotate: text runs upward
                gh, gw = arr.shape
                for r in range(gh):
                    for c in range(gw):
                        if arr[r, c]:
                            self.rect_fill(cx + c * scale, y + (len(s) - 1) * 6 * scale
                                           - r * scale - 7 * scale + (len(s) - 1) * 0,
                                           cx + (c + 1) * scale, y + (len(s) - 1) * 6 * scale
                                           - r * scale + scale, color)
                cx += 6 * scale
            return
        if center:
            x -= len(s) * 6 * scale / 2.0
        for k, ch in enumerate(s):
            rows = bit(ch)
            for r in range(7):
                for c in range(5):
                    if (rows[r] >> (4 - c)) & 1:
                        self.rect_fill(x + k * 6 * scale + c * scale, y + r * scale,
                                       x + k * 6 * scale + (c + 1) * scale,
                                       y + (r + 1) * scale, color)

    def save(self, path):
        data = self.img.clip(0, 255).astype(np.uint8)
        h, w = data.shape[:2]
        raw = b''.join(b'\x00' + data[y].tobytes() for y in range(h))
        def chunk(tag, payload):
            c = tag + payload
            return struct.pack('>I', len(payload)) + c + struct.pack('>I', zlib.crc32(c) & 0xffffffff)
        png = (b'\x89PNG\r\n\x1a\n'
               + chunk(b'IHDR', struct.pack('>IIBBBBB', w, h, 8, 2, 0, 0, 0))
               + chunk(b'IDAT', zlib.compress(raw, 6))
               + chunk(b'IEND', b''))
        open(path, 'wb').write(png)


class Axes:
    """Minimal data->pixel axes on a Canvas, with ticks/labels/legend."""

    def __init__(self, cv, px, py, pw, ph, xlim, ylim):
        self.cv, self.px, self.py, self.pw, self.ph = cv, px, py, pw, ph
        self.xlim, self.ylim = xlim, ylim
        cv.rect_fill(px, py, px + pw, py + ph, (255, 255, 255))
        cv.rect_fill(px, py, px + pw, py + ph, (250, 250, 250), alpha=0.0)

    def tp(self, x, y):
        fx = (x - self.xlim[0]) / (self.xlim[1] - self.xlim[0])
        fy = (y - self.ylim[0]) / (self.ylim[1] - self.ylim[0])
        return (self.px + fx * self.pw, self.py + self.ph - fy * self.ph)

    def _clip(self, pts):
        (x, y) = pts
        return (min(max(x, self.px), self.px + self.pw),
                min(max(y, self.py), self.py + self.ph))

    def plot(self, xs, ys, color, lw=1.8, dash=None):
        P = [self._clip(self.tp(x, y)) for x, y in zip(xs, ys)]
        for a, b in zip(P[:-1], P[1:]):
            self.cv.seg(a[0], a[1], b[0], b[1], color, w=lw, dash=dash)

    def vline(self, xv, color, lw=1.4, dash=(5, 4)):
        (x, ya) = self.tp(xv, self.ylim[0]); (_, yb) = self.tp(xv, self.ylim[1])
        self.cv.seg(x, ya, x, yb, color, w=lw, dash=dash)

    def band(self, x0, x1, color, alpha=0.15):
        (xa, ya) = self.tp(x0, self.ylim[0]); (xb, yb) = self.tp(x1, self.ylim[1])
        self.cv.rect_fill(min(xa, xb), min(ya, yb), max(xa, xb), max(ya, yb),
                          color, alpha=alpha)

    def errorbar(self, x, y, sx=None, sy=None, color=(0, 0, 0), ms=3.5,
                 cap=5, ring=False):
        (px, py) = self.tp(x, y)
        if sy is not None:
            (_, y1) = self.tp(x, y - sy); (_, y2) = self.tp(x, y + sy)
            self.cv.seg(px, y1, px, y2, color, w=1.1)
            self.cv.seg(px - cap / 2, y1, px + cap / 2, y1, color, w=1.1)
            self.cv.seg(px - cap / 2, y2, px + cap / 2, y2, color, w=1.1)
        if sx is not None:
            (x1, _) = self.tp(x - sx, y); (x2, _) = self.tp(x + sx, y)
            self.cv.seg(x1, py, x2, py, color, w=1.1)
            self.cv.seg(x1, py - cap / 2, x1, py + cap / 2, color, w=1.1)
            self.cv.seg(x2, py - cap / 2, x2, py + cap / 2, color, w=1.1)
        self.cv.disk(px, py, ms, color, ring=ring)

    def ticks(self, color=(60, 60, 60)):
        cv = self.cv
        def nice(lo, hi, n=6):
            span = hi - lo
            raw = span / n
            mag = 10 ** np.floor(np.log10(raw))
            for m in (1, 2, 5, 10):
                if raw <= m * mag:
                    step = m * mag; break
            start = np.ceil(lo / step) * step
            vals = np.arange(start, hi + 0.5 * step, step)
            dec = max(0, -int(np.floor(np.log10(step))))
            return vals, dec
        xt, xdec = nice(*self.xlim); yt, ydec = nice(*self.ylim)
        for v in xt:
            (px, py) = self.tp(v, self.ylim[0])
            cv.seg(px, py, px, py + 6, color, w=1.2)
            lab = f"{v:.{xdec}f}"
            cv.text(px - len(lab) * 3 * 2, py + 10, lab, scale=2)
        for v in yt:
            (px, py) = self.tp(self.xlim[0], v)
            cv.seg(self.px - 6, py, self.px, py, color, w=1.2)
            lab = f"{v:.{ydec}f}"
            cv.text(self.px - 10 - len(lab) * 6 * 2, py - 7, lab, scale=2)
        cv.rect_fill(self.px, self.py + self.ph, self.px + self.pw,
                     self.py + self.ph + 1.5, color)          # x spine
        cv.rect_fill(self.px - 1.5, self.py, self.px, self.py + self.ph,
                     color)                                    # y spine

    def legend(self, entries, x_off=12, y_off=10, scale=2):
        """entries: list of (kind, color, label); kind in line/dot/dash"""
        cv = self.cv; y = self.py + y_off
        for kind, color, lab in entries:
            (sx, _) = self.tp(self.xlim[0], 0)
            lx = self.px + x_off + 8
            if kind == 'line':
                cv.seg(lx - 22, y + 6, lx + 2, y + 6, color, w=2.4)
            elif kind == 'dash':
                cv.seg(lx - 22, y + 6, lx + 2, y + 6, color, w=2.4, dash=(5, 4))
            else:
                cv.disk(lx - 10, y + 6, 3.5, color, ring=(kind == 'oring'))
            cv.text(lx + 8, y, lab, scale=scale)
            y += 9 * scale + 4

