def _png_write(path, arr):
    """Write an HxWx3 uint8 array as a PNG file (RGB, 8 bit)."""
    h, w, _ = arr.shape
    raw = bytearray()
    step = w * 3
    flat = arr.reshape(h, step)
    for i in range(h):
        raw += b"\x00" + flat[i].tobytes()
    comp = zlib.compress(bytes(raw), 6)

    def chunk(tag, data):
        return (struct.pack(">I", len(data)) + tag + data
                + struct.pack(">I", zlib.crc32(tag + data) & 0xFFFFFFFF))

    ihdr = struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0)
    with open(path, "wb") as fh:
        fh.write(b"\x89PNG\r\n\x1a\n")
        fh.write(chunk(b"IHDR", ihdr))
        fh.write(chunk(b"IDAT", comp))
        fh.write(chunk(b"IEND", b""))


def _px(img, x, y, color):
    if 0 <= x < img.shape[1] and 0 <= y < img.shape[0]:
        img[y, x] = color


def _line(img, x0, y0, x1, y1, color):
    dx, dy = x1 - x0, y1 - y0
    n = int(max(abs(dx), abs(dy))) + 1
    for t in np.linspace(0.0, 1.0, n):
        _px(img, int(round(x0 + t * dx)), int(round(y0 + t * dy)), color)


def _rect(img, x0, y0, x1, y1, color):
    _line(img, x0, y0, x1, y0, color)
    _line(img, x1, y0, x1, y1, color)
    _line(img, x1, y1, x0, y1, color)
    _line(img, x0, y1, x0, y0, color)


def _text(img, x, y, s, scale=2, color=CLR_BLACK):
    """Draw s at pixel (x, y) = top-left, using the 3x5 bitmap font."""
    cx = x
    for ch in s.upper():
        g = _FONT.get(ch)
        if g is None:
            g = _FONT[' ']
        for row, bits in enumerate(g):
            for col in range(3):
                if bits >> (2 - col) & 1:
                    img_y = y + row * scale
                    img_x = cx + col * scale
                    img[img_y:img_y + scale, img_x:img_x + scale] = color
        cx += 4 * scale
    return cx


def _nice_ticks(lo, hi, n=5):
    if hi <= lo:
        hi = lo + 1.0
    span = hi - lo
    step = 10.0 ** np.floor(np.log10(span / n))
    for m in (1.0, 2.0, 5.0, 10.0):
        if span / step <= n * m:
            step *= m
            break
    start = np.ceil(lo / step) * step
    ticks = []
    v = start
    while v <= hi + 1e-12:
        ticks.append(float(v))
        v += step
    return ticks


def _fmt(v):
    if abs(v - round(v)) < 1e-9 and abs(v) < 1e6:
        return str(int(round(v)))
    return f"{v:.3g}"


def _panel(img, box, title_lines, curves, xr, yr, xlog, xlabel, ylabel):
    """Draw one panel: axes box, curves [(Nx2 pts, color)], labels."""
    x0, y0, x1, y1 = box          # pixel box: left, top, right, bottom
    top = y0
    _rect(img, x0, top, x1, y1, CLR_BLACK)
    ty = top + 6
    for t in title_lines:
        _text(img, x0 + 8, ty, t, scale=2)
        ty += 14
    lo_x, hi_x = (np.log10(xr[0]), np.log10(xr[1])) if xlog else xr
    lo_y, hi_y = yr
    if hi_y <= lo_y:
        hi_y = lo_y + 1.0

    def to_px_x(v):
        vv = np.log10(v) if xlog else v
        f = (vv - lo_x) / (hi_x - lo_x)
        return x0 + f * (x1 - x0)

    def to_px_y(v):
        f = (v - lo_y) / (hi_y - lo_y)
        return y1 - f * (y1 - y0)

    if xlog:
        tvx = [10.0 ** k for k in range(int(np.floor(np.log10(xr[0]))),
                                        int(np.ceil(np.log10(xr[1]))) + 1)]
    else:
        tvx = _nice_ticks(lo_x, hi_x, 4)
    for v in tvx:
        vv = np.log10(v) if xlog else v
        if lo_x - 1e-12 <= vv <= hi_x + 1e-12:
            xp = int(round(to_px_x(v)))
            _line(img, xp, y1, xp, y1 + 4, CLR_BLACK)
            s = _fmt(v)
            _text(img, xp - 3 * len(s), y1 + 6, s, scale=2)
    for v in _nice_ticks(lo_y, hi_y, 4):
        yp = int(round(to_px_y(v)))
        if top - 2 <= yp <= y1 + 2:
            _line(img, x0 - 4, yp, x0, yp, CLR_BLACK)
            s = _fmt(v)
            _text(img, x0 - 8 - 4 * len(s) * 2, yp - 5, s, scale=2)
    for pts, color in curves:
        arr = np.asarray(pts, dtype=np.float64)
        if arr.ndim == 2 and arr.shape[0] == 2 and arr.shape[1] > 2:
            arr = arr.T                      # (x-list, y-list) pair form
        px = np.array([to_px_x(v) for v in arr[:, 0]])
        py = np.array([to_px_y(v) for v in arr[:, 1]])
        for k in range(len(px) - 1):
            _line(img, px[k], py[k], px[k + 1], py[k + 1], color)
    _text(img, (x0 + x1) // 2 - 4 * len(xlabel), y1 + 22, xlabel, scale=2)
    for k, ch in enumerate(ylabel):
        _text(img, x0 - 58, top + 40 + k * 12, ch, scale=2)


