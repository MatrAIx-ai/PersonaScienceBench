def _text(img, x, y, s, scale=2, color=(25, 25, 25)):
    cx = x
    for ch in s:
        for (ax, ay), (bx, by) in _FONT.get(ch, []):
            _line(img, (cx + ax * scale, y + ay * scale),
                  (cx + bx * scale, y + by * scale), color, max(1, scale - 1))
        cx += 6 * scale


def _axes(img, box, title, xlabel, ylabel, xticks, yticks, xfmt="%.2f", yfmt="%.2f"):
    x0, y0, x1, y1 = box
    ax0, ay0, ax1, ay1 = x0 + 100, y0 + 60, x1 - 30, y1 - 75
    for p, q in [((ax0, ay0), (ax1, ay0)), ((ax1, ay0), (ax1, ay1)),
                 ((ax1, ay1), (ax0, ay1)), ((ax0, ay1), (ax0, ay0))]:
        _line(img, p, q, (0, 0, 0), 2)
    for t in xticks:
        px = int(ax0 + (t - xticks[0]) / (xticks[-1] - xticks[0]) * (ax1 - ax0))
        _line(img, (px, ay1), (px, ay1 + 8), (0, 0, 0), 2)
        lab = xfmt % t
        _text(img, px - 3 * len(lab), ay1 + 14, lab, 2)
    for t in yticks:
        py = int(ay1 - (t - yticks[0]) / (yticks[-1] - yticks[0]) * (ay1 - ay0))
        _line(img, (ax0 - 8, py), (ax0, py), (0, 0, 0), 2)
        lab = yfmt % t
        _text(img, ax0 - 16 - 6 * len(lab), py - 6, lab, 2)
    _text(img, (x0 + x1) // 2 - 3 * len(title), y0 + 16, title, 2)
    _text(img, (ax0 + ax1) // 2 - 3 * len(xlabel), y1 - 42, xlabel, 2)
    _text(img, ax0 + 10, ay0 - 40, ylabel, 2)
    span_x, span_y = ax1 - ax0, ay1 - ay0

    def mapper(xlim, ylim, pad=10):
        xmin, xmax = xlim
        ymin, ymax = ylim

        def f(x, y):
            px = ax0 + pad + (x - xmin) / (xmax - xmin) * (span_x - 2 * pad)
            py = ay1 - pad - (y - ymin) / (ymax - ymin) * (span_y - 2 * pad)
            return int(px), int(py)
        return f
    return mapper


def render_visualization(final_low, nat_i, nat_j, temps, hists, edges, fine,
                         cv_fine, cv_T, t_star, centers, fe, modes, barrier):
    K = len(temps)
    img = np.full((1050, 1400, 3), 255, np.uint8)
    p1, p2 = (60, 60, 660, 500), (740, 60, 1340, 500)
    p3, p4 = (60, 570, 660, 1000), (740, 570, 1340, 1000)

    # --- panel 1: 3D final configuration (orthographic projection) ----------
    a, e = np.radians(30.0), np.radians(25.0)
    ca, sa, ce, se = np.cos(a), np.sin(a), np.cos(e), np.sin(e)
    X, Y, Z = final_low.T
    u = X * ca - Y * sa
    depth = X * sa + Y * ca
    v = -depth * se + Z * ce
    bx0, by0, bx1, by1 = p1[0] + 60, p1[1] + 70, p1[2] - 40, p1[3] - 90
    s = min((bx1 - bx0) / (u.max() - u.min() + 1e-9),
            (by1 - by0) / (v.max() - v.min() + 1e-9))
    px = (bx0 + bx1) / 2 + (u - u.mean()) * s
    py = (by0 + by1) / 2 - (v - v.mean()) * s
    pts = np.stack([px, py], 1).astype(int)
    order = np.argsort(depth)          # painter's algorithm: far beads first
    for i in range(len(pts) - 1):
        _line(img, tuple(pts[i]), tuple(pts[i + 1]), (140, 140, 140), 3)
    for i, j in zip(nat_i, nat_j):
        _line(img, tuple(pts[i]), tuple(pts[j]), (30, 60, 210), 2)
    for i in order:
        _disc(img, pts[i][0], pts[i][1], 8, (205, 40, 40))
        _disc(img, pts[i][0] - 2, pts[i][1] - 2, 3, (235, 120, 120))
    _text(img, (p1[0] + p1[2]) // 2 - 150, p1[1] + 18,
          "FINAL CONFIG AT T=%.3F (LOWEST)" % temps[0], 2)
    _text(img, p1[0] + 40, p1[3] - 40, "RED: BEADS, GRAY: CHAIN, BLUE: NATIVE CONTACTS", 2)
    _text(img, p1[0] + 40, p1[1] + 40, "Q SIMILARITY = FRACTION OF M=36 NATIVE CONTACTS FORMED", 2)

    # --- panel 2: Q histograms ------------------------------------------------
    mp = _axes(img, p2, "Q HISTOGRAMS PER TEMPERATURE", "Q", "P(Q)",
               [0.0, 0.25, 0.5, 0.75, 1.0],
               [0.0, round(hists.max() * 0.5, 2), round(hists.max(), 2)], yfmt="%.2f")
    f2 = mp((0.0, 1.0), (0.0, hists.max() * 1.15))
    for k in range(K):
        t = k / (K - 1)
        col = (int(30 + 175 * t), int(70 - 30 * t), int(200 - 170 * t))
        prev = f2(0.0, hists[k][0])
        for b in range(1, len(centers)):
            cur = f2(centers[b], hists[k][b])
            _line(img, prev, cur, col, 2)
            prev = cur
    _text(img, p2[0] + 140, p2[1] + 70, "BLUE = LOW T, RED = HIGH T", 2)

    # --- panel 3: heat capacity -------------------------------------------------
    ylo = 0.0
    yhi = 1.1 * max(cv_fine.max(), cv_T.max())
    mp = _axes(img, p3, "HEAT CAPACITY CV = VAR(E)/T2", "T", "CV/KB",
               [round(t, 2) for t in np.linspace(temps.min(), temps.max(), 4)],
               [0.0, round(yhi / 2, 2), round(yhi, 2)], yfmt="%.1f")
    f3 = mp((float(fine.min()), float(fine.max())), (0.0, yhi))
    prev = f3(fine[0], cv_fine[0])
    for i in range(1, len(fine)):
        cur = f3(fine[i], cv_fine[i])
        _line(img, prev, cur, (0, 0, 0), 2)
        prev = cur
    for k in range(K):
        cx, cy = f3(temps[k], cv_T[k])
        _disc(img, cx, cy, 5, (230, 120, 30))
    lx, ly0 = f3(t_star, 0.0)
    ly1 = f3(t_star, yhi)[1]
    _line(img, (lx, ly1), (lx, ly0), (200, 30, 30), 2, dash=(6, 5))
    _text(img, lx - 40, p3[1] + 70, "T*=%.3F" % t_star, 2, (200, 30, 30))

    # --- panel 4: free-energy profile at T* -------------------------------------
    yhi = 1.15 * fe.max()
    mp = _axes(img, p4, "FREE ENERGY F(Q) AT T*=%.3F" % t_star, "Q", "F(Q) [KBT*]",
               [0.0, 0.25, 0.5, 0.75, 1.0],
               [0.0, round(yhi / 2, 1), round(yhi, 1)], yfmt="%.1f")
    f4 = mp((0.0, 1.0), (0.0, yhi))
    prev = f4(centers[0], fe[0])
    for b in range(1, len(centers)):
        cur = f4(centers[b], fe[b])
        _line(img, prev, cur, (30, 60, 200), 3)
        prev = cur
    for m in modes:
        mx, my0 = f4(m, 0.0)
        my1 = f4(m, yhi)[1]
        _line(img, (mx, my1), (mx, my0), (30, 150, 60), 2, dash=(4, 4))
    _text(img, p4[0] + 130, p4[1] + 70,
          "MODES AT Q=%s  BARRIER=%.2F KBT*" % (str(modes)[:22], barrier), 2)
    _png_write("visualization.png", img)


