def draw_text(img, x, y, s, color, scale=1):
    for ch in s:
        g = GLYPHS.get(ch.upper())
        if g is not None:
            for r, row in enumerate(g):
                for cc, v in enumerate(row):
                    if v == '1':
                        img[y+r*scale:y+(r+1)*scale, x+cc*scale:x+(cc+1)*scale] = color
        x += 6 * scale

def write_png(path, img):
    h, w = img.shape[:2]
    raw = b''.join(b'\x00' + img[i].tobytes() for i in range(h))
    def chunk(t, d):
        return struct.pack('>I', len(d)) + t + d + struct.pack('>I', zlib.crc32(t + d) & 0xffffffff)
    ihdr = struct.pack('>IIBBBBB', w, h, 8, 2, 0, 0, 0)
    with open(path, 'wb') as f:
        f.write(b'\x89PNG\r\n\x1a\n' + chunk(b'IHDR', ihdr)
                + chunk(b'IDAT', zlib.compress(raw, 6)) + chunk(b'IEND', b''))

def diverging(t):
    """t in [-1,1]: blue -> white -> red."""
    t = np.clip(t, -1.0, 1.0)
    rgb = np.zeros(t.shape + (3,))
    pos = t > 0
    rgb[..., 0] = np.where(pos, 1.0 - 0.15 * t, 1.0 + t)
    rgb[..., 1] = np.where(pos, 1.0 - 0.75 * t, 1.0 + 0.35 * t)
    rgb[..., 2] = np.where(pos, 1.0 - 0.75 * t, 1.0)
    return (np.clip(rgb, 0, 1) * 255).astype(np.uint8)

