def _png_write(path, rgb):
    import struct, zlib
    h, w, _ = rgb.shape
    raw = b"".join(b"\x00" + rgb[i].tobytes() for i in range(h))
    def chunk(tag, data):
        return struct.pack(">I", len(data)) + tag + data + struct.pack(">I", zlib.crc32(tag + data) & 0xFFFFFFFF)
    with open(path, "wb") as f:
        f.write(b"\x89PNG\r\n\x1a\n")
        f.write(chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0)))
        f.write(chunk(b"IDAT", zlib.compress(raw, 9)))
        f.write(chunk(b"IEND", b""))

def _draw_line(img, x0, y0, x1, y1, color, thick=1):
    n = int(max(abs(x1 - x0), abs(y1 - y0))) + 1
    for i in range(n):
        t = i / max(n - 1, 1)
        x, y = int(round(x0 + t * (x1 - x0))), int(round(y0 + t * (y1 - y0)))
        img[max(0, y - thick + 1):y + thick, max(0, x - thick + 1):x + thick] = color

def _draw_text(img, x, y, s, color=(0, 0, 0), scale=2):
    for k, ch in enumerate(s.upper()):
        rows = _FONT.get(ch, _FONT[" "]).split()
        for r, row in enumerate(rows):
            for c, bit in enumerate(row):
                if bit == "1":
                    yy = y + r * scale
                    xx = x + k * 6 * scale + c * scale
                    img[yy:yy + scale, xx:xx + scale] = color

def _marker(img, cx, cy, style, color):
    if style == "s":
        img[cy - 2:cy + 3, cx - 2:cx + 3] = color
    elif style == "o":
        for dx in range(-2, 3):
            for dy in range(-2, 3):
                if dx * dx + dy * dy <= 5:
                    img[cy + dy, cx + dx] = color
    else:  # triangle
        img[cy - 2, cx - 2:cx + 3] = color
        img[cy - 1, cx - 1:cx + 2] = color
        img[cy, cx - 2:cx + 3] = color
        img[cy + 1, cx - 2:cx + 3] = color
        img[cy + 2, cx] = color

def _panel(img, px0, py0, px1, py1, series, xticks, yticks, xlabel, ylabel, title,
           vline=None, legend=None, ylog=False):
    """series: list of (values_y, color, marker, label). x values are shared (T grid)."""
    BLACK, GREY = (0, 0, 0), (150, 150, 150)
    _draw_line(img, px0, py0, px1, py0, BLACK, 1)
    _draw_line(img, px0, py1, px1, py1, BLACK, 1)
    _draw_line(img, px0, py0, px0, py1, BLACK, 1)
    _draw_line(img, px1, py0, px1, py1, BLACK, 1)
    tvals = series[0][0]
    tmin, tmax = tvals.min(), tvals.max()
    ys_all = np.concatenate([s[1] for s in series])
    if ylog:
        ylo, yhi = np.floor(np.log10(ys_all.min())) - 0.2, np.ceil(np.log10(ys_all.max())) + 0.2
        def ymap(v):
            return py1 - (np.log10(v) - ylo) / (yhi - ylo) * (py1 - py0)
    else:
        ylo, yhi = ys_all.min() - 0.08 * (ys_all.max() - ys_all.min() + 1e-9), \
                   ys_all.max() + 0.08 * (ys_all.max() - ys_all.min() + 1e-9)
        def ymap(v):
            return py1 - (v - ylo) / (yhi - ylo) * (py1 - py0)
    def xmap(v):
        return px0 + (v - tmin) / (tmax - tmin) * (px1 - px0)
    for tv in xticks:
        xp = xmap(tv)
        _draw_line(img, xp, py1, xp, py1 + 5, BLACK, 1)
        _draw_text(img, int(xp) - 12, py1 + 9, f"{tv:g}", scale=1)
        _draw_line(img, xp, py0, xp, py1, (235, 235, 235), 1)
    for yv in yticks:
        yp = ymap(yv)
        _draw_line(img, px0 - 5, int(yp), px0, int(yp), BLACK, 1)
        label = f"1e{int(yv)}" if ylog else f"{yv:g}"
        _draw_text(img, px0 - 10 - 6 * len(label), int(yp) - 6, label, scale=1)
        _draw_line(img, px0, int(yp), px1, int(yp), (235, 235, 235), 1)
    if vline is not None:
        xv = xmap(vline)
        for yy in range(py0, py1, 8):
            _draw_line(img, xv, yy, xv, min(yy + 4, py1), GREY, 1)
    for (_, vals, color, marker, _lbl) in series:
        xs_pix = [xmap(v) for v in tvals]
        ys_pix = [ymap(v) for v in vals]
        for a, b in zip(zip(xs_pix[:-1], ys_pix[:-1]), zip(xs_pix[1:], ys_pix[1:])):
            _draw_line(img, a[0], a[1], b[0], b[1], color, 1)
        for xp, yp in zip(xs_pix, ys_pix):
            _marker(img, int(xp), int(yp), marker, color)
    _draw_text(img, px0, py0 - 26, title, scale=2)
    _draw_text(img, int((px0 + px1) / 2 - 6 * len(xlabel)), py1 + 22, xlabel, scale=2)
    _draw_text(img, px0, py0 - 10, ylabel, scale=2)
    if legend:
        for j, (color, marker, label) in enumerate(legend):
            ly = py0 + 14 + j * 16
            _draw_line(img, px1 - 170, ly + 5, px1 - 150, ly + 5, color, 1)
            _marker(img, px1 - 160, ly + 5, marker, color)
            _draw_text(img, px1 - 144, ly, label, scale=1)

def make_plot(rc_df, T_crossover, path):
    T = rc_df.T_K.values
    W, H = 1100, 480
    img = np.full((H, W, 3), 255, np.uint8)
    kmax = int(math.ceil(rc_df.log10_k_enhanced_s_inv.max()))
    kmin = int(math.floor(rc_df.log10_k_local_s_inv.min()))
    ytk = np.arange(math.floor(kmin), math.ceil(kmax) + 1, max(1, (kmax - kmin) // 5))
    xtk = [200, 400, 600, 800, 1000]
    _panel(img, 80, 70, 560, 400,
           [(T, rc_df.log10_k_local_s_inv.values, (0, 0, 200), "o", "local"),
            (T, rc_df.log10_k_optimized_s_inv.values, (0, 130, 0), "s", "optimized"),
            (T, rc_df.log10_k_enhanced_s_inv.values, (200, 0, 0), "^", "enhanced")],
           xtk, ytk, "T (K)", "LOG10 K (S^-1)", "RATE VARIANTS (LIGHT)",
           vline=T_crossover,
           legend=[((0, 0, 200), "o", "LOCAL"), ((0, 130, 0), "s", "OPTIMIZED"),
                   ((200, 0, 0), "^", "ENHANCED")])
    kap = rc_df.enhancement_factor.values
    yt2 = [10.0 ** p for p in np.arange(math.floor(np.log10(kap.min())),
                                        math.ceil(np.log10(kap.max())) + 0.5, 1)]
    _panel(img, 660, 70, 1060, 400,
           [(T, kap, (180, 0, 60), "d", "kappa")], xtk, yt2,
           "T (K)", "ENHANCEMENT FACTOR", "TUNNELING ENHANCEMENT", ylog=True)
    _draw_text(img, 80, 440, f"CROSSOVER T = {T_crossover:.1F} K  (DASHED LINE, LEFT PANEL)",
               scale=2)
    _png_write(path, img)


