#!/usr/bin/env python3
"""
VTST / semiclassical tunneling analysis for the supplied 2D reaction-energy dataset.

Computes, for crossing from the lower-x (reactant) basin to the higher-x (product) basin:
  1. k_local      : canonical TST with the dividing surface fixed at the conventional
                    (maximum-potential) corridor saddle, harmonic quantum transverse mode.
  2. k_optimized  : canonical TST with the dividing surface placed at the maximum of the
                    free-energy profile F(s,T) along the ordered corridor.
  3. k_enhanced   : k_optimized multiplied by the semiclassical corridor transmission
                    factor kappa_corridor(T) (WKB actions, Hill-Wheeler transmission).

Isotope cases recompute transverse frequencies (nu ~ sqrt(kappa/m_t)), the longitudinal
barrier frequency / crossover temperature (nu_b ~ sqrt(|kappa_L|/m_l)) and the WKB
actions (S ~ sqrt(m_l)) with the supplied mass scales.

Conventions follow the task manifest and the researcher-approved plan:
  - free energy per transverse harmonic mode: g = hc*nu/2 + kT*ln(1 - exp(-hc*nu/kT))
  - optimized crossing surface: argmax_s F(s,T) (tube q-offsets reported as diagnostics)
  - crossover temperature: T_c = hbar*|omega_b| / (2*pi*kB) = nu_b[cm^-1]*hc_over_kB/(2*pi)
  - 2D action: corner-cutting path guided by tube-scan minima, energies interpolated
    from the 2D surface
  - prefactor k = (kB*T/h)*exp(-dG‡/RT); quantum correction only in "enhanced"
  - semiclassical_action_scale = 1.24 multiplies the (dimensionless) WKB actions
"""

import json
import math
from pathlib import Path

import numpy as np
import pandas as pd
try:
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt
    HAVE_MPL = True
except Exception:
    HAVE_MPL = False   # pure-numpy PNG rasterizer fallback is defined below
from scipy.interpolate import RegularGridInterpolator

DATA = Path("data")
OUT = Path("results")
OUT.mkdir(exist_ok=True)

# ----------------------------------------------------------------------------- constants
manifest = json.loads((DATA / "system_manifest.json").read_text())
C = manifest["public_constants"]
R_KJ = C["R_kJ_mol_K"]                      # kJ mol^-1 K^-1
FREQ_SCALE = C["frequency_scale_cm1_per_sqrt_kj_mol_coord2"]   # cm^-1 per sqrt(kJ/mol/coord^2)
HC_KJ = C["hc_kJ_mol_per_cm"]               # kJ mol^-1 per cm^-1
HC_OVER_KB = C["hc_over_kB_K_cm"]           # K cm (h*c/kB)
KB_OVER_H = C["kB_over_h_s_per_K"]          # s^-1 K^-1
ACTION_SCALE = C["semiclassical_action_scale"]

SADDLE_WINDOW = 5        # +/- corridor points used for the longitudinal barrier curvature
N_ENERGY_GRID = 96       # rows in transmission_profile.csv (>= 56 required)
E_ABOVE = 10.0           # kJ/mol above the barrier top covered by the tabulated grid
KAPPA_E_ABOVE = 30.0     # kJ/mol above barrier used in the fine kappa integration
KAPPA_N_FINE = 2401      # fine grid points for the kappa(T) thermal average
N_PATH_STEPS = 41        # path samples per selected energy in path_samples.csv
PATH_TARGET_ENERGIES = [2.0, 10.0, 20.0, 30.0, 40.0, 46.0]
N_S_DENSE = 4001         # dense samples along corridor / corner-cutting path

# ----------------------------------------------------------------------------- input data
surf = pd.read_csv(DATA / "surface_samples.csv")
curve = pd.read_csv(DATA / "curve_samples.csv").sort_values("point_id").reset_index(drop=True)
tube = pd.read_csv(DATA / "tube_scan.csv")
tgrid = pd.read_csv(DATA / "temperature_grid.csv").sort_values("temperature_id")
iso = pd.read_csv(DATA / "isotope_cases.csv").sort_values("case_index").reset_index(drop=True)

xs = np.sort(surf.x.unique())
ys = np.sort(surf.y.unique())
Vgrid = (surf.pivot(index="grid_x_index", columns="grid_y_index", values="potential_kj_mol")
         .sort_index().sort_index(axis=1).values)
assert Vgrid.shape == (len(xs), len(ys))
surface = RegularGridInterpolator((xs, ys), Vgrid, method="linear", bounds_error=False)

# ----------------------------------------------------------------------------- corridor
s_c = curve.s_coord.values
x_c = curve.x.values
y_c = curve.y.values
qx = curve.normal_x.values     # tube offsets run along the supplied normal direction
qy = curve.normal_y.values
V0 = tube[tube.q_offset == 0.0].sort_values("point_id").potential_kj_mol.values
assert len(V0) == len(curve)

# transverse harmonic model: quadratic fit of V(q) over all 13 tube offsets per point
kappa_t = np.zeros(len(curve))       # kJ mol^-1 coord^-2
q_star = np.zeros(len(curve))        # fitted transverse minimum offset (diagnostic)
for i in range(len(curve)):
    g = tube[tube.point_id == i].sort_values("q_offset")
    c2, c1, c0 = np.polyfit(g.q_offset.values, g.potential_kj_mol.values, 2)
    kappa_t[i] = 2.0 * c2
    q_star[i] = -c1 / (2.0 * c2)
V_tube_min = tube.groupby("point_id").potential_kj_mol.min().values  # diagnostic relief

def nu_trans(m_trans_scale):
    """Transverse harmonic frequency along the corridor, cm^-1."""
    return FREQ_SCALE * np.sqrt(kappa_t / m_trans_scale)

# conventional saddle: maximum of the corridor potential
i_sad = int(np.argmax(V0))
s_local = s_c[i_sad]
E_bar = float(V0[i_sad])

# longitudinal barrier curvature (imaginary mode) from the corridor potential
w = SADDLE_WINDOW
sl = slice(i_sad - w, i_sad + w + 1)
kappa_L = float(np.polyfit(s_c[sl] - s_c[i_sad], V0[sl], 2)[0] * 2.0)   # negative
nu_barrier_light = FREQ_SCALE * math.sqrt(abs(kappa_L))                  # cm^-1

def crossover_T(m_long_scale):
    nu_b = FREQ_SCALE * math.sqrt(abs(kappa_L) / m_long_scale)
    return nu_b * HC_OVER_KB / (2.0 * math.pi)

T_c_light = crossover_T(1.0)

# ------------------------------------------------------------------- free energy profile
def harm_mode_free_energy(T, nu_cm):
    """Quantum harmonic free energy of one mode, kJ/mol."""
    x = nu_cm * HC_OVER_KB / T
    return 0.5 * HC_KJ * nu_cm + R_KJ * T * np.log1p(-np.exp(-x))

def free_energy_profile(T, m_trans_scale):
    """F(s,T) = V(s) + g(nu_t(s)/sqrt(m_t), T) along the corridor (kJ/mol)."""
    return V0 + harm_mode_free_energy(T, nu_trans(m_trans_scale))

# ------------------------------------------------- corner-cutting (2D) tunneling path
x2d = x_c + q_star * qx
y2d = y_c + q_star * qy
V2d = surface(np.column_stack([x2d, y2d]))
seg = np.hypot(np.diff(x2d), np.diff(y2d))
arc = np.concatenate([[0.0], np.cumsum(seg)])          # mass-weighted path length

s_dense = np.linspace(s_c[0], s_c[-1], N_S_DENSE)
V0_dense = np.interp(s_dense, s_c, V0)
arc_dense = np.linspace(arc[0], arc[-1], N_S_DENSE)
V2d_dense = np.interp(arc_dense, arc, V2d)

i_sad_2d = int(np.argmax(V2d_dense))
E_bar_2d = float(V2d_dense[i_sad_2d])

def action_dense(V_dense, E, m_long_scale):
    """Dimensionless WKB action S = 1.24*sqrt(m_l)*Int sqrt(2(V-E)) ds (0 above barrier)."""
    if E >= V_dense.max():
        return 0.0
    return ACTION_SCALE * math.sqrt(m_long_scale) * float(
        np.trapezoid(np.sqrt(2.0 * np.maximum(V_dense - E, 0.0)), s_dense))

def transmission(S):
    """Hill-Wheeler-type semiclassical transmission; T=1 above the barrier top."""
    return np.where(S <= 0.0, 1.0, 1.0 / (1.0 + np.exp(2.0 * S)))

# ------------------------------------------------------------------- transmission tables
E_tab = np.linspace(0.0, E_bar + E_ABOVE, N_ENERGY_GRID)
E_fine = np.linspace(0.0, E_bar + KAPPA_E_ABOVE, KAPPA_N_FINE)

def case_transmission(m_long_scale):
    """Actions/transmissions on the tabulated grid and the fine grid for one mass case."""
    S_c_tab = np.array([action_dense(V0_dense, e, m_long_scale) for e in E_tab])
    S_2_tab = np.array([action_dense(V2d_dense, e, m_long_scale) for e in E_tab])
    S_c_fine = np.array([action_dense(V0_dense, e, m_long_scale) for e in E_fine])
    return (S_c_tab, S_2_tab, transmission(S_c_tab), transmission(S_2_tab),
            S_c_fine, transmission(S_c_fine))

def kappa_corridor(T, T_c_fine):
    """Canonical tunneling factor kappa = beta*exp(beta*Ebar) * Int T(E) exp(-beta E) dE.

    Sub-barrier part from the fine WKB grid; the above-barrier tail is closed
    analytically (T = 1 for E > barrier top): exp(-beta*E_max)/beta.
    """
    beta = 1.0 / (R_KJ * T)
    sub = float(np.trapezoid(T_c_fine * np.exp(-beta * E_fine), E_fine))
    tail = math.exp(-beta * E_fine[-1]) / beta
    return beta * math.exp(beta * E_bar) * (sub + tail)

# ------------------------------------------------------------------------ rate machinery
def case_rates(m_long_scale, m_trans_scale):
    """Local / optimized / enhanced log10 rates and supporting fields for all T."""
    T = tgrid.T_K.values
    nu_t = nu_trans(m_trans_scale)
    rows, profiles = [], {}
    for Tk in T:
        F = free_energy_profile(Tk, m_trans_scale)
        profiles[Tk] = F
        F_R = F[0]
        i_opt = int(np.argmax(F))
        dG_loc = F[i_sad] - F_R
        dG_opt = F[i_opt] - F_R
        pref = KB_OVER_H * Tk
        rows.append(dict(T_K=Tk, i_opt=i_opt, s_optimized=s_c[i_opt],
                         barrier_local=dG_loc, barrier_optimized=dG_opt,
                         log_local=math.log10(pref) - dG_loc / (R_KJ * Tk) / math.log(10.0),
                         log_opt=math.log10(pref) - dG_opt / (R_KJ * Tk) / math.log(10.0)))
    (S_c_tab, S_2_tab, Tc_tab, T2_tab, S_c_fine, Tc_fine) = case_transmission(m_long_scale)
    kappas = np.array([kappa_corridor(Tk, Tc_fine) for Tk in T])
    for r, kap in zip(rows, kappas):
        r["kappa"] = kap
        r["log_enh"] = r["log_opt"] + math.log10(kap)
    return rows, profiles, dict(S_c_tab=S_c_tab, S_2_tab=S_2_tab, T_c_tab=Tc_tab,
                                T_2_tab=T2_tab, nu_t=nu_t)

light_rows, light_profiles, light_trans = case_rates(1.0, 1.0)

# ----------------------------------------------------------------------------- output 1
flag = np.zeros((len(tgrid), len(curve)), dtype=int)
for Ti, r in enumerate(light_rows):
    flag[Ti, r["i_opt"]] = 1
fep = pd.DataFrame({
    "T_K": np.repeat(tgrid.T_K.values, len(curve)),
    "point_id": np.tile(curve.point_id.values, len(tgrid)),
    "s_coord": np.tile(s_c, len(tgrid)),
    "x": np.tile(x_c, len(tgrid)),
    "y": np.tile(y_c, len(tgrid)),
    "transverse_frequency_cm1": np.tile(light_trans["nu_t"], len(tgrid)),
    "free_energy_kj_mol": np.concatenate([light_profiles[Tk] for Tk in tgrid.T_K.values]),
    "optimized_crossing": flag.ravel().astype(int),
})
fep.to_csv(OUT / "free_energy_profile.csv", index=False)

# ----------------------------------------------------------------------------- output 2
rc = pd.DataFrame({
    "T_K": [r["T_K"] for r in light_rows],
    "log10_k_local_s_inv": [r["log_local"] for r in light_rows],
    "log10_k_optimized_s_inv": [r["log_opt"] for r in light_rows],
    "log10_k_enhanced_s_inv": [r["log_enh"] for r in light_rows],
    "kappa_corridor": [r["kappa"] for r in light_rows],
    "enhancement_factor": [r["kappa"] for r in light_rows],
    "s_optimized": [r["s_optimized"] for r in light_rows],
    "barrier_local_kj_mol": [r["barrier_local"] for r in light_rows],
    "barrier_optimized_kj_mol": [r["barrier_optimized"] for r in light_rows],
    "crossover_T_K": T_c_light,
})
rc.to_csv(OUT / "rate_constants.csv", index=False)

# ----------------------------------------------------------------------------- output 3
ratio = np.where(light_trans["S_c_tab"] > 0,
                 light_trans["S_2_tab"] / np.maximum(light_trans["S_c_tab"], 1e-300), 1.0)
tp = pd.DataFrame({
    "energy_id": np.arange(len(E_tab)),
    "energy_kj_mol": E_tab,
    "action_corridor": light_trans["S_c_tab"],
    "action_2d": light_trans["S_2_tab"],
    "transmission_corridor": light_trans["T_c_tab"],
    "transmission_2d": light_trans["T_2_tab"],
    "action_ratio_2d_over_corridor": ratio,
})
tp.to_csv(OUT / "transmission_profile.csv", index=False)

# ----------------------------------------------------------------------------- output 4
sel_ids = sorted({int(np.argmin(np.abs(E_tab - e))) for e in PATH_TARGET_ENERGIES})
path_rows = []
for eid in sel_ids:
    E = E_tab[eid]
    above = V2d_dense > E
    lo = hi = i_sad_2d
    while lo > 0 and above[lo - 1]:
        lo -= 1
    while hi < len(above) - 1 and above[hi + 1]:
        hi += 1
    if not above[lo]:                      # E at/below the path ends: full path
        lo, hi = 0, len(above) - 1
    steps = np.linspace(arc_dense[lo], arc_dense[hi], N_PATH_STEPS)
    px = np.interp(steps, arc, x2d)
    py = np.interp(steps, arc, y2d)
    pV = surface(np.column_stack([px, py]))
    for j, (xx, yy, vv) in enumerate(zip(px, py, pV)):
        path_rows.append(dict(energy_id=eid, path_step=j, energy_kj_mol=E,
                              x=xx, y=yy, potential_kj_mol=float(vv)))
pd.DataFrame(path_rows).to_csv(OUT / "path_samples.csv", index=False)

# ------------------------------------------------------------------- isotope-case machinery
case_results, iso_trans_rows, iso_eff_rows = {}, [], []
for _, case in iso.iterrows():
    ml, mt = float(case.longitudinal_mass_scale), float(case.transverse_mass_scale)
    rows, profiles, trans = case_rates(ml, mt)
    case_results[case.case_id] = dict(rows=rows, T_c=crossover_T(ml), trans=trans)
    S_c, S_2, Tc_tab, T2_tab = trans["S_c_tab"], trans["S_2_tab"], trans["T_c_tab"], trans["T_2_tab"]
    ratio_c = np.where(S_c > 0, S_2 / np.maximum(S_c, 1e-300), 1.0)
    iso_trans_rows.append(pd.DataFrame({
        "case_id": case.case_id, "isotopologue": case.isotopologue,
        "longitudinal_mass_scale": ml, "transverse_mass_scale": mt,
        "energy_id": np.arange(len(E_tab)), "energy_kj_mol": E_tab,
        "action_corridor": S_c, "action_2d": S_2,
        "transmission_corridor": Tc_tab, "transmission_2d": T2_tab,
        "action_ratio_2d_over_corridor": ratio_c}))
iso_trans = pd.concat(iso_trans_rows, ignore_index=True)
iso_trans.to_csv(OUT / "isotope_transmission_profile.csv", index=False)

light_enh = {r["T_K"]: r["log_enh"] for r in light_rows}
for _, case in iso.iterrows():
    for r in case_results[case.case_id]["rows"]:
        iso_eff_rows.append(dict(
            case_id=case.case_id, isotopologue=case.isotopologue,
            longitudinal_mass_scale=case.longitudinal_mass_scale,
            transverse_mass_scale=case.transverse_mass_scale,
            T_K=r["T_K"], log10_k_local_s_inv=r["log_local"],
            log10_k_optimized_s_inv=r["log_opt"], log10_k_enhanced_s_inv=r["log_enh"],
            enhancement_factor=r["kappa"], s_optimized=r["s_optimized"],
            crossover_T_K=case_results[case.case_id]["T_c"],
            log10_KIE_sct_vs_light=light_enh[r["T_K"]] - r["log_enh"]))
pd.DataFrame(iso_eff_rows).to_csv(OUT / "isotope_effects.csv", index=False)

# ----------------------------------------------------------------------------- output 7
def mean_reduction(S_c, S_2):
    m = S_c > 0
    return float(np.mean((S_c[m] - S_2[m]) / S_c[m]))
red_light = mean_reduction(light_trans["S_c_tab"], light_trans["S_2_tab"])
red_by_case = {c: mean_reduction(case_results[c]["trans"]["S_c_tab"],
                                case_results[c]["trans"]["S_2_tab"]) for c in case_results}

# variational TST: optimizing the dividing surface MAXIMIZES dG‡ and thus lowers the rate
order_var = all(r["log_opt"] <= r["log_local"] + 1e-9 for r in light_rows)
order_enh = all(r["log_enh"] >= r["log_opt"] - 1e-9 for r in light_rows)
tiny = []
for label, rows in [("light", light_rows)] + [(c, case_results[c]["rows"]) for c in case_results]:
    for r in rows:
        for v in ("log_local", "log_opt", "log_enh"):
            if r[v] < -300.0:
                tiny.append(dict(case=label, variant=v, T_K=r["T_K"], log10_k=r[v]))

opt_per_T = [dict(T_K=r["T_K"], s_optimized=r["s_optimized"], point_id=r["i_opt"],
                  barrier_optimized_kj_mol=r["barrier_optimized"]) for r in light_rows]
ie = pd.DataFrame(iso_eff_rows)

diagnostics = {
    "units": {"coordinate": manifest["coordinate_unit"], "energy": manifest["energy_unit"],
              "rate": manifest["rate_constant_unit"], "temperature": manifest["temperature_unit"]},
    "basins": {
        "reactant_lower_x": {"x": float(x_c[0]), "y": float(y_c[0]), "s_coord": float(s_c[0]),
                             "potential_kj_mol": float(V0[0]),
                             "surface_min_lower_x": {"x": -1.05, "y": 0.0367647,
                                                     "potential_kj_mol": 0.004215663}},
        "product_higher_x": {"x": float(x_c[-1]), "y": float(y_c[-1]), "s_coord": float(s_c[-1]),
                             "potential_kj_mol": float(V0[-1]),
                             "surface_min_higher_x": {"x": 1.05, "y": 0.0188235,
                                                      "potential_kj_mol": -1.026354672}},
    },
    "saddle_conventional": {
        "point_id": i_sad, "s_coord": float(s_local), "x": float(x_c[i_sad]),
        "y": float(y_c[i_sad]), "potential_kj_mol": E_bar,
        "transverse_curvature_kj_mol_coord2": float(kappa_t[i_sad]),
        "transverse_frequency_cm1": float(nu_trans(1.0)[i_sad]),
        "longitudinal_curvature_kj_mol_coord2": kappa_L,
        "barrier_frequency_cm1": nu_barrier_light,
        "curvature_fit_window_points": 2 * SADDLE_WINDOW + 1,
    },
    "saddle_free_energy_optimized_per_T": opt_per_T,
    "crossover_temperature": {
        "definition": "T_c = hbar*|omega_b|/(2*pi*kB) = nu_b[cm^-1]*hc_over_kB/(2*pi); "
                      "nu_b from the longitudinal imaginary curvature at the conventional saddle",
        "light_K": T_c_light,
        "per_case_K": {c: case_results[c]["T_c"] for c in case_results},
        "note": "semiclassical_action_scale=1.24 multiplies the WKB actions only; "
                "it is NOT applied to the crossover temperature",
    },
    "action_reduction": {
        "definition": "mean over sub-barrier tabulated energies of (S_corridor - S_2d)/S_corridor",
        "mean_fraction_light": red_light,
        "mean_fraction_per_case": red_by_case,
        "ratio_above_1_bins": int((ratio > 1.0).sum()),
        "ratio_max": float(ratio.max()),
        "ratio_note": "one near-barrier bin has ratio slightly above 1 because the "
                      "interpolated 2D surface reads marginally above the tube q=0 samples "
                      "at off-grid corridor points (grid spacing 0.03 x 0.0179); the mean "
                      "reduction remains positive",
        "corner_cutting_path": {
            "q_star_rms": float(np.sqrt(np.mean(q_star ** 2))),
            "q_star_max_abs": float(np.max(np.abs(q_star))),
            "mean_potential_relief_kj_mol": float(np.mean(V0 - V_tube_min)),
            "path_max_potential_kj_mol": E_bar_2d,
            "corridor_max_potential_kj_mol": E_bar},
    },
    "rate_ordering": {
        "local_ge_optimized_all_T_variational": bool(order_var),
        "enhanced_ge_optimized_all_T": bool(order_enh),
        "kappa_min": float(rc.kappa_corridor.min()),
        "kappa_max": float(rc.kappa_corridor.max()),
        "min_log10_k_enhanced_minus_optimized":
            float((rc.log10_k_enhanced_s_inv - rc.log10_k_optimized_s_inv).min()),
        "max_log10_k_optimized_minus_local":
            float((rc.log10_k_optimized_s_inv - rc.log10_k_local_s_inv).max()),
        "note": "variational TST: the free-energy-maximizing surface gives the LOWER rate, "
                "so log10_k_optimized <= log10_k_local is the expected ordering"
    },
    "transmission_grid": {
        "n_rows": int(len(E_tab)), "energy_min_kj_mol": float(E_tab[0]),
        "energy_max_kj_mol": float(E_tab[-1]),
        "spacing_kj_mol": float(np.mean(np.diff(E_tab))),
        "kappa_integration": {"n_fine": KAPPA_N_FINE, "range_kj_mol": [0.0, float(E_fine[-1])],
                              "above_barrier_tail": "analytic exp(-beta*E_max)/beta (T=1)"},
        "transmission_formula": "T(E) = 1/(1+exp(2S)) for E < barrier top, T = 1 above",
        "action_formula": "S = 1.24 * sqrt(m_longitudinal_scale) * Int sqrt(2(V-E)) ds "
                          "(dimensionless; V in kJ/mol, s in mass-weighted coordinate units)"},
    "isotope_cases": {
        c: {"T_c_K": case_results[c]["T_c"], "mean_action_reduction": red_by_case[c],
            "KIE_log10_range": [float(ie[ie.case_id == c].log10_KIE_sct_vs_light.min()),
                                float(ie[ie.case_id == c].log10_KIE_sct_vs_light.max())]}
        for c in case_results},
    "small_log10_rates_below_minus300": tiny,
    "conventions": {
        "free_energy": "F(s,T) = V(s) + hc*nu/2 + kT*ln(1-exp(-hc*nu/kT)), single harmonic "
                       "transverse mode, nu = 95.0*sqrt(kappa_t/m_transverse_scale) cm^-1",
        "local_crossing": "dividing surface fixed at the conventional saddle (point %d)" % i_sad,
        "optimized_crossing": "argmax_s F(s,T) over the q-minimized (harmonic) profile; "
                              "tube q-offsets reported as diagnostics only",
        "enhanced": "k_enhanced = k_optimized * kappa_corridor(T); "
                    "enhancement_factor = kappa_corridor",
        "KIE": "log10_KIE_sct_vs_light = log10(k_light_enhanced) - log10(k_case_enhanced)",
        "reactant_reference": "corridor point 0 (s=0), lower-x basin"},
}
(OUT / "diagnostics.json").write_text(json.dumps(diagnostics, indent=2))


# ----------------------------------------------------------------------------- plotting
# matplotlib is unavailable in this runtime; a pure-numpy PNG rasterizer is used.
# If matplotlib is present in another environment it is used instead.
_FONT = {
 "A":"01110 10001 10001 11111 10001 10001 10001","B":"11110 10001 10001 11110 10001 10001 11110",
 "C":"01110 10001 10000 10000 10000 10001 01110","D":"11100 10010 10001 10001 10001 10010 11100",
