#!/usr/bin/env python3
"""
Deterministic confidence-interval engine forensics (asibench:computer_science.bci_forensics).

Reproducible audit of 9 anonymous CI engines over 6 public cases, using ONLY the
supplied evidence arrays. No random resampling panels are generated; every
bootstrap recomputation reuses the supplied deterministic index panels.

Key methodological choices (documented assumptions):
  A1. Population target per case = public statistic applied to the POOLED
      calibration samples (108 x 74 = 7992 values). The alternative reading
      (coverage of each replication's own statistic by its own bootstrap
      interval) is discarded because it is DEGENERATE on this instance: every
      engine attains empirical coverage 1.0 for every case, so it carries no
      discriminative information. The pooled target yields informative,
      engine-separating coverages (~0.79-0.94 vs nominal 0.9021).
  A2. All panels are matched by explicit keys/ids (npz keys case_XX; the
      engine_ids / case_ids arrays inside engine_interval_panels.npz). Row
      order of the CSV or of any array is never used to identify an engine.
  A3. Probe families are neutral: they measure engine behaviour, not case
      validity. probe_02/probe_03 use the supplied probe panels; probe_00/01
      are distances to recomputed percentile references (plain and endpoint-
      mirrored about the observed statistic) obtained with the SUPPLIED
      resample panels only.
  A4. baseline_low/high for interval_summary are the arrays supplied in
      engine_interval_panels.npz (not recomputed).
  A5. Failure labels may repeat across engines; exactly one predicted label
      per engine (the selected engine is labelled reliable_engine; every other
      engine takes its strongest failure-evidence label).

Only writes: analysis.py (this file) and results/*.
"""

import json
import os
import csv
import numpy as np
plt = None  # matplotlib imported lazily (may be unavailable; pure-numpy PNG fallback used)

DATA = "data"
RES = "results"
os.makedirs(RES, exist_ok=True)

# 0. Load public inputs and validate structure --------------------------------
with open(os.path.join(DATA, "study_manifest.json")) as fh:
    STUDY = json.load(fh)
with open(os.path.join(DATA, "probe_manifest.json")) as fh:
    PROBES = json.load(fh)

CONF = float(STUDY["confidence_level"])
ALPHA = 1.0 - CONF
QLO, QHI = ALPHA / 2.0, 1.0 - ALPHA / 2.0
CASES = STUDY["cases"]
CASE_IDS = [c["case_id"] for c in CASES]
ENGINE_IDS = list(STUDY["engine_ids"])
LABELS = list(STUDY["failure_label_vocabulary"])
FAMILIES = list(PROBES["probe_families"])
E, C, K = len(ENGINE_IDS), len(CASES), len(FAMILIES)

with open(os.path.join(DATA, "observed_samples.csv")) as fh:
    rows = list(csv.DictReader(fh))
observed = {}
for r in rows:
    observed.setdefault(r["case_id"], []).append(float(r["value"]))
observed = {c: np.asarray(observed[c], dtype=float) for c in CASE_IDS}
nobs = dict((x["case_id"], x["n_observations"]) for x in CASES)
for c in CASE_IDS:
    assert len(observed[c]) == nobs[c]

rp = np.load(os.path.join(DATA, "resample_panels.npz"))
cs = np.load(os.path.join(DATA, "calibration_samples.npz"))
crp = np.load(os.path.join(DATA, "calibration_resample_panels.npz"))
ep = np.load(os.path.join(DATA, "engine_interval_panels.npz"))

# panels are matched by explicit id arrays / keys, never by row order
assert list(ep["engine_ids"]) == ENGINE_IDS
assert list(ep["case_ids"]) == CASE_IDS
for c in CASE_IDS:
    assert c in rp.files and c in cs.files and c in crp.files
for k in ("observed_low", "observed_high", "probe_panel_02_low", "probe_panel_02_high"):
    assert tuple(ep[k].shape) == (E, C)
for k in ("calibration_low", "calibration_high"):
    assert tuple(ep[k].shape) == (E, C, 108)
for k in ("probe_panel_03_low", "probe_panel_03_high"):
    assert tuple(ep[k].shape) == (E, C, 6)
assert tuple(ep["baseline_low"].shape) == (C,)
for k in ep.files:
    if ep[k].dtype.kind == "f":
        assert np.all(np.isfinite(ep[k])), "non-finite value in engine_interval_panels"

# 1. Public statistic definitions ---------------------------------------------
def statistic(name, params, values, axis=-1):
    if name == "mean":
        return values.mean(axis=axis)
    if name == "median":
        return np.median(values, axis=axis)
    if name == "coefficient_of_variation":
        return values.std(axis=axis, ddof=params["std_ddof"]) / values.mean(axis=axis)
    if name == "upper_tail_rate":
        thr = params["threshold"]
        if params["comparison"] == ">=":
            return (values >= thr).mean(axis=axis)
        return (values > thr).mean(axis=axis)
    raise ValueError(name)

obs_stat_computed = np.array([
    statistic(c["statistic_name"], c["statistic_parameters"], observed[c["case_id"]])
    for c in CASES
])
assert np.allclose(obs_stat_computed, ep["observed_stat"], atol=1e-12)

# 2. Deterministic percentile references from the SUPPLIED panels --------------
q_obs_lo = np.zeros(C); q_obs_hi = np.zeros(C)
q_cal_lo = np.zeros((C, 108)); q_cal_hi = np.zeros((C, 108))
for ci, case in enumerate(CASES):
    cid = case["case_id"]
    v = observed[cid]
    boot = statistic(case["statistic_name"], case["statistic_parameters"], v[rp[cid]])
    q_obs_lo[ci], q_obs_hi[ci] = np.quantile(boot, [QLO, QHI])
    cal, pan = cs[cid], crp[cid]
    for r in range(108):
        b = statistic(case["statistic_name"], case["statistic_parameters"], cal[r][pan[r]])
        q_cal_lo[ci, r], q_cal_hi[ci, r] = np.quantile(b, [QLO, QHI])

# sanity: the supplied baseline arrays are the observed-case percentile reference
assert np.allclose(ep["baseline_low"], q_obs_lo, atol=1e-9)
assert np.allclose(ep["baseline_high"], q_obs_hi, atol=1e-9)

# 3. Pooled calibration target and coverage audit ------------------------------
theta = np.array([
    statistic(c["statistic_name"], c["statistic_parameters"], cs[c["case_id"]].ravel())
    for c in CASES
])

cal_lo, cal_hi = ep["calibration_low"], ep["calibration_high"]
emp_cov = np.zeros((E, C)); mean_width = np.zeros((E, C))
miss_lo = np.zeros((E, C)); miss_hi = np.zeros((E, C))
cov_score = np.zeros((E, C))
ref_width_cal = (q_cal_hi - q_cal_lo).mean(axis=1)
for e in range(E):
    for ci in range(C):
        lo, hi = cal_lo[e, ci], cal_hi[e, ci]
        emp_cov[e, ci] = np.mean((lo <= theta[ci]) & (hi >= theta[ci]))
        mean_width[e, ci] = np.mean(hi - lo)
        miss_lo[e, ci] = np.mean(lo > theta[ci])
        miss_hi[e, ci] = np.mean(hi < theta[ci])
        cov_score[e, ci] = (abs(emp_cov[e, ci] - CONF)
                            + abs(miss_lo[e, ci] - miss_hi[e, ci])
                            + abs(np.log(mean_width[e, ci] / ref_width_cal[ci])))

# 4. Neutral probe family diagnostics (severity: higher = worse) ---------------
d_plain = np.zeros((E, C))   # probe_00: distance to plain percentile reference
d_mirror = np.zeros((E, C))  # probe_01: distance to endpoint-mirrored reference
for ci, case in enumerate(CASES):
    th = obs_stat_computed[ci]
    mir_lo, mir_hi = 2 * th - q_obs_hi[ci], 2 * th - q_obs_lo[ci]
    for e in range(E):
        lo, hi = ep["observed_low"][e, ci], ep["observed_high"][e, ci]
        d_plain[e, ci] = (abs(lo - q_obs_lo[ci]) + abs(hi - q_obs_hi[ci])) / 2
        d_mirror[e, ci] = (abs(lo - mir_lo) + abs(hi - mir_hi)) / 2

d_p02 = np.zeros((E, C))     # probe_02: supplied shape/response panel deviation
for e in range(E):
    for ci in range(C):
        d_p02[e, ci] = (abs(ep["probe_panel_02_low"][e, ci] - ep["observed_low"][e, ci])
                        + abs(ep["probe_panel_02_high"][e, ci] - ep["observed_high"][e, ci])) / 2

d_p03 = np.zeros((E, C))     # probe_03: supplied split-panel instability
for e in range(E):
    for ci in range(C):
        std_splits = (ep["probe_panel_03_low"][e, ci].std()
                      + ep["probe_panel_03_high"][e, ci].std()) / 2
        off = (abs(ep["probe_panel_03_low"][e, ci].mean() - ep["observed_low"][e, ci])
               + abs(ep["probe_panel_03_high"][e, ci].mean() - ep["observed_high"][e, ci])) / 2
        d_p03[e, ci] = std_splits + off

d_p04 = np.zeros((E, C))     # probe_04: discrete-boundary deviation (discrete_tie regime)
for ci, case in enumerate(CASES):
    if case["regime"] == "discrete_tie":
        d_p04[:, ci] = d_plain[:, ci]

def severity_alias(d):
    h = np.median(d, axis=0, keepdims=True)
    h = np.where(h > 0, h, 1.0)
    return np.exp(-d / h)

def severity_distance(d):
    h = np.median(d, axis=0, keepdims=True)
    h = np.where(h > 0, h, 1.0)
    return d / (d + h)

sev = {"probe_00": severity_alias(d_plain), "probe_01": severity_alias(d_mirror),
       "probe_02": severity_distance(d_p02), "probe_03": severity_distance(d_p03),
       "probe_04": severity_distance(d_p04)}
sev_score = {}
for fam in FAMILIES:
    s = sev[fam]; out = np.zeros_like(s)
    for ci in range(C):
        col = s[:, ci]; rng = col.max() - col.min()
        out[:, ci] = (col - col.min()) / rng if rng > 0 else 0.0
    sev_score[fam] = out

# 5. Engine audit aggregates and combined score --------------------------------
coverage_gap = np.abs(emp_cov - CONF).mean(axis=1)
tail_imbalance = np.abs(miss_lo - miss_hi).mean(axis=1)
width_ratio = mean_width / ref_width_cal[None, :]
width_dev = np.abs(np.log(width_ratio)).mean(axis=1)
case_dispersion = cov_score.std(axis=1)
probe_metric = np.stack([sev_score[f].mean(axis=1) for f in FAMILIES], axis=1)

def minmax(x):
    rng = x.max() - x.min()
    return (x - x.min()) / rng if rng > 0 else np.zeros_like(x)

comp = np.stack([minmax(coverage_gap), minmax(tail_imbalance), minmax(width_dev),
                 minmax(case_dispersion)] + [probe_metric[:, k] for k in range(K)], axis=1)
engine_score = comp.mean(axis=1)

def rank_order(scores):
    return sorted(range(E), key=lambda i: (scores[i], coverage_gap[i], tail_imbalance[i], ENGINE_IDS[i]))

order_full = rank_order(engine_score)
selected_idx = order_full[0]
selected_id = ENGINE_IDS[selected_idx]

# 6. Failure-label evidence -----------------------------------------------------
lab_ev = {
    "reliable_engine": 1.0 - minmax(engine_score),
    "baseline_quantile_alias": minmax(probe_metric[:, 0]),
    "reflection_alias": minmax(probe_metric[:, 1]),
    "discrete_boundary_mismatch": minmax(probe_metric[:, 4]),
    "shape_correction_mismatch": minmax(probe_metric[:, 2]),
    "scale_response_mismatch": minmax(width_dev),
    "noise_amplifying_engine": minmax(probe_metric[:, 3]),
}
EV = np.stack([lab_ev[l] for l in LABELS], axis=1)
FAIL_IDX = [LABELS.index(l) for l in LABELS if l != "reliable_engine"]
predicted = {}
for e in range(E):
    if e == selected_idx:
        predicted[ENGINE_IDS[e]] = "reliable_engine"
    else:
        best = max(FAIL_IDX, key=lambda j: (EV[e, j], -j))
        predicted[ENGINE_IDS[e]] = LABELS[best]

# 7. Family ablation -------------------------------------------------------------
scores_all = {"none": engine_score.copy()}
for k, fam in enumerate(FAMILIES):
    keep = [j for j in range(comp.shape[1]) if j != 4 + k]
    scores_all[fam] = comp[:, keep].mean(axis=1)
ablation_rows = []
for name in ["none"] + FAMILIES:
    s = scores_all[name]; o = rank_order(s)
    ablation_rows.append({
        "excluded_probe_family": name,
        "top_engine_id": ENGINE_IDS[o[0]],
        "selected_engine_rank": o.index(selected_idx) + 1,
        "runner_up_engine_id": ENGINE_IDS[o[1]],
        "score_margin": float(s[o[1]] - s[o[0]]),
    })

# 8. Reliability report aggregates and case warnings -----------------------------
SE = np.sqrt(CONF * (1 - CONF) / 108.0)
case_warnings = {}
for ci, case in enumerate(CASES):
    w = []
    if abs(emp_cov[selected_idx, ci] - CONF) > 2 * SE:
        w.append(f"selected engine coverage {emp_cov[selected_idx, ci]:.3f} deviates from nominal "
                 f"{CONF:.4f} by more than 2 Monte-Carlo SE ({2*SE:.3f})")
    if not (ep["observed_low"][selected_idx, ci] <= theta[ci] <= ep["observed_high"][selected_idx, ci]):
        w.append("selected engine observed interval does not contain the estimated case target")
    if abs(miss_lo[selected_idx, ci] - miss_hi[selected_idx, ci]) > 0.10:
        w.append(f"selected engine tail miss rates unbalanced (low {miss_lo[selected_idx, ci]:.3f} "
                 f"vs high {miss_hi[selected_idx, ci]:.3f})")
    worst = int(np.argmax(np.abs(emp_cov[:, ci] - CONF)))
    if abs(emp_cov[worst, ci] - CONF) > 2 * SE:
        w.append(f"engine {ENGINE_IDS[worst]} shows the largest coverage deviation on this case "
                 f"({emp_cov[worst, ci]:.3f} vs nominal {CONF:.4f})")
    if w:
        case_warnings[case["case_id"]] = w

report = {"selected_engine_id": selected_id,
          "aggregate_coverage_gap": float(coverage_gap[selected_idx]),
          "aggregate_tail_imbalance": float(tail_imbalance[selected_idx]),
          "aggregate_probe_score": float(probe_metric[selected_idx].mean()),
          "engine_ranking": [ENGINE_IDS[i] for i in order_full],
          "case_warnings": case_warnings}

# 9. Write artifacts -------------------------------------------------------------
def write_csv(path, cols, recs):
    with open(path, "w", newline="") as fh:
        w = csv.DictWriter(fh, fieldnames=cols)
        w.writeheader()
        for r in recs:
            w.writerow({c: (float(r[c]) if isinstance(r[c], (np.floating, float)) and not isinstance(r[c], bool) else r[c])
                        for c in cols})

write_csv(os.path.join(RES, "engine_audit.csv"), STUDY["audit_columns"]["engine_audit"], [
    {"engine_id": ENGINE_IDS[e], "coverage_gap": coverage_gap[e],
     "tail_imbalance": tail_imbalance[e], "width_ratio": width_ratio[e].mean(),
     "case_dispersion": case_dispersion[e],
     **{f"probe_metric_{k:02d}": probe_metric[e, k] for k in range(K)},
     "engine_score": engine_score[e]} for e in range(E)])

with open(os.path.join(RES, "failure_modes.json"), "w") as fh:
    json.dump({"selected_engine_id": selected_id,
               "failure_modes": {ENGINE_IDS[e]: predicted[ENGINE_IDS[e]] for e in range(E)}}, fh, indent=2)
with open(os.path.join(RES, "selected_engine.json"), "w") as fh:
    json.dump({"selected_engine_id": selected_id,
               "selected_failure_mode": predicted[selected_id],
               "selected_engine_score": float(engine_score[selected_idx])}, fh, indent=2)

summary_cols = ["case_id", "statistic_name", "observed_stat", "selected_engine_id", "selected_low",
                "selected_high", "baseline_low", "baseline_high", "selected_width", "baseline_width_ratio"]
recs = []
for ci, case in enumerate(CASES):
    lo = float(ep["observed_low"][selected_idx, ci]); hi = float(ep["observed_high"][selected_idx, ci])
    bw = float(ep["baseline_high"][ci] - ep["baseline_low"][ci])
    recs.append({"case_id": case["case_id"], "statistic_name": case["statistic_name"],
                 "observed_stat": float(ep["observed_stat"][ci]), "selected_engine_id": selected_id,
                 "selected_low": lo, "selected_high": hi,
                 "baseline_low": float(ep["baseline_low"][ci]),
                 "baseline_high": float(ep["baseline_high"][ci]),
                 "selected_width": hi - lo, "baseline_width_ratio": (hi - lo) / bw})
write_csv(os.path.join(RES, "interval_summary.csv"), summary_cols, recs)

recs = []
for ci, case in enumerate(CASES):
    for e in range(E):
        recs.append({"case_id": case["case_id"], "regime": case["regime"], "engine_id": ENGINE_IDS[e],
                     "nominal_coverage": CONF, "empirical_coverage": emp_cov[e, ci],
                     "mean_width": mean_width[e, ci], "miss_low_rate": miss_lo[e, ci],
                     "miss_high_rate": miss_hi[e, ci], "n_replications": 108,
                     "coverage_score": cov_score[e, ci]})
write_csv(os.path.join(RES, "coverage_audit.csv"), STUDY["audit_columns"]["coverage_audit"], recs)

recs = []
for ci, case in enumerate(CASES):
    for fam in FAMILIES:
        for e in range(E):
            recs.append({"case_id": case["case_id"], "probe_family": fam, "engine_id": ENGINE_IDS[e],
                         "diagnostic_value": float(sev[fam][e, ci]),
                         "diagnostic_score": float(sev_score[fam][e, ci])})
write_csv(os.path.join(RES, "probe_audit.csv"), PROBES["diagnostic_columns"], recs)

recs = []
for ci, case in enumerate(CASES):
    for e in range(E):
        sig = [float(sev_score[f][e, ci]) for f in FAMILIES]
        recs.append({"case_id": case["case_id"], "engine_id": ENGINE_IDS[e],
                     **{f"probe_signal_{k:02d}": sig[k] for k in range(K)},
                     "profile_score": float(np.mean(sig))})
write_csv(os.path.join(RES, "case_probe_profile.csv"), STUDY["audit_columns"]["case_probe_profile"], recs)

recs = []
for e in range(E):
    ev_order = sorted(range(len(LABELS)), key=lambda j: (-EV[e, j], j))
    for j, lab in enumerate(LABELS):
        recs.append({"engine_id": ENGINE_IDS[e], "failure_label": lab,
                     "evidence_score": float(EV[e, j]), "label_rank": ev_order.index(j) + 1,
                     "is_predicted_label": 1 if predicted[ENGINE_IDS[e]] == lab else 0})
write_csv(os.path.join(RES, "failure_evidence.csv"), STUDY["audit_columns"]["failure_evidence"], recs)

write_csv(os.path.join(RES, "family_ablation.csv"), STUDY["audit_columns"]["family_ablation"], ablation_rows)

with open(os.path.join(RES, "reliability_report.json"), "w") as fh:
    json.dump(report, fh, indent=2)

