                img[yi, xi] = color

    def fmt(v):
        return ('%.3f' % v)

    # title
    text(20, 14, 'ENGINE AUDIT - NOMINAL %.4f - SELECTED: %s (%s)' % (CONF, selected_id, sel_label), 2)
    text(20, 44, 'PANELS: COVERAGE / WIDTH RATIO / PROBE SEVERITY / ENGINE SCORE (LOWER = MORE RELIABLE)', 1)

    # panel A: coverage grouped bars
    ax0, ay0, ax1, ay1 = 70, 90, 660, 440
    text(ax0, ay0-22, 'EMPIRICAL COVERAGE BY CASE AND ENGINE', 1)
    lo_s, hi_s = 0.70, 1.00
    def ycov(v):
        return int(ay1 - (v - lo_s) / (hi_s - lo_s) * (ay1 - ay0))
    dline(ax0, ycov(CONF), ax1, ycov(CONF), (0,0,0))
    text(ax1-40, ycov(CONF)-16, 'NOMINAL', 1)
    bw = (ax1-ax0) / (C*E + 1)
    for ci in range(C):
        for e in range(E):
            x0 = int(ax0 + (ci*E + e + 0.5) * bw)
            rect(x0, ycov(emp_cov[e, ci]), x0 + int(bw*0.8), ay1, PALETTE[e])
        text(int(ax0 + ci*E*bw + bw*E/2 - 30), ay1 + 8, CASE_IDS[ci].upper(), 1)
    text(ax0, ay1 + 30, 'BLACK LINE = NOMINAL 0.9021', 1)

    # panel B: mean width ratio bars
    bx0, by0, bx1, by1 = 760, 90, 1340, 440
    text(bx0, by0-22, 'MEAN CALIBRATION WIDTH / PERCENTILE REFERENCE', 1)
    wr = width_ratio.mean(axis=1)
    lo_w, hi_w = 0.9, 1.25
    def yw(v):
        return int(by1 - (v - lo_w) / (hi_w - lo_w) * (by1 - by0))
    dline(bx0, yw(1.0), bx1, yw(1.0), (0,0,0))
    bw2 = (bx1-bx0) / (E+1)
    for e in range(E):
        x0 = int(bx0 + (e+0.5)*bw2)
        rect(x0 - 14, yw(wr[e]), x0 + 14, by1, PALETTE[e])
        text(x0-30, yw(wr[e])-14, fmt(wr[e]), 1)
        text(x0-30, by1 + 8, 'E%02d' % e, 1)

    # panel C: probe severity heatmap
    cx0, cy0, cx1, cy1 = 70, 570, 660, 900
    text(cx0, cy0-24, 'MEAN PROBE SEVERITY (0 BEST, 1 WORST)', 1)
    cw, chh = (cx1-cx0)/K, (cy1-cy0)/E
    for e in range(E):
        for k in range(K):
            v = probe_metric[e, k]
            g = int(255 - 220*v)
            rect(int(cx0 + k*cw), int(cy0 + e*chh), int(cx0 + (k+1)*cw) - 1,
                 int(cy0 + (e+1)*chh) - 1, (g, g, 255))
            text(int(cx0 + k*cw + 8), int(cy0 + e*chh + chh/2 - 6), fmt(v), 1,
                 (0, 0, 0) if v < 0.6 else (255, 255, 255))
        text(int(cx0 - 58), int(cy0 + e*chh + chh/2 - 6), 'E%02d' % e, 1)
    for k in range(K):
        text(int(cx0 + k*cw + 14), cy1 + 6, 'P%02d' % k, 1)

    # panel D: engine score ranking
    dx0, dy0, dx1, dy1 = 760, 570, 1340, 900
    text(dx0, dy0-24, 'ENGINE SCORE RANKING (SELECTED IN GREEN)', 1)
    smax = max(engine_score) * 1.15 + 1e-9
    bh = (dy1-dy0) / E
    for rank, e in enumerate(order_full):
        y0 = int(dy0 + rank*bh)
        length = int((dx1-dx0-120) * engine_score[e]/smax)
        col = (34,139,34) if e == selected_idx else (120,120,120)
        rect(dx0, y0 + 4, dx0 + length, y0 + int(bh) - 4, col)
        text(dx0 - 44, y0 + bh/2 - 6, 'E%02d' % e, 1)
        text(dx0 + length + 6, y0 + bh/2 - 6, fmt(engine_score[e]), 1)

    raw = b''.join(b'\x00' + img[y].tobytes() for y in range(H))
    def chunk(tag, data):
        c = struct.pack('>I', len(data)) + tag + data
        return c + struct.pack('>I', zlib.crc32(tag + data) & 0xffffffff)
    png = (b'\x89PNG\r\n\x1a\n'
           + chunk(b'IHDR', struct.pack('>IIBBBBB', W, H, 8, 2, 0, 0, 0))
           + chunk(b'IDAT', zlib.compress(raw, 6))
           + chunk(b'IEND', b''))
    with open(path, 'wb') as fh:
        fh.write(png)

