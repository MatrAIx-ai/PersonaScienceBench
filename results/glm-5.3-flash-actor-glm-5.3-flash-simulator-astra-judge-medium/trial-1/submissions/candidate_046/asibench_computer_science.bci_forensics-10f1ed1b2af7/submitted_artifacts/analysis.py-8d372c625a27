    def dline(x0, y0, x1, y1, color=(0,0,0)):
        n = int(max(abs(x1-x0), abs(y1-y0))) + 1
        for t in np.linspace(0, 1, n):
            xi, yi = int(round(x0 + t*(x1-x0))), int(round(y0 + t*(y1-y0)))
