def global_curve(rule, grid):
    R, SZ, SZd = np.zeros(len(grid)), np.zeros(len(grid)), np.zeros(len(grid))
    for t, p in enumerate(grid):
        sc = rule(S_cal, p); miss = ~sc[np.arange(n_cal), y_idx]
        R[t] = (miss * c_y).mean(); SZ[t] = sc.sum(1).mean()
        SZd[t] = rule(S_dep, p).sum(1).mean()
    o = np.argsort(SZ)
    return SZ[o], R[o], SZd[np.argsort(SZd)], R[np.argsort(SZd)]
