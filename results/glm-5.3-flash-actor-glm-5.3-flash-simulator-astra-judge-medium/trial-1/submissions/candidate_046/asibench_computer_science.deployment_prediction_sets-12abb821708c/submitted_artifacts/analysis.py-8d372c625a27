#!/usr/bin/env python3
"""
Risk-controlling prediction sets for deployment records (approved plan).

Policy families (all single- or few-parameter, argmax label always included so
sets are never empty; risk_spec: empty_prediction_sets_allowed = false):
  * threshold:      Set = { l : s(l) >= tau_g }              (tau per stratum)
  * cost-aware:     Set = { l : s(l)*cost(l) >= mu }         (exploits the
    label-weighted miss risk structure: cheap labels are dropped earlier)
  * strata: k-means clusters on standardized anonymous features (recovered
    public groups), or a single global group.

Risk: label_weighted_miss  R = E[cost(true_label) * 1{true_label not in set}],
audited on the deployment population; target_risk = 0.1084.

Guarantee (RCPS / Learn-then-Test): delta = 0.1366 is the FAILURE PROBABILITY
of the guarantee, P(R_deployment > UCB) <= delta.  The UCB is a Hoeffding bound
per stratum, combined with the union (Bonferroni) bound over the full examined
policy grid x strata (M_EFFECTIVE events), pooled with DEPLOYMENT stratum
weights (the audited population).  Among feasible candidates (pooled UCB <=
target_risk) we select the smallest expected deployment set size.

Deployment labels are hidden and never read; no reference/ file is read.
Conventions for hidden-label outputs:
  * audit_summary.csv / partition_diagnostics.csv: 'empirical_risk' is the
    HONEST ESTIMATE of deployment risk = calibration empirical weighted miss
    risk reweighted with the deployment stratum composition (diagnostic groups).
  * constraint_audit.csv: 'empirical_risk' is the point estimate,
    'upper_confidence_risk' (extra column) carries the confidence bound; the
    BINDING pooled guarantee is the overall row's UCB.  Per-group UCBs use a
    Bonferroni delta/DG split with grid uniformity and are conservative
    diagnostics (their sum is not the binding constraint).
  * policy_parameters.csv / calibration_diagnostics.csv carry per-group and
    pooled UCBs as extra appended columns (all schema-required columns are
    present first, in schema order).
NOTE on figures: matplotlib is declared by the task runtime but is not
installed in this environment (no network access); the three required PNGs are
rendered with a self-contained numpy+zlib PNG rasterizer below.
"""
import json, os, itertools, zlib, struct
import numpy as np
import pandas as pd
from scipy.cluster.vq import kmeans2

DATA, RESULTS = "data", "results"
os.makedirs(RESULTS, exist_ok=True)
meta = json.load(open(f"{DATA}/metadata.json"))
spec = json.load(open(f"{DATA}/risk_spec.json"))
LABELS = list(meta["label_columns"]); FEATURES = list(meta["feature_columns"])
TARGET = float(spec["target_risk"]); DELTA = float(spec["delta"])
cost = np.array([spec["label_costs"][l] for l in LABELS]); B = float(cost.max())

cal = (pd.read_csv(f"{DATA}/calibration_labels.csv")
       .merge(pd.read_csv(f"{DATA}/calibration_scores.csv"), on="record_id")
       .merge(pd.read_csv(f"{DATA}/calibration_features.csv"), on="record_id"))
dep = (pd.read_csv(f"{DATA}/deployment_scores.csv")
       .merge(pd.read_csv(f"{DATA}/deployment_features.csv"), on="record_id"))
assert len(cal) == meta["n_calibration"] and len(dep) == meta["n_deployment"]

S_cal = cal[LABELS].to_numpy(float); S_dep = dep[LABELS].to_numpy(float)
y_idx = cal["true_label"].map({l: i for i, l in enumerate(LABELS)}).to_numpy()
y_true = cal["true_label"].to_numpy()
assert not np.isnan(y_idx).any()
c_y = cost[y_idx]; s_true = S_cal[np.arange(len(y_idx)), y_idx]
n_cal, n_dep = len(cal), len(dep)

Xc = cal[FEATURES].to_numpy(float); Xd = dep[FEATURES].to_numpy(float)
mu_f, sd_f = Xc.mean(0), Xc.std(0)
Zc, Zd = (Xc - mu_f) / sd_f, (Xd - mu_f) / sd_f

# ---------------------------------------------------------------- clustering
def best_kmeans(Z, k, restarts=5):
    best = None
    for seed in range(restarts):
        cent, lab = kmeans2(Z, k, minit="++", seed=seed, iter=100)
        inertia = ((Z - cent[lab]) ** 2).sum()
        if best is None or inertia < best[0]:
            best = (inertia, cent, lab)
    return best[1], best[2]

def assign(Z, cent):
    return ((Z[:, None, :] - cent[None, :, :]) ** 2).sum(2).argmin(1)

MIN_GROUP_CAL, MIN_GROUP_DEP = 400, 200
kmeans = {}
for k in (2, 3):
    cent, lab = best_kmeans(Zc, k)
    g_dep = assign(Zd, cent)
    if all((lab == g).sum() >= MIN_GROUP_CAL and (g_dep == g).sum() >= MIN_GROUP_DEP for g in range(k)):
        kmeans[k] = (lab, g_dep)
    else:
        print(f"[clustering] kmeans_k{k} skipped (group size below minimum)")

GLOBAL_G = (np.zeros(n_cal, int), np.zeros(n_dep, int))

def rule_threshold(S, tau):
    st = S >= tau
    st[np.arange(len(S)), S.argmax(1)] = True
    return st

def rule_cost(S, mu):
    st = S * cost[None, :] >= mu
    st[np.arange(len(S)), S.argmax(1)] = True
    return st

TH_GRID = np.geomspace(3e-4, 0.08, 20)      # tau grid (score threshold)
MU_GRID = np.geomspace(5e-4, 0.06, 20)      # mu grid (cost-aware threshold)

families = []
families.append(dict(name="threshold_global", groups=GLOBAL_G, G=1, rule=rule_threshold, grid=TH_GRID))
families.append(dict(name="cost_global", groups=GLOBAL_G, G=1, rule=rule_cost, grid=MU_GRID))
for k in (2, 3):
    if k in kmeans:
        families.append(dict(name=f"threshold_kmeans_k{k}", groups=kmeans[k], G=k,
                             rule=rule_threshold, grid=TH_GRID))

def family_curves(fam):
    g_cal, g_dep = fam["groups"]; Gf = fam["G"]; grid = fam["grid"]; T = len(grid)
    R = np.zeros((Gf, T)); SZc = np.zeros((Gf, T)); SZd = np.zeros((Gf, T))
    for g in range(Gf):
        m, md = g_cal == g, g_dep == g
        Sc_g, y_g, c_g = S_cal[m], y_idx[m], c_y[m]
        for t, p in enumerate(grid):
            sc = fam["rule"](Sc_g, p)
            miss = ~sc[np.arange(len(y_g)), y_g]
            R[g, t] = (miss * c_g).mean(); SZc[g, t] = sc.sum(1).mean()
            SZd[g, t] = fam["rule"](S_dep[md], p).sum(1).mean()
    return R, SZc, SZd

M_TOTAL = sum(len(f["grid"]) ** f["G"] for f in families)
M_EFFECTIVE = M_TOTAL * max(f["G"] for f in families)

def hoeff(n, m_events):
    return B * np.sqrt(np.log(m_events / DELTA) / (2.0 * n))

# ---------------------------------------------------------------- selection
candidates = []
for fam in families:
    Gf = fam["G"]; T = len(fam["grid"])
    R, SZc, SZd = family_curves(fam)
    g_cal, g_dep = fam["groups"]
    w_dep = np.array([(g_dep == g).mean() for g in range(Gf)])
    w_cal = np.array([(g_cal == g).mean() for g in range(Gf)])
    n_cal_g = np.array([(g_cal == g).sum() for g in range(Gf)])
    c_g = np.array([hoeff(n, M_EFFECTIVE) for n in n_cal_g])
    best = None
    for tup in itertools.product(range(T), repeat=Gf):
        t = np.array(tup)
        ucb = float((w_dep * (R[np.arange(Gf), t] + c_g)).sum())
        if ucb > TARGET:
            continue
        size_dep = float((w_dep * SZd[np.arange(Gf), t]).sum())
        size_cal = float((w_cal * SZc[np.arange(Gf), t]).sum())
        key = (size_dep, Gf)
        if best is None or key < best["key"]:
            best = dict(key=key, t=t, ucb=ucb, risk=float((w_dep * R[np.arange(Gf), t]).sum()),
                        size_dep=size_dep, size_cal=size_cal)
    if best is None:
        print(f"[selection] {fam['name']}: no feasible candidate (pooled UCB > target)")
        continue
    best.update(family=fam["name"], G=Gf, R=R, SZc=SZc, SZd=SZd, w_dep=w_dep, c_g=c_g,
                g_cal=g_cal, g_dep=g_dep, grid=fam["grid"], rule=fam["rule"])
    candidates.append(best)
    print(f"[selection] {fam['name']}: size_dep={best['size_dep']:.3f} size_cal={best['size_cal']:.3f} "
          f"UCB={best['ucb']:.4f} risk_pooled={best['risk']:.4f} params={fam['grid'][list(best['t'])].round(5)}")

assert candidates, "no feasible policy: target risk unreachable under examined families"
sel = min(candidates, key=lambda c: (c["size_dep"], c["G"]))
print(f"[selection] SELECTED {sel['family']} params={sel['grid'][list(sel['t'])].round(5)} "
      f"UCB={sel['ucb']:.4f} risk_pooled={sel['risk']:.4f} size_dep={sel['size_dep']:.3f}")

G = sel["G"]; params_sel = sel["grid"][list(sel["t"])]
g_pol_cal, g_pol_dep = sel["g_cal"], sel["g_dep"]
# build sets with per-record group parameter (works for G == 1 and G > 1)
def build_sets(S, g_assign):
    out = np.zeros((len(S), len(LABELS)), bool)
    for g in range(G):
        m = g_assign == g
        out[m] = sel["rule"](S[m], params_sel[g])
    return out
sets_cal = build_sets(S_cal, g_pol_cal)
sets_dep = build_sets(S_dep, g_pol_dep)
assert sets_dep.sum(1).min() >= 1, "empty prediction set produced"

miss_cal = ~sets_cal[np.arange(n_cal), y_idx]
risk_cal_groups = np.array([(miss_cal[g_pol_cal == g] * c_y[g_pol_cal == g]).mean() for g in range(G)])
dep_sizes_g = np.array([sets_dep[g_pol_dep == g].sum(1).mean() for g in range(G)])
m_pg = np.array([(g_pol_dep == g).sum() for g in range(G)])
n_pg = np.array([(g_pol_cal == g).sum() for g in range(G)])
w_pg = m_pg / m_pg.sum()
dep_sizes_all = sets_dep.sum(1)

# ------------------------------------------------- diagnostic recovered groups
diag = kmeans.get(3) or kmeans.get(2)
if diag is not None:
    d_g_cal, d_g_dep = diag; DG = len(np.unique(d_g_cal))
else:
    d_g_cal, d_g_dep, DG = GLOBAL_G[0], GLOBAL_G[1], 1
rec_ids = ["overall"] if DG == 1 else [f"recovered_group_{g}" for g in range(DG)]
m_dg = np.array([(d_g_dep == g).sum() for g in range(DG)])
n_dg = np.array([(d_g_cal == g).sum() for g in range(DG)])
w_dg = m_dg / m_dg.sum()
risk_cal_dg = np.array([(miss_cal[d_g_cal == g] * c_y[d_g_cal == g]).mean() for g in range(DG)])
dep_sizes_dg = np.array([dep_sizes_all[d_g_dep == g].mean() for g in range(DG)])
c_dg = np.array([hoeff(n, len(TH_GRID) * DG) for n in n_dg])   # delta/DG split, grid-uniform
risk_dep_hat = float((w_dg * risk_cal_dg).sum())               # honest deployment estimate
ucb_dep = float(sel["ucb"])                                   # binding pooled policy UCB

# ---------------------------------------------------------------- outputs
REQUIRED_OUTPUTS = ["analysis.py"] + [p for p in meta["output_files"] if p != "analysis.py"]

pd.DataFrame([{"record_id": rid,
               "prediction_set": " ".join(l for l, k in zip(LABELS, sets_dep[i]) if k)}
              for i, rid in enumerate(dep["record_id"])]).to_csv(
    f"{RESULTS}/prediction_sets.csv", index=False)

pol_ids = ["overall"] if G == 1 else [f"stratum_{g}" for g in range(G)]
pp = []
for gi in range(G):
    for lab in LABELS:
        pp.append({"proxy_stratum": pol_ids[gi], "label": lab,
                   "n_calibration": int(n_pg[gi]),
                   "n_calibration_label": int(((g_pol_cal == gi) & (y_true == lab)).sum()),
                   "threshold": float(params_sel[gi]),
                   "group_empirical_weighted_miss_risk": float(risk_cal_groups[gi]),
                   "group_upper_confidence_risk": float(risk_cal_groups[gi] + sel["c_g"][gi]),
                   "group_expected_set_size": float(dep_sizes_g[gi]),
                   "calibration_target_risk": TARGET, "target_risk": TARGET})
pp.append({"proxy_stratum": "overall", "label": "all", "n_calibration": int(n_pg.sum()),
           "n_calibration_label": int(n_cal),
           "threshold": float(np.average(params_sel, weights=m_pg)),
           "group_empirical_weighted_miss_risk": risk_dep_hat,
           "group_upper_confidence_risk": ucb_dep,
           "group_expected_set_size": float(dep_sizes_all.mean()),
           "calibration_target_risk": TARGET, "target_risk": TARGET})
pp_df = pd.DataFrame(pp)
pp_df["delta"] = DELTA
pp_df["ucb_method"] = (f"Hoeffding+Bonferroni uniform over {M_TOTAL} grid tuples x {G} policy "
                       "strata; delta = failure probability of P(R_dep > UCB) <= delta")
pp_df.to_csv(f"{RESULTS}/policy_parameters.csv", index=False)

def audit_rows(empirical_kind):
    """overall row + one row per recovered public group (diagnostic strata)."""
    out = []
    for gi in range(DG + 1):
        if gi < DG:
            scope = sid = rec_ids[gi]
            emp = float(risk_cal_dg[gi] if empirical_kind == "point" else risk_cal_dg[gi] + c_dg[gi])
            n_rec = int(m_dg[gi]); msz = float(dep_sizes_dg[gi])
            p90 = float(np.quantile(dep_sizes_all[d_g_dep == gi], 0.9))
        else:
            scope, sid = "overall", "all"
            emp = risk_dep_hat if empirical_kind == "point" else ucb_dep
            n_rec = int(n_dep); msz = float(dep_sizes_all.mean())
            p90 = float(np.quantile(dep_sizes_all, 0.9))
        out.append({"scope": scope, "stratum_id": sid, "n_records": n_rec,
                    "empirical_risk": emp, "mean_set_size": msz, "p90_set_size": p90,
                    "target_risk": TARGET, "risk_violation": bool(emp > TARGET)})
    return out

pd.DataFrame(audit_rows("point")).to_csv(f"{RESULTS}/audit_summary.csv", index=False)
pd.DataFrame({"record_id": dep["record_id"], "set_size": dep_sizes_all.astype(int),
              "proxy_stratum": [rec_ids[g] for g in d_g_dep]}).to_csv(
    f"{RESULTS}/set_size_summary.csv", index=False)
pd.DataFrame([{"scope": r["scope"], "stratum_id": r["stratum_id"], "n_records": r["n_records"],
               "empirical_risk": r["empirical_risk"], "mean_set_size": r["mean_set_size"],
               "p90_set_size": r["p90_set_size"], "target_risk": r["target_risk"],
               "risk_margin": r["target_risk"] - r["empirical_risk"]}
              for r in audit_rows("point")]).to_csv(f"{RESULTS}/partition_diagnostics.csv", index=False)

dd = []
for gi in range(DG):
    cf_, df_ = n_dg[gi] / n_dg.sum(), m_dg[gi] / m_dg.sum()
    eps = 1e-9   # stable convention for small calibration fractions
    dd.append({"proxy_stratum": rec_ids[gi], "calibration_fraction": float(cf_),
               "deployment_fraction": float(df_),
               "density_ratio_estimate": float((df_ + eps) / (cf_ + eps)),
               "absolute_fraction_shift": float(abs(df_ - cf_))})
if not dd:
    dd = [{"proxy_stratum": "overall", "calibration_fraction": 1.0, "deployment_fraction": 1.0,
           "density_ratio_estimate": 1.0, "absolute_fraction_shift": 0.0}]
pd.DataFrame(dd).to_csv(f"{RESULTS}/distribution_diagnostics.csv", index=False)

# calibration_diagnostics.csv: bins on the true-label-score axis (log-spaced)
BIN_EDGES = np.array([0.0, 5e-4, 1e-3, 2e-3, 5e-3, 0.01, 0.02, 0.05, 0.1, 0.3, 1.0000001])
groups_for_bins = ([("overall", np.ones(n_cal, bool))] +
                   [(rec_ids[gi], d_g_cal == gi) for gi in range(DG)] if DG > 1
                   else [("overall", np.ones(n_cal, bool))])
cd = []
for gname, mask in groups_for_bins:
    st = s_true[mask]
    for b in range(len(BIN_EDGES) - 1):
        bm = (st >= BIN_EDGES[b]) & (st < BIN_EDGES[b + 1])
        if bm.sum() == 0:
            continue
        cd.append({"proxy_stratum": gname, "bin_id": f"b{b:02d}",
                   "score_left": float(BIN_EDGES[b]), "score_right": float(BIN_EDGES[b + 1]),
                   "n_records": int(bm.sum()), "mean_true_label_score": float(st[bm].mean())})
cd_df = pd.DataFrame(cd)
grp = {("overall" if DG == 1 else rec_ids[gi]):
       (risk_dep_hat if DG == 1 else float(risk_cal_dg[gi]),
        ucb_dep if DG == 1 else float(risk_cal_dg[gi] + c_dg[gi])) for gi in range(DG)}
grp["overall"] = (risk_dep_hat, ucb_dep)
cd_df["group_empirical_weighted_miss_risk"] = [grp[p][0] for p in cd_df["proxy_stratum"]]
cd_df["group_upper_confidence_risk"] = [grp[p][1] for p in cd_df["proxy_stratum"]]
cd_df["pooled_upper_confidence_risk"] = ucb_dep
cd_df.to_csv(f"{RESULTS}/calibration_diagnostics.csv", index=False)

# constraint_audit.csv: point estimates + binding pooled UCB on the overall row
ca = []
for gi in range(DG + 1):
    if gi < DG:
        scope = sid = rec_ids[gi]
        emp = float(risk_cal_dg[gi]); ucb_g = float(risk_cal_dg[gi] + c_dg[gi])
        sizes = dep_sizes_all[d_g_dep == gi]
        n_empty = int((sets_dep[d_g_dep == gi].sum(1) == 0).sum())
    else:
        scope, sid = "overall", "all"
        emp, ucb_g = risk_dep_hat, ucb_dep
        sizes = dep_sizes_all
        n_empty = int((sets_dep.sum(1) == 0).sum())
    ca.append({"scope": scope, "stratum_id": sid, "empirical_risk": emp,
               "target_risk": TARGET, "risk_violation": bool(emp > TARGET),
               "violates": bool(emp > TARGET),
               "upper_confidence_risk": ucb_g, "ucb_violates": bool(ucb_g > TARGET),
               "mean_set_size_dep": float(sizes.mean()), "min_set_size": int(sizes.min()),
               "max_set_size": int(sizes.max()), "n_empty_sets": n_empty})
pd.DataFrame(ca)[["scope", "stratum_id", "empirical_risk", "target_risk", "risk_violation",
                  "violates", "upper_confidence_risk", "ucb_violates", "mean_set_size_dep",
                  "min_set_size", "max_set_size", "n_empty_sets"]].to_csv(
    f"{RESULTS}/constraint_audit.csv", index=False)

