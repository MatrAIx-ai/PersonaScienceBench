class Canvas:
    def __init__(self, w, h, bg=(255,255,255)):
        self.w, self.h = w, h
        self.a = np.full((h, w, 3), bg, np.uint8)
    def rect(self, x0, y0, x1, y1, col):
        x0, x1 = sorted((int(round(x0)), int(round(x1)))); y0, y1 = sorted((int(round(y0)), int(round(y1))))
        self.a[max(y0,0):min(y1+1,self.h), max(x0,0):min(x1+1,self.w)] = col
    def line(self, x0, y0, x1, y1, col, t=1):
        x0, y0, x1, y1 = int(round(x0)), int(round(y0)), int(round(x1)), int(round(y1))
        dx, dy = abs(x1-x0), abs(y1-y0)
        sx = 1 if x0 < x1 else -1; sy = 1 if y0 < y1 else -1
        err = dx - dy; x, y = x0, y0
        while True:
            self.rect(x - t//2, y - t//2, x + t//2, y + t//2, col)
            if x == x1 and y == y1: break
            e2 = 2*err
            if e2 > -dy: err -= dy; x += sx
            if e2 <  dx: err += dx; y += sy
    def text(self, x, y, s, col=BLACK, sc=1):
        for ch in s.upper():
            bm = FONT.get(ch, FONT[' ']).split()
            for r, row in enumerate(bm):
                for c, v in enumerate(row):
                    if v == '1':
                        self.rect(x + c*sc, y + r*sc, x + (c+1)*sc - 1, y + (r+1)*sc - 1, col)
            x += 6*sc

class Plot:
    def __init__(self, cv, x0, y0, x1, y1, xlim, ylim):
        self.cv, self.box = cv, (x0, y0, x1, y1)
        self.xlim, self.ylim = xlim, ylim
    def xy(self, x, y):
        x0, y0, x1, y1 = self.box
        fx = (x - self.xlim[0]) / (self.xlim[1] - self.xlim[0])
        fy = (y - self.ylim[0]) / (self.ylim[1] - self.ylim[0])
        return x0 + fx*(x1-x0), y1 - fy*(y1-y0)
    def frame(self, xticks=5, yticks=5, xfmt="%.3g", yfmt="%.3g", xlabel=None, title=None):
        x0, y0, x1, y1 = self.box; cv = self.cv
        cv.line(x0, y0, x1, y0, BLACK); cv.line(x1, y0, x1, y1, BLACK)
        cv.line(x1, y1, x0, y1, BLACK); cv.line(x0, y1, x0, y0, BLACK)
        for i in range(xticks + 1):
            v = self.xlim[0] + (self.xlim[1]-self.xlim[0])*i/xticks
            px, _ = self.xy(v, self.ylim[0])
            cv.line(px, y1, px, y1+4, BLACK)
            cv.text(int(px)-10, y1+7, xfmt % v, BLACK, 1)
        for i in range(yticks + 1):
            v = self.ylim[0] + (self.ylim[1]-self.ylim[0])*i/yticks
            _, py = self.xy(self.xlim[0], v)
            cv.line(x0-4, py, x0, py, BLACK)
            cv.text(x0-42, py-3, yfmt % v, BLACK, 1)
        if xlabel: cv.text((x0+x1)//2 - 5*len(xlabel), y1+22, xlabel, BLACK, 1)
        if title: cv.text((x0+x1)//2 - 6*len(title), max(y0-20, 4), title, BLACK, 1)
    def plot_line(self, xs, ys, col, t=2):
        pts = [self.xy(x, y) for x, y in zip(xs, ys)]
        for (a, b), (c, d) in zip(pts[:-1], pts[1:]):
            self.cv.line(a, b, c, d, col, t)
    def hline(self, y, col, t=1, dash=False):
        x0, y0, x1, y1 = self.box; _, py = self.xy(self.xlim[0], y)
        if not dash: self.cv.line(x0, py, x1, py, col, t)
        else:
            x = x0
            while x < x1:
                self.cv.line(x, py, min(x+8, x1), py, col, t); x += 12
    def legend(self, entries, x, y):
        wd = 8*max(len(e[1]) for e in entries) + 14
        self.cv.rect(x-4, y-4, x+wd, y + 14*len(entries)+4, (245,245,245))
        for xx, yy, col in [(x-4,y-4,x+wd),(x+wd,y-4,x+wd),(x+wd,y+14*len(entries)+4,x-4),(x-4,y+14*len(entries)+4,x-4)]:
            self.cv.line(xx, yy, yy if False else xx, yy, GRAY, 1)
        self.cv.line(x-4, y-4, x+wd, y-4, GRAY); self.cv.line(x+wd, y-4, x+wd, y+14*len(entries)+4, GRAY)
        self.cv.line(x+wd, y+14*len(entries)+4, x-4, y+14*len(entries)+4, GRAY)
        self.cv.line(x-4, y+14*len(entries)+4, x-4, y-4, GRAY)
        for i, (col, lab) in enumerate(entries):
            self.cv.rect(x, y + 14*i + 2, x+10, y + 14*i + 9, col)
            self.cv.text(x+16, y + 14*i, lab, BLACK, 1)

def hist_outline(cv, plot, values, edges, col):
    cnt, _ = np.histogram(values, bins=edges); cnt = cnt / cnt.sum()
    for i, c in enumerate(cnt):
        if c <= 0: continue
        xa, y0b = plot.xy(edges[i], 0); xb, _ = plot.xy(edges[i+1], 0)
        _, ytop = plot.xy(edges[i], c)
        cv.line(xa, y0b, xa, ytop, col, 1); cv.line(xa, ytop, xb, ytop, col, 1)
        cv.line(xb, ytop, xb, y0b, col, 1)

