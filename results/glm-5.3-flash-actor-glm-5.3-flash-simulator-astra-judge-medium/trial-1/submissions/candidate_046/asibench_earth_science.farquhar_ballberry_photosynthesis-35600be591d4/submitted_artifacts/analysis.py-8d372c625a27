 '5':[0x1F,0x10,0x1E,0x01,0x01,0x11,0x0E],'-':[0x00,0x00,0x00,0x1F,0x00,0x00,0x00],
 '.':[0x00,0x00,0x00,0x00,0x00,0x0C,0x0C],'A':[0x0E,0x11,0x11,0x1F,0x11,0x11,0x11],
 'a':[0x00,0x00,0x0E,0x01,0x0F,0x11,0x0F],'d':[0x01,0x01,0x0D,0x13,0x11,0x11,0x0F],
