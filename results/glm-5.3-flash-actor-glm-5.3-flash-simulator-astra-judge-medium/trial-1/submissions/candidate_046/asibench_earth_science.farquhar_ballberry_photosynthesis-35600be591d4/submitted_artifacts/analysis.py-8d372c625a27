def _draw_text(px, x0, y0, text, scale=2, color=(0, 0, 0)):
    for i, ch in enumerate(text):
        glyph = _FONT.get(ch)
        if glyph is None:
            continue
        for ry, bits in enumerate(glyph):
            for rx in range(5):
                if bits & (0x10 >> rx):
                    for dy in range(scale):
                        for dx in range(scale):
                            x, y = x0 + (i * 6 + rx) * scale + dx, y0 + ry * scale + dy
                            if 0 <= x < px.shape[1] and 0 <= y < px.shape[0]:
                                px[y, x] = color

def _draw_line(px, x0, y0, x1, y1, color):
    dx, dy = abs(x1 - x0), -abs(y1 - y0)
    sx, sy = (1 if x0 < x1 else -1), (1 if y0 < y1 else -1)
    err = dx + dy
    while True:
        if 0 <= x0 < px.shape[1] and 0 <= y0 < px.shape[0]:
            px[y0, x0] = color
        if x0 == x1 and y0 == y1:
            break
        e2 = 2 * err
        if e2 >= dy:
            err += dy; x0 += sx
        if e2 <= dx:
            err += dx; y0 += sy

def _panel(px, x0, y0, w, h, series, y_label):
    """Draw one plotting panel; series = list of (values, color)."""
    px[y0:y0 + h, x0] = (0, 0, 0)          # y axis
    px[y0 + h, x0:x0 + w] = (0, 0, 0)      # x axis
    allv = np.concatenate([np.asarray(v, float) for v, _ in series])
    lo, hi = float(allv.min()), float(allv.max())
    pad = 0.05 * (hi - lo if hi > lo else 1.0)
    lo, hi = lo - pad, hi + pad
    for v, c in series:
        xs = np.linspace(x0 + 1, x0 + w - 1, len(v)).astype(int)
        ys = (y0 + h - 1 - (np.asarray(v, float) - lo) / (hi - lo) * (h - 3)).astype(int)
        for x, y in zip(xs, ys):
            if 0 <= y < px.shape[0]:
                px[max(y - 1, 0):min(y + 2, px.shape[0]), x] = c
    _draw_text(px, x0 + 4, y0 + 4, y_label, scale=2, color=(0, 0, 0))
    for f, lab in ((0.0, '0'), (0.5, ''), (1.0, '')):
        yy = y0 + h - 1 - f * (h - 3)
        px[int(yy), max(x0 - 4, 0):x0] = (0, 0, 0)
        tx = max(2, x0 - 46)
        _draw_text(px, tx, int(yy) - 3, "%.3g" % (lo + f * (hi - lo)),
                   scale=1, color=(60, 60, 60))


def plot_diurnal_png(out, path):
    """Render the diurnal figure without matplotlib (stdlib PNG writer)."""
    W, H, S = 1000, 560, 2
    px = np.full((H, W, 3), 255, np.uint8)
    x0, pw, ph = 90, W - 130, 200
    red, blue = (200, 30, 30), (30, 60, 200)
    panels = [
        ([(out.A_shade.values, blue), (out.A_sun.values, red)],
         "A sun/shade (umol/m2/s)"),
        ([(out.rs_shade.values, blue), (out.rs_sun.values, red)],
         "rs sun/shade (s/m)"),
    ]
    for k, (series, lab) in enumerate(panels):
        y0 = 40 + k * (ph + 90)
        _panel(px, x0, y0, pw, ph, series, lab)
        px[y0 + ph, x0:x0 + pw:60] = (0, 0, 0)  # x ticks every 60 px
        for i, hr in enumerate((0, 48, 96)):
            _draw_text(px, x0 + int(pw * hr / 119) - 6, y0 + ph + 8, str(hr),
                       scale=1, color=(60, 60, 60))
    _draw_text(px, x0 + pw // 2 - 140, H - 30, "time (h)  -  5 days", scale=2)
    # PNG encoding (8-bit RGB, no interlace)
    raw = b''.join(b'\x00' + px[y].tobytes() for y in range(H))

    def chunk(tag, data):
        c = tag + data
        return (len(data)).to_bytes(4, 'big') + c + (zlib.crc32(c) & 0xffffffff).to_bytes(4, 'big')
    png = (b'\x89PNG\r\n\x1a\n'
           + chunk(b'IHDR', (W).to_bytes(4, 'big') + (H).to_bytes(4, 'big')
                   + bytes([8, 2, 0, 0, 0]))
           + chunk(b'IDAT', zlib.compress(raw, 9))
           + chunk(b'IEND', b''))
    with open(path, 'wb') as fh:
        fh.write(png)

def plot_diurnal(out, path):
    if HAS_MPL:
        fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(11, 7), sharex=True)
        ax1.plot(out.time_hr, out.A_shade, label="A shaded", color="tab:blue")
        ax1.plot(out.time_hr, out.A_sun, label="A sunlit", color="tab:red")
        ax1.set_ylabel("A  ($\\mu$mol CO$_2$ m$^{-2}$ s$^{-1}$)")
        ax1.legend(loc="upper right")
        ax1.set_title("Diurnal cycle: assimilation and stomatal resistance (C4 leaf, 5 days)")
        ax2.plot(out.time_hr, out.rs_shade, label="rs shaded", color="tab:blue")
        ax2.plot(out.time_hr, out.rs_sun, label="rs sunlit", color="tab:red")
        ax2.set_ylabel("r$_s$  (s m$^{-1}$)")
        ax2.set_xlabel("time (h)")
        ax2.legend(loc="upper right")
        for ax in (ax1, ax2):
            ax.grid(alpha=0.3)
            for d in range(1, 5):
                ax.axvline(24 * d, color="gray", lw=0.5, ls="--", alpha=0.6)
        fig.tight_layout()
        fig.savefig(path, dpi=150)
        plt.close(fig)
    else:
        plot_diurnal_png(out, path)


if __name__ == "__main__":
    main()


