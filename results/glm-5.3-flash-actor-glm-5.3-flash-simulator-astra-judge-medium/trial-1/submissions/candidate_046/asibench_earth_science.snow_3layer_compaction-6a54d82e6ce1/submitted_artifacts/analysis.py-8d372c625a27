def _plot_fallback(here, df, state, days, residual, swe0, daily_snow):
    import struct
    import zlib

    W, H = 1650, 1050
    img = np.full((H, W, 3), 255, np.uint8)
    BLACK, GREY = (0, 0, 0), (160, 160, 160)
    RED, BLUE, GREEN = (220, 30, 30), (30, 60, 200), (20, 130, 40)
    PURPLE = (140, 40, 160)

    def px(x, y, c):
        if 0 <= x < W and 0 <= y < H:
            img[y, x] = c

    def rect(x0, y0, x1, y1, c, fill=True):
        for yy in range(min(y0, y1), max(y0, y1) + 1):
            for xx in range(min(x0, x1), max(x0, x1) + 1):
                if fill or yy in (y0, y1) or xx in (x0, x1):
                    px(xx, yy, c)

    def line(x0, y0, x1, y1, c, dash=None):
        dx, dy = abs(x1 - x0), abs(y1 - y0)
        sx = 1 if x0 < x1 else -1
        sy = 1 if y0 < y1 else -1
        err = dx - dy
        n = 0
        x0, y0, x1, y1 = int(x0), int(y0), int(x1), int(y1)
        while (x0, y0) != (x1, y1):
            if dash is None or (n // 4) % 2 == 0:
                px(x0, y0, c)
            e2 = 2 * err
            if e2 > -dy:
                err -= dy; x0 += sx
            if e2 < dx:
                err += dx; y0 += sy
            n += 1
        px(x1, y1, c)

    def text(x, y, s, c=BLACK, scale=2):
        for ch in s.upper():
            g = _FONT.get(ch, _FONT[" "])
            for r, bits in enumerate(g):
                for b in range(5):
                    if bits & (1 << (4 - b)):
                        for yy in range(scale):
                            for xx in range(scale):
                                px(x + b * scale + xx, y + r * scale + yy, c)
            x += 6 * scale

    def fmt(v):
        return "%g" % v

    def panel(x0, y0, w, h, title, series, xlabel, ylabel, bars=None):
        mL, mR, mT, mB = 78, 150, 34, 46
        ax0, ay0 = x0 + mL, y0 + mT
        ax1, ay1 = x0 + w - mR, y0 + h - mB
        xs = [np.asarray(s[0]) for s in series]
        ys = [np.asarray(s[1]) for s in series]
        if bars:
            xs += [np.asarray(b[0]) for b in bars]
            ys += [np.asarray(b[1]) for b in bars]
        allx = np.concatenate(xs)
        ally = np.concatenate(ys)
        ally = ally[np.isfinite(ally)]
        xmin, xmax = float(allx.min()), float(allx.max())
        ymin, ymax = float(ally.min()), float(ally.max())
        if xmax == xmin:
            xmax = xmin + 1
        if ymax == ymin:
            ymax = ymin + 1
        pady = 0.06 * (ymax - ymin)
        ymin -= pady; ymax += pady

        def mx(v): return ax0 + (v - xmin) / (xmax - xmin) * (ax1 - ax0)
        def my(v): return ay1 - (v - ymin) / (ymax - ymin) * (ay1 - ay0)

        rect(x0, y0, x0 + w - 1, y0 + h - 1, BLACK, fill=False)
        rect(ax0, ay0, ax1, ay1, GREY, fill=False)
        for t in np.linspace(ymin, ymax, 5):
            yy = int(round(my(t)))
            line(ax0, yy, ax1, yy, (235, 235, 235))
            text(x0 + 8, yy - 3, fmt(t), BLACK, 1)
        for t in np.linspace(xmin, xmax, 5):
            xx = int(round(mx(t)))
            line(xx, ay0, xx, ay1, (235, 235, 235))
            text(xx - 6, ay1 + 6, fmt(t), BLACK, 1)
        text(x0 + mL, y0 + h - mB + 22, xlabel, BLACK, 2)
        text(x0 + 6, y0 + mT - 26, ylabel, BLACK, 2)
        text(x0 + 8, y0 + 8, title, BLACK, 2)
        for b in bars or []:
            xd, hts, c, lab, off, bw = b
            wpx = max(1, int(round(bw / (xmax - xmin) * (ax1 - ax0))))
            for k in range(len(xd)):
                v = hts[k]
                if not np.isfinite(v) or v <= 0:
                    continue
                xc = int(round(mx(xd[k] + off)))
                ytop = int(round(my(v)))
                rect(xc - wpx // 2, ytop, xc + wpx // 2, ay1, c)
        for s in series:
            xd, yd, c, lab, dash = s
            pts = [(int(round(mx(xd[k]))), int(round(my(yd[k]))))
                   for k in range(len(xd)) if np.isfinite(yd[k])]
            for k in range(len(pts) - 1):
                line(pts[k][0], pts[k][1], pts[k + 1][0], pts[k + 1][1], c, dash)
        entries = [(s[2], s[4], s[3]) for s in series if s[3]]
        entries += [(b[2], None, b[3]) for b in (bars or []) if b[3]]
        ly = y0 + mT + 4
        for c, dash, lab in entries:
            line(ax1 - 132, ly + 4, ax1 - 108, ly + 4, c, dash)
            text(ax1 - 102, ly, lab, BLACK, 1)
            ly += 13

    cum_m = np.cumsum(df.melt_mm.values)
    cum_r = np.cumsum(df.refreeze_mm.values)
    cum_o = np.cumsum(df.runoff_mm.values)
    cum_s = np.cumsum(daily_snow)
    res_cum = df.swe_mm.values + cum_o - swe0 - cum_s

    pw, ph = 520, 470
    gx, gy = 20, 40
    P = lambda r, c: (gx + c * (pw + 20), gy + r * (ph + gy))

    panel(*P(0, 0), pw, ph, "SWE AND SNOW DEPTH",
          [(days, df.swe_mm.values, BLUE, "SWE (MM W.E.)", None),
           (days, df.snow_depth_m.values * 1000, BLACK, "DEPTH (MM)", (4, 4))],
          "DAY", "MM")
    panel(*P(0, 1), pw, ph, "LAYER TEMPERATURES (DEG C)",
          [(days, state[:, 0, 4] - T_M, RED, "LAYER 1 (SKIN)", None),
           (days, state[:, 1, 4] - T_M, BLUE, "LAYER 2", None),
           (days, state[:, 2, 4] - T_M, GREEN, "LAYER 3", None),
           (days, np.zeros(len(days)), GREY, "0 C", None)],
          "DAY", "DEG C")
    panel(*P(0, 2), pw, ph, "DENSITY (KG/M3)",
          [(days, state[:, 0, 1], RED, "LAYER 1", None),
           (days, state[:, 1, 1], BLUE, "LAYER 2", None),
           (days, state[:, 2, 1], GREEN, "LAYER 3", None),
           (days, df.mean_density_kg_m3.values, BLACK, "BULK", (4, 4))],
          "DAY", "KG/M3")
    panel(*P(1, 0), pw, ph, "LAYER THICKNESS (M)",
          [(days, state[:, 0, 0], RED, "LAYER 1", None),
           (days, state[:, 1, 0], BLUE, "LAYER 2", None),
           (days, state[:, 2, 0], GREEN, "LAYER 3", None),
           (days, df.snow_depth_m.values, BLACK, "TOTAL", (4, 4))],
          "DAY", "M")
    panel(*P(1, 1), pw, ph, "DAILY MELT / REFREEZE / RUNOFF",
          [], "DAY", "MM W.E./DAY",
          bars=[(days, df.melt_mm.values, RED, "MELT", -0.28, 0.27),
                (days, df.refreeze_mm.values, BLUE, "REFREEZE", 0.0, 0.27),
                (days, df.runoff_mm.values, GREEN, "RUNOFF", 0.28, 0.27)])
    panel(*P(1, 2), pw, ph,
          "CUMULATIVE FLUXES; RESIDUAL = %+.1E MM" % residual,
          [(days, cum_m, RED, "CUM MELT", None),
           (days, cum_r, BLUE, "CUM REFREEZE", None),
           (days, cum_o, GREEN, "CUM RUNOFF", None),
           (days, cum_s, PURPLE, "CUM SNOWFALL", None),
           (days, res_cum, BLACK, "MASS RESIDUAL", (4, 4))],
          "DAY", "MM W.E.")

    # ---- encode PNG (8-bit RGB, no interlace)
    raw = b"".join(b"\x00" + img[y].tobytes() for y in range(H))
    idat = zlib.compress(raw, 6)

    def chunk(tag, data):
        c = struct.pack(">I", len(data)) + tag + data
        return c + struct.pack(">I", zlib.crc32(tag + data) & 0xFFFFFFFF)

    png = (b"\x89PNG\r\n\x1a\n"
           + chunk(b"IHDR", struct.pack(">IIBBBBB", W, H, 8, 2, 0, 0, 0))
           + chunk(b"IDAT", idat) + chunk(b"IEND", b""))
    with open(os.path.join(here, "results", "snow_evolution.png"), "wb") as fh:
        fh.write(png)
    print("matplotlib unavailable - figure rendered with built-in PNG writer")


