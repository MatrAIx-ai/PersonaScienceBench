def neighbor_sum(s):
    return (np.roll(s, 1, 0) + np.roll(s, -1, 0)
            + np.roll(s, 1, 1) + np.roll(s, -1, 1))


def run_dynamics(s0, grid_size, beta, n_steps, meas_times_i, snap_times_i, rng):
    """Checkerboard Metropolis; returns seriesA rows, interface density,
    the full lattice state at every measurement time and at every
    snapshot time (snapshot times need not coincide with measurements)."""
    s = s0.copy()
    N2 = grid_size * grid_size
    meas_index = {t: i for i, t in enumerate(meas_times_i)}
    snap_set = set(snap_times_i)
    seriesA = np.full((2, len(meas_times_i)), np.nan)
    rho_t = np.full(len(meas_times_i), np.nan)
    states = [None] * len(meas_times_i)
    snap_states = [None] * len(snap_times_i)
    g = np.add.outer(np.arange(grid_size), np.arange(grid_size)) % 2 == 0
    for sweep in range(1, n_steps + 1):
        for parity in (0, 1):
            mask = g if parity == 0 else ~g
            nb = neighbor_sum(s)
            dE = 2.0 * s * nb
            p_acc = np.exp(-beta * np.maximum(dE, 0.0))   # p = 1 if dE <= 0
            flip = mask & (rng.random((grid_size, grid_size)) < p_acc)
            s[flip] = -s[flip]
        if sweep in meas_index:
            i = meas_index[sweep]
            seriesA[0, i] = float(s.sum()) / N2
            seriesA[1, i] = -float((s * neighbor_sum(s)).sum()) / (2.0 * N2)
            r = (s != np.roll(s, 1, 0)).sum() + (s != np.roll(s, 1, 1)).sum()
            rho_t[i] = float(r) / (2.0 * N2)
            states[i] = s.copy()
        if sweep in snap_set:
            snap_states[snap_times_i.index(sweep)] = s.copy()
    assert not np.isnan(seriesA).any() and not np.isnan(rho_t).any()
    assert all(st is not None for st in states)
    assert all(st is not None for st in snap_states)
    return seriesA, rho_t, states, snap_states


def radial_correlation(s, max_r):
    """Angularly averaged <s(0) s(r)>: FFT autocorrelation averaged over
    origins, ring = all displacements with round(distance) == r."""
    n = s.shape[0]
    F = np.fft.rfft2(s.astype(np.float64))
    ac = np.fft.irfft2(F * np.conj(F), s=s.shape) / (n * n)
    yy, xx = np.mgrid[0:n, 0:n]
    dx = np.minimum(xx, n - xx)
    dy = np.minimum(yy, n - yy)
    d = np.rint(np.sqrt(dx ** 2 + dy ** 2)).astype(int)
    return np.array([ac[d == r].mean() for r in range(max_r)])


def length_from_correlation(G, m2, grid_size):
    """L = first zero crossing of C(r) = G(r) - m^2 (linear interpolation
    between bracketing integer r). Fallback: half-height crossing of G
    between G(0)=1 and the plateau m^2. Returns (L, method)."""
    C = G - m2
    if C[1] > 0.0:
        for r in range(2, len(C)):
            if C[r] <= 0.0:
                c0, c1 = C[r - 1], C[r]
                frac = (0.0 - c0) / (c1 - c0) if c1 != c0 else 0.5
                return (r - 1) + frac, "zero-crossing of C(r)=G(r)-m^2"
    half = 0.5 * (1.0 + m2)
    for r in range(1, len(G)):
        if G[r] <= half:
            g0, g1 = G[r - 1], G[r]
            frac = (half - g0) / (g1 - g0) if g1 != g0 else 0.5
            return (r - 1) + frac, "half-height crossing of G(r) (fallback)"
    return float(grid_size), "no crossing within max_r (saturated)"


def power_law_fit(t, L, t_min, t_max):
    """OLS fit log L = log A + theta log t on the window [t_min, t_max]."""
    sel = (t >= t_min) & (t <= t_max)
    x, y = np.log(t[sel]), np.log(L[sel])
    n = int(len(x))
    if n < 3:
        return dict(exponent=float("nan"), exponent_std_error=float("nan"),
                    amplitude=float("nan"), r_squared=float("nan"), n=n)
    theta, logA = np.polyfit(x, y, 1)
    yhat = theta * x + logA
    ss_res = float(((y - yhat) ** 2).sum())
    ss_tot = float(((y - y.mean()) ** 2).sum())
    r2 = 1.0 - ss_res / ss_tot if ss_tot > 0 else float("nan")
    dof = n - 2
    s_err = (float(np.sqrt(ss_res / dof / ((x - x.mean()) ** 2).sum()))
             if dof > 0 else float("nan"))
    return dict(exponent=float(theta), exponent_std_error=s_err,
                amplitude=float(np.exp(logA)), r_squared=float(r2), n=n)


