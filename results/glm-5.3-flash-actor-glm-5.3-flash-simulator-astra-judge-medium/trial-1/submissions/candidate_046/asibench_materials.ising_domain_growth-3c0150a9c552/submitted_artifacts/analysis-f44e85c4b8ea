#!/usr/bin/env python3
"""
B3: Hidden Binary-Grid Time Evolution.

Inferred model (all semantic choices documented in the JSON 'notes'):
  2D Ising model, J = 1, single-spin-flip Metropolis dynamics with
  inverse temperature beta = parameters['control'] (deep quench:
  beta_c = ln(1+sqrt(2))/2 ~ 0.4407 for J=1, so beta = 2.0236 is far
  below Tc -> domain coarsening from the disordered initial state).
  Periodic boundaries. 1 time unit = 1 Monte Carlo sweep =
  grid_size^2 single-spin attempts, implemented as two vectorized
  checkerboard half-updates per sweep. RNG:
  numpy.random.default_rng(dynamics_seed), drawn once at start.

Outputs (all float64 and finite):
  seriesA.npy [2, n_measurements]  row0 = magnetization per site m(t)
                                   row1 = energy per site e(t)
  seriesB.npy [2, n_measurements]  row0 = domain length L(t) (first zero
                                   crossing of connected correlation),
                                   row1 = interface (unlike-bond) density
  stackC.npy  [n_snapshots, max_r] angularly averaged G(r,t), r=0..max_r-1
  stackD.npy  [n_snapshots, grid_size] row-averaged spin profile
  stackE.npy  [n_snapshots, 2, grid_size] two axial averages per snapshot
  metadataA.json  scaling-collapse diagnostics
  metadataB.json  power-law fit L(t) = A * t**theta
  figure.png      diagnostic figure (matplotlib if available, otherwise a
                  dependency-free PNG renderer using only numpy + stdlib)
"""
import json
import numpy as np

