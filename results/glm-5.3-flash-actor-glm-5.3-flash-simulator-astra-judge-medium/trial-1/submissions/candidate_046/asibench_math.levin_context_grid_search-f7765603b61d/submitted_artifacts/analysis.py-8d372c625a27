"""Learned action-selection model for symbolic grid-search levels (asibench B3).

Interface (required):
    make_policy(training_data: dict, config: dict | None = None) -> policy
    policy.action_probs(level: dict, state: dict, legal_actions: list[str]) -> dict[str, float]

Design (learned from the 260 solved training levels, all replayed exactly):
  * Solutions are corridor walks: the agent continues in its previous direction
    whenever that is legal (5819/5819 steps in training), turns ONLY when the
    straight-ahead cell is a wall (385/385 turns are wall-forced), and never
    reverses (U-turns: 0).
  * Every level's turns rotate consistently in one direction (spiral rule):
    251/251 levels with >=1 turn are single-rotation; the remaining 9 levels
    have no turns at all.  Hence at an ambiguous wall-end junction (both
    perpendicular sides open; 247 such turns in training) the correct side is
    50/50 only for the FIRST turn of a level; all later turns are recovered
    from the rotation observed in the action history.
  * A neighbouring goal tile ('G') is taken whenever adjacent (260/260 final
    steps; 'G' is never adjacent earlier along the training paths).
  * Tile letters behave like uniform noise (chosen-side letter is larger in
    only ~52% of ambiguous turns; a per-previous-action side tilt fitted on
    247 ambiguous turns improved in-sample greedy success but REDUCED public
    eval success 4/4 -> 3/4, so it was removed rather than forced).

The policy is a behaviour-cloned log-linear model over these compound local
contexts with Laplace-smoothed counts learned in make_policy, an epsilon floor
on every legal action (so the scorer's search can backtrack), and strict
renormalisation over legal_actions.  All observation-field parsing is
defensive: formats of previous_action/history/history_tail/neighbors/
legal_mask/depth_* are inferred tolerantly and missing fields degrade
gracefully to weaker contexts.

NOTE: the policy never reads spatial level metadata at scoring time; the local
evaluation harness in __main__ uses the public eval grids purely as a
development emulation of the hidden transition system.
"""

from __future__ import annotations

import math
from collections import Counter

ACTIONS = ("U", "D", "L", "R")
DELTAS = {"U": (-1, 0), "D": (1, 0), "L": (0, -1), "R": (0, 1)}
OPPOSITE = {"U": "D", "D": "U", "L": "R", "R": "L"}
LEFT_OF = {"U": "L", "L": "D", "D": "R", "R": "U"}
RIGHT_OF = {"U": "R", "R": "D", "D": "L", "L": "U"}

DEFAULT_CONFIG = {
    "eps": 2e-3,           # probability floor for every legal action
    "w_inertia_cap": 6.0,  # cap on the learned log-weight for continuing straight
    "w_goal": 8.0,         # log-weight for stepping onto an adjacent goal tile
    "w_rot_cap": 6.0,      # cap on the learned log-weight for the observed spiral rotation
    "w_reverse": -6.0,     # penalty for reversing direction (never seen in training)
    "first_uniform": True, # first move: uniform (learned first-action tilt is noise: 63/63/69/65)
    "spiral_mode": "all_agree",  # 'all_agree' | 'last' | 'off' (rotation inference from history)
    "temp": 1.0,           # softmax temperature over log-scores
    "alpha": 1.0,          # Laplace smoothing pseudo-count
}

GOAL_LIKE_CHARS = {"G"}  # extended defensively (uppercase non-floor tiles count too)


# ----------------------------------------------------------------------------
# tolerant observation parsing
# ----------------------------------------------------------------------------

def _as_action(obj, default=None):
    """Extract an action string ('U'/'D'/'L'/'R') from an arbitrary object."""
    if obj is None:
        return default
    if isinstance(obj, str):
        s = obj.strip().upper()[:1]
        return s if s in ACTIONS else default
    if isinstance(obj, dict):
        for key in ("action", "a", "move", "dir", "direction", "name"):
            if key in obj:
                return _as_action(obj[key], default)
        return default
    if isinstance(obj, (list, tuple)) and obj:
        return _as_action(obj[0], default)
    return default


def _history_actions(state):
    """Best-effort extraction of the action history (most recent last)."""
    for key in ("history", "history_tail", "path", "trajectory"):
        raw = state.get(key)
        if not raw:
            continue
        if isinstance(raw, str):
            acts = [_as_action(ch) for ch in raw.upper()]
        elif isinstance(raw, dict):
            raw = raw.get("actions", raw.get("moves"))
            if isinstance(raw, str):
                acts = [_as_action(ch) for ch in raw.upper()]
            else:
                acts = [_as_action(x) for x in (raw or [])]
        else:
            acts = [_as_action(x) for x in raw]
        acts = [a for a in acts if a in ACTIONS]
        if acts:
            return acts
    return []


def _previous_action(state):
    prev = state.get("previous_action", state.get("prev_action"))
    prev = _as_action(prev)
    if prev is None:
        hist = _history_actions(state)
        if hist:
            prev = hist[-1]
    return prev


def _neighbors_dict(state, level):
    """Normalize 'neighbors' into {action: tile}. Returns {} if unknown."""
    nb = state.get("neighbors")
    if nb is None and isinstance(level, dict):
        nb = level.get("neighbors")
    out = {}
    if isinstance(nb, dict):
        for k, v in nb.items():
            a = _as_action(k)
            if a is not None:
                out[a] = v
    elif isinstance(nb, (list, tuple)):
        order = list(ACTIONS)
        if isinstance(level, dict):
            order = level.get("action_order") or order
        if len(nb) == 4 and all(isinstance(x, (list, tuple)) and len(x) >= 2 for x in nb):
            for x in nb:  # pairs like (action, tile)
                a = _as_action(x[0])
                if a is not None:
                    out[a] = x[1]
        elif len(nb) == 4:
            for a, tile in zip(order, nb):
                out[a] = tile
    return {a: t for a, t in out.items() if isinstance(t, str) and t}


def _is_wall(tile):
    if not isinstance(tile, str) or not tile:
        return None
    ch = tile.strip()[:1]
    if ch == "#":
        return True
    if ch.isalpha():
        return False  # floor letters and goal tiles are enterable
    return None


def _is_goal_like(tile):
    if not isinstance(tile, str) or not tile:
        return False
    ch = tile.strip()[:1]
    if ch in GOAL_LIKE_CHARS:
        return True
    # defensive: any uppercase, non-wall tile is treated as a special/goal tile
    return ch.isalpha() and ch.isupper()


def _rotation_of(prev, nxt):
    """Rotation direction ('L'/'R' turn) of a consecutive action pair, else None."""
    if prev is None or nxt is None or prev == nxt:
        return None
    if LEFT_OF.get(prev) == nxt:
        return "L"
    if RIGHT_OF.get(prev) == nxt:
        return "R"
    return None  # reversal or unknown


def _history_rotation(hist, mode="all_agree"):
    """Spiral rotation inferred from the action history.

    mode='all_agree': rotation only when every observed turn agrees (robust to
    backtracking/wandering histories, which otherwise poison downstream turns).
    mode='last'    : most recent observed turn wins.
    mode='off'     : never infer (all ambiguous turns are 50/50).
    """
    rots = []
    for i in range(1, len(hist)):
        r = _rotation_of(hist[i - 1], hist[i])
        if r is not None:
            rots.append(r)
    if mode == "off" or not rots:
        return None
    if mode == "last":
        return rots[-1]
    return rots[0] if len(set(rots)) == 1 else None


def _legal_actions(state, level, legal_actions, neighbors):
    acts = []
    for a in (legal_actions or []):
        if isinstance(a, str):
            a = a.strip().upper()[:1]
            if a in ACTIONS and a not in acts:
                acts.append(a)
    if acts:
        return acts
    mask = state.get("legal_mask")
    if mask is None and isinstance(level, dict):
        mask = level.get("legal_mask")
    if isinstance(mask, dict):
        cand = [_as_action(k) for k, v in mask.items() if v]
        cand = [a for a in cand if a]
        if cand:
            return cand
    if isinstance(mask, (list, tuple)) and len(mask) == 4:
        cand = [a for a, m in zip(ACTIONS, mask) if m]
        if cand:
            return cand
    if neighbors:  # fall back to wall inference
        cand = [a for a in ACTIONS if _is_wall(neighbors.get(a)) is False]
        if cand:
            return cand
    return list(ACTIONS)


# ----------------------------------------------------------------------------
# learning (behaviour cloning over compound local contexts)
# ----------------------------------------------------------------------------

def _replay_contexts(level):
    """Yield per-step context dicts by deterministically replaying a solution."""
    grid = level["grid"]
    r, c = level["start"]
    sol = level["solution"]
    n_rows, n_cols = len(grid), len(grid[0])

    def tile_at(rr, cc):
        if 0 <= rr < n_rows and 0 <= cc < n_cols:
            return grid[rr][cc]
        return "#"

    ctxs = []
    for i, act in enumerate(sol):
        neigh = {a: tile_at(r + dr, c + dc) for a, (dr, dc) in DELTAS.items()}
        ctxs.append({
            "step": i,
            "action": act,
            "prev": sol[i - 1] if i > 0 else None,
            "cell": tile_at(r, c),
            "neighbors": neigh,
            "history": sol[:i],
        })
        dr, dc = DELTAS[act]
        r, c = r + dr, c + dc
    return ctxs


def learn_model(training_data, alpha=1.0):
    """Accumulate Laplace-smoothed counts over compound local contexts."""
    m = {
        "alpha": alpha,
        "first": Counter(),
        "inertia_same": 0,
        "turn_while_open": 0,          # turned although straight was open (0 in training)
        "open_steps": 0,
        "goal_take": 0,
        "goal_skip": 0,
        "turn_forced": 0,
        "turn_ambiguous": 0,
        "amb_first_L": 0,
        "amb_first_R": 0,
        "amb_known_agree": 0,
        "amb_known_disagree": 0,
        "rot_agree": 0,
        "rot_disagree": 0,
        "n_levels": 0,
        "n_steps": 0,
    }
    for level in training_data.get("levels", []):
        if "solution" not in level:
            continue
        m["n_levels"] += 1
        for ctx in _replay_contexts(level):
            m["n_steps"] += 1
            act = ctx["action"]
            neigh = ctx["neighbors"]
            goal_actions = [a for a, t in neigh.items() if _is_goal_like(t)]
            if goal_actions:
                if act in goal_actions:
                    m["goal_take"] += 1
                else:
                    m["goal_skip"] += 1
            prev = ctx["prev"]
            if prev is None:
                m["first"][act] += 1
                continue
            straight_open = _is_wall(neigh.get(prev)) is False
            if act == prev:
                m["inertia_same"] += 1
                m["open_steps"] += 1
                continue
            if straight_open:
                m["turn_while_open"] += 1
                m["open_steps"] += 1
                continue
            perp = [d for d in (LEFT_OF[prev], RIGHT_OF[prev])
                    if _is_wall(neigh.get(d)) is False]
            rot = _rotation_of(prev, act)
            prior_rot = _history_rotation(ctx["history"], mode="last")
            if prior_rot is not None:
                if rot == prior_rot:
                    m["rot_agree"] += 1
                else:
                    m["rot_disagree"] += 1
            if len(perp) <= 1:
                m["turn_forced"] += 1
            else:
                m["turn_ambiguous"] += 1
                if prior_rot is None:
                    if rot == "L":
                        m["amb_first_L"] += 1
                    elif rot == "R":
                        m["amb_first_R"] += 1
                else:
                    if rot == prior_rot:
                        m["amb_known_agree"] += 1
                    else:
                        m["amb_known_disagree"] += 1
    return m


def _learned_log_odds(num, den, alpha, cap):
    """Smoothed log-odds of num vs (den-num), capped to stay conservative."""
    p = (num + alpha) / (den + 2.0 * alpha)
    q = 1.0 - p
    val = math.log(max(p, 1e-9) / max(q, 1e-9))
    return max(-cap, min(cap, val))


# ----------------------------------------------------------------------------
# policy
# ----------------------------------------------------------------------------

class Policy:
    """Compound-context behaviour-cloned policy over local observations."""

    def __init__(self, model, config=None):
        self.m = model
        cfg = dict(DEFAULT_CONFIG)
        cfg.update(config or {})
        self.cfg = cfg
        a = cfg["alpha"]
        m = model
        # learned weights (capped), overridable through config
        self.w_inertia = cfg.get(
            "w_inertia",
            _learned_log_odds(m["inertia_same"], m["turn_while_open"],
                              max(a, 0.5), cfg["w_inertia_cap"]),
        )
        # rotation consistency learned over ALL turns (forced + ambiguous):
        # in training 385/385 turns agree with the level's spiral direction.
        self.w_rot = cfg.get(
            "w_rot",
            _learned_log_odds(m["rot_agree"], m["rot_disagree"], a, cfg["w_rot_cap"]),
        )
        self.w_goal = cfg.get("w_goal")

    def action_probs(self, level, state, legal_actions):
        level = level if isinstance(level, dict) else {}
        state = state if isinstance(state, dict) else {}
        cfg = self.cfg
        neighbors = _neighbors_dict(state, level)
        acts = _legal_actions(state, level, legal_actions, neighbors)
        if not acts:
            return {}
        prev = _previous_action(state)
        hist = _history_actions(state)
        scores = {a: 0.0 for a in acts}

        # 1) goal pull: stepping onto an adjacent goal-like tile ends the search
        for act in acts:
            if _is_goal_like(neighbors.get(act)):
                scores[act] += self.w_goal

        # 2) inertia: continue straight while it is legal (learned ~1.0)
        if prev is not None and prev in acts:
            scores[prev] += self.w_inertia
        elif prev is not None:
            # wall ahead -> forced/ambiguous turn handling
            lo, ro = LEFT_OF.get(prev), RIGHT_OF.get(prev)
            perp = [d for d in (lo, ro) if d in acts]
            if len(perp) == 2:
                rot = None
                mode = cfg.get("spiral_mode", "all_agree")
                if mode != "off":
                    rot = _history_rotation(hist, mode=mode)
                if rot == "L" and lo in scores:
                    scores[lo] += self.w_rot
                elif rot == "R" and ro in scores:
                    scores[ro] += self.w_rot
                else:
                    # first ambiguous turn of a level: no local evidence separates
                    # the sides (tile letters are noise) -> uniform 50/50; the
                    # scorer's search resolves the coin via backtracking.
                    pass
            if OPPOSITE.get(prev) in scores:
                scores[OPPOSITE[prev]] += cfg["w_reverse"]

        # 3) no previous action -> first-move distribution
        if prev is None:
            if cfg.get("first_uniform", True):
                pass  # uniform (learned first-action tilt is statistical noise)
            else:
                first = self.m["first"]
                tot = sum(first.values()) + len(ACTIONS) * self.m["alpha"]
                for act in acts:
                    scores[act] += math.log(max(first.get(act, 0) + self.m["alpha"], 1e-9) / tot)

        # 4) softmax, epsilon floor, strict renormalisation over legal actions
        temp = max(cfg.get("temp", 1.0), 1e-6)
        mx = max(scores.values())
        exp_scores = {a: math.exp((scores[a] - mx) / temp) for a in acts}
        z = sum(exp_scores.values())
        probs = {a: exp_scores[a] / z for a in acts}
        eps = min(max(cfg.get("eps", 0.0), 0.0), 0.5)
        if eps > 0.0 and len(acts) > 1:
            probs = {a: (1.0 - eps) * probs[a] + eps / len(acts) for a in acts}
        z2 = sum(probs.values())
        probs = {a: probs[a] / z2 for a in acts}
        return probs


def make_policy(training_data, config=None):
    """Learn the compound-context model from solved levels and return a policy."""
    cfg = dict(DEFAULT_CONFIG)
    cfg.update(config or {})
    model = learn_model(training_data, alpha=cfg.get("alpha", 1.0))
    return Policy(model, cfg)


# ----------------------------------------------------------------------------
# local development harness (NOT used by the policy at scoring time)
# ----------------------------------------------------------------------------

def _level_state(level, r, c, history):
    """Emulate the scorer's local observation fields for a cell (dev harness only)."""
    grid = level["grid"]
    n_rows, n_cols = len(grid), len(grid[0])
    neighbors = {}
    for a, (dr, dc) in DELTAS.items():
        rr, cc = r + dr, c + dc
        neighbors[a] = grid[rr][cc] if 0 <= rr < n_rows and 0 <= cc < n_cols else "#"
    legal = [a for a, t in neighbors.items() if t != "#"]
    depth = len(history)
    run = 0
    for a in reversed(history):
        if history and a == history[-1]:
            run += 1
        else:
            break
    run = run or (1 if history else 0)
    max_depth = level.get("max_depth", 100)
    phase = ("early" if depth < max_depth / 3.0
             else "mid" if depth < 2.0 * max_depth / 3.0 else "late")
    return {
        "cell": grid[r][c],
        "neighbors": neighbors,
        "previous_action": history[-1] if history else None,
        "history": list(history),
        "history_tail": list(history[-8:]),
        "run_length_bucket": min(run, 8),
        "depth": depth,
        "depth_mod": depth % 10,
        "depth_phase": phase,
        "legal_mask": [1 if a in legal else 0 for a in ACTIONS],
        "legal_actions": list(legal),
    }


def emulate(level, policy, regime="dfs", budget=95):
    """Emulate a plausible scorer search on a level whose grid is available.

    regime='greedy': argmax roll-out, no backtracking.
    regime='dfs'   : depth-first graph search, children ordered by policy
                     probability (backtracking via the stack), global visited
                     set, expansion budget enforced.
    regime='best'  : best-first graph search ordered by cumulative log-prob
                     (Levin-style policy-ordered frontier).
    Expansions are counted as action_probs calls (one per expanded state);
    landing on the goal terminates without a further expansion.
    """
    grid = level["grid"]
    n_rows, n_cols = len(grid), len(grid[0])
    start = tuple(level["start"])
    max_depth = level.get("max_depth", 10 ** 6)

    if regime == "greedy":
        r, c = start
        history = []
        expansions = 0
        while expansions < budget and len(history) < max_depth:
            st = _level_state(level, r, c, history)
            probs = policy.action_probs(level, st, st["legal_actions"])
            expansions += 1
            if not probs:
                return {"success": False, "expansions": expansions, "path_len": len(history)}
            best = max(sorted(probs), key=lambda a: (probs[a], -ACTIONS.index(a)))
            dr, dc = DELTAS[best]
            r, c = r + dr, c + dc
            history.append(best)
            if not (0 <= r < n_rows and 0 <= c < n_cols) or grid[r][c] == "#":
                return {"success": False, "expansions": expansions, "path_len": len(history)}
            if grid[r][c] == "G":
                return {"success": True, "expansions": expansions, "path_len": len(history)}
        return {"success": False, "expansions": expansions, "path_len": len(history)}

    if regime == "best":
        import heapq
        start_state = _level_state(level, start[0], start[1], [])
        p0 = policy.action_probs(level, start_state, start_state["legal_actions"])
        frontier = []  # (-cum_log_prob, tie, r, c, history)
        heapq.heappush(frontier, (0.0, 0, start[0], start[1], []))
        visited = {start}
        expansions = 0
        counter = 1
        while frontier and expansions < budget:
            neglp, _tie, r, c, history = heapq.heappop(frontier)
            if len(history) >= max_depth:
                continue
            st = _level_state(level, r, c, history)
            probs = policy.action_probs(level, st, st["legal_actions"])
            expansions += 1
            for act, p in sorted(probs.items(), key=lambda kv: ACTIONS.index(kv[0])):
                dr, dc = DELTAS[act]
                nr, nc = r + dr, c + dc
                if not (0 <= nr < n_rows and 0 <= nc < n_cols) or grid[nr][nc] == "#":
                    continue
                if (nr, nc) in visited:
                    continue
                visited.add((nr, nc))
                if grid[nr][nc] == "G":
                    return {"success": True, "expansions": expansions,
                            "path_len": len(history) + 1}
                heapq.heappush(frontier, (neglp + math.log(max(p, 1e-12)), counter,
                                          nr, nc, history + [act]))
                counter += 1
        return {"success": False, "expansions": expansions, "path_len": -1}

    # regime == 'dfs': depth-first graph search with prob-ordered children
    visited = {start}
    stack = [(start[0], start[1], [])]
    expansions = 0
    while stack and expansions < budget:
        r, c, history = stack.pop()
        if len(history) >= max_depth:
            continue
        st = _level_state(level, r, c, history)
        probs = policy.action_probs(level, st, st["legal_actions"])
        expansions += 1
        children = sorted(probs.items(), key=lambda kv: (-kv[1], ACTIONS.index(kv[0])))
        for act, _p in reversed(children):  # LIFO: highest-prob child popped first
            dr, dc = DELTAS[act]
            nr, nc = r + dr, c + dc
            if not (0 <= nr < n_rows and 0 <= nc < n_cols) or grid[nr][nc] == "#":
                continue
            if (nr, nc) in visited:
                continue
            visited.add((nr, nc))
            if grid[nr][nc] == "G":
                return {"success": True, "expansions": expansions,
                        "path_len": len(history) + 1}
            stack.append((nr, nc, history + [act]))
    return {"success": False, "expansions": expansions, "path_len": -1}


def _step_agreement(train, policy):
    """Step-level argmax agreement between the policy and the expert solutions."""
    agree = total = 0
    mismatches = []
    for level in train["levels"]:
        for ctx in _replay_contexts(level):
            st = {
                "cell": ctx["cell"],
                "neighbors": ctx["neighbors"],
                "previous_action": ctx["prev"],
                "history": list(ctx["history"]),
                "history_tail": list(ctx["history"][-8:]),
                "run_length_bucket": 0,
                "depth": ctx["step"],
                "depth_mod": ctx["step"] % 10,
                "depth_phase": "mid",
                "legal_actions": [a for a, t in ctx["neighbors"].items() if t != "#"],
            }
            probs = policy.action_probs(level, st, st["legal_actions"])
            best = max(sorted(probs), key=lambda a: (probs[a], -ACTIONS.index(a)))
            total += 1
            if best == ctx["action"]:
                agree += 1
            elif len(mismatches) < 5:
                mismatches.append((level["id"], ctx["step"], ctx["prev"], best, ctx["action"]))
    return agree, total, mismatches


def _run_harness():
    import json
    import os

    for path in ("data/training_levels.json", "data/public_eval_levels.json"):
        if not os.path.exists(path):
            print(f"[harness] missing {path}; skipping emulation report")
            return

    with open("data/training_levels.json") as fh:
        train = json.load(fh)
    with open("data/public_eval_levels.json") as fh:
        ev = json.load(fh)

    policy = make_policy(train)
    m = policy.m
    print("learned model summary (from %d levels, %d steps):" % (m["n_levels"], m["n_steps"]))
    print("  inertia_same=%d turn_while_open=%d goal_take=%d goal_skip=%d" %
          (m["inertia_same"], m["turn_while_open"], m["goal_take"], m["goal_skip"]))
    print("  turn_forced=%d turn_ambiguous=%d amb_first(L/R)=%d/%d "
          "amb_known(agree/disagree)=%d/%d" %
          (m["turn_forced"], m["turn_ambiguous"], m["amb_first_L"], m["amb_first_R"],
           m["amb_known_agree"], m["amb_known_disagree"]))
    print("  learned weights: w_inertia=%.3f w_rot=%.3f" %
          (policy.w_inertia, policy.w_rot))

    agree, total, mismatches = _step_agreement(train, policy)
    print("\n[0] step-level argmax agreement with expert solutions: %d/%d (%.2f%%)" %
          (agree, total, 100.0 * agree / total))
    if mismatches:
        print("    first mismatches:", mismatches)

    print("\n[A] training levels under emulated search (budget=95):")
    for regime in ("greedy", "dfs", "best"):
        solved = 0
        exps = []
        for level in train["levels"]:
            res = emulate(level, policy, regime=regime, budget=95)
            exps.append(res["expansions"])
            solved += res["success"]
        print("  regime=%-6s solved=%d/%d  mean_expansions=%.1f  max_expansions=%d" %
              (regime, solved, len(train["levels"]), sum(exps) / len(exps), max(exps)))

    # upper-bound diagnostic: expert first move revealed (removes the one
    # inherently unobservable coin flip at the start), budget raised to 300
    class _OracleFirst:
        def __init__(self, base, sols):
            self.base = base
            self.sols = sols

        def action_probs(self, level, state, legal_actions):
            probs = self.base.action_probs(level, state, legal_actions)
            if state.get("previous_action") is None:
                sol = self.sols.get(level.get("id"))
                if sol and sol[0] in probs:
                    probs = {a: (1.0 if a == sol[0] else 1e-6) for a in probs}
            return probs

    opol = _OracleFirst(policy, {l["id"]: l["solution"] for l in train["levels"]})
    solved_or = 0
    for level in train["levels"]:
        solved_or += emulate(level, opol, regime="dfs", budget=300)["success"]
    print("\n[0b] diagnostic (upper bound): DFS with oracle first move, budget=300: "
          "solved %d/260" % solved_or)

    print("\n[B] public eval levels under emulated search (budget=95):")
    for regime in ("greedy", "dfs", "best"):
        for level in ev["levels"]:
            res = emulate(level, policy, regime=regime, budget=95)
            print("  regime=%-6s %s success=%s expansions=%d path_len=%s" %
                  (regime, level["id"], res["success"], res["expansions"], res["path_len"]))


if __name__ == "__main__":
    _run_harness()
