for truth in ({"side_hi": 1, "c0": 1.90, "v": -1.70, "b": 0.03},
              {"side_hi": 2, "c0": -1.40, "v": -0.30, "b": 0.03}):
    for seed in (1, 2):
        rg = np.random.default_rng(100 + seed)
        ts_ = rg.uniform(0.0, float(t.max()), n_obs)
        xs_ = rg.uniform(x_min, x_max, n_obs)
        ys_ = rg.uniform(y_min, y_max, n_obs)
        ss_ = (xs_ + ys_) / np.sqrt(2.0); ws_ = (xs_ - ys_) / np.sqrt(2.0)
        cc_ = truth["c0"] + truth["v"] * ts_ + truth["b"] * ws_
        hi_ = float(levels[truth["side_hi"]])
        lo_ = float(levels[truth["side_hi"] - 1])
        uu_ = np.where(ss_ < cc_, hi_, lo_) + sigma_hat * rg.standard_normal(n_obs)
        c0e, ve, be, rmse = fit_line_params(ss_, ws_, ts_, uu_, hi_, lo_,
                                            float(np.mean([truth["c0"],
                                                           truth["c0"] + truth["v"] * t.max()])))
        synth["cases"].append({
            "plus_u_side_level": hi_, "seed": seed,
            "c0_error": float(c0e - truth["c0"]), "v_error": float(ve - truth["v"]),
            "b_error": float(be - truth["b"]), "fit_rms": rmse})
v_err = [abs(c["v_error"]) for c in synth["cases"]]
c_err = [abs(c["c0_error"]) for c in synth["cases"]]
synth["max_abs_speed_error"] = float(max(v_err))
synth["max_abs_position_error"] = float(max(c_err))
