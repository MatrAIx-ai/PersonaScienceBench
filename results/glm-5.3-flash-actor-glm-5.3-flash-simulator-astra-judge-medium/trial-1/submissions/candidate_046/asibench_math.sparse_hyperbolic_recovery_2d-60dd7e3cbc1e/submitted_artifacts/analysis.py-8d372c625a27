def _viridis(a):
    anchors = np.array([
        [0.267, 0.005, 0.329], [0.283, 0.141, 0.458], [0.254, 0.265, 0.530],
        [0.207, 0.372, 0.553], [0.164, 0.471, 0.558], [0.128, 0.567, 0.551],
        [0.135, 0.659, 0.518], [0.267, 0.749, 0.441], [0.478, 0.821, 0.318],
        [0.741, 0.873, 0.150], [0.993, 0.906, 0.144]])
    a = np.clip(a, 0, 1) * (len(anchors) - 1)
    i0 = np.clip(np.floor(a).astype(int), 0, len(anchors) - 2)
    f = a - i0
    return anchors[i0] * (1 - f[..., None]) + anchors[i0 + 1] * f[..., None]

def _write_png(rgb, path):
    import struct, zlib
    h, w_, _ = rgb.shape
    raw = b"".join(b"\x00" + rgb[i].tobytes() for i in range(h))
    def chunk(tag, data):
        c = struct.pack(">I", len(data)) + tag + data
        return c + struct.pack(">I", zlib.crc32(tag + data) & 0xFFFFFFFF)
    with open(path, "wb") as fh:
        fh.write(b"\x89PNG\r\n\x1a\n"
                 + chunk(b"IHDR", struct.pack(">IIBBBBB", w_, h, 8, 2, 0, 0, 0))
                 + chunk(b"IDAT", zlib.compress(raw, 6))
                 + chunk(b"IEND", b""))

def _draw_line(img, x0, y0, x1, y1, color):
    nseg = int(max(abs(x1 - x0), abs(y1 - y0))) + 1
    xs = np.round(np.linspace(x0, x1, nseg)).astype(int)
    ys = np.round(np.linspace(y0, y1, nseg)).astype(int)
    okd = (xs >= 0) & (xs < img.shape[1]) & (ys >= 0) & (ys < img.shape[0])
    img[ys[okd], xs[okd]] = color

