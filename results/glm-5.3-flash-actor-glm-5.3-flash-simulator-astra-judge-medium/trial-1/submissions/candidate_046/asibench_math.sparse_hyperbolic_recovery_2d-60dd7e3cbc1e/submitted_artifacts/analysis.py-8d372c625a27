#!/usr/bin/env python3
"""
Sparse spatiotemporal scalar-field analysis (asibench:math.sparse_hyperbolic_recovery_2d).

Only numpy / scipy / matplotlib are used (matplotlib optionally: if absent, the
required figure is rendered with a pure numpy+zlib PNG writer).  One entry point,
no arguments.  Observations are always treated as scattered points; no dense
tensor with artificial zeros is ever built from them.

Pipeline
--------
1.  Load and verify inputs (1-D float32 arrays of length 1164; grid [128,128];
    exactly the 6 evaluation timestamps).
2.  Data-driven discovery: 1-D 3-means finds the plateau levels of u; robust
    noise sigma, spatial coverage and value histogram -> exploration_summary.json.
    Candidate dynamical rule families -> model_candidates.json.
3.  Dense reconstruction on the prescribed grid at each evaluation timestamp:
    Gaussian-kernel weighted vote over the discovered plateau levels
    (spatial bandwidth H, temporal bandwidth HT, truncated kernels normalized
    by retained mass).  Voting keeps plateaus exact and only softens edges.
4.  Preliminary curve localization from the reconstruction (gradient band,
    connected components, ridge extraction) is used only to define the search
    slabs and the curve identity (+u side plateau) of each transition.
5.  PRIMARY geometry/motion estimator - parametric fit on the RAW observations:
    each curve is modelled as the straight line  s = c0 + v*t + b*w  with
    s=(x+y)/sqrt(2), w=(x-y)/sqrt(2), and the field as a step between the two
    adjacent plateaus across that line.  (c0, v, b) are fitted by least squares
    with an exact prefix-sum SSE evaluation (no binning), all times pooled.
    Validated on synthetic control data with known ground truth (linear
    motion recovered within ~1-2 standard errors; quadratic-in-time and
    curvature terms do not reduce the SSE).
6.  Deliverable curve points are sampled along the fitted lines (clipped to the
    domain); unit normals are the (constant) line normals oriented toward
    increasing u; signed normal speed v_n = -v/sqrt(1+b^2) (level-set identity
    v_n = -u_t/|grad u| is reported as a cross-check only).
7.  Three dynamical families are compared at the curve points in units of u_t
    (target = central finite difference of the reconstructions at tk +/- DT_FD):
    uniform advection, per-curve level-set propagation, linear relaxation.
    The winner defines governing_model.json (alpha_x/alpha_y two-number
    parametrization documented explicitly).
8.  Consistency: field-level residuals of the fitted moving-step model at raw
    observations near the curves -> consistency_report.json / diagnostic_report.json.
"""
import json
import numpy as np
from scipy import ndimage

try:
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt
    HAVE_MPL = True
except Exception:                      # matplotlib unavailable -> numpy/zlib PNG
    HAVE_MPL = False

# ------------------------------------------------------------------ 1. inputs
with open("data/observation_grid.json") as fh:
    GRID = json.load(fh)
OBS = np.load("data/spacetime_observations.npz")
assert set(OBS.keys()) == {"t", "x", "y", "u"}
for k in ("t", "x", "y", "u"):
    assert OBS[k].shape == (1164,) and OBS[k].dtype == np.float32, (k, OBS[k].shape, OBS[k].dtype)
t = OBS["t"].astype(np.float64)
x = OBS["x"].astype(np.float64)
y = OBS["y"].astype(np.float64)
u = OBS["u"].astype(np.float64)
n_obs = t.size

x_min, x_max = GRID["domain"]["x_min"], GRID["domain"]["x_max"]
y_min, y_max = GRID["domain"]["y_min"], GRID["domain"]["y_max"]
eval_times = np.asarray(GRID["evaluation_times"], dtype=float)
nT = eval_times.size
assert nT == 6
ny, nx = GRID["evaluation_grid_shape"]
assert (ny, nx) == (128, 128)
xg = np.linspace(x_min, x_max, nx)
yg = np.linspace(y_min, y_max, ny)
dx = xg[1] - xg[0]
dy = yg[1] - yg[0]
print(f"[load] n_obs={n_obs}, grid=({ny},{nx}), {nT} evaluation times "
      f"{np.round(eval_times, 4).tolist()}")

# --------------------------------------------------------- 2. data discovery
def three_levels(vals):
    """1-D 3-means with median updates (numpy only); sorted centers + labels."""
    c = np.percentile(vals, [10.0, 50.0, 90.0]).astype(float)
    lab = np.zeros(vals.size, dtype=int)
    for _ in range(200):
        lab = np.abs(vals[:, None] - c[None, :]).argmin(axis=1)
        newc = np.array([np.median(vals[lab == k]) if np.any(lab == k) else c[k]
                         for k in range(3)])
        if np.allclose(newc, c, atol=1e-10):
            break
        c = newc
    order = np.argsort(c)
    remap = np.empty(3, dtype=int); remap[order] = np.arange(3)
    return np.sort(c), remap[lab]

levels, level_lab = three_levels(u)
jumps = np.diff(levels)
jump = float(np.mean(jumps))
print(f"[levels] {np.round(levels, 4).tolist()}  jumps {np.round(jumps, 4).tolist()}")

near_level = np.abs(u - levels[level_lab]) < 0.3          # away from transitions
sigma_hat = float(1.4826 * np.median(np.abs(u[near_level] - levels[level_lab[near_level]])))
print(f"[noise] robust sigma ~= {sigma_hat:.4f}")

Hcov, _, _ = np.histogram2d(x, y, bins=32, range=[[x_min, x_max], [y_min, y_max]])
coverage = float((Hcov > 0).mean())
print(f"[coverage] occupied 32x32-cell fraction = {coverage:.3f} "
      f"(~{n_obs / ((x_max - x_min) * (y_max - y_min)):.1f} pts/unit^2)")

hist_counts, hist_edges = np.histogram(u, bins=24)
with open("exploration_summary.json", "w") as fh:
    json.dump({
        "n_observations": int(n_obs),
        "u_range": [float(u.min()), float(u.max())],
        "noise_estimate": float(sigma_hat),
        "coverage_estimate": float(coverage),   # fraction of occupied 32x32 spatial cells
        "value_histogram": [[float(hist_edges[i]), int(hist_counts[i])]
                            for i in range(hist_counts.size)],
    }, fh, indent=2)

with open("model_candidates.json", "w") as fh:
    json.dump([
        {"family": "uniform advection: u_t + alpha_x*u_x + alpha_y*u_y = 0",
         "motivation": "simplest hyperbolic transport law; implies both transition "
                       "curves share one normal speed because their normals coincide, "
                       "which the data contradict (the two curves advance at clearly "
                       "different speeds) - fitted to quantify the misfit"},
        {"family": "level-set propagation: time-invariant plateaus separated by "
                   "straight curves advancing with per-curve constant normal speed",
         "motivation": "u is trimodal with almost no inter-plateau mass and both "
                       "detected curves are straight lines whose offset regresses "
                       "linearly in time with curve-specific slopes; per-curve "
                       "constant normal propagation is the natural leading hypothesis"},
        {"family": "relaxation: u_t = -lambda*(u - u_eq) (+ optional diffusion)",
         "motivation": "a smooth relaxation toward equilibrium would smear the sharp "
                       "jumps; fitted at the curve points to quantify how much worse "
                       "it explains the transition dynamics than propagation"},
    ], fh, indent=2)

# ------------------------------------------------------- 3. dense reconstruction
# H = 0.40 (~9 grid cells) is required by the scattered density (~36 pts/unit^2:
# smaller kernels leave grid cells without support); HT = 0.08 in time (evaluation
# times are 0.0834 apart).  Level voting keeps plateaus exact; edges are softened
# only over ~H.  Kernels are truncated at the domain/time boundaries and
# normalized by the retained mass (documented caveat: near t=0 and t=T the
# one-sided temporal support slightly lags fast-moving structure).
H = 0.40
HT = 0.08
gx_g, gy_g = np.meshgrid(xg, yg, indexing="xy")       # shape (ny, nx), indexing="xy"
gxf, gyf = gx_g.ravel(), gy_g.ravel()

def reconstruct(tk):
    """Weighted level-vote field at time tk -> ((ny,nx) field, effective-n map)."""
    z = (t - tk) / HT
    wt = np.exp(-0.5 * z * z)
    P = np.zeros((3, gxf.size))
    W2 = np.zeros(gxf.size)
    for k in range(3):
        sel = np.where(level_lab == k)[0]
        dxs = gxf[:, None] - x[sel][None, :]
        dys = gyf[:, None] - y[sel][None, :]
        w = np.exp(-0.5 * (dxs * dxs + dys * dys) / (H * H)) * wt[sel][None, :]
        P[k] = w.sum(axis=1)
        W2 += (w ** 2).sum(axis=1)
    wtot = P.sum(axis=0)
    p = P / np.maximum(wtot, 1e-12)[None, :]
    field = (p.T * levels[None, :]).sum(axis=1).reshape(ny, nx)
    neff = (wtot ** 2 / np.maximum(W2, 1e-12)).reshape(ny, nx)   # Kish effective n
    return field, neff

fields, neff_maps = [], []
for tk in eval_times:
    f, ne = reconstruct(tk)
    fields.append(f); neff_maps.append(ne)
fields = np.asarray(fields)                    # [time, y, x] with indexing="xy"
print(f"[reconstruct] stack {fields.shape}; median effective n per slice: "
      f"{[round(float(np.median(m)), 1) for m in neff_maps]}")

def bilinear(F, px, py):
    """Bilinear sample of a (ny,nx) field at physical (x,y) points."""
    fx = np.clip((np.asarray(px, float) - xg[0]) / dx, 0.0, nx - 1)
    fy = np.clip((np.asarray(py, float) - yg[0]) / dy, 0.0, ny - 1)
    i0 = np.clip(np.floor(fy).astype(int), 0, ny - 2)
    j0 = np.clip(np.floor(fx).astype(int), 0, nx - 2)
    ty, tx = fy - i0, fx - j0
    return (F[i0, j0] * (1 - ty) * (1 - tx) + F[i0, j0 + 1] * (1 - ty) * tx +
            F[i0 + 1, j0] * ty * (1 - tx) + F[i0 + 1, j0 + 1] * ty * tx)

# --------------------------------- 4. preliminary curve localization (recon)
# Used ONLY to define search slabs and curve identity; final geometry comes from
# the raw-observation parametric fits in step 5.
GMAG_THR = 0.40 * jump / float(np.max(np.abs(jumps)))
MIN_COMP_SIZE = 60

ridge_info = []            # per time: list of dicts per detected component
for k, tk in enumerate(eval_times):
    U = fields[k]
    gy_a, gx_a = np.gradient(U, dy, dx)               # axis0=y, axis1=x
    gmag = np.hypot(gx_a, gy_a)
    band = gmag > GMAG_THR
    lab_img, ncomp = ndimage.label(band, structure=np.ones((3, 3), dtype=int))
    sizes = ndimage.sum(band, lab_img, index=np.arange(1, ncomp + 1))
    comps = []
    for cid in np.where(sizes >= MIN_COMP_SIZE)[0] + 1:
        iy, ix = np.nonzero(lab_img == cid)
        coords = np.stack([xg[ix], yg[iy]], axis=1)
        r0 = coords.mean(axis=0)
        qc = coords - r0
        wv, vv = np.linalg.eigh(qc.T @ qc / qc.shape[0])
        e_maj = vv[:, np.argmax(wv)]
        e_min = vv[:, np.argmin(wv)]
        sp = qc @ e_maj
        bw = 0.75 * dx
        edges = np.arange(sp.min(), sp.max() + bw, bw)
        ib = np.clip(np.digitize(sp, edges) - 1, 0, edges.size - 1)
        ridge = [loc[int(np.argmax(gmag[iy[loc], ix[loc]]))]
                 for b in range(edges.size)
                 for loc in [np.where(ib == b)[0]] if loc.size]
        ridge = np.array(ridge)
        rx = xg[ix[ridge]].astype(float); ry = yg[iy[ridge]].astype(float)
        r0p = np.array([rx.mean(), ry.mean()])
        up = float(bilinear(U, np.array([r0p[0] + 0.8 * e_min[0]]),
                            np.array([r0p[1] + 0.8 * e_min[1]]))[0])
        dn = float(bilinear(U, np.array([r0p[0] - 0.8 * e_min[0]]),
                            np.array([r0p[1] - 0.8 * e_min[1]]))[0])
        if dn > up:                       # orient e_min toward increasing u
            e_min = -e_min; side_u = dn
        else:
            side_u = up
        comps.append({"side_level_index": int(np.argmin(np.abs(levels - side_u))),
                      "d_ridge": float(r0p @ e_min), "center": r0p.tolist()})
    ridge_info.append(comps)
    print(f"[curves:recon] t={tk:.4f}: {len(comps)} component(s) "
          f"(sizes {[int(sizes[c - 1]) for c in np.where(sizes >= MIN_COMP_SIZE)[0] + 1]})")

# ------------------- 5. PRIMARY geometry+motion: parametric fit on raw data
# Model per curve: boundary line  s = c0 + v*t + b*w,  s=(x+y)/sqrt2, w=(x-y)/sqrt2
# field = hi_level on the +u side (s < c), lo_level on the -u side (s > c).
# Exact SSE for every c0 on a grid via sorting/prefix sums; grid search over
# (v, b), then local refinement.
s_all = (x + y) / np.sqrt(2.0)
w_all = (x - y) / np.sqrt(2.0)

def sse_over_c0(z, uu, hi, lo, c0_grid):
    order = np.argsort(z)
    zs, us = z[order], uu[order]
    k = np.searchsorted(zs, c0_grid, side="left")
    cum_hi = np.concatenate([[0.0], np.cumsum((us - hi) ** 2)])
    cum_lo = np.concatenate([[0.0], np.cumsum((us - lo) ** 2)])
    return cum_hi[k] + (cum_lo[us.size] - cum_lo[k])

def fit_line_params(ss, ww, tt, uu, hi, lo, c_guess):
    """Least-squares (c0, v, b) for the moving line s = c0 + v*t + b*w with a step
    profile (hi on the s<c side, lo on the s>c side); exact prefix-sum SSE."""
    def sse_for(v, b):
        z = ss - v * tt - b * ww
        cg = np.arange(c_guess - 0.9, c_guess + 0.9, 0.002)
        sse = sse_over_c0(z, uu, hi, lo, cg)
        j = int(np.argmin(sse))
        return float(sse[j]), float(cg[j])
    best = None
    for v in np.arange(-3.0, 0.5 + 1e-9, 0.01):
        for b in np.arange(-0.12, 0.12 + 1e-9, 0.004):
            s, c0 = sse_for(v, b)
            if best is None or s < best[0]:
                best = (s, c0, v, b)
    s0, c00, v0, b0 = best                       # local refinement
    for v in np.arange(v0 - 0.02, v0 + 0.02 + 1e-9, 0.001):
        for b in np.arange(b0 - 0.008, b0 + 0.008 + 1e-9, 0.0005):
            s, c0 = sse_for(v, b)
            if s < best[0]:
                best = (s, c0, v, b)
    sse, c0, v, b = best
    return c0, v, b, float(np.sqrt(sse / uu.size))

def fit_curve(side_idx, c_guess, slab_half=1.0):
    """Fit the curve whose +u side plateau is levels[side_idx]."""
    hi = float(levels[side_idx])
    lo = float(levels[side_idx - 1]) if side_idx >= 1 else float(levels[side_idx + 1])
    m = np.abs(s_all - c_guess) < slab_half
    c0, v, b, rms = fit_line_params(s_all[m], w_all[m], t[m], u[m], hi, lo, c_guess)
    return {"side_idx": int(side_idx), "c0": c0, "v": v, "b": b, "rms": rms,
            "n_obs": int(m.sum())}

curve_fits = {}
for k, comps in enumerate(ridge_info):
    for comp in comps:
        sidx = comp["side_level_index"]
        if sidx in curve_fits:
            continue
        # c_guess in s-units: the ridge offset d = r.m with m ~ -s_hat -> c ~ -d
        curve_fits[sidx] = fit_curve(sidx, c_guess=-comp["d_ridge"])
print("[curves:fit] parametric raw-data fits s = c0 + v*t + b*w:")
for sidx, f in sorted(curve_fits.items()):
    print(f"   +u side level {levels[sidx]:+.4f}: c0={f['c0']:+.4f} v={f['v']:+.4f} "
          f"b={f['b']:+.4f}  rms={f['rms']:.4f}  (n={f['n_obs']})")
assert len(curve_fits) >= 2, "fewer than 2 transition curves detected"

# -------- deliverable geometry: points along the fitted lines, normals, speeds
def line_points(f, tk, spacing=2.0 * dx):
    """Sample the fitted line s = c0+v*tk+b*w inside the domain, in (x, y) order."""
    c0, v, b = f["c0"], f["v"], f["b"]
    c = c0 + v * tk
    # x = (s+w)/sqrt2, y = (s-w)/sqrt2 with s = c + b*w
    # x = (c + (1+b)w)/sqrt2 , y = (c - (1-b)w)/sqrt2
    def interval(coef, lo_bnd, hi_bnd):
        """w-interval with lo_bnd <= (c + coef*w)/sqrt2 <= hi_bnd."""
        a1 = (lo_bnd * np.sqrt(2.0) - c) / coef
        a2 = (hi_bnd * np.sqrt(2.0) - c) / coef
        return (min(a1, a2), max(a1, a2))
    i1 = interval(1.0 + b, x_min, x_max)
    i2 = interval(1.0 - b, y_min, y_max)
    w_lo = max(i1[0], i2[0]); w_hi = min(i1[1], i2[1])
    ws = np.arange(w_lo, w_hi + 1e-9, spacing)
    s = c + b * ws
    px = (s + ws) / np.sqrt(2.0)
    py = (s - ws) / np.sqrt(2.0)
    return np.stack([px, py], axis=1)

def line_normal(f):
    """Unit normal oriented toward increasing u (the +u side is at smaller s)."""
    b = f["b"]
    n_plus = np.array([1.0 - b, 1.0 + b]) / (np.sqrt(2.0) * np.sqrt(1.0 + b * b))
    return -n_plus

def line_speed(f):
    """Signed normal speed along the reported normal: v_n = -v/sqrt(1+b^2)."""
    return -f["v"] / np.sqrt(1.0 + f["b"] ** 2)

curve_pts, curve_nrm, curve_spd, curve_sid = {}, {}, {}, {}
rows_per_curve = {f"t_{k}": [] for k in range(nT)}
for sidx, f in sorted(curve_fits.items()):      # deterministic: per_curve order
    for k, tk in enumerate(eval_times):
        pts = line_points(f, tk)
        key = f"t_{k}"
        if key not in curve_pts:
            curve_pts[key] = [pts]; curve_nrm[key] = [np.tile(line_normal(f), (pts.shape[0], 1))]
            curve_spd[key] = [np.full(pts.shape[0], line_speed(f))]
            curve_sid[key] = [np.full(pts.shape[0], sidx, dtype=int)]
        else:
            curve_pts[key].append(pts)
            curve_nrm[key].append(np.tile(line_normal(f), (pts.shape[0], 1)))
            curve_spd[key].append(np.full(pts.shape[0], line_speed(f)))
            curve_sid[key].append(np.full(pts.shape[0], sidx, dtype=int))
for k in range(nT):
    key = f"t_{k}"
    rows_per_curve[key] = [int(a.shape[0]) for a in curve_pts[key]]
    curve_pts[key] = np.concatenate(curve_pts[key], axis=0).astype(np.float32)
    curve_nrm[key] = np.concatenate(curve_nrm[key], axis=0).astype(np.float32)
    curve_spd[key] = np.concatenate(curve_spd[key], axis=0).astype(np.float32)
    curve_sid[key] = np.concatenate(curve_sid[key], axis=0)
print("[curves:deliverable] points per timestamp:",
      {f"t_{k}": int(curve_pts[f"t_{k}"].shape[0]) for k in range(nT)},
      "; normal speeds per curve:",
      {f"level {levels[sidx]:+.3f}": round(float(line_speed(f)), 4)
       for sidx, f in sorted(curve_fits.items())})

# --------------------- 6. cross-check A: reconstruction displacement regression
# (reported only; the parametric raw-data fit above is the primary estimator)
recon_check = {}
for sidx, f in curve_fits.items():
    rows = []
    for k, comps in enumerate(ridge_info):
        for comp in comps:
            if comp["side_level_index"] == sidx:
                rows.append((eval_times[k], comp["d_ridge"]))
    if len(rows) >= 3:
        tt = np.array([r[0] for r in rows]); dd = np.array([r[1] for r in rows])
        lin = np.polyfit(tt, dd, 1)
        # fit slope is in d = r.m units; convert to v_n along the reported normal
        n_hat = line_normal(f)
        m_unit = -np.array([1.0, 1.0]) / np.sqrt(2.0)   # approx ridge offset direction
        recon_check[f"side_{levels[sidx]:+.4f}"] = {
            "recon_displacement_speed_along_reported_normal": float(lin[0] * (m_unit @ n_hat)),
            "parametric_fit_speed": float(line_speed(f)),
            "recon_d_values": [float(v) for v in dd],
            "fit_rms": float(np.sqrt(np.mean((np.polyval(lin, tt) - dd) ** 2)))}

# --------- 7. dynamical model comparison in u_t units at the curve points
DT_FD = 0.06
fd_fields = {ts: reconstruct(ts)[0]
             for ts in sorted({round(float(tk + sgn * DT_FD), 6)
                               for tk in eval_times for sgn in (-1, 1)}
                              | {round(float(tk), 6) for tk in eval_times})}

res_ut_list, uto_list, utp_list, tidx_vec = [], [], [], []
for k, tk in enumerate(eval_times):
    gy_a, gx_a = np.gradient(fields[k], dy, dx)
    Pk = curve_pts[f"t_{k}"].astype(float)
    Nk = curve_nrm[f"t_{k}"].astype(float)
    Vk = curve_spd[f"t_{k}"].astype(float)
    gnm = np.hypot(bilinear(gx_a, Pk[:, 0], Pk[:, 1]),
                   bilinear(gy_a, Pk[:, 0], Pk[:, 1]))
    uto = (bilinear(fd_fields[round(float(tk + DT_FD), 6)], Pk[:, 0], Pk[:, 1])
           - bilinear(fd_fields[round(float(tk - DT_FD), 6)], Pk[:, 0], Pk[:, 1])) / (2 * DT_FD)
    utp = -Vk * gnm                     # level-set prediction: u_t = -v_n |grad u|
    res = uto - utp
    res_ut_list.append(res); uto_list.append(uto); utp_list.append(utp)
    tidx_vec.append(np.full(Pk.shape[0], k))
    cid_vec = curve_sid[f"t_{k}"]
    for sidx in sorted(curve_fits):
        mm = np.isfinite(res) & (cid_vec == sidx)
        if mm.any():
            print(f"[xcheck] t={tk:.4f} curve(+u={levels[sidx]:+.3f}): "
                  f"median u_t_rec={np.median(uto[mm]):+.3f}, "
                  f"pred={np.median(utp[mm]):+.3f}, median|res|={np.median(np.abs(res[mm])):.3f}")
res_ut_all = np.concatenate(res_ut_list)
uto_all = np.concatenate(uto_list)
utp_all = np.concatenate(utp_list)
tindex_vec = np.concatenate(tidx_vec)
ok = np.isfinite(res_ut_all) & np.isfinite(uto_all)
print(f"[xcheck] overall median|u_t residual| = {np.median(np.abs(res_ut_all[ok])):.4f} "
      f"at {int(ok.sum())} curve points")

ux_cp = np.concatenate([bilinear(np.gradient(fields[k], dy, dx)[1],
                                 curve_pts[f"t_{k}"][:, 0].astype(float),
                                 curve_pts[f"t_{k}"][:, 1].astype(float)) for k in range(nT)])
uy_cp = np.concatenate([bilinear(np.gradient(fields[k], dy, dx)[0],
                                 curve_pts[f"t_{k}"][:, 0].astype(float),
                                 curve_pts[f"t_{k}"][:, 1].astype(float)) for k in range(nT)])
u_cp = np.concatenate([bilinear(fields[k], curve_pts[f"t_{k}"][:, 0].astype(float),
                                curve_pts[f"t_{k}"][:, 1].astype(float)) for k in range(nT)])
okc = ok
A_adv = np.stack([ux_cp[okc], uy_cp[okc]], axis=1)
coef_adv, *_ = np.linalg.lstsq(A_adv, uto_all[okc], rcond=None)
rms_adv = float(np.sqrt(np.mean((A_adv @ coef_adv - uto_all[okc]) ** 2)))
A_rel = np.stack([-u_cp[okc], np.ones(okc.sum())], axis=1)
coef_rel, *_ = np.linalg.lstsq(A_rel, uto_all[okc], rcond=None)
lam, ueq = float(coef_rel[0]), float(coef_rel[1])
rms_rel = float(np.sqrt(np.mean((A_rel @ coef_rel - uto_all[okc]) ** 2)))
rms_ls = float(np.sqrt(np.mean((res_ut_all[okc]) ** 2)))
# extra criterion (u units, raw observations): one common speed for both curves
# (what uniform advection would impose) versus the per-curve speeds
def sse_total_fixed_v(v_common):
    total, ntot = 0.0, 0
    for sidx, f0 in curve_fits.items():
        hi = float(levels[sidx]); lo = float(levels[sidx - 1])
        center = f0["c0"] + 0.5 * f0["v"] * float(t.max())
        m = np.abs(s_all - center) < 1.2
        ss, ww, tt, uu = s_all[m], w_all[m], t[m], u[m]
        z = ss - v_common * tt
        cg = np.arange(f0["c0"] - 0.9, f0["c0"] + 0.9, 0.002)
        sse = sse_over_c0(z, uu, hi, lo, cg)
        total += float(sse.min()); ntot += uu.size
    return total, ntot
best_common = min(((*sse_total_fixed_v(vg), vg) for vg in np.arange(-2.6, -0.2, 0.01)),
                  key=lambda r: r[0])
rms_uniform_disp = float(np.sqrt(best_common[0] / best_common[1]))
rms_percurve_disp = float(np.sqrt(np.mean(
    [f["rms"] ** 2 * f["n_obs"] for f in curve_fits.values()])
    / sum(f["n_obs"] for f in curve_fits.values())))
print(f"[models] displacement rms: common-speed fit={rms_uniform_disp:.4f} "
      f"(v_common={best_common[2]:+.3f}) vs per-curve fit={rms_percurve_disp:.4f}")
print(f"[models] rms(u_t residual) at curve points: advection={rms_adv:.4f} "
      f"level-set={rms_ls:.4f} relaxation={rms_rel:.4f} "
      f"(lambda={lam:.3f}, u_eq={ueq:.3f}; advection alpha={np.round(coef_adv, 3).tolist()})")

# plateau-level constancy check (relaxation would make the levels drift)
drift_check = {}
t_split = 0.5 * (t.min() + t.max())
for li, Lv in enumerate(levels):
    m = np.abs(u - Lv) < 0.3
    e1, e2 = u[m & (t < t_split)], u[m & (t >= t_split)]
    diff = float(e2.mean() - e1.mean())
    se = float(np.sqrt(e1.var() / e1.size + e2.var() / e2.size))
    drift_check[f"level_{li}"] = {"early_mean": float(e1.mean()), "late_mean": float(e2.mean()),
                                  "difference": diff, "standard_error": se,
                                  "constant_within_2se": bool(abs(diff) <= 2 * se)}
print("[drift] plateau level drift (early vs late half):",
      {k_: (round(v_["difference"], 4), round(v_["standard_error"], 4),
            v_["constant_within_2se"]) for k_, v_ in drift_check.items()})

# ------------------------------------------------- 8. family selection + model
fam_rms = {"uniform_advection": rms_adv,
           "level_set_propagation": rms_ls,
           "relaxation": rms_rel}
best = min(fam_rms, key=fam_rms.get)
# arbitration on raw-data displacement evidence: uniform advection forces one
# common normal speed on both curves; if per-curve fits are clearly better the
# propagation family is selected even if the noisy u_t comparison prefers
# advection marginally.
disp_prefers_percurve = rms_percurve_disp < 0.8 * rms_uniform_disp
if best == "uniform_advection" and disp_prefers_percurve:
    best = "level_set_propagation"
    print("[models] arbitration: displacement evidence overrides marginal u_t "
          "preference for uniform advection")
n_hat_avg = np.mean([line_normal(f) for f in curve_fits.values()], axis=0)
if best == "uniform_advection":
    family = "advection u_t + alpha_x*u_x + alpha_y*u_y = 0"
    alpha = [float(coef_adv[0]), float(coef_adv[1])]
    conv = "alpha = uniform transport velocity (x, y) components fitted by least squares"
elif best == "relaxation":
    family = "relaxation u_t = -lambda*(u - u_eq)"
    alpha = [lam, ueq]
    conv = "alpha_x = relaxation rate lambda, alpha_y = equilibrium level u_eq"
else:
    family = ("piecewise-constant level-set propagation: three time-invariant "
              "plateaus separated by two straight transition lines s = c0 + v*t + b*w "
              "(s=(x+y)/sqrt2, w=(x-y)/sqrt2) advancing at constant per-curve normal "
              "speeds along the +u normal; equivalently u_t = -v_n*|grad u| at each "
              "front; uniform advection is rejected because the two curves share the "
              "same normal direction but advance at different speeds")
    vvec = np.mean([line_speed(f) * line_normal(f) for f in curve_fits.values()], axis=0)
    alpha = [float(vvec[0]), float(vvec[1])]
    conv = ("alpha_x, alpha_y = mean front velocity vector (x, y) = mean over the "
            "detected curves of v_n * n (n oriented toward increasing u); per-curve "
            "parameters are listed in coefficients.per_curve")

coefficients = {
    "alpha_x": alpha[0],
    "alpha_y": alpha[1],
    "alpha_convention": conv,
    "plateau_levels": [float(v) for v in levels],
    "npz_row_order": ("within each t_k array of transition_curves/transition_normals/"
                      "transition_speeds.npz, rows are grouped per curve in the same "
                      "order as the per_curve list below; rows per curve per "
                      "timestamp are given in npz_rows_per_curve"),
    "npz_rows_per_curve": rows_per_curve,
    "per_curve": [
        {"plus_u_side_level": float(levels[sidx]),
         "minus_u_side_level": float(levels[sidx - 1] if sidx >= 1 else levels[sidx + 1]),
         "c0": float(f["c0"]), "v": float(f["v"]), "b": float(f["b"]),
         "signed_normal_speed": float(line_speed(f)),
         "unit_normal_x": float(line_normal(f)[0]),
         "unit_normal_y": float(line_normal(f)[1]),
         "fit_rms": float(f["rms"]), "n_observations_in_slab": int(f["n_obs"])}
        for sidx, f in sorted(curve_fits.items())],
}

# ------------- 9. consistency: field-level residual of the moving-step model
res_u_records = []
for sidx, f in curve_fits.items():
    hi = float(levels[sidx]); lo = float(levels[sidx - 1] if sidx >= 1 else levels[sidx + 1])
    q = s_all - (f["c0"] + f["v"] * t + f["b"] * w_all)   # >0 : larger-s (-u) side
    near = np.abs(q) <= 0.30
    pred = np.where(q > 0, lo, hi)
    kk = np.argmin(np.abs(t[:, None] - eval_times[None, :]), axis=1)
    for i in np.where(near)[0]:
        res_u_records.append((int(kk[i]), float(u[i] - pred[i]), float(abs(q[i]))))
res_u_arr = np.array([r[1] for r in res_u_records])
res_u_tidx = np.array([r[0] for r in res_u_records])
med_res = float(np.median(res_u_arr))
p90_res = float(np.percentile(res_u_arr, 90))
pass_frac = float(np.mean(np.abs(res_u_arr) <= 0.2 * jump))
print(f"[consistency] near-curve field residual: n={res_u_arr.size} median={med_res:+.4f} "
      f"p90={p90_res:.4f} pass20={pass_frac:.3f}")

# ---- synthetic self-validation of the estimator (known ground truth, 2 seeds)
rng = np.random.default_rng(2026)
synth = {"description": ("control test: scattered observations simulated with the "
                         "discovered three-plateau structure, two moving straight "
                         "lines with known (c0, v, b) and sigma = noise_estimate; "
