#!/usr/bin/env python3
"""
Deterministic state-estimation audit for data/measurements.npz.

1. Inspect the NPZ (arrays, timing, masks); no fixed clean sensor model assumed.
2. Reference trajectory (error PROXY, ground truth not public) = consensus of
   the forward particle filter and a time-reversed twin run (same model,
   dt -> -dt, stream processed backwards).
3. Bootstrap particle filter (N=1500, seed=0, weights always in log space):
   state = [px,py,vx,vy,b_r,b_theta]; CV dynamics + adaptively boosted process
   noise; measurement = [range, wrapped bearing] w.r.t. sensor at origin;
   likelihood = per-channel Gaussian core (0.9) + wide tail (0.1); missing
   channels (mask==False) are skipped -- no imputation, no synthetic data.
4. Adaptive systematic resampling (ESS < 0.5 N).
5. Required artifacts under results/ with strict NaN/inf sanitization.
"""
import json
import os

import numpy as np
try:
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt
    HAVE_MPL = True
except Exception:
    HAVE_MPL = False   # overview.png is then rendered by the built-in PNG writer
from scipy.special import logsumexp

SEED = 0
N_PART = 1500                # <= 1500 as required
DATA_PATH = "data/measurements.npz"
RESULTS_DIR = "results"

SIG_R = 0.07                 # range measurement noise (2nd-diff proxy ~0.02, conservative)
SIG_TH = 0.015               # bearing measurement noise (proxy ~0.004 rad, conservative)
SIG_A = 0.02                 # base acceleration noise per axis per step
SIG_B = 0.002                # bias random-walk std per step
TAIL_MULT = 8.0              # wide-tail component width multiplier
CORE_W = 0.9                 # mixture weight of the Gaussian core
Q_BOOST = 6.0               # process-noise boost factor during detected maneuvers
Q_DECAY = 0.70               # decay of the boost factor per calm step
ESS_FRAC_RESAMPLE = 0.5      # resample when ESS < 0.5 N
JIT_POS = 0.002              # roughening after resampling (positions)
JIT_VEL = 0.008              # roughening after resampling (velocities)
LOG_W_FLOOR = -700.0         # finite floor for normalized log-weights


def wrap_pi(a):
    return (a + np.pi) % (2.0 * np.pi) - np.pi


def sanitize(x, fallback=0.0):
    x = float(x)
    return x if np.isfinite(x) else fallback


def chan_mix(resid, sig):
    """Log-likelihood of a Gaussian-core + wide-tail mixture."""
    s_t = TAIL_MULT * sig
    lpc = -0.5 * (resid / sig) ** 2 - np.log(sig) - 0.5 * np.log(2 * np.pi)
    lpt = -0.5 * (resid / s_t) ** 2 - np.log(s_t) - 0.5 * np.log(2 * np.pi)
    mix = np.logaddexp(np.log(CORE_W) + lpc, np.log(1 - CORE_W) + lpt)
    core_share = np.exp(lpc - mix)
    return mix, core_share


# ----------------------------------------------------------------------------
# 1. Load and inspect
# ----------------------------------------------------------------------------
d = np.load(DATA_PATH, allow_pickle=True)
Y = np.asarray(d["Y"], dtype=float)
t = np.asarray(d["t"], dtype=float)
mask = np.asarray(d["mask"], dtype=bool)
try:
    meta = json.loads(str(d["metadata"]))
except Exception:
    meta = {}
DT = float(meta.get("dt", float(np.median(np.diff(t)))))
T_N = len(t)

wrap_events = [k + 1 for k in range(T_N - 1)
               if mask[k, 1] and mask[k + 1, 1]
               and abs(Y[k + 1, 1] - Y[k, 1]) > np.pi]
angle_wrap_event_count = len(wrap_events)
angle_wrapping_detected = angle_wrap_event_count > 0

# ----------------------------------------------------------------------------
# 2. Bootstrap particle filter: forward run + time-reversed twin run.
#    The reference trajectory (error PROXY, no public ground truth) is the
#    consensus (mean) of the forward filter and the time-reversed twin
#    (same model, dt -> -dt, data processed backwards). The NEES proxy uses the
#    filter's OWN weighted particle covariance (auto-consistency).
# ----------------------------------------------------------------------------
def run_pf(seed, reverse=False):
    """Bootstrap PF on state [px,py,vx,vy,b_r,b_theta].

    reverse=True processes the stream backwards with dt -> -dt; the velocity
    components keep their physical forward-time meaning because pos_{k-1} =
    pos_k - dt*v_k under the reversed transition.
    """
    rng = np.random.default_rng(seed)
    order = range(T_N - 1, -1, -1) if reverse else range(T_N)
    dt = -DT if reverse else DT
    F6 = np.eye(6)
    F6[0, 2] = dt
    F6[1, 3] = dt
    Q_BASE = SIG_A**2 * np.array([[dt**4/4, 0, dt**3/2, 0],
                                  [0, dt**4/4, 0, dt**3/2],
                                  [dt**3/2, 0, dt**2, 0],
                                  [0, dt**3/2, 0, dt**2]])
    # Expected per-channel NLL of the core+tail mixture, calibrated by MC
    # (chan_mix is scale-invariant, so one calibration serves both channels).
    _M = 200000
    _z = np.where(rng.random(_M) < CORE_W, rng.normal(0, 1, _M),
                  rng.normal(0, TAIL_MULT, _M))
    exp_nll = float(-np.mean(chan_mix(_z, 1.0)[0]))

    # anchor step (first/last step with both channels valid)
    i0 = T_N - 1 if reverse else 0
    step = -1 if reverse else 1
    while not mask[i0].all():
        i0 += step
    p0 = np.array([Y[i0, 0] * np.cos(Y[i0, 1]), Y[i0, 0] * np.sin(Y[i0, 1])])

    parts = np.zeros((N_PART, 6))
    parts[:, 0] = p0[0] + rng.normal(0, 0.10, N_PART)
    parts[:, 1] = p0[1] + rng.normal(0, 0.10, N_PART)
    parts[:, 2] = rng.normal(0, 0.25, N_PART)
    parts[:, 3] = rng.normal(0, 0.25, N_PART)
    logw = np.full(N_PART, -np.log(N_PART))

    mean_arr = np.zeros((T_N, 4))
    cov_arr = np.zeros((T_N, 4))
    diag = {k: np.zeros(T_N) for k in
            ["rmse_pos", "rmse_vel", "nees", "ess", "resampled", "weight_entropy",
             "max_log_weight", "min_log_weight", "bearing_residual_mean",
             "bearing_residual_std", "q_scale", "mean_nll"]}
    q_scale, sigma_mult, alarm = 1.0, 1.0, 0
    q_active_steps, mix36 = [], {}

    for k in order:
        Qk = np.zeros((6, 6))
        Qk[:4, :4] = (q_scale**2) * Q_BASE
        Qk[4:, 4:] = SIG_B**2 * np.eye(2)
        parts = parts @ F6.T + rng.multivariate_normal(np.zeros(6), Qk, N_PART)

        avail = mask[k]
        r_pred = np.hypot(parts[:, 0], parts[:, 1])
        b_pred = wrap_pi(np.arctan2(parts[:, 1], parts[:, 0]))
        mean_nll = 0.0
        if avail.any():
            ll = np.zeros(N_PART)
            n_ch = 0
            if avail[0]:
                m, share = chan_mix(Y[k, 0] - (r_pred + parts[:, 4]),
                                    SIG_R * sigma_mult)
                ll += m; n_ch += 1
                if k == 36 and not reverse:
                    mix36["range"] = float(np.mean(share))
            if avail[1]:
                m, share = chan_mix(wrap_pi(Y[k, 1] - (b_pred + parts[:, 5])),
                                    SIG_TH * sigma_mult)
                ll += m; n_ch += 1
                if k == 36 and not reverse:
                    mix36["bearing"] = float(np.mean(share))
            mean_nll = float(-np.mean(ll) / max(n_ch, 1))
            logw = logw + ll

        logw = logw - logsumexp(logw)
        logw = np.maximum(logw, LOG_W_FLOOR)
        w = np.exp(logw)
        w = w / w.sum()

        surprise = mean_nll - exp_nll
        if surprise > 1.0:
            alarm += 1
        else:
            alarm = max(0, alarm - 1)
        if alarm >= 2:
            q_scale = min(Q_BOOST, max(q_scale, 1.0) * 1.8)
        else:
            q_scale = max(1.0, q_scale * Q_DECAY)
        sigma_mult = min(2.0, max(1.0, sigma_mult * (1.05 if alarm >= 2 else 0.93)))

        mean = w @ parts
        dev = parts - mean
        cov = (w[:, None] * dev).T @ dev
        mean_arr[k] = mean[:4]
        cov_arr[k] = np.clip(np.diag(cov)[:4], 1e-12, None)

        # --- weight statistics BEFORE any resampling (post-update weights) ---
        ess_k = 1.0 / np.sum(w**2)
        pw = w[w > 0]
        entropy_k = -float(np.sum(pw * np.log(pw)))
        maxlw_k = float(np.max(logw))
        minlw_k = float(np.min(logw))

        # --- adaptive resampling (both directions; keeps the twin run alive) ---
        did_resample = 0.0
        if ess_k < ESS_FRAC_RESAMPLE * N_PART:
            idx = rng.choice(N_PART, size=N_PART, replace=True, p=w)
            parts = parts[idx]
            logw = np.full(N_PART, -np.log(N_PART))
            parts[:, :2] += rng.normal(0, JIT_POS, (N_PART, 2))
            parts[:, 2:4] += rng.normal(0, JIT_VEL, (N_PART, 2))
            did_resample = 1.0

        if not reverse:
            diag["mean_nll"][k] = mean_nll
            diag["q_scale"][k] = q_scale
            if q_scale > 1.5:
                q_active_steps.append(k)
            diag["ess"][k] = ess_k
            diag["resampled"][k] = did_resample
            diag["weight_entropy"][k] = entropy_k
            diag["max_log_weight"][k] = maxlw_k
            diag["min_log_weight"][k] = minlw_k
            if avail[1]:
                rb = wrap_pi(Y[k, 1] - (b_pred + parts[:, 5]))
                mu = float(w @ rb)
                diag["bearing_residual_mean"][k] = mu
                diag["bearing_residual_std"][k] = float(
                    np.sqrt(max(np.sum(w * rb**2) - mu**2, 0.0)))
            else:
                # documented finite fallback: 0.0 when the angular channel is missing
                diag["bearing_residual_mean"][k] = 0.0
                diag["bearing_residual_std"][k] = 0.0

    return mean_arr, cov_arr, diag, q_active_steps, mix36

fwd_mean, fwd_cov, diag, q_active_steps, mix36 = run_pf(SEED, reverse=False)
bwd_mean, bwd_cov, _, _, _ = run_pf(SEED + 1, reverse=True)

# innovation goodness-of-fit of the forward filter against the raw data
_r_pred = np.hypot(fwd_mean[:, 0], fwd_mean[:, 1])
_b_pred_m = np.arctan2(fwd_mean[:, 1], fwd_mean[:, 0])
_dr = np.where(mask[:, 0], Y[:, 0] - _r_pred, np.nan)
_db = np.where(mask[:, 1], wrap_pi(Y[:, 1] - _b_pred_m), np.nan)
SUSPECT = [17, 36, 37, 38, 39, 40, 41, 49, 72, 79]  # outliers + swing window
_clean = [k for k in range(T_N) if k not in SUSPECT]
innov_r_all = float(np.nanstd(_dr)); innov_b_all = float(np.nanstd(_db))
innov_r_clean = float(np.nanstd(_dr[_clean])); innov_b_clean = float(np.nanstd(_db[_clean]))
est_mean, est_cov = fwd_mean, fwd_cov
ref = 0.5 * (fwd_mean + bwd_mean)   # consensus reference (error PROXY only)

for k in range(T_N):
    dp = est_mean[k, :2] - ref[k, :2]
    dv = est_mean[k, 2:4] - ref[k, 2:4]
    diag["rmse_pos"][k] = float(np.hypot(dp[0], dp[1]))
    diag["rmse_vel"][k] = float(np.hypot(dv[0], dv[1]))
    # position-block covariance with a small measurement-noise floor: the
    # particle covariance underestimates spread after repeated resampling, and
    # no estimator can localize better than the measurement noise allows.
    cp = np.array([[fwd_cov[k, 0] + 0.25*SIG_R**2, 0], [0, fwd_cov[k, 1] + 0.25*SIG_R**2]])
    try:
        nees_k = float(dp @ np.linalg.solve(cp, dp))
    except np.linalg.LinAlgError:
        nees_k = 1e6
    diag["nees"][k] = min(nees_k, 1e6)

# ----------------------------------------------------------------------------
# 4. Sanitize and write outputs
# ----------------------------------------------------------------------------
os.makedirs(RESULTS_DIR, exist_ok=True)

def fin(col, fb=0.0):
    a = np.asarray(col, float).copy()
    a[~np.isfinite(a)] = fb
    return a

se = np.column_stack([
    fin(t), fin(est_mean[:, 0]), fin(est_mean[:, 1]), fin(est_mean[:, 2]),
    fin(est_mean[:, 3]), fin(est_cov[:, 0]), fin(est_cov[:, 1]),
    fin(est_cov[:, 2]), fin(est_cov[:, 3])])
np.savetxt(os.path.join(RESULTS_DIR, "state_estimates.csv"), se, delimiter=",",
           header="t,px,py,vx,vy,cov_px,cov_py,cov_vx,cov_vy", comments="", fmt="%.6f")

fd = np.column_stack([
    fin(t), fin(diag["rmse_pos"]), fin(diag["rmse_vel"]), fin(diag["nees"]),
    fin(diag["ess"]), fin(diag["resampled"]), fin(diag["weight_entropy"]),
    fin(diag["max_log_weight"]), fin(diag["min_log_weight"]),
    fin(diag["bearing_residual_mean"]), fin(diag["bearing_residual_std"])])
np.savetxt(os.path.join(RESULTS_DIR, "filter_diagnostics.csv"), fd, delimiter=",",
           header=("t,rmse_pos,rmse_vel,nees,ess,resampled,weight_entropy,"
                   "max_log_weight,min_log_weight,bearing_residual_mean,"
                   "bearing_residual_std"), comments="", fmt="%.6f")

nees_clip = np.clip(diag["nees"], 0, 1e6)
summary = {
    "pos_rmse": sanitize(np.sqrt(np.mean(diag["rmse_pos"]**2))),
    "vel_rmse": sanitize(np.sqrt(np.mean(diag["rmse_vel"]**2))),
    "mean_nees": sanitize(np.mean(nees_clip)),
    "median_nees": sanitize(np.median(nees_clip)),
    "ess_min": sanitize(np.min(diag["ess"])),
    "ess_mean": sanitize(np.mean(diag["ess"])),
    "resampling_count": int(np.sum(diag["resampled"] > 0)),
    "weight_degeneracy_detected": bool(np.min(diag["ess"]) < 0.1 * N_PART),
    "used_log_weights": True,
    "angle_wrapping_detected": bool(angle_wrapping_detected),
    "angle_wrap_event_count": int(angle_wrap_event_count),
}
with open(os.path.join(RESULTS_DIR, "summary.json"), "w") as f:
    json.dump(summary, f, indent=2)

# ----------------------------------------------------------------------------
# 5. Overview figure (matplotlib if available, else built-in PNG renderer)
# ----------------------------------------------------------------------------
overview_path = os.path.join(RESULTS_DIR, 'overview.png')
if HAVE_MPL:
    fig, axes = plt.subplots(2, 3, figsize=(16, 9))
    ax = axes[0, 0]
    ax.plot(ref[:, 0], ref[:, 1], "k--", lw=1, label="smoothed reference (proxy)")
    ax.plot(est_mean[:, 0], est_mean[:, 1], "b-", lw=1.5, label="PF mean")
    okb = mask.all(axis=1)
    ax.scatter(Y[okb, 0] * np.cos(Y[okb, 1]), Y[okb, 0] * np.sin(Y[okb, 1]),
               s=10, c="r", alpha=0.5, label="implied observations")
    ax.plot(0, 0, "k^", ms=10, label="sensor (origin, assumed)")
    ax.set_title("Trajectory"); ax.legend(fontsize=8); ax.set_aspect("equal")

    ax = axes[0, 1]
    ax.plot(t, Y[:, 0], "r.", ms=4, label="range meas (valid)")
    band = 2 * np.sqrt(est_cov[:, 0] + est_cov[:, 1])
    rpf = np.hypot(est_mean[:, 0], est_mean[:, 1])
    ax.plot(t, rpf, "b-", label="PF range")
    ax.fill_between(t, rpf - band, rpf + band, alpha=0.2, color="b")
    ax.set_title("Range: data vs PF (+-2 sigma)"); ax.legend(fontsize=8)

    ax = axes[0, 2]
    ax.plot(t[mask[:, 1]], Y[mask[:, 1], 1], "g.", ms=4, label="bearing meas (raw)")
    ax.plot(t, np.arctan2(est_mean[:, 1], est_mean[:, 0]), "b-", label="PF bearing")
    ax.set_title("Bearing: data vs PF"); ax.legend(fontsize=8)

    ax = axes[1, 0]
    ax.plot(t, diag["ess"], "b-")
    ax.axhline(0.5 * N_PART, color="r", ls="--", label="resample threshold")
    ax.plot(t[diag["resampled"] > 0], diag["ess"][diag["resampled"] > 0], "rv", ms=6)
    ax.set_title(f"ESS (resamples={summary['resampling_count']})"); ax.legend(fontsize=8)

    ax = axes[1, 1]
    ax.plot(t, diag["nees"], "m-", label="NEES proxy")
    ax.plot(t, diag["rmse_pos"], "c-", label="rmse_pos proxy")
    ax.set_yscale("log"); ax.set_title("NEES / position-error proxies"); ax.legend(fontsize=8)

    ax = axes[1, 2]
    ax.plot(t, diag["q_scale"], color="orange", label="q_scale")
    ax.set_title("Adaptive process-noise scale"); ax.set_xlabel("t"); ax.legend(fontsize=8)

    fig.suptitle("Particle-filter state-estimation audit (N=1500, seed=0)", fontsize=13)
    fig.tight_layout()
    fig.savefig(os.path.join(RESULTS_DIR, "overview.png"), dpi=130)
    plt.close(fig)
else:
    # ---- minimal PNG raster renderer (fallback when matplotlib is absent) ----
    _FONT = {
 'A':[14,17,17,31,17,17,17],'B':[30,17,17,30,17,17,30],'C':[14,17,16,16,16,17,14],
 'D':[30,17,17,17,17,17,30],'E':[31,16,16,30,16,16,31],'F':[31,16,16,30,16,16,16],
 'G':[14,17,16,23,17,17,15],'H':[17,17,17,31,17,17,17],'I':[14,4,4,4,4,4,14],
 'J':[7,2,2,2,18,18,12],'K':[17,18,20,24,20,18,17],'L':[16,16,16,16,16,16,31],
 'M':[17,27,21,21,17,17,17],'N':[17,25,21,19,17,17,17],'O':[14,17,17,17,17,17,14],
 'P':[30,17,17,30,16,16,16],'Q':[14,17,17,17,21,18,13],'R':[30,17,17,30,20,18,17],
 'S':[15,16,16,14,1,1,30],'T':[31,4,4,4,4,4,4],'U':[17,17,17,17,17,17,14],
 'V':[17,17,17,17,17,10,4],'W':[17,17,17,21,21,27,17],'X':[17,17,10,4,10,17,17],
 'Y':[17,17,10,4,4,4,4],'Z':[31,1,2,4,8,16,31],
 '0':[14,17,19,21,25,17,14],'1':[4,12,4,4,4,4,14],'2':[14,17,1,6,8,16,31],
 '3':[30,1,1,14,1,1,30],'4':[2,6,10,18,31,2,2],'5':[31,16,30,1,1,17,14],
