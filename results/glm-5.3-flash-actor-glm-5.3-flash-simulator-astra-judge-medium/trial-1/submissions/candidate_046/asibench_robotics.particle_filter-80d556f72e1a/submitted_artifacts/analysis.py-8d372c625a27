    def _fb_line(img, x0, y0, x1, y1, col, lw=1):
        n = int(max(abs(x1 - x0), abs(y1 - y0))) + 1
        if n <= 1:
            return
        xs = np.linspace(x0, x1, n).astype(int)
        ys = np.linspace(y0, y1, n).astype(int)
        ok = (xs >= 0) & (xs < img.shape[1]) & (ys >= 0) & (ys < img.shape[0])
        for d in range(lw):
            img[np.clip(ys[ok] + d, 0, img.shape[0]-1), xs[ok]] = col

    def _fb_dots(img, xs, ys, col, r=1):
        H, W = img.shape[:2]
        for x, y in zip(np.asarray(xs, int), np.asarray(ys, int)):
            if 0 <= x < W and 0 <= y < H:
                img[max(0,y-r):y+r+1, max(0,x-r):x+r+1] = col

    def _fb_text(img, x, y, s, scale=2, col=(0, 0, 0)):
        cx = x
        for ch in s:
            g = _FONT.get(ch.upper() if ch.isalpha() else ch)
            if g is None:
                cx += 6 * scale
                continue
            for ry, row in enumerate(g):
                for rx in range(5):
                    if (row >> (4 - rx)) & 1:
                        xa, ya = cx + rx*scale, y + ry*scale
                        img[ya:ya+scale, xa:xa+scale] = col
            cx += 6 * scale

    def _fb_png(path, img):
        import zlib, struct
        h, w, _ = img.shape
        raw = b"".join(b"\x00" + img[i].tobytes() for i in range(h))
        def chunk(tag, data):
            return (struct.pack(">I", len(data)) + tag + data
                    + struct.pack(">I", zlib.crc32(tag + data) & 0xffffffff))
        png = (b"\x89PNG\r\n\x1a\n"
               + chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0))
               + chunk(b"IDAT", zlib.compress(raw, 6))
               + chunk(b"IEND", b""))
        with open(path, "wb") as f:
            f.write(png)

    def _fb_panel(img, rect, series, title="", logy=False):
        x0, y0, x1, y1 = rect
        for (a, b, c, dd) in [(x0,y0,x1,y0),(x0,y1,x1,y1),(x0,y0,x0,y1),(x1,y0,x1,y1)]:
            _fb_line(img, a, b, c, dd, (60, 60, 60))
        xs_all = [np.asarray(s["x"], float) for s in series if len(s["x"])]
        ys_all = [np.asarray(s["y"], float) for s in series if len(s["x"])]
        if not xs_all:
            return
        X = np.concatenate(xs_all); Yv = np.concatenate(ys_all)
        ok = np.isfinite(Yv)
        if not ok.any():
            return
        xmin, xmax = X.min(), X.max()
        ymin, ymax = np.nanmin(Yv[ok]), np.nanmax(Yv[ok])
        if logy and ymin > 0:
            ymin, ymax = np.log10(ymin), np.log10(ymax)
        pad_x = 0.02*(xmax-xmin) if xmax > xmin else 1.0
        pad_y = 0.05*(ymax-ymin) if ymax > ymin else 1.0
        xmin -= pad_x; xmax += pad_x; ymin -= pad_y; ymax += pad_y
        pw, ph = x1-x0-20, y1-y0-30

        def m(xx, yy):
            if logy and ymin > 0:
                yy = np.log10(np.maximum(yy, 1e-12))
            fx = (np.asarray(xx)-xmin)/max(xmax-xmin, 1e-12)
            fy = (np.asarray(yy)-ymin)/max(ymax-ymin, 1e-12)
            return (x0+10+fx*pw).astype(int), (y1-20-fy*ph).astype(int)

        if ymin < 0 < ymax:
            _, zy = m([xmin], [0])
