def _render_with_pil(pd):
    import os, shutil, subprocess, tempfile
    candidates = ["/usr/bin/python3.14", "python3.14", "/usr/bin/python3"]
    interp = None
    for c in candidates:
        p = shutil.which(c) or (c if os.path.exists(c) else None)
        if not p:
            continue
        r = subprocess.run([p, "-c", "import PIL"], capture_output=True, text=True)
        if r.returncode == 0:
            interp = p
            break
    if interp is None:
        raise RuntimeError("Neither matplotlib nor PIL+interpreter available "
                           "for map_diagnostics.png")
    with tempfile.TemporaryDirectory() as td:
        jf = os.path.join(td, "plot.json")
        pf = os.path.join(td, "map_diagnostics.png")
        json.dump(pd, open(jf, "w"))
        subprocess.run([interp, "-c", PIL_CODE, jf, pf], check=True)
        shutil.copy(pf, "map_diagnostics.png")

