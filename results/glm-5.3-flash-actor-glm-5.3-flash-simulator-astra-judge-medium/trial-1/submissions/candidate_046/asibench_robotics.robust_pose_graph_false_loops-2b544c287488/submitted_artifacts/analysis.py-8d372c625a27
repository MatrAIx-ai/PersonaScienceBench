# --------------------------------------------------------------------------- plotting
def _gyr_cmap():
    import matplotlib.colors as mcolors
    return mcolors.LinearSegmentedColormap.from_list(
        "gyr", [(0.0, (0.0, 0.6, 0.0)), (0.5, (0.9, 0.8, 0.0)), (1.0, (0.8, 0.0, 0.0))])

def render_plot(plot_data):
    try:
        _plot_with_matplotlib(plot_data)
        return
    except Exception as e:                       # noqa: BLE001
        print("matplotlib unavailable (%s); rendering with PIL fallback" % e)
    _render_with_pil(plot_data)

def _plot_with_matplotlib(pd):
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt
    P0 = np.array(pd["P0"]); P1 = np.array(pd["P1"])
    ll = np.array(pd["loop_lines"]); fp = np.array(pd["false_probability"])
    r2 = np.array(pd["r2"]); acc = np.array(pd["accepted"]); thr = pd["r2_thresh"]
    nL = len(r2); cmap = _gyr_cmap()
    fig, axes = plt.subplots(1, 3, figsize=(18, 5.6))
    ax = axes[0]
    ax.plot(P0[:, 0], P0[:, 1], "-", color="0.6", lw=1.2, label="initial (dead-reckoning)")
    ax.plot(P1[:, 0], P1[:, 1], "-", color="tab:blue", lw=1.2, label="optimized")
    ax.plot(P0[0, 0], P0[0, 1], "k^", ms=9, label="anchor pose 0")
    ax.set_title("Trajectory: initial vs optimized")
    ax.set_xlabel("x [m]"); ax.set_ylabel("y [m]")
    ax.legend(fontsize=8); ax.set_aspect("equal", adjustable="datalim")
    ax = axes[1]
    for k in range(nL):
        ax.plot(ll[k, [0, 2]], ll[k, [1, 3]], "-", color=cmap(fp[k]), alpha=0.6, lw=1.2)
    sc = ax.scatter(ll[:, 0], ll[:, 1], c=fp, cmap=cmap, vmin=0, vmax=1, s=55,
                    edgecolors="k", linewidths=0.5)
    plt.colorbar(sc, ax=ax, label="false_probability")
    ax.set_title("Loop candidates colored by false probability")
    ax.set_xlabel("x [m]"); ax.set_ylabel("y [m]")
    ax.set_aspect("equal", adjustable="datalim")
    ax = axes[2]
    order = np.argsort(r2)
    colors = ["tab:green" if acc[k] else "tab:red" for k in order]
    ax.bar(range(nL), r2[order], color=colors)
    ax.axhline(thr, color="k", ls="--", lw=1, label="consensus threshold = %.1f" % thr)
    ax.set_yscale("log")
    ax.set_title("Per-loop final normalized residual r^2\n(green=accepted, red=rejected)")
    ax.set_xlabel("loops (sorted)"); ax.set_ylabel(r"r$^2$ (log)")
    ax.legend(fontsize=8)
    plt.tight_layout()
    plt.savefig("map_diagnostics.png", dpi=140)
    plt.close(fig)

