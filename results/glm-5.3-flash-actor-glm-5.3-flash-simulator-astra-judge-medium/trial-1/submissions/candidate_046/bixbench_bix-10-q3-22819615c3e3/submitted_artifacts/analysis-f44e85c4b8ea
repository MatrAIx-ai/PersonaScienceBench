# TASK008 - BCG-CORONA: COVID-19 severity by arm (BCG vs placebo) within
# patient-volume groups (patients_seen). Chi-square per group.
import pandas as pd, numpy as np, math, json
from scipy import stats

DATA='/workspace/data'
dm=pd.read_csv(f'{DATA}/TASK008_BCG-CORONA_DM.csv',encoding='latin-1')
ex=pd.read_csv(f'{DATA}/TASK008_BCG-CORONA_EX.csv',encoding='latin-1')
ae=pd.read_csv(f'{DATA}/TASK008_BCG-CORONA_AE.csv',encoding='latin-1')

KEYS=['STUDYID','TRTGRP','USUBJID']
blank=ae[[c for c in ae.columns if c not in KEYS]].isna().all(axis=1)
ae=ae[~blank].copy()
print(f'AE: 2694 rows -> removed {blank.sum()} blank placeholder rows -> {len(ae)} retained')

# ---- subject-level COVID severity ----
cmask=ae.AEPT.str.contains('COVID|SARS-CoV-2',case=False,na=False)
covid=ae[cmask]
g=covid.groupby('USUBJID').agg(sevmax=('AESEV','max'),hsmax=('AEHS','max')).reset_index()
outmap={'Worse':1,'Fatal':1}
o=covid.assign(w=covid.AEOUT.map(outmap)).groupby('USUBJID').w.max().reset_index().rename(columns={'w':'outsev'})
g=g.merge(o,on='USUBJID')
# primary severity: max AESEV; fallback to AEHS scale (1-2 vs >=3) for the 44 subjects w/o AESEV
g['sev_prim']=np.where(g.sevmax.notna(), g.sevmax>=3, g.hsmax>=3)
g['sev_fallback_used']=g.sevmax.isna()
df=dm.merge(g,on='USUBJID',how='left')
df['has_covid']=df.USUBJID.isin(g.USUBJID)
print('COVID-AE subjects:',df.has_covid.sum(),'| severity fallback (AEHS) used for',g.sev_fallback_used.sum())
print('Severe (primary def) among COVID-AE subjects:',df.sev_prim.sum())
GROUPS=['1-50','51-100','>100']

def cell(sub,sevcol,g,variant):
    tab=pd.crosstab(sub.TRTGRP,sub[sevcol]).reindex(index=['BCG','Placebo'],columns=[True,False]).fillna(0).astype(int).values
    a,b,c_,d=tab[0,0],tab[0,1],tab[1,0],tab[1,1]  # a=BCG severe, b=BCG non-sev, c=Pbo severe, d=Pbo non-sev
    out=dict(group=g,variant=variant,BCG_sev=a,BCG_nosev=b,Pbo_sev=c_,Pbo_nosev=d,n=a+b+c_+d)
    if (tab.sum(axis=1)==0).any() or (tab.sum(axis=0)==0).any():
        out.update(p_nc=None,note='degenerate table'); print(f'  [{variant}|{g}] degenerate',tab); return out
    chi2,p,dof,exp=stats.chi2_contingency(tab,correction=False)
    _,p_y,_,_=stats.chi2_contingency(tab,correction=True)
    p_f=stats.fisher_exact(tab)[1]
    t=tab.astype(float);  t=t+0.5 if (t==0).any() else t
    orr=(t[0,0]*t[1,1])/(t[0,1]*t[1,0]); se=math.sqrt(1/t[0,0]+1/t[0,1]+1/t[1,0]+1/t[1,1])
    out.update(chi2=chi2,p_nc=p,p_yates=p_y,p_fisher=p_f,OR=orr,
               CI=[math.exp(math.log(orr)-1.96*se),math.exp(math.log(orr)+1.96*se)],
               min_expected=exp.min(),
               valid='OK' if exp.min()>=5 else 'expected<5 -> prefer Fisher')
    print(f"  [{variant}|{g}] BCG {a}/{a+b} severe vs Pbo {c_}/{c_+d} | chi2={chi2:.4f} p_nc={p:.4f} | "
          f"p_Yates={p_y:.4f} | p_Fisher={p_f:.4f} | OR={orr:.3f} ({out['CI'][0]:.3f}-{out['CI'][1]:.3f}) | "
          f"minExp={exp.min():.2f} | {out['valid']}")
    return out

res=[]
print('\n=== PRIMARY. Variant A: only subjects with a COVID AE; severe = max(AESEV)>=3 (AEHS fallback) ===')
for gl in GROUPS:
    sub=df[(df.patients_seen==gl)&df.has_covid]
    res.append(cell(sub,'sev_prim',gl,'A_covidAE'))

print('\n=== PRIMARY. Variant B: all subjects in group; no COVID AE -> non-severe ===')
for gl in GROUPS:
    sub=df[df.patients_seen==gl].copy(); sub['sev_b']=df.sev_prim.fillna(False).loc[sub.index]
    res.append(cell(sub,'sev_b',gl,'B_all'))

print('\n=== SENSITIVITY: AEHS>=3 ===')
for den in ['A_covidAE','B_all']:
    for gl in GROUPS:
        sub=df[df.patients_seen==gl] if den=='B_all' else df[(df.patients_seen==gl)&df.has_covid]
        sub=sub.copy(); sub['s']=(df.hsmax>=3).fillna(False).loc[sub.index] if den=='B_all' else df.hsmax.notna().loc[sub.index]&(df.hsmax>=3).loc[sub.index]
        res.append(cell(sub,'s',gl,f'AEHS3_{den}'))

print('\n=== SENSITIVITY: AEOUT Worse/Fatal ===')
for den in ['A_covidAE','B_all']:
    for gl in GROUPS:
        sub=df[df.patients_seen==gl] if den=='B_all' else df[(df.patients_seen==gl)&df.has_covid]
        sub=sub.copy(); sub['s']=df.outsev.fillna(0).astype(bool).loc[sub.index]
        res.append(cell(sub,'s',gl,f'AEOUT_{den}'))

print('\n=== SENSITIVITY: expect_interact==Yes only ===')
for den in ['A_covidAE','B_all']:
    for gl in GROUPS:
        sub=df[(df.patients_seen==gl)&(df.expect_interact=='Yes')&(df.has_covid if den=='A_covidAE' else df.index==df.index)].copy()
        sub['s']=df.sev_prim.fillna(False).loc[sub.index]
        res.append(cell(sub,'s',gl,f'interactYes_{den}'))

print('\n=== SENSITIVITY (ordinal): severity categories from max AESEV (1/2/>=3), variant A, chi2 2x3 ===')
for gl in GROUPS:
    sub=df[(df.patients_seen==gl)&df.has_covid&df.sevmax.notna()].copy()
    sub['cat']=sub.sevmax.map(lambda x:'1' if x==1 else('2' if x==2 else '>=3'))
    tab=pd.crosstab(sub.TRTGRP,sub.cat).reindex(index=['BCG','Placebo'],columns=['1','2','>=3']).fillna(0).astype(int)
    chi2,p,dof,exp=stats.chi2_contingency(tab.values,correction=False)
    print(f'  [{gl}] {tab.values.tolist()} chi2={chi2:.4f} dof={dof} p={p:.4f} minExp={exp.min():.2f}')
    res.append(dict(group=gl,variant='ordinal_A',chi2=chi2,p_nc=p,min_expected=exp.min(),
                    valid='OK' if exp.min()>=5 else 'expected<5'))

R=pd.DataFrame(res)
R.to_csv('/workspace/analysis/task008_chi2_results.csv',index=False)
print('\nAll results saved -> analysis/task008_chi2_results.csv')
sig=R[R.p_nc.notna()&(R.p_nc<0.05)]
print('\nRows with p(no-correction)<0.05:'); print(sig[['variant','group','p_nc','p_yates','p_fisher']].to_string(index=False))
