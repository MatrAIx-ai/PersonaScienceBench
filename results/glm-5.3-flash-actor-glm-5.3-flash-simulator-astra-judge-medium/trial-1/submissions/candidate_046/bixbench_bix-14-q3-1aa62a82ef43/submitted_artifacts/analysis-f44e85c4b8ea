"""
BixBench bix-14-q3: Count non-reference exonic variants in CHIP genes across 86 samples.

Filters (per approved plan):
  1. Variant calls only: Zygosity in {Heterozygous, Homozygous Variant}
     (drops Zygosity=='Reference' and blank/no-call rows regardless of VAF).
  2. Exonic SO terms only: synonymous_variant, missense_variant, frameshift_variant,
     inframe_insertion, inframe_deletion
     (excludes intron_variant, 3'/5'-UTR terms incl. 5_prime_UTR_premature_start_codon_gain_variant,
      upstream_gene_variant [= intergenic-like class], splice_region_variant).
  3. Gene filter: split 'Gene Names' on commas; keep rows with >=1 gene in the
     56-gene CHIP list (ABL1 recovered from column header); row counted once.
  4. Dedup exact duplicate (Chr:Pos, Ref/Alt) rows within each sample.
  5. Per-sample counting, no cross-sample dedup (primary). Unique variant
     positions across samples reported as sensitivity.
Cross-check: In_CHIP flag vs parsed 56-gene list; disagreements resolved in favor
of the parsed list; discrepancy count reported.
"""
import pandas as pd, glob, os, re, collections

DATA = "data/CHIP_DP10_GQ20_PASS"
GENES_FILE = "data/230214_Schenz_et_al_2022_CHIP_Genes.xlsx"
STATUS_FILE = "data/230215_Trio_Status.xlsx"

EXONIC = {"synonymous_variant", "missense_variant", "frameshift_variant",
          "inframe_insertion", "inframe_deletion"}

# ---- CHIP gene list (ABL1 is stored as the column header) ----
g = pd.read_excel(GENES_FILE, header=None)
CHIP_GENES = {str(x).strip().upper() for x in g[0].tolist() if pd.notna(x)}
print(f"CHIP gene list size: {len(CHIP_GENES)}")

# ---- Trio status ----
status = pd.read_excel(STATUS_FILE, dtype={"Sample ID": str})
status["Sample ID"] = status["Sample ID"].str.strip()
print(f"Trio status rows: {len(status)}; files: {len(glob.glob(f'{DATA}/*.xlsx'))}")

def base_id(fname):
    b = os.path.basename(fname).replace("230209_Exome_GRCh38_CHIP_", "").replace(".xlsx", "")
    m = re.match(r"^(\d+)-(P|P1|P2|PF|PM)$", b)
    return m.group(1) if m else b

per_sample, inchip_disagree_total, splice_sens_total = [], 0, 0
unique_positions = set()
all_rows_seen, varcalls_seen = 0, 0

for f in sorted(glob.glob(f"{DATA}/*.xlsx")):
    df = pd.read_excel(f, header=1)          # row 2 = real column names
    all_rows_seen += len(df)
    sample = os.path.basename(f).replace("230209_Exome_GRCh38_CHIP_", "").replace(".xlsx", "")
    bid = base_id(f)

    # 1) non-reference variant calls only
    vc = df[df["Zygosity"].isin(["Heterozygous", "Homozygous Variant"])].copy()
    varcalls_seen += len(vc)

    # In_CHIP cross-check: flag says False but gene matches parsed list, or vice versa
    def chip_match(v):
        return any(str(x).strip().upper() in CHIP_GENES for x in str(v).split(","))
    gene_match = vc["Gene Names"].map(chip_match)
    flag = vc["In_CHIP"].astype("boolean").fillna(False)
    inchip_disagree_total += int((gene_match != flag).sum())

    # 2) exonic SO terms
    ex = vc[vc["Sequence Ontology (Combined)"].isin(EXONIC)]
    splice_sens_total += len(vc[vc["Sequence Ontology (Combined)"] == "splice_region_variant"]) # sens (pre-gene-filter, per-sample calls)

    # splice-inclusive sensitivity: exonic + splice_region
    sp = vc[vc["Sequence Ontology (Combined)"].isin(EXONIC | {"splice_region_variant"})]

    # 3) gene filter (both variants)
    ex = ex[gene_match.reindex(ex.index).astype(bool)]
    sp = sp[gene_match.reindex(sp.index).astype(bool)]

    # 4) dedup exact duplicate (Chr:Pos, Ref/Alt) rows within sample
    before = len(ex)
    ex = ex.drop_duplicates(subset=["Chr:Pos", "Ref/Alt"])
    sp = sp.drop_duplicates(subset=["Chr:Pos", "Ref/Alt"])
    dedup_removed = before - len(ex)

    # 5) count once per row (even if multiple matched genes)
    per_sample.append({"sample": sample, "id": bid,
                       "n_exonic_chip": len(ex),
                       "n_exonic_chip_with_splice": len(sp),
                       "dedup_removed": dedup_removed})
    for pos in ex["Chr:Pos"]:
        unique_positions.add(pos)

res = pd.DataFrame(per_sample)
total = int(res["n_exonic_chip"].sum())
splice_total = int(res["n_exonic_chip_with_splice"].sum())

print(f"\nTotal rows across 86 files: {all_rows_seen}")
print(f"Variant-called rows (Het/Hom) across 86 files: {varcalls_seen}")
print(f"In_CHIP flag vs parsed 56-gene list disagreements (among variant calls): {inchip_disagree_total}")
print("\n=== PRIMARY ANSWER ===")
print(f"Non-reference exonic variants in CHIP genes, 86 samples: {total}")
print(f"Sensitivity A (include splice_region_variant): {splice_total}")
print(f"Sensitivity B (unique variant positions across samples): {len(unique_positions)}")
print("\nPer-sample breakdown:")
print(res.to_string(index=False))
res.to_csv("analysis/per_sample_counts.csv", index=False)

# merge with status for context
out = res.merge(status[["Sample ID", "Status", "BLM Mutation Status"]],
                left_on="id", right_on="Sample ID", how="left")
print("\nPer-sample with status (first 30):")
print(out.drop(columns=["Sample ID"]).head(30).to_string(index=False))
print("\nMean per sample:", res["n_exonic_chip"].mean().round(2),
      "| min:", res["n_exonic_chip"].min(), "| max:", res["n_exonic_chip"].max())
