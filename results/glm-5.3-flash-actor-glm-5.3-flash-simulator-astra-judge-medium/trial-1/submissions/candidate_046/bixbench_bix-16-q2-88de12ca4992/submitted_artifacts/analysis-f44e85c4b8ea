"""
BixBench bix-16-q2: Skewness of the log2(TPM+1) gene expression distribution
across all cell lines in the dataset.

Primary definition: Fisher-Pearson standardized skewness coefficient with
sample-bias correction (G1, scipy.stats.skew(bias=False)) computed over the
pooled empirical distribution of ALL expression values in the
batch-corrected matrix (cell lines x genes).

Sensitivity views (secondary):
  S1: per-gene skewness across cell lines (axis=0, n=1,673 per gene)
  S2: skewness of per-cell-line mean expression (n=1,673)
  S3: skewness of per-gene mean expression (n=19,138)
Integrity check: expression-row ModelIDs are a subset of Model.csv ModelIDs.
Values are used exactly as supplied (no clipping / re-transformation).
"""
import pandas as pd
import numpy as np
from scipy import stats

EXPR = "data/OmicsExpressionProteinCodingGenesTPMLogp1BatchCorrected.csv"
MODEL = "data/Model.csv"

def main():
    df = pd.read_csv(EXPR)
    ids = df.iloc[:, 0].astype(str)
    X = df.iloc[:, 1:].to_numpy(dtype=float)

    print(f"[structure] matrix: {X.shape[0]} rows (cell lines) x {X.shape[1]} gene columns")
    print(f"[structure] ID column dtype: {df.iloc[:,0].dtype}; example IDs: {ids.head(3).tolist()}")
    print(f"[integrity] NaNs in gene matrix: {int(np.isnan(X).sum())}; NaNs in ID column: {int(ids.isna().sum())}")
    print(f"[range] min={X.min():.4f} max={X.max():.4f} mean={X.mean():.4f} sd={X.std():.4f}")

    # integrity check against Model.csv
    model_ids = set(pd.read_csv(MODEL, usecols=["ModelID"])["ModelID"])
    n_in = int(ids.isin(model_ids).sum())
    print(f"[integrity] expression ModelIDs found in Model.csv: {n_in}/{len(ids)} "
          f"(Model.csv has {len(model_ids)} unique IDs)")

    # PRIMARY: pooled Fisher-Pearson skewness (bias-corrected G1)
    flat = X.ravel()
    g1_bc = float(stats.skew(flat, bias=False))
    g1_raw = float(stats.skew(flat, bias=True))
    print("\n=== PRIMARY RESULT ===")
    print(f"Pooled skewness of all log2(TPM+1) values (G1, bias-corrected): {g1_bc:.4f}")
    print(f"(uncorrected G1 for reference: {g1_raw:.4f})")

    # SENSITIVITIES
    sk_gene = stats.skew(X, axis=0, bias=False)          # per gene across cell lines
    s1_med, s1_mean = float(np.median(sk_gene)), float(np.nanmean(sk_gene))
    s1_q1, s1_q3 = tuple(float(q) for q in np.nanpercentile(sk_gene, [25, 75]))
    s2 = float(stats.skew(X.mean(axis=1), bias=False))   # per-cell-line means
    s3 = float(stats.skew(X.mean(axis=0), bias=False))   # per-gene means
    print("\n=== SENSITIVITY (secondary) ===")
    print(f"S1 per-gene skew across cell lines: median={s1_med:.4f} mean={s1_mean:.4f} IQR=[{s1_q1:.4f}, {s1_q3:.4f}]")
    print(f"S2 skew of per-cell-line mean expression: {s2:.4f}")
    print(f"S3 skew of per-gene mean expression (note: sign inversion expected): {s3:.4f}")

    print("\n=== SUMMARY ===")
    print(f"The log2(TPM+1) expression distribution across all {X.shape[0]} cell lines "
          f"({X.shape[1]} protein-coding genes, {flat.size:,} values) is moderately "
          f"right-skewed: pooled Fisher-Pearson skewness G1 = {g1_bc:.4f}.")

if __name__ == "__main__":
    main()
