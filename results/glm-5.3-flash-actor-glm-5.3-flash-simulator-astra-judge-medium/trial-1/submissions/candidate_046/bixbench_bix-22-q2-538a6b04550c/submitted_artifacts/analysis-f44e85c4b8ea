#!/usr/bin/env python3
"""
BixBench bix-22-q2: Pearson correlation between gene length and mean expression
(across samples) for protein-coding genes in CD4 immune cells.

Primary design (approved):
  - Strict filter gene_biotype == 'protein_coding' (19,942 genes)
  - 151 CD4 sample columns selected via exact join on Sample_annotated_Zenodo.csv
  - Mean of raw batch-corrected counts per gene (variant a, PRIMARY)
  - Pearson r between Length and mean expression (scipy.stats.pearsonr)
Sensitivity variants:
  (b) same as (a) but excluding genes all-zero in CD4
  (c) Pearson between Length and log1p(mean) on the variant-(a) gene set
"""
import numpy as np
import pandas as pd
from scipy import stats

meta = pd.read_csv("data/GeneMetaInfo_Zenodo.csv")
counts = pd.read_csv("data/BatchCorrectedReadCounts_Zenodo.csv")
samp = pd.read_csv("data/Sample_annotated_Zenodo.csv")

# --- Align genes by Geneid ---
counts = counts.set_index("Unnamed: 0")
counts.index.name = "Geneid"
assert (counts.index.values == meta.Geneid.values).all(), "gene order mismatch"
meta = meta.set_index("Geneid")

# --- Filter protein-coding (strict equality) ---
pc = meta.index[meta.gene_biotype == "protein_coding"]
print(f"protein_coding genes (strict): {len(pc)}")

# --- Select CD4 samples via exact join on annotation ---
cd4_samples = samp.loc[samp.celltype == "CD4", "sample"].tolist()
cd4_in_counts = [c for c in counts.columns if c in set(cd4_samples)]
print(f"CD4 samples in counts (exact join): {len(cd4_in_counts)} (annotated: {len(cd4_samples)})")

cd4 = counts.loc[pc, cd4_in_counts]
length = meta.loc[pc, "Length"].astype(float)
mean_expr = cd4.mean(axis=1).astype(float)          # variant (a): raw mean, all PC genes kept
allzero = cd4.sum(axis=1) == 0
print(f"all-zero genes in CD4 (within PC set): {int(allzero.sum())}")

def pearson(x, y, label):
    r, p = stats.pearsonr(x, y)
    print(f"{label}: r = {r:.6f}  p = {p:.3e}  n = {len(x)}")
    return r, p

print("\n=== Pearson correlation: gene Length vs mean CD4 expression ===")
r_a, p_a = pearson(length.values, mean_expr.values, "(a) PRIMARY raw mean, all PC genes        ")
r_b, p_b = pearson(length.values[~allzero.values], mean_expr.values[~allzero.values],
                   "(b) raw mean, all-zero-in-CD4 excluded ")
r_c, p_c = pearson(length.values, np.log1p(mean_expr.values), "(c) log1p(mean) vs Length              ")

print("\n=== Diagnostics ===")
d = mean_expr.describe(percentiles=[.25, .5, .75, .9, .99])
print("Mean expression distribution (variant a):")
print(d.to_string())
print(f"Skew of mean expression: {stats.skew(mean_expr.values):.2f}")

# Leverage points: top |Length - mean(Length)| * residual influence
z_len = (length - length.mean()) / length.std()
resid = mean_expr - (mean_expr.mean() + np.polyfit(length, mean_expr, 1)[0] * (length - length.mean()))
lev = np.abs(z_len * (resid / resid.std()))
top = lev.nlargest(8)
print("\nTop leverage genes (|z_Length * z_resid|):")
for g, v in top.items():
    print(f"  {g}: Length={int(length[g])}, mean_expr={mean_expr[g]:.1f}, leverage={v:.2f}")

# Correlation with and without top leverage points
mask = ~length.index.isin(top.index)
r_nolv, p_nolv = stats.pearsonr(length.values[mask], mean_expr.values[mask])
print(f"\nVariant (a) r excluding top-8 leverage genes: r = {r_nolv:.6f} (n={mask.sum()})")

# Donor-duplicate diagnostic (_1/_2 replicates)
samp_cd4 = samp[samp.celltype == "CD4"].set_index("sample").loc[cd4_in_counts]
dup_donors = samp_cd4[samp_cd4.duplicated("samp", keep=False)]
print(f"\nCD4 samples from donors with replicate libraries (_1/_2): {len(dup_donors)} "
      f"({dup_donors.samp.nunique()} donors)")
# Spearman as rank-based robustness check
rho, ps = stats.spearmanr(length.values, mean_expr.values)
print(f"Spearman rho (variant a gene set): {rho:.6f}  p = {ps:.3e}")

results = {
    "variant_a_primary": {"r": r_a, "p": float(p_a), "n": len(pc)},
    "variant_b_excl_allzero": {"r": r_b, "p": float(p_b), "n": int((~allzero).sum())},
    "variant_c_log1p": {"r": r_c, "p": float(p_c), "n": len(pc)},
}
print("\nJSON summary:", results)
