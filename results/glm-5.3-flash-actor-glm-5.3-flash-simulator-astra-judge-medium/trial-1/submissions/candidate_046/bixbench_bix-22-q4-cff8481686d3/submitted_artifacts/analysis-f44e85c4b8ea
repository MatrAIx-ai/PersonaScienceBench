"""
BixBench bix-22-q4: Pearson correlation between gene length and mean expression
(across samples) for protein-coding genes in CD14 immune cells.

ASSUMPTIONS (documented as required):
1. Gene filter: gene_biotype == 'protein_coding' (exact match) -> 19,942 genes.
2. CD14 samples: columns joined against Sample_annotated_Zenodo.csv on
   celltype == 'CD14' (includes refsamp/nonrefsamp and _1/_2/PB suffixes) -> 132 samples.
3. Mean expression = arithmetic mean of BatchCorrectedReadCounts across the CD14
   samples, with NO transformation (no log) and NO additional normalization (no CPM/TPM).
4. Pearson correlation between Length and the mean expression over the 19,942 genes.
   Genes without a Length annotation would be excluded; none exist (0 missing lengths).
"""
import numpy as np
import pandas as pd
from scipy import stats

META = "data/GeneMetaInfo_Zenodo.csv"
COUNTS = "data/BatchCorrectedReadCounts_Zenodo.csv"
SAMPLE = "data/Sample_annotated_Zenodo.csv"

meta = pd.read_csv(META, index_col=0)
counts = pd.read_csv(COUNTS, index_col=0)
samp = pd.read_csv(SAMPLE, index_col=0)

# --- sanity checks ---
assert (counts.index == meta.index).all(), "gene order mismatch"
assert (meta.index == meta.Geneid).all()
cd14_ids = samp.index[samp.celltype == "CD14"]
assert set(cd14_ids) <= set(counts.columns), "CD14 annotation ids missing from counts"
print(f"counts {counts.shape}, meta {meta.shape}, annotation {samp.shape}")
print(f"CD14 samples used: {len(cd14_ids)}")

# --- filters ---
pc = meta.gene_biotype == "protein_coding"
print(f"protein_coding genes: {int(pc.sum())}")

sub_counts = counts.loc[pc.values, list(cd14_ids)]
lengths = meta.loc[pc, "Length"].astype(float).to_numpy()

# --- mean expression across CD14 samples (arithmetic mean, no transform) ---
mean_expr = sub_counts.mean(axis=1).to_numpy()

# --- drop any genes lacking length (none expected) ---
ok = np.isfinite(lengths) & np.isfinite(mean_expr)
print(f"genes with complete data: {int(ok.sum())} (excluded: {int((~ok).sum())})")
lengths, mean_expr = lengths[ok], mean_expr[ok]

# --- Pearson correlation ---
r, p = stats.pearsonr(lengths, mean_expr)
print(f"\nPearson r = {r:.10f}")
print(f"p-value   = {p:.6e}")
print(f"n (genes) = {len(lengths)}")

# Diagnostics: sensitivity to log-transform and CPM (informational)
r_log, _ = stats.pearsonr(lengths, np.log2(mean_expr + 1))
lib = counts.loc[pc.values, list(cd14_ids)].sum(axis=0).to_numpy()
cpm = sub_counts.to_numpy() / lib * 1e6
r_cpm, _ = stats.pearsonr(lengths, cpm.mean(axis=1))
print(f"[diagnostic] r with log2(mean+1)   = {r_log:.6f}")
print(f"[diagnostic] r with CPM mean       = {r_cpm:.6f}")

# quick scatter summary
print("\nSpearman (length vs mean raw):",
      stats.spearmanr(lengths, mean_expr).statistic)
