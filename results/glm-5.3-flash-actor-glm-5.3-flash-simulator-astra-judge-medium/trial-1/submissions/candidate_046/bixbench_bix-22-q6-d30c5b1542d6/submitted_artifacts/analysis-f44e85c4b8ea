"""BixBench bix-22-q6: Pearson correlation between gene length and gene expression
(protein-coding genes only).

Expression definition (as agreed): arithmetic mean of batch-corrected read counts
across all 723 samples per gene. Primary variant: Pearson r between Length and
log2(mean+1). Sensitivity variant: Pearson r between Length and raw mean.
"""
import numpy as np
import pandas as pd
from scipy import stats

meta = pd.read_csv('data/GeneMetaInfo_Zenodo.csv', index_col=0)
counts = pd.read_csv('data/BatchCorrectedReadCounts_Zenodo.csv', index_col=0)

# Sanity checks (agreed plan)
assert meta.index.equals(counts.index), "Geneid index mismatch"
assert list(counts.columns) == list(pd.read_csv('data/Sample_annotated_Zenodo.csv', index_col=0).index)
assert meta['Length'].isna().sum() == 0 and (meta['Length'] > 0).all()
assert not counts.isna().any().any()

# 1) protein_coding filter
pc = meta['gene_biotype'].str.strip() == 'protein_coding'
sub_meta = meta.loc[pc, ['Length']]
sub_counts = counts.loc[sub_meta.index]
n = len(sub_meta)

# 2) mean expression across all 723 samples
mean_expr = sub_counts.mean(axis=1).to_numpy()
lengths = sub_meta['Length'].to_numpy(float)

# 3) Pearson correlations
r_raw, p_raw = stats.pearsonr(lengths, mean_expr)
r_log, p_log = stats.pearsonr(lengths, np.log2(mean_expr + 1.0))

print(f"n protein_coding genes: {n}")
print(f"PRIMARY   Length vs log2(mean+1): r = {r_log:.6f}, p = {p_log:.3e}, n = {n}")
print(f"SENSITIV. Length vs raw mean    : r = {r_raw:.6f}, p = {p_raw:.3e}, n = {n}")
print(f"sign agreement: {'YES' if np.sign(r_log) == np.sign(r_raw) else 'NO'}")
print(f"mean_expr range: {mean_expr.min():.2f} .. {mean_expr.max():.2f}; n genes with mean==0: {(mean_expr==0).sum()}")
