#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
CBD in CRC cells: DE (DESeq2-style NB GLM, pure NumPy/SciPy) + GO BP enrichment
on a curated offline panel.
DEGs: padj < 0.05 & |log2FC| > 0.5 (no LFC shrinkage, per task spec).
Main contrast: CBD_IC50 (g7) vs DMSO (g3). Sensitivity: CBD_IC50_SS16h (g8) vs DMSO_SS16h (g4).
Environment notes: no network, no R/DESeq2, no GO databases -> NB GLM reimplemented
(validated against statsmodels GLM NegativeBinomial on individual genes) and a
curated GO BP panel with explicit Ensembl IDs, validated for presence/expression.
"""
import numpy as np, pandas as pd, scipy.stats as st
from statsmodels.stats.multitest import multipletests
from statsmodels.robust.robust_linear_model import RLM

COUNTS_F, LAYOUT_F, OUT = "data/counts_raw_unfiltered.csv", "data/sample_layout.csv", "results"
cnt = pd.read_csv(COUNTS_F, index_col=0)
layout = pd.read_csv(LAYOUT_F)
samples = [s.replace("-", "_") for s in layout["SampleID"]]
assert samples == list(cnt.columns), "column/sample mismatch"
groups = dict(zip(samples, layout["Group"]))
raw = cnt.to_numpy(dtype=np.float64)
keep = raw.sum(axis=1) >= 10            # DESeq2-style low-count filter
rf = raw[keep]
gm = np.exp(np.mean(np.log(rf + 1e-9), axis=1))
sf = np.median(rf / gm[:, None], axis=0); sf = sf / np.exp(np.mean(np.log(sf)))
print(f"[load] genes={cnt.shape[0]} samples={cnt.shape[1]} | [filter] retained={keep.sum()} "
      f"| [norm] sf min={sf.min():.3f} max={sf.max():.3f}")

# ---------------- curated GO BP panel (offline; explicit Ensembl ID lists) ----------------
GO_BP = {
 "GO:0006096 glycolytic process": {
   "ENSG00000111640": "GAPDH", "ENSG00000134333": "LDHA", "ENSG00000159399": "HK2",
   "ENSG00000074800": "ENO1", "ENSG00000117394": "SLC2A1"},
 "GO:0006119 oxidative phosphorylation": {
   "ENSG00000198888": "MT-CO1", "ENSG00000198899": "MT-ND1", "ENSG00000198712": "MT-CO2"},
 "GO:0006099 citrate cycle (TCA)": {"ENSG00000131374": "CS", "ENSG00000073578": "SDHA"},
 "GO:0006631 fatty acid metabolic process": {
   "ENSG00000169752": "FASN", "ENSG00000132142": "ACACA", "ENSG00000121897": "PPARG"},
 "GO:0006695 cholesterol metabolic process": {"ENSG00000113161": "HMGCR"},
 "GO:0006520 amino acid metabolic process": {"ENSG00000115419": "GLS", "ENSG00000148291": "GLUD1"},
 "GO:0006914 autophagy (metabolic-remodelling control)": {"ENSG00000171241": "BECN1", "ENSG00000161011": "SQSTM1"},
 "GO:0006915 apoptotic process (non-metabolic control)": {
   "ENSG00000153064": "BCL2", "ENSG00000087088": "BAX", "ENSG00000143384": "MCL1", "ENSG00000147853": "CDKN1A"},
}
HOUSEKEEPING_CHECKS = {"ENSG00000075624": "ACTB"}
MIN_MED_EXPR = 1.0   # validated member must pass count filter and have median norm expr >= 1

# ---------------- NB GLM contrast (validated vs statsmodels GLM-NB) ----------------
def run_contrast(case_samples, ctrl_samples, label):
    names = list(cnt.columns)
    idx = [names.index(s) for s in case_samples + ctrl_samples]
    yy = rf[:, idx]; s = sf[idx]; s = s / np.exp(np.mean(np.log(s)))   # renormalised subset
    N = len(idx); is_case = np.array([True] * len(case_samples) + [False] * len(ctrl_samples))
    X = np.column_stack([np.ones(N), is_case.astype(float)]); off = np.log(s)
    yn = yy / s; qn = yn.mean(1)
    vp = ((yn[:, is_case].var(1, ddof=1) * (is_case.sum() - 1)) +
          (yn[:, ~is_case].var(1, ddof=1) * ((~is_case).sum() - 1))) / (N - 2)
    e_inv = (1.0 / s).mean()
    raw_alpha = np.maximum(0.0, (vp - e_inv) / np.maximum(qn, 1e-8) ** 2)
    a0, a1 = 1e-8, 0.0; fit_ok = qn >= 5
    if fit_ok.sum() > 20:
        Xq = np.column_stack([np.ones(fit_ok.sum()), 1 / qn[fit_ok]])
        try:
            r = RLM(np.maximum(raw_alpha[fit_ok], 1e-8), Xq).fit(maxiter=100)
            a0, a1 = max(float(r.params[0]), 1e-8), max(float(r.params[1]), 0.0)
        except Exception: pass
    trend = np.clip(a0 + a1 / np.maximum(qn, 1e-8), 1e-8, 10.0)
    alpha = np.maximum(trend, np.where(np.isfinite(raw_alpha), raw_alpha, trend))
    b = np.zeros((len(qn), 2)); b[:, 0] = np.log(np.maximum(qn, 1e-8))
    for it in range(1, 201):
        eta = np.clip(b @ X.T, -30, 30); mu = np.exp(off + eta)
        w = mu / (1.0 + alpha[:, None] * mu); z = eta + (yy - mu) / mu
        XW = X[None, :, :] * w[:, :, None]
        A = np.einsum("gni,nj->gij", XW, X); rhs = np.einsum("gni,gn->gi", XW, z)
        b_new = np.linalg.solve(A + np.eye(2) * 1e-12, rhs[..., None])[..., 0]
        delta = np.max(np.abs(b_new - b) / (1 + np.abs(b_new)), axis=1)
        b = b_new
        if delta.max() < 1e-8: break
    eta = np.clip(b @ X.T, -30, 30); mu = np.exp(off + eta)
    w = mu / (1.0 + alpha[:, None] * mu); XW = X[None, :, :] * w[:, :, None]
    A = np.einsum("gni,nj->gij", XW, X); C = np.linalg.inv(A + np.eye(2) * 1e-12)
    se = np.sqrt(np.abs(C[:, 1, 1])); zstat = b[:, 1] / np.maximum(se, 1e-12)
    pval = 2 * st.norm.sf(np.abs(zstat)); padj = multipletests(pval, method="fdr_bh")[1]
    out = pd.DataFrame({"log2FC": b[:, 1] / np.log(2), "lfcSE": se, "stat": zstat, "pvalue": pval,
                        "padj": padj, "baseMean": qn}, index=cnt.index[keep])
    print(f"[disp/{label}] trend a0={a0:.3g} a1={a1:.3g}; median alpha={np.median(alpha):.3f}; "
          f"IRLS iters={it}")
    return out

def degs(res):
    sig = res[(res.padj < 0.05) & (res.log2FC.abs() > 0.5)]
    return sig, sig[sig.log2FC > 0], sig[sig.log2FC < 0]

main_case = [k for k, v in groups.items() if v == "CBD_IC50"]
main_ctrl = [k for k, v in groups.items() if v == "DMSO"]
sens_case = [k for k, v in groups.items() if v == "CBD_IC50_Serum_starvation_16h"]
sens_ctrl = [k for k, v in groups.items() if v == "DMSO_Serum_starvation"]
print(f"[contrast] main: {main_case} vs {main_ctrl}")
print(f"[contrast] sens: {sens_case} vs {sens_ctrl}")
res_main = run_contrast(main_case, main_ctrl, "main CBD vs DMSO")
res_sens = run_contrast(sens_case, sens_ctrl, "sens CBD+SS vs DMSO+SS")
for name, res in [("main", res_main), ("sens", res_sens)]:
    sig, up, dn = degs(res)
    print(f"[DE/{name}] tested={len(res)} padj<0.05={int((res.padj<0.05).sum())} "
          f"DEGs={len(sig)} up={len(up)} down={len(dn)} "
          f"(down:up ratio={len(dn)/max(len(up),1):.2f})")
    sig.sort_values("log2FC", ascending=False).to_csv(f"{OUT}/deg_{name}.csv")
    res.to_csv(f"{OUT}/deg_{name}_all_genes.csv")

# ---------------- curated panel validation (correct indexing; record exclusions) ----------------
ne = pd.DataFrame(rf / sf, index=cnt.index[keep], columns=cnt.columns)   # normalised expr
val_rows, validated, excluded_genes = [], {}, []
for term, genes in GO_BP.items():
    ok = {}
    for ens, sym in genes.items():
        if ens not in cnt.index:
            val_rows.append({"GO_term": term.split(" ")[0], "symbol": sym, "ensembl": ens,
                             "status": "absent_from_matrix", "median_norm_expr": np.nan,
                             "passes_filter": False})
            excluded_genes.append((term, sym, ens, "absent from matrix"))
        elif ens in ne.index:
            med = float(ne.loc[ens].median())
            val_rows.append({"GO_term": term.split(" ")[0], "symbol": sym, "ensembl": ens,
                             "status": "validated", "median_norm_expr": med, "passes_filter": True})
            if med >= MIN_MED_EXPR: ok[ens] = sym
            else: excluded_genes.append((term, sym, ens, f"low expression (median {med:.1f})"))
        else:
            val_rows.append({"GO_term": term.split(" ")[0], "symbol": sym, "ensembl": ens,
                             "status": "filtered_out_low_counts", "median_norm_expr": np.nan,
                             "passes_filter": False})
            excluded_genes.append((term, sym, ens, "failed low-count filter"))
    validated[term] = ok
pd.DataFrame(val_rows).to_csv(f"{OUT}/go_panel_validation.csv", index=False)
for e, sym in HOUSEKEEPING_CHECKS.items():
    print(f"[sanity] {sym}: median norm expr = {ne.loc[e].median():.0f} (expect high)")
print(f"[go] genes excluded from panel ({len(excluded_genes)}):")
for t, sym, e, why in excluded_genes: print(f"      - {sym} ({e}) from {t}: {why}")
print(f"[go] universe = validated panel members passing filter")
for t, d in validated.items():
    print(f"[go] {t}: declared={len(GO_BP[t])} validated={len(d)} symbols={list(d.values())}")

# ---------------- GO BP enrichment: Fisher exact (greater) per direction, BH FDR ----------------
def enrich(res, label):
    sig, _, _ = degs(res)
    up_ids = set(sig[sig.log2FC > 0].index); dn_ids = set(sig[sig.log2FC < 0].index)
    universe = set()
    for t, d in validated.items(): universe |= set(d)
    universe &= set(cnt_f := res.index)
    N = len(universe); rows = []
    for term, d in validated.items():
        members = set(d) & universe; K = len(members)
        if K == 0: continue
        for direction, sigset in [("up", up_ids), ("down", dn_ids)]:
            k = len(members & sigset); m = len(sigset & universe)
            _, p = st.fisher_exact([[k, K - k], [m - k, N - K - (m - k)]], alternative="greater")
            orr = ((k + 0.5) * (N - K - m + k + 0.5)) / ((K - k + 0.5) * (m - k + 0.5))
            rows.append({"contrast": label, "GO_term": term, "term_size_validated": K,
                         "universe_size": N, "direction": direction, "sig_in_term": k,
                         "sig_total_in_universe": m, "odds_ratio": orr,
                         "p_hypergeom_greater": p,
                         "median_log2FC_members": res.loc[list(members), "log2FC"].median(),
                         "mean_log2FC_members": res.loc[list(members), "log2FC"].mean(),
                         "n_members_up": len(members & up_ids), "n_members_down": len(members & dn_ids)})
    df = pd.DataFrame(rows); df["padj"] = 1.0
    for direction in ["up", "down"]:
        m_ = df.direction == direction
        if m_.sum(): df.loc[m_, "padj"] = multipletests(df.loc[m_, "p_hypergeom_greater"], method="fdr_bh")[1]
    return df.sort_values(["direction", "p_hypergeom_greater"])

en_main = enrich(res_main, "main CBD_IC50 vs DMSO")
en_sens = enrich(res_sens, "sens CBD_SS16h vs DMSO_SS16h")
en_main.to_csv(f"{OUT}/go_enrichment_main.csv", index=False)
en_sens.to_csv(f"{OUT}/go_enrichment_sens.csv", index=False)

# ---------------- weight comparison: up vs down in metabolic routes ----------------
print("\n========= WEIGHT COMPARISON: up vs down in GO BP metabolic routes =========")
met_terms = [t for t in validated if "control" not in t]
summary = []
for label, en, res in [("MAIN (CBD_IC50 vs DMSO)", en_main, res_main),
                       ("SENS (CBD_SS16h vs DMSO_SS16h)", en_sens, res_sens)]:
    sig, up, dn = degs(res)
    print(f"\n--- {label}: global DEGs up={len(up)} down={len(dn)} "
          f"(median |log2FC| up={up.log2FC.abs().median():.2f}, down={dn.log2FC.abs().median():.2f}) ---")
    summary.append({"contrast": label, "global_DEGs_up": len(up), "global_DEGs_down": len(dn),
                    "median_absLFC_up": up.log2FC.abs().median(), "median_absLFC_down": dn.log2FC.abs().median()})
    for t in validated:
        sub = en[en.GO_term == t]
        if sub.empty: continue
        u = sub[sub.direction == "up"].iloc[0]; d = sub[sub.direction == "down"].iloc[0]
        tag = "METABOLIC" if t in met_terms else "CONTROL "
        print(f"{tag} {t}\n    up   : k={int(u.sig_in_term)}/{int(u.term_size_validated)} "
              f"OR={u.odds_ratio:6.2f} padj={u.padj:9.3g} medLFC={u.median_log2FC_members:+.2f}\n"
              f"    down : k={int(d.sig_in_term)}/{int(d.term_size_validated)} "
              f"OR={d.odds_ratio:6.2f} padj={d.padj:9.3g} medLFC={d.median_log2FC_members:+.2f}")
    met = en[en.GO_term.isin(met_terms)]
    uh = int(met[met.direction == "up"].sig_in_term.sum()); dh = int(met[met.direction == "down"].sig_in_term.sum())
    print(f"[{label}] metabolic-panel significant hits: up={uh} down={dh}")
    summary[-1].update({"metabolic_hits_up": uh, "metabolic_hits_down": dh})
pd.DataFrame(summary).to_csv(f"{OUT}/direction_summary.csv", index=False)

detail = []
for term, d in validated.items():
    for e, sym in d.items():
        r1, r2 = res_main.loc[e], res_sens.loc[e]
        detail.append({"GO_term": term, "symbol": sym, "ensembl": e, "baseMean_main": r1.baseMean,
                       "log2FC_main": r1.log2FC, "padj_main": r1.padj,
                       "DEG_main": bool(r1.padj < 0.05 and abs(r1.log2FC) > 0.5),
                       "log2FC_sens": r2.log2FC, "padj_sens": r2.padj,
                       "DEG_sens": bool(r2.padj < 0.05 and abs(r2.log2FC) > 0.5)})
pd.DataFrame(detail).to_csv(f"{OUT}/go_panel_DE_detail.csv", index=False)
print("\n[done] results written to results/")
