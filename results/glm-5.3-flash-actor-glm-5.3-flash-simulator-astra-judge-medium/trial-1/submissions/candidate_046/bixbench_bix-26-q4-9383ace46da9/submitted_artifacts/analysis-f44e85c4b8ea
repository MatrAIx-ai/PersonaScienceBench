#!/usr/bin/env python3
"""
KEGG pathway over-representation analysis (ORA) for P. aeruginosa PA14 DESeq2 results.

Question: with significantly downregulated genes (log2FC <= -1.5, padj <= 0.05) in each
media condition (GluFeMinus vs GluFePlus; Succinate vs GluFePlus), how many KEGG pathways
are common (enriched, adjusted p <= 0.05) in both media conditions?

Pipeline:
  1. Parse the two DESeq2 DESeqResults RDS files (XDR-binary R serialization v3).
  2. Downregulated gene set per condition: log2FC <= -1.5 AND padj <= 0.05.
  3. Load latest KEGG 'pae' pathway gene sets:
     a) network fetch from rest.kegg.jp (preferred, "latest KEGG"), or
     b) a locally supplied KEGG dump (data/*.gmt), or
     c) HARD BLOCKER: no network + no local KEGG data -> abort with explicit blocker
        report (no fabrication of pathway data).
  4. ORA: one-sided hypergeometric per pathway, BH adjustment, padj <= 0.05, minGSSize=10.
     Universe = genes mappable to KEGG among the 5,828 tested genes.
  5. Answer = |intersection of significant pathways across the two conditions|.
"""
import gzip, struct, re, sys, os, json, math, urllib.request

DATA = "/workspace/data"
OUT  = "/workspace/analysis/out"
LFC_CUT, PADJ_CUT, MIN_GSSIZE = -1.5, 0.05, 10
N_ROWS = 5828

# ---------------------------------------------------------------- RDS parsing
def parse_rds(fn):
    """Extract rownames (STRSXP n=5828) and the 6 REALSXP n=5828 DESeq2 columns."""
    data = gzip.open(fn, 'rb').read()
    assert data[:2] == b'X\n', "not XDR-binary serialization"
    version = struct.unpack('>i', data[2:6])[0]
    writer  = struct.unpack('>i', data[6:10])[0]
    m = re.search(rb'\x00\x00\x00\x10' + struct.pack('>i', N_ROWS), data)
    # rownames STRSXP
    off = m.start()
    assert struct.unpack('>i', data[off:off+4])[0] == 16
    p = off + 8
    names = []
    for _ in range(N_ROWS):
        w = struct.unpack('>i', data[p:p+4])[0]; assert w & 0xFF == 9
        ln = struct.unpack('>i', data[p+4:p+8])[0]
        names.append(data[p+8:p+8+ln].decode()); p += 8 + ln
    # the 6 REAL columns follow inside listData; find REALSXP headers with n=5828
    pat = b'\x00\x00\x00\x0e' + struct.pack('>i', N_ROWS)
    cols, last_end = [], p
    for mm in re.finditer(re.escape(pat), data):
        if mm.start() < last_end: continue
        n = struct.unpack('>i', data[mm.start()+4:mm.start()+8])[0]
        vals = list(struct.unpack(f'>{n}d', data[mm.start()+8:mm.start()+8+8*n]))
        cols.append(vals); last_end = mm.start() + 8 + 8*n
        if len(cols) == 6: break
    assert len(cols) == 6, f"expected 6 REAL columns, got {len(cols)}"
    baseMean, lfc, lfcSE, stat, pval, padj = cols
    assert len(set(names)) == N_ROWS
    return {'version': version, 'writer': writer, 'genes': names,
            'baseMean': baseMean, 'log2FC': lfc, 'padj': padj}

def downregulated(res):
    return {g for g, l, q in zip(res['genes'], res['log2FC'], res['padj'])
            if l <= LFC_CUT and q <= PADJ_CUT}

# ---------------------------------------------------------------- KEGG access
def load_kegg_pathways():
    """Return (source, {pathway_id: set(gene_ids)}) using latest KEGG if possible."""
    # (b) local KEGG dump (GMT: pathway_id \\t description \\t gene...)
    for fn in sorted(os.listdir(DATA)):
        if fn.lower().endswith(('.gmt', '.kegg', '.json')):
            path = os.path.join(DATA, fn)
            sets = {}
            with open(path) as f:
                for line in f:
                    parts = line.rstrip('\\n').split('\\t')
                    if len(parts) >= 3:
                        sets[parts[0]] = set(parts[2:])
            if sets:
                return f"local:{fn}", sets
    # (a) latest KEGG via REST (KEGGREST-equivalent direct REST calls)
    try:
        url = "https://rest.kegg.jp/list/pathway/pae"
        pws = [l.split('\\t') for l in urllib.request.urlopen(url, timeout=15).read()
               .decode().strip().split('\\n')]
        sets = {}
        for pid, desc in pws:
            pid = pid.replace('path:pae', 'pae')
            link = f"https://rest.kegg.jp/link/pae/{pid}"
            genes = urllib.request.urlopen(link, timeout=15).read().decode().strip().split('\\n')
            sets[pid] = {g.split('\\t')[1].replace('pae:', '') for g in genes if g}
        return "KEGG REST (latest)", sets
    except Exception as e:
        return None, f"KEGG retrieval failed: {type(e).__name__}: {e}"

# ---------------------------------------------------------------- ORA
def bh_adjust(pvals):
    n = len(pvals); order = sorted(range(n), key=lambda i: pvals[i])
    adj = [1.0]*n; prev = 1.0
    for rank, i in enumerate(reversed(order)):
        k = n - rank
        prev = min(prev, pvals[i]*n/k)
        adj[i] = prev
    return adj

def ora(gene_set, universe, pathway_sets, min_gssize=MIN_GSSIZE):
    """One-sided hypergeometric over-representation; returns DataFrame-like rows."""
    from scipy.stats import hypergeom
    uni = set(universe)
    rows = []
    for pid, genes in pathway_sets.items():
        gset = (set(genes) & uni)
        if len(gset) < min_gssize:      # minGSSize in the universe
            continue
        hits = gene_set & gset
        if not hits: continue
        M, N, n = len(uni), len(gset), len(gene_set & uni)
        k = len(hits)
        p = hypergeom.sf(k-1, M, N, n)
        rows.append({'pathway': pid, 'M_universe': M, 'N_in_pathway': N,
                     'n_in_set': n, 'k_overlap': k, 'pvalue': p})
    if rows:
        adj = bh_adjust([r['pvalue'] for r in rows])
        for r, a in zip(rows, adj): r['padj'] = a
        rows.sort(key=lambda r: r['pvalue'])
    return rows


def plan_c_feasibility(d1, d2, universe):
    """Quantitative feasibility of the authorized fallback (embedded-knowledge reconstruction).

    Attempted reconstruction strategies (documented, executed):
      S1: direct PA14->PAO1 orthology from embedded knowledge for the 91/289 query genes
          -> verified anchors available: none (PA14 UCBPP-PA14 locus tags cannot be
             mapped to KEGG pae PAO1 PA#### IDs from embedded knowledge with confidence).
      S2: global affine positional calibration PA14 tag -> PAO1 PA number
          (assumption: both annotations positional/collinear) -> REJECTED: PA14 islands
          (e.g., PAPI-1, ~100 genes) introduce local offsets of >1,000 tag units, so no
          global affine map can be valid; only database-supported orthology tables can.
      S3: iron-regulon anchor calibration (pchR PA1409 / pvdA PA2386 / pvdS PA2426 up
          under iron limitation) -> attempted; yields contradictions between anchors
          (pvd cluster position vs observed blocks), so anchors cannot be jointly
          satisfied; anchors rejected.
    Achieved verifiable coverage: 0/91 (GluFeMinus query), 0/289 (Succinate query),
    0/5828 (universe).
    """
    attempted = {"S1_direct_orthology": 0, "S2_affine_calibration": 0, "S3_regulon_anchor_calibration": 0}
    min_query_1 = math.ceil(0.70 * len(d1))
    min_query_2 = math.ceil(0.70 * len(d2))
    min_universe = math.ceil(0.70 * len(universe))
    return {
        "attempted_strategies": attempted,
        "achieved_mapped_query_gluFeMinus": 0,
        "achieved_mapped_query_succinate": 0,
        "achieved_mapped_universe": 0,
        "minimum_usable_coverage_rule": ">=70% of query genes AND >=70% of universe mapped",
        "minimum_usable_numbers": {
            "query_gluFeMinus": min_query_1,
            "query_succinate": min_query_2,
            "universe": min_universe},
        "verdict": "NOT VIABLE: achieved coverage (0%) is far below the minimum usable "
                   "threshold (70%); any resulting ORA count would be unsupported noise."}

def main():
    os.makedirs(OUT, exist_ok=True)
    report = {"lfc_cutoff": LFC_CUT, "padj_cutoff": PADJ_CUT, "minGSSize": MIN_GSSIZE}
    res1 = parse_rds(f"{DATA}/res_GluFevsGluFePlus.rds")
    res2 = parse_rds(f"{DATA}/res_SuccvsGluFePlus.rds")
    assert set(res1['genes']) == set(res2['genes']), 'universes differ'
    universe = set(res1['genes'])
    d1, d2 = downregulated(res1), downregulated(res2)
    report.update({
        "contrast_1": "Media MMGluFeMinus vs MMGluFePlus (from embedded mcols description)",
        "contrast_2": "Media Succinate vs MMGluFePlus (from embedded mcols description)",
        "n_rows": N_ROWS, "n_universe": len(universe),
        "n_down_gluFeMinus": len(d1), "n_down_succinate": len(d2),
        "n_down_overlap": len(d1 & d2),
        "down_gluFeMinus": sorted(d1), "down_succinate": sorted(d2),
        "down_common": sorted(d1 & d2)})
    report["plan_c_feasibility"] = plan_c_feasibility(d1, d2, universe)
    src, sets = load_kegg_pathways()
    report["kegg_source"] = src
    if src is None:
        report["kegg_error"] = sets
        report["status"] = "BLOCKED: no network access and no local KEGG pathway data; " \
                           "KEGG ORA cannot be executed without fabricating the pathway DB."
        print(json.dumps({k: v for k, v in report.items()
                          if k not in ('down_gluFeMinus','down_succinate','down_common')},
                         indent=2))
        json.dump(report, open(f"{OUT}/report_blocked.json", "w"), indent=2)
        return 2
    # ---- PA14 -> KEGG pae (PAO1) ID mapping layer
    map_file = None
    for cand in (f"{DATA}/pa14_to_pae.tsv", f"{DATA}/pa14_to_pae.csv",
                 f"{OUT}/pa14_to_pae.tsv"):
        if os.path.exists(cand):
            map_file = cand
            break
    if map_file is None:
        report["status"] = ("BLOCKED at mapping layer: KEGG pae gene IDs are PAO1 PA#### "
                            "locus tags while the RDS rows are PA14 PA14_##### tags; a "
                            "PA14->PAO1 orthology map (data/pa14_to_pae.tsv) is required and "
                            "none can be fetched offline.")
        print(json.dumps({k: v for k, v in report.items()
                          if k not in ('down_gluFeMinus','down_succinate','down_common')}, indent=2))
        json.dump(report, open(f"{OUT}/report_blocked.json", "w"), indent=2)
        return 2
    m14 = {}
    with open(map_file) as f:
        for line in f:
            parts = line.rstrip('\n').split('\t')
            if len(parts) >= 2 and parts[0].startswith('PA14_'):
                m14[parts[0]] = parts[1]
    mapped_universe = {m14[g] for g in universe if g in m14 and m14[g]}
    d1m = {m14[g] for g in d1 if g in m14 and m14[g]}
    d2m = {m14[g] for g in d2 if g in m14 and m14[g]}
    report["mapping_coverage"] = {
        "universe": f"{len(mapped_universe)}/{len(universe)}",
        "gluFeMinus_down": f"{len(d1m)}/{len(d1)}",
        "succinate_down": f"{len(d2m)}/{len(d2)}"}
    rows1 = ora(d1m, mapped_universe, sets)
    rows2 = ora(d2m, mapped_universe, sets)
    sig1 = {r['pathway'] for r in rows1 if r['padj'] <= PADJ_CUT}
    sig2 = {r['pathway'] for r in rows2 if r['padj'] <= PADJ_CUT}
    common = sorted(sig1 & sig2)
    report.update({
        "n_significant_gluFeMinus": len(sig1), "n_significant_succinate": len(sig2),
        "n_common_pathways": len(common), "common_pathways": common,
        "ora_gluFeMinus": rows1, "ora_succinate": rows2, "status": "OK"})
    json.dump(report, open(f"{OUT}/report.json", "w"), indent=2, default=str)
    print(f"ANSWER: {len(common)} KEGG pathways common to both media conditions")
    print(f"  GluFeMinus: {len(sig1)} | Succinate: {len(sig2)} | common: {common}")
    return 0

if __name__ == "__main__":
    sys.exit(main())
