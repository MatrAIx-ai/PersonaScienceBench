"""
TASK008 BCG-CORONA: Odds ratio of BCG vaccination on COVID-19 severity.
Ordinal (proportional-odds logistic) regression via statsmodels OrderedModel.
Approved specification (2026-10-19):
  Primary response: max(AESEV) 1-4 among COVID-19 AEs, complete-case (n=153).
  Sensitivity: 0-4 scale (0 = no COVID-19 AE) over n=1000.
  Covariates: TRTGRP(BCG vs Placebo), mh_count (MHORRES==2 in MHSCAT
  'MEDICAL HISTORY', incl 'Other:' and Current RTI; NaN=No), patients_seen
  (ordinal 1/2/3), expect_interact (Yes=1); all six two-way interactions;
  OR of BCG at reference levels; no-interaction model as reference.
  Bootstrap CI: 2000 reps, seed 2026 (chunked runs, seeds 2026+chunk).
  MH variant: 15 fixed conditions only (sensitivity).
  Proportional-odds diagnostic: per-cut binary logits.
Usage: python3 task008_bcg_analysis.py <mode>
  modes: main | boot_primary | boot_mhfixed | boot_sens | collect
"""
import numpy as np, pandas as pd, warnings, json, sys, os
from statsmodels.miscmodels.ordinal_model import OrderedModel
import statsmodels.api as sm
warnings.filterwarnings("ignore")
SEED = 2026
INTER = ['bcgxmh_count','bcgxpatients_seen','bcgxexpect_interact',
         'mh_countxpatients_seen','mh_countxexpect_interact','patients_seenxexpect_interact']
BASE = ['bcg','mh_count','patients_seen','expect_interact']
FULL = BASE + INTER
CHUNK = 500; NBOOT = 2000

# ---------------- data ----------------
def build():
    dm = pd.read_csv('data/TASK008_BCG-CORONA_DM.csv')
    mh = pd.read_csv('data/TASK008_BCG-CORONA_MH.csv')
    ae = pd.read_csv('data/TASK008_BCG-CORONA_AE.csv')
    sub = mh[mh.MHSCAT == 'MEDICAL HISTORY']
    mh_count = sub.assign(yes=(sub.MHORRES==2.0).astype(int)).groupby('USUBJID').yes.sum()
    fixed15 = ['Tuberculosis','Hypertension','Diabetes Mellitus','Chronic Obstructive Pulmonary Disease',
               'Asthma','Other lung disease','Cardiovascular disease','Cerebrovascular disease',
               'Kidney disease','Liver disease','Cancer','Organ or bone marrow transplantation',
               'Primary immunodeficiency','Neutropenia or lymphopenia','Current respiratory tract infection']
    mh_count_fixed = (sub[sub.MHTERM.isin(fixed15)]
                      .assign(yes=(sub.MHORRES==2.0).astype(int)).groupby('USUBJID').yes.sum())
    covid = ae[ae.AEPT.str.contains('COVID|SARS-CoV-2', case=False, na=False)]
    sev = covid.groupby('USUBJID').AESEV.max()
    df = dm.set_index('USUBJID').copy()
    df['mh_count'] = mh_count.reindex(df.index).fillna(0).astype(int)
    df['mh_count_fixed'] = mh_count_fixed.reindex(df.index).fillna(0).astype(int)
    df['patients_seen'] = df.patients_seen.map({'1-50':1,'51-100':2,'>100':3}).astype(float)
    df['expect_interact'] = df.expect_interact.map({'No':0,'Yes':1}).astype(float)
    df['bcg'] = (df.TRTGRP=='BCG').astype(float)
    df['sev'] = sev.reindex(df.index)
    def design(d, mhcol='mh_count'):
        X = pd.DataFrame(index=d.index)
        X['bcg']=d.bcg; X['mh_count']=d[mhcol].astype(float)
        X['patients_seen']=d.patients_seen; X['expect_interact']=d.expect_interact
        for a,b in [('bcg','mh_count'),('bcg','patients_seen'),('bcg','expect_interact'),
                    ('mh_count','patients_seen'),('mh_count','expect_interact'),
                    ('patients_seen','expect_interact')]:
            X[f'{a}x{b}']=X[a]*X[b]
        return X
    prim = df[df.sev.notna()].copy(); prim['y']=prim.sev.astype(int)
    sens = df.copy(); sens['y']=np.where(sens.sev.notna(), sens.sev, 0).astype(int)
    return df, prim, sens, design

def fit_ord(y, X, cols):
    return OrderedModel(y.astype(int), X[cols], distr='logit').fit(method='bfgs', disp=False, maxiter=1000)

def or_bcg(res):
    b = res.params['bcg']; s = res.bse['bcg']
    return (float(np.exp(b)), float(np.exp(b-1.96*s)), float(np.exp(b+1.96*s)))

def boot_chunk(y, X, seed, n):
    rng = np.random.default_rng(seed)
    idx = np.arange(len(y)); out=[]; fails=0
    for _ in range(n):
        take = rng.choice(idx, size=len(idx), replace=True)
        ys_, Xs_ = y.iloc[take], X.iloc[take]
        if ys_.nunique() < 2: fails+=1; continue
        try: out.append(fit_ord(ys_, Xs_, FULL).params['bcg'])
        except Exception: fails+=1
    return np.array(out), fails

def po_check(y, X):
    rows=[]
    for c in sorted(y.unique())[:-1]:
        m = sm.Logit((y>c).astype(int), sm.add_constant(X[BASE])).fit(disp=False, maxiter=300)
        rows.append({'cut':f'>{c}','bcg_beta':float(m.params['bcg']),
                     'OR':float(np.exp(m.params['bcg'])),'p':float(m.pvalues['bcg'])})
    return pd.DataFrame(rows)

def boot_path(tag):
    return f'analysis/task008_boot_{tag}.npy', f'analysis/task008_boot_{tag}_fails.json'

def next_chunk(tag):
    path, fpath = boot_path(tag)
    done = 0 if not os.path.exists(path) else len(np.load(path))
    if done >= NBOOT: return None
    df, prim, sens, design = build()
    if tag=='primary':   y, X = prim.y, design(prim)
    elif tag=='mhfixed': y, X = prim.y, design(prim, 'mh_count_fixed')
    else:                y, X = sens.y, design(sens)
    chunk = min(CHUNK, NBOOT-done)
    vals, fails = boot_chunk(y, X, SEED+done, chunk)
    arr = vals if done==0 else np.concatenate([np.load(path), vals])
    np.save(path, arr)
    nf = json.load(open(fpath)) if os.path.exists(fpath) else {'fails':0}
    nf['fails'] += fails; json.dump(nf, open(fpath,'w'))
    print(f"{tag}: chunk {done}->{done+chunk} done; total {len(arr)} betas, {nf['fails']} failures")
    return None

if sys.argv[1] == 'main':
    df, prim, sens, design = build()
    Xp, yp = design(prim), prim.y
    Xs, ys = design(sens), sens.y
    print(f"PRIMARY n={len(prim)}, dist={yp.value_counts().sort_index().to_dict()}")
    print(f"SENSITIVITY n={len(sens)}, dist={ys.value_counts().sort_index().to_dict()}")
    r0 = fit_ord(yp, Xp, BASE); print("\n[Primary no-int] OR:", or_bcg(r0)); print(r0.summary())
    r1 = fit_ord(yp, Xp, FULL); print("\n[Primary with-int] OR:", or_bcg(r1))
    r0f = fit_ord(yp, design(prim,'mh_count_fixed'), BASE)
    print("\n[MH 15-fixed, no-int] OR:", or_bcg(r0f))
    rs0 = fit_ord(ys, Xs, BASE); print("\n[Sens 0-4 no-int] OR:", or_bcg(rs0)); print(rs0.summary())
    rs1 = fit_ord(ys, Xs, FULL); print("\n[Sens 0-4 with-int] OR:", or_bcg(rs1))
    print("\nPO check primary:\n", po_check(yp, Xp).to_string(index=False))
    print("\nPO check sensitivity:\n", po_check(ys, Xs).to_string(index=False))
    json.dump({'primary':{'n':len(prim),'dist':yp.value_counts().sort_index().to_dict(),
                          'OR_no_int':or_bcg(r0),'OR_int_wald':or_bcg(r1),
                          'OR_mhfixed_no_int':or_bcg(r0f)},
               'sensitivity':{'n':len(sens),'dist':ys.value_counts().sort_index().to_dict(),
                              'OR_no_int':or_bcg(rs0),'OR_int_wald':or_bcg(rs1)},
               'po_primary':po_check(yp,Xp).to_dict('records'),
               'po_sens':po_check(ys,Xs).to_dict('records')},
              open('analysis/task008_main.json','w'), indent=2, default=float)
elif sys.argv[1] in ('boot_primary','boot_mhfixed','boot_sens'):
    next_chunk(sys.argv[1].replace('boot_',''))
elif sys.argv[1] == 'collect':
    res = json.load(open('analysis/task008_main.json'))
    for tag in ['primary','mhfixed','sens']:
        path, fpath = boot_path(tag)
        b = np.load(path); nf = json.load(open(fpath))['fails']
        lo, hi = np.percentile(b,[2.5,97.5])
        res.setdefault('bootstrap',{})[tag] = {
            'reps': len(b), 'failures': nf,
            'OR_median': float(np.exp(np.median(b))),
            'CI': [float(np.exp(lo)), float(np.exp(hi))]}
        print(tag, res['bootstrap'][tag])
    json.dump(res, open('analysis/task008_results.json','w'), indent=2, default=float)
    print("Saved analysis/task008_results.json")
