"""
TASK008_BCG-CORONA - Análisis principal (aprobado por el investigador)
Regresión ordinal de probabilidades proporcionales (logit acumulado):
efecto de MHONGO (nº de condiciones médicas en curso) sobre la severidad
máxima de COVID-19 (AE.AESEV 1-4), ajustando por BCG (TRTGRP), patients_seen,
expect_interact y demografía (Age, SEX, RACE, education, work_hours).
"""
import pandas as pd, numpy as np
import statsmodels.api as sm
from statsmodels.miscmodels.ordinal_model import OrderedModel
import warnings; warnings.filterwarnings('ignore')
pd.set_option('display.width', 250)

# ---------- 1. Carga ----------
dm = pd.read_csv('data/TASK008_BCG-CORONA_DM.csv')
ae = pd.read_csv('data/TASK008_BCG-CORONA_AE.csv', low_memory=False)
mh = pd.read_csv('data/TASK008_BCG-CORONA_MH.csv', low_memory=False)

# ---------- 2. Variables por sujeto ----------
mhongo = (mh[mh.MHONGO=='Yes'].groupby('USUBJID').size()
          .reindex(dm.USUBJID).fillna(0).astype(int).rename('MHONGO'))
covid_mask = ae.AEPT.astype(str).str.contains('covid|corona|sars', case=False, na=False)
sev = ae[covid_mask].groupby('USUBJID').AESEV.max().rename('severity')

df = dm.set_index('USUBJID').join(mhongo).join(sev)
df['any_covid'] = df.index.isin(ae.loc[covid_mask,'USUBJID'])

df['BCG'] = (df.TRTGRP=='BCG').astype(int)
df['patients_seen_ord'] = df.patients_seen.map({'1-50':1,'51-100':2,'>100':3})
df['work_hours_ord'] = df.work_hours.map({'1-40':1,'41-80':2,'>80':3})
df['expect_interact_b'] = (df.expect_interact=='Yes').astype(int)
df['age_ord'] = df.Age.map({'10-19':1,'20-29':2,'30-39':3,'40-49':4,'50-59':5,'60-69':6,'70-79':7})
df['sex_b'] = (df.SEX==2).astype(int)
df['race_cat'] = df.RACE.replace({4:'4-5',5:'4-5'}).astype(str)
df['edu2'] = df.education.replace({3:2})
race_dum = pd.get_dummies(df.race_cat, prefix='RACE', drop_first=True).astype(float)

cc = df[df.severity.notna() & df.any_covid].copy()
print(f"Población COVID con severidad conocida: n={len(cc)} (de {df.any_covid.sum()} con AE COVID)")
print("\n=== Outcome: severidad máxima AE COVID (sujetos) ===")
print(cc.severity.value_counts().sort_index().to_string())
print("\n=== MHONGO (todos los 1000 sujetos) ===")
print(df.MHONGO.value_counts().sort_index().to_string())
print("\n=== MHONGO × severidad (n=%d) ===" % len(cc))
print(pd.crosstab(cc.MHONGO, cc.severity).to_string())
print("\n=== Severidad × TRTGRP ===")
print(pd.crosstab(cc.TRTGRP, cc.severity).to_string())

cov_base = ['MHONGO','BCG','patients_seen_ord','expect_interact_b']
cov_full = cov_base + ['age_ord','sex_b','edu2','work_hours_ord'] + list(race_dum.columns)

def design(d): return pd.concat([d[cov_base+['age_ord','sex_b','edu2','work_hours_ord']].astype(float),
                                 race_dum.loc[d.index]], axis=1)

def fit_po(data, covs, label):
    Y = data.severity.astype(int); X = design(data)[covs].astype(float)
    m = OrderedModel(Y, X, distr='logit'); r = m.fit(method='bfgs', disp=False)
    names = [p for p in r.params.index if '/' not in str(p)]
    params = r.params[names]; conf = r.conf_int().loc[names]
    tab = pd.DataFrame({'coef':params,'OR':np.exp(params),
        'OR_lo95':np.exp(conf[0]),'OR_hi95':np.exp(conf[1]),'p':r.pvalues[names]})
    pct = 100*(np.exp(params['MHONGO'])-1); ci=(100*(np.exp(conf.loc['MHONGO',0])-1),100*(np.exp(conf.loc['MHONGO',1])-1))
    print(f"\n===== {label} =====  n={len(data)}  llf={r.llf:.2f}")
    print(tab.round(4).to_string())
    print(f">> MHONGO: {pct:+.1f}% odds/condición adicional (IC95% {ci[0]:+.1f}% a {ci[1]:+.1f}%)")
    return tab, pct, ci

tab_full, pct_full, ci_full = fit_po(cc, cov_full,
    "PRIMARIO: PO completo (COVID, complete-case)")
tab_red, pct_red, ci_red = fit_po(cc, cov_base,
    "SENSIBILIDAD 1: PO reducido (set solicitado)")

# ---------- 3. Proporcionalidad de odds ----------
print("\n=== Chequeo de proporcionalidad: logits binarios acumulados ===")
rows=[]
Xc = design(cc)[cov_full].astype(float)
for cut in [2,3,4]:
    y = (cc.severity>=cut).astype(int)
    m = sm.Logit(y, sm.add_constant(Xc)).fit(disp=False)
    rows.append({'umbral':f'>= {cut}','beta_MHONGO':round(m.params['MHONGO'],3),
        'OR_MHONGO':round(np.exp(m.params['MHONGO']),3),
        'IC95':f"[{np.exp(m.conf_int().loc['MHONGO',0]):.2f}, {np.exp(m.conf_int().loc['MHONGO',1]):.2f}]"})
print(pd.DataFrame(rows).to_string(index=False))

# ---------- 4. Sensibilidad: imputación AEOUT para los 43 sin AESEV ----------
cr = ae[covid_mask]
def imp(g):
    if g.AESEV.notna().any(): return g.AESEV.max()
    out=set(g.AEOUT.dropna())
    if out & {'Worse','Unchanged','Fatal'}: return 3.0
    if out & {'Resolved','Improved','Resolved_'}: return 1.0
    return np.nan
sev_imp = cr.groupby('USUBJID').apply(imp).rename('severity')
df_imp = df.copy(); df_imp['severity'] = sev_imp.reindex(df_imp.index).values
df_imp.loc[~df_imp.any_covid,'severity'] = np.nan
n_imputed = int((df_imp.any_covid & df.severity.isna() & df_imp.severity.notna()).sum())
print(f"\nSujetos COVID con AESEV faltante imputados vía AEOUT: {n_imputed}")
cc_imp = df_imp[df_imp.severity.notna() & df_imp.any_covid]
tab_imp, pct_imp, ci_imp = fit_po(cc_imp, cov_full,
    "SENSIBILIDAD 2: imputación AEOUT")

# ---------- 5. Sensibilidad: sin-COVID como categoría mínima (n=1000) ----------
df0 = df.copy(); df0['severity'] = df0.severity.fillna(0)
tab0, pct0, ci0 = fit_po(df0, cov_full,
    "SENSIBILIDAD 3: sin-COVID como categoría 0 (n=1000)")

# ---------- 6. Resumen ----------
print("\n================= RESUMEN =================")
print(f"PRIMARIO PO completo (n={len(cc)}): {pct_full:+.1f}% por condición (IC95% {ci_full[0]:+.1f} a {ci_full[1]:+.1f}), p={tab_full.loc['MHONGO','p']:.3f}")
print(f"PO reducido (n={len(cc)}): {pct_red:+.1f}% (IC95% {ci_red[0]:+.1f} a {ci_red[1]:+.1f}), p={tab_red.loc['MHONGO','p']:.3f}")
print(f"Imputado AEOUT (n={len(cc_imp)}): {pct_imp:+.1f}% (IC95% {ci_imp[0]:+.1f} a {ci_imp[1]:+.1f})")
print(f"Sin-COVID como 0 (n=1000): {pct0:+.1f}% (IC95% {ci0[0]:+.1f} a {ci0[1]:+.1f})")
