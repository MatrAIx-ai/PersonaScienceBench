"""
TASK008 BCG-CORONA: Interaction effect of BCG vaccination status x prior medical
history on COVID-19 severity, via ordinal (proportional-odds logit) regression
controlling for patient-interaction frequency.

Primary specification (researcher-fixed):
- Outcome (subject level, n=1000): max(AESEV) over AE rows with AEPT='COVID-19';
  0 if the subject has no COVID-19 AE (scale 0-4). Episodes with missing AESEV are
  EXCLUDED from the max (subject keeps max over recorded episodes, else 0).
- Prior medical history: binary '>=1 chronic condition' (MH block, MHORRES=2,
  excluding 'Current respiratory tract infection'; 'Other:' free text excluded).
- Control: patients_seen (1-50/51-100/>100 coded 1/2/3). expect_interact only in
  sensitivity. SEX/RACE/education and AEHS excluded from the primary model.
- Assumption declared: MHORRES 1=No, 2=Yes.
Reported: exp(beta_interaction) with 95% CI; stratified BCG ORs; proportional-odds
LRT (category-varying slopes vs common slopes); convergence and separation checks.
"""
import numpy as np, pandas as pd
from statsmodels.miscmodels.ordinal_model import OrderedModel
from scipy import stats, optimize

pd.set_option('display.width', 220)

# ---------- 1. Load ----------
dm = pd.read_csv('data/TASK008_BCG-CORONA_DM.csv', low_memory=False)
ae = pd.read_csv('data/TASK008_BCG-CORONA_AE.csv', low_memory=False)
mh = pd.read_csv('data/TASK008_BCG-CORONA_MH.csv', low_memory=False)

# ---------- 2. Outcome ----------
cov = ae[ae['AEPT'].astype(str).str.strip().str.lower() == 'covid-19'].copy()
print(f"COVID-19 AE rows: {len(cov)}; subjects with >=1 COVID-19 AE: {cov.USUBJID.nunique()}")

def subj_max_sev(df, col='AESEV'):
    g = df[df[col].notna()].groupby('USUBJID')[col].max()
    return g

sev_primary = subj_max_sev(cov)
y = pd.Series(dm.USUBJID.map(lambda u: sev_primary.get(u, 0.0)).values, index=dm.USUBJID.values)
print("\nPRIMARY outcome distribution (0 = no COVID-19 AE):")
print(y.value_counts().sort_index().to_string())

# Sensitivity: impute missing AESEV from AEOUT (Resolved=1, Improved/Unchanged=2, Worse=3, Fatal=4)
out2sev = {'Resolved':1,'Resolved_':1,'Improved':2,'Unchanged':2,'Worse':3,'Fatal':4,'N_A':np.nan}
cov_imp = cov.copy(); cov_imp['AESEV_imp'] = cov_imp.AESEV.fillna(cov_imp.AEOUT.map(out2sev))
sev_imp = cov_imp.groupby('USUBJID').AESEV_imp.max()
y_imp = pd.Series(dm.USUBJID.map(lambda u: sev_imp.get(u, 0.0)).values, index=dm.USUBJID.values)
print("\nSENSITIVITY A (AEOUT-imputed) outcome distribution:")
print(y_imp.value_counts().sort_index().to_string())

# ---------- 3. Comorbidity ----------
med = mh[(mh.MHSCAT == 'MEDICAL HISTORY') & mh.MHTERM.notna()]
CORE = ['Tuberculosis','Hypertension','Diabetes Mellitus','Chronic Obstructive Pulmonary Disease',
        'Asthma','Other lung disease','Cardiovascular disease','Cerebrovascular disease',
        'Kidney disease','Liver disease','Cancer','Organ or bone marrow transplantation',
        'Primary immunodeficiency','Neutropenia or lymphopenia','Allergy','Hay fever','chronic sinusitis']
chronic_yes = med[(med.MHORRES == 2) & med.MHTERM.isin(CORE)]
comorb = dm.USUBJID.isin(set(chronic_yes.USUBJID)).astype(int).values
cnt = chronic_yes.groupby('USUBJID').size()
comorb_count = dm.USUBJID.map(lambda u: cnt.get(u, 0)).astype(int).values
oth = med[med.MHTERM.astype(str).str.startswith('Other:') & (med.MHORRES == 2)]
comorb_plus = dm.USUBJID.isin(set(chronic_yes.USUBJID) | set(oth.USUBJID)).astype(int).values
print(f"\nComorbidity prevalence (primary binary): {comorb.sum()}/1000 ({100*comorb.mean():.1f}%)")
print(f"With 'Other:' free text added: {comorb_plus.sum()}/1000")

# ---------- 4. Design matrix ----------
X = pd.DataFrame({
    'BCG': (dm.TRTGRP == 'BCG').astype(int).values,
    'comorb': comorb,
    'BCG_x_comorb': (dm.TRTGRP == 'BCG').astype(int).values * comorb,
    'patients_seen': dm.patients_seen.map({'1-50':1,'51-100':2,'>100':3}).values,
}, index=dm.USUBJID.values)
print("\npatients_seen x comorb x TRTGRP cell counts:")
print(pd.crosstab([dm.TRTGRP.values, comorb], dm.patients_seen.values, rownames=['TRTGRP','comorb'],
                  colnames=['patients_seen']))

def celltable(yv):
    df = pd.DataFrame({'key': [f"{a} | com={b}" for a, b in zip(dm.TRTGRP.values, comorb)],
                       'y': yv.values})
    return df.groupby(['key', 'y']).size().unstack(fill_value=0)

# ---------- 5. Model fitting helpers ----------
def fit_ordered(yv, Xv, name):
    mod = OrderedModel(yv, Xv, distr='logit')
    res = mod.fit(method='bfgs', disp=False, maxiter=5000)
    print(f"\n===== {name} =====")
    print(res.summary())
    print("converged:", res.mle_retvals.get('converged'))
    return res

def report_ors(res, preds):
    names = list(preds)
    b = res.params[names]; V = res.cov_params().loc[names, names]
    i = names.index('BCG_x_comorb')
    est = b['BCG_x_comorb']; se = np.sqrt(V.iloc[i, i])
    ci = (np.exp(est-1.96*se), np.exp(est+1.96*se)); p = 2*stats.norm.sf(abs(est/se))
    print(f"\n>> OR(interaction BCG x comorbidity) = {np.exp(est):.3f} (95% CI {ci[0]:.3f}-{ci[1]:.3f}), p={p:.4f}")
    bb, bi = b['BCG'], b['BCG_x_comorb']
    v0 = V.loc['BCG','BCG']
    v1 = V.loc['BCG','BCG'] + 2*V.loc['BCG','BCG_x_comorb'] + V.loc['BCG_x_comorb','BCG_x_comorb']
    for lab, e, v in [('comorb=0', bb, v0), ('comorb=1', bb+bi, v1)]:
        s = np.sqrt(v)
        print(f">> OR(BCG vs placebo | {lab}) = {np.exp(e):.3f} (95% CI {np.exp(e-1.96*s):.3f}-{np.exp(e+1.96*s):.3f})")
    return np.exp(est), ci, p

# ---------- 6. Primary model ----------
res = fit_ordered(y, X, "PRIMARY: ordinal logit (proportional odds), outcome 0-4")
ors_primary = report_ors(res, ['BCG','comorb','BCG_x_comorb','patients_seen'])
print("\nOutcome x TRTGRP x comorb cell counts (primary):")
print(celltable(y))

# ---------- 7. Proportional-odds diagnostics ----------
# Custom cumulative-logit likelihood; validate against OrderedModel, then LRT vs
# a model with cut-specific slopes (Brant-style test of proportional odds).
def make_ll(yv, Xv):
    yv = np.asarray(yv, float); Xv = np.asarray(Xv, float)
    n, p = Xv.shape
    K = int(yv.max()) + 1; cuts_n = K - 1
    idx = yv.astype(int)
    def ll(par, varying):
        if not varying:
            beta = par[:p]; dth = par[p:]
            B = np.tile(beta, (cuts_n, 1))
        else:
            B = par[:cuts_n*p].reshape(cuts_n, p); dth = par[cuts_n*p:]
        th = np.concatenate([[dth[0]], dth[0] + np.cumsum(np.exp(dth[1:]))])
        eta = Xv @ B.T - th[None, :]                      # P(y>j) = logistic(xB_j - th_j) (statsmodels convention)
        Pgt = 1/(1+np.exp(-np.clip(eta, -500, 500)))
        Pcum = np.hstack([np.ones((n,1)), Pgt, np.zeros((n,1))])
        Pj = np.clip(Pcum[np.arange(n), idx] - Pcum[np.arange(n), idx+1], 1e-12, None)
        return np.log(Pj).sum()
    return ll, cuts_n, p

ll_fn, cuts_n, p = make_ll(y.values, X.values)
# start from OrderedModel solution (actual thresholds)
tr = res.model.transform_threshold_params(res.params)   # [-inf, t1..t4, inf]
t_act = tr[1:-1]
d0 = [t_act[0]] + list(np.log(np.diff(t_act)))
x0_po = np.r_[res.params[:p].values, d0]
ll_po_val = ll_fn(x0_po, varying=False)
print(f"\nValidation: OrderedModel logLik = {res.llf:.4f}; custom PO logLik = {ll_po_val:.4f}")
assert abs(ll_po_val - res.llf) < 1e-3, "custom likelihood mismatch"

opt_po = optimize.minimize(lambda q: -ll_fn(q, False), x0_po, method='Nelder-Mead',
                           options={'maxiter':20000, 'maxfev':40000, 'xatol':1e-8, 'fatol':1e-10})
x0_gol = np.r_[np.tile(opt_po.x[:p], cuts_n), opt_po.x[p:]]
opt_gol = optimize.minimize(lambda q: -ll_fn(q, True), x0_gol, method='Nelder-Mead',
                            options={'maxiter':60000, 'maxfev':120000, 'xatol':1e-8, 'fatol':1e-10})
lr = 2*(opt_gol.fun*-1 - opt_po.fun*-1) * -1  # 2*(ll_gol - ll_po)
lr = 2*((-opt_gol.fun) - (-opt_po.fun))
df_test = (cuts_n-1)*(p-1)
p_lr = stats.chi2.sf(max(lr,0), df_test)
print(f"\nPROPORTIONAL-ODDS CHECK (LRT: cut-specific slopes vs common slopes)")
print(f"  logLik(PO) = {-opt_po.fun:.3f}; logLik(varying) = {-opt_gol.fun:.3f}; LR = {lr:.3f}; df = {df_test}; p = {p_lr:.4f}")
print("  Cut-specific slope estimates (varying-slopes model):")
print(pd.DataFrame(opt_gol.x[:cuts_n*p].reshape(cuts_n, p)[:, 1:], columns=list(X.columns)[1:],
                   index=[f"P(y>{j+1})" for j in range(cuts_n)]))

# ---------- 8. Sensitivity analyses ----------
print("\n################ SENSITIVITY ANALYSES ################")
rA = fit_ordered(y_imp, X, "A: AEOUT-imputed severity (0-4)"); report_ors(rA, ['BCG','comorb','BCG_x_comorb','patients_seen'])
print(celltable(y_imp))

y3 = y.clip(upper=3)
rB = fit_ordered(y3, X, "B: outcome collapsed 0-3"); report_ors(rB, ['BCG','comorb','BCG_x_comorb','patients_seen'])

ei = (dm.expect_interact.values == 'Yes').astype(int)
Xc = X.copy(); Xc['expect_interact'] = ei
rC = fit_ordered(y, Xc[['BCG','comorb','BCG_x_comorb','expect_interact']], "C: control = expect_interact")
report_ors(rC, ['BCG','comorb','BCG_x_comorb','expect_interact'])
rD = fit_ordered(y, Xc[['BCG','comorb','BCG_x_comorb','patients_seen','expect_interact']],
                 "D: both patients_seen and expect_interact")
report_ors(rD, ['BCG','comorb','BCG_x_comorb','patients_seen','expect_interact'])

Xn = X.copy(); Xn['comorb'] = comorb_count; Xn['BCG_x_comorb'] = Xn['BCG']*Xn['comorb']
rE = fit_ordered(y, Xn, "E: comorbidity as count"); report_ors(rE, ['BCG','comorb','BCG_x_comorb','patients_seen'])

rti = ae[ae.AECAT == 'RTI']
sev_rti = subj_max_sev(rti)
y_rti = pd.Series(dm.USUBJID.map(lambda u: sev_rti.get(u, 0.0)).values, index=dm.USUBJID.values)
print("\nF: RTI-wide outcome distribution:"); print(y_rti.value_counts().sort_index().to_string())
rF = fit_ordered(y_rti, X, "F: RTI-wide outcome (0-4)"); report_ors(rF, ['BCG','comorb','BCG_x_comorb','patients_seen'])
print(celltable(y_rti))

Xp = X.copy(); Xp['comorb'] = comorb_plus; Xp['BCG_x_comorb'] = Xp['BCG']*Xp['comorb']
rG = fit_ordered(y, Xp, "G: comorbidity incl. 'Other:' free text"); report_ors(rG, ['BCG','comorb','BCG_x_comorb','patients_seen'])

# ---------- 9. Descriptives for the answer ----------
print("\n================ DESCRIPTIVES ================")
print("Row-% outcome distribution by TRTGRP x comorb (primary outcome):")
dfk = pd.DataFrame({'key': [f"{a} | com={b}" for a, b in zip(dm.TRTGRP.values, comorb)], 'y': y.values})
print((dfk.groupby('key').y.value_counts(normalize=True).unstack()*100).round(1))
print("\nMedian patients_seen code by outcome level:")
print(y.groupby(dm.patients_seen.values).mean())
