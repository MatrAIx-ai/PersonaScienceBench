#!/usr/bin/env python3
"""
BixBench bix-3-q5 -- full analysis
Q: After DE analysis on three tissue comparisons (Final vs Baseline blood,
   Dentate gyrus vs Baseline blood, Dentate gyrus vs Final blood) and a
   binomial exact test with a 5% threshold, which tissue comparison shows
   negligible effects?
Pipeline (approved): Step1 identify precomputed blocks (NNLS) -> Step2 Option A
primary unpaired NB-GLM ~ tissue -> Step3 paired sensitivity -> Step4 Option B
sensitivity -> Step5 binomial exact tests (two readings, 5% threshold).
"""
import numpy as np, pandas as pd
from scipy.optimize import nnls
from scipy.stats import binomtest, norm, ttest_ind

XLSX = "data/Data_deposition_RNAseq_Paroxetine_2017.xlsx"
ALPHA_DE = 0.05
log = []
def P(*a):
    s = " ".join(str(x) for x in a); print(s, flush=True); log.append(s)

# ------------------------------------------------------------------ load ----
nc = pd.read_excel(XLSX, sheet_name="NormCount", header=None)
sample_codes = list(nc.iloc[3, 2:92])
body = nc.iloc[4:]
data_end = pd.to_numeric(body[0], errors="coerce").notna()[::-1].idxmax()
genes = nc.iloc[4:data_end+1, 1].astype(str).tolist()
counts = nc.iloc[4:data_end+1, 2:92].apply(pd.to_numeric, errors="coerce")
counts.index = genes; counts.columns = sample_codes

meta = pd.DataFrame({"Code": sample_codes})
meta["Tissue"] = ["baseline_blood"]*30 + ["dentate_gyrus"]*30 + ["final_blood"]*30
meta["Response"] = (["Control"]*10+["good_responder"]*10+["bad_responder"]*10)*3
ms = pd.read_excel(XLSX, sheet_name="Mapping_statistics")
meta = meta.merge(ms[["Code", "Sample ID"]], on="Code", how="left")

# --------------------------------------------- Step 1: block identity (NNLS) --
P("=== Step 1: identity of the 9 precomputed DESeq blocks (NNLS) ===")
X = counts.values.astype(float)
identity = []
for k in range(1, 10):
    blk = nc.iloc[4:data_end+1, 98+9*(k-1):107+9*(k-1)].apply(pd.to_numeric, errors="coerce")
    blk.index = genes
    rec = {"Comparison": k}
    for side, j in [("A", 1), ("B", 2)]:
        y = blk.iloc[:, j].values.astype(float)
        m = np.isfinite(y)
        coef, _ = nnls(X[m], y[m])
        idx = np.where(coef > 1e-6)[0]
        dom = [sample_codes[i] for i in idx if coef[i] > 0.01*coef[idx].max()]
        rel = float(np.nanmedian(np.abs(X[m]@coef - y[m]) / np.maximum(np.abs(y[m]), 1e-9)))
        mset = meta.set_index("Code")
        tis = sorted({mset.Tissue[c] for c in dom})[0]
        resp = "+".join(sorted({mset.Response[c] for c in dom}))
        full = [f"{resp}_{tis}{i}" for i in range(1, 11)]
        rec[f"{side}_n"] = len(dom)
        rec[f"{side}_group"] = f"{resp}_{tis}"
        rec[f"{side}_excluded"] = ";".join(sorted(set(full)-set(dom)))
        rec[f"{side}_medreldev"] = round(rel, 6)
    identity.append(rec)
ident = pd.DataFrame(identity)
P(ident[["Comparison","A_n","A_group","A_excluded","A_medreldev",
         "B_n","B_group","B_excluded","B_medreldev"]].to_string(index=False))
P("VERDICT: all 9 blocks are Response contrasts WITHIN one tissue; "
  "NONE is a tissue comparison (Final vs Baseline blood, DG vs Baseline, DG vs Final).")

# ------------------------------------------ Step 2: NB-GLM tissue contrasts --
P("\n=== Step 2: Option A (primary, unpaired) design ~ tissue ===")
Yf = np.rint(counts.values).astype(float)            # rounded counts
gm_gene = np.exp(np.nanmean(np.where(Yf > 0, np.log(Yf), np.nan), axis=1))
valid = gm_gene > 0
sfs = np.median(np.divide(Yf[valid], gm_gene[valid, None]), axis=0)
P(f"Size factors (median-of-ratios): min={sfs.min():.3f} max={sfs.max():.3f}")
keep_genes = Yf.sum(axis=1) >= 10
P(f"Gene pre-filter (total rounded counts >= 10): {int(keep_genes.sum())} of {len(genes)} kept")
Yk = Yf[keep_genes]; off = np.log(sfs)

def irls_nb(Ymat, Xdes, off_vec, alpha_vec, n_iter=60, tol=1e-8):
    G, N = Ymat.shape; p = Xdes.shape[1]
    mu0 = (Ymat + 0.5) / np.exp(off_vec)[None, :]
    beta = np.linalg.lstsq(Xdes, np.log(mu0).T, rcond=None)[0].T
    for it in range(n_iter):
        eta_lin = beta @ Xdes.T + off_vec[None, :]
        mu = np.exp(np.clip(eta_lin, -30, 30))
        W = mu / (1.0 + alpha_vec[:, None]*mu)
        Z = eta_lin + (Ymat - mu)/np.maximum(mu, 1e-12) - off_vec[None, :]
        WX = W[:, :, None] * Xdes[None, :, :]
        M2 = np.einsum("gnp,gnq->gpq", WX, WX)
        M1 = np.einsum("gn,np->gp", W*Z, Xdes)
        beta_new = np.linalg.solve(M2 + 1e-10*np.eye(p)[None], M1[:, :, None])[..., 0]
        delta = np.max(np.abs(beta_new - beta), axis=1)/(1e-3 + np.max(np.abs(beta_new), axis=1))
        beta = beta_new
        if np.nanmax(delta) < tol:
            break
    mu = np.exp(np.clip(beta @ Xdes.T + off_vec[None, :], -30, 30))
    return beta, mu, it

def trend_dispersion(Ymat, off_vec, nbins=100, floor=1e-4, cap=10.0):
    X0 = np.ones((Ymat.shape[1], 1))
    _, mu0, _ = irls_nb(Ymat, X0, off_vec, np.full(Ymat.shape[0], 1e-8))
    n, p = Ymat.shape[1], 1
    alpha_gw = ((Ymat-mu0)**2).sum(1) - (n-p)*mu0.mean(1)
    alpha_gw = alpha_gw / np.maximum((mu0**2).sum(1), 1e-12)
    alpha_gw = np.clip(alpha_gw, floor, cap)
    lx = np.log10(mu0.mean(1) + 1e-3)
    bins = np.linspace(lx.min(), lx.max(), nbins+1)
    which = np.clip(np.digitize(lx, bins)-1, 0, nbins-1)
    trend = np.array([np.median(alpha_gw[which == b]) for b in range(nbins)])
    centers = np.array([(bins[b]+bins[b+1])/2 for b in range(nbins)])
    ok = np.isfinite(trend)
    return np.clip(np.interp(lx, centers[ok], trend[ok]), floor, cap), alpha_gw

def bh(p):
    p = np.asarray(p, float); n = len(p); o = np.argsort(p)
    q = p[o]*n/np.arange(1, n+1); q = np.minimum.accumulate(q[::-1])[::-1]
    out = np.empty(n); out[o] = np.clip(q, 0, 1); return out

def nb_contrasts(Ymat, Xdes, off_vec, alpha_vec, contrasts):
    beta, mu, it = irls_nb(Ymat, Xdes, off_vec, alpha_vec)
    W = mu/(1.0+alpha_vec[:, None]*mu)
    WX = W[:, :, None] * Xdes[None, :, :]
    M2 = np.einsum("gnp,gnq->gpq", WX, WX) + 1e-10*np.eye(Xdes.shape[1])[None]
    out = {}
    for name, cvec in contrasts.items():
        c = np.asarray(cvec, float)
        sol = np.linalg.solve(M2, np.broadcast_to(c, (M2.shape[0], M2.shape[2]))[:, :, None])[..., 0]
        var = np.einsum("gp,p->g", sol, c)
        est = beta @ c
        z = est/np.sqrt(np.maximum(var, 1e-300))
        pval = 2*norm.sf(np.abs(z))
        out[name] = {"est": est, "pval": pval, "padj": bh(pval)}
    return out, it

alpha_trend, _ = trend_dispersion(Yk, off)
P(f"Trended dispersion: 5th pct={np.percentile(alpha_trend,5):.4f} "
  f"median={np.median(alpha_trend):.4f} 95th pct={np.percentile(alpha_trend,95):.4f}")
tissue = meta.Tissue.values
Xdes = np.column_stack([np.ones(len(tissue)),
                        (tissue == "dentate_gyrus").astype(float),
                        (tissue == "final_blood").astype(float)])
contrasts = {
    "final_blood_vs_baseline_blood": [0, 0, 1],
    "dentate_gyrus_vs_baseline_blood": [0, 1, 0],
    "dentate_gyrus_vs_final_blood": [0, 1, -1],
}
resA, itA = nb_contrasts(Yk, Xdes, off, alpha_trend, contrasts)
P(f"IRLS converged in {itA} iterations")

summary = []
def add_result(name, variant, r):
    padj = r["padj"]; n = len(padj)
    deg = int((padj < ALPHA_DE).sum())
    up = int(((padj < ALPHA_DE) & (r["est"] > 0)).sum()); down = deg - up
    bA = binomtest(deg, n, p=ALPHA_DE, alternative="greater")
    bB = binomtest(up, deg, p=0.5, alternative="two-sided") if deg else None
    bAu = binomtest(up, n, p=ALPHA_DE, alternative="greater")
    bAd = binomtest(down, n, p=ALPHA_DE, alternative="greater")
    summary.append({"comparison": name, "variant": variant, "tested": n,
                    "DEG": deg, "up": up, "down": down,
                    "DEG_fraction": round(deg/n, 5),
                    "binomA_p": bA.pvalue, "binomA_sig_5pct": bA.pvalue < 0.05,
                    "binomA_up_p": bAu.pvalue, "binomA_up_enriched": bAu.pvalue < 0.05,
                    "binomA_down_p": bAd.pvalue, "binomA_down_enriched": bAd.pvalue < 0.05,
                    "binomB_p": (bB.pvalue if bB else np.nan),
                    "binomB_sig_5pct": (bool(bB.pvalue < 0.05) if bB else False)})
    P(f"  [{variant}] {name}: tested={n} DEG={deg} (up={up}, down={down}) "
      f"frac={deg/n:.4f} binomA_p={bA.pvalue:.3g} binomB_p="
      f"{(bB.pvalue if bB else float('nan')):.3g}")

P("\n--- DEG counts and binomial exact tests (unpaired primary) ---")
for name in contrasts:
    add_result(name, "unpaired NB-GLM ~ tissue (Option A, primary)", resA[name])
np.save("analysis/resA_final.npy", resA["final_blood_vs_baseline_blood"]["padj"], allow_pickle=True)
np.save("analysis/resA_dg_base.npy", resA["dentate_gyrus_vs_baseline_blood"]["padj"], allow_pickle=True)
np.save("analysis/resA_dg_final.npy", resA["dentate_gyrus_vs_final_blood"]["padj"], allow_pickle=True)

# ------------------------------------- Step 3: paired sensitivity (blood) ----
P("\\n=== Step 3: paired sensitivity: Final vs Baseline blood, ~ subject + time ===")
def subj_of(sid):
    parts = sid.split("_")   # um mueller 2017 02 NN SS suffix
    return parts[5]
blood_idx = [i for i,t in enumerate(tissue) if t in ("baseline_blood","final_blood")]
blood_codes = [sample_codes[i] for i in blood_idx]
blood_sid = [subj_of(meta.set_index("Code").loc[c,"Sample ID"]) for c in blood_codes]
# verify each subject has exactly 1 baseline and 1 final sample
from collections import Counter
cnt = Counter(blood_sid)
P(f"Subject linkage via Sample ID field 6: {len(cnt)} subjects; "
  f"all appear exactly twice: {all(v==2 for v in cnt.values())}")
Yb = Yk[:, blood_idx] + 0.5
offb = off[blood_idx]
tb = tissue[blood_idx]
lev = sorted(set(blood_sid))
Xp = np.column_stack([np.ones(len(tb))] + [(np.array(blood_sid)==l).astype(float) for l in lev[1:]]
                     + [(tb=="final_blood").astype(float)])
alpha_bp, _ = trend_dispersion(Yb, offb, cap=10.0)
resBp, itBp = nb_contrasts(Yb, Xp, offb, alpha_bp,
                           {"final_vs_baseline_blood_paired": [0.0]*(Xp.shape[1]-1) + [1.0]})
P(f"paired IRLS iterations: {itBp}")
add_result("final_blood_vs_baseline_blood", "paired NB-GLM ~ subject+time (sensitivity)", 
           resBp["final_vs_baseline_blood_paired"])

# ------------------------------------- Step 4: Option B sensitivity ---------
P("\\n=== Step 4: Option B sensitivity (log2 + Welch t-test + BH) ===")
Ln = np.log2(Yk/np.exp(off)[None,:] + 1.0)
for name, (g1, g2) in {
    "final_blood_vs_baseline_blood": ("final_blood", "baseline_blood"),
    "dentate_gyrus_vs_baseline_blood": ("dentate_gyrus", "baseline_blood"),
    "dentate_gyrus_vs_final_blood": ("dentate_gyrus", "final_blood")}.items():
    a = Ln[:, tissue == g1]; b = Ln[:, tissue == g2]
    t, pv = ttest_ind(a, b, axis=1, equal_var=False)
    pv = np.nan_to_num(pv, nan=1.0)
    padj = bh(pv)
    est = b.mean(1) - a.mean(1)   # est>0: higher in g2 (contrast group)
    deg = int((padj < ALPHA_DE).sum())
    up = int(((padj < ALPHA_DE) & (est > 0)).sum()); down = deg-up
    bA = binomtest(deg, len(padj), p=ALPHA_DE, alternative="greater")
    bB = binomtest(up, deg, p=0.5, alternative="two-sided") if deg else None
    bAu = binomtest(up, len(padj), p=ALPHA_DE, alternative="greater")
    bAd = binomtest(down, len(padj), p=ALPHA_DE, alternative="greater")
    summary.append({"comparison": name, "variant": "log2 Welch t-test (Option B)",
                    "binomA_up_p": bAu.pvalue, "binomA_up_enriched": bAu.pvalue < 0.05,
                    "binomA_down_p": bAd.pvalue, "binomA_down_enriched": bAd.pvalue < 0.05,
                    "tested": len(padj), "DEG": deg, "up": up, "down": down,
                    "DEG_fraction": round(deg/len(padj), 5),
                    "binomA_p": bA.pvalue, "binomA_sig_5pct": bA.pvalue < 0.05,
                    "binomB_p": (bB.pvalue if bB else np.nan),
                    "binomB_sig_5pct": (bool(bB.pvalue < 0.05) if bB else False)})
    P(f"  [Option B] {name}: tested={len(padj)} DEG={deg} (up={up}, down={down}) "
      f"frac={deg/len(padj):.4f} binomA_p={bA.pvalue:.3g} "
      f"binomB_p={(bB.pvalue if bB else float('nan')):.3g}")

# ---------------------------------------------------------------- summary ---
P("\\n=== FINAL SUMMARY (DEG counts and binomial exact tests, 5% threshold) ===")
summ = pd.DataFrame(summary)
P(summ.to_string(index=False))
summ.to_csv("analysis/binomial_summary.csv", index=False)
ident.to_csv("analysis/comparison_identity.csv", index=False)

# concise verdict
P("\\n=== VERDICT ===")
prim = summ[(summ.comparison=="final_blood_vs_baseline_blood") & (summ.variant.str.startswith("unpaired"))].iloc[0]
for comp in ["final_blood_vs_baseline_blood","dentate_gyrus_vs_baseline_blood","dentate_gyrus_vs_final_blood"]:
    row = summ[(summ.comparison==comp) & (summ.variant.str.startswith("unpaired"))].iloc[0]
    P(f"{comp}: DEG={row.DEG}/{row.tested} ({row.DEG_fraction:.1%}) [up={row.up} ({row.up/row.tested:.1%}), "
      f"down={row.down} ({row.down/row.tested:.1%})]; "
      f"binomA-global p={row.binomA_p:.3g} (sig={row.binomA_sig_5pct}); "
      f"binomA-up p={row.binomA_up_p:.3g} (enriched={row.binomA_up_enriched}); "
      f"binomA-down p={row.binomA_down_p:.3g} (enriched={row.binomA_down_enriched}); "
      f"binomB (up vs down) p={row.binomB_p:.3g} (sig={row.binomB_sig_5pct})")
with open("analysis/run_log.txt", "w") as f: f.write("\n".join(log))
print("ALL DONE")
