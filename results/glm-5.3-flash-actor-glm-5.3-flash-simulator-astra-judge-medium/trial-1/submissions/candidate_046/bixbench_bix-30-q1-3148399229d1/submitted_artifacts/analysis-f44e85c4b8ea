"""
BixBench bix-30-q1 — Differential expression of serum miRNAs (DM1 patients vs controls)
Input: data/pone.0150501.s002.xls (Table S1: Ct values for 175 miRNAs, 10 DM1 patients P_1..P_10,
10 healthy controls C_11..C_20).

Approved methodology (researcher-confirmed):
- Independent (unpaired) design; groups defined by sample-name prefix (P_ -> patient, C_ -> control).
- Welch two-sided t-test per miRNA on Ct values (alpha = 0.05, BEFORE multiple-testing correction);
  pooled-variance t-test computed as a robustness check.
- Pairwise deletion of 'NAN' (no imputation, no Ct>=35 filter in the main calculation).
- Primary answer: percentage of the 175 miRNAs with p < 0.05; absolute count included;
  Benjamini-Hochberg FDR reported only as secondary context.
- Direction: delta = mean(Ct_control) - mean(Ct_paciente); delta > 0 => up-regulated in patients
  (lower Ct = higher expression).
"""
import struct, csv, math

# ---------- minimal OLE2 + BIFF8 reader (xlrd/LibreOffice unavailable in this sandbox) ----------
def read_ole(path):
    data = open(path,'rb').read()
    assert data[:8] == b'\xd0\xcf\x11\xe0\xa1\xb1\x1a\xe1'
    u16 = lambda o: struct.unpack_from('<H', data, o)[0]
    u32 = lambda o: struct.unpack_from('<I', data, o)[0]
    ssize = 1 << u16(0x1E); mini_cut = u32(0x38)
    difat = list(struct.unpack_from('<109I', data, 0x4C))
    s = u32(0x44)
    for _ in range(u32(0x48)):
        off = 512 + s*ssize
        if off >= len(data): break
        vals = struct.unpack_from('<%dI'%(ssize//4), data, off)
        difat.extend(vals[:-1]); s = vals[-1]
    FAT = []
    for fs in [d for d in difat[:u32(0x2C)] if d < 0xFFFFFFFA]:
        o = 512 + fs*ssize
        if o < len(data): FAT.extend(struct.unpack_from('<%dI'%(ssize//4), data, o))
    chain = lambda st: (lambda c: [c for c in iter(lambda cc=st: None, 1)])(st)  # placeholder
    def _chain(start):
        out=[]; c=start
        while c < 0xFFFFFFFA:
            out.append(c); c = FAT[c]
        return out
    def read_stream(start, size):
        return b''.join(data[512+c*ssize:512+(c+1)*ssize] for c in _chain(start))[:size or None]
    dirbuf = read_stream(u32(0x30), 0)
    entries=[]
    for i in range(len(dirbuf)//128):
        e = dirbuf[i*128:(i+1)*128]
        nlen = struct.unpack_from('<H', e, 0x40)[0]
        entries.append((e[:max(0,nlen-2)].decode('utf-16-le','replace'), e[0x42],
                        struct.unpack_from('<I', e, 0x74)[0], struct.unpack_from('<I', e, 0x78)[0]))
    root = next(e for e in entries if e[1]==5)
    minibuf = read_stream(root[2], root[3])
    mfat=[]
    for ms in _chain(u32(0x3C)):
        o = 512 + ms*ssize
        if o < len(data): mfat.extend(struct.unpack_from('<%dI'%(ssize//4), data, o))
    def read_mini(start, size):
        out=b''; c=start
        while c < 0xFFFFFFFA:
            out += minibuf[c*64:(c+1)*64]; c = mfat[c]
        return out[:size]
    streams={}
    for name, typ, start, size in entries:
        if typ==2:
            streams[name] = read_mini(start,size) if size < mini_cut else read_stream(start,size)
    return streams

def read_xlstr(b, off, cch, flags):
    rich, far = flags & 8, flags & 4
    if rich: nrun = struct.unpack_from('<H', b, off)[0]; off += 2+4*nrun
    if far: off += 4
    if flags & 1:
        s = b[off:off+2*cch].decode('utf-16-le','replace'); off += 2*cch
    else:
        s = b[off:off+cch].decode('latin-1'); off += cch
    return s, off

def parse_workbook(wb):
    pos=0; sst=[]; cells={}
    while pos < len(wb)-4:
        rec, ln = struct.unpack_from('<HH', wb, pos); p = wb[pos+4:pos+4+ln]
        if rec == 0x00FC:  # SST
            unique = struct.unpack_from('<I', p, 4)[0]; off = 8; sst=[]
            for _ in range(unique):
                cch = struct.unpack_from('<H', p, off)[0]; g = p[off+2]; off += 3
                s, off = read_xlstr(p, off, cch, g); sst.append(s)
        elif rec == 0x0203:  # NUMBER
            r, c = struct.unpack_from('<HH', p, 0)
            cells[(r,c)] = struct.unpack_from('<d', p, 6)[0]
        elif rec == 0x00FD:  # LABELSST
            r, c, xf, i = struct.unpack_from('<HHHI', p, 0); cells[(r,c)] = sst[i]
        elif rec == 0x0293 and len(p) > 8:  # RSTRING
            r, c = struct.unpack_from('<HH', p, 0)
            cells[(r,c)] = read_xlstr(p, 8, p[6], p[7])[0]
        pos += 4+ln
    return cells

# ---------- statistics ----------
from scipy import stats
def ttest(a, b, welch=True):
    t, p = stats.ttest_ind(b, a, equal_var=not welch)   # mean(control) - mean(patient) direction
    df = (len(a)+len(b)-2) if not welch else None
    if welch:
        n1, n2 = len(a), len(b); import math
        m1, m2 = sum(a)/n1, sum(b)/n2
        v1 = sum((x-m1)**2 for x in a)/(n1-1); v2 = sum((x-m2)**2 for x in b)/(n2-1)
        df = (v1/n1+v2/n2)**2/((v1/n1)**2/(n1-1)+(v2/n2)**2/(n2-1))
    return t, df, p

def bh_adjust(pvals):
    n = len(pvals); idx = sorted(range(n), key=lambda i: pvals[i])
    adj = [0.0]*n; prev = 1.0
    for rank in range(n, 0, -1):
        i = idx[rank-1]; val = pvals[i]*n/rank
        prev = min(prev, val); adj[i] = min(1.0, prev)
    return adj

# ---------- main ----------
streams = read_ole('data/pone.0150501.s002.xls')
wb = streams['Workbook']
cells = parse_workbook(wb)
rows = sorted({r for r,c in cells})
# header row (row index 1) sample names, cols 1..20
samples = {c: cells[(1,c)] for c in range(1,21)}
p_cols = [c for c in samples if samples[c].startswith('P_')]
c_cols = [c for c in samples if samples[c].startswith('C_')]
assert len(p_cols)==10 and len(c_cols)==10, (p_cols, c_cols)

results = []
for r in rows:
    if r < 2 or (r,0) not in cells: continue
    name = cells[(r,0)]
    pv = [cells.get((r,c)) for c in p_cols]
    cv = [cells.get((r,c)) for c in c_cols]
    pmiss = [v for v in pv if isinstance(v,str)]
    cmiss = [v for v in cv if isinstance(v,str)]
    a = [float(v) for v in pv if not isinstance(v,str)]
    b = [float(v) for v in cv if not isinstance(v,str)]
    t_w, df_w, p_w = ttest(b, a, welch=True)      # mean(control) - mean(patient) direction
    t_p, df_p, p_p = ttest(b, a, welch=False)
    results.append(dict(miRNA=name, n_patient=len(a), n_control=len(b),
                        miss_p=len(pmiss), miss_c=len(cmiss),
                        mean_p=sum(a)/len(a), mean_c=sum(b)/len(b),
                        delta=sum(b)/len(b)-sum(a)/len(a),
                        t_welch=t_w, df_welch=df_w, p_welch=p_w, t_pooled=t_p, df_pooled=df_p, p_pooled=p_p))

assert len(results)==175, len(results)
for r_, padj in zip(results, bh_adjust([x['p_welch'] for x in results])):
    r_['p_bh'] = padj

sig_w  = [r_ for r_ in results if r_['p_welch']  < 0.05]
sig_p  = [r_ for r_ in results if r_['p_pooled'] < 0.05]
sig_bh = [r_ for r_ in results if r_['p_bh']     < 0.05]

# export full table
with open('results_miRNA_ttests.csv','w',newline='') as f:
    w = csv.writer(f)
    w.writerow(['miRNA','n_patient','n_control','missing_patient','missing_control',
                'mean_Ct_patient','mean_Ct_control','delta_Ct(ctrl-pat)',
                't_welch','df_welch','p_welch','p_BH','p_pooled','sig_p<0.05_welch','up_in_patients'])
    for r_ in results:
        w.writerow([r_['miRNA'], r_['n_patient'], r_['n_control'], r_['miss_p'], r_['miss_c'],
                    f"{r_['mean_p']:.4f}", f"{r_['mean_c']:.4f}", f"{r_['delta']:.4f}",
                    f"{r_['t_welch']:.4f}", f"{r_['df_welch']:.1f}", f"{r_['p_welch']:.3e}",
                    f"{r_['p_bh']:.3e}", f"{r_['p_pooled']:.3e}",
                    'YES' if r_['p_welch']<0.05 else 'no',
                    'UP' if r_['delta']>0 else 'DOWN'])

# export extracted matrix as evidence
with open('matrix_ct_extracted.csv','w',newline='') as f:
    w = csv.writer(f); w.writerow(['miRNA']+[samples[c] for c in range(1,21)])
    for r in rows:
        if r < 2 or (r,0) not in cells: continue
        w.writerow([cells[(r,0)]] + [repr(cells.get((r,c))) for c in range(1,21)])

# context: Ct >= 35 values
n_hi = sum(1 for (r,c),v in cells.items() if r>=2 and 1<=c<=20 and not isinstance(v,str) and v>=35)

print(f"miRNAs analyzed: {len(results)}   samples: 10 patients (P_), 10 controls (C_)")
print(f"'NAN' cells excluded pairwise: {sum(r_['miss_p']+r_['miss_c'] for r_ in results)} "
      f"(in {sum(1 for r_ in results if r_['miss_p']+r_['miss_c']>0)} miRNAs); values Ct>=35 (context): {n_hi}")
print()
print("MINI-TABLE — miRNAs significant at p<0.05 (Welch, pre-correction):")
print(f"{'miRNA':<18}{'mean Ct pat':>12}{'mean Ct ctrl':>13}{'delta':>9}{'p (Welch)':>12}{'p (pooled)':>12}{'p (BH)':>10}  dir")
for r_ in sorted(sig_w, key=lambda x: x['p_welch']):
    print(f"{r_['miRNA']:<18}{r_['mean_p']:>12.2f}{r_['mean_c']:>13.2f}{r_['delta']:>9.2f}"
          f"{r_['p_welch']:>12.2e}{r_['p_pooled']:>12.2e}{r_['p_bh']:>10.2e}  "
          f"{'UP in patients' if r_['delta']>0 else 'DOWN in patients'}")
print()
print(f"PRIMARY: {len(sig_w)}/175 = {100*len(sig_w)/175:.1f}% of miRNAs significant at p<0.05 (Welch, unpaired, pre-correction)")
print(f"Robustness (pooled-variance t): {len(sig_p)}/175 = {100*len(sig_p)/175:.1f}%  "
      f"-> {'SAME set' if {r_['miRNA'] for r_ in sig_w}=={r_['miRNA'] for r_ in sig_p} else 'DIFFERS: '+str({r_['miRNA'] for r_ in sig_w} ^ {r_['miRNA'] for r_ in sig_p})}")
print(f"Secondary context (FDR-BH q<0.05): {len(sig_bh)}/175 = {100*len(sig_bh)/175:.1f}% "
      f"({', '.join(r_['miRNA'] for r_ in sig_bh) if sig_bh else 'none'})")
up = sum(1 for r_ in sig_w if r_['delta']>0)
print(f"Direction among significant (Welch): {up} up-regulated / {len(sig_w)-up} down-regulated in patients")
