#!/usr/bin/env python3
# -*- coding: utf-8 -*-
"""
BixBench bix-33-q1 — ¿Qué tipo de célula inmunitaria tiene el mayor número de genes
diferencialmente expresados (DEGs) significativos tras el tratamiento con AAV9
mini-distrofina?

Método aprobado (ver handoff de plan):
  * Vía Excel: contar genes ÚNICOS con p_val_adj < 0.05 en cada una de las 25 hojas
    (tablas DE Post-vs-Pre por tipo celular, formato Seurat FindMarkers).
  * Criterio principal SIN filtrar por dirección; desglose up/down como sensibilidad.
  * Sensibilidad de umbral: p_val_adj < 0.1 y filtro adicional |avg_log2FC| > 0.25.
  * El h5ad se usa SOLO para comprobaciones ligeras de coherencia:
      (a) los genes de las hojas existen en raw/var (20.863 genes),
      (b) orientación de avg_log2FC (Post vs Pre) con genes de respuesta interferón
          y con la concordancia sign(FC) vs pct.1 - pct.2.

SUPUESTOS DOCUMENTADOS (aprobados por el investigador):
  A1. Las hojas NO están pre-filtradas por significancia: contienen 13.697 filas en
      total, de las cuales solo 952 cumplen p_val_adj < 0.05. Por eso el conteo aplica
      el umbral sobre las filas de cada hoja en lugar de contar filas.
  A2. Las hojas tampoco son la lista completa de genes testados (listas parciales del
      suplemento); se asume que ese sesgo de inclusión afecta por igual a todos los
      tipos celulares y no altera la comparación relativa.
  A3. p_val_adj ya viene calculado en el archivo (corrección de Seurat/Bonferroni
      sobre los genes testados); se usa tal cual, sin recalcular.
  A4. avg_log2FC y pct.1/pct.2 están orientados Post (clase 1) vs Pre (clase 2); se
      verifica empíricamente (comprobación de orientación).
  A5. Deduplicación por nombre de gen dentro de cada hoja.
  A6. No se re-ejecuta DE sobre el h5ad: obs no contiene las etiquetas de los 25 tipos
      celulares (los clusters 0-17 son genéricos), por lo que re-ejecutar introduciría
      discrepancias con el suplemento.
  A7. Excel corrompió 12 símbolos génicos tipo fecha ("d-Mar", formato 'd-mmm':
      aliases clásicos de la familia MARCH), que openpyxl devuelve como datetime.
      Se recuperan como "d-Mar" y, para la comprobación de existencia en raw/var,
      también se prueba su forma moderna MARCHF{d}.
"""
import struct, sys, re
import pandas as pd

XLSX = "../data/Supplemental Data File 1 PostvsPre_DEG_tables_ANNOTATED by_cell_type.xlsx"
H5AD = "../data/MS_DMD_all_conga_final.h5ad"

sys.path.insert(0, ".")
from h5meta import R, obj_header_msgs, list_group, root_entries

# ----------------------------------------------------------------------------
# 1) Análisis principal: conteo de DEGs significativos por tipo celular (Excel)
# ----------------------------------------------------------------------------
import openpyxl, datetime

def read_sheet_genes(path):
    """Lee cada hoja devolviendo (DataFrame con columna 'gene', nº de símbolos
    recuperados de corrupción de fechas) (supuesto A7)."""
    wb = openpyxl.load_workbook(path, read_only=True, data_only=True)
    out = {}
    for s in wb.sheetnames:
        ws = wb[s]
        rows = ws.iter_rows(values_only=True)
        header = next(rows)
        genes, n_date = [], 0
        for row in rows:
            v = row[0]
            if v is None:
                continue
            if isinstance(v, datetime.datetime):        # p. ej. '7-Mar' -> MARCHF7
                genes.append(v.strftime('%d-%b').lstrip('0'))
                n_date += 1
            else:
                genes.append(str(v))
        data = [r for r in ws.iter_rows(min_row=2, values_only=True)]
        out[s] = (pd.DataFrame({'gene': genes,
                                'p_val': [r[1] for r in data],
                                'avg_log2FC': [r[2] for r in data],
                                'pct.1': [r[3] for r in data],
                                'pct.2': [r[4] for r in data],
                                'p_val_adj': [r[5] for r in data]}),
                  n_date)
    return out

SHEETS = read_sheet_genes(XLSX)

def sheet_df(sheet):
    return SHEETS[sheet][0]

sheet_names = list(SHEETS.keys())
records = []
for sheet in sheet_names:
    df = sheet_df(sheet)
    n_rows = len(df)
    df = df.drop_duplicates(subset='gene')          # A5: deduplicación por gen
    sig = df[df['p_val_adj'] < 0.05]                # criterio principal
    up = sig[sig['avg_log2FC'] > 0]
    down = sig[sig['avg_log2FC'] < 0]
    records.append({
        'cell_type': sheet,
        'rows_in_sheet': n_rows,
        'unique_genes': len(df),
        'DEG_adj<0.05': len(sig),
        'up(FC>0)': len(up),
        'down(FC<0)': len(down),
        'DEG_adj<0.1': int((df['p_val_adj'] < 0.1).sum()),
        'DEG_adj<0.05 & |FC|>0.25': int(((df['p_val_adj'] < 0.05) & (df['avg_log2FC'].abs() > 0.25)).sum()),
    })
res = pd.DataFrame(records).sort_values('DEG_adj<0.05', ascending=False).reset_index(drop=True)
print("=== Tabla principal: DEGs significativos (p_val_adj < 0.05) por tipo celular ===")
print(res.to_string(index=False))
winner = res.iloc[0]
print(f"\nGanador: {winner.cell_type} con {winner['DEG_adj<0.05']} DEGs significativos "
      f"({winner['up(FC>0)']} up / {winner['down(FC<0)']} down)")

# ----------------------------------------------------------------------------
# 2) Comprobación (a): los genes de las hojas existen en raw/var del h5ad
# ----------------------------------------------------------------------------
def get_oh(r, ents, path):
    oh = None
    for part in path.split('/')[1:]:
        sub, _ = list_group(r, oh) if oh else (ents, None)
        oh = {n: h for n, h, k, e in sub}.get(part)
    return oh

def read_contig_vlen(r, oh):
    """Lee un dataset 1-D contiguo de strings variable-length (h5py)."""
    dims = None; dt = None; lay = None
    for mtype, d in obj_header_msgs(r, oh):
        if mtype == 1:
            rank = r.u(d+1, 1)[0]
            dims = [struct.unpack('<Q', r.u(d+8+8*i, 8))[0] for i in range(rank)]
        elif mtype == 3:
            dt = (r.u(d, 1)[0] & 0xf, struct.unpack('<I', r.u(d+4, 4))[0])
        elif mtype == 8:
            b = r.u(d, 24)
            if b[0] == 3 and b[1] == 1:                      # v3, contiguo
                lay = (struct.unpack('<Q', b[2:10])[0], struct.unpack('<Q', b[10:18])[0])
    cls, esz = dt
    raw = r.u(lay[0], lay[1])
    assert cls == 9 and esz == 16, (cls, esz)
    out = []
    for i in range(dims[0]):
        e = raw[i*16:(i+1)*16]
        ln = struct.unpack('<I', e[0:4])[0]
        haddr = struct.unpack('<Q', e[4:12])[0]
        idx = struct.unpack('<I', e[12:16])[0]
        p = haddr + 16                                        # GCOL collection
        while True:
            oi = struct.unpack('<H', r.u(p, 2))[0]
            osz = struct.unpack('<Q', r.u(p+8, 8))[0]
            data = r.u(p+16, osz)
            if oi == idx:
                out.append(data[:ln].decode())
                break
            p += 16 + osz + ((8 - (osz % 8)) % 8)
    return out

r, ents = root_entries(H5AD)
raw_var = read_contig_vlen(r, get_oh(r, ents, '/raw/var/_index'))
var715 = read_contig_vlen(r, get_oh(r, ents, '/var/_index'))
print(f"\n=== Comprobación (a): genes en el h5ad ===")
print(f"raw/var: {len(raw_var)} genes | var: {len(var715)} genes | ejemplo raw/var: {raw_var[:5]}")
raw_set = set(raw_var)
def gene_matches(g):
    """Comprueba existencia de un gen en raw/var, resolviendo aliases d-Mar -> MARCHF{d}"""
    if g in raw_set:
        return True
    m = re.fullmatch(r'(\d+)-Mar', g)
    if m and (f'MARCH{m.group(1)}' in raw_set or f'MARCHF{m.group(1)}' in raw_set):
        return True
    m = re.fullmatch(r'(\d+)-Sep', g)
    if m and (f'SEPTIN{m.group(1)}' in raw_set or f'SEPT{m.group(1)}' in raw_set):
        return True
    return False
missing = {}
for sheet in sheet_names:
    g = set(sheet_df(sheet)['gene'])
    miss = sorted([x for x in g if not gene_matches(x)])
    if miss:
        missing[sheet] = miss
print(f"Hojas con genes NO presentes en raw/var: {len(missing)}")
for k, v in list(missing.items())[:5]:
    print(f"  {k}: {v[:5]}")
n_date_total = sum(SHEETS[s][1] for s in sheet_names)
print(f"Símbolos recuperados de corrupción de fecha Excel (A7): {n_date_total}")

# ----------------------------------------------------------------------------
# 3) Comprobación (b): orientación de avg_log2FC (Post vs Pre)
# ----------------------------------------------------------------------------
print("\n=== Comprobación (b): orientación de avg_log2FC ===")
# (b1) Concordancia sign(FC) con (pct.1 - pct.2) en todas las hojas
tot = ok = 0
for sheet in sheet_names:
    df = sheet_df(sheet)
    d = df[(df['p_val_adj'] < 0.05) & (df['avg_log2FC'] != 0)]
    agree = ((d['avg_log2FC'] > 0) == (d['pct.1'] > d['pct.2'])).sum()
    tot += len(d); ok += agree
print(f"(b1) Concordancia sign(avg_log2FC) == (pct.1>pct.2): {ok}/{tot} "
      f"({100*ok/tot:.1f}%) -> pct.1 corresponde a Post si FC>0 = up en Post")
# (b2) Genes de respuesta interferón (esperados UP tras AAV9 minidistrofina, por ISGs)
ISG = ['IFI44L','IFI44','IFIT1','IFIT2','IFIT3','ISG15','MX1','MX2','OAS1','OAS2',
       'OAS3','RSAD2','IFI6','IFITM1','IFITM3','XAF1','SAMD9','SAMD9L','LAG3','CXCL10']
rows = []
for sheet in sheet_names:
    df = sheet_df(sheet)
    m = df[df['gene'].isin(ISG)]
    if len(m):
        pos = int((m['avg_log2FC'] > 0).sum()); neg = int((m['avg_log2FC'] < 0).sum())
        rows.append((sheet, len(m), pos, neg))
isd = pd.DataFrame(rows, columns=['sheet','ISG_hits','FC>0','FC<0'])
print("(b2) Genes ISG/interferón en las hojas (esperados UP en Post):")
print(isd.to_string(index=False))
print(f"(b2) Total ISG hits: FC>0={isd['FC>0'].sum()}, FC<0={isd['FC<0'].sum()}")
# (b3) Ejemplo destacado de la hoja ganadora
w = sheet_df(winner.cell_type)
w = w[w['p_val_adj'] < 0.05].sort_values('avg_log2FC', ascending=False)
print(f"\n(3) Top-8 DEGs significativos de {winner.cell_type} (Post vs Pre):")
print(w.head(8)[['gene','avg_log2FC','pct.1','pct.2','p_val_adj']].to_string(index=False))
print(f"Top-8 down de {winner.cell_type}:")
print(w.tail(8)[['gene','avg_log2FC','pct.1','pct.2','p_val_adj']].to_string(index=False))

# ----------------------------------------------------------------------------
# 4) Resumen de sensibilidad
# ----------------------------------------------------------------------------
print("\n=== Sensibilidad: ranking bajo definiciones alternativas ===")
for col in ['DEG_adj<0.05', 'DEG_adj<0.1', 'DEG_adj<0.05 & |FC|>0.25']:
    order = res.sort_values(col, ascending=False)
    print(f"{col}: 1º {order.iloc[0].cell_type} ({order.iloc[0][col]}), "
          f"2º {order.iloc[1].cell_type} ({order.iloc[1][col]}), "
          f"3º {order.iloc[2].cell_type} ({order.iloc[2][col]})")
res.to_csv('deg_counts_by_cell_type.csv', index=False)
print("\nTabla guardada en work/deg_counts_by_cell_type.csv")
