"""
BixBench bix-37-q2: Base protein levels of ENO1 in normal samples
according to the proteomic data, rounded to 3 significant figures.

Method (as approved by researcher):
  - Load "Proteomic_data .xlsx", sheet "Tumor vs Normal" (header = row 1).
  - Identify the unique ENO1 row via triple cross-check:
      gene == 'ENO1'  AND  protein == 'P06733'  AND  Description contains 'GN=ENO1'
  - Extract the value in the 'Normal' column (linear raw MS intensity,
    no additional normalization), then round to 3 significant figures.
  - MeRIP_RNA_result.xlsx (m6A/RNA data) is NOT used in this calculation.

Declared assumptions:
  - Normal/Tumor columns are raw linear MS intensities per protein
    (verified internally: Ratio ~ Tumor/Normal, log2FC ~ log2(Ratio)).
  - No additional normalization is required.
Uncertainties:
  - Possible undocumented internal imputation in the original pipeline.
  - Empty helper columns 列1/列2 have no stated purpose (fully null, ignored).
"""
import re
import pandas as pd

SRC = "data/Proteomic_data .xlsx"
SHEET = "Tumor vs Normal"

# --- Load -------------------------------------------------------------------
df = pd.read_excel(SRC, sheet_name=SHEET)
print(f"Loaded sheet '{SHEET}': {df.shape[0]} rows x {df.shape[1]} columns")
print(f"Columns: {list(df.columns)}")
assert "Normal" in df.columns and "gene" in df.columns

# --- Sanity: internal unit checks (linear scale confirmation) ----------------
import numpy as np
d_ratio = (df["Ratio"] - df["Tumor"] / df["Normal"]).abs().max()
d_log2 = (df["log2FC"] - np.log2(df["Ratio"])).abs().max()
print(f"Max |Ratio - Tumor/Normal|   = {d_ratio:.2e}  (linear scale confirmed)")
print(f"Max |log2FC - log2(Ratio)|   = {d_log2:.2e}  (linear scale confirmed)")
print(f"Normal column: min={df['Normal'].min():.3g}, median={df['Normal'].median():.3g}, "
      f"max={df['Normal'].max():.3g}, nulls={df['Normal'].isna().sum()}")

# --- Triple cross-check for ENO1 ---------------------------------------------
mask = (
    (df["gene"] == "ENO1")
    & (df["protein"] == "P06733")
    & df["Description"].str.contains(r"GN=ENO1\b", regex=True)
)
hits = df[mask]
print(f"\nENO1 rows matching triple cross-check: {len(hits)}")
assert len(hits) == 1, f"Expected exactly one ENO1 row, found {len(hits)}"
row = hits.iloc[0]
print(hits[["protein", "Description", "gene", "gene_id", "Normal", "Tumor",
            "Ratio", "log2FC", "p.value"]].to_string(index=False))

# Also confirm no other ENO1-like duplicates by gene alone
print(f"Rows with gene=='ENO1' (gene-only check): {(df['gene'] == 'ENO1').sum()}")

# --- Extract base level in Normal samples ------------------------------------
raw_value = float(row["Normal"])
print(f"\nENO1 'Normal' raw value (linear MS intensity): {raw_value:.13g}")

# --- Round to 3 significant figures ------------------------------------------
def round_sig(x: float, sig: int = 3) -> float:
    if x == 0:
        return 0.0
    from math import floor, log10
    exponent = floor(log10(abs(x)))
    return round(x, -(exponent - (sig - 1)))

val_3sf = round_sig(raw_value, 3)
print(f"ENO1 base protein level in normal samples (3 s.f.): {val_3sf:.3g} "
      f"({val_3sf:,.0f})")

# --- Explicit exclusion of MeRIP file -----------------------------------------
print("\nMeRIP_RNA_result.xlsx: NOT used (contains m6A/RNA-seq results, "
      "not proteomic data).")

# --- Persist result ------------------------------------------------------------
with open("output/eno1_result.txt", "w") as f:
    f.write(f"ENO1 base protein level in normal samples (raw): {raw_value:.13g}\n")
    f.write(f"ENO1 base protein level in normal samples (3 s.f.): {val_3sf:.3g}\n")
print("\nResult saved to output/eno1_result.txt")
