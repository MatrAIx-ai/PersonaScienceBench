"""
BixBench bix-42-q2: Skewness of the RNA expression distribution (COAD).
Method: Fisher-Pearson sample skewness (scipy.stats.skew, bias=False).
Formula: g1_bias=False -> G1 = sqrt(n(n-1))/(n-2) * m3/m2^(3/2),
where m_k = sum((x-mean)^k)/n. Primary answer: skewness over ALL raw
expression values (tumors + normals pooled). Sensitivity: nonzero-only,
log2(1+x), and per-gene summary excluding all-zero gene rows.
Duplicated gene symbols are kept as independent rows (declared).
"""
import numpy as np
import pandas as pd
from scipy.stats import skew

EXP_FILE = "data/COAD__geneExp.xls"

exp = pd.read_csv(EXP_FILE, sep="\t").set_index("GeneSymbol")
print(f"Expression matrix: {exp.shape[0]} genes x {exp.shape[1]} samples")

v = exp.to_numpy(dtype=float)
n_val = v.size
zero_mask_all = v == 0
print(f"Total values: {n_val:,} | zeros: {zero_mask_all.sum():,} "
      f"({zero_mask_all.mean()*100:.1f}%) | min={v.min():g} max={v.max():g}")

# ---- Primary answer: all raw values, tumors + normals together ----
sk_all = skew(v.ravel(), bias=False)
print(f"\nPRIMARY - all raw values (pooled): skew = {sk_all:.4f}")

# ---- Sensitivity 1: nonzero values only ----
sk_nonzero = skew(v[v > 0], bias=False)
print(f"Sensitivity - nonzero values only:  skew = {sk_nonzero:.4f}")

# ---- Sensitivity 2: log2(1+x) over all values ----
sk_log = skew(np.log2(v + 1).ravel(), bias=False)
print(f"Sensitivity - log2(1+x) all values: skew = {sk_log:.4f}")

# ---- Per-gene summary, excluding all-zero gene rows ----
gene_sk_raw = skew(v, axis=1, bias=False, nan_policy="omit")
gene_sk_log = skew(np.log2(v + 1), axis=1, bias=False, nan_policy="omit")
all_zero_rows = (v == 0).all(axis=1)
n_excluded = int(all_zero_rows.sum())
gene_sk_raw_ok = gene_sk_raw[~all_zero_rows]
gene_sk_log_ok = gene_sk_log[~all_zero_rows]
print(f"\nPer-gene: {n_excluded} of {v.shape[0]} all-zero gene rows excluded "
      f"({n_excluded/v.shape[0]*100:.1f}%)")
print(f"Per-gene raw  skew: median={np.median(gene_sk_raw_ok):.3f} "
      f"mean={gene_sk_raw_ok.mean():.3f} IQR="
      f"[{np.percentile(gene_sk_raw_ok,25):.3f},{np.percentile(gene_sk_raw_ok,75):.3f}] "
      f"frac>0={np.mean(gene_sk_raw_ok>0):.3f}")
print(f"Per-gene log2 skew: median={np.median(gene_sk_log_ok):.3f} "
      f"mean={gene_sk_log_ok.mean():.3f} IQR="
      f"[{np.percentile(gene_sk_log_ok,25):.3f},{np.percentile(gene_sk_log_ok,75):.3f}] "
      f"frac>0={np.mean(gene_sk_log_ok>0):.3f}")

# ---- Verification: tumor samples only (01*) ----
tumor_cols = [c for c in exp.columns if c.split("-")[3].startswith("01")]
vt = v[:, [list(exp.columns).index(c) for c in tumor_cols]]
sk_tumor = skew(vt.ravel(), bias=False)
sk_tumor_log = skew(np.log2(vt + 1).ravel(), bias=False)
print(f"\nTumor-only check ({len(tumor_cols)} samples, 01*): "
      f"raw skew = {sk_tumor:.4f} | log2(1+x) skew = {sk_tumor_log:.4f}")

# ---- Verbal interpretation with declared thresholds ----
def interpret(s):
    if abs(s) < 0.5:
        return "approximately normal"
    if abs(s) > 1:
        return ("highly right-skewed" if s > 0 else "highly left-skewed")
    return ("minimally right-skewed" if s > 0 else "minimally left-skewed")

print("\n--- INTERPRETATION (thresholds: |skew|>1 strong, |skew|<0.5 approx. normal) ---")
print(f"All raw values (PRIMARY): skew={sk_all:.4f} -> {interpret(sk_all)}")
print(f"Nonzero raw values:       skew={sk_nonzero:.4f} -> {interpret(sk_nonzero)}")
print(f"log2(1+x) values:         skew={sk_log:.4f} -> {interpret(sk_log)}")
print(f"Tumor-only raw:           skew={sk_tumor:.4f} -> {interpret(sk_tumor)}")

# ---- Final concise answer ----
print("\nFINAL ANSWER:")
print(f"The RNA expression distribution (raw counts, {v.shape[0]} genes x {v.shape[1]} "
      f"samples) is highly right-skewed (Fisher-Pearson skewness = {sk_all:.2f}); "
      f"after log2(1+x) transformation it becomes approximately normal "
      f"(skewness = {sk_log:.2f}).")
