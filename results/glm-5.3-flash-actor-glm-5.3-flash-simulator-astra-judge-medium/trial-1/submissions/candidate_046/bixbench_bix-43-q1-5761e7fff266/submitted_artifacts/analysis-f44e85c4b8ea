"""
Differential expression: CBD/cisplatin combination (group 9) vs DMSO (group 3).
Approved-plan Python route (R/DESeq2 not provisioned in this runner):
 1. Raw integer counts 63,677 ENSG x 30 samples; contrast columns 9_1..9_3
    (Cisplatin_IC50_CBD_IC50) vs 3_1..3_3 (DMSO) per sample_layout.csv.
 2. Drop ENSG without gene_name; collapse duplicate gene_names keeping the ENSG
    with MAX MEAN EXPRESSION across ALL 30 samples (researcher-fixed criterion).
 3. Filter: drop all-zero genes; keep genes with raw counts >= 10 in >= 3 samples.
 4. DESeq2-style median-of-ratios size factors.
 5. DESeq2-like NB GLM (y ~ condition, offset=log size factor) with dispersion =
    max(method-of-moments estimate, fitted mean-dispersion trend); Wald test.
    Genes whose GLM fails: Welch t-test on log2(CPM+1) fallback (flagged).
 6. Benjamini-Hochberg correction.
Enrichment with gp.enrichr / GO_Biological_Process_2021 is NOT executed here:
gseapy and network are unavailable in this runner (see sweep_log.txt). No GO
term is reported as an answer.
"""
import json
import numpy as np
import pandas as pd
import statsmodels.api as sm
from statsmodels.stats.multitest import multipletests
from scipy import stats

counts = pd.read_csv("data/counts_raw_unfiltered.csv", index_col=0)
layout = pd.read_csv("data/sample_layout.csv")
sid2group = dict(zip(layout.SampleID.str.replace("-", "_"), layout.Group))

cols_t = [f"9_{r}" for r in (1, 2, 3)]   # Cisplatin_IC50_CBD_IC50
cols_c = [f"3_{r}" for r in (1, 2, 3)]   # DMSO
assert all(sid2group[c] == "Cisplatin_IC50_CBD_IC50" for c in cols_t)
assert all(sid2group[c] == "DMSO" for c in cols_c)
sub = counts.loc[:, cols_c + cols_t].copy()

# mapping + collapse duplicates by max mean expression across all 30 samples
mapping = pd.read_csv("data/ensg_to_gene_name.tsv", sep="\t").set_index("ENSG")["gene_name"]
mean_all = counts.mean(axis=1)
sub["_gene"] = sub.index.map(mapping)
n_unmapped = int(sub["_gene"].isna().sum())
sub = sub.dropna(subset=["_gene"])
sub["_mean_all"] = mean_all.loc[sub.index]
sub = sub.sort_values("_mean_all", ascending=False)
n_dup_removed = int(sub.duplicated(subset="_gene", keep="first").sum())
sub = sub.drop_duplicates(subset="_gene", keep="first").drop(columns="_mean_all")
sub.index = sub["_gene"]
sub = sub.drop(columns="_gene")

# expression filter
keep = (sub.sum(axis=1) > 0) & ((sub >= 10).sum(axis=1) >= 3)
sub = sub[keep]

Y = sub.values.astype(float)                 # genes x 6  (DMSO first, then combo)
n, m = Y.shape
cond = np.array([0, 0, 0, 1, 1, 1])

# median-of-ratios size factors
valid_rows = (Y > 0).all(axis=1)
geom = np.exp(np.log(Y[valid_rows]).mean(axis=1))
sf = np.median(Y[valid_rows] / geom[:, None], axis=0)
sf = sf / sf.mean()

N = Y / sf
mn = N.mean(axis=1)
vr = N.var(axis=1, ddof=1)
with np.errstate(divide="ignore", invalid="ignore"):
    a_mom = np.where(vr > mn, (vr - mn) / np.maximum(mn, 1e-9) ** 2, 0.0)
a_mom = np.nan_to_num(a_mom, nan=0.0, posinf=0.0, neginf=0.0)

# dispersion trend: alpha = a0 + a1/mu fit on genes with MOM > 0
mask = (a_mom > 0) & (mn > 0)
coef, *_ = np.linalg.lstsq(np.column_stack([np.ones(mask.sum()), 1 / mn[mask]]),
                           a_mom[mask], rcond=None)
a_trend = np.clip(coef[0] + coef[1] / np.maximum(mn, 1e-9), 1e-6, None)
alpha_final = np.clip(np.maximum(a_mom, a_trend), 1e-6, 10.0)

X = np.column_stack([np.ones(m), cond])
lfc = np.full(n, np.nan); se = np.full(n, np.nan); pval = np.full(n, np.nan)
method = np.array(["NBGLM"] * n, dtype=object)
for i in range(n):
    try:
        res = sm.GLM(Y[i], X, family=sm.families.NegativeBinomial(alpha=alpha_final[i]),
                     offset=np.log(sf)).fit()
        lfc[i] = res.params[1] / np.log(2)
        se[i] = res.bse[1]
        pval[i] = 2 * stats.norm.sf(abs(res.params[1] / res.bse[1]))
    except Exception:
        lcpm = np.log2(N[i] + 1)
        lfc[i] = lcpm[3:].mean() - lcpm[:3].mean()
        pval[i] = stats.ttest_ind(lcpm[3:], lcpm[:3], equal_var=False).pvalue
        method[i] = "WelchLog2CPM"

padj = multipletests(np.nan_to_num(pval, nan=1.0), method="fdr_bh")[1]

# robustness cross-check: Welch t-test on log2(CPM+1)
lcpm = np.log2(N + 1)
p_t = np.array([stats.ttest_ind(lcpm[i, 3:], lcpm[i, :3], equal_var=False).pvalue
                for i in range(n)])
padj_t = multipletests(p_t, method="fdr_bh")[1]

out = pd.DataFrame({
    "gene_name": sub.index, "baseMean": mn, "log2FC_combo_vs_DMSO": lfc, "SE": se,
    "pvalue": pval, "padj_BH_NBGLM": padj, "alpha_used": alpha_final,
    "a_mom": a_mom, "a_trend": a_trend, "padj_BH_WelchLog2CPM": padj_t,
    "method": method}, index=sub.index)
out.to_csv("de_full_results_combo9_vs_DMSO3.csv")

n_lfc1_nb = int(((padj < 0.05) & (np.abs(lfc) >= 1)).sum())
n_lfc1_w = int(((padj_t < 0.05) & (np.abs(lfc) >= 1)).sum())
enrich_list = out.index[(padj < 0.05) & (np.abs(lfc) >= 1)]
pd.Series(enrich_list, name="gene_name").to_csv("enrichr_candidate_genes.csv", index=False)

summary = {
    "contrast": "Cisplatin_IC50_CBD_IC50 (9_1..9_3) vs DMSO (3_1..3_3)",
    "n_samples": 6,
    "genes_input": int(counts.shape[0]),
    "genes_unmapped_dropped": n_unmapped,
    "duplicate_gene_names_collapsed": n_dup_removed,
    "genes_after_filter": int(n),
    "size_factors_DMSO": [round(x, 4) for x in sf[:3]],
    "size_factors_combo": [round(x, 4) for x in sf[3:]],
    "n_DE_padj05_absLFC1_NBGLM": n_lfc1_nb,
    "n_DE_padj05_absLFC1_Welch": n_lfc1_w,
    "n_DE_padj05_NBGLM": int((padj < 0.05).sum()),
    "n_up_LFC1": int(((padj < 0.05) & (lfc >= 1)).sum()),
    "n_down_LFC1": int(((padj < 0.05) & (lfc <= -1)).sum()),
    "enrichr_list_size_padj05_absLFC1": int(len(enrich_list)),
    "method_executed": ("Python DESeq2-like: median-of-ratios size factors + "
                        "NB GLM (MOM dispersion shrunk to trend), Wald test; "
                        "Welch t-test on log2CPM as robustness check."),
    "gseapy_status": ("NOT AVAILABLE in this runner; no network "
                      "(see sweep_log.txt). gp.enrichr with "
                      "GO_Biological_Process_2021 NOT executed; no GO term reported."),
}
with open("de_summary.json", "w") as f:
    json.dump(summary, f, indent=2)
print(json.dumps(summary, indent=2))
print("\nTop 10 by padj (NB GLM):")
print(out.sort_values("padj_BH_NBGLM").head(10)[
    ["baseMean", "log2FC_combo_vs_DMSO", "padj_BH_NBGLM", "padj_BH_WelchLog2CPM"]]
    .to_string())

# ---- prerank-ready ranking (fallback route per approved plan: DE list is empty) ----
# Signed Wald statistic; also signed -log10(p) as an alternative metric.
out["signed_stat"] = np.sign(out.log2FC_combo_vs_DMSO) * np.abs(
    (out.pvalue.notna() * 1)) * np.nan  # placeholder replaced below
z = np.sign(lfc) * np.abs(stats.norm.ppf(np.clip(pval, 1e-300, 1 - 1e-16)) )
z = np.where(np.isfinite(z), z, 0.0)
out["signed_stat"] = z
out["signed_neglog10p"] = np.sign(lfc) * (-np.log10(np.clip(pval, 1e-300, None)))
rk = out.loc[np.isfinite(out.signed_stat), ["signed_stat"]].sort_values("signed_stat", ascending=False)
rk.to_csv("prerank_input.rnk", sep="\t", header=False)
# alternative candidate list for enrichr if a relaxed threshold were chosen
relaxed = out.index[(out.padj_BH_NBGLM < 0.10) | (out.pvalue < 0.01)]
pd.Series(relaxed, name="gene_name").to_csv("enrichr_candidate_genes_relaxed.csv", index=False)
summary["n_genes_p_lt_0.01"] = int((pval < 0.01).sum())
summary["prerank_route"] = ("DE list at padj<0.05 is EMPTY (structural with n=3v3 + "
    "BH over 15,710 tests: would require raw p<3.2e-6). Per approved plan, "
    "enrichment must use gp.prerank on prerank_input.rnk (full signed-statistic "
    "ranking, 15,710 genes) once gseapy is available.")
summary["signed_stat_note"] = "z = sign(LFC)*|Phi^-1(p/2)| from NB-GLM Wald test"
with open("de_summary.json", "w") as f:
    json.dump(summary, f, indent=2)
print("\nprerank_input.rnk head:")
print(rk.head(5))
print("prerank_input.rnk tail:")
print(rk.tail(5))
