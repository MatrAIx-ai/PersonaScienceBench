#!/usr/bin/env python3
"""
STEP 2 (approved substitute B): DE, Cisplatin_IC50_CBD_IC50 vs DMSO.
Per-gene NB GLM (log link) via vectorized IRLS; DESeq2-style median-of-ratios
size factors; dispersion = parametric mean-dispersion trend (a1/mu + a0) fitted
to method-of-moments dispersions. DESeq2 SUBSTITUTE: no Cox-Reid adjustment, no
per-gene dispersion MAP shrinkage, no Cook's filtering, no independent
filtering -> expected differences, especially with n=3 vs 3.
Thresholds EXACT: raw Wald p<0.05, |log2FC|>0.5, baseMean>10.
"""
import json, numpy as np, pandas as pd
from scipy.stats import norm
from scipy.optimize import least_squares

counts = pd.read_csv("/workspace/data/counts_raw_unfiltered.csv", index_col=0)
layout = pd.read_csv("/workspace/data/sample_layout.csv")
layout["col"] = layout["SampleID"].str.replace("-", "_", regex=False)
comb = layout.loc[layout.Group == "Cisplatin_IC50_CBD_IC50", "col"].tolist()
ctrl = layout.loc[layout.Group == "DMSO", "col"].tolist()
sub = counts[comb + ctrl].astype(float)
Y = sub.values
n1, n0 = len(comb), len(ctrl)

loggeo = np.log(sub.replace(0, np.nan)).mean(axis=1).replace(0, np.nan)
ratios = sub.T.div(np.exp(loggeo), axis="columns")
sf = ratios.median(axis=1).values
N = Y / sf

g1, g0 = N[:, :n1], N[:, n1:]
v1 = g1.var(1, ddof=1); v0 = g0.var(1, ddof=1)
pool_v = (v1*(n1-1) + v0*(n0-1)) / (n1+n0-2)
pool_m = N.mean(1)
with np.errstate(divide="ignore", invalid="ignore"):
    a_mom = np.maximum(0.0, (pool_v - pool_m) / np.maximum(pool_m**2, 1e-12))

ok = (a_mom > 0) & (pool_m > 1)
mu_ok, a_ok = pool_m[ok], a_mom[ok]
def resid(p): return p[0]/mu_ok + p[1] - a_ok
fit = least_squares(resid, x0=[1.0, 0.01], loss="soft_l1", f_scale=1.0)
a1, a0 = fit.x
alpha_trend = np.clip(a1/np.maximum(pool_m, 1e-8) + a0, 1e-8, 10.0)

keep = pool_m > 0
y = Y[keep]
xv = np.array([0.]*n0 + [1.]*n1)
Xg = np.stack([np.ones(6), xv], axis=1)
Xb = np.repeat(Xg[None, :, :], keep.sum(), axis=0)
alpha = alpha_trend[keep][:, None]
b = np.zeros((keep.sum(), 2))
for it in range(200):
    eta = np.clip(np.einsum("gik,gi->gk", Xb, b) if False else (Xb * b[:, None, :]).sum(2), -20, 20)
    mu = np.exp(eta)
    W = mu / (1.0 + alpha*mu)
    z = eta + (y - mu)/mu
    XtWX = np.empty((keep.sum(), 2, 2))
    for i in range(2):
        for j in range(2):
            XtWX[:, i, j] = ((Xb[:, :, i] * W) * Xb[:, :, j]).sum(1)
    XtWz = np.stack([((Xb[:, :, i] * W) * z).sum(1) for i in range(2)], axis=1)
    b_new = np.linalg.solve(XtWX + 1e-10*np.eye(2), XtWz[:, :, None])[..., 0]
    d = np.max(np.abs(b_new - b))
    b = b_new
    if d < 1e-8: break
eta = np.clip((Xb * b[:, None, :]).sum(2), -20, 20)
mu = np.exp(eta)
W = mu / (1.0 + alpha*mu)
XtWX = np.empty((keep.sum(), 2, 2))
for i in range(2):
    for j in range(2):
        XtWX[:, i, j] = ((Xb[:, :, i] * W) * Xb[:, :, j]).sum(1)
cov = np.linalg.inv(XtWX + 1e-10*np.eye(2))
se = np.sqrt(cov[:, 1, 1])
lfc = b[:, 1] / np.log(2)
pval = 2*norm.sf(np.abs(b[:, 1]/se))

res = pd.DataFrame({"baseMean": pool_m[keep], "log2FoldChange": lfc,
                    "pvalue": pval, "dispersion": alpha[:, 0]},
                   index=counts.index[keep])
mapping = pd.read_csv("/workspace/data/ensg_to_gene_name.tsv", sep="\t").set_index("ENSG").gene_name
deg = res[(res.pvalue < 0.05) & (res.log2FoldChange.abs() > 0.5) & (res.baseMean > 10)]
deg = deg.join(mapping).dropna(subset=["gene_name"])
n_before = len(deg)
deg = deg.sort_values("baseMean", ascending=False).drop_duplicates("gene_name")
deg.to_csv("/workspace/out/DEG_substitute.csv")
res.to_csv("/workspace/out/de_results_substitute.csv")

summary = {
    "method": "NB GLM (log link, IRLS) + median-of-ratios size factors + parametric mean-dispersion trend; DESeq2 SUBSTITUTE",
    "trend_params": {"a1": float(a1), "a0": float(a0), "irls_iters": int(it+1)},
    "contrast": "Cisplatin_IC50_CBD_IC50 vs DMSO",
    "thresholds": "pvalue<0.05, |log2FC|>0.5, baseMean>10",
    "n_tests": int(keep.sum()),
    "n_DEG_before_dedupe": int(n_before), "n_DEG_after_dedupe": int(len(deg)),
    "n_up": int((deg.log2FoldChange > 0).sum()), "n_down": int((deg.log2FoldChange < 0).sum()),
    "top20_up": deg.sort_values("log2FoldChange", ascending=False).head(20).gene_name.tolist(),
    "top20_down": deg.sort_values("log2FoldChange").head(20).gene_name.tolist(),
}
json.dump(summary, open("/workspace/out/DEG_substitute_summary.json", "w"), indent=1)
print(json.dumps(summary, indent=1))
