#!/usr/bin/env python3
"""
BixBench bix-43-q2: Odds ratio for 'p53-mediated cell cycle gene regulation'
(Reactome_2022, gseapy.enrichr) among DEGs between Cisplatin_IC50_CBD_IC50
(combination) and DMSO. Thresholds: raw p<0.05, |log2FC|>0.5, baseMean>10.

This script runs the FULL canonical pipeline when pydeseq2+gseapy+network are
available; otherwise it executes and records environment diagnostics and the
method-independent steps (contrast setup, median-of-ratios size factors,
baseMean) and stops WITHOUT fabricating enrichment results.
"""
import json, os, sys, urllib.request
import numpy as np, pandas as pd

OUT = "/workspace/out"
os.makedirs(OUT, exist_ok=True)
report = {"environment": {}, "data_checks": {}, "pipeline_status": None}

# ---------- 1. Environment diagnostics ----------
def check_net():
    try:
        urllib.request.urlopen("https://maayanlab.cloud/Enrichr", timeout=8)
        return True
    except Exception:
        return False

report["environment"]["python"] = sys.version.split()[0]
for mod in ("pydeseq2", "gseapy"):
    try:
        m = __import__(mod); report["environment"][mod] = getattr(m, "__version__", "?")
    except Exception as e:
        report["environment"][mod] = f"UNAVAILABLE ({type(e).__name__})"
report["environment"]["R"] = "UNAVAILABLE (no Rscript in PATH)"
report["environment"]["network"] = check_net()
print("ENV:", json.dumps(report["environment"]))

# ---------- 2. Data checks + contrast setup ----------
counts = pd.read_csv("/workspace/data/counts_raw_unfiltered.csv", index_col=0)
layout = pd.read_csv("/workspace/data/sample_layout.csv")
layout["col"] = layout["SampleID"].str.replace("-", "_", regex=False)
comb_cols = layout.loc[layout.Group == "Cisplatin_IC50_CBD_IC50", "col"].tolist()
ctrl_cols = layout.loc[layout.Group == "DMSO", "col"].tolist()
assert set(counts.columns) == set(layout["col"]), "layout/columns mismatch"
assert counts.values.min() >= 0 and np.all(counts.values == counts.values.astype(int))
sub = counts[comb_cols + ctrl_cols]
# median-of-ratios size factors (DESeq2 standard)
logc = np.log(sub.replace(0, np.nan)).mean(axis=1)          # per-gene geometric mean
ratios = sub.T.div(logc.replace(0, np.nan).apply(np.exp), axis="columns")  # samples x genes
sf = ratios.median(axis=1)                                   # per-sample size factor
norm = sub.divide(pd.Series(sf.values, index=sub.columns), axis="columns")
baseMean = norm.mean(axis=1)
report["data_checks"] = {
    "counts_shape": list(counts.shape), "integer_raw_counts": True,
    "combination_samples": comb_cols, "dmso_samples": ctrl_cols,
    "group_sizes": {"Cisplatin_IC50_CBD_IC50": 3, "DMSO": 3},
    "size_factors": {c: round(float(s), 4) for c, s in zip(sub.columns, sf)},
    "genes_baseMean_gt10": int((baseMean > 10).sum()),
}
print("DATA:", json.dumps(report["data_checks"], indent=1))

# ---------- 3. Canonical pipeline (only if fully provisioned) ----------
can_go = (not isinstance(report["environment"]["gseapy"], str) and
          not isinstance(report["environment"]["pydeseq2"], str) and
          report["environment"]["network"])
if can_go:
    from pydeseq2.ds import DeseqStats
    from pydeseq2.dds import DeseqDataSet
    meta = pd.DataFrame({"condition": ["Cisplatin_IC50_CBD_IC50"]*3 + ["DMSO"]*3},
                        index=sub.index)
    dds = DeseqDataSet(counts=sub.T, metadata=meta, design="~condition",
                       refit_cooks=True)
    dds.deseq2()
    stat = DeseqStats(dds, contrast=["condition", "Cisplatin_IC50_CBD_IC50", "DMSO"])
    stat.summary(); res = stat.results_df
    deg = res[(res.pvalue < 0.05) & (res.log2FoldChange.abs() > 0.5) & (res.baseMean > 10)]
    mapping = pd.read_csv("/workspace/data/ensg_to_gene_name.tsv", sep="\t").drop_duplicates("ENSG")
    deg = deg.join(mapping.set_index("ENSG").gene_name).dropna(subset=["gene_name"])
    # dedupe symbols: keep ENSG with highest baseMean
    n_before = len(deg)
    deg = (deg.sort_values("baseMean", ascending=False)
              .drop_duplicates("gene_name"))
    genes = sorted(deg.gene_name.unique())
    import gseapy as gp
    enr = gp.enrichr(gene_list=genes, gene_sets="Reactome_2022",
                     organism="Human", out_dir=None)
    df = enr.results
    term = df[df.Term.str.contains("p53-mediated cell cycle gene regulation",
                                   case=False, regex=False)]
    row = term.iloc[0] if len(term) else None
    report["pipeline_status"] = "executed"
    report["results"] = {
        "n_DEG_before_dedupe": int(n_before), "n_DEG_after_dedupe": len(genes),
        "term": None if row is None else row["Term"],
        "odds_ratio": None if row is None else float(row["Odds Ratio"]),
        "overlap": None if row is None else row["Overlap"],
        "term_pvalue": None if row is None else float(row["P-value"]),
    }
else:
    report["pipeline_status"] = ("NOT EXECUTED: pydeseq2/gseapy/Enrichr-network "
                                 "unavailable in this runtime; no results fabricated.")

with open(f"{OUT}/environment_report.json", "w") as f:
    json.dump(report, f, indent=2)
print("PIPELINE_STATUS:", report["pipeline_status"])
if "results" in report:
    print("RESULTS:", json.dumps(report["results"], indent=1))
