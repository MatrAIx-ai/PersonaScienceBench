#!/usr/bin/env python3
"""
Análisis: log2 fold change de mexG (PA14_09540) en ΔrhlI (strain #97) vs wt (strain #1).
Método: parser RDS (serialización R v3, XDR) en Python puro — R no está disponible
en este runtime (Rscript ausente), por lo que se usa el fallback validado.
Pasos:
  1) Leer data/res_1vs97.rds, extraer el DESeqResults (6 columnas, 5828 filas) y rownames.
  2) Extraer la fila del locus tag PA14_09540 (mexG; mapeo vía CSV de anotaciones).
  3) Verificación de alineación (solicitada): el rowname del índice 0 debe ser PA14_09540 y
     no un artefacto; se contrasta PA14_09540 con su fila homóloga en res_1vs98 (índice 5408).
     baseMean es independiente del contraste ("mean of normalized counts for all samples"),
     por lo que DEBE ser idéntico para el mismo locus en ambos objetos: si coincide,
     la alineación fila-valor es correcta y no hay desplazamiento.
  4) Verificar ausencia de NA en la fila; redondear log2FoldChange a 2 decimales
     (half-to-even, igual que round() de R), conservando el signo "Strain 97 vs 1".
"""
import gzip, math, struct, sys, csv
sys.path.insert(0, 'analysis')
from rds_parse import RDSParser, attr_get

MEXG_LOCUS = 'PA14_09540'
NA_BITS = b'\x7f\xf0\x00\x00\x00\x00\x07\xa2'  # NA_real_ de R (double)

def find_attr_s4(n, out):
    """Localiza nodos ATTR-wrapped S4 (DESeqResults y subobjetos)."""
    if isinstance(n, tuple):
        if n[0] == 'ATTR' and n[1][0] == 'S4':
            out.append(n)
        if n[0] == 'ATTR':
            find_attr_s4(n[2], out)
        elif n[0] == 'LIST':
            for _, v in n[1]: find_attr_s4(v, out)
        elif n[0] == 'VEC':
            for v in n[1]: find_attr_s4(v, out)

def extract_deseq_results(path):
    """Devuelve (rownames, {col: list}, descriptions) del DESeqResults."""
    info, obj = RDSParser(gzip.open(path, 'rb').read()).parse()
    s4s = []; find_attr_s4(obj, s4s)
    results = None
    for s4 in s4s:
        rn = attr_get(s4, 'rownames')
        if rn and len(rn[1]) > 1000:
            results = s4
            break
    assert results is not None, f'no DESeqResults-like S4 in {path}'
    rownames = attr_get(results, 'rownames')[1]
    nrows = attr_get(results, 'nrows')[1][0]
    assert nrows == len(rownames)
    # columnas: slot listData (VEC de 6 vectores) dentro de los slots del S4
    cols = None
    def unwrap(x):
        return unwrap(x[1]) if isinstance(x, tuple) and x[0] == 'ATTR' else x
    for _, v in results[2][1]:
        v = unwrap(v)
        if isinstance(v, tuple) and v[0] == 'VEC' and len(v[1]) == 6 and \
           all(unwrap(c)[0] == 'REAL' and len(unwrap(c)[1]) == nrows for c in v[1]):
            cols = [unwrap(c)[1] for c in v[1]]
    assert cols is not None, 'listData de 6 columnas REAL no encontrada'
    assert all(len(c) == len(rownames) for c in cols), 'desalineación longitudes'
    names = ['baseMean', 'log2FoldChange', 'lfcSE', 'stat', 'pvalue', 'padj']
    # descripciones de mcols (evidencia)
    desc = []
    def get_desc(x):
        if isinstance(x, tuple):
            if x[0] == 'STR' and x[1] and isinstance(x[1][0], str) and \
               any(('fold change' in str(e)) or ('adjusted' in str(e)) or ('normalized counts' in str(e)) for e in x[1]):
                desc.append(list(x[1]))
                return
            if x[0] == 'LIST':
                for _, v in x[1]: get_desc(v)
            elif x[0] == 'ATTR':
                for y in x[1:]: get_desc(y)
            elif x[0] == 'VEC':
                for v in x[1]: get_desc(v)
    get_desc(results[2])
    return rownames, dict(zip(names, cols)), desc, info

def is_na(v):
    return struct.pack('>d', float(v)) == NA_BITS

def fmt(v):
    return 'NA' if is_na(v) else repr(v)

# ---------- 1) mapeo mexG en el CSV ----------
print('== PASO 1: mapeo de mexG en el CSV de anotaciones ==')
with open('data/Pseudomonas_aeruginosa_UCBPP-PA14.csv', newline='') as fh:
    rows = list(csv.DictReader(fh))
hits = [r for r in rows if (r['Gene Name'] or '').strip().lower() == 'mexg']
assert len(hits) == 1, f'esperada coincidencia única, obtuve {len(hits)}'
h = hits[0]
print(f"  fila CSV: PGD Gene ID={h['PGD Gene ID']}, Locus Tag={h['Locus Tag']}, "
      f"Gene Name={h['Gene Name']}, Product={h['Product Name']}, coords={h['Start']}-{h['End']} ({h['Strand']})")
locus = h['Locus Tag']
assert locus == MEXG_LOCUS

# ---------- 2) extracción de res_1vs97 ----------
print('\n== PASO 2: extracción del DESeqResults de res_1vs97.rds ==')
rownames97, cols97, desc97, info97 = extract_deseq_results('data/res_1vs97.rds')
print(f"  serialización: {info97}; filas={len(rownames97)}, columnas={len(cols97)}")
print(f"  descripciones mcols: {desc97[0]}")
idx97 = rownames97.index(locus)
print(f"  rownames[0:5] = {rownames97[:5]}")
print(f"  índice de {locus} (mexG) en res_1vs97: {idx97}")
row97 = {k: v[idx97] for k, v in cols97.items()}

# ---------- 3) verificación de alineación con res_1vs98 ----------
print('\n== PASO 3: verificación de alineación / artefacto de parseo ==')
rownames98, cols98, desc98, info98 = extract_deseq_results('data/res_1vs98.rds')
idx98 = rownames98.index(locus)
row98 = {k: v[idx98] for k, v in cols98.items()}
print(f"  rownames[0:5] de res_1vs98 = {rownames98[:5]} (rowname[0] ≠ PA14_09540 aquí: {'PA14_09540' != rownames98[0]})")
print(f"  índice de {locus} en res_1vs98: {idx98}")
print(f"  res_1vs97 rowname[{idx97}] = {rownames97[idx97]}  (≠ rowname[0] de res_1vs98 = {rownames98[0]}: "
      f"el índice 0 de 1vs97 no hereda el orden de 1vs98)")
same_base = (row97['baseMean'] == row98['baseMean'])
print(f"  baseMean(mexG) en 1vs97 = {fmt(row97['baseMean'])} vs en 1vs98 = {fmt(row98['baseMean'])} "
      f"→ idénticos: {same_base} (baseMean no depende del contraste; coincide ⇒ alineación correcta)")
# el resto de estadísticas sí difieren por contraste:
print(f"  lfc 1vs97 = {row97['log2FoldChange']!r} vs lfc 1vs98 = {row98['log2FoldChange']!r} "
      f"(difieren: {row97['log2FoldChange'] != row98['log2FoldChange']} — esperado, contrastes distintos)")
assert same_base, 'alineación inconsistente'
assert row97['log2FoldChange'] != row98['log2FoldChange']

# integridad global: mismas longitudes y rownames con genes únicos
assert len(set(rownames97)) == len(rownames97) == len(set(rownames98)) == len(rownames98)
print(f"  rownames únicos: {len(set(rownames97))} (1vs97) / {len(set(rownames98))} (1vs98) — integridad OK")

# ---------- 4) NA y resultado final ----------
print('\n== PASO 4: NA en la fila y valor final ==')
na_flags = {k: is_na(v) for k, v in row97.items()}
print(f"  NA en la fila mexG (res_1vs97): {na_flags} → sin NA: {not any(na_flags.values())}")
na_in_col = sum(1 for v in cols97['log2FoldChange'] if is_na(v))
na_padj_col = sum(1 for v in cols97['padj'] if is_na(v))
print(f"  NA en columna log2FoldChange completa: {na_in_col}; en padj: {na_padj_col}")
assert not any(na_flags.values())

lfc = row97['log2FoldChange']
rounded = round(lfc, 2)
print('\n== RESULTADO ==')
print(f"  mexG (PA14_09540) en res_1vs97 (Strain 97 [ΔrhlI] vs Strain 1 [wt]):")
print(f"    baseMean        = {fmt(row97['baseMean'])}")
print(f"    log2FoldChange  = {fmt(lfc)}")
print(f"    lfcSE           = {fmt(row97['lfcSE'])}")
print(f"    stat            = {fmt(row97['stat'])}")
print(f"    pvalue          = {fmt(row97['pvalue'])}")
print(f"    padj            = {fmt(row97['padj'])}")
print(f"  log2FoldChange redondeado a 2 decimales (signo Strain 97 vs 1, sin inversión): {rounded}")

# ---------- 5) verificación global de alineación (post-análisis) ----------
print('\n== PASO 5: verificación global de alineación (todos los genes) ==')
pos98 = {g: i for i, g in enumerate(rownames98)}
diff = 0; mism = None
for i, g in enumerate(rownames97):
    if cols97['baseMean'][i] != cols98['baseMean'][pos98[g]]:
        diff += 1
        if mism is None: mism = g
print(f'  baseMean idéntico entre 1vs97 y 1vs98 tras alinear por rowname: {len(rownames97)-diff}/{len(rownames97)} genes (diferencias: {diff}, primer mismatch: {mism})')
same_pos = sum(1 for i, g in enumerate(rownames97) if pos98[g] == i)
print(f'  índices coincidentes entre ambos objetos: {same_pos}/{len(rownames97)} '
      f'(los órdenes difieren ⇒ PA14_09540 en 0 (1vs97) y 5408 (1vs98) no es un corrimiento uniforme)')
assert diff == 0, 'alineación global inconsistente'
