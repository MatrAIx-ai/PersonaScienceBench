#!/usr/bin/env python3
"""
DE analysis: ASXL1 patient fibroblasts (disease vs control), design ~ sex + condition.
Python fallback (DESeq2-style): CPM>1 in >=7 samples filter; median-of-ratios size
factors; per-gene NB GLM (log link, offset log SF) by vectorized IRLS; dispersion =
max(method-of-moments gene-wise, parametric trend a1/mu + a0); Wald test + BH FDR.
"""
import numpy as np, pandas as pd, openpyxl, csv
from scipy.stats import norm
from statsmodels.stats.multitest import multipletests

COUNTS_F = "data/Issy_ASXL1_fibro_featureCounts_GeneTable_final.txt"
COLDATA_F = "data/Issy_ASXL1_fibro_coldata_gender.xlsx"

hdr = None; rows = []
with open(COUNTS_F) as f:
    hdr = f.readline().split()
    for l in f:
        rows.append(l.split())
counts_df = pd.DataFrame([[int(x) for x in r[1:]] for r in rows],
                         index=[r[0] for r in rows], columns=hdr[1:])
print(f"[load] count table: {counts_df.shape[0]} genes x {counts_df.shape[1]} samples", flush=True)

wb = openpyxl.load_workbook(COLDATA_F, read_only=True)
ws = wb.active
cd = pd.DataFrame(ws.values)
cd.columns = cd.iloc[0]; cd = cd.iloc[1:].reset_index(drop=True)
excluded = sorted(set(counts_df.columns) - set(cd['sample']))
print("[diagnostic] samples in counts but NOT in coldata (EXCLUDED):", excluded, flush=True)
cd = cd.set_index('sample').loc[counts_df.columns.intersection(cd['sample'])]
counts = counts_df[cd.index].values.astype(np.float64)

lib = counts.sum(axis=0)
cpm = counts / lib * 1e6
keep = (cpm > 1).sum(axis=1) >= 7
print(f"[diagnostic] filter CPM>1 in >=7 samples keeps {keep.sum()} / {keep.size} genes", flush=True)
y = counts[keep]
genes_kept = np.array(counts_df.index[keep])

logy = np.where(y > 0, np.log(y), np.nan)
loggeo = np.nanmean(logy, axis=1)
valid = np.isfinite(loggeo)
sf = np.exp(np.median(np.log(y[valid]) - loggeo[valid, None], axis=0))
sf = sf / sf.mean()
print("[diagnostic] size factors:", dict(zip(cd.index, np.round(sf, 4))), flush=True)

sex = (cd['sex'] == 'M').values.astype(float)
cond = (cd['condition'] == 'disease').values.astype(float)
X = np.column_stack([np.ones(len(cd)), sex, cond])
p = X.shape[1]; n_samples = y.shape[1]
offset = np.log(sf)[None, :]
Eye = np.eye(p)[None] * 1e-10

def irls_nb(Y, X, offset, alpha, maxit=100, tol=1e-9):
    """Vectorized NB IRLS with Fisher scoring, step halving and beta bounding."""
    g, m = Y.shape
    p = X.shape[1]
    Eye = np.eye(p)[None] * 1e-8
    beta = np.zeros((g, p))
    beta[:, 0] = np.log(np.maximum(Y, 0.5).mean(axis=1))
    Xb = np.broadcast_to(X, (g, m, p))
    for it in range(maxit):
        eta = beta @ X.T + offset
        mu = np.exp(np.clip(eta, -30.0, 30.0))
        W = np.maximum(mu / (1.0 + alpha[:, None] * mu), 1e-12)
        XtWX = np.einsum('gnp,gnq->gpq', Xb * W[:, :, None], Xb) + Eye
        grad = np.einsum('gn,gnp->gp', (Y - mu) / (1.0 + alpha[:, None] * mu), Xb)
        delta = np.linalg.solve(XtWX, np.stack([grad], -1))[..., 0]
        # cap step so |beta| stays bounded
        scale = np.abs(delta).max(axis=1) / 10.0
        with np.errstate(divide='ignore', invalid='ignore'):
            shrink = np.where(scale > 1.0, 1.0 / scale, 1.0)
        delta = delta * shrink[:, None]
        beta = np.clip(beta + delta, -40.0, 40.0)
        if np.abs(delta).max() < tol and it > 1:
            break
    return beta, mu

# pass 1: near-Poisson fit -> method-of-moments dispersion
alpha0 = np.full(y.shape[0], 1e-4)
b1, mu1 = irls_nb(y, X, offset, alpha0)
s2 = ((y - mu1) ** 2).sum(axis=1) / (n_samples - p)
mu_bar = mu1.mean(axis=1)
alpha_raw = np.clip((s2 - mu_bar) / mu_bar ** 2, 0, 1e4)
z = 1.0 / np.maximum(mu_bar, 1e-8)
A = np.column_stack([z, np.ones_like(z)])
coef, *_ = np.linalg.lstsq(A, alpha_raw, rcond=None)
ss_tot = max(((alpha_raw - alpha_raw.mean()) ** 2).sum(), 1e-12)
a1, a0 = max(coef[0], 0.0), max(coef[1], 0.0)
alpha_trend_par = np.clip(a1 * z + a0, 1e-8, 1e4)
r2 = 1 - ((alpha_raw - alpha_trend_par) ** 2).sum() / ss_tot
print(f"[diagnostic] gene-wise dispersion (alpha_raw) vs expression:", flush=True)
qs = np.quantile(mu_bar, [0.1,0.5,0.9])
for q in qs:
    sel = mu_bar <= q
    print(f"   mu<= {q:.1f}: median alpha_raw={np.median(alpha_raw[sel]):.4g} (n={sel.sum()})", flush=True)
if r2 < 0.9:
    from statsmodels.nonparametric.smoothers_lowess import lowess
    lf = lowess(np.log(alpha_raw + 1e-4), np.log(np.maximum(mu_bar, 1e-8)),
                frac=0.8, it=0, return_sorted=True)
    # interpolate trend at each gene's log-mu
    alpha_trend = np.clip(np.exp(np.interp(np.log(np.maximum(mu_bar, 1e-8)), lf[:,0], lf[:,1])) - 1e-4, 1e-8, 1e4)
    print(f"[diagnostic] parametric trend R2={r2:.3f} -> using LOWESS trend on log-log", flush=True)
else:
    alpha_trend = alpha_trend_par
    print(f"[diagnostic] dispersion parametric trend a1={a1:.4g} a0={a0:.4g} R2={r2:.3f}", flush=True)

alpha = np.minimum(np.maximum(alpha_raw, alpha_trend), 1e3)
print(f"[diagnostic] median alpha_raw={np.median(alpha_raw):.4g}; median alpha used={np.median(alpha):.4g}", flush=True)

b2, mu2 = irls_nb(y, X, offset, alpha)
W = mu2 / (1 + alpha[:, None] * mu2)
Xb = np.broadcast_to(X, (y.shape[0], y.shape[1], p))
XW = Xb * W[:, :, None]
XtWX = np.einsum('gnp,gnq->gpq', XW, Xb) + Eye
se = np.sqrt(np.linalg.inv(XtWX)[:, 2, 2])
zstat = b2[:, 2] / se
pval = 2 * norm.sf(np.abs(zstat))
padj = multipletests(pval, method='fdr_bh')[1]

gt = {}
with open('data/gencode.v31.primary_assembly.genes.csv', newline='') as f:
    for row in csv.DictReader(f):
        gt[row['gene_id']] = (row['gene_name'], row['gene_type'], row['hgnc_id'])
res = pd.DataFrame({
    'gene_id': genes_kept,
    'mean_norm_expr': mu2.mean(axis=1) / sf.mean(),
    'log2FC_disease_vs_control': b2[:, 2] / np.log(2),
    'log2FC_M_vs_F': b2[:, 1] / np.log(2),
    'se': se, 'z': zstat, 'pval': pval, 'padj': padj,
})
res['gene_name'] = res['gene_id'].map(lambda g: gt.get(g, ('NA', 'NA', 'NA'))[0])
res['biotype'] = res['gene_id'].map(lambda g: gt.get(g, ('NA', 'NA', 'NA'))[1])
res.to_csv('results/de_results_all_tested_genes.tsv', sep='\t', index=False)

sig = res[res['padj'] < 0.05].sort_values('padj')
print(f"[diagnostic] genes tested: {len(res)}; DEGs padj<0.05: {len(sig)} "
      f"(up: {(sig['log2FC_disease_vs_control']>0).sum()}, down: {(sig['log2FC_disease_vs_control']<0).sum()})", flush=True)
sig.to_csv('results/de_significant_padj05.tsv', sep='\t', index=False)
print("\n=== top 40 DEGs by padj ===", flush=True)
print(sig.head(40)[['gene_id','gene_name','biotype','log2FC_disease_vs_control','padj']].to_string(index=False), flush=True)
print("\n=== top 20 up by LFC (padj<0.05) ===", flush=True)
print(sig.sort_values('log2FC_disease_vs_control', ascending=False).head(20)[['gene_name','biotype','log2FC_disease_vs_control','padj']].to_string(index=False), flush=True)
print("\n=== top 20 down by LFC (padj<0.05) ===", flush=True)
print(sig.sort_values('log2FC_disease_vs_control').head(20)[['gene_name','biotype','log2FC_disease_vs_control','padj']].to_string(index=False), flush=True)
print("\n[diagnostic] library sizes (raw, used for CPM):", dict(zip(cd.index, lib.astype(int).tolist())), flush=True)
print("[diagnostic] ORA feasibility: no GO annotation resource found on system "
      "(no obo/gaf/gene2go, no R/Bioconductor, no network, gencode 'ont' all NA) "
      "-> GO BP over-representation could NOT be executed; documented as critical limitation.", flush=True)
print("[done]", flush=True)
