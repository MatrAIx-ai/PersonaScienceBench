"""ASXL1-mutated fibroblasts vs control (Issy capsule).
DE: DESeq2-style NB GLM (NumPy IRLS; median-of-ratios size factors; MoM dispersion
with fitted trend floor), design ~ sex + condition. 14 samples with coldata
(MGD1640F/MGD1641F dropped: no metadata). ORA: hypergeometric on up-regulated
genes (FDR<0.05, log2FC>1) against curated GO BP sets (offline env)."""
import numpy as np, pandas as pd, sys
from scipy.stats import norm, hypergeom
sys.path.insert(0, '/workspace')
from gene_sets import SETS, resolve

counts_all = pd.read_csv('data/Issy_ASXL1_fibro_featureCounts_GeneTable_final.txt', sep=r'\s+', index_col=0)
coldata = pd.read_excel('data/Issy_ASXL1_fibro_coldata_gender.xlsx').set_index('sample')
samples = list(coldata.index)
Y = counts_all[samples].to_numpy(float); gene_ids = counts_all.index.to_numpy()

gencode = pd.read_csv('data/gencode.v31.primary_assembly.genes.csv', low_memory=False)
sym_map = dict(zip(gencode.gene_id, gencode.gene_name)); gtype = dict(zip(gencode.gene_id, gencode.gene_type))
hgnc = pd.read_csv('data/HGNC_05-09-19.txt', sep='\t', dtype=str).fillna('')
ens2sym = {e.strip(): r['Approved symbol'] for _, r in hgnc.iterrows()
           for e in r['Ensembl ID(supplied by Ensembl)'].split(', ') if e.strip()}
symbols = np.array([sym_map.get(g, ens2sym.get(g.split('.')[0], g.split('.')[0])) for g in gene_ids])
print('counts:', Y.shape, '| condition:', coldata.condition.value_counts().to_dict(),
      '| sex:', coldata.sex.value_counts().to_dict())

sexM = (coldata.sex == 'M').to_numpy(float)
cond = (coldata.condition == 'disease').to_numpy(float)   # ASSUMPTION: disease = ASXL1-mutated
X = np.column_stack([np.ones(len(samples)), sexM, cond]); n, p = X.shape

# size factors (median of ratios)
L = np.log(Y, where=Y > 0, out=np.full(Y.shape, np.nan))
gm = np.exp(np.nanmean(L, axis=1))
ratios = Y / gm[:, None]
sf = np.nanmedian(ratios, axis=0); sf /= np.exp(np.mean(np.log(sf))); off = np.log(sf)

keep = Y.sum(1) >= 10
print('genes kept (rowSums>=10):', int(keep.sum()), 'of', len(gene_ids))
Yk, symk, gidk = Y[keep], symbols[keep], gene_ids[keep]
gtypek = np.array([gtype.get(g, 'NA') for g in gidk]); G = Yk.shape[0]

# dispersion (two-pass, DESeq2-like): fit full model with small alpha, then
# method-of-moments dispersion from Pearson residuals; shrink with trend floor.
alpha0 = np.full(G, 1e-4)
beta = np.zeros((G, 3)); beta[:, 0] = np.log((Yk.sum(1) + 1) / n / sf.mean())
A_XXt = X[:, :, None] * X[:, None, :]
for it in range(60):
    eta = beta @ X.T + off[None, :]
    mu = np.clip(np.exp(eta), 1e-8, 1e12)
    w = mu / (1 + alpha0[:, None] * mu)
    z = eta - off[None, :] + (Yk - mu) / mu
    Ag = np.einsum('gj,jkl->gkl', w, A_XXt) + 1e-9 * np.eye(3)[None]
    bn = np.linalg.solve(Ag, ((w * z) @ X)[:, :, None])[:, :, 0]
    mv = np.abs(bn - beta).max(); beta = bn
    if mv < 1e-7: break
eta = beta @ X.T + off[None, :]
mu = np.clip(np.exp(eta), 1e-8, 1e12)
alpha_mom = np.maximum(0.0, (((Yk - mu)**2 - mu).sum(1)) / np.maximum((mu**2).sum(1), 1e-8))
m = alpha_mom > 0; qq = mu.mean(1)
tgt = np.minimum(alpha_mom[m], np.quantile(alpha_mom[m], .99))
coef, *_ = np.linalg.lstsq(np.column_stack([1/np.maximum(qq[m], 1e-8), np.ones(m.sum())]), tgt, rcond=None)
trend = np.maximum(coef[0]/np.maximum(qq, 1e-8) + coef[1], 1e-6)
alpha = np.minimum(np.maximum(alpha_mom, trend), 10.0)
print(f'trend a0={coef[0]:.2f} a1={coef[1]:.2e}; median alpha={np.median(alpha):.3f}')

def deviance(y, mu_, al):
    al = np.maximum(np.asarray(al, float), 1e-12).reshape(-1, 1)
    return 2 * np.sum(y*np.log((y+1e-10)/mu_) - (y+1/al)*np.log((y+1/al)/(mu_+1/al)), axis=1)

dev_prev = deviance(Yk, np.exp(beta @ X.T + off), alpha)
for it in range(60):
    eta = beta @ X.T + off[None, :]
    mu = np.clip(np.exp(eta), 1e-8, 1e12)
    w = mu / (1 + alpha[:, None] * mu)
    z = eta - off[None, :] + (Yk - mu) / mu
    Ag = np.einsum('gj,jkl->gkl', w, A_XXt) + 1e-9 * np.eye(3)[None]
    bn = np.linalg.solve(Ag, ((w * z) @ X)[:, :, None])[:, :, 0]
    step = np.ones((G, 1))
    dev_c = deviance(Yk, np.exp(bn @ X.T + off), alpha)
    for _ in range(10):
        bad = (~np.isfinite(dev_c)) | (dev_c > dev_prev)
        if not bad.any(): break
        step[bad] *= 0.5
        bc = beta + step*(bn - beta)
        dev_c = deviance(Yk, np.clip(np.exp(bc @ X.T + off), 1e-8, 1e12), alpha)
    beta = beta + step*(bn - beta)
    dev_prev = np.minimum(dev_c, dev_prev)
    if np.abs(bn - beta).max() < 1e-7: break
print('pass-2 IRLS iterations:', it + 1)
eta = beta @ X.T + off[None, :]; mu = np.clip(np.exp(eta), 1e-8, 1e12)
w = mu / (1 + alpha[:, None] * mu)
Ag = np.einsum('gj,jkl->gkl', w, A_XXt) + 1e-9 * np.eye(3)[None]
se = np.sqrt(np.linalg.inv(Ag)[:, 2, 2])
z = beta[:, 2] / se; pval = 2*norm.sf(np.abs(z)); l2fc = beta[:, 2]/np.log(2)
o = np.argsort(pval); r = pval[o]; fdr = np.empty(len(r))
fdr[o] = np.minimum.accumulate((r*len(r)/np.arange(1, len(r)+1))[::-1])[::-1]
deg = pd.DataFrame({'gene_id': gidk, 'symbol': symk, 'gene_type': gtypek,
                    'log2FC': l2fc, 'Wald_z': z, 'pvalue': pval, 'FDR': fdr})
deg.to_csv('results/degs_asxl1_fibro.tsv', sep='\t', index=False)
up = deg[(deg.FDR < .05) & (deg.log2FC > 1)]; down = deg[(deg.FDR < .05) & (deg.log2FC < -1)]
print(f'DEGs: up={len(up)} down={len(down)} total FDR<0.05={int((deg.FDR<.05).sum())}')
print('top up:'); print(up.sort_values('FDR').head(12)[['symbol','log2FC','FDR']].to_string(index=False))
print('top down:'); print(down.sort_values('FDR').head(8)[['symbol','log2FC','FDR']].to_string(index=False))

# cross-check: OLS t on log2(CPM+1)
lcpm = np.log2(Yk / sf[None, :] * 1e6 + 1)
XtXinv = np.linalg.inv(X.T @ X); bb = lcpm @ X @ XtXinv          # (G,3)
s2 = ((lcpm - bb @ X.T)**2).sum(1) / (n - p)
t_ols = bb[:, 2] / np.sqrt(s2 * XtXinv[2, 2])
po = np.argsort(-np.abs(t_ols))[:8]
print('OLS cross-check (symbol, OLS log2FC, NB log2FC):',
      list(zip(symk[po].tolist(), np.round(bb[po, 2]/np.log(2), 2).tolist(), np.round(l2fc[po], 2).tolist())))

# ORA on up-regulated
uni_syms = set(symk); rows = []
for name, spec in SETS.items():
    if isinstance(spec, str): mem = resolve(spec, symbols)
    elif isinstance(spec, tuple): mem = resolve(spec[0], symbols) | set(spec[1])
    else: mem = set(spec)
    mem_u = mem & uni_syms; K = len(mem_u)
    if K == 0: continue
    hits = len(set(up.symbol) & mem_u)
    if hits == 0: continue
    N = len(uni_syms); nup = len(set(up.symbol))
    rows.append({'term': name, 'n_set_in_universe': K, 'n_up_hits': hits, 'n_up_total': nup, 'universe_size': N,
                 'fold_enrichment': (hits/nup)/(K/N), 'p': hypergeom.sf(hits-1, N, K, nup)})
ora = pd.DataFrame(rows).sort_values('p').reset_index(drop=True)
mm = len(ora); oo = np.argsort(ora.p.values)
qv = ora.p.values[oo]*mm/np.arange(1, mm+1)
ora['FDR'] = 1.0; ora.loc[oo, 'FDR'] = np.minimum.accumulate(qv[::-1])[::-1]
ora.to_csv('results/ora_up_asxl1.tsv', sep='\t', index=False)
print('\n=== ORA top-5 (up genes; universe=%d; %d sets tested) ===' % (len(uni_syms), mm))
print(ora.head(5).round(6).to_string(index=False))
t = ora.iloc[0]
print(f'\nMOST ENRICHED PROCESS: {t.term} | {t.n_up_hits}/{t.n_set_in_universe} up-genes hit | p={t.p:.3e} FDR={t.FDR:.3e}')
print('outputs: results/degs_asxl1_fibro.tsv, results/ora_up_asxl1.tsv')
