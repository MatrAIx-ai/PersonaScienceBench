"""
BixBench bix-51-q1 — Logistic regression, Age as the only predictor.
Question: predicted probability of achieving efficacy (PR) with treatment at age 65.

Spec (researcher-approved):
  - Data: data/data.xlsx, Sheet1; drop the 41 empty filler rows -> 80 valid patients.
  - Outcome y = 1 if Efficacy == "PR", else 0 (SD/PD).
  - Predictor: Age (continuous), the ONLY covariate (no group term).
  - Model: statsmodels Logit (MLE), pooled over all 80 patients.
  - Report: point prediction at Age=65; 95% CI as optional diagnostic.

ASSUMPTIONS (S1-S5):
  S1. PR = partial response (success), SD = stable disease, PD = progressive disease.
  S2. "Treatment" = the regimen associated with Group 1 (the only group with PR).
  S3. Age in years, complete for the 80 valid patients; no imputation.
  S4. No weighting/sampling columns exist; observations independent.
  S5. Minimal preprocessing: drop empty filler rows, numeric coercion of Age.

UNCERTAINTIES (U1-U3):
  U1. "With treatment" ambiguity -> approved spec = pooled Logit(PR ~ Age); a
      treatment-group-only fit is degenerate (outcome constant, all PR).
  U2. G1/G2 arm labels unknown (treatment vs control, or two regimens).
  U3. The single ' ' Age value belongs to filler rows, not to a patient.
"""
import numpy as np
import pandas as pd
import statsmodels.api as sm

PATH = "/workspace/data/data.xlsx"

# --- Load and clean ---------------------------------------------------------
df = pd.read_excel(PATH, sheet_name="Sheet1")
raw_shape = df.shape
d = df[df["Sequence number"].notna()].copy()          # drop 41 filler rows
assert len(d) == 80, f"expected 80 valid patients, got {len(d)}"
d["Age"] = pd.to_numeric(d["Age"], errors="coerce")
assert d["Age"].notna().all()                          # S3: complete ages
assert d["Groups"].notna().all()

# --- Crosstab diagnostics ---------------------------------------------------
ct = pd.crosstab(d["Groups"], d["Efficacy"])
print("Groups x Efficacy crosstab:\n", ct, "\n")

# --- Model: y = 1[PR], X = [const, Age] -------------------------------------
y = (d["Efficacy"] == "PR").astype(int)
X = sm.add_constant(d["Age"].astype(float))
fit = sm.Logit(y, X).fit(disp=0)
print(fit.summary())

b0, b1 = fit.params["const"], fit.params["Age"]
print(f"\nconst = {b0:.6f}, beta_Age = {b1:.6f}")

# --- Point prediction at Age = 65 -------------------------------------------
p65 = float(fit.predict(pd.DataFrame({"const": [1.0], "Age": [65.0]}))[0])
print(f"Predicted P(PR | Age=65) = {p65:.4f}")

# --- 95% CI (diagnostic, delta method on logit scale) -----------------------
cov = fit.cov_params().loc[["const", "Age"], ["const", "Age"]].values
x0 = np.array([1.0, 65.0])
eta0 = b0 + b1 * 65
se_eta = float(np.sqrt(x0 @ cov @ x0))
lo, hi = eta0 - 1.959964 * se_eta, eta0 + 1.959964 * se_eta
ci = (1 / (1 + np.exp(-lo)), 1 / (1 + np.exp(-hi)))
print(f"95% CI (delta method): [{ci[0]:.4f}, {ci[1]:.4f}]")

# --- Cross-check with scipy-only MLE ----------------------------------------
def nll(beta):
    eta = beta[0] + beta[1] * d["Age"].values
    return -np.sum(y.values * eta - np.log(1 + np.exp(eta)))
from scipy.optimize import minimize
res = minimize(nll, x0=[0.0, 0.0], method="BFGS")
print("scipy cross-check params:", res.x, "-> p(65) =",
      1 / (1 + np.exp(-(res.x[0] + res.x[1] * 65))))

# --- Save summary ------------------------------------------------------------
with open("/workspace/analysis_bix51_q1_output.txt", "w") as f:
    f.write(f"raw_shape={raw_shape}\nvalid_n={len(d)}\n")
    f.write(ct.to_string())
    f.write(f"\nconst={b0:.6f}\nbeta_Age={b1:.6f}\n"
            f"p_PR_age65={p65:.6f}\nci95=({ci[0]:.6f}, {ci[1]:.6f})\n")
    f.write(fit.summary().as_text())
print("\nSaved: /workspace/analysis_bix51_q1_output.txt")
