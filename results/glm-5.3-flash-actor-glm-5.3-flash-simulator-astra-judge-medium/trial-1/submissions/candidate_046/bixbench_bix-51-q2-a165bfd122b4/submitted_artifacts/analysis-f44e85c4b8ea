import pandas as pd
import numpy as np
import statsmodels.api as sm

# Load and clean: drop fully-empty rows and the residual row
df = pd.read_excel("data/data.xlsx", sheet_name="Sheet1")
df = df.dropna(how="all")

# Binary outcome: PR=1, PD/SD=0; complete cases only (80 expected)
d = df[df["Efficacy"].isin(["PR", "PD", "SD"]) & df["BMI"].notna()].copy()
d["y"] = (d["Efficacy"] == "PR").astype(int)
print("n cases:", len(d), "| y=1 (PR):", d["y"].sum(), "| y=0 (PD/SD):", (1 - d["y"]).sum())

X = sm.add_constant(d["BMI"].astype(float).values)
model = sm.Logit(d["y"].values, X)
res = model.fit(disp=0)

logL = res.llf
k = 2
aic = -2 * logL + 2 * k
n = len(d)
aicc = aic + (2 * k * (k + 1)) / (n - k - 1)

print(f"Converged: {res.mle_retvals['converged']}")
print(f"Intercept: {res.params[0]:.6f}  Coef(BMI): {res.params[1]:.6f}")
print(f"Log-likelihood: {logL:.6f}")
print(f"k = {k}")
print(f"AIC  = -2*logL + 2k = {aic:.6f}  (statsmodels aic attr: {res.aic:.6f})")
print(f"AICc = {aicc:.6f}")
print(f"LLR p-value: {res.llr_pvalue:.4f}")
