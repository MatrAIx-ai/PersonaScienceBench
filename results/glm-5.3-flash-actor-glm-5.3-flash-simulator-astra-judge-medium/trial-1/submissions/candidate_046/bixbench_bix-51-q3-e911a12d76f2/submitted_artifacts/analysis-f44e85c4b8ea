"""BixBench bix-51-q3: Logistic regression — p-value for Age as predictor of PR."""
import pandas as pd
import numpy as np
import statsmodels.api as sm

# 1) Load and clean
df = pd.read_excel('data/data.xlsx', sheet_name='Sheet1')
d = df.dropna(how='all')                       # removes the fully-empty trailing row
d = d[d['Efficacy'].notna()]                   # drops the spurious row (Age=' ') -> 80 patients
assert len(d) == 80, f"Expected 80 patients, got {len(d)}"

# 2) Build model frame
y = (d['Efficacy'] == 'PR').astype(int)        # PR=1, SD/PD=0
X = pd.DataFrame({
    'BMI': d['BMI'].astype(float),
    'Age': d['Age_num'] if 'Age_num' in d else pd.to_numeric(d['Age'], errors='coerce'),
    'Gender_Male': (d['Gender'].str.strip() == 'Male').astype(int),  # Female=0, Male=1
})
X = sm.add_constant(X)
assert X.notna().all().all() and y.notna().all(), "Missing values in model frame"

# 3) Fit GLM Binomial (logit)
glm = sm.GLM(y, X, family=sm.families.Binomial())
res = glm.fit()
print("=== statsmodels GLM Binomial (logit) ===")
print("Converged:", res.converged, "| Iterations:", res.fit_history['iteration'])
print(res.summary())
print("\nOR (exp(beta)) and 95% CI:")
orci = np.exp(pd.DataFrame({'coef': res.params, 'CI_low': res.conf_int()[0], 'CI_high': res.conf_int()[1]}))
print(orci.to_string(float_format=lambda v: f"{v:.4f}"))

p_age = res.pvalues['Age']
print(f"\nMAIN ANSWER — p-value (two-sided Wald) for Age: {p_age:.6g}")
print(f"Age OR = {np.exp(res.params['Age']):.4f}, 95% CI "
      f"({np.exp(res.conf_int().loc['Age',0]):.4f}, {np.exp(res.conf_int().loc['Age',1]):.4f})")

# 4) Cross-check: equivalent Logit model and gender recoding invariance
logit_res = sm.Logit(y, X).fit(disp=0)
print("\nLogit (MLE) check — Age p-value:", f"{logit_res.pvalues['Age']:.6g}",
      "| converged:", logit_res.mle_retvals['converged'])

X_flip = X.copy()
X_flip['Gender_Male'] = 1 - X_flip['Gender_Male']
res_flip = sm.GLM(y, X_flip, family=sm.families.Binomial()).fit()
print("\nGender recoded Male=0/Female=1:")
print("  Gender coef:", f"{res_flip.params['Gender_Male']:.6f}",
      "| Gender p:", f"{res_flip.pvalues['Gender_Male']:.6g}")
print("  Age p-value:", f"{res_flip.pvalues['Age']:.6g}",
      "| identical to original:", np.isclose(p_age, res_flip.pvalues['Age']))

# 5) Reference: univariable p-values for context
for v in ['Age', 'BMI', 'Gender_Male']:
    r1 = sm.GLM(y, sm.add_constant(X[[v]]), family=sm.families.Binomial()).fit()
    print(f"Univariable {v}: p = {r1.pvalues[v]:.6g}")
