"""
BixBench bix-51-q4: Change in log-odds of remission per year increase in age
Logistic regression with Age, BMI, and Gender as predictors.

DECISIONS DOCUMENTED (per researcher approval):
1. Outcome definition: remission = 1 if Efficacy == 'PR', 0 if Efficacy in {'SD','PD'}.
   Uncertainty: no column is literally labeled 'remission'. Documented from data:
   Groups (1/2) is an exact binary recode of Efficacy (Groups=1 <=> Efficacy='PR',
   verified below), supporting the PR-vs-non-PR definition of remission.
2. Gender coding: dummy indicator with Female as reference (Gender_male = 1 if 'Male').
   Reference choice does not affect the Age coefficient.
3. Data cleaning: spreadsheet declares 121 rows but rows 80-119 are fully empty and
   row 120 contains only a whitespace string in Age; only rows 0-79 (80 patients,
   Sequence number 1-80) are real data. Complete-case analysis: 0 missing values in
   Age/BMI/Gender/Efficacy among the 80 real patients -> no imputation needed.
"""
import numpy as np
import pandas as pd
import statsmodels.api as sm

df = pd.read_excel('data/data.xlsx', sheet_name='Sheet1')

# --- Cleaning: keep real patient rows (drop fully empty rows / whitespace-only row)
d = df.iloc[:80].copy()
assert len(d) == 80 and d['Sequence number'].nunique() == 80
assert d[['Age', 'BMI', 'Gender', 'Efficacy', 'Groups']].notna().all().all()

# --- Outcome: remission = PR vs non-PR (SD/PD)
d['remission'] = (d['Efficacy'] == 'PR').astype(int)
d['age'] = d['Age'].astype(float)
d['bmi'] = d['BMI'].astype(float)
d['gender_male'] = (d['Gender'] == 'Male').astype(int)  # reference = Female

# --- Internal control: Groups == 1 as outcome must reproduce the same fit
assert ((d['Groups'] == 1).astype(int) == d['remission']).all()

X = sm.add_constant(d[['age', 'bmi', 'gender_male']])
y = d['remission']

model_efficacy = sm.Logit(y, X).fit(disp=0)
model_groups   = sm.Logit((d['Groups'] == 1).astype(int), X).fit(disp=0)

print("=== Model 1: outcome = remission (Efficacy == 'PR') ===")
print(model_efficacy.summary())
print("\n=== Model 2 (control): outcome = Groups == 1 ===")
print(model_groups.summary())

b = model_efficacy.params['age']; se = model_efficacy.bse['age']
ci = model_efficacy.conf_int().loc['age']
print("\n--- AGE COEFFICIENT (Model 1) ---")
print(f"beta_age (log-odds per year) = {b:.4f}")
print(f"SE = {se:.4f}, 95% CI = [{ci[0]:.4f}, {ci[1]:.4f}], p = {model_efficacy.pvalues['age']:.4f}")
print(f"OR per year = {np.exp(b):.4f} (95% CI {np.exp(ci[0]):.4f}-{np.exp(ci[1]):.4f})")

# Control check
identical = np.allclose(model_efficacy.params, model_groups.params) and \
            np.allclose(model_efficacy.bse, model_groups.bse)
print(f"\nControl: Groups==1 outcome reproduces identical coefficients: {identical}")
print(f"Max |coef difference| = {np.max(np.abs(model_efficacy.params - model_groups.params)):.2e}")

# Diagnostics
print(f"\nConverged: {model_efficacy.mle_retvals['converged']}, "
      f"n = {int(model_efficacy.nobs)}, events (remission) = {int(y.sum())}")
print(f"Pseudo R2 = {model_efficacy.prsquared:.4f}, LL = {model_efficacy.llf:.3f}")

with open('output/results.txt', 'w') as f:
    f.write(model_efficacy.summary().as_text())
    f.write("\n\nCONTROL (Groups==1 outcome):\n" + model_groups.summary().as_text())
    f.write(f"\n\nbeta_age = {b:.4f}; SE = {se:.4f}; 95% CI [{ci[0]:.4f}, {ci[1]:.4f}]; "
            f"p = {model_efficacy.pvalues['age']:.4f}; OR = {np.exp(b):.4f}\n")
    f.write(f"Identical fit with Groups==1 outcome: {identical}\n")
