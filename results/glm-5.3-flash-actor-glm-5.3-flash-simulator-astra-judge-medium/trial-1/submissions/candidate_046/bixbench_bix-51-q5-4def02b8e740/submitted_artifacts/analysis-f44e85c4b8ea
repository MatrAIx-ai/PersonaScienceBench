"""
BixBench bix-51-q5: p-value for BMI association with treatment response.
Logistic regression: response (PR=1 vs SD+PD=0) ~ BMI, N=80 (rows 81-121 are empty padding).
Primary model: unadjusted. Sensitivity: adjusted by 7 covariates. Wald + LR tests.
"""
import pandas as pd
import numpy as np
import statsmodels.api as sm
from scipy import stats
import warnings

df = pd.read_excel('data/data.xlsx', sheet_name='Sheet1')
df = df[df['Efficacy'].notna()].copy()          # drop empty padding rows -> N=80
assert len(df) == 80

# Outcome: PR=1, SD/PD=0 (backed by perfect Groups-Efficacy separation: Group1=all PR, Group2=SD+PD)
df['response'] = (df['Efficacy'] == 'PR').astype(int)
df['bmi'] = df['BMI'].astype(float)

# Covariate coding (fixed reference levels). ECOG-PS values are mixed numeric 2 / string '0-1'.
df['gender_female'] = (df['Gender'] == 'Female').astype(int)
df['family_history_yes'] = (df['Family history'] == 'Yes').astype(int)
df['ecog_2'] = (df['ECOG-PS'].astype(str) == '2').astype(int)
df['childpugh_B'] = (df['Child-Pugh'] == 'B').astype(int)
df['chemo_yes'] = (df['Chemotherapy experience'] == 'Yes').astype(int)
df['hbv_yes'] = (df['HBV infection'] == 'Yes').astype(int)
df['age'] = df['Age'].astype(float)

def report(m, label):
    b = m.params['bmi']; se = m.bse['bmi']; z = b/se; p = m.pvalues['bmi']
    print(f"--- {label} (converged={m.mle_retvals['converged']}) ---")
    print(m.summary().tables[1])
    print(f"BMI coef={b:.6f} SE={se:.6f} Wald z={z:.4f} Wald p={p:.6f} OR={np.exp(b):.4f}")
    return b, se, p

# ---- Primary: unadjusted ----
X0 = sm.add_constant(df[['bmi']])
m0 = sm.Logit(df['response'], X0).fit(disp=0)
b0, se0, p0 = report(m0, "PRIMARY unadjusted: response ~ BMI")
m0_null = sm.Logit(df['response'], np.ones(len(df))).fit(disp=0)
lr0 = 2*(m0.llf - m0_null.llf); p_lr0 = stats.chi2.sf(lr0, 1)
print(f"LR test (primary): chi2={lr0:.4f} df=1 p={p_lr0:.6f}\n")

# ---- Sensitivity: adjusted (7 covariates + BMI) ----
covs = ['age','gender_female','family_history_yes','ecog_2','childpugh_B',
        'chemo_yes','hbv_yes','bmi']
X1 = sm.add_constant(df[covs])
with warnings.catch_warnings():
    warnings.simplefilter("ignore")
    m1 = sm.Logit(df['response'], X1).fit(disp=0)   # default Newton
b1, se1, p1 = report(m1, "SENSITIVITY adjusted: response ~ BMI + 7 covariates")

with warnings.catch_warnings():
    warnings.simplefilter("ignore")
    m1_null = sm.Logit(df['response'], X1.drop(columns='bmi')).fit(disp=0)
lr1 = 2*(m1.llf - m1_null.llf); p_lr1 = stats.chi2.sf(lr1, 1)
print(f"LR test (adjusted, BMI dropped): chi2={lr1:.4f} df=1 p={p_lr1:.6f}")

print("\nDiagnostics adjusted model (8 params, 41 events):")
print("converged:", m1.mle_retvals['converged'], "| iterations:", m1.mle_retvals['iterations'])
print("max |coef|:", m1.params.abs().max().round(3), "| max SE:", m1.bse.abs().max().round(3))
print("pseudo R2:", round(m1.prsquared, 4), "| LLR p (full vs null):", round(m1.llr_pvalue, 6))
pred = m1.predict(X1)
print("predicted prob range:", round(pred.min(), 4), "-", round(pred.max(), 4),
      "| any >0.999:", bool((pred > 0.999).any()))
# quasi-separation check: any 2x2 covariate table with a zero cell?
for c in covs[:-1]:
    if df[c].nunique() <= 5:
        tab = pd.crosstab(df[c], df['response'])
        if tab.min().min() == 0:
            print("PERFECT SEPARATION in:", c)
print("(no 'PERFECT SEPARATION' lines above means no zero-cell separation per covariate)")

print("\n=== ANSWER ===")
print(f"PRIMARY p-value for BMI (Wald, unadjusted): {p0:.4f}")
print(f"Sensitivity p-value for BMI (Wald, adjusted): {p1:.4f}")
