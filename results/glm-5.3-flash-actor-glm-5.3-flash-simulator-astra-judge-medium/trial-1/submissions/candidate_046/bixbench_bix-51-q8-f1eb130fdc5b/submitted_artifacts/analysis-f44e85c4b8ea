"""
BixBench bix-51-q8 — Simple logistic regression: age & camrelizumab response.
Coefficient estimate (change in log-odds) for AGE.
Deterministic (no randomness, no seed needed). Python + pandas + statsmodels + numpy.
"""
import warnings
import numpy as np
import pandas as pd
import statsmodels.api as sm
from statsmodels.tools.sm_exceptions import PerfectSeparationWarning

# ---------------------------------------------------------------- load & clean
df = pd.read_excel('data/data.xlsx', sheet_name='Sheet1')
print('RAW shape:', df.shape)

d = df.dropna(how='all').copy()          # drop fully empty padding rows
n_after_dropna = len(d)
d = d[d['Groups'].notna()].copy()        # keep rows with actual treatment assignment
print('Rows after dropping empty padding:', n_after_dropna,
      '| valid patient rows with treatment assignment:', len(d))

d['y']   = (d['Efficacy'] == 'PR').astype(float)          # response: 1=PR, 0=SD/PD
d['age'] = pd.to_numeric(d['Age'], errors='coerce')        # continuous, years
d['trt'] = (d['Groups'] == 1).astype(float)                # camrelizumab (Group 1, declared assumption)

print('\nValue counts:')
print('  Groups :', d['Groups'].value_counts().to_dict())
print('  Efficacy:', d['Efficacy'].value_counts().to_dict())
print('  Age    : complete for all valid rows =', bool(d['age'].notna().all()),
      '| range %.0f-%.0f' % (d['age'].min(), d['age'].max()))
print('\nCrosstab Groups x Efficacy:')
print(pd.crosstab(d['Groups'], d['Efficacy']))
print('\nResponses (PR=1) by treatment:', d.groupby('trt')['y'].sum().to_dict())
print('n =', len(d), '| total responses =', int(d['y'].sum()))

# NOTE the crosstab shows PERFECT SEPARATION: Group 1 -> 41/41 PR; Group 2 -> 0/39 PR.

X_age  = sm.add_constant(d['age'])
X_both = pd.DataFrame({'const': 1.0, 'age': d['age'].values, 'trt': d['trt'].values})
y      = d['y'].values

def report(name, params, bse, pvals, conv, iters, extra=''):
    print('\n=== %s ===' % name)
    print('  converged=%s  iterations=%s  %s' % (conv, iters, extra))
    for k in params.index:
        print('  %-5s coef=%12.6f  SE=%12.6f  p=%.5g' % (k, params[k], bse[k], pvals[k]))

# --------------------------------------------- (a) univariate MLE: age only
m1 = sm.GLM(y, X_age, family=sm.families.Binomial()).fit(maxiter=200)
report('A) UNIVARIATE MLE (age only)', m1.params, m1.bse, m1.pvalues,
       m1.converged, m1.fit_history['iteration'])
age_uni, se_uni, p_uni = m1.params['age'], m1.bse['age'], m1.pvalues['age']

# --------------------------------- (b) multivariable MLE: age + treatment
with warnings.catch_warnings(record=True) as wlist:
    warnings.simplefilter('always')
    m2 = sm.GLM(y, X_both, family=sm.families.Binomial()).fit(maxiter=500)
sep_warn = any(issubclass(w.category, PerfectSeparationWarning) for w in wlist)
report('B) MULTIVARIABLE MLE (age + camrelizumab)', m2.params, m2.bse, m2.pvalues,
       m2.converged, m2.fit_history['iteration'],
       extra='| PerfectSeparationWarning raised: %s' % sep_warn)
print('  -> treatment coef diverges under separation; Age coef NOT identifiable by standard MLE.')

# ------------------------------------------ (c) Firth penalized logit (IRLS)
def firth_logit(X, yv, maxiter=1000, tol=1e-12):
    """Firth (1993) penalized-likelihood logistic regression via IRLS.
    Modified score: U*_j = sum_i [y_i - mu_i + h_i(0.5 - mu_i)] x_ij,
    hat diagonal h_i = W_i * x_i'(X'WX)^{-1} x_i.  SEs from the inverse of the
    modified information matrix H - 0.5*Q, Q_jl = sum_i W_i(1-2mu_i) h_i x_ij x_il."""
    X = np.asarray(X, float); yv = np.asarray(yv, float)
    n, p = X.shape; beta = np.zeros(p)
    for it in range(maxiter):
        mu = 1/(1+np.exp(-(X@beta))); W = mu*(1-mu)
        H  = X.T@(X*W[:,None])
        Hinv = np.linalg.solve(H, np.eye(p))
        q = np.einsum('ij,jk,ik->i', X, Hinv, X)
        h = W*q
        U = X.T@(yv-mu) + 0.5*((h*(1-2*mu))[:,None]*X).sum(axis=0)
        step = Hinv@U
        beta = beta + step
        if np.max(np.abs(step)) < tol:
            mu = 1/(1+np.exp(-(X@beta))); W = mu*(1-mu)
            H  = X.T@(X*W[:,None]); Hinv = np.linalg.solve(H, np.eye(p))
            h = W*np.einsum('ij,jk,ik->i', X, Hinv, X)
            cov = np.linalg.inv(H - 0.5*np.einsum('i,ij,ik->jk', W*(1-2*mu)*h, X, X))
            return beta, np.sqrt(np.diag(cov)), it+1, np.max(np.abs(U))
    raise RuntimeError('Firth IRLS did not converge')

b3, se3, it3, score3 = firth_logit(X_both, y)
names3 = ['const', 'age', 'trt']
from scipy.stats import norm
z3 = b3/se3; p3 = 2*(1-norm.cdf(np.abs(z3)))
print('\n=== C) FIRTH PENALIZED MLE (age + camrelizumab) ===')
print('  converged=True (score max |U*| = %.2e)  iterations=%d' % (score3, it3))
for n_, b_, s_, p_ in zip(names3, b3, se3, p3):
    print('  %-5s coef=%12.6f  SE=%12.6f  p=%.5g' % (n_, b_, s_, p_))
age_firth, se_firth, p_firth = b3[1], se3[1], p3[1]

b4, se4, it4, score4 = firth_logit(X_age.values, y)
z4 = b4/se4; p4 = 2*(1-norm.cdf(np.abs(z4)))
print('\n=== D) FIRTH PENALIZED MLE (age only) ===')
print('  converged=True (score max |U*| = %.2e)  iterations=%d' % (score4, it4))
for n_, b_, s_, p_ in zip(['const', 'age'], b4, se4, p4):
    print('  %-5s coef=%12.6f  SE=%12.6f  p=%.5g' % (n_, b_, s_, p_))

# ------------------------------------------------------------------ summary
print('\n' + '='*78)
print('SUMMARY — coefficient of AGE (change in log-odds per year of age)')
print('='*78)
print('A) Univariate MLE (age only)          : %+.4f  (SE %.4f, p=%.4g)  [ADOPTED as primary]' % (age_uni, se_uni, p_uni))
print('B) Multivariable MLE (age+trt)        : %+.4f  (SE %.1f)  DEGENERATE — perfect separation, not identifiable' % (m2.params['age'], m2.bse['age']))
print('C) Firth penalized (age+trt)          : %+.4f  (SE %.4f, p=%.4g)  [separation-robust adjusted estimate]' % (age_firth, se_firth, p_firth))
print('D) Firth penalized (age only)         : %+.4f  (SE %.4f)' % (b4[1], se4[1]))
print('\nReason standard multivariable model is unidentified: Group 1 (camrelizumab) has')
print('41/41 responses (PR) and Group 2 has 0/39 — perfect separation of the response by')
print('treatment, so the treatment log-odds diverges to +infinity and the joint MLE does')
print('not yield finite, stable coefficients for the adjusted model.')
