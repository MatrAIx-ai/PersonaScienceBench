"""
BixBench bix-52-q7 — How many sites are removed when filtering sites that
do not show >90% or <10% methylation in Zebra Finch?

Approach (approved):
- Filter at site level ('Pos'), not per site-by-sample record.
- A site is KEPT if at least one of its records (any sample) shows
  MethylationPercentage >90 or <10 (strict, exclusive thresholds).
- A site is REMOVED if none of its records is extreme (all records in [10, 90]).
- MethylationPercentage is used as-is (0-100 scale).
Sensitivities: inclusive thresholds (>=90/<=10), "all records extreme" reading,
and JD (Japanese Quail) as comparison.
"""
import pandas as pd

def load(path):
    df = pd.read_csv(path)
    # formal duplicate check: site x sample records
    dup = df.duplicated(subset=['Pos', 'Sample']).sum()
    return df, dup

def summarize(df, label):
    total_sites = df['Pos'].nunique()
    total_rows = len(df)
    g = df.groupby('Pos')['MethylationPercentage']

    # PRIMARY: keep site if ANY record >90 or <10 (strict)
    keep_any_strict = g.apply(lambda s: ((s > 90) | (s < 10)).any())
    # Sensitivity 1: inclusive thresholds
    keep_any_incl = g.apply(lambda s: ((s >= 90) | (s <= 10)).any())
    # Sensitivity 2: keep site only if ALL records are >90 or <10
    keep_all_strict = g.apply(lambda s: ((s > 90) | (s < 10)).all())

    def report(keep_mask, name):
        kept = int(keep_mask.sum())
        removed = total_sites - kept
        removed_rows = int((~df['Pos'].map(keep_mask)).sum())
        print(f"[{label}] {name}: sites kept={kept}, sites removed={removed} "
              f"(rows removed={removed_rows} of {total_rows})")
        return kept, removed, removed_rows

    print(f"\n===== {label} =====")
    print(f"rows={total_rows}, unique sites={total_sites}, "
          f"unique samples={df['Sample'].nunique()}, SampleL levels={df['SampleL'].nunique()}, "
          f"chromosomes={df['Chromosome'].nunique()}, Dage range=[{df['Dage'].min()}, {df['Dage'].max()}]")
    k1 = report(keep_any_strict, "PRIMARY  (any record >90 or <10, strict)")
    k2 = report(keep_any_incl,  "sensitivity: inclusive >=90/<=10")
    k3 = report(keep_all_strict, "sensitivity: ALL records >90 or <10")
    return k1, k2, k3

zf, zf_dup = load('data/ZF_AgeRelated_CpG_noMT_Final.csv')
jd, jd_dup = load('data/JD_AgeRelated_CpG_noMT_Final.csv')
print(f"Duplicate Pos x Sample rows: ZF={zf_dup}, JD={jd_dup}")

zf_res = summarize(zf, 'Zebra Finch (ZF_AgeRelated_CpG_noMT_Final.csv)')
jd_res = summarize(jd, 'Japanese Quail / JD (JD_AgeRelated_CpG_noMT_Final.csv)')

print("\n===== ANSWER =====")
print(f"Zebra Finch: {zf_res[0][1]} of {zf['Pos'].nunique()} sites are removed "
      f"when filtering sites that do not show >90% or <10% methylation.")
