"""
UBE2M knockdown differential expression analysis (DESeq2 emulation in Python).
Offline environment: R/DESeq2, gseapy and the KEGG_2019_Mouse gene-set library are
NOT available (attempts documented separately). This script executes every step
that can be executed faithfully and exports the DE table + ranked gene list.
Contrast: KL1-KL3 = UBE2M knockdown (KD) vs WL1-WL3 = wild-type control.
Positive log2FC = up-regulated in KD.
"""
import time, numpy as np, pandas as pd
from scipy import optimize, special
from scipy.stats import norm
LN2 = np.log(2.0)
t0 = time.time()

# ---------------------------------------------------------------- load data
df = pd.read_csv("data/count.csv")
assert list(df.columns) == ["geneID","KL1","KL2","KL3","WL1","WL2","WL3"]
counts = df.iloc[:,1:].to_numpy(float)
genes  = df["geneID"].to_numpy()
print(f"input: {counts.shape[0]} genes x 6 samples; all integer: {bool(np.all(counts%1==0))}")

keep = counts.sum(1) > 0                      # DESeq2 all-zero pre-filter
Y, gid = counts[keep], genes[keep]
print(f"after all-zero filter: {Y.shape[0]} genes (dropped {(~keep).sum()})")

# --------------------------------------------- size factors (median of ratios)
with np.errstate(divide='ignore', invalid='ignore'): lg = np.log(Y); lg[lg == -np.inf] = np.nan          # mask zeros (DESeq2 convention)
sf = np.exp(np.nanmedian(lg - np.nanmean(np.where(np.isnan(lg), np.nan, lg), axis=1)[:,None], axis=0))
print("size factors:", np.round(sf,4))

# --------------------------------------------- design: intercept + condition(KD)
X = np.column_stack([np.ones(6), [0.,0.,0.,1.,1.,1.]])

# --------------------------------------------- batched NB GLM IRLS (log link)
def glm_fit(Y, off, alpha, iters=30):
    G, m = Y.shape; p = 2
    b = np.zeros((G,p)); b[:,0] = np.log(Y.mean(1)/np.exp(off).mean())
    for _ in range(iters):
        eta = b @ X.T + off
        mu  = np.exp(eta)
        W   = mu/(1.0 + alpha[:,None]*mu)
        z   = eta - off + (Y-mu)/np.maximum(mu,1e-12)
        XtW = X[None,:,:] * W[:,:,None]
        A   = np.einsum('gip,iq->gpq', XtW, X)
        rhs = np.einsum('gip,gi->gp', XtW, z)[:,:,None]   # G x p x 1
        b   = np.linalg.solve(A + 1e-9*np.eye(p)[None], rhs)[:,:,0]
    eta = b @ X.T + off; mu = np.exp(eta)
    W   = mu/(1.0 + alpha[:,None]*mu)
    XtW = X[None,:,:] * W[:,:,None]
    A   = np.linalg.inv(np.einsum('gip,iq->gpq', XtW, X) + 1e-9*np.eye(p)[None])
    return b, mu, A


# --------------------------------------------- dispersion: MoM -> trend -> EB MAP
off = np.log(sf)[None,:]
mu0  = Y/sf[None,:]
m_g  = mu0.mean(1); v_g = mu0.var(1, ddof=1)
alpha_raw = np.clip(np.maximum((v_g - m_g)/np.maximum(m_g,1e-8)**2, 1e-8), 1e-8, 100.)

def fit_trend():
    sel = (m_g > 0.5) & (alpha_raw > 1e-6)
    mm, aa = m_g[sel], alpha_raw[sel]
    wgt = np.sqrt(mm/(1.0+mm))
    def f(par):
        a1, a0 = np.exp(par)
        at = np.clip(a1/mm + a0, 1e-8, None)
        return np.sum(wgt*(np.log(aa)-np.log(at))**2)
    best = None
    for init in [(np.log(1.),np.log(0.05)),(np.log(0.1),np.log(0.05)),(np.log(5.),np.log(0.02))]:
        r = optimize.minimize(f, init, method='Nelder-Mead',
                              options={'xatol':1e-6,'fatol':1e-10,'maxiter':4000})
        if best is None or r.fun < best.fun: best = r
    return float(np.exp(best.x[0])), float(np.exp(best.x[1]))
a1, a0 = fit_trend()
alpha_tr = np.clip(a1/np.maximum(m_g,1e-8) + a0, 1e-8, 100.)
print(f"dispersion trend: alpha = {a1:.4g}/mean + {a0:.4g}")

def disp_map_vec(Y, mu, alpha_prior):
    """Per-gene MAP of alpha given current mu; Cauchy prior on log(alpha/alpha_prior)."""
    G = Y.shape[0]
    out = np.empty(G)
    lnp = np.log(np.maximum(alpha_prior,1e-8))
    def obj(loga):
        a = np.exp(np.clip(loga, -9.2, 4.6))       # scalar, (G,) or (G,K)
        if np.ndim(a) == 2:                        # grid case: (G,K) -> (G,1,K)
            r   = 1.0/a[:,None,:]
            Y3  = Y[:,:,None]; mu3 = mu[:,:,None]
        else:
            r = 1.0/a; Y3 = Y; mu3 = mu
        ll  = (special.gammaln(Y3+r) - special.gammaln(r) - special.gammaln(Y3+1)
               + r*np.log(r/(r+mu3)) + Y3*np.log(mu3/(r+mu3)))
        ll  = ll.sum(1)
        d   = loga - (lnp[:,None] if np.ndim(a)==2 else lnp)
        return -(ll - np.log1p(d*d) + loga)   # posterior = ll + Cauchy -log1p(d^2) + log(alpha) [Jacobian]
    # vectorised coarse grid + local refine (fast, accurate enough)
    lo, hi = -9.2, 4.6
    grid = np.linspace(lo, hi, 121)
    vals = np.stack([obj(g) for g in grid], 1)          # G x 121
    j = vals.argmin(1)
    lo_g = grid[np.maximum(j-1,0)]; hi_g = grid[np.minimum(j+1,120)]
    # local refinement pass
    grid2 = np.linspace(0,1,41)
    pts   = lo_g[:,None] + grid2[None,:]*(hi_g-lo_g)[:,None]
    vals2 = obj(pts)                                   # G x 41
    j2 = vals2.argmin(1)
    l2 = pts[np.arange(G), np.maximum(j2-1,0)]; h2 = pts[np.arange(G), np.minimum(j2+1,40)]
    out = np.exp(0.5*(l2+h2))
    return np.clip(out, 1e-4, 100.)

alpha = alpha_tr.copy()
for it in range(2):
    b, mu, _ = glm_fit(Y, off, alpha)
    alpha = disp_map_vec(Y, mu, alpha_tr)
    print(f"dispersion EB iteration {it+1} done; median alpha = {np.median(alpha):.4g}")

# --------------------------------------------- final GLM at MAP dispersion
b, mu, Ainv = glm_fit(Y, off, alpha)
var_b1 = Ainv[:,1,1]
se     = np.sqrt(np.maximum(var_b1,1e-12))
z      = b[:,1]/se
pval   = 2.0*norm.sf(np.abs(z))
baseMean = mu0.mean(1)
lfc_mle  = b[:,1]/LN2
se_mle   = se/LN2

# --------------------------------------------- apeglm-style shrinkage (Gaussian-prior MAP)
top = np.argsort(-baseMean)[:5000]
w   = 1.0/(se_mle[top]**2 + 1.0)
s2  = float(np.sum(w*lfc_mle[top]**2)/np.sum(w))
print(f"adaptive prior variance s2 = {s2:.4f} (prior sd {np.sqrt(s2):.3f} log2)")
lfc_shrunk = lfc_mle * s2/(s2 + se_mle**2)

# --------------------------------------------- BH padj (reported; filter uses raw p)
order = np.argsort(pval); G = len(pval)
adj = np.minimum.accumulate((pval[order]*G/np.arange(1,G+1))[::-1])[::-1]
padj = np.empty(G); padj[order] = np.clip(adj,0,1)

de = pd.DataFrame({"geneID":gid,"baseMean":baseMean,"log2FoldChange":lfc_mle,
                   "lfcSE":se_mle,"log2FoldChange_shrunk":lfc_shrunk,
                   "stat":z/LN2,"pvalue":pval,"padj":padj,"dispersion_MAP":alpha})
de.to_csv("de_table.csv", index=False)

sig = de[(de.pvalue<0.05)&(de.log2FoldChange_shrunk.abs()>1)&(de.baseMean>10)]
sig = sig.sort_values("log2FoldChange_shrunk", ascending=False)
sig.to_csv("sig_genes.csv", index=False)
pd.DataFrame({"geneID":sig.geneID,"score":sig.log2FoldChange_shrunk}).to_csv(
    "ranked_list_for_prerank.csv", index=False)

print("\n===== SUMMARY =====")
print(f"genes tested: {G}; DE passing filters (p<0.05, |LFC_shrunk|>1, baseMean>10): {len(sig)}")
print(f"  up in KD: {(sig.log2FoldChange_shrunk>1).sum()}   down in KD: {(sig.log2FoldChange_shrunk<-1).sum()}")
print(f"padj<0.05 genome-wide: {(padj<0.05).sum()}")
print("\nTop 12 up-in-KD:");  print(sig.head(12).to_string(index=False))
print("\nTop 12 down-in-KD:"); print(sig.tail(12).to_string(index=False))
print("\n10 most significant filtered genes:"); print(sig.nsmallest(10,"pvalue").to_string(index=False))

# --------------------------------- local enrichment feasibility (documented attempt)
import importlib, pathlib
found=[]
for pkg in ["gseapy","goatools","bioservices","mygene"]:
    try: importlib.import_module(pkg); found.append(pkg)
    except Exception: pass
print("\nlocal enrichment feasibility: enrichment pkgs:", found or "NONE",
      "| .gmt files on filesystem:", len(list(pathlib.Path('/').glob('**/*.gmt'))))
print("=> KEGG_2019_Mouse prerank NOT executable offline; documented, not fabricated.")
print(f"total runtime: {time.time()-t0:.1f}s")
