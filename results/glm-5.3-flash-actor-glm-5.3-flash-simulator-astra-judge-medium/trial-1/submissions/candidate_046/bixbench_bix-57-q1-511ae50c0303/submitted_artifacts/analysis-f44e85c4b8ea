#!/usr/bin/env python3
"""
BixBench bix-57-q1 — Percentage of gap characters relative to total alignment
positions across all alignments after aligning with MAFFT (--auto).

Method (approved by researcher):
  For each of the 10 input FASTA files run:  mafft --auto data/<name>.faa > alignments/<name>.aln.faa
  Parse each MAFFT FASTA alignment and count:
    numerator   = total gap characters ('-' plus any '.' if present) over all
                  aligned rows/columns of ALL alignments (pooled)
    denominator = total characters INCLUDING gaps over ALL alignments
                  (= sum over alignments of n_seq * alignment_length)
  Result = 100 * numerator / denominator (pooled ratio, not mean of per-file %).
  Trailing gaps included; no trimming; lowercase/ambiguous residues would count
  in the denominator as non-gap characters.

If MAFFT cannot be obtained, NO substitute aligner is used: the script logs all
discovery/provisioning attempts and reports the failure honestly.
"""
import os, sys, shutil, subprocess, glob, json, socket, datetime

TS = datetime.datetime.now().isoformat(timespec="seconds")
LOG = []
def log(msg):
    line = f"[{datetime.datetime.now().isoformat(timespec='seconds')}] {msg}"
    LOG.append(line); print(line, flush=True)

def read_fasta(path):
    seqs, name = {}, None
    for raw in open(path):
        line = raw.strip()
        if not line: continue
        if line.startswith(">"):
            name = line[1:].split()[0]; seqs[name] = []
        else:
            seqs[name].append(line)
    return {k: "".join(v) for k, v in seqs.items()}

# ---------------------------------------------------------------- inputs ----
INPUTS = sorted(glob.glob("data/*.faa"))
log(f"Input FASTA files: {len(INPUTS)}")
inputs_stats = {}
for f in INPUTS:
    seqs = read_fasta(f)
    lens = [len(s) for s in seqs.values()]
    allchars = "".join(seqs.values())
    pre_gaps = sum(allchars.count(c) for c in "-.")
    nonstd = sorted({c for c in allchars if not c.isalpha()})
    inputs_stats[f] = {"n_seq": len(seqs), "min_len": min(lens), "max_len": max(lens),
                       "total_residues": sum(lens), "pre_existing_gaps": pre_gaps,
                       "non_alphabet_chars": nonstd, "has_lowercase": any(c.islower() for c in allchars)}
    log(f"  {f}: n_seq={len(seqs)} len={min(lens)}-{max(lens)} residues={sum(lens)} "
        f"pre_existing_gaps={pre_gaps} non_alpha={nonstd or 'none'} lowercase={any(c.islower() for c in allchars)}")

# ------------------------------------------------- MAFFT discovery phase ----
log("== MAFFT discovery / provisioning attempts ==")
mafft = shutil.which("mafft")
log(f"1) shutil.which('mafft') in PATH: {mafft}")

extra_dirs = ["/usr/local/bin", "/opt", "/snap/bin", "/nix/var/nix/profiles/default/bin",
              "<HOME>/tools", "/home/tools", "/usr/bin", os.getcwd()]
found_extra = []
for d in extra_dirs:
    if os.path.isdir(d):
        for root, dirs, files in os.walk(d):
            for fn in files:
                if "mafft" in fn.lower():
                    found_extra.append(os.path.join(root, fn))
            if root.count(os.sep) - d.count(os.sep) >= 3:
                dirs[:] = []
log(f"2) targeted walk of {extra_dirs}: {found_extra or 'no mafft files found'}")

disk_hits = []
try:
    out = subprocess.run(["find", "/", "-xdev", "-iname", "*mafft*", "-not", "-path", "/proc/*"],
                         capture_output=True, text=True, timeout=120)
    disk_hits = [l for l in out.stdout.splitlines() if l.strip()]
except Exception as e:
    log(f"   full-disk find failed: {e}")
log(f"3) full-disk filesystem search for '*mafft*': {disk_hits or 'NOTHING FOUND'}")

install_attempts = []
# 3a) apt-get (needs root)
try:
    r = subprocess.run(["apt-get", "install", "-y", "--no-install-recommends", "mafft"],
                       capture_output=True, text=True, timeout=120)
    install_attempts.append(("apt-get install mafft", r.returncode, (r.stderr or r.stdout).strip().splitlines()[-1] if (r.stderr or r.stdout).strip() else ""))
except Exception as e:
    install_attempts.append(("apt-get install mafft", None, str(e)))
log(f"4) apt-get install attempt: {install_attempts[-1]}")
# 3b) pip (needs network/index)
try:
    r = subprocess.run([sys.executable, "-m", "pip", "download", "biopython", "-d", "/tmp/pipprobe"],
                       capture_output=True, text=True, timeout=60)
    tail = (r.stderr or r.stdout).strip().splitlines()[-1] if (r.stderr or r.stdout).strip() else ""
    install_attempts.append(("pip download probe (network/index check)", r.returncode, tail))
except Exception as e:
    install_attempts.append(("pip download probe", None, str(e)))
log(f"5) pip/network probe: {install_attempts[-1]}")
# 3c) raw TCP connectivity (any proxy/mirror?)
net = []
for host, port in [("8.8.8.8", 53), ("1.1.1.1", 53), ("<NFS_SERVER>", 2049), ("<NFS_SERVER>", 80)]:
    s = socket.socket(); s.settimeout(3)
    try:
        s.connect((host, port)); net.append(f"{host}:{port} OPEN")
    except Exception as e:
        net.append(f"{host}:{port} unreachable ({type(e).__name__})")
    s.close()
log(f"6) raw TCP connectivity probes: {net}")
try:
    socket.gethostbyname("mafft.cbrc.jp"); dns = "DNS OK"
except Exception:
    dns = "DNS resolution FAILS"
log(f"7) DNS: {dns}")

mafft = shutil.which("mafft")
if mafft:
    v = subprocess.run([mafft, "--version"], capture_output=True, text=True)
    mafft_version = (v.stderr or v.stdout).strip().splitlines()[0]
    log(f"MAFFT FOUND: {mafft} — {mafft_version}")
else:
    mafft_version = None
    log("CONCLUSION: MAFFT is NOT available and cannot be provisioned "
        "(not in PATH, absent from filesystem, apt blocked by lack of root, "
        "no network/DNS for pip or upstream download, no conda/module system).")

# ------------------------------------------------------------ alignment ----
os.makedirs("alignments", exist_ok=True)
os.makedirs("mafft_logs", exist_ok=True)
aln_files, strategy, run_ok = {}, {}, {}
if mafft:
    for f in INPUTS:
        base = os.path.splitext(os.path.basename(f))[0]
        outp = f"alignments/{base}.aln.faa"
        with open(outp, "w") as fo, open(f"mafft_logs/{base}.log", "w") as fe:
            r = subprocess.run([mafft, "--auto", f], stdout=fo, stderr=fe)
        err = open(f"mafft_logs/{base}.log").read()
        strategy[base] = next((ln.split("via ")[-1].strip(" ().") for ln in err.splitlines() if "via" in ln.lower()), "unknown")
        run_ok[base] = (r.returncode == 0 and os.path.getsize(outp) > 0)
        log(f"mafft --auto {f} -> {outp}: rc={r.returncode} strategy={strategy[base]} ok={run_ok[base]}")
else:
    for f in INPUTS:
        base = os.path.splitext(os.path.basename(f))[0]
        run_ok[base] = False
        log(f"mafft --auto {f} -> NOT ATTEMPTED (mafft executable unavailable)")

# ------------------------------------------------------------------ count ---
results, tot_gaps, tot_all, tot_dot = [], 0, 0, 0
for f in INPUTS:
    base = os.path.splitext(os.path.basename(f))[0]
    aln = f"alignments/{base}.aln.faa"
    if run_ok.get(base):
        seqs = read_fasta(aln)
        lengths = {len(s) for s in seqs.values()}
        joined = "".join(seqs.values())
        g = joined.count("-"); d = joined.count(".")
        n_char = sum(lengths) * len(seqs)  # == sum of len(s) for all rows
        tot_gaps += g; tot_dot += d; tot_all += n_char
        results.append({"file": base, "n_seq": len(seqs), "aln_length": sorted(lengths)[0] if len(lengths)==1 else lengths,
                        "gap_chars('-')": g, "gap_chars('.')": d, "total_chars_incl_gaps": n_char,
                        "pct_gaps_this_aln": round(100*g/n_char, 4)})
    else:
        results.append({"file": base, "n_seq": None, "aln_length": None,
                        "gap_chars('-')": None, "gap_chars('.')": None,
                        "total_chars_incl_gaps": None, "pct_gaps_this_aln": None,
                        "status": "MAFFT unavailable — alignment not produced"})

pct = round(100 * (tot_gaps + tot_dot) / tot_all, 2) if tot_all else None
summary = {
    "timestamp": TS, "mafft_path": mafft, "mafft_version": mafft_version,
    "strategy_selected_per_file": strategy,
    "numerator_total_gap_chars": tot_gaps + tot_dot,
    "of_which_dash": tot_gaps, "of_which_dot": tot_dot,
    "denominator_total_chars_incl_gaps": tot_all,
    "pooled_gap_percentage": pct,
    "mafft_available": bool(mafft),
}
print("\n=== PER-ALIGNMENT TABLE ===")
hdr = f"{'file':<28}{'n_seq':>6}{'aln_len':>9}{'gaps(-)':>9}{'gaps(.)':>8}{'total':>9}{'pct':>8}"
print(hdr)
for r in results:
    if r.get("n_seq") is not None:
        print(f"{r['file']:<28}{r['n_seq']:>6}{str(r['aln_length']):>9}{r["gap_chars('-')"]:>9}{r["gap_chars('.')"]:>8}{r['total_chars_incl_gaps']:>9}{r['pct_gaps_this_aln']:>8}")
    else:
        print(f"{r['file']:<28}  — MAFFT unavailable, no alignment")
print(f"\nPOOLED: gap chars={tot_gaps+tot_dot} / total chars={tot_all} -> {pct if pct is not None else 'N/A (no alignments)'}%")

json.dump({"summary": summary, "per_alignment": results, "inputs": inputs_stats,
           "install_attempts": [list(x) for x in install_attempts], "connectivity": net, "log": LOG},
          open("analysis_results.json", "w"), indent=2)
open("analysis_run.log", "w").write("\n".join(LOG) + "\n")
log("Wrote analysis_results.json and analysis_run.log")
