#!/usr/bin/env python3
"""
Average number of CHIP variants per sample after filtering out intronic,
intergenic, and UTR variants.

Input : data/CHIP_DP10_GQ20_PASS/*.xlsx  (86 sample workbooks, 1 sheet each,
        2-level header: row 1 group banners, row 2 column names, data from row 3)
        data/230214_Schenz_et_al_2022_CHIP_Genes.xlsx (55 CHIP genes)
Key columns: Zygosity (E/idx 4), Sequence Ontology (Combined) (N/idx 13),
        In_CHIP (AD/idx 29)

Rule (approved): a CHIP variant = row with Zygosity in {Heterozygous,
Homozygous Variant} AND SO term NOT in the exclusion set
{intron_variant, 3_prime_UTR_variant, 5_prime_UTR_variant,
 5_prime_UTR_premature_start_codon_gain_variant, upstream_gene_variant}.
Denominator = all 86 samples. Combined SO terms handled defensively by
splitting on commas. Sensitivity analysis: include Zygosity=None rows that
survive the SO filter.
"""
import glob, os, statistics, collections, csv
import openpyxl

EXCLUDE = {
    "intron_variant",
    "3_prime_UTR_variant",
    "5_prime_UTR_variant",
    "5_prime_UTR_premature_start_codon_gain_variant",
    "upstream_gene_variant",   # intergenic/flanking equivalent (U1, approved)
}
COUNT_ZYGOSITY = {"Heterozygous", "Homozygous Variant"}

# ---- CHIP gene list (diagnostic) ----
wb = openpyxl.load_workbook("data/230214_Schenz_et_al_2022_CHIP_Genes.xlsx")
chip_genes = {r[0].strip().upper() for r in wb["Sheet1"].iter_rows(min_row=1, values_only=True) if r[0]}
wb.close()
print(f"CHIP gene list: {len(chip_genes)} genes")

files = sorted(glob.glob("data/CHIP_DP10_GQ20_PASS/*.xlsx"))
print(f"Sample workbooks: {len(files)}")

per_sample = []          # main rule counts
per_sample_sens = []     # sensitivity: + Zygosity=None rows surviving SO filter
gene_counter = collections.Counter()   # gene names of retained variants
total_rows = 0
none_zyg_surviving = 0
none_zyg_surviving_details = []
dropped_by_term = collections.Counter()

for f in files:
    wb = openpyxl.load_workbook(f)
    ws = wb[wb.sheetnames[0]]
    rows = list(ws.iter_rows(min_row=3, values_only=True))  # data rows only (U4)
    wb.close()
    total_rows += len(rows)
    n_main = n_sens = 0
    for r in rows:
        zyg = r[4]
        so_raw = r[13]
        terms = [t.strip() for t in str(so_raw).split(",")] if so_raw else []
        kept_terms = [t for t in terms if t and t not in EXCLUDE]
        if not kept_terms:
            dropped_by_term[tuple(t for t in terms if t in EXCLUDE)] += 0  # bookkeeping no-op
            continue
        if zyg in COUNT_ZYGOSITY:
            n_main += 1
            n_sens += 1
            if r[12]:
                gene_counter[str(r[12]).upper()] += 1
        elif zyg is None:                       # sensitivity only (A1)
            n_sens += 1
            none_zyg_surviving += 1
            none_zyg_surviving_details.append((os.path.basename(f), r[0], r[12], r[13]))
    per_sample.append(n_main)
    per_sample_sens.append(n_sens)

mean = statistics.mean(per_sample)
median = statistics.median(per_sample)
mn, mx = min(per_sample), max(per_sample)
mean_s = statistics.mean(per_sample_sens)
median_s = statistics.median(per_sample_sens)

print(f"Total data rows parsed            : {total_rows}")
print(f"Per-sample counts (main rule)     : min={mn} median={median} mean={mean:.4f} max={mx}")
print(f"Per-sample counts (sensitivity)   : min={min(per_sample_sens)} median={median_s} mean={mean_s:.4f} max={max(per_sample_sens)}")
print(f"Zygosity=None rows surviving SO   : {none_zyg_surviving}")
if none_zyg_surviving_details:
    for d in none_zyg_surviving_details[:10]:
        print("   ", d)

# per-sample table
samples_tbl = [(os.path.basename(f).replace("230209_Exome_GRCh38_CHIP_", "").replace(".xlsx", ""), n, s)
               for f, n, s in zip(files, per_sample, per_sample_sens)]
with open("per_sample_chip_variant_counts.csv", "w", newline="") as fh:
    w = csv.writer(fh)
    w.writerow(["sample", "chip_variants_main", "chip_variants_sensitivity"])
    w.writerows(samples_tbl)

# gene diagnostic
covered = set(gene_counter) & chip_genes
print(f"Genes with retained variants      : {len(gene_counter)} distinct; "
      f"{len(covered)}/{len(chip_genes)} CHIP-list genes represented")
print("Top 10 genes:", gene_counter.most_common(10))

# breakdown of excluded/kept term classes among counted variants
wb = openpyxl.load_workbook(files[0]); wb.close()
print("\nPer-sample counts (main rule):")
print(", ".join(f"{s}:{n}" for s, n, _ in samples_tbl))
