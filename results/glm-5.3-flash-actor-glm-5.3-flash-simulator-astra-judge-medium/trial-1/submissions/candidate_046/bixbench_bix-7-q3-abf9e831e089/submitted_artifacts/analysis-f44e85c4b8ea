#!/usr/bin/env python3
"""
BixBench bix-7-q3: How many CHIP variants remain after removing reference calls?
Inputs: 86 per-sample exome variant reports (GRCh38, DP10/GQ20/PASS), 56-gene CHIP list,
trio status table. Variant = (chrom, pos, REF, ALT) consolidated across samples.
Reference call = Zygosity == "Reference". No-call rows (NaN zygosity, no DP/GQ) excluded
from the primary count (researcher-approved A1); sensitivity reported.
"""
import glob, os, re, json
import pandas as pd

DATA = "data/CHIP_DP10_GQ20_PASS"
OUT = {}

# ---------- 1. CHIP gene list ----------
chip_genes = pd.read_excel("data/230214_Schenz_et_al_2022_CHIP_Genes.xlsx", header=None)[0].astype(str).str.strip()
chip_genes = sorted(set(chip_genes))
OUT["n_chip_genes"] = len(chip_genes)

# ---------- 2. Trio status ----------
trio = pd.read_excel("data/230215_Trio_Status.xlsx")
trio["Sample ID"] = trio["Sample ID"].astype(str).str.strip()

# ---------- 3. Parse all reports ----------
def load_report(path):
    raw = pd.read_excel(path, header=None)
    top, sub = raw.iloc[0], raw.iloc[1]
    cols = []
    for a, b in zip(top, sub):
        a = "" if pd.isna(a) else str(a).strip()
        b = "" if pd.isna(b) else str(b).strip()
        cols.append((f"{b}|{a}" if b else a).strip("|"))  # "Zygosity|Proband (380-P)"
    df = raw.iloc[2:].copy()
    df.columns = cols
    return df

files = sorted(glob.glob(os.path.join(DATA, "*.xlsx")))
rows, per_sample, zyg_values, sheet_names = [], [], {}, set()
for f in files:
    base = os.path.basename(f)
    xl = pd.ExcelFile(f)
    sheet_names.add(xl.sheet_names[0])
    df = load_report(f)
    zcol  = [c for c in df.columns if c.startswith("Zygosity|")][0]
    sample_id = re.search(r"\((.*)\)", zcol.split("|", 1)[1]).group(1)
    pos_col = "Chr:Pos|Variant Info" if "Chr:Pos|Variant Info" in df.columns else df.columns[0]
    ra_col  = [c for c in df.columns if c == "Ref/Alt"][0] if "Ref/Alt" in df.columns else \
              [c for c in df.columns if c.endswith("|Ref/Alt")][0]
    gene_col = [c for c in df.columns if "Gene Names" in c][0]
    dp_col   = [c for c in df.columns if "Read Depths" in c][0]
    gq_col   = [c for c in df.columns if "Genotype Qualities" in c][0]
    vc = df[zcol].value_counts(dropna=False)
    for k, v in vc.items():
        kk = k if isinstance(k, str) else "NaN"
        zyg_values[kk] = zyg_values.get(kk, 0) + int(v)
    z = df[zcol]
    keep = z.isin(["Heterozygous", "Homozygous Variant"])          # non-reference calls
    sub = df[keep].copy()
    sub["sample"] = sample_id
    sub["chrom_pos"] = sub[pos_col].astype(str).str.strip()
    sub["ref_alt"] = sub[ra_col].astype(str).str.strip()
    # variant key: chrom|pos|REF|ALT
    key = (sub["chrom_pos"].str.split(":", regex=True).str[0] + "|"
           + sub["chrom_pos"].str.split(":", regex=True).str[1] + "|"
           + sub["ref_alt"].str.replace("/", "|", regex=False))
    sub["variant_key"] = key
    # CHIP gene tokens from Gene Names (multi-gene entries split on , ; and whitespace)
    def chip_hit(g):
        if pd.isna(g): return False
        toks = re.split(r"[;,/\s]+", str(g))
        return any(t in chip_genes for t in toks if t)
    sub["is_chip"] = sub[gene_col].apply(chip_hit)
    sub["genes"] = sub[gene_col].astype(str)
    rows.append(sub[["sample", "variant_key", "chrom_pos", "ref_alt", "genes", "is_chip", "DP_col" if False else zcol]])
    per_sample.append({
        "file": base, "sample_id": sample_id, "data_rows": len(df),
        "het": int((z == "Heterozygous").sum()),
        "hom_var": int((z == "Homozygous Variant").sum()),
        "reference": int((z == "Reference").sum()),
        "no_call_nan": int(z.isna().sum()),
        "other": int((~z.isin(["Heterozygous", "Homozygous Variant", "Reference"]) & z.notna()).sum()),
        "retained_rows": int(keep.sum()),
        "distinct_retained": sub["variant_key"].nunique(),
        "distinct_retained_chip": sub.loc[sub["is_chip"], "variant_key"].nunique(),
    })

calls = pd.concat(rows, ignore_index=True)
OUT["n_files"] = len(files)
OUT["sheet_names"] = sorted(sheet_names)
OUT["zygosity_values_all_files"] = zyg_values

# ---------- 4. A4: reconcile trio status (87 rows) vs files (86) ----------
file_samples = {p["sample_id"] for p in per_sample}
trio_ids = set(trio["Sample ID"])
OUT["A4"] = {
    "n_trio_rows": len(trio), "n_files": len(files), "n_unique_sample_ids": len(file_samples),
    "trio_ids_without_file": sorted(trio_ids - file_samples),
    "file_ids_without_trio_row": sorted(file_samples - trio_ids),
}

# ---------- 5. Main counts ----------
uniq = calls.drop_duplicates("variant_key")
OUT["main"] = {
    "distinct_variants_after_removing_reference_calls": int(uniq["variant_key"].nunique()),
    "distinct_CHIP_variants": int(uniq.loc[uniq["is_chip"], "variant_key"].nunique()),
    "retained_call_rows_total": len(calls),
    "samples": calls["sample"].nunique(),
}
nonchip = sorted(uniq.loc[~uniq["is_chip"], "genes"].unique())
OUT["non_chip_gene_entries_in_retained"] = nonchip

# removed inventory
removed_ref = sum(p["reference"] for p in per_sample)
removed_nc  = sum(p["no_call_nan"] for p in per_sample)
removed_other = sum(p["other"] for p in per_sample)
total_rows = sum(p["data_rows"] for p in per_sample)
OUT["removal_inventory"] = {
    "total_data_rows_all_files": total_rows,
    "reference_calls_removed": removed_ref,
    "no_call_rows_removed": removed_nc,
    "other_zygosity_rows_removed": removed_other,
    "variant_calls_retained_rows": len(calls),
}

# variants seen ONLY as reference somewhere? (informational)
allkeys = set()
for f in files:
    df = load_report(f)
    zcol  = [c for c in df.columns if c.startswith("Zygosity|")][0]
    pos_col = "Chr:Pos|Variant Info" if "Chr:Pos|Variant Info" in df.columns else df.columns[0]
    ra_col  = [c for c in df.columns if c.endswith("Ref/Alt")][0]
    k = (df[pos_col].astype(str).str.split(":").str[0] + "|" + df[pos_col].astype(str).str.split(":").str[1]
         + "|" + df[ra_col].astype(str).str.replace("/", "|", regex=False))
    allkeys |= set(k.dropna())
OUT["distinct_keys_any_zygosity"] = len(allkeys)

# ---------- 6. Breakdowns ----------

# ---------- 7. A4 refined: normalize "-P/-PF/-PM/-P1/-P2" suffixes ----------
def base_id(s):
    return re.sub(r"-(P1|P2|PF|PM|P)$", "", s)
norm_file_ids = {base_id(s) for s in file_samples}
trio_ids = set(trio["Sample ID"].astype(str))
OUT["A4"]["unique_trio_ids"] = len(trio_ids)
OUT["A4"]["family_files_norm_match"] = len(norm_file_ids & trio_ids)
OUT["A4"]["norm_unmatched_trio"] = sorted(trio_ids - norm_file_ids)
OUT["A4"]["norm_unmatched_files"] = sorted(norm_file_ids - trio_ids)
OUT["A4"]["n_srr_files"] = sum(1 for s in file_samples if s.startswith("SRR"))

# ---------- 8. Sensitivity / robustness ----------
# (a) variants present in reports but never called as non-reference anywhere
never_called = allkeys - set(uniq["variant_key"])
OUT["sensitivity"] = {
    "distinct_keys_in_all_reports": len(allkeys),
    "keys_only_reference_or_no_call_anywhere": len(never_called),
    "if_no_call_rows_were_counted_as_variants": len(allkeys),
    "note": "No-call rows carry no genotype call (no DP/GQ); under A1 they are excluded. "
            "Treating them as reference-equivalent removes the same rows, so the retained "
            "set is identical (673); the only divergent scenario is counting all reported loci.",
}
print("\nnever-called keys (all reports):", len(never_called))

per = pd.DataFrame(per_sample)
per.to_csv("per_sample_breakdown.csv", index=False)
OUT["per_sample_summary"] = {
    "min_retained": int(per["distinct_retained"].min()),
    "max_retained": int(per["distinct_retained"].max()),
    "mean_retained": round(float(per["distinct_retained"].mean()), 1),
    "files_with_no_call_rows": int((per["no_call_nan"] > 0).sum()),
    "files_with_other_zygosity": int((per["other"] > 0).sum()),
}
print(json.dumps(OUT, indent=2, default=str))
per.sort_values("distinct_retained", ascending=False).to_csv("per_sample_breakdown.csv", index=False)
print("\nTOP/BOTTOM per-sample retained distinct variants:")
print(per.sort_values("distinct_retained", ascending=False)[["sample_id","data_rows","reference","no_call_nan","retained_rows","distinct_retained","distinct_retained_chip"]].head(8).to_string(index=False))
print(per.sort_values("distinct_retained")[["sample_id","data_rows","reference","no_call_nan","retained_rows","distinct_retained","distinct_retained_chip"]].head(5).to_string(index=False))
