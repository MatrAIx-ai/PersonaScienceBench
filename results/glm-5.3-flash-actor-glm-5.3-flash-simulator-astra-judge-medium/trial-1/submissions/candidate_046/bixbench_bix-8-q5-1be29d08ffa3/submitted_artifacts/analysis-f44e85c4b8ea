"""
Independence test: m6A methylation status vs differential expression status
Bladder cancer dataset (data/MeRIP_RNA_result.xlsx, sheet 'Date Formatting').
Unit of analysis (primary): transcript rows, as precomputed status columns.
Sensitivity: gene-level aggregation; Fisher exact; 3x3 table.
"""
import numpy as np
import pandas as pd
from scipy.stats import chi2_contingency, fisher_exact

df = pd.read_excel('data/MeRIP_RNA_result.xlsx', sheet_name='Date Formatting')
assert df[['m6A', 'DEG']].isna().sum().sum() == 0
assert (df['m6A_DEG'] == df['m6A'] + ' and ' + df['DEG']).all()

# ---- 2x2 table (row level) ----
m6a_sig = df['m6A'].isin(['m6A Hyper', 'm6A Hypo'])
deg = df['DEG'].isin(['Up', 'Down'])
tab22 = pd.crosstab(m6a_sig.rename('m6A sig'), deg.rename('DEG'))
tab22 = tab22.reindex(index=[False, True], columns=[False, True])  # rows: no-sig, sig; cols: no-DEG, DEG
print("=== 2x2 observed (rows: m6A no-sig / m6A sig; cols: no-DEG / DEG) ===")
print(tab22.to_string())

chi2, p_chi, dof, expected = chi2_contingency(tab22, correction=False)
print(f"\nPearson chi2 = {chi2:.6f}, dof = {dof}")
print(f"p-value (chi2, no correction) = {p_chi:.6e}")
_, p_corr, _, _ = chi2_contingency(tab22, correction=True)
print(f"p-value (chi2, Yates correction) = {p_corr:.6e}")
odds, p_fish = fisher_exact(tab22)
print(f"Fisher exact: odds ratio = {odds:.6f}, p-value = {p_fish:.6e}")
print("\nExpected counts:")
print(pd.DataFrame(expected, index=tab22.index, columns=tab22.columns).round(2).to_string())

# ---- 3x3 table (optional secondary) ----
tab33 = pd.crosstab(df['m6A'], df['DEG'])
tab33 = tab33.reindex(index=['m6A Hyper', 'm6A Hypo', 'm6A no sig'],
                      columns=['Up', 'Down', 'no-DEGs'])
chi2_3, p_3, dof_3, exp_3 = chi2_contingency(tab33, correction=False)
print("\n=== 3x3 observed (Hyper/Hypo/no-sig x Up/Down/no-DEGs) ===")
print(tab33.to_string())
print(f"chi2 = {chi2_3:.4f}, dof = {dof_3}, p = {p_3:.6e}")
print("Expected (min):", round(exp_3.min(), 2))

# ---- Gene-level sensitivity ----
g = df.groupby('gene_id').agg(m6a_any=('m6A', lambda s: s.isin(['m6A Hyper', 'm6A Hypo']).any()),
                              deg_any=('DEG', lambda s: s.isin(['Up', 'Down']).any()))
tabg = pd.crosstab(g['m6a_any'], g['deg_any']).reindex(index=[False, True], columns=[False, True])
chi2_g, p_g, dof_g, exp_g = chi2_contingency(tabg, correction=False)
og, p_fg = fisher_exact(tabg)
print("\n=== Gene-level 2x2 (n genes = %d) ===" % len(g))
print(tabg.to_string())
print(f"chi2 = {chi2_g:.4f}, dof = {dof_g}, p = {p_g:.6e}; Fisher p = {p_fg:.6e}")

print("\n=== SUMMARY ===")
print(f"PRIMARY (row-level 2x2, Pearson chi2, no correction): chi2={chi2:.4f}, dof={dof}, p={p_chi:.4e}")
