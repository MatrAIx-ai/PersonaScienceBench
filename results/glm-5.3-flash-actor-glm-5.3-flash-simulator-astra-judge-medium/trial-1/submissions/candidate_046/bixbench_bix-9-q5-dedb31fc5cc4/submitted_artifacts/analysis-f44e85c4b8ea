#!/usr/bin/env python3
"""
BixBench bix-9-q5 — RNA-seq Paroxetine 2017 (Mueller et al.).
Question: In which tissue type do bad responders show the highest number of
significantly differentially expressed (lfc>0.5 and basemean>10) genes
compared to controls?

Approach (approved plan):
- Use the PRECOMPUTED DESeq comparison blocks in sheet "NormCount"
  (no DESeq2 re-run). Comparison blocks identified by fitting their
  log2FoldChange to group-mean ratios computed from the normalized counts:
      Comp2 = Control vs bad_responder, baseline_blood
      Comp5 = Control vs bad_responder, dentate_gyrus
      Comp8 = Control vs bad_responder, final_blood
- Primary criterion: |log2FoldChange| > 0.5 AND baseMean > 10.
- Sensitivity: add padj < 0.05 / padj < 0.1; one-sided lfc > 0.5.
- Robustness: recompute group means from the 10 samples/group in the
  NormCount count block, recompute log2FC and baseMean, recount.
- Sanitize stray trailing GeneID rows ('a', 'l7Rn6').
"""
import re
import numpy as np
import pandas as pd

XLSX = "data/Data_deposition_RNAseq_Paroxetine_2017.xlsx"

# ---------------------------------------------------------------- load ----
ms = pd.read_excel(XLSX, sheet_name="Mapping_statistics")
nc = pd.read_excel(XLSX, sheet_name="NormCount", header=None)

print("=" * 70)
print("MAPPING_STATISTICS (metadata)")
print("=" * 70)
meta = ms[["Sample ID", "Response", "Tissue", "Code"]].copy()
print("samples:", len(meta))
print(pd.crosstab(meta["Tissue"], meta["Response"]))
print("Response values:", sorted(meta["Response"].unique()))
print("Code example:", meta["Code"].iloc[0], "...", meta["Code"].iloc[-1],
      "| unique:", meta["Code"].nunique())

# ------------------------------------------------------------- NormCount --
# rows 0-2 multi-row header, row 3 column names, data from row 4
data = nc.iloc[4:].reset_index(drop=True)
gene_col = data.iloc[:, 1].astype(str)

bad_ids = gene_col.isin(["a", "l7Rn6"])
print("\nstray GeneID rows sanitized:", bad_ids.sum(), "->", gene_col[bad_ids].tolist())
data = data[~bad_ids].reset_index(drop=True)
gene_col = data.iloc[:, 1].astype(str)
print("gene rows used:", len(data))

names = list(nc.iloc[3, 2:92])          # 90 sample column headers
counts = data.iloc[:, 2:92].apply(pd.to_numeric, errors="coerce")
assert counts.isna().sum().sum() == 0
assert (counts.values >= 0).all()
frac = ((counts.values % 1) != 0).mean()
print(f"count matrix: {counts.shape[1]} samples x {counts.shape[0]} genes; "
      f"non-integer fraction {frac:.2%} -> DESeq size-factor NORMALIZED counts "
      "(not raw, not log)")

# group mapping: strip trailing sample number ('...1'..'...10')
groups = {}
for i, n in enumerate(names):
    m = re.search(r"\d+$", n)
    assert m, n
    g = n[: m.start()]
    groups.setdefault(g, []).append(i)
assert all(len(v) == 10 for v in groups.values()), {g: len(v) for g, v in groups.items()}
print("groups (10 samples each):", len(groups))

group_mean = {g: counts.iloc[:, idx].mean(axis=1) for g, idx in groups.items()}

# --------------------------------------- identify the 9 DESeq comparisons --
tissues = ["baseline_blood", "dentate_gyrus", "final_blood"]
contrast_defs = [("Control", "good_responder"), ("Control", "bad_responder"),
                 ("bad_responder", "good_responder")]
order = [(t, a, b) for t in tissues for a, b in contrast_defs]

print("\n" + "=" * 70)
print("IDENTIFY PRECOMPUTED COMPARISONS (fit log2FoldChange to group means)")
print("=" * 70)
block_assign = []
for k in range(9):
    c0 = 98 + 9 * k
    file_lfc = pd.to_numeric(data.iloc[:, c0 + 4], errors="coerce").replace(
        [np.inf, -np.inf], np.nan)
    best = None
    for (t, a, b) in order:
        lfc = np.log2(group_mean[f"{b}_{t}"] / group_mean[f"{a}_{t}"]).replace(
            [np.inf, -np.inf], np.nan)
        err = (lfc - file_lfc).abs().mean()
        if best is None or err < best[0]:
            best = (err, t, a, b)
    block_assign.append(best)
    print(f"Comparison{k+1}: A={best[2]:14s} B={best[3]:14s} tissue={best[1]:14s} "
          f"(mean|dLFC|={best[0]:.3f})")

bad_idx = {t: k for k, (t, a, b) in enumerate(order) if a == "Control" and b == "bad_responder"}
print("\nbad_responder vs Control comparisons:",
      {t: f"Comp{k+1}" for t, k in bad_idx.items()})

# ------------------------------------------------------------- counting --
def count_block(c0, lfc_thr=0.5, bm_thr=10, padj_thr=None, one_sided=False):
    lfc = pd.to_numeric(data.iloc[:, c0 + 4], errors="coerce")
    bm = pd.to_numeric(data.iloc[:, c0], errors="coerce")
    padj = pd.to_numeric(data.iloc[:, c0 + 6], errors="coerce")
    m = bm > bm_thr
    m &= (lfc > lfc_thr) if one_sided else (lfc.abs() > lfc_thr)
    if padj_thr is not None:
        m &= padj < padj_thr
    return int(m.fillna(False).sum())

print("\n" + "=" * 70)
print("PRIMARY RESULT — bad_responder vs Control per tissue (precomputed DESeq)")
print("criterion: |log2FoldChange| > 0.5 AND baseMean > 10")
print("=" * 70)
rows = []
for t, k in sorted(bad_idx.items(), key=lambda kv: kv[1]):
    c0 = 98 + 9 * k
    n_prim = count_block(c0)
    n_005 = count_block(c0, padj_thr=0.05)
    n_01 = count_block(c0, padj_thr=0.1)
    n_up = count_block(c0, one_sided=True)
    dMax = int((data.iloc[:, c0 + 7] != "-").sum())
    dMed = int((data.iloc[:, c0 + 8] != "-").sum())
    rows.append({"tissue": t, "comparison": f"Comp{k+1}", "primary": n_prim,
                 "plus_padj_0.05": n_005, "plus_padj_0.1": n_01,
                 "one_sided_up": n_up, "file_DEG_Max": dMax, "file_DEG_Median": dMed})
res = pd.DataFrame(rows)
print(res.to_string(index=False))

winner = res.loc[res["primary"].idxmax(), "tissue"]
print(f"\n>>> TISSUE WITH MOST DEGs (primary criterion): {winner}")

# ------------------------------------------------------- robustness check --
print("\n" + "=" * 70)
print("ROBUSTNESS — recompute LFC & baseMean from NormCount group means")
print("=" * 70)
rows2 = []
for t, k in sorted(bad_idx.items(), key=lambda kv: kv[1]):
    ga, gb = f"Control_{t}", f"bad_responder_{t}"
    lfc2 = np.log2(group_mean[gb] / group_mean[ga]).replace([np.inf, -np.inf], np.nan)
    bm2 = counts.iloc[:, groups[ga] + groups[gb]].mean(axis=1)  # mean of 20 samples
    padj = pd.to_numeric(data.iloc[:, 98 + 9 * k + 6], errors="coerce")
    n_prim = int(((lfc2.abs() > 0.5) & (bm2 > 10)).fillna(False).sum())
    n_005 = int(((lfc2.abs() > 0.5) & (bm2 > 10) & (padj < 0.05)).fillna(False).sum())
    n_01 = int(((lfc2.abs() > 0.5) & (bm2 > 10) & (padj < 0.1)).fillna(False).sum())
    # agreement with file lfc on direction/threshold set
    file_lfc = pd.to_numeric(data.iloc[:, 98 + 9 * k + 4], errors="coerce").replace(
        [np.inf, -np.inf], np.nan)
    agree = int(((lfc2.abs() > 0.5) == (file_lfc.abs() > 0.5)).sum())
    rows2.append({"tissue": t, "recomputed_primary": n_prim,
                  "recomputed_plus_padj_0.05": n_005,
                  "recomputed_plus_padj_0.1": n_01,
                  "genes_with_matching_lfc_threshold_call": f"{agree}/{len(lfc2)}"})
res2 = pd.DataFrame(rows2)
print(res2.to_string(index=False))
w2 = res2.loc[res2["recomputed_primary"].idxmax(), "tissue"]
print(f"\n>>> ranking unchanged: {w2 == winner} (recomputed winner: {w2})")

# ---------------------------------------------------------------- export --
res.to_csv("outputs/deg_counts_bad_vs_control.csv", index=False)
res2.to_csv("outputs/deg_counts_recomputed.csv", index=False)
print("\nSaved: outputs/deg_counts_bad_vs_control.csv, outputs/deg_counts_recomputed.csv")
