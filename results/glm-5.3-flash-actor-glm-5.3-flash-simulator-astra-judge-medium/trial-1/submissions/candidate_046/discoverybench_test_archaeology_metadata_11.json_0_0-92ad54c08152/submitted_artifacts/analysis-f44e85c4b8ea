"""
DiscoveryBench: archaeology/metadata_11
Question: In which century did Diversity in Pottery Form collapse while
Diversity in Pottery Decoration increased simultaneously?

Plan (approved):
 P1: century grid aligned to capital.csv (BCE 4300..500, 100-yr bins)
 P2: slopes dZ per century from RAW century values (primary); _inter/smoothed = confirmation
 P3: thresholds fixed from EMPIRICAL SLOPE DISTRIBUTION, declared before result
 P4: numeric cross-check capital.csv <-> time_series_data.csv raw values
 P5: primary simultaneity = same 100-yr bin; sensitivity window +/-100 yr
"""
import pandas as pd, numpy as np

# ---------- P4: load & cross-check ----------
ts = pd.read_csv('data/time_series_data.csv')
cap = pd.read_csv('data/capital.csv', decimal=',')

# map capital BCE -> ts CE = -BCE
cap2 = cap.rename(columns={'ZKeform':'form','Zkeverz':'deco'})[['BCE','form','deco']].assign(CE=lambda x: -x.BCE)[['CE','form','deco']]
tsraw = ts[['CE','PotteryForm','PotteryDecoration']].rename(
    columns={'PotteryForm':'form','PotteryDecoration':'deco'})
tsraw = tsraw.dropna(subset=['form','deco'])
m = cap2.merge(tsraw, on='CE', suffixes=('_cap','_ts'))
print('P4 cross-check: overlapping bins =', len(m))
print('max |diff| form =', float((m.form_cap-m.form_ts).abs().max()),
      '| deco =', float((m.deco_cap-m.deco_ts).abs().max()))
assert (m.form_cap-m.form_ts).abs().max() < 1e-9 and (m.deco_cap-m.deco_ts).abs().max() < 1e-9
print('P4 PASS: raw series are numerically identical on all overlapping bins.\n')

# ---------- P1: century grid (primary = capital.csv, covers 4300..500 BCE) ----------
df = cap[['BCE','ZKeform','Zkeverz']].rename(columns={'ZKeform':'form','Zkeverz':'deco'})
df = df.sort_values('BCE', ascending=False).reset_index(drop=True)  # oldest -> newest

# ---------- P2: slopes dZ = Z(newer bin) - Z(older bin); negative slope = decline over time
df['d_form'] = df.form.diff()          # newer - older
df['d_deco'] = df.deco.diff()
d = df.dropna(subset=['d_form','d_deco']).copy()

# ---------- P3: EMPIRICAL thresholds from slope distribution (declared BEFORE result) ----------
print('Empirical slope distribution (n=%d centuries):' % len(d))
print(d[['d_form','d_deco']].describe().round(3).to_string())
q5_f  = d.d_form.quantile(0.05);  q95_d = d.d_deco.quantile(0.95)
print('\nFixed thresholds (declared before result):')
print(f'  COLAPSE form : d_form <= {q5_f:+.3f}  (5th percentile of all form slopes)')
print(f'  AUMENTO deco : d_deco >= {q95_d:+.3f}  (95th percentile of all deco slopes)')
print('  Rule: a slope in the most extreme 5% tail = an epochal transition.')

d['collapse'] = d.d_form <= q5_f
d['increase'] = d.d_deco >= q95_d
d['both'] = d.collapse & d.increase

# ---------- P5: primary (same bin) + sensitivity +/-100 yr ----------
def to_century(bce):
    # a bin labelled 1700 BCE spans 1700-1601 BCE = '17th century BCE' (siglo XVII a.C.)
    rom = ['I','II','III','IV','V','VI','VII','VIII','IX','X','XI','XII','XIII','XIV',
           'XV','XVI','XVII','XVIII','XIX','XX','XXI','XXII','XXIII','XXIV','XXV','XXVI',
           'XXVII','XXVIII','XXIX','XXX','XXXI','XXXII','XXXIII','XXXIV','XXXV','XXXVI',
           'XXXVII','XXXVIII','XXXIX','XL','XLI','XLII','XLIII','XLIV']
    n = (bce-1)//100 + 1  # 1700 BCE spans 1700-1601 BCE = 17th century BCE
    return f"{bce} BCE / siglo {rom[n-1]} a.C."

hits = d[d.both]
print('\nPRIMARY RESULT (same 100-yr bin):')
if len(hits)==0:
    print('  no bin satisfies both conditions -> relaxation needed')
else:
    for _,r in hits.iterrows():
        print(f"  bin {r.BCE} BCE ({to_century(r.BCE)}): "
              f"d_form={r.d_form:+.2f}, d_deco={r.d_deco:+.2f}  "
              f"[Zform {df.loc[df.BCE==r.BCE+100,'form'].item():+.2f} -> {r.form:+.2f}; "
              f"Zdeco {df.loc[df.BCE==r.BCE+100,'deco'].item():+.2f} -> {r.deco:+.2f}]")

print('\nSENSITIVITY (+/-100 yr window): collapse bins near an increase bin or vice versa:')
for _,r in d[d.collapse].iterrows():
    near = d[(d.increase) & (d.BCE.between(r.BCE-100, r.BCE+100))]
    for _,r2 in near.iterrows():
        print(f"  collapse@{r.BCE}BCE (d_form={r.d_form:+.2f}) ~ increase@{r2.BCE}BCE (d_deco={r2.d_deco:+.2f})")

# ---------- confirmation: annual _inter series, 100-yr rolling mean ----------
ts_i = ts[['CE','PotteryForm_inter','PotteryDecoration_inter']].copy()
ts_i['form_s'] = ts_i.PotteryForm_inter.rolling(100, min_periods=50).mean()
ts_i['deco_s'] = ts_i.PotteryDecoration_inter.rolling(100, min_periods=50).mean()
cen = ts_i[ts_i.CE % 100 == 0].copy()        # sample at century marks
cen['BCE'] = -cen.CE
cen['d_form_s'] = cen.form_s.diff(); cen['d_deco_s'] = cen.deco_s.diff()
chk = cen[cen.BCE.isin(d.BCE)][['BCE','d_form_s','d_deco_s']].merge(
      d[['BCE','d_form','d_deco','both']], on='BCE')
print('\nCONFIRMATION (100-yr rolling mean of annual _inter, century marks):')
print('  spearman corr of slopes: form %.3f, deco %.3f' % (
    chk.d_form_s.corr(chk.d_form, method='spearman'),
    chk.d_deco_s.corr(chk.d_deco, method='spearman')))
conf = chk[chk.both]
for _,r in conf.iterrows():
    print(f"  bin {r.BCE} BCE: smoothed d_form={r.d_form_s:+.3f} (collapse={r.d_form_s<=q5_f}), "
          f"d_deco={r.d_deco_s:+.3f} (increase={r.d_deco_s>=q95_d})")

# ---------- evidence table ----------
ev = d[['BCE','form','deco','d_form','d_deco','collapse','increase','both']].copy()
ev['century'] = ev.BCE.map(to_century)
ev.to_csv('slope_evidence_table.csv', index=False)
print('\nEvidence table written: slope_evidence_table.csv')
print(ev.round(2).to_string(index=False))
