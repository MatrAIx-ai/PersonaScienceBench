"""
Growth-phase analysis for 2000-1100 BCE (DiscoveryBench episode: archaeology/metadata_13).
Primary growth proxy: g_all_mean (mean KDE growth rate, time_series_data.csv).
Corroborating proxy: pollen_grate_100 (change rate of interpolated pollen openness).
Openness levels (pollen_inter_100, SMOOTH_MEAN_100y) used only as context.
Century convention (as agreed): the "Nth century BCE" = CE in [-N, -(N-100)+1],
e.g. the 15th century BCE = 1500-1401 BCE = CE -1500 ... -1401.
  label(CE) = 100 * ceil(-CE / 100)   (== -100*floor(CE/100) for CE<0)
"""
import pandas as pd, numpy as np

DATA = "/workspace/data/"
ts = pd.read_csv(DATA + "time_series_data.csv")
pol = pd.read_csv(DATA + "pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv", decimal=",")

W0, W1 = -2000, -1100
w = ts[(ts.CE >= W0) & (ts.CE <= W1)].copy()
assert len(w) == 901

def label(ce, offset=0):
    """BCE-century label with optional symmetric bin-edge offset (in years)."""
    return (np.ceil((-ce - offset) / 100) * 100).astype(int)

# Edge handling: the window endpoint CE -1100 is a single row; merge it into the
# nearest full bin (1200 BCE = CE -1200..-1101) rather than a 1-year bin.
w["bce_century"] = label(w.CE)
n_before = (w.bce_century == 1100).sum()
w.loc[w.CE == W1, "bce_century"] = 1200
print(f"Edge handling: {n_before} row(s) at CE -1100 merged into the 1200-BCE bin.")

def summarize(df, offset=0):
    d = df.copy()
    d["bin"] = label(d.CE, offset)
    d.loc[d.CE == W1, "bin"] = label(W1 - offset)  # keep single-row endpoint merged consistently
    d.loc[d.CE == W1, "bin"] = 1200
    g = d.groupby("bin").agg(
        g_mean=("g_all_mean", "mean"), g_med=("g_all_mean", "median"), g_max=("g_all_mean", "max"),
        p_mean=("pollen_grate_100", "mean"), p_med=("pollen_grate_100", "median"), p_max=("pollen_grate_100", "max"),
        n=("CE", "count"))
    g["rank_g_mean"] = g.g_mean.rank(ascending=False, method="min").astype(int)
    g["rank_g_med"]  = g.g_med.rank(ascending=False, method="min").astype(int)
    g["rank_p_mean"] = g.p_mean.rank(ascending=False, method="min").astype(int)
    return g

main = summarize(w)
print("\n=== Century table (BCE label N = CE -N..-(N-100)+1) ===")
print(main.round(5).to_string())
main.round(6).to_csv("/workspace/analysis/century_table.csv")

print("\nTop 10 g_all_mean years (CE):", [int(x) for x in w.nlargest(10, "g_all_mean").CE])
print("Top 10 pollen_grate_100 years (CE):", [int(x) for x in w.nlargest(10, "pollen_grate_100").CE])

print("\n=== Robustness: bin-edge offset sensitivity and median vs mean ===")
for off in (0, -50, 50):
    t = summarize(w, off)
    top3 = t.sort_values("g_mean", ascending=False).head(3)
    top3m = t.sort_values("g_med", ascending=False).head(3)
    print(f"offset {off:+3d} y -> top-3 bins by g_mean: {list(top3.index)} {[round(v,5) for v in top3.g_mean]}"
          f" | by g_median: {list(top3m.index)}")
t = summarize(w)
print("Spearman rank corr (mean vs median, g_all_mean):",
      round(t.rank_g_mean.corr(t.rank_g_med, method="spearman"), 3))
print("Spearman rank corr (g_all_mean vs pollen_grate_100 century means):",
      round(t.g_mean.corr(t.p_mean, method="spearman"), 3))

print("\nNegative-growth bins (g_mean < 0):", {int(k): round(v, 5) for k, v in t[t.g_mean < 0].g_mean.items()})

# openness context (levels only)
pw = pol[(pol.CE >= W0) & (pol.CE <= W1)].copy()
pw["bin"] = label(pw.CE); pw.loc[pw.CE == W1, "bin"] = 1200
print("\nSMOOTH_MEAN_100y (openness level) century means:")
print(pw.groupby("bin").SMOOTH_MEAN_100y.mean().round(2).to_string())

# Z-indicator characterisation (context only)
zcols = [c for c in ts.columns if c.endswith("_inter")]
zc = w.groupby("bce_century")[zcols].mean()
sel = [c for c in zc.columns] 
print("\n=== Z-indicator century means (context) ===")
print(zc.round(2).to_string())
print("\nPeak bin (1500) delta vs window mean:")
print((zc.loc[1500] - zc.mean()).round(2).sort_values(ascending=False).to_string())
