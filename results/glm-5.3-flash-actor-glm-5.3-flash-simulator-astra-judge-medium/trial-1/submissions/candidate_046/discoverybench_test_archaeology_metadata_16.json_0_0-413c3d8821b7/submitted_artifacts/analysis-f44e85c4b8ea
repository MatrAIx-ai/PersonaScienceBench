"""
PCA on forms of capital (capital.csv) at 100-year bins; PC1 per bin;
characterization of Middle Neolithic (3400-3000 BCE, group MN) and
Younger Neolithic (2900-2300 BCE, group SG).
Approach (approved): correlation-matrix PCA (re-standardized Z columns),
fitted on the full 4300-500 BCE series, PC1 extracted per bin,
sign fixed so PC1 correlates positively with the mean of the 12 Z columns.
PCA implemented via numpy SVD (sklearn not available).
"""
import numpy as np, pandas as pd

cap = pd.read_csv('data/capital.csv', decimal=',')
ZCOLS = [c for c in cap.columns if c.startswith('Z')]
X = cap[ZCOLS].to_numpy(dtype=float)

# --- correlation-matrix PCA via SVD ---
Xs = (X - X.mean(axis=0)) / X.std(axis=0, ddof=1)          # re-standardize
U, S, Vt = np.linalg.svd(Xs, full_matrices=False)
expl = (S**2) / (S**2).sum()
pc = Xs @ Vt.T                                             # scores per bin
loadings = Vt.T                                            # loadings per variable

# --- sign convention: PC1 positively correlated with mean of the 12 Z ---
mean_z = X.mean(axis=1)
if np.corrcoef(pc[:, 0], mean_z)[0, 1] < 0:
    pc[:, 0] *= -1; loadings[:, 0] *= -1
    print("PC1 sign flipped to satisfy convention (positive corr with mean Z).")
else:
    print("PC1 sign already satisfies convention (positive corr with mean Z).")
r_sign = np.corrcoef(pc[:, 0], mean_z)[0, 1]
print(f"corr(PC1, mean of 12 Z) = {r_sign:.3f}")

print("\nExplained variance ratio (PC1-PC4):",
      np.round(expl[:4], 4), f" PC1 = {expl[0]*100:.1f}%")

load_df = pd.DataFrame({'loading_PC1': loadings[:, 0],
                        'corr_PC1': [np.corrcoef(pc[:,0], Xs[:,j])[0,1] for j in range(len(ZCOLS))]},
                       index=ZCOLS).sort_values('loading_PC1')
print("\nPC1 loadings / correlations (sorted):")
print(load_df.round(3).to_string())

# --- PC1 per bin ---
res = pd.DataFrame({'BCE': cap.BCE, 'group': cap.group, 'PC1': pc[:, 0]})
res['CE'] = -res.BCE
print("\nPC1 by 100-year bin (full series):")
print(res.round(3).to_string(index=False))

# --- phase characterization ---
mn = res[res.group == 'MN']           # 3400..3000 BCE (bins inclusive)
sg = res[res.group == 'SG']           # 2900..2300 BCE (bins inclusive)
def char(d, name):
    slope = np.polyfit(d.BCE, d.PC1, 1)[0]   # slope per year BCE (backward axis)
    slope_fwd = -slope                        # slope per century going forward in time
    print(f"\n{name}: bins={list(d.BCE)}")
    print(f"  PC1 mean={d.PC1.mean():.3f}  min={d.PC1.min():.3f}  max={d.PC1.max():.3f}  range={d.PC1.max()-d.PC1.min():.3f}")
    print(f"  trend (forward in time): {slope_fwd*100:+.3f} PC1 units per century  "
          f"(first={d.PC1.iloc[0]:.3f} at {d.BCE.iloc[0]} BCE, last={d.PC1.iloc[-1]:.3f} at {d.BCE.iloc[-1]} BCE)")
    return d
mn = char(mn, "Middle Neolithic MN 3400-3000 BCE")
sg = char(sg, "Younger Neolithic SG 2900-2300 BCE")
print(f"\nPhase contrast: mean(SG) - mean(MN) = {sg.PC1.mean()-mn.PC1.mean():.3f}")
# bin-by-bin MN vs SG
print("\nPer-bin PC1 MN:", np.round(mn.PC1.values, 3))
print("Per-bin PC1 SG:", np.round(sg.PC1.values, 3))

# --- secondary context: pollen openness over the same windows ---
pol = pd.read_csv('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv', decimal=',')
pol['BCE'] = -pol.CE
p = pol.set_index('BCE').sort_index()
for name, lo, hi in [('MN 3400-3000', 3400, 3000), ('SG 2900-2300', 2900, 2300)]:
    s = p['MEAN'][(p.index >= hi) & (p.index <= lo)]
    print(f"\nPollen openness MEAN {name}: mean={s.mean():.2f} start={s.iloc[0]:.2f} end={s.iloc[-1]:.2f} "
          f"(change {s.iloc[-1]-s.iloc[0]:+.2f})")
# correlation of bin-level PC1 with pollen MEAN at same bins (full series, common bins)
common = res.set_index('BCE').join(p['MEAN'], how='inner').dropna()
print(f"\ncorr(bin PC1, pollen MEAN), n={len(common)} bins 4300-500 BCE: "
      f"{np.corrcoef(common.PC1, common.MEAN)[0,1]:.3f}")

# --- save outputs ---
res.round(4).to_csv('analysis/pc1_by_bin.csv', index=False)
load_df.round(4).to_csv('analysis/pc1_loadings.csv')
print("\nSaved: analysis/pc1_by_bin.csv, analysis/pc1_loadings.csv")
