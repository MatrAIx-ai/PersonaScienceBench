# PCA on forms of capital (capital.csv), 100-year time slices
# Question: PC1 at 1100 BCE vs subsequent horizons 1000-500 BCE (Younger Bronze Age)
# NumPy-only implementation (sklearn unavailable in this environment).
import numpy as np, pandas as pd

df = pd.read_csv('data/capital.csv', sep=',', decimal=',', encoding='utf-8-sig')
Z_COLS = ['ZAxtSchwert','ZDolch','Zhausgr','ZCU_AU','Zamber','ZMonument',
          'ZHort','ZSichel','ZBeil','ZMW','ZKeform','Zkeverz']
assert df[Z_COLS].isna().sum().sum() == 0
X_raw = df[Z_COLS].values.astype(float)
n = X_raw.shape[0]

def orient(pc1, target):
    return -pc1 if np.corrcoef(pc1, target)[0,1] < 0 else pc1

# --- Main analysis: standardized PCA (correlation PCA), fit ONCE on all 39 rows
Xs = (X_raw - X_raw.mean(0)) / X_raw.std(0, ddof=0)
U, S, Vt = np.linalg.svd(Xs, full_matrices=False)
S_scaled = S / np.sqrt(n - 1)          # singular values as sqrt(eigenvalues)
evr = (S**2) / (S**2).sum()
pc1_unit = Xs @ Vt[0]                  # projection on unit eigenvector
pc1 = orient(pc1_unit, df['ZHort'].values)
flipped = not np.allclose(pc1, pc1_unit)
df['PC1'] = pc1

yba = df[df['group']=='YBA'].sort_values('BCE')
print('Explained variance ratio (PC1, PC2):', np.round(evr[:2],4))
print('Sign flipped so PC1-ZHort correlation positive:', flipped)
print()
print('PC1 by time slice (YBA):')
print(yba[['BCE','PC1']].round(4).to_string(index=False))
v1100 = float(yba.loc[yba['BCE']==1100,'PC1'].iloc[0])
rest = yba[yba['BCE']<=1000]['PC1'].values
mean_rest = rest.mean()
print()
print('PC1 1000-500 BCE: ' + ', '.join(f'{b}:{v:.4f}' for b,v in zip(yba[yba['BCE']<=1000]['BCE'], rest)))
print(f'PC1(1100 BCE) = {v1100:.4f}')
print(f'Mean PC1 1000-500 BCE = {mean_rest:.4f}')
print(f'Difference 1100 - mean(1000-500) = {v1100 - mean_rest:.4f}')
print()
srt = df.sort_values('BCE', ascending=False)
print('PC1 across all 39 slices (BCE:PC1):')
print('  ' + ' '.join(f'{b}:{v:+.2f}' for b,v in zip(srt['BCE'], srt['PC1'])))
print()
load = pd.Series(Vt[0] * (-1 if flipped else 1), index=Z_COLS)
print('PC1 loadings (correlations of PC1 with standardized Z; sign-oriented):')
print(load.round(3).to_string())
print()
print('Correlation of PC1 with each raw Z variable:')
print(df[Z_COLS].corrwith(df['PC1']).round(3).to_string())
print()

# --- Robustness: non-standardized (covariance) PCA on the already-typified Z values
Xc = X_raw - X_raw.mean(0)
Ur, Sr, Vtr = np.linalg.svd(Xc, full_matrices=False)
evr_r = (Sr**2) / (Sr**2).sum()
pc1b = orient(Xc @ Vtr[0], df['ZHort'].values)
v1100b = float(pc1b[df.index[df['BCE']==1100][0]])
mask = (df['BCE']<=1000).values
restb = pc1b[mask].mean()
print(f'Robustness (covariance PCA on raw Z): PC1(1100)={v1100b:.4f}, mean(1000-500)={restb:.4f}, diff={v1100b-restb:.4f}')
print(f'Explained variance ratio PC1 (covariance PCA): {evr_r[0]:.4f}')
print(f'Spearman corr between the two PC1 variants: {pd.Series(pc1).corr(pd.Series(pc1b), method="spearman"):.4f}')
print()
print('ZSichel values within YBA:', yba['ZSichel'].tolist(), '(constant -> interpretation limitation)')

# Save outputs
df[['BCE','group','PC1']].to_csv('outputs/pc1_by_slice.csv', index=False)
load.round(6).to_frame('loading').to_csv('outputs/pc1_loadings.csv')
yba[['BCE','PC1']].to_csv('outputs/pc1_yba.csv', index=False)
print()
print('Saved: outputs/pc1_by_slice.csv, outputs/pc1_loadings.csv, outputs/pc1_yba.csv')
