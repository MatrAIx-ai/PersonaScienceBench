import pandas as pd, numpy as np

np.set_printoptions(precision=3, suppress=True)

# Load capital.csv (decimal comma)
df = pd.read_csv('data/capital.csv', decimal=',')
Z_cols = [c for c in df.columns if c.startswith('Z')]
X = df[Z_cols].astype(float)

# Verify provenance against time_series_data.csv _inter series (century check)
ts = pd.read_csv('data/time_series_data.csv')
mapping = {'ZAxtSchwert':'HatchetSword_inter','ZDolch':'Dagger_inter','Zhausgr':'HouseSize_inter'}
ts['BCE'] = -ts['CE']
sel = ts[ts['BCE'].between(500,4300) & (ts['BCE']%100==0)].set_index('BCE').sort_index(ascending=False)
for k,v in mapping.items():
    merged = df.set_index('BCE')[k].astype(float) - sel[v]
    print(f'provenance {k} vs {v}: max|diff| = {merged.abs().max():.2e}')

# Standardize (PCA of correlations)
Z = (X - X.mean()) / X.std(ddof=0)

def pca(Zm):
    C = np.corrcoef(Zm.T) if isinstance(Zm, np.ndarray) else np.corrcoef(Zm, rowvar=False)
    w, V = np.linalg.eigh(C)
    idx = np.argsort(w)[::-1]
    w, V = w[idx], V[:, idx]
    # sign convention: make the largest-|loading| column positive (deterministic)
    for j in range(V.shape[1]):
        if V[np.argmax(np.abs(V[:, j])), j] < 0:
            V[:, j] *= -1
    scores = (Zm - Zm.mean(0)) @ V if isinstance(Zm, np.ndarray) else (Zm - Zm.mean(0)) @ V
    return w, V, scores

w, V, scores = pca(Z.values)
evr = w / w.sum()
print('\nExplained variance ratio PC1..PC4:', np.round(evr[:4],3), ' PC1+PC2 =', round(evr[0]+evr[1],3))

load = pd.DataFrame(V[:, :4], index=Z_cols, columns=['PC1','PC2','PC3','PC4'])
print('\nLoadings (all 12 vars):'); print(load.round(3))

sym = ['Zhausgr','ZDolch','ZAxtSchwert']
print('\nSymbolic variable loadings:'); print(load.loc[sym].round(3))

sc = pd.DataFrame(scores[:, :2], columns=['PC1','PC2'])
sc['BCE'] = df['BCE'].values; sc['group'] = df['group'].values
print('\nScores by group (mean/min/max):')
print(sc.groupby('group').agg(PC1_mean=('PC1','mean'), PC1_min=('PC1','min'), PC1_max=('PC1','max'),
                              PC2_mean=('PC2','mean'), PC2_min=('PC2','min'), PC2_max=('PC2','max')).round(2))
print('\nScores timeline (BCE desc):')
print(sc.sort_values('BCE', ascending=False).round(2).to_string(index=False))

# Sensitivity 1: drop ZSichel (near-constant)
Zcols2 = [c for c in Z_cols if c != 'ZSichel']
Z2 = (X[Zcols2] - X[Zcols2].mean()) / X[Zcols2].std(ddof=0)
w2, V2, _ = pca(Z2.values)
load2 = pd.DataFrame(V2[:, :2], index=Zcols2, columns=['PC1','PC2'])
print('\n--- Sensitivity A: PCA without ZSichel ---')
print('EVR PC1,PC2:', np.round((w2/w2.sum())[:2],3))
print(load2.loc[sym + [c for c in Zcols2 if c not in sym]].round(3))

# Sensitivity 2: winsorize ZMW outlier
X3 = X.copy(); X3['ZMW'] = X3['ZMW'].clip(upper=X3['ZMW'].quantile(0.99))
Z3 = (X3 - X3.mean()) / X3.std(ddof=0)
w3, V3, _ = pca(Z3.values)
load3 = pd.DataFrame(V3[:, :2], index=Z_cols, columns=['PC1','PC2'])
print('\n--- Sensitivity B: ZMW winsorized at 99th pct ---')
print('EVR PC1,PC2:', np.round((w3/w3.sum())[:2],3))
print(load3.loc[sym].round(3))

# Correlations among symbolic vars and with prestige/utilitarian blocks
print('\nCorrelations of symbolic vars with all Z:')
print(X.corr().loc[sym].round(2).to_string())
sc.to_csv('output/pc_scores.csv', index=False)
load.to_csv('output/pc_loadings.csv')
