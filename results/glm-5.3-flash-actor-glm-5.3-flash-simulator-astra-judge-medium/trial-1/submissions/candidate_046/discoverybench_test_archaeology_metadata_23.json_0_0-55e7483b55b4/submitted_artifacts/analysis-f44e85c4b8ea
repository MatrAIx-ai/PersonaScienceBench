"""
DiscoveryBench episode: discoverybench:test/archaeology/metadata_23.json/0/0
Question: Between 3400 BCE to 3000 BCE, how does the number of monuments and axes
change with elements of symbolic capital?

Approach (approved):
 (a) Characterize change of MonumentCount & AxesCelts in 3400-3000 BCE (Z units).
 (b) Descriptive correlations (Pearson & Spearman) with symbolic capital
     (HatchetSword, Dagger, HouseSize) at 5 centennial anchors + interpolated
     annual series, with cross-correlations at lags +/-100-200y.
 (c) Demographic/landscape context: MEAN and SMOOTH_MEAN_100y of pollen PC1.
 (d) Natural-language hypothesis with declared limitations.
"""
import numpy as np
import pandas as pd

OUT = []
def log(s=""):
    print(s)
    OUT.append(str(s))

TS_PATH = "data/time_series_data.csv"
CAP_PATH = "data/capital.csv"
POL_PATH = "data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv"
WIN_LO, WIN_HI = -3400, -3000

# ---------------------------------------------------------------- load
ts = pd.read_csv(TS_PATH)
cap = pd.read_csv(CAP_PATH, decimal=",")
pol = pd.read_csv(POL_PATH, decimal=",")

ZVARS = ["HatchetSword", "Dagger", "HouseSize", "CopperGold", "Amber",
         "MonumentCount", "Depot", "Sickle", "AxesCelts", "MonumentSize",
         "PotteryForm", "PotteryDecoration"]

log("=" * 78)
log("0) LOAD & CONSISTENCY CHECK")
log("=" * 78)
log(f"time_series_data: {ts.shape[0]} rows x {ts.shape[1]} cols; CE {ts.CE.min()}..{ts.CE.max()}")
log(f"capital.csv     : {cap.shape[0]} rows x {cap.shape[1]} cols; BCE {cap.BCE.max()}..{cap.BCE.min()}")
log(f"pollen file     : {pol.shape[0]} rows x {pol.shape[1]} cols; CE {pol.CE.min()}..{pol.CE.max()}")

# capital.csv (BCE positive) <-> time_series (CE negative): same value?
m = ts.merge(cap.assign(CE=-cap.BCE), on="CE", how="inner")
pairs = [("MonumentCount", "ZMonument"), ("AxesCelts", "ZBeil"), ("HatchetSword", "ZAxtSchwert"),
         ("Dagger", "ZDolch"), ("HouseSize", "Zhausgr")]
maxdiff = max(np.nanmax(np.abs(m[a] - m[b])) for a, b in pairs)
log(f"Consistency capital.csv vs time_series raw anchors (n={len(m)} rows): max abs diff = {maxdiff:.2e}")
log("ts.pollen vs Belau_PC1_inter correlation: "
    f"{ts.merge(pol, on='CE')[['pollen','Belau_PC1_inter']].dropna().corr().iloc[0,1]:.4f} (same series)")

# ---------------------------------------------------------------- window
w = ts[(ts.CE >= WIN_LO) & (ts.CE <= WIN_HI)]
anchors = w[w.CE % 100 == 0].sort_values("CE")
polw = pol[(pol.CE >= WIN_LO) & (pol.CE <= WIN_HI)]
capw = cap[(cap.BCE >= 3000) & (cap.BCE <= 3400)].sort_values("BCE", ascending=False)

log("")
log("=" * 78)
log("(a) CHARACTERIZATION OF MonumentCount & AxesCelts IN 3400-3000 BCE (Z units)")
log("=" * 78)
for v in ["MonumentCount", "AxesCelts"]:
    y = anchors[v].to_numpy(float)
    ce = anchors.CE.to_numpy(int)
    log(f"\n--- {v} (centennial anchors, CE negative = BCE) ---")
    for a, b, d in zip(ce[:-1], ce[1:], np.diff(y)):
        log(f"  {abs(a)}-> {abs(b)} BCE: delta Z = {d:+.4f}  ({d:+.4f} per century)")
    log(f"  start(3400)={y[0]:+.4f}, peak={y.max():+.4f} at {abs(ce[int(np.argmax(y))])} BCE, "
        f"end(3000)={y[-1]:+.4f}, total change={y[-1]-y[0]:+.4f} Z")
    log(f"  mean rate 3400->3000: {(y[-1]-y[0])/4:+.4f} Z/century; "
        f"rise 3400->3200: {(y[2]-y[0])/2:+.4f}/cent; fall 3200->3000: {(y[-1]-y[2])/2:+.4f}/cent")
    ip = w[["CE", v + "_inter"]].dropna()
    log(f"  annual interpolated series: min={ip[v+'_inter'].min():+.4f} at {abs(int(ip.loc[ip[v+'_inter'].idxmin(),'CE']))} BCE, "
        f"max={ip[v+'_inter'].max():+.4f} at {abs(int(ip.loc[ip[v+'_inter'].idxmax(),'CE']))} BCE")

log("\n--- Symbolic-capital elements (centennial anchors, same window) ---")
for v in ["HatchetSword", "Dagger", "HouseSize"]:
    y = anchors[v].to_numpy(float)
    log(f"  {v:13s}: " + " -> ".join(f"{abs(c)}BCE:{x:+.2f}" for c, x in zip(anchors.CE, y)) +
        f"   | total change {y[-1]-y[0]:+.3f} Z, range {y.max()-y.min():.3f} Z")

log("\n--- Context (social capital & other Z, anchors) ---")
for v in ["CopperGold", "Amber", "MonumentSize", "Depot"]:
    y = anchors[v].to_numpy(float)
    log(f"  {v:13s}: " + " -> ".join(f"{x:+.2f}" for x in y) + f"   | total change {y[-1]-y[0]:+.3f} Z")

log("\nCross-check capital.csv in window (group MN):")
log(capw[["BCE", "group", "ZMonument", "ZBeil", "ZAxtSchwert", "ZDolch", "Zhausgr"]].to_string(index=False))

# ---------------------------------------------------------------- correlations
log("")
log("=" * 78)
log("(b) RELATION: MONUMENTS & AXES vs SYMBOLIC CAPITAL")
log("=" * 78)
sym = ["HatchetSword", "Dagger", "HouseSize"]
tgt = ["MonumentCount", "AxesCelts"]
ctx = ["CopperGold", "Amber"]

A = anchors[["CE"] + tgt + sym + ctx].set_index("CE")
log("\nPearson / Spearman on the 5 centennial anchors (n=5, descriptive only):")
for t in tgt:
    for s in sym + ctx:
        pr = A[t].corr(A[s], method="pearson")
        sp = A[t].corr(A[s], method="spearman")
        log(f"  {t:14s} vs {s:13s}: Pearson r={pr:+.3f}  Spearman rho={sp:+.3f}")
log(f"\n  MonumentCount vs AxesCelts (anchor): Pearson r={A['MonumentCount'].corr(A['AxesCelts']):+.3f}, "
    f"Spearman rho={A['MonumentCount'].corr(A['AxesCelts'], method='spearman'):+.3f}")

W = w[["CE"] + [c + "_inter" for c in tgt + sym + ctx]].copy()
W.columns = ["CE"] + tgt + sym + ctx
assert W[tgt + sym + ctx].notna().all().all()
log("\nPearson / Spearman on the 401-point annual interpolated series (not independent):")
for t in tgt:
    for s in sym + ctx:
        pr = W[t].corr(W[s], method="pearson")
        sp = W[t].corr(W[s], method="spearman")
        log(f"  {t:14s} vs {s:13s}: Pearson r={pr:+.3f}  Spearman rho={sp:+.3f}")
log(f"\n  MonumentCount vs AxesCelts (annual): Pearson r={W['MonumentCount'].corr(W['AxesCelts']):+.3f}, "
    f"Spearman rho={W['MonumentCount'].corr(W['AxesCelts'], method='spearman'):+.3f}")

# cross-correlations at lags +/-100,200 years
log("\nCross-correlation (Pearson) with lag: target shifted vs symbolic-capital element")
log("(lag>0 means the target LAGS the capital element by |lag| years)")
def xcorr(x, y, lags=(-200, -100, 0, 100, 200)):
    out = {}
    for L in lags:
        a, b = W[x].copy(), W[y].copy()
        if L > 0:
            a = a.iloc[:-L].reset_index(drop=True); b = b.iloc[L:].reset_index(drop=True)
        elif L < 0:
            a = a.iloc[-L:].reset_index(drop=True); b = b.iloc[:L].reset_index(drop=True)
        ok = a.notna() & b.notna()
        out[L] = a[ok].corr(b[ok])
    return out
for t in tgt:
    for s in sym:
        cc = xcorr(t, s)
        log(f"  {t:14s} vs {s:13s}: " + "  ".join(f"lag{L:+4d}: r={r:+.3f}" for L, r in cc.items()))

# ---------------------------------------------------------------- pollen context
log("")
log("=" * 78)
log("(c) POLLEN / OPENNESS CONTEXT (PC1; assumed: higher PC1 = more open landscape)")
log("=" * 78)
pw = polw[["CE", "calBP", "MEAN", "SMOOTH_MEAN_100y"]].copy()
log(f"Window rows: {len(pw)}; MEAN range {pw.MEAN.min():+.3f} .. {pw.MEAN.max():+.3f}")
log(f"SMOOTH_MEAN_100y range: {pw.SMOOTH_MEAN_100y.min():+.3f} .. {pw.SMOOTH_MEAN_100y.max():+.3f}")
for label, col in [("MEAN", "MEAN"), ("SMOOTH_MEAN_100y", "SMOOTH_MEAN_100y")]:
    s = pw.set_index("CE")[col]
    log(f"  {label}: max at {abs(int(s.idxmax()))} BCE ({s.max():+.3f}), min at {abs(int(s.idxmin()))} BCE ({s.min():+.3f})")
log("  SMOOTH_MEAN_100y sampled every 50y in window:")
sm = pw[pw.CE % 50 == 0].sort_values("CE")
log("   " + "  ".join(f"{abs(c)}:{v:+.2f}" for c, v in zip(sm.CE, sm.SMOOTH_MEAN_100y)))

# align pollen (annual) with interpolated targets
PW = pol[["CE", "MEAN", "SMOOTH_MEAN_100y"]].merge(W[["CE"] + tgt], on="CE")
log("\nCorrelation targets vs pollen context (annual interpolated series, n=401):")
for t in tgt:
    for pcol in ["MEAN", "SMOOTH_MEAN_100y"]:
        pr = PW[t].corr(PW[pcol]); sp = PW[t].corr(PW[pcol], method="spearman")
        log(f"  {t:14s} vs {pcol:16s}: Pearson r={pr:+.3f}  Spearman rho={sp:+.3f}")
# 100y anchors of pollen (sample at anchor CEs)
pa = pol[pol.CE.isin(anchors.CE)][["CE", "MEAN", "SMOOTH_MEAN_100y"]].merge(A.reset_index(), on="CE")
log("\nCorrelation targets vs pollen at the 5 centennial anchors (n=5):")
for t in tgt:
    for pcol in ["MEAN", "SMOOTH_MEAN_100y"]:
        log(f"  {t:14s} vs {pcol:16s}: Pearson r={pa[t].corr(pa[pcol]):+.3f}  Spearman rho={pa[t].corr(pa[pcol], method='spearman'):+.3f}")
log(f"  pollen PC1 anchors by century (MEAN): " +
    " -> ".join(f"{abs(c)}:{v:+.2f}" for c, v in zip(pa.CE, pa.MEAN)))
log(f"  pollen PC1 anchors by century (SMOOTH_100y): " +
    " -> ".join(f"{abs(c)}:{v:+.2f}" for c, v in zip(pa.CE, pa.SMOOTH_MEAN_100y)))

# ---------------------------------------------------------------- saved window table
log("")
log("=" * 78)
log("WINDOW TABLE (centennial anchors: targets, symbolic capital, context)")
log("=" * 78)
tbl = anchors[["CE", "calBP", "MonumentCount", "AxesCelts"] + sym + ctx].copy()
tbl.columns = ["CE(-BCE)", "calBP", "MonumentCount", "AxesCelts", "HatchetSword", "Dagger", "HouseSize", "CopperGold", "Amber"]
log(tbl.round(4).to_string(index=False))
tbl.to_csv("analysis/window_anchors.csv", index=False)

with open("analysis/analysis_log.txt", "w") as f:
    f.write("\n".join(OUT))
print("\n[saved] analysis/analysis_log.txt, analysis/window_anchors.csv")
