"""
Diversity in Pottery Decoration vs Diversity in Pottery Form:
first century with opposite growth trends (Decoration up significantly,
Form down simultaneously).

Convention (documented): the change Δ between bin c-100 and bin c is
attributed to bin c, i.e. the century in which the new value appears.
Bin labelled CE = X denotes the interval (X-100, X] in years BCE
(see century labelling section of the report).
Primary criterion: ΔDec >= +theta and ΔForm <= -theta, theta = 0.3 z,
searched from the OLDEST bin (CE -4100) to the NEWEST (CE -500).
No pollen data and no capital.csv are used in the main answer.
"""
import numpy as np
import pandas as pd
from scipy import stats

df = pd.read_csv('data/time_series_data.csv', index_col=0)

# --- centennial bins (raw values) ---
bins = df[df['PotteryDecoration'].notna()][['CE', 'PotteryDecoration', 'PotteryForm']].reset_index(drop=True)
bins['DeltaDec'] = bins['PotteryDecoration'].diff()
bins['DeltaForm'] = bins['PotteryForm'].diff()  # change attributed to bin c (row c)

print("=== Centennial bins with inter-bin changes ===")
print(bins[['CE', 'PotteryDecoration', 'PotteryForm', 'DeltaDec', 'DeltaForm']]
      .dropna().to_string(index=False))

# --- primary criterion, sensitivity over theta ---
print("\n=== First bin (oldest->newest) with ΔDec >= +θ and ΔForm <= -θ ===")
results = {}
for theta in [0.2, 0.3, 0.5]:
    hit = bins[(bins.DeltaDec >= theta) & (bins.DeltaForm <= -theta)]
    first = hit.iloc[0] if len(hit) else None
    results[theta] = first
    if first is not None:
        print(f"theta={theta}: FIRST hit at CE = {int(first.CE)} "
              f"(Dec {first.PotteryDecoration:+.2f}, Form {first.PotteryForm:+.2f}; "
              f"ΔDec={first.DeltaDec:+.2f}, ΔForm={first.DeltaForm:+.2f}); "
              f"all hits: {[int(c) for c in hit.CE]}")
    else:
        print(f"theta={theta}: no hit")

# --- confirmation 1: Mann-Kendall trend on annual _inter series in windows ---
def mann_kendall(y):
    y = np.asarray(y, dtype=float)
    n = len(y)
    s = sum(np.sign(y[j] - y[i]) for i in range(n - 1) for j in range(i + 1, n))
    var_s = n * (n - 1) * (2 * n + 5) / 18.0
    if s > 0:   z = (s - 1) / np.sqrt(var_s)
    elif s < 0: z = (s + 1) / np.sqrt(var_s)
    else:       z = 0.0
    p = 2.0 * (1.0 - stats.norm.cdf(abs(z)))
    return z, p

inter = df[['CE', 'PotteryDecoration_inter', 'PotteryForm_inter']].dropna()
print("\n=== Mann-Kendall on annual _inter series, windows around candidate ===")
cand = int(results[0.3].CE)
for w in [100, 150, 250]:
    lo, hi = cand - 100 - w, cand + w
    seg = inter[(inter.CE >= lo) & (inter.CE <= hi)]
    z1, p1 = mann_kendall(seg.PotteryDecoration_inter.values)
    z2, p2 = mann_kendall(seg.PotteryForm_inter.values)
    s1 = stats.linregress(seg.CE, seg.PotteryDecoration_inter)
    s2 = stats.linregress(seg.CE, seg.PotteryForm_inter)
    print(f"window ±{w}y (CE {lo}..{hi}, n={len(seg)}): "
          f"Dec MK z={z1:+.2f} p={p1:.2e} slope={s1.slope:+.5f}/yr | "
          f"Form MK z={z2:+.2f} p={p2:.2e} slope={s2.slope:+.5f}/yr")

# --- confirmation 2: rolling OLS slopes over 200/300/500y windows ---
print("\n=== Rolling OLS slope (z/yr) ending at each century bin, 200/300/500y ===")
for w in [200, 300, 500]:
    rows = []
    for ce in bins.CE[1:]:
        seg = inter[(inter.CE > ce - 100 - w) & (inter.CE <= ce)]
        if len(seg) < w // 2:
            continue
        s1 = stats.linregress(seg.CE, seg.PotteryDecoration_inter).slope
        s2 = stats.linregress(seg.CE, seg.PotteryForm_inter).slope
        rows.append((int(ce), s1, s2))
    r = pd.DataFrame(rows, columns=['CE', 'slopeDec', 'slopeForm'])
    opp = r[(r.slopeDec > 0) & (r.slopeForm < 0)]
    first = int(opp.CE.iloc[0]) if len(opp) else None
    candrow = r[r.CE == cand]
    print(f"window {w}y: first opposite-sign bin CE={first}; "
          f"at CE={cand}: slopeDec={candrow.slopeDec.iloc[0]:+.6f}, slopeForm={candrow.slopeForm.iloc[0]:+.6f}/yr")

# --- evidence values for the final hypothesis ---
prev = bins[bins.CE == cand - 100].iloc[0]
cur = bins[bins.CE == cand].iloc[0]
print("\n=== Evidence for hypothesis ===")
print(f"Preceding bin CE={int(prev.CE)}: Decoration z={prev.PotteryDecoration:+.2f}, Form z={prev.PotteryForm:+.2f}")
print(f"Candidate bin CE={int(cur.CE)}: Decoration z={cur.PotteryDecoration:+.2f}, Form z={cur.PotteryForm:+.2f}")
print(f"Changes: ΔDec={cur.DeltaDec:+.2f} z, ΔForm={cur.DeltaForm:+.2f} z")
