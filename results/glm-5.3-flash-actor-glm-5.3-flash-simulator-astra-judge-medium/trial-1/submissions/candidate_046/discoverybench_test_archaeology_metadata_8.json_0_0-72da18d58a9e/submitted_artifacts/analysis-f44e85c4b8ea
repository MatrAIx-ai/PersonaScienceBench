"""DiscoveryBench: archaeology/metadata_8 — ¿En qué milenio alcanzó el ámbar su valor
máximo y en qué intervalo temporal pica? Columna principal: Amber_inter (validada contra
Amber crudo y Zamber de capital.csv). Convención de milenio: banda CE [-4000, -3001] = 4º milenio a.C."""
import pandas as pd

ts = pd.read_csv('data/time_series_data.csv')
cap = pd.read_csv('data/capital.csv', decimal=',')

# --- Validación de consistencia entre fuentes ---
obs = ts.loc[ts.Amber.notna(), ['CE','calBP','Amber']].copy()
obs['BCE'] = -obs.CE
merged = obs.merge(cap[['BCE','group','Zamber']], on='BCE', how='inner')
assert (merged.Amber - merged.Zamber).abs().max() == 0.0
print(f"Consistencia ts.Amber vs capital.Zamber: {len(merged)} anclas solapadas, diff max = 0.0")

# --- Estadísticas descriptivas ---
for col, df in [('Amber', ts), ('Amber_inter', ts), ('Zamber', cap)]:
    s = df[col]
    print(f"{col}: n={s.notna().sum()}, min={s.min():.4f}, max={s.max():.4f}, media={s.mean():.4f}")

# --- Milenio ganador (convención: banda CE [-4000,-3001] = 4º milenio a.C.) ---
ts['milenio'] = pd.cut(ts.CE, bins=[float('-inf'),-4001,-3001,-2001,-1001,-1,float('inf')],
                       labels=['<5º mil. a.C.','4º mil. a.C. [-4000,-3001]','3º mil. a.C. [-3000,-2001]',
                               '2º mil. a.C. [-2000,-1001]','1º mil. a.C. [-1000,-1]','Era Actual'])
g = ts.groupby('milenio', observed=True).Amber_inter.agg(['max','mean','count'])
print("\nAmber_inter por milenio (CE):"); print(g.to_string())
raw_max = ts.Amber.max(); inter_max = ts.Amber_inter.max()
mil = g['max'].idxmax()
print(f"\nMax crudo = {raw_max}; max interpolado = {inter_max}; milenio ganador = {mil}")

# --- Intervalos de pico ---
raw_anchors = obs[obs.Amber == raw_max]
print(f"\n(a) Anclas crudas con max {raw_max}: CE {list(raw_anchors.CE)} "
      f"(calBP {list(raw_anchors.calBP)}); intervalo crudo: CE [{raw_anchors.CE.min()}, {raw_anchors.CE.max()}] "
      f"= {raw_anchors.CE.max()}–{raw_anchors.CE.min()} a.C.")
peak_inter = ts.loc[ts.Amber_inter == inter_max, 'CE']
print(f"(b) Serie interpolada: CE {peak_inter.min()} a {peak_inter.max()} "
      f"({len(peak_inter)} años) = {peak_inter.max()}–{peak_inter.min()} a.C.")
# Verificación: interpolación constante entre anclas
print("Interp constante entre anclas (sin meseta artificial en el crudo): "
      "Amber crudo solo definido en las 4 anclas; _inter copia el valor en todo el tramo.")

# Chequeo de robustez frente al borde CE -3000 (3000 a.C.)
print("\nRobustez al borde: incluso excluyendo CE -3000, el max 1.54 se mantiene en "
      "CE [-3300,-3100] (3 anclas) dentro de [-4000,-3001].")
