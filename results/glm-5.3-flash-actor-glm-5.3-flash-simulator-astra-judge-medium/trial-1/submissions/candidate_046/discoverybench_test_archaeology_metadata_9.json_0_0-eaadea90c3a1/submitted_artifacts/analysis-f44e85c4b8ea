"""
Analisis principal: pico del capital social sumado y componentes que aumentan.
Plan aprobado: (1) carga capital.csv decimal=',' y CE=-BCE; (2) suma por siglo
(ZCU_AU+Zamber+ZMonument) y siglo pico; (3) picos, DeltaZ y tendencia por componente;
(4) robustez con series interpoladas anuales agregadas por siglo; (5) contexto del polen.
"""
import pandas as pd
import numpy as np

pd.set_option('display.width', 200)

SOCIAL = ['ZCU_AU', 'Zamber', 'ZMonument']  # Cobre/Oro, Ambar, N. Monumentos

# ---------- (1) Carga y mapeo ----------
cap = pd.read_csv('data/capital.csv', decimal=',')
cap['CE'] = -cap['BCE']
cap = cap.sort_values('CE').reset_index(drop=True)
assert cap['CE'].between(-4300, -500).all()

# ---------- (2) Suma de capital social por siglo ----------
cap['SumCapital'] = cap[SOCIAL].sum(axis=1)
cap['MeanCapital'] = cap[SOCIAL].mean(axis=1)  # robustez: mismo ranking
peak_sum = cap.loc[cap['SumCapital'].idxmax()]
print('=== (2) SUMA DE CAPITAL SOCIAL POR SIGLO (top 10) ===')
top = cap.nlargest(10, 'SumCapital')[['CE','BCE','group','ZCU_AU','Zamber','ZMonument','SumCapital']]
print(top.round(2).to_string(index=False))
print(f"\nSIGLO PICO: CE {peak_sum.CE} (BCE {peak_sum.BCE}) con SumCapital = {peak_sum.SumCapital:.2f} "
      f"(fase {peak_sum.group})")
top_mean = cap.nlargest(3, 'MeanCapital')[['CE','SumCapital','MeanCapital']]
print('Top-3 por media (robustez ranking):'); print(top_mean.round(2).to_string(index=False))

# ---------- (3) Componentes: pico, DeltaZ y tendencia ----------
print('\n=== (3) COMPONENTES: PICO, DELTA Z Y TENDENCIA ===')
rows = []
for v in SOCIAL + ['ZAxtSchwert','ZDolch','Zhausgr','ZHort','ZSichel','ZBeil','ZMW','ZKeform','Zkeverz']:
    i = cap[v].idxmax()
    peak_ce, peak_z = cap.loc[i,'CE'], cap.loc[i,v]
    prev_i = cap.index.get_loc(i)
    dz_prev = peak_z - (cap.loc[prev_i-1, v] if prev_i > 0 else np.nan)
    dz_from_min = peak_z - cap[v].min()
    # tendencia general: regresion lineal sobre CE (orden temporal) y correlacion Spearman
    slope = np.polyfit(cap['CE'], cap[v], 1)[0]
    rho = cap['CE'].corr(cap[v], method='spearman')
    trend = 'SUBE' if rho > 0.15 else ('BAJA' if rho < -0.15 else 'PLATA/NO MONOTONA')
    rows.append({'componente': v, 'pico_CE': peak_ce, 'pico_BCE': -peak_ce, 'pico_Z': round(peak_z,2),
                 'dZ_vs_siglo_prev': round(dz_prev,2) if not np.isnan(dz_prev) else np.nan,
                 'rango_Z': round(dz_from_min,2), 'pendiente_por_siglo': round(slope,3),
                 'spearman': round(rho,2), 'tendencia': trend})
comp = pd.DataFrame(rows)
print(comp.to_string(index=False))

# ---------- (4) Robustez con series interpoladas anuales ----------
print('\n=== (4) ROBUSTEZ: SERIES INTERPOLADAS ANUALES AGREGADAS POR SIGLO ===')
ts = pd.read_csv('data/time_series_data.csv')
ts['century'] = (ts['CE'] // 100) * 100  # marca de siglo
mapa = {'CopperGold_inter':'ZCU_AU','Amber_inter':'Zamber','MonumentCount_inter':'ZMonument'}
agg = ts.groupby('century')[list(mapa)].mean()
agg['SumCapital_inter'] = agg[list(mapa)].sum(axis=1)
agg = agg.reset_index().rename(columns={'century':'CE'})
pk = agg.loc[agg['SumCapital_inter'].idxmax()]
print(f"Siglo pico (interpolado, media de ~100 anos): CE {pk.CE:.0f} con Sum = {pk.SumCapital_inter:.2f}")
print(agg.nlargest(5,"SumCapital_inter").round(2).to_string(index=False))
same = int(pk.CE) == int(peak_sum.CE)
print(f"¿Se mantiene el siglo pico? {'SI' if same else 'NO - se desplaza'} "
      f"(crudo: CE {peak_sum.CE:.0f} vs interpolado: CE {pk.CE:.0f})")
# comparacion crudo vs interpolado por siglo (comun)
chk = cap.merge(agg, on='CE', suffixes=('_crudo','_inter'))
print('Correlacion SumCapital crudo vs interpolado (37 siglos comunes):',
      round(chk['SumCapital'].corr(chk['SumCapital_inter']), 3))
print('Diferencia maxima de siglo entre top-5 crudo y top-5 interpolado:',
      sorted(chk.nlargest(5,'SumCapital')['CE'].astype(int)) , 'vs',
      sorted(agg.nlargest(5,'SumCapital_inter')['CE'].astype(int)))

# ---------- (5) Contexto del polen (apertura del paisaje) ----------
print('\n=== (5) CONTEXTO POLEN (SMOOTH_MEAN_100y) ALREDEDOR DE LOS PICOS ===')
pol = pd.read_csv('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv', decimal=',')
pol['century'] = (pol['CE'] // 100) * 100
polc = pol.groupby('century')['SMOOTH_MEAN_100y'].mean()
def pol_at(ce, rad=100):
    sel = polc[(polc.index >= ce-rad) & (polc.index <= ce+rad)]
    return f"CE {ce} (+-{rad}y): {sel.mean():.2f}" if len(sel) else 'sin datos'
for ce in [int(peak_sum.CE), int(pk.CE), -2700, -3000, -1100]:
    print(f"  {pol_at(ce)}")
print('  Rango polen suavizado: min %.2f, max %.2f (CE %d a %d)' %
      (pol['SMOOTH_MEAN_100y'].min(), pol['SMOOTH_MEAN_100y'].max(), pol['CE'].min(), pol['CE'].max()))

# ---------- Resumen tabular persistente ----------
comp.to_csv('resultados_componentes.csv', index=False)
top.to_csv('resultados_top_siglos.csv', index=False)
print('\nArchivos de resumen guardados: resultados_componentes.csv, resultados_top_siglos.csv')
