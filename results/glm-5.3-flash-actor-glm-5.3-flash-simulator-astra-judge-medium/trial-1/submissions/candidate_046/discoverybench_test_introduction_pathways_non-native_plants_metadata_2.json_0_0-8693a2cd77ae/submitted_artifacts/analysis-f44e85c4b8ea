"""
Analysis: Prevalence of non-native plants introduced via gardening by habitat type.
Main data: invaded_niche_pathways.csv (632 plots, Barcelona province).
Context: temporal trends, invasion success traits, phylogenetic tree (context only).
Runtime substitutions (documented): no R/glmmTMB -> betabinomial via custom MLE (scipy);
overdispersion also checked with statsmodels GLM Binomial + HC3 robust SEs; no matplotlib/Bio.
"""
import numpy as np, pandas as pd, scipy.stats as st, json
from scipy.special import betaln, gammaln
from scipy.optimize import minimize
import statsmodels.api as sm
from statsmodels.stats.outliers_influence import variance_inflation_factor

rng = np.random.default_rng(42)
OUT = "/workspace/outputs/"
G, U, A, T, H = "n.gard", "n.unint", "n.agfo", "n.total", "habitat"

df = pd.read_csv("data/invaded_niche_pathways.csv", sep="\t")
temporal = pd.read_csv("data/temporal_trends_contingency_table.csv", sep=None, engine="python")
inv = pd.read_csv("data/invasion_success_pathways.csv")
assert ((df[G] + df[U] + df[A]) == df[T]).all(), "count consistency failed"
assert df.duplicated().sum() == 0

print("Habitats (n plots):", dict(df[H].value_counts()))
hab_levels = sorted(df[H].unique())

# ---------- 1. Descriptives ----------
rows = []
for h, g in df.groupby(H):
    pos = g[g[T] > 0]
    rows.append(dict(habitat=h, n_plots=len(g), plots_with_nonnative=len(pos),
        sum_gard=g[G].sum(), sum_unint=g[U].sum(), sum_agfo=g[A].sum(), sum_total=g[T].sum(),
        prevalence=g[G].sum() / g[T].sum(),
        mean_gard_per_plot=g[G].mean(), sd_gard_per_plot=g[G].std(),
        mean_prop_among_pos=(pos[G] / pos[T]).mean() if len(pos) else np.nan))
desc = pd.DataFrame(rows)
desc.to_csv(OUT + "descriptives_by_habitat.csv", index=False)
print("\n=== Descriptives by habitat ===")
print(desc.round(4).to_string(index=False))

# ---------- 2. Chi-square habitat x pathway ----------
ct = df.groupby(H)[[G, U, A]].sum()
chi2, p, dof, exp = st.chi2_contingency(ct.values)
n_tot = ct.values.sum()
cramers_v = np.sqrt(chi2 / (n_tot * (min(ct.shape) - 1)))
print(f"\n=== Chi2 habitat x pathway: chi2={chi2:.2f}, df={dof}, p={p:.3e}, Cramer's V={cramers_v:.3f}, N={n_tot}")
res = pd.DataFrame((ct.values - exp) / np.sqrt(exp), index=ct.index, columns=ct.columns).round(2)
res.to_csv(OUT + "chi2_std_residuals.csv")
print("Standardized residuals:")
print(res.to_string())
prop = ct.div(ct.sum(axis=1), axis=0)
prop.to_csv(OUT + "pathway_shares_by_habitat.csv")
print("\nPathway shares per habitat (Gard/Unint/AgriFo):")
print(prop.round(3).to_string())

# ---------- 3. Bootstrap CIs (5000 resamples, resampling plots within habitat) ----------
B = 5000
ci_prev, ci_gard = {}, {}
for h, g in df.groupby(H):
    a, t = g[G].values, g[T].values
    idx = rng.integers(0, len(g), (B, len(g)))
    pv = a[idx].sum(axis=1) / np.maximum(t[idx].sum(axis=1), 1)
    ci_prev[h] = [np.percentile(pv, 2.5), np.percentile(pv, 97.5)]
    ci_gard[h] = [np.percentile(a[idx].mean(axis=1), 2.5), np.percentile(a[idx].mean(axis=1), 97.5)]
ci_prev = pd.DataFrame(ci_prev, index=["lo", "hi"]).T
ci_prev["point"] = [df[df[H] == h][G].sum() / df[df[H] == h][T].sum() for h in ci_prev.index]
ci_prev.to_csv(OUT + "bootstrap_ci_prevalence.csv")
print("\n=== Bootstrap 95% CI prevalence (n.gard/n.total pooled) ===")
print(ci_prev.round(3).to_string())
ci_gard = pd.DataFrame(ci_gard, index=["lo", "hi"]).T
ci_gard["point"] = [df[df[H] == h][G].mean() for h in ci_gard.index]
ci_gard.to_csv(OUT + "bootstrap_ci_gard_richness.csv")
print("\n=== Bootstrap 95% CI mean gardening richness per plot ===")
print(ci_gard.round(3).to_string())

# ---------- 4. VIF ----------
df["n_total_pos"] = (df[T] > 0).astype(int)
conf_main = ["elevation", "urban.2009.500m", "cropland.2009.500m",
             "annual.temperature", "annual.rainfall", "annual.radiation",
             "distance.stream", "distance.road"]
REF_HAB = "Urban"
def design(dat, confs, ref=REF_HAB):
    d = pd.get_dummies(dat[H]).astype(float)
    d = d.drop(columns=[ref])
    X = pd.concat([d, dat[confs].apply(lambda s_: (s_ - s_.mean()) / s_.std())], axis=1)
    return sm.add_constant(X)
print("corr(elevation, annual.temperature) = %.3f" % np.corrcoef(df["elevation"], df["annual.temperature"])[0, 1])
print("corr(elevation, annual.rainfall) = %.3f" % np.corrcoef(df["elevation"], df["annual.rainfall"])[0, 1])

# iterative pruning of numeric confounders with VIF>10 (threshold rule, documented)
active = list(conf_main)
dropped = []
while True:
    Xtmp = sm.add_constant(pd.concat([pd.get_dummies(df[H], drop_first=True).astype(float),
                                      df[active].apply(lambda s_: (s_ - s_.mean()) / s_.std())], axis=1))
    vs = pd.Series([variance_inflation_factor(Xtmp.values, i) for i in range(Xtmp.shape[1])],
                   index=Xtmp.columns)
    num = {c: vs[c] for c in active}
    worst = max(num, key=num.get)
    if num[worst] <= 10 or len(active) <= 3:
        break
    dropped.append((worst, round(float(num[worst]), 2)))
    active.remove(worst)
conf_final = active
print("Dropped for VIF>10 (iterative):", dropped)
print("Final confounder set:", conf_final)
X1 = design(df, conf_final)
vif = pd.Series([variance_inflation_factor(X1.values, i) for i in range(X1.shape[1])], index=X1.columns)
vif.to_csv(OUT + "vif.csv", header=["VIF"])
print("\n=== VIF after pruning (standardized) ===")
print(vif.round(2).to_string())

# ---------- 5. Component 1: presence of any non-native ----------
m1 = sm.GLM(df["n_total_pos"], X1, family=sm.families.Binomial()).fit(cov_type="HC3")
c1 = pd.DataFrame({"coef": m1.params, "SE": m1.bse, "z": m1.tvalues, "p": m1.pvalues})
c1.to_csv(OUT + "glm_presence.csv")
print("\n=== Component 1: P(any non-native) binomial GLM, HC3 ===")
print(c1.round(4).to_string())

# ---------- 6. Component 2: gardening share among plots with non-natives ----------
sub = df[df[T] > 0].copy()
X2 = design(sub, conf_final)
y1 = sub[G].values; y0 = (sub[T] - sub[G]).values
Xv = X2.values

def betabinom_nll(params):
    beta, logphi = params[:-1], params[-1]
    eta = Xv @ beta
    p_ = 1 / (1 + np.exp(-np.clip(eta, -30, 30)))
    phi = np.exp(np.clip(logphi, -10, 10))
    a, b = p_ * phi, (1 - p_) * phi
    n_ = y1 + y0
    logC = gammaln(n_ + 1) - gammaln(y1 + 1) - gammaln(y0 + 1)
    ll = logC + betaln(a + y1, b + y0) - betaln(a, b)
    return -ll.sum()

# start from binomial GLM coefficients; multi-start on phi; bounded log-phi
m2_init = sm.GLM(np.column_stack([y1, y0]), X2.values,
                 family=sm.families.Binomial()).fit()
best = None
for lp0 in [-3.0, -1.0, 0.0, 1.0, 2.0]:
    x0 = np.r_[m2_init.params, lp0]
    o = minimize(betabinom_nll, x0, method="L-BFGS-B",
                 bounds=[(None, None)] * (X2.shape[1]) + [(-8, 6)],
                 options={"maxiter": 5000})
    if best is None or o.fun < best.fun:
        best = o
opt = best
phi_hat = float(np.exp(opt.x[-1])); rho = 1 / (1 + phi_hat)
print(f"\n=== Component 2: betabinomial MLE ===")
print(f"converged={opt.success}, phi={phi_hat:.2f}, overdispersion rho=1/(1+phi)={rho:.3f}")
def num_hess(f, x, eps=1e-4):
    n = len(x); H = np.zeros((n, n))
    f0 = f(x)
    for i in range(n):
        for j in range(i, n):
            ei = np.zeros(n); ej = np.zeros(n)
            ei[i] = eps; ej[j] = eps
            if i == j:
                H[i, i] = (f(x + ei) - 2 * f0 + f(x - ei)) / eps**2
            else:
                H[i, j] = H[j, i] = (f(x + ei + ej) - f(x + ei - ej)
                                     - f(x - ei + ej) + f(x - ei - ej)) / (4 * eps**2)
    return H
Hnum = num_hess(betabinom_nll, opt.x)
Hinv = np.linalg.pinv(Hnum)
se_all = np.sqrt(np.abs(np.diag(Hinv)))
se = se_all[:-1]
bb = pd.DataFrame({"coef": opt.x[:-1], "SE_approx": se}, index=X2.columns)
bb["OR"] = np.exp(bb["coef"]); bb["p"] = 2 * st.norm.sf(np.abs(bb["coef"] / bb["SE_approx"]))
bb.to_csv(OUT + "betabinom_coefs.csv")
# adjusted marginal predicted prevalence per habitat (covariates at observed values)
cols = list(X2.columns)
pred_rows = []
for h in hab_levels:
    Xh = X2.copy()
    for hh in hab_levels:
        if hh == REF_HAB or hh not in Xh.columns:
            continue
        Xh[hh] = 1.0 if hh == h else 0.0
    eta = Xh.values @ opt.x[:-1]
    p_ = 1 / (1 + np.exp(-np.clip(eta, -30, 30)))
    pred_rows.append(dict(habitat=h, adjusted_mean_prev=float(np.mean(p_))))
adj = pd.DataFrame(pred_rows)
adj.to_csv(OUT + "adjusted_prevalence_by_habitat.csv", index=False)
print("\n=== Adjusted mean predicted gardening prevalence (betabinomial, ref=%s) ===" % REF_HAB)
print(adj.round(3).to_string(index=False))
print(bb.round(4).to_string())

m2 = sm.GLM(np.column_stack([y1, y0]), X2.values,
            family=sm.families.Binomial()).fit(cov_type="HC3")
disp = float((m2.resid_pearson ** 2).sum() / m2.df_resid)
print(f"\nBinomial GLM Pearson chi2/df = {disp:.2f} (>1 => overdispersion; motivates betabinomial)")
c2 = pd.DataFrame({"coef": np.asarray(m2.params), "SE_HC3": np.asarray(m2.bse),
                   "p": np.asarray(m2.pvalues)}, index=list(X2.columns))
c2["OR"] = np.exp(c2["coef"])
c2.to_csv(OUT + "glm_gardshare_binomialHC3.csv")
print(c2.round(4).to_string())

# ---------- 7. Sensitivity ----------
sens_sets = {
    "main_2009_500m": conf_final,
    "hist_1956_500m": ["elevation", "urban.1956.500m", "cropland.1956.500m",
                       "annual.temperature", "annual.rainfall", "annual.radiation",
                       "distance.stream", "distance.road"],
    "hist_1993_500m": ["elevation", "urban.1993.500m", "cropland.1993.500m",
                       "annual.temperature", "annual.rainfall", "annual.radiation",
                       "distance.stream", "distance.road"],
    "plus_change_50m": conf_final + ["progressive.1956.2009.50m", "regressive.1956.2009.50m"],
}
sens_rows = []
for name, confs in sens_sets.items():
    for comp, dat in [("presence", df), ("gard_share", sub)]:
        Xs = design(dat, confs)
        if comp == "presence":
            mm = sm.GLM(dat["n_total_pos"], Xs.values, family=sm.families.Binomial()).fit(cov_type="HC3")
        else:
            mm = sm.GLM(np.column_stack([dat[G].values, (dat[T] - dat[G]).values]),
                        Xs.values, family=sm.families.Binomial()).fit(cov_type="HC3")
        cols = list(Xs.columns)
        for col in cols:
            if col != "const" and any(col == h for h in hab_levels if h != REF_HAB):
                j = cols.index(col)
                sens_rows.append(dict(model=name, component=comp, term=col,
                                      coef=float(np.asarray(mm.params)[j]), p=float(np.asarray(mm.pvalues)[j])))
sens = pd.DataFrame(sens_rows)
sens.to_csv(OUT + "sensitivity_habitat_coefs.csv", index=False)
print("\n=== Sensitivity: habitat coefficients (binomial GLM HC3) across specs ===")
print(sens.pivot_table(index="term", columns=["component", "model"], values="coef").round(3).to_string())

# ---------- 8. Temporal context ----------
tw = temporal.pivot(index="introduction.period", columns="pathway", values="n")[["AgriForest", "Gardening", "Unintentional"]]
tw["Gardening_share"] = tw.Gardening / tw.sum(axis=1)
tw.to_csv(OUT + "temporal_pathways.csv")
print("\n=== Temporal context ===")
print(tw.to_string())

# ---------- 9. Species-level context ----------
print("\n=== invasion_success context ===")
print("intro.pathway counts:", dict(inv["intro.pathway"].value_counts()))
print(pd.crosstab(inv["growth.form"], inv["intro.pathway"]).to_string())
print("mean mrt by pathway:")
print(inv.groupby("intro.pathway")["mrt"].mean().round(1).to_string())

summary = dict(dropped_confounders=dropped, final_confounders=conf_final,
               n_plots=len(df), n_plots_nonnative=int((df[T] > 0).sum()),
               chi2=float(chi2), p_chi2=float(p), cramers_v=float(cramers_v),
               betabinom_rho=rho, binom_glm_overdispersion=disp)
json.dump(summary, open(OUT + "summary.json", "w"), indent=2, default=float)
print("\nSummary:", json.dumps(summary, default=float))
