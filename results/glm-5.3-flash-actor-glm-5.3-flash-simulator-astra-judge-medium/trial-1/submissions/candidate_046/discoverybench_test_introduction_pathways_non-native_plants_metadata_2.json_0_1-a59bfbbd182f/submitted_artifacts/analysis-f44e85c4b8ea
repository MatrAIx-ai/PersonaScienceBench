"""DiscoveryBench: introduction_pathways_non-native_plants
Question: In what context does the gardening pathway for introducing non-native
plants show different prevalence styles across habitat types?
Approved plan: plot-level proportions + bootstrap CIs, association tests,
urban gradient, triangulation with invasion_success (no premature habitat pooling).
"""
import pandas as pd, numpy as np, itertools, json
from scipy import stats

rng = np.random.default_rng(42)
OUT = {}

# ---------- Load ----------
temp = pd.read_csv('data/temporal_trends_contingency_table.csv', sep='\t')
plots = pd.read_csv('data/invaded_niche_pathways.csv', sep='\t')
sp = pd.read_csv('data/invasion_success_pathways.csv')

# ---------- 1) Per-habitat pathway proportions + bootstrap CIs (plot resampling) ----------
counts = plots.groupby('habitat')[['n.gard','n.unint','n.agfo','n.total']].sum()
B = 5000
rows = []
for h, g in plots.groupby('habitat'):
    arr = g[['n.gard','n.unint','n.agfo','n.total']].values.astype(float)
    tot = arr[:,3].sum()
    props = {p: arr[:,i].sum()/tot if tot>0 else np.nan
             for i,p in enumerate(['gard','unint','agfo'])}
    # bootstrap resample plots within habitat (only plots with records for proportions)
    nz = arr[arr[:,3]>0]
    if len(nz) > 1:
        bs = np.array([[r[:3].sum()/r[3] for r in nz[rng.integers(0,len(nz),len(nz))]]
                       for _ in range(B)])
        ci = {p: np.percentile(bs[:,i],[2.5,97.5]) for i,p in enumerate(['gard','unint','agfo'])}
    else:  # single informative plot: CI undefined -> declare instability
        ci = {p: (np.nan, np.nan) for p in ['gard','unint','agfo']}
    # presence per plot (any gardening species) - uses ALL plots incl. zeros
    p_presence = (g['n.gard']>0).mean()
    rows.append({'habitat':h,'plots':len(g),'plots_with_records':int((g['n.total']>0).sum()),
                 'records':int(tot),
                 **{f'p_{k}':round(v,3) for k,v in props.items()},
                 **{f'p_{k}_ci':f"[{ci[k][0]:.3f},{ci[k][1]:.3f}]" for k in props},
                 'p_plot_any_gard':round(p_presence,3)})
prop_tab = pd.DataFrame(rows).sort_values('p_gard', ascending=False)
print("=== Per-habitat pathway proportions (records) + bootstrap 95% CI + plot-presence ===")
print(prop_tab.to_string(index=False))
OUT['proportions'] = prop_tab.to_dict('records')

# ---------- 2) Association tests: habitat x pathway (aggregated records) ----------
tab = counts[['n.gard','n.unint','n.agfo']].values
chi2, p_chi, dof, exp = stats.chi2_contingency(tab)
print(f"\nChi-square habitat x pathway: chi2={chi2:.1f}, df={dof}, p={p_chi:.2e}")
print(f"  min expected count = {exp.min():.2f} (<5 -> use permutation/Monte-Carlo check)")
# Monte-Carlo permutation of pathway labels among records within habitats
lab_pool = np.repeat([0,1,2], tab.sum(axis=0))  # pathway labels
obs_stat = stats.chi2_contingency(tab)[0]
mc = 0
for _ in range(5000):
    perm = rng.permutation(lab_pool)
    perm_tab = np.zeros_like(tab)
    idx=0
    for h_i,n in enumerate(tab.sum(axis=1)):
        perm_tab[h_i] = np.bincount(perm[idx:idx+n], minlength=3); idx+=n
    if stats.chi2_contingency(perm_tab)[0] >= obs_stat: mc+=1
p_mc = (mc+1)/5001
print(f"  Monte-Carlo (5000 perms, counts fixed per habitat) p = {p_mc:.4f}")
OUT['tests'] = {'chi2':chi2,'df':dof,'p_chi2':p_chi,'p_montecarlo':p_mc,'min_expected':float(exp.min())}

# pairwise habitat contrasts for Gardening proportion (Fisher 2x2 gard vs rest)
pair = []
for h1,h2 in itertools.combinations(counts.index,2):
    a,b = counts.loc[h1], counts.loc[h2]
    t = [[a['n.gard'], a['n.unint']+a['n.agfo']],[b['n.gard'], b['n.unint']+b['n.agfo']]]
    if t[0][0]+t[0][1]==0 or t[1][0]+t[1][1]==0: continue
    _,pf = stats.fisher_exact(t)
    pair.append({'hab1':h1,'hab2':h2,'p_gard1':a['n.gard']/max(a['n.total'],1),
                 'p_gard2':b['n.gard']/max(b['n.total'],1),'fisher_p':pf})
pair = pd.DataFrame(pair).sort_values('fisher_p')
print("\nMost significant pairwise Gardening-proportion contrasts (Fisher, gard vs rest):")
print(pair.head(10).round(4).to_string(index=False))
OUT['pairwise_top'] = pair.head(10).to_dict('records')

# ---------- 3) Gardening presence vs urban gradient (plots, incl. zero plots) ----------
sub = plots[(plots['habitat']!='Rock outcrops')].copy()  # rock has 1 record; keep for record-level though
# habitat-level correlation between p_gard and mean urban.2009 (50m buffer)
hab_mean = plots.groupby('habitat')[['urban.2009.50m','urban.2009.500m','urban.2009.1000m','cropland.2009.500m','elevation']].mean()
hab_mean['p_gard'] = counts['n.gard']/counts['n.total']
print("\n=== Habitat-level: p_gard vs landscape context (2009) ===")
print(hab_mean.round(3).to_string())
for c in ['urban.2009.50m','urban.2009.500m','urban.2009.1000m','cropland.2009.500m','elevation']:
    r,pr = stats.spearmanr(hab_mean[c], hab_mean['p_gard'])
    print(f"  Spearman p_gard ~ {c}: rho={r:.2f}, p={pr:.3f}")
    OUT.setdefault('habitat_gradient',{})[c]={'rho':r,'p':pr}
# plot-level: logistic-style contrast: urban.2009.50m of plots with vs without gardening
w = plots.loc[plots['n.gard']>0,'urban.2009.50m']; wo = plots.loc[plots['n.gard']==0,'urban.2009.50m']
u_mw = stats.mannwhitneyu(w,wo,alternative='greater')
print(f"  Plot-level urban.2009.50m: plots with Gardening median={w.median():.3f} vs without={wo.median():.3f} (Mann-Whitney one-sided p={u_mw.pvalue:.4f})")
OUT['urban_plot'] = {'median_with':float(w.median()),'median_without':float(wo.median()),'p':u_mw.pvalue}

# ---------- 4) Temporal trends ----------
temp['period']=pd.Categorical(temp['introduction.period'], ordered=True,
    categories=['Before 1500','1501-1900','1901-1984','1985-2019'])
tt = temp.pivot(index='introduction.period',columns='pathway',values='n')
tt['total']=tt.sum(axis=1); tt['p_gard']=tt['Gardening']/tt['total']
print("\n=== Temporal trends (Catalonia introductions) ===")
print(tt.to_string())
chi_t,pt,dof_t,_ = stats.chi2_contingency(temp.pivot(index='pathway',columns='introduction.period',values='n'))
print(f"Chi-square period x pathway: chi2={chi_t:.1f}, df={dof_t}, p={pt:.2e}")
OUT['temporal'] = {'table':tt.round(3).to_dict(),'chi2':chi_t,'p':pt}

# ---------- 5) Triangulation with invasion_success (species level, deduplicated) ----------
sp_d = sp.drop_duplicates(subset='Scientific_name', keep='first').copy()
print(f"\nSpecies after dedup (kept first of duplicated=TRUE): {len(sp_d)} (raw {len(sp)})")
g = sp_d[sp_d['intro.pathway']=='Gardening']; o = sp_d[sp_d['intro.pathway']!='Gardening']
print(f"Gardening species n={len(g)}, other pathways n={len(o)}")
for col in ['number.of.invaded.plots','habitat.range','invaded.niche.breadth','mrt']:
    mw = stats.mannwhitneyu(g[col].dropna(), o[col].dropna(), alternative='two-sided')
    print(f"  {col}: Gardening median={g[col].median():.2f} vs other={o[col].median():.2f} (Mann-Whitney p={mw.pvalue:.4f})")
top = sp_d.sort_values(['number.of.invaded.plots','habitat.range'],ascending=False).head(12)
print("\nTop-12 most widely invading species (plots, habitat.range, pathway):")
print(top[['Scientific_name','intro.pathway','number.of.invaded.plots','habitat.range','mrt']].to_string(index=False))
OUT['species'] = {'gard_vs_other': {c:{'gard_med':float(g[c].median()),'other_med':float(o[c].median()),
    'p':float(stats.mannwhitneyu(g[c].dropna(),o[c].dropna()).pvalue)}
    for c in ['number.of.invaded.plots','habitat.range','invaded.niche.breadth','mrt']},
    'top12': top[['Scientific_name','intro.pathway','number.of.invaded.plots','habitat.range','mrt']].to_dict('records')}
# Spearman: within Gardening species, does habitat.range predict invaded plots?
r1,p1 = stats.spearmanr(g['habitat.range'], g['number.of.invaded.plots'])
print(f"Within Gardening species: Spearman habitat.range ~ number.of.invaded.plots: rho={r1:.2f}, p={p1:.4f}")
OUT['species']['gard_habrange_vs_plots']={'rho':r1,'p':p1}

with open('outputs/results.json','w') as f: json.dump(OUT,f,indent=1,default=str)
prop_tab.to_csv('outputs/proportions_by_habitat.csv', index=False)
pair.to_csv('outputs/pairwise_fisher.csv', index=False)
print("\nSaved: outputs/results.json, outputs/proportions_by_habitat.csv, outputs/pairwise_fisher.csv")
