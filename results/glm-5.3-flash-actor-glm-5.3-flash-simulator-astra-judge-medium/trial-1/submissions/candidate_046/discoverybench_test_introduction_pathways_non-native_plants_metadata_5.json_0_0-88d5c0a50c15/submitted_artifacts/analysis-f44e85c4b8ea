# -*- coding: utf-8 -*-
"""
DiscoveryBench: introduction_pathways_non-native_plants
Question: In what scenario did urban land use promote a specific type of plant invasion?
Approved workflow:
  (1) habitat x pathway composition (invaded_niche), Urban vs rest
  (2) species traits by intro pathway (invasion_success)
  (3) temporal trends (contingency table)
  (4) phylogenetic support (Newick tree; O. ficus-indica entries excluded from phylo)
  (5) buffer/epoch consistency scan for urban cover
"""
import pandas as pd, numpy as np, re, json
from scipy import stats

OUT = {}

# ---------- Load ----------
t = pd.read_csv('data/temporal_trends_contingency_table.csv', sep='\t')
s = pd.read_csv('data/invasion_success_pathways.csv')
n = pd.read_csv('data/invaded_niche_pathways.csv', sep='\t')
txt = open('data/phylogenetic_tree.txt').read()

# ---------- 0. Documentation of change-variable sums != 1 ----------
sums = {}
for per in ['1956.2009','1993.2009']:
    buf='50m'  # trajectories only exist at the 50 m buffer in the dataset
    tot = n[f'progressive.{per}.{buf}']+n[f'regressive.{per}.{buf}']+n[f'no.changes.{per}.{buf}']
    bad = ((tot-1).abs()>1e-6)
    sums[f'{per}.{buf}'] = int(bad.sum())
OUT['change_sums_not_1'] = sums
OUT['change_sums_range'] = {k: [float(n[k2].sum()) for k2 in []] for k in []}
# per-row sum range per combo
rng = {}
for per in ['1956.2009','1993.2009']:
    buf='50m'
    tot = n[f'progressive.{per}.{buf}']+n[f'regressive.{per}.{buf}']+n[f'no.changes.{per}.{buf}']
    rng[f'{per}.{buf}'] = [round(float(tot.min()),3), round(float(tot.max()),3)]
OUT['change_sums_range'] = rng

# ---------- 1. Habitat x pathway composition ----------
hab = n.groupby('habitat')[['n.gard','n.unint','n.agfo','n.total']].sum()
# proportions per habitat
prop = hab[['n.gard','n.unint','n.agfo']].div(hab['n.total'].replace(0,np.nan), axis=0)
OUT['pathway_counts_by_habitat'] = hab.to_dict('index')
OUT['pathway_props_by_habitat'] = prop.round(3).to_dict('index')

# Plot-level: does a plot's dominant pathway differ between Urban and other habitats?
n2 = n.copy()
n2 = n2.rename(columns={'n.gard':'n_gard','n.unint':'n_unint','n.agfo':'n_agfo','n.total':'n_total'})
n2['urban_grp'] = np.where(n2['habitat']=='Urban','Urban','Other')
# Chi-square on plot-level pathway counts (each species-record per plot as a count)
# Use plot x pathway count table restricted to invaded species records
ct_urban = n2.groupby('urban_grp')[['n_gard','n_unint','n_agfo']].sum()
# chi2 test: are pathway proportions independent of Urban vs Other?
tab = ct_urban.values
# drop zero columns if any
keep = tab.sum(axis=0)>0
chi2, p, dof, exp = stats.chi2_contingency(tab[:,keep])
OUT['chi2_urban_vs_other_pathways'] = {'table': ct_urban.to_dict('index'),
    'chi2': round(float(chi2),3), 'p': float(p), 'dof': int(dof)}

# Poisson/GLM-style: negative binomial alternative -> use quasi-poisson via statsmodels if available
try:
    import statsmodels.api as sm
    have_sm = True
except Exception:
    have_sm = False
if have_sm:
    import statsmodels.formula.api as smf
    res = {}
    for resp in ['n_gard','n_unint','n_agfo']:
        n2['isUrban'] = (n2['habitat']=='Urban').astype(int)
        m = smf.glm(f'{resp} ~ isUrban', data=n2, family=sm.families.Poisson()).fit()
        # robust (quasi) SE
        m2 = smf.glm(f'{resp} ~ isUrban', data=n2, family=sm.families.Poisson()).fit(cov_type='HC0')
        res[resp] = {'coef_isUrban': round(float(m2.params['isUrban']),4),
                     'IRR': round(float(np.exp(m2.params['isUrban'])),3),
                     'p_HC0': float(m2.pvalues['isUrban'])}
    OUT['poisson_urban_effect_per_pathway'] = res
    # controlling for elevation/climate minimally
    res2 = {}
    n2z = n2.copy()
    for c in ['elevation','annual.temperature','annual.rainfall']:
        n2z[c.replace('.','_')+'_z'] = (n2z[c]-n2z[c].mean())/n2z[c].std()
    for resp in ['n_gard','n_unint','n_agfo']:
        m = smf.glm(resp+' ~ isUrban + elevation_z + annual_temperature_z + annual_rainfall_z',
                    data=n2z, family=sm.families.Poisson()).fit(cov_type='HC0')
        res2[resp] = {'IRR_isUrban': round(float(np.exp(m.params['isUrban'])),3),
                      'p_HC0': float(m.pvalues['isUrban'])}
    OUT['poisson_urban_effect_adjusted'] = res2

# ---------- 5. Urban cover buffer/epoch consistency with pathway dominance ----------
corr = {}
path_cols = ['n.gard','n.unint','n.agfo','n.total']
for buf in ['50m','500m','1000m']:
    for yr in ['1956','1993','2009']:
        col = f'urban.{yr}.{buf}'
        for pc in path_cols:
            r,pp = stats.spearmanr(n[col], n[pc])
            corr[f'{col}~{pc}'] = {'rho': round(float(r),3), 'p': float(pp)}
# progressive trajectories
for per in ['1956.2009','1993.2009']:
    for buf in ['50m']:
        col = f'progressive.{per}.{buf}'
        for pc in path_cols:
            r,pp = stats.spearmanr(n[col], n[pc])
            corr[f'{col}~{pc}'] = {'rho': round(float(r),3), 'p': float(pp)}
OUT['spearman_urban_progressive_vs_pathway'] = corr

# ---------- 2. Species traits by pathway ----------
s2 = s.copy()
def chisq(col):
    ct = pd.crosstab(s2['intro.pathway'], s2[col])
    keep = ct.sum(axis=0)>0
    c2,p,d,e = stats.chi2_contingency(ct.values[:,keep])
    return {'table': ct.to_dict('index'), 'chi2': round(float(c2),3), 'p': float(p), 'dof': int(d)}
OUT['trait_tests'] = {
    'growth.form_x_pathway': chisq('growth.form'),
    'dispersal_x_pathway': chisq('dispersal'),
    'vegetative_x_pathway': chisq('vegetative'),
}
num_tests = {}
for col in ['height','mrt','invaded.niche.breadth','native.niche.breadth',
            'number.of.invaded.plots','area.of.occupancy.10km','habitat.range']:
    groups = [g[col].dropna().values for _,g in s2.groupby('intro.pathway')]
    H,pp = stats.kruskal(*groups)
    med = s2.groupby('intro.pathway')[col].median().round(3).to_dict()
    mean = s2.groupby('intro.pathway')[col].mean().round(3).to_dict()
    num_tests[col] = {'H': round(float(H),3), 'p': float(pp), 'median_by_pathway': med, 'mean_by_pathway': mean}
OUT['numeric_trait_kruskal_by_pathway'] = num_tests

# success (invaded plots) by pathway
succ = s2.groupby('intro.pathway')[['number.of.invaded.plots','area.of.occupancy.10km','habitat.range']].mean().round(2)
OUT['invasion_extent_by_pathway'] = succ.to_dict('index')
H,pp = stats.kruskal(*[g['number.of.invaded.plots'].values for _,g in s2.groupby('intro.pathway')])
OUT['kruskal_plots_by_pathway'] = {'H': round(float(H),3), 'p': float(pp)}

# ---------- 3. Temporal trends ----------
piv = t.pivot(index='introduction.period', columns='pathway', values='n')
pct = piv.div(piv.sum(axis=1), axis=0).round(3)
OUT['temporal_counts'] = piv.to_dict('index')
OUT['temporal_props'] = pct.to_dict('index')
# chi2 trend: Gardening share across periods
ct = t.copy()
ct['pathway'] = pd.Categorical(ct['pathway'], ['AgriForest','Gardening','Unintentional'])
w = ct.pivot(index='introduction.period', columns='pathway', values='n').values
c2,p,d,e = stats.chi2_contingency(w)
OUT['temporal_chi2'] = {'chi2': round(float(c2),3), 'p': float(p), 'dof': int(d)}

# ---------- 4. Phylogenetic support ----------
tips = re.findall(r'[(,]\s*([A-Za-z_0-9]+)\s*:', txt)
tips = [x for x in tips if x]
matched = s2[s2['phylo.tip.label'].isin(set(tips))].copy()
# family-level clustering of Gardening species on the tree:
# simple test: do congeneric/consecutive tips share pathway? Use permutation of pathway labels over matched tips
labels_matched = matched['phylo.tip.label'].tolist()
path_vec = matched['intro.pathway'].astype('category').cat.codes.values
# positions of matched tips in tree tip order
order = [i for i,x in enumerate(tips) if x in set(labels_matched)]
tip_pos = {x:i for i,x in enumerate(tips)}
pos = np.array([tip_pos[l] for l in labels_matched])
srt = np.argsort(pos)
path_sorted = path_vec[srt]
# Moran-like autocorrelation statistic: sum over adjacent tips in tree order of same-pathway indicator
def autocorr_stat(v):
    return float(np.mean(v[1:]==v[:-1]))
obs = autocorr_stat(path_sorted)
rng_ = np.random.default_rng(42)
perm = np.array([autocorr_stat(rng_.permutation(path_sorted)) for _ in range(9999)])
OUT['phylo_pathway_clustering'] = {'observed_adjacent_same_pathway': round(obs,3),
    'perm_mean': round(float(perm.mean()),3), 'p_greater': round(float((perm>=obs).mean()),4),
    'n_species_in_tree': int(len(matched))}
# Also: family-level test - are Gardening species concentrated in certain families?
fam_ct = pd.crosstab(s2['family'].isin(['Asteraceae','Poaceae']), s2['intro.pathway'])
c2,pp,d,e = stats.chi2_contingency(fam_ct.values)
OUT['phylo_family_note'] = {'asteraceae_poaceae_vs_other_x_pathway': {'chi2': round(float(c2),3),'p': float(pp)}}

# ---------- Save ----------
with open('outputs/results.json','w') as f:
    json.dump(OUT, f, indent=1, default=str)
print(json.dumps(OUT, indent=1, default=str)[:12000])
