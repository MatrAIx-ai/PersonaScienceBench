import pandas as pd, numpy as np
from scipy import stats
n = pd.read_csv('data/invaded_niche_pathways.csv', sep='\t')
s = pd.read_csv('data/invasion_success_pathways.csv')

# A) Established urban vs progressive-change scenarios
n['isUrban'] = (n['habitat']=='Urban').astype(int)
n['urb_established'] = ((n['urban.2009.500m']>0.25) & (n['urban.1956.500m']>0.05)).astype(int)
print('Plots with established urban cover (>25% in 2009 & >5% in 1956, 500m):', n['urb_established'].sum())
for resp in ['n.gard','n.unint','n.agfo','n.total']:
    g = n.groupby('urb_established')[resp].mean()
    u = stats.mannwhitneyu(n.loc[n.urb_established==1,resp], n.loc[n.urb_established==0,resp], alternative='greater')
    print(resp, 'mean est=0:', round(g[0],3), ' est=1:', round(g[1],3), ' MannWhitney p(greater):', round(u.pvalue,5))

# progressive vs regressive vs no.changes groups (50m, 1956-2009)
n['traj'] = np.select(
    [n['progressive.1956.2009.50m']>=n[['regressive.1956.2009.50m','no.changes.1956.2009.50m']].max(axis=1),
     n['regressive.1956.2009.50m']>=n[['progressive.1956.2009.50m','no.changes.1956.2009.50m']].max(axis=1)],
    ['progressive','regressive'], default='no.changes')
print('\nTrajectory groups (50m 1956-2009):', n['traj'].value_counts().to_dict())
print(n.groupby('traj')[['n.gard','n.unint','n.agfo','n.total','urban.2009.500m']].mean().round(3).to_string())
kw = {c: stats.kruskal(*[g[c].values for _,g in n.groupby('traj')]) for c in ['n.unint','n.gard','n.total']}
print({k:(round(v.statistic,2),round(v.pvalue,5)) for k,v in kw.items()})

# B) Habitat composition chi-square over all 10 habitats (pathway x habitat, plot-level counts)
ct = n.groupby('habitat')[['n.gard','n.unint','n.agfo']].sum()
c2,p,d,e = stats.chi2_contingency(ct.values.T)
print('\nHabitat(10) x pathway chi2:', round(c2,2), 'p=', p, 'dof=', d)

# C) Top unintentional & gardening species by invaded plots
print('\nTop Unintentional species (invaded plots):')
print(s[s['intro.pathway']=='Unintentional'].nlargest(8,'number.of.invaded.plots')[['Scientific_name','family','growth.form','number.of.invaded.plots','habitat.range','invaded.niche.breadth','height']].to_string(index=False))
print('\nTop Gardening species:')
print(s[s['intro.pathway']=='Gardening'].nlargest(8,'number.of.invaded.plots')[['Scientific_name','family','growth.form','number.of.invaded.plots','habitat.range','invaded.niche.breadth','height']].to_string(index=False))

# D) Unintentional species traits summary (annual herbs?)
u = s[s['intro.pathway']=='Unintentional']
print('\nUnintentional growth.form shares:', (u['growth.form'].value_counts(normalize=True)*100).round(1).to_dict())
g = s[s['intro.pathway']=='Gardening']
print('Gardening growth.form shares:', (g['growth.form'].value_counts(normalize=True)*100).round(1).to_dict())

# E) Urban plots: per-plot pathway means and share of plots with >0 invaders
urb = n[n['habitat']=='Urban']
print('\nUrban plots (n=%d): mean per plot:'%len(urb), urb[['n.gard','n.unint','n.agfo','n.total']].mean().round(3).to_dict())
print('Urban plots with >=1 invader:', (urb['n.total']>0).sum(), '/', len(urb))
print('All plots with >=1 invader:', (n['n.total']>0).sum(), '/', len(n))

# ---------- Save supplement results ----------
import json
supp = {}
n['isUrban'] = (n['habitat']=='Urban').astype(int)
n['urb_established'] = ((n['urban.2009.500m']>0.25) & (n['urban.1956.500m']>0.05)).astype(int)
supp['established_urban_vs_rest_mean_counts'] = n.groupby('urb_established')[['n.gard','n.unint','n.agfo','n.total']].mean().round(3).to_dict('index')
n['traj'] = np.select(
    [n['progressive.1956.2009.50m']>=n[['regressive.1956.2009.50m','no.changes.1956.2009.50m']].max(axis=1),
     n['regressive.1956.2009.50m']>=n[['progressive.1956.2009.50m','no.changes.1956.2009.50m']].max(axis=1)],
    ['progressive','regressive'], default='no.changes')
supp['trajectory_groups_50m_1956_2009'] = n.groupby('traj')[['n.gard','n.unint','n.agfo','n.total','urban.2009.500m']].mean().round(3).to_dict('index')
ct = n.groupby('habitat')[['n.gard','n.unint','n.agfo']].sum()
c2,p,d,e = stats.chi2_contingency(ct.values.T)
supp['habitat10_x_pathway_chi2'] = {'chi2': round(float(c2),2), 'p': float(p), 'dof': int(d)}
u = s[s['intro.pathway']=='Unintentional']; g = s[s['intro.pathway']=='Gardening']
supp['growth_form_share_unintentional'] = (u['growth.form'].value_counts(normalize=True)*100).round(1).to_dict()
supp['growth_form_share_gardening'] = (g['growth.form'].value_counts(normalize=True)*100).round(1).to_dict()
supp['urban_plots'] = {'n_plots': int((n['habitat']=='Urban').sum()),
  'mean_per_plot': n[n['habitat']=='Urban'][['n.gard','n.unint','n.agfo','n.total']].mean().round(3).to_dict(),
  'plots_with_invader': int(((n['habitat']=='Urban')&(n['n.total']>0)).sum())}
supp['top_unintentional_species'] = u.nlargargest(8,'number.of.invaded.plots')[['Scientific_name','growth.form','number.of.invaded.plots']].to_dict('records') if False else u.nlargest(8,'number.of.invaded.plots')[['Scientific_name','growth.form','number.of.invaded.plots']].to_dict('records')
with open('outputs/results_supplement.json','w') as f: json.dump(supp,f,indent=1,default=str)
print('saved outputs/results_supplement.json')
