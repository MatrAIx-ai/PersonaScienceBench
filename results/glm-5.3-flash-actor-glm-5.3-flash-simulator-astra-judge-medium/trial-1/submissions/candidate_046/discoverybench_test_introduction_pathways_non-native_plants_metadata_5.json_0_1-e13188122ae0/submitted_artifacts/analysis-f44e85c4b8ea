# 8. phylogenetic robustness (optional): within-pathway patristic distance vs permutations
def parse_newick(s):
    s = s.strip().rstrip(";")
    pos = 0
    def node():
        nonlocal pos
        children = []
        if s[pos] == "(":
            pos += 1
            while True:
                children.append(node())
                if s[pos] == ",": pos += 1
                elif s[pos] == ")": pos += 1; break
        m = re.match(r"[^,():;]*", s[pos:]); name = m.group(0); pos += len(name)
        blen = 0.0
        m = re.match(r":([0-9.eE+-]+)", s[pos:])
        if m: blen = float(m.group(1)); pos += m.end()
        return {"name": name, "len": blen, "children": children}
    return node()

tree = parse_newick(open("data/phylogenetic_tree.txt").read())
paths = {}
def walk(nd, path):
    if not nd["children"]:
        paths[nd["name"]] = list(path)
    for ch in nd["children"]:
        walk(ch, path + [(id(nd), ch["len"])])
walk(tree, [])
leaves = list(paths)
idx = {n: i for i, n in enumerate(leaves)}
L = len(leaves)
D = np.zeros((L, L))
for i in range(L):
    for j in range(i + 1, L):
        a, b = paths[leaves[i]], paths[leaves[j]]
        k = 0
        while k < min(len(a), len(b)) and a[k][0] == b[k][0]: k += 1
        D[i, j] = D[j, i] = sum(x[1] for x in a[k:]) + sum(x[1] for x in b[k:])
print("\n=== PHYLO ROBUSTNESS (within-pathway mean patristic distance, 999 perms) ===")
rngp = np.random.default_rng(7)
rows = []
for pw in ["Gardening", "Unintentional", "AgriForest"]:
    sp_pw = species_unique.loc[species_unique["intro_pathway"] == pw,
                               "phylo_tip_label"].tolist()
    ii = [idx[s] for s in sp_pw if s in idx]
    tri = np.triu_indices(len(ii), 1)
    obs = D[np.ix_(ii, ii)][tri].mean()
    null = []
    for _ in range(999):
        pp = rngp.permutation(L)[:len(ii)]
        null.append(D[np.ix_(pp, pp)][tri].mean())
    pval = (np.sum(np.array(null) <= obs) + 1) / 1000
    rows.append({"pathway": pw, "k_species": len(ii),
                 "mean_within_patristic": round(float(obs), 1),
                 "null_mean": round(float(np.mean(null)), 1),
                 "p_clustered": round(float(pval), 3)})
    print(rows[-1])
pd.DataFrame(rows).to_csv(OUT + "phylo_permutation.csv", index=False)

