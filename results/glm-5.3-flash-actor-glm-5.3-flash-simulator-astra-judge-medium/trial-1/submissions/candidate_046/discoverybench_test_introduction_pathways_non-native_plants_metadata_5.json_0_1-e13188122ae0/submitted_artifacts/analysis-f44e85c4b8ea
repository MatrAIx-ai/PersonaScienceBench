# --------------------------------------------------- Firth penalized GLM
def expit(x):
    return 1.0 / (1.0 + np.exp(-np.clip(x, -30, 30)))

def firth_binom(X, y, m, max_iter=500, tol=1e-10):
    """Firth-penalized logistic regression for grouped binomial data.
    X: n x p design (no intercept column assumed included by caller),
    y: successes, m: trials. Returns beta, se (sqrt diag of I^{-1}), loglik."""
    n_, p_ = X.shape
    beta = np.zeros(p_)
    beta[0] = np.log((y.sum() + 0.5) / (m.sum() - y.sum() + 0.5))
    def loglik_pen(b):
        eta = X @ b; mu = expit(eta)
        ll = np.sum(y * np.log(mu + 1e-12) + (m - y) * np.log(1 - mu + 1e-12))
        return ll
    ll_old = loglik_pen(beta)
    for _ in range(max_iter):
        mu = expit(X @ beta)
        w = m * mu * (1 - mu)
        XtW = X.T * w
        I = XtW @ X
        Hinv = np.linalg.pinv(I)
        XHinv = X @ Hinv
        h = np.sum(X * XHinv, axis=1) * w          # hat diag
        U = X.T @ (y - m * mu)
        a = 0.5 * X.T @ ((1 - 2 * mu) * h)
        step = Hinv @ (U + a)
        # step halving
        t = 1.0
        for _ in range(40):
            cand = beta + t * step
            ll_new = loglik_pen(cand)
            if ll_new >= ll_old - 1e-10:
                break
            t /= 2
        beta = cand
        if np.max(np.abs(t * step)) < tol:
            ll_old = ll_new
            break
        ll_old = ll_new
    mu = expit(X @ beta)
    w = m * mu * (1 - mu)
    I = (X.T * w) @ X
    se = np.sqrt(np.diag(np.linalg.pinv(I)))
    return beta, se, ll_old

def build(rhs, data):
    X = patsy.dmatrix(rhs, data, return_type="dataframe")
    return np.asarray(X), list(X.columns)

def fit_report(rhs, data, ycol, mcol, label):
    X, names = build(rhs, data)
    beta, se, ll = firth_binom(X, data[ycol].values, data[mcol].values)
    z = beta / se
    p_w = 2 * stats.norm.sf(np.abs(z))
    # LRT p-values: refit without each term (drop whole block for C(...))
    lrt_p = []
    for j, nm in enumerate(names):
        keep = [k for k in range(len(names))
                if k == 0 or not (names[k].startswith(nm.split("[")[0]) and
                                  names[k].startswith("C("))]
        keep = sorted(set(keep) | {0})
        if j == 0:
            lrt_p.append(np.nan); continue
        if names[j].startswith("C("):
            keep = [k for k in range(len(names))
                    if not names[k].startswith("C(") or k == 0]
            keep = sorted(set(keep) | {0})
        else:
            keep = [k for k in range(len(names)) if k != j and k != 0]
            keep = sorted([0] + keep)
        if len(keep) == len(names):
            lrt_p.append(p_w[j]); continue
        _, _, ll0 = firth_binom(X[:, keep], data[ycol].values, data[mcol].values)
        lrt_p.append(stats.chi2.sf(max(2 * (ll - ll0), 0), 1))
    tab = pd.DataFrame({"coef": beta, "se": se, "z": z, "p_wald": p_w,
                        "p_LRT": lrt_p, "ci_low": beta - 1.96 * se,
                        "ci_high": beta + 1.96 * se}, index=names)
    tab.to_csv(OUT + f"firth_{label}.csv")
    return tab

