# 5. Moran's I of residuals (k=8 nearest neighbours, 199 permutations)
def morans_I(v, c, k=8):
    v = v - v.mean()
    d = np.hypot(c[:, 0][:, None] - c[:, 0][None, :],
                 c[:, 1][:, None] - c[:, 1][None, :])
    W = np.zeros((len(v), len(v)))
    for i in range(len(v)):
        W[i, np.argsort(d[i])[1:k + 1]] = 1.0
    W = ((W + W.T) > 0).astype(float)
    return (len(v) / W.sum()) * (v @ W @ v) / (v @ v)

print("\n=== SPATIAL AUTOCORRELATION (residual Moran's I, k=8 NN, 199 perms) ===")
for name in ["presence", "Gardening", "Unintentional", "AgriForest"]:
    if name == "presence":
        data, ycol, mcol = niche, "any_alien", "n_total"
    else:
        data, ycol, mcol = occ, f"n_{name[:4].lower() if name!='Unintentional' else 'unint'}", "n_total"
    if name == "Gardening": ycol = "n_gard"
    if name == "Unintentional": ycol = "n_unint"
    if name == "AgriForest": ycol = "n_agfo"
    X, _ = build(BASE, data)
    beta, _, _ = firth_binom(X, data[ycol].values, data[mcol].values)
    mu = expit(X @ beta)
    if name == "presence":
        res = data[ycol].values - mu
    else:
        res = data[ycol].values / data[mcol].values - mu  # Pearson-type residual
    cxy = data[["longitude", "latitude"]].values
    I = morans_I(res, cxy)
    null = np.array([morans_I(rng.permutation(res), cxy) for _ in range(199)])
    p = (np.sum(np.abs(null) >= abs(I)) + 1) / 200
    print(f"{name:14s} Moran's I = {I: .3f}  (perm. p = {p:.3f})")

