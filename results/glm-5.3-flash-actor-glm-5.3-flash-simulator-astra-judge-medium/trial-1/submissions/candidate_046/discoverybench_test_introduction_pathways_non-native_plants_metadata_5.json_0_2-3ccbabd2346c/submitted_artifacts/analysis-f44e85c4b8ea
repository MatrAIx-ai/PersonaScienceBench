"""
Urban land use and invasion of introduced plant types (Barcelona province / Catalonia).
Two levels: (A) plot-level - effect of urban land cover on presence/count of invaders
per introduction pathway; (B) species-level - characterization of plant types per
pathway and invasion success, with family/genus grouping.
"""
import itertools, re
import numpy as np
import pandas as pd
import statsmodels.api as sm
import statsmodels.formula.api as smf
from scipy import stats

pd.set_option('display.width', 200)

plots = pd.read_csv('data/invaded_niche_pathways.csv', sep=None, engine='python')
plots.columns = [c.replace('.','_') for c in plots.columns]
sp    = pd.read_csv('data/invasion_success_pathways.csv', sep=None, engine='python')
sp.columns = [c.replace('.','_') for c in sp.columns]
sp = sp.rename(columns={'number_of_invaded_plots':'n_invaded_plots'})
tt    = pd.read_csv('data/temporal_trends_contingency_table.csv', sep=None, engine='python')

# ---------------------------------------------------------------- sanity checks
print('=== SANITY ===')
print('plots rows/cols:', plots.shape, '| missing:', int(plots.isna().sum().sum()))
assert (plots['n_total'] == plots['n_gard']+plots['n_unint']+plots['n_agfo']).all()

plots['any_inv'] = (plots['n_total'] > 0).astype(int)
print('parcels with invaders:', plots['any_inv'].sum(), '/', len(plots))

# ---------------------------------------------------------------- temporal context
tt['pct'] = 100*tt['n']/tt.groupby('introduction.period')['n'].transform('sum')
print('\n=== TEMPORAL TRENDS (pct of period) ===')
print(tt.pivot(index='introduction.period', columns='pathway', values='pct').round(1))

# ---------------------------------------------------------------- SPECIES LEVEL (B)
print('\n=== SPECIES LEVEL: types per pathway ===')
ct = pd.crosstab(sp['intro_pathway'], sp['growth_form'])
print(ct)
chi2, p, dof, _ = stats.chi2_contingency(ct)
print(f'chi2(pathway x growth.form) = {chi2:.2f}, dof={dof}, p={p:.4g}')

# invasion success model: nb of invaded plots ~ pathway*growth.form + mrt + height
sp_model = sp.copy()
sp_model['log_mrt'] = np.log(sp_model['mrt'])
m_sp = smf.ols('n_invaded_plots ~ C(intro_pathway)*C(growth_form) + log_mrt + height',
               data=sp_model).fit()
print('\nOLS success ~ pathway*growth.form + log_mrt + height: R2=%.3f, n=%d' % (m_sp.rsquared, int(m_sp.nobs)))

# family/genus clustered SE (proxy for phylogenetic non-independence; no phylo tools available)
m_sp_c = m_sp.get_robustcov_results(cov_type='cluster', groups=sp_model.loc[m_sp.model.data.row_labels,'family'])
names = list(m_sp.params.index)
ps = list(m_sp_c.pvalues); ses = list(m_sp_c.bse)
sig = [(names[k], float(m_sp.params[names[k]]), float(ses[k]), float(ps[k]))
       for k in range(len(names)) if ps[k] < 0.05]
print('significant terms (family-clustered SE):')
for t, b, se, pv in sig: print(f'  {t}: beta={b:.3f}, SE={se:.3f}, p={pv:.4f}')

# niche breadth by pathway
print('\ninvaded.niche.breadth by pathway:')
print(sp.groupby('intro_pathway')[['invaded_niche_breadth','n_invaded_plots','mrt']].mean().round(2))
kw_p = stats.kruskal(*[g['invaded_niche_breadth'].values for _, g in sp.groupby('intro_pathway')])
print(f'Kruskal-Wallis niche breadth ~ pathway: H={kw_p.statistic:.2f}, p={kw_p.pvalue:.4f}')

# ---------------------------------------------------------------- PLOT LEVEL (A)
# main buffer 500 m (2009 cover = current; 1956 cover = historical), 50 m as sensitivity
plots['urban_now']   = plots['urban_2009_500m']
plots['urban_hist']  = plots['urban_1956_500m']
plots['cropl_now']   = plots['cropland_2009_500m']
plots['habitat']     = plots['habitat'].astype(str)

# correlation between urban change dummies and cover values (colinearity check)
print('\n=== colinearity of change dummies vs cover (500 m) ===')
chg = ['progressive_1956_2009_50m','regressive_1956_2009_50m','no_changes_1956_2009_50m']
for c in chg:
    print(c, 'corr with urban_now:', round(plots[c].corr(plots['urban_now']),3),
          '| with urban_hist:', round(plots[c].corr(plots['urban_hist']),3))

# A1: presence of any invader ~ urban cover (+ covariates)
cov = 'habitat + elevation + annual_temperature + annual_rainfall + distance_road + distance_stream'
for buf, tag in [('500m','MAIN 500m'), ('50m','SENS 50m')]:
    d = plots.copy()
    d['urban_now'] = d[f'urban_2009_{buf}']; d['urban_hist'] = d[f'urban_1956_{buf}']
    d['cropl_now'] = d[f'cropland_2009_{buf}']
    print(f'\n=== A1 presence-of-invaders logistic ({tag}) ===')
    m = smf.glm('any_inv ~ urban_now + urban_hist + cropl_now + ' + cov,
                data=d, family=sm.families.Binomial()).fit()
    print(f'OR urban_now={np.exp(m.params["urban_now"]):.2f} '
          f'[{np.exp(m.conf_int().loc["urban_now",0]):.2f},{np.exp(m.conf_int().loc["urban_now",1]):.2f}], '
          f'p={m.pvalues["urban_now"]:.4g}')
    print(f'OR urban_hist={np.exp(m.params["urban_hist"]):.2f}, p={m.pvalues["urban_hist"]:.3g}')
    m0 = smf.glm('any_inv ~ urban_now + urban_hist + cropl_now + elevation + annual_temperature + annual_rainfall + distance_road + distance_stream',
                 data=d, family=sm.families.Binomial()).fit()
    lrt = 2*(m.llf - m0.llf); dfd = int(m0.df_resid - m.df_resid)
    print('cropl_now p=%.3g | temp p=%.3g | habitat LRT chi2=%.1f (df=%d), p=%.3g' %
          (m.pvalues['cropl_now'], m.pvalues['annual_temperature'], lrt, dfd, stats.chi2.sf(lrt, dfd)))

# A2: pathway-specific conditional counts (given invaders present), Poisson w/ robust SE
sub = plots[plots['n_total'] > 0].copy()
print(f'\n=== A2 pathway-specific counts, conditional on n.total>0 (n={len(sub)}) ===')
res_tab = {}
for pw, col in [('Gardening','n_gard'), ('Unintentional','n_unint'), ('AgriForest','n_agfo')]:
    sub['y'] = sub[col]
    m = smf.glm('y ~ urban_now + urban_hist + cropl_now + ' + cov, data=sub,
                family=sm.families.Poisson()).fit(cov_type='HC1')
    irr = np.exp(m.params['urban_now'])
    ci = np.exp(m.conf_int().loc['urban_now'])
    res_tab[pw] = (irr, ci[0], ci[1], m.pvalues['urban_now'])
    print(f'{pw:14s} IRR(urban_now)={irr:.2f} [{ci[0]:.2f},{ci[1]:.2f}], p={m.pvalues["urban_now"]:.4g}; '
          f'urban_hist IRR={np.exp(m.params["urban_hist"]):.2f}, p={m.pvalues["urban_hist"]:.3g}')

# A3: composition across urbanization terciles (parcels with invaders)
sub['urb_terc'] = pd.qcut(sub['urban_now'], 3, labels=['low','mid','high'])
comp = sub.groupby('urb_terc', observed=True)[['n_gard','n_unint','n_agfo']].sum()
comp_pct = (100*comp.div(comp.sum(axis=1), axis=0)).round(1)
print('\n=== A3 composition of invaders by urbanization tercile (500 m, % of all invaders) ===')
print(comp); print(comp_pct)
print('mean urban_now by tercile:', sub.groupby('urb_terc', observed=True)['urban_now'].mean().round(3).to_dict())
# trend test: gardening share vs urbanization (Spearman on parcel shares)
sub['share_gard'] = sub['n_gard']/sub['n_total']
rho, pv = stats.spearmanr(sub['urban_now'], sub['share_gard'])
print(f'Spearman(urban_now, share_gardening | invaders present) rho={rho:.3f}, p={pv:.4g}')

# A4: urban habitat vs others (descriptive)
print('\nmean per-plot counts by habitat (top-5):')
print(sub.groupby('habitat')[['n_gard','n_unint','n_agfo','n_total']].mean().sort_values('n_total', ascending=False).round(2).head(5))

# A5: spatial autocorrelation check of A1 residuals (Moran's I, kNN ~ inverse distance weights)
d = plots.copy()
m1 = smf.glm('any_inv ~ urban_now + urban_hist + cropl_now + ' + cov, data=d,
             family=sm.families.Binomial()).fit()
resid = m1.resid_response.values
coords = d[['longitude','latitude']].values
n = len(coords)
# random-sample weights (500 random pairs, distance-decay) to keep cost low
rng = np.random.default_rng(0)
i_idx = rng.integers(0, n, 200000); j_idx = rng.integers(0, n, 200000)
dist = np.hypot(coords[i_idx,0]-coords[j_idx,0], coords[i_idx,1]-coords[j_idx,1])
keep = (dist > 0) & (dist < 5000)
w = 1.0/ (dist[keep] + 1)
num = (w * resid[i_idx[keep]] * resid[j_idx[keep]]).sum()
den = (resid**2).sum()
print(f"\nMoran-like I (random-pair, <5km, distance-decay): I={num/den:.4f} "
      f"(n_pairs={int(keep.sum())})")

print('\nDONE')

# ---------------------------------------------------------------- SUPPLEMENTARY CHECKS
print('\n=== SUPPLEMENTARY ===')
d = plots.copy()
d['urban_now'] = d['urban_2009_500m']; d['urban_hist'] = d['urban_1956_500m']
print('corr(urban_now, urban_hist) 500m:', round(d['urban_now'].corr(d['urban_hist']),3))

# 1000 m buffer as extra sensitivity
d['urban_now'] = d['urban_2009_1000m']; d['urban_hist'] = d['urban_1956_1000m']; d['cropl_now'] = d['cropland_2009_1000m']
m = smf.glm('any_inv ~ urban_now + urban_hist + cropl_now + ' + cov, data=d,
            family=sm.families.Binomial()).fit()
print('A1 1000m: OR urban_now=%.2f [%.2f,%.2f] p=%.3g' % (np.exp(m.params['urban_now']),
      *np.exp(m.conf_int().loc['urban_now']), m.pvalues['urban_now']))

# overdispersion check for A2 Poisson
sub = plots[plots['n_total'] > 0].copy()
sub['urban_now'] = sub['urban_2009_500m']; sub['urban_hist'] = sub['urban_1956_500m']
sub['cropl_now'] = sub['cropland_2009_500m']
for col in ['n_gard','n_unint','n_agfo']:
    print(f'{col}: mean={sub[col].mean():.2f}, var={sub[col].var():.2f}')

# formal composition test: pathway counts vs urban tercile
sub['urb_terc'] = pd.qcut(sub['urban_2009_500m'], 3, labels=['low','mid','high'])
tab = sub.groupby('urb_terc', observed=True)[['n_gard','n_unint','n_agfo']].sum()
chi2c, pc, dofc, _ = stats.chi2_contingency(tab.T)
print(f'composition (pathway x urban tercile) chi2={chi2c:.2f}, df={dofc}, p={pc:.4g}')
# pairwise: gardening share test
low, high = tab.loc['low'], tab.loc['high']
tbl = np.array([[low['n_gard'], low['n_unint']],[high['n_gard'], high['n_unint']]])
chi2g, pg, _, _ = stats.chi2_contingency(tbl)
print(f'gardening vs unintentional share, low vs high tercile: chi2={chi2g:.2f}, p={pg:.4g}')

# agriforest decline test
tbl2 = np.array([[low['n_agfo'], (low['n_gard']+low['n_unint']+low['n_agfo'])-low['n_agfo']],[high['n_agfo'], (high['n_gard']+high['n_unint']+high['n_agfo'])-high['n_agfo']]])
chi2a, pa, _, _ = stats.chi2_contingency(tbl2)
print(f'AgriForest share, low vs high tercile: chi2={chi2a:.2f}, p={pa:.4g}')

# species-level: invasive success of gardening shrub/tree vs others (median)
print('\nmedian n_invaded_plots by pathway x growth_form:')
print(sp.groupby(['intro_pathway','growth_form'])['n_invaded_plots'].median())
