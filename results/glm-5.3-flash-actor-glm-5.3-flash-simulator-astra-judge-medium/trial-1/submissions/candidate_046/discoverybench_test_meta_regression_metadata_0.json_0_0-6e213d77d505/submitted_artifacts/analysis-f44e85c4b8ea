"""Original vs replication effect sizes by domain (discipline).
Data: meta-regression_joined_data_heterogeneity_in_replication_projects.csv
Approved plan: paired Fisher-z differences + bootstrap CIs, sign tests,
relative_es/replicated summaries, project disaggregation (rpp vs ee),
sensitivity analysis excluding sign-inverted pairs.
"""
import pandas as pd, numpy as np
from scipy import stats

rng = np.random.default_rng(42)
df = pd.read_csv('data/meta-regression_joined_data_heterogeneity_in_replication_projects.csv', na_values=['NA',''])
df['diff_fis'] = df['fiso'] - df['fisr']
df['diff_ro_rr'] = df['ro'] - df['rr']
df['sign_flip'] = np.sign(df['ro']) != np.sign(df['rr'])
N_BOOT = 10000

def boot_ci(x, stat=np.mean, n=N_BOOT):
    x = np.asarray(x)
    idx = rng.integers(0, len(x), size=(n, len(x)))
    s = stat(x[idx], axis=1)
    return np.percentile(s, [2.5, 97.5])

def block(d, label):
    out = {'group': label, 'n': len(d)}
    for c in ['fiso','fisr','ro','rr']:
        out[f'mean_{c}'] = d[c].mean(); out[f'median_{c}'] = d[c].median()
    for c in ['diff_fis','diff_ro_rr']:
        m, md = d[c].mean(), d[c].median()
        lo, hi = boot_ci(d[c])
        w, p = stats.wilcoxon(d[c], alternative='greater', zero_method='wilcox')
        out.update({f'mean_{c}': m, f'median_{c}': md, f'ci_lo_{c}': lo, f'ci_hi_{c}': hi,
                    f'wilcoxon_p_{c}': p})
    out['pct_ro_gt_rr'] = (d['diff_ro_rr'] > 0).mean()
    k = (d['diff_ro_rr'] > 0).sum()
    out['sign_test_p'] = stats.binomtest(k, len(d), 0.5, alternative='greater').pvalue
    out['mean_relative_es'] = d['relative_es'].mean()
    out['median_relative_es'] = d['relative_es'].median()
    out['replicated_rate'] = d['replicated'].mean()
    return pd.Series(out)

def report(d, title):
    res = pd.DataFrame([block(d[d['discipline']==g], g) for g in sorted(d['discipline'].unique())] +
                       [block(d[d['project.y']==g], g) for g in sorted(d['project.y'].unique())])
    cols_show = ['group','n','mean_fiso','mean_fisr','mean_diff_fis','ci_lo_diff_fis','ci_hi_diff_fis',
                 'median_diff_fis','wilcoxon_p_diff_fis','pct_ro_gt_rr','sign_test_p',
                 'mean_relative_es','median_relative_es','replicated_rate']
    print(f"\n===== {title} =====")
    print(res[cols_show].round(4).to_string(index=False))
    return res

main = report(df, "MAIN ANALYSIS: by discipline (primary) and by replication project (disaggregation)")

# Weighted fixed-effect contrast (variance weighting on Fisher-z difference)
print("\n===== Weighted fixed-effect mean of (fiso - fisr) by discipline =====")
for g in sorted(df['discipline'].unique()):
    d = df[df['discipline']==g]
    v = d['se_fiso']**2 + d['se_fisr']**2
    w = 1/v
    wm = np.average(d['diff_fis'], weights=w)
    se = np.sqrt(1/w.sum())
    print(f"{g:10s} n={len(d):3d} weighted_mean={wm:.3f} SE={se:.3f} z={wm/se:.2f} "
          f"p={2*stats.norm.sf(abs(wm/se)):.4f}")

# Sensitivity: exclude sign-inverted pairs
sens = report(df[~df['sign_flip']], "SENSITIVITY: excluding 18 sign-inverted pairs")
flipped = report(df[df['sign_flip']], "SIGN-INVERTED PAIRS ONLY (n=18)")

# Compare with vs without
print("\n===== Sensitivity comparison (mean diff_fis / pct ro>rr) =====")
for g in sorted(df['discipline'].unique()):
    a = df[(df['discipline']==g)]; b = df[(df['discipline']==g) & (~df['sign_flip'])]
    print(f"{g:10s} all: mean={a['diff_fis'].mean():+.3f} pct_ro>rr={100*(a['diff_ro_rr']>0).mean():.1f}% (n={len(a)}) | "
          f"no-flip: mean={b['diff_fis'].mean():+.3f} pct_ro>rr={100*(b['diff_ro_rr']>0).mean():.1f}% (n={len(b)})")

# Cross-discipline pairwise comparisons of diff_fis (Mann-Whitney)
print("\n===== Cross-discipline comparison of diff_fis (Mann-Whitney U) =====")
gs = sorted(df['discipline'].unique())
for i in range(len(gs)):
    for j in range(i+1, len(gs)):
        a = df.loc[df['discipline']==gs[i],'diff_fis']; b = df.loc[df['discipline']==gs[j],'diff_fis']
        u, p = stats.mannwhitneyu(a, b, alternative='two-sided')
        print(f"{gs[i]} vs {gs[j]}: U={u:.0f}, p={p:.4f}")

# Cross-tab discipline x project
print("\n===== discipline x project.y crosstab =====")
print(pd.crosstab(df['discipline'], df['project.y']).to_string())

# Save outputs
main.to_csv('analysis/main_results_by_discipline_and_project.csv', index=False)
sens.to_csv('analysis/sensitivity_no_signflip.csv', index=False)
flipped.to_csv('analysis/signflip_pairs_only.csv', index=False)
df.to_csv('analysis/data_with_derived_columns.csv', index=False)
print("\nSaved: analysis/main_results_by_discipline_and_project.csv, sensitivity_no_signflip.csv, signflip_pairs_only.csv, data_with_derived_columns.csv")
