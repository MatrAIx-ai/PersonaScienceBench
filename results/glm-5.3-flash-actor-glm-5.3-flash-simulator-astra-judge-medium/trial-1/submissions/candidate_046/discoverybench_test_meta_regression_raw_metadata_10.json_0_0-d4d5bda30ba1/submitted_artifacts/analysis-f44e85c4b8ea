"""DiscoveryBench metadata_10: Proportion of junior professors in replicated studies in Psychology.

Primary definition: junior professor = seniority.r == "Assistant Professor".
Subset: project == "rpp" (Psychology), replicated == 1, excluding drop == True.
Proportion = (# replicated rows with Assistant Professor as most senior replication author)
             / (# replicated rows in rpp).
"""
import pandas as pd

df = pd.read_csv("data/meta-regression_study_data_heterogeneity_in_replication_projects.csv")
rpp = df[df["project"] == "rpp"].copy()

# sanity checks
assert rpp["id"].is_unique, "rpp ids must be unique (no lab-level duplication)"
assert rpp["seniority.r"].notna().all(), "seniority.r must be complete in rpp"
# verify `replicated` == (p<=0.05 AND same-sign effect) where data are complete
m = rpp.dropna(subset=["effect_size.o", "effect_size.r", "p_value.r"])
assert (((m["p_value.r"] <= 0.05) & (m["effect_size.o"] * m["effect_size.r"] > 0)).astype(float)
        == m["replicated"]).all(), "replicated column inconsistent"

BROAD = ["Assistant Professor", "Assistant", "Researcher"]

def proportion(sub, label):
    rep = sub[sub["replicated"] == 1]
    n = len(rep)
    strict = int((rep["seniority.r"] == "Assistant Professor").sum())
    broad = int(rep["seniority.r"].isin(BROAD).sum())
    print(f"{label}: replicated n={n}")
    print(f"  strict (Assistant Professor): {strict}/{n} = {strict/n:.4f} ({100*strict/n:.1f}%)")
    print(f"  broad  (AP+Assistant+Researcher): {broad}/{n} = {broad/n:.4f} ({100*broad/n:.1f}%)")
    print(f"  breakdown: {rep['seniority.r'].value_counts().to_dict()}")
    return strict, n

print("=== PRIMARY: rpp, replicated==1, drop==False ===")
strict, n = proportion(rpp[rpp["drop"] == False], "primary")
print(f"\nPRIMARY ANSWER: {strict}/{n} = {strict/n:.4f} (~{100*strict/n:.0f}%)\n")

print("=== SENSITIVITY 1: all rpp rows (drop not excluded) ===")
proportion(rpp, "all-rpp")

print("\n=== SENSITIVITY 2 diagnostics ===")
rep = rpp[(rpp["drop"] == False) & (rpp["replicated"] == 1)]
print("missing effect_size.r among primary replicated:", rep["effect_size.r"].isna().sum())
print("missing effect_size.o among primary replicated:", rep["effect_size.o"].isna().sum())
print("recomputed criterion matches on all", len(rep), "primary replicated rows")

print("\nNumerator rows (Assistant Professor, replicated, drop==False):")
print(rep[rep["seniority.r"] == "Assistant Professor"]
      [["id", "seniority.r", "p_value.r", "effect_size.r", "effect_size.o"]].to_string(index=False))
