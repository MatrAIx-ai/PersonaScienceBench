"""
Analysis: In which domain (discipline) did both original and replication studies
primarily use student subjects (quoted: original 82.4%, replication 80.9%)?

Data: data/meta-regression_study_data_heterogeneity_in_replication_projects.csv
(main source). The second CSV lacks subjects/discipline columns and is used only
for project-name cross-checking.

Unit decisions (approved by researcher):
- Main unit = one row per pair id (deduplicate). Prefer the 'aggregated'==True
  row when present, else the first row.
- Row-level (lab-level) analysis as sensitivity; explicit sensitivity for the
  16 ids whose subjects.r varies across labs, and for the 10 ids entirely
  drop==True; row rpp.154 (both subjects missing) handled explicitly.
- 'students' is the numerator; 'anyone', 'community', 'online' and NaN count
  as non-students in the denominator.
"""
import pandas as pd

DATA = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
DATA2 = "data/meta-regression_replication_success_data_heterogeneity_in_replication_projects.csv"

df = pd.read_csv(DATA)
print("=" * 70)
print("A. DATA OVERVIEW")
print("=" * 70)
print(f"study file rows: {len(df)}, unique pair ids: {df['id'].nunique()}")
print("rows by project:", dict(df['project'].value_counts()))
print("unique ids by project:", dict(df.groupby('project')['id'].nunique()))
print("missing: subjects.o =", df['subjects.o'].isna().sum(),
      "; subjects.r =", df['subjects.r'].isna().sum(),
      "; discipline =", df['discipline'].isna().sum(),
      "; project =", df['project'].isna().sum())

# consistency checks
g = df.groupby('id')
print("ids with >1 distinct subjects.o:", int((g['subjects.o'].nunique(dropna=False) > 1).sum()))
ids_var_r = g['subjects.r'].nunique(dropna=False)
ids_var_r = ids_var_r[ids_var_r > 1]
print("ids with >1 distinct subjects.r:", len(ids_var_r), "->", list(ids_var_r.index))
ids_all_drop = df.groupby('id')['drop'].agg('min')
ids_all_drop = ids_all_drop[ids_all_drop].index
print("ids entirely drop==True:", len(ids_all_drop), "->", list(ids_all_drop))
print("row with missing subjects:", df.loc[df['subjects.o'].isna() |
      df['subjects.r'].isna(), ['id','project','discipline','subjects.o','subjects.r','drop']].to_dict('records'))

def pct_students(d):
    so = (d['subjects.o'] == 'students').sum(); no = d['subjects.o'].notna().sum()
    sr = (d['subjects.r'] == 'students').sum(); nr = d['subjects.r'].notna().sum()
    return pd.Series({'n_pairs': len(d),
                      'n_students_o': so, 'n_valid_o': no, 'pct_students_o': so / no,
                      'n_students_r': sr, 'n_valid_r': nr, 'pct_students_r': sr / nr})

print()
print("=" * 70)
print("B. MAIN ANALYSIS - one row per pair id (aggregated row preferred)")
print("=" * 70)
def pick(sub):
    agg = sub[sub['aggregated'] == True]
    return agg.iloc[0:1] if len(agg) else sub.iloc[0:1]
pair = pd.concat([pick(s) for _, s in df.groupby('id')], ignore_index=True)
assert len(pair) == 141

main = pair.groupby('discipline').apply(pct_students, include_groups=False)
print(main.round(4).to_string())
overall = pct_students(pair)
print("\nOVERALL pair-level: o = %.4f (%d/%d), r = %.4f (%d/%d)"
      % (overall['pct_students_o'], overall['n_students_o'], overall['n_valid_o'],
         overall['pct_students_r'], overall['n_students_r'], overall['n_valid_r']))

print()
print("=" * 70)
print("C. SENSITIVITY 1 - row (lab) level, all 927 rows")
print("=" * 70)
row = df.groupby('discipline').apply(pct_students, include_groups=False)
print(row.round(4).to_string())
ovr = pct_students(df)
print("\nOVERALL row-level: o = %.4f, r = %.4f" % (ovr['pct_students_o'], ovr['pct_students_r']))

print()
print("=" * 70)
print("D. SENSITIVITY 2 - exclude the 10 ids entirely drop==True (pair level)")
print("=" * 70)
pair2 = pair[~pair['id'].isin(ids_all_drop)]
s2 = pair2.groupby('discipline').apply(pct_students, include_groups=False)
print(f"(n pairs = {len(pair2)})")
print(s2.round(4).to_string())

print()
print("=" * 70)
print("E. SENSITIVITY 3 - the 16 ids where subjects.r varies across labs")
print("=" * 70)
var_r = df[df['id'].isin(list(ids_var_r.index))].groupby('id')['subjects.r'].apply(
    lambda s: sorted(set(s.dropna().tolist())))
for i, v in var_r.items():
    print(i, v)
print('subjects.r of the aggregated rows for these ids:')
print(df[(df['aggregated'] == True) & (df['id'].isin(list(ids_var_r.index)))]['subjects.r'].value_counts().to_string())

print()
print("Cross-check of project naming in second CSV (informational only):")
d2 = pd.read_csv(DATA2)
print(d2['project'].value_counts().to_string())

main.round(4).to_csv("outputs/students_by_discipline_pair_level.csv")
row.round(4).to_csv("outputs/students_by_discipline_row_level.csv")
print("\nSaved: outputs/students_by_discipline_pair_level.csv, "
      "outputs/students_by_discipline_row_level.csv")

print()
print("=" * 70)
print("F. JOINT MEASURE - % of pairs where BOTH o and r used students")
print("=" * 70)
both = (pair['subjects.o'] == 'students') & (pair['subjects.r'] == 'students')
joint = pair.assign(both=both).groupby('discipline')['both'].agg(['sum', 'count', 'mean'])
print(joint.round(4).to_string())
print('\nDistance to quoted figures (82.4% o / 80.9% r), per discipline:')
for name, tbl, cols in [('pair-level', main, ('pct_students_o', 'pct_students_r')),
                        ('row-level', row, ('pct_students_o', 'pct_students_r'))]:
    for d in tbl.index:
        dist = abs(tbl.loc[d, cols[0]] * 100 - 82.4) + abs(tbl.loc[d, cols[1]] * 100 - 80.9)
        print(f'  {name} {d}: {dist:.1f} pp')
