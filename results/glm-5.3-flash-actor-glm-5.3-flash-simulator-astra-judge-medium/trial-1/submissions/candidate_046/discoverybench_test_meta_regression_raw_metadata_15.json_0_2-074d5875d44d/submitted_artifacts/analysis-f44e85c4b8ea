"""
Question: What proportion of original studies in Experimental Economics
were conducted in the United Kingdom?

Approach (approved):
- Dataset: data/meta-regression_study_data_heterogeneity_in_replication_projects.csv
- Subset: project == 'ee' (Experimental Economics replication project)
- Level: unique original study, identified by 'id' (one row per O/R pair)
- Numerator: unique 'ee' studies with experiment_country.o == 'United Kingdom'
- Denominator: total unique 'ee' ids (18)
- Defensive steps: deduplicate by 'id', drop rows flagged drop==True,
  report missing/ambiguous country values separately.
"""
import pandas as pd

DATA = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
UK = "United Kingdom"

df = pd.read_csv(DATA)
print(f"Total rows in file: {len(df)}; columns: {len(df.columns)}")

ee = df[df["project"] == "ee"].copy()
print(f"Rows in project 'ee': {len(ee)}")

# Defensive deduplication by unique O/R pair id and removal of dropped rows
before = len(ee)
ee = ee[ee["drop"] != True]          # no rows dropped in ee (verified: 0)
ee = ee.drop_duplicates(subset="id") # no duplicates in ee (verified: 18->18)
print(f"After drop-filter and dedup by id: {len(ee)} (was {before})")

# Country distribution of original experiments
print("\nexperiment_country.o distribution (ee):")
print(ee["experiment_country.o"].value_counts(dropna=False).to_string())

n_missing = ee["experiment_country.o"].isna().sum()
n_studies = ee["id"].nunique()
n_uk = int((ee["experiment_country.o"] == UK).sum())

proportion = n_uk / n_studies
print(f"\nUnique original studies (denominator): {n_studies}")
print(f"Missing experiment_country.o: {n_missing}")
print(f"Original studies conducted in the United Kingdom (numerator): {n_uk}")
print(f"Proportion: {n_uk}/{n_studies} = {proportion:.4f} ({proportion*100:.1f}%)")

uk_rows = ee.loc[ee["experiment_country.o"] == UK,
                 ["id", "title", "pub_year", "journal", "experiment_country.o"]]
print("\nUK original study/studies:")
print(uk_rows.to_string(index=False))

# Sensitivity: denominator excluding missing-country rows (same result here)
den_excl = ee["experiment_country.o"].notna().sum()
print(f"\nSensitivity check (denominator excluding missing country): "
      f"{n_uk}/{den_excl} = {n_uk/den_excl:.4f}")

result = {
    "ee_rows": int(len(ee)),
    "unique_original_studies": int(n_studies),
    "uk_original_studies": n_uk,
    "missing_country": int(n_missing),
    "proportion": round(proportion, 4),
    "proportion_pct": round(proportion * 100, 1),
}
print("\nRESULT:", result)
