import pandas as pd

PATH = 'data/meta-regression_study_data_heterogeneity_in_replication_projects.csv'
df = pd.read_csv(PATH)

# --- Unit of analysis: unique original studies in project 'ee' (Experimental Economics) ---
ee = df[df['project'] == 'ee'].copy()
assert ee['id'].is_unique, "ee ids not unique"
assert len(ee) == 18
assert ee['drop'].eq(False).all()
assert ee[['online.o', 'online.r', 'subjects.o', 'subjects.r', 'us_lab.o']].notna().all().all()

# Primary: proportion of original studies conducted in a lab (online.o == 0)
n = len(ee)
lab_orig = int((ee['online.o'] == 0).sum())
online_orig = n - lab_orig

# Secondary 1: same for replications (online.r == 0)
lab_rep = int((ee['online.r'] == 0).sum())
online_rep = n - lab_rep

# Secondary 2: cross-tab online.o x online.r
cross = pd.crosstab(ee['online.o'], ee['online.r'], dropna=False)

# Secondary 3: descriptive corroboration
subj = ee['subjects.o'].value_counts(dropna=False)
us_lab = ee['us_lab.o'].value_counts(dropna=False)
cross_subj_online = pd.crosstab(ee['subjects.o'], ee['online.o'])

print(f"Primary (originals): lab {lab_orig}/{n} = {100*lab_orig/n:.1f}%")
print(f"Secondary (replications): lab {lab_rep}/{n} = {100*lab_rep/n:.1f}%")
print("\nCross-tab online.o x online.r:\n", cross)
print("\nsubjects.o counts:\n", subj)
print("\nus_lab.o counts:\n", us_lab)
print("\nsubjects.o x online.o:\n", cross_subj_online)
print("\nee.4 check (subjects=community):")
print(ee.loc[ee['id'] == 'ee.4', ['id', 'title', 'online.o', 'subjects.o', 'us_lab.o']].to_string(index=False))

# Save supporting table
out = ee[['id', 'title', 'pub_year', 'online.o', 'online.r', 'subjects.o', 'subjects.r',
          'us_lab.o', 'experiment_country.o']].copy()
out['lab_original'] = (out['online.o'] == 0).astype(int)
out['lab_replication'] = (out['online.r'] == 0).astype(int)
out.to_csv('ee_lab_proportion_table.csv', index=False)
