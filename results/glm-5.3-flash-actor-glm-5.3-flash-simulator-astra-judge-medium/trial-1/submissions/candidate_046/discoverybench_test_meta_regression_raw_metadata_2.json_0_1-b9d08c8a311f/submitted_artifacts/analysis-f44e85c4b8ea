"""Average length of original papers: Experimental Economics (ee) vs Psychology (rpp).
Data: meta-regression_study_data_heterogeneity_in_replication_projects.csv
Unit of analysis: original paper (dedup by title for rpp; ee has 1 row per paper).
"""
import pandas as pd

df = pd.read_csv("data/meta-regression_study_data_heterogeneity_in_replication_projects.csv")

def stats(s: pd.Series) -> dict:
    return {"n": int(s.size), "mean": round(s.mean(), 2), "median": s.median(),
            "sd": round(s.std(ddof=1), 2), "min": int(s.min()), "max": int(s.max())}

# ---- Experimental Economics (ee): 18 rows, 18 unique ids/titles, no dedup needed
ee = df[df["project"] == "ee"]
assert ee["id"].nunique() == len(ee) == ee["title"].nunique() == 18
ee_stats = stats(ee["length"])

# ---- Psychology (rpp): dedup by title (primary), row-level (check)
rpp = df[df["project"] == "rpp"]
rpp_dedup = rpp.drop_duplicates(subset="title")
assert (rpp.groupby("title")["length"].nunique() == 1).all()  # length constant within each title
rpp_stats_dedup = stats(rpp_dedup["length"])
rpp_stats_rows = stats(rpp["length"])

print("Experimental Economics (ee), article-level:")
print(ee_stats)
print("Psychology (rpp), article-level (dedup by title):")
print(rpp_stats_dedup)
print("Psychology (rpp), row-level check (n=97):")
print(rpp_stats_rows)
print("Rows dropped by dedup:", len(rpp) - len(rpp_dedup))
print("Absolute change in rpp mean due to dedup:",
      round(abs(rpp_stats_dedup["mean"] - rpp_stats_rows["mean"]), 4), "pages")
print("Difference in means (ee - rpp):",
      round(ee_stats["mean"] - rpp_stats_dedup["mean"], 2), "pages")
