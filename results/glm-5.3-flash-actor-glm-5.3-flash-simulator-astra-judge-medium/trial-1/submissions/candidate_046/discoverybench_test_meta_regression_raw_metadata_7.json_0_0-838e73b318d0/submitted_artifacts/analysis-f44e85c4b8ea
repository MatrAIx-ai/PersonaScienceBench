"""
Question: In which domain do the majority of authors tend to be male
for both original and replication studies?

Approved workflow:
  1. Deduplicate by 'id' before aggregating to discipline level.
  2. authors_male.o: single value per id (verified constant).
  3. authors_male.r: mean over replication labs within the same id.
  4. "Majority male" = proportion strictly > 0.5 (exact tie does not count).
  5. Answer criterion: discipline where BOTH proportions (o and r) exceed 0.5.
  6. Robustness: row-level (per-lab) aggregation and % of teams majority-male.
"""
import pandas as pd

SRC = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
df = pd.read_csv(SRC)
print(f"Loaded {SRC}: shape={df.shape}")
assert df["authors_male.o"].notna().all() and df["authors_male.r"].notna().all()

# --- Diagnostics -------------------------------------------------------------
print("\n[diagnostic] rows per id:")
print(df.groupby("id").size().value_counts().sort_index())
print("\n[diagnostic] authors_male.o constant within id:",
      (df.groupby("id")["authors_male.o"].nunique() == 1).all())

# --- Main aggregation: id-level (deduplicated) -------------------------------
g = (df.groupby(["discipline", "id"])
       .agg(mo=("authors_male.o", "first"),          # constant per id
            mr=("authors_male.r", "mean"))           # mean across labs
       .reset_index())
main = g.groupby("discipline").agg(
    n_ids=("id", "nunique"),
    mean_m_o=("mo", "mean"), mean_m_r=("mr", "mean"),
    pct_majority_o=("mo", lambda s: (s > 0.5).mean()),
    pct_majority_r=("mr", lambda s: (s > 0.5).mean()))
main["majority_both"] = (main.mean_m_o > 0.5) & (main.mean_m_r > 0.5)
print("\n[MAIN] id-level (deduplicated) aggregation:")
print(main.round(4).to_string())

# --- Robustness A: row-level (per lab) ---------------------------------------
row = df.groupby("discipline").agg(
    n_rows=("id", "size"),
    mean_m_o=("authors_male.o", "mean"), mean_m_r=("authors_male.r", "mean"))
row["majority_both"] = (row.mean_m_o > 0.5) & (row.mean_m_r > 0.5)
print("\n[ROBUST-A] row-level (per lab) aggregation:")
print(row.round(4).to_string())

# --- Robustness B: % of teams majority-male, id-level ------------------------
rob_b = (g.assign(o_maj=g.mo > 0.5, r_maj=g.mr > 0.5)
          .groupby("discipline")[["o_maj", "r_maj"]].mean())
rob_b.columns = ["pct_teams_majority_o", "pct_teams_majority_r"]
rob_b["majority_both"] = (rob_b.pct_teams_majority_o > 0.5) & (rob_b.pct_teams_majority_r > 0.5)
print("\n[ROBUST-B] share of O/R pairs with majority-male team (id-level):")
print(rob_b.round(4).to_string())

# --- Agreement across approaches ---------------------------------------------
print("\n[AGREEMENT] majority_both across MAIN / ROBUST-A / ROBUST-B:")
for d in main.index:
    print(f"  {d:10s}: main={main.loc[d,'majority_both']}  row-level={row.loc[d,'majority_both']}  "
          f"pct-teams={rob_b.loc[d,'majority_both']}  (n_ids={main.loc[d,'n_ids']:.0f})")

winners = [d for d in main.index
           if main.loc[d, "majority_both"] and row.loc[d, "majority_both"]
           and rob_b.loc[d, "majority_both"]]
print(f"\nDisciplines passing BOTH-sides criterion under all three aggregations: {winners}")

main.round(4).to_csv("output/main_id_level_aggregation.csv")
row.round(4).to_csv("output/robust_row_level_aggregation.csv")
rob_b.round(4).to_csv("output/robust_pct_teams_id_level.csv")
print("\nOutputs written to output/")
