"""DiscoveryBench: demographic disparities in median 1985 wealth among ever incarcerated (NLSY79)."""
import pandas as pd

df = pd.read_csv("data/nls_incarceration_processed.csv")

# Normalize documented typo: 'hipanic' -> 'hispanic'
df["race"] = df["race"].replace({"hipanic": "hispanic"})

W = "composite_wealth_1985"
jail = df[df["ever_jailed"] == 1].copy()
nojail = df[df["ever_jailed"] == 0]

def summarize(g, col):
    return pd.Series({
        "n": len(g),
        "median": g[col].median(),
        "q25": g[col].quantile(.25),
        "q75": g[col].quantile(.75),
        "mean": g[col].mean(),
        "pct_le0": 100 * (g[col] <= 0).mean(),
        "n_negative": (g[col] < 0).sum(),
        "min": g[col].min(),
        "max": g[col].max(),
    })

rows = {"ALL ever_jailed=1": summarize(jail, W)}
for race in ["white", "black", "hispanic"]:
    rows[race] = summarize(jail[jail["race"] == race], W)
for sex in ["male", "female"]:
    rows[sex] = summarize(jail[jail["sex"] == sex], W)
for race in ["white", "black", "hispanic"]:
    for sex in ["male", "female"]:
        rows[f"{race} x {sex}"] = summarize(jail[(jail["race"] == race) & (jail["sex"] == sex)], W)
rows["CONTEXT: ever_jailed=0"] = summarize(nojail, W)
rows["CONTEXT: full sample"] = summarize(df, W)

tab = pd.DataFrame(rows).T.round(1)
print(tab.to_string())

flag = tab.loc["hispanic x female"]
print(f"\nFLAG: hispanic x female n={int(flag['n'])} -> unreliable cell (small sample).")
print(f"Context line: median wealth 1985 ever_jailed=1 = {rows['ALL ever_jailed=1']['median']} "
      f"vs ever_jailed=0 = {rows['CONTEXT: ever_jailed=0']['median']} USD.")
print(f"Overall % wealth<=0 among jailed: {rows['ALL ever_jailed=1']['pct_le0']:.1f}%")
tab.to_csv("artifacts/median_wealth_1985_summary.csv")
