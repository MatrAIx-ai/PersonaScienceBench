"""NLS incarceration & wealth: effect on Black respondents by initial SES stratum.

Approved plan: stratify Black respondents by 1985 composite wealth terciles
(proxy for income level), compare wealth changes 1985->1990 and 1985->1996
between ever_jailed=1 and ever_jailed=0, with cell sizes, medians and
winsorized means, plus an OLS with ever_jailed x tercile interaction and sex
control. Descriptive, not causal. 1996 is the main post-treatment contrast.
"""
import numpy as np
import pandas as pd
import statsmodels.formula.api as smf

pd.set_option("display.width", 200)
pd.set_option("display.max_columns", 50)

df = pd.read_csv("data/nls_incarceration_processed.csv")
W = ["composite_wealth_1985", "composite_wealth_1990", "composite_wealth_1996"]

# ---- winsorize helper (1%/99% within group of interest, applied to changes)
def winsor(s, lo=0.01, hi=0.99):
    return s.clip(s.quantile(lo), s.quantile(hi))

# ================= BLACK FOCUS =================
b = df[df.race == "black"].copy()

# terciles of baseline (1985) wealth
b["tercile"] = pd.qcut(b["composite_wealth_1985"], 3, labels=["T1_low", "T2_mid", "T3_high"])
print("Tercile boundaries (1985 wealth, black):")
print(b.groupby("tercile", observed=True)["composite_wealth_1985"].agg(["min", "max", "count"]))

# changes
for yr in (1990, 1996):
    b[f"delta_{yr}"] = b[f"composite_wealth_{yr}"] - b["composite_wealth_1985"]

rows = []
for t in ["T1_low", "T2_mid", "T3_high"]:
    sub = b[b.tercile == t]
    for j in (0, 1):
        g = sub[sub.ever_jailed == j]
        for yr in (1990, 1996):
            d, dw = g[f"delta_{yr}"], winsor(g[f"delta_{yr}"])
            rows.append({
                "tercile": t, "ever_jailed": j, "n": len(g),
                "year": yr,
                "median_delta": d.median(),
                "mean_delta_wins": dw.mean(),
                "median_w_end": g[f"composite_wealth_{yr}"].median(),
                "mean_w_end_wins": winsor(g[f"composite_wealth_{yr}"]).mean(),
            })
tab = pd.DataFrame(rows)
print("\n=== Wealth change (1985 baseline) by tercile x jail status, BLACK ===")
print(tab.to_string(index=False,
      formatters={"median_delta": "{:,.0f}".format, "mean_delta_wins": "{:,.0f}".format,
                  "median_w_end": "{:,.0f}".format, "mean_w_end_wins": "{:,.0f}".format}))

# relative change vs baseline median per tercile (context)
base_med = b.groupby("tercile", observed=True)["composite_wealth_1985"].median()
print("\nBaseline 1985 median wealth by tercile:\n", base_med.to_string())

# median delta differences (non-jailed minus jailed) per tercile/year
piv = tab.pivot_table(index=["tercile", "year"], columns="ever_jailed",
                      values="median_delta")
piv["gap_median"] = piv[0] - piv[1]
print("\n=== Gap in median wealth change (non-jailed minus jailed), BLACK ===")
print(piv[["gap_median"]].to_string(float_format="{:,.0f}".format))

# ============ OLS: interaction ever_jailed x tercile, control sex ============
b["jailed"] = b.ever_jailed
b["male"] = (b.sex == "male").astype(int)
for yr in (1990, 1996):
    b[f"dw{yr}"] = winsor(b[f"delta_{yr}"])
m90 = smf.ols("dw1990 ~ jailed * C(tercile, Treatment('T1_low')) + male", data=b).fit()
m96 = smf.ols("dw1996 ~ jailed * C(tercile, Treatment('T1_low')) + male", data=b).fit()
print("\n=== OLS dw1996 ~ jailed x tercile + male (BLACK, winsorized change) ===")
print(m96.summary().tables[1])
print("\n=== OLS dw1990 ~ jailed x tercile + male ===")
print(m90.summary().tables[1])

# ============ brief race context (optional, 1996 only) ============
print("\n=== Race context (brief): median wealth by race x jailed, 1985 & 1996 ===")
ctx = df.groupby(["race", "ever_jailed"])[["composite_wealth_1985", "composite_wealth_1996"]].median()
ctx["n"] = df.groupby(["race", "ever_jailed"]).size()
print(ctx.to_string(float_format="{:,.0f}".format))
ctx_mean = df.groupby(["race", "ever_jailed"])[["composite_wealth_1985", "composite_wealth_1996"]].agg(
    lambda s: winsor(s).mean())
print("\nWinsorized means:")
print(ctx_mean.to_string(float_format="{:,.0f}".format))
