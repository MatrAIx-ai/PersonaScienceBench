"""Análisis principal: ¿entre qué años ocurrió el mayor aumento de la mediana
de riqueza entre mujeres negras (race=black, sex=female)?
Primario: sin duplicados. Sensibilidades: con duplicados, clip negativos a 0,
exclusión de negativos. Bootstrap 5,000 réplicas (misma muestra dentro de cada
réplica para los tres años, preservando la estructura de panel).
"""
import pandas as pd, numpy as np

W = ['composite_wealth_1985','composite_wealth_1990','composite_wealth_1996']
df = pd.read_csv('data/nls_incarceration_processed.csv')
n_dup = df.duplicated().sum()
print(f"filas totales: {len(df)}; duplicados exactos: {n_dup}")

def analyze(data, label):
    bf = data[(data.race=='black') & (data.sex=='female')]
    m = [bf[c].median() for c in W]
    d1, d2 = m[1]-m[0], m[2]-m[1]
    rng = np.random.default_rng(20260101)
    a = [bf[c].values for c in W]
    B1, B2 = [], []
    for _ in range(5000):
        i = rng.integers(0, len(bf), len(bf))
        med = [np.median(x[i]) for x in a]
        B1.append(med[1]-med[0]); B2.append(med[2]-med[1])
    B1, B2 = np.array(B1), np.array(B2)
    print(f"\n===== {label} (n black female = {len(bf)}) =====")
    print(f"medianas 1985/1990/1996: {m[0]:.0f} / {m[1]:.0f} / {m[2]:.0f}")
    print(f"delta 1985->1990: {d1:.0f}  IC95 [{np.percentile(B1,2.5):.0f}, {np.percentile(B1,97.5):.0f}]")
    print(f"delta 1990->1996: {d2:.0f}  IC95 [{np.percentile(B2,2.5):.0f}, {np.percentile(B2,97.5):.0f}]")
    print(f"P(delta1 > delta2) = {(B1>B2).mean():.4f}")
    return m, d1, d2

# --- Primario: sin duplicados ---
prim = df.drop_duplicates()
m_p, d1_p, d2_p = analyze(prim, "PRIMARIO sin duplicados")

# --- Sensibilidad: con duplicados ---
m_s, d1_s, d2_s = analyze(df, "SENSIBILIDAD con duplicados")

# --- Sensibilidad: clip negativos a 0 / excluir negativos (sin duplicados) ---
bf = prim[(prim.race=='black') & (prim.sex=='female')]
print(f"\n===== Sensibilidad negativos (sin duplicados, n={len(bf)}) =====")
clip = [np.clip(bf[c], 0, None).median() for c in W]
print("clip>=0  medianas:", [f"{x:.0f}" for x in clip],
      " deltas:", f"{clip[1]-clip[0]:.0f} / {clip[2]-clip[1]:.0f}")
drop = [bf.loc[bf[c]>=0, c].median() for c in W]
print("drop_neg medianas:", [f"{x:.0f}" for x in drop],
      " deltas:", f"{drop[1]-drop[0]:.0f} / {drop[2]-drop[1]:.0f}",
      f" (n excluir neg: {[int((bf[c]>=0).sum()) for c in W]})")

# --- Contexto descriptivo: todos los subgrupos (sin duplicados) ---
print("\n===== Contexto: deltas de mediana por raza x sexo (sin duplicados) =====")
g = prim.groupby(['race','sex'])
rows = []
for k, gr in g:
    mm = [gr[c].median() for c in W]
    rows.append({'race':k[0], 'sex':k[1], 'n':len(gr),
                 'med85':mm[0], 'med90':mm[1], 'med96':mm[2],
                 'd_85_90':mm[1]-mm[0], 'd_90_96':mm[2]-mm[1],
                 'mayor_aumento': '1985-1990' if mm[1]-mm[0] > mm[2]-mm[1] else '1990-1996'})
print(pd.DataFrame(rows).to_string(index=False))

# --- Diagnóstico de la estructura de duplicados ---
print("\n===== Diagnóstico: estructura de los duplicados =====")
dups = df[df.duplicated(keep=False)]
print("filas involucradas en duplicados (contando ambas copias):", len(dups))
print("de ellas con patrón (0,0,0) en las tres riquezas:", int(((dups[W]==0).all(axis=1)).sum()))
print("top patrones duplicados:\n", df.groupby(W).size().sort_values(ascending=False).head(5).to_string())

# --- Grid completo de sensibilidades (black female) ---
print("\n===== Grid de sensibilidades (black female) =====")
def med(data, transform):
    out = []
    for c in W:
        x = data[c]
        if transform == 'raw': v = x
        elif transform == 'clip': v = x.clip(lower=0)
        elif transform == 'drop': v = x[x >= 0]
        out.append(v.median())
    return out
for base, bl in [(df,'con dups'), (df.drop_duplicates(),'sin dups')]:
    b = base[(base.race=='black')&(base.sex=='female')]
    for tr in ['raw','clip','drop']:
        m = med(b, tr)
        d1, d2 = m[1]-m[0], m[2]-m[1]
        print(f"{bl:9s} {tr:5s}: med {m[0]:>8.0f}/{m[1]:>8.0f}/{m[2]:>8.0f}  "
              f"d85-90={d1:>7.0f}  d90-96={d2:>7.0f}  -> mayor: "
              f"{'1985-1990' if d1>d2 else '1990-1996'}")
