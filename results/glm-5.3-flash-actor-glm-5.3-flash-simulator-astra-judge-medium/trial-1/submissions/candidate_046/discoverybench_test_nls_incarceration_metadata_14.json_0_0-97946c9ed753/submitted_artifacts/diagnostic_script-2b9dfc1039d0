"""Diagnóstico inicial (solo inspección) de data/nls_incarceration_processed.csv.
Ejecutado para el handoff stage=plan. No constituye el análisis principal.
"""
import pandas as pd, numpy as np

df = pd.read_csv('data/nls_incarceration_processed.csv')
W = ['composite_wealth_1985','composite_wealth_1990','composite_wealth_1996']

print("== 1. Perfil ==")
print("shape:", df.shape)
print(df.dtypes)
print("missing:\n", df.isna().sum())
print("duplicados exactos:", df.duplicated().sum())
for c in ['race','sex','ever_jailed']:
    print(f"\n{c}:\n{df[c].value_counts(dropna=False)}")

print("\n== 2. Descriptivos globales de riqueza ==")
for c in W:
    print(f"\n{c}\n", df[c].describe(percentiles=[.01,.05,.1,.25,.5,.75,.9,.95,.99]).round(1))
    print("negativos:", (df[c]<0).sum(), "ceros:", (df[c]==0).sum())

print("\n== 3. Por raza x sexo (n y medianas) ==")
print(df.groupby(['race','sex'])[W].agg(['size','median','min','max']).to_string())

bf = df[(df.race=='black') & (df.sex=='female')]
print("\n== Mujeres negras: cuantiles ==")
print(bf[W].quantile([.01,.05,.1,.25,.5,.75,.9,.95,.99]).round(1).to_string())
print("medianas por ever_jailed:\n", bf.groupby('ever_jailed')[W].median().to_string())
print("n por ever_jailed:\n", bf['ever_jailed'].value_counts())

print("\n== Diagnóstico de estabilidad (bootstrap 2000, solo control de calidad) ==")
rng = np.random.default_rng(0)
a = [bf[c].values for c in W]
d1, d2 = [], []
for _ in range(2000):
    i = rng.integers(0, len(bf), len(bf))
    d1.append(np.median(a[1][i]) - np.median(a[0][i]))
    d2.append(np.median(a[2][i]) - np.median(a[1][i]))
d1, d2 = np.array(d1), np.array(d2)
print(f"delta 85->90: {d1.mean():.0f} IC95 [{np.percentile(d1,2.5):.0f},{np.percentile(d1,97.5):.0f}]")
print(f"delta 90->96: {d2.mean():.0f} IC95 [{np.percentile(d2,2.5):.0f},{np.percentile(d2,97.5):.0f}]")
print("P(d1>d2):", (d1>d2).mean())

print("\n== Sensibilidad sobre negativos (medianas) ==")
print("raw       :", [bf[c].median() for c in W])
print("clip>=0   :", [np.clip(bf[c],0,None).median() for c in W])
print("drop_neg  :", [bf.loc[bf[c]>=0, c].median() for c in W])
