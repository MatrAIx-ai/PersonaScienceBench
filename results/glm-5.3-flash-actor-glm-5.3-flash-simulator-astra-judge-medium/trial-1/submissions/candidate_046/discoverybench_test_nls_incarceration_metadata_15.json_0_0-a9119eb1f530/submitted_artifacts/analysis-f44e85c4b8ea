import pandas as pd, numpy as np

df = pd.read_csv('data/nls_incarceration_processed.csv')
w = df[df.race == 'white'].copy()
YEARS = ['composite_wealth_1990', 'composite_wealth_1996']
LABEL = {'composite_wealth_1990': '1990', 'composite_wealth_1996': '1996'}

def gini(x):
    x = np.sort(np.asarray(x, dtype=float))
    n = len(x)
    # standard Gini for possibly-negative values: mean absolute difference / (2*mean)
    mad = np.abs(np.subtract.outer(x, x)).sum() / (n * n)
    mu = x.mean()
    return mad / (2 * mu) if mu != 0 else np.nan

def metrics(x):
    q10, q50, q90 = np.percentile(x, [10, 50, 90])
    return dict(n=len(x), mean=x.mean(), median=q50,
                p10=q10, p25=np.percentile(x, 25), p75=np.percentile(x, 75), p90=q90,
                p90p50=q90 / q50 if q50 > 0 else np.nan,
                p50p10=q50 / q10 if q10 > 0 else np.inf,
                gini=gini(x), cv=x.std() / x.mean() if x.mean() != 0 else np.nan,
                mean_over_median=x.mean() / q50 if q50 > 0 else np.nan,
                zero_share=(x == 0).mean(), neg_share=(x < 0).mean())

rows = []
for y in YEARS:
    for sex in ['male', 'female']:
        x = w.loc[w.sex == sex, y].values.astype(float)
        m = metrics(x); m.update(year=LABEL[y], sex=sex)
        rows.append(m)
base = pd.DataFrame(rows)
cols = ['year','sex','n','mean','median','p10','p25','p75','p90','p90p50','p50p10','gini','cv','mean_over_median','zero_share','neg_share']
base = base[cols]
pd.set_option('display.width', 250); pd.set_option('display.float_format', lambda v: f'{v:,.3f}')
print("=== BASE (current dollars, negatives kept) ===")
print(base.to_string(index=False))

# Between-sex relative median gap
print("\n=== Between-sex relative median gap (male/female) ===")
for y in YEARS:
    f = w.loc[w.sex=='female', y].median(); m = w.loc[w.sex=='male', y].median()
    print(f"{LABEL[y]}: male median={m:,.0f}, female median={f:,.0f}, ratio M/F={m/f:.3f}, F/M={f/m:.3f}")

# Sensitivity 1: winsorize p1-p99 within group-year
rows2 = []
for y in YEARS:
    for sex in ['male','female']:
        x = w.loc[w.sex==sex, y].values.astype(float)
        lo, hi = np.percentile(x, [1, 99])
        xw = np.clip(x, lo, hi)
        m = metrics(xw); m.update(year=LABEL[y], sex=sex)
        rows2.append(m)
wins = pd.DataFrame(rows2)[cols]
print("\n=== SENSITIVITY: winsorized p1-p99 (within group-year) ===")
print(wins.to_string(index=False))

# Sensitivity 2: drop negatives
rows3 = []
for y in YEARS:
    for sex in ['male','female']:
        x = w.loc[(w.sex==sex) & (w[y]>=0), y].values.astype(float)
        m = metrics(x); m.update(year=LABEL[y], sex=sex)
        rows3.append(m)
noneg = pd.DataFrame(rows3)[cols]
print("\n=== SENSITIVITY: negatives excluded ===")
print(noneg.to_string(index=False))

# Uncertainty C: zero-artefact quantification — exclude zeros
rows4 = []
for y in YEARS:
    for sex in ['male','female']:
        x = w.loc[(w.sex==sex) & (w[y]!=0), y].values.astype(float)
        m = metrics(x); m.update(year=LABEL[y], sex=sex)
        rows4.append(m)
nozero = pd.DataFrame(rows4)[cols]
print("\n=== SENSITIVITY: zeros excluded (zero-artifact check) ===")
print(nozero.to_string(index=False))

# Inflation note
print("\n=== Inflation note: 1996 values in 1990 dollars (divide by 1.22) ===")
for sex in ['male','female']:
    for y in YEARS:
        v = w.loc[w.sex==sex, y].median()
        print(f"{LABEL[y]} {sex}: median={v:,.0f}  (1990 dollars: {v/1.22:,.0f})")

# extreme value documentation
print("\n=== Extreme values ===")
print("Most negative 1990:", w.loc[w['composite_wealth_1990'].idxmin(), ['sex','composite_wealth_1990']].to_dict())
print("Top 3 |wealth| 1990:", sorted(w['composite_wealth_1990'])[:3], sorted(w['composite_wealth_1990'])[-3:])
