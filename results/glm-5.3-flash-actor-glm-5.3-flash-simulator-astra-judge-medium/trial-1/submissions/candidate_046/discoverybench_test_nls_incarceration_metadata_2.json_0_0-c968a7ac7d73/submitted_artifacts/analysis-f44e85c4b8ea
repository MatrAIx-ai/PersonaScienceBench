"""
Análisis: riqueza por año según antecedentes de encarcelamiento (ever_jailed, 1985-1994)
Dataset: NLSY79 cohort - data/nls_incarceration_processed.csv
Diseño aprobado: OLS por año (ever_jailed + C(race) + C(sex), errores HC3),
Mann-Whitney por año, significancia bilateral alfa=0.05 con corrección Holm
sobre las 3 pruebas por familia. Cambios entre años como contexto complementario.
"""
import numpy as np
import pandas as pd
from scipy import stats
import statsmodels.formula.api as smf

df = pd.read_csv("data/nls_incarceration_processed.csv")
YEARS = [1985, 1990, 1996]
wcols = {y: f"composite_wealth_{y}" for y in YEARS}

def signed_log(x):
    return np.sign(x) * np.log1p(np.abs(x))

def holm(pvals):
    """Corrección de Holm-Bonferroni."""
    p = np.asarray(pvals, dtype=float)
    order = np.argsort(p)
    m = len(p)
    adj = np.empty(m)
    running = 0.0
    for rank, idx in enumerate(order):
        val = (m - rank) * p[idx]
        running = max(running, val)
        adj[idx] = min(running, 1.0)
    return adj

# ---------- 1. Análisis principal: OLS HC3 por año ----------
print("=" * 80)
print("1. REGRESIÓN OLS POR AÑO: wealth ~ ever_jailed + C(race) + C(sex), errores HC3")
print("=" * 80)
ols_rows = []
for y in YEARS:
    m = smf.ols(f"{wcols[y]} ~ ever_jailed + C(race) + C(sex)", data=df).fit(cov_type="HC3")
    b = m.params["ever_jailed"]; se = m.bse["ever_jailed"]
    ci = m.conf_int().loc["ever_jailed"]; pv = m.pvalues["ever_jailed"]
    ols_rows.append({"year": y, "coef_ever_jailed": b, "se": se,
                     "ci_low": ci[0], "ci_high": ci[1], "p_raw": pv,
                     "n": int(m.nobs), "r2": m.rsquared})
    print(f"\nAño {y}: n={int(m.nobs)}, R2={m.rsquared:.4f}")
    print(m.summary().tables[1])
    print(f"  ever_jailed: coef={b:,.1f}, IC95%=[{ci[0]:,.1f}, {ci[1]:,.1f}], p={pv:.3e}")

ols_df = pd.DataFrame(ols_rows)
ols_df["p_holm"] = holm(ols_df["p_raw"].values)
print("\nTabla resumen OLS (con Holm sobre los 3 años):")
print(ols_df.to_string(index=False,
      formatters={"coef_ever_jailed": "{:,.1f}".format, "se": "{:,.1f}".format,
                  "ci_low": "{:,.1f}".format, "ci_high": "{:,.1f}".format,
                  "p_raw": "{:.3e}".format, "p_holm": "{:.3e}".format}))

# ---------- 2. Mann-Whitney por año ----------
print("\n" + "=" * 80)
print("2. MANN-WHITNEY U POR AÑO (g1=ever_jailed=1 vs g0=0)")
print("=" * 80)
mw_rows = []
for y in YEARS:
    c = wcols[y]
    g1 = df.loc[df.ever_jailed == 1, c]; g0 = df.loc[df.ever_jailed == 0, c]
    u, pv = stats.mannwhitneyu(g1, g0, alternative="two-sided")
    mw_rows.append({"year": y, "median_g0": g0.median(), "median_g1": g1.median(),
                    "mean_g0": g0.mean(), "mean_g1": g1.mean(),
                    "U": u, "p_raw": pv, "n1": len(g1), "n0": len(g0)})
mw_df = pd.DataFrame(mw_rows)
mw_df["p_holm"] = holm(mw_df["p_raw"].values)
print(mw_df.to_string(index=False,
      formatters={"median_g0": "{:,.0f}".format, "median_g1": "{:,.0f}".format,
                  "mean_g0": "{:,.1f}".format, "mean_g1": "{:,.1f}".format,
                  "p_raw": "{:.3e}".format, "p_holm": "{:.3e}".format}))

# ---------- 3. Cambios entre años (complementario, breve) ----------
print("\n" + "=" * 80)
print("3. CAMBIOS ENTRE AÑOS (contexto complementario)")
print("=" * 80)
chg_rows = []
for name, expr in [("delta_1990_1985", f"{wcols[1990]} - {wcols[1985]}"),
                   ("delta_1996_1985", f"{wcols[1996]} - {wcols[1985]}")]:
    df["_chg"] = df.eval(expr)
    m = smf.ols("_chg ~ ever_jailed + C(race) + C(sex)", data=df).fit(cov_type="HC3")
    b = m.params["ever_jailed"]; ci = m.conf_int().loc["ever_jailed"]; pv = m.pvalues["ever_jailed"]
    chg_rows.append({"change": name, "coef": b, "ci_low": ci[0], "ci_high": ci[1], "p_raw": pv})
    print(f"{name}: coef(ever_jailed)={b:,.1f}, IC95%=[{ci[0]:,.1f}, {ci[1]:,.1f}], p={pv:.3e}")
chg_df = pd.DataFrame(chg_rows)
chg_df["p_holm"] = holm(chg_df["p_raw"].values)
print(chg_df.to_string(index=False,
      formatters={"coef": "{:,.1f}".format, "ci_low": "{:,.1f}".format,
                  "ci_high": "{:,.1f}".format, "p_raw": "{:.3e}".format,
                  "p_holm": "{:.3e}".format}))

# ---------- 4. Sensibilidad ligera: sin duplicados ----------
print("\n" + "=" * 80)
print("4. SENSIBILIDAD (ligera): sin las 2.056 filas duplicadas")
print("=" * 80)
df_nd = df.drop_duplicates()
print(f"Filas sin duplicados: {len(df_nd)}")
for y in YEARS:
    m = smf.ols(f"{wcols[y]} ~ ever_jailed + C(race) + C(sex)", data=df_nd).fit(cov_type="HC3")
    g1 = df_nd.loc[df_nd.ever_jailed == 1, wcols[y]]; g0 = df_nd.loc[df_nd.ever_jailed == 0, wcols[y]]
    _, pmw = stats.mannwhitneyu(g1, g0, alternative="two-sided")
    print(f"  {y}: coef={m.params['ever_jailed']:,.1f}, p={m.pvalues['ever_jailed']:.3e}; MWU p={pmw:.3e}")

# ---------- 5. Robustez: log firmado y winsorización p99 ----------
print("\n" + "=" * 80)
print("5. ROBUSTEZ: log firmado y winsorización p99 (se reporta solo si cambia la conclusión)")
print("=" * 80)
conclusion_change = False
for y in YEARS:
    c = wcols[y]
    df["_sl"] = signed_log(df[c])
    m1 = smf.ols("_sl ~ ever_jailed + C(race) + C(sex)", data=df).fit(cov_type="HC3")
    cap = df[c].abs().quantile(0.99)
    df["_w"] = df[c].clip(lower=-cap, upper=cap)
    m2 = smf.ols("_w ~ ever_jailed + C(race) + C(sex)", data=df).fit(cov_type="HC3")
    p1, p2 = m1.pvalues["ever_jailed"], m2.pvalues["ever_jailed"]
    b1, b2 = m1.params["ever_jailed"], m2.params["ever_jailed"]
    print(f"  {y}: signed-log coef={b1:.3f}, p={p1:.3e} | winsorizada coef={b2:,.1f}, p={p2:.3e}")
    if (p1 >= 0.05) or (p2 >= 0.05):
        conclusion_change = True
print(f"  ¿Cambia alguna conclusión direccional/de significancia? {conclusion_change}")

print("\nANÁLISIS COMPLETADO.")
