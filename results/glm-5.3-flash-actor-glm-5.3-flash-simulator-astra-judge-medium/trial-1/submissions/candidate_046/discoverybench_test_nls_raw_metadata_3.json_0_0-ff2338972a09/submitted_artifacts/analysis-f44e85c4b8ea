"""
NLSY79: How does consideration of academic characteristics alter the effects
of SES and race on BA degree completion?
Operationalizations (approved by researcher):
  (i)  MAIN: 'Highest grade completed, 1979' as continuous outcome (OLS; ordinal as sensitivity)
  (ii) BA indicator = grade >= 16, Firth-penalized logistic (education measured up to 1979)
  (iii) Sensitivity: grade >= 13 ('some college')
Design: Model 1 = SES + race + sex + age; Model 2 = Model 1 + ASVAB composite + class-rank
percentile (+ missing indicator). Attenuation = % change in coefficients between models.
Missing data: complete-case and median-imputation-with-indicators run as mutual sensitivities.
All associations are associational, not causal; education is measured up to 1979 only.
"""
import numpy as np, pandas as pd, statsmodels.api as sm
from statsmodels.stats.outliers_influence import variance_inflation_factor
pd.set_option('display.width', 220); pd.set_option('display.max_columns', 50)
out_lines = []
def P(*a):
    s = ' '.join(str(x) for x in a); print(s); out_lines.append(s)

df = pd.read_csv('data/nls_raw.csv')
C = {i: c for i, c in enumerate(df.columns)}
grade   = 'Highest grade completed, 1979'
mother  = C[3]; father = C[4]; race = C[7]; sex = C[8]; fam = C[9]
income  = C[10]; rankc = C[17]; nclass = C[18]
asv_cols = [C[i] for i in range(19, 23)]

# ---------- cleaning ----------
d = df.copy()
d.loc[d[grade] == 95, grade] = np.nan              # code 95 -> missing (approved)
d['top_inc79'] = (d[income] >= 75000).astype(int)  # top-code flag
d.loc[d[income] >= 75000, income] = 75000
d['log_inc79'] = np.log(d[income].clip(lower=1))
for c in [mother, father]:
    d.loc[d[c] > 20, c] = np.nan
d['female'] = (d[sex] == 2).astype(int)
d['black'] = (d[race] == 1).astype(int)
d['hispanic'] = (d[race] == 2).astype(int)         # ref = NON-BLACK NON-HISPANIC (3)
d['grade'] = d[grade]
d['ba16'] = (d[grade] >= 16).astype(float); d.loc[d[grade].isna(), 'ba16'] = np.nan
d['somecoll13'] = (d[grade] >= 13).astype(float); d.loc[d[grade].isna(), 'somecoll13'] = np.nan
d['age79'] = d[C[1]]
d['hgc_mother'] = d[mother]; d['hgc_father'] = d[father]; d['famsize'] = d[fam]

# ASVAB composite: z-score each section, average, re-standardize
z = lambda s: (s - s.mean()) / s.std()
asv_z = pd.concat([z(d[c]) for c in asv_cols], axis=1)
d['asvab_ok'] = asv_z.notna().all(axis=1).astype(int)
d['asvab'] = asv_z.mean(axis=1, skipna=False)
d['asvab'] = z(d['asvab'])
# class-rank percentile (1 - rank/class size; higher = better)
d['rank_pct'] = 1 - d[rankc] / d[nclass]
d['rank_ok'] = d['rank_pct'].notna().astype(int)
d['rank_no'] = 1 - d['rank_ok']

ses = ['hgc_mother', 'hgc_father', 'log_inc79', 'top_inc79', 'famsize']
X1 = ['hgc_mother', 'hgc_father', 'log_inc79', 'top_inc79', 'famsize', 'black', 'hispanic', 'female', 'age79']
X2 = X1 + ['asvab', 'rank_pct', 'rank_no']

P('=== SAMPLE SIZES ===')
base_ok = d['grade'].notna()
cc1 = base_ok & d[ses].notna().all(axis=1)
cc2 = cc1 & (d['asvab_ok'] == 1)
P('total rows:', len(d), '| outcome non-missing:', int(base_ok.sum()))
P('Model1 complete cases (SES+outcome):', int(cc1.sum()))
P('common Model1+Model2 sample (SES+ASVAB complete):', int(cc2.sum()),
  ' (rank imputed with indicator there; rank available:', int(d.loc[cc2,'rank_ok'].sum()), ')')

def design(dd, cols, imp=False):
    X = dd[cols].copy()
    inds = []
    if imp:
        for c in ['hgc_mother', 'hgc_father', 'log_inc79']:
            X[c+'_no'] = X[c].isna().astype(int); inds.append(c+'_no')
            X[c] = X[c].fillna(X[c].median())
        X['famsize'] = X['famsize'].fillna(X['famsize'].median())
        if 'asvab' in cols:
            X['asvab_no'] = (X['asvab'].isna()).astype(int); inds.append('asvab_no')
            X['asvab'] = X['asvab'].fillna(X['asvab'].median())
        if 'rank_pct' in cols:
            X['rank_pct'] = X['rank_pct'].fillna(X['rank_pct'].median())
    else:
        if 'rank_pct' in cols:
            X['rank_pct'] = X['rank_pct'].fillna(X['rank_pct'].median())  # rank_no indicator carries the missingness
    return sm.add_constant(X, has_constant='add'), inds

def attenuation(r1, r2, names):
    P('\n--- ATTENUATION (Model1 -> Model2), % change: (b1-b2)/b1*100 ---')
    rows = []
    for n in names:
        if n in r1.index and n in r2.index and r1[n] != 0:
            rows.append((n, r1[n], r2[n], 100*(r1[n]-r2[n])/r1[n]))
    return pd.DataFrame(rows, columns=['variable','b_Model1','b_Model2','attenuation_%']).set_index('variable')

def run_ols(dd, cols, label):
    X, _ = design(dd, cols)
    m = sm.OLS(dd['grade'], X, missing='drop').fit(cov_type='HC3')
    P(f'\n=== {label} | OLS on highest grade completed 1979 (HC3 SE) | n={int(m.nobs)} ===')
    t = pd.DataFrame({'coef': m.params, 'se': m.bse, 't': m.tvalues, 'p': m.pvalues}).round(4)
    P(t.to_string()); P('R2 =', round(m.rsquared, 4))
    return m.params, m

names_ses_race = ['hgc_mother','hgc_father','log_inc79','famsize','black','hispanic']

# ---------- MAIN: continuous outcome, complete cases ----------
dd2 = d[cc2].copy()
b1, m1 = run_ols(dd2, X1, 'MODEL 1 (SES+race), complete cases')
b2, m2 = run_ols(dd2, X2, 'MODEL 2 (+ ASVAB composite + rank percentile), same sample')
att = attenuation(b1, b2, names_ses_race)
P('\n' + att.round(3).to_string())

Xv, _ = design(dd2, X2)
P('\n=== VIF (Model 2 design, common sample) ===')
P(pd.Series({Xv.columns[i]: round(variance_inflation_factor(Xv.values, i), 2)
             for i in range(1, Xv.shape[1])}).to_string())

# ---------- SENSITIVITY A: median imputation + indicators, full sample ----------
di = d[base_ok].copy()
Xi1, _ = design(di, X1, imp=True)
Xi2, _ = design(di, X2, imp=True)
mi1 = sm.OLS(di['grade'], Xi1).fit(cov_type='HC3')
mi2 = sm.OLS(di['grade'], Xi2).fit(cov_type='HC3')
P(f'\n=== SENSITIVITY: median-imputation + indicators | n={int(mi1.nobs)} ===')
P('Model1 coeffs:', mi1.params.round(4).to_dict())
P('Model2 coeffs:', mi2.params.round(4).to_dict())
P(attenuation(mi1.params, mi2.params, names_ses_race).round(3).to_string())

# ---------- (ii) Firth logistic: BA = grade>=16 ----------
def firth_loglik(X, y, b):
    eta = np.clip(X@b, -30, 30); p = 1/(1+np.exp(-eta)); w = np.clip(p*(1-p), 1e-10, None)
    I = X.T@(X*w[:, None]); sign, ld = np.linalg.slogdet(I)
    return (y*np.log(np.clip(p,1e-12,1)) + (1-y)*np.log(np.clip(1-p,1e-12,1))).sum() + 0.5*ld

def firth(Xmat, y, tol=1e-9, maxit=8000):
    X = np.asarray(Xmat, float); y = np.asarray(y, float)
    b = np.zeros(X.shape[1]); b[0] = np.log(np.clip(y.mean(), .02, .98)/(1-np.clip(y.mean(), .02, .98)))
    ll = firth_loglik(X, y, b)
    for it in range(maxit):
        eta = np.clip(X@b, -30, 30); p = 1/(1+np.exp(-eta)); w = np.clip(p*(1-p), 1e-10, None)
        I = X.T@(X*w[:, None]); Iinv = np.linalg.pinv(I)
        h = np.einsum('ij,jk,ik->i', X*w[:, None], Iinv, X)     # leverage diag
        U = X.T@(y-p) + 0.5*(X*(w*(1-2*p)*h)[:, None]).sum(axis=0)  # Firth modified score
        step = Iinv@U
        if np.max(np.abs(step)) < tol: break
        t_, ok = 1.0, False
        for _ in range(40):
            bn = b + t_*step
            lln = firth_loglik(X, y, bn)
            if lln >= ll - 1e-10:
                b, ll, ok = bn, lln, True; break
            t_ /= 2
        if not ok: break
    eta = np.clip(X@b, -30, 30); p = 1/(1+np.exp(-eta)); w = np.clip(p*(1-p), 1e-10, None)
    I = X.T@(X*w[:, None]); cov = np.linalg.pinv(I)
    return b, np.sqrt(np.diag(cov)), it+1

P('\n=== (ii) FIRTH LOGISTIC: P(grade>=16) | common sample (n=%d, events=%d) ===' % (cc2.sum(), int(d.loc[cc2,'ba16'].sum())))
for cols0, lab in [(X1, 'Firth Model1 (SES+race)'), (X2, 'Firth Model2 (+academics)')]:
    cols = [c for c in cols0 if c != 'top_inc79']   # top_inc79 (61 obs, 0-2 events) causes separation; dropped for Firth only
    Xf, _ = design(dd2, cols)
    # rescale continuous predictors (z-scores) to break the near-separation ridge in age/const
    cont = [c for c in cols if dd2[c].nunique() > 2]
    for c in cont:
        Xf[c] = (Xf[c] - Xf[c].mean()) / Xf[c].std()
    bf, sef, it = firth(Xf, dd2['ba16'].values, maxit=8000)
    orr = pd.Series(np.exp(bf), index=Xf.columns); lo = np.exp(bf-1.96*sef); hi = np.exp(bf+1.96*sef)
    P(f'-- {lab} (iters={it}) --')
    P(pd.DataFrame({'beta': bf.round(4), 'OR': orr.round(3), 'OR_lo95': lo.round(3), 'OR_hi95': hi.round(3)}, index=Xf.columns).to_string())

# ---------- (iii) sensitivity: grade>=13 standard logistic ----------
P('\n=== (iii) SENSITIVITY: LOGISTIC P(grade>=13) | common sample (n=%d, events=%d) ===' % (cc2.sum(), int(dd2['somecoll13'].sum())))
r13 = {}
for cols, lab in [(X1, 'Model1'), (X2, 'Model2')]:
    Xl, _ = design(dd2, cols)
    lm = sm.Logit(dd2['somecoll13'], Xl).fit(disp=0)
    P(f'-- {lab}: ORs --'); P(np.exp(lm.params).round(3).to_string())
    r13[lab] = lm.params
P(attenuation(r13['Model1'], r13['Model2'], names_ses_race).round(3).to_string())

# ---------- ordinal sensitivity ----------
try:
    from statsmodels.miscmodels.ordinal_model import OrderedModel
    yo = dd2['grade'].astype(int)
    Xo1, _ = design(dd2, X1); Xo2, _ = design(dd2, X2)
    Xo1, Xo2 = Xo1.drop(columns='const'), Xo2.drop(columns='const')
    om1 = OrderedModel(yo, Xo1, distr='logit').fit(method='bfgs', disp=0, maxiter=600)
    om2 = OrderedModel(yo, Xo2, distr='logit').fit(method='bfgs', disp=0, maxiter=600)
    for lab, om, Xo in [('Ordered M1', om1, Xo1), ('Ordered M2', om2, Xo2)]:
        P(f'\n=== ORDINAL (logit) {lab} | n={int(om.nobs)} ===')
        P(pd.Series(om.params[[c for c in Xo.columns]], index=[c for c in Xo.columns]).round(4).to_string())
    P(attenuation(om1.params, om2.params, names_ses_race).round(3).to_string())
except Exception as e:
    P('\n[ordinal model failed:', repr(e), ']')

# ---------- descriptives for narrative ----------
P('\n=== DESCRIPTIVES ===')
P('mean grade by race (common sample):', dd2.groupby(race)['grade'].mean().round(2).to_dict())
P('BA>=16 rate by race (all with outcome):', d.groupby(race)['ba16'].mean().round(4).to_dict())
P('>=13 rate by race (all with outcome):', d.groupby(race)['somecoll13'].mean().round(3).to_dict())
P('mean ASVAB composite by race:', d.groupby(race)['asvab'].mean().round(2).to_dict())

with open('results_nls.txt', 'w') as f:
    f.write('\n'.join(out_lines))
P('\n[results saved to results_nls.txt]')
