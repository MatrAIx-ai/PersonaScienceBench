"""
NLSY79 (nls_raw.csv): BA degree completion for Black students by SES levels.
Approved workflow: cleaning -> childhood SES composite (terciles within cohort 1)
-> attainment rates by SES with CIs -> cross-cohort contrast -> logistic robustness.
Primary outcome: BA proxy = Highest grade completed (1979) >= 16 (with explicit
small-n limitation). Adjacent outcomes (HS>=12, postsec>=13, years of schooling)
are supporting-gradient evidence only.
"""
import pandas as pd, numpy as np, json
from scipy import stats

df = pd.read_csv('data/nls_raw.csv')
N0 = len(df)

# ---- 1) Cleaning ----
df = df.rename(columns={
    'Highest grade completed, 1979': 'hgc79',
    "Highest grade completed by respondent's mother, 1979": 'hgc_mom',
    "Highest grade completed by respondent's father, 1979": 'hgc_dad',
    'Total net family income, previous calendar year, 1979': 'inc79',
    'Total net family income, previous calendar year, 1985': 'inc85',
    'Total net family income, previous calendar year, 1989': 'inc89',
    'Family net wealth, 1985': 'w85', 'Family net wealth, 1990': 'w90',
    'Family net wealth, 1996 (key data point)': 'w96',
    'Racial/ethnic cohort, 1979': 'race', 'Sex of respondent, 1979': 'sex',
    'Age of respondent, 1979': 'age79'})
df.loc[df['hgc79'] == 95, 'hgc79'] = np.nan          # invalid code
df['ba']    = (df['hgc79'] >= 16).astype(float)       # 1.20% missing preserved
df['hs']    = (df['hgc79'] >= 12).astype(float)
df['postsec'] = (df['hgc79'] >= 13).astype(float)
cohorts = {1: 'BLACK', 2: 'HISPANIC', 3: 'NON-BLACK NON-HISPANIC'}
df['race_lab'] = df['race'].map(cohorts)

# ---- 2) Childhood SES composite: log(income79+1), mother HGC, father HGC ----
# Missing -> median within racial/ethnic cohort (sensitivity: complete cases too)
comp = pd.DataFrame(index=df.index)
comp['loginc'] = np.log1p(df['inc79'].clip(lower=0))
comp['mom'] = df['hgc_mom']; comp['dad'] = df['hgc_dad']
med = comp.groupby(df['race']).transform('median')
comp_imp = comp.fillna(med)
z = (comp_imp - comp_imp.mean()) / comp_imp.std()
df['ses_raw'] = z.mean(axis=1)
df['ses_missing'] = comp.isna().any(axis=1)

# Terciles of SES computed within cohort 1 (BLACK)
b = df[df['race'] == 1].copy()
q1, q2 = b['ses_raw'].quantile([1/3, 2/3])
b['ses_lvl'] = pd.cut(b['ses_raw'], [-np.inf, q1, q2, np.inf],
                      labels=['Low SES', 'Mid SES', 'High SES'])
df['ses_lvl'] = b['ses_lvl'].reindex(df.index)
print("Cohort 1 tercile cutpoints (SES z-composite):", round(q1,3), round(q2,3))
print("SES-level n (cohort 1, incl. missing-SES rows):")
print(b.groupby('ses_lvl', observed=True).size().to_string())

# ---- 3) Rates by SES level within cohort 1, Wilson 95% CI ----
def wilson(k, n, z=1.96):
    if n == 0: return (np.nan, np.nan)
    p = k/n; d = 1 + z**2/n
    c = (p + z**2/(2*n)) / d
    h = z*np.sqrt(p*(1-p)/n + z**2/(4*n**2)) / d
    return (c-h, c+h)

rows = []
for lvl in ['Low SES', 'Mid SES', 'High SES']:
    g = b[b['ses_lvl'] == lvl]
    for out in ['ba', 'postsec', 'hs', 'hgc79']:
        s = g[out].dropna()
        k = int(s.sum()) if out != 'hgc79' else np.nan
        n = len(s)
        lo, hi = wilson(k, n) if out != 'hgc79' else (np.nan, np.nan)
        rows.append({'SES level': lvl, 'outcome': out, 'n_complete': n,
                     'k_cases': k, 'rate': (k/n if out != 'hgc79' else np.nan),
                     'ci_lo': lo, 'ci_hi': hi,
                     'mean': (s.mean() if out == 'hgc79' else np.nan),
                     'sd': (s.std() if out == 'hgc79' else np.nan)})
rates = pd.DataFrame(rows)
print("\n=== Cohort 1 (BLACK): attainment by childhood SES level ===")
print(rates.to_string(index=False))

# Cochran-Armitage-ish trend: logistic slope across SES level (0/1/2) within cohort 1
for out in ['ba', 'postsec', 'hs']:
    g = b.dropna(subset=[out, 'ses_lvl'])
    x = g['ses_lvl'].map({'Low SES': 0, 'Mid SES': 1, 'High SES': 2}).astype(float)
    ct = pd.crosstab(x, g[out])
    try:
        r = stats.pearsonr(x, g[out])
        print(f"\nTrend SES(0/1/2) vs {out}: r={r[0]:.3f}, p={r[1]:.4f}")
        print(ct.to_string())
    except Exception as e:
        print(out, 'trend error', e)

# ---- 4) Cross-cohort contrast: rates by SES level (SES terciles per own cohort) ----
print("\n=== Cross-cohort: rates by within-cohort SES terciles ===")
cc = []
for rc in [1, 2, 3]:
    g0 = df[df['race'] == rc].copy()
    q = g0['ses_raw'].quantile([1/3, 2/3])
    g0['ses_lvl'] = pd.cut(g0['ses_raw'], [-np.inf, q[1/3], q[2/3], np.inf],
                           labels=['Low SES', 'Mid SES', 'High SES'])
    for lvl in ['Low SES', 'Mid SES', 'High SES']:
        gg = g0[g0['ses_lvl'] == lvl]
        for out in ['ba', 'postsec', 'hs']:
            s = gg[out].dropna()
            cc.append({'cohort': cohorts[rc], 'SES': lvl, 'outcome': out,
                       'n': len(s), 'rate': (s.mean() if len(s) else np.nan)})
ccdf = pd.DataFrame(cc)
piv = ccdf.pivot_table(index=['outcome', 'SES'], columns='cohort', values='rate')
print((piv * 100).round(2).to_string())

# ---- 5) Logistic robustness within cohort 1 ----
import numpy.linalg as la
def logit_fit(y, X):
    X = np.column_stack([np.ones(len(X)), X])
    beta = np.zeros(X.shape[1])
    for _ in range(100):
        p = 1/(1+np.exp(-(X @ beta).clip(-30, 30)))
        W = p*(1-p); g = X.T @ (y - p); H = X.T @ (X*W[:,None])
        step = la.solve(H + 1e-10*np.eye(len(beta)), g); beta += step
        if np.max(np.abs(step)) < 1e-10: break
    se = np.sqrt(np.diag(la.inv(H)))
    return beta, se

g = b.dropna(subset=['ba', 'ses_lvl', 'sex', 'age79', 'ses_missing'])
y = g['ba'].values
print(f"\nLogistic (BA) complete cases in cohort 1: n={len(g)}, k_BA={int(y.sum())}")
# too few BA cases for stable logit -> run on postsec and hs; report BA logit with caveat
x = np.column_stack([
    g['ses_lvl'].map({'Low SES':0,'Mid SES':1,'High SES':2}).values.astype(float),
    (g['sex']==2).astype(int).values, g['age79'].values])
for name, yy in [('postsec>=13', g['postsec'].values), ('hs>=12', g['hs'].values), ('ba>=16', y)]:
    try:
        beta, se = logit_fit(yy.astype(float), x)
        orr = np.exp(beta[1]); lo = np.exp(beta[1]-1.96*se[1]); hi = np.exp(beta[1]+1.96*se[1])
        print(f"  {name}: OR per SES-tercile step = {orr:.2f} (95% CI {lo:.2f}-{hi:.2f}); k_cases={int(yy.sum())}")
    except Exception as e:
        print(f"  {name}: fit failed ({e})")

# Sensitivity: complete-case SES (no imputation)
g2 = b[~b['ses_missing']].copy()
print("\nSensitivity (complete-case SES, cohort 1): rates by SES tercile")
q = g2['ses_raw'].quantile([1/3, 2/3])
g2['sl'] = pd.cut(g2['ses_raw'], [-np.inf, q[1/3], q[2/3], np.inf],
                  labels=['Low SES', 'Mid SES', 'High SES'])
for out in ['ba', 'postsec', 'hs']:
    tab = g2.groupby('sl', observed=True)[out].agg(['count', 'sum', 'mean'])
    print(f"-- {out} --\n{tab.to_string()}")

# Sensitivity: adult SES (wealth96) vs attainment, cohort 1, description only
g3 = b.dropna(subset=['w96'])
g3['wlvl'] = pd.qcut(g3['w96'], 3, labels=['Low', 'Mid', 'High'], duplicates='drop')
print("\nSensitivity: cohort 1 attainment by 1996 family-wealth tercile (adult SES)")
for out in ['ba', 'postsec', 'hs']:
    t = g3.groupby('wlvl', observed=True)[out].agg(['count', 'sum', 'mean'])
    print(f"-- {out} --\n{t.to_string()}")

# Save tables
rates.to_csv('outputs/rates_cohort1_by_ses.csv', index=False)
ccdf.to_csv('outputs/cross_cohort_rates.csv', index=False)
g.to_csv('outputs/cohort1_analysis_sample.csv', index=False)
print("\nSaved: outputs/rates_cohort1_by_ses.csv, outputs/cross_cohort_rates.csv, outputs/cohort1_analysis_sample.csv")
