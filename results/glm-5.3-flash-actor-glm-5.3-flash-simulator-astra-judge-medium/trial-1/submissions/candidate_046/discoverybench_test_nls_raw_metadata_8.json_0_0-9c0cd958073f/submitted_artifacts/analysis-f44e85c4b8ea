"""
Analysis: Median family net wealth by racial/ethnic cohort (NLSY79), 1985/1990/1996.
Main analysis keeps negative and zero wealth values (genuine net worth).
Sensitivity (secondary): excludes negatives.
Cohort 3 (NON-BLACK NON-HISPANIC) used as proxy for 'white individuals' (declared assumption).
"""
import pandas as pd
import numpy as np

df = pd.read_csv('data/nls_raw.csv')
COHORT = 'Racial/ethnic cohort, 1979'
WEALTH = {
    1985: 'Family net wealth, 1985',
    1990: 'Family net wealth, 1990',
    1996: 'Family net wealth, 1996 (key data point)',
}
LABEL = {1: 'Black', 2: 'Hispanic', 3: 'Non-Black Non-Hispanic (white proxy)'}
WHITE, BLACK, HISP = 3, 1, 2

rows = []
for year, col in WEALTH.items():
    s = df[col]
    for coh in [WHITE, BLACK, HISP]:
        v = s[df[COHORT] == coh].dropna()
        med = v.median()
        rows.append({
            'year': year, 'cohort': LABEL[coh], 'n': int(v.size),
            'median_all': med,
            'median_nonneg': v[v >= 0].median(),
            'n_negative': int((v < 0).sum()),
            'share_negative_pct': 100 * (v < 0).mean(),
        })
table = pd.DataFrame(rows)
print('=== MAIN TABLE: medians by cohort and year (negatives & zeros kept) ===')
main = table.pivot(index='year', columns='cohort', values='median_all')[[LABEL[WHITE], LABEL[BLACK], LABEL[HISP]]]
print(main.to_string(float_format=lambda x: f'{x:,.0f}'))

print('\n=== Median ratios and dollar differences (white proxy vs others) ===')
cmp_rows = []
for year in WEALTH:
    mw = main.loc[year, LABEL[WHITE]]; mb = main.loc[year, LABEL[BLACK]]; mh = main.loc[year, LABEL[HISP]]
    cmp_rows.append({'year': year,
                     'ratio_white_black': mw / mb, 'diff_white_black_usd': mw - mb,
                     'ratio_white_hispanic': mw / mh, 'diff_white_hispanic_usd': mw - mh})
cmp = pd.DataFrame(cmp_rows).set_index('year')
print(cmp.to_string(float_format=lambda x: f'{x:,.2f}'))

print('\n=== SECONDARY SENSITIVITY: medians excluding negative values ===')
sens = table.pivot(index='year', columns='cohort', values='median_nonneg')[[LABEL[WHITE], LABEL[BLACK], LABEL[HISP]]]
print(sens.to_string(float_format=lambda x: f'{x:,.0f}'))
print('\nShare of negative values by cohort/year (%):')
print(table.pivot(index='year', columns='cohort', values='share_negative_pct')[[LABEL[WHITE], LABEL[BLACK], LABEL[HISP]]].to_string(float_format=lambda x: f'{x:.1f}'))

print('\n=== Sample sizes and nonresponse (attrition check) ===')
print(table.pivot(index='year', columns='cohort', values='n')[[LABEL[WHITE], LABEL[BLACK], LABEL[HISP]]].to_string())

print('\n=== Gap trajectory (white proxy minus black / hispanic, USD) ===')
for year in WEALTH:
    mw = main.loc[year, LABEL[WHITE]]
    print(f"{year}: white-{BLACK} {LABEL[BLACK]} gap = ${mw - main.loc[year, LABEL[BLACK]]:,.0f}; "
          f"white-{HISP} {LABEL[HISP]} gap = ${mw - main.loc[year, LABEL[HISP]]:,.0f}")

table.to_csv('outputs/median_wealth_by_cohort_year.csv', index=False)
cmp.to_csv('outputs/ratios_and_differences.csv')
print('\nSaved: outputs/median_wealth_by_cohort_year.csv, outputs/ratios_and_differences.csv')
