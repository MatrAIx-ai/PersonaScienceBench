"""
Which variable's effect on BA degree completion decreases from +0.3636 to -0.2293
(becoming insignificant) when race and academic characteristics are added?

Data: data/nls_ses_processed.csv (8,773 rows, no missing values).
Design (approved by researcher):
  Model A (base):     BA ~ SES + FAMILY SIZE + SEX
  Model B (full):     A + race dummies (ref=White) + ASVAB composite + PERCENTILE IN CLASS
  Curriculum measure: NOT present in the supplied file -> omitted (documented).
  Estimator: logistic regression (statsmodels Logit), log-odds scale primary;
             probit and OLS linear-probability (LPM) run as scale robustness checks.
  Significance: two-sided p < 0.05, standard MLE SEs.
  Specification grid: SES raw vs standardized x ASVAB raw vs standardized x
             family size continuous (log/siblings/z variants also checked).
Selection rule: best principled match to +0.3636 in the base model, then check the
             0.3636 -> -0.2293 insignificant pattern in the full model.
"""
import numpy as np
import pandas as pd
import statsmodels.api as sm
import statsmodels.formula.api as smf

RNG_NOTE = "No randomness used; all results deterministic MLE fits."

df = pd.read_csv("data/nls_ses_processed.csv").rename(columns={
    "SAMPLE_RACE": "race", "SAMPLE_SEX": "sex",
    "FAMILY SIZE OF SAMPLE": "famsize",
    "ABILITY: COMPOSITE OF ASVAB SCORE": "asvab",
    "BA DEGREE COMPLETED": "ba",
    "PERCENTILE IN CLASS": "pctl", "SES": "ses"})
df["ba"] = df["ba"].astype(int)
df["female"] = (df["sex"] == "Female").astype(int)
df["black"] = (df["race"] == "Black").astype(int)      # reference category = White
df["hispanic"] = (df["race"] == "Hispanic").astype(int)
df["ses_z"] = (df["ses"] - df["ses"].mean()) / df["ses"].std(ddof=0)
df["asvab_z"] = (df["asvab"] - df["asvab"].mean()) / df["asvab"].std(ddof=0)

def logit(y, X):
    return sm.Logit(y, sm.add_constant(X)).fit(disp=0)

def show(m, label):
    out = pd.DataFrame({"coef": m.params, "se": m.bse, "z": m.tvalues,
                        "p": m.pvalues, "OR": np.exp(m.params)})
    print(f"\n===== {label}  (n={int(m.nobs)}, pseudo-R2={m.prsquared:.4f}) =====")
    print(out.round(4).to_string())
    return out

# ---------- 1. Data summary ----------
print("DATA SUMMARY")
print(f"rows={len(df)}  missing={int(df.isna().sum().sum())}  "
      f"BA=1: {df.ba.sum()} ({df.ba.mean():.3%})  BA=0: {(1-df.ba).sum()}")
print(df[["famsize", "asvab", "pctl", "ses"]].describe().T[["mean", "std", "min", "max"]].round(3).to_string())
print("race:", df.race.value_counts().to_dict(), " sex:", df.sex.value_counts().to_dict())

# ---------- 2. Primary specification (logit) ----------
BASE = ["ses", "famsize", "female"]
FULL = BASE + ["black", "hispanic", "asvab_z", "pctl"]
m_base = logit(df.ba, df[BASE])
m_full = logit(df.ba, df[FULL])
t_base = show(m_base, "MODEL A (base): BA ~ SES + family size + female")
t_full = show(m_full, "MODEL B (full): A + Black/Hispanic dummies + ASVAB(z) + class percentile")

# ---------- 3. Specification grid (logit/probit), key variable trajectories ----------
print("\n===== SPECIFICATION GRID: base -> full coefficient for each background variable =====")
rows = []
for ses_v in ["ses", "ses_z"]:
    for acad in [["asvab_z", "pctl"], ["asvab", "pctl"]]:
        for race_base in [False, True]:
            base = [ses_v, "famsize", "female"] + (["black", "hispanic"] if race_base else [])
            full = base + acad + ([] if race_base else ["black", "hispanic"])
            m1, m2 = logit(df.ba, df[base]), logit(df.ba, df[full])
            for v in [ses_v, "famsize", "female"]:
                rows.append(dict(ses=ses_v, acad="+".join(acad), race_base=race_base, var=v,
                                 base_b=m1.params[v], base_p=m1.pvalues[v],
                                 full_b=m2.params[v], full_p=m2.pvalues[v]))
grid = pd.DataFrame(rows)
print(grid.round(4).to_string(index=False))
grid.to_csv("analysis/out_coefficient_grid.csv", index=False)

# ---------- 4. Scale robustness: probit and OLS linear probability ----------
print("\n===== SCALE ROBUSTNESS (base = SES + famsize + female; full = + race + ASVAB(z) + pctl) =====")
prob1 = sm.Probit(df.ba, sm.add_constant(df[BASE])).fit(disp=0)
prob2 = sm.Probit(df.ba, sm.add_constant(df[FULL])).fit(disp=0)
ols1 = smf.ols("ba ~ ses + famsize + female", df).fit(cov_type="HC1")
ols2 = smf.ols("ba ~ ses + famsize + female + black + hispanic + asvab_z + pctl", df).fit(cov_type="HC1")
cmp = pd.DataFrame({
    "logit_base": [m_base.params[v] for v in ["ses", "famsize", "female"]],
    "logit_base_p": [m_base.pvalues[v] for v in ["ses", "famsize", "female"]],
    "logit_full": [m_full.params[v] for v in ["ses", "famsize", "female"]],
    "logit_full_p": [m_full.pvalues[v] for v in ["ses", "famsize", "female"]],
    "probit_base": [prob1.params[v] for v in ["ses", "famsize", "female"]],
    "probit_full": [prob2.params[v] for v in ["ses", "famsize", "female"]],
    "LPM_base": [ols1.params[v] for v in ["ses", "famsize", "female"]],
    "LPM_full": [ols2.params[v] for v in ["ses", "famsize", "female"]],
    "LPM_full_p": [ols2.pvalues[v] for v in ["ses", "famsize", "female"]],
}, index=["ses", "famsize", "female"])
print(cmp.round(4).to_string())
cmp.to_csv("analysis/out_scale_robustness.csv")

# ---------- 5. Match check against cited figures 0.3636 / -0.2293 ----------
print("\n===== MATCH CHECK vs cited 0.3636 -> -0.2293 (insignificant) =====")
print("Variables positive & significant in some base model (candidates for a +0.3636 start):")
for v in ["ses", "ses_z", "female"]:
    lb = m_base.params.get(v, np.nan)
    pb = prob1.params[v] if v in prob1.params.index else sm.Probit(df.ba, sm.add_constant(df[["ses_z","famsize","female"]])).fit(disp=0).params.get(v, np.nan)
    print(f"  {v}: base logit {lb:.4f}, base probit {pb:.4f}")
print("SES across estimators, base -> full:")
print(f"  logit: {m_base.params['ses']:.4f} (p={m_base.pvalues['ses']:.2e}) -> {m_full.params['ses']:.4f} (p={m_full.pvalues['ses']:.4f})")
print(f"  probit:{prob1.params['ses']:.4f} -> {prob2.params['ses']:.4f} (p={prob2.pvalues['ses']:.4f})")
print(f"  LPM:   {ols1.params['ses']:.4f} (p={ols1.pvalues['ses']:.2e}) -> {ols2.params['ses']:.4f} (p={ols2.pvalues['ses']:.4f})  <- flips NEGATIVE, insignificant")
print("No specification reproducible from this file yields exactly 0.3636 -> -0.2293;")
print("SES is the only background variable with a positive base effect that collapses toward")
print("zero/negative and loses significance when race + academic characteristics enter (LPM flip).")

# ---------- 6. Final primary-model tables to disk ----------
t_base.to_csv("analysis/out_model_base.csv")
t_full.to_csv("analysis/out_model_full.csv")
print("\nSaved: out_model_base.csv, out_model_full.csv, out_coefficient_grid.csv, out_scale_robustness.csv")
