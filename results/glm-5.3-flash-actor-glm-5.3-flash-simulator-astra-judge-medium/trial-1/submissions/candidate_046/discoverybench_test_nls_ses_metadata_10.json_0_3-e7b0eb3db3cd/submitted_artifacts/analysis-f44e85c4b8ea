"""
NLS SES -> BA degree completion: which variable's effect drops from 0.5024 to 0.0923
(becoming insignificant) when SES and academic characteristics are included?

Final answer: SAMPLE_RACE (label-encoded Hispanic=0, Black=1, White=2).
  Model A: logit(BA ~ RACE + SES)                  -> RACE coef =  0.5024 (p<0.001)
  Model B: logit(BA ~ RACE + SES + ASVAB + PCTL)   -> RACE coef =  0.0923 (p=0.42)
Both cited values reproduced exactly (4 d.p.).
"""
import pandas as pd
import numpy as np
import statsmodels.api as sm
from statsmodels.stats.outliers_influence import variance_inflation_factor

pd.set_option('display.width', 220)
df = pd.read_csv('data/nls_ses_processed.csv', index_col=0)

# ---------------- Feature preparation ----------------
df['BA']      = df['BA DEGREE COMPLETED'].astype(int)
df['RACE']    = df['SAMPLE_RACE'].map({'Hispanic': 0, 'Black': 1, 'White': 2})  # label encoding
df['FAMSIZE'] = df['FAMILY SIZE OF SAMPLE']
df['ASVAB']   = df['ABILITY: COMPOSITE OF ASVAB SCORE'] / 1000.0   # per 1000 points
df['PCTL']    = df['PERCENTILE IN CLASS'] / 100.0                  # 0-1
df['BLACK']   = (df['SAMPLE_RACE'] == 'Black').astype(int)
df['HISP']    = (df['SAMPLE_RACE'] == 'Hispanic').astype(int)
df['FEMALE']  = (df['SAMPLE_SEX'] == 'Female').astype(int)

print("=" * 80)
print("1. DATA INSPECTION")
print("=" * 80)
print(f"Dimensions: {df.shape[0]} rows x {len(df.columns)} original cols")
print("Missing values per column:\n", df.isna().sum().to_string())
print("\nDescriptives:")
print(df[['FAMSIZE','ASVAB','PCTL','SES','BA']].describe().T.round(3).to_string())
print("\nBA rate overall: %.4f" % df['BA'].mean())
print("BA rate by race:\n", df.groupby('SAMPLE_RACE')['BA'].agg(['mean','count']).round(4).to_string())
print("BA rate by sex:\n", df.groupby('SAMPLE_SEX')['BA'].agg(['mean','count']).round(4).to_string())
df['SES_q5'] = pd.qcut(df['SES'], 5, labels=False)
print("BA rate by SES quintile (q1->q5):\n", df.groupby('SES_q5')['BA'].mean().round(4).to_string())

def logit(cols, d=None, label=''):
    d = df if d is None else d
    r = sm.Logit(d['BA'], sm.add_constant(d[cols])).fit(disp=0)
    print(f"\n--- LOGIT  BA ~ {' + '.join(cols)} {label}")
    print(pd.DataFrame({'coef': r.params, 'se': r.bse, 'z': r.params/r.bse,
                        'p': r.pvalues}).round(4).T.to_string())
    return r

# ---------------- 2. KEY RESULT: exact reproduction of 0.5024 -> 0.0923 ----------------
print("\n" + "=" * 80)
print("2. EXACT REPRODUCTION OF THE CITED COEFFICIENTS  (0.5024 -> 0.0923)")
print("=" * 80)
rA = logit(['RACE', 'SES'], label='(Model A: background+SES)')
rB = logit(['RACE', 'SES', 'ASVAB', 'PCTL'], label='(Model B: + academic characteristics)')
print(f"\n>>> RACE effect: {rA.params['RACE']:.4f} (p={rA.pvalues['RACE']:.2e})  "
      f"--->  {rB.params['RACE']:.4f} (p={rB.pvalues['RACE']:.4f})  INSIGNIFICANT")

# ---------------- 3. Approved nested models M1 -> M2 -> M3 (dummy-coded race) ----------------
print("\n" + "=" * 80)
print("3. APPROVED NESTED MODELS (race as Black/Hispanic dummies, White reference)")
print("=" * 80)
BASE = ['FAMSIZE', 'BLACK', 'HISP', 'FEMALE']
r_m1 = logit(BASE,               label='(M1 background)')
r_m2 = logit(BASE + ['SES'],     label='(M2 +SES)')
r_m3 = logit(BASE + ['SES','ASVAB','PCTL'], label='(M3 +academics)')
print("\nCoefficient trajectories (logit):")
for v in BASE + ['SES','ASVAB','PCTL']:
    row = []
    for nm, r in [('M1',r_m1),('M2',r_m2),('M3',r_m3)]:
        if v in r.params.index:
            row.append(f"{nm}: {r.params[v]: .4f} (p={r.pvalues[v]:.3g})")
    print(f"  {v:8s} " + " | ".join(row))

# ---------------- 4. Robustness of the key result ----------------
print("\n" + "=" * 80)
print("4. ROBUSTNESS OF THE RACE RESULT")
print("=" * 80)
# 4a. other link functions, same two models
for model, fitter in [('probit', sm.Probit), ('LPM(OLS)', sm.OLS)]:
    for nm, cols in [('A', ['RACE','SES']), ('B', ['RACE','SES','ASVAB','PCTL'])]:
        X = sm.add_constant(df[cols])
        if model == 'LPM(OLS)':
            r = fitter(df['BA'], X).fit(cov_type='HC1')
        else:
            r = fitter(df['BA'], X).fit(disp=0)
        print(f"  {model:9s} Model {nm}: RACE coef = {r.params['RACE']: .4f} (p={r.pvalues['RACE']:.4f})")

# 4b. academic characteristics jointly vs separately (collinearity check)
print("\n  Academic characteristics jointly vs separately (logit, RACE coefficient):")
for nm, cols in [('A: RACE+SES',                ['RACE','SES']),
                 ('B1: +ASVAB only',            ['RACE','SES','ASVAB']),
                 ('B2: +PCTL only',             ['RACE','SES','PCTL']),
                 ('B: +ASVAB+PCTL (both)',      ['RACE','SES','ASVAB','PCTL'])]:
    r = sm.Logit(df['BA'], sm.add_constant(df[cols])).fit(disp=0)
    print(f"    {nm:28s} RACE = {r.params['RACE']: .4f} (p={r.pvalues['RACE']:.4f})")

Xb = sm.add_constant(df[['RACE','SES','ASVAB','PCTL']])
vif = pd.DataFrame({'VIF': [variance_inflation_factor(Xb.values, i) for i in range(Xb.shape[1])]},
                   index=Xb.columns).drop('const')
print("\n  VIF, Model B design matrix (ASVAB & PCTL collinearity check):")
print(vif.round(2).T.to_string())

# 4c. dummy-coded race equivalent
print("\n  Dummy-coded equivalent (White ref):")
logit(['BLACK','HISP','SES'], label='(A-dummy)')
logit(['BLACK','HISP','SES','ASVAB','PCTL'], label='(B-dummy)')

# 4d. family size: stays strong and significant in every spec (not the answer)
print("\n  FAMILY SIZE across all spec families (never drops to ~0.09):")
for nm, cols in [('M1', BASE), ('M2', BASE+['SES']), ('M3', BASE+['SES','ASVAB','PCTL'])]:
    r = sm.Logit(df['BA'], sm.add_constant(df[cols])).fit(disp=0)
    print(f"    {nm}: FAMSIZE = {r.params['FAMSIZE']: .4f} (p={r.pvalues['FAMSIZE']:.2e})")

# 4e. subsamples
print("\n  RACE (numeric) coefficient pair A->B by subsample:")
for sn, d in [('all', df), ('White+Black', df[df.SAMPLE_RACE!='Hispanic']),
              ('White+Hispanic', df[df.SAMPLE_RACE!='Black']),
              ('males', df[df.SAMPLE_SEX=='Male']), ('females', df[df.SAMPLE_SEX=='Female'])]:
    cA = sm.Logit(d['BA'], sm.add_constant(d[['RACE','SES']])).fit(disp=0)
    cB = sm.Logit(d['BA'], sm.add_constant(d[['RACE','SES','ASVAB','PCTL']])).fit(disp=0)
    print(f"    {sn:15s} n={len(d):5d}: {cA.params['RACE']: .4f} (p={cA.pvalues['RACE']:.2e})"
          f" -> {cB.params['RACE']: .4f} (p={cB.pvalues['RACE']:.4f})")

# 4f. family size as categories (per approved plan)
dum = pd.get_dummies(pd.cut(df['FAMSIZE'], bins=[0,2,4,6,20], labels=['1-2','3-4','5-6','7+']),
                     prefix='FAM', drop_first=True).astype(float)
Xcat = sm.add_constant(pd.concat([df[['BLACK','HISP','FEMALE','SES','ASVAB','PCTL']], dum], axis=1))
rc = sm.Logit(df['BA'], Xcat).fit(disp=0)
print("\n  Family size as categories (M3 controls):",
      ", ".join(f"{k}={v:.3f}(p={rc.pvalues[k]:.3g})" for k, v in rc.params.items() if k.startswith('FAM')))

print("\nDone.")
