"""
NLS SES x Race interaction analysis (DiscoveryBench: nls_ses)
Question: Is the relation between SES and chances of BA degree completion
affected by the racial lines of the individual?

Workflow:
 Step 1 - Descriptives: BA rates by race x SES tertile, Wilson CIs,
          per-race SES gradients (logits).
 Step 2 - Logistic interaction models M1-M3 (+M4 triple interaction),
          LR test of the interaction block, ORs by race,
          LPM robustness, Firth-style check (penalized via large-events
          caveat) and SES-tertile robustness.
"""
import pandas as pd, numpy as np
import statsmodels.api as sm, statsmodels.formula.api as smf
from scipy import stats

df = pd.read_csv('data/nls_ses_processed.csv', index_col=0)
df = df.rename(columns={
    'FAMILY SIZE OF SAMPLE': 'FAMILY_SIZE',
    'ABILITY: COMPOSITE OF ASVAB SCORE': 'ASVAB',
    'PERCENTILE IN CLASS': 'PCTL'})
df['BA'] = df['BA DEGREE COMPLETED'].astype(int)
df['race'] = df['SAMPLE_RACE']
df['sex'] = df['SAMPLE_SEX']
df['ses_t'] = pd.qcut(df['SES'], 3, labels=['low', 'mid', 'high'])

out = []
def say(s=''):
    print(s); out.append(str(s))

say('=== STEP 1: Descriptives ===')
say('\nBA rate by race x SES tertile:')
say(df.pivot_table(index='race', columns='ses_t', values='BA', aggfunc='mean').round(4).to_string())
say('\nCell counts:')
say(df.pivot_table(index='race', columns='ses_t', values='BA', aggfunc='count').to_string())

def wilson(k, n, z=1.96):
    p = k / n; d = 1 + z*z / n; c = p + z*z/(2*n)
    m = z * np.sqrt(p*(1-p)/n + z*z/(4*n*n))
    return (c-m)/d, (c+m)/d

say('\nBA counts and Wilson 95% CI by race x SES tertile:')
for r in ['White', 'Black', 'Hispanic']:
    for s in ['low', 'mid', 'high']:
        sub = df[(df.race == r) & (df.ses_t == s)]
        k, nn = sub.BA.sum(), len(sub)
        lo, hi = wilson(k, nn)
        say(f'{r:9s} {s:4s}: {int(k):3d}/{nn:4d} = {k/nn:.4f}  CI[{lo:.4f},{hi:.4f}]')

say('\nPer-race SES logit gradients:')
grad = {}
for r in ['White', 'Black', 'Hispanic']:
    sub = df[df.race == r]
    m = smf.logit('BA ~ SES', data=sub).fit(disp=0)
    grad[r] = np.exp(m.params['SES'])
    say(f'{r}: OR={np.exp(m.params["SES"]):.3f}, 95% CI '
        f'{np.exp(m.conf_int().loc["SES"]).round(3).tolist()}, p={m.pvalues["SES"]:.4g}, '
        f'n={len(sub)}, events={int(sub.BA.sum())}')

say('\n=== STEP 2: Interaction models ===')
m1 = smf.logit('BA ~ SES + C(race)', data=df).fit(disp=0)
m2 = smf.logit('BA ~ SES * C(race)', data=df).fit(disp=0)
m3 = smf.logit('BA ~ SES * C(race) + ASVAB + PCTL + FAMILY_SIZE + C(sex)',
               data=df).fit(disp=0)
m4 = smf.logit('BA ~ SES * C(race) * C(sex)', data=df).fit(disp=0)

for tag, mod in [('M1', m1), ('M2', m2), ('M3', m3), ('M4', m4)]:
    say(f'\n--- {tag}: logL={mod.llf:.2f}, converged={mod.mle_retvals["converged"]}')
    ci = np.exp(mod.conf_int())
    for name in mod.params.index:
        say(f'  {name:32s} b={mod.params[name]:+.4f}  OR={np.exp(mod.params[name]):.3f}  '
            f'CI[{ci.loc[name,0]:.3f},{ci.loc[name,1]:.3f}]  p={mod.pvalues[name]:.4g}')

lr = 2*(m2.llf - m1.llf); df_lr = int(m2.df_model - m1.df_model)
say(f'\nLR test, interaction block (M2 vs M1): chi2={lr:.3f}, df={df_lr}, '
    f'p={stats.chi2.sf(lr, df_lr):.4g}')

say('\nSES odds ratios by race (from M2 and M3):')
cov2, cov3 = m2.cov_params(), m3.cov_params()
def or_by_race(mod, cov, lab):
    # Reference race is Black (design has T.Hispanic / T.White dummies)
    bB = mod.params['SES']
    varB = cov.loc['SES','SES']; seB = np.sqrt(varB)
    rows = [('Black', bB, np.exp(bB), np.exp(bB-1.96*seB), np.exp(bB+1.96*seB))]
    for r, dummy in [('Hispanic', 'C(race)[T.Hispanic]'), ('White', 'C(race)[T.White]')]:
        inter = f'SES:{dummy}'
        b = bB + mod.params[inter]
        var = varB + cov.loc[inter,inter] + 2*cov.loc['SES',inter]
        se = np.sqrt(var)
        rows.append((r, b, np.exp(b), np.exp(b-1.96*se), np.exp(b+1.96*se)))
    for r, b, orv, lo, hi in rows:
        say(f'  {lab} SES OR ({r}): b={b:+.4f}  OR={orv:.3f}  CI[{lo:.3f},{hi:.3f}]')
or_by_race(m2, cov2, 'M2')
or_by_race(m3, cov3, 'M3')

say('\n=== Robustness ===')
# LPM with robust SEs
lpm = smf.ols('BA ~ SES * C(race) + ASVAB + PCTL + FAMILY_SIZE + C(sex)',
              data=df).fit(cov_type='HC1')
say('\nLPM (HC1) interaction terms:')
for name in lpm.params.index:
    if ':' in name and 'SES' in name:
        say(f'  {name:32s} b={lpm.params[name]:+.5f}  p={lpm.pvalues[name]:.4g}')

# SES tertile version
df['ses3'] = pd.Categorical(df.ses_t, ['low','mid','high'])
m2t = smf.logit('BA ~ C(ses3) * C(race)', data=df).fit(disp=0)
say('\nLogit with SES tertiles (ref = low SES, White):')
ci = np.exp(m2t.conf_int())
for name in m2t.params.index:
    say(f'  {name:32s} OR={np.exp(m2t.params[name]):.3f}  '
        f'CI[{ci.loc[name,0]:.3f},{ci.loc[name,1]:.3f}]  p={m2t.pvalues[name]:.4g}')

# Predicted probabilities along SES by race (M3), mean covariates
say('\nPredicted P(BA) from M3 at SES grid (mean covariates, Female):')
grid = pd.DataFrame({'SES': np.linspace(-2.4, 2.7, 6)})
for r in ['White', 'Black', 'Hispanic']:
    for sx in ['Female']:
        g = grid.copy(); g['race'] = r; g['sex'] = sx
        g['ASVAB'] = df.ASVAB.mean(); g['PCTL'] = df.PCTL.mean(); g['FAMILY_SIZE'] = df.FAMILY_SIZE.mean()
        p = m3.predict(g)
        say(f'  {r:9s} {sx}: ' + '  '.join(f'{x:.4f}' for x in p))

# Rare-event note: penalized (Firth-type) logit via statsmodels GLM with L2 is not Firth;
# use smf.Logit.fit_regularized as directional stability check
m2r = smf.logit('BA ~ SES * C(race)', data=df).fit_regularized(disp=0, alpha=0.5)
say('\nL2-penalized logit (alpha=0.5) SES x race coefficients (direction check):')
for name in m2r.params.index:
    say(f'  {name:32s} b={m2r.params[name]:+.4f}')

with open('analysis_output.txt', 'w') as f:
    f.write('\n'.join(out))
print('\nSaved analysis_output.txt')
