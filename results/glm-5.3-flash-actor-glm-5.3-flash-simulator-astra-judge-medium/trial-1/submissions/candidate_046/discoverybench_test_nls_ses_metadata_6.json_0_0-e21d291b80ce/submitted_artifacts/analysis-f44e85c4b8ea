import pandas as pd
import numpy as np

df = pd.read_csv('data/nls_ses_processed.csv')
df['BA'] = df['BA DEGREE COMPLETED'].astype(int)

def stratified(tablename, q=5):
    labels = [f'Q{i}' for i in range(1, q+1)]
    df['SES_bin'] = pd.qcut(df['SES'], q=q, labels=labels)
    tab = df.pivot_table(index='SES_bin', columns='SAMPLE_RACE', values='BA',
                         aggfunc=['mean', 'count', 'sum'])
    print(f'=== {tablename}: BA rate by SES quintile x race ===')
    rates = tab['mean'][['White','Black','Hispanic']]
    ns = tab['count'][['White','Black','Hispanic']]
    completes = tab['sum'][['White','Black','Hispanic']]
    out = rates.copy()
    out['gap_abs(B-W)'] = rates['Black'] - rates['White']
    out['ratio(B/W)'] = np.where(rates['White']>0, rates['Black']/rates['White'], np.nan)
    out['n_White'] = ns['White']; out['n_Black'] = ns['Black']; out['n_Hisp'] = ns['Hispanic']
    out['completions_White'] = completes['White'].astype(int)
    out['completions_Black'] = completes['Black'].astype(int)
    out['completions_Hisp'] = completes['Hispanic'].astype(int)
    print(out.round(4).to_string())
    print()
    return out

q5 = stratified('QUINTILES', 5)
q4 = stratified('QUARTILES (sensitivity)', 4)
q3 = stratified('TERCILES (sensitivity)', 3)

# SES bin edges for reference
print('SES quintile edges:', pd.qcut(df['SES'], 5, retbins=True)[1].round(3))
print('SES quartile edges:', pd.qcut(df['SES'], 4, retbins=True)[1].round(3))

# Save quintile table
q5.to_csv('analysis/quintile_table.csv')
