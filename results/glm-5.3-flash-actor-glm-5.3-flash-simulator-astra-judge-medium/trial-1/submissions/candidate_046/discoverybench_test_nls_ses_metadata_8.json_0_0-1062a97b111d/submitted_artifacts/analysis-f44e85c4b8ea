"""
Analysis: Locate the factor -0.9568 associated with BA degree completion
between two races in the NLS SES dataset (DiscoveryBench: nls_ses_metadata_8).

Workflow:
 1. Load and inspect data (shape, columns, race levels, BA rates, missing values).
 2. Variant 1: single logistic model of BA completion with race x covariate
    interactions (one covariate at a time to keep the model stable with only
    236 BA=1 events). Report all coefficients with SE and 95% CI.
 3. Variant 2: separate logistic models per race (BA ~ SES), pairwise
    coefficient comparisons.
 4. Identify which pair of races reproduces the factor -0.9568, and report the
    direction (reference category).
"""
import warnings
import numpy as np
import pandas as pd
import statsmodels.formula.api as smf

warnings.filterwarnings("ignore")
TARGET = -0.9568
OUT = []

def log(msg=""):
    print(msg)
    OUT.append(str(msg))

def pick(res, frag, exclude=":SES"):
    """Return (name, coef, se, p) for the first param whose name contains frag."""
    for k in res.params.index:
        if frag in k and exclude not in k:
            return k, res.params[k], res.bse[k], res.pvalues[k]
    raise KeyError(frag)

# ---------------------------------------------------------------- 1. Inspection
df = pd.read_csv("data/nls_ses_processed.csv")
df = df.rename(columns={
    "FAMILY SIZE OF SAMPLE": "FAM",
    "ABILITY: COMPOSITE OF ASVAB SCORE": "ASVAB",
    "PERCENTILE IN CLASS": "PCTL",
})
df["BA"] = df["BA DEGREE COMPLETED"].astype(int)
df["RACE"] = df["SAMPLE_RACE"]
df["MALE"] = (df["SAMPLE_SEX"] == "Male").astype(int)

log("=" * 78)
log("1. DATA INSPECTION")
log("=" * 78)
log(f"Shape: {df.shape[0]} rows x {df.shape[1]} columns")
log(f"Missing values per column:\n{df.isna().sum().to_string()}")
log(f"Race levels: {df['RACE'].value_counts().to_dict()}")
log("BA completion rate by race:")
log(pd.crosstab(df["RACE"], df["BA"], normalize="index").round(4).to_string())

COVS = ["SES", "ASVAB", "PCTL", "FAM", "MALE"]

# ------------------------------------------------- 2. Variant 1: race x covariate
log("")
log("=" * 78)
log("2. VARIANT 1: single logistic model BA ~ C(RACE) * covariate (ref = White)")
log("=" * 78)
matches_v1 = []
for cov in COVS:
    m = smf.logit(f"BA ~ C(RACE, Treatment(reference='White')) * {cov}", data=df).fit(disp=0)
    log(f"\n--- covariate = {cov} (pseudoR2={m.prsquared:.4f}, n={int(m.nobs)}) ---")
    for k in m.params.index:
        v, se, p = m.params[k], m.bse[k], m.pvalues[k]
        flag = ""
        if abs(v - TARGET) < 0.0005:
            flag = "  <<<< MATCHES -0.9568"
            matches_v1.append((cov, k, v, se, p))
        log(f"  {k:40s} {v: .6f}  SE={se:.4f}  95%CI=[{v-1.96*se:.3f},{v+1.96*se:.3f}]  p={p:.4g}{flag}")

log("")
log("VARIANT 1 matches:")
for cov, k, v, se, p in matches_v1:
    log(f"  covariate={cov}; term={k}; coef={v:.6f} (SE={se:.4f}, p={p:.3g})")

# ------------------------------------------------- 3. Variant 2: stratified models
log("")
log("=" * 78)
log("3. VARIANT 2: separate logistic models per race (BA ~ SES), pairwise diffs")
log("=" * 78)
coefs = {}
for r in ["White", "Black", "Hispanic"]:
    mr = smf.logit("BA ~ SES", data=df[df["RACE"] == r]).fit(disp=0)
    coefs[r] = (mr.params["SES"], mr.bse["SES"])
    log(f"  {r:9s} SES coef = {coefs[r][0]: .4f}  SE={coefs[r][1]:.4f}")
for a, b in [("Black", "White"), ("Hispanic", "White"), ("Black", "Hispanic"),
             ("White", "Black"), ("White", "Hispanic"), ("Hispanic", "Black")]:
    d = coefs[a][0] - coefs[b][0]
    se = float(np.sqrt(coefs[a][1] ** 2 + coefs[b][1] ** 2))
    flag = "  <<<< MATCHES -0.9568" if abs(d - TARGET) < 0.02 else ""
    log(f"  {a} - {b}: diff = {d: .4f}  SE={se:.4f}{flag}")

# --------------------------------------------------------- 4. Focus on the match
log("")
log("=" * 78)
log("4. FOCUS: the coefficient that reproduces -0.9568")
log("=" * 78)
m = smf.logit("BA ~ C(RACE, Treatment(reference='White')) * SES", data=df).fit(disp=0)
log("Model: logit(P(BA=1)) ~ race + SES + race x SES   (reference race = White)")
log(m.summary().tables[1].as_text())
kb, vb, seb, pb = pick(m, "Black")
log(f"Interpretation: logit coefficient for Black (vs White) = {vb:.6f}")
log(f"Odds ratio Black/White at SES = 0: {np.exp(vb):.4f}")
log("Equivalent parameterization with Black as reference gives White coefficient = +0.9568;")
log("therefore the factor -0.9568 corresponds to Black compared to White.")
log("")
log("Robustness check: additive model (no interaction), Black vs White coefficient:")
m_add = smf.logit("BA ~ C(RACE, Treatment(reference='White')) + SES", data=df).fit(disp=0)
ka, va, sea, pa = pick(m_add, "Black")
log(f"  {va:.4f} (SE={sea:.4f}, p={pa:.3g})  -- same sign/magnitude order; the exact")
log("  -0.9568 arises in the race x SES specification (evaluated at SES = 0).")

with open("analysis_results.txt", "w") as fh:
    fh.write("\n".join(OUT))
print("\nSaved analysis_results.txt")
