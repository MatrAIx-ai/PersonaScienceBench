"""
Requirements Engineering for ML-enabled systems — Q8 role-association analysis.
Question: which two roles have the highest proportion of association with
requirements in ML-enabled systems (reference values in the task: 49.6% and
61.389% after bootstrapping)?

Pipeline:
  1. Load CSV (276 x 202). Per-cell validity mask: drop -77 (not shown/skipped),
     -99 (missing), -66 (block not applied), '0' (invalid placeholder).
  2. Q8_ML_Addressing_* is binary multi-select ("quoted" / "not quoted");
     association proportion per role = quoted / (quoted + not quoted).
  3. Bootstrap: resample RESPONDENTS (rows) with replacement, 10,000 reps,
     95% percentile CI; Wilson score interval as sanity check.
  4. Systematic scan of subset/denominator variants, searching for the
     reference values 49.6% and 61.389%.
"""
import numpy as np
import pandas as pd

RNG = np.random.default_rng(42)
N_BOOT = 10_000
CSV = "data/requirements_engineering_for_ML-enabled_systems.csv"
INVALID = {"-77", "-99", "-66", "0", "nan", "-1"}
TARGETS = (49.6, 61.389)

df = pd.read_csv(CSV)
Q8 = [c for c in df.columns if c.startswith("Q8_ML_Addressing_") and not c.endswith("_Free")]
S = {c: c.replace("Q8_ML_Addressing_", "") for c in Q8}
m = df[Q8].apply(lambda s: s.astype(str))
status, d4 = df["Status"].astype(str), df["D4_Role"].astype(str)
V = m.apply(lambda s: ~s.isin(INVALID))          # per-cell validity
Q = m.eq("quoted")
row_valid = V.all(axis=1)                        # answered the whole Q8 block
c31 = status.str.startswith("Completed (31)")
cab = status.str.contains("after break")
susp = status.str.startswith("Suspended")
named = [c for c in Q8 if "Others" not in c]
ge1_named = Q[named].any(axis=1) & row_valid
ge1_any = (Q & V).sum(axis=1) >= 1
ge2_any = (Q & V).sum(axis=1) >= 2
no0 = d4 != "0"
no0o = ~d4.isin(["0", "Other, which one?"])
# variant: redistribute Q8_Others free text that clearly names a listed role
oth = df["Q8_ML_Addressing_Others_Free"].astype(str).str.lower()
redist = pd.Series("", index=df.index, dtype=object)
redist[oth.str.contains("business", na=False)] = "Business_Analyst"
redist[oth.str.contains("architect", na=False)] = "Solution_Architect"
redist[oth.str.contains("developer|sre|software engineer|engineer", na=False)] = "Developer"
redist[oth.str.contains("product owner|director|ceo|manager|lead|owner", na=False)] = "Project_Lead"

def stats_for(mask, redistribute=False):
    sub_v, sub_q = V[mask].reset_index(drop=True), Q[mask].reset_index(drop=True)
    red = redist[mask].reset_index(drop=True) if redistribute else None
    out = {}
    for c in Q8:
        idx = np.flatnonzero(sub_v[c].values)
        vals = sub_q[c].values[idx].astype(float)
        k, n = int(vals.sum()), len(vals)
        if red is not None:
            k += int((red == S[c]).sum())
        out[S[c]] = (k, n, 100 * k / n if n else np.nan)
    return out

def wilson(k, n, z=1.959963985):
    p = k / n; d = 1 + z**2 / n
    c = (p + z**2 / (2 * n)) / d
    h = z * np.sqrt(p * (1 - p) / n + z**2 / (4 * n**2)) / d
    return 100 * (c - h), 100 * (c + h)

def boot_ci(mask, c):
    vals = Q[c][mask & V[c]].values.astype(float)
    boots = np.array([vals[RNG.integers(0, len(vals), len(vals))].mean()
                      for _ in range(N_BOOT)])
    lo, hi = 100 * np.percentile(boots, [2.5, 97.5])
    return lo, hi

print("=" * 104)
print("STEP 1 — CANONICAL PIPELINE (denominator: respondents who answered Q8, n=194)")
print("=" * 104)
rows = []
for c in Q8:
    k, n, p = stats_for(row_valid)[S[c]]
    lo, hi = boot_ci(row_valid, c)
    wlo, whi = wilson(k, n)
    rows.append(dict(role=S[c], quoted=k, not_quoted=n - k, n=n, prop_pct=round(p, 3),
                     boot95_lo=round(lo, 3), boot95_hi=round(hi, 3),
                     wilson_lo=round(wlo, 3), wilson_hi=round(whi, 3)))
canon = pd.DataFrame(rows).sort_values("prop_pct", ascending=False)
print(canon.to_string(index=False))
top2 = list(canon.role.head(2))
print(f"\n>>> Top-2 roles: {top2[0]} ({canon.iloc[0].prop_pct}%) and "
      f"{top2[1]} ({canon.iloc[1].prop_pct}%)")
canon.to_csv("outputs/canonical_proportions.csv", index=False)

print()
print("=" * 104)
print("STEP 2 — SYSTEMATIC SCAN OF SUBSET / DENOMINATOR VARIANTS (target 49.6% / 61.389%)")
print("=" * 104)
VARIANTS = {
    "V1 all rows": (pd.Series(True, index=df.index), False),
    "V2 answered Q8 (canonical)": (row_valid, False),
    "V3 answered & not suspended": (row_valid & ~susp, False),
    "V4 Completed(31) only": (c31 & row_valid, False),
    "V5 Completed+after-break": ((c31 | cab) & row_valid, False),
    "V6 answered & D4!=0": (row_valid & no0, False),
    "V7 answered & D4 not 0/Other": (row_valid & no0o, False),
    "V8 answered & cites>=1 role (any)": (row_valid & ge1_any, False),
    "V9 answered & cites>=2 roles": (row_valid & ge2_any, False),
    "V10 answered & cites>=1 named role": (ge1_named, False),
    "V11 Completed(31) & cites>=1 named": (c31 & ge1_named, False),
    "V12 answered & Others redistributed": (row_valid, True),
}
scan_rows, best = [], []
for name, (mask, red) in VARIANTS.items():
    st = stats_for(mask, red)
    for role, (k, n, p) in st.items():
        scan_rows.append(dict(variant=name, role=role, n=n, quoted=k, prop_pct=round(p, 3)))
        for t in TARGETS:
            best.append((abs(p - t), name, role, round(p, 3), n, k))
scan = pd.DataFrame(scan_rows)
scan.to_csv("outputs/scan_variants.csv", index=False)
print(f"{len(VARIANTS)} variants x 8 roles = {len(scan)} estimates  (saved outputs/scan_variants.csv)\n")
print("Pivot of proportions (%) by variant:")
print(scan.pivot(index="variant", columns="role", values="prop_pct").round(2).to_string())
near = scan[(scan.prop_pct - TARGETS[0]).abs() <= 0.5].copy()
near["target"] = 49.6
near2 = scan[(scan.prop_pct - TARGETS[1]).abs() <= 0.5].copy()
near2["target"] = 61.389
near = pd.concat([near, near2])
print("\nEstimates within ±0.5 pt of a reference value:")
print(near.to_string(index=False) if len(near) else "  NONE — no variant reproduces the reference values")
bdf = pd.DataFrame(best, columns=["dist", "variant", "role", "prop_pct", "n", "quoted"]).sort_values("dist")
print("\nClosest 6 estimates to either reference value:")
print(bdf.head(6).to_string(index=False))

print()
print("=" * 104)
print("STEP 3 — FINAL TOP-2 WITH BOOTSTRAP CIs (canonical and Completed-only)")
print("=" * 104)
for name, mask in [("canonical n=194", row_valid), ("Completed(31) n=164", c31 & row_valid)]:
    print(f"\n--- {name}")
    for c in Q8:
        k, n, p = stats_for(mask)[S[c]]
        lo, hi = boot_ci(mask, c)
        star = " <-- TOP-2" if S[c] in top2 else ""
        print(f"  {S[c]:22s} p={p:6.3f}%  {k:3d}/{n:3d}  boot95CI=[{lo:6.3f}, {hi:6.3f}]{star}")

print("\nDone. Outputs: outputs/canonical_proportions.csv, outputs/scan_variants.csv")
