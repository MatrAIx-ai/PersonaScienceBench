"""Bounded deterministic reconciliation scan for the reference values
49.6% and 61.389% (95% CI [49.219,49.981] / [60.955,61.822])."""
import pandas as pd, numpy as np
from fractions import Fraction

df = pd.read_csv('data/requirements_engineering_for_ML-enabled_systems.csv')
Q8 = [c for c in df.columns if c.startswith('Q8_ML_Addressing_') and not c.endswith('_Free')]
S = {c: c.replace('Q8_ML_Addressing_','') for c in Q8}
m = df[Q8].apply(lambda s: s.astype(str))
status, d4 = df['Status'].astype(str), df['D4_Role'].astype(str)
NEG = {'-77','-99','-66','-1'}
row_valid = m.apply(lambda s: ~s.isin(NEG | {'0'})).all(axis=1)
c31 = status.str.startswith('Completed (31)'); cab = status.str.contains('after break')
named = [c for c in Q8 if 'Others' not in c]
d4_valid = ~d4.isin(['0','Other, which one?'])
TOL = 0.05  # points
targets = {'DS_49.6': 49.6, 'PL_61.389': 61.389}

hits = []
def check(tag, num, den, role):
    if den <= 0: return
    p = 100*num/den
    for tname, t in targets.items():
        if abs(p - t) <= TOL:
            hits.append((tag, role, num, den, round(p,3), tname))

def run(tag, mask, treat77):  # treat77: 'exclude' | 'as_notquoted'
    if treat77 == 'exclude':
        sub = m[mask]
        Q = sub.eq('quoted'); V = sub.apply(lambda s: ~s.isin(NEG))
        for c in Q8: check(tag, int(Q[c][V[c]].sum()), int(V[c].sum()), S[c])
        # row-level condition on citing >=1 named role, computed inside this subset
        sub_named = Q[named].any(axis=1) & V[named].all(axis=1)
        for c in Q8: check(tag+'|ge1named', int(Q[c][sub_named & V[c]].sum()), int(sub_named[V[c]].sum()), S[c])
    else:  # -77 and all negatives counted as 'not quoted', denominator = all rows in mask
        sub = m[mask]
        for c in Q8:
            check(tag+'|neg-as-NQ', int(sub[c].eq('quoted').sum()), len(sub), S[c])

print('(a) denominator 276, negatives as not quoted:')
run('a-all-negNQ', pd.Series(True, index=df.index), 'as_notquoted')
print('(b,c,d) condition x status x treatment grid:')
base_masks = {
    'all': pd.Series(True, index=df.index),
    'completed(164)': c31, 'completed+break(188)': c31 | cab,
    'D4valid': d4_valid, 'D4valid&completed': d4_valid & c31, 'D4valid&comp+break': d4_valid & (c31|cab),
    'exclSuspended': ~status.str.startswith('Suspended'),
}
for mn, mk in base_masks.items():
    for tr in ['exclude','as_notquoted']:
        run(f'{mn}|{tr}', mk, tr)

print('(e) share-of-citations and share-of-valid-cells:')
Qall = m.eq('quoted'); Vall = m.apply(lambda s: ~s.isin(NEG))
row_valid_full = Vall.all(axis=1)
tot_cit = int(Qall[Vall].sum().sum()); tot_named_cit = int(Qall[named][Vall[named]].sum().sum())
for c in Q8:
    k = int(Qall[c][Vall[c]].sum())
    check('share-of-all-citations', k, tot_cit, S[c])
    check('share-of-named-citations', k, tot_named_cit, S[c])
    check('share-of-valid-cells', k, int(Vall[c].sum())*8, S[c])  # not meaningful but included
    # cells-based (per-column denominator, not requiring whole row valid):
    check('cells-valid-denominator', k, int(Vall[c].sum()), S[c])

print('\n(f) integer fraction search: k/N within ±0.05 pt of targets, N in 100..400:')
for tname, t in targets.items():
    fr = []
    for N in range(100, 401):
        k = round(t*N/100)
        if k <= N and abs(100*k/N - t) <= TOL:
            fr.append((N, k, round(100*k/N,4)))
    print(f'  {tname} ({t}%): candidates k/N =', fr[:12], f'... total {len(fr)}')
    exact = [(N,k) for N,k,p in fr if abs(100*k/N - t) < 1e-6]
    print(f'    exactly equal: {exact}')

print('\nALL HITS (±0.05 pt):')
if hits:
    h = pd.DataFrame(hits, columns=['variant','role','num','den','prop_pct','target'])
    print(h.to_string(index=False)); h.to_csv('outputs/reconciliation_hits.csv', index=False)
else:
    print('  NONE — no variant reproduces 49.6% or 61.389% within ±0.05 pt.')
