"""
Analysis: Most commonly used requirements-elicitation technique in ML-enabled
system projects (Q9 block of requirements_engineering_for_ML-enabled_systems.csv).

Method (approved by researcher):
  - Q9 columns are binary-encoded: 'quoted' = technique selected/used,
    'not quoted' = not selected, '-77' = question skipped (missing).
  - 'Most commonly used' = highest proportion of 'quoted' among respondents
    who answered Q9 (n = 194; 82 rows with '-77' excluded).
  - Statistic bootstrapped: proportion of respondents selecting each technique.
  - 10,000 bootstrap resamples (with replacement, n=194), seed=42,
    percentile 95% CIs (2.5 / 97.5).
  - Also reported: bootstrap probability that Interviews is the top-ranked
    technique in a resample; sensitivity analysis with denominator 276
    ('-77' treated as 'not used').
  - Codes -99 / -66 (not applicable) handled: none occur in the main Q9
    columns; they are excluded from any numerators/denominators if present.
"""
import numpy as np
import pandas as pd

SEED = 42
N_BOOT = 10_000
CSV = "data/requirements_engineering_for_ML-enabled_systems.csv"

TECHS = [
    "Q9_ML_Elicitation_Interviews",
    "Q9_ML_Elicitation_Scenarios",
    "Q9_ML_Elicitation_Prototyping",
    "Q9_ML_Elicitation_Workshops_Meetings",
    "Q9_ML_Elicitation_Observation",
    "Q9_ML_Elicitation_Others",
]

def main():
    rng = np.random.default_rng(SEED)
    df = pd.read_csv(CSV, keep_default_na=False)

    # Missing-code audit for the Q9 block
    print("Missing-code audit (Q9 main columns):")
    print(df[TECHS].apply(lambda s: s.value_counts().to_dict()).to_string())

    ans = df[~(df[TECHS] == "-77").any(axis=1)].copy()
    n = len(ans)
    print(f"\nRespondents answering Q9 (no '-77'): n = {n}")

    X = np.column_stack([(ans[c] == "quoted").astype(int).to_numpy() for c in TECHS])
    labels = [c.replace("Q9_ML_Elicitation_", "") for c in TECHS]

    obs = X.mean(axis=0) * 100
    print("\nObserved proportions (%) among n =", n)
    for l, o in zip(labels, obs):
        print(f"  {l:20s} count={X[:, labels.index(l)].sum():3d}  p={o:6.2f}%")

    # Bootstrap
    idx = rng.integers(0, n, size=(N_BOOT, n))
    boot = X[idx].mean(axis=1) * 100          # (N_BOOT, 6)
    lo, hi = np.percentile(boot, [2.5, 97.5], axis=0)

    print(f"\nBootstrap results ({N_BOOT} resamples, seed={SEED}, percentile 95% CI):")
    print(f"{'Technique':22s}{'obs%':>8s}{'CI low':>10s}{'CI high':>10s}")
    for i, l in enumerate(labels):
        print(f"{l:22s}{obs[i]:8.2f}{lo[i]:10.2f}{hi[i]:10.2f}")

    # Gap between Interviews and the runner-up block
    runner_up = boot[:, 1:].max(axis=1)
    gap = boot[:, 0] - runner_up
    print(f"\nBootstrap gap Interviews - best rival: mean={gap.mean():.2f} pp, "
          f"95% CI [{np.percentile(gap,2.5):.2f}, {np.percentile(gap,97.5):.2f}] pp, "
          f"P(gap>0)={100*np.mean(gap>0):.2f}%")

    # Probability that Interviews is the top technique in a resample
    p_top = 100 * np.mean(boot[:, 0] >= boot[:, 1:].max(axis=1))
    print(f"P(Interviews is top technique in bootstrap resample) = {p_top:.2f}%")

    # Sensitivity: denominator 276 ('-77' treated as 'not used')
    X_all = np.column_stack([(df[c] == "quoted").astype(int).to_numpy() for c in TECHS])
    obs_all = X_all.mean(axis=0) * 100
    print("\nSensitivity (denominator N=276, '-77' as not used):")
    for l, o in zip(labels, obs_all):
        print(f"  {l:20s} {o:6.2f}%")

    # Key numbers for the hypothesis
    print("\nKEY: Interviews obs = {:.3f}% ({}/{}), bootstrap CI [{:.3f}, {:.3f}]".format(
        obs[0], int(X[:, 0].sum()), n, lo[0], hi[0]))

if __name__ == "__main__":
    main()
