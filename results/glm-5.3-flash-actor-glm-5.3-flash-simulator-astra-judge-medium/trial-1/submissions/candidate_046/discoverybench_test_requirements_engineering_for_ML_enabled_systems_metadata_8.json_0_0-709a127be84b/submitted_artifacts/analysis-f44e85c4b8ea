"""Bootstrap analysis of Q10_ML_Documentation_* usage percentages.

Primary definition: respondents who answered Q10 (no '-77' in any of the 12
format columns), n=194; indicator = (value == 'quoted'); respondent-level
bootstrap, B=10,000, seed=42, 95% percentile CIs.
Sensitivity: n=164 (Status 'Completed (31)'), n=188 (all completed).
Alternative aggregations tested against the target figures (10.13%, 4.366%).
"""
import numpy as np
import pandas as pd

SEED, B = 42, 10000
df = pd.read_csv('data/requirements_engineering_for_ML-enabled_systems.csv')
Q10 = [c for c in df.columns if c.startswith('Q10_ML_Documentation_') and not c.endswith('_Free')]

valid = (df[Q10] != '-77').all(axis=1)
quoted = (df[Q10] == 'quoted').astype(int)

def bootstrap(mask, label):
    X = quoted[mask].to_numpy()
    n = mask.sum()
    rng = np.random.default_rng(SEED)
    idx = rng.integers(0, n, size=(B, n))
    props = X[idx].mean(axis=0) * 100
    rows = []
    for j, c in enumerate(Q10):
        lo, hi = np.percentile(props[:, j], [2.5, 97.5])
        rows.append({'format': c.replace('Q10_ML_Documentation_', ''),
                     'count': int(X[:, j].sum()), 'n': n,
                     'pct': X[:, j].mean() * 100,
                     'ci_lo': lo, 'ci_hi': hi})
    out = pd.DataFrame(rows).sort_values('pct').reset_index(drop=True)
    print(f'\n=== {label} (n={n}) ===')
    print(out.to_string(index=False,
          float_format=lambda v: f'{v:.3f}'))
    return out

primary = bootstrap(valid, 'PRIMARY: answered Q10')
s164 = bootstrap(df['Status'] == 'Completed (31)', 'SENSITIVITY: Completed (31) only')
s188 = bootstrap(df['Status'].isin(['Completed (31)', 'Completed after break (32)']),
                 'SENSITIVITY: all completed')

# ---- Alternative aggregations vs target (10.13%, 4.366%) ----
print('\n=== ALTERNATIVE AGGREGATIONS ===')
X = quoted[valid]
tot_mentions = int(X.values.sum())
alts = {
    'share of total quoted mentions (n=416 mentions)': X.sum() / tot_mentions * 100,
    'n=276, -77 treated as not-quoted': quoted.sum() / 276 * 100,
    'n=174 (quoted >=1 format)': X.sum() / (X.sum(axis=1) > 0).sum() * 100,
    'n=150 (>=1 quoted excl Not_Documented)': X.drop(columns=[Q10[0]]).sum()
        / (X.drop(columns=[Q10[0]]).sum(axis=1) > 0).sum() * 100,
    'n=188 completed, -77 as not-quoted for suspended': quoted[df['Status'] != 'Suspended (22)'].sum() / 188 * 100,
}
for name, ser in alts.items():
    two = ser.sort_values().head(3)
    print(f'--- {name}')
    for k, v in two.items():
        print(f'    {k.replace("Q10_ML_Documentation_", "")}: {v:.3f}%')
print('Target: 10.13% and 4.366% -> reproduced?', end=' ')
hits = [(k, two.index[0], round(two.iloc[0], 3), round(two.iloc[1], 3))
        for k, two in [(k, v.sort_values()) for k, v in alts.items()]]
print(any(abs(a - 10.13) < 0.05 and abs(b - 4.366) < 0.05 for _, _, a, b in hits))

