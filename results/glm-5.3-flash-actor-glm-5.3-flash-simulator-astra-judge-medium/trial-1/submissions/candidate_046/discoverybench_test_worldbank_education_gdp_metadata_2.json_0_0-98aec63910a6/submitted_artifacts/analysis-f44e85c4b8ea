"""
Analysis: Effect of education expenditure on per-capita GDP (GNI),
comparing Lower Middle Income countries (LMC, proxy for "developing countries")
vs Sub-Saharan Africa (SSA/SSF). 1975-2015 WDI aggregate series.

Approved design:
 - No imputation of SSA GNI; only real 2011-2015 observations used.
 - Central estimand: interaction EduExp x SSA (delta) in
   log(GNI pc) ~ EduExp + SSA + EduExp x SSA (+ controls), pooled unbalanced.
 - Lagged EduExp (t-1, t-2) as endogeneity mitigation; HAC (Newey-West) SEs;
   no clustered SEs (only 2 groups). Associational, NOT causal.
 - Auxiliary (supportive only): secondary enrollment vs education expenditure,
   full 1975-2015 window (41 obs per group).
"""
import warnings
import numpy as np
import pandas as pd
import statsmodels.api as sm

warnings.filterwarnings("ignore")
OUT = []

def log(msg):
    print(msg)
    OUT.append(str(msg))

# ---------------------------------------------------------------- load & melt
df = pd.read_csv("data/worldbank_education_gdp.csv")
year_cols = [c for c in df.columns if "[YR" in c]
long = df.melt(id_vars=["Country Group", "Country Code", "Series Name", "Series Code"],
               value_vars=year_cols, var_name="YearLabel", value_name="Value")
long["Year"] = long["YearLabel"].str.split(" ").str[0].astype(int)
long = long.rename(columns={"Country Group": "Group"})
long = long[["Group", "Year", "Series Code", "Value"]]
long["Value"] = pd.to_numeric(long["Value"].astype(str).str.strip(), errors="coerce")
panel = (long.pivot_table(index=["Group", "Year"], columns="Series Code",
                          values="Value").reset_index())
panel = panel.rename(columns={
    "NY.GNP.PCAP.KD": "GNI_pc", "NY.ADJ.AEDU.GN.ZS": "EduExp",
    "NE.EXP.GNFS.KD.ZG": "ExpGrowth", "SE.PRM.ENRR": "EnrollPrim",
    "SE.SEC.ENRR": "EnrollSec", "SL.TLF.CACT.ZS": "LabForce"})
panel["SSA"] = (panel["Group"] == "Sub-Saharan Africa").astype(int)
panel = panel.sort_values(["Group", "Year"]).reset_index(drop=True)

log("=" * 78)
log("PANEL STRUCTURE (wide->long->pivot): %d rows = %d groups x %d years"
    % (len(panel), panel["Group"].nunique(), panel["Year"].nunique()))
log("=" * 78)
log(panel.groupby("Group")[["GNI_pc", "EduExp", "ExpGrowth", "EnrollPrim",
                            "EnrollSec", "LabForce"]]
    .agg(["count", "min", "max", "mean"]).round(2).to_string())

# ------------------------------------------------------------ descriptives
log("")
log("=" * 78)
log("DESCRIPTIVE STATISTICS BY GROUP AND WINDOW (means, ranges, trends)")
log("=" * 78)
for gname, g in panel.groupby("Group"):
    for wname, sel in [("1975-2015", g),
                       ("1991-2015 (exports/labor window)", g[g["Year"] >= 1991]),
                       ("2011-2015 (common GNI window)", g[g["Year"] >= 2011])]:
        lines = [f"--- {gname} | {wname} ---"]
        for v in ["GNI_pc", "EduExp", "ExpGrowth", "EnrollPrim", "EnrollSec",
                  "LabForce"]:
            s = sel[v].dropna()
            if len(s) == 0:
                continue
            t = sel.loc[s.index, "Year"]
            slope = np.polyfit(t, s, 1)[0] if len(s) > 2 else np.nan
            lines.append(f"  {v:10s}: n={len(s):2d}  mean={s.mean():8.2f}  "
                         f"min={s.min():9.2f}  max={s.max():9.2f}  "
                         f"trend={slope:+7.3f}/yr")
        log("\n".join(lines))
    for v in ["GNI_pc", "EduExp"]:
        s = g[["Year", v]].dropna()
        if len(s) > 2:
            cagr = (s[v].iloc[-1] / s[v].iloc[0]) ** (1 / (s["Year"].iloc[-1] - s["Year"].iloc[0])) - 1
            log(f"  CAGR {v} ({s['Year'].iloc[0]}-{s['Year'].iloc[-1]}): {cagr*100:+.2f}%/yr")
for gname, g in panel.groupby("Group"):
    s = g[["Year", "EduExp"]].dropna()
    pk, tr = s.loc[s["EduExp"].idxmax()], s.loc[s["EduExp"].idxmin()]
    log(f"{gname}: EduExp peak {pk['EduExp']:.2f}% ({int(pk['Year'])}), "
        f"trough {tr['EduExp']:.2f}% ({int(tr['Year'])})")

# ------------------------------------------------------------------ models
common = panel[panel["GNI_pc"].notna()].copy()
common["logGNI"] = np.log(common["GNI_pc"])
common["EduXSSA"] = common["EduExp"] * common["SSA"]

def fit(sample, cols, label, lags=1):
    d = sample.dropna(subset=[c for c in cols if c in sample.columns]).copy()
    y = d["logGNI"] if "logGNI" in d else d["EnrollSec"]
    X = sm.add_constant(d[cols], has_constant="add")
    m = sm.OLS(y, X).fit(cov_type="HAC", cov_kwds={"maxlags": lags})
    log("")
    log(f"--- {label} (n={int(m.nobs)}, HAC(Newey-West, maxlags={lags}) SEs) ---")
    log(f"    R-squared = {m.rsquared:.3f}")
    for name in m.params.index:
        pv = float(m.pvalues[name])
        star = "**" if pv < 0.05 else ("*" if pv < 0.10 else "")
        log(f"    {name:14s} b={float(m.params[name]):+9.4f}  "
            f"se={float(m.bse[name]):7.4f}  p={pv:6.3f}{star}")
    return m

log("")
log("=" * 78)
log("CENTRAL SPECIFICATION: log(GNI_pc) ~ EduExp + SSA + EduExp x SSA")
log("Pooled UNBALANCED panel: LMC 1975-2015 (41 obs) + SSA 2011-2015 (5 obs);")
log("NO imputation of SSA GNI (declared limitation).")
log("=" * 78)
m1 = fit(common, ["EduExp", "SSA", "EduXSSA"], "M1: baseline (no controls)")
fit(common, ["EduExp", "SSA", "EduXSSA", "EnrollSec"], "M2: + secondary enrollment")
fit(common, ["EduExp", "SSA", "EduXSSA", "EnrollSec", "ExpGrowth", "LabForce"],
    "M3: + exports growth & labor force")

log("")
log("=" * 78)
log("ROBUSTNESS: BALANCED 2011-2015 WINDOW ONLY (n=10; 5 obs per group)")
log("=" * 78)
bal = common[common["Year"] >= 2011].copy()
fit(bal, ["EduExp", "SSA", "EduXSSA"], "M1b: baseline, balanced window")
fit(bal, ["EduExp", "SSA", "EduXSSA", "EnrollSec"], "M2b: + enrollment, balanced")

log("")
log("=" * 78)
log("LAGGED SPECIFICATIONS (endogeneity mitigation: EduExp t-1 / t-2)")
log("=" * 78)
for L in [1, 2]:
    d = common.sort_values(["Group", "Year"]).copy()
    d["EduExp_l1"] = d.groupby("Group")["EduExp"].shift(1)
    d["EduExp_l2"] = d.groupby("Group")["EduExp"].shift(2)
    d["lagXSSA"] = d[f"EduExp_l{L}"] * d["SSA"]
    cols = ["EduExp_l1", "SSA"] if L == 1 else ["EduExp_l1", "EduExp_l2", "SSA"]
    fit(d, cols + ["lagXSSA"],
        f"M4(L{L}): lagged EduExp (t-1" + (" & t-2" if L == 2 else "") + ")")

log("")
log("=" * 78)
log("DYNAMIC SPEC (lagged log GNI as regressor)")
log("=" * 78)
d = common.sort_values(["Group", "Year"]).copy()
d["logGNI_l1"] = d.groupby("Group")["logGNI"].shift(1)
fit(d, ["logGNI_l1", "EduExp", "SSA", "EduXSSA"], "M5: dynamic with logGNI(t-1)")

# ------------------------------------------------------------ auxiliary path
log("")
log("=" * 78)
log("AUXILIARY (supportive, descriptive ONLY): human-capital channel")
log("Education expenditure vs secondary enrollment, full 1975-2015 (n=41/group)")
log("=" * 78)
for gname, g in panel.groupby("Group"):
    s = g[["Year", "EduExp", "EnrollSec", "EnrollPrim"]].dropna()
    r_sec = np.corrcoef(s["EduExp"], s["EnrollSec"])[0, 1]
    r_pri = np.corrcoef(s["EduExp"], s["EnrollPrim"])[0, 1]
    m = sm.OLS(s["EnrollSec"], sm.add_constant(s["EduExp"])).fit(
        cov_type="HAC", cov_kwds={"maxlags": 3})
    log(f"  {gname}: corr(EduExp, EnrollSec)={r_sec:+.3f}; "
        f"corr(EduExp, EnrollPrim)={r_pri:+.3f}")
    log(f"      EnrollSec ~ EduExp: b={float(m.params['EduExp']):+.3f} "
        f"(se={float(m.bse['EduExp']):.3f}, p={float(m.pvalues['EduExp']):.4f}), "
        f"R2={m.rsquared:.3f}")

log("")
log("  LMC full-window assoc. between EduExp and log GNI (n=41, HAC):")
lmc = panel[(panel["Group"] == "Lower middle income") & panel["GNI_pc"].notna()].copy()
lmc["logGNI"] = np.log(lmc["GNI_pc"])
m = sm.OLS(lmc["logGNI"], sm.add_constant(lmc["EduExp"])).fit(
    cov_type="HAC", cov_kwds={"maxlags": 3})
log(f"      b={float(m.params['EduExp']):+.4f} (se={float(m.bse['EduExp']):.4f}, "
    f"p={float(m.pvalues['EduExp']):.4f}), R2={m.rsquared:.3f} "
    "[trend-dominated; associational only]")

log("")
log("=" * 78)
log("LIMITATIONS (declared)")
log("=" * 78)
log(" - SSA GNI per capita available only for 2011-2015 (n=5); NO imputation.")
log(" - Pooled regressions are UNBALANCED (LMC 1975-2015 vs SSA 2011-2015); the")
log("   interaction may partly reflect time-period composition, not only group.")
log(" - 2 aggregate units only; results are associational, NOT causal.")
log(" - LMC used as proxy for 'developing countries' (assumption).")
log(" - Series is GNI per capita constant 2015 US$ (proxy for per-capita GDP).")
log(" - HAC SEs with very small n; low statistical power.")
log(" - 'Adjusted savings: education expenditure' differs slightly from")
log("   'public education spending % of total expenditure'.")

with open("analysis_output.txt", "w") as f:
    f.write("\n".join(OUT))
print("\n[saved] analysis_output.txt")
