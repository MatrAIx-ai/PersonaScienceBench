# -*- coding: utf-8 -*-
"""
NLSY79 (1989): ¿Cómo influye la edad en la probabilidad de retirar más dinero
del que aporta a ahorros (DISSAVED)?
Modelo principal: logit binario con AGE y AGE_2 (no linealidad), controles:
log1p(INCOME), GENDER, BMI, BLACK, HISPANIC. EE robustos HC1.
Decisiones del investigador fijadas: (1) outcome binario DISSAVED (multinomial fuera de alcance);
(2) INCOME: log1p principal + winsorización p99 como sensibilidad; (3) BMI: excluir 12 valores imposibles.
"""
import pandas as pd, numpy as np, statsmodels.api as sm
from statsmodels.stats.outliers_influence import variance_inflation_factor

df = pd.read_csv('data/nls_bmi_processed.csv')
N0 = len(df)

# --- Limpieza: excluir 12 BMI imposibles (<12 o >70) ---
bad_bmi = (df.BMI < 12) | (df.BMI > 70)
dfc = df[~bad_bmi].copy()
print(f"Filas excluidas por BMI imposible: {bad_bmi.sum()} (de {N0}); analisis principal n={len(dfc)}")

dfc['LOG_INCOME'] = np.log1p(dfc.INCOME)
dfc['FEMALE'] = (dfc.GENDER == 'FEMALE').astype(int)

def fit(d, cols, label):
    X = sm.add_constant(d[cols], has_constant='add')
    m = sm.Logit(d.DISSAVED, X).fit(cov_type='HC1', disp=0)
    print(f"\n===== {label} (n={len(d)}) =====")
    tbl = pd.DataFrame({'coef': m.params, 'OR': np.exp(m.params),
                        'SE_HC1': m.bse, 'z': m.tvalues, 'p': m.pvalues,
                        'IC95_lo': m.conf_int()[0], 'IC95_hi': m.conf_int()[1]})
    tbl['IC95_OR_lo'], tbl['IC95_OR_hi'] = np.exp(tbl.IC95_lo), np.exp(tbl.IC95_hi)
    print(tbl.round(4).to_string())
    print(f"LogLik={m.llf:.2f}  PseudoR2(McF)={1-m.llf/m.llnull:.4f}  N={m.nobs}")
    return m

cols_main = ['AGE','AGE_2','LOG_INCOME','FEMALE','BMI','BLACK','HISPANIC']
m_main = fit(dfc, cols_main, "MODELO PRINCIPAL: logit DISSAVED ~ AGE + AGE_2 + log1p(INCOME) + FEMALE + BMI + BLACK + HISPANIC")

# --- Test conjunto de AGE y AGE_2 (Wald) ---
wt = m_main.wald_test('(AGE = 0), (AGE_2 = 0)', scalar=True)
print(f"\nTest conjunto Wald (AGE=AGE_2=0): chi2={float(wt.statistic):.3f}, df=2, p={float(wt.pvalue):.5f}")

# --- AME de la edad (efecto marginal promedio) ---
X = sm.add_constant(dfc[cols_main], has_constant='add')
p = m_main.predict(X)
dAGE = dfc.AGE.values
p1 = m_main.predict(X.assign(AGE=dAGE+1, AGE_2=(dAGE+1)**2))
ame = np.mean(p1 - p)
print(f"AME de +1 anio de edad: {ame*100:+.3f} puntos porcentuales (IC95 por delta-method aprox: ver curva)")

# --- Curva de probabilidad predicha por edad (resto en la media/observacion tipica) ---
prof = pd.DataFrame({'AGE': range(24,33)}); prof['AGE_2'] = prof.AGE**2
base = dfc[['LOG_INCOME','FEMALE','BMI','BLACK','HISPANIC']].mean()
for c in base.index: prof[c] = base[c]
Xp = sm.add_constant(prof[cols_main], has_constant='add')
prof['pred_prob'] = m_main.predict(Xp)
# AME por edad especifica
ame_by_age = []
for a in range(24,33):
    Xa = dfc[cols_main].copy(); Xa.AGE = a; Xa.AGE_2 = a*a
    pa = m_main.predict(sm.add_constant(Xa, has_constant='add'))
    Xb = Xa.copy(); Xb.AGE = a+1; Xb.AGE_2 = (a+1)**2
    pb = m_main.predict(sm.add_constant(Xb, has_constant='add'))
    ame_by_age.append(np.mean(pb-pa))
prof['AME_(a->a+1)_pp'] = np.array(ame_by_age)*100
print("\nCurva de probabilidad predicha por edad (covariables en la media) y AME local:")
print(prof[['AGE','pred_prob','AME_(a->a+1)_pp']].round(4).to_string(index=False))

# --- VIF antes / despues de centrar AGE ---
def vif_table(d, cols, tag):
    Xv = sm.add_constant(d[cols], has_constant='add')
    print(f"\nVIF ({tag}):")
    for i, c in enumerate(Xv.columns):
        if c != 'const':
            print(f"  {c:12s} {variance_inflation_factor(Xv.values, i):8.2f}")
vif_table(dfc, cols_main, "AGE sin centrar")
dfc['AGE_c'] = dfc.AGE - dfc.AGE.mean(); dfc['AGE_2c'] = dfc.AGE_c**2
cols_c = ['AGE_c','AGE_2c','LOG_INCOME','FEMALE','BMI','BLACK','HISPANIC']
vif_table(dfc, cols_c, "AGE centrada")

# --- Chequeo no parametrico: edad como factor de 9 categorias ---
dfc['AGE_f'] = pd.Categorical(dfc.AGE, categories=sorted(dfc.AGE.unique()))
d_f = pd.get_dummies(dfc[['DISSAVED','AGE_f','LOG_INCOME','FEMALE','BMI','BLACK','HISPANIC']],
                     columns=['AGE_f'], drop_first=True, dtype=float)
m_f = sm.Logit(d_f.DISSAVED, sm.add_constant(d_f.drop(columns='DISSAVED'))).fit(cov_type='HC1', disp=0)
lrt = 2*(m_f.llf - m_main.llf); dfree = m_f.df_model - m_main.df_model
from scipy import stats as st
print(f"\nChequeo categorico (edad como factor, ref=24): LogLik={m_f.llf:.2f}")
print(f"LRT cuadratico vs categorico: chi2={lrt:.3f}, df={dfree}, p={st.chi2.sf(lrt, dfree):.4f} "
      f"(p>0.05 => la forma cuadratica no es rechazada)")
print("Coefs categoricos (vs 24 anios):")
cf = pd.DataFrame({'coef': m_f.params, 'p': m_f.pvalues})
print(cf.loc[[c for c in cf.index if 'AGE_f' in c]].round(4).to_string())

# --- Tabla observada por edad junto al predicho del modelo principal ---
obs = dfc.groupby('AGE').agg(n=('DISSAVED','size'), tasa_obs=('DISSAVED','mean')).reset_index()
obs = obs.merge(prof[['AGE','pred_prob']], on='AGE')
print("\nTabla: tasas observadas vs probabilidad predicha (modelo principal):")
print(obs.round(4).to_string(index=False))

# --- Sensibilidad: winsorizacion de INCOME al p99 ---
dfw = dfc.copy()
p99 = dfw.INCOME.quantile(.99)
dfw['INCOME_W'] = dfw.INCOME.clip(upper=p99)
dfw['LOG_INCOME'] = np.log1p(dfw.INCOME_W)
m_w = fit(dfw, cols_main, "SENSIBILIDAD: INCOME winsorizado al p99 (log1p)")
print(f"\nConcordancia de conclusion sobre edad (coef AGE/AGE_2 principal vs sensibilidad): "
      f"AGE {m_main.params['AGE']:.4f} vs {m_w.params['AGE']:.4f}; "
      f"AGE_2 {m_main.params['AGE_2']:.6f} vs {m_w.params['AGE_2']:.6f}")

# --- Sensibilidad: AGE centrada ---
m_c = fit(dfc, cols_c, "SENSIBILIDAD: AGE centrada (misma covariables)")
print(f"Test conjunto Wald AGE_c/AGE_2c: ", end="")
wt2 = m_c.wald_test('(AGE_c = 0), (AGE_2c = 0)', scalar=True)
print(f"chi2={float(wt2.statistic):.3f}, p={float(wt2.pvalue):.5f}")
