"""
NLSY79: Does increased time preference (impatience) lead to higher BMI?
Proxy for time preference: 1989 savings behavior (net saving flow).
BMI: weight (lbs->kg) / height (in->m)^2.
Main BMI: height 1985 + weight 1992. Sensitivity: height 1981 (feet-inches code) + weight 1989.
"""
import numpy as np, pandas as pd, statsmodels.formula.api as smf
from scipy import stats

RAW = 'data/nls_raw.csv'
df = pd.read_csv(RAW)
C = df.columns
col = lambda key: C[C.str.contains(key, regex=False)][0]

# ---------- cleaning ----------
h81 = df[col('Height of respondent, 1981')]
h85 = df[col('Height of respondent, 1985')]
w81 = df[col('Weight of respondent, 1981')]
w89 = df[col('Weight of respondent, 1989')]
w92 = df[col('Weight of respondent, 1992')]
cat = df[col('Was more money put into or taken out of R/spouse savings')]
pin = df[col('Net amount respondent/spouse put into savings')]
pout = df[col('Net amount respondent/spouse took out of savings')]

# height 1981: code = feet*100 + inches -> inches
h81_in = pd.Series(np.where((h81 >= 400) & (h81 <= 611), (h81 // 100) * 12 + (h81 % 100), np.nan), index=df.index)
h85_in = h85.where((h85 >= 48) & (h85 <= 84))

# weights: lbs, plausibility window
w89_cl = w89.where((w89 >= 50) & (w89 <= 450))
w92_cl = w92.where((w92 >= 50) & (w92 <= 450))
w81_cl = w81.where((w81 >= 50) & (w81 <= 450))

LB2KG = 0.45359237
bmi_main = (w92_cl * LB2KG) / (h85_in * 0.0254) ** 2
bmi_sens = (w89_cl * LB2KG) / (h81_in * 0.0254) ** 2

# savings proxy: structural zeros by skip pattern; top-codes -> NaN
TOPCODES = [9999996, 8192797]
pin_c = pin.replace(TOPCODES, np.nan)
pout_c = pout.replace(TOPCODES, np.nan)
put = np.where(cat == 1, pin_c.fillna(0), 0.0)          # only cat=1 has a 'put' amount
took = np.where(cat == 2, pout_c.fillna(0), 0.0)        # only cat=2 has a 'took' amount
savings_flow = put - took
savings_flow = pd.Series(savings_flow).where(cat.notna())  # missing if cat missing
sd_flow = savings_flow.std()
z_flow = (savings_flow - savings_flow.mean()) / sd_flow

# ordinal robust proxy: 4 no savings(lowest patience), 2 took out, 3 no change, 1 put in
ord_map = {4: 0, 2: 1, 3: 2, 1: 3}
ord_proxy = cat.map(ord_map)

# JAIL: ever in residence-type JAIL (code 5) in any recorded wave 1981-1996
res_cols = [c for c in C if c.startswith('Type of residence respondent is living in')]
jail_any = (df[res_cols] == 5).any(axis=1)

# controls
sex = df[col('Sex of respondent')]                 # 1 M, 2 F
race = df[col('Racial/ethnic cohort')]             # 1 B, 2 H, 3 other
age = df[col('Age of respondent at interview date, 1989')]
age = age.fillna(df[col('Age of respondent, 1979')] + 10)   # impute 1989 age if attrited
edu = df[col('Highest grade completed, 1979')].replace(95, np.nan)
inc89 = df[col('Total net family income, previous calendar year, 1989')]
inc89 = inc89.where(inc89 >= 0)
wealth85 = df[col('Family net wealth, 1985')].where(lambda s: s > -900000)
wealth90 = df[col('Family net wealth, 1990')].where(lambda s: s > -900000)

d = pd.DataFrame({
    'bmi': bmi_main, 'bmi_sens': bmi_sens, 'z_flow': z_flow, 'flow': savings_flow,
    'ord': ord_proxy, 'female': (sex == 2).astype(float),
    'black': (race == 1).astype(float), 'hisp': (race == 2).astype(float),
    'age': age, 'edu': edu, 'log_inc': np.log1p(inc89.clip(lower=0)),
    'log_w85': np.log1p(wealth85.clip(lower=0)), 'log_w90': np.log1p(wealth90.clip(lower=0)),
    'jail': jail_any.astype(float),
})

print('=' * 80)
print('A. UNIVARIATE / DIAGNOSTICS')
print('=' * 80)
print(f"BMI main (h1985 & w1992):  n={d['bmi'].notna().sum()}  mean={d['bmi'].mean():.2f}  sd={d['bmi'].std():.2f}")
print(f"BMI sens (h1981 & w1989):  n={d['bmi_sens'].notna().sum()}  mean={d['bmi_sens'].mean():.2f}  sd={d['bmi_sens'].std():.2f}")
print(f"savings flow: n={d['flow'].notna().sum()}  mean=${d['flow'].mean():,.0f}  sd=${d['flow'].std():,.0f}  median=${d['flow'].median():,.0f}")
print(f"excluded: w89>450lb n={(w89>450).sum()}; h81 out-of-range n={h81_in.isna().sum() - h81.isna().sum()}")
print(f"jail any wave: n={int(d['jail'].sum())} ({d['jail'].mean():.2%})")

print()
print('=' * 80)
print('B. TERTILE COMPARISON (net saving flow 1989, main BMI h85+w92)')
print('=' * 80)
sub = d.dropna(subset=['bmi', 'z_flow']).copy()
sub['terc'] = pd.qcut(sub['flow'].rank(method='first'), 3, labels=['T1 lowest saving', 'T2 middle', 'T3 highest saving'])
tab = sub.groupby('terc', observed=True)['bmi'].agg(['count', 'mean', 'std'])
tab['sem'] = tab['std'] / np.sqrt(tab['count'])
print(tab.round(2))
# trend test
codes = sub['terc'].cat.codes
r, p = stats.pearsonr(codes, sub['bmi'])
print(f"Pearson trend r={r:.3f}, p={p:.2e}")
t12 = stats.ttest_ind(sub.loc[sub.terc == sub.terc.cat.categories[0], 'bmi'],
                      sub.loc[sub.terc == sub.terc.cat.categories[2], 'bmi'], equal_var=False)
print(f"T3 - T1 diff = {sub.loc[sub.terc==sub.terc.cat.categories[2],'bmi'].mean() - sub.loc[sub.terc==sub.terc.cat.categories[0],'bmi'].mean():.2f} BMI points; Welch t p={t12.pvalue:.2e}")

print()
print('=' * 80)
print('C. OLS  (savings flow standardized; HC3 robust SE; n reported per spec)')
print('=' * 80)
base = ['z_flow', 'female', 'black', 'hisp', 'age', 'edu', 'log_inc', 'jail']
specs = {
    'M1 bmi_main ~ z_flow':                    ['z_flow'],
    'M2 + demographics':                       base,
    'M3 + log wealth1985':                     base + ['log_w85'],
    'M4 + log wealth1990':                     base + ['log_w90'],
}
for name, rhs in specs.items():
    dd = d.dropna(subset=['bmi'] + [x for x in rhs if x != 'jail'])
    f = 'bmi ~ ' + ' + '.join(rhs)
    m = smf.ols(f, data=dd).fit(cov_type='HC3')
    b, se, pv = m.params['z_flow'], m.bse['z_flow'], m.pvalues['z_flow']
    print(f"{name:32s} n={int(m.nobs):5d}  beta(z_flow)={b:+.3f}  SE={se:.3f}  p={pv:.2e}  R2={m.rsquared:.3f}")

print()
print('C2. Same on sensitivity BMI (h1981 + w1989):')
for name, rhs in specs.items():
    dd = d.dropna(subset=['bmi_sens'] + [x for x in rhs if x != 'jail'])
    f = 'bmi_sens ~ ' + ' + '.join(rhs)
    m = smf.ols(f, data=dd).fit(cov_type='HC3')
    b, pv = m.params['z_flow'], m.pvalues['z_flow']
    print(f"{name:32s} n={int(m.nobs):5d}  beta(z_flow)={b:+.3f}  p={pv:.2e}  R2={m.rsquared:.3f}")

print()
print('=' * 80)
print('D. ORDINAL ROBUST PROXY (0=no savings, 1=took out, 2=no change, 3=put in)')
print('=' * 80)
dd = d.dropna(subset=['bmi', 'ord'] + base[1:])
m = smf.ols('bmi ~ ord + female + black + hisp + age + edu + log_inc + jail', data=dd).fit(cov_type='HC3')
print(f"n={int(m.nobs)}  beta(ord)={m.params['ord']:+.3f} BMI per ordinal step  p={m.pvalues['ord']:.2e}")
print('BMI means by ordinal level:'); print(dd.groupby('ord')['bmi'].agg(['count','mean']).round(2))

print()
print('=' * 80)
print('E. ROBUSTNESS: drop ever-JAIL respondents, main spec M2')
print('=' * 80)
dd = d[(d.jail == 0)].dropna(subset=['bmi'] + base[1:])
m = smf.ols('bmi ~ ' + ' + '.join(base), data=dd).fit(cov_type='HC3')
print(f"n={int(m.nobs)}  beta(z_flow)={m.params['z_flow']:+.3f}  p={m.pvalues['z_flow']:.2e}")

sub.to_csv('outputs/tercile_sample.csv', index=False)
d.to_csv('outputs/analysis_dataset.csv', index=False)
print('\nSaved: outputs/tercile_sample.csv, outputs/analysis_dataset.csv')
