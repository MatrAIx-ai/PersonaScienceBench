#!/usr/bin/env python3
"""
Recover latent per-case summaries (component A: single sinusoid; component B:
fundamental + first harmonic + offset in obs_0) and predict future A-only values.
Model: obs_0(t) = b1*sin(2pi(t-t0)/PA) + b2*cos(...) + c1..c2 (fund at PB)
       + c3..c4 (first harmonic, 2*PB) + offset + noise; weights 1/err^2;
       t0 = reference_epoch_day from input_0.json.
"""
import json, csv
import numpy as np
import pandas as pd
from scipy.optimize import minimize

meta = json.load(open('data/input_0.json'))
T0 = float(meta['reference_epoch_day'])
CASES = list(meta['case_order'])
df = pd.read_csv('data/input_1.csv')
tgt = pd.read_csv('data/input_2.csv', dtype={'case_id': str, 'time_day': str})

def design(t, PA, PB, withA=True):
    cols = []
    if withA:
        x = 2*np.pi*(t - T0)/PA
        cols += [np.sin(x), np.cos(x)]
    xB = 2*np.pi*(t - T0)/PB
    cols += [np.sin(xB), np.cos(xB), np.sin(2*xB), np.cos(2*xB), np.ones_like(t)]
    return np.column_stack(cols)

def wls(A, y, w):
    ATA = A.T @ (A * w[:, None]); ATy = A.T @ (y * w)
    b = np.linalg.solve(ATA, ATy)
    r = y - A @ b
    return b, float(np.sum(w*r*r)), np.linalg.inv(ATA)

def periodogram_peaks(t, y, sig, n=10, fmin=1/200., fmax=1/2.0):
    freqs = np.linspace(fmin, fmax, 40000)
    w = 1/sig**2
    ym = np.average(y, weights=w); base = np.sum(w*(y-ym)**2)
    ps = np.empty_like(freqs)
    for k, f in enumerate(freqs):
        x = 2*np.pi*f*(t - T0)
        A = np.column_stack([np.sin(x), np.cos(x)])
        try: _, c2, _ = wls(A, y, w)
        except np.linalg.LinAlgError: ps[k] = 0.0; continue
        ps[k] = 1 - c2/(base + 1e-300)
    idx = np.argsort(ps)[::-1]; chosen = []; T = t.max() - t.min()
    for i in idx:
        if all(abs(freqs[i]-freqs[j]) > 2.0/T for j in chosen): chosen.append(i)
        if len(chosen) >= n: break
    return [(freqs[i], ps[i]) for i in chosen]

def refine_pair(t, y, w, PA0, PB0):
    def f(p):
        PA, PB = np.exp(p)
        if PA < 2 or PB < 2 or abs(PA - PB) < 0.05: return 1e18
        try: return wls(design(t, PA, PB, True), y, w)[1]
        except np.linalg.LinAlgError: return 1e18
    r = minimize(f, [np.log(PA0), np.log(PB0)], method='Nelder-Mead',
                 options={'xatol': 1e-9, 'fatol': 1e-9, 'maxiter': 6000, 'maxfev': 6000})
    PA, PB = np.exp(r.x)
    b, c2, C = wls(design(t, PA, PB, True), y, w)
    return PA, PB, b, c2, C

def fit_fixed_pb(t, y, w, PB, PA, withA=True, extra=()):
    cols = design(t, PA if withA else 1.0, PB, withA=withA)
    for P in extra:
        x = 2*np.pi*(t - T0)/P
        cols = np.column_stack([cols, np.sin(x), np.cos(x)])
    return wls(cols, y, w)

def chan_fB(g, ch, PB_guess, n_distr=3):
    t = g.time_day.values; y = g[ch].values; w = 1/g[ch+'_err'].values**2
    peaks = periodogram_peaks(t, y, g[ch+'_err'].values, n=8)
    distr = []; T = t.max() - t.min()
    for f, p in peaks:
        if p < 0.05: continue
        if abs(f - 1/PB_guess) < 1.5/T or abs(f - 2/PB_guess) < 1.5/T: continue
        if any(abs(f - d) < 1.5/T for d in distr): continue
        distr.append(1.0/f)
        if len(distr) >= n_distr: break
    def chi2(logp):
        fB = np.exp(logp[0]); Pds = np.exp(logp[1:])
        if not (1/250 < fB < 1/3): return 1e18
        x = 2*np.pi*(t - T0)*fB
        cols = [np.sin(x), np.cos(x), np.sin(2*x), np.cos(2*x), np.ones_like(t)]
        for P in Pds:
            xx = 2*np.pi*(t - T0)/P; cols += [np.sin(xx), np.cos(xx)]
        try: return wls(np.column_stack(cols), y, w)[1]
        except np.linalg.LinAlgError: return 1e18
    x0 = [np.log(1/PB_guess)] + [np.log(P) for P in distr]
    r = minimize(chi2, x0, method='Nelder-Mead',
                 options={'xatol': 1e-10, 'fatol': 1e-10, 'maxiter': 20000, 'maxfev': 20000})
    fB = float(np.exp(r.x[0]))
    cols = [np.sin(2*np.pi*(t-T0)/PB_guess), np.cos(2*np.pi*(t-T0)/PB_guess),
            np.sin(4*np.pi*(t-T0)/PB_guess), np.cos(4*np.pi*(t-T0)/PB_guess), np.ones_like(t)]
    for P in distr:
        xx = 2*np.pi*(t-T0)/P; cols += [np.sin(xx), np.cos(xx)]
    c2_fix = wls(np.column_stack(cols), y, w)[1]
    return fB, r.fun, c2_fix, distr

summary_rows, pred_rows, report = [], [], []
for case in CASES:
    g = df[df.case_id == case]
    t = g.time_day.values; y = g['obs_0'].values
    w = 1/g['obs_0_err'].values**2; N = len(t)

    # step 1: candidate (PA, PB) pairs
    cand = {}
    for ch in ['obs_0', 'obs_1', 'obs_2']:
        for f, p in periodogram_peaks(t, g[ch].values, g[ch+'_err'].values, n=8):
            if p > 0.05: cand[round(f, 6)] = max(cand.get(round(f, 6), 0), p)
    for ch2 in ['obs_1', 'obs_2']:
        yy = g['obs_0'].values - g[ch2].values
        ss = np.sqrt(g['obs_0_err'].values**2 + g[ch2+'_err'].values**2)
        for f, p in periodogram_peaks(t, yy, ss, n=8):
            if p > 0.05: cand[round(f, 6)] = max(cand.get(round(f, 6), 0), p)
    cand = sorted(cand); T = t.max() - t.min()
    pairs = []
    for fA in cand:
        for fB in cand:
            if abs(fA - fB) < 1.0/T: continue
            try: _, c2, _ = wls(design(t, 1/fA, 1/fB, True), y, w)
            except np.linalg.LinAlgError: continue
            pairs.append((c2, 1/fA, 1/fB))
    pairs.sort()
    best = None
    for _, PA0, PB0 in pairs[:15]:
        PA, PB, b, c2, C = refine_pair(t, y, w, PA0, PB0)
        if best is None or c2 < best[2]: best = (PA, PB, c2)
    PA0, PB0, c20 = best

    # step 1b: label assignment -- the true fB is the frequency whose
    # fundamental+harmonic pair also explains the aux channels; the swapped
    # assignment (harmonic relabeled as fundamental) leaves the other aux peak
    # unexplained and scores far worse.
    def aux_score(PBg):
        s = 0.0
        for ch in ['obs_1', 'obs_2']:
            s += chan_fB(g, ch, PBg)[1]
        return s
    if aux_score(PB0) <= aux_score(PA0):
        lab = 'fB=long-period solution retained'
    else:
        PA0, PB0 = PB0, PA0
        lab = 'swapped to put fundamental on the long period'
    report.append('%s: label assignment: PA=%.4f PB=%.4f (%s)' % (case, PA0, PB0, lab))

    # step 2: cross-channel PB validation
    fBs, costs = [], []
    for ch in ['obs_1', 'obs_2']:
        fB_ch, c2_free, c2_fix, _ = chan_fB(g, ch, PB0)
        fBs.append(fB_ch); costs.append(c2_fix - c2_free)
    adopt_aux = (costs[0] > 500 and costs[1] > 500 and abs(1/fBs[0] - 1/fBs[1]) < 0.1)
    PB = 2.0/(fBs[0] + fBs[1]) if adopt_aux else PB0
    report.append('%s: obs_0 fit PA=%.4f PB=%.4f chi2=%.2f; aux PB=%s fixed-cost=%s -> PB=%.4f (%s)'
                  % (case, PA0, PB0, c20, [round(1/f, 4) for f in fBs],
                     [round(c, 1) for c in costs], PB,
                     'aux consensus' if adopt_aux else 'obs_0 value'))

    # step 3: PA search at fixed PB + presence test
    b_noA, c2_noA, _ = fit_fixed_pb(t, y, w, PB, 1.0, withA=False)
    resid = y - design(t, 1.0, PB, withA=False) @ b_noA
    rpeaks = periodogram_peaks(t, resid, g['obs_0_err'].values, n=6)
    bestA = None
    for f, p in rpeaks:
        PA1 = 1/f
        if abs(PA1 - PB) < 0.3 or abs(PA1 - PB/2) < 0.05: continue
        def f1(p, PA1=PA1):
            PAx = np.exp(p[0])
            if PAx < 2: return 1e18
            return fit_fixed_pb(t, y, w, PB, PAx, withA=True)[1]
        r = minimize(f1, [np.log(PA1)], method='Nelder-Mead',
                     options={'xatol': 1e-10, 'fatol': 1e-10, 'maxiter': 4000})
        if bestA is None or r.fun < bestA[1]: bestA = (float(np.exp(r.x[0])), r.fun)
    PA, c2_full = bestA
    b_full, _, C_full = fit_fixed_pb(t, y, w, PB, PA, withA=True)
    amp = float(np.hypot(b_full[0], b_full[1])); sig = float(np.sqrt(C_full[0, 0] + C_full[1, 1]))
    dchi2 = c2_noA - c2_full
    present = (amp/sig >= 4.0) and (dchi2 >= 20.0)
    report.append('%s: PB fixed=%.4f; PA=%.4f chi2=%.2f vs noA %.2f (dchi2=%.1f); A amp=%.3f+-%.3f (%.1f s) -> present=%d'
                  % (case, PB, PA, c2_full, c2_noA, dchi2, amp, sig, amp/sig, int(present)))

    # step 4: optional distractor augmentation (delta-BIC < -10)
    extra_periods = []; b_use, c2_use = (b_full, c2_full) if present else (b_noA, c2_noA)
    for _ in range(2):
        model = design(t, PA if present else 1.0, PB, withA=present)
        for P in extra_periods:
            x = 2*np.pi*(t-T0)/P
            model = np.column_stack([model, np.sin(x), np.cos(x)])
        rres = y - model @ b_use
        improved = False
        for f, p in periodogram_peaks(t, rres, g['obs_0_err'].values, n=3):
            Pn = 1/f
            known = [PB] + ([PA] if present else []) + extra_periods
            if any(abs(Pn - q)/q < 0.05 for q in known): continue
            x = 2*np.pi*(t-T0)/Pn
            model2 = np.column_stack([model, np.sin(x), np.cos(x)])
            try: b2, c22, _ = wls(model2, y, w)
            except np.linalg.LinAlgError: continue
            if (c22 + model2.shape[1]*np.log(N)) < (c2_use + model.shape[1]*np.log(N)) - 10:
                extra_periods.append(Pn); b_use, c2_use = b2, c22; improved = True; break
        if not improved: break
    if extra_periods:
        report.append('%s: distractor columns at P=%s (delta-BIC); reported coeffs from augmented fit'
                      % (case, [round(p, 3) for p in extra_periods]))

    # final coefficients
    if present:
        bA1, bA2 = b_use[0], b_use[1]; bB = b_use[2:6]; off = b_use[6]
        model = design(t, PA, PB, True)
        for P in extra_periods:
            x = 2*np.pi*(t-T0)/P
            model = np.column_stack([model, np.sin(x), np.cos(x)])
        rms = float(np.sqrt(np.mean((y - model @ b_use)**2)))
        report.append('%s: FINAL present PA=%.4f PB=%.4f chi2=%.2f resid_rms=%.3f (median err=%.3f)'
                      % (case, PA, PB, c2_use, rms, np.median(g['obs_0_err'].values)))
    else:
        def fPB(p):
            PBx = np.exp(p[0])
            if PBx < 2: return 1e18
            return wls(design(t, 1.0, PBx, withA=False), y, w)[1]
        r = minimize(fPB, [np.log(PB)], method='Nelder-Mead',
                     options={'xatol': 1e-10, 'fatol': 1e-10, 'maxiter': 4000})
        PB = float(np.exp(r.x[0]))
        b_noA2, c2_noA2, _ = wls(design(t, 1.0, PB, withA=False), y, w)
        bB = b_noA2[0:4]; off = b_noA2[4]; bA1 = bA2 = 0.0; PA = 0.0
        rms = float(np.sqrt(np.mean((y - design(t, 1.0, PB, withA=False) @ b_noA2)**2)))
        report.append('%s: FINAL absent PB=%.4f chi2=%.2f resid_rms=%.3f (median err=%.3f)'
                      % (case, PB, c2_noA2, rms, np.median(g['obs_0_err'].values)))

    summary_rows.append({'case_id': case, 'component_a_present': int(present),
        'component_a_period_day': PA, 'component_a_basis1_u0': bA1, 'component_a_basis2_u0': bA2,
        'component_b_period_day': PB, 'component_b_basis1_u0': bB[0], 'component_b_basis2_u0': bB[1],
        'component_b_basis3_u0': bB[2], 'component_b_basis4_u0': bB[3], 'offset_u0': off})
    for _, row in tgt[tgt.case_id == case].iterrows():
        td = float(row['time_day'])
        val = bA1*np.sin(2*np.pi*(td - T0)/PA) + bA2*np.cos(2*np.pi*(td - T0)/PA) if present else 0.0
        pred_rows.append((row['case_id'], row['time_day'], val))

sum_cols = ['case_id', 'component_a_present', 'component_a_period_day', 'component_a_basis1_u0',
            'component_a_basis2_u0', 'component_b_period_day', 'component_b_basis1_u0',
            'component_b_basis2_u0', 'component_b_basis3_u0', 'component_b_basis4_u0', 'offset_u0']
with open('signal_summary.csv', 'w', newline='') as fh:
    wr = csv.writer(fh); wr.writerow(sum_cols)
    for r in summary_rows:
        wr.writerow([r['case_id']] + [('%d' % r[c]) if c == 'component_a_present' else
                                      (('0.0' if r[c] == 0 else '%.10g' % r[c]))
                                      for c in sum_cols[1:]])
with open('target_predictions.csv', 'w', newline='') as fh:
    wr = csv.writer(fh); wr.writerow(['case_id', 'time_day', 'component_a_value_u0'])
    for cid, td, v in pred_rows:
        wr.writerow([cid, td, ('0.0' if v == 0 else '%.10g' % v)])

print('=== diagnostics report ===')
for line in report: print(line)
print(); print('signal_summary.csv:'); print(open('signal_summary.csv').read())
print('target_predictions.csv:'); print(open('target_predictions.csv').read())
