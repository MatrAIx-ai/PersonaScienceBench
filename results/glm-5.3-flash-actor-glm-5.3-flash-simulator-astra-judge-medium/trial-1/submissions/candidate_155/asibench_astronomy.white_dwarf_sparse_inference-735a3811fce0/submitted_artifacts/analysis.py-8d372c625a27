         "no_legend": True},
    ]


def render_mpl(spec, path):
    fig, axes = plt.subplots(1, 3, figsize=(17, 5))
    for ax, pan in zip(axes, spec["panels"]):
        for s in pan["series"]:
            if s["kind"] == "line":
                ax.plot(s["x"], s["y"], "-", lw=1.5, color=s["color"],
                        label=s.get("label"))
            elif s["kind"] == "point":
                ax.plot(s["x"], s["y"], ".", ms=5, color=s["color"],
                        label=s.get("label"))
            else:
                ax.errorbar(s["x"], s["y"], xerr=s.get("xerr"),
                            yerr=s.get("yerr"), fmt="o", ms=4, capsize=2,
                            color=s["color"], label=s.get("label"))
        if pan.get("invert_x"):
            ax.invert_xaxis()
        ax.set_xlabel(pan["xlabel"]); ax.set_ylabel(pan["ylabel"])
        ax.set_title(pan["title"]); ax.legend(fontsize=8)
    fig.suptitle(spec["suptitle"]); fig.tight_layout()
    fig.savefig(path, dpi=150); plt.close(fig)

