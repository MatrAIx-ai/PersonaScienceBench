#!/usr/bin/env python3
"""
Sparse/noisy compact-star sequence reconstruction (B3 task, white-dwarf episode).

Physical model: cold, zero-temperature electron-degenerate (Chandrasekhar)
white-dwarf sequence.  Relativistic degenerate-electron equation of state

    rho(x) = mu_e * m_u * (m_e c / hbar)^3 * x^3 / (3 pi^2)          [g/cm^3]
    P(x)   = (m_e^4 c^5 / 24 pi^2 hbar^3) * f(x)                     [dyn/cm^2]
    f(x)   = x (2x^2 - 3) sqrt(1+x^2) + 3 asinh(x),   x = p_F / (m_e c)

combined with Newtonian hydrostatic equilibrium

    dP/dr = -G m rho / r^2 ,      dm/dr = 4 pi r^2 rho ,

integrated from a central density rho_c (parameter x_c) out to the surface
defined by rho/rho_c = surface_threshold (manifest: 0.0001).

The dimensionless profile shapes depend only on x_c; the mass/radius scales
are set by mu_e (M ~ mu_e^-2, R ~ mu_e^-1).  A single global parameter mu_e
is fitted JOINTLY to the M-R observations and the (partially missing) profile
fragments with the reported per-point Gaussian uncertainties.  Every output
(M-R curve, scalar radii, mass limit, profiles) is generated from this one
reconstructed sequence, satisfying the manifest's single-family consistency,
monotonicity and smoothness constraints by construction.
"""
import json
import os
import numpy as np
import pandas as pd
from scipy.integrate import solve_ivp
from scipy.optimize import least_squares
from scipy.interpolate import interp1d

# ----------------------------------------------------------------------------
# physical constants (CGS)
# ----------------------------------------------------------------------------
m_e = 9.1093837015e-28      # g
c = 2.99792458e10           # cm/s
hbar = 1.054571817e-27      # erg s
G = 6.67430e-8              # cgs
m_u = 1.66053906660e-24     # g
Msun = 1.98892e33           # g

P0 = m_e**4 * c**5 / (24.0 * np.pi**2 * hbar**3)
SURF_THRESH = 1.0e-4        # rho/rho_c surface threshold (physics_manifest)


def eos_f(x):
    s = np.sqrt(1.0 + x * x)
    return x * (2.0 * x * x - 3.0) * s + 3.0 * np.arcsinh(x)


def eos_fp(x):
    s = np.sqrt(1.0 + x * x)
    return (2.0 * x * x - 3.0) * s + 4.0 * x * x * s \
        + x * x * (2.0 * x * x - 3.0) / s + 3.0 / s


def rho_const(mu_e):
    return ((m_e * c) / hbar) ** 3 / (3.0 * np.pi**2) * mu_e * m_u


def solve_wd(xc, mu_e=2.0, n_profile=4001, want_profile=True):
    """Integrate one Chandrasekhar model. Returns M [Msun], R [km] and,
    optionally, dense profiles (r/R, rho/rho_c, m/M)."""
    K = rho_const(mu_e)
    rhoc = K * xc**3
    xsurf = xc * SURF_THRESH ** (1.0 / 3.0)

    def rhs(r, y):
        x, m = y
        x = max(x, 1e-13)
        rho = K * x**3
        return [-G * m * rho / (r * r * P0 * eos_fp(x)), 4.0 * np.pi * r * r * rho]

    def event(r, y):
        return y[0] - xsurf
    event.terminal = True
    event.direction = -1

    r0 = 1.0  # cm
    m0 = 4.0 * np.pi / 3.0 * r0**3 * rhoc
    sol = solve_ivp(rhs, [r0, 1e14], [xc, m0], rtol=1e-8,
                    atol=[1e-12, 1e3], events=event, dense_output=want_profile)
    Rs = sol.t_events[0][0] if len(sol.t_events[0]) else sol.t[-1]
    M = sol.y[1, -1] / Msun
    R_km = Rs / 1e5
    if not want_profile:
        return M, R_km, None
    rr = np.linspace(0.0, Rs, n_profile)
    rr[0] = 1e-6
    yy = sol.sol(rr)
    rf = rr / Rs
    rho_frac = (yy[0] / xc) ** 3
    m_frac = yy[1] / yy[1, -1]
    return M, R_km, (rf, rho_frac, m_frac)


# ----------------------------------------------------------------------------
# load data
# ----------------------------------------------------------------------------
os.makedirs("results", exist_ok=True)

mr = pd.read_csv("data/mr_observations.csv")
pf = pd.read_csv("data/profile_fragments.csv")
query = json.load(open("data/query_targets.json"))

Mo = mr.mass_solar_obs.values
Ro = mr.radius_km_obs.values
sM = mr.sigma_mass_solar.values
sR = mr.sigma_radius_km.values

eval_masses = np.array(query["mr_eval_masses_solar"])
profile_targets = np.array(query["profile_target_masses_solar"])
xi_grid = np.array(query["radius_fraction_grid"])

# ----------------------------------------------------------------------------
# reference grid of models at mu_e = 2: M(x_c), R(x_c)
# ----------------------------------------------------------------------------
xcs = np.geomspace(0.05, 1000.0, 90)
grid_M, grid_R = [], []
for xc in xcs:
    M, R, _ = solve_wd(xc, mu_e=2.0, want_profile=False)
    grid_M.append(M)
    grid_R.append(R)
grid_M = np.array(grid_M)
grid_R = np.array(grid_R)
o = np.argsort(grid_M)
xc_of_M = interp1d(grid_M[o], xcs[o], kind="cubic", fill_value="extrapolate")


def model_R_at_mass(masses, mu_e):
    """Model radius [km] at given masses for electron weight mu_e."""
    Mi = grid_M * (2.0 / mu_e) ** 2
    Ri = grid_R * (2.0 / mu_e)
    oo = np.argsort(Mi)
    return interp1d(Mi[oo], Ri[oo], kind="cubic", fill_value="extrapolate")(masses)


def model_profile_at_mass(mass, mu_e, xi_points):
    """Solve directly at the x_c implied by `mass`; return rho/rho_c and m/M
    at the requested radius fractions (plus the model M, R)."""
    xc = float(xc_of_M(mass * (mu_e / 2.0) ** 2))
    M, R, (rf, rho_frac, m_frac) = solve_wd(xc, mu_e=mu_e, want_profile=True)
    rho_i = interp1d(rf, rho_frac, kind="linear", fill_value="extrapolate")
    m_i = interp1d(rf, m_frac, kind="linear", fill_value="extrapolate")
    xc_ = np.clip(xi_points, 1e-12, 1.0)
    out_rho = np.where(xi_points <= 0, 1.0, rho_i(xc_))
    out_rho = np.where(xi_points >= 1.0, SURF_THRESH, out_rho)
    out_m = np.where(xi_points <= 0, 0.0, m_i(xc_))
    out_m = np.where(xi_points >= 1.0, 1.0, out_m)
    return out_rho, out_m, (M, R)


# ----------------------------------------------------------------------------
# joint weighted least-squares fit of mu_e (single global parameter)
# ----------------------------------------------------------------------------
def mr_residuals(mu_e):
    """Radius residuals including the mass-uncertainty contribution via the
    local model slope dR/dM."""
    Rp = model_R_at_mass(Mo, mu_e)
    dM = np.maximum(1e-4 * Mo, 1e-5)
    slope = (model_R_at_mass(Mo + dM, mu_e)
             - model_R_at_mass(np.maximum(Mo - dM, 1e-3), mu_e)) \
        / (dM + np.maximum(Mo - dM, 1e-3) - Mo + Mo) * 0 + \
        (model_R_at_mass(Mo + dM, mu_e)
         - model_R_at_mass(np.maximum(Mo - dM, 1e-3), mu_e)) \
        / (Mo + dM - np.maximum(Mo - dM, 1e-3))
    s_eff = np.sqrt(sR**2 + (slope * sM) ** 2)
    return (Rp - Ro) / s_eff


def profile_residuals(mu_e):
    res = []
    for tm, g in pf.groupby("target_mass_solar"):
        d = g.dropna(subset=["density_fraction_obs"])
        e = g.dropna(subset=["enclosed_mass_fraction_obs"])
        rho_pred, _, _ = model_profile_at_mass(tm, mu_e, d.radius_fraction.values)
        res.append((rho_pred - d.density_fraction_obs.values)
                   / d.sigma_density_fraction.values)
        _, m_pred, _ = model_profile_at_mass(tm, mu_e, e.radius_fraction.values)
        res.append((m_pred - e.enclosed_mass_fraction_obs.values)
                   / e.sigma_enclosed_mass_fraction.values)
    return np.concatenate(res)


def joint_residual(p):
    mu_e = 2.0 * np.exp(p[0])
    return np.concatenate([mr_residuals(mu_e), profile_residuals(mu_e)])


fit = least_squares(joint_residual, [0.0], xtol=1e-12, ftol=1e-12)
mu_e_joint = 2.0 * np.exp(fit.x[0])
r_mr = mr_residuals(mu_e_joint)
r_prof = profile_residuals(mu_e_joint)
n_mr, n_prof = len(Mo), len(r_prof)
chi2_mr = float(np.sum(r_mr**2))
chi2_prof = float(np.sum(r_prof**2))
chi2_tot = chi2_mr + chi2_prof
red_tot = chi2_tot / (n_mr + n_prof)

# M-R-only fit (diagnostic comparison)
fit_mr = least_squares(lambda p: mr_residuals(2.0 * np.exp(p[0])), [0.0],
                       xtol=1e-12, ftol=1e-12)
mu_e_mr = 2.0 * np.exp(fit_mr.x[0])
chi2_mr_only = float(np.sum(mr_residuals(mu_e_mr) ** 2))

# two-parameter flexibility check: mu_e + independent radius scale alpha
# (diagnostic only: alpha = R_pred * alpha, i.e. decoupled radius scale)
Rp1 = model_R_at_mass(Mo, mu_e_joint)
dM = np.maximum(1e-4 * Mo, 1e-5)
slope = (model_R_at_mass(Mo + dM, mu_e_joint)
         - model_R_at_mass(np.maximum(Mo - dM, 1e-3), mu_e_joint)) \
    / (Mo + dM - np.maximum(Mo - dM, 1e-3))
s_eff = np.sqrt(sR**2 + (slope * sM) ** 2)

def joint_residual2(p):
    mu_e = 2.0 * np.exp(p[0])
    alpha = np.exp(p[1])
    return np.concatenate([(alpha * model_R_at_mass(Mo, mu_e) - Ro) / s_eff,
                           profile_residuals(mu_e)])

fit2 = least_squares(joint_residual2, [0.0, 0.0], xtol=1e-12, ftol=1e-12)
chi2_2p = float(np.sum(fit2.fun**2))
mu_e_2p = 2.0*np.exp(fit2.x[0]); alpha_2p = float(np.exp(fit2.x[1]))
r2 = joint_residual2(fit2.x)
n2a = len(Mo)
print(f"  2-param detail: mu_e={mu_e_2p:.4f} alpha={alpha_2p:.5f} "
      f"chi2_MR={np.sum(r2[:n2a]**2):.2f}/{n2a} "
      f"chi2_prof={np.sum(r2[n2a:]**2):.2f}/{len(r2)-n2a}")

print("=== fit summary ===")
print(f"joint fit:   mu_e = {mu_e_joint:.5f}   chi2_MR={chi2_mr:.2f}/{n_mr}  "
      f"chi2_prof={chi2_prof:.2f}/{n_prof}  reduced={red_tot:.3f}")
print(f"M-R-only:    mu_e = {mu_e_mr:.5f}   chi2_MR={chi2_mr_only:.2f}/{n_mr}  "
      f"reduced={chi2_mr_only/n_mr:.3f}")
print(f"2-param (mu_e + R scale): chi2={chi2_2p:.2f} (joint 1-param {chi2_tot:.2f})")

# ----------------------------------------------------------------------------
# leave-one-out check on the M-R points (refit mu_e from M-R only)
# ----------------------------------------------------------------------------
loo_z = []
for i in range(len(Mo)):
    keep = np.arange(len(Mo)) != i

    def loo_res(p, keep=keep):
        return mr_residuals(2.0 * np.exp(p[0]))[keep]
    fl = least_squares(loo_res, [0.0], xtol=1e-12, ftol=1e-12)
    loo_z.append(mr_residuals(2.0 * np.exp(fl.x[0]))[i])
loo_z = np.array(loo_z)
print(f"LOO z-scores on M-R: max|z|={np.abs(loo_z).max():.2f}, "
      f"rms={np.sqrt((loo_z**2).mean()):.2f}")

# ----------------------------------------------------------------------------
# mass limit and summary radii
# ----------------------------------------------------------------------------
M_big = [solve_wd(xc_big, mu_e=mu_e_joint, want_profile=False)[0]
         for xc_big in (300.0, 1000.0, 3000.0)]
M_limit_numeric = M_big[-1]
M_limit_analytic = 5.836 / mu_e_joint**2
print(f"mass limit: numeric asymptote={M_limit_numeric:.4f}  "
      f"analytic 5.836/mu_e^2={M_limit_analytic:.4f}")

R_eval = model_R_at_mass(eval_masses, mu_e_joint)
summary_radii = {}
for key, m in [("radius_at_0p6Msun_km", 0.6), ("radius_at_1p0Msun_km", 1.0),
               ("radius_at_1p2Msun_km", 1.2), ("radius_at_1p3Msun_km", 1.3)]:
    summary_radii[key] = float(model_R_at_mass(np.array([m]), mu_e_joint)[0])

summary = {
    "mass_limit_solar": float(M_limit_analytic),
    **{k: float(v) for k, v in summary_radii.items()},
}

# ----------------------------------------------------------------------------
# outputs
# ----------------------------------------------------------------------------
pd.DataFrame({"mass_solar": eval_masses, "radius_km": R_eval}).to_csv(
    "results/mr_reconstruction.csv", index=False)

rho_arr = np.zeros((len(profile_targets), len(xi_grid)))
m_arr = np.zeros_like(rho_arr)
for i, tm in enumerate(profile_targets):
    rho_i, m_i, (Mt, Rt) = model_profile_at_mass(tm, mu_e_joint, xi_grid)
    rho_arr[i] = rho_i
    m_arr[i] = m_i
    # mutual-consistency diagnostic: integrate 4 pi r^2 rho from the density
    # channel and compare with the enclosed-mass channel
    rf_fine = np.linspace(0.0, 1.0, 20001)
    rho_fine, m_fine, _ = model_profile_at_mass(tm, mu_e_joint, rf_fine)
    xc = float(xc_of_M(tm * (mu_e_joint / 2.0) ** 2))
    rhoc = rho_const(mu_e_joint) * xc**3
    R_cm = Rt * 1e5
    integ = np.trapezoid(4 * np.pi * (rf_fine * R_cm)**2 * rho_fine * rhoc,
                         rf_fine * R_cm)
    print(f"profile M={tm}: model M={Mt:.4f} R={Rt:.1f} km; "
          f"encm(1.0)={m_i[-1]:.6f}; density(1.0)={rho_i[-1]:.3e}; "
          f"mass integrated from density / M = {integ/Msun/Mt:.6f}")

np.savez("results/profiles_reconstruction.npz",
         density_fraction=rho_arr,
         enclosed_mass_fraction=m_arr)

json.dump(summary, open("results/summary.json", "w"), indent=2)
print("summary:", json.dumps(summary))

mm = np.linspace(0.05, float(eval_masses.max()), 400)
mm_r = model_R_at_mass(mm, mu_e_joint)

