def write_png(path, img):
    import zlib, struct
    h, w, _ = img.shape
    raw = b"".join(b"\x00" + img[i].tobytes() for i in range(h))
    def chunk(tag, data):
        return (struct.pack(">I", len(data)) + tag + data
                + struct.pack(">I", zlib.crc32(tag + data) & 0xFFFFFFFF))
    png = (b"\x89PNG\r\n\x1a\n"
           + chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0))
           + chunk(b"IDAT", zlib.compress(raw, 6))
           + chunk(b"IEND", b""))
    open(path, "wb").write(png)


def draw_text(img, x0, y0, text, scale=2, color=(0, 0, 0)):
    h, w, _ = img.shape
    cx = x0
    for ch in text:
        g = GLYPHS.get(ch, GLYPHS[" "])
        for ry, row in enumerate(g):
            for rx, bit in enumerate(row):
                if bit == "1":
                    yy = y0 + ry * scale
                    xx = cx + rx * scale
                    if 0 <= yy < h - scale and 0 <= xx < w - scale:
                        img[yy:yy+scale, xx:xx+scale] = color
        cx += 6 * scale


def draw_seg(img, x0, y0, x1, y1, color, lw=1):
    h, w, _ = img.shape
    n = int(max(abs(x1-x0), abs(y1-y0))) + 1
    xs = np.linspace(x0, x1, max(n,2)).round().astype(int)
    ys = np.linspace(y0, y1, max(n,2)).round().astype(int)
    ok = (xs >= 1) & (xs < w-1) & (ys >= 1) & (ys < h-1)
    img[ys[ok], xs[ok]] = color
    if lw > 1:
        for d in (-1, 1):
            img[np.clip(ys[ok]+d,0,h-1), xs[ok]] = color
            img[ys[ok], np.clip(xs[ok]+d,0,w-1)] = color


def _fmt(v):
    a = abs(v)
    if a != 0 and (a >= 1e4 or a < 0.01):
        return "%.0e" % v
    if a >= 100:
        return "%.0f" % v
    if a >= 1:
        return "%.1f" % v
    return "%.2f" % v


def nice_ticks(lo, hi, n=5):
    if hi <= lo:
        hi = lo + 1.0
    raw = (hi - lo) / max(n - 1, 1)
    mag = 10.0 ** np.floor(np.log10(raw))
    for mult in (1.0, 2.0, 2.5, 5.0, 10.0):
        step = mult * mag
        if step >= raw:
            break
    t0 = np.ceil(lo / step) * step
    return np.arange(t0, hi + 1e-9 * step, step)


def render_fallback(spec, path):
    W, H = 1680, 560
    img = np.full((H, W, 3), 255, np.uint8)
    black = COLORS["k"]
    pw = (W - 60) // 3
    ph = H - 100
    for pi, pan in enumerate(spec["panels"]):
        x0, y0 = 20 + pi * pw, 12
        plot_w, plot_h = pw - 70, ph - 40
        allx = [s["x"] for s in pan["series"]]
        ally = [s["y"] for s in pan["series"]]
        for s in pan["series"]:
            if s.get("yerr") is not None:
                ally += [s["y"] + s["yerr"], s["y"] - s["yerr"]]
            if s.get("xerr") is not None:
                allx += [s["x"] + s["xerr"], s["x"] - s["xerr"]]
        allx = np.concatenate(allx); ally = np.concatenate(ally)
        xmin, xmax = allx.min(), allx.max()
        ymin, ymax = ally.min(), ally.max()
        xmin -= 0.05 * (xmax - xmin or 1.0); xmax += 0.05 * (xmax - xmin or 1.0)
        ymin -= 0.08 * (ymax - ymin or 1.0); ymax += 0.08 * (ymax - ymin or 1.0)
        if pan.get("invert_x"):
            xmin, xmax = xmax, xmin

        def tx(x):
            return int(x0 + 52 + (x - xmin) / (xmax - xmin) * plot_w)
        def ty(y):
            return int(y0 + plot_h - (y - ymin) / (ymax - ymin) * plot_h)

        draw_seg(img, tx(xmin), ty(ymin), tx(xmax), ty(ymin), black)
        draw_seg(img, tx(xmin), ty(ymin), tx(xmin), ty(ymax), black)
        for tv in nice_ticks(min(ymin, ymax), max(ymin, ymax)):
            py = ty(tv)
            if y0 - 5 <= py <= y0 + plot_h + 5:
                draw_seg(img, tx(xmin) - 4, py, tx(xmin), py, black)
                lbl = _fmt(tv)
                draw_text(img, tx(xmin) - 8 - 6 * len(lbl) * 2, py - 7, lbl, 2, black)
        for tv in nice_ticks(min(xmin, xmax), max(xmin, xmax)):
            px = tx(tv)
            if x0 + 45 <= px <= x0 + 45 + plot_w + 5:
                draw_seg(img, px, ty(ymin), px, ty(ymin) + 4, black)
                lbl = _fmt(tv)
                draw_text(img, px - 6 * len(lbl), ty(ymin) + 8, lbl, 2, black)
        draw_text(img, x0 + 52 + plot_w // 2 - 6 * len(pan["xlabel"]),
                  y0 + plot_h + 28, pan["xlabel"], 2, black)
        ylab = pan["ylabel"]
        cx = x0 + 6
        cy = y0 + plot_h // 2 + 6 * len(ylab)
        for k, ch in enumerate(ylab):
            g = GLYPHS.get(ch, GLYPHS[" "])
            for ry, row in enumerate(g):
                for rx, bit in enumerate(row):
                    if bit == "1":
                        yy = cy - k * 12 - ry * 2
                        xx = cx + ry * 2
                        img[yy:yy+2, xx:xx+2] = black
        draw_text(img, x0 + 52, y0 + 2, pan["title"], 2, black)
        li = 0
        for s in pan["series"]:
            col = COLORS.get(s["color"], (0, 0, 0))
            if s["kind"] == "line":
                xa = np.asarray(s["x"], float); ya = np.asarray(s["y"], float)
                if pan.get("invert_x"):
                    xa = xa  # tx handles inversion via xmin/xmax swap
                for j in range(len(xa) - 1):
                    draw_seg(img, tx(xa[j]), ty(ya[j]), tx(xa[j+1]), ty(ya[j+1]), col)
            elif s["kind"] == "point":
                for xv, yv in zip(s["x"], s["y"]):
                    px, py = tx(xv), ty(yv)
                    img[py-2:py+3, px-2:px+3] = col
            else:
                ye = s.get("yerr")
                if ye is not None:
                    for xv, yv, yy_ in zip(s["x"], s["y"], ye):
                        px, py = tx(xv), ty(yv)
                        draw_seg(img, px, ty(yv-yy_), px, ty(yv+yy_), col)
                        draw_seg(img, px-3, ty(yv+yy_), px+3, ty(yv+yy_), col)
                        draw_seg(img, px-3, ty(yv-yy_), px+3, ty(yv-yy_), col)
                xe = s.get("xerr")
                if xe is not None:
                    for xv, yv, xx_ in zip(s["x"], s["y"], xe):
                        px, py = tx(xv), ty(yv)
                        draw_seg(img, tx(xv-xx_), py, tx(xv+xx_), py, col)
                        draw_seg(img, tx(xv-xx_), py-3, tx(xv-xx_), py+3, col)
                        draw_seg(img, tx(xv+xx_), py-3, tx(xv+xx_), py+3, col)
                for xv, yv in zip(s["x"], s["y"]):
                    px, py = tx(xv), ty(yv)
                    img[py-2:py+3, px-2:px+3] = col
            if s.get("label") and not s.get("no_legend"):
                ly = y0 + 22 + li * 14
                img[ly:ly+8, x0+58:x0+74] = col
                draw_text(img, x0+80, ly, s["label"], 2, black)
                li += 1
    draw_text(img, 20, H - 28, spec["suptitle"], 2, black)
    write_png(path, img)


