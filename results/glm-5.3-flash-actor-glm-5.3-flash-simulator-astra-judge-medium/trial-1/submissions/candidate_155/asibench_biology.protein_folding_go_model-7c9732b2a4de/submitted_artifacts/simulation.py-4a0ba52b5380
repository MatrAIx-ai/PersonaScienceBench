"""
B3: Interacting-bead stochastic dynamics on a reference configuration.

Go-type bead model (harmonic backbone bonds at native lengths, LJ 10-12 native
wells of depth 1 kBT, soft-core non-native repulsion) simulated with BAOAB
Langevin dynamics at every temperature in data/parameters.json, each run started
from the reference configuration.  All runtime parameters come from the file.
Only numpy, scipy and matplotlib are used.
"""
import json
import numpy as np

RNG_SEED = 12345

with open("data/parameters.json") as fh:
    P = json.load(fh)
N = int(P["n_beads"]); GAMMA = float(P["friction"]); DT = float(P["dt_reduced"])
TEMPS = [float(t) for t in P["temperature_list"]]; K = len(TEMPS)
NSTEPS = int(P["n_steps_per_T"]); CUTOFF = float(P["contact_cutoff"])
MINSEP = int(P["min_seq_separation"]); SAVE = int(P["save_interval"])

X_REF = np.load("data/target_coords.npy")
assert X_REF.shape == (N, 3)
N_CKPT = NSTEPS // SAVE                      # 230 saved frames per temperature

iu, ju = np.triu_indices(N, k=1)
sep = ju - iu
DREF = np.linalg.norm(X_REF[iu] - X_REF[ju], axis=1)
native_mask = (sep >= MINSEP) & (DREF <= CUTOFF)
NI, NJ = iu[native_mask], ju[native_mask]
R0N = DREF[native_mask]; M = NI.size         # M = 36 native adjacency relations
CONTACT_FORM = 1.2 * R0N                     # deterministic formation criterion
bond_mask = (sep == 1)
BI, BJ = iu[bond_mask], ju[bond_mask]; R0B = DREF[bond_mask]
rep_mask = (sep >= 2) & (~native_mask)
RI, RJ = iu[rep_mask], ju[rep_mask]
SIG_REP = 3.0                                # excluded-volume diameter (< bond)

K_BOND = 100.0      # harmonic bond stiffness (kBT/length^2)
EPS = 1.0           # native well depth (kBT)
RC_FACTOR = 2.0     # native well truncated (shifted-force) at 2*r0
FMAX = 5000.0       # safety cap on repulsive force magnitude

def _native_well(r, r0):
    """LJ 10-12 well, minimum -EPS at r=r0, shifted-force truncated at 2*r0."""
    rc = RC_FACTOR * r0
    s = r0 / r
    u = EPS * (5.0 * s**12 - 6.0 * s**10)
    du = (60.0 * EPS / r) * (s**10 - s**12)
    sc = r0 / rc
    u_c = EPS * (5.0 * sc**12 - 6.0 * sc**10)
    du_c = (60.0 * EPS / rc) * (sc**10 - sc**12)
    u = np.where(r < rc, u - u_c - (r - rc) * du_c, 0.0)
    du = np.where(r < rc, du - du_c, 0.0)
    return u, du

def forces_and_energy(x):
    """Total force (N,3) and potential energy U in reduced units (kBT at T=1)."""
    f = np.zeros_like(x); u_tot = 0.0
    d = x[BI] - x[BJ]; r = np.linalg.norm(d, axis=1)
    du = K_BOND * (r - R0B); u_tot += 0.5 * np.sum(du * (r - R0B))
    fv = (-du / r)[:, None] * d
    np.add.at(f, BI, fv); np.add.at(f, BJ, -fv)
    d = x[NI] - x[NJ]; r = np.linalg.norm(d, axis=1)
    u, du = _native_well(r, R0N); u_tot += np.sum(u)
    fv = (-du / r)[:, None] * d
    np.add.at(f, NI, fv); np.add.at(f, NJ, -fv)
    d = x[RI] - x[RJ]; r = np.linalg.norm(d, axis=1)
    ins = r < SIG_REP
    if np.any(ins):
        ri, di = r[ins], d[ins]
        du = -12.0 * SIG_REP**12 / ri**13
        u_tot += np.sum(SIG_REP**12 / ri**12)
        fv = (-du / ri)[:, None] * di
        fmag = np.linalg.norm(fv, axis=1)
        fv = fv * np.minimum(1.0, FMAX / np.maximum(fmag, 1e-12))[:, None]
        np.add.at(f, RI[ins], fv); np.add.at(f, RJ[ins], -fv)
    return f, u_tot

def q_value(x):
    r = np.linalg.norm(x[NI] - x[NJ], axis=1)
    return float(np.mean(r <= CONTACT_FORM))

C1 = np.exp(-GAMMA * DT); C2 = np.sqrt(1.0 - C1 * C1)

def run_temperature(T, x0, rng):
    """BAOAB Langevin dynamics (mass 1, kBT = T).  Returns x, Q, U, contacts."""
    x = x0.copy(); v = np.zeros_like(x)
    q_traj = np.empty(N_CKPT); u_traj = np.empty(N_CKPT)
    form = np.empty((N_CKPT, M)); ck = 0
    for step in range(1, NSTEPS + 1):
        f, _ = forces_and_energy(x)
        v += 0.5 * DT * f; x += 0.5 * DT * v
        v = C1 * v + C2 * np.sqrt(T) * rng.standard_normal(x.shape)
        x += 0.5 * DT * v
        f, u = forces_and_energy(x)
        v += 0.5 * DT * f
        if step % SAVE == 0 and ck < N_CKPT:
            q_traj[ck] = q_value(x); u_traj[ck] = u
            r = np.linalg.norm(x[NI] - x[NJ], axis=1)
            form[ck] = (r <= CONTACT_FORM)
            ck += 1
    return x, q_traj, u_traj, form

def main():
    rng = np.random.default_rng(RNG_SEED)
    warnings = []

    # ---- stability pre-check at the highest temperature (20 000 steps) ------
    x = X_REF.copy(); v = np.zeros_like(x)
    for step in range(1, 20001):
        f, _ = forces_and_energy(x)
        v += 0.5 * DT * f; x += 0.5 * DT * v
        v = C1 * v + C2 * np.sqrt(TEMPS[-1]) * rng.standard_normal(x.shape)
        x += 0.5 * DT * v
        f, _ = forces_and_energy(x)
        v += 0.5 * DT * f
        if step % 5000 == 0:
            rb = np.linalg.norm(x[BI] - x[BJ], axis=1)
            rmin = min(np.linalg.norm(x[NI] - x[NJ], axis=1).min(),
                       np.linalg.norm(x[RI] - x[RJ], axis=1).min())
            print(f"[precheck T={TEMPS[-1]:.4f}] step {step:6d} "
                  f"max|bond stretch| {np.abs(rb - R0B).max():.3f} "
                  f"min pair dist {rmin:.3f} Q {q_value(x):.3f}")
    assert np.isfinite(x).all() and rb.max() < 10.0, "bond instability at T_max"

    # --------------------------- full ladder --------------------------------
    Q = np.empty((K, N_CKPT)); U = np.empty((K, N_CKPT))
    FORM = np.empty((K, N_CKPT, M)); final_lowT = None
    for t, T in enumerate(TEMPS):
        x_final, q_traj, u_traj, form = run_temperature(T, X_REF, rng)
        Q[t] = q_traj; U[t] = u_traj; FORM[t] = form
        if t == 0:
            final_lowT = x_final.copy()
        print(f"T={T:.4f}  <Q>={q_traj.mean():.4f}  varQ={q_traj.var():.4f}  "
              f"<U>={u_traj.mean():.3f}  varU={u_traj.var():.3f}")

    np.save("final_coords.npy", final_lowT.astype(np.float64))
    np.save("order_parameter_trajectory.npy", Q)

    # ------------------------------------------------ histograms of Q --------
    edges = np.linspace(0.0, 1.0, 51)
    centers = 0.5 * (edges[:-1] + edges[1:])
    counts = np.empty((K, 50))
    for t in range(K):
        h, _ = np.histogram(Q[t], bins=edges)
        counts[t] = h
    hist = counts / counts.sum(axis=1, keepdims=True)
    np.save("order_parameter_histograms.npy", hist)

    # ------------------------------------------- per-temperature observables -
    meanQ = Q.mean(axis=1); varQ = Q.var(axis=1)
    meanU = U.mean(axis=1); varU = U.var(axis=1)
    cv = varU / np.array(TEMPS)**2               # fluctuation heat capacity
    corrQE = np.empty(K)
    for t in range(K):
        sq, su = Q[t].std(), U[t].std()
        corrQE[t] = 0.0 if sq == 0 or su == 0 else float(np.corrcoef(Q[t], U[t])[0, 1])
    with open("temperature_observables.json", "w") as fh:
        json.dump({"temperatures": TEMPS,
                   "mean_order_parameter_by_T": meanQ.tolist(),
                   "var_order_parameter_by_T": varQ.tolist(),
                   "mean_energy_by_T": meanU.tolist(),
                   "var_energy_by_T": varU.tolist(),
                   "heat_capacity_direct_by_T": cv.tolist(),
                   "q_energy_correlation_by_T": corrQE.tolist()}, fh, indent=2)

    # heat-capacity curve: fluctuation estimates at ladder T, linearly interp.
    fine_T = np.linspace(TEMPS[0], TEMPS[-1], 200)
    cv_fine = np.interp(fine_T, np.array(TEMPS), cv)
    np.save("heat_capacity_curve.npy", np.vstack([fine_T, cv_fine]))

    # --------------------------------------------- T_star: <Q> = 0.5 crossing
    T_arr = np.array(TEMPS)
    cross = np.where((meanQ[:-1] - 0.5) * (meanQ[1:] - 0.5) <= 0)[0]
    if cross.size:
        i = int(cross[np.argmin(np.abs(meanQ[cross] - 0.5))])
        T_star = T_arr[i] + (0.5 - meanQ[i]) * (T_arr[i + 1] - T_arr[i]) / (meanQ[i + 1] - meanQ[i])
        T_used = T_arr[i] if abs(meanQ[i] - 0.5) <= abs(meanQ[i + 1] - 0.5) else T_arr[i + 1]
    elif np.all(meanQ > 0.5):
        slope = (meanQ[-1] - meanQ[-2]) / (T_arr[-1] - T_arr[-2])
        T_star = T_arr[-1] + (0.5 - meanQ[-1]) / slope; T_used = T_arr[-1]
        warnings.append("<Q>(T) never crossed 0.5 within the ladder (all > 0.5); "
                        "T_star obtained by linear extrapolation from the two hottest temperatures.")
    else:
        slope = (meanQ[1] - meanQ[0]) / (T_arr[1] - T_arr[0])
        T_star = T_arr[0] + (0.5 - meanQ[0]) / slope; T_used = T_arr[0]
        warnings.append("<Q>(T) never crossed 0.5 within the ladder (all < 0.5); "
                        "T_star obtained by linear extrapolation from the two coldest temperatures.")
    peak_cv = float(cv_fine.max())

    # -------- WHAM multi-histogram reweighting over all K trajectories -------
    # Ferrenberg-Swendsen WHAM with the trivial (temperature-only) bias: the
    # density of states e(Q) is estimated by a deterministic fixed-point
    # iteration (no optimizer on the free-energy landscape), then reweighted
    # to beta* = 1/T_star.  Per-bin energies are averaged over temperatures
    # (standard WHAM approximation); bins without data anywhere are excluded.
    beta = 1.0 / T_arr
    B = np.where(counts.sum(axis=0) > 0)[0]          # bins containing data
    u_bin = np.full((K, 50), np.nan)
    for t in range(K):
        idx = np.clip(((Q[t] - edges[0]) / (edges[1] - edges[0])).astype(int), 0, 49)
        for b in B:
            m = idx == b
            if m.any():
                u_bin[t, b] = U[t][m].mean()
    u_comb = np.nansum(np.where(np.isfinite(u_bin), u_bin, 0.0) * counts, axis=0) \
             / np.maximum(counts.sum(axis=0), 1)
    uB = u_comb[B]
    hB = counts[:, B]
    e = np.ones(B.size); f = np.zeros(K)
    for _ in range(200000):
        w = np.exp(-beta[:, None] * uB[None, :] + f[:, None])   # (K, nb)
        e_new = hB.sum(axis=0) / (N_CKPT * w.sum(axis=0))
        f_new = -np.log((e_new[None, :] * np.exp(-beta[:, None] * uB[None, :])).sum(axis=1))
        done = np.max(np.abs(f_new - f)) < 1e-12
        e, f = e_new, f_new
        if done:
            break
    beta_star = 1.0 / T_star
    P_star = e * np.exp(-beta_star * uB)
    P_star = P_star / P_star.sum()
    F_data = -T_star * np.log(np.maximum(P_star, 1e-300))
    F = np.full(50, F_data.max())                    # empty bins: finite clip
    F[B] = F_data
    F = F - F.min()
    q_wham_mean = float((P_star * centers[B]).sum())
    np.save("transition_free_energy_profile.npy", np.vstack([centers, F]))

    # ------------------ deterministic mode / barrier analysis on profile -----
    Fs = np.convolve(F, np.ones(3) / 3.0, mode="same")   # minimal smoothing
    local_min = [b for b in range(50)
                 if Fs[b] <= (Fs[b - 1] if b > 0 else np.inf)
                 and Fs[b] <= (Fs[b + 1] if b < 49 else np.inf)]
    if len(local_min) >= 2:
        order = sorted(local_min, key=lambda b: Fs[b])
        m1, m2 = order[0], order[1]
        lo_b, hi_b = min(m1, m2), max(m1, m2)
        barrier = float(max(0.0, Fs[lo_b:hi_b + 1].max() - min(Fs[m1], Fs[m2])))
        sep_modes = float(abs(centers[m1] - centers[m2]))
        modes = [float(centers[m1]), float(centers[m2])]
    else:
        modes = [float(centers[int(np.argmin(Fs))])]
        sep_modes = 0.0; barrier = 0.0
        warnings.append("Only one mode detected in the free-energy profile at T_star; "
                        "mode_separation and free_energy_barrier_kT set to 0.")

    # --------------------------------------- Q-energy joint histograms -------
    q_edges = np.linspace(0.0, 1.0, 21); e_edges = np.linspace(-3.0, 3.0, 21)
    qe = np.zeros((K, 20, 20))
    for t in range(K):
        e = U[t]; s = e.std()
        ez = np.zeros_like(e) if s == 0 else np.clip((e - e.mean()) / s, -3.0, 3.0)
        H, _, _ = np.histogram2d(Q[t], ez, bins=[q_edges, e_edges])
        qe[t] = H / H.sum()
    np.save("q_energy_joint_histograms.npy", qe)

    # --------------------------- native contact probabilities (K, M) ---------
    ncp = FORM.mean(axis=1)
    np.save("native_contact_probability.npy", ncp)

    # --------------------------------------------- Jaccard at lowest T -------
    d_fin = np.linalg.norm(final_lowT[iu] - final_lowT[ju], axis=1)
    cand = sep >= MINSEP
    A_ref = set(zip(iu[cand & (DREF <= CUTOFF)].tolist(), ju[cand & (DREF <= CUTOFF)].tolist()))
    A_fin = set(zip(iu[cand & (d_fin <= CUTOFF)].tolist(), ju[cand & (d_fin <= CUTOFF)].tolist()))
    jac = len(A_ref & A_fin) / len(A_ref | A_fin)

    with open("transition_analysis.json", "w") as fh:
        json.dump({"transition_temperature": float(T_star),
                   "peak_heat_capacity": peak_cv,
                   "order_parameter_at_transition_mean": q_wham_mean,
                   "order_parameter_at_transition_modes": modes,
                   "mode_separation": sep_modes,
                   "free_energy_barrier_kT": barrier,
                   "reference_contact_jaccard": float(jac),
                   "warnings": warnings}, fh, indent=2)

    # ------------------------------------------------------ visualization ----
    render_figure(final_lowT, hist, centers, meanQ, fine_T, cv_fine, cv,
                  F, ncp, T_star, T_used, jac, modes)

    print("\nSummary")
    print(f"  M native contacts      : {M}")
    print(f"  T_star (=<Q>=0.5 mid)  : {T_star:.5f}   (profile: WHAM over {K} temperatures)")
    print(f"  peak heat capacity     : {peak_cv:.4f}")
    print(f"  <Q> at transition (WHAM): {q_wham_mean:.4f}")
    print(f"  modes                  : {modes}")
    print(f"  mode separation        : {sep_modes:.4f}")
    print(f"  free-energy barrier    : {barrier:.4f} kBT*")
    print(f"  Jaccard (reference)    : {jac:.4f}")
    print(f"  warnings               : {warnings}")


# =====================================================================
# Visualization.  matplotlib is used when available; otherwise a pure
# numpy + stdlib (zlib/struct) PNG renderer with an embedded 5x7 bitmap
# font produces the same multi-panel figure (no external packages).
# =====================================================================
def render_figure(final_lowT, hist, centers, meanQ, fine_T, cv_fine, cv,
                  F, ncp, T_star, T_used, jac, modes):
    try:
        import matplotlib
        matplotlib.use("Agg")
        import matplotlib.pyplot as plt
        _render_mpl(final_lowT, hist, centers, meanQ, fine_T, cv_fine, cv,
                    F, ncp, T_star, T_used, jac, modes, plt)
    except ImportError:
        _render_np(final_lowT, hist, centers, meanQ, fine_T, cv_fine, cv,
                   F, ncp, T_star, T_used, jac, modes)

def _render_mpl(final_lowT, hist, centers, meanQ, fine_T, cv_fine, cv,
                F, ncp, T_star, T_used, jac, modes, plt):
    fig = plt.figure(figsize=(15, 9))
    ax = fig.add_subplot(2, 3, 1, projection="3d")
    ax.scatter(*X_REF.T, c="gray", s=14, alpha=0.5, label="reference")
    ax.scatter(*final_lowT.T, c="crimson", s=45, label="final (lowest T)")
    for a, b in zip(BI, BJ):
        ax.plot(*np.vstack([final_lowT[a], final_lowT[b]]).T, "r-", lw=1)
    ax.set_title("Final configuration (lowest T)"); ax.legend()
    ax = fig.add_subplot(2, 3, 2)
    for t in range(K):
        ax.plot(centers, hist[t], label=f"T={TEMPS[t]:.3f}")
    ax.set_xlabel("Q"); ax.set_ylabel("P(Q)")
    ax.set_title("Q histograms per temperature"); ax.legend(fontsize=7)
    ax = fig.add_subplot(2, 3, 3)
    ax.plot(TEMPS, meanQ, "o-", label="<Q>(T)")
    ax.axhline(0.5, color="gray", ls=":")
    ax.axvline(T_star, color="r", ls="--", label=f"T*={T_star:.3f}")
    ax.set_xlabel("T"); ax.set_ylabel("<Q>"); ax.legend()
    ax = fig.add_subplot(2, 3, 4)
    ax.plot(fine_T, cv_fine, "-"); ax.plot(TEMPS, cv, "o")
    ax.axvline(T_star, color="r", ls="--")
    ax.set_xlabel("T"); ax.set_ylabel("C = Var(U)/T$^2$")
    ax = fig.add_subplot(2, 3, 5)
    ax.plot(centers, F, "-")
    ax.set_xlabel("Q"); ax.set_ylabel("F(Q)/kBT*")
    ax = fig.add_subplot(2, 3, 6)
    for t in range(K):
        ax.plot(ncp[t], label=f"T={TEMPS[t]:.3f}")
    ax.set_xlabel("native contact index"); ax.legend(fontsize=7)
    fig.tight_layout(); fig.savefig("visualization.png", dpi=150)

