 ']':[0x0E,0x02,0x02,0x02,0x02,0x02,0x0E],'<':[0x02,0x04,0x08,0x10,0x08,0x04,0x02],
 '>':[0x08,0x04,0x02,0x01,0x02,0x04,0x08],'^':[0x04,0x0A,0x11,0,0,0,0],
}
PAL = [(0,0,0),(204,0,0),(0,128,0),(0,0,204),(230,120,0),(128,0,204),(0,150,150)]

def _render_np(final_lowT, hist, centers, meanQ, fine_T, cv_fine, cv,
               F, ncp, T_star, T_used, jac, modes):
    import zlib, struct
    W, H = 1800, 1080
    img = np.full((H, W, 3), 255, np.uint8)

    def disk(cx, cy, r, col):
        x0, x1 = int(cx - r), int(cx + r) + 1
        y0, y1 = int(cy - r), int(cy + r) + 1
        for yy in range(max(0, y0), min(H, y1)):
            for xx in range(max(0, x0), min(W, x1)):
                if (xx - cx) ** 2 + (yy - cy) ** 2 <= r * r:
                    img[yy, xx] = col

    def line(p0, p1, col, w=1):
        x0, y0 = p0; x1, y1 = p1
        n = int(max(abs(x1 - x0), abs(y1 - y0))) + 1
        for k in range(n + 1):
            s = k / n
            disk(x0 + s * (x1 - x0), y0 + s * (y1 - y0), w, col)

    def rect(x, y, wd, ht, col):
        img[max(0,y):y+ht, max(0,x):x+wd] = col

    def text(x, y, s, col=(0, 0, 0), sc=2):
        for ch in s.upper():
            g = _G.get(ch, _G[' '])
            for r in range(7):
                for c in range(5):
                    if g[r] >> (4 - c) & 1:
                        rect(x + c * sc, y + r * sc, sc, sc, col)
            x += 6 * sc

    def panel(pi, title):
        col, row = pi % 3, pi // 3
        px0, py0 = 10 + col * 595, 10 + row * 535
        rect(px0, py0, 575, 515, (200, 200, 200))
        rect(px0 + 1, py0 + 1, 573, 513, (255, 255, 255))
        text(px0 + 12, py0 + 10, title, sc=2)
        return px0 + 65, py0 + 40, 480, 420     # plot-area origin and size

    def axes(px0, py0, pw, ph, xlim, ylim, xlab, ylab):
        rect(px0, py0, pw, ph, (255, 255, 255))
        line((px0, py0 + ph), (px0 + pw, py0 + ph), (0, 0, 0))       # x axis
        line((px0, py0), (px0, py0 + ph), (0, 0, 0))                 # y axis
        def mp(x, y):
            fx = (x - xlim[0]) / (xlim[1] - xlim[0])
            fy = (y - ylim[0]) / (ylim[1] - ylim[0])
            return px0 + fx * pw, py0 + ph - fy * ph
        for i in range(4):
            xt = xlim[0] + i * (xlim[1] - xlim[0]) / 3
            yt = ylim[0] + i * (ylim[1] - ylim[0]) / 3
            lx, _ = mp(xt, ylim[0]); _, ly = mp(xlim[0], yt)
            line((lx, py0 + ph), (lx, py0 + ph + 4), (0, 0, 0))
            line((px0 - 4, ly), (px0, ly), (0, 0, 0))
            text(int(lx) - 10, py0 + ph + 8, f"{xt:.2f}", sc=1)
            text(px0 - 34, int(ly) - 6, f"{yt:.2f}", sc=1)
        text(px0 + pw // 2 - 20, py0 + ph + 22, xlab, sc=2)
        for k, ch in enumerate(ylab):
            text(px0 - 56, py0 + ph // 2 - len(ylab) * 6 + k * 12, ch, sc=2)
        return mp

    # ---- panel 0: final configuration (lowest T) vs reference, 3D view ------
    px0, py0, pw, ph = panel(0, "FINAL CONFIG (LOWEST T) VS REF   JACCARD=%.3f" % jac)
    def proj(x):
        ca, sa, cb, sb = 0.8, 0.6, 0.9, 0.436          # fixed iso-like view
        u = x[0] * ca - x[1] * sa
        w = x[0] * sa + x[1] * ca
        return u, x[2] * cb - w * sb, w * cb + x[2] * sb
    P3 = np.array([proj(p) for p in final_lowT]); P3r = np.array([proj(p) for p in X_REF])
    allp = np.vstack([P3[:, :2], P3r[:, :2]])
    u0, u1 = allp[:, 0].min() - 1, allp[:, 0].max() + 1
    v0, v1 = allp[:, 1].min() - 1, allp[:, 1].max() + 1
    def mp3(p):
        return px0 + (p[0] - u0) / (u1 - u0) * pw, py0 + ph - (p[1] - v0) / (v1 - v0) * ph
    for a, b in zip(BI, BJ):                            # bonds of final config
        line(mp3(P3[a]), mp3(P3[b]), (204, 0, 0), 1)
    for p in P3r:
        disk(*mp3(p), 2, (150, 150, 150))
    for p in P3:
        disk(*mp3(p), 4, (204, 0, 0))
    text(px0 + 5, py0 + 30, "O REF  + FINAL(BONDS)", sc=1)

    # ---- panel 1: per-temperature Q histograms -------------------------------
    px0, py0, pw, ph = panel(1, "Q HISTOGRAMS PER TEMPERATURE")
    mp = axes(px0, py0, pw, ph, (0, 1), (0, float(hist.max() * 1.15 + 1e-6)),
              "Q", "P(Q)")
    for t in range(K):
        pts = [mp(c, h) for c, h in zip(centers, hist[t])]
        for a, b in zip(pts[:-1], pts[1:]):
            line(a, b, PAL[t + 1], 1)
    lx = px0 + pw - 120
    for t in range(K):
        rect(lx, py0 + 8 + t * 16, 14, 8, PAL[t + 1])
        text(lx + 20, py0 + 6 + t * 16, "T=%.3f" % TEMPS[t], sc=1)

    # ---- panel 2: <Q>(T) with T* midpoint ------------------------------------
    px0, py0, pw, ph = panel(2, "<Q> VS T   (T* FROM <Q>=0.5)")
    mp = axes(px0, py0, pw, ph, (TEMPS[0] * 0.98, TEMPS[-1] * 1.02), (0, 1), "T", "<Q>")
    pts = [mp(t, q) for t, q in zip(TEMPS, meanQ)]
    for a, b in zip(pts[:-1], pts[1:]):
        line(a, b, (0, 0, 204), 1)
    for p in pts:
        disk(*p, 3, (0, 0, 204))
    line(mp(TEMPS[0], 0.5), mp(TEMPS[-1], 0.5), (120, 120, 120), 1)
    tsx, _ = mp(T_star, 0.0); _, tsy = mp(T_star, 0.5)
    for yy in range(py0, py0 + ph, 6):
        img[yy, int(tsx)] = (204, 0, 0); img[yy, int(tsx) + 1] = (204, 0, 0)
    disk(tsx, tsy, 4, (204, 0, 0))
    text(px0 + 8, py0 + 8, "T*=%.4f" % T_star, sc=2, col=(204, 0, 0))

    # ---- panel 3: fluctuation heat capacity ----------------------------------
    px0, py0, pw, ph = panel(3, "HEAT CAPACITY  C = VAR(U)/T^2")
    ymax = float(max(cv_fine.max(), cv.max())) * 1.15 + 1e-6
    mp = axes(px0, py0, pw, ph, (fine_T[0], fine_T[-1]), (0, ymax), "T", "C")
    pts = [mp(t, c) for t, c in zip(fine_T, cv_fine)]
    for a, b in zip(pts[:-1], pts[1:]):
        line(a, b, (0, 128, 0), 1)
    for t, c in zip(TEMPS, cv):
        disk(*mp(t, c), 3, (0, 0, 0))
    tsx, _ = mp(T_star, 0.0)
    for yy in range(py0, py0 + ph, 6):
        img[yy, int(tsx)] = (204, 0, 0); img[yy, int(tsx) + 1] = (204, 0, 0)

    # ---- panel 4: free-energy profile at T* ----------------------------------
    px0, py0, pw, ph = panel(4, "FREE ENERGY F(Q) AT T*=%.4f" % T_star)
    mp = axes(px0, py0, pw, ph, (0, 1), (0, float(F.max() * 1.15 + 1e-6)), "Q", "F(KBT*)")
    pts = [mp(c, f) for c, f in zip(centers, F)]
    for a, b in zip(pts[:-1], pts[1:]):
        line(a, b, (128, 0, 204), 1)
    for m in modes:
        disk(*mp(m, float(F[np.argmin(np.abs(centers - m))])), 3, (204, 0, 0))

    # ---- panel 5: native contact probability ---------------------------------
    px0, py0, pw, ph = panel(5, "NATIVE CONTACT PROBABILITY (M=%d)" % M)
    mp = axes(px0, py0, pw, ph, (0, M - 1), (0, 1.02), "CONTACT INDEX", "P")
    for t in range(K):
        pts = [mp(j, p) for j, p in enumerate(ncp[t])]
        for a, b in zip(pts[:-1], pts[1:]):
            line(a, b, PAL[t + 1], 1)
    lx = px0 + pw - 120
    for t in range(K):
        rect(lx, py0 + 8 + t * 16, 14, 8, PAL[t + 1])
        text(lx + 20, py0 + 6 + t * 16, "T=%.3f" % TEMPS[t], sc=1)

    # ------------------------------------------------ PNG writer -------------
    raw = b"".join(b"\x00" + img[y].tobytes() for y in range(H))
    def chunk(tg, d):
        return (struct.pack(">I", len(d)) + tg + d
                + struct.pack(">I", zlib.crc32(tg + d) & 0xFFFFFFFF))
    png = (b"\x89PNG\r\n\x1a\n"
           + chunk(b"IHDR", struct.pack(">IIBBBBB", W, H, 8, 2, 0, 0, 0))
           + chunk(b"IDAT", zlib.compress(raw, 6))
           + chunk(b"IEND", b""))
    with open("visualization.png", "wb") as fh:
        fh.write(png)
    print("wrote visualization.png (%dx%d, numpy renderer)" % (W, H))

if __name__ == "__main__":
    main()
