#!/usr/bin/env python3
"""
Solution-phase electron-transfer response calculation.

Pipeline
--------
1. Read metadata, reorder every frame-specific array to ascending site_id
   (site-major Cartesian blocks: [x,y,z] per site).
2. Rigidly align frame B onto frame A (forward) and frame A onto frame B
   (backward) with a mass-weighted Kabsch superposition (proper rotation,
   det = +1, no reflection).
3. Mass-weighted Hessian diagonalisation per frame; retain the 15 resolved
   (positive-eigenvalue) modes, ordered by ascending eigenvalue.
4. Reorganisation energies:
     lambda_4pt_*  = 1/2 d^T H d           (four-point harmonic estimator,
                                            evaluated on the reference-frame
                                            potential surface)
     lambda_nm_*   = 1/2 sum_k eps_k c_k^2 (resolved-mode decomposition)
     lambda_inner_effective = mean(forward, backward)
     lambda_outer  = Marcus two-sphere nonequilibrium solvent term
     lambda_total  = inner_effective + outer
5. Marcus / Golden-Rule rates on the preserved driving-force grid
   (rows kept in file order) and the self-exchange rate (Delta G = 0).
6. Diagnostics + a six-panel overview.png.  matplotlib is not importable in
   this environment, so the figure is rendered with a self-contained numpy
   rasteriser and written as a valid 8-bit RGB PNG (zlib/struct only).

Conventions (fixed by the output contract and researcher sign-off)
------------------------------------------------------------------
* forward  compares frame B in frame A : align B -> A, displacement
  d_f = sqrt(m) * (B_aligned - A), expressed in frame A; evaluated on the
  frame-A surface (H_A).
* backward compares frame A in frame B : align A -> B, displacement
  d_b = sqrt(m) * (A_aligned - B), expressed in frame B; evaluated on the
  frame-B surface (H_B).
* Cross-frame overlaps / transported profiles are magnitude-based.
* dominant_mode_* = zero-based index of the retained mode with the largest
  lambda contribution.
* inverted-region scan: grid sorted by ascending axis_eV, scanned from the
  most negative end; a point is inverted when axis_eV < -lambda_total;
  first_inverted_* = first such point encountered in that scan.
"""

import csv
import json
import os
import math
import struct
import zlib

import numpy as np

DATA = "data"
OUT = "results"

HBAR_EV_S = 6.582119569e-16          # hbar [eV s]
KB_EV_K = 8.617333262e-5             # Boltzmann [eV/K]
COULOMB_EV_A = 14.399645             # e^2/(4 pi eps0) [eV A]
EIG_TOL = 1e-8                       # resolved-mode eigenvalue threshold


def read_csv_rows(path):
    with open(path, newline="") as fh:
        return list(csv.DictReader(fh))


def load_inputs():
    site_rows = read_csv_rows(f"{DATA}/site_table.csv")
    site_ids = [int(r["site_id"]) for r in site_rows]
    masses = {int(r["site_id"]): float(r["mass_amu"]) for r in site_rows}
    labels = {int(r["site_id"]): r["label_code"] for r in site_rows}

    order_rows = read_csv_rows(f"{DATA}/frame_site_order.csv")
    raw_to_site = {}
    for r in order_rows:
        raw_to_site.setdefault(r["frame_id"], {})[int(r["row_index"])] = (
            int(r["site_id"]), r["label_code"])

    for fid, mapping in raw_to_site.items():
        for idx, (sid, lab) in mapping.items():
            assert labels[sid] == lab, (fid, idx, sid, lab)

    coords, hess, site_perm = {}, {}, {}
    for fid in ("frame_a", "frame_b"):
        c_raw = np.load(f"{DATA}/{fid}_coords.npy")
        h_raw = np.load(f"{DATA}/{fid}_hessian.npy")
        mapping = raw_to_site[fid]
        perm = [mapping[idx][0] for idx in sorted(mapping)]
        p = [s * 3 + c for s in perm for c in range(3)]
        coords[fid] = c_raw[np.argsort(perm)]
        hess[fid] = h_raw[np.ix_(p, p)]
        site_perm[fid] = perm
        assert np.allclose(hess[fid], hess[fid].T, atol=1e-10)

    manifest = json.load(open(f"{DATA}/system_manifest.json"))
    medium = json.load(open(f"{DATA}/medium_response.json"))
    grid = [(int(r["grid_id"]), float(r["axis_eV"]))
            for r in read_csv_rows(f"{DATA}/driving_force_grid.csv")]
    return (site_ids, masses, labels, coords, hess, site_perm,
            manifest, medium, grid)


def kabsch(P, Q, w):
    """Rotation+translation (det=+1) minimising sum_i w_i |P_i R + t - Q_i|^2."""
    w = np.asarray(w, float)
    Pc = (P * w[:, None]).sum(0) / w.sum()
    Qc = (Q * w[:, None]).sum(0) / w.sum()
    A = (P - Pc).T @ ((Q - Qc) * w[:, None])
    U, _, Vt = np.linalg.svd(A)
    d = np.sign(np.linalg.det(Vt.T @ U.T))
    R = Vt.T @ np.diag([1.0, 1.0, d]) @ U.T
    t = Qc - Pc @ R
    fitted = P @ R + t
    rmsd = math.sqrt(((fitted - Q) ** 2).sum(1).mean())
    return R, t, rmsd


