        "Z": ["11111", "00001", "00010", "00100", "01000", "10000", "11111"],
        "0": ["01110", "10001", "10011", "10101", "11001", "10001", "01110"],
        "1": ["00100", "01100", "00100", "00100", "00100", "00100", "01110"],
        "2": ["01110", "10001", "00001", "00110", "01000", "10000", "11111"],
        "3": ["11110", "00001", "00001", "01110", "00001", "00001", "11110"],
        "4": ["00010", "00110", "01010", "10010", "11111", "00010", "00010"],
        "5": ["11111", "10000", "11110", "00001", "00001", "10001", "01110"],
        "6": ["00110", "01000", "10000", "11110", "10001", "10001", "01110"],
        "7": ["11111", "00001", "00010", "00100", "01000", "01000", "01000"],
        "8": ["01110", "10001", "10001", "01110", "10001", "10001", "01110"],
        "9": ["01110", "10001", "10001", "01111", "00001", "00010", "01100"],
        "-": ["00000", "00000", "00000", "01110", "00000", "00000", "00000"],
        ".": ["00000", "00000", "00000", "00000", "00000", "01100", "01100"],
        ":": ["00000", "01100", "01100", "00000", "01100", "01100", "00000"],
        "/": ["00001", "00010", "00010", "00100", "01000", "01000", "10000"],
        "(": ["00010", "00100", "01000", "01000", "01000", "00100", "00010"],
        ")": ["01000", "00100", "00010", "00010", "00010", "00100", "01000"],
        "=": ["00000", "00000", "11111", "00000", "11111", "00000", "00000"],
        " ": ["00000", "00000", "00000", "00000", "00000", "00000", "00000"],
    }

    def text(x, y, s, col=(0, 0, 0), sc=2):
        for ch in s.upper():
            g = GLYPH.get(ch, GLYPH[" "])
            for r, row in enumerate(g):
                for c, bit in enumerate(row):
                    if bit == "1":
                        rect(x + c * sc, y + r * sc, x + (c + 1) * sc, y + (r + 1) * sc, col)
            x += 6 * sc

    PALETTE = [(76, 114, 176), (221, 132, 82), (85, 168, 104), (196, 78, 82),
               (129, 114, 179), (147, 120, 96), (218, 139, 195), (140, 140, 140),
               (204, 185, 116)]
    SELCOL = (42, 157, 143)

    def q_title(x0, y0, t):
        text(x0 + 20, y0 + 8, t)

    text(20, 8, f"ANON CI-ENGINE AUDIT - SELECTED: {ENGINES[SEL]} "
                f"(SCORE {ENGINE_SCORE[SEL]:.3f} LABEL {pred_label[ENGINES[SEL]]})")

    # Q1: reliability bars
    x0, y0, w, h = 0, 40, W // 2, H // 2 - 40
    q_title(x0, y0, "COMBINED ENGINE RELIABILITY (HIGHER = BETTER)")
    bw = (w - 140) // NENG
    for k, e in enumerate(full_order):
        bh = int(ENGINE_SCORE[e] * (h - 130))
        xa = x0 + 70 + k * bw
        rect(xa, y0 + h - 50 - bh, xa + bw - 10, y0 + h - 50,
             SELCOL if e == SEL else (76, 114, 176))
        text(xa, y0 + h - 40, f"E{e:02d}", sc=1)
        text(xa - 4, y0 + h - 66 - bh, f"{ENGINE_SCORE[e]:.2f}", sc=1)
    text(x0 + 20, y0 + h - 18, f"SELECTED: {ENGINES[SEL]} SCORE {ENGINE_SCORE[SEL]:.3f}", sc=1)

    # Q2: per-case empirical coverage
    x0, y0, w, h = W // 2, 40, W // 2, H // 2 - 40
    q_title(x0, y0, "PER-CASE EMPIRICAL COVERAGE (108 CALIBRATION REPS)")
    px0, px1 = x0 + 80, x0 + w - 180
    ymin, ymax = 0.75, 0.96

    def xy(i, v, ybase=y0):
        return (int(px0 + i * (px1 - px0) / (NCASE - 1)),
                int(ybase + 70 + (ymax - v) / (ymax - ymin) * (h - 140)))

    yn = xy(0, NOM)[1]
    for xx in range(px0, px1, 8):
        rect(xx, yn, xx + 4, yn + 2, (196, 78, 82))
    text(px0 + 6, yn - 16, f"NOMINAL {NOM}", (196, 78, 82), 1)
    for i in range(NCASE):
        text(xy(i, ymin)[0] - 12, y0 + h - 34, f"C{i:02d}", sc=1)
    for e in range(NENG):
        col = SELCOL if e == SEL else PALETTE[e % len(PALETTE)]
        pts = [xy(i, emp[e, i]) for i in range(NCASE)]
        for a, b in zip(pts[:-1], pts[1:]):
            steps = max(abs(b[0] - a[0]), abs(b[1] - a[1]), 1)
            for t in range(steps + 1):
                px(int(a[0] + (b[0] - a[0]) * t / steps),
                   int(a[1] + (b[1] - a[1]) * t / steps), col, 2)
        for p in pts:
            rect(p[0] - 3, p[1] - 3, p[0] + 3, p[1] + 3, col)
        text(x0 + w - 150, y0 + 50 + 16 * (e % 9),
             f"E{e:02d} {emp[e].mean():.3f}", col, 1)

    # Q3: heatmap of mean normalized probe diagnostics
    x0, y0, w, h = 0, H // 2, W // 2, H // 2 - 30
    q_title(x0, y0, "MEAN NORMALIZED PROBE DIAGNOSTIC (SEVERITY 0-1)")
    heat = np.stack([dscore[f].mean(1) for f in PROBES], axis=1)
    cw, ch = (w - 220) // len(PROBES), (h - 120) // NENG
    for e in range(NENG):
        for fi in range(len(PROBES)):
            v = float(heat[e, fi])
            col = (int(68 + 187 * v), int(1 + 150 * (1 - v)), int(84 + 100 * (1 - v)))
            xa, ya = x0 + 170 + fi * cw, y0 + 60 + e * ch
            rect(xa, ya, xa + cw - 4, ya + ch - 4, col)
            text(xa + 6, ya + ch // 2 - 8, f"{v:.2f}", (255, 255, 255), 1)
        text(x0 + 100, y0 + 60 + e * ch + ch // 2 - 8, f"E{e:02d}", sc=1)
    for fi, f in enumerate(PROBES):
        text(x0 + 170 + fi * cw, y0 + h - 36, f"P{fi:02d}", sc=1)
    text(x0 + 20, y0 + h - 16, "P00 COV-ASYM P01 WIDTH P02 SCALE-RESP P03 SPLIT-NOISE P04 REFLECT", sc=1)

    # Q4: width ratio lines
    x0, y0, w, h = W // 2, H // 2, W // 2, H // 2 - 30
    q_title(x0, y0, "MEAN WIDTH / BASELINE WIDTH")
    px0, px1 = x0 + 80, x0 + w - 40
    ymin, ymax = 0.85, 1.15

    def xy2(i, v):
        return (int(px0 + i * (px1 - px0) / (NCASE - 1)),
                int(y0 + 70 + (ymax - v) / (ymax - ymin) * (h - 140)))

    yn = xy2(0, 1.0)[1]
    for xx in range(px0, px1, 8):
        rect(xx, yn, xx + 4, yn + 2, (196, 78, 82))
    text(px0 + 6, yn - 16, "BASELINE", (196, 78, 82), 1)
    for i in range(NCASE):
        text(xy2(i, ymin)[0] - 12, y0 + h - 34, f"C{i:02d}", sc=1)
    for e in range(NENG):
        col = SELCOL if e == SEL else PALETTE[e % len(PALETTE)]
        pts = [xy2(i, mwidth[e, i] / BASE_WIDTH[i]) for i in range(NCASE)]
        for a, b in zip(pts[:-1], pts[1:]):
            steps = max(abs(b[0] - a[0]), abs(b[1] - a[1]), 1)
            for t in range(steps + 1):
                px(int(a[0] + (b[0] - a[0]) * t / steps),
                   int(a[1] + (b[1] - a[1]) * t / steps), col, 2)
        for p in pts:
            rect(p[0] - 3, p[1] - 3, p[0] + 3, p[1] + 3, col)

    # encode PNG
    raw = b"".join(b"\x00" + img[r].tobytes() for r in range(H))

    def chunk(tag, data):
        c = struct.pack(">I", len(data)) + tag + data
        return c + struct.pack(">I", zlib.crc32(tag + data) & 0xFFFFFFFF)

    ihdr = struct.pack(">IIBBBBB", W, H, 8, 2, 0, 0, 0)
    png = (b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", ihdr)
           + chunk(b"IDAT", zlib.compress(raw, 6)) + chunk(b"IEND", b""))
    with open(os.path.join(OUT, "engine_overview.png"), "wb") as fh:
        fh.write(png)


