def nice_ticks(lo, hi, k=5):
    step = (hi - lo) / (k - 1)
    mag = 10 ** np.floor(np.log10(step))
    step = (round(step / mag) or 1) * mag
    t0 = np.ceil(lo / step) * step
    return list(np.arange(t0, hi + 1e-9, step))

