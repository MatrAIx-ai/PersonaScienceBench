"""
Deployment prediction sets under a label-weighted miss-risk target.

Task (asibench:computer_science.deployment_prediction_sets)
============================================================
Build prediction sets for the 5911 unlabeled deployment records so that the
label-weighted miss risk stays under target_risk = 0.1084 while the mean set
size stays far below the trivial all-label set (9 labels).

Method (approved by the researcher)
===================================
1.  Strata recovery (public, feature-only).  Features are standardized on the
    pooled calibration+deployment sample (public inputs only).  The projection
    mean(v000, v001, v002) separates a "hard" region from an "easy" region
    (calibration top-1 accuracy 0.419 vs 0.860) and is also the direction of
    the strongest calibration->deployment shift (KS ~0.15 on v000-v002).
    Strata are the calibration-median (or tertile) cells of this projection:
    s0 = hard, s1 = easy (s2 = middle when 3 strata are compared).

2.  Per-(stratum, label) conformal thresholds.  For each cell (s, l) with n
    calibration records of true label l, the threshold is the m-th smallest
    true-label score with m = ceil(alpha * (n + 1)) - 1 (lower order
    statistic).  Under exchangeability this gives the exact finite-sample
    guarantee  P(miss | s, true label = l) <= alpha.  A deployment record in
    stratum s receives every label l whose score >= threshold(s, l); the
    argmax label is always added so that sets are never empty (risk_spec
    forbids empty sets).

3.  Finite-sample risk control (RCPS style).  The record loss is
    L = c(true_label) * 1{true_label not in set}, bounded in [0, 1.65]
    (c_max = max label cost).  Per-stratum calibration means are combined
    with DEPLOYMENT stratum weights w_s^dep (this reweighting makes the
    estimate honest under the observed mix shift: only ~28% of deployment
    records fall in the easy stratum vs ~50% of calibration).  The upper
    confidence bound uses Hoeffding's inequality with a union bound over
    strata at level delta = 0.1366:
        UCB_s = r_hat_s + c_max * sqrt( ln(S / delta) / (2 n_s) )
        UCB_overall = sum_s w_s^dep * UCB_s
    alpha is selected on a grid as the one minimizing the deployment-projected
    mean set size subject to:
        UCB_overall <= 0.95 * target_risk  (extra conservative margin on the
        bound itself, per the researcher's instruction to stay away from the
        boundary rather than press against it),
        plug-in deployment risk <= 0.9 * target_risk  (conservative buffer),
        cross-fitted (2-fold, parity split) deployment risk <= target_risk,
        per-stratum risk <= target_risk.
    The cross-fitted check protects against the plug-in optimism of thresholds
    evaluated on the data that calibrated them.

RISK CONVENTIONS (per researcher instruction #1)
================================================
* PRIMARY convention (used for all decisions and for the main rows of every
  output file):  risk = E[ c(true_label) * 1{true_label not in prediction_set} ]
  ("label_weighted_miss" of data/risk_spec.json, cost-weighted, max 1.65).
* SECONDARY, reported as an annotation: cost-normalized risk
  = E[c(true)*1{miss}] / E[c(true)] (in [0,1]); written into
  results/constraint_audit.csv as extra rows with scope values
  'overall_cost_normalized' and 'proxy_stratum_cost_normalized'.

DEPLOYMENT LABELS ARE NEVER READ.  Any deployment "empirical_risk" value in
the output files is an ESTIMATE: the calibration within-stratum mean loss
re-weighted by the deployment stratum fractions.  This is noted here and in
the meta rows of results/calibration_diagnostics.csv; the constraint audit
records the final upper confidence bound next to the target.
"""

import json
import os

import numpy as np
import pandas as pd

# ----------------------------------------------------------------------------
# 0. Load inputs
# ----------------------------------------------------------------------------
with open("data/risk_spec.json") as f:
    SPEC = json.load(f)
with open("data/metadata.json") as f:
    META = json.load(f)

LABELS = META["label_columns"]
N_LABELS = len(LABELS)
COST = np.array([SPEC["label_costs"][l] for l in LABELS])
C_MAX = COST.max()
TARGET = SPEC["target_risk"]
DELTA = SPEC["delta"]
assert not SPEC["empty_prediction_sets_allowed"]

cal_feat = pd.read_csv("data/calibration_features.csv")
cal_lab = pd.read_csv("data/calibration_labels.csv")
cal_sco = pd.read_csv("data/calibration_scores.csv")
dep_feat = pd.read_csv("data/deployment_features.csv")
dep_sco = pd.read_csv("data/deployment_scores.csv")

for t in (cal_feat, cal_lab, cal_sco, dep_feat, dep_sco):
    assert t.isna().sum().sum() == 0
assert (cal_feat.record_id.values == cal_lab.record_id.values).all()
assert (cal_feat.record_id.values == cal_sco.record_id.values).all()
assert (dep_feat.record_id.values == dep_sco.record_id.values).all()

Sc = cal_sco[LABELS].values                      # calibration scores (n_cal, 9)
Sd = dep_sco[LABELS].values                      # deployment scores (n_dep, 9)
n_cal, n_dep = len(Sc), len(Sd)
y_idx = np.array([LABELS.index(v) for v in cal_lab.true_label.values])
assert set(cal_lab.true_label) <= set(LABELS)

# ----------------------------------------------------------------------------
# 1. Stratum recovery from public features
# ----------------------------------------------------------------------------
FEATS = META["feature_columns"]
F_all = np.vstack([cal_feat[FEATS].values, dep_feat[FEATS].values])
mu, sd = F_all.mean(0), F_all.std(0)
pc = (cal_feat[FEATS].values - mu) / sd
pd_ = (dep_feat[FEATS].values - mu) / sd
PROJ_COLS = [0, 1, 2]          # v000, v001, v002: most shifted / most informative
proj_c = pc[:, PROJ_COLS].mean(1)
proj_d = pd_[:, PROJ_COLS].mean(1)


def assign_strata(n_strata):
    if n_strata == 2:
        cuts = [float(np.median(proj_c))]
    else:  # 3
        cuts = [float(v) for v in np.quantile(proj_c, [1 / 3, 2 / 3])]
    return np.digitize(proj_c, cuts), np.digitize(proj_d, cuts), cuts


def dep_strata(n_strata):
    cuts = ([float(np.median(proj_c))] if n_strata == 2
            else [float(v) for v in np.quantile(proj_c, [1 / 3, 2 / 3])])
    return np.digitize(proj_c, cuts), np.digitize(proj_d, cuts)


def thresholds_for(alpha, scores, strata_c, y_idx_):
    """Per-(stratum,label) conformal lower order statistic; thr=-1 => all labels."""
    S = int(strata_c.max()) + 1
    thr = np.full((S, N_LABELS), -1.0)
    n_cell = np.zeros((S, N_LABELS), dtype=int)
    m_cell = np.zeros((S, N_LABELS), dtype=int)
    for s in range(S):
        for k in range(N_LABELS):
            v = np.sort(scores[(strata_c == s) & (y_idx_ == k), k])
            n_cell[s, k] = len(v)
            m = int(np.ceil(alpha * (len(v) + 1))) - 1
            m_cell[s, k] = m
            thr[s, k] = -1.0 if m < 1 else float(v[m - 1])
    return thr, n_cell, m_cell


def apply_policy(scores, strata, thr):
    """Set = {l : p_l >= thr[stratum,l]} union argmax (nonempty guarantee)."""
    sets = scores >= thr[strata]
    am = scores.argmax(1)
    sets[np.arange(len(scores)), am] = True
    return sets


def evaluate(alpha, strata_c, strata_d, thr):
    sets_c = apply_policy(Sc, strata_c, thr)
    miss_c = ~sets_c[np.arange(n_cal), y_idx]
    loss_c = COST[y_idx] * miss_c
    S = thr.shape[0]
    rs, ns, ucb_s = [], [], []
    for s in range(S):
        m = strata_c == s
        rs.append(float(loss_c[m].mean()))
        ns.append(int(m.sum()))
        ucb_s.append(rs[-1] + C_MAX * np.sqrt(np.log(S / DELTA) / (2 * ns[-1])))
    wc = np.array([(strata_c == s).mean() for s in range(S)])
    wd = np.array([(strata_d == s).mean() for s in range(S)])
    r_dep = float(wd @ np.array(rs))
    ucb = float(wd @ np.array(ucb_s))
    mean_cost_s = np.array([COST[y_idx][strata_c == s].mean() for s in range(S)])
    r_dep_norm = r_dep / float(wd @ mean_cost_s)
    sets_d = apply_policy(Sd, strata_d, thr)
    size_d = sets_d.sum(1)
    size_s = [float(size_d[strata_d == s].mean()) for s in range(S)]
    return dict(alpha=alpha, S=S, rs=rs, ns=ns, ucb_s=ucb_s, wc=wc, wd=wd,
                r_dep=r_dep, ucb=ucb, r_dep_norm=r_dep_norm,
                mean_cost_s=mean_cost_s, size_dep=float(size_d.mean()),
                size_s=size_s, thr=thr, n_cell=n_cell, m_cell=m_cell,
                sets_c=sets_c, sets_d=sets_d, size_d=size_d)


def cross_fitted(alpha, n_strata):
    """2-fold cross-fitted deployment risk estimate (parity split)."""
    fold = np.arange(n_cal) % 2
    losses = np.empty(n_cal)
    for a, b in ((0, 1), (1, 0)):
        st_a = np.digitize(proj_c[fold == a],
                           ([float(np.median(proj_c[fold == a]))] if n_strata == 2
                            else [float(v) for v in
                                  np.quantile(proj_c[fold == a], [1 / 3, 2 / 3])]))
        thr_a, _, _ = thresholds_for(alpha, Sc[fold == a], st_a, y_idx[fold == a])
        st_b = np.digitize(proj_c[fold == b],
                           ([float(np.median(proj_c[fold == a]))] if n_strata == 2
                            else [float(v) for v in
                                  np.quantile(proj_c[fold == a], [1 / 3, 2 / 3])]))
        sets_b = apply_policy(Sc[fold == b], st_b, thr_a)
        miss_b = ~sets_b[np.arange((fold == b).sum()), y_idx[fold == b]]
        losses[fold == b] = COST[y_idx[fold == b]] * miss_b
    st_cal, st_dep = dep_strata(n_strata)
    rs = [float(losses[st_cal == s].mean()) for s in range(n_strata)]
    wd = np.array([(st_dep == s).mean() for s in range(n_strata)])
    return float(wd @ np.array(rs)), rs


# ----------------------------------------------------------------------------
# 2. Model selection: strata count (2 vs 3) and alpha on a grid
# ----------------------------------------------------------------------------
grid = np.round(np.arange(0.01, 0.2001, 0.002), 4)
candidates = []
for n_strata in (2, 3):
    st_c, st_d, cuts = assign_strata(n_strata)
    for alpha in grid:
        thr, n_cell, m_cell = thresholds_for(alpha, Sc, st_c, y_idx)
        if (m_cell < 1).any():
            continue                      # cell too thin: would include all labels
        ev = evaluate(alpha, st_c, st_d, thr)
        r_cf, _ = cross_fitted(alpha, n_strata)
        ev.update(r_cf=r_cf, n_strata=n_strata, cuts=cuts,
                  feasible=(ev["ucb"] <= 0.95 * TARGET
                            and ev["r_dep"] <= 0.9 * TARGET
                            and r_cf <= TARGET
                            and max(ev["rs"]) <= TARGET))
        candidates.append(ev)

feas = [c for c in candidates if c["feasible"]]
assert feas, "no feasible (strata, alpha) combination"
best = sorted(feas, key=lambda c: (round(c["size_dep"], 6), c["alpha"]))[0]

ALPHA, N_STRATA = best["alpha"], best["n_strata"]
st_c, st_d, cuts = assign_strata(N_STRATA)
THR, N_CELL, M_CELL = thresholds_for(ALPHA, Sc, st_c, y_idx)
EV = evaluate(ALPHA, st_c, st_d, THR)
R_CF, RS_CF = cross_fitted(ALPHA, N_STRATA)
STRATA_IDS = [f"s{s}" for s in range(N_STRATA)]
print(f"selected: n_strata={N_STRATA} alpha={ALPHA} r_dep={EV['r_dep']:.4f} "
      f"ucb={EV['ucb']:.4f} r_cf={R_CF:.4f} size_dep={EV['size_dep']:.3f}")
print(f"feasible candidates: {len(feas)} / {len(candidates)}")


# ----------------------------------------------------------------------------
# 3. Write outputs
# ----------------------------------------------------------------------------
os.makedirs("results", exist_ok=True)

# --- prediction_sets.csv ---
sets_d = EV["sets_d"]
rows = []
for i in range(n_dep):
    labs = [LABELS[k] for k in range(N_LABELS) if sets_d[i, k]]
    assert labs, "empty prediction set (forbidden)"
    rows.append({"record_id": dep_sco.record_id.values[i],
                 "prediction_set": " ".join(labs)})
pd.DataFrame(rows).to_csv("results/prediction_sets.csv", index=False)

# --- set_size_summary.csv ---
pd.DataFrame({"record_id": dep_sco.record_id.values,
              "set_size": EV["size_d"].astype(int),
              "proxy_stratum": [STRATA_IDS[s] for s in st_d]}
             ).to_csv("results/set_size_summary.csv", index=False)

# --- policy_parameters.csv ---
pol = []
for s in range(N_STRATA):
    for k in range(N_LABELS):
        pol.append({"proxy_stratum": STRATA_IDS[s], "label": LABELS[k],
                    "n_calibration": EV["ns"][s],
                    "n_calibration_label": int(N_CELL[s, k]),
                    "threshold": float(THR[s, k]),
                    "group_empirical_weighted_miss_risk": float(EV["rs"][s]),
                    "group_upper_confidence_risk": float(EV["ucb_s"][s]),
                    "group_expected_set_size": float(EV["size_s"][s]),
                    "calibration_target_risk": float(ALPHA),
                    "target_risk": TARGET})
pd.DataFrame(pol).to_csv("results/policy_parameters.csv", index=False)

# --- distribution_diagnostics.csv ---
dist = []
for s in range(N_STRATA):
    fc, fd = float(EV["wc"][s]), float(EV["wd"][s])
    dist.append({"proxy_stratum": STRATA_IDS[s],
                 "calibration_fraction": fc, "deployment_fraction": fd,
                 "density_ratio_estimate": fd / max(fc, 1.0 / n_cal),
                 "absolute_fraction_shift": abs(fd - fc)})
pd.DataFrame(dist).to_csv("results/distribution_diagnostics.csv", index=False)

# --- calibration_diagnostics.csv (bins of the true-label score per stratum) ---
BIN_EDGES = np.array([0.0, 0.01, 0.02, 0.05, 0.10, 0.20, 0.40, 0.60, 0.80, 1.0 + 1e-9])
tl_scores = Sc[np.arange(n_cal), y_idx]
diag = []
for s in range(N_STRATA):
    v = tl_scores[st_c == s]
    b = np.digitize(v, BIN_EDGES[1:-1], right=False)
    for bi in range(len(BIN_EDGES) - 1):
        msk = b == bi
        if not msk.any():
            continue
        diag.append({"proxy_stratum": STRATA_IDS[s], "bin_id": f"b{bi}",
                     "score_left": float(BIN_EDGES[bi]),
                     "score_right": float(BIN_EDGES[bi + 1]),
                     "n_records": int(msk.sum()),
                     "mean_true_label_score": float(v[msk].mean())})
# meta rows: bound used, delta, selected alpha, selected statistic, key numbers
meta = [("bound_inequality", None, "hoeffding on losses in [0,1.65], union bound over strata"),
        ("delta", DELTA, "confidence level from risk_spec.json"),
        ("selected_alpha", ALPHA, "conformal per-cell miss level"),
        ("selected_statistic", None,
         "lower order statistic m=ceil(alpha*(n+1))-1 per (stratum,label)"),
        ("strata_cut_values", None, ";".join(f"{c:.6f}" for c in cuts)),
        ("cross_fitted_risk_estimate", R_CF, "2-fold parity split, deployment-reweighted"),
        ("plug_in_deployment_risk_estimate", EV["r_dep"], "primary convention"),
        ("overall_upper_confidence_bound", EV["ucb"], "hoeffding, delta=0.1366"),
        ("target_risk", TARGET, "from risk_spec.json")]
for name, val, note in meta:
    diag.append({"proxy_stratum": "__meta__", "bin_id": f"{name}={val if val is not None else note}",
                 "score_left": float(val) if isinstance(val, (int, float)) else np.nan,
                 "score_right": np.nan, "n_records": n_cal,
                 "mean_true_label_score": float(val) if isinstance(val, (int, float)) else np.nan})
pd.DataFrame(diag).to_csv("results/calibration_diagnostics.csv", index=False)

# --- audit_summary.csv ---
def p90(x):
    return float(np.percentile(x, 90))

aud = [{"scope": "overall", "stratum_id": "all", "n_records": n_dep,
        "empirical_risk": EV["r_dep"], "mean_set_size": EV["size_dep"],
        "p90_set_size": p90(EV["size_d"]), "target_risk": TARGET,
        "risk_violation": bool(EV["r_dep"] > TARGET)}]
for s in range(N_STRATA):
    md = st_d == s
    aud.append({"scope": "proxy_stratum", "stratum_id": STRATA_IDS[s],
                "n_records": int(md.sum()),
                "empirical_risk": float(EV["rs"][s]),
                "mean_set_size": float(EV["size_s"][s]),
                "p90_set_size": p90(EV["size_d"][md]),
                "target_risk": TARGET,
                "risk_violation": bool(EV["rs"][s] > TARGET)})
pd.DataFrame(aud).to_csv("results/audit_summary.csv", index=False)

# --- partition_diagnostics.csv ---
part = [{"scope": a["scope"], "stratum_id": a["stratum_id"],
         "n_records": a["n_records"], "empirical_risk": a["empirical_risk"],
         "mean_set_size": a["mean_set_size"], "p90_set_size": a["p90_set_size"],
         "target_risk": a["target_risk"],
         "risk_margin": a["target_risk"] - a["empirical_risk"]} for a in aud]
pd.DataFrame(part).to_csv("results/partition_diagnostics.csv", index=False)

# --- constraint_audit.csv ---
# primary rows: scope='overall' + scope='proxy_stratum' (cost-weighted convention)
# annotation rows (extra, clearly labeled): UCB vs target, cross-fitted estimate,
# and the cost-normalized secondary convention (both overall and per stratum).
con = []
for a in aud:
    con.append({"scope": a["scope"], "stratum_id": a["stratum_id"],
                "empirical_risk": a["empirical_risk"], "target_risk": a["target_risk"],
                "risk_violation": a["risk_violation"], "violates": a["risk_violation"]})
con.append({"scope": "overall_upper_confidence_bound", "stratum_id": "all",
            "empirical_risk": EV["ucb"], "target_risk": TARGET,
            "risk_violation": bool(EV["ucb"] > TARGET), "violates": bool(EV["ucb"] > TARGET)})
con.append({"scope": "overall_cross_fitted_estimate", "stratum_id": "all",
            "empirical_risk": R_CF, "target_risk": TARGET,
            "risk_violation": bool(R_CF > TARGET), "violates": bool(R_CF > TARGET)})
con.append({"scope": "overall_cost_normalized", "stratum_id": "all",
            "empirical_risk": EV["r_dep_norm"], "target_risk": TARGET,
            "risk_violation": bool(EV["r_dep_norm"] > TARGET),
            "violates": bool(EV["r_dep_norm"] > TARGET)})
for s in range(N_STRATA):
    rn = EV["rs"][s] / EV["mean_cost_s"][s]
    con.append({"scope": "proxy_stratum_cost_normalized", "stratum_id": STRATA_IDS[s],
                "empirical_risk": float(rn), "target_risk": TARGET,
                "risk_violation": bool(rn > TARGET), "violates": bool(rn > TARGET)})
pd.DataFrame(con).to_csv("results/constraint_audit.csv", index=False)

