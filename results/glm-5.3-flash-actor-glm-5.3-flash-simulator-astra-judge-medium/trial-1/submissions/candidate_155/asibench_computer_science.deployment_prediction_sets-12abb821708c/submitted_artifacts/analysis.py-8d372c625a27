def write_png(path, arr):
    h, w, _ = arr.shape
    raw = b''.join(b'\x00' + arr[y].tobytes() for y in range(h))

    def chunk(tag, data):
        return (struct.pack('>I', len(data)) + tag + data
                + struct.pack('>I', zlib.crc32(tag + data) & 0xFFFFFFFF))
    png = (b'\x89PNG\r\n\x1a\n'
           + chunk(b'IHDR', struct.pack('>IIBBBBB', w, h, 8, 2, 0, 0, 0))
           + chunk(b'IDAT', zlib.compress(raw, 9))
           + chunk(b'IEND', b''))
    with open(path, 'wb') as f:
        f.write(png)


class Canvas:
    def __init__(self, w, h, bg=(255, 255, 255)):
        self.w, self.h = w, h
        self.a = np.zeros((h, w, 3), dtype=np.uint8)
        self.a[:] = bg

    def px(self, x, y, c):
        if 0 <= x < self.w and 0 <= y < self.h:
            self.a[y, x] = c

    def rect(self, x0, y0, x1, y1, c):
        for yy in range(max(0, y0), min(self.h, y1 + 1)):
            self.a[yy, max(0, x0):min(self.w, x1 + 1)] = c

    def line(self, x0, y0, x1, y1, c, t=1):
        x0, y0, x1, y1 = int(x0), int(y0), int(x1), int(y1)
        n = int(max(abs(x1 - x0), abs(y1 - y0), 1))
        for i in range(n + 1):
            x = int(round(x0 + (x1 - x0) * i / n))
            y = int(round(y0 + (y1 - y0) * i / n))
            for dx in range(-(t // 2), t // 2 + 1):
                for dy in range(-(t // 2), t // 2 + 1):
                    self.px(x + dx, y + dy, c)

    def text(self, x, y, s, c=(0, 0, 0), scale=1):
        cx = x
        for ch in s.upper():
            g = GLYPHS.get(ch, GLYPHS[' '])
            for r, row in enumerate(g):
                for col, v in enumerate(row):
                    if v == 'X':
                        for dx in range(scale):
                            for dy in range(scale):
                                self.px(cx + col * scale + dx,
                                        y + r * scale + dy, c)
            cx += 6 * scale


class Axes:
    """One plot region with data mapping, frame, ticks and numeric labels."""

    def __init__(self, cv, x0, y0, x1, y1, xlim, ylim, xticks, yticks,
                 xfmt='{:.2f}', yfmt='{:.2f}', xlabel=None, ylabel=None,
                 title=None):
        self.cv, self.box = cv, (x0, y0, x1, y1)
        self.xlim, self.ylim = xlim, ylim

        def mx(v):
            return x0 + (v - xlim[0]) / (xlim[1] - xlim[0]) * (x1 - x0)

        def my(v):
            return y1 - (v - ylim[0]) / (ylim[1] - ylim[0]) * (y1 - y0)
        self.mx, self.my = mx, my
        cv.rect(x0, y0, x1, y1, (255, 255, 255))
        for e, w in (((x0, y0, x1, y0), 1), ((x1, y0, x1, y1), 1),
                     ((x0, y1, x1, y1), 1), ((x0, y0, x0, y1), 1)):
            cv.line(*e, (60, 60, 60), w)
        for t in xticks:
            X = int(round(mx(t)))
            cv.line(X, y1, X, y1 + 4, (60, 60, 60))
            s = xfmt.format(t)
            cv.text(X - 3 * len(s), y1 + 7, s, scale=1)
        for t in yticks:
            Y = int(round(my(t)))
            cv.line(x0 - 4, Y, x0, Y, (60, 60, 60))
            s = yfmt.format(t)
            cv.text(x0 - 8 - 6 * len(s), Y - 3, s, scale=1)
        if xlabel:
            cv.text((x0 + x1) // 2 - 3 * len(xlabel), y1 + 20, xlabel, scale=1)
        if ylabel:
            for i, ch in enumerate(ylabel):
                cv.text(x0 - 46, (y0 + y1) // 2 - 3 * len(ylabel) + 6 * i, ch, scale=1)
        if title:
            cv.text((x0 + x1) // 2 - 3 * len(title), max(0, y0 - 18), title, scale=1)

    def polyline(self, xs, ys, c, t=1):
        pts = [(self.mx(v), self.my(u)) for v, u in zip(xs, ys) if
               self.xlim[0] <= v <= self.xlim[1] and self.ylim[0] <= u <= self.ylim[1]]
        for (ax, ay), (bx, by) in zip(pts[:-1], pts[1:]):
            self.cv.line(ax, ay, bx, by, c, t)

    def hline(self, v, c, t=1):
        self.cv.line(self.box[0], int(round(self.my(v))), self.box[2],
                     int(round(self.my(v))), c, t)

    def vline(self, v, c, t=1):
        self.cv.line(int(round(self.mx(v))), self.box[1], int(round(self.mx(v))),
                     self.box[3], c, t)

    def marker(self, xv, yv, c, r=4):
        X, Y = self.mx(xv), self.my(yv)
        for dx in range(-r, r + 1):
            for dy in range(-r, r + 1):
                if dx * dx + dy * dy <= r * r:
                    self.cv.px(int(X + dx), int(Y + dy), c)

    def bars(self, cats, vals, c, bw_frac=.5, baseline=0):
        n = len(cats)
        span = (self.box[2] - self.box[0]) / n
        for i, v in enumerate(vals):
            cx = self.box[0] + span * (i + .5)
            wq = span * bw_frac / 2
            Y = self.my(max(v, baseline))
            Y0 = self.my(baseline)
            self.cv.rect(int(cx - wq), int(min(Y, Y0)), int(cx + wq),
                         int(max(Y, Y0)), c)
            self.cv.text(int(cx - 6), int(self.box[3]) + 8, cats[i], scale=1)

    def hist(self, values, edges, c):
        counts, _ = np.histogram(values, bins=edges)
        mxv = counts.max() if counts.max() else 1
        pts = [(edges[0], 0)]
        for i, ct in enumerate(counts):
            pts += [(edges[i], ct / mxv), (edges[i + 1], ct / mxv)]
        pts += [(edges[-1], 0)]
        self.polyline([p[0] for p in pts], [p[1] for p in pts], c, t=1)

    def legend(self, x, y, items, scale=1):
        for i, (c, s) in enumerate(items):
            yy = y + i * 10 * scale
            self.cv.rect(x, yy, x + 5 * scale, yy + 5 * scale, c)
            self.cv.text(x + 8 * scale, yy, s, scale=scale)

