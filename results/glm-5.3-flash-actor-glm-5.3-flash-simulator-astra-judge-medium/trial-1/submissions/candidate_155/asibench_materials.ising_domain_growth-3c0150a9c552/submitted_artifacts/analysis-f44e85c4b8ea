#!/usr/bin/env python3
"""
B3: Hidden Binary-Grid Time Evolution
=====================================

Inferred model (see notes in metadataA/metadataB):
  2D nearest-neighbour Ising model, H = -J sum_<ij> s_i s_j, J = k_B = 1,
  periodic boundaries, stochastic single-spin-flip (nonconserved) Metropolis
  dynamics at temperature T = control (units of J/k_B).

  Evidence: initial_state.npy is an uncorrelated +-1 int8 lattice (random
  high-temperature start); control = 2.0236 lies just below the exact 2D
  Ising critical temperature 2/ln(1+sqrt2) = 2.269185..., i.e. a quench
  slightly below Tc producing slow domain coarsening over the simulated
  range; log-distributed measurement times (3.4 decades), geometric snapshot
  times, max_r = grid_size/2 and dynamics_seed all match a coarsening
  scaling Monte Carlo experiment.

Time unit: 1 step = 1 Monte Carlo sweep = N = grid_size**2 single-spin
update attempts, implemented as two vectorised checkerboard half-sweeps
(even sublattice then odd sublattice, fresh random numbers each half-sweep).
A measurement at time t is taken immediately after sweep int(t) completes.

Dynamics seed: numpy.random.default_rng(dynamics_seed).

Only numpy (plus the Python standard library for the PNG writer) is used;
no network access and no package installation.  matplotlib is not installed
in this environment, so figure.png is rasterised directly from arrays.
"""

import json
import time as _time
import numpy as np

# ----------------------------------------------------------------------------
# Inputs
# ----------------------------------------------------------------------------
with open("data/parameters.json") as fh:
    P = json.load(fh)

grid_size         = int(P["grid_size"])
control           = float(P["control"])
n_steps           = int(P["n_steps"])
n_snapshots       = int(P["n_snapshots"])
n_measurements    = int(P["n_measurements"])
snapshot_times    = [float(x) for x in P["snapshot_times"]]
measurement_times = [float(x) for x in P["measurement_times"]]
max_r             = int(P["max_r"])
dynamics_seed     = int(P["dynamics_seed"])

state0 = np.load("data/initial_state.npy")
assert state0.shape == (grid_size, grid_size)

T = control                       # temperature in units of J/k_B (assumption)
inv_T = 1.0 / T
N = grid_size * grid_size
TOTAL_BONDS = 2 * N               # periodic square lattice

# ----------------------------------------------------------------------------
# Dynamics: vectorised checkerboard Metropolis single-spin flips
# ----------------------------------------------------------------------------
rng = np.random.default_rng(dynamics_seed)
ii, jj = np.indices((grid_size, grid_size))
mask_even = ((ii + jj) % 2 == 0)
mask_odd  = ~mask_even


def sweep(state):
    """One MC sweep: N update attempts as two checkerboard half-sweeps."""
    for mask in (mask_even, mask_odd):
        nb = (np.roll(state, 1, 0) + np.roll(state, -1, 0) +
              np.roll(state, 1, 1) + np.roll(state, -1, 1))
        dE = 2.0 * state * nb                        # energy change on flip
        p_acc = np.exp(np.minimum(-dE * inv_T, 0.0)) # Metropolis min(1, e^{-dE/T})
        flip = mask & (rng.random(state.shape) < p_acc)
        state[flip] = -state[flip]
    return state


# ----------------------------------------------------------------------------
# Observables
# ----------------------------------------------------------------------------
# Periodic autocorrelation via FFT: ac[dx, dy] = <s(x,y) s(x+dx, y+dy)>_x,y
dx = np.arange(grid_size)
DX, DY = np.meshgrid(dx, dx, indexing="ij")
dxp = np.where(DX <= grid_size // 2, DX, DX - grid_size)
dyp = np.where(DY <= grid_size // 2, DY, DY - grid_size)
radius = np.sqrt(dxp ** 2 + dyp ** 2)
# angular shells: integer separation r holds all displacements with Euclidean
# length in [r-0.5, r+0.5); r = 0 is the (0,0) bin only.
shell_masks = [(radius < 0.5) if r == 0
               else ((radius >= r - 0.5) & (radius < r + 0.5))
               for r in range(max_r)]


def autocorr(state):
    s = state.astype(np.float64)
    F = np.fft.rfft2(s)
    return np.fft.irfft2(F * np.conj(F), s.shape) / N


def angular_C(ac):
    """Angularly averaged correlation C(r), r = 0..max_r-1."""
    return np.array([ac[m].mean() for m in shell_masks])


def length_from_C(C, max_scan=max_r - 1):
    """
    Characteristic domain length L(t) = decay length of the angularly averaged
    correlation C(r,t): first crossing of C(r) below 1/e (linear interpolation
    between the surrounding bins).  Chosen over the first zero crossing after
    an explicit robustness comparison on this run: C(r) is very flat near zero
    at late times, so the zero-crossing position jumps erratically (e.g. it is
    undefined for t > 177 and hops between widely separated values), while the
    1/e crossing is smooth, monotone on average and defined up to t = 331.
    If C(r) stays above 1/e out to r = max_r the length is 'censored'
    (L >= max_r); the recorded value is max_r and it is excluded from fits.
    Returns (L, censored, method).
    """
    one_over_e = np.exp(-1.0)
    for i in range(1, max_scan + 1):
        if C[i] < one_over_e <= C[i - 1]:
            den = C[i - 1] - C[i]
            frac = 0.5 if den == 0.0 else (C[i - 1] - one_over_e) / den
            return (i - 1) + frac, False, "1/e decay crossing"
    return float(max_r), True, "censored: C(r) > 1/e out to r = max_r"


def observables(state):
    m = float(state.mean())
    dis = int(np.sum(state != np.roll(state, 1, 0)) +
              np.sum(state != np.roll(state, 1, 1)))
    rho = dis / TOTAL_BONDS           # interface (unsatisfied-bond) density
    e = -2.0 + 4.0 * rho              # energy per site, J = 1
    return m, e, rho

# ----------------------------------------------------------------------------
# Main run
# ----------------------------------------------------------------------------
meas_index = {int(t): k for k, t in enumerate(measurement_times)}
snap_index = {int(t): k for k, t in enumerate(snapshot_times)}
# NOTE: snapshot time 2965 is not in measurement_times; snapshots are handled
# independently (same estimator), measurement arrays keep n_measurements columns.

seriesA = np.full((2, n_measurements), np.nan)   # [m(t), e(t)]
seriesB = np.full((2, n_measurements), np.nan)   # [L(t), rho(t)]
L_censored = np.zeros(n_measurements, dtype=bool)
L_method = [""] * n_measurements
snap_states, snap_C, snap_profiles, snap_dirC = {}, {}, {}, {}
snap_L, snap_cens, snap_meth = {}, {}, {}

state = state0.astype(np.int8).copy()

t0 = _time.time()
for s in range(1, n_steps + 1):
    state = sweep(state)
    is_meas = s in meas_index
    is_snap = s in snap_index
    if is_meas or is_snap:
        ac = autocorr(state)
        C = angular_C(ac)
        Lv, cens, meth = length_from_C(C)
        if is_meas:
            k = meas_index[s]
            m, e, rho = observables(state)
            seriesA[0, k] = m
            seriesA[1, k] = e
            seriesB[0, k] = Lv
            seriesB[1, k] = rho
            L_censored[k] = cens
            L_method[k] = meth
        if is_snap:
            j = snap_index[s]
            snap_states[j] = state.copy()
            snap_C[j] = C
            snap_L[j] = Lv
            snap_cens[j] = cens
            snap_meth[j] = meth
            snap_profiles[j] = state.mean(axis=0).astype(np.float64)  # m(x): mean over y
            snap_dirC[j] = np.stack([ac[:, 0], ac[0, :]])              # [C_x(r), C_y(r)]
    if s % 2000 == 0:
        print(f"  sweep {s}/{n_steps}  ({_time.time()-t0:.1f} s)", flush=True)

print(f"dynamics finished in {_time.time()-t0:.1f} s")

assert np.all(np.isfinite(seriesA)) and np.all(np.isfinite(seriesB)), \
    "all series values must be finite"

stackC = np.stack([snap_C[j] for j in range(n_snapshots)])            # [6, max_r]
stackD = np.stack([snap_profiles[j] for j in range(n_snapshots)])     # [6, grid_size]
stackE = np.stack([snap_dirC[j] for j in range(n_snapshots)])         # [6, 2, grid_size]

t_meas = np.array(measurement_times)
t_snap = np.array(snapshot_times)
L_snap = np.array([snap_L[j] for j in range(n_snapshots)])
cens_snap = np.array([bool(snap_cens[j]) for j in range(n_snapshots)])

# ----------------------------------------------------------------------------
# metadataA: dynamical scaling collapse  C(r,t) = f(r / L(t))
# ----------------------------------------------------------------------------
# Applicability rule (as approved):
#   (i)   well-defined L for the considered snapshots (not censored, L >= 2),
#   (ii)  snapshot lengths span >= a factor 3,
#   (iii) a common x = r/L window of width >= 0.5 exists;
#   snapshots with finite-size-saturated lengths (censored or L > 0.75*grid)
#   are excluded from the collapse and reported in notes (never forced in).
SAT_LIMIT = 0.75 * grid_size
excluded = [int(t) for t, Lv, c in zip(t_snap, L_snap, cens_snap)
            if c or Lv > SAT_LIMIT]
kept = [j for j in range(n_snapshots)
        if int(t_snap[j]) not in excluded and (not cens_snap[j]) and L_snap[j] >= 2.0]

notes_A = [
    "Model: 2D nearest-neighbour Ising, H = -J sum s_i s_j, J = k_B = 1, periodic "
    "boundaries, single-spin-flip Metropolis dynamics; T = control = 2.0236 "
    "(units J/k_B), just below the exact 2D Ising Tc = 2/ln(1+sqrt2) = 2.2692.",
    "Alternative interpretation control = beta = J/(k_B T) (T = 0.494, deep quench) "
    "considered and rejected: the value just below Tc and the O(10^4)-sweep sampling "
    "window favour the temperature reading.",
    "Time unit: 1 step = 1 MC sweep = N = 10000 update attempts, implemented as two "
    "vectorised checkerboard half-sweeps (even then odd sublattice, fresh random "
    "numbers per half-sweep); measurements taken immediately after sweep int(t).",
    "RNG: numpy.random.default_rng(dynamics_seed = 1802725656).",
    "Length estimator (used consistently for seriesB, the collapse and the power-law "
    "fit): L(t) = decay length of the angularly averaged correlation C(r,t), i.e. the "
    "first crossing of C(r) below 1/e (linearly interpolated between bins); if C(r) "
    "stays above 1/e out to r = max_r the length is censored (L >= max_r) and excluded "
    "from fits and collapse.  The first zero crossing was tested first and discarded: "
    "C(r) is flat near zero at late times, so the zero-crossing estimator is erratic "
    "(undefined for t > 177 in this run) while the 1/e length is smooth and monotone "
    "on average up to t = 331.",
    "Scaling form tested: C(r,t) = f(r/L(t)) with x = r/L; collapse_dimension d = 2.",
]

collapse_quality = None
collapse_rms = None
collapse_times = []
collapse_lengths = []
collapse_x = [0.0, 0.0]
collapse_grid = 0
curves = None
xs = None

if len(kept) >= 3:
    L_kept = np.array([L_snap[j] for j in kept])
    span = float(L_kept.max() / L_kept.min())
    x_maxima = np.array([(max_r - 1) / L_snap[j] for j in kept])
    x_lo, x_hi = 0.3, min(2.5, 0.9 * x_maxima.min())
    if span >= 3.0 and (x_hi - x_lo) >= 0.5:
        xs = np.linspace(x_lo, x_hi, 100)
        curves = np.array([np.interp(xs, np.arange(max_r) / L_snap[j], snap_C[j])
                           for j in kept])
        mean_curve = curves.mean(axis=0)
        std_curve = curves.std(axis=0, ddof=1)
        rms_mean = float(np.sqrt((mean_curve ** 2).mean()))
        rms_spread = float(np.sqrt((std_curve ** 2).mean()))
        collapse_rms = rms_spread / rms_mean
        collapse_quality = float(np.clip(1.0 - collapse_rms, 0.0, 1.0))
        collapse_times = [float(t_snap[j]) for j in kept]
        collapse_lengths = [float(L_snap[j]) for j in kept]
        collapse_x = [float(x_lo), float(x_hi)]
        collapse_grid = grid_size
        notes_A.append(
            f"Collapse performed on {len(kept)} snapshots (times {collapse_times}) "
            f"with L = {[round(v, 2) for v in collapse_lengths]}; length span = "
            f"{span:.1f}; x window [{x_lo}, {x_hi:.2f}].")
        if excluded:
            notes_A.append(
                f"Snapshots at times {excluded} excluded from the collapse: length "
                f"censored or L > 0.75*grid_size = {SAT_LIMIT:.0f} (finite-size "
                "saturation); they are NOT forced into the collapse.")
        notes_A.append(
            f"collapse_quality = 1 - RMS inter-snapshot spread / RMS of mean curve "
            f"= {collapse_quality:.3f}; collapse_relative_rms_spread = {collapse_rms:.3f}.")
    else:
        notes_A.append(
            f"Collapse not applicable: length span {span:.2f} < 3 or common x window "
            f"([{x_lo:.2f}, {x_hi:.2f}]) too narrow; schema nulls/0 applied.")
else:
    notes_A.append(
        "Collapse not applicable: fewer than 3 snapshots with well-defined, "
        "non-saturated lengths; schema nulls/0 applied.")
    if excluded:
        notes_A.append(
            f"Snapshots at times {excluded} have censored or saturated lengths "
            f"(L > {SAT_LIMIT:.0f}) and were excluded.")

metadataA = {
    "collapse_check_applicable": bool(collapse_quality is not None),
    "collapse_quality": collapse_quality,
    "collapse_relative_rms_spread": collapse_rms,
    "collapse_dimension": 2,
    "collapse_snapshot_times": collapse_times,
    "collapse_lengths": collapse_lengths,
    "collapse_x_range": collapse_x,
    "collapse_grid_size": collapse_grid,
    "notes": notes_A,
}

# ----------------------------------------------------------------------------
# metadataB: power-law growth fit  L(t) = A * t^alpha
# ----------------------------------------------------------------------------
# Fit-range selection (documented, deterministic):
#   valid points = measurement times with non-censored L, L >= 2 (length
#                  well defined) and L <= 0.35 * grid_size (finite-size
#                  effects / approach to the saturated state excluded);
#   noise reduction = single coarsening events make pointwise L(t) jumpy, so
#                  points are binned into equal-width bins of log10(t)
#                  (12 bins/decade) and the bin median of log L is used;
#                  bins with < 2 points are dropped;
#   fit         = ordinary least squares on (log t_bin, log L_bin).
#   fit_range   = [t_min, t_max] of the underlying points entering the bins.
valid = (~L_censored) & np.isfinite(seriesB[0])
L_CEIL = 0.35 * grid_size
cand = np.where(valid & (seriesB[0] >= 2.0) & (seriesB[0] <= L_CEIL) &
                (t_meas >= 2))[0]
notes_B = [
    "Power-law model L(t) = A * t^alpha fitted by ordinary least squares on "
    "(log t, log L) over the reported fit_range.",
    "Same L(t) estimator as seriesB/collapse: 1/e decay crossing of the "
    "angularly averaged C(r,t) (interpolated); censored points (C(r) > 1/e out "
    "to r = max_r) excluded.",
    "Expected for 2D nonconserved (scalar order parameter) coarsening: alpha = 1/2.",
]
exponent = exponent_se = amplitude = r2 = float("nan")
fit_range = [float("nan"), float("nan")]
if len(cand) >= 5:
    lt = np.log10(t_meas[cand])
    lL = np.log10(seriesB[0][cand])
    width = 1.0 / 12.0
    edges = np.arange(np.floor(lt.min() / width) * width,
                      np.ceil(lt.max() / width) * width + 1e-9, width)
    bt, bL, bcount = [], [], []
    for a, b in zip(edges[:-1], edges[1:]):
        s = (lt >= a) & (lt < b)
        if s.sum() >= 2:
            bt.append(float(np.median(lt[s])))
            bL.append(float(np.median(lL[s])))
            bcount.append(int(s.sum()))
    if len(bt) >= 5:
        bt, bL = np.array(bt), np.array(bL)
        slope, intercept = np.polyfit(bt, bL, 1)
        pred = slope * bt + intercept
        ss_res = float(((bL - pred) ** 2).sum())
        ss_tot = float(((bL - bL.mean()) ** 2).sum())
        r2 = 1.0 - ss_res / ss_tot
        n_fit = len(bt)
        exponent_se = float(np.sqrt(ss_res / (n_fit - 2) /
                                    ((bt - bt.mean()) ** 2).sum()))
        exponent = float(slope)
        amplitude = float(np.exp(intercept))
        fit_range = [float(t_meas[cand].min()), float(t_meas[cand].max())]
        notes_B.append(
            f"fit_range = [{fit_range[0]:.0f}, {fit_range[1]:.0f}] selected as follows: "
            f"points require non-censored L >= 2 and L <= 0.35*grid_size = {L_CEIL:.0f} "
            "(finite-size saturation and the late approach to the ordered state "
            "excluded; censoring starts at t = 345 in this run).  Pointwise L(t) is "
            "jumpy because coarsening is a discrete succession of annihilation events, "
            "so the fit uses medians of log L in equal-width log10(t) bins "
            f"(12 bins/decade; {n_fit} bins, >= 2 points each, "
            f"{int(np.sum(bcount))} points in total).")
        notes_B.append(
            f"Result: alpha = {exponent:.4f} +- {exponent_se:.4f} (std error), "
            f"A = {amplitude:.4f}, R^2 = {r2:.5f};  consistent with the 1/2 growth "
            "law of 2D nonconserved coarsening.")
    else:
        notes_B.append("Fewer than 5 populated log-time bins: no valid fit (NaN).")
else:
    notes_B.append("Fewer than 5 usable points: no valid power-law fit (NaN reported).")

metadataB = {
    "exponent": exponent,
    "exponent_std_error": exponent_se,
    "amplitude": amplitude,
    "fit_range": fit_range,
    "r_squared": r2,
    "notes": notes_B,
}

