FIG_W, FIG_H = 1680, 1280
img = np.full((FIG_H, FIG_W, 3), 255, np.uint8)


def _px(x, y, c):
    if 0 <= x < FIG_W and 0 <= y < FIG_H:
        img[y, x] = c


def fill_rect(x0, y0, w, h, c):
    x0, y0 = max(0, int(x0)), max(0, int(y0))
    x1, y1 = min(FIG_W, int(x0) + int(w)), min(FIG_H, int(y0) + int(h))
    if x1 > x0 and y1 > y0:
        img[y0:y1, x0:x1] = c


def draw_line(x0, y0, x1, y1, c):
    x0, y0, x1, y1 = int(round(x0)), int(round(y0)), int(round(x1)), int(round(y1))
    dx, dy = abs(x1 - x0), abs(y1 - y0)
    sx = 1 if x0 < x1 else -1
    sy = 1 if y0 < y1 else -1
    err = dx - dy
    while True:
        _px(x0, y0, c)
        if x0 == x1 and y0 == y1:
            break
        e2 = 2 * err
        if e2 > -dy:
            err -= dy; x0 += sx
        if e2 < dx:
            err += dx; y0 += sy


def draw_rect(x0, y0, w, h, c):
    draw_line(x0, y0, x0 + w, y0, c)
    draw_line(x0, y0 + h, x0 + w, y0 + h, c)
    draw_line(x0, y0, x0, y0 + h, c)
    draw_line(x0 + w, y0, x0 + w, y0 + h, c)


