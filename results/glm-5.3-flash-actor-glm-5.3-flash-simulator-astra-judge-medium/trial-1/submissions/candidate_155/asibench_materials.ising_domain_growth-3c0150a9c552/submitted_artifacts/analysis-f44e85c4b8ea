            for gx, b in enumerate(row):
                if b == "1":
                    fill_rect(cx + gx * scale, int(y) + gy * scale, scale, scale, color)
        cx += 6 * scale


def text_w(text, scale=1):
    return 6 * scale * len(str(text))


def _fmt(v):
    return f"{v:g}"


class Panel:
    def __init__(self, x0, y0, w, h, title=""):
        self.x0, self.y0, self.w, self.h = int(x0), int(y0), int(w), int(h)
        draw_rect(x0, y0, w, h, BLACK)
        if title:
            draw_text(x0 + 2, y0 - 14, title, 1, BLACK)

    def set_ranges(self, rx, ry):
        self.rx, self.ry = rx, ry

    def tx(self, u):
        return self.x0 + 2 + (self.w - 4) * (u - self.rx[0]) / (self.rx[1] - self.rx[0])

    def ty(self, v):
        return self.y0 + self.h - 2 - (self.h - 4) * (v - self.ry[0]) / (self.ry[1] - self.ry[0])

    def plot(self, x, y, color, dash=0):
        x = np.asarray(x, float); y = np.asarray(y, float)
        fx = self.tx(x); fy = self.ty(y)
        n = len(x)
        for i in range(n - 1):
            if dash and (i % dash):
                continue
            if np.isfinite(fx[i]) and np.isfinite(fy[i]) and \
               np.isfinite(fx[i + 1]) and np.isfinite(fy[i + 1]):
                draw_line(fx[i], fy[i], fx[i + 1], fy[i + 1], color)

    def marker_x(self, x, y, color, size=4):
        if np.isfinite(x) and np.isfinite(y):
            cx, cy = self.tx(x), self.ty(y)
            draw_line(cx - size, cy - size, cx + size, cy + size, color)
            draw_line(cx - size, cy + size, cx + size, cy - size, color)

    def xticks_lin(self, n=5):
        vals = np.linspace(self.rx[0], self.rx[1], n)
        for v in vals:
            xx = self.tx(v)
            draw_line(xx, self.y0 + self.h, xx, self.y0 + self.h + 3, BLACK)
            draw_text(xx - text_w(_fmt(v)) / 2,
                      self.y0 + self.h + 5, _fmt(v), 1, BLACK)

    def xticks_log(self):
        k0 = int(np.ceil(self.rx[0] - 1e-9)); k1 = int(np.floor(self.rx[1] + 1e-9))
        for k in range(k0, k1 + 1):
            xx = self.tx(float(k))
            draw_line(xx, self.y0 + self.h, xx, self.y0 + self.h + 3, BLACK)
            lab = f"10^{k}"
            draw_text(xx - text_w(lab) / 2, self.y0 + self.h + 5, lab, 1, BLACK)

    def yticks_lin(self, n=5):
        vals = np.linspace(self.ry[0], self.ry[1], n)
        for v in vals:
            yy = self.ty(v)
            draw_line(self.x0 - 3, yy, self.x0, yy, BLACK)
            lab = _fmt(v)
            draw_text(self.x0 - 5 - text_w(lab), yy - 3, lab, 1, BLACK)

    def yticks_log(self):
        k0 = int(np.ceil(self.ry[0] - 1e-9)); k1 = int(np.floor(self.ry[1] + 1e-9))
        for k in range(k0, k1 + 1):
            yy = self.ty(float(k))
            draw_line(self.x0 - 3, yy, self.x0, yy, BLACK)
            lab = f"10^{k}"
            draw_text(self.x0 - 5 - text_w(lab), yy - 3, lab, 1, BLACK)

    def xlabel(self, s):
        draw_text(self.x0 + self.w / 2 - text_w(s) / 2, self.y0 + self.h + 14, s, 1, BLACK)

    def ylabel(self, s):
        # vertical text rendered horizontally, rotated by drawing column-wise
        for i, ch in enumerate(str(s).upper()):
            g = _G.get(ch, _G[" "])
            base_x = self.x0 - text_w(s) - 8
            base_y = self.y0 + self.h / 2 - text_w(s) / 2 + i * 6
            for gy, row in enumerate(g):
                for gx, b in enumerate(row):
                    if b == "1":
                        # rotate 90 degrees: (gx,gy) -> (gy, -gx)
                        fill_rect(int(base_x) + gy, int(base_y) - gx, 1, 1, BLACK)

    def legend(self, items, xy=(6, 4)):
        lx, ly = self.x0 + xy[0], self.y0 + xy[1]
        for color, label in items:
            fill_rect(lx, ly + 2, 8, 3, color)
            draw_text(lx + 12, ly, label, 1, BLACK)
            ly += 11


def auto_range(arrays, log=False, pad=0.06):
    a = np.concatenate([np.ravel(np.asarray(a, float)) for a in arrays])
    a = a[np.isfinite(a)]
    if log:
        a = np.log10(a[a > 0])
    lo, hi = float(a.min()), float(a.max())
    d = (hi - lo) or 1.0
    return lo - pad * d, hi + pad * d


def write_png(path, image):
    h, w = image.shape[:2]
    raw = b"".join(b"\x00" + image[y].tobytes() for y in range(h))
    def chunk(tag, data):
        return (struct.pack(">I", len(data)) + tag + data +
                struct.pack(">I", zlib.crc32(tag + data) & 0xFFFFFFFF))
    png = (b"\x89PNG\r\n\x1a\n" +
           chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0)) +
           chunk(b"IDAT", zlib.compress(raw, 6)) +
           chunk(b"IEND", b""))
    with open(path, "wb") as fh:
        fh.write(png)

