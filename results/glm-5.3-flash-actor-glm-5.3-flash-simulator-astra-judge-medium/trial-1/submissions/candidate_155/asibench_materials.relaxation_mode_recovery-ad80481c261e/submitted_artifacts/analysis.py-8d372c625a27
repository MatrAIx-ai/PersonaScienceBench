#!/usr/bin/env python3
"""Shared-mode recovery from complex response curves.
R_m(x) = a0_m + sum_k a_mk / (1 + (i*x*tau_k)^phi_k)
Shared (K, tau_k, phi_k); curve-specific a0_m, a_mk>=0 (real).
Outer: bounded trf LS over (log10 tau_k, phi_k), 2K params.
Inner (variable projection): linear in (a0_m,a_mk); re/im-stacked bounded LS.
Gram matrix is identical across curves (columns 1, Re f_k, Im f_k), so the
unconstrained VARPRO solve is done via one shared Gram + 5 rhs vectors.
"""
import numpy as np, json, os
from scipy.optimize import least_squares, lsq_linear

RNG = np.random.default_rng(20260617)
D = np.genfromtxt('data/curves.csv', delimiter=',', names=True, dtype=None, encoding='utf8')
CUR = D['curve'].astype(int); NC = 5
X = D['x'][:96].copy(); N = len(X)
assert all(np.array_equal(X, D['x'][CUR == m]) for m in range(NC))
R = [D['re'][CUR == m] + 1j * D['im'][CUR == m] for m in range(NC)]
LXMIN, LXMAX = np.log10(X.min()), np.log10(X.max())
TAU_LO, TAU_HI = LXMIN - 0.5, LXMAX + 0.5
PHI_LO = 0.01
SIG_EST = np.array([np.std(np.diff(v, 2)) / np.sqrt(6.0)
                    for m in range(NC) for v in (R[m].real, R[m].imag)])
SIGMA = float(SIG_EST.mean())

def basis(p, x):
    K = len(p) // 2
    return 1.0 / (1.0 + (1j * x[None, :] * 10.0 ** p[:K, None]) ** p[K:, None])

def solve_curve_direct(f, Rm):
    K = f.shape[0]
    A = np.empty((2 * N, K + 1))
    A[:N, 0] = 1.0; A[N:, 0] = 0.0; A[:N, 1:] = f.real.T; A[N:, 1:] = f.imag.T
    b = np.empty(2 * N); b[:N] = Rm.real; b[N:] = Rm.imag
    lb = np.full(K + 1, -np.inf); ub = np.full(K + 1, np.inf); lb[1:] = 0.0
    rr = lsq_linear(A, b, bounds=(lb, ub), tol=1e-12)
    return rr.x, rr.fun

def residuals(p, RR=None):
    """Joint residual vector + per-curve amplitudes (variable projection)."""
    RR = R if RR is None else RR
    f = basis(p, X); K = f.shape[0]
    Re, Im = f.real, f.imag                      # K x N
    G = np.empty((K + 1, K + 1))
    G[0, 0] = N
    sRe = Re.sum(axis=1)
    G[0, 1:] = sRe; G[1:, 0] = sRe
    G[1:, 1:] = Re @ Re.T + Im @ Im.T
    rhs = np.empty((K + 1, NC))
    rhs[0] = [RR[m].real.sum() for m in range(NC)]
    for m in range(NC):
        rhs[1:, m] = Re @ RR[m].real + Im @ RR[m].imag
    out = np.empty(NC * 2 * N); amps = np.empty((NC, K + 1))
    Gs = G + 1e-12 * np.eye(K + 1) * max(1.0, np.trace(G))
    sol = np.linalg.solve(Gs, rhs)               # unconstrained VARPRO, all curves
    for m in range(NC):
        a = sol[:, m]
        if np.all(a[1:] >= -1e-10):
            pred_re = a[0] + Re.T @ a[1:]
            pred_im = Im.T @ a[1:]
            amps[m] = a
            out[2 * N * m:2 * N * m + N] = RR[m].real - pred_re
            out[2 * N * m + N:2 * N * (m + 1)] = RR[m].imag - pred_im
        else:
            a2, r2 = solve_curve_direct(f, RR[m])
            amps[m] = a2
            out[2 * N * m:2 * N * (m + 1)] = r2
    return out, amps

def bounds_of(K):
    lo = np.full(2 * K, TAU_LO); hi = np.full(2 * K, TAU_HI)
    lo[K:] = PHI_LO; hi[K:] = 1.0
    return lo, hi

def fit_once(p0, max_nfev=4000, tol=1e-13):
    K = len(p0) // 2
    r = least_squares(lambda p: residuals(p)[0], p0, bounds=bounds_of(K),
                      method='trf', xtol=tol, ftol=tol, gtol=tol, max_nfev=max_nfev)
    res, amps = residuals(r.x)
    return dict(x=r.x, rss=float(res @ res), res=res, amps=amps, nfev=r.nfev)

def seed_quantile(K, phi=0.8):
    lt = np.interp(np.linspace(0.08, 0.92, K), [0, 1], [TAU_LO + 0.3, TAU_HI - 0.3])
    return np.concatenate([np.sort(lt), np.full(K, phi)])

def multistart(K, n_rand, n_screen=200):
    sols = [fit_once(seed_quantile(K, phi), max_nfev=600, tol=1e-10) for phi in (0.5, 0.8, 1.0)]
    for i in range(n_rand):
        lt = np.sort(RNG.uniform(TAU_LO, TAU_HI, K))
        sols.append(fit_once(np.concatenate([lt, RNG.uniform(0.15, 1.0, K)]),
                             max_nfev=n_screen, tol=1e-10))
        if (i + 1) % 50 == 0:
            print("  K=%d screened %d/%d" % (K, i + 1, n_rand), flush=True)
    sols.sort(key=lambda s: s['rss'])
    top = [fit_once(s['x'], max_nfev=4000, tol=1e-13) for s in sols[:8]]
    top += sols
    top.sort(key=lambda s: s['rss'])
    return top

n = NC * 2 * N
print("== data ==", flush=True)
print("curves=%d points=%d shared log grid OK; step %.4f dex; x in [%.3e,%.3e]"
      % (NC, N, np.diff(np.log10(X))[0], X.min(), X.max()))
print("noise sigma (2nd-diff, re&im x 5):", np.round(SIG_EST, 4), "mean %.4f" % SIGMA, flush=True)

print("\n== multistart K=1..6 ==", flush=True)
results = {}
for K in range(1, 7):
    sols = multistart(K, 120 if K <= 3 else (160 if K <= 5 else 150))
    results[K] = sols; best = sols[0]
    p_mod = 2 * K + NC * (K + 1)
    bic = n * np.log(best['rss'] / n) + p_mod * np.log(n)
    p_eff = p_mod - int(np.sum(best['amps'][:, 1:] < 1e-8))
    print("K=%d RSS=%8.4f rms=%.4f BIC(p=%d)=%8.2f (p_eff=%d BIC_eff=%8.2f) nfev=%d"
          % (K, best['rss'], np.sqrt(best['rss'] / n), p_mod, bic, p_eff,
             n * np.log(best['rss'] / n) + p_eff * np.log(n), best['nfev']), flush=True)
    print("   taus", np.round(10 ** best['x'][:K], 6), "phis", np.round(best['x'][K:], 4), flush=True)
    np.savez('results/search_K%d.npz' % K, x=best['x'], rss=best['rss'],
             amps=best['amps'], n_sols=len(sols))

def bic_of(sol, K, eff=False):
    p = 2 * K + NC * (K + 1)
    if eff: p -= int(np.sum(sol['amps'][:, 1:] < 1e-8))
    return n * np.log(sol['rss'] / n) + p * np.log(n)

bics = {K: bic_of(results[K][0], K) for K in range(1, 7)}
K_bic = min(bics, key=bics.get)
print("\nBIC by K:", {K: round(v, 2) for K, v in bics.items()}, "-> argmin K =", K_bic)

def prune_reasons(sol, K):
    taus = 10 ** sol['x'][:K]; keep = []; why = []
    for k in range(K):
        if np.all(sol['amps'][:, 1 + k] < 1e-6):
            why.append((k, 'a_k~0 all curves')); continue
        if any(abs(np.log10(taus[k] / taus[j])) < 0.5 for j in keep):
            why.append((k, 'tau within 0.5 dex of mode %d' % (keep[-1] + 1))); continue
        keep.append(k)
    return keep, why

for Kc in (4, 5):
    keep, why = prune_reasons(results[Kc][0], Kc)
    print("K=%d pruning: %s" % (Kc, why if why else "no redundant modes"))

K_final, sol_final = K_bic, results[K_bic][0]
for K in range(K_bic + 1, 7):
    d_rms = np.sqrt(results[K - 1][0]['rss'] / n) - np.sqrt(results[K][0]['rss'] / n)
    if d_rms < 0.15 * SIGMA:
        print("parsimony: K=%d rejected (rms gain %.4f < 0.15*sigma)" % (K, d_rms)); break
    K_final, sol_final = K, results[K][0]
print("chosen K =", K_final)

print("\n== stability (K=%d) ==" % K_final, flush=True)
sol = sol_final; taus = 10 ** sol['x'][:K_final]; phis = sol['x'][K_final:]
def same_modes(t1, t2, tol=0.25):
    return len(t1) == len(t2) and np.all(np.abs(np.log10(np.sort(t1)) - np.log10(np.sort(t2))) < tol)
good = sum(same_modes(10 ** s['x'][:K_final], taus) for s in results[K_final])
print("multistart: %d/%d runs reproduce the mode set (0.25 dex tol)" % (good, len(results[K_final])))
boot = []
for b in range(25):
    Rb = [R[m] + RNG.normal(0, SIGMA, N) + 1j * RNG.normal(0, SIGMA, N) for m in range(NC)]
    rb = least_squares(lambda p: residuals(p, Rb)[0], sol['x'], bounds=bounds_of(K_final),
                       method='trf', xtol=1e-11, ftol=1e-11, max_nfev=2000)
    boot.append(np.sort(10 ** rb.x[:K_final]))
boot = np.array(boot); med = np.median(boot, axis=0)
lo_, hi_ = np.percentile(boot, [16, 84], axis=0)
print("bootstrap(25): tau median", np.round(med, 5))
print("  16-84%% spread (dex): +", np.round(np.log10(hi_ / med), 3), "-",
      np.round(np.log10(med / lo_), 3), "| grid res %.3f dex" % np.diff(np.log10(X))[0])
flags = []
for k in range(K_final):
    fl = []
    if phis[k] > 1 - 1e-4: fl.append('phi=1 boundary')
    if min(abs(sol['x'][k] - TAU_LO), abs(sol['x'][k] - TAU_HI)) < 1e-3: fl.append('tau at bound')
    if np.any(sol['amps'][:, 1 + k] < 1e-6): fl.append('a_k~0 in some curve')
    if fl: flags.append((k + 1, fl))
print("boundary audit:", flags if flags else "none")
res2 = sol['res'].reshape(NC, 2, N)
print("residual var re/im = %.3f" % (np.var(res2[:, 0]) / np.var(res2[:, 1])))

final = fit_once(sol['x'], max_nfev=8000, tol=1e-14)
order = np.argsort(10 ** final['x'][:K_final])
taus_f = (10 ** final['x'][:K_final])[order]; phis_f = final['x'][K_final:][order]
amps = final['amps']; amps_f = np.hstack([amps[:, [0]], amps[:, 1:][:, order]])
os.makedirs('results', exist_ok=True)
with open('results/modes.csv', 'w') as fh:
    fh.write('tau,' + ','.join('a_%d' % m for m in range(NC)) + '\n')
    for k in range(K_final):
        fh.write('%.8g,' % taus_f[k] + ','.join('%.8g' % amps_f[m, k + 1] for m in range(NC)) + '\n')
print("\n== final ==")
print("K =", K_final)
for k in range(K_final):
    print("mode %d tau=%.6g phi=%.4f a=%s" % (k + 1, taus_f[k], phis_f[k], np.round(amps_f[:, k + 1], 4)))
print("a0 per curve:", np.round(amps_f[:, 0], 4))
fr = final['res'].reshape(NC, 2, N)
for m in range(NC):
    print("curve %d rms = %.4f" % (m, np.sqrt((fr[m] ** 2).sum() / (2 * N))))
print("joint rms = %.4f (noise floor ~ %.4f)" % (np.sqrt(final['rss'] / n), SIGMA))
print("wrote results/modes.csv")
