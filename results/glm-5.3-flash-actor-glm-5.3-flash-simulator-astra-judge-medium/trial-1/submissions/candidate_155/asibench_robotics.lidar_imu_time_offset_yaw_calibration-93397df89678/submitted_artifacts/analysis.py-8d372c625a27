 ')': _rows(".X...", "..X..", "...X.", "...X.", "...X.", "..X..", ".X..."),
 '+': _rows(".....", "..X..", "..X..", "XXXXX", "..X..", "..X..", "....."),
 '=': _rows(".....", ".....", "XXXXX", ".....", "XXXXX", ".....", "....."),
 '/': _rows("....X", "...X.", "...X.", "..X..", ".X...", ".X...", "X...."),
 ':': _rows(".....", "..X..", "..X..", ".....", "..X..", "..X..", "....."),
 ',': _rows(".....", ".....", ".....", ".....", "..XX.", "..X..", ".X..."),
 '*': _rows(".....", "X.X.X", ".XXX.", "XXXXX", ".XXX.", "X.X.X", "....."),
 ' ': _rows(".....", ".....", ".....", ".....", ".....", ".....", "....."),
}


def _draw_text(canvas, x, y, text, color, scale=2):
    x, y = int(x), int(y)
    for ch in text:
        g = FONT.get(ch.upper(), FONT[' '])
        for r, row in enumerate(g):
            for c, cc in enumerate(row):
                if cc == 'X':
                    canvas[y + r * scale:y + (r + 1) * scale,
                           x + c * scale:x + (c + 1) * scale] = color
        x += 6 * scale


def _line(canvas, x0, y0, x1, y1, color):
    n = int(max(abs(x1 - x0), abs(y1 - y0))) + 1
    xs = np.linspace(x0, x1, n).astype(int)
    ys = np.linspace(y0, y1, n).astype(int)
    ok = (xs >= 0) & (xs < canvas.shape[1]) & (ys >= 0) & (ys < canvas.shape[0])
    canvas[ys[ok], xs[ok]] = color


class _Panel:
    """One axes panel: data-to-pixel mapping, frame, ticks, labels."""

    def __init__(self, canvas, rect, xlim, ylim, title="", xlabel="", ylabel=""):
        self.cv, self.rect = canvas, rect
        self.xlim, self.ylim = list(map(float, xlim)), list(map(float, ylim))
        x0, y0, w, h = rect
        self.pl, self.pt, self.pw, self.ph = x0 + 58, y0 + 30, w - 72, h - 72
        self._frame()
        self._ticks()
        if title:
            _draw_text(canvas, x0 + 60, y0 + 6, title[:62], (0, 0, 0), 2)
        if xlabel:
            _draw_text(canvas, self.pl + self.pw // 2 - 5 * len(xlabel),
                       y0 + h - 18, xlabel, (0, 0, 0), 2)
        if ylabel:
            _draw_text(canvas, x0 + 6, y0 + 30 + self.ph // 2 - 5 * len(ylabel),
                       ylabel, (0, 0, 0), 2)

    def _frame(self):
        c = (60, 60, 60)
        _line(self.cv, self.pl, self.pt, self.pl + self.pw, self.pt, c)
        _line(self.cv, self.pl, self.pt + self.ph, self.pl + self.pw,
              self.pt + self.ph, c)
        _line(self.cv, self.pl, self.pt, self.pl, self.pt + self.ph, c)
        _line(self.cv, self.pl + self.pw, self.pt, self.pl + self.pw,
              self.pt + self.ph, c)

    def to_px(self, x, y):
        x0, x1 = self.xlim
        y0, y1 = self.ylim
        if x1 == x0: x1 = x0 + 1
        if y1 == y0: y1 = y0 + 1
        px = self.pl + (np.asarray(x) - x0) / (x1 - x0) * self.pw
        py = self.pt + self.ph - (np.asarray(y) - y0) / (y1 - y0) * self.ph
        return px, py

    def _ticks(self):
        def fmt(v):
            return f"{v:.3g}".upper()[:7]
        for frac in (0.0, 0.25, 0.5, 0.75, 1.0):
            xv = self.xlim[0] + frac * (self.xlim[1] - self.xlim[0])
            px, py = self.to_px(xv, self.ylim[0])
            _line(self.cv, px, py, px, py + 4, (60, 60, 60))
            _draw_text(self.cv, int(px) - 8, int(py) + 7, fmt(xv), (0, 0, 0), 1)
            yv = self.ylim[0] + frac * (self.ylim[1] - self.ylim[0])
            px, py = self.to_px(self.xlim[0], yv)
            _line(self.cv, px - 4, py, px, py, (60, 60, 60))
            _draw_text(self.cv, px - 36, int(py) - 3, fmt(yv), (0, 0, 0), 1)

    def scatter(self, x, y, color):
        for xi, yi in zip(np.asarray(x), np.asarray(y)):
            px, py = self.to_px(xi, yi)
            _dot(self.cv, int(px), int(py), color, 2)

    def plot_line(self, x, y, color):
        px, py = self.to_px(np.asarray(x, float), np.asarray(y, float))
        _line(self.cv, px[0], py[0], px[-1], py[-1], color)

    def hline(self, yv, color):
        px, py = self.to_px(np.array([self.xlim[0], self.xlim[1]]),
                            np.array([yv, yv]))
        _line(self.cv, px[0], py[0], px[1], py[1], color)

    def bars(self, labels, values, color, label_fmt=str):
        n = len(values)
        bw = max(int(self.pw / (n * 1.5)), 3)
        for i, v in enumerate(values):
            xc = self.xlim[0] + (i + 0.5) / n * (self.xlim[1] - self.xlim[0])
            px, py0 = self.to_px(xc, self.ylim[0])
            _, py1 = self.to_px(xc, max(v, self.ylim[1] * 1e-6))
            x0 = int(px - bw / 2)
            self.cv[int(py1):int(py0), x0:x0 + bw] = color
            _draw_text(self.cv, int(px) - 4 * len(label_fmt(labels[i])),
                       self.pt + self.ph + 14, label_fmt(labels[i]), (0, 0, 0), 1)


def _dot(canvas, x, y, color, s=1):
    h, w = canvas.shape[:2]
    x, y = max(0, min(w - s, x)), max(0, min(h - s, y))
    canvas[y:y + s, x:x + s] = color


def render_fallback_png(fd, path):
    W, H = 1560, 920
    cv = np.full((H, W, 3), 255, np.uint8)
    _draw_text(cv, 380, 6,
               "MULTI-SENSOR MOTION RECORD AUDIT - CALIBRATION DIAGNOSTICS",
               (0, 0, 0), 2)
    r = fd["r_vs_time"]
    ylim = (float(min(r["r_tr"].min(), r["r_he"].min())) - 0.002,
            float(max(r["r_tr"].max(), r["r_he"].max())) + 0.002)
    p = _Panel(cv, (10, 34, 500, 410),
               (float(r["t_tr"].min()), float(r["t_tr"].max())), ylim,
               "YAW RESIDUAL VS TIME (ZERO SHIFT)", "TIME (S)", "RAD")
    p.scatter(r["t_tr"], r["r_tr"], (31, 119, 180))
    p.scatter(r["t_he"], r["r_he"], (255, 127, 14))
    p.hline(r["hline"], (0, 0, 0))
    _draw_text(cv, 80, 418, "BLUE: TRAIN   ORANGE: HELDOUT   BLACK: -B*DT",
               (0, 0, 0), 2)

    d = fd["delta_fit"]
    p = _Panel(cv, (525, 34, 500, 410),
               (float(d["x"].min()), float(d["x"].max())),
               (float(d["y"].min()) - .002, float(d["y"].max()) + .002),
               d["title"], "OMEGA(T1)-OMEGA(T0) (RAD)", "RESID (RAD)")
    p.scatter(d["x"], d["y"], (31, 119, 180))
    xd = np.linspace(d["x"].min(), d["x"].max(), 10)
    p.plot_line(xd, d["slope"] * xd, (214, 39, 40))

    tl = fd["tilt"]
    ymin = float(min(tl["y_tr"].min(), tl["y_he"].min())) - .01
    ymax = float(max(tl["y_tr"].max(), tl["y_he"].max())) + .01
    p = _Panel(cv, (1040, 34, 510, 410), (0.0, float(tl["x_tr"].max())),
               (ymin, ymax), f"TRANSLATION TILT: PHI={tl['phi']:.4f} RAD",
               "DX (M)", "DY (M)")
    p.scatter(tl["x_tr"], tl["y_tr"], (31, 119, 180))
    p.scatter(tl["x_he"], tl["y_he"], (255, 127, 14))
    xs = np.linspace(0, tl["x_tr"].max(), 10)
    p.plot_line(xs, -np.tan(tl["phi"]) * xs, (214, 39, 40))

    o = fd["obs"]
    p = _Panel(cv, (10, 480, 500, 420), (-0.5, len(o["ids"]) - 0.5),
               (0.0, max(o["scores"]) * 1.15), "PER-SEGMENT OBSERVABILITY",
               "SEGMENT ID", "SCORE")
    p.bars(o["ids"], o["scores"], (31, 119, 180))

    h = fd["hist"]
    cnt, edges = np.histogram(h["res"], bins=25)
    p = _Panel(cv, (525, 480, 500, 420), (float(edges[0]), float(edges[-1])),
               (0, int(cnt.max()) * 1.15), "HELD-OUT YAW RESIDUALS",
               "RESIDUAL (RAD)", "COUNT")
    centers = 0.5 * (edges[:-1] + edges[1:])
    p.bars(np.round(centers, 3), cnt, (255, 187, 120), label_fmt=lambda v: "")

    s = fd["sign"]
    p = _Panel(cv, (1040, 480, 510, 420), (-0.5, 2.5),
               (0.0, max(s["vals"]) * 1.2), "EXTRINSIC SIGN CHECK",
               "", "MEAN MISFIT (M)")
    p.bars(range(3), s["vals"], (44, 160, 44))
    for i, lab in enumerate(s["labels"]):
        _draw_text(cv, 1060 + i * 170, 866, lab[:14], (0, 0, 0), 1)

    # ---- encode PNG
    raw = b"".join(b"\x00" + cv[y].tobytes() for y in range(H))
    import struct, zlib
    def chunk(tag, data):
        c = struct.pack(">I", len(data)) + tag + data
        return c + struct.pack(">I", zlib.crc32(tag + data) & 0xFFFFFFFF)
    png = (b"\x89PNG\r\n\x1a\n"
           + chunk(b"IHDR", struct.pack(">IIBBBBB", W, H, 8, 2, 0, 0, 0))
           + chunk(b"IDAT", zlib.compress(raw, 6))
           + chunk(b"IEND", b""))
    path.write_bytes(png)


