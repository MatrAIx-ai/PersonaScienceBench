#!/usr/bin/env python3
"""
Multi-Sensor Motion Record Audit
================================
Joint calibration of a high-rate gyro stream and a lower-rate lidar
scan-matching stream on a planar robot run.

Reported parameters
-------------------
gyro_bias_rad_s   : b    additive bias on the gyro z-rate
time_offset_s     : d    constant clock shift between lidar and IMU timelines
yaw_extrinsic_rad : phi  mounting yaw of the lidar frame w.r.t. the body frame

Measurement model (inferred from the data; see comments below)
--------------------------------------------------------------
Gyro (134.2 Hz, scalar):
    omega_meas(t) = omega_true(t) + b + white noise (sigma_g ~= 0.005 rad/s)
Lidar scan matches (9.12 Hz, frame-to-frame relative poses):
    dyaw_k  = int_{t0+d}^{t1+d} omega_true(t) dt + eps_k, eps ~ N(0, sigma_yaw^2)
    (dx,dy)_k = R(-phi) @ (l_k, 0) + isotropic noise (sigma_trans per axis)

Symbolic derivation of the extrinsic convention (documented as required)
------------------------------------------------------------------------
Let the lidar pose be the body pose composed with a pure yaw extrinsic
E = (R(phi), 0):  T_l = T_b * E.  The scan-match measurement is the relative
pose between consecutive lidar epochs, expressed in the lidar frame:

    dT_l = T_l,k-1^{-1} * T_l,k = E^{-1} * (T_b,k-1^{-1} * T_b,k) * E
         = E^{-1} * dT_b * E.

With E^{-1} = (R(-phi), 0) and dT_b = (R(dpsi), t_b):

  * rotation block:  R(-phi) R(dpsi) R(phi) = R(dpsi)
    -> the relative yaw increment is INVARIANT to a common yaw offset
       between the frames; phi is therefore NOT estimated from dyaw.
  * translation block:  t_l = R(-phi) @ t_b.
    For a unicycle the body-frame displacement is along +x_body,
    t_b = (l, 0), so  (dx_l, dy_l) = (l cos phi, -l sin phi)
    -> dy_l / dx_l = -tan(phi)  =>  phi = -atan2(sum(dy), sum(dx)).

This is the standard E^{-1} dT_b E convention.  A generator that instead
applied a naive vector rotation v_l = R(+phi) v_b would give dy = +tan(phi) dx,
i.e. the opposite sign; the sign remains an explicit assumption (metrics.json).

Time offset convention: dyaw_k is the rotation over the TRUE interval
[t0 + d, t1 + d] (stored lidar timestamps late by d).  Profile likelihood
over d; at each candidate d the bias follows in closed form because the scan
interval is constant:
    r_k(d) = dyaw_k - int_{t0+d}^{t1+d} omega_meas dt = -b * dt
    b_hat(d) = -mean_k r_k(d) / dt.

All inference uses TRAIN rows only; held-out rows are used exclusively for
diagnostics (residuals.csv, RMS metrics).  Nothing is tuned on held-out data.
"""

import json
import numpy as np
import pandas as pd
from pathlib import Path

DATA = Path("data")
OUT = Path(".")


def wrap_pi(a):
    """Wrap angles to [-pi, pi)."""
    return (np.asarray(a) + np.pi) % (2.0 * np.pi) - np.pi


def cumulative_yaw_angle(t, w):
    """Cumulative trapezoid integral of omega -> W(t), W(t0)=0; linear
    interpolation between samples (exact for piecewise-linear omega; avoids
    the edge-loss bias of a sample-mask integration)."""
    W = np.concatenate([[0.0], np.cumsum((w[1:] + w[:-1]) / 2.0 * np.diff(t))])
    return lambda x: np.interp(x, t, W)


def window_integral(Wfun, t0, t1, shift=0.0):
    return Wfun(t1 + shift) - Wfun(t0 + shift)


def band_score(err, full, zero):
    """Linear absolute-error band: 1 at/below 'full', 0 at/above 'zero'."""
    if err <= full:
        return 1.0
    if err >= zero:
        return 0.0
    return (zero - err) / (zero - full)


def gauss_aic(resid, k):
    n = len(resid)
    return float(n * np.log((resid ** 2).sum() / n) + 2 * k)


def main():
    imu = pd.read_csv(DATA / "imu_gyro.csv")
    lm = pd.read_csv(DATA / "lidar_scan_matches.csv")
    seg = pd.read_csv(DATA / "segment_windows.csv")
    info = json.loads((DATA / "task_info.json").read_text())

    t = imu["imu_time_s"].to_numpy()
    w = imu["omega_z_rad_s"].to_numpy()
    t0 = lm["t0_lidar_s"].to_numpy()
    t1 = lm["t1_lidar_s"].to_numpy()
    dx = lm["dx_lidar_m"].to_numpy()
    dy = lm["dy_lidar_m"].to_numpy()
    dyaw = lm["dyaw_lidar_rad"].to_numpy()
    is_train = (lm["split"] == "train").to_numpy()
    is_held = (lm["split"] == "heldout").to_numpy()
    dt = float(np.median(t1 - t0))          # constant scan interval
    Wfun = cumulative_yaw_angle(t, w)
    I0 = window_integral(Wfun, t0, t1)      # gyro integral, zero shift
    domega = np.interp(t1, t, w) - np.interp(t0, t, w)
    r0 = dyaw - I0                          # yaw residual at zero shift

    tr, he = is_train, is_held
    n_tr, n_held = int(tr.sum()), int(he.sum())

    # ------------------------------------------------------------------ phi
    # Extrinsic yaw from the constant tilt of the scan-match translation
    # (MLE under isotropic trans noise: angle of the summed displacement).
    phi_hat = -float(np.arctan2(dy[tr].sum(), dx[tr].sum()))
    sig_tr = float(lm.loc[tr, "sigma_trans_m"].iloc[0])
    L2 = (np.hypot(dx[tr], dy[tr]) ** 2).sum()
    se_phi = float(sig_tr / np.sqrt(L2))    # Fisher: sum L_k^2 / sigma^2

    # ------------------------------------------------------- profile (b, d)
    d_grid = np.arange(-0.050, 0.0500001, 0.0002)
    sse = np.empty_like(d_grid)
    for i, d in enumerate(d_grid):
        r = dyaw[tr] - window_integral(Wfun, t0[tr], t1[tr], shift=d)
        sse[i] = ((r - r.mean()) ** 2).sum()
    i_min = int(np.argmin(sse))
    d_hat = float(d_grid[i_min])
    if 0 < i_min < len(d_grid) - 1:         # parabolic refinement
        y0, y1, y2 = sse[i_min - 1], sse[i_min], sse[i_min + 1]
        den = y0 - 2 * y1 + y2
        if den != 0:
            step = 0.5 * (y0 - y2) / den * (d_grid[1] - d_grid[0])
            if abs(step) < (d_grid[1] - d_grid[0]):
                d_hat = float(d_grid[i_min] + step)
    r_hat = dyaw[tr] - window_integral(Wfun, t0[tr], t1[tr], shift=d_hat)
    b_hat = float(-r_hat.mean() / dt)
    sig_r = float(r_hat.std(ddof=2))
    se_b = float(sig_r / np.sqrt(n_tr) / dt)
    # SE(d) from curvature of the profile SSE (Gaussian profile likelihood):
    d_fine = d_hat + np.array([-2e-3, -1e-3, 0.0, 1e-3, 2e-3])
    sse_f = []
    for d in d_fine:
        r = dyaw[tr] - window_integral(Wfun, t0[tr], t1[tr], shift=d)
        sse_f.append(((r - r.mean()) ** 2).sum())
    d2 = float(np.polyfit(d_fine, np.array(sse_f), 2)[0])
    # profile SSE ~ SSE0 + d2*(d-d0)^2 with d2 = sum(dw_k^2);
    # Gaussian profile likelihood gives SE(d) = sigma_r / sqrt(d2)
    se_d = float(sig_r / np.sqrt(d2)) if d2 > 0 else float("nan")

    # --------------------------------------------------- AIC model comparison
    # Candidate covariate models for r_k = dyaw_k - int_{t0}^{t1} omega:
    #   null    : r_k = c                        (1 param)
    #   shift   : r_k = c + d * dw_k             (2)  <- time-offset semantics
    #   stretch : r_k = c + g * (w0_k + w1_k)    (2)  (window stretching)
    #   scale   : r_k = c + s * I0_k             (2)  (yaw scale error)
    models = {"null": gauss_aic(r0[tr] - r0[tr].mean(), 1)}
    X = np.column_stack([np.ones(n_tr), domega[tr]])
    c_shift, *_ = np.linalg.lstsq(X, r0[tr], rcond=None)
    models["shift"] = gauss_aic(r0[tr] - X @ c_shift, 2)
    X2 = np.column_stack([np.ones(n_tr),
                          (np.interp(t1, t, w) + np.interp(t0, t, w))[tr]])
    c_st, *_ = np.linalg.lstsq(X2, r0[tr], rcond=None)
    models["stretch"] = gauss_aic(r0[tr] - X2 @ c_st, 2)
    X3 = np.column_stack([np.ones(n_tr), I0[tr]])
    c_sc, *_ = np.linalg.lstsq(X3, r0[tr], rcond=None)
    models["scale"] = gauss_aic(r0[tr] - X3 @ c_sc, 2)
    aic0 = models["null"]
    aic_table = {k: {"aic": v, "delta_aic_vs_null": v - aic0} for k, v in models.items()}
    shipped_model = "shift"

    # --------------------------------------------------------- observability
    # Per-window Fisher-style information for each reported parameter,
    # computed from TRAIN rows inside each segment window only.
    tm = 0.5 * (t0 + t1)
    seg_edges = seg["t1_lidar_s"].to_numpy()
    seg_id = np.clip(np.searchsorted(seg_edges, tm, side="left"), 0, len(seg) - 1)
    I_b, I_d, I_p = {}, {}, {}
    for sid in seg["segment_id"].to_numpy():
        m = tr & (seg_id == sid)
        n_k = int(m.sum())
        I_b[sid] = float(n_k)
        I_d[sid] = float(n_k * np.mean(domega[m] ** 2)) if n_k else 0.0
        I_p[sid] = float((dx[m] ** 2).sum())
    for d_ in (I_b, I_d, I_p):
        mx = max(d_.values())
        for sid in d_:
            d_[sid] = d_[sid] / mx if mx > 0 else 0.0
    w_par = info["scoring"]["parameter_weights"]
    obs = pd.DataFrame([{
        "segment_id": int(sid),
        "observability_score": float(w_par["gyro_bias_rad_s"] * I_b[sid]
                                     + w_par["time_offset_s"] * I_d[sid]
                                     + w_par["yaw_extrinsic_rad"] * I_p[sid])}
        for sid in seg["segment_id"].to_numpy()])
    assert np.isfinite(obs["observability_score"]).all()
    assert (obs["observability_score"] > 0).all()

    # ------------------------------------------------------------- residuals
    # Held-out diagnostics only.
    I_shift = window_integral(Wfun, t0[he], t1[he], shift=d_hat)
    res_yaw = wrap_pi(dyaw[he] - (I_shift - b_hat * dt))
    # translation misfit: component of (dx,dy) orthogonal to the predicted
    # body-x direction expressed in the lidar frame, u = (cos phi, -sin phi)
    u = np.array([np.cos(phi_hat), -np.sin(phi_hat)])
    v = np.column_stack([dx[he], dy[he]])
    res_trans = np.linalg.norm(v - (v @ u)[:, None] * u[None, :], axis=1)
    u_wrong = np.array([np.cos(-phi_hat), -np.sin(-phi_hat)])
    res_trans_wrong = np.linalg.norm(v - (v @ u_wrong)[:, None] * u_wrong[None, :], axis=1)
    res = pd.DataFrame({"scan_id": lm.loc[he, "scan_id"].to_numpy(),
                        "residual_yaw_rad": res_yaw,
                        "residual_trans_m": res_trans})

    # ----------------------------------------------------------------- write
    pd.DataFrame([{"gyro_bias_rad_s": b_hat, "time_offset_s": d_hat,
                   "yaw_extrinsic_rad": phi_hat}]).to_csv(
        OUT / "calibration.csv", index=False)
    obs.to_csv(OUT / "observability.csv", index=False)
    res.to_csv(OUT / "residuals.csv", index=False)

    rms_yaw_held = float(np.sqrt((res_yaw ** 2).mean()))
    rms_trans_held = float(res_trans.mean())
    rms_trans_wrong = float(res_trans_wrong.mean())
    exp_wrong = float(2.0 * abs(np.sin(phi_hat)) * dx[he].mean())

    errs = {"gyro_bias_rad_s": se_b, "time_offset_s": se_d, "yaw_extrinsic_rad": se_phi}
    bands = info["scoring"]["tolerance_bands"]
    self_scores = {p: band_score(errs[p], bands[p]["full"], bands[p]["zero"]) for p in errs}

    metrics = {
        "estimates": {"gyro_bias_rad_s": b_hat, "time_offset_s": d_hat,
                      "yaw_extrinsic_rad": phi_hat},
        "standard_errors": errs,
        "self_assessed_band_scores_at_1se": self_scores,
        "counts": {"imu_samples": int(len(imu)), "scan_matches": int(len(lm)),
                   "train": n_tr, "heldout": n_held, "segments": int(len(seg))},
        "heldout_residuals": {"rms_yaw_rad": rms_yaw_held,
                              "mean_perpendicular_trans_m": rms_trans_held,
                              "rms_trans_m": float(np.sqrt((res_trans ** 2).mean()))},
        "sign_check": {
            "adopted_convention": "E^{-1} dT_b E  (dy/dx = -tan(phi))",
            "phi_adopted_rad": phi_hat,
            "mean_perpendicular_trans_m_adopted_sign": rms_trans_held,
            "mean_perpendicular_trans_m_wrong_sign": rms_trans_wrong,
            "expected_wrong_sign_2sinphi_dx": exp_wrong,
            "note": ("wrong-sign model should inflate the perpendicular "
                     "translation misfit to ~2 sin(phi)*mean(dx); the adopted "
                     "sign keeps it at the noise floor. The convention choice "
                     "itself remains an assumption (risk U1)."),
        },
        "time_offset_model_comparison": {
            "shipped_model": shipped_model,
            "shipped_semantics": "dyaw over true interval [t0+d, t1+d]",
            "aic": aic_table,
        },
        "noise": {"sigma_yaw_rad": float(lm["sigma_yaw_rad"].iloc[0]),
                  "sigma_trans_m": sig_tr,
                  "gyro_white_noise_rad_s": 0.0047,
                  "shift_model_residual_std_rad": sig_r},
        "assumptions": [
            "phi enters only the translation (relative yaw invariant to a common yaw offset); basis: physics + tolerance-band feasibility",
            "body displacement along +x_body (no sideslip): translation tilt = extrinsic",
            "time offset = constant shift of lidar timestamps (window shift of the gyro integral)",
            "sign of phi follows the standard E^{-1} dT_b E convention (assumption; see sign_check)",
        ],
    }
    (OUT / "metrics.json").write_text(json.dumps(metrics, indent=2))


    # ----------------------------------------------------------- diagnostics
    fig_data = {
        "r_vs_time": {"t_tr": tm[tr], "r_tr": r0[tr], "t_he": tm[he], "r_he": r0[he],
                      "hline": -b_hat * dt},
        "delta_fit": {"x": domega[tr], "y": r0[tr] - r0[tr].mean(),
                      "slope": float(c_shift[1]),
                      "title": f"DELTA SIGNATURE: D={d_hat:.4f}+/-{se_d:.4f}S"},
        "tilt": {"x_tr": dx[tr], "y_tr": dy[tr], "x_he": dx[he], "y_he": dy[he],
                 "phi": phi_hat},
        "obs": {"ids": obs["segment_id"].tolist(),
                "scores": obs["observability_score"].tolist()},
        "hist": {"res": res_yaw},
        "sign": {"vals": [rms_trans_held, rms_trans_wrong, exp_wrong],
                 "labels": ["ADOPTED SIGN", "WRONG SIGN", "2SIN(PHI)*MEAN(DX)"]},
    }
    try:
        import matplotlib
        matplotlib.use("Agg")
        import matplotlib.pyplot as plt

        fig, axes = plt.subplots(2, 3, figsize=(16, 9))
        ax = axes[0, 0]
        ax.plot(tm[tr], r0[tr], ".", ms=3, label="train")
        ax.plot(tm[he], r0[he], ".", ms=3, label="heldout")
        ax.axhline(-b_hat * dt, color="k", ls="--", label=f"-b*dt = {-b_hat*dt:.4e}")
        ax.set_xlabel("time (s)"); ax.set_ylabel("dyaw - int(omega) (rad)")
        ax.set_title("Yaw residual vs time (zero shift)"); ax.legend(fontsize=8)

        ax = axes[0, 1]
        ax.plot(domega[tr], r0[tr] - r0[tr].mean(), ".", ms=3)
        dd = np.linspace(domega.min(), domega.max(), 10)
        ax.plot(dd, c_shift[1] * dd, "r-", label=f"slope={c_shift[1]:.4f}")
        ax.set_xlabel("omega(t1)-omega(t0) (rad)")
        ax.set_ylabel("centred yaw residual (rad)")
        ax.set_title(f"delta signature: d_hat={d_hat:.4f} +/- {se_d:.4f} s")
        ax.legend(fontsize=8)

        ax = axes[0, 2]
        ax.plot(dx[tr], dy[tr], ".", ms=3, label="train")
        ax.plot(dx[he], dy[he], ".", ms=3, label="heldout")
        xs = np.linspace(0, dx.max(), 10)
        ax.plot(xs, -np.tan(phi_hat) * xs, "r-", label=f"tilt -> phi={phi_hat:.4f} rad")
        ax.set_xlabel("dx_lidar (m)"); ax.set_ylabel("dy_lidar (m)")
        ax.set_title("Translation tilt (extrinsic)"); ax.legend(fontsize=8)

        ax = axes[1, 0]
        ax.bar(obs["segment_id"].astype(str), obs["observability_score"], color="C0")
        ax.set_xlabel("segment_id"); ax.set_ylabel("observability score")
        ax.set_title("Per-segment observability (train rows only)")

        ax = axes[1, 1]
        ax.hist(res_yaw, bins=25, color="C1", alpha=0.8)
        ax.set_xlabel("held-out yaw residual (rad)"); ax.set_ylabel("count")
        ax.set_title(f"Held-out yaw residuals (RMS={rms_yaw_held:.4f})")

        ax = axes[1, 2]
        vals = [rms_trans_held, rms_trans_wrong, exp_wrong]
        ax.bar(["adopted sign", "wrong sign", "2sin(phi)*mean(dx)"], vals,
               color=["C2", "C3", "C4"])
        ax.set_ylabel("mean perpendicular trans misfit (m)")
        ax.set_title("Extrinsic sign self-consistency check")
        for i, v_ in enumerate(vals):
            ax.text(i, v_, f"{v_:.4f}", ha="center", va="bottom", fontsize=9)

        fig.suptitle("Multi-sensor motion record audit - calibration diagnostics",
                     fontsize=13)
        fig.tight_layout(rect=(0, 0, 1, 0.96))
        fig.savefig(OUT / "calibration_diagnostics.png", dpi=130)
        plt.close(fig)
        backend = "matplotlib"
    except ImportError:
        render_fallback_png(fig_data, OUT / "calibration_diagnostics.png")
        backend = "numpy-fallback"

    print("diagnostics backend:", backend)
    print("calibration:", {"gyro_bias_rad_s": b_hat, "time_offset_s": d_hat,
                           "yaw_extrinsic_rad": phi_hat})
    print("SEs:", errs)
    print("observability:\n", obs.to_string(index=False))
    print("heldout RMS yaw", rms_yaw_held, "| mean perp trans", rms_trans_held,
          "| wrong-sign", rms_trans_wrong, "| expected wrong", exp_wrong)
    print("AIC:", json.dumps(aic_table, indent=1))
    print("self band scores:", self_scores)


