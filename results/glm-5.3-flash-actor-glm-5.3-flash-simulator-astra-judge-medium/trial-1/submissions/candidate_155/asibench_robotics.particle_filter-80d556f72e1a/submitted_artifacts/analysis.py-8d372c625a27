# Panel rendering (numpy raster + 5x7 bitmap font)
# ----------------------------------------------------------------------------
def draw_text(canvas, x, y, text, color, scale=2):
    for ch in text.upper():
        glyph = FONT.get(ch, FONT[' '])
        for r, rowbits in enumerate(glyph):
            for c, bit in enumerate(rowbits):
                if bit == '1':
                    y0 = y + r * scale
                    x0 = x + c * scale
                    canvas[y0:y0 + scale, x0:x0 + scale] = color
        x += 6 * scale


class Panel:
    def __init__(self, canvas, x0, y0, w, h, xlim, ylim, xlabel="", title=""):
        self.c = canvas
        self.x0, self.y0, self.w, self.h = x0, y0, w, h
        self.xlim, self.ylim = xlim, ylim
        self.xlabel, self.title = xlabel, title
        # frame
        canvas[y0:y0 + h, x0] = 60
        canvas[y0:y0 + h, x0 + w - 1] = 60
        canvas[y0, x0:x0 + w] = 60
        canvas[y0 + h - 1, x0:x0 + w] = 60
        # ticks (5 evenly spaced)
        for i in range(5):
            frac = i / 4.0
            xt = x0 + int(frac * (w - 1))
            yt = y0 + h - 1 - int(frac * (h - 1))
            canvas[y0 + h - 1: y0 + h + 3, xt] = 60
            canvas[yt - 2:yt + 1, x0 - 3:x0] = 60
            lo, hi = ylim
            v = lo + frac * (hi - lo)
            draw_text(canvas, x0 - 34, yt - 3, f"{v:.1f}" if abs(v) >= 0.1 else f"{v:.2f}", 60, 1)
            lo2, hi2 = xlim
            v2 = lo2 + frac * (hi2 - lo2)
            draw_text(canvas, xt - 8, y0 + h + 4, f"{v2:.0f}", 60, 1)
        if xlabel:
            draw_text(canvas, x0 + w // 2 - 3 * len(xlabel), y0 + h + 14, xlabel, 60, 1)
        if title:
            draw_text(canvas, x0, y0 - 12, title, 0, 2)

    def to_px(self, xs, ys):
        lo, hi = self.xlim
        lo2, hi2 = self.ylim
        fx = (np.asarray(xs, dtype=float) - lo) / max(hi - lo, 1e-12)
        fy = (np.asarray(ys, dtype=float) - lo2) / max(hi2 - lo2, 1e-12)
        fx = np.clip(fx, -0.02, 1.02)
        fy = np.clip(fy, -0.02, 1.02)
        px = self.x0 + 1 + fx * (self.w - 3)
        py = self.y0 + self.h - 2 - fy * (self.h - 3)
        return px, py

    def line(self, xs, ys, color, thick=1):
        px, py = self.to_px(xs, ys)
        for j in range(len(px) - 1):
            n = max(int(max(abs(px[j + 1] - px[j]), abs(py[j + 1] - py[j]))) + 1, 2)
            xsamp = np.linspace(px[j], px[j + 1], n)
            ysamp = np.linspace(py[j], py[j + 1], n)
            xi = np.clip(np.round(xsamp).astype(int), self.x0 + 1, self.x0 + self.w - 2)
            yi = np.clip(np.round(ysamp).astype(int), self.y0 + 1, self.y0 + self.h - 2)
            if thick <= 1:
                self.c[yi, xi] = color
            else:
                for o in range(thick):
                    self.c[np.clip(yi + o, 0, self.c.shape[0] - 1), xi] = color

    def dots(self, xs, ys, color, s=2):
        px, py = self.to_px(xs, ys)
        xi = np.clip(np.round(px).astype(int), self.x0 + 1, self.x0 + self.w - 2)
        yi = np.clip(np.round(py).astype(int), self.y0 + 1, self.y0 + self.h - 2)
        self.c[yi, xi] = color
        if s > 1:
            self.c[np.clip(yi + 1, 0, self.c.shape[0] - 1), xi] = color


def make_overview(t, Y, mask, ref, res, out_path):
    """2x2 panels: (1) trajectory, (2) range fit, (3) bearing fit,
    (4) ESS + resampling + NEES proxy."""
    W, H = 1280, 980
    canvas = np.full((H, W), 255, dtype=np.uint8)
    pw, ph = 560, 400
    positions = [(70, 120), (680, 120), (70, 580), (680, 580)]

    # Panel 1: trajectory
    p1 = Panel(canvas, *positions[0], pw, ph,
               xlim=(min(ref["x"].min(), res["est"][:, 0].min()) - 0.4,
                     max(ref["x"].max(), res["est"][:, 0].max()) + 0.4),
               ylim=(min(ref["y"].min(), res["est"][:, 1].min()) - 0.4,
                     max(ref["y"].max(), res["est"][:, 1].max()) + 0.4),
               xlabel="PX", title="TRAJECTORY: PF MEAN VS REF")
    # reference as gray dots, PF mean as dark line
    step = 2
    p1.dots(ref["x"][::step], ref["y"][::step], 150)
    p1.line(res["est"][:, 0], res["est"][:, 1], 20, thick=2)
    draw_text(canvas, positions[0][0] + 10, positions[0][1] + ph - 28,
              "GRAY DOTS: REF", 150, 1)
    draw_text(canvas, positions[0][0] + 10, positions[0][1] + ph - 14,
              "DARK: PF MEAN", 20, 1)

    # Panel 2: range
    mv = mask[:, 0]
    p2 = Panel(canvas, *positions[1], pw, ph, xlim=(t[0], t[-1]),
               ylim=(0.0, float(Y[:, 0][mv].max()) * 1.15),
               xlabel="T", title="RANGE: MEAS VS PF PRED")
    r_pred = np.hypot(res["est"][:, 0], res["est"][:, 1])
    ti = np.where(mv)[0]
    p2.dots(t[ti], Y[ti, 0], 150)
    p2.line(t, r_pred, 200, thick=2)
    draw_text(canvas, positions[1][0] + 10, positions[1][1] + ph - 28,
              "GRAY: MEAS (GAPS SKIPPED)", 150, 1)
    draw_text(canvas, positions[1][0] + 10, positions[1][1] + ph - 14,
              "DARK: PF PREDICTED", 200, 1)

    # Panel 3: bearing
    mbv = mask[:, 1]
    p3 = Panel(canvas, *positions[2], pw, ph, xlim=(t[0], t[-1]),
               ylim=(-np.pi - 0.2, np.pi + 0.2),
               xlabel="T", title="BEARING: MEAS VS PF PRED")
    b_pred = wrap_angle(np.arctan2(res["est"][:, 1], res["est"][:, 0]))
    ti = np.where(mbv)[0]
    p3.dots(t[ti], Y[ti, 1], 150)
    p3.line(t, b_pred, 200, thick=2)
    draw_text(canvas, positions[2][0] + 10, positions[2][1] + ph - 14,
              "WRAP-AWARE; GAPS SKIPPED", 150, 1)

    # Panel 4: ESS + resampling + NEES proxy
    p4 = Panel(canvas, *positions[3], pw, ph, xlim=(t[0], t[-1]),
               ylim=(0.0, N_PARTICLES * 1.05),
               xlabel="T", title="ESS, RESAMPLING, NEES PROXY (X100)")
    p4.line(t, res["diag"]["ess"], 20, thick=2)
    nees100 = np.clip(res["diag"]["nees"], 0, N_PARTICLES) 
    p4.line(t, nees100, 0, thick=1)
    rs = np.where(res["diag"]["resampled"] > 0)[0]
    for i in rs:
        xi = p4.to_px(np.array([t[i]]), np.array([0.0]))[0][0]
        xi = int(np.clip(xi, p4.x0 + 1, p4.x0 + p4.w - 2))
        canvas[p4.y0:p4.y0 + 12, xi] = 200
    draw_text(canvas, positions[3][0] + 10, positions[3][1] + ph - 42,
              "DARK: ESS", 20, 1)
    draw_text(canvas, positions[3][0] + 10, positions[3][1] + ph - 28,
              "BLACK: NEESX100", 0, 1)
    draw_text(canvas, positions[3][0] + 10, positions[3][1] + ph - 14,
              "TICKS: RESAMPLE", 200, 1)

    return write_png(out_path, np.repeat(canvas[:, :, None], 3, axis=2))


# ----------------------------------------------------------------------------
# Finite-value sanitization
# ----------------------------------------------------------------------------
def finite(a, fallback=0.0):
    a = np.asarray(a, dtype=float).copy()
    bad = ~np.isfinite(a)
    if bad.any():
        a[bad] = fallback
    return a


def sanitize_df(df):
    for c in df.columns:
        df[c] = finite(df[c].to_numpy(dtype=float), 0.0)
    return df


