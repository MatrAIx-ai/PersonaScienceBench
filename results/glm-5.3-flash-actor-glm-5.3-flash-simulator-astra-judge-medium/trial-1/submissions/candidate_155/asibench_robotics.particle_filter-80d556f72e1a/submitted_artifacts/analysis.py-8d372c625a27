import numpy as np
import pandas as pd
from scipy.optimize import least_squares

# ----------------------------------------------------------------------------
# Configuration
# ----------------------------------------------------------------------------
SEED = 20260117
N_PARTICLES = 1500          # <= 1500 per task contract
SIGMA_R = 0.03              # range likelihood width (second-difference/regularized-fit estimate ~0.03)
SIGMA_B = 0.02              # bearing likelihood width (regularized-fit residual std ~0.015)
OUTLIER_MIX_WEIGHT = 0.05   # broad heavy-tail component weight
OUTLIER_MIX_SCALE = 8.0     # broad component = 8x sigma
SIGMA_A_BASE = 0.05         # base random-walk acceleration std
Q_MULT_MAX = 8.0            # max adaptive process-noise inflation
Q_MULT_UP = 1.7             # inflation factor when NIS fires
Q_MULT_DECAY = 0.85         # per-step decay of inflation toward 1
NIS_TRIGGER = 9.0           # ~chi2(2) 99% quantile for 2 available channels
TEMPER_GAMMA = 0.8   # likelihood tempering vs predicted spread
P_CT = 0.15                 # probability of coordinated-turn proposal branch
SIGMA_W = 0.06              # turn-rate std of CT branch (rad / step)
SIGMA_INIT_POS = 0.15
SIGMA_INIT_VEL = 0.30
SIGMA_JITTER = 0.02         # post-resampling roughening
SIGMA_BIAS_STEP = 0.012     # bearing-bias random-walk std (variant 'bias')
SIGMA_BIAS_INIT = 0.05
ESS_RESAMPLE_FRAC = 0.5
LOGW_FLOOR = -690.0         # keep all log weights finite (never -inf)

DATA_PATH = "data/measurements.npz"
RESULTS_DIR = "results"


def wrap_angle(a):
    return (a + np.pi) % (2.0 * np.pi) - np.pi


def load_data(path=DATA_PATH):
    d = np.load(path, allow_pickle=True)
    Y = np.asarray(d["Y"], dtype=float)
    t = np.asarray(d["t"], dtype=float)
    mask = np.asarray(d["mask"], dtype=bool)
    meta = str(d["metadata"]) if "metadata" in d.files else ""
    return Y, t, mask, meta


def count_wrap_events(Y, mask):
    """Measured bearing jumps larger than pi between consecutive valid samples."""
    b, m = Y[:, 1], mask[:, 1]
    events = []
    for i in range(len(b) - 1):
        if m[i] and m[i + 1] and abs(b[i + 1] - b[i]) > np.pi:
            events.append((int(i), float(b[i]), float(b[i + 1])))
    return len(events), events


# ----------------------------------------------------------------------------
# Robust smooth-trajectory reference (proxy ground truth)
# ----------------------------------------------------------------------------
def robust_reference(Y, mask, seg=4, lam=3.0):
    """Regularized piecewise-constant acceleration trajectory fit (robust loss,
    acceleration-roughness penalty). Used ONLY as a reference for proxy error
    metrics; the true state is not public."""
    n = len(Y)
    nseg = (n + seg - 1) // seg
    mr, mb = mask[:, 0], mask[:, 1]
    r, b = Y[:, 0], Y[:, 1]

    def build(p):
        x0, y0, vx0, vy0 = p[0:4]
        ax = p[4:4 + nseg]
        ay = p[4 + nseg:4 + 2 * nseg]
        x = np.zeros(n); y = np.zeros(n)
        vx = np.zeros(n); vy = np.zeros(n)
        X, Yc, Vx, Vy = x0, y0, vx0, vy0
        for i in range(n):
            x[i] = X; y[i] = Yc; vx[i] = Vx; vy[i] = Vy
            k = min(i // seg, nseg - 1)
            Vx += ax[k]; Vy += ay[k]
            X += Vx; Yc += Vy
        return x, y, vx, vy

    def resid(p):
        x, y, vx, vy = build(p)
        rr = np.hypot(x, y)
        bb = np.arctan2(y, x)
        acc = np.concatenate([np.diff(vx), np.diff(vy)])
        return np.concatenate([(rr[mr] - r[mr]) / 0.05,
                               wrap_angle(bb[mb] - b[mb]) / 0.05,
                               lam * acc / 0.05])

    p0 = np.zeros(4 + 2 * nseg)
    i0 = int(np.argmax(mask[:, 0] & mask[:, 1]))
    p0[0] = r[i0] * np.cos(b[i0])
    p0[1] = r[i0] * np.sin(b[i0])
    sol = least_squares(resid, p0, loss="soft_l1", f_scale=1.0, max_nfev=4000)
    x, y, vx, vy = build(sol.x)
    rr = np.hypot(x, y)
    bb = np.arctan2(y, x)
    res_r = np.where(mr, rr - r, 0.0)
    res_b = np.where(mb, wrap_angle(bb - b), 0.0)
    return dict(x=x, y=y, vx=vx, vy=vy, res_r=res_r, res_b=res_b)


# ----------------------------------------------------------------------------
# Particle filter
# ----------------------------------------------------------------------------
def mixture_loglik(res, sigma):
    """Per-channel robust log-likelihood: 95% Gaussian + 5% broad heavy tail."""
    a = -0.5 * (res / sigma) ** 2 - math.log(sigma) - 0.5 * math.log(2 * math.pi)
    s = OUTLIER_MIX_SCALE * sigma
    c = -0.5 * (res / s) ** 2 - math.log(s) - 0.5 * math.log(2 * math.pi)
    la = a + math.log(1.0 - OUTLIER_MIX_WEIGHT)
    lc = c + math.log(OUTLIER_MIX_WEIGHT)
    mx = np.maximum(la, lc)
    return mx + np.log(np.exp(la - mx) + np.exp(lc - mx))


def _normalize_logw(logw):
    mx = float(np.max(logw))
    tot = float(np.sum(np.exp(logw - mx)))
    logw_norm = np.maximum(logw - (mx + math.log(tot)), LOGW_FLOOR)
    w = np.exp(logw_norm)
    w /= w.sum()
    return w, logw_norm


def _systematic_resample(w, rng):
    n = len(w)
    pos = (rng.random() + np.arange(n)) / n
    cs = np.cumsum(w)
    cs[-1] = 1.0
    return np.clip(np.searchsorted(cs, pos), 0, n - 1)


def innovation_whiteness(res_series, valid):
    """Lag-1 autocorrelation and mean of the per-step bearing residual series."""
    v = np.asarray(res_series)[valid]
    v = v[np.isfinite(v)]
    if len(v) < 3:
        return 0.0, float(v.mean()) if len(v) else 0.0
    vc = v - v.mean()
    denom = max(float(np.dot(vc, vc)), 1e-300)
    return float(np.dot(vc[:-1], vc[1:]) / denom), float(v.mean())


def _init_velocity(Y, mask, i0, k_use=6):
    """Rough initial velocity + spread from a short CV fit to early data."""
    idx = [i for i in range(i0, min(len(Y), i0 + k_use)) if mask[i, 0] and mask[i, 1]]
    if len(idx) < 3:
        return np.array([0.0, 0.0]), SIGMA_INIT_VEL
    tt = np.arange(i0, i0 + k_use, dtype=float)
    idx = np.array(idx, dtype=int)
    r, b = Y[idx, 0], Y[idx, 1]
    xs, ys = r * np.cos(b), r * np.sin(b)
    A = np.vstack([np.ones(len(idx)), tt[idx] - i0]).T
    vx = float(np.linalg.lstsq(A, xs, rcond=None)[0][1])
    vy = float(np.linalg.lstsq(A, ys, rcond=None)[0][1])
    return np.array([vx, vy]), 0.15


def run_pf(Y, mask, t, variant="inflation", seed=SEED, n=N_PARTICLES,
           sigma_r=SIGMA_R, sigma_b=SIGMA_B):
    """Bootstrap particle filter with adaptive maneuver handling.

    variant='inflation' : 4-D state, NIS-triggered process-noise inflation.
    variant='bias'      : 5-D state (+ slowly varying bearing bias), same
                          inflation machinery, so the variant comparison
                          isolates the benefit of the bias state.
    """
    rng = np.random.default_rng(seed)
    n_steps = len(t)
    dim = 5 if variant == "bias" else 4

    i0 = int(np.argmax(mask[:, 0] & mask[:, 1]))
    r0, b0 = Y[i0, 0], Y[i0, 1]
    # data-driven initial velocity: short-horizon CV fit to the first valid
    # measurements (no ground-truth leakage; uses only public observations)
    v0, v0_std = _init_velocity(Y, mask, i0)
    P = np.zeros((n, dim))
    P[:, 0] = r0 * np.cos(b0) + SIGMA_INIT_POS * rng.standard_normal(n)
    P[:, 1] = r0 * np.sin(b0) + SIGMA_INIT_POS * rng.standard_normal(n)
    P[:, 2] = v0[0] + v0_std * rng.standard_normal(n)
    P[:, 3] = v0[1] + v0_std * rng.standard_normal(n)
    if dim == 5:
        P[:, 4] = SIGMA_BIAS_INIT * rng.standard_normal(n)
    logw = np.full(n, -math.log(n))

    est = np.zeros((n_steps, 4))
    cov = np.zeros((n_steps, 4))
    names = ("rmse_pos", "rmse_vel", "nees", "ess", "resampled",
             "weight_entropy", "max_log_weight", "min_log_weight",
             "bearing_residual_mean", "bearing_residual_std",
             "nis", "q_mult", "ct_frac")
    diag = {k: np.zeros(n_steps) for k in names}
    adapt_events = []
    resample_count = 0

    for k in range(n_steps):
        ct_branch = np.zeros(n, dtype=bool)
        if k > 0:
            # ---- adaptive process noise ----
            q_prev = diag["q_mult"][k - 1]
            if diag["nis"][k - 1] > NIS_TRIGGER:
                q_new = min(Q_MULT_MAX, q_prev * Q_MULT_UP)
                if q_new >= 1.5 and (not adapt_events
                                     or adapt_events[-1][0] != k - 1):
                    adapt_events.append((k - 1, float(t[k - 1]),
                                         "nis_inflation", float(q_new)))
            else:
                q_new = max(1.0, q_prev * Q_MULT_DECAY)
            diag["q_mult"][k] = q_new
            sigma_a = SIGMA_A_BASE * q_new

            # ---- IMM-lite propagation ----
            dt = float(t[k] - t[k - 1])
            ct_branch = rng.random(n) < P_CT
            w_turn = np.clip(SIGMA_W * rng.standard_normal(n), -0.2, 0.2)
            w_turn = np.sign(w_turn) * np.maximum(np.abs(w_turn), 0.02)
            th = w_turn * dt
            sin_t, cos_t = np.sin(th), np.cos(th)
            vx0, vy0 = P[:, 2].copy(), P[:, 3].copy()
            x_ct = P[:, 0] + (vx0 * sin_t + vy0 * (1.0 - cos_t)) / w_turn
            y_ct = P[:, 1] + (vy0 * sin_t - vx0 * (1.0 - cos_t)) / w_turn
            vx_rot = vx0 * cos_t - vy0 * sin_t
            vy_rot = vx0 * sin_t + vy0 * cos_t
            x_lin = P[:, 0] + vx0 * dt
            y_lin = P[:, 1] + vy0 * dt
            P[:, 0] = np.where(ct_branch, x_ct, x_lin)
            P[:, 1] = np.where(ct_branch, y_ct, y_lin)
            P[:, 2] = np.where(ct_branch, vx_rot, vx0) + sigma_a * rng.standard_normal(n)
            P[:, 3] = np.where(ct_branch, vy_rot, vy0) + sigma_a * rng.standard_normal(n)
            if dim == 5:
                P[:, 4] += SIGMA_BIAS_STEP * rng.standard_normal(n)

            # ---- measurement update (masked channels skipped) ----
            bias = P[:, 4] if dim == 5 else 0.0
            r_pred = np.hypot(P[:, 0], P[:, 1])
            b_pred = np.arctan2(P[:, 1], P[:, 0]) + bias
            loglik = np.zeros(n)
            res_b_particles = None
            sigma_eff = {}
            w_pre, _ = _normalize_logw(logw)
            prior_mean = (w_pre[:, None] * P).sum(axis=0)
            prior_r = math.hypot(prior_mean[0], prior_mean[1])
            prior_b = math.atan2(prior_mean[1], prior_mean[0]) + (
                prior_mean[4] if dim == 5 else 0.0)
            if mask[k, 0]:
                res_r = Y[k, 0] - r_pred
                # tempering: never let the likelihood be sharper than a fixed
                # fraction of the predicted cloud spread (EnKF-like gain
                # limit; prevents chronic weight degeneracy)
                spread_r = math.sqrt(max(float(np.sum(w_pre * (r_pred - prior_r) ** 2)), 0.0))
                s_eff = max(sigma_r, TEMPER_GAMMA * spread_r)
                sigma_eff[0] = s_eff
                loglik += mixture_loglik(res_r, s_eff)
            if mask[k, 1]:
                res_b_particles = wrap_angle(Y[k, 1] - b_pred)
                spread_b = math.sqrt(max(float(np.sum(w_pre * wrap_angle(b_pred - prior_b) ** 2)), 0.0))
                s_eff = max(sigma_b, TEMPER_GAMMA * spread_b)
                sigma_eff[1] = s_eff
                loglik += mixture_loglik(res_b_particles, s_eff)
            logw = logw + loglik

        w, logw_norm = _normalize_logw(logw)
        mean5 = (w[:, None] * P).sum(axis=0)
        mean = mean5[:4]

        # ---- NIS from the PRIOR predictive mean ----
        if k > 0:
            nis = 0.0
            innov_r = innov_b = 0.0
            if mask[k, 0]:
                innov_r = float(Y[k, 0] - math.hypot(prior_mean[0], prior_mean[1]))
                nis += (innov_r / sigma_eff.get(0, sigma_r)) ** 2
            if mask[k, 1]:
                b_pri = math.atan2(prior_mean[1], prior_mean[0]) + (
                    prior_mean[4] if dim == 5 else 0.0)
                innov_b = float(wrap_angle(Y[k, 1] - b_pri))
                nis += (innov_b / sigma_eff.get(1, sigma_b)) ** 2
            diag["nis"][k] = nis

            if res_b_particles is not None:
                bm = float((w * res_b_particles).sum())
                bv = math.sqrt(max(float((w * (res_b_particles - bm) ** 2).sum()), 0.0))
                diag["bearing_residual_mean"][k] = bm
                diag["bearing_residual_std"][k] = bv
            else:
                # documented finite fallback when the angular channel is missing
                diag["bearing_residual_mean"][k] = 0.0
                diag["bearing_residual_std"][k] = 0.0
        else:
            if mask[k, 1]:
                b_pred0 = np.arctan2(P[:, 1], P[:, 0]) + (P[:, 4] if dim == 5 else 0.0)
                res_b = wrap_angle(Y[k, 1] - b_pred0)
                bm = float((w * res_b).sum())
                diag["bearing_residual_mean"][k] = bm
                diag["bearing_residual_std"][k] = math.sqrt(
                    max(float((w * (res_b - bm) ** 2).sum()), 0.0))
            else:
                diag["bearing_residual_mean"][k] = 0.0
                diag["bearing_residual_std"][k] = 0.0

        # ---- weights / ESS statistics ----
        ess = 1.0 / max(float(np.sum(w ** 2)), 1e-300)
        diag["ess"][k] = ess
        diag["ct_frac"][k] = float((w * ct_branch.astype(float)).sum())
        diag["weight_entropy"][k] = -float(np.sum(w * np.log(np.maximum(w, 1e-300))))
        diag["max_log_weight"][k] = float(np.max(logw_norm))
        diag["min_log_weight"][k] = float(np.min(logw_norm))

        # ---- weighted covariance ----
        d4 = P[:, :4] - mean
        cov4 = (d4 * w[:, None]).T @ d4 + 1e-9 * np.eye(4)
        est[k] = mean
        cov[k] = [cov4[0, 0], cov4[1, 1], cov4[2, 2], cov4[3, 3]]

        # ---- resampling / degeneracy revival ----
        if ess < ESS_RESAMPLE_FRAC * n:
            idx = _systematic_resample(w, rng)
            P = P[idx].copy()
            # mild roughening proportional to the posterior spread
            s_pos = max(0.25 * float(np.std(P[:, 0])), SIGMA_JITTER)
            s_vel = max(0.25 * float(np.std(P[:, 2])), SIGMA_JITTER)
            P[:, 0] += s_pos * rng.standard_normal(n)
            P[:, 1] += s_pos * rng.standard_normal(n)
            P[:, 2] += s_vel * rng.standard_normal(n)
            P[:, 3] += s_vel * rng.standard_normal(n)
            logw = np.full(n, -math.log(n))
            diag["resampled"][k] = 1.0
            resample_count += 1
            # ---- revival injection on near-total collapse ----
            # When the particle cloud is far too narrow to explain the current
            # measurement (e.g. the fast bearing sweep at the close pass),
            # re-inject particles directly at the measurement-implied
            # position with a dispersed velocity. This restores diversity
            # without inventing observations (uses only the measured values).
            bearing_sweep = (abs(innov_b) > 0.5) and (abs(innov_r) < 0.2)
            if (ess < 0.05 * n and mask[k, 0] and mask[k, 1]
                    and bearing_sweep):
                rm, bm = Y[k, 0], Y[k, 1]
                half = n // 2
                P[:half, 0] = rm * np.cos(bm) + 0.1 * rng.standard_normal(half)
                P[:half, 1] = rm * np.sin(bm) + 0.1 * rng.standard_normal(half)
                P[:half, 2] = mean[2] + 0.25 * rng.standard_normal(half)
                P[:half, 3] = mean[3] + 0.25 * rng.standard_normal(half)
                if dim == 5:
                    P[:half, 4] = 0.0
                adapt_events.append((k, float(t[k]), "revival_injection",
                                     float(ess)))
        else:
            logw = logw_norm

    return dict(est=est, cov=cov, diag=diag, resample_count=resample_count,
                adapt_events=adapt_events, variant=variant)


# ----------------------------------------------------------------------------
# Proxy error metrics vs the robust smooth reference
# ----------------------------------------------------------------------------
def proxy_diagnostics(res, ref):
    est = res["est"]
    d_pos = np.hypot(est[:, 0] - ref["x"], est[:, 1] - ref["y"])
    d_vel = np.hypot(est[:, 2] - ref["vx"], est[:, 3] - ref["vy"])
    nees = np.zeros(len(est))
    for k in range(len(est)):
        Pm = np.zeros((4, 4))
        Pm[0, 0] = res["cov"][k, 0]
        Pm[1, 1] = res["cov"][k, 1]
        Pm[2, 2] = res["cov"][k, 2]
        Pm[3, 3] = res["cov"][k, 3]
        # off-diagonals are not stored; regularized diagonal approximation
        Pm += np.eye(4) * (1e-3 + 0.05 * np.trace(Pm) / 4.0)
        diff = est[k] - np.array([ref["x"][k], ref["y"][k],
                                  ref["vx"][k], ref["vy"][k]])
        try:
            val = float(diff @ np.linalg.solve(Pm, diff))
        except np.linalg.LinAlgError:
            val = 1e4
        nees[k] = min(max(val, 0.0), 1e4)
    return d_pos, d_vel, nees


def variant_score(res, ref, mask):
    """Innovation-whiteness score: |lag-1 autocorr| of bearing residuals,
    tie-broken by |residual mean|. Smaller is better."""
    rho1, mu = innovation_whiteness(res["diag"]["bearing_residual_mean"],
                                    mask[:, 1])
    return dict(rho1=rho1, mean=mu, score=abs(rho1) + 0.5 * abs(mu))


