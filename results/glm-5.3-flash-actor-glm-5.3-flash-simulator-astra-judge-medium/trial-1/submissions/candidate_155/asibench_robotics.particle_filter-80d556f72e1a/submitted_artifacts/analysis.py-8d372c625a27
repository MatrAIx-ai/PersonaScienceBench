def write_png(path, rgb):
    """Minimal PNG encoder: 8-bit RGB, filter type 0 per row."""
    h, w, _ = rgb.shape
    raw = b"".join(b"\x00" + rgb[i].tobytes() for i in range(h))
    comp = zlib.compress(raw, 6)

    def chunk(typ, data):
        return (struct.pack(">I", len(data)) + typ + data
                + struct.pack(">I", zlib.crc32(typ + data) & 0xFFFFFFFF))

    png = (b"\x89PNG\r\n\x1a\n"
           + chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0))
           + chunk(b"IDAT", comp)
           + chunk(b"IEND", b""))
    with open(path, "wb") as f:
        f.write(png)
    return len(png)


def verify_png(path):
    """Re-parse the PNG and verify structure + decode the raster."""
    with open(path, "rb") as f:
        data = f.read()
    assert data[:8] == b"\x89PNG\r\n\x1a\n", "bad PNG signature"
    pos, idat, ihdr, iend = 8, b"", None, False
    while pos < len(data):
        (ln,) = struct.unpack(">I", data[pos:pos + 4])
        typ = data[pos + 4:pos + 8]
        payload = data[pos + 8:pos + 8 + ln]
        (crc,) = struct.unpack(">I", data[pos + 8 + ln:pos + 12 + ln])
        assert crc == (zlib.crc32(typ + payload) & 0xFFFFFFFF), "bad CRC"
        if typ == b"IHDR":
            ihdr = struct.unpack(">IIBBBBB", payload)
        elif typ == b"IDAT":
            idat += payload
        elif typ == b"IEND":
            iend = True
        pos += 12 + ln
    assert ihdr is not None and iend, "missing IHDR/IEND"
    w, h, depth, ctype, _, _, _ = ihdr
    assert depth == 8 and ctype == 2, "unexpected pixel format"
    raw = zlib.decompress(idat)
    assert len(raw) == h * (w * 3 + 1), "decompressed size mismatch"
    stride = w * 3
    rows = []
    for i in range(h):
        row = raw[i * (stride + 1):(i + 1) * (stride + 1)]
        assert row[0] == 0, "unexpected row filter"
        rows.append(np.frombuffer(row[1:], dtype=np.uint8))
    rgb = np.stack(rows).reshape(h, w, 3)
    return dict(width=w, height=h, size_bytes=len(data), raster=rgb)


