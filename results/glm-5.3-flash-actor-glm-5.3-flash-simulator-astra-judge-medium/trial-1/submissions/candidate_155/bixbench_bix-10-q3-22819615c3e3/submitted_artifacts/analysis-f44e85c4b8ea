# Main analysis: TASK008 BCG-CORONA
# Question: In which patients_seen group do BCG vs Placebo differ significantly
# (p<0.05, chi-square) in COVID-19 severity?
import numpy as np
import pandas as pd
from scipy import stats

dm = pd.read_csv('data/TASK008_BCG-CORONA_DM.csv')
ae = pd.read_csv('data/TASK008_BCG-CORONA_AE.csv', encoding='latin-1')

# ---- 1. Build per-subject COVID-19 severity (max AESEV among COVID-related AEs)
mask = ae.AEPT.astype(str).str.lower().str.contains('covid|sars')
cov = ae[mask].copy()
n_covid_records = len(cov)
n_missing_sev_records = cov.AESEV.isna().sum()

# per subject: max severity over non-missing; subjects with only-missing severity excluded
per = (cov.dropna(subset=['AESEV'])
          .groupby('USUBJID')
          .AESEV.max()
          .rename('severity')
          .reset_index())
sub = per.merge(dm[['USUBJID','TRTGRP','patients_seen']], on='USUBJID', how='left')
n_subj_any_covid = cov.USUBJID.nunique()
n_subj_used = sub.USUBJID.nunique()
n_subj_excl_all_missing = cov[~cov.USUBJID.isin(per.USUBJID)].USUBJID.nunique()

print('='*70)
print('DATA CONSTRUCTION')
print(f'COVID-related AE records: {n_covid_records} (subjects: {n_subj_any_covid})')
print(f'  records with missing AESEV (excluded): {n_missing_sev_records}')
print(f'  subjects with NO non-missing AESEV (excluded from main analysis): {n_subj_excl_all_missing}')
print(f'Subjects in main analysis (severity known): {n_subj_used}')
print('Severity distribution (main analysis):')
print(sub.severity.value_counts().sort_index().to_string())

groups = ['1-50', '51-100', '>100']

def report_table(tab, label):
    print('-'*70)
    print(label)
    print(tab.to_string())
    chi2, p, dof, exp = stats.chi2_contingency(tab, correction=False)
    n_small = int((exp < 5).sum())
    print(f'Pearson chi2={chi2:.4f}, dof={dof}, p={p:.4f} | cells with expected<5: {n_small}/{exp.size}')
    line = (label, chi2, p, n_small, exp.size)
    return line, exp, p

results = {}

# ---- 2. MAIN ANALYSIS: chi-square TRTGRP x severity (levels 1-4 as observed) per group
print('\n' + '='*70)
print('MAIN ANALYSIS: TRTGRP x COVID-19 severity (AESEV max, levels as observed)')
main_rows = []
for g in groups:
    d = sub[sub.patients_seen == g]
    tab = pd.crosstab(d.TRTGRP, d.severity)
    row, exp, p = report_table(tab, f'Group {g} (n={len(d)})')
    main_rows.append((g, row[1], row[2], row[3], row[4], tab))
    results[g] = {'main_p_pearson': p}
print('\nMAIN SUMMARY (chi-square, uncorrected Pearson = primary判定):')
for g, chi2, p, ns, ne, tab in main_rows:
    print(f'  patients_seen={g}: chi2={chi2:.4f}, p={p:.4f}, cells expected<5: {ns}/{ne} -> {"SIGNIFICANT" if p<0.05 else "ns"}')

# ---- 3. Fisher exact + Yates as supplement (2x2 binary merges)
print('\n' + '='*70)
print('SUPPLEMENT: binary merges with Fisher exact and Yates-corrected chi2')
for name, fn in [('Mild(1) vs Moderate+ (2-4)', lambda s: np.where(s == 1, 'mild', 'mod+')),
                 ('Non-severe (1-2) vs Severe (3-4)', lambda s: np.where(s <= 2, 'nonsev', 'sev+'))]:
    print(f'\n--- {name}')
    sub2 = sub.copy()
    sub2['bin'] = fn(sub2.severity)
    for g in groups:
        d = sub2[sub2.patients_seen == g]
        tab = pd.crosstab(d.TRTGRP, d.bin)
        chi2p, pp, _, _ = stats.chi2_contingency(tab, correction=False)
        chi2y, py, _, _ = stats.chi2_contingency(tab, correction=True)
        orr, pf = stats.fisher_exact(tab)
        print(f'  {g}: table {tab.values.tolist()} | Pearson chi2 p={pp:.4f} | Yates p={py:.4f} | Fisher p={pf:.4f} (OR={orr:.3f})')
        results.setdefault(g, {})[name] = {'pearson_p': pp, 'yates_p': py, 'fisher_p': pf}

# ---- 4. SENSITIVITY: include subjects without COVID AE as separate category (all 1000)
print('\n' + '='*70)
print('SENSITIVITY: all 1000 subjects, category "No COVID AE" added')
dm2 = dm.copy()
sev_map = dict(zip(per.USUBJID, per.severity))
dm2['sevcat'] = dm2.USUBJID.map(sev_map).fillna('NoCOVID')
for g in groups:
    d = dm2[dm2.patients_seen == g]
    tab = pd.crosstab(d.TRTGRP, d.sevcat)
    row, exp, p = report_table(tab, f'Group {g} (n={len(d)})')
    results.setdefault(g, {})['sensitivity_noCOVID_p'] = p

# ---- 5. Monte-Carlo exact-style supplement for RxC main tables (conditioned on margins)
print('\n' + '='*70)
print('SUPPLEMENT: Monte-Carlo permutation chi2 (10000 resamples, margins fixed) for main tables')
rng = np.random.default_rng(0)
for g, chi2, p, ns, ne, tab in main_rows:
    obs = tab.values
    r = obs.sum(1); c = obs.sum(0); n = obs.sum()
    count = 0; B = 10000
    for _ in range(B):
        # random table with fixed margins via shuffling labels
        rows = np.repeat(np.arange(len(r)), r)
        cols = np.repeat(np.arange(len(c)), c)
        rng.shuffle(cols)
        t = np.zeros_like(obs)
        np.add.at(t, (rows, cols), 1)
        if stats.chi2_contingency(t, correction=False)[0] >= chi2 - 1e-9:
            count += 1
    print(f'  {g}: MC-exact p ~= {count/B:.4f} (Pearson chi2={chi2:.4f})')
    results[g]['mc_exact_p'] = count/B

print('\n' + '='*70)
print('FINAL RESULT SUMMARY')
for g in groups:
    r = results[g]
    print(f"patients_seen={g}: main Pearson chi2 p={r['main_p_pearson']:.4f} | "
          f"MC-exact p={r['mc_exact_p']:.4f} | "
          f"Fisher(mild vs mod+) p={r['Mild(1) vs Moderate+ (2-4)']['fisher_p']:.4f} | "
          f"Fisher(nonsev vs sev+) p={r['Non-severe (1-2) vs Severe (3-4)']['fisher_p']:.4f} | "
          f"sensitivity(no-COVID category) p={r['sensitivity_noCOVID_p']:.4f}")

# ---- 6. Robustness: record-level (not per-subject) chi-square
print('\n' + '='*70)
print('ROBUSTNESS: record-level chi-square (each COVID AE record, AESEV non-missing)')
cov2 = cov.dropna(subset=['AESEV']).merge(dm[['USUBJID','patients_seen']], on='USUBJID')
for g in groups:
    d = cov2[cov2.patients_seen == g]
    tab = pd.crosstab(d.TRTGRP, d.AESEV)
    chi2, p, dof, exp = stats.chi2_contingency(tab, correction=False)
    print(f'  {g}: n={len(d)}, chi2={chi2:.4f}, dof={dof}, p={p:.4f}')
    results.setdefault(g, {})['record_level_p'] = p

print('\nANSWER: No patients_seen group shows a statistically significant (p<0.05)')
print('difference in COVID-19 severity between BCG and placebo (chi-square).')
