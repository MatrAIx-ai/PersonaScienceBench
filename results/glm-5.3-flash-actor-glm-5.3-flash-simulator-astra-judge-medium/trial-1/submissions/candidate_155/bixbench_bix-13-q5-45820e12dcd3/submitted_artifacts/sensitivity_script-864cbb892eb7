"""Sensitivity of the target-set count to dispersion choice and design formula."""
import numpy as np, pandas as pd
from scipy import optimize, stats

src = open('analysis.py').read()
head = src.split('# --------------------------------------------- dispersion shrinkage')[0]
ns = {}
exec(head, ns)
Y, X, sizef, irls, nb_loglik, disp_mle = ns['Y'], ns['X'], ns['sizef'], ns['irls'], ns['nb_loglik'], ns['disp_mle']
trend = ns['trend']; n, p = ns['n'], ns['p']; n_genes = Y.shape[0]
res = pd.read_csv('results/deseq2_equivalent_results.csv', index_col=0)
alpha_mle = res['dispersion_MLE'].to_numpy()
md, strain = ns['md'], ns['strain']
L2 = np.log(2.0)

def bh(p):
    p = np.asarray(p, float); valid = np.isfinite(p)
    q = np.full_like(p, np.nan); pv = p[valid]; m = len(pv)
    o = np.argsort(pv)
    ranked = pv[o]*m/(np.arange(m)+1)
    ranked = np.minimum.accumulate(ranked[::-1])[::-1]
    qv = np.clip(ranked,0,1); qs = np.empty(m); qs[o]=qv; q[valid]=qs
    return q

SCEN = {'conv(97=lasI,98=rhlI,99=double)': (('strain97','strain98'),'strain99'),
        'alt(98=double)': (('strain99','strain97'),'strain98'),
        'alt(97=double)': (('strain98','strain99'),'strain97')}

def report(alpha_use, Xd, label):
    cols = ['strain97','strain98','strain99']
    j0 = Xd.shape[1]-3
    pv = {c: np.empty(n_genes) for c in cols}
    for i in range(n_genes):
        beta, mu, w = irls(Y[i], Xd, sizef, alpha_use[i])
        se = np.sqrt(np.diag(np.linalg.inv(Xd.T @ (w[:,None]*Xd))))
        for j,c in enumerate(cols, start=j0):
            pv[c][i] = 2*stats.norm.sf(abs(beta[j]/se[j]))
    sig = {c: bh(pv[c]) < 0.05 for c in cols}
    counts = {c: int(sig[c].sum()) for c in cols}
    scen = {name: int(((sig[s[0]]|sig[s[1]]) & ~sig[dbl]).sum()) for name,(s,dbl) in SCEN.items()}
    print(f"{label}: sig {counts} | target {scen}")

# (a) no shrinkage: gene-wise MLE dispersions
report(alpha_mle, X, "A: MLE dispersion (no shrinkage)      ")
# (b) trend dispersion only
report(np.maximum(trend, 1e-8), X, "B: trend dispersion only              ")

# (c) design ~ strain (no media covariate)
S2 = ns['S']; X2 = np.column_stack([np.ones(len(md)), S2])
am2 = np.empty(n_genes)
for i in range(n_genes):
    am2[i], _ = disp_mle(Y[i], X2, sizef)
resid2 = np.log(am2) - np.log(trend)
df2 = X2.shape[0]-X2.shape[1]
sig2b = max((1.4826*np.median(np.abs(resid2-np.median(resid2))))**2*df2/(df2+2), 1e-3)
af2 = np.empty(n_genes)
for i in range(n_genes):
    if am2[i] < trend[i]:
        af2[i] = am2[i]; continue
    y = Y[i]
    def obj(loga):
        _, mu, _ = irls(y, X2, sizef, np.exp(loga), maxit=25)
        return -nb_loglik(y, mu, np.exp(loga)) + (loga-np.log(trend[i]))**2/(2*sig2b)
    af2[i] = np.exp(optimize.minimize_scalar(obj, bounds=(-10,4), method='bounded', options={'xatol':1e-3}).x)
report(af2, X2, "C: design ~ strain (no media term)      ")
