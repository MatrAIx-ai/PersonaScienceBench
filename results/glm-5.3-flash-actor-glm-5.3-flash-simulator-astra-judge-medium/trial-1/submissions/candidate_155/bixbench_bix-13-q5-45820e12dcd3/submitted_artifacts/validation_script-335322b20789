"""Numeric cross-check of IRLS GLM fits vs statsmodels NB GLM on sampled genes."""
import numpy as np, pandas as pd
import statsmodels.api as sm
from scipy import stats

src = open('analysis.py').read()
head = src.split('# ---------------------------------------------------------------- run')[0]
ns = {}
exec(head, ns)
Y, X, sizef, irls = ns['Y'], ns['X'], ns['sizef'], ns['irls']
res = pd.read_csv('results/deseq2_equivalent_results.csv', index_col=0)

idx = [0, 100, 500, 1000, 2000, 3000, 4000, 5000, 5827]
max_dbeta = 0.0; max_dz = 0.0
for i in idx:
    a = res['dispersion_final'].iloc[i]
    beta, mu, w = irls(Y[i], X, sizef, a)
    Xs = sm.add_constant(X[:, 1:], has_constant='add')  # same design, drop dup intercept col 0 handled below
    # use full X but statsmodels needs no duplicate: build from columns 1..5 + intercept
    mod = sm.GLM(Y[i], np.column_stack([np.ones(X.shape[0]), X[:, 1:]]),
                 family=sm.families.NegativeBinomial(alpha=a), offset=np.log(sizef))
    r = mod.fit(tol=1e-12)
    db = np.max(np.abs(r.params - np.concatenate([[beta[0]], beta[1:]])))
    se = np.sqrt(np.diag(r.cov_params()))
    dz = np.max(np.abs(r.params/se - beta/np.sqrt(np.diag(np.linalg.inv(X.T@(w[:,None]*X)))))) if False else np.max(np.abs(r.params/se - beta/np.sqrt(np.diag(np.linalg.inv(X.T@(w[:,None]*X))))))
    max_dbeta = max(max_dbeta, db); max_dz = max(dz, np.abs(r.params[3]/se[3] - beta[3]/np.sqrt(np.diag(np.linalg.inv(X.T@(w[:,None]*X))))[3]))
print("max |beta - statsmodels beta| over sampled genes:", max_dbeta)
print("max |z - statsmodels z| (strain97 coef):", max_dz)

# BH check vs statsmodels
from statsmodels.stats.multitest import multipletests
q1 = res['strain97_padj'].to_numpy()
q2 = multipletests(res['strain97_pval'].to_numpy(), method='fdr_bh')[1]
m = np.isfinite(q1)
print("max |padj mine - padj statsmodels|:", np.max(np.abs(q1[m]-q2[m])))
