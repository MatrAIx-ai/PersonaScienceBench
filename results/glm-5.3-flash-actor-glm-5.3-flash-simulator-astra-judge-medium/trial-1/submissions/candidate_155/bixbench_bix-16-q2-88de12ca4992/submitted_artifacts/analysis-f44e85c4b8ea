#!/usr/bin/env python3
"""
Skewness of gene expression distribution (log2(TPM+1), batch-corrected)
across all cell lines in the DepMap-style capsule inputs.

Main metric: Fisher-Pearson unbiased sample skewness G1
(scipy.stats.skew, bias=False) computed over ALL elements of the
expression matrix (merged), plus per-cell-line (row) and per-gene
(column) skewness summaries as supplementary evidence.

Zero and negative values are NOT removed (batch correction can produce
small negatives; zero log2(TPM+1) = no expression is real signal).
Only true NaNs are excluded and counted.
CRISPRGeneEffect.csv is not used in this question.
"""
import json
import numpy as np
import pandas as pd
from scipy import stats

EXPR = "data/OmicsExpressionProteinCodingGenesTPMLogp1BatchCorrected.csv"
MODEL = "data/Model.csv"
OUT_JSON = "analysis/skewness_results.json"
OUT_HIST = "analysis/skewness_histogram.txt"

# ---------- 1. Load expression matrix (float32, chunked) ----------
print("Loading expression matrix ...")
chunks, ids = [], []
for chunk in pd.read_csv(EXPR, index_col=0, chunksize=250):
    ids.extend(chunk.index.astype(str))
    chunks.append(chunk.to_numpy(dtype=np.float32))
X = np.vstack(chunks)
del chunks
n_cells, n_genes = X.shape
print(f"Matrix: {n_cells} cell lines x {n_genes} gene columns")

# ---------- 2. Basic QC ----------
nan_total = int(np.isnan(X).sum())
finite = X[np.isfinite(X)]           # exclude true NaNs only
vals = finite.astype(np.float64)     # float64 for moment accuracy
qs = np.percentile(vals, [0.5, 1, 5, 25, 50, 75, 95, 99, 99.5])
mean = float(vals.mean()); sd = float(vals.std(ddof=1))
median = float(np.median(vals))

def g1_unbiased(a):
    """Fisher-Pearson unbiased sample skewness G1 (scipy bias=False)."""
    return float(stats.skew(a, bias=False))

skew_merged = g1_unbiased(vals)
# sanity: same via moments
n = vals.size
m2 = ((vals - mean) ** 2).mean(); m3 = ((vals - mean) ** 3).mean()
g1 = m3 / m2 ** 1.5
adj = np.sqrt(n * (n - 1)) / (n - 2)
skew_merged_manual = float(g1 * adj)

# ---------- 3. ID correspondence with Model.csv ----------
model = pd.read_csv(MODEL)
model_ids = set(model["ModelID"].astype(str))
expr_ids = set(ids)
id_match = {
    "expression_rows": len(ids),
    "expression_unique_ids": len(expr_ids),
    "model_rows": int(len(model)),
    "matched": len(expr_ids & model_ids),
    "expression_not_in_model": sorted(expr_ids - model_ids)[:5],
}

# ---------- 4. Per-cell-line (row) and per-gene (column) skewness ----------
print("Computing row/column skewness ...")
Xf = X.copy()
nan_rows = int(np.isnan(Xf).any(axis=1).sum())
if nan_total:
    col_mean = np.nanmean(Xf, axis=0)
    idx = np.where(np.isnan(Xf))
    Xf[idx] = np.take(col_mean, idx[1])
row_skew = stats.skew(Xf, axis=1, bias=False, nan_policy="omit")
col_skew = stats.skew(Xf, axis=0, bias=False, nan_policy="omit")

def summarize(a):
    a = np.asarray(a, dtype=np.float64)
    a = a[np.isfinite(a)]
    q1, q3 = np.percentile(a, [25, 75])
    return {"n": int(a.size), "mean": float(a.mean()), "median": float(np.median(a)),
            "q1": float(q1), "q3": float(q3), "iqr": float(q3 - q1),
            "min": float(a.min()), "max": float(a.max()),
            "pct_positive": float((a > 0).mean() * 100)}

row_sum, col_sum = summarize(row_skew), summarize(col_skew)

# ---------- 5. Histogram evidence (ASCII; matplotlib unavailable offline) ----------
def ascii_hist(a, bins=40, width=60, title=""):
    counts, edges = np.histogram(a, bins=bins)
    w = counts.max()
    lines = [title]
    for c, lo, hi in zip(counts, edges[:-1], edges[1:]):
        bar = "#" * int(round(c / w * width))
        lines.append(f"{lo:7.2f} .. {hi:7.2f} | {bar} ({c})")
    return "\n".join(lines)

with open("analysis/skewness_histogram.txt", "w") as f:
    f.write(ascii_hist(vals, title="Histogram of ALL merged log2(TPM+1) values"))
print(ascii_hist(vals, title="Histogram of ALL merged log2(TPM+1) values"))

# ---------- 6. Report ----------
result = {
    "dimensions": {"cell_lines_rows": n_cells, "gene_columns": n_genes,
                   "total_elements": int(X.size), "float32_memory_mb": round(X.nbytes/2**20, 1)},
    "missing": {"nan_count": nan_total, "rows_with_nan": nan_rows,
                "note": "only NaNs excluded; zeros and negatives retained"},
    "distribution": {
        "min": float(vals.min()), "max": float(vals.max()),
        "percentiles": {"p0.5": float(qs[0]), "p1": float(qs[1]), "p5": float(qs[2]),
                        "q1": float(qs[3]), "median": float(qs[4]), "q3": float(qs[5]),
                        "p95": float(qs[6]), "p99": float(qs[7]), "p99.5": float(qs[8])},
        "mean": mean, "sd": sd, "mean_minus_median": mean - median,
        "pct_values_zero_or_below": float((vals <= 0).mean() * 100),
    },
    "skewness": {
        "merged_G1_scipy_biasFalse": skew_merged,
        "merged_G1_manual_check": skew_merged_manual,
        "per_cell_line": row_sum,
        "per_gene": col_sum,
    },
    "id_check": id_match,
    "files": {"expression": EXPR, "model": MODEL, "histogram": "analysis/skewness_histogram.txt"},
}
with open(OUT_JSON, "w") as f:
    json.dump(result, f, indent=2)
print(json.dumps(result, indent=2))
