"""CD4 protein-coding genes: Pearson correlation between gene length and mean expression.

Main specification (approved):
- Genes: gene_biotype == 'protein_coding' exactly (semicolon-joined multi-biotype rows excluded).
- Samples: all 151 columns with celltype == 'CD4' in Sample_annotated_Zenodo.csv.
- Expression: per-sample CPM (counts*1e6 / column total), then arithmetic mean across the 151 samples.
- Correlation: Pearson r (mean CPM vs Length), Fisher-z 95% CI, p-value. No log transform,
  no low-expression filter, no MT/sex-chromosome exclusion.
Robustness (secondary): (a) raw-count means; (b) mean of log2(CPM+1) vs linear length;
(c) main spec after low-expression filter (CPM>1 in >= half of CD4 samples);
(d) donor-level aggregation (mean per samp, then across donors).
"""
import pandas as pd
import numpy as np
from scipy import stats

META = 'data/GeneMetaInfo_Zenodo.csv'
COUNTS = 'data/BatchCorrectedReadCounts_Zenodo.csv'
SAMPLES = 'data/Sample_annotated_Zenodo.csv'

# ---------- Load ----------
meta = pd.read_csv(META)
samples = pd.read_csv(SAMPLES).set_index('sample')
counts = pd.read_csv(COUNTS, index_col=0)

# ---------- Assertion checks ----------
# 1) Gene IDs identical set AND order between metadata and counts
assert list(counts.index) == list(meta['Geneid']), "Gene ID order/set mismatch"
assert set(counts.index) == set(meta['Geneid'])
assert counts.index.is_unique and meta['Geneid'].is_unique

# 2) Count columns exactly match annotation sample names (order included)
assert list(counts.columns) == list(samples.index), "Count columns vs annotation mismatch"

# 3) CD4 columns exist verbatim in counts
cd4_samples = samples.index[samples['celltype'] == 'CD4'].tolist()
assert len(cd4_samples) == 151, f"expected 151 CD4 samples, got {len(cd4_samples)}"
assert set(cd4_samples).issubset(counts.columns)

cd4 = counts[cd4_samples]

# 4) CPM denominators strictly positive
col_tot = cd4.sum(axis=0)
assert (col_tot > 0).all(), "zero-total CD4 column found"
assert not np.isnan(cd4.values).any()

# 5) Length validity
pc_mask = meta['gene_biotype'] == 'protein_coding'
assert pc_mask.sum() == 19942, f"expected 19942 protein_coding rows, got {pc_mask.sum()}"
lengths = meta.loc[pc_mask, 'Length'].to_numpy(float)
assert np.isfinite(lengths).all() and (lengths > 0).all()

# ---------- Main specification ----------
cd4_pc = cd4.loc[meta.loc[pc_mask, 'Geneid']]
cpm = cd4_pc.div(col_tot, axis=1) * 1e6
mean_cpm = cpm.mean(axis=1).to_numpy(float)

def pearson_ci(x, y):
    r, p = stats.pearsonr(x, y)
    n = len(x)
    z = np.arctanh(r); se = 1.0 / np.sqrt(n - 3)
    lo, hi = np.tanh(z - 1.959963985 * se), np.tanh(z + 1.959963985 * se)
    return r, p, lo, hi, n

r_main, p_main, lo_main, hi_main, n_main = pearson_ci(lengths, mean_cpm)
print("=== MAIN SPECIFICATION ===")
print(f"n genes = {n_main}, n CD4 samples = {len(cd4_samples)}")
print(f"Pearson r = {r_main:.6f}  (3dp: {r_main:.3f})")
print(f"95% CI (Fisher z) = [{lo_main:.6f}, {hi_main:.6f}]  (3dp: [{lo_main:.3f}, {hi_main:.3f}])")
print(f"p-value = {p_main:.3e}")

# ---------- Robustness ----------
res = {"MAIN: CPM mean vs length": (r_main, p_main, lo_main, hi_main)}

# (a) raw-count arithmetic mean
raw_mean = cd4_pc.mean(axis=1).to_numpy(float)
r, p, lo, hi, _ = pearson_ci(lengths, raw_mean)
res["(a) raw count mean vs length"] = (r, p, lo, hi)

# (b) mean of log2(CPM+1) vs linear length
log_mean = np.log2(cpm.to_numpy() + 1).mean(axis=1)
r, p, lo, hi, _ = pearson_ci(lengths, log_mean)
res["(b) mean log2(CPM+1) vs length"] = (r, p, lo, hi)

# (c) low-expression filter: CPM>1 in >= half of CD4 samples, then main spec
keep = (cpm > 1).sum(axis=1) >= (len(cd4_samples) / 2)
sel = meta.loc[pc_mask, 'Geneid'][keep.to_numpy()]
mean_cpm_f = cpm.loc[sel].mean(axis=1).to_numpy(float)
r, p, lo, hi, _ = pearson_ci(lengths[keep.to_numpy()], mean_cpm_f)
res[f"(c) CPM mean, filter CPM>1 in >=50% samples (n={keep.sum()})"] = (r, p, lo, hi)

# (d) donor-level aggregation: mean per samp, then across donors
samp_map = samples.loc[cd4_samples, 'samp']
donor_mean = cpm.T.groupby(samp_map.values).mean().T.mean(axis=1)
cd4_pc_d = cd4_pc.loc[donor_mean.index]
r, p, lo, hi, _ = pearson_ci(
    meta.set_index('Geneid').loc[donor_mean.index, 'Length'].to_numpy(float),
    donor_mean.to_numpy(float))
res[f"(d) donor(samp)-aggregated CPM mean ({samp_map.nunique()} donors)"] = (r, p, lo, hi)

print("\n=== ROBUSTNESS (secondary) ===")
for k, (r, p, lo, hi) in res.items():
    print(f"{k}: r={r:.3f}  95%CI=[{lo:.3f}, {hi:.3f}]  p={p:.2e}")

print(f"\nMain vs robustness |Δr| range: "
      f"{min(abs(v[0]-r_main) for k,v in res.items() if k!='MAIN: CPM mean vs length'):.3f}"
      f"–{max(abs(v[0]-r_main) for k,v in res.items() if k!='MAIN: CPM mean vs length'):.3f}")
