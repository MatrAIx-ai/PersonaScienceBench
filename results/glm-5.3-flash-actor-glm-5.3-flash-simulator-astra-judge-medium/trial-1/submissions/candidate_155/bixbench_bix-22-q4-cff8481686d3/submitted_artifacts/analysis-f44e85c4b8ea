import pandas as pd
import numpy as np
from scipy import stats

# Load gene metadata
meta = pd.read_csv('data/GeneMetaInfo_Zenodo.csv', index_col=0)

# Load sample annotations
annot = pd.read_csv('data/Sample_annotated_Zenodo.csv')
cd14_samples = annot.loc[annot['celltype'] == 'CD14', 'sample'].tolist()
assert len(cd14_samples) == 132, len(cd14_samples)

# Load full count matrix
counts = pd.read_csv('data/BatchCorrectedReadCounts_Zenodo.csv', index_col=0)

# Full index consistency check: all 59,453 rows must match meta exactly
assert counts.shape[0] == meta.shape[0], (counts.shape, meta.shape)
assert (counts.index == meta.index).all(), "Index order mismatch between counts and meta"
assert counts.index.is_unique and meta.index.is_unique
print(f"Index consistency check PASSED: {counts.shape[0]} rows identical in counts and meta")

# Restrict matrix to CD14 sample columns (order per annotation table)
cd14 = counts[cd14_samples]
assert cd14.shape == (59453, 132)

# Filter protein-coding genes
mask = meta['gene_biotype'] == 'protein_coding'
pc_meta = meta[mask]
pc_counts = cd14.loc[mask.values, :]   # align rows by boolean mask; index verified identical
assert pc_counts.shape == (19942, 132)
assert (pc_counts.index == pc_meta.index).all()

# Main analysis: arithmetic mean on raw batch-corrected counts (no log, no normalization, no filtering)
mean_expr = pc_counts.mean(axis=1)
r, p = stats.pearsonr(pc_meta['Length'].values, mean_expr.values)
print(f"MAIN (raw count mean): r = {r:.6f}, p = {p:.3e}, genes = {pc_counts.shape[0]}, samples = {cd14.shape[1]}")

# Optional sensitivity: log2(count+1) then average
log_mean = np.log2(pc_counts.values + 1).mean(axis=1)
r_log, p_log = stats.pearsonr(pc_meta['Length'].values, log_mean)
print(f"SENSITIVITY (log2(count+1) mean): r = {r_log:.6f}, p = {p_log:.3e}")
