#!/usr/bin/env python3
"""
BixBench bix-22-q6: Pearson correlation between gene length and gene expression
for protein-coding genes only.

Inputs (workspace/data):
  GeneMetaInfo_Zenodo.csv          - Geneid, Chr, Length, gene_biotype (59,453 genes)
  BatchCorrectedReadCounts_Zenodo.csv - 59,453 genes x 723 samples (non-negative integers)
  Sample_annotated_Zenodo.csv      - 723 samples: sample, samp, samtype, celltype, batch, sex

Approved analysis plan (researcher-approved):
  * "Gene expression" = per-gene MEAN across all 723 samples
    (for Pearson r this is mathematically equivalent to the per-gene SUM).
  * Protein-coding filter: gene_biotype == 'protein_coding' (exact string), 19,942 genes.
    Semicolon-joined multi-value biotype rows (22 rows, e.g. RGS5, CCDC39, POLR2J4) are
    treated conservatively: a row counts as protein-coding ONLY IF every ';'-split tag is
    'protein_coding'; mixed-tag rows are excluded. 'translated_*_pseudogene' labels (3
    genes) are NOT protein_coding and are excluded.
  * Primary result: Pearson r between raw Length and raw mean expression
    (literal reading of the question). Zero-mean genes are RETAINED.
  * Sensitivity: (a) log2(mean+1) vs log2(Length) Pearson; (b) Spearman;
    (c) recomputation after excluding the 645 all-zero protein-coding genes;
    (d) brief note on CPM / library-size normalization (column sums vary ~33x,
    so these batch-corrected counts are not library-size normalized; mean-based
    aggregation is dominated by high-depth libraries, but r(mean) == r(sum) exactly,
    so the choice of mean vs sum does not affect the coefficient).
  * No additional library-size normalization is applied to the primary statistic.
"""
import numpy as np
import pandas as pd
from scipy.stats import pearsonr, spearmanr

DATA = "data"

meta = pd.read_csv(f"{DATA}/GeneMetaInfo_Zenodo.csv", index_col=0)
counts = pd.read_csv(f"{DATA}/BatchCorrectedReadCounts_Zenodo.csv", index_col=0)
annot = pd.read_csv(f"{DATA}/Sample_annotated_Zenodo.csv")

# --- sanity checks -----------------------------------------------------------
assert counts.shape == (len(meta), len(annot))
assert (counts.index.to_numpy() == meta.Geneid.to_numpy()).all()
assert list(counts.columns) == annot["sample"].tolist()
vals = counts.to_numpy()
assert not np.isnan(vals).any() and (vals >= 0).all()

# --- protein-coding filter ---------------------------------------------------
bt = meta["gene_biotype"]
exact_pc = bt.eq("protein_coding")
semicolon = bt.str.contains(";")
pc_strict = exact_pc & ~semicolon            # clean labels only
# conservative rule for the 22 semicolon rows: all tags must be 'protein_coding'
pc_semi_ok = semicolon & bt.str.split(";").map(lambda ts: all(t.strip() == "protein_coding" for t in ts))
pc_mask = pc_strict | pc_semi_ok
print(f"[filter] exact protein_coding            : {int(exact_pc.sum())}")
print(f"[filter] semicolon rows total            : {int(semicolon.sum())}")
print(f"[filter] semicolon rows all-protein_coding: {int(pc_semi_ok.sum())}")
print(f"[filter] final protein-coding gene set   : {int(pc_mask.sum())}")

lengths = meta["Length"].to_numpy()
mean_expr = counts.mean(axis=1).to_numpy()   # expression = mean across all 723 samples

L = lengths[pc_mask]
E = mean_expr[pc_mask]
print(f"[filter] all-zero protein-coding genes   : {int((E == 0).sum())}")

def report(name, x, y):
    r, p = pearsonr(x, y)
    rho, _ = spearmanr(x, y)
    print(f"{name:<58s} pearson r = {r:+.4f} (p={p:.3e})   spearman rho = {rho:+.4f}")
    return r, rho

print("\n=== Sensitivity analyses (protein-coding genes only) ===")
r_main, rho_main = report("PRIMARY  raw mean-expression vs raw Length", E, L)
r_log,  rho_log  = report("SENS-1   log2(mean+1) vs log2(Length)  [Pearson r shown]", np.log2(E + 1), np.log2(L))
nz = E > 0
r_nz,  rho_nz    = report(f"SENS-2   raw, excluding {int(nz.sum() == 0) and 0 or int((E == 0).sum())} all-zero genes", E[nz], L[nz])
report("SENS-2b  log-log, excluding all-zero genes", np.log2(E[nz] + 1), np.log2(L[nz]))

# CPM note (brief, not a full branch): library-size normalized check
lib = counts.sum(axis=0).to_numpy()
cpm_mean = counts.multiply(1e6 / lib, axis=1).mean(axis=1).to_numpy()
r_cpm, _ = pearsonr(L, cpm_mean[pc_mask])
print(f"[SENS-3] CPM-normalized mean vs raw Length: pearson r = {r_cpm:+.4f}  "
      f"(library sizes span {lib.min():,}-{lib.max():,}; no extra normalization in primary)")

# single-celltype sensitivity (PBMC only)
pbmc = annot.index[annot["celltype"] == "PBMC"]
E_pbmc = counts.iloc[:, pbmc].mean(axis=1).to_numpy()
r_pbmc, _ = pearsonr(L, E_pbmc[pc_mask])
print(f"[SENS-4] PBMC-only mean expression vs raw Length: pearson r = {r_pbmc:+.4f}")

print("\n=== FINAL ANSWER (approved primary definition) ===")
print(f"Pearson r between gene Length and mean expression across all 723 samples,")
print(f"protein-coding genes only (n={int(pc_mask.sum())}, zero-mean genes retained): r = {r_main:.4f}")
