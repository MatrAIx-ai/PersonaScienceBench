#!/usr/bin/env python3
"""
CBD differential expression analysis (DESeq2-style pipeline in pure Python).
Primary: CBD_IC50 vs DMSO (vehicle). Sensitivity: CBD_IC50 vs Untreated.
DESeq2-style: median-of-ratios size factors (all 30 samples), per-gene NB dispersion
(pooled within-group method of moments) shrunk toward a parametric trend,
vectorized IRLS NB GLM, Wald test, BH correction.
NOTE: no R/Bioconductor, no network, no GO annotation files in this environment
(verified: data dir contains only the two input files; header has no annotation columns),
so GO BP enrichment cannot be executed here; conclusions rest on DE directionality.
"""
import numpy as np, pandas as pd
from scipy import stats

LN2 = np.log(2.0)

counts = pd.read_csv('data/counts_raw_unfiltered.csv', index_col=0)
layout = pd.read_csv('data/sample_layout.csv')
layout['col'] = layout['SampleID'].str.replace('-', '_', regex=False)
assert counts.shape == (63677, 30)
assert set(counts.columns) == set(layout['col'])

Y = counts.values.astype(np.float64)
genes = counts.index.values

# size factors: median-of-ratios over all 30 samples (DESeq2 default)
logc = np.log(np.where(Y > 0, Y, np.nan))
gm = np.exp(np.nanmean(logc, axis=1))
valid = np.isfinite(gm) & (gm > 0)
sf = np.median(Y[valid] / gm[valid][:, None], axis=0)
sf = sf / np.exp(np.mean(np.log(sf)))
print("size factors (min/med/max): %.3f %.3f %.3f" % (sf.min(), np.median(sf), sf.max()))

def bh(p):
    p = np.asarray(p); n = len(p)
    o = np.argsort(p); ranked = p[o] * n / (np.arange(n) + 1)
    adj = np.minimum.accumulate(ranked[::-1])[::-1]
    out = np.empty(n); out[o] = np.clip(adj, 0, 1)
    return out

def run_comparison(case_cols, ctrl_cols, label):
    cols = list(counts.columns)
    idx = np.array([cols.index(c) for c in case_cols + ctrl_cols])
    y = Y[:, idx]; s = sf[idx]
    n1, n = len(case_cols), len(case_cols) + len(ctrl_cols)
    keep = (y >= 10).sum(axis=1) >= 3
    yg = y[keep]
    X = np.zeros((n, 2)); X[:, 0] = 1.0; X[:n1, 1] = 1.0   # beta1 = case vs control

    # dispersion: pooled within-group method of moments on normalized counts
    nc = yg / s[None, :]
    mu_pred = np.zeros_like(yg)
    for start, cnt in [(0, n1), (n1, n - n1)]:
        qk = nc[:, start:start+cnt].mean(axis=1)
        mu_pred[:, start:start+cnt] = qk[:, None] * s[None, start:start+cnt]
    df_res = n - 2
    a_g = ((yg - mu_pred) ** 2).sum(1) - mu_pred.sum(1)
    a_g = a_g / np.maximum((mu_pred ** 2).sum(1), 1e-12) / df_res
    a_g = np.clip(a_g, 1e-8, 10.0)
    mean_of_nc = nc.mean(1)
    mmask = mean_of_nc > np.quantile(mean_of_nc, 0.25)
    A = np.column_stack([1.0 / mean_of_nc[mmask], np.ones(mmask.sum())])
    coef, *_ = np.linalg.lstsq(A, a_g[mmask], rcond=None)
    a_trend = np.clip(coef[0] / np.maximum(mean_of_nc, 1e-8) + coef[1], 1e-8, 10.0)
    a_final = np.clip((df_res * a_g + a_trend) / (df_res + 1.0), 1e-8, 10.0)
    print(f"[{label}] trend a1/mean+a0: a1={coef[0]:.4g} a0={coef[1]:.4g}; alpha median={np.median(a_final):.3f}")

    # vectorized IRLS NB GLM
    G = yg.shape[0]
    beta = np.zeros((G, 2))
    beta[:, 0] = np.log(np.maximum(mean_of_nc, 0.5))
    Xb = beta @ X.T
    x1 = X[:, 1]
    for it in range(100):
        eta = Xb + np.log(s)[None, :]
        mu = np.maximum(np.exp(eta), 1e-8)
        Wm = mu / (1.0 + a_final[:, None] * mu)
        Z = eta - np.log(s)[None, :] + (yg - mu) / mu
        w = Wm * x1
        i00 = Wm.sum(1); i01 = w.sum(1); i11 = (w * x1).sum(1)
        det = np.maximum(i00 * i11 - i01 ** 2, 1e-12)
        wz = Wm * Z; wz1 = wz * x1
        b_new = np.stack([(i11 * wz.sum(1) - i01 * wz1.sum(1)) / det,
                          (i00 * wz1.sum(1) - i01 * wz.sum(1)) / det], 1)
        step = np.abs(b_new - beta).max()
        beta = b_new.copy()
        beta[:, 1] = np.clip(beta[:, 1], -30, 30)
        Xb = beta @ X.T
        if step < 1e-8:
            break
    eta = Xb + np.log(s)[None, :]
    mu = np.maximum(np.exp(eta), 1e-8)
    Wm = mu / (1.0 + a_final[:, None] * mu)
    w = Wm * x1
    i11 = Wm.sum(1); i01 = w.sum(1); i00 = (w * x1).sum(1)
    det = np.maximum(i00 * i11 - i01 ** 2, 1e-12)
    se = np.sqrt(i00 / det)
    zstat = beta[:, 1] / se
    pval = 2 * stats.norm.sf(np.abs(zstat))
    l2fc = beta[:, 1] / LN2
    padj = bh(pval)

    res = pd.DataFrame({'EnsemblID': genes[keep], 'baseMean': mean_of_nc,
                        'log2FC': l2fc, 'lfcSE': se / LN2, 'stat': zstat,
                        'pvalue': pval, 'padj': padj})
    sig = res[(res.padj < 0.05) & (res.log2FC.abs() > 0.5)]
    up = sig[sig.log2FC > 0]; dn = sig[sig.log2FC < 0]
    print(f"\n===== {label} =====")
    print(f"genes tested: {G} | sig (padj<0.05 & |log2FC|>0.5): {len(sig)} (up {len(up)}, down {len(dn)})")
    print(f"median log2FC  up: {up.log2FC.median():+.3f} | down: {dn.log2FC.median():+.3f}")
    print(f"mean |log2FC|  up: {up.log2FC.abs().mean():.3f} | down: {dn.log2FC.abs().mean():.3f}")
    for name, d in [("top up", up), ("top down", dn)]:
        print(name + " (by padj):")
        print(d.sort_values('padj').head(8)[['EnsemblID', 'baseMean', 'log2FC', 'padj']].to_string(index=False))
    res.sort_values('padj').to_csv(f"results/DE_{label}.csv", index=False)
    return res, sig, up, dn

resD, sigD, upD, dnD = run_comparison(['7_1', '7_2', '7_3'], ['3_1', '3_2', '3_3'], 'CBD_IC50_vs_DMSO')
resU, sigU, upU, dnU = run_comparison(['7_1', '7_2', '7_3'], ['1_1', '1_2', '1_3'], 'CBD_IC50_vs_Untreated')

print("\n===== direction agreement between the two comparisons =====")
sD, sU = set(sigD.EnsemblID), set(sigU.EnsemblID)
both_up = set(upD.EnsemblID) & set(upU.EnsemblID)
both_dn = set(dnD.EnsemblID) & set(dnU.EnsemblID)
flip = (set(upD.EnsemblID) & set(dnU.EnsemblID)) | (set(dnD.EnsemblID) & set(upU.EnsemblID))
print(f"up: {len(upD)} vs {len(upU)} | down: {len(dnD)} vs {len(dnU)}")
print(f"concordantly up {len(both_up)} | concordantly down {len(both_dn)} | direction-flipped {len(flip)}")
