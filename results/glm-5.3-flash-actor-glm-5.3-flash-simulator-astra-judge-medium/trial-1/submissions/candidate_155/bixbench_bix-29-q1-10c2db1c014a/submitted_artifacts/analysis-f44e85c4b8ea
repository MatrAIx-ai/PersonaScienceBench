"""TASK008 BCG-CORONA: Ordinal (proportional-odds logistic) regression of
COVID-19 severity on BCG vaccination, prior medical history count and
patient interaction frequency, with treatment x contact-frequency interaction.
Researcher-approved plan; Python statsmodels OrderedModel (cumulative logit).
Positive coefficient => higher odds of more severe COVID-19 (OR = exp(beta)).
"""
import numpy as np, pandas as pd, warnings
from scipy import stats, optimize
from statsmodels.miscmodels.ordinal_model import OrderedModel
import statsmodels.api as sm
warnings.filterwarnings("ignore")

# ---------------- 1. Subject-level analysis dataset ----------------
dm = pd.read_csv("data/TASK008_BCG-CORONA_DM.csv")
ae = pd.read_csv("data/TASK008_BCG-CORONA_AE.csv")
mh = pd.read_csv("data/TASK008_BCG-CORONA_MH.csv")

cov = ae[ae.AEPT.str.contains("COVID", case=False, na=False)]
sev = cov.groupby("USUBJID").AESEV.max().rename("covid_sev")
covid_any = pd.Index(cov.USUBJID.unique())
df = dm.set_index("USUBJID").join(sev)
df["has_covid"] = df.index.isin(covid_any).astype(int)   # any COVID-19 AE record (n=194)
df["trt"] = (df.TRTGRP == "BCG").astype(int)          # Placebo = reference

mhsub = mh[mh.MHSCAT == "MEDICAL HISTORY"]
std = mhsub[~mhsub.MHTERM.str.startswith("Other:", na=False)].copy()
std["chronic"] = std.MHTERM != "Current respiratory tract infection"
c17 = std[std.chronic & (std.MHORRES == 2)].groupby("USUBJID").size()
coth = mhsub[mhsub.MHTERM.str.startswith("Other:", na=False) & (mhsub.MHORRES == 2)].groupby("USUBJID").size()
df["hist_count"] = c17.reindex(df.index, fill_value=0).astype(float)
df["hist_count_incl"] = df.hist_count + coth.reindex(df.index, fill_value=0).astype(float)

df["ps"] = df.patients_seen.map({"1-50": 1, "51-100": 2, ">100": 3}).astype(float)
df["ei"] = (df.expect_interact == "Yes").astype(float)
df["trt_ps"] = df.trt * df.ps
df["trt_ei"] = df.trt * df.ei

cs = df[df.covid_sev.notna()]        # 151 cases with severity
csA = df[df.has_covid == 1]          # 194 cases incl. missing severity

print("=" * 72); print("SPARSITY: TRT x patients_seen x severity (n=151)")
print(pd.crosstab([cs.TRTGRP, cs.patients_seen], cs.covid_sev))

Xcols = ["trt", "hist_count", "ps", "trt_ps"]

def fit_ord(y, X, name, show=True):
    mod = OrderedModel(np.asarray(y), np.asarray(X, float), distr="logit")
    res = mod.fit(method="bfgs", disp=False, maxiter=5000)
    k_t = mod.k_levels - 1
    if show:
        conv = res.mle_retvals.get("converged")
        print(f"\n--- {name}: converged={conv}, llf={res.llf:.3f}, n={len(y)}")
        b = res.params[:-k_t]; ci = np.asarray(res.conf_int())[:-k_t]; cols_names = list(np.asarray(X, float).dtype.names or X.columns) if hasattr(X, "columns") else [f"x{i}" for i in range(len(b))]
        tbl = pd.DataFrame({"coef": b, "OR": np.exp(b),
                            "CI_lo": np.exp(ci[:, 0]), "CI_hi": np.exp(ci[:, 1]),
                            "p": res.pvalues[:-k_t]}, index=cols_names)
        print(tbl.round(4).to_string())
        cuts = mod.transform_threshold_params(res.params)[1:-1]
        print("cutpoints (actual):", np.round(cuts, 3))
    return res, mod

def or_at(res, mod, cols, var, inter, levels, base=1.0, label="modifier"):
    k_t = mod.k_levels - 1
    b = res.params[:-k_t]
    V = np.asarray(res.cov_params())[:-k_t, :-k_t]
    i1, i2 = cols.index(var), cols.index(inter)
    rows = []
    for L in levels:
        w = np.zeros(len(b)); w[i1] = 1; w[i2] = L - base
        est = w @ b; se = np.sqrt(w @ V @ w); z = stats.norm.ppf(.975)
        rows.append({f"{label}_level": L, "BCG OR": float(np.exp(est)),
                     "CI_lo": float(np.exp(est - z * se)), "CI_hi": float(np.exp(est + z * se))})
    return pd.DataFrame(rows).round(4)

# ---------------- 2. PO assumption diagnostics ----------------
def brant_tests(y, X, name):
    """Brant-style: per-cutpoint binary logits P(Y>j); per-variable + overall test."""
    K = int(np.max(y) - np.min(y) + 1)
    rows = {}
    for j in range(1, K):
        d = (np.asarray(y) > np.min(y) + j - 1).astype(int)
        if d.sum() in (0, len(d)): continue
        try:
            rj = sm.Logit(d, sm.add_constant(np.asarray(X, float), has_constant="add")).fit(disp=False, maxiter=2000)
            rows[j] = (np.asarray(rj.params), np.asarray(rj.cov_params()))
        except Exception as e:
            print(f"  cutpoint {j}: binary logit failed ({e})")
    js = sorted(rows)
    bjs = np.array([rows[j][0] for j in js]); Vjs = [rows[j][1] for j in js]
    Vinv = [np.linalg.pinv(V) for V in Vjs]
    Vbar = np.linalg.pinv(sum(Vinv))
    bbar = Vbar @ sum(Vi @ bj for Vi, bj in zip(Vinv, bjs))
    print(f"\n[{name}] Brant-style check of PO (cutpoint-specific ORs from binary logits):")
    idx = ["const"] + list(X.columns)
    disp = pd.DataFrame({f"Y>{j}": np.exp(bjs[k]) for k, j in enumerate(js)}, index=idx)
    print(disp.round(3).to_string())
    for m_, nm in enumerate(idx[1:]):
        d = np.array([bjs[k][m_ + 1] - bbar[m_ + 1] for k in range(len(js))])
        W = 0.0
        for k in range(len(js)):
            vk = (Vjs[k] - Vbar)[m_ + 1, m_ + 1]
            if vk > 0: W += d[k] ** 2 / vk
        dfd = len(js) - 1
        print(f"  PO test for {nm}: chi2={W:.2f}, df={dfd}, p={stats.chi2.sf(W, dfd):.4g}")

def lr_parallel(y, X, resA, modA, name):
    """LR test PO vs non-parallel (category-specific beta) cumulative logit."""
    K = int(np.max(y) - np.min(y) + 1); p = X.shape[1]
    y0 = (np.asarray(y) - np.min(y)).astype(int)
    def gen_ll(params):
        c = np.empty(K - 1); c[0] = params[0]
        for j in range(1, K - 1): c[j] = c[j - 1] + np.exp(params[j])
        B = params[K - 1:].reshape(K - 1, p)
        F = stats.logistic.cdf(c - X.values @ B.T)
        F = np.hstack([np.zeros((len(y0), 1)), F, np.ones((len(y0), 1))])
        pr = F[np.arange(len(y0)), y0 + 1] - F[np.arange(len(y0)), y0]
        return -np.sum(np.log(np.clip(pr, 1e-12, None)))
    b0 = resA.params[:-(modA.k_levels - 1)]
    thr = resA.params[-(modA.k_levels - 1):]
    cut = np.concatenate([thr[:1], np.exp(thr[1:])]).cumsum()
    x0 = np.concatenate([cut[:1], np.log(np.diff(cut)), np.tile(b0, K - 1)])
    bnds = [(-30, 30)] * (K - 1) + [(-8, 8)] * ((K - 1) * p)   # bound betas: sparse-data separation guard
    r = optimize.minimize(gen_ll, x0, method="L-BFGS-B", bounds=bnds, options={"maxiter": 10000})
    if any(abs(r.x[K - 1:]) >= 7.99):
        print("  WARNING: non-parallel fit hits beta bounds (data separation at sparse cutpoints); ORs approximate.")
    ll_np, ll_p = -r.fun, resA.llf
    dfd = (K - 2) * p
    LR = 2 * (ll_np - ll_p)
    pval = stats.chi2.sf(max(LR, 0), dfd)
    print(f"\n[{name}] Parallel-lines (PO) LR test: LR={LR:.3f}, df={dfd}, p={pval:.4g}")
    B = r.x[K - 1:].reshape(K - 1, p)
    print("  non-parallel model, cutpoint-specific BCG ORs:",
          {f"Y>{j}": round(np.exp(B[k, 0]), 3) for k, j in enumerate(range(1, K))})
    return LR, dfd, pval

# ---------------- 3. Primary and required estimands ----------------
print("=" * 72); print("MODEL A (PRIMARY): COVID cases with AESEV, n=151, outcome 1-4")
yA = cs.covid_sev.astype(int).values; XA = cs[Xcols]
resA, modA = fit_ord(yA, XA, "A: severity ~ trt + hist_count + ps + trt:ps")
print("BCG OR at each patients_seen level (interaction model):")
print(or_at(resA, modA, Xcols, "trt", "trt_ps", [1, 2, 3], label="patients_seen").to_string(index=False))
lrA = lr_parallel(yA, XA, resA, modA, "Model A")
brant_tests(yA, XA, "Model A")

print("\n" + "=" * 72)
print("MODEL B: outcome 0 (no COVID-19 AE) to 4; 43 COVID cases w/o AESEV noted")
XB = df[Xcols]
print("level composition (0=no COVID AE, 1-4=severity, 'm'=missing severity):")
print(df.covid_sev.apply(lambda v: int(v) if pd.notna(v) else "m").groupby(df.has_covid).value_counts().to_string())
print("\nB-primary: all 1000; missing-severity COVID cases assigned lowest level 1:")
yB = df.covid_sev.fillna(0).where(df.has_covid == 1, 0).astype(int)
yB = df.covid_sev.fillna(1.0) * df.has_covid            # no-COVID->0, missing-sev->1
resB, modB = fit_ord(yB.astype(int).values, XB, "B(primary, n=1000): trt + hist + ps + trt:ps")
print("BCG OR at each patients_seen level:")
print(or_at(resB, modB, Xcols, "trt", "trt_ps", [1, 2, 3], label="patients_seen").to_string(index=False))
lrB = lr_parallel(yB.astype(int).values, XB, resB, modB, "Model B primary")
print("\nB-variant: 43 missing-severity cases EXCLUDED (n=957):")
sub = df[(df.has_covid == 0) | df.covid_sev.notna()]
r, m = fit_ord(sub.covid_sev.fillna(0).astype(int).values, sub[Xcols], "B-excl (n=957)")
print("BCG OR at ps levels:", or_at(r, m, Xcols, "trt", "trt_ps", [1, 2, 3], label="ps").to_string(index=False))
print("\nB-variant: 43 missing-severity cases assigned HIGHEST level 4 (n=1000):")
yB4 = df.covid_sev.fillna(4.0) * df.has_covid
r, m = fit_ord(yB4.astype(int).values, XB, "B-miss=4 (n=1000)")
print("BCG OR at ps levels:", or_at(r, m, Xcols, "trt", "trt_ps", [1, 2, 3], label="ps").to_string(index=False))
brant_tests(yB.astype(int).values, XB, "Model B primary")

print("\nMain-effect-only models (no interaction) for reference:")
fit_ord(yA, cs[["trt", "hist_count", "ps"]], "A0 no interaction")
fit_ord(yB.astype(int).values, df[["trt", "hist_count", "ps"]], "B0 no interaction")

# ---------------- 4. Sensitivity analyses ----------------
print("\n" + "=" * 72); print("SENSITIVITY ANALYSES")
print("\nS1: expect_interact replaces patients_seen (n=151)")
cols = ["trt", "hist_count", "ei", "trt_ei"]
r, m = fit_ord(yA, cs[cols], "S1 trt + hist + expect_interact + interaction")
print("BCG OR at expect_interact = No / Yes:")
print(or_at(r, m, cols, "trt", "trt_ei", [0, 1], base=0, label="expect_interact").to_string(index=False))

print("\nS2: patients_seen as dummies (n=151)")
d2 = (cs.ps == 2).astype(float).values; d3 = (cs.ps == 3).astype(float).values
Xs2 = pd.DataFrame({"trt": cs.trt.values, "hist_count": cs.hist_count.values,
                    "ps2": d2, "ps3": d3, "trt:ps2": cs.trt.values * d2,
                    "trt:ps3": cs.trt.values * d3})
r, m = fit_ord(yA, Xs2, "S2 dummy-coded modifier + interactions")
print("BCG OR at patients_seen 1-50 (reference) / with interactions:",
      or_at(r, m, list(Xs2.columns), "trt", "trt:ps2", [1], base=1).to_string(index=False))

print("\nS3: 43 missing-AESEV cases (n=194) bounding analyses")
for fill, nm in [(1, "missing assigned lowest level (1)"), (4, "missing assigned highest level (4)")]:
    y = csA.covid_sev.fillna(fill).astype(int).values
    r, m = fit_ord(y, csA[Xcols], f"S3 {nm}")
    print("BCG OR at patients_seen 1-50:", or_at(r, m, Xcols, "trt", "trt_ps", [1]).to_string(index=False))

print("\nS4: history count including 'Other:' free-text (n=151)")
cols4 = ["trt", "hist_count_incl", "ps", "trt_ps"]
r, m = fit_ord(yA, cs[cols4], "S4 incl Other")
print("BCG OR at patients_seen 1-50:", or_at(r, m, cols4, "trt", "trt_ps", [1]).to_string(index=False))

print("\nS5: all-1000 model with hist_count incl Other")
cols5 = ["trt", "hist_count_incl", "ps", "trt_ps"]
