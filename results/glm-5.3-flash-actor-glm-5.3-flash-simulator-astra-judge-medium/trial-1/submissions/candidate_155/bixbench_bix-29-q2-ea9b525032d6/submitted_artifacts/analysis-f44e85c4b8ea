"""TASK008 BCG-CORONA - Final analysis (researcher-approved design).
Question: independent effect of each additional ongoing medical condition
(MHONGO) on the odds of higher COVID-19 severity, controlling for BCG
vaccination status and patient interaction variables (proportional-odds
ordinal logistic regression).

Design per approved plan:
- Outcome (main): subject-level max AESEV (1-4 ordinal) among COVID-19 AE
  records (AEPT in {COVID-19, COVID-19 pneumonia, Asymptomatic COVID-19});
  missing AESEV -> complete-case exclusion.
- Predictor of interest: MHONGO count = #MH records with MHONGO=="Yes".
- Covariates: TRTGRP (BCG vs Placebo), patients_seen (ordinal 3-level),
  expect_interact (binary), Age band (ordinal), SEX, education, work_hours
  (ordinal), RACE (categorical dummies).
- Sensitivities: (a) COVID AESEV merged 1/2/3+; (b) all-AE max AESEV (n~791).
"""
import warnings
import numpy as np
import pandas as pd
import statsmodels.api as sm
from scipy import stats
from statsmodels.miscmodels.ordinal_model import OrderedModel

dm = pd.read_csv("data/TASK008_BCG-CORONA_DM.csv")
mh = pd.read_csv("data/TASK008_BCG-CORONA_MH.csv")
ae = pd.read_csv("data/TASK008_BCG-CORONA_AE.csv")

# ---- MHONGO ongoing-condition count per subject (MHONGO == "Yes" only) ----
ongo = mh[mh.MHONGO == "Yes"]
cnt = ongo.groupby("USUBJID").size().rename("mhongo_count")
df = dm.merge(cnt, on="USUBJID", how="left")
df["mhongo_count"] = df["mhongo_count"].fillna(0).astype(int)

# ---- outcomes ----
covid = ae[ae.AEPT.isin(["COVID-19", "COVID-19 pneumonia", "Asymptomatic COVID-19"])]
df["y_covid"] = covid.groupby("USUBJID").AESEV.max().reindex(df.USUBJID).values
df["y_allae"] = ae.groupby("USUBJID").AESEV.max().reindex(df.USUBJID).values

# ---- covariate coding ----
df["bcg"] = (df.TRTGRP == "BCG").astype(int)
df["patients_seen_o"] = df.patients_seen.map({"1-50": 1, "51-100": 2, ">100": 3})
df["expect_interact_b"] = (df.expect_interact == "Yes").astype(int)
df["age_o"] = df.Age.map({"10-19": 1, "20-29": 2, "30-39": 3, "40-49": 4,
                          "50-59": 5, "60-69": 6, "70-79": 7})
df["work_hours_o"] = df.work_hours.map({"1-40": 1, "41-80": 2, ">80": 3})
df["sex_b"] = df.SEX - 1
race_d = pd.get_dummies(df.RACE.astype(str), prefix="RACE", drop_first=True).astype(float)
df = pd.concat([df, race_d], axis=1)
COV = ["mhongo_count", "bcg", "patients_seen_o", "expect_interact_b",
       "age_o", "sex_b", "education", "work_hours_o"] + list(race_d.columns)

def best_mn_llf(y, X):
    """Best multinomial-logit log-likelihood across optimizers (raw X)."""
    best = -np.inf
    with warnings.catch_warnings():
        warnings.simplefilter("ignore")
        m = sm.MNLogit(y, X)
        for kw in [dict(), dict(method="bfgs", maxiter=5000),
                   dict(method="lbfgs", maxiter=20000, maxfun=200000),
                   dict(method="powell", maxiter=20000, maxfun=200000)]:
            try:
                r = m.fit(disp=False, **kw)
                if np.isfinite(r.llf):
                    best = max(best, r.llf)
            except Exception:
                pass
    return best

def fit_ord(d, ycol, label):
    d2 = d.dropna(subset=[ycol] + COV).copy()
    X = d2[COV].astype(float)
    y = d2[ycol].astype(int)
    res = OrderedModel(y, X, distr="logit").fit(method="bfgs", disp=False, maxiter=5000)
    tbl = pd.DataFrame({"coef": res.params, "OR": np.exp(res.params),
                        "CI2.5": np.exp(res.conf_int()[0]),
                        "CI97.5": np.exp(res.conf_int()[1]),
                        "p": res.pvalues})
    b = res.params["mhongo_count"]
    lo, hi = np.exp(res.conf_int().loc["mhongo_count"])
    # proportional-odds LR test: ordinal vs (best achievable) multinomial logit
    mn_llf = best_mn_llf(y, X)
    J = y.nunique(); dfree = (J - 2) * X.shape[1]
    lr = 2 * (mn_llf - res.llf)
    p_lr = stats.chi2.sf(max(lr, 0.0), dfree)
    print(f"\n===== {label}  n={len(d2)}  conv={res.mle_retvals.get('converged')}"
          f"  dist={y.value_counts().sort_index().to_dict()}")
    print(tbl.round(4).to_string())
    print(f"PO LR test: LR={lr:.3f}, df={dfree}, p={p_lr:.4f}")
    print(f"MHONGO OR per +1 = {np.exp(b):.4f} -> {(np.exp(b)-1)*100:.2f}% odds increase "
          f"(95% CI {(lo-1)*100:.2f}% to {(hi-1)*100:.2f}%), p={res.pvalues['mhongo_count']:.4f}")
    return dict(model=label, n=len(d2), conv=res.mle_retvals.get("converged"),
                OR=np.exp(b), pct=(np.exp(b)-1)*100,
                pct_lo=(lo-1)*100, pct_hi=(hi-1)*100,
                p=res.pvalues["mhongo_count"], lr=lr, df=dfree, p_lr=p_lr,
                dist=str(y.value_counts().sort_index().to_dict()))

rows = []
rows.append(fit_ord(df, "y_covid", "MAIN: COVID AE max AESEV 1-4"))
rows.append(fit_ord(df.assign(y_covid=df.y_covid.clip(upper=3)), "y_covid",
                    "SENS: COVID AESEV merged 1/2/3+"))
rows.append(fit_ord(df, "y_allae", "SENS: all-AE max AESEV 1-4"))

summary = pd.DataFrame(rows)
print("\n===== FINAL SUMMARY =====")
print(summary.round(4).to_string(index=False))
summary.to_csv("work/task008_results_summary.csv", index=False)
