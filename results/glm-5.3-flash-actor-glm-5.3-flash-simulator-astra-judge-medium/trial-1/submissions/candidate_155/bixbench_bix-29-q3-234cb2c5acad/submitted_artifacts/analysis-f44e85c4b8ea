# TASK008 BCG-CORONA: interaction of BCG vaccination status x prior medical history
# on COVID-19 severity (ordinal), controlling for patient interaction frequency.
# Primary: cumulative-link ordinal logistic (statsmodels OrderedModel).
import numpy as np, pandas as pd
import statsmodels.api as sm
from statsmodels.miscmodels.ordinal_model import OrderedModel

DATA = '/workspace/data/'
dm = pd.read_csv(DATA+'TASK008_BCG-CORONA_DM.csv')
ae = pd.read_csv(DATA+'TASK008_BCG-CORONA_AE.csv')
mh = pd.read_csv(DATA+'TASK008_BCG-CORONA_MH.csv')

# ---------- subject-level frame ----------
d = dm[['USUBJID','TRTGRP','SEX','Age','RACE','education','work_hours',
        'patients_seen','expect_interact']].copy()
d['bcg'] = (d.TRTGRP=='BCG').astype(int)
d['sex2'] = (d.SEX==2).astype(int)          # 2 = presumed female
age_map = {'10-19':'<30','20-29':'<30','30-39':'30-39','40-49':'40-49',
           '50-59':'50-59','60-69':'60+','70-79':'60+'}
d['age'] = d.Age.map(age_map)
d['work'] = d.work_hours.map({'1-40':'1-40','41-80':'41-80+','>80':'41-80+'})
d['ps_cat'] = d.patients_seen  # 1-50 / 51-100 / >100 (categorical, ref 1-50)

# ---------- outcomes ----------
def max_sev(sub):
    s = sub.AESEV.dropna()
    return s.max() if len(s) else np.nan

rti = ae[ae.AECAT=='RTI']
y_rti = rti.groupby('USUBJID').apply(max_sev).rename('y_rti')
y_all = ae.groupby('USUBJID').apply(max_sev).rename('y_all')
cov = ae[ae.AEPT.astype(str).str.contains('COVID', case=False, na=False)]
y_cov = cov.groupby('USUBJID').apply(max_sev).rename('y_cov')
has_rti = (ae.AECAT=='RTI').groupby(ae.USUBJID).any()
for s in (y_rti, y_all, y_cov):
    d[s.name] = d.USUBJID.map(s)
d['no_rti_ae'] = (~d.USUBJID.isin(has_rti[has_rti].index)).astype(int)
d.loc[d.no_rti_ae==1, 'y_rti_floor'] = 1.0   # sensitivity (c): no-RTI-AE -> level 1
d.loc[d.no_rti_ae==0, 'y_rti_floor'] = d.loc[d.no_rti_ae==0,'y_rti']

# ---------- prior medical history ----------
med = mh[mh.MHSCAT=='MEDICAL HISTORY']
core14 = ['Tuberculosis','Hypertension','Diabetes Mellitus',
 'Chronic Obstructive Pulmonary Disease','Asthma','Other lung disease',
 'Cardiovascular disease','Cerebrovascular disease','Kidney disease',
 'Liver disease','Cancer','Organ or bone marrow transplantation',
 'Primary immunodeficiency','Neutropenia or lymphopenia']
yes = med[(med.MHORRES==2)]
d['priorhx'] = d.USUBJID.isin(yes[yes.MHTERM.isin(core14)].USUBJID).astype(int)
d['priorhx_w_other'] = d.USUBJID.isin(yes.USUBJID).astype(int)  # incl. Other: freetext

# ---------- exclusions (primary: complete-case on y_rti) ----------
d['excluded'] = d.y_rti.isna().astype(int)
tab_exc = pd.crosstab([d.TRTGRP, d.priorhx], d.excluded)
print('=== Excluded (no RTI-AE severity) by TRTGRP x priorhx ===')
print(tab_exc, '\n')

# ---------- design matrix builder ----------
def design(dd, priorhx_col):
    X = pd.DataFrame(index=dd.index)
    X['bcg'] = dd.bcg
    X['priorhx'] = dd[priorhx_col]
    X['bcg_x_priorhx'] = X.bcg * X.priorhx
    X['ps_51_100'] = (dd.ps_cat=='51-100').astype(int)
    X['ps_gt100'] = (dd.ps_cat=='>100').astype(int)
    for a in ['30-39','40-49','50-59','60+']:
        X[f'age_{a}'] = (dd.age==a).astype(int)
    X['work_41_80+'] = (dd.work=='41-80+').astype(int)
    return X

def fit_ord(dd, ycol, priorhx_col, label):
    dd = dd.dropna(subset=[ycol])
    X = design(dd, priorhx_col)
    y = dd[ycol].astype(int)
    m = OrderedModel(y, X, distr='logit')
    r = m.fit(method='bfgs', disp=False)
    p = r.params
    b_int, se_int = p['bcg_x_priorhx'], r.bse['bcg_x_priorhx']
    b_trt, se_trt = p['bcg'], r.bse['bcg']
    or_int = np.exp(b_int)
    ci = np.exp([b_int-1.96*se_int, b_int+1.96*se_int])
    # stratum-specific BCG vs Placebo ORs
    or_s0 = np.exp(b_trt)
    ci_s0 = np.exp([b_trt-1.96*se_trt, b_trt+1.96*se_trt])
    b_s1 = b_trt + b_int
    var = r.cov_params().loc[['bcg','bcg_x_priorhx'],['bcg','bcg_x_priorhx']].values
    se_s1 = np.sqrt(var[0,0]+var[1,1]+2*var[0,1])
    or_s1 = np.exp(b_s1); ci_s1 = np.exp([b_s1-1.96*se_s1, b_s1+1.96*se_s1])
    print(f'--- {label}  (n={len(dd)}) ---')
    print('severity levels:', y.value_counts().sort_index().to_dict())
    print('cell sizes TRTGRP x priorhx:',
          dd.groupby(['TRTGRP', dd[priorhx_col]]).size().to_dict())
    print(pd.DataFrame({'coef':p, 'OR':np.exp(p), 'pval':r.pvalues}).to_string(float_format='%.4f'))
    print(f'INTERACTION OR (BCG effect ratio, priorhx1 vs priorhx0): '
          f'{or_int:.3f}  95% CI {ci[0]:.3f}-{ci[1]:.3f}  p={r.pvalues["bcg_x_priorhx"]:.4f}')
    print(f'  OR BCG vs Placebo | priorhx=0: {or_s0:.3f} ({ci_s0[0]:.3f}-{ci_s0[1]:.3f})')
    print(f'  OR BCG vs Placebo | priorhx=1: {or_s1:.3f} ({ci_s1[0]:.3f}-{ci_s1[1]:.3f})')
    print()
    return dict(label=label, n=len(dd), OR_int=or_int, lo=ci[0], hi=ci[1],
                p=r.pvalues['bcg_x_priorhx'], OR_s0=or_s0, OR_s1=or_s1)

res = []
res.append(fit_ord(d[d.excluded==0], 'y_rti', 'priorhx', 'PRIMARY: max AESEV over RTI AEs, complete-case'))
res.append(fit_ord(d[d.excluded==0], 'y_all', 'priorhx', 'Sens(a): max AESEV over ALL AEs'))
res.append(fit_ord(d[d.excluded==0], 'y_cov', 'priorhx', 'Sens(b): max AESEV over COVID-PT AEs'))
res.append(fit_ord(d, 'y_rti_floor', 'priorhx', 'Sens(c): no-RTI-AE subjects -> level 1'))
res.append(fit_ord(d[d.excluded==0], 'y_rti', 'priorhx_w_other', 'Sens(d): priorhx incl Other free-text'))
res.append(fit_ord(d, 'y_rti_floor', 'priorhx_w_other', 'Sens(d+c): priorhx incl Other, floor for no-AE'))

print('=== Sensitivity summary: interaction OR ===')
print(pd.DataFrame(res).to_string(index=False, float_format='%.3f'))

# ---------- proportional-odds informal check (adjacent binary models) ----------
dd0 = d[d.excluded==0]
for cut in [2,3,4]:
    yy = (dd0.y_rti >= cut).astype(int)
    X = design(dd0, 'priorhx'); X = sm.add_constant(X)
    try:
        m = sm.Logit(yy, X).fit(disp=0)
        print(f'P(Y>={cut}) logit: OR int={np.exp(m.params.bcg_x_priorhx):.3f} '
              f'(p={m.pvalues.bcg_x_priorhx:.3f}), OR trt={np.exp(m.params.bcg):.3f}, n={len(dd0)}')
    except Exception as e:
        print(f'cut {cut}: failed ({e})')
