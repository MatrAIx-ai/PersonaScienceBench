#!/usr/bin/env python3
"""
Differential expression analysis of serum miRNA Ct values
Source: data/pone.0150501.s002.xls ("Table S1. Ct values for 175 miRNAs in DM1 and healthy controls serum")

Question: What percentage of miRNAs show significant differential expression
between patient and control groups BEFORE multiple testing correction?

Method (approved):
- Groups: P_1..P_10 = DM1 patients; C_11..C_20 = healthy controls
- 'NAN' cells treated as missing (not zero); per-miRNA tests use available values
- Primary test: Welch two-sample t-test on Ct values (Ct is already log-scale)
- Threshold: unadjusted p < 0.05 (no multiple-testing correction)
- Percentage = (# miRNAs with p<0.05) / 175 * 100
- Sensitivity: Student t, Wilcoxon rank-sum, Bonferroni & BH corrected counts
"""
import sys, struct
sys.path.insert(0, '/usr/lib/python3/dist-packages')
import numpy as np
from scipy import stats
from statsmodels.stats.multitest import multipletests
import olefile

XLS = '/workspace/data/pone.0150501.s002.xls'

# ---------- minimal BIFF8 (.xls) reader (xlrd unavailable in this env) ----------
def decode_rk(rk):
    if rk & 2:
        val = float(rk >> 2)
    else:
        val = struct.unpack('<d', b'\x00'*4 + struct.pack('<I', rk & 0xFFFFFFFC))[0]
    if rk & 1:
        val /= 100
    return val

class Chunks:
    def __init__(self, chunks): self.chunks = chunks; self.ci = 0; self.off = 0
    def avail(self):
        return 0 if self.ci >= len(self.chunks) else len(self.chunks[self.ci]) - self.off
    def next_chunk(self): self.ci += 1; self.off = 0
    def take(self, n):
        out = b''
        while n > 0:
            if self.ci >= len(self.chunks): raise EOFError
            t = min(self.avail(), n)
            out += self.chunks[self.ci][self.off:self.off+t]
            self.off += t; n -= t
            if self.avail() == 0 and n > 0: self.next_chunk()
        return out

def parse_sst(recs):
    sst = []
    for idx, (rec, payload) in enumerate(recs):
        if rec != 0x00FC: continue
        n_total, n_unique = struct.unpack('<II', payload[:8])
        chunks = [payload[8:]]
        for rec2, p2 in recs[idx+1:]:
            if rec2 == 0x003C: chunks.append(p2)
            else: break
        rd = Chunks(chunks)
        for _ in range(n_unique):
            cch = struct.unpack('<H', rd.take(2))[0]
            if rd.avail() == 0: rd.next_chunk()
            flags = rd.take(1)[0]; wide = flags & 1
            cRun = cbExt = 0
            if flags & 8: cRun = struct.unpack('<H', rd.take(2))[0]
            if flags & 4: cbExt = struct.unpack('<I', rd.take(4))[0]
            parts = []; remaining = cch; first = True
            while remaining > 0:
                if rd.avail() == 0:
                    rd.next_chunk()
                    if not first:
                        f2 = rd.take(1)[0]
                        if (f2 & 1) != wide: wide = f2 & 1
                a = rd.avail()
                if wide:
                    nb = min(remaining, a // 2); parts.append(rd.take(nb*2).decode('utf-16-le', 'replace'))
                else:
                    nb = min(remaining, a); parts.append(rd.take(nb).decode('latin-1'))
                remaining -= nb; first = False
            if cRun: rd.take(4*cRun)
            if cbExt: rd.take(cbExt)
            sst.append(''.join(parts))
        break
    return sst

def read_sheet(path):
    data = olefile.OleFileIO(path).openstream('Workbook').read()
    recs = []; i = 0
    while i + 4 <= len(data):
        rec, ln = struct.unpack('<HH', data[i:i+4])
        recs.append((rec, data[i+4:i+4+ln])); i += 4 + ln
    sst = parse_sst(recs)
    rows = {}; si = -1; in_data = True
    for rec, payload in recs:
        if rec == 0x0809: si += 1; rows.setdefault(si, {}); in_data = True; continue
        if rec == 0x000A: in_data = False; continue
        if not in_data or si < 0: continue
        r = rows[si]
        if rec == 0x0203:
            row, col = struct.unpack('<HH', payload[:4]); r[(row, col)] = struct.unpack('<d', payload[6:14])[0]
        elif rec == 0x00BD:
            row, colf = struct.unpack('<HH', payload[:4])
            for k in range((len(payload)-6)//6):
                off = 4 + k*6
                rk = struct.unpack('<I', payload[off+2:off+6])[0]
                r[(row, colf+k)] = decode_rk(rk)
        elif rec == 0x027E:
            row, col = struct.unpack('<HH', payload[:4])
            r[(row, col)] = decode_rk(struct.unpack('<I', payload[6:10])[0])
        elif rec == 0x00FD:
            row, col, ixfe, sidx = struct.unpack('<HHHI', payload[:10])
            if sidx < len(sst): r[(row, col)] = sst[sidx]
    # pick the non-empty worksheet
    for si in sorted(rows):
        if len(rows[si]) > 100: return rows[si]
    raise RuntimeError('no data sheet found')

# ---------- load table ----------
rr = read_sheet(XLS)
nrows = max(k[0] for k in rr) + 1
ncols = max(k[1] for k in rr) + 1

title = rr.get((0, 0))
header = [rr.get((1, c)) for c in range(1, ncols)]
patients = [c for c, h in enumerate(header, start=1) if h and h.startswith('P_')]
controls = [c for c, h in enumerate(header, start=1) if h and h.startswith('C_')]

mirnas, mat = [], []
for r in range(2, nrows):
    name = rr.get((r, 0))
    row = []
    for c in range(1, ncols):
        v = rr.get((r, c))
        row.append(np.nan if (v is None or isinstance(v, str)) else float(v))
    mirnas.append(name); mat.append(row)
mat = np.array(mat)
print('Title cell:', repr(title))
print('Samples :', header)
print('Patient cols:', patients, 'Control cols:', controls)
print('Matrix:', mat.shape, 'missing (NaN):', int(np.isnan(mat).sum()))
assert mat.shape == (175, 20), mat.shape

P = mat[:, [c-1 for c in patients]]
C = mat[:, [c-1 for c in controls]]
print('Group sizes: patients=%d, controls=%d' % (P.shape[1], C.shape[1]))
print('Per-miRNA available values (min patients=%d, min controls=%d)' % (
    int(np.sum(~np.isnan(P), axis=1).min()), int(np.sum(~np.isnan(C), axis=1).min())))

# ---------- primary test: Welch t-test ----------
t_res = stats.ttest_ind(P, C, axis=1, equal_var=False, nan_policy='omit')
t_res_s = stats.ttest_ind(P, C, axis=1, equal_var=True, nan_policy='omit')
w_res = stats.mannwhitneyu(P, C, axis=1, alternative='two-sided', nan_policy='omit')
# note: mannwhitneyu with nan_policy='omit' supported in scipy>=1.9

welch_p = np.nan_to_num(t_res.pvalue, nan=1.0)
stud_p  = np.nan_to_num(t_res_s.pvalue, nan=1.0)
wil_p   = np.nan_to_num(w_res.pvalue,  nan=1.0)

n = len(mirnas)
sig_welch = int((welch_p < 0.05).sum())
sig_stud  = int((stud_p  < 0.05).sum())
sig_wil   = int((wil_p   < 0.05).sum())
bh = multipletests(welch_p, method='fdr_bh')[1]
bon = multipletests(welch_p, method='bonferroni')[1]

print('\n===== RESULTS =====')
print('Total miRNAs tested (denominator): %d' % n)
print('Welch t-test, unadjusted p<0.05 : %d  -> %.2f%%' % (sig_welch, 100*sig_welch/n))
print('Student t-test, unadjusted p<0.05: %d  -> %.2f%%' % (sig_stud, 100*sig_stud/n))
print('Wilcoxon rank-sum, p<0.05       : %d  -> %.2f%%' % (sig_wil, 100*sig_wil/n))
print('Bonferroni-corrected p<0.05     : %d' % int((bon < 0.05).sum()))
print('BH (FDR)-corrected p<0.05       : %d' % int((bh < 0.05).sum()))

order = np.argsort(welch_p)
print('\nTop 10 miRNAs by Welch p-value:')
print('%-18s %8s %8s %10s' % ('miRNA', 'mean_P', 'mean_C', 'p_welch'))
for i in order[:10]:
    print('%-18s %8.2f %8.2f %10.3g' % (mirnas[i], np.nanmean(P[i]), np.nanmean(C[i]), welch_p[i]))
print('\nSignificant (Welch, unadjusted p<0.05) list:')
print([mirnas[i] for i in order if welch_p[i] < 0.05])
