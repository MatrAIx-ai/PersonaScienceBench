#!/usr/bin/env python3
"""
BixBench bix-33-q1 analysis:
Which immune cell type has the highest number of significantly
differentially expressed genes after AAV9 mini-dystrophin treatment?

Primary source: 'Supplemental Data File 1 PostvsPre_DEG_tables_ANNOTATED
by_cell_type.xlsx' — the published Post-vs-Pre DEG tables, one sheet per
annotated cell type (Seurat FindMarkers-style columns:
gene, p_val, avg_log2FC, pct.1, pct.2, p_val_adj).

Counts per cell type of genes with p_val_adj < 0.05 (primary, two-sided),
plus sensitivity analyses (p_val_adj < 0.01; up/down separated) and
diagnostics (genes tested per type, fraction significant).
"""
import openpyxl
import pandas as pd

XLSX = 'data/Supplemental Data File 1 PostvsPre_DEG_tables_ANNOTATED by_cell_type.xlsx'
PADJ_PRIMARY = 0.05
PADJ_SENSITIVITY = 0.01


def load_tables(path=XLSX):
    """Read every sheet into a DataFrame; sheet name = cell type."""
    wb = openpyxl.load_workbook(path, read_only=True)
    tables = {}
    for sheet in wb.sheetnames:
        df = pd.DataFrame(
            list(wb[sheet].iter_rows(min_row=2, values_only=True)),
            columns=['gene', 'p_val', 'avg_log2FC', 'pct.1', 'pct.2', 'p_val_adj'],
        )
        # drop fully empty trailing rows if any
        df = df.dropna(subset=['gene']).reset_index(drop=True)
        tables[sheet] = df
    wb.close()
    return tables


def summarize(tables):
    rows = []
    for cell_type, df in tables.items():
        padj = df['p_val_adj']
        lfc = df['avg_log2FC']
        sig05 = padj < PADJ_PRIMARY
        sig01 = padj < PADJ_SENSITIVITY
        rows.append({
            'cell_type': cell_type,
            'genes_tested': len(df),
            'sig_0.05_total': int(sig05.sum()),
            'sig_0.05_up': int((sig05 & (lfc > 0)).sum()),
            'sig_0.05_down': int((sig05 & (lfc < 0)).sum()),
            'sig_0.01_total': int(sig01.sum()),
            'sig_0.01_up': int((sig01 & (lfc > 0)).sum()),
            'sig_0.01_down': int((sig01 & (lfc < 0)).sum()),
            'frac_sig_0.05': round(float(sig05.mean()), 3),
        })
    return pd.DataFrame(rows)


def add_rank(df, col):
    df = df.copy()
    df['rank_' + col] = df[col].rank(ascending=False, method='min').astype(int)
    return df


def main():
    tables = load_tables()
    print(f"Sheets read: {len(tables)}; total DEG rows: "
          f"{sum(len(d) for d in tables.values())}")

    s = summarize(tables)

    # ---- Primary: padj < 0.05, two-sided ----
    primary = add_rank(s.sort_values('sig_0.05_total', ascending=False),
                       'sig_0.05_total')
    print('\n=== PRIMARY: significant DEGs at p_val_adj < 0.05 (two-sided) ===')
    print(primary[['rank_sig_0.05_total', 'cell_type', 'genes_tested',
                   'sig_0.05_total', 'sig_0.05_up', 'sig_0.05_down',
                   'frac_sig_0.05']].to_string(index=False))

    winner = primary.iloc[0]
    print(f"\nWINNER (padj<0.05, two-sided): {winner['cell_type']} "
          f"with {winner['sig_0.05_total']} significant DEGs "
          f"(runner-up: {primary.iloc[1]['cell_type']} "
          f"{primary.iloc[1]['sig_0.05_total']})")

    # ---- Sensitivity (a): padj < 0.01, two-sided ----
    sens01 = add_rank(s.sort_values('sig_0.01_total', ascending=False),
                      'sig_0.01_total')
    print('\n=== SENSITIVITY (a): p_val_adj < 0.01 (two-sided) ===')
    print(sens01[['rank_sig_0.01_total', 'cell_type', 'sig_0.01_total']].head(10)
          .to_string(index=False))

    # ---- Sensitivity (b): direction separated at padj < 0.05 ----
    up_rank = add_rank(s.sort_values('sig_0.05_up', ascending=False),
                       'sig_0.05_up')
    down_rank = add_rank(s.sort_values('sig_0.05_down', ascending=False),
                         'sig_0.05_down')
    print('\n=== SENSITIVITY (b): padj < 0.05, UP-regulated only ===')
    print(up_rank[['rank_sig_0.05_up', 'cell_type', 'sig_0.05_up']].head(10)
          .to_string(index=False))
    print('\n=== SENSITIVITY (b): padj < 0.05, DOWN-regulated only ===')
    print(down_rank[['rank_sig_0.05_down', 'cell_type', 'sig_0.05_down']].head(10)
          .to_string(index=False))

    # ---- Sensitivity (c): two-sided at padj<0.01 winner check ----
    w01 = sens01.iloc[0]
    wup = up_rank.iloc[0]
    wdn = down_rank.iloc[0]
    print('\n=== WINNERS UNDER EACH CRITERION ===')
    print(f"padj<0.05 two-sided : {winner['cell_type']} ({winner['sig_0.05_total']})")
    print(f"padj<0.01 two-sided : {w01['cell_type']} ({w01['sig_0.01_total']})")
    print(f"padj<0.05 up-only   : {wup['cell_type']} ({wup['sig_0.05_up']})")
    print(f"padj<0.05 down-only : {wdn['cell_type']} ({wdn['sig_0.05_down']})")

    # ---- Diagnostics: panel saturation ----
    diag = add_rank(s.sort_values('genes_tested', ascending=False),
                    'genes_tested')
    print('\n=== DIAGNOSTIC: genes tested and significant fraction (padj<0.05) ===')
    print(diag[['cell_type', 'genes_tested', 'sig_0.05_total', 'frac_sig_0.05']]
          .to_string(index=False))

    # save full summary table
    s.to_csv('deg_counts_by_cell_type.csv', index=False)
    print("\nSaved full summary table to deg_counts_by_cell_type.csv")


if __name__ == '__main__':
    main()
