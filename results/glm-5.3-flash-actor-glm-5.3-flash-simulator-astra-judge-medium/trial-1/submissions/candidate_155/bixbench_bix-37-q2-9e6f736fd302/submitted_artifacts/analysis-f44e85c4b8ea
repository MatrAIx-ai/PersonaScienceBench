# Analysis: base protein level of ENO1 in normal samples
# Source: "Proteomic_data .xlsx", worksheet "Tumor vs Normal"
import pandas as pd

df = pd.read_excel('data/Proteomic_data .xlsx', sheet_name='Tumor vs Normal')
print('Sheet shape:', df.shape)

eno1 = df[df['gene'] == 'ENO1']
print('ENO1 rows found:', len(eno1))
row = eno1.iloc[0]
print('protein:', row['protein'], '| Description:', row['Description'])
normal_val = float(row['Normal'])
print('Normal value (raw):', normal_val)

# Round to 3 significant figures
from decimal import Decimal
sig3 = float(f'{normal_val:.3g}')
print('Rounded to 3 significant figures:', sig3)
