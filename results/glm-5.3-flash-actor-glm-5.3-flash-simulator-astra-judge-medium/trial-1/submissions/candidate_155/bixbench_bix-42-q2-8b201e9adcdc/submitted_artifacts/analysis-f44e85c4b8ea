"""BixBench bix-42-q2: Skewness of the RNA expression distribution (COAD gene expression).
Primary: pooled raw-count-scale values, all 328 samples x all genes.
Sensitivity: tumor-only, log2(x+1), duplicate-collapsed, per-gene summary.
Metrics: Fisher g1, Bowley quantile skewness, D'Agostino K2, subsample Shapiro-Wilk,
          histogram/density (SVG), Q-Q plots, per-gene skewness summary.
NOTE: matplotlib/R are unavailable in this environment, so figures are written as SVG.
"""
import numpy as np, pandas as pd, json, math
from scipy import stats

RNG = np.random.default_rng(42)
ge = pd.read_csv("data/COAD__geneExp.xls", sep="\t", index_col=0)
tumor_cols = [c for c in ge.columns if c[13:15] == "01"]
X_all = ge.to_numpy(dtype=float)
X_tum = ge[tumor_cols].to_numpy(dtype=float)
results = {}

def fisher_g1(x): return float(stats.skew(x, bias=False))

def bowley(x):
    q1, q2, q3 = np.percentile(x, [25, 50, 75])
    d = q3 - q1  # (Q3-Q2)+(Q2-Q1)
    return float((q3 - q2 - (q2 - q1)) / d) if d != 0 else 0.0

def describe(x, name, n_shapiro=4999):
    x = np.asarray(x, float); x = x[np.isfinite(x)]
    out = {"n_values": int(x.size), "fisher_g1": fisher_g1(x), "bowley_skew": bowley(x),
           "mean": float(x.mean()), "median": float(np.median(x)),
           "p25": float(np.percentile(x, 25)), "p75": float(np.percentile(x, 75)),
           "min": float(x.min()), "max": float(x.max())}
    sub = RNG.choice(x, size=min(n_shapiro, x.size), replace=False)
    sw = stats.shapiro(sub); k2 = stats.normaltest(x)
    out["shapiro_W_subsample"] = {"W": float(sw.statistic), "p": float(sw.pvalue), "n": int(sub.size)}
    out["dagostino_K2_pooled"] = {"stat": float(k2.statistic), "p": float(k2.pvalue)}
    results[name] = out
    return x

x_all_raw = describe(X_all.ravel(), "pooled_all_samples_raw")
x_tum_raw = describe(X_tum.ravel(), "pooled_tumor_only_raw")
x_all_log = describe(np.log2(X_all.ravel() + 1.0), "pooled_all_samples_log2")
ge_c = ge.groupby(level=0).mean()
x_dup_raw = describe(ge_c.to_numpy(dtype=float).ravel(), "pooled_all_samples_raw_dedup")

# per-gene skewness summary (tumor samples), vectorised
Xt = ge[tumor_cols].to_numpy(float)
m, sd = Xt.mean(1), Xt.std(1, ddof=1)
sk_g = np.where(sd > 0, (Xt.mean(1) * 0), 0)  # placeholder replaced below
n = Xt.shape[1]
m3 = ((Xt - m[:, None])**3).mean(1); m2 = ((Xt - m[:, None])**2).mean(1)
adj = (n*(n-1)) / ((n-2)*(n-3))
g1 = adj * (np.sqrt(n*(n-1))/(n-2)) * (m3 / m2**1.5)
g1 = np.where(m2 > 0, g1, np.nan)
per_gene_skew = pd.Series(g1, index=ge.index)
Xl = np.log2(Xt + 1.0)
ml, sdl = Xl.mean(1), Xl.std(1, ddof=1)
m3l = ((Xl - ml[:, None])**3).mean(1); m2l = ((Xl - ml[:, None])**2).mean(1)
g1l = adj * (np.sqrt(n*(n-1))/(n-2)) * (m3l / m2l**1.5)
g1l = np.where(m2l > 0, g1l, np.nan)
per_gene_skew_log = pd.Series(g1l, index=ge.index)

n_valid = int(np.isfinite(g1).sum())
results["per_gene_skew_tumor_raw"] = {
    "n_genes": int(per_gene_skew.size), "n_valid_nonzero_variance_genes": n_valid, "median": float(per_gene_skew.median()),
    "mean": float(per_gene_skew.mean()), "q1": float(per_gene_skew.quantile(.25)),
    "q3": float(per_gene_skew.quantile(.75)), "frac_gt1": float((per_gene_skew > 1).mean()),
    "frac_gt2": float((per_gene_skew > 2).mean()), "frac_lt0": float((per_gene_skew < 0).mean())}
results["per_gene_skew_tumor_log2"] = {
    "median": float(per_gene_skew_log.median()), "mean": float(per_gene_skew_log.mean()),
    "frac_gt1": float((per_gene_skew_log > 1).mean()), "frac_lt0": float((per_gene_skew_log < 0).mean())}

# ---------------- SVG plotting helpers (no matplotlib available) ----------------
W, H, M = 900, 420, 60
def esc(s): return str(s).replace("&", "&amp;").replace("<", "&lt;")

def svg_open(): return [f'<svg xmlns="http://www.w3.org/2000/svg" width="{W}" height="{H}" font-family="sans-serif">']
def axis_lines(x0, x1, y0, y1):
    return (f'<line x1="{x0}" y1="{y1}" x2="{x1}" y2="{y1}" stroke="black"/>'
            f'<line x1="{x0}" y1="{y0}" x2="{x0}" y2="{y1}" stroke="black"/>')
def xtick(v, px, py, fmt="%.0f"):
    return (f'<line x1="{px:.1f}" y1="{py}" x2="{px:.1f}" y2="{py+5}" stroke="black"/>'
            f'<text x="{px:.1f}" y="{py+18}" font-size="11" text-anchor="middle">{fmt % v}</text>')
def ytick(v, px, py, fmt="%.2f"):
    return (f'<line x1="{px-5}" y1="{py:.1f}" x2="{px}" y2="{py:.1f}" stroke="black"/>'
            f'<text x="{px-8}" y="{py+4:.1f}" font-size="11" text-anchor="end">{fmt % v}</text>')
def title(t): return f'<text x="{W/2}" y="24" font-size="15" text-anchor="middle">{esc(t)}</text>'

def hist_svg(x, title_txt, fname, bins=120, xlim=None, normal_overlay=True, xfmt="%.0f"):
    if xlim is not None:
        x = np.clip(x, xlim[0], xlim[1])
    counts, edges = np.histogram(x, bins=bins)
    dens = counts / counts.sum() / (edges[1]-edges[0])
    x0, x1, y0, y1 = M, W-M, H-M-10, M+30
    lo, hi = (xlim if xlim is not None else (edges[0], edges[-1]))
    def px(v): return x0 + (v-lo)/(hi-lo)*(x1-x0)
    ymax = dens.max()*1.15
    def py(v): return y1 - v/ymax*(y1-y0)
    s = svg_open() + [title_txt and title(title_txt), axis_lines(x0, x1, y0, y1)]
    for i in range(len(counts)):
        if counts[i] == 0: continue
        s.append(f'<rect x="{px(edges[i]):.1f}" y="{py(dens[i]):.1f}" width="{px(edges[i+1])-px(edges[i]):.2f}" '
                 f'height="{y1-py(dens[i]):.1f}" fill="#4878CF" stroke="none"/>')
    if normal_overlay:
        xs = np.linspace(lo, hi, 300)
        pdf = stats.norm.pdf(xs, x.mean(), x.std())
        pts = " ".join(f"{px(v):.1f},{py(min(d, ymax)):.1f}" for v, d in zip(xs, pdf) if px(lo) <= px(v) <= px(hi))
        s.append(f'<polyline points="{pts}" fill="none" stroke="red" stroke-width="2"/>')
    ticks = np.linspace(lo, hi, 7)
    for v in ticks: s.append(xtick(v, px(v), y1, xfmt))
    for v in np.linspace(0, ymax, 5):
        s.append(ytick(v, x0, py(v), "%.4f"))
    s.append(f'<text x="{W/2}" y="{H-8}" font-size="12" text-anchor="middle">value (Fisher g1 = {fisher_g1(x):.2f}, Bowley = {bowley(x):.2f})</text>')
    s.append(f'<text x="16" y="{(y0+y1)/2}" font-size="12" text-anchor="middle" transform="rotate(-90 16 {(y0+y1)/2})">density</text>')
    s.append('</svg>')
    open(f"results/{fname}", "w").write("\n".join(s))

def qq_svg(x, title_txt, fname, max_pts=3000):
    xs = np.sort(x)
    n = len(xs)
    idx = np.linspace(0, n-1, min(max_pts, n)).astype(int)
    xs_s = xs[idx]
    theo = stats.norm.ppf((np.arange(1, len(xs_s)+1)-0.5)/len(xs_s))
    theo = (theo - theo.mean())/theo.std() * xs_s.std() + xs_s.mean()
    x0, x1, y0, y1 = M, W-M, H-M-10, M+30
    lo, hi = min(theo.min(), xs_s.min()), max(theo.max(), xs_s.max())
    pad = (hi-lo)*0.02
    lo, hi = lo-pad, hi+pad
    def px(v): return x0 + (v-lo)/(hi-lo)*(x1-x0)
    def py(v): return y1 - (v-lo)/(hi-lo)*(y1-y0)
    s = svg_open() + [title(title_txt), axis_lines(x0, x1, y0, y1)]
    s.append(f'<line x1="{px(lo):.1f}" y1="{py(lo):.1f}" x2="{px(hi):.1f}" y2="{py(hi):.1f}" stroke="red" stroke-width="1.5"/>')
    for v, t in zip(xs_s, theo):
        s.append(f'<circle cx="{px(t):.1f}" cy="{py(v):.1f}" r="1.2" fill="#4878CF" fill-opacity="0.5"/>')
    for v in np.linspace(lo, hi, 5): s.append(xtick(v, px(v), y1))
    for v in np.linspace(lo, hi, 5): s.append(ytick(v, x0, py(v)))
    s.append(f'<text x="{W/2}" y="{H-8}" font-size="12" text-anchor="middle">theoretical normal quantiles</text>')
    s.append(f'<text x="16" y="{(y0+y1)/2}" font-size="12" text-anchor="middle" transform="rotate(-90 16 {(y0+y1)/2})">sample quantiles</text>')
    s.append('</svg>')
    open(f"results/{fname}", "w").write("\n".join(s))

hist_svg(x_all_raw, "Pooled raw RNA expression, all 328 samples (log-y view, clipped tail)", "hist_raw_all.svg", xlim=(0, 6e5))
hist_svg(x_all_log, "Pooled log2(x+1) RNA expression, all 328 samples", "hist_log2_all.svg", bins=80, xfmt="%.1f")
hist_svg(x_tum_raw, "Pooled raw RNA expression, 285 tumor samples (log-y view, clipped tail)", "hist_raw_tumor.svg", xlim=(0, 6e5))
qq_svg(x_all_raw, "Q-Q plot: raw expression, all 328 samples", "qq_raw_all.svg")
qq_svg(x_all_log, "Q-Q plot: log2(x+1) expression, all 328 samples", "qq_log2_all.svg")
qq_svg(x_tum_raw, "Q-Q plot: raw expression, 285 tumor samples", "qq_raw_tumor.svg")

# per-gene skew histogram
hist_svg(per_gene_skew.dropna().to_numpy(), "Per-gene Fisher g1, 285 tumor samples (raw scale)", "per_gene_skew_hist.svg", bins=90, xfmt="%.0f")

with open("results/skewness_results.json", "w") as f:
    json.dump(results, f, indent=2)
pd.DataFrame({"per_gene_g1_raw": per_gene_skew, "per_gene_g1_log2": per_gene_skew_log}).to_csv("results/per_gene_skew.tsv", sep="\t")
print(json.dumps(results, indent=2))
