#!/usr/bin/env python3
"""
BixBench bix-43 Q2 analysis.
Question: Odds ratio for p53-mediated cell cycle gene regulation (Reactome_2022)
using all significant DEGs (p<0.05, |lfc|>0.5, baseMean>10) for
CBD/cisplatin combination vs DMSO.

EXECUTION PATH DISCLOSURE (recorded up-front, as agreed with the researcher):
- gseapy, pydeseq2 and R/DESeq2 are NOT installed in this environment and there is
  NO network access (verified: DNS resolution fails; no GMT files on disk).
- Therefore the approved fallback path is used:
    (a) DE: self-implemented DESeq2-equivalent negative-binomial GLM
        (median-of-ratios size factors, method-of-moments dispersion with
        DESeq2-style parametric trend, log-link GLM via IRLS, two-sided Wald test).
    (b) Enrichment: Reactome_2022 gseapy.enrichr could NOT be executed. The
        Reactome gene set for the p53-mediated DNA-damage-response term is
        reconstructed from Reactome/MSigDB knowledge (list written out to
        out/reactome_p53_term_reconstructed.txt), and the Enrichr/gseapy
        Odds Ratio formula is recomputed directly from overlaps.
        All reconstruction approximations are flagged in the output.
"""
import json
import numpy as np
import pandas as pd
from scipy import stats
import statsmodels.api as sm
from statsmodels.stats.multitest import multipletests

OUT = {}

# ---------------------------------------------------------------- load inputs
counts = pd.read_csv("data/counts_raw_unfiltered.csv", index_col=0)
layout = pd.read_csv("data/sample_layout.csv")
smap = pd.read_csv("data/ensg_to_gene_name.tsv", sep="\t")

layout["col"] = layout.SampleID.str.replace("-", "_", regex=False)
layout = layout.set_index("col")

OUT["counts_shape"] = list(counts.shape)
OUT["counts_duplicates"] = int(counts.index.duplicated().sum())
OUT["counts_zero_rows"] = int((counts.sum(axis=1) == 0).sum())

# ---------------------------------------------------- groups (approved choice)
# Group 9 'Cisplatin_IC50_CBD_IC50' (CBD/cisplatin combination, non-starvation)
#  vs Group 3 'DMSO'.  Note: 'Cisplatin_IC50_CBD_IC50_Serum_starvation_16h'
#  (Group 10) is a starvation-confounded variant whose matched control would be
#  'DMSO_Serum_starvation' (Group 4); it is NOT used.
COMB = layout.index[layout.Group == "Cisplatin_IC50_CBD_IC50"].tolist()
DMSO = layout.index[layout.Group == "DMSO"].tolist()
samples = DMSO + COMB                      # DMSO first => intercept = DMSO
y = counts[samples].to_numpy(dtype=float)
cond = np.array([0] * len(DMSO) + [1] * len(COMB))
n1, n2 = len(DMSO), len(COMB)
OUT["groups"] = {"combination_n": n2, "DMSO_n": n1,
                 "combination_samples": COMB, "DMSO_samples": DMSO}

# ------------------------------------------------------ size factors (DESeq2)
mask_pos = (y > 0).all(axis=1)
geom = np.exp(np.log(y[mask_pos]).mean(axis=1))
sf = np.median(y[mask_pos] / geom[:, None], axis=0)
sf = sf / np.exp(np.log(sf).mean())        # normalise to mean 1
nc = y / sf                                 # normalised counts
baseMean = nc.mean(axis=1)
OUT["size_factors"] = dict(zip(samples, [round(float(s), 4) for s in sf]))

# ------------------------------------------------------------- dispersion MOM
var_nc = nc.var(axis=1, ddof=1)
mu = baseMean.copy()
mom = np.where(mu > 0, (var_nc - mu) / np.maximum(mu, 1e-12) ** 2, np.nan)

# DESeq2-style parametric trend alpha = a0 + a1/baseMean, robust fit on genes
fit_mask = (mu > 10) & np.isfinite(mom) & (mom >= 0)
for _ in range(10):                        # iteratively drop top alphas (robust)
    x = 1.0 / mu[fit_mask]
    z = mom[fit_mask]
    a1, a0 = np.polyfit(x, z, 1)
    resid = z - (a0 + a1 * x)
    keep = resid <= np.percentile(resid, 95)
    if keep.all():
        break
    idx = np.where(fit_mask)[0][keep]
    new = np.zeros_like(fit_mask)
    new[idx] = True
    fit_mask = new
alpha_trend = np.maximum(a0 + a1 / np.maximum(mu, 1e-12), 1e-8)
OUT["dispersion_trend"] = {"a0": float(a0), "a1": float(a1),
                           "n_fit_genes": int(fit_mask.sum())}

# ----------------------------------------------------------- NB GLM (Wald test)
X = sm.add_constant(cond)
fit_idx = np.where(mu > 10)[0]             # fit only genes that can pass baseMean>10
rows = []
for i in fit_idx:
    yy = y[i]
    if yy.sum() == 0 or (yy > 0).sum() < 2:
        continue
    try:
        res = sm.GLM(yy, X, family=sm.families.NegativeBinomial(alpha=alpha_trend[i])).fit()
        lfc, se = res.params[1], res.bse[1]
        zval = lfc / se
        pval = 2 * stats.norm.sf(abs(zval))
        rows.append((counts.index[i], float(baseMean[i]), float(lfc), float(se),
                     float(zval), float(pval)))
    except Exception:
        continue
res_df = pd.DataFrame(rows, columns=["ENSG", "baseMean", "log2FC", "SE", "z", "pvalue"])
res_df["padj"] = multipletests(res_df.pvalue.values, method="fdr_bh")[1]
res_df = res_df.set_index("ENSG")

# --------------------------------------------------------- literal thresholds
sig = res_df[(res_df.pvalue < 0.05) & (res_df.log2FC.abs() > 0.5) & (res_df.baseMean > 10)]
OUT["n_tested_baseMean_gt10"] = int(len(fit_idx))
OUT["n_significant_p05_absLfc05_baseMean10"] = int(len(sig))
OUT["n_up"] = int((sig.log2FC > 0).sum())
OUT["n_down"] = int((sig.log2FC < 0).sum())
sig.to_csv("out/DEG_significant.csv")
res_df.to_csv("out/DE_results_all_tested.csv")

# robustness note (optional, padj side)
OUT["n_significant_padj05"] = int(((res_df.padj < 0.05) & (res_df.log2FC.abs() > 0.5)
                                   & (res_df.baseMean > 10)).sum())

# --------------------------------------------------------- ENSG -> gene symbol
emap = smap.set_index("ENSG").gene_name
sig2 = sig.copy()
sig2["gene_name"] = sig2.index.map(emap)
unmapped = int(sig2.gene_name.isna().sum())
sig2 = sig2.dropna(subset=["gene_name"])
gene_list_all = sig2.gene_name.tolist()            # with duplicates
gene_list = sorted(set(gene_list_all))             # unique symbols (dedup)
OUT["DEG_mapping"] = {"unmapped_ENSG": unmapped,
                      "n_with_symbol": int(len(sig2)),
                      "n_unique_symbols": len(gene_list),
                      "duplicates_collapsed": int(len(gene_list_all) - len(gene_list))}
sig2.to_csv("out/DEG_significant_with_symbol.csv")
with open("out/DEG_unique_symbols.txt", "w") as f:
    f.write("\n".join(gene_list))

# ============================================================ ENRICHMENT (fallback)
# Reactome_2022 gseapy.enrichr NOT executable (no network). Reconstructed
# Reactome gene set for the p53-mediated DNA-damage-response / cell-cycle term.
# Content = curated Reactome "p53 pathway" gene content (signalling + p53
# transcriptional programme incl. cell-cycle regulation), written out for audit.
P53_SET = sorted(set("""
ATM ATR CHEK1 CHEK2 TP53 MDM2 MDM4 CDKN2A PPM1D CREBBP EP300 KAT5 SIRT1 HIPK2
PIDD1 RCHY1 TP53BP1 PML DDB1 DDB2 CUL4A CUL4B XPC RPA1 RPA2 RPA3 ATRIP TOPBP1
RAD17 RAD9A RAD1 HUS1 MRE11 RAD50 NBN CLSPN TIMELESS TIPIN
CDKN1A GADD45A GADD45B GADD45G BTG2 BTG3 BBC3 PMAIP1 BAX BCL2L11 BCL2 MCL1
FAS TNFRSF10A TNFRSF10B APAF1 IGFBP3 IER3 AEN OGG1 MUTYH POLH POLK RRM2B
SESN1 SESN2 SESN3 C12orf5 STEAP3 SLC7A11 FDXR E2F1 E2F7 E2F8 CDC25A CDC25C
CDK1 CDK2 CCNG1 GTSE1 SCARA3 ADGRB1 TP53I3 TP53TG1 RPS27L SERPINE1 WEE1
CABLES1 PERP
""".split()))
with open("out/reactome_p53_term_reconstructed.txt", "w") as f:
    f.write("\n".join(P53_SET))

# Enrichr/gseapy parameters (assumptions, flagged):
#  M = number of annotated genes in the Reactome_2022 Enrichr library (~2,393
#  gene sets) -> assumed 11,000; sensitivity shown for 10k and 15k.
#  OR (Enrichr-style, primary) = (k/N) / (K/M)
#  OR (Fisher cross-product, secondary) = k*(M-K-N+k) / ((N-k)*(K-k))
def enrichment(genes, K, M):
    q = set(genes)
    k = len(q & set(K))
    N = len(q)
    K = len(set(K))
    or_ratio = (k / N) / (K / M)
    a, b, c, d = k, N - k, K - k, M - K - N + k
    or_fisher = (a * d) / (b * c) if b * c > 0 else float("inf")
    p_hyper = stats.hypergeom.sf(k - 1, M, K, N)
    return {"overlap": int(k), "query_N": N, "set_K": K, "library_M": M,
            "odds_ratio_enrichr": round(or_ratio, 4),
            "odds_ratio_fisher": round(or_fisher, 4),
            "p_hypergeometric": p_hyper}

K_p53 = P53_SET
rows_or = []
for M in (10000, 11000, 15000):
    rows_or.append({"library_M": M, **enrichment(gene_list, K_p53, M)})
OUT["enrichment_p53_mediated_dna_damage_response"] = rows_or
OUT["reconstructed_set_size"] = len(P53_SET)

# exploratory split (documented as secondary)
up = sorted(set(sig2.gene_name[sig2.log2FC > 0]))
dn = sorted(set(sig2.gene_name[sig2.log2FC < 0]))
OUT["exploratory_up_down"] = {
    "up": enrichment(up, K_p53, 11000),
    "down": enrichment(dn, K_p53, 11000)}

with open("out/summary.json", "w") as f:
    json.dump(OUT, f, indent=2, default=str)
print(json.dumps(OUT, indent=2, default=str))
