#!/usr/bin/env python3
"""
BixBench bix-46-q1 analysis:
log2 fold change of mexG in ΔrhlI (strain #97) vs WT (strain #1).

Inputs:
  data/res_1vs97.rds                     DESeq2 DESeqResults object, contrast "Strain 97 vs 1"
  data/Pseudomonas_aeruginosa_UCBPP-PA14.csv  Pseudomonas Genome DB annotation (PGD Gene ID, Locus Tag, Gene Name, ...)

Method:
  1. Read the DESeqResults RDS with a pure-Python R XDR-serialization (v3) parser
     (no R runtime available in this environment; parser validated by exact
     byte consumption and internal consistency checks).
  2. Map gene name "mexG" -> Locus Tag via the annotation CSV (unique match).
  3. Locate the gene BY ROW NAME (rownames = PA14 locus tags) in the results
     object -- never by row index (row order differs between result files).
  4. Take the stored log2FoldChange column (MLE, "Strain 97 vs 1") as-is;
     report padj as supporting evidence; round to 2 decimals.
"""
import csv, gzip, struct, sys, os

HERE = os.path.dirname(os.path.abspath(__file__))
DATA = os.path.join(HERE, '..', 'data')

NA_REAL_BITS = 0x7ff00000000007a2

class Nil:
    def __repr__(self): return "NULL"
NIL = Nil()

class PairList(list):
    def get(self, tag):
        for t, v in self:
            if t == tag: return v
    def tags(self): return [t for t, _ in self]

class RSym(str): pass

class RObj:
    def __init__(self, attrs): self.attrs = attrs
    def slot(self, name): return self.attrs.get(name) if self.attrs else None

class Reader:
    def __init__(self, data):
        self.d = data; self.pos = 0; self.refs = []
    def i32(self):
        v = struct.unpack('>i', self.d[self.pos:self.pos+4])[0]; self.pos += 4; return v
    def f64(self):
        raw = self.d[self.pos:self.pos+8]; self.pos += 8
        v = struct.unpack('>d', raw)[0]
        if struct.unpack('>Q', raw)[0] == NA_REAL_BITS: v = None   # R NA_real_
        return v
    def raw(self, n):
        b = self.d[self.pos:self.pos+n]; self.pos += n; return b

def as_str(x):
    if isinstance(x, RSym): return str(x)
    if isinstance(x, bytes): return x.decode('utf-8', 'replace')
    if isinstance(x, str): return None if x == 'NA_STRING' else x
    return x

def read_item(r):
    flags = r.i32()
    if (flags & 255) == 255:                      # REFSXP: packed or explicit index
        idx = r.i32() if flags == 255 else (flags >> 8)
        if idx > 0:
            return r.refs[idx - 1]
        return ('ENV_REF', idx)                   # negative: special environments (not needed)
    t = flags & 255
    if t in (0, 254):                             # NILSXP / NILVALUE_SXP
        obj = NIL
    else:
        tag = read_item(r) if (flags & 0x400) else None
        if t == 1:                                # SYMSXP
            obj = RSym(as_str(read_item(r)))
        elif t == 9:                              # CHARSXP
            n = r.i32(); obj = r.raw(n) if n >= 0 else 'NA_STRING'
        elif t in (10, 13):                       # LGLSXP / INTSXP
            n = r.i32(); obj = [r.i32() for _ in range(n)]
        elif t == 14:                             # REALSXP
            n = r.i32(); obj = [r.f64() for _ in range(n)]
        elif t == 16:                             # STRSXP
            n = r.i32(); obj = [as_str(read_item(r)) for _ in range(n)]
        elif t == 17:                             # CPLXSXP
            n = r.i32(); obj = [(r.f64(), r.f64()) for _ in range(n)]
        elif t in (19, 20):                       # VECSXP / EXPRSXP
            n = r.i32(); obj = [read_item(r) for _ in range(n)]
        elif t == 24:                             # RAWSXP
            n = r.i32(); obj = r.raw(n)
        elif t == 25:                             # S4SXP
            obj = RObj(None)
        elif t in (2, 6):                         # LISTSXP / LANGSXP pairlist node
            car = read_item(r); cdr = read_item(r)
            pairs = [(tag, car)]
            while isinstance(cdr, PairList):
                pairs.extend(cdr); cdr = NIL
            obj = PairList(pairs)
        else:
            raise ValueError(f"unhandled R type {t} (flags {flags:#x}) at byte {r.pos - 4}")
    if flags & 0x200:                             # attributes follow the payload
        attrs = read_item(r)
        if isinstance(obj, RObj):
            obj.attrs = attrs
        elif attrs is not None:
            obj = _WithAttrs(obj, attrs)
    if t == 1:                                    # symbols are the reference-tracked objects here
        r.refs.append(obj)
    return obj

class _WithAttrs(list):
    def __init__(self, items, attrs):
        super().__init__(items); self.attrs = attrs

def parse_rds(path):
    data = gzip.decompress(open(path, 'rb').read())
    assert data[:2] == b'X\n', "not an XDR R stream"
    r = Reader(data); r.pos = 2
    version = r.i32(); r.i32(); r.i32()           # version, writer, min reader
    if version >= 3:
        n = r.i32(); r.raw(n).decode()            # native encoding name
    obj = read_item(r)
    assert r.pos == len(data), f"incomplete parse: {r.pos}/{len(data)}"
    return obj

def extract_results(obj):
    """rownames + named columns of a serialized DESeqResults/DataFrame S4."""
    assert isinstance(obj, RObj), "top-level object is not an S4 (DESeqResults)"
    a = obj.attrs
    cls_val = a.get('class')
    cls = [as_str(x) for x in cls_val] if hasattr(cls_val, '__iter__') else cls_val
    assert cls == ['DESeqResults'], f"unexpected class: {cls}" 
    rownames = a.get('rownames')
    listdata = a.get('listData')                  # _WithAttrs list of columns
    colnames = listdata.attrs.get('names')
    assert len(colnames) == len(listdata)
    return rownames, dict(zip(colnames, listdata))

def main():
    # --- annotation: gene name -> locus tag ---
    with open(os.path.join(DATA, 'Pseudomonas_aeruginosa_UCBPP-PA14.csv'),
              newline='', encoding='utf-8') as f:
        rows = [row for row in csv.DictReader(f)
                if (row['Gene Name'] or '').strip().lower() == 'mexg']
    assert len(rows) == 1, f"expected unique mexG annotation, got {len(rows)}"
    ann = rows[0]
    locus_tag = ann['Locus Tag']
    print(f"[annotation] mexG -> PGD Gene ID={ann['PGD Gene ID']}, Locus Tag={locus_tag}")

    # --- results table for strain 97 vs 1 ---
    obj = parse_rds(os.path.join(DATA, 'res_1vs97.rds'))
    rownames, cols = extract_results(obj)
    print(f"[res_1vs97] genes={len(rownames)}, columns={list(cols)}")
    assert locus_tag in rownames, f"{locus_tag} not found in rownames"
    i = rownames.index(locus_tag)                 # match BY ROW NAME
    base_mean  = cols['baseMean'][i]
    lfc        = cols['log2FoldChange'][i]
    lfc_se     = cols['lfcSE'][i]
    stat       = cols['stat'][i]
    pvalue     = cols['pvalue'][i]
    padj       = cols['padj'][i]

    rounded = round(lfc, 2)
    print(f"[mexG / PA14_09540] row index (positional, informational only) = {i}")
    print(f"  baseMean        = {base_mean!r}")
    print(f"  log2FoldChange  = {lfc!r}")
    print(f"  lfcSE           = {lfc_se!r}")
    print(f"  stat            = {stat!r}")
    print(f"  pvalue          = {pvalue!r}")
    print(f"  padj            = {padj!r}")
    print(f"  log2FoldChange rounded to 2 decimals = {rounded}")

    # --- cross-check with res_1vs98 (different contrast; confirms row-name mapping) ---
    obj98 = parse_rds(os.path.join(DATA, 'res_1vs98.rds'))
    rn98, cols98 = extract_results(obj98)
    j = rn98.index(locus_tag)
    print(f"[cross-check res_1vs98] same gene found at row index {j} (differs from {i}: "
          f"row order is not comparable), baseMean identical = "
          f"{cols98['baseMean'][j] == base_mean}")

    assert abs(rounded - (-4.96)) < 1e-12, f"unexpected result {rounded}"
    print(f"\nANSWER: mexG log2 fold change (ΔrhlI strain #97 vs WT strain #1) = {rounded}")

    with open(os.path.join(HERE, 'mexG_result.txt'), 'w') as f:
        f.write(f"gene_name=mexG\nlocus_tag={locus_tag}\npgd_gene_id={ann['PGD Gene ID']}\n"
                f"contrast=Strain 97 vs 1 (DESeq2 MLE, stored log2FoldChange column)\n"
                f"baseMean={base_mean!r}\nlog2FoldChange={lfc!r}\nlfcSE={lfc_se!r}\n"
                f"stat={stat!r}\npvalue={pvalue!r}\npadj={padj!r}\nlog2FoldChange_2dp={rounded}\n")

if __name__ == '__main__':
    main()
