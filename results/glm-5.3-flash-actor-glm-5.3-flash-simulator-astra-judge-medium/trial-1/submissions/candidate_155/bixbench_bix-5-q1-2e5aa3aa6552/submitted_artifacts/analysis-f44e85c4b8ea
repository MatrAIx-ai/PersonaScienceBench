"""
Differential expression: ASXL1 fibroblast disease vs control.
Design: ~ condition + sex ; 14 metadata-matched samples (MGD1640F/MGD1641F dropped).
DESeq2-style NB GLM (vectorized):
  median-of-ratios size factors -> alternating NB-GLM beta / per-gene dispersion MLE
  -> parametric trend alpha = a0 + a1/mu -> EB MAP shrinkage (log-normal prior, capped at MLE)
  -> final IRLS at moderated dispersion -> Wald test on condition_disease -> BH FDR.
Prefilter: raw counts >= 10 in >= 3 samples. Up: padj<0.05 & log2FC>1.
"""
import numpy as np, pandas as pd
from scipy.special import gammaln, digamma

counts = pd.read_csv('data/Issy_ASXL1_fibro_featureCounts_GeneTable_final.txt', sep=r'\s+', index_col=0)
counts.columns = [c.strip() for c in counts.columns]
coldata = pd.read_excel('data/Issy_ASXL1_fibro_coldata_gender.xlsx')
coldata['condition'] = coldata['condition'].astype(str).str.strip()
coldata['sex'] = coldata['sex'].astype(str).str.strip()

samples = [s for s in coldata['sample'] if s in counts.columns]
dropped = [c for c in counts.columns if c not in samples]
cts = counts[samples].astype(np.int64)
cd = coldata.set_index('sample').loc[samples]
print('samples used:', len(samples), '| dropped count-only columns:', dropped)
print('condition:', cd['condition'].value_counts().to_dict(), '| sex:', cd['sex'].value_counts().to_dict())
print(pd.crosstab(cd['condition'], cd['sex']))

X = np.column_stack([np.ones(len(samples)),
                     (cd['condition'] == 'disease').astype(float).values,
                     (cd['sex'] == 'M').astype(float).values])
n, p = X.shape
keep = (cts >= 10).sum(axis=1) >= 3
print(f'prefilter (>=10 counts in >=3 samples): kept {keep.sum()} / {len(cts)} genes')
cts_f = cts[keep]
genes = cts_f.index.values
Y = cts_f.values.astype(float)
G = Y.shape[0]

loggeo = np.log(np.where(Y > 0, Y, np.nan))
sf = np.median(Y / np.exp(np.nanmean(loggeo, axis=1))[:, None], axis=0)
sf = sf / sf.mean()
print('size factors:', dict(zip(samples, np.round(sf, 4))))
off = np.log(sf)[None, :]

def nb_dev(Y, mu, alpha):
    r = (1.0 / alpha)[:, None]
    mur = np.maximum(mu, 1e-300); yr = np.maximum(Y, 1e-300)
    t1 = np.where(Y > 0, Y * np.log(yr / mur), 0.0)
    t2 = (Y + r) * np.log((Y + r) / (mur + r))
    return 2.0 * (t1 - t2)

def irls(Y, off, alpha, X, iters=100):
    # Fisher scoring with vectorized step-halving on NB deviance (monotone, stable)
    beta = np.linalg.lstsq(X, np.log(Y / np.exp(off) + 0.5).T, rcond=None)[0].T
    eye = np.eye(X.shape[1])
    eta = np.clip(beta @ X.T + off, -10, 15)
    mu = np.exp(eta)
    dev = nb_dev(Y, mu, alpha).sum(axis=1)
    done = np.zeros(len(beta), dtype=bool)
    for _ in range(iters):
        if done.all(): break
        eta = np.clip(beta @ X.T + off, -10, 15)
        mu = np.exp(eta)
        var = mu + alpha[:, None] * mu ** 2
        w = np.clip(mu ** 2 / var, 1e-12, None)
        z = eta + (Y - mu) / var * mu
        A = np.einsum('gn,ni,nj->gij', w, X, X)
        idx = np.arange(X.shape[1])
        A[:, idx, idx] += 1e-10
        A[:, idx, idx] += 1e-8 * np.maximum(np.einsum('gii->g', A) / X.shape[1], 1e-8)[:, None]
        b = np.einsum('gn,ni,gn->gi', w, X, z)
        step = np.linalg.solve(A, b[..., None])[..., 0] - beta
        lam = np.ones(len(beta))
        active = ~done
        for _h in range(40):
            act = active & (lam > 1e-8)
            if not act.any(): break
            beta_try = beta + lam[:, None] * step
            mu_try = np.exp(np.clip(beta_try @ X.T + off, -10, 15))
            dev_try = nb_dev(Y, mu_try, alpha).sum(axis=1)
            ok = act & (dev_try <= dev + 1e-10)
            lam[act & ~ok] /= 2
        beta_try = beta + lam[:, None] * step
        mu_try = np.exp(np.clip(beta_try @ X.T + off, -10, 15))
        dev_try = np.minimum(nb_dev(Y, mu_try, alpha).sum(axis=1), dev)
        converged = (np.max(np.abs(lam[:, None] * step), axis=1) < 1e-8) & active
        beta = np.where(active[:, None], beta_try, beta)
        dev = np.where(active, dev_try, dev)
        done = converged
    return beta

def nbll(Y, mu, alpha):
    r = (1.0 / alpha)[:, None]
    return (gammaln(Y + r) - gammaln(r) - gammaln(Y + 1)
            + r * np.log(r) + Y * np.log(np.maximum(mu, 1e-12))
            - (r + Y) * np.log(r + np.maximum(mu, 1e-12))).sum(axis=1)

def alpha_mle_given_beta(Y, mu, lo=-10.0, hi=np.log(100.0)):
    G_ = Y.shape[0]
    lo = np.full(G_, lo); hi = np.full(G_, hi)
    for _ in range(60):
        mid = 0.5 * (lo + hi)
        r = (1.0 / np.exp(mid))[:, None]
        mur = np.maximum(mu, 1e-12)
        g = (digamma(Y + r) - digamma(r) + np.log(r / (r + mur))
             + (mur - Y) / (r + mur)).sum(axis=1)
        lo = np.where(g < 0, mid, lo)
        hi = np.where(g < 0, hi, mid)
    return np.exp(0.5 * (lo + hi))

# alternating joint fit
alpha = np.full(G, 0.1)
beta = irls(Y, off, alpha, X)
for it in range(8):
    mu = np.exp(np.clip(beta @ X.T + off, -10, 15))
    alpha_new = alpha_mle_given_beta(Y, mu)
    beta = irls(Y, off, alpha_new, X)
    if np.max(np.abs(np.log(alpha_new / alpha))) < 1e-3:
        alpha = alpha_new; break
    alpha = alpha_new
mu0 = np.exp(np.clip(beta @ X.T + off, -10, 15))
alpha_mle = alpha
print('alpha_mle quantiles:', np.quantile(alpha_mle, [0, .25, .5, .75, .95, 1]).round(4))

# dispersion trend alpha = a0 + a1/mu (robust)
mu_mean = Y.sum(axis=1) / n / sf.mean()
muo, aio = mu_mean.copy(), alpha_mle * mu_mean
for _ in range(5):
    A = np.vstack([muo, np.ones_like(muo)]).T
    coef, *_ = np.linalg.lstsq(A, aio, rcond=None)
    resid = aio - A @ coef
    s = np.median(np.abs(resid)) * 1.4826
    m = np.abs(resid) < 3 * max(s, 1e-12)
    if m.all(): break
    muo, aio = muo[m], aio[m]
a1, a0 = max(coef[0], 1e-12), max(coef[1], 1e-12)
print(f'dispersion trend: alpha = {a0:.4g} + {a1:.4g}/mu')
alpha_trend = np.maximum(a0 + a1 / np.maximum(mu_mean, 1e-8), 1e-8)

resid_log = np.log(alpha_mle) - np.log(alpha_trend)
sigma2 = max(np.var(resid_log[resid_log < np.quantile(resid_log, 0.95)]), 1e-4)
print(f'prior log-variance sigma2 = {sigma2:.4f}')

lt, ht = np.full(G, -10.0), np.full(G, np.log(100.0))
gr = (np.sqrt(5) - 1) / 2
c, d = ht - gr * (ht - lt), lt + gr * (ht - lt)
def map_obj(loga):
    alpha = np.exp(loga)
    r = (1.0 / alpha)[:, None]
    ll = (gammaln(Y + r) - gammaln(r) - gammaln(Y + 1)
          + r * np.log(r) + Y * np.log(np.maximum(mu0, 1e-12))
          - (r + Y) * np.log(r + np.maximum(mu0, 1e-12))).sum(axis=1)
    return -ll + 0.5 * (loga - np.log(alpha_trend)) ** 2 / sigma2
oc, od = map_obj(c), map_obj(d)
for _ in range(80):
    take_left = oc < od
    ht = np.where(take_left, d, ht); lt = np.where(take_left, lt, c)
    c = ht - gr * (ht - lt); d = lt + gr * (ht - lt)
    oc, od = map_obj(c), map_obj(d)
alpha_map = np.exp(0.5 * (lt + ht))
alpha_final = np.minimum(alpha_map, alpha_mle)
print('alpha_final quantiles:', np.quantile(alpha_final, [0, .25, .5, .75, .95, 1]).round(4))

# final fit at moderated dispersion + Wald test
beta = irls(Y, off, alpha_final, X)
mu = np.exp(np.clip(beta @ X.T + off, -10, 15))
w = np.clip(mu ** 2 / (mu + alpha_final[:, None] * mu ** 2), 1e-12, None)
A = np.einsum('gn,ni,nj->gij', w, X, X)
cov = np.linalg.inv(A)
se = np.sqrt(np.maximum(cov[:, 1, 1], 1e-18))
z = beta[:, 1] / se
from scipy.stats import norm as _norm
pval = 2 * _norm.sf(np.abs(z))

res = pd.DataFrame({'baseMean': mu_mean, 'log2FoldChange': beta[:, 1] / np.log(2),
                    'lfcSE': se / np.log(2), 'stat': z, 'pvalue': pval}, index=genes)
def bh(pv):
    pv = np.asarray(pv); m = len(pv); o = np.argsort(pv)
    q = pv[o] * m / (np.arange(m) + 1)
    q = np.minimum.accumulate(q[::-1])[::-1]
    out = np.empty(m); out[o] = np.minimum(q, 1.0); return out
res['padj'] = bh(res['pvalue'].values)
print('tested genes after prefilter:', len(res))
up = res[(res.padj < 0.05) & (res.log2FoldChange > 1)]
down = res[(res.padj < 0.05) & (res.log2FoldChange < -1)]
print(f'UP (padj<0.05 & LFC>1): {len(up)} | DOWN (padj<0.05 & LFC<-1): {len(down)} | any padj<0.05: {(res.padj<0.05).sum()}')
print('pvalue quantiles:', res.pvalue.quantile([0,.05,.25,.5,.75,.95,1]).round(4).to_dict())

gen = pd.read_csv('data/gencode.v31.primary_assembly.genes.csv', low_memory=False)
sym = gen.set_index('gene_id')['gene_name']
res['gene_id'] = res.index.str.replace(r'\.\d+$', '', regex=True)
res['gene_name'] = sym.reindex(res.index).values
hg = pd.read_csv('data/HGNC_05-09-19.txt', sep='\t')
hg_ens = set(hg['Ensembl ID(supplied by Ensembl)'].dropna().str.split('|').explode().str.strip())
res['hgnc_mapped'] = res['gene_id'].isin(hg_ens)
res.sort_values('pvalue').to_csv('results/DE_results_condition_sex.csv')
up = res.loc[up.index]
up.sort_values('padj').to_csv('results/upregulated_padj0.05_lfcGT1.csv')
print('upregulated genes with HGNC Ensembl mapping:', up['hgnc_mapped'].sum(), '/', len(up))
print(up.sort_values('padj').head(20)[['gene_name', 'baseMean', 'log2FoldChange', 'lfcSE', 'padj']].to_string())
print('wrote results/DE_results_condition_sex.csv and results/upregulated_padj0.05_lfcGT1.csv')
