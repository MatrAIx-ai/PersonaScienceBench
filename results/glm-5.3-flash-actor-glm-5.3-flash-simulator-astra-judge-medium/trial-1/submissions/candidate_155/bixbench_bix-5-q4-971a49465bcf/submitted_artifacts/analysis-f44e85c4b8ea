Xm = np.column_stack([np.ones(len(cond)), cond])
logcpm = np.log2(NF + 1)
dfr = Xm.shape[0] - 2
B = np.linalg.lstsq(Xm, np.asarray(logcpm).T, rcond=None)[0]
resid = np.asarray(logcpm).T - Xm @ B
s2 = (resid**2).sum(0) / dfr
f = np.sqrt(np.diag(np.linalg.inv(Xm.T @ Xm)))[1]
t0 = B[1] / (np.sqrt(s2) * f)
pv_raw = 2*st.t.sf(np.abs(t0), df=dfr)
usable = np.isfinite(s2) & (s2 > 0)
lsv2 = np.log(s2[usable]); mu, v = lsv2.mean(), lsv2.var(ddof=1)
d0 = 2*(1+v)/max(v-1, 1e-6) if v > 1 else 2.0
d0 = max(d0, 0.05)
s2_0 = np.exp(mu)
s2_post = (d0*s2_0 + dfr*s2) / (d0 + dfr)
tt = B[1] / (np.sqrt(s2_post) * f)
pv_l = 2*st.t.sf(np.abs(tt), df=d0 + dfr)
pa_l = multipletests(pv_l, method='fdr_bh')[1]
lfc_l = B[1] / np.log(2)
