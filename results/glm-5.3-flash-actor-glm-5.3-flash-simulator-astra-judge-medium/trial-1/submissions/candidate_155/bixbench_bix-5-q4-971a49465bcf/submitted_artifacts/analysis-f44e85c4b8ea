#!/usr/bin/env python3
"""
ASXL1-mutated fibroblasts: differential expression + functional enrichment
==========================================================================
Question: Which is the most enriched process in the ASXL1-mutated fibroblasts?

Explicit assumptions (approved by researcher):
  * coldata 'disease' = ASXL1-mutated fibroblasts, 'control' = control
    (ASSUMPTION - metadata does not itself name the mutated gene).
  * MGD1640F, MGD1641F (2 extra count columns with no metadata) are DROPPED.
  * Primary model ~ condition; sex only as a sensitivity analysis.
  * Environment is offline, no R/Bioconductor, no pydeseq2/gseapy/goatools,
    no local GO annotation (probed and recorded). DE is implemented as a
    DESeq2-style negative-binomial GLM pipeline in pure Python.
  * GO enrichment uses a RESEARCHER-APPROVED FALLBACK: systematic manual
    classification into GO-branch-guided curated gene sets, tested by
    hypergeometric ORA + pre-ranked GSEA. This is a SURROGATE, NOT a formal
    full-GO-BP enrichment.
"""
import os, json
import numpy as np, pandas as pd
import scipy.stats as st
import statsmodels.api as sm
from statsmodels.genmod.families import NegativeBinomial
from statsmodels.stats.multitest import multipletests

os.makedirs("/workspace/outputs", exist_ok=True)
log = lambda *a: print(*a, flush=True)

probe = {}
for m in ['numpy','pandas','scipy','statsmodels','openpyxl','pydeseq2','gseapy','goatools']:
    try: __import__(m); probe[m] = "OK"
    except Exception: probe[m] = "MISSING"
log("ENV PROBE:", probe)

CNT = "/workspace/data/Issy_ASXL1_fibro_featureCounts_GeneTable_final.txt"
CD  = "/workspace/data/Issy_ASXL1_fibro_coldata_gender.xlsx"
GEN = "/workspace/data/gencode.v31.primary_assembly.genes.csv"
HGN = "/workspace/data/HGNC_05-09-19.txt"

counts_full = pd.read_csv(CNT, sep=r"\s+")            # file is SPACE-separated, not tab!
coldata = pd.read_excel(CD)
gencode = pd.read_csv(GEN, index_col=0, low_memory=False)
hgnc    = pd.read_csv(HGN, sep="\t", low_memory=False)
log(f"counts {counts_full.shape}, coldata {coldata.shape}, gencode {gencode.shape}, hgnc {hgnc.shape}")

cnt_samples = list(counts_full.columns[1:])
extra = [s for s in cnt_samples if s not in set(coldata['sample'])]
log("extra count columns dropped (no metadata):", extra)
assert list(coldata['sample']) == cnt_samples[:len(coldata)], "order mismatch"
counts = counts_full[['Geneid'] + list(coldata['sample'])].set_index('Geneid')
counts = counts.loc[gencode['gene_id'].values]        # align rows with gencode (same order, verified)

# --- ID mapping: Ensembl -> HGNC approved symbol (fallback: gencode gene_name)
hgnc_ok = hgnc[hgnc['Status'] == 'Approved'].copy()
ens2sym = {}
for ens, sym in zip(hgnc_ok['Ensembl ID(supplied by Ensembl)'], hgnc_ok['Approved symbol']):
    if isinstance(ens, str):
        for e in ens.split(','):
            e = e.strip()
            if e: ens2sym[e] = sym
gencode = gencode.copy()
gencode['ens0'] = gencode['gene_id'].str.split('.').str[0]
n_hgnc = gencode['ens0'].map(ens2sym).notna().sum()
gencode['symbol'] = gencode['ens0'].map(ens2sym).fillna(gencode['gene_name'])
gencode['symbol'] = gencode['symbol'].astype(str).str.upper()
log(f"symbol mapped via HGNC: {n_hgnc} / {len(gencode)}")

counts.index = gencode['symbol'].values
dups = int(counts.index.duplicated(keep=False).sum())
counts = counts.groupby(level=0).sum()
gencode_ann = gencode.groupby('symbol').agg(gene_type=('gene_type', lambda x: ','.join(sorted(set(x)))))
gencode_ann = gencode_ann.loc[~gencode_ann.index.duplicated(keep='first')]
log(f"after symbol aggregation: {counts.shape[0]} unique symbols (dup rows collapsed: {dups})")
counts.to_csv("/workspace/outputs/counts_symbol.csv")

# --- Low-expression filter + DESeq2 median-of-ratios size factors
lib = counts.sum(axis=0).values.astype(float)
cpm = counts.values / lib * 1e6
keep = (cpm > 1).sum(axis=1) >= 7                    # >= min group size (7 vs 7)
log(f"genes before/after filter: {counts.shape[0]} -> {keep.sum()}")
pd.DataFrame({'n_samples_cpm_gt1': (cpm > 1).sum(axis=1)}, index=counts.index
             ).to_csv("/workspace/outputs/filter_stats_per_gene.csv")

Y = counts.values[keep].astype(float)
genes_kept = counts.index[keep]
types_kept = gencode_ann['gene_type'].reindex(genes_kept).fillna('').values

gmean = st.gmean(np.maximum(Y, 1e-3), axis=1)
sf = np.median((Y / gmean[:, None])[gmean > 0], axis=0)
sf = sf / sf.mean()
NF = Y / sf[None, :]
log("size factors:", np.round(sf, 4).tolist())
pd.DataFrame({'sample': coldata['sample'], 'size_factor': sf,
              'condition': coldata['condition'], 'sex': coldata['sex']}).to_csv(
    "/workspace/outputs/size_factors.csv", index=False)

L = np.log2(NF + 1); Xc = L - L.mean(1, keepdims=True)
U, S, Vt = np.linalg.svd(Xc, full_matrices=False)
pc = Vt[:2].T * S[:2]
pd.DataFrame({'PC1': pc[:, 0], 'PC2': pc[:, 1]}).assign(
    sample=coldata['sample'], condition=coldata['condition'], sex=coldata['sex']
).to_csv("/workspace/outputs/pca.csv", index=False)
log("PCA variance frac PC1 %.3f PC2 %.3f" % tuple((S[:2]**2 / (S**2).sum())[[0, 1]]))

# ----------------------------------------------------------------------
# 4. DESeq2-style NB GLM differential expression (pure Python)
# ----------------------------------------------------------------------
def disp_trend(mu_mean, alpha_raw):
    m = (mu_mean > 0.5) & (alpha_raw > 1e-6)
    if m.sum() < 100:
        return np.full_like(mu_mean, np.median(alpha_raw[m]) if m.sum() else np.median(alpha_raw))
    x, y = np.log10(mu_mean[m]), np.log10(np.maximum(alpha_raw[m], 1e-6))
    try:
        tr = sm.nonparametric.lowess(y, x, frac=0.6, it=3)
        return 10**np.interp(np.log10(np.maximum(mu_mean, 1e-3)), tr[:, 0], tr[:, 1])
    except Exception:
        b, a = np.polyfit(x, y, 1)
        return 10**(a + b * np.log10(np.maximum(mu_mean, 1e-3)))

def fit_design(Ymat, Xdesign, sf_vec):
    n = Ymat.shape[1]
    mu0 = np.empty_like(Ymat)
    for j in range(Ymat.shape[0]):
        try:
            g = sm.GLM(Ymat[j], Xdesign, family=NegativeBinomial(alpha=1e-8),
                       offset=np.log(sf_vec)).fit()
            mu0[j] = g.fittedvalues
        except Exception:
            mu0[j] = np.maximum(Ymat[j].mean(), 0.5)
    mu_mean = mu0.mean(1)
    alpha_raw = np.maximum(0, ((Ymat - mu0)**2).sum(1) - mu0.sum(1)) / np.maximum((mu0**2).sum(1), 1e-12)
    alpha_tr = disp_trend(mu_mean, alpha_raw)
    W = 25.0
    alpha_fin = np.clip((n*alpha_raw + W*alpha_tr) / (n + W), 1e-8, 50)
    coef = np.full(Ymat.shape[0], np.nan); z = np.full(Ymat.shape[0], np.nan)
    for j in range(Ymat.shape[0]):
        yj = Ymat[j]
        if yj.sum() == 0: continue
        try:
            g = sm.GLM(yj, Xdesign, family=NegativeBinomial(alpha=alpha_fin[j]),
                       offset=np.log(sf_vec)).fit(maxiter=100)
            c = float(g.params[1]); v = float(g.cov_params()[1, 1])
            coef[j] = c; z[j] = c / max(np.sqrt(max(v, 1e-12)), 1e-12)
        except Exception:
            pass
    return coef, z, alpha_fin, mu_mean

cond = (coldata['condition'] == 'disease').astype(int).values
Xd = np.column_stack([np.ones(len(cond)), cond])
log("fitting primary model ~ condition ...")
coef, z, alpha_fin, mu_mean = fit_design(Y, Xd, sf)
ok = ~np.isnan(z)
pval = np.full_like(z, 1.0); pval[ok] = 2*st.norm.sf(np.abs(z[ok]))
padj = np.full_like(z, 1.0); padj[ok] = multipletests(pval[ok], method='fdr_bh')[1]
lfc = coef / np.log(2)

sexm = (coldata['sex'] == 'M').astype(int).values
Xs = np.column_stack([np.ones(len(cond)), cond, sexm])
log("fitting sensitivity model ~ condition + sex ...")
cs, zs, _, _ = fit_design(Y, Xs, sf)
oks = ~np.isnan(zs)
pvals = np.full_like(zs, 1.0); pvals[oks] = 2*st.norm.sf(np.abs(zs[oks]))
padjs = np.full_like(zs, 1.0); padjs[oks] = multipletests(pvals[oks], method='fdr_bh')[1]

de = pd.DataFrame({'symbol': genes_kept, 'gene_type': types_kept,
                   'baseMean': mu_mean, 'log2FC': lfc, 'wald_z': z,
                   'pval': pval, 'padj': padj,
                   'log2FC_sex_model': cs/np.log(2), 'padj_sex_model': padjs})
de.to_csv("/workspace/outputs/de_results.csv", index=False)

FDR = 0.05
up   = de[(de.padj < FDR) & (de.log2FC >  0.58)]
down = de[(de.padj < FDR) & (de.log2FC < -0.58)]
sig  = de[de.padj < FDR]
summary = {
    "tested_genes": int((~np.isnan(z)).sum()), "sig_FDR05": int(len(sig)),
    "up_FDR05_lfc0.58": int(len(up)), "down_FDR05_lfc0.58": int(len(down)),
    "up_FDR05_lfc1": int(len(de[(de.padj < FDR) & (de.log2FC > 1)])),
    "down_FDR05_lfc1": int(len(de[(de.padj < FDR) & (de.log2FC < -1)])),
    "sex_model_spearman_lfc": float(st.spearmanr(de.log2FC, de.log2FC_sex_model, nan_policy='omit').statistic),
    "sex_model_sig_overlap": int(len(de[(de.padj < FDR) & (de.padj_sex_model < FDR)])),
}
log("DE summary:", json.dumps(summary, indent=1))
pd.Series(summary).to_csv("/workspace/outputs/de_summary.csv")
sig.sort_values('padj').head(50).to_csv("/workspace/outputs/de_top50.csv", index=False)

