def leading_edge(gset, rank_z, sign):
    o = np.argsort(-rank_z) if sign > 0 else np.argsort(rank_z)
    g = de['symbol'].values[o]; zz = np.abs(rank_z[o]); hits = np.isin(g, gset)
    w = zz*hits
    run = np.cumsum(np.where(hits, w/np.maximum(w.sum(), 1e-12), -1.0/(len(g)-hits.sum())))
    k = int(np.argmax(np.abs(run)))
    return sorted(set(g[:k+1][hits[:k+1]]))
