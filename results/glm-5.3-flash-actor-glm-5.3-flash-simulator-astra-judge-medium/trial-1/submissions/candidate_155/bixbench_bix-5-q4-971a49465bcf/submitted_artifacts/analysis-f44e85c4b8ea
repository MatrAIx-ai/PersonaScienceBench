def bh(p):
    p = np.asarray(p, float); n = len(p)
    o = np.argsort(p); padj = np.empty(n)
    padj[o] = np.minimum.accumulate((p[o]*n/np.arange(1, n+1))[::-1])[::-1]
    return np.minimum(padj, 1.0)

def ora(sig_genes, label):
    rows = []
    for k, s in mapped.items():
        hit = len(set(sig_genes) & set(s))
        K, N, n = len(s), len(background), len(sig_genes)
        p = st.hypergeom.sf(hit-1, N, K, n) if hit > 0 else 1.0
        rows.append({'direction': label, 'gene_set': k, 'set_size': K, 'hits': hit,
                     'fold_enrichment': (hit/n)/(K/N) if hit else 0.0, 'p': p})
    df = pd.DataFrame(rows); df['padj'] = bh(df['p'].values)
    return df.sort_values(['padj', 'p'])

def gsea_prerank(rank_z, nperm=2000, seed=1):
    """pre-ranked GSEA on curated sets; gene-label permutation (vectorized)"""
    rng = np.random.default_rng(seed)
    order = np.argsort(-rank_z)
    genes_r = de['symbol'].values[order]; zr = np.abs(rank_z[order])
    idx_of = {g: i for i, g in enumerate(genes_r)}
    N = len(genes_r); rows = []
    for k, s in mapped.items():
        hits = sorted(idx_of[g] for g in s if g in idx_of)
        m = len(hits)
        if m < 5: continue
        # observed ES
        w = zr[hits]; C = np.cumsum(w/w.sum()); p = np.array(hits)
        cum_hit = C - (p - np.arange(1, m+1))/(N-m)
        cum_bef = np.concatenate([[0.0], C[:-1]]) - (p - np.arange(0, m))/(N-m)
        allv = np.concatenate([cum_hit, cum_bef])
        es = allv[np.argmax(np.abs(allv))]
        # null: gene-label permutation, vectorized over permutations
        null = np.empty(nperm)
        jj = np.arange(1, m+1)
        for b in range(nperm):
            H = np.sort(rng.choice(N, m, replace=False))
            Cn = np.cumsum(zr[H]); Cn = Cn/Cn[-1]
            chn = Cn - (H - jj)/(N-m)
            cbn = np.concatenate([[0.0], Cn[:-1]]) - (H - (jj-1))/(N-m)
            av = np.concatenate([chn, cbn])
            null[b] = av[np.argmax(np.abs(av))]
        pos = null[null > 0] if es > 0 else null[null < 0]
        nes = es/pos.mean() if len(pos) and pos.mean() != 0 else np.nan
        pv = (np.sum(np.abs(null) >= abs(es)) + 1)/(nperm + 1)
        rows.append({'direction': ('UP' if es > 0 else 'DOWN') + '_vs_control',
                     'gene_set': k, 'set_size': m, 'ES': es, 'NES': nes, 'p_perm': pv})
    df = pd.DataFrame(rows); df['padj'] = bh(df['p_perm'].values)
    return df.sort_values(['padj', 'NES'], ascending=[True, False])

