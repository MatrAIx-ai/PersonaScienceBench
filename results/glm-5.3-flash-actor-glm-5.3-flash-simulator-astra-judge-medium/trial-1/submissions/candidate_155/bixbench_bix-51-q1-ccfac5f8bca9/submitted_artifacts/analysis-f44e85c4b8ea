"""
BixBench bix-51 Q1: Logistic regression — predicted probability of achieving
efficacy PR (with treatment) at Age = 65, using Age as the only predictor.

Data: data/data.xlsx, Sheet1.
Outcome: efficacyPR = 1 if Efficacy == 'PR', else 0 (SD/PD).
Predictor: Age (continuous, years, sole covariate).
Sample: all 80 analyzable records (rows with non-missing Groups). A
treatment-group-only fit is degenerate (all 41 Group-1 patients are PR,
zero outcome variance), so the model is fitted on the pooled sample, as
approved.
"""
import pandas as pd
import numpy as np
import statsmodels.api as sm

# ---- Load ----
df = pd.read_excel('data/data.xlsx', sheet_name='Sheet1')
n_raw = len(df)
d = df[df['Groups'].notna()].copy()          # 80 real records; rest is blank padding
d['Age'] = pd.to_numeric(d['Age'])
assert d['Age'].notna().all() and d['Efficacy'].notna().all(), "unexpected missingness"

# ---- Define outcome ----
d['efficacyPR'] = (d['Efficacy'] == 'PR').astype(int)

# ---- Degeneracy check for treatment-only fit ----
g1 = d[d['Groups'] == 1]
print(f"Group 1 (treatment): n={len(g1)}, PR={int((g1['Efficacy']=='PR').sum())} "
      f"(outcome variance = {(g1['efficacyPR']).var():.4f} -> treatment-only fit degenerate)")

# ---- Logistic regression: efficacyPR ~ Age (pooled, MLE, no penalty) ----
X = sm.add_constant(d['Age'])
model = sm.Logit(d['efficacyPR'], X).fit(disp=0)
print(model.summary())

beta_age = model.params['Age']
or_per_year = np.exp(beta_age)
ci = model.conf_int().loc['Age']
or_ci = np.exp(ci)
p_age = model.pvalues['Age']

# ---- Prediction at Age = 65 ----
p65 = float(model.predict(pd.DataFrame({'const': [1.0], 'Age': [65.0]}))[0])

print("\n=== Results ===")
print(f"n = {len(d)} (Group1 {int((d['Groups']==1).sum())} treatment / Group2 {int((d['Groups']==2).sum())} control)")
print(f"Intercept (const) = {model.params['const']:.4f}")
print(f"Age coefficient (log-odds/yr) = {beta_age:.4f}")
print(f"OR per year of Age = {or_per_year:.4f} (95% CI {or_ci[0]:.4f}–{or_ci[1]:.4f}), p = {p_age:.4f}")
print(f"Pseudo R-squared = {model.prsquared:.4f}, LLR p = {model.llr_pvalue:.5f}")
print(f"Predicted P(PR) at Age = 65 : {p65:.4f}  (~{p65*100:.1f}%)")

# sanity: model-implied probabilities at a few ages
for a in [40, 50, 65, 75]:
    pa = float(model.predict(pd.DataFrame({'const':[1.0],'Age':[a]}))[0])
    print(f"  P(PR | Age={a}) = {pa:.3f}")
