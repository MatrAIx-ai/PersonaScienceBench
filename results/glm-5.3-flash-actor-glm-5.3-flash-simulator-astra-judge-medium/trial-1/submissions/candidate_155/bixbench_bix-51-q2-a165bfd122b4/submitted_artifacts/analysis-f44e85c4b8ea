# AIC of logistic regression: BMI (sole predictor) -> treatment response (Efficacy PR)
import pandas as pd
import numpy as np
import statsmodels.api as sm

# ---- Load and clean ----
df = pd.read_excel('data/data.xlsx', sheet_name='Sheet1')

# Strip whitespace-only strings so blank padding rows are detected as NaN
data = df.apply(lambda c: c.map(lambda v: np.nan if isinstance(v, str) and v.strip() == '' else v))
data = data.dropna(subset=['Efficacy', 'BMI']).copy()
print('Rows after dropping blank padding rows (Efficacy & BMI present):', len(data))
assert data[['Efficacy', 'BMI']].isna().sum().sum() == 0

# ---- Binary response ----
# PR = responder (Y=1); SD, PD = non-responder (Y=0)
y = (data['Efficacy'] == 'PR').astype(int)
print('Response coding: PR -> 1, SD/PD -> 0')
print('Responder proportion: %d/%d = %.4f' % (y.sum(), len(y), y.mean()))

X = sm.add_constant(data['BMI'].astype(float))

# ---- Fit: logit link, intercept + BMI (k = 2) ----
fit = sm.Logit(y, X).fit(disp=False)
llf = fit.llf
k = int(fit.params.shape[0])
aic_sm = fit.aic
aic_manual = -2 * llf + 2 * k

print('\nConverged:', bool(fit.mle_retvals['converged']))
print('n observations in fit:', int(fit.nobs))
print('\nCoefficient estimates:')
print(fit.summary2().tables[1].to_string())
print('\nLog-likelihood: %.6f' % llf)
print('Parameters k: %d (intercept + BMI)' % k)
print('AIC (statsmodels fit.aic = -2*llf + 2*k): %.2f' % aic_sm)
print('AIC (manual -2*llf + 2*k):                 %.2f' % aic_manual)
assert abs(aic_sm - aic_manual) < 1e-6, 'AIC mismatch between statsmodels and manual formula'

# ---- Cross-check with Binomial GLM (logit link) ----
glm = sm.GLM(y, X, family=sm.families.Binomial(link=sm.families.links.Logit())).fit()
print('\nCross-check (GLM Binomial, logit link):')
print('GLM llf: %.6f' % glm.llf)
print('GLM AIC: %.2f' % glm.aic)
print('GLM intercept: %.6f | GLM BMI slope: %.6f' % (glm.params['const'], glm.params['BMI']))
assert abs(glm.aic - aic_manual) < 1e-4, 'GLM AIC mismatch'

print('\nFINAL RESULT: AIC = %.2f' % aic_manual)
