"""BixBench bix-51-q3: Combined logistic regression (BMI, Age, Gender) -> PR response."""
import pandas as pd
import numpy as np
import statsmodels.api as sm

# --- Load and clean ---
df = pd.read_excel('/workspace/data/data.xlsx', sheet_name='Sheet1')
print(f"Raw sheet shape: {df.shape}")
df = df.dropna(how='all')                       # drop fully blank spreadsheet row
df['Age'] = pd.to_numeric(df['Age'], errors='coerce')
key = ['Efficacy', 'Age', 'Gender', 'BMI']
print(f"Rows with missing model variables: {df[key].isna().any(axis=1).sum()}")
df = df.dropna(subset=key).reset_index(drop=True)
print(f"Analytic n: {len(df)}")

# --- Variables ---
df['response'] = (df['Efficacy'] == 'PR').astype(int)   # PR=1; PD & SD = 0
df['gender_ind'] = (df['Gender'] == 'Female').astype(int)  # Male = reference

X = sm.add_constant(df[['BMI', 'Age', 'gender_ind']].astype(float))
y = df['response']

# --- Fit ---
model = sm.Logit(y, X).fit(disp=False)
print(f"\nconverged: {model.converged} | mle_retvals: {model.mle_retvals.get('iterations')} iterations")
print(f"n fitted: {model.nobs} | LL: {model.llf:.3f} | LL-null: {model.llnull:.3f} "
      f"| McFadden pseudo-R2: {model.prsquared:.4f}")
print(f"Outcome counts: PR={y.sum()}, non-PR={(1-y).sum()}")
pred = (model.predict(X) >= 0.5).astype(int)
print(f"Predicted-response count: {pred.sum()} (no separation indicated)")

# --- Full coefficient table ---
tbl = pd.DataFrame({
    'coef': model.params,
    'std_err': model.bse,
    'z': model.tvalues,
    'p_value': model.pvalues,
    'OR': np.exp(model.params),
    'CI2.5': np.exp(model.conf_int()[0]),
    'CI97.5': np.exp(model.conf_int()[1]),
}).round(6)
print("\n=== Full coefficient table ===")
print(tbl.to_string())

age_p = model.pvalues['Age']
print(f"\n>>> AGE p-value in combined model: {age_p:.6f}")
