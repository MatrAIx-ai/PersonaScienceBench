"""
BixBench bix-51-q4: logistic regression for remission (Efficacy == PR)
Outcome: remission = 1 if Efficacy == 'PR' (partial response), 0 otherwise (SD/PD).
Predictors: Age (per 1 year), BMI, Gender (Male=1, Female=0 reference).
Population: 80 valid records (Sequence number 1-80) from data/data.xlsx Sheet1.
"""
import pandas as pd
import numpy as np
import statsmodels.api as sm

df = pd.read_excel('data/data.xlsx', sheet_name='Sheet1')

# Keep only valid records: Sequence number 1-80 (trailing rows are blank / stray cells)
df = df[df['Sequence number'].notna() & (df['Sequence number'] <= 80)].copy()
assert df.shape[0] == 80, f"Expected 80 valid rows, got {df.shape[0]}"

# Binarize outcome: remission = PR
y = (df['Efficacy'].str.strip() == 'PR').astype(int)

# Predictors
age = pd.to_numeric(df['Age'], errors='coerce')          # handles stray blank string
bmi = pd.to_numeric(df['BMI'], errors='coerce')
gender = (df['Gender'].str.strip() == 'Male').astype(int)  # Male=1, Female=0 (reference)

print("Missing after coercion:", y.isna().sum(), age.isna().sum(), bmi.isna().sum(), gender.isna().sum())
assert y.notna().all() and age.notna().all() and bmi.notna().all() and gender.notna().all()

X = sm.add_constant(pd.DataFrame({'Age': age, 'BMI': bmi, 'Gender_Male': gender}))

# Complete-case safety net (none expected)
mask = X.notna().all(axis=1) & y.notna()
X, y = X[mask], y[mask]
print(f"\nAnalysis n = {mask.sum()} (remission/PR cases = {y.sum()}, non-remission = {(1-y).sum()})")

model = sm.Logit(y, X).fit(disp=False)
print("\n=== Model summary ===")
print(model.summary2())

ci = model.conf_int()
ci.columns = ['2.5%', '97.5%']
out = pd.DataFrame({
    'coef (log-odds)': model.params,
    'SE': model.bse,
    'z': model.tvalues,
    'p': model.pvalues,
    'OR (exp(beta))': np.exp(model.params),
}).join(ci)
print("\n=== Coefficient table ===")
print(out.round(4).to_string())

age_coef = model.params['Age']
print(f"\nPRIMARY ANSWER: change in log-odds of remission per 1-year increase in Age "
      f"= {age_coef:.6f} (SE={model.bse['Age']:.6f}, 95% CI [{ci.loc['Age','2.5%']:.6f}, "
      f"{ci.loc['Age','97.5%']:.6f}], p={model.pvalues['Age']:.4f}); "
      f"OR per year = exp(beta) = {np.exp(age_coef):.4f}")

# Convergence / diagnostics
print(f"\nConverged: {model.mle_retvals['converged']}; "
      f"LLR p-value = {model.llr_pvalue:.4f}; pseudo R2 = {model.prsquared:.4f}")
