"""
BixBench bix-51-q5: logistic regression - BMI vs treatment response.
Data: data/data.xlsx (Sheet1). Response: PR = responder (1), SD/PD = non-responder (0).
Model: response ~ BMI (unadjusted, BMI continuous per 1 kg/m^2).
"""
import pandas as pd
import numpy as np
import statsmodels.api as sm
from scipy import stats

# ---------- Data loading & cleaning ----------
df = pd.read_excel('data/data.xlsx', sheet_name='Sheet1')

# 1) Drop the fully empty trailing row (Excel row 121; Age contains a stray " " only)
df = df[df.drop(columns=[]).notna().any(axis=1)]
df = df[df['Groups'].notna()]          # removes the blank spacer row (Age == " ")

# 2) Age: text -> numeric
df['Age'] = pd.to_numeric(df['Age'].astype(str).str.strip(), errors='coerce')
assert df['Age'].notna().all()

# 3) ECOG-PS: unify mixed str/int coding -> 0 (ECOG 0-1) / 1 (ECOG 2)
df['ECOG-PS'] = df['ECOG-PS'].astype(str).str.strip().map({'0-1': 0, '2': 1})
assert df['ECOG-PS'].notna().all()

print(f"Analytic N = {len(df)}")
print("Groups:", df['Groups'].value_counts().to_dict())
print("Efficacy:", df['Efficacy'].value_counts().to_dict())

# ---------- Outcome definition (RECIST) ----------
df['response'] = (df['Efficacy'].str.strip() == 'PR').astype(int)
print(pd.crosstab(df['response'], df['BMI'].describe().round(2).to_dict() and df['Groups']))

# ---------- Main model: response ~ BMI ----------
X = sm.add_constant(df['BMI'].values)
y = df['response'].values
fit = sm.Logit(y, X).fit(disp=0)
bmi_coef, bmi_se = fit.params[1], fit.bse[1]
wald_z = bmi_coef / bmi_se
p_wald = 2 * (1 - stats.norm.cdf(abs(wald_z)))

# Likelihood-ratio test: full vs BMI-free (intercept-only) model
ll_full = fit.llf
fit0 = sm.Logit(y, np.ones_like(y)).fit(disp=0)
lrt_stat = 2 * (ll_full - fit0.llf)
p_lrt = stats.chi2.sf(lrt_stat, df=1)

or_ = np.exp(bmi_coef)
ci = np.exp([bmi_coef - 1.96 * bmi_se, bmi_coef + 1.96 * bmi_se])

print("\n===== Logistic regression: response ~ BMI (N=%d) =====" % len(df))
print(f"BMI coefficient (log-odds per 1 kg/m2): {bmi_coef:.6f}")
print(f"SE: {bmi_se:.6f}   z: {wald_z:.4f}")
print(f"Odds ratio: {or_:.4f}  (95% CI {ci[0]:.4f} - {ci[1]:.4f})")
print(f"Wald p-value:      {p_wald:.6f}")
print(f"Likelihood-ratio p-value: {p_lrt:.6f} (LR chi2 = {lrt_stat:.4f}, df=1)")
print(f"Log-likelihood: {ll_full:.4f}   McFadden pseudo-R2: {1 - ll_full/fit0.llf:.4f}")

# ---------- Sensitivity: adjusted model WITHOUT Groups (Group excluded due to complete separation) ----------
Xa = sm.add_constant(df[['BMI', 'Age', 'ECOG-PS']].assign(
    **{'Child-Pugh_B': (df['Child-Pugh'] == 'B').astype(int)}).values)
fita = sm.Logit(y, Xa).fit(disp=0)
p_wald_adj = 2 * (1 - stats.norm.cdf(abs(fita.params[1] / fita.bse[1])))
print(f"\n[Sensitivity] BMI ~ + Age + ECOG-PS + Child-Pugh: BMI coef {fita.params[1]:.4f}, Wald p {p_wald_adj:.6f}")

print("\nANSWER (Wald p-value for BMI in response ~ BMI):", round(p_wald, 6))
