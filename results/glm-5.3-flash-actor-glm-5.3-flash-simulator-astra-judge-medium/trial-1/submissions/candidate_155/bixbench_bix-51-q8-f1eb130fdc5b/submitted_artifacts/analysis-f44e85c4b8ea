# Simple (univariable) logistic regression: Efficacy (PR=1 vs SD/PD=0) ~ Age (years)
import pandas as pd
import numpy as np
import statsmodels.api as sm

df = pd.read_excel('data/data.xlsx', sheet_name='Sheet1')
d = df[df['Sequence number'].notna()].copy()          # 80 real records
d['Age'] = pd.to_numeric(d['Age'], errors='coerce')
d = d.dropna(subset=['Age', 'Efficacy'])
d['response'] = (d['Efficacy'] == 'PR').astype(int)   # 1 = PR (response), 0 = SD/PD

print("n =", len(d), "| response (PR) count:", d['response'].sum())

# Descriptive diagnostics
print("\nAge by outcome group:")
print(d.groupby('response')['Age'].agg(['count','mean','std','min','max']))
print("\nOutcome counts:", d['response'].value_counts().to_dict())
print("Response rate:", round(d['response'].mean(), 4))

# Fit: y ~ intercept + Age
X = sm.add_constant(d['Age'].astype(float))
model = sm.Logit(d['response'], X).fit(disp=0)
print("\n=== statsmodels Logit summary ===")
print(model.summary2())

b, se = model.params['Age'], model.bse['Age']
or_ = np.exp(b)
ci = np.exp(model.conf_int().loc['Age'])
print(f"\nAge coefficient (per 1 year, log-odds): {b:.6f}")
print(f"Std. error: {se:.6f}")
print(f"z = {model.tvalues['Age']:.4f}, p = {model.pvalues['Age']:.6g}")
print(f"OR = {or_:.6f}, 95% CI OR: [{ci[0]:.6f}, {ci[1]:.6f}]")
print(f"Intercept: {model.params['const']:.6f} (se {model.bse['const']:.6f}, p {model.pvalues['const']:.6g})")
print(f"Log-likelihood: {model.llf:.4f}, LL-null: {model.llnull:.4f}")
print(f"LLR p-value: {model.llr_pvalue:.6g}, Pseudo R2 (McFadden): {model.prsquared:.6f}")
print(f"AIC: {model.aic:.4f}")

# Per-10-year scaling (supplementary)
print(f"\nPer 10 years: beta = {b*10:.4f}, OR = {np.exp(b*10):.4f}")

# Perfect-separation check: crosstab Age(decile-ish) vs outcome, and group confounding
d['AgeBand'] = pd.cut(d['Age'], bins=[39,49,59,69,75])
print("\nAge band x response:")
print(pd.crosstab(d['AgeBand'], d['response']))
print("\nGroup x response (confounding note):")
print(pd.crosstab(d['Groups'], d['response']))
