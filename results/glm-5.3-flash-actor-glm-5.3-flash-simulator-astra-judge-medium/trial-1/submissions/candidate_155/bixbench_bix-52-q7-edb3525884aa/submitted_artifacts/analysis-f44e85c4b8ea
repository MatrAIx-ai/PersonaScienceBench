#!/usr/bin/env python3
"""
Question: How many sites are removed when filtering sites that do not show
>90% or <10% methylation in Zebra Finch (ZF)?

Approved method (plan-approved):
- Unit: MethylationPercentage is on a 0-100 percentage scale.
- Site granularity: unique Pos (genomic CpG site). A site is KEPT if ANY of
  its sample-level rows shows methylation >90% or <10% (strict inequalities).
  A site is REMOVED if ALL of its rows fall within [10, 90] (inclusive bounds,
  i.e., no row shows >90% or <10%).
- Denominator: number of unique Pos in the ZF data.
- Boundary sensitivity (footnote only): if extremes are defined inclusively
  (>=90% or <=10%), the removed count changes.
- No chromosome filtering (MT absent from data; 1A/4A mapping not applied).
- JD file used only as a sanity-check footnote; the answer concerns ZF only.
"""
import pandas as pd

zf = pd.read_csv("data/ZF_AgeRelated_CpG_noMT_Final.csv", encoding="utf-8-sig")

# --- Input sanity checks ---
assert zf["MethylationPercentage"].notna().all(), "missing methylation values"
assert zf["MethylationPercentage"].between(0, 100).all(), "values outside 0-100"
assert zf["MethylationPercentage"].max() > 1  # max=100.0 -> 0-100 percentage scale, not 0-1

total_sites = zf["Pos"].nunique()
extreme_rows = ((zf["MethylationPercentage"] > 90) | (zf["MethylationPercentage"] < 10)).sum()

# --- Approved site-level filter (strict >90 / <10) ---
kept = zf.groupby("Pos")["MethylationPercentage"].apply(
    lambda s: ((s > 90) | (s < 10)).any())
removed_sites = int((~kept).sum())
kept_sites = int(kept.sum())

# --- Boundary sensitivity (>=90 / <=10) ---
kept_incl = zf.groupby("Pos")["MethylationPercentage"].apply(
    lambda s: ((s >= 90) | (s <= 10)).any())
removed_sites_incl = int((~kept_incl).sum())

print(f"ZF total rows: {len(zf)}")
print(f"ZF unique sites (denominator): {total_sites}")
print(f"Rows showing >90% or <10% methylation (strict): {extreme_rows}")
print(f"Rows exactly at 10.0: {(zf['MethylationPercentage'] == 10).sum()}, "
      f"exactly at 90.0: {(zf['MethylationPercentage'] == 90).sum()}")
print(f"Removed sites (strict >90/<10, approved): {removed_sites}")
print(f"Kept sites (strict): {kept_sites}")
print(f"[footnote] Removed sites if extremes are >=90/<=10: {removed_sites_incl}")

# --- JD sanity check (footnote) ---
jd = pd.read_csv("data/JD_AgeRelated_CpG_noMT_Final.csv", encoding="utf-8-sig")
jd_kept = jd.groupby("Pos")["MethylationPercentage"].apply(
    lambda s: ((s > 90) | (s < 10)).any())
print(f"[footnote] JD sanity check: removed {int((~jd_kept).sum())} of {jd['Pos'].nunique()} sites (same method)")
