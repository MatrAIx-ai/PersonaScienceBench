def enrichr_ora(query_ids, gene_set_ids, universe):
    """gseapy.enrichr-equivalent ORA: Fisher exact + Enrichr combined score (ln(p)*z)."""
    a = len(set(query_ids)&set(gene_set_ids)); M = len(universe); K = len(set(gene_set_ids)); N = len(set(query_ids))
    p = stats.hypergeom.sf(a-1, M, K, N)
    exp = N*K/M; sd = np.sqrt(N*(K/M)*(1-K/M)*(M-N)/max(M-1,1))
    z = (a-exp)/sd if sd>0 else 0.0
    return dict(overlap=a, p=float(p), z=z, combined=float(-np.log(max(p,1e-300))*z), expected_null=exp)
