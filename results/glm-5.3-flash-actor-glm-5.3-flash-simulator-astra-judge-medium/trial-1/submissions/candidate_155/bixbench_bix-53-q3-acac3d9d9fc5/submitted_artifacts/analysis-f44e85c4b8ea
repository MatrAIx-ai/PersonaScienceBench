b_p   = res[(res.log2FC_shrunk.abs()>1)&(res.baseMean>10)&(res.padj.between(0.04,0.06))]
b_bm  = res[(res.padj<0.05)&(res.log2FC_shrunk.abs()>1)&(res.baseMean.between(8,12))]
print(f"  |shrunk lfc| in (0.9,1.1), padj<0.05, bm>10 : {len(b_lfc)}")
print(f"  padj in (0.04,0.06), other filters          : {len(b_p)}")
print(f"  baseMean in (8,12), other filters           : {len(b_bm)}")
beta2 = fit(beta0.copy(), res.alpha_mom.to_numpy()[:,None])
eta2 = np.log(s)[None,:] + beta2[:,:1] + beta2[:,1:2]*x[None,:]
mu2 = np.exp(np.clip(eta2,-30,30))
w2 = mu2/(1.0 + res.alpha_mom.to_numpy()[:,None]*mu2)
I00 = w2.sum(1); I01 = (w2*x).sum(1); I11 = (w2*x*x).sum(1)
det2 = I00*I11 - I01**2
p2 = 2*stats.norm.sf(np.abs(beta2[:,1]/np.sqrt(np.maximum(I00/det2,1e-12))))
padj2 = multipletests(p2, method='fdr_bh')[1]
print(f"  dispersion shrinkage OFF (alpha=mom)        : {int(((padj2<0.05)&(res.log2FC_shrunk.abs()>1)&(res.baseMean>10)).sum())}")
low = res[res.baseMean < 5]
print(f"  p-uniformity on near-null genes (baseMean<5, n={len(low)}): KS p={stats.kstest(low.pvalue.to_numpy(),'uniform').pvalue:.3f}")

