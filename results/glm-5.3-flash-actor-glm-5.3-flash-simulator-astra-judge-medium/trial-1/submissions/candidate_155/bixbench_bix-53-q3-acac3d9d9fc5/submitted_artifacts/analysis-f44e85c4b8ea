import numpy as np, pandas as pd
from scipy import stats
from statsmodels.stats.multitest import multipletests

df = pd.read_csv('/workspace/data/count.csv')
genes = df['geneID'].to_numpy()
Y = df[['KL1','KL2','KL3','WL1','WL2','WL3']].to_numpy(float)
n = Y.shape[1]
cond = np.array([1.,1.,1.,0.,0.,0.])   # KL = KD numerator [ASSUMPTION: capsule does not define KL/WL]
x = cond
print(f"[data] {Y.shape[0]} genes x {n} samples; raw integer counts; 0 missing; 0 duplicated IDs")

pos = Y > 0
gm = np.exp(np.nanmean(np.where(pos, np.log(Y, where=pos, out=np.full(Y.shape, np.nan)), np.nan), axis=1))
gm = np.nan_to_num(gm)
valid = pos.all(axis=1) & (gm > 0)
sf = np.exp(np.median(np.log(Y[valid]/gm[valid,None]), axis=0))
print(f"[size factors] {np.round(sf,4).tolist()}")
baseMean = (Y/sf).mean(axis=1)
idx = np.where(baseMean > 0)[0]
g, s = Y[idx], sf

def fit(beta, alpha_col):
    for _ in range(100):
        eta = np.log(s)[None,:] + beta[:,:1] + beta[:,1:2]*x[None,:]
        mu = np.exp(np.clip(eta,-30,30))
        inv = 1.0 + alpha_col*mu
        r0 = ((g-mu)/inv).sum(1); r1 = ((g-mu)*x/inv).sum(1)
        w = mu/inv
        I00 = w.sum(1); I01 = (w*x).sum(1); I11 = (w*x*x).sum(1)
        det = I00*I11 - I01**2
        beta = beta + np.stack([(I11*r0-I01*r1)/det, (I00*r1-I01*r0)/det], 1)
    return beta

KLm = cond==1; WLm = ~KLm
b0 = np.log(np.maximum((g[:,WLm]/s[WLm]).mean(1), 1e-3))
b1 = np.log(np.maximum((g[:,KLm]/s[KLm]).mean(1), 1e-3)) - b0
beta0 = np.stack([b0,b1],1)
beta = fit(beta0.copy(), np.full((len(idx),1), 1e-6))
eta = np.log(s)[None,:] + beta[:,:1] + beta[:,1:2]*x[None,:]
mu = np.exp(np.clip(eta,-30,30))
alpha_mom = np.maximum((((g-mu)**2 - mu).sum(1))/np.maximum((mu**2).sum(1),1e-12), 1e-8)

bm = baseMean[idx]
good = (alpha_mom < 10) & (bm > 5)
z_, a_, wt = 1/bm[good], alpha_mom[good], bm[good]/(1+alpha_mom[good])
A = np.column_stack([z_, np.ones_like(z_)])
coef,*_ = np.linalg.lstsq(A*wt[:,None], a_*wt, rcond=None)
a1, a0 = max(coef[0],0), max(coef[1],1e-4)
alpha_trend = a1/bm + a0
C_SHRINK = 10.0   # documented approximation of DESeq2 dispersion shrinkage strength
alpha_final = np.maximum((alpha_mom*(n-2) + alpha_trend*C_SHRINK)/((n-2)+C_SHRINK), 1e-8)
print(f"[dispersion] trend: alpha = {a1:.4f}/mean + {a0:.6f}")

beta = fit(beta.copy(), alpha_final[:,None])
eta = np.log(s)[None,:] + beta[:,:1] + beta[:,1:2]*x[None,:]
mu = np.exp(np.clip(eta,-30,30))
w = mu/(1.0 + alpha_final[:,None]*mu)
I00 = w.sum(1); I01 = (w*x).sum(1); I11 = (w*x*x).sum(1)
det = I00*I11 - I01**2
se = np.sqrt(np.maximum(I00/det, 1e-12))
lfc_mle = beta[:,1]/np.log(2)
pval = 2*stats.norm.sf(np.abs(beta[:,1]/se))

strong = bm > 50
b2 = lfc_mle[strong]**2; s2 = (se[strong]/np.log(2))**2
tau2 = max(np.mean(b2-s2), 1e-3)
for _ in range(5):
    sh = tau2/(tau2 + s2); tau2 = max(np.mean(b2 - sh*b2), 1e-3)
shr = tau2/(tau2 + (se/np.log(2))**2)
lfc_shrunk = lfc_mle*shr
print(f"[shrinkage] prior tau^2 = {tau2:.4f}; median shrink factor = {np.median(shr):.3f}")

res = pd.DataFrame({'geneID': genes[idx], 'baseMean': baseMean[idx],
                    'log2FC_MLE': lfc_mle, 'log2FC_shrunk': lfc_shrunk,
                    'se_log2': se/np.log(2), 'stat': beta[:,1]/se,
                    'pvalue': pval, 'alpha_mom': alpha_mom, 'alpha_final': alpha_final})
res['padj'] = multipletests(res['pvalue'].to_numpy(), method='fdr_bh')[1]
res.to_csv('/workspace/analysis/deseq_results.csv', index=False)

