#!/usr/bin/env python3
"""
bixbench:bix-57-q1 - gap percentage across alignments.

METHOD NOTE (important): MAFFT is NOT available in this execution environment
(no binary anywhere incl. all NFS mounts, no network, no root, /usr read-only,
no container daemon; exhaustively verified). The required "MAFFT --auto"
alignment therefore CANNOT be executed. This script implements a clearly
labelled pure-Python FALLBACK: pairwise Gotoh (affine gap) + BLOSUM62 +
UPGMA guide-tree progressive alignment + one round of profile-realignment
refinement. Results are NOT MAFFT --auto results and are reported as such.

Statistics (researcher-approved):
  gap char: '-' only; numerator: all '-' across 10 alignments;
  denominator: sum over alignments of (n_seqs * n_cols);
  terminal gaps counted, no trimming, nothing removed.
"""
import os, itertools, json

DATA = "data"
GAP_OPEN, GAP_EXTEND = -10.0, -0.5

BLO62_TXT = """
   A  R  N  D  C  Q  E  G  H  I  L  K  M  F  P  S  T  W  Y  V
A  4 -1 -2 -2  0 -1 -1  0 -2 -1 -1 -1 -1 -2 -1  1  0 -3 -2  0
R -1  5  0 -2 -3  1  0 -2  0  3 -3  2  0 -3 -2 -1 -1 -3 -2 -3
N -2  0  6  1 -3  0  0  0  1 -3 -3  0 -2 -3 -2  1  1 -4 -2 -3
D -2 -2  1  6 -3  0  2 -1 -1 -3 -4 -1 -3 -3 -1  0 -1 -4 -3 -3
C  0 -3 -3 -3  9 -3 -4 -3 -3 -1 -1 -3 -1 -2 -3 -1 -1 -2 -2 -1
Q -1  1  0  0 -3  5  2 -2  0  3 -3  1  0 -3 -2  0 -1 -2 -1 -2
E -1  0  0  2 -4  2  5 -2  0  3 -3  1  0 -3 -2  0 -1 -2 -1 -2
G  0 -2  0 -1 -3 -2 -2  6 -2 -4 -4 -2 -3 -3 -2  0 -2 -2 -3 -3
H -2  0  1 -1 -3  0  0 -2  8 -3 -3 -1 -2 -1 -2 -1 -2 -2  2 -3
I -1  3 -3 -3 -1  3  3 -4 -3  4  2 -1  3  0 -3  0 -1 -3 -1  3
L -2 -3 -3 -4 -1 -2 -2 -4 -3  2  4 -2  2  0 -3 -2 -1 -2 -1  1
K -1  2  0 -1 -3  1  1 -2 -1 -3 -2  5 -1 -1 -1  0 -1 -3 -2 -2
M -1  0 -2 -3 -1  0  0 -3 -2  1  2 -1  5  0 -2 -1 -1 -1 -1  1
F -2 -3 -3 -3 -1 -3 -3 -3 -1  0  0 -1  0  6 -4 -2 -2  1  3 -1
P -1 -2 -2 -1 -3 -2 -2 -2 -2 -3 -3 -1 -2 -4  7 -1 -1 -4 -3 -2
S  1 -1  1  0 -3  0  0  0 -1 -2 -2  0 -1 -2 -1  4  1 -3 -2 -2
T  0 -1  1 -1 -1 -1 -1 -2 -2 -1 -1 -1 -1 -2 -1  1  5 -2 -2  0
W -3 -3 -4 -4 -2 -2 -2 -2 -2 -3 -2 -3 -1  1 -4 -3 -2 11  2 -3
Y -2 -2 -2 -3 -2 -1 -1 -3  2 -1 -1 -2 -1  3 -3 -2 -2  2  7 -1
V  0 -3 -3 -3 -1 -2 -2 -3 -3  3  1 -2  1 -1 -2 -2  0 -3 -1  4
"""
AAS = "ARNDCQEGHILKMFPSTWYV"
_lines = [l for l in BLO62_TXT.strip().splitlines() if l.strip()]
_hdr = _lines[0].split()
BLO62 = {}
for l in _lines[1:]:
    p = l.split()
    for h, v in zip(_hdr, map(float, p[1:])):
        BLO62[(p[0], h)] = v
UNKNOWN_SCORE = -1.0

def sub(x, y):
    if x == '-' or y == '-':
        return 0.0
    return BLO62.get((x, y), BLO62.get((y, x), UNKNOWN_SCORE))

def read_fasta(path):
    recs, name, seq = [], None, []
    for line in open(path):
        line = line.strip()
        if line.startswith('>'):
            if name is not None:
                recs.append((name, ''.join(seq)))
            name, seq = (line[1:].split()[0] if line[1:].strip() else '?'), []
        elif line:
            seq.append(line)
    if name is not None:
        recs.append((name, ''.join(seq)))
    return recs

def gotoh_align(s1, s2):
    """Global pairwise alignment, affine gaps (Gotoh). -> (aln1, aln2, score)."""
    n, m = len(s1), len(s2)
    NEG = float('-inf')
    M = [[NEG]*(m+1) for _ in range(n+1)]
    Ix = [[NEG]*(m+1) for _ in range(n+1)]
    Iy = [[NEG]*(m+1) for _ in range(n+1)]
    pM = [[None]*(m+1) for _ in range(n+1)]
    pIx = [[None]*(m+1) for _ in range(n+1)]
    pIy = [[None]*(m+1) for _ in range(n+1)]
    M[0][0] = 0.0
    for i in range(1, n+1):
        Ix[i][0] = GAP_OPEN + (i-1)*GAP_EXTEND
        pIx[i][0] = 'Ix' if i > 1 else 'M'
    for j in range(1, m+1):
        Iy[0][j] = GAP_OPEN + (j-1)*GAP_EXTEND
        pIy[0][j] = 'Iy' if j > 1 else 'M'
    for i in range(1, n+1):
        ci = s1[i-1]
        for j in range(1, m+1):
            cj = s2[j-1]
            best, bsrc = NEG, None
            for val, src in ((M[i-1][j-1],'M'), (Ix[i-1][j-1],'Ix'), (Iy[i-1][j-1],'Iy')):
                if val > best: best, bsrc = val, src
            M[i][j] = best + sub(ci, cj); pM[i][j] = bsrc
            cand = [(M[i-1][j] + GAP_OPEN, 'M'), (Ix[i-1][j] + GAP_EXTEND, 'Ix'),
                    (Iy[i-1][j] + GAP_OPEN, 'Iy')]
            Ix[i][j], pIx[i][j] = max(cand)
            cand = [(M[i][j-1] + GAP_OPEN, 'M'), (Iy[i][j-1] + GAP_EXTEND, 'Iy'),
                    (Ix[i][j-1] + GAP_OPEN, 'Ix')]
            Iy[i][j], pIy[i][j] = max(cand)
    score, state = max([(M[n][m], 'M'), (Ix[n][m], 'Ix'), (Iy[n][m], 'Iy')])
    a1, a2 = [], []
    i, j = n, m
    while i > 0 or j > 0:
        if state == 'M' and i > 0 and j > 0:
            a1.append(s1[i-1]); a2.append(s2[j-1]); ns = pM[i][j]; i -= 1; j -= 1
        elif state == 'Iy' or (state == 'M' and j == 0):
            if j > 0:
                a1.append('-'); a2.append(s2[j-1]); ns = pIy[i][j]; j -= 1
            else:
                a1.append(s1[i-1]); a2.append('-'); ns = 'Ix'; i -= 1
        else:
            if i > 0:
                a1.append(s1[i-1]); a2.append('-'); ns = pIx[i][j]; i -= 1
            else:
                a1.append('-'); a2.append(s2[j-1]); ns = 'Iy'; j -= 1
        state = ns if ns is not None else ('Ix' if j == 0 else 'Iy') if (i > 0 or j > 0) else None
        if state is None and (i > 0 or j > 0):
            state = 'Ix' if j == 0 else 'Iy'
    return ''.join(reversed(a1)), ''.join(reversed(a2)), score

def pair_score(aln1, aln2):
    """SP score of two aligned strings (affine gaps, gap-gap = 0)."""
    s = 0.0
    prev1 = prev2 = None
    for x, y in zip(aln1, aln2):
        if x == '-' and y == '-':
            prev1 = prev2 = None
        elif x == '-':
            s += GAP_EXTEND if prev1 == '-' else GAP_OPEN
            prev1, prev2 = '-', None
        elif y == '-':
            s += GAP_EXTEND if prev2 == '-' else GAP_OPEN
            prev2, prev1 = '-', None
        else:
            s += sub(x, y); prev1 = prev2 = None
    return s

def upgma_tree(names, dist):
    """UPGMA clustering -> nested lists of leaf indices."""
    clusters = {i: [i] for i in range(len(names))}
    active = set(clusters)
    nid = len(names)
    d = {k: dict(v) for k, v in dist.items()}
    merges = []
    while len(active) > 1:
        a, b = min(itertools.combinations(sorted(active), 2), key=lambda ab: d[ab[0]][ab[1]])
        clusters[nid] = clusters[a] + clusters[b]
        active.discard(a); active.discard(b)
        d[nid] = {}
        for c in active:
            v = (d[a][c]*len(clusters[a]) + d[b][c]*len(clusters[b])) / (len(clusters[a]) + len(clusters[b]))
            d[nid][c] = d[c][nid] = v
        merges.append((nid, a, b))
        active.add(nid); nid += 1
    def build(k):
        if k < len(names):
            return k
        _, a, b = next(m for m in merges if m[0] == k)
        return [build(a), build(b)]
    return build(nid - 1)

def profile_info(profile):
    ncol = len(profile[0])
    cols = [[p[c] for p in profile] for c in range(ncol)]
    nres = [sum(1 for ch in col if ch != '-') for col in cols]
    return cols, nres

def align_profiles(profA, profB):
    """Profile-profile Gotoh (affine, column-based penalties).
    match col: sum of BLOSUM62 over residue-residue pairs (gap-in-column pairs = 0);
    consuming col i of A as a gap: -(open|extend) * nresA[i] (open on state entry),
    symmetric for B."""
    colsA, nresA = profile_info(profA)
    colsB, nresB = profile_info(profB)
    n, m = len(colsA), len(colsB)
    NEG = float('-inf')
    M = [[NEG]*(m+1) for _ in range(n+1)]
    Ix = [[NEG]*(m+1) for _ in range(n+1)]
    Iy = [[NEG]*(m+1) for _ in range(n+1)]
    pM = [[None]*(m+1) for _ in range(n+1)]
    pIx = [[None]*(m+1) for _ in range(n+1)]
    pIy = [[None]*(m+1) for _ in range(n+1)]
    M[0][0] = 0.0
    for i in range(1, n+1):
        Ix[i][0] = GAP_OPEN*nresA[0] + sum(GAP_EXTEND*nresA[k] for k in range(1, i))
        pIx[i][0] = 'Ix' if i > 1 else 'M'
    for j in range(1, m+1):
        Iy[0][j] = GAP_OPEN*nresB[0] + sum(GAP_EXTEND*nresB[k] for k in range(1, j))
        pIy[0][j] = 'Iy' if j > 1 else 'M'
    MS = [[0.0]*m for _ in range(n)]
    for i in range(n):
        ca = colsA[i]
        for j in range(m):
            cb = colsB[j]
            tot = 0.0
            for x in ca:
                if x == '-':
                    continue
                for y in cb:
                    if y != '-':
                        tot += BLO62.get((x, y), BLO62.get((y, x), UNKNOWN_SCORE))
            MS[i][j] = tot
    for i in range(1, n+1):
        for j in range(1, m+1):
            best, bsrc = NEG, None
            for val, src in ((M[i-1][j-1],'M'), (Ix[i-1][j-1],'Ix'), (Iy[i-1][j-1],'Iy')):
                if val > best: best, bsrc = val, src
            M[i][j] = best + MS[i-1][j-1]; pM[i][j] = bsrc
            Ix[i][j], pIx[i][j] = max([(M[i-1][j] + GAP_OPEN*nresA[i-1], 'M'),
                                       (Ix[i-1][j] + GAP_EXTEND*nresA[i-1], 'Ix'),
                                       (Iy[i-1][j] + GAP_OPEN*nresA[i-1], 'Iy')])
            Iy[i][j], pIy[i][j] = max([(M[i][j-1] + GAP_OPEN*nresB[j-1], 'M'),
                                       (Iy[i][j-1] + GAP_EXTEND*nresB[j-1], 'Iy'),
                                       (Ix[i][j-1] + GAP_OPEN*nresB[j-1], 'Ix')])
    score, state = max([(M[n][m], 'M'), (Ix[n][m], 'Ix'), (Iy[n][m], 'Iy')])
    ops = []
    i, j = n, m
    while i > 0 or j > 0:
        if state == 'M' and i > 0 and j > 0:
            ops.append((i-1, j-1)); ns = pM[i][j]; i -= 1; j -= 1
        elif state == 'Iy' or (state == 'M' and j == 0):
            if j > 0:
                ops.append((None, j-1)); ns = pIy[i][j]; j -= 1
            else:
                ops.append((i-1, None)); ns = 'Ix'; i -= 1
        else:
            if i > 0:
                ops.append((i-1, None)); ns = pIx[i][j]; i -= 1
            else:
                ops.append((None, j-1)); ns = 'Iy'; j -= 1
        if (i > 0 or j > 0) and (ns is None):
            state = 'Ix' if j == 0 else 'Iy'
        else:
            state = ns
    ops.reverse()
    outA, outB = [], []
    for ia, jb in ops:
        outA.append(tuple(colsA[ia]) if ia is not None else ('-',)*len(profA))
        outB.append(tuple(colsB[jb]) if jb is not None else ('-',)*len(profB))
    newA = [''.join(t) for t in zip(*outA)] if outA else []
    newB = [''.join(t) for t in zip(*outB)] if outB else []
    return newA, newB, score

def flatten(node):
    if isinstance(node, int):
        return [node]
    return flatten(node[0]) + flatten(node[1])

def progressive_msa(names, seqs):
    """UPGMA guide tree + progressive profile alignment. -> (msa rows, leaf order, tree)"""
    k = len(seqs)
    dist = {i: {} for i in range(k)}
    for i, j in itertools.combinations(range(k), 2):
        _, _, sc = gotoh_align(seqs[i], seqs[j])
        d = -sc / min(len(seqs[i]), len(seqs[j]))
        dist[i][j] = dist[j][i] = d
    tree = upgma_tree(names, dist)
    profiles = {i: [seqs[i]] for i in range(k)}
    def align_node(node):
        if isinstance(node, int):
            return
        left, right = node
        align_node(left); align_node(right)
        la, ra = flatten(left), flatten(right)
        pa = [profiles[s][0] for s in la]   # each leaf profile is a single-row list
        pb = [profiles[s][0] for s in ra]
        na, nb, _ = align_profiles(pa, pb)
        for s, aln in zip(la, na): profiles[s] = [aln]
        for s, aln in zip(ra, nb): profiles[s] = [aln]
    align_node(tree)
    order = flatten(tree)
    return [profiles[s] for s in order], order, tree

def msa_sp_score(msa):
    return sum(pair_score(msa[a], msa[b])
               for a, b in itertools.combinations(range(len(msa)), 2))

def refine_one_round(msa, order, tree):
    """One refinement round: for each internal split of the guide tree, re-align the
    two subprofiles (extracted from the current MSA); accept a split if SP improves."""
    def internal_nodes(node, acc):
        if not isinstance(node, int):
            acc.append(node)
            internal_nodes(node[0], acc); internal_nodes(node[1], acc)
        return acc
    idx_of = {s: k for k, s in enumerate(order)}
    current, cur_score = list(msa), msa_sp_score(msa)
    for node in internal_nodes(tree, []):
        la, ra = set(flatten(node[0])), set(flatten(node[1]))
        def sub_profile(group):
            idxs = sorted(idx_of[s] for s in group)
            prof = [current[i] for i in idxs]
            keep = [c for c in range(len(prof[0])) if any(p[c] != '-' for p in prof)]
            return [''.join(p[c] for c in keep) for p in prof], idxs
        pa, ia = sub_profile(la)
        pb, ib = sub_profile(ra)
        na, nb, _ = align_profiles(pa, pb)
        cand = list(current)
        for k, aln in zip(ia, na): cand[k] = aln
        for k, aln in zip(ib, nb): cand[k] = aln
        sc = msa_sp_score(cand)
        if sc > cur_score:
            current, cur_score = cand, sc
    return current, cur_score

def main():
    files = ["1018517at2759.faa","1010730at2759.faa","1019762at2759.faa","1038775at2759.faa",
             "100698at2759.faa","1003258at2759.faa","1041560at2759.faa","1065019at2759.faa",
             "1079827at2759.faa","1014314at2759.faa"]
    os.makedirs("alignments", exist_ok=True)
    rows, per_pcts = [], []
    total_gaps = total_cells = 0
    for fn in files:
        recs = read_fasta(os.path.join(DATA, fn))
        names = [r[0] for r in recs]
        seqs = [r[1] for r in recs]
        msa, order, tree = progressive_msa(names, seqs)
        msa_ref, sc = refine_one_round(msa, order, tree)
        for aln, s in zip(msa_ref, [seqs[o] for o in order]):
            assert aln.replace('-', '') == s, "alignment lost residues!"
        nseq = len(msa_ref); ncol = len(msa_ref[0])
        assert all(len(a) == ncol for a in msa_ref)
        gaps = sum(a.count('-') for a in msa_ref)
        cells = nseq * ncol
        pct = 100.0 * gaps / cells
        total_gaps += gaps; total_cells += cells; per_pcts.append(pct)
        chars = sorted(set(''.join(msa_ref)))
        nonstd = [c for c in chars if c != '-' and c not in AAS]
        with open(os.path.join("alignments", fn.replace('.faa', '.aln.faa')), 'w') as fh:
            for nm, aln in zip([names[o] for o in order], msa_ref):
                fh.write(f">{nm}\n{aln}\n")
        rows.append({"file": fn, "nseq": nseq, "ncol": ncol, "cells": cells,
                     "gaps": gaps, "pct": pct})
        print(f"{fn}: nseq={nseq} ncol={ncol} cells={cells} gaps={gaps} "
              f"pct={pct:.4f}% nonstd={nonstd} refinement_SP={sc:.1f}")
    pooled = 100.0 * total_gaps / total_cells
    mean_pct = sum(per_pcts) / len(per_pcts)
    print("\n==== SUMMARY (FALLBACK method, NOT MAFFT --auto) ====")
    print(f"total gap chars ('-')      : {total_gaps}")
    print(f"total alignment cells      : {total_cells}")
    print(f"pooled gap percentage      : {pooled:.4f}%")
    print(f"mean of per-alignment pcts : {mean_pct:.4f}%")
    with open("results.json", "w") as fh:
        json.dump({"method": ("pure-Python Gotoh(affine)+BLOSUM62+UPGMA progressive "
                              "+ 1 refinement round; NOT MAFFT --auto (MAFFT unavailable "
                              "in environment)"),
                   "per_alignment": rows, "total_gaps": total_gaps,
                   "total_cells": total_cells, "pooled_pct": pooled,
                   "mean_pct": mean_pct, "gap_open": GAP_OPEN,
                   "gap_extend": GAP_EXTEND}, fh, indent=2)

if __name__ == "__main__":
    main()
