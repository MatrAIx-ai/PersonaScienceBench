"""CHIP variants per sample after filtering out intronic, intergenic and UTR variants.

Data: 86 sample workbooks in data/CHIP_DP10_GQ20_PASS/ (DP>=10, GQ>=20, PASS).
Each workbook: single sheet, two-row hierarchical header; data from row 3.
Key columns: Zygosity (col 5), Sequence Ontology (Combined) (col 14),
             Chr:Pos (col 1), Ref/Alt (col 2).

Filtering rules (per researcher-approved plan):
  - Excluded SO categories:
      intronic   : intron_variant
      intergenic : upstream_gene_variant  (closest to intergenic in this dataset;
                   no strict intergenic_variant exists - every row has a gene name)
      UTR        : 3_prime_UTR_variant, 5_prime_UTR_variant,
                   5_prime_UTR_premature_start_codon_gain_variant
  - Counted rows: Zygosity in {Heterozygous, Homozygous Variant}
    (Reference rows = reference genotype, not a variant carried by the sample ->
     excluded; Zygosity-missing rows = placeholder rows for the other alt allele
     at multiallelic sites -> excluded, semantics verified below).
  - Duplicates: deduplicated on (Chr:Pos, Ref/Alt).
  - splice_region_variant is NOT intronic -> kept (sensitivity analysis without it).
  - ClinVar columns and In_CHIP flag are not used for filtering.
  - All 86 sample files are used (no Trio_Status subsetting).
Run: python3 analysis.py
"""
import pandas as pd, glob, numpy as np, collections, os

DATA_GLOB = 'data/CHIP_DP10_GQ20_PASS/*.xlsx'
EXCLUDE = {'intron_variant',                       # intronic
           'upstream_gene_variant',                # intergenic (closest available)
           '3_prime_UTR_variant',                  # UTR
           '5_prime_UTR_variant',
           '5_prime_UTR_premature_start_codon_gain_variant'}

def load(path):
    df = pd.read_excel(path, sheet_name=0, header=[0, 1])
    df.columns = [c2 if c2 and str(c2) != 'nan' else c1 for c1, c2 in df.columns]
    return df

rows, nan_zyg_audit, so_outside = [], [], collections.Counter()
files = sorted(glob.glob(DATA_GLOB))
print(f'Number of sample files: {len(files)}')
for path in files:
    sample = os.path.basename(path).replace('230209_Exome_GRCh38_CHIP_', '').replace('.xlsx', '')
    df = load(path)
    assert df['In_CHIP'].all(), f'non-CHIP row found in {path}'
    # audit Zygosity-missing rows (placeholder semantics check)
    nz = df[df['Zygosity'].isna()]
    for _, r in nz.iterrows():
        grp = df[df['Chr:Pos'] == r['Chr:Pos']]
        ntyped = int(grp['Zygosity'].notna().sum())
        no_data = pd.isna(r['Read Depths (DP)']) and pd.isna(r['Variant Allele Freq'])
        if ntyped == 0:
            cat = 'no_genotype_data_at_position'
        elif no_data:
            cat = 'placeholder_other_alt_at_typed_position'
        else:
            cat = 'other'
        nan_zyg_audit.append({'sample': sample, 'pos': r['Chr:Pos'], 'ref_alt': r['Ref/Alt'],
                              'category': cat, 'rows_at_pos': len(grp), 'typed_rows_at_pos': ntyped})
    # count kept rows
    kept = df[(df['Zygosity'].isin(['Heterozygous', 'Homozygous Variant'])) &
              (~df['Sequence Ontology (Combined)'].isin(EXCLUDE))]
    kept = kept.drop_duplicates(subset=['Chr:Pos', 'Ref/Alt'])
    kept_sp = kept[kept['Sequence Ontology (Combined)'] != 'splice_region_variant']
    rows.append({'sample': sample, 'n_rows_total': len(df),
                 'n_nonref': int(df['Zygosity'].isin(['Heterozygous', 'Homozygous Variant']).sum()),
                 'n_kept': len(kept), 'n_kept_no_splice': len(kept_sp)})
    for v in kept['Sequence Ontology (Combined)']:
        so_outside[v] += 1

res = pd.DataFrame(rows)
def stats(x):
    return dict(mean=round(float(np.mean(x)), 2), median=float(np.median(x)),
                sd=round(float(np.std(x, ddof=1)), 2),
                min=int(np.min(x)), max=int(np.max(x)))

main = stats(res['n_kept'])
sens = stats(res['n_kept_no_splice'])
print('\nSO terms remaining after filter (rows summed over samples):', dict(so_outside.most_common()))
print(f'\nMAIN  (splice_region kept):    {main}')
print(f'SENS. (splice_region removed): {sens}')
cats = collections.Counter(a['category'] for a in nan_zyg_audit)
print(f"\nZygosity-missing rows audit: {len(nan_zyg_audit)} rows across all samples:")
for k, v in cats.most_common():
    print(f"  {k}: {v}")
print("  -> none carry genotype evidence (Zygosity/DP/VAF absent); excluded from counts.")
res.to_csv('chip_variants_per_sample.csv', index=False)
print('\nFirst rows of per-sample table:'); print(res.head(10).to_string(index=False))
