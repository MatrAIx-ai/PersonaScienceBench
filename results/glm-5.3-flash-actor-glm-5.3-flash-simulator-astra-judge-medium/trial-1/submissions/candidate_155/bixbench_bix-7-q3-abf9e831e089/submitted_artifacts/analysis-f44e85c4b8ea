#!/usr/bin/env python3
"""
bixbench:bix-7-q3 — How many CHIP variants remain after removing reference calls?

Primary convention (approved):
  - Load all 86 workbooks in data/CHIP_DP10_GQ20_PASS/ with normal (non-read_only) loading
    (read_only mode returns truncated rows because of broken sheet dimension metadata).
  - Remove records with Zygosity == 'Reference' (explicit reference genotype).
  - Also remove blank-zygosity rows (uncarried ALT allele at multiallelic sites).
  - Count remaining records (sample x ALT allele) = CHIP variant calls.
  - Sensitivity (alternatives, NOT the primary answer):
      (A) removing only explicit 'Reference' rows (keeping blank-zygosity rows)
      (B) counting distinct variant sites (Chr:Pos + Ref/Alt) with >=1 non-reference call
  - No additional gene-list / effect filtering (panel-scoped; In_CHIP flag constant 'True').
"""
import glob, os, json, collections
import openpyxl

DATA_GLOB = 'data/CHIP_DP10_GQ20_PASS/*.xlsx'
OUT_JSON  = 'artifacts/analysis_results.json'

records = []           # retained variant calls
stats = {
    'files_total': 0, 'files_skipped': 0, 'skipped_names': [],
    'rows_total': 0, 'zygosity_counts': collections.Counter(),
    'removed_reference': 0, 'removed_blank_zygosity': 0,
    'retained_heterozygous': 0, 'retained_homozygous': 0,
}
alt_A_total = 0        # sensitivity A: rows minus explicit Reference rows
nonref_sites = set()   # sensitivity B: distinct sites with >=1 non-reference call
per_file = {}          # file -> (rows, reference, blank, retained)
per_sample = collections.Counter()
per_gene = collections.Counter()
zyg_val_counter = collections.Counter()

files = sorted(glob.glob(DATA_GLOB))
for fp in files:
    name = os.path.basename(fp)
    try:
        wb = openpyxl.load_workbook(fp)          # normal load (NOT read_only)
    except Exception as e:
        stats['files_skipped'] += 1
        stats['skipped_names'].append((name, str(e)))
        continue
    ws = wb.worksheets[0]
    hdr2 = [c.value for c in ws[2]]
    zyg_i = hdr2.index('Zygosity'); gene_i = hdr2.index('Gene Names')
    hdr1 = [c.value for c in ws[1]]
    sample_id = hdr1[4].split('(')[1].rstrip(')')  # e.g. '502-P1' or 'SRR5463149'

    f_rows = f_ref = f_blank = f_ret = 0
    for r in ws.iter_rows(min_row=3, values_only=True):
        if r[0] is None:            # guard: fully empty trailing row
            continue
        f_rows += 1
        z = r[zyg_i]
        zyg_val_counter[z] += 1
        if z == 'Reference':
            f_ref += 1
        elif z is None:
            f_blank += 1
        else:
            f_ret += 1
            records.append({'sample': sample_id, 'file': name, 'chrpos': r[0],
                            'alt': r[1], 'zygosity': z, 'gene': r[gene_i],
                            'dp': r[7], 'gq': r[8]})
            nonref_sites.add((r[0], r[1]))
            per_sample[sample_id] += 1
            for g in str(r[gene_i]).split(','):
                per_gene[g.strip()] += 1
    stats['rows_total'] += f_rows
    stats['removed_reference'] += f_ref
    stats['removed_blank_zygosity'] += f_blank
    stats['retained_heterozygous'] += sum(1 for x in records if x['file']==name and x['zygosity']=='Heterozygous')
    stats['retained_homozygous'] += sum(1 for x in records if x['file']==name and x['zygosity']=='Homozygous Variant')
    alt_A_total += (f_rows - f_ref)
    per_file[name] = {'rows': f_rows, 'reference': f_ref, 'blank_zygosity': f_blank, 'retained': f_ret}
    wb.close()

stats['files_total'] = len(files)
primary_answer = stats['removed_reference'] + stats['removed_blank_zygosity']  # removed
retained = stats['rows_total'] - stats['removed_reference'] - stats['removed_blank_zygosity']
result = {
    'primary_answer_CHIP_variant_calls_remaining': retained,
    'reconciliation': {
        'total_records': stats['rows_total'],
        'removed_reference': stats['removed_reference'],
        'removed_blank_zygosity_uncarried_alt': stats['removed_blank_zygosity'],
        'removed_total': stats['removed_reference'] + stats['removed_blank_zygosity'],
        'retained_total': retained,
        'sum_check': stats['rows_total'] == retained + stats['removed_reference'] + stats['removed_blank_zygosity'],
        'zygosity_counts_raw': {str(k): v for k, v in zyg_val_counter.items()},
        'files_total': stats['files_total'], 'files_skipped': stats['files_skipped'],
    },
    'sensitivity_A_keep_blank_zygosity': alt_A_total,
    'sensitivity_B_distinct_variant_sites': len(nonref_sites),
    'retained_by_zygosity': {'Heterozygous': stats['retained_heterozygous'],
                             'Homozygous Variant': stats['retained_homozygous']},
    'retained_per_sample_top10': per_sample.most_common(10),
    'retained_per_gene_top15': per_gene.most_common(15),
    'n_samples_with_calls': len(per_sample),
    'per_file': per_file,
}
with open(OUT_JSON, 'w') as fh:
    json.dump(result, fh, indent=2, default=str)
print(json.dumps({k: v for k, v in result.items() if k != 'per_file'}, indent=2, default=str))
