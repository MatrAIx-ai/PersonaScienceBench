"""Formal analysis for bixbench bix-8-q5:
Independence test between m6A methylation status and differential expression (DEG) status.

Primary analysis: record-level 2x2 Pearson chi-square WITHOUT Yates continuity correction
(expected counts all far > 5). Sensitivity analyses: Yates-corrected chi-square,
Fisher exact, 3x3 test, and gene-level collapsed table.
"""
import numpy as np
import pandas as pd
from scipy.stats import chi2_contingency, fisher_exact

pd.set_option('display.width', 300, 'display.max_columns', 30)

df = pd.read_excel('data/MeRIP_RNA_result.xlsx', sheet_name='Date Formatting')
assert df.shape == (12754, 13) and df.isna().sum().sum() == 0

# ---------------- Primary 2x2 table (record level) ----------------
m6a_lab = np.where(df['m6A'].str.contains('no sig'), 'm6A no sig', 'm6A sig (Hyper+Hypo)')
deg_lab = np.where(df['DEG'] == 'no-DEGs', 'no-DEGs', 'DEG (Up+Down)')
tab = pd.crosstab(pd.Series(m6a_lab, name='m6A'), pd.Series(deg_lab, name='DEG'))
tab = tab.reindex(index=['m6A no sig', 'm6A sig (Hyper+Hypo)'],
                  columns=['no-DEGs', 'DEG (Up+Down)'])
print("=== Primary 2x2 contingency table (observed) ===")
print(tab, "\nN =", tab.values.sum())

chi2_nc, p_nc, dof, exp = chi2_contingency(tab, correction=False)
print("\n--- PRIMARY: Pearson chi-square, NO Yates correction ---")
print(f"chi2 = {chi2_nc:.6f}, df = {dof}")
print(f"p-value = {p_nc:.6e}")
print("expected frequencies:\n", pd.DataFrame(exp, index=tab.index, columns=tab.columns))

# ---------------- Sensitivity analyses ----------------
chi2_y, p_y, _, _ = chi2_contingency(tab, correction=True)
print(f"\n[Sens 1] Yates-corrected 2x2 chi2 = {chi2_y:.6f}, p = {p_y:.6e}")

odds, p_f = fisher_exact(tab.values)
print(f"[Sens 2] Fisher exact 2x2: odds ratio = {odds:.6f}, p = {p_f:.6e}")

tab3 = pd.crosstab(df['m6A'], df['DEG'])
chi3, p3, dof3, exp3 = chi2_contingency(tab3, correction=False)
print(f"\n[Sens 3] 3x3 (m6A 3 levels x DEG 3 levels): chi2 = {chi3:.6f}, df = {dof3}, p = {p3:.6e}")
print("3x3 observed:\n", tab3)
print("3x3 expected min:", exp3.min())

# Gene-level collapsed table: gene is m6A-sig if ANY transcript record is sig;
# gene is DEG if ANY transcript record is DEG
gene_lvl = df.groupby('gene_id').agg(m6a=('m6A', lambda s: (~s.str.contains('no sig')).any()),
                                     deg=('DEG', lambda s: (s != 'no-DEGs').any()))
gtab = pd.crosstab(gene_lvl['m6a'].map({False: 'm6A no sig (gene)', True: 'm6A sig (gene)'}),
                   gene_lvl['deg'].map({False: 'no-DEGs', True: 'DEG'}))
gtab = gtab.reindex(index=['m6A no sig (gene)', 'm6A sig (gene)'], columns=['no-DEGs', 'DEG'])
print(f"\n[Sens 4] Gene-level collapsed 2x2 (n genes = {len(gene_lvl)}):\n", gtab)
chiG, pG, dofG, expG = chi2_contingency(gtab, correction=False)
print(f"gene-level chi2 (no Yates) = {chiG:.6f}, df = {dofG}, p = {pG:.6e}")

# ---------------- Summary ----------------
print("\n================ SUMMARY ================")
print(f"PRIMARY (record-level 2x2 Pearson chi2, no Yates): p = {p_nc:.4e}  (chi2={chi2_nc:.4f}, df={dof})")
print(f"  Yates-corrected:            p = {p_y:.4e}")
print(f"  Fisher exact:               p = {p_f:.4e}")
print(f"  3x3 chi2:                   p = {p3:.4e}")
print(f"  gene-level collapsed 2x2:   p = {pG:.4e}")
