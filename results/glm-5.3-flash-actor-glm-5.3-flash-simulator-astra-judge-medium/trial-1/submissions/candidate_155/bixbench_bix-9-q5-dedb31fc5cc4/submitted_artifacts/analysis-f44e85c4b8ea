#!/usr/bin/env python3
"""
BixBench bix-9-q5 analysis:
In which tissue type do bad responders show the highest number of significantly
differentially expressed (|lfc|>0.5 and baseMean>10) genes compared to controls?

Data: data/Data_deposition_RNAseq_Paroxetine_2017.xlsx
Strategy: REUSE the authors' precomputed DESeq2 results embedded in the 'NormCount'
sheet (raw counts are not supplied; a fresh NB test on the normalized matrix would
be statistically improper). Identify the three 'bad_responder vs Control' blocks
(2, 5, 8) and VERIFY their contrast direction in code via group-mean matching.
Primary criterion: padj < 0.05 AND baseMean > 10 AND |log2FoldChange| > 0.5.
NA/Inf are treated as not significant. Sensitivity analyses: one-sided (lfc > +0.5)
and the workbook's own DEG flags intersected with the thresholds.
"""
import numpy as np
import openpyxl
from collections import Counter

XLSX = "/workspace/data/Data_deposition_RNAseq_Paroxetine_2017.xlsx"
PADJ_CUT = 0.05
LFC_CUT = 0.5
BASEMEAN_CUT = 10.0

wb = openpyxl.load_workbook(XLSX, read_only=True)

# ---------------- 1. Parse Mapping_statistics ----------------
ms = wb["Mapping_statistics"]
meta = []  # (SampleID, Response, Tissue, Code)
for r in ms.iter_rows(min_row=2, values_only=True):
    if r[1]:
        meta.append((r[1], r[6], r[7], r[8]))
resp_counter = Counter(m[1] for m in meta)
tissue_counter = Counter(m[2] for m in meta)
cell_counter = Counter((m[1], m[2]) for m in meta)
print("Mapping_statistics: n samples =", len(meta))
print("  Response:", dict(resp_counter))
print("  Tissue  :", dict(tissue_counter))
print("  Response x Tissue cells:", {f"{a}|{b}": v for (a, b), v in sorted(cell_counter.items())})

# ---------------- 2. Parse NormCount ----------------
ws = wb["NormCount"]
rows = ws.iter_rows(values_only=True)
r1 = next(rows); next(rows); r3 = next(rows)          # block-label rows 1-3
hdr = next(rows)                                       # row 4 = true header
sample_names = [hdr[j] for j in range(2, 92)]
assert set(sample_names) == {m[3] for m in meta}, "Code <-> NormCount column mismatch"
print("\nNormCount: 90 sample columns match Mapping_statistics 'Code' values exactly.")

# group membership from column names
def group_of(name):
    for resp in ("Control", "good_responder", "bad_responder"):
        if name.startswith(resp + "_"):
            return resp, name[len(resp) + 1:].rstrip("0123456789")
    raise ValueError(name)

groups = {}
for j in range(2, 92):
    resp, tis = group_of(hdr[j])
    groups.setdefault(tis, {}).setdefault(resp, []).append(j - 2)  # 0-based over 90 value cols

# read gene rows: value matrix (cols 2-91) + DESeq blocks (start = 98 + 9k)
BLOCK_STARTS = [98 + 9 * k for k in range(9)]
BLOCK_FIELDS = ["baseMean", "baseMeanA", "baseMeanB", "foldChange",
                "log2FoldChange", "pval", "padj", "DEG_Max", "DEG_Median"]
values, blocks = [], {k: {f: [] for f in BLOCK_FIELDS} for k in range(9)}
genes = []
for row in ws.iter_rows(min_row=5, values_only=True):
    if row[1] is None:
        continue
    genes.append(row[1])
    values.append([row[j] for j in range(2, 92)])
    for k in range(9):
        s = BLOCK_STARTS[k]
        for i, f in enumerate(BLOCK_FIELDS):
            blocks[k][f].append(row[s + i])
M = np.array(values, dtype=float)
print("NormCount value matrix:", M.shape,
      "| non-integer values:", np.sum(M != np.round(M)),
      "-> DESeq size-factor-normalized counts (not raw, not log).")

def to_num(x):
    return float(x) if isinstance(x, (int, float)) else np.nan  # 'NA', 'Inf', '=-Inf' -> NaN

for k in range(9):
    for f in ("baseMean", "baseMeanA", "baseMeanB", "foldChange",
              "log2FoldChange", "pval", "padj"):
        blocks[k][f] = np.array([to_num(x) for x in blocks[k][f]])
print("Row 1/3 labels confirm: comps 1-3 = 'DESeq, Comparison 1-3, exclude outliers' "
      "blocks follow the baseline_blood Max/Median summary columns, etc.")

# ---------------- 3. Identify + VERIFY contrast of every block in code ----------------
print("\n=== Contrast identification/verification (code-fixed, not hand-waved) ===")
group_means = {tis: {resp: M[:, idx].mean(axis=1) for resp, idx in d.items()}
               for tis, d in groups.items()}
block_tissue = {k: t for k, t in zip(range(9),
                 ["baseline_blood"] * 3 + ["dentate_gyrus"] * 3 + ["final_blood"] * 3)}
block_contrast = {}
for k in range(9):
    tis = block_tissue[k]
    lfc = blocks[k]["log2FoldChange"]
    scores = {}
    for g1 in ("Control", "good_responder", "bad_responder"):
        for g2 in ("Control", "good_responder", "bad_responder"):
            if g1 == g2:
                continue
            x = np.log2(group_means[tis][g1] / group_means[tis][g2])
            ok = np.isfinite(x) & np.isfinite(lfc)
            scores[(g1, g2)] = np.corrcoef(x[ok], lfc[ok])[0, 1]
    (gA, gB), best = max(scores.items(), key=lambda kv: kv[1])
    block_contrast[k] = (gA, gB, best)
    print(f"Block {k+1} ({tis}): baseMeanA='{gA}', baseMeanB='{gB}' "
          f"(corr of lfc with log2(meanA/meanB) = {best:.3f}); "
          f"runner-up: {sorted(scores.items(), key=lambda kv: -kv[1])[1][0]} r="
          f"{sorted(scores.values(), reverse=True)[1]:.3f}")

BAD_VS_CTRL = {k: block_contrast[k] for k in (1, 4, 7)}  # 0-based -> blocks 2,5,8
print("\nBad responder vs Control blocks (0-based 1,4,7 = workbook blocks 2,5,8):")
for k, (gA, gB, r) in BAD_VS_CTRL.items():
    print(f"  Block {k+1} ({block_tissue[k]}): A={gA}, B={gB}, r={r:.3f}")

# ---------------- 4. Primary count: padj<0.05 & baseMean>10 & |lfc|>0.5 ----------------
def count_block(k, two_sided=True, use_flags=None):
    bm, lfc, padj = blocks[k]["baseMean"], blocks[k]["log2FoldChange"], blocks[k]["padj"]
    ok = np.isfinite(bm) & np.isfinite(lfc) & np.isfinite(padj)
    sel = ok & (padj < PADJ_CUT) & (bm > BASEMEAN_CUT)
    sel &= (np.abs(lfc) > LFC_CUT) if two_sided else (lfc > LFC_CUT)
    if use_flags is not None:
        sel &= np.isin(np.array(blocks[k][use_flags], dtype=object), ["U", "D"])
    return sel

results = {}
print("\n=== PRIMARY RESULT (reused authors' precomputed DESeq2 blocks; "
      f"padj<{PADJ_CUT}, baseMean>{BASEMEAN_CUT}, |lfc|>{LFC_CUT}) ===")
print(f"{'tissue':<16}{'block':<7}{'contrast (A vs B)':<38}{'n DEGs':<8}"
      f"{'n up':<7}{'n down':<7}")
for k in (1, 4, 7):
    tis = block_tissue[k]
    gA, gB, r = block_contrast[k]
    sel = count_block(k, two_sided=True)
    up = int(np.sum(sel & (blocks[k]["log2FoldChange"] > 0)))
    down = int(np.sum(sel & (blocks[k]["log2FoldChange"] < 0)))
    results[tis] = dict(n=int(sel.sum()), up=up, down=down,
                        contrast=f"{gA} vs {gB}")
    print(f"{tis:<16}{k+1:<7}{gA+' vs '+gB:<38}{int(sel.sum()):<8}{up:<7}{down:<7}")
winner = max(results, key=lambda t: results[t]["n"])
print(f"\n--> Tissue with the HIGHEST number of significant DEGs (bad vs control): {winner}")

# ---------------- 5. Sensitivity analyses ----------------
print("\n=== Sensitivity A: one-sided (lfc > +0.5 only, up-regulated in bad responders) ===")
for k in (1, 4, 7):
    tis = block_tissue[k]
    sel = count_block(k, two_sided=False)
    print(f"  {tis:<16} block {k+1}: n = {int(sel.sum())}")

print("\n=== Sensitivity B: workbook's own DEG flags (U/D) intersected with the "
      "thresholds (padj<0.05 & baseMean>10 & |lfc|>0.5) ===")
for crit in ("DEG_Median", "DEG_Max"):
    print(f"  -- DEG criterion: {crit} --")
    for k in (1, 4, 7):
        tis = block_tissue[k]
        sel = count_block(k, two_sided=True, use_flags=crit)
        print(f"  {tis:<16} block {k+1}: n = {int(sel.sum())}")

print("\n=== Sensitivity C: workbook's own DEG flags alone (no extra thresholds) ===")
for crit in ("DEG_Median", "DEG_Max"):
    print(f"  -- DEG criterion: {crit} --")
    for k in (1, 4, 7):
        tis = block_tissue[k]
        flags = np.array(blocks[k][crit], dtype=object)
        print(f"  {tis:<16} block {k+1}: n = {int(np.isin(flags, ['U','D']).sum())}")

# ---------------- 6. Top genes per tissue (evidence) ----------------
print("\n=== Top 5 significant DEGs per tissue (by |lfc|), primary criterion ===")
for k in (1, 4, 7):
    tis = block_tissue[k]
    sel = count_block(k, two_sided=True)
    idx = np.where(sel)[0]
    order = idx[np.argsort(-np.abs(blocks[k]["log2FoldChange"][idx]))][:5]
    print(f"  {tis} (block {k+1}, {block_contrast[k][0]} vs {block_contrast[k][1]}):")
    for i in order:
        print(f"    {genes[i]:<12} baseMean={blocks[k]['baseMean'][i]:9.1f} "
              f"lfc={blocks[k]['log2FoldChange'][i]:+.2f} padj={blocks[k]['padj'][i]:.2e}")

print("\nDone.")
