"""
Growth-phase analysis, 2000-1100 BCE.
Century convention: the Nth century BCE = years N000..N001 BCE (e.g. 20th c. BCE = 2000-1901 BCE).
Tracks:
  a) demographic/activity: per-century mean g_all_mean (yearly KDE growth rate) and
     log-difference of kde_all_mean between century endpoints (time_series_data.csv, yearly grain)
  b) material culture: century-over-century DeltaZ for the 12 Z indicators from capital.csv
     (native 100-y grain), mean DeltaZ, #increasing, PC1 composite index and its DeltaPC1.
     Robustness: same computed from _inter columns of time_series_data.csv (yearly grain).
  c) land use: per-century mean pollen_grate_100, Delta pollen_inter_100 (endpoints),
     Delta SMOOTH_MEAN_100y (pollen file). Raw pollen observation counts per century.
Sign convention: g_all_mean and pollen_grate_100 are per-year fractional rates, positive = increase.
"""
import pandas as pd, numpy as np

ts   = pd.read_csv('data/time_series_data.csv')
cap  = pd.read_csv('data/capital.csv', decimal=',')
pol  = pd.read_csv('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv', decimal=',')

# ---- century bins (convention: Nth c. BCE = N000..N001 BCE) -----------------
centuries = [(2000,'20th'),(1900,'19th'),(1800,'18th'),(1700,'17th'),
             (1600,'16th'),(1500,'15th'),(1400,'14th'),(1300,'13th'),(1200,'12th')]
# 11th c. BCE (1100-1001) is almost entirely outside the window (data end at 1100 BCE).

ts = ts.set_index('CE').sort_index()
win = ts.loc[-2000:-1100]

# ---- Track a ----------------------------------------------------------------
rows=[]
for start,name in centuries:
    yrs = win.loc[-start : -(start-99)]           # N000 .. (N-1)01 inclusive
    g_mean = yrs.g_all_mean.mean()                # avg yearly growth rate
    g_sum  = yrs.g_all_mean.sum()                 # ~ total log-growth over the century
    kde_start = win.loc[-start,'kde_all_mean']; kde_end = win.loc[-(start-99),'kde_all_mean']
    dlog = np.log(kde_end)-np.log(kde_start)
    rows.append(dict(century=f'{name} c. BCE', span=f'{start}-{start-99} BCE',
                     g_mean_per_yr=g_mean, g_total=g_sum, dlog_kde=dlog,
                     kde_start=kde_start, kde_end=kde_end))
A = pd.DataFrame(rows)

# ---- Track b (capital.csv, native 100-y grain) ------------------------------
Z = ['ZAxtSchwert','ZDolch','Zhausgr','ZCU_AU','Zamber','ZMonument','ZHort',
     'ZSichel','ZBeil','ZMW','ZKeform','Zkeverz']
capv = cap.set_index('BCE')[Z].sort_index()
X = (capv - capv.mean()) / capv.std()          # re-standardize for PCA stability
Xc = X - X.mean()
u,s,vt = np.linalg.svd(Xc.values, full_matrices=False)
pc1 = Xc.values @ vt[0]; pc1 = pd.Series(pc1, index=X.index)
if pc1.corr(capv.iloc[:,0]) < 0: pc1 = -pc1    # orient: higher = more capital
rows=[]
for start,name in centuries:
    if start-100 < capv.index.min(): continue
    dz = capv.loc[start-100] - capv.loc[start]   # change during century N (row N+100 minus row N)
    dpc = pc1.loc[start-100] - pc1.loc[start]
    rows.append(dict(century=f'{name} c. BCE', mean_dZ=dz.mean(), n_up=(dz>0).sum(),
                     n_of_12=len(dz), dPC1=dpc))
B = pd.DataFrame(rows)

# ---- Track b robustness (_inter columns, yearly grain) ----------------------
INTER = {'HatchetSword_inter':'ZAxtSchwert','Dagger_inter':'ZDolch','HouseSize_inter':'Zhausgr',
         'CopperGold_inter':'ZCU_AU','Amber_inter':'Zamber','MonumentCount_inter':'ZMonument',
         'Depot_inter':'ZHort','Sickle_inter':'ZSichel','AxesCelts_inter':'ZBeil',
         'MonumentSize_inter':'ZMW','PotteryForm_inter':'ZKeform','PotteryDecoration_inter':'Zkeverz'}
rows=[]
for start,name in centuries:
    v_end   = win.loc[-start, list(INTER)]          # state at N000
    v_start = win.loc[-(start-99), list(INTER)]  # state at (N-1)01
    dz = v_start.values - v_end.values
    rows.append(dict(century=f'{name} c. BCE', mean_dZ_inter=dz.mean(), n_up_inter=(dz>0).sum()))
B2 = pd.DataFrame(rows)

# ---- Track c (pollen) --------------------------------------------------------
polf = pol.set_index('CE').sort_index()
rows=[]
for start,name in centuries:
    yrs = win.loc[-start : -(start-100)+1]
    seg = polf.loc[-start : -(start-99)]
    grate = yrs.pollen_grate_100.mean()
    pi_end = win.loc[-start,'pollen_inter_100']; pi_start = win.loc[-(start-99),'pollen_inter_100']
    sm_end = seg.SMOOTH_MEAN_100y.iloc[0];       sm_start = seg.SMOOTH_MEAN_100y.iloc[-1]
    n_raw = int(yrs.pollen.notna().sum())
    rows.append(dict(century=f'{name} c. BCE', grate_mean=grate,
                     d_pollen_inter_100=pi_start-pi_end, d_SM100=sm_start-sm_end,
                     n_pollen_raw=n_raw))
C = pd.DataFrame(rows)

# ---- Combine & rank ----------------------------------------------------------
M = A.merge(B,on='century').merge(B2,on='century').merge(C,on='century')
for col,asc in [('g_mean_per_yr',False),('dlog_kde',False),('mean_dZ',False),('dPC1',False),
                ('grate_mean',False),('d_pollen_inter_100',False),('d_SM100',False)]:
    M[f'rank_{col}'] = M[col].rank(ascending=asc, method='min').astype(int)
M['rank_mean'] = M[[c for c in M.columns if c.startswith('rank_')]].mean(axis=1)

pd.set_option('display.width',250); pd.set_option('display.max_columns',50)
print("=== TRACK A: demographic/activity (yearly grain) ===");   print(A.round(6).to_string(index=False))
print("\n=== TRACK B: material culture (capital.csv, 100-y grain) ==="); print(B.round(3).to_string(index=False))
print("\nPC1 loadings (capital composite):")
print(pd.Series(vt[0], index=Z).round(3).to_string())
print("\nPC1 by century (BCE row -> PC1):"); print(pc1.loc[1100:2000].round(3).to_string())
print("\n=== TRACK B robustness (_inter, yearly grain) ==="); print(B2.round(3).to_string(index=False))
print("\n=== TRACK C: pollen / land use ==="); print(C.round(5).to_string(index=False))
print("\n=== COMBINED RANK TABLE ===")
print(M[['century','span','g_mean_per_yr','dlog_kde','mean_dZ','n_up','dPC1',
         'mean_dZ_inter','grate_mean','d_pollen_inter_100','d_SM100','n_pollen_raw',
         'rank_g_mean_per_yr','rank_dlog_kde','rank_mean_dZ','rank_dPC1',
         'rank_grate_mean','rank_d_SM100','rank_mean']].round(5).to_string(index=False))
M.to_csv('analysis/per_century_metrics.csv', index=False)

# quick consistency: alternative boundary convention check (bins shifted by 1y)
rows_alt=[]
for start,name in centuries:
    yrs = win.loc[-start+1 : -(start-100)]   # shifted-boundary convention
    rows_alt.append((name, yrs.g_all_mean.mean()))
alt = pd.DataFrame(rows_alt, columns=['century','g_mean_shifted'])
print("\n=== Boundary-convention sensitivity (g_mean, bins shifted 1 y) ===")
print(alt.round(6).to_string(index=False))
print("\nTop century under primary convention:", M.loc[M.rank_mean.idxmin(),'century'])
print("Top century under shifted convention:", alt.loc[alt.g_mean_shifted.idxmax(),'century'])
