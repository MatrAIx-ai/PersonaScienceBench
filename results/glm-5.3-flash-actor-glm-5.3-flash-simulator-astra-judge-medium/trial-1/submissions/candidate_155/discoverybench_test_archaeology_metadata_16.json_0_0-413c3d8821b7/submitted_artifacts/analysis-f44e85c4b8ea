"""PCA on forms of capital (hundred-year time slices), DiscoveryBench archaeology task.

Data: capital.csv — 39 century slices (4300-500 BCE), 12 Z-standardized capital variables.
PCA via numpy SVD on re-standardized variables (correlation-matrix PCA).
Sign convention (as approved): PC1 is oriented so that it is POSITIVELY correlated
with the overall level of capital variables, operationalized as a positive Pearson
correlation between PC1 scores and the row-mean of the 12 standardized variables.
Two fits:
  Fit A: PCA on all 39 slices (primary).
  Fit B: PCA on the 12 MN+SG slices only (sensitivity check).
Periods (per capital.csv group labels): MN = 3400-3000 BCE (5 slices);
'Younger Neolithic' 2900-2300 BCE = group SG (7 slices) — name mapping given by the task.
"""
import pandas as pd, numpy as np

OUT = []
def log(s=""):
    print(s); OUT.append(str(s))

cap = pd.read_csv('data/capital.csv', decimal=',')
ZCOLS = ['ZAxtSchwert','ZDolch','Zhausgr','ZCU_AU','Zamber','ZMonument',
         'ZHort','ZSichel','ZBeil','ZMW','ZKeform','Zkeverz']
bce, grp = cap.BCE.values, cap.group.values
X = cap[ZCOLS].astype(float).values

def run_pca(Xfit):
    mu, sd = Xfit.mean(0), Xfit.std(0, ddof=1)
    Xs = (Xfit - mu) / sd
    composite = Xs.mean(1)                       # overall capital level per slice
    U, S, Vt = np.linalg.svd(Xs, full_matrices=False)
    var = S**2 / (len(Xfit) - 1); evr = var / var.sum()
    load = Vt[:4]; scores = Xs @ Vt[:4].T
    r = np.corrcoef(scores[:,0], composite)[0,1]
    if r < 0:                                    # sign convention flip
        load = load.copy(); load[0] = -load[0]
        scores = scores.copy(); scores[:,0] = -scores[:,0]
        r = -r
    return evr, scores, load, r, composite

def trend_block(sub, name):
    d = sub.PC1.values                            # newest -> oldest
    log(f"\n{name}: PC1 max {d.max():.3f}, min {d.min():.3f}, within-period range {d.max()-d.min():.3f}")
    log("  time-ordered (newest->oldest BCE): " + ", ".join(f"{v:.2f}" for v in d))
    steps = ", ".join(f"{int(bb)}->{int(aa)}:{'+' if dd>0 else '-'}{abs(dd):.2f}"
                      for aa, bb, dd in zip(d[:-1], d[1:], np.diff(d)))
    log(f"  stepwise changes (newest->oldest): {steps}")
    log("  overall trend: " + ("PC1 DECLINES going back in time (highest at the period's younger end)"
                              if d[0] > d[-1] else
                              "PC1 RISES going back in time (highest at the period's older end)"))

def loadings_block(load, evr, label):
    log(f"\n===== {label} =====")
    log("Explained variance ratio PC1..PC4: " + ", ".join(f"{v:.3f}" for v in evr[:4]))
    log(f"PC1 explains {evr[0]*100:.1f}% of variance")
    log("PC1 loadings (sign convention: positive = higher overall capital level):")
    for c, l in sorted(zip(ZCOLS, load[0]), key=lambda t: -abs(t[1])):
        log(f"  {c:12s} {l:+.3f}")

# ---------- Fit A ----------
log("### Fit A: PCA on all 39 century slices (4300-500 BCE)")
evrA, scA, ldA, rA, compA = run_pca(X)
log(f"corr(PC1, composite mean of 12 standardized vars) = {rA:+.3f} -> positive direction kept")
loadings_block(ldA, evrA, "Fit A: all periods")
subA = pd.DataFrame({'BCE': bce, 'group': grp, 'PC1': scA[:,0], 'PC2': scA[:,1],
                     'PC3': scA[:,2], 'PC4': scA[:,3]}).sort_values('BCE', ascending=False)
log("\nPC scores by slice (newest first):")
log(subA.to_string(index=False, float_format=lambda v: f"{v:.3f}"))
trend_block(subA[subA.group=='MN'], "MN (3400-3000 BCE)")
trend_block(subA[subA.group=='SG'], "YN/SG (2900-2300 BCE)")

# ---------- Fit B ----------
log("\n\n### Fit B (sensitivity): PCA on MN+SG slices only (3400-2300 BCE, n=12)")
mBS = (grp=='MN') | (grp=='SG')
evrB, scB, ldB, rB, compB = run_pca(X[mBS])
log(f"corr(PC1, composite mean of 12 standardized vars) = {rB:+.3f} -> positive direction kept")
loadings_block(ldB, evrB, "Fit B: MN+SG only")
subB = pd.DataFrame({'BCE': bce[mBS], 'group': grp[mBS], 'PC1': scB[:,0],
                     'PC2': scB[:,1], 'PC3': scB[:,2], 'PC4': scB[:,3]}
                    ).sort_values('BCE', ascending=False)
log("\nPC scores by slice (newest first):")
log(subB.to_string(index=False, float_format=lambda v: f"{v:.3f}"))
trend_block(subB[subB.group=='MN'], "MN (3400-3000 BCE)")
trend_block(subB[subB.group=='SG'], "YN/SG (2900-2300 BCE)")

# ---------- Comparison ----------
log("\n\n### PC1 loadings comparison, Fit A vs Fit B")
cmp = pd.DataFrame({'FitA_PC1': ldA[0], 'FitB_PC1': ldB[0]}, index=ZCOLS)
cmp['diff'] = cmp.FitA_PC1 - cmp.FitB_PC1
log(cmp.round(3).to_string())
both = pd.DataFrame({'A': subA[subA.group.isin(['MN','SG'])].PC1.values, 'B': subB.PC1.values})
log(f"\nPearson r of PC1 (12 MN+SG slices) between Fit A and Fit B: {both.A.corr(both.B):.3f}")
log(f"Within-period ranges — Fit A: MN {subA[subA.group=='MN'].PC1.max()-subA[subA.group=='MN'].PC1.min():.2f}, "
    f"SG {subA[subA.group=='SG'].PC1.max()-subA[subA.group=='SG'].PC1.min():.2f}; "
    f"Fit B: MN {subB[subB.group=='MN'].PC1.max()-subB[subB.group=='MN'].PC1.min():.2f}, "
    f"SG {subB[subB.group=='SG'].PC1.max()-subB[subB.group=='SG'].PC1.min():.2f}")

# raw century Z values for the two periods (for narrative grounding)
log("\n### Raw century Z values, MN and YN/SG slices")
log(cap[mBS].sort_values('BCE', ascending=False).to_string(index=False))

# ---------- Pollen background (comma decimals) ----------
pol = pd.read_csv('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv',
                  index_col=0, decimal=',')
pol['BCE'] = -pol.CE.astype(float)
seg = pol[(pol.BCE>=2300)&(pol.BCE<=3400)]
log("\n### Pollen openness context (SMOOTH_MEAN_100y) — background only")
log(f"MN    (3400-3000 BCE) mean openness: {seg[seg.BCE>=3000].SMOOTH_MEAN_100y.mean():.2f}")
log(f"YN/SG (2900-2300 BCE) mean openness: {seg[seg.BCE<=2900].SMOOTH_MEAN_100y.mean():.2f}")
log(f"EN    (4300-3500 BCE) mean openness: {pol[(pol.BCE>=3500)&(pol.BCE<=4300)].SMOOTH_MEAN_100y.mean():.2f}")

# ---------- Save ----------
subA.to_csv('outputs/pc_scores_fitA_all_periods.csv', index=False)
subB.to_csv('outputs/pc_scores_fitB_MN_SG.csv', index=False)
pd.DataFrame({'variable': ZCOLS, 'FitA_PC1': ldA[0], 'FitB_PC1': ldB[0],
              'FitA_PC2': ldA[1], 'FitB_PC2': ldB[1]}).to_csv('outputs/pc1_loadings.csv', index=False)
with open('outputs/pca_results.txt','w') as f:
    f.write("\n".join(OUT))
print("\nSaved: outputs/pca_results.txt, pc_scores_fitA_all_periods.csv, "
      "pc_scores_fitB_MN_SG.csv, pc1_loadings.csv")
