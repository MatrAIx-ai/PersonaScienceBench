import pandas as pd, numpy as np

np.set_printoptions(precision=3, suppress=True)

# ---------- Load ----------
cap = pd.read_csv('/workspace/data/capital.csv', decimal=',')
ZCOLS = ['ZAxtSchwert','ZDolch','Zhausgr','ZCU_AU','Zamber','ZMonument',
         'ZHort','ZSichel','ZBeil','ZMW','ZKeform','Zkeverz']
GROUPS = {  # confirmed study-context mapping
 'symbolic': ['ZAxtSchwert','ZDolch','Zhausgr'],
 'social':   ['ZCU_AU','Zamber','ZMonument'],
 'cultural': ['ZKeform','Zkeverz'],
 'economic': ['ZHort','ZSichel','ZBeil','ZMW'],
}

def pca_corr(X, cols, label=''):
    """PCA on correlation matrix (standardize columns). Returns scores, loadings, evr.
    Zero-variance columns are dropped (their correlation is undefined)."""
    X = np.asarray(X, float)
    keep = X.std(0, ddof=0) > 0
    if not keep.all():
        print(f"[{label}] dropping zero-variance columns: {[c for c,k in zip(cols,keep) if not k]}")
        cols = [c for c,k in zip(cols,keep) if k]
        X = X[:, keep]
    Xs = (X - X.mean(0)) / X.std(0, ddof=0)
    C = np.corrcoef(Xs, rowvar=False)
    w, V = np.linalg.eigh(C)
    order = np.argsort(w)[::-1]
    w, V = w[order], V[:, order]
    scores = Xs @ V
    loadings = V * np.sqrt(w)          # corr(var, PC)
    evr = w / w.sum()
    return scores, loadings, evr, w, cols

def sign_fix(loadings, orient_vars=('ZCU_AU','ZHort','Zamber','ZMonument')):
    """Orient PC1 so that the mean loading on status/social-economic abundance vars is positive."""
    idx = [list(loadings.index).index(v) for v in orient_vars if v in loadings.index]
    s = np.sign(np.mean(loadings.values[idx, 0]))
    return s if s != 0 else 1.0

def report(scores, loadings, evr, label, slices=None):
    loadings = loadings.copy()
    s = sign_fix(loadings)
    pc1 = scores[:, 0] * s
    loadings.iloc[:, 0] *= s
    print(f"\n===== {label} =====")
    print("Explained variance ratio (PC1..PC4):", np.round(evr[:4], 3),
          f"| PC1 = {evr[0]*100:.1f}%")
    print("PC1 loadings (correlations, sign-fixed):")
    print(loadings.iloc[:, 0].round(3).to_string())
    df = pd.DataFrame({'BCE': slices, 'PC1': pc1, 'PC2': scores[:,1]})
    return df, loadings

slices = cap['BCE'].values

# ---------- Primary: full 39 x 12 correlation PCA ----------
scores, load_df, evr, ev, used = pca_corr(cap[ZCOLS], ZCOLS)
load_df = pd.DataFrame(load_df, index=used)
prim, prim_load = report(scores, load_df, evr, "PRIMARY: full 39x12 correlation PCA", slices=slices)
prim['group'] = cap['group'].values
print("\nPC1/PC2 by slice (all periods):")
print(prim.round(3).to_string())

prim = prim.dropna(subset=['BCE']); yba = prim[prim.group=='YBA'].reset_index(drop=True)
p1100 = yba.loc[yba.BCE==1100, 'PC1'].values[0]
later = yba[yba.BCE.between(500,1000)]
mean_later = later.PC1.mean()
yba['diff_vs_1100'] = yba.PC1 - p1100
print("\nYBA block:")
print(yba.round(3).to_string())
print(f"PC1(1100) = {p1100:.3f}; mean PC1(1000-500) = {mean_later:.3f}; "
      f"difference 1100 - mean(later) = {p1100-mean_later:.3f}")
print("Per-slice difference (later minus 1100):")
print((later.PC1.values - p1100).round(3))
# significance-ish: how many SDs of the later-slice spread?
sd_later = later.PC1.std(ddof=1)
print(f"SD of later PC1 = {sd_later:.3f}; 1100 is {(p1100-mean_later)/sd_later:.2f} SD above later mean")

# ---------- Sensitivity (a): YBA-only 7 x 12 ----------
scores_a, load_a, evr_a, _, used_a = pca_corr(cap[cap.BCE.between(500,1100)][ZCOLS], ZCOLS, label="YBA-only")
load_a = pd.DataFrame(load_a, index=used_a)
sa, la = report(scores_a, load_a, evr_a, "SENSITIVITY (a): YBA-only 7x12 PCA",
                slices=slices[-7:])
sa['BCE'] = slices[-7:]
pa = sa[sa.BCE==1100].PC1.values[0]; mea = sa[sa.BCE.between(500,1000)].PC1.mean()
print(f"PC1(1100)={pa:.3f}, mean(1000-500)={mea:.3f}, diff={pa-mea:.3f}")

# ---------- Sensitivity (b): exclude ZSichel ----------
cols_b = [c for c in ZCOLS if c != 'ZSichel']
scores_b, load_b, evr_b, _, used_b = pca_corr(cap[cols_b], cols_b, label="no-ZSichel")
load_b = pd.DataFrame(load_b, index=used_b)
sb, lb = report(scores_b, load_b, evr_b, "SENSITIVITY (b): full 39x11 (no ZSichel)")
sb['BCE'] = slices
pb = sb[sb.BCE==1100].PC1.values[0]; meb = sb[sb.BCE.between(500,1000)].PC1.mean()
print(f"PC1(1100)={pb:.3f}, mean(1000-500)={meb:.3f}, diff={pb-meb:.3f}")

# ---------- Sensitivity (c): annual interpolated rows averaged per century bin ----------
ts = pd.read_csv('/workspace/data/time_series_data.csv')
imap = {'ZAxtSchwert':'HatchetSword_inter','ZDolch':'Dagger_inter','Zhausgr':'HouseSize_inter',
        'ZCU_AU':'CopperGold_inter','Zamber':'Amber_inter','ZMonument':'MonumentCount_inter',
        'ZHort':'Depot_inter','ZSichel':'Sickle_inter','ZBeil':'AxesCelts_inter',
        'ZMW':'MonumentSize_inter','ZKeform':'PotteryForm_inter','Zkeverz':'PotteryDecoration_inter'}
ts['BCE'] = -ts['CE']
ts['bin'] = (np.ceil(ts['BCE']/100)*100).astype(int)   # bin label = upper edge (e.g. 1100 covers 1100..1001)
agg = ts.groupby('bin')[[imap[c] for c in ZCOLS]].mean()
agg.columns = ZCOLS
print(f"\nCentury-bin means from annual _inter rows: bins {agg.index.min()}..{agg.index.max()}, n={len(agg)}")
scores_c, load_c, evr_c, _, used_c = pca_corr(agg[ZCOLS], ZCOLS, label="annual-binmean")
load_c = pd.DataFrame(load_c, index=used_c)
sc, lc = report(scores_c, load_c, evr_c, "SENSITIVITY (c): annual-interpolated, century-bin means")
sc['BCE'] = agg.index.values
pc = sc[sc.BCE==1100].PC1.values[0]; mec = sc[sc.BCE.between(500,1000)].PC1.mean()
print(f"PC1(1100)={pc:.3f}, mean(1000-500)={mec:.3f}, diff={pc-mec:.3f}")

# ---------- Group-level PC1 (secondary, per confirmed mapping) ----------
print("\n===== Group-level PC1 (PCA within each capital form, full 39 slices) =====")
for g, cols in GROUPS.items():
    s, l, e, _, used_g = pca_corr(cap[cols], cols, label=g)
    l = pd.DataFrame(l, index=used_g)
    sf = sign_fix(l, orient_vars=cols)
    sc1 = s[:,0]*sf
    ser = pd.Series(sc1, index=slices).sort_index()
    print(f"{g}: PC1 evr={e[0]*100:.1f}%; PC1(1100)={ser[1100]:.3f}, "
          f"mean(1000-500)={ser.loc[500:1000].mean():.3f}, diff={ser[1100]-ser.loc[500:1000].mean():.3f}")

# ---------- Save outputs ----------
out = prim[['BCE','group','PC1','PC2']].round(4)
out.to_csv('/workspace/analysis/pc1_by_slice_primary.csv', index=False)
pd.DataFrame({'BCE':slices[-7:], 'PC1_yba_only':sa.PC1.round(4).values,
              'PC1_no_ZSichel':[sb[sb.BCE==b].PC1.values[0] for b in slices[-7:]],
              'PC1_annual_binmean':[sc[sc.BCE==b].PC1.values[0] for b in slices[-7:]]}).to_csv(
              '/workspace/analysis/pc1_yba_sensitivity.csv', index=False)
print("\nSaved: analysis/pc1_by_slice_primary.csv, analysis/pc1_yba_sensitivity.csv")
