# -*- coding: utf-8 -*-
"""PCA of forms of capital over 100-year time slices.

Main analysis : capital.csv (39 x 12 raw Z values), correlation-matrix PCA.
Appendix      : sensitivity check with time_series_data.csv *_inter columns
                aggregated to 100-year bin means.
Sign convention: PC1 oriented so that the mean PC1 loading of the symbolic
                capital trio (ZAxtSchwert, ZDolch, Zhausgr) is positive
                (fallback: largest-|loading| symbolic variable); PC2 oriented
                so ZDolch's PC2 loading is positive.
"""
import numpy as np
import pandas as pd

Z_COLS = ['ZAxtSchwert','ZDolch','Zhausgr','ZCU_AU','Zamber','ZMonument',
          'ZHort','ZSichel','ZBeil','ZMW','ZKeform','Zkeverz']
CAP_TYPE = {'ZAxtSchwert':'symbolic','ZDolch':'symbolic','Zhausgr':'symbolic',
            'ZCU_AU':'social','Zamber':'social','ZMonument':'social',
            'ZKeform':'cultural','Zkeverz':'cultural',
            'ZHort':'economic','ZSichel':'economic','ZBeil':'economic','ZMW':'economic'}
SYM = ['ZAxtSchwert','ZDolch','Zhausgr']


def corr_pca(X, names, orient=True):
    """Correlation-matrix PCA via eigendecomposition. Returns (loadings, evr, scores)."""
    Xm = np.asarray(X, dtype=float)
    # standardize -> correlation PCA
    mu, sd = Xm.mean(axis=0), Xm.std(axis=0, ddof=1)
    Xs = (Xm - mu) / sd
    C = np.corrcoef(Xm, rowvar=False)
    w, V = np.linalg.eigh(C)                 # ascending
    order = np.argsort(w)[::-1]
    w, V = w[order], V[:, order]
    evr = w / w.sum()
    load = V * np.sqrt(w)                    # variable loadings (correlation w/ PCs)
    scores = Xs @ V
    if orient:
        sym_rows = [names.index(v) for v in SYM]
        smean = load[sym_rows, 0].mean()
        mixed = bool((load[sym_rows, 0] > 0).any() and (load[sym_rows, 0] < 0).any())
        note = ''
        if smean < 0:
            if not mixed:
                note = 'PC1/PC2 flipped: symbolic trio same sign, mean made positive'
            else:
                ref = names[sym_rows[int(np.argmax(np.abs(load[sym_rows, 0])))]]
                note = f'symbolic trio MIXED on PC1; oriented so largest-|loading| var ({ref}) > 0'
            load[:, 0] *= -1
            scores[:, 0] *= -1
        if load[names.index('ZDolch'), 1] < 0:
            load[:, 1] *= -1
            scores[:, 1] *= -1
            note += '; PC2 flipped so ZDolch > 0'
        return load, evr, scores, note.strip('; ')
    return load, evr, scores, ''


cap = pd.read_csv('data/capital.csv', decimal=',')
assert cap.shape[0] == 39 and not cap[Z_COLS].isna().any().any()
assert (np.abs(np.diff(cap.BCE.values)) == 100).all()

load, evr, scores, note = corr_pca(cap[Z_COLS].values, Z_COLS)
ldf = pd.DataFrame(load[:, :6], index=Z_COLS, columns=["PC1","PC2","PC3","PC4","PC5","PC6"]).round(4)
sdf = pd.DataFrame({'BCE': cap.BCE.values, 'group': cap['group'].values,
                    'PC1': scores[:, 0], 'PC2': scores[:, 1]})

print('=== MAIN: capital.csv, correlation PCA, 39 x 100-year slices ===')
print('Sign convention applied:', note or 'none needed')
print('\nExplained variance ratio:')
for i in range(5):
    print(f'  PC{i+1}: {evr[i]*100:5.2f}%   (cumulative {evr[:i+1].sum()*100:5.2f}%)')

print('\nLoadings (PC1..PC6):')
print(ldf.to_string())

print('\n--- Symbolic capital on PC1 ---')
for v in SYM:
    print(f'  {v:12s} PC1 = {ldf.loc[v,"PC1"]:+.4f}')
print(f'  mean of trio PC1 = {ldf.loc[SYM,"PC1"].mean():+.4f}')

print('\n--- Symbolic capital on PC2 ---')
for v in SYM:
    print(f'  {v:12s} PC2 = {ldf.loc[v,"PC2"]:+.4f}')
s2 = ldf.loc[SYM, 'PC2']
print(f'  trio PC2 spread: min {s2.min():+.4f}, max {s2.max():+.4f}, '
      f'same sign: {bool((s2 > 0).all() or (s2 < 0).all())}')

print('\n--- Group means of PC1/PC2 loadings by capital type ---')
for t in ['symbolic', 'social', 'cultural', 'economic']:
    rows = [v for v in Z_COLS if CAP_TYPE[v] == t]
    pv = ', '.join(f'{v}={ldf.loc[v, "PC2"]:+.2f}' for v in rows)
    print('  ' + t.ljust(9) + f'PC1 mean {ldf.loc[rows, "PC1"].mean():+.3f}  '
          f'PC2 mean {ldf.loc[rows, "PC2"].mean():+.3f}  (PC2 values: {pv})')

print('\n--- Sample scores by 100-year slice (time, oldest first) ---')
print(sdf.to_string(index=False))

# ---------------- text biplot ----------------
print('\n=== Biplot: variable loadings in PC1-PC2 plane (text) ===')
print(f"{'':14s}" + ''.join(f'{c:>8s}' for c in ['PC1-','PC1+','PC2-','PC2+']))
for v in Z_COLS:
    print(f'{v:14s} PC1={ldf.loc[v,"PC1"]:+.3f}  PC2={ldf.loc[v,"PC2"]:+.3f}  [{CAP_TYPE[v]}]')

# ---------------- appendix sensitivity ----------------
ts = pd.read_csv('data/time_series_data.csv')
INTER = ['HatchetSword_inter','Dagger_inter','HouseSize_inter','CopperGold_inter',
         'Amber_inter','MonumentCount_inter','Depot_inter','Sickle_inter',
         'AxesCelts_inter','MonumentSize_inter','PotteryForm_inter','PotteryDecoration_inter']
ts['binBCE'] = -((ts.CE // 100) * 100)
tsb = ts.groupby('binBCE')[INTER].mean()
common = [b for b in cap.BCE.values if b in tsb.index]
print(f'  overlap: {len(common)}/39 slices (ts starts at 4100 BCE; slices 4300/4200 BCE have no inter data)')
tsb = tsb.reindex(common)
assert not tsb.isna().any().any(), 'binning must cover all overlapping slices'
lb, bev, _, bnote = corr_pca(tsb.values, Z_COLS)
lbdf = pd.DataFrame(lb[:, :2], index=Z_COLS, columns=["PC1","PC2"]).round(4)
print('\n=== APPENDIX: sensitivity, *_inter 100y bin means ===')
print('Sign convention applied:', bnote or 'none needed')
print(f'  EVR PC1 {bev[0]*100:.2f}%  PC2 {bev[1]*100:.2f}%')
print(f'  loading corr(main vs sens): PC1 r={np.corrcoef(load[:,0], lb[:,0])[0,1]:.4f} '
      f'PC2 r={np.corrcoef(load[:,1], lb[:,1])[0,1]:.4f}')
print(f'  max |loading diff|: PC1 {np.abs(load[:,0]-lb[:,0]).max():.4f} '
      f'PC2 {np.abs(load[:,1]-lb[:,1]).max():.4f}')
print('  symbolic trio (main | sens):')
for v in SYM:
    print(f'    {v:12s} PC1 {ldf.loc[v,"PC1"]:+.3f} | {lbdf.loc[v,"PC1"]:+.3f}   '
          f'PC2 {ldf.loc[v,"PC2"]:+.3f} | {lbdf.loc[v,"PC2"]:+.3f}')

ldf.to_csv('output/loadings.csv')
sdf.to_csv('output/scores.csv', index=False)
print('\nSaved output/loadings.csv and output/scores.csv')
