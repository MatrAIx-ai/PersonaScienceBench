# -*- coding: utf-8 -*-
"""
3400-3000 BCE: How do monument counts and axes/celts co-vary with elements
of symbolic capital (HatchetSword, Dagger, HouseSize)?
Also: monument-axes relation, and pollen openness as demographic background.
Primary series: *_inter columns (annual, linear interp between century obs).
Anchors: 5 century observations (-3400..-3000). Effective-DOF corrected stats.
"""
import pandas as pd, numpy as np
from scipy import stats

OUT = []
def P(*a):
    s = ' '.join(str(x) for x in a)
    OUT.append(s); print(s)

# ---------- load ----------
ts  = pd.read_csv('data/time_series_data.csv')
cap = pd.read_csv('data/capital.csv', decimal=',')
pol = pd.read_csv('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv', decimal=',')

W = ts[(ts.CE >= -3400) & (ts.CE <= -3000)].copy()
POL = pol[(pol.CE >= -3400) & (pol.CE <= -3000)].copy()
W = W.merge(POL[['CE','MEAN','SMOOTH_MEAN_100y']], on='CE', how='left',
            suffixes=('','_pol'))
assert len(W) == 401

# ---------- helper: effective-DOF corrected correlation ----------
def corr_effdof(x, y, label):
    m = x.notna() & y.notna()
    a, b = x[m].values, y[m].values
    n = len(a)
    r, p_naive = stats.pearsonr(a, b)
    rho, p_naive_s = stats.spearmanr(a, b)
    # lag-1 autocorrelations
    def r1(v):
        if len(v) < 3: return 0.0
        c = np.corrcoef(v[:-1], v[1:])[0,1]
        return 0.0 if np.isnan(c) else c
    r1x, r1y = r1(a), r1(b)
    n_eff = n*(1 - r1x*r1y)/(1 + r1x*r1y) if (1 + r1x*r1y) != 0 else n
    n_eff = max(n_eff, 3)
    t = r*np.sqrt((n_eff-2)/(1-r**2)) if abs(r) < 1 else np.inf
    p_eff = 2*stats.t.sf(abs(t), df=n_eff-2)
    P(f"{label:55s} r={r:+.3f} (n={n}, n_eff={n_eff:.1f}, p_eff={p_eff:.3f}) | "
      f"Spearman rho={rho:+.3f} | lag1autocorr x={r1x:+.2f} y={r1y:+.2f}")
    return r, p_eff, n_eff

def lag_profile(x, y, lags=range(-100,101,10)):
    m0 = x.notna() & y.notna()
    best = None
    P("  lag profile (y lagged by L years; L>0 means y follows x):")
    for L in lags:
        xx, yy = x.shift(L), y
        m = xx.notna() & yy.notna()
        if m.sum() < 50: continue
        r = np.corrcoef(xx[m], yy[m])[0,1]
        P(f"    L={L:+4d}: r={r:+.3f} (n={m.sum()})")
        if best is None or abs(r) > abs(best[1]): best = (L, r)
    P(f"  -> strongest link at lag {best[0]} (r={best[1]:+.3f})")
    return best

P("="*100)
P("SECTION 0. Window definition: CE -3400..-3000 (calBP 5350..4950), 401 annual rows, "
  "5 century anchor observations (-3400,-3300,-3200,-3100,-3000).")
P("="*100)

# ---------- SECTION 1: descriptive trends inside window ----------
P("\nSECTION 1. Trend within 3400-3000 BCE (annual _inter series: OLS slope per century of z, with n_eff-corrected significance)")
trend = W[['CE','MonumentCount','MonumentCount_inter','AxesCelts','AxesCelts_inter',
           'HatchetSword','HatchetSword_inter','Dagger','Dagger_inter',
           'HouseSize','HouseSize_inter','pollen_inter','pollen_inter_100','pollen_grate_100',
           'MEAN','SMOOTH_MEAN_100y']]
for c in ['MonumentCount_inter','AxesCelts_inter','HatchetSword_inter','Dagger_inter',
          'HouseSize_inter','pollen_inter_100','MEAN','SMOOTH_MEAN_100y']:
    y = W[c]
    x = W.CE.values
    ok = y.notna()
    slope, ic, r, p, se = stats.linregress(x[ok], y[ok])
    P(f"  {c:22s} start={y.iloc[0]:+.3f} end={y.iloc[-1]:+.3f} "
      f"range=[{y.min():+.2f},{y.max():+.2f}] slope={slope*100:+.3f} z/century (r={r:+.2f}, p={p:.4g})")

P("\n  Century anchor values (raw z, also equal in capital.csv):")
anch = ts[ts.CE.isin([-3400,-3300,-3200,-3100,-3000])][
    ['CE','MonumentCount','AxesCelts','HatchetSword','Dagger','HouseSize',
     'pollen_inter_100']]
P(anch.to_string(index=False))

# ---------- SECTION 2 (a): monuments & axes vs symbolic-capital elements ----------
P("\nSECTION 2a. Co-movement with symbolic capital elements (annual _inter series, n_eff corrected)")
for tgt in ['MonumentCount_inter','AxesCelts_inter']:
    for sym in ['HatchetSword_inter','Dagger_inter','HouseSize_inter']:
        corr_effdof(W[tgt], W[sym], f"{tgt}  vs  {sym}")

P("\n  Same correlations at the 5 century anchor points (n=5, DESCRIPTIVE ONLY):")
A = ts[ts.CE.isin([-3400,-3300,-3200,-3100,-3000])]
for tgt, tgtl in [('MonumentCount','ZMonument'),('AxesCelts','ZBeil')]:
    for sym, syml in [('HatchetSword','ZAxtSchwert'),('Dagger','ZDolch'),('HouseSize','Zhausgr')]:
        r, p = stats.pearsonr(A[tgt], A[sym]); rho,_ = stats.spearmanr(A[tgt], A[sym])
        P(f"  {tgt}(vs) {sym:13s} n=5  Pearson r={r:+.3f}  Spearman rho={rho:+.3f}")

# ---------- SECTION 2 (b): MonumentCount vs AxesCelts ----------
P("\nSECTION 2b. MonumentCount vs AxesCelts (annual _inter, n_eff corrected)")
corr_effdof(W['MonumentCount_inter'], W['AxesCelts_inter'], "MonumentCount_inter vs AxesCelts_inter (same year)")
P("  Lead/lag profile:")
lag_profile(W['MonumentCount_inter'], W['AxesCelts_inter'])
P("  Reverse lead/lag (AxesCelts leading):")
lag_profile(W['AxesCelts_inter'], W['MonumentCount_inter'])
r, p = stats.pearsonr(A['MonumentCount'], A['AxesCelts']); rho,_ = stats.spearmanr(A['MonumentCount'], A['AxesCelts'])
P(f"  Century anchors n=5: Pearson r={r:+.3f}, Spearman rho={rho:+.3f} (descriptive only)")
# peak check
P("  Peak sensitivity: window correlation EXCLUDING the -3200 anchor point's interpolated rise:")
Wx = W[~((W.CE>=-3260)&(W.CE<=-3140))]   # drop the interpolated peak episode
corr_effdof(Wx['MonumentCount_inter'], Wx['AxesCelts_inter'], "  excluding +/-60y around -3200 peak")

# ---------- SECTION 2 (c): pollen openness background ----------
P("\nSECTION 2c. Pollen openness / growth-rate background (n_eff corrected)")
corr_effdof(W['MonumentCount_inter'], W['MEAN'],            "MonumentCount_inter vs pollen openness MEAN (PC1 interp mean)")
corr_effdof(W['AxesCelts_inter'],    W['MEAN'],             "AxesCelts_inter    vs pollen openness MEAN")
corr_effdof(W['MonumentCount_inter'], W['SMOOTH_MEAN_100y'],"MonumentCount_inter vs openness SMOOTH_MEAN_100y")
corr_effdof(W['AxesCelts_inter'],    W['SMOOTH_MEAN_100y'],"AxesCelts_inter    vs openness SMOOTH_MEAN_100y")
corr_effdof(W['MonumentCount_inter'], W['pollen_grate_100'],"MonumentCount_inter vs pollen_grate_100 (Belau growth rate)")
corr_effdof(W['AxesCelts_inter'],    W['pollen_grate_100'], "AxesCelts_inter    vs pollen_grate_100")
corr_effdof(W['HouseSize_inter'],    W['MEAN'],             "HouseSize_inter    vs openness MEAN (PC1 direction check)")
corr_effdof(W['HouseSize_inter'],    W['CE'].astype(float), "HouseSize_inter    vs CE (long-term direction check)")
corr_effdof(W['pollen_inter'],       W['MEAN'],             "Belau pollen (ts)  vs openness MEAN (same-source check)")

# ---------- SECTION 3: PC1 direction evidence ----------
P("\nSECTION 3. PC1 direction check (assumption: higher PC1 = more open landscape, Feeser et al. 2019)")
for c in ['Belau_PC1','Woserin_PC1','MEAN']:
    ok = pol[c].notna()
    sl, ic, r, p, se = stats.linregress(pol.CE[ok], pol[c][ok])
    P(f"  {c:12s} vs CE over whole file: slope={sl*1000:+.4f}/millennium, r={r:+.3f}, n={ok.sum()}")
P("  (If PC1 rises toward the present/late periods and co-moves positively with HouseSize "
  "and with settlement openness indicators, the 'higher=more open' reading is supported.)")

# ---------- SECTION 4: symbolic-capital composite ----------
P("\nSECTION 4. Symbolic-capital composite (mean z of HatchetSword, Dagger, HouseSize)")
W['SYMCAP_inter'] = W[['HatchetSword_inter','Dagger_inter','HouseSize_inter']].mean(axis=1)
A2 = A.copy(); A2['SYMCAP'] = A2[['HatchetSword','Dagger','HouseSize']].mean(axis=1)
corr_effdof(W['MonumentCount_inter'], W['SYMCAP_inter'], "MonumentCount_inter vs SYMBOLIC-CAPITAL composite")
corr_effdof(W['AxesCelts_inter'],    W['SYMCAP_inter'],  "AxesCelts_inter    vs SYMBOLIC-CAPITAL composite")
r, p = stats.pearsonr(A2['MonumentCount'], A2['SYMCAP']); rho,_ = stats.spearmanr(A2['MonumentCount'], A2['SYMCAP'])
P(f"  Century anchors n=5: MonumentCount vs SYMCAP: r={r:+.3f}, rho={rho:+.3f} (descriptive)")
r, p = stats.pearsonr(A2['AxesCelts'], A2['SYMCAP']); rho,_ = stats.spearmanr(A2['AxesCelts'], A2['SYMCAP'])
P(f"  Century anchors n=5: AxesCelts    vs SYMCAP: r={r:+.3f}, rho={rho:+.3f} (descriptive)")

# ---------- save ----------
W[['CE','calBP','MonumentCount','MonumentCount_inter','AxesCelts','AxesCelts_inter',
   'HatchetSword','HatchetSword_inter','Dagger','Dagger_inter','HouseSize','HouseSize_inter',
   'SYMCAP_inter','pollen_inter','pollen_inter_100','pollen_grate_100','MEAN','SMOOTH_MEAN_100y']
  ].to_csv('output/window_3400_3000BCE_series.csv', index=False)
with open('output/analysis_log.txt','w') as f:
    f.write('\n'.join(OUT))
P("\nSaved: output/window_3400_3000BCE_series.csv, output/analysis_log.txt")
