# -*- coding: utf-8 -*-
"""Complementary statistical views: first differences of annual _inter series
and century-step changes, to avoid the degenerate n_eff of levels analysis."""
import pandas as pd, numpy as np
from scipy import stats

OUT=[]
def P(*a):
    s=' '.join(str(x) for x in a); OUT.append(s); print(s)

ts  = pd.read_csv('data/time_series_data.csv')
pol = pd.read_csv('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv', decimal=',')
W = ts[(ts.CE>=-3400)&(ts.CE<=-3000)].copy()
W = W.merge(pol[['CE','MEAN','SMOOTH_MEAN_100y']], on='CE', how='left')

def rep(x,y,label):
    m=x.notna()&y.notna(); a,b=x[m].values,y[m].values; n=len(a)
    if n<3 or np.std(a)==0 or np.std(b)==0:
        P(f"{label:60s} UNDEFINED (constant series or n<3, n={n})"); return
    r,p=stats.pearsonr(a,b); rho,ps=stats.spearmanr(a,b)
    def r1(v):
        c=np.corrcoef(v[:-1],v[1:])[0,1]; return 0.0 if np.isnan(c) else c
    n_eff=n*(1-r1(a)*r1(b))/(1+r1(a)*r1(b)); n_eff=max(n_eff,3)
    t=r*np.sqrt((n_eff-2)/(1-r**2)) if abs(r)<1 else np.inf
    pe=2*stats.t.sf(abs(t),df=n_eff-2)
    P(f"{label:60s} r={r:+.3f} rho={rho:+.3f} (n={n}, n_eff={n_eff:.1f}, p_eff={pe:.3f})")

P("SECTION A. FIRST DIFFERENCES (year-over-year change of _inter z, 400 points) - removes level trend/autocorrelation")
D = W[['MonumentCount_inter','AxesCelts_inter','HatchetSword_inter','Dagger_inter',
       'HouseSize_inter','pollen_inter_100','MEAN','SMOOTH_MEAN_100y']].diff()
for tgt in ['MonumentCount_inter','AxesCeltas' if False else 'AxesCelts_inter']:
    for sym in ['HatchetSword_inter','Dagger_inter','HouseSize_inter']:
        rep(D[tgt],D[sym],f"d({tgt}) vs d({sym})")
rep(D['MonumentCount_inter'],D['AxesCelts_inter'],"d(MonumentCount) vs d(AxesCelts) same year")
rep(D['MonumentCount_inter'].shift(50),D['AxesCelts_inter'],"d(MonumentCount, +50y lead) vs d(AxesCelts)")
rep(D['AxesCelts_inter'].shift(50),D['MonumentCount_inter'],"d(AxesCelts, +50y lead) vs d(MonumentCount)")
for tgt in ['MonumentCount_inter','AxesCelts_inter']:
    rep(D[tgt],D['MEAN'],f"d({tgt.split('_')[0]}) vs d(openness MEAN)")
    rep(D[tgt],D['pollen_inter_100'],f"d({tgt.split('_')[0]}) vs d(pollen_inter_100 Belau)")
    rep(D[tgt],W['pollen_grate_100'],f"d({tgt.split('_')[0]}) vs pollen growth rate (level)")

P("")
P("SECTION B. CENTURY-STEP CHANGES (delta-z between successive century anchors, n=4 pairs, DESCRIPTIVE)")
A = ts[ts.CE.isin([-3400,-3300,-3200,-3100,-3000])].reset_index(drop=True)
dA = A[['MonumentCount','AxesCelts','HatchetSword','Dagger','HouseSize','pollen_inter_100']].diff().dropna()
P(dA.to_string(index=False))
for a in ['MonumentCount','AxesCelts']:
    for b in ['HatchetSword','Dagger','HouseSize','pollen_inter_100']:
        x,y=dA[a],dA[b]
        if x.std()==0 or y.std()==0:
            P(f"  d{a} vs d{b}: UNDEFINED (constant)"); continue
        r,p=stats.pearsonr(x,y)
        P(f"  d{a:14s} vs d{b:18s} r={r:+.3f} (n=4, descriptive)")

P("")
P("SECTION C. Within-window variance check of symbolic-capital elements (annual _inter)")
for c in ['HatchetSword_inter','Dagger_inter','HouseSize_inter']:
    y=W[c]; P(f"  {c:20s} min={y.min():+.3f} max={y.max():+.3f} std={y.std():.4f} unique={y.nunique()}")
P("  -> Dagger is CONSTANT (-0.58) across the whole 3400-3000 BCE window: it cannot covary "
  "with anything inside this window; any 'Dagger effect' must come from outside the window.")
open('output/analysis_differences_log.txt','w').write('\n'.join(OUT))
