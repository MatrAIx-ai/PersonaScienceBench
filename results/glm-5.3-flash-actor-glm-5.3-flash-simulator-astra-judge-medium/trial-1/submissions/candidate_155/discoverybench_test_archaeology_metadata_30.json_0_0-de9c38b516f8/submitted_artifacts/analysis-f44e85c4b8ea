import pandas as pd, numpy as np

ts = pd.read_csv('data/time_series_data.csv', index_col=0)
raw = ts[ts.CE % 100 == 0].copy().sort_values('CE').reset_index(drop=True)
# exclude backfilled duplicates: century anchor series starts at CE -4100 (matches capital BCE 4300/4200 backfill issue)
cent = raw[['CE','PotteryForm','PotteryDecoration']].copy()
cent['dForm'] = cent.PotteryForm.diff()
cent['dDeco'] = cent.PotteryDecoration.diff()
print(cent.to_string(index=False))
print()

def first_reverse(df, fcol, dcol, thr):
    """first century where Deco rises >= thr AND Form falls <= -thr vs previous century"""
    for i in range(1, len(df)):
        if df[dcol].iloc[i] >= thr and df[fcol].iloc[i] <= -thr:
            return df.CE.iloc[i], df[dcol].iloc[i], df[fcol].iloc[i]
    return None, None, None

print('=== Threshold sensitivity (raw century series, first reverse century) ===')
for thr in [0.05,0.1,0.15,0.2,0.25,0.3,0.4,0.5]:
    ce, dd, dfm = first_reverse(cent, 'dForm', 'dDeco', thr)
    print(f'thr={thr}: CE={ce} (dDeco={dd}, dForm={dfm})')

# quantile-based definition
adec = cent.dDeco.abs().dropna(); afor = cent.dForm.abs().dropna()
print('\n|dDeco| quantiles:', adec.describe([.5,.75,.9]).to_dict())
print('|dForm| quantiles:', afor.describe([.5,.75,.9]).to_dict())
for q in [0.5,0.75,0.9]:
    tq = adec.quantile(q)
    ce, dd, dfm = first_reverse(cent, 'dForm', 'dDeco', tq)
    print(f'quantile {q} (thr={tq:.3f}): CE={ce} (dDeco={dd}, dForm={dfm})')

# inter column robustness: century aggregation of _inter = same as raw; also yearly deltas
inter = ts[['CE','PotteryForm_inter','PotteryDecoration_inter']].sort_values('CE').reset_index(drop=True)
# century-to-century change on inter column (values at century marks identical to raw -> same result)
cent2 = inter[inter.CE % 100 == 0].copy()
cent2['dForm'] = cent2.PotteryForm_inter.diff(); cent2['dDeco'] = cent2.PotteryDecoration_inter.diff()
print('\n=== _inter column, century-to-century deltas: identical to raw? ===')
print(np.allclose(cent.dForm.dropna(), cent2.dForm.dropna()), np.allclose(cent.dDeco.dropna(), cent2.dDeco.dropna()))
ce, dd, dfm = first_reverse(cent2, 'dForm', 'dDeco', 0.1)
print(f'_inter thr=0.1: CE={ce} (dDeco={dd}, dForm={dfm})')

# smoothed inter (100y rolling mean), then century deltas
sm = inter.copy()
sm['PFs'] = sm.PotteryForm_inter.rolling(100, min_periods=100).mean()
sm['PDs'] = sm.PotteryDecoration_inter.rolling(100, min_periods=100).mean()
cs = sm[sm.CE % 100 == 0].dropna(subset=['PFs']).copy()
cs['dForm'] = cs.PFs.diff(); cs['dDeco'] = cs.PDs.diff()
print('\n=== 100y-rolling-smoothed inter, century deltas, thr sweep ===')
for thr in [0.05,0.1,0.2]:
    ce, dd, dfm = first_reverse(cs, 'dForm', 'dDeco', thr)
    print(f'thr={thr}: CE={ce} (dDeco={round(dd,3)}, dForm={round(dfm,3)})')

# show all reverse events (thr=0.1) on raw
print('\n=== All reverse-growth centuries (raw, thr=0.1) ===')
ev = cent[(cent.dDeco>=0.1)&(cent.dForm<=-0.1)]
print(ev.to_string(index=False))
