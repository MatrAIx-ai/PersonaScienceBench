"""
Amber peak analysis — DiscoveryBench episode: archaeology/metadata_8
Question: In which millennium did amber have the highest value and in what
time interval did it peak?

Method (approved plan):
  - Raw 100-year Amber anchors in time_series_data.csv are ground truth.
  - Amber_inter used only to characterize plateau continuity/extent.
  - capital.csv Zamber used as independent cross-validation.
  - Strict millennium convention: 4th millennium BCE = 4000-3001 BCE.
  - Chronology: CE = -BCE; calBP = 1950 - CE.
"""
import pandas as pd, numpy as np, json

OUT = {}

# ---------------- Load ----------------
ts  = pd.read_csv('data/time_series_data.csv', index_col=0)
cap = pd.read_csv('data/capital.csv', sep=',', decimal=',')

# ---------------- 1. Chronology verification ----------------
assert ts.CE.is_monotonic_increasing and ts.CE.diff().dropna().eq(1).all()
assert ((1950 - ts.CE) == ts.calBP).all(), "calBP convention violated"
assert cap.BCE.is_monotonic_decreasing and cap.BCE.diff().dropna().eq(-100).all()

# ---------------- 2. Cross-validation: Zamber vs raw Amber ----------------
m = ts.dropna(subset=['Amber']).set_index('CE')['Amber']
cap['CE'] = -cap['BCE']
cmp = cap.set_index('CE').join(m.rename('ts_Amber'), how='left')
max_diff = float((cmp['Zamber'] - cmp['ts_Amber']).abs().max())
n_match  = int(cmp['ts_Amber'].notna().sum())
assert max_diff == 0.0 and n_match == 37
OUT['cross_validation'] = {
    "Zamber_vs_rawAmber_max_abs_diff": max_diff,
    "matched_anchor_points": f"{n_match}/37 (capital.csv adds BCE 4300 & 4200, both Zamber=-1.07)"}

# ---------------- 3. Raw-anchor descriptive statistics ----------------
raw = ts.dropna(subset=['Amber'])[['CE','calBP','Amber']]
OUT['raw_stats'] = {k: round(float(v),4) for k,v in raw.Amber.describe().items()}
OUT['inter_stats'] = {k: round(float(v),4) for k,v in ts.Amber_inter.describe().items()}

# ---------------- 4. Peak identification (raw anchors) ----------------
amax = raw.Amber.max()
peak = raw[raw.Amber == amax]
OUT['peak'] = {
    "max_Z": amax,
    "anchor_years_BCE": sorted(-peak.CE),          # positive BCE
    "anchor_years_CE":  sorted(peak.CE),
    "calBP_range": [int(peak.calBP.min()), int(peak.calBP.max())],
    "interval_BCE": f"{-peak.CE.max()}-{-peak.CE.min()} BCE",
    "interval_CE":  f"CE {peak.CE.min()} to {peak.CE.max()}",
    "n_anchor_centuries": len(peak),
    "cultural_group": cap.loc[cap.CE.isin(peak.CE), 'group'].unique().tolist()}

# Plateau continuity in the interpolated series
pl = ts[ts.Amber_inter == ts.Amber_inter.max()]
OUT['interpolated_plateau'] = {
    "value": float(ts.Amber_inter.max()),
    "CE_start": int(pl.CE.min()), "CE_end": int(pl.CE.max()),
    "calBP_start": int(pl.calBP.max()), "calBP_end": int(pl.calBP.min()),
    "n_annual_rows": len(pl),
    "identical_to_raw_peak_location": bool(pl.CE.min() == peak.CE.min() and pl.CE.max() == peak.CE.max())}

# Second-highest plateau (context only)
smax = raw[raw.Amber < amax].Amber.max()
sp = raw[raw.Amber == smax]
OUT['second_plateau'] = {"value": smax,
    "interval_BCE": f"{-sp.CE.max()}-{-sp.CE.min()} BCE",
    "calBP": [int(sp.calBP.max()), int(sp.calBP.min())]}

# ---------------- 5. Millennium ranking (BCE millennium = e.g. 4th mill. BCE = 4000-3001 BCE) ----
raw = raw.copy()
raw['BCE'] = -raw['CE']
raw['millennium_BCE'] = ((raw.BCE - 1)//1000 + 1).astype(int)   # 4000..3001 -> 4 ; 3000..2001 -> 3
rank = raw.groupby('millennium_BCE').Amber.agg(['max','mean','count']).sort_values('mean', ascending=False)
OUT['millennium_ranking'] = rank.round(4).to_dict('index')
best = rank.index[0]
OUT['best_millennium_BCE'] = int(best)

# floor-binning sensitivity check (CE//1000), which splits year 3000 BCE into the 3rd-mill. bin
ts['mill_floor'] = ts.CE//1000*1000
fb = ts.groupby('mill_floor').Amber_inter.agg(['max','mean'])
OUT['floor_bin_sensitivity'] = fb.loc[[-4000, -3000]].round(4).to_dict('index')
OUT['floor_bin_note'] = ("Naive CE//1000 floor-binning puts the single anchor year 3000 BCE into the "
    "3rd-millennium bin, creating a nominal max-tie (1.54 in both bins); bin means resolve it "
    "decisively: 4th millennium BCE mean 1.484 vs 3rd millennium BCE mean -0.148 (raw anchors).")

# ---------------- 6. Interpolated >=1.0 envelope (context, NOT peak start) ----------------
hi = ts[ts.Amber_inter >= 1.0]
OUT['interpolated_ge1_envelope'] = {"CE": [int(hi.CE.min()), int(hi.CE.max())],
    "calBP": [int(hi.calBP.max()), int(hi.calBP.min())],
    "caveat": "The envelope's early edge (CE -4018) is a linear-interpolation artifact of the "
              "-1.07 -> 1.46 step across CE -4100 -> -4000; it is NOT the peak start."}

print(json.dumps(OUT, indent=2, default=str))
with open('amber_analysis_output.json','w') as f:
    json.dump(OUT, f, indent=2, default=str)
