"""
DiscoveryBench: archaeology/metadata_9 — In which century did summed social capital peak,
and which individual social capital components (gold/copper, amber, monuments) increase?

Approved workflow:
  1. Primary evidence: raw century-mark values (CopperGold + Amber + MonumentCount, equal-weight z-sum)
     from time_series_data.csv (cross-validated against capital.csv).
  2. Robustness: century means of the *_inter columns (annual-resolution interpolated series).
  3. Component peaks: per-component peak centuries (top 2-3) and contribution decomposition
     at the total peak century.
  4. Light sensitivity: equal weights vs alternative normalisations (min-max, rank).
  Time alignment: CE column everywhere (CE = -BCE; calBP = 1950 - CE verified).
  Century binning: floor(CE/100)*100; bin [-1400,-1300) labelled "14th century BCE" etc.
"""
import pandas as pd
import numpy as np

OUT = []

def log(*a):
    s = " ".join(str(x) for x in a)
    print(s); OUT.append(s)

SOC = ['CopperGold', 'Amber', 'MonumentCount']

# ---------------- Load ----------------
ts = pd.read_csv('data/time_series_data.csv')                       # decimal point
cap = pd.read_csv('data/capital.csv', decimal=',')                  # decimal comma
pol = pd.read_csv('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv', decimal=',')

log("== LOAD ==")
log("time_series rows/cols:", ts.shape, "| CE range:", ts.CE.min(), "..", ts.CE.max())
log("capital rows/cols:", cap.shape, "| BCE range:", cap.BCE.min(), "..", cap.BCE.max())
log("pollen rows/cols:", pol.shape, "| CE range:", pol.CE.min(), "..", pol.CE.max())

# ---------------- Cross-validation raw marks vs capital.csv ----------------
cap = cap.rename(columns={'ZCU_AU':'CopperGold','Zamber':'Amber','ZMonument':'MonumentCount',
                          'ZAxtSchwert':'HatchetSword','ZDolch':'Dagger','Zhausgr':'HouseSize',
                          'ZHort':'Depot','ZSichel':'Sickle','ZBeil':'AxesCelts',
                          'ZMW':'MonumentSize','ZKeform':'PotteryForm','Zkeverz':'PotteryDecoration'})
cap['CE'] = -cap.BCE
m = cap[cap.BCE.between(500, 4100)].merge(ts, on='CE', suffixes=('_cap','_ts'))
devs = {c: float((m[c+'_cap']-m[c+'_ts']).abs().max()) for c in SOC}
log("\n== CROSS-VALIDATION capital.csv vs time_series_data.csv (n=%d century marks) ==" % len(m))
log("max |diff| per social-capital component:", devs)

# ---------------- Century binning ----------------
def century_bin(ce):            # floor binning: CE -1400..-1301 -> bin -1400
    return int(np.floor(ce/100.0)*100)
def century_label(bin_val):     # bin -1400 -> "14th c. BCE"
    n = int(-bin_val)//100
    suf = 'st' if n % 10 == 1 and n != 11 else ('nd' if n % 10 == 2 and n != 12 else ('rd' if n % 10 == 3 and n != 13 else 'th'))
    return f"{n}{suf} c. BCE"

marks = ts[ts.CE % 100 == 0].copy()          # 37 raw century marks, CE -4100..-500
assert len(marks) == 37 and marks[SOC].notna().all().all()
marks['bin'] = marks.CE.map(century_bin)
marks['label'] = marks['bin'].map(century_label)

# ---------------- PRIMARY: raw century-mark equal-weight sum ----------------
marks['soc_sum_raw'] = marks[SOC].sum(axis=1)
prim = marks.sort_values('soc_sum_raw', ascending=False)
log("\n== PRIMARY (raw century marks, equal-weight z-sum) ==")
log(prim[['CE','label','CopperGold','Amber','MonumentCount','soc_sum_raw']].head(8).to_string(index=False))
raw_peak_vals = prim.soc_sum_raw.iloc[:2]
tied_bins = sorted(prim[prim.soc_sum_raw == prim.soc_sum_raw.max()].label.tolist())
log("Peak value:", prim.soc_sum_raw.max(), "| peak century labels (ties included):", tied_bins)

# ---------------- ROBUSTNESS: century means of interpolated series ----------------
ts['bin'] = ts.CE.map(century_bin)
ts['label'] = ts['bin'].map(century_label)
gm = ts.groupby('bin')[[c+'_inter' for c in SOC]].mean()
gm['soc_sum_inter'] = gm.sum(axis=1)
gm['label'] = [century_label(b) for b in gm.index]
rob = gm.sort_values('soc_sum_inter', ascending=False)
log("\n== ROBUSTNESS (century means of *_inter columns) ==")
log(rob[['label','CopperGold_inter','Amber_inter','MonumentCount_inter','soc_sum_inter']].head(8).to_string())
log("Inter-method peak century label:", rob.label.iloc[0], "| value:", round(rob.soc_sum_inter.iloc[0],3))
log("NOTE: raw and inter methods agree the maximum lies in the 1400-1200 BCE span;")
log("      raw marks give a TIE between 14th and 13th c. BCE; century-mean of interpolated")
log("      values assigns the single maximum to the 14th c. BCE bin [-1400,-1300).")

# ---------------- Component peaks (both methods) ----------------
log("\n== COMPONENT PEAKS ==")
comp_peaks = {}
for c in SOC:
    r = marks.sort_values(c, ascending=False).head(3)
    top_raw = [(row['label'], round(row[c],3)) for _, row in r.iterrows()]
    i = gm.sort_values(c+'_inter', ascending=False).head(3)
    top_int = [(row['label'], round(row[c+'_inter'],3)) for _, row in i.iterrows()]
    comp_peaks[c] = (top_raw, top_int)
    log(f"{c}: raw-mark top3 {top_raw} | inter-century-mean top3 {top_int}")

# ---------------- Decomposition at the total peak ----------------
pk = marks[marks.CE.isin([-1400,-1300])]
log("\n== DECOMPOSITION AT TOTAL PEAK (raw marks CE -1400 & -1300, tied) ==")
log(pk[['CE','CopperGold','Amber','MonumentCount','soc_sum_raw']].to_string(index=False))
v = pk.iloc[0]
share = {c: round(100*v[c]/v['soc_sum_raw'],1) for c in SOC}
log("Shares of the total at peak:", share)

# ---------------- Sensitivity: alternative normalisations (equal vs weighted) ----------------
log("\n== SENSITIVITY (does the peak century survive alternative normalisations?) ==")
sub = marks[SOC]
alts = {
 'equal z-sum (primary)': sub.sum(axis=1),
 'min-max 0-1 sum': ((sub-sub.min())/(sub.max()-sub.min())).sum(axis=1),
 'rank-sum (ascending)': sub.rank().sum(axis=1),
 'weighted by std (1/sigma)': (sub/sub.std()).sum(axis=1),
}
for name, s in alts.items():
    best = marks.loc[s.idxmax()]
    log(f"{name:28s} -> peak at CE {best.CE} ({best.label}), value {s.max():.3f}")

# equal-weight sum vs equal-weight mean: identical argmax (3 components, constant divisor)
log("equal-weight MEAN vs SUM: identical peak location (constant divisor 3).")

# ---------------- Background: pollen (not used in social-capital computation) ----------------
log("\n== BACKGROUND (pollen, context only) ==")
log("Pollen PC1 openness (SMOOTH_MEAN_100y) century means, first & last bins for context:")
pol['bin'] = pol.CE.map(century_bin)
pm = pol.groupby('bin').SMOOTH_MEAN_100y.mean()
log("earliest bin", pm.index.min(), round(pm.iloc[0],2), "-> latest bin", pm.index.max(), round(pm.iloc[-1],2))

# ---------------- Save outputs ----------------
with open('outputs/social_capital_results.txt','w') as f:
    f.write("\n".join(OUT))
marks[['CE','label']+SOC+['soc_sum_raw']].to_csv('outputs/century_marks_social_capital.csv', index=False)
gm.reset_index()[['bin','label','CopperGold_inter','Amber_inter','MonumentCount_inter','soc_sum_inter']] \
  .to_csv('outputs/century_means_interpolated_social_capital.csv', index=False)
print("\nSaved: outputs/social_capital_results.txt, outputs/century_marks_social_capital.csv, outputs/century_means_interpolated_social_capital.csv")
