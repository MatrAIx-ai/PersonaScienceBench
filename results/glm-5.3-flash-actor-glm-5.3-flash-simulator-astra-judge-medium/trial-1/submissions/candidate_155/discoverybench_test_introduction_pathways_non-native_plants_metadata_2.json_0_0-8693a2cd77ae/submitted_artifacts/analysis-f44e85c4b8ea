lv = [i for i in qt.index if i not in ("Intercept","Broad-leaved forests","Rock outcrops")]
o  = [qt.loc[i,"OR"] for i in lv]
ol = [qt.loc[i,"lo"] for i in lv]; oh = [qt.loc[i,"hi"] for i in lv]
Wd, H = 900, 130+40*len(lv); x0, w, xmax = 300, 480, 40.0
L = [f'<svg xmlns="http://www.w3.org/2000/svg" width="{Wd}" height="{H}" font-family="sans-serif">',
     '<text x="20" y="28" font-size="17" font-weight="bold">Quasi-binomial GLM: OR of a non-native record being Gardening, vs Urban</text>',
     '<text x="20" y="46" font-size="12" fill="#555">plots with n.total&gt;0 (n=191); X2-scale quasi-binomial; bars = Wald 95% CI; dashed line = OR 1</text>',
     '<text x="20" y="62" font-size="12" fill="#c0392b">Broad-leaved forests (4/4) and Rock outcrops (0/1) not shown: complete separation, OR not estimable</text>',
