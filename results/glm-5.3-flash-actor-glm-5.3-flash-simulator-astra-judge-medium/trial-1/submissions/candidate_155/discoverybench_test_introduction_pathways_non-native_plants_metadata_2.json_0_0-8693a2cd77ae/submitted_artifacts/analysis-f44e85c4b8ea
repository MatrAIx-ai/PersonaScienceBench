for t in [1,2,5,10,20,40]:
    L.append(f'<text x="{x0+w*t/xmax}" y="{H-12}" font-size="11" text-anchor="middle">{t}</text>')
L.append('</svg>'); open(OUT+"fig2_OR_vs_Urban_forest.svg","w").write("\n".join(L))
