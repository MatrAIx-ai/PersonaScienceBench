"""Formal analysis: gardening-pathway prevalence of non-native plants by habitat type."""
import numpy as np, pandas as pd, scipy.stats as st, math, json
import statsmodels.api as sm, statsmodels.formula.api as smf
from statsmodels.stats.outliers_influence import variance_inflation_factor
import statsmodels.discrete.discrete_model as dm

rng = np.random.default_rng(42); OUT = "outputs/"
niche = pd.read_csv("data/invaded_niche_pathways.csv", sep="\t").rename(columns={"n.gard":"ngard","n.unint":"nunint","n.agfo":"nagfo","n.total":"ntot"})
succ  = pd.read_csv("data/invasion_success_pathways.csv")
temp  = pd.read_csv("data/temporal_trends_contingency_table.csv", sep="\t")
HAB = ["Urban","Croplands","Scrublands","Riparian","Wetlands","Coastal",
       "Meadows","Broad-leaved forests","Coniferous forests","Rock outcrops"]

# A. zero niche-breadth handling (auxiliary only)
nb0 = succ[succ["invaded.niche.breadth"] == 0]
zero_note = {"n_zero": int(len(nb0)), "species": nb0["Scientific_name"].unique().tolist(),
             "means_with_zeros": succ.groupby("intro.pathway")["invaded.niche.breadth"].mean().to_dict(),
             "means_without_zeros": succ[succ["invaded.niche.breadth"]>0].groupby("intro.pathway")["invaded.niche.breadth"].mean().to_dict()}
print("[A] niche-breadth==0 rows:", len(nb0), "species:", zero_note["species"])
print("  means with/without zeros:", {k:(round(zero_note['means_with_zeros'][k],3), round(zero_note['means_without_zeros'][k],3)) for k in zero_note['means_with_zeros']})

# descriptive shares
def wilson(k,n,z=1.96):
    if n==0: return (np.nan,np.nan)
    p=k/n; d=1+z*z/n; c=(p+z*z/(2*n))/d; h=z*math.sqrt(p*(1-p)/n+z*z/(4*n*n))/d
    return (max(0,c-h),min(1,c+h))
def boot(df,B=10000):
    o={}
    for h,g in df.groupby("habitat",observed=True):
        tot=g["ntot"].values; gar=g["ngard"].values
        idx=np.where(tot>0)[0]
        if len(idx)==0: o[h]=(np.nan,np.nan); continue
        s=np.array([gar[r].sum()/tot[r].sum() for r in (rng.choice(idx,len(idx),True) for _ in range(B))])
        o[h]=(np.nanquantile(s,.025),np.nanquantile(s,.975))
    return o
rows=[]
for h,g in niche.groupby("habitat",observed=True):
    k,n=int(g["ngard"].sum()),int(g["ntot"].sum()); lo,hi=wilson(k,n)
    rows.append({"habitat":h,"n_plots":len(g),"n_plots_totalpos":int((g["ntot"]>0).sum()),
                 "sum_n_gard":k,"sum_n_total":n,"gard_share":k/n if n else np.nan,
                 "wilson_lo":lo,"wilson_hi":hi})
desc=pd.DataFrame(rows); bt=boot(niche)
desc["boot_lo"]=[bt[h][0] for h in desc.habitat]; desc["boot_hi"]=[bt[h][1] for h in desc.habitat]
desc.round(4).to_csv(OUT+"habitat_gardening_shares.csv",index=False)
print("\n[Descriptive]"); print(desc.round(3).to_string(index=False))

# B. dedup counts
succ_d = succ[~succ["duplicated"]]
print(f"\n[B] rows={len(succ)}, unique species={succ.Scientific_name.nunique()}, after dedup={len(succ_d)}; gardening rows {int((succ["intro.pathway"]=='Gardening').sum())} -> {int((succ_d["intro.pathway"]=='Gardening').sum())}")

# main quasi-binomial on ntot>0
sub = niche[niche["ntot"]>0].copy()
sub["habitat"]=pd.Categorical(sub["habitat"].astype(str),categories=[h for h in HAB if h in set(niche.loc[niche["ntot"]>0,"habitat"])])
print("\n[Main subset ntot>0]"); print(sub.groupby("habitat",observed=True).agg(n=("ngard","size"),gard=("ngard","sum"),tot=("ntot","sum")))

def quasi_F(m_big, m_small):
    """F-test for nested quasi-likelihood GLMs via Pearson X2."""
    X2b = np.sum(m_big.resid_pearson**2); X2s = np.sum(m_small.resid_pearson**2)
    dfb = len(m_big.model.endog) - len(m_big.params); dfs = len(m_small.model.endog) - len(m_small.params)
    F = ((X2s - X2b)/(dfs - dfb)) / (X2b/dfb)
    return F, st.f.sf(F, dfs-dfb, dfb), dfb
def hab_test(m, key="habitat"):
    names=list(m.params.index); idx=[i for i,n in enumerate(names) if n.startswith(key)]
    R=np.zeros((len(idx),len(names)))
    for j,i in enumerate(idx): R[j,i]=1
    ft=m.f_test(R)
    return float(ft.fvalue), float(ft.pvalue), len(idx)
FAM = sm.families.Binomial()
m0 = smf.glm("ngard + I(ntot-ngard) ~ 1", data=sub, family=FAM).fit(scale="X2")
m1 = smf.glm("ngard + I(ntot-ngard) ~ habitat", data=sub, family=FAM).fit(scale="X2")
F,pF,dfF = hab_test(m1)
qF,qP,qDF = quasi_F(m1,m0)
print(f"   (quasi-F via Pearson: F={qF:.3f}, df1={qDF}, p={qP:.4g})")
print(f"\n[Main] quasi-binomial habitat F={F:.3f} df={dfF:.0f} p={pF:.4g}; dispersion scale={m1.scale:.2f}")
def orci(res):
    se=np.sqrt(np.diag(res.cov_params())); p=res.params
    return pd.DataFrame({"OR":np.exp(p),"lo":np.exp(p-1.96*se),"hi":np.exp(p+1.96*se),"p":2*st.norm.sf(np.abs(p/se))},index=res.params.index)
qt=orci(m1); qt.index=[i.replace("habitat[T.","").replace("]","") for i in qt.index]
qt.to_csv(OUT+"quasibinomial_OR_vs_Urban.csv")
print(qt.round(3).to_string())
agg=niche.groupby("habitat",observed=True)[["ngard","nunint","nagfo"]].sum()
chi2,pchi,dof,_=st.chi2_contingency(agg.values)
print(f"[Aggregated chi2 habitat x pathway] chi2={chi2:.1f} dof={dof} p={pchi:.3g}")

# robustness: Poisson log-link + offset log(ntot) with HC1 robust SE (NB degenerate: alpha->0)
X = sm.add_constant(pd.get_dummies(sub["habitat"].astype(str), drop_first=True).astype(float))
pois = sm.GLM(sub["ngard"].astype(float), X, family=sm.families.Poisson(),
              offset=np.log(sub["ntot"].values)).fit(cov_type="HC1")
ptab = pd.DataFrame({"coef": pois.params, "robust_se": pois.bse,
                     "p": 2*st.norm.sf(np.abs(pois.params/pois.bse))})
ptab.index = [i.replace("habitat_","") for i in ptab.index]
ptab.to_csv(OUT+"poisson_robust_coefs.csv")
print("\n[Robustness Poisson+offset log(ntot), ntot>0, HC1 SE]"); print(ptab.round(3).to_string())
# also standard binomial (scale=1) on subset for comparison
mbin = smf.glm("ngard + I(ntot-ngard) ~ habitat", data=sub, family=FAM).fit()
print("[Robustness standard binomial (scale=1)] habitat coef p-values (habitat terms):")
print(pd.DataFrame({"coef":mbin.params,"p":mbin.pvalues}).round(4).to_string())


# aggregated Poisson log-rate model (offset log total count) - robustness
ah = niche.groupby("habitat", observed=True).agg(ng=("ngard","sum"), nt=("ntot","sum")).reset_index()
ah = ah[ah["nt"]>0]
ah["habitat"]=pd.Categorical(ah["habitat"],categories=HAB)  # reference = Urban
Xh = sm.add_constant(pd.get_dummies(ah["habitat"], drop_first=True).astype(float))
ph = sm.GLM(ah["ng"].astype(float), Xh, family=sm.families.Poisson(),
            offset=np.log(ah["nt"].values)).fit()  # classical SE: HC collapses for saturated fit
pht = pd.DataFrame({"log_rate_diff_vs_Urban": ph.params, "se": ph.bse,
                    "p": 2*st.norm.sf(np.abs(ph.params/ph.bse))})
pht.index = [i.replace("habitat[T.","").replace("]","") for i in pht.index]
pht.to_csv(OUT+"poisson_aggregated_lograte.csv")
print("\n[Robustness aggregated Poisson log-rate, offset log(sum ntot), HC1]"); print(pht.round(3).to_string())

# sensitivity: drop Rock outcrops
sub2 = sub[sub["habitat"]!="Rock outcrops"]
mb0 = smf.glm("ngard + I(ntot-ngard) ~ 1", data=sub2, family=FAM).fit(scale="X2")
mb1 = smf.glm("ngard + I(ntot-ngard) ~ habitat", data=sub2, family=FAM).fit(scale="X2")
Fs,Ps,_ = hab_test(mb1)
print(f"\n[Sens: Rock outcrops dropped] n={len(sub2)}, habitat F-test p={Ps:.4g}, scale={mb1.scale:.2f}")
qb=orci(mb1); qb.index=[i.replace("habitat[T.","").replace("]","") for i in qb.index]
qb.to_csv(OUT+"sens_no_rock_or.csv"); print(qb.round(3).to_string())

# covariate model + VIF
for a,b in [("elevation","elev_s"),("annual.temperature","temp_s"),("annual.rainfall","rain_s"),
            ("urban.2009.1000m","urban09_1000"),("progressive.1993.2009.50m","prog_9309_50")]:
    sub[b]=(sub[a]-sub[a].mean())/sub[a].std()
covs=["elev_s","temp_s","rain_s","urban09_1000","prog_9309_50"]
mc = smf.glm("ngard + I(ntot-ngard) ~ habitat + elev_s + temp_s + rain_s + urban09_1000 + prog_9309_50",
             data=sub, family=FAM).fit(scale="X2")
Xv=sm.add_constant(sub[covs].astype(float))
vif={c:variance_inflation_factor(Xv.values,i) for i,c in enumerate(Xv.columns)}
print("\n[Covariate model] VIF:",{k:round(v,2) for k,v in vif.items()})
cc=pd.DataFrame({"coef":mc.params,"p":mc.pvalues}); cc.to_csv(OUT+"covariate_model_coefs.csv")
print(cc.round(3).to_string())
Fc,Pc,_ = hab_test(mc)
print("covariate-model habitat F-test p=%.4g" % Pc)

# Moran's I on Pearson residuals (kNN k=6)
coords=sub[["longitude","latitude"]].values
D=np.sqrt(((coords[:,None,:]-coords[None,:,:])**2).sum(-1)); np.fill_diagonal(D,np.inf)
W=np.zeros_like(D)
for i in range(len(D)):
    for j in np.argsort(D[i])[:6]: W[i,j]=1
W=np.maximum(W,W.T); Wr=W/W.sum(1,keepdims=True)
r=m1.resid_pearson
I=(len(r)/W.sum())*(r@Wr@r)/(r@r)
perm=np.array([(rp@Wr@rp)/(rp@rp) for rp in (rng.permutation(r) for _ in range(999))])
Ip=(len(r)/W.sum())*perm
pmoran=(np.sum(np.abs(Ip)>=abs(I))+1)/1000
print(f"\n[Spatial] Moran's I={I:.3f}, permutation p={pmoran:.3f}")

# auxiliary species-level contrasts (before/after dedup)
def aux(df,label):
    rows=[]
    for v in ["habitat.range","invaded.niche.breadth","mrt","number.of.invaded.plots"]:
        a=df.loc[df["intro.pathway"]=="Gardening",v]; b=df.loc[df["intro.pathway"]!="Gardening",v]
        t,p=st.ttest_ind(a,b,equal_var=False); u,pu=st.mannwhitneyu(a,b)
        rows.append({"variable":v,"gard_mean":a.mean(),"other_mean":b.mean(),"welch_p":p,"mwu_p":pu})
    r=pd.DataFrame(rows); r["dataset"]=label; return r
aux=pd.concat([aux(succ,"all81"),aux(succ_d,"dedup77")])
aux.round(4).to_csv(OUT+"species_level_pathway_contrasts.csv",index=False)
print("\n[Aux species-level] Gardening vs others:"); print(aux.round(3).to_string(index=False))

temp["ptot"]=temp.groupby("introduction.period")["n"].transform("sum"); temp["share"]=temp["n"]/temp["ptot"]
temp.to_csv(OUT+"temporal_shares.csv",index=False)
print("\n[Aux temporal] Gardening share by period:")
print(temp.pivot(index="introduction.period",columns="pathway",values="share").round(3).to_string())
json.dump(zero_note,open(OUT+"niche_breadth_zero_note.json","w"),indent=1)

# ---------- SVG figures (matplotlib unavailable) ----------
def svg_bar(path, labels, vals, los, his, title, subline):
    Wd, H = 940, 80+40*len(labels)+80
    L = [f'<svg xmlns="http://www.w3.org/2000/svg" width="{Wd}" height="{H}" font-family="sans-serif">',
         f'<text x="20" y="28" font-size="17" font-weight="bold">{title}</text>',
         f'<text x="20" y="46" font-size="12" fill="#555">{subline}</text>']
    x0, w, ymax = 320, 500, 1.0
    for i,(l,v,lo,hi) in enumerate(zip(labels,vals,los,his)):
        y = 80+i*40
        L.append(f'<text x="{x0-10}" y="{y+13}" font-size="12" text-anchor="end">{l}</text>')
        if v!=v: continue
        L.append(f'<rect x="{x0}" y="{y}" width="{w*v/ymax}" height="20" fill="#3b7dd8"/>')
        L.append(f'<line x1="{x0+w*lo/ymax}" y1="{y+10}" x2="{x0+w*hi/ymax}" y2="{y+10}" stroke="#c0392b" stroke-width="2"/>')
        for xx in (lo,hi):
            L.append(f'<line x1="{x0+w*xx/ymax}" y1="{y+5}" x2="{x0+w*xx/ymax}" y2="{y+15}" stroke="#c0392b" stroke-width="2"/>')
        L.append(f'<text x="{x0+w*hi/ymax+8}" y="{y+13}" font-size="11">{v:.2f} [{lo:.2f}-{hi:.2f}]</text>')
    for t in [0,.25,.5,.75,1.0]:
        L.append(f'<line x1="{x0+w*t}" y1="70" x2="{x0+w*t}" y2="{80+40*len(labels)}" stroke="#ddd"/>')
        L.append(f'<text x="{x0+w*t}" y="{98+40*len(labels)}" font-size="11" text-anchor="middle">{t:.2f}</text>')
    L.append(f'<text x="20" y="62" font-size="11" fill="#c0392b">red caps = Wilson 95% CI (plot-level bootstrap CIs in CSV)</text></svg>')
    open(path,"w").write("\n".join(L))

d2 = desc.dropna(subset=["gard_share"])
svg_bar(OUT+"fig1_gardening_share_by_habitat.svg", list(d2["habitat"]), list(d2["gard_share"]),
        list(d2["wilson_lo"]), list(d2["wilson_hi"]),
        "Gardening-pathway share of non-native plants by habitat type",
