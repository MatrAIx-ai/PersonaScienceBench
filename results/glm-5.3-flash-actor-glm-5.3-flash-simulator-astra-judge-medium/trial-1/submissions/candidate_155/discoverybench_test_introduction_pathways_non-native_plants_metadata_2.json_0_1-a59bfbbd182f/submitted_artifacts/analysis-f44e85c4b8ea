"""
Gardening introduction pathway prevalence across habitat types
(Barcelona province non-native flora; DiscoveryBench episode
discovery_bench:test/introduction_pathways_non-native_plants).

Main metric  : gardening prevalence per plot  = sum(n.gard)/n_plots per habitat
               (all 632 plots in the denominator, zero-count plots included)
Robustness   : pathway composition share among plots with >=1 non-native record
               = sum(n.gard)/sum(n.total) restricted to n.total>0
Supplements  : temporal trends (pathway x period), species-level invasion success
               by primary pathway (duplicated=TRUE secondary-pathway rows removed).
"""
import pandas as pd
import numpy as np

OUT = open('gardening_prevalence_summary.txt', 'w')
def say(*a):
    line = ' '.join(str(x) for x in a)
    print(line); OUT.write(line + '\n')

# ---------- Load ----------
temporal = pd.read_csv('data/temporal_trends_contingency_table.csv', sep='\t')
species  = pd.read_csv('data/invasion_success_pathways.csv')
plots    = pd.read_csv('data/invaded_niche_pathways.csv', sep='\t')
assert (plots['n.gard'] + plots['n.unint'] + plots['n.agfo'] == plots['n.total']).all()

# ---------- 1. Per-habitat summary ----------
hab_order = ['Urban','Croplands','Coastal','Riparian','Wetlands','Meadows',
             'Scrublands','Rock outcrops','Broad-leaved forests','Coniferous forests']
rows = []
for hab, g in plots.groupby('habitat'):
    pos = g[g['n.total'] > 0]                      # plots with >=1 non-native record
    tot = g[['n.gard','n.unint','n.agfo','n.total']].sum()
    row = dict(habitat=hab, n_plots=len(g),
               gard_count=tot['n.gard'], unint_count=tot['n.unint'],
               agfo_count=tot['n.agfo'], total_records=tot['n.total'],
               # MAIN: prevalence per plot (zero plots included)
               gard_per_plot=tot['n.gard']/len(g),
               unint_per_plot=tot['n.unint']/len(g),
               agfo_per_plot=tot['n.agfo']/len(g),
               # any-record prevalence
               frac_plots_any_record=len(pos)/len(g),
               # robustness: composition within invaded plots only
               gard_share_invaded=(pos['n.gard'].sum()/pos['n.total'].sum()) if len(pos) else np.nan,
               unint_share_invaded=(pos['n.unint'].sum()/pos['n.total'].sum()) if len(pos) else np.nan,
               agfo_share_invaded=(pos['n.agfo'].sum()/pos['n.total'].sum()) if len(pos) else np.nan,
               n_invaded_plots=len(pos))
    rows.append(row)
hab_sum = pd.DataFrame(rows).set_index('habitat').loc[hab_order]
hab_sum['urban2009_50m_mean'] = plots.groupby('habitat')['urban.2009.50m'].mean().loc[hab_order]
hab_sum['crop2009_50m_mean']  = plots.groupby('habitat')['cropland.2009.50m'].mean().loc[hab_order]
hab_sum['temp_mean'] = plots.groupby('habitat')['annual.temperature'].mean().loc[hab_order]
hab_sum['rain_mean'] = plots.groupby('habitat')['annual.rainfall'].mean().loc[hab_order]
hab_sum = hab_sum.round(3)
say('=== Table 1: per-habitat gardening prevalence and pathway composition ===')
say(hab_sum.to_string())
hab_sum.to_csv('habitat_pathway_summary.csv')

# ---------- 2. Gradient checks ----------
say('\n=== Table 2: Spearman correlations between per-plot gardening counts and covariates ===')
covs = ['urban.2009.50m','cropland.2009.50m','urban.2009.1000m','cropland.2009.1000m',
        'annual.temperature','annual.rainfall','elevation','distance.road','distance.stream']
res = []
for c in covs:
    r_all = plots['n.gard'].corr(plots[c], method='spearman')
    r_any = plots.loc[plots['n.total']>0,'n.gard'].corr(plots.loc[plots['n.total']>0,c], method='spearman')
    res.append((c, round(r_all,3), round(r_any,3)))
cor = pd.DataFrame(res, columns=['covariate','spearman_all632plots','spearman_among_invaded'])
say(cor.to_string(index=False))
cor.to_csv('gardening_covariate_correlations.csv', index=False)

# habitat-level: gard_per_plot vs urban mean across the 10 habitats
s1 = hab_sum['gard_per_plot'].corr(hab_sum['urban2009_50m_mean'], method='spearman')
s2 = hab_sum['gard_share_invaded'].corr(hab_sum['urban2009_50m_mean'], method='spearman')
say(f'\nHabitat-level Spearman: gard_per_plot vs urban cover = {s1:.2f}; '
    f'gard_share_invaded vs urban cover = {s2:.2f}')

# ---------- 3. Temporal background ----------
say('\n=== Table 3: temporal trends (pathway x period) ===')
piv = temporal.pivot(index='introduction.period', columns='pathway', values='n')
piv['total'] = piv.sum(axis=1)
piv['gard_share'] = (piv['Gardening']/piv['total']).round(3)
say(piv.loc[['Before 1500','1501-1900','1901-1984','1985-2019']].to_string())

# ---------- 4. Species-level invasion success (dedup decision) ----------
say('\n=== Table 4: invasion success by PRIMARY pathway (duplicated=TRUE removed) ===')
prim = species[~species['duplicated']]
say('Dedup decision: 81 rows contain 77 unique species; the 4 duplicated=TRUE rows are the '
    'same species listed with a SECONDARY introduction pathway (Eucalyptus camaldulensis, '
    'Opuntia ficus-indica, Oxalis debilis, Populus deltoides). For species-level metrics we '
    'keep only the primary pathway rows (duplicated=FALSE, n=76) to avoid double counting.')
say(f'Primary pathway counts: {prim["intro.pathway"].value_counts().to_dict()} '
    f'(with secondary rows Gardening=42, Unintentional=30, AgriForest=9 of 81 rows)')
t4 = prim.groupby('intro.pathway')[['number.of.invaded.plots','invaded.niche.breadth','mrt']].agg(['mean','median']).round(2)
say(t4.to_string())
OUT.close()
