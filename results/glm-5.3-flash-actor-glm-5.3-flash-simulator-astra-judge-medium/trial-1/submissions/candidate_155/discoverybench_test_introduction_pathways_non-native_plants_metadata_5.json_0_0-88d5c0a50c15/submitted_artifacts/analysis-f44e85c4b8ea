# ============================================================
# DiscoveryBench: "In what scenario did urban land use promote
# a specific type of plant invasion?" (Barcelona province plots)
# Full workflow S0-S4, as approved by researcher.
# ============================================================
import numpy as np, pandas as pd, re, json, warnings
from scipy import stats
import statsmodels.api as sm
from statsmodels.discrete.count_model import ZeroInflatedNegativeBinomialP
from statsmodels.discrete.discrete_model import NegativeBinomial, Poisson
warnings.filterwarnings("ignore")
OUT = {}
def p(txt=""): print(txt)

# ---------------- S0: load & clean ----------------
tt  = pd.read_csv("data/temporal_trends_contingency_table.csv", sep="\t")
ins = pd.read_csv("data/invasion_success_pathways.csv")
inp = pd.read_csv("data/invaded_niche_pathways.csv", sep="\t")

# dedup policy (researcher-approved): keep base row per Scientific_name,
# drop the '2'-suffixed phylo-tip duplicate copies for species-level stats
ins_dedup = ins[~ins["duplicated"]].copy()
p(f"S0: invasion_success rows {len(ins)} -> deduped {len(ins_dedup)} "
  f"(removed {ins['duplicated'].sum()} '2'-suffix copies)")
assert (inp["n.gard"]+inp["n.unint"]+inp["n.agfo"]==inp["n.total"]).all()

# ---------------- S1: descriptive ----------------
p("\n=== S1a: temporal trends (proportion of each pathway per period) ===")
piv = tt.pivot(index="introduction.period", columns="pathway", values="n")
piv_pct = (piv.div(piv.sum(axis=1),axis=0)*100).round(1)
p(piv.to_string()); p(piv_pct.to_string())
chi2, pv, dof, _ = stats.chi2_contingency(piv)
p(f"Chi-square period x pathway: chi2={chi2:.1f}, df={dof}, p={pv:.2e}")

p("\n=== S1b: invasion counts summed by habitat ===")
hab = inp.groupby("habitat")[["n.gard","n.unint","n.agfo","n.total"]].sum()
hab["n_plots"]=inp.groupby("habitat").size()
hab["total_per_plot"]=(hab["n.total"]/hab["n_plots"]).round(2)
p(hab.to_string())

p("\n=== S1c: mean pathway counts by urban.2009.500m quartile ===")
inp["urb09_q"]=pd.cut(inp["urban.2009.500m"],bins=[-0.01,0.001,0.05,0.30,1.01],labels=["0%","0-5%","5-30%",">30%"])
q=inp.groupby("urb09_q",observed=True)[["n.gard","n.unint","n.agfo","n.total","urban.2009.500m"]].mean().round(3)
p(q.to_string())
p("\nMean counts by urban.2009.500m==0 vs >0:")
p(inp.assign(u=inp["urban.2009.500m"]>0).groupby("u")[["n.gard","n.unint","n.agfo","n.total"]].mean().round(3).to_string())

p("\n=== S1d: recent progressive change (1993-2009, 50m) halves ===")
inp["prog_hi"]=inp["progressive.1993.2009.50m"]>=inp["progressive.1993.2009.50m"].median()
p(inp.groupby("prog_hi")[["n.gard","n.unint","n.agfo","n.total"]].mean().round(3).to_string())

corr_urb = {c: round(inp[f"urban.2009.500m"].corr(inp[c]),3) for c in ["n.gard","n.unint","n.agfo","n.total"]}
corr_cro = {c: round(inp[f"cropland.2009.500m"].corr(inp[c]),3) for c in ["n.gard","n.unint","n.agfo","n.total"]}
OUT["corr_urban2009_500m"]=corr_urb; OUT["corr_cropland2009_500m"]=corr_cro
p(f"\nPearson r with urban.2009.500m:  {corr_urb}")
p(f"Pearson r with cropland.2009.500m: {corr_cro}")

# ---------------- S2: count models ----------------
p("\n=== S2: count models (plot level, N=632) ===")
# scale continuous predictors, log-transform skewed distances, group habitats
inp["z_elev"]=(inp["elevation"]-inp["elevation"].mean())/inp["elevation"].std()
for c in ["annual.temperature","annual.rainfall"]:
    inp["z_"+c]=(inp[c]-inp[c].mean())/inp[c].std()
inp["log_dist_road"]=np.log10(inp["distance.road"]+1); inp["log_dist_road"]=(inp["log_dist_road"]-inp["log_dist_road"].mean())/inp["log_dist_road"].std()
inp["log_dist_stream"]=np.log10(inp["distance.stream"]+1); inp["log_dist_stream"]=(inp["log_dist_stream"]-inp["log_dist_stream"].mean())/inp["log_dist_stream"].std()
inp["habgrp"]=inp["habitat"].replace({"Broad-leaved forests":"Forest","Coniferous forests":"Forest",
                                      "Rock outcrops":"ScrubRock","Scrublands":"ScrubRock"})
p("habitat groups: "+str(inp["habgrp"].value_counts().to_dict()))
dum=pd.get_dummies(inp["habgrp"],prefix="hab",drop_first=True).astype(float)
ctrl=["z_elev","z_annual.temperature","z_annual.rainfall","log_dist_road","log_dist_stream"]
def makeX(main):
    return sm.add_constant(pd.concat([inp[main],dum,inp[ctrl]],axis=1))

def fit(yname, X, fam=None, nb=False, zinb=False, name=""):
    y = inp[yname]
    try:
        if zinb:
            Xi=sm.add_constant(pd.DataFrame({"infl":np.ones(len(inp))}))
            st=None
            try:
                nbm=NegativeBinomial(y,X).fit(disp=0,maxiter=200,method="bfgs")
                st=list(nbm.params)+[0.0]
            except Exception: pass
            m=ZeroInflatedNegativeBinomialP(y,X,inflation="logit",exog_infl=Xi).fit(disp=0,maxiter=800,start_params=st)
        elif nb:
            m=NegativeBinomial(y,X).fit(disp=0,maxiter=500,method="bfgs")
        else:
            m=sm.GLM(y,X,family=fam).fit(cov_type="HC0")
        return m
    except Exception as e:
        p(f"  [{name}] FAILED: {type(e).__name__}: {e}"); return None

def report(m,label,mainvars):
    if m is None: return None
    aic=m.aic if m.aic==m.aic else "NA"
    p(f"-- {label}:  llf={m.llf:.1f}  AIC={aic}")
    for k in mainvars:
        v=m.params[k]; pv=m.pvalues[k]
        star="***" if pv<0.001 else "**" if pv<0.01 else "*" if pv<0.05 else ""
        p(f"     {k:34s} coef={v:+.3f}  p={pv:.4g} {star}")
    OUT[label]={k:{"coef":round(float(m.params[k]),3),"p":round(float(m.pvalues[k]),5)} for k in mainvars}
    return m

MAINS=["urban.2009.500m","progressive.1993.2009.50m"]
p("\n-- S2a: predictor search, Poisson(HC0) AIC for n.gard --")
best=None
for var in ["urban.1956.500m","urban.1993.500m","urban.2009.500m","urban.2009.50m","urban.2009.1000m"]:
    X=makeX([var,"progressive.1993.2009.50m"])
    m=fit("n.gard",X,fam=sm.families.Poisson(),name=var)
    if m:
        p(f"   {var:22s} AIC={m.aic:7.1f}  coef={m.params[var]:+.3f} p={m.pvalues[var]:.2e}")
        if best is None or m.aic<best[0]: best=(m.aic,var)
p(f"   --> best urban predictor: {best[1]} (AIC {best[0]:.1f})")

UVAR=best[1]
MAINS=[UVAR,"progressive.1993.2009.50m"]
p(f"\n-- S2b: core model for n.gard (urban={UVAR}) --")
Xg=makeX(MAINS)
mg_p=fit("n.gard",Xg,fam=sm.families.Poisson()); report(mg_p,"Poisson n.gard",MAINS)
mg_nb=fit("n.gard",Xg,nb=True); report(mg_nb,"NB n.gard",MAINS)
mg_z=fit("n.gard",Xg,zinb=True,name="ZINB")
if mg_z is not None:
    p(f"-- ZINB n.gard: llf={mg_z.llf:.1f}")
    for k in MAINS:
        p(f"     {k:34s} coef={mg_z.params[k]:+.3f}  p={mg_z.pvalues[k]:.4g}")
    OUT["ZINB n.gard"]={k:{"coef":round(float(mg_z.params[k]),3),"p":round(float(mg_z.pvalues[k]),5)} for k in MAINS}

p("\n   also with 1956 urban cover (historical baseline):")
Xh=makeX(["urban.1956.500m","progressive.1993.2009.50m"])
mh=fit("n.gard",Xh,fam=sm.families.Poisson()); report(mh,"Poisson n.gard (urban.1956.500m)",["urban.1956.500m","progressive.1993.2009.50m"])


p("\n-- S2b2: habitat-group effects on n.gard (Poisson HC0, with and without urban cover) --")
Xh1=sm.add_constant(pd.concat([dum,inp[ctrl]],axis=1))
m1=fit("n.gard",Xh1,fam=sm.families.Poisson())
p("   habitat only:")
for k in dum.columns:
    p(f"     {k:20s} coef={m1.params[k]:+.3f} p={m1.pvalues[k]:.4g}")
Xh2=sm.add_constant(pd.concat([inp[[UVAR]],dum,inp[ctrl]],axis=1))
m2=fit("n.gard",Xh2,fam=sm.families.Poisson())
p(f"   habitat + {UVAR}:")
p(f"     {UVAR:20s} coef={m2.params[UVAR]:+.3f} p={m2.pvalues[UVAR]:.4g}")
for k in dum.columns:
    p(f"     {k:20s} coef={m2.params[k]:+.3f} p={m2.pvalues[k]:.4g}")
OUT["habitat_only_n.gard"]={k:{"coef":round(float(m1.params[k]),3),"p":round(float(m1.pvalues[k]),5)} for k in dum.columns}

p("\n-- S2c: contrast channels (Poisson HC0) --")
Xu=makeX(["cropland.2009.500m","urban.2009.500m"])
mu=fit("n.unint",Xu,fam=sm.families.Poisson()); report(mu,"Poisson n.unint",["cropland.2009.500m","urban.2009.500m"])
mu2=fit("n.unint",makeX(MAINS),fam=sm.families.Poisson()); report(mu2,"Poisson n.unint (urban+prog)",MAINS)
ma=fit("n.agfo",Xg,fam=sm.families.Poisson()); report(ma,"Poisson n.agfo",MAINS)

p("\n-- S2d: interaction urban.2009.500m x progressive.1993.2009.50m (n.gard) --")
inp["uxp"]=inp["urban.2009.500m"]*inp["progressive.1993.2009.50m"]
Xi=makeX(["urban.2009.500m","progressive.1993.2009.50m","uxp"])
mi=fit("n.gard",Xi,fam=sm.families.Poisson())
if mi is not None:
    report(mi,"Poisson n.gard + interaction",["urban.2009.500m","progressive.1993.2009.50m","uxp"])

# ---------------- S3: species-level mechanism ----------------
p("\n=== S3: species-level traits by introduction pathway (deduped, N=77) ===")
d=ins_dedup
for v in ["invaded.niche.breadth","habitat.range","number.of.invaded.plots","area.of.occupancy.10km","mrt"]:
    groups=[d.loc[d["intro.pathway"]==g,v].values for g in ["Gardening","Unintentional","AgriForest"]]
    H,pv=stats.kruskal(*groups)
    med={g:round(float(np.median(d.loc[d['intro.pathway']==g,v])),2) for g in ["Gardening","Unintentional","AgriForest"]}
    p(f"   {v:26s} KW H={H:6.2f} p={pv:.4g} medians={med}")
    OUT[f"KW_{v}"]={"H":round(H,2),"p":float(pv),"medians":med}
mw=stats.mannwhitneyu(d.loc[d["intro.pathway"]=="Gardening","invaded.niche.breadth"],
                      d.loc[d["intro.pathway"]=="Unintentional","invaded.niche.breadth"],alternative="less")
p(f"   Mann-Whitney Gardening < Unintentional (invaded.niche.breadth): U={mw.statistic:.0f}, p={mw.pvalue:.4g}")
OUT["MW_gard_less_unint_nichebreadth"]={"U":float(mw.statistic),"p":float(mw.pvalue)}
p("\n   mean invaded.niche.breadth x pathway:")
p(d.groupby("intro.pathway")[["invaded.niche.breadth","habitat.range","number.of.invaded.plots","mrt"]].agg(["mean","median"]).round(2).to_string())
# phylo note
tips=set(re.findall(r'[A-Za-z_\-0-9]+(?=:)',open("data/phylogenetic_tree.txt").read()))
p(f"\n   Phylo note: tree contains {len(tips)} tip labels incl. the four '2'-suffix duplicate tips "
  f"(Eucalyptus_camaldulensis2, Opuntia_ficus-indica2, Oxalis_debilis2, Populus_deltoides2); "
  f"species-level stats above use the {len(ins_dedup)} deduped base rows.")

# ---------------- summary ----------------
p("\n=== Key numbers for hypothesis ===")
p(f"AIC habitat-only (n.gard): {m1.aic:.1f} | habitat+{UVAR}: {m2.aic:.1f}")
p(f"NB urban coef ({UVAR}): {mg_nb.params[UVAR]:+.3f} p={mg_nb.pvalues[UVAR]:.4g} (habitat-adjusted: NS/negative)")
p(f"Poisson interaction uxp: {mi.params['uxp']:+.3f} p={mi.pvalues['uxp']:.4g} (trend only, not significant)")

p("\n-- S1e: gardening share of invaders per habitat (gardening specificity) --")
inp["share_gard"]=np.where(inp["n.total"]>0, inp["n.gard"]/inp["n.total"].replace(0,np.nan), np.nan)
sh=inp.groupby("habitat").apply(lambda d: pd.Series({
    "gard_sum":d["n.gard"].sum(),"total_sum":d["n.total"].sum(),
    "gard_share":d["n.gard"].sum()/max(d["n.total"].sum(),1),
    "mean_share_pos":d.loc[d["n.total"]>0,"share_gard"].mean()}), include_groups=False).round(3).sort_values("gard_share",ascending=False)
p(sh.to_string())
OUT["gardening_share_by_habitat"]=sh.to_dict(orient="index")

# urban vs non-urban habitat comparison for pathway mix
p("\n-- S1f: pathway mix, urban habitat vs croplands (chi-square on pooled counts) --")
tab=inp.groupby("habitat")[["n.gard","n.unint","n.agfo"]].sum().loc[["Urban","Croplands"]]
chi2b,pb,_,_=stats.chi2_contingency(tab)
p(tab.to_string()); p(f"chi2={chi2b:.2f}, p={pb:.4g}")
OUT["chi2_urban_vs_cropland_mix"]={"chi2":round(chi2b,2),"p":float(pb)}

json.dump(OUT, open("outputs/model_summary.json","w"), indent=1, default=str)
p("\nSaved outputs/model_summary.json")
