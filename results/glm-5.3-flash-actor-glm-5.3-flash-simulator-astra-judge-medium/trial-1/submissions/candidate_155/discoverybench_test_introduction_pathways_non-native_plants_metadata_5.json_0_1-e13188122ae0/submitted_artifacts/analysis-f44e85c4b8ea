"""
Analysis: Which plant introduction pathways are influenced by urban land use?
Data: 632 plots (Barcelona province), 3 introduction pathways (Gardening,
Unintentional, AgriForest), urban land-cover share at 50/500/1000 m buffers
in 1956/1993/2009.

A) Hurdle models per pathway: presence part = logistic with WEAK RIDGE (lambda=0.1
   on non-intercept coefficients; needed because several habitat levels have zero
   positives -> separation) plus count part = Poisson on positive counts.
   Focal covariate: urban.2009.500m. Covariates: log elevation, habitat (10),
   log road & stream distance, annual temperature & rainfall, b-splines of UTM x,y.
   Joint bootstrap (1000) of presence-part urban coefficients -> pairwise
   pathway contrasts. Sensitivity across 9 land-cover columns.
B) Invasion-success metrics by pathway (Kruskal-Wallis).
C) Temporal pathway counts/shares (chi-square).
"""
import numpy as np, pandas as pd, patsy
from scipy import stats
import json, warnings
warnings.filterwarnings("ignore")

d = pd.read_csv('data/invaded_niche_pathways.csv', sep='\t')
d['logroad'] = np.log1p(d['distance.road']); d['logstream'] = np.log1p(d['distance.stream'])
d['elevlog'] = np.log1p(d['elevation'])
for c in ['elevlog','logroad','logstream','annual.temperature','annual.rainfall','longitude','latitude']:
    d['z_'+c if c.startswith('annual') or c in ('longitude','latitude') else c] = \
        (d[c]-d[c].mean())/d[c].std()
d = d.rename(columns={'z_annual.temperature':'temp','z_annual.rainfall':'rain',
                      'z_longitude':'x','z_latitude':'y'})
d['habitat'] = d['habitat'].astype(str)

pathways = ['Gardening','Unintentional','AgriForest']
pathway_col = {'Gardening':'n.gard','Unintentional':'n.unint','AgriForest':'n.agfo'}
for p in pathways: d['pres_'+p] = (d[pathway_col[p]]>0).astype(int)

BASE = 'urban.2009.500m'
RHS = 'urban + elevlog + C(habitat) + logroad + logstream + temp + rain + bs(x, df=4) + bs(y, df=4)'
LAM = 0.1

def penalized_irls(X, y, family='binomial', lam=LAM, maxit=100, tol=1e-9):
    n, k = X.shape
    P = np.eye(k); P[0,0] = 0.0            # do not penalize intercept
    b = np.zeros(k)
    for it in range(maxit):
        eta = X @ b
        if family == 'binomial':
            mu = 1/(1+np.exp(-np.clip(eta, -30, 30))); w = mu*(1-mu)
        else:
            mu = np.exp(np.clip(eta, -30, 30)); w = mu
        w = np.clip(w, 1e-10, None)
        U = X.T @ (y-mu) - lam*P@b
        H = X.T @ (X*w[:,None]) + lam*P
        step = np.linalg.solve(H, U)
        b = b + step
        if np.abs(step).max() < tol: break
    W = X.T @ (X*w[:,None]) + lam*P
    cov = np.linalg.inv(W)
    return b, cov, it

def fit_pathway(pathway, df, urban_col='urban'):
    Xp = patsy.dmatrix(RHS, df, return_type='dataframe')
    X = Xp.values; names = list(Xp.columns)
    j = names.index('urban')
    y = df['pres_'+pathway].values.astype(float)
    b, cov, it = penalized_irls(X, y, 'binomial')
    pres = {'coef':b[j], 'se':np.sqrt(cov[j,j]), 'z':b[j]/np.sqrt(cov[j,j]),
            'p':2*stats.norm.sf(abs(b[j]/np.sqrt(cov[j,j]))), 'OR':np.exp(b[j]), 'names':names, 'b':b}
    pos = df[df[pathway_col[pathway]]>0]
    Xp2 = patsy.dmatrix(RHS, pos, return_type='dataframe')
    X2 = Xp2.values; j2 = list(Xp2.columns).index('urban')
    y2 = pos[pathway_col[pathway]].values.astype(float)
    b2, cov2, _ = penalized_irls(X2, y2, 'poisson')
    cnt = {'coef':b2[j2], 'se':np.sqrt(cov2[j2,j2]),
           'p':2*stats.norm.sf(abs(b2[j2]/np.sqrt(cov2[j2,j2]))), 'OR':np.exp(b2[j2])}
    return pres, cnt

def urban_only_fit(pathway, df):
    Xp = patsy.dmatrix(RHS, df, return_type='dataframe')
    X = Xp.values; j = list(Xp.columns).index('urban')
    y = df['pres_'+pathway].values.astype(float)
    b, cov, _ = penalized_irls(X, y, 'binomial')
    return b[j]

# ---------- descriptives ----------
desc = []
for p in pathways:
    pres = d['pres_'+p]==1
    desc.append({'pathway':p,'n_pos':int(pres.sum()),
        'mean_urban_pos':d.loc[pres,BASE].mean(),'mean_urban_abs':d.loc[~pres,BASE].mean(),
        'r_urban':np.corrcoef(d[BASE], d['pres_'+p])[0,1]})
desc = pd.DataFrame(desc); desc.to_csv('results/A0_descriptives.csv', index=False)
print('=== A0. descriptives (urban.2009.500m) ==='); print(desc.round(4).to_string(index=False))

# ---------- A. main hurdle fits ----------
dd = d.rename(columns={BASE:'urban'})
rows = []
for p in pathways:
    pres, cnt = fit_pathway(p, dd)
    rows.append({'pathway':p,'part':'presence (logit, weak ridge)','n_pos':int(d['pres_'+p].sum()),
        'urban_coef':pres['coef'],'SE':pres['se'],'OR':pres['OR'],'p':pres['p']})
    rows.append({'pathway':p,'part':'count|>0 (Poisson, weak ridge)','n_pos':int((d[pathway_col[p]]>0).sum()),
        'urban_coef':cnt['coef'],'SE':cnt['se'],'OR':cnt['OR'],'p':cnt['p']})
res = pd.DataFrame(rows); res.to_csv('results/A_hurdle_main.csv', index=False)
print('\n=== A. hurdle models, urban.2009.500m (OR = exp(urban coef)) ===')
print(res.round(4).to_string(index=False))

# ---------- A2. joint bootstrap ----------
rng = np.random.default_rng(42); B = 1000
boot = {p: np.full(B, np.nan) for p in pathways}
for b_i in range(B):
    s = dd.iloc[rng.integers(0, len(dd), len(dd))]
    for p in pathways:
        try: boot[p][b_i] = urban_only_fit(p, s)
        except Exception: pass
bd = pd.DataFrame(boot)
print('\nboot valid:', bd.notna().sum().to_dict())
cis = {p: np.percentile(bd[p].dropna(), [2.5,97.5]) for p in pathways}
rows = []
for p in pathways:
    rows.append({'pathway':p,'boot_median':np.nanmedian(bd[p]),'CI_low':cis[p][0],'CI_high':cis[p][1]})
    print(f"{p}: urban coef boot median {np.nanmedian(bd[p]):.3f}, 95% CI [{cis[p][0]:.3f},{cis[p][1]:.3f}], OR CI [{np.exp(cis[p][0]):.2f},{np.exp(cis[p][1]):.2f}]")
diffs = []
for a,b in [('Gardening','Unintentional'),('Gardening','AgriForest'),('Unintentional','AgriForest')]:
    delta = (bd[a]-bd[b]).dropna()
    lo,hi = np.percentile(delta,[2.5,97.5])
    diffs.append({'comparison':f'{a} - {b}','delta':delta.mean(),'CI_low':lo,'CI_high':hi,
                  'p_two_sided':2*min((delta<=0).mean(),(delta>=0).mean()),'n_valid':len(delta)})
    print(f"{a} - {b}: delta {delta.mean():.3f} CI [{lo:.3f},{hi:.3f}] p={diffs[-1]['p_two_sided']:.3f}")
dfd = pd.DataFrame(diffs); dfd.to_csv('results/A_pathway_differences_boot.csv', index=False)
pd.DataFrame([{'pathway':p,'CI_low':cis[p][0],'CI_high':cis[p][1]} for p in pathways]).to_csv('results/A_boot_CIs.csv', index=False)

# ---------- A3. sensitivity ----------
sens = []
for buf in ['50m','500m','1000m']:
    for yr in ['1956','1993','2009']:
        col = f'urban.{yr}.{buf}'
        d2 = d.rename(columns={col:'urban'})
        for p in pathways:
            try: c = urban_only_fit(p, d2)
            except Exception: c = np.nan
            sens.append({'buffer':buf,'year':yr,'pathway':p,'urban_coef':c})
sens = pd.DataFrame(sens); sens.to_csv('results/A_sensitivity_buffers_years.csv', index=False)
print('\n=== A3. sensitivity (urban coef, presence logit) ===')
print(sens.pivot_table(index=['buffer','year'],columns='pathway',values='urban_coef').round(3).to_string())

# ---------- B ----------
sp = pd.read_csv('data/invasion_success_pathways.csv')
metrics = ['number.of.invaded.plots','area.of.occupancy.10km','habitat.range',
           'invaded.niche.breadth','mrt','native.niche.breadth','height']
brows = []
for met in metrics:
    g = [sp.loc[sp['intro.pathway']==p, met].values for p in pathways]
    H, pk = stats.kruskal(*g)
    brows.append({'metric':met,'KW_H':H,'p':pk,'median_gard':np.median(g[0]),
                  'median_unint':np.median(g[1]),'median_agfo':np.median(g[2])})
Bres = pd.DataFrame(brows); Bres.to_csv('results/B_invasion_success_by_pathway.csv', index=False)
print('\n=== B. invasion-success metrics by pathway (Kruskal-Wallis) ===')
print(Bres.round(4).to_string(index=False))

# ---------- C ----------
t = pd.read_csv('data/temporal_trends_contingency_table.csv', sep='\t')
t.columns = [c.strip('"') for c in t.columns]
piv = t.pivot(index='introduction.period', columns='pathway', values='n')[pathways]
shares = piv.div(piv.sum(axis=1), axis=0)
chi2, pc, dof, _ = stats.chi2_contingency(piv)
piv.to_csv('results/C_temporal_counts.csv'); shares.to_csv('results/C_temporal_shares.csv')
print('\n=== C. temporal trends ==='); print(piv.to_string())
print('shares:'); print(shares.round(3).to_string())
print(f'chi2={chi2:.1f}, dof={dof}, p={pc:.2e}')


# ---------- A1b. partial adjustments (mechanism of attenuation) ----------
prows = []
for p in pathways:
    for tag, rhs in [('no habitat (urban + env)', 'urban + elevlog + logroad + logstream + temp + rain + bs(x, df=4) + bs(y, df=4)'),
                     ('habitat only (urban + habitat)', 'urban + C(habitat)')]:
        Xp = patsy.dmatrix(rhs, dd, return_type='dataframe')
        X = Xp.values; j = list(Xp.columns).index('urban')
        b, cov, _ = penalized_irls(X, dd['pres_'+p].values.astype(float), 'binomial')
        prows.append({'pathway':p,'spec':tag,'urban_coef':b[j],'SE':np.sqrt(cov[j,j]),
                      'p':2*stats.norm.sf(abs(b[j]/np.sqrt(cov[j,j])))})
pres_adj = pd.DataFrame(prows); pres_adj.to_csv('results/A1b_partial_adjustments.csv', index=False)
print('\n=== A1b. partial-adjustment urban coefficients (presence logit) ===')
print(pres_adj.round(4).to_string(index=False))
print('corr(habitat==Urban dummy, urban.2009.500m): %.3f' % np.corrcoef((d['habitat']=='Urban').astype(float), d[BASE])[0,1])

json.dump({'descriptives': desc.to_dict('records'),
  'main_urban': {row['pathway'] + '/' + row['part']: {'coef':float(row['urban_coef']),'p':float(row['p'])} for _, row in res.iterrows()},
  'partial_adjustments': pres_adj.to_dict('records'),
  'boot_CIs': {p: [float(cis[p][0]), float(cis[p][1])] for p in pathways},
  'boot_diffs': diffs, 'sensitivity': sens.to_dict('records'),
  'kruskal': Bres.to_dict('records'), 'chi2_temporal': {'chi2':float(chi2),'p':float(pc),'dof':int(dof)}},
  open('results/summary.json','w'), indent=1, default=float)
print('\nSaved: results/*.csv + summary.json')
