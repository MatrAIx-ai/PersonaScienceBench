# -*- coding: utf-8 -*-
"""
How did urban land use affect the invasion of different types of introduced plants?
Three-layer analysis: (A) temporal pathway trends, (B) species-level invasion success
by pathway (+ phylogenetic sensitivity), (C) plot-level urban cover x pathway.
"""
import csv, re, math, warnings
import numpy as np, pandas as pd
from scipy import stats
import statsmodels.api as sm
import statsmodels.formula.api as smf
from statsmodels.stats.outliers_influence import variance_inflation_factor

warnings.filterwarnings("ignore")
pd.set_option("display.width", 200)

# ---------------------------------------------------------------- load data
temporal = pd.read_csv("data/temporal_trends_contingency_table.csv", sep="\t")
species  = pd.read_csv("data/invasion_success_pathways.csv")
plots    = pd.read_csv("data/invaded_niche_pathways.csv", sep="\t")
plots.columns = [c.strip('"').replace('.','_') for c in plots.columns]

print("="*70); print("PART A: temporal trends in introduction pathways"); print("="*70)
tab = temporal.pivot(index="introduction.period", columns="pathway", values="n")[["AgriForest","Gardening","Unintentional"]]
print(tab)
chi2, p, dof, _ = stats.chi2_contingency(tab)
n = tab.values.sum()
cramers_v = math.sqrt(chi2/(n*(min(tab.shape)-1)))
print(f"\nChi-square independence test: chi2={chi2:.1f}, dof={dof}, p={p:.2e}, Cramer's V={cramers_v:.3f}")
order = ["Before 1500","1501-1900","1901-1984","1985-2019"]
prop = tab.div(tab.sum(axis=1), axis=0).loc[order]
print("\nPathway share per period:")
print(prop.round(3))
x = np.arange(4)
for pw in tab.columns:
    r, pr = stats.pearsonr(x, prop[pw].values)
    print(f"  linear trend in share of {pw}: r={r:+.3f} (p={pr:.4f})")

# ---------------------------------------------------------------- Part B
print("\n"+"="*70); print("PART B: species-level invasion success by pathway"); print("="*70)
dups = species[species['duplicated'].astype(str).str.lower()=='true'].Scientific_name.unique().tolist()
print("duplicated=TRUE species (aggregation rule = mean of numeric traits):", dups)
num_cols = ["number.of.invaded.plots","area.of.occupancy.10km","habitat.range",
            "invaded.niche.breadth","mrt","native.niche.breadth","height"]
sp = species.groupby("Scientific_name").agg(
    {**{c:"mean" for c in num_cols}, "intro.pathway":"first", "growth.form":"first",
     "phylo.tip.label":"first"}).reset_index()
sp.columns = [c.replace(".","_") for c in sp.columns]
sp["pathway"] = sp["intro_pathway"]
print(f"after aggregation: {len(sp)} species (from {len(species)} rows)")
print("\npathway counts:", sp["intro_pathway"].value_counts().to_dict())

for y in ["number_of_invaded_plots","area_of_occupancy_10km","invaded_niche_breadth"]:
    groups = [sp.loc[sp["intro_pathway"]==pw, y].values for pw in ["Gardening","Unintentional","AgriForest"]]
    H, pk = stats.kruskal(*groups)
    med = {pw: float(np.median(g)) for pw,g in zip(["Gardening","Unintentional","AgriForest"],groups)}
    eps2 = (H - 3 + 1) / (len(sp) - 3)   # epsilon-squared effect size
    print(f"Kruskal-Wallis {y}: H={H:.2f}, p={pk:.4f}, eps^2={eps2:.3f}, medians={med}")

# Negative binomial GLM: invaded plots ~ pathway + mrt + habitat.range
sp["pathway"] = pd.Categorical(sp["intro_pathway"], categories=["Gardening","AgriForest","Unintentional"])
md = smf.negativebinomial("number_of_invaded_plots ~ pathway + mrt + habitat_range", data=sp).fit(disp=0)
print("\nNB GLM number.of.invaded.plots ~ pathway + mrt + habitat.range:")
print(md.summary().tables[1])

# ---------------- PGLS sensitivity (manual GLS with lambda grid search) ----
def parse_newick(s):
    s = s.strip().rstrip(";")
    pos = 0
    def node():
        nonlocal pos
        children = []; label = ""
        if s[pos] == "(":
            pos += 1
            while True:
                children.append(node())
                if s[pos] == ",": pos += 1; continue
                if s[pos] == ")": pos += 1; break
            m = re.match(r"[^,:;]*", s[pos:]); label = m.group(0); pos += len(label)
        else:
            m = re.match(r"[^,:()]*", s[pos:]); label = m.group(0); pos += len(label)
        blen = 0.0
        if pos < len(s) and s[pos] == ":":
            pos += 1
            m = re.match(r"[-0-9.eE+]+", s[pos:]); blen = float(m.group(0)); pos += len(m.group(0))
        return {"children": children, "label": label.strip(), "len": blen}
    return node()

root = parse_newick(open("data/phylogenetic_tree.txt").read())
tips = {}
def walk(nd, depth, path):
    path = path + [(id(nd), nd["len"])]
    if not nd["children"]:
        tips[nd["label"]] = (depth + nd["len"], path)
    for c in nd["children"]:
        walk(c, depth + nd["len"], path)
walk(root, 0.0, [])
tip_labels = list(tips)
print(f"\nPGLS: tree parsed, {len(tip_labels)} tips")

def shared_depth(a, b):
    pa, pb = tips[a][1], tips[b][1]
    d, i = 0.0, 0
    while i < min(len(pa), len(pb)) and pa[i][0] == pb[i][0]:
        d += pa[i][1]; i += 1
    return d

Vfull = np.zeros((len(tip_labels), len(tip_labels)))
for i,a in enumerate(tip_labels):
    for j,b in enumerate(tip_labels):
        if i==j: Vfull[i,j] = tips[a][0]
        else:    Vfull[i,j] = shared_depth(a,b)
idx = {l:i for i,l in enumerate(tip_labels)}
sp["tip_i"] = sp["phylo_tip_label"].map(idx)

def pgls(formula_like, X, y, lam_grid=np.linspace(0,1,21)):
    # formula_like unused; X,y numpy; returns best lambda, coefs, se, ll
    n = len(y)
    best = None
    for lam in lam_grid:
        V = lam*Vfull[np.ix_(sp.tip_i, sp.tip_i)] + (1-lam)*np.eye(n)
        V = V + np.eye(n)*1e-8
        Vinv = np.linalg.inv(V)
        XtVinvX = X.T @ Vinv @ X
        beta = np.linalg.solve(XtVinvX, X.T @ Vinv @ y)
        resid = y - X @ beta
        s2 = float(resid @ Vinv @ resid) / (n - X.shape[1])
        ll = -0.5*(n*np.log(2*np.pi) + 2*np.log(max(s2,1e-12)) + np.linalg.slogdet(V)[1] + resid @ Vinv @ resid / s2)
        if best is None or ll > best[0]:
            cov = np.linalg.inv(XtVinvX) * s2
            best = (ll, lam, beta, np.sqrt(np.diag(cov)))
    return best

Z = pd.get_dummies(sp["pathway"], prefix="pw", drop_first=True).astype(float)
for target, name in [("invaded_niche_breadth","invaded niche breadth"),
                     ("number_of_invaded_plots","invaded plots")]:
    y = sp[target].values.astype(float)
    if name=="invaded plots": y = np.log1p(y)
    X = np.column_stack([np.ones(len(sp)), Z.values])
    ll, lam, beta, se = pgls(None, X, y)
    names = ["Intercept","pw_AgriForest","pw_Unintentional"]
    print(f"\nPGLS {name} ~ pathway (lambda={lam:.2f}):")
    for nm,b,sd in zip(names,beta,se):
        t = b/sd if sd>0 else np.nan
        print(f"  {nm}: beta={b:+.3f} (SE={sd:.3f}, t={t:+.2f})")

# ---------------------------------------------------------------- Part C
print("\n"+"="*70); print("PART C: plot-level urban cover x pathway"); print("="*70)
long = plots.melt(id_vars=[c for c in plots.columns if not c.startswith("n_")],
                  value_vars=["n_gard","n_unint","n_agfo"],
                  var_name="pathway", value_name="count")
long["pathway"] = long["pathway"].str.replace("n_","").map(
    {"gard":"Gardening","unint":"Unintentional","agfo":"AgriForest"})
long["plot_id"] = long.index // 3
long["pathway"] = pd.Categorical(long["pathway"], categories=["Gardening","AgriForest","Unintentional"])

covs = "habitat + elevation + annual_temperature + annual_rainfall + annual_radiation + distance_stream + distance_road"

def fit_nb(data, formula, group):
    m = smf.negativebinomial(formula, data=data).fit(disp=0, method="lbfgs",
        maxiter=200, cov_type="cluster", cov_kwds={"groups": group})
    return m

aics = {}
for scale in ["50m","500m","1000m"]:
    u = f"urban_2009_{scale}"
    f1 = f"count ~ pathway*{u} + {covs}"
    m1 = fit_nb(long, f1, long["plot_id"])
    f2 = f"count ~ pathway + progressive_1956_2009_50m + regressive_1956_2009_50m + {covs}"
    m2 = fit_nb(long, f2, long["plot_id"])
    aics[scale] = {"current_urban_cover(model1)": m1.aic, "historical_change(model2)": m2.aic}
    print(f"\n--- scale {scale} ---")
    print(f"M1 (current urban cover) AIC={m1.aic:.1f} | M2 (historical change) AIC={m2.aic:.1f}")
    print(f"LR test interaction (M1 vs pathway+urban add-on): use table below")
    print(f"M1 key coefficients (IRR = exp(beta)):")
    for t in m1.params.index:
        if ("pathway" in t) or (u in t) or (":" in t):
            b = m1.params[t]; p = m1.pvalues[t]
            print(f"  {t}: beta={b:+.3f}, IRR={math.exp(b):.2f}, p={p:.4f}")
    # LRT for interaction
    m0 = fit_nb(long, f"count ~ pathway + {u} + {covs}", long["plot_id"])
    lr = 2*(m1.llf - m0.llf); df = 2
    print(f"  interaction LRT: LR={lr:.2f}, df={df}, p={stats.chi2.sf(lr,df):.4f}")
    print(f"M2 key coefficients:")
    for t in m2.params.index:
        if ("progressive" in t) or ("regressive" in t):
            b = m2.params[t]; p = m2.pvalues[t]
            print(f"  {t}: beta={b:+.3f}, IRR={math.exp(b):.2f}, p={p:.4f}")

print("\nAIC comparison (lower better):")
print(pd.DataFrame(aics).round(1))

# composition model with offset log(n.total+1)
long2 = long.merge(plots[["n_total"]].reset_index().rename(columns={"index":"plot_id"}), on="plot_id")
long2 = long2[long2["n_total"] > 0]
mcomp = fit_nb(long2, f"count ~ pathway*urban_2009_500m + {covs}", long2["plot_id"])
import math as _m
print(f"\nComposition model (offset log n.total, nonzero-plot subset n_plots={long2.plot_id.nunique()}):")
for t in mcomp.params.index:
    if ("pathway" in t) or ("urban" in t):
        print(f"  {t}: beta={mcomp.params[t]:+.3f}, IRR={_m.exp(mcomp.params[t]):.2f}, p={mcomp.pvalues[t]:.4f}")

# VIF collinearity urban vs progressive
print("\nCollinearity (VIF) between urban.2009 and 1956-2009 change terms:")
for scale in ["50m","500m","1000m"]:
    Xv = plots[[f"urban_2009_{scale}", "progressive_1956_2009_50m", "regressive_1956_2009_50m",
                "no_changes_1956_2009_50m"]].values
    Xv = sm.add_constant(Xv)
    vifs = [variance_inflation_factor(Xv, i) for i in range(1, Xv.shape[1])]
    print(f"  {scale}: VIF urban={vifs[0]:.1f}, progressive={vifs[1]:.1f}, regressive={vifs[2]:.1f}")

# marginal means: predicted counts at urban=0 vs 0.5 by pathway (M1, 500m)
u = "urban_2009_500m"
m1 = fit_nb(long, f"count ~ pathway*{u} + {covs}", long["plot_id"])
base = long.drop_duplicates("plot_id").copy()
print("\nPredicted plot counts at urban.2009.500m = 0.00 vs 0.75 (other covs at median/mode):")
for pw in ["Gardening","Unintentional","AgriForest"]:
    d0 = base.copy(); d0["pathway"] = pw; d0[u] = 0.0
    d1 = base.copy(); d1["pathway"] = pw; d1[u] = 0.75
    p0 = float(np.mean(m1.predict(d0))); p1 = float(np.mean(m1.predict(d1)))
    print(f"  {pw}: {p0:.2f} -> {p1:.2f} (x{p1/max(p0,1e-9):.2f})")
print("\nDONE")
