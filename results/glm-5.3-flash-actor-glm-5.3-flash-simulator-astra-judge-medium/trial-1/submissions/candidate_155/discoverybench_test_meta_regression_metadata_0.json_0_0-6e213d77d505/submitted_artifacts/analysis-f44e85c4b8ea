"""
BixBench analysis: For which domains do effect size estimates tend to be larger
in original studies compared to replication studies?

Data: meta-regression_joined_data_heterogeneity_in_replication_projects.csv
Main metric: paired Fisher-z difference d = fisr - fiso, by discipline.
Robustness: correlation scale (ro/rr), relative_es, replicated rate,
             weighted/robust meta-regression fisr ~ discipline + fiso,
             trimmed (extreme-value-excluded) sensitivity.
"""
import numpy as np
import pandas as pd
import scipy.stats as st

pd.set_option("display.width", 220)
pd.set_option("display.max_columns", 50)

df = pd.read_csv("data/meta-regression_joined_data_heterogeneity_in_replication_projects.csv")
print(f"=== DATA === shape={df.shape}, unique studies={df['study'].nunique()}, "
      f"full duplicate rows={df.duplicated().sum()}")

# ---------------------------------------------------------------- main paired stats
df["d"] = df["fisr"] - df["fiso"]
df["d_corr"] = df["rr"] - df["ro"]
df["shrink_mag"] = df["rr"].abs() < df["ro"].abs()      # magnitude shrinkage
df["sign_flip"] = np.sign(df["rr"]) != np.sign(df["ro"]) # direction flip
df["abs_rel_es"] = df["relative_es"].abs()

def paired_summary(g):
    d = g["d"].values
    n = len(d)
    mean, sd = d.mean(), d.std(ddof=1)
    se = sd / np.sqrt(n)
    tcrit = st.t.ppf(0.975, n - 1)
    t_t, t_p = st.ttest_1samp(d, 0)
    try:
        w_p = st.wilcoxon(d).pvalue
    except ValueError:
        w_p = np.nan
    return pd.Series({
        "n": n, "mean_d": mean, "median_d": np.median(d), "sd_d": sd,
        "ci_low": mean - tcrit * se, "ci_high": mean + tcrit * se,
        "t_p": t_p, "wilcoxon_p": w_p,
        "median_ro": g["ro"].median(), "mean_ro": g["ro"].mean(),
        "median_rr": g["rr"].median(), "mean_rr": g["rr"].mean(),
        "median_rel_es": g["relative_es"].median(), "mean_rel_es": g["relative_es"].mean(),
        "share_shrink_mag": g["shrink_mag"].mean(),
        "share_sign_flip": g["sign_flip"].mean(),
        "replicated_rate": g["replicated"].mean(),
    })

summ = df.groupby("discipline").apply(paired_summary, include_groups=False)
print("\n=== PER-DISCIPLINE PAIRED SUMMARY (d = fisr - fiso) ===")
print(summ.round(3).to_string())

print("\n=== EXTREME-VALUE SENSITIVITY (trim d beyond +/-3 MAD from median; none dropped by rule) ===")
med, mad = df["d"].median(), st.median_abs_deviation(df["d"], scale="normal")
print(f"median={med:.3f}, MAD-scaled={mad:.3f}, outer bounds=[{med-3*mad:.3f},{med+3*mad:.3f}]")
extreme = df[df["d"].abs() > med + 3 * mad]
print("rows beyond 3 MAD:", extreme[["study","discipline","d"]].to_string(index=False) if len(extreme) else "none")
# also a fixed trimming: drop |d| in top/bottom 5% for robustness check
q = df["d"].quantile([0.05, 0.95])
trim = df[(df["d"] >= q.iloc[0]) & (df["d"] <= q.iloc[1])]
print("\n5%-trimmed comparison (mean d / median d):")
print(df.groupby("discipline")["d"].agg(["mean","median"]).round(3))
print(trim.groupby("discipline")["d"].agg(["mean","median"]).round(3).rename(columns={"mean":"mean_d_trim","median":"median_d_trim"}))
# relative_es with/without extremes (drop |relative_es| > 1, i.e., replication > 100% of original)
m = df["relative_es"].abs() <= 1
print("\nrelative_es mean/median, full vs |relative_es|<=1 subset:")
print(df.groupby("discipline")["relative_es"].agg(["mean","median"]).round(3))
print(df[m].groupby("discipline")["relative_es"].agg(["mean","median"]).round(3))

# ---------------------------------------------------------------- group comparisons
print("\n=== GROUP COMPARISONS ===")
disc = ["Social","Cognitive","Economics"]
d_vals = {k: df.loc[df["discipline"]==k,"d"].values for k in disc}
r_vals = {k: df.loc[df["discipline"]==k,"relative_es"].values for k in disc}
print(f"Kruskal-Wallis on d: H={st.kruskal(*d_vals.values())[0]:.3f}, p={st.kruskal(*d_vals.values())[1]:.4f}")
print(f"Kruskal-Wallis on relative_es: H={st.kruskal(*r_vals.values())[0]:.3f}, p={st.kruskal(*r_vals.values())[1]:.4f}")
print(f"ANOVA on d: F={st.f_oneway(*d_vals.values())[0]:.3f}, p={st.f_oneway(*d_vals.values())[1]:.4f}")
for a,b in [("Social","Cognitive"),("Social","Economics"),("Cognitive","Economics")]:
    t,p = st.mannwhitneyu(d_vals[a], d_vals[b], alternative="two-sided")
    diff = d_vals[a].mean()-d_vals[b].mean()
    print(f"  Mann-Whitney d: {a} vs {b}: mean diff={diff:+.3f}, p={p:.4f}")

# replicated rates
tab = pd.crosstab(df["discipline"], df["replicated"])
print("\nreplicated x discipline table:\n", tab)
chi2, p, _, _ = st.chi2_contingency(tab)
print(f"Chi-square replicated ~ discipline: chi2={chi2:.3f}, p={p:.4f}")
for a,b in [("Social","Cognitive"),("Social","Economics"),("Cognitive","Economics")]:
    t = df[df["discipline"].isin([a,b])]
    ct = pd.crosstab(t["discipline"], t["replicated"])
    orr, pv = st.fisher_exact(ct)
    print(f"  Fisher replicated {a} vs {b}: OR={orr:.3f}, p={pv:.4f}")

# ---------------------------------------------------------------- meta-regression (sensitivity)
print("\n=== SENSITIVITY REGRESSION: fisr ~ discipline + fiso ===")
import statsmodels.api as sm
X = pd.get_dummies(df["discipline"], drop_first=True).astype(float)  # ref = Cognitive
X["fiso"] = df["fiso"]
X = sm.add_constant(X)
# OLS
ols = sm.OLS(df["fisr"], X).fit()
print(ols.summary2().tables[1].round(4).to_string())
# inverse-variance weighted by total precision (se_fiso^2 + se_fisr^2)
w = 1.0 / (df["se_fiso"]**2 + df["se_fisr"]**2)
wls = sm.WLS(df["fisr"], X, weights=w).fit()
print("\nWLS (inv-variance weighted):")
print(wls.summary2().tables[1].round(4).to_string())
# robust (HC3) OLS
rob = sm.OLS(df["fisr"], X).fit(cov_type="HC3")
print("\nOLS with HC3 robust SE:")
print(rob.summary2().tables[1].round(4).to_string())
# same regression with d as outcome
olsd = sm.OLS(df["d"], X.drop(columns=["fiso"])).fit(cov_type="HC3")
print("\nOLS (HC3) on d ~ discipline (no fiso covariate):")
print(olsd.summary2().tables[1].round(4).to_string())

# ---------------------------------------------------------------- key counts for wording
print("\n=== KEY COUNTS ===")
print(df.groupby("discipline").agg(
    n=("study","size"), shrink_mag=("shrink_mag","sum"), sign_flip=("sign_flip","sum"),
    replicated=("replicated","sum")).to_string())
print("\nSocial sign-flip share:", df[df["discipline"]=="Social"]["sign_flip"].mean().round(3))
print("Overall d mean/median:", df["d"].mean().round(3), df["d"].median().round(3))
print("Studies with d>0 (replication larger):", (df["d"]>0).sum(), "/", len(df))
