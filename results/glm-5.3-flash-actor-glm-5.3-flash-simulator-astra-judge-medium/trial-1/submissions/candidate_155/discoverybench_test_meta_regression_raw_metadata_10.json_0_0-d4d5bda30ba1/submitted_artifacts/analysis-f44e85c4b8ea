"""
Analysis: Proportion of junior professors among replicated studies in Psychology (project == 'rpp').

Main operational definition (assumption, flagged):
  junior professor = seniority.r in {Assistant, Assistant Professor}
Denominator: rows with project=='rpp' and replicated==1 (35 rows; each rpp study is one row).
Sensitivity analyses:
  S1: junior = Assistant Professor only
  S2: junior = Assistant / Assistant Professor / Associate Professor (broad)
  S3: main definition after excluding drop==True rows
"""
import pandas as pd

CSV = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
df = pd.read_csv(CSV)

# --- Data quality / robustness checks -------------------------------------
rpp = df[df["project"] == "rpp"].copy()
assert len(rpp) == 97
assert rpp["replicated"].notna().all(), "replicated has NaN in rpp"
assert rpp["seniority.r"].notna().all(), "seniority.r has NaN in rpp"
assert rpp["id"].is_unique, "rpp rows are not one-per-study"
print(f"rpp rows: {len(rpp)}; replicated: {rpp['replicated'].sum():.0f}; "
      f"replicated NaN: {rpp['replicated'].isna().sum()}; "
      f"seniority.r NaN: {rpp['seniority.r'].isna().sum()}; "
      f"unique ids: {rpp['id'].nunique()}")

rep = rpp[rpp["replicated"] == 1].copy()
N = len(rep)
print(f"Denominator (rpp & replicated==1): {N}")
print("\nseniority.r counts (rpp & replicated==1):")
print(rep["seniority.r"].value_counts(dropna=False).to_string())

MAIN_JUNIOR = {"Assistant", "Assistant Professor"}
def prop(subset, junior_set):
    n = int(subset["seniority.r"].isin(junior_set).sum())
    return n, len(subset), n / len(subset)

# --- Main definition -------------------------------------------------------
n_main, d_main, p_main = prop(rep, MAIN_JUNIOR)

# --- Sensitivity analyses --------------------------------------------------
n_s1, d_s1, p_s1 = prop(rep, {"Assistant Professor"})                       # S1: narrow
n_s2, d_s2, p_s2 = prop(rep, MAIN_JUNIOR | {"Associate Professor"})         # S2: broad
rep_nodrop = rep[rep["drop"] != True]                                       # S3: exclude drop==True
n_s3, d_s3, p_s3 = prop(rep_nodrop, MAIN_JUNIOR)

print("\n--- Results ---")
print(f"Main  (Assistant + Assistant Professor)      : {n_main}/{d_main} = {p_main:.1%} ({p_main:.3f})")
print(f"S1    (Assistant Professor only)             : {n_s1}/{d_s1} = {p_s1:.1%} ({p_s1:.3f})")
print(f"S2    (+ Associate Professor, broad)         : {n_s2}/{d_s2} = {p_s2:.1%} ({p_s2:.3f})")
print(f"S3    (main, excluding drop==True, n={d_s3}) : {n_s3}/{d_s3} = {p_s3:.1%} ({p_s3:.3f})")

out = pd.DataFrame({
    "definition": ["Main: Assistant + Assistant Professor",
                   "S1: Assistant Professor only",
                   "S2: broad (incl. Associate Professor)",
                   "S3: main, drop==True excluded"],
    "numerator": [n_main, n_s1, n_s2, n_s3],
    "denominator": [d_main, d_s1, d_s2, d_s3],
    "proportion": [round(p_main, 4), round(p_s1, 4), round(p_s2, 4), round(p_s3, 4)],
})
out.to_csv("analysis/junior_professor_rpp_results.csv", index=False)
print("\n", out.to_string(index=False))
