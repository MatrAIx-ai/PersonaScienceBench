"""
Analysis: Which domain (Social / Cognitive / Economics) used student subjects
primarily in BOTH the original and the replication studies?

Data: meta-regression_study_data_heterogeneity_in_replication_projects.csv
(927 rows x 57 cols; one row per original-study x replication-lab; 'id' identifies
 the O/R pair; 26 multi-lab pairs carry lab-level rows (aggregated=False) plus one
 consolidated row (aggregated=True)).

Method (approved):
  1. Deduplicate to ONE row per O/R pair (id): prefer the aggregated=True row,
     otherwise the single lab row  -> 141 analysis rows.
  2. Per discipline, compute the share of subjects.o == 'students' and
     subjects.r == 'students' (valid denominator, i.e. excluding the single
     missing-subjects pair rpp.154).
  3. Sensitivity: (a) lab-level rows only, (b) all 927 rows, (c) excluding the
     missing-subjects pair. The 'drop' column is NOT applied (semantics unclear).
"""
import pandas as pd

SRC = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
df = pd.read_csv(SRC)
df["aggregated"] = df["aggregated"].fillna(False).astype(bool)

print(f"raw rows: {len(df)}, unique O/R pairs (id): {df['id'].nunique()}")

# --- 1. dedup: one row per O/R pair, prefer aggregated row -------------------
multi_ids = set(df.loc[df["aggregated"], "id"])
dedup = df[(df["aggregated"]) | (~df["id"].isin(multi_ids))].copy()
assert dedup.groupby("id").size().eq(1).all()
assert len(dedup) == df["id"].nunique() == 141
print(f"deduplicated analysis rows: {len(dedup)}")

# --- 2. primary statistic: student share per discipline ----------------------
valid = dedup[dedup["subjects.o"].notna() & dedup["subjects.r"].notna()].copy()
print(f"pairs with complete subjects info: {len(valid)} "
      f"(excluded pair: {set(dedup['id']) - set(valid['id'])})")

rows = []
for disc in ["Social", "Cognitive", "Economics"]:
    sub = valid[valid["discipline"] == disc]
    rows.append({
        "discipline": disc,
        "n_pairs": len(sub),
        "n_students_o": int((sub["subjects.o"] == "students").sum()),
        "pct_students_o": round(100 * (sub["subjects.o"] == "students").mean(), 1),
        "n_students_r": int((sub["subjects.r"] == "students").sum()),
        "pct_students_r": round(100 * (sub["subjects.r"] == "students").mean(), 1),
    })
primary = pd.DataFrame(rows)
print("\n=== PRIMARY: deduplicated per O/R pair (aggregated row preferred) ===")
print(primary.to_string(index=False))

# --- 3. sensitivity analyses --------------------------------------------------
sens = {}
# (a) lab-level rows only (aggregated rows excluded)
lab = df[df["aggregated"] != True]
# (b) all raw rows
# (c) dedup + exclude missing-subjects pair already == valid set used above
for name, d in [("lab_rows_only", lab), ("all_raw_rows", df)]:
    s = []
    for disc in ["Social", "Cognitive", "Economics"]:
        sub = d[d["discipline"] == disc]
        s.append((disc,
                  round(100 * (sub["subjects.o"] == "students").mean(), 1),
                  round(100 * (sub["subjects.r"] == "students").mean(), 1)))
    sens[name] = s

print("\n=== SENSITIVITY: (discipline, %students original, %students replication) ===")
for k, v in sens.items():
    print(k, "->", v)

# --- 4. decision ---------------------------------------------------------------
# Reference percentages given in the research question: original 82.4%, replication 80.9%.
REF_O, REF_R = 82.4, 80.9
primary["dist_to_ref"] = ((primary["pct_students_o"] - REF_O) ** 2
                          + (primary["pct_students_r"] - REF_R) ** 2) ** 0.5
print(f"\ndistance to reference (o={REF_O}%, r={REF_R}%):")
print(primary[["discipline", "dist_to_ref"]].round(2).to_string(index=False))

both_majority = primary.loc[
    (primary["pct_students_o"] > 50) & (primary["pct_students_r"] > 50), "discipline"
].tolist()
winner = primary.sort_values("dist_to_ref").iloc[0]["discipline"]
print("\ndomains with majority students in BOTH:", both_majority)
print("domain whose student shares best match the reference figures:", winner)
assert winner == "Social", "expected Social"
print("ANSWER: Social")
