"""Final computation: proportion of ee original studies conducted in the United Kingdom."""
import pandas as pd

df1 = pd.read_csv('data/meta-regression_study_data_heterogeneity_in_replication_projects.csv', low_memory=False)
df2 = pd.read_csv('data/meta-regression_replication_success_data_heterogeneity_in_replication_projects.csv')

# Denominator: unique ee original studies (one row per id; verified no dups/missing)
ee = df1[df1['project'] == 'ee'].drop_duplicates(subset='id')
denom = len(ee)

# Numerator: exact string match 'United Kingdom'
uk_mask = ee['experiment_country.o'] == 'United Kingdom'
num = int(uk_mask.sum())

uk_studies = ee.loc[uk_mask, ['id', 'title', 'experiment_country.o']].to_dict('records')

print(f'Numerator (UK originals): {num}')
print(f'Denominator (ee originals): {denom}')
print(f'Proportion: {num}/{denom} = {num/denom:.4f} = {num/denom*100:.1f}%')
print('UK study record(s):', uk_studies)

# Sanity: no missing countries, no multi-country separators in ee
assert ee['experiment_country.o'].notna().all()
assert not ee['experiment_country.o'].str.contains(r'[,;&/]').any()

# Cross-check: File 2 EE rows should be 18, matching 1:1 with ee ids
ee2 = df2[df2['project'] == 'Experimental Economics']
print(f'\nCross-check: File2 Experimental Economics rows = {len(ee2)} (matches ee originals: {len(ee2) == denom})')

# Save tidy result
pd.DataFrame([{'project': 'ee', 'denominator': denom, 'uk_count': num,
               'proportion': num/denom, 'percent': num/denom*100,
               'uk_ids': '; '.join(s['id'] for s in uk_studies),
               'uk_titles': '; '.join(s['title'] for s in uk_studies)}]).to_csv('uk_proportion_result.csv', index=False)
