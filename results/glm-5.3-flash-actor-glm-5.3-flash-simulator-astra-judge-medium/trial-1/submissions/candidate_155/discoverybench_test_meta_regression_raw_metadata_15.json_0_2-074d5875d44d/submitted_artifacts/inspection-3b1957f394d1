"""Inspection-only script: dimensions, ee subset, country coding, duplicates. No final answer computed."""
import pandas as pd

df1 = pd.read_csv('data/meta-regression_study_data_heterogeneity_in_replication_projects.csv', low_memory=False)
df2 = pd.read_csv('data/meta-regression_replication_success_data_heterogeneity_in_replication_projects.csv')

print('File1 shape:', df1.shape)
print('File2 shape:', df2.shape)
print('File1 project counts:', df1['project'].value_counts(dropna=False).to_dict())
print('File2 project counts:', df2['project'].value_counts(dropna=False).to_dict())

ee = df1[df1['project'] == 'ee']
print('\nee rows:', len(ee), '| unique ids:', ee['id'].nunique())
print('experiment_country.o (ee):', ee['experiment_country.o'].value_counts(dropna=False).to_dict())
print('ee missing/blank country:', int(ee['experiment_country.o'].isna().sum()))

print('\nDistinct experiment_country.o in full file:', sorted(df1['experiment_country.o'].dropna().unique()))
print('File1 has experiment_country.o:', 'experiment_country.o' in df1.columns,
      '| File2 has it:', 'experiment_country.o' in df2.columns)

print('\nFull-file duplicate ids:', int(df1['id'].duplicated().sum()), '| unique ids:', df1['id'].nunique())
print('ee duplicate ids:', int(ee['id'].duplicated().sum()))
g = df1.groupby('id')['experiment_country.o'].nunique(dropna=False)
print('ids with inconsistent country across rows:', int((g > 1).sum()))
print('ee drop flags:', ee['drop'].value_counts(dropna=False).to_dict(),
      '| ee aggregated non-null:', int(ee['aggregated'].notna().sum()))
