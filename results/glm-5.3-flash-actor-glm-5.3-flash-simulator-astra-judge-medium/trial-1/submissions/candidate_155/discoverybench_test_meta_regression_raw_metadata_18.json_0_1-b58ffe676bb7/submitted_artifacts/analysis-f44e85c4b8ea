"""
Question: What proportion of studies in Experimental Economics were conducted in a lab setting?
Data: meta-regression study data (heterogeneity in replication projects).
Unit of analysis: unique O/R pair (id) in the ee (Experimental Economics) subset.
Lab setting inferred from online.o == 0 (online is the only setting proxy; no explicit lab/field column).
"""
import pandas as pd

CSV = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
df = pd.read_csv(CSV)
print(f"Full dataset: {df.shape[0]} rows, {df.shape[1]} cols")
print("Project counts:", df["project"].value_counts().to_dict())

# --- ee subset: unique O/R pairs, exclude flagged rows (none in ee) ---
ee = df[(df["project"] == "ee") & (~df["drop"].astype(bool))].copy()
n = ee["id"].nunique()
print(f"\nee subset: {len(ee)} rows, {n} unique O/R pair ids (study count)")
assert (ee.groupby("id").size() == 1).all(), "ee pairs are one-row-per-id"

# completeness of setting-relevant fields
for c in ["online.o", "online.r", "subjects.o", "subjects.r", "experiment_country.o"]:
    print(f"  {c}: missing {ee[c].isna().sum()}/{n}")

# --- primary rule: lab = original experiment conducted offline ---
lab_primary = (ee["online.o"] == 0)
# --- sensitivity checks ---
lab_replication = (ee["online.r"] == 0)
lab_either = (ee["online.o"] == 0) | (ee["online.r"] == 0)
strict_students = (ee["online.o"] == 0) & (ee["subjects.o"] == "students")

def prop(mask, label):
    k = int(mask.sum())
    print(f"{label}: {k}/{n} = {k/n*100:.1f}%")
    return k, n

print("\n--- Proportion conducted in a lab setting (ee project) ---")
k1, _ = prop(lab_primary, "PRIMARY  (online.o == 0)")
prop(lab_replication, "Sensitivity 1: replication side (online.r == 0)")
prop(lab_either, "Sensitivity 2: either O or R offline")
prop(strict_students, "Sensitivity 3: offline AND subjects.o == 'students' (strict)")

print("\nNon-student original-subject rows (strict-rule exceptions):")
print(ee.loc[ee["subjects.o"] != "students", ["id", "subjects.o", "online.o", "experiment_country.o"]].to_string(index=False))

print("\nSupporting counts (primary rule):")
print("  subjects.o:", ee["subjects.o"].value_counts().to_dict())
print("  subjects.r:", ee["subjects.r"].value_counts().to_dict())
print("  online.o  :", ee["online.o"].value_counts().to_dict())
print("  online.r  :", ee["online.r"].value_counts().to_dict())

print("\nRESULT: {} of {} Experimental Economics O/R study pairs ({}%) were conducted offline (lab setting).".format(k1, n, k1/n*100))
