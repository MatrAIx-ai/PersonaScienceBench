"""Average length of original papers: Experimental Economics (ee) vs Psychology (rpp).

Unit of analysis (approved): paper level = the single row per unique id with blank lab_id.
Main analysis keeps all 141 paper-level rows; sensitivity (a) drops drop==TRUE rows,
(b) deduplicates repeated titles within each project.
"""
import csv, collections, statistics as st

PATH = 'data/meta-regression_study_data_heterogeneity_in_replication_projects.csv'
rows = list(csv.DictReader(open(PATH)))

# paper-level rows: one per unique id (the row with blank lab_id)
byid = collections.defaultdict(list)
for r in rows:
    byid[r['id']].append(r)
paper_rows = [rs[0] for rs in ([x for x in rs if x['lab_id'].strip() == ''] for rs in byid.values())]

def desc(L):
    L = sorted(L)
    q = st.quantiles(L, n=4)  # Q1, Q2(median), Q3
    return dict(n=len(L), mean=round(st.mean(L), 2),
                sd=round(st.stdev(L), 2) if len(L) > 1 else None,
                median=round(st.median(L), 2), q1=q[0], q3=q[2],
                min=min(L), max=max(L))

def report(label, groups):
    print(f"\n=== {label} ===")
    out = {}
    for p in ('ee', 'rpp'):
        L = [int(r['length']) for r in groups[p]]
        out[p] = desc(L)
        print(p, out[p])
    d = out['ee']['mean'] - out['rpp']['mean']
    print(f"mean difference (ee - rpp) = {round(d,2)} pages "
          f"({round(d/out['rpp']['mean']*100,1)}% of rpp mean)")
    return out

# 1) main: all paper-level rows, unit = id
main = report('MAIN (unit = id, all 141 paper-level rows)',
              {p: [r for r in paper_rows if r['project'] == p] for p in ('ee', 'rpp')})

# 2) sensitivity: exclude drop == TRUE
nondrop = [r for r in paper_rows if r['drop'].strip().upper() != 'TRUE']
sens_drop = report('SENSITIVITY A: exclude drop==TRUE',
                   {p: [r for r in nondrop if r['project'] == p] for p in ('ee', 'rpp')})

# 3) sensitivity: deduplicate by title within project (keep first occurrence)
seen, dedup = set(), []
for r in paper_rows:
    key = (r['project'], r['title'].strip().lower())
    if key not in seen:
        seen.add(key); dedup.append(r)
sens_title = report('SENSITIVITY B: deduplicate repeated titles within project',
                    {p: [r for r in dedup if r['project'] == p] for p in ('ee', 'rpp')})

# background reference only
print("\n=== BACKGROUND (not part of answer) ===")
for p in ('ml1', 'ml3'):
    L = [int(r['length']) for r in paper_rows if r['project'] == p]
    print(p, desc(L))

# save results
with open('analysis/results.txt', 'w') as f:
    for label, res in [('MAIN', main), ('SENSITIVITY A (no drop)', sens_drop),
                       ('SENSITIVITY B (title-dedup)', sens_title)]:
        f.write(f"{label}\n")
        for p, d in res.items():
            f.write(f"  {p}: {d}\n")
