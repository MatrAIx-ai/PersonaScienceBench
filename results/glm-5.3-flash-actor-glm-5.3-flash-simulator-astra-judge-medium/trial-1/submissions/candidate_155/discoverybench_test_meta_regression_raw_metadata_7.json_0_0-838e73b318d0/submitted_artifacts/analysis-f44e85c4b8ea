"""
Question: In which domain (discipline: Social, Cognitive, Economics) do the majority
of authors tend to be male for BOTH original and replication studies?

Approved approach:
  A. One row per O/R pair: aggregated==True row for ml1/ml3, single row for rpp/ee.
  B. Primary: exclude drop==True pairs. Sensitivity: include them.
  C. Verify no missing authors_male.o/.r after dedup.
  D. Primary metric: share of pairs with authors_male.o>0.5 AND authors_male.r>0.5.
  E. Sensitivities: >=0.5 tie-inclusive threshold; mean-of-lab-rows authors_male.r for ml1/ml3.
  F. Dataset 2 not used (contains no authorship or discipline information).
"""
import pandas as pd

SRC = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
DISCIPLINES = ["Social", "Cognitive", "Economics"]

df = pd.read_csv(SRC)

# ---- A. one row per O/R pair -------------------------------------------------
agg_rows = df[df["aggregated"] == True]      # ml1/ml3 project-level replication rows
single_rows = df[df["aggregated"].isna()]    # rpp/ee: exactly one row per id
assert agg_rows["id"].is_unique and single_rows["id"].is_unique
dedup = pd.concat([agg_rows, single_rows], ignore_index=True)
assert dedup["id"].is_unique, "dedup must yield one row per O/R pair"
print(f"Dedup: {len(df)} raw rows -> {len(dedup)} O/R pairs "
      f"(ml1/ml3 aggregated: {len(agg_rows)}, rpp/ee single: {len(single_rows)})")
print("Pairs flagged drop==True in dedup set:", int(dedup['drop'].sum()))

# ---- C. missing-value check after dedup --------------------------------------
for col in ["authors_male.o", "authors_male.r"]:
    assert dedup[col].notna().all(), f"unexpected missing {col} after dedup"
print("Missing authors_male.o / authors_male.r after dedup: 0 / 0")

def summarise(data, thr, use_drop_filter, op, label):
    d = data[~data["drop"]] if use_drop_filter else data
    mo = op(d["authors_male.o"], thr)
    mr = op(d["authors_male.r"], thr)
    both = mo & mr
    rows = []
    for disc in DISCIPLINES:
        sub = (d["discipline"] == disc).to_numpy()
        rows.append({
            "scenario": label,
            "discipline": disc,
            "n_pairs": int(sub.sum()),
            "pct_original_majority_male": round(100 * mo.to_numpy()[sub].mean(), 1),
            "pct_replication_majority_male": round(100 * mr.to_numpy()[sub].mean(), 1),
            "pct_BOTH_majority_male": round(100 * both.to_numpy()[sub].mean(), 1),
            "mean_authors_male.o": round(d.loc[sub, "authors_male.o"].mean(), 3),
            "mean_authors_male.r": round(d.loc[sub, "authors_male.r"].mean(), 3),
        })
    return pd.DataFrame(rows)

gt = lambda s, t: s > t; gt.__name__ = "gt"
ge = lambda s, t: s >= t; ge.__name__ = "ge"

frames = [
    summarise(dedup, 0.5, True,  gt, "PRIMARY: excl drop, >0.5"),
    summarise(dedup, 0.5, False, gt, "sensitivity: incl drop, >0.5"),
    summarise(dedup, 0.5, True,  ge, "sensitivity: excl drop, >=0.5"),
    summarise(dedup, 0.5, False, ge, "sensitivity: incl drop, >=0.5"),
]
# mean-of-lab-rows alternative for ml1/ml3 replication authorship
lab_mean = df[~df["drop"]].groupby("id")["authors_male.r"].mean()
alt = dedup.copy()
alt["authors_male.r"] = alt["id"].map(lab_mean)
frames.append(summarise(alt, 0.5, True, gt, "sensitivity: mean-of-lab-rows, >0.5"))

results = pd.concat(frames, ignore_index=True)
print()
print(results.to_string(index=False))
results.to_csv("analysis/author_gender_by_discipline.csv", index=False)

print("\nHeadline ranking of pct_BOTH_majority_male per scenario:")
for scen, grp in results.groupby("scenario", sort=False):
    ranked = grp.sort_values("pct_BOTH_majority_male", ascending=False)
    winner = ranked.iloc[0]["discipline"]
    print(f"  {scen}: " + ", ".join(f"{r.discipline}={r.pct_BOTH_majority_male}% (n={r.n_pairs})" for r in ranked.itertuples())
          + f"  -> winner: {winner}")
