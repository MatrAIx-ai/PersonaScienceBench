"""Median wealth in 1985 among individuals ever jailed (1985-1994), by race/sex."""
import pandas as pd

df = pd.read_csv('data/nls_incarceration_processed.csv')
W = 'composite_wealth_1985'

# Reference: full-sample and ever_jailed=0 medians
print('=== Background reference ===')
for label, d in [('full sample', df), ('ever_jailed=0', df[df.ever_jailed == 0]),
                 ('ever_jailed=1', df[df.ever_jailed == 1])]:
    print(f"{label}: n={len(d)}, median={d[W].median():.0f}, "
          f"Q1={d[W].quantile(.25):.0f}, Q3={d[W].quantile(.75):.0f}, "
          f"IQR={d[W].quantile(.75)-d[W].quantile(.25):.0f}, mean={d[W].mean():.0f}")

# Main analysis: ever_jailed=1, cross groups
sub = df[df.ever_jailed == 1].copy()

def stats(g):
    return pd.Series({
        'n': len(g),
        'median': g[W].median(),
        'Q1': g[W].quantile(.25),
        'Q3': g[W].quantile(.75),
        'IQR': g[W].quantile(.75) - g[W].quantile(.25),
        'mean': g[W].mean(),
        'median_pos': g.loc[g[W] > 0, W].median(),   # sensitivity: drop negatives (and zeros)
        'pct_le0': (g[W] <= 0).mean() * 100,
    })

print('\n=== Main: ever_jailed=1, race x sex cross groups ===')
cross = sub.groupby(['race', 'sex']).apply(stats, include_groups=False)
print(cross.round(1).to_string())

print('\n=== Single-variable groupings (ever_jailed=1) ===')
print('By race:'); print(sub.groupby('race').apply(stats, include_groups=False).round(1).to_string())
print('By sex:'); print(sub.groupby('sex').apply(stats, include_groups=False).round(1).to_string())

print('\n=== ever_jailed=0 comparison medians by race and sex (descriptive) ===')
z = df[df.ever_jailed == 0]
print('By race:'); print(z.groupby('race')[W].agg(['count', 'median', 'mean']).round(1).to_string())
print('By sex:'); print(z.groupby('sex')[W].agg(['count', 'median', 'mean']).round(1).to_string())

print('\n=== Sensitivity: ever_jailed=1 medians excluding wealth <= 0 ===')
pos = sub[sub[W] > 0]
print('By race:'); print(pos.groupby('race')[W].agg(['count', 'median', 'mean']).round(1).to_string())
print('By sex:'); print(pos.groupby('sex')[W].agg(['count', 'median', 'mean']).round(1).to_string())

cross.round(1).to_csv('median_wealth_1985_ever_jailed_cross.csv')
