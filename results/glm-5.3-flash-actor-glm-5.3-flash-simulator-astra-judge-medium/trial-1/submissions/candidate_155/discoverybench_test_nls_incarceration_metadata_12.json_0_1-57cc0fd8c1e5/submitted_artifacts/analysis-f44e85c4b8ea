"""
NLSY79 incarceration & wealth — black respondents by baseline wealth tier.
Primary sample: race=='black', deduplicated (one row per respondent).
Outcomes: d_late = w1996-w1990 (post-window), d_total = w1996-w1985.
Stratifier: baseline (1985) composite wealth tiers as proxy for income tiers.
"""
import pandas as pd
import numpy as np
import statsmodels.formula.api as smf

COLS = ['composite_wealth_1985','composite_wealth_1990','composite_wealth_1996']

def signed_log(x):
    return np.sign(x) * np.log1p(np.abs(x))

def build(df):
    d = df.copy()
    d['d_early'] = d['composite_wealth_1990'] - d['composite_wealth_1985']
    d['d_late']  = d['composite_wealth_1996'] - d['composite_wealth_1990']
    d['d_total'] = d['composite_wealth_1996'] - d['composite_wealth_1985']
    d['sl_total'] = signed_log(d['d_total'])
    return d

def assign_tiers(d, q1, q2, q3):
    # tier cutpoints passed in (computed once on primary sample) for comparability
    def t(w):
        if w <= 0: return 0
        if w <= q1: return 1
        if w <= q2: return 2
        return 3
    return d['composite_wealth_1985'].map(t)

def tier_table(d, label):
    rows = []
    for tier in sorted(d['tier'].unique()):
        for j in [0,1]:
            s = d[(d.tier==tier)&(d.ever_jailed==j)]
            if len(s)==0: continue
            rows.append({
                'sample': label, 'tier': tier, 'ever_jailed': j, 'n': len(s),
                'w1985_med': s['composite_wealth_1985'].median(),
                'w1990_med': s['composite_wealth_1990'].median(),
                'w1996_med': s['composite_wealth_1996'].median(),
                'd_late_med': s['d_late'].median(),
                'd_total_med': s['d_total'].median(),
                'd_total_mean': s['d_total'].mean(),
                'pct_w1996_le0': (s['composite_wealth_1996']<=0).mean(),
                'pct_w1996_le_w1985': (s['d_total']<=0).mean(),
            })
    return pd.DataFrame(rows)

def run(sample_df, label, cutpoints):
    d = build(sample_df)
    d['tier'] = assign_tiers(d, *cutpoints)
    print(f"\n{'='*80}\nSAMPLE: {label}  (n={len(d)}, jailed={d.ever_jailed.sum()})")
    print("tier counts by jailed status:")
    print(pd.crosstab(d['tier'], d['ever_jailed']))
    tt = tier_table(d, label)
    print("\n-- Median trajectory & deltas by tier x jailed --")
    print(tt.round(1).to_string(index=False))
    # regression: d_total ~ tier * jailed + sex (where both sexes present)
    forms = ["d_total ~ C(tier, Treatment(reference=0)) + ever_jailed:C(tier, Treatment(reference=0))"]
    if d['sex'].nunique() > 1:
        forms[0] += " + C(sex)"
    # signed-log outcome too
    for y, f in [('d_total', forms[0]), ('sl_total', forms[0].replace('d_total','sl_total'))]:
        m = smf.ols(f, data=d).fit(cov_type='HC3')
        print(f"\n-- OLS (HC3): {y} ~ tier * ever_jailed{' + sex' if d['sex'].nunique()>1 else ''} --")
        key = [k for k in m.params.index if 'ever_jailed' in k]
        print(f"R2={m.rsquared:.3f}, n={int(m.nobs)}")
        print(m.params[key].round(1).to_string())
        print("p-values:"); print(m.pvalues[key].round(4).to_string())
    return tt, d

