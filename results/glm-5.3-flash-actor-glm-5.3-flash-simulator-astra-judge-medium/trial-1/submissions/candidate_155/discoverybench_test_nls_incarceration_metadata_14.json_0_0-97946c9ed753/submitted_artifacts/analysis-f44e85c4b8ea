import pandas as pd
import numpy as np

df = pd.read_csv('data/nls_incarceration_processed.csv')
years = ['1985', '1990', '1996']
cols = [f'composite_wealth_{y}' for y in years]

def q(s, p): return s.quantile(p)

print('='*70)
print('TABLE 1: Black females (n) median, IQR per year (raw, negatives kept)')
bf = df[(df.race=='black') & (df.sex=='female')]
for c in cols:
    print(f"{c}: n={len(bf)}, median={bf[c].median():.0f}, Q1={q(bf[c],.25):.0f}, Q3={q(bf[c],.75):.0f}")

print()
print('='*70)
print('TABLE 2: All six race x sex groups, median per year + adjacent-year deltas')
rows = []
for (r, s), g in df.groupby(['race','sex']):
    med = {c: g[c].median() for c in cols}
    rows.append({
        'group': f'{r}_{s}', 'n': len(g),
        'med1985': med[cols[0]], 'med1990': med[cols[1]], 'med1996': med[cols[2]],
        'd85_90': med[cols[1]]-med[cols[0]],
        'd90_96': med[cols[2]]-med[cols[1]],
        'd85_96': med[cols[2]]-med[cols[0]],
        'pct85_90': 100*(med[cols[1]]-med[cols[0]])/abs(med[cols[0]]) if med[cols[0]]!=0 else np.nan,
        'pct90_96': 100*(med[cols[2]]-med[cols[1]])/abs(med[cols[1]]) if med[cols[1]]!=0 else np.nan,
    })
t2 = pd.DataFrame(rows)
print(t2.round(1).to_string(index=False))

print()
print('='*70)
print('TABLE 3: Black female sensitivity - winsorize at p99 (keep negatives)')
for c in cols:
    p99 = bf[c].quantile(.99)
    w = bf[c].clip(upper=p99)
    print(f"{c}: raw median={bf[c].median():.0f} | p99-capped median={w.median():.0f} | p99={p99:.0f}")

print()
print('='*70)
print('TABLE 4: Sensitivity - negatives truncated to 0 (all groups)')
rows = []
for (r, s), g in df.groupby(['race','sex']):
    med0 = {c: g[c].clip(lower=0).median() for c in cols}
    rows.append({'group': f'{r}_{s}', 'n': len(g),
        'med1985_z': med0[cols[0]], 'med1990_z': med0[cols[1]], 'med1996_z': med0[cols[2]],
        'd85_90_z': med0[cols[1]]-med0[cols[0]], 'd90_96_z': med0[cols[2]]-med0[cols[1]],
        'd85_96_z': med0[cols[2]]-med0[cols[0]]})
t4 = pd.DataFrame(rows)
print(t4.round(1).to_string(index=False))

print()
print('Black female medians raw vs zero-truncated:')
for c in cols:
    print(f"{c}: raw={bf[c].median():.0f}, zero-truncated={bf[c].clip(lower=0).median():.0f}")
