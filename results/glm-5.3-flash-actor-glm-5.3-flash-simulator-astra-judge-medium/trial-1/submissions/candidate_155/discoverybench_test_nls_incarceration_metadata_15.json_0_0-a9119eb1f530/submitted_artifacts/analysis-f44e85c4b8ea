"""
Wealth inequality change for white males and white females, NLSY79, 1990 vs 1996.
Outputs: console report + output/wealth_inequality_results.csv + output/gini_sensitivity.csv
"""
import pandas as pd
import numpy as np

OUT = "output"
df = pd.read_csv("data/nls_incarceration_processed.csv")

def gini(x):
    """Gini coefficient allowing negative values (standard mean-absolute-difference formula)."""
    x = np.asarray(x, dtype=float)
    if len(x) == 0:
        return np.nan
    mad = np.mean(np.abs(x[:, None] - x[None, :])) / 2.0
    mu = np.mean(x)
    if mu == 0:
        return np.nan
    return mad / abs(mu)

def gini_truncated(x):
    """Gini after truncating negatives to zero (sensitivity)."""
    return gini(np.maximum(np.asarray(x, dtype=float), 0))

def quant_stats(x):
    x = np.asarray(x, dtype=float)
    q10, q50, q90, q99 = np.percentile(x, [10, 50, 90, 99])
    q01, q25, q75 = np.percentile(x, [1, 25, 75])
    mu = x.mean()
    p90p10 = q90 / q10 if q10 > 0 else np.nan
    p90p50 = q90 / q50 if q50 > 0 else np.nan
    return dict(n=len(x), mean=mu, median=q50, p1=q01, p25=q25, p50=q50,
                p75=q75, p90=q90, p99=q99, p90p10=p90p10, p90p50=p90p50,
                mean_over_median=mu / q50 if q50 > 0 else np.nan,
                pct_zero=np.mean(x == 0) * 100, pct_neg=np.mean(x < 0) * 100)

def winsorize(x, lo=1, hi=99):
    x = np.asarray(x, dtype=float).copy()
    a, b = np.percentile(x, [lo, hi])
    return np.clip(x, a, b)

def prep(x, mode):
    x = np.asarray(x, dtype=float).copy()
    if mode == "raw":
        return x
    if mode == "trim3m":          # drop |wealth| > 3,000,000
        return x[np.abs(x) <= 3_000_000]
    if mode == "winsor":          # winsorize at 1%/99%
        return winsorize(x)
    if mode == "nozeros":         # drop exact zeros (sensitivity for 1996 spike)
        return x[x != 0]
    if mode == "nonneg":          # truncate negatives to zero (Gini only)
        return np.maximum(x, 0)
    raise ValueError(mode)

MODES = ["raw", "trim3m", "winsor", "nozeros"]
rows = []
for sex in ["male", "female"]:
    for year in ["1990", "1996"]:
        base = df[(df.race == "white") & (df.sex == sex)][f"composite_wealth_{year}"]
        for mode in MODES:
            x = prep(base, mode)
            st = quant_stats(x)
            st.update(sex=sex, year=year, variant=mode, gini=gini(x), gini_nonneg=gini_truncated(x))
            rows.append(st)

res = pd.DataFrame(rows)
cols = ["sex", "year", "variant", "n", "mean", "median", "p25", "p50", "p75", "p90", "p99",
        "p90p10", "p90p50", "mean_over_median", "gini", "gini_nonneg", "pct_zero", "pct_neg"]
res[cols].to_csv(f"{OUT}/wealth_inequality_results.csv", index=False)
pd.set_option("display.width", 220, "display.max_columns", 30, "display.float_format", lambda v: f"{v:,.2f}")
print("=== Main table: white respondents, raw (nominal) values ===")
print(res[res.variant == "raw"][cols].to_string(index=False))
print()
print("=== Sensitivity variants (1990 and 1996) ===")
print(res[res.variant != "raw"][cols].to_string(index=False))

# ---- between-sex gap (male minus female) for each variant/year ----
print()
print("=== Between-sex gaps (male - female), nominal ===")
gap_rows = []
for mode in MODES:
    for year in ["1990", "1996"]:
        m = res[(res.sex == "male") & (res.year == year) & (res.variant == mode)].iloc[0]
        f = res[(res.sex == "female") & (res.year == year) & (res.variant == mode)].iloc[0]
        gap_rows.append(dict(variant=mode, year=year,
                             median_gap=m["median"] - f["median"],
                             mean_gap=m["mean"] - f["mean"],
                             mean_ratio=m["mean"] / f["mean"],
                             gini_gap=m["gini"] - f["gini"],
                             p90p10_gap=(m["p90p10"] if pd.notna(m["p90p10"]) else np.nan)
                                        - (f["p90p10"] if pd.notna(f["p90p10"]) else np.nan)))
gaps = pd.DataFrame(gap_rows)
gaps.to_csv(f"{OUT}/between_sex_gaps.csv", index=False)
print(gaps.to_string(index=False))

# ---- bootstrap CIs for gini change 1990->1996 within each sex (raw) ----
rng = np.random.default_rng(42)
print()
print("=== Bootstrap 95% CI for Gini (raw), and for the 1996-1990 change ===")
for sex in ["male", "female"]:
    for year in ["1990", "1996"]:
        x = df[(df.race == "white") & (df.sex == sex)][f"composite_wealth_{year}"].values
        bs = np.array([gini(rng.choice(x, len(x), replace=True)) for _ in range(1000)])
        print(f"{sex} {year}: gini={gini(x):.4f}  CI=[{np.percentile(bs,2.5):.4f},{np.percentile(bs,97.5):.4f}]")
    x90 = df[(df.race == "white") & (df.sex == sex)]["composite_wealth_1990"].values
    x96 = df[(df.race == "white") & (df.sex == sex)]["composite_wealth_1996"].values
    n = min(len(x90), len(x96))
    d = []
    for _ in range(1000):
        i = rng.integers(0, len(x90), n); j = rng.integers(0, len(x96), n)
        d.append(gini(x96[j]) - gini(x90[i]))
    lo, hi = np.percentile(d, [2.5, 97.5])
    print(f"{sex}: change in gini (1996-1990) = {gini(x96)-gini(x90):+.4f}  CI=[{lo:+.4f},{hi:+.4f}]"
          f"  -> {'significant' if lo*hi>0 else 'not significant at 95%'}")
