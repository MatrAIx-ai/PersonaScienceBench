"""Supplement: P90/P25 (bottom-heavy zeros make P90/P10 undefined), zero/negative shares,
and quantile-level changes 1990->1996 for white males/females."""
import pandas as pd, numpy as np
df = pd.read_csv("data/nls_incarceration_processed.csv")

for sex in ["male", "female"]:
    print(f"--- white {sex} ---")
    for year in ["1990", "1996"]:
        x = df[(df.race=="white") & (df.sex==sex)][f"composite_wealth_{year}"].values.astype(float)
        p10,p25,p50,p75,p90,p99 = np.percentile(x,[10,25,50,75,90,99])
        print(f"{year}: p10={p10:,.0f} p25={p25:,.0f} p50={p50:,.0f} p75={p75:,.0f} "
              f"p90={p90:,.0f} p99={p99:,.0f}  P90/P25={p90/p25 if p25>0 else np.nan:,.2f}  "
              f"zero%={100*(x==0).mean():.1f}  neg%={100*(x<0).mean():.1f}  "
              f"bottom25%sum_share={'n/a'}")
# top share (share of total wealth held by top 10% / top 1%), raw
print()
print("Top wealth shares (raw):")
for sex in ["male","female"]:
    for year in ["1990","1996"]:
        x = df[(df.race=="white") & (df.sex==sex)][f"composite_wealth_{year}"].values.astype(float)
        xs = np.sort(x)
        # share held by top 10% and top 1% (net of negatives: shares can exceed 1 with negative wealth)
        tot = xs.sum()
        top10 = xs[int(0.9*len(xs)):].sum()/tot
        top1  = xs[int(0.99*len(xs)):].sum()/tot
        print(f"white {sex} {year}: top10% share={top10:.3f}  top1% share={top1:.3f}")
