# -*- coding: utf-8 -*-
"""
Analysis: NLSY79 incarceration vs wealth (1985, 1990, 1996)
Question: In which years were individuals with a criminal record (ever_jailed=1,
jailed between 1985-1994) found to have significantly lower wealth than those without?
"""
import numpy as np
import pandas as pd
from scipy import stats

DATA = "data/nls_incarceration_processed.csv"
YEARS = ["1985", "1990", "1996"]
COLS = [f"composite_wealth_{y}" for y in YEARS]

def tests(df, label):
    print(f"\n{'='*70}\n{label}  (n={len(df)})\n{'='*70}")
    rows = []
    for y, c in zip(YEARS, COLS):
        g0 = df.loc[df.ever_jailed == 0, c].astype(float)
        g1 = df.loc[df.ever_jailed == 1, c].astype(float)
        l0 = np.log1p(g0.clip(lower=0))
        l1 = np.log1p(g1.clip(lower=0))
        tw = stats.ttest_ind(g0, g1, equal_var=False)
        tl = stats.ttest_ind(l0, l1, equal_var=False)
        mu = stats.mannwhitneyu(g0, g1, alternative="two-sided")
        rows.append(dict(
            year=y,
            mean_j0=g0.mean(), median_j0=g0.median(), sd_j0=g0.std(),
            mean_j1=g1.mean(), median_j1=g1.median(), sd_j1=g1.std(),
            mean_diff=g0.mean() - g1.mean(),
            median_diff=g0.median() - g1.median(),
            pct_median_diff=(g0.median() - g1.median()) / max(abs(g0.median()), 1) * 100,
            welch_t=tw.statistic, welch_p=tw.pvalue,
            log_t=tl.statistic, log_p=tl.pvalue,
            mwu_p=mu.pvalue,
            sig=(tw.pvalue < .05 and tl.pvalue < .05 and mu.pvalue < .05),
        ))
    out = pd.DataFrame(rows)
    def fmt_p(p):
        return f"{p:.3g}" if p >= 1e-4 else f"{p:.2e}"
    print(out.to_string(index=False, float_format=lambda x: f"{x:,.4g}"))
    print("\nPer-year detail:")
    for r in rows:
        print(f"\n--- {r['year']} ---")
        print(f"  no-jail (n={int((df.ever_jailed==0).sum())}): mean=${r['mean_j0']:,.0f}  median=${r['median_j0']:,.0f}  sd=${r['sd_j0']:,.0f}")
        print(f"  jail    (n={int((df.ever_jailed==1).sum())}): mean=${r['mean_j1']:,.0f}  median=${r['median_j1']:,.0f}  sd=${r['sd_j1']:,.0f}")
        print(f"  mean diff (no-jail minus jail) = ${r['mean_diff']:,.0f}")
        print(f"  median diff                    = ${r['median_diff']:,.0f}")
        print(f"  (a) Welch t (raw)   : t={r['welch_t']:.2f}, p={fmt_p(r['welch_p'])}")
        print(f"  (b) Welch t (log1p) : t={r['log_t']:.2f}, p={fmt_p(r['log_p'])}")
        print(f"  (c) Mann-Whitney U  : p={fmt_p(r['mwu_p'])}")
        print(f"  All three tests significant at alpha=0.05: {r['sig']}")
    return out

df = pd.read_csv(DATA)
print(f"Loaded {df.shape[0]} rows, {df.shape[1]} cols; missing values: {int(df.isna().sum().sum())}")

# ---------- 1. Main analysis: full data ----------
main = tests(df, "MAIN ANALYSIS - FULL DATA")

# ---------- 2. Sensitivity: drop duplicate rows ----------
dedup = df.drop_duplicates()
print(f"\nDedup: {len(df)} -> {len(dedup)} rows ({len(df)-len(dedup)} duplicates removed)")
print("Jailed group after dedup:", int((dedup.ever_jailed == 1).sum()))
sens = tests(dedup, "SENSITIVITY - DEDUPLICATED DATA")

print("\n=== Consistency check (full vs dedup) ===")
cmp = pd.DataFrame({
    "year": YEARS,
    "welch_p_full": main.welch_p.values, "welch_p_dedup": sens.welch_p.values,
    "log_p_full": main.log_p.values, "log_p_dedup": sens.log_p.values,
    "mwu_p_full": main.mwu_p.values, "mwu_p_dedup": sens.mwu_p.values,
})
cmp["same_conclusion"] = (main.sig.values == sens.sig.values)
print(cmp.to_string(index=False, float_format=lambda x: f"{x:,.3g}"))

# ---------- 3. Stratified by race and sex ----------
print("\n" + "="*70 + "\nSTRATIFIED ANALYSIS (full data)\n" + "="*70)
for var in ["race", "sex"]:
    print(f"\n### Stratified by {var} ###")
    for level in df[var].unique():
        sub = df[df[var] == level]
        n1, n0 = int((sub.ever_jailed == 1).sum()), int((sub.ever_jailed == 0).sum())
        print(f"\n-- {var} = {level}  (jail n={n1}, no-jail n={n0}) --")
        if n1 < 10:
            print("   Jail subgroup n < 10: descriptive only.")
        for y, c in zip(YEARS, COLS):
            g0 = sub.loc[sub.ever_jailed == 0, c].astype(float)
            g1 = sub.loc[sub.ever_jailed == 1, c].astype(float)
            if n1 >= 2:
                mu = stats.mannwhitneyu(g0, g1, alternative="two-sided")
                tw = stats.ttest_ind(g0, g1, equal_var=False)
                print(f"   {y}: jail mean=${g1.mean():,.0f} median=${g1.median():,.0f} | "
                      f"no-jail mean=${g0.mean():,.0f} median=${g0.median():,.0f} | "
                      f"diff(mean)=${g0.mean()-g1.mean():,.0f} | Welch p={tw.pvalue:.3g} | MWU p={mu.pvalue:.3g}")
            else:
                print(f"   {y}: jail mean=${g1.mean():,.0f} median=${g1.median():,.0f} | "
                      f"no-jail mean=${g0.mean():,.0f} median=${g0.median():,.0f} (test not run, n1<2)")

# Save result tables
main.to_csv("outputs/main_results.csv", index=False)
sens.to_csv("outputs/dedup_sensitivity_results.csv", index=False)
df.to_csv("outputs/data_with_log_columns.csv", index=False)
print("\nSaved outputs/main_results.csv, outputs/dedup_sensitivity_results.csv")
