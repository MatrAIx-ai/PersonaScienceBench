# -*- coding: utf-8 -*-
"""
NLSY79: How does consideration of academic characteristics alter the effects of
SES and race on BA (early college-entry) completion?
Outcome is a structural proxy: highest grade completed by 1979 >= 13 (primary),
>= 16 (sensitivity, n=39). No post-1979 education/degree records exist in data.
"""
import numpy as np, pandas as pd, statsmodels.api as sm, json, warnings
from statsmodels.imputation.mice import MICE, MICEData
warnings.filterwarnings("ignore")

RAW = "/workspace/data/nls_raw.csv"
C_MOTH = "Highest grade completed by respondent's mother, 1979"
C_FATH = "Highest grade completed by respondent's father, 1979"
C_EDU  = "Highest grade completed, 1979"
C_RACE = "Racial/ethnic cohort, 1979"
C_SEX  = "Sex of respondent, 1979"
C_FAM  = "Family size, 1979"
C_INC  = "Total net family income, previous calendar year, 1979"
C_RANK = "Rank in class last year attended at this school, 1981"
C_NSTU = "Number of students in class last year attended at this school, 1981"
C_AGE79= "Age of respondent, 1979"
ASVAB  = [c for c in pd.read_csv(RAW, nrows=0).columns if "ASVAB" in c]

df = pd.read_csv(RAW)
ren = {C_MOTH:"moth_edu", C_FATH:"fath_edu", C_EDU:"edu79", C_RACE:"race", C_SEX:"sex",
       C_FAM:"famsize", C_INC:"inc78", C_RANK:"rank", C_NSTU:"nstu", C_AGE79:"age79"}
asv_map = {}
for c in df.columns:
    if "ASVAB" in c:
        asv_map[c] = "asvab_" + c.split(" - ")[1].split(" Z")[0].strip().replace(" ","_").lower()
ren.update(asv_map)
df = df.rename(columns=ren)
ASV = list(asv_map.values())

# ---- clean ----
df.loc[df.edu79 >= 90, "edu79"] = np.nan          # 95 = missing code
df["female"] = (df.sex == 2).astype(int)
df["black"]  = (df.race == 1).astype(int)
df["hisp"]   = (df.race == 2).astype(int)
df["ln_inc"] = np.log1p(df.inc78.clip(lower=0))

# SES components (standardized); family size reversed
for c in ["moth_edu","fath_edu"]:
    df[c+"_z"] = (df[c]-df[c].mean())/df[c].std()
df["ln_inc_z"] = (df.ln_inc-df.ln_inc.mean())/df.ln_inc.std()
df["famsize_rz"] = -((df.famsize-df.famsize.mean())/df.famsize.std())

# SES index: mean of available standardized components (>=2 required)
comp = df[["moth_edu_z","fath_edu_z","ln_inc_z","famsize_rz"]]
df["ses_n"] = comp.notna().sum(axis=1)
df["ses"] = comp.mean(axis=1).where(df.ses_n>=2)

# academic characteristics
for a in ASV: df[a+"_z"] = (df[a]-df[a].mean())/df[a].std()
df["asvab_mean_z"] = df[[a+"_z" for a in ASV]].mean(axis=1).where(df[ASV].notna().all(axis=1))
df["rank_pct"] = 1 - df["rank"]/df["nstu"]
df["rank_pct_z"] = (df["rank_pct"]-df["rank_pct"].mean())/df["rank_pct"].std()

# outcomes
df["y13"] = (df.edu79 >= 13).astype(float).where(df.edu79.notna())
df["y16"] = (df.edu79 >= 16).astype(float).where(df.edu79.notna())

print("=== N =", len(df), "===")
print("y13 events:", int(df.y13.sum()), " y16 events:", int(df.y16.sum()))

# ---- missingness by race (mechanism probe) ----
miss_vars = {"inc78":"income78","asvab_mean_z":"ASVAB","rank_pct":"class_rank",
             "moth_edu":"mother_edu","fath_edu":"father_edu"}
tab = pd.DataFrame({v: df.groupby("race")[k].apply(lambda s: s.isna().mean()*100).round(1)
                    for k,v in miss_vars.items()})
tab.index = ["Black","Hispanic","NonBlack/Hisp"]
print("\n=== Missing % by race ==="); print(tab.to_string())

def logit(y, X):
    d = pd.concat([y, X], axis=1).dropna()
    m = sm.Logit(d.iloc[:,0], sm.add_constant(d.iloc[:,1:])).fit(disp=0)
    return m, d

def std_beta(m, d):
    # standardized (x-standardized) coefficients: b * sd_x  (binary y: b*sd_x/1.81 approx via y sd)
    out = {}
    for k in m.params.index:
        if k == "const": continue
        out[k] = m.params[k]*d[k].std()
    return out

def run_model(yname, Xcols, label, data=None):
    data = df if data is None else data
    m, d = logit(data[yname], data[Xcols])
    sb = std_beta(m, d)
    print(f"\n--- {label}  (n={len(d)}, events={int(d[yname].sum())}) ---")
    for k in m.params.index:
        if k=="const": continue
        print(f"  {k:22s} b={m.params[k]: .4f}  OR={np.exp(m.params[k]): .3f} "
              f"p={m.pvalues[k]:.4f}  std_b={sb.get(k,np.nan): .4f}")
    return m, d, sb

CORE = ["ses","black","hisp","female","age79"]
ACAD = ["asvab_mean_z","rank_pct_z"]

# age >=17 restriction
main = df[df.age79>=17].copy()
print("\nMain sample (age>=17):", len(main))

# full-model complete-case sample (has rank)
sub_rank = main.dropna(subset=CORE+ACAD+["y13"])
print("Complete-case incl. rank:", len(sub_rank))

results = {}
# Stage 1/2 on main complete cases (no rank needed)
s_main = main.dropna(subset=CORE+["y13"])
print("Complete cases main sample (no rank):", len(s_main))
m1,d1,sb1 = run_model("y13", CORE, "M1 baseline: SES+race (no academics), main sample", s_main)
m2,d2,sb2 = run_model("y13", CORE+["asvab_mean_z"], "M2: + ASVAB, main sample", s_main)
# Stage 3 comparison on identical rank-subsample
s_r = sub_rank
m1r,d1r,sb1r = run_model("y13", CORE, "M1-r baseline re-run on rank subsample", s_r)
m2r,d2r,sb2r = run_model("y13", CORE+["asvab_mean_z"], "M2-r: + ASVAB on rank subsample", s_r)
m3,d3,sb3  = run_model("y13", CORE+ACAD, "M3: + ASVAB + class-rank percentile, rank subsample", s_r)

def atten(b_base, b_full):
    return 100*(b_base-b_full)/b_base

print("\n=== Coefficient attenuation (% of baseline coefficient absorbed) ===")
rows=[]
for k in ["ses","black","hisp"]:
    rows.append([k, atten(sb1[k], sb2[k]), atten(sb1r[k], sb2r[k]), atten(sb1r[k], sb3[k]), atten(sb2r[k], sb3[k])])
att = pd.DataFrame(rows, columns=["var","base->+ASVAB (main n)","base->+ASVAB (rank n)",
                                  "base->+ASVAB+rank (rank n)","ASVAB-only->+rank (rank n)"])
print(att.round(1).to_string(index=False))

# KHB-style: residualized academic vars to check scale comparability (simple version):
# report discrete change in predicted P for SES sd shift and race dummy under M1r vs M3
def ame(m, d, k):
    X = sm.add_constant(d[m.params.index.drop("const")])
    p0 = m.predict(X); Xk = X.copy(); Xk[k] = Xk[k] + (d[k].std() if k!="black" and k!="hisp" else 1)
    p1 = m.predict(Xk)
    return (p1-p0).mean()
print("\n=== Average marginal change (probability points) ===")
for k in ["ses","black","hisp"]:
    a1, a3 = ame(m1r,d1r,k), ame(m3,d3,k)
    print(f"  {k:6s} M1r={a1:+.4f}  M3={a3:+.4f}  ratio retained={a3/a1:.2f}")

# robustness: by-race subsample SES effect, interaction, y16, MI
print("\n=== By-race SES effect (M1 spec, main sample) ===")
for r,lab in [(1,"Black"),(2,"Hispanic"),(3,"NonBlack")]:
    sub = s_main[s_main.race==r]
    if sub.y13.nunique()<2: print(lab,"insufficient variation"); continue
    mm,_ = logit(sub["y13"], sub[["ses","female","age79"]])
    print(f"  {lab:9s} b_ses={mm.params['ses']: .4f} (p={mm.pvalues['ses']:.4f}, n={len(sub)})")

s_main2 = s_main.copy(); s_main2["ses_x_black"]=s_main2.ses*s_main2.black
mi,_ = logit(s_main2["y13"], s_main2[CORE+["ses_x_black"]])
print(f"\nInteraction ses x black: b={mi.params['ses_x_black']:.4f} (p={mi.pvalues['ses_x_black']:.4f})")

# y16 sensitivity on same samples
print("\n=== Sensitivity: outcome >=16 (BA proxy, rare) ===")
s16 = main.dropna(subset=CORE+["y16"])
m16a,_,_ = run_model("y16", CORE, "M1 y16 baseline (no academics)", s16)
s16r = main.dropna(subset=CORE+ACAD+["y16"])
if s16r.y16.nunique()>1:
    m16b,_,_ = run_model("y16", CORE+ACAD, "M3 y16 with academics", s16r)
else:
    print("  y16 with academics: <2 outcome classes in complete cases; not estimable")

# Multiple imputation (MICE) for main-sample models M1 vs M2
print("\n=== MICE multiple imputation (5 imputations), main sample ===")
mi_vars = CORE+["asvab_mean_z","y13","moth_edu","fath_edu","ln_inc","famsize"]
dat = main[mi_vars].drop(columns=[]).copy()
mice = MICEData(dat, perturbation_method="boot")
bts=[]; ses_list=[]
mice.update_all()   # first pass fills all missing
for i in range(4):
    mice.update_all()
    X = sm.add_constant(mice.data[["ses","black","hisp","female","age79"]])
    Xa = sm.add_constant(mice.data[["ses","black","hisp","female","age79","asvab_mean_z"]])
    y = mice.data["y13"].round()
    mB = sm.Logit(y,X).fit(disp=0); mA = sm.Logit(y,Xa).fit(disp=0)
    bts.append(mB.params); ses_list.append(mA.params)
B = pd.concat(bts,axis=1).mean(axis=1); A = pd.concat(ses_list,axis=1).mean(axis=1)
print("MI pooled (baseline -> +ASVAB) standardized-coef attenuation:")
sdb = {k: B[k]*df[k].std() for k in B.index if k!="const"}
sda = {k: A[k]*df[k].std() for k in A.index if k!="const"}
for k in ["ses","black","hisp"]:
    print(f"  {k:6s} std_b: {sdb[k]:.4f} -> {sda[k]:.4f}  attenuation {100*(sdb[k]-sda[k])/sdb[k]:.1f}%")

print("\nDone.")
