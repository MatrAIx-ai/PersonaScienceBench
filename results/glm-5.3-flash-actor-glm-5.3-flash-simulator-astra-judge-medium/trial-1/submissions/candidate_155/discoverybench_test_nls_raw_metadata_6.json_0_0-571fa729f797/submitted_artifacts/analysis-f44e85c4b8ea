"""
DiscoveryBench task: How is the advantage in BA degree completion rates for Black
students related to Socioeconomic status levels?

Data: NLSY79 extract (nls_raw.csv), 12,686 respondents; education measured as of 1979
(respondents aged 14-22 in 1979 => attainment-as-of-1979, right-censored).

Approved design:
- Primary outcome: Highest grade completed 1979 >= 16 (BA proxy); code 95 -> missing.
  Secondary (equal footing): >= 13 (any postsecondary exposure) and >= 17.
- Primary contrast: Black (cohort 1) vs non-Black non-Hispanic (cohort 3);
  Hispanic (cohort 2) reported descriptively only.
- SES: family-of-origin composite = mean of available z-scored components
  (>=2 of 3 required): parental education (max of mother/father), log family income
  1979 (top-code 75,001), occupation-at-14 mapped to 1-digit 1970 census major group
  with an ordinal skill ranking. Sample tertiles (Low/Mid/High).
- Sensitivity: complete-case SES, PMM multiple imputation, later SES
  (1985/89 income, 1985/90/96 wealth, winsorized), age+ASVAB covariate check.
- Inference: Firth-penalized logit (implemented here), race x SES-tertile interaction.
"""
import numpy as np, pandas as pd
from scipy import stats
import statsmodels.api as sm

OUT = "outputs/"
COL = {
 'id'  : 'ID# (range 1-12686) 1979',
 'age' : 'Age of respondent, 1979',
 'occ' : 'Occupation of adult male in household at age 14, 1979',
 'mo'  : "Highest grade completed by respondent's mother, 1979",
 'fa'  : "Highest grade completed by respondent's father, 1979",
 'hgc' : 'Highest grade completed, 1979',
 'race': 'Racial/ethnic cohort, 1979',
 'inc79':'Total net family income, previous calendar year, 1979',
 'inc85':'Total net family income, previous calendar year, 1985',
 'inc89':'Total net family income, previous calendar year, 1989',
 'w85' : 'Family net wealth, 1985',
 'w90' : 'Family net wealth, 1990',
 'w96' : 'Family net wealth, 1996 (key data point)',
 'asvab':['ASVAB - Arithmetic Reasoning Z Score (rounded), 1981',
          'ASVAB - Word Knowledge Z Score (rounded), 1981',
          'ASVAB - Paragraph Comprehension Z Score (rounded), 1981',
          'ASVAB - Mathematics Knowledge Z Score (rounded), 1981'],
}
ren = {v:k for k,v in COL.items() if k != 'asvab'}
for a in COL['asvab']:
    ren[a] = 'asvab_' + a.split(' - ')[1].split(' Z')[0].lower().replace(' ','_')
df = pd.read_csv('data/nls_raw.csv').rename(columns=ren)
ASV = list(ren.values())[-4:]

df['hgc'] = df['hgc'].where(df['hgc'] != 95)          # 95 = ungraded -> missing
for thr, name in [(16,'ba'), (13,'ps'), (17,'ba17')]:
    df[name] = (df['hgc'] >= thr).astype(float).where(df['hgc'].notna())

df['parent_ed'] = df[['mo','fa']].max(axis=1)          # NaN if both missing
df['log_inc79'] = np.log1p(df['inc79'].clip(upper=75001))

# 1970 census major-group (first digit) ordinal skill ranking:
# 0 professional > 2 managers > 3 sales > 4 clerical > 5 craftsmen >
# 6 operatives > 1 farm managers > 7 transport/laborers > 9 service > 8 farm laborers
OCC_RANK = {0:10, 2:9, 3:8, 4:7, 5:6, 6:5, 1:4, 7:3, 9:2, 8:1}
df['occ_rank'] = (df['occ'] // 100).map(OCC_RANK)

df['asvab_mean'] = df[ASV].mean(axis=1)            # mean of available z-scores

# ------------------------------------------------- SES composite and tertiles
comps = ['parent_ed','log_inc79','occ_rank']
zs = {c: (df[c] - df[c].mean()) / df[c].std() for c in comps}
Z = pd.DataFrame(zs)
n_avail = Z.notna().sum(axis=1)
df['ses_raw'] = Z.mean(axis=1).where(n_avail >= 2)     # mean of available z-scores
df['ses_tertile'] = pd.qcut(df['ses_raw'], 3, labels=['Low','Mid','High'])

base = df[df['hgc'].notna() & df['race'].isin([1,2,3]) & df['ses_raw'].notna()].copy()
base_primary = base[base['race'].isin([1,3])].copy()   # primary contrast sample
base_cc = df[df['hgc'].notna() & df['race'].isin([1,3]) &
             df[comps].notna().all(axis=1)].copy()     # complete-case sensitivity
print(f"N primary (Black vs nonB-nonH, SES index >=2 comps): {len(base_primary)}")
print(f"  by race: {base_primary['race'].value_counts().sort_index().to_dict()}")
print(f"BA events in primary sample: {int(base_primary['ba'].sum())}")
print(f"PS events (>=13): {int(base_primary['ps'].sum())}, >=17 events: {int(base_primary['ba17'].sum())}")

# --------------------------------------------------- descriptive race x tertile
def rate_table(data, outcome):
    rows = []
    for race, rl in [(1,'Black'), (2,'Hispanic'), (3,'nonB-nonH')]:
        for t in ['Low','Mid','High']:
            s = data[(data['race']==race) & (data['ses_tertile']==t)].dropna(subset=[outcome])
            n = len(s); k = int(s[outcome].sum()); p = k/n if n else np.nan
            lo, hi = sm.stats.proportion_confint(k, n, method='wilson') if n else (np.nan, np.nan)
            rows.append(dict(race=rl, ses=t, n=n, events=k, rate_pct=round(100*p,2),
                             ci_lo=round(100*lo,2), ci_hi=round(100*hi,2)))
    return pd.DataFrame(rows)

for name, outc in [('ba','ba'), ('ps','ps'), ('ba17','ba17')]:
    t = rate_table(base, outc)
    t.to_csv(OUT+f'rate_table_{name}_race_by_ses_tertile.csv', index=False)
print("\n--- BA (grade>=16) rate % by race x SES tertile ---")
print(rate_table(base,'ba').to_string(index=False))
print("\n--- any postsecondary (>=13) rate % by race x SES tertile ---")
print(rate_table(base,'ps').to_string(index=False))
print("\n--- grade>=17 rate % by race x SES tertile ---")
print(rate_table(base,'ba17').to_string(index=False))

# ------------------------------------------------------------- Firth logistic
def firth_logit(X, y, tol=1e-8, maxit=500):
    """Firth-penalized logistic regression (penalty on all params except intercept)."""
    X = np.asarray(X, float); y = np.asarray(y, float)
    n, p = X.shape
    beta = np.zeros(p)
    pen = np.ones(p); pen[0] = 0.0                      # do not penalize intercept
    for _ in range(maxit):
        eta = X @ beta
        mu = 1/(1+np.exp(-eta))
        w = np.clip(mu*(1-mu), 1e-10, None)
        Xw = X * w[:,None]
        I = X.T @ Xw
        Iinv = np.linalg.pinv(I)
        # Firth score correction: J_i = 0.5 * trace(I^{-1} dI/dbeta_i)
        J = np.zeros(p)
        for i in np.where(pen==1)[0]:
            dIi = Xw.T @ X[:, i:i+1]
            J[i] = 0.5*np.trace(Iinv @ dIi)
        score = X.T @ (y - mu) + J
        step = Iinv @ score
        beta = beta + step
        if np.max(np.abs(step)) < tol: break
    mu = 1/(1+np.exp(-(X @ beta)))
    w = np.clip(mu*(1-mu), 1e-10, None)
    I = (X * w[:,None]).T @ X
    cov = np.linalg.pinv(I)
    se = np.sqrt(np.diag(cov))
    return beta, se

def firth_table(X, y, names):
    b, se = firth_logit(X, y)
    z = b/se
    pv = 2*stats.norm.sf(np.abs(z))
    return pd.DataFrame({'term':names, 'beta':b.round(4), 'se':se.round(4),
                         'z':z.round(2), 'p':pv.round(4)})

# design matrices (primary sample)
d = base_primary.copy()
race_b = (d['race']==1).astype(int)
T = pd.get_dummies(d['ses_tertile'], drop_first=True).reindex(columns=['Mid','High']).fillna(0).astype(int)
names1 = ['intercept','race_black','ses_mid','ses_high','race_black:ses_mid','race_black:ses_high']
X1 = np.column_stack([np.ones(len(d)), race_b, T['Mid'], T['High'],
                      race_b*T['Mid'], race_b*T['High']])

for out, lab in [('ba','BA (grade>=16)'), ('ps','any postsecondary (>=13)'), ('ba17','grade>=17')]:
    t = firth_table(X1, d[out].values, names1)
    print(f"\n--- Firth logit: {lab} (N={len(d)}, events={int(d[out].sum())}) ---")
    print(t.to_string(index=False))
    t.to_csv(OUT+f'firth_{out}.csv', index=False)

# covariate specification check: + age 1979 + mean ASVAB z (complete cases on ASVAB)
d2 = d[d['asvab_mean'].notna()].copy()
rb = (d2['race']==1).astype(int).values
T2 = pd.get_dummies(d2['ses_tertile'], drop_first=True).reindex(columns=['Mid','High']).fillna(0).astype(int).values
age = (d2['age']-d2['age'].mean())/d2['age'].std()
asv = (d2['asvab_mean']-d2['asvab_mean'].mean())/d2['asvab_mean'].std()
X2 = np.column_stack([np.ones(len(d2)), rb, T2, rb[:,None]*T2, age.values, asv.values])
names2 = names1 + ['age_z','asvab_z']
for out, lab in [('ba','BA'), ('ps','any postsecondary')]:
    t = firth_table(X2, d2[out].values, names2)
    print(f"\n--- Firth logit + age & ASVAB covariates: {lab} (N={len(d2)}, events={int(d2[out].sum())}) ---")
    print(t.to_string(index=False))
    t.to_csv(OUT+f'firth_{out}_cov.csv', index=False)

# ------------------------------------------------- sensitivity 1: complete case
d3 = base_cc.copy()
rb3 = (d3['race']==1).astype(int).values
T3 = pd.get_dummies(d3['ses_tertile'], drop_first=True).reindex(columns=['Mid','High']).fillna(0).astype(int).values
X3 = np.column_stack([np.ones(len(d3)), rb3, T3, rb3[:,None]*T3])
names3 = ['intercept','race_black','ses_mid','ses_high','rb:mid','rb:high']
for out, lab in [('ba','BA'), ('ps','any postsecondary')]:
    t = firth_table(X3, d3[out].values, names3)
    print(f"\n--- Sensitivity (complete-case SES): Firth logit {lab} (N={len(d3)}, events={int(d3[out].sum())}) ---")
    print(t.to_string(index=False))
    t.to_csv(OUT+f'firth_{out}_cc.csv', index=False)

# ------------------------------------------------- sensitivity 2: PMM imputation
def pmm_impute(frame, comps, m=5, k=3, seed=42):
    """Chained predictive-mean-matching imputation of the SES components."""
    rng = np.random.default_rng(seed)
    out = []
    for _ in range(m):
        cur = frame[comps].copy()
        cur['race'] = frame['race'].values
        for it in range(10):
            for c in comps:
                miss = cur[c].isna()
                if not miss.any(): continue
                others = [x for x in comps if x != c]
                aux = pd.concat([cur[others], cur['race']], axis=1)
                aux = aux.fillna(aux.median(numeric_only=True))
                obs = ~miss
                X = np.column_stack([np.ones(obs.sum()), aux.loc[obs].values])
                yv = cur.loc[obs, c].values
                bhat, *_ = np.linalg.lstsq(X, yv, rcond=None)
                Xmiss = np.column_stack([np.ones(miss.sum()), aux.loc[miss].values])
                yhat = Xmiss @ bhat
                resid = yv - X @ bhat
                sigma = resid.std(ddof=len(bhat))
                ystar = yhat + rng.normal(0, sigma, miss.sum())
                order = np.argsort(np.abs(yv[None,:] - ystar[:,None]), axis=1)[:, :k]
                pick = rng.integers(0, k, miss.sum())
                cur.loc[miss, c] = yv[order[np.arange(miss.sum()), pick]]
        out.append(cur)
    return out

imp_frame = df[df['hgc'].notna() & df['race'].isin([1,3])].copy()
imputed = pmm_impute(imp_frame, comps)
pooled = []
for j, imp in enumerate(imputed):
    zj = pd.DataFrame({c: (imp[c]-df[c].mean())/df[c].std() for c in comps})
    sesj = zj.mean(axis=1).where(zj.notna().sum(axis=1)>=2).fillna(zj.mean(axis=1))
    sub = imp_frame.copy()
    sub['ses_j'] = sesj.values
    sub['ter'] = pd.qcut(sub['ses_j'], 3, labels=[0,1,2]).astype(float)
    rb = (sub['race']==1).astype(float).values
    t01 = (sub['ter']==1).astype(float).values; t02 = (sub['ter']==2).astype(float).values
    X = np.column_stack([np.ones(len(sub)), rb, t01, t02, rb*t01, rb*t02])
    res = {}
    for outc in ['ba','ps']:
        b, se = firth_logit(X, sub[outc].values)
        res[outc] = np.r_[b, se]
    pooled.append(res)
    if j == 0:
        for outc in ['ba','ps']:
            print(f"\n--- PMM draw 1: {outc} ---")
            print(dict(zip(names1, res[outc][:6].round(4))))

print("\n--- PMM MI pooled (m=5): race x SES interaction terms (Rubin's rules) ---")
mi_rows = []
for outc in ['ba','ps']:
    ests = np.array([r[outc][:6] for r in pooled])
    vars_ = np.array([r[outc][6:]**2 for r in pooled])
    qbar = ests.mean(0); ub = vars_.mean(0)
    bb = ests.var(0, ddof=1)
    tot = ub + (1+1/5)*bb
    se = np.sqrt(tot)
    z = qbar/se; pv = 2*stats.norm.sf(np.abs(z))
    for i, nm in enumerate(names1):
        if i in (4,5) or i == 1:
            mi_rows.append(dict(outcome=outc, term=nm, beta=qbar[i], se=se[i], z=z[i], p=pv[i]))
mi = pd.DataFrame(mi_rows)
print(mi.round(4).to_string(index=False))
mi.to_csv(OUT+'firth_mi_pooled_interactions.csv', index=False)

# ------------------------- sensitivity 3: later SES (income/wealth, winsorized)
print("\n--- Sensitivity: later SES measures (Black vs nonB-nonH, BA rates) ---")
later = df[df['hgc'].notna() & df['race'].isin([1,3])].copy()
rows = []
for c, lab in [('inc85','income 1985'), ('inc89','income 1989'), ('w85','wealth 1985'),
               ('w90','wealth 1990'), ('w96','wealth 1996')]:
    win = later[c].clip(lower=later[c].quantile(0.01), upper=later[c].quantile(0.99))
    later[lab] = pd.qcut(win, 3, labels=['Low','Mid','High'])
    for race, rl in [(1,'Black'), (3,'nonB-nonH')]:
        for t in ['Low','Mid','High']:
            s = later[(later['race']==race) & (later[lab]==t) & later['ba'].notna()]
            if len(s):
                rows.append(dict(measure=lab, race=rl, ses=t, n=len(s),
                                 ba_pct=round(100*s['ba'].mean(),2)))
lat = pd.DataFrame(rows)
print(lat.to_string(index=False))
lat.to_csv(OUT+'sensitivity_later_ses_ba_rates.csv', index=False)

# --------------------------------------------- Black-minus-nonB gap per tertile
print("\n--- Gap (Black - nonB-nonH), percentage points, primary sample ---")
for out, lab in [('ba','BA'), ('ps','PS>=13'), ('ba17','>=17')]:
    piv = []
    for t in ['Low','Mid','High']:
        b = base[(base['race']==1)&(base['ses_tertile']==t)][out].dropna()
        n = base[(base['race']==3)&(base['ses_tertile']==t)][out].dropna()
        pb, pn = b.mean(), n.mean()
        se = np.sqrt(pb*(1-pb)/len(b) + pn*(1-pn)/len(n))
        piv.append(dict(tertile=t, black_pct=round(100*pb,2), nonb_pct=round(100*pn,2),
                        gap_pp=round(100*(pb-pn),2), se_pp=round(100*se,2)))
    g = pd.DataFrame(piv)
    print(f"[{lab}]"); print(g.to_string(index=False))
    g.to_csv(OUT+f'gap_{out}_by_tertile.csv', index=False)

print("\nMean SES components by race (all rows):")
print(df.groupby('race')[comps].mean().round(2).to_string())
df.groupby('race')[comps].mean().round(3).to_csv(OUT+'ses_components_by_race.csv')
print("\nAll outputs written to outputs/. Done.")
