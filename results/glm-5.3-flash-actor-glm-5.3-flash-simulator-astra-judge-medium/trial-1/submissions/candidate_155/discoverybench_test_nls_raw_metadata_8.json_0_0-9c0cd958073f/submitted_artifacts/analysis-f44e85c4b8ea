"""
Analysis: How does the median family net wealth of white (non-black, non-Hispanic)
individuals compare to that of black and Hispanic individuals from 1985 onwards?
Data: NLSY79 extract (data/nls_raw.csv). Cross-sections: 1985, 1990, 1996.
Primary median definition: all non-missing values (including zero and negative net worth).
Sensitivity: (a) positive values only; (b) 1%/99% winsorized (on all non-missing values).
All statistics unweighted (no weight variable present in the data).
"""
import pandas as pd
import numpy as np

RACE_COL = 'Racial/ethnic cohort, 1979'
WEALTH_COLS = {
    1985: 'Family net wealth, 1985',
    1990: 'Family net wealth, 1990',
    1996: 'Family net wealth, 1996 (key data point)',
}
RACE_LABELS = {1: 'Black', 2: 'Hispanic', 3: 'Non-black non-Hispanic (white proxy)'}

df = pd.read_csv('data/nls_raw.csv')
df['_race_label'] = df[RACE_COL].map(RACE_LABELS)

def winsorize(s, lo=0.01, hi=0.99):
    q_lo, q_hi = s.quantile(lo), s.quantile(hi)
    return s.clip(lower=q_lo, upper=q_hi)

rows, gap_rows = [], []
for year, col in WEALTH_COLS.items():
    w = pd.to_numeric(df[col], errors='coerce')
    grp = df.assign(_w=w).groupby('_race_label')['_w']
    for label in RACE_LABELS.values():
        s = grp.get_group(label)
        n_total = len(s)
        n_obs = s.notna().sum()
        s_all = s.dropna()
        med_main = s_all.median()
        s_pos = s_all[s_all > 0]
        med_pos = s_pos.median() if len(s_pos) else np.nan
        s_win = winsorize(s_all)
        med_win = s_win.median()
        rows.append(dict(year=year, group=label, n_total=n_total, n_obs=n_obs,
                         miss_rate=1 - n_obs / n_total,
                         n_zero=(s_all == 0).sum(), n_neg=(s_all < 0).sum(),
                         median_main=med_main, median_positive_only=med_pos,
                         median_winsorized_1_99=med_win))

tidy = pd.DataFrame(rows)

# gaps relative to reference group
for year in WEALTH_COLS:
    sub = tidy[tidy.year == year].set_index('group')
    ref_main = sub.loc['Non-black non-Hispanic (white proxy)', 'median_main']
    ref_pos = sub.loc['Non-black non-Hispanic (white proxy)', 'median_positive_only']
    for g in ['Black', 'Hispanic']:
        gm = sub.loc[g, 'median_main']; gp = sub.loc[g, 'median_positive_only']
        gw = sub.loc[g, 'median_winsorized_1_99']
        gap_rows.append(dict(year=year, comparison=f'white_proxy / {g}',
                             abs_gap_main=ref_main - gm, ratio_main=ref_main / gm if gm else np.nan,
                             abs_gap_positive_only=ref_pos - gp,
                             ratio_positive_only=ref_pos / gp if gp else np.nan,
                             ratio_winsorized=sub.loc['Non-black non-Hispanic (white proxy)', 'median_winsorized_1_99'] / gw if gw else np.nan))
gaps = pd.DataFrame(gap_rows)

pd.set_option('display.width', 200)
print("=" * 100)
print("TABLE 1: Median family net wealth by race/ethnicity and year (unweighted)")
print(tidy.to_string(index=False,
      formatters={'miss_rate': '{:.1%}'.format, 'median_main': '${:,.0f}'.format,
                  'median_positive_only': '${:,.0f}'.format,
                  'median_winsorized_1_99': '${:,.0f}'.format}))
print()
print("=" * 100)
print("TABLE 2: Gaps of white-proxy group vs Black and Hispanic groups")
print(gaps.to_string(index=False,
      formatters={'abs_gap_main': '${:,.0f}'.format, 'ratio_main': '{:.2f}x'.format,
                  'abs_gap_positive_only': '${:,.0f}'.format, 'ratio_positive_only': '{:.2f}x'.format,
                  'ratio_winsorized': '{:.2f}x'.format}))

tidy.to_csv('outputs/median_wealth_by_group.csv', index=False)
gaps.to_csv('outputs/wealth_gaps.csv', index=False)
print("\nSaved: outputs/median_wealth_by_group.csv, outputs/wealth_gaps.csv")
