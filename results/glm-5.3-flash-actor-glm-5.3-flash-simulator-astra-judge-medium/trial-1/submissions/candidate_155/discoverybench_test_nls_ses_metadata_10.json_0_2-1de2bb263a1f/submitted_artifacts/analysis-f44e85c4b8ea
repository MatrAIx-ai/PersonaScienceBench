"""
FINAL ANALYSIS — NLS SES & BA degree completion (DiscoveryBench episode
discoverybench:test/nls_ses/metadata_10.json/0/2)

Question: The effect of which variable on BA degree completion decreases from
0.3636 to -0.2293 (while becoming insignificant) when both race and academic
characteristics are included in analysis?

Approved workflow:
  Step 1  data audit
  Step 2  nested logistic regression (background model -> + academic) + LPM check
  Step 3  systematic replication grid (form x covariate set x coding x SE type)
          to locate the specification that reproduces 0.3636 -> -0.2293
  Step 4  diagnostics (collinearity, separation/convergence, flip scan for
          every candidate variable)
"""
import numpy as np, pandas as pd, statsmodels.api as sm, warnings
warnings.filterwarnings("ignore")
pd.set_option("display.width", 220)

# ---------------- Step 1: data audit ----------------
df = pd.read_csv("data/nls_ses_processed.csv", index_col=0)
print("STEP 1 - DATA AUDIT")
print("rows:", len(df), " cols:", df.shape[1], " total NaN:", int(df.isna().sum().sum()))
df["BA"] = df["BA DEGREE COMPLETED"].astype(int)
df["ASVAB"] = df["ABILITY: COMPOSITE OF ASVAB SCORE"]
df["PCT"] = df["PERCENTILE IN CLASS"]
df["PCT_rev"] = 100 - df["PCT"]
df["fam"] = df["FAMILY SIZE OF SAMPLE"]
for c in ["BA", "SAMPLE_RACE", "SAMPLE_SEX"]:
    print(f"  {c}:", df[c].value_counts().to_dict() if df[c].nunique() < 10
          else f"mean={df[c].mean():.4f}")
for c in ["ASVAB", "PCT", "PCT_rev", "SES", "fam"]:
    print(f"  {c}: min={df[c].min():.3f} max={df[c].max():.3f} mean={df[c].mean():.3f}")
print("  dup CASE IDs:", df["CASE ID"].duplicated().sum())

race_d = pd.concat([
    (df["SAMPLE_RACE"] == "Black").astype(float).rename("race_Black"),
    (df["SAMPLE_RACE"] == "Hispanic").astype(float).rename("race_Hispanic")], axis=1)  # White=ref
df = pd.concat([df, race_d, (df["SAMPLE_SEX"] == "Male").astype(float).rename("male")], axis=1)
y = df["BA"]
BASE = ["SES", "male", "race_Black", "race_Hispanic"]          # no family size
FULL = BASE + ["ASVAB", "PCT"]

def logit_fit(cols, cov=None):
    X = sm.add_constant(df[cols], has_constant="add")
    r = (sm.Logit(y, X).fit(disp=0, maxiter=200) if cov is None
         else sm.Logit(y, X).fit(disp=0, maxiter=200, cov_type=cov))
    i = list(X.columns).index("SES")
    return (float(np.asarray(r.params)[i]), float(np.asarray(r.bse)[i]),
            float(np.asarray(r.pvalues)[i]), r)

def lpm_fit(cols):
    X = sm.add_constant(df[cols], has_constant="add")
    r = sm.OLS(y, X).fit(cov_type="HC1")
    return float(r.params["SES"]), float(r.bse["SES"]), float(r.pvalues["SES"]), r

# ---------------- Step 2: headline nested models ----------------
print("\nSTEP 2 - HEADLINE NESTED MODELS (logit; base = SES+sex+race, no fam size)")
print(f"{'':6s}{'coef(SES)':>11s}{'se':>8s}{'p':>8s}{'OR':>8s}")
for nm, cols, fn in [("M1", BASE, logit_fit), ("M2", FULL, logit_fit)]:
    c, s, p, r = fn(cols)
    print(f"{nm:6s}{c:+11.4f}{s:8.4f}{p:8.4f}{np.exp(c):8.3f}")
c1, s1, p1, r1 = logit_fit(BASE); c2, s2, p2, r2 = logit_fit(FULL)
print("\nM1 full table:"); print(pd.DataFrame({"coef": r1.params, "OR": np.exp(r1.params),
      "se": r1.bse, "p": r1.pvalues}).round(4).to_string())
print("M2 full table:"); print(pd.DataFrame({"coef": r2.params, "OR": np.exp(r2.params),
      "se": r2.bse, "p": r2.pvalues}).round(4).to_string())
print(f"AME(SES): M1 {r1.get_margeff(at='overall').summary_frame().loc['SES','dy/dx']:+.4f}"
      f"  M2 {r2.get_margeff(at='overall').summary_frame().loc['SES','dy/dx']:+.4f}")

# ---------------- Step 3: replication grid ----------------
print("\nSTEP 3 - REPLICATION GRID (SES coefficient path; target 0.3636 -> -0.2293)")
rows = []
def add(form, label, base, full):
    f1, f2 = (logit_fit, logit_fit) if form == "logit" else (lpm_fit, lpm_fit)
    a, sa, pa, _ = f1(base); b, sb, pb, _ = f2(full)
    rows.append({"form": form, "spec": label, "M1_SES": a, "M1_se": sa, "M1_p": pa,
                 "M2_SES": b, "M2_se": sb, "M2_p": pb})
variants = [
    ("SES+race -> +ASVAB+PCT",            ["SES","race_Black","race_Hispanic"],
                                          ["SES","race_Black","race_Hispanic","ASVAB","PCT"]),
    ("SES+sex+race -> +ASVAB+PCT",        BASE, FULL),
    ("SES+sex+race -> +ASVAB+PCT+fam",    BASE, FULL + ["fam"]),
    ("SES+sex+fam+race -> +ASVAB+PCT",    BASE + ["fam"], FULL + ["fam"]),
]
for form in ["logit", "LPM"]:
    for label, b, f in variants:
        add(form, label, b, f)
# cloglog companion
X1 = sm.add_constant(df[BASE], has_constant="add"); X2 = sm.add_constant(df[FULL], has_constant="add")
for nm, X in [("M1", X1), ("M2", X2)]:
    pass
r1c = sm.GLM(y, X1, family=sm.families.Binomial(sm.families.links.CLogLog())).fit()
r2c = sm.GLM(y, X2, family=sm.families.Binomial(sm.families.links.CLogLog())).fit()
rows.append({"form": "cloglog", "spec": "SES+sex+race -> +ASVAB+PCT",
             "M1_SES": r1c.params["SES"], "M1_se": r1c.bse["SES"], "M1_p": r1c.pvalues["SES"],
             "M2_SES": r2c.params["SES"], "M2_se": r2c.bse["SES"], "M2_p": r2c.pvalues["SES"]})
grid = pd.DataFrame(rows)
print(grid.round(4).to_string(index=False))
grid.to_csv("analysis_out/final_grid.csv", index=False)

# ---------------- Step 4: diagnostics & flip scan ----------------
print("\nSTEP 4 - DIAGNOSTICS")
print("  corr(ASVAB, PCT) =", round(df.ASVAB.corr(df.PCT), 4),
      "| corr(SES, ASVAB) =", round(df.SES.corr(df.ASVAB), 4),
      "| corr(SES, PCT) =", round(df.SES.corr(df.PCT), 4))
Xv = sm.add_constant(df[FULL], has_constant="add")
vif = np.diag(np.linalg.inv(np.corrcoef(Xv.drop(columns="const").values, rowvar=False)))
print("  VIF:", {k: round(v, 2) for k, v in zip(Xv.columns.drop("const"), vif)})
pr = r2.predict(X2)
print("  M2 logit converged:", r2.mle_retvals["converged"],
      "| pred prob range:", round(pr.min(), 5), "-", round(pr.max(), 4),
      "(no separation: no fitted prob at 0/1)")
print("  Percentile coding: corr(ASVAB, PCT_rev) =", round(df.ASVAB.corr(df.PCT_rev), 4),
      "-> data consistent with higher percentile = BETTER standing")
X2r = sm.add_constant(df[BASE + ["ASVAB", "PCT_rev"]], has_constant="add")
r2r = sm.Logit(y, X2r).fit(disp=0, maxiter=200)
print(f"  PCT_rev coef (M2): {r2r.params['PCT_rev']:+.4f} vs PCT {r2.params['PCT']:+.4f}"
      f" | SES coef unchanged: {r2r.params['SES']:+.4f}")

print("\n  Flip scan of every candidate variable (logit, SES also shown):")
def scan(t, base, full, form="logit"):
    Xa = sm.add_constant(df[base], has_constant="add"); Xb = sm.add_constant(df[full], has_constant="add")
    if form == "logit":
        ra = sm.Logit(y, Xa).fit(disp=0, maxiter=200); rb = sm.Logit(y, Xb).fit(disp=0, maxiter=200)
    else:
        ra = sm.OLS(y, Xa).fit(cov_type="HC1"); rb = sm.OLS(y, Xb).fit(cov_type="HC1")
    return (float(ra.params[t]), float(ra.pvalues[t]), float(rb.params[t]),
            float(rb.bse[t]), float(rb.pvalues[t]))
allv = ["SES", "male", "fam", "race_Black", "race_Hispanic"]  # vars present in M1
base2 = ["male", "fam", "race_Black", "race_Hispanic", "SES"]
full2 = base2 + ["ASVAB", "PCT"]
for t in allv:
    a, pa, b, sb, pb = scan(t, base2, full2)
    flip = (np.sign(a) != np.sign(b)) and pa < 0.05 and pb > 0.05
    print(f"    {t:14s}: {a:+.4f} (p={pa:.4f}) -> {b:+.4f} (se={sb:.4f}, p={pb:.4f})"
          f"{'  <<< sign-flip + loss of significance' if flip else ''}")
