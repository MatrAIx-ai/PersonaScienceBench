"""NLS SES -> BA degree completion: nested-model coefficient comparison.

Question: which variable's effect on BA completion drops from ~0.5024 to ~0.0923
(becoming insignificant) once SES and academic characteristics are included?

Models: logistic (primary) + LPM (robustness), raw and z-scored scales.
"""
import pandas as pd
import numpy as np
import statsmodels.api as sm

OUT = 'analysis/outputs'
import os; os.makedirs(OUT, exist_ok=True)

df = pd.read_csv('data/nls_ses_processed.csv')
df['BA'] = df['BA DEGREE COMPLETED'].astype(int)
df['Black'] = (df['SAMPLE_RACE'] == 'Black').astype(int)
df['Hispanic'] = (df['SAMPLE_RACE'] == 'Hispanic').astype(int)
df['Female'] = (df['SAMPLE_SEX'] == 'Female').astype(int)
ABIL = 'ABILITY: COMPOSITE OF ASVAB SCORE'; PCTL = 'PERCENTILE IN CLASS'
for c in ['FAMILY SIZE OF SAMPLE', ABIL, PCTL, 'SES']:
    df[c + '_z'] = (df[c] - df[c].mean()) / df[c].std()

def fit(kind, cols):
    X = sm.add_constant(df[cols].astype(float))
    if kind == 'logit': return sm.Logit(df['BA'], X).fit(disp=0)
    if kind == 'probit': return sm.Probit(df['BA'], X).fit(disp=0)
    return sm.OLS(df['BA'], X).fit()

BG = ['Black', 'Hispanic', 'Female', 'FAMILY SIZE OF SAMPLE']
sequences = {
    'M1_bg': BG,
    'M2_bg+SES': BG + ['SES'],
    'M3_bg+SES+acad': BG + ['SES', ABIL, PCTL],
    'M3b_bg+acad+SES': BG + [ABIL, PCTL, 'SES'],
    'SESonly': ['SES'],
    'SES+acad(no bg)': ['SES', ABIL, PCTL],
    'SES+PCTL(no bg)': ['SES', PCTL],
}
rows = []
for kind in ['logit', 'probit', 'ols']:
    for name, cols in sequences.items():
        m = fit(kind, cols)
        for v in m.params.index:
            if v == 'const': continue
            rows.append(dict(model=kind, spec=name, variable=v,
                             coef=round(float(m.params[v]), 4),
                             se=round(float(m.bse[v]), 4),
                             p=round(float(m.pvalues[v]), 4),
                             sig='*' if m.pvalues[v] < 0.05 else ''))
tab = pd.DataFrame(rows)
tab.to_csv(f'{OUT}/coefficient_table.csv', index=False)

# SES-focused grid: SES coefficient under every background-control combination
import itertools
others = ['Black', 'Hispanic', 'Female', 'FAMILY SIZE OF SAMPLE']
acad_opts = {'none': [], ABIL: [ABIL], PCTL: [PCTL], 'abil+pctl': [ABIL, PCTL]}
grid = []
for r in range(0, 5):
    for combo in itertools.combinations(others, r):
        row = {'controls': '+'.join(combo) if combo else '(none)'}
        for an, acad in acad_opts.items():
            m = fit('logit', list(combo) + ['SES'] + acad)
            row[f'{an}_coef'] = round(float(m.params['SES']), 4)
            row[f'{an}_p'] = round(float(m.pvalues['SES']), 4)
        grid.append(row)
gr = pd.DataFrame(grid)
gr.to_csv(f'{OUT}/ses_coefficient_grid.csv', index=False)
print(tab.to_string())
print()
print(gr.to_string())
