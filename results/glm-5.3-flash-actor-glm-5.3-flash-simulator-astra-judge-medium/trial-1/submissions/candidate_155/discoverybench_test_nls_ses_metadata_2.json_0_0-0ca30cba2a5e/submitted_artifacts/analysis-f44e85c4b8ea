"""
NLS SES x Race analysis: does SES relate to BA completion differently by race?
Descriptive/associative analysis (observational data; no causal claims).
Convention note: PERCENTILE IN CLASS -- higher value = higher class standing
(verified: BA rate rises monotonically across quartiles 0.14%->7.5%; univariate
logit slope +0.045, p<1e-4; corr with ASVAB +0.70).
"""
import numpy as np, pandas as pd
import statsmodels.api as sm
from scipy import stats as st

df = pd.read_csv('data/nls_ses_processed.csv')
df['BA'] = df['BA DEGREE COMPLETED'].astype(int)
df['FEMALE'] = (df['SAMPLE_SEX'] == 'Female').astype(int)
race = pd.get_dummies(pd.Categorical(df['SAMPLE_RACE'], categories=['White','Black','Hispanic']), prefix='RACE', drop_first=True).astype(float)  # ref = White
df = pd.concat([df, race], axis=1)
for c in ['SES','ABILITY: COMPOSITE OF ASVAB SCORE','PERCENTILE IN CLASS','FAMILY SIZE OF SAMPLE']:
    df[c + '_c'] = (df[c] - df[c].mean()) / df[c].std()
df['SES_x_RACEBlack'] = df['SES_c'] * df['RACE_Black']
df['SES_x_RACEHispanic'] = df['SES_c'] * df['RACE_Hispanic']
print(f'N={len(df)}, events={int(df["BA"].sum())}')

def fit(cols, name):
    X = sm.add_constant(df[cols]); m = sm.Logit(df['BA'], X).fit(disp=0)
    out = pd.DataFrame({'log_odds': m.params, 'OR': np.exp(m.params),
                        'CI_low_OR': np.exp(m.conf_int()[0]), 'CI_high_OR': np.exp(m.conf_int()[1]),
                        'p': m.pvalues})
    print(f'\n=== {name}  AIC={m.aic:.1f} BIC={m.bic:.1f} llf={m.llf:.1f} ===')
    print(out.round(4).to_string())
    return m, out

base   = ['SES_c', 'RACE_Black', 'RACE_Hispanic', 'SES_x_RACEBlack', 'SES_x_RACEHispanic']
covs   = ['PERCENTILE IN CLASS_c', 'FAMILY SIZE OF SAMPLE_c', 'FEMALE']
covs_a = ['PERCENTILE IN CLASS_c', 'FAMILY SIZE OF SAMPLE_c', 'FEMALE', 'ABILITY: COMPOSITE OF ASVAB SCORE_c']

m0, t0 = fit(base, 'M0: SES x RACE (no covariates)')
m1, t1 = fit(base + covs, 'M1: + class pctile, family size, female')
m2, t2 = fit(base + covs_a, 'M2: full (+ ASVAB)')

def lrt(full, drop_cols):
    Xf = sm.add_constant(df[full.params.index[1:]])
    Xr = Xf.drop(columns=drop_cols)
    r = sm.Logit(df['BA'], Xr).fit(disp=0)
    return 2 * (full.llf - r.llf), len(drop_cols), st.chi2.sf(2*(full.llf - r.llf), len(drop_cols))

for nm, mm in [('M0', m0), ('M1', m1), ('M2', m2)]:
    s, d, p = lrt(mm, ['SES_x_RACEBlack', 'SES_x_RACEHispanic'])
    print(f'Joint LRT (SES x RACE), {nm}: chi2={s:.2f}, df={d}, p={p:.4f}')

for nm, mm, addcols in [('M0', m0, base[:3]), ('M2', m2, ['SES_c','RACE_Black','RACE_Hispanic']+covs_a)]:
    ma = sm.Logit(df['BA'], sm.add_constant(df[addcols])).fit(disp=0)
    print(f'{nm} additive AIC={ma.aic:.1f}/BIC={ma.bic:.1f}  vs  interactive AIC={mm.aic:.1f}/BIC={mm.bic:.1f}')

# Predicted probabilities by race over SES grid, from M2 (covariates at sample means)
ses_grid = np.linspace(df['SES_c'].min(), df['SES_c'].max(), 200)
ref = {c: df[c].mean() for c in covs_a}
def pred(race_col):
    rows = []
    for s in ses_grid:
        d = {'const': 1.0, 'SES_c': s, 'RACE_Black': 0.0, 'RACE_Hispanic': 0.0,
             'SES_x_RACEBlack': 0.0, 'SES_x_RACEHispanic': 0.0}
        d.update(ref); d[race_col] = 1.0; d['SES_x_' + race_col] = s
        rows.append(d)
    Xp = pd.DataFrame(rows)[m2.params.index]
    eta = Xp @ m2.params
    var = np.einsum('ij,jk,ik->i', Xp, m2.cov_params(), Xp)
    sig = lambda z: 1/(1+np.exp(-z))
    return sig(eta), sig(eta - 1.96*np.sqrt(var)), sig(eta + 1.96*np.sqrt(var))

ses_raw = ses_grid * df['SES'].std() + df['SES'].mean()
curve = pd.DataFrame({'SES_raw': ses_raw})
for rc in ['RACE_White','RACE_Black','RACE_Hispanic']:
    pr, lo, hi = pred(rc)
    curve[rc.replace('RACE_','')+'_p'] = pr
    curve[rc.replace('RACE_','')+'_lo'] = lo
    curve[rc.replace('RACE_','')+'_hi'] = hi
curve.to_csv('outputs/pred_prob_curve_by_race.csv', index=False)
print('\nCurves saved (200-point grid); excerpt at SES deciles:')
sub = curve.iloc[::20]
print(sub.round(4).to_string(index=False))
# ASCII sketch of point estimates (probabilities x1000)
print('\nASCII sketch (P_BA x 1000 vs SES, W=White B=Black H=Hispanic):')
for i in range(0, 200, 8):
    row = curve.iloc[i]
    def bar(v): return '#' * int(round(v*1000))
    print(f'SES {row.SES_raw:+.2f} | W{bar(row.White_p):<18} B{bar(row.Black_p):<14} H{bar(row.Hispanic_p):<12} | W={row.White_p*100:.1f}% B={row.Black_p*100:.1f}% H={row.Hispanic_p*100:.1f}%')

# Predicted P(BA) at SES = -1SD / mean / +1SD, by race
rows = []
for rc in ['RACE_White','RACE_Black','RACE_Hispanic']:
    for lab, s in [('-1SD',-1.0),('mean',0.0),('+1SD',1.0)]:
        d = {'const':1.0,'SES_c':s,'RACE_Black':0.0,'RACE_Hispanic':0.0,
             'SES_x_RACEBlack':0.0,'SES_x_RACEHispanic':0.0}
        d.update(ref); d[rc]=1.0; d['SES_x_'+rc]=s
        Xp = pd.DataFrame([d])[m2.params.index]
        rows.append({'race': rc.replace('RACE_',''), 'SES': lab, 'P_BA_pct': 100*m2.predict(Xp)[0]})
pp = pd.DataFrame(rows).pivot(index='SES', columns='race', values='P_BA_pct')
print('\nPREDICTED P(BA) %, M2, covariates at means:')
print(pp.round(2).to_string())

with pd.ExcelWriter('outputs/model_tables.xlsx') as w:
    for k, t in {'M0':t0,'M1':t1,'M2':t2}.items(): t.round(5).to_excel(w, sheet_name=k)
    pp.to_excel(w, sheet_name='pred_prob')
key = pd.concat([t1.loc[['SES_c','RACE_Black','RACE_Hispanic','SES_x_RACEBlack','SES_x_RACEHispanic']],
                 t2.loc[['SES_c','RACE_Black','RACE_Hispanic','SES_x_RACEBlack','SES_x_RACEHispanic']]], keys=['M1','M2'])
print('\nKEY ESTIMATES (M1 / M2):\n', key.round(4).to_string())
