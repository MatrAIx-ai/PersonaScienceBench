"""
Analysis: At what Socioeconomic levels is the advantage/disadvantage in BA
completion rates for Black students more pronounced?
Data: NLS (nls_ses_processed.csv). Design approved by researcher:
- No directional prior; report observed race gaps by SES level (magnitude focus).
- Main stratification: SES quintiles (equal frequency). Sensitivity: deciles,
  continuous logistic model with SES spline + race interaction.
- Statistics: risk difference (RD, percentage points) with Wald 95% CI;
  odds ratio (OR, Haldane-Anscombe 0.5 correction) with log-scale 95% CI;
  logistic interaction test. Fisher exact for sparse cells.
- Supplement: sex-stratified RD (descriptive only). No covariate control.
"""
import numpy as np, pandas as pd
from scipy import stats
import statsmodels.api as sm
import statsmodels.formula.api as smf
import json, itertools

df = pd.read_csv('data/nls_ses_processed.csv', index_col=0)
df['BA'] = df['BA DEGREE COMPLETED'].astype(int)

def rd_or_ci(x1, n1, x0, n0, alpha=0.05):
    """group1 vs group0. Returns RD, RD CI, OR (0.5-corrected), OR CI, fisher p, min expected."""
    p1, p0 = x1/n1, x0/n0
    rd = p1 - p0
    se_rd = np.sqrt(p1*(1-p1)/n1 + p0*(1-p0)/n0)
    z = stats.norm.ppf(1-alpha/2)
    rd_lo, rd_hi = rd - z*se_rd, rd + z*se_rd
    # Haldane-Anscombe corrected OR
    a, b, c, d = x1+0.5, n1-x1+0.5, x0+0.5, n0-x0+0.5
    OR = (a*d)/(b*c)
    se_log = np.sqrt(1/a + 1/b + 1/c + 1/d)
    or_lo, or_hi = np.exp(np.log(OR) - z*se_log), np.exp(np.log(OR) + z*se_log)
    table = np.array([[x1, n1-x1], [x0, n0-x0]])
    fisher_p = stats.fisher_exact(table)[1]
    min_exp = min(n1, n0) * (x1+x0)/(n1+n0)
    return dict(RD=rd, RD_lo=rd_lo, RD_hi=rd_hi, OR=OR, OR_lo=or_lo, OR_hi=or_hi,
                fisher_p=fisher_p, min_expected=min_exp)

def fmt(r):
    return (f"RD={r['RD']*100:+.2f}pp [{r['RD_lo']*100:+.2f},{r['RD_hi']*100:+.2f}]  "
            f"OR={r['OR']:.2f} [{r['OR_lo']:.2f},{r['OR_hi']:.2f}]  "
            f"fisher_p={r['fisher_p']:.3f}  minExp={r['min_expected']:.1f}")

results = {}

# ---------- MAIN: SES quintiles (equal frequency) ----------
df['SES_q5'] = pd.qcut(df['SES'], 5, labels=[f'Q{i+1}' for i in range(5)])
q_edges = df.groupby('SES_q5')['SES'].agg(['min','max','count'])
print("=== SES quintile edges (equal frequency) ===")
print(q_edges.round(3).to_string())

rows = []
for q in [f'Q{i+1}' for i in range(5)]:
    sub = df[df['SES_q5']==q]
    for g1, g0 in [('Black','White'), ('Black','Hispanic'), ('Hispanic','White')]:
        s1, s0 = sub[sub['SAMPLE_RACE']==g1], sub[sub['SAMPLE_RACE']==g0]
        r = rd_or_ci(s1['BA'].sum(), len(s1), s0['BA'].sum(), len(s0))
        rows.append(dict(SES_level=q, comparison=f"{g1} vs {g0}",
                         n1=len(s1), x1=int(s1['BA'].sum()), rate1=s1['BA'].mean(),
                         n0=len(s0), x0=int(s0['BA'].sum()), rate0=s0['BA'].mean(),
                         **r))
main = pd.DataFrame(rows)
print("\n=== MAIN: RD / OR by SES quintile ===")
for q in [f'Q{i+1}' for i in range(5)]:
    print(f"\n--- {q} ---")
    for _, r in main[main.SES_level==q].iterrows():
        print(f"{r['comparison']}: Black/comp rates {r['rate1']*100:.2f}% vs {r['rate0']*100:.2f}% | {fmt(r)}")
results['main_quintiles'] = main

# rate table
rate_tab = df.pivot_table(index='SES_q5', columns='SAMPLE_RACE', values='BA', aggfunc='mean').round(4)
cnt_tab  = df.pivot_table(index='SES_q5', columns='SAMPLE_RACE', values='BA', aggfunc='size')
print("\n=== Completion rates by SES quintile x race ===")
print((rate_tab*100).round(2).to_string())
print("\n=== Cell sizes ===")
print(cnt_tab.to_string())

# ---------- SENSITIVITY 1: deciles ----------
df['SES_q10'] = pd.qcut(df['SES'], 10, labels=[f'D{i+1}' for i in range(10)])
rows10 = []
for d in [f'D{i+1}' for i in range(10)]:
    sub = df[df['SES_q10']==d]
    for g1, g0 in [('Black','White'), ('Black','Hispanic')]:
        s1, s0 = sub[sub['SAMPLE_RACE']==g1], sub[sub['SAMPLE_RACE']==g0]
        r = rd_or_ci(s1['BA'].sum(), len(s1), s0['BA'].sum(), len(s0))
        rows10.append(dict(SES_level=d, comparison=f"{g1} vs {g0}",
                           n1=len(s1), x1=int(s1['BA'].sum()), rate1=s1['BA'].mean(),
                           n0=len(s0), x0=int(s0['BA'].sum()), rate0=s0['BA'].mean(), **r))
dec = pd.DataFrame(rows10)
print("\n=== SENSITIVITY: deciles, Black vs White RD (pp) with CI ===")
for d in [f'D{i+1}' for i in range(10)]:
    r = dec[(dec.SES_level==d)&(dec.comparison=='Black vs White')].iloc[0]
    flag = " [sparse: fisher/exp<5]" if r['min_expected']<5 else ""
    print(f"{d}: rates {r['rate1']*100:.2f}% vs {r['rate0']*100:.2f}% | RD={r['RD']*100:+.2f} [{r['RD_lo']*100:+.2f},{r['RD_hi']*100:+.2f}]{flag}")

# ---------- SENSITIVITY 2: continuous logistic with spline + interaction ----------
df['raceB'] = (df['SAMPLE_RACE']=='Black').astype(int)
df['raceH'] = (df['SAMPLE_RACE']=='Hispanic').astype(int)
m_lin = smf.logit('BA ~ raceB + raceH + SES + raceB:SES + raceH:SES', data=df).fit(disp=0)
print("\n=== Logistic: BA ~ race + SES + race:SES (linear interaction) ===")
print(m_lin.summary2().tables[1].round(4).to_string())
# spline for SES (natural cubic-ish via restricted pieces: use 4-knot patsy-free approach with bs basis)
try:
    from patsy import dmatrix
    spl = "bs(SES, df=4, degree=3, include_intercept=False)"
    X = dmatrix(f"{spl} + raceB + raceH + raceB:(bs(SES, df=4, degree=3, include_intercept=False)) + raceH:(bs(SES, df=4, degree=3, include_intercept=False))", df, return_type='dataframe')
    m_sp = sm.GLM(df['BA'], X, family=sm.families.Binomial()).fit()
    print("\nSpline interaction GLM converged. Interaction coefficients (raceB:spl*, raceH:spl*):")
    inter = [i for i in m_sp.params.index if 'race' in i]
    print(m_sp.summary2().tables[1].loc[inter].round(4).to_string())
    lr = 2*(m_sp.llf - smf.logit('BA ~ raceB + raceH + bs(SES, df=4, degree=3)', data=df).fit(disp=0).llf)
    print(f"LR test of race x spline-SES interaction vs main-effects-only spline model: chi2={lr:.2f}, df={len(inter)}, p={stats.chi2.sf(lr, len(inter)):.4f}")
    grid = np.linspace(df['SES'].quantile(0.02), df['SES'].quantile(0.98), 40)
    spl_expr = f"{spl} + raceB + raceH + raceB:({spl}) + raceH:({spl})"
    def pred_at(b, h):
        g = pd.DataFrame({'SES': grid, 'raceB': b, 'raceH': h})
        Xp = dmatrix(spl_expr, g, return_type='dataframe')
        return np.asarray(m_sp.predict(Xp))
    pB, pW = pred_at(1, 0), pred_at(0, 0)
    rd_curve = pd.DataFrame({'SES': grid, 'P_Black': pB, 'P_White': pW, 'RD_pp': (pB - pW) * 100})
    print("\nModel-based Black-White RD (pp) across SES (spline model; NOTE: spline coefficients unstable/near-separation, curve is exploratory):")
    print(rd_curve.iloc[::6].round(4).to_string(index=False))
    rd_curve.to_csv('outputs/rd_curve_spline.csv', index=False)
except Exception as e:
    print("spline model failed:", e)

# ---------- SUPPLEMENT: sex-stratified RD (Black vs White), quintiles ----------
rows_sex = []
for sex in ['Male','Female']:
    d_ = df[df['SAMPLE_SEX']==sex]
    for q in [f'Q{i+1}' for i in range(5)]:
        sub = d_[d_['SES_q5']==q]
        s1, s0 = sub[sub['SAMPLE_RACE']=='Black'], sub[sub['SAMPLE_RACE']=='White']
        r = rd_or_ci(s1['BA'].sum(), len(s1), s0['BA'].sum(), len(s0))
        rows_sex.append(dict(sex=sex, SES_level=q, n1=len(s1), x1=int(s1['BA'].sum()),
                             rate1=s1['BA'].mean(), n0=len(s0), x0=int(s0['BA'].sum()),
                             rate0=s0['BA'].mean(), **r))
sexdf = pd.DataFrame(rows_sex)
print("\n=== SUPPLEMENT: Black vs White RD by sex x SES quintile (descriptive) ===")
for sex in ['Male','Female']:
    print(f"-- {sex} --")
    for q in [f'Q{i+1}' for i in range(5)]:
        r = sexdf[(sexdf.sex==sex)&(sexdf.SES_level==q)].iloc[0]
        flag = " [sparse]" if r['min_expected']<5 else ""
        print(f"{q}: {r['rate1']*100:.2f}% vs {r['rate0']*100:.2f}% | RD={r['RD']*100:+.2f} [{r['RD_lo']*100:+.2f},{r['RD_hi']*100:+.2f}]{flag}")

# ---------- save ----------
main.to_csv('outputs/main_quintile_rd_or.csv', index=False)
dec.to_csv('outputs/decile_sensitivity.csv', index=False)
sexdf.to_csv('outputs/sex_stratified_rd.csv', index=False)
rate_tab.to_csv('outputs/rate_table_quintile.csv')
cnt_tab.to_csv('outputs/count_table_quintile.csv')
with open('outputs/logit_linear_interaction.json','w') as f:
    json.dump({k: float(v) for k, v in m_lin.params.items()} |
              {f'p_{k}': float(v) for k, v in m_lin.pvalues.items()}, f, indent=1)
print("\nSaved outputs: main_quintile_rd_or.csv, decile_sensitivity.csv, sex_stratified_rd.csv, rate_table_quintile.csv, count_table_quintile.csv, rd_curve_spline.csv, logit_linear_interaction.json")
