"""Requirements Engineering for ML-enabled Systems: which roles are most associated
with requirements? Winner definition + honest respondent-level bootstrap CIs."""
import pandas as pd, numpy as np

rng = np.random.default_rng(20260419)
B = 10000
df = pd.read_csv('data/requirements_engineering_for_ML-enabled_systems.csv')
ROLES = ['Project Lead / Project Manager','Business Analyst','Requirements Engineer',
         'Solution Architect','Data Scientist','Developer','Test Manager / Tester']
COL = 'Q12_ML_Most_Difficult_Activity_Aligning_Requirements_Data'   # winning definition
ALIAS = {'Project Lead / Project Manager':'Project Lead / Project Manager',
         'Business Analyst':'Business Analyst','Requirements Engineer':'Requirements Engineer',
         'Solution Architect':'Solution Architect','Data Scientist':'Data Scientist',
         'Developer':'Developer','Test Manager / Tester':'Test Manager / Tester'}

def wilson(k, n, z=1.96):
    if n == 0: return (np.nan, np.nan)
    p = k/n; d = 1 + z*z/n
    c = (p + z*z/(2*n)) / d
    h = z*np.sqrt(p*(1-p)/n + z*z/(4*n*n)) / d
    return (100*(c-h), 100*(c+h))

def boot_ci(k, n, B=B):
    if n == 0: return (np.nan, np.nan)
    draws = rng.binomial(n, k/n, size=B) / n * 100
    return tuple(np.percentile(draws, [2.5, 97.5]))

# ---------- Winning definition: D4_Role x Q12_Aligning_Requirements_Data ----------
d = df[df['Status'] != 'Suspended (22)']            # completed respondents
valid = d[COL].isin(['quoted','not quoted'])
dd = d[valid & d['D4_Role'].isin(ROLES)]
rows = []
for r in ROLES:
    s = dd.loc[dd['D4_Role']==r, COL]
    n, k = len(s), int((s=='quoted').sum())
    if n == 0: continue
    lo, hi = boot_ci(k, n); wlo, whi = wilson(k, n)
    rows.append(dict(role=r, n=n, quoted=k, pct=round(100*k/n,3),
                     boot_lo=round(lo,3), boot_hi=round(hi,3),
                     wilson_lo=round(wlo,3), wilson_hi=round(whi,3)))
win = pd.DataFrame(rows).sort_values('pct', ascending=False)
print("=== WINNER: D4_Role x Q12_ML_Most_Difficult_Activity_Aligning_Requirements_Data (completed only) ===")
print(win.to_string(index=False))
win.to_csv('output/winner_bootstrap.csv', index=False)

# ---------- Sensitivity 1: Q8 aggregated (quoted proportions), n=194 ----------
d8 = df[df['Q8_ML_Addressing_Project_Lead'].isin(['quoted','not quoted'])]
Q8 = {'Project Lead / Project Manager':'Q8_ML_Addressing_Project_Lead',
      'Business Analyst':'Q8_ML_Addressing_Business_Analyst',
      'Requirements Engineer':'Q8_ML_Addressing_Requirement_Engineer',
      'Solution Architect':'Q8_ML_Addressing_Solution_Architect',
      'Data Scientist':'Q8_ML_Addressing_Data_Scientist',
      'Developer':'Q8_ML_Addressing_Developer','Test Manager / Tester':'Q8_ML_Addressing_Tester',
      'Others':'Q8_ML_Addressing_Others'}
rows = []
for r, c in Q8.items():
    s = d8[c]; n, k = len(s), int((s=='quoted').sum())
    lo, hi = boot_ci(k, n); wlo, whi = wilson(k, n)
    rows.append(dict(role=r, n=n, quoted=k, pct=round(100*k/n,3),
                     boot_lo=round(lo,3), boot_hi=round(hi,3),
                     wilson_lo=round(wlo,3), wilson_hi=round(whi,3)))
q8t = pd.DataFrame(rows).sort_values('pct', ascending=False)
print("\n=== SENSITIVITY: Q8_ML_Addressing_* quoted proportion (all Q8 respondents, n=194) ===")
print(q8t.to_string(index=False))
q8t.to_csv('output/q8_bootstrap.csv', index=False)

# ---------- Sensitivity 2: table of per-role point estimates across definitions ----------
defn_cols = {
 'Q12_Aligning_Requirements_Data': COL,
 'Q12_Eliciting_Analyzing': 'Q12_ML_Most_Difficult_Activity_Eliciting_Analyzing',
 'Q12_Customer_Expectactions': 'Q12_ML_Most_Difficult_Activity_Customer_Expectactions',
 'Q12_Changing_Requirements': 'Q12_ML_Most_Difficult_Activity_Changing_Requirements',
 'Q1_ProblemUnderstanding_ExtremelyRelevant': 'Q1_ML_Life_Cycle_Importance_Problem_Understanding',
 'Q2_ProblemUnderstanding_VeryComplex': 'Q2_ML_Life_Cycle_Difficulty_Problem_Understanding'}
sens = {}
for name, c in defn_cols.items():
    if name.startswith('Q1_'):
        s = d[c]; v = s[~s.isin(['-77','0','-99'])]
        sel = lambda ss: ss.isin(['Extremely Relevant'])
    elif name.startswith('Q2_'):
        s = d[c]; v = s[~s.isin(['-77','0','-99'])]
        sel = lambda ss: ss.isin(['Very Complex'])
    else:
        v = d[c]; v = v[v.isin(['quoted','not quoted'])]
        sel = lambda ss: ss=='quoted'
    sens[name] = {r: (round(100*sel(v[d['D4_Role']==r]).mean(),1), int((d['D4_Role']==r).sum()))
                  for r in ROLES if (d['D4_Role']==r).sum() >= 8 and sel(v[d['D4_Role']==r]).notna().sum() > 0}
sens_df = pd.DataFrame(sens).T
print("\n=== SENSITIVITY: per-role point estimates (%(n)) across definitions (completed only) ===")
print(sens_df.to_string())
sens_df.to_csv('output/sensitivity_definitions.csv')

