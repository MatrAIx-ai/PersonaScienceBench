import pandas as pd, numpy as np

df = pd.read_csv('data/requirements_engineering_for_ML-enabled_systems.csv')
ROLES = ['Project Lead / Project Manager','Business Analyst','Requirements Engineer',
         'Solution Architect','Data Scientist','Developer','Test Manager / Tester','Other, which one?']
TARGETS = [49.6, 61.389]
TOL = 1.2

def samples(d):
    base = d[d['D4_Role'].isin(ROLES)]
    return {'all_rows': base,
            'completed_only': base[base['Status']!='Suspended (22)']}

hits = []
def add(defn, role, p, n, src):
    for t in TARGETS:
        if abs(p-t) <= TOL:
            hits.append(dict(definition=defn, role=role, pct=round(p,3), n=n, target=t))

S = samples(df)
# All Q1 / Q2 columns x top-1 / top-2 categories
for sname, d in S.items():
    for col in [c for c in df.columns if c.startswith(('Q1_','Q2_'))]:
        vals = d[col].value_counts()
        cats = [v for v in vals.index if v not in ('-77','0','-99')]
        ordered = sorted([c for c in cats if c not in ("I don't know",)],
                         key=lambda x: -vals[x])  # not meaningful order; just test each single & pairs of top cats
        for k in range(1,3):
            topk = list(vals.index[:k+0]) if False else None
        # test: each single category, and "top-2 most common non-missing"
        nonmiss = [c for c in cats if c not in ('-77','0','-99')]
        testsets = [(c,) for c in nonmiss] + [tuple(sorted(nonmiss, key=lambda x:-vals[x])[:2])]
        for catsel in testsets:
            valid = d[col].isin(nonmiss)
            dd = d[valid]
            for r in ROLES:
                ss = dd.loc[dd['D4_Role']==r, col]
                if len(ss) < 10: continue
                p = ss.isin(catsel).mean()*100
                add(f'{col}|in={catsel}|{sname}', r, p, len(ss), 'Q1/Q2')
    # Q3 all columns, thresholds
    for col in [c for c in df.columns if c.startswith('Q3_')]:
        s = pd.to_numeric(d[col], errors='coerce')
        valid = s.notna() & ~d[col].astype(str).isin(['-66','-77','-99'])
        for thr in [0,5,10,15,20,25,30]:
            for r in ROLES:
                ss = s[valid & (d['D4_Role']==r)]
                if len(ss) < 10: continue
                add(f'{col}|gt{thr}|{sname}', r, (ss>thr).mean()*100, len(ss), 'Q3')
    # all quoted/not-quoted blocks
    for prefix in ['Q8_','Q9_','Q10_','Q11_','Q12_','Q13_','Q15_','Q16_']:
        for col in [c for c in df.columns if c.startswith(prefix) and not c.endswith('_Free') and 'Yes' not in c and 'No' not in c]:
            valid = d[col].isin(['quoted','not quoted'])
            dd = d[valid]
            if len(dd) < 40: continue
            for r in ROLES:
                ss = dd.loc[dd['D4_Role']==r, col]
                if len(ss) < 10: continue
                add(f'{col}|{sname}', r, (ss=='quoted').mean()*100, len(ss), 'quoted')

res = pd.DataFrame(hits)
print("hits:", len(res))
pairs = []
for defn, g in res.groupby('definition'):
    m496 = g[abs(g['pct']-49.6)<=TOL]; m614 = g[abs(g['pct']-61.389)<=TOL]
    if len(m496) and len(m614): pairs.append((defn, list(m496.role), list(m614.role)))
print("BOTH-target definitions:")
for p in pairs: print(p)
res.to_csv('output/scan_broad_hits.csv', index=False)
