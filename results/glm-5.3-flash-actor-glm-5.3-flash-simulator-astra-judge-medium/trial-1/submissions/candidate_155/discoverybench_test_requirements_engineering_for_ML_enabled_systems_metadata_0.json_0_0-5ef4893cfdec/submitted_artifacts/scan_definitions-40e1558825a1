import pandas as pd, numpy as np, itertools, json

df = pd.read_csv('data/requirements_engineering_for_ML-enabled_systems.csv')
ROLES7 = ['Project Lead / Project Manager','Business Analyst','Requirements Engineer',
          'Solution Architect','Data Scientist','Developer','Test Manager / Tester']
TARGETS = [49.6, 61.389]
TOL = 1.5  # percentage points

# ---------- Sample variants ----------
def base_mask(d):
    # drop rows where D4_Role is placeholder '0' (missing)
    return d['D4_Role'].isin(ROLES7 + ['Other, which one?'])

samples = {}
samples['all_rows'] = df[base_mask(df)]
samples['completed_only'] = samples['all_rows'][samples['all_rows']['Status']!='Suspended (22)']

results = []
def add_hit(defn, role, p, n, note):
    for t in TARGETS:
        if abs(p - t) <= TOL:
            results.append(dict(definition=defn, role=role, pct=round(p,3), n=n, matches=round(t,3), note=note))

# ---------- Definition family 1: Q8 quoted ----------
for sname, d in samples.items():
    m = d['Q8_ML_Addressing_Project_Lead'].isin(['quoted','not quoted'])
    dd = d[m]
    for r in ROLES7 + ['Others']:
        col = 'Q8_ML_Addressing_' + r.split(' / ')[0].replace(' ','_') if r!='Others' else 'Q8_ML_Addressing_Others'
        # careful mapping
    mapping = {
        'Project Lead / Project Manager':'Q8_ML_Addressing_Project_Lead',
        'Business Analyst':'Q8_ML_Addressing_Business_Analyst',
        'Requirements Engineer':'Q8_ML_Addressing_Requirement_Engineer',
        'Solution Architect':'Q8_ML_Addressing_Solution_Architect',
        'Data Scientist':'Q8_ML_Addressing_Data_Scientist',
        'Developer':'Q8_ML_Addressing_Developer',
        'Test Manager / Tester':'Q8_ML_Addressing_Tester',
        'Others':'Q8_ML_Addressing_Others'}
    for r, col in mapping.items():
        s = dd[col]
        add_hit(f'Q8_quoted[{sname}]', r, (s=='quoted').mean()*100, len(s), 'quoted/(quoted+not quoted)')

# ---------- Definition family 2: D4_Role x Q1 (Problem Understanding importance) ----------
q1_cats_top1 = ['Extremely Relevant']
q1_cats_top2 = ['Extremely Relevant','High Relevance']
q2_cats_top1 = ['Very Complex']
q2_cats_top2 = ['Very Complex','Complex']
for sname, d in samples.items():
    for col, catsets, label in [
        ('Q1_ML_Life_Cycle_Importance_Problem_Understanding', {'top1':q1_cats_top1,'top2':q1_cats_top2}, 'Q1_ProblemUnderstanding'),
        ('Q2_ML_Life_Cycle_Difficulty_Problem_Understanding', {'top1':q2_cats_top1,'top2':q2_cats_top2}, 'Q2_ProblemUnderstanding')]:
        for k, cats in catsets.items():
            s = d[col]
            valid = ~s.isin(['-77','0','-99'])
            dd = d[valid]
            for r in ROLES7:
                ss = dd.loc[dd['D4_Role']==r, col]
                if len(ss) < 8: continue
                add_hit(f'{label}_{k}[{sname}]', r, ss.isin(cats).mean()*100, len(ss), f'in {cats}')

# ---------- Definition family 3: D4_Role x Q3 effort ----------
# effort >0 (any effort reported) and effort >= median / >=20%
for sname, d in samples.items():
    col = 'Q3_ML_Life_Cycle_Effort_Problem_Understanding'
    s = pd.to_numeric(d[col], errors='coerce')
    valid = s.notna() & ~d[col].astype(str).isin(['-66','-77','-99','0'])
    for rule in ['gt0','ge10','ge20','ge25']:
        thr = {'gt0':0,'ge10':10,'ge20':20,'ge25':25}[rule]
        for r in ROLES7:
            ss = s[valid & (d['D4_Role']==r)]
            if len(ss) < 8: continue
            add_hit(f'Q3_effort_{rule}[{sname}]', r, (ss>thr).mean()*100, len(ss), f'effort>{thr}')

# ---------- Definition family 4: D4_Role x Q12 activities (quoted) ----------
q12cols = [c for c in df.columns if c.startswith('Q12_ML_Most_Difficult_Activity_') and not c.endswith('_Free')]
for sname, d in samples.items():
    for col in q12cols:
        valid = d[col].isin(['quoted','not quoted'])
        dd = d[valid]
        if len(dd) < 30: continue
        for r in ROLES7:
            ss = dd.loc[dd['D4_Role']==r, col]
            if len(ss) < 8: continue
            add_hit(f'Q12_{col.replace("Q12_ML_Most_Difficult_Activity_","")}[{sname}]', r,
                    (ss=='quoted').mean()*100, len(ss), 'quoted proportion')

# ---------- Definition family 5: D4_Role x Q9 elicitation / Q10 documentation (quoted) ----------
for prefix in ['Q9_ML_Elicitation_','Q10_ML_Documentation_']:
    cols = [c for c in df.columns if c.startswith(prefix) and not c.endswith('_Free')]
    for sname, d in samples.items():
        for col in cols:
            valid = d[col].isin(['quoted','not quoted'])
            dd = d[valid]
            if len(dd) < 30: continue
            for r in ROLES7:
                ss = dd.loc[dd['D4_Role']==r, col]
                if len(ss) < 8: continue
                add_hit(f'{prefix}{col.replace(prefix,"")}[{sname}]', r, (ss=='quoted').mean()*100, len(ss), 'quoted proportion')

res = pd.DataFrame(results)
res.to_csv('output/scan_hits.csv', index=False)
print("Total hits within ±%.1fpp of targets: %d" % (TOL, len(res)))
# Find definitions where BOTH targets are hit AND the two roles are the top-2
pairs = []
for defn, g in res.groupby('definition'):
    m496 = g[abs(g['pct']-49.6)<=TOL]
    m614 = g[abs(g['pct']-61.389)<=TOL]
    if len(m496) and len(m614):
        pairs.append((defn, m496[['role','pct','n']].values.tolist(), m614[['role','pct','n']].values.tolist()))
print("\nDefinitions hitting BOTH targets:")
for p in pairs: print(p)
