"""
Analysis: Most commonly used technique for eliciting requirements in ML-enabled
system projects (Q9_ML_Elicitation_* columns).

Dataset: data/requirements_engineering_for_ML-enabled_systems.csv (276 respondents x 202 columns)

Encoding notes (verified during inspection):
- Q9 items are encoded as 'quoted' / 'not quoted' / '-77'.
- '-77' = item unanswered (survey dropout): the same 82 rows carry '-77' on all
  six Q9 items, and all 82 have Status 'Suspended (22)'. Excluded as NA.
- '-99' / '-66' are NA sentinels in free-text / numeric columns elsewhere.
- Free-text 'Q9_ML_Elicitation_Others' (+ '_Free') is a catch-all, not a
  rankable named technique; the candidate set is the five named techniques.

Methods:
1) Quoted-proportion per technique, three labeled denominator variants:
   (a) PRIMARY: n = 194 respondents who answered the Q9 block;
   (b) ROBUSTNESS: n = 276 (all rows, '-77' treated as non-use);
   (c) among respondents quoting >=1 named technique.
2) Bootstrap: 10,000 resamples (with replacement) of the primary sample,
   percentile 95% CI per technique, seed = 20240613.
3) Reconciliation with the quoted target figure 69.399% (95% CI [69.062, 69.735]).
"""
import numpy as np
import pandas as pd

SEED = 20240613
B = 10_000

CSV = "data/requirements_engineering_for_ML-enabled_systems.csv"
TECHS = {
    "Q9_ML_Elicitation_Interviews": "Interviews",
    "Q9_ML_Elicitation_Scenarios": "Scenarios",
    "Q9_ML_Elicitation_Prototyping": "Prototyping",
    "Q9_ML_Elicitation_Workshops_Meetings": "Workshops and meetings",
    "Q9_ML_Elicitation_Observation": "Observation",
    "Q9_ML_Elicitation_Others": "Others (free-text catch-all, not ranked)",
}

df = pd.read_csv(CSV)
n_total = len(df)
print(f"Rows (respondents): {n_total}; columns: {df.shape[1]}")

q9_cols = list(TECHS)
unanswered_mask = (df[q9_cols] == "-77").all(axis=1)
n_unanswered = int(unanswered_mask.sum())
print(f"Rows with '-77' on ALL Q9 items (unanswered/dropout): {n_unanswered}")
print("Status of those rows:", df.loc[unanswered_mask, "Status"].value_counts().to_dict())

valid = df.loc[~unanswered_mask].copy()
n_valid = len(valid)
print(f"Valid respondents for Q9: {n_valid}\n")

# ---------- Binomial indicator matrices ----------
def indicators(frame):
    return (frame[q9_cols] == "quoted").astype(int).to_numpy()

X_valid = indicators(valid)          # primary sample
X_all = (df[q9_cols] == "quoted").astype(int).to_numpy()  # all-276 variant

# ---------- Point estimates ----------
rows = []
any_quote_valid = X_valid.sum(axis=1) > 0
for j, col in enumerate(q9_cols):
    p_valid = X_valid[:, j].mean()
    p_all = X_all[:, j].mean()
    p_quoters = X_valid[any_quote_valid, j].mean()
    rows.append({
        "Technique": TECHS[col],
        "quoted_n": int(X_valid[:, j].sum()),
        "pct_of_valid_194": 100 * p_valid,
        "pct_of_all_276": 100 * p_all,
        "pct_of_quoters_174": 100 * p_quoters,
    })
point = pd.DataFrame(rows).sort_values("pct_of_valid_194", ascending=False)
print("=== Point estimates ===")
print(point.to_string(index=False, float_format=lambda v: f"{v:.3f}"))

# ---------- Bootstrap (percentile 95% CI), seed fixed ----------
rng = np.random.default_rng(SEED)
idx = rng.integers(0, n_valid, size=(B, n_valid))
boot = X_valid[idx]                      # (B, n_valid, k)
boot_means = boot.mean(axis=1) * 100     # percentage per technique
ci = np.percentile(boot_means, [2.5, 97.5], axis=0)

ci_rows = []
for j, col in enumerate(q9_cols):
    lo, hi = ci[:, j]
    ci_rows.append({
        "Technique": TECHS[col],
        "point_pct": 100 * X_valid[:, j].mean(),
        "ci_low": lo, "ci_high": hi,
    })
ci_tab = pd.DataFrame(ci_rows).sort_values("point_pct", ascending=False)
print(f"\n=== Bootstrap 95% CIs (10,000 resamples of n={n_valid}, seed={SEED}) ===")
print(ci_tab.to_string(index=False, float_format=lambda v: f"{v:.3f}"))

top = ci_tab.iloc[0]
rank_ok = (ci_tab["point_pct"].iloc[0] > ci_tab["point_pct"].iloc[1:].max())
print(f"\nTop technique: {top.Technique} at {top.point_pct:.3f}% "
      f"(95% percentile-bootstrap CI [{top.ci_low:.3f}, {top.ci_high:.3f}]); "
      f"strictly highest point estimate: {rank_ok}")

# ---------- Reconciliation with the quoted 69.399% / CI [69.062, 69.735] ----------
target, lo_t, hi_t = 69.399, 69.062, 69.735
print("\n=== Reconciliation with the quoted figure ===")
print(f"Target: {target}% (95% CI [{lo_t}, {hi_t}]); CI half-width {(hi_t-lo_t)/2:.3f} pp")
# implied effective n for a proportion at p=0.69399 with that half-width (normal approx, 1.96*SE)
p = target / 100
halfw = (hi_t - lo_t) / 200
n_implied = p * (1 - p) / (halfw / 1.96) ** 2
print(f"Implied effective n under normal approximation: ~{n_implied:,.0f}  (vs n=194 here)")
match = point[(point.pct_of_valid_194 - target).abs() < 1.0]
print("Columns with quoted-proportion within 1 pp of 69.399%:", "NONE" if match.empty else match.Technique.tolist())
print("Max reproducible elicitation proportion: %.3f%% (%s)" %
      (point.pct_of_valid_194.max(), point.Technique.iloc[0]))

# save outputs
point.to_csv("analysis/q9_point_estimates.csv", index=False)
ci_tab.to_csv("analysis/q9_bootstrap_cis.csv", index=False)
print("\nSaved: analysis/q9_point_estimates.csv, analysis/q9_bootstrap_cis.csv")
