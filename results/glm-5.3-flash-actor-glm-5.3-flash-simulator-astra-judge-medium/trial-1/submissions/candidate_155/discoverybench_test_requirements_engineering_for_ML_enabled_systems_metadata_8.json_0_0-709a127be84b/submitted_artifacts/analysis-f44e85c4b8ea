"""Least-used ML documentation formats (Q10) with respondent-level bootstrap CIs.

Data: data/requirements_engineering_for_ML-enabled_systems.csv (276 respondents x 202 cols).
Use indicator: 'quoted' (option selected) in each Q10_ML_Documentation_* option column.
The 82 rows with -77 across all Q10 option columns never received the Q10 block
(all Status 'Suspended') and are dropped for the primary analysis (valid n=194).
Bootstrap: resample respondents with replacement, B=10,000, percentile 95% CIs.
"""
import numpy as np
import pandas as pd

RNG = np.random.default_rng(20261019)
B = 10_000
DATA = 'data/requirements_engineering_for_ML-enabled_systems.csv'

df = pd.read_csv(DATA)
q10 = [c for c in df.columns if c.startswith('Q10_ML_Documentation') and not c.endswith('_Free')]
formats = [c for c in q10 if c not in ('Q10_ML_Documentation_Not_Documented',
                                       'Q10_ML_Documentation_Others')]
skip = (df[q10] == '-77').all(axis=1)

def run(sample_df, label):
    n = len(sample_df)
    ind = (sample_df[formats] == 'quoted').to_numpy(float)   # n x 10
    point = ind.mean(axis=0)
    boot = np.empty((B, len(formats)))
    for b in range(B):
        idx = RNG.integers(0, n, n)
        boot[b] = ind[idx].mean(axis=0)
    lo, hi = np.percentile(boot, [2.5, 97.5], axis=0)
    out = pd.DataFrame({'format': [c.replace('Q10_ML_Documentation_', '') for c in formats],
                        'k_quoted': ind.sum(axis=0).astype(int), 'n': n,
                        'pct_point': 100 * point, 'ci_lo': 100 * lo, 'ci_hi': 100 * hi})
    out = out.sort_values('pct_point').reset_index(drop=True)
    print(f'\n=== {label} (n={n}) ===')
    print(out.to_string(index=False, float_format=lambda x: f'{x:.3f}'))
    print('Two least-used named formats:',
          out.iloc[0]['format'], f"({out.iloc[0]['pct_point']:.3f}%, 95% CI "
          f"[{out.iloc[0]['ci_lo']:.3f}, {out.iloc[0]['ci_hi']:.3f}]) and",
          out.iloc[1]['format'], f"({out.iloc[1]['pct_point']:.3f}%, 95% CI "
          f"[{out.iloc[1]['ci_lo']:.3f}, {out.iloc[1]['ci_hi']:.3f}])")
    return out

primary = run(df[~skip], 'PRIMARY: valid Q10 respondents (drop -77 block-skipped)')
sens = run(df, 'SENSITIVITY: all 276 rows (-77 treated as not using)')

# diagnostics
print('\n=== Diagnostics ===')
print('Rows total:', len(df), '| -77 block-skipped:', int(skip.sum()),
      '| valid:', int((~skip).sum()))
print('Status of skipped rows:', dict(df.loc[skip, 'Status'].value_counts()))
print('Non-named option columns excluded from ranking: Not_Documented (30 quoted, 15.46% of 194),',
      'Others (15 quoted, 7.73% of 194; ties MLCanvas)')
print('Others quoted == MLCanvas quoted set?',
      ((df['Q10_ML_Documentation_Others'] == 'quoted') ==
       (df['Q10_ML_Documentation_MLCanvas'] == 'quoted')).all())
primary.to_csv('q10_least_used_bootstrap_primary.csv', index=False)
sens.to_csv('q10_least_used_bootstrap_sensitivity.csv', index=False)
print('Saved: q10_least_used_bootstrap_primary.csv, q10_least_used_bootstrap_sensitivity.csv')
