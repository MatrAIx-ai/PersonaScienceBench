import pandas as pd
df = pd.read_csv('data/requirements_engineering_for_ML-enabled_systems.csv')
q10 = [c for c in df.columns if c.startswith('Q10_ML_Documentation')]
print('shape:', df.shape)
for c in q10:
    print(c, dict(df[c].value_counts(dropna=False)))
m77 = (df[q10] == '-77').all(axis=1)
print('rows with -77 across all Q10 cols:', m77.sum())
print('Status of -77 rows:', dict(df.loc[m77, 'Status'].value_counts()))
