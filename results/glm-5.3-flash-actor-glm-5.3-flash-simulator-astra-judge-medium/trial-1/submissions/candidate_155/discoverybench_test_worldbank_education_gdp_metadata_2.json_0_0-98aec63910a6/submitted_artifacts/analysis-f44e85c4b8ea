"""Worldbank education expenditure vs GNI per capita: LMC vs Sub-Saharan Africa.

Frame (accepted by researcher): aggregate WDI group series; LMC = developing countries;
income = GNI per capita constant 2015 US$ (NY.GNP.PCAP.KD); expenditure = adjusted
savings: education expenditure, % of GNI (NY.ADJ.AEDU.GN.ZS); no imputation of the
36 missing SSF income years (complete-case).
"""
import numpy as np, pandas as pd, statsmodels.api as sm

df = pd.read_csv('data/worldbank_education_gdp.csv')
years = sorted((c for c in df.columns if '[YR' in c), key=lambda c: int(c.split(' ')[0]))
long = df.melt(id_vars=['Country Group','Country Code','Series Code'],
               value_vars=years, var_name='yr', value_name='val').dropna()
long['year'] = long['yr'].str.extract(r'^(\d{4})').astype(int)
panel = long.pivot_table(index=['Country Code','year'], columns='Series Code',
                         values='val', aggfunc='first').reset_index()
panel = panel.rename(columns={'NY.GNP.PCAP.KD':'gni','NY.ADJ.AEDU.GN.ZS':'edu'})
panel['lm'] = (panel['Country Code']=='LMC').astype(float)
panel['ln_gni'] = np.log(panel['gni'])
panel['ln_edu'] = np.log(panel['edu'])
panel['edu_x_lm'] = panel['edu']*panel['lm']

def ols(y, X, hac=True, label=''):
    if hac:
        m = sm.OLS(y, sm.add_constant(X)).fit(cov_type='HAC', cov_kwds={'maxlags':1})
    else:
        m = sm.OLS(y, sm.add_constant(X)).fit()
    print(f'--- {label} (n={int(m.nobs)}) ---')
    print(m.summary().tables[1])
    return m

print('=== (1) Pooled interaction model, all available income obs (LMC 1975-2015 + SSF 2011-2015, n=46) ===')
allw = panel[panel['gni'].notna()].copy()
m1 = ols(allw['ln_gni'], allw[['edu','lm','edu_x_lm']], label='ln(GNI) ~ edu + LMC + edu:LMC, HAC(1), n=46')
b_edu, b_int = m1.params['edu'], m1.params['edu_x_lm']
se_edu, se_int = m1.bse['edu'], m1.bse['edu_x_lm']
print(f"\nGroup-specific slopes: SSA beta_SSA = {b_edu:.4f} (HAC se {se_edu:.4f}, p={m1.pvalues['edu']:.4f}); "
      f"LMC beta_LMC = beta+delta = {b_edu+b_int:.4f} (HAC se via delta-method "
      f"{np.sqrt(se_edu**2 + se_int**2 + 2*m1.cov_params().loc['edu','edu_x_lm']):.4f})")
ci = m1.conf_int().loc[['edu','edu_x_lm']]
print('95% CI:\n', ci)

print('\n=== (1b) Pre-registered spec: strict overlap window 2011-2015 only (n=10) ===')
w = allw[allw['year']>=2011].copy()
m1b = ols(w['ln_gni'], w[['edu','lm','edu_x_lm']], label='ln(GNI) ~ edu + LMC + edu:LMC, HAC(1), n=10')
b_edu, b_int = m1b.params['edu'], m1b.params['edu_x_lm']
se_edu, se_int = m1b.bse['edu'], m1b.bse['edu_x_lm']
print(f"\nGroup-specific slopes (n=10): SSA beta_SSA = {b_edu:.4f} (HAC se {se_edu:.4f}, p={m1b.pvalues['edu']:.4f}); "
      f"LMC beta_LMC = {b_edu+b_int:.4f} (HAC se {np.sqrt(se_edu**2 + se_int**2 + 2*m1b.cov_params().loc['edu','edu_x_lm']):.4f})")
ci = m1b.conf_int().loc[['edu','edu_x_lm']]
print('95% CI:\n', ci)
b_edu, b_int = m1.params['edu'], m1.params['edu_x_lm']
se_edu, se_int = m1.bse['edu'], m1.bse['edu_x_lm']
print(f"\nGroup-specific slopes: SSA beta_SSA = {b_edu:.4f} (HAC se {se_edu:.4f}); "
      f"LMC beta_LMC = beta+delta = {b_edu+b_int:.4f} (HAC se via delta-method "
      f"{np.sqrt(se_edu**2 + se_int**2 + 2*m1.cov_params().loc['edu','edu_x_lm']):.4f})")
ci = m1.conf_int().loc[['edu','edu_x_lm']]
print('95% CI:\n', ci)

print('\n=== (2a) Diagnostic: within-group OLS, SSF only, overlap years 2011-2015 (n=5) ===')
m2a = ols(w[w['Country Code']=='SSF']['ln_gni'],
          w[w['Country Code']=='SSF'][['edu']], hac=False, label='SSF 2011-2015 ln(GNI) ~ edu')
print('\n=== (2b) Diagnostic: within-group OLS, LMC only, 1975-2015 (n=41) ===')
w2 = panel[(panel['Country Code']=='LMC') & panel['gni'].notna()]
m2b = ols(w2['ln_gni'], w2[['edu']], label='LMC 1975-2015 ln(GNI) ~ edu, HAC(1)')

print('\n=== (2c) Diagnostic: LMC level model is confounded by trend; add linear year trend ===')
X = w2[['edu']].copy(); X['year'] = w2['year'].values
ols(w2['ln_gni'], X, label='LMC 1975-2015 ln(GNI) ~ edu + year, HAC(1)')
print('\n=== (2d) Robustness: pooled model n=46 adding linear year trend ===')
X = allw[['edu','lm','edu_x_lm']].copy(); X['year'] = allw['year'].values
ols(allw['ln_gni'], X, label='ln(GNI) ~ edu + LMC + edu:LMC + year, HAC(1), n=46')

print('\n=== (3) Descriptive 1975-2015, fully observed series ===')
for grp in ['SSF','LMC']:
    s = panel[panel['Country Code']==grp]
    print(f"{grp}: edu %GNI 1975={s['edu'].iloc[0]:.2f} 2015={s['edu'].iloc[-1]:.2f} "
          f"mean={s['edu'].mean():.2f} | prim enr {s['SE.PRM.ENRR'].iloc[0]:.1f}->{s['SE.PRM.ENRR'].iloc[-1]:.1f} "
          f"| sec enr {s['SE.SEC.ENRR'].iloc[0]:.1f}->{s['SE.SEC.ENRR'].iloc[-1]:.1f}")
# correlation of edu with enrollment (education investment -> schooling outcome)
for grp in ['SSF','LMC']:
    s = panel[panel['Country Code']==grp]
    print(grp, 'corr(edu, prim enr) =', round(s['edu'].corr(s['SE.PRM.ENRR']),3),
          ' corr(edu, sec enr) =', round(s['edu'].corr(s['SE.SEC.ENRR']),3))
# growth rates of GNI in overlap window
for grp in ['SSF','LMC']:
    s = panel[(panel['Country Code']==grp) & panel['gni'].notna() & (panel['year']>=2011)]
    print(grp, 'GNI CAGR 2011-2015 = %.3f%%' % (100*((s['gni'].iloc[-1]/s['gni'].iloc[0])**0.25-1)),
          '| mean edu %%GNI 2011-2015 = %.2f' % s['edu'].mean())
w.to_csv('artifacts/overlap_panel.csv', index=False)
panel.to_csv('artifacts/long_panel.csv', index=False)
