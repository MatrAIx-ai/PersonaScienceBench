"""
Analysis: How does age influence the likelihood of withdrawing more money
from savings than putting in? (NLSY79, 1989; ages 24-32)

Models:
  M1  Main logistic: DISSAVED ~ AGE + AGE_2 + GENDER + log1p(INCOME) + BLACK + HISPANIC + BMI
  M2  Robustness: INCOME==47.27906396881807 and BMI==25.158945822012686 treated as
      missing -> (a) listwise deletion, (b) missing-indicator model
  M3  Robustness: BMI truncated to [15,60], refit main model
  M4  Sensitivity: multinomial logistic (baseline = put in more;
      categories: withdrew more / no change-no savings / put in more)
"""
import numpy as np
import pandas as pd
import statsmodels.api as sm
import statsmodels.formula.api as smf
from scipy import stats

INCOME_FILL = 47.27906396881807
BMI_FILL    = 25.158945822012686

df = pd.read_csv('data/nls_bmi_processed.csv')
df['FEMALE'] = (df.GENDER == 'FEMALE').astype(int)
df['log_income'] = np.log1p(df.INCOME)
df['income_imputed'] = (df.INCOME == INCOME_FILL).astype(int)
df['bmi_imputed']    = (df.BMI == BMI_FILL).astype(int)

MAIN = ('DISSAVED ~ AGE + AGE_2 + FEMALE + log_income + BLACK + HISPANIC + BMI')

def fit_logit(data, formula, label):
    m = smf.logit(formula, data=data).fit(disp=0)
    print(f"\n=== {label} (n={int(m.nobs)}) ===")
    print(m.summary2().tables[1].round(4).to_string())
    print(f"pseudo-R2 (McFadden) = {m.prsquared:.4f}, LL = {m.llf:.2f}, LL-null = {m.llnull:.2f}")
    print(f"LLR p-value = {m.llr_pvalue:.3e}")
    return m

print("#"*70, "\nMODEL 1: MAIN LOGISTIC")
m1 = fit_logit(df, MAIN, "M1 main")

# Wald tests: joint significance of AGE & AGE_2
wt = m1.wald_test('(AGE = 0), (AGE_2 = 0)', scalar=True)
print(f"Wald test AGE+AGE_2 joint: chi2={float(wt.statistic):.3f}, p={float(wt.pvalue):.3e}")
wt2 = m1.wald_test('(AGE_2 = 0)', scalar=True)
print(f"Wald test AGE_2 alone:     chi2={float(wt.statistic):.3f}, p={float(wt.pvalue):.3e}")

# Marginal effects at each age (holding others at sample means / observed mix)
ages = np.arange(24, 33)
ame_rows = []
for a in ages:
    d = df.copy(); d['AGE'] = a; d['AGE_2'] = a**2
    p = m1.predict(d)
    ame_rows.append((a, p.mean(), p.std()))
ame = pd.DataFrame(ame_rows, columns=['AGE','mean_pred_prob','sd'])
print("\nAverage predicted P(DISSAVED=1) by age (covariates at observed values):")
print(ame.round(4).to_string(index=False))
# marginal effect (discrete, age is integer): p(a+1)-p(a)
diffs = np.diff(ame['mean_pred_prob'].values)
print("\nDiscrete marginal effect per +1 year of age:", np.round(diffs,4).tolist())

# Turning point of the quadratic: d p /d age =0
b1, b2 = m1.params['AGE'], m1.params['AGE_2']
print(f"\nQuadratic coefficients: AGE={b1:.5f}, AGE_2={b2:.7f}")
if b2 != 0:
    tp = -b1/(2*b2)
    print(f"Turning point (in raw age units) = {tp:.2f} -> {'outside' if tp<24 or tp>32 else 'inside'} the observed 24-32 range")
print(f"Odds ratio per +1 year (at mean age, main effect only): OR(AGE)={np.exp(b1):.4f}, OR(AGE_2 per unit)={np.exp(b2):.6f}")

print("\n"+"#"*70, "\nMODEL 2: ROBUSTNESS - imputed values treated as missing")
d2 = df[(df.INCOME != INCOME_FILL) & (df.BMI != BMI_FILL)].copy()
m2a = fit_logit(d2, MAIN, "M2a listwise deletion of imputed rows")
print(f"rows dropped: {len(df)-len(d2)}")
m2b = fit_logit(df, MAIN + ' + income_imputed + bmi_imputed', "M2b missing-indicator model")

print("\n"+"#"*70, "\nMODEL 3: ROBUSTNESS - BMI truncated to [15,60]")
d3 = df.copy(); d3['BMI'] = d3.BMI.clip(15, 60)
m3 = fit_logit(d3, MAIN, "M3 BMI winsorized [15,60]")

print("\n"+"#"*70, "\nMODEL 4: MULTINOMIAL LOGISTIC (3 categories)")
d4 = df.copy()
d4['SAVE3'] = np.select(
    [d4.DISSAVED==1, d4.SAMESAVE==1], [1, 2], default=0)  # 0=put in more, 1=withdrew more, 2=no change
print(d4.SAVE3.value_counts().sort_index().to_dict())
mn = smf.mnlogit('SAVE3 ~ AGE + AGE_2 + FEMALE + log_income + BLACK + HISPANIC + BMI',
                 data=d4).fit(disp=0)
for _res in []:
    pass
print(mn.summary())
# manual joint Wald across both equations (SAVE3=1 and SAVE3=2)
k = len(mn.params)  # params per equation
import numpy as np
R = np.zeros((4, 2*k))
names_eq = list(mn.params.index) if hasattr(mn.params,'index') else None
p1 = mn.params  # DataFrame: rows=names, cols=['SAVE3=1','SAVE3=2']
cols = list(p1.columns)
R[0, cols.index(cols[0]) if False else list(p1.columns).index(p1.columns[0]) + 0] = 0  # placeholder
# build properly
names = list(p1.index)
R = np.zeros((4, p1.size))
def put(row, name, eq):
    R[row, names.index(name)*2 + eq] = 1
put(0,'AGE',0); put(1,'AGE_2',0); put(2,'AGE',1); put(3,'AGE_2',1)
wtm = mn.wald_test(R, scalar=True)
print(f"\nMultinomial joint Wald (AGE,AGE_2 across both equations): chi2={float(np.ravel(wtm.statistic)[0]):.3f}, p={float(np.ravel(wtm.pvalue)[0]):.3e}")

# Comparison table
print("\n"+"#"*70, "\nSUMMARY: AGE / AGE_2 coefficients across models")
rows=[]
for label, m in [("M1 main", m1), ("M2a delete imputed", m2a), ("M2b miss-indicator", m2b), ("M3 BMI winsor", m3)]:
    rows.append({"model":label, "AGE_coef":m.params['AGE'], "AGE_se":m.bse['AGE'], "AGE_p":m.pvalues['AGE'],
                 "AGE2_coef":m.params['AGE_2'], "AGE2_se":m.bse['AGE_2'], "AGE2_p":m.pvalues['AGE_2'],
                 "pseudoR2":m.prsquared, "n":int(m.nobs)})
print(pd.DataFrame(rows).round(5).to_string(index=False))

print("\n"+"#"*70, "\nDIAGNOSTIC: age pattern among imputed vs non-imputed rows")
imp = (df.INCOME == INCOME_FILL) | (df.BMI == BMI_FILL)
print("imputed rows:", int(imp.sum()),
      "| DISSAVED rate imputed:", round(df[imp].DISSAVED.mean(),3),
      "| non-imputed:", round(df[~imp].DISSAVED.mean(),3))
print("\nDISSAVED rate by age, imputed vs non-imputed:")
print(df.groupby([df.AGE, imp]).DISSAVED.mean().round(3).unstack())
print("\nAGE share: imputed vs non-imputed (column-normalized):")
print(pd.crosstab(df.AGE, imp, normalize='columns').round(3))
