"""
NLSY79: Does increased time preference (patience, proxied by saving behavior)
relate to higher BMI?

Data notes established during inspection:
- Weight variables are recorded in POUNDS (metadata says kg; contradicted by data:
  lb interpretation gives BMI median 22.1, kg gives ~49).
- Height 1981 is coded feet-inches (e.g., 507 = 5'7" = 67 in), not inches.
- Height 1985 is in inches.
- NLSY invalid/top codes: weight >= 995 (1989); savings amounts 8,192,797 and
  9,999,996; income 1979 topcode 75,001; wealth 1996 max repeated 141x.
"""
import pandas as pd, numpy as np
import statsmodels.api as sm
import statsmodels.formula.api as smf
from scipy import stats

pd.set_option('display.width', 220)
OUT = open('output/results.txt', 'w')
def P(*a):
    s = ' '.join(str(x) for x in a)
    print(s); OUT.write(s + '\n')

df = pd.read_csv('data/nls_raw.csv')
n0 = len(df)

# ---------------- cleaning ----------------
h85 = 'Height of respondent, 1985'
w89 = 'Weight of respondent, 1989'
w92 = 'Weight of respondent, 1992'
h81 = 'Height of respondent, 1981'
w81 = 'Weight of respondent, 1981'
cat = 'Was more money put into or taken out of R/spouse savings since last interview, 1989'
pin = 'Net amount respondent/spouse put into savings since last interview, 1989'
pout = 'Net amount respondent/spouse took out of savings since last interview, 1989'
w85_ = 'Family net wealth, 1985'
w96_ = 'Family net wealth, 1996 (key data point)'

d = df.copy()
# heights/weights
d['h85_in'] = d[h85].where(d[h85].between(55, 84))
d['h81_in'] = (d[h81] // 100 * 12 + d[h81] % 100).where(d[h81].between(400, 611))
d['h81_in'] = d['h81_in'].where(d['h81_in'].between(55, 84))
d['w89_lb'] = d[w89].where(d[w89].between(75, 700))
d['w92_lb'] = d[w92].where(d[w92].between(75, 700))
d['w81_lb'] = d[w81].where(d[w81].between(75, 700))
for yr, h, w in [(1981, 'h81_in', 'w81_lb'), (1989, 'h85_in', 'w89_lb'), (1992, 'h85_in', 'w92_lb')]:
    d[f'bmi{yr}'] = 703 * d[w] / d[h] ** 2
for b in ['bmi1981', 'bmi1989', 'bmi1992']:
    d[b] = d[b].where(d[b].between(15, 60))

# time-preference proxy
d['netsaver'] = (d[cat] == 1).astype(float)
d.loc[d[cat].isna(), 'netsaver'] = np.nan
d['savcat'] = d[cat].map({1: 'Put in', 2: 'Took out', 3: 'No change', 4: 'No savings'})

# net savings flow (top codes -> NaN)
pin_c = d[pin].where(d[pin] < 1e6)
pout_c = d[pout].where(d[pout] < 1e6)
d['netflow'] = np.nan
d.loc[d[cat] == 1, 'netflow'] = pin_c[d[cat] == 1]
d.loc[d[cat] == 2, 'netflow'] = -pout_c[d[cat] == 2]
d.loc[d[cat].isin([3, 4]), 'netflow'] = 0.0

# covariates
d['female'] = (d['Sex of respondent, 1979'] == 2).astype(float)
d['black'] = (d['Racial/ethnic cohort, 1979'] == 1).astype(float)
d['hisp'] = (d['Racial/ethnic cohort, 1979'] == 2).astype(float)
d['age79'] = d['Age of respondent, 1979'].astype(float)
d['educ'] = d['Highest grade completed, 1979'].where(d['Highest grade completed, 1979'] < 90)
d['meduc'] = d["Highest grade completed by respondent's mother, 1979"]
d['feduc'] = d["Highest grade completed by respondent's father, 1979"]
asv = ['ASVAB - Arithmetic Reasoning Z Score (rounded), 1981',
       'ASVAB - Word Knowledge Z Score (rounded), 1981',
       'ASVAB - Paragraph Comprehension Z Score (rounded), 1981',
       'ASVAB - Mathematics Knowledge Z Score (rounded), 1981']
d['afqt'] = d[asv].mean(axis=1)
inc79 = 'Total net family income, previous calendar year, 1979'
d['inc79'] = d[inc79].where(d[inc79] < 75000)  # drop topcode 75001
d['logincome79'] = np.log(d['inc79'].where(d['inc79'] > 0))
d['famsize'] = d['Family size, 1979'].astype(float)
# ever in jail-type residence 1981-1996
res = [c for c in d.columns if c.startswith('Type of residence')]
d['everjail'] = (d[res] == 5).any(axis=1).astype(float)

# wealth (sign-preserving log)
def slog(s):
    return np.sign(s) * np.log1p(np.abs(s))
d['wealthchg'] = slog(d[w96_]) - slog(d[w85_])
d['wealthchg_raw'] = (d[w96_] - d[w85_])
lo = d['wealthchg_raw'].quantile(.01); hi = d['wealthchg_raw'].quantile(.99)
d['wealthchg_raw'] = d['wealthchg_raw'].clip(lo, hi)

COV = ['female', 'black', 'hisp', 'age79', 'educ', 'meduc', 'feduc',
       'afqt', 'logincome79', 'famsize', 'everjail']

P('=' * 90)
P('SECTION 0. SAMPLE DEFINITIONS')
P('=' * 90)
P(f'rows={n0}')
P('n savcat nonmissing              :', int(d[cat].notna().sum()))
P('n netsaver + bmi1989 (valid)     :', int(d[['netsaver', 'bmi1989']].dropna().shape[0]))
P('n netsaver + bmi1989+1992 (valid):', int(d[['netsaver', 'bmi1989', 'bmi1992']].dropna().shape[0]))
P('n everjail=1:', int(d['everjail'].sum()))

P('')
P('=' * 90)
P('SECTION 1. DESCRIPTIVES BY SAVINGS CATEGORY (1989)')
P('=' * 90)
for b in ['bmi1989', 'bmi1992']:
    P(f'\n{b} by savcat:')
    for c in ['Put in', 'No change', 'Took out', 'No savings']:
        g = d.loc[d['savcat'] == c, b].dropna()
        P(f'  {c:10s}: n={len(g):5d}  mean={g.mean():.2f}  se={g.std()/np.sqrt(len(g)):.2f}')
    groups = [g[b].dropna() for _, g in d.groupby('savcat')]
    F, p = stats.f_oneway(*groups)
    order = {'Put in': 0, 'No change': 1, 'Took out': 2, 'No savings': 3}
    x = d['savcat'].map(order)
    ok = d[b].notna() & x.notna()
    r, pt = stats.spearmanr(x[ok], d.loc[ok, b])
    P(f'  ANOVA F={F:.3f}, p={p:.4g} | Spearman trend rho={r:.3f}, p={pt:.4g}')
P('\nnetflow by savcat:')
for c in ['Put in', 'No change', 'Took out', 'No savings']:
    g = d.loc[d['savcat'] == c, 'netflow'].dropna()
    P(f'  {c:10s}: n={len(g):5d}  median=${np.median(g):,.0f}')

P('')
P('=' * 90)
P('SECTION 2. MAIN CROSS-SECTIONAL MODELS')
P('=' * 90)
def ols_report(formula, data, label):
    m = smf.ols(formula, data=data).fit(cov_type='HC1')
    P(f'\n--- {label} ---  n={int(m.nobs)}, R2={m.rsquared:.4f}, adjR2={m.rsquared_adj:.4f}')
    for v in m.params.index:
        star = ' *' if m.pvalues[v] < .05 else ''
        P(f'  {v:15s} b={m.params[v]:9.4f}  se={m.bse[v]:.4f}  t={m.tvalues[v]:7.3f}  p={m.pvalues[v]:.4g}{star}')
    return m

m1 = ols_report('bmi1989 ~ netsaver', d, 'M1: bmi1989 ~ netsaver')
m2 = ols_report('bmi1989 ~ netsaver + ' + ' + '.join(COV), d, 'M2: bmi1989 ~ netsaver + COV')
m3 = ols_report('bmi1992 ~ netsaver', d, 'M3: bmi1992 ~ netsaver')
m4 = ols_report('bmi1992 ~ netsaver + ' + ' + '.join(COV), d, 'M4: bmi1992 ~ netsaver + COV')

P('')
P('=' * 90)
P('SECTION 3. SENSITIVITY: TREATMENT OF "NO SAVINGS" (cat 4)')
P('=' * 90)
d_no4 = d[d['savcat'].isin(['Put in', 'No change', 'Took out'])].copy()
d_no4['saver_excl4'] = (d_no4['savcat'] == 'Put in').astype(float)
m5 = ols_report('bmi1992 ~ saver_excl4 + ' + ' + '.join(COV), d_no4,
                'M5: cat4 dropped; savers vs (takers + no change)')
d_c4 = d[d['savcat'].isin(['Put in', 'Took out', 'No savings'])].copy()
d_c4['saver_vs4'] = np.where(d_c4['savcat'] == 'Put in', 1.0,
                             np.where(d_c4['savcat'] == 'No savings', 0.0, np.nan))
m6 = ols_report('bmi1992 ~ saver_vs4 + ' + ' + '.join(COV), d_c4,
                'M6: no-savings merged with takers; saver vs rest')

P('')
P('=' * 90)
P('SECTION 4. LONGITUDINAL: BMI1992 ~ SAVING(1989) + BASELINE BMI(1981) + COV')
P('=' * 90)
m7 = ols_report('bmi1992 ~ netsaver + ' + ' + '.join(COV), d,
                'M7: same spec as M4 (re-fit for coefficient comparison)')
m8 = ols_report('bmi1992 ~ netsaver + bmi1981 + ' + ' + '.join(COV), d,
                'M8: + baseline BMI1981 (primary causal mitigation)')
d['dbmi'] = d['bmi1992'] - d['bmi1981']
m9 = ols_report('dbmi ~ netsaver + ' + ' + '.join(COV), d,
                'M9: BMI change (1992-1981) ~ netsaver + COV')
P('\nCoefficient change after baseline adjustment:')
P(f'  netsaver b without baseline BMI: {m7.params["netsaver"]:.4f} (p={m7.pvalues["netsaver"]:.4g})')
P(f'  netsaver b with    baseline BMI: {m8.params["netsaver"]:.4f} (p={m8.pvalues["netsaver"]:.4g})')
P(f'  attenuation: {(1 - m8.params["netsaver"]/m7.params["netsaver"])*100:.1f}%')

P('')
P('=' * 90)
P('SECTION 5. OBESITY (BMI>=30) LOGISTIC')
P('=' * 90)
d['obese92'] = (d['bmi1992'] >= 30).astype(float).where(d['bmi1992'].notna())
L1 = smf.logit('obese92 ~ netsaver', d).fit(disp=0)
L2 = smf.logit('obese92 ~ netsaver + ' + ' + '.join(COV), d).fit(disp=0)
L3 = smf.logit('obese92 ~ netsaver + bmi1981 + ' + ' + '.join(COV), d).fit(disp=0)
for lab, m in [('L1 unadj', L1), ('L2 +cov', L2), ('L3 +baseline BMI', L3)]:
    orv = np.exp(m.params['netsaver'])
    ci = np.exp(m.conf_int().loc['netsaver'])
    P(f'  {lab}: n={int(m.nobs)}, OR={orv:.3f} [{ci[0]:.3f},{ci[1]:.3f}], p={m.pvalues["netsaver"]:.4g}, pseudoR2={m.prsquared:.4f}')

P('')
P('=' * 90)
P('SECTION 6. SUPPLEMENTARY PROXIES: NET SAVINGS FLOW & WEALTH ACCUMULATION')
P('=' * 90)
d['l_netflow'] = np.log1p(d['netflow'].abs()) * np.sign(d['netflow'])
mF = ols_report('bmi1992 ~ l_netflow + ' + ' + '.join(COV), d,
                'M-FLOW: bmi1992 ~ sign-preserving log net savings flow (1989)')
mW = ols_report('bmi1992 ~ wealthchg + ' + ' + '.join(COV), d,
                'M-WEALTH: bmi1992 ~ sign-log wealth change (1985->1996)')
mW2 = ols_report('bmi1992 ~ wealthchg_raw + ' + ' + '.join(COV), d,
                 'M-WEALTH2: bmi1992 ~ winsorized raw wealth change (1985->1996)')

P('')
P('=' * 90)
P('SECTION 7. MISSING-DATA SENSITIVITY (median imputation on covariates)')
P('=' * 90)
di = d.copy()
for v in ['educ', 'meduc', 'feduc', 'afqt', 'logincome79']:
    di[v] = di[v].fillna(di[v].median())
di['everjail'] = di['everjail'].fillna(0)
mI = ols_report('bmi1992 ~ netsaver + ' + ' + '.join(COV), di, 'M-IMP: covariate median imputation')
mI2 = ols_report('bmi1992 ~ netsaver + bmi1981 + ' + ' + '.join(COV), di,
                 'M-IMP-LONG: longitudinal with imputation')
P(f'\nComplete-case netsaver coef (M8): {m8.params["netsaver"]:.4f}; imputed (M-IMP-LONG): {mI2.params["netsaver"]:.4f}')

P('')
P('=' * 90)
P('SECTION 8. SAVERS vs TAKERS ONLY (both have accounts; cleanest contrast)')
P('=' * 90)
sub = d[d['savcat'].isin(['Put in', 'Took out'])].copy()
sub['put'] = (sub['savcat'] == 'Put in').astype(float)
mA = ols_report('bmi1992 ~ put + ' + ' + '.join(COV), sub, 'M-A: savers vs takers')
mB = ols_report('bmi1992 ~ put + bmi1981 + ' + ' + '.join(COV), sub,
                'M-B: savers vs takers + baseline BMI1981')

OUT.close()
print('\nDONE -> output/results.txt')
