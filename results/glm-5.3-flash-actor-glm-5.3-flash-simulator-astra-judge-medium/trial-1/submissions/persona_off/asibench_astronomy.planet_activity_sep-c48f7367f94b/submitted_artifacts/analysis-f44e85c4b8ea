"""
asibench:astronomy.planet_activity_sep

Recover latent per-case summary (offset, component-A sinusoid at P_A, component-B
fundamental + first harmonic at P_B, all relative to reference_epoch_day from
input_0.json) from the primary channel obs_0 of input_1.csv, and predict future
component-A-only values at the times listed in input_2.csv.

Method
------
1. Per case, weighted least squares (weights 1/obs_0_err^2) on obs_0 with the
   7-parameter model
       m(t) = c0
            + a1*sin(2*pi*(t-t0)/P_A) + a2*cos(2*pi*(t-t0)/P_A)
            + b1*sin(2*pi*(t-t0)/P_B) + b2*cos(2*pi*(t-t0)/P_B)
            + b3*sin(4*pi*(t-t0)/P_B) + b4*cos(4*pi*(t-t0)/P_B)
   with t0 = reference_epoch_day.  (P_A, P_B) are found by a global dense 2-D
   grid scan over [4, 150] d followed by two local refinement passes; the linear
   coefficients are solved analytically at every grid node.
2. Presence of component A is decided by the likelihood-ratio statistic
       dchi2 = chi2(B-only global best) - chi2(full global best),
   which follows chi2_2 under the null; the scan maximum under the null is
   expected at ~10-15, while true detections here give 105-290.  Threshold: 30.
3. For cases with component_a_present = 0 the contract forces P_A, a1, a2 and
   all future component_a_value_u0 to 0.0 (B and offset are still reported).
4. Outputs: signal_summary.csv (4 rows) and target_predictions.csv (one row per
   input_2.csv row, same order, case_id/time_day copied verbatim).
"""
import json
import numpy as np
import pandas as pd

DATA0 = "data/input_0.json"
DATA1 = "data/input_1.csv"
DATA2 = "data/input_2.csv"

CHI2_PRESENCE_THRESHOLD = 30.0  # dchi2 (2 params) for declaring component A present


def wls_chi2_beta(t_rel, v, err, cols):
    """Weighted least squares; returns (chi2, beta)."""
    X = np.column_stack(cols)
    w = 1.0 / np.asarray(err) ** 2
    Xw = X * np.sqrt(w)[:, None]
    vw = np.asarray(v) * np.sqrt(w)
    beta, *_ = np.linalg.lstsq(Xw, vw, rcond=None)
    r = vw - Xw @ beta
    return float(np.sum(r * r)), beta


def basis_cols(t_rel, P_A, P_B, with_A=True, with_B=True):
    cols = [np.ones_like(t_rel)]
    if with_A:
        cols += [np.sin(2 * np.pi * t_rel / P_A), np.cos(2 * np.pi * t_rel / P_A)]
    if with_B:
        w1 = 2 * np.pi / P_B
        cols += [np.sin(w1 * t_rel), np.cos(w1 * t_rel),
                 np.sin(2 * w1 * t_rel), np.cos(2 * w1 * t_rel)]
    return cols


def main():
    with open(DATA0) as fh:
        meta = json.load(fh)
    t0_epoch = float(meta["reference_epoch_day"])          # = 0.0 for this task
    case_order = list(meta["case_order"])

    obs = pd.read_csv(DATA1)
    tgt_raw = pd.read_csv(DATA2, dtype=str)                # verbatim copy of ids/times
    tgt_time = tgt_raw["time_day"].astype(float).values

    summary_rows = []
    pred_rows = []
    audit = []

    for case in case_order:
        g = obs[obs["case_id"] == case]
        t = g["time_day"].values
        v = g["obs_0"].values
        e = g["obs_0_err"].values
        t_rel = t - t0_epoch

        # ---- B-only global scan (dense, 1-D) --------------------------------
        bestB = None
        for P_B in np.arange(4.0, 150.0 + 1e-9, 0.005):
            chi2, _ = wls_chi2_beta(t_rel, v, e, basis_cols(t_rel, None, P_B, with_A=False))
            if bestB is None or chi2 < bestB[0]:
                bestB = (chi2, P_B)
        chi2_B, _ = bestB

        # ---- full (A + B) global 2-D scan -----------------------------------
        coarse = np.arange(4.0, 150.0 + 1e-9, 0.5)
        Sc = np.sin(2 * np.pi * np.outer(t_rel, 1.0 / coarse))
        Cc = np.cos(2 * np.pi * np.outer(t_rel, 1.0 / coarse))
        best = None
        for i, P_A in enumerate(coarse):
            sa, ca = Sc[:, i], Cc[:, i]
            for j, P_B in enumerate(coarse):
                w1 = 2 * np.pi / P_B
                cols = [np.ones_like(t_rel), sa, ca,
                        np.sin(w1 * t_rel), np.cos(w1 * t_rel),
                        np.sin(2 * w1 * t_rel), np.cos(2 * w1 * t_rel)]
                chi2, beta = wls_chi2_beta(t_rel, v, e, cols)
                if best is None or chi2 < best[0]:
                    best = (chi2, P_A, P_B, beta)
        # local refinements
        for step, half in ((0.02, 0.6), (0.002, 0.03)):
            _, PAc, PBc, _ = best
            for P_A in np.arange(PAc - half, PAc + half + 1e-12, step):
                for P_B in np.arange(PBc - half, PBc + half + 1e-12, step):
                    chi2, beta = wls_chi2_beta(
                        t_rel, v, e, basis_cols(t_rel, P_A, P_B))
                    if chi2 < best[0]:
                        best = (chi2, P_A, P_B, beta)
        chi2_F, P_A, P_B, beta = best

        dchi2 = chi2_B - chi2_F
        present = dchi2 >= CHI2_PRESENCE_THRESHOLD
        dof = len(t) - (7 if present else 5)

        offset = float(beta[0])
        b1, b2, b3, b4 = (float(x) for x in beta[-4:])
        if present:
            a1, a2 = float(beta[1]), float(beta[2])
            summary_rows.append([case, 1, f"{P_A:.10g}", f"{a1:.10g}", f"{a2:.10g}",
                                 f"{P_B:.10g}", f"{b1:.10g}", f"{b2:.10g}",
                                 f"{b3:.10g}", f"{b4:.10g}", f"{offset:.10g}"])
            # epoch-invariant component-A-only extrapolation
            ph = 2 * np.pi * (tgt_time[[i for i, c in enumerate(tgt_raw["case_id"]) if c == case]] - t0_epoch) / P_A
            for idx, tt in zip([i for i, c in enumerate(tgt_raw["case_id"]) if c == case], ph):
                pred_rows.append((idx, case, tgt_raw["time_day"].iloc[idx],
                                  f"{a1 * np.sin(tt) + a2 * np.cos(tt):.10g}"))
            a_amp = float(np.hypot(a1, a2))
        else:
            summary_rows.append([case, 0, "0", "0", "0",
                                 f"{P_B:.10g}", f"{b1:.10g}", f"{b2:.10g}",
                                 f"{b3:.10g}", f"{b4:.10g}", f"{offset:.10g}"])
            for idx, c in enumerate(tgt_raw["case_id"]):
                if c == case:
                    pred_rows.append((idx, case, tgt_raw["time_day"].iloc[idx], "0"))
            a_amp = 0.0
            a1 = a2 = float("nan")

        audit.append(dict(case=case, P_A=P_A if present else None, P_B=P_B,
                          a1=a1, a2=a2, b1=b1, b2=b2, b3=b3, b4=b4,
                          offset=offset, a_amp=a_amp,
                          chi2_full=chi2_F, dof=dof,
                          chi2_full_dof=chi2_F / dof, chi2_B=chi2_B, dchi2=dchi2,
                          present=present))

    # ---- write outputs ------------------------------------------------------
    hdr = ("case_id,component_a_present,component_a_period_day,component_a_basis1_u0,"
           "component_a_basis2_u0,component_b_period_day,component_b_basis1_u0,"
           "component_b_basis2_u0,component_b_basis3_u0,component_b_basis4_u0,offset_u0")
    with open("signal_summary.csv", "w") as fh:
        fh.write(hdr + "\n")
        for row in summary_rows:
            fh.write(",".join(str(x) for x in row) + "\n")

    pred_rows.sort(key=lambda r: r[0])
    with open("target_predictions.csv", "w") as fh:
        fh.write("case_id,time_day,component_a_value_u0\n")
        for _, case, tday, val in pred_rows:
            fh.write(f"{case},{tday},{val}\n")

    # ---- audit print --------------------------------------------------------
    print(f"reference_epoch_day = {t0_epoch}")
    for a in audit:
        print(f"{a['case']}: present={a['present']} P_A={a['P_A']} P_B={a['P_B']:.4f}")
        print(f"   A: a1={a['a1']} a2={a['a2']} amp={a['a_amp']}")
        print(f"   B: b1={a['b1']:.4f} b2={a['b2']:.4f} b3={a['b3']:.4f} b4={a['b4']:.4f} offset={a['offset']:.4f}")
        print(f"   chi2_full={a['chi2_full']:.2f} dof={a['dof']} chi2/dof={a['chi2_full_dof']:.3f} "
              f"chi2_Bonly={a['chi2_B']:.2f} dchi2(A)={a['dchi2']:.2f}")


if __name__ == "__main__":
    main()
