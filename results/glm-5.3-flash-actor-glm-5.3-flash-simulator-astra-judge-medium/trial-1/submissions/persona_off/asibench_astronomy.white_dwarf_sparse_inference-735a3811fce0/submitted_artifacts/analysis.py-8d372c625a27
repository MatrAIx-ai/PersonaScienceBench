#!/usr/bin/env python3
"""
Sparse/Noisy Compact-Star Sequence Reconstruction
=================================================

Reconstructs a physically self-consistent cold, non-rotating compact-star
(stable-branch) sequence from sparse noisy M-R observations and partial noisy
internal profile fragments, then predicts holdout M-R values and normalized
internal profiles requested in data/query_targets.json.

Model and conventions:
----------------------
* M-R sequence: weighted Chandrasekhar/Nauenberg-type family
      R(M) = A * sqrt( (Mlim/M)^(2/3) - (M/Mlim)^(2/3) ),  R in km, M in Msun
  - R decreases monotonically with M along the stable branch (manifest).
  - The terminal mass of the family is Mlim (R -> 0 as M -> Mlim).
  - MASS LIMIT INTERPRETATION (transparent documentation):
    `mass_limit_solar` is reported as the fitted-family Chandrasekhar-like
    parameter Mlim (~1.44).  An alternative interpretation is that the true
    sequence terminates at a turning point near ~1.32-1.33 Msun (hinted by the
    dense clustering of the eval masses just below 1.32).  The data cannot
    distinguish these; we report the fitted-family value and quantify the
    model-form risk with a 3-parameter turning-point variant (finite R at
    Mlim) via delta-chi2 / AIC.
* Profiles: flexible empirical family (validated against the data)
      density_fraction(x) = (1 - x^a)^b,   x = r/R in [0, 1]
  with a(M), b(M) smooth (linear) functions of mass, fitted GLOBALLY to all
  three fragments jointly using BOTH channels (density and enclosed mass) =>
  a single smooth family along one stable sequence.
  Normalization conventions:
      - density_fraction(0) = 1 exactly  (rho/rho_center = 1 at the center)
      - density_fraction(1) = 0 exactly  (below the manifest surface
        threshold 1e-4 at the surface)
      - enclosed_mass_fraction(x) = int_0^x t^2 rho_f(t) dt /
                                    int_0^1 t^2 rho_f(t) dt
        so enclosed_mass_fraction(1) = 1 EXACTLY on the output grid.
  Integration uses a fine uniform grid + cumulative trapezoid rule, NOT
  scipy.quad, because quad silently fails on the derivative kink at x=1.
* Noise: independent Gaussian with the per-point sigmas given in the CSVs
  (physics_manifest noise contract).  For M-R the mass uncertainty is folded
  in through the effective-variance approximation
  sigma_eff^2 = sigma_R^2 + (dR/dM * sigma_M)^2.
* Uncertainties: parametric bootstrap (resynthesize data from the fitted
  model using the quoted sigmas, refit, percentile bands) for M-R
  predictions, Mlim, and profile curves.
* Consistency: summary.json radii and mr_reconstruction.csv come from the
  SAME fitted M-R curve; profile predictions come from the SAME global
  profile family.  No independently fitted values anywhere.

Output NPZ layout: arrays `density_fraction` and `enclosed_mass_fraction`,
each of shape (3, 99): rows ordered as profile_target_masses_solar =
[0.6, 1.0, 1.3] Msun, columns = radius_fraction_grid from query_targets.json.
(Neither the manifest nor query_targets.json specifies any other shape.)

NOTE on plotting: if matplotlib is importable it is used; otherwise a
self-contained pure-numpy PNG renderer (bitmap font, lines, error bars,
filled bands) produces an equivalent figure, so the script runs on systems
without matplotlib.
"""

import json
import struct
import zlib
from pathlib import Path

import numpy as np
import pandas as pd
from scipy.optimize import least_squares

RNG = np.random.default_rng(20261020)
DATA = Path("data")
OUT = Path("results")
OUT.mkdir(exist_ok=True)

# ----------------------------------------------------------------------------
# Load inputs
# ----------------------------------------------------------------------------
mr = pd.read_csv(DATA / "mr_observations.csv")
pf = pd.read_csv(DATA / "profile_fragments.csv")
qt = json.load((DATA / "query_targets.json").open())
manifest = json.load((DATA / "physics_manifest.json").open())

M_obs = mr["mass_solar_obs"].to_numpy()
R_obs = mr["radius_km_obs"].to_numpy()
sM = mr["sigma_mass_solar"].to_numpy()
sR = mr["sigma_radius_km"].to_numpy()

eval_masses = np.asarray(qt["mr_eval_masses_solar"], float)
prof_masses = np.asarray(qt["profile_target_masses_solar"], float)
xgrid = np.asarray(qt["radius_fraction_grid"], float)

# ----------------------------------------------------------------------------
# Part 1: M-R sequence (2-parameter Nauenberg-type weighted fit)
# ----------------------------------------------------------------------------
def mr_model(M, A, Mlim):
    t = (Mlim / M) ** (2.0 / 3.0) - (M / Mlim) ** (2.0 / 3.0)
    return A * np.sqrt(np.clip(t, 1e-12, None))

def mr_residuals(p, M, R, s_eff):
    return (mr_model(M, *p) - R) / s_eff

def eff_sigma(p, M, sM_, sR_):
    # effective variance: fold mass uncertainty into radius uncertainty
    A, Mlim = p
    h = 1e-6 * M
    lo = np.maximum(M - h, 1e-3)
    dRdM = (mr_model(M + h, A, Mlim) - mr_model(lo, A, Mlim)) / (M + h - lo)
    return np.sqrt(sR_**2 + (dRdM * sM_)**2)

def fit_mr(M, R, sM_, sR_, p0=(7600.0, 1.4356)):
    p = np.array(p0, float)
    s_eff = eff_sigma(p, M, sM_, sR_)
    for _ in range(3):  # iterate effective variance to convergence
        s_eff = eff_sigma(p, M, sM_, sR_)
        r = least_squares(mr_residuals, p, args=(M, R, s_eff),
                          bounds=([1000.0, 1.1], [50000.0, 3.0]))
        p = r.x
    chi2 = float(np.sum(mr_residuals(p, M, R, s_eff)**2))
    return p, chi2, s_eff

p_fit, chi2_mr, s_eff_fit = fit_mr(M_obs, R_obs, sM, sR)
A_fit, Mlim_fit = p_fit
chi2_red_mr = chi2_mr / (len(M_obs) - 2)

# --- diagnostic: 3-parameter turning-point variant (finite R at Mlim) --------
def mr_model_tp(M, A, Mlim, R0):
    return R0 + mr_model(M, A, Mlim)

def fit_mr_tp(M, R, sM_, sR_, p0=(7600.0, 1.4356, 0.0)):
    p = np.array(p0, float)
    for _ in range(3):
        def res(pp, M, R):
            h = 1e-6 * M
            lo = np.maximum(M - h, 1e-3)
            dRdM = (mr_model_tp(M + h, *pp) - mr_model_tp(lo, *pp)) / (M + h - lo)
            s_eff = np.sqrt(sR_**2 + (dRdM * sM_)**2)
            return (mr_model_tp(M, *pp) - R) / s_eff
        r = least_squares(res, p, args=(M, R),
                          bounds=([1000.0, 1.1, -5000.0], [50000.0, 3.0, 5000.0]))
        p = r.x
    h = 1e-6 * M
    lo = np.maximum(M - h, 1e-3)
    dRdM = (mr_model_tp(M + h, *p) - mr_model_tp(lo, *p)) / (M + h - lo)
    s_eff = np.sqrt(sR_**2 + (dRdM * sM_)**2)
    chi2 = float(np.sum(((mr_model_tp(M, *p) - R) / s_eff)**2))
    return p, chi2

p_tp, chi2_tp = fit_mr_tp(M_obs, R_obs, sM, sR)
aic2, aic3 = chi2_mr + 4, chi2_tp + 6
tp_improves = aic3 < aic2 - 2.0
print("M-R 2-param fit:      A=%.1f km  Mlim=%.4f Msun  chi2=%.2f chi2/dof=%.3f"
      % (A_fit, Mlim_fit, chi2_mr, chi2_red_mr))
print("M-R 3-param variant:  A=%.1f  Mlim=%.4f  R0=%.1f km  chi2=%.2f chi2/dof=%.3f"
      % (*p_tp, chi2_tp, chi2_tp / (len(M_obs) - 3)))
print("  delta-chi2 = %.2f, AIC2=%.2f, AIC3=%.2f -> %s"
      % (chi2_mr - chi2_tp, aic2, aic3,
         "KEEP 2-PARAM (no decisive AIC improvement)" if not tp_improves
         else "3-PARAM FAVORED"))
if not tp_improves:
    print("  NOTE: the near-tie (delta-AIC=%.2f) and the turning-point family's"
          % (aic2 - aic3))
    print("  preference for Mlim~%.3f with finite R(Mlim)~%.0f km -- together"
          % (p_tp[1], p_tp[2]))
    print("  with the eval masses clustering just below 1.32 -- is documented as"
          " the alternative mass-limit interpretation (~1.32-1.33).")
print("  M-R pulls:", np.round(mr_residuals(p_fit, M_obs, R_obs, s_eff_fit), 2))

# --- parametric bootstrap for M-R -------------------------------------------
NBOOT_MR = 500
boot_mr, n_discard = [], 0
for _ in range(NBOOT_MR):
    Mb = RNG.normal(M_obs, sM)
    Rb = RNG.normal(mr_model(Mb, *p_fit), sR)
    try:
        pb, _, _ = fit_mr(Mb, Rb, sM, sR, p0=p_fit)
    except Exception:
        n_discard += 1
        continue
    if pb[1] <= eval_masses.max() + 1e-3:  # family cannot cover the eval range
        n_discard += 1
        continue
    boot_mr.append(pb)
boot_mr = np.array(boot_mr)
print("MR bootstrap: %d/%d accepted (%d discarded: Mlim below eval range)" %
      (len(boot_mr), NBOOT_MR, n_discard))

R_eval = mr_model(eval_masses, *p_fit)
BM, BL = boot_mr[:, 0][:, None], boot_mr[:, 1][:, None]
R_eval_band = np.percentile(mr_model(eval_masses[None, :], BM, BL), [16, 84], axis=0)
summary_masses = np.array([0.6, 1.0, 1.2, 1.3])
R_sum = mr_model(summary_masses, *p_fit)
R_sum_band = np.percentile(mr_model(summary_masses[None, :], BM, BL), [16, 84], axis=0)
Mlim_band = np.percentile(boot_mr[:, 1], [16, 84])
print("Mlim bootstrap 16/84: %.4f / %.4f" % tuple(Mlim_band))
for m, r, lo, hi in zip(summary_masses, R_sum, R_sum_band[0], R_sum_band[1]):
    print("  R(%.1f Msun) = %.1f km  [bootstrap 16-84: %.1f, %.1f]" % (m, r, lo, hi))

# ----------------------------------------------------------------------------
# Part 2: profiles -- global joint fit of (1 - x^a)^b with a(M), b(M) linear
# ----------------------------------------------------------------------------
T = np.linspace(0.0, 1.0, 20001)          # fine grid, cumulative trapezoid
DT = T[1] - T[0]

def rho_f(x, a, b):
    return np.clip(1.0 - x**a, 0.0, None) ** b

def cum_mass(x, a, b):
    """Enclosed-mass integral on the fine grid, interpolated to x.
    Normalized so that m(1) = 1 exactly."""
    r = rho_f(T, a, b)
    W = np.concatenate([[0.0], np.cumsum(0.5 * (T[1:]**2 * r[1:] + T[:-1]**2 * r[:-1])) * DT])
    return np.interp(x, T, W) / W[-1]

frag_masses = np.sort(pf["target_mass_solar"].unique())
rows_d, rows_m = [], []
for fm in frag_masses:
    g = pf[pf["target_mass_solar"] == fm]
    gd = g.dropna(subset=["density_fraction_obs"])
    gm = g.dropna(subset=["enclosed_mass_fraction_obs"])
    rows_d.append((fm, gd["radius_fraction"].to_numpy(), gd["density_fraction_obs"].to_numpy(),
                   gd["sigma_density_fraction"].to_numpy()))
    rows_m.append((fm, gm["radius_fraction"].to_numpy(), gm["enclosed_mass_fraction_obs"].to_numpy(),
                   gm["sigma_enclosed_mass_fraction"].to_numpy()))

def profile_residuals(p):
    a0, a1, b0, b1 = p
    out = []
    for fm, x, d, s in rows_d:
        a, b = a0 + a1 * fm, b0 + b1 * fm
        out.append((rho_f(x, a, b) - d) / s)
    for fm, x, m, s in rows_m:
        a, b = a0 + a1 * fm, b0 + b1 * fm
        out.append((cum_mass(x, a, b) - m) / s)
    return np.concatenate(out)

PROF_BOUNDS = ([0.3, -2.0, 0.3, -5.0], [6.0, 2.0, 20.0, 10.0])
r_prof = least_squares(profile_residuals, [1.5, 0.0, 2.5, 1.5], bounds=PROF_BOUNDS)
a0, a1, b0, b1 = r_prof.x
chi2_prof = float(np.sum(profile_residuals(r_prof.x)**2))
nprof = sum(len(x) for _, x, _, _ in rows_d) + sum(len(x) for _, x, _, _ in rows_m)
chi2_red_prof = chi2_prof / (nprof - 4)
print("\nGlobal profile fit: a(M) = %.4f %+.4f*M, b(M) = %.4f %+.4f*M" % (a0, a1, b0, b1))
print("  profile chi2 = %.2f, chi2/dof = %.3f (n=%d, p=4)" % (chi2_prof, chi2_red_prof, nprof))
for fm, x, d, s in rows_d:
    print("  frag %.2f density pulls:" % fm,
          np.round((rho_f(x, a0 + a1 * fm, b0 + b1 * fm) - d) / s, 2))
for fm, x, m, s in rows_m:
    print("  frag %.2f mass    pulls:" % fm,
          np.round((cum_mass(x, a0 + a1 * fm, b0 + b1 * fm) - m) / s, 2))

# diagnostic: quadratic b(M) variant (5 params) -- reported, not adopted
def profile_residuals_q(p):
    a0, a1, b0, b1, b2 = p
    out = []
    for fm, x, d, s in rows_d:
        out.append((rho_f(x, a0 + a1 * fm, b0 + b1 * fm + b2 * fm * fm) - d) / s)
    for fm, x, m, s in rows_m:
        out.append((cum_mass(x, a0 + a1 * fm, b0 + b1 * fm + b2 * fm * fm) - m) / s)
    return np.concatenate(out)

r_q = least_squares(profile_residuals_q, [1.5, 0.0, 2.5, 1.5, 0.0],
                    bounds=([0.3, -2.0, 0.3, -5.0, -5.0], [6.0, 2.0, 20.0, 10.0, 5.0]))
chi2_q = float(np.sum(profile_residuals_q(r_q.x)**2))
print("  diagnostic quadratic-b(M) (5p): chi2=%.2f chi2/dof=%.3f AIC=%.2f "
      "(linear AIC=%.2f) -> %s"
      % (chi2_q, chi2_q / (nprof - 5), chi2_q + 10, chi2_prof + 8,
         "quad favored by AIC; predictions at 0.6/1.0/1.3 similar (b(1.3): %.2f vs %.2f)"
         % (r_q.x[2] + r_q.x[3] * 1.3 + r_q.x[4] * 1.69, b0 + b1 * 1.3)
         if chi2_q + 10 < chi2_prof + 8 - 2 else "linear kept"))

dens_out = np.zeros((3, len(xgrid)))
mass_out = np.zeros((3, len(xgrid)))
for i, M in enumerate(prof_masses):
    dens_out[i] = rho_f(xgrid, a0 + a1 * M, b0 + b1 * M)
    mass_out[i] = cum_mass(xgrid, a0 + a1 * M, b0 + b1 * M)

# normalization checks on the output grid
assert np.isclose(dens_out[:, 0], 1.0).all(), "density_fraction(0) must be 1"
assert np.isclose(mass_out[:, -1], 1.0).all(), "enclosed_mass_fraction(1) must be 1"
assert (dens_out[:, -1] < manifest["surface_threshold"]).all()
print("Normalization checks: density_fraction(0)=1 exact; enclosed_mass_fraction(1)=1 exact;")
print("  density_fraction(1) = %s < surface_threshold=%g"
      % (np.array2string(dens_out[:, -1], precision=3), manifest["surface_threshold"]))

# --- parametric bootstrap for profiles ---------------------------------------
NBOOT_PF = 400
boot_prof = []
for it in range(NBOOT_PF):
    rows_d_b, rows_m_b = [], []
    for fm, x, d, s in rows_d:
        rows_d_b.append((fm, x, RNG.normal(rho_f(x, a0 + a1 * fm, b0 + b1 * fm), s), s))
    for fm, x, m, s in rows_m:
        rows_m_b.append((fm, x, RNG.normal(cum_mass(x, a0 + a1 * fm, b0 + b1 * fm), s), s))
    rows_d_saved, rows_m_saved = rows_d, rows_m
    rows_d, rows_m = rows_d_b, rows_m_b
    try:
        rb = least_squares(profile_residuals, r_prof.x, bounds=PROF_BOUNDS)
        a0b, a1b, b0b, b1b = rb.x
        if all(0.3 < a0b + a1b * M and 0.3 < b0b + b1b * M for M in prof_masses):
            dd = [rho_f(xgrid, a0b + a1b * M, b0b + b1b * M) for M in prof_masses]
            mm = [cum_mass(xgrid, a0b + a1b * M, b0b + b1b * M) for M in prof_masses]
            boot_prof.append((np.array(dd), np.array(mm)))
    except Exception:
        pass
    rows_d, rows_m = rows_d_saved, rows_m_saved
boot_prof = np.array(boot_prof)
print("Profile bootstrap: %d/%d accepted" % (len(boot_prof), NBOOT_PF))
dens_band = np.percentile(boot_prof[:, 0], [16, 84], axis=0)
mass_band = np.percentile(boot_prof[:, 1], [16, 84], axis=0)
for i, M in enumerate(prof_masses):
    print("  M=%.1f: median bootstrap 16-84 width: density %.3f, mass %.3f" %
          (M, np.median(dens_band[1, i] - dens_band[0, i]),
           np.median(mass_band[1, i] - mass_band[0, i])))

# ----------------------------------------------------------------------------
# Write outputs
# ----------------------------------------------------------------------------
pd.DataFrame({"mass_solar": eval_masses, "radius_km": R_eval}).to_csv(
    OUT / "mr_reconstruction.csv", index=False)

np.savez(OUT / "profiles_reconstruction.npz",
         density_fraction=dens_out, enclosed_mass_fraction=mass_out)

summary = {
    "mass_limit_solar": float(Mlim_fit),
    "radius_at_0p6Msun_km": float(R_sum[0]),
    "radius_at_1p0Msun_km": float(R_sum[1]),
    "radius_at_1p2Msun_km": float(R_sum[2]),
    "radius_at_1p3Msun_km": float(R_sum[3]),
}
(OUT / "summary.json").write_text(json.dumps(summary, indent=2) + "\n")

# Figure data shared by both plotting backends
xx = np.linspace(0, 1, 400)
Mgrid = np.linspace(0.2, min(1.42, Mlim_fit * 0.995), 400)
COLORS = {"seq": (31, 119, 180), "band": (31, 119, 180), "obs": (0, 0, 0),
          "pred": (255, 127, 14), "star": (214, 39, 40),
          "p0": (44, 160, 44), "p1": (214, 39, 40), "p2": (148, 103, 189)}
prof_colors = [COLORS["p0"], COLORS["p1"], COLORS["p2"]]

try:
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt

    fig, axes = plt.subplots(2, 2, figsize=(13, 10))
    ax = axes[0, 0]
    band = np.percentile(mr_model(Mgrid[None, :], BM, BL), [16, 84], axis=0)
    ax.fill_between(Mgrid, band[0], band[1], alpha=0.2, color="#1f77b4",
                    label="bootstrap 16-84%")
    ax.plot(Mgrid, mr_model(Mgrid, *p_fit), "C0-", label="reconstructed sequence")
    ax.errorbar(M_obs, R_obs, xerr=sM, yerr=sR, fmt="ko", ms=4, capsize=2,
                label="observations")
    ax.plot(eval_masses, R_eval, "C1.", ms=6, label="holdout predictions")
    for m, r in zip(summary_masses, R_sum):
        ax.plot(m, r, "r*", ms=12)
    ax.set_xlabel("M / Msun"); ax.set_ylabel("R / km")
    ax.set_title("M-R sequence (Nauenberg-type weighted fit)\n"
                 "A=%.0f km, Mlim=%.4f Msun, chi2/dof=%.2f"
                 % (A_fit, Mlim_fit, chi2_red_mr))
    ax.legend(fontsize=8); ax.invert_xaxis()

    ax = axes[0, 1]
    for fm, x, d, s in rows_d:
        ax.errorbar(x, d, yerr=s, fmt="o", ms=4, capsize=2, label="obs M=%.2f" % fm)
    for M, c in zip(prof_masses, ["C2", "C3", "C4"]):
        i = list(prof_masses).index(M)
        ax.plot(xx, rho_f(xx, a0 + a1 * M, b0 + b1 * M), c + "-", label="recon M=%.1f" % M)
        ax.fill_between(xx, np.interp(xx, xgrid, dens_band[0][i]),
                        np.interp(xx, xgrid, dens_band[1][i]), color=c, alpha=0.15)
    ax.set_xlabel("r/R"); ax.set_ylabel("rho/rho_c")
    ax.set_title("Density profiles"); ax.legend(fontsize=7)

    ax = axes[1, 0]
    for fm, x, m, s in rows_m:
        ax.errorbar(x, m, yerr=s, fmt="o", ms=4, capsize=2, label="obs M=%.2f" % fm)
    for M, c in zip(prof_masses, ["C2", "C3", "C4"]):
        i = list(prof_masses).index(M)
        ax.plot(xx, cum_mass(xx, a0 + a1 * M, b0 + b1 * M), c + "-", label="recon M=%.1f" % M)
        ax.fill_between(xx, np.interp(xx, xgrid, mass_band[0][i]),
                        np.interp(xx, xgrid, mass_band[1][i]), color=c, alpha=0.15)
    ax.set_xlabel("r/R"); ax.set_ylabel("m(<r)/M")
    ax.set_title("Enclosed-mass profiles"); ax.legend(fontsize=7)

    ax = axes[1, 1]
    ax.hist(mr_residuals(p_fit, M_obs, R_obs, s_eff_fit), bins=8, alpha=0.6,
            label="M-R pulls")
    ax.hist(profile_residuals(r_prof.x), bins=12, alpha=0.6, label="profile pulls")
    ax.set_xlabel("standardized residual"); ax.set_title("Residual structure check")
    ax.legend(fontsize=8)

    fig.suptitle("Compact-star stable-branch reconstruction")
    fig.tight_layout()
    fig.savefig(OUT / "reconstruction_plot.png", dpi=150)
    plt.close(fig)
    print("Plot written with matplotlib.")
    MPL = True
except ImportError:
    MPL = False
    print("matplotlib unavailable -> using built-in pure-numpy PNG renderer.")

if not MPL:
    # --------------------------------------------------------------
    # Minimal pure-numpy PNG renderer (no external imaging libs):
    # 3x5 bitmap font, lines/discs, error bars, column-filled bands.
    # --------------------------------------------------------------
    FONT = {
        '0':"111101101101111",'1':"010110010010111",'2':"111001111100111",
        '3':"111001111001111",'4':"101101111001001",'5':"111100111001111",
        '6':"111100111101111",'7':"111001001010010",'8':"111101111101111",
        '9':"111101111001111",
        'A':"010101111101101",'B':"110101110101110",'C':"011100100100011",
        'D':"110101101101110",'E':"111100111100111",'F':"111100111100100",
        'G':"011100101101011",'H':"101101111101101",'I':"111010010010111",
        'J':"001001001101010",'K':"101101110101101",'L':"100100100100111",
        'M':"101111111101101",'N':"110101101101101",'O':"010101101101010",
        'P':"110101110100100",'Q':"010101101110011",'R':"110101110110101",
        'S':"011010010100110",'T':"111010010010010",'U':"101101101101111",
        'V':"101101101101010",'W':"101101111111101",'X':"101101010101101",
        'Y':"101101010010010",'Z':"111001010100111",
        ' ':"000000000000000",'.':"000000000000010",',':"000000000010100",
        '-':"000000111000000",'+':"000010111010000",'(':"001010010010100",
        ')':"100010010010001",'/':"001001010100100",':':"000010000010000",
        '%':"101001010100101",'=':"000111000111000",'*':"101010111010101",
    }
    BLACK, GREY = (0, 0, 0), (130, 130, 130)

    class Canvas:
        def __init__(self, w, h):
            self.w, self.h = w, h
            self.buf = np.full((h, w, 3), 255, np.uint8)

        def px(self, x, y, c):
            if 0 <= x < self.w and 0 <= y < self.h:
                self.buf[int(y), int(x)] = c

        def disc(self, cx, cy, r, c):
            cx, cy, r = int(round(cx)), int(round(cy)), int(r)
            if r <= 0:
                self.px(cx, cy, c); return
            for dy in range(-r, r + 1):
                for dx in range(-r, r + 1):
                    if dx * dx + dy * dy <= r * r:
                        self.px(cx + dx, cy + dy, c)

        def line(self, x0, y0, x1, y1, c, w=1):
            n = int(max(abs(x1 - x0), abs(y1 - y0))) + 1
            r = 0 if w <= 1 else (w - 1) // 2 + 1
            for i in range(n + 1):
                t = i / max(n, 1)
                self.disc(x0 + (x1 - x0) * t, y0 + (y1 - y0) * t, r, c)

        def text(self, s, x, y, scale=2, c=BLACK, anchor="left"):
            s = s.upper()
            wch = 4 * scale
            if anchor == "center":
                x -= int(len(s) * wch / 2)
            elif anchor == "right":
                x -= int(len(s) * wch)
            for k, ch in enumerate(s):
                g = FONT.get(ch)
                if g is None:
                    continue
                for row in range(5):
                    for col in range(3):
                        if g[row * 3 + col] == '1':
                            self.buf[y + row * scale: y + (row + 1) * scale,
                                     x + k * wch + col * scale:
                                     x + k * wch + (col + 1) * scale] = c

    class Panel:
        def __init__(self, cv, rect, xlim, ylim, title="", xlabel="", ylabel="",
                     xflip=False):
            self.cv, self.rect = cv, rect
            self.xlim, self.ylim = xlim, ylim
            self.xflip = xflip
            self.px0, self.py0 = rect[0] + 80, rect[1] + 44
            self.pw = rect[2] - 80 - 20
            self.ph = rect[3] - 44 - 58
            self.title, self.xlabel, self.ylabel = title, xlabel, ylabel

        def map(self, x, y):
            fx = (x - self.xlim[0]) / (self.xlim[1] - self.xlim[0])
            if self.xflip:
                fx = 1 - fx
            fy = (y - self.ylim[0]) / (self.ylim[1] - self.ylim[0])
            return self.px0 + fx * self.pw, self.py0 + self.ph * (1 - fy)

        @staticmethod
        def _ticks(lim, n=5):
            lo, hi = lim
            span = hi - lo
            step = 10.0 ** np.floor(np.log10(span / n))
            for mult in (1, 2, 2.5, 5, 10):
                if span / (step * mult) <= n * 1.7:
                    step *= mult
                    break
            out, t = [], np.ceil(lo / step) * step
            while t <= hi + 1e-9:
                out.append((float(t), "%g" % t))
                t += step
            return out

        def frame(self):
            cv = self.cv
            x0, y0 = self.px0, self.py0
            x1, y1 = x0 + self.pw, y0 + self.ph
            cv.line(x0, y0, x1, y0, BLACK); cv.line(x1, y0, x1, y1, BLACK)
            cv.line(x1, y1, x0, y1, BLACK); cv.line(x0, y1, x0, y0, BLACK)
            for t, lab in self._ticks(self.xlim):
                px, _ = self.map(t, 0)
                cv.line(px, y1, px, y1 + 5, BLACK)
                cv.text(lab, int(px), y1 + 10, 2, BLACK, "center")
            for t, lab in self._ticks(self.ylim):
                _, py = self.map(0, t)
                cv.line(x0 - 5, py, x0, py, BLACK)
                cv.text(lab, x0 - 9, int(py) - 5, 2, BLACK, "right")
            if self.title:
                cv.text(self.title, x0 + self.pw // 2, self.rect[1] + 10, 2, BLACK, "center")
            if self.xlabel:
                cv.text(self.xlabel, x0 + self.pw // 2, y1 + 28, 2, BLACK, "center")
            if self.ylabel:
                ya = y0 + self.ph // 2
                for i, ch in enumerate(self.ylabel.upper()):
                    cv.text(ch, self.rect[0] + 28, ya - 40 + i * 15, 2, BLACK, "center")

        def curve(self, x, y, c, w=2):
            P = [self.map(xi, yi) for xi, yi in zip(x, y)]
            for (ax_, ay_), (bx_, by_) in zip(P[:-1], P[1:]):
                self.cv.line(ax_, ay_, bx_, by_, c, w)

        def band(self, x, ylo, yhi, c, frac=0.25):
            bc = tuple(int(255 - frac * (255 - v)) for v in c)
            cv = self.cv
            for xi, yl, yh in zip(x, ylo, yhi):
                _, pyt = self.map(xi, max(yl, yh))
                _, pyb = self.map(xi, min(yl, yh))
                colx = int(self.map(xi, 0)[0])
                j0, j1 = max(int(pyt), self.py0), min(int(pyb), self.py0 + self.ph)
                if j1 > j0:
                    cv.buf[j0:j1, colx] = bc

        def scatter(self, x, y, c, r=4):
            for xi, yi in zip(x, y):
                px, py = self.map(xi, yi)
                self.cv.disc(px, py, r, (255, 255, 255))
                self.cv.disc(px, py, r - 1, c)

        def errorbar(self, x, y, xe, ye, c, r=4):
            for xi, yi, ex, ey in zip(x, y, np.zeros_like(x) if xe is None else xe, ye):
                px, py = self.map(xi, yi)
                _, yt = self.map(xi, yi + ey); _, yb = self.map(xi, yi - ey)
                self.cv.line(px, yt, px, yb, c)
                self.cv.line(px - 3, yt, px + 3, yt, c)
                self.cv.line(px - 3, yb, px + 3, yb, c)
                if xe is not None:
                    pl, _ = self.map(xi - ex, yi); pr, _ = self.map(xi + ex, yi)
                    self.cv.line(pl, py, pr, py, c)
                self.cv.disc(px, py, r, (255, 255, 255))
                self.cv.disc(px, py, r - 1, c)

        def vline(self, xv, c, w=1, dash=False):
            px, _ = self.map(xv, 0)
            y0, y1 = self.py0, self.py0 + self.ph
            if dash:
                for k in range(0, y1 - y0, 10):
                    self.cv.line(px, y0 + k, px, min(y0 + k + 5, y1), c, w)
            else:
                self.cv.line(px, y0, px, y1, c, w)

        def legend(self, entries):
            lx = self.px0 + self.pw - 14
            ly = self.py0 + 10
            for i, (lab, c) in enumerate(entries):
                yy = ly + i * 19
                self.cv.line(lx - 70, yy + 5, lx - 40, yy + 5, c, 3)
                self.cv.text(lab, lx - 34, yy, 2, BLACK)

