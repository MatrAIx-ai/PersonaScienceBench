def _write_png(path, img):
    """Minimal RGB PNG writer (zlib + struct), used by the fallback path."""
    h, w = img.shape[:2]
    raw = b"".join(b"\x00" + img[y].tobytes() for y in range(h))
    def chunk(tag, data):
        return (struct.pack(">I", len(data)) + tag + data
                + struct.pack(">I", zlib.crc32(tag + data) & 0xFFFFFFFF))
    hdr = struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0)
    with open(path, "wb") as fh:
        fh.write(b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", hdr)
                 + chunk(b"IDAT", zlib.compress(raw, 6)) + chunk(b"IEND", b""))


class _Canvas:
    """Tiny pixel canvas for the fallback figure renderer."""

    def __init__(self, w, h):
        self.img = np.full((h, w, 3), 255, np.uint8)
        self.w, self.h = w, h

    def px(self, x, y, col):
        if 0 <= x < self.w and 0 <= y < self.h:
            self.img[y, x] = col

    def line(self, x0, y0, x1, y1, col):
        dx, dy = abs(x1 - x0), abs(y1 - y0)
        sx = 1 if x0 < x1 else -1
        sy = 1 if y0 < y1 else -1
        err = dx - dy
        while True:
            self.px(x0, y0, col)
            if x0 == x1 and y0 == y1:
                break
            e2 = 2 * err
            if e2 > -dy:
                err -= dy
                x0 += sx
            if e2 < dx:
                err += dx
                y0 += sy

    def text(self, x, y, s, col=(0, 0, 0), scale=1):
        for ch in s:
            g = FONT.get(ord(ch))
            if ch == " " or g is None:
                x += 4 * scale
                continue
            w, h, rows = g
            for r in range(h):
                v = rows[r]
                for cc in range(w):
                    if (v >> (w - 1 - cc)) & 1:
                        for dy in range(scale):
                            for dx in range(scale):
                                self.px(x + cc * scale + dx,
                                        y + r * scale + dy, col)
            x += (w + 1) * scale


def _nice_ticks(lo, hi, n=5):
    if not np.isfinite(lo) or not np.isfinite(hi) or hi <= lo:
        return [0.0, 1.0]
    step = 10.0 ** math.floor(math.log10((hi - lo) / n))
    for m in (1.0, 2.0, 5.0, 10.0):
        if (hi - lo) / step <= n:
            break
        step *= m
    out, v = [], math.ceil(lo / step) * step
    while v <= hi + 1e-12:
        out.append(v)
        v += step
    return out


def _fallback_figure(rep_t, rep_trace, rep_i, cr_idx, j_big, cv_isi,
                     period_vs_ip3, p_open_vs_ip3):
    """4-panel diagnostic figure drawn without matplotlib."""
    W, H = 1400, 1000
    cv = _Canvas(W, H)
    cv.text(400, 10, "Stochastic De Young-Keizer IP3R Ca2+ oscillations", scale=2)
    lm, rm, tm, bm = 100, 30, 55, 80
    pw, ph = (W - lm - rm) // 2 - 30, (H - tm - bm) // 2 - 45
    panels = []
    for row in range(2):
        for col in range(2):
            x0 = lm + col * (pw + 70)
            y0 = tm + row * (ph + 80)
            panels.append((x0, y0, x0 + pw, y0 + ph))

    def panel(p, xs, ys, xlabel, ylabel, title, color):
        x0, y0, x1, y1 = p
        cv.img[y0:y1 + 1, x0:x1 + 1] = 255
        cv.line(x0, y0, x1, y0, (0, 0, 0))
        cv.line(x0, y1, x1, y1, (0, 0, 0))
        cv.line(x0, y0, x0, y1, (0, 0, 0))
        cv.line(x1, y0, x1, y1, (0, 0, 0))
        xs = np.asarray(xs, float)
        ys = np.asarray(ys, float)
        ok = np.isfinite(ys)
        if not ok.any():
            ys = np.zeros_like(xs)
            ok = np.ones_like(xs, bool)
        xs, ys = xs[ok], ys[ok]
        lox, hix, loy, hiy = xs.min(), xs.max(), ys.min(), ys.max()
        if hix <= lox:
            hix = lox + 1.0
        if hiy <= loy:
            hiy = loy + 0.1 * max(abs(loy), 1e-9)
        lox -= 0.05 * (hix - lox); hix += 0.05 * (hix - lox)
        loy -= 0.08 * (hiy - loy); hiy += 0.08 * (hiy - loy)
        mx = lambda v: x0 + (v - lox) / (hix - lox) * (x1 - x0)
        my = lambda v: y1 - (v - loy) / (hiy - loy) * (y1 - y0)
        for tv in _nice_ticks(lox, hix):
            cv.line(int(round(mx(tv))), y1, int(round(mx(tv))), y1 + 4, (0, 0, 0))
            lab = "%g" % tv
            cv.text(int(round(mx(tv))) - 3 * len(lab), y1 + 8, lab, scale=1)
        for tv in _nice_ticks(loy, hiy):
            cv.line(x0 - 4, int(round(my(tv))), x0, int(round(my(tv))), (0, 0, 0))
            lab = "%g" % tv
            cv.text(x0 - 6 - 6 * len(lab), int(round(my(tv))) - 4, lab, scale=1)
        pts = [(int(round(mx(a))), int(round(my(b)))) for a, b in zip(xs, ys)]
        for a in range(len(pts) - 1):
            cv.line(pts[a][0], pts[a][1], pts[a + 1][0], pts[a + 1][1], color)
        cv.text(x0, y0 - 15, title, scale=1)
        cv.text(x0 + (x1 - x0) // 2 - 5 * len(xlabel), y1 + 26, xlabel, scale=1)
        cv.text(x0 - 88, y0 + (y1 - y0) // 2 - 5, ylabel, scale=1)

    panel(panels[0], rep_t, rep_trace, "time (s)", "Ca cyt (uM)",
          "(a) trace: IP3=%.4g uM, N=%d"
          % (IP3_LEVELS[rep_i], CHANNEL_COUNTS[j_big]), (30, 60, 200))
    xs = [i for i, p in enumerate(period_vs_ip3) if p is not None]
    ys = [p for p in period_vs_ip3 if p is not None]
    panel(panels[1], xs if xs else [0, 1], ys if ys else [0, 1],
          "IP3 level index", "period (s)",
          "(b) peak-to-peak period vs IP3 (N=%d)" % CHANNEL_COUNTS[j_big],
          (200, 30, 30))
    cvy = [v if v is not None else float("nan") for v in cv_isi]
    panel(panels[2], CHANNEL_COUNTS, cvy, "channel count N", "CV of ISI",
          "(c) CV vs N at IP3=%.4g uM (idx %d)" % (IP3_LEVELS[cr_idx], cr_idx),
          (30, 140, 30))
    panel(panels[3], list(range(len(IP3_LEVELS))), p_open_vs_ip3,
          "IP3 level index", "open fraction",
          "(d) P_open vs IP3 (N=%d)" % CHANNEL_COUNTS[j_big], (130, 30, 160))
    _write_png("calcium_summary.png", cv.img)


