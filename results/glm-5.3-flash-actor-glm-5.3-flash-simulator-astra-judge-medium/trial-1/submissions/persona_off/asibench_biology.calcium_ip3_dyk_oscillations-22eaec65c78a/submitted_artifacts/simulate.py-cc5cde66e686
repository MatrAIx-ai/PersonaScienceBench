_FP = SYS["channel_flux_and_pump"]
V1 = _FP["max_channel_flux_rate_per_second"]  # 6.0 /s
V2 = _FP["lumen_leak_rate_per_second"]        # 0.11 /s
VMAX = _FP["reuptake_vmax_micromolar_per_second"]  # 0.9 uM/s
KM = _FP["reuptake_km_micromolar"]            # 0.1 uM
KM2 = KM * KM

IP3_LEVELS = list(SPEC["ip3_levels_micromolar"])
CHANNEL_COUNTS = list(SPEC["channel_counts"])
N_REP = int(SPEC["n_replicates"])
T_OBS = float(SPEC["T_obs_seconds"])
DT_OUT = float(SPEC["dt_out_seconds"])
N_SAMPLES = int(round(T_OBS / DT_OUT))
assert N_SAMPLES == 1200

CA0 = SYS["initial_conditions_hint"]["ca_cyt_initial_micromolar"]  # 0.1 uM
CE0 = (C0 - CA0) / C1                      # lumen from conservation


# ------------------------------------------------- subunit rate machinery ---
def flip_rates(s, ip3, ca):
    """Return (rate_i, rate_j, rate_k) for a subunit in state s."""
    i = s & 1
    j = (s >> 1) & 1
    k = s >> 2
    if k == 0:
        ri = A1 * ip3 if i == 0 else D1
    else:
        ri = A3 * ip3 if i == 0 else D3
    rj = A5 * ca if j == 0 else D5
    if i == 0:
        rk = A4 * ca if k == 0 else D4
    else:
        rk = A2 * ca if k == 0 else D2
    return ri, rj, rk


def prob_table(ip3, ca, dt):
    """(8,3) table of per-substep flip probabilities p = 1-exp(-r*dt)."""
    T = np.empty((8, 3))
    for s in range(8):
        ri, rj, rk = flip_rates(s, ip3, ca)
        T[s, 0] = -math.expm1(-ri * dt)
        T[s, 1] = -math.expm1(-rj * dt)
        T[s, 2] = -math.expm1(-rk * dt)
    return T


def stationary_dist(ip3, ca):
    """Stationary distribution of the 8-state subunit chain at fixed ligand/Ca."""
    Q = np.zeros((8, 8))
    for s in range(8):
        ri, rj, rk = flip_rates(s, ip3, ca)
        for r, bit in ((ri, 1), (rj, 2), (rk, 4)):
            Q[s, s] -= r
            Q[s, s ^ bit] += r
    M = Q.T.copy()
    M[-1, :] = 1.0
    b = np.zeros(8)
    b[-1] = 1.0
    return np.linalg.solve(M, b)


# --------------------------------------------------------- ODE (RK4) -------
def rk4_step(c, ce, f, dt):
    """One RK4 step of the two-compartment balance with f_open frozen."""
    v12 = V1 * f + V2

    def der(cc, cee):
        J = v12 * (cee - cc)
        pump = VMAX * cc * cc / (KM2 + cc * cc)
        return C1 * J - pump, -J + pump / C1

    a1_, b1_ = der(c, ce)
    a2_, b2_ = der(c + 0.5 * dt * a1_, ce + 0.5 * dt * b1_)
    a3_, b3_ = der(c + 0.5 * dt * a2_, ce + 0.5 * dt * b2_)
    a4_, b4_ = der(c + dt * a3_, ce + dt * b3_)
    c_new = c + dt / 6.0 * (a1_ + 2.0 * a2_ + 2.0 * a3_ + a4_)
    ce_new = ce + dt / 6.0 * (b1_ + 2.0 * b2_ + 2.0 * b3_ + b4_)
    return c_new, ce_new


# -------------------------------------------------------- one trajectory ----
def run_case(ip3, N, seed_tags, n_burn_steps, steps_per_out):
    """Simulate one (level, N, replicate) trajectory.

    Returns (trace[N_SAMPLES], mean_open_fraction, conservation_error_max).
    The mean open fraction is accumulated over every 1 ms substep of the
    observation window (not just the 0.1 s output samples).
    """
    rng = np.random.default_rng([BASE_SEED] + list(seed_tags))
    # quasi-steady-state initial subunit states at (IP3_i, Ca = CA0)
    pi0 = stationary_dist(ip3, CA0)
    states = rng.choice(8, size=(N, 3), p=pi0).astype(np.int8)
    c, ce = CA0, CE0

    def substep(c, ce):
        T = prob_table(ip3, c, DT_INT)
        u = rng.random((N, 3, 3))
        flips = u < T[states]
        d = flips[:, :, 0].astype(np.int8)
        d += 2 * flips[:, :, 1]
        d += 4 * flips[:, :, 2]
        np.bitwise_xor(states, d, out=states)
        om = states == 3
        n_open = np.count_nonzero(om[:, 0] & om[:, 1] & om[:, 2])
        return rk4_step(c, ce, n_open / N, DT_INT), n_open

    # burn-in (discarded; lets the channel ensemble and the Ca balance relax
    # onto the attractor before the observation window)
    for _ in range(n_burn_steps):
        (c, ce), _ = substep(c, ce)

    trace = np.empty(N_SAMPLES, dtype=np.float64)
    open_sum = 0
    n_acc = 0
    cons_max = 0.0
    for k in range(N_SAMPLES):
        trace[k] = c
        for _ in range(steps_per_out):
            (c, ce), n_open = substep(c, ce)
            open_sum += n_open
            n_acc += 1
            dev = abs(c + C1 * ce - C0) / C0
            if dev > cons_max:
                cons_max = dev
    f_open_avg = open_sum / (n_acc * N)
    return trace, f_open_avg, cons_max


def _run_one(tag):
    """Module-level worker (must be picklable for multiprocessing)."""
    i, j, r = tag
    tr, fo, cs = run_case(IP3_LEVELS[i], CHANNEL_COUNTS[j], [i, j, r],
                          NB_STEPS, SPO_STEPS)
    return tag, tr, fo, cs, detect_isis(tr)


# ------------------------------------------------------------ statistics ----
def detect_isis(trace):
    """Peak-to-peak inter-spike intervals (s) of a cytosolic Ca trace."""
    ptp = float(np.max(trace) - np.min(trace))
    if ptp <= 0:
        return np.empty(0)
    prom = max(0.05, 0.25 * ptp)
    idx, _ = find_peaks(trace, prominence=prom, distance=3)
    if idx.size < 2:
        return np.empty(0)
    return np.diff(idx) * DT_OUT


def pooled_isis(isis, i, j, reps):
    parts = [isis[(i, j, r)] for r in range(reps)]
    parts = [p for p in parts if p.size]
    return np.concatenate(parts) if parts else np.empty(0)


def main():
    n_burn_steps = int(round(T_BURN / DT_INT))
    steps_per_out = int(round(DT_OUT / DT_INT))

    traces = {}
    f_open = {}
    cons_max_all = 0.0
    isis = {}
    # schedule the expensive (large-N) cases first for load balance
    tasks = [(i, j, r) for i in range(len(IP3_LEVELS))
             for j in reversed(range(len(CHANNEL_COUNTS)))
             for r in range(N_REP)]

    global NB_STEPS, SPO_STEPS
    NB_STEPS, SPO_STEPS = n_burn_steps, steps_per_out

    n_workers = min(16, mp.cpu_count() or 1)
    print("running grid: %d levels x %d channel counts x %d replicates "
          "(%d worker processes)"
          % (len(IP3_LEVELS), len(CHANNEL_COUNTS), N_REP, n_workers), flush=True)
    results = {}
    if n_workers > 1:
        with mp.Pool(n_workers) as pool:
            for tag, tr, fo, cs, iv in pool.imap_unordered(_run_one, tasks):
                results[tag] = (tr, fo, cs, iv)
                print("  done ip3 idx %d N=%d rep %d"
                      % (tag[0], CHANNEL_COUNTS[tag[1]], tag[2]), flush=True)
    else:
        for tag in tasks:
            _, tr, fo, cs, iv = _run_one(tag)
            results[tag] = (tr, fo, cs, iv)

    for i, ip3 in enumerate(IP3_LEVELS):
        for j, N in enumerate(CHANNEL_COUNTS):
            trs, fos, css, ivs = [], [], [], []
            for r in range(N_REP):
                tr, fo, cs, iv = results[(i, j, r)]
                trs.append(tr); fos.append(fo); css.append(cs); ivs.append(iv)
                isis[(i, j, r)] = iv
            traces["ip3%d_N%d" % (i, j)] = np.asarray(trs, dtype=np.float64)
            f_open[(i, j)] = fos
            cons_max_all = max(cons_max_all, max(css))
            nspk = [len(isis[(i, j, r)]) + 1 if isis[(i, j, r)].size else 0
                    for r in range(N_REP)]
            print("  ip3=%.4f uM N=%4d : peaks/rep=%s  f_open=%.5f  cons=%.2e"
                  % (ip3, N, nspk, float(np.mean(fos)), max(css)), flush=True)

    np.savez("ca_traces.npz", **traces)

    # ---- period at the largest channel count (peak-to-peak spacing) --------
    j_big = len(CHANNEL_COUNTS) - 1
    period_vs_ip3 = []
    for i in range(len(IP3_LEVELS)):
        pool = pooled_isis(isis, i, j_big, N_REP)
        period_vs_ip3.append(float(np.mean(pool)) if pool.size else None)

    # ---- CV of ISIs across channel counts at one low-ligand level ---------
    def cvs_at(idx):
        """CV of pooled ISIs per N; None where a replicate has < 2 ISIs."""
        out = []
        for j in range(len(CHANNEL_COUNTS)):
            per_rep = [isis[(idx, j, r)] for r in range(N_REP)]
            if all(p.size >= 2 for p in per_rep):
                pool = np.concatenate(per_rep)
                if np.mean(pool) > 0:
                    out.append(float(np.std(pool, ddof=1) / np.mean(pool)))
                    continue
            out.append(None)
        return out

    cr_idx, cv_isi = None, None
    for idx in range(len(IP3_LEVELS)):
        # lowest ligand level at which EVERY (N, replicate) yields >= 2 ISIs,
        # i.e. all channel counts spike enough for a meaningful CV
        cand = cvs_at(idx)
        if all(v is not None for v in cand):
            cr_idx, cv_isi = idx, cand
            break
    if cr_idx is None:
        best, best_ok = 0, -1
        for idx in range(len(IP3_LEVELS)):
            cand = cvs_at(idx)
            ok = sum(v is not None for v in cand)
            if ok > best_ok:
                best, best_ok, cv_isi = idx, ok, cand
        cr_idx = best

    # ---- time-averaged open fraction at the largest channel count ---------
    # (averaged over the full post-burn-in 120 s observation window)
    p_open_vs_ip3 = [float(np.mean(f_open[(i, j_big)]))
                     for i in range(len(IP3_LEVELS))]

    summary = {
        "ip3_levels": [float(x) for x in IP3_LEVELS],
        "channel_counts": [int(x) for x in CHANNEL_COUNTS],
        "period_vs_ip3": period_vs_ip3,
        "cv_isi_vs_N": cv_isi,
        "p_open_vs_ip3": p_open_vs_ip3,
        "conservation_error_max": float(cons_max_all),
        "cr_ip3_idx_used": int(cr_idx),
    }
    with open("summary_stats.json", "w") as fh:
        json.dump(summary, fh, indent=2)
    print(json.dumps(summary, indent=2))

    # diagnostic: simulated P_open vs quasi-static mean-field p3^3 at N_max
    for i, ip3 in enumerate(IP3_LEVELS):
        tr = traces["ip3%d_N%d" % (i, j_big)][0]
        mf = float(np.mean([stationary_dist(ip3, float(cc))[3] ** 3
                            for cc in tr[::10]]))
        print("  ip3=%.4f: simulated P_open=%.5f  quasi-static mean-field p3^3=%.5f"
              % (ip3, p_open_vs_ip3[i], mf), flush=True)

    # ------------------------------------------------------------- figure ---
    # representative trace: the lowest level where both N_max replicates show
    # a clear relaxation-oscillation spike train (>= 4 ISIs); else any spiking
    rep_i = next((k for k in range(len(IP3_LEVELS))
                  if all(isis[(k, j_big, r)].size >= 4 for r in range(N_REP))),
                 next((k for k, p in enumerate(period_vs_ip3) if p is not None), 0))
    rep_trace = traces["ip3%d_N%d" % (rep_i, j_big)][0]
    rep_t = np.arange(N_SAMPLES) * DT_OUT
    if HAVE_MPL:
        fig, axes = plt.subplots(2, 2, figsize=(11, 8))
        ax = axes[0, 0]
        ax.plot(rep_t, rep_trace, lw=0.8, color="tab:blue")
        ax.set_xlabel("time (s)")
        ax.set_ylabel("Ca_cyt (uM)")
        ax.set_title("(a) representative trace: IP3=%.4g uM, N=%d"
                     % (IP3_LEVELS[rep_i], CHANNEL_COUNTS[j_big]))
        ax = axes[0, 1]
        ax.plot(range(len(IP3_LEVELS)), period_vs_ip3, "o-", color="tab:red")
        ax.set_xlabel("IP3 level index")
        ax.set_ylabel("period (s)")
        ax.set_title("(b) peak-to-peak period vs IP3 (N=%d)"
                     % CHANNEL_COUNTS[j_big])
        ax = axes[1, 0]
        ax.plot(CHANNEL_COUNTS, [v if v is not None else np.nan for v in cv_isi],
                "s-", color="tab:green")
        ax.set_xscale("log")
        ax.set_xlabel("channel count N")
        ax.set_ylabel("CV of ISI")
        ax.set_title("(c) CV vs N at IP3=%.4g uM (idx %d)"
                     % (IP3_LEVELS[cr_idx], cr_idx))
        ax = axes[1, 1]
        ax.plot(range(len(IP3_LEVELS)), p_open_vs_ip3, "d-", color="tab:purple")
        ax.set_xlabel("IP3 level index")
        ax.set_ylabel("time-avg open fraction")
        ax.set_title("(d) P_open vs IP3 (N=%d)" % CHANNEL_COUNTS[j_big])
        fig.suptitle("Stochastic De Young-Keizer IP3R Ca2+ oscillations "
                     "(%d substeps of %g ms each)" % (steps_per_out, DT_INT * 1e3))
        fig.tight_layout(rect=(0, 0, 1, 0.96))
        fig.savefig("calcium_summary.png", dpi=130)
        plt.close(fig)
        print("figure written with matplotlib/Agg")
    else:
        _fallback_figure(rep_t, rep_trace, rep_i, cr_idx, j_big, cv_isi,
                         period_vs_ip3, p_open_vs_ip3)
        print("figure written with pure-Python PNG fallback "
              "(matplotlib unavailable in this runtime)")



