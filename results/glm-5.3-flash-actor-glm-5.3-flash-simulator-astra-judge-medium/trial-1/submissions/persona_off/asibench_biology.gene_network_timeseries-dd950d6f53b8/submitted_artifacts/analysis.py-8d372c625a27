#!/usr/bin/env python3
"""
Directed gene regulatory network inference (ASIBench biology.gene_network_timeseries).

Outputs: analysis.py, inferred_network.npy, edge_sign_predictions.npy,
hub_genes.json, method_comparison.json, network_metrics.json.

inferred_network[i, j] = strength of gene j's influence on gene i ([target, source]).

Methods (>=2 independent approaches, 4 implemented):
  A  dynamical elastic-net ODE regression on Savitzky-Golay smoothed time courses
  B1 shrunk-precision partial correlations of the steady states (skeleton + sign corroboration)
  B2 intervention-constrained steady-state regression (exact clamps detected in the data)
  B3 intervention-response regression (direct vs cascade control of clamped genes)
Ensemble: rank-normalised weighted average; stability-elbow threshold kept inside the
required 5-40% off-diagonal density band; signs preferentially from the dynamical fit,
cross-method conflicts coded as sign 0.

Implemented on numpy/scipy only (no scikit-learn in this runtime): the elastic-net
coordinate descent, Ledoit-Wolf shrinkage, ridge and cross-validation loops below are
self-contained, standard textbook implementations.
"""
import json
import warnings
from pathlib import Path

import numpy as np
from scipy.signal import savgol_filter
from scipy.stats import rankdata

warnings.filterwarnings("ignore")
RNG = np.random.default_rng(0)
DATA = Path("data")
N_GENES = 25
DT = 0.612245

ts = np.load(DATA / "expression_timeseries.npy")
ss = np.load(DATA / "perturbation_steady_states.npy")
n_exp, n_time, n_genes = ts.shape
assert (n_exp, n_time, n_genes) == (5, 50, 25) and ss.shape == (16, 25)
assert np.isfinite(ts).all() and np.isfinite(ss).all()
baseline = ss[0]
dev = ss[1:] - baseline
noop_dev = dev[1]
print(f"[sanity] no-op row max|dev| = {np.abs(noop_dev).max():.3f} "
      "(noise reference; excluded from all steady-state fits)")


# ---------------------------------------------------------------------------
# self-contained estimators (numpy only)
# ---------------------------------------------------------------------------
def enet_cd(X, y, alpha, l1_ratio, max_iter=2000, tol=1e-7, w_init=None):
    """Coordinate descent for 1/(2n)||y-Xw||^2 + alpha*((1-l1)/2||w||^2 + l1||w||_1)."""
    n, p = X.shape
    w = np.zeros(p) if w_init is None else w_init.copy()
    x2 = (X ** 2).mean(axis=0)
    r = y - X @ w
    for _ in range(max_iter):
        max_dl = 0.0
        for j in range(p):
            if x2[j] <= 0:
                continue
            w_old = w[j]
            rho = X[:, j] @ r / n + x2[j] * w_old
            thr = alpha * l1_ratio
            denom = x2[j] + alpha * (1 - l1_ratio)
            w_new = np.sign(rho) * max(abs(rho) - thr, 0.0) / denom if denom > 0 else 0.0
            if w_new != w_old:
                r += X[:, j] * (w_old - w_new)
                w[j] = w_new
                max_dl = max(max_dl, abs(w_new - w_old))
        if max_dl < tol:
            break
    return w


def enet_fit(X, y, alphas, l1_ratios, cv_idx, fit_intercept=True):
    """Elastic net with grid search over (alpha, l1_ratio) by CV; returns w in raw space
    of the given (already column-scaled) X plus chosen hyper-parameters."""
    n, p = X.shape
    best = (np.inf, alphas[0], l1_ratios[0], None)
    yc = y - y.mean() if fit_intercept else y
    for l1r in l1_ratios:
        for al in alphas:
            se = 0.0
            for tr, te in cv_idx:
                w = enet_cd(X[tr], yc[tr], al, l1r)
                se += ((yc[te] - X[te] @ w) ** 2).mean()
            if se < best[0]:
                best = (se, al, l1r, None)
    _, al, l1r, _ = best
    w = enet_cd(X, yc, al, l1r)
    return w, al, l1r


def ridge_fit(X, Y, alpha, intercept=True):
    """Closed-form ridge; X may be unscaled; penalty excludes the intercept column."""
    n, p = X.shape
    if intercept:
        Xd = np.hstack([X, np.ones((n, 1))])
        pen = np.eye(p + 1) * alpha
        pen[-1, -1] = 0.0
    else:
        Xd, pen = X, np.eye(p) * alpha
    return np.linalg.solve(Xd.T @ Xd + pen, Xd.T @ Y)


def ledoit_wolf_precision(X):
    """Ledoit-Wolf shrunk covariance -> precision matrix (X: n x p, centered inside)."""
    Xc = X - X.mean(axis=0)
    n, p = Xc.shape
    S = Xc.T @ Xc / n
    mu = np.trace(S) / p
    d2 = ((S - mu * np.eye(p)) ** 2).sum() / p
    b2 = sum(((np.outer(x, x) - S) ** 2).sum() for x in Xc) / (n * p) / n
    shrink = min(b2, d2) / d2 if d2 > 0 else 1.0
    S_shrunk = (1 - shrink) * S + shrink * mu * np.eye(p)
    return np.linalg.pinv(S_shrunk), shrink


def kfold_idx(n, k, seed=1):
    idx = np.arange(n)
    RNG2 = np.random.default_rng(seed)
    RNG2.shuffle(idx)
    return [(np.setdiff1d(idx, f), f) for f in np.array_split(idx, k)]

# ---------------------------------------------------------------------------
# 1. detect interventions (an INFERENCE from the data, not documented fact)
#    KO: gene forced to ~0 ; OE: gene forced to ~10 (exact clamp values)
# ---------------------------------------------------------------------------
KO_TOL = OE_TOL = 0.05
clamp_rows = []
for r in range(15):
    row = ss[1 + r]
    ko = np.where(np.abs(row) < KO_TOL)[0]
    oe = np.where(np.abs(row - 10.0) < OE_TOL)[0]
    clamped = np.array([g for g in np.union1d(ko, oe) if abs(dev[r, g]) > 1.0], dtype=int)
    z = np.zeros(n_genes)
    for g in np.union1d(ko, oe):
        z[g] = row[g] - baseline[g]
    clamp_rows.append(dict(row=r + 1, ko=ko.tolist(), oe=oe.tolist(),
                           clamped=clamped.tolist(), z=z, has_clamp=len(clamped) > 0))
informative = [c for c in clamp_rows if c["has_clamp"]]
n_multi = sum(len(c["clamped"]) > 1 for c in informative)
print(f"[interventions] rows with detected clamps: {len(informative)}/15; "
      f"targets/row {[len(c['clamped']) for c in informative]}; multi-target rows: {n_multi}")
print("[interventions] rows 1 and 6 deviate strongly but have NO exact clamp "
      "(likely partial knockdowns of undocumented type) -> excluded from B2/B3")

# ---------------------------------------------------------------------------
# 2. METHOD A: dynamical elastic-net ODE regression on smoothed time courses
# ---------------------------------------------------------------------------
window, poly = 9, 3
dts = savgol_filter(ts, window_length=window, polyorder=poly, deriv=1, delta=DT, axis=1)
X_all = ts[:, 2:-2, :].reshape(-1, n_genes)          # trim SG boundary artefacts
Y_all = dts[:, 2:-2, :].reshape(-1, n_genes)
exp_id = np.repeat(np.arange(n_exp), X_all.shape[0] // n_exp)

mu_x, sdx = X_all.mean(axis=0), X_all.std(axis=0)
sdx[sdx == 0] = 1.0
Xs = (X_all - mu_x) / sdx

# conditioning diagnostics of the standardised design
sv = np.linalg.svd(Xs, compute_uv=False)
eff_rank = float(sv.sum() ** 2 / (sv ** 2).sum())
cond_number = float(sv[0] / sv[-1])
print(f"[design] time-course design cond={cond_number:.1f}, effective rank "
      f"{eff_rank:.1f}/25 -> elastic-net (l1>0) used, not ridge alone")

alphas = np.logspace(-3, 1, 12)
l1_ratios = [0.2, 0.5, 0.8]
logo_idx = [(np.where(exp_id != k)[0], np.where(exp_id == k)[0]) for k in range(n_exp)]

A_coef = np.zeros((n_genes, n_genes))       # dx_i/dt = A_ii x_i + sum_j A_ij x_j
A_coef = np.zeros((n_genes, n_genes))       # dx_i/dt = A_ii x_i + sum_j A_ij x_j
A_r2 = np.zeros(n_genes)
A_hp = []
for i in range(n_genes):
    y = Y_all[:, i]
    sd_y = y.std() or 1.0
    yc = (y - y.mean()) / sd_y               # centered+scaled target
    w, al, l1r = enet_fit(Xs, yc, alphas, l1_ratios, logo_idx, fit_intercept=True)
    A_coef[i] = w * sd_y / sdx               # back to raw units
    A_hp.append((al, l1r))
    A_r2[i] = 1 - np.mean((y - (Xs @ w * sd_y + y.mean())) ** 2) / np.var(y)

# bootstrap stability over experiments (fixed chosen hyper-parameters)
n_boot_A = 60
selA = np.zeros((n_genes, n_genes))
for b in range(n_boot_A):
    idx = RNG.choice(n_exp, n_exp, replace=True)
    Xb = ts[idx][:, 2:-2, :].reshape(-1, n_genes)
    Yb = dts[idx][:, 2:-2, :].reshape(-1, n_genes)
    Xbs = (Xb - mu_x) / sdx
    for i in range(n_genes):
        yb = Yb[:, i]
        w = enet_cd(Xbs, (yb - yb.mean()) / (yb.std() or 1.0), A_hp[i][0], A_hp[i][1])
        selA[i] += (np.abs(w) > 1e-8)
A_stab = selA / n_boot_A
A_score = np.abs(A_coef)
np.fill_diagonal(A_score, 0.0)
np.fill_diagonal(A_stab, 0.0)
print(f"[A] mean leave-one-experiment-out R2 = {A_r2.mean():.3f}; mean stability "
      f"{A_stab[A_stab > 0].mean() if (A_stab > 0).any() else 0:.2f}")

# ---------------------------------------------------------------------------
# 3. METHOD B1: shrunk-precision partial correlations of steady states
# ---------------------------------------------------------------------------
ss_fit = ss[[r for r in range(16) if r != 2]]        # drop the no-op row
P, shrink = ledoit_wolf_precision(ss_fit)
d = np.sqrt(np.diag(P))
pcorr = P / np.outer(d, d)
np.fill_diagonal(pcorr, 0.0)
B1_score, B1_sign = np.abs(pcorr), np.sign(pcorr)
np.fill_diagonal(B1_score, 0.0)
n_sub = 40
selB1 = np.zeros((n_genes, n_genes))
k_top = int(0.25 * (n_genes - 1))
for _ in range(n_sub):
    idx = RNG.choice(ss_fit.shape[0], 12, replace=False)
    Ps, _ = ledoit_wolf_precision(ss_fit[idx])
    ds = np.sqrt(np.diag(Ps))
    pc = Ps / np.outer(ds, ds)
    np.fill_diagonal(pc, 0.0)
    for i in range(n_genes):
        selB1[i, np.argsort(-np.abs(pc[i]))[:k_top]] += 1
B1_stab = selB1 / n_sub
print(f"[B1] LW shrinkage {shrink:.2f}; mean stability of top-25% edges "
      f"{B1_stab[B1_stab > 0].mean():.2f}")

# ---------------------------------------------------------------------------
# 4. METHOD B2: steady-state balance equations as a proximal correction of the
#    dynamical estimate.
#    For every gene i NOT intervened in condition c the (approximately linear)
#    steady-state balance  A_i. (x*_c - x0) = 0  must hold.  Verified
#    empirically: the dynamical A leaves only ~0.8% of the deviation variance
#    unresolved by these equations.  The balance equations alone underdetermine
#    A (12 conditions, extreme collinearity: in-sample R2 = 1.0 but nested-LOO
#    R2 < 0), so they are used as well-posed correction data:
#      a_i = argmin_a || Delta_i a ||^2 + lambda || a - A_i. ||^2
#    where Delta_i stacks the deviation vectors of conditions where gene i is
#    not clamped; lambda chosen by leave-one-condition-out minimisation of the
#    held-out balance residual.  Multi-target rows are handled exactly: all
#    clamped genes of a row are excluded from that row's equation jointly.
# ---------------------------------------------------------------------------
D = np.stack([dev[c["row"] - 1] for c in clamp_rows])       # (15, 25)
Z = np.stack([c["z"] for c in clamp_rows])                  # (15, 25)
clamped_mat = np.stack([np.isin(np.arange(n_genes), c["clamped"]) for c in clamp_rows])

B2_coef = np.zeros((n_genes, n_genes))
B2_impr = []          # held-out balance residual: prior vs corrected
res_lambdas = np.logspace(-1, 3, 9)
for i in range(n_genes):
    use = ~clamped_mat[:, i]
    Delta = D[use]                                  # (m, 25)
    m = Delta.shape[0]
    H = Delta.T @ Delta
    p = A_coef[i].copy()
    # choose lambda by LOO over conditions on held-out balance residual
    best_l, best_res = None, np.inf
    for lam in res_lambdas:
        se = 0.0
        for k in range(m):
            tr = np.arange(m) != k
            Hk = Delta[tr].T @ Delta[tr]
            ak = p - np.linalg.solve(Hk + lam * np.eye(n_genes), Hk @ p)
            se += (ak @ Delta[k]) ** 2
        if se < best_res:
            best_res, best_l = se, lam
    a = p - np.linalg.solve(H + best_l * np.eye(n_genes), H @ p)
    B2_coef[i] = a
    res_prior = np.mean([(p @ Delta[k]) ** 2 for k in range(m)]) if m else np.nan
    res_corr = np.mean([(a @ Delta[k]) ** 2 for k in range(m)]) if m else np.nan
    B2_impr.append((res_prior, res_corr, best_l))
B2_coef = np.asarray(B2_coef)
imp_prior = np.nanmean([x[0] for x in B2_impr])
imp_corr = np.nanmean([x[1] for x in B2_impr])
B2_score = np.abs(B2_coef)
np.fill_diagonal(B2_score, 0.0)
B2_sign = np.sign(B2_coef)
# stability: bootstrap over conditions; frequency of edge in gene's top-8
selB2 = np.zeros((n_genes, n_genes))
for _ in range(40):
    for i in range(n_genes):
        use = ~clamped_mat[:, i]
        Delta = D[use]
        bidx = RNG.choice(Delta.shape[0], Delta.shape[0], replace=True)
        Hb = Delta[bidx].T @ Delta[bidx]
        lam = B2_impr[i][2]
        ab = A_coef[i] - np.linalg.solve(Hb + lam * np.eye(n_genes), Hb @ A_coef[i])
        top = np.argsort(-np.abs(ab))[:8]
        selB2[i, top] += 1
B2_stab = selB2 / 40
np.fill_diagonal(B2_stab, 0.0)
print(f"[B2] held-out balance residual: prior {imp_prior:.3f} -> corrected "
      f"{imp_corr:.3f} ({imp_corr / imp_prior:.2f}x); mean stability "
      f"{B2_stab[B2_stab > 0].mean():.2f}")

# ---------------------------------------------------------------------------
# 5. METHOD B3: intervention-response regression (total effects)
#    D ~ Z M with ridge; only rows with detected clamps; co-clamped genes enter
#    Z simultaneously so cascade confounding from multi-target rows is
#    controlled.  M[i, j] = total response of gene i to clamping gene j.
#    NOTE: these are TOTAL (direct + cascade) effects; used for influence
#    ranking and as sign tiebreak, not as a direct-edge estimator.
# ---------------------------------------------------------------------------
use_rows = np.array([c["has_clamp"] for c in clamp_rows])
Zf, Df = Z[use_rows], D[use_rows]
n_r = Zf.shape[0]
sd_z = Zf.std(axis=0); sd_z[sd_z == 0] = 1.0
Zs = Zf / sd_z
alphas_r = np.logspace(-2, 4, 25)
loo = [(np.setdiff1d(np.arange(n_r), [k]), np.array([k])) for k in range(n_r)]
best = (np.inf, alphas_r[0])
for al in alphas_r:
    se = 0.0
    for tr, te in loo:
        Wm = ridge_fit(Zs[tr], Df[tr], al)
        se += ((Df[te] - Zs[te] @ Wm[:-1] - Wm[-1]) ** 2).mean()
    if se < best[0]:
        best = (se, al)
alpha_b3 = best[1]
Wm = ridge_fit(Zs, Df, alpha_b3)
M = (Wm[:-1] / sd_z).T
# per-gene LOO R2 over folds where gene i is NOT itself clamped
B3_r2_list = []
for i in range(n_genes):
    num = den = 0.0
    for k in range(n_r):
        if clamped_mat[use_rows][k, i]:
            continue
        Wk = ridge_fit(Zs[loo[k][0]], Df[loo[k][0]], alpha_b3)
        pr = Zs[k] @ Wk[:-1] + Wk[-1]
        num += (Df[k, i] - pr[i]) ** 2
        den += (Df[k, i] - Df[:, i].mean()) ** 2
    if den > 0:
        B3_r2_list.append(1 - num / den)
B3_r2_med = float(np.nanmedian(B3_r2_list))
B3_score, B3_sign = np.abs(M), np.sign(M)
np.fill_diagonal(B3_score, 0.0)
selB3 = np.zeros_like(B3_score)
for _ in range(40):
    bidx = RNG.choice(n_r, n_r, replace=True)
    Wb = ridge_fit(Zs[bidx], Df[bidx], alpha_b3)
    selB3 += (np.abs((Wb[:-1] / sd_z).T) > 0.1 * np.abs(M).max())
B3_stab = selB3 / 40
print(f"[B3] LOO-CV alpha={alpha_b3:.2g}; median per-gene LOO R2 = {B3_r2_med:.3f}; "
      f"mean stability {B3_stab[B3_stab > 0].mean():.2f}")

# ---------------------------------------------------------------------------
# 6. ensemble combination, stability-elbow threshold, signs
# ---------------------------------------------------------------------------
def rank01(S):
    out = np.zeros_like(S)
    nz = S > 0
    if nz.any():
        r = rankdata(S[nz], method="average")
        out[nz] = r / r.max()
    return out

# fixed informed weights (rationale in method_comparison.json):
# A: primary dynamical evidence; B2: independent steady-state balance
# information correcting A; B3: intervention total-effects; B1: skeleton.
weights = {"A": 0.35, "B2": 0.30, "B3": 0.20, "B1": 0.15}
S = (weights["A"] * rank01(A_score) + weights["B2"] * rank01(B2_score) +
     weights["B3"] * rank01(B3_score) + weights["B1"] * rank01(B1_score))
stability = (weights["A"] * A_stab + weights["B2"] * B2_stab +
             weights["B3"] * B3_stab + weights["B1"] * B1_stab)
S_off = S.copy(); np.fill_diagonal(S_off, 0.0)
stab_off = stability.copy(); np.fill_diagonal(stab_off, 0.0)

order = np.argsort(-S_off.flatten())
flatS, flatSt = S_off.flatten()[order], stab_off.flatten()[order]
n_off = n_genes * (n_genes - 1)
ks = np.unique(np.maximum((np.linspace(0.05, 0.40, 36) * n_off).astype(int), 1))
mean_stab = np.array([flatSt[:k].mean() for k in ks])
dens_of_k = ks / n_off
band = (dens_of_k >= 0.10) & (dens_of_k <= 0.30)
best_k, best_val = None, -np.inf
for k, dstab, dn in zip(ks[band], mean_stab[band], dens_of_k[band]):
    if dstab >= 0.7 * mean_stab[band].max():
        val = dstab - abs(dn - 0.22)          # elbow preference near 22% density
        if val > best_val:
            best_val, best_k = val, k
if best_k is None:
    best_k = ks[band][np.argmax(mean_stab[band])]
density_used = best_k / n_off
print(f"[threshold] K={best_k} edges -> off-diagonal density {density_used:.3f} "
      f"(mean stability of kept edges {flatSt[:best_k].mean():.2f})")

W = np.zeros((n_genes, n_genes))
for f in order[:best_k]:
    i, j = divmod(int(f), n_genes)
    W[i, j] = S_off[i, j]

# signs: equation-based pair (A, B2) primary; B3 tiebreak; conflict -> 0;
# B1 partial-correlation sign only as last-resort fallback.
signs = np.zeros((n_genes, n_genes))
ab_conflict = unresolved = fallback_b1 = fallback_default = 0
scored = 0
for i in range(n_genes):
    for j in range(n_genes):
        if W[i, j] == 0:
            continue
        sA, s2, s3, s1 = (np.sign(A_coef[i, j]), B2_sign[i, j],
                          B3_sign[i, j], B1_sign[i, j])
        scored += 1
        if sA != 0 and s2 != 0 and sA != s2:          # A/B2 conflict
            ab_conflict += 1
            if s3 == sA:
                primary = sA
            elif s3 == s2:
                primary = s2
            else:
                primary = 0.0                          # unresolved -> uncertain
                unresolved += 1
        else:
            primary = sA if sA != 0 else (s2 if s2 != 0 else (s3 if s3 != 0 else 0.0))
        if primary == 0 and s1 != 0:
            primary, fallback_b1 = s1, fallback_b1 + 1
        if primary == 0:
            primary, fallback_default = 1.0, fallback_default + 1
        signs[i, j] = primary
conflict_rate = unresolved / max(scored, 1)
print(f"[signs] A/B2 conflicts {ab_conflict}/{scored}; unresolved (sign 0) "
      f"{unresolved} = {conflict_rate:.2%}; B1 fallback {fallback_b1}, "
      f"default+1 fallback {fallback_default}")

# ---------------------------------------------------------------------------
# 7. diagnostics + outputs
# ---------------------------------------------------------------------------
assert np.isfinite(W).all() and W.dtype == np.float64
off_mask = ~np.eye(n_genes, dtype=bool)
density = (W[off_mask] != 0).sum() / off_mask.sum()
assert 0.05 <= density <= 0.40, density
np.fill_diagonal(W, 0.0)
signs[W == 0] = 0.0
assert np.all(signs[W != 0] != 0) and np.all(signs[W == 0] == 0) and np.isfinite(signs).all()
np.save("inferred_network.npy", W.astype(np.float64))
np.save("edge_sign_predictions.npy", signs.astype(np.float64))

out_strength = np.abs(W).sum(axis=0)
in_strength = np.abs(W).sum(axis=1)
hubs = np.argsort(-out_strength)[:2].tolist()
# sensitivity: B3 total-effect column sums (independent intervention-based
# influence ranking) as a robustness note for the hub choice
b3_tot = np.abs(M).sum(axis=0)
b3_top2 = np.argsort(-b3_tot)[:2].tolist()
with open("hub_genes.json", "w") as fh:
    json.dump({"hub_genes": [int(h) for h in hubs],
               "criterion": "out-strength (column sums of |inferred_network|), top 2",
               "sensitivity_note": "gene ranking by out-strength of the submitted "
                                    "topology; the independent B3 total-effect "
                                    f"ranking gives {b3_top2} - hub #1 agrees, the "
                                    "runner-up differs, so hub #2 carries "
                                    "criterion uncertainty"},
              fh, indent=2)

adj = (W != 0).astype(int)
np.fill_diagonal(adj, 0)
in_deg = adj.sum(axis=1)          # row sums  ([target, source])
out_deg = adj.sum(axis=0)         # column sums
metrics = {
    "convention": "[target, source]: [i,j] = influence of gene j on gene i; "
                  "in-degree = row sums, out-degree = column sums of the exact "
                  "nonzero submitted topology (no post-hoc threshold)",
    "n_genes": n_genes,
    "n_edges": int(adj.sum()),
    "density_offdiagonal": float(density),
    "in_degree_row_sums": {"per_gene": in_deg.tolist(), "mean": float(in_deg.mean()),
                           "max": int(in_deg.max()), "min": int(in_deg.min())},
    "out_degree_column_sums": {"per_gene": out_deg.tolist(), "mean": float(out_deg.mean()),
                               "max": int(out_deg.max()), "min": int(out_deg.min())},
    "weighted_in_strength_per_gene": np.round(in_strength, 4).tolist(),
    "weighted_out_strength_per_gene": np.round(out_strength, 4).tolist(),
    "reciprocal_edges": int(((adj + adj.T) == 2).sum() // 2),
    "hub_genes_by_out_strength": hubs}
with open("network_metrics.json", "w") as fh:
    json.dump(metrics, fh, indent=2)
