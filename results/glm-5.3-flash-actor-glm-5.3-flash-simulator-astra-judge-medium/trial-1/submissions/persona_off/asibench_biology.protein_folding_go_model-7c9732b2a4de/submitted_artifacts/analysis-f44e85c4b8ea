def _cmap(anchors, t):
    t = np.clip(np.asarray(t, float), 0.0, 1.0)
    n = len(anchors) - 1
    pos = t * n
    lo = np.clip(np.floor(pos).astype(int), 0, n - 1)
    frac = (pos - lo)[:, None]
    return (anchors[lo] * (1 - frac) + anchors[lo + 1] * frac).astype(np.uint8)


def _write_png(path, img):
    import zlib, struct
    h, w, _ = img.shape
    raw = b"".join(b"\x00" + img[y].tobytes() for y in range(h))
    def chunk(tag, data):
        return (struct.pack(">I", len(data)) + tag + data +
                struct.pack(">I", zlib.crc32(tag + data) & 0xFFFFFFFF))
    with open(path, "wb") as fh:
        fh.write(b"\x89PNG\r\n\x1a\n")
        fh.write(chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0)))
        fh.write(chunk(b"IDAT", zlib.compress(raw, 6)))
        fh.write(chunk(b"IEND", b""))


def _line(img, x0, y0, x1, y1, color, thick=1):
    x0, y0, x1, y1 = int(round(x0)), int(round(y0)), int(round(x1)), int(round(y1))
    dx, dy = abs(x1 - x0), abs(y1 - y0)
    sx = 1 if x0 < x1 else -1
    sy = 1 if y0 < y1 else -1
    err = dx - dy
    H, W, _ = img.shape
    x, y = x0, y0
    while True:
        if 0 <= y < H and 0 <= x < W:
            img[y, max(0, x - thick + 1):x + thick, :] = color
        if x == x1 and y == y1:
            break
        e2 = 2 * err
        if e2 > -dy:
            err -= dy; x += sx
        if e2 < dx:
            err += dx; y += sy


def _dashed_line(img, x0, y0, x1, y1, color, dash=6, gap=4, thick=1):
    L = np.hypot(x1 - x0, y1 - y0)
    nseg = max(int(L // (dash + gap)), 1)
    for s in range(nseg + 1):
        t0 = s * (dash + gap) / max(L, 1e-9)
        t1 = min(t0 + dash / max(L, 1e-9), 1.0)
        if t0 >= 1.0:
            break
        _line(img, x0 + t0 * (x1 - x0), y0 + t0 * (y1 - y0),
              x0 + t1 * (x1 - x0), y0 + t1 * (y1 - y0), color, thick)


def _disk(img, cx, cy, rad, color):
    H, W, _ = img.shape
    y0, y1 = max(0, int(cy - rad)), min(H, int(cy + rad) + 1)
    x0, x1 = max(0, int(cx - rad)), min(W, int(cx + rad) + 1)
    if y0 >= y1 or x0 >= x1:
        return
    yy, xx = np.mgrid[y0:y1, x0:x1]
    m = (yy - cy) ** 2 + (xx - cx) ** 2 <= rad * rad
    img[y0:y1, x0:x1][m] = color


def _frame(img, x0, y0, x1, y1):
    _line(img, x0, y0, x1, y0, (0, 0, 0))
    _line(img, x0, y1, x1, y1, (0, 0, 0))
    _line(img, x0, y0, x0, y1, (0, 0, 0))
    _line(img, x1, y0, x1, y1, (0, 0, 0))


def _axes(img, px0, py0, px1, py1, nx=5, ny=5):
    """black L-shaped axes with ticks (no text)"""
    _line(img, px0, py1, px1, py1, (0, 0, 0), 2)   # x axis (bottom)
    _line(img, px0, py0, px0, py1, (0, 0, 0), 2)   # y axis (left)
    for i in range(nx + 1):
        x = px0 + (px1 - px0) * i / nx
        _line(img, x, py1, x, py1 + 6, (0, 0, 0))
    for i in range(ny + 1):
        y = py1 - (py1 - py0) * i / ny
        _line(img, px0 - 6, y, px0, y, (0, 0, 0))


def _plot_curve(img, xs, ys, px0, py0, px1, py1, color, thick=2,
                xrange=None, yrange=None):
    xs = np.asarray(xs, float); ys = np.asarray(ys, float)
    if xrange is None:
        xrange = (xs.min(), xs.max())
    if yrange is None:
        yrange = (ys.min(), ys.max())
    tx = (xs - xrange[0]) / (xrange[1] - xrange[0] + 1e-12)
    ty = (ys - yrange[0]) / (yrange[1] - yrange[0] + 1e-12)
    X = px0 + tx * (px1 - px0)
    Y = py1 - ty * (py1 - py0)
    for i in range(len(X) - 1):
        _line(img, X[i], Y[i], X[i + 1], Y[i + 1], color, thick)
    return X, Y


def _vline(img, xfrac, px0, py0, px1, py1, color=(80, 80, 80)):
    x = px0 + xfrac * (px1 - px0)
    _dashed_line(img, x, py0, x, py1, color, dash=8, gap=6, thick=2)


def _render_fallback(d):
    W, H = 1400, 1100
    img = np.full((H, W, 3), 255, np.uint8)
    panels = {1: (50, 50, 660, 510), 2: (740, 50, 1350, 510),
              3: (50, 590, 660, 1050), 4: (740, 590, 1350, 1050)}
    fin, nset = d["final_lowT"], d["native_set"]
    temps, qh, pc = d["temperatures"], d["q_hists"], d["profile_centers"]
    t_star, fineT, hc = d["t_star"], d["fine_T"], d["hc_fine"]
    joint, kn, modes = d["joint"], d["k_near"], d["mode_locs"]

    # --- panel 1: final configuration (isometric projection) ---
    px0, py0, px1, py1 = panels[1]
    az, el = 0.65, 0.55
    ca, sa, ce, se = np.cos(az), np.sin(az), np.cos(el), np.sin(el)
    R = np.array([[ca, sa, 0], [-sa * se, ca * se, ce], [sa * ce, -ca * ce, se]])
    p3 = fin @ R.T
    lo, hi = p3.min(axis=0), p3.max(axis=0)
    span = max(hi[0] - lo[0], hi[1] - lo[1]) + 1e-9
    scale = 0.8 * min(px1 - px0, py1 - py0) / span
    cx0, cy0 = (px0 + px1) / 2, (py0 + py1) / 2
    XY = np.column_stack([cx0 + (p3[:, 0] - (lo[0] + hi[0]) / 2) * scale,
                          cy0 - (p3[:, 1] - (lo[1] + hi[1]) / 2) * scale])
    depth = p3[:, 2]
    cols = _cmap(_VIRIDIS, np.arange(d["n_beads"]) / max(d["n_beads"] - 1, 1))
    for (i, j) in sorted(nset):  # native contacts: red dashed (behind)
        if depth[i] + depth[j] < 2 * depth.mean():
            _dashed_line(img, *XY[i], *XY[j], (200, 30, 30), dash=7, gap=5)
    for i in range(d["n_beads"] - 1):  # bonds
        _line(img, *XY[i], *XY[i + 1], (20, 20, 20), 2)
    for (i, j) in sorted(nset):  # native contacts in front
        if depth[i] + depth[j] >= 2 * depth.mean():
            _dashed_line(img, *XY[i], *XY[j], (200, 30, 30), dash=7, gap=5)
    order = np.argsort(depth)
    for i in order:
        _disk(img, XY[i, 0], XY[i, 1], 8, cols[i])
    _frame(img, px0, py0, px1, py1)

    # --- panel 2: per-temperature Q histograms ---
    px0, py0, px1, py1 = panels[2]
    for k in range(len(temps)):
        col = _cmap(_COOLWARM, np.array([k / max(len(temps) - 1, 1)]))[0]
        _plot_curve(img, pc, qh[k], px0 + 45, py0 + 25, px1 - 15, py1 - 25,
                    tuple(int(c) for c in col), 2, xrange=(0, 1))
    _vline(img, (t_star - temps.min()) / (temps.max() - temps.min()),
           px0 + 45, py0 + 25, px1 - 15, py1 - 25)
    _axes(img, px0 + 45, py0 + 25, px1 - 15, py1 - 25)
    _frame(img, px0, py0, px1, py1)

    # --- panel 3: heat-capacity response curve ---
    px0, py0, px1, py1 = panels[3]
    _plot_curve(img, fineT, hc, px0 + 45, py0 + 25, px1 - 15, py1 - 25,
                (30, 80, 200), 2)
    _vline(img, (t_star - temps.min()) / (temps.max() - temps.min()),
           px0 + 45, py0 + 25, px1 - 15, py1 - 25)
    _axes(img, px0 + 45, py0 + 25, px1 - 15, py1 - 25)
    _frame(img, px0, py0, px1, py1)

    # --- panel 4: joint Q-energy histogram at nearest T* + F(Q) modes ---
    px0, py0, px1, py1 = panels[4]
    gx0, gy0, gx1, gy1 = px0 + 45, py0 + 25, px1 - 15, py1 - 25
    Hj = joint[kn]  # (20 Q bins, 20 z bins)
    flat = _cmap(_MAGMA, (Hj.T / Hj.max()).ravel())
    nx_, ny_ = Hj.shape[1], Hj.shape[0]
    cw, chh = (gx1 - gx0) / nx_, (gy1 - gy0) / ny_
    for iy in range(ny_):
        for ix in range(nx_):
            col = flat[iy * nx_ + ix]
            yA = gy1 - iy * chh
            img[int(gy0 + (ny_ - 1 - iy) * chh):int(gy0 + (ny_ - iy) * chh),
                int(gx0 + ix * cw):int(gx0 + (ix + 1) * cw)] = col
    for qm in modes:  # F(Q) mode markers on the z=0 row
        _disk(img, gx0 + qm * (gx1 - gx0), (gy0 + gy1) / 2, 9, (0, 230, 230))
    _axes(img, gx0, gy0, gx1, gy1)
    _frame(img, px0, py0, px1, py1)
    _write_png("visualization.png", img)


def _make_figure(d):
    if HAVE_MPL:
        _plot_mpl(d)
    else:
        _render_fallback(d)


def _plot_mpl(d):
    fin, nset = d["final_lowT"], d["native_set"]
    temps, qh, pc = d["temperatures"], d["q_hists"], d["profile_centers"]
    t_star, fineT, hc = d["t_star"], d["fine_T"], d["hc_fine"]
    joint, kn, modes = d["joint"], d["k_near"], d["mode_locs"]
    fig = plt.figure(figsize=(14, 11))
    ax1 = fig.add_subplot(2, 2, 1, projection="3d")
    ax1.scatter(fin[:, 0], fin[:, 1], fin[:, 2], c=np.arange(d["n_beads"]),
                cmap="viridis", s=60)
    for i in range(d["n_beads"] - 1):
        ax1.plot(*zip(fin[i], fin[i + 1]), "k-", lw=1)
    for (i, j) in sorted(nset):
        ax1.plot(*zip(fin[i], fin[j]), "r--", lw=0.6, alpha=0.6)
    ax1.set_title(f"Final lowest-T config (T={temps[0]:.3f})")
    ax2 = fig.add_subplot(2, 2, 2)
    cmap = plt.get_cmap("coolwarm")
    for k in range(len(temps)):
        ax2.plot(pc, qh[k], color=cmap(k / max(len(temps) - 1, 1)),
                 label=f"T={temps[k]:.3f}")
    ax2.axvline(t_star, color="k", ls="--", lw=1, label=f"T*={t_star:.3f}")
    ax2.set_xlabel("Q"); ax2.set_ylabel("P(Q)")
    ax2.set_title("Per-temperature Q histograms"); ax2.legend(fontsize=7)
    ax3 = fig.add_subplot(2, 2, 3)
    ax3.plot(fineT, hc, "b-")
    ax3.axvline(t_star, color="k", ls="--", label=f"T*={t_star:.3f}")
    ax3.set_xlabel("T"); ax3.set_ylabel("C(T) = var(E)/T^2")
    ax3.set_title("Heat-capacity response curve (secondary diagnostic)")
    ax3.legend()
    ax4 = fig.add_subplot(2, 2, 4)
    im = ax4.imshow(joint[kn].T, origin="lower", aspect="auto",
                    extent=[0, 1, -3, 3], cmap="magma")
    ax4.plot(modes, [0.0] * len(modes), "c*", ms=14, label="F(Q) modes")
    ax4.set_xlabel("Q"); ax4.set_ylabel("z-scored energy")
    ax4.set_title(f"Joint Q-energy hist at T={temps[kn]:.3f} (nearest T*)")
    ax4.legend()
    fig.colorbar(im, ax=ax4, label="probability mass")
    fig.suptitle("B3 interacting-bead stochastic dynamics: folding analysis")
    fig.tight_layout()
    fig.savefig("visualization.png", dpi=150)
    plt.close(fig)


