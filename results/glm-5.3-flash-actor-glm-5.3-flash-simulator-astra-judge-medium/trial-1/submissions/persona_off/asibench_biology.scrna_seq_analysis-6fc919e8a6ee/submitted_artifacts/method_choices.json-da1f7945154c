    "pca": {
      "method": "exact PCA via numpy SVD on centered log-normalized matrix, top 15 PCs",
      "justification": "denoising / dimension reduction; PC1 is marker-driven (corr with log library size = 0.024), so no size regression applied"
    },
    "clustering": {
      "method": "hierarchical bisecting k-means anchored on the connected components of the symmetric kNN graph (k=15, distance weights): the raw graph has 2 connected components (sizes [382, 418]) with a clear eigengap in the normalized-affinity spectrum (1.0000, 0.9997, then 0.8136...); starting from these components, clusters are repeatedly bisected - largest-within-WSS cluster first, split by k-means (scipy kmeans++, 30 restarts, min within-cluster SS) on a re-centered within-cluster PCA (top 10 PCs) - until k = n_clusters=4 clusters exist",
      "justification": "diagnostics showed (a) plain k-means on global PCA space is unstable (local minima collapse one cluster to >400 cells at higher WSS), and (b) the data are organized as two barely-connected superpopulations whose markers form two coherent expression programs; bisecting within components guarantees no cluster ever spans a genuine graph disconnection, while restarts guard against bad initializations. Marker-recovery evidence: the hierarchical solution and a balanced global PCA k-means recover the same one-vs-rest AUC structure (79 genes with max AUC>0.6), confirming the choice is not metric-driven",
      "k_selection": "k=4 fixed from metadata (2 components x 2 bisections); silhouette sweep k=2..6 in spectral space reported as supporting evidence only and does not override metadata"
    },
    "pseudotime": {
      "method": "Dijkstra geodesic distance from a data-driven root over the symmetrized kNN graph (edge weight = Euclidean distance), min-max scaled to [0,1]; outliers damped at the 99th percentile before scaling",
      "root_rule": "cell with lowest mean graph-geodesic distance to all cells (most central), which lies in the most graph-central cluster (cluster 0)",
      "justification": "no stage/time metadata exists; the central cluster is the hub of the cluster geometry (centroid distance ~5-5.4 to all others vs ~17.5 among branch clusters), consistent with a progenitor-like root",
      "degenerate_graph_handling": "connected components checked BEFORE any analysis step; if the graph is disconnected, components are linked by their nearest-pair Euclidean distance until one component remains (2 component(s) found after guard)"
    },
    "differential_expression": {
      "method": "one-vs-rest Mann-Whitney U per gene per cluster on log-normalized values; AUC = U/(n_in*n_out); gene score = max over clusters of (2*AUC - 1); ties broken by log2 fold change on the linear normalized scale",
      "justification": "rank-based and robust to heavy zero inflation (80.8% zeros); AUC is an interpretable effect size; full ranked list of all 250 genes output (no arbitrary top-K cutoff)"
    },
    "grn": {
      "method": "per-target OLS regression on standardized log-normalized TF expression using ONLY the first n_tf_genes=20 gene columns (per approved interpretation, the TF-column restriction applies to the GRN matrix only; clustering/pseudotime/DE use all genes). For each target j, TF j is regressed on the other 19 TFs (+ intercept); grn_scores[i,j] = standardized coefficient of TF i in the model for target j = directed effect of regulator i on target j (change in SDs of j per SD of i, conditional on all other TFs). Diagonal 0; scores signed; NOT min-max rescaled",
      "score_definition": "B[i,j] = beta_i in the OLS y_j ~ 1 + sum_{i!=j} y_i on z-scored log-normalized TF expression (n=800 cells); sign > 0 supports activation, sign < 0 repression evidence; strength evidence reported separately as the OLS t-statistic (|t| > 2 nominal cut)",
      "directedness": "each target has its own regression model, so B[i,j] and B[j,i] come from DIFFERENT models and are asymmetric by construction; the brief's convention grn_scores[i,j] = edge i->j is respected",
      "direction_identifiability_caveat": "for observational snapshot data with approximately linear-Gaussian conditional structure, edge direction is information-theoretically weakly identifiable; three data-driven direction tests were run and all showed NO usable signal: (1) pseudotime-lagged correlation asymmetry (max |asymmetry| 0.151 at lag 80 vs permutation-null mean 0.159; cross-lag stability ~ 0), (2) additive-noise-model (ANM) residual-dependence asymmetry on cubic fits (directional evidence D = 0.50 +/- 0.06 on the 26 strong pairs, indistinguishable from the 0.49 null on weak pairs), (3) heuristic orientations by conditional R^2, count variance, mean count, or detection rate (7-12 of 26 agreements = coin flips). The delivered directed scores therefore reflect the per-target regression effects (a standard directed GRN parameterization), and the unidentifiability of direction from this data alone is explicitly documented",
      "robustness_check": "Spearman rank correlation between TF profiles computed as a complementary check; sign agreement with the |t|>2 edge set reported",
      "justification": "regression-based (not merely correlational) inference partials out indirect effects through the other TFs (conditional, not marginal association); the 20x20 dense problem is computationally trivial"
    },
