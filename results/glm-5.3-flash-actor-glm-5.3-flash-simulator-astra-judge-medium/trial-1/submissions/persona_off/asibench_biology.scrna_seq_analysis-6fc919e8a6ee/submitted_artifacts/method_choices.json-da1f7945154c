  "method_choices": {
    "preprocessing": {
      "method": "library-size normalization to median size factor (CPM-like) + log1p",
      "justification": "counts are integer-valued raw UMI-like counts (verified); library sizes moderately variable (CV 0.191); log1p stabilizes variance for downstream Gaussian methods"
