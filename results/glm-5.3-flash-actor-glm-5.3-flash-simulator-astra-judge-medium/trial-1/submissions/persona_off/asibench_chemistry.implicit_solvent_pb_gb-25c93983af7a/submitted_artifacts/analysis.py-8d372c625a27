 '/':"00001 00010 00010 00100 01000 01000 10000",':':"00000 00110 00110 00000 00110 00110 00000",
 '+':"00000 00100 00100 11111 00100 00100 00000",'=':"00000 00000 11111 00000 11111 00000 00000",
 ',':"00000 00000 00000 00000 00110 00100 01000",'[':"01110 01000 01000 01000 01000 01000 01110",
 ']':"01110 00010 00010 00010 00010 00010 01110",'%':"01001 01010 00100 00100 01010 01010 00000"}


def _draw_text(img, x0, y0, text, scale=2, color=(0, 0, 0)):
    for ch in text.upper():
        g = _GLYPHS.get(ch, _GLYPHS[' '])
        rows = g.split()
        for ry, rowbits in enumerate(rows):
            for rx, bit in enumerate(rowbits):
                if bit == '1':
                    y = y0 + ry * scale
                    x = x0 + rx * scale
                    img[y:y + scale, x:x + scale] = color
        x0 += 6 * scale


def _diverging(v, vmax):
    c = np.clip(v / max(vmax, 1e-300), -1.0, 1.0)
    r = np.where(c >= 0, 255.0, 255.0 * (1.0 + c))
    g = np.where(c >= 0, 255.0 * (1.0 - c), 255.0 * (1.0 + c))
    b = np.where(c >= 0, 255.0 * (1.0 - c), 255.0)
    return np.stack([r, g, b], -1).astype(np.uint8)


def _write_png(path, img):
    import zlib, struct
    h, w, _ = img.shape
    raw = b''.join(b'\x00' + img[i].tobytes() for i in range(h))
    def chunk(tag, data):
        return (struct.pack('>I', len(data)) + tag + data +
                struct.pack('>I', zlib.crc32(tag + data) & 0xffffffff))
    png = (b'\x89PNG\r\n\x1a\n'
           + chunk(b'IHDR', struct.pack('>IIBBBBB', w, h, 8, 2, 0, 0, 0))
           + chunk(b'IDAT', zlib.compress(raw, 6)) + chunk(b'IEND', b''))
    open(path, 'wb').write(png)


def _imshow_panel(img, ox, oy, field, vmax, scale, label, unit):
    small = _diverging(field, vmax)
    big = np.repeat(np.repeat(small, scale, 0), scale, 1)
    img[oy:oy + big.shape[0], ox:ox + big.shape[1]] = big
    _draw_text(img, ox, oy + big.shape[0] + 6, label, 2, (0, 0, 0))
    _draw_text(img, ox + big.shape[1] - 14 * 12, oy - 18, unit, 2, (0, 0, 0))


def _bar_panel(img, ox, oy, w, h, primary, secondary):
    img[oy:oy + h, ox:ox + w] = (255, 255, 255)
    base = oy + h - 30
    img[base:base + 2, ox:ox + w] = (0, 0, 0)          # x axis
    img[oy:base, ox:ox + 2] = (0, 0, 0)                # y axis
    hi = max(abs(primary), abs(secondary), 1e-9)
    usable = (base - oy) - 44
    for k, (val, col, name) in enumerate([(primary, (70, 116, 193), 'primary (PB)'),
                                          (secondary, (221, 132, 43), 'secondary (GB)')]):
        bh = int(round(abs(val) / hi * usable))
        x = ox + 60 + k * (w // 2)
        if val >= 0:
            img[base - bh:base, x:x + 46] = col
        else:
            img[base:min(base + bh, oy + h), x:x + 46] = col
        _draw_text(img, x - 12, (base + 10) if val >= 0 else (base + bh + 10),
                   '%+.3f' % val, 2, (0, 0, 0))
        _draw_text(img, ox + 24, oy + 6, name, 2, (0, 0, 0))


def _overview_fallback(df_out):
    scale, pad = 8, 18
    pw = N_GRID * scale                      # 280
    W = pad + 3 * (pw + 60) + pad
    H = 90 + 8 * (pw + 60) + 40
    img = np.full((H, W, 3), 255, np.uint8)
    _draw_text(img, pad, 20, 'IMPLICIT-SOLVENT BINDING RESPONSE: PB PRIMARY VS GB-CROSS SECONDARY',
               2, (0, 0, 0))
    heads = ['SES SDF (PRESCRIBED PLANE)', 'REACTION FIELD (KCAL/MOL/E)', 'RESPONSE METRICS (KCAL/MOL)']
    for k, hd in enumerate(heads):
        _draw_text(img, pad + k * (pw + 60), 52, hd, 2, (0, 0, 0))
    for ci, case in enumerate(CASES):
        cid = case['case_id']
        ps = [p for p in PLANE_SPEC['planes'] if p['case_id'] == cid][0]
        geo = plane_slice(VOL_A[ci], ps['axis'], ps['plane_index'], ps['storage_order'])
        fld = np.load('results/field_slice.npy')[ci]
        y0 = 90 + ci * (pw + 60)
        _imshow_panel(img, pad, y0, geo, 3.0, scale,
                      '%s %s-plane SDF' % (cid, ps['axis']), 'SDF')
        _imshow_panel(img, pad + pw + 60, y0, fld, np.max(np.abs(fld)) or 1.0, scale,
                      '%s field' % cid, 'KCAL/MOL/E')
        _bar_panel(img, pad + 2 * (pw + 60), y0, pw + 60, pw,
                   df_out.metric_primary_kcal_mol[ci], df_out.metric_secondary_kcal_mol[ci])
        _draw_text(img, pad + 2 * (pw + 60), y0 + pw + 6, cid, 2, (0, 0, 0))
    _write_png('results/overview.png', img)


def make_overview(df_out):
    if HAVE_MPL:
        fig, axes = plt.subplots(8, 3, figsize=(15, 30))
        for ci, case in enumerate(CASES):
            cid = case['case_id']
            ps = [p for p in PLANE_SPEC['planes'] if p['case_id'] == cid][0]
            geo = plane_slice(VOL_A[ci], ps['axis'], ps['plane_index'], ps['storage_order'])
            fld = np.load('results/field_slice.npy')[ci]
            ax = axes[ci, 0]
            im = ax.imshow(geo, origin='lower', cmap='bwr_r', vmin=-3, vmax=3)
            ax.set_title(f"{cid} SES SDF [{ps['axis']}-plane]")
            plt.colorbar(im, ax=ax, fraction=0.046)
            ax = axes[ci, 1]
            vm = np.nanmax(np.abs(fld))
            im = ax.imshow(fld, origin='lower', cmap='bwr', vmin=-vm, vmax=vm)
            ax.set_title(f'{cid} reaction field (kcal/mol/e)')
            plt.colorbar(im, ax=ax, fraction=0.046)
            ax = axes[ci, 2]
            ax.bar([-0.15, 0.15],
                   [df_out.metric_primary_kcal_mol[ci], df_out.metric_secondary_kcal_mol[ci]],
                   0.3, color=['#4a74c1', '#dd842b'])
            ax.set_xticks([-0.15, 0.15])
            ax.set_xticklabels(['primary (PB)', 'secondary (GB cross)'], fontsize=8)
            ax.set_ylabel('kcal/mol')
            ax.set_title(f'{cid} response metrics')
        fig.suptitle('Implicit-solvent binding response: PB primary vs GB-cross secondary '
                     '(geometry slice = prescribed plane, SES signed distance)', y=0.995)
        fig.tight_layout(rect=[0, 0, 1, 0.99])
        fig.savefig('results/overview.png', dpi=110)
        plt.close(fig)
    else:
        _overview_fallback(df_out)


