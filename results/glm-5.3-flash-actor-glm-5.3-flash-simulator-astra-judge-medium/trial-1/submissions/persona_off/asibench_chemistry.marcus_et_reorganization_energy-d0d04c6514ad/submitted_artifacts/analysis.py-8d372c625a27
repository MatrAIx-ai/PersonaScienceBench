W, H = 1600, 1200
canvas = np.full((H, W, 3), 255, dtype=np.uint8)


def px(x, y, c):
    x, y = int(round(x)), int(round(y))
    if 0 <= y < H and 0 <= x < W:
        canvas[y, x] = c


def fill_rect(x0, y0, x1, y1, c):
    x0, x1 = sorted((int(x0), int(x1)))
    y0, y1 = sorted((int(y0), int(y1)))
    canvas[max(y0, 0):min(y1 + 1, H), max(x0, 0):min(x1 + 1, W)] = c


def blend_rect(x0, y0, x1, y1, c, alpha):
    x0, x1 = sorted((int(x0), int(x1)))
    y0, y1 = sorted((int(y0), int(y1)))
    sub = canvas[max(y0, 0):min(y1 + 1, H), max(x0, 0):min(x1 + 1, W)]
    sub[:] = (alpha * np.array(c) + (1 - alpha) * sub).astype(np.uint8)


def line(x0, y0, x1, y1, c, thick=1):
    n = int(max(abs(x1 - x0), abs(y1 - y0))) + 1
    for t in np.linspace(0, 1, max(n, 2)):
        x, y = x0 + t * (x1 - x0), y0 + t * (y1 - y0)
        for dy in range(-(thick // 2), thick // 2 + 1):
            for dx in range(-(thick // 2), thick // 2 + 1):
                px(int(round(x)) + dx, int(round(y)) + dy, c)


def circle(cx, cy, r, c):
    for yy in range(int(cy - r), int(cy + r) + 1):
        for xx in range(int(cx - r), int(cx + r) + 1):
            if (xx - cx) ** 2 + (yy - cy) ** 2 <= r * r:
                px(xx, yy, c)


