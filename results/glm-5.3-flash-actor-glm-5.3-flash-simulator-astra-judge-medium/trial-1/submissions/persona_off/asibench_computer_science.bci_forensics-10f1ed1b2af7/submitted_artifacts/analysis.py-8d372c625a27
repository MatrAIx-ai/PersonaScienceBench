     "L":"100100100100111","M":"101111111101101","N":"110101101101101",
     "O":"010101101101010","P":"110101110100100","Q":"010101101110011",
     "R":"110101110101101","S":"011100010001110","T":"111010010010010",
     "U":"101101101101111","V":"101101101101010","W":"101101111111101",
     "X":"101101010101101","Y":"101101010010010","Z":"111001010100111",
     "_":"000000000000111","-":"000000111000000",".":"000000000000010",
     "(":"010100100100010",")":"010001001001010","=":"000111000111000",
     ":":"000010000010000",",":"000000000010100","/":"001001010100100",
     " ":"000000000000000"}

def _png_write(path, img):
    h, w, _ = img.shape
    raw = b"".join(b"\x00" + img[y].tobytes() for y in range(h))
    def chunk(tag, data):
        return (struct.pack(">I", len(data)) + tag + data +
                struct.pack(">I", zlib.crc32(tag + data) & 0xFFFFFFFF))
    png = (b"\x89PNG\r\n\x1a\n" +
           chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0)) +
           chunk(b"IDAT", zlib.compress(raw, 6)) + chunk(b"IEND", b""))
    Path(path).write_bytes(png)

def _draw_text(img, x, y, text, scale=2, color=(30, 30, 30)):
    cx = x
    for ch in text.upper():
        rows = F.get(ch, F[" "])
        for r in range(5):
            for c in range(3):
                if rows[r * 3 + c] == "1":
                    img[y + r * scale:y + (r + 1) * scale,
                        cx + c * scale:cx + (c + 1) * scale] = color
        cx += 4 * scale
    return cx

def _hline(img, x0, x1, y, color=(120, 120, 120)):
    img[y, x0:x1 + 1] = color

def _vline(img, x, y0, y1, color=(120, 120, 120)):
    img[y0:y1 + 1, x] = color

def _panel(img, x0, y0, w, h, title):
    img[y0:y0 + h, x0:x0 + w] = (255, 255, 255)
    _hline(img, x0, x0 + w - 1, y0, (60, 60, 60))
    _hline(img, x0, x0 + w - 1, y0 + h - 1, (60, 60, 60))
    _vline(img, x0, y0, y0 + h - 1, (60, 60, 60))
    _vline(img, x0 + w - 1, y0, y0 + h - 1, (60, 60, 60))
    _draw_text(img, x0 + 12, y0 + 10, title, 3, (20, 20, 20))

def _bars(img, px0, py0, pw, ph, series, labels, hline=None):
    n = len(labels)
    vmax = max(max(float(np.max(v)) for _, _, v in series), 1e-12) * 1.15
    ax0, ay0 = px0 + 110, py0 + 70
    ax1, ay1 = px0 + pw - 30, py0 + ph - 60
    for frac in (0.0, 0.25, 0.5, 0.75, 1.0):
        yy = int(ay1 - frac * (ay1 - ay0))
        _hline(img, ax0, ax1, yy, (225, 225, 225))
        _draw_text(img, px0 + 8, yy - 7, f"{frac * vmax:.2f}", 2, (90, 90, 90))
    _vline(img, ax0, ay0, ay1); _hline(img, ax0, ax1, ay1, (60, 60, 60))
    if hline is not None:
        yy = int(ay1 - hline / vmax * (ay1 - ay0))
        _hline(img, ax0, ax1, yy, (200, 40, 40))
        _draw_text(img, ax1 - 160, yy - 18, "BASELINE REF", 2, (200, 40, 40))
    slot = (ax1 - ax0) / n
    bw = max(int(slot * 0.6 / len(series)), 2)
    for i in range(n):
        for si, (_, col, vals) in enumerate(series):
            v = float(np.asarray(vals)[i]) / vmax * (ay1 - ay0)
            bx = int(ax0 + slot * (i + 0.5) - slot * 0.3 + si * bw)
            img[max(int(ay1 - v), ay0):int(ay1), bx:bx + bw] = col
        _draw_text(img, int(ax0 + slot * (i + 0.5) - 36), ay1 + 8, labels[i], 2)
    lx = ax0 + 10
    for name, col, _ in series:
        img[py0 + 40:py0 + 50, lx:lx + 10] = col
        lx = _draw_text(img, lx + 14, py0 + 40, name, 2) + 14

def _lines(img, px0, py0, pw, ph, series, labels):
    n = len(labels)
    vmax = max(max(float(np.max(v)) for _, _, v in series), 1e-12) * 1.15
    ax0, ay0 = px0 + 110, py0 + 70
    ax1, ay1 = px0 + pw - 30, py0 + ph - 60
    for frac in (0.0, 0.5, 1.0):
        yy = int(ay1 - frac * (ay1 - ay0))
        _hline(img, ax0, ax1, yy, (225, 225, 225))
        _draw_text(img, px0 + 8, yy - 7, f"{frac * vmax:.3f}", 2, (90, 90, 90))
    _vline(img, ax0, ay0, ay1); _hline(img, ax0, ax1, ay1, (60, 60, 60))
    slot = (ax1 - ax0) / max(n - 1, 1)
    for name, col, vals in series:
        vals = np.asarray(vals, float)
        pts = [(int(ax0 + slot * i), int(ay1 - vals[i] / vmax * (ay1 - ay0)))
               for i in range(n)]
        for i in range(n - 1):
            (xa, ya), (xb, yb) = pts[i], pts[i + 1]
            for t in range(max(abs(xb - xa), 1)):
                xx = xa + t
                yy = int(ya + (yb - ya) * t / max(xb - xa, 1))
                img[yy - 1:yy + 1, xx:xx + 2] = col
        for xx, yy in pts:
            img[yy - 3:yy + 3, xx - 3:xx + 3] = col
    lx = ax0 + 10
    for name, col, _ in series:
        img[py0 + 40:py0 + 50, lx:lx + 10] = col
        lx = _draw_text(img, lx + 14, py0 + 40, name, 2) + 14
    for i in range(n):
        _draw_text(img, int(ax0 + slot * i - 36), ay1 + 8, labels[i], 2)

