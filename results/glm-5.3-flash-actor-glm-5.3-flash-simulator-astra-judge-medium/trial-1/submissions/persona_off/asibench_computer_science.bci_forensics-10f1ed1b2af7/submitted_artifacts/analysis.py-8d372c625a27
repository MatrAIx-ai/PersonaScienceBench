#!/usr/bin/env python3
"""
Deterministic confidence-interval engine forensics analysis.

Declared scales / orientations (internal consistency is authoritative):
  * Population target per case t_c = mean over the 108 calibration replications of
    the replication statistic (public statistic definition). Sensitivity note: the
    pooled-calibration statistic differs only in the 3rd decimal for the CV / median
    cases (case_02: 0.7241 vs 0.7297; case_05: 0.8689 vs 0.8591); the coverage
    ranking is unchanged. Recorded in reliability_report.case_warnings.
  * empirical_coverage = P(cal_low <= t_c <= cal_high) over 108 replications;
    miss_low_rate = P(t_c < low); miss_high_rate = P(t_c > high).
  * All probe severities (probe_metric_*) are >= 0 with SMALLER = HEALTHIER:
      probe_00 alias severity      : closeness of endpoints to the naive
                                     percentile construction or its mirror
                                     (1 - minmax(min distance)); clones severe.
      probe_01 asymmetry mismatch  : |A_engine - A_ref| of normalised endpoint
                                     asymmetry about observed_stat (obs + cal).
      probe_02 stress response dev : |panel_02 shift - cross-engine mean shift|.
      probe_03 variant instability : dispersion of probe_panel_03 variants around
                                     the engine's own observed interval.
      probe_04 discrete boundary   : endpoint deviation from the percentile
                                     reference on the discrete regime (0 else).
  * diagnostic_score = diagnostic_value / cross-engine mean of that (case, family)
    cell (monotone, finite; 0 when the cell mean is 0).
  * mm() maps each cross-engine metric to [0,1] (0 = best). engine_score /
    profile_score are weighted means of normalised severities -> smaller = more
    reliable. evidence_score is larger = more likely for that label.
  * coverage_score = max(0, 1 - |empirical - nominal| / nominal) (higher = better).
Engine score weights: coverage_gap .26, tail_imbalance .12, |1-width_ratio| .12,
case_dispersion .12, probe metrics jointly .38 (.076 each).
Failure-label evidence (per engine, higher = more likely):
  reliable_engine = 1 - mm(engine_score);
  baseline_quantile_alias = 1 - mm(mean distance to percentile reference);
  reflection_alias = (1 - mm(mean distance to mirrored reference))
                     * (1 - mm(mean |A_engine + A_ref|));
  discrete_boundary_mismatch = mm(probe_04 metric);
  shape_correction_mismatch = mm(mean |A_engine - A_ref| over skewed/ratio cases);
  scale_response_mismatch = mm(0.5*mm(width-scale dispersion)
                               + 0.5*mm(stress response deviation));
  noise_amplifying_engine = mm(0.5*mm(case_dispersion) + 0.5*mm(probe_03 metric));
  predicted label = argmax evidence; exact evidence ties are broken by the
  dominance rule (label on which the engine is most dominant relative to
  every other engine's evidence), then vocabulary order; the
  argmin-engine_score engine is reconciled to reliable_engine when needed.
"""
import json
import numpy as np
import pandas as pd
from pathlib import Path
from statistics import NormalDist

DATA = Path("data"); OUT = Path("results"); OUT.mkdir(exist_ok=True)
study = json.loads((DATA / "study_manifest.json").read_text())
probe_man = json.loads((DATA / "probe_manifest.json").read_text())
NOMINAL = study["confidence_level"]
CASES = study["cases"]; CASE_IDS = [c["case_id"] for c in CASES]
ENGINES = list(study["engine_ids"]); LABELS = list(study["failure_label_vocabulary"])
PROBES = list(probe_man["probe_families"]); ALPHA = (1.0 - NOMINAL) / 2.0
Z = NormalDist().inv_cdf(1 - ALPHA)
obs = pd.read_csv(DATA / "observed_samples.csv")
rpanel = np.load(DATA / "resample_panels.npz")
cal = np.load(DATA / "calibration_samples.npz")
calp = np.load(DATA / "calibration_resample_panels.npz")
eng = np.load(DATA / "engine_interval_panels.npz", allow_pickle=True)
E, C = len(ENGINES), len(CASE_IDS)
obs_vals = {c["case_id"]: obs.loc[obs.case_id == c["case_id"], "value"].to_numpy(float)
            for c in CASES}
assert all(len(v) == c["n_observations"] for c, v in zip(CASES, obs_vals.values()))

def stat_fn(name, params, v, axis=-1):
    if name == "mean":
        return v.mean(axis=axis)
    if name == "median":
        return np.median(v, axis=axis)
    if name == "coefficient_of_variation":
        return v.std(axis=axis, ddof=params.get("std_ddof", 1)) / v.mean(axis=axis)
    if name == "upper_tail_rate":
        t = params["threshold"]; op = params.get("comparison", ">=")
        return (v >= t).mean(axis=axis) if op == ">=" else (v > t).mean(axis=axis)
    raise ValueError(name)

def boot_stats(case_id, case):
    idx = rpanel[case_id]
    return stat_fn(case["statistic_name"], case["statistic_parameters"],
                   obs_vals[case_id][idx], axis=1)          # (885,)

def cal_boot_stats(case_id, case):
    s = cal[case_id]; idx = calp[case_id]                    # (108,74) (108,374,74)
    vals = s[np.arange(s.shape[0])[:, None, None], idx]      # (108,374,74)
    return stat_fn(case["statistic_name"], case["statistic_parameters"], vals, axis=2)

def mm(v):
    v = np.asarray(v, float); lo, hi = v.min(), v.max()
    return np.zeros_like(v) if hi - lo < 1e-15 else (v - lo) / (hi - lo)

# ------------------------------------------------------- targets & coverage audit
targets, targets_pooled = {}, {}
for c in CASES:
    per_rep = stat_fn(c["statistic_name"], c["statistic_parameters"],
                      cal[c["case_id"]], axis=1)
    targets[c["case_id"]] = float(per_rep.mean())
    targets_pooled[c["case_id"]] = float(
        stat_fn(c["statistic_name"], c["statistic_parameters"],
                cal[c["case_id"]].ravel(), axis=0))
cov_rows = []
emp = np.zeros((E, C)); miss_lo = np.zeros((E, C)); miss_hi = np.zeros((E, C))
mwidth = np.zeros((E, C))
for j, c in enumerate(CASES):
    cid = c["case_id"]; t = targets[cid]
    lo = eng["calibration_low"][:, j, :]; hi = eng["calibration_high"][:, j, :]
    emp[:, j] = ((lo <= t) & (t <= hi)).mean(axis=1)
    miss_lo[:, j] = (t < lo).mean(axis=1)
    miss_hi[:, j] = (t > hi).mean(axis=1)
    mwidth[:, j] = (hi - lo).mean(axis=1)
    for i, eid in enumerate(ENGINES):
        cs = max(0.0, 1.0 - abs(emp[i, j] - NOMINAL) / NOMINAL)
        cov_rows.append(dict(case_id=cid, regime=c["regime"], engine_id=eid,
                             nominal_coverage=NOMINAL, empirical_coverage=emp[i, j],
                             mean_width=mwidth[i, j], miss_low_rate=miss_lo[i, j],
                             miss_high_rate=miss_hi[i, j],
                             n_replications=int(c["n_calibration_replications"]),
                             coverage_score=cs))
coverage_audit = pd.DataFrame(cov_rows)

# ------------------------------------------- percentile-bootstrap reference panels
ref_lo = np.zeros(C); ref_hi = np.zeros(C)
nrep = int(CASES[0]["n_calibration_replications"])
cref_lo = np.zeros((C, nrep)); cref_hi = np.zeros_like(cref_lo)
for j, c in enumerate(CASES):
    q = np.quantile(boot_stats(c["case_id"], c), [ALPHA, 1 - ALPHA])
    ref_lo[j], ref_hi[j] = q
    assert np.allclose([ref_lo[j], ref_hi[j]],
                       [eng["baseline_low"][j], eng["baseline_high"][j]]), \
        "baseline panels must equal percentile-bootstrap reference"
    cq = np.quantile(cal_boot_stats(c["case_id"], c), [ALPHA, 1 - ALPHA], axis=1)
    cref_lo[j], cref_hi[j] = cq
ref_w = ref_hi - ref_lo

# ------------------------------------------------------------- probe diagnostics
p = np.zeros((5, E, C))
dist_pct = np.zeros((E, C)); dist_refl = np.zeros((E, C)); asym_ref = np.zeros(C)
p1_obs = np.zeros((E, C))
for j, c in enumerate(CASES):
    cid = c["case_id"]
    lo = eng["observed_low"][:, j]; hi = eng["observed_high"][:, j]
    st = eng["observed_stat"][j]; w = ref_w[j]
    refl = np.array([2 * st - ref_hi[j], 2 * st - ref_lo[j]])
    dist_pct[:, j] = (np.abs(lo - ref_lo[j]) + np.abs(hi - ref_hi[j])) / w
    dist_refl[:, j] = (np.abs(lo - refl[0]) + np.abs(hi - refl[1])) / w
    d_min = np.minimum(dist_pct[:, j], dist_refl[:, j])
    p[0, :, j] = 1.0 - mm(d_min)      # clones (small distance) -> severe (~1)
    cal_lo = eng["calibration_low"][:, j, :]; cal_hi = eng["calibration_high"][:, j, :]
    a_ref = ((ref_hi[j] - st) - (st - ref_lo[j])) / w
    asym_ref[j] = a_ref
    a_eng = ((hi - st) - (st - lo)) / (hi - lo)
    a_ref_cal = ((cref_hi[j] - targets[cid]) - (targets[cid] - cref_lo[j])) / \
                (cref_hi[j] - cref_lo[j])
    a_eng_cal = ((cal_hi - targets[cid]) - (targets[cid] - cal_lo)) / (cal_hi - cal_lo)
    p1_obs[:, j] = np.abs(a_eng - a_ref)
    p[1, :, j] = 0.5 * (p1_obs[:, j] +
                        np.abs(a_eng_cal - a_ref_cal).mean(axis=1))
    resp = (np.abs(eng["probe_panel_02_low"][:, j] - lo) +
            np.abs(eng["probe_panel_02_high"][:, j] - hi)) / 2.0
    p[2, :, j] = np.abs(resp - resp.mean())
    plo = eng["probe_panel_03_low"][:, j, :]; phi = eng["probe_panel_03_high"][:, j, :]
    mid = (plo + phi) / 2.0; wid = phi - plo; wobs = hi - lo
    p[3, :, j] = 0.5 * (np.abs(mid - (lo + hi)[:, None] / 2.0).mean(axis=1) / wobs +
                        np.abs(wid - wobs[:, None]).mean(axis=1) / wobs)
    support = np.unique(np.round(boot_stats(cid, c), 12))
    if support.size < 0.5 * c["n_observed_bootstrap"]:   # genuinely discrete regime
        p[4, :, j] = (np.abs(lo - ref_lo[j]) + np.abs(hi - ref_hi[j])) / w
    # continuous regimes: lattice alignment not applicable -> severity stays 0

probe_audit_rows = []
for j, cid in enumerate(CASE_IDS):
    for k, fam in enumerate(PROBES):
        cell = p[k, :, j]; denom = cell.mean()
        scores = np.zeros(E) if denom < 1e-15 else cell / denom
        for i, eid in enumerate(ENGINES):
            probe_audit_rows.append(dict(case_id=cid, probe_family=fam,
                                         engine_id=eid,
                                         diagnostic_value=float(cell[i]),
                                         diagnostic_score=float(scores[i])))
probe_audit = pd.DataFrame(probe_audit_rows)
probe_metric = p.mean(axis=2)                               # (5, E)

prof_rows = []
for j, cid in enumerate(CASE_IDS):
    norm = np.array([mm(p[k, :, j]) for k in range(5)])
    pscore = 0.2 * norm.sum(axis=0)
    for i, eid in enumerate(ENGINES):
        row = dict(case_id=cid, engine_id=eid)
        for k in range(5):
            row[f"probe_signal_{k:02d}"] = float(p[k, i, j])
        row["profile_score"] = float(pscore[i])
        prof_rows.append(row)
case_probe_profile = pd.DataFrame(prof_rows)

# ------------------------------------------------------------------ engine audit
width_ratio_c = mwidth / ref_w[None, :]
coverage_gap = np.abs(emp - NOMINAL).mean(axis=1)
tail_imbalance = np.abs(miss_lo - miss_hi).mean(axis=1)
width_ratio = width_ratio_c.mean(axis=1)
cal_w = eng["calibration_high"] - eng["calibration_low"]     # (E, C, 108)
case_dispersion = (cal_w.std(axis=2, ddof=0) /
                   np.maximum(cal_w.mean(axis=2), 1e-12)).mean(axis=1)
norm_g, norm_t = mm(coverage_gap), mm(tail_imbalance)
norm_w = mm(np.abs(width_ratio - 1)); norm_d = mm(case_dispersion)
norm_p = np.array([mm(probe_metric[k]) for k in range(5)])   # (5, E)
W = dict(coverage_gap=0.26, tail_imbalance=0.12, width=0.12, dispersion=0.12,
         probe=0.38)
engine_score = (W["coverage_gap"] * norm_g + W["tail_imbalance"] * norm_t +
                W["width"] * norm_w + W["dispersion"] * norm_d +
                W["probe"] * norm_p.mean(axis=0))
engine_audit = pd.DataFrame(dict(
    engine_id=ENGINES, coverage_gap=coverage_gap, tail_imbalance=tail_imbalance,
    width_ratio=width_ratio, case_dispersion=case_dispersion,
    **{f"probe_metric_{k:02d}": probe_metric[k] for k in range(5)},
    engine_score=engine_score))

# ------------------------------------------------------ failure evidence & labels
skewed_idx = [j for j, c in enumerate(CASES)
              if c["regime"] in ("skewed_positive", "ratio_statistic")]
shape_sev = p1_obs[:, skewed_idx].mean(axis=1)   # observed asymmetry only
wscale = (eng["observed_high"] - eng["observed_low"]) / (2 * Z *
          np.array([boot_stats(c["case_id"], c).std(ddof=1) for c in CASES])[None, :])
scale_sev = 0.5 * mm((wscale.max(axis=1) - wscale.min(axis=1)) /
                     np.maximum(wscale.mean(axis=1), 1e-12)) + 0.5 * mm(p[2].mean(axis=1))
noise_sev = 0.5 * mm(case_dispersion) + 0.5 * mm(probe_metric[3])
refl_sym = np.abs(((eng["observed_high"] - eng["observed_stat"]) -
                   (eng["observed_stat"] - eng["observed_low"])) /
                  (eng["observed_high"] - eng["observed_low"]) +
                  asym_ref[None, :]).mean(axis=1)
evid = {
    "reliable_engine": 1.0 - engine_score / max(engine_score.max(), 1e-15),
    "baseline_quantile_alias": 1.0 - mm(dist_pct.mean(axis=1)),
    "reflection_alias": (1.0 - mm(dist_refl.mean(axis=1))) * (1.0 - mm(refl_sym)),
    "discrete_boundary_mismatch": mm(probe_metric[4]),
    "shape_correction_mismatch": mm(shape_sev),
    "scale_response_mismatch": mm(scale_sev),
    "noise_amplifying_engine": mm(noise_sev),
}
ev_rows = []; predicted = {}; ev_rank = {}
for i, eid in enumerate(ENGINES):
    scores = {lab: float(evid[lab][i]) for lab in LABELS}
    top = max(scores.values())
    tied = [lab for lab in LABELS if scores[lab] >= top - 1e-12]
    if len(tied) == 1:
        order = sorted(LABELS, key=lambda lab: (-scores[lab], LABELS.index(lab)))
    else:
        # dominance tie-break: prefer the label on which this engine is most
        # dominant relative to every other engine's evidence for that label
        dominance = {lab: (scores[lab] /
                           max(max(float(evid[lab][k]) for k in range(E) if k != i),
                               1e-12)) for lab in tied}
        order = sorted(LABELS, key=lambda lab: (-scores[lab], -dominance.get(lab, 0.0),
                                                LABELS.index(lab)))
    predicted[eid] = order[0]
    ev_rank[eid] = {lab: r + 1 for r, lab in enumerate(order)}
    for lab in LABELS:
        ev_rows.append(dict(engine_id=eid, failure_label=lab,
                            evidence_score=scores[lab],
                            label_rank=ev_rank[eid][lab], is_predicted_label=0))
failure_evidence = pd.DataFrame(ev_rows)

# ---------------------------------------------------------------- selection
selected_i = int(np.argmin(engine_score)); selected_id = ENGINES[selected_i]
reconciliation = None
if predicted[selected_id] != "reliable_engine":
    reconciliation = (f"argmin engine_score ({selected_id}) had argmax evidence "
                      f"'{predicted[selected_id]}'; reconciled to reliable_engine "
                      f"because engine_score is the authoritative selection rule and "
                      f"its score margin over the field is "
                      f"{engine_score.max() - engine_score[selected_i]:.4f}.")
    predicted[selected_id] = "reliable_engine"
for i, eid in enumerate(ENGINES):
    failure_evidence.loc[(failure_evidence.engine_id == eid) &
                         (failure_evidence.failure_label == predicted[eid]),
                         "is_predicted_label"] = 1
failure_modes = {"selected_engine_id": selected_id,
                 "failure_modes": {eid: predicted[eid] for eid in ENGINES}}
selected_engine = {"selected_engine_id": selected_id,
                   "selected_failure_mode": predicted[selected_id],
                   "selected_engine_score": float(engine_score[selected_i])}

# ------------------------------------------------------------- family ablation
def combined_score(exclude=None):
    comps = [(W["coverage_gap"], norm_g), (W["tail_imbalance"], norm_t),
             (W["width"], norm_w), (W["dispersion"], norm_d)]
    keep = [k for k in range(5) if exclude is None or PROBES[k] != exclude]
    comps += [(W["probe"] / 5.0, norm_p[k]) for k in keep]
    wsum = sum(w for w, _ in comps)
    return sum(w * v for w, v in comps) / wsum

abl_rows = []; ablation_notes = []
for excl in ["none"] + PROBES:
    sc = combined_score(None if excl == "none" else excl)
    order = np.argsort(sc, kind="stable")
    top, runner = int(order[0]), int(order[1])
    sel_rank = int(np.where(order == selected_i)[0][0]) + 1
    abl_rows.append(dict(excluded_probe_family=excl, top_engine_id=ENGINES[top],
                         selected_engine_rank=sel_rank,
                         runner_up_engine_id=ENGINES[runner],
                         score_margin=float(abs(sc[runner] - sc[top]))))
    if ENGINES[top] != selected_id:
        ablation_notes.append(f"excluding {excl} moves the top rank to "
                              f"{ENGINES[top]} (selected engine rank {sel_rank})")
family_ablation = pd.DataFrame(abl_rows)

# --------------------------------------------------------------- interval_summary
int_rows = []
for j, c in enumerate(CASES):
    slo = eng["observed_low"][selected_i, j]
    shi = eng["observed_high"][selected_i, j]
    bwid = ref_w[j]
    int_rows.append(dict(
        case_id=c["case_id"], statistic_name=c["statistic_name"],
        observed_stat=float(eng["observed_stat"][j]), selected_engine_id=selected_id,
        selected_low=float(slo), selected_high=float(shi),
        baseline_low=float(eng["baseline_low"][j]),
        baseline_high=float(eng["baseline_high"][j]),
        selected_width=float(shi - slo), baseline_width_ratio=float((shi - slo) / bwid)))
interval_summary = pd.DataFrame(int_rows)

# ---------------------------------------------------------- reliability report
agg_probe = float(norm_p[:, selected_i].mean())
ranking = [ENGINES[i] for i in np.argsort(engine_score, kind="stable")]
case_warnings = {}
for j, c in enumerate(CASES):
    cid = c["case_id"]
    ml, mh = miss_lo[selected_i, j], miss_hi[selected_i, j]
    wr = width_ratio_c[selected_i, j]; warn = {}
    if abs(ml - mh) > 0.05:
        warn["tail_asymmetry"] = (f"selected-engine miss rates asymmetric: "
                                  f"low={ml:.3f} vs high={mh:.3f}")
    if abs(wr - 1.0) > 0.05:
        warn["width_vs_baseline"] = f"width ratio vs percentile baseline {wr:.3f}"
    if abs(targets_pooled[cid] - targets[cid]) > 1e-9:
        warn["target_sensitivity"] = (f"replication-mean target {targets[cid]:.4f} vs "
                                      f"pooled-statistic target "
                                      f"{targets_pooled[cid]:.4f} (coverage ranking "
                                      f"unchanged under either target)")
    case_warnings[cid] = warn if warn else {"status": "no anomaly flagged"}
case_warnings["_method_note"] = ("Target = mean of 108 per-replication calibration "
                                 "statistics; empirical_coverage brackets that target. "
                                 "Pooled-statistic sensitivity check recorded per case.")
report = {"selected_engine_id": selected_id,
          "aggregate_coverage_gap": float(coverage_gap[selected_i]),
          "aggregate_tail_imbalance": float(tail_imbalance[selected_i]),
          "aggregate_probe_score": agg_probe,
          "engine_ranking": ranking, "case_warnings": case_warnings}
if reconciliation:
    report["selection_reconciliation"] = reconciliation
if ablation_notes:
    report["ablation_stability_notes"] = ablation_notes

# ----------------------------------------------------------------- write outputs
engine_audit.to_csv(OUT / "engine_audit.csv", index=False)
coverage_audit.to_csv(OUT / "coverage_audit.csv", index=False)
probe_audit.to_csv(OUT / "probe_audit.csv", index=False)
case_probe_profile.to_csv(OUT / "case_probe_profile.csv", index=False)
failure_evidence.to_csv(OUT / "failure_evidence.csv", index=False)
family_ablation.to_csv(OUT / "family_ablation.csv", index=False)
interval_summary.to_csv(OUT / "interval_summary.csv", index=False)
(OUT / "failure_modes.json").write_text(json.dumps(failure_modes, indent=2))
(OUT / "selected_engine.json").write_text(json.dumps(selected_engine, indent=2))
(OUT / "reliability_report.json").write_text(json.dumps(report, indent=2))

# ------------------------------------------------------------------ validation
assert list(engine_audit.columns) == study["audit_columns"]["engine_audit"]
assert list(coverage_audit.columns) == study["audit_columns"]["coverage_audit"]
assert list(probe_audit.columns) == probe_man["diagnostic_columns"]
assert list(case_probe_profile.columns) == study["audit_columns"]["case_probe_profile"]
assert list(failure_evidence.columns) == study["audit_columns"]["failure_evidence"]
assert list(family_ablation.columns) == study["audit_columns"]["family_ablation"]
assert list(interval_summary.columns) == [
    "case_id", "statistic_name", "observed_stat", "selected_engine_id", "selected_low",
    "selected_high", "baseline_low", "baseline_high", "selected_width",
    "baseline_width_ratio"]
assert len(engine_audit) == E and len(coverage_audit) == E * C
assert len(probe_audit) == E * C * len(PROBES)
assert len(case_probe_profile) == E * C and len(failure_evidence) == E * len(LABELS)
assert len(family_ablation) == 1 + len(PROBES) and len(interval_summary) == C
for df in (engine_audit, coverage_audit, probe_audit, case_probe_profile,
           failure_evidence, family_ablation, interval_summary):
    assert np.isfinite(df.select_dtypes(include=[np.number]).to_numpy()).all(), df
assert (failure_evidence.groupby("engine_id").is_predicted_label.sum() == 1).all()
assert family_ablation.score_margin.ge(0).all()
assert failure_modes["selected_engine_id"] == selected_engine["selected_engine_id"] \
    == interval_summary.selected_engine_id.unique()[0] == report["selected_engine_id"]
assert set(failure_modes["failure_modes"].values()) <= set(LABELS)
assert sorted(coverage_audit.case_id.unique()) == sorted(CASE_IDS)
assert sorted(engine_audit.engine_id) == sorted(ENGINES)

print("selected:", selected_id, "| score:", round(float(engine_score[selected_i]), 4))
print("ranking:", ranking)
print("failure modes:", json.dumps(failure_modes["failure_modes"]))
print(reconciliation or "no reconciliation needed")
print(family_ablation.round(4).to_string(index=False))
print(engine_audit.round(4).to_string(index=False))
print(pd.DataFrame(emp, index=ENGINES, columns=CASE_IDS).round(3).to_string())

