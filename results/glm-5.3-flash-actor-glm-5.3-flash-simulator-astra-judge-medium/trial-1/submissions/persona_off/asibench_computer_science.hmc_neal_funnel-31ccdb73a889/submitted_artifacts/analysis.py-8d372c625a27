                lab = f"{fx:.3g}" if abs(fx) < 1000 else f"{fx:.2g}"
                self.text(gx-6, y1+8, lab, scale=1)
                fy = ylim[0] + (ylim[1]-ylim[0])*i/4
                gy = int(tf_y(fy))
                self._line(x0, gy, x1, gy, (230,230,230))
                lab = f"10^{fy:.3g}" if logy and fy != 0 else f"{fy:.3g}"
                self.text(x0-40, gy-6, lab, scale=1)
            return tf_x, tf_y

        def save(self, path):
            raw = b''.join(b'\x00' + self.img[y].tobytes()
                           for y in range(self.H))
            def chunk(tag, data):
                c = struct.pack('>I', len(data)) + tag + data
                return c + struct.pack('>I', zlib.crc32(tag+data) & 0xffffffff)
            png = (b'\x89PNG\r\n\x1a\n'
