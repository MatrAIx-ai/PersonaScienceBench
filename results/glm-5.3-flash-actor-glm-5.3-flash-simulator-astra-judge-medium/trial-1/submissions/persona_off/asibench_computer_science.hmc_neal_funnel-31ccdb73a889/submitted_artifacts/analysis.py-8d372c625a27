            self.nr, self.nc = nrows, ncols
            self.pw, self.ph = width // ncols, height // nrows

        def _px(self, x, y, col):
            if 0 <= x < self.W and 0 <= y < self.H:
                self.img[y, x] = col

        def _rect(self, x0, y0, x1, y1, col):
            self.img[max(y0,0):max(y1,0), max(x0,0):max(x1,0)] = col

        def _line(self, x0, y0, x1, y1, col, t=1):
            n = int(max(abs(x1-x0), abs(y1-y0))) + 1
            for s in np.linspace(0, 1, max(n, 2)):
                x, y = int(round(x0 + s*(x1-x0))), int(round(y0 + s*(y1-y0)))
                for dx in range(-t, t+1):
