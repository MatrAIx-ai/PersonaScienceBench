#!/usr/bin/env python3
"""
Deterministic transition-kernel forensic analysis: anonymous HMC kernels on a
Neal-funnel-style target with a nonlinear sampler chart.

Pipeline: (1) build target/gradient/kinetic from the manifest with the public
sampler-chart convention; (2) infer the anonymous reversible volume-preserving
transition family from the candidate evidence by robust (median-based) fitting
of a palindromic splitting-integrator library; (3) audit all public candidates,
assign the six canonical failure-mode labels, select the valid kernel;
(4) replay the production and held-out streams EXACTLY with the supplied
momenta/uniforms (no re-drawing) and emit audits, samples, diagnostics, profile
and overview figure.

Documented conventions/assumptions:
* delta_h = H(proposal_state, proposal_momentum) - H(current_state, current_momentum);
  accept iff log(u) < -delta_h; accept_prob = min(1, exp(-delta_h)).
* Audit windows are the FIRST audit_transitions (80) production and the FIRST
  holdout_audit_transitions (100) held-out transitions of the supplied streams
  (prefix convention; the inputs do not specify the window location).
* energy_diagnostics.csv and the delta_h/acceptance entries of diagnostics.json
  use the FULL production stream (all 1020 transitions per chain).
* latent_samples.npy rows = accepted sampler states after each of the 900 kept
  transitions (transitions 121..1020).
* panel_ess_v / ess_v: per-chain initial-positive-sequence (Geyer) ESS summed
  over chains; split-Rhat uses chains split in half.
* latent_mean_abs_max = max_d |mean(z_d)|, latent_var_abs_max =
  max_d |var(z_d)-1| from the standard funnel residuals z (not from q).
* expected_radius2 = (dimension-1) * mean(exp(v)) over kept centered samples
  in each supplied bin.
* Failure-mode labels form a bijection over the six public candidate ids.
"""
import json, csv, os
import numpy as np
try:
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt
    HAVE_MPL = True
except Exception:            # matplotlib-free fallback rasterizer below
    HAVE_MPL = False

ROOT = os.path.dirname(os.path.abspath(__file__))
DATA = os.path.join(ROOT, "data")
RES = os.path.join(ROOT, "results")
os.makedirs(RES, exist_ok=True)

with open(os.path.join(DATA, "target_manifest.json")) as f:
    MAN = json.load(f)
with open(os.path.join(DATA, "transition_schedule.json")) as f:
    SCH = json.load(f)

DIM = int(MAN["dimension"])
SIGMA_V = float(MAN["sigma_v"])
SC = MAN["sampler_chart"]
M = np.asarray(SC["matrix"], float)
SHIFT = np.asarray(SC["shift"], float)
WARP = float(SC["warp_strength"])
PHASE = np.asarray(SC["warp_phase"], float)
G = np.asarray(MAN["kinetic_metric"]["inverse_mass_matrix"], float)
CANDIDS = list(MAN["public_candidate_ids"])
BUNDLE = np.load(os.path.join(DATA, "candidate_transition_bundle.npz"))
PANEL = np.load(os.path.join(DATA, "candidate_chain_panel.npz"))

def to_centered(q):
    q = np.asarray(q, float)
    u = (q - SHIFT) @ M.T
    c = np.empty_like(u)
    c[..., 0] = u[..., 0]
    c[..., 1:] = u[..., 1:] + WARP * np.sin(u[..., 0:1] + PHASE)
    return c

def to_sampler(c):
    c = np.asarray(c, float)
    u = np.empty_like(c)
    u[..., 0] = c[..., 0]
    u[..., 1:] = c[..., 1:] - WARP * np.sin(c[..., 0:1] + PHASE)
    q = np.linalg.solve(M, u.reshape(-1, DIM).T).T + SHIFT
    return q.reshape(c.shape)

def pot_centered(c):
    v = c[..., 0]
    x = c[..., 1:]
    s2 = np.sum(x * x, axis=-1)
    with np.errstate(over="ignore"):
        return (0.5 * (v / SIGMA_V) ** 2 + 0.5 * (DIM - 1) * v
                + 0.5 * np.exp(np.minimum(-v, 700.0)) * s2)

def grad_centered(c):
    v = c[..., 0:1]
    x = c[..., 1:]
    s2 = np.sum(x * x, axis=-1, keepdims=True)
    g = np.empty_like(c)
    with np.errstate(over="ignore"):
        e = np.exp(np.minimum(-v, 700.0))
    g[..., 0:1] = v / SIGMA_V ** 2 + 0.5 * (DIM - 1) - 0.5 * e * s2
    g[..., 1:] = e * x
    return g

def potential(q):
    return pot_centered(to_centered(q))

def grad_potential(q):
    c = to_centered(q)
    u = (q - SHIFT) @ M.T
    gc = grad_centered(c)
    gu = np.empty_like(q)
    gu[..., 0:1] = gc[..., 0:1] + WARP * np.sum(
        gc[..., 1:] * np.cos(u[..., 0:1] + PHASE), axis=-1, keepdims=True)
    gu[..., 1:] = gc[..., 1:]
    return gu @ M

def kinetic(p):
    return 0.5 * np.einsum("...i,ij,...j->...", p, G, p)

def hamiltonian(q, p):
    return potential(q) + kinetic(p)

# ---- transition-family library (anonymous reversible, volume-preserving) ----
def dkd_step(q, p, eps, L, beta=0.5):
    """Palindromic drift-kick-drift (position-Verlet) family; end drifts have
    coefficient beta, middle drifts share the remainder (total drift = L*eps).
    Reversible and volume-preserving for every beta; beta=0.5 is canonical."""
    bm = (L - 2.0 * beta) / (L - 1.0)
    q = q + beta * eps * (p @ G)
    for _ in range(L - 1):
        p = p - eps * grad_potential(q)
        q = q + bm * eps * (p @ G)
    p = p - eps * grad_potential(q)
    q = q + beta * eps * (p @ G)
    return q, p

def kdk_step(q, p, eps, L, beta=0.5):
    """Palindromic kick-drift-kick (velocity-Verlet/leapfrog) family."""
    am = (L - 2.0 * beta) / (L - 1.0)
    p = p - beta * eps * grad_potential(q)
    for _ in range(L - 1):
        q = q + eps * (p @ G)
        p = p - am * eps * grad_potential(q)
    q = q + eps * (p @ G)
    p = p - beta * eps * grad_potential(q)
    return q, p

FAMILIES = {"dkd": dkd_step, "kdk": kdk_step}

def fit_family(obs_q, obs_p, qs, ps, ladder, L, family, betas):
    best = None
    for beta in betas:
        loss, res = 0.0, []
        for li, eps in enumerate(ladder):
            q1, p1 = FAMILIES[family](qs.copy(), ps.copy(), eps, L, beta)
            rq = float(np.median(np.linalg.norm(q1 - obs_q[li], axis=1)))
            rp = float(np.median(np.linalg.norm(p1 - obs_p[li], axis=1)))
            res.append((rq, rp))
            loss += rq + rp
        if best is None or loss < best[1]:
            best = (float(beta), loss, res)
    return best

# ---- candidate audit metrics ----------------------------------------------
ladder = BUNDLE["step_size_ladder"]
probe_q, probe_p = BUNDLE["probe_states"], BUNDLE["probe_momenta"]
prop_q, prop_p = BUNDLE["proposal_states"], BUNDLE["proposal_momenta"]
rev_q, rev_p = BUNDLE["reverse_states"], BUNDLE["reverse_momenta"]
base = int(np.argmin(np.abs(ladder - SCH["step_size"])))
L_SCHED = int(SCH["integration_steps"])

betas = np.round(np.arange(0.30, 0.7001, 0.005), 4)
fits = {}
for fam in FAMILIES:
    fits[fam] = [fit_family(prop_q[ci], prop_p[ci], probe_q, probe_p,
                            ladder, L_SCHED, fam, betas)
                 for ci in range(len(CANDIDS))]
fit_table = {fam: [{"candidate": CANDIDS[i], "beta": fits[fam][i][0],
                    "loss": fits[fam][i][1]} for i in range(len(CANDIDS))]
             for fam in fits}
best_family = min(fits, key=lambda f: min(x[1] for x in fits[f]))
valid_fit_beta = min(fits[best_family], key=lambda x: x[1])[0]

def linear_clip(err, lo_err, hi_score):
    """linear(error, full, zero): 1 if err<=lo, 0 if err>=hi, linear between."""
    if err <= lo_err:
        return 1.0
    if err >= hi_score:
        return 0.0
    return 1.0 - (err - lo_err) / (hi_score - lo_err)

def ess_ips(x):
    x = np.asarray(x, float); n = len(x)
    x = x - x.mean()
    ac = np.correlate(x, x, "full")[n - 1:] / np.arange(n, 0, -1)
    if ac[0] <= 0:
        return float(n)
    rho = ac / ac[0]
    tau, k = -1.0, 0
    while k + 1 < n:
        pair = rho[k] + rho[k + 1]
        if pair <= 0:
            break
        tau += 2.0 * pair
        k += 2
    return float(min(n / max(tau, 1.0 / n), n))

def split_rhat(x):
    x = np.asarray(x, float); m, n = x.shape
    half = n // 2
    xs = np.concatenate([x[:, :half], x[:, half:2 * half]], axis=0)
    m2, N = xs.shape
    means = xs.mean(axis=1)
    W = xs.var(axis=1, ddof=1).mean()
    B = N * means.var(ddof=1)
    return float(np.sqrt(((N - 1) / N * W + B / N) / W))

def ess_total(x):
    return float(sum(ess_ips(x[c]) for c in range(x.shape[0])))

rows = []
for ci, cid in enumerate(CANDIDS):
    h0 = hamiltonian(probe_q, probe_p)
    rms_l = []
    for li in range(len(ladder)):
        h1 = hamiltonian(prop_q[ci, li], prop_p[ci, li])
        rms_l.append(np.sqrt(np.mean((h1 - h0) ** 2)))
    energy_rmse = float(rms_l[base])
    energy_slope = float(np.polyfit(np.log(ladder), np.log(rms_l), 1)[0])
    d = (np.linalg.norm(rev_q[ci, base] - probe_q, axis=1)
         + np.linalg.norm(rev_p[ci, base] + probe_p, axis=1))
    reverse_p95 = float(np.percentile(d, 95))
    vin, vout = BUNDLE["volume_input"], BUNDLE["volume_output"][ci]
    X = np.concatenate([vin, np.ones((vin.shape[0], 1))], axis=1)
    A, _, _, _ = np.linalg.lstsq(X, vout, rcond=None)
    Lin = A[:vin.shape[1]].T
    volume_logdet_abs = float(abs(np.linalg.slogdet(Lin)[1]))
    acc = PANEL["panel_accepted"][ci]
    acceptance_rate = float(acc.mean())
    pv = PANEL["panel_centered_samples"][ci, :, :, 0]
    panel_mean_v = float(pv.mean())
    panel_var_v = float(pv.var(ddof=1))
    panel_rhat_v = split_rhat(pv)
    panel_ess_v = ess_total(pv)
    validity = (0.24 * linear_clip(energy_rmse, 0.01, 0.18)
                + 0.24 * linear_clip(reverse_p95, 1e-8, 5e-3)
                + 0.20 * linear_clip(volume_logdet_abs, 1e-5, 0.08)
                + 0.16 * linear_clip(
                    abs(panel_var_v - SIGMA_V ** 2) / SIGMA_V ** 2, 0.08, 0.55)
                + 0.16 * linear_clip(abs(0.82 - acceptance_rate), 0.25, 0.80))
    rows.append(dict(candidate_id=cid, energy_rmse=energy_rmse,
                     energy_slope=energy_slope, reverse_p95=reverse_p95,
                     volume_logdet_abs=volume_logdet_abs,
                     acceptance_rate=acceptance_rate,
                     panel_mean_v=panel_mean_v, panel_var_v=panel_var_v,
                     panel_ess_v=panel_ess_v, panel_rhat_v=panel_rhat_v,
                     validity_score=float(validity)))

# ---- failure-mode classification (evidence-based rule cascade) -------------
valid_idx = int(np.argmax([r["validity_score"] for r in rows]))
fam_res_state = [fits[best_family][ci][2][base][0]
                 for ci in range(len(CANDIDS))]   # median |dq| at base step
fam_res = [fits[best_family][ci][2][base][0] + fits[best_family][ci][2][base][1]
           for ci in range(len(CANDIDS))]
q_rep, p_rep = FAMILIES[best_family](probe_q.copy(), probe_p.copy(),
                                     ladder[base], L_SCHED,
                                     fits[best_family][valid_idx][0])
lag_alpha, mom_match = [], []
for ci in range(len(CANDIDS)):
    d = prop_q[ci, base] - q_rep
    dr = ladder[base] * (p_rep @ G)
    lag_alpha.append(float(np.median(np.sum(d * dr, axis=1)
                                     / (np.sum(dr * dr, axis=1) + 1e-300))))
    mom_match.append(float(np.max(np.abs(prop_p[ci, base]
                                         - prop_p[valid_idx, base]))))

labels, used = {}, set()
labels[CANDIDS[valid_idx]] = "valid_transition"
used.add(CANDIDS[valid_idx])
for ci, cid in enumerate(CANDIDS):
    if cid in used:
        continue
    r = rows[ci]
    if (r["volume_logdet_abs"] > 1.0 and fam_res_state[ci] < 0.05
            and r["energy_rmse"] < 10.0):
        labels[cid] = "volume_loss"; used.add(cid)
for ci, cid in enumerate(CANDIDS):
    if cid in used:
        continue
    r = rows[ci]
    if (r["volume_logdet_abs"] < 0.01 and r["reverse_p95"] < 1e-2
            and r["energy_rmse"] > 10.0):
        labels[cid] = "energy_drift"; used.add(cid)
for ci, cid in enumerate(CANDIDS):
    if cid in used:
        continue
    if (mom_match[ci] < 1e-3 and 0.05 < abs(lag_alpha[ci]) < 0.5):
        labels[cid] = "delayed_response"; used.add(cid)
for ci, cid in enumerate(CANDIDS):
    if cid in used:
        continue
    if fam_res_state[ci] > 1.0:
        labels[cid] = "coordinate_mismatch"; used.add(cid)
for ci, cid in enumerate(CANDIDS):
    if cid not in used:
        labels[cid] = "terminal_imbalance"; used.add(cid)
assert len(set(labels.values())) == len(CANDIDS)

# ---- exact replay of production and held-out streams ------------------------
REPLAY_FAMILY, REPLAY_BETA = best_family, fits[best_family][valid_idx][0]

def replay_stream(q0, momenta, uniforms, eps, L):
    n_chains, n_trans, _ = momenta.shape
    q = q0.copy()
    accepted_hist = np.empty((n_chains, n_trans, DIM))
    prop_hist = np.empty((n_chains, n_trans, DIM))
    dh = np.empty((n_chains, n_trans))
    ap = np.empty((n_chains, n_trans))
    ac = np.empty((n_chains, n_trans), dtype=bool)
    for t in range(n_trans):
        p = momenta[:, t]
        qp, pp = FAMILIES[REPLAY_FAMILY](q.copy(), p.copy(), eps, L, REPLAY_BETA)
        d = hamiltonian(qp, pp) - hamiltonian(q, p)
        a = np.minimum(1.0, np.exp(-np.minimum(d, 700.0)))
        acc = np.log(uniforms[:, t]) < -d
        prop_hist[:, t] = qp
        dh[:, t] = d
        ap[:, t] = a
        ac[:, t] = acc
        q = np.where(acc[:, None], qp, q)
        accepted_hist[:, t] = q
    return accepted_hist, prop_hist, dh, ap, ac

q0 = np.load(os.path.join(DATA, "initial_latent_states.npy"))
mom = np.load(os.path.join(DATA, "transition_momenta.npy"))
uni = np.load(os.path.join(DATA, "transition_uniforms.npy"))
acc_hist, prop_hist, dh, ap, ac = replay_stream(
    q0, mom, uni, float(SCH["step_size"]), L_SCHED)

n_keep, warm, n_audit = (int(SCH["kept_transitions"]),
                         int(SCH["warmup_transitions"]),
                         int(SCH["audit_transitions"]))
latent_samples = acc_hist[:, warm:warm + n_keep, :]
np.save(os.path.join(RES, "latent_samples.npy"), latent_samples)
samples = to_centered(latent_samples)
np.save(os.path.join(RES, "samples.npy"), samples)
np.savez(os.path.join(RES, "transition_audit.npz"),
         accepted_latent=acc_hist[:, :n_audit, :],
         proposal_latent=prop_hist[:, :n_audit, :],
         delta_h=dh[:, :n_audit], accept_prob=ap[:, :n_audit],
         accepted=ac[:, :n_audit])

hq0 = np.load(os.path.join(DATA, "holdout_initial_latent_states.npy"))
hmom = np.load(os.path.join(DATA, "holdout_transition_momenta.npy"))
huni = np.load(os.path.join(DATA, "holdout_transition_uniforms.npy"))
h_acc, h_prop, h_dh, h_ap, h_ac = replay_stream(
    hq0, hmom, huni, float(SCH["holdout_step_size"]),
    int(SCH["holdout_integration_steps"]))
h_audit = int(SCH["holdout_audit_transitions"])
np.savez(os.path.join(RES, "holdout_transition_audit.npz"),
         accepted_latent=h_acc[:, :h_audit, :],
         proposal_latent=h_prop[:, :h_audit, :],
         delta_h=h_dh[:, :h_audit], accept_prob=h_ap[:, :h_audit],
         accepted=h_ac[:, :h_audit])
np.save(os.path.join(RES, "holdout_terminal_states.npy"), h_acc[:, -1, :])

# ---- energy diagnostics (full production stream) ----------------------------
with open(os.path.join(RES, "energy_diagnostics.csv"), "w", newline="") as f:
    w = csv.writer(f)
    w.writerow(["chain_id", "acceptance_rate", "mean_abs_delta_h",
                "p95_abs_delta_h", "max_abs_delta_h"])
    for c in range(acc_hist.shape[0]):
        w.writerow([f"chain_{c}", float(ac[c].mean()),
                    float(np.abs(dh[c]).mean()),
                    float(np.percentile(np.abs(dh[c]), 95)),
                    float(np.abs(dh[c]).max())])

v_kept = samples[..., 0]
x_kept = samples[..., 1:]
z = np.concatenate([v_kept[..., None] / SIGMA_V,
                    np.exp(-0.5 * v_kept[..., None]) * x_kept], axis=-1)
flat_v = v_kept.reshape(-1)
radius2 = np.sum(x_kept ** 2, axis=-1).reshape(-1)

bins = []
with open(os.path.join(DATA, "profile_bins.csv")) as f:
    for row in csv.DictReader(f):
        bins.append((int(row["bin_id"]), float(row["v_left"]),
                     float(row["v_right"])))
total = flat_v.size
with open(os.path.join(RES, "funnel_profile.csv"), "w", newline="") as f:
    w = csv.writer(f)
    w.writerow(["bin_id", "v_left", "v_right", "count", "fraction",
                "mean_v", "mean_radius2", "expected_radius2"])
    for i, (bid, lo, hi) in enumerate(bins):
        m = (flat_v >= lo) & (flat_v < hi) if i < len(bins) - 1 else \
            (flat_v >= lo) & (flat_v <= hi)
        cnt = int(m.sum())
        if cnt:
            mv = float(flat_v[m].mean())
            mr2 = float(radius2[m].mean())
            er2 = float((DIM - 1) * np.mean(np.exp(flat_v[m])))
        else:
            mv = mr2 = er2 = ""
        w.writerow([bid, lo, hi, cnt, cnt / total, mv, mr2, er2])

diag = {
    "mean_v": float(flat_v.mean()),
    "var_v": float(flat_v.var(ddof=1)),
    "mean_radius2": float(radius2.mean()),
    "split_rhat_v": split_rhat(v_kept),
    "ess_v": ess_total(v_kept),
    "split_rhat_radius2": split_rhat(radius2.reshape(v_kept.shape)),
    "ess_radius2": ess_total(radius2.reshape(v_kept.shape)),
    "overall_acceptance_rate": float(ac.mean()),
    "chain_acceptance_rates": [float(ac[c].mean()) for c in range(ac.shape[0])],
    "mean_abs_delta_h": float(np.abs(dh).mean()),
    "p95_abs_delta_h": float(np.percentile(np.abs(dh), 95)),
    "max_abs_delta_h": float(np.abs(dh).max()),
    "latent_mean_abs_max": float(np.max(np.abs(z.reshape(-1, DIM).mean(0)))),
    "latent_var_abs_max": float(np.max(np.abs(
        z.reshape(-1, DIM).var(0, ddof=1) - 1.0))),
    "left_tail_prob_v_lt_minus5": float((flat_v < -5.0).mean()),
    "right_tail_prob_v_gt_5": float((flat_v > 5.0).mean()),
}
with open(os.path.join(RES, "diagnostics.json"), "w") as f:
    json.dump(diag, f, indent=2)

cols = MAN["audit_columns"]
with open(os.path.join(RES, "kernel_audit.csv"), "w", newline="") as f:
    w = csv.writer(f)
    w.writerow(cols)
    for r in rows:
        w.writerow([r["candidate_id"]] + [repr(r[c]) for c in cols[1:]])
with open(os.path.join(RES, "failure_modes.json"), "w") as f:
    json.dump(labels, f, indent=2)

sel = rows[valid_idx]
selected = {
    "selected_candidate": CANDIDS[valid_idx],
    "validity_score": sel["validity_score"],
    "replay_family": {
        "name": "palindromic_drift_kick_drift_position_verlet",
        "inferred_from": "candidate_transition_bundle proposal/reverse arrays",
        "end_drift_coefficient_beta": float(REPLAY_BETA),
        "integration_steps_production": L_SCHED,
        "step_size_production": float(SCH["step_size"]),
        "note": ("anonymous reversible, volume-preserving transition; the "
                 "fitted end-drift coefficient reproduces canonical "
                 "position-Verlet (DKD); robust median residuals against the "
                 "candidate evidence sit at the deterministic-perturbation "
                 "scale (see family_fit)")},
    "family_fit": fit_table,
    "evidence": {
        "energy_rmse": sel["energy_rmse"],
        "energy_slope": sel["energy_slope"],
        "reverse_p95": sel["reverse_p95"],
        "volume_logdet_abs": sel["volume_logdet_abs"],
        "acceptance_rate_panel": sel["acceptance_rate"],
        "failure_mode": labels[CANDIDS[valid_idx]],
        "failure_mode_assignment": labels,
    },
}
with open(os.path.join(RES, "selected_kernel.json"), "w") as f:
    json.dump(selected, f, indent=2)


if HAVE_MPL:
    fig, axes = plt.subplots(2, 3, figsize=(15, 8))
    ax = axes[0, 0]
    for c in range(v_kept.shape[0]):
        ax.plot(v_kept[c], lw=0.4, label=f"chain {c}")
    ax.set_title("kept v traces"); ax.set_xlabel("kept transition")
    ax.legend(fontsize=7)
    ax = axes[0, 1]
    for c in range(samples.shape[0]):
        rr = np.sum(samples[c, :, 1:] ** 2, axis=1)
        ax.scatter(v_kept[c][::5], rr[::5], s=3, alpha=0.25)
    vv = np.linspace(min(flat_v.min(), -6.0), min(-0.5, flat_v.max()), 300)
    ax.plot(vv, (DIM - 1) * np.exp(vv), "k-", lw=1.2, label="11*exp(v)")
    ax.set_yscale("log"); ax.set_xlabel("v"); ax.set_ylabel("radius2")
    ax.set_title("funnel geometry (kept centered samples)"); ax.legend(fontsize=7)
    ax = axes[0, 2]
    for c in range(dh.shape[0]):
        ax.semilogy(np.abs(dh[c]), lw=0.4)
    ax.axvspan(0, n_audit, alpha=0.15, color="orange", label="audit window")
    ax.set_title("|delta_h| per production transition")
    ax.set_xlabel("transition"); ax.legend(fontsize=7)
    ax = axes[1, 0]
