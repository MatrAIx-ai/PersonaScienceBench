            for yy in (y0+1, y0+self.ph-2):
                self._line(x0+1, yy, x0+self.pw-2, yy, (60,60,60))
            return (x0+55, y0+self.ph-45, x0+self.pw-15, y0+55)

        def axes_data(self, box, xlim, ylim, logy=False, logx=False):
            x0, y0, x1, y1 = box
            def tf_x(v):
                if logx:
                    v = np.log10(np.maximum(v, 1e-12))
                    lo, hi = np.log10(max(xlim[0],1e-12)), np.log10(xlim[1])
                else:
                    lo, hi = xlim
                return x0 + (v-lo)/(hi-lo)*(x1-x0)
            def tf_y(v):
                if logy:
                    v = np.log10(np.maximum(v, 1e-12))
                    lo, hi = np.log10(max(ylim[0],1e-12)), np.log10(ylim[1])
                else:
                    lo, hi = ylim
                return y1 - (v-lo)/(hi-lo)*(y1-y0)
            for i in range(5):
                fx = xlim[0] + (xlim[1]-xlim[0])*i/4
                gx = int(tf_x(fx))
