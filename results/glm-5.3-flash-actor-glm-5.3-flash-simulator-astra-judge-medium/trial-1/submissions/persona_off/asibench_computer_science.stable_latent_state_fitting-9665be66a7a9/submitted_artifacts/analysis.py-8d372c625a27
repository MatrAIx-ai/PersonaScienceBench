              "objective": obj, "relative_change": rel}) \
    .to_csv(OUT + "fit_trace.csv", index=False)

# 6. local_weights.npy (rows in global_index order, one column per fitted row)
assert G.shape == (N, Kc) and np.isfinite(G).all()
assert np.abs(G.sum(1) - 1).max() < 1e-8
np.save(OUT + "local_weights.npy", G)

# 7. neighbor_summary.csv
#    Interpretation: outgoing transition profile of each fitted row.
#    weight = A[row, column]; joint_fraction = expected share of adjacent
#    state pairs equal to (row, column) among all adjacent pairs;
#    conditional_value = max_s B[column, s] (modal emission prob of successor).
_, _, xis = forward_backward(A, B, pi)
xi_sum = np.zeros((Kc, Kc))
for al, lb in xis:
    xi_sum += np.einsum("ti,ij,tj->ij", al, A, lb)
joint = xi_sum / xi_sum.sum()
nb = [(i, j, A[i, j], joint[i, j], B[j].max())
      for i in range(Kc) for j in range(Kc) if A[i, j] > 1e-8]
pd.DataFrame(nb, columns=["row", "column", "weight", "joint_fraction", "conditional_value"]) \
    .to_csv(OUT + "neighbor_summary.csv", index=False)

# 8. local_assignments.csv
labels = G.argmax(1)
pd.DataFrame({"sequence_id": seq_ids, "position": positions,
              "global_index": gidx, "label": labels}).to_csv(
    OUT + "local_assignments.csv", index=False)

# 9. stream_diagnostics.csv
ent_pos = -(G * np.log(G + 1e-300)).sum(1)
sd = []
for si, name in enumerate(stream_names):
    s, e = starts[si], ends[si]
    labs = labels[s:e]
    dom = np.bincount(labs, minlength=Kc).max() / (e - s)
    lik_all = B[:, sym[s:e]].T          # per-position filtered log-likelihood
    sd.append(dict(sequence_id=name, n_positions=int(e - s),
                   mean_objective=float(np.log(np.clip((lik_all * G[s:e]).sum(1), 1e-300, None)).mean()),
                   weight_entropy_mean=float(ent_pos[s:e].mean()),
                   dominant_label_fraction=float(dom)))
pd.DataFrame(sd).to_csv(OUT + "stream_diagnostics.csv", index=False)

