def _crc(b): return zlib.crc32(b) & 0xFFFFFFFF

def png_write(path, img):
    h, w, _ = img.shape
    raw = b"".join(b"\x00" + img[i].tobytes() for i in range(h))
    def chunk(tag, data):
        c = struct.pack(">I", len(data)) + tag + data
        return c + struct.pack(">I", _crc(tag + data))
    png = (b"\x89PNG\r\n\x1a\n"
           + chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0))
           + chunk(b"IDAT", zlib.compress(raw, 6))
           + chunk(b"IEND", b""))
    open(path, "wb").write(png)

def draw_text(img, x, y, s, scale=2, color=(0, 0, 0)):
    for ch in s.upper():
        g = FONT.get(ch, FONT[" "])
        for r, row in enumerate(g.split()):
            for cc, bit in enumerate(row):
                if bit == "1":
                    ys = y + r * scale; xs = x + cc * scale
                    img[ys:ys + scale, xs:xs + scale] = color
        x += 6 * scale

def draw_line(img, x0, y0, x1, y1, color):
    dx, dy = abs(x1 - x0), abs(y1 - y0)
    sx = 1 if x0 < x1 else -1; sy = 1 if y0 < y1 else -1
    err = dx - dy
    while True:
        if 0 <= y0 < img.shape[0] and 0 <= x0 < img.shape[1]:
            img[y0, x0] = color
        if x0 == x1 and y0 == y1: break
        e2 = 2 * err
        if e2 > -dy: err -= dy; x0 += sx
        if e2 < dx: err += dx; y0 += sy

def draw_rect(img, x0, y0, x1, y1, color, fill=None):
    if fill is not None:
        img[y0:y1, x0:x1] = fill
    draw_line(img, x0, y0, x1, y0, color); draw_line(img, x0, y1, x1, y1, color)
    draw_line(img, x0, y0, x0, y1, color); draw_line(img, x1, y0, x1, y1, color)

def cmap_viridis(t):
    anchors = np.array([(68,1,84),(59,82,139),(33,145,140),(94,201,98),(253,231,37)])
    t = np.clip(t, 0, 1)
    i = np.minimum((t * 4).astype(int), 3); f = t * 4 - i
    return (anchors[i] * (1 - f[..., None]) + anchors[i + 1] * f[..., None]).astype(np.uint8)

def cmap_magma(t):
    anchors = np.array([(0,0,4),(87,16,110),(188,55,84),(249,142,9),(252,253,191)])
    t = np.clip(t, 0, 1)
    i = np.minimum((t * 4).astype(int), 3); f = t * 4 - i
    return (anchors[i] * (1 - f[..., None]) + anchors[i + 1] * f[..., None]).astype(np.uint8)

class Panel:
    """Simple axis frame with data-to-pixel mapping (y up)."""
    def __init__(self, img, x0, y0, x1, y1, title="", xlabel="", ylabel=""):
        self.img, self.x0, self.y0, self.x1, self.y1 = img, x0, y0, x1, y1
        draw_rect(img, x0, y0, x1, y1, (0, 0, 0), fill=(255, 255, 255))
        if title: draw_text(img, x0 + 8, y0 - 26, title, 2)
        if xlabel: draw_text(img, (x0 + x1)//2 - 6*len(xlabel), y1 + 22, xlabel, 2)
        if ylabel:
            for i, ch in enumerate(ylabel):
                draw_text(img, x0 - 34, (y0 + y1)//2 - 8*len(ylabel) + i*16, ch, 2)
    def map(self, xr, yr, x, y):
        px = self.x0 + (x - xr[0]) / (xr[1] - xr[0]) * (self.x1 - self.x0)
        py = self.y1 - (y - yr[0]) / (yr[1] - yr[0]) * (self.y1 - self.y0)
        return int(round(px)), int(round(py))
    def xticks(self, xr, vals, fmt="{:.0f}"):
        for v in vals:
            px, _ = self.map(xr, (0, 1), v, 0)
            draw_line(self.img, px, self.y1, px, self.y1 + 5, (0, 0, 0))
            s = fmt.format(v)
            draw_text(self.img, px - 3 * len(s), self.y1 + 9, s, 2)
    def yticks(self, yr, vals, fmt="{:.1f}"):
        for v in vals:
            _, py = self.map((0, 1), yr, 0, v)
            draw_line(self.img, self.x0 - 5, py, self.x0, py, (0, 0, 0))
            s = fmt.format(v)
            draw_text(self.img, self.x0 - 12 - 6 * len(s), py - 7, s, 2)
    def plot(self, xr, yr, xs, ys, color, marker=None):
        pts = [self.map(xr, yr, x, y) for x, y in zip(xs, ys)]
        for (px, py), (qx, qy) in zip(pts[:-1], pts[1:]):
            draw_line(self.img, px, py, qx, qy, color)
        if marker:
            for px, py in pts:
                draw_rect(self.img, px - 3, py - 3, px + 3, py + 3, color, fill=color)
    def vline(self, xr, yr, x, color=(0, 0, 0)):
        px, _ = self.map(xr, yr, x, 0)
        draw_line(self.img, px, self.y0, px, self.y1, color)

# ----------------------------------------------------------------------------
# Candidate fitting with per-K caches (resumable), selection diagnostics
# ----------------------------------------------------------------------------
def fit_and_cache(K):
    best = None
    traces = []
    for r in range(N_RESTARTS):
        LL, A, B, pi, _, trace = em_fit(K, SEED_BASE + 1000 * K + r,
                                        collect_trace=True)
        traces.append(trace)
        if best is None or LL > best[0]:
            best = (LL, A, B, pi)
    LL, A, B, pi = best
    order, st = canonical_order(A, B)
    A, B, pi = A[np.ix_(order, order)], B[order], pi[order]
    _, gammas, _ = forward_backward(A, B, pi)
    G = np.vstack(gammas); G /= G.sum(1, keepdims=True)
    runs = np.concatenate([np.full(len(t), r) for r, t in enumerate(traces)])
    steps = np.concatenate([t[:, 0] for t in [np.array(x) for x in traces]])
    objs = np.concatenate([np.array(x)[:, 1] for x in traces])
    rels = np.concatenate([np.array(x)[:, 2] for x in traces])
    np.savez(OUT + f"_cache_K{K}.npz", A=A, B=B, pi=pi, LL=LL, G=G,
             run=runs, step=steps, obj=objs, rel=rels)
    print(f"K={K:2d}  best LL = {LL:.4f}  (cached, {N_RESTARTS} restarts)", flush=True)

def load_all():
    res = {}
    for K in K_GRID:
        z = np.load(OUT + f"_cache_K{K}.npz")
        res[K] = dict(LL=float(z["LL"]), A=z["A"], B=z["B"], pi=z["pi"],
                      G=z["G"], trace=(z["run"], z["step"], z["obj"], z["rel"]))
    return res

def kl_sym(p, q, eps=1e-12):
    p, q = p + eps, q + eps
    p /= p.sum(); q /= q.sum()
    return 0.5 * (p * np.log(p / q)).sum() + 0.5 * (q * np.log(q / p)).sum()

def selection_diagnostics(res):
    rows = []
    for K, d in res.items():
        A, B, G = d["A"], d["B"], d["G"]
        usage = G.mean(0)
        unc = float((1.0 - G.max(1)).mean())
        ent = float(-(G * np.log(G + 1e-300)).sum(1).mean())
        n_free = K * K + (ALPHABET_SIZE - 1) * K - 1
        bic = -2 * d["LL"] + n_free * LOGN
        aic = -2 * d["LL"] + 2 * n_free
        pairs = [(i, j) for i in range(K) for j in range(i + 1, K)]
        ekl = min(kl_sym(B[i], B[j]) for i, j in pairs) if pairs else np.nan
        tl1 = min(np.abs(A[i] - A[j]).sum() for i, j in pairs) if pairs else np.nan
        dup = any((kl_sym(B[i], B[j]) < 0.05 and np.abs(A[i] - A[j]).sum() < 0.1)
                  for i, j in pairs)
        rows.append(dict(candidate=K, n_free_values=n_free, objective=d["LL"],
                         criterion=bic, aic=aic, min_row_usage=usage.min(),
                         mean_assignment_uncertainty=unc, mean_weight_entropy=ent,
                         min_emission_kl=ekl, min_transition_l1=tl1,
                         near_duplicate_rows=dup))
    ev = pd.DataFrame(rows).sort_values("candidate").reset_index(drop=True)
    ev["delta_LL_vs_prev_K"] = ev["objective"].diff()
    ev["delta_LL_per_added_row"] = ev["delta_LL_vs_prev_K"] / ev["candidate"].diff()
    ev["delta_BIC_vs_prev_K"] = ev["criterion"].diff()
    return ev

# ----------------------------------------------------------------------------
# Dispatch: resumable chunked execution
# ----------------------------------------------------------------------------
mode = sys.argv[1] if len(sys.argv) > 1 else "all"

if mode == "fit":
    fit_and_cache(int(sys.argv[2]))
    sys.exit(0)

res = load_all()

if mode == "verify":
    chosen_K = int(json.load(open(OUT + "_chosen.json"))["chosen_K"])
    LL2, A2, B2, pi2, _, _ = em_fit(chosen_K, SEED_BASE + 1000 * chosen_K + 0)
    for r in range(1, N_RESTARTS):
        L2, a2, b2, p2, _, _ = em_fit(chosen_K, SEED_BASE + 1000 * chosen_K + r)
        if L2 > LL2:
            LL2, A2, B2, pi2 = L2, a2, b2, p2
    order2, _ = canonical_order(A2, B2)
    A2, B2, pi2 = A2[np.ix_(order2, order2)], B2[order2], pi2[order2]
    A1, B1, pi1 = res[chosen_K]["A"], res[chosen_K]["B"], res[chosen_K]["pi"]
    gap = max(np.abs(A1 - A2).max(), np.abs(B1 - B2).max(), np.abs(pi1 - pi2).max())
    ll_gap = abs(res[chosen_K]["LL"] - LL2)
    print(f"VERIFY: max |param difference| = {gap:.3e}, |LL difference| = {ll_gap:.3e}")
    assert gap < 1e-10 and ll_gap < 1e-6, "chosen model did not reproduce identically"
    print("VERIFY PASSED: identical parameters and objective from fixed seeds")
    sys.exit(0)

