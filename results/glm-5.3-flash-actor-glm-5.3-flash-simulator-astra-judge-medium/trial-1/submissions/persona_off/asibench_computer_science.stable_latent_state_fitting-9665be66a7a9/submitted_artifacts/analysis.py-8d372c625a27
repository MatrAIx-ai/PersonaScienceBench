"""
Stable latent-state fitting for long categorical streams.

Self-implemented Baum-Welch EM for a first-order latent-state Markov model
(HMM) with K latent rows, shared across the six streams.  Only numpy, pandas
and scipy are used (plus stdlib zlib/struct for rasterizing the diagnostics
PNG, since matplotlib is unavailable in this runtime).  No black-box
sequence-model or probabilistic-programming package is imported.

Outputs (all under results/):
  candidate_summary.csv, matrix_a.csv, matrix_b.csv, vector_a.csv,
  fit_trace.csv, local_weights.npy, neighbor_summary.csv,
  local_assignments.csv, stream_diagnostics.csv, diagnostics.png
plus one supporting table, selection_evidence.csv (multi-evidence model
comparison), and per-candidate fit caches (_cache_K*.npz, _chosen.json)
used to make long runs resumable; these are supplementary only.

Usage:
  python3 analysis.py            # fit any missing candidates, then finalize
  python3 analysis.py fit K      # fit candidate K only (resumable chunks)
  python3 analysis.py finalize   # selection + outputs from caches
  python3 analysis.py verify     # refit chosen K from seeds, check identity
"""
import json
import sys
import zlib
import struct
import numpy as np
import pandas as pd

DATA_CSV = "data/sequences.csv"
META_JSON = "data/metadata.json"
OUT = "results/"
ALPHABET_SIZE = 32
K_GRID = [2, 3, 4, 5, 6, 7, 8, 10, 12]
N_RESTARTS = 12          # >= 10 seeded restarts per candidate
MAX_ITERS = 300
TOL = 1e-7
SEED_BASE = 20260101
PSEUDO_A = 1.0           # MAP Dirichlet pseudo-counts: regularization ONLY
PSEUDO_B = 1.0           # (excluded from all reported likelihoods)

# ----------------------------------------------------------------------------
# Data loading
# ----------------------------------------------------------------------------
meta = json.load(open(META_JSON))
df = pd.read_csv(DATA_CSV).sort_values("global_index").reset_index(drop=True)
assert (df.global_index.values == np.arange(len(df))).all()
sym = df.symbol.values.astype(int)
seq_ids = df.sequence_id.values
positions = df.position.values
gidx = df.global_index.values
bounds = (df.groupby("sequence_id", sort=True).global_index.agg(["min", "max"])
          .sort_values("min"))
starts, ends = bounds["min"].values, bounds["max"].values + 1
stream_names = list(bounds.index)
N = len(sym)
LOGN = float(np.log(N))
ONEHOT = np.eye(ALPHABET_SIZE)[sym]

# ----------------------------------------------------------------------------
# Baum-Welch EM (scaled forward-backward), MAP-regularized updates
# ----------------------------------------------------------------------------
def forward_backward(A, B, pi):
    """Scaled forward-backward over all streams. Returns LL, gammas, xi parts."""
    K_ = A.shape[0]
    LL = 0.0
    gammas, xis = [], []
    for s, e in zip(starts, ends):
        T = e - s
        lik = B[:, sym[s:e]].T                      # (T, K) emission likelihoods
        alpha = np.empty((T, K_))
        c = np.empty(T)
        a = pi * lik[0]; c[0] = a.sum(); alpha[0] = a / c[0]
        LL += np.log(c[0])
        for t in range(1, T):
            a = (alpha[t - 1] @ A) * lik[t]
            c[t] = a.sum(); alpha[t] = a / c[t]
            LL += np.log(c[t])
        beta = np.empty((T, K_))
        beta[-1] = 1.0
        for t in range(T - 2, -1, -1):
            beta[t] = (A @ (lik[t + 1] * beta[t + 1])) / c[t + 1]
        gamma = alpha * beta
        gamma /= gamma.sum(1, keepdims=True)        # guard fp drift
        gammas.append(gamma)
        xis.append((alpha[:-1], lik[1:] * beta[1:]))
    return LL, gammas, xis

def em_fit(K, seed, collect_trace=False):
    rng = np.random.default_rng(seed)
    A = rng.dirichlet(np.ones(K), size=K)
    B = rng.dirichlet(np.ones(ALPHABET_SIZE), size=K)
    pi = rng.dirichlet(np.ones(K))
    prev = None
    trace = []
    for it in range(MAX_ITERS + 1):
        LL, gammas, xis = forward_backward(A, B, pi)
        rel = np.nan if prev is None else (LL - prev) / abs(prev)
        trace.append((it, LL, rel))
        if prev is not None and abs(rel) < TOL and it >= 5:
            break
        prev = LL
        if it == MAX_ITERS:
            break
        A_num = np.full((K, K), PSEUDO_A)
        B_num = np.full((K, ALPHABET_SIZE), PSEUDO_B)
        pi_num = np.full(K, 1.0)
        for (s, e), g, (al, lb) in zip(zip(starts, ends), gammas, xis):
            pi_num += g[0]
            A_num += np.einsum("ti,ij,tj->ij", al, A, lb)
            B_num += g.T @ ONEHOT[s:e]
        A = A_num / A_num.sum(1, keepdims=True)
        B = B_num / B_num.sum(1, keepdims=True)
        pi = pi_num / pi_num.sum()
    LL, gammas, _ = forward_backward(A, B, pi)
    return LL, A, B, pi, gammas, trace

def stationary(A):
    v = np.ones(A.shape[0]) / A.shape[0]
    for _ in range(2000):
        v = v @ A
        v /= v.sum()
    return v

def canonical_order(A, B):
    """Canonical labels: rows ordered by descending stationary weight."""
    st = stationary(A)
    order = np.argsort(-st, kind="stable")
    return order, st[order]

