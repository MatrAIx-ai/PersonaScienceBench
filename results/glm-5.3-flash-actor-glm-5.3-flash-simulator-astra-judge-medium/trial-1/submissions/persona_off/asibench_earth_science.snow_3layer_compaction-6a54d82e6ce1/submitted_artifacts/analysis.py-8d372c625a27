def load_inputs():
    with open("data/snowpack_init.json") as f:
        init = json.load(f)
    df = pd.read_csv("data/forcing.csv")
    forc = {"t_air": df["t_air_K"].to_numpy(),
            "snow": df["snowfall_mm_hr"].to_numpy(),
            "rain": df["rainfall_mm_hr"].to_numpy(),
            "sw": df["sw_in_wm2"].to_numpy(),
            "lw": df["lw_in_wm2"].to_numpy()}
    return init, forc


def run_and_report(label, forc, init, dt_sub, **over):
    res = simulate(forc, init, dt_sub=dt_sub, **over)
    s = res["summary"]
    e = res["energy"]
    # energy-consistency diagnostic (relative to 273.15 K reference):
    # dH = Q_in + enthalpy of precipitation inputs - enthalpy removed/added
    # by sublimation/deposition; plus the latent heat of skin melt (that
    # energy does not pass through conduction); minus the enthalpy carried
    # away by runoff.  Melt/refreeze inside the pack are internal conversions.
    d_h = e["h_end"] - e["h0"]
    expected = (e["q_in"] + e["h_precip"] + e["h_sub"]
                + e["q_skin_melt"] - e["h_runoff"] - e["h_evap"])
    e_resid = d_h - expected
    print(f"\n[{label}] dt_sub={dt_sub}s over={over}")
    print(f"  final SWE={s[-1,0]:9.3f} mm  depth={s[-1,1]:7.4f} m  "
          f"mean rho={s[-1,5]:7.2f} kg/m3")
    print(f"  totals: melt={res['tot']['melt']:8.2f}  refreeze={res['tot']['refrz']:8.2f}  "
          f"runoff={res['tot']['runoff']:7.2f}  sublim={res['tot']['sub']:6.3f}  "
          f"deposit={res['tot']['dep']:6.3f}  evap={res['tot']['evap']:6.3f} mm")
    print(f"  mass-closure max daily |residual| = {res['max_resid']:.3e} mm")
    print(f"  energy check: dH={d_h:.4e} J/m2, expected={expected:.4e}, "
          f"rel.err={abs(e_resid)/max(abs(expected),1.0):.2e}")
    return res


def main():
    os.makedirs(RESULTS_DIR, exist_ok=True)
    init, forc = load_inputs()

    print("=== INITIAL STATE (data/snowpack_init.json) ===")
    for i, l in enumerate(init["layers"]):
        print(f"  layer {i+1}: D={l['thickness_m']:.6f} m  rho={l['density_kg_m3']:.3f} "
              f"kg/m3  ice={l['ice_mm']:.5f} mm  liq={l['liq_mm']:.3f} mm  "
              f"T={l['temp_K']:.2f} K")
    swe0 = sum(l["ice_mm"] + l["liq_mm"] for l in init["layers"])
    d0 = sum(l["thickness_m"] for l in init["layers"])
    print(f"  total: SWE={swe0:.3f} mm, depth={d0:.5f} m, "
          f"bulk rho={swe0/d0:.2f} kg/m3")

    # ---------------- production run ----------------------------------
    res = run_and_report("PRODUCTION (dt_sub=60 s, turbulent ON)", forc, init,
                         dt_sub=60.0)
    state, summary = res["state"], res["summary"]

    np.save(os.path.join(RESULTS_DIR, "snow_state.npy"), state)
    header = ("day,swe_mm,snow_depth_m,melt_mm,refreeze_mm,runoff_mm,"
              "mean_density_kg_m3")
    rows = [header]
    for d in range(state.shape[0]):
        s = summary[d]
        rows.append(f"{d+1},{s[0]:.6f},{s[1]:.6f},{s[2]:.6f},{s[3]:.6f},"
                    f"{s[4]:.6f},{s[5]:.6f}")
    with open(os.path.join(RESULTS_DIR, "snow_summary.csv"), "w") as f:
        f.write("\n".join(rows) + "\n")

    renderer = build_figure(state, summary,
                            os.path.join(RESULTS_DIR, "snow_evolution.png"))
    print(f"\nfigure written with renderer: {renderer}")

    # ---------------- reports ------------------------------------------
    print("\n=== DAILY EVOLUTION (selected days) ===")
    print(" day   swe_mm  depth_m  rho_mean  melt   refrz  runoff  "
          "Ttop(C) Tmid(C) Tbot(C)")
    for d in list(range(0, state.shape[0], 7)) + [state.shape[0] - 1]:
        s = summary[d]
        tt = state[d, :, 4] - 273.15
        print(f"{d+1:4d}  {s[0]:8.2f}  {s[1]:7.4f}  {s[5]:8.2f}  "
              f"{s[2]:6.2f}  {s[3]:6.2f}  {s[4]:6.2f}  "
              f"{tt[0]:7.2f} {tt[1]:7.2f} {tt[2]:7.2f}")

    tbot = state[:, 2, 4]
    print(f"\nBOTTOM-LAYER TEMPERATURE (K): min={tbot.min():.3f} "
          f"max={tbot.max():.3f} mean={tbot.mean():.3f} "
          f"(ground boundary T={T_GROUND:.2f} K; consistency check "
          f"T_bottom in [T_ground-1K, 273.15K] at all times: "
          f"{bool((tbot >= T_GROUND - 1.0).all() and (tbot <= TF + 1e-6).all())})")

    tot = res["tot"]
    print(f"\nMASS CLOSURE (68-day cumulative, mm w.e.):")
    print(f"  snowfall={tot['snow']:.4f}  rainfall={tot['rain']:.4f}  "
          f"deposition={tot['dep']:.4f}  sublimation={tot['sub']:.4f}  "
          f"runoff={tot['runoff']:.4f}  evaporation={tot['evap']:.4f}")
    print(f"  dSWE = {summary[-1,0] - swe0:.4f} mm vs inputs-outputs = "
          f"{tot['snow']+tot['rain']+tot['dep']-tot['sub']-tot['runoff']-tot['evap']:.4f} mm")
    print(f"  max daily |residual| = {res['max_resid']:.3e} mm (machine precision)")

    # ---------------- sensitivity / verification runs ------------------
    print("\n=== SENSITIVITY / VERIFICATION RUNS ===")
    runs = [
        ("dt=600 s (step check)", dict(dt_sub=600.0)),
        ("turbulent OFF (C_H=C_E=0)", dict(dt_sub=300.0, c_h=0.0, c_e=0.0)),
        ("turbulent x2 (C_H=C_E=4e-3)", dict(dt_sub=300.0, c_h=4.0e-3, c_e=4.0e-3)),
        ("albedo 0.70", dict(dt_sub=300.0, albedo=0.70)),
        ("albedo 0.90", dict(dt_sub=300.0, albedo=0.90)),
        ("K_GROUND 0.1 W/m/K", dict(dt_sub=300.0, k_ground=0.1)),
    ]
    for label, kw in runs:
        run_and_report(label, forc, init, **kw)

    print("\nArtifacts written:")
    for p in ["analysis.py", "results/snow_state.npy", "results/snow_summary.csv",
              "results/snow_evolution.png"]:
        print("  ", p, os.path.getsize(p) if os.path.exists(p) else "MISSING")


if __name__ == "__main__":
    main()
