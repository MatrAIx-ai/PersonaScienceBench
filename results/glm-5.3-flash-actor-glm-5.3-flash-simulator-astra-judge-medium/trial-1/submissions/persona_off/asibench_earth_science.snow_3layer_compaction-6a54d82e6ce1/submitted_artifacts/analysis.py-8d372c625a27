    '/': ["00001", "00010", "00010", "00100", "01000", "01000", "10000"],
    '+': ["00000", "00100", "00100", "11111", "00100", "00100", "00000"],
    'X2': ["00000", "00000", "01010", "00100", "01010", "00000", "00000"],
    ' ': ["00000", "00000", "00000", "00000", "00000", "00000", "00000"],
}


def _png_write(path, w, h, buf):
    raw = b''.join(b'\x00' + bytes(buf[y * w * 3:(y + 1) * w * 3]) for y in range(h))
    def chunk(tag, data):
        c = struct.pack('>I', len(data)) + tag + data
        return c + struct.pack('>I', zlib.crc32(tag + data) & 0xffffffff)
    png = (b'\x89PNG\r\n\x1a\n'
           + chunk(b'IHDR', struct.pack('>IIBBBBB', w, h, 8, 2, 0, 0, 0))
           + chunk(b'IDAT', zlib.compress(raw, 6))
           + chunk(b'IEND', b''))
    with open(path, 'wb') as f:
        f.write(png)


def _draw_text(buf, w, x, y, s, scale=2, col=(0, 0, 0)):
    cx = x
    for ch in s.upper():
        g = FONT.get(ch, FONT[' '])
        for r, row in enumerate(g):
            for c_i in range(5):
                if row[c_i] == '1':
                    for dy in range(scale):
                        for dx in range(scale):
                            px = cx + c_i * scale + dx
                            py = y + r * scale + dy
                            if 0 <= px < w and py < len(buf) // (w * 3):
                                o = (py * w + px) * 3
                                buf[o:o + 3] = bytes(col)
        cx += 6 * scale


def _nice_ticks(lo, hi, n=5):
    if hi <= lo:
        hi = lo + 1.0
    raw = (hi - lo) / max(n, 1)
    mag = 10.0 ** math.floor(math.log10(raw))
    for m in (1, 2, 2.5, 5, 10):
        step = m * mag
        if step >= raw:
            break
    start = math.ceil(lo / step) * step
    ticks = []
    t = start
    while t <= hi + 1e-9:
        ticks.append(t)
        t += step
    return ticks


def _fmt(v):
    return f"{v:.4g}"


def _hex2rgb(hx):
    hx = hx.lstrip("#")
    return tuple(int(hx[i:i + 2], 16) for i in (0, 2, 4)) if isinstance(hx, str) \
        else tuple(hx)


def _render_png_fallback(path, panels, day, w=1440, h=1040):
    buf = bytearray(w * h * 3)
    buf[:] = b'\xff' * len(buf)
    boxes = [(120, 50, 580, 400), (760, 50, 580, 400),
             (120, 570, 580, 400), (760, 570, 580, 400)]
    for (x0, y0, pw, ph), p in zip(boxes, panels):
        _draw_text(buf, w, x0, y0 - 0, p["title"], 2, (0, 0, 0))
        # auto y-limits
        vals = np.concatenate([np.asarray(s[0]) for s in p["series"]])
        lo, hi = float(vals.min()), float(vals.max())
        if p["ylim"]:
            if p["ylim"][0] is not None:
                lo = p["ylim"][0]
            if p["ylim"][1] is not None:
                hi = p["ylim"][1]
        pad = 0.06 * (hi - lo if hi > lo else max(abs(hi), 1.0))
        lo, hi = lo - pad, hi + pad
        xr = (float(day[0]), float(day[-1]))
        # axes frame
        def px(xd):
            return x0 + int((xd - xr[0]) / (xr[1] - xr[0]) * (pw - 10)) + 5
        def py(yd):
            return y0 + ph - int((yd - lo) / (hi - lo) * (ph - 30)) - 20
        for xx in range(px(xr[0]), px(xr[1]) + 1):
            for yy in (py(lo), py(hi)):
                o = (yy * w + xx) * 3
                buf[o:o + 3] = b'\x00\x00\x00'
        for yy in range(py(lo), py(hi) + 1):
            for xx in (px(xr[0]), px(xr[1])):
                o = (yy * w + xx) * 3
                buf[o:o + 3] = b'\x00\x00\x00'
        # ticks and labels
        for tv in _nice_ticks(lo, hi):
            yy = py(tv)
            for xx in range(px(xr[0]) - 4, px(xr[0])):
                o = (yy * w + xx) * 3
                buf[o:o + 3] = b'\x00\x00\x00'
            _draw_text(buf, w, px(xr[0]) - 60, yy - 6, _fmt(tv), 2)
        for tv in _nice_ticks(xr[0], xr[1], 6):
            xx = px(tv)
            for yy in range(py(lo), py(lo) + 5):
                o = (yy * w + xx) * 3
                buf[o:o + 3] = b'\x00\x00\x00'
            _draw_text(buf, w, xx - 14, py(lo) + 8, _fmt(tv), 2)
        _draw_text(buf, w, x0 + pw // 2 - 40, y0 + ph + 8, "DAY", 2)
        # series lines (Bresenham)
        for yarr, col, _lab in [(s[0], _hex2rgb(s[1]), s[2]) for s in p["series"]]:
            prev = None
            for k in range(len(day)):
                pt = (px(float(day[k])), py(float(yarr[k])))
                if prev is not None:
                    x1, y1 = prev
                    x2, y2 = pt
                    dx, dy = abs(x2 - x1), abs(y2 - y1)
                    sx = 1 if x1 < x2 else -1
                    sy = 1 if y1 < y2 else -1
                    err = dx - dy
                    while True:
                        if y0 < y1 < y0 + ph and x0 < x1 < x0 + pw:
                            o = (y1 * w + x1) * 3
                            buf[o:o + 3] = bytes(col)
                        if x1 == x2 and y1 == y2:
                            break
                        e2 = 2 * err
                        if e2 > -dy:
                            err -= dy
                            x1 += sx
                        if e2 < dx:
                            err += dx
                            y1 += sy
                prev = pt
        # legend
        lx = x0 + 10
        for yarr, col, lab in [(s[0], _hex2rgb(s[1]), s[2]) for s in p["series"]]:
            for xx in range(lx, lx + 26):
                o = ((y0 + ph - 34) * w + xx) * 3
                buf[o:o + 3] = bytes(col)
            _draw_text(buf, w, lx + 30, y0 + ph - 40, lab, 2)
            lx += (len(lab) * 6 + 8) * 2 + 40
    _png_write(path, w, h, buf)


