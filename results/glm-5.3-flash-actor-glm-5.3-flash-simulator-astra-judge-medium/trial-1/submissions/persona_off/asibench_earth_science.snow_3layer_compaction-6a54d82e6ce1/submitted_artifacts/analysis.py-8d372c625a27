#!/usr/bin/env python3
"""
Process-based, fixed 3-layer snowpack model driven by hourly atmospheric forcing.

Physics
-------
* Surface energy balance at a zero-heat-capacity snow "skin": absorbed shortwave
  (fixed albedo), net longwave (emissivity 0.98), bulk-aerodynamic sensible and
  latent heat (neutral stability, assumed wind/RH - explicit constants below).
  Skin temperature is solved by bisection each substep; if the balance requires
  a skin temperature above 273.15 K the skin is pinned at the melting point and
  the surplus energy converts surface ice to meltwater.
* Thermal diffusion between layers and with a fixed-temperature ground base
  (Sturm et al. 1997 effective conductivity, harmonic-mean interface values).
* Cold-content-limited melt at 273.15 K; instantaneous refreeze of held liquid
  when a layer is below freezing (released latent heat warms the layer).
  Ice and liquid water are separate state variables in every layer.
* Top-down liquid percolation with irreducible water holding capacity
  (THETA_IRR x pore volume); excess leaves the bottom layer as runoff.
* Degenerate ablated states (a layer with no ice) are handled physically:
  surplus energy of ponded meltwater above 273.15 K evaporates water
  (open-system latent sink, tracked in the mass closure).
* Two-process compaction: overburden-driven settling through a viscosity that
  increases with density and decreases with temperature and liquid content
  (SNTHERM/Anderson-style); snowfall is added to the top layer (3 layers fixed).
* Mass closure: dSWE = snowfall + rainfall + deposition - sublimation - runoff,
  verified numerically each day; residual reported.
* Consistency: density = (ice + liquid)/thickness is derived from conserved
  mass after every update; ice and liquid are never merged.

Outputs: analysis.py (this file), results/snow_state.npy (float64 (n_days,3,5):
[thickness_m, density_kg_m3, ice_mm, liq_mm, temp_K]), results/snow_summary.csv
(day, swe_mm, snow_depth_m, melt_mm, refreeze_mm, runoff_mm,
mean_density_kg_m3), results/snow_evolution.png (matplotlib if available,
otherwise a self-contained pure-stdlib PNG renderer).
"""

import json
import math
import os
import struct
import zlib

import numpy as np
import pandas as pd

# --------------------------------------------------------------------- #
# Physical constants (SI)                                                #
# --------------------------------------------------------------------- #
TF = 273.15                 # K, fusion point
SIGMA = 5.670374419e-8      # Stefan-Boltzmann
EPS_SNOW = 0.98             # snow longwave emissivity
RHO_ICE = 917.0             # kg/m3
RHO_WAT = 1000.0
L_F = 333500.0              # J/kg fusion
L_S = 2.838e6               # J/kg sublimation
L_V = 2.45e6                # J/kg vaporisation (ponded-water sink)
C_ICE = 2100.0              # J/kg/K
C_WAT = 4186.0
C_AIR = 1005.0
R_AIR = 287.05
G = 9.81
P_ATM = 101325.0            # Pa (constant in forcing file)

# --------------------------------------------------------------------- #
# Assumed parameters (NOT supplied by the input data - explicit)         #
# --------------------------------------------------------------------- #
ALBEDO = 0.80               # broadband snow albedo (fixed)
WIND_SPEED = 2.0            # m/s, assumed (no wind in forcing)
C_H = 2.0e-3                # neutral bulk sensible transfer coefficient
C_E = 2.0e-3                # neutral bulk latent transfer coefficient
REL_HUM = 0.75              # assumed relative humidity (no RH in forcing)

T_GROUND = 272.15           # K, fixed basal ground temperature
K_GROUND = 0.4              # W/m/K, ground-snow exchange conductivity

FRESH_SNOW_RHO = 120.0      # kg/m3, density of newly fallen snow
THETA_IRR = 0.04            # irreducible liquid saturation of pore volume

# compaction (SNTHERM/Anderson-style viscosity parameterisation)
ETA0 = 3.0e9                # Pa.s at rho=150 kg/m3, T=273.15 K, dry
COMP_C_RHO = 1.5            # viscosity e-folding per 50 kg/m3 above 150
COMP_C_T = 2.0              # viscosity e-folding per 10 K below 273.15 K
COMP_C_WET = 3.0            # liquid-content softening factor
COMP_MAX_RATE_HR = 0.02     # max fractional thickness loss per hour

DT_SUB = 60.0               # substep length (s); step-insensitivity verified
RESULTS_DIR = "results"


# --------------------------------------------------------------------- #
# Helpers                                                                #
# --------------------------------------------------------------------- #
def k_eff_sturm(rho):
    """Effective thermal conductivity, Sturm et al. (1997), rho in kg/m3."""
    rg = rho / 1000.0
    k = 0.138 - 1.01 * rg + 3.233 * rg * rg
    return max(0.02, k)


def q_sat_ice(t):
    """Saturation vapour pressure over ice (Pa), Clausius-Clapeyron."""
    return 611.2 * math.exp(5423.0 * (1.0 / TF - 1.0 / t))


def q_sat_mix(t, p):
    e = q_sat_ice(t)
    return 0.622 * e / (p - 0.378 * e)


# --------------------------------------------------------------------- #
# Model core                                                             #
# --------------------------------------------------------------------- #
def simulate(forc, init, dt_sub=DT_SUB, albedo=ALBEDO, c_h=C_H, c_e=C_E,
             wind=WIND_SPEED, rel_hum=REL_HUM, t_ground=T_GROUND,
             k_ground=K_GROUND, theta_irr=THETA_IRR):
    """Run the fixed-3-layer simulation; returns state/summary/diagnostics."""
    n_hours = len(forc["t_air"])
    n_days = n_hours // 24
    n_sub = int(round(3600.0 / dt_sub))
    dt = 3600.0 / n_sub

    # state variables: ice (mm w.e. = kg/m2), liquid (mm), thickness (m), T (K)
    ice = [float(l["ice_mm"]) for l in init["layers"]]
    liq = [float(l["liq_mm"]) for l in init["layers"]]
    dep = [float(l["thickness_m"]) for l in init["layers"]]
    tmp = [float(l["temp_K"]) for l in init["layers"]]

    state = np.zeros((n_days, 3, 5), dtype=np.float64)
    summary = np.zeros((n_days, 6), dtype=np.float64)  # swe,dep,melt,rf,ro,rho

    acc = {"melt": 0.0, "refrz": 0.0, "runoff": 0.0, "evap": 0.0,
           "snow": 0.0, "rain": 0.0, "sub": 0.0, "dep": 0.0}
    tot = dict(acc)
    max_resid = 0.0
    energy = {"q_in": 0.0, "h_precip": 0.0, "h_sub": 0.0,
              "q_skin_melt": 0.0, "h_runoff": 0.0, "h_evap": 0.0}

    def h_total():
        """Enthalpy of the snowpack relative to liquid water at 273.15 K.

        h_ice(T) = C_ICE*(T-TF) - L_F ; h_liq(T) = C_WAT*(T-TF).  With this
        reference, melting ice at 273.15 K raises H by L_F per kg (energy
        supplied externally), refreeze lowers it by L_F (heat released into
        the layer cold content) - so the bookkeeping below is exact.
        """
        h = 0.0
        for i in range(3):
            h += ice[i] * (C_ICE * (tmp[i] - TF) - L_F)
            h += liq[i] * C_WAT * (tmp[i] - TF)
        return h

    h0 = h_total()
    swe_prev = sum(l["ice_mm"] + l["liq_mm"] for l in init["layers"])

    for day in range(n_days):
        acc.update(melt=0.0, refrz=0.0, runoff=0.0, evap=0.0, snow=0.0,
                   rain=0.0, sub=0.0, dep=0.0)
        for hh in range(24):
            hr = day * 24 + hh
            ta = float(forc["t_air"][hr])
            sf = float(forc["snow"][hr])
            rn = float(forc["rain"][hr])
            sw = float(forc["sw"][hr])
            lw = float(forc["lw"][hr])

            # ---------------- precipitation input (top layer) ------------
            if sf > 0.0:
                c_old = ice[0] * C_ICE + liq[0] * C_WAT
                t_new = min(ta, TF)
                tmp[0] = (c_old * tmp[0] + sf * C_ICE * t_new) / (c_old + sf * C_ICE)
                ice[0] += sf
                dep[0] += sf / FRESH_SNOW_RHO
                acc["snow"] += sf
                energy["h_precip"] += sf * (C_ICE * (t_new - TF) - L_F)
            if rn > 0.0:
                c_old = ice[0] * C_ICE + liq[0] * C_WAT
                t_r = min(ta, TF)
                tmp[0] = (c_old * tmp[0] + rn * C_WAT * t_r) / (c_old + rn * C_WAT)
                liq[0] += rn
                acc["rain"] += rn
                energy["h_precip"] += rn * C_WAT * (t_r - TF)

            # per-hour surface-balance constants
            sw_abs = (1.0 - albedo) * sw
            rho_air = P_ATM / (R_AIR * ta)
            q_air = rel_hum * q_sat_mix(ta, P_ATM)

            for _ in range(n_sub):
                rho0 = (ice[0] + liq[0]) / dep[0]
                k1 = k_eff_sturm(rho0)
                dist1 = max(dep[0] * 0.5, 1e-4)

                def skin_flux(ts):
                    """F(ts) = surface sources - conductive sink (W/m2)."""
                    lw_net = EPS_SNOW * lw - EPS_SNOW * SIGMA * ts ** 4
                    qh = rho_air * C_AIR * c_h * wind * (ta - ts)
                    ql = rho_air * L_S * c_e * wind * (q_air - q_sat_mix(ts, P_ATM))
                    cond = k1 * (ts - tmp[0]) / dist1
                    return sw_abs + lw_net + qh + ql - cond, qh, ql

                f_tf, qh_tf, ql_tf = skin_flux(TF)
                if f_tf > 0.0:                       # skin pinned at melting point
                    ts_skin = TF
                    q_in = k1 * (TF - tmp[0]) / dist1
                    surplus = f_tf
                else:
                    lo, hi = 150.0, TF
                    for _ in range(40):
                        mid = 0.5 * (lo + hi)
                        f_mid, _, _ = skin_flux(mid)
                        if f_mid > 0.0:
                            lo = mid
                        else:
                            hi = mid
                    ts_skin = 0.5 * (lo + hi)
                    lw_net = EPS_SNOW * lw - EPS_SNOW * SIGMA * ts_skin ** 4
                    qh = rho_air * C_AIR * c_h * wind * (ta - ts_skin)
                    ql = rho_air * L_S * c_e * wind * (q_air - q_sat_mix(ts_skin, P_ATM))
                    q_in = sw_abs + lw_net + qh + ql
                    surplus = 0.0
                    ql_tf = ql

                # ---------- sublimation / deposition mass exchange --------
                # (enthalpy of exchange evaluated at the skin temperature)
                m_sub = ql_tf * dt / L_S
                if m_sub < 0.0:
                    remove = min(-m_sub, max(ice[0], 0.0))
                    rho_now = max((ice[0] + liq[0]) / dep[0], 1.0)
                    ice[0] -= remove
                    dep[0] = max(dep[0] - remove / rho_now, 1e-5)
                    acc["sub"] += remove
                    energy["h_sub"] += remove * (L_F - C_ICE * (TF - tmp[0]))
                elif m_sub > 0.0:
                    rho_now = max((ice[0] + liq[0]) / dep[0], 1.0)
                    ice[0] += m_sub
                    dep[0] += m_sub / rho_now
                    acc["dep"] += m_sub
                    energy["h_sub"] += m_sub * (C_ICE * (tmp[0] - TF) - L_F)

                # ---------- conduction between layers and ground ----------
                rho1 = (ice[1] + liq[1]) / dep[1]
                rho2 = (ice[2] + liq[2]) / dep[2]
                k2 = k_eff_sturm(rho1)
                k3 = k_eff_sturm(rho2)
                k12 = 2.0 * k1 * k2 / (k1 + k2)
                k23 = 2.0 * k2 * k3 / (k2 + k3)
                d12 = 0.5 * (dep[0] + dep[1])
                d23 = 0.5 * (dep[1] + dep[2])
                q12 = k12 * (tmp[0] - tmp[1]) / d12
                q23 = k23 * (tmp[1] - tmp[2]) / d23
                qg = k_ground * (t_ground - tmp[2]) / max(dep[2] * 0.5, 1e-4)

                e0 = (q_in - q12) * dt
                e1 = (q12 - q23) * dt
                e2 = (q23 + qg) * dt
                energy["q_in"] += (q_in + qg) * dt

                c0 = ice[0] * C_ICE + liq[0] * C_WAT
                c1 = ice[1] * C_ICE + liq[1] * C_WAT
                c2 = ice[2] * C_ICE + liq[2] * C_WAT
                if c0 > 0.0:
                    tmp[0] += e0 / c0
                else:
                    tmp[0] = TF
                if c1 > 0.0:
                    tmp[1] += e1 / c1
                else:
                    tmp[1] = TF
                if c2 > 0.0:
                    tmp[2] += e2 / c2
                else:
                    tmp[2] = TF

                # ---------- melt / refreeze (cold-content bookkeeping) ----
                for i in range(3):
                    ci = ice[i] * C_ICE + liq[i] * C_WAT
                    if ice[i] <= 0.0 and liq[i] > 0.0 and tmp[i] > TF:
                        # ice-free (ponded meltwater): excess energy above the
                        # melting point cannot be stored as sensible heat of a
                        # snow layer in any physical sense - it evaporates
                        # water (open-system latent sink, tracked in closure).
                        excess = (tmp[i] - TF) * ci
                        ev = min(liq[i], excess / L_V)
                        liq[i] -= ev
                        acc["evap"] += ev
                        energy["h_evap"] += ev * L_V
                        tmp[i] = TF
                        continue
                    if tmp[i] > TF:
                        excess = (tmp[i] - TF) * ci
                        if ice[i] > 0.0 and ice[i] >= excess / L_F:
                            melt = excess / L_F
                            ice[i] -= melt
                            liq[i] += melt
                            acc["melt"] += melt
                            tmp[i] = TF
                        else:
                            # all ice melts; any leftover warms the liquid
                            e_used = ice[i] * L_F
                            acc["melt"] += ice[i]
                            liq[i] += ice[i]
                            ice[i] = 0.0
                            c_liq = max(liq[i] * C_WAT, 1e-9)
                            tmp[i] = TF + max(excess - e_used, 0.0) / c_liq
                    elif tmp[i] < TF and liq[i] > 0.0:
                        cc = (TF - tmp[i]) * ci
                        refr = min(liq[i], cc / L_F)
                        liq[i] -= refr
                        ice[i] += refr
                        acc["refrz"] += refr
                        c_new = ice[i] * C_ICE + liq[i] * C_WAT
                        tmp[i] = TF - max(cc - refr * L_F, 0.0) / c_new

                # ---------- surface melt when skin pinned -----------------
                if surplus > 0.0:
                    m_pot = surplus * dt / L_F
                    m = min(m_pot, max(ice[0], 0.0))
                    if m > 0.0:
                        ice[0] -= m
                        liq[0] += m
                        acc["melt"] += m
                        energy["q_skin_melt"] += m * L_F
                    leftover = (m_pot - m) * L_F      # no ice left to melt
                    if leftover > 0.0 and liq[0] > 0.0:
                        tmp[0] += leftover / max(liq[0] * C_WAT, 1e-9)
                        energy["q_in"] += leftover

                # ---------- percolation & runoff --------------------------
                # Drainage moves liquid together with its enthalpy relative
                # to the 273.15 K reference (meltwater is at TF, so in the
                # normal regime this is a pure mass transfer; blending keeps
                # energy conservation exact in degenerate warm-water states).
                for i in range(3):
                    pore = dep[i] - ice[i] / RHO_ICE
                    cap = max(theta_irr * pore * 1000.0, 0.0)
                    if liq[i] > cap:
                        move = liq[i] - cap
                        liq[i] = cap
                        h_move = move * C_WAT * (tmp[i] - TF)
                        if i < 2:
                            c_recv = ice[i + 1] * C_ICE + liq[i + 1] * C_WAT
                            tmp[i + 1] = TF + (c_recv * (tmp[i + 1] - TF)
                                               + h_move) \
                                         / (c_recv + move * C_WAT)
                            liq[i + 1] += move
                        else:
                            energy["h_runoff"] += h_move
                            acc["runoff"] += move

            # ---------------- hourly compaction ---------------------------
            mass_above = 0.0
            for i in range(3):
                mi = ice[i] + liq[i]
                p_ovb = G * mass_above
                rho_i = mi / dep[i]
                wet = liq[i] / max(mi, 1e-9)
                arg1 = min(COMP_C_RHO * (rho_i - 150.0) / 50.0, 700.0)
                arg2 = min(COMP_C_T * (TF - tmp[i]) / 10.0, 700.0)
                eta = (ETA0 * math.exp(arg1) * math.exp(arg2)
                       / (1.0 + COMP_C_WET * wet))
                rate = min(p_ovb / eta, COMP_MAX_RATE_HR / 3600.0)
                dep[i] *= (1.0 - rate * 3600.0)
                dep[i] = max(dep[i], mi / RHO_ICE)     # density cap 917 kg/m3
                mass_above += mi

        # ---------------- end of day bookkeeping --------------------------
        swe = sum(ice) + sum(liq)
        depth = sum(dep)
        state[day, :, 0] = dep
        state[day, :, 1] = [(ice[i] + liq[i]) / dep[i] for i in range(3)]
        state[day, :, 2] = ice
        state[day, :, 3] = liq
        state[day, :, 4] = tmp
        summary[day] = (swe, depth, acc["melt"], acc["refrz"], acc["runoff"],
                        swe / depth)

        d_swe = swe - swe_prev
        inflow = acc["snow"] + acc["rain"] + acc["dep"]
        outflow = acc["sub"] + acc["runoff"] + acc["evap"]
        max_resid = max(max_resid, abs(d_swe - (inflow - outflow)))
        swe_prev = swe
        for k in tot:
            tot[k] += acc[k]

    return {"state": state, "summary": summary, "max_resid": max_resid,
            "tot": tot, "energy": {"q_in": energy["q_in"],
                                   "h_precip": energy["h_precip"],
                                   "h_sub": energy["h_sub"],
                                   "q_skin_melt": energy["q_skin_melt"],
                                   "h_runoff": energy["h_runoff"],
                                   "h_evap": energy["h_evap"],
                                   "h0": h0, "h_end": h_total()}}


# --------------------------------------------------------------------- #
# Diagnostic figure                                                      #
# --------------------------------------------------------------------- #
def build_figure(state, summary, path):
    """4-panel diagnostic figure; matplotlib preferred, stdlib PNG fallback."""
    n = state.shape[0]
    day = np.arange(1, n + 1)
    swe = state[:, :, 2].sum(1) + state[:, :, 3].sum(1)
    depth = state[:, :, 0].sum(1)
    mean_rho = swe / depth
    temps = state[:, :, 4] - 273.15
    melt = summary[:, 2]
    refrz = summary[:, 3]
    runoff = summary[:, 4]

    panels = [
        {"title": "SWE AND DEPTH", "ylim": (0, max(swe.max(), 1) * 1.1),
         "series": [(swe, "#1f77b4", "SWE (MM)"), (depth * 100.0, "#d62728", "DEPTH X100 (CM)")]},
        {"title": "LAYER TEMPERATURE (C)", "ylim": None,
         "series": [(temps[:, 0], "#d62728", "TOP"), (temps[:, 1], "#2ca02c", "MID"),
                    (temps[:, 2], "#1f77b4", "BOTTOM")]},
        {"title": "LAYER DENSITY (KG/M3)", "ylim": (0, None),
         "series": [(state[:, :, 1][:, 0], "#d62728", "TOP"),
                    (state[:, :, 1][:, 1], "#2ca02c", "MID"),
                    (state[:, :, 1][:, 2], "#1f77b4", "BOTTOM"),
                    (mean_rho, "#000000", "MEAN")]},
        {"title": "DAILY FLUXES (MM)", "ylim": (0, None),
         "series": [(melt, "#ff7f0e", "MELT"), (refrz, "#9467bd", "REFREEZE"),
                    (runoff, "#17becf", "RUNOFF")]},
    ]
    try:
        import matplotlib
        matplotlib.use("Agg")
        import matplotlib.pyplot as plt
        fig, axes = plt.subplots(2, 2, figsize=(14, 10))
        for ax, p in zip(axes.ravel(), panels):
            for y, col, lab in p["series"]:
                ax.plot(day, y, color=col, lw=1.2, label=lab)
            ax.set_title(p["title"])
            ax.set_xlabel("day")
            ax.legend(loc="best", fontsize=8)
            ax.grid(alpha=0.3)
        axes[0, 0].set_ylabel("mm / cm")
        axes[1, 0].set_ylabel("deg C / kg m-3")
        axes[1, 1].set_ylabel("mm")
        fig.suptitle("3-layer snowpack evolution under hourly forcing")
        fig.tight_layout()
        fig.savefig(path, dpi=110)
        plt.close(fig)
        return "matplotlib"
    except Exception:
        _render_png_fallback(path, panels, day)
        return "stdlib-png-fallback"


