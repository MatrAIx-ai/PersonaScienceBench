    if d["fit_ok"]:
        tt = np.array(d["fit_range"])
        ax.loglog(tt, d["amp"] * tt ** d["exponent"], "r--",
                  label=f"fit: L = {d['amp']:.3g} t^{d['exponent']:.3f} "
                        f"(R2={d['r2']:.4f})")
        ax.axvspan(*d["fit_range"], color="r", alpha=0.08)
    ax.set_xlabel("t [sweeps]"); ax.set_ylabel("L(t)"); ax.legend(fontsize=8)
    ax.set_title("metadataB: coarsening power law", fontsize=10)

    ax = fig.add_subplot(gsf[2, 3:6])
    for i, t in enumerate(d["snap_times"]):
        ax.plot(d["stackE"][i, 0], label=f"rows, t={int(t)}")
    ax.plot(d["stackE"][-1, 1], "--",
            label=f"cols, t={int(d['snap_times'][-1])}")
    ax.set_xlabel("row / column index")
    ax.set_ylabel("magnetization profile"); ax.legend(fontsize=7)
    ax.set_title("stackD / stackE: directional profiles", fontsize=10)

    fig.suptitle(d["suptitle"], fontsize=12)
    fig.savefig(path, dpi=140, bbox_inches="tight")
    plt.close(fig)


