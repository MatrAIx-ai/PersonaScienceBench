def _png_write(path, img):
    import struct, zlib
    h, w, _ = img.shape
    raw = b"".join(b"\x00" + img[i].tobytes() for i in range(h))

    def chunk(tag, data):
        return (struct.pack(">I", len(data)) + tag + data +
                struct.pack(">I", zlib.crc32(tag + data) & 0xFFFFFFFF))

    ihdr = struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0)
    with open(path, "wb") as f:
        f.write(b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", ihdr) +
                chunk(b"IDAT", zlib.compress(raw, 6)) + chunk(b"IEND", b""))


def _text(img, x, y, s, scale=2, color=(0, 0, 0)):
    for ch in str(s).upper():
        g = _FONT.get(ch, _FONT[" "])
        for r in range(7):
            bits = g[r]
            for c in range(5):
                if bits & (1 << (4 - c)):
                    img[y + r * scale:y + (r + 1) * scale,
                        x + c * scale:x + (c + 1) * scale] = color
        x += 6 * scale
    return x


def _line(img, x0, y0, x1, y1, color):
    H, W, _ = img.shape
    dx, dy = abs(x1 - x0), abs(y1 - y0)
    sx = 1 if x0 < x1 else -1
    sy = 1 if y0 < y1 else -1
    err = dx - dy
    while True:
        if 0 <= y0 < H and 0 <= x0 < W:
            img[y0, x0] = color
        if x0 == x1 and y0 == y1:
            break
        e2 = 2 * err
        if e2 > -dy:
            err -= dy
            x0 += sx
        if e2 < dx:
            err += dx
            y0 += sy


def _hline(img, x0, x1, y, color):
    for x in range(min(x0, x1), max(x0, x1) + 1):
        if 0 <= y < img.shape[0] and 0 <= x < img.shape[1]:
            img[y, x] = color


def _vline(img, x, y0, y1, color):
    for y in range(min(y0, y1), max(y0, y1) + 1):
        if 0 <= y < img.shape[0] and 0 <= x < img.shape[1]:
            img[y, x] = color


def _fmt(v):
    v = float(v)
    if abs(v - round(v)) < 1e-9 and abs(v) < 1e6:
        return str(int(round(v)))
    return "%.3g" % v


def _lin_ticks(lo, hi, n=4):
    span = hi - lo
    if span <= 0:
        return [lo]
    raw = span / max(n, 1)
    mag = 10.0 ** np.floor(np.log10(raw))
    step = 10 * mag
    for m in (1, 2, 2.5, 5, 10):
        if raw <= m * mag:
            step = m * mag
            break
    t0 = np.ceil(lo / step) * step
    out, v = [], float(t0)
    while v <= hi + 1e-9 * max(1.0, abs(hi)):
        out.append(v)
        v += step
    return out or [lo, hi]


def _log_ticks(lo, hi):
    out = []
    k = int(np.floor(np.log10(max(lo, 1e-12))))
    while 10.0 ** k <= hi * 1.001:
        for m in (1, 2, 5):
            v = m * 10.0 ** k
            if lo * 0.999 <= v <= hi * 1.001:
                out.append(v)
        k += 1
    return out or [lo, hi]


_COLORS = [(200, 30, 30), (30, 60, 200), (30, 150, 60), (230, 140, 30),
           (130, 60, 160), (110, 80, 40), (0, 0, 0), (0, 130, 160)]


def _plot_panel(img, rect, series, title, xlabel="", ylabel="",
                logx=False, logy=False, xlim=None, ylim=None,
                legend=True, ntx=4, nty=4):
    x0, y0, x1, y1 = rect
    gx = (70, 70, 70)
    _hline(img, x0, x1, y0, gx); _hline(img, x0, x1, y1, gx)
    _vline(img, x0, y0, y1, gx); _vline(img, x1, y0, y1, gx)
    allx = np.concatenate([np.asarray(s[0], float) for s in series])
    ally = np.concatenate([np.asarray(s[1], float) for s in series])
    xmin, xmax = (float(allx.min()), float(allx.max())) if xlim is None else xlim
    ymin, ymax = (float(ally.min()), float(ally.max())) if ylim is None else ylim
    if not logy:
        pad = 0.06 * (ymax - ymin if ymax > ymin else 1.0)
        ymin, ymax = ymin - pad, ymax + pad
    else:
        ymin = max(ymin, 1e-3)
        ymax = ymax * 1.4
    px0, px1 = x0 + 46, x1 - 8
    py0, py1 = y0 + 18, y1 - 22

    def tx(v):
        if logx:
            v, a, b = np.log10(v), np.log10(xmin), np.log10(xmax)
        else:
            a, b = xmin, xmax
        return px0 + (v - a) / (b - a) * (px1 - px0)

    def ty(v):
        if logy:
            v, a, b = np.log10(v), np.log10(ymin), np.log10(ymax)
        else:
            a, b = ymin, ymax
        return py1 - (v - a) / (b - a) * (py1 - py0)

    xtk = _log_ticks(xmin, xmax) if logx else _lin_ticks(xmin, xmax, ntx)
    ytk = _log_ticks(ymin, ymax) if logy else _lin_ticks(ymin, ymax, nty)
    for v in xtk:
        xp = int(round(tx(v)))
        if px0 <= xp <= px1:
            _vline(img, xp, py1, py1 + 3, gx)
            _text(img, xp - 6, py1 + 6, _fmt(v), 1, gx)
    for v in ytk:
        yp = int(round(ty(v)))
        if py0 <= yp <= py1:
            _hline(img, px0 - 3, px0, yp, gx)
            _text(img, px0 - 44, yp - 4, _fmt(v), 1, gx)
    _text(img, x0 + 6, y0 + 4, title, 1, (0, 0, 0))
    if xlabel:
        _text(img, x0 + 46, y1 + 8, xlabel, 1, (0, 0, 0))
    if ylabel:
        for i, ch in enumerate(str(ylabel).upper()):
            if ch != " ":
                _text(img, x0 - 42, y0 + 24 + 12 * i, ch, 1, (0, 0, 0))
    for k, (xs, ys, lab) in enumerate(series):
        col = _COLORS[k % len(_COLORS)]
        X = np.asarray(xs, float)
        Y = np.asarray(ys, float)
        mm = np.isfinite(X) & np.isfinite(Y)
        X, Y = X[mm], Y[mm]
        pts = [(int(round(tx(x))), int(round(ty(y)))) for x, y in zip(X, Y)]
        for a, b in zip(pts[:-1], pts[1:]):
            _line(img, a[0], a[1], b[0], b[1], col)
        if legend and lab:
            lx = max(px0 + 4, x1 - 140)
            ly = py0 + 6 + 12 * k
            _hline(img, lx, lx + 14, ly + 3, col)
            _text(img, lx + 18, ly, lab, 1, col)


def _spin_panel(img, state, x0, y0, size, title):
    _text(img, x0, y0 - 14, title, 1, (0, 0, 0))
    a = np.asarray(state, float)
    t = ((a + 1.0) / 2.0)[..., None]
    lo = np.array([50, 70, 190]); mid = np.array([238, 238, 238])
    hi = np.array([190, 30, 30])
    col = np.where(t < 0.5, lo + (t / 0.5) * (mid - lo),
                   mid + ((t - 0.5) / 0.5) * (hi - mid))
    k = int(size / a.shape[0])
    big = np.kron(np.rint(col).astype(np.uint8),
                  np.ones((k, k, 1), np.uint8))
    img[y0:y0 + size, x0:x0 + size] = big


