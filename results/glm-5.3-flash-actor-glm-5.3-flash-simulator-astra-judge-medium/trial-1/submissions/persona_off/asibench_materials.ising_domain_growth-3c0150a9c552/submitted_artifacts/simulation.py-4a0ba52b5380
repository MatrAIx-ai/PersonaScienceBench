# main
# ----------------------------------------------------------------------
def main():
    params = json.load(open(f"{DATA_DIR}/parameters.json"))
    grid = params["grid_size"]
    T = params["control"]
    n_steps = params["n_steps"]
    snap_times = params["snapshot_times"]
    meas_times = params["measurement_times"]
    max_r = params["max_r"]
    seed = params["dynamics_seed"]

    s0 = np.load(f"{DATA_DIR}/initial_state.npy")
    assert s0.shape == (grid, grid)

    rng = np.random.default_rng(seed)
    ii, jj = np.indices((grid, grid))
    masks = [(ii + jj) % 2 == 0, (ii + jj) % 2 == 1]

    snap_idx = [int(t) for t in snap_times]
    snap_set = set(snap_idx)
    meas_pos = {int(t): k for k, t in enumerate(meas_times)}
    targets = set(meas_pos) | snap_set

    m_series = np.full(len(meas_pos), np.nan)
    e_series = np.full(len(meas_pos), np.nan)
    Lrho_series = np.full(len(meas_pos), np.nan)
    states = {}

    s = s0.astype(np.int16).copy()
    for t in range(1, n_steps + 1):
        s = metropolis_sweep(s, T, rng, masks)
        if t in targets:
            bal, e, rho = bond_stats(s)
            if t in meas_pos:
                k = meas_pos[t]
                m_series[k] = s.mean()
                e_series[k] = e
                Lrho_series[k] = 1.0 / rho
            states[t] = s.astype(np.int8).copy()

    assert not np.isnan(m_series).any(), "missing measurement records"

    # per-measurement-time half-crossing length of C(r)
    Lh_series = np.array([
        half_crossing(radial_correlation(states[int(t)].astype(np.float64), max_r),
                      max_r - 1)
        for t in meas_times])

    # ---------------- per-snapshot diagnostics ----------------
    n_snap = len(snap_times)
    stackC = np.zeros((n_snap, max_r))
    stackD = np.zeros((n_snap, grid))
    stackE = np.zeros((n_snap, 2, grid))
    L_snap, Lh_snap = [], []
    for i, t in enumerate(snap_idx):
        st = states[t].astype(np.float64)
        C = radial_correlation(st, max_r)
        stackC[i] = C
        stackD[i] = st.mean(axis=1)
        stackE[i, 0] = st.mean(axis=1)
        stackE[i, 1] = st.mean(axis=0)
        bal, e, rho = bond_stats(st.astype(np.int16))
        L_snap.append(1.0 / rho)
        Lh_snap.append(half_crossing(C, max_r - 1))
    L_snap = np.array(L_snap)
    Lh_snap = np.array(Lh_snap)

    # ---------------- metadataA: scaling collapse ----------------
    Lmax = L_snap.max()
    x_max = float(min(2.0, 0.95 * (max_r - 1) / Lmax))
    x_min = 0.05
    applicable = bool(x_max > x_min and np.all(np.isfinite(L_snap)) and Lmax > 1.0)
    rel_spread = quality = None
    alt_quality = None
    x_range = [x_min, x_max]
    if applicable:
        xg = np.linspace(x_min, x_max, 200)

        def _q(Ls, curves):
            Y = np.vstack([np.interp(xg, np.arange(max_r) / L, c)
                           for L, c in zip(Ls, curves)])
            ybar = Y.mean(axis=0)
            den = np.sqrt((ybar ** 2).mean())
            if den <= 0:
                return None
            sp = float(np.sqrt(((Y - ybar) ** 2).mean()) / den)
            return float(max(0.0, 1.0 - sp)), sp

        res = _q(L_snap, stackC)
        if res:
            quality, rel_spread = res
        res_alt = _q(Lh_snap, stackC)
        if res_alt:
            alt_quality = res_alt[0]
    else:
        x_range = [0.0, 0.0]

    rho_end = float(Lrho_series[-1] ** -1)
    m_end = float(m_series[-1])
    metadataA = {
        "collapse_check_applicable": applicable,
        "collapse_quality": quality,
        "collapse_relative_rms_spread": rel_spread,
        "collapse_dimension": 2,
        "collapse_snapshot_times": [float(t) for t in snap_times],
        "collapse_lengths": [float(v) for v in L_snap],
        "collapse_x_range": [float(x_range[0]), float(x_range[1])],
        "collapse_grid_size": int(grid) if applicable else 0,
        "notes": [
            "Model: 2D Ising, Metropolis single-spin-flip (model A) at "
            "T = control = %.4f (J = k_B = 1), one sweep per time step, "
            "checkerboard updates, periodic boundaries, numpy "
            "default_rng(dynamics_seed)." % T,
            "Collapse: y = C(r, t) (normalized, C(0) = 1) vs x = r/L(t) with "
            "L = 1/rho (rho = unlike-neighbor-bond fraction); curves "
            "interpolated onto a common x grid over collapse_x_range; "
            "relative RMS spread = RMS(curves - mean)/RMS(mean); "
            "collapse_quality = 1 - spread clipped to [0, 1].",
            "Cross-check: half-crossing length of C(r) (first r with C < 0.5) "
            "at the snapshot times = %s; a collapse built on those lengths "
            "gives quality = %.3f." % ([round(float(v), 1) for v in Lh_snap],
                                       alt_quality if alt_quality is not None
                                       else float("nan")),
            "T = 2.0236 lies close to Tc = 2.269: the coarsening regime lasts "
            "only up to t ~ 300 (the half-crossing length grows ~ t^0.5), "
            "after which the finite %dx%d system equilibrates (m -> %.2f, "
            "equilibrium interface-density floor rho_eq ~ %.3f, so 1/rho "
            "plateaus near %.0f). Late snapshots are near-equilibrium "
            "configurations, which degrades the scaling collapse."
            % (grid, grid, m_end, rho_end, 1.0 / rho_end),
            "Control-parameter check: the temperature reading T = control is "
            "supported by the observed dynamics (interface density falls "
            "0.5 -> %.3f and domains coarsen with ~t^0.5 before "
            "equilibration). The alternative reading beta*J = control "
            "(T = 0.494) was tested during development and rejects itself: "
            "the quench freezes into a metastable wall network within ~50 "
            "sweeps (e freezes at -1.957, rho ~ 0.011) with no progressive "
            "domain growth." % rho_end,
        ],
    }

    # ---------------- metadataB: power-law fit ----------------
    tmeas = np.asarray(meas_times, dtype=float)
    Lm = Lh_series
    lo_ok = Lm >= 3.0
    hi_ok = np.abs(m_series) <= 0.5
    t_lo = float(tmeas[lo_ok].min()) if lo_ok.any() else None
    t_hi = float(tmeas[hi_ok].max()) if hi_ok.any() else None
    fit_ok = t_lo is not None and t_hi is not None and t_hi > t_lo
    if fit_ok:
        sel = (tmeas >= t_lo) & (tmeas <= t_hi)
        if sel.sum() < 10:
            fit_ok = False
    exponent = p_err = amp = r_squared = np.nan
    fit_range = [float(tmeas.min()), float(tmeas.max())]
    rho_fit_note = ""
    if fit_ok:
        fit_range = [t_lo, t_hi]
        x = np.log(tmeas[sel])
        y = np.log(Lm[sel])
        A = np.vstack([np.ones_like(x), x]).T
        coef, *_ = np.linalg.lstsq(A, y, rcond=None)
        yhat = A @ coef
        ss_res = ((y - yhat) ** 2).sum()
        ss_tot = ((y - y.mean()) ** 2).sum()
        r_squared = float(1.0 - ss_res / ss_tot) if ss_tot > 0 else np.nan
        dof = max(len(x) - 2, 1)
        cov = (ss_res / dof) * np.linalg.inv(A.T @ A)
        p, logA = float(coef[1]), float(coef[0])
        p_err = float(np.sqrt(cov[1, 1]))
        exponent = p
        amp = float(np.exp(logA))
        cc = np.polyfit(np.log(tmeas[sel]), np.log(Lrho_series[sel]), 1)
        rho_fit_note = ("Cross-check: the interface-density length 1/rho over "
                        "the same window gives p = %.3f (lower because it "
                        "already contains part of the equilibrium wall-density "
                        "floor)." % cc[0])

    metadataB = {
        "exponent": exponent,
        "exponent_std_error": p_err,
        "amplitude": amp,
        "fit_range": [float(v) for v in fit_range],
        "r_squared": r_squared,
        "notes": [
            "Fit: OLS of log L(t) vs log t over measurement times in "
            "fit_range; L = half-crossing length of the normalized "
            "correlation C(r, t) (first r with C < 0.5).",
            "fit_range is the growth window: from the first time with "
            "L >= 3 to the last time with |m(t)| <= 0.5. Beyond it the "
            "system equilibrates at T = 2.0236 (close to Tc), C(r) tends to "
            "the m^2 plateau above 0.5, and no clean power law exists; "
            "forcing a fit over the saturated regime would be meaningless.",
            "For model-A 2D Ising coarsening the expected exponent is "
            "1/z ~= 0.44-0.5 (z ~ 2.17).",
        ],
    }
    if fit_ok:
        metadataB["notes"].append(rho_fit_note)
    else:
        metadataB["notes"].append("No valid power-law fit: NaN reported "
                                  "per the schema fallback.")
    metadataB["notes"].append(
        "Control-parameter check: under T = control the half-crossing length "
        "grows with exponent ~0.5 before equilibration; the alternative "
        "beta*J = control reading (T = 0.494) shows no progressive growth "
        "(frozen metastable network), so the temperature reading is adopted.")

    # ---------------- write artifacts ----------------
    np.save(f"{OUT_DIR}/seriesA.npy", np.vstack([tmeas, m_series]).astype(np.float64))
    np.save(f"{OUT_DIR}/seriesB.npy", np.vstack([tmeas, e_series]).astype(np.float64))
    np.save(f"{OUT_DIR}/stackC.npy", stackC.astype(np.float64))
    np.save(f"{OUT_DIR}/stackD.npy", stackD.astype(np.float64))
    np.save(f"{OUT_DIR}/stackE.npy", stackE.astype(np.float64))

    json.dump(metadataA, open(f"{OUT_DIR}/metadataA.json", "w"), indent=2)
    json.dump(metadataB, open(f"{OUT_DIR}/metadataB.json", "w"), indent=2)

    # ---------------- figure ----------------
    figdata = dict(
        suptitle=("B3 HIDDEN BINARY-GRID TIME EVOLUTION: 2D ISING DOMAIN "
                  f"GROWTH  T={T}  GRID={grid}  SEED={seed}"),
        snap_times=snap_times, states=[states[int(t)] for t in snap_idx],
        tmeas=tmeas, m=m_series, e=e_series,
        stackC=stackC, stackE=stackE, snap_idx=snap_idx,
        L_snap=L_snap, Lh_snap=Lh_snap, Lm=Lm, Lrho=Lrho_series,
        max_r=max_r,
        applicable=applicable, quality=quality, x_range=x_range,
        fit_ok=fit_ok, exponent=exponent, amp=amp, r2=r_squared,
        fit_range=fit_range, grid=grid, T=T, seed=seed,
        exp_err=p_err, rel_spread=rel_spread,
    )
    try:
        _render_figure_matplotlib(figdata, OUT_DIR + "/figure.png")
    except Exception as exc:
        print("matplotlib unavailable (%s); using pure-numpy PNG renderer" % exc)
        _render_figure_numpy(figdata, OUT_DIR + "/figure.png")

    # ---------------- console evidence ----------------
    print(f"T = {T}, n_steps = {n_steps}")
    print("snapshot times :", snap_times)
    print("m at snapshots :", np.round([states[t].mean() for t in snap_idx], 4))
    print("L (1/rho)      :", np.round(L_snap, 3))
    print("L (half-cross) :", Lh_snap)
    print("collapse: applicable=", applicable, " quality=", quality,
          " rel_spread=", rel_spread, " x_range=", x_range,
          " alt_quality(half)=", alt_quality)
    print("fit: exponent=", exponent, "+/-", p_err, " amplitude=", amp,
          " range=", fit_range, " r2=", r_squared)
    print("early trajectory (U1 check): t, m, 1/rho, half-cross ->")
    for t in [5, 6, 10, 14, 20, 26, 41, 49, 60, 84, 103, 138, 201, 269,
              360, 482, 644, 862, 1153, 1542, 2062, 2758, 3689, 4934,
              6599, 8826, 11804, 12305]:
        k = meas_pos[t]
        print(f"   t={t:6d}  m={m_series[k]:+.4f}  1/rho={Lrho_series[k]:6.2f}"
              f"  Lh={Lh_series[k]:5.1f}")


if __name__ == "__main__":
    main()
