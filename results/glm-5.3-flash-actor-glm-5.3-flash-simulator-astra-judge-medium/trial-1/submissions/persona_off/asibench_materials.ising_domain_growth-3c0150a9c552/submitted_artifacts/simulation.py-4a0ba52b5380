"""
B3: Hidden Binary-Grid Time Evolution -- 2D Ising domain growth (model A).

Inferred model
--------------
- data/initial_state.npy is an uncorrelated +/-1 configuration (magnetization
  0.011, nearest-neighbor correlations ~0): a high-temperature quench initial
  condition.
- data/parameters.json: `control` = 2.0236 is interpreted as the temperature T
  in units J = k_B = 1 (just below the exact 2D Ising Tc = 2/ln(1+sqrt2) =
  2.26918), consistent with the episode name `ising_domain_growth` and with the
  log-spaced sampling schedules characteristic of a coarsening study.
- Dynamics: Metropolis single-spin-flip (non-conserved order parameter,
  model A) on a periodic 100x100 lattice; 1 time step = 1 Monte Carlo sweep
  (N = grid_size^2 spin updates, implemented as two conflict-free
  checkerboard half-sweeps); RNG = numpy default_rng(dynamics_seed).

Diagnostics
-----------
- seriesA: [measurement_times, magnetization m(t)]
- seriesB: [measurement_times, energy per site e(t)]  (J = 1)
- stackC : rotationally averaged two-point correlation C(r, t), r = 0..max_r-1,
           C(0) = 1, at the snapshot times.
- stackD : row-wise magnetization profile m(y) per snapshot.
- stackE : [row-wise magnetization profile, column-wise magnetization profile].
- metadataA: dynamic scaling collapse C(r, t) vs x = r/L(t), domain length
           L = 1/rho with rho the unlike-bond (interface) density.
- metadataB: power-law coarsening fit L(t) = A * t^p by OLS on (log t, log L).
"""
import json
import numpy as np

DATA_DIR = "data"
OUT_DIR = "."


# ----------------------------------------------------------------------
# model
# ----------------------------------------------------------------------
def metropolis_sweep(s, T, rng, masks):
    """One Monte Carlo sweep: one Metropolis update attempt at every site,
    done as two conflict-free checkerboard half-sweeps."""
    for mask in masks:
        H = (np.roll(s, 1, 0) + np.roll(s, -1, 0) +
             np.roll(s, 1, 1) + np.roll(s, -1, 1))
        dE = 2 * s * H                      # energy change of a flip (J = 1)
        p = np.where(dE <= 0, 1.0, np.exp(-dE / T))
        flip = mask & (rng.random(s.shape) < p)
        s[flip] = -s[flip]
    return s


def bond_stats(s):
    """Aligned-bond count, energy per site, interface density."""
    b1 = s * np.roll(s, -1, 0)                          # +x bonds
    b2 = s * np.roll(s, -1, 1)                          # +y bonds
    bal = int((b1 > 0).sum() + (b2 > 0).sum())          # aligned bonds
    nbonds = 2 * s.size
    e = (nbonds - 2.0 * bal) / s.size                   # energy per site, J=1
    rho = (nbonds - bal) / nbonds                       # unlike-bond fraction
    return bal, e, rho


_RC_CACHE = {}


def radial_correlation(s, max_r):
    """Rotationally averaged (periodic) two-point correlation C(r),
    r = 0..max_r-1, normalized so C(0) = 1. Vectorized radial binning."""
    s = np.asarray(s, np.float64)
    n = s.shape[0]
    key = (n, max_r)
    if key not in _RC_CACHE:
        i = np.arange(n)
        off = np.where(i <= n // 2, i, i - n).astype(float)
        DX, DY = np.meshgrid(off, off, indexing="ij")
        D = np.rint(np.hypot(DX, DY)).astype(int)
        valid = (D >= 0) & (D < max_r)
        _RC_CACHE[key] = (D[valid], valid)
    Dv, valid = _RC_CACHE[key]
    F = np.fft.fft2(s)
    ac = np.fft.ifft2(F * np.conj(F)).real / s.size
    cnt = np.bincount(Dv, minlength=max_r)
    C = np.bincount(Dv, weights=ac[valid], minlength=max_r) / np.maximum(cnt, 1)
    C[0] = 1.0
    return C


def half_crossing(C, cap):
    """First r with C(r) < 0.5; returns `cap` (= max_r - 1) when the crossing
    lies beyond the accessible window, i.e. the domain length has reached the
    system scale (the total correlation then tends to the m^2 plateau)."""
    for r in range(1, len(C)):
        if C[r] < 0.5:
            return float(r)
    return float(cap)


