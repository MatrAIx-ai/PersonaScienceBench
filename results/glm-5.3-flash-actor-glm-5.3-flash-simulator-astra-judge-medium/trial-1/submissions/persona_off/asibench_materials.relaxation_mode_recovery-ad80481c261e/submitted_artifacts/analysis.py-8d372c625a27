#!/usr/bin/env python3
"""Shared-mode recovery from complex response curves.

Model (curve m):
    R_m(x) = a0_m + sum_{k=1..K} a_{k,m} / (1 + (i*x*tau_k)^phi_k)

Shared across curves: K, tau_k > 0, 0 < phi_k <= 1.
Curve-specific: baseline a0_m (free sign), modal amplitudes a_{k,m} >= 0.

Method: variable projection. For fixed (tau, phi) the model is linear in
(a0_m, a_{k,m}); each curve's amplitudes are solved by bounded linear LS on
the stacked (re, im) system. The outer nonlinear problem over (log tau, phi)
is solved by multistart trust-region least squares. K is selected by a
BIC-style criterion on the profiled SSE, with amplitude-collapse and
multistart-reproduction stability checks.
"""
import json
import os
import numpy as np
from scipy.optimize import least_squares, nnls

RNG = np.random.default_rng(0)

DATA = "data/curves.csv"
OUT_DIR = "results"
PHI_LO, PHI_HI = 0.05, 1.0          # 0 < phi <= 1 hard bound
K_MIN, K_MAX = 1, 6
N_STARTS = 40


def load():
    d = np.genfromtxt(DATA, delimiter=",", names=True, encoding="utf8")
    curves = d["curve"].astype(int)
    x = d["x"]
    y = d["re"] + 1j * d["im"]
    m0 = curves == 0
    xs = x[m0]
    assert all(np.allclose(x[curves == c], xs) for c in range(curves.max() + 1))
    ys = np.stack([y[curves == c] for c in range(curves.max() + 1)])
    return xs, ys


def design(x, log_tau, phi):
    """Complex design matrix (n x (K+1)): constant column + mode columns."""
    cols = [np.ones_like(x)]
    for t, ph in zip(np.atleast_1d(np.exp(log_tau)), np.atleast_1d(phi)):
        z = t * x                                     # x * tau_k
        w = (z ** ph) * np.exp(1j * np.pi * ph / 2)   # (i z)^phi, z>0
        cols.append(1.0 / (1.0 + w))
    return np.stack(cols, axis=1)


def profile_amplitudes(A, ys):
    """Per-curve bounded linear LS via NNLS on the stacked real system.

    a0 is free (any real): encoded as a0 = u - v with u, v >= 0.
    Modal amplitudes are constrained >= 0 directly.
    Returns coeffs (M x (K+1)) and stacked residual vector.
    """
    n2 = 2 * A.shape[0]
    K1 = A.shape[1]
    # augmented design: [a0+  a0-  a_1 ... a_K]
    Ar = np.vstack([A.real, A.imag])              # (2n) x (K+1)
    Aa = np.hstack([Ar[:, :1], -Ar[:, :1], Ar[:, 1:]])  # a0+, a0-, modes
    M = len(ys)
    coeffs = np.empty((M, K1))
    resid = np.empty((M, n2))
    for m in range(M):
        y = ys[m]
        b = np.concatenate([y.real, y.imag])
        xnn, _ = nnls(Aa, b, maxiter=10 * Aa.shape[1])
        a0 = xnn[0] - xnn[1]
        coeffs[m] = np.concatenate([[a0], xnn[2:]])
        resid[m] = Aa @ xnn - b
    return coeffs, resid.ravel()


def make_residual(xs, ys):
    def resid(p):
        K = len(p) // 2
        A = design(xs, p[:K], p[K:])
        _, r = profile_amplitudes(A, ys)
        if not np.all(np.isfinite(r)):
            r = np.nan_to_num(r, nan=1e6, posinf=1e6, neginf=-1e6)
        return r
    return resid


def fit_K(xs, ys, K, n_starts=N_STARTS):
    resid = make_residual(xs, ys)
    lt_lo, lt_hi = np.log(1.0 / xs.max()) - 1.0, np.log(1.0 / xs.min()) + 1.0
    phi_grid = np.array([0.3, 0.5, 0.7, 0.9, 1.0])
    best = None
    found = []
    for s in range(n_starts):
        if s < phi_grid.size:
            lt0 = np.sort(RNG.uniform(lt_lo + 1, lt_hi - 1, size=K))
            phi0 = np.full(K, phi_grid[s])
        else:
            lt0 = np.sort(RNG.uniform(lt_lo, lt_hi, size=K))
            phi0 = RNG.uniform(0.2, 1.0, size=K)
        p0 = np.concatenate([lt0, np.clip(phi0, PHI_LO, PHI_HI)])
        lo = np.concatenate([np.full(K, lt_lo - 3.0), np.full(K, PHI_LO)])
        hi = np.concatenate([np.full(K, lt_hi + 3.0), np.full(K, PHI_HI)])
        try:
            sol = least_squares(resid, p0, bounds=(lo, hi), method="trf",
                                x_scale="jac", max_nfev=400)
        except Exception as e:
            print("  start failed:", repr(e))
            continue
        p = sol.x.copy()
        sse = float(np.sum(sol.fun ** 2))
        found.append((sse, p))
        if best is None or sse < best[0]:
            best = (sse, p)
    return best, found


def main():
    xs, ys = load()
    M = ys.shape[0]
    n = xs.size
    n_total = 2 * n * M

    table, all_found = [], {}
    for K in range(K_MIN, K_MAX + 1):
        best, found = fit_K(xs, ys, K)
        sse, p = best
        n_par = 2 * K + M * (K + 1)
        b = n_total * np.log(sse / n_total) + n_par * np.log(n_total)
        table.append((K, sse, np.sqrt(sse / n_total), n_par, b))
        all_found[K] = found
        print(f"K={K}: SSE={sse:.4f} rms={np.sqrt(sse/n_total):.5f} "
              f"params={n_par} BIC={b:.2f}", flush=True)

    bics = np.array([t[4] for t in table])
    K_best = int(table[int(np.argmin(bics))][0])
    print("BIC-selected K:", K_best)

    sse_best, p_best = min(all_found[K_best], key=lambda t: t[0])
    K = K_best
    lt_b, phi_b = p_best[:K], p_best[K:]
    # stability among starts: (a) SSE within 1% of best, (b) parameter match
    def canon(p):
        """Modes ordered by log-tau, with phi carried along in pairing."""
        idx = np.argsort(p[:K])
        return p[:K][idx], p[K:][idx]
    lt_bc, phi_bc = canon(p_best)
    def match(p):
        lt_i, ph_i = canon(p)
        return (np.max(np.abs(lt_i - lt_bc)) < 0.35
                and np.max(np.abs(ph_i - phi_bc)) < 0.15)
    n_sse = sum(1 for s, _ in all_found[K_best] if s <= 1.01 * sse_best)
    good = [p for s, p in all_found[K_best] if match(p)]
    n_close = len(good)
    if n_close:
        lts = np.stack([canon(g)[0] for g in good])
        phs = np.stack([canon(g)[1] for g in good])
        spread_lt = (lts.max(axis=0) - lts.min(axis=0)).tolist()   # log tau
        spread_phi = (phs.max(axis=0) - phs.min(axis=0)).tolist()
    else:
        spread_lt, spread_phi = [], []
    print(f"starts within 1% of best SSE: {n_sse}/{len(all_found[K_best])}")
    print(f"starts matching best params: {n_close}/{len(all_found[K_best])}")
    print("log-tau spread among matching starts:",
          np.round(np.sort(spread_lt), 3))
    print("phi spread among matching starts:", np.round(np.sort(spread_phi), 3))

    A = design(xs, lt_b, phi_b)
    coeffs, resid = profile_amplitudes(A, ys)
    amps = coeffs[:, 1:]
    collapse = (amps.max(axis=0) < 0.01 * np.abs(ys).max())
    print("mode amplitudes (rows=curves):")
    print(np.array2string(amps, precision=4, suppress_small=True))
    print("collapsed modes:", np.where(collapse)[0].tolist())

    rms_re = np.sqrt(np.mean(resid[:n * M] ** 2))
    rms_im = np.sqrt(np.mean(resid[n * M:] ** 2))
    print(f"residual rms: re={rms_re:.5f} im={rms_im:.5f}")
    rr = resid.reshape(M, 2 * n)
    ac = []
    for m in range(M):
        r_re, r_im = rr[m, :n], rr[m, n:]
        print(f"curve {m}: rms_re={np.sqrt(np.mean(r_re**2)):.5f} "
              f"rms_im={np.sqrt(np.mean(r_im**2)):.5f}")
        ac.append([float(np.corrcoef(r_re[:-1], r_re[1:])[0, 1]),
                   float(np.corrcoef(r_im[:-1], r_im[1:])[0, 1])])
    print("lag-1 autocorrelation of residuals (re, im) per curve:",
          np.round(ac, 3).tolist())
    if K_best < K_MAX:
        sse2, _ = min(all_found[K_best + 1], key=lambda t: t[0])
        print(f"SSE ratio K_best->K_best+1: {sse_best/sse2:.3f}")

    order = np.argsort(np.exp(lt_b))
    taus = np.exp(lt_b)[order]
    amps_out = amps[:, order].T                   # (K modes) x (M curves)
    os.makedirs(OUT_DIR, exist_ok=True)
    header = "tau," + ",".join(f"a_{m}" for m in range(M))
    with open(os.path.join(OUT_DIR, "modes.csv"), "w") as f:
        f.write(header + "\n")
        for k in range(K):
            f.write(",".join([f"{taus[k]:.6g}"] +
                             [f"{amps_out[k, m]:.6g}" for m in range(M)]) + "\n")

    meta = {
        "K": int(K), "tau": taus.tolist(), "phi": phi_b[order].tolist(),
        "a0": coeffs[:, 0].tolist(), "amplitudes": amps_out.tolist(),
        "sse": sse_best, "rms_total": float(np.sqrt(sse_best / n_total)),
        "rms_re": float(rms_re), "rms_im": float(rms_im),
        "bic_table": [dict(K=int(t[0]), sse=t[1], rms=t[2], params=t[3],
                           bic=t[4]) for t in table],
        "starts_within_1pct_of_best": int(n_sse),
        "n_starts_total": int(len(all_found[K_best])),
        "log_tau_spread_matching_starts": spread_lt,
        "phi_spread_matching_starts": spread_phi,
        "matching_starts_log_tau_spread_note": "spread across starts, per mode, modes ordered by tau",
        "n_starts": int(len(all_found[K_best])),
        "collapsed_modes": np.where(collapse)[0].tolist(),
        "resid_lag1_autocorr": ac,
    }
    with open(os.path.join(OUT_DIR, "fit_summary.json"), "w") as f:
        json.dump(meta, f, indent=2)
    print("wrote results/modes.csv and results/fit_summary.json")
    print("a0 per curve:", np.round(coeffs[:, 0], 4).tolist())
    print("phi:", np.round(phi_b[order], 4).tolist())
    print("tau:", np.array2string(taus, precision=5))


if __name__ == "__main__":
    main()
