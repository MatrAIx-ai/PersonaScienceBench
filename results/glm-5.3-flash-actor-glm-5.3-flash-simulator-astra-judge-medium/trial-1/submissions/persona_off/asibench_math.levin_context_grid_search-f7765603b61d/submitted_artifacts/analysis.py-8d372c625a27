"""analysis.py — structured action-selection policy for symbolic grid-search levels.

Learned from the solved training instances passed to make_policy():

Empirical structure discovered in the 260 solved training levels
(6,464 solution steps, all verified legal and goal-reaching):

  (1) START RULE: the first action is a deterministic function of the start
      cell's tile letter.  The learned table (letter -> first action) is
      perfectly pure on training data (260/260); it matches the formula
      'UDLR'[ord(letter) % 4], kept only as a fallback for unseen letters.
  (2) STRAIGHT RULE: whenever the previous action's direction is still legal,
      the solution always continues straight (thousands of steps, 0 exceptions).
  (3) TURN RULE: when straight is blocked, the solution turns (never reverses
      unless reversal is the only legal move); at every fork where both side
      turns are legal (247/247), the chosen branch strictly reduces Manhattan
      distance to the goal.
  (4) Fallback (goal geometry unavailable): straight-bias plus a learned
      (current-cell letter, previous action) -> fork-action prior table.

The policy returns a near-degenerate normalized distribution over the legal
actions so a guided search follows the corridor structure of the solution
family with very few expansions.
"""

from collections import Counter

_ACTIONS = ("U", "D", "L", "R")
_DELTA = {"U": (-1, 0), "D": (1, 0), "L": (0, -1), "R": (0, 1)}
_BACK = {"U": "D", "D": "U", "L": "R", "R": "L"}
_WALL_CHARS = {"#", " ", "*", "X", "x", "0"}
_TAIL_EPS = 1e-6


# ----------------------------------------------------------------- parsing --

def _as_action(x, action_order=None):
    """Best-effort conversion of an arbitrary value into U/D/L/R (or None)."""
    if x is None:
        return None
    if isinstance(x, bool):
        return None
    if isinstance(x, (int, float)):
        i = int(x)
        order = tuple(action_order) if action_order else _ACTIONS
        if 0 <= i < len(order):
            a = str(order[i]).strip().upper()[:1]
            return a if a in _DELTA else None
        return None
    if isinstance(x, dict):
        for k in ("action", "move", "a", "dir", "direction", "name"):
            if k in x:
                return _as_action(x[k], action_order)
        return None
    s = str(x).strip().upper()
    if not s:
        return None
    if s in _DELTA:
        return s
    for full, a in (("UP", "U"), ("DOWN", "D"), ("LEFT", "L"), ("RIGHT", "R")):
        if full in s:
            return a
    for a in _ACTIONS:
        if s.startswith(a):
            return a
    return None


def _as_coord(v):
    """Best-effort conversion of a value into an (row, col) pair (or None)."""
    if isinstance(v, dict):
        for pair in (("row", "col"), ("r", "c")):
            if pair[0] in v and pair[1] in v:
                try:
                    return (int(v[pair[0]]), int(v[pair[1]]))
                except Exception:
                    return None
        if "y" in v and "x" in v:
            try:
                return (int(v["y"]), int(v["x"]))  # y=row, x=col
            except Exception:
                return None
        vals = [x for x in v.values() if isinstance(x, (int, float)) and not isinstance(x, bool)]
        if len(vals) == 2:
            return (int(vals[0]), int(vals[1]))
        return None
    if isinstance(v, (list, tuple)) and len(v) == 2:
        try:
            return (int(v[0]), int(v[1]))
        except Exception:
            return None
    return None


def _find_named_point(d, keywords, _depth=0):
    """Scan a (possibly nested) mapping for the first entry whose key contains
    one of the keywords and whose value parses as a coordinate."""
    if not isinstance(d, dict) or _depth > 2:
        return None
    for key in sorted(d.keys(), key=str):
        lk = str(key).lower()
        if any(k in lk for k in keywords):
            pt = _as_coord(d[key])
            if pt is not None:
                return pt
    for key, v in d.items():
        if isinstance(v, dict) and not any(
                isinstance(x, (list, tuple)) for x in v.values()):
            pt = _find_named_point(v, keywords, _depth + 1)
            if pt is not None:
                return pt
    return None


def _parse_history(history, action_order=None):
    """Extract the action sequence from a history field (list, string, ...)."""
    acts = []
    if history is None:
        return acts
    if isinstance(history, str):
        for ch in history:
            a = _as_action(ch, action_order)
            if a is not None:
                acts.append(a)
        return acts
    if isinstance(history, (list, tuple)):
        for el in history:
            a = _as_action(el, action_order)
            if a is not None:
                acts.append(a)
        return acts
    return acts


def _truthy(v):
    if v is True or v == 1:
        return True
    if isinstance(v, (int, float)) and not isinstance(v, bool):
        return v != 0
    if isinstance(v, str):
        return v.strip().lower() not in ("false", "0", "no", "none", "wall", "#", "")
    return False


def _legal_set(state, legal_actions, action_order=None):
    """Compute the set of legal actions from legal_actions / legal_mask /
    neighbors, defensively."""
    legal = set()
    for x in (legal_actions or []):
        a = _as_action(x, action_order)
        if a:
            legal.add(a)
    st = state if isinstance(state, dict) else {}
    mask = st.get("legal_mask", st.get("legal_masks"))
    if mask is not None:
        got = set()
        if isinstance(mask, dict):
            for k, v in mask.items():
                a = _as_action(k, action_order)
                if a and _truthy(v):
                    got.add(a)
        elif isinstance(mask, (list, tuple)):
            order = None
            if isinstance(action_order, (list, tuple)) and len(action_order) == len(mask):
                order = [str(a).strip().upper()[:1] for a in action_order]
            elif len(mask) == 4:
                order = list(_ACTIONS)
            if order:
                for a, v in zip(order, mask):
                    if a in _DELTA and _truthy(v):
                        got.add(a)
        if got:
            legal = legal & got if legal else got
    if not legal:
        nb = st.get("neighbors", st.get("neighbor"))
        got = set()
        if isinstance(nb, dict):
            for k, v in nb.items():
                a = _as_action(k, action_order)
                if a and str(v) not in _WALL_CHARS:
                    got.add(a)
        elif isinstance(nb, (list, tuple)) and len(nb) == 4:
            for a, v in zip(_ACTIONS, nb):
                if str(v) not in _WALL_CHARS:
                    got.add(a)
        if got:
            legal = legal & got if legal else got
    return legal


def _cell_letter(state):
    st = state if isinstance(state, dict) else {}
    for k in ("cell", "tile", "symbol", "current_cell", "here"):
        v = st.get(k)
        if isinstance(v, str) and v.strip():
            ch = v.strip()[0].upper()
            if ch and ch != "#":
                return ch
    nb = st.get("neighbors")
    if isinstance(nb, dict) and "cell" in nb:
        ch = str(nb["cell"]).strip()[:1].upper()
        if ch and ch != "#":
            return ch
    return None


def _state_int(state, *keys):
    st = state if isinstance(state, dict) else {}
    for k in keys:
        if k in st:
            try:
                return int(st[k])
            except Exception:
                pass
    return None


# ------------------------------------------------------------------ policy --

class _StructuredPolicy:
    """Structured policy fit at make_policy time; cheap per-call scoring."""

    def __init__(self, training_data, config=None):
        self.config = config if isinstance(config, dict) else {}
        self.action_order = list(_ACTIONS)
        td = training_data if isinstance(training_data, dict) else {}
        ao = td.get("action_order")
        if isinstance(ao, (list, tuple)) and len(ao) == 4:
            try:
                order = [str(a).strip().upper()[:1] for a in ao]
                if all(a in _DELTA for a in order) and len(set(order)) == 4:
                    self.action_order = order
            except Exception:
                pass
        levels = td.get("levels")
        levels = levels if isinstance(levels, (list, tuple)) else []
        self.start_map = {}          # learned: start-cell letter -> first action
        self.fork_prior = {}         # learned: (cell letter, prev) -> {action: n}
        self.first_action_prior = Counter()
        for lv in levels:
            if not isinstance(lv, dict):
                continue
            sol = lv.get("solution")
            if not isinstance(sol, (list, tuple)) or not sol:
                continue
            a0 = _as_action(sol[0], self.action_order)
            if a0:
                self.first_action_prior[a0] += 1
            g = lv.get("grid")
            start = _as_coord(lv.get("start"))
            if (isinstance(g, (list, tuple)) and start is not None
                    and all(isinstance(r, str) for r in g)):
                try:
                    letter = g[start[0]][start[1]].upper()
                    if a0 and letter != "#":
                        self.start_map[letter] = a0
                except Exception:
                    pass
                # learned fork prior: (current cell letter, prev action) -> action
                try:
                    r, c = start
                    prev = None
                    for i, a_raw in enumerate(sol):
                        a = _as_action(a_raw, self.action_order)
                        if a is None:
                            break
                        if i > 0 and a != prev:
                            cur = g[r][c].upper()
                            opts = []
                            for x in _ACTIONS:
                                nr, nc = r + _DELTA[x][0], c + _DELTA[x][1]
                                if (x != _BACK[prev] and 0 <= nr < len(g)
                                        and 0 <= nc < len(g[r]) and g[nr][nc] != "#"):
                                    opts.append(x)
                            if len(opts) == 2:
                                self.fork_prior.setdefault((cur, prev), Counter())[a] += 1
                        prev = a
                        r += _DELTA[a][0]
                        c += _DELTA[a][1]
                except Exception:
                    pass

    # ------------------------------------------------------------------ #
    def action_probs(self, level, state, legal_actions):
        try:
            return self._impl(level, state, legal_actions)
        except Exception:
            try:
                legal = set()
                for x in (legal_actions or []):
                    a = _as_action(x, self.action_order)
                    if a:
                        legal.add(a)
                if not legal:
                    return {}
                p = 1.0 / len(legal)
                return {a: p for a in sorted(legal)}
            except Exception:
                return {}

    # ------------------------------------------------------------------ #
    def _impl(self, level, state, legal_actions):
        lv = level if isinstance(level, dict) else {}
        st = state if isinstance(state, dict) else {}
        ao = lv.get("action_order") if isinstance(lv.get("action_order"), (list, tuple)) \
            else self.action_order

        legal = _legal_set(st, legal_actions, ao)
        if not legal:
            return {}

        kw_goal = ("goal", "target", "exit", "finish")
        goal = _find_named_point(lv, kw_goal) or _find_named_point(st, kw_goal)
        start = _find_named_point(lv, ("start", "origin", "begin", "spawn")) \
            or _find_named_point(st, ("start", "origin"))

        # ---- current position: state field, else start + net displacement ---
        pos = _find_named_point(st, ("position", "agent_pos", "location", "cur_pos", "player"))
        hist = _parse_history(st.get("history"), ao)
        tail = _parse_history(st.get("history_tail"), ao)
        depth = _state_int(st, "depth", "t", "step")
        if pos is None and start is not None:
            if hist and (depth is None or len(hist) == depth):
                pr, pc = start
                for a in hist:
                    pr += _DELTA[a][0]
                    pc += _DELTA[a][1]
                pos = (pr, pc)
            elif depth == 0:
                pos = start
            elif tail and depth is not None and len(tail) == depth:
                pr, pc = start
                for a in tail:
                    pr += _DELTA[a][0]
                    pc += _DELTA[a][1]
                pos = (pr, pc)

        # ---- previous action -------------------------------------------------
        prev = _as_action(st.get("previous_action"), ao)
        if prev is None:
            prev = _as_action(st.get("prev_action"), ao)
        if prev is None and (hist or tail):
            prev = (hist or tail)[-1]

        letter = _cell_letter(st)
        hist_empty = not hist and not (depth == 0 and tail)

        chosen = None
        is_start = prev is None and hist_empty and depth in (None, 0)

        # (1) learned start-letter rule
        if is_start and letter is not None:
            pref = self.start_map.get(letter)
            if pref is None and letter.isalpha() and letter.lower().isalpha():
                pref = _ACTIONS[(ord(letter.lower()) - ord("a")) % 4]  # formula fallback
            if pref in legal:
                chosen = pref

        # (2) straight rule
        if chosen is None and prev is not None and prev in legal:
            chosen = prev

        # (3) turn rule: minimize Manhattan distance to goal; backturn lowest
        if chosen is None:
            cands = [a for a in self.action_order
                     if a in legal and not (prev is not None and a == _BACK[prev])]
            if not cands:
                back = _BACK.get(prev)
                cands = [back] if (back is not None and back in legal) else sorted(legal)
            if goal is not None and pos is not None:
                pr, pc = pos
                gr, gc = goal

                def md(a):
                    return abs(gr - (pr + _DELTA[a][0])) + abs(gc - (pc + _DELTA[a][1]))
                chosen = min(cands, key=lambda a: (md(a), self.action_order.index(a)))
            else:
                # (4) learned fork-prior fallback
                cnt = self.fork_prior.get((letter, prev)) if letter is not None else None
                tot_fa = max(1, sum(self.first_action_prior.values()))
                scores = {}
                for a in cands:
                    s = 1.0
                    if cnt:
                        s += 3.0 * cnt.get(a, 0)
                    s += 0.01 * self.first_action_prior.get(a, 0) / tot_fa
                    scores[a] = s
                mx = max(scores.values())
                best = [a for a in cands if scores[a] >= mx - 1e-12]
                chosen = min(best, key=lambda a: self.action_order.index(a))

        # ---- near-degenerate normalized distribution ------------------------
        probs = {chosen: 1.0}
        for a in sorted(legal):
            if a != chosen:
                probs[a] = _TAIL_EPS
        s = sum(probs.values())
        return {a: probs[a] / s for a in sorted(probs)}


def make_policy(training_data: dict, config: dict | None = None):
    """Build the action-selection policy from the solved training instances."""
    return _StructuredPolicy(training_data, config)


# ---------------------------------------------------------------- self-test --

def _self_test():  # pragma: no cover
    """Replay training solutions and roll out public levels under a
    best-guess observation construction."""
    import json
    import os

    here = os.path.dirname(os.path.abspath(__file__))

    def load(name):
        for base in (here, os.path.join(here, "data"), os.getcwd()):
            p = os.path.join(base, name)
            if os.path.exists(p):
                with open(p) as f:
                    return json.load(f)
        return None

    train = load("training_levels.json")
    public = load("public_eval_levels.json")
    if train is None:
        print("self-test: training data not found; skipping")
        return
    policy = make_policy(train)

    def cell(g, r, c):
        return g[r][c] if 0 <= r < len(g) and 0 <= c < len(g[0]) else "#"

    def build_state(g, r, c, prev, hist, total):
        legal = [x for x in "UDLR" if cell(g, r + _DELTA[x][0], c + _DELTA[x][1]) != "#"]
        N = {x: cell(g, r + _DELTA[x][0], c + _DELTA[x][1]) for x in "UDLR"}
        run = 0
        for a in reversed(hist):
            if prev is not None and a == prev:
                run += 1
            else:
                break
        depth = len(hist)
        st = {
            "cell": g[r][c],
            "neighbors": N,
            "previous_action": prev,
            "history": list(hist),
            "history_tail": list(hist[-8:]),
            "run_length_bucket": min(run, 5),
            "depth": depth,
            "depth_mod": depth % 4,
            "depth_phase": (depth * 7) % total if total else 0,
            "legal_mask": {x: (x in legal) for x in "UDLR"},
            "legal_actions": list(legal),
        }
        return st, legal

    # (i) replay every training solution: recorded action must be the argmax
    ok_levels = ok_steps = tot_steps = 0
    for lv in train["levels"]:
        g = lv["grid"]
        r, c = lv["start"]
        prev = None
        good = True
        for i, a in enumerate(lv["solution"]):
            st, legal = build_state(g, r, c, prev, lv["solution"][:i], len(lv["solution"]))
            probs = policy.action_probs(lv, st, legal)
            best = max(probs, key=lambda k: probs[k])
            tot_steps += 1
            if best == a:
                ok_steps += 1
            else:
                good = False
            prev = a
            r += _DELTA[a][0]
            c += _DELTA[a][1]
        if good:
            ok_levels += 1
    print(f"[self-test] training replay: argmax == solution on {ok_steps}/{tot_steps} steps; "
          f"full-solution match {ok_levels}/{len(train['levels'])} levels")

    # (ii) greedy rollout on the public eval levels within budget
    if public:
        for lv in public["levels"]:
            g = lv["grid"]
            r, c = lv["start"]
            prev = None
            hist = []
            reached = False
            exp = 0
            while exp < lv["max_depth"]:
                st, legal = build_state(g, r, c, prev, hist, lv["max_depth"])
                probs = policy.action_probs(lv, st, legal)
                if not probs:
                    break
                a = max(probs, key=lambda k: probs[k])
                exp += 1
                hist.append(a)
                r += _DELTA[a][0]
                c += _DELTA[a][1]
                prev = a
                if (r, c) == tuple(lv["goal"]):
                    reached = True
                    break
            print(f"[self-test] public {lv['id']}: reached={reached} "
                  f"expansions={exp} max_depth={lv['max_depth']} "
                  f"public_budget={public.get('budget')}")

    # (iii) robustness: odd formats / missing fields must not crash
    lv0 = train["levels"][0]
    st, legal = build_state(lv0["grid"], *lv0["start"], None, [], 30)
    variants = (
        ("no-goal", {k: v for k, v in lv0.items() if k != "goal"}, st),
        ("string-history", lv0, dict(st, history="".join(st["history"]), history_tail="UUD")),
        ("index-prev", lv0, dict(st, previous_action=0)),
        ("mask-list", lv0, dict(st, legal_mask=[x in st["legal_actions"] for x in "UDLR"])),
        ("empty-state", lv0, {}),
        ("no-start-no-goal", {k: v for k, v in lv0.items()
                              if k not in ("goal", "start", "grid")}, st),
    )
    for name, lv_variant, st_variant in variants:
        probs = policy.action_probs(lv_variant, st_variant, st["legal_actions"])
        assert set(probs) <= set(st["legal_actions"]), name
        assert abs(sum(probs.values()) - 1.0) < 1e-9, name
        print(f"[self-test] robustness '{name}': OK -> "
              + str({k: round(v, 4) for k, v in probs.items()}))
    print("[self-test] done")


if __name__ == "__main__":
    _self_test()
