"""
Solve a*sigma(n) = b*n + c for all integers 1 <= n <= U, where sigma(n) is
the sum-of-divisors function.

Primary engine (structure-aware search, no bulk precompute-and-scan):
    Depth-first search over the multiplicative structure of n.  n is built as
    a product of prime powers taken in strictly decreasing prime order,
    carrying (n0, s0 = sigma(n0)).  The remaining factor m must satisfy

        a*s0*sigma(m) = b*n0*m + c ,    1 <= m <= M = U // n0,

    where every prime factor of m is smaller than the last prime used.  For
    m >= 2 the following rigorous bounds produce an integer feasibility
    interval [m_lo, m_hi] for m; an empty interval prunes the branch:

        sigma(m) >= m + 1
            =>  (b*n0 - a*s0)*m >= a*s0 - c
        sigma(m) <= R*m,  R = maximal prod q/(q-1) over a prefix of the
            available primes whose primorial is <= M
            =>  (b*n0 - a*s0*R)*m <= c

    Additionally, since sigma(m') is an integer, the child equation
    a*s0*sp*sigma(m') = b*n1*m' + c requires the congruence
    b*n1*m' = -c (mod a*s0*sp) to be solvable, i.e.
    gcd(b*n1, a*s0*sp) must divide c -- a cheap per-branch filter.

Fast path / safety fallback: an O(U) linear (smallest-prime-factor) sigma
sieve plus a linear scan.  It is used when U <= SMALL_U_CUTOFF (where it is
the genuinely cheaper tool) and as a fallback if the DFS ever exceeds
DFS_TIME_GUARD seconds.

Self-contained: Python standard library only.
"""

import json
import math
import sys
import time
from array import array

# --------------------------------------------------------------------------
# Tunables
# --------------------------------------------------------------------------
SMALL_U_CUTOFF = 50_000          # sieve is the cheaper tool at this scale
DFS_TIME_GUARD = 45.0            # seconds; on trip -> sieve fallback
SIEVE_FALLBACK_MAX = 20_000_000  # largest U for which the fallback sieve fits

# Diagnostics of the most recent solve() call (engine, nodes, seconds, ...).
last_stats = {}


# --------------------------------------------------------------------------
# O(U) linear sieve for sigma (small-U fast path, fallback, validation)
# --------------------------------------------------------------------------
def _sigma_sieve(U):
    if U > 2_000_000:
        sig = array('q', bytes(8 * (U + 1)))
        pp = array('q', bytes(8 * (U + 1)))
    else:
        sig = [0] * (U + 1)
        pp = [0] * (U + 1)
    primes = []
    sig[1] = 1
    for i in range(2, U + 1):
        if sig[i] == 0:                      # i is prime
            primes.append(i)
            sig[i] = i + 1
            pp[i] = i + 1
        for p in primes:
            ip = i * p
            if ip > U:
                break
            if i % p == 0:
                pp[ip] = pp[i] * p + 1       # sigma(p^(k+1))
                sig[ip] = pp[ip] * (sig[i] // pp[i])
                break
            else:
                sig[ip] = sig[i] * (p + 1)   # sigma(p^1) factor
                pp[ip] = p + 1
    return sig


def _primes_upto(n):
    sieve = bytearray([1]) * (n + 1)
    sieve[0:2] = b'\x00\x00'
    i = 2
    while i * i <= n:
        if sieve[i]:
            step = sieve[i * i:: i]
            sieve[i * i:: i] = bytearray(len(step))
        i += 1
    return [i for i in range(2, n + 1) if sieve[i]]


# --------------------------------------------------------------------------
# Structure-aware DFS with rigorous interval pruning
# --------------------------------------------------------------------------
class _DfsTimeout(Exception):
    pass


def _dfs_search(a, b, c, U, deadline=None):
    """Return (sorted list of solutions, node count).  May raise _DfsTimeout."""
    sys.setrecursionlimit(100000)
    primes = _primes_upto(U + 1)
    nprimes = len(primes)

    # Prefix products over the smallest primes:
    #   Ppre[k] = product of first k primes, Rpre[k] = prod q/(q-1).
    # For m composed of the first pidx primes with m <= M, the maximum of
    # sigma(m)/m is achieved by the longest such prefix (each factor q/(q-1)
    # is > 1 and decreasing in q, so prefixes maximize the product).
    Rpre = [1.0]
    Ppre = [1]
    for q in primes:
        Ppre.append(Ppre[-1] * q)
        Rpre.append(Rpre[-1] * q / (q - 1))
        if Ppre[-1] > U:
            break
    K = len(Rpre)
    SAFETY = 1.0 + 1e-9   # inflate R slightly: overestimating R is sound

    def max_ratio(M, pidx):
        best = 1.0
        top = pidx if pidx < K - 1 else K - 1
        for k in range(1, top + 1):
            if Ppre[k] > M:
                break
            best = Rpre[k]
        return best * SAFETY

    sols = []
    nodes = [0]

    def rec(n0, s0, pidx, M):
        nodes[0] += 1
        if deadline is not None and (nodes[0] & 0x3FFF) == 0 \
                and time.monotonic() > deadline:
            raise _DfsTimeout
        # Leaf: remaining factor m = 1  =>  candidate n = n0.
        if a * s0 == b * n0 + c:
            sols.append(n0)
        if M < 2 or pidx == 0:
            return

        m_lo, m_hi = 2, M

        # (1) sigma(m) >= m + 1  =>  (b*n0 - a*s0)*m >= a*s0 - c
        D1 = b * n0 - a * s0
        need1 = a * s0 - c
        if D1 > 0:
            if need1 > 0:
                lo = -(-need1 // D1)             # ceil(need1 / D1)
                if lo > m_lo:
                    m_lo = lo
        elif D1 == 0:
            if need1 > 0:
                return
        else:  # D1 < 0:  m <= need1 / D1   (requires need1 <= 0)
            if need1 > 0:
                return
            hi = need1 // D1                     # floor(need1 / D1), D1 < 0
            if hi < m_hi:
                m_hi = hi

        # (2) sigma(m) <= R*m  =>  (b*n0 - a*s0*R)*m <= c
        R = max_ratio(M, pidx)
        D2 = b * n0 - a * s0 * R
        if D2 > 0:
            if c < 0:
                return
            hi = c // D2                         # floor(c / D2)
            if hi < m_hi:
                m_hi = hi
        elif D2 == 0:
            if c < 0:
                return
        else:  # D2 < 0:  m >= c / D2   (binding only when c < 0)
            if c < 0:
                lo = ((-c) + (-D2) - 1) // (-D2)  # ceil(c / D2), both negative
                if lo > m_lo:
                    m_lo = lo

        if m_lo > m_hi:
            return

        # Branch on the next (largest) prime p = primes[j], exponent e >= 1.
        for j in range(pidx):
            p = primes[j]
            if p > m_hi:
                break
            pe = p
            sp = p + 1                            # sigma(p^1)
            while pe <= m_hi:
                # necessary: exists m' with pe*m' in [m_lo, m_hi]
                if pe * (m_hi // pe) >= m_lo:
                    n1 = n0 * pe
                    s1 = s0 * sp
                    # congruence filter: b*n1*m' = -c (mod a*s1) must be
                    # solvable in m'  <=>  gcd(b*n1, a*s1) divides c
                    m2 = a * s1
                    if c % math.gcd(b * n1 % m2 or m2, m2) == 0:
                        rec(n1, s1, j, m_hi // pe)
                pe *= p
                sp = (pe * p - 1) // (p - 1)      # sigma(p^(e+1))

    rec(1, 1, nprimes, U)
    sols.sort()
    return sols, nodes[0]


# --------------------------------------------------------------------------
# Public entry point
# --------------------------------------------------------------------------
def solve(a: int, b: int, c: int, U: int) -> list:
    """Return the ascending list of all n in [1, U] with a*sigma(n) = b*n + c."""
    t0 = time.monotonic()
    a, b, c, U = int(a), int(b), int(c), int(U)
    stats = {"engine": None, "nodes": 0, "seconds": 0.0, "fallback": False}

    if U < 1:
        stats["engine"] = "empty-domain"
        last_stats.clear()
        last_stats.update(stats)
        return []

    # Normalize the sign of a (multiplying the whole equation by -1).
    if a < 0:
        a, b, c = -a, -b, -c

    # Degenerate case a = 0:  b*n + c = 0 (a linear condition on n).
    if a == 0:
        if b == 0:
            res = list(range(1, U + 1)) if c == 0 else []
        else:
            if c % b == 0:
                n = -(c // b)
                res = [n] if 1 <= n <= U else []
            else:
                res = []
        stats["engine"] = "linear(a=0)"
        stats["seconds"] = time.monotonic() - t0
        last_stats.clear()
        last_stats.update(stats)
        return res

    # Necessary congruence condition: b*n = -c (mod a) solvable
    # <=> gcd(b, a) divides c.
    if c % math.gcd(b, a) != 0:
        stats["engine"] = "congruence-filter"
        stats["seconds"] = time.monotonic() - t0
        last_stats.clear()
        last_stats.update(stats)
        return []

    def sieve_result():
        sig = _sigma_sieve(U)
        return [n for n in range(1, U + 1) if a * sig[n] == b * n + c]

    if U <= SMALL_U_CUTOFF:
        res = sieve_result()
        stats["engine"] = "sieve"
    else:
        try:
            res, nodes = _dfs_search(a, b, c, U,
                                     deadline=t0 + DFS_TIME_GUARD)
            stats["engine"] = "dfs"
            stats["nodes"] = nodes
        except _DfsTimeout:
            # Safety fallback: exhaustive sieve (only for feasible U).
            if U <= SIEVE_FALLBACK_MAX:
                res = sieve_result()
                stats["engine"] = "dfs->sieve-fallback"
                stats["fallback"] = True
            else:
                res, nodes = _dfs_search(a, b, c, U, deadline=None)
                stats["engine"] = "dfs-unguarded"
                stats["nodes"] = nodes

    stats["seconds"] = time.monotonic() - t0
    last_stats.clear()
    last_stats.update(stats)
    return res


# --------------------------------------------------------------------------
# Batch driver: build the two required CSVs from data/problem_instances.json
# --------------------------------------------------------------------------
def main():
    with open("data/problem_instances.json", "r") as fh:
        instances = json.load(fh)["instances"]

    solutions_rows = []
    summary_rows = []
    print(f"{'instance':<16}{'split':<13}{'engine':<24}"
          f"{'nodes':>10}{'sec':>9}  {'count':>6}  largest")
    for rec in sorted(instances, key=lambda r: r["instance_id"]):
        res = solve(rec["a"], rec["b"], rec["c"], rec["U"])
        st = dict(last_stats)
        solutions_rows.extend((rec["instance_id"], n) for n in res)
        summary_rows.append((rec["instance_id"], len(res),
                             res[-1] if res else 0))
        print(f"{rec['instance_id']:<16}{rec['split']:<13}"
              f"{st.get('engine', '?'):<24}{st.get('nodes', 0):>10}"
              f"{st.get('seconds', 0.0):>9.2f}  {len(res):>6}  "
              f"{res[-1] if res else 0}")

    with open("results/solutions.csv", "w", newline="") as fh:
        fh.write("instance_id,n\n")
        for iid, n in solutions_rows:
            fh.write(f"{iid},{n}\n")
    with open("results/instance_summary.csv", "w", newline="") as fh:
        fh.write("instance_id,solution_count,largest_solution\n")
        for iid, cnt, largest in summary_rows:
            fh.write(f"{iid},{cnt},{largest}\n")
    print(f"\nwrote results/solutions.csv ({len(solutions_rows)} rows) and "
          f"results/instance_summary.csv ({len(summary_rows)} rows)")


if __name__ == "__main__":
    main()
