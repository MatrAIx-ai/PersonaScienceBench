#!/usr/bin/env python3
"""
Threshold and scaling analysis of the asymmetric, parity-modulated 1D
birth-death lattice process defined SOLELY by ./data/task_input.json.

Model (exactly as specified by the input contract):
  - binary sites {0,1}, fully-inactive absorbing state, periodic BC, size L
  - initial condition: fully active for every trajectory
  - random-sequential updates; one sweep = L random site visits (with
    replacement, i.e. i.i.d. uniform site draws -- the literal reading of
    "L random site visits"); time t counts sweeps, t = 1..t_max
  - active site visited: dies with probability dt
  - inactive site i visited:
        p_birth = min(1, lambda*dt*parity_scale(i)*
                         (left_weight*x[i-1] + right_weight*x[i+1]))
    with left = (i-1) mod L, right = (i+1) mod L (0-based indexing;
    both conventions are immaterial by lattice symmetry for even L),
    left_weight = 1.0, right_weight = 0.85,
    parity_scale(even site) = 1.04, parity_scale(odd site) = 0.96.
  - rho(t) and survival recorded once per sweep for t = 1..t_max;
    trajectories freeze at rho = 0 after absorption (exact absorbing state).

All randomness derives deterministically from protocol.seed via
SeedSequence spawn children mapped to (lambda index, size index).

Threshold strategy (why): at t_max=1000 every scanned lambda still shows
metastable survival, so the classic finite-size ordering flip of rho_ss is
uninformative (extinction dilution at small L mimics the subcritical side).
The in-protocol observable that separates the phases is the late-time
decay rate gamma(lambda) = -d ln rho / dt over the second half of t_max:
gamma -> 0 at the threshold and grows ~ linearly below it. gamma is
estimated per size and fitted jointly with a shared threshold
gamma_{i,lam} = m_i * max(0, lam_c - lam) + c, where the constant c
absorbs the critical power-law background (rho ~ t^-delta gives an
apparent log-slope ~ delta/t inside a fixed window). The rho_ss ordering
crossing is still computed and reported as a secondary diagnostic.
"""

import json
import time
from pathlib import Path

import numpy as np
import pandas as pd

DATA_PATH = Path("data/task_input.json")
OUT_DIR = Path("results")

# Fixed analysis meta-parameters (documented, not part of the input contract)
RHO_WINDOW_FRAC = 0.20       # rho_ss = mean rho over last 20% of t_max
GAMMA_WINDOW = (500, 1000)   # [lo, hi) index window for late-time log-slope
GAMMA_FIT_SIZES = (64, 128, 256)  # L=32 excluded: extinction dilution corrupts
                              # its late-time log-slopes (reported anyway)
N_BOOTSTRAP = 500            # seed-resampling replicates
LC_GRID = (1.60, 2.00, 0.005)     # lambda_c candidates for the gamma fit
C_GRID = (0.0, 8e-4, 9)           # power-law background offsets
BETA_SENS = 0.01             # lambda_c sensitivity shift for beta
TAU_T_REF = 100              # reference time for tau_half
DELTA_FIT_T_MIN = 100        # log-log fit window for delta starts here
Z_R2_MIN = 0.90              # R^2 required to declare tau ~ L^z resolved
BETA_DP_REF = 0.2764         # reference 1+1 DP beta (sanity anchor only)


def load_input(path=DATA_PATH):
    # utf-8-sig transparently handles both plain UTF-8 and UTF-8-SIG (BOM)
    with open(path, "r", encoding="utf-8-sig") as fh:
        return json.load(fh)


def simulate_group(lam, L, n_seeds, t_max, rng,
                   dt, w_left, w_right, s_even, s_odd):
    """Run n_seeds independent trajectories for t_max sweeps.

    Returns rho of shape (t_max, n_seeds): density after each sweep.
    Dead trajectories stay exactly zero (absorbing state), so no explicit
    freezing bookkeeping is needed.
    """
    x = np.ones((n_seeds, L), dtype=bool)
    rows = np.arange(n_seeds)
    scale = np.where(np.arange(L) % 2 == 0, s_even, s_odd)
    rho = np.empty((t_max, n_seeds), dtype=np.float64)

    for t in range(t_max):
        # pre-drawn RNG blocks for this sweep: L i.i.d. uniform site visits
        # per trajectory (with replacement); one uniform per visit reused for
        # whichever branch applies (death if active, birth if inactive).
        idx = rng.integers(0, L, size=(n_seeds, L))
        u = rng.random((n_seeds, L))
        for j in range(L):
            sites = idx[:, j]
            cur = x[rows, sites]
            uj = u[:, j]
            die = cur & (uj < dt)
            if die.any():
                x[rows[die], sites[die]] = False
            left = x[rows, sites - 1]
            right = x[rows, (sites + 1) % L]   # wraparound indexing = periodic BC
            p = lam * dt * scale[sites] * (w_left * left + w_right * right)
            birth = (~cur) & (uj < p)
            if birth.any():
                x[rows[birth], sites[birth]] = True
        rho[t] = x.mean(axis=1)
    return rho


# ----------------------------------------------------------------------------
# Estimators
# ----------------------------------------------------------------------------
def late_decay_rate(curve, lo, hi=GAMMA_WINDOW[1]):
    """gamma = -OLS slope of ln rho vs t over sweeps t in [lo+1, hi].
    curve is a seed-averaged density trace. Returns np.nan if fewer than
    10 positive points are available."""
    seg = np.asarray(curve[lo:hi], dtype=float)
    t = np.arange(lo + 1, hi + 1, dtype=float)
    ok = seg > 0
    if ok.sum() < 10:
        return np.nan
    y = np.log(seg[ok])
    slope = np.polyfit(t[ok], y, 1)[0]
    return float(-slope)


def fit_threshold_gamma(lambdas, gamma, sizes_fit,
                        lc_grid=LC_GRID, c_grid=C_GRID):
    """Joint fit gamma[i, k] = m_i * max(0, lam_c - lam_k) + c with shared
    lam_c, c >= 0 and per-size slopes m_i >= 0. Returns
    (lam_c, c, {size: m}, sse)."""
    lam = np.asarray(lambdas, dtype=float)
    best = (np.inf, np.nan, None, np.inf)
    for lc in np.arange(*lc_grid):
        d = np.maximum(lc - lam, 0.0)
        denom = float((d * d).sum())
        for c in np.linspace(*c_grid):
            sse = 0.0
            ms = {}
            for L in sizes_fit:
                y = gamma[L]
                m = float((d * (y - c)).sum() / denom) if denom > 0 else 0.0
                m = max(m, 0.0)
                sse += float(((y - (m * d + c)) ** 2).sum())
                ms[L] = m
            if sse < best[0]:
                best = (sse, float(lc), c, ms)
    return best[1], best[2], best[3], best[0]


def crossing_lambda(rho32, rho256, lambdas):
    """Secondary diagnostic: lambda_c from the sign change of
    rho_ss(L=32) - rho_ss(L=256). Returns (estimate, censored_flag, note)."""
    d = rho32 - rho256
    for i in range(len(lambdas) - 1):
        if d[i] > 0.0 and d[i + 1] <= 0.0:
            lam_c = lambdas[i] + (lambdas[i + 1] - lambdas[i]) * d[i] / (d[i] - d[i + 1])
            return float(lam_c), False, ("interior bracket between %g and %g"
                                         % (lambdas[i], lambdas[i + 1]))
    if d[0] <= 0.0:
        return float(lambdas[0]), True, ("censored: rho32 <= rho256 at the lowest scanned "
                                         "lambda (no ordering flip anywhere in the scan)")
    return float(lambdas[-1]), True, "censored: no ordering flip up to highest scanned lambda"


def pooled_beta_fit(rho_beta, lambdas_beta, lam_c):
    """Fit log rho_ss = a_size + beta*log(lambda - lam_c) with shared beta and
    per-size intercepts. rho_beta shape (n_beta_lambdas, n_sizes).
    Points with rho <= 0 are masked. Returns (beta, per_size_betas, sse)."""
    n_b, n_s = rho_beta.shape
    if not np.all(np.asarray(lambdas_beta) > lam_c):
        return np.nan, [np.nan] * n_s, np.inf
    xlog = np.log(np.asarray(lambdas_beta) - lam_c)
    X, y = [], []
    for bi in range(n_b):
        for si in range(n_s):
            if rho_beta[bi, si] > 0:
                X.append((bi, si))
                y.append(np.log(rho_beta[bi, si]))
    if len(y) < n_s + 1:                     # need >= 1 intercept + slope dof
        return np.nan, [np.nan] * n_s, np.inf
    y = np.array(y)
    n_s_tot = n_s
    Xd = np.zeros((len(y), 1 + n_s_tot))
    for k, (bi, si) in enumerate(X):
        Xd[k, 0] = xlog[bi]
        Xd[k, 1 + si] = 1.0
    coef, *_ = np.linalg.lstsq(Xd, y, rcond=None)
    sse = float(np.sum((y - Xd @ coef) ** 2))
    per_size = []
    A1 = np.column_stack([xlog, np.ones(n_b)])
    for si in range(n_s):
        col = rho_beta[:, si]
        if np.all(col > 0):
            c, *_ = np.linalg.lstsq(A1, np.log(col), rcond=None)
            per_size.append(float(c[0]))
        else:
            per_size.append(np.nan)
    return float(coef[0]), per_size, sse


def fit_delta(mean_curve, t_min=DELTA_FIT_T_MIN):
    """Best-effort critical decay exponent: rho(t) ~ t^-delta."""
    t = np.arange(1, len(mean_curve) + 1)
    mask = (t >= t_min) & (mean_curve > 0)
    if mask.sum() < 20:
        return np.nan
    x = np.log(t[mask])
    y = np.log(mean_curve[mask])
    slope, _ = np.polyfit(x, y, 1)
    return float(-slope)


def tau_half(mean_curve, t_ref=TAU_T_REF):
    """Characteristic decay time: first sweep t > t_ref where the
    seed-averaged rho falls below half of its value at t_ref (this skips the
    initial relaxation transient, which is L-independent). Returns
    (tau, censored_flag)."""
    ref = mean_curve[t_ref - 1]
    if not np.isfinite(ref) or ref <= 0:
        return np.nan, True
    below = np.where(mean_curve[t_ref:] < 0.5 * ref)[0]
    if len(below) == 0:
        return float(len(mean_curve)), True   # right-censored at t_max
    return float(t_ref + below[0]), False


def power_law_fit(sizes, taus):
    """log tau vs log L -> z with R^2."""
    x = np.log(np.asarray(sizes, dtype=float))
    y = np.log(np.asarray(taus, dtype=float))
    slope, intercept = np.polyfit(x, y, 1)
    pred = slope * x + intercept
    ss_res = float(np.sum((y - pred) ** 2))
    ss_tot = float(np.sum((y - y.mean()) ** 2))
    r2 = 1.0 - ss_res / ss_tot if ss_tot > 0 else 0.0
    return float(slope), float(r2)


# ----------------------------------------------------------------------------
# Main
# ----------------------------------------------------------------------------
def main():
    t_start = time.time()
    inp = load_input()
    proto = inp["protocol"]
    par = inp["parameterization"]

    lambdas = [float(v) for v in proto["lambda_scan"]]
    lambdas_beta = [float(v) for v in proto["beta_fit_lambdas"]]
    sizes = [int(v) for v in proto["system_sizes"]]
    n_seeds = int(proto["n_seeds"])
    t_max = int(proto["t_max"])
    proto_seed = int(proto["seed"])

    dt = float(par["dt"])
    w_left = float(par["left_neighbor_weight"])
    w_right = float(par["right_neighbor_weight"])
    s_even = float(par["site_parity_scale"]["even"])
    s_odd = float(par["site_parity_scale"]["odd"])
    assert par["boundary_condition"] == "periodic"
    assert par["update_scheme"] == "random_sequential"
    assert par["initial_condition"] == "fully_active_for_each_trajectory"
    task_id = inp["task_id"]

    OUT_DIR.mkdir(parents=True, exist_ok=True)

    n_l, n_s = len(lambdas), len(sizes)
    master = np.random.SeedSequence(proto_seed)
    children = master.spawn(n_l * n_s + 2)   # last two: supplementary diagnostics

    # ---- protocol scan -----------------------------------------------------
    rho_all = {}        # (li, si) -> (t_max, n_seeds) density trajectories
    t0 = time.time()
    for li, lam in enumerate(lambdas):
        for si, L in enumerate(sizes):
            rng = np.random.default_rng(children[li * n_s + si])
            rho_all[(li, si)] = simulate_group(
                lam, L, n_seeds, t_max, rng, dt, w_left, w_right, s_even, s_odd)
        print("[scan] lambda=%.3f done (%.1fs)" % (lam, time.time() - t0), flush=True)

    w0 = int(round(t_max * (1.0 - RHO_WINDOW_FRAC)))   # first index of late window
    rho_ss_cell = np.empty((n_l, n_s, n_seeds))        # per-seed late-window means
    surv_cell = np.empty((n_l, n_s, n_seeds))          # per-seed alive at t_max
    for li in range(n_l):
        for si in range(n_s):
            r = rho_all[(li, si)]
            rho_ss_cell[li, si] = r[w0:, :].mean(axis=0)
            surv_cell[li, si] = (r[-1, :] > 0).astype(float)
    rho_ss_mean = rho_ss_cell.mean(axis=2)
    surv_mean = surv_cell.mean(axis=2)

    pd.DataFrame([{"lambda": lambdas[li], "system_size": sizes[si],
                   "rho_ss": float(rho_ss_mean[li, si]),
                   "survival_prob": float(surv_mean[li, si]),
                   "n_runs": n_seeds}
                  for li in range(n_l) for si in range(n_s)]
                 ).to_csv(OUT_DIR / "dp_scan.csv", index=False)

    ts_rows = []
    for li, lam in enumerate(lambdas):
        for si, L in enumerate(sizes):
            r = rho_all[(li, si)]
            rho_t = r.mean(axis=1)
            sv_t = (r > 0).mean(axis=1)
            for t in range(t_max):
                ts_rows.append((lam, L, t + 1, rho_t[t], sv_t[t]))
    pd.DataFrame(ts_rows, columns=["lambda", "system_size", "time", "rho", "survival_prob"]
                 ).to_csv(OUT_DIR / "dp_timeseries.csv", index=False)
    print("[scan] CSVs written (%.1fs)" % (time.time() - t0), flush=True)

    # ---- supplementary long-budget diagnostic (clearly outside protocol) ----
    # purpose: bound the true threshold and prove that t_max=1000 resolves only
    # metastable dynamics. Same kernel, L=256, t=30000, 6 seeds, 2 lambdas.
    diag_t_max, diag_seeds = 20000, 6
    diag_marks = [5000, 10000, 20000]
    diag_configs = [1.742, 1.805]
    diag_results = []
    for k, lam in enumerate(diag_configs):
        rng = np.random.default_rng(children[n_l * n_s + k])
        r = simulate_group(lam, 256, diag_seeds, diag_t_max, rng,
                           dt, w_left, w_right, s_even, s_odd)
        for tm in diag_marks:
            diag_results.append({"lambda": lam, "system_size": 256, "time": tm,
                                 "rho": float(r[tm - 1].mean()),
                                 "survival_prob": float((r[tm - 1] > 0).mean())})
        print("[diag] lambda=%.3f done (%.1fs)" % (lam, time.time() - t0), flush=True)

    # ---- per-size late-time decay rates gamma(lambda) -----------------------
    gamma_mean = {L: np.array([late_decay_rate(rho_all[(li, si)].mean(axis=1), *GAMMA_WINDOW)
                                for li in range(n_l)])
                  for si, L in enumerate(sizes)}
    gamma_per_seed = {L: np.empty((n_l, n_seeds)) for L in sizes}
    for si, L in enumerate(sizes):
        for li in range(n_l):
            for s in range(n_seeds):
                gamma_per_seed[L][li, s] = late_decay_rate(
                    rho_all[(li, si)][:, s], *GAMMA_WINDOW)

    sizes_fit = [L for L in GAMMA_FIT_SIZES if L in sizes]
    lc_hat, c_hat, m_hat, sse_hat = fit_threshold_gamma(
        lambdas, gamma_mean, sizes_fit)
    print("[threshold] lam_c_hat=%.4f c=%.2e m=%s" % (lc_hat, c_hat, m_hat), flush=True)

    # bootstrap: resample seeds, recompute gamma traces, refit
    boot_rng = np.random.default_rng(np.random.SeedSequence(proto_seed).spawn(1)[0])
    boot_lc, boot_beta, boot_delta, boot_z = [], [], [], []
    bidx = [lambdas.index(v) for v in lambdas_beta]
    for b in range(N_BOOTSTRAP):
        pick = boot_rng.integers(0, n_seeds, n_seeds)
        g_b = {L: np.array([late_decay_rate(
            rho_all[(li, si)][:, pick].mean(axis=1), *GAMMA_WINDOW)
            for li in range(n_l)]) for si, L in enumerate(sizes)}
        lc_b, _, _, _ = fit_threshold_gamma(lambdas, g_b, sizes_fit)
        boot_lc.append(lc_b)
        if np.all(np.asarray(lambdas_beta) > lc_b):
            rb = rho_ss_cell[bidx, :, :][:, :, pick].mean(axis=2)  # (3, n_s)
            beta_b, _, _ = pooled_beta_fit(rb, lambdas_beta, lc_b)
            if np.isfinite(beta_b):
                boot_beta.append(beta_b)
        lam_star = min(lambdas, key=lambda v: abs(v - lc_b))
        li_star = lambdas.index(lam_star)
        ds, tvs, cens = [], [], []
        for si, L in enumerate(sizes):
            curve = rho_all[(li_star, si)][:, pick].mean(axis=1)
            if L in (128, 256):
                ds.append(fit_delta(curve))
            tv, cn = tau_half(curve)
            tvs.append(tv)
            cens.append(cn)
        boot_delta.append(float(np.nanmean(ds)))
        if not any(cens):
            z_b, _ = power_law_fit(sizes, tvs)
            boot_z.append(z_b)
    print("[bootstrap] done (%.1fs)" % (time.time() - t0), flush=True)

    # ---- threshold reporting ------------------------------------------------
    lam_lo, lam_hi = lambdas[0], lambdas[-1]
    lc_arr = np.array(boot_lc, dtype=float)
    ci_low = float(np.nanpercentile(lc_arr, 2.5))
    ci_high = float(np.nanpercentile(lc_arr, 97.5))
    if lam_lo - 1e-9 <= lc_hat <= lam_hi + 1e-9:
        lam_c_est, cens = lc_hat, False
        ci_note = ("interior estimate from the joint late-time decay-rate fit; "
                   "percentile bootstrap CI over seed resamples (n=%d)" % N_BOOTSTRAP)
        if ci_high >= LC_GRID[1] - 1e-9:
            ci_note += ("; CI upper bound unbounded (limited by the fit grid): the data do "
                        "not bound lambda_c from above within this protocol")
        elif ci_low < lam_lo or ci_high > lam_hi:
            ci_note += "; CI extends beyond the scanned range (weakly constrained)"
    elif lc_hat > lam_hi:
        lam_c_est, cens = lc_hat, True
        ci_note = ("estimate lies above the highest scanned lambda: linear extrapolation "
                   "of the late-time decay rate; only a lower bound is constrained")
        ci_low = max(ci_low, lam_hi)
    else:
        lam_c_est, cens = lc_hat, True
        ci_note = ("estimate lies below the lowest scanned lambda: linear extrapolation "
                   "of the late-time decay rate; only an upper bound is constrained")
        ci_high = min(ci_high, lam_lo)

    # secondary diagnostic: rho_ss ordering crossing (expected uninformative here)
    i32, i256 = sizes.index(32), sizes.index(256)
    lc_cross, cross_cens, cross_note = crossing_lambda(
        rho_ss_mean[:, i32], rho_ss_mean[:, i256], lambdas)

    # ---- beta ---------------------------------------------------------------
    beta_hat = np.nan
    beta_lo = beta_hi = np.nan
    beta_per_size = [np.nan] * n_s
    beta_spread = np.nan
    beta_note = ""
    if np.all(np.asarray(lambdas_beta) > lam_c_est):
        bidx0 = [lambdas.index(v) for v in lambdas_beta]
        beta_hat, beta_per_size, _ = pooled_beta_fit(
            rho_ss_mean[bidx0, :], lambdas_beta, lam_c_est)
        if np.isfinite(beta_hat):
            fin = np.isfinite(beta_per_size)
            beta_spread = float(np.max(np.array(beta_per_size)[fin])
                                - np.min(np.array(beta_per_size)[fin])) if fin.all() else np.nan
            beta_arr = np.array(boot_beta, dtype=float)
            if len(beta_arr):
                beta_lo, beta_hi = [float(v) for v in np.nanpercentile(beta_arr, [2.5, 97.5])]
            # sensitivity to lambda_c within +-BETA_SENS
            sens = []
            for dlc in (-BETA_SENS, +BETA_SENS):
                lc_s = lam_c_est + dlc
                if np.all(np.asarray(lambdas_beta) > lc_s):
                    b_s, _, _ = pooled_beta_fit(rho_ss_mean[bidx0, :], lambdas_beta, lc_s)
                    if np.isfinite(b_s):
                        sens.append(b_s)
            beta_note = ("beta fitted at fixed lam_c=%.4f from the decay-rate threshold "
                         "estimate; per-size fits %s; sensitivity to lam_c +-%.3f: %s"
                         % (lam_c_est, [None if not np.isfinite(v) else round(v, 3)
                                       for v in beta_per_size], BETA_SENS,
                            [round(v, 3) for v in sens] if sens else "n/a"))
        else:
            beta_note = "beta fit failed (insufficient valid points)"
    else:
        beta_note = ("beta NOT identifiable: beta_fit_lambdas %s do not all exceed the "
                     "estimated threshold lam_c=%.4f; the scanned window does not contain "
                     "enough supercritical quasi-stationary points at this budget"
                     % (lambdas_beta, lam_c_est))
    single_size_risk = bool(np.isfinite(beta_spread) and beta_spread > 0.15)

    # ---- delta and z at the scan point nearest lambda_c ---------------------
    lam_star = min(lambdas, key=lambda v: abs(v - lam_c_est))
    li_star = lambdas.index(lam_star)
    delta_by_size, taus, tau_cens = {}, {}, {}
    for si, L in enumerate(sizes):
        curve = rho_all[(li_star, si)].mean(axis=1)
        delta_by_size[L] = fit_delta(curve)
        taus[L], tau_cens[L] = tau_half(curve)
    dvals = [delta_by_size[L] for L in (128, 256) if np.isfinite(delta_by_size[L])]
    delta_hat = float(np.mean(dvals)) if dvals else np.nan
    d_arr = np.array(boot_delta, dtype=float)

    finite_taus = [taus[L] for L in sizes if not tau_cens[L]]
    if len(finite_taus) >= 3:
        z_hat, z_r2 = power_law_fit(sizes, [taus[L] for L in sizes])
        dynamic_scale_observed = bool(z_r2 >= Z_R2_MIN)
        z_note = ("tau_half(t_ref=%d) ~ L^z fit at lambda*=%.3f over sizes %s: z=%.3f, "
                  "R^2=%.3f; right-censored sizes: %s"
                  % (TAU_T_REF, lam_star, sizes, z_hat, z_r2,
                     [L for L in sizes if tau_cens[L]] or "none"))
    else:
        z_hat, z_r2 = np.nan, np.nan
        dynamic_scale_observed = False
        z_note = ("tau_half ~ L^z fit NOT resolvable: %d/%d sizes right-censored at "
                  "t_max=%d (near-critical slowing down exceeds the finite budget); "
                  "z is only bounded, not measured"
                  % (len(sizes) - len(finite_taus), len(sizes), t_max))
    collapse_success = bool(dynamic_scale_observed and np.isfinite(z_hat))

    # ---- universality assessment --------------------------------------------
    threshold_consistent = bool(np.isfinite(lam_c_est)
                                and (lam_lo - 0.05) <= lam_c_est <= (lam_hi + 0.05))
    beta_consistent = bool(np.isfinite(beta_hat) and 0.15 <= beta_hat <= 0.45
                           and np.all(np.isfinite(beta_per_size))
                           and np.all(np.array(beta_per_size) > 0)
                           and (not np.isfinite(beta_spread) or beta_spread <= 0.15))
    static_evidence_consistent = bool(threshold_consistent and beta_consistent)
    universality_supported = bool(static_evidence_consistent and not single_size_risk)
    conclusion = ("consistent_with_directed_percolation" if universality_supported
                  else "inconclusive")

    # ---- dp_summary.csv -----------------------------------------------------
    def num(v):
        return float(v) if v is not None and np.isfinite(v) else np.nan

