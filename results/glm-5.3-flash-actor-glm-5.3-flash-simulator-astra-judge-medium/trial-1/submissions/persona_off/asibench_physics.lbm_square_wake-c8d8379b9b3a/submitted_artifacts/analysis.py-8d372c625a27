#!/usr/bin/env python3
"""
LBM (D2Q9, BGK) simulation of 2D flow past a square solid region.

Input : ./data/task_input.json (UTF-8 or UTF-8-SIG) -- the ONLY benchmark input.
Output: ./results/fluid_summary.csv, fluid_force_series.csv, fluid_centerline.csv,
        fluid_transverse_profile.csv, fluid_report.json

Method (as approved):
  - D2Q9 lattice, single-relaxation-time BGK collision, tau = 0.5 + 3*nu,
    nu = uin * square_size / re (lattice units, dx=dy=dt=1, rho0=1).
  - BCs: equilibrium (Dirichlet-velocity) inlet at x=0 (rho=1, u=(uin,0)),
    zero-gradient outflow at x=nx-1, periodic top/bottom.
  - Solid: exact contracted mask x in [cx-half, cx-half+size), y in [cy-half, ...),
    clipped to domain; full-way bounce-back on solid nodes (mid-link wall location).
  - Force: momentum-exchange on fluid->solid boundary links only,
    impulse per step per link = 2 * f_i^post(x_fluid) * e_i (Ladd).
    cd = Fx/(0.5*uin^2*square_size), cl = Fy/(0.5*uin^2*square_size).
  - Deterministic initial field: rho=1, u=(uin,0) equilibrium everywhere,
    solid mask applied from step 0. Exactly n_steps updates; no extra settling.
  - Sampling: completed-update counts k with warmup <= k < n_steps and
    (k - warmup) % sample_every == 0 (k = 1000, 1010, ..., 4990 here).
    cd_mean = mean of instantaneous cd over samples; cl_rms = RMS of cl.
    converged = all samples finite AND |mean(cd 2nd half) - mean(cd 1st half)|
                / (|cd_mean| + 1e-12) < 0.05.
  - Fields (centerline y = cy, profile at x_probe = min(nx-1, cx+2*size)) are
    macroscopic velocities of the final-step snapshot after exactly n_steps
    updates; u is set to 0 inside solid nodes (no-slip wall convention).
"""
import json
import os
import time

import numpy as np
import pandas as pd

INPUT_PATH = "./data/task_input.json"
RESULTS_DIR = "./results"

# D2Q9 velocity set (e_i), weights, opposites
EX = np.array([0, 1, 0, -1, 0, 1, -1, -1, 1], dtype=np.int64)
EY = np.array([0, 0, 1, 0, -1, 1, 1, -1, -1], dtype=np.int64)
W = np.array([4.0 / 9.0] + [1.0 / 9.0] * 4 + [1.0 / 36.0] * 4, dtype=np.float64)
OPP = np.array([0, 3, 4, 1, 2, 7, 8, 5, 6], dtype=np.int64)


def load_input(path):
    with open(path, "rb") as fh:
        raw = fh.read()
    if raw.startswith(b"\xef\xbb\xbf"):  # UTF-8 BOM
        raw = raw[3:]
    return json.loads(raw.decode("utf-8"))


def equilibrium(rho, ux, uy):
    """D2Q9 equilibrium, shape (9, ny, nx)."""
    eu = EX[:, None, None] * ux[None, :, :] + EY[:, None, None] * uy[None, :, :]
    uu = ux * ux + uy * uy
    return W[:, None, None] * rho[None, :, :] * (
        1.0 + 3.0 * eu + 4.5 * eu * eu - 1.5 * uu
    )


def build_solid_mask(nx, ny, square_center, square_size):
    cx, cy = int(square_center[0]), int(square_center[1])
    size = int(square_size)
    half = size // 2
    x0 = max(0, cx - half)
    x1 = min(nx, x0 + size)
    y0 = max(0, cy - half)
    y1 = min(ny, y0 + size)
    solid = np.zeros((ny, nx), dtype=bool)
    solid[y0:y1, x0:x1] = True
    return solid, (x0, x1, y0, y1)


def run_case(case):
    nx, ny = int(case["nx"]), int(case["ny"])
    uin, re = float(case["uin"]), float(case["re"])
    n_steps = int(case["n_steps"])
    warmup = int(case["warmup_steps"])
    sample_every = int(case["sample_every"])
    size = int(case["square_size"])

    nu = uin * size / re
    tau = 0.5 + 3.0 * nu
    omega = 1.0 / tau

    solid, box = build_solid_mask(nx, ny, case["square_center"], size)
    fluid = ~solid

    # --- deterministic initial field: uniform flow, equilibrium populations ---
    rho0 = np.ones((ny, nx), dtype=np.float64)
    ux0 = np.full((ny, nx), uin, dtype=np.float64)
    uy0 = np.zeros((ny, nx), dtype=np.float64)
    f = equilibrium(rho0, ux0, uy0)  # (9, ny, nx)

    # inlet equilibrium column (rho=1, u=(uin,0))
    eu_in = EX * uin
    f_inlet = W * (1.0 + 3.0 * eu_in + 4.5 * eu_in ** 2 - 1.5 * uin ** 2)
    f_inlet = f_inlet[:, None] * np.ones((1, ny))  # (9, ny)

    # --- precompute fluid->solid boundary-link masks (momentum exchange) ---
    link_masks = []
    for i in range(1, 9):
        # element (y, x) True  <=>  node (y+ey, x+ex) is solid and (y,x) fluid
        sshift = np.roll(solid, shift=(-EY[i], -EX[i]), axis=(0, 1))
        m = fluid & sshift
        if m.any():
            link_masks.append((i, m))

    cd_list, cl_list, step_list = [], [], []
    force_norm = 0.5 * uin ** 2 * size

    t_start = time.time()
    for step in range(1, n_steps + 1):
        # --- macroscopic fields ---
        rho = f.sum(axis=0)
        mom = np.tensordot(f, np.stack([EX, EY], axis=1).astype(np.float64), axes=(0, 0))
        ux = mom[:, :, 0] / rho
        uy = mom[:, :, 1] / rho

        # --- BGK collision (all nodes; solid nodes are overwritten by BB) ---
        feq = equilibrium(rho, ux, uy)
        fpost = f + omega * (feq - f)

        # --- force: momentum exchange on fluid->solid links ---
        Fx = 0.0
        Fy = 0.0
        for i, m in link_masks:
            s = fpost[i][m].sum()
            Fx += 2.0 * EX[i] * s
            Fy += 2.0 * EY[i] * s

        # --- streaming (pull), periodic in y; x-edges overwritten below ---
        f = np.empty_like(fpost)
        for i in range(9):
            f[i] = np.roll(fpost[i], shift=(EY[i], EX[i]), axis=(0, 1))

        # --- full-way bounce-back on all solid nodes (atomic swap) ---
        fs = f[:, solid]              # (9, n_solid) incoming (post-streaming)
        f[:, solid] = fs[OPP, :]

        # --- boundaries ---
        f[:, :, 0] = f_inlet                       # equilibrium inlet
        f[:, :, nx - 1] = f[:, :, nx - 2]          # zero-gradient outlet

        # --- sampling: completed-update count k, (k - warmup) % se == 0 ---
        if warmup <= step < n_steps and (step - warmup) % sample_every == 0:
            step_list.append(step)
            cd_list.append(Fx / force_norm)
            cl_list.append(Fy / force_norm)

    elapsed = time.time() - t_start

    # --- final-step macroscopic fields ---
    rho = f.sum(axis=0)
    mom = np.tensordot(f, np.stack([EX, EY], axis=1).astype(np.float64), axes=(0, 0))
    ux = mom[:, :, 0] / rho
    uy = mom[:, :, 1] / rho
    ux[solid] = 0.0   # no-slip wall convention inside the solid
    uy[solid] = 0.0

    cd_arr = np.asarray(cd_list, dtype=np.float64)
    cl_arr = np.asarray(cl_list, dtype=np.float64)
    st_arr = np.asarray(step_list, dtype=np.int64)

    if cd_arr.size == 0 or not (np.isfinite(cd_arr).all() and np.isfinite(cl_arr).all()):
        raise RuntimeError(f"case {case['case_id']}: empty or non-finite force samples")

    cd_mean = float(cd_arr.mean())
    cl_rms = float(np.sqrt((cl_arr ** 2).mean()))
    n = cd_arr.size
    first_half = float(cd_arr[: n // 2].mean())
    second_half = float(cd_arr[n // 2:].mean())
    rel_change = abs(second_half - first_half) / (abs(cd_mean) + 1e-12)
    converged = bool(rel_change < 0.05)

    cx, cy = int(case["square_center"][0]), int(case["square_center"][1])
    x_probe = min(nx - 1, cx + 2 * size)
    cy_row = min(ny - 1, cy)

    return {
        "case_id": case["case_id"], "nx": nx, "ny": ny, "re": re, "uin": uin,
        "nu": nu, "tau": tau, "n_steps": n_steps,
        "cd_mean": cd_mean, "cl_rms": cl_rms, "converged": converged,
        "series": pd.DataFrame({"case_id": case["case_id"], "step": st_arr,
                                "cd": cd_arr, "cl": cl_arr}),
        "centerline": pd.DataFrame({"case_id": case["case_id"],
                                    "x": np.arange(nx, dtype=np.int64),
                                    "u": ux[cy_row, :]}),
        "profile": pd.DataFrame({"case_id": case["case_id"],
                                 "x_probe": np.full(ny, x_probe, dtype=np.int64),
                                 "y": np.arange(ny, dtype=np.int64),
                                 "u": ux[:, x_probe], "v": uy[:, x_probe]}),
        "elapsed_s": elapsed, "n_samples": int(n), "rel_change": rel_change,
        "box": box,
    }


def main():
    os.makedirs(RESULTS_DIR, exist_ok=True)
    data = load_input(INPUT_PATH)
    cases = data["cases"]
    print(f"Loaded {len(cases)} cases from {INPUT_PATH}")

    summaries, series_frames, center_frames, profile_frames = [], [], [], []
    for case in cases:
        res = run_case(case)
        summaries.append({k: res[k] for k in
                          ("case_id", "nx", "ny", "re", "uin", "nu", "tau",
                           "n_steps", "cd_mean", "cl_rms", "converged")})
        series_frames.append(res["series"])
        center_frames.append(res["centerline"])
        profile_frames.append(res["profile"])
        print(f"case {res['case_id']}: tau={res['tau']:.6f} "
              f"cd_mean={res['cd_mean']:.6f} cl_rms={res['cl_rms']:.6f} "
              f"converged={res['converged']} samples={res['n_samples']} "
              f"rel_change={res['rel_change']:.4f} "
              f"runtime={res['elapsed_s']:.1f}s box={res['box']}")

    summary = pd.DataFrame(summaries, columns=[
        "case_id", "nx", "ny", "re", "uin", "nu", "tau", "n_steps",
        "cd_mean", "cl_rms", "converged"])
    force_series = pd.concat(series_frames, ignore_index=True)
    centerline = pd.concat(center_frames, ignore_index=True)
    profile = pd.concat(profile_frames, ignore_index=True)

    # --- finite checks ---
    for name, df in (("summary", summary), ("series", force_series),
                     ("centerline", centerline), ("profile", profile)):
        num = df.select_dtypes(include=[np.number])
        if not np.isfinite(num.to_numpy(dtype=np.float64)).all():
            raise RuntimeError(f"non-finite values in {name}")

    # --- case-ID consistency ---
    ids_in = [c["case_id"] for c in cases]
    for name, df in (("summary", summary), ("series", force_series),
                     ("centerline", centerline), ("profile", profile)):
        if sorted(set(df["case_id"])) != sorted(ids_in):
            raise RuntimeError(f"case-ID mismatch in {name}")

    summary.to_csv(os.path.join(RESULTS_DIR, "fluid_summary.csv"), index=False)
    force_series.to_csv(os.path.join(RESULTS_DIR, "fluid_force_series.csv"), index=False)
    centerline.to_csv(os.path.join(RESULTS_DIR, "fluid_centerline.csv"), index=False)
    profile.to_csv(os.path.join(RESULTS_DIR, "fluid_transverse_profile.csv"), index=False)

    cd_mean_avg = float(summary["cd_mean"].mean())
    report = {
        "task_id": data.get("task_id", "fluid-square-wake-2d-001"),
        "units": data.get("units", "dimensionless"),
        "cd_mean_avg": cd_mean_avg,
        "method_summary": (
            "D2Q9 lattice-Boltzmann BGK solver in lattice units (dx=dy=dt=1, rho0=1); "
            "nu = uin*square_size/re, tau = 0.5 + 3*nu (contract formula, overriding the "
            "JSON's target_tau key); equilibrium (Dirichlet-velocity) inlet at x=0 with "
            "rho=1, u=(uin,0); zero-gradient outflow at x=nx-1; periodic top/bottom; "
            "square obstacle from the contracted mask (cx-half..cx-half+size), full-way "
            "bounce-back (mid-link wall); force by momentum exchange on fluid->solid "
            "boundary links, impulse 2*f_i^post*e_i per link per step (Ladd); "
            "cd = Fx/(0.5*uin^2*square_size), cl = Fy/(0.5*uin^2*square_size); "
            "deterministic uniform-flow equilibrium initial field with the solid mask "
            "applied from step 0; exactly n_steps updates, no extra settling; samples at "
            "completed-update counts k with warmup <= k < n_steps and "
            "(k - warmup) % sample_every == 0; cd_mean = mean of instantaneous sampled cd, "
            "cl_rms = RMS of instantaneous sampled cl; converged = all samples finite AND "
            "|mean(cd 2nd half) - mean(cd 1st half)|/(|cd_mean|+1e-12) < 0.05; centerline "
            "row y = square_center_y and transverse profile at "
            "x_probe = min(nx-1, cx + 2*square_size) are macroscopic velocities of the "
            "final-step snapshot (u = 0 inside solid nodes). Pure numpy (numba unavailable)."
        ),
    }
    with open(os.path.join(RESULTS_DIR, "fluid_report.json"), "w", encoding="utf-8") as fh:
        json.dump(report, fh, indent=2)

    print(f"\ncd_mean_avg = {cd_mean_avg:.6f}")
    print(summary.to_string(index=False))
    print(f"series rows per case: {force_series['case_id'].value_counts().to_dict()}")
    print(f"centerline rows per case: {centerline['case_id'].value_counts().to_dict()}")
    print(f"profile rows per case: {profile['case_id'].value_counts().to_dict()}")


if __name__ == "__main__":
    main()
