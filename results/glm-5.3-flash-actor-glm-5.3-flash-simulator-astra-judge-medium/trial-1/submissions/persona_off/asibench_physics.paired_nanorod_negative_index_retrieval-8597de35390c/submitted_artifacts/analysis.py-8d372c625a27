def _render_matplotlib(panels, path, colors):
    import matplotlib.pyplot as plt
    fig, axes = plt.subplots(2, 2, figsize=(13.5, 10.0))
    for ax, pn in zip(axes.ravel(), panels):
        for sp in pn["spans"]:
            ax.axvspan(sp["x0"], sp["x1"], color=colors[sp["color"] % 10],
                       alpha=0.15)
        for s in pn["series"]:
            c = colors[s["color"] % 10]
            if s["style"] == "dot":
                ax.plot(s["x"], s["y"], ".", ms=3, color=c, alpha=0.5,
                        label=s["label"])
            else:
                ax.plot(s["x"], s["y"], "-" if s["style"] == "line" else "--",
                        lw=1.2, color=c, label=s["label"])
        for an in pn["annotations"]:
            ax.annotate(an["text"], (an["x"], an["y"]), fontsize=7,
                        xytext=(5, 8), textcoords="offset points")
        if pn["yscale"] == "log":
            ax.set_yscale("log")
        ax.set_xlabel(pn["xlabel"]); ax.set_ylabel(pn["ylabel"])
        ax.set_title(pn["title"], fontsize=10)
        if pn["legend"] and any(s["label"] for s in pn["series"]):
            ax.legend(fontsize=7, ncol=2)
    fig.tight_layout()
    fig.savefig(path, dpi=150)
    plt.close(fig)


