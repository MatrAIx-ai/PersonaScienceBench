def _render_minipng(panels, path, colors, width=1500, height=1050):
    """Self-contained raster renderer + PNG writer (numpy + zlib only)."""
    import zlib
    import struct

    def hex2rgb(h):
        return np.array([int(h[i:i + 2], 16) for i in (1, 3, 5)], dtype=np.uint8)

    pal = [hex2rgb(c) for c in colors]
    img = np.full((height, width, 3), 255, dtype=np.uint8)

    def put(x, y, rgb):
        if 0 <= y < height and 0 <= x < width:
            img[int(y), int(x)] = rgb

    def line(x0, y0, x1, y1, rgb, dash=False):
        n = int(max(abs(x1 - x0), abs(y1 - y0))) + 1
        xs = np.linspace(x0, x1, n)
        ys = np.linspace(y0, y1, n)
        if dash:
            keep = (np.arange(n) // 4) % 2 == 0
            xs, ys = xs[keep], ys[keep]
        for x, y in zip(xs, ys):
            put(round(x), round(y), rgb)
            put(round(x) + 1, round(y), rgb)

    def text(x, y, s, scale=2, rgb=None):
        rgb = np.array([0, 0, 0], dtype=np.uint8) if rgb is None else rgb
        cx = x
        for ch in s:
            for poly in _GLYPHS.get(ch.upper(), []):
                pts = [(cx + px * scale, y + (6 - py) * scale)
                       for px, py in poly]
                for (xa, ya), (xb, yb) in zip(pts[:-1], pts[1:]):
                    line(xa, ya, xb, yb, rgb)
            cx += 5 * scale

    L, R, T, B = 60, width - 20, 30, height - 60
    pw, ph = (R - L) // 2 - 20, (B - T) // 2 - 30
    origins = [(L, T), (L + pw + 40, T), (L, T + ph + 60),
               (L + pw + 40, T + ph + 60)]
    for pn, (ox, oy) in zip(panels, origins):
        ax0, ay0, ax1, ay1 = ox, oy + 25, ox + pw, oy + ph + 5
        xs = np.concatenate([s["x"] for s in pn["series"] if len(s["x"])])
        ys = np.concatenate([s["y"] for s in pn["series"] if len(s["y"])])
        if pn["yscale"] == "log":
            ys = np.log10(np.clip(ys, 1e-8, None))
        x0, x1 = float(xs.min()), float(xs.max())
        y0, y1 = float(ys.min()), float(ys.max())
        if y1 - y0 < 1e-12:
            y1 = y0 + 1e-12
        pad = 0.05 * (x1 - x0)
        x0, x1 = x0 - pad, x1 + pad
        py0, py1 = y0 - 0.05 * (y1 - y0), y1 + 0.05 * (y1 - y0)

        def tx(xv):
            return ax0 + (xv - x0) / (x1 - x0) * (ax1 - ax0)

        def ty(yv):
            return ay1 - (yv - py0) / (py1 - py0) * (ay1 - ay0)

        # frame + ticks
        for (xa, ya, xb, yb) in [(ax0, ay0, ax1, ay0), (ax0, ay1, ax1, ay1),
                                 (ax0, ay0, ax0, ay1), (ax1, ay0, ax1, ay1)]:
            line(xa, ya, xb, yb, np.zeros(3, dtype=np.uint8))
        for i in range(6):
            xv = x0 + i * (x1 - x0) / 5
            yv = py0 + i * (py1 - py0) / 5
            line(tx(xv), ay1, tx(xv), ay1 + 4, np.zeros(3, dtype=np.uint8))
            line(ax0 - 4, ty(yv), ax0, ty(yv), np.zeros(3, dtype=np.uint8))
            text(tx(xv) - 12, ay1 + 8, f"{xv:.0f}", 1)
            lab = f"1e{yv:.1f}" if pn["yscale"] == "log" else f"{yv:.2f}"
            text(ax0 - 38, ty(yv) - 6, lab, 1)
        text(ox, oy + 8, pn["title"], 1)
        text(ax0 + (ax1 - ax0) / 2 - 40, ay1 + 22, pn["xlabel"], 1)
        text(ox + 5, oy + 55, pn["ylabel"], 1)
        # spans
        for sp in pn["spans"]:
            rgb = pal[sp["color"] % 10].copy()
            xa, xb = tx(sp["x0"]), tx(sp["x1"])
            for yy in range(ay0, ay1 + 1):
                for xx in range(int(xa), int(xb) + 1):
                    cur = img[yy, xx].astype(int)
                    img[yy, xx] = (0.85 * cur + 0.15 * rgb).astype(np.uint8)
        # series
        for s in pn["series"]:
            rgb = pal[s["color"] % 10]
            sx = s["x"]
            sy = s["y"]
            if pn["yscale"] == "log":
                sy = np.log10(np.clip(sy, 1e-8, None))
            X = tx(sx)
            Y = ty(sy)
            if s["style"] == "dot":
                for xx, yy in zip(X, Y):
                    put(xx, yy, rgb); put(xx + 1, yy, rgb)
                    put(xx, yy + 1, rgb); put(xx + 1, yy + 1, rgb)
            else:
                for i in range(1, len(X)):
                    line(X[i - 1], Y[i - 1], X[i], Y[i], rgb,
                         dash=(s["style"] == "dash"))
        # annotations
        for an in pn["annotations"]:
            text(tx(an["x"]) + 4, ty(an["y"]) - 4, an["text"], 1)
        # legend
        if pn["legend"]:
            labels = [(s["label"], s["color"], s["style"])
                      for s in pn["series"] if s["label"]]
            ly = ay0 + 4
            for lab, ck, st in labels:
                rgb = pal[ck % 10]
                line(ax1 - 130, ly + 3, ax1 - 110, ly + 3, rgb,
                     dash=(st == "dash"))
                text(ax1 - 106, ly, lab, 1)
                ly += 9
    # encode PNG
    raw = b"".join(
        b"\x00" + img[y].tobytes() for y in range(height))
    def chunk(tag, data):
        c = struct.pack(">I", len(data)) + tag + data
        return c + struct.pack(">I", zlib.crc32(tag + data) & 0xFFFFFFFF)
    png = (b"\x89PNG\r\n\x1a\n"
           + chunk(b"IHDR", struct.pack(">IIBBBBB", width, height, 8, 2, 0, 0, 0))
           + chunk(b"IDAT", zlib.compress(raw, 6))
           + chunk(b"IEND", b""))
    with open(path, "wb") as fh:
        fh.write(png)


