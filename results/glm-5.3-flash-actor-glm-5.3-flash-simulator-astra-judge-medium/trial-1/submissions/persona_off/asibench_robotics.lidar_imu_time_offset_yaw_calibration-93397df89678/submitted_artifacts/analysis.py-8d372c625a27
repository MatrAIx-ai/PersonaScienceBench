def _png_write(path, img):
    h, wd, _ = img.shape
    raw = b"".join(b"\x00" + img[i].tobytes() for i in range(h))

    def chunk(tag, data):
        c = struct.pack(">I", len(data)) + tag + data
        return c + struct.pack(">I", zlib.crc32(tag + data) & 0xFFFFFFFF)
    png = (b"\x89PNG\r\n\x1a\n"
           + chunk(b"IHDR", struct.pack(">IIBBBBB", wd, h, 8, 2, 0, 0, 0))
           + chunk(b"IDAT", zlib.compress(raw, 6))
           + chunk(b"IEND", b""))
    with open(path, "wb") as f:
        f.write(png)


class _Panel:
    """One axes panel on a shared RGB canvas."""

    def __init__(self, img, x0, y0, x1, y1, title, sc=2):
        self.img, self.sc = img, sc
        self.px0, self.py0, self.px1, self.py1 = x0, y0, x1, y1
        self._text(x0, y0, title, (0, 0, 0))
        # plot box (leave 12*scale px at bottom / 6*scale at left for labels)
        self.bx0 = x0 + 10 * sc
        self.by0 = y0 + 5 * sc
        self.bx1 = x1
        self.by1 = y1 - 12 * sc
        self._hline(self.by0, self.bx0, self.bx1, (0, 0, 0))
        self._hline(self.by1, self.bx0, self.bx1, (0, 0, 0))
        self._vline(self.bx0, self.by0, self.by1, (0, 0, 0))
        self._vline(self.bx1, self.by0, self.by1, (0, 0, 0))

    def _put(self, x, y, c):
        h, w_, _ = self.img.shape
        if 0 <= x < w_ and 0 <= y < h:
            self.img[y, x] = c

    def _hline(self, y, x0, x1, c):
        self.img[int(y), int(x0):int(x1) + 1] = c

    def _vline(self, x, y0, y1, c):
        self.img[int(y0):int(y1) + 1, int(x)] = c

    def _text(self, x, y, s, c):
        for k, ch in enumerate(s.upper()):
            g = _FONT.get(ch, _FONT[' '])
            for r in range(7):
                for cc in range(5):
                    if g[r][cc] == '1':
                        for a in range(self.sc):
                            for b in range(self.sc):
                                self._put(x + k * 6 * self.sc + cc * self.sc
                                          + a, y + r * self.sc + b, c)

    def set_axes(self, xlim, ylim, xlab, ylab, xfmt="%.3f", yfmt="%.3f"):
        self.x0, self.x1 = float(xlim[0]), float(xlim[1])
        self.y0, self.y1 = float(ylim[0]), float(ylim[1])
        sc = self.sc
        for frac in (0.0, 0.25, 0.5, 0.75, 1.0):
            xv = self.x0 + frac * (self.x1 - self.x0)
            xp = self.bx0 + frac * (self.bx1 - self.bx0)
            self._vline(xp, self.by1, self.by1 + 4 * sc, (0, 0, 0))
            self._text(int(xp - 12 * sc), self.by1 + 6 * sc,
                       xfmt % xv, (60, 60, 60))
            yv = self.y0 + (1 - frac) * (self.y1 - self.y0)
            yp = self.by1 - frac * (self.by1 - self.by0)
            self._hline(yp, self.bx0 - 4 * sc, self.bx0, (0, 0, 0))
            lbl = yfmt % yv
            self._text(int(self.bx0 - 6 * sc - 6 * sc * len(lbl)),
                       int(yp - 3 * sc), lbl, (60, 60, 60))
        self._text(int(self.bx0), self.by1 + 6 * sc + 9 * sc,
                   xlab, (0, 0, 0))
        self._text(self.px0 + 1, self.by0 + 2 * sc, ylab, (0, 0, 0))
        return self

    def _map(self, x, y):
        fx = (x - self.x0) / max(self.x1 - self.x0, 1e-12)
        fy = (y - self.y0) / max(self.y1 - self.y0, 1e-12)
        return (self.bx0 + fx * (self.bx1 - self.bx0),
                self.by1 - fy * (self.by1 - self.by0))

    def line(self, xs, ys, c, ms=1):
        pts = [self._map(x, y) for x, y in zip(xs, ys)]
        for (xa, ya), (xb, yb) in zip(pts[:-1], pts[1:]):
            n = int(max(abs(xb - xa), abs(yb - ya))) + 1
            for k in range(n + 1):
                x = int(round(xa + (xb - xa) * k / n))
                y = int(round(ya + (yb - ya) * k / n))
                for a in range(-ms // 2, ms // 2 + 1):
                    for b in range(-ms // 2, ms // 2 + 1):
                        self._put(x + a, y + b, c)

    def scatter(self, xs, ys, c, r=2):
        for x, y in zip(xs, ys):
            xp, yp = self._map(x, y)
            xp, yp = int(round(xp)), int(round(yp))
            for a in range(-r, r + 1):
                for b in range(-r, r + 1):
                    if a * a + b * b <= r * r:
                        self._put(xp + a, yp + b, c)

    def bars(self, keys, vals, c):
        n = len(vals)
        bw = (self.bx1 - self.bx0) / max(n, 1)
        for k, v in zip(keys, vals):
            xa, ya = self._map(k - 0.4, v)
            xb, yb = self._map(k + 0.4, self.y0)
            self.img[int(ya):int(yb) + 1, int(xa):int(xb) + 1] = c

    def vline_data(self, x, c):
        xp, _ = self._map(x, self.y0)
        self._vline(int(round(xp)), self.by0, self.by1, c)

    def hline_data(self, y, c):
        _, yp = self._map(self.x0, y)
        self._hline(int(round(yp)), self.bx0, self.bx1, c)


def render_diagnostics(tm, resid_all, train, held, sig_yaw, coarse, vals,
                       jcoarse, jvals, tau_int, res_yaw, dx, dy, dyaw,
                       eps_hat, scores, segs, path):
    K = (30, 30, 30); BLU = (70, 110, 180); RED = (200, 40, 40)
    GRN = (40, 140, 60); ORG = (220, 130, 30); GRY = (150, 150, 150)
    W, H = 1560, 1740
    img = np.full((H, W, 3), 255, np.uint8)
    pw, ph = W // 2, H // 3

    def cell(r, c, title):
        return _Panel(img, c * pw + 15, r * ph + 10, (c + 1) * pw - 15,
                      (r + 1) * ph - 8, title)

    # panel 1: yaw residuals vs time
    p = cell(0, 0, "YAW RESIDUALS VS TIME (TRAIN BLUE / HELD-OUT RED)")
    p.set_axes((0, tm.max()), (-0.025, 0.025), "T (S)",
               "RESID (RAD)", "%.0f", "%.3f")
    p.hline_data(0, GRY)
    p.scatter(tm[train], resid_all[train], BLU, r=1)
    p.scatter(tm[held], resid_all[held], RED, r=2)

    # panel 2: tau profile
    p = cell(0, 1, "TIME-OFFSET PROFILE LIKELIHOOD (DELTA CHI2)")
    ymin = min(vals.min(), jvals.min())
    ymax = max((vals - ymin).max(), (jvals - ymin).max())
    p.set_axes((coarse[0] * 1e3, coarse[-1] * 1e3), (0, ymax),
               "INTERNAL TAU (MS)", "DELTA CHI2", "%.0f", "%.0f")
    p.line(coarse * 1e3, vals - vals.min(), BLU, ms=1)
    p.line(jcoarse * 1e3, jvals - jvals.min(), RED, ms=1)
    p.vline_data(tau_int * 1e3, GRN)

    # panel 3: yaw residual histograms
    p = cell(1, 0, "YAW RESIDUAL DISTRIBUTION (TRAIN / HELD-OUT)")
    edges = np.linspace(-0.025, 0.025, 41)
    htr, _ = np.histogram(resid_all[train], bins=edges, density=True)
    hho, _ = np.histogram(res_yaw[held], bins=edges, density=True)
    centers = 0.5 * (edges[:-1] + edges[1:])
    top = max(htr.max(), hho.max(),
              (1 / (sig_yaw * np.sqrt(2 * np.pi))) * 1.2)
    p.set_axes((-0.025, 0.025), (0, top), "RESID (RAD)", "DENSITY",
               "%.3f", "%.1f")
    p.line(centers, htr, BLU, ms=2)
    p.line(centers, hho, RED, ms=2)
    xs = np.linspace(-0.025, 0.025, 100)
    p.line(xs, np.exp(-xs**2 / (2 * sig_yaw**2)) / (sig_yaw * np.sqrt(2*np.pi)),
           K, ms=1)

    # panel 4: extrinsic fit
    p = cell(1, 1, "EXTRINSIC FIT: DY - ARC TERM VS DX (TRAIN)")
    yat = dy[train] - dx[train] * np.tan(dyaw[train] / 2)
    p.set_axes((0, dx.max() * 1.02), (min(yat.min(), 0), yat.max() + 0.002),
               "DX (M)", "DY - ARC (M)", "%.2f", "%.3f")
    p.scatter(dx[train], yat, BLU, r=1)
    p.line(np.array([0, dx.max() * 1.02]),
           np.sin(eps_hat) * np.array([0, dx.max() * 1.02]), RED, ms=2)

    # panel 5: observability bars
    p = cell(2, 0, "PER-SEGMENT OBSERVABILITY (NORMALIZED FI TRACE)")
    sids = [g["sid"] for g in segs]
    sv = [scores[i] for i in sids]
    p.set_axes((-0.5, len(sids) - 0.5), (0, max(sv) * 1.15),
               "SEGMENT ID", "SCORE", "%.0f", "%.2f")
    p.bars(sids, sv, BLU)
    p.hline_data(1.0, GRY)

    # panel 6: autocorrelation
    p = cell(2, 1, "YAW RESIDUAL AUTOCORRELATION (TRAIN)")
    lags = list(range(1, 11))
    ac = [float(np.corrcoef(resid_all[train][:-k], resid_all[train][k:])[0, 1])
          for k in lags]
    p.set_axes((0.5, 10.5), (min(min(ac), 0) * 1.2, max(max(ac), 0.05) * 1.2),
               "LAG (SCANS)", "AUTOCORR", "%.0f", "%.2f")
    p.hline_data(0, GRY)
    p.bars(lags, ac, ORG)

    _png_write(path, img)




