"""
Deterministic nonlinear target-tracking audit: bootstrap particle filter.

Input : data/measurements.npz  (Y: 95x2 [range, bearing], t: 95, mask: 95x2 bool)
Output: results/state_estimates.csv, results/filter_diagnostics.csv,
        results/summary.json, results/overview.png, results/conclusion.txt

Model (inferred from the data during exploration):
  * Channel 0 = range  r = hypot(px, py) + b_r        (strictly positive)
  * Channel 1 = bearing theta = atan2(py, px) + b_b   (wrapped to [-pi, pi])
  * State [px, py, vx, vy, omega, b_r, b_b]; coordinated-turn-capable motion:
    velocity is rotated by omega*dt each step; omega, b_r, b_b random-walk.
  * Adaptive process-noise scale lambda (innovation/NIS driven, windowed
    median so isolated outlier spikes do not trigger maneuver inflation).
  * Robust contaminated-Gaussian per-channel likelihood
    (1-eps)*N(0,sig^2) + eps*N(0,(5 sig)^2); if the weighted innovation is
    beyond a 6-sigma gate the channel falls back to the broad component only
    (documented, finite, keeps weights non-degenerate).
  * Missing channels (mask False) are skipped in the likelihood.
  * Log-domain weights, systematic resampling when ESS < N/2, light
    roughening after resampling to preserve diversity.

Diagnostics / proxies (documented in results/conclusion.txt):
  * rmse_pos, rmse_vel : per-step distance between the filtered estimate and
    a backward-simulation particle smoother reference (trajectory-error
    proxy, since the true trajectory is not public).
  * nees : normalized innovation squared (NIS) computed with the covariance
    predicted by the particle ensemble (NEES-style covariance consistency
    proxy; chi-square-distributed with dof = #available channels if the
    filter is self-consistent).
  * bearing_residual_mean/std : wrapped bearing innovation statistics
    (finite fallback 0.0 when the bearing channel is missing).
"""
import os
import json
import numpy as np
import pandas as pd

RNG = np.random.default_rng(42)

# ----------------------------------------------------------------------
# configuration
N_PART = 1200                 # <= 1500 particles
DT = 1.0
EPS_MIX = 0.08                # contamination fraction of the mixture
BROAD_FACTOR = 5.0            # broad mixture component = 5 * sigma
GATE_FACTOR = 8.0             # gated fallback component = 8 * sigma
GATE_NIS = 36.0               # gate threshold on normalized innovation^2
LAM_MAX = 40.0                # max adaptive process-noise scale
Q_V0 = 0.015                  # baseline accel (velocity RW) std
Q_OM0 = 0.02                  # baseline turn-rate RW std
Q_BR = 0.002                  # range-bias RW std
Q_BB = 0.0008                 # bearing-bias RW std
SMOOTH_M = 40                 # backward-simulation samples for smoother

def wrap(a):
    return (a + np.pi) % (2.0 * np.pi) - np.pi

# ----------------------------------------------------------------------
# load
d = np.load("data/measurements.npz", allow_pickle=True)
Y = np.asarray(d["Y"], dtype=float)
t = np.asarray(d["t"], dtype=float)
mask = np.asarray(d["mask"], dtype=bool)
meta = json.loads(str(d["metadata"]))
T = len(t)

r_obs = np.where(mask[:, 0], Y[:, 0], np.nan)
b_obs = np.where(mask[:, 1], Y[:, 1], np.nan)

# ----------------------------------------------------------------------
# robust noise-scale estimation from 3-point residuals of valid stretches
def robust_sigma_3pt(v, m):
    res = []
    for i in range(1, len(v) - 1):
        if m[i] and m[i - 1] and m[i + 1]:
            res.append(v[i] - 0.5 * (v[i - 1] + v[i + 1]))
    res = np.asarray(res)
    med = np.median(res)
    mad = np.median(np.abs(res - med))
    return 1.4826 * mad / np.sqrt(1.5)  # 3-pt residual -> per-sample sigma

sig_r_raw = robust_sigma_3pt(r_obs, mask[:, 0])
bu = np.unwrap(b_obs[mask[:, 1]])
b_un = np.full(T, np.nan)
b_un[mask[:, 1]] = bu
sig_b_raw = robust_sigma_3pt(b_un, mask[:, 1])
SIG_R = float(max(sig_r_raw * 1.2, 0.030))
SIG_B = float(max(sig_b_raw * 1.2, 0.008))

# time-varying local noise scale: rolling robust std of 3-point residuals
# (the mid-record is visibly heavier-tailed than the quiet end segments)
def local_sigma(v, m, global_sig, win=8, lo=0.8, hi=4.0):
    res = np.full(len(v), np.nan)
    for i in range(1, len(v) - 1):
        if m[i] and m[i - 1] and m[i + 1]:
            res[i] = v[i] - 0.5 * (v[i - 1] + v[i + 1])
    out = np.full(len(v), global_sig)
    for i in range(len(v)):
        w = res[max(0, i - win):i + win + 1]
        w = w[np.isfinite(w)]
        if len(w) >= 3:
            s = 1.4826 * np.median(np.abs(w - np.median(w))) / np.sqrt(1.5)
            out[i] = np.clip(global_sig + 0.5 * s, global_sig * lo, global_sig * hi)
    return out

sig_r_t = local_sigma(r_obs, mask[:, 0], SIG_R)
sig_b_t = local_sigma(b_un, mask[:, 1], SIG_B)

# angle-wrap event pre-scan (consecutive valid bearing samples crossing +-pi)
wrap_events = 0
for i in range(1, T):
    if mask[i, 1] and mask[i - 1, 1]:
        raw = b_obs[i] - b_obs[i - 1]
        if abs(wrap(raw) - raw) > 1e-9:
            wrap_events += 1

# ----------------------------------------------------------------------
# initialization (wrap-aware, on the first fully valid observation)
i0 = int(np.argmax(mask.all(axis=1)))
r0, b0 = r_obs[i0], b_obs[i0]
theta0 = b0 + RNG.normal(0.0, 3.0 * SIG_B, N_PART)
rr0 = np.clip(r0 + RNG.normal(0.0, 3.0 * SIG_R, N_PART), 0.05, None)
px = rr0 * np.cos(theta0)
py = rr0 * np.sin(theta0)
spd = np.abs(RNG.normal(0.0, 0.10, N_PART)) + 0.005
hdg = RNG.uniform(-np.pi, np.pi, N_PART)
vx = spd * np.cos(hdg)
vy = spd * np.sin(hdg)
om = RNG.normal(0.0, 0.03, N_PART)
br = np.zeros(N_PART)
bb = np.zeros(N_PART)
X = np.vstack([px, py, vx, vy, om, br, bb])          # (7, N)

logw = np.full(N_PART, -np.log(N_PART))              # normalized log weights
lam = 1.0                                            # adaptive process-noise scale
nis_hist = []                                        # rolling NIS history
store_X, store_lw = [], []                           # for backward smoother
lam_hist = np.zeros(T)

# storage for outputs
est = np.zeros((T, 4))
cov_diag = np.zeros((T, 4))
diag = {k: np.zeros(T) for k in
        ["rmse_pos", "rmse_vel", "nees", "ess", "resampled", "weight_entropy",
         "max_log_weight", "min_log_weight", "bearing_residual_mean",
         "bearing_residual_std", "nis_raw", "pred_r", "pred_b",
         "bias_r", "bias_b", "bias_b_std"]}
resampled_flags = np.zeros(T, dtype=int)

def systematic_resample(logw_norm, rng):
    w = np.exp(logw_norm)
    w = w / w.sum()
    u = (rng.random() + np.arange(N_PART)) / N_PART
    idx = np.searchsorted(np.cumsum(w), u)
    return np.clip(idx, 0, N_PART - 1)

for k in range(T):
    # ---------------- predict ----------------
    qv, qom = Q_V0 * np.sqrt(lam), Q_OM0 * np.sqrt(lam)
    om_new = X[4] + qom * RNG.standard_normal(N_PART)
    th = om_new * DT
    c, s = np.cos(th), np.sin(th)
    vx_r = c * X[2] - s * X[3] + qv * RNG.standard_normal(N_PART)
    vy_r = s * X[2] + c * X[3] + qv * RNG.standard_normal(N_PART)
    px_new = X[0] + vx_r * DT
    py_new = X[1] + vy_r * DT
    br_new = X[5] + Q_BR * RNG.standard_normal(N_PART)
    bb_new = X[6] + Q_BB * RNG.standard_normal(N_PART)
    X = np.vstack([px_new, py_new, vx_r, vy_r, om_new, br_new, bb_new])
    lam_hist[k] = lam

    # ---------------- update ----------------
    pr = np.hypot(X[0], X[1])
    pb = np.arctan2(X[1], X[0])
    pred_r = pr + X[5]
    pred_b = wrap(pb + X[6])
    loglik = np.zeros(N_PART)
    nis_t, dof_t = 0.0, 0
    b_res_list = None

    def channel_ll(z, pred, sig, is_angle):
        """contaminated-Gaussian log likelihood (mixture always active).

        The NIS reported to the maneuver controller uses a broad-variance
        substitution when the innovation exceeds the gate, so isolated
        outliers do not masquerade as maneuvers."""
        innov = wrap(z - pred) if is_angle else (z - pred)
        S = np.var(pred) + sig ** 2                       # predicted spread
        nis_mean = innov.mean() ** 2 / S
        base = -0.5 * (innov / sig) ** 2 - np.log(sig * np.sqrt(2 * np.pi))
        broad = (-0.5 * (innov / (BROAD_FACTOR * sig)) ** 2
                 - np.log(BROAD_FACTOR * sig * np.sqrt(2 * np.pi)))
        if nis_mean > GATE_NIS:
            # gated fallback: broad single Gaussian. Gross outliers (10-30
            # sigma) then carry almost no information (weights stay
            # non-degenerate) while genuine model mismatch is recovered
            # through the adaptive process-noise controller.
            gsig = GATE_FACTOR * sig
            ll = -0.5 * (innov / gsig) ** 2 - np.log(gsig * np.sqrt(2 * np.pi))
            nis_out = innov.mean() ** 2 / (np.var(pred) + (GATE_FACTOR * sig) ** 2)
        else:
            ll = np.logaddexp(np.log(1 - EPS_MIX) + base,
                              np.log(EPS_MIX) + broad)
            nis_out = nis_mean
        return ll, innov, nis_out

    if mask[k, 0]:
        ll, innov, nis = channel_ll(r_obs[k], pred_r, sig_r_t[k], False)
        loglik += ll
        nis_t += nis
        dof_t += 1
    if mask[k, 1]:
        ll, innov, nis = channel_ll(b_obs[k], pred_b, sig_b_t[k], True)
        loglik += ll
        nis_t += nis
        dof_t += 1
        b_res_list = innov                                # wrapped residuals
    nis_raw = nis_t

    logw = logw + loglik
    logw -= np.max(logw)
    w = np.exp(logw)
    wsum = w.sum()
    if not np.isfinite(wsum) or wsum <= 0:                # absolute fallback
        w = np.ones(N_PART) / N_PART
        logw = np.full(N_PART, -np.log(N_PART))
    else:
        w = w / wsum
        logw = np.log(w)

    ess = 1.0 / np.sum(w ** 2)
    entropy = -np.sum(w[w > 0] * np.log(w[w > 0]))

    # weighted estimates
    est[k] = w @ X[:4].T
    dev = X[:4] - est[k][:, None]
    cov = (w[None, :] * dev) @ dev.T
    cov += np.eye(4) * 1e-12
    cov_diag[k] = np.diag(cov)

    # bearing residual diagnostics (finite fallback 0.0)
    if b_res_list is not None:
        bw = w / w.sum()
        mu_b = float(bw @ b_res_list)
        diag["bearing_residual_mean"][k] = mu_b
        diag["bearing_residual_std"][k] = float(
            np.sqrt(np.clip(bw @ (wrap(b_res_list - mu_b)) ** 2, 0.0, None)))
    else:
        diag["bearing_residual_mean"][k] = 0.0
        diag["bearing_residual_std"][k] = 0.0

    diag["pred_r"][k] = float(w @ pred_r)
    diag["pred_b"][k] = float(w @ pred_b)
    diag["nis_raw"][k] = nis_raw
    diag["bias_r"][k] = float(w @ X[5])
    diag["bias_b"][k] = float(w @ X[6])
    diag["bias_b_std"][k] = float(np.sqrt(max(w @ (X[6] - float(w @ X[6])) ** 2, 0.0)))

    # store posterior for smoothing
    store_X.append(X.copy())
    store_lw.append(logw.copy())

    # ---------------- adaptive process-noise controller ----------------
    nis_hist.append(nis_t / max(dof_t, 1))
    if k >= 4:
        med = np.median(nis_hist[-5:])
        lam = float(np.clip(lam * max(med, 1e-3) ** 0.5, 1.0, LAM_MAX))
    diag["lam_used_next"] = None  # placeholder removed below
    diag.pop("lam_used_next", None)

    # ---------------- resampling ----------------
    if ess < N_PART / 2.0:
        idx = systematic_resample(logw, RNG)
        X = X[:, idx]
        # roughening: proportional to ensemble spread with an absolute floor
        # so a collapsed cloud regains diversity (units: px, py, vx, vy,
        # omega, b_r, b_b)
        floor = np.array([0.015, 0.015, 0.008, 0.008, 0.004, 0.002, 0.0008])
        hscale = N_PART ** (-1.0 / 7.0)
        spread = np.maximum(hscale * X.std(axis=1, keepdims=True) * 0.2,
                            floor[:, None] * 0.5)
        X = X + spread * RNG.standard_normal((7, N_PART))
        X[4] = np.clip(X[4], -0.5, 0.5)
        logw = np.full(N_PART, -np.log(N_PART))
        resampled_flags[k] = 1

    diag["ess"][k] = ess
    diag["resampled"][k] = resampled_flags[k]
    diag["weight_entropy"][k] = entropy
    diag["max_log_weight"][k] = float(logw.max())
    diag["min_log_weight"][k] = float(logw.min())

# ----------------------------------------------------------------------
# backward-simulation particle smoother (reference for error proxies)
store_X = np.array(store_X)                # (T, 7, N)
store_lw = np.array(store_lw)              # (T, N)

def trans_mu_q(Xk, lam_k):
    """deterministic part and diagonal Q of transition Xk -> Xk+1"""
    qv = Q_V0 * np.sqrt(lam_k)
    qom = Q_OM0 * np.sqrt(lam_k)
    th = Xk[4] * DT
    c, s = np.cos(th), np.sin(th)
    vx_r = c * Xk[2] - s * Xk[3]
    vy_r = s * Xk[2] + c * Xk[3]
    mu = np.vstack([Xk[0] + vx_r * DT, Xk[1] + vy_r * DT, vx_r, vy_r,
                    Xk[4], Xk[5], Xk[6]])               # (7, N)
    q = np.array([qv ** 2 + qv ** 2, qv ** 2 + qv ** 2, qv ** 2, qv ** 2,
                  qom ** 2, Q_BR ** 2, Q_BB ** 2])
    return mu, q

smoother_sum = np.zeros((T, 4))
for m in range(SMOOTH_M):
    wl = np.exp(store_lw[-1])
    wl /= wl.sum()
    j = RNG.choice(N_PART, p=wl)
    traj = np.zeros((T, 7))
    traj[-1] = store_X[-1][:, j]
    for k in range(T - 2, -1, -1):
        Xk = store_X[k]
        mu, q = trans_mu_q(Xk, lam_hist[k + 1])
        dd = traj[k + 1][:, None] - mu                  # (7, N)
        logp = -0.5 * np.sum(dd ** 2 / q[:, None], axis=0) \
               - 0.5 * np.sum(np.log(2 * np.pi * q))
        lp = store_lw[k] + logp
        lp -= lp.max()
        p = np.exp(lp)
        psum = p.sum()
        if not np.isfinite(psum) or psum <= 0:
            p = np.ones(N_PART) / N_PART
        else:
            p = p / psum
        j = RNG.choice(N_PART, p=p)
        traj[k] = Xk[:, j]
    smoother_sum += traj[:, :4]
smoother_mean = smoother_sum / SMOOTH_M

rmse_pos = np.hypot(est[:, 0] - smoother_mean[:, 0], est[:, 1] - smoother_mean[:, 1])
rmse_vel = np.hypot(est[:, 2] - smoother_mean[:, 2], est[:, 3] - smoother_mean[:, 3])
diag["rmse_pos"] = rmse_pos
diag["rmse_vel"] = rmse_vel
nees = np.where(np.isfinite(diag["nis_raw"]), diag["nis_raw"], 0.0)

# ----------------------------------------------------------------------
# outputs
os.makedirs("results", exist_ok=True)

state_df = pd.DataFrame({
    "t": t, "px": est[:, 0], "py": est[:, 1], "vx": est[:, 2], "vy": est[:, 3],
    "cov_px": cov_diag[:, 0], "cov_py": cov_diag[:, 1],
    "cov_vx": cov_diag[:, 2], "cov_vy": cov_diag[:, 3]})
for col in state_df.columns:
    v = state_df[col].to_numpy(dtype=float)
    assert np.all(np.isfinite(v)), col
state_df.to_csv("results/state_estimates.csv", index=False)

diag_df = pd.DataFrame({
    "t": t,
    "rmse_pos": diag["rmse_pos"], "rmse_vel": diag["rmse_vel"],
    "nees": nees, "ess": diag["ess"], "resampled": resampled_flags.astype(float),
    "weight_entropy": diag["weight_entropy"],
    "max_log_weight": diag["max_log_weight"], "min_log_weight": diag["min_log_weight"],
    "bearing_residual_mean": diag["bearing_residual_mean"],
    "bearing_residual_std": diag["bearing_residual_std"]})
for col in diag_df.columns:
    v = diag_df[col].to_numpy(dtype=float)
    v = np.where(np.isfinite(v), v, 0.0)
    diag_df[col] = v
diag_df.to_csv("results/filter_diagnostics.csv", index=False)

def rms(x):
    return float(np.sqrt(np.mean(np.asarray(x, dtype=float) ** 2)))

summary = {
    "pos_rmse": rms(diag["rmse_pos"]),
    "vel_rmse": rms(diag["rmse_vel"]),
    "mean_nees": float(np.mean(nees)),
    "median_nees": float(np.median(nees)),
    "ess_min": float(np.min(diag["ess"])),
    "ess_mean": float(np.mean(diag["ess"])),
    "resampling_count": int(resampled_flags.sum()),
    "weight_degeneracy_detected": bool(np.min(diag["ess"]) < N_PART / 2.0),
    "used_log_weights": True,
    "angle_wrapping_detected": bool(wrap_events > 0),
    "angle_wrap_event_count": int(wrap_events),
}
for key, val in summary.items():
    if isinstance(val, float):
        assert np.isfinite(val), key
with open("results/summary.json", "w") as f:
    json.dump(summary, f, indent=2)


