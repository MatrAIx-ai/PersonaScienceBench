CANVAS = np.full((1200, 1600, 3), 255, dtype=np.uint8)

def px_set(x, y, col):
    xi, yi = int(round(x)), int(round(y))
    if 0 <= xi < CANVAS.shape[1] and 0 <= yi < CANVAS.shape[0]:
        CANVAS[yi, xi] = col

def draw_line(x0, y0, x1, y1, col, thick=2):
    n = int(max(abs(x1 - x0), abs(y1 - y0))) + 1
    for i in range(n + 1):
        x = x0 + (x1 - x0) * i / max(n, 1)
        y = y0 + (y1 - y0) * i / max(n, 1)
        for dx in range(-(thick // 2), thick // 2 + 1):
            for dy in range(-(thick // 2), thick // 2 + 1):
                px_set(x + dx, y + dy, col)

def draw_dot(x, y, col, r=2):
    for dx in range(-r, r + 1):
        for dy in range(-r, r + 1):
            if dx * dx + dy * dy <= r * r:
                px_set(x + dx, y + dy, col)

def draw_text(x, y, s, col, scale=2):
    for ci, ch in enumerate(str(s).upper()):
        g = FONT.get(ch, FONT[' '])
        for ry in range(7):
            row = g[ry]
            for rx in range(5):
                if row & (1 << (4 - rx)):
                    for sx in range(scale):
                        for sy in range(scale):
                            px_set(x + ci * 6 * scale + rx * scale + sx,
                                   y + ry * scale + sy, col)

def write_png(path, arr):
    h, w, _ = arr.shape
    raw = b''.join(b'\x00' + arr[i].tobytes() for i in range(h))
    def chunk(tag, data):
        c = struct.pack('>I', len(data)) + tag + data
        return c + struct.pack('>I', zlib.crc32(tag + data) & 0xffffffff)
    png = (b'\x89PNG\r\n\x1a\n'
           + chunk(b'IHDR', struct.pack('>IIBBBBB', w, h, 8, 2, 0, 0, 0))
           + chunk(b'IDAT', zlib.compress(raw, 6))
           + chunk(b'IEND', b''))
    with open(path, 'wb') as f:
        f.write(png)

BLUE = (30, 60, 200); GREEN = (0, 140, 70); GRAY = (160, 160, 160)
RED = (220, 40, 40); BLACK = (0, 0, 0); ORANGE = (235, 130, 0)
PURPLE = (120, 40, 160)

class Panel:
    def __init__(self, x0, y0, x1, y1, title):
        self.x0, self.y0, self.x1, self.y1 = x0, y0, x1, y1
        draw_line(x0, y1, x1, y1, BLACK, 2)   # x axis (bottom)
        draw_line(x0, y0, x0, y1, BLACK, 2)   # y axis (left)
        draw_text(x0, y0 - 26, title, BLACK, 2)
    def map(self, xs, ys, xr, yr):
        fx = (np.asarray(xs) - xr[0]) / (xr[1] - xr[0])
        fy = (np.asarray(ys) - yr[0]) / (yr[1] - yr[0])
        return self.x0 + fx * (self.x1 - self.x0), self.y1 - fy * (self.y1 - self.y0)

def draw_axes_labels(pan, xr, yr, xlab, ylab):
    for frac in (0.0, 0.5, 1.0):
        xv = xr[0] + frac * (xr[1] - xr[0])
        yv = yr[0] + frac * (yr[1] - yr[0])
        X, Y = pan.map([xv], [yv], xr, yr)
        draw_text(X[0] - 10, pan.y1 + 6, ('%.2f' % xv), BLACK, 1)
        draw_text(pan.x0 - 62, Y[0] - 6, ('%.2f' % yv), BLACK, 1)
    draw_text((pan.x0 + pan.x1) / 2 - 30, pan.y1 + 24, xlab, BLACK, 2)
    draw_text(pan.x0 - 96, (pan.y0 + pan.y1) / 2, ylab, BLACK, 2)

