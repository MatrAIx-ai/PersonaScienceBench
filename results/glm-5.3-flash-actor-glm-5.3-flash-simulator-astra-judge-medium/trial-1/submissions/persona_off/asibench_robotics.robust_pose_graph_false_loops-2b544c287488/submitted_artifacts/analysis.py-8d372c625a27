#!/usr/bin/env python3
"""
Robust SE(2) pose-graph optimization for the mobile-robot map-consistency task
(episode: robotics.robust_pose_graph_false_loops).

Pipeline (deterministic, CPU-only, numpy/scipy):
  0. Load inputs, reproduce poses_initial from the odometry chain (sanity check),
     unwrap headings along the chain.
  1. Structure diagnostics: motion periodicity of the odometry chain, anomalous
     lap-boundary odometry edges, loop-candidate gap structure, raw residuals.
  2. Stage A - coarse lap-graph alignment: the chain's within-lap relative shape
     is shared across laps; a small SE(2) problem over the lap origins is solved
     against all loop closures (robust Huber).
  3. Stage B - unfold to a full [544,3] initialization and refine with sparse
     Levenberg-Marquardt (analytic Jacobians, pose 0 anchored as world gauge).
  4. Stage C - robust graduated re-weighting (GNC-style Geman-McClure influence,
     mu annealed) over ALL edges so inconsistent edges are rejected without
     hand-picking; weights refreshed every outer iteration.
  5. Stage D - hard inlier/outlier classification (chi2(3) 99% quantile) and a
     final least-squares polish on inliers only.
  6. loop_closure_scores.csv: false_probability from a two-component EM mixture
     on the final per-loop chi2 (inlier: scaled chi2(3); outlier: free-scale,
     free-dof chi2). Raw chi2 values are reported in metrics.json.
  7. Sensitivity: kernel-variant partitions, non-robust and all-loops-rejected
     reference costs, chain-deformation statistics under both sigma readings.
  8. map_diagnostics.png is rendered with a pure-numpy rasterizer + zlib PNG
     encoder (matplotlib is unavailable in this offline environment).

Outputs (workspace root): poses.npy, loop_closure_scores.csv, metrics.json,
map_diagnostics.png (this file is analysis.py).
"""
import json
import struct
import time
import zlib

import numpy as np
import pandas as pd
from scipy import sparse
from scipy.optimize import least_squares
from scipy.sparse.linalg import spsolve
from scipy.stats import chi2 as chi2dist

DATA_DIR = "data"
N_EXPECT = 544
CHI2_3_Q99 = 11.345  # 99% quantile of chi2 with 3 dof


def wrap(a):
    return (a + np.pi) % (2.0 * np.pi) - np.pi


# ----------------------------------------------------------------------------
# SE(2) pose-graph core
# ----------------------------------------------------------------------------
class EdgeSet:
    def __init__(self, i, j, z, st, sr):
        self.i = np.asarray(i, int)
        self.j = np.asarray(j, int)
        self.z = np.asarray(z, float)
        self.st = np.asarray(st, float)
        self.sr = np.asarray(sr, float)
        self.M = len(self.i)


def residuals(P, g, rows):
    """e = z - h(p), h = (R_i^T (t_j - t_i), wrap(theta_j - theta_i))."""
    r = np.asarray(rows)
    Pi, Pj = P[g.i[r]], P[g.j[r]]
    c, s = np.cos(Pi[:, 2]), np.sin(Pi[:, 2])
    d = Pj[:, :2] - Pi[:, :2]
    tx = c * d[:, 0] + s * d[:, 1]
    ty = -s * d[:, 0] + c * d[:, 1]
    dth = wrap(Pj[:, 2] - Pi[:, 2])
    return np.stack([g.z[r, 0] - tx, g.z[r, 1] - ty, g.z[r, 2] - dth], axis=1)


def chi2_edges(P, g, rows):
    e = residuals(P, g, rows)
    r = np.asarray(rows)
    return (e[:, 0] ** 2 + e[:, 1] ** 2) / g.st[r] ** 2 + e[:, 2] ** 2 / g.sr[r] ** 2


def jac_weighted(P, g, rows, w):
    """Sparse Jacobian of sqrt(w)*diag(1/st,1/st,1/sr)*e wrt poses.
    de/dt_i = +R^T, de/dt_j = -R^T, de/dth_i = -[A d, -1]^T, de/dth_j = -[0,0,1]^T,
    A = dR^T/dtheta = [[-s, c], [-c, -s]]  (because e = z - h)."""
    r = np.asarray(rows)
    n = len(r)
    e = residuals(P, g, r)
    Pi = P[g.i[r]]
    c, s = np.cos(Pi[:, 2]), np.sin(Pi[:, 2])
    d = P[g.j[r], :2] - Pi[:, :2]
    Ad0 = -s * d[:, 0] + c * d[:, 1]
    Ad1 = -c * d[:, 0] - s * d[:, 1]
    swt = np.sqrt(w) / g.st[r]
    swr = np.sqrt(w) / g.sr[r]
    m = np.arange(n)
    ri, co, da = [], [], []

    def blk(rr, cc, vals):
        v = np.asarray(vals, float)
        if v.ndim == 1:
            v = v[:, None]
        ri.append(np.repeat(rr, v.shape[1]))
        co.append(np.ravel(cc))
        da.append(v.ravel())

    ii3, jj3 = 3 * g.i[r], 3 * g.j[r]
    blk(3 * m + 0, np.c_[ii3 + 0, ii3 + 1], np.stack([swt * c, swt * s], 1))
    blk(3 * m + 1, np.c_[ii3 + 0, ii3 + 1], np.stack([-swt * s, swt * c], 1))
    blk(3 * m + 0, jj3 + 0, -swt * c)
    blk(3 * m + 0, jj3 + 1, -swt * s)
    blk(3 * m + 1, jj3 + 0, swt * s)
    blk(3 * m + 1, jj3 + 1, -swt * c)
    blk(3 * m + 0, ii3 + 2, -swt * Ad0)
    blk(3 * m + 1, ii3 + 2, -swt * Ad1)
    blk(3 * m + 2, ii3 + 2, swr)
    blk(3 * m + 2, jj3 + 2, -swr)
    ri = np.concatenate(ri); co = np.concatenate(co); da = np.concatenate(da)
    J = sparse.coo_matrix((da, (ri, co)), shape=(3 * n, 3 * P.shape[0])).tocsr()
    sc = np.empty((n, 3))
    sc[:, 0] = swt; sc[:, 1] = swt; sc[:, 2] = swr
    return J, (e * sc).ravel()


def lm_solve(P, sets, anchor=0, iters=200, lam0=1e-4, verbose=False):
    """Levenberg-Marquardt on sum w_k * chi2_k over edge sets [(graph, rows, weights)].
    Pose `anchor` is fixed (world gauge). Returns (P, cost, n_iters)."""
    P = P.copy()
    Nn = P.shape[0]

    def cost(Pp):
        tot = 0.0
        for g, r, w in sets:
            rr = np.arange(g.M) if r is None else np.asarray(r)
            ww = np.ones(len(rr)) if w is None else np.asarray(w, float)
            tot += float(np.sum(ww * chi2_edges(Pp, g, rr)))
        return tot

    c0 = cost(P)
    lam = lam0
    used = 0
    for it in range(iters):
        H = sparse.csr_matrix((3 * Nn, 3 * Nn))
        gv = np.zeros(3 * Nn)
        for g, r, w in sets:
            rr = np.arange(g.M) if r is None else np.asarray(r)
            ww = np.ones(len(rr)) if w is None else np.asarray(w, float)
            J, e_s = jac_weighted(P, g, rr, ww)
            H = H + (J.T @ J)
            gv = gv + (J.T @ e_s)
        H = H.tolil()
        for a in range(3 * anchor, 3 * anchor + 3):
            H[:, a] = 0.0
            H[a, :] = 0.0
            H[a, a] = 1.0
        gv[3 * anchor:3 * anchor + 3] = 0.0
        H = H.tocsc()
        diag = np.maximum(H.diagonal(), 1e-9)
        reg = sparse.diags(diag)
        improved = False
        for _ in range(14):
            dx = spsolve((H + lam * reg).tocsc(), -gv)
            if not np.all(np.isfinite(dx)):
                lam *= 10.0
                continue
            Pn = P.copy()
            Pn[:, 0] += dx[0::3]
            Pn[:, 1] += dx[1::3]
            Pn[:, 2] += dx[2::3]
            cn = cost(Pn)
            if cn < c0:
                P, c0 = Pn, cn
                lam = max(lam * 0.4, 1e-12)
                improved = True
                break
            lam *= 10.0
        used += 1
        if verbose and it % 10 == 0:
            print(f"    LM iter {it:3d}  cost {c0:.6e}  lam {lam:.1e}")
        if not improved:
            break
        if np.abs(gv).max() < 1e-9:
            break
    return P, c0, used


def se2_comp(T, U):
    x, y, th = T
    ux, uy, uth = U
    c, s = np.cos(th), np.sin(th)
    return np.array([x + c * ux - s * uy, y + s * ux + c * uy, th + uth])


def se2_rel(Ti, Tj):
    x, y, th = Ti
    c, s = np.cos(th), np.sin(th)
    d = Tj[:2] - Ti[:2]
    return np.array([c * d[0] + s * d[1], -s * d[0] + c * d[1], wrap(Tj[2] - th)])


