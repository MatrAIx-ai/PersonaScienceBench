def draw_text(img, x, y, text, color, scale=2):
    for ch in text:
        glyph = FONT5x7.get(ch.upper(), FONT5x7[' '])
        for gy, row in enumerate(glyph):
            for gx, bit in enumerate(row):
                if bit == '1':
                    x0, y0 = x + gx * scale, y + gy * scale
                    img[y0:y0 + scale, x0:x0 + scale] = color
        x += 6 * scale


def draw_line(img, x0, y0, x1, y1, color, thick=1):
    dx, dy = abs(x1 - x0), abs(y1 - y0)
    sx = 1 if x0 < x1 else -1
    sy = 1 if y0 < y1 else -1
    err = dx - dy
    H, W = img.shape[:2]
    while True:
        t = thick // 2
        img[max(0, y0 - t):min(H, y0 + thick - t), max(0, x0 - t):min(W, x0 + thick - t)] = color
        if x0 == x1 and y0 == y1:
            break
        e2 = 2 * err
        if e2 > -dy:
            err -= dy; x0 += sx
        if e2 < dx:
            err += dx; y0 += sy


def draw_disc(img, cx, cy, r, color):
    H, W = img.shape[:2]
    y0, y1 = max(0, cy - r), min(H, cy + r + 1)
    x0, x1 = max(0, cx - r), min(W, cx + r + 1)
    if y0 >= y1 or x0 >= x1:
        return
    yy, xx = np.ogrid[y0:y1, x0:x1]
    mask = (yy - cy) ** 2 + (xx - cx) ** 2 <= r * r
    region = img[y0:y1, x0:x1]
    region[mask] = color


# ----------------------------------------------------------------------------
# main analysis
# ----------------------------------------------------------------------------
def main():
    t_start = time.time()
    log = {}

    # ---------------- 0. load & sanity ----------------
    poses_init = np.load(f"{DATA_DIR}/poses_initial.npy")
    odo_df = pd.read_csv(f"{DATA_DIR}/odometry_edges.csv")
    loop_df = pd.read_csv(f"{DATA_DIR}/loop_candidates.csv")
    with open(f"{DATA_DIR}/task_info.json") as f:
        task_info = json.load(f)
    N = len(poses_init)
    assert N == N_EXPECT == task_info["num_poses"]

    g_odom = EdgeSet(odo_df["from"], odo_df["to"],
                     odo_df[["dx", "dy", "dtheta"]].to_numpy(float),
                     odo_df["sigma_trans"].to_numpy(float),
                     odo_df["sigma_rot"].to_numpy(float))
    g_loop = EdgeSet(loop_df["from"], loop_df["to"],
                     loop_df[["dx", "dy", "dtheta"]].to_numpy(float),
                     loop_df["sigma_trans"].to_numpy(float),
                     loop_df["sigma_rot"].to_numpy(float))
    M, L = g_odom.M, g_loop.M
    all_o, all_l = np.arange(M), np.arange(L)

    chain = np.zeros_like(poses_init)
    chain[0] = poses_init[0]
    for k in range(M):
        chain[k + 1] = se2_comp(chain[k], g_odom.z[k])
    log["sanity"] = {
        "chain_composition_max_pos_dev_m": float(np.abs(chain[:, :2] - poses_init[:, :2]).max()),
        "chain_composition_max_theta_dev_rad_wrapped":
            float(np.abs(wrap(chain[:, 2] - poses_init[:, 2])).max()),
        "theta_storage": "poses_initial stores wrapped theta; unwrapped copy used internally; "
                         "output poses.npy re-wrapped to [-pi, pi)",
    }
    P_unw = poses_init.copy()
    P_unw[:, 2] = chain[:, 2]

    # ---------------- 1. structure diagnostics ----------------
    gaps_raw = (loop_df["to"].to_numpy(int) - loop_df["from"].to_numpy(int))
    P_per = int(np.gcd.reduce(gaps_raw))
    lag_stats = []
    for lag in range(1, min(3 * P_per, M - 1)):
        n = M - lag
        d = np.linalg.norm(g_odom.z[:n, :2] - g_odom.z[lag:lag + n, :2], axis=1)
        lag_stats.append((lag, float(np.percentile(d, 90))))
    p90_at_period = dict(lag_stats).get(P_per)
    sym_lags = [lg for lg, m in lag_stats if m < 0.5]  # edge vectors self-similar at these lags
    laps = N // P_per
    gaps = loop_df["to"].to_numpy(int) - loop_df["from"].to_numpy(int)
    boundary_idx = np.arange(P_per - 1, M, P_per)
    bsteps = np.linalg.norm(g_odom.z[boundary_idx, :2], axis=1)
    norm_steps = np.linalg.norm(np.delete(g_odom.z[:, :2], boundary_idx, axis=0), axis=1)
    chi_loop_vs_chain = chi2_edges(P_unw, g_loop, all_l)

    # loop claim connected components (union-find over loop edges)
    parent = list(range(N))

    def find(a):
        while parent[a] != a:
            parent[a] = parent[parent[a]]
            a = parent[a]
        return a

    for a, b in zip(loop_df["from"], loop_df["to"]):
        ra, rb = find(int(a)), find(int(b))
        if ra != rb:
            parent[ra] = rb
    comp_sizes = sorted(pd.Series([find(int(a)) for a in loop_df["from"]]).value_counts().tolist(),
                        reverse=True)

    log["structure_diagnostics"] = {
        "motion_period_in_edges": int(P_per),
        "period_source": "GCD of the 55 loop-candidate gaps (gap_laps = gap / period all integer)",
        "p90_edge_vector_difference_at_period_lag_m": p90_at_period,
        "self_similar_edge_lags_lt_period": [int(v) for v in sym_lags],
        "self_similarity_note": (
            "edge vectors (local frame) also match at shorter lags with a ~pi/2 heading advance per "
            "sub-period, i.e. the traversed loop is rotationally symmetric; poses only COINCIDE at the "
            "revisit period, which is why loop gaps are multiples of it"),
        "num_laps": int(laps),
        "loop_gap_unique_mod_period": sorted({int(g % P_per) for g in gaps}),
        "loop_gap_lap_multiples": sorted({int(g // P_per) for g in gaps}),
        "normal_edge_step_len_mean_m": float(norm_steps.mean()),
        "boundary_edge_step_len_m": {int(e): float(s) for e, s in zip(boundary_idx, bsteps)},
        "boundary_edge_dtheta_rad": {int(e): float(g_odom.z[e, 2]) for e in boundary_idx},
        "loop_chi2_vs_initial_chain": {
            "min": float(chi_loop_vs_chain.min()),
            "median": float(np.median(chi_loop_vs_chain)),
            "max": float(chi_loop_vs_chain.max()),
        },
        "loop_claim_component_sizes": [int(v) for v in comp_sizes],
        "reading": (
            f"the odometry edge sequence is self-similar at lags {sym_lags} "
            f"(p90 edge-vector difference ~{p90_at_period:.3f} m, vs >1.3 m at non-similar lags); "
            f"the revisit period is the GCD of the {L} loop gaps = {P_per} edges ({laps} laps); "
            f"all loop gaps are exact multiples of {P_per}; the {len(boundary_idx)} lap-boundary "
            f"odometry edges have steps {bsteps.min():.1f}-{bsteps.max():.1f} m "
            f"(vs {norm_steps.mean():.2f} m mean) while their dtheta stays near a common value, "
            f"i.e. poses_initial carries piecewise-rigid per-lap drift while the loop closures "
            f"mutually agree that the laps coincide."),
    }

    # ---------------- 2. Stage A: coarse lap-graph alignment ----------------
    Gsh = np.zeros((P_per, 3))
    for k in range(P_per):
        acc = np.zeros(3)
        for Lp in range(laps):
            i = Lp * P_per + k
            c0, s0 = np.cos(chain[Lp * P_per, 2]), np.sin(chain[Lp * P_per, 2])
            d = chain[i, :2] - chain[Lp * P_per, :2]
            acc += np.array([c0 * d[0] + s0 * d[1], -s0 * d[0] + c0 * d[1],
                             chain[i, 2] - chain[Lp * P_per, 2]])
        Gsh[k] = acc / laps

    def lap_pred(xv, Lp, k, Lq, kq):
        return se2_rel(se2_comp(xv[3 * Lp:3 * Lp + 3], Gsh[k]),
                       se2_comp(xv[3 * Lq:3 * Lq + 3], Gsh[kq]))

    def stage_a_resid(xg):
        xv = np.concatenate([poses_init[0], xg])
        out = []
        for t in range(L):
            i, j = int(loop_df["from"].iloc[t]), int(loop_df["to"].iloc[t])
            zl = loop_df.loc[t, ["dx", "dy", "dtheta"]].to_numpy(float)
            e = lap_pred(xv, i // P_per, i % P_per, j // P_per, j % P_per) - zl
            e[2] = wrap(e[2])
            out.extend(e)
        return np.array(out)

    sol_a = least_squares(stage_a_resid, chain[np.arange(laps) * P_per].ravel()[3:].copy(),
                          loss="huber", f_scale=float(np.median(g_loop.st)), max_nfev=5000)
    xv = np.concatenate([poses_init[0], sol_a.x])
    ra = sol_a.fun.reshape(-1, 3)
    chi_a = (ra[:, 0] ** 2 + ra[:, 1] ** 2) / g_loop.st[0] ** 2 + ra[:, 2] ** 2 / g_loop.sr[0] ** 2
    log["stage_A_lap_alignment"] = {
        "free_params": 3 * (laps - 1), "measurements": 3 * L,
        "chi2_total": float(chi_a.sum()),
        "chi2_per_dof": float(chi_a.sum() / (3 * L - 3 * (laps - 1))),
        "residual_trans_mean_m": float(np.linalg.norm(ra[:, :2], axis=1).mean()),
        "residual_trans_max_m": float(np.linalg.norm(ra[:, :2], axis=1).max()),
        "lap_origins_recovered_world_frame":
            [[float(v) for v in xv[3 * Lp:3 * Lp + 3]] for Lp in range(laps)],
        "lap_origin_position_spread_m": float(np.max(
            [np.linalg.norm(xv[3 * Lp:3 * Lp + 2] - xv[0:2]) for Lp in range(laps)])),
    }

    q0 = np.zeros_like(P_unw)
    for i in range(N):
        q0[i] = se2_comp(xv[3 * (i // P_per):3 * (i // P_per) + 3], Gsh[i % P_per])
    q0[0] = poses_init[0]

    # ---------------- 3. Stage B: full refinement on trusted edges ----------------
    wl_rows = np.setdiff1d(all_o, boundary_idx)
    Q, cost_b, it_b = lm_solve(q0.copy(), [(g_odom, wl_rows, None), (g_loop, all_l, None)],
                               anchor=0, iters=300)
    log["stage_B_refine"] = {
        "edges": "within-lap odometry + all loops (boundary edges excluded pending stage C)",
        "num_within_lap_edges": int(len(wl_rows)),
        "iterations": int(it_b), "chi2_total": float(cost_b),
        "chi2_within_lap_odom": float(chi2_edges(Q, g_odom, wl_rows).sum()),
        "chi2_loops": float(chi2_edges(Q, g_loop, all_l).sum()),
        "measurements": 3 * (len(wl_rows) + L), "free_params": 3 * N - 3,
        "dof": int(3 * (len(wl_rows) + L) - (3 * N - 3)),
    }

    # ---------------- 4. Stage C: robust GNC over ALL edges ----------------
    mu, mu_min, it_c_total = 1e3, 30.0, 0
    P = Q.copy()
    chi2_ref = float(chi2_edges(Q, g_odom, wl_rows).sum() + chi2_edges(Q, g_loop, all_l).sum())
    while mu > mu_min:
        w_o = (mu / (mu + chi2_edges(P, g_odom, all_o))) ** 2
        w_l = (mu / (mu + chi2_edges(P, g_loop, all_l))) ** 2
        P, _, k = lm_solve(P, [(g_odom, all_o, w_o), (g_loop, all_l, w_l)],
                           anchor=0, iters=8, lam0=1e-8)
        it_c_total += k
        mu /= 2.0
    chi_o_all = chi2_edges(P, g_odom, all_o)
    chi_l_all = chi2_edges(P, g_loop, all_l)
    chi2_after = float(chi_o_all[wl_rows].sum() + chi_l_all.sum())
    gnc_degraded = chi2_after > 2.0 * chi2_ref
    if gnc_degraded:  # safety guard: revert to the stage-B solution for classification
        P = Q.copy()
        chi_o_all = chi2_edges(P, g_odom, all_o)
        chi_l_all = chi2_edges(P, g_loop, all_l)
    log["stage_C_robust_GNC"] = {
        "gnc_degraded_and_reverted": bool(gnc_degraded),
        "kernel": "Geman-McClure influence w=(mu/(mu+chi2))^2, mu annealed 1e6 -> 30 (halved), weights refreshed each outer iteration",
        "outer_iterations": int(it_c_total),
        "chi2_within_lap_odom": float(chi_o_all[wl_rows].sum()),
        "chi2_loops": float(chi_l_all.sum()),
        "boundary_edge_chi2_after_GNC": {int(e): float(chi_o_all[e]) for e in boundary_idx},
    }

    # ---------------- 5. Stage D: hard inliers + final polish ----------------
    inl_o = np.where(chi_o_all <= CHI2_3_Q99)[0]
    inl_l = np.where(chi_l_all <= CHI2_3_Q99)[0]
    P_final, cost_d, it_d = lm_solve(P, [(g_odom, inl_o, None), (g_loop, inl_l, None)],
                                     anchor=0, iters=300)
    chi_o_fin = chi2_edges(P_final, g_odom, all_o)
    chi_l_fin = chi2_edges(P_final, g_loop, all_l)
    n_meas = 3 * (len(inl_o) + len(inl_l))
    dof = n_meas - (3 * N - 3)
    log["stage_D_final"] = {
        "inlier_odom_edges": int(len(inl_o)),
        "rejected_odom_edges": [int(e) for e in np.setdiff1d(all_o, inl_o)],
        "inlier_loops": int(len(inl_l)),
        "rejected_loops": [int(e) for e in np.setdiff1d(all_l, inl_l)],
        "iterations": int(it_d), "chi2_total_inliers": float(cost_d),
        "chi2_odom_inlier_mean": float(chi_o_fin[inl_o].mean()),
        "chi2_loop_inlier_mean": float(chi_l_fin[inl_l].mean()),
        "dof": int(dof),
        "dof_check": "expected chi2 ~ dof (144) +- sqrt(2*dof) ~ +-17 if noise model and solution are consistent",
    }

    # ---------------- 6. loop scoring (EM mixture on final chi2) ----------------
    def fit_mixture(x, c2_out=100.0, em_iters=200):
        """Two-component contamination model on final per-loop chi2:
          inlier  : c1 * chi2(3)      (c1 estimated robustly, ~1 if sigmas are correct)
          outlier : c2_out * chi2(3)  (broad contamination, c2_out = 100x)
        Posterior P(outlier|x) evaluated in log space (stable), monotone non-decreasing in chi2.
        pi_inlier is estimated by EM but floored so that a false component always exists."""
        def log_chi2pdf(xx, scale):
            t = np.asarray(xx, float) / scale
            return (-0.5 * t + 0.5 * np.log(np.maximum(t, 1e-300))
                    - 1.5 * np.log(2.0) - 0.5 * float(__import__("math").lgamma(1.5))
                    - np.log(scale))
        c1 = float(max(np.median(x) / 2.36597, 1e-3))  # chi2(3) median = 2.36597
        pi1 = 0.95
        for _ in range(em_iters):
            lf1 = np.log(pi1) + log_chi2pdf(x, c1)
            lf2 = np.log(1.0 - pi1) + log_chi2pdf(x, c2_out)
            p1 = np.exp(lf1 - np.logaddexp(lf1, lf2))
            pi1 = float(np.clip(p1.mean(), 0.50, 0.99))
            c1 = float(max(np.sum(p1 * x) / max(np.sum(p1) * 3, 1e-12), 1e-3))
        lf1 = np.log(pi1) + log_chi2pdf(x, c1)
        lf2 = np.log(1.0 - pi1) + log_chi2pdf(x, c2_out)
        p_false = np.exp(lf2 - np.logaddexp(lf1, lf2))
        return p_false, {"pi_inlier": pi1, "scale_inlier": c1, "scale_outlier": c2_out,
                         "note": "contamination model: outlier component = 100x-scale chi2(3); "
                                 "posteriors computed in log space"}
    p_false, mix_params = fit_mixture(chi_l_fin)
    pd.DataFrame({
        "loop_id": loop_df["loop_id"].to_numpy(int),
        "false_probability": [float(v) for v in p_false],
    }).to_csv("loop_closure_scores.csv", index=False)
    log["loop_scoring"] = {
        "method": "two-component contamination mixture on final per-loop chi2: inlier ~ "
                  "c1*chi2(3) (c1 estimated), outlier ~ 100*c1-scale chi2(3); "
                  "false_probability = posterior P(outlier | chi2), log-space evaluation",
        "mixture_params": mix_params,
        "accepted_loops_false_prob<0.5": int((p_false < 0.5).sum()),
    }

    # ---------------- 7. sensitivity & reference hypotheses ----------------
    kernels = {
        "Geman-McClure(mu=30)": lambda u: (30.0 / (30.0 + u)) ** 2,
        "Tukey(c2=11.34)": lambda u: np.where(u < 11.34, (1 - u / 11.34) ** 2, 0.0),
        "Tukey(c2=7)": lambda u: np.where(u < 7.0, (1 - u / 7.0) ** 2, 0.0),
        "Tukey(c2=20)": lambda u: np.where(u < 20.0, (1 - u / 20.0) ** 2, 0.0),
        "Huber(delta2=9)": lambda u: np.minimum(1.0, 3.0 / np.sqrt(np.maximum(u, 1e-12))),
        "Cauchy(c2=11.34)": lambda u: 1.0 / (1.0 + u / 11.34),
    }
    ref_part_l = chi_l_fin <= CHI2_3_Q99
    sens = {}
    for name, wf in kernels.items():
        Pv = P_final.copy()
        for _ in range(30):
            w_o = wf(chi2_edges(Pv, g_odom, all_o))
            w_l = wf(chi2_edges(Pv, g_loop, all_l))
            Pv, _, _ = lm_solve(Pv, [(g_odom, all_o, w_o), (g_loop, all_l, w_l)],
                                anchor=0, iters=3, lam0=1e-8)
        part_l = chi2_edges(Pv, g_loop, all_l) <= CHI2_3_Q99
        part_o = chi2_edges(Pv, g_odom, all_o) <= CHI2_3_Q99
        union = int(np.sum(part_l | ref_part_l))
        sens[name] = {
            "accepted_loops": int(part_l.sum()),
            "rejected_loops": [int(loop_df["loop_id"].iloc[k]) for k in np.where(~part_l)[0]],
            "accepted_odom_edges": int(part_o.sum()),
            "max_final_loop_chi2": float(chi2_edges(Pv, g_loop, all_l).max()),
            "jaccard_vs_primary_loop_partition":
                float(np.sum(part_l & ref_part_l) / union) if union else 1.0,
        }
    log["sensitivity_kernels"] = sens

    Pn, cn, _ = lm_solve(P_final.copy(), [(g_odom, all_o, None), (g_loop, all_l, None)],
                         anchor=0, iters=100)
    log["reference_nonrobust_PGO"] = {
        "description": "plain least squares on ALL 598 edges from the refined init (no robustness)",
        "chi2_total": float(cn),
        "min_boundary_edge_chi2": float(chi2_edges(Pn, g_odom, boundary_idx).min()),
        "note": "the 7 inconsistent lap-boundary odometry edges (chi2 up to ~1.6e5) dominate the "
                "objective and drag the solution; this is the failure mode the robust pipeline prevents",
    }
    log["reference_all_loops_rejected"] = {
        "description": "trajectory = poses_initial (pure odometry chain), all 55 loops treated as outliers",
        "chi2_odom": 0.0,
        "chi2_loops_total": float(chi_loop_vs_chain.sum()),
        "chi2_loops_min": float(chi_loop_vs_chain.min()),
        "note": "against the chain every loop is a ~9-4500 sigma outlier; treating all 55 mutually "
                "consistent claims (gaps exactly multiples of the 68-edge motion period, residuals "
                "~N(0, sigma_loop)) as simultaneous gross errors is not a tenable noise model",
    }

    # ---------------- correction / deformation statistics ----------------
    dp = np.linalg.norm(P_final[:, :2] - poses_init[:, :2], axis=1)
    dth = np.abs(wrap(P_final[:, 2] - poses_init[:, 2]))
    per_lap_mean, per_lap_max = [], []
    for Lp in range(laps):
        sel = slice(Lp * P_per, (Lp + 1) * P_per)
        per_lap_mean.append(float(dp[sel].mean()))
        per_lap_max.append(float(dp[sel].max()))
    loop_phases = sorted({int(v) for v in np.concatenate([
        loop_df["from"].to_numpy(int) % P_per, loop_df["to"].to_numpy(int) % P_per])})
    disp_cov, disp_uncov = [], []
    for k in range(P_per):
        for Lp in range(1, laps):
            d = float(np.linalg.norm(P_final[Lp * P_per + k, :2] - P_final[k, :2]))
            (disp_cov if k in set(loop_phases) else disp_uncov).append(d)
    rw = float(np.sqrt(2.0 * (P_per - 1)) * g_odom.st[0])  # within-lap random-walk scale
    log["lap_coincidence_check"] = {
        "description": "phase-aligned cross-lap pose differences in the final solution "
                       "(0 if the laps coincide exactly)",
        "loop_covered_phases": loop_phases,
        "rms_spread_loop_covered_phases_m": float(np.sqrt(np.mean(np.square(disp_cov)))),
        "max_spread_loop_covered_phases_m": float(np.max(disp_cov)),
        "rms_spread_uncovered_phases_m": float(np.sqrt(np.mean(np.square(disp_uncov)))),
        "max_spread_uncovered_phases_m": float(np.max(disp_uncov)),
        "expected_within_lap_random_walk_scale_m": rw,
        "note": ("phases touched by loop closures agree across laps at the loop-closure noise level; "
                 "phases without any loop closure (their relative placement rests only on within-lap "
                 "odometry, a sqrt(%d)-edge random walk of scale %.2f m per axis) spread more - this is "
                 "the irreducible uncertainty of the given measurement graph, not an inconsistency"
                 % (P_per - 1, rw)),
    }
    # rotation-only consistency of the rejected odometry edges (diagnostic: were they
    # translation-only corruptions?)
    rej_o = np.setdiff1d(all_o, inl_o)
    e_rej = residuals(P_final, g_odom, rej_o)
    log["rejected_odom_edge_detail"] = {
        "edges": [int(e) for e in rej_o],
        "trans_residual_m": [float(np.hypot(*r)) for r in e_rej[:, :2]],
        "rot_residual_rad": [float(r) for r in e_rej[:, 2]],
        "rot_chi2": [float(r ** 2 / g_odom.sr[rej_o[k]] ** 2) for k, r in enumerate(e_rej[:, 2])],
    }

    log["chain_deformation"] = {
        "per_pose_correction_m": {"mean": float(dp.mean()), "rms": float(np.sqrt((dp ** 2).mean())),
                                  "median": float(np.median(dp)), "max": float(dp.max())},
        "per_pose_theta_correction_rad_max": float(dth.max()),
        "poses_moved_gt_0p5m": int((dp > 0.5).sum()),
        "poses_moved_gt_2m": int((dp > 2.0).sum()),
        "per_lap_mean_correction_m": per_lap_mean,
        "per_lap_max_correction_m": per_lap_max,
        "per_edge_equivalent_correction_m_if_spread_over_lap": [m / P_per for m in per_lap_mean],
        "interpretation": (
            "corrections are piecewise-rigid per-lap offsets: within-lap relative geometry is preserved "
            "to noise level, so the deformation is NOT spread along the chain. Under the stated iid "
            "per-edge sigma_trans=0.0478 m reading, a single 18.3 m boundary-edge error is ~380 sigma "
            "(impossible as iid noise), and spreading a ~24 m lap correction over 68 edges would need "
            "~0.36 m/edge (~7.5 sigma per edge) - also inconsistent. Hence poses_initial carries "
            "systematic per-lap drift (bias); the appropriate treatment is robust re-weighting, and the "
            "7 boundary edges that encode the drift increments are rejected."
        ),
    }

    # ---------------- 8. outputs ----------------
    out = P_final.copy()
    out[:, 2] = wrap(out[:, 2])
    np.save("poses.npy", out.astype(np.float64))

    inl_l_set = set(inl_l.tolist())
    per_loop_table = []
    for k in range(L):
        per_loop_table.append({
            "loop_id": int(loop_df["loop_id"].iloc[k]),
            "from": int(loop_df["from"].iloc[k]), "to": int(loop_df["to"].iloc[k]),
            "gap_laps": int(gaps[k] // P_per),
            "chi2_initial_vs_chain": float(chi_loop_vs_chain[k]),
            "chi2_final": float(chi_l_fin[k]),
            "false_probability": float(p_false[k]),
            "used_in_final_solution": bool(k in inl_l_set),
        })
    metrics = {
        "episode": "asibench:robotics.robust_pose_graph_false_loops",
        "inputs": {
            "num_poses": int(N), "num_odometry_edges": int(M), "num_loop_candidates": int(L),
            "odometry_sigma_trans": float(g_odom.st[0]), "odometry_sigma_rot": float(g_odom.sr[0]),
            "loop_sigma_trans": float(g_loop.st[0]), "loop_sigma_rot": float(g_loop.sr[0]),
            "pose_convention": task_info["pose_convention"],
            "edge_convention": task_info["edge_convention"],
            "world_frame_anchor": task_info["world_frame_anchor"],
        },
        "method": {
            "summary": "robust SE(2) pose-graph optimization: coarse lap-graph alignment -> sparse LM "
                       "refinement -> GNC-Geman-McClure graduated re-weighting over all edges -> hard "
                       "inlier classification -> final polish; pose 0 anchored as world gauge; headings "
                       "unwrapped internally and re-wrapped on output",
            "robust_kernel": "Geman-McClure influence w=(mu/(mu+chi2))^2 with GNC annealing "
                             "(mu: 1e3 -> 30, halved, weights refreshed each outer iteration); "
                             "inlier threshold chi2(3) 99% quantile = 11.345",
            "deterministic": True,
        },
        "pipeline_log": log,
        "final_solution": {
            "chi2_total_inliers": float(cost_d),
            "chi2_per_dof": float(cost_d / max(dof, 1)),
            "odom_edges_used": int(len(inl_o)), "loops_used": int(len(inl_l)),
            "false_probability_max": float(p_false.max()),
            "false_probability_median": float(np.median(p_false)),
        },
        "per_loop_table": per_loop_table,
        "runtime_seconds": round(time.time() - t_start, 2),
        "software": {"numpy": np.__version__, "scipy": __import__("scipy").__version__,
                     "note": "matplotlib unavailable offline; PNG hand-encoded (numpy+zlib)"},
    }
    with open("metrics.json", "w") as f:
        json.dump(metrics, f, indent=2)

    odom_out_mask = chi_o_fin > CHI2_3_Q99
    render_diagnostics(poses_init, P_final, loop_df, p_false, boundary_idx, odom_out_mask, chi_l_fin)
    print("analysis complete; runtime %.1f s" % (time.time() - t_start))
    print("final: chi2=%.1f, odom inliers %d/543, loop inliers %d/55, max false_prob %.3f"
          % (cost_d, len(inl_o), len(inl_l), p_false.max()))
    return P_final, p_false, metrics


def render_diagnostics(poses_init, P_final, loop_df, p_false, boundary_idx, odom_out_mask, chi_loop_vals):
    W, H = 1600, 1150
    img = np.full((H, W, 3), 255, np.uint8)
    C_GRID = np.array([232, 232, 232], np.uint8)
    C_TXT = np.array([35, 35, 35], np.uint8)
    C_INIT = np.array([180, 180, 180], np.uint8)
    C_FIN = np.array([25, 85, 175], np.uint8)
    C_ACC = np.array([25, 140, 70], np.uint8)
    C_REJ = np.array([210, 45, 45], np.uint8)
    C_BAD = np.array([235, 140, 30], np.uint8)

    ml, mr, mt, map_h = 90, 40, 100, 740
    pts = np.vstack([poses_init[:, :2], P_final[:, :2]])
    lo, hi = pts.min(0), pts.max(0)
    span = np.maximum(hi - lo, 1e-6) + 4.0
    sc = min((W - ml - mr) / span[0], map_h / span[1])
    ox = ml + ((W - ml - mr) - span[0] * sc) / 2.0
    oy = mt + (map_h - span[1] * sc) / 2.0

    def w2p(pt):
        return int(round(ox + (pt[0] - lo[0]) * sc)), int(round(oy + (hi[1] - pt[1]) * sc))

    for gx in np.arange(np.floor(lo[0] / 5) * 5, hi[0] + 5, 5):
        px, _ = w2p([gx, 0])
        draw_line(img, px, mt, px, mt + map_h, C_GRID)
        draw_text(img, px - 5, mt + map_h + 6, f"{gx:.0f}", C_TXT, 2)
    for gy in np.arange(np.floor(lo[1] / 5) * 5, hi[1] + 5, 5):
        _, py = w2p([0, gy])
        draw_line(img, ml, py, W - mr, py, C_GRID)
        draw_text(img, 16, py - 7, f"{gy:.0f}", C_TXT, 2)
    draw_text(img, W // 2 - 40, mt + map_h + 32, "X (M)", C_TXT, 2)
    draw_text(img, 14, mt - 36, "Y (M)", C_TXT, 2)

    for traj, col, th in ((poses_init, C_INIT, 1), (P_final, C_FIN, 2)):
        for k in range(len(traj) - 1):
            x0, y0 = w2p(traj[k]); x1, y1 = w2p(traj[k + 1])
            draw_line(img, x0, y0, x1, y1, col, th)
    for e in boundary_idx:
        if odom_out_mask[e]:
            x0, y0 = w2p(poses_init[e]); x1, y1 = w2p(poses_init[e + 1])
            draw_line(img, x0, y0, x1, y1, C_BAD, 3)
    for t in range(len(loop_df)):
        i, j = int(loop_df["from"].iloc[t]), int(loop_df["to"].iloc[t])
        col = C_ACC if p_false[t] < 0.5 else C_REJ
        x0, y0 = w2p(P_final[i]); x1, y1 = w2p(P_final[j])
        draw_line(img, x0, y0, x1, y1, col, 2)
    sx, sy = w2p(P_final[0])
    draw_disc(img, sx, sy, 6, np.array([0, 0, 0], np.uint8))
    draw_text(img, sx + 9, sy - 9, "S", C_TXT, 2)

    ly = mt + 6
    draw_line(img, W - mr - 268, ly + 6, W - mr - 226, ly + 6, C_INIT, 3)
    draw_text(img, W - mr - 218, ly, "INITIAL (ODOMETRY)", C_TXT, 2)
    draw_line(img, W - mr - 268, ly + 30, W - mr - 226, ly + 30, C_FIN, 3)
    draw_text(img, W - mr - 218, ly + 24, "ROBUST SOLUTION", C_TXT, 2)
    draw_line(img, W - mr - 268, ly + 54, W - mr - 226, ly + 54, C_ACC, 3)
    draw_text(img, W - mr - 218, ly + 48, "LOOP: FALSE PROB < 0.5", C_TXT, 2)
    draw_line(img, W - mr - 268, ly + 78, W - mr - 226, ly + 78, C_REJ, 3)
    draw_text(img, W - mr - 218, ly + 72, "LOOP: FALSE PROB >= 0.5", C_TXT, 2)
    draw_line(img, W - mr - 268, ly + 102, W - mr - 226, ly + 102, C_BAD, 3)
    draw_text(img, W - mr - 218, ly + 96, "OUTLIER ODOMETRY EDGE", C_TXT, 2)
    draw_text(img, ml, 30, "ROBUST POSE-GRAPH DIAGNOSTICS", C_TXT, 3)
    draw_text(img, ml, 62, "544 POSES / 543 ODOMETRY EDGES / 55 LOOP CANDIDATES", C_TXT, 2)

    # bottom panels: left = false probability (log scale), right = per-loop final chi2 (log scale)
    by0, by1 = mt + map_h + 68, H - 62
    x_split = ml + int(0.56 * (W - ml - mr))
    for (px0, px1, title, vals, vthr, vlog_lo, vlog_hi) in (
            (ml, x_split - 12, "PER-LOOP FALSE PROBABILITY (LOG SCALE)",
             [max(float(v), 1e-9) for v in p_false], 0.5, 1e-8, 1.0),
            (x_split + 12, W - mr, "PER-LOOP FINAL CHI2 (LOG SCALE)",
             [max(float(v), 1e-3) for v in chi_loop_vals], CHI2_3_Q99, 1e-2, 1e5)):
        draw_line(img, px0, by1, px1, by1, C_TXT, 1)
        draw_line(img, px0, by0, px0, by1, C_TXT, 1)
        nn = len(vals)
        bwd = (px1 - px0) / nn
        for t in range(nn):
            lv = np.log10(vals[t])
            frac = (lv - np.log10(vlog_lo)) / (np.log10(vlog_hi) - np.log10(vlog_lo))
            frac = float(np.clip(frac, 0.02, 1.0))
            bh = int(frac * (by1 - by0 - 24))
            col = C_ACC if vals[t] < (0.5 if vthr == 0.5 else CHI2_3_Q99) else C_REJ
            x0 = int(px0 + t * bwd + bwd * 0.15)
            img[by1 - bh:by1, x0:x0 + max(2, int(bwd * 0.7))] = col
        ythr = by1 - int((np.log10(vthr) - np.log10(vlog_lo)) /
                         (np.log10(vlog_hi) - np.log10(vlog_lo)) * (by1 - by0 - 24))
        draw_line(img, px0, ythr, px1, ythr, C_REJ, 1)
        draw_text(img, px0 + 4, by0 - 22, title, C_TXT, 2)
        for t in range(0, nn, 10):
            draw_text(img, int(px0 + t * bwd), by1 + 6, str(int(loop_df["loop_id"].iloc[t])), C_TXT, 2)
    draw_text(img, ml, H - 34, "LOOP ID (TICKS EVERY 10)", C_TXT, 2)
    write_png("map_diagnostics.png", img)


if __name__ == "__main__":
    main()
