"""
TASK008 BCG-CORONA: Chi-square analysis of COVID-19 severity (BCG vs Placebo)
within patient-volume groups (DM.patients_seen).

Primary outcome (subject-level, binary):
  'More severe COVID-19' = most severe COVID-19-related AE has AESEV >= 2
  'Mild/none'            = all COVID-19 AEs AESEV == 1, or no COVID-19 AE
COVID-19 AEs: AEPT in {COVID-19, COVID-19 pneumonia, Asymptomatic COVID-19,
SARS-CoV-2 test positive}.
Strata: patients_seen in {'1-50','51-100','>100'}.
Test: scipy.stats.chi2_contingency per 2x2 (arm x severity); Fisher exact if any
expected count < 5. Sensitivities: AEHS>=3 threshold; COVID-AE subjects only;
outcome-based severity (AEOUT Worse/Fatal or AESER=Yes). Supplementary:
multi-level AESEV (1-4, incl. 0 for no-COVID) x arm chi-square per group.
"""
import pandas as pd
import numpy as np
from scipy.stats import chi2_contingency, fisher_exact

DATA = "/workspace/data"
COVID_PTS = {"COVID-19", "COVID-19 pneumonia", "Asymptomatic COVID-19",
             "SARS-CoV-2 test positive"}

dm = pd.read_csv(f"{DATA}/TASK008_BCG-CORONA_DM.csv")
ae = pd.read_csv(f"{DATA}/TASK008_BCG-CORONA_AE.csv")

covid = ae[ae["AEPT"].isin(COVID_PTS)].copy()
print(f"COVID-19-related AE rows: {len(covid)} in {covid.USUBJID.nunique()} subjects")

def subj_max(frame, col):
    return frame.groupby("USUBJID")[col].max()

# Subject-level severity measures from COVID-19 AEs
max_sev = subj_max(covid, "AESEV")            # 1-4
max_hs  = subj_max(covid, "AEHS")             # 0-7
severe_out = covid.assign(flag=((covid.AEOUT.isin(["Worse", "Fatal"])) |
                                (covid.AESER == "Yes")).astype(int))
max_out = severe_out.groupby("USUBJID")["flag"].max()

sub = dm[["USUBJID", "TRTGRP", "patients_seen"]].copy()
sub = sub.merge(max_sev.rename("maxAESEV"), on="USUBJID", how="left")
sub = sub.merge(max_hs.rename("maxAEHS"), on="USUBJID", how="left")
sub = sub.merge(max_out.rename("sevOutcome"), on="USUBJID", how="left")
sub["hasCOVID"] = sub["USUBJID"].isin(covid.USUBJID).astype(int)

for v in ["maxAESEV", "maxAEHS", "sevOutcome"]:
    sub[v] = sub[v].fillna(0)  # no COVID AE -> 0 (none/mild)

def run_2x2(df, sevcol, threshold, label, restrict_covid=False):
    d = df[df.hasCOVID == 1] if restrict_covid else df
    d = d.assign(sev=(d[sevcol] >= threshold).astype(int))
    rows = []
    for grp in ["1-50", "51-100", ">100"]:
        g = d[d.patients_seen == grp]
        tab = pd.crosstab(g.TRTGRP, g.sev).reindex(index=["BCG", "Placebo"],
                                                   columns=[0, 1], fill_value=0)
        chi2, p, dof, exp = chi2_contingency(tab)
        fisher = None
        note = "chi-square"
        if (exp < 5).any():
            orr, pf = fisher_exact(tab)
            fisher, p, note = orr, pf, "Fisher (expected<5)"
        rows.append({
            "analysis": label, "group": grp, "n": len(g),
            "BCG_severe": int(tab.loc["BCG", 1]), "BCG_total": int(tab.loc["BCG"].sum()),
            "Placebo_severe": int(tab.loc["Placebo", 1]),
            "Placebo_total": int(tab.loc["Placebo"].sum()),
            "chi2": round(chi2, 4), "dof": dof,
            "min_expected": round(exp.min(), 2),
            "p_value": round(p, 5), "test": note,
            "fisher_p": round(fisher, 5) if fisher is not None else "",
            "p_lt_0.05": p < 0.05,
        })
    res = pd.DataFrame(rows)
    print(f"\n=== {label} ===")
    print(res.to_string(index=False))
    return res

results = []
results.append(run_2x2(sub, "maxAESEV", 2, "PRIMARY: binary, max AESEV>=2 among COVID AEs (no-COVID=mild/none)"))
results.append(run_2x2(sub, "maxAEHS", 3, "SENSITIVITY: binary, max AEHS>=3 (no-COVID=0)"))
results.append(run_2x2(sub, "maxAESEV", 2, "SENSITIVITY: AESEV>=2 restricted to subjects WITH COVID-19 AE", restrict_covid=True))
results.append(run_2x2(sub, "sevOutcome", 1, "SENSITIVITY: outcome-based (AEOUT Worse/Fatal or AESER=Yes)"))

# Supplementary: multi-level severity (max AESEV level incl. 0=no COVID AE) x arm
print("\n=== SUPPLEMENTARY: multi-level max AESEV (0=no COVID AE, 1-4) x arm, chi-square per volume group ===")
multi_rows = []
for grp in ["1-50", "51-100", ">100"]:
    g = sub[sub.patients_seen == grp]
    tab = pd.crosstab(g.TRTGRP, g.maxAESEV).reindex(index=["BCG", "Placebo"],
                                                    columns=[0, 1, 2, 3, 4], fill_value=0)
    tab_nz = tab.loc[:, tab.sum(axis=0) > 0]  # drop all-zero severity columns
    chi2, p, dof, exp = chi2_contingency(tab_nz)
    multi_rows.append({"group": grp, "n": len(g), "chi2": round(chi2, 4),
                       "dof": dof, "p_value": round(p, 5),
                       "min_expected": round(exp.min(), 2), "p_lt_0.05": p < 0.05})
    print(f"\nGroup {grp} contingency table (rows=arm, cols=max AESEV level):")
    print(tab.to_string())
multi = pd.DataFrame(multi_rows)
print()
print(multi.to_string(index=False))
results.append(multi)

out = pd.concat(results, ignore_index=True)
out.to_csv("/workspace/analysis/task008_chi_square_results.csv", index=False)
print("\nSaved: /workspace/analysis/task008_chi_square_results.csv")

# Answer basis: PRIMARY analysis groups with p<0.05
prim = results[0]
sig = prim[prim["p_lt_0.05"]]["group"].tolist()
print(f"\nANSWER BASIS (primary): groups with p<0.05 -> {sig if sig else 'none'}")
