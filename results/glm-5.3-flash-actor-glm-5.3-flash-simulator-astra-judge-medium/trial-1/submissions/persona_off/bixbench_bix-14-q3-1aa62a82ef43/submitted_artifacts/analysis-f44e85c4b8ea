#!/usr/bin/env python3
"""
BixBench bix-14-q3 analysis:
Non-reference exonic variants in CHIP genes across the 86 analyzed samples
(data/CHIP_DP10_GQ20_PASS/ per-sample variant spreadsheets).

Primary definitions (researcher-approved):
  - Cohort   : 86 per-sample spreadsheets (each file = one sample)
  - Non-ref  : Zygosity in {Heterozygous, Homozygous Variant}
               (drop 'Reference' and the 1,151 Zygosity=None no-calls)
  - Region   : drop SO (Combined) terms containing 'intron', 'UTR', 'intergenic'
               (keep synonymous, missense, splice_region, inframe ins/del,
                frameshift, upstream_gene_variant)
  - CHIP gene: comma-separated 'Gene Names' intersected with the 56-gene list
               from 230214_Schenz_et_al_2022_CHIP_Genes.xlsx
  - Counting : per-sample variant occurrences (rows) after deduplication
"""
import glob, os, re, collections, json
import openpyxl
import pandas as pd

DATA = 'data/CHIP_DP10_GQ20_PASS'
GENE_FILE = 'data/230214_Schenz_et_al_2022_CHIP_Genes.xlsx'
TRIO_FILE = 'data/230215_Trio_Status.xlsx'
OUT = 'out'
os.makedirs(OUT, exist_ok=True)

# ---------------- inputs ----------------
wb = openpyxl.load_workbook(GENE_FILE)
chip_genes = sorted({r[0] for r in wb.active.iter_rows(values_only=True) if r[0]})
print(f'CHIP gene list: {len(chip_genes)} genes')

wt = openpyxl.load_workbook(TRIO_FILE)
trows = list(wt.active.iter_rows(values_only=True))
trios = pd.DataFrame(trows[1:], columns=[str(c).strip() for c in trows[0]])
trios['Sample ID'] = trios['Sample ID'].astype(str).str.strip()
trios['Status'] = trios['Status'].astype(str).str.strip()
trio_ids = set(trios['Sample ID'])
print(f'trio status table: {len(trios)} samples; statuses: {dict(collections.Counter(trios["Status"]))}')

# per-sample xlsx: two header rows (group row + sub-header row); data from row 3.
# Sub-header row is identical in all 86 files; some files contain duplicate column
# names, so we map columns positionally by sub-header name and extract tidy fields.
SUB = ['chr_pos', 'ref_alt', 'primary_findings', 'incidental_findings', 'zygosity',
       'mendel_error', 'inherited_from', 'dp', 'gq', 'vaf', 'in_acmg', 'acmg_match',
       'gene_names', 'so_combined', 'effect_combined', 'transcript', 'exon_number',
       'hgvs_c', 'hgvs_p', 'gnomad_filter', 'gnomad_af', 'gnomad_ac', 'gnomad_an',
       'gnomad_hom', 'clinvar_id', 'clinvar_class', 'clinvar_aggregate',
       'clinvar_review', 'clinvar_conditions', 'in_chip', 'chip_match',
       'in_dnam', 'dnam_match']

records = []
n_raw_total, n_dup_total = 0, 0
role_header_by_sample = {}
for path in sorted(glob.glob(os.path.join(DATA, '*.xlsx'))):
    sid = os.path.basename(path).replace('230209_Exome_GRCh38_CHIP_', '').replace('.xlsx', '')
    wbk = openpyxl.load_workbook(path, read_only=False)   # stale dims break read_only
    ws = wbk.active
    rows = list(ws.iter_rows(values_only=True))
    group_row, sub_row, body = rows[0], rows[1], rows[2:]
    assert sub_row[0] == 'Chr:Pos' and sub_row[4] == 'Zygosity'
    role_header_by_sample[sid] = str(group_row[4])        # e.g. 'Proband (502-P1)'
    seen = set()
    n_raw_total += len(body)
    for r in body:
        key = (r[0], r[1])
        if key in seen:            # deduplicate exact (Chr:Pos, Ref/Alt) duplicate rows
            n_dup_total += 1
            continue
        seen.add(key)
        rec = {'sample': sid}
        for i, name in enumerate(SUB):
            rec[name] = r[i] if i < len(r) else None
        rec['role_header'] = str(group_row[4])
        records.append(rec)
    wbk.close()

data = pd.DataFrame(records)
print(f'files: {data["sample"].nunique()} | raw rows: {n_raw_total} | '
      f'exact duplicate rows dropped: {n_dup_total} | rows after dedup: {len(data)}')

# sample role + trio-sample id from the sample-specific group header
m = data['role_header'].str.extract(r'^(.*?)\s*\((.*)\)$')
data['role'] = m[0].str.strip()
data['trio_sample_id'] = m[1].str.strip()
# numeric family IDs carry role suffixes in file names (179-P1, 185-PF, ...):
# strip the suffix so '179-P1' maps to trio Sample ID '179'; SRR IDs match directly
data['trio_key'] = data['trio_sample_id'].apply(
    lambda s: re.match(r'^(\d+)-', s).group(1) if re.match(r'^(\d+)-', s) else s)
data['trio_match'] = data['trio_key'].isin(trio_ids)
unmapped = sorted(data.loc[~data['trio_match'], 'sample'].unique())
print(f'samples whose header ID does NOT map to a trio Sample ID: {unmapped or "none"}')
trio_missing = sorted(trio_ids - set(data['trio_key']))
print(f'trio Sample IDs without a variant spreadsheet: {trio_missing} (father 533 documented, not a filter)')

# ---------------- filters ----------------
data['zygosity'] = data['zygosity'].fillna('None')
data['so'] = data['so_combined'].astype(str)
data['genes'] = data['gene_names'].astype(str)

data['is_nonref'] = data['zygosity'].isin(['Heterozygous', 'Homozygous Variant'])
data['notref_literal'] = data['zygosity'] != 'Reference'                       # sensitivity
data['region_excluded'] = data['so'].str.contains('intron|UTR|intergenic', case=False, na=False)
data['so_strict_exonic'] = data['so'].isin(['missense_variant', 'synonymous_variant',
                                            'frameshift_variant', 'inframe_insertion',
                                            'inframe_deletion'])
data['so_splice_or_upstream'] = data['so'].isin(['splice_region_variant', 'upstream_gene_variant'])
data['in_chip_gene_list'] = data['genes'].apply(
    lambda g: any(x.strip() in chip_genes for x in g.split(',')))
data['chip_genes_hit'] = data['genes'].apply(
    lambda g: ','.join(sorted({x.strip() for x in g.split(',') if x.strip() in chip_genes})))

print('\n--- filter steps (per-sample occurrences after dedup) ---')
print(f'all rows                             : {len(data)}')
s1 = data[data['is_nonref']]
print(f"zygosity in (Heterozygous, Homozygous Variant) : {len(s1)}")
s2 = s1[~s1['region_excluded']]
print(f'  drop SO containing intron/UTR/intergenic     : {len(s2)}')
s3 = s2[s2['in_chip_gene_list']]
PRIMARY = len(s3)
print(f'  keep rows with a Gene Name in CHIP gene list : {PRIMARY}')

uniq = s3.drop_duplicates(subset=['chr_pos', 'ref_alt'])
print(f'\n>>> PRIMARY ANSWER: {PRIMARY} non-reference exonic CHIP-gene variant occurrences '
      f'across the 86 samples ({len(uniq)} unique (Chr:Pos, Ref/Alt) variants)')
print('primary zygosity composition:', dict(collections.Counter(s3['zygosity'])))
print('primary SO composition      :', dict(collections.Counter(s3['so'])))

# ---------------- sensitivity grid ----------------
def subset(zdef, rdef, gdef):
    d = data
    if zdef == 'nonref':      d = d[d['is_nonref']]
    elif zdef == '!=ref':     d = d[d['notref_literal']]
    if rdef == 'primary':       d = d[~d['region_excluded']]
    elif rdef == 'strict':      d = d[d['so_strict_exonic']]
    elif rdef == 'no_splice_up': d = d[~d['region_excluded'] & ~d['so_splice_or_upstream']]
    if gdef == 'genelist':      d = d[d['in_chip_gene_list']]
    return d                    # gdef 'In_CHIP' -> no extra gene filter (all rows True)

grid = []
for z in ['nonref', '!=ref']:
    for r in ['primary', 'strict', 'no_splice_up']:
        for g in ['genelist', 'In_CHIP']:
            d = subset(z, r, g)
            grid.append({'zygosity': z, 'region': r, 'genes': g,
                         'n_occurrences': len(d),
                         'n_unique_variants': d.drop_duplicates(subset=['chr_pos', 'ref_alt']).shape[0]})
sens = pd.DataFrame(grid)
print('\n--- sensitivity grid ---')
print(sens.to_string(index=False))

# ---------------- refinement (a): trio mapping ----------------
s3_mapped = s3[s3['trio_match']]
print('\n--- refinement (a): trio-status mapping ---')
print(f'primary occurrences restricted to trio-mapped samples: {len(s3_mapped)}')
print(f'primary occurrences total (86 files)                 : {PRIMARY}')
print(f'identical: {len(s3_mapped) == PRIMARY}')

# ---------------- refinement (b): per-gene breakdown ----------------
rows = []
for _, r in s3.iterrows():
    for gname in r['chip_genes_hit'].split(','):
        if gname:
            rows.append((gname, r['sample'], r['chr_pos'], r['ref_alt'], r['so'], r['zygosity']))
per_gene = pd.DataFrame(rows, columns=['gene', 'sample', 'chr_pos', 'ref_alt', 'so', 'zygosity'])
pc = per_gene.groupby('gene').size().rename('occurrences')
uv = per_gene.drop_duplicates(['gene', 'chr_pos', 'ref_alt']).groupby('gene').size().rename('unique_variants')
ns = per_gene.groupby('gene')['sample'].nunique().rename('n_samples')
breakdown = pd.concat([pc, uv, ns], axis=1).sort_values('occurrences', ascending=False)
print('\n--- refinement (b): per-gene breakdown of the primary count ---')
print(breakdown.to_string())
multi = per_gene.groupby(['chr_pos', 'ref_alt'])['gene'].nunique()
print(f'rows annotated to >1 CHIP gene: {int((multi > 1).sum())} '
      f'(per-gene occurrences therefore sum to {len(per_gene)} = {PRIMARY} primary count + '
      f'{len(per_gene) - PRIMARY} double-attributed rows)')

# ---------------- save artifacts ----------------
s3.to_csv(f'{OUT}/primary_nonref_exonic_chip_variants.csv', index=False)
breakdown.to_csv(f'{OUT}/per_gene_breakdown.csv')
sens.to_csv(f'{OUT}/sensitivity_grid.csv', index=False)
summary = {'primary_count_per_sample_occurrences': int(PRIMARY),
           'primary_unique_variants': int(len(uniq)),
           'sensitivity_grid': sens.to_dict('records'),
           'per_gene_breakdown': breakdown.reset_index().to_dict('records'),
           'duplicate_rows_dropped': int(n_dup_total),
           'unmapped_samples': unmapped,
           'trio_ids_without_file': trio_missing}
with open(f'{OUT}/summary.json', 'w') as f:
    json.dump(summary, f, indent=2)
print(f'\noutputs written to {OUT}/: primary_nonref_exonic_chip_variants.csv, '
      f'per_gene_breakdown.csv, sensitivity_grid.csv, summary.json')
