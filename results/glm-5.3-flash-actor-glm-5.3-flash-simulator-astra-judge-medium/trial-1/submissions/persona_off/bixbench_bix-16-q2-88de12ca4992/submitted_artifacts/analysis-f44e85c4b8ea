"""
BixBench bix-16-q2: Skewness of the gene expression log2(TPM+1) distribution
across all cell lines in the DepMap expression matrix.

Pooled skewness via chunkwise float64 moment accumulation; supporting stats,
histogram, and per-gene skewness sensitivity note. Values kept as-is
(no clipping of slightly negative batch-correction artifacts).
"""
import csv
import numpy as np
from scipy import stats

CSV = "data/OmicsExpressionProteinCodingGenesTPMLogp1BatchCorrected.csv"
MODEL = "data/Model.csv"

# ---------- (1) cross-check row IDs vs Model.csv ----------
model_ids = set()
with open(MODEL, newline="") as f:
    r = csv.reader(f)
    next(r)
    for row in r:
        model_ids.add(row[0])

# ---------- (2) chunked load + moment accumulation ----------
n_cols = 19138
row_ids = []
# per-column moment accumulators (for per-gene skewness sensitivity note)
c1 = np.zeros(n_cols)   # sum
c2 = np.zeros(n_cols)   # sum of squares
c3 = np.zeros(n_cols)   # sum of cubes
ncol_counts = np.zeros(n_cols, dtype=np.int64)
# global values buffer (32.0M float32 = 128 MB, fine in memory) for median/hist
vals = None
row = 0

with open(CSV, newline="") as f:
    r = csv.reader(f)
    header = next(r)
    assert header[0] == "" and len(header) == n_cols + 1
    first = True
    for rec in r:
        assert len(rec) == n_cols + 1, f"malformed row {row}"
        row_ids.append(rec[0])
        v = np.asarray(rec[1:], dtype=np.float32)
        if first:
            vals = np.empty((6000, n_cols), dtype=np.float32)  # 1673 < 6000 rows
            first = False
        vals[row] = v
        vd = v.astype(np.float64)
        c1 += vd
        c2 += vd * vd
        c3 += vd * vd * vd
        ncol_counts += 1
        row += 1
    vals = vals[:row]

n_rows, n_genes = vals.shape
n_total = vals.size
print(f"matrix: {n_rows} cell lines x {n_genes} genes = {n_total:,} values")

matched = len(set(row_ids) & model_ids)
print(f"row IDs matched in Model.csv: {matched}/{len(row_ids)} "
      f"(unmatched: {len(row_ids) - matched})")

# ---------- (3) pooled statistics (float64 accumulation) ----------
v64 = vals.astype(np.float64)
mean = v64.mean()
m2 = ((v64 - mean) ** 2).sum()
m3 = ((v64 - mean) ** 3).sum()
var_pop = m2 / n_total
sd_pop = np.sqrt(var_pop)
skew_pop = (m3 / n_total) / var_pop ** 1.5          # bias=True convention
n = n_total
g1 = skew_pop
G1 = g1 * np.sqrt(n * (n - 1)) / (n - 2)            # bias=False (Fisher-Pearson)
skew_scipy = stats.skew(vals.ravel())               # scipy default bias=True

median = np.median(v64)
q1, q3 = np.percentile(v64, [25, 75])
vmin, vmax = float(vals.min()), float(vals.max())
pct_neg = float((vals < 0).mean() * 100)
pct_zero = float((vals == 0).mean() * 100)
mode_bin = np.histogram(v64, bins=np.arange(-0.5, 16.5, 0.5))[0]
mode_region = f"[{np.arange(-0.5, 16.5, 0.5)[np.argmax(mode_bin)]}, " \
              f"{np.arange(-0.5, 16.5, 0.5)[np.argmax(mode_bin)] + 0.5}]"

print("\n--- Pooled distribution statistics (all values, unmodified) ---")
print(f"n values        : {n_total:,}")
print(f"mean            : {mean:.4f}")
print(f"median          : {median:.4f}")
print(f"mode region (0.5-wide bins) : {mode_region}")
print(f"std (population): {sd_pop:.4f}")
print(f"Q1 / Q3         : {q1:.4f} / {q3:.4f}")
print(f"min / max       : {vmin:.4f} / {vmax:.4f}")
print(f"% negative      : {pct_neg:.2f}%   % exact zero: {pct_zero:.2f}%")
print(f"mean - median   : {mean - median:+.4f} (positive => right skew)")
print(f"SKEWNESS (bias=True, population G1)  : {skew_pop:.6f}")
print(f"SKEWNESS (scipy.stats.skew default)  : {skew_scipy:.6f}")
print(f"SKEWNESS (bias=False, adjusted G1)   : {G1:.6f}")

# ---------- (4) 200-bin histogram ----------
counts, edges = np.histogram(v64, bins=200)
print("\n--- 200-bin histogram (nonzero bins only) ---")
for c, lo, hi in zip(counts, edges[:-1], edges[1:]):
    if c > 0:
        bar = "#" * max(1, int(60 * c / counts.max()))
        print(f"[{lo:6.2f},{hi:6.2f}) {c:>10,} {bar}")

# ---------- (5) per-gene skewness sensitivity note ----------
n_ = ncol_counts.astype(np.float64)
mu = c1 / n_
m2g = c2 / n_ - mu ** 2
m3g = c3 / n_ - mu ** 3 - 3 * mu * m2g
gene_skew = m3g / m2g ** 1.5
print("\n--- Per-gene (column-wise) skewness sensitivity note ---")
print(f"genes: {len(gene_skew)}")
print(f"median gene-level skew : {np.median(gene_skew):.4f}")
print(f"Q1 / Q3 gene skew      : {np.percentile(gene_skew, 25):.4f} / "
      f"{np.percentile(gene_skew, 75):.4f}")
print(f"fraction of genes with skew > 0: {(gene_skew > 0).mean() * 100:.1f}%")

print("\nCONCLUSION: pooled distribution is positively (right) skewed, "
      f"skewness = {skew_pop:.4f} (bias=True); "
      f"{G1:.4f} (bias=False).")
