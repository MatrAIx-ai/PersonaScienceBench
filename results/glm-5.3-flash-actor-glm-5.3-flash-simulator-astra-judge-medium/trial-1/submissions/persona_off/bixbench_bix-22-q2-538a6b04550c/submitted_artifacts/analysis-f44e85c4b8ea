"""
Pearson correlation between gene length and mean expression (CD4 samples)
for protein-coding genes. BixBench bix-22-q2.

Primary: raw-value Pearson r between Length (bp) and arithmetic mean of
supplied BatchCorrectedReadCounts across CD4 samples, exact gene_biotype
== 'protein_coding'.
Sensitivity: log-log Pearson r; multi-biotype inclusion delta.
"""
import numpy as np
import pandas as pd

META = "data/GeneMetaInfo_Zenodo.csv"
COUNTS = "data/BatchCorrectedReadCounts_Zenodo.csv"
ANN = "data/Sample_annotated_Zenodo.csv"

# --- Load inputs ---
meta = pd.read_csv(META, index_col=0)
counts = pd.read_csv(COUNTS, index_col=0)
ann = pd.read_csv(ANN)

print(f"meta: {meta.shape}, counts: {counts.shape}, ann: {ann.shape}")

# --- Join on gene symbol (verified 1:1 in inspection) ---
assert counts.index.isin(meta["Geneid"]).all()
genes = meta.set_index("Geneid").loc[counts.index]
assert (genes.index == counts.index).all()

# --- CD4 selection via annotation sheet, `sample` key ---
cd4_samples = ann.loc[ann["celltype"] == "CD4", "sample"].tolist()
missing = [s for s in cd4_samples if s not in counts.columns]
assert not missing, f"annotation samples missing from matrix: {missing}"
mat = counts[cd4_samples]
print(f"CD4 samples: n={len(cd4_samples)} (all present in matrix)")

# --- Mean expression across CD4 samples (values as supplied) ---
mean_expr = mat.mean(axis=1)

# --- Defensive length filter (no-op expected) ---
lengths = genes["Length"].astype(float)
bad = lengths.isna() | (lengths <= 0)
print(f"genes with NA/non-positive length (dropped): {bad.sum()}")
mean_expr = mean_expr[~bad.reindex(mean_expr.index)]
lengths = lengths.reindex(mean_expr.index)

# --- Primary: exact protein_coding ---
pc_mask = genes["gene_biotype"] == "protein_coding"
pc_mask = pc_mask.reindex(mean_expr.index)
x = lengths[pc_mask].to_numpy()
y = mean_expr[pc_mask].to_numpy()

n_zero_mean = int((y == 0).sum())
r_primary = np.corrcoef(x, y)[0, 1]

# Sensitivity 1: log-log
r_loglog = np.corrcoef(np.log2(x), np.log2(y + 1))[0, 1]

# Sensitivity 2: include multi-biotype rows containing 'protein_coding'
pc2_mask = genes["gene_biotype"].str.contains("protein_coding", regex=False).reindex(mean_expr.index)
r_multi = np.corrcoef(lengths[pc2_mask].to_numpy(), mean_expr[pc2_mask].to_numpy())[0, 1]
n_multi = int(pc2_mask.sum())

print(f"\nn protein_coding (exact): {pc_mask.sum()}")
print(f"genes with zero mean expression among them: {n_zero_mean}")
print(f"PRIMARY Pearson r (raw, length vs mean count): {r_primary:.4f}")
print(f"Sensitivity log-log r: {r_loglog:.4f}")
print(f"Sensitivity incl. multi-biotype rows (n={n_multi}): r = {r_multi:.4f}")
print(f"Delta from multi-biotype inclusion: {r_multi - r_primary:+.4f}")

# Extra diagnostics
print(f"\nLength range (bp): {x.min():.0f} - {x.max():.0f}")
print(f"Mean count range: {y.min():.3f} - {y.max():.1f}")

# --- Sanity: value-type check on CD4 block ---
sub = mat.to_numpy()
print(f"\nCD4 block: dtype int64={np.all(np.mod(sub, 1) == 0)}, negatives={(sub < 0).sum()}, "
      f"min={sub.min()}, max={sub.max()}  -> raw/integer-like values (no evident log/CPM/ComBat transform)")

results = {
    "primary_pearson_r_raw": round(float(r_primary), 4),
    "loglog_pearson_r": round(float(r_loglog), 4),
    "multi_biotype_r": round(float(r_multi), 4),
    "multi_biotype_delta": round(float(r_multi - r_primary), 4),
    "n_protein_coding": int(pc_mask.sum()),
    "n_cd4_samples": len(cd4_samples),
    "n_zero_mean_genes": n_zero_mean,
}
print("\nRESULTS:", results)
