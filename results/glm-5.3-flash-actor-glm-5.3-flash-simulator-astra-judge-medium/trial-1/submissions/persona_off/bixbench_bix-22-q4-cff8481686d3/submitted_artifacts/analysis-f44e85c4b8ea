"""Pearson correlation between gene length and mean CD14 expression (protein-coding genes).

Primary result: Pearson r between gene Length and the per-gene arithmetic mean of the
supplied batch-corrected counts across all 132 CD14 samples, over the 19,942
protein-coding genes, on the raw linear scale.
Sensitivity notes (labeled, not the deliverable): log1p-transformed variant and a
per-sample CPM-then-mean variant.
"""
import numpy as np
import pandas as pd
from scipy.stats import pearsonr

# ---- Load inputs ----
meta = pd.read_csv("data/GeneMetaInfo_Zenodo.csv")
counts = pd.read_csv("data/BatchCorrectedReadCounts_Zenodo.csv")
annot = pd.read_csv("data/Sample_annotated_Zenodo.csv")

gene_col = counts.columns[0]          # gene symbol column
n_genes, n_samples_total = counts.shape[0], counts.shape[1] - 1

# ---- Select CD14 samples: annotation celltype == "CD14", matched to count columns ----
cd14_samples = annot.loc[annot["celltype"] == "CD14", "sample"].tolist()
cd14_in_counts = [s for s in cd14_samples if s in counts.columns]
assert len(cd14_in_counts) == len(cd14_samples) == 132, "CD14 sample mismatch"
assert set(cd14_in_counts) == {c for c in counts.columns[1:] if "CD14" in c}

# ---- Per-gene mean across the 132 CD14 samples (raw batch-corrected counts) ----
mean_expr = counts[cd14_in_counts].mean(axis=1)

# ---- Merge protein-coding metadata (lossless symbol join) ----
pc = meta.loc[meta["gene_biotype"] == "protein_coding", ["Geneid", "Length"]]
merged = pc.merge(pd.DataFrame({gene_col: counts[gene_col], "mean_expr": mean_expr}),
                  left_on="Geneid", right_on=gene_col, how="inner")
assert len(merged) == len(pc) == 19942, "unexpected loss in merge"
assert merged["Length"].notna().all() and merged["mean_expr"].notna().all()
assert (merged["Length"] > 0).all()

# ---- Primary result: Pearson r on raw scale ----
r_raw, p_raw = pearsonr(merged["Length"], merged["mean_expr"])
print(f"Genes in metadata: {len(meta)}; protein-coding: {len(pc)}; "
      f"CD14 samples used: {len(cd14_in_counts)}; merged genes: {len(merged)}")
print(f"PRIMARY  Pearson r (raw scale): {r_raw:.4f}  (p = {p_raw:.3e})")

# ---- Sensitivity 1: log1p on both variables ----
r_log, p_log = pearsonr(np.log1p(merged["Length"]), np.log1p(merged["mean_expr"]))
print(f"SENSITIVITY log1p both:            {r_log:.4f}  (p = {p_log:.3e})")

# ---- Sensitivity 2: per-sample CPM (library-size normalize) then mean ----
lib = counts[cd14_in_counts].sum(axis=0)
cpm = counts[cd14_in_counts].div(lib, axis=1) * 1e6
cpm_mean = cpm.mean(axis=1).to_frame("cpm_mean")
cpm_mean[gene_col] = counts[gene_col].to_numpy()   # align values to gene symbols
cpm_merged = merged[["Geneid", "Length"]].merge(cpm_mean, left_on="Geneid",
                                                right_on=gene_col, how="inner")
assert len(cpm_merged) == len(merged)
r_cpm, p_cpm = pearsonr(cpm_merged["Length"], cpm_merged["cpm_mean"])
print(f"SENSITIVITY per-sample CPM mean:   {r_cpm:.4f}  (p = {p_cpm:.3e})")
