"""
BixBench bix-22-q6: Pearson correlation between gene length and gene expression,
restricted to protein-coding genes only.

Inputs (capsule):
  data/GeneMetaInfo_Zenodo.csv          gene metadata: Geneid, Chr, Length, gene_biotype
  data/BatchCorrectedReadCounts_Zenodo.csv  genes x samples batch-corrected counts (index = Geneid)
  data/Sample_annotated_Zenodo.csv      sample annotation keyed by `sample`

Primary analysis: per-gene mean of batch-corrected counts across all 723 samples
(linear scale) vs. Length, Pearson r on genes with gene_biotype == "protein_coding".
Sensitivity: log2(mean + 1) transform of the same expression summary.
"""
import numpy as np
import pandas as pd
from scipy import stats

COUNTS_F = "data/BatchCorrectedReadCounts_Zenodo.csv"
META_F   = "data/GeneMetaInfo_Zenodo.csv"

# ---- Load and verify join keys -------------------------------------------------
meta = pd.read_csv(META_F)
counts = pd.read_csv(COUNTS_F, index_col=0)

assert meta["Geneid"].is_unique
assert set(counts.index) == set(meta["Geneid"]), "gene keys mismatch"
print(f"metadata genes: {len(meta)}, count-matrix genes: {counts.shape[0]}, "
      f"samples (columns): {counts.shape[1]}")

# ---- Protein-coding filter -----------------------------------------------------
pc_mask_exact = meta["gene_biotype"] == "protein_coding"
n_exact = int(pc_mask_exact.sum())
compound = meta["gene_biotype"].str.contains("protein_coding", regex=False) & ~pc_mask_exact
n_compound = int(compound.sum())
print(f"protein_coding (exact match): {n_exact}")
print(f"compound multi-biotype rows containing 'protein_coding' (EXCLUDED): {n_compound}")

pc_ids = meta.loc[pc_mask_exact, "Geneid"]
X = counts.loc[pc_ids]

# ---- Expression summaries ------------------------------------------------------
mean_counts = X.mean(axis=1)               # per-gene mean across all 723 samples
log2_expr = np.log2(mean_counts + 1)       # sensitivity variant

n_zero_mean = int((mean_counts == 0).sum())
print(f"protein-coding genes with zero mean count (before degenerate filter): {n_zero_mean}")

# ---- Drop zero-variance expression summaries -----------------------------------
nz_mask = mean_counts > 0                     # zero-variance genes are exactly the all-zero ones (counts >= 0)
keep = mean_counts[nz_mask]
keep_log = log2_expr[nz_mask]
n_removed = int((~nz_mask).sum())
print(f"degenerate (zero-variance) genes removed: {n_removed}; n genes used: {len(keep)}")

lengths = meta.set_index("Geneid").loc[keep.index, "Length"].astype(float)

# ---- Pearson correlations -------------------------------------------------------
r_lin, p_lin = stats.pearsonr(lengths, keep)
r_log, p_log = stats.pearsonr(lengths, keep_log)
print(f"\nPRIMARY  Pearson r (Length vs mean batch-corrected count, linear): "
      f"r = {r_lin:.4f}, p = {p_lin:.3e}, n = {len(keep)}")
print(f"SENSITIVITY Pearson r (Length vs log2(mean+1)): "
      f"r = {r_log:.4f}, p = {p_log:.3e}, n = {len(keep)}")

# ---- Diagnostics ----------------------------------------------------------------
print("\nDiagnostics:")
print(f"  mean counts: median {keep.median():.1f}, mean {keep.mean():.1f}, max {keep.max():.1f}")
print(f"  lengths: median {lengths.median():.0f}, min {lengths.min():.0f}, max {lengths.max():.0f}")
print(f"  Spearman (length vs linear mean): "
      f"{stats.spearmanr(lengths, keep).statistic:.4f}")
