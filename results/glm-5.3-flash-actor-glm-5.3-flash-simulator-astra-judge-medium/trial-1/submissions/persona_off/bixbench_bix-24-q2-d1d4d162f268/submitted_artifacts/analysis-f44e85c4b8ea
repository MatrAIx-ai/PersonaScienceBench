#!/usr/bin/env python3
"""
CBD direction-of-effect analysis in CRC cells (BixBench bix-24-q2).
Primary contrast: CBD_IC50 (group 7) vs DMSO vehicle (group 3), 3 reps each.
Sensitivity:      CBD_IC50_Serum_starvation_16h (8) vs DMSO_Serum_starvation (4).
Pipeline (Python fallback, R/DESeq2 unavailable in runner):
  median-of-ratios size factors -> per-gene NB GLM (log link, offset=log size factor,
  method-of-moments dispersion with parametric trend shrinkage) -> Wald test ->
  BH padj -> significant: padj<0.05 & |log2FC|>0.5.
GO BP ORA (up/down vs pre-filtered universe, BH) is attempted but BLOCKED:
no internet, no R/clusterProfiler, no gseapy/mygene, no GMT/OBO/gene2go files
anywhere on the runner. Limitation documented; no fabricated enrichment.
"""
import numpy as np, pandas as pd, scipy.optimize as so, scipy.stats as st
from statsmodels.stats.multitest import multipletests

counts = pd.read_csv('data/counts_raw_unfiltered.csv', index_col=0)
layout = pd.read_csv('data/sample_layout.csv')
counts.columns = [c.replace('-', '_') for c in counts.columns]
sample2group = {s.replace('-', '_'): g for s, g in zip(layout.SampleID, layout.Group)}

groups = {g: [f"{i}_{r}" for r in (1, 2, 3)] for i, g in
          zip(range(1, 11), ['Untreated', 'Serum_starvation', 'DMSO', 'DMSO_Serum_starvation',
                             'Cisplatin_IC50', 'Cisplatin_IC50_SS_16h', 'CBD_IC50',
                             'CBD_IC50_SS_16h', 'Cisplatin_IC50_CBD_IC50',
                             'Cisplatin_IC50_CBD_IC50_SS_16h'])}
assert all(c in counts.columns for cols in groups.values() for c in cols)

def mor_size_factors(Y):
    with np.errstate(divide='ignore'):
        logY = np.log(np.where(Y > 0, Y, np.nan).astype(float))
        gmean = np.exp(np.nanmean(logY, axis=1))
    ok = np.isfinite(gmean) & (gmean > 0)
    ratios = Y[ok] / gmean[ok, None]
    return np.median(ratios, axis=0), int(ok.sum())

def mom_dispersion(Yn):
    G = Yn.shape[1] // 2
    num = np.zeros(Yn.shape[0]); den = np.zeros(Yn.shape[0])
    for k in range(2):
        Yk = Yn[:, k*G:(k+1)*G]
        m = Yk.mean(1)
        num += ((Yk - m[:, None])**2).sum(1) - (G - 1) * m
        den += (G - 1) * m**2
    return num / den

def nb_glm_wald(Y, sf, alpha):
    ngene, nsamp = Y.shape
    X = np.column_stack([np.ones(nsamp), np.repeat([0.0, 1.0], nsamp // 2)])
    off = np.log(sf)
    Yf = Y.astype(float)
    with np.errstate(divide='ignore'):
        ly = np.log((Yf + 0.5) / sf)
    beta = np.zeros((ngene, 2))
    beta[:, 0] = ly[:, :nsamp//2].mean(1)
    beta[:, 1] = ly[:, nsamp//2:].mean(1) - beta[:, 0]
    mu = np.exp(np.clip(beta @ X.T + off, -20, 30))
    for _ in range(50):
        w = np.maximum(mu / (1.0 + alpha[:, None] * mu), 1e-12)
        z = (beta @ X.T) + (Yf - mu) / np.maximum(mu, 1e-10)
        A = np.einsum('gs,si,sj->gij', w, X, X)
        b = np.einsum('gs,si,gs->gi', w, X, z)
        Ainv = np.linalg.inv(A + np.eye(2) * 1e-10)
        beta_new = np.einsum('gij,gj->gi', Ainv, b)
        if np.max(np.abs(beta_new - beta)) < 1e-8:
            beta = beta_new; break
        beta = beta_new
        mu = np.exp(np.clip(beta @ X.T + off, -20, 30))
    return beta[:, 1], np.sqrt(Ainv[:, 1, 1])

def run_contrast(counts, ctrl_cols, treat_cols, label):
    sub = counts[ctrl_cols + treat_cols]
    keep = (sub >= 10).sum(axis=1) >= 3
    Y = sub[keep].values
    sf, n_sf_genes = mor_size_factors(Y)
    Yn = Y / sf
    amom = mom_dispersion(Yn)
    m = Yn.mean(1)
    fit_mask = (amom > 1e-5) & np.isfinite(amom)
    hi = np.percentile(amom[fit_mask], 95)
    def obj(p):
        return np.mean((np.minimum(amom[fit_mask], hi) - (p[0] / m[fit_mask] + p[1]))**2)
    p0 = [np.median(amom[fit_mask] * m[fit_mask]), max(np.median(amom[fit_mask]), 1e-4)]
    try:
        res = so.minimize(obj, p0, method='Nelder-Mead')
        a1, a0 = abs(res.x[0]), abs(res.x[1])
    except Exception:
        a1, a0 = 1.0, 0.01
    alpha = np.clip(np.maximum(amom, a1 / np.maximum(m, 1.0) + a0), 1e-6, 50.0)
    lfc, se = nb_glm_wald(Y, sf, alpha)
    lfc2 = lfc / np.log(2)
    z = lfc / se
    p = 2 * st.norm.sf(np.abs(z))
    padj = multipletests(p, method='fdr_bh')[1]
    sig = (padj < 0.05) & (np.abs(lfc2) > 0.5)
    out = pd.DataFrame({'gene': sub.index[keep], 'log2FC': lfc2, 'SE': se / np.log(2),
                        'pval': p, 'padj': padj, 'significant': sig,
                        'mean_norm_DMSO': Yn[:, :len(ctrl_cols)].mean(1),
                        'mean_norm_CBD': Yn[:, len(ctrl_cols):].mean(1)})
    up, dn = out[sig & (out.log2FC > 0)], out[sig & (out.log2FC < 0)]
    print(f"\n===== {label} =====")
    print(f"genes pre-filter retained: {int(keep.sum())} (from {counts.shape[0]})")
    print(f"genes used for size factors: {n_sf_genes}; trend dispersion a1={a1:.3f}, a0={a0:.4g}")
    print(f"padj<0.05 only: {int((out.padj < 0.05).sum())}")
    print(f"SIGNIFICANT (padj<0.05 & |log2FC|>0.5): UP={len(up)}  DOWN={len(dn)}")
    print(f"up:   median={up.log2FC.median():.3f} mean={up.log2FC.mean():.3f} sum={up.log2FC.sum():.1f}")
    print(f"down: median={dn.log2FC.median():.3f} mean={dn.log2FC.mean():.3f} sum={dn.log2FC.sum():.1f}")
    if len(out[sig]) > 10:
        wr = st.wilcoxon(out.loc[sig, 'log2FC'], alternative='two-sided')
        print(f"Wilcoxon signed-rank (log2FC of significant genes): stat={wr.statistic:.0f}, p={wr.pvalue:.3g}")
    print("\nTop 10 UP (by padj):")
    print(up.nsmallest(10, 'padj')[['gene', 'log2FC', 'padj']].to_string(index=False))
    print("\nTop 10 DOWN (by padj):")
    print(dn.nsmallest(10, 'padj')[['gene', 'log2FC', 'padj']].to_string(index=False))
    return out, keep, dict(label=label, n_retained=int(keep.sum()), n_up=int(len(up)),
                           n_down=int(len(dn)), up_median_lfc=float(up.log2FC.median()),
                           down_median_lfc=float(dn.log2FC.median()),
                           up_mean_lfc=float(up.log2FC.mean()), down_mean_lfc=float(dn.log2FC.mean()),
                           up_sum_lfc=float(up.log2FC.sum()), down_sum_lfc=float(dn.log2FC.sum()),
                           wilcoxon_p=(float(wr.pvalue) if len(out[sig]) > 10 else None),
                           trend_a1=float(a1), trend_a0=float(a0),
                           n_padj_only=int((out.padj < 0.05).sum()))

primary, keep_primary, summ_primary = run_contrast(
    counts, groups['DMSO'], groups['CBD_IC50'], 'PRIMARY: CBD_IC50 vs DMSO (7 vs 3)')
sens, keep_sens, summ_sens = run_contrast(
    counts, groups['DMSO_Serum_starvation'], groups['CBD_IC50_SS_16h'],
    'SENSITIVITY: CBD+SS16h vs DMSO+SS (8 vs 4)')

primary.to_csv('results_DE_primary_CBD_vs_DMSO.csv', index=False)
sens.to_csv('results_DE_sensitivity_CBDSS_vs_DMSOSS.csv', index=False)
keep_all = (counts >= 10).sum(axis=1) >= 3
print(f"\nGlobal pre-filter (all 30 samples, >=10 counts in >=3): {int(keep_all.sum())} genes")

