"""
TASK008 BCG-CORONA (BixBench bix-29-q2):
Independent effect of each additional ongoing medical condition (MHONGO) on the
odds of higher COVID-19 severity, controlling for BCG vaccination status (TRTGRP)
and patient-interaction variables (patients_seen, expect_interact), via a
proportional-odds (cumulative logit) ordinal regression.

Outcome: maximum AESEV (ordinal 1<2<3<4) across a subject's COVID-19 AE records
(AEPT containing 'COVID'). Predictor: count of MH records with MHONGO=='Yes'
(MEDICAL HISTORY section) per subject. Result: 100*(exp(beta)-1)% increase in
odds of higher severity per additional ongoing condition.
"""
import numpy as np
import pandas as pd
import statsmodels.api as sm
from statsmodels.miscmodels.ordinal_model import OrderedModel

# ---------------- Load ----------------
dm = pd.read_csv('data/TASK008_BCG-CORONA_DM.csv')
mh = pd.read_csv('data/TASK008_BCG-CORONA_MH.csv')
ae = pd.read_csv('data/TASK008_BCG-CORONA_AE.csv')

# ---------------- Predictor: ongoing-condition count per subject ----------------
mh_mh = mh[mh['MHSCAT'] == 'MEDICAL HISTORY']
ongoing = (mh_mh.loc[mh_mh['MHONGO'] == 'Yes']
           .groupby('USUBJID').size()
           .reindex(dm['USUBJID']).fillna(0).astype(int)
           .rename('ongoing_count'))
dm = dm.merge(ongoing, left_on='USUBJID', right_index=True)

# ---------------- Outcome: max COVID-19 AE severity per subject ----------------
cov = ae[ae['AEPT'].astype(str).str.contains('COVID', case=False, na=False)]
dm['has_covid'] = dm['USUBJID'].isin(cov['USUBJID']).astype(int)   # presence of any COVID AE
maxsev = cov.groupby('USUBJID')['AESEV'].max().rename('covid_sev')
dm = dm.merge(maxsev, left_on='USUBJID', right_index=True, how='left')

print(f"Subjects: {len(dm)}; with >=1 COVID-19 AE: {dm.has_covid.sum()}; "
      f"of those with known severity: {dm[dm.has_covid == 1].covid_sev.notna().sum()}")

# ---------------- Design ----------------
dm['bcg'] = (dm['TRTGRP'] == 'BCG').astype(int)
dm['expect_yes'] = (dm['expect_interact'] == 'Yes').astype(int)
dm['ps_51_100'] = (dm['patients_seen'] == '51-100').astype(int)
dm['ps_gt100'] = (dm['patients_seen'] == '>100').astype(int)
BASE = ['ongoing_count', 'bcg', 'expect_yes', 'ps_51_100', 'ps_gt100']

def make_expanded(set_df, min_n=10):
    """Dummies for Age/SEX/RACE/education/work_hours. The most frequent level
    (with >= min_n obs in the analysis set) serves as the reference; other
    levels with >= min_n obs get dummies; rarer levels are absorbed into the
    reference (dummy=0) to keep the Hessian invertible."""
    cols = []
    for var, pref in [('Age', 'Age'), ('RACE', 'RACE'), ('education', 'Edu'),
                      ('work_hours', 'WH'), ('SEX', 'Sex')]:
        s = set_df[var].astype(str)
        vc = s.value_counts()
        keep = list(vc[vc >= min_n].index)
        ref = vc[vc.index.isin(keep)].idxmax()
        for lev in keep:
            if lev == ref:
                continue
            name = f'{pref}_{lev}'
            dm[name] = (dm[var].astype(str) == lev).astype(int)
            cols.append(name)
    return cols

def fit_ord(df, cols, outcome='covid_sev'):
    d = df.dropna(subset=[outcome] + cols).copy()
    y = d[outcome].astype(int)
    X = d[cols].astype(float)
    res = OrderedModel(y, X, distr='logit').fit(method='bfgs', disp=False)
    return d, res

def report(label, df, cols):
    d, res = fit_ord(df, cols)
    b, se = res.params['ongoing_count'], res.bse['ongoing_count']
    lo, hi = res.conf_int().loc['ongoing_count']
    pct = 100 * (np.exp(b) - 1)
    print(f"\n=== {label} ===  n={len(d)}, levels={sorted(d['covid_sev'].unique())}")
    print(f"MHONGO (ongoing_count): beta={b:.4f}, SE={se:.4f}, "
          f"95% CI [{lo:.4f}, {hi:.4f}], z={b/se:.2f}")
    print(f"  -> {pct:.1f}% increase in odds per additional ongoing condition "
          f"(95% CI {100*(np.exp(lo)-1):.1f}% to {100*(np.exp(hi)-1):.1f}%)")
    # Proportional-odds check: threshold-specific (non-parallel) binary logits
    print("  PO check - MHONGO coefficient in binary cumulative logits:")
    for cut in sorted(d['covid_sev'].unique())[:-1]:
        yy = (d['covid_sev'] > cut).astype(int)
        if yy.nunique() < 2 or yy.sum() < 3:
            print(f"    >{cut:.0f}: insufficient events (n_high={yy.sum()})"); continue
        r = sm.GLM(yy, sm.add_constant(d[cols].astype(float)),
                   family=sm.families.Binomial()).fit()
        c = r.conf_int().loc['ongoing_count']
        print(f"    >{cut:.0f}: beta={r.params['ongoing_count']:.4f} "
              f"(CI {c[0]:.4f}, {c[1]:.4f}), n_high={yy.sum()}")
    return {'n': len(d), 'beta': b, 'se': se, 'ci': (lo, hi), 'pct': pct}

res_all = {}
res_all['primary'] = report("PRIMARY: COVID-AE subjects with known severity (1-4)",
                            dm[dm.has_covid == 1], BASE)

# (a) all COVID-AE subjects, unknown severity imputed at lowest observed level
da = dm[dm.has_covid == 1].copy()
da['covid_sev'] = da['covid_sev'].fillna(da['covid_sev'].min())
res_all['imp_low'] = report("(a) All 194 COVID-AE subjects, unknown severity -> 1", da, BASE)

# (b) full cohort, no COVID AE = extra lowest category 0
db = dm.copy(); db['covid_sev'] = db['covid_sev'].fillna(0)
res_all['full0'] = report("(b) Full cohort (n=1000), 0=no COVID AE ... 4", db, BASE)

# (c) covariate-expanded model on the primary analysis set
EXTRA = make_expanded(dm[dm.has_covid == 1])
prim = dm[dm.has_covid == 1]
res_all['expanded'] = report("(c) Primary set + Age/SEX/RACE/education/work_hours",
                             prim, BASE + EXTRA)

# Sensitivity: binary any-ongoing
dbin = prim.copy(); dbin['ongoing_count'] = (dbin['ongoing_count'] > 0).astype(int)
res_all['binary'] = report("Sensitivity: binary any-ongoing predictor, primary set", dbin, BASE)

# ---------------- Summary ----------------
print("\n===== SUMMARY (MHONGO coefficient, proportional-odds logit) =====")
for k, v in res_all.items():
    print(f"{k:9s}: n={v['n']:4d}  beta={v['beta']:.4f}  SE={v['se']:.4f}  "
          f"95% CI [{v['ci'][0]:.4f}, {v['ci'][1]:.4f}]  -> {v['pct']:.1f}% odds increase")

print("\nDescriptives:")
print("Primary-set severity distribution:", prim['covid_sev'].value_counts().sort_index().to_dict())
print("Mean ongoing count by arm:", dm.groupby('TRTGRP')['ongoing_count'].mean().round(3).to_dict())
print("Mean severity by ongoing count (primary set):",
      prim.groupby('ongoing_count')['covid_sev'].agg(['mean', 'count']).round(2).to_dict('index'))
