"""
TASK008 BCG-CORONA: ordinal regression of COVID-19 severity on BCG vaccination
status, prior medical history, their interaction, and patient interaction frequency.

Public question: "What is the interaction effect between BCG vaccination status and
prior medical history on COVID-19 severity, as measured by the odds ratio in an
ordinal regression model that controls for patient interaction frequency?"

Primary model: proportional-odds ordinal logistic on ALL 1000 subjects with a
derived ordinal outcome:
  0 = no COVID-19 adverse event (AEPT == 'COVID-19')
  1-4 = max AESEV among the subject's COVID-19 AE rows
  COVID rows missing AESEV are imputed from AEOUT/AESER:
      AESER == 'Yes' or AEOUT == 'Worse'   -> 3
      AEOUT == 'Unchanged'                 -> 2
      AEOUT in ('Resolved','Improved')     -> 1
Design (approved):
  - predictors: BCG (TRTGRP=='BCG'), priorMH (any positive MH history), BCG x priorMH,
    patients_seen as an ordered 3-level term {'1-50':0, '51-100':1, '>100':2}
  - priorMH: broad binary, MHSCAT=='MEDICAL HISTORY', MHORRES==2 (1=No, 2=Yes,
    inferred), including 'Other:' free-text rows, EXCLUDING the acute
    'Current respiratory tract infection' item
  - No Age/SEX in the primary model (question specifies controlling for patient
    interaction frequency only); an Age/SEX-adjusted variant is a labeled sensitivity.
Reported quantity: interaction OR = exp(beta_interaction) with 95% CI.
"""
import numpy as np
import pandas as pd
from statsmodels.miscmodels.ordinal_model import OrderedModel

DATA = 'data'

# ---------------------------------------------------------------- load inputs
dm = pd.read_csv(f'{DATA}/TASK008_BCG-CORONA_DM.csv')
ae = pd.read_csv(f'{DATA}/TASK008_BCG-CORONA_AE.csv')
mh = pd.read_csv(f'{DATA}/TASK008_BCG-CORONA_MH.csv')

# ---------------------------------------------------------------- DM checks
assert dm['USUBJID'].is_unique, 'DM is not one row per subject'
assert set(dm['TRTGRP'].unique()) == {'BCG', 'Placebo'}
print('DM: %d subjects; TRTGRP: %s' % (len(dm), dm['TRTGRP'].value_counts().to_dict()))

ps_map = {'1-50': 0, '51-100': 1, '>100': 2}
dm['patients_seen_ord'] = dm['patients_seen'].map(ps_map)
assert dm['patients_seen_ord'].notna().all()

# ---------------------------------------------------------------- MH: prior history
mhc = mh[(mh['MHSCAT'] == 'MEDICAL HISTORY')].copy()
# MHORRES coding inferred: 1 = No, 2 = Yes (corroborated: MHONGO/MHCM 'Yes' only on ORRES=2 rows)
pos = mhc[(mhc['MHORRES'] == 2.0) & (mhc['MHTERM'] != 'Current respiratory tract infection')]
prior_any = pos.groupby('USUBJID').size().rename('n_pos')
severe_terms = {'Tuberculosis', 'Hypertension', 'Diabetes Mellitus',
                'Chronic Obstructive Pulmonary Disease', 'Other lung disease',
                'Cardiovascular disease', 'Cerebrovascular disease', 'Kidney disease',
                'Liver disease', 'Cancer', 'Organ or bone marrow transplantation',
                'Primary immunodeficiency', 'Neutropenia or lymphopenia'}
prior_sev = pos[pos['MHTERM'].isin(severe_terms)].groupby('USUBJID').size().rename('n_pos_sev')

dm = dm.merge(prior_any, how='left', left_on='USUBJID', right_index=True)
dm = dm.merge(prior_sev, how='left', left_on='USUBJID', right_index=True)
dm['priorMH'] = (dm['n_pos'].fillna(0) > 0).astype(int)
dm['priorMH_severe'] = (dm['n_pos_sev'].fillna(0) > 0).astype(int)
dm['BCG'] = (dm['TRTGRP'] == 'BCG').astype(int)
print('priorMH any: %d/%d ; priorMH severe subset: %d/%d'
      % (dm['priorMH'].sum(), len(dm), dm['priorMH_severe'].sum(), len(dm)))

# ---------------------------------------------------------------- AE: severity outcome
covid = ae[ae['AEPT'].astype(str).str.strip().str.lower() == 'covid-19'].copy()
print('COVID-19 AE rows: %d in %d subjects' % (len(covid), covid['USUBJID'].nunique()))

def imp(row):
    if pd.notna(row['AESEV']):
        return row['AESEV']
    if row['AESER'] == 'Yes' or row['AEOUT'] == 'Worse':
        return 3.0
    if row['AEOUT'] == 'Unchanged':
        return 2.0
    if row['AEOUT'] in ('Resolved', 'Resolved_', 'Improved'):
        return 1.0
    return np.nan

covid['AESEV_imp'] = covid.apply(imp, axis=1)
n_imputed_rows = int((covid['AESEV'].isna() & covid['AESEV_imp'].notna()).sum())
print('COVID rows with AESEV imputed from AEOUT/AESER: %d' % n_imputed_rows)

sev = covid.groupby('USUBJID')['AESEV_imp'].max().rename('severity')
df = dm.merge(sev, how='left', left_on='USUBJID', right_index=True)
df['severity'] = df['severity'].fillna(0).astype(int)
print('Derived severity (0-4) distribution:', df['severity'].value_counts().sort_index().to_dict())
print('Imputed-severity-level counts:', 
      sev[covid.groupby('USUBJID')['AESEV'].max().isna()].value_counts().to_dict())

# ---------------------------------------------------------------- helper: fit + report
def fit_ordered(d, formula_cols, label):
    d2 = d.dropna(subset=formula_cols + ['severity'])
    X = d2[formula_cols].astype(float)
    y = d2['severity'].astype(int)
    # OrderedModel requires the response to start at 0 after sorting; use category order
    mod = OrderedModel(y, X, distr='logit')
    res = mod.fit(method='bfgs', disp=False)
    print('\n===== %s (n=%d) =====' % (label, len(d2)))
    tbl = pd.DataFrame({'coef': res.params, 'SE': res.bse,
                        'z': res.params / res.bse,
                        'p': 2 * (1 - _normcdf(abs(res.params / res.bse)))})
    tbl['OR'] = np.exp(res.params)
    tbl['OR_lo95'] = np.exp(res.params - 1.96 * res.bse)
    tbl['OR_hi95'] = np.exp(res.params + 1.96 * res.bse)
    print(tbl.round(4).to_string())
    return res, tbl, len(d2)

from scipy.stats import norm as _n
def _normcdf(x):
    return _n.cdf(x)

cols_main = ['BCG', 'priorMH', 'BCG_x_priorMH', 'patients_seen_ord']
df['BCG_x_priorMH'] = df['BCG'] * df['priorMH']

# ---------------------------------------------------------------- primary model
res, tbl, n = fit_ordered(df, cols_main, 'PRIMARY: severity 0-4, all subjects')
b = res.params['BCG_x_priorMH']; se = res.bse['BCG_x_priorMH']
print('\n>>> PRIMARY interaction OR = %.4f (95%% CI %.4f-%.4f), p=%.4f'
      % (np.exp(b), np.exp(b - 1.96 * se), np.exp(b + 1.96 * se),
         2 * (1 - _n.cdf(abs(b / se)))))

# cell counts: arm x history x severity
cc = pd.crosstab([df['TRTGRP'], df['priorMH']], df['severity'])
print('\nCell counts (arm x priorMH) x severity:\n', cc.to_string())

# ---------------------------------------------------------------- sensitivities
# S1: complete case (exclude the imputed 41 subjects)
imp_subj = set(covid.loc[covid['AESEV'].isna() & covid['AESEV_imp'].notna(), 'USUBJID'])
d_cc = df[~df['USUBJID'].isin(imp_subj)]
res1, tbl1, n1 = fit_ordered(d_cc, cols_main, 'S1 complete-case (excl. imputed)')
# S2: COVID cases only, severity 1-4
d_covid = df[df['severity'] >= 1]
res2, tbl2, n2 = fit_ordered(d_covid, cols_main, 'S2 COVID cases only (1-4)')
# S3: severe-comorbidity definition of prior history
df['sev_x'] = df['BCG'] * df['priorMH_severe']
res3, tbl3, n3 = fit_ordered(
    df.rename(columns={'priorMH_severe': 'priorMH2'})
      .assign(BCG_x_priorMH=lambda x: x['BCG'] * x['priorMH2']),
    ['BCG', 'priorMH2', 'BCG_x_priorMH', 'patients_seen_ord'],
    'S3 severe-comorbidity subset')
# S4: Age/SEX adjusted (labeled sensitivity only)
d4 = df.copy()
d4['AGE_f'] = d4['Age'].astype('category').cat.codes
d4['SEX_f'] = (d4['SEX'] == 2).astype(int)
res4, tbl4, n4 = fit_ordered(d4, cols_main + ['AGE_f', 'SEX_f'], 'S4 Age/SEX adjusted')
# S5: expect_interact as the interaction-frequency control instead
d5 = df.copy()
d5['expect_interact_yes'] = (d5['expect_interact'] == 'Yes').astype(int)
res5, tbl5, n5 = fit_ordered(d5, ['BCG', 'priorMH', 'BCG_x_priorMH', 'expect_interact_yes'],
                             'S5 expect_interact control instead of patients_seen')

# ---------------------------------------------------------------- save outputs
with open('analysis/results_summary.txt', 'w') as f:
    f.write('PRIMARY interaction OR = %.4f (95%% CI %.4f-%.4f)\n\n' %
            (np.exp(b), np.exp(b - 1.96 * se), np.exp(b + 1.96 * se)))
    f.write('PRIMARY coefficient table:\n%s\n\n' % tbl.round(4).to_string())
    f.write('Cell counts (arm x priorMH) x severity:\n%s\n\n' % cc.to_string())
    f.write('S1 complete-case:\n%s\n\n' % tbl1.round(4).to_string())
    f.write('S2 COVID-only (1-4):\n%s\n\n' % tbl2.round(4).to_string())
    f.write('S3 severe-comorbidity:\n%s\n\n' % tbl3.round(4).to_string())
    f.write('S4 Age/SEX adjusted:\n%s\n\n' % tbl4.round(4).to_string())
    f.write('S5 expect_interact control:\n%s\n\n' % tbl5.round(4).to_string())
print('\nSaved analysis/results_summary.txt')
