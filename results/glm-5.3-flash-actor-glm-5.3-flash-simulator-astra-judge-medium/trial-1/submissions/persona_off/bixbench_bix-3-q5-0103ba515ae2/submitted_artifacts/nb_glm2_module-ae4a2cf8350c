import numpy as np
from scipy import stats
from nb_glm import bh

def nb_glm(Y, grp, offset=None, dispersion_trend=True, trend_quantile=0.5,
           shrink_weight=1.0, max_iter=60):
    """NB GLM (log link, var=mu+alpha*mu^2), per-gene dispersion from
    WITHIN-GROUP method-of-moments, shrunk toward a binned mean-expression trend.
    Y: G x J normalized counts; grp: boolean array (True = group A)."""
    G, J = Y.shape
    if offset is None:
        offset = np.zeros(J)
    X = np.stack([np.ones(J), grp.astype(float)], axis=1)
    keep = Y.sum(1) > 0
    # group means for dispersion estimation
    mu_g = np.where(grp[None, :], np.where(grp, Y, 0).sum(1)[:, None] / max(grp.sum(), 1),
                    np.where(~grp, Y, 0).sum(1)[:, None] / max((~grp).sum(), 1))
    res2 = ((Y - mu_g) ** 2).sum(1)
    alpha_raw = np.maximum((res2 - mu_g.sum(1)) / np.maximum((mu_g ** 2).sum(1), 1e-12), 0.0)
    if dispersion_trend:
        m = mu_g.mean(1)
        o = np.argsort(np.log(np.maximum(m, 1e-3)))
        trend = np.empty(G); edges = np.linspace(0, G, 26).astype(int)
        for i in range(25):
            idx = o[edges[i]:edges[i + 1]]
            trend[idx] = max(np.quantile(alpha_raw[idx], trend_quantile), 1e-4)
        n_eff = keep * J
        alpha_use = (shrink_weight * trend + n_eff * alpha_raw) / (shrink_weight + n_eff)
    else:
        alpha_use = alpha_raw
    alpha_use = np.maximum(alpha_use, 1e-6)
    alpha_use[~keep] = 1.0
    # GLM fit
    b = np.zeros((G, 2))
    b[:, 0] = np.log(np.maximum(Y.mean(1), 1e-8)) - offset.mean()
    for it in range(max_iter):
        eta = b[:, :1] + b[:, 1:] * grp[None, :] + offset[None, :]
        mu = np.exp(np.clip(eta, -20, 25))
        W = mu / (1.0 + alpha_use[:, None] * mu)
        z = eta + (Y - mu) / np.maximum(mu, 1e-12)
        XW = X[None, :, :] * W[:, :, None]
        A = np.einsum('gji,jk->gik', XW, X) + np.eye(2)[None] * 1e-10
        rhs = np.einsum('gji,gj->gi', XW, z)
        b_new = np.linalg.solve(A, rhs[..., None])[..., 0]
        if np.max(np.abs(b_new - b)) < 1e-9:
            b = b_new; break
        b = b_new
    eta = b[:, :1] + b[:, 1:] * grp[None, :] + offset[None, :]
    mu = np.exp(np.clip(eta, -20, 25))
    W = mu / (1.0 + alpha_use[:, None] * mu)
    XW = X[None, :, :] * W[:, :, None]
    A = np.einsum('gji,jk->gik', XW, X) + np.eye(2)[None] * 1e-10
    V = np.linalg.inv(A)
    se1 = np.sqrt(np.maximum(V[:, 1, 1], 1e-300))
    zs = b[:, 1] / se1
    p = 2 * stats.norm.sf(np.abs(zs))
    l2 = b[:, 1] / np.log(2)
    return l2, p, alpha_use, keep
