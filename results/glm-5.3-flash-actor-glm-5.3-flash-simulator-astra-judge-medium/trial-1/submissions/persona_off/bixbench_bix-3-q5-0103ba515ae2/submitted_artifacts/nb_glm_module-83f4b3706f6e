import numpy as np
from scipy import stats

def bh(p):
    p = np.asarray(p); n = len(p)
    o = np.argsort(p); ranked = p[o] * n / (np.arange(n) + 1)
    adj = np.minimum.accumulate(ranked[::-1])[::-1]
    out = np.empty(n); out[o] = np.clip(adj, 0, 1)
    return out

def _irls(Y, X, offset, alpha, b0, max_iter=50, tol=1e-9):
    """Vectorized IRLS for NB2 log-link GLM. Y: G x J, X: J x 2, offset: J."""
    b = b0
    for _ in range(max_iter):
        eta = b[:, :1] + b[:, 1:] * X[:, 1][None, :] + offset[None, :]
        mu = np.exp(np.clip(eta, -20, 25))
        W = mu / (1.0 + alpha[:, None] * mu)
        z = eta + (Y - mu) / np.maximum(mu, 1e-12)
        XW = X[None, :, :] * W[:, :, None]
        A = np.einsum('gji,jk->gik', XW, X) + np.eye(2)[None] * 1e-10
        rhs = np.einsum('gji,gj->gi', XW, z)
        b_new = np.linalg.solve(A, rhs[..., None])[..., 0]
        if np.max(np.abs(b_new - b)) < tol:
            return b_new
        b = b_new
    return b

def nb_glm_wald(Y, group, offset, dispersion='trend', prior_weight=2.0,
                max_iter=50, n_bins=25):
    """DESeq-style NB GLM (log link, var = mu + alpha*mu^2) per gene.
    dispersion='raw': per-gene MoM dispersion (anti-conservative-free but low power)
    dispersion='trend': shrink toward binned-median mean-dispersion trend (default)."""
    G, J = Y.shape
    X = np.stack([np.ones(J), group.astype(float)], axis=1)
    keep = Y.sum(1) > 0
    b0 = np.zeros((G, 2))
    b0[:, 0] = np.log(np.maximum(Y.mean(1), 1e-8)) - offset.mean()
    # stage 1: fit with small dispersion to get mu for MoM dispersion
    alpha0 = np.full(G, 1e-4)
    b1 = _irls(Y, X, offset, alpha0, b0, max_iter=30)
    eta = b1[:, :1] + b1[:, 1:] * X[:, 1][None, :] + offset[None, :]
    mu1 = np.exp(np.clip(eta, -20, 25))
    sse = ((Y - mu1) ** 2).sum(1)
    alpha_raw = np.maximum((sse - mu1.sum(1)) / np.maximum((mu1 ** 2).sum(1), 1e-12), 0.0)
    if dispersion == 'raw':
        alpha_use = np.maximum(alpha_raw, 1e-8)
    else:
        m = mu1.mean(1)
        logm = np.log(np.maximum(m, 1e-3))
        order = np.argsort(logm)
        trend = np.empty(G)
        edges = np.linspace(0, G, n_bins + 1).astype(int)
        for i in range(n_bins):
            idx = order[edges[i]:edges[i + 1]]
            trend[idx] = max(np.median(alpha_raw[idx]), 1e-5)
        # MAP-like shrinkage: weighted average of raw and trend
        n_eff = keep * J
        alpha_use = (prior_weight * trend + n_eff * alpha_raw) / (prior_weight + n_eff)
        alpha_use = np.maximum(alpha_use, 1e-8)
        alpha_use[~keep] = 1e-8
    # stage 2: final fit with shrunken dispersion
    b = _irls(Y, X, offset, alpha_use, b1, max_iter=max_iter)
    eta = b[:, :1] + b[:, 1:] * X[:, 1][None, :] + offset[None, :]
    mu = np.exp(np.clip(eta, -20, 25))
    W = mu / (1.0 + alpha_use[:, None] * mu)
    XW = X[None, :, :] * W[:, :, None]
    A = np.einsum('gji,jk->gik', XW, X) + np.eye(2)[None] * 1e-10
    V = np.linalg.inv(A)
    se1 = np.sqrt(np.maximum(V[:, 1, 1], 1e-300))
    zstat = b[:, 1] / se1
    pval = 2 * stats.norm.sf(np.abs(zstat))
    l2 = b[:, 1] / np.log(2)
    return l2, pval, alpha_use, keep
