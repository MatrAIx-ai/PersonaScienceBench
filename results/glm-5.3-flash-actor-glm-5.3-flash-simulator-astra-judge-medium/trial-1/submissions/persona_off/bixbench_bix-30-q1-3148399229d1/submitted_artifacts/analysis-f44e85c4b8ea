#!/usr/bin/env python3
"""
Analysis: percentage of miRNAs significantly differentially expressed
(patient vs control) before multiple-testing correction.

Input: data/pone.0150501.s002.xls  (legacy BIFF .xls, single sheet,
       "Table S1. Ct values for 175 miRNAs in DM1 and healthy controls serum")
Method: parsed via OLE stream extraction (7z) + minimal BIFF8 reader, because
       xlrd is unavailable and LibreOffice conversion fails in this sandbox.
Tests:  per-miRNA two-sided Welch t-test on Ct values (P_* vs C_*),
        alpha = 0.05 uncorrected. Sensitivity: Mann-Whitney U,
        global-mean-normalized Ct, complete-row deletion.
"""
import struct, csv, os
from collections import defaultdict
import numpy as np
from scipy import stats

XLS = 'data/pone.0150501.s002.xls'
WORK = 'work'
os.makedirs(WORK, exist_ok=True)

# ---------- 1. Parse ----------
os.system(f"7z e -y -o{WORK}/ole {XLS} Workbook >/dev/null 2>&1")
d = open(f'{WORK}/Workbook.bin','rb').read() if os.path.exists(f'{WORK}/Workbook.bin') \
    else open(f'{WORK}/ole/Workbook','rb').read()

recs = []
pos = 0
while pos + 4 <= len(d):
    rid, rlen = struct.unpack_from('<HH', d, pos)
    recs.append((rid, d[pos+4:pos+4+rlen])); pos += 4 + rlen

# SST (0x00FC, possibly continued by 0x003C)
sst, in_sst = b'', False
for rid, b in recs:
    if rid == 0x00FC: sst += b; in_sst = True
    elif in_sst and rid == 0x003C: sst += b
    else: in_sst = False
p = 8
_, cs = struct.unpack_from('<II', sst, 0)
strings = []
for _ in range(cs):
    cch = struct.unpack_from('<H', sst, p)[0]; p += 2
    fl = sst[p]; p += 1
    comp, rich, fe = fl & 1, fl & 8, fl & 4
    ne = 0
    if rich: ne += struct.unpack_from('<H', sst, p)[0]*4; p += 2
    if fe:   ne += struct.unpack_from('<I', sst, p)[0];   p += 4
    raw = sst[p:p + (cch*2 if comp else cch)]
    p += (cch*2 if comp else cch) + ne
    strings.append(raw.decode('utf-16-le') if comp else raw.decode('latin-1'))

def rk2f(rk):
    if rk & 0x02:
        v = rk >> 2
        if v & (1 << 29): v -= (1 << 30)
    else:
        v = struct.unpack('<d', struct.pack('<I', rk & 0xFFFFFFFC) + b'\x00\x00\x00\x00')[0]
    return v/100 if rk & 1 else v

cells, cur = defaultdict(dict), False
for rid, b in recs:
    if rid == 0x0809:
        cur = struct.unpack_from('<H', b, 2)[0] == 16; continue
    if not cur: continue
    if rid == 0x0203:
        r, c = struct.unpack_from('<HH', b, 0); cells[r][c] = struct.unpack_from('<d', b, 6)[0]
    elif rid == 0x00FD:
        r, c, _xf, i = struct.unpack_from('<HHHI', b, 0); cells[r][c] = strings[i]
    elif rid == 0x027E:
        r, c = struct.unpack_from('<HH', b, 0); cells[r][c] = rk2f(struct.unpack_from('<I', b, 6)[0])
    elif rid == 0x00BD:
        r, c1 = struct.unpack_from('<HH', b, 0)
        for i in range((len(b)-6)//6):
            c = struct.unpack_from('<H', b, 4+i*6)[0]
            cells[r][c] = rk2f(struct.unpack_from('<I', b, 4+i*6+2)[0])

title  = cells[0][0]
header = [cells[1].get(c, '') for c in range(21)]
rows   = sorted(r for r in cells if r >= 2)
names  = [cells[r][0] for r in rows]
print(f"title : {title!r}")
print(f"header: {header[1:]}")
print(f"miRNAs: {len(rows)} (unique: {len(set(names))})")

P_COLS, C_COLS = list(range(1, 11)), list(range(11, 21))
assert all(header[c].startswith('P_') for c in P_COLS)
assert all(header[c].startswith('C_') for c in C_COLS)

def cell2float(v):
    if isinstance(v, str):
        assert v == 'NAN', v
        return np.nan
    return float(v)

mat = np.array([[cell2float(cells[r].get(c, 'NAN')) for c in P_COLS + C_COLS] for r in rows])
pat, ctrl = mat[:, :10], mat[:, 10:]

# ---------- 2. Save parsed matrix ----------
with open(f'{WORK}/miRNA_ct_matrix.csv', 'w', newline='') as f:
    w = csv.writer(f)
    w.writerow(['miRNA'] + header[1:])
    for nme, row in zip(names, mat):
        w.writerow([nme] + ['NAN' if np.isnan(v) else f'{v:.4f}' for v in row])
print(f"wrote {WORK}/miRNA_ct_matrix.csv ({mat.shape[0]} x {mat.shape[1]})")

# ---------- 3. Main test: Welch t-test on Ct ----------
def direction(t):
    # Ct lower = more abundant; t = mean(P) - mean(C) on Ct scale
    return 'higher_in_patients' if t < 0 else 'lower_in_patients'

res = []
for i, nme in enumerate(names):
    x, y = pat[i], ctrl[i]
    x, y = x[~np.isnan(x)], y[~np.isnan(y)]
    t, pval = stats.ttest_ind(x, y, equal_var=False)
    res.append((nme, t, pval, direction(t), len(x), len(y)))

sig = [r for r in res if r[2] < 0.05]
sig_up = [r for r in sig if r[3] == 'higher_in_patients']   # lower Ct in patients
sig_dn = [r for r in sig if r[3] == 'lower_in_patients']

n = len(res)
print("\n=== MAIN RESULT (Welch t-test, uncorrected p < 0.05) ===")
print(f"tested miRNAs: {n}")
print(f"significant: {len(sig)}/{n} = {len(sig)/n*100:.2f}%")
print(f"  higher in patients (lower Ct): {len(sig_up)}")
print(f"  lower in patients  (higher Ct): {len(sig_dn)}")
print("top 10 by p-value:")
for nme, t, pv, dr, nx, ny in sorted(res, key=lambda r: r[2])[:10]:
    print(f"  {nme:<18} t={t:7.3f}  p={pv:.3e}  {dr}  nP={nx} nC={ny}")

# ---------- 4. Sensitivity checks ----------
def run(test_fn, label):
    sig = sum(test_fn(i) < 0.05 for i in range(n))
    print(f"  {label:<48} {sig}/{n} = {sig/n*100:.2f}%")
    return sig

print("\n=== SENSITIVITY CHECKS ===")
# Mann-Whitney U on Ct
run(lambda i: stats.mannwhitneyu(
        pat[i][~np.isnan(pat[i])], ctrl[i][~np.isnan(ctrl[i])],
        alternative='two-sided').pvalue, "Mann-Whitney U on raw Ct")

# global-mean normalization: subtract each sample's mean Ct over non-NAN miRNAs
col_mean = np.nanmean(mat, axis=0)
matn = mat - col_mean
pn_, cn_ = matn[:, :10], matn[:, 10:]
sig_n = 0
for i in range(n):
    x, y = pn_[i][~np.isnan(pn_[i])], cn_[i][~np.isnan(cn_[i])]
    if stats.ttest_ind(x, y, equal_var=False).pvalue < 0.05: sig_n += 1
print(f"  {'Welch t-test on global-mean-normalized Ct':<48} {sig_n}/{n} = {sig_n/n*100:.2f}%")

# complete-row deletion (drop any miRNA with a NAN)
complete = [i for i in range(n) if not np.isnan(mat[i]).any()]
sig_c = sum(stats.ttest_ind(pat[i], ctrl[i], equal_var=False).pvalue < 0.05 for i in complete)
print(f"  {'Welch t-test, complete rows only (n rows = %d)' % len(complete):<48} "
      f"{sig_c}/{len(complete)} = {sig_c/len(complete)*100:.2f}%")

# Student t (equal variance) for reference
run(lambda i: stats.ttest_ind(
        pat[i][~np.isnan(pat[i])], ctrl[i][~np.isnan(ctrl[i])],
        equal_var=True).pvalue, "Student t-test (equal variance) on raw Ct")

# agreement between Welch and MWU on which miRNAs are significant
mwu = [stats.mannwhitneyu(pat[i][~np.isnan(pat[i])], ctrl[i][~np.isnan(ctrl[i])]).pvalue
       for i in range(n)]
agree = sum((r[2] < 0.05) == (m < 0.05) for r, m in zip(res, mwu))
print(f"  Welch vs Mann-Whitney agreement on significance: {agree}/{n}")

print("\nAll 175 miRNAs with Welch p-values saved to work/results_welch.csv")
with open(f'{WORK}/results_welch.csv', 'w', newline='') as f:
    w = csv.writer(f)
    w.writerow(['miRNA', 't_stat', 'p_value', 'direction', 'n_patient', 'n_control', 'sig_p05'])
    for nme, t, pv, dr, nx, ny in res:
        w.writerow([nme, f'{t:.4f}', f'{pv:.4e}', dr, nx, ny, pv < 0.05])
