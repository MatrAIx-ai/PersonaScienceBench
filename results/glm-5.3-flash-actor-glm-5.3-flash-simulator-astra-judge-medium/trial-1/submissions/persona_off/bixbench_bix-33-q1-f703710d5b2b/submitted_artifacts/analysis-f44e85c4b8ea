"""bixbench:bix-33-q1 — Which immune cell type has the highest number of significantly
differentially expressed genes after AAV9 mini-dystrophin treatment?

Method (approved):
- Authoritative source: "Supplemental Data File 1 PostvsPre_DEG_tables_ANNOTATED by_cell_type.xlsx"
  (25 worksheets = 25 immune cell types; Post-vs-Pre DEG tables, Seurat-style columns:
  gene (Unnamed: 0), p_val, avg_log2FC, pct.1, pct.2, p_val_adj).
- Significant = Benjamini-Hochberg p_val_adj < 0.05, up- and down-regulated genes combined,
  no fold-change cutoff in the primary definition; p_val_adj = 0.0 (underflow) counted as significant.
- Sensitivity check: same threshold plus |avg_log2FC| >= 0.25.
- Sheet name = cell type label.
"""
import pandas as pd

XLSX = "data/Supplemental Data File 1 PostvsPre_DEG_tables_ANNOTATED by_cell_type.xlsx"
PADJ_CUT = 0.05
FC_CUT = 0.25

xl = pd.ExcelFile(XLSX)
assert len(xl.sheet_names) == 25, f"expected 25 sheets, got {len(xl.sheet_names)}"

rows = []
for sheet in xl.sheet_names:
    df = xl.parse(sheet)
    assert list(df.columns) == ["Unnamed: 0", "p_val", "avg_log2FC", "pct.1", "pct.2", "p_val_adj"]
    assert df["p_val_adj"].isna().sum() == 0
    n_dupes = int(df["Unnamed: 0"].duplicated().sum())
    sig = df["p_val_adj"] < PADJ_CUT                      # padj==0.0 counts (0.0 < 0.05)
    sig_fc = sig & (df["avg_log2FC"].abs() >= FC_CUT)
    rows.append({
        "cell_type": sheet,
        "rows_in_sheet": len(df),
        "unique_genes": int(df["Unnamed: 0"].nunique()),
        "dup_genes": n_dupes,
        "sig_total": int(sig.sum()),
        "sig_up": int((sig & (df["avg_log2FC"] > 0)).sum()),
        "sig_down": int((sig & (df["avg_log2FC"] < 0)).sum()),
        "sig_fc0.25": int(sig_fc.sum()),
        "zero_lfc_sig": int((sig & (df["avg_log2FC"] == 0)).sum()),
    })

res = pd.DataFrame(rows).sort_values("sig_total", ascending=False).reset_index(drop=True)
res.insert(0, "rank", range(1, len(res) + 1))
pd.set_option("display.width", 160)
print("Per-cell-type significant DEG counts (Post-AAV vs Pre-AAV, p_val_adj < 0.05):\n")
print(res.to_string(index=False))

tot = res["sig_total"].sum()
print(f"\nTotal significant DEG rows across all 25 sheets: {tot}")
top, second, third = res.iloc[0], res.iloc[1], res.iloc[2]
print(f"\nANSWER: {top['cell_type']} has the highest number of significantly DE genes "
      f"({top['sig_total']} of {top['rows_in_sheet']} tested genes; {top['sig_up']} up / {top['sig_down']} down).")
print(f"Runners-up: {second['cell_type']} ({second['sig_total']}: {second['sig_up']} up / {second['sig_down']} down), "
      f"{third['cell_type']} ({third['sig_total']}: {third['sig_up']} up / {third['sig_down']} down).")

mismatch = res[res["sig_total"] != res["sig_fc0.25"]]
print("\nSensitivity check (adding |avg_log2FC| >= 0.25):",
      "identical counts for every cell type" if mismatch.empty else f"differences:\n{mismatch}")
res.to_csv("deg_counts_by_cell_type.csv", index=False)
print("\nSaved ranked table to deg_counts_by_cell_type.csv")
