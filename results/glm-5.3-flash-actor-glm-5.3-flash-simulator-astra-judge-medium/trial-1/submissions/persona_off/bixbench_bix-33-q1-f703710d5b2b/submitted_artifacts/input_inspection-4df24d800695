"""Input inspection for bixbench:bix-33-q1 (does NOT run the final analysis)."""
import collections, struct
import numpy as np
import pandas as pd
import h5mini as h

XLSX = "data/Supplemental Data File 1 PostvsPre_DEG_tables_ANNOTATED by_cell_type.xlsx"
H5AD = "data/MS_DMD_all_conga_final.h5ad"

print("=" * 30, "1) XLSX DEG TABLES", "=" * 30)
xl = pd.ExcelFile(XLSX)
print("number of worksheets:", len(xl.sheet_names))
for s in xl.sheet_names:
    df = xl.parse(s)
    print(f"  {s:16s} rows={len(df):5d} cols={list(df.columns)} missing_p_val_adj={int(df['p_val_adj'].isna().sum())}")

print("=" * 30, "2) H5AD (via minimal pure-Python HDF5 reader)", "=" * 30)
r = h.Reader(H5AD)
root = r.list_group(r.root_entry["ohdr"])
print("root keys:", sorted(root.keys()))
X = r.dataset_info(root["X"])
print("X dims [cells, genes]:", X["dims"])
obs = r.list_group(root["obs"])
var = r.list_group(root["var"])
print("obs columns:", sorted(obs.keys()))
print("var columns:", sorted(var.keys()))
print("n cells:", len(h.read_dataset_values2(r, obs["_index"])))
print("n genes:", len(h.read_dataset_values2(r, var["_index"])))
sb = r.list_group(obs["Status_batch"])
print("Status_batch categories:", h.read_dataset_values2(r, sb["categories"]))
print("Status_batch counts:", collections.Counter(x for x in h.read_dataset_values2(r, sb["codes"])))
cg = r.list_group(obs["clusters_gex_for_degs"])
print("clusters_gex_for_degs categories:", h.read_dataset_values2(r, cg["categories"]))
uns = r.list_group(root["uns"])
p = r.list_group(r.list_group(uns["degs_for_gex_clusters"])["params"])
for k, a in sorted(p.items()):
    try: print("degs_for_gex_clusters params:", k, "=", h.read_dataset_values2(r, a))
    except Exception as e: print("   ", k, "ERR", repr(e)[:50])

print("=" * 30, "3) QUALITY / ALIGNMENT", "=" * 30)
h5genes = set(h.read_dataset_values2(r, var["_index"]))
allgenes = set()
for s in xl.sheet_names:
    allgenes |= set(xl.parse(s)["Unnamed: 0"])
print("unique xlsx genes:", len(allgenes), "| overlap with h5ad 715 genes:", len(allgenes & h5genes))
print("h5ad cell-type field: numeric clusters only (clusters_gex_for_degs, 18 clusters);",
      "no named cell-type column -> xlsx sheets (25 named immune cell types) are the annotated label source")
print("treatment encoded: Status_batch = Post-AAV (n=21874) vs Pre-AAV (n=19591); Status 0/1 mirrors it")
