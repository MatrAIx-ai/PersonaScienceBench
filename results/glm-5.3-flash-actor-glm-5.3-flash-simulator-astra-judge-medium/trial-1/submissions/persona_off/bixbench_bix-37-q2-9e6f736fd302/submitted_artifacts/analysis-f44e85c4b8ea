"""
BixBench bix-37-q2: Base protein level of ENO1 in normal samples.
Extracts the ENO1 'Normal' value from the proteomic data and rounds to 3 significant figures.
"""
import pandas as pd

FILE = "data/Proteomic_data .xlsx"   # note the space in the filename
SHEET = "Tumor vs Normal"

df = pd.read_excel(FILE, sheet_name=SHEET)

# Drop the empty trailing unnamed columns (列1, 列2) present in the raw sheet
empty_cols = [c for c in df.columns if df[c].notna().sum() == 0]
df = df.drop(columns=empty_cols)
print(f"Loaded {df.shape[0]} rows x {df.shape[1]} columns; dropped empty columns: {empty_cols}")

# Filter to ENO1 (gene name and UniProt accession P06733)
eno1 = df[(df["gene"] == "ENO1") | (df["protein"] == "P06733")]
print(f"ENO1 rows found: {len(eno1)}")
row = eno1.iloc[0]
print(row.to_string())

# Extract Normal value verbatim
normal_raw = row["Normal"]
print(f"\nENO1 Normal (verbatim): {normal_raw!r}")

# Round to 3 significant figures
from decimal import Decimal
def sig3(x) -> float:
    d = Decimal(repr(float(x)))
    exp = d.adjusted()          # power-of-10 exponent of leading digit
    return float(round(d, -(exp - 2)))

    assert Decimal(repr(float(normal_raw))) == Decimal("72896133.2946858")
rounded = sig3(normal_raw)
print(f"Rounded to 3 significant figures: {rounded:.3g}  (= {rounded:,.0f})")

print("\nFINAL ANSWER: The base protein level of ENO1 in normal samples is "
      f"{rounded:.3g} (= {rounded:,.0f}) — the linear-scale aggregate MS intensity "
      "reported in the 'Normal' column for ENO1 (UniProt P06733, gene_id 2023), "
      "sheet 'Tumor vs Normal'.")
