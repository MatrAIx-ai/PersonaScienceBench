"""
BixBench bix-42-q2 — Skewness of TCGA COAD RNA expression distribution.
Executed analysis: primary Fisher-Pearson G1 over pooled linear-scale values,
with Pearson-2 and Bowley corroboration, normality tests, per-sample/per-gene
summaries, tumor-only and log2(x+1) sensitivities, and duplicate-gene check.
"""
import numpy as np
import pandas as pd
from scipy import stats

RNG = np.random.default_rng(42)

def g1(x):
    """Fisher-Pearson standardized skewness coefficient (sample, biased)."""
    x = np.asarray(x, float); n = x.size
    m = x.mean(); s = x.std()
    return n * ((x - m) ** 3).sum() / ((n - 1) * (n - 2) * s ** 3)

def g1_adj(x):
    """Sample-size-corrected (SPSS-style) skewness."""
    x = np.asarray(x, float); n = x.size
    return np.sqrt(n * (n - 1)) / (n - 2) * g1(x)

def pearson2(x):
    x = np.asarray(x, float)
    return 3.0 * (x.mean() - np.median(x)) / x.std()

def bowley(x):
    q1, q2, q3 = np.percentile(x, [25, 50, 75])
    iqr = q3 - q1
    return (q3 + q1 - 2 * q2) / iqr if iqr > 0 else 0.0

print("=" * 70)
print("LOAD: data/COAD__geneExp.xls")
df = pd.read_csv("data/COAD__geneExp.xls", sep="\t", index_col=0)
n_genes, n_samples = df.shape
print(f"matrix: {n_genes} genes x {n_samples} samples; NaNs={int(df.isna().sum().sum())}")
print("duplicate gene symbols:", int(df.index.duplicated().sum()))

# --- Primary: pooled linear-scale distribution ---
V = df.to_numpy(float)
flat = V.ravel()
N = flat.size
print(f"\n--- POOLED LINEAR-SCALE DISTRIBUTION (N={N:,}) ---")
print(f"mean={flat.mean():.2f}  median={np.median(flat):.2f}  SD={flat.std():.2f}")
q = np.percentile(flat, [1, 5, 25, 50, 75, 95, 99, 99.9])
print("quantiles 1/5/25/50/75/95/99/99.9%:", np.round(q, 2))
print(f"exact zeros: {(flat == 0).sum():,} ({100*(flat==0).mean():.2f}%)")

G1 = g1(flat)
se_g1 = np.sqrt(6.0 * N * (N - 1) / ((N - 2) * (N + 1) * (N + 3)))
print(f"Fisher-Pearson G1 = {G1:.2f}  (SE under normality = {se_g1:.4f}; "
      f"G1/SE = {G1/se_g1:,.0f})")
print(f"corrected G1 (SPSS) = {g1_adj(flat):.2f}")
print(f"Pearson-2  [3(mean-med)/SD] = {pearson2(flat):.2f}")
print(f"Bowley quantile skewness = {bowley(flat):.3f}  (0=symmetric, +1=extreme right)")

# Normality comparison on a large subsample (scipy needs manageable n for tests)
sub = RNG.choice(flat, size=1_000_000, replace=False)
dag = stats.normaltest(sub)          # D'Agostino-Pearson K^2
jb = stats.jarque_bera(sub)
print(f"D'Agostino K^2 on 1M subsample: stat={dag.statistic:,.0f} p={dag.pvalue:.3g}")
print(f"Jarque-Bera on 1M subsample:    stat={jb.statistic:.3g} p={jb.pvalue:.3g}")

# Histogram + QQ view for the record (text form + saved arrays)
h, edges = np.histogram(flat, bins=[0, 0.01, 0.1, 1, 10, 100, 1e3, 1e4, 1e5, 1.4e6])
print("histogram (bins 0,0.01,0.1,1,10,100,1e3,1e4,1e5,1.4e6):", h)
np.savez_compressed("output/pooled_hist.npz", counts=h, edges=edges)
qsub = np.sort(RNG.choice(flat, size=20000, replace=False))
theo = stats.norm.ppf((np.arange(1, 20001) - 0.5) / 20000, loc=sub.mean(), scale=sub.std())
qq = np.column_stack([theo[::200], qsub[::200]])
np.save("output/qq_points.npy", qq)
print("QQ sample (theoretical normal vs observed, every 200th of 20k):")
for t, o in qq[::25]:
    print(f"   theo={t:>12,.1f}  obs={o:>12,.1f}")

# --- Per-sample skewness ---
ss = df.skew(axis=0)
print(f"\n--- PER-SAMPLE SKEWNESS (n={len(ss)}) ---")
print(f"median={ss.median():.2f}  mean={ss.mean():.2f}  IQR=[{ss.quantile(.25):.2f}, {ss.quantile(.75):.2f}]"
      f"  range=[{ss.min():.2f}, {ss.max():.2f}]")
print("all samples positive:", bool((ss > 0).all()))

# --- Per-gene skewness ---
gs = df.skew(axis=1)
print(f"\n--- PER-GENE SKEWNESS (n={len(gs)}) ---")
print(f"median={gs.median():.2f}  mean={gs.mean():.2f}  IQR=[{gs.quantile(.25):.2f}, {gs.quantile(.75):.2f}]"
      f"  range=[{gs.min():.2f}, {gs.max():.2f}]")
print("fraction of genes with G1>0:", f"{(gs>0).mean():.3f}")

# --- Tumor-only sensitivity (sample-type code 01 = primary tumor) ---
tumor_cols = [c for c in df.columns if c.split("-")[3][:2] == "01"]
Vt = df[tumor_cols].to_numpy(float).ravel()
print(f"\n--- SENSITIVITY: TUMOR-ONLY (n={len(tumor_cols)} samples, code 01) ---")
print(f"G1={g1(Vt):.2f}  Pearson-2={pearson2(Vt):.2f}  Bowley={bowley(Vt):.3f}")

# --- Duplicate gene symbols: average vs keep-as-is ---
dups = df.index[df.index.duplicated(keep=False)].unique()
df_avg = df.groupby(level=0).mean()
G1_avg = g1(df_avg.to_numpy(float).ravel())
print(f"\n--- DUPLICATE-GENE CHECK ({len(dups)} duplicated symbols) ---")
print(f"G1 with duplicates kept as-is = {G1:.2f}")
print(f"G1 with duplicated symbols averaged = {G1_avg:.2f}")

# --- Log2(x+1) sensitivity (clearly labeled) ---
L = np.log2(V + 1.0).ravel()
print(f"\n--- SENSITIVITY: LOG2(x+1) SCALE (NOT the basis for the verdict) ---")
print(f"mean={L.mean():.2f}  median={np.median(L):.2f}")
print(f"G1={g1(L):.2f}  Pearson-2={pearson2(L):.2f}  Bowley={bowley(L):.3f}")
dagL = stats.normaltest(RNG.choice(L, size=1_000_000, replace=False))
print(f"D'Agostino K^2 on 1M log subsample: stat={dagL.statistic:,.0f} p={dagL.pvalue:.3g}")

print("\n" + "=" * 70)
print("VERDICT BASIS: pooled linear-scale Fisher-Pearson G1 on data as supplied.")
