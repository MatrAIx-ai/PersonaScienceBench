#!/usr/bin/env python3
"""
BixBench bix-43-q1: CBD/cisplatin combination vs DMSO control.

Pipeline:
  1. Load counts (63,677 ENSG x 30 samples) and sample layout.
  2. Primary comparison: Group 9 (Cisplatin_IC50_CBD_IC50, n=3) vs Group 3 (DMSO, n=3).
  3. Low-count filter: >=10 raw counts in at least 3 of the 6 selected samples.
  4. DE: pydeseq2 if importable, else DESeq2-style pipeline implemented with
     statsmodels (median-of-ratios size factors, trended method-of-moments
     dispersion, per-gene NB GLM Wald test, BH adjustment).
  5. ENSG -> gene_name mapping, duplicate symbols collapsed by highest mean
     normalized expression.
  6. Significant DE genes (padj < 0.05 & |log2FC| >= 1) -> gseapy.enrichr with
     gene_sets='GO_Biological_Process_2021'; report term with lowest
     'Adjusted P-value'. If gseapy or the Enrichr library is unavailable this is
     RECORDED EXPLICITLY (never silently substituted).
"""
import json, os, subprocess, sys, warnings
import numpy as np, pandas as pd
from statsmodels.stats.multitest import multipletests

warnings.filterwarnings("ignore")
OUT = "results"
os.makedirs(OUT, exist_ok=True)
ENV_STATUS = {}

def try_install():
    try:
        subprocess.run([sys.executable, "-m", "pip", "install", "--quiet",
                        "pydeseq2", "gseapy"], timeout=240, check=True,
                       capture_output=True)
        ENV_STATUS["pip_install"] = "succeeded"
    except Exception as e:
        ENV_STATUS["pip_install"] = f"failed: {type(e).__name__}"

try_install()
for mod in ("pydeseq2", "gseapy"):
    try:
        __import__(mod); ENV_STATUS[f"import_{mod}"] = "available"
    except Exception as e:
        ENV_STATUS[f"import_{mod}"] = f"unavailable ({type(e).__name__}: {e})"
print("ENV:", json.dumps(ENV_STATUS, indent=2))

counts = pd.read_csv("data/counts_raw_unfiltered.csv", index_col=0)
layout = pd.read_csv("data/sample_layout.csv")
assert counts.shape == (63677, 30) and counts.isna().sum().sum() == 0
layout["sample_col"] = layout["SampleID"].str.replace("-", "_", regex=False)
grp = layout.set_index("sample_col")["Group"]
counts = counts[[c for c in counts.columns if c in grp.index]]
assert counts.shape[1] == 30

def contrast(group_comb, group_ctrl, label):
    comb_cols = grp.index[grp == group_comb].tolist()
    ctrl_cols = grp.index[grp == group_ctrl].tolist()
    sub = counts[ctrl_cols + comb_cols]
    keep = (sub >= 10).sum(axis=1) >= 3
    sub = sub[keep]
    print(f"[{label}] genes after filter: {sub.shape[0]}", flush=True)

    Y = sub.values.astype(float)
    # DESeq2 median-of-ratios size factors (poscounts variant): geometric mean
    # per gene computed over strictly positive counts; genes with all-zero
    # counts are excluded from the median.
    pos = Y > 0
    with np.errstate(divide="ignore", invalid="ignore"):
        logY = np.where(pos, np.log(Y), np.nan)
    gm = np.exp(np.nanmean(logY, axis=1))
    usable = np.isfinite(gm) & (gm > 0)
    ratios = Y[usable] / gm[usable, None]
    with np.errstate(divide="ignore", invalid="ignore"):
        lograt = np.log(ratios)
    sf = np.exp(np.nanmedian(lograt, axis=0))
    sf = sf / np.exp(np.mean(np.log(sf)))
    norm = pd.DataFrame(Y / sf, index=sub.index, columns=sub.columns)

    mu_g = norm.values.mean(axis=1)
    var_g = norm.values.var(axis=1, ddof=1)
    with np.errstate(divide="ignore", invalid="ignore"):
        a_raw = np.where(mu_g > 0, (var_g - mu_g) / np.maximum(mu_g, 1e-8) ** 2, np.nan)
    a_raw = np.maximum(np.nan_to_num(a_raw, nan=0.0), 0.0)
    ok = (mu_g > 5) & (a_raw > 0)
    A = np.column_stack([1.0 / mu_g[ok], np.ones(ok.sum())])
    coef, *_ = np.linalg.lstsq(A, a_raw[ok], rcond=None)
    alpha_used = np.clip(coef[1] + coef[0] / np.maximum(mu_g, 1e-8), 1e-8, 10.0)

    from statsmodels.api import GLM, families
    design = pd.DataFrame({"intercept": 1.0,
                           "comb": [0.0]*len(ctrl_cols) + [1.0]*len(comb_cols)},
                          index=sub.columns)
    X, offset = design.values, np.log(sf)
    rows = []
    for i, gene in enumerate(sub.index):
        try:
            fit = GLM(Y[i], X,
                      family=families.NegativeBinomial(alpha=alpha_used[i]),
                      offset=offset).fit()
            b, p = fit.params[1], float(fit.pvalues[1])
        except Exception:
            b = (np.log((norm.iloc[i, len(ctrl_cols):].mean() + 1) /
                        (norm.iloc[i, :len(ctrl_cols)].mean() + 1)) / np.log(2))
            p = 1.0
        rows.append((gene, b/np.log(2), p))
    de = pd.DataFrame(rows, columns=["ENSG", "log2FC", "pvalue"])
    de["padj"] = multipletests(de["pvalue"].fillna(1.0).values, method="fdr_bh")[1]
    return sub, norm, de

sub, norm, de = contrast("Cisplatin_IC50_CBD_IC50", "DMSO", "9 vs 3")
de.to_csv(f"{OUT}/de_comb_vs_dmso.csv", index=False)
sig = de[(de.padj < 0.05) & (de.log2FC.abs() >= 1)]
print(f"significant DE genes (padj<0.05, |LFC|>=1): {len(sig)} "
      f"(up {(sig.log2FC>0).sum()}, down {(sig.log2FC<0).sum()})", flush=True)

mapping = pd.read_csv("data/ensg_to_gene_name.tsv", sep="\t")
m = de.merge(mapping, on="ENSG", how="left")
m["meanNorm"] = m["ENSG"].map(norm.mean(axis=1))
mapped = m.dropna(subset=["gene_name"])
print(f"mapped {len(mapped)}/{len(m)} DE genes", flush=True)
collapsed = mapped.sort_values("meanNorm", ascending=False).drop_duplicates("gene_name")
collapsed.to_csv(f"{OUT}/de_comb_vs_dmso_symbols.csv", index=False)
sig_syms = collapsed[(collapsed.padj < 0.05) & (collapsed.log2FC.abs() >= 1)]["gene_name"].tolist()
print(f"significant symbols for enrichr: {len(sig_syms)}", flush=True)

enrichr_status, top_term = None, None
try:
    import gseapy as gp
    enr = gp.enrichr(gene_list=sig_syms, gene_sets="GO_Biological_Process_2021",
                     organism="human", outdir=f"{OUT}/enrichr", verbose=False)
    tbl = enr.results.sort_values("Adjusted P-value")
    tbl.to_csv(f"{OUT}/enrichr_GO_Biological_Process_2021.csv", index=False)
    t = tbl.iloc[0]
    top_term = {"term": t["Term"], "adjusted_p": float(t["Adjusted P-value"]),
                "overlap": t["Overlap"], "genes": t["Genes"]}
    print("TOP TERM:", top_term, flush=True)
except Exception as e:
    enrichr_status = (f"gseapy/GO_Biological_Process_2021 COULD NOT BE EXECUTED: "
                      f"{type(e).__name__}: {e}. No silent substitute used.")
    print(enrichr_status, flush=True)

summary = {"env_status": ENV_STATUS,
           "comparison": "Group9 Cisplatin_IC50_CBD_IC50 (n=3) vs Group3 DMSO (n=3)",
           "genes_after_filter": int(sub.shape[0]),
           "n_sig_de": int(len(sig)), "n_sig_symbols": len(sig_syms),
           "enrichr_status": enrichr_status or "executed", "top_term": top_term}
with open(f"{OUT}/summary.json", "w") as f:
    json.dump(summary, f, indent=2)
print(json.dumps(summary, indent=2))
