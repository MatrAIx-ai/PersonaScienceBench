"""
BixBench bix-43-q2 — full analysis script (DESeq2-style NB DE + enrichment attempt).

Question: odds ratio for "p53-mediated cell cycle gene regulation" in gseapy/Reactome_2022
enrichment of DE genes (p<0.05, |lfc|>0.5, baseMean>10) between CBD/cisplatin combination
(Group 9: Cisplatin_IC50_CBD_IC50) and DMSO (Group 3).

DE model: DESeq2-style — median-of-ratios size factors, per-gene NB dispersion MLE by
profile likelihood, parametric dispersion trend a1/mu + a0, log-scale shrinkage to a
MAP dispersion (DESeq2 prior), NB GLM Wald test on the condition coefficient.
"""
import numpy as np
import pandas as pd
import scipy.stats as st
import warnings
warnings.filterwarnings("ignore")

rng = np.random.default_rng(0)

# ------------------------------------------------------------------ load data
counts = pd.read_csv("data/counts_raw_unfiltered.csv", index_col=0)
layout = pd.read_csv("data/sample_layout.csv")
emap = pd.read_csv("data/ensg_to_gene_name.tsv", sep="\t")

counts.columns = [c.replace("_", "-") for c in counts.columns]
gmap = dict(zip(layout["SampleID"], layout["Group"]))
CTRL, COMBO = "DMSO", "Cisplatin_IC50_CBD_IC50"
cols = [s for s in counts.columns if gmap.get(s) == CTRL] + \
       [s for s in counts.columns if gmap.get(s) == COMBO]
print("DMSO cols:", cols[:3], " combo cols:", cols[3:])
mat = counts.loc[:, cols].to_numpy(dtype=float)
nsamp = mat.shape[1]
grp = np.array([0] * 3 + [1] * 3)
X = np.column_stack([np.ones(nsamp), grp.astype(float)])

# ------------------------------------------- DESeq2 median-of-ratios size factors
nz = (mat > 0).all(axis=1)
gm = np.exp(np.log(mat[nz]).mean(axis=1))
sf = np.median(mat[nz] / gm[:, None], axis=0)
sf = sf / np.exp(np.log(sf).mean())
norm = mat / sf
base_mean = norm.mean(axis=1)
print("size factors:", np.round(sf, 4).tolist())

# ------------------------------------------------- NB profile-likelihood machinery
LOGSF = np.log(sf)
Y = mat                       # (G, 6)

def fit_beta(y, alpha, b0, eta_off, tol=1e-8, itmax=60):
    """Vectorized Newton for NB GLM, fixed alpha (scalar or (G,)).
    Returns beta (G,2), loglik (G,), ok (G, bool)."""
    G, J = y.shape
    a = alpha if np.isscalar(alpha) else np.asarray(alpha)[:, None]
    b = np.where(np.isfinite(b0), b0, 0.0)
    eta = np.clip(b @ X.T + eta_off, -30, 30)
    mu = np.exp(eta)
    ll_prev = (y * (eta - np.log1p(a * mu)) - (1.0 / a) * np.log1p(a * mu)).sum(1)
    ll_prev = np.where(np.isfinite(ll_prev), ll_prev, -1e10)
    ok = np.zeros(G, bool)
    for _ in range(itmax):
        W = mu / (1.0 + a * mu)
        U = ((y - mu) * W) @ X
        F = np.empty((G, 2, 2))
        F[:, 0, 0] = (W * X[None, :, 0] * X[None, :, 0]).sum(1)
        F[:, 0, 1] = F[:, 1, 0] = (W * X[None, :, 0] * X[None, :, 1]).sum(1)
        F[:, 1, 1] = (W * X[None, :, 1] * X[None, :, 1]).sum(1)
        det = F[:, 0, 0] * F[:, 1, 1] - F[:, 0, 1] ** 2
        det = np.where(det <= 0, 1e-12, det)
        step = np.column_stack([
            (F[:, 1, 1] * U[:, 0] - F[:, 0, 1] * U[:, 1]) / det,
            (F[:, 0, 0] * U[:, 1] - F[:, 0, 1] * U[:, 0]) / det])
        step = np.clip(step, -5, 5)
        for _h in range(6):                          # step halving on ll decrease
            b_new = b + step
            eta_n = np.clip(b_new @ X.T + eta_off, -30, 30)
            mu_n = np.exp(eta_n)
            ll_n = (y * (eta_n - np.log1p(a * mu_n)) -
                    (1.0 / a) * np.log1p(a * mu_n)).sum(1)
            better = np.isfinite(ll_n) & (ll_n >= ll_prev - 1e-9)
            if better.all():
                break
            step = step * 0.5
        worse = (~better) | ~np.isfinite(ll_n)
        b_new[worse] = b[worse]
        ll_n[worse] = ll_prev[worse]
        ok = np.isfinite(ll_n) & (np.abs(ll_n - ll_prev) < tol * (np.abs(ll_prev) + 1.0))
        b, ll_prev, eta, mu = b_new, ll_n, eta_n, mu_n
        if ok.all():
            break
    return b, ll_prev, ok

# genes analysed: baseMean > 10 (DESeq2 independent-filtering regime; matches the stated filter)
sel = base_mean > 10
ys = mat[sel]
bs = base_mean[sel]
Gs = ys.shape[0]
print(f"genes analysed (baseMean>10): {Gs}")

A_GRID = np.exp(np.linspace(np.log(1e-3), np.log(30.0), 33))   # dispersion grid

# start from normalized group means
m0 = (ys[:, :3] / sf[:3]).mean(1)
m1 = (ys[:, 3:] / sf[3:]).mean(1)
b0 = np.column_stack([np.log(m0 + 0.5), np.log((m1 + 0.5) / (m0 + 0.5))])
LL = np.empty((Gs, len(A_GRID)))
BET = np.empty((Gs, len(A_GRID), 2))
CONV = np.zeros((Gs, len(A_GRID)), bool)
for k, a in enumerate(A_GRID):
    b, ll, ok = fit_beta(ys, a, b0, LOGSF[None, :])
    BET[:, k, :] = b
    LL[:, k] = np.where(np.isfinite(ll), ll, -np.inf)
    CONV[:, k] = ok
print("profile grid done; converged frac:", CONV.mean().round(3))

# parabolic refinement of alpha MLE
kmax = LL.argmax(1)
def parab(y0, y1, y2):
    d = (y0 - 2 * y1 + y2)
    d = np.where(np.abs(d) < 1e-12, 1e-12, d)
    return np.clip(0.5 * (y0 - y2) / d, -1, 1)
bad = ~np.isfinite(LL).any(1)
kk = np.clip(kmax, 1, len(A_GRID) - 2)
y0, y1, y2 = LL[np.arange(Gs), kk - 1], LL[np.arange(Gs), kk], LL[np.arange(Gs), kk + 1]
delta = parab(y0, y1, y2)
alpha_mle = np.exp(np.log(A_GRID[kk]) + delta * (np.log(A_GRID[1]) - np.log(A_GRID[0])))
alpha_mle = np.clip(alpha_mle, A_GRID[0], A_GRID[-1])
alpha_mle[bad] = np.nan
print("alpha MLE: median", np.median(alpha_mle).round(3),
      "q10", np.quantile(alpha_mle, .1).round(3),
      "q90", np.quantile(alpha_mle, .9).round(3))

# ------------------------------------------------- parametric trend a1/mu + a0
use = CONV.any(1) & (alpha_mle > 1e-3) & (alpha_mle < 20) & (bs > 10)
x, ya = bs[use], alpha_mle[use]
coef, *_ = np.linalg.lstsq(np.column_stack([np.ones_like(x), 1.0 / x]), ya, rcond=None)
a0f, a1f = coef
# robust refit: drop extreme outliers, refit
r = ya - (a0f + a1f / x)
keep = r < np.quantile(r, 0.97)
coef, *_ = np.linalg.lstsq(np.column_stack([np.ones_like(x[keep]), 1.0 / x[keep]]), ya[keep], rcond=None)
a0f, a1f = coef
trend = np.clip(a0f + a1f / np.maximum(bs, 1e-8), 1e-4, 30.0)
print(f"trend fit: a0={a0f:.4f} a1={a1f:.3f} (genes in robust fit: {keep.sum()})")

# ------------------------------------------------------ prior variance + MAP
lg = np.log(alpha_mle)
hi = bs > 50
sig1 = np.var(lg[hi]) if hi.sum() > 10 else np.var(lg)
sig2 = 2.0 / (nsamp - 2)          # approx sampling variance of log alpha MLE
prior_var = float(np.clip(sig1 - sig2, 0.6 * sig1, 10.0))
print(f"prior var on log alpha: {prior_var:.3f} (sig1={sig1:.3f}, sig2={sig2:.3f})")

# MAP dispersion: maximize ll(alpha) - (log a - log trend)^2/(2 prior_var)
target = LL - (np.log(A_GRID)[None, :] - np.log(trend)[:, None]) ** 2 / (2 * prior_var)
kmap = target.argmax(1)
kk2 = np.clip(kmap, 1, len(A_GRID) - 2)
y0, y1, y2 = target[np.arange(Gs), kk2 - 1], target[np.arange(Gs), kk2], target[np.arange(Gs), kk2 + 1]
delta = parab(y0, y1, y2)
alpha_map = np.exp(np.log(A_GRID[kk2]) + delta * (np.log(A_GRID[1]) - np.log(A_GRID[0])))
alpha_map = np.clip(alpha_map, 1e-4, 30.0)
print("alpha MAP: median", np.median(alpha_map).round(3))

# ---------------------------------------------------- final fit + Wald test
# refit at MAP alpha (start from grid betas at nearest grid point)
b_start = BET[np.arange(Gs), kk2, :]
b_start = np.where(np.isfinite(b_start), b_start, b0)
b, llf, okf = fit_beta(ys, alpha_map, b_start, LOGSF[None, :])
eta = b @ X.T + LOGSF[None, :]
mu = np.exp(eta)
W = mu / (1.0 + alpha_map[:, None] * mu)
F = np.empty((Gs, 2, 2))
F[:, 0, 0] = (W * X[None, :, 0] ** 2).sum(1)
F[:, 0, 1] = F[:, 1, 0] = (W * X[None, :, 0] * X[None, :, 1]).sum(1)
F[:, 1, 1] = (W * X[None, :, 1] ** 2).sum(1)
det = F[:, 0, 0] * F[:, 1, 1] - F[:, 0, 1] ** 2
det = np.where(det <= 0, 1e-12, det)
se1 = np.sqrt(np.where(det > 0, F[:, 0, 0] / det, np.nan))  # F^-1[1,1] = F00/det
lfc = b[:, 1] / np.log(2.0)
z = b[:, 1] / se1
pval = 2 * st.norm.sf(np.abs(z))

res = pd.DataFrame({
    "ENSG": counts.index[sel], "baseMean": bs, "log2FoldChange": lfc,
    "lfcSE": se1, "stat": z, "pvalue": pval, "alpha_MAP": alpha_map,
    "alpha_trend": trend,
})
print("converged final fit:", int(okf.sum()), "/", Gs)

# ------------------------------------------------------------------ filtering
n_basemean = len(res)
step_p = res[res["pvalue"] < 0.05]
n_p = len(step_p)
step_lfc = step_p[step_p["log2FoldChange"].abs() > 0.5]
n_lfc = len(step_lfc)
print(f"baseMean>10: {n_basemean} | p<0.05: {n_p} | p<0.05 & |lfc|>0.5: {n_lfc}")
print("up:", int((step_lfc['log2FoldChange'] > 0).sum()), "down:", int((step_lfc['log2FoldChange'] < 0).sum()))

# --------------------------------------------------------- ENSG -> gene symbol
res2 = res.merge(emap.drop_duplicates("ENSG"), on="ENSG", how="left")
n_mapped_all = int(res2["gene_name"].notna().sum())
de = res2.loc[step_lfc.index]
n_de_mapped = int(de["gene_name"].notna().sum())
symbols = (de.dropna(subset=["gene_name"])
             .sort_values("baseMean", ascending=False)
             .drop_duplicates("gene_name"))
n_symbols = len(symbols)
print(f"symbol coverage (all analysed): {n_mapped_all}/{n_basemean} | mapped DE: {n_de_mapped}/{n_lfc} | unique symbols: {n_symbols}")

res2.to_csv("output/de_results_basemean10.csv", index=False)
symbols.to_csv("output/de_genes_filtered_symbols.csv", index=False)
with open("output/de_gene_list.txt", "w") as f:
    f.write("\n".join(symbols["gene_name"].tolist()))
print("top 15 DE genes by baseMean:")
print(symbols[["ENSG", "gene_name", "baseMean", "log2FoldChange", "pvalue"]]
      .head(15).to_string(index=False))

# --------------------------------------------------- Step 2: gseapy enrichment
try:
    import gseapy
    ENR = gseapy.enrichr(gene_list=symbols["gene_name"].tolist(),
                         gene_sets="Reactome_2022", organism="Human",
                         outdir="output/enrichr", cutoff=1.0)
    tbl = ENR.results
    tbl.to_csv("output/reactome2022_results.csv", index=False)
    hits = tbl[tbl["Term"].str.contains("p53", case=False)]
    print(hits.to_string(index=False))
except Exception as e:
    msg = f"gseapy/Enrichr not executable in this environment: {type(e).__name__}: {e}"
    print("BLOCKER:", msg)
    with open("output/enrichment_blocker.txt", "w") as f:
        f.write(msg + "\n")
