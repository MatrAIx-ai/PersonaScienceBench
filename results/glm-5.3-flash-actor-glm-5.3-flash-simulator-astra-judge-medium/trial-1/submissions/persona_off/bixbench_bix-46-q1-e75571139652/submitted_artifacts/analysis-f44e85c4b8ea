#!/usr/bin/env python3
"""
BixBench bix-46-q1: log2 fold change of mexG in ΔrhlI (strain #97) vs WT (strain #1).

Approach (approved by researcher):
  Pure-Python parser for gzipped, XDR, serialization-format-3 RDS files (R is not
  available in this runner). Each file holds a DESeqResults S4 object (package
  DESeq2) with columns baseMean, log2FoldChange, lfcSE, stat, pvalue, padj and
  5828 rows keyed by PA14 locus tags. 'mexG' is mapped to locus tag PA14_09540
  via the PGD reference CSV. The stored mcols description
  "log2 fold change (MLE): Strain 97 vs 1" establishes that log2FoldChange is
  already expressed as ΔrhlI (strain 97) vs WT (strain 1), i.e. the direction the
  question asks for, so no sign flip is applied.
"""
import csv, gzip, struct, sys

NA_INT = -2147483648
STRSXP, INTSXP, REALSXP = 16, 13, 14

def is_rna_real(raw8):
    """True if the 8 big-endian bytes encode R's NA_real_ (low word = 1954 pattern)."""
    hi = struct.unpack('>I', raw8[0:4])[0]
    lo = struct.unpack('>I', raw8[4:8])[0]
    return (hi & 0x7fffffff) == 0x7ff00000 and 1950 <= lo <= 1978

def read_rds(path):
    """Load gzipped RDS; return (data, offset of first serialized item)."""
    d = gzip.open(path, 'rb').read()
    assert d[0:2] == b'X\n', 'unexpected RDS magic'
    version = struct.unpack_from('>i', d, 2)[0]
    assert version == 3, f'only format v3 supported, got {version}'
    # header: version(3), writer R version, min reader version, then the
    # encoding marker: [len]['UTF-8'] -> payload starts at 2 + 3*4 + 4 + len
    enc_len = struct.unpack_from('>i', d, 14)[0]
    start = 18 + enc_len
    return d, start

def char_strings(d, off, count):
    """Parse `count` CHARSXP items ([flags 0x40009][len][utf8 bytes]) from off."""
    out = []
    for _ in range(count):
        flags, ln = struct.unpack_from('>ii', d, off)
        assert flags == 0x00040009, f'bad CHARSXP header {hex(flags)} @ {off}'
        out.append(d[off + 8: off + 8 + ln].decode('utf-8'))
        off += 8 + ln
    return out, off

def find_all(d, pattern):
    idxs, off = [], 0
    while True:
        i = d.find(pattern, off)
        if i < 0:
            return idxs
        idxs.append(i)
        off = i + 4

def extract_results(d):
    """Extract (rownames, column names, column values) from a DESeqResults RDS."""
    # rownames STRSXP lives right after the header (slot 'rownames' of the S4)
    flags, n_rows = struct.unpack_from('>ii', d, 84)
    assert (flags & 0xff) == STRSXP and n_rows == 5828, (hex(flags), n_rows)
    rownames, end = char_strings(d, 92, n_rows)

    # the six numeric result columns are the six REALSXP vectors of length n_rows
    real_offsets = find_all(d, struct.pack('>ii', REALSXP, n_rows))
    assert len(real_offsets) == 6, f'expected 6 numeric columns, found {len(real_offsets)}'

    # column names come from the rownames of the elementMetadata (mcols) frame;
    # located via the 'baseMean' string near the end of the stream
    i_base = d.rfind(b'baseMean')
    i_item = i_base - 8                      # CHARSXP header of 'baseMean'
    s_flags, s_len = struct.unpack_from('>ii', d, i_item - 8)   # STRSXP header
    assert (s_flags & 0xff) == STRSXP and s_len == 6, (hex(s_flags), s_len)
    col_names, _ = char_strings(d, i_item, s_len)

    def col(off):
        vals = []
        for k in range(n_rows):
            raw = d[off + 8 + 8 * k: off + 16 + 8 * k]
            vals.append(None if is_rna_real(raw) else struct.unpack('>d', raw)[0])
        return vals

    cols = {nm: col(o) for nm, o in zip(col_names, real_offsets)}
    return rownames, col_names, cols

def mexG_lfc(path, gene='mexG', locus='PA14_09540'):
    d, _ = read_rds(path)
    rownames, col_names, cols = extract_results(d)
    assert col_names == ['baseMean', 'log2FoldChange', 'lfcSE', 'stat', 'pvalue', 'padj']
    assert rownames.count(locus) == 1, f'{locus} not unique in {path}'
    i = rownames.index(locus)
    lfc, se, stat = cols['log2FoldChange'][i], cols['lfcSE'][i], cols['stat'][i]
    assert lfc is not None, f'log2FoldChange is NA for {locus} in {path}'
    # cross-check column alignment: stat = log2FoldChange / lfcSE
    assert abs(stat - lfc / se) < 1e-6 * max(1.0, abs(stat)), (stat, lfc / se)
    return {'file': path, 'n_rows': len(rownames), 'locus_tag': locus,
            'index': i, 'baseMean': cols['baseMean'][i], 'log2FoldChange': lfc,
            'lfcSE': se, 'stat': stat, 'pvalue': cols['pvalue'][i],
            'padj': cols['padj'][i], 'rounded_2dp': round(lfc, 2)}

def main():
    # 1) map gene name -> locus tag via PGD reference (must be unique)
    hits = []
    with open('/workspace/data/Pseudomonas_aeruginosa_UCBPP-PA14.csv', newline='') as f:
        for r in csv.DictReader(f):
            if r['Gene Name'] == 'mexG' or 'mexG' in (r['Gene synonyns'] or ''):
                hits.append(r['Locus Tag'])
    assert hits == ['PA14_09540'], f'mexG mapping not unique: {hits}'
    print(f"mexG -> locus tag {hits[0]} (unique match in PGD reference CSV)")

    r97 = mexG_lfc('/workspace/data/res_1vs97.rds')
    r98 = mexG_lfc('/workspace/data/res_1vs98.rds')
    for r in (r97, r98):
        print(f"\n{r['file']}: rows={r['n_rows']}, {r['locus_tag']} at row index {r['index']}")
        print(f"  baseMean        = {r['baseMean']:.6g}")
        print(f"  log2FoldChange  = {r['log2FoldChange']!r}")
        print(f"  lfcSE           = {r['lfcSE']:.6g}")
        print(f"  stat            = {r['stat']:.6g}  (check: lfc/lfcSE OK)")
        print(f"  pvalue          = {r['pvalue']:.4g}")
        print(f"  padj            = {r['padj']:.4g}")
        print(f"  log2FC rounded to 2 dp = {r['rounded_2dp']}")

    print("\nANSWER: log2 fold change of mexG (PA14_09540) in ΔrhlI (strain #97) "
          f"vs WT (strain #1) = {r97['rounded_2dp']}")

if __name__ == '__main__':
    main()
