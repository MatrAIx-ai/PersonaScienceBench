#!/usr/bin/env python3
"""
BixBench bix-49-q4 - data preparation & diagnostics (executed part).

The full differential expression analysis requires DESeq2 lfcShrink(type='apeglm')
(R/Bioconductor). R is not available in this workspace (no R, no network egress,
no root, no docker daemon), so this script performs everything that can be
executed faithfully without R:
  - validate count table / coldata alignment,
  - apply the approved pre-filter (rowSums(counts) >= 10),
  - report design-relevant diagnostics,
and stages analysis/run_deseq2_apeglm.R implementing the approved DESeq2
workflow verbatim for execution in an R-provisioned runtime.
"""
import csv, json, sys

COUNTS = "data/Issy_ASXL1_blood_featureCounts_GeneTable_final.txt"
GENCODE = "data/gencode.v31.primary_assembly.genes.csv"

# ---------------------------------------------------------------- import counts
# NOTE: file is whitespace-delimited (multiple spaces), not tab-delimited.
with open(COUNTS) as f:
    lines = f.read().splitlines()
header = lines[0].split()
rows = [l.split() for l in lines[1:] if l.strip()]
assert all(len(r) == len(header) for r in rows), "ragged rows"
samples = header[1:]
counts = {r[0]: [int(v) for v in r[1:]] for r in rows}
print(f"[counts] {len(counts)} genes x {len(samples)} samples (whitespace-delimited)")
print(f"[counts] samples: {', '.join(samples)}")

libsize = {s: sum(counts[g][i] for g in counts) for i, s in enumerate(samples)}
print("[library sizes]")
for s in samples:
    print(f"  {s}\t{libsize[s]:,}")

# ---------------------------------------------------------------- import coldata
import openpyxl
wb = openpyxl.load_workbook("data/Issy_ASXL1_blood_coldata_gender.xlsx", read_only=True)
ws = wb["Sheet1"]
it = ws.iter_rows(values_only=True)
cd_hdr = list(next(it))
coldata = [dict(zip(cd_hdr, r)) for r in it if r[0] is not None]
print(f"[coldata] {len(coldata)} rows x {len(cd_hdr)} cols: {cd_hdr}")

cd_samples = [r["sample"] for r in coldata]
print(f"[alignment] coldata samples missing from counts : {set(cd_samples) - set(samples)}")
print(f"[alignment] count samples without coldata       : {sorted(set(samples) - set(cd_samples))}")

analysis_samples = [s for s in samples if s in set(cd_samples)]
cond = {r["sample"]: r["condition"] for r in coldata}
n_a = sum(1 for s in analysis_samples if cond[s] == "ASXL1")
n_c = sum(1 for s in analysis_samples if cond[s] == "Control")
print(f"[design] analysis set: {len(analysis_samples)} samples -> ASXL1 (disease) = {n_a}, Control (reference) = {n_c}")

# ---------------------------------------------------------------- pre-filter
keep = [g for g in counts if sum(counts[g]) >= 10]
print(f"[prefilter] rowSums(counts) >= 10 : retained {len(keep)} / {len(counts)} genes "
      f"(removed {len(counts) - len(keep)})")

# ---------------------------------------------------------------- gencode annotation check
gids = set()
with open(GENCODE) as f:
    rd = csv.DictReader(f)
    for row in rd:
        gids.add(row["gene_id"])
inter = gids & set(counts)
print(f"[annotation] gencode gene_ids matched to Geneid: {len(inter)}/{len(counts)}")

# ---------------------------------------------------------------- write subset for R
with open("analysis/counts_prefiltered.tsv", "w") as f:
    f.write("Geneid\t" + "\t".join(analysis_samples) + "\n")
    for g in keep:
        idx = [samples.index(s) for s in analysis_samples]
        f.write(g + "\t" + "\t".join(str(counts[g][i]) for i in idx) + "\n")
with open("analysis/coldata.tsv", "w") as f:
    f.write("sample\tcondition\tsex\n")
    for r in coldata:
        f.write(f'{r["sample"]}\t{r["condition"]}\t{r["sex"]}\n')
print("[written] analysis/counts_prefiltered.tsv (pre-filtered, 19 samples)")
print("[written] analysis/coldata.tsv (sample/condition/sex)")

summary = {
    "genes_total": len(counts),
    "genes_after_prefilter_rowSums_ge_10": len(keep),
    "samples_in_analysis": len(analysis_samples),
    "n_ASXL1": n_a, "n_Control": n_c,
    "samples_dropped_no_metadata": sorted(set(samples) - set(cd_samples)),
    "deseq2_apeglm_executed": False,
    "blocker": "R/Bioconductor unavailable in workspace; see analysis/provisioning_attempts.log",
}
with open("analysis/prep_diagnostics_summary.json", "w") as f:
    json.dump(summary, f, indent=2)
print(json.dumps(summary, indent=2))
