#!/usr/bin/env Rscript
# BixBench bix-49-q4 - approved DESeq2 + apeglm workflow (NOT YET EXECUTED:
# R unavailable in the workspace; staged for the runner-provided R runtime).
suppressPackageStartupMessages({library(DESeq2)})   # apeglm comes via lfcShrink

cts <- read.delim("analysis/counts_prefiltered.tsv", row.names = 1, check.names = FALSE)
coldata <- read.delim("analysis/coldata.tsv", stringsAsFactors = FALSE)
coldata$condition <- relevel(factor(coldata$condition), ref = "Control")
coldata$sex       <- factor(coldata$sex)
stopifnot(identical(colnames(cts), coldata$sample))

# Headline design: ~condition (sensitivity: ~condition + sex)
dds <- DESeqDataSetFromMatrix(cts, coldata, design = ~ condition)
dds <- DESeq(dds)
cat("resultsNames:", resultsNames(dds), "\n")

res <- results(dds, contrast = c("condition", "ASXL1", "Control"), alpha = 0.05)
resApe <- lfcShrink(dds, coef = "condition_ASXL1_vs_Control", res = res, type = "apeglm")

# attach gene symbols (gencode v31, versioned gene_id joins 1:1 to Geneid)
genc <- read.csv("data/gencode.v31.primary_assembly.genes.csv",
                 stringsAsFactors = FALSE, row.names = 1)
resApe$gene_name <- genc[rownames(resApe), "gene_name"]

padj <- resApe$padj; lfc <- resApe$log2FoldChange
sig <- !is.na(padj) & padj < 0.05
n_up   <- sum(sig & lfc > 0)
n_down <- sum(sig & lfc < 0)
cat(sprintf("n_up = %d, n_down = %d, TOTAL = %d\n", n_up, n_down, n_up + n_down))
cat("mcols(dds)$... dispersion summary:\n"); print(summary(mcols(dds)$dispersion))
cat("apeglm results summary:\n"); print(summary(resApe, alpha = 0.05))
write.csv(as.data.frame(resApe), "analysis/deseq2_apeglm_results.csv")

# sensitivity: ~condition + sex
dds2 <- DESeq(DESeqDataSetFromMatrix(cts, coldata, design = ~ condition + sex))
res2 <- results(dds2, contrast = c("condition", "ASXL1", "Control"), alpha = 0.05)
res2a <- lfcShrink(dds2, coef = "condition_ASXL1_vs_Control", res = res2, type = "apeglm")
s2 <- !is.na(res2a$padj) & res2a$padj < 0.05
cat(sprintf("SENSITIVITY ~condition+sex: n_up = %d, n_down = %d, TOTAL = %d\n",
            sum(s2 & res2a$log2FoldChange > 0), sum(s2 & res2a$log2FoldChange < 0),
            sum(s2)))
