#!/usr/bin/env python3
"""
bixbench:bix-5-q1 — Which GO biological process is most enriched in diseased vs control?

Executed pipeline (run as: python3 analysis.py 1  /  python3 analysis.py 2):
  Phase 1: load featureCounts matrix + coldata; exclude MGD1640F/MGD1641F (no metadata);
           DESeq2-style median-of-ratios size factors -> per-gene NB GLM (~condition + sex,
           Wald test, BH FDR) -> results/DE_results.tsv.
  Phase 2: Ensembl->gencode gene_name->HGNC symbol mapping; ORA universe; sensitivity design
           (~condition only); heuristic theme quantification; GO ORA blocker documentation;
           results/DE_significant_annotated.tsv, results/diagnostics.json.
Offline environment: no R, no DESeq2/edgeR/pydeseq2/gseapy/goatools, no network (verified below).
"""
import warnings, json, time, sys, os, glob, importlib.util
import numpy as np, pandas as pd
import statsmodels.api as sm
from scipy import stats
from statsmodels.stats.multitest import multipletests
warnings.filterwarnings('ignore')
t0 = time.time(); OUT = '/workspace/results'
phase = sys.argv[1] if len(sys.argv) > 1 else '1'

cts = pd.read_csv('data/Issy_ASXL1_fibro_featureCounts_GeneTable_final.txt', sep=r'\s+').set_index('Geneid')
cd  = pd.read_excel('data/Issy_ASXL1_fibro_coldata_gender.xlsx')
samples = list(cd['sample']); counts = cts[samples].astype(float)
cd = cd.set_index('sample').loc[samples]

def fit(design_cols, label):
    X = pd.DataFrame(sm.add_constant(design_cols, has_constant='add'), index=cd.index)
    X.columns = ['const'] + list(design_cols.columns)
    i = list(X.columns).index('cond')
    print(f'[design:{label}] rank {np.linalg.matrix_rank(X.values)}/{X.shape[1]} (estimable)', flush=True)
    res = {}
    idx = counts.index[counts.sum(axis=1) > 0]
    arr = counts.loc[idx].values
    for r, g in enumerate(idx):
        y = arr[r]
        try:
            m0 = sm.GLM(y, X, family=sm.families.Poisson(), offset=off).fit(); mu = m0.fittedvalues
            a  = max(((y-mu)**2 - mu).sum()/(mu**2).sum(), 1e-5)          # MoM dispersion
            m1 = sm.GLM(y, X, family=sm.families.NegativeBinomial(alpha=a), offset=off).fit()
            res[g] = (m1.params.iloc[i], m1.bse.iloc[i], a)
        except Exception:
            res[g] = (np.nan, np.nan, np.nan)
    d = pd.DataFrame(res, index=['beta','se','alpha']).T
    z = (d.beta/d.se).replace([np.inf,-np.inf], np.nan)
    d['log2FC'] = d.beta/np.log(2); d['z'] = z
    d['pvalue'] = 2*stats.norm.sf(z.abs())
    d['padj'] = multipletests(d['pvalue'].fillna(1), method='fdr_bh')[1]
    return d.sort_values('padj')

if phase == '1':
    # ---------- QC ----------
    print(f'[load] matrix {cts.shape}; analyzed {len(samples)} samples '
          f'(MGD1640F/MGD1641F excluded: no coldata metadata)', flush=True)
    print('[coldata] disease:', (cd.condition=='disease').sum(), 'control:', (cd.condition=='control').sum(),
          '| sex:', dict(cd.sex.value_counts()), flush=True)
    print('[QC] library sizes:', {s: int(v) for s, v in counts.sum(axis=0).items()}, flush=True)
    print('[QC] all-zero genes:', int((counts.sum(axis=1)==0).sum()),
          '| NaNs:', int(counts.isna().sum().sum()), '| raw counts, not normalized', flush=True)
    # ---------- size factors ----------
    pos = counts[(counts > 0).all(axis=1)]
    ref = np.exp(np.log(pos).mean(axis=1)).values
    sf  = (counts.loc[pos.index] / ref[:, None]).median(axis=0)
    sf  = sf / np.exp(np.mean(np.log(sf)))
    globals()['off'] = np.log(sf.values)
    print(f'[sizef] {len(pos)} all-positive genes used; size factors:',
          {s: round(float(v),4) for s, v in sf.items()}, flush=True)
    # ---------- NB GLM ~ condition + sex ----------
    d1 = fit(pd.DataFrame({'cond': (cd.condition=='disease').astype(int),
                           'male': (cd.sex=='M').astype(int)}, index=cd.index), 'cond+sex')
    print(f'[DE cond+sex] tested {len(d1)}; BH FDR<0.05: {int((d1.padj<0.05).sum())} '
          f'(alpha: median {d1.alpha.median():.4f}, IQR {d1.alpha.quantile(.25):.4f}-'
          f'{d1.alpha.quantile(.75):.4f})', flush=True)
    d1.to_csv(f'{OUT}/DE_results.tsv', sep='\t')
    print(f'[phase1 done] {time.time()-t0:.0f}s', flush=True)

else:
    # ---------- GO blocker: exhaustive offline provisioning check ----------
    GO_BLOCKER = {}
    try:
        urllib = __import__('urllib.request')
        urllib.request.urlopen('https://pypi.org/simple/', timeout=8); GO_BLOCKER['network'] = 'OK'
    except Exception as e: GO_BLOCKER['network'] = f'FAIL ({type(e).__name__})'
    GO_BLOCKER['packages'] = {m: bool(importlib.util.find_spec(m)) for m in
                              ['gseapy','goatools','mygene','pydeseq2','anndata']}
    GO_BLOCKER['annotation_files'] = glob.glob('/workspace/**/*.gmt') + glob.glob('/workspace/**/*.obo') + \
        glob.glob('/usr/share/*.gmt') + glob.glob('/usr/share/*.obo') + \
        glob.glob('/opt/*.gmt') + glob.glob('/opt/*.obo')
    print('[GO blocker check]', json.dumps(GO_BLOCKER), flush=True)

    d1 = pd.read_csv(f'{OUT}/DE_results.tsv', sep='\t', index_col=0)
    # ---------- mapping ----------
    g = pd.read_csv('data/gencode.v31.primary_assembly.genes.csv', low_memory=False)
    gmap = g.set_index('gene_id')['gene_name']; gn_counts = g['gene_name'].value_counts()
    h = pd.read_csv('data/HGNC_05-09-19.txt', sep='\t', low_memory=False)
    approved = set(h['Approved symbol'])
    d1['gene_name'] = gmap.reindex(d1.index).values
    d1['symbol'] = np.where(d1['gene_name'].isin(approved), d1['gene_name'], pd.NA)
    d1['ambiguous_symbol'] = d1['gene_name'].map(gn_counts) > 1
    nz = (counts > 0).sum(axis=1)
    uni_ids = [gid for gid in nz[nz >= 3].index]
    uni_syms = {n for n in (gmap[gid] for gid in uni_ids) if n in approved and gn_counts.get(n,0)==1}
    print(f'[universe] {len(uni_ids)} genes with >=3 nonzero samples -> {len(uni_syms)} unique HGNC symbols', flush=True)
    sig = d1[d1.padj < 0.05]
    sig2 = sig[(~sig.ambiguous_symbol) & sig.symbol.notna() & sig.symbol.isin(uni_syms)]
    sig2.to_csv(f'{OUT}/DE_significant_annotated.tsv', sep='\t')
    print(f'[DE sig annotated] {len(sig2)} genes (up {int((sig2.log2FC>0).sum())}, down {int((sig2.log2FC<0).sum())})', flush=True)
    print('[top 25 by padj]\n' + sig2.head(25)[['symbol','log2FC','pvalue','padj']].to_string(), flush=True)

    print('\n[GO BP ORA] NOT EXECUTED: no GO annotation resource available offline '
          '(network FAIL, no gseapy/goatools/org.Hs.eg.db, no .gmt/.obo annotation files in inputs or system). '
          'Most-defensible interpretation of the executed DE evidence is reported instead.', flush=True)

    # ---------- sensitivity: ~condition only ----------
    pos = counts[(counts > 0).all(axis=1)]
    ref = np.exp(np.log(pos).mean(axis=1)).values
    sf  = (counts.loc[pos.index] / ref[:, None]).median(axis=0)
    sf  = sf / np.exp(np.mean(np.log(sf)))
    globals()['off'] = np.log(sf.values)
    d2 = fit(pd.DataFrame({'cond': (cd.condition=='disease').astype(int)}, index=cd.index), 'cond-only')
    s1, s2 = set(d1.index[d1.padj<0.05]), set(d2.index[d2.padj<0.05])
    print(f'[sensitivity] ~cond-only: {len(s2)} sig; overlap with ~cond+sex: {len(s1 & s2)} '
          f'(Jaccard {len(s1 & s2)/len(s1 | s2):.2f})', flush=True)

    # ---------- heuristic theme quantification (keyword families, not GO) ----------
    themes = {'neuronal_dev/cell_adhesion': ['CNTN','SEMA','ROBO','LRFN','CLSTN','ADGRL','GRID','NEFH','STMN',
      'SCN','STXBP','CHRN','ANO2','EPS8','PDE8B','GUCY1A2','PIEZO2','IGDCC4','APBA2','CYFIP2','PPP1R9A',
      'GNAO1','RGS9','GRI','NCAM','NRCAM','LSAMP','PAX6','DPYSL','PCDH','NRXN','NLGN','SHANK','DLG','MYOZ'],
     'glycosylation/metabolism': ['GALN','UGT','GLYAT','LGALS','SLC','CYP','AKR','GST','ALDH','GAL'],
     'chromatin/TF': ['ZNF','KLF','FOX','SOX','BCL11A','PRDM','ZFHX','EBF','HOX','TBX','MEF2','HDAC','KDM'],
     'immune/interferon': ['HLA','IFIT','ISG','OAS','MX','CXCL','CCL','IL','TLR','CD200','SIRP','SOC','IFI','IRF']}
    sym = set(sig2.symbol.dropna())
    theme_counts = {}
    for t, kws in themes.items():
        hits = sorted(s for s in sym if any(k in s for k in kws))
        theme_counts[t] = {'n': len(hits), 'frac': round(len(hits)/len(sym), 3), 'genes': hits[:20]}
        print(f'[theme] {t}: {len(hits)}/{len(sym)} ({len(hits)/len(sym):.1%})', flush=True)
    json.dump({'go_blocker': GO_BLOCKER, 'size_factors': {s: float(v) for s, v in sf.items()},
               'n_tested': int(len(d1)), 'n_sig': int((d1.padj<0.05).sum()),
               'alpha_median': float(d1.alpha.median()), 'universe_size': int(len(uni_syms)),
               'n_sig_annotated': int(len(sig2)),
               'sensitivity_cond_only': {'n_sig': len(s2), 'overlap': len(s1 & s2)},
               'theme_counts': theme_counts, 'runtime_s': round(time.time()-t0, 1)},
              open(f'{OUT}/diagnostics.json','w'), indent=1)
    print(f'[phase2 done] {time.time()-t0:.0f}s', flush=True)
