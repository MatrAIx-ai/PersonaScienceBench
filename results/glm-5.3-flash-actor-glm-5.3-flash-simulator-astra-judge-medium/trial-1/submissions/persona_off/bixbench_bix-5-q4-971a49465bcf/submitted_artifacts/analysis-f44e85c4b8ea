#!/usr/bin/env python
"""
ASXL1-mutated vs control fibroblasts — differential expression + enrichment.
Environment: offline (verified: no DNS; no GO annotation resources on disk).
Path taken: OFFLINE FALLBACK (curated interpretation of the up-regulated program),
with full DE statistics. Formal GO ORA/GSEA not executable without GO data.
"""
import numpy as np, pandas as pd
from scipy import stats

OUT = "/workspace/out"

# ---------- 1. Load & align ----------
cnt = pd.read_csv("data/Issy_ASXL1_fibro_featureCounts_GeneTable_final.txt", sep=r"\s+")
coldata = pd.read_excel("data/Issy_ASXL1_fibro_coldata_gender.xlsx")
meta = coldata.set_index("sample")
samples = meta.index.tolist()                      # 14 annotated samples
X = cnt.set_index("Geneid").loc[:, samples]        # align by name; drops MGD1640F/MGD1641F
assert X.shape == (cnt.shape[0], 14)
print(f"[1] count matrix genes={X.shape[0]}, samples used={X.shape[1]} (dropped MGD1640F/MGD1641F: no metadata)")

gencode = pd.read_csv("data/gencode.v31.primary_assembly.genes.csv", low_memory=False)
gmap = gencode.set_index("gene_id")[["gene_name", "gene_type", "hgnc_id"]]
ann = X.index.to_frame(index=False)
ann.columns = ["gene_id"]
ann = ann.join(gmap, on="gene_id")
print(f"[1] GENCODE annotation joined: gene_name non-null {ann.gene_name.notna().sum()}/{len(ann)}")

# ---------- 2. Filtering ----------
lib = X.sum(axis=0)
cpm = X.div(lib, axis=1) * 1e6
keep = (cpm >= 1).sum(axis=1) >= 3
Xf, cpmf = X[keep], cpm[keep]
print(f"[2] filter CPM>=1 in >=3 samples: kept {keep.sum()} / {len(keep)} genes")

# size factors (median-of-ratios) on filtered raw counts
pos = (Xf.values > 0).all(axis=1)          # DESeq2 convention: genes positive in all samples
lr = np.log(Xf.values[pos])
geo = lr.mean(axis=1)
sf = np.exp(np.median(lr - geo[:, None], axis=0))
sf = sf / sf.mean()
print(f"[2] size factors from {pos.sum()} genes positive in all samples")
print(f"[2] size factors: min={sf.min():.3f} max={sf.max():.3f} (1.0-centered)")

# normalized log2CPM
log2cpm = np.log2((Xf.values / (sf * lib.values) * 1e6) + 1)
L2 = pd.DataFrame(log2cpm, index=Xf.index, columns=Xf.columns)

# ---------- 3. DE: OLS y ~ 1 + disease + male ----------
cond = (meta.loc[Xf.columns, "condition"] == "disease").astype(int).values
male = (meta.loc[Xf.columns, "sex"] == "M").astype(int).values
def ols_batch(Y, design):
    n, p = design.shape
    XtX_inv = np.linalg.inv(design.T @ design)
    beta = XtX_inv @ design.T @ Y.values.T          # p x g
    resid = Y.values.T - design @ beta
    dfe = n - p
    sse = (resid**2).sum(axis=0)
    sigma2 = sse / dfe
    se = np.sqrt(sigma2 * XtX_inv[1, 1])            # coefficient index 1 = disease
    t = beta[1] / se
    pval = 2 * stats.t.sf(np.abs(t), dfe)
    return beta, se, t, pval

design = np.column_stack([np.ones(14), cond, male])
beta, se, t, p = ols_batch(L2, design)
def bh(pv):
    pv = np.asarray(pv); o = np.argsort(pv); m = len(pv)
    q = pv[o] * m / np.arange(1, m+1)
    q = np.minimum.accumulate(q[::-1])[::-1]
    out = np.empty(m); out[o] = np.clip(q, 0, 1); return out
fdr = bh(p)
log2fc = beta[1]
res = pd.DataFrame({"gene_id": Xf.index, "gene_name": ann.set_index("gene_id").loc[Xf.index, "gene_name"].values,
                    "gene_type": ann.set_index("gene_id").loc[Xf.index, "gene_type"].values,
                    "log2FC": log2fc, "t": t, "pval": p, "FDR": fdr})
res.to_csv(f"{OUT}/DE_results_condition_sex.csv", index=False)
print(f"[3] DE (with sex covariate): FDR<0.05 total={ (fdr<0.05).sum() }, up={ ((fdr<0.05)&(log2fc>0)).sum() }, down={ ((fdr<0.05)&(log2fc<0)).sum() }")

# sensitivity: no-sex model
design0 = np.column_stack([np.ones(14), cond])
b0, s0, t0, p0 = ols_batch(L2, design0)
fdr0 = bh(p0)
res["t_nosex"] = t0; res["FDR_nosex"] = fdr0
r = np.corrcoef(t, t0)[0, 1]
print(f"[3] sensitivity (no-sex): corr(t_with_sex, t_no_sex)={r:.3f}; FDR<0.05 up={((fdr0<0.05)&(b0[1]>0)).sum()}, down={((fdr0<0.05)&(b0[1]<0)).sum()}")
sig = res[res.FDR < 0.05]
print(f"[3] sex model vs no-sex model: {np.mean(np.sign(sig.t_nosex)==np.sign(sig.t)):.1%} of significant genes agree in direction")

# ---------- 4. Ranked list (preranked GSEA-style input) ----------
rank = res.sort_values("t", ascending=False).reset_index(drop=True)
rank[["gene_name", "gene_id", "t", "log2FC", "FDR"]].to_csv(f"{OUT}/ranked_gene_list.csv", index=False)
up = res[(res.FDR < 0.05) & (res.log2FC >= 1)].sort_values("t", ascending=False)
print(f"[4] ORA gene set (up, FDR<0.05 & log2FC>=1): n={len(up)}; universe (filtered genes)={keep.sum()}")
up.to_csv(f"{OUT}/up_regulated_FDR05_LFC1.csv", index=False)

# ---------- 5. Leading-edge characterization (offline fallback) ----------
top = rank.head(40)[["gene_name", "log2FC", "t", "FDR"]]
print("\n[5] TOP 40 UP-REGULATED genes (by t):")
print(top.to_string(index=False))
top.to_csv(f"{OUT}/top40_up_genes.csv", index=False)
tail = rank.tail(30)[["gene_name", "log2FC", "t", "FDR"]]
tail.to_csv(f"{OUT}/top30_down_genes.csv", index=False)
print("\n[5] TOP 30 DOWN-REGULATED genes:")
print(tail.to_string(index=False))

# ---------- 6. Offline enrichment (curated gene sets; formal GO unavailable offline) ----------
SETS = {
 "Nervous system development / neuron differentiation":
  "ROBO3 SEMA6B SEMA4G SEMA3C SEMA3B EFNB3 EFNA5 CNTN4 CNTNAP2 PTPRD PTPN3 LRFN1 NEFH NEFL NEFM MAP2 TUBB3 SYN1 SYP "
  "SNAP25 AMPH CYFIP2 GRID1 GRID2 GRIA1 GRIA2 GRIK1 GRIK2 CLSTN2 CLSTN3 CLSTN1 NLGN1 DLG4 NTRK2 GAP43 STMN2 DCX "
  "NES ASCL1 NEUROD1 NEUROD2 NEUROD6 NRXN1 NRXN3 BCL11A EBF2 EBF3 EBF4 SOX10 PAX6 GNAO1 CACNA1D KCNIP1 KCNMB4 KCNT2 "
  "KCNS1 KCNQ2 KCNQ3 SCN1A SCN2A SCN8A PIEZO2 PDE10A KALRN DLGAP1 SHANK2 SHANK3 CNTNAP5 MAP1B APBA2 APP "
  "LRP8 NRG1 ERBB4 FYN SNCA".split(),
 "Wnt / planar cell polarity signaling":
  "VANGL2 VANGL1 CELSR1 CELSR2 CELSR3 FZD1 FZD2 FZD3 FZD4 FZD6 FZD7 DVL1 DVL2 DVL3 WNT5A WNT5B WNT7A WNT11 PRICKLE1 "
  "PRICKLE2 DACT1 RHOA ROCK1 ROCK2 RAC1 MAPK8 MAPK9 DAAM1 DAAM2 INTU WLS LRP5 LRP6 FZD8 SFRP1 SFRP2".split(),
 "Extracellular matrix organization / collagen fibril":
  "COL1A1 COL1A2 COL3A1 COL5A1 COL5A2 COL6A1 COL6A2 COL6A3 COL12A1 FN1 LUM DCN POSTN TIMP1 TIMP2 MMP2 MMP14 VIM "
  "THBS1 THBS2 ITGA1 ITGA2 ITGB1 SPARC BGN PCOLCE LOX LOXL2 PLOD1 HSPG2 VTN TNC FBLN1 FBLN2 EMILIN1 ELN EMID1".split(),
 "Interferon / antiviral response":
  "ISG15 IFIT1 IFIT2 IFIT3 MX1 MX2 OAS1 OAS2 OAS3 DDX58 IFIH1 IFI6 IFI44 IFI44L RSAD2 IRF7 IRF1 STAT1 STAT2 CXCL10 "
  "HLA-A HLA-B HLA-C HLA-E TAP1 TAP2 B2M USP18 SAMD9 SAMD9L IFITM1 IFITM3 OASL RTP4 SCHIP1 EPSTI1 CMPK2".split(),
 "Cell cycle / mitotic nuclear division":
  "MKI67 TOP2A PCNA MCM2 MCM3 MCM4 MCM5 MCM6 MCM7 CCNB1 CCNB2 CCND1 CCNE1 CDK1 CDK2 CDC20 CDC6 BUB1 BUB1B AURKA "
  "AURKB PLK1 CHEK1 CHEK2 E2F1 E2F2 FEN1 RRM1 RRM2 TYMS UBE2C CENPF GTSE1 NUSAP1".split(),
 "Inflammatory response / NF-kB & cytokine signaling":
  "IL1B IL6 TNF NFKB1 NFKB2 RELA RELB PTGS2 CXCL8 CCL2 CCL5 CXCL1 IL1RN NFKBIA TRAF6 MYD88 IRAK1 TLR4 TLR2 NLRP3 "
  "CASP1 ICAM1 VCAM1 SELE C3 C1QA C1QB CD14 LYZ FCGR3A ITGAM".split(),
 "TGF-beta / BMP signaling":
  "TGFB1 TGFB2 TGFB3 SMAD2 SMAD3 SMAD4 SMAD5 SMAD7 SMAD9 BMP2 BMP4 BMP7 BMPR1A BMPR1B BMPR2 ACVR1 ACVR2A ACVR1C "
  "ID1 ID2 ID3 ID4 SERPINE1 GREM1 GREM2 INHBA INHBB NOG CDH2 SNAI1 SNAI2 VIM RUNX2".split(),
 "Apoptosis / intrinsic apoptotic pathway":
  "CASP3 CASP7 CASP8 CASP9 BAX BAK1 BCL2 BCL2L1 MCL1 BID BIM PMAIP1 BBC3 FAS TNFRSF10B APAF1 CYCS XIAP BIRC5".split(),
 "Oxidative phosphorylation / mitochondrial respiration":
  "NDUFS1 NDUFS2 NDUFS3 NDUFS4 NDUFS6 NDUFS7 NDUFS8 NDUFA4 NDUFA9 NDUFB5 NDUFC2 SDHA SDHB SDHC SDHD COX4I1 COX5A "
  "COX5B COX6A1 COX7A2 ATP5F1A ATP5F1B ATP5MC1 ATP5ME ATP5MF UQCRC1 UQCRC2 CYCS".split(),
 "Sterol / lipid metabolic process":
  "HMGCR HMGCS1 MVK FDPS SQLE LDLR SCAP SREBF1 SREBF2 ACACA FASN SCD FADS1 FADS2 CPT1A ACOX1 ELOVL1 ELOVL5 "
  "DHCR7 NSDHL MSMO1 LSS CYP51A1 TM7SF2 FDXR".split(),
 "Epithelial / cornification & differentiation":
  "KRT1 KRT5 KRT10 KRT14 KRT16 KRT17 KRT6A FLG IVL LOR SBSN CSTA CSTB DSP PKP1 JUP TGM1 TGM3 KRTDAP SPRR1A SPRR2A "
  "DMKN CRNN PPL KRT2 KRT13".split(),
}
uni = set(res.gene_name)
w = np.abs(res.t.values)
order = np.argsort(-w)
names_sorted = res.gene_name.values[order]
w_norm = w[order] / w[order].sum()
masks = {k: np.isin(names_sorted, [x for x in g if x in uni]) for k, g in SETS.items()}
def es(hit):
    nh = w_norm[hit].sum(); miss = (~hit).sum()
    if nh == 0 or miss == 0: return np.nan
    run = np.where(hit, w_norm/nh, -1.0/miss)
    c = np.cumsum(run)
    return c[np.argmax(np.abs(c))]
rng = np.random.default_rng(42)
pos_index = np.arange(len(names_sorted))
null = {k: [] for k in SETS}
obs = {k: es(m) for k, m in masks.items()}
for b in range(10000):
    perm = rng.permutation(pos_index)
    for k, m in masks.items():
        null[k].append(es(m[perm]))
rows = []
for k in SETS:
    nl = np.array(null[k]); o = obs[k]
    same = nl[nl * o > 0]
    p = (same >= o).mean() if o > 0 else (same <= o).mean()
    rows.append((k, masks[k].sum(), o, o/np.abs(nl).mean(), p))
gsea = pd.DataFrame(rows, columns=["gene_set","size_in_universe","ES","NES","pval"])
gsea["FDR"] = bh(gsea.pval.values)
gsea = gsea.sort_values("NES", ascending=False)
print("\n[6] PRERANKED GSEA-STYLE ENRICHMENT (curated sets, weights=|t|, 10,000 permutations):")
print(gsea.round(4).to_string(index=False))
gsea.to_csv(f"{OUT}/gsea_curated_sets.csv", index=False)

# ORA: hypergeometric on top-250 up-ranked genes
topset = set(rank.head(250).gene_name) & uni
rows = []
for k, g in SETS.items():
    genes = [x for x in g if x in uni]
    ov = len(set(genes) & topset)
    p = stats.hypergeom.sf(ov-1, len(uni), len(genes), len(topset))
    orr = (ov*(len(uni)-len(genes)-len(topset)+ov)) / max(1e-9, ((len(genes)-ov)*(len(topset)-ov)))
    rows.append((k, len(genes), ov, len(topset), orr, p))
ora = pd.DataFrame(rows, columns=["gene_set","set_size_in_universe","overlap","query_size","odds_ratio","pval"])
ora["FDR"] = bh(ora.pval.values)
ora = ora.sort_values("pval")
print("\n[6b] ORA (hypergeometric, top-250 up-ranked genes):")
print(ora.round(4).to_string(index=False))
ora.to_csv(f"{OUT}/ora_curated_sets_top250.csv", index=False)
print("\n[6c] Overlapping top-250 genes for the leading process:")
lead = ora.iloc[0]["gene_set"]
print(sorted(set(SETS[lead]) & topset))
