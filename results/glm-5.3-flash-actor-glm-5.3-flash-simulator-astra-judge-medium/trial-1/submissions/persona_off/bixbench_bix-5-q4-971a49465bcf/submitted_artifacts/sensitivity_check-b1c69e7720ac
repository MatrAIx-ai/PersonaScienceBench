import numpy as np, pandas as pd
from scipy import stats
cnt = pd.read_csv("data/Issy_ASXL1_fibro_featureCounts_GeneTable_final.txt", sep=r"\s+")
meta = pd.read_excel("data/Issy_ASXL1_fibro_coldata_gender.xlsx").set_index("sample")
X = cnt.set_index("Geneid")[meta.index]
lib = X.sum(axis=0); cpm = X.div(lib,axis=1)*1e6
keep = (cpm>=1).sum(axis=1)>=3; Xf = X[keep]
pos = (Xf.values>0).all(axis=1); lr = np.log(Xf.values[pos])
sf = np.exp(np.median(lr - lr.mean(axis=1)[:,None], axis=0)); sf/=sf.mean()
log2cpm = np.log2((Xf.values/(sf*lib.values)*1e6)+1)
cond = (meta.loc[Xf.columns,"condition"]=="disease").astype(int).values
male = (meta.loc[Xf.columns,"sex"]=="M").astype(int).values
res = pd.read_csv("out/DE_results_condition_sex.csv", index_col="gene_id")
res = res.loc[Xf.index]
# no-sex t already computed in main script; recompute here for self-containedness
def ols(Y, d):
    XtXi = np.linalg.inv(d.T@d); b = XtXi@d.T@Y.T
    r = Y.T - d@b; s2 = (r**2).sum(0)/(len(d)-d.shape[1])
    se = np.sqrt(s2*XtXi[1,1]); return b[1]/se
t_nosex = ols(log2cpm, np.column_stack([np.ones(14), cond]))
NS = set("ROBO3 SEMA6B SEMA4G SEMA3C SEMA3B EFNB3 EFNA5 CNTN4 CNTNAP2 PTPRD PTPN3 LRFN1 NEFH NEFL NEFM MAP2 TUBB3 SYN1 SYP SNAP25 AMPH CYFIP2 GRID1 GRID2 GRIA1 GRIA2 GRIK1 GRIK2 CLSTN2 CLSTN3 CLSTN1 NLGN1 DLG4 NTRK2 GAP43 STMN2 DCX NES ASCL1 NEUROD1 NEUROD2 NEUROD6 NRXN1 NRXN3 BCL11A EBF2 EBF3 EBF4 SOX10 PAX6 GNAO1 CACNA1D KCNIP1 KCNMB4 KCNT2 KCNS1 KCNQ2 KCNQ3 SCN1A SCN2A SCN8A PIEZO2 PDE10A KALRN DLGAP1 SHANK2 SHANK3 CNTNAP5 MAP1B APBA2 APP LRP8 NRG1 ERBB4 FYN SNCA".split())
uni = set(res.gene_name)
for label, tv in [("with-sex t", res.t.values), ("no-sex t", t_nosex)]:
    o = np.argsort(-np.abs(tv)); names_sorted = res.gene_name.values[o]; w = np.abs(tv)[o]; w /= w.sum()
    hit = np.isin(names_sorted, [g for g in NS if g in uni])
    nh = w[hit].sum(); miss = (~hit).sum()
    c = np.cumsum(np.where(hit, w/nh, -1.0/miss)); es = c[np.argmax(np.abs(c))]
    # permutation p
    rng = np.random.default_rng(1); pi=np.arange(len(names_sorted)); cnt_=0
    for _ in range(5000):
        h = hit[rng.permutation(pi)]
        nh2=w[h].sum(); c2=np.cumsum(np.where(h,w/nh2,-1.0/((~h).sum()))); e2=c2[np.argmax(np.abs(c2))]
        cnt_ += (e2>=es) if es>0 else (e2<=es)
    print(f"[sens:{label}] Nervous-system-set ES={es:.3f}, perm p={cnt_/5000:.4f}")
for N in [100, 200, 250, 500]:
    top = set(res["gene_name"].values[np.argsort(-res.t.values)[:N]])
    ov = len(NS & top)
    p = stats.hypergeom.sf(ov-1, len(uni), len([g for g in NS if g in uni]), N)
    print(f"[sens ORA top-{N}] overlap={ov}, p={p:.2e}")
