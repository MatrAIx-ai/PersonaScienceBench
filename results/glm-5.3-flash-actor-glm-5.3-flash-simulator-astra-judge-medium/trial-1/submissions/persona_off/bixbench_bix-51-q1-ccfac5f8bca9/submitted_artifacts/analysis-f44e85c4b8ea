"""
BixBench bix-51-q1: Predicted probability of achieving efficacy PR with treatment
at Age = 65, using a univariable logistic regression (Age as only predictor).

Data: data/data.xlsx (Sheet1). Rows 81-121 are fully blank and dropped.
Outcome: PR = 1 if Efficacy == 'PR', else 0 (SD and PD both counted as non-PR).
Cohort: all 80 patients (Groups perfectly partitions Efficacy; Group 1 = all PR,
Group 2 = SD/PD only). Interpreting "treatment" as Group 1 only would make the
Age-only model degenerate (constant outcome), so the full treated cohort is used.
"""
import numpy as np
import pandas as pd
import statsmodels.api as sm
import statsmodels.formula.api as smf

# 1) Load and clean
df = pd.read_excel("data/data.xlsx", sheet_name="Sheet1")
df = df.replace(r"^\s*$", np.nan, regex=True)  # whitespace-only cells -> NaN
df = df.dropna(how="all").copy()          # drop fully blank rows -> 80 patients
df["Age"] = pd.to_numeric(df["Age"].astype(str).str.strip(), errors="coerce")
assert df.shape[0] == 80, df.shape
assert df["Age"].notna().all(), "unexpected missing Age among patients"
assert df["Groups"].notna().all() and df["Efficacy"].notna().all()

# 2) Verify Groups-Efficacy concordance
tab = pd.crosstab(df["Groups"], df["Efficacy"])
print("Groups x Efficacy table:\n", tab)
assert (df.loc[df.Groups == 1, "Efficacy"] == "PR").all()
assert (df.loc[df.Groups == 2, "Efficacy"].isin(["SD", "PD"])).all()

df["PR"] = (df["Efficacy"] == "PR").astype(int)
print("\nPR counts:", df["PR"].value_counts().to_dict())

# 3) Univariable logistic regression PR ~ Age
fit = smf.logit("PR ~ Age", data=df).fit(disp=0)
print(fit.summary())
b1, se1 = fit.params["Age"], fit.bse["Age"]
or_ = np.exp(b1)
or_ci = np.exp([b1 - 1.96 * se1, b1 + 1.96 * se1])
print(f"\nAge log-OR = {b1:.4f} (SE {se1:.4f}), OR = {or_:.4f}, "
      f"95% CI ({or_ci[0]:.4f}, {or_ci[1]:.4f}), p = {fit.pvalues['Age']:.2e}")

# 4) Predicted probability at Age = 65 with 95% CI (delta method)
X = pd.DataFrame({"Intercept": 1.0, "Age": 65.0}, index=[0])
cov = fit.cov_params()
eta = float((X.values @ fit.params.values)[0])
se_eta = float(np.sqrt((X.values @ cov.values @ X.values.T)[0, 0]))
p = 1 / (1 + np.exp(-eta))
ci = 1 / (1 + np.exp(-(np.array([eta - 1.96 * se_eta, eta + 1.96 * se_eta]))))
print(f"\nPredicted P(PR | Age=65) = {p:.4f} ({p*100:.1f}%)")
print(f"95% CI (delta method): ({ci[0]:.4f}, {ci[1]:.4f}) "
      f"= ({ci[0]*100:.1f}%, {ci[1]*100:.1f}%)")

# sanity: observed PR rate near age 65
near = df[(df.Age >= 60) & (df.Age <= 70)]
print(f"\nObserved PR rate, ages 60-70 (n={len(near)}): {near['PR'].mean():.3f}")
