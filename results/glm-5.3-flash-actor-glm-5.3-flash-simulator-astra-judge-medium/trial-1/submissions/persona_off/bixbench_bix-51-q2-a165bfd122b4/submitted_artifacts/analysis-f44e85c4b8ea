"""
BixBench bix-51-q2: AIC of logistic regression of treatment response (efficacy PR)
on BMI (sole predictor).

Data: data/data.xlsx, Sheet1 (80 real patients after dropping 41 blank artifact rows).
Outcome: response = 1 if Efficacy == 'PR', else 0 (SD/PD).  Predictor: BMI (continuous).
Model: statsmodels Logit, ML fit, k = 2 (intercept + BMI).  AIC = -2*LL + 2*k.
"""
import numpy as np
import pandas as pd
import statsmodels.api as sm

# 1) Load and clean
df = pd.read_excel("data/data.xlsx", sheet_name="Sheet1")
raw_rows = len(df)
df = df.dropna(how="all")                      # drop fully blank artifact rows
df = df[df["Efficacy"].notna()]                # drop the one residual NaN row
assert len(df) == 80, f"expected 80 patients, got {len(df)}"

# 2) Binary outcome and predictor
df["response"] = (df["Efficacy"].str.strip() == "PR").astype(int)
print("Efficacy counts:", df["Efficacy"].value_counts().to_dict())
print("Response counts (1=PR, 0=SD/PD):", df["response"].value_counts().to_dict())
assert df[["response", "BMI"]].notna().all().all(), "unexpected missing values"
n = len(df)

# 3) Fit logistic regression
X = sm.add_constant(df["BMI"].astype(float))
model = sm.Logit(df["response"].values, X.values)
res = model.fit(disp=0)

# 4) AIC
k = 2
aic_reported = res.aic
aic_manual = -2 * res.llf + 2 * k
print(f"\nn used            : {n}")
print(f"events (PR=1)     : {int(df['response'].sum())}")
print(f"log-likelihood    : {res.llf:.6f}")
print(f"k (params)        : {k}")
print(f"AIC (statsmodels) : {aic_reported:.6f}")
print(f"AIC (manual)      : {aic_manual:.6f}")
print(f"McFadden pseudo-R2: {res.prsquared:.4f}")
print(f"LLR p-value       : {res.llr_pvalue:.4f}")

# 5) Coefficient table
params = pd.DataFrame({
    "coef": res.params, "SE": res.bse, "z": res.tvalues, "p": res.pvalues,
    "CI2.5": res.conf_int()[:, 0], "CI97.5": res.conf_int()[:, 1],
}, index=["Intercept", "BMI"])
print("\nCoefficient table:")
print(params.to_string(float_format=lambda v: f"{v:.6f}"))

# sanity: sklearn-style cross-check via scipy-free manual likelihood
beta = res.params
p = 1 / (1 + np.exp(-(beta[0] + beta[1] * df["BMI"].values)))
ll = np.sum(df["response"].values * np.log(p) + (1 - df["response"].values) * np.log(1 - p))
print(f"\nmanual LL check   : {ll:.6f}  (matches statsmodels: {np.isclose(ll, res.llf)})")
print(f"FINAL AIC         : {aic_manual:.2f}")
