# BixBench bix-51-q3: Combined logistic regression - p-value for Age predicting treatment response (PR)
import pandas as pd
import numpy as np
import statsmodels.formula.api as smf

df = pd.read_excel('data/data.xlsx', sheet_name='Sheet1')
df = df.dropna(how='all')                      # drop empty padding rows
df = df[df['Efficacy'].notna()]                # analytic cohort: 80 patients
df['Age'] = pd.to_numeric(df['Age'], errors='coerce')

# Primary outcome: PR = 1, non-PR (PD/SD) = 0
df['efficacy_bin'] = (df['Efficacy'] == 'PR').astype(int)
print("n =", len(df), "| events (PR) =", df['efficacy_bin'].sum())

# Primary model: efficacy_bin ~ BMI + Age + Gender
model = smf.logit('efficacy_bin ~ BMI + Age + C(Gender)', data=df)
res = model.fit(disp=False)
print("\nConverged:", res.mle_retvals.get('converged'))
print("\n=== PRIMARY MODEL: PR vs non-PR (PD+SD) ===")
tbl = res.summary2().tables[1]
tbl['OR'] = np.exp(tbl['Coef.'])
print(tbl[['Coef.','Std.Err.','z','P>|z|','OR']].to_string())
print("\nAge p-value (primary): %.6f" % tbl.loc['Age','P>|z|'])

# Sensitivity: PR vs PD only (exclude SD)
sens = df[df['Efficacy'] != 'SD'].copy()
print("\n=== SENSITIVITY: PR vs PD only (n=%d, events=%d) ===" % (len(sens), sens['efficacy_bin'].sum()))
res2 = smf.logit('efficacy_bin ~ BMI + Age + C(Gender)', data=sens).fit(disp=False)
t2 = res2.summary2().tables[1]; t2['OR'] = np.exp(t2['Coef.'])
print(t2[['Coef.','Std.Err.','z','P>|z|','OR']].to_string())
print("\nAge p-value (sensitivity): %.6f" % t2.loc['Age','P>|z|'])
