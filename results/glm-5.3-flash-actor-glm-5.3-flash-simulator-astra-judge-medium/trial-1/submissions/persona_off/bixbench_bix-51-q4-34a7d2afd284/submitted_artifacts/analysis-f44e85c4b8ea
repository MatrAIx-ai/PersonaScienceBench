"""Logistic regression: remission ~ Age + BMI + Gender (BixBench bix-51-q4)."""
import numpy as np
import pandas as pd
import statsmodels.api as sm

df = pd.read_excel('data/data.xlsx', sheet_name='Sheet1')

# 1) Restrict to substantive rows (drop 41 padding rows incl. row-120 Age artifact)
d = df.dropna(subset=['Efficacy']).copy()
print(f"Substantive rows: {len(d)} (dropped {len(df)-len(d)} padding rows)")
d['Age'] = pd.to_numeric(d['Age'], errors='coerce')
assert d[['Age','BMI','Efficacy','Gender']].notna().all().all(), "Unexpected missing data"

# 2) Outcome and predictors
d['remission'] = (d['Efficacy'] == 'PR').astype(int)          # primary: PR vs SD+PD
d['female'] = (d['Gender'] == 'Female').astype(int)           # Female=1, Male=0
X = sm.add_constant(d[['Age','BMI','female']].astype(float))
y = d['remission']

def fit_model(y, X, label):
    m = sm.Logit(y, X).fit(disp=0, maxiter=200)
    print(f"\n===== {label} =====")
    print("converged:", m.mle_retvals['converged'], "| llf:", round(m.llf,3),
          "| n:", int(m.nobs))
    # separation check: fitted probabilities near 0/1 or nonfinite params
    p = m.predict()
    print("max fitted prob: %.3f | min fitted prob: %.3f" % (p.max(), p.min()))
    tab = pd.DataFrame({'coef': m.params, 'OR': np.exp(m.params),
                        'CI2.5': np.exp(m.conf_int()[0]),
                        'CI97.5': np.exp(m.conf_int()[1]),
                        'p': m.pvalues}).round(4)
    print(tab.to_string())
    a = m.params['Age']
    print(f"\n>> Age log-odds per +1 year: {a:.4f} (95% CI {m.conf_int().loc['Age',0]:.4f} to {m.conf_int().loc['Age',1]:.4f}; p={m.pvalues['Age']:.4f}); OR={np.exp(a):.4f}")
    return m, a

m1, a1 = fit_model(y, X, "PRIMARY: remission = PR (1) vs SD/PD (0)")

# 5) Sensitivity: PR+SD vs PD
d['remission2'] = d['Efficacy'].isin(['PR','SD']).astype(int)
m2, a2 = fit_model(d['remission2'], X, "SENSITIVITY: remission = PR+SD (1) vs PD (0)")

print(f"\nSummary: primary Age log-odds/yr = {a1:.4f}; sensitivity = {a2:.4f}; difference = {a2-a1:.4f}")
print("\nEfficacy outcome counts:", d['Efficacy'].value_counts().to_dict())
