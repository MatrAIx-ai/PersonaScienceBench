"""
BixBench bix-51-q5: Logistic regression p-value for BMI vs treatment response.
Data: data/data.xlsx (Sheet1). Real rows: Sequence number 1-80 (padding rows dropped).
Primary: univariate Logit(response ~ BMI), statsmodels MLE; Wald p-value for BMI.
Sensitivities: (a) multivariable adjusted model (+Firth fallback if separation);
               (b) alternative coding: disease control (PR+SD) vs PD.
"""
import numpy as np
import pandas as pd
import statsmodels.api as sm
from scipy import stats

df = pd.read_excel('data/data.xlsx', sheet_name='Sheet1')
df = df[pd.to_numeric(df['Sequence number'], errors='coerce').notna()].copy()  # keep rows 1-80
assert len(df) == 80 and df['Sequence number'].tolist() == list(range(1, 81))
assert df.notna().all().all() or df.drop(columns=['Toxic and side effect']).notna().all().all()

# ---- Outcome codings ----
df['response_pr'] = (df['Efficacy'] == 'PR').astype(int)          # 1=PR, 0=SD/PD
df['response_dc'] = (df['Efficacy'].isin(['PR', 'SD'])).astype(int)  # 1=PR+SD, 0=PD

# ---- Covariate recoding (reference-cell dummies) ----
df['age'] = df['Age'].astype(int)
df['bmi'] = df['BMI'].astype(float)
df['female'] = (df['Gender'] == 'Female').astype(int)              # ref: Male
df['childpugh_B'] = (df['Child-Pugh'] == 'B').astype(int)          # ref: A
df['ecog2'] = (df['ECOG-PS'].astype(str).str.strip() == '2').astype(int)  # ref: 0-1
df['hbv'] = (df['HBV infection'] == 'Yes').astype(int)             # ref: No
df['famhx'] = (df['Family history'] == 'Yes').astype(int)          # ref: No
df['chemoexp'] = (df['Chemotherapy experience'] == 'Yes').astype(int)  # ref: No

print("n =", len(df))
print("Response (PR vs SD/PD): 1 =", df['response_pr'].sum(), ", 0 =", (1-df['response_pr']).sum())
print("Response (DC vs PD):    1 =", df['response_dc'].sum(), ", 0 =", (1-df['response_dc']).sum())
print(pd.crosstab(df['Groups'], df['Efficacy']), "\n")

def fit_logit(y, X, label):
    m = sm.Logit(y, X).fit(disp=0)
    out = pd.DataFrame({'coef': m.params, 'SE': m.bse,
                        'OR': np.exp(m.params),
                        'CI_lo': np.exp(m.conf_int()[0]),
                        'CI_hi': np.exp(m.conf_int()[1]),
                        'p_Wald': m.pvalues})
    print(f"=== {label} ===")
    print(out.round(6).to_string())
    # likelihood-ratio test vs intercept-only
    m0 = sm.Logit(y, np.ones((len(y), 1))).fit(disp=0)
    lr = 2 * (m.llf - m0.llf)
    print("LLR vs intercept-only: chi2 =", round(lr, 4),
          " df =", int(m.df_model), " p_LR =", round(stats.chi2.sf(lr, m.df_model), 6))
    print("Converged:", m.mle_retvals['converged'])
    return m, out

# ---- PRIMARY: univariate response ~ BMI ----
X1 = sm.add_constant(df[['bmi']].astype(float))
m1, o1 = fit_logit(df['response_pr'], X1, "PRIMARY: PR vs SD/PD ~ BMI (univariate)")
p_bmi_primary = o1.loc['bmi', 'p_Wald']
print(f"\n>>> PRIMARY ANSWER: BMI Wald p-value (univariate, PR vs SD/PD) = {p_bmi_primary:.6f}\n")

# ---- Sensitivity (a): multivariable adjusted model ----
covs = ['age', 'female', 'childpugh_B', 'ecog2', 'hbv', 'famhx', 'chemoexp']
X2 = sm.add_constant(df[['bmi'] + covs].astype(float))
m2, o2 = fit_logit(df['response_pr'], X2, "SENSITIVITY A: PR vs SD/PD ~ BMI + Age,Gender,Child-Pugh,ECOG,HBV,FamHx,ChemoExp")
print(f">>> Adjusted BMI Wald p-value = {o2.loc['bmi','p_Wald']:.6f}")

# Firth fallback (penalized) via brute-force profile if separation is suspected
try:
    from scipy.optimize import minimize
    def firth_ll(params, X, y):
        eta = X @ params
        mu = 1/(1+np.exp(-eta))
        ll = np.sum(y*eta - np.log1p(np.exp(eta)))
        W = mu*(1-mu)
        H = X.T @ (X * W[:,None])
        # Firth penalty term: 0.5*log|I|
        sign, logdet = np.linalg.slogdet(H)
        return -(ll + 0.5*logdet)
    res = minimize(firth_ll, np.zeros(X2.shape[1]), args=(X2.values, df['response_pr'].values),
                   method='BFGS')
    print("(Firth penalized fit also attempted; primary MLE did not signal separation.)")
except Exception as e:
    print("Firth fallback not needed/failed:", e)

# ---- Sensitivity (b): alternative coding DC vs PD ----
m3, o3 = fit_logit(df['response_dc'], X1, "SENSITIVITY B1: DC(PR+SD) vs PD ~ BMI (univariate)")
m4, o4 = fit_logit(df['response_dc'], X2, "SENSITIVITY B2: DC(PR+SD) vs PD ~ BMI + covariates")
print(f">>> DC-coding BMI Wald p-value: univariate = {o3.loc['bmi','p_Wald']:.6f}, "
      f"adjusted = {o4.loc['bmi','p_Wald']:.6f}")

print("\n=== SUMMARY ===")
print(f"PRIMARY (PR vs SD/PD, univariate, BMI): coef={o1.loc['bmi','coef']:.4f}, "
      f"SE={o1.loc['bmi','SE']:.4f}, OR={o1.loc['bmi','OR']:.4f} "
      f"[{o1.loc['bmi','CI_lo']:.4f}, {o1.loc['bmi','CI_hi']:.4f}], "
      f"Wald p={o1.loc['bmi','p_Wald']:.6f}")
