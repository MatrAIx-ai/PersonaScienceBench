"""
BixBench bix-51-q8: Simple logistic regression — Age vs camrelizumab treatment response.

Question: In a simple logistic regression model assessing age and camrelizumab
treatment response, what is the coefficient estimate (change in log-odds) for age?

Data: data/data.xlsx, Sheet1. Rows 0-79 are the 80 real patient records; rows 80-119
are entirely empty and row 120 contains only a blank Age string (padding artifacts),
so these 41 trailing rows are excluded from the analysis.
"""
import pandas as pd
import numpy as np
import statsmodels.api as sm

# ---------------------------------------------------------------- load & clean
df = pd.read_excel('data/data.xlsx', sheet_name='Sheet1')
print(f"Raw sheet shape: {df.shape}")

patient = df.iloc[:80].copy()          # keep only the 80 real patient rows
pad = df.iloc[80:]
print(f"Excluded padding rows: {len(pad)} "
      f"({pad.drop(columns='Toxic and side effect').isna().all(axis=1).sum()} fully empty; "
      f"1 trailing row with only a blank Age string)")
assert patient['Age'].notna().all(), "Unexpected missing Age among patient rows"

patient['age'] = pd.to_numeric(patient['Age'], errors='raise').astype(float)

# Primary outcome: camrelizumab treatment response (PR = responder vs PD/SD = non-responder)
patient['response'] = (patient['Efficacy'] == 'PR').astype(int)

# Sanity check: perfect Group <-> Efficacy alignment
ct = pd.crosstab(patient['Groups'], patient['Efficacy'])
print("\nGroup x Efficacy crosstab (perfect alignment expected):")
print(ct.to_string())
assert (patient.loc[patient['Groups'] == 1, 'Efficacy'] == 'PR').all()
assert (patient.loc[patient['Groups'] == 2, 'Efficacy'] != 'PR').all()

# ------------------------------------------------------- primary model: Logit
X = sm.add_constant(patient['age'].values)
y = patient['response'].values

model = sm.Logit(y, X).fit(disp=0)
print(f"\nPrimary model: response ~ age   (statsmodels Logit, converged={model.mle_retvals['converged']})")
print(model.summary())

b   = model.params[1]
se  = model.bse[1]
z   = b / se
p   = model.pvalues[1]
lo, hi = model.conf_int()[1]
print(f"\nPRIMARY RESULT  (n={int(model.nobs)}, responders={int(y.sum())})")
print(f"  age coefficient (log-odds per year): {b:.4f}")
print(f"  SE = {se:.4f}, z = {z:.3f}, p = {p:.4g}")
print(f"  95% CI: [{lo:.4f}, {hi:.4f}]")
print(f"  OR per year = {np.exp(b):.4f}  (95% CI {np.exp(lo):.4f}-{np.exp(hi):.4f})")

# Equivalence check: same coefficient using Groups (1 vs 2) as the outcome
y_grp = (patient['Groups'] == 1).astype(int).values
m_grp = sm.Logit(y_grp, X).fit(disp=0)
print(f"\nEquivalence check, outcome = Groups (1 vs 2): age coef = {m_grp.params[1]:.4f} "
      f"(identical to primary: {np.isclose(m_grp.params[1], b)})")

# ----------------------------------- secondary sensitivity: PR/SD vs PD coding
y_alt = (patient['Efficacy'] != 'PD').astype(int).values
m_alt = sm.Logit(y_alt, X).fit(disp=0)
print(f"\nSECONDARY sensitivity check, coding PR/SD=1 vs PD=0 (n={int(m_alt.nobs)}, cases={int(y_alt.sum())}):")
print(f"  age coefficient = {m_alt.params[1]:.4f}, SE = {m_alt.bse[1]:.4f}, "
      f"p = {m_alt.pvalues[1]:.4g}, OR = {np.exp(m_alt.params[1]):.4f}")
print("\nNote: this alternative coding is NOT the primary answer; PR vs PD/SD is primary.")

print(f"\nFINAL ANSWER: age coefficient (change in log-odds per year) = {b:.4f}")
