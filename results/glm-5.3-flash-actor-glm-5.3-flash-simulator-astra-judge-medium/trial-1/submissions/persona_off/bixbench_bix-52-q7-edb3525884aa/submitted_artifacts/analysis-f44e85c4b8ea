"""
BixBench episode bixbench:bix-52-q7
Question: How many sites are removed when filtering sites that do not show
          >90% or <10% methylation in Zebra Finch?

Approved approach (researcher-approved):
- Input: data/ZF_AgeRelated_CpG_noMT_Final.csv (Zebra Finch, sample-site rows).
- A "site" is one row of the CSV (a CpG site observed in one sample), since each
  row carries exactly one MethylationPercentage value.
- Filter: keep rows with MethylationPercentage > 90 OR < 10.
  Remove rows NOT satisfying that condition, i.e. methylation in the closed
  band [10%, 90%] (boundary values exactly 10% or 90% are removed, per the
  strict wording ">90% or <10%").
- Primary answer: number of rows (sample-site rows) removed.
- Sensitivity note: unique-site (Pos) variants are reported for transparency.
- JD data and chromosome-length files are not used for this question.
"""
import pandas as pd

INPUT = "data/ZF_AgeRelated_CpG_noMT_Final.csv"

zf = pd.read_csv(INPUT)

total_rows = len(zf)
n_unique_sites = zf["Pos"].nunique()
m = zf["MethylationPercentage"]

# Sanity checks on scale and structure
assert m.min() >= 0 and m.max() <= 100, "MethylationPercentage expected on 0-100 percent scale"
assert zf["MethylationPercentage"].notna().all()

# --- Primary filter (row-level) ---
kept_mask = (m > 90) | (m < 10)
kept_rows = int(kept_mask.sum())
removed_rows = total_rows - kept_rows

kept_over90 = int((m > 90).sum())
kept_under10 = int((m < 10).sum())
boundary_90 = int((m == 90).sum())
boundary_10 = int((m == 10).sum())

# --- Sensitivity: unique genomic sites (Pos) ---
per_site = zf.groupby("Pos")["MethylationPercentage"]
site_min, site_max, site_mean = per_site.min(), per_site.max(), per_site.mean()

# Variant A: a site "shows" >90% or <10% methylation if ANY of its sample rows
#            does. A site is removed only if NO sample row is extreme, i.e.
#            every row of the site falls in the band [10, 90]
#            (equivalently: site min >= 10 AND site max <= 90).
sites_removed_no_extreme_row = int(((site_min >= 10) & (site_max <= 90)).sum())

# Variant B (degenerate): site kept if its aggregate (mean) methylation is
#            >90% or <10%; removed otherwise
sites_removed_mean = int(((site_mean >= 10) & (site_mean <= 90)).sum())

print("=" * 70)
print("Zebra Finch (ZF_AgeRelated_CpG_noMT_Final.csv)")
print("=" * 70)
print(f"Total sample-site rows:                {total_rows}")
print(f"Unique genomic sites (Pos):            {n_unique_sites}")
print(f"Methylation scale: percent (0-100), min={m.min()}, max={m.max()}")
print("-" * 70)
print("PRIMARY (row-level filter, band [10%, 90%] removed):")
print(f"  Rows kept  (>90% or <10%):           {kept_rows}")
print(f"    - rows >90%:                       {kept_over90}")
print(f"    - rows <10%:                       {kept_under10}")
print(f"    - boundary rows exactly 90%:       {boundary_90} (removed)")
print(f"    - boundary rows exactly 10%:       {boundary_10} (removed)")
print(f"  PRIMARY ANSWER - rows removed:       {removed_rows}")
print("-" * 70)
print("SENSITIVITY (unique-site variants, transparency only):")
print(f"  Unique sites total:                  {n_unique_sites}")
print(f"  Removed if NO sample row is extreme: {sites_removed_no_extreme_row} "
      f"(kept {n_unique_sites - sites_removed_no_extreme_row})")
print(f"  Removed if mean methylation in band: {sites_removed_mean} "
      f"(kept {n_unique_sites - sites_removed_mean}) [degenerate]")
print("=" * 70)
print(f"ANSWER: {removed_rows} sites (sample-site rows) are removed when "
      f"filtering Zebra Finch sites that do not show >90% or <10% methylation.")
