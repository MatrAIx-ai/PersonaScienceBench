"""
bixbench:bix-53-q3 -- Step 1: Differential expression, KL (KD) vs WL (control).

Self-implemented DESeq2-equivalent pipeline (pydeseq2/DESeq2 are not installable in
this offline sandbox; see plan_notes.md):
  * median-of-ratios size factors (DESeq2)
  * per-gene NB2 GLM, log link, design ~ 1 + condition(KL=1/WL=0)
  * gene-wise dispersion by profile-likelihood MLE (log-spaced alpha grid +
    vectorised parabolic refinement; beta refit by IRLS at each alpha)
  * parametric dispersion trend alpha(mu) = a1/mu + a0 (DESeq2-style), gene
    dispersions pulled up to the trend when the MLE is below it
  * Wald test (z = lfc/se) -> raw p-value
  * LFC shrinkage: normal-prior MAP, lfc_shrunk = lfc * s2/(s2+se^2), with the
    prior variance s2 estimated by an empirical-Bayes moment estimator
    (median of lfc^2 - se^2 over baseMean>10 genes) -- DESeq2 'normal' shrink analogue
Filters: p<0.05 (raw Wald p), |lfcShrunk|>1, baseMean>10
"""
import numpy as np, pandas as pd
from scipy import special, stats
import statsmodels.stats.multitest as mt

df = pd.read_csv('/workspace/data/count.csv', index_col=0)
group = np.array([1, 1, 1, 0, 0, 0], float)   # 1 = KL (KD, numerator), 0 = WL (control)
Y = df.values.astype(float)
G, n = Y.shape
print(f"genes={G}, samples={n} (KL1-3 = KD, WL1-3 = control)")

# ---------- size factors (median-of-ratios, DESeq2) ----------
loggeo = np.log(np.where(Y > 0, Y, 1.0)).mean(axis=1)
pos = np.all(Y > 0, axis=1)
sf = np.exp(np.median(np.log(Y[pos] / np.exp(loggeo[pos])[:, None]), axis=0))
sf = sf / np.exp(np.mean(np.log(sf)))
print("size factors:", np.round(sf, 5).tolist())
NF = Y / sf[None, :]
baseMean_all = NF.mean(axis=1)

idx = np.where(baseMean_all > 0)[0]           # DESeq2 drops all-zero rows
y = Y[idx] / sf[None, :]
bm = baseMean_all[idx]
print("genes fit:", len(idx))

def irls_vec(y, alpha, beta=None, iters=30):
    """Vectorised NB2-GLM IRLS across all genes (design [1, KL])."""
    if beta is None:
        beta = np.zeros((y.shape[0], 2))
        beta[:, 0] = np.log(np.maximum(y.mean(1), 0.5))
    for _ in range(iters):
        eta = beta[:, 0:1] + beta[:, 1:2] * group[None, :]
        mu = np.exp(eta)
        W = mu / (1.0 + alpha[:, None] * mu)
        z = eta + (y - mu) / mu
        S00 = W.sum(1); S01 = (W * group).sum(1); S11 = (W * group * group).sum(1)
        T0 = (W * z).sum(1); T1 = (W * group * z).sum(1)
        det = S00 * S11 - S01 ** 2
        det = np.where(np.abs(det) < 1e-12, 1e-12, det)
        beta = np.column_stack([
            np.clip((S11 * T0 - S01 * T1) / det, -30, 30),
            np.clip((S00 * T1 - S01 * T0) / det, -30, 30)])
    mu = np.exp(beta[:, 0:1] + beta[:, 1:2] * group[None, :])
    return beta, mu

def loglik(y, mu, alpha):
    r = (1.0 / alpha)[:, None]
    return (special.gammaln(y + r) - special.gammaln(r) - special.gammaln(y + 1)
            + r * np.log(r) - r * np.log(r + mu) + y * np.log(mu) - y * np.log(r + mu)).sum(1)

# ---------- gene-wise dispersion: profile MLE on log-alpha grid + parabolic refine ----------
grid = 10.0 ** np.linspace(-3, 1, 17)         # alpha in [1e-3, 10]
LL = np.empty((len(idx), len(grid)))
beta = np.zeros((len(idx), 2))
beta[:, 0] = np.log(np.maximum(y.mean(1), 0.5))
for k, a in enumerate(grid):
    beta, mu = irls_vec(y, np.full(len(idx), a), beta=beta, iters=12)
    LL[:, k] = loglik(y, mu, np.full(len(idx), a))
kmax = LL.argmax(1)
klo = np.clip(kmax - 1, 0, len(grid) - 1)
khi = np.clip(kmax + 1, 0, len(grid) - 1)
x = np.log(grid)
def parab(x0, x1, x2, y0, y1, y2):
    d = (x0 - x1) * (x0 - x2) * (x1 - x2)
    A = (x2 * (y1 - y0) + x1 * (y0 - y2) + x0 * (y2 - y1)) / d
    B = (x2**2 * (y0 - y1) + x1**2 * (y2 - y0) + x0**2 * (y1 - y2)) / d
    return np.where(A < 0, -B / (2 * A), x1)
xv = parab(x[klo], x[kmax], x[khi], LL[np.arange(len(idx)), klo],
           LL[np.arange(len(idx)), kmax], LL[np.arange(len(idx)), khi])
alpha_mle = np.exp(np.clip(xv, x[0], x[-1]))
# one refinement pass around the vertex
step = np.log(grid[1] / grid[0])
for sg in (-1, 0, 1):
    a2 = np.exp(np.clip(xv + sg * step / 2, x[0], x[-1]))
    b2, mu2 = irls_vec(y, a2, beta=beta, iters=12)
    ll2 = loglik(y, mu2, a2)
    upd = ll2 > LL[np.arange(len(idx)), kmax]
    alpha_mle = np.where(upd, a2, alpha_mle)
    beta = np.where(upd[:, None], b2, beta)
alpha_mle = np.clip(alpha_mle, 1e-3, 10.0)
print("dispersion MLE: median=%.4f mean=%.4f  (# at lower bound: %d, at upper: %d)" % (
    np.median(alpha_mle), alpha_mle.mean(), (alpha_mle <= 1e-3 + 1e-12).sum(), (alpha_mle >= 10 - 1e-9).sum()))

# ---------- parametric dispersion trend + DESeq2-style shrinkage ----------
big = bm > 10
xx = 1.0 / bm[big]; aa = alpha_mle[big]
keep = np.ones(len(xx), bool); coef = np.array([0.0, np.median(aa)])
for _ in range(3):
    A = np.column_stack([xx[keep], np.ones(keep.sum())])
    coef, *_ = np.linalg.lstsq(A, aa[keep], rcond=None)
    resid = aa - (coef[0] * xx + coef[1])
    s = np.median(np.abs(resid - np.median(resid))) * 1.4826 + 1e-9
    keep = np.abs(resid - np.median(resid)) < 3 * s
a1, a0 = max(coef[0], 0.0), max(coef[1], 1e-4)
print(f"dispersion trend: alpha = {a1:.4f}/mu + {a0:.5f}")
alpha_trend = np.clip(a1 / np.maximum(bm, 1e-8) + a0, 1e-4, 10.0)
alpha_final = np.maximum(alpha_mle, alpha_trend)

# ---------- final GLM + Wald test ----------
beta, mu = irls_vec(y, alpha_final, beta=beta, iters=50)
eta = beta[:, 0:1] + beta[:, 1:2] * group[None, :]
W = mu / (1.0 + alpha_final[:, None] * mu)
S00 = W.sum(1); S01 = (W * group).sum(1); S11 = (W * group * group).sum(1)
det = S00 * S11 - S01 ** 2
se_b1 = np.sqrt(S00 / np.where(np.abs(det) < 1e-12, 1e-12, det))
lfc = beta[:, 1]
z = lfc / se_b1
pval = 2 * stats.norm.sf(np.abs(z))

# ---------- LFC shrinkage (normal-prior MAP; DESeq2 'normal' analogue) ----------
hi = bm > 10
sig2 = float(np.median(np.maximum(lfc[hi] ** 2 - se_b1[hi] ** 2, 0.0)))
if sig2 <= 1e-6:
    sig2 = float(np.mean(np.maximum(lfc[hi] ** 2 - se_b1[hi] ** 2, 0.0)))
lfc_shrunk = lfc * sig2 / (sig2 + se_b1 ** 2)
print(f"shrinkage prior variance sigma^2 = {sig2:.4f} (sigma = {np.sqrt(sig2):.3f})")

res = pd.DataFrame({'geneID': df.index[idx], 'baseMean': bm, 'lfc': lfc,
                    'lfcShrunk': lfc_shrunk, 'se': se_b1, 'stat': z, 'pvalue': pval,
                    'alpha_MLE': alpha_mle, 'alpha_final': alpha_final})
res['padj_BH'] = mt.multipletests(pval, method='fdr_bh')[1]
sig = res[(res.pvalue < 0.05) & (np.abs(res.lfcShrunk) > 1) & (res.baseMean > 10)]
print(f"\nTOTAL significant DGEs (p<0.05, |lfcShrunk|>1, baseMean>10): {len(sig)}")
print(f"  up: {(sig.lfcShrunk > 1).sum()}, down: {(sig.lfcShrunk < -1).sum()}")
print(f"  raw p<0.05 (all tests): {(res.pvalue < 0.05).sum()}; padj<0.05: {(res.padj_BH < 0.05).sum()}")
print("\nTop 15 significant by |shrunk LFC|:")
print(sig.reindex(sig.lfcShrunk.abs().sort_values(ascending=False).index)
      [['geneID', 'baseMean', 'lfc', 'lfcShrunk', 'pvalue']].head(15).to_string(index=False))
res.to_csv('/workspace/analysis/deseq_results.csv', index=False)
sig.to_csv('/workspace/analysis/sig_genes.csv', index=False)
print("\nSaved: analysis/deseq_results.csv, analysis/sig_genes.csv")
