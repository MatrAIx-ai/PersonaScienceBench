#!/usr/bin/env python3
"""
DESeq2-equivalent differential expression pipeline (pure Python/numpy fallback).
Data: UBE2M knockdown (KL1-3) vs wild-type control (WL1-3), mouse RNA-seq counts.
Implements: median-of-ratios size factors, NB GLM (log-link, ~condition),
gene-wise MLE dispersion + robust parametric trend fit + empirical-Bayes squeeze,
Wald test, apeglm-style Cauchy-prior MAP log2FC shrinkage, BH adjustment.
"""
import numpy as np, pandas as pd
from scipy.special import gammaln, ndtr
from scipy.optimize import minimize

df = pd.read_csv('data/count.csv')
genes = df['geneID'].values
Y = df.iloc[:, 1:].values.astype(np.float64)          # genes x 6
samples = list(df.columns[1:])
cond = np.array([1., 1., 1., 0., 0., 0.])             # 1 = KL (KD), 0 = WL (WT)
X = np.column_stack([np.ones(6), cond])               # design ~ condition
n, p = 6, 2
LOG2 = np.log(2.0)

# ---------- size factors (median-of-ratios) ----------
loggeo = np.log(Y).mean(axis=1)
nz = np.all(Y > 0, axis=1)
ref = np.exp(loggeo[nz])
sf = np.median(Y[nz] / ref[:, None], axis=0)
sf = sf / sf.mean()
norm = Y / sf
baseMean = norm.mean(axis=1)
print("size factors:", np.round(sf, 4), flush=True)

def nb_llik(Y, mu, alpha):
    r = (1.0 / alpha)[..., None] if np.ndim(alpha) else 1.0 / alpha
    r = np.broadcast_to(r, Y.shape)
    return (gammaln(r + Y) - gammaln(r) - gammaln(Y + 1)
            + r * np.log(r / (r + mu)) + Y * np.log(mu / (r + mu)))

def irls(Y, X, alpha, beta0, maxit=60, tol=1e-8):
    G = Y.shape[0]
    beta = beta0.copy()
    mu = np.exp(beta[:, :1] + beta[:, 1:] * X[None, :, 1])
    for it in range(maxit):
        W = mu / (1.0 + alpha[:, None] * mu)
        z = np.log(mu) + (Y - mu) / mu
        A11 = W.sum(1); A12 = (W * cond).sum(1); A22 = (W * cond ** 2).sum(1)
        b1 = (W * z).sum(1); b2 = (W * z * cond).sum(1)
        det = A11 * A22 - A12 * A12
        det = np.where(np.abs(det) < 1e-300, 1e-300, det)
        new = np.column_stack([(A22 * b1 - A12 * b2) / det,
                               (A11 * b2 - A12 * b1) / det])
        new = np.clip(new, -30, 30)
        mu_new = np.exp(new[:, :1] + new[:, 1:] * X[None, :, 1])
        if np.max(np.abs(new - beta)) < tol:
            beta, mu = new, mu_new
            break
        beta, mu = new, mu_new
    return beta, mu

# ---------- gene-wise dispersion MLE ----------
fit_mask = baseMean > 0
Yf, bmf = Y[fit_mask], baseMean[fit_mask]
G = Yf.shape[0]
beta_start = np.column_stack([np.log(bmf), np.zeros(G)])

def profile_llik(loga):
    a = np.exp(loga)
    b, mu = irls(Yf, X, a, beta_start.copy(), maxit=15)
    return nb_llik(Yf, mu, a).sum(1)

lo, hi = np.full(G, -12.0), np.full(G, 6.0)
flo = profile_llik(lo)
for _ in range(60):
    mid = 0.5 * (lo + hi)
    fm = profile_llik(mid)
    go_right = flo < fm
    lo = np.where(go_right, mid, lo); flo = np.where(go_right, fm, flo)
    hi = np.where(go_right, hi, mid)
alpha_mle = np.exp(0.5 * (lo + hi))
print("dispersion MLE done. median alpha:", np.median(alpha_mle), flush=True)

# ---------- robust parametric trend: alpha = a1/mu + a0 ----------
m, a = bmf, alpha_mle
w = m > 5
mm, aa = m[w], a[w]
a1, a0 = 1.0, max(np.median(aa), 1e-6)
for _ in range(50):
    d = aa - (a1 / mm + a0)
    s = max(np.median(np.abs(d - np.median(d))) * 1.4826, 1e-3)
    wt = np.minimum(1.0, 1.345 * s / np.maximum(np.abs(d), 1e-12))
    A = np.column_stack([1 / mm, np.ones_like(mm)])
    AW = A * wt[:, None]
    sol, *_ = np.linalg.lstsq(AW.T @ A, AW.T @ aa, rcond=None)
    a1n, a0n = sol
    a1n = max(a1n, 1e-12); a0n = max(a0n, 1e-8)
    if abs(a1n - a1) < 1e-6 * a1 and abs(a0n - a0) < 1e-6 * a0:
        a1, a0 = a1n, a0n; break
    a1, a0 = a1n, a0n
print(f"trend fit: alpha = {a1:.3f}/mu + {a0:.5f}", flush=True)
alpha_trend = np.clip(a1 / np.maximum(m, 1e-8) + a0, 1e-8, 100)

# ---------- EB squeeze toward trend (edgeR-style, prior.df = 10) ----------
prior_df = 10.0
pn = prior_df / (n - p)
inv = pn / (pn + 1) / alpha_trend + 1 / (pn + 1) / np.maximum(alpha_mle, 1e-8)
alpha_final = 1.0 / inv
print("final dispersion median:", np.median(alpha_final), flush=True)

# ---------- final GLM fit -> Wald test ----------
beta_f, mu_f = irls(Yf, X, alpha_final, beta_start.copy(), maxit=60)
W = mu_f / (1.0 + alpha_final[:, None] * mu_f)
A11 = W.sum(1); A12 = (W * cond).sum(1); A22 = (W * cond ** 2).sum(1)
det = np.where(np.abs(A11 * A22 - A12 * A12) < 1e-300, 1e-300, A11 * A22 - A12 * A12)
lfcSE = np.sqrt(A11 / det)
beta1 = beta_f[:, 1]
stat = beta1 / lfcSE
pval = 2.0 * ndtr(-np.abs(stat))

res = pd.DataFrame({'geneID': genes[fit_mask], 'baseMean': bmf,
                    'log2FC_MLE': beta1 / LOG2, 'lfcSE': lfcSE / LOG2,
                    'stat': stat, 'pvalue': pval, 'dispersion': alpha_final})

# ---------- apeglm-style Cauchy MAP shrinkage ----------
prior_scale = 1.0   # apeglm default: Cauchy(0, s=1) on natural-log LFC scale
from scipy.optimize import brentq
b0v = beta_f[:, 0]
def dpost(b0, alpha, y, b):
    mu = np.clip(np.exp(b0 + b * cond), 1e-300, 1e300)
    ww = mu / (1 + alpha * mu)
    return (ww * (y - mu)).sum() - 2 * b / (prior_scale**2 + b**2)
def map_shrink(b0, alpha, y):
    lo, hi = -12.0, 12.0
    f_lo = dpost(b0, alpha, y, lo); f_hi = dpost(b0, alpha, y, hi)
    if f_lo * f_hi < 0:
        return brentq(lambda b: dpost(b0, alpha, y, b), lo, hi, xtol=1e-8)
    # no interior root: pick endpoint with higher posterior
    def negpost(b):
        mu = np.clip(np.exp(b0 + b * cond), 1e-300, 1e300)
        return -(nb_llik(y, mu, alpha).sum()
                 - np.log(np.pi * prior_scale * (1 + (b / prior_scale) ** 2)))
    return lo if negpost(lo) <= negpost(hi) else hi

bm_hi = bmf > 10
shrunk = np.full(G, np.nan)
for i in np.where(bm_hi)[0]:
    shrunk[i] = map_shrink(b0v[i], alpha_final[i], Yf[i])
res['log2FC_shrunk'] = shrunk / LOG2
print("shrinkage done", flush=True)

# ---------- BH ----------
o = np.argsort(pval); mt = fit_mask.sum()
padj = np.full(G, np.nan)
q = pval[o] * mt / (np.arange(mt) + 1)
q = np.minimum.accumulate(q[::-1])[::-1]
padj[o] = np.clip(q, 0, 1)
res['padj'] = padj

res.to_csv('analysis/de_results.csv', index=False)
print("tested genes:", mt)
for lbl, msk in [("p<0.05 & |lfcShrunk|>1 & baseMean>10",
                  (res.pvalue < .05) & (res.log2FC_shrunk.abs() > 1) & (res.baseMean > 10)),
                 ("padj<0.05 variant",
                  (res.padj < .05) & (res.log2FC_shrunk.abs() > 1) & (res.baseMean > 10)),
                 ("p<0.05 & |lfcMLE|>1 & baseMean>10",
                  (res.pvalue < .05) & (res.log2FC_MLE.abs() > 1) & (res.baseMean > 10))]:
    sub = res[msk]
    up = (sub.log2FC_shrunk > 0).sum()
    print(f"{lbl}: n={len(sub)} (KD-up {up}, KD-down {len(sub)-up})")
print(res.sort_values('pvalue').head(15).round(4).to_string())

# ---------- diagnostics & DE list ----------
print("\n--- diagnostics ---")
import numpy as np
pv = res.pvalue.dropna().values
print("p<0.05:", (pv<.05).sum(), " p<0.01:", (pv<.01).sum(),
      " p in [0.05,0.1):", ((pv>=.05)&(pv<.1)).sum(), " p>0.5:", (pv>0.5).mean().round(3))
sub = res[(res.pvalue < 0.05) & (res.log2FC_shrunk.abs() > 1) & (res.baseMean > 10)].copy()
sub = sub.sort_values(['pvalue', 'baseMean'], ascending=[True, False])
sub.to_csv('analysis/DE_genes_significant.csv', index=False)
print("significant DE list saved:", len(sub), "genes -> analysis/DE_genes_significant.csv")
print("shrunk-LFC summary of DE genes:\n", sub.log2FC_shrunk.describe().round(3))
res2 = res.sort_values('stat', ascending=False)
res2['rank_stat'] = np.arange(1, len(res2)+1)
res2[['geneID','baseMean','log2FC_MLE','lfcSE','stat','pvalue','padj','log2FC_shrunk']] \
    .to_csv('analysis/ranked_all_genes.csv', index=False)
print("full ranked table saved: analysis/ranked_all_genes.csv")
