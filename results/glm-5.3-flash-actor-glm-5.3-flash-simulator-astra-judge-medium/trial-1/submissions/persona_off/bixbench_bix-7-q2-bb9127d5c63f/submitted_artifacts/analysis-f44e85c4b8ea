"""
CHIP variants per sample (BixBench bix-7-q2)
Question: average number of CHIP variants per sample after filtering out
intronic, intergenic, and UTR variants.

Data: data/CHIP_DP10_GQ20_PASS/*.xlsx (86 per-sample workbooks)
Decisions confirmed by researcher:
 - Keep only rows with a real alternate genotype call (Zygosity in
   {Heterozygous, Homozygous Variant}); exclude 'Reference' and blank (no-call) rows.
 - Primary SO exclusion set: intron_variant, 3_prime_UTR_variant,
   5_prime_UTR_variant, 5_prime_UTR_premature_start_codon_gain_variant,
   upstream_gene_variant (intergenic-adjacent).
 - splice_region_variant KEPT in primary (distinct SO term, not literally intronic);
   sensitivity reported with it excluded.
 - No re-application of the 56-gene list (In_CHIP=True governs); no trio stratification.
 - Primary counting unit: unique variants keyed by (Chr:Pos, Ref/Alt) per sample;
   row counts reported as secondary check.
 - Sensitivity: mean with vs. without the 380-P / 381-PM no-call anomaly samples.
"""
import glob, os, re
import pandas as pd

DATA = "/workspace/data/CHIP_DP10_GQ20_PASS"

EXCLUDE_PRIMARY = {
    "intron_variant",
    "3_prime_UTR_variant",
    "5_prime_UTR_variant",
    "5_prime_UTR_premature_start_codon_gain_variant",
    "upstream_gene_variant",
}
EXCLUDE_SENS_SPLICE = EXCLUDE_PRIMARY | {"splice_region_variant"}

files = sorted(glob.glob(os.path.join(DATA, "*.xlsx")))
print(f"Number of sample workbooks: {len(files)}")

per_sample = []
step_totals = {"total_rows": 0, "reference_rows": 0, "no_call_rows": 0,
               "excluded_by_SO_primary": 0, "excluded_by_SO_no_splice": 0,
               "dup_rows_collapsed": 0}

for f in files:
    sample = re.sub(r"^230209_Exome_GRCh38_CHIP_", "", os.path.basename(f)).replace(".xlsx", "")
    df = pd.read_excel(f, header=1)

    n_total = len(df)
    n_ref = int((df["Zygosity"] == "Reference").sum())
    n_nocall = int(df["Zygosity"].isna().sum())
    called = df[df["Zygosity"].isin(["Heterozygous", "Homozygous Variant"])].copy()

    n_alt_rows = len(called)
    n_unique_var = called.duplicated(subset=["Chr:Pos", "Ref/Alt"]).sum()
    step_totals["dup_rows_collapsed"] += int(n_unique_var)
    called_u = called.drop_duplicates(subset=["Chr:Pos", "Ref/Alt"])

    so = called_u["Sequence Ontology (Combined)"]
    kept_primary = called_u[~so.isin(EXCLUDE_PRIMARY)]
    kept_nosplice = called_u[~so.isin(EXCLUDE_SENS_SPLICE)]

    step_totals["total_rows"] += n_total
    step_totals["reference_rows"] += n_ref
    step_totals["no_call_rows"] += n_nocall
    step_totals["excluded_by_SO_primary"] += int(len(called_u) - len(kept_primary))
    step_totals["excluded_by_SO_no_splice"] += int(len(called_u) - len(kept_nosplice))

    per_sample.append({
        "sample": sample,
        "rows_total": n_total,
        "rows_reference": n_ref,
        "rows_nocall": n_nocall,
        "rows_alt_called": n_alt_rows,
        "unique_alt_variants": len(called_u),
        "kept_primary": len(kept_primary),
        "kept_no_splice": len(kept_nosplice),
        "kept_primary_rows": int((~called["Sequence Ontology (Combined)"].isin(EXCLUDE_PRIMARY)).sum()),
    })

res = pd.DataFrame(per_sample)
print("\n--- Per-sample table (first 10 / last 5) ---")
print(res.head(10).to_string(index=False))
print("...")
print(res.tail(5).to_string(index=False))

print("\n--- Pipeline step totals (pooled over 86 files) ---")
print(f"Total rows read:                        {step_totals['total_rows']}")
print(f"Reference-zygosity rows (excluded):     {step_totals['reference_rows']}")
print(f"Blank/no-call zygosity rows (excluded): {step_totals['no_call_rows']}")
print(f"Alternate-called rows:                  "
      f"{step_totals['total_rows'] - step_totals['reference_rows'] - step_totals['no_call_rows']}")
print(f"Duplicate (Chr:Pos,Ref/Alt) rows collapsed: {step_totals['dup_rows_collapsed']}")
print(f"Rows excluded by SO filter (primary):   {step_totals['excluded_by_SO_primary']}")
print(f"Rows excluded by SO filter (also splice): {step_totals['excluded_by_SO_no_splice']}")

kept = res["kept_primary"]
print("\n--- PRIMARY RESULT ---")
print(f"Unique CHIP variants per sample after filtering intronic/intergenic/UTR:")
print(f"  mean   = {kept.mean():.2f}")
print(f"  median = {kept.median():.1f}")
print(f"  min/max = {kept.min()} / {kept.max()}")
print(f"  SD     = {kept.std():.2f}")

print("\n--- Sensitivity analyses ---")
print(f"(a) Excluding splice_region_variant too: mean = {res['kept_no_splice'].mean():.2f}")
print(f"(b) Row-count (not unique-variant) basis: mean = {res['kept_primary_rows'].mean():.2f}")
anom = res[res["sample"].isin(["380-P", "381-PM"])]
print(f"(c) Anomalous samples 380-P/381-PM kept_primary: "
      f"{anom.set_index('sample')['kept_primary'].to_dict()}")
wo = res[~res["sample"].isin(["380-P", "381-PM"])]["kept_primary"]
print(f"    mean without 380-P/381-PM (n={len(wo)}): {wo.mean():.2f}  "
      f"vs with all 86: {kept.mean():.2f}")

res.to_csv("/workspace/analysis/per_sample_chip_variant_counts.csv", index=False)
print("\nPer-sample table written to analysis/per_sample_chip_variant_counts.csv")

# quick breakdown of what the kept variants are (pooled, unique-variant basis)
import collections
c = collections.Counter()
for f in files:
    df = pd.read_excel(f, header=1)
    called = df[df["Zygosity"].isin(["Heterozygous", "Homozygous Variant"])]
    called = called.drop_duplicates(subset=["Chr:Pos", "Ref/Alt"])
    c.update(called.loc[~called["Sequence Ontology (Combined)"].isin(EXCLUDE_PRIMARY),
                        "Sequence Ontology (Combined)"].value_counts().to_dict())
print("\nPooled composition of kept variants (primary definition):")
for k, v in c.most_common():
    print(f"  {k}: {v}")
