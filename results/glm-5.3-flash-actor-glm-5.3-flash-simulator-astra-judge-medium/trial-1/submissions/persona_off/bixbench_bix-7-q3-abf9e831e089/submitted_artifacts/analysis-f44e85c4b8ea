#!/usr/bin/env python3
"""
Count distinct CHIP variants remaining after removing reference calls.

Inputs:
  data/CHIP_DP10_GQ20_PASS/*.xlsx   -- 86 per-sample variant workbooks (GRCh38 exome,
                                       DP>=10/GQ>=20/PASS pre-filter), 2 header rows,
                                       33 columns; col 1 'Chr:Pos', col 2 'Ref/Alt',
                                       col 5 'Zygosity' ('Reference'/'Heterozygous'/
                                       'Homozygous Variant'/blank), col 13 'Gene Names'.
  data/230214_Schenz_et_al_2022_CHIP_Genes.xlsx -- 56 CHIP gene symbols (no header).

Rule (primary): key = (Chr:Pos, Ref/Alt). A key is removed as a reference call if it is
only ever genotyped 'Reference'. Blank zygosity = no-call (excluded, not counted as
reference). A variant REMAINS if it is called Heterozygous or Homozygous Variant in at
least one sample. Count = distinct remaining keys.
"""
import glob, os, json
from collections import Counter, defaultdict
import openpyxl

DATA = "data/CHIP_DP10_GQ20_PASS"
GENES_FILE = "data/230214_Schenz_et_al_2022_CHIP_Genes.xlsx"

# --- CHIP gene list (single column, no header) ---
ws = openpyxl.load_workbook(GENES_FILE).active
CHIP_GENES = {str(r[0]).strip() for r in ws.iter_rows(values_only=True) if r[0]}
print(f"CHIP gene list: {len(CHIP_GENES)} genes")

# --- Load all workbooks ---
ALT = {"Heterozygous", "Homozygous Variant"}
key_state = defaultdict(set)          # (chrpos, ref/alt) -> set of zygosity states seen
gene_map = {}                          # key -> gene names (from first file seen)
n_files, n_rows = 0, 0
zyg_counter = Counter()

for path in sorted(glob.glob(os.path.join(DATA, "*.xlsx"))):
    ws = openpyxl.load_workbook(path).active          # non-read-only: merged header safe
    rows = list(ws.iter_rows(values_only=True))
    n_files += 1
    for r in rows[2:]:                                # skip 2 header rows
        n_rows += 1
        z = r[4]
        state = z if z in ("Reference", *ALT) else "BLANK"
        zyg_counter[state] += 1
        k = (str(r[0]).strip(), str(r[1]).strip())
        key_state[k].add(state)
        if k not in gene_map and r[12]:
            gene_map[k] = str(r[12])

print(f"Files loaded: {n_files}; variant rows (excl. headers): {n_rows}")
print("Zygosity row counts:", dict(zyg_counter))

keys = set(key_state)
alt_keys   = {k for k, s in key_state.items() if s & ALT}
never_alt  = {k for k, s in key_state.items() if not (s & ALT)}          # Reference and/or blank only
ref_only   = {k for k, s in key_state.items() if s == {"Reference"}}
alt_positions = {p for p, _ in alt_keys}

# per-sample alt-call rows
alt_rows = sum(zyg_counter[s] for s in ALT)

# --- Sensitivity: strict 56-gene-list membership ---
def genes_of(g):
    return {t.strip() for t in g.split(",")} if g else set()
strict_keys = {k for k in alt_keys if genes_of(gene_map.get(k, "")) & CHIP_GENES}

results = {
    "files": n_files,
    "variant_rows_total": n_rows,
    "zygosity_rows": dict(zyg_counter),
    "distinct_keys_total_before_removal": len(keys),
    "distinct_positions_total": len({p for p, _ in keys}),
    "primary_distinct_chip_variants_after_removing_reference_calls": len(alt_keys),
    "primary_distinct_positions_alt_called": len(alt_positions),
    "keys_never_alt_called": len(never_alt),
    "keys_only_ever_reference": len(ref_only),
    "per_sample_alt_call_rows": alt_rows,
    "sensitivity_strict_56gene_list_distinct_alt_keys": len(strict_keys),
}

print(json.dumps(results, indent=2))

# gene breakdown of retained variants (top 15)
gb = Counter(next(iter(genes_of(gene_map.get(k,""))), "?") for k in alt_keys)
print("Top genes among retained variants:", gb.most_common(15))

with open("out/chip_variant_counts.json", "w") as fh:
    json.dump(results, fh, indent=2)
