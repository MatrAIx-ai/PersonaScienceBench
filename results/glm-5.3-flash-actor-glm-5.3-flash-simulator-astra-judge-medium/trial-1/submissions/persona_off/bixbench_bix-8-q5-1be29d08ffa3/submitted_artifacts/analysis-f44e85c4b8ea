"""Independence test: m6A methylation status vs differential expression status
Bladder cancer MeRIP-seq/RNA-seq results (data/MeRIP_RNA_result.xlsx, "Date Formatting").
Primary: transcript-level 2x2 chi-square with Yates correction.
Sensitivity: Fisher's exact, 3x3 chi-square, gene-level aggregated 2x2.
"""
import pandas as pd
import numpy as np
from scipy.stats import chi2_contingency, fisher_exact

df = pd.read_excel("data/MeRIP_RNA_result.xlsx", sheet_name="Date Formatting")
print(f"Rows: {len(df)}, unique transcripts: {df.GeneID.nunique()}, unique genes: {df.gene_id.nunique()}")

# Binary collapse of pre-computed status flags
m6a_sig = df["m6A"].isin(["m6A Hyper", "m6A Hypo"])   # significant m6A methylation
deg     = df["DEG"].isin(["Up", "Down"])              # differentially expressed

table2x2 = pd.crosstab(m6a_sig, deg)                  # rows: m6A sig? cols: DEG?
print("\nPrimary 2x2 contingency table (rows: m6A sig [Hyper|Hypo] vs no-sig; cols: DEG [Up|Down] vs no-DEGs):")
print(table2x2)

# 1) Primary: Pearson chi-square with Yates continuity correction
chi2, p_yates, dof, expected = chi2_contingency(table2x2, correction=True)
print(f"\nPRIMARY - 2x2 chi-square (Yates correction): chi2={chi2:.4f}, dof={dof}, p={p_yates:.6e}")
print("Expected counts:", np.round(expected, 2))

# 2) Sensitivity: Fisher's exact (two-sided) on same 2x2
odds, p_fisher = fisher_exact(table2x2)
print(f"\nSENSITIVITY - Fisher's exact (2x2): OR={odds:.4f}, p={p_fisher:.6e}")

# 3) Sensitivity: 3x3 chi-square with full status levels
table3x3 = pd.crosstab(df["m6A"], df["DEG"])
chi2_3, p_3, dof_3, _ = chi2_contingency(table3x3, correction=False)  # >2x2: no Yates
print(f"\nSENSITIVITY - 3x3 chi-square (m6A x DEG full levels): chi2={chi2_3:.4f}, dof={dof_3}, p={p_3:.6e}")
print(table3x3)

# 4) Sensitivity: gene-level aggregation (gene is m6A-sig if any transcript is sig; likewise DEG)
gene = df.groupby("gene_id").agg(
    m6A=("m6A", lambda s: "sig" if (s != "m6A no sig").any() else "no"),
    DEG=("DEG", lambda s: "DE"  if (s != "no-DEGs").any()   else "no"))
tg = pd.crosstab(gene.m6A, gene.DEG)
chi2_g, p_g, dof_g, _ = chi2_contingency(tg, correction=True)
print(f"\nSENSITIVITY - gene-level aggregated 2x2 ({len(gene)} genes, any-sig rule), chi-square (Yates): "
      f"chi2={chi2_g:.4f}, dof={dof_g}, p={p_g:.6e}")
print(tg)

print("\n================ SUMMARY ================")
print(f"PRIMARY  2x2 chi-square (Yates): p = {p_yates:.3e}")
print(f"Sensitivity Fisher exact 2x2   : p = {p_fisher:.3e}")
print(f"Sensitivity 3x3 chi-square     : p = {p_3:.3e}")
print(f"Sensitivity gene-level 2x2     : p = {p_g:.3e}")
