#!/usr/bin/env python3
"""
BixBench bix-9-q5
Question: In which tissue type do bad responders show the highest number of
significantly differentially expressed (lfc>0.5 and basemean>10) genes compared
to controls?

Data: data/Data_deposition_RNAseq_Paroxetine_2017.xlsx, sheet 'NormCount'.
Primary evidence: the nine DESeq2 result blocks deposited in that sheet
(computed by the original capsule from raw counts with DESeq2 outlier
exclusion).  Raw counts are not provided and no DESeq2/R tooling is available,
so the deposited results are authoritative; the size-factor-normalized sample
columns are used for independent verification of block identity and signs.

Criteria applied: padj < 0.05 (NA padj = not significant), baseMean > 10,
lfc > 0.5 (literal, primary) and |lfc| > 0.5 (sensitivity).
"""
import numpy as np
import pandas as pd

XLSX = "data/Data_deposition_RNAseq_Paroxetine_2017.xlsx"
TISSUE_NAME = {"bl": "baseline blood", "dg": "dentate gyrus", "fb": "final blood"}

# ------------------------------------------------------------------ load
df = pd.read_excel(XLSX, sheet_name="NormCount", header=None, skiprows=3)
data = df.iloc[1:].reset_index(drop=True)
data.columns = range(data.shape[1])            # col 0 'Index', col 1 'GeneID'
genes = data[1].astype(str).tolist()
print(f"Loaded NormCount: {data.shape[0]} genes x {data.shape[1]} columns")

# Sample count columns (0-based 2..91); each tissue block of 30 columns is
# ordered Control 1-10, good_responder 1-10, bad_responder 1-10.
groups = {}
for pref, base in (("bl", 2), ("dg", 32), ("fb", 62)):
    groups[f"{pref}_ctrl"] = list(range(base, base + 10))
    groups[f"{pref}_good"] = list(range(base + 10, base + 20))
    groups[f"{pref}_bad"] = list(range(base + 20, base + 30))
gmean = {k: data[c].astype(float).mean(axis=1) for k, c in groups.items()}

# Nine DESeq2 blocks of 9 columns from column 98:
# baseMean, baseMeanA, baseMeanB, foldChange, log2FoldChange, pval, padj, DEG, DEG
block_start = [98 + 9 * k for k in range(9)]
block_tissue = ["bl", "bl", "bl", "dg", "dg", "dg", "fb", "fb", "fb"]

# --------------------------------------------------- verify block identity/sign
print()
print("=" * 78)
print("STEP 1  Verification of the nine DESeq2 blocks against the count matrix")
print("=" * 78)
print("Method: within one DESeq run both compared groups share the same size-")
print("factor scale, so for the TRUE pair (A,B) the quantity")
print("log(baseMeanA/meanA) - log(baseMeanB/meanB) must be ~0 for every gene;")
print("for wrong pairs it is not. foldChange = baseMeanB/baseMeanA,")
print("lfc = log2(B/A), i.e. lfc>0 means up in group B.")
print()
identity = {}
for k, s in enumerate(block_start):
    bA = pd.to_numeric(data[s + 1], errors="coerce")
    bB = pd.to_numeric(data[s + 2], errors="coerce")
    bm = pd.to_numeric(data[s], errors="coerce")
    pref = block_tissue[k]
    m = bm > 100
    res = []
    for a in [f"{pref}_ctrl", f"{pref}_good", f"{pref}_bad"]:
        for b in [f"{pref}_ctrl", f"{pref}_good", f"{pref}_bad"]:
            if a == b:
                continue
            d = np.log(bA[m] / gmean[a][m]) - np.log(bB[m] / gmean[b][m])
            res.append((d.replace([np.inf, -np.inf], np.nan).dropna().abs().median(),
                        a, b))
    res.sort()
    dev, a, b = res[0]
    identity[k] = (a, b)
    gname = {"ctrl": "Control", "good": "good responder", "bad": "bad responder"}
    print(f"Comparison {k+1:2d} ({TISSUE_NAME[pref]:15s}): A = {gname[a.split('_')[1]]:14s}"
          f" B = {gname[b.split('_')[1]]:14s}  median|scale-diff| = {dev:.3f}"
          f"  (runner-up {res[1][0]:.3f})")

# consistency of the design: each tissue should yield the trio
# (good vs ctrl, bad vs ctrl, good vs bad) in that block order
expected = [("ctrl", "good"), ("ctrl", "bad"), ("bad", "good")]
for t in range(3):
    for j in range(3):
        a, b = identity[3 * t + j]
        assert (a.split("_")[1], b.split("_")[1]) == expected[j], \
            f"unexpected block design at comparison {3*t+j+1}"
print("\nAll nine blocks follow the same design per tissue:")
print("  block 3t+1: Control(A) vs good responder(B); block 3t+2: Control(A) vs")
print("  bad responder(B); block 3t+3: bad responder(A) vs good responder(B).")

# additional sign check on strongly significant genes
print("\nSign check (genes with padj<1e-6, baseMean>100): lfc sign vs sign of")
print("log2(group-mean ratio) from the count matrix:")
for pref, k in {"bl": 1, "dg": 4, "fb": 7}.items():
    s = block_start[k]
    lfc = pd.to_numeric(data[s + 4], errors="coerce")
    padj = pd.to_numeric(data[s + 6], errors="coerce")
    a, b = identity[k]
    pred = np.log2(gmean[b].clip(lower=1) / gmean[a].clip(lower=1))  # log2(B/A), same as lfc
    m = (padj < 1e-6) & lfc.notna() & (pd.to_numeric(data[s], errors="coerce") > 100)
    agree = float((np.sign(lfc[m]) == np.sign(pred[m])).mean())
    print(f"  {TISSUE_NAME[pref]:15s}: n={int(m.sum()):4d} strong genes, "
          f"sign agreement = {agree:.1%}")

# ------------------------------------------------- main DE counts per tissue
print()
print("=" * 78)
print("STEP 2  Significant DE genes, bad responders vs controls, per tissue")
print("=" * 78)
bad_vs_ctrl = {"bl": 1, "dg": 4, "fb": 7}      # comparisons 2, 5, 8
rows, results = [], {}
for pref, k in bad_vs_ctrl.items():
    s = block_start[k]
    a, b = identity[k]
    assert (a, b) == (f"{pref}_ctrl", f"{pref}_bad")
    res = pd.DataFrame({
        "GeneID": genes,
        "baseMean": pd.to_numeric(data[s], errors="coerce"),
        "baseMeanA_control": pd.to_numeric(data[s + 1], errors="coerce"),
        "baseMeanB_bad": pd.to_numeric(data[s + 2], errors="coerce"),
        "log2FoldChange": pd.to_numeric(data[s + 4], errors="coerce"),
        "pval": pd.to_numeric(data[s + 5], errors="coerce"),
        "padj": pd.to_numeric(data[s + 6], errors="coerce"),
    })
    sig = res["padj"] < 0.05                                    # NA -> False
    literal = sig & (res["log2FoldChange"] > 0.5) & (res["baseMean"] > 10)
    absfilt = sig & (res["log2FoldChange"].abs() > 0.5) & (res["baseMean"] > 10)
    results[TISSUE_NAME[pref]] = res.assign(_lit=literal, _abs=absfilt)
    rows.append({
        "tissue": TISSUE_NAME[pref],
        "padj<0.05 (any lfc)": int(sig.sum()),
        "lfc>0.5 & baseMean>10 (literal)": int(literal.sum()),
        "|lfc|>0.5 & baseMean>10 (sensitivity)": int(absfilt.sum()),
        "genes with lfc<=0.5 caught by |lfc| variant": int((absfilt & ~literal).sum()),
    })

summary = pd.DataFrame(rows)
print(summary.to_string(index=False))

print()
print("=" * 78)
print("STEP 3  Top 10 genes per tissue (literal criterion, ascending padj)")
print("=" * 78)
for tissue, res in results.items():
    top = res[res["_lit"]].sort_values("padj").head(10)
    show = top[["GeneID", "baseMean", "log2FoldChange", "pval", "padj"]].copy()
    show["baseMean"] = show["baseMean"].round(2)
    show["log2FoldChange"] = show["log2FoldChange"].round(3)
    show["padj"] = show["padj"].map(lambda x: f"{x:.3g}")
    print(f"\n--- {tissue} ---")
    print(show.to_string(index=False))

# ------------------------------------------------------------- robustness
print()
print("=" * 78)
print("STEP 4  Robustness and cross-checks")
print("=" * 78)
lit = {r["tissue"]: r["lfc>0.5 & baseMean>10 (literal)"] for r in rows}
ab = {r["tissue"]: r["|lfc|>0.5 & baseMean>10 (sensitivity)"] for r in rows}
print(f"literal criterion : {lit}")
print(f"|lfc| criterion   : {ab}")
assert max(lit, key=lit.get) == max(ab, key=ab.get)
winner = max(lit, key=lit.get)
print(f"Ranking identical under both readings of 'lfc>0.5' -> {winner}")

print("\nCross-check against the sheet's own undocumented DEG(Max/Median) flags")
print("(NOT used for the answer; flags are a subset of padj<0.05 & |lfc|>~0.58,")
print("without any baseMean>10 filter, so counts are expected to be higher):")
for pref, k in bad_vs_ctrl.items():
    s = block_start[k]
    print(f"  {TISSUE_NAME[pref]:15s}: DEG_max flags = "
          f"{int(data[s+7].isin(['D','U']).sum())}, DEG_median flags = "
          f"{int(data[s+8].isin(['D','U']).sum())}")

print()
print("=" * 78)
print("FINAL ANSWER")
print("=" * 78)
print(f"Dentate gyrus. Bad responders show the highest number of significantly")
print(f"differentially expressed genes vs controls in the DENTATE GYRUS")
print(f"({lit[winner]} genes with padj<0.05, lfc>0.5, baseMean>10; {ab[winner]} genes")
print(f"under the |lfc|>0.5 variant), versus baseline blood ({lit['baseline blood']})")
print(f"and final blood ({lit['final blood']}).")

summary.to_csv("deg_summary_per_tissue.csv", index=False)
for tissue, res in results.items():
    res[res["_lit"]].sort_values("padj")[
        ["GeneID", "baseMean", "log2FoldChange", "pval", "padj"]
    ].to_csv(f"deg_bad_vs_control_{tissue.replace(' ', '_')}.csv", index=False)
print("\nSaved: deg_summary_per_tissue.csv + one full qualifying-gene list per tissue")
