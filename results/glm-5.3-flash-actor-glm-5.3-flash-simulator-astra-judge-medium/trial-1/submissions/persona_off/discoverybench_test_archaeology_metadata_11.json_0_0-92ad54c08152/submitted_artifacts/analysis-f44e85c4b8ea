"""Century-level analysis: Pottery Form diversity collapse vs Pottery Decoration diversity rise."""
import pandas as pd, numpy as np

ts = pd.read_csv('data/time_series_data.csv')
cap = pd.read_csv('data/capital.csv', decimal=',')

# ---- 1. Century-level series & cross-check ----
ts_c = ts[ts.PotteryForm.notna()][['CE','calBP','PotteryForm','PotteryDecoration']].copy()
ts_c['BCE'] = -ts_c.CE
ts_c = ts_c.sort_values('CE').reset_index(drop=True)
cap_c = cap[['BCE','group','ZKeform','Zkeverz']].copy()
cap_c['BCE'] = cap_c.BCE.astype(int)

m = ts_c.merge(cap_c, on='BCE', how='outer', indicator=True)
print('merge status:', m._merge.value_counts().to_dict())
print('max abs diff PF (ts vs cap):', (m.PotteryForm - m.ZKeform).abs().max())
print('max abs diff PD (ts vs cap):', (m.PotteryDecoration - m.Zkeverz).abs().max())

# century deltas (BCE decreasing = time forward: from 4300 BCE down to 500 BCE)
d = cap_c.sort_values('BCE', ascending=False).reset_index(drop=True)
d['dPF'] = d.ZKeform.diff()   # change going from older to younger century
d['dPD'] = d.Zkeverz.diff()
sdPF, sdPD = d.dPF.std(), d.dPD.std()
print(f'\nstd of century deltas: dPF={sdPF:.3f}, dPD={sdPD:.3f}')
print(f'PF: mean={d.ZKeform.mean():.3f} min={d.ZKeform.min():.3f} | PD: mean={d.Zkeverz.mean():.3f} max={d.Zkeverz.max():.3f}')

# ---- 2. Systematic search under multiple definitions ----
def detect(dPF_drop_sig, dPD_rise_sig, also_min=False):
    cond = (d.dPF <= -dPF_drop_sig*sdPF) & (d.dPD >= dPD_rise_sig*sdPD)
    if also_min:
        cond = cond | ((d.ZKeform <= d.ZKeform.min()+1e-9) & (d.dPD > 0))
    return d[cond][['BCE','group','ZKeform','dPF','Zkeverz','dPD']]

for sig in (1.0, 1.5, 2.0):
    print(f'\n--- simultaneous events at {sig}-sigma ---')
    print(detect(sig, sig).to_string(index=False))
print('\n--- events: PF drop >=1.5sig AND reaches series minimum, PD rises >=1sig ---')
cond = (d.dPF <= -1.5*sdPF) & (d.ZKeform <= d.ZKeform.min()+1e-9) & (d.dPD >= 1*sdPD)
print(d[cond][['BCE','group','ZKeform','dPF','Zkeverz','dPD']].to_string(index=False))

# full century table (last 10 rows around transition)
print('\n--- century table 2200-1400 BCE ---')
print(d[(d.BCE>=1400)&(d.BCE<=2200)][['BCE','group','ZKeform','dPF','Zkeverz','dPD']].to_string(index=False))

# ---- 3. Quantify 1700 BCE transition + secondary candidates ----
print('\n--- all large-magnitude one-century changes (|delta| >= 1 sigma) ---')
big = d[(d.dPF.abs() >= sdPF) | (d.dPD.abs() >= sdPD)]
print(big[['BCE','group','ZKeform','dPF','Zkeverz','dPD']].to_string(index=False))

# ---- verify with annual _inter series: century means from interpolated columns ----
ts['cent_BCE'] = (-ts.CE)//100*100
inter_c = ts.groupby('cent_BCE')[['PotteryForm_inter','PotteryDecoration_inter']].mean()
inter_c['dPF'] = inter_c.PotteryForm_inter.diff().shift(-1)  # delta toward next (younger) century
inter_c['dPD'] = inter_c.PotteryDecoration_inter.diff().shift(-1)
print('\n--- _inter century means 1800-1600 BCE ---')
print(inter_c.loc[1800:1600].round(3).to_string())

# ---- 4. Context: pollen openness & demography around 1700 BCE ----
pol = pd.read_csv('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv', decimal=',')
pol['cent_BCE'] = (-pol.CE)//100*100
pc = pol.groupby('cent_BCE')[['MEAN','SMOOTH_MEAN_100y']].mean().round(2)
print('\n--- pollen openness, 2000-1200 BCE (context only) ---')
print(pc.loc[2000:1200].to_string())
print('\nkde_all_mean (demographic proxy) century means 2000-1200 BCE:')
kd = ts.groupby('cent_BCE')[['kde_all_mean','kde_all_detrend']].mean().round(6)
print(kd.loc[2000:1200].to_string())
