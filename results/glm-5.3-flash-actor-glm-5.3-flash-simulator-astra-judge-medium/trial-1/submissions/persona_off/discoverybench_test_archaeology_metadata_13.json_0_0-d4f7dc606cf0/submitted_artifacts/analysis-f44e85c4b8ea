"""
Analysis: centuries with the highest growth phase within 2000-1100 BCE.
Growth = pollen_grate_100 (percentage change of 100-y smoothed pollen openness score,
the demographic indicator). Corroboration: g_all_mean, SMOOTH_MEAN_100y / pollen_inter_100
level trends, capital.csv Z-columns. Sensitivity: recomputed growth from diffs.
"""
import pandas as pd
import numpy as np

DATA = "/workspace/data/"
ts = pd.read_csv(DATA + "time_series_data.csv")
cap = pd.read_csv(DATA + "capital.csv", decimal=",")
pol = pd.read_csv(DATA + "pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv", decimal=",")

# --- window & century binning: BCE century c covers CE in [-c, -c+99] ---
W_LO, W_HI = -2000, -1100
w = ts[(ts.CE >= W_LO) & (ts.CE <= W_HI)].copy()
w["centuryBCE"] = -(np.floor((w.CE + 2000) / 100).astype(int) * 100 - 2000)  # CE -2000..-1901 -> 2000
assert w.centuryBCE.between(1100, 2000).all()

def agg(df, col):
    return df.groupby("centuryBCE")[col].agg(["mean", "median", "max", "count"]).round(6)

print("=" * 80)
print("1) pollen_grate_100 per BCE century (2000-1100)")
g = agg(w, "pollen_grate_100")
print(g.to_string())
rank = g["mean"].sort_values(ascending=False)
print("\nRanking by mean pollen_grate_100:")
print(rank.to_string())

# boundary sensitivity: exclude single year CE -1100
w_ex = w[w.CE != -1100]
g_ex = agg(w_ex, "pollen_grate_100")
print("\nSensitivity - boundary year CE -1100 EXCLUDED (century 1100 has 0 rows then):")
print(g_ex.to_string())
rank_ex = g_ex["mean"].dropna().sort_values(ascending=False)
print("Ranking without boundary year:")
print(rank_ex.to_string())
print("Top-century identical with/without boundary year:",
      rank.index[0] == rank_ex.index[0] and list(rank.index[:3]) == list(rank_ex.index[:3]))

print("\n" + "=" * 80)
print("2) Corroboration A: g_all_mean (archaeological KDE growth rate) per century")
print(agg(w, "g_all_mean")[["mean", "median"]].to_string())
print("g_all_mean ranking:", agg(w, "g_all_mean")["mean"].sort_values(ascending=False).head(4).to_dict())

print("\nCorroboration B: level trend of 100-y smoothed openness")
p = pol.copy()
p["centuryBCE"] = -(np.floor((p.CE + 2000) / 100).astype(int) * 100 - 2000)
pw = p[(p.CE >= W_LO) & (p.CE <= W_HI)]
lvl = pw.groupby("centuryBCE")["SMOOTH_MEAN_100y"].mean().round(3)
lvl_ts = w.groupby("centuryBCE")["pollen_inter_100"].mean().round(3)
tab = pd.DataFrame({"SMOOTH_MEAN_100y_mean": lvl, "pollen_inter_100_mean": lvl_ts})
tab["delta_smooth"] = tab["SMOOTH_MEAN_100y_mean"].diff().round(3)
print(tab.to_string())

print("\nCorroboration C: capital.csv Z-columns in window (100-y bins)")
cw = cap[(cap.BCE >= 1100) & (cap.BCE <= 2000)].set_index("BCE").sort_index(ascending=False)
zcols = ["ZAxtSchwert", "ZDolch", "Zhausgr", "ZCU_AU", "Zamber", "ZMonument", "ZHort",
         "ZSichel", "ZBeil", "ZMW", "ZKeform", "Zkeverz"]
zc = cw[zcols + ["group"]]
print(zc.to_string())
zmean = cw[zcols].mean(axis=1)
print("\nCapital composite (mean of Z-columns) per century BCE:")
print(zmean.round(3).to_string())
print("Century-over-century delta of composite:")
print(zmean.diff().round(3).to_string())

print("\n" + "=" * 80)
print("3) Sensitivity: recomputed growth (first difference of 100-y smoothed series)")
p2 = pol.sort_values("CE").copy()
p2["growth_recomp"] = p2["SMOOTH_MEAN_100y"].diff()
ts2 = ts.sort_values("CE").copy()
ts2["growth_from_inter100"] = ts2["pollen_inter_100"].diff()
w2 = ts2[(ts2.CE >= W_LO) & (ts2.CE <= W_HI)].copy()
w2["centuryBCE"] = -(np.floor((w2.CE + 2000) / 100).astype(int) * 100 - 2000)
w2 = w2.merge(p2[["CE", "growth_recomp"]], on="CE", how="left")
rec = w2.groupby("centuryBCE")[["growth_recomp", "growth_from_inter100"]].mean().round(6)
print(rec.to_string())
print("Ranking by recomputed growth (SMOOTH_MEAN_100y diff):")
print(rec["growth_recomp"].sort_values(ascending=False).head(4).to_dict())
print("Ranking by recomputed growth (pollen_inter_100 diff):")
print(rec["growth_from_inter100"].sort_values(ascending=False).head(4).to_dict())
# also 100-year cumulative change of smoothed level per century
lvl_full = p2.set_index("CE")["SMOOTH_MEAN_100y"]
cum = {c: lvl_full.get(-c, np.nan) - lvl_full.get(-c - 100, np.nan) for c in range(2000, 1099, -100)}
print("\n100-y cumulative change of SMOOTH_MEAN_100y ending at each century start:")
print(pd.Series(cum).round(3).sort_values(ascending=False).to_string())

print("\n" + "=" * 80)
print("4) Summary of top centuries across metrics")
summary = pd.DataFrame({
    "pollen_grate_100_mean": g["mean"],
    "g_all_mean": agg(w, "g_all_mean")["mean"],
    "growth_recomp_smooth": rec["growth_recomp"],
    "growth_recomp_inter100": rec["growth_from_inter100"],
}).round(6)
print(summary.to_string())
for col in summary.columns:
    s = summary[col].dropna()
    top = s[s >= s.max() * 0.75]
    print(f"{col}: top (>=75% of max) centuries -> {sorted(top.index.tolist(), reverse=True)}")
