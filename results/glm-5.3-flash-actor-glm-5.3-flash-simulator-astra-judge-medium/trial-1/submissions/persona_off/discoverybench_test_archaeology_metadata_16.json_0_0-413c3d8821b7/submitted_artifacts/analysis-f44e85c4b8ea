"""
PCA on the 12 forms of capital (Z values) in 100-year time slices (capital.csv).
Characterizes Middle Neolithic (3400-3000 BCE) and Younger Neolithic (2900-2300 BCE)
via PC1 scores, within-phase trends, and loadings. Includes robustness checks.
"""
import pandas as pd
import numpy as np

OUT = "outputs"
ZCOLS = ["ZAxtSchwert","ZDolch","Zhausgr","ZCU_AU","Zamber","ZMonument",
         "ZHort","ZSichel","ZBeil","ZMW","ZKeform","Zkeverz"]
MN = [3400,3300,3200,3100,3000]      # Middle Neolithic, endpoints included
SG = [2900,2800,2700,2600,2500,2400,2300]  # Younger Neolithic, endpoints included

# ---------- 1. Load ----------
cap = pd.read_csv("data/capital.csv", decimal=",")
print("capital.csv shape:", cap.shape, "| NaNs in Z cols:", int(cap[ZCOLS].isna().sum().sum()))
cap = cap.drop(columns=["group","color"])
assert cap["BCE"].tolist() == list(range(4300, 499, -100)), "unexpected bin grid"

X = cap[ZCOLS].astype(float).values
Xs = (X - X.mean(0)) / X.std(0, ddof=1)          # re-standardize across the 39 rows

# ---------- 2. PCA ----------
# PCA via SVD of the standardized matrix (n=39 rows x p=12 vars)
Xc = Xs - Xs.mean(0)
U, S, Vt = np.linalg.svd(Xc, full_matrices=False)
evr = (S**2) / (S**2).sum()                    # explained variance ratio (correlation-matrix PCA)
scores_all = U[:, :len(ZCOLS)] * S[:len(ZCOLS)]
scores = scores_all[:, 0]

# Sign convention: orient PC1 so that the loading of ZMonument (monument count) is POSITIVE.
# (monument count is chosen as reference because it has the largest variance of the raw Z inputs)
if Vt[0, ZCOLS.index("ZMonument")] < 0:
    scores, loadings = -scores, -Vt[0]
else:
    loadings = Vt[0]
print("\nSign convention: PC1 oriented so ZMonument (monument count) loading is POSITIVE.")

load_df = pd.DataFrame({"variable": ZCOLS, "PC1_loading": loadings.round(3)})
print("\nPC1 loadings:\n", load_df.to_string(index=False))

res = cap[["BCE"]].copy()
res["PC1"] = scores.round(3)
res.to_csv(f"{OUT}/pc1_scores_by_century.csv", index=False)
print("\nPC1 by century:\n", res.to_string(index=False))

# ---------- 3. Phase characterization ----------
full_mean = scores.mean()
def characterize(name, bins):
    s = res[res["BCE"].isin(bins)]["PC1"].values
    slope = np.polyfit(bins, s, 1)[0]  # per century of BCE increase (i.e., per 100 y backwards)
    return dict(phase=name, bins=bins, mean=s.mean(), sd=s.std(ddof=1),
                first=s[0], last=s[-1],
                slope_per_bin=np.polyfit(range(len(bins)), s, 1)[0],
                range=(s.min(), s.max()))
for nm, b in [("Middle Neolithic (3400-3000 BCE)", MN), ("Younger Neolithic (2900-2300 BCE)", SG)]:
    c = characterize(nm, b)
    print(f"\n{nm}: mean PC1 = {c['mean']:.3f} (full-series mean = {full_mean:.3f}, "
          f"full-series sd = {scores.std(ddof=1):.3f})")
    print(f"  per-bin PC1: {dict(zip(b, np.round(c['bins'] and res[res.BCE.isin(b)]['PC1'].values,3)))}")
    print(f"  first->last bin: {c['first']:.3f} -> {c['last']:.3f}; "
          f"OLS slope per 100-y step = {c['slope_per_bin']:.3f}; range {c['range']}")

# top |loadings| per pole
ld = load_df.sort_values("PC1_loading")
print("\nStrongest NEGATIVE pole (low PC1):", ld.head(3).values.tolist())
print("Strongest POSITIVE pole (high PC1):", ld.tail(3).values.tolist())

# ---------- 4. Robustness: drop ZSichel ----------
cols2 = [c for c in ZCOLS if c != "ZSichel"]
Xs2 = (cap[cols2].astype(float).values); Xs2 = (Xs2 - Xs2.mean(0)) / Xs2.std(0, ddof=1)
Xs2c = Xs2 - Xs2.mean(0)
U2, S2, Vt2 = np.linalg.svd(Xs2c, full_matrices=False)
s2 = (U2[:, 0] * S2[0])
if Vt2[0, cols2.index("ZMonument")] < 0: s2 = -s2
evr2 = (S2**2) / (S2**2).sum()
r2 = res.copy(); r2["PC1_noSichel"] = s2.round(3)
mn2 = r2[r2.BCE.isin(MN)]["PC1_noSichel"].mean(); sg2 = r2[r2.BCE.isin(SG)]["PC1_noSichel"].mean()
print(f"\n[Robustness 1 - PCA without ZSichel] EVR PC1={evr2[0]:.3f}; "
      f"MN mean={mn2:.3f}, YN mean={sg2:.3f}; corr with main PC1="
      f"{np.corrcoef(res['PC1'], s2)[0,1]:.3f}")

# ---------- 5. Robustness: cross-check raw century Z vs time_series_data.csv raw columns ----------
ts = pd.read_csv("data/time_series_data.csv")
pairs = [("ZAxtSchwert","HatchetSword"),("ZDolch","Dagger"),("Zhausgr","HouseSize"),
         ("ZCU_AU","CopperGold"),("Zamber","Amber"),("ZMonument","MonumentCount"),
         ("ZHort","Depot"),("ZSichel","Sickle"),("ZBeil","AxesCelts"),
         ("ZMW","MonumentSize"),("ZKeform","PotteryForm"),("Zkeverz","PotteryDecoration")]
ok = True
for a, b in pairs:
    c = cap.set_index("BCE")[a].astype(float)
    t = ts.set_index(-ts["CE"])[b]
    t = t[t.index.isin(c.index)]
    if not np.allclose(c.loc[t.index].values, t.values, atol=1e-9, equal_nan=True):
        ok = False; print("  MISMATCH:", a, b)
print(f"[Robustness 2 - raw century Z values identical in both files: {ok}]")

# ---------- 6. Supplementary pollen context ----------
pl = pd.read_csv("data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv", decimal=",")
pl["BCE"] = -pl["CE"]
for nm, b in [("MN", MN), ("SG/YN", SG)]:
    sub = pl[pl["BCE"].isin(b)]
    print(f"[Supplementary] pollen openness MEAN {nm}: mean={sub['MEAN'].mean():.2f} "
          f"(smoothed 100y: {sub['SMOOTH_MEAN_100y'].mean():.2f})")

res.to_csv(f"{OUT}/pc1_scores_by_century.csv", index=False)
load_df.to_csv(f"{OUT}/pc1_loadings.csv", index=False)
print("\nSaved outputs/pc1_scores_by_century.csv and outputs/pc1_loadings.csv")
