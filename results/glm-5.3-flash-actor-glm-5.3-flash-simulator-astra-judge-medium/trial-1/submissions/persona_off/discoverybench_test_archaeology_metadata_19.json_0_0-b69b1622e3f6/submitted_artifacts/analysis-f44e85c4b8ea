"""
PCA on forms of capital in 100-year time slices - Younger Bronze Age (1100-500 BCE).
Primary PCA fitted on the full 39-slice series (all periods); YBA-only PCA as sensitivity check.
Sign convention: PC1 loadings are flipped so that their sum is positive (higher PC1 = higher
overall capital intensity as weighted by the positive-sum loadings).
"""
import pandas as pd, numpy as np

DATA = 'data/capital.csv'
cap = pd.read_csv(DATA, decimal=',')

ZCOLS = ['ZAxtSchwert','ZDolch','Zhausgr',          # symbolic
         'ZCU_AU','Zamber','ZMonument',             # social
         'ZKeform','Zkeverz',                       # cultural
         'ZHort','ZSichel','ZBeil','ZMW']           # economic
FORMS = {c:('symbolic' if c in ['ZAxtSchwert','ZDolch','Zhausgr'] else
            'social'   if c in ['ZCU_AU','Zamber','ZMonument'] else
            'cultural' if c in ['ZKeform','Zkeverz'] else 'economic')
         for c in ZCOLS}

# ---- sanity: equality with time_series_data.csv at horizons ----
ts = pd.read_csv('data/time_series_data.csv', index_col=0)
m = {'HatchetSword':'ZAxtSchwert','Dagger':'ZDolch','HouseSize':'Zhausgr','CopperGold':'ZCU_AU',
     'Amber':'Zamber','MonumentCount':'ZMonument','Depot':'ZHort','Sickle':'ZSichel',
     'AxesCelts':'ZBeil','MonumentSize':'ZMW','PotteryForm':'ZKeform','PotteryDecoration':'Zkeverz'}
diffs=[]
for bce in range(1100,499,-100):
    r = ts[ts.CE==-bce].iloc[0]; c = cap[cap.BCE==bce].iloc[0]
    diffs += [abs(r[t]-c[z]) for t,z in m.items()]
print(f'[check] max |capital.csv - time_series(raw & _inter)| over 84 horizon cells = {max(diffs):.1e}')

# ---- primary PCA: all 39 hundred-year slices ----
X = cap[ZCOLS].to_numpy(float)
Xz = (X - X.mean(0)) / X.std(0, ddof=0)
def np_pca(X, k):
    # eigendecomposition of correlation (standardized) matrix; numpy-only PCA
    C = np.corrcoef(X, rowvar=False)
    w, V = np.linalg.eigh(C)
    order = np.argsort(w)[::-1]
    w, V = w[order], V[:, order]
    return w[:k], V[:, :k]

eigvals, eigvecs = np_pca(Xz, len(ZCOLS))
load = eigvecs[:, 0].copy()
if load.sum() < 0: load = -load; sign_flip = True
else: sign_flip = False
scores_full = (Xz @ load) / np.sqrt(eigvals[0])   # standardized scores

var_ratio = eigvals / len(ZCOLS)
print(f'\n[PCA full series] n=39 slices, 12 vars; sign_flip_applied={sign_flip}')
print(f'PC1 explained variance: {var_ratio[0]*100:.1f}%  (PC2 {var_ratio[1]*100:.1f}%)')
print('\nPC1 loadings (sign-fixed: sum positive) by capital form:')
for c,l in sorted(zip(ZCOLS, load), key=lambda x:-abs(x[1])):
    print(f'  {c:<12} {FORMS[c]:<9} {l:+.3f}')

yba_mask = (cap.BCE>=500)&(cap.BCE<=1100)
res = pd.DataFrame({'BCE': cap.BCE[yba_mask].values,
                    'PC1_full': scores_full[yba_mask],
                    'group': cap.group[yba_mask].values})
print('\nYBA PC1 scores (primary, full-series fit):')
print(res.to_string(index=False))

s1100 = res.loc[res.BCE==1100,'PC1_full'].iloc[0]
later = res[res.BCE<=1000]
later_mean = later.PC1_full.mean()
print(f'\nPC1 at 1100 BCE = {s1100:+.3f}')
for _,r in later.iterrows():
    print(f'  vs {int(r.BCE)} BCE ({r.PC1_full:+.3f}): diff = {s1100-r.PC1_full:+.3f} PC1 units')
print(f'  vs mean of 1000-500 ({later_mean:+.3f}): diff = {s1100-later_mean:+.3f} PC1 units')
print(f'  later-six range: [{later.PC1_full.min():+.3f}, {later.PC1_full.max():+.3f}], std={later.PC1_full.std():.3f}')
z_like = (s1100 - later_mean)/later.PC1_full.std()
print(f'  1100 as z-score relative to later six: {z_like:+.2f}')

# ---- per-variable contribution to the contrast (1100 vs later mean) ----
row1100 = cap[cap.BCE==1100][ZCOLS].iloc[0]
later_rows = cap[cap.BCE<=1000][ZCOLS]
contr = (row1100 - later_rows.mean()) * load          # contribution to PC1 difference
print('\nPer-variable contributions to (PC1_1100 - mean PC1_1000-500):')
for c,v in contr.sort_values(key=abs, ascending=False).items():
    print(f'  {c:<12} {FORMS[c]:<9} value1100={row1100[c]:+.2f}  laterMean={later_rows[c].mean():+.2f}  contribution={v:+.3f}')

# ---- sensitivity: YBA-only PCA, drop constant ZSichel ----
yba = cap[yba_mask]
# drop any zero-variance columns within the YBA window (ZSichel and ZKeform are both constant there)
const_cols = [c for c in ZCOLS if yba[c].std(ddof=0)==0]
print('constant columns within YBA window (dropped from sensitivity fit):', const_cols)
ycols = [c for c in ZCOLS if c not in const_cols]
Y = yba[ycols].to_numpy(float); Yz = (Y-Y.mean(0))/Y.std(0,ddof=0)
w2, V2 = np_pca(Yz, len(ycols))
l2 = V2[:, 0].copy()
if l2.sum()<0: l2=-l2
s2 = (Yz@l2)/np.sqrt(w2[0])
print(f'\n[Sensitivity: YBA-only PCA, {len(ycols)} vars] PC1 var = {w2[0]/len(ycols)*100:.1f}%')
sens = pd.DataFrame({'BCE':yba.BCE.values,'PC1_ybaonly':s2})
print(sens.to_string(index=False))
r_full = np.corrcoef(res.PC1_full, sens.PC1_ybaonly)[0,1]
d2 = s2[0]-s2[1:].mean()
print(f'corr(PC1_full, PC1_ybaonly) over 7 slices = {r_full:.3f}')
print(f'YBA-only: PC1(1100)={s2[0]:+.3f} vs later mean {s2[1:].mean():+.3f} -> diff {d2:+.3f}')

res_out = res.merge(sens, on='BCE')
res_out.to_csv('outputs/yba_pc1_scores.csv', index=False)
pd.DataFrame({'variable':ZCOLS,'form':[FORMS[c] for c in ZCOLS],
              'loading_full':load}).to_csv('outputs/pc1_loadings.csv', index=False)
print('\nSaved outputs/yba_pc1_scores.csv and outputs/pc1_loadings.csv')
