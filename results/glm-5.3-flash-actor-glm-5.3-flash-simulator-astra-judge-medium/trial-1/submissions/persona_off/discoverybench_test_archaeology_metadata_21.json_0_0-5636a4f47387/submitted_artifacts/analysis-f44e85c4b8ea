"""PCA on forms of capital in 100-year slices (capital.csv), DiscoveryBench archaeology."""
import pandas as pd, numpy as np

OUT = 'out/'
cap = pd.read_csv('data/capital.csv', decimal=',')
zcols = ['ZAxtSchwert','ZDolch','Zhausgr','ZCU_AU','Zamber','ZMonument','ZHort','ZSichel','ZBeil','ZMW','ZKeform','Zkeverz']
labels = {'ZAxtSchwert':'Symbolic: Hatchets & Swords','ZDolch':'Symbolic: Daggers','Zhausgr':'Symbolic: House Size',
          'ZCU_AU':'Social: Copper & Gold','Zamber':'Social: Amber','ZMonument':'Social: Monument Count',
          'ZHort':'Economic: Depot','ZSichel':'Economic: Sickle','ZBeil':'Economic: Axes & Celts','ZMW':'Economic: Monument Size',
          'ZKeform':'Cultural: Pottery Form','Zkeverz':'Cultural: Pottery Decoration'}
# deterministic, consistent sign convention across all runs:
#   PC1 anchored so ZCU_AU (largest |PC1| loading in main run) is positive;
#   PC2 anchored so ZBeil (largest |PC2| loading in main run) is positive.
ANCH = {'PC1':'ZCU_AU', 'PC2':'ZBeil'}

def run_pca(X, cols, bce, grp, title, mode='corr'):
    if mode == 'corr':
        Xs = (X - X.mean(0)) / X.std(0, ddof=1)
        M = np.corrcoef(Xs, rowvar=False)
        scale = None
    else:  # 'cov': covariance of as-given Z (no re-standardization), loadings rescaled to corr units
        Xs = X - X.mean(0)
        M = Xs.T @ Xs / (len(Xs)-1)
        scale = X.std(0, ddof=1)
    w, V = np.linalg.eigh(M); order = np.argsort(w)[::-1]; w, V = w[order], V[:, order]
    evr = w / w.sum()
    print(f"\n===== {title} =====")
    print("Eigenvalues:", np.round(w,3))
    print("Explained variance (%):", np.round(evr*100,2))
    print("Cumulative (%):", np.round(np.cumsum(evr)*100,2))
    print("Kaiser (eig>1) components:", int((w>1).sum()))
    L = (V[:, :2] * np.sqrt(w[:2])[None,:]).T
    if scale is not None: L = L / scale[None,:]
    for i, pc in enumerate(['PC1','PC2']):           # fixed anchor sign convention
        j = cols.index(ANCH[pc]); s = 1 if L[i,j] > 0 else -1
        L[i] *= s; V[:, i] *= s
    t = pd.DataFrame({'variable':cols,'group':[labels[c] for c in cols],
                      'PC1':np.round(L[0],3),'PC2':np.round(L[1],3)})
    t['rank_absPC1'] = t.PC1.abs().rank(ascending=False).astype(int)
    print(t.to_string(index=False))
    S = (Xs @ V[:, :2])
    sc = pd.DataFrame({'BCE':bce,'group':grp,'PC1':np.round(S[:,0],3),'PC2':np.round(S[:,1],3)})
    print("\nSlice scores (most recent first):")
    print(sc.sort_values('BCE',ascending=False).to_string(index=False))
    print("\nPC2 by period group:")
    print(sc.groupby('group',sort=False)['PC2'].agg(['count','mean','std','min','max']).round(3).to_string())
    print("\nPC1 by period group:")
    print(sc.groupby('group',sort=False)['PC1'].agg(['mean','std','min','max']).round(3).to_string())
    return t, sc, w, evr

X_raw = cap[zcols].values
t_main, sc_main, eig_main, evr_main = run_pca(
    X_raw, zcols, cap.BCE.values, cap['group'].values,
    "MAIN: correlation-matrix PCA, 39 slices (BCE 4300-500), ZSichel re-standardized")
t_main.to_csv(OUT+'loadings_main.csv', index=False); sc_main.to_csv(OUT+'scores_main.csv', index=False)

# Sensitivity 1: covariance of as-given Z (ZSichel NOT re-standardized)
t2, sc2, w2, evr2 = run_pca(X_raw, zcols, cap.BCE.values, cap['group'].values,
    "SENSITIVITY 1: covariance PCA on as-given Z (ZSichel as-is, SD=0.538)", mode='cov')
t2.to_csv(OUT+'loadings_cov_asgiven.csv', index=False)
print("Loadings corr main vs cov: PC1 r =", round(np.corrcoef(t_main.PC1, t2.PC1)[0,1],3),
      "| PC2 r =", round(np.corrcoef(t_main.PC2, t2.PC2)[0,1],3))

# Sensitivity 2: 37 slices (drop BCE 4300, 4200)
sub = cap[cap.BCE <= 4100]
t3, sc3, w3, evr3 = run_pca(sub[zcols].values, zcols, sub.BCE.values, sub['group'].values,
    "SENSITIVITY 2: 37 slices (BCE 4100-500), correlation-matrix PCA")
t3.to_csv(OUT+'loadings_37slices.csv', index=False)
print("Loadings corr main vs 37-slice: PC1 r =", round(np.corrcoef(t_main.PC1, t3.PC1)[0,1],3),
      "| PC2 r =", round(np.corrcoef(t_main.PC2, t3.PC2)[0,1],3))
print("\nDone.")
