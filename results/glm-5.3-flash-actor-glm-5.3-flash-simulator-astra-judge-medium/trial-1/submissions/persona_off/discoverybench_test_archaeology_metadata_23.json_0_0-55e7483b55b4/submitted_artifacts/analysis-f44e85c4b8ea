"""
DiscoveryBench episode: discoverybench:test/archaeology/metadata_23.json/0/0
Question: Between 3400 BCE and 3000 BCE, how does the number of monuments and axes
change with elements of symbolic capital?

Symbolic capital (strict, per study context): HatchetSword, Dagger, HouseSize.
Secondary/contextual: CopperGold, Amber. Monument block: MonumentCount, MonumentSize.
Axes: AxesCelts. Land-use covariate: pollen openness (ts pollen_inter, pollen-file
SMOOTH_MEAN_100y). Window: CE -3400..-3000 (3400-3000 BCE).

Descriptive/correlational only: only 5 independent 100-yr anchor bins in window.
"""
import pandas as pd, numpy as np, json, itertools

OUT = {}

# ---------- robust parsing ----------
ts = pd.read_csv('data/time_series_data.csv', index_col=0)
cap = pd.read_csv('data/capital.csv', skipinitialspace=True)  # handles CRLF + spaces
for c in cap.columns:
    if c.startswith('Z') or c in ('BCE',):
        cap[c] = cap[c].astype(str).str.strip().str.replace(',', '.').astype(float)
pol = pd.read_csv('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv', index_col=0)
def _comma_to_float(v):
    if isinstance(v, str):
        return float(v.strip().replace(',', '.'))
    return v
for c in pol.columns:
    pol[c] = pol[c].map(_comma_to_float)

SYM   = ['HatchetSword_inter', 'Dagger_inter', 'HouseSize_inter']
SEC   = ['CopperGold_inter', 'Amber_inter']
MON   = ['MonumentCount_inter', 'MonumentSize_inter']
AXES  = ['AxesCelts_inter']
POLL  = ['pollen_inter']

w = ts[(ts.CE >= -3400) & (ts.CE <= -3000)].copy()      # 401 annual rows
a = w[w.CE % 100 == 0].copy()                            # 5 raw anchor bins
assert len(w) == 401 and len(a) == 5 and a[['MonumentCount','AxesCelts']].notna().all().all()

cols = MON + AXES + SYM + SEC + POLL
OUT['window_rows'] = len(w); OUT['anchor_bins'] = len(a)

# ---------- anchor-level table (raw observed values) ----------
anchor_tbl = a[['CE'] + [c.replace('_inter','') for c in MON+AXES+SYM+SEC]].copy()
anchor_tbl['pollen_interp_to_bin'] = [np.interp(ce, w[w.pollen_inter.notna()].CE.values,
                                                w[w.pollen_inter.notna()].pollen_inter.values)
                                      for ce in a.CE]
anchor_tbl['CE_BCE'] = -anchor_tbl.CE
OUT['anchor_table'] = anchor_tbl[['CE_BCE'] + [c.replace('_inter','') for c in MON+AXES+SYM+SEC] + ['pollen_interp_to_bin']].round(3).to_dict('records')

# ---------- pollen-file covariate (independent source) ----------
pw = pol[(pol.CE >= -3400) & (pol.CE <= -3000)]
OUT['pollen_file_smooth100_at_anchors'] = {
    int(-int(ce)): round(float(pw[pw.CE == ce].SMOOTH_MEAN_100y.iloc[0]), 3) for ce in a.CE}

# ---------- Pearson / Spearman on annual interpolated series ----------
def corr_block(df, cols):
    out = {}
    for x in MON + AXES:
        for y in SYM + SEC + POLL:
            sub = df[[x, y]].dropna()
            r = sub[x].corr(sub[y], method='pearson')
            rho = sub[x].corr(sub[y], method='spearman')
            out[f'{x.replace("_inter","")} ~ {y.replace("_inter","")}'] = {
                'pearson': round(float(r), 3), 'spearman': round(float(rho), 3), 'n_rows': len(sub)}
    return out

OUT['corr_annual_interpolated'] = corr_block(w, cols)
OUT['corr_anchor_5bins']        = corr_block(a, cols)

# ---------- first-difference (detrended) correlations, annual series ----------
d = w[cols].diff().dropna()
OUT['corr_first_difference_annual'] = corr_block(d, [c for c in d.columns])

# ---------- lagged cross-correlation (±100 yr), annual series ----------
def lagged(x, y, lags=range(-100, 101, 20)):
    res = {}
    for L in lags:
        xs = w[x].shift(L)          # positive L: x leads y by L years
        sub = pd.concat([xs, w[y]], axis=1).dropna()
        res[L] = round(float(sub.iloc[:,0].corr(sub.iloc[:,1])), 3)
    return res
OUT['lagged_pearson'] = {f'{x.replace("_inter","")} ~ {y.replace("_inter","")}': lagged(x, y)
                         for x in MON + AXES for y in SYM}

# ---------- robustness: monotonic trend direction on anchors (n=5) ----------
def direction(v):
    v = np.asarray(v, float); t = np.arange(len(v))
    r = np.corrcoef(t, v)[0, 1]
    return 'increasing' if r > 0 else 'decreasing', round(float(r), 3)
OUT['anchor_linear_trend_3400_to_3000BCE'] = {
    c.replace('_inter',''): direction(a[c].values) for c in MON + AXES + SYM + SEC + ['pollen_inter']}

# ---------- interpolation-robustness check: raw anchors vs piecewise-linear smear ----------
# correlation of anchor pairs using ONLY the 5 raw bins (no interpolation)
OUT['note_3200BCE_spike'] = {
    'MonumentCount_max_at_BCE': int(-a.loc[a.MonumentCount_inter.idxmax(), 'CE']),
    'MonumentCount_max_z': round(float(a.MonumentCount_inter.max()), 3),
    'AxesCelts_max_at_BCE': int(-a.loc[a.AxesCelts_inter.idxmax(), 'CE']),
    'AxesCelts_max_z': round(float(a.AxesCelts_inter.max()), 3),
    'MonumentCount_excl_3200_range': round(float(a[a.CE != -3200].MonumentCount.max()
                                                 - a[a.CE != -3200].MonumentCount.min()), 3),
    'AxesCelts_excl_3200_range': round(float(a[a.CE != -3200].AxesCelts.max()
                                             - a[a.CE != -3200].AxesCelts.min()), 3)}

with open('outputs/analysis_results.json', 'w') as f:
    json.dump(OUT, f, indent=1, default=str)

# ---------- console summary ----------
print("ANCHOR TABLE (raw 100-yr bins, 3400->3000 BCE):")
print(anchor_tbl[['CE_BCE','MonumentCount','AxesCelts','HatchetSword','Dagger','HouseSize','CopperGold','Amber','pollen_interp_to_bin']].round(3).to_string(index=False))
print("\nCORRELATIONS, 5 raw anchor bins (n=5, independent):")
for k, v in OUT['corr_anchor_5bins'].items(): print(f"  {k:38s} P={v['pearson']:+.3f}  S={v['spearman']:+.3f}")
print("\nCORRELATIONS, annual interpolated series (n=401, descriptive only):")
for k, v in OUT['corr_annual_interpolated'].items(): print(f"  {k:38s} P={v['pearson']:+.3f}  S={v['spearman']:+.3f}")
print("\nCORRELATIONS, first differences (annual, detrended):")
for k, v in OUT['corr_first_difference_annual'].items(): print(f"  {k:38s} P={v['pearson']:+.3f}  S={v['spearman']:+.3f}")
print("\nLAGGED Pearson (positive lag = predictor leads), annual:")
for k, v in OUT['lagged_pearson'].items(): print(f"  {k}: {v}")
print("\nAnchor linear trend 3400->3000 BCE:", OUT['anchor_linear_trend_3400_to_3000BCE'])
print("\n3200 BCE spike diagnostics:", OUT['note_3200BCE_spike'])
print("\nPollen-file SMOOTH_MEAN_100y at anchors:", OUT['pollen_file_smooth100_at_anchors'])
