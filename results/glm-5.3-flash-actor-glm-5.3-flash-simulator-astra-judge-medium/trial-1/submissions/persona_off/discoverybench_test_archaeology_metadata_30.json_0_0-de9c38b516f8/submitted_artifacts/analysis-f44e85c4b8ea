"""
First century where Pottery Decoration rises significantly while Pottery Form declines.
Data: DiscoveryBench archaeology case (time_series_data.csv, capital.csv).
"""
import pandas as pd, numpy as np
from scipy import stats

pd.set_option('display.width', 220)

# ---------- Load ----------
ts = pd.read_csv('data/time_series_data.csv')
cap = pd.read_csv('data/capital.csv', decimal=',')

# ---------- Century-level bins ----------
bins = ts[ts['PotteryDecoration'].notna()][['CE','PotteryDecoration','PotteryForm']].copy()
bins = bins.reset_index(drop=True)
bins['BCE'] = -bins['CE']

# Cross-validate against capital.csv (only role of capital.csv, plus period labels)
m = cap.merge(bins[['BCE','PotteryDecoration','PotteryForm']], on='BCE', how='left')
assert (m.Zkeverz.round(6) == m.PotteryDecoration.round(6)).sum() == 37, 'capital/ts mismatch'
bins = bins.merge(cap[['BCE','group']], on='BCE', how='left')
bins = bins.rename(columns={'group':'period'})
bins['period'] = bins['period'].fillna('pre-EN')  # 4100/4200 BCE not in capital.csv

# ---------- (1) Per-century first differences ----------
bins['dDec'] = bins['PotteryDecoration'].diff()
bins['dForm'] = bins['PotteryForm'].diff()
bins['opposite_sign'] = (bins.dDec > 0) & (bins.dForm < 0)

print('=== Century-level table (37 bins) ===')
print(bins[['CE','BCE','period','PotteryDecoration','PotteryForm','dDec','dForm',
            'opposite_sign']].round(3).to_string(index=False))

qual = bins[bins.opposite_sign & bins.dDec.notna()]
print('\n=== (1) ALL centuries with Dec up AND Form down (sign-only) ===')
print(qual[['CE','BCE','period','dDec','dForm']].round(3).to_string(index=False))

# ---------- (2) Significance filters ----------
med_abs_ddec = bins.dDec.abs().median()
print(f'\nmedian |dDec| across century transitions = {med_abs_ddec:.3f}')
thr = 0.5
q1 = qual[qual.dDec >= thr]
tercile_cut = bins.dDec.quantile(2/3)  # top-tercile threshold on all dDec
q2 = qual[qual.dDec >= tercile_cut]
print(f'=== (2a) filter dDec >= +{thr} z: qualifying centuries ===')
print(q1[['CE','BCE','period','dDec','dForm']].round(3).to_string(index=False))
print(f'\n=== (2b) top-tercile variant (threshold dDec >= {tercile_cut:.3f}) ===')
print(q2[['CE','BCE','period','dDec','dForm']].round(3).to_string(index=False))
first_sign  = qual.BCE.iloc[0]  if len(qual) else None
first_thr   = q1.BCE.iloc[0]    if len(q1) else None
first_terc  = q2.BCE.iloc[0]    if len(q2) else None
print(f'\nfirst qualifying century: sign-only={first_sign} BCE, >=0.5z={first_thr} BCE, '
      f'top-tercile={first_terc} BCE')

# ---------- (3) Robustness checks ----------
# (3a) Rolling OLS slopes on annual _inter series in +/-100 y windows centred on each bin
res = []
for _, row in bins.iterrows():
    c = row.CE
    w = ts[ts.CE.between(c-100, c+100)]
    y1, y2 = w.PotteryDecoration_inter.values, w.PotteryForm_inter.values
    x = w.CE.values - c
    s1 = np.polyfit(x, y1, 1)[0]; s2 = np.polyfit(x, y2, 1)[0]
    res.append((c, s1, s2, s1 > 0, s2 < 0))
roll = pd.DataFrame(res, columns=['CE','slope_Dec','slope_Form','dec_up','form_down'])
roll['opposite'] = roll.dec_up & roll.form_down
rq = roll[roll.opposite]
print('\n=== (3a) rolling ±100y OLS slopes on _inter (slope per year *100 for readability) ===')
print(roll.assign(slope_Dec=roll.slope_Dec*100, slope_Form=roll.slope_Form*100)
          .round(4).to_string(index=False))
print('rolling first qualifying bin CE =', rq.CE.iloc[0] if len(rq) else None)

# (3b) Mann-Kendall-style: Spearman of 3-bin windows (bin t-1, t, t+1) vs time
mk = []
for i in range(1, len(bins)-1):
    d = stats.spearmanr([0,1,2], bins.PotteryDecoration.values[i-1:i+2]).statistic
    f = stats.spearmanr([0,1,2], bins.PotteryForm.values[i-1:i+2]).statistic
    mk.append((bins.CE.iloc[i], d, f, d > 0.5, f < -0.5))
mk = pd.DataFrame(mk, columns=['CE','tau_Dec','tau_Form','dec_up','form_down'])
mk['opposite'] = mk.dec_up & mk.form_down
mq = mk[mk.opposite]
print('\n=== (3b) 3-bin Spearman trend windows (centred bin CE) ===')
print(mk.round(3).to_string(index=False))
print('Spearman-window first qualifying bin CE =', mq.CE.iloc[0] if len(mq) else None)

# (3c) _inter-based replication: per-century difference taken from _inter at bin years
inter = ts[ts.CE.isin(bins.CE)][['CE','PotteryDecoration_inter','PotteryForm_inter']].reset_index(drop=True)
inter['dDec'] = inter.PotteryDecoration_inter.diff()
inter['dForm'] = inter.PotteryForm_inter.diff()
iq = inter[(inter.dDec > 0) & (inter.dForm < 0)]
print('\n=== (3c) _inter-based replication: first qualifying CE =',
      iq.CE.iloc[0] if len(iq) else None, '| all qualifying CEs:', iq.CE.tolist())
same = np.allclose(inter.dDec.values, bins.dDec.values, atol=1e-9, equal_nan=True)
print('identical to bin-level differences:', same)

# ---------- Save artifacts ----------
bins.round(4).to_csv('output/century_delta_table.csv', index=False)
qual.round(4).to_csv('output/qualifying_centuries_sign_only.csv', index=False)
roll.round(6).to_csv('output/rolling_ols_slopes.csv', index=False)
mk.round(4).to_csv('output/spearman_windows.csv', index=False)
print('\nArtifacts written: century_delta_table.csv, qualifying_centuries_sign_only.csv, '
      'rolling_ols_slopes.csv, spearman_windows.csv')
