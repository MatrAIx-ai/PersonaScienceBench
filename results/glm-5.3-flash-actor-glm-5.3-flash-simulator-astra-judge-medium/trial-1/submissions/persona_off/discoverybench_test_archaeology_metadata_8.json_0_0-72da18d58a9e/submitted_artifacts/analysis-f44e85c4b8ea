"""
Analysis: In which millennium did amber have the highest value,
and in what time interval did it peak?

Datasets (DiscoveryBench archaeology task):
  data/time_series_data.csv  - yearly series, CE (negative = BCE), Amber / Amber_inter z-scores
  data/capital.csv           - 100-year-step period table, BCE + Zamber (comma decimals)
  data/pollen_openness_score_...csv - pollen PC1 (not needed for amber; loaded only as a sanity check)

Millennium convention: Nth millennium BCE = years N*000 .. (N-1)*000+1 BCE,
i.e. 4th millennium BCE = 4000-3001 BCE (astronomical binning, as approved).
"""
import pandas as pd
import numpy as np
import json

OUT = {}

# ---------------- 1. Load data ----------------
ts = pd.read_csv('data/time_series_data.csv', index_col=0)
cap = pd.read_csv('data/capital.csv', decimal=',')
pol = pd.read_csv('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv',
                  index_col=0, decimal=',')

assert ts.CE.is_monotonic_increasing
assert ts.calBP.equals(1950 - ts.CE)                      # BCE stored as negative CE
assert np.allclose(1950 - pol.calBP, pol.CE)              # same convention in pollen file

# ---------------- 2. Millennium bins on the yearly series ----------------
# (-CE-1)//1000 + 1 : CE=-3300 -> ((3300-1)//1000)+1 = 4  -> 4th millennium BCE
ts['mill_BCE'] = ((-ts.CE - 1) // 1000 + 1).astype(int)

raw = ts.dropna(subset=['Amber']).copy()                  # 37 anchors at 100-yr steps
raw['mill_BCE'] = ((-raw.CE - 1) // 1000 + 1).astype(int)

bin_inter = ts.groupby('mill_BCE')['Amber_inter'].agg(['mean', 'max', 'count'])
bin_raw = raw.groupby('mill_BCE')['Amber'].agg(['mean', 'max', 'count'])
mill_table = bin_inter.join(bin_raw, lsuffix='_inter', rsuffix='_raw')
mill_table.index = [f"{int(m)}th millennium BCE" if m > 0 else f"{abs(int(m))+1}th millennium CE"
                    for m in mill_table.index]
print("=== Millennium-bin table (time_series_data.csv) ===")
print(mill_table.round(3).to_string())
OUT['millennium_bins'] = mill_table.round(4).reset_index().to_dict('records')

# ---------------- 3. Global maximum and peak plateau ----------------
zmax = ts.Amber_inter.max()
max_years = ts.loc[ts.Amber_inter == zmax, 'CE']
plateau = (max_years.min(), max_years.max())              # contiguous by construction
assert raw.Amber.max() == zmax

# raw anchors >= 1.46 (the high phase)
hi = raw[raw.Amber >= 1.46]
hi_span = (-hi.CE.min(), -hi.CE.max())                    # in BCE years, chronological order
strict_span = (-plateau[1], -plateau[0])                  # plateau in BCE years

print(f"\nGlobal max z (raw & interpolated): {zmax}")
print(f"Max anchor year: BCE {-int(raw.loc[raw.Amber.idxmax(), 'CE'])} (falls in "
      f"{(-int(raw.loc[raw.Amber.idxmax(), 'CE']) - 1)//1000 + 1}th millennium BCE)")
print(f"Strict peak plateau (interpolated == max): BCE {strict_span[0]}-{strict_span[1]}")
print(f"Sustained high phase (raw anchors z>=1.46): BCE {hi_span[0]}-{hi_span[1]} "
      f"(z: {sorted(hi.Amber.unique())})")
OUT.update({'z_max': float(zmax),
            'max_anchor_BCE': int(-raw.loc[raw.Amber.idxmax(), 'CE']),
            'peak_plateau_BCE': [int(strict_span[0]), int(strict_span[1])],
            'high_phase_BCE': [int(hi_span[0]), int(hi_span[1])],
            'high_phase_levels': sorted(hi.Amber.unique().tolist())})

# ---------------- 4. Cross-check with capital.csv ----------------
mm = raw.assign(BCE=-raw.CE.astype(int))[['BCE', 'Amber']].merge(cap[['BCE', 'Zamber']], on='BCE')
assert np.allclose(mm.Amber, mm.Zamber), "anchor mismatch between ts and capital"
extra = sorted(set(cap.BCE) - set(-raw.CE.astype(int)))
cap_max = cap.loc[cap.Zamber.idxmax()]
print(f"\nCross-check capital.csv: {len(mm)} shared anchors match exactly (max diff "
      f"{np.abs(mm.Amber - mm.Zamber).max():.2e}); capital extends to BCE {extra} "
      f"(Zamber = {cap[cap.BCE.isin(extra)].Zamber.unique().tolist()}), "
      f"does not change the result.")
print(f"capital Zamber max: {cap_max.Zamber} at BCE {cap_max.BCE} (group {cap_max['group']})")
OUT['capital_crosscheck'] = {'n_shared_anchors': int(len(mm)), 'exact_match': True,
                             'extra_BCE_rows': extra,
                             'capital_max': {'BCE': int(cap_max.BCE), 'group': cap_max['group'],
                                             'Zamber': float(cap_max.Zamber)}}

# ---------------- 5. 5th-millennium edge artifact ----------------
m5 = ts[ts.mill_BCE == 5]
art = {'CE_window': [int(m5.CE.min()), int(m5.CE.max())],
       'n_years': int(len(m5)),
       'interpolated_mean': round(float(m5.Amber_inter.mean()), 3),
       'raw_anchor_BCEs': sorted(-raw.loc[raw.mill_BCE == 5, 'CE'].astype(int)),
       'raw_anchor_value': float(raw.loc[raw.mill_BCE == 5, 'Amber'].iloc[0]),
       'capital_4300_4200_Zamber': cap[cap.BCE >= 4100].Zamber.tolist()}
print("\n5th-millennium edge artifact:", art)
OUT['edge_artifact_mill5'] = art

# ---------------- 6. Post-peak decline (context) ----------------
decline = raw[(raw.CE > -2900) & (raw.CE <= -1000)][['CE', 'Amber']]
print("\nPost-peak raw anchors (BCE, z):")
print(decline.assign(BCE=-decline.CE.astype(int))[['BCE', 'Amber']].to_string(index=False))
OUT['post_peak'] = decline.assign(BCE=-decline.CE.astype(int))[['BCE', 'Amber']].round(3).to_dict('records')

with open('output/amber_peak_results.json', 'w') as f:
    json.dump(OUT, f, indent=2)

print("\n=== HEADLINE ===")
print(f"Millennium with highest amber value: 4th millennium BCE (bin mean {bin_inter.loc[4,'mean']:.2f}, "
      f"bin max {bin_inter.loc[4,'max']:.2f})")
print(f"Peak interval: ~{strict_span[0]}-{strict_span[1]} BCE (z = {zmax}, dataset maximum)")
print(f"High phase context: z = 1.46 from ~{hi_span[0]} BCE onward")
