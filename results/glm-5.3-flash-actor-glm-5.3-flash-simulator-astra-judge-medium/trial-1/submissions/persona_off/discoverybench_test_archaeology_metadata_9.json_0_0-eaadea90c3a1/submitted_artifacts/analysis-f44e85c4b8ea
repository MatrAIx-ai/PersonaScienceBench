# DiscoveryBench: archaeology / social capital peak century analysis
# Chronology convention: time runs forward as BCE decreases (oldest = highest BCE).
import pandas as pd, numpy as np
pd.set_option('display.width', 220); pd.set_option('display.max_columns', 50)

cap = pd.read_csv('data/capital.csv', decimal=',')
ts  = pd.read_csv('data/time_series_data.csv')
pol = pd.read_csv('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv', decimal=',')

comp = ['ZCU_AU','Zamber','ZMonument']
names = {'ZCU_AU':'CopperGold','Zamber':'Amber','ZMonument':'MonumentCount'}
cap['SocialCapital'] = cap[comp].sum(axis=1)
cap = cap.sort_values('CE' if 'CE' in cap else 'BCE', ascending=False)  # placeholder, fixed below
cap = cap.sort_values('BCE', ascending=False).reset_index(drop=True)   # oldest (4300) -> youngest (500)

print("=== 1) RAW century series (chronological: oldest -> youngest) ===")
print(cap[['BCE','group','SocialCapital']+comp].to_string(index=False, float_format=lambda x: f"{x: .3f}"))

peak_idx = cap.SocialCapital.idxmax(); peak_bce = int(cap.BCE[peak_idx])
ties = cap[np.isclose(cap.SocialCapital, cap.SocialCapital.max())].BCE.tolist()
print(f"\nPEAK century (raw sum): BCE {peak_bce}, sum = {cap.SocialCapital.max():.3f}; tied centuries: {ties}")
print("Top 5 centuries by raw sum:")
print(cap.nlargest(5,'SocialCapital')[['BCE','group','SocialCapital']+comp].to_string(index=False, float_format=lambda x: f"{x: .3f}"))

# 2) attribution over the true chronological run-up (4300 BCE -> peak)
print("\n=== 2) Component attribution (chronological run-up 4300 -> peak BCE) ===")
runup = cap.iloc[:peak_idx+1]
d = runup[comp].diff()
print("Per-century deltas (change into each century, chronological):")
print(pd.concat([runup[['BCE']], d.rename(columns=names).round(3)], axis=1).to_string(index=False))
first, pkrow = runup.iloc[0], runup.iloc[-1]
tot = pkrow.SocialCapital - first.SocialCapital
print(f"\nCumulative change over full run-up (BCE {int(first.BCE)} -> BCE {peak_bce}); total sum delta {tot:+.3f}:")
for c in comp:
    dd = pkrow[c]-first[c]; print(f"  {names[c]:13s}: {first[c]: .3f} -> {pkrow[c]: .3f}  ({dd:+.3f}, {dd/tot*100:5.1f}% of total)")
print("\nChange into the peak plateau from the preceding 2 centuries (1600->1400 BCE):")
prev = cap[cap.BCE==1600].iloc[0]
for c in comp:
    dd = pkrow[c]-prev[c]; print(f"  {names[c]:13s}: {prev[c]: .3f} -> {pkrow[c]: .3f}  ({dd:+.3f})")
print("\nSpearman rho with the sum, full series / run-up only:")
for c in comp:
    print(f"  {names[c]:13s}: full {cap[c].corr(cap.SocialCapital,'spearman'):.3f} | run-up {runup[c].corr(runup.SocialCapital,'spearman'):.3f}")
print("\nWhich component records the largest single-century rise over the whole series?")
for c in comp:
    i = cap[c].diff().idxmax()
    print(f"  {names[c]:13s}: max rise {cap[c].diff()[i]:+.3f} into BCE {int(cap.BCE[i])}")

# sign-fixed PCA
X = (cap[comp].values - cap[comp].values.mean(0)) / cap[comp].values.std(0)
w, V = np.linalg.eigh(np.cov(X.T)); w, V = w[::-1], V[:, ::-1]
pc1 = X @ V[:,0]
if np.corrcoef(pc1, cap.SocialCapital)[0,1] < 0: V[:,0] *= -1; pc1 = -pc1
print("\nPCA PC1 (sign fixed positive vs summed capital): loadings:", 
      {names[c]: round(float(V[i,0]),3) for i,c in enumerate(comp)},
      f"| variance share {w[0]/w.sum()*100:.1f}%")

# 3) sensitivity
print("\n=== 3) Sensitivity ===")
roll = cap.SocialCapital.rolling(3, center=True, min_periods=1).mean()
print(f"Peak century, 3-century centered rolling mean: BCE {int(cap.BCE[roll.idxmax()])} ({roll.max():.3f}); top3:",
      [int(cap.BCE[i]) for i in roll.nlargest(3).index])
x, y = cap.BCE.values.astype(float), cap.SocialCapital.values
b, a = np.polyfit(x, y, 1); resid = y - (a + b*x)
print(f"Peak century, linearly detrended sum: BCE {int(cap.BCE[np.argmax(resid)])} (residual {resid.max():.3f}; slope {b:+.5f}/yr)")
tsa = ts.sort_values('CE'); s_ann = tsa.CopperGold_inter + tsa.Amber_inter + tsa.MonumentCount_inter
print(f"Peak of interpolated ANNUAL sum: CE {int(tsa.CE[s_ann.idxmax()])} (= BCE {-int(tsa.CE[s_ann.idxmax()])}, {s_ann.max():.3f}); annual values flat-topped 1400-1300 BCE:", 
      np.isclose(s_ann[(tsa.CE>=-1400)&(tsa.CE<=-1300)], 4.23803, atol=1e-3).all())
tmp = pd.DataFrame({'BCE': -tsa.CE.values, 's': s_ann.values})
tmp['cent'] = np.ceil(tmp.BCE/100)*100
agg = tmp.groupby('cent').s.mean()
print(f"Peak century bin, annual-mean sum: BCE {int(agg.idxmax())} ({agg.max():.3f}); top5 bins:",
      [(int(k), round(v,3)) for k,v in agg.nlargest(5).items()])

# 4) pollen/openness context
print("\n=== 4) Pollen/openness context (context only) ===")
ts2 = ts.copy(); ts2['BCE'] = -ts2.CE
mg = ts2.merge(pol[['CE','MEAN','SMOOTH_MEAN_100y']], on='CE', how='inner')
mg['sum'] = mg.CopperGold_inter + mg.Amber_inter + mg.MonumentCount_inter
print(f"Overlap: {len(mg)} annual rows, CE {int(mg.CE.max())}..{int(mg.CE.min())}")
print(f"  sum vs pollen MEAN:          Spearman {mg['sum'].corr(mg.MEAN,'spearman'):.3f} | Pearson {mg['sum'].corr(mg.MEAN):.3f}")
print(f"  sum vs SMOOTH_MEAN_100y:     Spearman {mg['sum'].corr(mg.SMOOTH_MEAN_100y,'spearman'):.3f} | Pearson {mg['sum'].corr(mg.SMOOTH_MEAN_100y):.3f}")
cm = mg.groupby(np.ceil(mg.BCE/100)*100).agg(sum_mean=('sum','mean'), open_mean=('MEAN','mean'))
print(f"  century-level Spearman(sum, openness MEAN): {cm.sum_mean.corr(cm.open_mean,'spearman'):.3f} (n={len(cm)})")
print(f"  openness MEAN at peak centuries (1400/1300 BCE): {cm.loc[1400,'open_mean']:.2f} / {cm.loc[1300,'open_mean']:.2f} vs series max {cm.open_mean.max():.2f} at BCE {int(cm.open_mean.idxmax())}")

cap[['BCE','group','SocialCapital']+comp].round(4).to_csv('analysis_out/century_social_capital.csv', index=False)
print("\nSaved: analysis_out/century_social_capital.csv")
