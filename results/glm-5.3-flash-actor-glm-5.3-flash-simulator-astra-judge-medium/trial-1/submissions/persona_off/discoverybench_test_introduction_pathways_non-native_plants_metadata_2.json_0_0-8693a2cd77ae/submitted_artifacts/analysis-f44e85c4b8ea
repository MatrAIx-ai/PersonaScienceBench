"""
Analysis: How does the prevalence of non-native plants introduced via gardening
vary by habitat type?
Primary data: data/invaded_niche_pathways.csv (tab-separated; one row = one plot).
Context: data/temporal_trends_contingency_table.csv, data/invasion_success_pathways.csv.
"""
import numpy as np
import pandas as pd
import statsmodels.api as sm
import statsmodels.formula.api as smf
from scipy import stats
from statsmodels.stats.multitest import multipletests

pd.set_option('display.width', 250); pd.set_option('display.max_columns', 50)

inv = pd.read_csv('data/invaded_niche_pathways.csv', sep='\t')
ct  = pd.read_csv('data/temporal_trends_contingency_table.csv', sep='\t')
spp = pd.read_csv('data/invasion_success_pathways.csv')

# ---------------------------------------------------------------- sanity checks
assert (inv['n.gard'] + inv['n.unint'] + inv['n.agfo'] == inv['n.total']).all()
assert (inv[['n.gard','n.unint','n.agfo','n.total']] >= 0).all().all()
assert inv.isna().sum().sum() == 0
print("Sanity: additive identity OK in all rows; no missing values; no negative counts.")

# ================================================================ 1) DESCRIPTIVE
# Wilson 95% CI helper
def wilson(k, n, z=1.96):
    if n == 0: return (np.nan, np.nan)
    p = k / n
    den = 1 + z**2 / n
    centre = (p + z**2 / (2*n)) / den
    half = z * np.sqrt(p*(1-p)/n + z**2/(4*n**2)) / den
    return (max(0.0, centre - half), min(1.0, centre + half))

agg = inv.groupby('habitat').agg(
    plots=('n.total', 'size'),
    invaded_plots=('n.total', lambda x: int((x > 0).sum())),
    n_gard=('n.gard', 'sum'),
    n_unint=('n.unint', 'sum'),
    n_agfo=('n.agfo', 'sum'),
    n_total=('n.total', 'sum'))
agg['mean_n.gard_per_plot'] = agg['n_gard'] / agg['plots']
agg['prop_gard'] = agg['n_gard'] / agg['n_total']
agg[['ci_lo','ci_hi']] = agg.apply(
    lambda r: pd.Series(wilson(r['n_gard'], r['n_total'])), axis=1)
agg = agg.sort_values('prop_gard', ascending=False)
print("\n=== DESCRIPTIVE TABLE (primary: prop_gard = sum n.gard / sum n.total) ===")
print(agg[['plots','invaded_plots','n_gard','n_unint','n_agfo','n_total',
           'prop_gard','ci_lo','ci_hi','mean_n.gard_per_plot']].round(3).to_string())

# gardening among ALL plots (absolute frequency ranking)
freq = inv.groupby('habitat')['n.gard'].mean().sort_values(ascending=False)
print("\nMean n.gard per plot (all plots, incl. zeros), ranked:")
print(freq.round(3).to_string())

# ================================================================ 2) INFERENCE
# (a) Chi-square: gardening vs other, across habitats (invaded records only)
tab = np.column_stack([agg['n_gard'], agg['n_total'] - agg['n_gard']])
chi2, p_chi, dof, exp = stats.chi2_contingency(tab)
print(f"\nChi-square (10x2 gardening vs other): chi2={chi2:.2f}, dof={dof}, p={p_chi:.3e}")
print("Min expected cell count:", exp.min().round(2))

# (b) Binomial GLM on invaded plots: cbind(n.gard, n.total-n.gard) ~ habitat
habs = sorted(inv['habitat'].unique())
invaded = inv[inv['n.total'] > 0].copy()
invaded['other'] = invaded['n.total'] - invaded['n.gard']
invaded['habitat'] = pd.Categorical(invaded['habitat'], categories=habs)
invaded['habitat'] = invaded['habitat'].cat.reorder_categories(
    ['Urban'] + [h for h in habs if h != 'Urban'])
binom = smf.glm('Q("n.gard") + other ~ habitat', data=invaded,
                family=sm.families.Binomial()).fit()
print("\n=== Binomial GLM (invaded plots only): n.gard vs other ~ habitat ===")
print(f"n = {len(invaded)} invaded plots; deviance = {binom.deviance:.1f} on {binom.df_resid} df")
# marginal means: predicted gardening proportion per habitat (equal-weight plots)
habs = sorted(inv['habitat'].unique())
grid = pd.DataFrame({'habitat': habs})
mm_bin = binom.get_prediction(grid).summary_frame(alpha=0.05)
mm_bin.index = habs
mm_bin = mm_bin.rename(columns={'mean':'pred_prop_gard','mean_ci_lower':'lo','mean_ci_upper':'hi'})
mm_bin = mm_bin.sort_values('pred_prop_gard', ascending=False)
print("Predicted gardening proportion per habitat (binomial GLM marginal means):")
print(mm_bin[['pred_prop_gard','lo','hi']].round(3).to_string())
# contrasts vs reference level
ct_b = binom.params.drop('Intercept').to_frame('coef')
ct_b['z'] = binom.tvalues.drop('Intercept')
ct_b['p'] = binom.pvalues.drop('Intercept')
print("\nBinomial GLM coefficients (reference = Urban):")
print(ct_b.round(4).to_string())

# (c) Poisson / negative-binomial GLM over ALL 632 plots: n.gard ~ habitat
inv_o = inv.copy()
inv_o['habitat'] = inv_o['habitat'].cat.reorder_categories(
    ['Urban'] + [h for h in habs if h != 'Urban']) if isinstance(inv_o['habitat'].dtype, pd.CategoricalDtype) else inv_o['habitat']
inv_o['habitat'] = pd.Categorical(inv_o['habitat'],
    categories=['Urban'] + [h for h in habs if h != 'Urban'])
pois = smf.glm('Q("n.gard") ~ habitat', data=inv_o, family=sm.families.Poisson()).fit()
mu = pois.fittedvalues
dispersion = ((inv['n.gard'] - mu)**2 / mu).sum() / pois.df_resid
print(f"\n=== Poisson GLM (all {len(inv)} plots): n.gard ~ habitat ===")
print(f"Pearson dispersion = {dispersion:.2f} (>1 => overdispersion)")
if dispersion > 1.5:
    nb = smf.glm('Q("n.gard") ~ habitat', data=inv,
                 family=sm.families.NegativeBinomial(alpha=1/dispersion)).fit()
    model_nb, name = nb, 'Negative-binomial GLM (alpha=1/dispersion)'
else:
    model_nb, name = pois, 'Poisson GLM'
print("Using:", name)
print(f"deviance = {model_nb.deviance:.1f} on {model_nb.df_resid} df; LR vs intercept-only:")
null_nb = smf.glm('Q("n.gard") ~ 1', data=inv_o,
                  family=sm.families.Poisson()).fit()
lr = 2*(pois.llf - null_nb.llf)
print(f"  LR = {lr:.1f}, df = {pois.df_model:.0f}, p = {stats.chi2.sf(lr, pois.df_model):.3e}")
grid_o = pd.DataFrame({'habitat': pd.Categorical(habs,
    categories=['Urban'] + [h for h in habs if h != 'Urban'])})
pred_nb = model_nb.predict(grid_o)
pred_nb.index = habs
print("Predicted mean n.gard per plot by habitat (model marginal means):")
print(pred_nb.sort_values(ascending=False).round(3).to_string())
obs_nb = inv.groupby('habitat')['n.gard'].mean().reindex(habs).round(3)
print("Observed mean n.gard per plot by habitat:")
print(obs_nb.sort_values(ascending=False).to_string())
# rate ratios vs reference
rr = pd.DataFrame({'coef': model_nb.params.drop('Intercept'),
                   'rate_ratio': np.exp(model_nb.params.drop('Intercept')),
                   'p': model_nb.pvalues.drop('Intercept')}).sort_index()
print(f"\n{name} contrasts (rate ratios vs reference = Urban):")
print(rr.round(4).to_string())

# ================================================================ 3) SENSITIVITY
inv2 = inv.copy()
inv2['urban1000'] = inv2['urban.2009.1000m']
inv2['crop1000']  = inv2['cropland.2009.1000m']
inv2['temp']      = inv2['annual.temperature']
inv2['rain']      = inv2['annual.rainfall']
inv2['d_road']    = inv2['distance.road']
inv2['d_stream']  = inv2['distance.stream']
form_cov = ('Q("n.gard") ~ habitat + elevation + temp + rain'
            ' + urban1000 + crop1000 + d_road + d_stream')
pois_cov = smf.glm(form_cov, data=inv2, family=sm.families.Poisson()).fit()
mu2 = pois_cov.fittedvalues
disp2 = ((inv2['n.gard'] - mu2)**2 / mu2).sum() / pois_cov.df_resid
nb_cov = smf.glm(form_cov, data=inv2,
                 family=sm.families.NegativeBinomial(alpha=1/disp2)).fit()
print(f"\n=== Sensitivity: NB GLM n.gard ~ habitat + elevation + temperature + rainfall"
      f" + urban/cropland 2009 (1000 m) + distances ===")
print(f"Poisson dispersion with covariates = {disp2:.2f}")
tab2 = pd.DataFrame({'coef': nb_cov.params, 'p': nb_cov.pvalues})
tab2['rate_ratio'] = np.exp(tab2['coef'])
print("Habitat coefficients (reference = {}):".format(sorted(habs)[0]))
print(tab2.loc[[i for i in tab2.index if i.startswith('habitat')]].round(4).to_string())
print("Covariate coefficients:")
print(tab2.drop(index=[i for i in tab2.index if i.startswith('habitat')]).round(4).to_string())
print("LR test habitat block (NB with vs without habitat):")
form_cov0 = ('Q("n.gard") ~ elevation + temp + rain'
             ' + urban1000 + crop1000 + d_road + d_stream')
pois_cov0 = smf.glm(form_cov0, data=inv2,
                    family=sm.families.Poisson()).fit()
lr2 = 2*(pois_cov.llf - pois_cov0.llf)
print(f"  LR = {lr2:.1f}, df = {len(habs)-1}, p = {stats.chi2.sf(lr2, len(habs)-1):.3e}")

# Binomial GLM with covariates on invaded plots (sensitivity)
form_bin_cov = ('Q("n.gard") + other ~ habitat + elevation + temp + rain'
                ' + urban1000 + crop1000 + d_road + d_stream')
invaded2 = invaded.assign(
    urban1000=invaded['urban.2009.1000m'], crop1000=invaded['cropland.2009.1000m'],
    temp=invaded['annual.temperature'], rain=invaded['annual.rainfall'],
    d_road=invaded['distance.road'], d_stream=invaded['distance.stream'])
bin_cov = smf.glm(form_bin_cov, data=invaded2, family=sm.families.Binomial()).fit()
bt = pd.DataFrame({'coef': bin_cov.params, 'p': bin_cov.pvalues})
print("\nBinomial GLM + covariates: habitat coefficients (p-values):")
print(bt.loc[[i for i in bt.index if i.startswith('habitat')]].round(4).to_string())

# optional robustness: landscape-change flags + spatial autocorrelation check
inv3 = inv2.copy()
inv3['prog'] = inv3['progressive.1956.2009.50m']
inv3['regr'] = inv3['regressive.1956.2009.50m']
form_lc = form_cov + ' + prog + regr'
pois_lc = smf.glm(form_lc, data=inv3, family=sm.families.Poisson()).fit()
pois_lc0 = smf.glm(form_cov0 + ' + prog + regr', data=inv3,
                   family=sm.families.Poisson()).fit()
print("\nRobustness: adding landscape-change flags -> habitat LR p =",
      f"{stats.chi2.sf(2*(pois_lc.llf - pois_lc0.llf), pois_lc.df_model - pois_lc0.df_model):.3e}")
# Moran-like check on residuals (crude: correlation of residual with nearest-neighbour residual)
lon = inv['longitude'].values.astype(float); lat = inv['latitude'].values.astype(float)
res = (inv['n.gard'].values - pois.fittedvalues.values)
from scipy.spatial import cKDTree
tree = cKDTree(np.column_stack([lon, lat]))
d, idx = tree.query(np.column_stack([lon, lat]), k=2)
nn_res = res[idx[:,1]]
r_sp = stats.pearsonr(res, nn_res)
print(f"Spatial autocorrelation crude check (Pearson r of residual vs nearest-neighbour residual): r={r_sp[0]:.3f}, p={r_sp[1]:.3g}")

# ================================================================ 4) CONTEXT
print("\n=== CONTEXT: temporal trends (regional Catalonia) ===")
piv = ct.pivot(index='introduction.period', columns='pathway', values='n')
piv = piv.reindex(['Before 1500','1501-1900','1901-1984','1985-2019'])
print(piv.to_string())
print("Gardening share by period:",
      (piv['Gardening']/piv.sum(axis=1)).round(3).to_dict())
chi2t, pt, dt_, _ = stats.chi2_contingency(piv.values)
print(f"Chi-square period x pathway: chi2={chi2t:.1f}, dof={dt_}, p={pt:.3e}")

print("\n=== CONTEXT: invasion_success_pathways (species-level, deduplicated) ===")
spp_dd = spp[~spp['duplicated']].copy()
print(f"Rows after removing duplicated flag: {len(spp_dd)}; intro.pathway:",
      spp_dd['intro.pathway'].value_counts().to_dict())
print("Gardening species share:", round(spp_dd['intro.pathway'].eq('Gardening').mean(), 3))

# low-confidence flags
print("\nLow-confidence habitats (small invaded-record counts):",
      [h for h in agg.index if agg.loc[h,'n_total'] < 10])

# save outputs
agg.round(4).to_csv('outputs/per_habitat_summary.csv')
mm_bin.round(4).to_csv('outputs/binomial_glm_marginal_means.csv')
pd.DataFrame({'chi2':[chi2],'p':[p_chi],'dof':[dof]}).to_csv('outputs/chi_square.csv', index=False)
print("\nSaved: outputs/per_habitat_summary.csv, outputs/binomial_glm_marginal_means.csv, outputs/chi_square.csv")
