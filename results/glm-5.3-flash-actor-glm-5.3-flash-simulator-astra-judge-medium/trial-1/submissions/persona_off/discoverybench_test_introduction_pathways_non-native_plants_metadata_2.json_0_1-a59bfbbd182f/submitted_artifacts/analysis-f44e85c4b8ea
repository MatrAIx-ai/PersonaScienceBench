"""
Analysis: In what context does the gardening pathway for introducing non-native
plants show different prevalence styles across habitat types?

Primary data : data/invaded_niche_pathways.csv (632 plots, Barcelona province)
Supporting   : data/invasion_success_pathways.csv (81 species)
              data/temporal_trends_contingency_table.csv (regional first records)
              data/phylogenetic_tree.txt (species linkage only; not needed here)

Operationalization of "prevalence style" (agreed with researcher):
 (a) proportional share of Gardening among alien species recorded in the habitat
 (b) per-plot mean number of Gardening aliens (ALL plots of the habitat as
     denominator, including plots with n.total == 0)
 (c) which pathway dominates the habitat's alien mix
Primary claim is based on within-plot proportions/frequencies, NOT raw counts,
because habitat plot numbers are unequal (29-106 plots).
"""
import csv, json, math
import numpy as np
import pandas as pd
from scipy import stats

OUT = "artifacts"

# ---------------------------------------------------------------- load primary
df = pd.read_csv("data/invaded_niche_pathways.csv", sep="\t")
PW = ["n.gard", "n.unint", "n.agfo"]
assert (df[PW].sum(axis=1) == df["n.total"]).all(), "n.total != row sum"
n_plots = len(df)
print(f"Plots: {n_plots}; plots with >=1 alien: {(df["n.total"] > 0).sum()}; "
      f"total alien records: {int(df["n.total"].sum())}")

# ------------------------------------------------- habitat x pathway contingency
ct = df.groupby("habitat")[PW].sum()
ct.columns = ["Gardening", "Unintentional", "AgriForest"]
ct["Total"] = ct.sum(axis=1)
ct["n_plots"] = df.groupby("habitat").size()
ct = ct.sort_values("Total", ascending=False)
ct.to_csv(f"{OUT}/contingency_habitat_x_pathway.csv")
print("\n=== Habitat x pathway contingency (alien records summed over plots) ===")
print(ct.to_string())

# --------------------------------------------- per-habitat prevalence-style table
summ = pd.DataFrame(index=ct.index)
summ["n_plots"] = ct["n_plots"]
summ["aliens_total"] = ct["Total"]
summ["gard_count"] = ct["Gardening"]
summ["gard_share_of_aliens"] = ct["Gardening"] / ct["Total"]           # (a)
summ["gard_per_plot_mean"] = df.groupby("habitat")["n.gard"].mean()     # (b)
summ["gard_plot_freq"] = df.assign(g=df["n.gard"] > 0).groupby("habitat")["g"].mean()
summ["unint_share_of_aliens"] = ct["Unintentional"] / ct["Total"]
summ["agfo_share_of_aliens"] = ct["AgriForest"] / ct["Total"]
# (c) dominant pathway
summ["dominant_pathway"] = ct[["Gardening", "Unintentional", "AgriForest"]].idxmax(axis=1)
summ["dominant_share"] = ct[["Gardening", "Unintentional", "AgriForest"]].max(axis=1) / ct["Total"]
# evidence flag for sparse habitats
summ["low_evidence"] = summ["aliens_total"] < 10
summ = summ.sort_values("gard_share_of_aliens", ascending=False)
summ.to_csv(f"{OUT}/per_habitat_gardening_prevalence.csv")
print("\n=== Per-habitat gardening prevalence styles ===")
print(summ.round(3).to_string())

# --------------------------------------------------- statistical test
# Contingency of alien records: habitats (rows) x 3 pathways (cols).
# Sparse cells (expected counts < 5, zeros) exist; pool low-evidence habitats.
tab = ct[["Gardening", "Unintentional", "AgriForest"]].values
exp = np.outer(tab.sum(axis=1), tab.sum(axis=0)) / tab.sum()
print("\nExpected counts under independence:")
print(pd.DataFrame(exp.round(2), index=ct.index,
                   columns=["Gardening", "Unintentional", "AgriForest"]).to_string())

low_ev = ct.index[ct["Total"] < 10].tolist()
print("\nLow-evidence habitats pooled (aliens < 10):", low_ev)
pooled = df[df.habitat.isin(low_ev)][PW].sum()
big = df[~df.habitat.isin(low_ev)].groupby("habitat")[PW].sum()
tab2 = pd.concat([big, pooled.rename("Pooled_low_evidence").to_frame().T])
tab2.columns = ["Gardening", "Unintentional", "AgriForest"]
print("\nTest table (rows = habitats, pooled where sparse):")
print(tab2.to_string())
tab2.to_csv(f"{OUT}/contingency_test_table.csv")

chi2, p_chi, dof, _ = stats.chi2_contingency(tab2.values)
print(f"\nChi-square (pooled): chi2={chi2:.2f}, df={dof}, p={p_chi:.3e}")

# Expected counts in test table — check chi-square validity
exp2 = np.outer(tab2.values.sum(axis=1), tab2.values.sum(axis=0)) / tab2.values.sum()
print("Min expected count in test table:", round(exp2.min(), 2))

# Permutation fallback / cross-check (row totals fixed)
rng = np.random.default_rng(42)
row = tab2.values.sum(axis=1); col = tab2.values.sum(axis=0); N = tab2.values.sum()
def chi2_stat(t):
    e = np.outer(t.sum(1), t.sum(0)) / t.sum()
    return ((t - e) ** 2 / e).sum()
obs = chi2_stat(tab2.values)
n_perm = 20000
marg = np.repeat(np.arange(len(row)), row)
cnt = 0
for _ in range(n_perm):
    rng.shuffle(marg)
    t = np.zeros_like(tab2.values, dtype=float)
    # build table by shuffling column labels among fixed row totals
    lab = np.concatenate([np.full(c, j) for j, c in enumerate(col)])
    rng.shuffle(lab)
    for r, c in zip(np.repeat(np.arange(len(row)), row), lab):
        t[r, c] += 1
    if chi2_stat(t) >= obs - 1e-9:
        cnt += 1
p_perm = (cnt + 1) / (n_perm + 1)
print(f"Permutation test (20,000 shuffles, row/col totals fixed): "
      f"chi2_obs={obs:.2f}, p={p_perm:.5f}")

# Pairwise: which habitats contrast? Gardening share among aliens with
# Wilson-type comparison — use 2x2 Gardening vs (Unint+Agfo) per habitat pair
print("\nPairwise Gardening-vs-other composition (chi-square 2xK per habitat vs rest,"
      " only for high-evidence habitats):")
hi = [h for h in ct.index if ct.loc[h, "Total"] >= 10]
for h in hi:
    t = np.array([[ct.loc[h, "Gardening"], ct.loc[h, "Total"] - ct.loc[h, "Gardening"]],
                  [ct.loc[hi].drop(h).Gardening.sum(),
                   ct.loc[hi].drop(h).Total.sum() - ct.loc[hi].drop(h).Gardening.sum()]])
    c2, pv, _, _ = stats.chi2_contingency(t)
    print(f"  {h:25s} gard share={summ.loc[h,'gard_share_of_aliens']:.2f} "
          f"vs rest: chi2={c2:.2f}, p={pv:.2e}")

# ------------------------------------------- supporting context (species level)
sp = pd.read_csv("data/invasion_success_pathways.csv")
sp_ctx = sp["intro.pathway"].value_counts()
print("\n=== Species-level context (invasion_success_pathways.csv, n=81) ===")
print(sp_ctx.to_string(), "\nGardening share:", round(sp_ctx["Gardening"] / len(sp), 3))
print("NOTE: no per-species habitat column -> species-level habitat attribution "
      "NOT possible from these files; used as context only.")

tmp = pd.read_csv("data/temporal_trends_contingency_table.csv", sep="\t")
pv = tmp.pivot(index="introduction.period", columns="pathway", values="n")
pv = pv[["AgriForest", "Gardening", "Unintentional"]]
pv["gard_share"] = pv["Gardening"] / pv.sum(axis=1)
print("\n=== Temporal context (regional first records) ===")
print(pv.round(3).to_string())
pv.to_csv(f"{OUT}/temporal_context.csv")

# ----------------------------------------------------------------- diagnostics
diag = {
    "n_plots": n_plots,
    "plots_with_aliens": int((df["n.total"] > 0).sum()),
    "total_alien_records": int(df["n.total"].sum()),
    "chi2_pooled": {"chi2": round(chi2, 2), "df": int(dof), "p": float(p_chi),
                    "min_expected": round(float(exp2.min()), 2)},
    "permutation": {"chi2_obs": round(obs, 2), "p": float(p_perm), "n_perm": n_perm},
    "low_evidence_habitats": low_ev,
    "counting_semantics_note": "n.* are per-plot integer counts; semantics "
    "(distinct species vs occurrences; multi-pathway assignment) undocumented",
}
with open(f"{OUT}/diagnostics.json", "w") as f:
    json.dump(diag, f, indent=2)
print("\nArtifacts written:", diag)
