# urban deltas (urban-specific change, replacing the mixed 'progressive' column)
plots['d_urban_56_09_50']  = plots['urban_2009_50m']  - plots['urban_1956_50m']
plots['d_urban_93_09_50']  = plots['urban_2009_50m']  - plots['urban_1993_50m']
plots['d_urban_56_09_1000']= plots['urban_2009_1000m']- plots['urban_1956_1000m']
plots['d_urban_93_09_1000']= plots['urban_2009_1000m']- plots['urban_1993_1000m']
