# ---------------- PART 1: temporal context ----------------
print('\n' + '='*80); print('PART 1 - TEMPORAL TRENDS IN INTRODUCTION PATHWAYS')
print('='*80)
tt = temporal.pivot(index='introduction.period', columns='pathway', values='n')
tt = tt[['AgriForest','Gardening','Unintentional']]
tt['total'] = tt.sum(axis=1)
print(tt)
