chi2, p, dof, _ = stats.chi2_contingency(temporal.pivot(index='pathway', columns='introduction.period', values='n'))
print(f'  chi2={chi2:.1f}, dof={dof}, p={p:.2e}')

# ---------------- PART 2: species-level checks ----------------
print('\n' + '='*80); print('PART 2 - SPECIES-LEVEL (invasion_success_pathways.csv)')
print('='*80)
dup = species[species.duplicated]
print('Duplicated (2nd-pathway) entries:')
print(dup[['Scientific_name','intro.pathway','number.of.invaded.plots','area.of.occupancy.10km','phylo.tip.label']])
# verify the paired rows are identical in success metrics
pairs = species[species.Scientific_name.isin(dup.Scientific_name)]
g = pairs.groupby('Scientific_name')[['number.of.invaded.plots','area.of.occupancy.10km','habitat.range','invaded.niche.breadth','mrt']].nunique()
print('n unique success values within each duplicated species (1 => identical rows):')
print(g)
sp_dedup = species.drop_duplicates('Scientific_name').copy()
print(f'Dedup rule: keep one row per species ({len(species)} -> {len(sp_dedup)}) since success metrics are identical across pathway rows; '
      f'pathway for analysis taken from the retained (first) row.')

print('\nPathway means (dedup):')
print(sp_dedup.groupby('intro.pathway')[['number.of.invaded.plots','area.of.occupancy.10km','habitat.range','invaded.niche.breadth','mrt']].mean().round(2))

# Poisson / NB GLM: invasion success ~ pathway, controlling for mrt
sp = sp_dedup.copy()
sp['pathway'] = pd.Categorical(sp['intro.pathway'], categories=['Gardening','Unintentional','AgriForest'])
for resp in ['number.of.invaded.plots','area.of.occupancy.10km']:
    d2 = pd.DataFrame({'path': sp['pathway'].astype(str).values, 'mrt': sp['mrt'].astype(float).values,
                       'y': sp[resp].astype(float).values})
    X = pd.DataFrame({'const':1.0,
                      'path_Unintentional':(d2.path=='Unintentional').astype(float),
                      'path_AgriForest':(d2.path=='AgriForest').astype(float),
                      'mrt':d2.mrt})
    y = d2.y
    pois = sm.GLM(y, X, family=sm.families.Poisson()).fit()
    nb   = sm.NegativeBinomial(y, X).fit(disp=0)
    alpha = nb.params.iloc[-1]
    nbb   = sm.GLM(y, X, family=sm.families.NegativeBinomial(alpha=alpha)).fit()
    print(f'\nGLM ({resp}) ~ pathway + mrt  [NB alpha={alpha:.2f}]')
    coef = nbb.params.drop('const'); ci = nbb.conf_int().loc[coef.index]
    out = pd.DataFrame({'coef': coef.round(3), 'CI2.5': ci[0].round(3), 'CI97.5': ci[1].round(3), 'p': nbb.pvalues[coef.index].round(4)})
    print(out)
# niche breadth (Gaussian)
sp2 = sp.rename(columns={'invaded.niche.breadth':'niche_breadth'})
m = smf.ols('niche_breadth ~ C(intro_pathway, Treatment("Gardening")) + mrt', data=sp2.rename(columns={'intro.pathway':'intro_pathway'})).fit()
print('\nOLS invaded_niche_breadth ~ pathway + mrt')
print(m.params.round(3).to_dict()); print('R2 =', round(m.rsquared,3))

# ---------------- PART 3: plot-level composition models ----------------
print('\n' + '='*80); print('PART 3 - PLOT-LEVEL PATHWAY COMPOSITION (invaded_niche_pathways.csv)')
print('='*80)
sub = plots[plots.n_total > 0].copy()
print(f'plots with >=1 non-native species: {len(sub)} / {len(plots)}')
long = []
path_cols = {'n_gard':'Gardening','n_unint':'Unintentional','n_agfo':'AgriForest'}
for col, name in path_cols.items():
    tmp = sub[['habitat','elevation','annual_temperature','annual_rainfall','distance_road',
               'urban_2009_50m','urban_2009_1000m','urban_1956_50m','urban_1993_50m',
