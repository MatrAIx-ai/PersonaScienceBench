# change-class anomaly rows
ch56 = plots[['progressive_1956_2009_50m','regressive_1956_2009_50m','no_changes_1956_2009_50m']].sum(axis=1)
ch93 = plots[['progressive_1993_2009_50m','regressive_1993_2009_50m','no_changes_1993_2009_50m']].sum(axis=1)
bad = (ch56 <= 0.02) | (ch93 <= 0.02)
