                   'd_crop_56_09_50','n_total','bad_change','count']
    tmp['pathway'] = name
    long.append(tmp)
L = pd.concat(long).reset_index(drop=True)
L['pathway'] = pd.Categorical(L['pathway'], categories=['Gardening','Unintentional','AgriForest'])

def run_composition(predictor, data, label):
    d = data.dropna(subset=[predictor]).reset_index(drop=True).copy()
    d['urban'] = d[predictor].astype(float)
    X = pd.DataFrame({'const':1.0,
                      'unint':(d.pathway=='Unintentional').astype(float).values,
                      'agfo':(d.pathway=='AgriForest').astype(float).values,
                      'urban':d['urban'].values,
                      'unint_x_urban':((d.pathway=='Unintentional').astype(float).values*d['urban'].values),
                      'agfo_x_urban':((d.pathway=='AgriForest').astype(float).values*d['urban'].values),
                      'elev':(d['elevation'].values/100.0), 'temp':d['temp'].values, 'rain':(d['rain'].values/100.0)})
    # habitat dummies (baseline = Urban)
    for h in [h for h in d.habitat.unique() if h!='Urban']:
        X[f'hab_{h}'] = (d.habitat==h).astype(float).values
    y = d['count'].astype(float); off = np.log(d['n_total'])
    pois = sm.GLM(y, X, family=sm.families.Poisson(), offset=off).fit()
    disp = pois.pearson_chi2/pois.df_resid
    nb = sm.GLM(y, X, family=sm.families.NegativeBinomial(alpha=max(disp,0.01)), offset=off).fit()
    print(f'\n--- Composition NB-GLM, predictor = {predictor} ({label}) | Poisson overdispersion={disp:.2f} ---')
    ix = ['unint_x_urban','agfo_x_urban','urban']
    ci = nb.conf_int().loc[ix]
    print(pd.DataFrame({'coef':nb.params[ix].round(3),'CI2.5':ci[0].round(3),'CI97.5':ci[1].round(3),'p':nb.pvalues[ix].round(4)}))
    return nb

for pred, lab in [('u09_50','urban cover 2009, 50m buffer'), ('u09_1000','urban cover 2009, 1000m buffer'),
                  ('d_urban_56_09_50','urban change 1956->2009, 50m'), ('d_urban_93_09_50','urban change 1993->2009, 50m'),
                  ('d_urban_93_09_1000','urban change 1993->2009, 1000m')]:
    run_composition(pred, L, lab)

# sensitivity: exclude anomalous change rows
print('\n--- SENSITIVITY: excluding rows with all change-class proportions = 0 ---')
run_composition('d_urban_56_09_50', L[~L.bad_change], 'urban change 1956->2009 50m, anomalies excluded')
run_composition('u09_50', L[~L.bad_change], 'urban 2009 50m, anomalies excluded')

# presence/absence logistic on ALL plots (does urban promote presence of gardening species?)
print('\n--- Presence/absence logistic GLMs (all 632 plots, pathway presence ~ urban) ---')
for col, name in path_cols.items():
    plots['pres'] = (plots[col]>0).astype(int)
    X = sm.add_constant(pd.DataFrame({'urban':plots['urban_2009_50m'],
                                      'elev':plots['elevation']/100., 'temp':plots['annual_temperature'],
                                      'rain':plots['annual_rainfall']/100.}))
    for h in [h for h in plots.habitat.unique() if h!='Urban']:
        X[f'hab_{h}'] = (plots.habitat==h).astype(float)
    logit = sm.GLM(plots['pres'], X, family=sm.families.Binomial()).fit()
    b, se = logit.params['urban'], logit.bse['urban']
    orr = np.exp(b); ci = np.exp([b-1.96*se, b+1.96*se])
    print(f'{name:15s} OR(urban2009 50m)={orr:.2f}  95%CI [{ci[0]:.2f},{ci[1]:.2f}]  p={logit.pvalues["urban"]:.4f}')

# ---------------- PART 4: pathway composition by habitat ----------------
print('\n' + '='*80); print('PART 4 - PATHWAY SHARES BY HABITAT')
print('='*80)
agg = plots.groupby('habitat')[['n_gard','n_unint','n_agfo','n_total']].sum()
agg['gard_share'] = (agg.n_gard/agg.n_total*100).round(1)
agg['unint_share'] = (agg.n_unint/agg.n_total*100).round(1)
agg['agfo_share'] = (agg.n_agfo/agg.n_total*100).round(1)
print(agg[['n_gard','n_unint','n_agfo','n_total','gard_share','unint_share','agfo_share']])
overall_gard = plots.n_gard.sum()/plots.n_total.sum()
print(f'\nOverall gardening share: {overall_gard*100:.1f}%')
for h in ['Urban','Riparian','Coastal','Wetlands','Croplands']:
    k, n = agg.loc[h,'n_gard'], agg.loc[h,'n_total']
    ci = stats.binomtest(int(k), int(n), overall_gard).proportion_ci(0.95)
    p = stats.binomtest(int(k), int(n), overall_gard).pvalue
    print(f'{h:22s} gardening share {k}/{n} = {k/n*100:.1f}%  95%CI[{ci.low*100:.1f},{ci.high*100:.1f}]  p_vs_overall={p:.4f}')

