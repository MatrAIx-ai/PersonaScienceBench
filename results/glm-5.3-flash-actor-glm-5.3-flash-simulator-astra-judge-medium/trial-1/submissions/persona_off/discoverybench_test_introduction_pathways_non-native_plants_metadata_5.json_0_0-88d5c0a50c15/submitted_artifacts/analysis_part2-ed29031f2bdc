"""Follow-up diagnostics: effect sizes for the urban->pathway scenario."""
import numpy as np, pandas as pd, statsmodels.api as sm
from scipy import stats
import warnings; warnings.filterwarnings('ignore')

plots = pd.read_csv('data/invaded_niche_pathways.csv', sep='\t')
plots.columns = [c.replace('.','_') for c in plots.columns]
plots['habitat'] = plots['habitat'].str.strip()
plots['d_urban_93_09_1000'] = plots['urban_2009_1000m'] - plots['urban_1993_1000m']
plots['d_urban_56_09_1000'] = plots['urban_2009_1000m'] - plots['urban_1956_1000m']
ch93 = plots[['progressive_1993_2009_50m','regressive_1993_2009_50m','no_changes_1993_2009_50m']].sum(axis=1)
bad = ch93 <= 0.02

print('--- Raw contrasts: mean pathway counts by urban-cover quartiles (2009, 1000m) ---')
q = pd.qcut(plots['urban_2009_1000m'], 4, labels=['Q1_low','Q2','Q3','Q4_high'])
print(plots.groupby(q, observed=True)[['n_gard','n_unint','n_agfo','n_total']].mean().round(3))
print('\n--- Mean pathway counts by urbanization delta (1993->2009, 1000m): top vs bottom tercile ---')
terc = pd.qcut(plots['d_urban_93_09_1000'], 3, labels=['low','mid','high'])
print(plots.groupby(terc, observed=True)[['n_gard','n_unint','n_agfo','n_total']].mean().round(3))

print('\n--- Presence/absence logistic (all 632 plots) at the 1000m scale ---')
for col, name in [('n_gard','Gardening'),('n_unint','Unintentional'),('n_agfo','AgriForest')]:
    for pred in ['urban_2009_1000m','d_urban_93_09_1000']:
        plots['pres'] = (plots[col]>0).astype(int)
        X = sm.add_constant(pd.DataFrame({'u':plots[pred],'elev':plots['elevation']/100.,
                                          'temp':plots['annual_temperature'],'rain':plots['annual_rainfall']/100.}))
        for h in [h for h in plots.habitat.unique() if h!='Urban']:
            X[f'hab_{h}'] = (plots.habitat==h).astype(float).values
        m = sm.GLM(plots['pres'], X, family=sm.families.Binomial()).fit()
        b, se = m.params['u'], m.bse['u']
        print(f'{name:15s} {pred:22s} OR={np.exp(b):.2f} CI[{np.exp(b-1.96*se):.2f},{np.exp(b+1.96*se):.2f}] p={m.pvalues["u"]:.4f}')

print('\n--- Per-pathway NB count GLMs (all 632 plots, count ~ urban + covariates) ---')
for col, name in [('n_gard','Gardening'),('n_unint','Unintentional'),('n_agfo','AgriForest')]:
    for pred in ['urban_2009_1000m','d_urban_93_09_1000']:
        y = plots[col].astype(float)
        X = sm.add_constant(pd.DataFrame({'u':plots[pred],'elev':plots['elevation']/100.,
                                          'temp':plots['annual_temperature'],'rain':plots['annual_rainfall']/100.}))
        for h in [h for h in plots.habitat.unique() if h!='Urban']:
            X[f'hab_{h}'] = (plots.habitat==h).astype(float).values
        pois = sm.GLM(y, X, family=sm.families.Poisson()).fit(); disp = pois.pearson_chi2/pois.df_resid
        nb = sm.GLM(y, X, family=sm.families.NegativeBinomial(alpha=max(disp,0.01))).fit()
        b, se = nb.params['u'], nb.bse['u']
        irr = np.exp(b); ci = np.exp([b-1.96*se, b+1.96*se])
        print(f'{name:15s} {pred:22s} IRR={irr:.2f} CI[{ci[0]:.2f},{ci[1]:.2f}] p={nb.pvalues["u"]:.4f}')

print('\n--- Sensitivity: key model (unint x urban delta 93-09, 1000m) excluding anomalous change rows ---')
sub = plots[(plots.n_total>0) & ~bad]
long = []
for col, name in [('n_gard','Gardening'),('n_unint','Unintentional'),('n_agfo','AgriForest')]:
    t = sub[['habitat','elevation','annual_temperature','annual_rainfall','d_urban_93_09_1000','urban_2009_1000m','n_total',col]].copy()
    t.columns = ['habitat','elevation','temp','rain','delta','u','n_total','count']; t['pathway']=name; long.append(t)
L = pd.concat(long).reset_index(drop=True)
X = pd.DataFrame({'const':1.0,
                  'unint':(L.pathway=='Unintentional').astype(float).values,
                  'agfo':(L.pathway=='AgriForest').astype(float).values,
                  'u':L['u'].values, 'delta':L['delta'].values,
                  'unint_x_delta':((L.pathway=='Unintentional').astype(float).values*L['delta'].values),
                  'agfo_x_delta':((L.pathway=='AgriForest').astype(float).values*L['delta'].values),
                  'elev':L['elevation'].values/100., 'temp':L['temp'].values, 'rain':L['rain'].values/100.})
for h in [h for h in L.habitat.unique() if h!='Urban']:
    X[f'hab_{h}'] = (L.habitat==h).astype(float).values
pois = sm.GLM(L['count'], X, family=sm.families.Poisson(), offset=np.log(L['n_total'])).fit()
disp = pois.pearson_chi2/pois.df_resid
nb = sm.GLM(L['count'], X, family=sm.families.NegativeBinomial(alpha=max(disp,0.01)), offset=np.log(L['n_total'])).fit()
ix = ['unint_x_delta','agfo_x_delta','delta','u']
ci = nb.conf_int().loc[ix]
print(pd.DataFrame({'coef':nb.params[ix].round(3),'CI2.5':ci[0].round(3),'CI97.5':ci[1].round(3),'p':nb.pvalues[ix].round(4)}))
print(f'(excluded {bad.sum()} anomalous rows; {len(sub)//3*3} long-format rows retained... n plots = {len(sub)})')

print('\n--- Robustness: same composition model using 1956->2009 delta at 1000m ---')
plots['d_urban_56_09_1000_alt'] = plots['d_urban_56_09_1000']
sub = plots[plots.n_total>0]
long = []
for col, name in [('n_gard','Gardening'),('n_unint','Unintentional'),('n_agfo','AgriForest')]:
    t = sub[['habitat','elevation','annual_temperature','annual_rainfall','urban_2009_1000m','d_urban_56_09_1000','n_total',col]].copy()
    t.columns = ['habitat','elevation','temp','rain','u','delta','n_total','count']; t['pathway']=name; long.append(t)
L = pd.concat(long).reset_index(drop=True)
X = pd.DataFrame({'const':1.0,'unint':(L.pathway=='Unintentional').astype(float).values,
                  'agfo':(L.pathway=='AgriForest').astype(float).values,
                  'u':L['u'].values,'delta':L['delta'].values,
                  'unint_x_delta':((L.pathway=='Unintentional').astype(float).values*L['delta'].values),
                  'agfo_x_delta':((L.pathway=='AgriForest').astype(float).values*L['delta'].values),
                  'elev':L['elevation'].values/100.,'temp':L['temp'].values,'rain':L['rain'].values/100.})
for h in [h for h in L.habitat.unique() if h!='Urban']:
    X[f'hab_{h}'] = (L.habitat==h).astype(float).values
pois = sm.GLM(L['count'], X, family=sm.families.Poisson(), offset=np.log(L['n_total'])).fit()
disp = pois.pearson_chi2/pois.df_resid
nb = sm.GLM(L['count'], X, family=sm.families.NegativeBinomial(alpha=max(disp,0.01)), offset=np.log(L['n_total'])).fit()
ix = ['unint_x_delta','agfo_x_delta','delta','u']
ci = nb.conf_int().loc[ix]
print(pd.DataFrame({'coef':nb.params[ix].round(3),'CI2.5':ci[0].round(3),'CI97.5':ci[1].round(3),'p':nb.pvalues[ix].round(4)}))

print('\n--- Gardening share in plots that urbanized most (delta 93-09 1000m > 0.2) vs unchanged ---')
hi = plots[plots.d_urban_93_09_1000 > 0.2]; lo = plots[plots.d_urban_93_09_1000 == 0]
for nm, d in [('urbanized plots', hi), ('unchanged plots', lo)]:
    tot = d[['n_gard','n_unint','n_agfo']].sum().sum()
    print(f'{nm}: n={len(d)}, records={int(tot)}, gard share={d.n_gard.sum()/tot*100:.1f}%, unint share={d.n_unint.sum()/tot*100:.1f}%')
