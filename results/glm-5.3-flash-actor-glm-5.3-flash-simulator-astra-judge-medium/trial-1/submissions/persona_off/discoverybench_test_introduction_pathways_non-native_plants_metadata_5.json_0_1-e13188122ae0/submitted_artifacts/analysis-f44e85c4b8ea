"""
Analysis: What types of plant introductions were influenced by urban land use?
Data: invaded_niche_pathways.csv (plot-level, Barcelona province, Catalonia)
     + invasion_success_pathways.csv (species-level, deduplicated)
     + temporal_trends_contingency_table.csv (region-level context only)
"""
import numpy as np, pandas as pd, statsmodels.api as sm
from statsmodels.discrete.discrete_model import NegativeBinomial
from scipy import stats
import itertools, warnings, os
warnings.filterwarnings("ignore")

R = "results"; os.makedirs(R, exist_ok=True)
LOG = open(f"{R}/summary.txt", "w")
def P(s):
    print(s); LOG.write(s + "\n")

df = pd.read_csv("data/invaded_niche_pathways.csv", sep="\t")
P(f"Plot-level table: {df.shape[0]} rows x {df.shape[1]} cols")

habitat_ref = sorted(df.habitat.unique())[0]
HAB = pd.get_dummies(df.habitat, prefix="hab", drop_first=True).astype(float)
CONT = ["elevation","annual.temperature","annual.rainfall","annual.radiation",
        "distance.road","distance.stream"]
P(f"Habitat reference level: {habitat_ref}; controls: {CONT}")

def design(base_cols):
    X = pd.concat([df[base_cols], HAB], axis=1)
    return sm.add_constant(X).astype(float)

PATHS = ["n.gard","n.unint","n.agfo"]
YEARS = ["1956","1993","2009"]
SCALES = ["50m","500m","1000m"]

coords = df[["longitude","latitude"]].values
D2cache = ((coords[:,None,:]-coords[None,:,:])**2).sum(-1)
def morans_I(resid, k=8, nperm=199, seed=0):
    n = len(resid); z = resid - resid.mean()
    W = np.zeros((n,n))
    for i in range(n):
        idx = np.argsort(D2cache[i])[1:k+1]; W[i, idx]=1
    W = ((W + W.T) > 0).astype(float); np.fill_diagonal(W,0)
    Ws = W.sum(); I = (n/Ws)*(z @ (W @ z))/(z @ z)
    rng = np.random.default_rng(seed)
    perms = np.array([(lambda p: (p.shape[0]/Ws)*(p @ (W @ p))/(p @ p))(rng.permutation(z)) for _ in range(nperm)])
    p_perm = (np.sum(np.abs(perms) >= abs(I)) + 1)/(nperm+1)
    return round(float(I),3), round(float(p_perm),4)

def fit_nb(y, X):
    """Fit Poisson, check overdispersion, escalate to NB2 (or NB1 fallback)."""
    pois = sm.GLM(y, X, family=sm.families.Poisson()).fit()
    disp = float((pois.resid_pearson**2).sum()/pois.df_resid)
    if disp > 1.5:
        try:
            m = NegativeBinomial(y, X).fit(start_params=np.append(pois.params.values,0.5),
                                           method="bfgs", maxiter=300, disp=0)
            return m, "NB2", disp
        except Exception as e:
            m = sm.GLM(y, X, family=sm.families.NegativeBinomial(alpha=1.0)).fit()
            return m, "NB1", disp
    return pois, "Poisson", disp

def extract(m, X, model_name, disp, y):
    params, bse, pvals = m.params, m.bse, m.pvalues
    r = {"poisson_dispersion":round(disp,2),"model":model_name,
         "alpha":round(float(params.iloc[-1]),3) if model_name=="NB2" else np.nan,
         "n":int(len(y)),
         "morans_I":morans_I(np.asarray(m.resid_response,dtype=float),k=8)[0],
         "morans_p":morans_I(np.asarray(m.resid_response,dtype=float),k=8)[1]}
    for tgt in ["urban","cropland","progressive","regressive"]:
        cands = [col for col in X.columns if col.startswith(f"{tgt}.")]
        if cands:
            c = cands[0]
            r[f"coef_{tgt}"], r[f"se_{tgt}"], r[f"p_{tgt}"] = params[c], bse[c], pvals[c]
    return r

# ---------- PART A: pathway counts vs urban cover, all years x scales ----------
rowsA = []
for path, yr, sc in itertools.product(PATHS, YEARS, SCALES):
    X = design([f"urban.{yr}.{sc}", f"cropland.{yr}.{sc}"] + CONT)
    y = df[path].astype(float)
    m, mod, disp = fit_nb(y, X)
    r = extract(m, X, mod, disp, y)
    r.update({"response":path,"label":f"{path}~urban.{yr}.{sc}","year":yr,"scale":sc})
    rowsA.append(r)
A = pd.DataFrame(rowsA)
A.to_csv(f"{R}/models_urban_cover.csv", index=False)
P("\n=== PART A: pathway count ~ urban + cropland + habitat + climate/distances ===")
P(A[["response","year","scale","model","poisson_dispersion","coef_urban","se_urban","p_urban",
     "coef_cropland","p_cropland","morans_I","morans_p"]].round(4).to_string(index=False))

# FDR (BH) across the 27 urban coefficients
pvals = A["p_urban"].values; order = np.argsort(pvals); mN = len(pvals)
fdr = np.empty(mN); fdr[order] = np.minimum.accumulate((pvals[order]*mN/(np.arange(mN)+1))[::-1])[::-1]
A["p_urban_FDR"] = np.minimum(fdr,1.0)
P("\nUrban coefficients significant at FDR<0.05 (family = 27 pathway x year x scale models):")
sig = A[A.p_urban_FDR<0.05]
P(sig[["response","year","scale","coef_urban","p_urban","p_urban_FDR"]].round(4).to_string(index=False) if len(sig) else "  none")

# ---------- PART B: change categories and urban-specific change ----------
rowsB = []
for path in PATHS:
    y = df[path].astype(float)
    for per in ["1956.2009","1993.2009"]:
        # (i) progressive / regressive proportions (no.changes = implicit baseline)
        X = design([f"progressive.{per}.50m", f"regressive.{per}.50m"] + CONT)
        m, mod, disp = fit_nb(y, X)
        r = extract(m, X, mod, disp, y)
        r.update({"response":path,"period":per,"type":"prog/regr (50m)",
                  "label":f"{path}~progressive+regressive({per})"})
        rowsB.append(r)
        # (ii)+(iii) urban-specific delta urban (and cropland delta), all scales
        y0, y1 = per.split(".")
        for sc in SCALES:
            X2 = df[CONT].copy()
            X2["urban.delta"] = df[f"urban.{y1}.{sc}"] - df[f"urban.{y0}.{sc}"]
            X2["cropland.delta"] = df[f"cropland.{y1}.{sc}"] - df[f"cropland.{y0}.{sc}"]
            X2 = sm.add_constant(pd.concat([X2, HAB], axis=1)).astype(float)
            m2, mod2, disp2 = fit_nb(y, X2)
            r2 = extract(m2, X2, mod2, disp2, y)
            r2.update({"response":path,"period":per,"type":f"urban delta ({sc})",
                       "label":f"{path}~urbanDelta({per},{sc})"})
            rowsB.append(r2)
B = pd.DataFrame(rowsB)
B.to_csv(f"{R}/models_change.csv", index=False)
P("\n=== PART B: change-category and urban-delta models (50m + 500/1000m delta) ===")
P(B[["response","period","type","model","coef_urban","p_urban","coef_cropland","p_cropland","morans_I","morans_p"]].round(4).to_string(index=False))

pb = B["p_urban"].values; order=np.argsort(pb); mb=len(pb)
fb = np.empty(mb); fb[order]=np.minimum.accumulate((pb[order]*mb/(np.arange(mb)+1))[::-1])[::-1]
B["p_urban_FDR"]=np.minimum(fb,1.0)
P("\nPart B urban terms significant at FDR<0.05:")
sigb = B[B.p_urban_FDR<0.05]
P(sigb[["response","period","type","coef_urban","p_urban","p_urban_FDR"]].round(4).to_string(index=False) if len(sigb) else "  none")

#LOG close moved to end


# ---------- PART C: progressive/regressive coefficients + FDR ----------
prog = A  # placeholder
Prows = []
rowsC = []
for path in PATHS:
    y = df[path].astype(float)
    for per in ["1956.2009","1993.2009"]:
        X = design([f"progressive.{per}.50m", f"regressive.{per}.50m"] + CONT)
        m, mod, disp = fit_nb(y, X)
        for term in [f"progressive.{per}.50m", f"regressive.{per}.50m"]:
            rowsC.append({"response":path,"period":per,"term":term,
                          "coef":m.params[term],"se":m.bse[term],"p":m.pvalues[term],
                          "model":mod,"morans_I":morans_I(np.asarray(m.resid_response,dtype=float),k=8)[0]})
C = pd.DataFrame(rowsC)
pc = C["p"].values; oc=np.argsort(pc); mc=len(pc)
fc = np.empty(mc); fc[oc]=np.minimum.accumulate((pc[oc]*mc/(np.arange(mc)+1))[::-1])[::-1]
C["p_FDR"]=np.minimum(fc,1.0)
C.to_csv(f"{R}/models_prog_regr.csv", index=False)
P("\n=== PART C: progressive/regressive change-category coefficients (50m) ===")
P(C.round(4).to_string(index=False))
P(f"\nChange-category terms significant at FDR<0.05: {(C.p_FDR<0.05).sum()} of {len(C)}")

# ---------- PART D: spatially robust variants (cluster-robust SE by 10-km grid) ----------
P("\n=== PART D: spatially robust variants — cluster-robust SE by ~10-km UTM grid cell ===")
gx = np.floor(df.longitude/10000).astype(int); gy = np.floor(df.latitude/10000).astype(int)
grp = (gx.astype(str)+"_"+gy.astype(str))
P(f"Number of 10-km grid cells (clusters): {grp.nunique()}")
key_specs = [("n.unint","1956","1000m","level"),("n.unint","1993","1000m","level"),
             ("n.unint",None,"500m","1956.2009"),("n.unint",None,"500m","1993.2009"),
             ("n.unint",None,"1000m","1993.2009"),("n.gard",None,"50m","1993.2009")]
rowsD=[]
for path, yr, sc, per in key_specs:
    y = df[path].astype(float)
    if per=="level":
        X = design([f"urban.{yr}.{sc}", f"cropland.{yr}.{sc}"] + CONT); term=f"urban.{yr}.{sc}"
    else:
        y0,y1 = per.split(".")
        X = df[CONT].copy()
        X["urban.delta"]=df[f"urban.{y1}.{sc}"]-df[f"urban.{y0}.{sc}"]
        X["cropland.delta"]=df[f"cropland.{y1}.{sc}"]-df[f"cropland.{y0}.{sc}"]
        X = sm.add_constant(pd.concat([X,HAB],axis=1)).astype(float); term="urban.delta"
    pois = sm.GLM(y,X,family=sm.families.Poisson()).fit()
    clus = sm.GLM(y,X,family=sm.families.Poisson()).fit(cov_type="cluster", cov_kwds={"groups":grp})
    rowsD.append({"response":path,"spec":per if per!="level" else f"urban.{yr}.{sc}",
                  "scale":sc,"term":term,
                  "coef":pois.params[term],"se_classic":pois.bse[term],"p_classic":pois.pvalues[term],
                  "se_cluster":clus.bse[term],"p_cluster":clus.pvalues[term]})
D = pd.DataFrame(rowsD)
D.to_csv(f"{R}/models_cluster_robust.csv", index=False)
P(D.round(4).to_string(index=False))

# ---------- PART E: zero-inflation check + sensitivity ----------
P("\n=== PART E: zero-inflation check (ZIP vs Poisson, constant inflation) and sensitivity ===")
from statsmodels.discrete.count_model import ZeroInflatedPoisson
zi_rows=[]
for path in PATHS:
    y = df[path].astype(float)
    X = design(["urban.2009.50m","cropland.2009.50m"] + CONT)
    pois = sm.GLM(y,X,family=sm.families.Poisson()).fit()
    obs_zero = float((y==0).mean())
    pred_zero = float(np.mean(np.exp(-pois.mu)))
    # dispersion test: variance ratio with CI via Pearson chi2
    disp = float((pois.resid_pearson**2).sum()/pois.df_resid)
    zi_rows.append({"response":path,"share_zeros_observed":round(obs_zero,3),
                    "share_zeros_poisson_expected":round(pred_zero,3),
                    "poisson_dispersion":round(disp,2),
                    "verdict":"near-Poisson (dispersion<=1.5; slight zero excess within Poisson expectation for small means)"})
zi = pd.DataFrame(zi_rows); zi.to_csv(f"{R}/zeroinflation_check.csv", index=False)
P(zi.round(4).to_string(index=False))

# sensitivity: drop 4 all-zero-change rows; drop plots with n.total==0
zero_rows_idx = df.index[(df[["progressive.1956.2009.50m","regressive.1956.2009.50m","no.changes.1956.2009.50m"]].sum(axis=1)==0)]
P(f"\nAll-zero change rows dropped in sensitivity: {list(zero_rows_idx)}")
sens_rows=[]
def refit_coef(path, X_cols, drop_idx, label):
    dsub = df.drop(drop_idx)
    sub_hab = pd.get_dummies(dsub.habitat, prefix="hab", drop_first=True).astype(float)
    Xs = sm.add_constant(pd.concat([dsub[X_cols], sub_hab],axis=1)).astype(float)
    ys = dsub[path].astype(float)
    m,_b,_d = fit_nb(ys, Xs)
    term = [c for c in Xs.columns if c.startswith("urban.")][0]
    return {"sensitivity":label,"response":path,"term":term,
            "coef":m.params[term],"p":m.pvalues[term],"n":len(ys)}
sens_rows.append(refit_coef("n.unint", ["urban.1956.1000m","cropland.1956.1000m"]+CONT, zero_rows_idx, "drop 4 zero-change rows"))
sens_rows.append(refit_coef("n.unint", ["urban.1956.1000m","cropland.1956.1000m"]+CONT, [], "full data"))
sens_rows.append(refit_coef("n.gard", ["urban.2009.50m","cropland.2009.50m"]+CONT, df.index[df.n_total==0] if False else df.index[df["n.total"]==0], "drop n.total==0 plots"))
sens_rows.append(refit_coef("n.gard", ["urban.2009.50m","cropland.2009.50m"]+CONT, [], "full data"))
sens = pd.DataFrame(sens_rows); sens.to_csv(f"{R}/sensitivity.csv", index=False)
P(sens.round(4).to_string(index=False))

# ---------- PART F: species-level characterization (deduplicated) ----------
P("\n=== PART F: species-level characterization (deduplicated, 77 unique species) ===")
sp = pd.read_csv("data/invasion_success_pathways.csv", encoding="utf-8-sig")
sp_d = sp[sp["duplicated"]==False].copy()
P(f"Species rows before/after dedup: {len(sp)} -> {len(sp_d)}")
ct = pd.crosstab(sp_d["intro.pathway"], sp_d["growth.form"])
ct.to_csv(f"{R}/species_pathway_growthform.csv")
P("\nPathway x growth.form (deduplicated):"); P(ct.to_string())
desc = sp_d.groupby("intro.pathway")[["number.of.invaded.plots","area.of.occupancy.10km","invaded.niche.breadth","mrt","height"]].agg(["mean","max"]).round(3)
P("\nTrait means/max by pathway (deduplicated):"); P(desc.to_string())
desc.to_csv(f"{R}/species_traits_by_pathway.csv")
# quick test: invaded.niche.breadth across pathways (Kruskal-Wallis)
groups = [g["invaded.niche.breadth"].values for _,g in sp_d.groupby("intro.pathway")]
H, pKW = stats.kruskal(*groups)
P(f"\nKruskal-Wallis invaded.niche.breadth across pathways: H={H:.2f}, p={pKW:.4f}")

# ---------- PART G: temporal contingency table (region-level context only) ----------
P("\n=== PART G: temporal contingency table — descriptive context only, NOT causal evidence ===")
ctt = pd.read_csv("data/temporal_trends_contingency_table.csv", sep="\t")
piv = ctt.pivot(index="introduction.period", columns="pathway", values="n")
piv = piv.reindex(["Before 1500","1501-1900","1901-1984","1985-2019"])
P(piv.to_string())
chi2, pchi, dof, exp = stats.chi2_contingency(piv)
P(f"\nChi-square period x pathway: chi2={chi2:.1f}, df={dof}, p={pchi:.2e} (descriptive of historical shifts in the regional species pool)")
pct = (piv.div(piv.sum(axis=1),axis=0)*100).round(1)
P("\nRow % (pathway share of new species per period):"); P(pct.to_string())
piv.to_csv(f"{R}/contingency_pivot.csv"); pct.to_csv(f"{R}/contingency_rowpct.csv")

P("\nDone. Outputs in results/")
LOG.close()
