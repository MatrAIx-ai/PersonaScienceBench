"""
How did urban land use affect the invasion of different types of introduced plants?
Full executed analysis:
  (a) descriptives: habitat x pathway table, temporal 4x3 chi-square trend test
  (b) per-pathway hurdle GLMs (logistic presence + NB count|presence), urban/cropland
      at 500m (1000m comparison), progressive/regressive/no-changes categories
  (c) species-level NB model with pathway x mrt, genus-cluster-robust SEs
  (d) VIF and overdispersion diagnostics
Assumptions (confirmed by researcher): cover columns are 0-1 proportions; plots are
independent (spatial autocorrelation acknowledged); 4 duplicated species rows are
multi-pathway records (deduplicated for species models); 5 anomalous change rows
excluded from change-category models only; correlational interpretation.
"""
import pandas as pd, numpy as np, json, warnings
from scipy import stats
import statsmodels.api as sm
from statsmodels.stats.outliers_influence import variance_inflation_factor
warnings.filterwarnings('ignore')

OUT = {}
def sect(t): print("\n" + "="*70 + f"\n{t}\n" + "="*70)

tt  = pd.read_csv('data/temporal_trends_contingency_table.csv', sep='\t')
isv = pd.read_csv('data/invasion_success_pathways.csv')
inp = pd.read_csv('data/invaded_niche_pathways.csv', sep='\t')
print("loaded:", tt.shape, isv.shape, inp.shape)

def prune(Xdf):
    """drop zero-variance and rank-deficient columns; ALWAYS keep the intercept"""
    cols = list(Xdf.columns); keep = []
    for c in cols:
        if c == 'const': keep.append(c); continue
        v = Xdf[c].values
        if np.ptp(v) == 0: continue
        trial = keep + [c]
        if np.linalg.matrix_rank(Xdf[trial].values) == len(trial): keep.append(c)
    return Xdf[keep]

def fit_logit(y, X):
    Xp = prune(X)
    return sm.GLM(y, Xp, family=sm.families.Binomial()).fit(cov_type='HC1')

def fit_nb(y, X):
    Xp = prune(X)
    pois = sm.GLM(y, Xp, family=sm.families.Poisson()).fit()
    mu = pois.fittedvalues
    alpha = max(((y-mu)**2/mu).sum()/(len(y)-Xp.shape[1]), 1e-3)
    m = sm.GLM(y, Xp, family=sm.families.NegativeBinomial(alpha=alpha)).fit(cov_type='HC1')
    m._alpha = alpha
    return m

# ================= (a) DESCRIPTIVES =================
sect("A1. Temporal 4x3 contingency table + trend test")
tab = tt.pivot(index='introduction.period', columns='pathway', values='n').loc[
      ['Before 1500','1501-1900','1901-1984','1985-2019']]
print(tab)
chi2, p, dof, exp = stats.chi2_contingency(tab)
print(f"chi-square = {chi2:.2f}, dof = {dof}, p = {p:.3e}")
x = np.array([0,1,2,3])
for pw in tab.columns:
    yv = tab[pw].values; tot = yv.sum()
    sl = stats.linregress(x, yv/tot*100)
    print(f"  {pw:14s} share: {np.round(yv/tot*100,1)} ; trend {sl.slope:+.1f} pp/period (p={sl.pvalue:.4f})")
OUT['temporal_chi2'] = {'chi2': chi2, 'p': p, 'dof': dof, 'table': tab.to_dict()}

sect("A2. Habitat-level pathway counts")
hab_mean = inp.groupby('habitat')[['n.gard','n.unint','n.agfo','n.total']].mean().round(2)
hab_sum  = inp.groupby('habitat')[['n.gard','n.unint','n.agfo','n.total']].sum()
n_pl = inp.groupby('habitat').size()
tabA2 = pd.concat([n_pl.rename('n.plots'), hab_mean, hab_sum.add_suffix('_tot')], axis=1)
print(tabA2.to_string())
OUT['habitat_table'] = tabA2.to_dict()

sect("A3. Species-level descriptives by pathway")
g = isv.groupby('intro.pathway')[['number.of.invaded.plots','area.of.occupancy.10km',
    'habitat.range','mrt','invaded.niche.breadth']].agg(['mean','median']).round(2)
print(g.to_string())

# ============ design ============
inp2 = inp.copy()
inp2['urban_any'] = (inp2['urban.2009.500m']>0).astype(int)
inp2['urban_hi']  = (inp2['urban.2009.500m']>0.2).astype(int)
inp2['crop_log']  = np.log1p(inp2['cropland.2009.500m'])
inp2['elev_z']  = (inp2['elevation']-inp2['elevation'].mean())/inp2['elevation'].std()
inp2['rain_z']  = (inp2['annual.rainfall']-inp2['annual.rainfall'].mean())/inp2['annual.rainfall'].std()
for c,src in [('distroad_z','distance.road'), ('diststream_z','distance.stream')]:
    t = np.log1p(inp2[src]); inp2[c] = (t-t.mean())/t.std()
print("\nurban 500m bins: none=%d, low(0-0.2]=%d, high(>0.2)=%d" % (
    (inp2['urban.2009.500m']==0).sum(),
    ((inp2['urban.2009.500m']>0)&(inp2['urban.2009.500m']<=0.2)).sum(),
    (inp2['urban.2009.500m']>0.2).sum()))
hab_levels = ['Scrublands','Croplands','Coniferous forests','Broad-leaved forests','Urban',
              'Riparian','Rock outcrops','Meadows','Wetlands','Coastal']
hab_cols = []
for h in hab_levels[1:]:
    c = 'hab_'+h.replace(' ','_').replace('-','_'); inp2[c] = (inp2['habitat']==h).astype(int); hab_cols.append(c)
baseF = ['urban_any','urban_hi','crop_log','elev_z','rain_z','distroad_z','diststream_z']
XF  = sm.add_constant(inp2[baseF+hab_cols], has_constant='add')
XFh = sm.add_constant(inp2[baseF], has_constant='add')
assert 'const' in prune(XF).columns, "intercept dropped!"

# ================= (b) hurdle GLMs, FINAL spec =================
sect("B. FINAL hurdle GLMs per pathway (500m; urban_any/urban_hi/crop_log; HC1 SE)")
final = {}
PWs = [('Gardening','n.gard'),('Unintentional','n.unint'),('AgriForest','n.agfo'),('Total','n.total')]
for pw, col in PWs:
    y = inp2[col].values; pres=(y>0).astype(int)
    r = {'n_pos': int(pres.sum()), 'total_count': int(y.sum())}
    for tag, XX in [('with_habitat', XF), ('no_habitat', XFh)]:
        m = fit_logit(pres, XX)
        r['logit_'+tag] = {k:{'coef':float(m.params[k]),'p':float(m.pvalues[k]),'OR':float(np.exp(m.params[k]))}
                           for k in ['urban_any','urban_hi','crop_log']}
        ypos = y[y>0]
        if len(ypos)>=15:
            mnb = fit_nb(ypos, XX.loc[y>0])
            r['nb_'+tag] = {k:{'coef':float(mnb.params[k]),'p':float(mnb.pvalues[k]),'IRR':float(np.exp(mnb.params[k]))}
                            for k in ['urban_any','urban_hi','crop_log'] if k in mnb.params.index}
            r['nb_pearson_df_'+tag] = float(((ypos-mnb.fittedvalues)**2/mnb.fittedvalues).sum()/(len(ypos)-prune(XX.loc[y>0]).shape[1]))
    final[pw]=r
    for tag in ['no_habitat','with_habitat']:
        lg, nb = r['logit_'+tag], r.get('nb_'+tag,{})
        print(f"  {pw:14s} [{tag}]")
        for k in ['urban_any','urban_hi','crop_log']:
            v = lg[k]
            line = f"     presence {k:9s} OR={v['OR']:.2f} (p={v['p']:.3f})"
            if k in nb: line += f"  |  count IRR={nb[k]['IRR']:.2f} (p={nb[k]['p']:.3f})"
            print(line)
OUT['final_500m'] = final

# ---- 1000m scale comparison ----
sect("B2. 1000m buffer comparison")
inp2['urban_any_1k'] = (inp2['urban.2009.1000m']>0).astype(int)
inp2['urban_hi_1k']  = (inp2['urban.2009.1000m']>0.2).astype(int)
inp2['crop_log_1k']  = np.log1p(inp2['cropland.2009.1000m'])
baseK = ['urban_any_1k','urban_hi_1k','crop_log_1k','elev_z','rain_z','distroad_z','diststream_z']
XK  = sm.add_constant(inp2[baseK+hab_cols], has_constant='add')
XKh = sm.add_constant(inp2[baseK], has_constant='add')
res1000 = {}
for pw, col in PWs:
    y = inp2[col].values; pres=(y>0).astype(int)
    r={}
    for tag, XX in [('with_habitat',XK),('no_habitat',XKh)]:
        m = fit_logit(pres, XX)
        r['logit_'+tag] = {k:{'OR':float(np.exp(m.params[k])),'p':float(m.pvalues[k])}
                           for k in ['urban_any_1k','urban_hi_1k','crop_log_1k']}
        ypos=y[y>0]
        if len(ypos)>=15:
            mnb = fit_nb(ypos, XX.loc[y>0])
            r['nb_'+tag] = {k:{'IRR':float(np.exp(mnb.params[k])),'p':float(mnb.pvalues[k])}
                            for k in ['urban_any_1k','urban_hi_1k','crop_log_1k'] if k in mnb.params.index}
    res1000[pw]=r
    lg, nb = r['logit_no_habitat'], r.get('nb_no_habitat',{})
    ua = nb.get('urban_any_1k',{})
    print(f"  {pw:14s} no_hab: urban_any OR={lg['urban_any_1k']['OR']:.2f} (p={lg['urban_any_1k']['p']:.3f}) "
          f"urban_hi OR={lg['urban_hi_1k']['OR']:.2f} (p={lg['urban_hi_1k']['p']:.3f}) "
          f"crop OR={lg['crop_log_1k']['OR']:.2f} (p={lg['crop_log_1k']['p']:.3f}) "
          f"| count IRR urban_any={ua.get('IRR',float('nan')):.2f} (p={ua.get('p',float('nan')):.3f})")
OUT['final_1000m'] = res1000

# ---- change categories ----
sect("B3. Change categories 1956-2009 (50m buffer; 5 anomalous rows excluded)")
chg = inp.copy()
s = chg[['progressive.1956.2009.50m','regressive.1956.2009.50m','no.changes.1956.2009.50m']].sum(axis=1)
print(f"excluded {int((s<0.5).sum())} anomalous rows -> {int((s>=0.5).sum())} kept")
chg = chg[s>=0.5].copy()
chg['progressive'] = chg['progressive.1956.2009.50m']
chg['regressive']  = chg['regressive.1956.2009.50m']
chg['elev_z'] = (chg['elevation']-inp['elevation'].mean())/inp['elevation'].std()
chg['rain_z'] = (chg['annual.rainfall']-inp['annual.rainfall'].mean())/inp['annual.rainfall'].std()
for h in hab_levels[1:]:
    chg['hab_'+h.replace(' ','_').replace('-','_')] = (chg['habitat']==h).astype(int)
Xc = sm.add_constant(chg[['progressive','regressive','elev_z','rain_z']+hab_cols], has_constant='add')
reschg = {}
for pw, col in PWs:
    y = chg[col].values; pres=(y>0).astype(int)
    r={}
    try:
        m = fit_logit(pres, Xc)
        r['logit'] = {k:{'OR':float(np.exp(m.params[k])),'p':float(m.pvalues[k])} for k in ['progressive','regressive']}
    except Exception as e: r['logit']={'err':str(e)}
    ypos=y[y>0]
    if len(ypos)>=15:
        try:
            mnb = fit_nb(ypos, Xc.loc[y>0])
            r['nb'] = {k:{'IRR':float(np.exp(mnb.params[k])),'p':float(mnb.pvalues[k])} for k in ['progressive','regressive']}
        except Exception as e: r['nb']={'err':str(e)}
    reschg[pw]=r
    lg, nb = r.get('logit',{}), r.get('nb',{})
    if 'progressive' in lg and 'progressive' in nb:
        print(f"  {pw:14s} progressive OR={lg['progressive']['OR']:.2f} (p={lg['progressive']['p']:.3f}) "
              f"IRR={nb['progressive']['IRR']:.2f} (p={nb['progressive']['p']:.3f}) | "
              f"regressive OR={lg['regressive']['OR']:.2f} (p={lg['regressive']['p']:.3f}) "
              f"IRR={nb['regressive']['IRR']:.2f} (p={nb['regressive']['p']:.3f})")
OUT['change_cats'] = reschg

# ================= (c) species-level NB =================
sect("C. Species-level NB: number.of.invaded.plots ~ pathway x mrt + traits (genus-clustered SE)")
isd = isv.drop_duplicates(subset=['Scientific_name'], keep='first').copy()
print(f"deduplication: {len(isv)} records -> {len(isd)} species (dropped {len(isv)-len(isd)} second-pathway rows of 4 multi-pathway species)")
isd['mrt_z'] = (isd['mrt']-isd['mrt'].mean())/isd['mrt'].std()
isd['height_z'] = np.log10(isd['height']); isd['height_z'] = (isd['height_z']-isd['height_z'].mean())/isd['height_z'].std()
isd['veg'] = (isd['vegetative']=='Yes').astype(int)
isd['unint'] = (isd['intro.pathway']=='Unintentional').astype(int)
isd['agfo']  = (isd['intro.pathway']=='AgriForest').astype(int)
isd['unint_mrt'] = isd['unint']*isd['mrt_z']; isd['agfo_mrt'] = isd['agfo']*isd['mrt_z']
Xs = sm.add_constant(isd[['unint','agfo','mrt_z','unint_mrt','agfo_mrt','habitat.range','height_z','veg']], has_constant='add')
ys = isd['number.of.invaded.plots'].values
pois = sm.GLM(ys, Xs, family=sm.families.Poisson()).fit(); mu = pois.fittedvalues
alpha_s = max(((ys-mu)**2/mu).sum()/(len(ys)-Xs.shape[1]), 1e-3)
print(f"moment alpha = {alpha_s:.3f}; genus groups = {isd['genus'].nunique()}")
genus_groups = isd['genus'].values
m_nb = sm.GLM(ys, Xs, family=sm.families.NegativeBinomial(alpha=alpha_s)).fit(cov_type='cluster', cov_kwds={'groups': genus_groups})
terms = ['unint','agfo','mrt_z','unint_mrt','agfo_mrt','habitat.range','height_z','veg']
for k in terms:
    print(f"  {k:12s} b={m_nb.params[k]:+.3f}  IRR={np.exp(m_nb.params[k]):.2f}  cluster-robust p={m_nb.pvalues[k]:.4f}"
          + (" *" if m_nb.pvalues[k]<0.05 else ""))
m_red = sm.GLM(ys, Xs[['const','unint','agfo','habitat.range','height_z','veg']],
               family=sm.families.NegativeBinomial(alpha=alpha_s)).fit()
lr = 2*(m_nb.llf - m_red.llf); p_lr = stats.chi2.sf(lr, 3)
print(f"  LRT pathway x mrt interactions: LR={lr:.2f}, df=3, p={p_lr:.4f}")
OUT['species_nb'] = {k:{'coef':float(m_nb.params[k]),'p':float(m_nb.pvalues[k]),'IRR':float(np.exp(m_nb.params[k]))} for k in terms}
OUT['species_nb_lrt_interaction'] = {'LR': float(lr), 'p': float(p_lr)}
OUT['species_nb_dedup_note'] = f"{len(isv)} records -> {len(isd)} species (4 multi-pathway duplicates dropped, keep='first')"

sect("C2. Secondary: area.of.occupancy.10km ~ same spec (genus-clustered)")
yao = isd['area.of.occupancy.10km'].values
pois2 = sm.GLM(yao, Xs, family=sm.families.Poisson()).fit(); mu2 = pois2.fittedvalues
alpha2 = max(((yao-mu2)**2/mu2).sum()/(len(yao)-Xs.shape[1]), 1e-3)
m2 = sm.GLM(yao, Xs, family=sm.families.NegativeBinomial(alpha=alpha2)).fit(cov_type='cluster', cov_kwds={'groups': genus_groups})
for k in terms:
    print(f"  {k:12s} b={m2.params[k]:+.3f}  IRR={np.exp(m2.params[k]):.2f}  p={m2.pvalues[k]:.4f}"
          + (" *" if m2.pvalues[k]<0.05 else ""))
OUT['species_nb_ao'] = {k:{'coef':float(m2.params[k]),'p':float(m2.pvalues[k])} for k in terms}

# ================= (d) diagnostics =================
sect("D. VIF (final numeric spec, 500m) and overdispersion")
XvF = inp2[baseF]
vifsF = {XvF.columns[i]: float(variance_inflation_factor(sm.add_constant(XvF).values, i+1)) for i in range(XvF.shape[1])}
for k,v in vifsF.items(): print(f"  VIF {k:12s} = {v:.2f}")
OUT['vif_final'] = vifsF
print("\nOverdispersion (NB Pearson chi2/df on presence subsets, no-habitat spec):")
for pw in final:
    v = final[pw].get('nb_pearson_df_no_habitat')
    if v: print(f"  {pw:14s} {v:.2f}")

# bivariate Spearman for reference
from scipy.stats import spearmanr
sect("E. Bivariate Spearman (plot level, 500m buffer)")
for pw in ['n.gard','n.unint','n.agfo','n.total']:
    ru,pu = spearmanr(inp['urban.2009.500m'], inp[pw])
    rc,pc = spearmanr(inp['cropland.2009.500m'], inp[pw])
    print(f"  {pw:8s} urban rho={ru:+.3f} (p={pu:.2e}) | crop rho={rc:+.3f} (p={pc:.2e})")
    OUT.setdefault('spearman', {})[pw] = {'urban_rho': float(ru), 'urban_p': float(pu),
                                          'crop_rho': float(rc), 'crop_p': float(pc)}

json.dump(OUT, open('outputs/intermediate_results.json','w'), indent=1, default=str)
print("\nALL DONE - results saved to outputs/intermediate_results.json")
