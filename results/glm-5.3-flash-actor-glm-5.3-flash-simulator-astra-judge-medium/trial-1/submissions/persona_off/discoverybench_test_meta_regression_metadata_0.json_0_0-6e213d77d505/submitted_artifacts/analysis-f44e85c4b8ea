import pandas as pd, numpy as np
from scipy import stats

df = pd.read_csv('data/meta-regression_joined_data_heterogeneity_in_replication_projects.csv')

def analyze(group_col):
    rows = []
    for d, sub in df.groupby(group_col):
        n = len(sub)
        d_fisr = sub['fiso'] - sub['fisr']
        d_raw  = sub['ro'] - sub['rr']
        t_p = stats.ttest_1samp(d_fisr, 0).pvalue
        w_p = stats.wilcoxon(d_fisr).pvalue if n >= 6 else np.nan
        # sign flips: replication reversed direction (rr<0 given all ro>0)
        n_flip = int((sub['rr'] < 0).sum())
        n_atten = int(((sub['relative_es'] > 0) & (sub['relative_es'] < 1)).sum())
        n_gt1   = int((sub['relative_es'] > 1).sum())
        # supplementary inverse-variance weighted pooled difference (Fisher-z scale)
        se_d = np.sqrt(sub['se_fiso']**2 + sub['se_fisr']**2)
        w = 1/se_d**2
        pooled = np.sum(w*d_fisr)/np.sum(w)
        pooled_se = 1/np.sqrt(np.sum(w))
        z = pooled/pooled_se
        rows.append(dict(domain=d, n=n,
            pct_orig_gt=int((d_fisr>0).sum()), pct_orig_gt_pct=round(100*(d_fisr>0).mean(),1),
            mean_dz=round(d_fisr.mean(),3), med_dz=round(d_fisr.median(),3),
            mean_draw=round(d_raw.mean(),3),
            t_p=round(t_p,6), wilcoxon_p=round(w_p,6),
            sign_flips=n_flip, atten_0_to_1=n_atten, rel_gt1=n_gt1,
            mean_rel=round(sub['relative_es'].mean(),3), med_rel=round(sub['relative_es'].median(),3),
            replicated_pct=round(100*sub['replicated'].mean(),1),
            pooled_dz=round(pooled,3), pooled_se=round(pooled_se,3), pooled_z=round(z,2),
            pooled_p="<0.001" if 10**(-abs(z)/1) and z>3.3 else round(2*stats.norm.sf(abs(z)),6)))
    return pd.DataFrame(rows)

print("=== PRIMARY: by discipline (Fisher-z paired differences) ===")
t1 = analyze('discipline'); print(t1.to_string(index=False))

print("\n=== SECONDARY: by project ===")
t2 = analyze('project.x'); print(t2.to_string(index=False))

# Overall
n=len(df); d_all = df['fiso']-df['fisr']
print(f"\nOVERALL: n={n}, orig>rep {(d_all>0).sum()} ({100*(d_all>0).mean():.1f}%), mean dz={d_all.mean():.3f}, "
      f"paired t p={stats.ttest_1samp(d_all,0).pvalue:.2e}, Wilcoxon p={stats.wilcoxon(d_all).pvalue:.2e}")
print(f"Sign flips overall: {(df['rr']<0).sum()}, relative_es>1: {(df['relative_es']>1).sum()}, 0<rel<1: {((df['relative_es']>0)&(df['relative_es']<1)).sum()}")

# robustness: raw correlation scale proportions (identical to Fisher-z sign since monotone)
print("\nRobustness (raw r scale): proportion ro>rr by discipline:")
print(df.groupby('discipline').apply(lambda s: round(100*(s['ro']>s['rr']).mean(),1), include_groups=False).to_string())
print("Sign agreement between dz (Fisher-z) and raw difference >0:",
      int(((df['fiso']>df['fisr'])==(df['ro']>df['rr'])).sum()), "/", n)

# chi-square / pairwise on sign-flip rates
tab = pd.crosstab(df['discipline'], df['rr']<0)
print("\nSign-flip counts crosstab (flip=False/True):"); print(tab.to_string())
chi2, p_chi, _, _ = stats.chi2_contingency(tab)
print(f"Chi-square flip~discipline: chi2={chi2:.2f}, p={p_chi:.4f}")
# relative_es Kruskal across disciplines
groups = [s['relative_es'] for _,s in df.groupby('discipline')]
print(f"Kruskal-Wallis relative_es across disciplines: H={stats.kruskal(*groups).statistic:.2f}, p={stats.kruskal(*groups).pvalue:.4f}")
groups_d = [s['fiso']-s['fisr'] for _,s in df.groupby('discipline')]
print(f"Kruskal-Wallis dz across disciplines: H={stats.kruskal(*groups_d).statistic:.2f}, p={stats.kruskal(*groups_d).pvalue:.4f}")

# Social vs others on relative_es
soc = df[df.discipline=='Social']['relative_es']; oth = df[df.discipline!='Social']['relative_es']
print(f"Social vs others relative_es Mann-Whitney: p={stats.mannwhitneyu(soc,oth,alternative='less').pvalue:.4f}")

t1.to_csv('analysis/results_by_discipline.csv', index=False)
t2.to_csv('analysis/results_by_project.csv', index=False)
