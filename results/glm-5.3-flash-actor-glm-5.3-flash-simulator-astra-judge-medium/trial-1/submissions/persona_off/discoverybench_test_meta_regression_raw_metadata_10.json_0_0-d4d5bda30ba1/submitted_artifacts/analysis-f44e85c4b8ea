"""Proportion of junior professors among replicated studies in Psychology (rpp project).

Primary spec (approved): scope=project=='rpp'; 'replicated' = existing binary column
(encodes p<=0.05 & same direction); variable=seniority.r (most senior author of the
replication team); junior={Assistant Professor, Assistant}; denominator = replicated
rpp studies; drop==True rows kept in primary (filter documented as undocumented).
"""
import pandas as pd

JUNIOR = ["Assistant Professor", "Assistant"]
df = pd.read_csv("data/meta-regression_study_data_heterogeneity_in_replication_projects.csv")
rpp = df[df["project"] == "rpp"].copy()

def prop(sub, junior):
    rep = sub[sub["replicated"] == 1]
    n = int(rep["seniority.r"].isin(junior).sum()); d = len(rep)
    return n, d, (n / d if d else float("nan"))

# Sanity spot-check of 'replicated' against p<=0.05 & same-direction effect
chk = rpp.dropna(subset=["p_value.r", "effect_size.o", "effect_size.r"])
derived = ((chk["p_value.r"] <= 0.05) & (chk["effect_size.r"] * chk["effect_size.o"] > 0)).astype(float)
print(f"Spot-check agreement replicated vs derived: {(derived == chk['replicated']).mean():.3f} on {len(chk)} rows")

n, d, p = prop(rpp, JUNIOR)
print(f"PRIMARY: {n}/{d} replicated rpp studies led by a junior professor = {p:.4f} ({p*100:.1f}%)")
print("Replicated rpp seniority breakdown:\n", rpp[rpp['replicated']==1]['seniority.r'].value_counts())

# Sensitivity variants
for label, sub, jset in [
    ("Junior incl Researcher (all rows)", rpp, JUNIOR + ["Researcher"]),
    ("Primary, drop==True excluded", rpp[rpp["drop"] != True], JUNIOR),
    ("Incl Researcher, drop==True excluded", rpp[rpp["drop"] != True], JUNIOR + ["Researcher"]),
    ("Secondary: seniority.o, junior excl Researcher", rpp, None),
]:
    if jset is None:
        rep = sub[sub["replicated"] == 1]
        n = int(rep["seniority.o"].isin(JUNIOR).sum()); d = len(rep); p = n / d
    else:
        n, d, p = prop(sub, jset)
    print(f"SENSITIVITY {label}: {n}/{d} = {p:.4f} ({p*100:.1f}%)")

n_all = int(rpp["seniority.r"].isin(JUNIOR).sum())
print(f"CONTEXT all 97 rpp rows junior: {n_all}/97 = {n_all/97:.4f}")
print("drop==True rpp ids:", sorted(rpp[rpp['drop']==True]['id'].tolist()),
      "| duplicates among them:", rpp[rpp['drop']==True]['id'].duplicated().sum())
