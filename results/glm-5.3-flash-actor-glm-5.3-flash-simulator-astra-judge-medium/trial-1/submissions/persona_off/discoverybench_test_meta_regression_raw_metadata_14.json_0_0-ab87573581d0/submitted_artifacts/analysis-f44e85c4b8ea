import pandas as pd

df = pd.read_csv('data/meta-regression_study_data_heterogeneity_in_replication_projects.csv')
print('shape:', df.shape)
print('id unique:', df['id'].nunique(), 'of', len(df))
print('lab_id unique:', df['lab_id'].nunique())
for c in ['subjects.o','subjects.r','discipline','project']:
    print('---', c, 'missing:', df[c].isna().sum())
    print(df[c].value_counts(dropna=False).to_string())
print(pd.crosstab(df['project'], df['discipline']).to_string())
print(pd.crosstab(df['project'], df['subjects.o']).to_string())
print(pd.crosstab(df['project'], df['subjects.r']).to_string())

print('\nROW-LEVEL student proportions:')
for c in ['subjects.o','subjects.r']:
    for g in ['discipline','project']:
        print(g, c)
        print(df.groupby(g)[c].apply(lambda s: (s=='students').mean()).round(4).to_string())
print('overall row-level:', round((df['subjects.o']=='students').mean(),4),
      round((df['subjects.r']=='students').mean(),4))

u = df.drop_duplicates('id')
print('\nUNIQUE-STUDY LEVEL (%d studies):' % len(u))
print('overall:', round((u['subjects.o']=='students').mean(),4),
      round((u['subjects.r']=='students').mean(),4))
for c in ['subjects.o','subjects.r']:
    for g in ['discipline','project']:
        print(g, c)
        print(u.groupby(g)[c].apply(lambda s: (s=='students').mean()).round(4).to_string())

# consistency checks
g = df.groupby('id')[['subjects.o','subjects.r']].nunique(dropna=False)
print('\nids with >1 distinct subjects.o:', (g['subjects.o']>1).sum(),
      '; subjects.r:', (g['subjects.r']>1).sum())
print('missing subjects rows:')
print(df[df['subjects.o'].isna() | df['subjects.r'].isna()][['id','project','discipline']].to_string())

print('\n=== AGGREGATION VARIANTS (replication-side) ===')
target_o, target_r = 0.824, 0.809

# Variant A: row-level excluding rows where either subject is NA
v = df[df['subjects.o'].notna() & df['subjects.r'].notna()]
for disc in ['Social','Cognitive','Economics']:
    d = v[v['discipline']==disc]
    print(disc, 'A both-nonNA row-level:', round((d['subjects.o']=='students').mean(),4),
          round((d['subjects.r']=='students').mean(),4))

# Variant B: majority vote across labs per id
mv = df.groupby('id').agg({'discipline':'first','project':'first',
                           'subjects.o':lambda s: s.mode().iloc[0] if s.notna().any() else None,
                           'subjects.r':lambda s: s.mode().iloc[0] if s.notna().any() else None})
for disc in ['Social','Cognitive','Economics']:
    d = mv[mv['discipline']==disc]
    print(disc, 'B majority-vote study-level:', round((d['subjects.o']=='students').mean(),4),
          round((d['subjects.r']=='students').mean(),4))
print('overall B:', round((mv['subjects.o']=='students').mean(),4),
      round((mv['subjects.r']=='students').mean(),4))

# Variant C: exclude aggregated rows (aggregated==True), row-level and study-level
na = df[df['aggregated']!=True]
for disc in ['Social','Cognitive','Economics']:
    d = na[na['discipline']==disc]
    u = d.drop_duplicates('id')
    print(disc, 'C excl-aggregated row:', round((d['subjects.o']=='students').mean(),4),
          round((d['subjects.r']=='students').mean(),4),
          '| study-level:', round((u['subjects.o']=='students').mean(),4),
          round((u['subjects.r']=='students').mean(),4))

# Variant D: first lab row per id (lab order as given)
f = df.drop_duplicates('id', keep='first')
for disc in ['Social','Cognitive','Economics']:
    d = f[f['discipline']==disc]
    print(disc, 'D first-lab study-level:', round((d['subjects.o']=='students').mean(),4),
          round((d['subjects.r']=='students').mean(),4))

# search: any subset (discipline x project) with both targets within tolerance
print('\nSubset scan (discipline x project), row-level and study-level:')
for disc in df['discipline'].unique():
    for proj in df['project'].unique():
        d = df[(df['discipline']==disc)&(df['project']==proj)]
        if len(d)==0: continue
        u = d.drop_duplicates('id')
        print(disc, proj, 'row:', round((d['subjects.o']=='students').mean(),4),
              round((d['subjects.r']=='students').mean(),4),
              'study:', round((u['subjects.o']=='students').mean(),4),
              round((u['subjects.r']=='students').mean(),4))
