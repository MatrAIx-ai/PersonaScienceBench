"""Proportion of Experimental Economics original studies conducted in the United Kingdom."""
import pandas as pd

DATA = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
df = pd.read_csv(DATA)
print(f"Total rows: {len(df)}")

ee = df[df["project"] == "ee"].copy()
print(f"EE rows: {len(ee)}")

# Defensive verification: one row per original study
assert ee["id"].is_unique, "Duplicate EE ids found"
assert ee["title"].is_unique, "Duplicate EE titles found"
n_lab = ee["lab_id"].notna().sum()
n_agg = ee["aggregated"].notna().sum()
print(f"EE lab_id non-null: {n_lab}; aggregated non-null: {n_agg} (no per-lab duplication)")
if n_lab or n_agg:
    ee = ee.drop_duplicates(subset="id")
print(f"EE unique original studies after dedup check: {len(ee)}")

# Country handling
missing = ee[ee["experiment_country.o"].isna() | (ee["experiment_country.o"].astype(str).str.strip() == "")]
print(f"EE rows with missing/blank country: {len(missing)}")
valid = ee[~ee.index.isin(missing.index)]
print(f"Denominator (EE original studies with non-missing country): {len(valid)}")

uk = valid[valid["experiment_country.o"].str.strip().str.lower().isin(["united kingdom", "uk", "great britain", "england"])]
print(f"UK studies (numerator): {len(uk)}")
print(uk[["id", "title", "authors.o", "pub_year", "experiment_country.o"]].to_string(index=False))

prop = len(uk) / len(valid)
print(f"\nProportion UK = {len(uk)}/{len(valid)} = {prop:.4f} ({prop*100:.1f}%)")
print("Country distribution:")
print(valid["experiment_country.o"].value_counts().to_string())
