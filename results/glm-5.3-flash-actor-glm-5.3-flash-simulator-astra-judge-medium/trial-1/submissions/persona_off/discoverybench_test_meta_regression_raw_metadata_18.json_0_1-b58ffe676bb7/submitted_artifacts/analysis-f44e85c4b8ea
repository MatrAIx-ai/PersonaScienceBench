"""Proportion of Experimental Economics (project == 'ee') original studies conducted in a lab setting.

Definition: 'lab setting' is inferred as NOT conducted online, i.e. online.o == 0,
since the dataset has no direct lab/online field. Proportion computed over unique
original studies (unique id = unique O/R pair).
"""
import pandas as pd

CSV = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
df = pd.read_csv(CSV)

print(f"Full dataset: {df.shape[0]} rows, {df.shape[1]} columns, {df['id'].nunique()} unique O/R pairs")

ee = df[df["project"] == "ee"].copy()
n_rows_ee = len(ee)
n_studies_ee = ee["id"].nunique()
print(f"EE subset: {n_rows_ee} rows, {n_studies_ee} unique studies (id)")

# Deduplicate on id (stated no-op for ee, kept for correctness)
unique_ee = ee.drop_duplicates(subset="id")

# Exclusion flags (verified: no exclusions apply)
print("drop flag:", unique_ee["drop"].value_counts(dropna=False).to_dict())
print("aggregated flag:", unique_ee["aggregated"].value_counts(dropna=False).to_dict())

# online.o distribution (original experiments)
online_counts = unique_ee["online.o"].value_counts(dropna=False).to_dict()
print("online.o distribution over unique ee studies:", online_counts)

# Corroborating signals
print("subjects.o distribution:", unique_ee["subjects.o"].value_counts(dropna=False).to_dict())
print("us_lab.o distribution (country of lab, not lab/online flag):",
      unique_ee["us_lab.o"].value_counts(dropna=False).to_dict())

lab = (unique_ee["online.o"] == 0)
n_lab = int(lab.sum())
prop = n_lab / len(unique_ee)
print(f"Lab-based (online.o == 0) original studies: {n_lab}/{len(unique_ee)} = {prop:.2%}")

# Row-based check (identical because one row per id in ee)
prop_rows = (ee["online.o"] == 0).mean()
print(f"Row-based proportion (check): {prop_rows:.2%}")

assert n_studies_ee == n_rows_ee == 18
assert unique_ee["online.o"].isna().sum() == 0
assert prop == 1.0

result = {
    "n_unique_ee_studies": n_studies_ee,
    "n_lab_based": n_lab,
    "proportion_lab_based": prop,
    "online_o_distribution": online_counts,
}
print("RESULT:", result)
