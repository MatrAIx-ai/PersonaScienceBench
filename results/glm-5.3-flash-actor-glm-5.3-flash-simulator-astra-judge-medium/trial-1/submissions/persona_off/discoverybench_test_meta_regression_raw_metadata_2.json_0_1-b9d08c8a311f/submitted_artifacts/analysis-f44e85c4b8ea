"""
Average length (pages) of original papers: Experimental Economics (ee) vs Psychology (rpp)
Dataset: data/meta-regression_study_data_heterogeneity_in_replication_projects.csv
Level: unique original paper (one row per 'id'); length is constant within id (verified).
"""
import pandas as pd
import numpy as np

CSV = 'data/meta-regression_study_data_heterogeneity_in_replication_projects.csv'
df = pd.read_csv(CSV)
print(f"Loaded {CSV}: {df.shape[0]} rows, {df.shape[1]} cols, {df['id'].nunique()} unique ids")

# --- Sanity checks -----------------------------------------------------------
assert (df.groupby('id')['length'].nunique() > 1).sum() == 0, "length varies within id!"
print("Check: 'length' constant within every id ->", (df.groupby('id')['length'].nunique() > 1).sum() == 0)

# A4 verification: any rpp id flagged drop=True?
drop_rpp_ids = df[(df.project == 'rpp') & (df['drop'] == True)]['id'].unique()
print(f"A4 check: rpp rows with drop=True: {(df.project=='rpp').sum() and ((df.project=='rpp') & (df['drop']==True)).sum()}; "
      f"affected ids: {list(drop_rpp_ids) if len(drop_rpp_ids) else 'none'}")
drop_ee = df[(df.project == 'ee') & (df['drop'] == True)].shape[0]
print(f"A4 check: ee rows with drop=True: {drop_ee}")

# Missingness / anomaly scan for length in ee & rpp
for p in ['ee', 'rpp']:
    L = df.loc[df.project == p, 'length']
    print(f"{p}: missing={L.isna().sum()}, zeros={(L==0).sum()}, negatives={(L<0).sum()}, non-numeric={pd.to_numeric(L, errors='coerce').isna().sum() - L.isna().sum()}")

# --- Main analysis: unique-original level -------------------------------------
u = df.drop_duplicates('id')

def summarize(g):
    L = g['length'].astype(float)
    return pd.Series({
        'n (unique originals)': len(L),
        'mean': round(L.mean(), 2),
        'median': L.median(),
        'sd': round(L.std(ddof=1), 2),
        'min': int(L.min()),
        'max': int(L.max()),
    })

def build_table(scope_u, label):
    rows = {}
    rows['Experimental Economics (ee)'] = summarize(scope_u[scope_u.project == 'ee'])
    rows['Psychology (rpp)'] = summarize(scope_u[scope_u.project == 'rpp'])
    t = pd.DataFrame(rows).T
    print(f"\n=== {label} ===")
    print(t.to_string())
    return t

# Headline table (ee vs rpp only)
t_main = build_table(u, "HEADLINE: ee vs rpp, unique-original level")

# Sensitivity U1: combined Psychology bucket incl. Many Labs originals (ml1, ml3, rpp)
psy_ids = u[u.project.isin(['ml1', 'ml3', 'rpp'])]
L_psy = psy_ids['length'].astype(float)
# Deduplicate same paper appearing under multiple ids within the psychology set (by title)
psy_dedup_title = psy_ids.drop_duplicates('title')
print(f"\nU1 sensitivity: psychology originals by id-level n={len(L_psy)}; after title-dedup n={len(psy_dedup_title)} "
      f"(mean {L_psy.mean():.2f} vs {psy_dedup_title['length'].mean():.2f})")

rows = {
    'Experimental Economics (ee)': summarize(u[u.project == 'ee']),
    'Psychology incl. Many Labs (ml1+ml3+rpp)': pd.Series({
        'n (unique originals)': len(L_psy),
        'mean': round(L_psy.mean(), 2),
        'median': L_psy.median(),
        'sd': round(L_psy.std(ddof=1), 2),
        'min': int(L_psy.min()),
        'max': int(L_psy.max()),
    }),
}
t_sens = pd.DataFrame(rows).T
print("\n=== SENSITIVITY (U1): ee vs Psychology incl. Many Labs ===")
print(t_sens.to_string())

# Difference in headline means
m_ee = t_main.loc['Experimental Economics (ee)', 'mean']
m_rpp = t_main.loc['Psychology (rpp)', 'mean']
print(f"\nHeadline difference: ee mean - rpp mean = {m_ee} - {m_rpp} = {round(m_ee - m_rpp, 2)} pages")

# rpp mean-median gap detail
Lr = u.loc[u.project == 'rpp', 'length'].astype(float)
print(f"rpp detail: mean={Lr.mean():.2f}, median={Lr.median():.0f}, "
      f"share <=7 pages: {(Lr<=7).mean()*100:.1f}%, share <=10 pages: {(Lr<=10).mean()*100:.1f}%")
