"""Analysis: In which domain do the majority of authors tend to be male
for both original and replication studies?

Data: meta-regression_study_data_heterogeneity_in_replication_projects.csv
(927 lab-level rows, 141 unique O/R pairs).
"""
import pandas as pd
import numpy as np

DATA = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
df = pd.read_csv(DATA)
print(f"Loaded {len(df)} rows, {df['id'].nunique()} unique O/R pairs")

# ---------------- base-case pair-level table ----------------
# Original side: constant per id -> take first row per id
orig = df.groupby("id").first()[["discipline", "project", "authors_male.o",
                                 "n_authors.o", "drop"]]

# Replication side, pair level: aggregated=True row (ml1/ml3) or single row (rpp/ee)
is_pair_level = (df["aggregated"] == True) | (df["lab_id"].isna())
repl = df[is_pair_level].groupby("id").first()[["authors_male.r", "n_authors.r"]]

pair = orig.join(repl)
assert pair[["authors_male.o", "authors_male.r"]].notna().all().all()
print(f"Pair-level table: {len(pair)} pairs")

def summarize(pairs, label):
    g = pairs.groupby("discipline")
    out = pd.DataFrame({
        "n_pairs": g.size(),
        "mean_male_o": g["authors_male.o"].mean().round(3),
        "mean_male_r": g["authors_male.r"].mean().round(3),
        "share_maj_o": g.apply(lambda x: (x["authors_male.o"] > 0.5).mean()).round(3),
        "share_maj_r": g.apply(lambda x: (x["authors_male.r"] > 0.5).mean()).round(3),
        "share_maj_both": g.apply(lambda x: ((x["authors_male.o"] > 0.5) &
                                             (x["authors_male.r"] > 0.5)).mean()).round(3),
        "mean_authors_o": g["n_authors.o"].mean().round(2),
        "mean_authors_r": g["n_authors.r"].mean().round(2),
    })
    # author-weighted (approximate for r)
    wt = pairs.groupby("discipline").apply(
        lambda x: pd.Series({
            "wt_male_o": np.sum(x["authors_male.o"] * x["n_authors.o"]) / x["n_authors.o"].sum(),
            "wt_male_r": np.sum(x["authors_male.r"] * x["n_authors.r"]) / x["n_authors.r"].sum(),
        }), include_groups=False).round(3)
    out = out.join(wt)
    print(f"\n=== {label} ===")
    print(out.to_string())
    return out

base = summarize(pair, "BASE CASE: all 141 pairs (drop=True rows included)")
print("\nProject composition per discipline (base):")
print(pair.groupby(["discipline", "project"]).size().to_string())

# majority-male indicator per pair, both sides
for d in ["Social", "Cognitive", "Economics"]:
    sub = pair[pair["discipline"] == d]
    print(f"{d}: pairs majority-male on BOTH sides: "
          f"{((sub['authors_male.o']>0.5)&(sub['authors_male.r']>0.5)).sum()}/{len(sub)}")

# ---------------- sensitivity 1: exclude drop=True ----------------
sens1 = pair[~pair["drop"]]
summarize(sens1, "SENSITIVITY 1: excluding drop=True pairs "
          f"({len(sens1)} pairs)")

# ---------------- sensitivity 2: pooled multi-lab replication teams ----------
# Pool all lab-level rows: replication team defined per (id, lab); pairs without
# lab_id are single rows. Then average within id.
lab = df[df["aggregated"] != True].copy()   # all lab rows incl. NaN-lab rpp/ee
pooled = lab.groupby("id").agg(
    discipline=("discipline", "first"),
    authors_male_o=("authors_male.o", "first"),
    n_labs=("lab_id", lambda x: x.notna().sum()),
    mean_male_r_labs=("authors_male.r", "mean"),
    share_maj_r_labs=("authors_male.r", lambda x: (x > 0.5).mean()),
)
pooled["pooled_maj_r"] = pooled["mean_male_r_labs"] > 0.5
g = pooled.groupby("discipline")
pooled_tab = pd.DataFrame({
    "n_pairs": g.size(),
    "mean_male_o": g["authors_male_o"].mean().round(3),
    "mean_male_r_labs": g["mean_male_r_labs"].mean().round(3),
    "share_maj_o": g.apply(lambda x: (x["authors_male_o"] > 0.5).mean()).round(3),
    "share_maj_r_labs": g["pooled_maj_r"].mean().round(3),
})
print("\n=== SENSITIVITY 2: multi-lab replication teams pooled (lab-level "
      "authors_male.r averaged per pair; majority = pair-mean ratio > 0.5) ===")
print(pooled_tab.to_string())

# lab-level view: share of individual replication TEAMS that are majority male
labteams = df[df["lab_id"].notna()]
lt = labteams.groupby(["discipline"]).apply(
    lambda x: pd.Series({
        "n_lab_teams": len(x),
        "share_maj_r_labteams": (x["authors_male.r"] > 0.5).mean(),
        "mean_male_r_labteams": x["authors_male.r"].mean(),
    }), include_groups=False).round(3)
print("\nLab-level replication teams (ml1/ml3 only, n=%d rows):" % len(labteams))
print(lt.to_string())

# ---------------- author-weighted interpretation is approximate for r -------
bad = df[(np.abs(df["authors_male.r"] * df["n_authors.r"]
                 - (df["authors_male.r"] * df["n_authors.r"]).round())) > 1e-6]
print(f"\nReplication rows where ratio x n_authors is non-integer "
      f"(author-weighted r treated as approximate): {len(bad)}")

# ---------------- per-project consistency for the leading domain -------------
print("\nEconomics by project (pair level):")
print(pair[pair["discipline"] == "Economics"].groupby("project").agg(
    n=("authors_male.o", "size"),
    mean_male_o=("authors_male.o", "mean"),
    mean_male_r=("authors_male.r", "mean")).round(3).to_string())

# ---------------- verdict summary -------------------------------------------
print("\n=== VERDICT CHECK (base case) ===")
for d, row in base.iterrows():
    both = (row["share_maj_o"] > 0.5) and (row["share_maj_r"] > 0.5)
    print(f"{d}: share_maj_o={row['share_maj_o']}, share_maj_r={row['share_maj_r']} "
          f"-> majority-male on both sides: {both} "
          f"(mean ratio o/r = {row['mean_male_o']}/{row['mean_male_r']})")
