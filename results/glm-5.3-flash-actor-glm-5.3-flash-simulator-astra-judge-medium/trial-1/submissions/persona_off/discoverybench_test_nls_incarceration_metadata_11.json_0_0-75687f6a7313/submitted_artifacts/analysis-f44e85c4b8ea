"""
Median 1985 wealth disparities among the ever-incarcerated (NLSY79-derived).
Question: What kind of demographic disparities exist in median wealth in 1985
among individuals who were ever incarcerated?
"""
import pandas as pd

df = pd.read_csv("data/nls_incarceration_processed.csv")
W = "composite_wealth_1985"

# Data typo: 'hipanic' -> 'hispanic' (labeling only; no rows changed otherwise)
df["race_clean"] = df["race"].replace({"hipanic": "hispanic"})

inc = df[df["ever_jailed"] == 1].copy()          # ever incarcerated subsample
non = df[df["ever_jailed"] == 0].copy()          # context benchmark

def summarize(d, label):
    g = d.groupby("race_clean")[W].agg(n="size", median="median", mean="mean",
                                       p25=lambda s: s.quantile(.25),
                                       p75=lambda s: s.quantile(.75))
    g["share_le0"] = (d.groupby("race_clean")[W].apply(lambda s: (s <= 0).mean()))
    print(f"\n=== {label}: median 1985 wealth by race ===")
    print(g.round(1))
    g2 = d.groupby("sex")[W].agg(n="size", median="median", mean="mean",
                                 p25=lambda s: s.quantile(.25),
                                 p75=lambda s: s.quantile(.75))
    g2["share_le0"] = (d.groupby("sex")[W].apply(lambda s: (s <= 0).mean()))
    print(f"\n=== {label}: median 1985 wealth by sex ===")
    print(g2.round(1))
    g3 = d.groupby(["race_clean", "sex"])[W].agg(n="size", median="median", mean="mean",
                                                 p25=lambda s: s.quantile(.25),
                                                 p75=lambda s: s.quantile(.75))
    g3["share_le0"] = d.groupby(["race_clean", "sex"])[W].apply(lambda s: (s <= 0).mean())
    print(f"\n=== {label}: median 1985 wealth by race x sex ===")
    print(g3.round(1))
    return g3

print("n ever-incarcerated:", len(inc), "| n never-jailed:", len(non))
g3 = summarize(inc, "EVER INCARCERATED (ever_jailed==1)")

# Disparities vs white male reference (absolute difference and ratio)
ref = g3.loc[("white", "male"), "median"]
print("\n=== Disparities vs white male (reference median ${:,.0f}) ===".format(ref))
for idx, row in g3.iterrows():
    diff = row["median"] - ref
    ratio = row["median"] / ref if ref != 0 else float("nan")
    print(f"{idx}: median=${row['median']:,.0f}  diff=${diff:,.0f}  ratio={ratio:.2f}  n={int(row['n'])}")

# Context benchmark (secondary): never-jailed group
g3n = summarize(non, "CONTEXT ONLY: never jailed (ever_jailed==0)")
refn = g3n.loc[("white", "male"), "median"]
print("\n=== Context disparities vs white male (never jailed) ===")
for idx, row in g3n.iterrows():
    print(f"{idx}: median=${row['median']:,.0f}  ratio vs white male={row['median']/refn:.2f}  n={int(row['n'])}")

# Supplementary: skew documentation (mean vs median within incarcerated)
print("\nMean-vs-median contrast (incarcerated, right-skew documentation):")
print(g3[["n", "median", "mean"]].round(1))
