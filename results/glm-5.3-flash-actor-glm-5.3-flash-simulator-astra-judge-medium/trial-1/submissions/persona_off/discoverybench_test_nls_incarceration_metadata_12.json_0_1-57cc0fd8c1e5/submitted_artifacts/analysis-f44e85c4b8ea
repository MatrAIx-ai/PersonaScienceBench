"""
NLSY79 incarceration & wealth analysis (DiscoveryBench: nls_incarceration)
Question: How does incarceration affect the wealth of black individuals based on their income levels?
No income variable exists -> baseline (1985) composite wealth terciles proxy "income levels".
Approach approved by researcher (terciles primary; quartile robustness if jailed cells >= ~30).
"""
import pandas as pd, numpy as np
from scipy import stats

OUT = []
def p(*a):
    s = " ".join(str(x) for x in a)
    OUT.append(s); print(s)

df = pd.read_csv('data/nls_incarceration_processed.csv')
W = ['composite_wealth_1985','composite_wealth_1990','composite_wealth_1996']
p("=== HEADER: rows =", len(df), "| columns:", list(df.columns))
p("NOTE: race value 'hipanic' observed as-is in data; treated as the documented 'hispanic' category (not renamed).")

b = df[df['race']=='black'].copy()
p("\n=== BLACK SUBSAMPLE === n =", len(b), "| ever_jailed:", dict(b['ever_jailed'].value_counts()))

# ---- baseline terciles ----
b['w3'] = pd.qcut(b['composite_wealth_1985'], 3, labels=['T1_low','T2_mid','T3_high'])
cuts = b['composite_wealth_1985'].quantile([1/3, 2/3]).tolist()
p("Tercile cutpoints (1985 wealth, black subsample):", [round(c) for c in cuts])
cell = b.groupby(['w3','ever_jailed'], observed=True).size()
p("Cell sizes (tercile x jailed):\n", cell.to_string())

def block(sub, label):
    p(f"\n--- {label} ---")
    for stratum in sorted(sub['strat'].unique(), key=str) if 'strat' in sub else []:
        pass

# helper for one stratification analysis
def run_strat(data, stratcol, strata_order, label, min_cell_report=True):
    p(f"\n========== {label} ==========")
    rows = []
    for s in strata_order:
        for j in [0,1]:
            sub = data[(data[stratcol]==s) & (data['ever_jailed']==j)]
            if len(sub)==0: continue
            r = {'stratum':s,'jailed':j,'n':len(sub)}
            for c,tag in zip(W,['85','90','96']):
                r[f'med{tag}']=sub[c].median(); r[f'mean{tag}']=sub[c].mean()
                r[f'pos{tag}']=(sub[c]>0).mean()
            # 1985->96 change
            r['d_med96'] = sub['composite_wealth_1996'].median()-sub['composite_wealth_1985'].median()
            r['d_mean96'] = sub['composite_wealth_1996'].mean()-sub['composite_wealth_1985'].mean()
            rows.append(r)
    t = pd.DataFrame(rows)
    p(t.round(1).to_string(index=False))
    # contrasts within stratum
    p("\nWithin-stratum contrasts (jailed - never-jailed):")
    for s in strata_order:
        j1 = data[(data[stratcol]==s)&(data['ever_jailed']==1)]
        j0 = data[(data[stratcol]==s)&(data['ever_jailed']==0)]
        if len(j1)<5 or len(j0)<5: p(f"  {s}: cell too small (n1={len(j1)}, n0={len(j0)})"); continue
        p(f"  {s} (n1={len(j1)}, n0={len(j0)}):")
        for c,tag in zip(W,['85','90','96']):
            mw = stats.mannwhitneyu(j1[c], j0[c], alternative='two-sided')
            p(f"    {tag}: dMed={j1[c].median()-j0[c].median():>10.0f}  dMean={j1[c].mean()-j0[c].mean():>10.0f}  MWU p={mw.pvalue:.3f}  pos%: {100*(j1[c]>0).mean():.0f} vs {100*(j0[c]>0).mean():.0f}")
        d = (j1['composite_wealth_1996']-j1['composite_wealth_1985']) - (j0['composite_wealth_1996']-j0['composite_wealth_1985'])
        p(f"    DiD 85->96 (mean change gap): {d.mean():.0f} | dMed 85->96: {(j1['composite_wealth_1996'].median()-j1['composite_wealth_1985'].median())-(j0['composite_wealth_1996'].median()-j0['composite_wealth_1985'].median()):.0f}")
        # winsorized at 99th pct of full black sample
        wins = {c: data[c].clip(upper=data[c].quantile(0.99)) for c in W}
        for c,tag in zip(W,['85','90','96']):
            p(f"    {tag} winsor99: dMean={wins[c][j1.index].mean()-wins[c][j0.index].mean():.0f}")
        p(f"    positive-wealth 1996: jailed {100*(j1['composite_wealth_1996']>0).mean():.0f}% vs never {100*(j0['composite_wealth_1996']>0).mean():.0f}%")
    return t

tert = run_strat(b, 'w3', ['T1_low','T2_mid','T3_high'], "BLACK: 1985-WEALTH TERCILES (primary)")

# ---- quartile robustness ----
b['w4'] = pd.qcut(b['composite_wealth_1985'], 4, labels=['Q1','Q2','Q3','Q4'])
qcell = b.groupby(['w4','ever_jailed'], observed=True).size()
p("\n=== QUARTILE ROBUSTNESS (cell sizes) ===\n", qcell.to_string())
if (qcell.xs(1, level='ever_jailed') >= 30).all():
    run_strat(b, 'w4', ['Q1','Q2','Q3','Q4'], "BLACK: QUARTILES (robustness)")

# ---- sex sanity check within black ----
p("\n========== SEX CHECK (black subsample) ==========")
p(pd.crosstab(b['sex'], b['ever_jailed'], margins=True).to_string())
p("\nMean/median wealth by sex x jailed (black):")
sx = b.groupby(['sex','ever_jailed'])[W].agg(['mean','median','size']).round(0)
p(sx.to_string())
for s in ['male','female']:
    sub = b[b['sex']==s]
    j1,j0 = sub[sub['ever_jailed']==1], sub[sub['ever_jailed']==0]
    p(f"\n  {s}: n1={len(j1)} n0={len(j0)} | 1996 dMed={j1['composite_wealth_1996'].median()-j0['composite_wealth_1996'].median():.0f} dMean={j1['composite_wealth_1996'].mean()-j0['composite_wealth_1996'].mean():.0f} | DiD mean 85->96 = {(j1['composite_wealth_1996']-j1['composite_wealth_1985']).mean()-(j0['composite_wealth_1996']-j0['composite_wealth_1985']).mean():.0f}")

# ---- white reference contrast (secondary) ----
wht = df[df['race']=='white'].copy()
wht['w3'] = pd.qcut(wht['composite_wealth_1985'], 3, labels=['T1_low','T2_mid','T3_high'])
run_strat(wht, 'w3', ['T1_low','T2_mid','T3_high'], "WHITE REFERENCE: 1985-WEALTH TERCILES (secondary)")

# ---- pooled sex-adjusted (linear additivity, black) ----
p("\n========== SEX-ADJUSTED POOLED CHECK (black) ==========")
# simple within-sex-cell demeaned comparison of 1996 wealth, jailed vs not, black only
bb = b.copy()
for c in W:
    bb[c+'_dm'] = bb[c] - bb.groupby('sex', observed=True)[c].transform('mean')
for c,tag in zip(W,['85','90','96']):
    j1 = bb[bb['ever_jailed']==1][c+'_dm']; j0 = bb[bb['ever_jailed']==0][c+'_dm']
    p(f"  {tag}: sex-demeaned mean gap (jailed-never) = {j1.mean()-j0.mean():.0f}")

open('analysis/analysis_output.txt','w').write("\n".join(OUT))
p("\nSaved to analysis/analysis_output.txt")
