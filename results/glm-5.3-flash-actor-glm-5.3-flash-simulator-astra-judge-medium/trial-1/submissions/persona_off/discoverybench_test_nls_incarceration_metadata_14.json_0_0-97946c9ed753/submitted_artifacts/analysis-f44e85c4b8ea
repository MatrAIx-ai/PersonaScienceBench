"""
Analysis: Between which years did the largest increases in median wealth
occur among black females?
Data: data/nls_incarceration_processed.csv (NLSY79-derived)
"""
import numpy as np
import pandas as pd

RNG = np.random.default_rng(42)
YEARS = [1985, 1990, 1996]
WCOLS = [f"composite_wealth_{y}" for y in YEARS]

df = pd.read_csv("data/nls_incarceration_processed.csv")

# 1. Filter and coercion checks
for c in WCOLS:
    df[c] = pd.to_numeric(df[c], errors="coerce")
bf = df[(df["race"] == "black") & (df["sex"] == "female")].copy()
n = len(bf)
missing_after = int(bf[WCOLS].isna().sum().sum())
print(f"Black females: n={n}; missing/non-numeric wealth values after coercion: {missing_after}")

# ever_jailed breakdown (exploratory context only)
jailed = bf["ever_jailed"].value_counts().to_dict()
print(f"ever_jailed breakdown (exploratory): {jailed}")

# 2. Medians and interval changes
meds = {y: float(bf[f"composite_wealth_{y}"].median()) for y in YEARS}
rows = []
for a, b in [(1985, 1990), (1990, 1996)]:
    d_abs = meds[b] - meds[a]
    d_rel = meds[b] / meds[a] if meds[a] != 0 else float("inf")
    rows.append({"interval": f"{a}-{b}", "median_start": meds[a], "median_end": meds[b],
                 "abs_change": d_abs, "ratio": d_rel, "pct_change": 100 * (d_rel - 1)})
tbl = pd.DataFrame(rows)
print("\nMedians:", meds)
print(tbl.to_string(index=False))

largest = tbl.loc[tbl["abs_change"].idxmax(), "interval"]
largest_rel = tbl.loc[tbl["ratio"].idxmax(), "interval"]
print(f"\nLargest increase (absolute): {largest}; (relative): {largest_rel}")

# 3. Sensitivity: exclude zeros (negatives retained as valid net worth)
meds_nz = {y: float(bf.loc[bf[f"composite_wealth_{y}"] != 0, f"composite_wealth_{y}"].median()) for y in YEARS}
print("\nSensitivity (zeros excluded, negatives kept):", meds_nz)
for a, b in [(1985, 1990), (1990, 1996)]:
    print(f"  {a}-{b}: abs {meds_nz[b]-meds_nz[a]:+.1f}, ratio {meds_nz[b]/meds_nz[a]:.2f}")

# 4. Bootstrap CIs for interval changes (median difference), 2000 resamples
B = 2000
boot = {}
for a, b in [(1985, 1990), (1990, 1996)]:
    xa = bf[f"composite_wealth_{a}"].to_numpy()
    xb = bf[f"composite_wealth_{b}"].to_numpy()
    diffs = np.empty(B)
    for i in range(B):
        ia = RNG.integers(0, len(xa), len(xa))
        ib = RNG.integers(0, len(xb), len(xb))
        diffs[i] = np.median(xb[ib]) - np.median(xa[ia])
    lo, hi = np.percentile(diffs, [2.5, 97.5])
    boot[f"{a}-{b}"] = (float(np.median(diffs)), float(lo), float(hi))
    print(f"Bootstrap 95% CI, median change {a}-{b}: point {np.median(diffs):+.1f}, CI [{lo:+.1f}, {hi:+.1f}]")

# Exploratory ever_jailed medians (flagged: n=16 too small for inference)
bf_j = bf[bf["ever_jailed"] == 1]
expl = {y: float(bf_j[f"composite_wealth_{y}"].median()) for y in YEARS}
print("\nExploratory (ever_jailed==1, n=16) medians:", expl)

tbl.to_csv("outputs/black_female_median_wealth_intervals.csv", index=False)
pd.DataFrame({"year": YEARS,
              "median_all": [meds[y] for y in YEARS],
              "median_excl_zeros": [meds_nz[y] for y in YEARS]}).to_csv(
    "outputs/black_female_median_wealth_by_year.csv", index=False)

print("\nHYPOTHESIS: Among black females in the NLSY79 cohort, median composite wealth "
      f"rose from ${meds[1985]:,.0f} in 1985 to ${meds[1990]:,.0f} in 1990 (+${meds[1990]-meds[1985]:,.0f}, "
      f"a ~{100*(meds[1990]/meds[1985]-1):.0f}% increase), and then from ${meds[1990]:,.0f} in 1990 to "
      f"${meds[1996]:,.0f} in 1996 (+${meds[1996]-meds[1990]:,.0f}, ~{100*(meds[1996]/meds[1990]-1):.0f}%). "
      "The largest increase in median wealth therefore occurred between 1985 and 1990, "
      "in both absolute-dollar and relative terms.")
