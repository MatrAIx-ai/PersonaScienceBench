"""
Wealth inequality change for white males vs. white females, 1990 -> 1996
Dataset: data/nls_incarceration_processed.csv (NLSY79-derived)
Primary run: all rows as supplied (n=12,013); sensitivity runs as specified.
"""
import numpy as np
import pandas as pd

RNG = np.random.default_rng(20261019)
DATA = "data/nls_incarceration_processed.csv"
YEARS = ["1990", "1996"]

# ---------------- helpers ----------------
def gini_full(x):
    """Gini via the sorted-rank formula, O(n log n) (valid with negatives; interpret with care).
    Equivalent to the mean-absolute-difference definition G = sum|xi-xj| / (2*n^2*mean)."""
    x = np.sort(np.asarray(x, dtype=float))
    n = len(x)
    s = x.sum()
    if n == 0 or s <= 0:
        return np.nan
    return (2.0 * np.arange(1, n + 1) @ x - (n + 1) * s) / (n * s)

def gini_pos(x):
    x = x[x > 0]
    return gini_full(x) if len(x) else np.nan

def top_share(x, p):
    """Share of total positive wealth held by top p fraction (positives only)."""
    x = np.sort(x[x > 0].astype(float))[::-1]
    tot = x.sum()
    if tot <= 0:
        return np.nan
    k = max(1, int(np.ceil(len(x) * p)))
    return x[:k].sum() / tot

def summarize(x):
    x = np.asarray(x, dtype=float)
    pos = x[x > 0]
    p = np.percentile
    med = np.median(x)
    q = {
        "n": len(x),
        "mean": x.mean(),
        "median": med,
        "sd": x.std(ddof=1),
        "cv": x.std(ddof=0) / x.mean(),
        "p10": p(x, 10), "p25": p(x, 25), "p50": p(x, 50), "p75": p(x, 75), "p90": p(x, 90),
        "p90_over_p10_pos": p(pos, 90) / p(pos, 10) if len(pos) else np.nan,
        "p90_over_p50": p(x, 90) / med if med > 0 else np.nan,
        "p75_over_p25": p(x, 75) / p(x, 25) if p(x, 25) > 0 else np.nan,
        "gini_all": gini_full(x),
        "gini_pos": gini_pos(x),
        "top10_share": top_share(x, 0.10),
        "top1_share": top_share(x, 0.01),
        "share_zero": np.mean(x == 0),
        "share_neg": np.mean(x < 0),
        "share_pos": np.mean(x > 0),
    }
    return q

def fmt_row(name, q):
    return {
        "group": name, "n": q["n"],
        "mean": f"{q['mean']:,.0f}", "median": f"{q['median']:,.0f}", "sd": f"{q['sd']:,.0f}",
        "cv": f"{q['cv']:.2f}",
        "p10": f"{q['p10']:,.0f}", "p25": f"{q['p25']:,.0f}", "p50": f"{q['p50']:,.0f}",
        "p75": f"{q['p75']:,.0f}", "p90": f"{q['p90']:,.0f}",
        "p90/p10(pos)": f"{q['p90_over_p10_pos']:.1f}",
        "p90/p50": f"{q['p90_over_p50']:.1f}",
        "p75/p25": f"{q['p75_over_p25']:.1f}",
        "gini(all)": f"{q['gini_all']:.3f}", "gini(pos)": f"{q['gini_pos']:.3f}",
        "top10%share": f"{100*q['top10_share']:.1f}%", "top1%share": f"{100*q['top1_share']:.1f}%",
        "%zero": f"{100*q['share_zero']:.1f}%", "%neg": f"{100*q['share_neg']:.1f}%",
        "%pos": f"{100*q['share_pos']:.1f}%",
    }

def bootstrap_dispersion(x90, x96, n_boot=1000):
    """Paired bootstrap (resample row indices shared by both waves' cross-sections)
    for changes in CV, gini_all, gini_pos, p90/p50."""
    n = len(x90)
    assert len(x96) == n
    out = {k: [] for k in ["d_cv", "d_gini_all", "d_gini_pos", "d_p90p50"]}
    for _ in range(n_boot):
        idx = RNG.integers(0, n, n)
        a, b = x90[idx], x96[idx]
        out["d_cv"].append(b.std(ddof=0)/b.mean() - a.std(ddof=0)/a.mean())
        out["d_gini_all"].append(gini_full(b) - gini_full(a))
        out["d_gini_pos"].append(gini_pos(b) - gini_pos(a))
        pa, pb = np.percentile(a, 90), np.percentile(b, 90)
        ma, mb = np.median(a), np.median(b)
        out["d_p90p50"].append((pb/mb if mb > 0 else np.nan) - (pa/ma if ma > 0 else np.nan))
    res = {}
    for k, v in out.items():
        v = np.array([t for t in v if np.isfinite(t)])
        res[k] = (np.mean(v), np.percentile(v, 2.5), np.percentile(v, 97.5))
    return res

# ---------------- load ----------------
df = pd.read_csv(DATA)
assert df.isna().sum().sum() == 0
W90, W96 = "composite_wealth_1990", "composite_wealth_1996"

def run(groups, label, note=""):
    print(f"\n{'='*100}\nPRIMARY TABLE" if label == "primary" else f"\n{'='*100}\nSENSITIVITY: {label} {note}")
    rows = []
    data = {}
    raw = {}
    for sex in ["male", "female"]:
        sub = groups.get(("white", sex))
        if sub is None:
            continue
        for y, col in zip(YEARS, [W90, W96]):
            x = sub[col].values
            q = summarize(x)
            rows.append(fmt_row(f"white {sex} {y}", q))
            data[(sex, y)] = q
            raw[(sex, y)] = x
    tbl = pd.DataFrame(rows)
    print(tbl.to_string(index=False))
    # change-in-change
    print("\n--- Change 1990->1996 by sex, and male-vs-female change-in-change ---")
    def delta(sex, key):
        return data[(sex,"1996")][key] - data[(sex,"1990")][key]
    for key, lab in [("cv","CV"), ("gini_all","Gini(all)"), ("gini_pos","Gini(pos)"),
                     ("median","median ($)"), ("share_zero","zero share (pp)"),
                     ("share_neg","neg share (pp)"), ("p90","p90 ($)"), ("mean","mean ($)"),
                     ("top10_share","top-10% share")]:
        dm, dfm = delta("male", key), delta("female", key)
        unit = "pp" if "share" in key else ""
        v_m = dm*100 if "share" in key else dm
        v_f = dfm*100 if "share" in key else dfm
        print(f"{lab:18s} male Δ = {v_m:12,.3f}{unit:2s} | female Δ = {v_f:12,.3f}{unit:2s} | "
              f"ΔΔ(male-female) = {v_m - v_f:12,.3f}")
    return data, raw

# ---------------- primary ----------------
groups = {k: g for k, g in df.groupby(["race", "sex"])}
data_primary, raw_primary = run(groups, "primary")

print("\n--- Bootstrap (1,000 paired resamples) for dispersion changes 1990->1996 ---")
for sex in ["male", "female"]:
    res = bootstrap_dispersion(raw_primary[(sex, "1990")], raw_primary[(sex, "1996")])
    print(f"\nwhite {sex}:")
    for k, (m, lo, hi) in res.items():
        print(f"  Δ{k:12s} = {m:9.3f}  95% CI [{lo:9.3f}, {hi:9.3f}]")

# ---------------- sensitivity runs ----------------
dd = df.drop_duplicates()
run({k: g for k, g in dd.groupby(["race", "sex"])}, "dedup", "(exact duplicates removed, n=10,114)")

d_noout = df[df[W90] > -800000]
run({k: g for k, g in d_noout.groupby(["race", "sex"])}, "outlier", "(1990 value -$866,400 removed)")

d_pos = df[(df[W90] > 0) & (df[W96] > 0)]
run({k: g for k, g in d_pos.groupby(["race", "sex"])}, "exclude-zeros",
    "(respondents with zero wealth in either wave dropped; n=%d)" % len(d_pos))

# negatives set to zero
d_nz = df.copy()
d_nz[W90] = d_nz[W90].clip(lower=0)
d_nz[W96] = d_nz[W96].clip(lower=0)
run({k: g for k, g in d_nz.groupby(["race", "sex"])}, "negatives->0", "(negative wealth floored at 0)")

print("\nDone.")
