"""Analysis: wealth (1985/1990/1996) by incarceration status (ever_jailed) in NLSY79 processed data."""
import pandas as pd, numpy as np
from scipy import stats
import statsmodels.formula.api as smf

rng = np.random.default_rng(42)
df = pd.read_csv('data/nls_incarceration_processed.csv')
YEARS = ['composite_wealth_1985','composite_wealth_1990','composite_wealth_1996']
print(f"N={len(df)}, ever_jailed=1: {(df.ever_jailed==1).sum()}, =0: {(df.ever_jailed==0).sum()}")

def boot_ci(y, g, n=5000):
    d = []
    y0, y1 = y[g==0], y[g==1]
    for _ in range(n):
        d.append(y1.sample(len(y1), replace=True, random_state=rng.integers(1e9)).mean()
                 - y0.sample(len(y0), replace=True, random_state=rng.integers(1e9)).mean())
    return np.percentile(d, [2.5, 97.5])

rows = []
for y in YEARS:
    g, w = df.ever_jailed.values, df[y].values
    j, nj = w[g==1], w[g==0]
    t, p_t = stats.ttest_ind(j, nj, equal_var=False)
    u, p_u = stats.mannwhitneyu(j, nj, alternative='two-sided')
    # Brown-Mood style median test
    stat_med, p_med, _, _ = stats.median_test(j, nj)
    cliffs = (2*u/(len(j)*len(nj))) - 1  # rank-biserial (Cliff's delta equivalent)
    b = boot_ci(df[y], g)
    rows.append(dict(year=y, mean_jailed=j.mean(), mean_non=nj.mean(),
                     diff_mean=j.mean()-nj.mean(), boot_lo=b[0], boot_hi=b[1],
                     median_jailed=np.median(j), median_non=np.median(nj),
                     p_welch=p_t, p_MWU=p_u, p_median=p_med, cliffs_delta=cliffs))
raw = pd.DataFrame(rows)
print("\n=== RAW per-year comparisons (jailed - non-jailed) ===")
print(raw.round(4).to_string(index=False))

# Covariate-adjusted OLS (HC1 robust SE)
print("\n=== Adjusted OLS: wealth ~ ever_jailed + race + sex (HC1) ===")
adj = {}
for y in YEARS:
    m = smf.ols(f"{y} ~ ever_jailed + C(race) + C(sex)", data=df).fit(cov_type='HC1')
    adj[y] = dict(coef=m.params['ever_jailed'], se=m.bse['ever_jailed'], p=m.pvalues['ever_jailed'])
    print(f"{y}: beta={m.params['ever_jailed']:.1f}, SE={m.bse['ever_jailed']:.1f}, p={m.pvalues['ever_jailed']:.4g}")

# Baseline-adjusted (1990, 1996 controlling 1985 wealth) -> change from selection vs incarceration-era gap
print("\n=== Baseline-adjusted OLS: wealth_y ~ ever_jailed + race + sex + wealth_1985 (HC1) ===")
base = {}
for y in YEARS[1:]:
    m = smf.ols(f"{y} ~ ever_jailed + C(race) + C(sex) + composite_wealth_1985", data=df).fit(cov_type='HC1')
    base[y] = dict(coef=m.params['ever_jailed'], se=m.bse['ever_jailed'], p=m.pvalues['ever_jailed'])
    print(f"{y}: beta={m.params['ever_jailed']:.1f}, SE={m.bse['ever_jailed']:.1f}, p={m.pvalues['ever_jailed']:.4g}")

# Sensitivity: signed-log transform
print("\n=== Sensitivity: signed-log(wealth) ~ ever_jailed + race + sex (HC1) ===")
sl = {}
for y in YEARS:
    df[f'sl_{y}'] = np.sign(df[y]) * np.log1p(np.abs(df[y]))
    m = smf.ols(f"sl_{y} ~ ever_jailed + C(race) + C(sex)", data=df).fit(cov_type='HC1')
    sl[y] = dict(coef=m.params['ever_jailed'], p=m.pvalues['ever_jailed'])
    print(f"{y}: beta={m.params['ever_jailed']:.3f}, p={m.pvalues['ever_jailed']:.4g}")

# Holm correction across the 3 years for each test family
def holm(p):
    o = np.argsort(p); ps = np.asarray(p)[o]; m = len(p)
    adj_p = np.empty(m); running = 0
    for i, idx in enumerate(o):
        v = ps[i]*(m-i); running = max(running, v); adj_p[idx] = min(1, running)
    return adj_p
print("\n=== Holm-adjusted p-values (across 3 years) ===")
print("Welch t raw p:", [f"{raw.p_welch[i]:.4g}" for i in range(3)], "-> Holm:", np.round(holm(raw.p_welch),4))
print("MWU    raw p:", [f"{raw.p_MWU[i]:.4g}" for i in range(3)], "-> Holm:", np.round(holm(raw.p_MWU),4))
print("Median raw p:", [f"{raw.p_median[i]:.4g}" for i in range(3)], "-> Holm:", np.round(holm(raw.p_median),4))
print("OLS-adj raw p:", [f"{adj[y]['p']:.4g}" for y in YEARS], "-> Holm:", np.round(holm([adj[y]['p'] for y in YEARS]),4))
print("Baseline-adj raw p:", [f"{base[y]['p']:.4g}" for y in YEARS[1:]], "-> Holm:", np.round(holm([base[y]['p'] for y in YEARS[1:]]),4))

# summary table
out = raw.copy()
out['ols_adj_beta'] = [adj[y]['coef'] for y in YEARS]; out['ols_adj_p'] = [adj[y]['p'] for y in YEARS]
out['base_adj_beta'] = [np.nan]+[base[y]['coef'] for y in YEARS[1:]]; out['base_adj_p'] = [np.nan]+[base[y]['p'] for y in YEARS[1:]]
out['sl_beta'] = [sl[y]['coef'] for y in YEARS]; out['sl_p'] = [sl[y]['p'] for y in YEARS]
out.to_csv('results_wealth_by_jail_status.csv', index=False)
print("\nSaved results_wealth_by_jail_status.csv")
print(out.round(4).to_string(index=False))
