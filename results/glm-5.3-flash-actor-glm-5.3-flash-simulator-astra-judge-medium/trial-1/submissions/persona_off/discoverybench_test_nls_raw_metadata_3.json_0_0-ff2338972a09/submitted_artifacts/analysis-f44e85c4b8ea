"""
NLSY79: How does consideration of academic characteristics alter the effects of
Socioeconomic Status and race on college attendance/completion (proxied by
dormitory residence)?
Nested logistic regressions: SES+race baseline vs baseline+academic controls.
"""
import pandas as pd, numpy as np, statsmodels.api as sm, json, sys

df = pd.read_csv('/workspace/data/nls_raw.csv')
OUT = {}

# ---------------- variable construction ----------------
MOM = "Highest grade completed by respondent's mother, 1979"
DAD = "Highest grade completed by respondent's father, 1979"
INC79 = "Total net family income, previous calendar year, 1979"
FAMSIZE = "Family size, 1979"
RACE = "Racial/ethnic cohort, 1979"
SEX = "Sex of respondent, 1979"
AGE = "Age of respondent, 1979"
RANK = "Rank in class last year attended at this school, 1981"
CSIZE = "Number of students in class last year attended at this school, 1981"
ASV = ["ASVAB - Arithmetic Reasoning Z Score (rounded), 1981",
       "ASVAB - Word Knowledge Z Score (rounded), 1981",
       "ASVAB - Paragraph Comprehension Z Score (rounded), 1981",
       "ASVAB - Mathematics Knowledge Z Score (rounded), 1981"]
RES = [c for c in df.columns if c.startswith("Type of residence")]

d = pd.DataFrame(index=df.index)
d["ses_momgrade"] = df[MOM]
d["ses_dadgrade"] = df[DAD]
d["ses_lnincome79"] = np.log1p(df[INC79].clip(lower=0))
d["ses_famsize79"] = df[FAMSIZE]
d["race_black"]    = (df[RACE] == 1).astype(float)
d["race_hispanic"] = (df[RACE] == 2).astype(float)   # ref = Non-Black/Non-Hispanic (3)
d["female"] = (df[SEX] == 2).astype(float)
d["age79"] = df[AGE]

# Outcome A: ever in dorm/fraternity/sorority in ANY wave 1981-1996
d["y_dorm_any"] = (df[RES] == 3).any(axis=1).astype(float)
# Outcome B (sensitivity): dorm in 1985 or later waves only
late = [c for c in RES if int(c.rsplit(',',1)[-1].strip()) >= 1985]
d["y_dorm_1985plus"] = (df[late] == 3).any(axis=1).astype(float)

# Academic controls
for c, new in zip(ASV, ["acad_asvab_ar","acad_asvab_wk","acad_asvab_pc","acad_asvab_mk"]):
    s = df[c]
    d[new] = (s - s.mean()) / s.std()          # re-standardized
rankpct = 1 - df[RANK] / df[CSIZE]
d["acad_rankpct"] = rankpct.where(df[RANK].notna() & df[CSIZE].notna())

# ---------------- group means by race cohort (sanity check) ----------------
grp_vars = ["y_dorm_any","y_dorm_1985plus","ses_momgrade","ses_dadgrade",
            "ses_lnincome79","ses_famsize79","acad_asvab_ar","acad_rankpct","age79"]
gm = d.groupby(df[RACE])[grp_vars].mean().T.round(3)
gm.columns = ["cohort1","cohort2","cohort3(NBNH ref)"]
OUT["group_means_by_race"] = gm.to_dict()
print("=== GROUP MEANS BY RACIAL/ETHNIC COHORT ===")
print(gm.to_string())

# ---------------- logistic helpers ----------------
def fit_logit(dat, cols, y):
    X = sm.add_constant(dat[cols], has_constant='add')
    m = sm.Logit(dat[y], X).fit(disp=0, maxiter=200)
    return m

def coef_table(m):
    t = pd.DataFrame({"log_odds": m.params, "p": m.pvalues})
    t["OR"] = np.exp(m.params)
    return t

BASE = ["ses_momgrade","ses_dadgrade","ses_lnincome79","ses_famsize79",
        "race_black","race_hispanic","female","age79"]
ACAD = ["acad_asvab_ar","acad_asvab_wk","acad_asvab_pc","acad_asvab_mk","acad_rankpct"]

def run_pair(data, y, label, extra_acad=None):
    acad = (extra_acad or ACAD)
    keep = BASE + acad + [y]
    cc = data[keep].dropna()
    m1 = fit_logit(cc, BASE, y)
    m2 = fit_logit(cc, BASE + acad, y)
    print(f"\n=== {label} | N={len(cc)} | outcome={y} ===")
    print(f"outcome prevalence: {cc[y].mean():.3f}")
    print(f"Model1 converged={m1.mle_retvals['converged']} llf={m1.llf:.1f}; "
          f"Model2 converged={m2.mle_retvals['converged']} llf={m2.llf:.1f}")
    t1, t2 = coef_table(m1), coef_table(m2)
    tab = pd.DataFrame(index=t1.index)
    tab["M1_logodds"], tab["M1_OR"] = t1["log_odds"], t1["OR"]
    tab["M2_logodds"], tab["M2_OR"] = t2["log_odds"], t2["OR"]
    tab["pct_atten"] = 100*(1 - t2["log_odds"]/t1["log_odds"])
    tab["M1_p"], tab["M2_p"] = t1["p"], t2["p"]
    tab["atten_note"] = ["*" if abs(t1.loc[v,"log_odds"]) < 0.05 else "" for v in tab.index]
    print(tab.round(4).to_string())
    print("   (* = % attenuation unstable: |M1 log-odds| < 0.05)")
    return {"N": len(cc), "prev": round(float(cc[y].mean()),4),
            "converged": [bool(m1.mle_retvals['converged']), bool(m2.mle_retvals['converged'])],
            "llf": [round(float(m1.llf),1), round(float(m2.llf),1)],
            "table": tab.round(4).to_dict()}

res = {}
# primary complete-case pairs
res["primary_any"]        = run_pair(d, "y_dorm_any", "MODEL 1 vs 2: ever-dorm (any wave), complete-case")
res["sens_1985plus"]      = run_pair(d, "y_dorm_1985plus", "SENSITIVITY: ever-dorm 1985+, complete-case")

# ASVAB-only model (larger N; rank excluded)
res["asvab_only"]         = run_pair(d, "y_dorm_any", "MODEL 1 vs 2a: academic = ASVAB only", extra_acad=ACAD[:4])

# rank-only model
res["rank_only"]          = run_pair(d, "y_dorm_any", "MODEL 1 vs 2b: academic = rank percentile only", extra_acad=["acad_rankpct"])

# ---------------- missing-indicator robustness ----------------
imp = d.copy()
# ASVAB missingness is nearly identical across the four subtests -> collapse to ONE indicator
asvab_miss = imp[ACAD[:4]].isna().any(axis=1).astype(float)
rank_miss = imp["acad_rankpct"].isna().astype(float)
for c in ACAD:
    imp[c] = imp[c].fillna(imp[c].median())
imp["acad_asvab_missing"] = asvab_miss
imp["acad_rank_missing"] = rank_miss
res["mi_indicators"] = run_pair(imp, "y_dorm_any", "ROBUSTNESS: median imputation + collapsed missing indicators",
                                extra_acad=ACAD + ["acad_asvab_missing","acad_rank_missing"])

# diagnostics summary
print("\n=== DIAGNOSTICS SUMMARY ===")
for k, v in res.items():
    print(f"{k}: N={v['N']}, prevalence={v['prev']}, converged={v['converged']}, llf={v['llf']}")

json.dump({"group_means": gm.round(4).to_dict(),
           "models": {k: {"N": v["N"], "prev": v["prev"], "converged": v["converged"], "llf": v["llf"],
                          "table": v["table"]} for k, v in res.items()}},
          open('/workspace/analysis/results.json','w'), indent=1, default=str)
print("\nSaved results.json")
