"""
NLSY79 analysis: Black-vs-non-Black college-attendance-proxy gap across SES levels.

Outcome (proxy, NOT BA completion): ever lived in 'DORM, FRATERNITY, SORORITY'
(residence code 3) in any wave 1981-1996.
SES composite (pre-outcome): parental education (mother/father 1979) + 1979 family income.
Race contrast: Black (1) vs non-Black pooled (2+3); sensitivity Black vs non-Black non-Hispanic (3).
"""
import numpy as np, pandas as pd
import statsmodels.formula.api as smf
from scipy import stats

pd.set_option('display.width', 250)
pd.set_option('display.max_columns', 50)

df = pd.read_csv('data/nls_raw.csv')

RACE   = 'Racial/ethnic cohort, 1979'
MOM    = "Highest grade completed by respondent's mother, 1979"
DAD    = "Highest grade completed by respondent's father, 1979"
GRADE  = 'Highest grade completed, 1979'
INC79  = 'Total net family income, previous calendar year, 1979'
AGE    = 'Age of respondent, 1979'
SEX    = 'Sex of respondent, 1979'
ASVAB  = 'ASVAB - Arithmetic Reasoning Z Score (rounded), 1981'
res_cols = [c for c in df.columns if c.startswith('Type of residence')]

# ---------------- cleaning ----------------
df['grade79'] = df[GRADE].where(df[GRADE] <= 20)          # 95 -> missing
df['ever_dorm'] = df[res_cols].eq(3).any(axis=1).astype(int)
df['black']     = (df[RACE] == 1).astype(int)
df['nonblacknh']= (df[RACE] == 3).astype(int)             # sensitivity contrast
df['hispanic']  = (df[RACE] == 2).astype(int)
df['female']    = (df[SEX] == 2).astype(int)
df['age79']     = df[AGE]
df['income_missing'] = df[INC79].isna().astype(int)

print(f'N total = {len(df)}')
print(f'Outcome ever_dorm = 1: {df.ever_dorm.sum()} ({df.ever_dorm.mean()*100:.1f}%)')
print(f'grade79 >= 16 (descriptive only): n={int((df.grade79>=16).sum())}')
df['inc79']=df[INC79]; df['mom_ed']=df[MOM]; df['dad_ed']=df[DAD]

# ---------------- SES composite ----------------
for c, name in [(MOM,'mom_ed'), (DAD,'dad_ed'), (INC79,'inc79')]:
    z = (df[c] - df[c].mean()) / df[c].std()
    df['z_'+name] = z
df['ses_components'] = df[['z_mom_ed','z_dad_ed','z_inc79']].notna().astype(int).sum(axis=1)
df['ses_composite']  = df[['z_mom_ed','z_dad_ed','z_inc79']].mean(axis=1, skipna=True)

def tertiles(s, labels=('SES_Low','SES_Mid','SES_High')):
    q = s.quantile([1/3, 2/3])
    return pd.cut(s, [-np.inf, q[1/3], q[2/3], np.inf], labels=labels)

df['ses_tertile'] = tertiles(df.ses_composite)
df['ses_pe']      = tertiles(df[[MOM,DAD]].max(axis=1))                    # parental-ed only
df['ses_inc']     = tertiles(df[INC79])                                    # income only

# ---------------- complete-case primary sample ----------------
need = ['ever_dorm','black','female','age79','ses_tertile','ses_composite']
cc = df.dropna(subset=need).copy()
print(f'\nComplete-case primary N = {len(cc)} (dropped {len(df)-len(cc)}; '
      f'{df.ses_composite.isna().sum()} lack all SES components)')

# ---------------- (b) rates by race x SES tertile ----------------
def wilson(x, n, alpha=0.05):
    if n == 0: return (np.nan, np.nan)
    p = x/n; z = stats.norm.ppf(1-alpha/2)
    d = 1 + z*z/n; c = (p + z*z/(2*n))/d; h = z*np.sqrt(p*(1-p)/n + z*z/(4*n*n))/d
    return (max(0,c-h), min(1,c+h))

rows = []
for t in ['SES_Low','SES_Mid','SES_High']:
    for grp, lab in [(1,'Black'), (0,'Non-Black (pooled)')]:
        s = cc[(cc.ses_tertile == t) & (cc.black == grp)]
        x, n = int(s.ever_dorm.sum()), len(s)
        lo, hi = wilson(x, n)
        rows.append({'SES_tier':t, 'Group':lab, 'N':n, 'n_dorm':x,
                     'rate%':100*x/n if n else np.nan,
                     'CI_low%':100*lo, 'CI_high%':100*hi})
rates = pd.DataFrame(rows)
# Hispanic-only + nonBlack-nonHispanic rates within tertile
for t in ['SES_Low','SES_Mid','SES_High']:
    for code, lab in [(2,'Hispanic only'), (3,'NonB-nonHisp only')]:
        s = cc[(cc.ses_tertile == t) & (cc[RACE] == code)]
        x, n = int(s.ever_dorm.sum()), len(s)
        lo, hi = wilson(x, n)
        rates.loc[len(rates)] = {'SES_tier':t,'Group':lab,'N':n,'n_dorm':x,
                                 'rate%':100*x/n if n else np.nan,'CI_low%':100*lo,'CI_high%':100*hi}
print('\n=== Outcome rates by race x SES tertile (complete case) ===')
print(rates.to_string(index=False, float_format=lambda v: f'{v:6.1f}'))

print('\n=== Black - Non-Black(pooled) rate-difference (percentage points) ===')
for t in ['SES_Low','SES_Mid','SES_High']:
    b  = cc[(cc.ses_tertile==t)&(cc.black==1)].ever_dorm
    nb = cc[(cc.ses_tertile==t)&(cc.black==0)].ever_dorm
    diff = 100*(b.mean()-nb.mean())
    # se of diff
    se = 100*np.sqrt(b.mean()*(1-b.mean())/len(b) + nb.mean()*(1-nb.mean())/len(nb))
    print(f'{t}: Black {100*b.mean():5.1f}% (n={len(b)}) vs non-Black {100*nb.mean():5.1f}% (n={len(nb)}) '
          f'-> diff {diff:+5.1f} pp  (95% CI {diff-1.96*se:+.1f} to {diff+1.96*se:+.1f})')

# ---------------- (c) logistic regressions ----------------
cc2 = cc.copy(); cc2['ses_t'] = cc2.ses_tertile.astype(str)
def fit(formula, data, label):
    m = smf.logit(formula, data=data).fit(disp=0)
    print(f'\n--- {label} (N={int(m.nobs)}) ---')
    ors = np.exp(m.params)
    out = pd.DataFrame({'coef':m.params,'OR':ors,'CI_lo':np.exp(m.conf_int()[0]),
                        'CI_hi':np.exp(m.conf_int()[1]),'p':m.pvalues})
    print(out.round(4).to_string())
    return m, out

m1, o1 = fit('ever_dorm ~ black * C(ses_t) + age79 + female', cc2,
             'Primary: black x SES tertile, adjusted age+sex (ref = SES_Low)')

# additive interaction: marginal rate differences by SES tier
cc2['black_eff'] = cc2.black
print('\n=== Marginal predicted rates & additive interaction (model 1) ===')
for t in ['SES_Low','SES_Mid','SES_High']:
    d0 = cc2[cc2.ses_t==t].copy(); d0['black']=0
    d1 = d0.copy(); d1['black']=1
    p0, p1 = m1.predict(d0).mean(), m1.predict(d1).mean()
    print(f'{t}: predicted non-Black {100*p0:5.1f}% vs Black {100*p1:5.1f}% -> additive gap {100*(p1-p0):+5.1f} pp')

# multiplicative interaction p-values
print('\nInteraction terms (black x SES_Mid/High):')
for k in ['black:C(ses_t)[T.SES_Mid]','black:C(ses_t)[T.SES_High]']:
    if k in o1.index: print(f'  {k}: OR={o1.loc[k,"OR"]:.3f}, p={o1.loc[k,"p"]:.4f}')

# sensitivity: Black vs non-Black non-Hispanic
cc3 = cc2[cc2.hispanic==0].copy()
m2, o2 = fit('ever_dorm ~ black * C(ses_t) + age79 + female', cc3,
             'Sensitivity: Black vs non-Black non-Hispanic only')

# ASVAB-adjusted (post-treatment caveat)
cc4 = cc2.dropna(subset=['z_ASVAB']).rename(columns={'z_ASVAB':'asvab'}) if 'z_ASVAB' in cc2 else cc2.copy()
cc4 = cc2.dropna(subset=[ASVAB]).copy(); cc4['asvab'] = cc4[ASVAB]
m3, o3 = fit('ever_dorm ~ black * C(ses_t) + age79 + female + asvab', cc4,
             'Sensitivity: + ASVAB score (POST-TREATMENT caveat)')

# ---------------- sensitivity: SES definitions & missing-income indicator ----------------
print('\n=== Sensitivity: SES from parental education only ===')
ccA = df.dropna(subset=['ever_dorm','black','female','age79','ses_pe']).copy()
ccA['ses_t'] = ccA.ses_pe.astype(str)
fit('ever_dorm ~ black * C(ses_t) + age79 + female', ccA, 'SES = parental education tertiles')

print('\n=== Sensitivity: SES from 1979 income only (complete case on income) ===')
ccB = df.dropna(subset=['ever_dorm','black','female','age79','ses_inc','inc79']).copy()
ccB['ses_t'] = ccB.ses_inc.astype(str)
fit('ever_dorm ~ black * C(ses_t) + age79 + female', ccB, 'SES = income tertiles')

print('\n=== Sensitivity: composite + income-missing indicator (regression adjustment) ===')
ccC = cc2.copy()
mC, oC = fit('ever_dorm ~ black * C(ses_t) + age79 + female + income_missing', ccC,
             'Primary model + income_missing indicator')

# ---------------- cell N summary ----------------
print('\n=== N per cell (complete case) ===')
print(cc2.groupby(['ses_t','black']).size().unstack().to_string())

# save tables
rates.to_csv('analysis/rates_by_race_ses.csv', index=False)
with open('analysis/model_summary.txt','w') as f:
    for lab, m in [('primary',m1),('vs_nonblacknh',m2),('asvab_adj',m3),('income_missing',mC)]:
        f.write(f'==== {lab} ====\n{m.summary()}\n\n')
print('\nSaved: analysis/rates_by_race_ses.csv, analysis/model_summary.txt')
