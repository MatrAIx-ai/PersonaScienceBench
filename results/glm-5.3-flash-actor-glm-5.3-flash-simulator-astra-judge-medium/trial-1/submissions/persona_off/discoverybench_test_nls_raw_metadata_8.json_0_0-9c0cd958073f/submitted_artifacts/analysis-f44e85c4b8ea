"""NLSY79: racial wealth gap in median family net wealth, 1985-1996 (DiscoveryBench task)."""
import pandas as pd
import numpy as np

RACE_MAP = {1: 'Black', 2: 'Hispanic', 3: 'NonBlackNonHispanic'}
WAVES = {'1985': 'Family net wealth, 1985',
         '1990': 'Family net wealth, 1990',
         '1996': 'Family net wealth, 1996 (key data point)'}
RACE = 'Racial/ethnic cohort, 1979'
SID = 'Sample ID, 1979 (interview)'
COMPONENTS = {
    '1985': ['Market value of residential property respondent/spouse own, 1985',
             'Total market value of farm, business, and other property, 1985',
             'Market Value of vehicles respondent/spouse own, 1985',
             'Total market value of items over $500, 1985'],
    '1990': ['Market value of residential property respondent/spouse own, 1990',
             'Total market value of farm, business, and other property, 1990',
             'Market Value of vehicles respondent/spouse own, 1990',
             'Total market value of items over $500, 1990'],
    '1996': ['Market value of residential property respondent/spouse own, 1996',
             'Total market value of farm, business, and other property, 1996',
             'Market Value of vehicles respondent/spouse own, 96',
             'Total market value of items over $500, 1996'],
}

df = pd.read_csv('data/nls_raw.csv')
df['cohort'] = df[RACE].map(RACE_MAP)
wcols = list(WAVES.values())

# ---- 1. Primary: unweighted available-case medians per cohort per wave ----
rows = []
for year, col in WAVES.items():
    for cohort in ['NonBlackNonHispanic', 'Black', 'Hispanic']:
        s = df.loc[df['cohort'] == cohort, col].dropna()
        rows.append({'wave': year, 'cohort': cohort, 'n': len(s),
                     'median': s.median(), 'mean': s.mean(),
                     'pct_neg': 100 * (s < 0).mean(), 'pct_zero': 100 * (s == 0).mean()})
prim = pd.DataFrame(rows)
print('=== TABLE 1: Primary medians (unweighted, available case, negatives kept) ===')
print(prim.round(1).to_string(index=False))
print()

# Gaps and ratios (reference = NonBlackNonHispanic = "white" proxy)
print('=== TABLE 2: Dollar gaps and ratios (white cohort as reference) ===')
gap_rows = []
for year, col in WAVES.items():
    m = {c: df.loc[df['cohort'] == c, col].median() for c in RACE_MAP.values()}
    for minority in ['Black', 'Hispanic']:
        gap_rows.append({'wave': year, 'comparison': f'NonBlackNonHispanic - {minority}',
                         'gap_$': m['NonBlackNonHispanic'] - m[minority],
                         'ratio_white/minority': m['NonBlackNonHispanic'] / m[minority]})
gaps = pd.DataFrame(gap_rows)
print(gaps.round(2).to_string(index=False))
print()

# ---- 2. Balanced-panel sensitivity (respondents with all three waves) ----
panel_mask = df[wcols].notna().all(axis=1)
panel = df[panel_mask]
print(f'=== TABLE 3: Balanced panel (n={len(panel)} respondents in all three waves) ===')
prows = []
for year, col in WAVES.items():
    med = panel.groupby('cohort')[col].median()
    prows.append({'wave': year, **{c: med[c] for c in ['NonBlackNonHispanic', 'Black', 'Hispanic']}})
panel_tab = pd.DataFrame(prows)
print(panel_tab.round(0).to_string(index=False))
print('Panel gaps/ratios:')
for year, col in WAVES.items():
    m = panel.groupby('cohort')[col].median()
    for minority in ['Black', 'Hispanic']:
        print(f"  {year}: white-{minority} gap = ${m['NonBlackNonHispanic']-m[minority]:,.0f}, "
              f"ratio = {m['NonBlackNonHispanic']/m[minority]:.2f}x")
print()

# ---- 3. Positives-only sensitivity ----
print('=== TABLE 4: Sensitivity - positives-only median (exclude negatives & zeros) ===')
srows = []
for year, col in WAVES.items():
    for cohort in ['NonBlackNonHispanic', 'Black', 'Hispanic']:
        s = df.loc[(df['cohort'] == cohort) & (df[col] > 0), col].dropna()
        srows.append({'wave': year, 'cohort': cohort, 'n_positive': len(s), 'median_pos': s.median()})
pos = pd.DataFrame(srows)
print(pos.round(0).to_string(index=False))
print()

# ---- 4. Asset components (median among owners; secondary material) ----
print('=== TABLE 5: Asset components, median among those with non-missing value, by cohort ===')
comp_rows = []
for year, cols in COMPONENTS.items():
    for col in cols:
        g = df.groupby('cohort')[col].median()
        short = col.split(',')[0] if '1996' not in col.split(',')[0] else col.replace(', 96','').split(',')[0]
        comp_rows.append({'wave': year,
                          'component': col.replace(', 1985','').replace(', 1990','').replace(', 1996','').replace(', 96',''),
                          **{c: g[c] for c in ['NonBlackNonHispanic', 'Black', 'Hispanic']}})
comp = pd.DataFrame(comp_rows)
print(comp.round(0).to_string(index=False))
print()

# ---- 5. Attrition diagnostics ----
print('=== Attrition diagnostics ===')
for year, col in WAVES.items():
    miss = df.groupby('cohort')[col].apply(lambda s: 100 * s.isna().mean())
    print(f'  {year} missing%: ' + ', '.join(f'{c}={miss[c]:.1f}' for c in miss.index))
both = df[df[wcols[0]].notna() & df[wcols[2]].notna()]
print(f'  Observed in BOTH 1985 and 1996: n={len(both)}; cohort shares: '
      f'{both["cohort"].value_counts(normalize=True).round(3).to_dict()}')
# 1985 wealth of those who drop out by 1996 vs stayers
w85 = df['Family net wealth, 1985']
stayers = df[w85.notna() & df[wcols[2]].notna()]['Family net wealth, 1985']
droppers = df[w85.notna() & df[wcols[2]].isna()]['Family net wealth, 1985']
print(f'  1985 median wealth: stayers-to-1996 ${stayers.median():,.0f} (n={len(stayers)}) '
      f'vs dropouts-by-1996 ${droppers.median():,.0f} (n={len(droppers)})')

# Top-code counts
print('=== Top-code check (identical repeated maxima) ===')
for year, col in WAVES.items():
    s = df[col].dropna()
    mx = s.max()
    print(f'  {year}: max={mx:,.0f}, count at max={int((s == mx).sum())}')

# Save tables
with pd.ExcelWriter('nls_wealth_results.xlsx') as xl:
    prim.to_excel(xl, sheet_name='primary_medians', index=False)
    gaps.to_excel(xl, sheet_name='gaps_ratios', index=False)
    panel_tab.to_excel(xl, sheet_name='balanced_panel', index=False)
    pos.to_excel(xl, sheet_name='positives_only', index=False)
    comp.to_excel(xl, sheet_name='components', index=False)
print('\nSaved: nls_wealth_results.xlsx')
