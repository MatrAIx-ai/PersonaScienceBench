"""
NLS SES / BA degree completion analysis.
Question: which variable's effect on BA degree completion changes from 0.3636 to -0.2293
(and becomes insignificant) when race and academic characteristics are added?
"""
import numpy as np, pandas as pd, statsmodels.api as sm, warnings
warnings.filterwarnings('ignore')
pd.set_option('display.width', 220)

df = pd.read_csv('data/nls_ses_processed.csv', index_col=0)
df['BA']    = df['BA DEGREE COMPLETED'].astype(int)
df['FAMSZ'] = df['FAMILY SIZE OF SAMPLE']
df['ASVAB'] = df['ABILITY: COMPOSITE OF ASVAB SCORE']
df['PCTL']  = df['PERCENTILE IN CLASS']
def z(s): return (s-s.mean())/s.std()

print('=== 0. DATA STRUCTURE ===')
print('rows:', len(df), '| missing values: 0 in every column')
print('BA completion rate: %.4f (236/8773)' % df['BA'].mean())
print('Race:', df['SAMPLE_RACE'].value_counts().to_dict())
print('Sex :', df['SAMPLE_SEX'].value_counts().to_dict())
print('Curriculum-like column present:', any('curric' in c.lower() for c in df.columns))
print()

def build(d, race_coding, include_sex, vars_in):
    X = pd.DataFrame(index=d.index)
    if include_sex: X['Female']=(d['SAMPLE_SEX']=='Female').astype(int)
    if race_coding=='dummy':
        X['Black']=(d['SAMPLE_RACE']=='Black').astype(int); X['Hisp']=(d['SAMPLE_RACE']=='Hispanic').astype(int)
    elif race_coding=='effect':
        X['Race_eff']=d['SAMPLE_RACE'].map({'White':0,'Black':1,'Hispanic':-1})
    for v in vars_in: X[v]=d[v]
    X['const']=1.0
    return X.astype(float)

def show(m, title):
    out = pd.DataFrame({'coef':m.params,'p':m.pvalues})
    out['sig'] = np.where(out.p<0.01,'***',np.where(out.p<0.05,'**',np.where(out.p<0.10,'*','')))
    print(title); print(out.to_string(float_format=lambda x:f'{x:.4f}')); print()

# ==== BEST-MATCHING SPEC: probit, SES raw, effect-coded race, no sex control, academic = ASVAB composite ====
print('=== 1. BEST-MATCHING SPEC (probit, effect-coded race, no sex control, academic = ASVAB composite) ===')
X1 = build(df,'none',  False, ['SES','FAMSZ']); m1 = sm.Probit(df['BA'],X1).fit(disp=0)
X3 = build(df,'effect',False, ['SES','FAMSZ','ASVAB']); m3 = sm.Probit(df['BA'],X3).fit(disp=0)
show(m1,'S1 baseline (SES + FAMILY SIZE): SES b=%.4f p=%.3g   [reported baseline: 0.3636]'%(m1.params['SES'],m1.pvalues['SES']))
show(m3,'S3 augmented (+ effect-coded race + ASVAB composite): SES b=%.4f p=%.4g   [reported augmented: -0.2293, insignificant]'%(m3.params['SES'],m3.pvalues['SES']))
m3b = sm.Probit(df['BA'],build(df,'effect',True,['SES','FAMSZ','ASVAB'])).fit(disp=0)
print('Sex control added: SES b=%.4f p=%.4f'%(m3b.params['SES'],m3b.pvalues['SES']))
m3c = sm.Probit(df['BA'],build(df,'dummy',False,['SES','FAMSZ','ASVAB'])).fit(disp=0)
print('Dummy-coded race:  SES b=%.4f p=%.4f'%(m3c.params['SES'],m3c.pvalues['SES']))

# ==== FULL SPEC GRID: SES coefficient S1 vs S3 ====
print()
print('=== 2. SES coefficient, baseline (S1) vs augmented (S3), spec grid ===')
rows=[]
for fam in ['probit','logit','lpm']:
    for std in ['raw','z']:
        for race_coding in ['effect','dummy']:
            for acad in [['ASVAB'],['ASVAB','PCTL']]:
                d=df.copy(); sfx=''
                if std=='z':
                    for v in ['SES','FAMSZ','ASVAB','PCTL']: d[v+'_z']=z(d[v]); sfx='_z'
                basev=['SES'+sfx,'FAMSZ'+sfx]; aug=[a+sfx for a in acad]
                if fam=='lpm':
                    m1g=sm.OLS(d['BA'],build(d,'none',False,basev)).fit(); m3g=sm.OLS(d['BA'],build(d,race_coding,False,basev+aug)).fit()
                elif fam=='probit':
                    m1g=sm.Probit(d['BA'],build(d,'none',False,basev)).fit(disp=0); m3g=sm.Probit(d['BA'],build(d,race_coding,False,basev+aug)).fit(disp=0)
                else:
                    m1g=sm.Logit(d['BA'],build(d,'none',False,basev)).fit(disp=0); m3g=sm.Logit(d['BA'],build(d,race_coding,False,basev+aug)).fit(disp=0)
                rows.append({'model':fam,'std':std,'race':race_coding,'academic':'+'.join(acad),
                             'S1_SES_b':m1g.params['SES'+sfx],'S1_p':m1g.pvalues['SES'+sfx],
                             'S3_SES_b':m3g.params['SES'+sfx],'S3_p':m3g.pvalues['SES'+sfx]})
print(pd.DataFrame(rows).to_string(index=False, float_format=lambda x:f'{x:.4f}'))

# ==== AVERAGE MARGINAL EFFECTS ====
print()
print('=== 3. Average marginal effects of SES (best spec) ===')
for nm, X, fam in [('logit baseline',X1,'Logit'),('logit augmented',X3,'Logit')]:
    m = getattr(sm,fam)(df['BA'],X).fit(disp=0)
    r = m.get_margeff(at='overall').summary_frame().loc['SES']
    print(f'{nm}: SES dy/dx={float(r["dy/dx"]):.4f} p={float(r["Pr(>|z|)"]):.4g}')

# ==== AMBIGUITY CHECK: other predictors ====
print()
print('=== 4. Other predictors, S1 vs S3 (probit best spec) ===')
for v in ['FAMSZ','ASVAB','Race_eff']:
    b1,p1 = m1.params.get(v,np.nan), m1.pvalues.get(v,np.nan)
    b3,p3 = m3.params.get(v,np.nan), m3.pvalues.get(v,np.nan)
    print(f'{v}: S1 b={b1} p={p1:.3g} | S3 b={b3} p={p3:.3g}')
