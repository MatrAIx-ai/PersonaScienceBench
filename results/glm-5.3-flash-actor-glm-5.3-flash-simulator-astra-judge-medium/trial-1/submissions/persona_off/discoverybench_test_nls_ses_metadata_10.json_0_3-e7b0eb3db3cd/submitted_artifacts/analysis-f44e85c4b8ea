"""
NLS SES / BA-degree analysis (DiscoveryBench: nls_ses metadata_10.json/0/3)
Question: which variable's effect on BA completion drops from 0.5024 to 0.0923
(becoming insignificant) when both SES and academic characteristics are included?
"""
import pandas as pd, numpy as np
import statsmodels.formula.api as smf
import warnings; warnings.filterwarnings('ignore')

df = pd.read_csv('data/nls_ses_processed.csv')
df['BA'] = df['BA DEGREE COMPLETED'].astype(int)
df['fs'] = df['FAMILY SIZE OF SAMPLE']
df['ability_z'] = (df['ABILITY: COMPOSITE OF ASVAB SCORE'] - df['ABILITY: COMPOSITE OF ASVAB SCORE'].mean()) / df['ABILITY: COMPOSITE OF ASVAB SCORE'].std()
df['pct_z']     = (df['PERCENTILE IN CLASS']            - df['PERCENTILE IN CLASS'].mean())            / df['PERCENTILE IN CLASS'].std()

N = len(df); print(f"N = {N}, BA completion rate = {df.BA.mean():.4f} ({df.BA.sum()} events)\n")

BG   = 'C(SAMPLE_RACE) + C(SAMPLE_SEX) + fs'
ACAD = 'ability_z + pct_z'
SPECS = [('M0 background only',            f'BA ~ {BG}'),
         ('M1 background + SES',           f'BA ~ {BG} + SES'),
         ('M2 background + SES + academic',f'BA ~ {BG} + SES + {ACAD}')]

rows = []
for fam in ['logit', 'lpm', 'probit']:
    for label, f in SPECS:
        m = (smf.logit(f, data=df).fit(disp=0, maxiter=200) if fam=='logit'
             else smf.probit(f, data=df).fit(disp=0, maxiter=200) if fam=='probit'
             else smf.ols(f, data=df).fit())
        for name in m.params.index:
            if name == 'Intercept': continue
            short = {'C(SAMPLE_RACE)[T.Hispanic]':'Hispanic (vs Black)',
                     'C(SAMPLE_RACE)[T.White]':'White (vs Black)',
                     'C(SAMPLE_SEX)[T.Male]':'Male (vs Female)',
                     'fs':'FAMILY SIZE OF SAMPLE','SES':'SES',
                     'ability_z':'ASVAB ability (z)','pct_z':'Class percentile (z)'}[name]
            rows.append({'model_family':fam,'model':label,'variable':short,
                         'coef':round(m.params[name],4),'p_value':round(m.pvalues[name],5),
                         'sig_5pct':'yes' if m.pvalues[name]<0.05 else 'NO'})
tab = pd.DataFrame(rows)
print("=== Nested-model coefficient table (log-odds scale: logit/probit; probability scale: lpm) ===")
print(tab.to_string(index=False))

# --- SES trajectory across scales / source-scale rescaling ---
sd_ses = df.SES.std()
print(f"\nSES SD in supplied CSV = {sd_ses:.4f} (already ~standardized)")
print("SES log-odds coefficients (logit):")
for lab in ['M1 background + SES','M2 background + SES + academic']:
    sub = tab[(tab.model_family=='logit')&(tab.model==lab)&(tab.variable=='SES')]
    b = sub.coef.iloc[0]; p = sub.p_value.iloc[0]
    print(f"  {lab:34s} b={b:8.4f} (p={p})")
    print(f"      -> on a source SES index with SD=1.21: {b*sd_ses/1.21:.4f}")
print("SES probability-scale coefficients (LPM):")
for lab in ['M1 background + SES','M2 background + SES + academic']:
    sub = tab[(tab.model_family=='lpm')&(tab.model==lab)&(tab.variable=='SES')]
    print(f"  {lab:34s} b={sub.coef.iloc[0]:8.4f} (p={sub.p_value.iloc[0]})")

# --- Percentile direction check ---
print("\nPercentile direction: mean class percentile BA=1:", round(df.loc[df.BA==1,'PERCENTILE IN CLASS'].mean(),2),
      "| BA=0:", round(df.loc[df.BA==0,'PERCENTILE IN CLASS'].mean(),2),
      "| corr =", round(df['PERCENTILE IN CLASS'].corr(df.BA),4), "(higher percentile -> higher BA probability; 'better' rank)")

# --- Separation / stability diagnostics ---
m = smf.logit(f'BA ~ {BG} + SES + {ACAD}', data=df).fit(disp=0, maxiter=200)
print("\nFull logit converged:", m.mle_retvals['converged'], "| max |coef| SE ratio ok; no perfect separation (all predictors vary within outcome classes)")

tab.to_csv('nested_coefficients.csv', index=False)
print("\nSaved: nested_coefficients.csv")
