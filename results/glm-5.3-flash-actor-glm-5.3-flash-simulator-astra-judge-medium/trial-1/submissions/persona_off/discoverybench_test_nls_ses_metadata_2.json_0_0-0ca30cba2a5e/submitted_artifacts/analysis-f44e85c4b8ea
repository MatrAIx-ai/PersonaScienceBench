"""
Analysis: Is the SES -> BA-completion relation affected by race?
Data: data/nls_ses_processed.csv (NLS respondents, N=8,773, no missing values)

Design (agreed with researcher):
1) Primary: logistic regression BA ~ SES_z * race (White reference), joint Wald test
   of interaction terms, individual interaction ORs with 95% CI, predicted
   probabilities by race at +/-1 SD SES.
2) Adjusted model adding ASVAB_z, class percentile, family size, sex (controls may
   be mediators -> direct-effect interpretation).
3) Robustness: SES spline/quintile linearity check, Firth-penalty sensitivity,
   SES-quintile x race descriptive BA rates with counts, sensitivity excluding
   family size == 1.
Note: ASVAB composite is on an undocumented rescaled scale (1,016-3,068; the
documented sum-of-4-rounded-z-scores would span roughly -8..+8); it is standardized
before use.
"""
import numpy as np
import pandas as pd
import statsmodels.api as sm
import statsmodels.formula.api as smf
from scipy import stats
import patsy

CSV = "data/nls_ses_processed.csv"
OUT = "analysis/results_nls_ses.txt"

df = pd.read_csv(CSV)
df = df.drop(columns=[c for c in df.columns if c.startswith("Unnamed")])

BA = "BA DEGREE COMPLETED"
df["ba"] = df[BA].astype(int)
df["ses_z"] = (df["SES"] - df["SES"].mean()) / df["SES"].std()
df["asvab_z"] = (df["ABILITY: COMPOSITE OF ASVAB SCORE"] - df["ABILITY: COMPOSITE OF ASVAB SCORE"].mean()) / df["ABILITY: COMPOSITE OF ASVAB SCORE"].std()
df["race"] = pd.Categorical(df["SAMPLE_RACE"], categories=["White", "Black", "Hispanic"])
df["female"] = (df["SAMPLE_SEX"] == "Female").astype(int)

lines = []
def P(*a):
    s = " ".join(str(x) for x in a)
    lines.append(s)
    print(s)

P("=" * 80)
P("DESCRIPTIVES")
P("=" * 80)
P(f"N = {len(df)}; BA completions = {df.ba.sum()} ({df.ba.mean():.4f})")
P("\nBA rate by race:")
P(df.groupby("race", observed=True)["ba"].agg(["mean", "count"]).to_string())

P("\nBA rate by SES quintile x race (mean, n):")
df["ses_q"] = pd.qcut(df["SES"], 5, labels=["Q1(low)", "Q2", "Q3", "Q4", "Q5(high)"])
tab = df.pivot_table(index="ses_q", columns="race", values="ba", aggfunc=["mean", "count"], observed=True)
P(tab.to_string())

P("\nSES mean (SD) by race:")
P(df.groupby("race", observed=True)["SES"].agg(["mean", "std", "count"]).to_string())

def fit_and_report(formula, data, label):
    P("\n" + "=" * 80)
    P(f"MODEL: {label}")
    P(f"formula: {formula}")
    P("=" * 80)
    m = smf.logit(formula, data=data).fit(disp=0)
    P(m.summary2().tables[1].round(4).to_string())
    P(f"log-lik = {m.llf:.2f}, AIC = {m.aic:.1f}")
    i_terms = [t for t in m.params.index if "ses_z:" in t or ":ses_z" in t]
    if i_terms:
        R = np.zeros((len(i_terms), len(m.params)))
        for k, t in enumerate(i_terms):
            R[k, list(m.params.index).index(t)] = 1.0
        wt = m.wald_test(R, scalar=True)
        P(f"Joint Wald test of interaction terms {i_terms}: chi2 = {float(wt.statistic):.3f}, df = {len(i_terms)}, p = {float(wt.pvalue):.4f}")
    return m

P("\n" + "=" * 80)
P("PRIMARY (UNADJUSTED) MODEL")
P("=" * 80)
m1 = fit_and_report("ba ~ ses_z * C(race)", df, "Unadjusted logistic: BA ~ SES_z * race (White ref)")

P("\nORs with 95% CI (unadjusted):")
or_ci = np.exp(m1.params - 1.96 * m1.bse).to_frame("OR_lo")
or_ci["OR"] = np.exp(m1.params)
or_ci["OR_hi"] = np.exp(m1.params + 1.96 * m1.bse)
P(or_ci.round(3).to_string())

P("\nPredicted BA probability by race at SES_z = -1, 0, +1 (unadjusted model):")
newd = pd.DataFrame([(r, s) for r in ["White", "Black", "Hispanic"] for s in [-1, 0, 1]],
                    columns=["race", "ses_z"])
newd["pred_prob"] = m1.predict(newd.assign(female=0))
P(newd.pivot(index="ses_z", columns="race", values="pred_prob").round(4).to_string())

P("\n" + "=" * 80)
P("ADJUSTED MODEL (controls may be mediators -> direct-effect interpretation)")
P("=" * 80)
df2 = df.rename(columns={"PERCENTILE IN CLASS": "classpct", "FAMILY SIZE OF SAMPLE": "famsize"})
df2["classpct100"] = df2["classpct"] / 100
df2["logfam"] = np.log(df2["famsize"])
m2 = fit_and_report("ba ~ ses_z * C(race) + asvab_z + classpct100 + logfam + female", df2,
                    "Adjusted logistic: BA ~ SES_z * race + ASVAB_z + class pct/100 + log(family size) + sex")
P("\nORs with 95% CI (adjusted):")
or_ci2 = np.exp(m2.params - 1.96 * m2.bse).to_frame("OR_lo")
or_ci2["OR"] = np.exp(m2.params)
or_ci2["OR_hi"] = np.exp(m2.params + 1.96 * m2.bse)
P(or_ci2.round(3).to_string())

P("\nPredicted BA probability by race at SES_z = -1, 0, +1 (adjusted model, covariates at sample means):")
newd["pred_prob_adj"] = m2.predict(newd.assign(female=0, asvab_z=df2.asvab_z.mean(),
                                               classpct100=df2.classpct100.mean(), logfam=df2.logfam.mean()))
P(newd.pivot(index="ses_z", columns="race", values="pred_prob_adj").round(4).to_string())

P("\n" + "=" * 80)
P("ROBUSTNESS 1: SES nonlinearity (cubic spline, 3 df, interacted with race), unadjusted")
P("=" * 80)
y, X = patsy.dmatrices("ba ~ bs(ses_z, df=3, degree=3) * C(race)", df, return_type="dataframe")
m_sp = sm.Logit(y.iloc[:, 0], X).fit(disp=0)
i_cols = [c for c in X.columns if "bs(ses_z" in c and ":" in c]
R = np.zeros((len(i_cols), X.shape[1]))
for k, c in enumerate(i_cols):
    R[k, list(X.columns).index(c)] = 1.0
wt = m_sp.wald_test(R, scalar=True)
P(f"Spline interaction terms: {len(i_cols)}; joint Wald chi2 = {float(wt.statistic):.3f}, df = {len(i_cols)}, p = {float(wt.pvalue):.4f}")

P("\nROBUSTNESS 1b: SES-quintile x race model (unadjusted) - quintile-specific coefficients")
m_q = smf.logit("ba ~ C(ses_q) * C(race)", df).fit(disp=0)
P(m_q.summary2().tables[1].round(4).to_string())

P("\n" + "=" * 80)
P("ROBUSTNESS 2: Firth penalized logistic (primary specification)")
P("=" * 80)

def firth_logit(X, y, tol=1e-8, max_iter=200):
    """Firth penalized logistic regression (Jeffreys prior penalty)."""
    n, p = X.shape
    beta = np.zeros(p)
    for it in range(max_iter):
        eta = X @ beta
        mu = 1 / (1 + np.exp(-eta))
        W = mu * (1 - mu)
        XW = X * W[:, None]
        H = XW @ np.linalg.pinv(X.T @ XW) @ X.T
        h = np.diag(H)
        U = X.T @ ((y - mu) + h * (0.5 - mu))
        J = X.T @ (X * (W + h * (W - (mu - 0.5) ** 2))[:, None])
        step = np.linalg.pinv(J) @ U
        beta = beta + step
        if np.max(np.abs(step)) < tol:
            break
    eta = X @ beta
    mu = 1 / (1 + np.exp(-eta))
    W = mu * (1 - mu)
    XW = X * W[:, None]
    H = XW @ np.linalg.pinv(X.T @ XW) @ X.T
    h = np.diag(H)
    J = X.T @ (X * (W + h * (W - (mu - 0.5) ** 2))[:, None])
    cov = np.linalg.pinv(J)
    return beta, cov, it

Xd = patsy.dmatrix("ses_z * C(race)", df, return_type="dataframe")
beta_f, cov_f, it_f = firth_logit(Xd.values, df["ba"].values.astype(float))
P(f"Firth converged in {it_f} iterations")
names = list(Xd.columns)
P("\nFirth coefficients (log-odds) and ORs:")
for k, nm in enumerate(names):
    se = np.sqrt(cov_f[k, k])
    P(f"  {nm:30s} beta = {beta_f[k]: .4f} (SE {se:.4f})  OR = {np.exp(beta_f[k]):.3f}  CI [{np.exp(beta_f[k]-1.96*se):.3f}, {np.exp(beta_f[k]+1.96*se):.3f}]")
i_idx = [k for k, nm in enumerate(names) if ":" in nm and "ses_z" in nm]
if i_idx:
    R = np.zeros((len(i_idx), len(names)))
    for k, i in enumerate(i_idx):
        R[k, i] = 1.0
    w = R @ beta_f
    Wstat = float(w @ np.linalg.pinv(R @ cov_f @ R.T) @ w)
    P(f"Joint Firth Wald test of interactions: chi2 = {Wstat:.3f}, df = {len(i_idx)}, p = {stats.chi2.sf(Wstat, len(i_idx)):.4f}")

P("\n" + "=" * 80)
P("ROBUSTNESS 3: excluding FAMILY SIZE == 1, unadjusted primary model")
P("=" * 80)
df3 = df[df["FAMILY SIZE OF SAMPLE"] != 1]
P(f"N after exclusion = {len(df3)} (excluded {len(df) - len(df3)})")
m3 = fit_and_report("ba ~ ses_z * C(race)", df3, "Unadjusted logistic excluding family size = 1")

P("\n" + "=" * 80)
P("SUMMARY CONTRASTS (unadjusted): SES slope per +1 SD SES by race")
P("=" * 80)
b = m1.params
V = m1.cov_params().values
idx = list(m1.params.index)
for race, i_term in [("White", None), ("Black", "ses_z:C(race)[T.Black]"), ("Hispanic", "ses_z:C(race)[T.Hispanic]")]:
    if i_term is None:
        est, se = b["ses_z"], m1.bse["ses_z"]
    else:
        est = b["ses_z"] + b[i_term]
        k1, k2 = idx.index("ses_z"), idx.index(i_term)
        se = np.sqrt(V[k1, k1] + V[k2, k2] + 2 * V[k1, k2])
    P(f"  {race:9s}: SES slope log-odds = {est: .4f} (SE {se:.4f}), OR per +1 SD = {np.exp(est):.3f}, 95% CI [{np.exp(est-1.96*se):.3f}, {np.exp(est+1.96*se):.3f}]")

with open(OUT, "w") as f:
    f.write("\n".join(lines))
P(f"\nFull results written to {OUT}")
