"""
Analysis: At what Socioeconomic levels is the advantage in completion rates
for Black students more pronounced?
Dataset: data/nls_ses_processed.csv (NLSY79 secondary-school background data)

Design (approved plan):
  - Primary SES binning: pooled-SES deciles; sensitivity: quartiles (and quintiles).
  - Primary contrast: Black vs non-Black (pooled). Secondary: Black vs White,
    Black vs Hispanic.
  - Raw rate differences with 95% CIs (normal-approx on the difference, plus
    Wilson CIs for each rate).
  - Logistic regression: BA ~ Black * SES-bin (categorical interaction),
    pooled; adjusted sensitivity model adds ASVAB composite, class percentile,
    sex, family size.
"""
import numpy as np
import pandas as pd
import statsmodels.api as sm
from scipy import stats

RNG_SEED = 0

df = pd.read_csv("data/nls_ses_processed.csv")
df["BA"] = df["BA DEGREE COMPLETED"].astype(int)
df["Black"] = (df["SAMPLE_RACE"] == "Black").astype(int)

def wilson_ci(k, n, z=1.96):
    if n == 0: return (np.nan, np.nan)
    p = k / n
    den = 1 + z**2 / n
    c = (p + z**2 / (2 * n)) / den
    h = z * np.sqrt(p * (1 - p) / n + z**2 / (4 * n**2)) / den
    return (max(0, c - h), min(1, c + h))

def diff_ci(k1, n1, k0, n0):
    p1, p0 = k1 / n1, k0 / n0
    se = np.sqrt(p1 * (1 - p1) / n1 + p0 * (1 - p0) / n0)
    return (p1 - p0 - 1.96 * se, p1 - p0 + 1.96 * se)

def strata_table(data, bincol, bin_order=None):
    rows = []
    for q, sub in data.groupby(bincol, observed=True):
        b = sub[sub.SAMPLE_RACE == "Black"]; w = sub[sub.SAMPLE_RACE == "White"]
        h = sub[sub.SAMPLE_RACE == "Hispanic"]; o = sub[sub.SAMPLE_RACE != "Black"]
        row = {
            "bin": q, "n": len(sub),
            "n_Black": len(b), "n_White": len(w), "n_Hisp": len(h),
            "events_Black": int(b.BA.sum()), "events_White": int(w.BA.sum()),
            "events_Hisp": int(h.BA.sum()), "events_Other": int(o.BA.sum()),
            "rate_Black": b.BA.mean(), "rate_White": w.BA.mean(),
            "rate_Hisp": h.BA.mean(), "rate_Other": o.BA.mean(),
            "diff_Black_other": b.BA.mean() - o.BA.mean(),
        }
        lo, hi = diff_ci(int(b.BA.sum()), len(b), int(o.BA.sum()), len(o))
        row["diff_lo"], row["diff_hi"] = lo, hi
        bw_lo, bw_hi = diff_ci(int(b.BA.sum()), len(b), int(w.BA.sum()), len(w))
        row["diff_Black_white"], row["bw_lo"], row["bw_hi"] = b.BA.mean() - w.BA.mean(), bw_lo, bw_hi
        bh_lo, bh_hi = diff_ci(int(b.BA.sum()), len(b), int(h.BA.sum()), len(h))
        row["diff_Black_hisp"], row["bh_lo"], row["bh_hi"] = b.BA.mean() - h.BA.mean(), bh_lo, bh_hi
        rows.append(row)
    out = pd.DataFrame(rows)
    if bin_order is not None:
        out["bin"] = pd.Categorical(out["bin"], bin_order, ordered=True)
        out = out.sort_values("bin")
    return out

print("=" * 100)
print("SECTION 1: Overall rates by race")
print("=" * 100)
print(df.groupby("SAMPLE_RACE")["BA"].agg(["mean", "sum", "count"]).to_string())

# ---- deciles (primary) ----
for k, name in [(10, "SES_decile"), (4, "SES_quartile"), (5, "SES_quintile")]:
    df[name] = pd.qcut(df["SES"], k, labels=False)

print()
print("=" * 100)
print("SECTION 2: Raw stratified rates -- SES DECILES (primary binning)")
print("diff_Black_other = rate(Black) - rate(non-Black pooled); CIs are 95% normal-approx")
print("=" * 100)
dec = strata_table(df, "SES_decile")
pd.set_option("display.width", 250)
print(dec[["bin", "n", "n_Black", "events_Black", "events_Other",
           "rate_Black", "rate_Other", "diff_Black_other", "diff_lo", "diff_hi",
           "diff_Black_white", "diff_Black_hisp"]].round(4).to_string(index=False))

print()
print("=" * 100)
print("SECTION 3: Sensitivity -- SES QUARTILES and QUINTILES")
print("=" * 100)
quart = strata_table(df, "SES_quartile")
print("QUARTILES:")
print(quart[["bin", "n_Black", "events_Black", "rate_Black", "rate_Other",
             "diff_Black_other", "diff_lo", "diff_hi"]].round(4).to_string(index=False))
quint = strata_table(df, "SES_quintile")
print("QUINTILES:")
print(quint[["bin", "n_Black", "events_Black", "rate_Black", "rate_Other",
             "diff_Black_other", "diff_lo", "diff_hi"]].round(4).to_string(index=False))

# ---- logistic regression, unadjusted interaction model ----
print()
print("=" * 100)
print("SECTION 4: Logistic regression, BA ~ Black * SES decile (categorical, ref = decile 0)")
print("=" * 100)
X = pd.get_dummies(df["SES_decile"], prefix="dec", drop_first=True).astype(float)
for c in X.columns:
    X[c + "_xBlack"] = X[c] * df["Black"]
X = sm.add_constant(pd.concat([pd.Series(df["Black"], name="Black"), X], axis=1).astype(float))
m1 = sm.GLM(df["BA"], X, family=sm.families.Binomial()).fit()
print(m1.summary2().tables[1].round(4).to_string())
# marginal Black-vs-other effect within each decile from the interaction model
print()
print("Implied log-odds gap (Black - non-Black) by decile, unadjusted model:")
print("(coefficient on Black + interaction term for that decile)")
for d in range(10):
    if d == 0:
        est, se = m1.params["Black"], m1.bse["Black"]
    else:
        col = f"dec_{d}_xBlack"
        est, se = m1.params["Black"] + m1.params[col], np.sqrt(m1.bse["Black"]**2 + m1.bse[col]**2)
    z = est / se
    print(f"  decile {d}: log-odds gap {est:+.3f} (se {se:.3f}, z {z:+.2f})")

# ---- adjusted model ----
print()
print("=" * 100)
print("SECTION 5: Adjusted model adds ASVAB composite, class percentile, sex, family size")
print("=" * 100)
X2 = X.copy()
X2["asvab"] = (df["ABILITY: COMPOSITE OF ASVAB SCORE"] - df["ABILITY: COMPOSITE OF ASVAB SCORE"].mean()) / df["ABILITY: COMPOSITE OF ASVAB SCORE"].std()
X2["cls_pct"] = (df["PERCENTILE IN CLASS"] - df["PERCENTILE IN CLASS"].mean()) / df["PERCENTILE IN CLASS"].std()
X2["female"] = (df["SAMPLE_SEX"] == "Female").astype(float)
X2["famsize"] = (df["FAMILY SIZE OF SAMPLE"] - df["FAMILY SIZE OF SAMPLE"].mean()) / df["FAMILY SIZE OF SAMPLE"].std()
m2 = sm.GLM(df["BA"], X2, family=sm.families.Binomial()).fit()
print(m2.summary2().tables[1].round(4).to_string())
print()
print("Implied log-odds gap (Black - non-Black) by decile, ADJUSTED model:")
for d in range(10):
    if d == 0:
        est, se = m2.params["Black"], m2.bse["Black"]
    else:
        col = f"dec_{d}_xBlack"
        est, se = m2.params["Black"] + m2.params[col], np.sqrt(m2.bse["Black"]**2 + m2.bse[col]**2)
    z = est / se
    print(f"  decile {d}: log-odds gap {est:+.3f} (se {se:.3f}, z {z:+.2f})")

# ---- top-decile spotlight ----
print()
print("=" * 100)
print("SECTION 6: Top-decile spotlight (raw)")
print("=" * 100)
top = df[df.SES_decile == 9]
b, o = top[top.SAMPLE_RACE == "Black"], top[top.SAMPLE_RACE != "Black"]
print(f"Top decile: Black {int(b.BA.sum())}/{len(b)} = {b.BA.mean():.4f}; "
      f"Other {int(o.BA.sum())}/{len(o)} = {o.BA.mean():.4f}; "
      f"diff {b.BA.mean()-o.BA.mean():+.4f}")
lo, hi = diff_ci(int(b.BA.sum()), len(b), int(o.BA.sum()), len(o))
print(f"95% CI for diff: [{lo:+.4f}, {hi:+.4f}]")
# Fisher exact p for the top decile 2x2
tab = np.array([[int(b.BA.sum()), len(b) - int(b.BA.sum())],
                [int(o.BA.sum()), len(o) - int(o.BA.sum())]])
print("Fisher exact p (top decile 2x2):", stats.fisher_exact(tab)[1])

# Save tables
dec.to_csv("outputs/strata_deciles.csv", index=False)
quart.to_csv("outputs/strata_quartiles.csv", index=False)
quint.to_csv("outputs/strata_quintiles.csv", index=False)
m1.summary2().tables[1].to_csv("outputs/glm_unadjusted.csv")
m2.summary2().tables[1].to_csv("outputs/glm_adjusted.csv")
print()
print("Saved: outputs/strata_deciles.csv, strata_quartiles.csv, strata_quintiles.csv, glm_unadjusted.csv, glm_adjusted.csv")
