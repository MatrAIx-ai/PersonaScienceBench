"""
Supplementary models for the NLS SES / BA-completion analysis.
Fixes the complete-separation problem in the categorical Black x decile model:
  (a) continuous-interaction logistic models (no separation),
  (b) per-decile Fisher exact tests,
  (c) Firth penalized logistic regression per decile (bias-reduced estimates).
"""
import numpy as np
import pandas as pd
import statsmodels.api as sm
from scipy import stats, optimize

df = pd.read_csv("data/nls_ses_processed.csv")
df["BA"] = df["BA DEGREE COMPLETED"].astype(int)
df["Black"] = (df["SAMPLE_RACE"] == "Black").astype(int)
ses_mean, ses_sd = df["SES"].mean(), df["SES"].std()
df["ses_z"] = (df["SES"] - ses_mean) / ses_sd

# ---------- (a) continuous interaction logistic models ----------
print("=" * 95)
print("MODEL A: BA ~ Black * (SES + SES^2)  -- unadjusted, continuous interaction")
print("=" * 95)
def fit_cont(adj):
    X = pd.DataFrame({
        "const": 1.0, "Black": df["Black"], "ses": df["ses_z"], "ses2": df["ses_z"]**2,
    })
    X["Black_x_ses"] = df["Black"] * df["ses_z"]
    X["Black_x_ses2"] = df["Black"] * df["ses_z"]**2
    if adj:
        X["asvab"] = stats.zscore(df["ABILITY: COMPOSITE OF ASVAB SCORE"])
        X["cls_pct"] = stats.zscore(df["PERCENTILE IN CLASS"])
        X["female"] = (df["SAMPLE_SEX"] == "Female").astype(float)
        X["famsize"] = stats.zscore(df["FAMILY SIZE OF SAMPLE"])
    m = sm.GLM(df["BA"], X, family=sm.families.Binomial()).fit()
    return m, X

for adj, label in [(False, "UNADJUSTED"), (True, "ADJUSTED (+ASVAB, class percentile, sex, family size)")]:
    m, X = fit_cont(adj)
    print(f"\n--- {label} ---")
    print(m.summary2().tables[1].round(4).to_string())
    # implied log-odds gap at SES decile midpoints
    print("Implied Black-vs-nonBlack log-odds gap at SES percentile points:")
    for pct, lab in [(5, "5th pct (low)"), (25, "25th"), (50, "50th (median)"), (75, "75th"), (95, "95th pct (high)"), (99, "99th")]:
        s = np.percentile(df["ses_z"], pct)
        b1 = m.params["Black"]; b2 = m.params["Black_x_ses"]; b3 = m.params["Black_x_ses2"]
        est = b1 + b2 * s + b3 * s * s
        # delta-method SE
        g = np.array([1, s, s * s])  # wrt b1, b2, b3
        V = m.cov_params().loc[["Black", "Black_x_ses", "Black_x_ses2"], ["Black", "Black_x_ses", "Black_x_ses2"]].values
        se = np.sqrt(g @ V @ g)
        z = est / se
        print(f"  SES {lab:>16}: gap {est:+.3f} (se {se:.3f}, z {z:+.2f})")

# ---------- (b) per-decile Fisher exact ----------
print()
print("=" * 95)
print("MODEL B: per-decile 2x2 Fisher exact tests, Black vs non-Black")
print("=" * 95)
df["dec"] = pd.qcut(df["SES"], 10, labels=False)
rows = []
for d, sub in df.groupby("dec"):
    b = sub[sub.SAMPLE_RACE == "Black"]; o = sub[sub.SAMPLE_RACE != "Black"]
    tab = np.array([[int(b.BA.sum()), len(b) - int(b.BA.sum())],
                    [int(o.BA.sum()), len(o) - int(o.BA.sum())]])
    orr, p = stats.fisher_exact(tab)
    rows.append({"dec": d, "Black_events": int(b.BA.sum()), "Black_n": len(b),
                 "Other_events": int(o.BA.sum()), "Other_n": len(o),
                 "odds_ratio": orr, "fisher_p": p})
print(pd.DataFrame(rows).round(4).to_string(index=False))

# ---------- (c) Firth penalized logistic per decile ----------
print()
print("=" * 95)
print("MODEL C: Firth penalized logistic per decile -> bias-reduced Black log-odds gap")
print("=" * 95)
def firth_logit(X, y, tol=1e-8, maxit=200):
    n, p = X.shape
    beta = np.zeros(p)
    for _ in range(maxit):
        eta = X @ beta
        mu = 1 / (1 + np.exp(-eta))
        W = mu * (1 - mu)
        W = np.clip(W, 1e-10, None)
        XtW = X.T * W
        H = XtW @ X
        Hinv = np.linalg.pinv(H)
        # hat diagonal
        XWXinv = Hinv
        h = np.einsum("ij,jk,ik->i", X * W, XWXinv, X)
        U = X.T @ (y - mu) + 0.5 * (h * (1 - 2 * mu)) @ X
        step = Hinv @ U
        beta_new = beta + step
        if np.max(np.abs(step)) < tol:
            beta = beta_new
            break
        beta = beta_new
    eta = X @ beta
    mu = 1 / (1 + np.exp(-eta))
    W = np.clip(mu * (1 - mu), 1e-10, None)
    H = (X.T * W) @ X
    cov = np.linalg.pinv(H)
    return beta, cov

rows = []
for d, sub in df.groupby("dec"):
    Xd = np.column_stack([np.ones(len(sub)), (sub.SAMPLE_RACE == "Black").astype(float)])
    # drop the constant-Black case (none here since each decile has both groups)
    beta, cov = firth_logit(Xd, sub.BA.values)
    est, se = beta[1], np.sqrt(cov[1, 1])
    z = est / se if se > 0 else np.nan
    rows.append({"dec": d, "firth_logodds_gap": est, "se": se, "z": z,
                 "p": 2 * (1 - stats.norm.cdf(abs(z))) if np.isfinite(z) else np.nan})
firth = pd.DataFrame(rows)
print(firth.round(4).to_string(index=False))
firth.to_csv("outputs/firth_per_decile.csv", index=False)
print()
print("Note: decile 0 has 0 Black events; Firth correction keeps the estimate finite and")
print("bias-reduced rather than diverging to -infinity (complete separation).")
