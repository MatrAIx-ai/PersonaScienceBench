import numpy as np, pandas as pd
from scipy import stats

df = pd.read_csv("data/nls_ses_processed.csv")
df["BA"] = df["BA DEGREE COMPLETED"].astype(int)
df["dec"] = pd.qcut(df["SES"], 10, labels=False)

def firth_logit(X, y, tol=1e-10, maxit=500):
    p = X.shape[1]
    beta = np.zeros(p)
    for _ in range(maxit):
        eta = X @ beta
        mu = 1/(1+np.exp(-eta))
        W = np.clip(mu*(1-mu), 1e-10, None)
        H = (X.T * W) @ X
        Hinv = np.linalg.pinv(H)
        # hat diagonal: h_i = w_i * x_i' Hinv x_i
        q = (X @ Hinv) * X
        h = W * q.sum(axis=1)
        U = X.T @ (y - mu) + 0.5 * X.T @ ((1 - 2*mu) * h)
        step = Hinv @ U
        beta = beta + step
        if np.max(np.abs(step)) < tol: break
    eta = X @ beta
    mu = 1/(1+np.exp(-eta))
    W = np.clip(mu*(1-mu), 1e-10, None)
    cov = np.linalg.pinv((X.T * W) @ X)
    return beta, cov

rows = []
for d, sub in df.groupby("dec"):
    X = np.column_stack([np.ones(len(sub)), (sub.SAMPLE_RACE=="Black").astype(float)])
    beta, cov = firth_logit(X, sub.BA.values.astype(float))
    est, se = beta[1], np.sqrt(cov[1,1])
    z = est/se
    rows.append({"dec": d, "firth_gap": est, "se": se, "z": z,
                 "p": 2*(1-stats.norm.cdf(abs(z)))})
out = pd.DataFrame(rows)
print(out.round(4).to_string(index=False))
out.to_csv("outputs/firth_per_decile.csv", index=False)
