"""Focused tie-breaking round for target factor -0.9568 (BA degree completion, race contrasts)."""
import itertools, warnings
import numpy as np, pandas as pd, statsmodels.api as sm, statsmodels.formula.api as smf
from scipy.optimize import minimize
from scipy.special import expit
warnings.filterwarnings("ignore")
TARGET=-0.9568
df = pd.read_csv('/workspace/data/nls_ses_processed.csv', index_col=0)
df['BA']=df['BA DEGREE COMPLETED'].astype(int)
RACES=['Hispanic','Black','White']
res_rows=[]

def logit_fit(y,X):
    return sm.Logit(y, sm.add_constant(X,has_constant='add')).fit(disp=0)

def record(lab, contrast, coef, se=np.nan, extra=''):
    res_rows.append(dict(family=lab, contrast=contrast, coef=coef, se=se,
                         dev=abs(coef-TARGET), note=extra))

# ---------- 1. Interactions ----------
# race x sex
for ref in RACES:
    X=pd.get_dummies(df.SAMPLE_RACE,prefix='R').drop(columns=[f'R_{ref}']).astype(float)
    sexf=(df.SAMPLE_SEX=='Female').astype(float)
    for r in [x for x in RACES if x!=ref]:
        X[f'{r}xSEX']=X[f'R_{r}']*sexf
        res=logit_fit(df.BA,X)
        # contrast at Male (sex=0): main effect; at Female: main + interaction
        b=res.params[f'R_{r}']; i=res.params[f'{r}xSEX']
        record(f'logit racexSEX ref={ref}', f'{r} vs {ref} @Male', b, res.bse[f'R_{r}'])
        record(f'logit racexSEX ref={ref}', f'{r} vs {ref} @Female', b+i, res.bse[f'{r}xSEX'])
# race x SES (SES centered)
ses_c=df.SES-df.SES.mean()
for ref in RACES:
    X=pd.get_dummies(df.SAMPLE_RACE,prefix='R').drop(columns=[f'R_{ref}']).astype(float)
    X['SES']=ses_c
    for r in [x for x in RACES if x!=ref]:
        X[f'{r}xSES']=X[f'R_{r}']*ses_c
        res=logit_fit(df.BA,X)
        b=res.params[f'R_{r}']
        # contrast at mean SES = main effect
        record(f'logit racexSES ref={ref}', f'{r} vs {ref} @meanSES', b, res.bse[f'R_{r}'])
        # contrast at SES = +1sd, -1sd
        s1=ses_c.std()
        record(f'logit racexSES ref={ref}', f'{r} vs {ref} @SES+1sd', b+s1*res.params[f'{r}xSES'])
        record(f'logit racexSES ref={ref}', f'{r} vs {ref} @SES-1sd', b-s1*res.params[f'{r}xSES'])

# ---------- 2. Alternative operationalizations ----------
# (a) reversed/rescaled percentile (linear transform: race coefs invariant, confirm)
d2=df.copy(); d2['PCTL_REV']=100-df["PERCENTILE IN CLASS"]
for ref in RACES:
    X=pd.get_dummies(d2.SAMPLE_RACE,prefix='R').drop(columns=[f'R_{ref}']).astype(float)
    X['PCTL_REV']=d2["PCTL_REV"]
    r=logit_fit(d2.BA,X)
    for nm in r.params.index:
        if nm.startswith('R_'):
            record('logit PCTL reversed', f'{nm[2:]} vs {ref}', r.params[nm], r.bse[nm], 'invariance check')
# (b) SES quartiles
q=pd.qcut(df.SES,4,labels=False,duplicates='drop')
for ref in RACES:
    X=pd.get_dummies(df.SAMPLE_RACE,prefix='R').drop(columns=[f'R_{ref}']).astype(float)
    X=pd.concat([X,pd.get_dummies(q,prefix='SESq',drop_first=True).astype(float)],axis=1)
    r=logit_fit(df.BA,X)
    for nm in r.params.index:
        if nm.startswith('R_'):
            record('logit SES quartiles', f'{nm[2:]} vs {ref}', r.params[nm], r.bse[nm])
# (c) SES quartiles + sex; ASVAB z-scored (invariance check)
z=(df['ABILITY: COMPOSITE OF ASVAB SCORE']-df['ABILITY: COMPOSITE OF ASVAB SCORE'].mean())/df['ABILITY: COMPOSITE OF ASVAB SCORE'].std()
for ref in RACES:
    X=pd.get_dummies(df.SAMPLE_RACE,prefix='R').drop(columns=[f'R_{ref}']).astype(float)
    X['ASVABz']=z; X['SESq']=q
    X=pd.concat([X.drop(columns=['SESq']),pd.get_dummies(q,prefix='SESq',drop_first=True).astype(float)],axis=1)
    r=logit_fit(df.BA,X)
    for nm in r.params.index:
        if nm.startswith('R_'):
            record('logit SESq+ASVABz', f'{nm[2:]} vs {ref}', r.params[nm], r.bse[nm])

# ---------- 3. Subsample variants ----------
print('Boundary/extreme rows:')
print('  percentile min/max:', df['PERCENTILE IN CLASS'].min().round(3), df['PERCENTILE IN CLASS'].max().round(3))
print('  SES min/max:', df.SES.min().round(3), df.SES.max().round(3))
print('  fam size values:', sorted(df['FAMILY SIZE OF SAMPLE'].unique()))
print('  ASVAB min/max:', df['ABILITY: COMPOSITE OF ASVAB SCORE'].min(), df['ABILITY: COMPOSITE OF ASVAB SCORE'].max())
print('  CASE ID duplicates:', df['CASE ID'].duplicated().sum())
subs = {
 'drop pct<1 or >99': df[(df['PERCENTILE IN CLASS']>=1)&(df['PERCENTILE IN CLASS']<=99)],
 'drop pct<5 or >95': df[(df['PERCENTILE IN CLASS']>=5)&(df['PERCENTILE IN CLASS']<=95)],
 'drop SES out +/-2.5sd': df[df.SES.abs()<=2.5],
 'drop SES out +/-2sd': df[df.SES.abs()<=2.0],
 'drop fam size==12': df[df['FAMILY SIZE OF SAMPLE']<12],
 'drop ASVAB<=1050': df[df['ABILITY: COMPOSITE OF ASVAB SCORE']>1050],
 'age/ID<=10000 (first cohort)': df[df['CASE ID']<=10000],
}
for lab,sub in subs.items():
    for ref in RACES:
        X=pd.get_dummies(sub.SAMPLE_RACE,prefix='R').drop(columns=[f'R_{ref}']).astype(float)
        r=logit_fit(sub.BA,X)
        for nm in r.params.index:
            if nm.startswith('R_'):
                record(f'subsample {lab} (n={len(sub)})', f'{nm[2:]} vs {ref}', r.params[nm], r.bse[nm])

# ---------- 4. L2-penalized logistic (sklearn-style objective) ----------
# minimize 0.5*||w||^2 + C*sum log(1+exp(-yXw)); intercept unpenalized
def l2_fit(Xc, y, C):
    n,p=Xc.shape
    Xd=np.hstack([np.ones((n,1)),Xc])
    yv=2*y-1
    def obj(w):
        z=Xd@w
        loss=np.sum(np.logaddexp(0,-z*yv))
        pen=0.5*w[1:]@w[1:]
        return C*loss+pen
    def grad(w):
        z=Xd@w; p=expit(z)
        g=Xd.T@(p-y)  # d/dw of loss
        g[1:]=C*g[1:]+w[1:]
        g[0]=C*g[0]
        return g
    w0=np.zeros(p+1)
    r=minimize(obj,w0,jac=grad,method='L-BFGS-B')
    return r.x[1:]
COVS={'SES':df.SES.values,'ASVAB':df['ABILITY: COMPOSITE OF ASVAB SCORE'].values,
      'PCTL':df['PERCENTILE IN CLASS'].values,'SEX':(df.SAMPLE_SEX=='Female').astype(float).values}
for spec,keys in [('race-only',[]),('full',[k for k in COVS])]:
    for ref in RACES:
        Xr=pd.get_dummies(df.SAMPLE_RACE,prefix='R').drop(columns=[f'R_{ref}']).astype(float).values
        Xc=np.hstack([Xr]+[COVS[k][:,None] for k in keys])
        # raw (unscaled) and standardized feature variants
        for lab,Xv in [('raw',Xc),('std',(Xc-Xc.mean(0))/Xc.std(0))]:
            for C in [0.0001,0.0003,0.001,0.003,0.01,0.03,0.1,0.3,1.0,3.0,10.0,100.0]:
                w=l2_fit(Xv,df.BA.values,C)
                # back out race coefs (approx for std: refit is direct on dummies so coef comparable after std? keep raw only for matching, std for info)
                for j,nm in enumerate([f'{r}' for r in RACES if r!=ref]):
                    if lab=='raw':
                        record(f'L2 logit C={C} {spec} raw', f'{nm} vs {ref}', w[j])
                    else:
                        # standardized: coef on std dummy ~ same as raw coef (binary dummy std scales coef)
                        pass
# Also: where does Black-vs-White hit exactly -0.9568 under L2? bisect C
Xr=pd.get_dummies(df.SAMPLE_RACE,prefix='R').drop(columns=['R_White']).astype(float).values
def bw_coef(C):
    w=l2_fit(Xr,df.BA.values,C)
    return w[1]  # column order: Black, Hispanic
lo,hi=1e-4,100.0
for _ in range(60):
    mid=np.sqrt(lo*hi)
    c=bw_coef(mid)
    if c>TARGET: lo=mid
    else: hi=mid
c=bw_coef(mid)
hw=l2_fit(Xr,df.BA.values,mid)
print(f'\nL2-penalized race-only: Black-vs-White = -0.9568 exactly at C ~= {mid:.6g}; '
      f'at that C, Hispanic-vs-White = {hw[0]:.4f} (dev {abs(hw[0]-TARGET):.4f})')

# ---------- 5. summary ----------
t=pd.DataFrame(res_rows).sort_values('dev')
t.to_csv('outputs/tie_break.csv',index=False)
print('\n=== TIE-BREAK: top 20 by |coef-(-0.9568)| ===')
print(t.head(20).to_string(index=False))
print('\nMatches within 1e-3:', len(t[t.dev<1e-3]))
print('Matches within 1e-2:', len(t[t.dev<1e-2]))
print('\nBest dev per candidate pair:')
print(t[t.contrast.str.contains('White')].groupby(t.contrast.str.split(' vs ').str[0]).dev.min())
