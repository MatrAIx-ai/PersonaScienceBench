"""
Analysis: Which two roles have the highest proportion of association with
requirements in ML-enabled systems?

Operationalization (approved plan):
  Primary: Q8_ML_Addressing_* columns ("quoted" = the role addresses ML/RE aspects).
  Denominator: respondents who answered Q8 (exclude -77 skipped rows).
  Bootstrap: 10,000-resample percentile bootstrap, 95% CI per role proportion.
  Sensitivity: Status filter (Completed only; Completed+after-break),
               excluding D4_Role=='0', excluding D4_Role=='Other, which one?'.
  Secondary operationalizations: Q1 (importance of Problem Understanding &
               Requirements) and Q12 (difficulty of Eliciting/Analyzing).
"""
import pandas as pd
import numpy as np

RNG = np.random.default_rng(42)
B = 10_000
DATA = "data/requirements_engineering_for_ML-enabled_systems.csv"

df = pd.read_csv(DATA)
q8_cols = {
    "Project Lead / Project Manager": "Q8_ML_Addressing_Project_Lead",
    "Business Analyst":               "Q8_ML_Addressing_Business_Analyst",
    "Requirements Engineer":          "Q8_ML_Addressing_Requirement_Engineer",
    "Solution Architect":             "Q8_ML_Addressing_Solution_Architect",
    "Data Scientist":                 "Q8_ML_Addressing_Data_Scientist",
    "Developer":                      "Q8_ML_Addressing_Developer",
    "Tester":                         "Q8_ML_Addressing_Tester",
    "Other (free text)":              "Q8_ML_Addressing_Others",
}

def q8_proportions(d, label, boot=True):
    rows = []
    # respondent-level validity: answered Q8 at all (first col != -77)
    answered = d[d["Q8_ML_Addressing_Project_Lead"] != "-77"]
    n = len(answered)
    for role, col in q8_cols.items():
        s = answered[col]
        k = int((s == "quoted").sum())
        p = 100.0 * k / n
        rec = {"subset": label, "role": role, "n_respondents": n,
               "n_quoted": k, "proportion_pct": round(p, 3)}
        if boot:
            x = (s == "quoted").astype(int).to_numpy()
            idx = RNG.integers(0, n, size=(B, n))
            stats = x[idx].mean(axis=1) * 100.0
            lo, hi = np.percentile(stats, [2.5, 97.5])
            rec["ci95_low"] = round(lo, 3)
            rec["ci95_high"] = round(hi, 3)
        rows.append(rec)
    return pd.DataFrame(rows)

def sens_proportions(d, label):
    return q8_proportions(d, label, boot=False)

# ---------------- Primary analysis ----------------
primary = q8_proportions(df, "all_276 (Q8 answered: n varies per row)")
primary_sorted = primary.sort_values("proportion_pct", ascending=False)
print("=== PRIMARY: all respondents, denominators = Q8 respondents (n=194) ===")
print(primary_sorted.to_string(index=False))

top2 = primary_sorted.head(2)
print("\nTop-2 roles:", list(top2["role"]),
      "at", list(top2["proportion_pct"]), "%")

# ---------------- Sensitivity analyses ----------------
sens_frames = []
sens_frames.append(sens_proportions(df[df["Status"] == "Completed (31)"],
                                    "Status=Completed (n=164)"))
sens_frames.append(sens_proportions(df[df["Status"] != "Suspended (22)"],
                                    "Completed+after-break (n=188)"))
sens_frames.append(sens_proportions(df[df["D4_Role"] != "0"],
                                    "exclude D4_Role=='0'"))
sens_frames.append(sens_proportions(df[df["D4_Role"] != "Other, which one?"],
                                    "exclude D4_Role=='Other'"))
sens_frames.append(sens_proportions(df[~df["D4_Role"].isin(["0", "Other, which one?"])],
                                    "exclude '0' and 'Other'"))
sens = pd.concat(sens_frames, ignore_index=True)
print("\n=== SENSITIVITY (point estimates only) ===")
piv = sens.pivot_table(index="role", columns="subset",
                       values="proportion_pct").round(2)
print(piv.to_string())

# ---------------- Secondary operationalizations ----------------
# Q1: importance of "Problem Understanding and Requirements" per role (High/Extremely)
print("\n=== SECONDARY: Q1 Problem Understanding & Requirements (High/Extremely Relevant), by D4_Role ===")
for role, g in df[df["D4_Role"] != "0"].groupby("D4_Role"):
    s = g["Q1_ML_Life_Cycle_Importance_Problem_Understanding"]
    s = s[~s.isin(["I don't know", "0", "-77", "-99"])]
    if len(s):
        print(f"  {role:35s} n={len(s):3d}  {100*s.isin(['High Relevance','Extremely Relevant']).mean():.1f}%")

# Q12: difficulty of Eliciting & Analyzing requirements, by D4_Role
print("\n=== SECONDARY: Q12 'Eliciting/Analyzing' quoted, by D4_Role ===")
for role, g in df[df["D4_Role"] != "0"].groupby("D4_Role"):
    s = g["Q12_ML_Most_Difficult_Activity_Eliciting_Analyzing"]
    s = s[s != "-77"]
    if len(s):
        print(f"  {role:35s} n={len(s):3d}  {100*(s=='quoted').mean():.1f}% quoted")

# ---------------- Save ----------------
primary_sorted.to_csv("outputs/q8_primary_proportions_ci.csv", index=False)
sens.to_csv("outputs/q8_sensitivity_proportions.csv", index=False)
print("\nSaved outputs/q8_primary_proportions_ci.csv and outputs/q8_sensitivity_proportions.csv")
