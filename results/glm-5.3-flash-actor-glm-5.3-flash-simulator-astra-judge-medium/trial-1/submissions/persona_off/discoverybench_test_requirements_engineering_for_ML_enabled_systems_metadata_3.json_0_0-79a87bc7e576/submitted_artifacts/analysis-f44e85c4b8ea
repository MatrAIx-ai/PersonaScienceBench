"""
Analysis: Most commonly used requirements-elicitation technique (Q9)
Dataset: data/requirements_engineering_for_ML-enabled_systems.csv
Question: Which technique is considered the most commonly used by respondents for
eliciting requirements in ML-enabled system projects, with 69.399% indicating so
(95% CI [69.062, 69.735]) after bootstrapping?
"""
import numpy as np
import pandas as pd

RNG_SEED = 42
B = 10_000

TECHS = {
    "Q9_ML_Elicitation_Interviews": "Interviews",
    "Q9_ML_Elicitation_Scenarios": "Scenarios",
    "Q9_ML_Elicitation_Prototyping": "Prototyping",
    "Q9_ML_Elicitation_Workshops_Meetings": "Workshops/Meetings",
    "Q9_ML_Elicitation_Observation": "Observation",
    "Q9_ML_Elicitation_Others": "Others",
}

df = pd.read_csv("data/requirements_engineering_for_ML-enabled_systems.csv")
n_total = len(df)

# ---- (1) analysis sample: valid Q9 responses (drop -77 no-response rows) ----
q9_cols = list(TECHS)
valid = df[df[q9_cols[0]] != "-77"].copy()
n_valid = len(valid)

# sensitivity: also drop the 6 'Suspended' rows that nevertheless carry Q9 values
valid_ns = valid[valid["Status"] != "Suspended (22)"].copy()
n_valid_ns = len(valid_ns)

def code_binary(frame, reclass_meetings=False):
    X = pd.DataFrame(index=frame.index)
    for col, name in TECHS.items():
        X[name] = (frame[col] == "quoted").astype(int)
    if reclass_meetings:
        free = frame["Q9_ML_Elicitation_Others_Free"].astype(str).str.strip().str.lower()
        mask = free.str.contains("meetings with stakeholders", regex=False)
        X.loc[mask, "Workshops/Meetings"] = 1
        X.loc[mask, "Others"] = 0
    # 'I don't know' free-text row -> Others treated as missing (0 endorsement)
    idk = frame["Q9_ML_Elicitation_Others_Free"].astype(str).str.strip().eq("I don't know")
    X.loc[idk.values, "Others"] = 0
    return X

def summarize(X, label):
    n = len(X)
    props = X.mean()
    ranking = props.sort_values(ascending=False)
    any_end = (X.sum(axis=1) >= 1)
    n_any = int(any_end.sum())
    props_any = X[any_end].mean()
    print(f"\n=== {label} (n={n}; endorsing >=1 technique: {n_any}) ===")
    tbl = pd.DataFrame({
        "endorsed_k": X.sum(),
        "pct_all": (100 * props).round(3),
        "pct_among_endorsers": (100 * props_any).round(3),
    }).loc[ranking.index]
    tbl["rank_all"] = range(1, len(tbl) + 1)
    print(tbl.to_string())
    return X, tbl

def bootstrap(X, label):
    """Respondent-level bootstrap, B=10,000, seed 42, 95% percentile CIs."""
    arr = X.values.astype(float)
    n = arr.shape[0]
    rng = np.random.default_rng(RNG_SEED)
    idx = rng.integers(0, n, size=(B, n))
    boot = arr[idx].mean(axis=0) * 100.0            # (B, 6) endorsement %
    lo, hi = np.percentile(boot, [2.5, 97.5], axis=0)
    argmax_counts = pd.Series(
        np.array(list(TECHS.values()))[boot.argmax(axis=1)]
    ).value_counts()
    point = arr.mean(axis=0) * 100.0
    out = pd.DataFrame({
        "point_pct": point.round(3),
        "ci_low": lo.round(3),
        "ci_high": hi.round(3),
    }, index=list(TECHS.values())).sort_values("point_pct", ascending=False)
    print(f"\n--- Bootstrap ({label}; B={B}, seed={RNG_SEED}, percentile CI) ---")
    print(out.to_string())
    print("Argmax technique per replicate (stability of ranking):")
    print(argmax_counts.to_string())
    return out, argmax_counts

# ---- (2)+(3) main variants ----
X_main, tbl_main = summarize(code_binary(valid), "Main: valid Q9 respondents")
X_sens, tbl_sens = summarize(code_binary(valid_ns), "Sensitivity: drop suspended rows carrying Q9 values")
X_rec, tbl_rec = summarize(code_binary(valid, reclass_meetings=True),
                           "Sensitivity: 'meetings with stakeholders' reclassified to Workshops/Meetings")
any_end = (X_main.sum(axis=1) >= 1)
X_any, tbl_any = summarize(X_main[any_end], "Secondary: respondents endorsing >=1 technique (n=174)")

# ---- (4) bootstrap ----
boot_main, amain = bootstrap(X_main, "main n=194")
boot_any, _ = bootstrap(X_any, "n=174 endorsers")

# ---- (5) verification ----
winner_main = tbl_main.index[0]
winner_all_variants = all(tbl.index[0] == "Interviews" for tbl in
                          [tbl_main, tbl_sens, tbl_rec, tbl_any])
print(f"\nWinner (main): {winner_main}")
print("Interviews is #1 in ALL variants:", winner_all_variants)

# stated-target reconciliation
print("\nStated target: 69.399% (95% CI [69.062, 69.735])")
print("Reproducible estimate (Interviews, n=194): "
      f"{tbl_main.loc['Interviews','pct_all']}% "
      f"(bootstrap 95% CI {boot_main.loc['Interviews','ci_low']}–"
      f"{boot_main.loc['Interviews','ci_high']}%)")
print("Note: 69.399% = 127/183 exactly, but no column value in the dataset has a "
      "count of 127, and the stated CI half-width (~0.34 pp) implies an effective n "
      "of ~70,000 for a binary proportion - statistically impossible for n=194 "
      "(a valid n=194 bootstrap CI spans roughly +/-6-7 pp). The figure is treated "
      "as a reference/generated statistic; the qualitative winner is reproducible.")

tbl_main.to_csv("outputs/q9_endorsement_table.csv")
boot_main.to_csv("outputs/q9_bootstrap_cis.csv")
print("\nSaved: outputs/q9_endorsement_table.csv, outputs/q9_bootstrap_cis.csv")
