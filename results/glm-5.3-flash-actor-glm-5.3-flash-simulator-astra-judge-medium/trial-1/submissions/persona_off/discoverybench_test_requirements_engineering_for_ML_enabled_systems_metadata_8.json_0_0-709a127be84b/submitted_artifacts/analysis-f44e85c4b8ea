"""
Least-used documentation formats for requirements in ML-enabled system projects
(Q10_ML_Documentation_* block, requirements_engineering_for_ML-enabled_systems.csv)

Primary analysis : usage = 'quoted' among the 194 respondents who answered Q10;
                   respondent-level bootstrap (B=10,000, seed=2024), 95% percentile CI
                   (+ BCa robustness).
Sensitivities    : 276-row denominator (skipped = non-use); among the 150 respondents
                   who use >=1 substantive documentation format; share-of-total-mentions.
Reconciliation   : systematic pass over denominator/definition variants to test whether
                   the quoted target figures (10.13% CI[9.926,10.333] and
                   4.366% CI[4.231,4.501]) are reproducible from this CSV.
"""
import numpy as np
import pandas as pd
from scipy import stats

SEED, B = 2024, 10000
rng = np.random.default_rng(SEED)

df = pd.read_csv('data/requirements_engineering_for_ML-enabled_systems.csv')
Q10 = [c for c in df.columns if c.startswith('Q10_ML_Documentation') and not c.endswith('_Free')]
short = {c: c.replace('Q10_ML_Documentation_', '') for c in Q10}
X = (df[Q10] == 'quoted')
valid = df[Q10].ne('-77').all(axis=1).values          # 194 respondents answered Q10

NAMED = ['Vision_Document','Requirements_Lists','Goal_Models','Use_Case_Models',
         'Prototypes','User_Stories','BDD_Scenarios','MLCanvas','Notebooks','Data_Models']
cols_named = [c for c in Q10 if short[c] in NAMED]

def boot_ci(x, stat=np.mean, B=B):
    """percentile + BCa 95% CI for the mean of a binary vector"""
    x = np.asarray(x, float); x = x[~np.isnan(x)]
    idx = rng.integers(0, len(x), size=(B, len(x)))
    reps = x[idx].mean(axis=1)
    lo, hi = np.percentile(reps, [2.5, 97.5])
    # BCa (standard: lower limit uses z_{alpha/2} = -1.96, upper +1.96)
    theta = x.mean()
    n = len(x)
    z0 = stats.norm.ppf((reps < theta).mean())
    jack = np.array([np.delete(x, i).mean() for i in range(n)])
    d = jack.mean() - jack
    a = (d ** 3).sum() / (6 * (d ** 2).sum() ** 1.5)
    z = 1.959963985
    a_lo = stats.norm.cdf(z0 + (z0 - z) / (1 - a * (z0 - z)))
    a_hi = stats.norm.cdf(z0 + (z0 + z) / (1 - a * (z0 + z)))
    lo_b, hi_b = np.percentile(reps, [100 * a_lo, 100 * a_hi])
    return theta, lo, hi, lo_b, hi_b

print('=' * 100)
print('PRIMARY ANALYSIS - usage rate among the 194 respondents who answered Q10')
print('=' * 100)
rows = []
for c in Q10:
    x = X[c].values[valid].astype(float)
    p, lo, hi, lob, hib = boot_ci(x)
    rows.append(dict(format=short[c], k=int(x.sum()), n=int(len(x)),
                     p_pct=100 * p, lo=100 * lo, hi=100 * hi,
                     bca_lo=100 * lob, bca_hi=100 * hib))
prim = pd.DataFrame(rows).sort_values('p_pct')
print(prim.to_string(index=False, float_format=lambda v: f'{v:.3f}'))

print('\nRanking of NAMED formats (Others/Not_Documented reported separately):')
rank = prim[prim.format.isin(NAMED)].reset_index(drop=True)
print(rank.head(4).to_string(index=False, float_format=lambda v: f'{v:.3f}'))
print('Tie check: MLCanvas and Others both k=15 (7.732%) - Others is a catch-all, excluded from ranking.')

print('\n' + '=' * 100)
print('SENSITIVITIES')
print('=' * 100)
print('\n(a) denominator = all 276 rows (-77 treated as non-use):')
sens276 = pd.DataFrame({'format': [short[c] for c in Q10],
                        'k': [int(X[c].sum()) for c in Q10],
                        'p_pct': [100 * X[c].mean() for c in Q10]}).sort_values('p_pct')
print(sens276.to_string(index=False, float_format=lambda v: f'{v:.3f}'))

doc_any = X[cols_named].any(axis=1).values & valid
print(f'\n(b) among the {doc_any.sum()} respondents who use >=1 substantive documentation format:')
for c in cols_named:
    print(f"   {short[c]:20s} {X.loc[doc_any, c].sum():3d}  {100*X.loc[doc_any, c].mean():.3f}%")

tot = int(X[Q10].values[valid].sum())
print(f'\n(c) share of total documentation-format mentions (total mentions = {tot}):')
for c in Q10:
    print(f"   {short[c]:20s} {100 * X[c].values[valid].sum() / tot:.3f}%")

print('\n' + '=' * 100)
print('RECONCILIATION PASS - can 10.13% (CI 9.926-10.333) / 4.366% (CI 4.231-4.501) be reproduced?')
print('=' * 100)
T1, T2, HW1, HW2 = 0.1013, 0.04366, 0.00204, 0.00135   # targets & CI half-widths
report = []

def check(label, p1, p2, note=''):
    ok1 = abs(p1 - T1) <= 5e-4; ok2 = abs(p2 - T2) <= 5e-4
    report.append((label, round(100 * p1, 4), round(100 * p2, 4), ok1, ok2, note))

# 1. integer-count scan over plausible denominators (HYPOTHETICAL pairs a,b that would be
#    needed to hit the targets - checked afterwards against counts actually observed in Q10)
for n in [150, 158, 164, 190, 194, 195, 225, 276, 286, 296, 298]:
    a = round(T1 * n); b = round(T2 * n)
    check(f'counts a={a},b={b} over n={n}', a / n, b / n,
          f'actual rates {a/n:.5f}, {b/n:.5f}; max |a/n-10.13%|={abs(a/n-T1)*100:.3f}pp')

# 2. observed per-format rates under every subset tested in inspection
subsets = {'all 276': np.ones(len(df), bool), 'valid Q10 (194)': valid,
           'Completed only (164)': (df['Status'] == 'Completed (31)').values & valid,
           'no sentinel 0 anywhere (225)': (~(df == '0').any(axis=1).values) & valid,
           'no -77 anywhere (190)': (~(df == '-77').any(axis=1).values) & valid}
for name, m in subsets.items():
    ps = {short[c]: X.loc[m, c].mean() for c in Q10}
    two = sorted(ps.items(), key=lambda kv: kv[1])[:3]
    check(f'rates on subset: {name}', two[0][1], two[1][1],
          f'two smallest: {two[0][0]} {two[0][1]*100:.3f}%, {two[1][0]} {two[1][1]*100:.3f}%')

# 3. share-of-total-mentions variants
for tot_name, totv in [('all 12 options (416)', tot),
                       ('11 doc formats (386)', int(X[cols_named].values[valid].sum())),
                       ('10 named formats (371)', int(X[[c for c in cols_named if short[c] != 'Others']].values[valid].sum()))]:
    sh = {short[c]: X[c].values[valid].sum() / totv for c in Q10 if short[c] != 'Not_Documented'}
    two = sorted(sh.items(), key=lambda kv: kv[1])[:3]
    check(f'share of mentions, {tot_name}', two[0][1], two[1][1],
          f'two smallest shares: {two}')

# 4. alternative reading of quoted/not-quoted (inverted coding)
ps_inv = {short[c]: 1 - X.loc[valid, c].mean() for c in Q10}
two = sorted(ps_inv.items(), key=lambda kv: kv[1])[:2]
check("inverted coding ('not quoted' = used)", two[0][1], two[1][1], 'two smallest inverted rates')

# 5. CI-width plausibility for ANY respondent-level proportion, n<=276
for n in [194, 276]:
    for p in [T1, T2]:
        se = np.sqrt(p * (1 - p) / n)
        hw = 1.96 * se * 100
        report.append((f'expected bootstrap CI half-width, n={n}, p={p*100:.3f}%', np.nan, np.nan,
                       False, False, f'~+/-{hw:.3f}pp vs target half-widths 0.204pp/0.135pp'))
n_eff1 = T1 * (1 - T1) / (HW1 / 1.96) ** 2
n_eff2 = T2 * (1 - T2) / (HW2 / 1.96) ** 2
report.append(('implied effective sample size from target CI half-widths', np.nan, np.nan, False, False,
               f'~{n_eff1:,.0f} and ~{n_eff2:,.0f} observations - impossible for n<=276'))

rec = pd.DataFrame(report, columns=['variant', 'stat1_%', 'stat2_%', 'matches_10.13', 'matches_4.366', 'note'])
print(rec.to_string(index=False))
n_match = rec[['matches_10.13', 'matches_4.366']].values.sum()
obs_counts = sorted(int(X[c].values[valid].sum()) for c in Q10)
hyp = [(r['stat1_%'], r['stat2_%'], r['variant']) for _, r in rec.iterrows()
       if (r['matches_10.13'] or r['matches_4.366']) and r['variant'].startswith('counts')]
real_match = [h for h in hyp if round(h[0] / 100 * 276) in obs_counts and round(h[1] / 100 * 276) in obs_counts]
print(f'\nVariants flagged as numerically compatible: {len(hyp)} - but these are HYPOTHETICAL integer pairs.')
print(f'Q10 counts actually observed (over 194 or 276): {obs_counts}')
print(f'Compatible pairs realised by observed Q10 counts: {len(real_match)} -> '
      + ('REPRODUCIBLE' if real_match else 'NOT REPRODUCIBLE from this CSV by any tested variant'))

# our actual bootstrap CI widths, for contrast
bdd = rank.iloc[0]; mlc = rank[rank.format == 'MLCanvas'].iloc[0]
print(f"\nOur percentile CIs: BDD {bdd.lo:.3f}-{bdd.hi:.3f}% (half-width ~{(bdd.hi-bdd.lo)/2:.2f}pp), "
      f"MLCanvas {mlc.lo:.3f}-{mlc.hi:.3f}% (half-width ~{(mlc.hi-mlc.lo)/2:.2f}pp)")

print('\n' + '=' * 100)
print('FINAL RESULT')
print('=' * 100)
print(f"Least used      : BDD Scenarios  {bdd.p_pct:.3f}% (95% percentile CI {bdd.lo:.3f}-{bdd.hi:.3f}%; BCa {bdd.bca_lo:.3f}-{bdd.bca_hi:.3f}%)")
print(f"Second least    : ML Canvas      {mlc.p_pct:.3f}% (95% percentile CI {mlc.lo:.3f}-{mlc.hi:.3f}%; BCa {mlc.bca_lo:.3f}-{mlc.bca_hi:.3f}%)")
print("('Others' free-form catch-all ties ML Canvas at 15/194 and is reported separately;")
print(" 'Not_Documented' (30/194, 15.46%) indicates 15.5% of respondents do not document at all.)")
