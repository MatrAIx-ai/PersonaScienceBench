"""Main analysis: effect of education expenditure on per-capita GDP,
Lower middle income (LMC, proxy for developing countries) vs Sub-Saharan Africa (SSA).
Data-grounded, group-level WDI panel 1975-2015."""
import json, warnings
import numpy as np, pandas as pd
import statsmodels.api as sm
from statsmodels.tsa.stattools import adfuller
from statsmodels.stats.stattools import durbin_watson
warnings.filterwarnings('ignore')

CSV = 'data/worldbank_education_gdp.csv'
YRS = list(range(1975, 2016))
GNI, EDU, EXP = 'gni_pc', 'edu_share', 'exp_growth'
PRIM, SEC, LFP = 'prim_enr', 'sec_enr', 'lfpr'
NAME2KEY = {
    'GNI per capita (constant 2015 USdollar)': GNI,
    'Adjusted savings: education expenditure (percentage of GNI)': EDU,
    'Exports of goods and services (annual percentage growth)': EXP,
    'School enrollment, primary (percentage gross)': PRIM,
    'School enrollment, secondary (percentage gross)': SEC,
    'Labor force participation rate, total (percentage of total population ages 15+) (modeled ILO estimate)': LFP,
}

# ---------- 1. Load & reshape ----------
df = pd.read_csv(CSV, na_values=['..', ''])
df.columns = list(df.columns[:4]) + YRS
long = df.melt(id_vars=['Country Group', 'Series Name'], value_vars=YRS,
               var_name='year', value_name='value')
long['key'] = long['Series Name'].map(NAME2KEY)
panel = long.pivot_table(index=['Country Group', 'year'], columns='key', values='value').reset_index()
panel = panel.rename(columns={'Country Group': 'group'})
panel = panel.sort_values(['group', 'year']).reset_index(drop=True)
panel['ssa'] = (panel['group'] == 'Sub-Saharan Africa').astype(int)
for c in [GNI, EDU, SEC]:
    panel[f'dlog_{c}' if c == GNI else f'd_{c}'] = panel.groupby('group')[c].transform(lambda s: s.diff())
panel['dlog_gni'] = panel.groupby('group')[GNI].transform(lambda s: np.log(s).diff()) * 100
panel['d_edu'] = panel.groupby('group')[EDU].transform('diff')
panel['lag_edu'] = panel.groupby('group')[EDU].shift(1)
panel['lag_dlog_gni'] = panel.groupby('group')['dlog_gni'].shift(1)
panel['d_sec'] = panel.groupby('group')[SEC].transform('diff')
panel['d_lfp'] = panel.groupby('group')[LFP].transform('diff')
panel['log_gni'] = np.log(panel[GNI])

out = {}
lmc = panel[panel.group == 'Lower middle income'].set_index('year')
ssa = panel[panel.group == 'Sub-Saharan Africa'].set_index('year')

def adf(s, name):
    s = s.dropna()
    r = adfuller(s, regression='c', autolag='AIC')
    return {'series': name, 'n': int(len(s)), 'adf_stat': round(r[0], 3), 'p': round(r[1], 4)}

# ---------- 2. Diagnostics ----------
diag = {'adf': [adf(lmc[GNI], 'LMC gni level'), adf(lmc['dlog_gni'], 'LMC dlog_gni'),
                adf(lmc[EDU], 'LMC edu level'), adf(lmc['d_edu'], 'LMC d_edu'),
                adf(ssa[EDU], 'SSA edu level')]}
X0 = sm.add_constant(lmc[[EDU]].dropna()); y0 = lmc.loc[X0.index, GNI]
diag['dw_naive_level_ols_LMC'] = round(durbin_watson(sm.OLS(y0, X0).fit().resid), 3)
out['diagnostics'] = diag

def fit(d, y, xs, lags=5):
    d = d[[y] + xs].dropna()
    m = sm.OLS(d[y], sm.add_constant(d[xs])).fit(cov_type='HAC', cov_kwds={'maxlags': lags})
    return m, len(d)

def rep(m, n, tag):
    rows = []
    for k in m.params.index:
        rows.append({'term': k, 'b': round(m.params[k], 5), 'se': round(m.bse[k], 5),
                     't': round(m.tvalues[k], 2), 'p': round(m.pvalues[k], 4)})
    r = {'model': tag, 'n': n, 'r2': round(m.rsquared, 3), 'coefs': rows,
         'dw_resid': round(durbin_watson(m.resid), 2)}
    print(f"\n[{tag}] n={n} R2={m.rsquared:.3f} DW={r['dw_resid']}")
    for row in rows: print("   ", row)
    return r

models = []
# ---------- 3. LMC main models ----------
m, n = fit(lmc, 'dlog_gni', ['lag_edu'])
models.append(rep(m, n, 'LMC-FD1: dlog_gni ~ lag_edu'))
m, n = fit(lmc, 'dlog_gni', ['lag_dlog_gni', 'lag_edu'])
models.append(rep(m, n, 'LMC-ADL: dlog_gni ~ lag_dlog_gni + lag_edu'))
m, n = fit(lmc, 'dlog_gni', ['lag_edu', 'd_sec'])
models.append(rep(m, n, 'LMC-FD2: dlog_gni ~ lag_edu + d_sec'))
m, n = fit(lmc.loc[1992:], 'dlog_gni', ['lag_edu', 'd_sec', EXP, 'd_lfp'])
models.append(rep(m, n, 'LMC-FD3 (1992+, all controls): dlog_gni ~ lag_edu + d_sec + exp_growth + d_lfp'))
m, n = fit(lmc.loc[1992:], 'dlog_gni', ['lag_dlog_gni', 'lag_edu', 'd_sec', EXP, 'd_lfp'])
models.append(rep(m, n, 'LMC-ADL2 (1992+, all controls)'))
out['lmc_models'] = models

# ---------- 4. Common window 2011-2015 ----------
cw = panel[(panel.year >= 2011) & (panel.year <= 2015)].copy()
summ = cw.groupby('group').agg(gni_first=('gni_pc', 'first'), gni_last=('gni_pc', 'last'),
                               edu_mean=('edu_share', 'mean'), sec_mean=('sec_enr', 'mean'))
summ['gni_growth_pct_11_15'] = 100 * (summ.gni_last / summ.gni_first - 1)
print("\n[Common window 2011-2015 summary]"); print(summ.round(3).to_string())
out['common_window_summary'] = summ.round(3).reset_index().to_dict('records')

# pooled level model with interaction (10 obs)
cw2 = cw[['year', 'ssa', 'log_gni', 'edu_share']].dropna().sort_values('year')
Xi = cw2[['edu_share', 'ssa']].copy(); Xi['ssa_x_edu'] = Xi.ssa * Xi.edu_share
mi = sm.OLS(cw2['log_gni'], sm.add_constant(Xi)).fit(cov_type='HAC', cov_kwds={'maxlags': 2})
out['interaction_level_model'] = rep(mi, len(cw2), 'Pooled 2011-15 levels: log_gni ~ edu + ssa + ssa:edu')

# block bootstrap (resample whole years jointly, B=5000, iid-year block)
rng = np.random.default_rng(42)
years = cw2.year.unique(); B = 5000; bs = []
Xm = sm.add_constant(Xi).values; yv = cw2['log_gni'].values
for b in range(B):
    ys = rng.choice(years, size=len(years), replace=True)
    idx = np.concatenate([np.where(cw2.year.values == y)[0] for y in ys])
    try:
        bs.append(sm.OLS(yv[idx], Xm[idx]).fit().params[list(Xm.columns).index('ssa_x_edu') + 1
                   if isinstance(Xm, np.ndarray) else -1].item() if False else
                  sm.OLS(yv[idx], Xm[idx]).fit().params[3])
    except Exception:
        pass
bs = np.array(bs)
out['interaction_bootstrap'] = {'B': int(len(bs)), 'point': round(mi.params['ssa_x_edu'], 4),
    'ci95': [round(float(np.percentile(bs, 2.5)), 4), round(float(np.percentile(bs, 97.5)), 4)],
    'p_two_sided': round(float(2 * min((bs <= 0).mean(), (bs >= 0).mean())), 4)}
print("\n[Interaction ssa_x_edu block bootstrap]", out['interaction_bootstrap'])

# growth-model descriptive for common window
gw = panel[(panel.year >= 2012) & (panel.year <= 2015)]
print("\n[Mean dlog_gni & d_edu 2012-2015]")
gs = gw.groupby('group')[['dlog_gni', 'd_edu']].mean().round(3)
print(gs.to_string()); out['common_window_growth'] = gs.reset_index().to_dict('records')

# ---------- 5. Long-horizon trajectory evidence ----------
traj = {}
for g, d in [('Sub-Saharan Africa', ssa), ('Lower middle income', lmc)]:
    t = {}
    t['edu_share_mean'] = round(d[EDU].mean(), 2)
    t['edu_share_1975_85_mean'] = round(d.loc[1975:1985, EDU].mean(), 2)
    t['edu_share_2005_15_mean'] = round(d.loc[2005:2015, EDU].mean(), 2)
    for c, nm in [(PRIM, 'prim'), (SEC, 'sec')]:
        t[f'{nm}_enr_1975'] = round(d.loc[1975, c], 1); t[f'{nm}_enr_2015'] = round(d.loc[2015, c], 1)
        t[f'{nm}_gain'] = round(t[f'{nm}_enr_2015'] - t[f'{nm}_enr_1975'], 1)
    if d[GNI].notna().sum() > 10:
        t['gni_pc_1975'] = round(d.loc[1975, GNI], 1); t['gni_pc_2015'] = round(d.loc[2015, GNI], 1)
        t['gni_pc_growth_pct'] = round(100 * (t['gni_pc_2015'] / t['gni_pc_1975'] - 1), 1)
        t['avg_dlog_gni_pct'] = round(d['dlog_gni'].mean(), 2)
    traj[g] = t
print("\n[Trajectory]"); print(json.dumps(traj, indent=1))
out['trajectory'] = traj

# LMC decade income growth
dec = lmc.groupby((lmc.index // 5) * 5)['dlog_gni'].mean().round(2)
out['lmc_5yr_avg_growth'] = dec.to_dict()
print("\n[LMC avg annual dlog_gni by 5-yr period]"); print(dec.to_string())

# corr of d_edu with dlog_gni per group (full and common window)
for tag, d in [('LMC 1976-2015', lmc), ('SSA 2012-2015', ssa.loc[2012:])]:
    dd = d[['dlog_gni', 'd_edu']].dropna()
    print(f"corr(d_edu, dlog_gni) {tag}: n={len(dd)} r={dd.d_edu.corr(dd.dlog_gni):.3f}")

out['overlap_note'] = 'SSA aggregate is largely a subset of LMC aggregate -> non-independent groups'
out['metadata_note'] = "datasets.json says '% of total expenditure'; actual series NY.ADJ.AEDU.GN.ZS is '% of GNI'"

json.dump(out, open('analysis/results.json', 'w'), indent=1, default=str)
print("\nSaved analysis/results.json")
