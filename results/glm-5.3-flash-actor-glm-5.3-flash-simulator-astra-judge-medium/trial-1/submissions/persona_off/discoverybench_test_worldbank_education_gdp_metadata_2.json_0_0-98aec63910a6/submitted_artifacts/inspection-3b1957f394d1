"""Initial inspection of data/worldbank_education_gdp.csv (DiscoveryBench episode)."""
import pandas as pd, numpy as np

CSV = 'data/worldbank_education_gdp.csv'
raw = pd.read_csv(CSV, dtype=str)
df = pd.read_csv(CSV, na_values=['..', ''])
yrs = list(range(1975, 2016))
df.columns = list(df.columns[:4]) + yrs

print(f"shape={df.shape}; groups={df['Country Group'].unique().tolist()} "
      f"codes={df['Country Code'].unique().tolist()}")
print(f"'..' placeholder cells: {raw.isin(['..']).sum().sum()}")
print("\nSeries x group with coverage (n/41, first..last year, min..max):")
for g in df['Country Group'].unique():
    print(f"\n[{g}]")
    sub = df[df['Country Group'] == g].set_index('Series Name')[yrs]
    for s in sub.index:
        a = sub.loc[s].dropna()
        rng = f"{a.min():.3f}..{a.max():.3f}" if len(a) else "-"
        print(f"  {s[:70]:<70} n={len(a):>2} {a.index.min()}..{a.index.max()}  [{rng}]")
