"""
Analysis: How does age influence the likelihood of withdrawing more money
from savings than putting in? (NLSY79, 1989 cross-section, ages 24-32)

Primary model: logit of DISSAVED on AGE, AGE_2 (as supplied), log(1+INCOME),
GENDER, BMI, BLACK, HISPANIC; robust (HC1) SEs.
Robustness: age-bin rates with 95% CIs, SAMESAVE-excluded re-estimation,
exclusion of mean-imputed INCOME/BMI rows, linear-in-age logit,
BMI>60 handling variant.
"""
import numpy as np
import pandas as pd
import statsmodels.api as sm
from scipy import stats

df = pd.read_csv('data/nls_bmi_processed.csv')
n = len(df)

# ---------- helpers ----------
def fit_logit(d, formula_cols, add_const=True):
    X = d[formula_cols].copy()
    X.insert(0, 'const', 1.0)
    y = d['DISSAVED']
    m = sm.Logit(y, X).fit(disp=0, cov_type='HC1')
    return m

def age_profile(coefs, ages=range(24,33)):
    """p(dissaved|age) partial effect of age at each age, holding covariates fixed:
    logit = b0 + b1*a + b2*a^2 (+ covariate terms, common across ages)."""
    b1, b2 = coefs['AGE'], coefs['AGE_2']
    out = []
    for a in ages:
        dlogit = b1 + 2*b2*a
        p = 1/(1+np.exp(-(b1*a + b2*a*a)))
        # marginal effect on probability holding other covs at a common baseline:
        # compute at mean of covariates below.
        out.append((a, dlogit, p))
    return out

def marginal_effects_at_covmeans(m, d, ages=range(24,33)):
    """Predicted P(DISSAVED=1) by age with covariates at sample means,
    and discrete difference between adjacent ages."""
    X = d[['AGE','AGE_2','LINC','FEMALE','BMI','BLACK','HISPANIC']].copy()
    X.insert(0,'const',1.0)
    Xc = X.mean()
    rows=[]
    for a in ages:
        xc = Xc.copy(); xc['AGE']=a; xc['AGE_2']=a*a
        p = m.predict(xc.to_frame().T)[0]
        rows.append((a,p))
    ps = np.array([r[1] for r in rows])
    diffs = np.diff(ps)
    return rows, diffs

df['LINC'] = np.log1p(df['INCOME'])
df['FEMALE'] = (df['GENDER']=='FEMALE').astype(int)

results = {}

# ---------- 1. PRIMARY model: all-inclusive ----------
cols = ['AGE','AGE_2','LINC','FEMALE','BMI','BLACK','HISPANIC']
m1 = fit_logit(df, cols)
print("=== PRIMARY: logit DISSAVED ~ AGE + AGE_2 + covariates (all-inclusive), HC1 ===")
print(m1.summary2().tables[1].round(4))
results['primary'] = m1
prof, diffs = marginal_effects_at_covmeans(m1, df)
print("\nPredicted P(dissaved) by age (covariates at means):")
for (a,p),d in zip(prof,diffs):
    print(f"  age {a}: p={p:.4f}  dP vs prev age={d:+.4f}")
# turning point of quadratic: a* = -b1/(2*b2)
b1,b2 = m1.params['AGE'], m1.params['AGE_2']
print(f"\nQuadratic turning point (in fitted logit): age* = {-b1/(2*b2):.2f}")

# average marginal effect of AGE (numerical, over all obs)
X = df[cols].copy(); X.insert(0,'const',1.0)
def p_of_age(Xdf, a):
    Xd = Xdf.copy(); Xd['AGE']=a; Xd['AGE_2']=a*a
    return m1.predict(Xd)
ame = (p_of_age(X, 32).mean() - p_of_age(X, 24).mean())/8
print(f"Average marginal effect of 1 extra year of age (24->32 slope): {ame:+.4f} per year")

# ---------- 2. Age-bin descriptive rates with 95% CIs ----------
print("\n=== Age-bin rates with 95% CI (Wilson) ===")
bins = [(24,26),(27,29),(30,32)]
for lo,hi in bins:
    sub = df[(df.AGE>=lo)&(df.AGE<=hi)]
    k, nn = sub.DISSAVED.sum(), len(sub)
    p = k/nn
    se = np.sqrt(p*(1-p)/nn)
    print(f"  {lo}-{hi}: rate={p:.3f} ({k}/{nn})  95% CI=[{p-1.96*se:.3f},{p+1.96*se:.3f}]")

# ---------- 3. SAMESAVE-excluded secondary model ----------
d2 = df[df.SAMESAVE==0]
m2 = fit_logit(d2, cols)
print(f"\n=== SECONDARY: excluding SAMESAVE=1 (n={len(d2)}) ===")
print(m2.summary2().tables[1].round(4))
prof2, diffs2 = marginal_effects_at_covmeans(m2, d2)
print("Predicted P(dissaved) by age (covariates at means):")
for (a,p),d in zip(prof2,diffs2):
    print(f"  age {a}: p={p:.4f}  dP vs prev age={d:+.4f}")
b1b,b2b = m2.params['AGE'], m2.params['AGE_2']
print(f"Turning point: age* = {-b1b/(2*b2b):.2f}")

# raw rates by age within SAMESAVE==0 subsample
print("\nDISSAVED rate by age among SAMESAVE==0:")
print(d2.groupby('AGE')['DISSAVED'].agg(['mean','count']).round(3))

# ---------- 4. Exclude mean-imputed INCOME/BMI rows ----------
INC_MEAN, BMI_MEAN = 47.27906396881807, 25.158945822012686
d3 = df[(np.abs(df.INCOME-INC_MEAN)>1e-9) & (np.abs(df.BMI-BMI_MEAN)>1e-9)]
m3 = fit_logit(d3, cols)
print(f"\n=== ROBUSTNESS: excluding mean-imputed INCOME & BMI rows (n={len(d3)}) ===")
print(m3.summary2().tables[1][['Coef.','Std.Err.','P>|z|']].round(4))
prof3,_ = marginal_effects_at_covmeans(m3, d3)
print("Predicted P by age:", [f"{a}:{p:.4f}" for a,p in prof3])

# ---------- 5. Linear-in-age logit (primary sample) ----------
m4 = fit_logit(df, ['AGE','LINC','FEMALE','BMI','BLACK','HISPANIC'])
print("\n=== ROBUSTNESS: linear-in-age logit (all-inclusive) ===")
print(m4.summary2().tables[1][['Coef.','Std.Err.','P>|z|']].round(4))

# ---------- 6. BMI>60 handling variant ----------
d5 = df[df.BMI<=60]
m5 = fit_logit(d5, cols)
print(f"\n=== ROBUSTNESS: dropping BMI>60 rows (n={len(d5)}) ===")
print(m5.summary2().tables[1][['Coef.','Std.Err.','P>|z|']].round(4))

# ---------- 7. Imputation-flag augmented primary model ----------
df['INC_IMPUTED'] = (np.abs(df.INCOME-INC_MEAN)<1e-9).astype(int)
df['BMI_IMPUTED'] = (np.abs(df.BMI-BMI_MEAN)<1e-9).astype(int)
m6 = fit_logit(df, cols+['INC_IMPUTED','BMI_IMPUTED'])
print("\n=== ROBUSTNESS: primary + imputation flags ===")
print(m6.summary2().tables[1][['Coef.','Std.Err.','P>|z|']].round(4))

# ---------- Model comparison table (age coefficients) ----------
print("\n=== Summary: AGE & AGE_2 coefficients across specifications (HC1 SEs) ===")
rows=[]
for name,m,dd in [('Primary (all-inclusive)',m1,df),('Excl. SAMESAVE=1',m2,d2),
                  ('Excl. imputed rows',m3,d3),('Linear-in-age (AGE coef)',m4,df),
                  ('Excl. BMI>60',m5,d5),('Primary + imputation flags',m6,df)]:
    r = {'model':name,'n':len(dd)}
    for v in ['AGE','AGE_2']:
        if v in m.params.index:
            r[v]=f"{m.params[v]:+.4f} (SE {m.bse[v]:.4f}, p={m.pvalues[v]:.3f})"
    rows.append(r)
print(pd.DataFrame(rows).to_string(index=False))

# ---------- Diagnostics ----------
print("\n=== Diagnostics ===")
print(f"Primary: pseudo-R2={m1.prsquared:.4f}, LL={m1.llf:.1f}, converged={m1.mle_retvals['converged']}")
print(f"Secondary: pseudo-R2={m2.prsquared:.4f}, LL={m2.llf:.1f}, converged={m2.mle_retvals['converged']}")
print("VIF on primary design:")
from statsmodels.stats.outliers_influence import variance_inflation_factor
Xv = df[cols].copy(); Xv.insert(0,'const',1.0)
print(pd.Series({c: variance_inflation_factor(Xv.values,i) for i,c in enumerate(Xv.columns) if c!='const'}).round(2))

# save results table
pd.DataFrame(rows).to_csv('outputs/model_comparison.csv', index=False)
prof_df = pd.DataFrame({'AGE':[a for a,_ in prof],'p_primary':[p for _,p in prof],
                        'p_excl_samesave':[p for _,p in prof2],'p_excl_imputed':[p for _,p in prof3]})
prof_df.to_csv('outputs/age_profile.csv', index=False)
print("\nSaved outputs/model_comparison.csv and outputs/age_profile.csv")
