"""
Does increased time preference lead to higher BMI?
Data: NLSY79 extract (data/nls_raw.csv), 12,686 respondents x 61 columns.

Time-preference proxy (no direct measure in data): 1989 savings behavior
  - net flow  = put-in amount (else 0) - took-out amount (else 0), winsorized
  - ordinal   = 1 put more in / 2 took more out / 3 no change / 4 no savings
  - log amount variants (log1p of amounts)
Primary BMI uses weight read as POUNDS converted to kg (x0.453592), height in
inches; sensitivity uses the literal-kg reading from the metadata dictionary.

Models:
  A. Cross-sectional OLS at 1989: BMI1989 ~ savings measure (+ covariates)
  B. 4-category savings contrast vs BMI1989 (unadjusted + adjusted)
  C. Within-person change: dBMI(89-81) and dBMI(92-89) ~ savings + covariates
Diagnostics: sample sizes, cleaning counts, attrition/covariate balance.
"""
import numpy as np, pandas as pd, statsmodels.formula.api as smf, json, warnings
warnings.filterwarnings("ignore")

COL = {
 "id":"ID# (range 1-12686) 1979",
 "age79":"Age of respondent, 1979",
 "occ14":"Occupation of adult male in household at age 14, 1979",
 "momed":"Highest grade completed by respondent's mother, 1979",
 "daded":"Highest grade completed by respondent's father, 1979",
 "educ79":"Highest grade completed, 1979",
 "sample":"Sample ID, 1979 (interview)",
 "race":"Racial/ethnic cohort, 1979",
 "sex":"Sex of respondent, 1979",
 "famsize":"Family size, 1979",
 "inc79":"Total net family income, previous calendar year, 1979",
 "inc85":"Total net family income, previous calendar year, 1985",
 "inc89":"Total net family income, previous calendar year, 1989",
 "h81":"Height of respondent, 1981","h85":"Height of respondent, 1985",
 "w81":"Weight of respondent, 1981","w89":"Weight of respondent, 1989",
 "w92":"Weight of respondent, 1992",
 "res89":"Type of residence respondent is living in, 1989",
 "res85":"Type of residence respondent is living in, 1985",
 "res81":"Type of residence respondent is living in, 1981",
 "res92":"Type of residence respondent is living in, 1992",
 "savcat":"Was more money put into or taken out of R/spouse savings since last interview, 1989",
 "put":"Net amount respondent/spouse put into savings since last interview, 1989",
 "out":"Net amount respondent/spouse took out of savings since last interview, 1989",
 "wealth85":"Family net wealth, 1985",
}
df = pd.read_csv("data/nls_raw.csv").rename(columns={v: k for k, v in COL.items()})
log = {"n_rows": len(df)}

# ---------- height cleaning ----------
h = df["h81"].astype("Int64")
df["h81_in"] = (h // 100 * 12 + h % 100).astype(float)
df.loc[(df["h81_in"] < 48) | (df["h81_in"] > 84), "h81_in"] = np.nan
df["h85_in"] = df["h85"].where(df["h85"].between(48, 84))
# prefer 1985 height where both exist, else 1981 (closest to 1989 BMI is 1985)
df["height_in"] = df["h85_in"].fillna(df["h81_in"])

# ---------- weight cleaning ----------
W_LO, W_HI = 70, 500          # pounds, plausible adult range
for y, c in [("81","w81"),("89","w89"),("92","w92")]:
    s = df[c].where(df[c].between(W_LO, W_HI))
    df[f"w{y}_lb"] = s
    df[f"w{y}_kg"] = s * 0.453592          # primary reading: pounds -> kg
    df[f"w{y}_kg_lit"] = s                 # literal-kg sensitivity reading

log["w89_out_of_range_trimmed"] = int((~df["w89"].isna() & df["w89_kg"].isna()).sum())
log["h81_bad_format"] = int((~df["h81"].isna() & df["h81_in"].isna()).sum())

# ---------- BMI ----------
df["bmi89"]    = df["w89_kg"]     / (df["height_in"]*0.0254)**2
df["bmi89lit"] = df["w89_kg_lit"] / (df["height_in"]*0.0254)**2
df["bmi81"]    = df["w81_kg"]     / (df["height_in"]*0.0254)**2
df["bmi92"]    = df["w92_kg"]     / (df["height_in"]*0.0254)**2
for b in ["bmi89","bmi81","bmi92"]:
    df.loc[~df[b].between(15, 60), b] = np.nan

# ---------- savings (time-preference proxy), 1989 ----------
df["savcat"] = df["savcat"].where(df["savcat"].isin([1,2,3,4]))
put = df["put"].where(df["put"] > 0, 0)
out = df["out"].where(df["out"] > 0, 0)
# consistency guard: amounts should only appear for matching category
put_ok = df["put"].notna() & (df["savcat"] == 1)
out_ok = df["out"].notna() & (df["savcat"] == 2)
put = put.where(put_ok, 0); out = out.where(out_ok, 0)
cap = 100000.0
put_c = put.clip(upper=cap); out_c = out.clip(upper=cap)
df["netflow89"] = put_c - out_c                      # positive = net saving
df["logflow89"] = np.sign(df["netflow89"]) * np.log1p(np.abs(df["netflow89"]))
df["logput89"]  = np.log1p(put_c.where(put_ok, 0))
df["logout89"]  = np.log1p(out_c.where(out_ok, 0))
df["saver"]     = (df["savcat"] == 1).astype(float).where(df["savcat"].notna())
# 4-category dummies (ref = took money out, cat 2)
for k, lab in [(1,"in"),(3,"same"),(4,"none")]:
    df[f"sav_{lab}"] = (df["savcat"] == k).astype(float).where(df["savcat"].notna())

# ---------- covariates ----------
df["male"]      = (df["sex"] == 1).astype(float)
df["black"]     = (df["race"] == 1).astype(float)
df["hispanic"]  = (df["race"] == 2).astype(float)
df["age89"]     = df["Age of respondent at interview date, 1989"]
df["educ"]      = df["educ79"].where(df["educ79"] <= 20)          # 95 = missing code
df["momed"]     = df["momed"].where(df["momed"] <= 20)
df["daded"]     = df["daded"].where(df["daded"] <= 20)
df["inc89_c"]   = df["inc89"].clip(upper=100000) / 1000.0         # topcode-aware, $k
df["logwealth85"] = np.log1p(df["wealth85"].clip(lower=0))
df["ever_jail"] = ((df["res89"] == 5) | (df["res85"] == 5) | (df["res81"] == 5) | (df["res92"] == 5)).astype(float)
df["logflow89_c"] = df["logflow89"]                                # centered below

COV = ["male","black","hispanic","age89","educ","momed","daded","famsize",
       "inc89_c","logwealth85","ever_jail"]

def fit(formula, data):
    d = data.dropna(subset=[v for v in ["bmi89","bmi81","bmi92","netflow89","savcat"] if v in formula])
    m = smf.ols(formula, data=d).fit(cov_type="HC1")
    return m, d

res = {}
# ---------- A. cross-sectional 1989 ----------
for tag, x in [("netflow89","netflow89"),("logflow89","logflow89"),("saver","saver")]:
    m_u, d = fit(f"bmi89 ~ {x}", df)
    m_a, _ = fit(f"bmi89 ~ {x} + " + " + ".join(COV), df)
    res[f"A_{tag}_unadj"] = dict(n=int(m_u.nobs), b=float(m_u.params[x]), se=float(m_u.bse[x]), p=float(m_u.pvalues[x]))
    res[f"A_{tag}_adj"]   = dict(n=int(m_a.nobs), b=float(m_a.params[x]), se=float(m_a.bse[x]), p=float(m_a.pvalues[x]))

# ---------- B. 4-category contrast (ref = took money out) ----------
m_u, d = fit("bmi89 ~ sav_in + sav_same + sav_none", df)
m_a, _ = fit("bmi89 ~ sav_in + sav_same + sav_none + " + " + ".join(COV), df)
for m, key in [(m_u,"B_cat_unadj"),(m_a,"B_cat_adj")]:
    res[key] = dict(n=int(m.nobs),
        coefs={k: dict(b=float(m.params[k]), se=float(m.bse[k]), p=float(m.pvalues[k]))
               for k in ["sav_in","sav_same","sav_none"]})

# ---------- C. within-person change ----------
df["dbmi_89_81"] = df["bmi89"] - df["bmi81"]
df["dbmi_92_89"] = df["bmi92"] - df["bmi89"]
for tag, y, base in [("89_81","dbmi_89_81","bmi81"),("92_89","dbmi_92_89","bmi89")]:
    for x in ["netflow89","logflow89"]:
        m_u, _ = fit(f"{y} ~ {x}", df)
        m_a, _ = fit(f"{y} ~ {x} + {base} + " + " + ".join(COV), df)
        res[f"C_{tag}_{x}_unadj"] = dict(n=int(m_u.nobs), b=float(m_u.params[x]), se=float(m_u.bse[x]), p=float(m_u.pvalues[x]))
        res[f"C_{tag}_{x}_adj"]   = dict(n=int(m_a.nobs), b=float(m_a.params[x]), se=float(m_a.bse[x]), p=float(m_a.pvalues[x]))

# ---------- D. attrition / covariate balance ----------
df["has89"] = df["bmi89"].notna().astype(int)
df["all3"]  = (df["bmi81"].notna() & df["bmi89"].notna() & df["bmi92"].notna()).astype(int)
bal = {}
for g, col in [("weight1989_observed","has89"),("all_three_weights","all3")]:
    t = df.groupby(col)[["male","black","hispanic","age89","educ","savcat","inc89_c"]].mean().round(3)
    bal[g] = json.loads(t.to_json(orient="index"))
res["D_balance"] = bal
res["D_n"] = dict(full=len(df), has_bmi89=int(df["has89"].sum()),
                  has_all_three=int(df["all3"].sum()),
                  complete_case_cs=int((df["bmi89"].notna() & df["savcat"].notna()).sum()))

# ---------- E. literal-kg sensitivity (cross-sectional, adjusted) ----------
m_lit, _ = fit("bmi89lit ~ netflow89 + " + " + ".join(COV), df)
res["E_literal_kg_netflow_adj"] = dict(n=int(m_lit.nobs), b=float(m_lit.params["netflow89"]),
                                       se=float(m_lit.bse["netflow89"]), p=float(m_lit.pvalues["netflow89"]))

# ---------- F. descriptive summary ----------
desc = {
 "bmi89_mean_primary_lb_reading": round(float(df["bmi89"].mean()),2),
 "bmi89_mean_literal_kg_reading": round(float(df["bmi89lit"].mean()),2),
 "bmi89_sd": round(float(df["bmi89"].std()),2),
 "n_bmi89": int(df["bmi89"].notna().sum()),
 "netflow89_median": float(df["netflow89"].median()),
 "netflow89_mean": round(float(df["netflow89"].mean()),0),
 "savcat_counts": df["savcat"].value_counts().sort_index().astype(int).to_dict(),
}
res["F_desc"] = desc

with open("analysis/results.json","w") as f: json.dump(res, f, indent=1, default=str)
print(json.dumps(res, indent=1, default=str))
