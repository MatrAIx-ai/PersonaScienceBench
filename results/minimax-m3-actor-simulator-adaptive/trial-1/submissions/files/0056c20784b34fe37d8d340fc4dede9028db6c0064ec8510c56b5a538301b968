"""Inspection & cross-verification script for the amber-peak question.

Purpose: load all three datasets, summarize shape/time coverage/missingness,
cross-verify Amber vs Zamber at overlapping 100-year bins, and pinpoint
the peak Amber value, its bins, and the corresponding millennium.

This script is the analysis artifact for the DiscoveryBench
"discoverybench/test/archaeology/metadata_8.json/0/0" task:
"In which millennium did amber have the highest value and in what time
interval did it peak?"
"""
import pandas as pd
import numpy as np

# -------------------------------------------------------------------
# 1. Load datasets
# -------------------------------------------------------------------
df_pollen = pd.read_csv("data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv")
df_ts = pd.read_csv("data/time_series_data.csv")
df_cap = pd.read_csv("data/capital.csv")

print("pollen file shape:", df_pollen.shape,
      " CE range:", df_pollen['CE'].min(), "to", df_pollen['CE'].max(),
      " calBP range:", df_pollen['calBP'].min(), "to", df_pollen['calBP'].max(),
      " amber cols present:",
      [c for c in df_pollen.columns if 'amber' in c.lower()])

print("time_series shape:", df_ts.shape,
      " CE range:", df_ts['CE'].min(), "to", df_ts['CE'].max(),
      " calBP range:", df_ts['calBP'].min(), "to", df_ts['calBP'].max(),
      " Amber nulls:", df_ts['Amber'].isna().sum(),
      "/", len(df_ts),
      " Amber_inter nulls:", df_ts['Amber_inter'].isna().sum(),
      "/", len(df_ts))

print("capital shape:", df_cap.shape,
      " BCE range:", df_cap['BCE'].min(), "to", df_cap['BCE'].max(),
      " (= CE range:", -df_cap['BCE'].max(), "to", -df_cap['BCE'].min(), ")",
      " Zamber nulls:", df_cap['Zamber'].isna().sum(),
      "/", len(df_cap))

# -------------------------------------------------------------------
# 2. Cross-verify Amber (time_series) vs Zamber (capital)
# -------------------------------------------------------------------
df_cap['Zamber_num'] = df_cap['Zamber'].astype(str).str.replace(',', '.').astype(float)
df_cap['CE_derived'] = -df_cap['BCE']

merged = df_ts[['CE', 'Amber', 'Amber_inter']].merge(
    df_cap[['CE_derived', 'BCE', 'Zamber', 'Zamber_num']],
    left_on='CE', right_on='CE_derived', how='inner')

diff = (merged['Amber'] - merged['Zamber_num']).abs()
print("\nAmber vs Zamber at 37 overlapping 100-year bins: max |diff| =",
      diff.max(), "  identical?", bool((diff < 1e-9).all()))

# -------------------------------------------------------------------
# 3. Peak amber identification (raw binned values, study convention)
# -------------------------------------------------------------------
peak_z = df_ts['Amber'].max()
peak_rows = df_ts.loc[df_ts['Amber'] == peak_z, ['CE', 'calBP', 'Amber']]
print(f"\nMax Amber Z-value: {peak_z}")
print("Peak bins (ordered by CE descending → BCE ascending):")
print(peak_rows.sort_values('CE').to_string(index=False))

# Contiguous peak run in 100-year bins
peak_ce = sorted(peak_rows['CE'].tolist(), reverse=True)  # oldest first
print(f"Peak CE range (descending): {peak_ce[-1]} to {peak_ce[0]}  "
      f"= {abs(peak_ce[-1])} BCE to {abs(peak_ce[0])} BCE")

# Millennium classification
def millennium_label(ce):
    if ce < 0:  # BCE
        bce = -ce
        m = (bce - 1) // 1000 + 1
        return f"{m}th millennium BCE ({1000*(m-1)+1}-{1000*m} BCE)"
    m = (ce - 1) // 1000 + 1
    return f"{m}th millennium CE ({1000*(m-1)+1}-{1000*m} CE)"

print("\nMillennium classification of each peak bin:")
for ce in peak_ce:
    print(f"  CE={ce} (BCE={-ce}) -> {millennium_label(ce)}")

# Cross-check on the interpolated series
peak_inter = df_ts['Amber_inter'].max()
print(f"\nMax Amber_inter (interpolated 1-yr): {peak_inter}, "
      f"# rows at max: {(df_ts['Amber_inter'] == peak_inter).sum()}")
