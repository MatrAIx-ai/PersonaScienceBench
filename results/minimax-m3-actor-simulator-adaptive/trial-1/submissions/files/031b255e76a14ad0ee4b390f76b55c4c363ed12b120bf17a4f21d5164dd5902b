"""
DiscoveryBench / metadata_15 — UK proportion analysis.

Question:  What proportion of original studies in Experimental Economics
           were conducted in the United Kingdom?

Approach (researcher-approved):
    (1) Subset to project=='ee' in the study CSV (18 rows, id-unique,
        no missing experiment_country.o).
    (2) Apply a defensive UK-equivalence set, case- and whitespace-insensitive:
        {united kingdom, uk, gb, great britain, england, scotland, wales,
         northern ireland, united kingdom of great britain and northern ireland}.
    (3) Denominator = 18 ee rows (studies, not subjects; no weighting by n.o).
    (4) No drop==True filter, but report its count within ee for transparency.
    (5) Report proportion, numerator, denominator, matching studies, edge cases.
"""

from __future__ import annotations
import json
import pandas as pd
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
CSV  = ROOT / "data" / "meta-regression_study_data_heterogeneity_in_replication_projects.csv"

# --- 1. Load -----------------------------------------------------------------
sd = pd.read_csv(CSV)
print(f"Loaded study CSV : shape={sd.shape}")
print(f"Columns          : {list(sd.columns)}")

# --- 2. Subset to ee ---------------------------------------------------------
ee = sd[sd["project"] == "ee"].copy()
print(f"\nee subset rows  : {len(ee)}")
print(f"ee unique ids    : {ee['id'].nunique()}")
print(f"ee missing country.o : {ee['experiment_country.o'].isna().sum()}")

# --- 3. Defensive UK-equivalence rule, case/whitespace-insensitive ----------
UK_SET = {
    "united kingdom",
    "uk",
    "gb",
    "great britain",
    "england",
    "scotland",
    "wales",
    "northern ireland",
    "united kingdom of great britain and northern ireland",
}
def is_uk(val: object) -> bool:
    if pd.isna(val):
        return False
    return str(val).strip().lower() in UK_SET

ee["is_uk"] = ee["experiment_country.o"].apply(is_uk)

# --- 4. Numerator / Denominator / Proportion --------------------------------
numerator   = int(ee["is_uk"].sum())
denominator = int(len(ee))
proportion  = numerator / denominator if denominator else float("nan")

print("\n--- EE × experiment_country.o ---")
print(ee["experiment_country.o"].value_counts(dropna=False).to_string())

print("\n--- UK-matching rows ---")
uk_rows = ee.loc[ee["is_uk"], ["id", "title", "experiment_country.o", "discipline", "pub_year", "journal"]]
print(uk_rows.to_string(index=False))

# --- 5. drop==True count within ee (transparency) ---------------------------
n_dropped_ee = int(ee["drop"].sum())
print(f"\nee rows with drop==True (transparency only, NOT used in calc): {n_dropped_ee}")

# --- 6. Summary -------------------------------------------------------------
summary = {
    "question":           "What proportion of original studies in Experimental Economics were conducted in the United Kingdom?",
    "dataset":            CSV.name,
    "subset_rule":        "project == 'ee'",
    "uk_label_rule":      "case/whitespace-insensitive match against UK_SET (defensive over-approximation)",
    "uk_labels_present":  sorted(ee.loc[ee["is_uk"], "experiment_country.o"].unique().tolist()),
    "denominator":        denominator,
    "numerator":          numerator,
    "proportion":         proportion,
    "proportion_pct":     round(100 * proportion, 4),
    "matching_studies":   uk_rows.to_dict(orient="records"),
    "ee_drop_count":      n_dropped_ee,
    "ee_missing_country": int(ee["experiment_country.o"].isna().sum()),
    "ee_unique_ids":      int(ee["id"].nunique()),
    "weighting":          "None (unweighted; counts of studies, not of subjects).",
}

out_json = ROOT / "artifacts" / "analysis" / "uk_proportion_ee.json"
out_json.write_text(json.dumps(summary, indent=2, ensure_ascii=False))
print(f"\nSummary written -> {out_json}")
print("\n=== FINAL RESULT ===")
print(f"Proportion = {numerator}/{denominator} = {proportion:.6f} ({100*proportion:.2f}%)")
