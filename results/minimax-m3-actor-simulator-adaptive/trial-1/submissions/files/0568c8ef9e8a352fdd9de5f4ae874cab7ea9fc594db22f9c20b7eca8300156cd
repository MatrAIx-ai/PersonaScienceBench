                    'Specific intervention targets/mechanisms are undocumented, so the design '
                    'matrix is a proxy for the true perturbation Jacobian.',
                    'Low bootstrap stability (Jaccard = %.3f +/- %.3f) because the sparse B '
                    'edge set has high sampling variability when only 12 of 15 perturbations '
                    'are held out.' % tuple(stab_B),
                ],
            },
        ],
    }
    mc['consensus'] = {
        'rule': (
            'Union of top-K_A from Method A and top-K_B from Method B, dropping edges '
            'where the two methods disagree on sign. Merged weights are the geometric '
            'mean of normalised |.| when both contribute, or the contributing method\'s '
            'score otherwise. Density clamped to [5%,40%] by dropping weakest edges if '
            'too dense, or by extending top-K if too sparse.'
        ),
        'K_A_final':             int(KAf),
        'K_B_final':             int(KBf),
        'off_diagonal_density':  float(density_off),
        'in_target_band':        bool(0.05 <= density_off <= 0.40),
        'relaxation_log':        relax_log,
        'rationale': (
            'Union + sign agreement reduces false positives while keeping edges supported '
            'by either modality. Geometric-mean merging rewards edges on which both '
            'methods agree strongly.'
        ),
    }
    with open(out_dir / 'method_comparison.json', 'w') as f:
        json.dump(mc, f, indent=2)


# ---------------------------------------------------------------- Main
def main():
    print('==== STEP 1: Method A (with/without t=0 sample; pick best) ====', flush=True)
    S_A0, sign_A0 = method_A(ts, drop_first_sample=False)
    S_A1, sign_A1 = method_A(ts, drop_first_sample=True)
    sep0, sep1 = separation_metric(S_A0), separation_metric(S_A1)
    print(f'  no-skip sep = {sep0:.3f}; skip-first sep = {sep1:.3f}')
    if sep1 >= sep0:
        S_A, sign_A, A_label = S_A1, sign_A1, 'skip_first_sample'
    else:
        S_A, sign_A, A_label = S_A0, sign_A0, 'keep_all_samples'
    print(f'  -> chose {A_label}')

    print('==== STEP 2: Method B (forward-stepwise LOOCV on perturbations) ====')
    t0 = time.time()
    S_B, sign_B, cv_r2_B, nnz_per_gene = method_B(ss, max_features=12)
    print(f'  done in {time.time()-t0:.1f}s; '
          f'per-gene CV R^2 mean/min/max = {cv_r2_B.mean():.3f}/'
          f'{cv_r2_B.min():.3f}/{cv_r2_B.max():.3f}; '
          f'support mean = {nnz_per_gene.mean():.2f}')

    print('==== STEP 3: Build consensus ====')
    n_A, n_B = normalize_abs(S_A), normalize_abs(S_B)
    consensus_idx, sign_lk, weight_lk, density, relax_log, KAf, KBf = consensus_flow(
        K_A=130, K_B=130, sign_A=sign_A, sign_B=sign_B, n_A=n_A, n_B=n_B,
        target_lo=LO, target_hi=HI)
    print(f'  K_A={KAf}, K_B={KBf}, density={density:.4f} '
          f'(in [0.05,0.40]? {LO <= density <= HI})')
    for l in relax_log:
        print('  ' + l)

    print('==== STEP 4: Build matrices ====')
    inferred = np.zeros((N_G, N_G), dtype=np.float64)
    signs    = np.zeros((N_G, N_G), dtype=np.float64)
    for idx in consensus_idx:
        i, j = divmod(idx, N_G)
        inferred[i, j] = weight_lk[idx]
        signs[i, j]    = sign_lk[idx]
    np.fill_diagonal(inferred, 0.0)
    np.fill_diagonal(signs,    0.0)

    print('==== STEP 5: Sanity checks ====')
    assert inferred.shape == (N_G, N_G) and inferred.dtype == np.float64
    assert not np.isnan(inferred).any() and not np.isinf(inferred).any()
    assert np.all((inferred == 0) == (signs == 0)), 'zero-net -> zero-sign violated'
    assert np.allclose(np.diag(inferred), 0.0), 'diagonal must be zero'
    off_diag = inferred.copy(); np.fill_diagonal(off_diag, 0.0)
    nonzero_off = int((off_diag != 0).sum())
    density_off = nonzero_off / OFF
    print(f'  off-diag nonzero = {nonzero_off}, density = {density_off:.4f}')
    assert 0.05 <= density_off <= 0.40, f'density {density_off} out of band'

    print('==== STEP 6: Hub identification ====')
    binary = (inferred != 0).astype(float)
    out_deg = binary.sum(axis=0)
    in_deg  = binary.sum(axis=1)
    total_weight = np.abs(inferred).sum(axis=0)
    hubs = sorted(range(N_G),
                  key=lambda g: (-out_deg[g], -total_weight[g]))[:2]
    for h in hubs:
        print(f'  hub {h}: out_deg = {int(out_deg[h])}, in_deg = {int(in_deg[h])}')
    assert len(set(hubs)) == 2, 'hubs must be two distinct genes'

    print('==== STEP 7: Stability bootstraps ====')
    t0 = time.time()
    stab_A = bootstrap_A_overlap(ts, n_reps=15, label_A_used=A_label,
                                 base_consensus_size=len(consensus_idx))
    print(f'  A stability: {stab_A[0]:.3f} +/- {stab_A[1]:.3f}  '
          f'({time.time()-t0:.1f}s)')
    t0 = time.time()
    stab_B = bootstrap_B_overlap(ss, n_reps=15,
                                 base_consensus_size=len(consensus_idx))
    print(f'  B stability: {stab_B[0]:.3f} +/- {stab_B[1]:.3f}  '
          f'({time.time()-t0:.1f}s)')

    print('==== STEP 8: Write artifacts ====')
    write_artifacts(inferred, signs, hubs,
                    cv_r2_B, nnz_per_gene,
                    A_label, KAf, KBf, density_off,
                    method_A_obj=dict(S_A=S_A,
                                       consensus_idx=list(consensus_idx)),
                    method_B_obj=dict(S_B=S_B),
                    stab_A=stab_A, stab_B=stab_B, relax_log=relax_log)
    print('  all six artifacts written to workspace root.')
    print('Done.')


