                    'mean_supportsize':       float(n_nz_per_gene.mean()),
                    'mean_abs_coef_retained': float(np.mean(retained_B_coefs)) if retained_B_coefs else 0.0,
                    'stability_jaccard_12of15': float(stab_B[0]),
