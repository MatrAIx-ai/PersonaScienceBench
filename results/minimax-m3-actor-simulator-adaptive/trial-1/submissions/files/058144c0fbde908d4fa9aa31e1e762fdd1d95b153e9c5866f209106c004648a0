def draw_text(canvas, x0, y0, text, color=(0, 0, 0, 255), scale=1):
    for ch in text:
        glyph = _FONT.get(ch.upper(), _FONT.get(ch, _FONT[' ']))
        for ry in range(7):
            bits = glyph[ry]
            for rx in range(5):
                if bits & (1 << (4 - rx)):
                    for dy in range(scale):
                        for dx in range(scale):
                            xx = x0 + rx * scale + dx
                            yy = y0 + ry * scale + dy
                            if 0 <= xx < canvas.shape[1] and 0 <= yy < canvas.shape[0]:
                                canvas[yy, xx] = color
        x0 += 6 * scale
    return x0


def write_png(path, width, height, px):
    sig = b"\x89PNG\r\n\x1a\n"

    def chunk(tag, data):
        return (struct.pack(">I", len(data)) + tag + data +
                struct.pack(">I", zlib.crc32(tag + data) & 0xffffffff))

    ihdr = struct.pack(">IIBBBBB", width, height, 8, 6, 0, 0, 0)
    raw = b"".join(b"\x00" + px[row].tobytes() for row in range(height))
    idat = zlib.compress(raw, 6)
    with open(path, "wb") as f:
        f.write(sig)
        f.write(chunk(b"IHDR", ihdr))
        f.write(chunk(b"IDAT", idat))
        f.write(chunk(b"IEND", b""))


def make_rate_plot(path, T_list, k_local, k_opt, k_enh, kappa):
    W, H = 1024, 640
    canvas = np.full((H, W, 4), 255, dtype=np.uint8)
    margin_l, margin_r = 90, 90
    margin_t, margin_b = 100, 90
    plot_w = W - margin_l - margin_r
    plot_h = H - margin_t - margin_b
    x0p, y0p = margin_l, margin_t
    log_k_min, log_k_max = -28, 16
    kappa_max = max(2.0, float(np.nanmax(kappa)) * 1.2)
    kappa_min = 0.0
    T_min, T_max = float(T_list[0]), float(T_list[-1])

    def X(t): return int(x0p + (t - T_min) / (T_max - T_min) * plot_w)
    def YL(v): return int(y0p + plot_h - (v - log_k_min) / (log_k_max - log_k_min) * plot_h)
    def YR(v): return int(y0p + plot_h - (v - kappa_min) / (kappa_max - kappa_min) * plot_h)

    for x in range(x0p, x0p + plot_w + 1):
        canvas[y0p + plot_h, x] = (0, 0, 0, 255)
        canvas[y0p, x] = (0, 0, 0, 255)
    for y in range(y0p, y0p + plot_h + 1):
        canvas[y, x0p] = (0, 0, 0, 255)
        canvas[y, x0p + plot_w] = (0, 0, 0, 255)
    grid_color = (220, 220, 220, 255)
    for v in range(log_k_min, log_k_max + 1, 4):
        y = YL(v)
        if y0p <= y <= y0p + plot_h:
            for x in range(x0p, x0p + plot_w + 1):
                canvas[y, x] = grid_color
    for tick in np.linspace(T_min, T_max, num=8):
        x = X(tick)
        if x0p <= x <= x0p + plot_w:
            for y in range(y0p, y0p + plot_h + 1):
                canvas[y, x] = grid_color

    log_k_loc = np.log10(k_local)
    log_k_opt = np.log10(k_opt)
    log_k_enh = np.log10(k_enh)
    color_local = (220, 30, 30, 255)
    color_opt = (255, 140, 0, 255)
    color_enh = (30, 60, 220, 255)
    color_kappa = (30, 160, 60, 255)
    thick = 2

    def draw_line(values, Yfun, color):
        last = None
        for iT, T in enumerate(T_list):
            v_clip = float(np.clip(values[iT],
                                   min(log_k_min, float(np.nanmin(values))),
                                   max(log_k_max, float(np.nanmax(values)))))
            x = X(T)
            y = int(np.clip(Yfun(v_clip), y0p, y0p + plot_h))
            if last is not None:
                x_prev, y_prev = last
                dx = x - x_prev
                dy = y - y_prev
                steps = max(abs(dx), abs(dy), 1)
                for s in range(steps + 1):
                    xx = x_prev + int(round(dx * s / steps))
                    yy = y_prev + int(round(dy * s / steps))
                    for t in range(-thick + 1, thick):
                        if 0 <= xx + t < canvas.shape[1] and 0 <= yy < canvas.shape[0]:
                            canvas[yy, xx + t] = color
            last = (x, y)

    draw_line(log_k_loc, YL, color_local)
    draw_line(log_k_opt, YL, color_opt)
    draw_line(log_k_enh, YL, color_enh)
    draw_line(kappa, YR, color_kappa)

    for v in range(log_k_min, log_k_max + 1, 4):
        y = YL(v)
        if 0 <= y < canvas.shape[0]:
            for x in range(x0p - 6, x0p):
                canvas[y, x] = (0, 0, 0, 255)
            draw_text(canvas, x0p - 56, y - 3, str(v), scale=1)
    for tick in np.linspace(T_min, T_max, num=8):
        x = X(tick)
        for y in range(y0p + plot_h + 1, y0p + plot_h + 6):
            canvas[y, x] = (0, 0, 0, 255)
        draw_text(canvas, x - 14, y0p + plot_h + 12, f"{tick:.0f}", scale=1)

    kticks = np.linspace(0.0, kappa_max, num=6)
    for kk in kticks:
        if kk > kappa_max + 1e-9: continue
        y = YR(kk)
        if not (y0p <= y <= y0p + plot_h): continue
        for x in range(x0p + plot_w + 1, x0p + plot_w + 7):
            canvas[y, x] = (0, 0, 0, 255)
        draw_text(canvas, x0p + plot_w + 10, y - 3, f"{kk:.1f}", scale=1)

    leg_x = x0p + plot_w - 280
    leg_y = y0p + 10
    for i, (lbl, col) in enumerate([
        ("LOG10 K_LOCAL", color_local),
        ("LOG10 K_OPTIMIZED", color_opt),
        ("LOG10 K_ENHANCED", color_enh),
        ("ENHANCEMENT FACTOR", color_kappa),
    ]):
        for dy in range(2, 8):
            for dx in range(0, 28):
                if 0 <= leg_y + 2 + i * 16 + dy < canvas.shape[0] and \
                   0 <= leg_x + dx < canvas.shape[1]:
                    canvas[leg_y + 2 + i * 16 + dy, leg_x + dx] = col
        draw_text(canvas, leg_x + 32, leg_y + i * 16, lbl, scale=1, color=(0, 0, 0, 255))

    draw_text(canvas, x0p + plot_w // 2 - 60, H - 18, "TEMPERATURE K", scale=1)
    draw_text(canvas, 8, y0p + plot_h // 2 - 24, "LOG10 K S-1", scale=1)
    draw_text(canvas, W - 80, y0p + plot_h // 2 - 20, "KAPPA", scale=1)
    draw_text(canvas, x0p + 16, 18, "RATE CONSTANTS AND TUNNELING ENHANCEMENT", scale=2)

    write_png(path, W, H, canvas)


