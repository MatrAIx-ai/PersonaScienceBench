"""
DiscoveryBench / nls_ses / metadata_2 — moderation analysis (v3).

KEY CORRECTION vs v2:
    The Firth-penalised log-likelihoods are NOT comparable for the
    likelihood-ratio test of the interaction block, because the
    Firth penalty (0.5*log|I|) itself depends on the model parameters.
    For inferential LR-testing we use the *unpenalised* log-likelihoods
    at the Firth-fitted MLEs.  Point estimates still come from Firth
    (so the rare-event / small-stratum bias is corrected), individual
    coefficient inference uses Wald-tests on Firth beta with model-based
    SEs, and effect-size CIs come from bootstrap on the full Firth fit.
    See Heinze & Schemper (2002) and Kosmidis & Firth (2017).

Research question
-----------------
Is the relation between SES and BA-degree completion affected by
SAMPLE_RACE?

Model
-----
Firth logistic regression of BA on SES, race, SES*race, with sex,
ABILITY (ASVAB composite), percentile in class, and family size as
additive covariates; White = reference category.
"""
import json
import time
from pathlib import Path

import numpy as np
import pandas as pd
from scipy import stats as sps

ROOT = Path("/workspace")
DATA = ROOT / "data/nls_ses_processed.csv"
ART = ROOT / "artifacts"
SEED = 20261021


# --------------------------------------------------------------------------- #
# Design matrix                                                               #
# --------------------------------------------------------------------------- #
def prepare():
    df = pd.read_csv(DATA)
    df = df.drop(columns=["Unnamed: 0"])
    df["y"] = df["BA DEGREE COMPLETED"].astype(int)
    df["Black"] = (df["SAMPLE_RACE"] == "Black").astype(int)
    df["Hispanic"] = (df["SAMPLE_RACE"] == "Hispanic").astype(int)
    df["Male"] = (df["SAMPLE_SEX"] == "Male").astype(int)
    df["SES_c"] = df["SES"] - df["SES"].mean()
    df["SES_c_Black"] = df["SES_c"] * df["Black"]
    df["SES_c_Hispanic"] = df["SES_c"] * df["Hispanic"]
    covariates = [
        "Male", "ABILITY: COMPOSITE OF ASVAB SCORE",
        "PERCENTILE IN CLASS", "FAMILY SIZE OF SAMPLE",
        "SES_c", "Black", "Hispanic",
        "SES_c_Black", "SES_c_Hispanic",
    ]
    return df, covariates


def make_X(df_in, covariates, with_interaction=True):
    n = len(df_in); p = 1 + len(covariates)
    X = np.empty((n, p), dtype=np.float64)
    X[:, 0] = 1.0
    for j, c in enumerate(covariates, start=1):
        if c in ("SES_c_Black", "SES_c_Hispanic") and not with_interaction:
            X[:, j] = 0.0
        else:
            X[:, j] = df_in[c].values
    return X



# --------------------------------------------------------------------------- #
# Firth logistic regression (Newton-Raphson with bias-corrected score)        #
# --------------------------------------------------------------------------- #
# The scored update is                                                       #
#     beta <- beta + (X' W X)^{-1} * [X'(y-mu) - adj(beta)]                 #
#                                                                          #
# where adj(beta)_j = 0.5 * tr((X'WX)^{-1} d/dbeta_j (X' W X))              #
# and d/dbeta_j (X' W X) = X' diag(w (1-2 mu) x_j) X.                        #
#                                                                          #
# Vectorised:  diag-block of X (X'WX)^{-1} X' is (X (X'WX)^{-1} X^T)_{ii}   #
# stored column-wise without forming an n x n matrix.                       #
# --------------------------------------------------------------------------- #
def firth_logit(X, y, max_iter=200, tol=1e-9, return_extra=False):
    n, p = X.shape
    beta = np.zeros(p, dtype=np.float64)
    converged = False
    n_iter = 0
    for it in range(max_iter):
        eta = X @ beta
        mu = np.where(eta >= 0,
                      1.0 / (1.0 + np.exp(-eta)),
                      np.exp(-np.abs(eta)) / (1.0 + np.exp(-np.abs(eta)))) * np.where(eta >= 0, 1.0, np.exp(eta) / np.exp(np.abs(eta)))
        # cleaner stable sigmoid
        pos = eta >= 0
        mu = np.empty_like(eta, dtype=np.float64)
        mu[pos] = 1.0 / (1.0 + np.exp(-eta[pos]))
        mu[~pos] = np.exp(eta[~pos]) / (1.0 + np.exp(eta[~pos]))
        mu = np.clip(mu, 1e-12, 1.0 - 1e-12)
        w = mu * (1.0 - mu)
        U = X.T @ (y - mu)
        XtW = X.T * w
        I_mat = XtW @ X
        try:
            L = np.linalg.cholesky(I_mat)
            Iinv = np.linalg.inv(I_mat)
        except np.linalg.LinAlgError:
            I_mat = I_mat + 1e-8 * np.eye(I_mat.shape[0])
            Iinv = np.linalg.inv(I_mat)
            L = np.linalg.cholesky(I_mat)
        XI = X @ Iinv
        H_diag = (X * XI).sum(axis=1)
        adj = 0.5 * X.T @ (H_diag * w * (1.0 - 2.0 * mu))
        U_pen = U - adj
        try:
            step = np.linalg.solve(I_mat, U_pen)
        except np.linalg.LinAlgError:
            break
        beta = beta + step
        n_iter = it + 1
        if np.max(np.abs(step)) < tol:
            converged = True
            break
        if not np.all(np.isfinite(beta)):
            break

    # final
    eta = X @ beta
    pos = eta >= 0
    mu = np.empty_like(eta, dtype=np.float64)
    mu[pos] = 1.0 / (1.0 + np.exp(-eta[pos]))
    mu[~pos] = np.exp(eta[~pos]) / (1.0 + np.exp(eta[~pos]))
    mu = np.clip(mu, 1e-12, 1.0 - 1e-12)
    w = mu * (1.0 - mu)
    XtW = X.T * w
    I_mat = XtW @ X
    try:
        L = np.linalg.cholesky(I_mat)
        Iinv = np.linalg.inv(I_mat)
    except np.linalg.LinAlgError:
        I_mat = I_mat + 1e-8 * np.eye(I_mat.shape[0])
        Iinv = np.linalg.inv(I_mat)
        L = np.linalg.cholesky(I_mat)

    eps = 1e-12
    ll = float(np.sum(y * np.log(mu + eps) + (1.0 - y) * np.log(1.0 - mu + eps)))
    logdetI = 2.0 * float(np.sum(np.log(np.diag(L))))
    ll_pen = ll + 0.5 * logdetI

    if return_extra:
        return {"beta": beta, "SE": np.sqrt(np.maximum(np.diag(Iinv), 0.0)),
                "Iinv": Iinv, "mu": mu, "loglik": ll, "loglik_pen": ll_pen,
                "logdetI": logdetI, "converged": converged, "iters": n_iter}
    return beta, Iinv, ll, ll_pen


# --------------------------------------------------------------------------- #
# Helpers                                                                     #
# --------------------------------------------------------------------------- #
def race_ame_pp(beta, X, race_mask):
    blacks = float(X[race_mask, 6].sum())
    hispanics = float(X[race_mask, 7].sum())
    if blacks > 0 and hispanics == 0:
        slope = beta[5] + beta[8]
    elif hispanics > 0 and blacks == 0:
        slope = beta[5] + beta[9]
    else:
        slope = beta[5]
    eta = X[race_mask] @ beta
    pos = eta >= 0
    mu = np.empty_like(eta, dtype=np.float64)
    mu[pos] = 1.0 / (1.0 + np.exp(-eta[pos]))
    mu[~pos] = np.exp(eta[~pos]) / (1.0 + np.exp(eta[~pos]))
    mu = np.clip(mu, 1e-12, 1.0 - 1e-12)
    w = mu * (1.0 - mu)
    return 100.0 * float(np.mean(w * slope))


def ame_in_subsample(beta, df_sub, with_interaction=True):
    cov_local = ["Male", "ABILITY: COMPOSITE OF ASVAB SCORE",
                 "PERCENTILE IN CLASS", "FAMILY SIZE OF SAMPLE",
                 "SES_c", "Black", "Hispanic",
                 "SES_c_Black", "SES_c_Hispanic"]
    X_sub = make_X(df_sub, cov_local, with_interaction=with_interaction)
    out = {}
    for r in ["Black", "Hispanic", "White"]:
        m = df_sub["SAMPLE_RACE"].eq(r).values
        out[r] = race_ame_pp(beta, X_sub, m) if m.sum() else np.nan
    return out


def predicted_probs(beta_full, ses_grid, df_means, race_code):
    n = len(ses_grid)
    Xg = np.empty((n, 10), dtype=np.float64)
    Xg[:, 0] = 1.0
    Xg[:, 1] = df_means["Male"]
    Xg[:, 2] = df_means["ABILITY"]
    Xg[:, 3] = df_means["PERCENTILE"]
    Xg[:, 4] = df_means["FAMSI"]
    Xg[:, 5] = ses_grid - df_means["SES"]
    if race_code == "White":
        Xg[:, 6] = 0.0; Xg[:, 7] = 0.0
    elif race_code == "Black":
        Xg[:, 6] = 1.0; Xg[:, 7] = 0.0
    elif race_code == "Hispanic":
        Xg[:, 6] = 0.0; Xg[:, 7] = 1.0
    Xg[:, 8] = Xg[:, 5] * Xg[:, 6]
    Xg[:, 9] = Xg[:, 5] * Xg[:, 7]
    eta = Xg @ beta_full
    pos = eta >= 0
    mu = np.empty_like(eta, dtype=np.float64)
    mu[pos] = 1.0 / (1.0 + np.exp(-eta[pos]))
    mu[~pos] = np.exp(eta[~pos]) / (1.0 + np.exp(eta[~pos]))
    return mu



# --------------------------------------------------------------------------- #
# Main                                                                        #
# --------------------------------------------------------------------------- #
def main():
    print("=" * 78)
    print("PREPARE")
    print("=" * 78)
    df, covariates = prepare()

    X_full = make_X(df, covariates, with_interaction=True)
    X_rest = make_X(df, covariates, with_interaction=False)
    y = df["y"].values.astype(np.float64)

    print("\n" + "=" * 78)
    print("FULL FIRTH MODEL (with interaction)")
    print("=" * 78)
    t0 = time.time()
    full = firth_logit(X_full, y, return_extra=True)
    print(f"  fitted in {time.time()-t0:.2f}s, converged={full['converged']}, iters={full['iters']}")
    beta_full = full["beta"]
    se_full = full["SE"]
    names = ["Intercept"] + covariates
    print(f"  {'param':<42s} {'coef':>11s} {'SE':>10s} {'z':>8s} {'p':>10s}")
    for nm, b, s in zip(names, beta_full, se_full):
        z = b / s if s > 0 else np.nan
        p = 2.0 * (1.0 - sps.norm.cdf(abs(z)))
        print(f"  {nm:<42s} {b:+11.5f} {s:10.5f} {z:+8.3f} {p:10.3e}")
    print(f"  log-lik (UNPENALISED) = {full['loglik']:.5f}")
    print(f"  log-lik (FIRTH)       = {full['loglik_pen']:.5f}  [0.5 log|I| = {0.5*full['logdetI']:.4f}]")

    print("\n" + "=" * 78)
    print("RESTRICTED FIRTH MODEL (no interaction)")
    print("=" * 78)
    t0 = time.time()
    rest = firth_logit(X_rest, y, return_extra=True)
    print(f"  fitted in {time.time()-t0:.2f}s, converged={rest['converged']}, iters={rest['iters']}")
    print(f"  log-lik (UNPENALISED) = {rest['loglik']:.5f}")
    print(f"  log-lik (FIRTH)       = {rest['loglik_pen']:.5f}  [0.5 log|I| = {0.5*rest['logdetI']:.4f}]")
    print(f"  Restricted coefficients:")
    for nm, b, s in zip(names[:-2], rest["beta"], rest["SE"]):
        z = b / s if s > 0 else np.nan
        p = 2.0 * (1.0 - sps.norm.cdf(abs(z)))
        print(f"    {nm:<42s} {b:+11.5f} {s:10.5f} {z:+8.3f} {p:10.3e}")

    # LR tests:
    print("\n" + "=" * 78)
    print("LR TESTS (H0: beta_BLK = beta_HIS = 0)")
    print("=" * 78)
    lr_pen = 2.0 * (full["loglik_pen"] - rest["loglik_pen"])
    lr_unpen = 2.0 * (full["loglik"] - rest["loglik"])
    print(f"  LR_penalised (Firth, but the penalty itself differs across models => NOT chi-square):")
    print(f"      {lr_pen:.5f}, df=2  -- for diagnostic only, do NOT use")
    print(f"  LR_unpenalised (standard, Firth-fitted MLE):")
    print(f"      {lr_unpen:.5f}, df=2, p = {1.0 - sps.chi2.cdf(lr_unpen, 2):.4e}")
    p_lr = 1.0 - sps.chi2.cdf(lr_unpen, 2)

    # Wald joint test on the Firth estimates
    i_int = [8, 9]
    beta_int = beta_full[i_int]
    sigma_int = full["Iinv"][np.ix_(i_int, i_int)]
    try:
        wald_joint = float(beta_int @ np.linalg.solve(sigma_int, beta_int))
    except np.linalg.LinAlgError:
        wald_joint = float("nan")
    p_wald = 1.0 - sps.chi2.cdf(wald_joint, 2)
    print(f"  Wald joint (Firth estimates, model-based SE):")
    print(f"      chi2 = {wald_joint:.5f}, df=2, p = {p_wald:.4e}")

    # Race-specific AME point estimates
    race_masks = {
        "Black":   df["SAMPLE_RACE"].eq("Black").values,
        "Hispanic":df["SAMPLE_RACE"].eq("Hispanic").values,
        "White":   df["SAMPLE_RACE"].eq("White").values,
    }
    ame_point = {r: race_ame_pp(beta_full, X_full, race_masks[r]) for r in race_masks}
    print("\n" + "=" * 78)
    print("RACE-SPECIFIC AMEs (point estimates, pp per 1-unit SES)")
    print("=" * 78)
    for r in ["White", "Black", "Hispanic"]:
        print(f"  {r:>9s}: n = {int(race_masks[r].sum()):5d},   AME(SES) = {ame_point[r]:+.5f} pp per 1-unit SES")


    # -------------------------------------------------------------------------
    # Race-stratified Firth (supplementary)
    # -------------------------------------------------------------------------
    print("\n" + "=" * 78)
    print("SUPPLEMENTARY: RACE-STRATIFIED FIRTH LOGISTIC, SES OR + 95% CI + p")
    print("=" * 78)
    stratified = {}
    for r in ["White", "Black", "Hispanic"]:
        df_sub = df[df["SAMPLE_RACE"].eq(r)].reset_index(drop=True)
        X_sub = make_X(df_sub, covariates, with_interaction=False)
        y_sub = df_sub["y"].values.astype(np.float64)
        rfit = firth_logit(X_sub, y_sub, return_extra=True)
        b_ses = rfit["beta"][5]
        se_ses = rfit["SE"][5]
        z = b_ses / se_ses if se_ses > 0 else np.nan
        p = 2.0 * (1.0 - sps.norm.cdf(abs(z)))
        OR = float(np.exp(b_ses))
        CI_low = float(np.exp(b_ses - 1.96 * se_ses))
        CI_high = float(np.exp(b_ses + 1.96 * se_ses))
        sd_ses_sub = float(df_sub["SES"].std())
        OR_per_SD = float(np.exp(b_ses * sd_ses_sub))
        ame_unit = race_ame_pp(rfit["beta"], X_sub, np.ones(len(df_sub), dtype=bool))
        stratified[r] = {
            "n": int(len(df_sub)),
            "n_events": int(y_sub.sum()),
            "coef_SES": float(b_ses),
            "SE_SES": float(se_ses),
            "z": float(z),
            "p_value": float(p),
            "OR_SES_per_1unit": OR,
            "OR_CI95_low": CI_low,
            "OR_CI95_high": CI_high,
            "OR_SES_per_1SD": OR_per_SD,
            "AME_pp_per_1unit": float(ame_unit),
            "AME_pp_per_1SD": float(ame_unit * sd_ses_sub),
            "ses_sd_in_group": sd_ses_sub,
        }
        print(f"  {r:>9s}: n={len(df_sub):5d},  events={int(y_sub.sum()):3d},  "
              f"coef_SES={b_ses:+.4f}  SE={se_ses:.4f}  p={p:.3e}  "
              f"OR/unit={OR:.3f} 95%CI=({CI_low:.3f},{CI_high:.3f})  "
              f"OR/SD={OR_per_SD:.3f}  AME(unit)={ame_unit:+.5f} pp")

    # -------------------------------------------------------------------------
    # Bootstrap (1000 reps) for AME CIs AND a bootstrap version of the LR test
    # -------------------------------------------------------------------------
    print("\n" + "=" * 78)
    print("BOOTSTRAP (1000 reps) — AME CIs, predicted-prob CIs, LR-bootstrap p-value")
    print("=" * 78)
    rng = np.random.default_rng(SEED)
    n_boot = 1000
    n_total = len(df)
    ame_boot = {r: np.empty(n_boot, dtype=np.float64) for r in ["Black", "Hispanic", "White"]}
    lr_boot = np.empty(n_boot, dtype=np.float64)
    ses_grid = np.linspace(df["SES"].min(), df["SES"].max(), 60)
    pred_grid = {r: np.full((n_boot, len(ses_grid)), np.nan) for r in ["Black", "Hispanic", "White"]}
    df_means = {
        "Male":      float(df["Male"].mean()),
        "ABILITY":   float(df["ABILITY: COMPOSITE OF ASVAB SCORE"].mean()),
        "PERCENTILE":float(df["PERCENTILE IN CLASS"].mean()),
        "FAMSI":     float(df["FAMILY SIZE OF SAMPLE"].mean()),
        "SES":       float(df["SES"].mean()),
    }
    n_fail = 0
    t0 = time.time()
    for b in range(n_boot):
        idx = rng.integers(0, n_total, size=n_total)
        df_b = df.iloc[idx].reset_index(drop=True)
        y_b = df_b["y"].values.astype(np.float64)
        Xbf = make_X(df_b, covariates, with_interaction=True)
        Xbr = make_X(df_b, covariates, with_interaction=False)
        try:
            fit_f = firth_logit(Xbf, y_b, return_extra=True)
            fit_r = firth_logit(Xbr, y_b, return_extra=True)
            if not (fit_f["converged"] and fit_r["converged"]):
                n_fail += 1
                continue
            beta_b = fit_f["beta"]
            for r in ["Black", "Hispanic", "White"]:
                ame_boot[r][b] = ame_in_subsample(beta_b, df_b, with_interaction=True)[r]
                pred_grid[r][b, :] = predicted_probs(beta_b, ses_grid, df_means, r)
            lr_boot[b] = 2.0 * (fit_f["loglik"] - fit_r["loglik"])
        except Exception:
            n_fail += 1
            continue
        if (b + 1) % 100 == 0:
            print(f"  ... rep {b+1}/{n_boot} ({(time.time()-t0):.1f}s, {n_fail} failed)")
    print(f"  bootstrap done in {(time.time()-t0):.1f}s, total failed = {n_fail}/{n_boot}")

    # bootstrap LR p-value
    n_lr_finite = int(np.isfinite(lr_boot).sum())
    p_lr_boot = (1.0 + (lr_boot[~np.isnan(lr_boot) & ~np.isinf(lr_boot)] >= lr_unpen).sum()) / (1.0 + n_lr_finite)
    print(f"  Bootstrap-LR p-value (joint H0 interaction):")
    print(f"      observed LR = {lr_unpen:.4f}")
    print(f"      bootstrap LR p = {p_lr_boot:.4f}")
    print(f"      n_reps with finite LR = {n_lr_finite}")

    boot_summary = {}
    for r in ["Black", "Hispanic", "White"]:
        col = ame_boot[r]
        ok = np.isfinite(col)
        ci_low, ci_high = np.percentile(col[ok], [2.5, 97.5])
        boot_summary[r] = {"ci_low": float(ci_low), "ci_high": float(ci_high), "n_used": int(ok.sum())}
    sd_ses = float(df["SES"].std())
    sd_summary = {r: {"point_pp_per_SD": float(ame_point[r] * sd_ses),
                       "ci_low": float(boot_summary[r]["ci_low"] * sd_ses),
                       "ci_high": float(boot_summary[r]["ci_high"] * sd_ses)}
                  for r in ["Black", "Hispanic", "White"]}

    print("\nAME (pp / 1-unit SES), point + bootstrap 95% CI")
    for r in ["Black", "Hispanic", "White"]:
        b = boot_summary[r]
        print(f"  {r:>9s}: point = {ame_point[r]:+.5f}   "
              f"95% CI = [{b['ci_low']:+.5f}, {b['ci_high']:+.5f}]   "
              f"n_boot used = {b['n_used']}")
    print("\nAME (pp / 1-SD SES), point + bootstrap 95% CI")
    for r in ["Black", "Hispanic", "White"]:
        s = sd_summary[r]
        print(f"  {r:>9s}: point = {s['point_pp_per_SD']:+.5f}   "
              f"95% CI = [{s['ci_low']:+.5f}, {s['ci_high']:+.5f}]")

    # -------------------------------------------------------------------------
    # Save artefacts
    # -------------------------------------------------------------------------
    np.savez(ART / "primary_model.npz",
             beta_full=beta_full, SE_full=se_full,
             ll_full_unpen=full["loglik"], ll_full_pen=full["loglik_pen"],
             logdetI_full=full["logdetI"], converged_full=full["converged"], iters_full=full["iters"],
             lr_pen=lr_pen, lr_unpen=lr_unpen, p_lr_unpen=p_lr,
             wald_joint=wald_joint, p_wald=p_wald,
             ll_rest_unpen=rest["loglik"], ll_rest_pen=rest["loglik_pen"], logdetI_rest=rest["logdetI"],
             ses_grid=ses_grid, sd_ses=sd_ses,
             n_boot=n_boot, n_boot_failed=n_fail,
             ame_unit_White=ame_point["White"], ame_unit_Black=ame_point["Black"], ame_unit_Hispanic=ame_point["Hispanic"],
             beta_restricted=rest["beta"], SE_restricted=rest["SE"],
             p_lr_boot=p_lr_boot, n_lr_finite=n_lr_finite,
             lr_boot=lr_boot)
    np.savez(ART / "boot_pred_grid.npz",
             ses_grid=ses_grid,
             pred_White_mean=predicted_probs(beta_full, ses_grid, df_means, "White"),
             pred_Black_mean=predicted_probs(beta_full, ses_grid, df_means, "Black"),
             pred_Hispanic_mean=predicted_probs(beta_full, ses_grid, df_means, "Hispanic"),
             pred_White_lo=np.nanpercentile(pred_grid["White"], 2.5, axis=0),
             pred_Black_lo=np.nanpercentile(pred_grid["Black"], 2.5, axis=0),
             pred_Hispanic_lo=np.nanpercentile(pred_grid["Hispanic"], 2.5, axis=0),
             pred_White_hi=np.nanpercentile(pred_grid["White"], 97.5, axis=0),
             pred_Black_hi=np.nanpercentile(pred_grid["Black"], 97.5, axis=0),
             pred_Hispanic_hi=np.nanpercentile(pred_grid["Hispanic"], 97.5, axis=0))

    primary_summary = {
        "n_total": int(len(df)),
        "n_events": int(df["y"].sum()),
        "base_rate_pp": float(df["y"].mean() * 100.0),
        "covariates": ["Intercept", "Male", "ABILITY", "PERCENTILE", "FAMSI",
                       "SES_c (centred)", "Black", "Hispanic", "SES_c*Black", "SES_c*Hispanic"],
        "primary_point_estimates_use": "Firth-bias-reduced",
        "primary_inference_use": "unpenalised LR stat (chi-square, df=2); Wald joint (df=2); bootstrap LR",
        "primary_estimates": {
            "full": {names[i]: {"coef": float(beta_full[i]), "SE": float(se_full[i])}
                     for i in range(len(names))},
            "restricted": {names[i]: {"coef": float(rest["beta"][i]), "SE": float(rest["SE"][i])}
                           for i in range(len(rest["beta"]))},
        },
        "tests_H0_interactions_JointBlockZero": {
            "LR_unpenalised": {"chi2": float(lr_unpen), "df": 2, "p": float(p_lr)},
            "Wald_joint":     {"chi2": float(wald_joint), "df": 2, "p": float(p_wald)},
            "Bootstrap_LR":   {"p": float(p_lr_boot), "n_reps": n_lr_finite},
