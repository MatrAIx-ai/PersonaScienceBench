
"""
Comparative analysis: effect of education expenditure (% of GNI) on
per-capita GDP, Sub-Saharan Africa (SSF) vs Lower Middle Income (LMC),
1975-2015 WDI aggregate panel.

Plan (binding decisions):
- A1: Treat 'Adjusted savings: education expenditure (% of GNI)' as the
      education-expenditure variable. Do NOT substitute dollar spending.
- A2: Primary spec is pooled OLS with interaction (HAC SEs) on 2011-2015.
- A3: Comparative claim restricted to 2011-2015 overlap.
- A4: Required named variables reported in final answer/hypothesis.
"""
import json
from pathlib import Path
import numpy as np
import pandas as pd
import statsmodels.api as sm

DATA_PATH = Path("/workspace/data/worldbank_education_gdp.csv")
ART_DIR = Path("/workspace/artifacts")
ART_DIR.mkdir(exist_ok=True, parents=True)

raw = pd.read_csv(DATA_PATH)
year_cols = [c for c in raw.columns if c.startswith("19") or c.startswith("20")]
rename = {c: int(c.split(" ")[0]) for c in year_cols}
long = raw.rename(columns=rename).melt(
    id_vars=["Country Group", "Country Code", "Series Name", "Series Code"],
    var_name="year", value_name="value",
)
long["year"] = long["year"].astype(int)
long["value"] = pd.to_numeric(long["value"], errors="coerce")

panel = long.pivot_table(
    index=["Country Group", "Country Code", "year"],
    columns="Series Name", values="value",
).reset_index()
panel.columns.name = None
panel = panel.rename(columns={
    "GNI per capita (constant 2015 USdollar)": "gni_pc",
    "Adjusted savings: education expenditure (percentage of GNI)": "edu_share",
    "Exports of goods and services (annual percentage growth)": "exp_growth",
    "School enrollment, primary (percentage gross)": "prim_enr",
    "School enrollment, secondary (percentage gross)": "sec_enr",
    "Labor force participation rate, total (percentage of total population ages 15+) (modeled ILO estimate)": "lfpr",
})
panel = panel.sort_values(["Country Group", "year"]).reset_index(drop=True)
panel["is_LMC"] = (panel["Country Code"] == "LMC").astype(int)
panel["log_gni"] = np.log(panel["gni_pc"])

print("=" * 70)
print("Reshaped panel preview:")
print(panel.head().to_string(index=False))
print()
print(f"Panel shape: {panel.shape}; years {panel['year'].min()}-{panel['year'].max()}")
print(f"Groups present: {sorted(panel['Country Group'].unique())}")
print()


# Coverage table
coverage = (panel.groupby("Country Group")[
    ["gni_pc", "edu_share", "exp_growth", "prim_enr", "sec_enr", "lfpr"]
    ].agg(lambda s: int(s.notna().sum())))
coverage = coverage.rename(columns={
    "gni_pc": "GNI per capita",
    "edu_share": "EduShare (% of GNI)",
    "exp_growth": "Exports growth",
    "prim_enr": "Primary enroll.",
    "sec_enr": "Secondary enroll.",
    "lfpr": "Labor force part.",
})
print("=" * 70)
print("(a) Coverage table (non-null counts, 1975-2015):")
print(coverage.to_string())
coverage.to_csv(ART_DIR / "coverage_table.csv")
print()

# Find overlap window
gni_by_year = (panel.dropna(subset=["gni_pc"])
               .groupby("year")["Country Group"].nunique())
overlap_years = sorted(gni_by_year[gni_by_year == 2].index.tolist())
print(f"GNI per capita overlap years (both groups): {overlap_years}")
print(f"Overlap T = {len(overlap_years)}")
print()

# Outliers
print("=" * 70)
print("(b) Export growth extremes:")
exg = panel.dropna(subset=["exp_growth"])[["Country Group", "year", "exp_growth"]]
print("  Two most negative:")
print(exg.nsmallest(2, "exp_growth").to_string(index=False))
print("  Two most positive:")
print(exg.nlargest(2, "exp_growth").to_string(index=False))
flag_2009 = ((panel["year"] == 2009) & (panel["exp_growth"] < -40)).any()
flag_2000 = ((panel["year"] == 2000) & (panel["exp_growth"] > 25)).any()
print(f"  SSF exports 2009 <= -40? {bool(flag_2009)}")
print(f"  SSF exports 2000 >= +25? {bool(flag_2000)}")
print()

# Build analytic frame on 2011-2015
W0, W1 = 2011, 2015
prim = panel[(panel["year"] >= W0) & (panel["year"] <= W1)].copy()
prim = prim.sort_values(["Country Group", "year"])
prim["log_gni_lag"] = prim.groupby("Country Group")["log_gni"].shift(1)
prim["trend"] = prim["year"] - W0

required_cols = ["log_gni", "log_gni_lag", "edu_share", "lfpr",
                 "prim_enr", "sec_enr", "exp_growth", "trend"]
model_df = prim.dropna(subset=required_cols).copy()
model_df["edu_x_LMC"] = model_df["edu_share"] * model_df["is_LMC"]

print("=" * 70)
print(f"Primary analytic frame (window {W0}-{W1}):")
print(model_df[["Country Group", "year", "gni_pc", "log_gni", "edu_share",
                "log_gni_lag", "lfpr", "prim_enr", "sec_enr",
                "exp_growth", "is_LMC"]].to_string(index=False))
print()
print(f"Observations in primary regression: {len(model_df)}")
print(f"Per-group N: {model_df.groupby('Country Group').size().to_dict()}")
print()


# Per-group OLS on the 2011-2015 window (transparency)
print("=" * 70)
print("Per-group OLS on 2011-2015 with lag and trend (transparency):")
per_group = {}
for grp, sub in model_df.groupby("Country Group"):
    if len(sub) < 3:
        print(f"  {grp}: insufficient obs ({len(sub)}) for lean regression.")
        continue
    # Lean per-group: log(GNI) ~ EduShare + log_gni_lag + trend
    X = sm.add_constant(sub[["edu_share", "log_gni_lag", "trend"]])
    y = sub["log_gni"].values
    res_pg = sm.OLS(y, X).fit(cov_type="HAC", cov_kwds={"maxlags": 1})
    per_group[grp] = res_pg
    print(f"\n  {grp} (T={len(sub)}), design: log(GNI) ~ EduShare + log_gni_lag + trend, HAC(1):")
    print(f"    {'variable':14s} {'coef':>10s} {'HAC SE':>10s} {'t':>8s} {'p':>8s}")
    for v in ["const", "edu_share", "log_gni_lag", "trend"]:
        print(f"    {v:14s} {res_pg.params[v]: .5f} {res_pg.bse[v]: .5f} "              f"{res_pg.tvalues[v]: .3f} {res_pg.pvalues[v]: .3f}")
    print(f"    R^2 = {res_pg.rsquared:.4f}")

# Primary pooled OLS with interaction
print()
print("=" * 70)
print("Primary pooled OLS with interaction, 2011-2015, HAC SE:")
lean_cols = ["edu_share", "is_LMC", "edu_x_LMC", "log_gni_lag", "trend"]
X = sm.add_constant(model_df[lean_cols])
y = model_df["log_gni"].values
print(f"  Design: log(GNI) ~ EduShare + is_LMC + EduShare*is_LMC + log_gni_lag + trend")
print(f"  N = {len(model_df)}, k = {X.shape[1]}")

res_ols = sm.OLS(y, X).fit()
res_hac = sm.OLS(y, X).fit(cov_type="HAC", cov_kwds={"maxlags": 1})

print("\n  Naive OLS:")
print(f"    {'variable':14s} {'coef':>10s} {'SE':>10s} {'t':>8s} {'p':>8s}")
for v in lean_cols:
    print(f"    {v:14s} {res_ols.params[v]: .5f} {res_ols.bse[v]: .5f} "          f"{res_ols.tvalues[v]: .3f} {res_ols.pvalues[v]: .3f}")

print("\n  HAC (Newey-West, maxlags=1):")
for v in lean_cols:
    print(f"    {v:14s} {res_hac.params[v]: .5f} {res_hac.bse[v]: .5f} "          f"{res_hac.tvalues[v]: .3f} {res_hac.pvalues[v]: .3f}")
print(f"  R^2 = {res_hac.rsquared:.4f}, adj R^2 = {res_hac.rsquared_adj:.4f}")

with open(ART_DIR / "primary_pooled_OLS_summary.txt", "w") as fh:
    fh.write(res_hac.summary().as_text())
    fh.write("\n\nDesign: log(GNI) ~ EduShare + is_LMC + EduShare*is_LMC + log_gni_lag + trend, window 2011-2015, HAC(1).\n")
print(f"\n  Saved: {ART_DIR/'primary_pooled_OLS_summary.txt'}")


# Robustness A: include primary enrollment control
print()
print("=" * 70)
print("Robustness A: pooled OLS adding primary enrollment:")
ctrl_cols = ["edu_share", "is_LMC", "edu_x_LMC", "log_gni_lag", "trend", "prim_enr"]
cdf = model_df.dropna(subset=ctrl_cols)
print(f"  N with primary enrollment available in window: {len(cdf)}")
resc = None
if len(cdf) >= len(ctrl_cols) + 2:
    Xc = sm.add_constant(cdf[ctrl_cols])
    yc = cdf["log_gni"].values
    resc = sm.OLS(yc, Xc).fit(cov_type="HAC", cov_kwds={"maxlags": 1})
    print(f"    {'variable':14s} {'coef':>10s} {'HAC SE':>10s} {'t':>8s} {'p':>8s}")
    for v in ctrl_cols:
        print(f"    {v:14s} {resc.params[v]: .5f} {resc.bse[v]: .5f} "              f"{resc.tvalues[v]: .3f} {resc.pvalues[v]: .3f}")
else:
    print("  Insufficient N for this robustness check.")

# Robustness B: differenced form
print()
print("=" * 70)
print("Robustness B: pooled OLS on differenced data (no log_gni_lag):")
diff_df = model_df.sort_values(["Country Group", "year"]).copy()
diff_df["d_log_gni"] = diff_df.groupby("Country Group")["log_gni"].diff()
diff_df["d_edu_share"] = diff_df.groupby("Country Group")["edu_share"].diff()
diff_df["d_edu_x_LMC"] = diff_df["d_edu_share"] * diff_df["is_LMC"]
diff_df = diff_df.dropna(subset=["d_log_gni", "d_edu_share", "is_LMC", "trend"])
print(f"  N differenced obs: {len(diff_df)}")
resdi = None
if len(diff_df) >= 3:
    Xdi = sm.add_constant(diff_df[["d_edu_share", "is_LMC",
                                   "d_edu_x_LMC", "trend"]])
    yd = diff_df["d_log_gni"].values
    resdi = sm.OLS(yd, Xdi).fit(cov_type="HAC", cov_kwds={"maxlags": 1})
    print(f"    {'variable':14s} {'coef':>10s} {'HAC SE':>10s} {'t':>8s} {'p':>8s}")
    for v in ["const", "d_edu_share", "is_LMC", "d_edu_x_LMC", "trend"]:
        print(f"    {v:14s} {resdi.params[v]: .5f} {resdi.bse[v]: .5f} "              f"{resdi.tvalues[v]: .3f} {resdi.pvalues[v]: .3f}")
else:
    print("  Insufficient differenced obs.")

# Save JSON record
ssf2009 = panel.query("year==2009 and `Country Code`=='SSF'")
ssf2000 = panel.query("year==2000 and `Country Code`=='SSF'")
out = {
    "primary_window": [W0, W1],
    "primary_window_length": int(W1 - W0 + 1),
    "primary_regression_N": int(len(model_df)),
    "per_group_N": {k: int(v) for k, v in model_df.groupby("Country Group").size().to_dict().items()},
    "primary_coefs_HAC": {
        v: {
            "coef": float(res_hac.params[v]),
            "hac_se": float(res_hac.bse[v]),
            "t": float(res_hac.tvalues[v]),
            "p": float(res_hac.pvalues[v]),
        }
        for v in lean_cols
    },
    "primary_R2": float(res_hac.rsquared),
    "per_group_results": {
        grp: {
            "N": int(len(sub_df)),
            "edu_share_coef": float(per_group[grp].params["edu_share"]),
            "edu_share_HAC_SE": float(per_group[grp].bse["edu_share"]),
        }
        for grp, sub_df in model_df.groupby("Country Group") if grp in per_group
    },
    "outlier_flags": {
        "ssf_exports_2009_le_-40": bool(flag_2009),
        "ssf_exports_2000_ge_25": bool(flag_2000),
        "ssf_exports_2009_value": float(ssf2009["exp_growth"].iloc[0]) if not ssf2009["exp_growth"].isna().all() else None,
        "ssf_exports_2000_value": float(ssf2000["exp_growth"].iloc[0]) if not ssf2000["exp_growth"].isna().all() else None,
    },
    "robustness_A_with_primary_enrollment": {
        "N": int(len(cdf)) if resc is not None else None,
        "edu_x_LMC_coef": float(res_c.params["edu_x_LMC"]) if (resc is not None and "edu_x_LMC" in res_c.params) else None
    } if False else None,  # placeholder; fill below
    "robustness_B_differenced": {
        "N": int(len(diff_df)) if resdi is not None else None,
    },
}
# Fill robustness A
if resc is not None:
    out["robustness_A_with_primary_enrollment"] = {
        "N": int(len(cdf)),
        "edu_share_coef": float(resc.params["edu_share"]),
        "edu_share_HAC_SE": float(resc.bse["edu_share"]),
        "edu_x_LMC_coef": float(resc.params["edu_x_LMC"]),
        "edu_x_LMC_HAC_SE": float(resc.bse["edu_x_LMC"]),
    }
if resdi is not None:
    out["robustness_B_differenced"] = {
        "N": int(len(diff_df)),
        "d_edu_share_coef": float(resdi.params["d_edu_share"]),
        "d_edu_share_HAC_SE": float(resdi.bse["d_edu_share"]),
        "d_edu_x_LMC_coef": float(resdi.params["d_edu_x_LMC"]),
        "d_edu_x_LMC_HAC_SE": float(resdi.bse["d_edu_x_LMC"]),
    }

with open(ART_DIR / "primary_results.json", "w") as fh:
    json.dump(out, fh, indent=2)

print()
print("=" * 70)
print("Artifacts written:")
for p in sorted(ART_DIR.iterdir()):
    print(f"  - {p.name}")

print()
print("=" * 70)
print("Headline summary:")
v = "edu_x_LMC"
print(f"  Interaction coef (EduShare x is_LMC) = {res_hac.params[v]: .5f}")
print(f"  HAC SE                              = {res_hac.bse[v]: .5f}")
print(f"  t (HAC)                             = {res_hac.tvalues[v]: .3f}")
print(f"  p                                   = {res_hac.pvalues[v]: .3f}")
print(f"  Sample size pooled regression N     = {len(model_df)}")
