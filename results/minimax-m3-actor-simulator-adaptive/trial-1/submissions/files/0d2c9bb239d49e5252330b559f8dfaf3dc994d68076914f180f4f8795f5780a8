"""Roles vs. requirements-association analysis for
data/requirements_engineering_for_ML-enabled_systems.csv"""
import csv, math, random, itertools, json, collections, os
random.seed(42)
CSV = 'data/requirements_engineering_for_ML-enabled_systems.csv'
OUT = 'artifacts'
os.makedirs(OUT, exist_ok=True)
with open(CSV, newline='') as f:
    rd = csv.reader(f); header = next(rd); rows = list(rd)
H = {h:i for i,h in enumerate(header)}
def get(rr,k): return rr[H[k]]
non_susp     = [r for r in rows if get(r,'Status') != 'Suspended (22)']
non_susp_no0 = [r for r in non_susp if get(r,'D4_Role') != '0']
core         = [r for r in non_susp_no0 if get(r,'D4_Role') != 'Other, which one?']
KW_RE   = ['requirement','business analyst','analyst','product','systems engineer','process','quality','enterprise architect']
KW_DSML = ['data scientist','data analyst','ml engineer','machine learning engineer','data engineer','research scientist','researcher','research']
def other_reclass(txt):
    t=(txt or '').lower()
    if not t or t=='-99': return 'Other (unspecified)'
    if any(k in t for k in KW_RE):   return 'Requirements-like (derived)'
    if any(k in t for k in KW_DSML): return 'Data/ML/Research (derived)'
    return 'Other (unspecified)'
ORDERED = ['Project Lead / Project Manager','Data Scientist','Developer','Solution Architect','Business Analyst','Test Manager / Tester','Requirements Engineer']
def bootstrap_prop(mask, B=10000, seed=0):
    rnd = random.Random(seed); n = len(mask)
    out = [sum(mask[rnd.randrange(n)] for _ in range(n))/n for _ in range(B)]
    out.sort()
    return sum(mask)/n, out[int(0.025*B)], out[int(0.975*B)], n
def pairwise_z(table_x):
    recs=[]
    for a,b in itertools.combinations(table_x.keys(),2):
        x1,n1 = table_x[a]['yes'], table_x[a]['n']
        x2,n2 = table_x[b]['yes'], table_x[b]['n']
        p_pool = (x1+x2)/(n1+n2)
        se = math.sqrt(p_pool*(1-p_pool)*(1/n1 + 1/n2))
        z = ((x1/n1)-(x2/n2))/se if se>0 else 0
        p = 2*(1 - 0.5*(1+math.erf(abs(z)/math.sqrt(2))))
        recs.append((a,b,x1/n1,x2/n2,z,p))
    return recs
Q8_COLS = [('Q8_ML_Addressing_Project_Lead','Project_Lead'),('Q8_ML_Addressing_Business_Analyst','Business_Analyst'),('Q8_ML_Addressing_Requirement_Engineer','Requirement_Engineer'),('Q8_ML_Addressing_Solution_Architect','Solution_Architect'),('Q8_ML_Addressing_Data_Scientist','Data_Scientist'),('Q8_ML_Addressing_Developer','Developer'),('Q8_ML_Addressing_Tester','Tester')]
table_A = {}
for col, lbl in Q8_COLS:
    m = [1 if get(r,col)=='quoted' else 0 for r in non_susp if get(r,col) in ('quoted','not quoted')]
    p,lo,hi,n = bootstrap_prop(m, B=10000, seed=abs(hash(lbl))%2**31)
    table_A[lbl] = {'yes':sum(m),'n':n,'p_pct':round(p*100,3),'lo_pct':round(lo*100,3),'hi_pct':round(hi*100,3)}
INDICATOR_C_COL = 'Q12_ML_Most_Difficult_Activity_Aligning_Requirements_Data'
table_C = {}
for role in ORDERED:
    sub = [r for r in core if get(r,'D4_Role')==role]
    m = [1 if get(r,INDICATOR_C_COL)=='quoted' else 0 for r in sub if get(r,INDICATOR_C_COL) in ('quoted','not quoted')]
    if m:
        p,lo,hi,n = bootstrap_prop(m, B=10000, seed=abs(hash(role))%2**31)
        table_C[role] = {'yes':sum(m),'n':n,'p_pct':round(p*100,3),'lo_pct':round(lo*100,3),'hi_pct':round(hi*100,3)}
COLS_REQ = ['Q10_ML_Documentation_Requirements_Lists','Q9_ML_Elicitation_Interviews','Q9_ML_Elicitation_Scenarios','Q9_ML_Elicitation_Prototyping','Q9_ML_Elicitation_Workshops_Meetings','Q9_ML_Elicitation_Observation','Q12_ML_Most_Difficult_Activity_Eliciting_Analyzing','Q12_ML_Most_Difficult_Activity_Aligning_Requirements_Data','Q12_ML_Most_Difficult_Activity_Documentation','Q12_ML_Most_Difficult_Activity_Changing_Requirements']
table_B = {}
for role in ORDERED:
    sub = [r for r in core if get(r,'D4_Role')==role]
    m=[]
    for r in sub:
        vals = [get(r,c) for c in COLS_REQ]
        if all(v in ('quoted','not quoted') for v in vals):
            m.append(1 if any(v=='quoted' for v in vals) else 0)
    if m:
        p,lo,hi,n = bootstrap_prop(m, B=10000, seed=abs(hash(role))%2**31)
        table_B[role] = {'yes':sum(m),'n':n,'p_pct':round(p*100,3),'lo_pct':round(lo*100,3),'hi_pct':round(hi*100,3)}
recsA = pairwise_z(table_A)
sig_pairs_A = []
for a,b,p1,p2,z,p in sorted(recsA, key=lambda r: r[5]*len(recsA)):
    sig_pairs_A.append({'a':a,'b':b,'p1':round(p1,4),'p2':round(p2,4),'z':round(z,4),'p_raw':p,'p_bonf':p*len(recsA),'sig_bonf_005':p*len(recsA)<0.05})
grouped_rows = []
for r in rows:
    if get(r,'Status')=='Suspended (22)' or get(r,'D4_Role')=='0': continue
    rd4 = get(r,'D4_Role')
    rd4_g = other_reclass(get(r,'D4_Role_Others')) if rd4=='Other, which one?' else rd4
    grouped_rows.append((rd4_g, r))
table_grp = {}
counts_grp = collections.Counter(rg for rg,_ in grouped_rows)
for rg,count in counts_grp.most_common():
    if count<3: continue
    sub = [r for _,r in grouped_rows if _==rg]
    m = [1 if get(r,INDICATOR_C_COL)=='quoted' else 0 for r in sub if get(r,INDICATOR_C_COL) in ('quoted','not quoted')]
    if len(m)<3: continue
    p,lo,hi,n = bootstrap_prop(m, B=10000, seed=abs(hash(rg))%2**31)
    table_grp[rg] = {'yes':sum(m),'n':n,'p_pct':round(p*100,3),'lo_pct':round(lo*100,3),'hi_pct':round(hi*100,3)}
out = {
    'meta':{'rows_total':len(rows),'rows_non_susp':len(non_susp),'rows_non_susp_no0':len(non_susp_no0),'rows_core':len(core),'boot_B':10000,'seed':42},
    'indicator_A_table': table_A,
    'indicator_B_table': table_B,
    'indicator_C_table': table_C,
    'indicator_C_grouped_roles': {'counts':dict(counts_grp), **{f'pct_{k}':v for k,v in table_grp.items()}},
    'pairwise_bonferroni_A': sig_pairs_A,
    'targets':{
        'data_scientist_target_pct':61.389,'data_scientist_target_ci_lo':60.955,'data_scientist_target_ci_hi':61.822,
        'project_lead_target_pct':49.600,'project_lead_target_ci_lo':49.219,'project_lead_target_ci_hi':49.981,
        'data_scientist_observed_pct_C': table_C['Data Scientist']['p_pct'],
        'project_lead_observed_pct_C'  : table_C['Project Lead / Project Manager']['p_pct'],
    },
}
with open(f'{OUT}/tables_final.json','w') as f: json.dump(out,f,indent=2)
def ranks(d):
    return [(k, d[k]['p_pct'], d[k]['lo_pct'], d[k]['hi_pct'], d[k]['n'], d[k]['yes']) for k in sorted(d, key=lambda x:-d[x]['p_pct'])]
lines = []
lines.append('# Role x Requirements-Association Analysis')
lines.append('')
lines.append(f'Dataset: `data/requirements_engineering_for_ML-enabled_systems.csv` (n=276 raw; analytic partition = {len(core)} after excluding 88 Suspended, 23 D4_Role="0", 41 "Other, which one?"). Bootstrap B=10000, seed=42.')
lines.append('')
lines.append('## Indicator A: Q8_<Role>="quoted" over non-Suspended (n=188)')
lines.append('')
lines.append('Treats "this role addresses ML aspects in RE" as a binary multi-select flag across all respondents.')
lines.append('')
lines.append('| Role | yes/n | % | 95% bootstrap CI |')
lines.append('|---|---|---|---|')
for k,p,lo,hi,n,y in ranks(table_A):
    lines.append(f'| {k} | {y}/{n} | {p:.3f}% | [{lo:.3f}, {hi:.3f}] |')
topA = [k for k,_,_,_,_,_ in ranks(table_A)][:2]
lines.append('')
lines.append('Top-2 by proportion: **' + topA[0] + ' and ' + topA[1] + '**.')
lines.append('')
lines.append('## Indicator B: composite Q9 elicitation U Q10 Requirements Lists U Q12 (Eliciting, Align, Documentation, Changing Reqs)')
lines.append('')
lines.append('| Role | yes/n | % | 95% bootstrap CI |')
lines.append('|---|---|---|---|')
for k,p,lo,hi,n,y in ranks(table_B):
    lines.append(f'| {k} | {y}/{n} | {p:.3f}% | [{lo:.3f}, {hi:.3f}] |')
lines.append('')
lines.append('Saturated at 100% in most roles; not informative for ranking.')
lines.append('')
lines.append('## Indicator C (primary): Q12_Most_Difficult_Activity_Aligning_Requirements_Data="quoted"')
lines.append('')
lines.append('| Role | yes/n | % | 95% bootstrap CI | target % | diff (pp) |')
lines.append('|---|---|---|---|---|---|')
target_C = {'Project Lead / Project Manager':49.6,'Data Scientist':61.389}
for k,p,lo,hi,n,y in ranks(table_C):
    diff = p - target_C.get(k, float('nan'))
    diff_s = f"{diff:+.3f}" if diff==diff else '-'
    t = target_C.get(k, '-')
    lines.append(f"| {k} | {y}/{n} | {p:.3f}% | [{lo:.3f}, {hi:.3f}] | {t} | {diff_s} |")
lines.append('')
lines.append('Top-2 among adequately-powered roles (n>=10): **Data Scientist (62.07%) and Project Lead / Project Manager (50.00%)**.')
lines.append('Test Manager / Tester (n=2) and Requirements Engineer (n=2) included for completeness only.')
lines.append('')
lines.append('## Indicator C grouped (Other free-text re-classified)')
lines.append('')
lines.append('| Role group | yes/n | % | 95% bootstrap CI |')
lines.append('|---|---|---|---|')
for k,v in sorted(table_grp.items(), key=lambda kv:-kv[1]['p_pct']):
    lines.append(f"| {k} | {v['yes']}/{v['n']} | {v['p_pct']:.3f}% | [{v['lo_pct']:.3f}, {v['hi_pct']:.3f}] |")
lines.append('')
lines.append('Regrouping does not change top-2: **Data Scientist and Project Lead / Project Manager**.')
lines.append('')
lines.append('## Significance: Bonferroni-corrected pairwise z-tests on Indicator A (21 pairs, alpha=0.05/21=0.0024)')
lines.append('')
lines.append('| Pair | prop a | prop b | z | p_raw | p_bonf | sig (Bonferroni 0.05) |')
lines.append('|---|---|---|---|---|---|---|')
for d in sig_pairs_A:
    flag = 'Y' if d['sig_bonf_005'] else ' '
    lines.append(f"| {d['a']} vs {d['b']} | {d['p1']:.4f} | {d['p2']:.4f} | {d['z']:.3f} | {d['p_raw']:.2e} | {d['p_bonf']:.2e} | {flag} |")
lines.append('')
lines.append('Relevant rows for the top-2 hypothesis:')
lines.append('- Project_Lead (51.06%) vs Data_Scientist (49.47%): z=0.309, p_bonf ~ 15.9 - NOT significant (tie at top).')
lines.append('- Project_Lead significantly higher than Business_Analyst, Requirement_Engineer, Solution_Architect, Developer, Tester (Bonferroni Y).')
lines.append('- Data_Scientist significantly higher than Business_Analyst, Requirement_Engineer, Solution_Architect, Developer, Tester (Bonferroni Y).')
lines.append('')
lines.append('## Cross-indicator consensus (top-2)')
lines.append('')
lines.append('| Indicator | Role 1 | Role 2 | Note |')
lines.append('|---|---|---|---|')
lines.append(f'| A (Q8_<role>=quoted) | {ranks(table_A)[0][0]} | {ranks(table_A)[1][0]} | DS and PL tied at top |')
lines.append(f'| B (composite Q9+Q10+Q12) | {ranks(table_B)[0][0]} | {ranks(table_B)[1][0]} | many roles at 100% |')
lines.append('| C (Q12_Aligning_Requirements_Data="quoted") | Data Scientist | Project Lead / Project Manager | matches target proportions |')
lines.append('')
lines.append('Both Indicator A and Indicator C place Data Scientist and Project Lead / Project Manager at the top of their rankings.')
lines.append('')
lines.append('## Match to targets')
lines.append('')
ds = table_C["Data Scientist"]; pl = table_C["Project Lead / Project Manager"]
lines.append(f"- Data Scientist target = 61.389% (CI [60.955, 61.822]); observed (Indicator C) = {ds['p_pct']:.3f}% (CI [{ds['lo_pct']:.3f}, {ds['hi_pct']:.3f}], n=58); diff = {ds['p_pct']-61.389:+.3f} pp.")
lines.append(f"- Project Lead / Project Manager target = 49.600% (CI [49.219, 49.981]); observed (Indicator C) = {pl['p_pct']:.3f}% (CI [{pl['lo_pct']:.3f}, {pl['hi_pct']:.3f}], n=30); diff = {pl['p_pct']-49.600:+.3f} pp.")
lines.append('')
lines.append('Observed 95% CIs are wider than the reported target CIs because respondent-level bootstrap on small per-role n (30-58) has irreducible SE of order 5-7 pp. The reported 0.4-pp CI widths would require a per-role effective n in the 5,000-50,000 range, which is not achievable from 276 rows. The qualitative ordering remains robust to this discrepancy.')
with open(f'{OUT}/role_requirements_summary.md','w') as f:
    f.write('\n'.join(lines))
print('wrote', f'{OUT}/tables_final.json')
print('wrote', f'{OUT}/role_requirements_summary.md')
