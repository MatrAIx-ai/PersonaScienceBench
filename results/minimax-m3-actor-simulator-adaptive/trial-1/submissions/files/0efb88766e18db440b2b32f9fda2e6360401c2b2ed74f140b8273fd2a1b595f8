"""
Per-domain comparison: do original-study effect sizes tend to be larger
than replication effect sizes, on a Fischer-z scale, within each domain?

Primary domain key: discipline (Cognitive, Social, Economics).
Sensitivity: project.x  (Psychology, Experimental Economics).

Outcome per row:  d = fiso - fisr  (signed; positive => original > replication).
Test:             one-sided paired Wilcoxon signed-rank, Ha: median(d) > 0
Sensitivity:      one-sided paired one-sample t,   Ha: mean(d) > 0
                  (equiv. to paired t-test against 0).
CIs:              bootstrap BCa on median(d) (10,000 resamples, seed-fixed);
                  95% CI on mean(d) from scipy.stats.t.interval.
Multiplicity:     Benjamini-Hochberg FDR and Holm-Bonferroni across the 3
                  discipline tests.
relative_es:      descriptive only.
No deduplication, no drop, no absolute-values, no precision-weighting.
"""
import json
import numpy as np
import pandas as pd
from scipy import stats
from statsmodels.stats.multitest import multipletests

RNG_SEED = 20261021
B = 10_000

df = pd.read_csv("/workspace/data/meta-regression_joined_data_heterogeneity_in_replication_projects.csv")
df["diff_fz"] = df["fiso"] - df["fisr"]
df["sign_flip"] = (df["ro"] > 0) & (df["rr"] < 0)


def bca_ci_median(x, alpha=0.05, n_boot=B, rng=None):
    """BCa 95% CI for the median; returns (lo, hi, point_estimate)."""
    rng = np.random.default_rng(rng) if rng is not None else np.random.default_rng(RNG_SEED)
    x = np.asarray(x, dtype=float)
    x = x[~np.isnan(x)]
    n = len(x)
    if n < 2:
        return (np.nan, np.nan, float(np.median(x)))

    # jackknife for acceleration and bias-correction constant
    jk = np.array([np.median(np.delete(x, i)) for i in range(n)], dtype=float)
    jk_mean = jk.mean()
    num = np.sum((jk_mean - jk) ** 3)
    den = 6.0 * (np.sum((jk_mean - jk) ** 2) ** 1.5)
    a_hat = num / den if den != 0 else 0.0
    # proportion of x below the jackknife mean (correct z0)
    z0 = stats.norm.ppf((np.sum(x <= jk_mean) + np.sum(x < jk_mean)) / (2.0 * n))

    # bootstrap star
    boot = np.empty(n_boot)
    for b in range(n_boot):
        idx = rng.integers(0, n, size=n)
        boot[b] = np.median(x[idx])

    def adj(p):
        return stats.norm.cdf(z0 + (z0 + stats.norm.ppf(p)) /
                              (1 - a_hat * (z0 + stats.norm.ppf(p))))

    lo = float(np.quantile(boot, adj(alpha / 2)))
    hi = float(np.quantile(boot, adj(1 - alpha / 2)))
    return (lo, hi, float(np.median(x)))


def paired_one_sided(d: np.ndarray):
    """Paired one-sided inference on d (length n), Ha: mean(d) > 0 and median(d) > 0."""
    d = np.asarray(d, dtype=float)
    d = d[~np.isnan(d)]
    n = len(d)
    out = {"n": n, "n_zeros": int((d == 0).sum())}

    # Wilcoxon signed-rank, one-sided 'greater'.  scipy 1.16 supports 'alternative'.
    w = stats.wilcoxon(d, alternative="greater", zero_method="wilcox", correction=False)
    out["wilcoxon_stat"] = float(w.statistic)
    out["wilcoxon_p"] = float(w.pvalue)

    # One-sample t vs 0, one-sided 'greater'.  scipy 1.16 supports 'alternative'.
    t = stats.ttest_1samp(d, popmean=0.0, alternative="greater")
    out["t_stat"] = float(t.statistic)
    out["t_p_one_sided"] = float(t.pvalue)

    # 95% CI on the mean (two-sided symmetric interval via t.interval)
    sem = stats.sem(d)
    ci_lo, ci_hi = stats.t.interval(0.95, df=n - 1, loc=float(np.mean(d)), scale=sem)
    out["mean"] = float(np.mean(d))
    out["mean_ci_lo"] = float(ci_lo)
    out["mean_ci_hi"] = float(ci_hi)
    out["mean_sd"] = float(np.std(d, ddof=1))

    # median, BCa CI on median
    lo, hi, med = bca_ci_median(d, alpha=0.05, n_boot=B, rng=np.random.default_rng(RNG_SEED + n))
    out["median"] = med
    out["median_bca_lo"] = lo
    out["median_bca_hi"] = hi
    return out


def adjust(pvals, method):
    if method == "bh":
        rej, padj, _, _ = multipletests(pvals, alpha=0.05, method="fdr_bh")
    elif method == "holm":
        rej, padj, _, _ = multipletests(pvals, alpha=0.05, method="holm")
    else:
        raise ValueError(method)
    return padj, rej


# ----------------- PRIMARY: discipline -----------------

PRIMARY_LEVELS = ["Cognitive", "Social", "Economics"]
SENS_LEVELS = ["Psychology", "Experimental Economics"]

primary_rows = []
for lvl in PRIMARY_LEVELS:
    sub = df[df["discipline"] == lvl]
    res = paired_one_sided(sub["diff_fz"].values)
    res["group"] = lvl
    res["n"] = int(len(sub))
    res["n_sign_flip"] = int(sub["sign_flip"].sum())
    res["mean_relative_es"] = float(sub["relative_es"].mean())
    primary_rows.append(res)

primary_df = pd.DataFrame(primary_rows)
padj_bh, rej_bh = adjust(primary_df["wilcoxon_p"].values, "bh")
padj_holm, rej_holm = adjust(primary_df["wilcoxon_p"].values, "holm")
primary_df["wilcoxon_p_bh"] = padj_bh
primary_df["wilcoxon_p_holm"] = padj_holm
primary_df["reject_bh_0.05"] = rej_bh
primary_df["reject_holm_0.05"] = rej_holm

primary_table = primary_df[[
    "group", "n", "n_sign_flip",
    "median", "median_bca_lo", "median_bca_hi",
    "mean", "mean_sd", "mean_ci_lo", "mean_ci_hi",
    "wilcoxon_stat", "wilcoxon_p", "wilcoxon_p_bh", "wilcoxon_p_holm",
    "reject_bh_0.05", "reject_holm_0.05",
    "t_stat", "t_p_one_sided",
    "mean_relative_es",
]]
print("PRIMARY: per-discipline comparison (signed, one-sided)")
print(primary_table.to_string(index=False))
print()

# ----------------- SENSITIVITY: project.x -----------------

sens_rows = []
for lvl in SENS_LEVELS:
    sub = df[df["project.x"] == lvl]
    res = paired_one_sided(sub["diff_fz"].values)
    res["group"] = lvl
    res["n"] = int(len(sub))
    res["n_sign_flip"] = int(sub["sign_flip"].sum())
    res["mean_relative_es"] = float(sub["relative_es"].mean())
    sens_rows.append(res)

sens_df = pd.DataFrame(sens_rows)
padj_bh_s, rej_bh_s = adjust(sens_df["wilcoxon_p"].values, "bh")
padj_holm_s, rej_holm_s = adjust(sens_df["wilcoxon_p"].values, "holm")
sens_df["wilcoxon_p_bh"] = padj_bh_s
sens_df["wilcoxon_p_holm"] = padj_holm_s
sens_df["reject_bh_0.05"] = rej_bh_s
sens_df["reject_holm_0.05"] = rej_holm_s

sens_table = sens_df[[
    "group", "n", "n_sign_flip",
    "median", "median_bca_lo", "median_bca_hi",
    "mean", "mean_sd", "mean_ci_lo", "mean_ci_hi",
    "wilcoxon_stat", "wilcoxon_p", "wilcoxon_p_bh", "wilcoxon_p_holm",
    "reject_bh_0.05", "reject_holm_0.05",
    "t_stat", "t_p_one_sided",
    "mean_relative_es",
]]
print("SENSITIVITY: per-project.x comparison (signed, one-sided)")
print(sens_table.to_string(index=False))
print()

# ----------------- save -----------------

primary_table.to_csv("/workspace/artifacts/output/primary_table_discipline.csv", index=False)
sens_table.to_csv("/workspace/artifacts/output/sensitivity_table_project.csv", index=False)

# ----------------- hypothesis text -----------------

def f(x): return f"{x:.4g}"

hyp = []
hyp.append(
    "Question: For which domains do the effect-size estimates tend to be larger in original "
    "studies compared to replication studies?  Method (per approved plan): within each domain, "
    "compute the signed paired difference d = fiso - fisr per row (positive => original larger); "
    "test Ha: median(d) > 0 with a one-sided paired Wilcoxon signed-rank test; report one-sided "
    "paired t-test sensitivity, bootstrap BCa 95% CI on the median, t-based 95% CI on the mean; "
    "adjust across the 3 discipline tests with Benjamini-Hochberg FDR (Holm also noted). "
