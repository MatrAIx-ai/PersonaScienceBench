rej_str = ", ".join(
    [f"{r['group']} (p_BH={f(r['wilcoxon_p_bh'])}, n={int(r['n'])})"
     for _, r in rejected.iterrows()]
) or "none"
not_rej_str = ", ".join(
    [f"{r['group']} (p_BH={f(r['wilcoxon_p_bh'])}, n={int(r['n'])})"
     for _, r in not_rej.iterrows()]
) or "none"
hyp.append(
