"""
DiscoveryBench / metadata_23.json — full analysis script.
Question: Between 3400 BCE and 3000 BCE, how does the number of monuments and
axes change with elements of symbolic capital?

This script is the executed analysis referenced in the result handoff.
Output artefacts (CSV) are written next to this script.
"""
import pandas as pd, numpy as np
from scipy import stats
import os, pathlib

ROOT = pathlib.Path(__file__).resolve().parent.parent
DATA = ROOT / "data"
OUT  = pathlib.Path(__file__).resolve().parent
os.makedirs(OUT, exist_ok=True)

# 0. Load (note: capital.csv and pollen CSV use German decimal commas)
ts  = pd.read_csv(DATA / "time_series_data.csv", index_col=0)
cap = pd.read_csv(DATA / "capital.csv", decimal=",")
pol = pd.read_csv(DATA / "pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv",
                  index_col=0, decimal=",")

# 1. Slice to 3400–3000 BCE
ts_s = ts.iloc[700:1101].copy().reset_index(drop=True)              # 401 rows, CE -3400..-3000
cap_s = cap[(cap.BCE >= 3000) & (cap.BCE <= 3400)].copy().reset_index(drop=True)
pol_s = pol[(pol.CE <= -3000) & (pol.CE >= -3400)].copy().reset_index(drop=True)

# 2. Anchor overlay (5 100-yr bins) — direct from capital.csv
anchor = pd.DataFrame({
    "BCE":          cap_s.BCE.values,
    "ZMonument":    cap_s.ZMonument.values,
    "ZMW":          cap_s.ZMW.values,
    "ZBeil":        cap_s.ZBeil.values,
    "ZAxtSchwert":  cap_s.ZAxtSchwert.values,
    "ZDolch":       cap_s.ZDolch.values,
    "Zhausgr":      cap_s.Zhausgr.values,
    "Zamber":       cap_s.Zamber.values,
    "ZCU_AU":       cap_s.ZCU_AU.values,
    "ZHort":        cap_s.ZHort.values,
})

# Cross-check that capital.csv == time_series raw anchors at the 5 BCE points
ts_idx_off = {3400:0, 3300:100, 3200:200, 3100:300, 3000:400}
for col_pair in [("ZMonument","MonumentCount"), ("ZMW","MonumentSize"),
                 ("ZBeil","AxesCelts"), ("ZAxtSchwert","HatchetSword"),
                 ("ZDolch","Dagger"), ("Zhausgr","HouseSize")]:
    cap_col, ts_col = col_pair
    for bce, off in ts_idx_off.items():
        a = cap_s.loc[cap_s.BCE==bce, cap_col].iloc[0]
        b = ts_s.iloc[off][ts_col]
        assert np.isclose(a, b, atol=1e-6), f"Mismatch {cap_col} vs {ts_col} at {bce}"
print("Capital.csv and time_series raw anchors align exactly at the 5 BCE points.")

# 3. Δ-slope + peak/trough per series
def describe_series(name, vals):
    v = np.asarray(vals, dtype=float)
    imax, imin = int(np.argmax(v)), int(np.argmin(v))
    delta = v[-1] - v[0]
    return {
        "series": name,
        "start_3400": float(v[0]),
        "end_3000":   float(v[-1]),
        "delta_3400_to_3000": float(delta),
        "peak_BCE": int(anchor.BCE.iloc[imax]),
        "peak_value": float(v[imax]),
        "trough_BCE": int(anchor.BCE.iloc[imin]),
        "trough_value": float(v[imin]),
        "max_minus_min": float(v[imax]-v[imin]),
    }
desc_rows = []
for col in ["ZMonument","ZMW","ZBeil","ZAxtSchwert","ZDolch","Zhausgr","Zamber","ZCU_AU","ZHort"]:
    desc_rows.append(describe_series(col, anchor[col].values))
desc_df = pd.DataFrame(desc_rows)
desc_df.to_csv(OUT/"anchor_describe.csv", index=False)
print("\nAnchor series description (5 points):")
print(desc_df.round(3).to_string(index=False))

# 4. Pearson + Spearman on 5 anchors (descriptive only — n=5)
def safe_pearson(x, y):
    if np.std(x) == 0 or np.std(y) == 0:
        return (np.nan, np.nan)
    return stats.pearsonr(x, y)
def safe_spearman(x, y):
    if np.std(x) == 0 or np.std(y) == 0:
        return (np.nan, np.nan)
    return stats.spearmanr(x, y)

corr_rows = []
targets = ["ZMonument","ZMW","ZBeil"]
symbols = ["ZAxtSchwert","ZDolch","Zhausgr"]
for t in targets:
    for s in symbols:
        x = anchor[t].values; y = anchor[s].values
        rp, pp = safe_pearson(x, y)
        rs, ps = safe_spearman(x, y)
        corr_rows.append({"target":t, "symbol":s, "pearson_r":rp, "pearson_p":pp,
                          "spearman_r":rs, "spearman_p":ps})
corr_df = pd.DataFrame(corr_rows)
corr_df.to_csv(OUT/"correlations_5anchors.csv", index=False)
print("\nCorrelation matrix (n=5; descriptive only):")
print(corr_df.round(3).to_string(index=False))

# Alignment of Monuments<->Axes themselves
extra = []
for a, b in [("ZMonument","ZBeil"), ("ZMonument","ZMW"), ("ZBeil","ZMW")]:
    x = anchor[a].values; y = anchor[b].values
    rp, pp = safe_pearson(x, y); rs, ps = safe_spearman(x, y)
    extra.append({"target":a, "symbol":b, "pearson_r":rp, "pearson_p":pp,
                  "spearman_r":rs, "spearman_p":ps})
pd.DataFrame(extra).to_csv(OUT/"monuments_axes_alignment.csv", index=False)
print("\nMonument↔Axes / Size alignment (n=5):")
print(pd.DataFrame(extra).round(3).to_string(index=False))

# 5. Trajectory data (interp + raw anchors)
traj = pd.DataFrame({
    "CE": ts_s["CE"],
    "MonumentCount_inter": ts_s["MonumentCount_inter"],
    "AxesCelts_inter":     ts_s["AxesCelts_inter"],
    "HatchetSword_inter":  ts_s["HatchetSword_inter"],
    "Dagger_inter":        ts_s["Dagger_inter"],
    "HouseSize_inter":     ts_s["HouseSize_inter"],
    "MonumentCount_raw":   ts_s["MonumentCount"],
    "AxesCelts_raw":       ts_s["AxesCelts"],
    "HatchetSword_raw":    ts_s["HatchetSword"],
    "Dagger_raw":          ts_s["Dagger"],
    "HouseSize_raw":       ts_s["HouseSize"],
})
traj.to_csv(OUT/"trajectory_3400_3000.csv", index=False)

# 6. Demographic backdrop (direction only)
def pollen_desc(name, s):
    return {
        "series": name,
        "start_3400": float(s.iloc[0]),
        "end_3000":   float(s.iloc[-1]),
        "delta":      float(s.iloc[-1]-s.iloc[0]),
        "min":        float(s.min()),
        "max":        float(s.max()),
    }
pol_rows = []
for col in ["Belau_PC1_inter","MEAN","SMOOTH_MEAN_100y"]:
    pol_rows.append(pollen_desc(col, pol_s[col]))
pd.DataFrame(pol_rows).to_csv(OUT/"pollen_backdrop_summary.csv", index=False)
print("\nPollen openness (direction only):")
print(pd.DataFrame(pol_rows).round(3).to_string(index=False))

# 7. Save slices for transparency
ts_s.to_csv(OUT/"TS_slice_3400_3000.csv", index=False)
cap_s.to_csv(OUT/"capital_slice_3400_3000.csv", index=False)
pol_s.to_csv(OUT/"pollen_slice_3400_3000.csv", index=False)

# 8. Final natural-language hypothesis (data-grounded, co-trajectory wording)
hypothesis = (
    "Between 3400 and 3000 BCE the counts of monuments and the deposition record of axes track each other tightly across the slice: both rise from below-average (ZMonument −0.46, ZBeil +0.37 at BCE 3400) to a clear joint peak at BCE 3200 (ZMonument +0.91, ZBeil +2.60, Pearson r = +0.87, Spearman ρ = +0.62 on the 5 anchor observations), then re-converge to mildly positive values by BCE 3000 (ZMonument −0.36, ZBeil +0.80). The three symbolic-capital indicators do not share this peak: HatchetSword (≈ ZAxtSchwert, the axe-and-sword weapon-symbol class) is essentially flat across the slice (−0.43 throughout, peak-to-trough range 0.01σ), Dagger (≈ ZDolch) is constant at −0.58, and HouseSize (≈ Zhausgr) is highest at the start (+2.05) and falls steadily to its slice minimum at BCE 3100 (−0.06) before a partial recovery to +0.19. Counter to an expectation of cross-symbol synchrony, monument counts and axes co-rise while the two weapon-symbol components stay flat and HouseSize declines — a co-trajectory of the built form with the axe/celt record that is decoupled from, and partly opposed to, the Hatchet-Swords / Daggers / HouseSize reading of symbolic capital. Monument size (ZMonumentSize / ZMW) moves opposite to the count (Pearson r ≈ −0.20 vs ZMonument, r ≈ −0.62 vs ZBeil), so the BCE 3200 spike is one of more, but not larger, monuments. As backdrop the pollen-based openness record (Belau PC1, the cross-site MEAN, and SMOOTH_MEAN_100y) rises across the slice (Belau_PC1_inter −1.16 → +1.65; MEAN −1.86 → +0.08; SMOOTH_MEAN_100y −1.81 → +0.20), so the monument-and-axes peak at BCE 3200 sits on a backdrop of rising, not falling, openness."
)
with open(OUT/"hypothesis.txt","w") as f:
    f.write(hypothesis)
print("\nHypothesis written to artifacts/hypothesis.txt")
