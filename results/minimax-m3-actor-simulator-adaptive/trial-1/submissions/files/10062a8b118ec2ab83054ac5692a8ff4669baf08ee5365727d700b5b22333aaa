"""
analysis.py -- Discovery-Bench archaeology / metadata_13
Question: In what centuries did we see the highest growth phase of the period
between 2000 BCE and 1100 BCE?

Operationalization (study context): demographic growth is pollen_grate_100
(per-year fractional change of the 100-yr-smoothed openness score
pollen_inter_100). Openness growth should track cultural/economic capital
proxies.
"""
import os
import numpy as np
import pandas as pd

DATA = "data"
ART  = "artifacts/analysis"
os.makedirs(ART, exist_ok=True)

# ---------- helpers ---------------------------------------------------------
def to_num(s):
    return pd.to_numeric(s.astype(str).str.replace(",", ".", regex=False),
                         errors="coerce")

def load_time_series():
    return pd.read_csv(f"{DATA}/time_series_data.csv")

def load_capital():
    df = pd.read_csv(f"{DATA}/capital.csv")
    for c in df.columns:
        if c not in ("BCE","group","color"):
            df[c] = to_num(df[c])
    return df

def load_pollen_file():
    df = pd.read_csv(f"{DATA}/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv")
    for c in df.columns:
        if c == "Unnamed: 0":
            continue
        if df[c].dtype.kind not in ("f","i"):
            df[c] = to_num(df[c])
    # Belt-and-braces: cast any remaining object to numeric
    for c in df.columns:
        if c == "Unnamed: 0":
            continue
        if df[c].dtype.kind not in ("f","i"):
            df[c] = pd.to_numeric(df[c], errors="coerce")
    return df

def log1p_slope(y, x):
    mask = np.isfinite(y) & np.isfinite(x)
    n = int(mask.sum())
    if n < 3:
        return np.nan, np.nan, n
    yy = np.log1p(np.asarray(y[mask], dtype=float))
    xx = np.asarray(x[mask], dtype=float)
    if yy.std() == 0:
        return 0.0, np.nan, n
    slope, intercept = np.polyfit(xx, yy, 1)
    ss_res = float(np.sum((yy - (slope*xx + intercept))**2))
    ss_tot = float(np.sum((yy - yy.mean())**2))
    r2 = 1.0 - ss_res/ss_tot if ss_tot > 0 else np.nan
    return slope, r2, n

# ---------- load ------------------------------------------------------------
ts  = load_time_series()
cap = load_capital()
pol = load_pollen_file()

for c in ["SMOOTH_MEAN_100y","SMOOTH_MEAN_200y","MEAN"]:
    print(f"pol {c} dtype: {pol[c].dtype}, non-null: {pol[c].notna().sum()}")

WIN_LO, WIN_HI = -2000, -1100                    # 2000 BCE .. 1100 BCE
ts_w  = ts[(ts["CE"]   >= WIN_LO) & (ts["CE"]   <= WIN_HI)].copy()
pol_w = pol[(pol["CE"] >= WIN_LO) & (pol["CE"] <= WIN_HI)].copy()
print(f"time_series rows in window: {len(ts_w)}  ({ts_w['CE'].min()}..{ts_w['CE'].max()})")
print(f"pollen_file rows in window: {len(pol_w)}  ({pol_w['CE'].min()}..{pol_w['CE'].max()})")

# ---------- 9 century bins (half-open, -1100 row excluded by default) -----
bin_lo = [-2000,-1900,-1800,-1700,-1600,-1500,-1400,-1300,-1200]
bin_hi = [-1901,-1801,-1701,-1601,-1501,-1401,-1301,-1201,-1101]
bin_labels = [f"{abs(lo)}-{abs(hi)} BCE" for lo,hi in zip(bin_lo,bin_hi)]
print("Bins:", bin_labels)

def assign_bin(ce):
    if ce == -1100:
        return None       # boundary row, excluded from default bins
    for lo, hi, lbl in zip(bin_lo, bin_hi, bin_labels):
        if ce >= lo and ce <= hi:
            return lbl
    return None

ts_w["bin"]  = ts_w["CE"].map(assign_bin)
pol_w["bin"] = pol_w["CE"].map(assign_bin)
print("bin row counts (ts_w):")
print(ts_w["bin"].value_counts().reindex(bin_labels))

CAPITAL_COLS  = ["HatchetSword","Dagger","HouseSize","CopperGold","Amber",
                 "MonumentCount","Depot","Sickle","AxesCelts","MonumentSize",
                 "PotteryForm","PotteryDecoration"]
CAPITAL_INTER = [c + "_inter" for c in CAPITAL_COLS]
assert all(c in ts_w.columns for c in CAPITAL_INTER), "missing _inter cols"

# ---------- per-bin aggregation --------------------------------------------
records = []
for lbl in bin_labels:
    sub     = ts_w[ts_w["bin"] == lbl]
    sub_pol = pol_w[pol_w["bin"] == lbl]
    rec = {"century_window": lbl,
           "n":          len(sub),
           "mean_grate": float(sub["pollen_grate_100"].mean()),
           "std_grate":  float(sub["pollen_grate_100"].std()),
           "min_grate":  float(sub["pollen_grate_100"].min()),
           "max_grate":  float(sub["pollen_grate_100"].max())}
    slope, r2, _ = log1p_slope(sub["pollen_inter_100"], sub["CE"])
    rec["slope_log1p_inter100_per_yr"] = slope
    rec["r2_log1p_inter100"]           = r2
    rec["mean_kde_all_mean"]           = float(sub["kde_all_mean"].mean())
    rec["mean_g_all_mean"]             = float(sub["g_all_mean"].mean())
    for c in CAPITAL_INTER:
        vals = sub[c].dropna().to_numpy()
        rec[f"delta_{c}"] = float(vals[-1] - vals[0]) if len(vals) >= 2 else 0.0
    rec["mean_SMOOTH_MEAN_100y"]        = float(sub_pol["SMOOTH_MEAN_100y"].mean())
    rec["mean_SMOOTH_MEAN_200y"]        = float(sub_pol["SMOOTH_MEAN_200y"].mean())
    s200, _, _ = log1p_slope(sub_pol["SMOOTH_MEAN_200y"], sub_pol["CE"])
    rec["slope_log1p_SMOOTH_MEAN_200y"] = s200
    rec["sum_pos_grate"]                = float(sub["pollen_grate_100"].clip(lower=0).sum())
    records.append(rec)

table = (pd.DataFrame(records)
            .set_index("century_window")
            .reindex(bin_labels))

# ---------- rankings --------------------------------------------------------
primary_rank = table["mean_grate"].rank(ascending=False, method="min").astype(int)
robA_rank    = table["slope_log1p_inter100_per_yr"].rank(ascending=False, method="min").astype(int)

table["cum2_mean_grate"] = table["mean_grate"].rolling(2, min_periods=1).sum()
table["cum3_mean_grate"] = table["mean_grate"].rolling(3, min_periods=1).sum()
top2_start = table["cum2_mean_grate"].idxmax()
top3_start = table["cum3_mean_grate"].idxmax()
top2_val   = float(table["cum2_mean_grate"].max())
top3_val   = float(table["cum3_mean_grate"].max())

primary_top = table["mean_grate"].idxmax()
idx = bin_labels.index(primary_top)
neigh = [bin_labels[max(0,idx-1)], primary_top, bin_labels[min(len(bin_labels)-1, idx+1)]]

# ---------- concordance: within-bin capital deltas & between-bin change ----
print(f"\nprimary top bin: {primary_top};  neighbors: {neigh}")

print("\nCapital Z_inter within-bin deltas (primary top bin):")
for c in CAPITAL_INTER:
    print(f"  {c}: {table.loc[primary_top, f'delta_{c}']:+.4f}")

print("\nBetween-bin capital change (start of [next] - end of [current]):")
for i in range(len(bin_labels)-1):
    a, b = bin_labels[i], bin_labels[i+1]
    end_a   = ts_w[ts_w["bin"]==a].iloc[-1]
    start_b = ts_w[ts_w["bin"]==b].iloc[0]
    line = f"  {a} -> {b}:"
    for c in CAPITAL_INTER:
        d = start_b[c] - end_a[c]
        line += f" {c.replace('_inter','')}={d:+.2f}"
    print(line)

# ---------- 1100 BCE inclusion sensitivity ----------------------------------
sub_def = ts_w[ts_w["bin"] == "1200-1101 BCE"]
sub_inc = ts_w[(ts_w["CE"] >= -1200) & (ts_w["CE"] <= -1100)]
print("\n1100 BCE inclusion sensitivity (last bin only):")
for name, sub in [("default: 1200-1101 BCE (excl -1100)", sub_def),
                  ("incl -1100: 101 rows 1200-1100 BCE", sub_inc)]:
    n = len(sub)
    m = float(sub["pollen_grate_100"].mean())
    print(f"  {name}: n={n}, mean grate={m:+.6e}, std={sub['pollen_grate_100'].std():.4e},"
          f" max={sub['pollen_grate_100'].max():+.6e}, min={sub['pollen_grate_100'].min():+.6e}")

# Re-rank all 9 with -1100 included
sens_records = []
for lbl in bin_labels:
    sub = sub_inc if lbl == "1200-1101 BCE" else ts_w[ts_w["bin"] == lbl]
    sens_records.append({"century_window": lbl,
                         "mean_grate_incl1100": float(sub["pollen_grate_100"].mean())})
sens_df = pd.DataFrame(sens_records).set_index("century_window")
sens_top = sens_df["mean_grate_incl1100"].idxmax()
print(f"\nWith -1100 included in last bin:  top-1 still {primary_top}?  "
      f"sensitivity rank-1 = {sens_top}  ({(sens_top==primary_top)})")

# ---------- save outputs ----------------------------------------------------
table_out = table.copy()
table_out["rank_primary_mean_grate"] = primary_rank
table_out["rank_robustA_log_slope"]  = robA_rank
table_out["cum2_mean_grate"]         = table["cum2_mean_grate"]
table_out["cum3_mean_grate"]         = table["cum3_mean_grate"]
for col in table_out.columns:
    if table_out[col].dtype.kind == "f":
        table_out[col] = table_out[col].map(lambda x: float(f"{x:.6g}"))
table_out.to_csv(f"{ART}/per_century_table.csv", index_label="century_window")
table.to_csv(f"{ART}/full_table.csv",          index_label="century_window")

rank_df = pd.DataFrame({
    "century_window":          bin_labels,
    "mean_grate_per_yr":       table["mean_grate"].values,
    "rank_primary_mean_grate": primary_rank.values,
    "rank_robustA_log_slope":  robA_rank.values,
    "cum2_mean_grate":         table["cum2_mean_grate"].values,
    "cum3_mean_grate":         table["cum3_mean_grate"].values,
})
rank_df.to_csv(f"{ART}/rankings.csv", index=False)

# ---------- console summary ------------------------------------------------
pd.options.display.width = 240
pd.options.display.max_columns = None
pd.options.display.float_format = "{:.6e}".format

show_cols = ["n","mean_grate","std_grate","min_grate","max_grate",
             "slope_log1p_inter100_per_yr","r2_log1p_inter100",
             "mean_kde_all_mean","mean_g_all_mean",
             "sum_pos_grate","mean_SMOOTH_MEAN_100y",
             "mean_SMOOTH_MEAN_200y","slope_log1p_SMOOTH_MEAN_200y",
             "rank_primary_mean_grate","rank_robustA_log_slope",
             "cum2_mean_grate","cum3_mean_grate"]
print("\n========= PER-CENTURY TABLE =========")
print(table[show_cols].to_string())

print(f"\nPRIMARY top century: {primary_top}  "
      f"(mean pollen_grate_100/yr = {table.loc[primary_top,'mean_grate']:+.6e})")
print(f"Robust A top century: {robA_rank.idxmin()}  "
      f"(slope log(1+inter_100) yr^-1 = {table.loc[robA_rank.idxmin(),'slope_log1p_inter100_per_yr']:+.6e})")
print(f"Robust B top-2-century cum window: starts {top2_start}  cum2 = {top2_val:+.6e}")
print(f"Robust B top-3-century cum window: starts {top3_start}  cum3 = {top3_val:+.6e}")

print("\nPrimary top bin headline numbers:")
for k in ["mean_grate","std_grate","slope_log1p_inter100_per_yr","r2_log1p_inter100",
         "mean_kde_all_mean","mean_g_all_mean",
         "mean_SMOOTH_MEAN_200y","slope_log1p_SMOOTH_MEAN_200y","sum_pos_grate"]:
    print(f"  {k}: {table.loc[primary_top,k]:+.6e}")

top3 = table["mean_grate"].nlargest(3).index.tolist()
print("\nTop-3 primary bins vs 200yr-smoothing ranks:")
for b in top3:
    s200       = table.loc[b,"slope_log1p_SMOOTH_MEAN_200y"]
    rank_by_sl = int(table["slope_log1p_SMOOTH_MEAN_200y"].rank(ascending=False, method="min").loc[b])
    rank_by_lv = int(table["mean_SMOOTH_MEAN_200y"].rank(ascending=False, method="min").loc[b])
    print(f"  {b}: primary rank={int(primary_rank.loc[b])}, 200yr-slope={s200:+.6e} (rank={rank_by_sl}), 200yr-level rank={rank_by_lv}")

print("\nCONCORDANCE on top + 2 neighbours (count of capital categories with END>START within bin):")
for b in neigh:
    positives = sum(1 for c in CAPITAL_INTER if table.loc[b, f'delta_{c}'] > 0)
    negatives = sum(1 for c in CAPITAL_INTER if table.loc[b, f'delta_{c}'] < 0)
    zeros     = 12 - positives - negatives
    print(f"  {b}: positive deltas = {positives}/12, negative = {negatives}/12, zero = {zeros}/12")
