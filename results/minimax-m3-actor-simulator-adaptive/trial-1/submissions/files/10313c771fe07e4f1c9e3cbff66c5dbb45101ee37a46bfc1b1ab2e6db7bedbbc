"""Century-binned social-capital analysis — full Step 1..7 execution.

Bin convention: K-th century BCE = BCE = K*100 .. (K-1)*100 + 1.
E.g. 14th century BCE = 1400..1301 BCE.
For a year y BCE (equivalently CE=-y), K = ceil(y/100) = (y+99)//100.
"""
import json, math
import numpy as np
import pandas as pd

# ============================================================
# Step 1 — load + parse
# ============================================================
ts = pd.read_csv("data/time_series_data.csv")
cap = pd.read_csv("data/capital.csv")

zc = ["ZAxtSchwert","ZDolch","Zhausgr","ZCU_AU","Zamber","ZMonument",
      "ZHort","ZSichel","ZBeil","ZMW","ZKeform","Zkeverz"]
for c in zc:
    cap[c] = cap[c].str.replace(",", ".").astype(float)

rename = dict(ZAxtSchwert="HatchetSword", ZDolch="Dagger", Zhausgr="HouseSize",
              ZCU_AU="CopperGold", Zamber="Amber", ZMonument="MonumentCount",
              ZHort="Depot", ZSichel="Sickle", ZBeil="AxesCelts",
              ZMW="MonumentSize", ZKeform="PotteryForm", Zkeverz="PotteryDecoration")
z_order = list(rename.values())            # plain column names  (12)
inter_cols = [c + "_inter" for c in z_order]

# add a capital.csv column with the matching plain-name
for k, v in rename.items():
    cap[v] = cap[k]

# Cross-validation
n_pairs, diffs = 0, 0.0
for _, r in cap.iterrows():
    ce = -int(r["BCE"])
    if ce in ts["CE"].values:
        rr = ts.loc[ts["CE"] == ce].iloc[0]
        for v in z_order:
            diffs += abs(r[v] - rr[v + "_inter"]); n_pairs += 1
print(f"[diag] capital vs *inter @ bin centers: n_pairs={n_pairs}, mean|Δ|={diffs/n_pairs:.6f}")

# ============================================================
# Step 2 — bin into 100-year centuries
# ============================================================
def year_to_K(y):
    return (y + 99) // 100              # K-th century BCE for year y BCE

def K_to_yr_range(K):
    return -100*K, -100*(K-1) - 1       # (yr_lo, yr_hi)  e.g. K=14 -> (-1400,-1301)

ts["K"] = ts["CE"].apply(lambda ce: year_to_K(-int(ce)))
K_set_ts = sorted(ts["K"].unique())
print(f"[diag] rows read: {len(ts)}, bins produced: {len(K_set_ts)}, K range: {min(K_set_ts)}..{max(K_set_ts)}")
print(f"[diag] NaN total in *_inter: {ts[inter_cols].isna().sum().sum()}")
print(f"[diag] NaN total in raw Z : {ts[z_order].isna().sum().sum()}")

# ============================================================
# Step 3 — per-bin aggregates
# ============================================================
inter_mean = ts.groupby("K")[inter_cols].mean().rename(columns=lambda c: c.replace("_inter","_inter_mean"))
# raw Z only at bin center (CE = -yr_lo = -100*K)
def raw_at_center(K):
    sub = ts.loc[ts["K"]==K]
    center_ce = -100*K
    if (sub["CE"]==center_ce).any():
        return sub.loc[sub["CE"]==center_ce, z_order].iloc[0]
    return pd.Series({c: np.nan for c in z_order})
raw_center = pd.DataFrame({K: raw_at_center(K) for K in K_set_ts}).T
poll_mean  = ts.groupby("K")[["pollen_inter_100","pollen_grate_100"]].mean()

records = []
for K in K_set_ts:
    yr_lo, yr_hi = K_to_yr_range(K)
    rec = {
        "K_th_century_BCE": int(K),
        "year_range": f"{abs(yr_lo)}–{abs(yr_hi)} BCE",
        "CE_range":   f"{yr_lo}..{yr_hi}",
        "n_rows_in_bin": int((ts["K"]==K).sum()),
        "has_raw_Z_centers": int(raw_center.loc[K].notna().sum()),
    }
    for c in z_order:
        rec[f"{c}_inter_mean"] = float(inter_mean.loc[K, f"{c}_inter_mean"])
        v = raw_center.loc[K, c]
        rec[f"{c}_raw_center"] = None if pd.isna(v) else float(v)
    rec["pollen_inter_100_mean"] = float(poll_mean.loc[K, "pollen_inter_100"])
    rec["pollen_grate_100_mean"] = float(poll_mean.loc[K, "pollen_grate_100"])
    rec["SC3_inter_sum"] = rec["CopperGold_inter_mean"] + rec["Amber_inter_mean"] + rec["MonumentCount_inter_mean"]
    if raw_center.loc[K, ["CopperGold","Amber","MonumentCount"]].notna().all():
        rec["SC3_raw_sum"] = float(raw_center.loc[K,"CopperGold"] + raw_center.loc[K,"Amber"] + raw_center.loc[K,"MonumentCount"])
    else:
        rec["SC3_raw_sum"] = None
    records.append(rec)

table = pd.DataFrame(records).sort_values("K_th_century_BCE").reset_index(drop=True)
table.to_csv("results/bin_table.csv", index=False)
print(f"[diag] bin table shape: {table.shape} -> results/bin_table.csv")
print(f"[diag] K values: {table['K_th_century_BCE'].tolist()}")

# ============================================================
# Step 4 — peak from *_inter SC3
# ============================================================
SC3 = table["SC3_inter_sum"]
peak_row_idx  = SC3.idxmax()        # positional index in table
peak_K        = int(table.loc[peak_row_idx, "K_th_century_BCE"])
peak_tbl      = table.loc[peak_row_idx].to_dict()
print(f"\n[PEAK] variant (i) *_inter SC3  -> K={peak_K}  "
      f"({peak_tbl['year_range']}, CE {peak_tbl['CE_range']}),  SC3={peak_tbl['SC3_inter_sum']:.4f}")

print('\n[diag] top-5 SC3 (inter sum):')
print(SC3.sort_values(ascending=False).head(5).round(4).to_string())
print('\n[diag] top-5 SC3 (raw sum, only bins with all 3 raw):')
print(table["SC3_raw_sum"].dropna().sort_values(ascending=False).head(5).round(4).to_string())

print(f'\n[diag] SC3 across OBA region (BCE 1700..900):')
for K in range(year_to_K(1700), year_to_K(900)-1, -1):
    if K in table["K_th_century_BCE"].values:
        r = table.loc[table["K_th_century_BCE"]==K].iloc[0]
        print(f"  K={K:>2d}  ({r['year_range']:<22s} CE {r['CE_range']:<14s})  "
              f"SC3i={r['SC3_inter_sum']:+.3f}  "
              f"SC3r={r['SC3_raw_sum']!s:>8s}  "
              f"CG={r['CopperGold_inter_mean']:+.2f} A={r['Amber_inter_mean']:+.2f} M={r['MonumentCount_inter_mean']:+.2f}")

K_1400 = year_to_K(1400)            # = 14
K_1300 = year_to_K(1300)            # = 13
print(f"\n[diag] tie bins: K(1400 BCE)={K_1400},  K(1300 BCE)={K_1300}")
for K in [K_1400, K_1300]:
    r = table.loc[table["K_th_century_BCE"]==K].iloc[0]
    print(f"  K={K}  year={r['year_range']}  SC3inter={r['SC3_inter_sum']:.4f}  "
          f"SC3raw={r['SC3_raw_sum']}  CG={r['CopperGold_inter_mean']:.3f} "
          f"A={r['Amber_inter_mean']:.3f}  M={r['MonumentCount_inter_mean']:.3f}  "
          f"raw @ center: CG={r['CopperGold_raw_center']} A={r['Amber_raw_center']} M={r['MonumentCount_raw_center']}")

# ============================================================
# Step 5 — which components rise into the peak
# ============================================================
def ckey(c): return f"{c}_inter_mean"
long_run_mean = table[[ckey(c) for c in z_order]].mean()
rising = []
print('\n=== Step 5: rising-component check at peak bin ===')
for c in z_order:
    series = table[ckey(c)].sort_values(ascending=False)
    top3 = list(series.index[:3])
    in_top3 = bool(peak_row_idx in top3)
    val_at_peak = float(table.loc[peak_row_idx, ckey(c)])
    above = bool(val_at_peak > long_run_mean[ckey(c)])
    rising.append(dict(
        component=c,
        value_at_peak=val_at_peak,
        long_run_mean=float(long_run_mean[ckey(c)]),
        above_long_run_mean=above,
        in_top3_of_series=in_top3,
        series_top3_K=[int(table.loc[i,"K_th_century_BCE"]) for i in top3],
        series_top3_year=[table.loc[i,"year_range"] for i in top3],
        series_rank_at_peak=int((table[ckey(c)] >= val_at_peak).sum()),
        rises_into_peak=bool(above and in_top3),
    ))
    print(f"  {c:>20s}  v={val_at_peak:+.3f}  μ={long_run_mean[ckey(c)]:+.3f}  "
          f"aboveμ={above}  top3={in_top3}  rank={rising[-1]['series_rank_at_peak']}  "
          f"RISE={above and in_top3}")

# ============================================================
# Step 6 — demographic support (±1 bin)
# ============================================================
print(f"\n=== Step 6: demographic neighborhood of peak (K={peak_K}) ===")
demog = {}
for K in [peak_K-1, peak_K, peak_K+1]:
    if K in table["K_th_century_BCE"].values:
        r = table.loc[table["K_th_century_BCE"]==K].iloc[0]
        demog[f"{K}th century BCE"] = dict(
            year_range=r["year_range"], CE_range=r["CE_range"],
            pollen_inter_100_mean=r["pollen_inter_100_mean"],
            pollen_grate_100_mean=r["pollen_grate_100_mean"],
        )
        print(f"  K={K} ({r['year_range']:<22s})  "
              f"pollen_inter_100={r['pollen_inter_100_mean']:.3f}  "
              f"pollen_grate_100={r['pollen_grate_100_mean']:.5f}")
# Also wider context (BCE 1700..900)
print("\n[diag] pollen trend around OBA region:")
for K in range(year_to_K(1700), year_to_K(900)-1, -1):
    if K in table["K_th_century_BCE"].values:
        r = table.loc[table["K_th_century_BCE"]==K].iloc[0]
        print(f"  K={K:>3d} ({r['year_range']:<22s})  "
              f"pollen_i100={r['pollen_inter_100_mean']:.3f}  "
              f"pollen_g100={r['pollen_grate_100_mean']:.5f}")

# ============================================================
# Step 7 — robustness matrix
# ============================================================
def best(s):
    s = s.dropna()
    if s.empty: return {"K": None, "label": None, "value": None, "year_range": None}
    i = s.idxmax(); v = float(s[i])
    return {"K": int(table.loc[i,"K_th_century_BCE"]),
            "label": f"{int(table.loc[i,'K_th_century_BCE'])}th century BCE",
            "year_range": table.loc[i,"year_range"],
            "CE_range":  table.loc[i,"CE_range"],
            "value": round(v, 4)}

robust = {
    "i__inter_sum3_rawZ":       best(SC3),
    "ii__inter_mean12":         best(table[[ckey(c) for c in z_order]].mean(axis=1)),
    "iii__rawZ_sum3":           best(table["SC3_raw_sum"]),
    "iv__inter_sum3_clipneg0":  best(
        table["CopperGold_inter_mean"].clip(lower=0)
        + table["Amber_inter_mean"].clip(lower=0)
        + table["MonumentCount_inter_mean"].clip(lower=0)
    ),
}
print('\n=== Step 7 robustness matrix ===')
for k,v in robust.items():
    print(f"  {k:>30s}  -> K={v['K']} ({v['label']}, {v['year_range']}, CE {v['CE_range']})  value={v['value']}")

# ============================================================
# JSON dump
# ============================================================
def j(x):
    if isinstance(x,(np.integer,)): return int(x)
    if isinstance(x,(np.floating,)): return float(x)
    if isinstance(x,(np.ndarray,)): return x.tolist()
    return x

peak = dict(peak_tbl)
peak.pop("y_lo", None)
peak["peak_K_th_century_BCE"]  = peak_K
peak["peak_century_label"]     = f"{peak_K}th century BCE"
peak["peak_year_range"]        = peak_tbl["year_range"]
peak["peak_CE_range"]          = peak_tbl["CE_range"]
peak["SC3_components_inter"]   = dict(
    CopperGold_inter=peak_tbl["CopperGold_inter_mean"],
    Amber_inter=peak_tbl["Amber_inter_mean"],
    MonumentCount_inter=peak_tbl["MonumentCount_inter_mean"],
)
peak["SC3_components_raw_center"] = dict(
    CopperGold=peak_tbl["CopperGold_raw_center"],
    Amber=peak_tbl["Amber_raw_center"],
    MonumentCount=peak_tbl["MonumentCount_raw_center"],
)

out = dict(
    schema=dict(
        K_definition="K = (y_BCE + 99)//100;  year_range = -100*K .. -100*(K-1)-1",
        n_rows_in_time_series=int(len(ts)),
        n_bins_produced=int(table.shape[0]),
        K_min=int(table["K_th_century_BCE"].min()),
        K_max=int(table["K_th_century_BCE"].max()),
        year_window=f"{abs(int(K_to_yr_range(table['K_th_century_BCE'].max())[0]))}–{abs(int(K_to_yr_range(table['K_th_century_BCE'].min())[1]))} BCE",
        nan_total_in_inter=int(ts[inter_cols].isna().sum().sum()),
        capital_vs_inter_mean_abs_diff=float(diffs/n_pairs),
    ),
    bin_records=[{k:j(v) for k,v in r.items()} for r in records],
    peak=peak,
    rising_components=rising,
    demog=demog,
    robustness_matrix=robust,
    oba_tie_resolution=dict(
        K_1400_BCE=K_1400, K_1300_BCE=K_1300,
        SC3_inter_BCE_1400=float(table.loc[table["K_th_century_BCE"]==K_1400,"SC3_inter_sum"].iloc[0]),
        SC3_inter_BCE_1300=float(table.loc[table["K_th_century_BCE"]==K_1300,"SC3_inter_sum"].iloc[0]),
        SC3_raw_BCE_1400=table.loc[table["K_th_century_BCE"]==K_1400,"SC3_raw_sum"].iloc[0],
        SC3_raw_BCE_1300=table.loc[table["K_th_century_BCE"]==K_1300,"SC3_raw_sum"].iloc[0],
    ),
)
with open("results/century_results.json","w") as f:
    json.dump(out, f, indent=2, default=j)
print('\n[diag] JSON saved -> results/century_results.json')
