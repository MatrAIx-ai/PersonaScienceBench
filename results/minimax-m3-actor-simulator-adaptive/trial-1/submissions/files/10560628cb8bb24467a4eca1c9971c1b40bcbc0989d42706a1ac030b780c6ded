"""
DiscoveryBench analysis — 'least used ML requirements-documentation format'.

Approach (approved plan):
  - Analytic sample: rows where none of the 12 main Q10_ML_Documentation_*
    columns contain a negative integer (NA sentinel).  →  n = 194.
  - Per-format indicator: 1 iff the cell value is "quoted".
  - Point estimate p̂_j = (#quoted for format j) / 194.
  - Bootstrap B = 10,000, seed = 42, row-level with-replacement resampling.
  - 95% percentile CI primary; BCa sensitivity (BCa implementation uses the
    jackknife for acceleration and the bias-correction constant from the
    bootstrap distribution).
  - Rank ascending; pairwise Δ bootstrap CIs for the three lowest ranks
    (CI excluding 0 ⇒ significant separation; no p-values, no multiple-
    comparison correction).

Outputs to stdout:
  - Ranked table (10 positive formats, descending p̂): n_quoted, p̂, percentile CI.
  - BCa CIs printed as a separate small table.
  - Pairwise Δ CIs for the three lowest-ranked formats.
  - Sensitivities (n=276 NA-treated-not-quoted; n=188 Status=Complete-only)
    printed as a small footer table.

This script deliberately performs no Wald/normal-approx CI work (per approval).
"""

import csv
import math
import numpy as np
from pathlib import Path

# ---------------------------------------------------------------- constants
DATA = Path("data/requirements_engineering_for_ML-enabled_systems.csv")
BOOTSTRAP_REPS = 10_000
SEED = 42

Q10_POSITIVE = [
    "Q10_ML_Documentation_Vision_Document",
    "Q10_ML_Documentation_Requirements_Lists",
    "Q10_ML_Documentation_Goal_Models",
    "Q10_ML_Documentation_Use_Case_Models",
    "Q10_ML_Documentation_Prototypes",
    "Q10_ML_Documentation_User_Stories",
    "Q10_ML_Documentation_BDD_Scenarios",
    "Q10_ML_Documentation_MLCanvas",
    "Q10_ML_Documentation_Notebooks",
    "Q10_ML_Documentation_Data_Models",
]
Q10_ALL_MAIN = Q10_POSITIVE + ["Q10_ML_Documentation_Not_Documented"]


# ---------------------------------------------------------------- helpers
def is_neg(s: str) -> bool:
    """Return True iff `s` is a negative integer-valued cell (NA sentinel)."""
    s = (s or "").strip()
    if s.startswith("-") and s[1:].lstrip("-").isdigit():
        try:
            return int(s) < 0
        except ValueError:
            return False
    return False


def percentile_ci(samples: np.ndarray, alpha: float = 0.05) -> tuple[float, float]:
    lo, hi = np.percentile(samples, [100 * alpha / 2, 100 * (1 - alpha / 2)])
    return float(lo), float(hi)


def bca_ci(
    samples: np.ndarray,
    point_estimate: float,
    data: np.ndarray,
    stat_fn,
    alpha: float = 0.05,
) -> tuple[float, float, float, float]:
    """BCa CI via bias-correction z0 and jackknife acceleration a.

    `samples` is the bootstrapped statistic (length B).
    `point_estimate` is the observed statistic on the full data.
    `data` is the original data (n rows) used by `stat_fn` (a 1D array).
    """
    from scipy.stats import norm  # used only here for BCa
    B_ = len(samples)
    # bias-correction constant z0
    prop_less = float(np.mean(samples < point_estimate))
    # avoid 0 / 1 → clamp
    prop_less = min(max(prop_less, 1e-12), 1 - 1e-12)
    z0 = norm.ppf(prop_less)

    # jackknife acceleration
    n = len(data)
    jk = np.empty(n)
    for i in range(n):
        leave = np.delete(data, i)
        jk[i] = stat_fn(leave)
    jk_mean = jk.mean()
    num = float(np.sum((jk_mean - jk) ** 3))
    den = 6.0 * float(np.sum((jk_mean - jk) ** 2) ** 1.5)
    a = num / den if den != 0 else 0.0

    # adjusted percentiles
    z_alpha_lo = norm.ppf(alpha / 2)
    z_alpha_hi = norm.ppf(1 - alpha / 2)

    def adj(z):
        return norm.cdf(z0 + (z + z0) / (1 - a * (z + z0)))

    p_lo = 100 * adj(z_alpha_lo)
    p_hi = 100 * adj(z_alpha_hi)
    lo = float(np.percentile(samples, p_lo))
    hi = float(np.percentile(samples, p_hi))
    return lo, hi, z0, a


# ---------------------------------------------------------------- load
with open(DATA, newline="", encoding="utf-8") as f:
    reader = csv.reader(f)
    header = next(reader)
    rows = list(reader)
n_rows = len(rows)
print(f"# Loaded {n_rows} rows × {len(header)} columns")

# Column index lookup
idx = {c: header.index(c) for c in header}

# ---------------------------------------------------------------- analytic sample (n=194)
def analytic_mask(all_target_cols):
    keep = np.ones(n_rows, dtype=bool)
    for j in range(n_rows):
        for c in all_target_cols:
            if is_neg(rows[j][idx[c]]):
                keep[j] = False
                break
    return keep

mask_194 = analytic_mask(Q10_POSITIVE + ["Q10_ML_Documentation_Not_Documented"])
n194 = int(mask_194.sum())
print(f"# Analytic sample (n_analytic = {n194})")

# Per-format indicators within n=194
indicators = {}
for c in Q10_POSITIVE:
    arr = np.array(
        [1.0 if (mask_194[j] and rows[j][idx[c]].strip() == "quoted") else 0.0
         for j in range(n_rows)]
    )
    # restrict to analytic rows only for cleaner downstream code
    indicators[c] = arr[mask_194]

# point estimates
p_hat = {c: float(indicators[c].mean() * 100.0) for c in Q10_POSITIVE}

# ---------------------------------------------------------------- bootstrap
rng = np.random.default_rng(SEED)
n_b = n194
boot = {c: np.empty(BOOTSTRAP_REPS) for c in Q10_POSITIVE}
for b in range(BOOTSTRAP_REPS):
    take = rng.integers(0, n_b, size=n_b)
    for c in Q10_POSITIVE:
        boot[c][b] = indicators[c][take].mean() * 100.0

# percentile CIs
pct_ci = {c: percentile_ci(boot[c]) for c in Q10_POSITIVE}

# BCa CIs (use scipy only here)
bca_ci_d = {}
try:
    for c in Q10_POSITIVE:
        stat_fn = lambda x, c=c: float(x.mean() * 100.0)
        lo, hi, z0, a = bca_ci(boot[c], p_hat[c], indicators[c], stat_fn)
        bca_ci_d[c] = {
            "lo": lo, "hi": hi, "z0": z0, "a": a
        }
    has_bca = True
except Exception as e:
    print(f"# BCa computation failed: {e}")
    has_bca = False

# ---------------------------------------------------------------- ranked table
ranked = sorted(Q10_POSITIVE, key=lambda c: p_hat[c])
print("\n# Ranked table (n_analytic = 194) — positive documentation formats, ascending by p̂")
print(f"{'rank':>4}  {'format':55s}  {'n_quoted':>8}  {'p̂ %':>8}  {'percentile 95% CI':>22}  {'width':>6}")
for r, c in enumerate(ranked, start=1):
    lo, hi = pct_ci[c]
    print(f"  {r:>2}  {c:55s}  {int(indicators[c].sum()):>8d}  {p_hat[c]:>8.4f}  [{lo:>6.4f}, {hi:>6.4f}]  {hi-lo:>6.4f}")

if has_bca:
    print("\n# BCa 95% CIs (sensitivity)")
    print(f"{'format':55s}  {'percentile CI':>26}  {'BCa CI':>26}  {'BCa width':>10}")
    for c in ranked:
        plo, phi = pct_ci[c]
        blo = bca_ci_d[c]["lo"]
        bhi = bca_ci_d[c]["hi"]
        print(f"  {c:55s}  [{plo:>6.4f}, {phi:>6.4f}]  [{blo:>6.4f}, {bhi:>6.4f}]  {bhi-blo:>10.4f}")

# ---------------------------------------------------------------- pairwise Δ CIs (bottom three)
bottom3 = ranked[:3]
print("\n# Pairwise bootstrap Δ = p̂_A − p̂_B; row-level paired resampling")
print("# Pairs of interest: A,B ∈ bottom-3, A < B (more negative ⇒ A more depleted)")
pairs = [(bottom3[i], bottom3[j]) for i in range(len(bottom3)) for j in range(i + 1, len(bottom3))]
print(f"{'A (lower)':55s}  {'B (higher)':55s}  {'Δ̂':>10}  {'Δ 95% CI (percentile)':>26}  {'excl. 0?':>9}")
deltas = {}
rng2 = np.random.default_rng(SEED + 1)
for A, Bname in pairs:
    delta_boot = np.empty(BOOTSTRAP_REPS)
    n_ = n194
    for bi in range(BOOTSTRAP_REPS):
        take = rng2.integers(0, n_, size=n_)
        delta_boot[bi] = (indicators[A][take].mean() - indicators[Bname][take].mean()) * 100.0
    lo, hi = percentile_ci(delta_boot)
    excl = "YES" if (lo > 0 or hi < 0) else "no"
    delta_hat = p_hat[A] - p_hat[Bname]
    deltas[(A, Bname)] = (delta_hat, lo, hi, excl)
    print(f"  {A:55s}  {Bname:55s}  {delta_hat:>10.4f}  [{lo:>6.4f}, {hi:>6.4f}]  {excl:>9}")

# ---------------------------------------------------------------- sensitivity A: n=276 (NA treated as "not quoted")
print("\n# Sensitivity: n=276 (NA rows retained, NA counted as 'not quoted')")
indicators_276 = {}
for c in Q10_POSITIVE:
    indicators_276[c] = np.array(
        [1.0 if rows[j][idx[c]].strip() == "quoted" else 0.0
         for j in range(n_rows)]
    )
    # but exclude negative cells explicitly (treat negative as 0 instead of NA)
p_hat_276 = {c: float(indicators_276[c].mean() * 100.0) for c in Q10_POSITIVE}
ranked_276 = sorted(Q10_POSITIVE, key=lambda c: p_hat_276[c])
print(f"{'rank':>4}  {'format':55s}  {'n_quoted':>8}  {'p̂ % (n=276)':>12}")
for r, c in enumerate(ranked_276, start=1):
    print(f"  {r:>2}  {c:55s}  {int(indicators_276[c].sum()):>8d}  {p_hat_276[c]:>12.4f}")

# ---------------------------------------------------------------- sensitivity B: n=188 (Status=Completed, Q10-valid)
print("\n# Sensitivity: n=188 (Status ∈ {Completed, Completed-after-break}, Q10-valid)")
status_idx = idx["Status"]
mask_completed = mask_194 & np.array([
    rows[j][status_idx].startswith("Completed") for j in range(n_rows)
])
n_completed = int(mask_completed.sum())
print(f"# n_Completed_status_valid = {n_completed}")
indicators_188 = {c: indicators[c][mask_completed[mask_194]] for c in Q10_POSITIVE}
p_hat_188 = {c: float(indicators_188[c].mean() * 100.0) for c in Q10_POSITIVE}
ranked_188 = sorted(Q10_POSITIVE, key=lambda c: p_hat_188[c])
print(f"{'rank':>4}  {'format':55s}  {'n_quoted':>8}  {'p̂ % (n=188)':>12}")
for r, c in enumerate(ranked_188, start=1):
    print(f"  {r:>2}  {c:55s}  {int(indicators_188[c].sum()):>8d}  {p_hat_188[c]:>12.4f}")

# ---------------------------------------------------------------- target-fit audit
print("\n# Target-fit audit")
print("# Targets from brief: 10.13% [9.926, 10.333] and 4.366% [4.231, 4.501].")
print("# Width 0.407 pp ⇒ implied n_eff ≈ 1.96² · p̂(1-p̂)/w² ≈ 1.96² · 0.091/0.00407² ≈ 21,000.")
print("# Width 0.270 pp ⇒ implied n_eff ≈ 1.96² · 0.0417/0.00270² ≈ 22,000.")
print("# The supplied dataset (194 / 276 rows) cannot yield CIs this narrow — flagged.")

# Also print the bottom-two for explicit reference
print("\n# Final primary call (n=194, percentile CI):")
bot1, bot2 = ranked[0], ranked[1]
print(f"# Least used:     {bot1}     → p̂ = {p_hat[bot1]:.4f}%, CI = {pct_ci[bot1]}")
print(f"# 2nd-least used: {bot2}     → p̂ = {p_hat[bot2]:.4f}%, CI = {pct_ci[bot2]}")
