"""DiscoveryBench meta-regression replication analysis.

Operational definition (approved):
  PRIMARY   = mean of paired Fisher-z difference  (fiso - fisr)
  COMPANION = P(fiso > fisr)  (sign-flip robust)
  SECONDARY = mean ratio fisr/fiso  (with sign-flip caveat; 18/86 flip)

Inferential layer: descriptive + 95% percentile bootstrap CI on
mean(fiso - fisr); resample studies within each domain; n_boot = 1000;
random_state = 42.
"""
import sys, os, json
sys.path.insert(0, os.path.dirname(__file__))
import numpy as np
import pandas as pd
from minipng import Canvas

RNG_SEED = 42
N_BOOT = 1000

DATA = "data/meta-regression_joined_data_heterogeneity_in_replication_projects.csv"
df = pd.read_csv(DATA)
print(f"Loaded {df.shape[0]} rows x {df.shape[1]} cols from {DATA}\n")

N_SIGN_FLIPS = int(((df["ro"] > 0) & (df["rr"] < 0)).sum())

def per_domain_summary(frame):
    rows = []
    for key, sub in frame.groupby("__domain__", dropna=False):
        n = len(sub)
        fiso = sub["fiso"].to_numpy()
        fisr = sub["fisr"].to_numpy()
        diff = fiso - fisr
        rng = np.random.default_rng(RNG_SEED)
        idx = np.arange(n)
        boot_means = np.empty(N_BOOT)
        for b in range(N_BOOT):
            s = rng.choice(idx, size=n, replace=True)
            boot_means[b] = diff[s].mean()
        ci_lo, ci_hi = np.percentile(boot_means, [2.5, 97.5])
        ratio = fisr / fiso
        rows.append({
            "domain": key, "n": n,
            "mean(fiso)": float(np.mean(fiso)), "median(fiso)": float(np.median(fiso)),
            "mean(fisr)": float(np.mean(fisr)), "median(fisr)": float(np.median(fisr)),
            "mean(fiso-fisr)": float(np.mean(diff)),
            "CI_lo": float(ci_lo), "CI_hi": float(ci_hi),
            "median(fiso-fisr)": float(np.median(diff)),
            "sd(diff)": float(np.std(diff, ddof=1)),
            "IQR_lo": float(np.percentile(diff, 25)),
            "IQR_hi": float(np.percentile(diff, 75)),
            "P(fiso>fisr)": float(np.mean(diff > 0)),
            "mean_ratio*": float(np.mean(ratio)),
        })
    return pd.DataFrame(rows).sort_values("domain").reset_index(drop=True)

specs = [
    ("discipline", df.assign(__domain__=df["discipline"])),
    ("project.x", df.assign(__domain__=df["project.x"])),
    ("discipline_x_project.x",
        df.assign(__domain__=df["discipline"].fillna("NA")+" | "+df["project.x"].fillna("NA"))),
    ("journal", df.assign(__domain__=df["journal"])),
]
summaries = {n: per_domain_summary(f) for n, f in specs}

print("="*100)
print("SUMMARY TABLES (A)")
print("="*100)
for name, tab in summaries.items():
    print(f"\n--- Grouping: {name} ---")
    cols = ["domain","n","mean(fiso)","median(fiso)","mean(fisr)","median(fisr)",
            "mean(fiso-fisr)","CI_lo","CI_hi","median(fiso-fisr)","sd(diff)",
            "IQR_lo","IQR_hi","P(fiso>fisr)","mean_ratio*"]
    pretty = tab[cols].copy()
    for c in pretty.columns:
        if c not in ("domain","n"):
            pretty[c] = pretty[c].round(4)
    print(pretty.to_string(index=False))
    print("* mean_ratio = mean(fisr/fiso). SIGNED raw ratio; negative for the "
          f"{N_SIGN_FLIPS}/{len(df)} cases where fisr flipped sign while fiso stayed positive.")

with open("artifacts/analysis/summary_tables.json","w") as f:
    json.dump({k:v.to_dict(orient="records") for k,v in summaries.items()}, f, indent=2)
print("\nSaved artifacts/analysis/summary_tables.json")

# ===== PLOT B: Cleveland dot plot - per-discipline mean fiso vs mean fisr =====
disc = summaries["discipline"].sort_values("mean(fiso-fisr)").reset_index(drop=True)

W, H = 880, 360
canvas = Canvas(W, H, bg=(255,255,255))
LEFT, RIGHT = 110, W-30
TOP, BOT = 50, H-50

canvas.text(20, 12, "PER-DISCIPLINE MEAN EFFECT SIZE: ORIGINAL VS REPLICATION", c=(0,0,0))
canvas.text(20, 26, "Grey line = attenuation per discipline   |   D = mean(fiso - fisr)", c=(110,110,110))

ys = {}
for i, (_, row) in enumerate(disc.iterrows()):
    ys[row["domain"]] = int(TOP + (i+0.5)*(BOT-TOP)/len(disc))

xlo = -0.05
xhi = float(disc["mean(fiso)"].max())*1.10 + 0.10
def x_to_px(x):
    return LEFT + (x - xlo)/(xhi - xlo) * (RIGHT - LEFT)

zero_x = x_to_px(0)
canvas.thick_line(zero_x, TOP, zero_x, BOT, c=(220,220,220), t=1)

xticks = np.linspace(0, xhi, 6)
for x in xticks:
    px = x_to_px(x)
    canvas.line(px, BOT, px, BOT+6, c=(80,80,80))
    s = f"{x:.2f}"
    canvas.text(px - canvas.text_width(s)//2, BOT+10, s, c=(60,60,60))

canvas.thick_line(LEFT, BOT, RIGHT, BOT, c=(80,80,80), t=1)
canvas.thick_line(LEFT, TOP, LEFT, BOT, c=(80,80,80), t=1)

COL_ISO   = (31,119,180)
COL_REP   = (214,39,40)
COL_LINE  = (120,120,120)

for _, row in disc.iterrows():
    d = row["domain"]; y = ys[d]
    canvas.text(10, y-3, d, c=(0,0,0))
    canvas.line(LEFT, y, RIGHT, y, c=(235,235,235))
    px_r = x_to_px(row["mean(fisr)"])
    px_o = x_to_px(row["mean(fiso)"])
    canvas.thick_line(px_r, y, px_o, y, c=COL_LINE, t=2)
    canvas.circle(px_r, y, 7, c=COL_REP, fill=True)
    canvas.circle(px_r, y, 7, c=(0,0,0), fill=False)
    canvas.circle(px_o, y, 7, c=COL_ISO, fill=True)
    canvas.circle(px_o, y, 7, c=(0,0,0), fill=False)
    px_ann = max(px_r, px_o) + 14
    s = f"D={row['mean(fiso-fisr)']:+.3f}"
    canvas.text(px_ann, y-3, s, c=(0,0,0))

canvas.text(LEFT + (RIGHT-LEFT)//2 - 80, BOT+28,
            "Mean effect size (Fisher-z scale)", c=(0,0,0))

lgx, lgy = RIGHT-220, TOP+5
canvas.filled_rect(lgx-6, lgy-6, lgx+220, lgy+38, (250,250,250))
canvas.thick_line(lgx-6, lgy-6, lgx+220, lgy-6, c=(0,0,0), t=1)
canvas.thick_line(lgx-6, lgy+38, lgx+220, lgy+38, c=(0,0,0), t=1)
canvas.thick_line(lgx-6, lgy-6, lgx-6, lgy+38, c=(0,0,0), t=1)
canvas.thick_line(lgx+220, lgy-6, lgx+220, lgy+38, c=(0,0,0), t=1)
canvas.circle(lgx+8, lgy+10, 6, c=COL_REP, fill=True)
canvas.text(lgx+22, lgy+6,  "REPLICATION (mean fisr)", c=(0,0,0))
canvas.circle(lgx+8, lgy+26, 6, c=COL_ISO, fill=True)
canvas.text(lgx+22, lgy+22, "ORIGINAL (mean fiso)",    c=(0,0,0))

canvas.text(zero_x - canvas.text_width("0")//2, TOP-12, "0", c=(120,120,120))

canvas.save_png("artifacts/plots/cleveland_dot.png")
print("\nSaved artifacts/plots/cleveland_dot.png")

# ===== PLOT C: Paired strip / dot plot per discipline =====
disc_order = sorted(disc["domain"].tolist())
PW, PH = 1280, 420
canvas = Canvas(PW, PH, bg=(255,255,255))

canvas.text(20, 12, "PAIRED EFFECT SIZES BY DISCIPLINE: (fiso, fisr) PER STUDY", c=(0,0,0))
canvas.text(20, 26, "Each study is a thin line linking its original (left) and replication (right) value", c=(110,110,110))
canvas.text(20, 40, "Blue = iso>rep, Red = iso<=rep   |   black diamonds = discipline means connected by dashed line", c=(110,110,110))

ylo, yhi = -0.55, 1.45
panel_w = (PW - 90) // 3
T = 60; B = PH-50

def plot_panel(canvas, pidx, discipline):
    L = 80 + pidx*panel_w
    R = L + panel_w - 30
    sub = df[df["discipline"]==discipline].sort_values("fiso").reset_index(drop=True)
    n = len(sub)
    canvas.text(L, 60, f"{discipline.upper()}  (n={n})", c=(0,0,0))
    canvas.thick_line(L, T, L, B, c=(80,80,80), t=1)
    canvas.thick_line(L, B, R, B, c=(80,80,80), t=1)
    yticks = np.linspace(ylo, yhi, 7)
    for yv in yticks:
        py = B - (yv - ylo)/(yhi - ylo)*(B-T)
        canvas.line(L-4, py, L, py, c=(80,80,80))
        s = f"{yv:.2f}"
        canvas.text(L - canvas.text_width(s) - 8, py-3, s, c=(60,60,60))
        canvas.line(L, py, R, py, c=(235,235,235))
    canvas.text(L + 12, B+8, "ORIGINAL  fiso", c=(0,0,0))
    canvas.text(R - 90, B+8, "REPLICATION  fisr", c=(0,0,0))
    canvas.text(L + panel_w//2 - 80, B+24, "<--------- STUDY (paired) --------->", c=(120,120,120))
    for i, row in sub.iterrows():
        x0 = L + 30; x1 = R - 30
        y0 = B - (row["fiso"] - ylo)/(yhi - ylo)*(B-T)
        y1 = B - (row["fisr"] - ylo)/(yhi - ylo)*(B-T)
        col = (90,140,200) if row["fiso"] > row["fisr"] else (220,90,90)
        canvas.line(x0, y0, x1, y1, c=col)
    mf = sub["fiso"].mean(); mr = sub["fisr"].mean()
    mfy = B - (mf - ylo)/(yhi - ylo)*(B-T)
    mry = B - (mr - ylo)/(yhi - ylo)*(B-T)
    canvas.thick_line(L + 30, mfy, R - 30, mry, c=(0,0,0), t=1)
    canvas.filled_rect(L + 24, mfy-4, L + 36, mfy+4, (0,0,0))
    canvas.filled_rect(R - 36, mry-4, R - 24, mry+4, (0,0,0))
    p_iso = float((sub['fiso']>sub['fisr']).mean())
    ann = f"mean D = {mf-mr:+.3f}   P(iso>rep) = {p_iso:.2f}"
    canvas.text(L + 6, T + 24, ann, c=(0,0,0))

for i, d in enumerate(disc_order):
    plot_panel(canvas, i, d)

# y-axis title (rotated 90 deg by writing it vertically, letter by letter)
yt_label = "FISHER-z"
lyx = 16
for j, ch in enumerate(yt_label):
    canvas.text(lyx, (T+B)//2 - 30 + j*8, ch, c=(0,0,0))

canvas.save_png("artifacts/plots/paired_strip.png")
print("Saved artifacts/plots/paired_strip.png")

# ===== (D) Per-discipline one-line finding =====
print("\n" + "="*100)
print("PER-DISCIPLINE ONE-LINE FINDINGS (D)")
print("="*100)
ranked = disc.sort_values("mean(fiso-fisr)", ascending=False).reset_index(drop=True)
for _, r in ranked.iterrows():
    if r["CI_lo"] > 0:
        note = "(positive D; CI entirely above zero)"
    elif r["CI_hi"] < 0:
        note = "(negative D; CI entirely below zero)"
    else:
        note = "(CI crosses zero)"
    print(f"  {r['domain']:<10s}  n={int(r['n']):>3d}  mean(fiso-fisr)={r['mean(fiso-fisr)']:+.4f}  "
          f"95% bootstrap CI [{r['CI_lo']:+.4f}, {r['CI_hi']:+.4f}]  "
          f"P(fiso>fisr)={r['P(fiso>fisr)']:.2f}  --> {note}")

# ===== (E) Final ranking and hypothesis =====
top = ranked.iloc[0]
sec = ranked.iloc[1]
last = ranked.iloc[-1]

print("\n" + "="*100)
print("RANKING (mean fiso-fisr, descending)")
print("="*100)
for i, r in ranked.iterrows():
    print(f"  rank {i+1}: {r['domain']:<10s}  mean(fiso-fisr) = {r['mean(fiso-fisr)']:+.4f}  "
          f"P(fiso>fisr) = {r['P(fiso>fisr)']:.2f}  95% CI [{r['CI_lo']:+.4f}, {r['CI_hi']:+.4f}]")

hyp = (
    f"Original effect size estimates tend to be larger than replication effect estimates "
    f"in {top['domain']}, as evidenced by a positive mean paired difference of "
    f"{top['mean(fiso-fisr)']:+.4f} on the Fisher-z scale across N={int(top['n'])} studies "
    f"(95% bootstrap CI [{top['CI_lo']:+.4f}, {top['CI_hi']:+.4f}], 1000 resamples) "
    f"and a P(fiso > fisr) of {top['P(fiso>fisr)']:.2f}; in contrast, "
    f"{sec['domain']} shows a smaller mean paired difference of {sec['mean(fiso-fisr)']:+.4f} "
    f"(95% bootstrap CI [{sec['CI_lo']:+.4f}, {sec['CI_hi']:+.4f}]) "
    f"with P(fiso > fisr) of {sec['P(fiso>fisr)']:.2f}, and {last['domain']} lies in between "
    f"with mean paired difference {last['mean(fiso-fisr)']:+.4f} "
    f"(95% bootstrap CI [{last['CI_lo']:+.4f}, {last['CI_hi']:+.4f}]) "
    f"and P(fiso > fisr) of {last['P(fiso>fisr)']:.2f}."
)
print("\n" + "="*100)
print("FINAL NATURAL-LANGUAGE HYPOTHESIS (E)")
print("="*100)
print(hyp)
print()
print(f"Most pronounced original-over-replication shift: {top['domain']}.")
print("Operational definition that drove that call: mean paired difference on the Fisher-z scale")
print("(mean(fiso - fisr) per domain), corroborated by the companion statistic P(fiso > fisr).")

with open("artifacts/analysis/hypothesis.txt", "w") as f:
    f.write(hyp + "\n\n")
    f.write(f"Most pronounced original-over-replication shift: {top['domain']}.\n")
    f.write("Operational definition that drove that call: mean paired difference on the Fisher-z scale\n")
    f.write("(mean(fiso - fisr) per domain), corroborated by the companion statistic P(fiso > fisr).\n")
print("\nSaved artifacts/analysis/hypothesis.txt")

# ===== (F) Limitations =====
print("\n" + "="*100)
print("LIMITATIONS (F)")
print("="*100)
n_eco = int(summaries["discipline"].set_index("domain").loc["Economics","n"])
n_qje = int(summaries["journal"].set_index("domain").loc["The Quarterly Journal of Economics","n"])
print(
    f"- Small per-domain n; Economics has only n={n_eco} studies and QJE has only n={n_qje} studies -- "
    "per-domain bootstrap CIs should be read as descriptive, not as precise inferential intervals.\n"
    f"- Sign-flip cases: {N_SIGN_FLIPS} of {len(df)} replication effect sizes flip direction relative "
    "to the original (rr<0 while ro>0). Any signed-ratio view (mean fisr/fiso) is therefore distorted; "
    "the primary metric used here, mean(fiso - fisr), is not affected, and the companion P(fiso > fisr) "
    "is sign-flip robust.\n"
    "- discipline and project.x encode the same partition in this dataset "
    "(Psychology = Cognitive U Social; Experimental Economics = Economics), so the discipline-level "
    "finding is also the project-level finding; they are not independent pieces of evidence."
)

print("\nAll artifacts written under /workspace/artifacts/")
