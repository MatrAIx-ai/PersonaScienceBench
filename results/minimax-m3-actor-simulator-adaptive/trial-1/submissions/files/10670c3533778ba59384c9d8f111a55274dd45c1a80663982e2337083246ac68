"""
DiscoveryBench — meta-regression heterogeneity in replication projects.
Question: in which domain (discipline OR replication-project) did both original
and replication studies primarily use student subjects (target ~82.4% / ~80.9%)?

df1 only. Operationalization (A) is primary; (E) is a robustness check on a
different reading. Two exclusions as additional robustness sanity checks.
"""
import json, os, pandas as pd, numpy as np

p = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
df1 = pd.read_csv(p)

T_O, T_R = 82.4, 80.9
out = {}

# ---------------------------------------------------------------------------
# (A) Per-group marginal student-subject shares
# ---------------------------------------------------------------------------
def per_group_table(frame):
    rows = []
    order = [("discipline", v) for v in ["Social", "Cognitive", "Economics"]] + \
            [("project",    v) for v in ["ml1", "ml3", "rpp", "ee"]] + \
            [("ALL", None)]
    for grp_name, val in order:
        sub = frame if val is None else frame[frame[grp_name] == val]
        n  = len(sub)
        pO = (sub["subjects.o"] == "students").mean() * 100
        pR = (sub["subjects.r"] == "students").mean() * 100
        L1 = abs(pO - T_O) + abs(pR - T_R)
        rows.append({
            "grouping": grp_name,
            "value":    val if val is not None else "df1 overall",
            "n":        n,
            "pct_O_students": round(pO, 2),
            "pct_R_students": round(pR, 2),
            "abs_dev_O":      round(abs(pO - T_O), 2),
            "abs_dev_R":      round(abs(pR - T_R), 2),
            "L1_to_82.4_80.9": round(L1, 2),
        })
    res = pd.DataFrame(rows).sort_values("L1_to_82.4_80.9").reset_index(drop=True)
    return res

table_A = per_group_table(df1)
out["table_A_marginal_share"] = table_A.to_dict(orient="records")
print("=== (A) Marginal student-subject share, ranked by L1 to targets ===")
print(table_A.to_string(index=False))

# ---------------------------------------------------------------------------
# (E) P(both students) by discipline — robustness on a different reading
# ---------------------------------------------------------------------------
def both_students(frame):
    mask = (frame["subjects.o"] == "students") & (frame["subjects.r"] == "students")
    both = frame.assign(_both=mask)
    rows = []
    for disc in ["Social", "Cognitive", "Economics"]:
        sub = both[both["discipline"] == disc]
        rows.append({"discipline": disc, "n": len(sub),
                     "pct_both_students": round(sub["_both"].mean()*100, 2)})
    rows.append({"discipline": "df1 OVERALL", "n": len(both),
                 "pct_both_students": round(both["_both"].mean()*100, 2)})
    return pd.DataFrame(rows)

table_E = both_students(df1)
out["table_E_joint_share"] = table_E.to_dict(orient="records")
print("\n=== (E) Joint share P(O students AND R students), by discipline ===")
print(table_E.to_string(index=False))

# ---------------------------------------------------------------------------
# Sanity (i): drop the single row with NaN in subjects.o / subjects.r
# ---------------------------------------------------------------------------
nan_mask = df1["subjects.o"].isna() | df1["subjects.r"].isna()
n_nan = int(nan_mask.sum())
df_clean = df1.loc[~nan_mask].copy()

def social_block(frame, tag):
    sub = frame[frame["discipline"] == "Social"]
    return {
        "tag":   tag,
        "n":     int(len(sub)),
        "pct_O_students": round((sub["subjects.o"] == "students").mean()*100, 2),
        "pct_R_students": round((sub["subjects.r"] == "students").mean()*100, 2),
        "n_dropped_from_df1": int(len(df1) - len(frame)),
    }

sanity = []
sanity.append(social_block(df1,     "as-loaded (NaN counted as missing in mean)"))
sanity.append(social_block(df_clean,"after dropping the 1 NaN row"))
print("\n=== Sanity (i): Social block before vs after NaN drop ===")
for s in sanity:
    print(s)

# ---------------------------------------------------------------------------
# Sanity (ii): exclude rows where `aggregated` is non-null
# ---------------------------------------------------------------------------
agg_non_null = df1["aggregated"].notna()
n_agg_excl  = int(agg_non_null.sum())
df_no_agg   = df1.loc[~agg_non_null].copy()

print(f"\nRows with aggregated non-null in df1: {n_agg_excl} "
      f"(True={int((df1['aggregated']==True).sum())}, "
      f"False={int((df1['aggregated']==False).sum())})")
print(f"Remaining after exclusion: {len(df_no_agg)}")

sanity.append(social_block(df_no_agg,
                           "after dropping rows with aggregated non-null"))
print("\n=== Sanity (ii): Social block after excluding aggregated!=NaN ===")
print(sanity[-1])

# Distribution of disciplines after exclusion (does Social still dominate?)
print("\nDiscipline distribution after excluding aggregated!=NaN:")
print(df_no_agg["discipline"].value_counts(dropna=False).to_string())

# Project distribution after exclusion (sanity)
print("\nProject distribution after excluding aggregated!=NaN:")
print(df_no_agg["project"].value_counts(dropna=False).to_string())

out["sanity_checks"] = sanity
out["n_dropped_nan"]    = n_nan
out["n_dropped_aggregated_non_null"] = n_agg_excl

# ---------------------------------------------------------------------------
# Save evidence
# ---------------------------------------------------------------------------
with open("artifacts/analysis_table_A.json", "w") as f:
    json.dump(out["table_A_marginal_share"], f, indent=2)
with open("artifacts/analysis_table_E.json", "w") as f:
    json.dump(out["table_E_joint_share"], f, indent=2)
with open("artifacts/analysis_sanity.json", "w") as f:
    json.dump({"n_dropped_nan": n_nan,
               "n_dropped_aggregated_non_null": n_agg_excl,
               "sanity_checks": sanity}, f, indent=2)

# Also save the executed script as the canonical artifact
import shutil
shutil.copyfile("analysis.py", "artifacts/analysis.py")
print("\nArtifacts written to artifacts/")
