"""
PCA on forms-of-capital in 100-year time slices.
(Executed; numpy-only because scikit-learn is unavailable.)

Input   : data/capital.csv
          39 century bins (BCE 4300 -> BCE 500, step -100), each with 12
          z-score indicators of archaeological "forms of capital".
Question: how are ZAxtSchwert (Hatchets & Swords), ZDolch (Daggers),
          Zhausgr (House Size) characterized on PC1 and along PC2?
Method  : ONE PCA on the 39x12 standardized matrix (correlation-equivalent)
          via numpy SVD (equivalent to sklearn PCA on centered data).
          Sign convention:
              PC1 sign = sign of loading on ZKeform (Pottery Form)
              PC2 sign = sign of variable with the largest |loading| on PC2.
          Reports: full 12x12 loadings, explained-variance ratios,
          per-bin PC1/PC2 scores, focused row-table for the 3 symbolic
          variables, and the PC2-score distribution across 39 bins.
"""
import json
from pathlib import Path
import numpy as np
import pandas as pd

ROOT  = Path(".")
DATA  = ROOT / "data" / "capital.csv"
ART_D = ROOT / "artifacts" / "data"
ART_D.mkdir(parents=True, exist_ok=True)

# ---------- 1. Load + parse comma-decimals --------------------------------
raw = pd.read_csv(DATA)
zcols = [c for c in raw.columns if c.startswith("Z")]
for c in zcols:
    raw[c] = raw[c].astype(str).str.replace(",", ".").astype(float)
raw = raw.sort_values("BCE").reset_index(drop=True)

X = raw[zcols].to_numpy()                          # (39, 12)
print(f"X shape        : {X.shape}")
print(f"BCE span       : {raw['BCE'].min()} .. {raw['BCE'].max()}"
      f"   n_bins = {len(raw)}   step = {int(np.median(np.diff(raw['BCE'])))}")

# ---------- 2. Verify (already) standardized, then re-center to machine eps
mu = X.mean(axis=0); sd = X.std(axis=0, ddof=0)
print("\nRaw standardized check (mean / std; should both be ~0 / ~1):")
for c, m, s in zip(zcols, mu, sd):
    print(f"  {c:<14s} mean={m:+.4f}  std={s:.4f}")
Xz = (X - X.mean(axis=0)) / X.std(axis=0, ddof=0)   # exact standardization

# ---------- 3. PCA via SVD on centered data -------------------------------
# Xz = U S V^T  =>  scores = U * S   (n, k),   loadings = V  (p, k)
U, S, Vt = np.linalg.svd(Xz, full_matrices=False)
scores    = U * S                                    # (39, 12)
loadings  = Vt.T                                     # (12, 12)
# sklearn convention: components_ * sqrt(n-1) = eigenvectors of cov; here
# we report *unit-length* loadings (cosine of variable vs. PC) which is what
# `pca.components_` returns and what is conventionally called "loadings" in
# archaeology papers. Re-normalize loadings to unit length and scale scores
# accordingly so explained variance is preserved and loadings are the cosine.
norms    = np.linalg.norm(loadings, axis=0, keepdims=True)
loadings = loadings / norms                         # unit-length eigenvectors
# Recompute scores so that loadings^T @ scores / n-1 = covariance diag = eigval
eigvals  = (S ** 2) / (Xz.shape[0] - 1)             # length 12
explained = eigvals / eigvals.sum()

print("\nExplained variance (per PC, cumulative):")
for i in range(12):
    print(f"  PC{i+1:>2d} : {explained[i]*100:6.2f}%   "
          f"cum={explained[:i+1].sum()*100:6.2f}%   "
          f"eigval={eigvals[i]:.4f}")

# ---------- 4. Sign-alignment convention -----------------------------------
idx_keform   = zcols.index("ZKeform")
s1_candidate = loadings[idx_keform, 0]
s1 = np.sign(s1_candidate) if s1_candidate != 0 else +1.0
abs_pc2       = np.abs(loadings[:, 1])
j_pc2_max     = int(np.argmax(abs_pc2))
s2_candidate  = loadings[j_pc2_max, 1]
s2 = np.sign(s2_candidate) if s2_candidate != 0 else +1.0
print(f"\nSign alignment: "
      f"PC1 sign={s1:+.0f} (ZKeform PC1 lin = {s1_candidate:+.4f}),  "
      f"PC2 sign={s2:+.0f} (dominant |load| on PC2 = {zcols[j_pc2_max]} "
      f"with {loadings[j_pc2_max, 1]*s2:+.4f} post-align)")

flipped = []
for k in range(12):
    sk = s1 if k == 0 else (s2 if k == 1 else +1.0)
    if sk < 0:
        loadings[:, k] = -loadings[:, k]
        scores[:, k]   = -scores[:, k]
        flipped.append(k + 1)
print("Components flipped to align: ", flipped if flipped else "none")

# Contribution share of each variable to PCk = loading^2 / sum(loading^2)
share = (loadings ** 2)
share_pc1 = share[:, 0] / share[:, 0].sum()
share_pc2 = share[:, 1] / share[:, 1].sum()

# ---------- 5. Full 12x12 loadings artifact --------------------------------
load_df = pd.DataFrame(loadings.round(4), index=zcols,
                       columns=[f"PC{i+1}" for i in range(12)])
load_df["share_PC1"] = share_pc1.round(4)
load_df["share_PC2"] = share_pc2.round(4)
load_df.to_csv(ART_D / "pca_loadings_12x12.csv", index_label="variable")
print("\nFull 12x12 loadings (PC1..PC12) + contribution shares on PC1/PC2:")
with pd.option_context("display.width", 200, "display.max_columns", 20):
    print(load_df.to_string())

# ---------- 6. Per-bin PC1 / PC2 scores ------------------------------------
scores_df = pd.DataFrame({
    "BCE":   raw["BCE"].astype(int),
    "group": raw["group"].astype(str),
})
for k in range(12):
    scores_df[f"PC{k+1}"] = scores[:, k].round(4)
scores_df.to_csv(ART_D / "pca_scores_39bins.csv", index=False)
print("\nPer-bin PC1 / PC2 scores (chronological, BCE descending):")
with pd.option_context("display.width", 160):
    print(scores_df[["BCE", "group", "PC1", "PC2"]].to_string(index=False))

# ---------- 7. Focused symbolic-on-PC1 / PC2 row table ----------------------
sym = ["Zhausgr", "ZDolch", "ZAxtSchwert"]
sym_long = {"Zhausgr":"House size (m^2)",
            "ZDolch": "Daggers",
            "ZAxtSchwert":"Hatchets & Swords"}
focus = pd.DataFrame({
    "indicator":    [sym_long[v] for v in sym],
    "short_var":    sym,
    "PC1_loading":  [load_df.loc[v, "PC1"]   for v in sym],
    "PC1_share":    [load_df.loc[v, "share_PC1"] for v in sym],
    "PC2_loading":  [load_df.loc[v, "PC2"]   for v in sym],
    "PC2_share":    [load_df.loc[v, "share_PC2"] for v in sym],
}).round(4)
focus.to_csv(ART_D / "symbolic_on_PC1_PC2.csv", index=False)
print("\nFocused table for symbolic-capital indicators on PC1 / PC2:")
print(focus.to_string(index=False))

# ---------- 8. PC2 score distribution across the 39 bins -------------------
pc2 = scores[:, 1]
pc2_min, pc2_max = float(pc2.min()), float(pc2.max())
pc2_med          = float(np.median(pc2))
pc2_q1, pc2_q3   = float(np.percentile(pc2, 25)), float(np.percentile(pc2, 75))
pc2_iqr          = pc2_q3 - pc2_q1
frac_pos         = float((pc2 > 0).mean())
print("\nPC2-score distribution across 39 century bins:")
print(f"  min={pc2_min:+.4f}   max={pc2_max:+.4f}   range={pc2_max - pc2_min:.4f}")
print(f"  median={pc2_med:+.4f}   IQR=[Q1={pc2_q1:+.4f}, Q3={pc2_q3:+.4f}]  (IQR={pc2_iqr:.4f})")
print(f"  frac_bins_PC2>0 = {frac_pos:.3f}   ({int((pc2>0).sum())}/{len(pc2)})")

pc1 = scores[:, 0]
print("\nPC1-score distribution (for context):")
print(f"  min={pc1.min():+.4f}   max={pc1.max():+.4f}   "
      f"median={np.median(pc1):+.4f}   IQR={np.percentile(pc1,75)-np.percentile(pc1,25):.4f}")
print(f"  frac_bins_PC1>0 = {(pc1>0).mean():.3f}")
print(f"\nVariance explained -- PC1 = {explained[0]*100:.2f}%,  "
      f"PC2 = {explained[1]*100:.2f}%,  "
      f"cumulative PC1+PC2 = {(explained[0]+explained[1])*100:.2f}%")

# ---------- 9. Save standardized matrix for reproducibility ----------------
std_df = raw[["BCE", "group"] + zcols].copy()
for i, c in enumerate(zcols):
    std_df[c] = Xz[:, i].round(6)
std_df.to_csv(ART_D / "capital_standardized.csv", index=False)

# ---------- 10. machine-readable summary JSON ------------------------------
# Pre-flipped loading sign (raw, before convention) for transparency:
raw_load_pc1_keform = Vt.T[idx_keform, 0] / np.linalg.norm(Vt.T[:, 0])
raw_load_pc2_max_var = zcols[j_pc2_max]
raw_load_pc2_max_val = Vt.T[j_pc2_max, 1] / np.linalg.norm(Vt.T[:, 1])

summary = {
    "n_bins": int(len(raw)),
    "bce_span": [int(raw["BCE"].min()), int(raw["BCE"].max())],
    "matrix_shape": list(map(int, Xz.shape)),
    "standardization_verified": {
        "column_means": [round(float(m), 6) for m in mu],
        "column_stds_pop": [round(float(s), 6) for s in sd],
        "max_abs_mean": round(float(np.max(np.abs(mu))), 6),
        "max_abs_deviation_from_std1": round(float(np.max(np.abs(sd - 1.0))), 6),
    },
    "sign_convention": {
        "PC1_aligned_to": "ZKeform (Pottery Form) loading positive",
        "PC2_aligned_to": f"largest |loading| variable ({zcols[j_pc2_max]}) positive",
        "components_flipped_post_align": flipped,
        "raw_pc1_keform_loading": round(float(raw_load_pc1_keform), 4),
        "raw_pc2_max_var": raw_load_pc2_max_var,
        "raw_pc2_max_loading": round(float(raw_load_pc2_max_val), 4),
    },
    "explained_variance_ratio": [round(float(x), 6) for x in explained],
    "explained_variance_pct":   [round(float(x) * 100, 4) for x in explained],
    "explained_cumulative_pct": [round(float(x) * 100, 4)
                                 for x in np.cumsum(explained)],
    "pc1_distribution": {
        "min": round(float(pc1.min()), 4),
        "max": round(float(pc1.max()), 4),
        "median": round(float(np.median(pc1)), 4),
        "frac_positive": round(float((pc1 > 0).mean()), 4),
    },
    "pc2_distribution": {
        "min": round(pc2_min, 4),
        "max": round(pc2_max, 4),
        "range": round(pc2_max - pc2_min, 4),
        "median": round(pc2_med, 4),
        "Q1": round(pc2_q1, 4),
        "Q3": round(pc2_q3, 4),
        "IQR": round(pc2_iqr, 4),
        "frac_positive": round(frac_pos, 4),
    },
    "symbolic_focus": [
        {
            "variable": v,
            "label": sym_long[v],
            "PC1_loading": round(load_df.loc[v, "PC1"], 4),
            "PC1_share":   round(load_df.loc[v, "share_PC1"], 4),
            "PC2_loading": round(load_df.loc[v, "PC2"], 4),
            "PC2_share":   round(load_df.loc[v, "share_PC2"], 4),
        }
        for v in sym
    ],
    "full_loadings_dict": {v: {f"PC{i+1}": round(float(load_df.loc[v, f"PC{i+1}"]), 4)
                               for i in range(12)}
                           for v in zcols},
}
(ART_D / "summary.json").write_text(json.dumps(summary, indent=2))
print("\nArtifacts written to", ART_D, ":",
      *[p.name for p in sorted(ART_D.iterdir())])
print("Analysis script:", "artifacts/analysis/pca_capital_100yr.py")
