"""
DiscoveryBench NLSY79 — Black vs NBNH BA-completion x Family net wealth 1996.

Locked decisions (researcher-approved, see task transcript):
- BA proxy = (Highest grade completed, 1979 >= 16) on respondents aged >=18 in 1979.
- Drop grade sentinel 95.
- SES = quartile bins of Family net wealth, 1996 (key data point), pooled across Black ∪ NBNH.
- Compare Racial/ethnic cohort, 1979 codes 1 (Black) vs 3 (NBNH only).
- Logistic: BA ~ race * SES_quartile + age + sex (penalised to handle quasi-separation).
  OLS alternative on continuous grade; OLS = primary reflector of signal.
- Sensitivity: parents' education (max of mother/father grade) + wealth-missing indicator.
- Direction is data-driven.
"""
import warnings
warnings.filterwarnings('ignore')

import numpy as np
import pandas as pd
import statsmodels.api as sm
import scipy.stats as stats

CSV = '/workspace/data/nls_raw.csv'
df = pd.read_csv(CSV, low_memory=False)

# --- Column handles (verbatim labels) ---
RACE   = 'Racial/ethnic cohort, 1979'
AGE79  = 'Age of respondent, 1979'
SEX    = 'Sex of respondent, 1979'
GRADE  = 'Highest grade completed, 1979'
WEALTH = 'Family net wealth, 1996 (key data point)'
WEALTH_SHORT = 'Family net wealth, 1996'
MOM    = "Highest grade completed by respondent's mother, 1979"
DAD    = "Highest grade completed by respondent's father, 1979"

# --- Step 1: Sample restriction ---
df = df.dropna(subset=[RACE]).copy()
df = df[df[RACE].isin([1, 3])].copy()
df = df[df[AGE79] >= 18].copy()
df = df[(df[GRADE].notna()) & (df[GRADE] != 95)].copy()

print(f'Restricted sample (age>=18, code 1 or 3, no grade sentinel): n={len(df)}')
print(f"  Black: n={int((df[RACE]==1).sum())}")
print(f"  NBNH : n={int((df[RACE]==3).sum())}")

df['BA']      = (df[GRADE] >= 16).astype(int)
df['Black']   = (df[RACE] == 1).astype(int)
df['age79']   = df[AGE79]
df['female']  = (df[SEX] == 2).astype(int)
df['wealth_missing'] = df[WEALTH].isna().astype(int)
print(f"  Overall BA rate in restricted sample: {df['BA'].mean():.4f}")

# --- Step 2: Wealth 1996 quartiles, pooled Black + NBNH (non-missing) ---
thr = df[WEALTH].quantile([0.25, 0.5, 0.75]).values
print(f'\nWealth 1996 quartile thresholds ($, pooled non-missing Black+NBNH):')
print(f'  Q1/Q2 cutoff      : ${thr[0]:>12,.0f}')
print(f'  Q2/Q3 cutoff      : ${thr[1]:>12,.0f}')
print(f'  Q3/Q4 cutoff      : ${thr[2]:>12,.0f}')

def quartile(x, t):
    if np.isnan(x): return np.nan
    if x <= t[0]: return 1
    if x <= t[1]: return 2
    if x <= t[2]: return 3
    return 4

df['SES_quartile'] = df[WEALTH].apply(lambda v: quartile(v, thr))

# --- Step 3: BA rates by race x SES quartile ---
print('\n==========================================================')
print('Binary BA-completion rates by race x SES quartile')
print('==========================================================')
print('Restriction: age>=18, grade>0 and !=95, race in {1,3}.')
print('SES quartile uses Family net wealth, 1996; rates are raw (not modelled).')
print(f'{"Q":>3} | {"Black_n":>8} {"Black_rate":>10} | {"NBNH_n":>6} {"NBNH_rate":>10} | {"gap(B-N)":>10}')
print('-'*65)
cells = []
for q in [1,2,3,4]:
    nb = int(((df['SES_quartile']==q) & (df['Black']==1)).sum())
    nw = int(((df['SES_quartile']==q) & (df['Black']==0)).sum())
    rb = df.loc[(df['SES_quartile']==q) & (df['Black']==1), 'BA'].mean() if nb>0 else np.nan
    rw = df.loc[(df['SES_quartile']==q) & (df['Black']==0), 'BA'].mean() if nw>0 else np.nan
    gap = rb - rw
    cells.append((q, nb, rb, nw, rw, gap))
    print(f'{q:>3} | {nb:>8d} {rb:>10.4f} | {nw:>6d} {rw:>10.4f} | {gap:>+10.4f}')
print('-'*65)

# --- Step 4: OLS continuous grade (primary reflector of signal) ---
dfm = df.dropna(subset=['SES_quartile','age79','female']).copy()
print(f'\nOLS modelling sample n={len(dfm)} (Black={int(dfm["Black"].sum())}, NBNH={int((dfm["Black"]==0).sum())})')

def add_design(d):
    d = d.copy()
    d['Q2'] = (d['SES_quartile']==2).astype(int)
    d['Q3'] = (d['SES_quartile']==3).astype(int)
    d['Q4'] = (d['SES_quartile']==4).astype(int)
    d['Black_x_Q2'] = d['Black']*d['Q2']
    d['Black_x_Q3'] = d['Black']*d['Q3']
    d['Black_x_Q4'] = d['Black']*d['Q4']
    return d

dfm = add_design(dfm)
X_cols = ['Black','Q2','Q3','Q4','Black_x_Q2','Black_x_Q3','Black_x_Q4','age79','female']
X = sm.add_constant(dfm[X_cols].astype(float), has_constant='add')

m_ols = sm.OLS(dfm[GRADE], X).fit()
print('\n--- OLS: Highest grade completed, 1979 ~ race * SES_quartile + age + sex ---')
print(m_ols.summary().tables[1])
inter_names = ['Black_x_Q2','Black_x_Q3','Black_x_Q4']
b = m_ols.params[inter_names].values
C = m_ols.cov_params().loc[inter_names, inter_names].values
wald_ols = float(b @ np.linalg.solve(C, b))
dfn, dfd = 3, int(m_ols.df_resid)
print(f'OLS joint race x SES F({dfn},{dfd}) = {wald_ols/dfn:.3f}, '
      f'p = {1-stats.f.cdf(wald_ols/dfn, dfn, dfd):.4f}; R^2={m_ols.rsquared:.4f}')

# --- Step 5: Logistic regression (L2-penalised to handle separation) ---
m_logit = sm.Logit(dfm['BA'], X).fit_regularized(disp=False, alpha=1e-4)
print('\n--- Penalised logistic: BA ~ race * SES_quartile + age + sex ---')
print(m_logit.params.round(3).to_string())
# Wald on penalised model (cov_params is post-OLS-like; still informative)

# Fallback: linear-probability model on the binary BA flag (clean OLS, no separation issue)
m_lpm = sm.OLS(dfm['BA'].astype(float), X).fit()
print('\n--- LPM (OLS on binary BA) for clean inferential numbers ---')
print(m_lpm.summary().tables[1])
b = m_lpm.params[inter_names].values
C = m_lpm.cov_params().loc[inter_names, inter_names].values
wald_lpm = float(b @ np.linalg.solve(C, b))
dfn2, dfd2 = 3, int(m_lpm.df_resid)
print(f'LPM joint race x SES F({dfn2},{dfd2}) = {wald_lpm/dfn2:.3f}, '
      f'p = {1-stats.f.cdf(wald_lpm/dfn2, dfn2, dfd2):.4f}; R^2={m_lpm.rsquared:.4f}')

# Predicted BA rates per race x quartile from LPM (avg-over-covariates)
import pandas as pd
def predict_lpm(model, race, q, age_mean, female_mean):
    x = np.zeros(len(X_cols)+1)
    x[0]=1; x[1]=race
    x[2]=1 if q==2 else 0
    x[3]=1 if q==3 else 0
    x[4]=1 if q==4 else 0
    if race==1:
        x[5]=1 if q==2 else 0
        x[6]=1 if q==3 else 0
        x[7]=1 if q==4 else 0
    x[8]=age_mean; x[9]=female_mean
    return float(model.predict(x.reshape(1,-1))[0])

age_m = dfm['age79'].mean(); fm_m = dfm['female'].mean()
print('\nPredicted P(BA) per race x quartile (LPM, averaged over age & sex):')
pred_table = {}
for q in [1,2,3,4]:
    pb = predict_lpm(m_lpm, 1, q, age_m, fm_m)
    pw = predict_lpm(m_lpm, 0, q, age_m, fm_m)
    pred_table[q] = (pb, pw)
    print(f"  Q{q}: Black={pb:.4f}  NBNH={pw:.4f}  gap(B-N)={pb-pw:+.4f}")

# --- Step 6: Sensitivity A — SES = max(parent education) ---
print('\n==========================================================')
print('SENSITIVITY A: SES = max(mother grade, father grade)')
print('==========================================================')
df['par_max'] = df[[MOM,DAD]].max(axis=1)
par_thr = df['par_max'].quantile([0.25,0.5,0.75]).values
print(f'Parents\'-max quartiles: Q1<=<=Q2={par_thr[0]}, Q3={par_thr[1]}, Q4={par_thr[2]}')
def pq(v):
    if np.isnan(v): return np.nan
    if v <= par_thr[0]: return 1
    if v <= par_thr[1]: return 2
    if v <= par_thr[2]: return 3
    return 4
df['SES_parQ'] = df['par_max'].apply(pq)
print(f'{"Q":>3} | {"Black_n":>8} {"Black_rate":>10} | {"NBNH_n":>6} {"NBNH_rate":>10} | {"gap":>10}')
print('-'*65)
for q in [1,2,3,4]:
    nb = int(((df['SES_parQ']==q) & (df['Black']==1)).sum())
    nw = int(((df['SES_parQ']==q) & (df['Black']==0)).sum())
    rb = df.loc[(df['SES_parQ']==q) & (df['Black']==1), 'BA'].mean() if nb>0 else np.nan
    rw = df.loc[(df['SES_parQ']==q) & (df['Black']==0), 'BA'].mean() if nw>0 else np.nan
    print(f'{q:>3} | {nb:>8d} {rb:>10.4f} | {nw:>6d} {rw:>10.4f} | {rb-rw if nb>0 and nw>0 else float("nan"):>+10.4f}')

# --- Step 7: Sensitivity B — add wealth_missing indicator to LPM ---
dfm_b = add_design(df.dropna(subset=['SES_quartile','age79','female']).copy())
X_cols_b = X_cols + ['wealth_missing']
m_lpm_b = sm.OLS(dfm_b['BA'].astype(float),
                 sm.add_constant(dfm_b[X_cols_b].astype(float), has_constant='add')).fit()
print('\n==========================================================')
print('SENSITIVITY B: LPM + wealth_missing indicator (controls attrition)')
print('==========================================================')
print(m_lpm_b.summary().tables[1])
b = m_lpm_b.params[inter_names].values
C = m_lpm_b.cov_params().loc[inter_names, inter_names].values
wald = float(b @ np.linalg.solve(C, b))
print(f'Joint race x SES F(3,{int(m_lpm_b.df_resid)}) = {wald/3:.3f}, p={1-stats.f.cdf(wald/3,3,int(m_lpm_b.df_resid)):.4f}')

# --- Diagnostics summary for final report ---
print('\n==========================================================')
print('NUMERIC SUMMARY FOR FINAL HYPOTHESIS')
print('==========================================================')
gap_Q1 = cells[0][5]; gap_Q2 = cells[1][5]; gap_Q3 = cells[2][5]; gap_Q4 = cells[3][5]
print('Raw BA-rate gap(B-N) by Family net wealth, 1996 quartile:')
print(f'  Q1: {gap_Q1:+.4f}')
print(f'  Q2: {gap_Q2:+.4f}')
print(f'  Q3: {gap_Q3:+.4f}')
print(f'  Q4: {gap_Q4:+.4f}')
print(f'OLS (continuous grade) main interaction coefficients: '
      f"{m_ols.params[['Black_x_Q2','Black_x_Q3','Black_x_Q4']].round(3).to_dict()}")
print(f'OLS joint F={wald_ols/dfn:.3f}, p={1-stats.f.cdf(wald_ols/dfn,dfn,dfd):.4f}')

# Save rate table
out = pd.DataFrame({
    'SESS_quartile':[c[0] for c in cells],
    'Black_n':[c[1] for c in cells],
    'Black_BA_rate':[c[2] for c in cells],
    'NBNH_n':[c[3] for c in cells],
    'NBNH_BA_rate':[c[4] for c in cells],
    'Black_minus_NBNH_gap':[c[5] for c in cells],
})
out['wealth_lower_$'] = [0, thr[0], thr[1], thr[2]]
out['wealth_upper_$'] = [thr[0], thr[1], thr[2], np.inf]
out.to_csv('/workspace/artifacts/rate_table.csv', index=False)
print('\nWrote /workspace/artifacts/rate_table.csv')
