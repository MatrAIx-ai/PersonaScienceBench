"""
Analysis script for NLSY79-derived median-family-wealth comparison across
racial/ethnic cohort.

Headline: MICE-imputed medians of family net wealth by cohort x wave,
with complete-case and zero-fill as robustness checks.
Reference: NON-BLACK NON-HISPANIC (code 3) (see hypothesis A1 caveat).
Dollars: nominal USD headline + 1996 USD supplementary (CPI-U
1982-84=100, U.S. BLS series CUUR0000SA0).  Deflator applied to
1985 and 1990 only; 1996 reported at face value.

Reproduction:  python scripts/analysis.py
Writes:        results/tables/results_long.csv
               results/tables/results_wide.md
               results/tables/analysis_meta.json
"""
import os, json
from pathlib import Path
import numpy as np
import pandas as pd
from scipy import stats

ROOT = Path(__file__).resolve().parents[1]
CSV = ROOT / 'data' / 'nls_raw.csv'
OUT = ROOT / 'results'
OUT.mkdir(exist_ok=True)
(OUT / 'tables').mkdir(exist_ok=True)

# BLS CPI-U (US city avg, all items, not seasonally adjusted),
# annual averages, 1982-84 = 100, rounded to one decimal
CPI = {1985: 107.6, 1990: 130.7, 1996: 156.9}
CPI_BASE = 1996
DEFLATOR = {y: CPI[CPI_BASE] / CPI[y] for y in CPI}

YEARS = [1985, 1990, 1996]
WEALTH_COLS = {
    1985: 'Family net wealth, 1985',
    1990: 'Family net wealth, 1990',
    1996: 'Family net wealth, 1996 (key data point)',
}
COHORT_LABELS = {1: 'BLACK', 2: 'HISPANIC', 3: 'NON-BLACK NON-HISPANIC'}

df = pd.read_csv(CSV)
df['cohort'] = df['Racial/ethnic cohort, 1979'].map(COHORT_LABELS)
assert df['cohort'].notna().all()

def median_with_iqr(s):
    s = s.dropna()
    if s.empty:
        return {'n': 0, 'median': np.nan, 'p25': np.nan, 'p75': np.nan}
    return {
        'n': int(s.shape[0]),
        'median': float(s.median()),
        'p25': float(s.quantile(0.25)),
        'p75': float(s.quantile(0.75)),
    }

# ---------- complete-case ----------
cc_rows = []
for yr in YEARS:
    for coh in ['BLACK', 'HISPANIC', 'NON-BLACK NON-HISPANIC']:
        s = df.loc[df['cohort'] == coh, WEALTH_COLS[yr]]
        m = median_with_iqr(s)
        cc_rows.append({'treatment': 'complete_case', 'wave': yr, 'cohort': coh, **m})
cc = pd.DataFrame(cc_rows)

# ---------- zero-fill ----------
zf_rows = []
for yr in YEARS:
    for coh in ['BLACK', 'HISPANIC', 'NON-BLACK NON-HISPANIC']:
        s = df.loc[df['cohort'] == coh, WEALTH_COLS[yr]].fillna(0)
        m = median_with_iqr(s)
        m['n'] = int(df.loc[df['cohort'] == coh].shape[0])
        zf_rows.append({'treatment': 'zero_fill', 'wave': yr, 'cohort': coh, **m})
zf = pd.DataFrame(zf_rows)

# ---------- MICE design ----------
def build_design(df):
    d = pd.DataFrame(index=df.index)
    d['black'] = (df['cohort'] == 'BLACK').astype(float)
    d['hispanic'] = (df['cohort'] == 'HISPANIC').astype(float)
    d['female'] = (df['Sex of respondent, 1979'] == 2).astype(float)
    d['age79'] = df['Age of respondent, 1979'].astype(float)
    d['family_size_79'] = df['Family size, 1979'].astype(float)
    m_ed = df["Highest grade completed by respondent's mother, 1979"]
    f_ed = df["Highest grade completed by respondent's father, 1979"]
    par = pd.concat([m_ed, f_ed], axis=1).mean(axis=1, skipna=True)
    d['parental_edu'] = par
    inc79 = df['Total net family income, previous calendar year, 1979']
    inc85 = df['Total net family income, previous calendar year, 1985']
    inc89 = df['Total net family income, previous calendar year, 1989']
    d['log_inc_79'] = np.log1p(inc79.clip(lower=0))
    d['log_inc_85'] = np.log1p(inc85.clip(lower=0))
    d['log_inc_89'] = np.log1p(inc89.clip(lower=0))
    return d

design = build_design(df)

all_min = min(df[WEALTH_COLS[y]].min() for y in YEARS)
K = 1.0 - all_min  # wealth + K >= 1
print(f'[MICE] wealth shift K = {K:.2f} (all_min across years = {all_min:.0f})')

wealth_ls = {}
for yr in YEARS:
    wealth_ls[yr] = np.log(df[WEALTH_COLS[yr]].astype(float) + K)

def ols_posterior_draw(X_obs, y_obs, X_mis, rng):
    """Posterior-predictive draw under conjugate-normal-inverse-gamma prior.
    beta_hat, s2_hat from OLS; draw sigma2* and beta* from posterior;
    y_mis = X_mis @ beta* + sqrt(sigma2*) * eps.
    """
    n, p = X_obs.shape
    X1 = np.hstack([np.ones((n, 1)), X_obs])
    XtX = X1.T @ X1 + np.eye(p + 1) * 1e-9
    Xty = X1.T @ y_obs
    beta_hat = np.linalg.solve(XtX, Xty)
    resid = y_obs - X1 @ beta_hat
    s2_hat = float((resid ** 2).sum() / max(n - p - 1, 1))
    s2_hat = max(s2_hat, 1e-6)
    X1_mis = np.hstack([np.ones((X_mis.shape[0], 1)), X_mis])
    scale = np.linalg.inv(XtX)
    sigma2_star = s2_hat * (n - p - 1) / rng.chisquare(df=max(n - p - 1, 1))
    z = rng.standard_normal(size=(p + 1,))
    beta_star = beta_hat + np.sqrt(sigma2_star) * np.sqrt(np.diag(scale)) * z
    y_mis = X1_mis @ beta_star + np.sqrt(sigma2_star) * rng.standard_normal(size=X_mis.shape[0])
    return y_mis

def mice_chain(df, design, wealth_ls, m_imps=20, cycles=10, seed=20260101):
    rng_master = np.random.default_rng(seed)
    seeds = rng_master.integers(low=1, high=2**31 - 1, size=m_imps)
    imputed_sets = []
    for j, s in enumerate(seeds):
        rng = np.random.default_rng(int(s))
        cur = {}
        for yr in YEARS:
            y = wealth_ls[yr].copy()
            mask_mis = y.isna()
            for c in ['BLACK', 'HISPANIC', 'NON-BLACK NON-HISPANIC']:
                cm = mask_mis & (df['cohort'] == c)
                init = y[df['cohort'] == c].median() if (not y[df['cohort'] == c].dropna().empty) else np.log(K)
                y[cm] = init
            cur[yr] = y

        for cycle in range(cycles):
            for tgt in YEARS:
                others = [y for y in YEARS if y != tgt]
                X = design.copy()
                X['w_other1'] = cur[others[0]]
                X['w_other2'] = cur[others[1]]
                X_arr = X.values.astype(float)
                mu = np.nanmean(X_arr, axis=0)
                sd = np.nanstd(X_arr, axis=0)
                sd = np.where(sd < 1e-9, 1.0, sd)
                Xz = (X_arr - mu) / sd
                y_target = cur[tgt].copy()
                mask_obs = y_target.notna().values
                y_obs = y_target[mask_obs].astype(float).values
                X_obs = Xz[mask_obs]
                X_mis = Xz[~mask_obs]
                imputed = ols_posterior_draw(X_obs, y_obs, X_mis, rng)
                cur[tgt].iloc[mask_obs.nonzero()[0]] = y_obs
                cur[tgt].iloc[(~mask_obs).nonzero()[0]] = imputed

        imp_df = pd.DataFrame(index=df.index)
        for yr in YEARS:
            imp_df[WEALTH_COLS[yr]] = np.exp(cur[yr].values) - K
        imputed_sets.append(imp_df)
        print(f'  [MICE] imputation {j+1}/{m_imps} done')
    return imputed_sets

print('[MICE] running 20 imputations x 10 cycles...')
imputed_sets = mice_chain(df, design, wealth_ls, m_imps=20, cycles=10)

def pooled_median(imp_sets, cohort_mask, wealth_col, seed=11):
    meds, ses = [], []
    for d in imp_sets:
        s = d.loc[cohort_mask, wealth_col]
        s = s[np.isfinite(s)]
        m = float(s.median())
        meds.append(m)
        rng = np.random.default_rng(seed)
        bts = [float(s.iloc[rng.integers(0, s.shape[0], s.shape[0])].median()) for _ in range(200)]
        ses.append(float(np.std(bts, ddof=1)))
    meds = np.asarray(meds); ses = np.asarray(ses)
    m = len(meds)
    Q_bar = float(meds.mean())
    U_bar = float((ses ** 2).mean())
    B_var = float(((meds - Q_bar) ** 2).sum() / (m - 1)) if m > 1 else 0.0
    T = U_bar + (1 + 1.0 / m) * B_var
    SE = float(np.sqrt(T))
    return {'median': Q_bar, 'se': SE, 'lo': Q_bar - 1.96 * SE, 'hi': Q_bar + 1.96 * SE}

mice_rows = []
cohort_masks = {
    'BLACK': df['cohort'].eq('BLACK'),
    'HISPANIC': df['cohort'].eq('HISPANIC'),
    'NON-BLACK NON-HISPANIC': df['cohort'].eq('NON-BLACK NON-HISPANIC'),
}
for yr in YEARS:
    col = WEALTH_COLS[yr]
    for coh, mask in cohort_masks.items():
        p = pooled_median(imputed_sets, mask, col)
        mice_rows.append({
            'treatment': 'mice', 'wave': yr, 'cohort': coh,
            'n': int(mask.sum()), 'median': p['median'],
            'se': p['se'], 'lo': p['lo'], 'hi': p['hi'],
            'p25': np.nan, 'p75': np.nan,
        })
mice = pd.DataFrame(mice_rows)

def normalise(d):
    d = d.copy()
    d['se'] = np.nan; d['lo'] = np.nan; d['hi'] = np.nan
    if 'p25' not in d: d['p25'] = np.nan
    if 'p75' not in d: d['p75'] = np.nan
    d['n'] = d['n'].astype(int)
    return d[['treatment','wave','cohort','n','median','se','lo','hi','p25','p75']]

results = pd.concat([normalise(cc), normalise(zf), normalise(mice)], ignore_index=True)

def add_ratios(d):
    out = d.copy()
    out['ratio_to_NBNH'] = np.nan; out['gap_to_NBNH_nominal'] = np.nan
    for tr in out.treatment.unique():
        for yr in YEARS:
            nb = float(out[(out.treatment==tr)&(out.wave==yr)&(out.cohort=='NON-BLACK NON-HISPANIC')]['median'].iloc[0])
            for coh in ['BLACK','HISPANIC']:
                idx = (out.treatment==tr)&(out.wave==yr)&(out.cohort==coh)
                v = float(out.loc[idx,'median'].iloc[0])
                out.loc[idx, 'ratio_to_NBNH'] = v/nb if nb != 0 else float('nan')
                out.loc[idx, 'gap_to_NBNH_nominal'] = nb - v
    return out

results = add_ratios(results)
results['median_1996USD'] = results.apply(lambda r: r['median']*DEFLATOR[r['wave']], axis=1)

disp = results.round(2)
disp.to_csv(OUT/'tables'/'results_long.csv', index=False)
print('[OK] wrote', OUT/'tables'/'results_long.csv')

def md_table(tr):
    sub = results[results.treatment==tr].copy()
    lines = [f'### Treatment: {tr}  (nominal USD; gap/ratio vs NON-BLACK NON-HISPANIC reference)','']
    lines.append('| Wave | Cohort | n | Median (nominal $) | Median (1996 $) | p25 | p75 | Ratio to NBNH | Gap to NBNH ($) |')
    lines.append('|---|---|---:|---:|---:|---:|---:|---:|---:|')
    cohort_order = {'BLACK':0,'HISPANIC':1,'NON-BLACK NON-HISPANIC':2}
    sub = sub.assign(_o=sub.cohort.map(cohort_order)).sort_values(['wave','_o'])
    for _, r in sub.iterrows():
        p25 = '' if pd.isna(r.p25) else f'{r.p25:,.0f}'
        p75 = '' if pd.isna(r.p75) else f'{r.p75:,.0f}'
        gap = '' if pd.isna(r['gap_to_NBNH_nominal']) else f'{r["gap_to_NBNH_nominal"]:,.0f}'
        lines.append(f"| {r.wave} | {r.cohort} | {r.n} | {r['median']:,.0f} | {r['median_1996USD']:,.0f} | {p25} | {p75} | {r.ratio_to_NBNH:.2f} | {gap} |")
    lines.append('')
    return '\n'.join(lines)

md_all = ['# Results: median family net wealth by racial/ethnic cohort, NLSY79','',
          'Cohort coding: 1=BLACK, 2=HISPANIC, 3=NON-BLACK NON-HISPANIC',
          '(residual category, NOT exactly "white"; see A1 caveat).','',
          f'CPI-U deflator (BLS 1982-84=100) to 1996 USD: '
          f'1985 -> x{DEFLATOR[1985]:.4f}; 1990 -> x{DEFLATOR[1990]:.4f}; 1996 -> 1.0000.','Source: U.S. BLS CPI-U series CUUR0000SA0, annual avg.','']
for tr in ['complete_case','mice','zero_fill']:
    md_all.append(md_table(tr))

md_all.append('## Family size at 1979 (contextual note)')
md_all.append('| Cohort | n | Mean | Median | SD |')
md_all.append('|---|---:|---:|---:|---:|')
fam = df.groupby('cohort')['Family size, 1979'].agg(['count','mean','median','std']).round(2)
for coh, r in fam.iterrows():
    md_all.append(f"| {coh} | {int(r['count'])} | {r['mean']:.2f} | {r['median']:.2f} | {r['std']:.2f} |")
md_all.append('')
(OUT/'tables'/'results_wide.md').write_text('\n'.join(md_all))
print('[OK] wrote', OUT/'tables'/'results_wide.md')

print()
print('=== Headline (MICE) medians ===')
hdl = results[results.treatment=='mice'].pivot(index='cohort', columns='wave', values='median').round(0)
print(hdl.reindex(['BLACK','HISPANIC','NON-BLACK NON-HISPANIC']).to_string())
print()
print('=== Ratios (MICE) ===')
print(results[(results.treatment=='mice')&(results.cohort!='NON-BLACK NON-HISPANIC')][['wave','cohort','median','ratio_to_NBNH','gap_to_NBNH_nominal']].to_string(index=False))
print()
print('=== Robustness: complete-case medians ===')
hd2 = results[results.treatment=='complete_case'].pivot(index='cohort', columns='wave', values='median').round(0)
print(hd2.reindex(['BLACK','HISPANIC','NON-BLACK NON-HISPANIC']).to_string())
print()
print('=== Robustness: zero-fill (lower bound) medians ===')
hd3 = results[results.treatment=='zero_fill'].pivot(index='cohort', columns='wave', values='median').round(0)
print(hd3.reindex(['BLACK','HISPANIC','NON-BLACK NON-HISPANIC']).to_string())
print()
print('=== Median 1996 USD (MICE) ===')
hdl2 = results[results.treatment=='mice'].pivot(index='cohort', columns='wave', values='median_1996USD').round(0)
print(hdl2.reindex(['BLACK','HISPANIC','NON-BLACK NON-HISPANIC']).to_string())

meta = {
    'cpi_source': 'BLS CPI-U series CUUR0000SA0, annual averages, 1982-84=100',
    'cpi': CPI, 'deflator_to_1996USD': DEFLATOR,
    'mice': {'n_imputations': 20, 'cycles_per_imp': 10,
             'posterior_draw': 'conjugate-normal-inverse-gamma (BDA3 14.1)',
             'we_transform': 'log(W + K), K = 1 - min(W) over all years',
             'predictors_per_wave': ['black','hispanic','female','age79','family_size_79',
                                     'parental_edu','log_inc_79','log_inc_85','log_inc_89',
                                     'other_year_wealth_log'],
             'bootstrap_se_for_pooling': 200},
    'sample': {
        'N_rows': int(len(df)),
        'BLACK': int((df.cohort=='BLACK').sum()),
        'HISPANIC': int((df.cohort=='HISPANIC').sum()),
        'NON-BLACK NON-HISPANIC': int((df.cohort=='NON-BLACK NON-HISPANIC').sum()),
    },
    'reference_cohort_caveat': 'NON-BLACK NON-HISPANIC is the residual category; not strictly white.',
    'balanced_panel_n_all_three_waves': int((df[WEALTH_COLS[1985]].notna() & df[WEALTH_COLS[1990]].notna() & df[WEALTH_COLS[1996]].notna()).sum()),
}
(OUT/'tables'/'analysis_meta.json').write_text(json.dumps(meta, indent=2, default=float))
print('[OK] wrote', OUT/'tables/analysis_meta.json')
