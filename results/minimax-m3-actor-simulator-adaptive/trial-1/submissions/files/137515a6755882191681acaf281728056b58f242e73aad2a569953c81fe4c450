    s_path = []
    for nm in ['M1','M2','M3','M4']:
        m, _ = fits_r[nm]
        s_path.append((float(m.params['SES']), float(m.pvalues['SES'])))
    print(f"   SES trajectory M1 → M4 (ref={ref}): " + " → ".join([f"{b:+.4f} (p={p:.4f})" for b,p in s_path]))
