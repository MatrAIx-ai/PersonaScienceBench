"""Final consolidated analysis: nested OLS trajectories + logit robustness + reference sensitivity."""
import pandas as pd
import numpy as np
import statsmodels.api as sm
from itertools import product

pd.set_option('display.width', 220)
pd.set_option('display.max_columns', None)
pd.set_option('display.float_format', lambda x: f'{x:.6f}')

df = pd.read_csv('data/nls_ses_processed.csv', index_col=0)
df['BA'] = df['BA DEGREE COMPLETED'].astype(int)
df['Black']    = (df['SAMPLE_RACE'] == 'Black').astype(int)
df['Hispanic'] = (df['SAMPLE_RACE'] == 'Hispanic').astype(int)
df['White']    = (df['SAMPLE_RACE'] == 'White').astype(int)
df['Female']   = (df['SAMPLE_SEX']  == 'Female').astype(int)
df['NonWhite'] = ((df['SAMPLE_RACE'] != 'White')).astype(int)

print(f"Total N = {len(df)}; complete cases on all analysis variables = {df[['BA','SES','FAMILY SIZE OF SAMPLE','SAMPLE_RACE','SAMPLE_SEX','ABILITY: COMPOSITE OF ASVAB SCORE','PERCENTILE IN CLASS']].dropna().shape[0]}")
print("\nOutcome by race:")
print(df.groupby('SAMPLE_RACE')['BA'].agg(['mean','count','sum']))
print("\nOutcome by sex:")
print(df.groupby('SAMPLE_SEX')['BA'].agg(['mean','count','sum']))

CONT_RAW = ['SES','FAMILY SIZE OF SAMPLE','ABILITY: COMPOSITE OF ASVAB SCORE','PERCENTILE IN CLASS']
d_raw = df.copy()

d_std = df.copy()
for c in CONT_RAW:
    d_std[c] = (d_std[c] - d_std[c].mean()) / d_std[c].std()

def fit(d, spec, link='ols', race_ref='White'):
    """race_ref controls SAMPLE_RACE dummy coding."""
    if race_ref == 'White':
        race_dum = ['Black','Hispanic']
    elif race_ref == 'Black':
        race_dum = ['White','Hispanic']
    elif race_ref == 'Hispanic':
        race_dum = ['White','Black']
    spec_real = []
    for v in spec:
        if v == 'RACE':
            spec_real.extend(race_dum)
        elif v == 'NONWHITE':
            spec_real = [v if x!='RACE' else [v] for x in spec]
            spec_real = [x if isinstance(x,list) else x for x in spec_real]
            spec_real = [item for sub in spec_real for item in (sub if isinstance(sub,list) else [sub])]
            continue
        else:
            spec_real.append(v)
    spec_real = [v for v in spec_real]
    X = sm.add_constant(d[spec_real])
    y = d['BA']
    if link == 'ols':
        return sm.OLS(y, X).fit(cov_type='HC1'), spec_real
    elif link == 'logit':
        return sm.Logit(y, X).fit(disp=False, cov_type='HC1'), spec_real
    elif link == 'probit':
        return sm.Probit(y, X).fit(disp=False, cov_type='HC1'), spec_real

# -----------------------------------------------------------------------------
# PRIMARY: Standardized-predictor OLS trajectory M1..M4
# -----------------------------------------------------------------------------
print("\n\n" + "="*120)
print("PRIMARY ANALYSIS -- STANDARDIZED OLS, Robust (HC1) SEs")
print("="*120)

spec_M1 = ['SES','FAMILY SIZE OF SAMPLE','Female']
spec_M2 = spec_M1 + ['RACE']
spec_M3 = spec_M1 + ['ABILITY: COMPOSITE OF ASVAB SCORE','PERCENTILE IN CLASS']
spec_M4 = spec_M1 + ['RACE','ABILITY: COMPOSITE OF ASVAB SCORE','PERCENTILE IN CLASS']

fits_std = {}
for nm, sp in [('M1 bg only', spec_M1),
               ('M2 M1+race', spec_M2),
               ('M3 M1+academic', spec_M3),
               ('M4 M1+race+academic', spec_M4)]:
    m, real_spec = fit(d_std, sp, link='ols', race_ref='White')
    fits_std[nm] = (m, real_spec)
    print(f"\n----- {nm}  (n={int(m.nobs)}, predictors={real_spec}) -----")
    print(m.summary().tables[1])

# Trajectory table (standardized betas)
all_preds = ['SES','FAMILY SIZE OF SAMPLE','Female','Black','Hispanic',
             'ABILITY: COMPOSITE OF ASVAB SCORE','PERCENTILE IN CLASS','White']
rows = []
for p in all_preds:
    row = {'predictor': p}
    for nm in ['M1 bg only','M2 M1+race','M3 M1+academic','M4 M1+race+academic']:
        m, _ = fits_std[nm]
        if p in m.params.index:
            row[f'{nm}_beta'] = float(m.params[p])
            row[f'{nm}_se']   = float(m.bse[p])
            row[f'{nm}_p']    = float(m.pvalues[p])
            row[f'{nm}_sig']  = '*' if float(m.pvalues[p]) < 0.05 else ' '
        else:
            for c in ['beta','se','p','sig']:
                row[f'{nm}_{c}'] = np.nan
    rows.append(row)
traj_std = pd.DataFrame(rows)
print("\n========== TRAJECTORY: STANDARDIZED OLS ==========")
print(traj_std.to_string(index=False))
traj_std.to_csv('scripts/trajectory_std_ols.csv', index=False)

# -----------------------------------------------------------------------------
# UNSTANDARDIZED OLS (raw scale, for transparency)
# -----------------------------------------------------------------------------
print("\n\n" + "="*120)
print("UNSTANDARDIZED OLS (raw scale) - for transparency")
print("="*120)

fits_raw = {}
for nm, sp in [('M1', spec_M1),('M2', spec_M2),('M3', spec_M3),('M4', spec_M4)]:
    m, real = fit(d_raw, sp, link='ols', race_ref='White')
    fits_raw[nm] = (m, real)
    print(f"\n----- {nm}  predictors={real}  -----")
    print(m.summary().tables[1])

rows_raw = []
for p in all_preds:
    row = {'predictor': p}
    for nm in ['M1','M2','M3','M4']:
        m, _ = fits_raw[nm]
        if p in m.params.index:
            row[f'{nm}_beta'] = float(m.params[p])
            row[f'{nm}_se']   = float(m.bse[p])
            row[f'{nm}_p']    = float(m.pvalues[p])
            row[f'{nm}_sig']  = '*' if float(m.pvalues[p]) < 0.05 else ' '
        else:
            for c in ['beta','se','p','sig']:
                row[f'{nm}_{c}'] = np.nan
    rows_raw.append(row)
traj_raw = pd.DataFrame(rows_raw)
print("\n--- Trajectory Unstandardized OLS ---")
print(traj_raw.to_string(index=False))
traj_raw.to_csv('scripts/trajectory_raw_ols.csv', index=False)

# -----------------------------------------------------------------------------
# PROBIT TRAJECTORY (matches question's 0.3636)
# -----------------------------------------------------------------------------
print("\n\n" + "="*120)
print("PROBIT (links to question's +0.3636 value)")
print("="*120)
fits_p = {}
for nm, sp in [('M1', spec_M1),('M2', spec_M2),('M3', spec_M3),('M4', spec_M4)]:
    m, real = fit(d_raw, sp, link='probit', race_ref='White')
    fits_p[nm] = (m, real)
    print(f"\n----- {nm}  predictors={real}  -----")
    print(m.summary().tables[1])

rows_p = []
for p in all_preds:
    row = {'predictor': p}
    for nm in ['M1','M2','M3','M4']:
        m, _ = fits_p[nm]
        if p in m.params.index:
            row[f'{nm}_coef'] = float(m.params[p])
            row[f'{nm}_se']   = float(m.bse[p])
            row[f'{nm}_p']    = float(m.pvalues[p])
            row[f'{nm}_sig']  = '*' if float(m.pvalues[p]) < 0.05 else ' '
        else:
            for c in ['coef','se','p','sig']:
                row[f'{nm}_{c}'] = np.nan
    rows_p.append(row)
traj_p = pd.DataFrame(rows_p)
print("\n--- Trajectory Probit (raw scale) ---")
print(traj_p.to_string(index=False))
traj_p.to_csv('scripts/trajectory_probit.csv', index=False)

print("\n\n========== SES trajectory across all three specifications ==========")
for label, df_traj in [('Standardized OLS', traj_std),
                       ('Raw OLS',         traj_raw),
                       ('Probit (raw)',    traj_p)]:
    s = df_traj[df_traj.predictor == 'SES'].iloc[0]
    cols = [c for c in df_traj.columns if c.endswith('_beta') or c.endswith('_coef')]
    print(f"\n  [{label}]")
    for c in cols:
        v = s[c]
        p_col = c.replace('_beta','_p').replace('_coef','_p')
        if p_col in df_traj.columns:
            p = s[p_col]
            print(f"     {c:36s} : {v:+.4f}  (p={p:.4f})")

# -----------------------------------------------------------------------------
# LOGIT ROBUSTNESS
# -----------------------------------------------------------------------------
print("\n\n" + "="*120)
print("LOGIT ROBUSTNESS (with AMEs)")
print("="*120)

spec_M4L = spec_M4
m_logit, real = fit(d_raw, spec_M4L, link='logit', race_ref='White')
print(f"\nLogit M4 predictors={real}")
print(m_logit.summary().tables[1])

m_logit_std, real = fit(d_std, spec_M4L, link='logit', race_ref='White')
print(f"\nLogit M4 (standardized) predictors={real}")
print(m_logit_std.summary().tables[1])

# AMEs
ame_M4 = m_logit.get_margeff(at='overall', method='dydx')
print("\nLogit M4 Average Marginal Effects (raw predictors):")
print(ame_M4.summary().tables[1])

ame_M4_std = m_logit_std.get_margeff(at='overall', method='dydx')
print("\nLogit M4 AMEs (standardized predictors):")
print(ame_M4_std.summary().tables[1])

# Compare standardized betas across link functions for M4
print("\n--- M4 standardized coefficient comparison ---")
m_ols_std, _ = fits_std['M4 M1+race+academic']
m_p_raw, _ = fits_p['M4']
ols_std_betas = {v: float(m_ols_std.params[v]) for v in m_ols_std.params.index if v != 'const'}
probit_betas  = {v: float(m_p_raw.params[v]) for v in m_p_raw.params.index if v != 'const'}
logit_ames    = {v: float(ame_M4.summary().tables[1].data[r][1]) for r in range(2, len(ame_M4.summary().tables[1].data)) if ame_M4.summary().tables[1].data[r][1] != ''}
logit_coefs   = {v: float(m_logit.params[v]) for v in m_logit.params.index if v != 'const'}
# Manual parse
print(f"{'Variable':40s} {'OLS std β':>13s} {'Probit b':>13s} {'Logit b':>13s} {'Logit AME':>13s}")
for v in ['SES','FAMILY SIZE OF SAMPLE','Female','Black','Hispanic','ABILITY: COMPOSITE OF ASVAB SCORE','PERCENTILE IN CLASS']:
    ols    = ols_std_betas.get(v, np.nan)
    prob   = probit_betas.get(v, np.nan)
    logit  = logit_coefs.get(v, np.nan)
    ame    = logit_ames.get(v, np.nan)
    print(f"  {v:38s} {ols:+13.4f} {prob:+13.4f} {logit:+13.4f} {ame:+13.5f}")

# -----------------------------------------------------------------------------
# RACE REFERENCE SENSITIVITY
# -----------------------------------------------------------------------------
print("\n\n" + "="*120)
print("RACE REFERENCE CATEGORY SENSITIVITY (standardized OLS, M1..M4)")
print("="*120)
for ref in ['White','Black','Hispanic']:
    print(f"\n----- Reference = {ref} -----")
    fits_r = {}
    for nm, sp in [('M1', spec_M1),('M2', spec_M2),('M3', spec_M3),('M4', spec_M4)]:
        m, real = fit(d_std, sp, link='ols', race_ref=ref)
