# ---------- 3. Logistic regression with Black x SES interaction ----------------
def fit_logit_ba(data, ses_col, label):
    sub = data[data[ses_col].isin(["Low", "Middle", "High"])].copy()
    sub["Black"] = (sub["race_lbl"] == "Black").astype(int)
    sub["Hispanic"] = (sub["race_lbl"] == "Hispanic").astype(int)
    sub["SES_Low"] = (sub[ses_col] == "Low").astype(int)
    sub["SES_High"] = (sub[ses_col] == "High").astype(int)
    sub["Black_x_Low"] = sub["Black"] * sub["SES_Low"]
    sub["Black_x_High"] = sub["Black"] * sub["SES_High"]
    sub["Hisp_x_Low"] = sub["Hispanic"] * sub["SES_Low"]
    sub["Hisp_x_High"] = sub["Hispanic"] * sub["SES_High"]
    sub["female"] = (sub["sex"] == 2).astype(int)
    sub["age_c"] = sub["age1979"] - sub["age1979"].mean()
    cols = ["Black", "Hispanic",
            "SES_Low", "SES_High",
            "Black_x_Low", "Black_x_High",
            "Hisp_x_Low", "Hisp_x_High",
            "female", "age_c"]
    sub_aligned = sub.reset_index(drop=True)
    X = sm.add_constant(sub_aligned[cols].astype(float), has_constant="add")
    y = sub_aligned["ba_proxy"].astype(float)
    valid = y.notna()
    Xv = X.loc[valid].reset_index(drop=True)
    yv = y.loc[valid].reset_index(drop=True)
    sub_aligned = sub_aligned.loc[valid.values].reset_index(drop=True)
    mask = Xv.notna().all(axis=1)
    Xv = Xv.loc[mask].reset_index(drop=True)
    yv = yv.loc[mask].reset_index(drop=True)
    sub_aligned = sub_aligned.loc[mask.values].reset_index(drop=True)
    model = sm.Logit(yv, Xv)
    res = model.fit(disp=False, maxiter=200, method="bfgs")
    n_obs = int(mask.sum()); n_ev = int(yv.sum())
    print(f"\n[{label}] Logistic BA_proxy — N={n_obs}, events={n_ev}")
    summ = pd.DataFrame({
        "coef": res.params, "se": res.bse,
        "z": res.tvalues, "p": res.pvalues,
        "ci_lo": res.conf_int().iloc[:, 0],
        "ci_hi": res.conf_int().iloc[:, 1],
    })
    print(summ.to_string(float_format=lambda x: f"{x: .4f}"))
    summ.to_csv(f"artifacts/logit_summary_{label}.csv")
    return res, sub_aligned

def marginal_gaps(res, sub, ses_levels=("Low", "Middle", "High")):
    """Average marginal: P(Black=1, ...) - P(Black=0, ...) at each SES tier,
    holding Hispanic=0 (NBNH reference), sex and age at sample means."""
    female_val = sub["female"].mean()
    age_c_val = sub["age_c"].mean()
    Xcols = list(res.params.index)
    cov_mat = res.cov_params().values
    b = res.params.values
    rows = []
    for s in ses_levels:
        SL = 1.0 if s == "Low" else 0.0
        SH = 1.0 if s == "High" else 0.0
        x0 = np.zeros(len(Xcols))
        x0[0] = 1.0
        x0[2] = 0.0  # Hispanic=0 (NBNH ref)
        x0[3] = SL; x0[4] = SH
        x0[9] = female_val; x0[10] = age_c_val
        x1 = x0.copy()
        x1[1] = 1.0; x1[5] = SL; x1[6] = SH
        eta0 = x0 @ b; eta1 = x1 @ b
        p0 = 1/(1+np.exp(-eta0)); p1 = 1/(1+np.exp(-eta1))
        diff = p1 - p0
        grad = (p1*(1-p1))*x1 - (p0*(1-p0))*x0
        var = float(grad @ cov_mat @ grad)
        se = np.sqrt(max(var, 0.0))
        rows.append({"ses": s, "p_NBNH": p0, "p_Black": p1,
                     "gap": diff, "se": se,
                     "ci_lo": diff - 1.96*se, "ci_hi": diff + 1.96*se})
    return pd.DataFrame(rows)

