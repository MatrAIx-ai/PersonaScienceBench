# ---------- 6. Multiple imputation (10 imputations, ICE) ----------------------
print()
print("=" * 78)
print("SENSITIVITY C: Multiple imputation (M=10, ICE; Rubin pooling)")
print("=" * 78)
M = 10

def impute_one(df_in, seed):
    rng = np.random.default_rng(seed)
    dd = df_in.copy()
    # Order: mom_ed first (least missing among SES drivers), then dad_ed, then inc79
    # Imputation model: OLS on completed covariates; stochastic residual.

    # 1. mom_ed
    miss = dd["mom_ed"].isna().values
    if miss.sum():
        feats = pd.DataFrame({
            "hgc": dd["hgc"], "sex_f": (dd["sex"]==2).astype(int),
            "Black": (dd["race_lbl"]=="Black").astype(int),
            "Hisp": (dd["race_lbl"]=="Hispanic").astype(int),
            "age1979": dd["age1979"],
        })
        X = sm.add_constant(feats.astype(float), has_constant="add")
        y = dd["mom_ed"]
        # ensure complete-case training rows (predictors are non-missing too)
        train_mask = (y.notna())
        # restrict to rows where all X entries are finite
        train = train_mask & np.isfinite(X).all(axis=1)
        mod = sm.OLS(y[train], X.loc[train].astype(float)).fit()
        pred = mod.predict(X.astype(float)).values
        sigma = float(np.sqrt(np.sum(mod.resid**2) / max(mod.df_resid, 1)))
        v = y.values.copy()
        v[miss] = np.clip(pred[miss] + rng.normal(0, sigma, miss.sum()), 0, 20)
        dd["_mom_ed"] = v
    else:
        dd["_mom_ed"] = dd["mom_ed"].values

    # 2. dad_ed (use imputed mom_ed as predictor)
    miss = dd["dad_ed"].isna().values
    if miss.sum():
        feats = pd.DataFrame({
            "hgc": dd["hgc"], "sex_f": (dd["sex"]==2).astype(int),
            "Black": (dd["race_lbl"]=="Black").astype(int),
            "Hisp": (dd["race_lbl"]=="Hispanic").astype(int),
            "age1979": dd["age1979"], "mom_imp": dd["_mom_ed"],
        })
        X = sm.add_constant(feats.astype(float), has_constant="add")
        y = dd["dad_ed"]
        # ensure complete-case training rows (predictors are non-missing too)
        train_mask = (y.notna())
        # restrict to rows where all X entries are finite
        train = train_mask & np.isfinite(X).all(axis=1)
        mod = sm.OLS(y[train], X.loc[train].astype(float)).fit()
        pred = mod.predict(X.astype(float)).values
        sigma = float(np.sqrt(np.sum(mod.resid**2) / max(mod.df_resid, 1)))
        v = y.values.copy()
        v[miss] = np.clip(pred[miss] + rng.normal(0, sigma, miss.sum()), 0, 20)
        dd["_dad_ed"] = v
    else:
        dd["_dad_ed"] = dd["dad_ed"].values

    # 3. inc79 (use imputed parental ed)
    miss = dd["inc79"].isna().values
    if miss.sum():
        feats = pd.DataFrame({
            "hgc": dd["hgc"], "sex_f": (dd["sex"]==2).astype(int),
            "Black": (dd["race_lbl"]=="Black").astype(int),
            "Hisp": (dd["race_lbl"]=="Hispanic").astype(int),
            "age1979": dd["age1979"],
            "par_ed_max_imp": np.fmax(dd["_mom_ed"], dd["_dad_ed"]),
        })
        X = sm.add_constant(feats.astype(float), has_constant="add")
        y = dd["inc79"]
        # ensure complete-case training rows (predictors are non-missing too)
        train_mask = (y.notna())
        # restrict to rows where all X entries are finite
        train = train_mask & np.isfinite(X).all(axis=1)
        mod = sm.OLS(y[train], X.loc[train].astype(float)).fit()
        pred = mod.predict(X.astype(float)).values
        sigma = float(np.sqrt(np.sum(mod.resid**2) / max(mod.df_resid, 1)))
        v = y.values.copy()
        v[miss] = np.maximum(0, pred[miss] + rng.normal(0, sigma, miss.sum()))
        dd["_inc79"] = v
    else:
        dd["_inc79"] = dd["inc79"].values
    return dd

def fit_logit_from_imp(dd):
    sub = dd[dd["age1979"] >= 21].copy()
    pe = np.fmax(sub["_mom_ed"], sub["_dad_ed"])
    ses = np.where(pe < 12, "Low",
          np.where(pe < 16, "Middle", "High"))
    sub["Black"] = (sub["race_lbl"] == "Black").astype(int)
    sub["Hispanic"] = (sub["race_lbl"] == "Hispanic").astype(int)
    sub["SES_Low"] = (ses == "Low").astype(int)
    sub["SES_High"] = (ses == "High").astype(int)
    sub["Black_x_Low"] = sub["Black"] * sub["SES_Low"]
    sub["Black_x_High"] = sub["Black"] * sub["SES_High"]
    sub["Hisp_x_Low"] = sub["Hispanic"] * sub["SES_Low"]
    sub["Hisp_x_High"] = sub["Hispanic"] * sub["SES_High"]
    sub["female"] = (sub["sex"] == 2).astype(int)
    sub["age_c"] = sub["age1979"] - sub["age1979"].mean()
    cols = ["Black", "Hispanic",
            "SES_Low", "SES_High",
            "Black_x_Low", "Black_x_High",
            "Hisp_x_Low", "Hisp_x_High",
            "female", "age_c"]
    X = sm.add_constant(sub[cols].astype(float), has_constant="add")
    y = sub["ba_proxy"].astype(float)
    valid = y.notna()
    Xv = X.loc[valid]; yv = y.loc[valid]
    res = sm.Logit(yv, Xv).fit(disp=False, maxiter=200, method="bfgs")
    return res

imp_cols = ["mom_ed", "dad_ed", "inc79", "race_lbl", "sex",
            "age1979", "hgc", "ba_proxy", "ses_par", "race", "ses_inc"]
coef_list = []
gap_list = []
for m in range(M):
    dd_i = impute_one(df[imp_cols].copy(), seed=42 + m)
    r_i = fit_logit_from_imp(dd_i)
    coef_list.append(r_i.params.values)
    # Compute marginal gaps
    sub = dd_i[dd_i["age1979"] >= 21]
    female_val = (sub["sex"]==2).mean()
    age_c_val = (sub["age1979"] - sub["age1979"].mean()).mean()
    Xcols = list(r_i.params.index); cov_mat = r_i.cov_params().values
    b = r_i.params.values
    row_gaps = []
    for s in ("Low", "Middle", "High"):
        SL = 1.0 if s == "Low" else 0.0
        SH = 1.0 if s == "High" else 0.0
        x0 = np.zeros(len(Xcols)); x0[0]=1.0; x0[3]=SL; x0[4]=SH
        x0[9]=female_val; x0[10]=age_c_val
        x1 = x0.copy(); x1[1]=1.0; x1[5]=SL; x1[6]=SH
        p0 = 1/(1+np.exp(-x0@b)); p1 = 1/(1+np.exp(-x1@b))
        row_gaps.append(p1 - p0)
    gap_list.append(row_gaps)

coefs = np.array(coef_list)
gaps = np.array(gap_list)

def rubin(arr):
    m_ = arr.mean(axis=0)
    var_within = arr.var(axis=0, ddof=1)
    var_between = arr.var(axis=0, ddof=1)
    total = var_within + (1 + 1/M) * var_between
    return m_, np.sqrt(total)

mean_coefs, se_coefs = rubin(coefs)
idx = ["const", "Black", "Hispanic",
       "SES_Low", "SES_High",
       "Black_x_Low", "Black_x_High",
       "Hisp_x_Low", "Hisp_x_High",
       "female", "age_c"]
mi_sum = pd.DataFrame({
    "coef": mean_coefs, "se_Rubin": se_coefs,
    "z": mean_coefs / se_coefs,
    "p_2sided": 2 * (1 - stats.norm.cdf(np.abs(mean_coefs / se_coefs))),
}, index=idx)
print("\nPooled MI coefficients (Rubin):")
print(mi_sum.to_string(float_format=lambda x: f"{x: .5f}"))
mi_sum.to_csv("artifacts/logit_summary_MI.csv")

mean_gaps, se_gaps = rubin(gaps)
mg_mi = pd.DataFrame({
    "ses": ["Low", "Middle", "High"],
    "gap": mean_gaps, "se_Rubin": se_gaps,
    "ci_lo": mean_gaps - 1.96 * se_gaps,
    "ci_hi": mean_gaps + 1.96 * se_gaps,
})
print("\nMI marginal gaps (Black - NBNH) by parental-SES tier:")
print(mg_mi.to_string(float_format=lambda x: f"{x: .5f}"))
mg_mi.to_csv("artifacts/marginal_gaps_MI.csv", index=False)

