def ct_ba(data, ses_col="ses_par", out_lbl="ba_event"):
    rows = []
    for r in ("Black", "NBNH", "Hispanic"):
        for s in ["Low", "Middle", "High", "Missing"]:
            sub = data[(data["race_lbl"] == r) & (data[ses_col] == s)]
            n = sub["ba_proxy"].notna().sum()
            ev = int(sub["ba_proxy"].dropna().sum()) if n else 0
            rate = ev / n if n else np.nan
            rows.append({"race": r, "ses": s, "n_complete": int(n),
                         out_lbl: ev, "ba_rate": rate})
    return pd.DataFrame(rows)

