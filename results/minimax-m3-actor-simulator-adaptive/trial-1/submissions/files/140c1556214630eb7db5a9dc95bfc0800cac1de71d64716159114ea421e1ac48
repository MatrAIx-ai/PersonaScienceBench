"""
DiscoveryBench / archaeology metadata_13 — highest growth phase identification
in 2000–1100 BCE using the supplied time-series, capital and pollen CSVs.

Conventions used (locked in by the researcher):
  * binning C1: century label = |CE| // 100
  * primary growth signal = pollen_grate_100 (100-y %change of interpolated pollen openness)
  * corroborators: g_all_mean (KDE growth rate), cumulative Δ pollen_inter
  * the 1-row "century 20" bin (CE=-2000 only) is dropped from per-century statistics
  * capital.csv used as directional corroboration only
"""
import pandas as pd
import numpy as np

# ---------- 1. Load ----------
ts = pd.read_csv("/workspace/data/time_series_data.csv", index_col=0)
cap = pd.read_csv("/workspace/data/capital.csv", decimal=",")

# ---------- 2. Window 2000–1100 BCE ----------
ts["century"] = (ts["CE"].abs() // 100).astype(int)  # C1
window = ts[(ts["CE"] >= -2000) & (ts["CE"] <= -1100)].copy()
window_full = window[window["century"] != 20].copy()  # drop single-row bin

# ---------- 3. Per-century aggregations ----------
agg = window_full.groupby("century").agg(
    n=("CE", "count"),
    mean_pollen_grate_100=("pollen_grate_100", "mean"),
    median_pollen_grate_100=("pollen_grate_100", "median"),
    max_pollen_grate_100=("pollen_grate_100", "max"),
    pos_sum_pollen_grate=("pollen_grate_100", lambda s: s.clip(lower=0).sum()),
    mean_g_all_mean=("g_all_mean", "mean"),
    max_g_all_mean=("g_all_mean", "max"),
    pollen_inter_start=("pollen_inter", "first"),
    pollen_inter_end=("pollen_inter", "last"),
).assign(pollen_inter_net_delta=lambda d: d["pollen_inter_end"] - d["pollen_inter_start"])
agg.index = [f"{c}00 BCE" for c in agg.index]
agg.index.name = "century"

# ---------- 4. Rank & sustained phase ----------
win_mean = window_full["pollen_grate_100"].mean()
peak = agg["mean_pollen_grate_100"].idxmax()
flag = (agg["mean_pollen_grate_100"] > win_mean).values
runs, cur = [], []
for i, v in enumerate(flag):
    if v: cur.append(agg.index[i])
    else:
        if cur: runs.append(cur); cur = []
if cur: runs.append(cur)
longest_sustained = max(runs, key=len)

# ---------- 5. Capital.csv corroboration ----------
cap_w = cap[(cap["BCE"] >= 1100) & (cap["BCE"] <= 2000)].sort_values("BCE").copy()
z_cols = [c for c in cap_w.columns if c.startswith("Z")]
cap_w["Zmean"] = cap_w[z_cols].mean(axis=1)

# ---------- 6. C2 sensitivity check ----------
ts2 = ts.copy()
ts2["century_C2"] = ((ts2["CE"].abs() + 99) // 100).astype(int)
w2 = ts2[(ts2["CE"] >= -2000) & (ts2["CE"] <= -1100)]
w2 = w2[w2["century_C2"] != 20]
peak_C2_label = f"{w2.groupby('century_C2')['pollen_grate_100'].mean().idxmax()}00 BCE"

# ---------- 7. Reporting ----------
print(agg.to_string())
print(f"\nWindow mean pollen_grate_100 : {win_mean:.6f}")
print(f"Peak century (C1)            : {peak}")
print(f"Longest sustained run above mean: {longest_sustained}")
print(f"Peak century under C2 convention: {peak_C2_label}")
print(cap_w[["BCE","group","Zmean"]+z_cols].to_string(index=False))
