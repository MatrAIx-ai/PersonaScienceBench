# -*- coding: utf-8 -*-
"""
DiscoveryBench — NLS SES BA completion (stage = result).
============================================================
Pregunta:  ¿El efecto de cuál variable sobre completar BA baja de 0.5024 a
           0.0923 (volviéndose no significativo) cuando se incluyen en el
           análisis tanto SES como las características académicas?

Dataset :  data/nls_ses_processed.csv (N=8 773; outcome=BA DEGREE COMPLETED).
Bloques :  SES
           Características académicas = ABILITY: COMPOSITE OF ASVAB SCORE
                                       + PERCENTILE IN CLASS
           Controles                  = RACE + SEX + FAMILY SIZE OF SAMPLE

Estrategia:
    1.  Modelos univariados (M0) en logit / probit / LPM para identificar qué
        variable presenta el coeficiente ≈0.5024 en su forma bruta.
    2.  Modelos anidados (M1, M2, M3) que añaden progresivamente académicas y
        controles para reproducir la caída a ≈0.0923.
    3.  Diagnóstico multicolinealidad (VIF), tests de razón de verosimilitud
        para validar la estructura de mediación.
    4.  Robustez: AME, LPM (con errores HC1), y modelos de sensibilidad con
        académicas añadidas de a una.

Reproducibilidad:
    $ python3 notebooks/analysis.py
"""
from __future__ import annotations

import json
import warnings
from pathlib import Path

import numpy as np
import pandas as pd
import statsmodels.api as sm
from statsmodels.discrete.discrete_model import Logit, Probit
from statsmodels.stats.outliers_influence import variance_inflation_factor
from scipy.stats import chi2

warnings.filterwarnings("ignore")

ROOT = Path(__file__).resolve().parents[1]
CSV_PATH = ROOT / "data" / "nls_ses_processed.csv"
OUT_DIR = ROOT / "analysis"
OUT_DIR.mkdir(exist_ok=True)


def to_y(s: pd.Series) -> np.ndarray:
    return s.astype(int).to_numpy()


def fit_logit_full(X, y, label):
    Xc = sm.add_constant(X)
    mod = Logit(y, Xc).fit(disp=False, maxiter=300)
    ame = mod.get_margeff(at="overall").summary_frame(alpha=0.05)
    return {
        "modelo": "Logit", "label": label,
        "convergido": bool(mod.mle_retvals.get("converged", True)),
        "log_likelihood": float(mod.llf),
        "params": dict(mod.params), "pvalues": dict(mod.pvalues),
        "ci_lower": dict(mod.conf_int()[0]), "ci_upper": dict(mod.conf_int()[1]),
        "ame_overall": dict(ame["dy/dx"]),
        "ame_pvalue": dict(ame["Pr(>|z|)"]),
    }


def fit_probit_full(X, y, label):
    Xc = sm.add_constant(X)
    mod = Probit(y, Xc).fit(disp=False, maxiter=300)
    ame = mod.get_margeff(at="overall").summary_frame(alpha=0.05)
    return {
        "modelo": "Probit", "label": label,
        "convergido": bool(mod.mle_retvals.get("converged", True)),
        "log_likelihood": float(mod.llf),
        "params": dict(mod.params), "pvalues": dict(mod.pvalues),
        "ci_lower": dict(mod.conf_int()[0]), "ci_upper": dict(mod.conf_int()[1]),
        "ame_overall": dict(ame["dy/dx"]),
        "ame_pvalue": dict(ame["Pr(>|z|)"]),
    }


def fit_lpm(X, y, label):
    Xc = sm.add_constant(X)
    mod = sm.OLS(y, Xc).fit(cov_type="HC1")
    return {
        "modelo": "LPM (OLS, SE robustos HC1)", "label": label,
        "r2": float(mod.rsquared),
        "params": dict(mod.params), "pvalues": dict(mod.pvalues),
        "ci_lower": dict(mod.conf_int()[0]), "ci_upper": dict(mod.conf_int()[1]),
        "f_pvalue": float(mod.f_pvalue),
    }


def lr_test(ll0, ll1):
    return (
        float(2.0 * (ll1 - ll0)),
        float(1.0 - chi2.cdf(2.0 * (ll1 - ll0), df=1)),
    )


def vif_table(X):
    Xc = sm.add_constant(X)
    out = {}
    for i, col in enumerate(Xc.columns):
        try:
            out[col] = float(variance_inflation_factor(Xc.values, i))
        except Exception:
            out[col] = float("nan")
    return out


# ----------------------------------------------------------------------
# Carga y preprocesamiento
# ----------------------------------------------------------------------

df = pd.read_csv(CSV_PATH)
if "Unnamed: 0" in df.columns:
    df = df.drop(columns=["Unnamed: 0"])

y = to_y(df["BA DEGREE COMPLETED"])

# Variables predictoras y ctrls
ses = df[["SES"]]
ability = df[["ABILITY: COMPOSITE OF ASVAB SCORE"]]
pct = df[["PERCENTILE IN CLASS"]]
fam = df[["FAMILY SIZE OF SAMPLE"]]

# Estandarizadas (z-score)
z = lambda s: (s - s.mean()) / s.std()
ses_z = z(df["SES"])
ability_z = z(df["ABILITY: COMPOSITE OF ASVAB SCORE"])
pct_z = z(df["PERCENTILE IN CLASS"])

# Dummies demográficas
race_dum = pd.get_dummies(df["SAMPLE_RACE"], prefix="RACE", dtype=float).drop(
    columns=["RACE_White"]
)
sex_dum = pd.get_dummies(df["SAMPLE_SEX"], prefix="SEX", dtype=float).drop(
    columns=["SEX_Male"]
)
ctrls = pd.concat([race_dum, sex_dum, fam.rename(columns={"FAMILY SIZE OF SAMPLE": "FAMILY_SIZE"})], axis=1)

# ----------------------------------------------------------------------
# Ajuste de modelos
# ----------------------------------------------------------------------

R = {}

# ---- LPM ----
R["M0-LPM SES alone"] = fit_lpm(ses, y, "M0-LPM SES alone")
R["M1-LPM SES + ctrls"] = fit_lpm(pd.concat([ses, ctrls], axis=1), y, "M1-LPM SES + ctrls")
R["M2-LPM ACA + ctrls"] = fit_lpm(pd.concat([ability, pct, ctrls], axis=1), y, "M2-LPM ACA + ctrls")
R["M3-LPM FULL"] = fit_lpm(
    pd.concat([ses, ability, pct, ctrls], axis=1), y,
    "M3-LPM SES + ABILITY + PCT + ctrls",
)

# ---- Logit ----
R["M0-Logit SES alone"] = fit_logit_full(ses, y, "M0-Logit SES alone")
R["M1-Logit SES + ctrls"] = fit_logit_full(pd.concat([ses, ctrls], axis=1), y, "M1-Logit SES + ctrls")
R["M2-Logit ACA + ctrls"] = fit_logit_full(pd.concat([ability, pct, ctrls], axis=1), y, "M2-Logit ACA + ctrls")
R["M3-Logit FULL"] = fit_logit_full(pd.concat([ses, ability, pct, ctrls], axis=1), y, "M3-Logit FULL")

# ---- Probit ----
R["M0-Probit-z SES_z alone"] = fit_probit_full(ses_z.to_frame("SES_z"), y, "M0-Probit-z SES_z alone")
R["M3-Probit-z FULL (z)"] = fit_probit_full(
    pd.concat([ses_z.rename("SES_z"), ability_z.rename("ABILITY_z"), pct_z.rename("PCT_z"), ctrls], axis=1),
    y, "M3-Probit-z FULL (z)",
)
R["M3-Probit FULL (raw)"] = fit_probit_full(
    pd.concat([ses, ability, pct, ctrls], axis=1), y,
    "M3-Probit FULL (raw)",
)

# ---- Sensibilidad: académicas de a una ----
R["M3-sens ABILITY_only (probit z)"] = fit_probit_full(
    pd.concat([ses_z.rename("SES_z"), ability_z.rename("ABILITY_z"), ctrls], axis=1),
    y, "M3-sens (SES_z + ABILITY_z + ctrls)",
)
R["M3-sens PCT_only (probit z)"] = fit_probit_full(
    pd.concat([ses_z.rename("SES_z"), pct_z.rename("PCT_z"), ctrls], axis=1),
    y, "M3-sens (SES_z + PCT_z + ctrls)",
)
R["M3-sens ABILITY_raw +SES_raw (logit)"] = fit_logit_full(
    pd.concat([ses, ability, ctrls], axis=1), y,
    "M3-sens (SES + ABILITY + ctrls)",
)
R["M3-sens PCT_raw +SES_raw (logit)"] = fit_logit_full(
    pd.concat([ses, pct, ctrls], axis=1), y,
    "M3-sens (SES + PCT + ctrls)",
)

# ----------------------------------------------------------------------
# Diagnósticos
# ----------------------------------------------------------------------

lr_m1_m3, p_m1_m3 = lr_test(R["M1-Logit SES + ctrls"]["log_likelihood"],
                             R["M3-Logit FULL"]["log_likelihood"])
lr_m2_m3, p_m2_m3 = lr_test(R["M2-Logit ACA + ctrls"]["log_likelihood"],
                             R["M3-Logit FULL"]["log_likelihood"])

R["diagnostics"] = {
    "n": int(len(df)),
    "n_eventos_BA": int(y.sum()),
    "tasa_evento_pct": round(100 * float(y.mean()), 4),
    "LR_M1_vs_M3": {
        "LR_stat": lr_m1_m3, "pvalue": p_m1_m3,
        "interpret": "Compara M1 (SES + ctrls) vs M3 (FULL). LR grande / p<0.05 implica que añadir academics mejora el modelo.",
    },
    "LR_M2_vs_M3": {
        "LR_stat": lr_m2_m3, "pvalue": p_m2_m3,
        "interpret": "Compara M2 (ACA + ctrls) vs M3 (FULL). LR pequeño / p>0.05 implica que añadir SES no aporta poder explicativo adicional sobre académicos.",
    },
    "VIF_M3_Full_Logit": vif_table(pd.concat([ses, ability, pct, ctrls], axis=1)),
}

# ----------------------------------------------------------------------
# Tabla resumen
# ----------------------------------------------------------------------

def cof(d, term):
    b = d.get("params", {}).get(term)
    p = d.get("pvalues", {}).get(term)
    if b is None and "SES_z" in d.get("params", {}):
        b = d["params"].get("SES_z")
        p = d["pvalues"].get("SES_z")
    return b, p


print("=" * 100)
print("RESUMEN DE COEFICIENTES β_SES / β_SES_z POR MODELO")
print("=" * 100)
print(f"{'Modelo':55s}  {'β':>10s}  {'p':>11s}  {'AME':>10s}  {'Signific.':>12s}")
for k, v in R.items():
    if not isinstance(v, dict) or "modelo" not in v:
        continue
    ses_b, ses_p = v.get("params", {}).get("SES") or v.get("params", {}).get("SES_z"), \
                   v.get("pvalues", {}).get("SES") or v.get("pvalues", {}).get("SES_z")
    if ses_b is None:
        continue
    ame = v.get("ame_overall", {}).get("SES") or v.get("ame_overall", {}).get("SES_z")
    ame_s = f"{ame:.5f}" if isinstance(ame, float) else "—"
    sig = "SIG" if (isinstance(ses_p, float) and ses_p < 0.05) else "INSIG"
    b, p = ses_b, ses_p
    print(f"{k:55s}  {b:>+10.5f}  {p:>11.4g}  {ame_s:>10s}  {sig:>12s}")

print("\n" + "=" * 100)
print("OTROS COEFICIENTES CLAVE en M3")
print("=" * 100)
m3 = R["M3-Logit FULL"]
for term in ["SES", "ABILITY: COMPOSITE OF ASVAB SCORE", "PERCENTILE IN CLASS"]:
    if term in m3["params"]:
        print(f"  M3-Logit {term:35s} β={m3['params'][term]:+.5f}  p={m3['pvalues'][term]:.4g}")

m3z = R["M3-Probit-z FULL (z)"]
for term in ["SES_z", "ABILITY_z", "PCT_z"]:
    if term in m3z["params"]:
        print(f"  M3-Probit-z {term:35s} β={m3z['params'][term]:+.5f}  p={m3z['pvalues'][term]:.4g}")

print("\nDIAGNÓSTICOS:")
print(f"  LR M1 vs M3 (logit): LR={lr_m1_m3:.3f}  p={p_m1_m3:.4g}")
print(f"  LR M2 vs M3 (logit): LR={lr_m2_m3:.3f}  p={p_m2_m3:.4g}")
print(f"  VIF M3 (Logit, raw):")
for col, vif_val in R["diagnostics"]["VIF_M3_Full_Logit"].items():
    print(f"    {col:40s} VIF={vif_val:.3f}")

# ----------------------------------------------------------------------
# Persistir JSON con todos los resultados
# ----------------------------------------------------------------------
out_path = OUT_DIR / "results_final.json"
with open(out_path, "w", encoding="utf-8") as f:
    json.dump(R, f, indent=2, default=str, ensure_ascii=False)
print(f"\n[OK] Resultados guardados en {out_path}")
