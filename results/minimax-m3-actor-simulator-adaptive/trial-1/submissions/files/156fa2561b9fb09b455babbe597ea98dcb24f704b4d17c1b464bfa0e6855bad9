"""
NLSY79 /data/nls_raw.csv — median FAMILY net wealth by race, per wave.

Approach (per the approved plan):
- Race groups (column 'Racial/ethnic cohort, 1979'):
    1 BLACK, 2 HISPANIC, 3 NON-BLACK NON-HISPANIC (treated as 'white' reference).
- Wealth: 'Family net wealth, 1985', 'Family net wealth, 1990',
          'Family net wealth, 1996 (key data point)'.
- Per (year, race) cell, complete-case, UNWEIGHTED median.
- Bootstrap 95% percentile CI on each median, B = 1000, fixed seed.
- Negative wealths kept as-is (no winsorize / floor).
- Additional outputs: per-cell n, share of negative-wealth observations,
  white - Black and white - Hispanic median gaps and ratios.
"""
import os, json, numpy as np, pandas as pd

DATA = "/workspace/data/nls_raw.csv"
RNG = np.random.default_rng(20261021)
B = 1000  # bootstrap replications per cell

df = pd.read_csv(DATA)

race_col = "Racial/ethnic cohort, 1979"
race_map = {1: "BLACK", 2: "HISPANIC", 3: "NON-BLACK NON-HISPANIC (white)"}
df["race_label"] = df[race_col].map(race_map)

wealth_cols = {
    1985: "Family net wealth, 1985",
    1990: "Family net wealth, 1990",
    1996: "Family net wealth, 1996 (key data point)",
}

def bootstrap_median_ci(x, B=1000, alpha=0.05, rng=None):
    x = np.asarray(x, dtype=float)
    n = len(x)
    idx = rng.integers(0, n, size=(B, n)) if rng is not None else np.random.randint(0, n, size=(B, n))
    meds = np.median(x[idx], axis=1)
    lo = float(np.quantile(meds, alpha / 2))
    hi = float(np.quantile(meds, 1 - alpha / 2))
    return float(np.median(x)), lo, hi

rows = []
per_cell = {}
for yr, col in wealth_cols.items():
    for rcode in [1, 2, 3]:
        sub = df.loc[df[race_col] == rcode, col].dropna()
        n = int(len(sub))
        share_neg = float((sub < 0).mean()) if n else float("nan")
        if n == 0:
            med = lo = hi = float("nan")
        else:
            med, lo, hi = bootstrap_median_ci(sub.values, B=B, rng=RNG)
        per_cell[(yr, rcode)] = dict(n=n, median=med, lo=lo, hi=hi, share_neg=share_neg)
        rows.append({
            "year": yr,
            "race": race_map[rcode],
            "n": n,
            "share_negative_wealth": round(share_neg, 4),
            "median_$_nominal": round(med) if not np.isnan(med) else None,
            "ci_lo": round(lo) if not np.isnan(lo) else None,
            "ci_hi": round(hi) if not np.isnan(hi) else None,
        })

table_per_cell = pd.DataFrame(rows)
print("=== Per (year, race) cell — n, share-negative, median and 95% bootstrap CI ===")
print(table_per_cell.to_string(index=False))
print()

# Pivot to per-year comparison rows
gap_rows = []
for yr in [1985, 1990, 1996]:
    w = per_cell[(yr, 3)]["median"]
    b = per_cell[(yr, 1)]["median"]
    h = per_cell[(yr, 2)]["median"]
    nw, nb, nh = per_cell[(yr, 3)]["n"], per_cell[(yr, 1)]["n"], per_cell[(yr, 2)]["n"]
    gap_rows.append({
        "year": yr,
        "n_white": nw,
        "n_black": nb,
        "n_hispanic": nh,
        "median_white_$_nominal": None if w is None or np.isnan(w) else round(w),
        "median_black_$_nominal": None if b is None or np.isnan(b) else round(b),
        "median_hispanic_$_nominal": None if h is None or np.isnan(h) else round(h),
        "gap_white_minus_black_$": None if (w is None or b is None or np.isnan(w) or np.isnan(b)) else round(w - b),
        "gap_white_minus_hispanic_$": None if (w is None or h is None or np.isnan(w) or np.isnan(h)) else round(w - h),
        "ratio_white_to_black": None if (w is None or b is None or np.isnan(w) or np.isnan(b) or b == 0) else round(w / b, 2),
        "ratio_white_to_hispanic": None if (w is None or h is None or np.isnan(w) or np.isnan(h) or h == 0) else round(w / h, 2),
    })
gap_table = pd.DataFrame(gap_rows)
print("=== Per-year comparison: medians, gaps, ratios (nominal $) ===")
print(gap_table.to_string(index=False))
print()

# Flag small-n cells
small_n = [r for r in rows if r["n"] < 100]
print(f"=== Cells with n < 100: {len(small_n)} ===")
for r in small_n:
    print(f"  year={r['year']}, race={r['race']}, n={r['n']}")

# Save outputs
os.makedirs("/workspace/artifacts", exist_ok=True)
table_per_cell.to_csv("/workspace/artifacts/per_cell_medians.csv", index=False)
gap_table.to_csv("/workspace/artifacts/per_year_comparison.csv", index=False)
with open("/workspace/artifacts/analysis_settings.json", "w") as f:
    json.dump({"B_bootstrap": B, "seed": 20261021,
               "weighting": "unweighted",
               "missing_treatment": "complete-case per (year, race)",
               "negative_wealth_treatment": "retained (no winsorize / no floor)",
               "currency": "nominal $",
               "race_white_definition": "Racial/ethnic cohort == 3 (NON-BLACK NON-HISPANIC)"}, f, indent=2)

print("\nArtifacts written to /workspace/artifacts/")
