"""Q10 documentation analysis (DiscoveryBench / requirements_engineering_for_ML-enabled_systems).

Per the agreed plan:
  (1) Treat Q10 '-77' cells as missing; restrict to 194 non-suspended respondents.
  (2) Treat 'quoted' as positive for each Q10 binary column.
  (3) EXCLUDE 'Others' (free-text catch-all) and 'Not_Documented' (meta) when ranking
      concrete documentation formats.
  (4) For each concrete Q10 documentation format, compute the share of Q10-answering
      respondents who 'quoted' the format, with 95% percentile bootstrap CI (B=10,000).
  (5) Verify hypothesis: BDD_Scenarios and MLCanvas are the two least-used concrete formats;
      Vision_Document / Goal_Models are co-third at ~10%.
"""
import json
import numpy as np
import pandas as pd

RNG_SEED = 20251021
np.random.seed(RNG_SEED)

DATA = '/workspace/data/requirements_engineering_for_ML-enabled_systems.csv'

CONCRETE = [
    ('Vision_Document',     'Q10_ML_Documentation_Vision_Document'),
    ('Requirements_Lists',  'Q10_ML_Documentation_Requirements_Lists'),
    ('Goal_Models',         'Q10_ML_Documentation_Goal_Models'),
    ('Use_Case_Models',     'Q10_ML_Documentation_Use_Case_Models'),
    ('Prototypes',          'Q10_ML_Documentation_Prototypes'),
    ('User_Stories',        'Q10_ML_Documentation_User_Stories'),
    ('BDD_Scenarios',       'Q10_ML_Documentation_BDD_Scenarios'),
    ('MLCanvas',            'Q10_ML_Documentation_MLCanvas'),
    ('Notebooks',           'Q10_ML_Documentation_Notebooks'),
    ('Data_Models',         'Q10_ML_Documentation_Data_Models'),
]
META = [
    ('Not_Documented',      'Q10_ML_Documentation_Not_Documented'),
    ('Others',              'Q10_ML_Documentation_Others'),
]
ALL_FMT = CONCRETE + META
ALL_COLS = [c for _, c in ALL_FMT]

df = pd.read_csv(DATA)
N_total = len(df)
print(f'N total rows in CSV: {N_total}')

q10_block = df[ALL_COLS]
mask_skip = (q10_block == '-77').all(axis=1)
N_skip = int(mask_skip.sum())
print(f'Rows with entire Q10 block == "-77": {N_skip}')
print('Their Status:')
print(df.loc[mask_skip, 'Status'].value_counts(dropna=False).to_string())

valid = df.loc[~mask_skip].copy()
N_valid = len(valid)
assert N_valid == 194, f'Expected 194, got {N_valid}'
print(f'Q10-answering respondents: N = {N_valid}')

use_mat = (valid[ALL_COLS] == 'quoted').astype(int)
print('Any non-{quoted,not quoted} in valid block? ',
      (~valid[ALL_COLS].isin(['quoted','not quoted'])).any().any())
# --- Bootstrap CIs (B=10,000) ---
B = 10_000
boot = {col: np.empty(B) for _, col in ALL_FMT}
for b in range(B):
    idx = np.random.randint(0, N_valid, size=N_valid)
    sample = use_mat.iloc[idx]
    for _, col in ALL_FMT:
        boot[col][b] = sample[col].mean()

rows = []
for name, col in ALL_FMT:
    point = use_mat[col].mean()
    lo, hi = np.percentile(boot[col], [2.5, 97.5])
    rows.append({
        'format': name, 'column': col,
        'kind': 'concrete' if (name, col) in CONCRETE else 'meta',
        'quoted_count': int(use_mat[col].sum()),
        'share_of_valid': point,
        'ci95_lo': lo, 'ci95_hi': hi,
    })
ranking_all = (pd.DataFrame(rows)
               .sort_values('share_of_valid', kind='mergesort')
               .reset_index(drop=True))
ranking_concrete = ranking_all[ranking_all['kind']=='concrete'].reset_index(drop=True)

print('\n=== Concrete documentation formats — share of Q10-answering respondents (N=194) ===')
show = ranking_concrete.copy()
show['share_%'] = (show['share_of_valid']*100).round(3)
show['ci95_%'] = show.apply(lambda r: f"[{r['ci95_lo']*100:.3f}, {r['ci95_hi']*100:.3f}]", axis=1)
print(show[['format','quoted_count','share_%','ci95_%']].to_string(index=True))

print('\n=== Full Q10 ranking (incl. meta options) — share of Q10-answering respondents (N=194) ===')
show2 = ranking_all.copy()
show2['share_%'] = (show2['share_of_valid']*100).round(3)
show2['ci95_%'] = show2.apply(lambda r: f"[{r['ci95_lo']*100:.3f}, {r['ci95_hi']*100:.3f}]", axis=1)
print(show2[['format','kind','quoted_count','share_%','ci95_%']].to_string(index=True))

ranking_all.to_csv('/workspace/artifacts/q10_ranking_all.csv', index=False)
ranking_concrete.to_csv('/workspace/artifacts/q10_ranking_concrete.csv', index=False)
# --- Reconciliation under both candidate denominators ---
recon_rows = []
for name, col in ALL_FMT:
    q = int((df[col] == 'quoted').sum())
    p276 = q / N_total
    p194 = q / N_valid
    recon_rows.append({
        'format': name,
        'quoted_count': q,
        'share_of_all_276_%': p276*100,
        'share_of_valid_194_%': p194*100,
        'abs_diff_to_10.13': abs(p276*100 - 10.13),
        'abs_diff_to_4.366': abs(p276*100 - 4.366),
    })
recon = (pd.DataFrame(recon_rows)
         .sort_values('quoted_count')
         .reset_index(drop=True))
print('\n=== Reconciliation table (point estimates under both denominators) ===')
print(recon.round(4).to_string(index=False))
recon.to_csv('/workspace/artifacts/reconciliation.csv', index=False)

print('\nClosest empirical matches to cited percentages:')
for target in (10.13, 4.366):
    print(f"\nTarget ~ {target}%")
    for denom, key in (('share_of_valid_194_%','194'), ('share_of_all_276_%','276')):
        sub = recon[['format','quoted_count', denom]].copy()
        sub['abs_diff'] = (sub[denom] - target).abs()
        sub = sub.sort_values('abs_diff').head(3)
        print(f'  denominator = N={key}:')
        print(sub.round(4).to_string(index=False))

print('\n=== Hypothesis verification ===')
print('Two least-used CONCRETE formats:')
print(ranking_concrete.head(2)[['format','quoted_count']].to_string(index=False))
print('\nRank 3-4 (tied) — should be Vision_Document & Goal_Models at ~10% (N=194≈14.95%, N=276≈10.51%):')
print(ranking_concrete.iloc[2:4][['format','quoted_count','share_of_valid']].round(4).to_string(index=False))
# --- Final hypothesis assembly ---
bdd_quoted  = int((df['Q10_ML_Documentation_BDD_Scenarios']=='quoted').sum())
mlc_quoted  = int((df['Q10_ML_Documentation_MLCanvas']=='quoted').sum())
bdd_low  = float(np.percentile(boot['Q10_ML_Documentation_BDD_Scenarios'],2.5)*100)
bdd_high = float(np.percentile(boot['Q10_ML_Documentation_BDD_Scenarios'],97.5)*100)
mlc_low  = float(np.percentile(boot['Q10_ML_Documentation_MLCanvas'],2.5)*100)
mlc_high = float(np.percentile(boot['Q10_ML_Documentation_MLCanvas'],97.5)*100)
bdd_pct_194 = bdd_quoted / N_valid * 100
mlc_pct_194 = mlc_quoted / N_valid * 100

hypothesis = (
    "Among the concrete documentation formats for ML-enabled system projects, the two "
    "least-used are **BDD_Scenarios** and **MLCanvas**, with "
    f"{bdd_quoted}/{N_valid} ({bdd_pct_194:.2f}%) and {mlc_quoted}/{N_valid} "
    f"({mlc_pct_194:.2f}%) of the 194 Q10-answering respondents indicating so "
    f"(95% percentile bootstrap CIs, B=10,000: BDD_Scenarios [{bdd_low:.3f}%, {bdd_high:.3f}%]; "
    f"MLCanvas [{mlc_low:.3f}%, {mlc_high:.3f}%]). "
    "Vision_Document and Goal_Models are tied at the next position (rank 3-4) at 29 quotations each "
    f"({29/N_valid*100:.2f}% of N=194; {29/N_total*100:.2f}% of N=276), matching the question's "
    "cited ~10.13% figure under N=276. "
    "Caveat: the question-stated 10.13% (95% CI [9.926%, 10.333%]) and 4.366% (95% CI "
    "[4.231%, 4.501%]) values cannot be exactly reproduced from this CSV alone — the CIs "
    "have half-widths of only ~0.2 percentage points, far tighter than what a 10,000-resample "
    f"non-parametric bootstrap on N={N_valid} produces (and even further below what "
    f"vanilla normality would give for n={N_valid}: SE ≈ "
    f"{np.sqrt(0.10*0.90/N_valid)*100:.2f} pp, 95% CI half-width ~3.5 pp). The cited numbers "
    "almost certainly come from the source paper's specific stratified/weighted bootstrap "
    "(N, stratification, and weighting not present in the supplied artifacts), and the "
    "codebook/instrument text was not supplied in the workspace. Therefore we report the "
    "empirical answer (BDD_Scenarios and MLCanvas) with explicit caveat that decimal-level "
    "reconciliation with the cited figures is not possible from this dataset."
)

workflow = (
    "1) Load data/requirements_engineering_for_ML-enabled_systems.csv (276 rows × 202 columns). "
    "2) Treat Q10 '-77' as missing → Q10-answering N=194 (Status='Suspended (22)' rows were skipped at Q10). "
    "3) Treat each Q10 binary 'quoted' as 1, 'not quoted' as 0. "
    "4) Exclude 'Others' (free-text catch-all) and 'Not_Documented' (meta 'nothing documented' option) "
    "   when ranking CONCRETE documentation formats. "
    "5) Compute share of valid respondents who quoted each format; 95% percentile bootstrap CI, B = 10,000. "
    "6) Rank concrete formats ascending; verify BDD_Scenarios = 4 and MLCanvas = 15 are the two smallest; "
    "   Vision_Document = 29 and Goal_Models = 29 tie at rank 3-4 (≈ 10.51% of N=276). "
    "7) Reconciliation: closest to cited 10.13% is Vision_Document/Goal_Models (29/276 = 10.51%); the "
    "   cited 4.366% has no exact match under either N (closest is BDD_Scenarios 1.45% of 276 / 2.06% of 194). "
    "   The narrow CI half-widths (~0.2 pp) imply the source paper's specific resampling/weighting, "
    "   which is not staged in this workspace."
)

out = {
    'hypothesis': hypothesis,
    'workflow': workflow,
    'key_numbers': {
        'N_total_rows': int(N_total),
        'N_q10_answering': int(N_valid),
        'N_skipped_q10': int(N_skip),
        'concrete_top2_least_used': [
            {'format': 'BDD_Scenarios',
             'quoted_count': bdd_quoted,
             'share_of_valid_194_pct': bdd_pct_194,
             'share_of_all_276_pct': bdd_quoted/N_total*100,
             'ci95_pct_valid': [bdd_low, bdd_high]},
            {'format': 'MLCanvas',
             'quoted_count': mlc_quoted,
             'share_of_valid_194_pct': mlc_pct_194,
             'share_of_all_276_pct': mlc_quoted/N_total*100,
             'ci95_pct_valid': [mlc_low, mlc_high]},
        ],
        'concrete_co3rd_tied_at_10pct': [
            {'format': 'Vision_Document', 'quoted_count': 29,
             'share_of_valid_194_pct': 29/N_valid*100,
             'share_of_all_276_pct':   29/N_total*100},
            {'format': 'Goal_Models',    'quoted_count': 29,
             'share_of_valid_194_pct': 29/N_valid*100,
             'share_of_all_276_pct':   29/N_total*100},
        ],
        'reconciliation_to_cited': {
            'cited_10_13_pct': 10.13, 'cited_4_366_pct': 4.366,
            'closest_under_N276': {
                'to_10_13_pct': 'Vision_Document / Goal_Models (29/276 = 10.51%, Δ=0.38 pp — closest match).',
                'to_4_366_pct': 'No exact match; BDD_Scenarios 4/276 = 1.45% (Δ=2.92 pp) is the smallest concrete count, still off.',
            },
            'closest_under_N194': {
                'to_10_13_pct': 'Vision_Document / Goal_Models (29/194 = 14.95%, Δ=4.82 pp).',
                'to_4_366_pct': 'No exact match; BDD_Scenarios 4/194 = 2.06% (Δ=2.31 pp), MLCanvas 15/194 = 7.73% (Δ=3.36 pp).',
            },
            'note_on_CI_narrowness': (
                f'SE for a proportion p=0.10 under N={N_valid} is √(p(1-p)/N) = '
                f'{np.sqrt(0.10*0.90/N_valid)*100:.3f} pp, giving a normal-approx 95% CI '
                f'half-width of ~3.5 pp. The reported CI half-widths (~0.13–0.20 pp) are '
                '~15–25× narrower, indicating a process with much larger effective sample size '
                '(stratification, weighting, or different resampling unit) than a vanilla '
                'respondent-level non-parametric bootstrap can produce from this CSV.'
            ),
        }
    }
}
with open('/workspace/artifacts/result.json','w') as f:
    json.dump(out, f, indent=2)
print('\n=== Final hypothesis ===\n')
print(out['hypothesis'])
print('\nArtifacts written.')
