import pandas as pd, numpy as np, json, warnings
warnings.filterwarnings('ignore')
from scipy.stats import chi2, pearsonr
import statsmodels.api as sm
from statsmodels.genmod.families import Binomial
from statsmodels.genmod.families.links import Logit

def auc_man(y,p):
    y=np.asarray(y); p=np.asarray(p); pos=p[y==1]; neg=p[y==0]
    if len(pos)==0 or len(neg)==0: return np.nan
    n1,n0=len(pos),len(neg); c=np.concatenate([pos,neg])
    o=np.argsort(c, kind='mergesort'); s=c[o]; r=np.empty_like(o, dtype=float); i=0
    while i<len(c):
        j=i
        while j<len(c) and s[j]==s[i]: j+=1
        r[o[i:j]] = (i+j-1)/2 + 1
        i=j
    return (r[:n1].sum() - n1*(n1+1)/2) / (n1*n0)
def brier(y,p): return float(np.mean((np.asarray(p)-np.asarray(y))**2))
def mcfadden(mod,y):
    null = sm.GLM(y, np.ones((len(y),1)), family=Binomial()).fit(disp=False).llf
    return 1 - mod.llf/null
def fit(X,y):
    if isinstance(X, pd.DataFrame):
        Xc = sm.add_constant(X, has_constant='add')
    else:
        Xc = np.column_stack([np.ones(X.shape[0]), X])
    return sm.GLM(y, Xc, family=Binomial(link=Logit())).fit(disp=False)

# -------------- LOAD + DEDUP --------------
df_raw = pd.read_csv('/workspace/data/nls_bmi_processed.csv')
key = ['GENDER','AGE','AGE_2','INCOME','DISSAVED','SAMESAVE','BMI','BLACK','HISPANIC']
df = df_raw.drop_duplicates(subset=key).reset_index(drop=True)
n_raw, n_dd = len(df_raw), len(df)
dr_raw, dr_dd = df_raw['DISSAVED'].mean(), df['DISSAVED'].mean()
print(f"n_raw={n_raw}  n_dedup={n_dd}  DISSAVED_raw={dr_raw:.4f}  DISSAVED_dedup={dr_dd:.4f}")
print(f"Pearson(AGE,DISSAVED) raw={pearsonr(df_raw['AGE'], df_raw['DISSAVED'])[0]:+.4f}  dedup={pearsonr(df['AGE'], df['DISSAVED'])[0]:+.4f}")

df['FEMALE'] = (df['GENDER']=='FEMALE').astype(int)
df['log_INC'] = np.log1p(df['INCOME'])
y = df['DISSAVED'].values

def rcs(age, knots):
    a = np.asarray(age, float); tj,tk,tl = knots[0], knots[-2], knots[-1]
    u=np.maximum(a-tj,0)**2; v1=np.maximum(a-tk,0)**2; v2=np.maximum(a-tl,0)**2
    return (u - v1*(tl-tj)/(tl-tk) - v2*(tj-tk)/(tl-tk))
KNOTS = [26,28,30]
df['age_spline'] = rcs(df['AGE'].values, KNOTS)

# Models (DataFrames so column names preserved)
specs = {
    'M1':         df[['AGE']],
    'M2':         df[['AGE','FEMALE','BLACK','HISPANIC']],
    'M3':         df[['AGE','INCOME','log_INC','FEMALE','BLACK','HISPANIC']],
    'M3b_log':    df[['AGE','log_INC','FEMALE','BLACK','HISPANIC']],
    'M4_spline':  df[['AGE','age_spline','INCOME','log_INC','FEMALE','BLACK','HISPANIC']],
}
fits = {n: fit(X,y) for n,X in specs.items()}

print("\nBeta(AGE) per model:")
for n,m in fits.items():
    names = m.model.exog_names
    print(f"  {n:12s} beta_AGE={m.params.iloc[names.index('AGE')]:+.5f}  p={m.pvalues.iloc[names.index('AGE')]:.4f}")

print("\nDiagnostics:")
for n,m in fits.items():
    Xc = sm.add_constant(specs[n], has_constant='add')
    p = m.predict(Xc)
    print(f"  {n:12s}  AUC={auc_man(y,p):.5f}  Brier={brier(y,p):.5f}  McFadden={mcfadden(m,y):.5f}  AIC={m.aic:.2f}")

bt = (df['AGE'].values * np.log(df['AGE'].values))
m_bt = fit(pd.concat([specs['M2'], pd.Series(bt, name='AGE_logAGE', index=specs['M2'].index)], axis=1), y)
lr_bt = -2*(fits["M2"].llf - m_bt.llf)
lr_34 = -2*(fits["M3"].llf - fits["M4_spline"].llf)
print(f"\nBox-Tidwell (M2 + AGE*lnAGE): chi2={lr_bt:.3f} p={chi2.sf(lr_bt,1):.4f}")
print(f"Spline vs linear (M3 vs M4): chi2={lr_34:.4f} p={chi2.sf(lr_34,1):.4f}")

# Predicted curves
age_grid = np.arange(24, 32.01, 0.5)
INC_med = float(df['INCOME'].median())
modes = {c:int(df[c].mode().iloc[0]) for c in ['FEMALE','BLACK','HISPANIC']}

def newX(cols, ages):
    d = pd.DataFrame(index=range(len(ages)))
    for c in cols:
        if c=='AGE': d[c]=ages
        elif c=='INCOME': d[c]=INC_med
        elif c=='log_INC': d[c]=np.log1p(INC_med)
        elif c=='FEMALE': d[c]=modes['FEMALE']
        elif c=='BLACK': d[c]=modes['BLACK']
        elif c=='HISPANIC': d[c]=modes['HISPANIC']
        elif c=='age_spline': d[c]=rcs(ages, KNOTS)
    return d

P = {n: fits[n].predict(sm.add_constant(newX(specs[n].columns, age_grid), has_constant='add')) for n in specs}

print("\nPredicted P(DISSAVED|AGE) at median covariate values:")
print(f"{'AGE':>5} {'M2_noINC':>9} {'M3_INC':>9} {'M4_spl':>9}")
for i,a in enumerate(age_grid):
    print(f"{a:>5.1f} {P['M2'][i]:>9.4f} {P['M3'][i]:>9.4f} {P['M4_spline'][i]:>9.4f}")

# Bootstrap CI for M3 predicted curve + beta
rng = np.random.default_rng(20251022)
B = 1000
X3mat = specs['M3'].values
X3_for_pred = sm.add_constant(newX(specs['M3'].columns, age_grid), has_constant='add').values
boot = np.zeros((B, len(age_grid))); boot_beta = np.full(B, np.nan)
for b in range(B):
    idx = rng.integers(0, len(y), len(y))
    Xb = np.column_stack([np.ones(len(idx)), X3mat[idx]])
    try:
        mb = sm.GLM(y[idx], Xb, family=Binomial(link=Logit())).fit(disp=False, maxiter=80)
        boot[b] = mb.predict(X3_for_pred)
        # x1 is the AGE slot (first column after const)
        boot_beta[b] = mb.params[1]
    except Exception:
        pass
lo = np.nanpercentile(boot,2.5,axis=0); hi=np.nanpercentile(boot,97.5,axis=0)
beta_lo=np.nanpercentile(boot_beta,2.5); beta_hi=np.nanpercentile(boot_beta,97.5)

print("\nM3 predicted curve with bootstrap 95% CI:")
for i,a in enumerate(age_grid):
    print(f"  AGE={a:>4.1f}  P={P['M3'][i]:.4f}  CI=({lo[i]:.4f}, {hi[i]:.4f})")
print(f"M3 beta(AGE) point={fits["M3"].params.iloc[fits["M3"].model.exog_names.index('AGE')]:+.5f}  bootstrap 95% CI=({beta_lo:+.5f}, {beta_hi:+.5f})")

# Q1 vs Q4 effect-size in pp
qA = np.array([25.,31.])
print("\nQ1(25) vs Q4(31) at medians (pp diff):")
for mn in ['M2','M3','M4_spline']:
    pp = fits[mn].predict(sm.add_constant(newX(specs[mn].columns, qA), has_constant='add'))
    print(f"  {mn}: {pp[0]:.4f} -> {pp[1]:.4f}, delta={pp[1]-pp[0]:+.4f} pp")

# Save curve
out = pd.DataFrame({
    'AGE_grid': age_grid,
    'P_M2_no_income': P['M2'],
    'P_M3_with_income': P['M3'],
    'P_M4_spline': P['M4_spline'],
    'P_M3_lo95': lo, 'P_M3_hi95': hi,
})
out.to_csv('/workspace/predicted_curve.csv', index=False)

# Raw sensitivity
print("\n=== RAW (no dedup) sensitivity ===")
df_r = df_raw.copy()
df_r['FEMALE']=(df_r['GENDER']=='FEMALE').astype(int); df_r['log_INC']=np.log1p(df_r['INCOME'])
yr = df_r['DISSAVED'].values
m2r = fit(df_r[['AGE','FEMALE','BLACK','HISPANIC']], yr)
m3r = fit(df_r[['AGE','INCOME','log_INC','FEMALE','BLACK','HISPANIC']], yr)
print(f"  RAW M2: beta_AGE={m2r.params.iloc[1]:+.5f}  p={m2r.pvalues.iloc[1]:.4e}")
print(f"  RAW M3: beta_AGE={m3r.params.iloc[1]:+.5f}  p={m3r.pvalues.iloc[1]:.4e}")
print(f"  DEDUP M2: beta_AGE={fits["M2"].params.iloc[1]:+.5f}  p={fits["M2"].pvalues.iloc[1]:.4f}")
print(f"  DEDUP M3: beta_AGE={fits["M3"].params.iloc[1]:+.5f}  p={fits["M3"].pvalues.iloc[1]:.4f}")

# Save results JSON
import json
results = {
    'n_raw': int(n_raw), 'n_dedup': int(n_dd),
    'DISS_raw': float(dr_raw), 'DISS_dedup': float(dr_dd),
    'pearson_AGE_DISS_raw': float(pearsonr(df_raw['AGE'], df_raw['DISSAVED'])[0]),
    'pearson_AGE_DISS_dedup': float(pearsonr(df['AGE'], df['DISSAVED'])[0]),
    'coefs_dedup': {
        n: {'beta_AGE': float(fits[n].params.iloc[fits[n].model.exog_names.index('AGE')]),
            'p_AGE':   float(fits[n].pvalues.iloc[fits[n].model.exog_names.index('AGE')]),
            'AUC':     float(auc_man(y, fits[n].predict(sm.add_constant(specs[n], has_constant='add')))),
            'Brier':   float(brier(y, fits[n].predict(sm.add_constant(specs[n], has_constant='add')))),
            'McFadden': float(mcfadden(fits[n], y)),
            'AIC':     float(fits[n].aic)}
        for n in ['M1','M2','M3','M3b_log','M4_spline']
    },
    'coefs_raw': {
        'M2_raw':{'beta_AGE':float(m2r.params.iloc[1]),'p_AGE':float(m2r.pvalues.iloc[1])},
        'M3_raw':{'beta_AGE':float(m3r.params.iloc[1]),'p_AGE':float(m3r.pvalues.iloc[1])},
    },
    'dx_tests': {
        'box_tidwell_chi2': float(lr_bt), 'box_tidwell_p': float(chi2.sf(lr_bt,1)),
        'spline_vs_linear_chi2': float(lr_34), 'spline_vs_linear_p': float(chi2.sf(lr_34,1))
    },
    'pred_grid_age': age_grid.tolist(),
    'P_M2': P['M2'].tolist(),
    'P_M3': P['M3'].tolist(),
    'P_M4': P['M4_spline'].tolist(),
    'P_M3_lo95': lo.tolist(), 'P_M3_hi95': hi.tolist(),
    'beta_AGE_bootstrap_CI_M3': [float(beta_lo), float(beta_hi)],
}
with open('/workspace/results.json','w') as f: json.dump(results, f, indent=2, default=float)
print("\nResults saved to /workspace/results.json and predicted_curve.csv")
