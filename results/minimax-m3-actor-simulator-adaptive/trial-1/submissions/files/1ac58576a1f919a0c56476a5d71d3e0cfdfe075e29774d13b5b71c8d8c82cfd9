"""
NLSY79 — BMI vs. impatience-proxy analysis (CORRECTED units)

KEY UNIT CORRECTIONS (verified empirically before running anything else):
- "Height of respondent, 1981" is NOT in inches (all values 400-611). Unusable. Use 1985 height only.
- "Height of respondent, 1985" IS in inches (48-81, median 67). Use this for all waves.
- Weights are in POUNDS, not kg. Using kg gives mean BMI ~49-57 (impossible).
  Using lbs with the standard 703*lb/in^2 formula gives plausible BMI in the high-twenties range.

CAVEATS REPORTED UPFRONT in the writeup:
1. 1981 BMI is computed from 1981 weight × 1985 height (different waves).
   Acceptable: cohort was 16-22 in 1981, 20-26 in 1985; adult height is stable.
2. Composite impatience proxy is intersection (savings-direction impatient AND low residual-wealth).
3. Strictly associational; no causal language anywhere.
"""
import json
import numpy as np
import pandas as pd
import statsmodels.api as sm
from scipy import stats

df = pd.read_csv("data/nls_raw.csv")
N_total = len(df)

# ---- HEIGHT: 1985 in inches (clean) ----
HEIGHT_LO, HEIGHT_HI = 48.0, 90.0
h85 = df["Height of respondent, 1985"]
df["height_clean_in"] = h85.where((h85 >= HEIGHT_LO) & (h85 <= HEIGHT_HI), np.nan)
n_h_avail = df["height_clean_in"].notna().sum()
n_h_excl = df["height_clean_in"].isna().sum() - df["Height of respondent, 1985"].isna().sum()
print(f"Height (1985, inches) available: {n_h_avail} / {N_total}; "
      f"unavailable (no 1985 height): {N_total - n_h_avail}")

# Document 1981-height anomaly
h81 = df["Height of respondent, 1981"]
print(f"Height 1981 column range: [{h81.min():.0f}, {h81.max():.0f}] — NOT in inches; excluded entirely.\n")

# ---- BMI: using lbs & 703 conversion; need weight (lbs) and height_clean_in ----
def bmi_us(weight_lb, height_in):
    return 703.0 * weight_lb / (height_in ** 2)

df["BMI_1981"] = bmi_us(df["Weight of respondent, 1981"], df["height_clean_in"])
df["BMI_1989"] = bmi_us(df["Weight of respondent, 1989"], df["height_clean_in"])
df["BMI_1992"] = bmi_us(df["Weight of respondent, 1992"], df["height_clean_in"])

for y in [1981, 1989, 1992]:
    s = df[f"BMI_{y}"].dropna()
    s = s[(s >= 12) & (s <= 80)]  # plausibility band
    print(f"BMI_{y} (12-80 plausibility band): n={len(s)}, "
          f"mean={s.mean():.2f}, sd={s.std():.2f}, "
          f"p1={s.quantile(.01):.2f}, p99={s.quantile(.99):.2f}")
print()

# ---- WEALTH winsorize then residualize ----
def winsorize(s, lo=0.01, hi=0.99):
    a, b = s.quantile(lo), s.quantile(hi)
    return s.clip(lower=a, upper=b)

wnw_raw = df["Family net wealth, 1990"]
wnw_w = winsorize(wnw_raw)
df["wealth_1990_w"] = wnw_w

work = df.copy()
work["age_79"] = work["Age of respondent, 1979"]
work["female"] = work["Sex of respondent, 1979"].map({1: 0.0, 2: 1.0})
work["race_black"] = (work["Racial/ethnic cohort, 1979"] == 1).astype(float)
work["race_hisp"] = (work["Racial/ethnic cohort, 1979"] == 2).astype(float)

mask_w = work["wealth_1990_w"].notna() & work["age_79"].notna() & \
         work["female"].notna() & work["race_black"].notna()
Xw = sm.add_constant(work.loc[mask_w, ["age_79", "female", "race_black", "race_hisp"]])
yw = work.loc[mask_w, "wealth_1990_w"]
ols_w = sm.OLS(yw, Xw).fit()
work["wealth_1990_resid"] = np.nan
work.loc[mask_w, "wealth_1990_resid"] = ols_w.resid
work["wealth_resid_q"] = pd.qcut(work["wealth_1990_resid"], 5, labels=False, duplicates="drop")
work["low_wealth_q"] = (work["wealth_resid_q"] == 0).astype(float)
print(f"Wealth residualization (W on age+sex+race): n={mask_w.sum()}, R^2={ols_w.rsquared:.3f}; "
      f"wealth_1990 winsor bounds=[{wnw_w.min():.0f}, {wnw_w.max():.0f}] (vs. raw [{wnw_raw.min():.0f}, {wnw_raw.max():.0f}])")
print(f"Low-wealth residual-quintile count: {int(work['low_wealth_q'].sum())}\n")

# Savings-direction impatience
sd = df["Was more money put into or taken out of R/spouse savings since last interview, 1989"]
work["impat_via_savings"] = sd.isin([2.0, 4.0]).astype(float)
print(f"Impatience via savings direction (took out=2 or no savings=4): "
      f"n_impatient={int(work['impat_via_savings'].sum())} / n_observed={work['impat_via_savings'].notna().sum()}")
print(f"Savings direction counts:\n{sd.value_counts(dropna=False).sort_index()}\n")

# Composite: intersection
work["composite_impat"] = ((work["impat_via_savings"] == 1.0) &
                            (work["low_wealth_q"] == 1.0)).astype(float)
print(f"Composite impatience proxy (intersection; was NOT used by everyone due to missingness): "
      f"n_composite=1: {int(work['composite_impat'].sum())} / "
      f"n_with_complete_data: {work['composite_impat'].notna().sum()}\n")

# Controls
work["log_fam_inc_85"] = np.log(work["Total net family income, previous calendar year, 1985"].clip(lower=1.0))
work["grade_79"] = work["Highest grade completed, 1979"]
controls = ["age_79", "female", "race_black", "race_hisp",
            "log_fam_inc_85", "grade_79"]

def bmi_group_table(outcome, proxy_col, label):
    sub = work[[outcome, proxy_col]].dropna()
    sub = sub[(sub[outcome] >= 12) & (sub[outcome] <= 80)]
    n0 = int((sub[proxy_col] == 0).sum())
    n1 = int((sub[proxy_col] == 1).sum())
    g0 = sub.loc[sub[proxy_col] == 0, outcome]
    g1 = sub.loc[sub[proxy_col] == 1, outcome]
    m0, m1 = g0.mean(), g1.mean()
    sd0, sd1 = g0.std(ddof=1), g1.std(ddof=1)
    se = np.sqrt(sd0**2/n0 + sd1**2/n1)
    diff = m1 - m0
    df_w = (sd0**2/n0 + sd1**2/n1)**2 / ((sd0**2/n0)**2/(n0-1) + (sd1**2/n1)**2/(n1-1))
    tcrit = stats.t.ppf(0.975, df_w)
    lo, hi = diff - tcrit*se, diff + tcrit*se
    print(f"[{label}] n0={n0}, n1={n1}, mean BMI 0={m0:.3f}, 1={m1:.3f}, "
          f"diff={diff:+.3f}, 95% CI [{lo:+.3f}, {hi:+.3f}]")
    return {"outcome": outcome, "proxy": proxy_col, "label": label,
            "n0": n0, "n1": n1,
            "mean0": float(m0), "mean1": float(m1),
            "diff": float(diff), "ci_lo": float(lo), "ci_hi": float(hi)}

def adjusted_ols(outcome, proxy_col, label):
    cols = [outcome, proxy_col] + controls
    sub = work[cols].dropna()
    sub = sub[(sub[outcome] >= 12) & (sub[outcome] <= 80)]
    y = sub[outcome]
    X = sm.add_constant(sub[[proxy_col] + controls])
    m = sm.OLS(y, X).fit()
    coef, se, p = m.params[proxy_col], m.bse[proxy_col], m.pvalues[proxy_col]
    lo, hi = coef - 1.96*se, coef + 1.96*se
    print(f"[{label}] Adjusted OLS n={len(sub)}, coef={coef:+.3f}, SE={se:.3f}, "
          f"95% CI [{lo:+.3f}, {hi:+.3f}], p={p:.4g}, R^2={m.rsquared:.3f}")
    return {"outcome": outcome, "proxy": proxy_col, "label": label,
            "n": int(len(sub)), "coef": float(coef), "se": float(se),
            "ci_lo": float(lo), "ci_hi": float(hi), "p": float(p),
            "r2": float(m.rsquared)}

print("=== HEADLINE: BMI_1989 — COMPOSITE PROXY ===")
r_C_unadj = bmi_group_table("BMI_1989", "composite_impat", "1989 BMI by composite (UNADJUSTED)")
r_C_adj = adjusted_ols("BMI_1989", "composite_impat", "1989 BMI ~ composite + controls (ADJUSTED)")

print("\n=== ROBUSTNESS: BMI_1989 — SAVINGS-DIRECTION-ONLY PROXY ===")
r_S_unadj = bmi_group_table("BMI_1989", "impat_via_savings", "1989 BMI by savings-dir (UNADJUSTED)")
r_S_adj = adjusted_ols("BMI_1989", "impat_via_savings", "1989 BMI ~ savings-dir + controls (ADJUSTED)")

print("\n=== SENSITIVITY 1: BMI_1981 (weight 1981 × height 1985, mixing waves) ===")
r_81_unadj = bmi_group_table("BMI_1981", "composite_impat", "1981 BMI by composite (UNADJUSTED)")
r_81_adj = adjusted_ols("BMI_1981", "composite_impat", "1981 BMI ~ composite + controls (ADJUSTED)")

print("\n=== SENSITIVITY 2: BMI_1992 ===")
r_92_unadj = bmi_group_table("BMI_1992", "composite_impat", "1992 BMI by composite (UNADJUSTED)")
r_92_adj = adjusted_ols("BMI_1992", "composite_impat", "1992 BMI ~ composite + controls (ADJUSTED)")

# Per-group n's including n_per_group before plausibility filter
print("\n=== RAW COUNT BEFORE PLAUSIBILITY FILTER ===")
for y in [1981, 1989, 1992]:
    sub_pre = work[[f"BMI_{y}", "composite_impat"]].dropna()
    n0p = int((sub_pre["composite_impat"] == 0).sum())
    n1p = int((sub_pre["composite_impat"] == 1).sum())
    print(f"  BMI_{y} composite: n0={n0p}, n1={n1p} (pre plausibility filter)")

results = {
    "data_summary": {
        "total_rows": int(N_total),
        "height_1985_col_inches_n": int(work["height_clean_in"].notna().sum()),
        "height_1985_col_excluded_count": int(N_total - work["height_clean_in"].notna().sum()),
        "height_1981_data_anomaly": "All 12,143 values fall 400-611; not inches; ignored.",
        "weight_unit_correction": "Weights treated as POUNDS (not kg as dataset description claims).",
        "bmi_formula": "703 * weight_lb / height_in^2",
        "wealth_winsor_percentiles": [0.01, 0.99],
        "wealth_winsor_bounds": [float(wnw_w.min()), float(wnw_w.max())],
        "wealth_raw_bounds": [float(wnw_raw.min()), float(wnw_raw.max())],
        "attrition": {
            "1981": int(df["BMI_1981"].notna().sum()),
            "1989": int(df["BMI_1989"].notna().sum()),
            "1992": int(df["BMI_1992"].notna().sum())
        }
    },
    "headline_1989_composite_unadjusted": r_C_unadj,
    "headline_1989_composite_adjusted": r_C_adj,
    "robustness_1989_savingsdir_unadjusted": r_S_unadj,
    "robustness_1989_savingsdir_adjusted": r_S_adj,
    "sensitivity_1981_composite_unadjusted": r_81_unadj,
    "sensitivity_1981_composite_adjusted": r_81_adj,
    "sensitivity_1992_composite_unadjusted": r_92_unadj,
    "sensitivity_1992_composite_adjusted": r_92_adj
}

with open("artifacts/results.json", "w") as f:
    json.dump(results, f, indent=2)
print("\nWritten artifacts/results.json")
