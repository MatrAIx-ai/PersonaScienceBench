"""
DiscoveryBench — metadata_11 / archaeology
Question: In which century did Diversity in Pottery Form collapse and Diversity
in Pottery Decoration increase simultaneously?

Inputs (data/):
  - time_series_data.csv     PRIMARY: annual CE axis, raw + interpolated pottery Z
  - capital.csv              cross-check: per-century Z for the same series
  - pollen_openness_score_*.csv  context only

Steps:
  A. Confirm PotteryForm == PotteryForm_inter at the 100-y grid (max abs diff).
  B. Build per-century endpoint table (CE in {-4100,-4000,...,-500}).
  C. Per-century Δ: ΔForm_100 / ΔDec_100 at each transition.
     Filter transitions with dForm<0 AND dDec>0.
     Pick largest |ΔForm| (primary); tie-break by largest ΔDec.
  D. Cross-check vs capital.csv (ZKeform / Zkeverz) for the chosen transition.
     Bin-mean robustness using PotteryForm_inter / PotteryDecoration_inter
     averaged over the 100-year window preceding vs succeeding each endpoint.
  E. Write per-century Δ table and machine-readable summary.

Century labelling conventions used:
  - 'data-point century' = the century whose FIRST YEAR equals the data point year
    (year-labels convention). CE=-1800 -> '18th c. BCE' (year 1800 BCE is first year
    of 18th c. BCE); CE=-1700 -> '17th c. BCE' (year 1700 BCE = last year of 18th c.
    BCE / first year of 17th c. BCE).
  - 'century-during' = the century INSIDE WHICH a transition between two
    consecutive endpoints falls. The transition from CE=-1800 (= start of
    18th c. BCE) to CE=-1700 (= start of 17th c. BCE) spans the entire 18th c.
    BCE. This is the headline answer.
"""
import pandas as pd
import numpy as np
import json, os

DATA = "/workspace/data"
OUT  = "/workspace/artifacts"
os.makedirs(OUT, exist_ok=True)

# ---------- Load ----------
ts = pd.read_csv(f"{DATA}/time_series_data.csv", index_col=0)

def _to_float(x):
    if pd.isna(x): return np.nan
    if isinstance(x, (int, float, np.floating, np.integer)): return float(x)
    return float(str(x).replace('.', '').replace(',', '.'))
cap_raw = pd.read_csv(f"{DATA}/capital.csv")
for c in cap_raw.columns:
    if c not in ("BCE","group","color"):
        cap_raw[c] = cap_raw[c].map(_to_float)

# ---------- A: confirm raw vs inter at 100-y grid ----------
mask100 = (ts['CE'] % 100 == 0)
form_diff  = (ts.loc[mask100,'PotteryForm']         - ts.loc[mask100,'PotteryForm_inter']).abs().max()
decor_diff = (ts.loc[mask100,'PotteryDecoration']   - ts.loc[mask100,'PotteryDecoration_inter']).abs().max()
print(f"[A] max|Form    - Form_inter|    at 100-y grid: {form_diff:.6f}")
print(f"[A] max|Decor   - Decor_inter|   at 100-y grid: {decor_diff:.6f}")

# ---------- B: per-century endpoint table ----------
def data_point_century(ce):
    """Year-label convention: CE=-N00 is the FIRST year of the N-th c. BCE."""
    return f"{-int(ce)//100}th c. BCE"

def century_during(prev_ce, curr_ce):
    """Return the century INSIDE WHICH the transition (prev_ce -> curr_ce) falls.
    Under year-label convention, prev_ce is the LAST year of century(prev_ce+1)
    and curr_ce is the LAST year of century(curr_ce+1) -- NO. Let me reason again.

    Under year-label convention:
      CE=-(N-1)*100   -> year (N-1)*100 BCE = last year of N-th c. BCE .. not quite.
    Better reasoning:
      Year N00 BCE is the FIRST year of the N-th c. BCE.
      Year (N-1)*100 + 1 BCE is the LAST year of the N-th c. BCE.
      So 18th c. BCE = 1800 BCE .. 1701 BCE.
      Data point CE=-1800 = year 1800 BCE = 1st year of 18th c. BCE.
      Data point CE=-1700 = year 1700 BCE = 1st year of 17th c. BCE — i.e.,
      OUTSIDE the 18th c. BCE.
      So the value held AT CE=-1700 pertains to the START of the 17th c. BCE.

    What we want: 'during which century did the change happen?'
    The change from val(CE=-1800) to val(CE=-1700) happens between years 1800 BCE
    and 1700 BCE. Since the 18th c. BCE covers 1800 .. 1701 BCE, ALL of this change
    occurred INSIDE the 18th c. BCE (no part of it crosses into the 17th c. BCE
    because the LAST year of the 18th c. BCE — 1701 BCE — is OUTSIDE the data
    range of the change).

    Therefore: centuries-during the transition prev_ce -> curr_ce is the century
    whose last year (curr_ce+1 if curr_ce is the START of the next century) is
    curr_ce + 99 in CE terms. Equivalently, it is the century labelled by
    data_point_century(prev_ce).
    """
    return f"{-int(prev_ce)//100}th c. BCE"

endpoints = ts.loc[mask100 & (ts['CE'] >= -4100) & (ts['CE'] <= -500),
                   ['CE','calBP','PotteryForm','PotteryForm_inter',
                    'PotteryDecoration','PotteryDecoration_inter']].copy()
endpoints['century_of_point'] = endpoints['CE'].map(data_point_century)
endpoints = endpoints.sort_values('CE').reset_index(drop=True)

# ---------- C: per-century Δ ----------
endpoints['dForm_100'] = endpoints['PotteryForm'].diff()
endpoints['dDec_100']  = endpoints['PotteryDecoration'].diff()
endpoints['century_during'] = [
    century_during(endpoints.iloc[i-1]['CE'], endpoints.iloc[i]['CE'])
    if i > 0 else None
    for i in range(len(endpoints))
]

simul = endpoints.dropna(subset=['dForm_100','dDec_100']).query("dForm_100 < 0 and dDec_100 > 0").copy()
print(f"\n[C] #centuries-during with simultaneous collapse+rise  = {len(simul)}")
print(simul[['CE','century_of_point','century_during','PotteryForm','PotteryDecoration',
             'dForm_100','dDec_100']].to_string(index=False))

# Primary: largest |ΔForm|; tie-break by largest ΔDec.
primary = simul.assign(abs_dForm=simul['dForm_100'].abs()) \
               .sort_values(['abs_dForm','dDec_100'], ascending=[False, False]) \
               .iloc[0]
print("\n[C] PRIMARY (largest |ΔForm|, tie-break ΔDec):")
print(primary[['CE','century_of_point','century_during',
               'PotteryForm','PotteryDecoration','dForm_100','dDec_100']])

# ---------- D1: cross-check against capital.csv ----------
bce_prev = int(-primary['CE'] + 100)   # year at START of the primary century-during
bce_curr = int(-primary['CE'])         # year at END   of the primary century-during
row_prev = cap_raw.loc[cap_raw['BCE'] == bce_prev]
row_curr = cap_raw.loc[cap_raw['BCE'] == bce_curr]
print(f"\n[D1] capital.csv cross-check for transition BCE {bce_prev} -> {bce_curr}:")
if not row_prev.empty and not row_curr.empty:
    f_prev, f_curr = float(row_prev['ZKeform'].iloc[0]), float(row_curr['ZKeform'].iloc[0])
    d_prev, d_curr = float(row_prev['Zkeverz'].iloc[0]), float(row_curr['Zkeverz'].iloc[0])
    print(f"   ZKeform  {bce_prev}BCE={f_prev:+.2f}  -> {bce_curr}BCE={f_curr:+.2f}   ΔForm_capital = {f_curr-f_prev:+.2f}")
    print(f"   Zkeverz  {bce_prev}BCE={d_prev:+.2f}  -> {bce_curr}BCE={d_curr:+.2f}   ΔDec_capital  = {d_curr-d_prev:+.2f}")
    print(f"   Agreement ΔForm: {np.isclose(f_curr-f_prev, primary['dForm_100'], atol=1e-6)}")
    print(f"   Agreement ΔDec : {np.isclose(d_curr-d_prev, primary['dDec_100'],  atol=1e-6)}")

# ---------- D2: bin-mean robustness ----------
bm_rows = []
for i in range(len(endpoints)-1):
    r0, r1 = endpoints.iloc[i], endpoints.iloc[i+1]
    span0 = (ts['CE'] >= r0['CE']) & (ts['CE'] < r0['CE']+100)
    span1 = (ts['CE'] >= r1['CE']) & (ts['CE'] < r1['CE']+100)
    f0, f1 = ts.loc[span0,'PotteryForm_inter'].mean(), ts.loc[span1,'PotteryForm_inter'].mean()
    d0, d1 = ts.loc[span0,'PotteryDecoration_inter'].mean(), ts.loc[span1,'PotteryDecoration_inter'].mean()
    bm_rows.append({
        'CE_prev': int(r0['CE']), 'CE_curr': int(r1['CE']),
        'century_during': century_during(r0['CE'], r1['CE']),
        'meanForm_prev':  f0, 'meanForm_curr': f1, 'dForm_binmean': f1-f0,
        'meanDec_prev':   d0, 'meanDec_curr':  d1, 'dDec_binmean':  d1-d0,
    })
bm = pd.DataFrame(bm_rows)
bm_simul = bm.query("dForm_binmean < 0 and dDec_binmean > 0").copy()
print(f"\n[D2] Bin-mean robustness: simultaneous collapse+rise transitions (count={len(bm_simul)}):")
print(bm_simul.to_string(index=False))
if not bm_simul.empty:
    bm_primary = bm_simul.assign(abs_dF=bm_simul['dForm_binmean'].abs()) \
                       .sort_values(['abs_dF','dDec_binmean'], ascending=[False, False]) \
                       .iloc[0]
    print("\n[D2] Bin-mean PRIMARY (largest |ΔForm_binmean|, tie-break ΔDec_binmean):")
    print(bm_primary.to_string())

# ---------- E: write outputs ----------
out_path = f"{OUT}/century_table.csv"
endpoints.to_csv(out_path, index=False)
print(f"\n[E] wrote {out_path} ({len(endpoints)} rows)")

# Validate uniqueness of the simultaneous event
n_sim = len(simul)
n_sim_bm = len(bm_simul)

summary = {
    'question': 'In which century did Diversity in Pottery Form collapse and Diversity in Pottery Decoration increase simultaneously?',
    'data_source_note': 'time_series_data.csv (PRIMARY), capital.csv (cross-check, comma-decimal parsed)',
    'selection_rule': 'min(ΔForm) given ΔDec>0; tie-break max(ΔDec)',
    'ce_axis_convention': 'CE = -BCE (signed Common Era); calBP = 1950 - CE',
    'century_label_convention_data_point': 'CE=-N100 means year N00 BCE = first year of N-th c. BCE',
    'century_label_convention_during': 'The century-during a transition prev_CE->curr_CE is the century labelled by data_point_century(prev_CE), i.e., the bin between the two endpoints.',
    'A_max_abs_diff_form_vs_form_inter_at_grid'  : float(form_diff),
    'A_max_abs_diff_decor_vs_decor_inter_at_grid': float(decor_diff),
    'C_n_unique_simultaneous_transitions' : int(n_sim),
    'C_primary_CE_prev'        : int(primary['CE']) + 100,
    'C_primary_CE_curr'        : int(primary['CE']),
    'C_primary_century_during' : str(primary['century_during']),
    'C_primary_data_point_curr': str(primary['century_of_point']),
    'C_primary_dForm_100'      : float(primary['dForm_100']),
    'C_primary_dDec_100'       : float(primary['dDec_100']),
    'C_primary_Form_prev_CE'   : float(endpoints.loc[endpoints["CE"]==int(primary["CE"])-100,"PotteryForm"].iloc[0]),
    'C_primary_Form_curr_CE'   : float(primary['PotteryForm']),
    'C_primary_Dec_prev_CE'    : float(endpoints.loc[endpoints["CE"]==int(primary["CE"])-100,"PotteryDecoration"].iloc[0]),
    'C_primary_Dec_curr_CE'    : float(primary['PotteryDecoration']),
    'D1_capital_Form_change'   : float(f_curr-f_prev),
    'D1_capital_Decor_change'  : float(d_curr-d_prev),
    'D1_capital_agrees_with_ts_form'  : bool(np.isclose(f_curr-f_prev, primary['dForm_100'], atol=1e-6)),
    'D1_capital_agrees_with_ts_decor' : bool(np.isclose(d_curr-d_prev, primary['dDec_100'],  atol=1e-6)),
    'D2_n_unique_simultaneous_transitions_binmean' : int(n_sim_bm),
    'D2_binmean_primary_century_during' : str(bm_primary['century_during']) if not bm_simul.empty else None,
    'D2_binmean_primary_dForm'           : float(bm_primary['dForm_binmean']) if not bm_simul.empty else None,
    'D2_binmean_primary_dDec'            : float(bm_primary['dDec_binmean'])  if not bm_simul.empty else None,
}
with open(f"{OUT}/result_summary.json","w") as f:
    json.dump(summary, f, indent=2)
print(f"\n[E] wrote {OUT}/result_summary.json")

# ---------- Print final headline ----------
print("\n" + "="*64)
print("FINAL HEADLINE")
print("="*64)
print(f"Century-during (100-y bin where the change happens): {primary['century_during']}")
print(f"  Δ PotteryForm       : {primary['dForm_100']:+.2f} (collapse, "
      f"{endpoints.loc[endpoints["CE"]==int(primary["CE"])-100,"PotteryForm"].iloc[0]:+.2f} -> "
      f"{primary['PotteryForm']:+.2f})")
print(f"  Δ PotteryDecoration : {primary['dDec_100']:+.2f} (rise,    "
      f"{endpoints.loc[endpoints["CE"]==int(primary["CE"])-100,"PotteryDecoration"].iloc[0]:+.2f} -> "
      f"{primary['PotteryDecoration']:+.2f})")
print(f"  Unique simultaneous collapse+rise transitions in table: {n_sim}")
