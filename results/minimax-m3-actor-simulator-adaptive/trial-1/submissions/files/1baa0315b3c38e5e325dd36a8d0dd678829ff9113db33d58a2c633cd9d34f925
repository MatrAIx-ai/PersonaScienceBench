"""Stage=result — final computation for:
"What proportion of studies in Experimental Economics were conducted in a lab setting?"

Approved primary operationalization:
   project == 'ee'  AND  online.o == 0   (applied to originals; unique original = unique id)

Sensitivity checks:
   S1: in-person AND subject pool in {students, community}
   S2: in-person AND subject pool in {students}                 (strict "lab-with-undergrads")
   S3: in-person AND compensation in {cash, mixed}
   S4: original AND replication both in-person (same_online == 1)
   S5: primary definition re-run with explicit n reporting.

Unit of analysis: a row in CSV1 with project=='ee'; dedupe by id defensively.
"""
from pathlib import Path
import json
import re
import pandas as pd

ROOT = Path(__file__).resolve().parents[1]
DATA1 = ROOT / "data" / "meta-regression_study_data_heterogeneity_in_replication_projects.csv"
DATA2 = ROOT / "data" / "meta-regression_replication_success_data_heterogeneity_in_replication_projects.csv"
OUT   = ROOT / "artifacts" / "results.json"

df  = pd.read_csv(DATA1)
df2 = pd.read_csv(DATA2)  # reference only

# --- Sanity / cross-confirmation ---
ee2 = df2[df2["project"] == "Experimental Economics"].copy()
def _surname(s):
    s = re.sub(r"\s*\(.*$", "", str(s))
    s = s.split(" et al")[0].split(" and ")[0].strip()
    return s.split()[-1].lower()
surnames_csv1 = set(_surname(a) for a in df[df["project"]=="ee"]["authors.o"])
surnames_csv2 = set(_surname(s) for s in ee2["study"])
first_author_match = (len(surnames_csv1) == 18 and surnames_csv1 == surnames_csv2)

# --- Restrict to ee and dedupe by id ---
ee = df[df["project"] == "ee"].copy()
n_pre = len(ee)
ee = ee.drop_duplicates(subset=["id"]).reset_index(drop=True)
n = len(ee)

# --- Primary proportion ---
online_o = ee["online.o"]
num_offline = int((online_o == 0).sum())
denom = int(n)
primary_frac = f"{num_offline}/{denom}"
primary_pct  = 100.0 * num_offline / denom if denom else float("nan")

# --- Sensitivity checks ---
S1 = int(((ee["online.o"] == 0) & (ee["subjects.o"].isin(["students", "community"]))).sum())
S2 = int(((ee["online.o"] == 0) & (ee["subjects.o"] == "students")).sum())
S3 = int(((ee["online.o"] == 0) & (ee["compensation.o"].isin(["cash", "mixed"]))).sum())
S4 = int((ee["same_online"] == 1).sum())

# --- Replication-side mirror (footnote) ---
online_r_all_zero = int((ee["online.r"] == 0).sum()) == denom
same_online_all_one = int((ee["same_online"] == 1).sum()) == denom

# --- The "community" outlier ---
community_rows = ee.loc[ee["subjects.o"] == "community", "title"].tolist()

results = {
    "question": "What proportion of studies in Experimental Economics were conducted in a lab setting?",
    "data_files": {
        "csv1": str(DATA1.relative_to(ROOT)),
        "csv2": str(DATA2.relative_to(ROOT)),
        "csv1_shape": list(df.shape),
        "csv2_shape": list(df2.shape),
    },
    "primary_definition": "in-person in the ORIGINAL experiment (project=='ee' AND online.o==0); unique original = unique id",
    "n_total_ee": n_pre,
    "n_after_dedup": denom,
    "primary": {
        "numerator_in_person": num_offline,
        "denominator_total": denom,
        "fraction": primary_frac,
        "percent": primary_pct,
    },
    "sensitivity": {
        "S1_inperson_AND_subjects_in_{students,community}": f"{S1}/{denom}  ({100.0*S1/denom:.2f}%)",
        "S2_inperson_AND_subjects_strict_students":        f"{S2}/{denom}  ({100.0*S2/denom:.2f}%)",
        "S3_inperson_AND_compensation_in_{cash,mixed}":    f"{S3}/{denom}  ({100.0*S3/denom:.2f}%)",
        "S4_original_AND_replication_both_in_person":      f"{S4}/{denom}  ({100.0*S4/denom:.2f}%)",
        "S5_primary_replay":                               f"{num_offline}/{denom}  ({primary_pct:.2f}%)",
        "sensitivity_range_pct": "94.44% – 100.00% (17/18 – 18/18)",
        "only_row_that_flips_S1_vs_S2": community_rows,
    },
    "replication_side_mirror": {
        "online_r_all_zero_for_all_ee_rows": bool(online_r_all_zero),
        "same_online_all_one_for_all_ee_rows": bool(same_online_all_one),
        "note": "Originals and replications have identical in-person status (same_online==1 for all 18), so the proportion is the same on either side.",
    },
    "caveats": [
        "n=18 is the entirety of the Experimental Economics replication-project subset in this dataset, not a population estimate of all Experimental Economics studies.",
        "CSV2 (replication-success file) has only study-level effect estimates and no lab/setting fields; it is referenced only to cross-confirm the 18 ee originals (CSV1↔CSV2 18↔18, same study set by first-author name).",
        "lab_id is NaN for every ee row (it indexes replication labs in multi-lab projects, not the original-study setting in ee).",
        "online.o, online.r, subjects.o, compensation.o, same_online are fully observed for ee (no NaN); no imputation needed.",
        "The single community-pool original (Charness & Dufwenberg 2011) is the only row whose subject-pool differs from 'students'; it is the row that flips S2 (17/18) but is still counted under S1 (18/18) because it is in-person.",
    ],
    "cross_confirm_csv1_csv2": {
        "csv1_ee_rows": int(n_pre),
        "csv2_ee_rows": int(len(ee2)),
        "first_author_match_surnames": first_author_match,
        "csv2_has_setting_fields": any(c in df2.columns for c in
                                       ["online.o","online.r","subjects.o","compensation.o","lab_id"]),
    },
}

OUT.write_text(json.dumps(results, indent=2))
print(json.dumps(results, indent=2))
