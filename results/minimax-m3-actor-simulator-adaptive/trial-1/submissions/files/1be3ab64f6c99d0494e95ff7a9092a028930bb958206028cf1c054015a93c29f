"""
DiscoveryBench metadata_7 question
Question: In which domain do the majority of authors tend to be male
for both original and replication studies?
Input  : data/meta-regression_study_data_heterogeneity_in_replication_projects.csv (n=927)
Outputs: artifacts/analysis/per_discipline_all.csv
         artifacts/analysis/per_discipline_no_aggregated.csv
         artifacts/analysis/per_discipline_psy.csv
         artifacts/analysis/notes.md
"""
import pandas as pd

PATH = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
s = pd.read_csv(PATH)

def per_table(df):
    return (
        df.groupby("discipline")
          .agg(n=("id","count"),
               mean_o=("authors_male.o","mean"),
               mean_r=("authors_male.r","mean"),
               share_o_50=("authors_male.o", lambda v: (v>0.5).mean()),
               share_o_60=("authors_male.o", lambda v: (v>0.6).mean()),
               share_r_50=("authors_male.r", lambda v: (v>0.5).mean()),
               share_r_60=("authors_male.r", lambda v: (v>0.6).mean()))
          .reset_index()
        )

per_table(s).to_csv("artifacts/analysis/per_discipline_all.csv", index=False)
per_table(s[~s["n_authors.r"].ge(20)]).to_csv("artifacts/analysis/per_discipline_no_aggregated.csv", index=False)
per_table(s[s["project"].isin(["ml1","ml3","rpp"])]).to_csv("artifacts/analysis/per_discipline_psy.csv", index=False)
