"""DiscoveryBench - archaeology - pottery divergence (v2).
Convention: data is ordered by BCE ascending (500..4100). Each raw value
attaches to BCE=start of century. So the change WITHIN century b
(v_b - v_{b+100}) is the chronological-forward delta for the newer century b.
Theil-Sen slope is computed with x = chronological time (-bce), i.e.
positive slope => value grows with time.
"""
import json
from pathlib import Path
import numpy as np
import pandas as pd
from scipy.stats import theilslopes

ROOT = Path(__file__).resolve().parent.parent
OUT  = ROOT / "outputs"
FIG  = ROOT / "figures"
OUT.mkdir(exist_ok=True); FIG.mkdir(exist_ok=True)

# ---------- Load ----------
ts = pd.read_csv(ROOT / "data" / "time_series_data.csv", index_col=0)
ts["BCE"] = -ts["CE"]
bin_centers = list(range(500, 4100 + 1, 100))   # 500..4100 step 100, 37 points
bce_idx = {b: i for i, b in enumerate(bin_centers)}

def at(df, bce, col):
    rows = df.loc[df["BCE"] == bce, col]
    return float(rows.iloc[0]) if len(rows) and pd.notna(rows.iloc[0]) else np.nan

series = pd.DataFrame({
    "BCE":      bin_centers,
    "PF_inter": [at(ts, b, "PotteryForm_inter")      for b in bin_centers],
    "PD_inter": [at(ts, b, "PotteryDecoration_inter") for b in bin_centers],
    "PF_raw":   [at(ts, b, "PotteryForm")             for b in bin_centers],
    "PD_raw":   [at(ts, b, "PotteryDecoration")        for b in bin_centers],
})
series.to_csv(OUT / "century_series.csv", index=False)

# ---------- Chronological-forward delta: ΔZ(b) = v(b) - v(b+100) ----------
# b+100 is the older precedent; valid for b in [500..4000], invalid for b=4100.
def chron_delta(col):
    out = []
    for b in bin_centers:
        if b == 4100:
            out.append(np.nan)
            continue
        i, j = bce_idx[b], bce_idx[b + 100]
        a, c = series[col].iat[i], series[col].iat[j]
        out.append(a - c if pd.notna(a) and pd.notna(c) else np.nan)
    return out

series["dPF_chron"] = chron_delta("PF_inter")
series["dPD_chron"] = chron_delta("PD_inter")
series["dPF_raw_chron"]   = chron_delta("PF_raw")
series["dPD_raw_chron"]   = chron_delta("PD_raw")
valid_mask = series["BCE"] < 4100

def is_opp_chron(row, eps, dpf, dpd):
    a, b = row[dpf], row[dpd]
    if pd.isna(a) or pd.isna(b): return False
    return (b > 0) and (a < 0) and (abs(b) >= eps) and (abs(a) >= eps)

for eps in (0.3, 0.5, 0.7):
    tag = f"{int(round(eps*10)):02d}"
    series[f"opp_chron_eps{tag}"] = valid_mask & series.apply(
        lambda r: is_opp_chron(r, eps, "dPF_chron", "dPD_chron"), axis=1)
    series[f"opp_chron_raw_eps{tag}"] = valid_mask & series.apply(
        lambda r: is_opp_chron(r, eps, "dPF_raw_chron", "dPD_raw_chron"), axis=1)

# ---------- Theil-Sen over (b+100, b, b-100) in chronological order ----------
# y ordered chronologically-forward: older (b+100) -> current (b) -> newer (b-100)
# x = [0, 1, 2] (chronological time steps of 100 years each)
def theil_chrono(val_col, b):
    need = [b + 100, b, b - 100]
    y = []
    for bb in need:
        r = series.loc[series["BCE"] == bb, val_col]
        if len(r) == 0 or pd.isna(r.iloc[0]): return (np.nan,)*3
        y.append(float(r.iloc[0]))
    x = np.array([0., 1., 2.])
    res = theilslopes(y, x, alpha=0.95)
    return float(res.slope), float(res.low_slope), float(res.high_slope)

rows = []
for b in bin_centers:
    pfs, pflo, pfhi = theil_chrono("PF_inter", b)
    pds, pdlo, pdhi = theil_chrono("PD_inter", b)
    rows.append((b, pfs, pflo, pfhi, pds, pdlo, pdhi))
slope_df = pd.DataFrame(rows, columns=["BCE","slope_PF","lo_PF","hi_PF","slope_PD","lo_PD","hi_PD"])
series = series.merge(slope_df, on="BCE", how="left")

def opp_slope_chrono(r):
    sPF, loPF, hiPF = r["slope_PF"], r["lo_PF"], r["hi_PF"]
    sPD, loPD, hiPD = r["slope_PD"], r["lo_PD"], r["hi_PD"]
    if any(pd.isna(v) for v in (sPF, loPF, hiPF, sPD, loPD, hiPD)): return False
    return (sPF < 0) and (loPF < 0) and (sPD > 0) and (loPD > 0)

series["opp_slope_3c_chrono"] = valid_mask & series.apply(opp_slope_chrono, axis=1)

# ---------- Persistence: divergence holds into the *newer* century ----------
def persists_chrono(r, eps, dpf, dpd):
    b = r["BCE"]
    nxt = series.loc[series["BCE"] == b - 100]
    if len(nxt) == 0: return False
    n = nxt.iloc[0]
    if pd.isna(n[dpf]) or pd.isna(n[dpd]): return False
    return (n[dpd] > 0) and (n[dpf] < 0) and (abs(n[dpd]) >= eps) and (abs(n[dpf]) >= eps)
for eps in (0.3, 0.5, 0.7):
    tag = f"{int(round(eps*10)):02d}"
    series[f"persist_chron_eps{tag}"] = valid_mask & series.apply(
        lambda r: persists_chrono(r, eps, "dPF_chron", "dPD_chron"), axis=1)

# ---------- Save table ----------
out_cols = ["BCE","PF_inter","PD_inter","PF_raw","PD_raw",
            "dPF_chron","dPD_chron","dPF_raw_chron","dPD_raw_chron",
            "opp_chron_eps03","opp_chron_eps05","opp_chron_eps07",
            "opp_chron_raw_eps03","opp_chron_raw_eps05","opp_chron_raw_eps07",
            "slope_PF","lo_PF","hi_PF","slope_PD","lo_PD","hi_PD",
            "opp_slope_3c_chrono",
            "persist_chron_eps03","persist_chron_eps05","persist_chron_eps07"]
series[out_cols].to_csv(OUT / "delta_table.csv", index=False)

# ---------- Pretty print ----------
pd.set_option("display.width", 220)
pd.set_option("display.max_columns", 30)
pd.set_option("display.float_format", lambda v: f"{v:+.3f}" if not pd.isna(v) else "NaN")
print("=== CHRONOLOGICAL DELTA TABLE (BCE 4000..500) ===")
print(series.loc[series["BCE"] != 4100, out_cols].to_string(index=False))

# ---------- Candidates ----------
def first_true(col):
    rows = series.loc[series[col]]
    return int(rows["BCE"].iloc[0]) if len(rows) else None
def all_true(col):
    return [int(b) for b in series.loc[series[col], "BCE"]]

cands = {}
for eps in (0.3, 0.5, 0.7):
    tag = f"{int(round(eps*10)):02d}"
    cands[f"eps_{eps}"] = {
        "first_chron_BCE":   first_true(f"opp_chron_eps{tag}"),
        "first_chron_raw_BCE": first_true(f"opp_chron_raw_eps{tag}"),
        "all_chron_BCE":     all_true(f"opp_chron_eps{tag}"),
        "all_chron_raw_BCE": all_true(f"opp_chron_raw_eps{tag}"),
    }
cands["theil_sen_3c_chrono"] = {
    "first_BCE": first_true("opp_slope_3c_chrono"),
    "all_BCE":   all_true("opp_slope_3c_chrono"),
}
primary_first = cands["eps_0.5"]["first_chron_BCE"]
print("\n=== CANDIDATES ===")
for k, v in cands.items():
    print(k, v)

# consistency raw vs _inter at primary
if primary_first is not None:
    raw_eq = all(
        bool(series.loc[series["BCE"] == primary_first, f"opp_chron_raw_eps{e:02d}"].iloc[0]) ==
        bool(series.loc[series["BCE"] == primary_first, f"opp_chron_eps{e:02d}"].iloc[0])
        for e in (3,5,7))
    print("raw_eq_inter_at_primary (epsilon agreement):", raw_eq)

# ---------- Detail at primary ----------
if primary_first is not None:
    r  = series.loc[series["BCE"] == primary_first].iloc[0]
    pr = series.loc[series["BCE"] == primary_first + 100].iloc[0]
    nr = series.loc[series["BCE"] == primary_first - 100]
    print(f"\n=== DETAIL at primary first century BCE = {primary_first} ===")
    print(f"Older  (BCE {int(pr['BCE'])}): PF={pr['PF_inter']:+.4f}  PD={pr['PD_inter']:+.4f}")
    print(f"Curr   (BCE {int(r ['BCE'])}): PF={r ['PF_inter']:+.4f}  PD={r ['PD_inter']:+.4f}")
    if len(nr):
        nr = nr.iloc[0]
        print(f"Newer  (BCE {int(nr['BCE'])}): PF={nr['PF_inter']:+.4f}  PD={nr['PD_inter']:+.4f}")
        print(f"Persistence into BCE {int(nr['BCE'])}:  eps=0.3 -> {bool(r['persist_chron_eps03'])},  "
              f"eps=0.5 -> {bool(r['persist_chron_eps05'])},  eps=0.7 -> {bool(r['persist_chron_eps07'])}")
    print(f"Δ (newer - older):  dPF={r['dPF_chron']:+.4f} (|.|={abs(r['dPF_chron']):.4f}),  "
          f"dPD={r['dPD_chron']:+.4f} (|.|={abs(r['dPD_chron']):.4f})")
    print(f"Theil-Sen slope (3c, chrono order):  PF slope={r['slope_PF']:+.4f} CI[{r['lo_PF']:+.4f},{r['hi_PF']:+.4f}],  "
          f"PD slope={r['slope_PD']:+.4f} CI[{r['lo_PD']:+.4f},{r['hi_PD']:+.4f}]")
    print(f"3c slope robust (opposite + CI clear): {bool(r['opp_slope_3c_chrono'])}")

# ---------- ASCII plot ----------
vals_pf = series["PF_inter"].tolist(); vals_pd = series["PD_inter"].tolist()
lo = min(min(vals_pf), min(vals_pd)) - 0.1
hi = max(max(vals_pf), max(vals_pd)) + 0.1
W = 60
def vx(v): return max(0, min(W-1, int((v - lo) / (hi - lo) * (W - 1))))
al = [f"Z range: [{lo:.2f}, {hi:.2f}]   F=PotteryForm_inter, D=PotteryDecoration_inter, *=both"]
al.append(" " * 12 + "+" + "-" * W + "+")
for i, b in enumerate(reversed(series["BCE"])):  # top=BCE 4100, bottom=BCE 500
    ri = len(series) - 1 - i
    p, d = vx(vals_pf[ri]), vx(vals_pd[ri])
    line = [" "] * W
    line[p] = ("*" if p == d else "F")
    line[d] = ("*" if p == d else "D")
    al.append(f"BCE {b:5d} |{''.join(line)}|")
print("\n=== ASCII PLOT (rows = centuries, top = oldest BCE 4100, bottom = newest BCE 500) ===")
print("\n".join(al))
(FIG / "ascii_plot.txt").write_text("\n".join(al) + "\n")

# ---------- results.json ----------
def as_py(x):
    if isinstance(x, (np.bool_,)): return bool(x)
    if isinstance(x, (np.integer,)): return int(x)
    if isinstance(x, (np.floating,)): return float(x)
    return x
results = {
    "convention": "ΔZ(b) = v(b) - v(b+100) (chronological-forward); x=chrono for Theil-Sen.",
    "primary_first_century_BCE": as_py(primary_first),
    "candidates_by_eps": cands,
}
if primary_first is not None:
    results["primary_detail"] = {
        "BCE": as_py(primary_first),
        "PF_at":      float(series.loc[series["BCE"]==primary_first,"PF_inter"].iloc[0]),
        "PD_at":      float(series.loc[series["BCE"]==primary_first,"PD_inter"].iloc[0]),
        "PF_older":   float(series.loc[series["BCE"]==primary_first+100,"PF_inter"].iloc[0]),
        "PD_older":   float(series.loc[series["BCE"]==primary_first+100,"PD_inter"].iloc[0]),
        "dPF_chron":  as_py(series.loc[series["BCE"]==primary_first,"dPF_chron"].iloc[0]),
        "dPD_chron":  as_py(series.loc[series["BCE"]==primary_first,"dPD_chron"].iloc[0]),
        "slope_PF":   as_py(series.loc[series["BCE"]==primary_first,"slope_PF"].iloc[0]),
        "slope_PD":   as_py(series.loc[series["BCE"]==primary_first,"slope_PD"].iloc[0]),
        "slope_PF_CI_lo": as_py(series.loc[series["BCE"]==primary_first,"lo_PF"].iloc[0]),
        "slope_PF_CI_hi": as_py(series.loc[series["BCE"]==primary_first,"hi_PF"].iloc[0]),
        "slope_PD_CI_lo": as_py(series.loc[series["BCE"]==primary_first,"lo_PD"].iloc[0]),
        "slope_PD_CI_hi": as_py(series.loc[series["BCE"]==primary_first,"hi_PD"].iloc[0]),
        "opp_slope_3c_robust": bool(series.loc[series["BCE"]==primary_first,"opp_slope_3c_chrono"].iloc[0]),
        "persists_into_next_eps03": bool(series.loc[series["BCE"]==primary_first,"persist_chron_eps03"].iloc[0]),
        "persists_into_next_eps05": bool(series.loc[series["BCE"]==primary_first,"persist_chron_eps05"].iloc[0]),
        "persists_into_next_eps07": bool(series.loc[series["BCE"]==primary_first,"persist_chron_eps07"].iloc[0]),
    }
with open(OUT / "results.json", "w") as f:
    json.dump(results, f, indent=2, default=as_py)
print("\n=== results.json ===")
print(json.dumps(results, indent=2, default=as_py))

# ---------- SVG plot (no matplotlib) ----------
svg_W, svg_H = 980, 460
ml, mr, mt, mb = 80, 30, 40, 60
pw = svg_W - ml - mr; ph = svg_H - mt - mb
bces = series["BCE"].tolist()
xf = lambda b: ml + (4100 - b) / (4100 - 500) * pw   # x: oldest left, newest right
yf = lambda v: mt + (hi - v) / (hi - lo) * ph
def path(vs, c):
    return '<polyline fill="none" stroke="'+c+'" stroke-width="2" points="' + " ".join(f"{xf(b):.1f},{yf(v):.1f}" for b,v in zip(bces, vs)) + '"/>'

s = []
s.append(f'<svg xmlns="http://www.w3.org/2000/svg" width="{svg_W}" height="{svg_H}" viewBox="0 0 980 460" font-family="sans-serif" font-size="11">')
s.append(f'<rect x="0" y="0" width="{svg_W}" height="{svg_H}" fill="white" stroke="#ccc"/>')
s.append(f'<text x="{svg_W/2:.0f}" y="22" text-anchor="middle" font-weight="bold">Pottery Form and Pottery Decoration - Z, _inter, 100-year bins BCE 4100-500</text>')
for v in np.linspace(lo, hi, 7):
    y = yf(v)
    s.append(f'<line x1="{ml}" x2="{svg_W-mr}" y1="{y:.1f}" y2="{y:.1f}" stroke="#eee"/>')
    s.append(f'<text x="{ml-6}" y="{y+3:.1f}" text-anchor="end">{v:+.2f}</text>')
for b in range(500, 4101, 500):
    x = xf(b)
    s.append(f'<line x1="{x:.1f}" x2="{x:.1f}" y1="{mt}" y2="{mt+ph:.1f}" stroke="#f3f3f3"/>')
    s.append(f'<text x="{x:.1f}" y="{svg_H-mb+14:.0f}" text-anchor="middle">BCE {b}</text>')
s.append(f'<line x1="{ml}" x2="{svg_W-mr}" y1="{mt+ph:.1f}" y2="{mt+ph:.1f}" stroke="#333"/>')
s.append(f'<line x1="{ml}" x2="{ml}" y1="{mt}" y2="{mt+ph:.1f}" stroke="#333"/>')
s.append(path(vals_pf, "#1f77b4"))
s.append(path(vals_pd, "#d62728"))
for b, v in zip(bces, vals_pf):
    s.append(f'<circle cx="{xf(b):.1f}" cy="{yf(v):.1f}" r="2" fill="#1f77b4"/>')
for b, v in zip(bces, vals_pd):
    s.append(f'<circle cx="{xf(b):.1f}" cy="{yf(v):.1f}" r="2" fill="#d62728"/>')
if primary_first is not None:
    pv = series.loc[series["BCE"]==primary_first,"PF_inter"].iloc[0]
    dv = series.loc[series["BCE"]==primary_first,"PD_inter"].iloc[0]
    s.append(f'<line x1="{xf(primary_first):.1f}" x2="{xf(primary_first):.1f}" y1="{mt}" y2="{mt+ph:.1f}" stroke="#2ca02c" stroke-dasharray="4,3"/>')
    s.append(f'<circle cx="{xf(primary_first):.1f}" cy="{yf(pv):.1f}" r="6" fill="none" stroke="#2ca02c" stroke-width="2"/>')
    s.append(f'<circle cx="{xf(primary_first):.1f}" cy="{yf(dv):.1f}" r="6" fill="none" stroke="#2ca02c" stroke-width="2"/>')
    s.append(f'<text x="{xf(primary_first):.1f}" y="{mt+12:.1f}" text-anchor="middle" fill="#2ca02c" font-weight="bold">first * BCE {primary_first}</text>')
ly = mt + 14
s.append(f'<line x1="{svg_W-mr-180:.0f}" x2="{svg_W-mr-160:.0f}" y1="{ly}" y2="{ly}" stroke="#1f77b4" stroke-width="2"/>')
s.append(f'<text x="{svg_W-mr-156:.0f}" y="{ly+3}">PF_inter</text>')
s.append(f'<line x1="{svg_W-mr-110:.0f}" x2="{svg_W-mr-90:.0f}" y1="{ly+18}" y2="{ly+18}" stroke="#d62728" stroke-width="2"/>')
s.append(f'<text x="{svg_W-mr-86:.0f}" y="{ly+21}">PD_inter</text>')
s.append(f'<line x1="{svg_W-mr-180:.0f}" x2="{svg_W-mr-160:.0f}" y1="{ly+36}" y2="{ly+36}" stroke="#2ca02c" stroke-width="2" stroke-dasharray="4,3"/>')
s.append(f'<text x="{svg_W-mr-156:.0f}" y="{ly+39}">primary first century</text>')
s.append('</svg>')
(FIG / "pottery_pf_pd.svg").write_text("\n".join(s))
