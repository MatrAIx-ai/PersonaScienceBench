print("\n========== STAGE B — chi-square ==========")
cont = agg[['sum_gard','sum_unint','sum_agfo']].values
chi2, p_chi2, dof, expected = ss.chi2_contingency(cont)
n_total = cont.sum()
cramers_v = float(np.sqrt(chi2 / (n_total * (min(cont.shape)-1))))
print(f"chi2={chi2:.3f}  df={dof}  p={p_chi2:.4g}  V={cramers_v:.3f}")
resid_std = (cont - expected) / np.sqrt(expected)
habitats = list(agg.index)
pathways = ['Gardening','Unintentional','AgriForest']
resid_df = pd.DataFrame(resid_std, index=habitats, columns=pathways).round(2)
print("\nStandardised (Pearson) residuals:")
print(resid_df.to_string())

print("\nFisher per habitat (gardening vs non-gardening vs column marginal):")
records = []
for h in habitats:
    a = int(agg.loc[h,'sum_gard']); b = int(agg['sum_gard'].sum()-a)
    c = int(agg.loc[h,'total_n']-a)
    d = int((agg['total_n'].sum()-agg.loc[h,'total_n'])-b)
    table = [[a,b],[c,d]]
    odds, p_f = ss.fisher_exact(table)
    records.append({'habitat':h,'OR_gard':odds,'Fisher_p':p_f,
                    'p_gard': a/(a+c) if (a+c)>0 else np.nan,
                    'n_in_habitat': a+c})
    print(f"  {h:22s}  OR={odds:6.3f}  p={p_f:.4g}  p_gard={a/(a+c):.3f}")
