# STAGE C — Clustering on pathway composition (scipy-based)
# ------------------------------------------------------------------
print("\n========== STAGE C ==========")
P = agg[['p_gard','p_unint','p_agfo']].fillna(0).values
# z-standardise
Z = (P - P.mean(axis=0)) / P.std(axis=0, ddof=0)
# PCA via SVD on centred matrix
Zc = Z - Z.mean(axis=0)
U, S, Vt = np.linalg.svd(Zc, full_matrices=False)
scores = Zc @ Vt.T[:, :2]
explained = (S**2) / (S**2).sum()
print(f"PCA explained variance (top 2 PCs): {explained[:2].round(3)}")
loadings = Vt[:2, :]
print("Loadings (rows PC1/PC2; cols [p_gard, p_unint, p_agfo]):")
print(pd.DataFrame(loadings, columns=['p_gard','p_unint','p_agfo'],
                   index=['PC1','PC2']).round(3).to_string())

# Hierarchical clustering (Ward) on Euclidean distance of Z
Dmat = pdist(Z, metric='euclidean')
Z_link = sch.linkage(Dmat, method='ward')

def manual_silhouette(Z, labels):
    n = len(Z)
    labs = np.asarray(labels)
    distinct = np.unique(labs)
    if len(distinct) < 2 or len(distinct) >= n:
        return -1.0
    D = squareform(pdist(Z, 'euclidean'))
    s_vals = []
    for i in range(n):
        same = np.where(labs == labs[i])[0]
        same = same[same != i]
        a = D[i, same].mean() if len(same) > 0 else 0.0
        b = np.inf
        for k in distinct:
            if k == labs[i]: continue
            other = np.where(labs == k)[0]
            b = min(b, D[i, other].mean())
        s = (b - a) / max(a, b) if max(a, b) > 0 else 0.0
        s_vals.append(s)
    return float(np.mean(s_vals))

sil = {}
for k in range(2, 6):
    labs = sch.fcluster(Z_link, t=k, criterion='maxclust')
    sil[k] = manual_silhouette(Z, labs)
    print(f"k={k}  silhouette={sil[k]:.3f}")
best_k = max(sil, key=sil.get)
labs_best = sch.fcluster(Z_link, t=best_k, criterion='maxclust')

hab_clusters = pd.DataFrame({
    'habitat' : habitats,
    'cluster' : labs_best,
    'p_gard'  : agg['p_gard'].values,
    'p_unint' : agg['p_unint'].values,
    'p_agfo'  : agg['p_agfo'].values,
    'PC1'     : scores[:,0],
    'PC2'     : scores[:,1]
}).sort_values(['cluster','p_gard'], ascending=[True,False])
