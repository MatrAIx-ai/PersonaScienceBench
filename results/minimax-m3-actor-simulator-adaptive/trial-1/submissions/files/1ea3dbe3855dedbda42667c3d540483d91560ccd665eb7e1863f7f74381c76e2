formula_bin = 'pres_gard ~ C(habitat) + elevation + urban_2009_500m + cropland_2009_500m + annual_temperature + annual_rainfall'
formula_nb  = 'Q("n.gard") ~ C(habitat) + elevation + urban_2009_500m + cropland_2009_500m + annual_temperature + annual_rainfall'

