        fh.write(mdf.summary().as_text()); fh.write("\n")
    print("\nMixedLM (Linear LMM): converged=", mdf.converged, "AIC=", round(mdf.aic,1))
    _co = pd.DataFrame({'coef':mdf.fe_params,'SE':mdf.bse_fe,'z':mdf.tvalues,'p':mdf.pvalues}).round(4)
    print(_co.to_string())
