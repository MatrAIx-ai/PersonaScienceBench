        _co = pd.DataFrame({'coef':bi.params,'SE':bi.bse,'z':bi.tvalues,'p':bi.pvalues}).round(3)
        print(_co.to_string())
    except Exception as e:
        bi=None; print(f"Bin GLM failed: {e}"); fh.write(f"Bin failed: {e}\n")

# MixedLM as a random-intercept sanity check on log(1+n.gard) at the plot scale
