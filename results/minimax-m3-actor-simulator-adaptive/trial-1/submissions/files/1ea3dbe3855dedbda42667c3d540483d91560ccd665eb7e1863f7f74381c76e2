print("\n========== STAGE A ==========")

def habitat_aggregates(df):
    g = df.groupby('habitat')
    out = pd.DataFrame({
        'n_plots'  : g.size(),
        'total_n'  : g['n.total'].sum(),
        'sum_gard' : g['n.gard'].sum(),
        'sum_unint': g['n.unint'].sum(),
        'sum_agfo' : g['n.agfo'].sum(),
        'zero_total_plots': g['n.total'].apply(lambda x: int((x==0).sum())),
        'mean_n_total'    : g['n.total'].mean(),
        'mean_n_gard'     : g['n.gard'].mean(),
        'mean_n_unint'    : g['n.unint'].mean(),
        'mean_n_agfo'     : g['n.agfo'].mean(),
    })
    out['p_gard']  = (out['sum_gard']  / out['total_n']).replace([np.inf,-np.inf], np.nan)
    out['p_unint'] = (out['sum_unint'] / out['total_n']).replace([np.inf,-np.inf], np.nan)
    out['p_agfo']  = (out['sum_agfo']  / out['total_n']).replace([np.inf,-np.inf], np.nan)
    out['dom_rank_gard'] = out[['p_gard','p_unint','p_agfo']].rank(axis=1, ascending=False)['p_gard'].astype(int)
    return out

