print(agg.round(3).to_string())

rng = np.random.default_rng(42)
B = 2000
ci_records = []
for h, sub in in_.groupby('habitat'):
    b_p, b_mu = [], []
    for _ in range(B):
        idx = rng.integers(0, len(sub), size=len(sub))
        b = sub.iloc[idx]
