    lr = smf.logit(formula_lr, data=sp_lr).fit(disp=False)
    print(f"Logit converged={lr.mle_retvals.get('converged',False)} AIC={lr.aic:.1f}")
    _co = pd.DataFrame({'coef':lr.params,'SE':lr.bse,'z':lr.tvalues,'p':lr.pvalues}).round(3)
