        'p_gard'       : agg.loc[h,'p_gard'],
        'p_gard_lo95'  : float(np.nanpercentile(arr_p,2.5)),
        'p_gard_hi95'  : float(np.nanpercentile(arr_p,97.5)),
        'mu_gard'      : agg.loc[h,'mean_n_gard'],
        'mu_gard_lo95' : float(np.nanpercentile(arr_mu,2.5)),
        'mu_gard_hi95' : float(np.nanpercentile(arr_mu,97.5)),
