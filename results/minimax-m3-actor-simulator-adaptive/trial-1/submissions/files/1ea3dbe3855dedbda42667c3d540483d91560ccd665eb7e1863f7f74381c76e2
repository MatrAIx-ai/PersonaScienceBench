    fh.write("Stage D : Plot-level GLMs\n=========================\n")
    fh.write(f"Rows used: {len(df_model)}/{len(in_)}\n\n")

    try:
        nb = smf.glm(formula_nb, data=df_model, family=sm.families.NegativeBinomial()).fit()
        fh.write("--- Negative Binomial GLM  (n.gard) ---\n")
        fh.write(nb.summary().as_text()); fh.write("\n\n")
        print("NB GLM:", "converged" if nb.converged else "NOT converged",
              f"AIC={nb.aic:.1f}")
        _co = pd.DataFrame({'coef':nb.params,'SE':nb.bse,'z':nb.tvalues,'p':nb.pvalues}).round(3)
        print(_co.to_string())
    except Exception as e:
        nb=None; print(f"NB GLM failed: {e}"); fh.write(f"NB failed: {e}\n\n")

    try:
        bi = smf.glm(formula_bin, data=df_model, family=sm.families.Binomial()).fit()
        fh.write("--- Binomial GLM (presence/absence) ---\n")
        fh.write(bi.summary().as_text()); fh.write("\n\n")
        print("\nBinomial GLM:", "converged" if bi.converged else "NOT converged",
