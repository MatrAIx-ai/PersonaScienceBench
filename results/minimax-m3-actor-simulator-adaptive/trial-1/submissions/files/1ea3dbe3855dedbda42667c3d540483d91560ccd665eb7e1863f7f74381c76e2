def mean_within(labels, D):
    if len(labels) < 2: return np.nan
    sub = D.loc[labels, labels].values
    iu = np.triu_indices_from(sub, k=1)
    return float(sub[iu].mean())

matched_sp = sp[sp['phylo.tip.label'].isin(D_phylo.index)].copy()
common = [l for l in D_phylo.index if l in set(matched_sp['phylo.tip.label'])]
D_sub = D_phylo.loc[common, common]
labels_g = [l for l in matched_sp.loc[matched_sp['Gardening']==1,'phylo.tip.label'] if l in D_sub.index]
labels_u = [l for l in matched_sp.loc[matched_sp['Unintentional']==1,'phylo.tip.label'] if l in D_sub.index]
labels_a = [l for l in matched_sp.loc[matched_sp['AgriForest']==1,'phylo.tip.label'] if l in D_sub.index]
print(f"\nMatched-for-phylo: Gardening={len(labels_g)}, Unintentional={len(labels_u)}, AgriForest={len(labels_a)}")

obs_g = mean_within(labels_g, D_sub)
obs_u = mean_within(labels_u, D_sub)
print(f"Mean patristic within Gardening     : {obs_g:.3f}")
print(f"Mean patristic within Unintentional : {obs_u:.3f}")

def cluster_p(group_a, all_labels, D_full, B=1999, seed=0):
    rng = np.random.default_rng(seed)
    obs = mean_within(group_a, D_full)
    ge = 0
    for _ in range(B):
        samp = list(rng.choice(all_labels, size=len(group_a), replace=False))
        v = mean_within(samp, D_full)
        if v <= obs: ge += 1
    return (ge+1)/(B+1)

p_g = cluster_p(labels_g, common, D_sub, B=1999, seed=11) if len(labels_g)>=2 else None
p_u = cluster_p(labels_u, common, D_sub, B=1999, seed=23) if len(labels_u)>=2 else None
