# ------------------------------------------------------------------
# Tiny Newick parser
# ------------------------------------------------------------------
def parse_newick(s: str):
    s = s.strip()
    if s.endswith(';'): s = s[:-1]
    pos = [0]
    def read_length():
        if pos[0] < len(s) and s[pos[0]] == ':':
            pos[0] += 1
            start = pos[0]
            if pos[0] < len(s) and s[pos[0]] == '-': pos[0] += 1
            while pos[0] < len(s) and (s[pos[0]].isdigit() or s[pos[0]] in '.eE+'):
                pos[0] += 1
            try:
                return float(s[start:pos[0]])
            except Exception:
                return 0.0
        return 0.0
    def read_name():
        if pos[0] >= len(s): return None
        ch = s[pos[0]]
        if ch in ',()': return None
        if ch in ":;": return None
        start = pos[0]
        while pos[0] < len(s) and s[pos[0]] not in ',():;':
            pos[0] += 1
        return s[start:pos[0]]
    def parse_subtree():
        if pos[0] < len(s) and s[pos[0]] == '(':
            pos[0] += 1
            children = []
            children.append(parse_subtree())
            while pos[0] < len(s) and s[pos[0]] == ',':
                pos[0] += 1
                children.append(parse_subtree())
            if pos[0] < len(s) and s[pos[0]] == ')': pos[0] += 1
            name = read_name()
            length = read_length()
            return ('internal', name, length, children)
        else:
            name = read_name()
            length = read_length()
            return ('leaf', name, length, [])
    return parse_subtree()

def pairwise_patristic(root, names_subset=None):
    leaf_paths = {}
    def collect(n, path):
        path_edges = path + [(n, n[2])]
        if n[0] == 'leaf':
            dist = sum(L for _, L in path_edges if L is not None)
            leaf_paths[n[1]] = (path_edges, dist)
        else:
            for c in n[3]: collect(c, path_edges)
    collect(root, [])
    if names_subset is None:
        all_names = [n for n in leaf_paths.keys() if n is not None]
    else:
        all_names = [n for n in names_subset if n in leaf_paths]
    mat = pd.DataFrame(0.0, index=all_names, columns=all_names)
    for i, ni in enumerate(all_names):
        edges_i, dist_i = leaf_paths[ni]
        path_set_i = set(id(e[0]) for e in edges_i)
        for nj in all_names[i+1:]:
            edges_j, dist_j = leaf_paths[nj]
            path_set_j = set(id(e[0]) for e in edges_j)
            shared = 0.0
            for e, L in edges_i:
                if L is not None and id(e) in path_set_j:
                    shared += L
            d = dist_i + dist_j - 2*shared
            mat.loc[ni, nj] = d
            mat.loc[nj, ni] = d
    return mat

def leaf_names_of(node):
    out = []
    def walk(n):
        if n[0] == 'leaf': out.append(n[1])
        else:
            for c in n[3]: walk(c)
    walk(node)
    return out

