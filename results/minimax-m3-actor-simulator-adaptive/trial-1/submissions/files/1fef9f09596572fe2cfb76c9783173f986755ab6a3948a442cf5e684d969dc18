import pandas as pd
import numpy as np
DATA = "/workspace/data"

df_in = pd.read_csv(f"{DATA}/invaded_niche_pathways.csv", sep="\t")
df_in.columns = [c.strip().strip('"').strip() for c in df_in.columns]
for c in df_in.columns:
    if df_in[c].dtype == object:
        df_in[c] = df_in[c].astype(str).str.strip().str.strip('"').str.strip()
        try: df_in[c] = pd.to_numeric(df_in[c])
        except: pass

# Full Spearman including 500m, 1000m
for buf in ['50m','500m','1000m']:
    u = df_in[f'urban.2009.{buf}']
    c_ = df_in[f'cropland.2009.{buf}']
    print(f"\n=== buffer {buf} ===")
    print("Spearman vs urban.2009:")
    for name, s in [('n.gard',df_in['n.gard']),('n.unint',df_in['n.unint']),
                    ('n.agfo',df_in['n.agfo']),('n.total',df_in['n.total'])]:
        print(f"  {name:8s}  rho(gard)=  {s.corr(u,'spearman'):+.3f}")
    print("Spearman vs cropland.2009:")
    for name, s in [('n.gard',df_in['n.gard']),('n.unint',df_in['n.unint']),
                    ('n.agfo',df_in['n.agfo']),('n.total',df_in['n.total'])]:
        print(f"  {name:8s}  rho(crp)=   {s.corr(c_,'spearman'):+.3f}")

# Mixed habitat table (the obvious aggregation for the hypothesis)
print("\n--- HABITAT-level aggregates ---")
ag = df_in.groupby('habitat').agg(
    n_rows=('n.total','size'),
    sum_gard=('n.gard','sum'),
    sum_unint=('n.unint','sum'),
    sum_agfo=('n.agfo','sum'),
    sum_total=('n.total','sum'),
    mean_urban2009_50m=('urban.2009.50m','mean'),
    mean_urban2009_500m=('urban.2009.500m','mean'),
    mean_urban2009_1000m=('urban.2009.1000m','mean'),
    mean_crp2009_500m=('cropland.2009.500m','mean'),
    mean_urban1956_500m=('urban.1956.500m','mean'),
    mean_crp1956_500m=('cropland.1956.500m','mean'),
    mean_progressive_1956_2009=('progressive.1956.2009.50m','mean'),
    mean_regressive_1956_2009 =('regressive.1956.2009.50m','mean'),
    mean_nochanges_1956_2009  =('no.changes.1956.2009.50m','mean'),
)
ag['p_gard']  = (ag['sum_gard']/ag['sum_total']).round(3)
ag['p_unint'] = (ag['sum_unint']/ag['sum_total']).round(3)
ag['p_agfo']  = (ag['sum_agfo']/ag['sum_total']).round(3)
print(ag.to_string())

# Correlation among the 10 habitats: pathway-fractions vs urban
print("\nCorrelations across the 10 habitat means:")
m = ag[['p_gard','p_unint','p_agfo','sum_total',
        'mean_urban2009_500m','mean_urban1956_500m',
        'mean_crp2009_500m','mean_crp1956_500m']].copy()
print(m.corr(method='spearman').round(3))

# Also the row-level on only "active" rows (n.total>0)
act = df_in[df_in['n.total']>0].copy()
print(f"\nactive rows (n.total>0): {len(act)}/{len(df_in)}")
print("Sum across active rows: gard={} unint={} agfo={} total={}".
      format(act['n.gard'].sum(), act['n.unint'].sum(), act['n.agfo'].sum(), act['n.total'].sum()))
for buf in ['500m']:
    u = act[f'urban.2009.{buf}']
    c_ = act[f'cropland.2009.{buf}']
    print(f"\nACTIVE rows only, buffer {buf}:")
    for name, s in [('n.gard',act['n.gard']),('n.unint',act['n.unint']),
                    ('n.agfo',act['n.agfo'])]:
        rho_u = s.corr(u,'spearman')
        rho_c = s.corr(c_,'spearman')
        rho_p = s.corr(df_in.loc[act.index,'no.changes.1956.2009.50m'],'spearman')
        print(f"  {name:8s}  rho(urban09)={rho_u:+.3f}  rho(crp09)={rho_c:+.3f}  rho(no.changes)={rho_p:+.3f}")

# Quick sanity: phylogenetic signal in pathways?
df_is = pd.read_csv(f"{DATA}/invasion_success_pathways.csv")
print(f"\ninvasion_success rows: {len(df_is)}; intro.pathway counts:\n{df_is['intro.pathway'].value_counts()}")
# Mean values per pathway
print(df_is.groupby('intro.pathway')[['number.of.invaded.plots','habitat.range',
    'invaded.niche.breadth','mrt','height']].mean().round(2).to_string())
