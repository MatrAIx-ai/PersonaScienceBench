import pandas as pd
import numpy as np

df = pd.read_csv('/workspace/data/nls_ses_processed.csv', index_col=0)
print("=== Shape ===")
print(df.shape)
print("\n=== Dtypes ===")
print(df.dtypes)
print("\n=== Head ===")
print(df.head(3))
print("\n=== SAMPLE_RACE value_counts (incl NA) ===")
print(df['SAMPLE_RACE'].value_counts(dropna=False))
print("\n=== SAMPLE_SEX value_counts (incl NA) ===")
print(df['SAMPLE_SEX'].value_counts(dropna=False))

print("\n=== NA counts per column ===")
print(df.isna().sum())
print("\n=== Total rows with any NA ===")
print(df.isna().any(axis=1).sum())

print("\n=== BA DEGREE COMPLETED distribution (incl NA, raw) ===")
print(df['BA DEGREE COMPLETED'].value_counts(dropna=False))

# SES descriptive
print("\n=== SES describe ===")
print(df['SES'].describe())
print("\n=== SES quantiles 0, .1, .25, .5, .75, .9, 1 ===")
print(df['SES'].quantile([0, .1, .25, .5, .75, .9, 1]))
print("\n=== SES unique count ===")
print(df['SES'].nunique(), "unique SES values out of", len(df))
print("First 10 unique SES values sorted:")
print(sorted(df['SES'].dropna().unique())[:10])
print("Last 10 unique SES values sorted:")
print(sorted(df['SES'].dropna().unique())[-10:])

print("\n=== SES by race (describe) ===")
print(df.groupby('SAMPLE_RACE', dropna=False)['SES'].describe())

print("\n=== BA completion rate by race ===")
print(df.groupby('SAMPLE_RACE', dropna=False)['BA DEGREE COMPLETED'].agg(['mean','count','sum']))

print("\n=== Crosstab: race x BA completion (with NA shown) ===")
print(pd.crosstab(df['SAMPLE_RACE'], df['BA DEGREE COMPLETED'], dropna=False, margins=True))

print("\n=== Percentile in class describe ===")
print(df['PERCENTILE IN CLASS'].describe())
print("\n=== Ability describe ===")
print(df['ABILITY: COMPOSITE OF ASVAB SCORE'].describe())
print("\n=== Family size describe ===")
print(df['FAMILY SIZE OF SAMPLE'].describe())
