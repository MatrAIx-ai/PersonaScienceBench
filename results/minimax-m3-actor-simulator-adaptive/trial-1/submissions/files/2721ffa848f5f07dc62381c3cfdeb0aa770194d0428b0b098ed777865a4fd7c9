#!/usr/bin/env python3
"""Render visualization.png from viz_data.json using PIL only."""
import json, sys
from PIL import Image, ImageDraw, ImageFont

def load_font(size):
    try:
        return ImageFont.load_default(size=size)
    except Exception:
        return ImageFont.load_default()

def hex_to_rgb(h):
    return tuple(int(h.lstrip("#")[i:i+2], 16) for i in (0, 2, 4))

PALETTE = ['#1f77b4', '#ff7f0e', '#2ca02c', '#d62728', '#9467bd', '#8c564b']

def auto_scale(vals, vmin=None, vmax=None):
    a = [v for v in vals if v is not None]
    if vmin is None: vmin = min(a)
    if vmax is None: vmax = max(a)
    if vmax - vmin < 1e-12:
        return lambda x: 0.5
    return lambda x: (x - vmin) / (vmax - vmin)

def main(argv):
    if len(argv) < 3:
        print('usage: viz_render.py <viz_data.json> <out.png>', file=sys.stderr)
        sys.exit(2)
    with open(argv[1]) as f:
        D = json.load(f)
    out = argv[2]

    W, H = 1600, 1100
    img  = Image.new('RGB', (W, H), '#FFFFFF')
    draw = ImageDraw.Draw(img)
    f_title = load_font(28)
    f_axes  = load_font(16)
    f_small = load_font(13)

    # 2x2 panel layout: each panel has its own axis area
    pad_l, pad_r, pad_t, pad_b = 70, 30, 70, 50
    panel_w = (W - pad_l - pad_r - 30) // 2
    panel_h = (H - pad_t - pad_b - 30) // 2
    gx, gy = 30, 30

    # --- Panel A (top-left): final lowest-T configuration ------------------
    ax0 = pad_l
    ay0 = pad_t
    ref = D['ref_coords']; fin = D['final_coords_low']
    nref = len(ref); nfin = len(fin)
    nat_pairs = D['nat_pairs']; bb = D['backbone']
    a_panel = (ax0, ay0, ax0 + panel_w, ay0 + panel_h)
    draw.rectangle(a_panel, outline='#444444', width=2)
    draw.text((ax0 + 12, ay0 + 8),
              "A. Final lowest-T config (xy) vs reference (ghost)", fill='#222222',
              font=f_axes)
    # Map both ref and final to the panel with shared scale
    all_x = [p[0] for p in ref] + [p[0] for p in fin]
    all_y = [p[1] for p in ref] + [p[1] for p in fin]
    xmin, xmax = min(all_x), max(all_x)
    ymin, ymax = min(all_y), max(all_y)
    if xmax - xmin < 1e-9: xmax = xmin + 1
    if ymax - ymin < 1e-9: ymax = ymin + 1
    inner = (a_panel[0] + 30, a_panel[1] + 40, a_panel[2] - 15, a_panel[3] - 25)
    def map_xy(x, y):
        u = (x - xmin) / (xmax - xmin)
        v = (y - ymin) / (ymax - ymin)
        return (inner[0] + u * (inner[2] - inner[0]),
                inner[3] - v * (inner[3] - inner[1]))
    # Reference ghost (gray)
    for a, b in bb:
        draw.line([map_xy(ref[a][0], ref[a][1]), map_xy(ref[b][0], ref[b][1])], fill='#BBBBBB', width=1)
    for (a, b) in nat_pairs:
        draw.line([map_xy(ref[a][0], ref[a][1]), map_xy(ref[b][0], ref[b][1])], fill='#E5C7E5', width=1)
    for k in range(nref):
        x, y, _ = ref[k]
        draw.ellipse([map_xy(x, y)[0]-3, map_xy(x, y)[1]-3,
                      map_xy(x, y)[0]+3, map_xy(x, y)[1]+3], fill='#999999', outline='#666666')
    # Final (colored)
    for a, b in bb:
        draw.line([map_xy(fin[a][0], fin[a][1]), map_xy(fin[b][0], fin[b][1])], fill='#3060AA', width=2)
    for (a, b) in nat_pairs:
        d = ((fin[a][0]-fin[b][0])**2 + (fin[a][1]-fin[b][1])**2)**0.5
        if d < D.get('cut', 1e9):
            draw.line([map_xy(fin[a][0], fin[a][1]), map_xy(fin[b][0], fin[b][1])], fill='#D04040', width=1)
    for k in range(nfin):
        x, y, _ = fin[k]
        u, v = map_xy(x, y)
        draw.ellipse([u-4, v-4, u+4, v+4], fill='#FFAA00', outline='#222222')
    draw.text((a_panel[0] + 10, a_panel[3] - 22),
              f"red dashed lines = preserved native contacts (xy proj); "
              f"Jaccard={D['jaccard']:.3f}",
              fill='#444444', font=f_small)

    # --- Panel B (top-right): per-T Q histograms overlay -------------------
    ax1 = pad_l + panel_w + gx
    ay1 = pad_t
    b_panel = (ax1, ay1, ax1 + panel_w, ay1 + panel_h)
    draw.rectangle(b_panel, outline='#444444', width=2)
    draw.text((b_panel[0] + 12, b_panel[1] + 8),
              "B. Normalized Q histograms (each T)", fill='#222222', font=f_axes)
    bin_c = D['q_bin_centers']
    hists = D['hist_q']
    K = len(hists)
    ymax = max(max(h) for h in hists)
    if ymax < 1e-9: ymax = 1.0
    inner_b = (b_panel[0] + 50, b_panel[1] + 40,
               b_panel[2] - 80, b_panel[3] - 35)
    # x in [0,1], y in [0, ymax]
    def map_qhist(x, y):
        u = x
        v = y / ymax
        return (inner_b[0] + u * (inner_b[2] - inner_b[0]),
                inner_b[3] - v * (inner_b[3] - inner_b[1]))
    # axes
    draw.line([(inner_b[0], inner_b[3]), (inner_b[2], inner_b[3])],
              fill='#000000', width=2)
    draw.line([(inner_b[0], inner_b[1]), (inner_b[0], inner_b[3])],
              fill='#000000', width=2)
    # x ticks
    for tx in [0.0, 0.25, 0.5, 0.75, 1.0]:
        px = map_qhist(tx, 0)[0]
        draw.line([(px, inner_b[3]), (px, inner_b[3] + 4)], fill='#000000', width=1)
        draw.text((px-8, inner_b[3] + 6), f'{tx:.2f}', fill='#000000', font=f_small)
    draw.text(((inner_b[0]+inner_b[2])/2 - 30, inner_b[3] + 18),
              'Q (native-contact fraction)', fill='#000000', font=f_small)
    # y ticks
    for ty in [0.0, ymax*0.5, ymax]:
        py = map_qhist(0, ty)[1]
        draw.line([(inner_b[0]-4, py), (inner_b[0], py)], fill='#000000', width=1)
        draw.text((inner_b[0]-46, py-7), f'{ty:.2f}', fill='#000000', font=f_small)
    draw.text((inner_b[0]-46, inner_b[1]-4), 'P(Q)', fill='#000000', font=f_small)
    # histogram lines + T list in legend
    Ts = D['temperatures']
    for k in range(K):
        col = hex_to_rgb(PALETTE[k % len(PALETTE)])
        pts = []
        prev = None
        # bar polygons
        for j, h in enumerate(hists[k]):
            x_left  = bin_c[j] - 0.01
            x_right = bin_c[j] + 0.01
            p1 = map_qhist(x_left, 0)
            p2 = map_qhist(x_right, h)
            draw.rectangle([p1[0], p2[1], p2[0], p1[1]],
                           outline=col, width=1)
        # smooth line through bin centers
        pts = [map_qhist(bin_c[j], hists[k][j]) for j in range(len(hists[k]))]
        if len(pts) >= 2:
            draw.line(pts, fill=col, width=2)
        # legend
        leg_x = inner_b[2] + 12
        leg_y = inner_b[1] + 8 + k * 18
        draw.line([(leg_x, leg_y+8), (leg_x+20, leg_y+8)], fill=col, width=3)
        draw.text((leg_x+24, leg_y), f'T={Ts[k]:.4f}', fill='#000000', font=f_small)

    # --- Panel C (bottom-left): heat-capacity curve C(T) -------------------
    ax2 = pad_l
    ay2 = pad_t + panel_h + gy
    c_panel = (ax2, ay2, ax2 + panel_w, ay2 + panel_h)
    draw.rectangle(c_panel, outline='#444444', width=2)
    draw.text((c_panel[0] + 12, c_panel[1] + 8),
              "C. Heat capacity C(T) = var(E)/kB T^2  (peak = cross-check)",
              fill='#222222', font=f_axes)
    inner_c = (c_panel[0] + 70, c_panel[1] + 40,
               c_panel[2] - 20, c_panel[3] - 35)
    Tf = D['T_fine']; Cf = D['C_fine']
    Cd = D['C_direct']
    peak_idx = int(max(range(len(Cf)), key=lambda i: Cf[i]))
    T_min = min(Tf); T_max = max(Tf)
    C_min = 0.0; C_max = max(max(Cf), max(Cd))
    if C_max < 1e-9: C_max = 1.0
    def map_heat(x, y):
        u = (x - T_min) / (T_max - T_min)
        v = y / C_max
        return (inner_c[0] + u * (inner_c[2] - inner_c[0]),
                inner_c[3] - v * (inner_c[3] - inner_c[1]))
    # axes
    draw.line([(inner_c[0], inner_c[3]), (inner_c[2], inner_c[3])], fill='#000000', width=2)
    draw.line([(inner_c[0], inner_c[1]), (inner_c[0], inner_c[3])], fill='#000000', width=2)
    # x ticks (5)
    Nticks = 5
    for i in range(Nticks+1):
        tx = T_min + (T_max - T_min) * i / Nticks
        px = map_heat(tx, 0)[0]
        draw.line([(px, inner_c[3]), (px, inner_c[3]+4)], fill='#000000', width=1)
        draw.text((px - 18, inner_c[3] + 6), f'{tx:.2f}', fill='#000000', font=f_small)
    draw.text(((inner_c[0]+inner_c[2])/2 - 10, inner_c[3] + 18),
              'T (reduced)', fill='#000000', font=f_small)
    # y ticks
    for i in range(6):
        ty = C_max * i / 5
        py = map_heat(0, ty)[1]
        draw.line([(inner_c[0]-4, py), (inner_c[0], py)], fill='#000000', width=1)
        draw.text((inner_c[0]-50, py-7), f'{ty:.2f}', fill='#000000', font=f_small)
    draw.text((inner_c[0]-60, inner_c[1]-4), 'C(T)', fill='#000000', font=f_small)
    # direct values as scatter points
    for k, T in enumerate(D['temperatures']):
        u, v = map_heat(T, Cd[k])
        draw.ellipse([u-5, v-5, u+5, v+5], fill='#222222', outline='#000000')
        draw.text((u+6, v-7), f'{Cd[k]:.2f}', fill='#222222', font=f_small)
    # interpolated curve
    pts = [map_heat(Tf[j], Cf[j]) for j in range(len(Tf))]
    if len(pts) >= 2:
        draw.line(pts, fill='#D04040', width=2)
    # T* vertical
    Tstar = D['T_star']
    ps = map_heat(Tstar, 0)
    draw.line([(ps[0], inner_c[1]), (ps[0], inner_c[3])],
              fill='#1f77b4', width=2)
    draw.text((ps[0] + 4, inner_c[1] + 4),
              f'T*={Tstar:.3f}\n<q(T*)>=0.5', fill='#1f77b4', font=f_small)
    # peak
    pp = map_heat(Tf[peak_idx], Cf[peak_idx])
    draw.ellipse([pp[0]-6, pp[1]-6, pp[0]+6, pp[1]+6],
                 outline='#2ca02c', width=2)
    draw.text((pp[0]+8, pp[1]-7),
              f'C peak @ T={Tf[peak_idx]:.3f}\nCpeak={Cf[peak_idx]:.3f}',
              fill='#2ca02c', font=f_small)

    # --- Panel D (bottom-right): F(Q) landscape at T* ---------------------
    ax3 = pad_l + panel_w + gx
    ay3 = pad_t + panel_h + gy
    d_panel = (ax3, ay3, ax3 + panel_w, ay3 + panel_h)
    draw.rectangle(d_panel, outline='#444444', width=2)
    draw.text((d_panel[0] + 12, d_panel[1] + 8),
              "D. Free-energy F(Q) at T* (histogram + log-ratio)",
              fill='#222222', font=f_axes)
    Fc = D['F_centers']; Fq = D['F_q']
    ymax_F = max(Fq) if max(Fq) > 0 else 1.0
    inner_d = (d_panel[0] + 60, d_panel[1] + 40,
               d_panel[2] - 20, d_panel[3] - 50)
    def map_FQ(x, y):
        u = x
        v = y / ymax_F
        return (inner_d[0] + u * (inner_d[2] - inner_d[0]),
                inner_d[3] - v * (inner_d[3] - inner_d[1]))
    # axes
    draw.line([(inner_d[0], inner_d[3]), (inner_d[2], inner_d[3])],
              fill='#000000', width=2)
    draw.line([(inner_d[0], inner_d[1]), (inner_d[0], inner_d[3])],
              fill='#000000', width=2)
    for tx in [0.0, 0.25, 0.5, 0.75, 1.0]:
        px = map_FQ(tx, 0)[0]
        draw.line([(px, inner_d[3]), (px, inner_d[3]+4)], fill='#000000', width=1)
        draw.text((px-8, inner_d[3]+6), f'{tx:.2f}', fill='#000000', font=f_small)
    draw.text(((inner_d[0]+inner_d[2])/2 - 8, inner_d[3] + 18),
              'Q', fill='#000000', font=f_small)
    Nticks = 5
    for i in range(Nticks+1):
        ty = ymax_F * i / Nticks
        py = map_FQ(0, ty)[1]
        draw.line([(inner_d[0]-4, py), (inner_d[0], py)], fill='#000000', width=1)
        draw.text((inner_d[0]-46, py-7), f'{ty:.2f}', fill='#000000', font=f_small)
    draw.text((inner_d[0]-50, inner_d[1]-4), 'F(Q)', fill='#000000', font=f_small)
    # bars
    for j, fv in enumerate(Fq):
        p1 = map_FQ(Fc[j] - 0.005, 0)
        p2 = map_FQ(Fc[j] + 0.005, fv)
        if p2[1] < inner_d[1]:
            # outside top: clamp
            x1, y1 = map_FQ(Fc[j] - 0.005, ymax_F)
            x2, y2 = map_FQ(Fc[j] + 0.005, ymax_F)
            draw.rectangle([x1, inner_d[1]-2, x2, inner_d[3]], fill='#777777', outline='#555555')
        else:
            draw.rectangle([p1[0], p2[1], p2[0], p1[1]],
                           fill='#9CCEFF', outline='#1f77b4')
    # line through centers
    pts = [map_FQ(Fc[j], Fq[j]) for j in range(len(Fc))]
    if len(pts) >= 2:
        draw.line(pts, fill='#1f77b4', width=2)
    # mode markers
    for m in D['transition_modes']:
        u = map_FQ(m, 0)[0]
        draw.line([(u, inner_d[1]), (u, inner_d[3])], fill='#D04040', width=1)
        draw.text((u-10, inner_d[1] - 16), f'm={m:.2f}', fill='#D04040', font=f_small)
    # summary banner
    summary = (f"T*={D['T_star']:.4f}   T_close={D['T_close']:.4f}   "
               f"modes={[round(m,3) for m in D['transition_modes']]}   "
               f"sep={D['mode_separation']:.3f}   "
               f"barrier={D['barrier_kT']:.2f} kBT*   "
               f"Jaccard={D['jaccard']:.3f}")
    draw.text((d_panel[0] + 10, d_panel[3] - 22), summary,
              fill='#222222', font=f_small)

    # Title
    draw.text((W//2 - 360, 18),
              "B3 Go-model stochastic dynamics: low-N chain, K=6 BAOAB runs (re-init)",
              fill='#111111', font=f_title)

    img.save(out, 'PNG')
    print('wrote', out)

if __name__ == '__main__':
    main(sys.argv)
