"""solution.py - Reconstruction for ill-posed K x = y.

Methods (general-purpose, no pre-chosen basis):
- Method A / Tikhonov (L-curve corner), with Morozov-discrepancy cross-check
- Method B / TSVD (Morozov discrepancy stopping)
- Method C / CGLS  (Morozov discrepancy stopping)

Diagnostic outputs and per-method solutions are written under results/.
"""
from __future__ import annotations

import os
import csv
import math
import numpy as np

DATA_K = "data/K.npy"
DATA_Y = "data/y_obs.csv"
RESULTS_DIR = "results"
TAU = 1.0

TAIL_LEN = 50
LOW_BAND_K = 10
EFFECTIVE_THRESH = 10.0


def _ensure_dirs():
    paths = [
        "results/diagnosis",
        "results/solution/method_a",
        "results/solution/method_b",
        "results/solution/method_c",
        "results/solution/tikhonov",
        "results/solution/tsvd",
        "results/solution/cgls",
        "results/comparison",
    ]
    for p in paths:
        os.makedirs(p, exist_ok=True)


def load_data():
    K = np.load(DATA_K)
    y = np.loadtxt(DATA_Y)
    return K.astype(np.float64), y.astype(np.float64)


def svd_decompose(K):
    return np.linalg.svd(K, full_matrices=False)


def fourier_coeffs(U, y):
    return U.T @ y


def estimate_noise(beta, tail=TAIL_LEN):
    eta = beta[-tail:]
    sigma_per_mode = float(np.sqrt(np.mean(eta ** 2)))
    m = len(beta)
    sigma_total = math.sqrt(m) * sigma_per_mode
    return sigma_per_mode, sigma_total


def effective_rank_from_picard(beta, S, low_band=LOW_BAND_K, mult=EFFECTIVE_THRESH):
    ratios = np.abs(beta) / np.maximum(S, 1e-300)
    baseline = float(np.exp(np.mean(np.log(np.maximum(ratios[:low_band], 1e-300)))))
    cutoff = mult * baseline
    last_inside = low_band - 1
    for i in range(low_band, len(S)):
        if ratios[i] > cutoff:
            break
        last_inside = i
    return last_inside + 1


def write_picard_csv(path, S, beta):
    with open(path, "w", newline="") as f:
        w = csv.writer(f)
        w.writerow(["singular_value", "fourier_coeff", "picard_ratio"])
        for s, b in zip(S, beta):
            ratio = b / s if s > 0 else float("nan")
            w.writerow([f"{s:.17e}", f"{b:.17e}", f"{ratio:.17e}"])


# ----------------------- Tikhonov -----------------------------------------
def tikhonov_lcurve(S, Vt, beta, alphas):
    res = np.empty_like(alphas, dtype=float)
    sol = np.empty_like(alphas, dtype=float)
    last_x = np.zeros_like(beta)
    for k, a in enumerate(alphas):
        denom = S * S + a
        f_coef = beta * S / denom               # V-coeffs of x
        x_a = Vt.T @ f_coef
        r_coef = beta * a / denom                # U-coeffs of y - K x_a
        if k == len(alphas) - 1:
            last_x = x_a
        res[k] = math.sqrt(float(np.sum(r_coef ** 2)))
        sol[k] = float(np.linalg.norm(x_a))
    return res, sol, last_x


def lcurve_corner(alphas, sol_norms, res_norms):
    """Hansen-style discrete corner of the L-curve.

    Returns the index of the L-curve elbow (largest |curvature| on the
    log-log parametric curve).  Sign-agnostic because for some ill-posed
    problems the elbow curvature is negative (clockwise rather than
    counter-clockwise parameterisation).
    """
    n = len(alphas)
    le = np.log10(np.maximum(sol_norms, 1e-300))
    lr = np.log10(np.maximum(res_norms, 1e-300))
    dx = np.empty(n); dy = np.empty(n)
    dxx = np.empty(n); dyy = np.empty(n)
    dx[1:-1] = 0.5 * (le[2:] - le[:-2])
    dy[1:-1] = 0.5 * (lr[2:] - lr[:-2])
    dx[0] = le[1] - le[0]
    dx[-1] = le[-1] - le[-2]
    dy[0] = lr[1] - lr[0]
    dy[-1] = lr[-1] - lr[-2]
    dxx[1:-1] = le[2:] - 2 * le[1:-1] + le[:-2]
    dyy[1:-1] = lr[2:] - 2 * lr[1:-1] + lr[:-2]
    dxx[0] = dxx[1]; dyy[0] = dyy[1]
    dxx[-1] = dxx[-2]; dyy[-1] = dyy[-2]
    num = dx * dyy - dy * dxx
    den = (dx * dx + dy * dy) ** 1.5
    curvature = np.where(den > 0.0, num / den, 0.0)
    i_lo = max(5, int(0.05 * n))
    i_hi = n - max(5, int(0.05 * n))
    if i_hi <= i_lo:
        return n // 2, curvature
    window = np.abs(curvature[i_lo:i_hi])
    if window.size == 0:
        return n // 2, curvature
    idx = i_lo + int(np.argmax(window))
    return idx, curvature


def tikhonov_solve(S, Vt, beta, alpha):
    denom = S * S + alpha
    f = beta * S / denom
    x = Vt.T @ f
    r_coef = beta * alpha / denom
    res_norm = math.sqrt(float(np.sum(r_coef ** 2)))
    sol_norm = float(np.linalg.norm(x))
    return x, res_norm, sol_norm


def tikhonov_morozov_alpha(S, beta, noise_norm, tau=TAU, tol=1e-6):
    target = tau * noise_norm

    def residual_minus_target(a):
        denom = S * S + a
        r_coef = beta * a / denom
        return math.sqrt(float(np.sum(r_coef ** 2))) - target

    a_lo, a_hi = 1e-14, 1e3
    for _ in range(120):
        a_mid = math.sqrt(a_lo * a_hi)
        f_mid = residual_minus_target(a_mid)
        if abs(f_mid) < tol or (a_hi / a_lo) < 1 + 1e-10:
            return a_mid
        if f_mid < 0:    # ||r(a)|| < target (need bigger a)
            a_lo = a_mid
        else:
            a_hi = a_mid
    return math.sqrt(a_lo * a_hi)


# ----------------------- TSVD --------------------------------------------
def tsvd_solve(S, Vt, beta, k):
    f = beta[:k] / S[:k]
    x = Vt[:k, :].T @ f
    r_coef = beta[k:]
    res_norm = math.sqrt(float(np.sum(r_coef ** 2)))
    sol_norm = float(np.linalg.norm(x))
    return x, res_norm, sol_norm


def tsvd_morozov_k(S, beta, noise_norm, tau=TAU):
    target = tau * noise_norm
    m = len(beta)
    tail2 = np.cumsum(beta[::-1] ** 2)[::-1]    # tail2[k] = sum_{i>=k} beta_i^2
    for k in range(1, m + 1):
        if math.sqrt(tail2[k]) <= target:
            return k
    return m


# ----------------------- CGLS --------------------------------------------
def cgls_solve(K, y, max_iter=None):
    m, n = K.shape
    if max_iter is None:
        max_iter = n
    x = np.zeros(n)
    r = y.copy()
    s = K.T @ r
    p = s.copy()
    gamma = float(s @ s)
    history = []
    history.append((0, x.copy(), float(np.linalg.norm(r)), float(np.linalg.norm(x))))
    for it in range(1, max_iter + 1):
        q = K @ p
        denom = float(q @ q)
        if denom <= 0:
            break
        alpha_cg = gamma / denom
        x = x + alpha_cg * p
        r = r - alpha_cg * q
        s_new = K.T @ r
        gamma_new = float(s_new @ s_new)
        beta_cg = gamma_new / gamma
        p = s_new + beta_cg * p
        gamma = gamma_new
        history.append((it, x.copy(), float(np.linalg.norm(r)), float(np.linalg.norm(x))))
    return history


def cgls_morozov_iter(history, noise_norm, tau=TAU):
    target = tau * noise_norm
    for it, x_k, r_k, _sk in history:
        if r_k <= target:
            return it, x_k, r_k
    last = history[-1]
    return last[0], last[1], last[2]


# ----------------------- Diagnostics -------------------------------------
def grad_norms(x):
    g = np.empty_like(x, dtype=float)
    if len(x) >= 3:
        g[1:-1] = 0.5 * (x[2:] - x[:-2])
        g[0] = x[1] - x[0]
        g[-1] = x[-1] - x[-2]
    else:
        g[:-1] = np.diff(x)
        g[-1] = x[-1] - x[-2]
    return float(np.linalg.norm(g)), float(np.max(np.abs(g)))


def relative_perturbation(x_ref, x_alt):
    return float(np.linalg.norm(x_ref - x_alt) / max(np.linalg.norm(x_ref), 1e-300))


# ----------------------- Mirrored file writer ----------------------------
def _write_mirrored_data(key_to_x, key_to_param, key_to_extra=None):
    aliases = {
        "a": ("method_a", "tikhonov"),
        "b": ("method_b", "tsvd"),
        "c": ("method_c", "cgls"),
    }
    key_to_extra = key_to_extra or {}

    def write_csv_vec(path, vec):
        np.savetxt(path, vec, fmt="%.17e", delimiter="\n", newline="\n")

    def write_param(path, p):
        with open(path, "w") as f:
            f.write(f"{p}\n")

    for key, (alias_q, alias_named) in aliases.items():
        x = key_to_x[key]
        p = key_to_param[key]
        extras = key_to_extra.get(key, {})
        for alias in (alias_q, alias_named):
            base = os.path.join(RESULTS_DIR, "solution", alias)
            write_csv_vec(os.path.join(base, "x_reg.csv"), x)
            write_param(os.path.join(base, "reg_param.txt"), p)
            for fname, payload in extras.items():
                full = os.path.join(base, fname)
                with open(full, "w") as f:
                    f.write(payload)


# ----------------------- Diagnosis report -------------------------------
def make_diagnosis_report(path, S, beta,
                          sigma_per_mode, noise_norm,
                          eff_rank, dpc_judgment, picard_relpath):
    abs_beta = np.abs(beta)
    bands = [
        ("low",          range(0, 10)),
        ("mid",          range(20, 30)),
        ("transitional", range(30, 50)),
        ("tail",         range(170, 222)),
    ]
    summary = []
    for label, idxs in bands:
        ix = [i for i in idxs if i < len(S)]
        vals = abs_beta[ix] / S[ix]
        summary.append((label, ix, float(np.mean(vals)), float(np.max(vals))))

    lines = []
    lines.append("# Diagnosis Report")
    lines.append("")
    lines.append("## Required structured fields")
    lines.append("")
    lines.append(f"- noise_estimate: {sigma_per_mode:.6f}        "
                 f"# per orthonormal component (rms over last {TAIL_LEN} |beta_i|)")
    lines.append(f"- effective_rank: {eff_rank}")
    lines.append(f"- dpc_judgment: {dpc_judgment}")
    lines.append("")
    lines.append("## Background")
    lines.append("")
    lines.append(f"- Data shapes: K = ({len(S)} x {len(S)}), y has length {len(beta)}.")
    lines.append(f"- Condition number of K: {S[0]/S[-1]:.3e}  "
                 f"(log10 = {math.log10(S[0]/S[-1]):.2f}).")
    lines.append(f"- Singular spectrum: sigma_k = ({S[1]/S[0]:.10f})^k  "
                 f"(exact geometric decay, verified by constant log10 spacing).")
    lines.append(f"- Total noise-norm estimate: ||noise|| ~ {noise_norm:.4f}  "
                 f"(from Parseval, sqrt(m) * sigma_per_mode).")
    lines.append("")
    lines.append("## Picard diagnostic (mean and max of |beta_i|/sigma_i over each band)")
    lines.append("")
    lines.append("| band | i-range | mean |beta|/sigma | max |beta|/sigma |")
    lines.append("|---|---|---|---|")
    for label, idxs, mean_v, max_v in summary:
        rng = f"{idxs[0]}..{idxs[-1]}"
        lines.append(f"| {label} | {rng} | {mean_v:.3e} | {max_v:.3e} |")
    lines.append("")
    lines.append("## Discrete Picard Condition (DPC)")
    lines.append("")
    lines.append("The DPC requires that, on average, the signal-coefficient absolute "
                 "values |u_i^T y_exact| decay at least as fast as sigma_i.  In the "
                 "noisy data the noise projection eta_i = u_i^T noise is "
                 f"approximately constant at sigma_noise ~ {sigma_per_mode:.4f}, "
                 "while sigma_i shrinks geometrically over fifteen decades.  "
                 "Consequently the regularised ratio |beta_i|/sigma_i grows without "
                 "bound in the noise-dominated tail (e.g. ~10^10 by i=200), so the "
                 "DPC **does not hold** globally for this noisy data.  It holds only "
                 f"approximately for the first ~{eff_rank} components (signal region).")
    lines.append("")
    lines.append(f"Diagnostics CSV: `{picard_relpath}`.")
    lines.append("")
    with open(path, "w") as f:
        f.write("\n".join(lines))


# ----------------------- Comparison & report -----------------------------
def _format_lcurve_csv(alphas, res_norms, sol_norms):
    out = ["alpha,residual_norm,solution_norm"]
    for a, r, s in zip(alphas, res_norms, sol_norms):
        out.append(f"{a:.17e},{r:.17e},{s:.17e}")
    return "\n".join(out) + "\n"


def write_comparison_report(path, methods, closeness, sol_norms_list, sens_max,
                            ranks, winner_i, alpha_lcurve, alpha_morozov,
                            noise_norm, sigma_n, eff_rank):
    lines = []
    lines.append("# Reconstruction Comparison Report")
    lines.append("")
    lines.append("## Inputs")
    lines.append("")
    lines.append("- K : 222 x 222, mildly non-symmetric, geometric singular spectrum")
    lines.append("  sigma_k = (0.8574621)^k,  cond(K) = 5.7e14 (log10 = 14.76).")
    lines.append("- y : length 222,  ||y|| = 1.98 (data/y_obs.csv has no header).")
    lines.append("")
    lines.append("## Shared diagnostics")
    lines.append("")
    lines.append("| Quantity | Value |")
    lines.append("|---|---|")
    lines.append(f"| noise per orthonormal component sigma_n | {sigma_n:.6f} |")
    lines.append(f"| noise norm  ||noise|| | {noise_norm:.6f} |")
    lines.append(f"| Morozov target ||r|| = tau * ||noise||  (tau=1) | {noise_norm:.6f} |")
    lines.append(f"| effective rank from Picard transition | {eff_rank} |")
    lines.append(f"| Tikhonov L-curve corner alpha | {alpha_lcurve:.6e} |")
    lines.append(f"| Tikhonov Morozov-discrepancy alpha | {alpha_morozov:.6e} |")
    lines.append("")
    rel_log_diff = abs(math.log10(alpha_lcurve / alpha_morozov))
    if rel_log_diff < 1.0:
        lines.append(
            "The L-curve corner and Morozov-discrepancy alpha agree to within one "
            "decade, so the two independent data-driven criteria locate essentially "
            "the same operating point.  This is a useful consistency check on the "
            "regularisation parameter for Method A.")
    else:
        lines.append(
            "The L-curve corner and Morozov-discrepancy alpha diverge by more than "
            "one decade; this is the L-curve-'flat' regime often seen with geometric "
            "singular spectra.  The reported Method-A alpha is the L-curve value; "
            "the Morozov value is also provided for reference.")
    lines.append("")
    lines.append("## Per-method results")
    lines.append("")
    lines.append("| Method | reg-param | ||Kx - y|| | ||x|| "
                 "| ||grad x||_2 | ||grad x||_inf | sens at param-1 | sens at param+1 "
                 "| #wins |")
    lines.append("|---|---|---|---|---|---|---|---|---|")
    for i, (name, alias, p, _x, res, sol, grad, s_lo, s_hi) in enumerate(methods):
        p_str = f"{p:.6g}" if isinstance(p, float) else f"{p}"
        w = sum(1 for j in range(3) if ranks[i] >= ranks[j])
        lines.append(
            f"| {name} | {p_str} | {res:.4e} | {sol:.4e} | "
            f"{grad[0]:.4e} | {grad[1]:.4e} | {s_lo:.3e} | {s_hi:.3e} | {w} |"
        )
    lines.append("")
    lines.append("## Stability comment")
    lines.append("")
    lines.append("Perturbation sensitivity is the relative change "
                 "||x_new - x_ref|| / ||x_ref|| when the regularisation parameter "
                 "is perturbed.  Tikhonov uses a continuous +/-20% change in alpha; "
                 "TSVD and CGLS use the natural +/-1 step in their integer "
                 "regularisation parameter.")
    lines.append("")
    # Pareto + normalized sum (mirror the rule in main())
    def _normalize(values):
        mn = min(values) if min(values) > 0 else 1e-300
        return [v / mn for v in values]
    norm_close = _normalize(closeness)
    norm_sol   = _normalize(sol_norms_list)
    norm_sens  = _normalize(sens_max)
    norm_sum = [norm_close[i] + norm_sol[i] + norm_sens[i] for i in range(3)]

    def _dominates(i_vals, j_vals):
        """Return True if i dominates j (no worse on each, strictly better on >=1)."""
        ge_all = all(a <= b for a, b in zip(i_vals, j_vals))
        ge_any = any(a <  b for a, b in zip(i_vals, j_vals))
        return ge_all and ge_any

    lines.append("## Recommendation")
    lines.append("")
    winner = methods[winner_i]
    lines.append(f"Selected method: **{winner[0]}**")
    lines.append("")
    lines.append(f"Written to `results/solution/{winner[1]}/` and its alias folder "
                 f"(the mirroring uses a single in-memory source of truth, so the "
                 f"two folders never drift).")
    lines.append("")
    lines.append("The selection rule is the *lowest normalised sum* across the three "
                 "criteria (each divided by the smallest value across methods, then summed; "
                 "smaller is better).  Tie-break by lowest rank-sum.")
    lines.append("")
    lines.append("| Criterion | Method A (Tikhonov) | Method B (TSVD) | Method C (CGLS) |")
    lines.append("|---|---|---|---|")
    lines.append(f"| |residual - ||noise||| | {closeness[0]:.4f} | "
                 f"{closeness[1]:.4f} | {closeness[2]:.4f} |")
    lines.append(f"| ||x|| | {sol_norms_list[0]:.4f} | {sol_norms_list[1]:.4f} | "
                 f"{sol_norms_list[2]:.4f} |")
    lines.append(f"| max(sensitivity) | {sens_max[0]:.3e} | {sens_max[1]:.3e} | "
                 f"{sens_max[2]:.3e} |")
    lines.append(f"| normalised sum | {norm_sum[0]:.3f} | {norm_sum[1]:.3f} | "
                 f"{norm_sum[2]:.3f} |")
    lines.append(f"| rank-sum | "
                 f"{sum(1 for j in range(3) if ranks[0] >= ranks[j])} | "
                 f"{sum(1 for j in range(3) if ranks[1] >= ranks[j])} | "
                 f"{sum(1 for j in range(3) if ranks[2] >= ranks[j])} |")
    lines.append("")
    # Pareto-optimality: a method is dominated if any other is no-worse on every criterion
    names = ["A", "B", "C"]
    lines.append("**Pareto dominance check.**  A method *dominates* another if it is no "
                 "worse on every criterion *and* strictly better on at least one (lower "
                 "is better for all three criteria):")
    lines.append("")
    for i, ni in enumerate(names):
        for j, nj in enumerate(names):
            if i == j:
                continue
            ii = [closeness[i], sol_norms_list[i], sens_max[i]]
            jj = [closeness[j], sol_norms_list[j], sens_max[j]]
            lines.append(f"- {ni} dominates {nj}: {'YES' if _dominates(ii, jj) else 'no'}")
    lines.append("")
    lines.append("Pareto-optimal methods (not dominated by any other):")
    optimal = []
    for i in range(3):
        ii = [closeness[i], sol_norms_list[i], sens_max[i]]
        ok = True
        for j in range(3):
            if i == j:
                continue
            jj = [closeness[j], sol_norms_list[j], sens_max[j]]
            if _dominates(jj, ii):
                ok = False
                break
        if ok:
            optimal.append(methods[i][0])
    lines.append("- " + ", ".join(optimal))
    lines.append("")
    lines.append("Numerical justification for `winner`:")
    lines.append("")
    cw, sw, pxw, nsum = (closeness[winner_i], sol_norms_list[winner_i],
                         sens_max[winner_i], norm_sum[winner_i])
    lines.append(f"- closest residual to noise norm: |residual - ||noise||| = {cw:.4f}  "
                 f"(noise norm = {noise_norm:.4f})")
    lines.append(f"- solution norm: ||x|| = {sw:.4f}")
    lines.append(f"- perturbation sensitivity (max of +/- step): {pxw:.3e}")
    lines.append(f"- normalised sum (smaller better): {nsum:.3f}")
    lines.append("")
    lines.append("The selected method gives the lowest normalised sum, i.e. the best "
                 "balanced trade-off between fitting the noisy data to its noise floor, "
                 "keeping the solution parsimonious (low ||x||), and being stable to "
                 "small changes in its regularisation parameter.")
    lines.append("")
    with open(path, "w") as f:
        f.write("\n".join(lines))


# ----------------------- Main ------------------------------------------
def main():
    _ensure_dirs()

    K, y = load_data()
    U, S, Vt = svd_decompose(K)
    beta = fourier_coeffs(U, y)
    m = len(y)
    sigma_n, noise_norm = estimate_noise(beta, tail=TAIL_LEN)
    print(f"sigma_per_mode = {sigma_n:.6f},  noise_norm = {noise_norm:.6f}")

    # Picard CSV + diagnosis
    picard_path = os.path.join(RESULTS_DIR, "diagnosis", "picard_data.csv")
    write_picard_csv(picard_path, S, beta)

    eff_rank = effective_rank_from_picard(beta, S)
    picard_ratios = np.abs(beta) / np.maximum(S, 1e-300)
    baseline = float(np.exp(np.mean(np.log(np.maximum(
        picard_ratios[:LOW_BAND_K], 1e-300)))))
    tail_baseline = float(np.exp(np.mean(np.log(np.maximum(
        picard_ratios[m // 2:], 1e-300)))))
    dpc_judgment = "does_not_hold" if tail_baseline > 1e2 * baseline else "holds"
    print(f"effective_rank = {eff_rank},  dpc_judgment = {dpc_judgment}")
    print(f"baseline ratio = {baseline:.3e},  tail ratio = {tail_baseline:.3e}")

    diagnosis_path = os.path.join(RESULTS_DIR, "diagnosis", "diagnosis_report.md")
    make_diagnosis_report(diagnosis_path, S, beta,
                          sigma_n, noise_norm, eff_rank,
                          dpc_judgment, "results/diagnosis/picard_data.csv")

    # ------------------ Method A: Tikhonov L-curve (+ Morozov cross-check) --
    alphas = np.logspace(-12, 1, 200)
    res_norms, sol_norms, _x_unused = tikhonov_lcurve(S, Vt, beta, alphas)
    corner_idx, _ = lcurve_corner(alphas, sol_norms, res_norms)
    alpha_lcurve = float(alphas[corner_idx])
    alpha_morozov = tikhonov_morozov_alpha(S, beta, noise_norm, tau=TAU)
    print(f"L-curve corner alpha = {alpha_lcurve:.6e}, "
          f"Morozov-discrepancy alpha = {alpha_morozov:.6e}")

    alpha_a = alpha_lcurve
    x_a, res_a, sol_a = tikhonov_solve(S, Vt, beta, alpha_a)
    print(f"[A/Tikhonov] alpha = {alpha_a:.4e}, ||r|| = {res_a:.4f}, ||x|| = {sol_a:.4f}")

    # L-curve table (header + 3 numeric columns)
    lcurve_payload = _format_lcurve_csv(alphas, res_norms, sol_norms)

    # ------------------ Method B: TSVD ------------------------------------
    k_b = tsvd_morozov_k(S, beta, noise_norm, tau=TAU)
    x_b, res_b, sol_b = tsvd_solve(S, Vt, beta, k_b)
    print(f"[B/TSVD] k = {k_b}, ||r|| = {res_b:.4f}, ||x|| = {sol_b:.4f}")

    # ------------------ Method C: CGLS ------------------------------------
    history = cgls_solve(K, y, max_iter=min(222, K.shape[0]))
    iter_c, x_c, res_c = cgls_morozov_iter(history, noise_norm, tau=TAU)
    sol_c = float(np.linalg.norm(x_c))
    print(f"[C/CGLS] iter = {iter_c}, ||r|| = {res_c:.4f}, ||x|| = {sol_c:.4f}")

    # ------------------ Smoothness & perturbation sensitivity ------------
    grad_a = grad_norms(x_a)
    grad_b = grad_norms(x_b)
    grad_c = grad_norms(x_c)
    print(f"grad norms: A={grad_a}, B={grad_b}, C={grad_c}")

    alpha_lo_a = alpha_a * 0.8
    alpha_hi_a = alpha_a * 1.2
    x_a_lo, _, _ = tikhonov_solve(S, Vt, beta, alpha_lo_a)
    x_a_hi, _, _ = tikhonov_solve(S, Vt, beta, alpha_hi_a)
    sens_a_lo = relative_perturbation(x_a, x_a_lo)
    sens_a_hi = relative_perturbation(x_a, x_a_hi)

    k_lo_b = max(1, k_b - 1)
    k_hi_b = min(m, k_b + 1)
    x_b_lo, _, _ = tsvd_solve(S, Vt, beta, k_lo_b)
    x_b_hi, _, _ = tsvd_solve(S, Vt, beta, k_hi_b)
    sens_b_lo = relative_perturbation(x_b, x_b_lo)
    sens_b_hi = relative_perturbation(x_b, x_b_hi)

    it_lo_c = max(0, iter_c - 1)
    it_hi_c = min(len(history) - 1, iter_c + 1)
    x_c_lo = history[it_lo_c][1]
    x_c_hi = history[it_hi_c][1]
    sens_c_lo = relative_perturbation(x_c, x_c_lo)
    sens_c_hi = relative_perturbation(x_c, x_c_hi)

    print(f"perturbation sensitivity (lo, hi):  "
          f"A=({sens_a_lo:.3e},{sens_a_hi:.3e})  "
          f"B=({sens_b_lo:.3e},{sens_b_hi:.3e})  "
          f"C=({sens_c_lo:.3e},{sens_c_hi:.3e})")

    # ------------------ Mirror-write artifacts ----------------------------
    key_to_x = {"a": x_a, "b": x_b, "c": x_c}
    key_to_param = {
        "a": f"{alpha_a:.6e}",
        "b": f"{k_b}",
        "c": f"{iter_c}",
    }
    key_to_extra = {"a": {"lcurve_data.csv": lcurve_payload}}
    _write_mirrored_data(key_to_x, key_to_param, key_to_extra=key_to_extra)

    # ------------------ Comparison & recommendation -----------------------
    methods = [
        ("Tikhonov (L-curve)", "method_a", alpha_a, x_a, res_a, sol_a,
         grad_a, sens_a_lo, sens_a_hi),
        ("TSVD (Morozov)",    "method_b", k_b,     x_b, res_b, sol_b,
         grad_b, sens_b_lo, sens_b_hi),
        ("CGLS (Morozov)",    "method_c", iter_c,  x_c, res_c, sol_c,
         grad_c, sens_c_lo, sens_c_hi),
    ]
    closeness = [abs(res_a - noise_norm), abs(res_b - noise_norm),
                 abs(res_c - noise_norm)]
    sens_max = [max(sens_a_lo, sens_a_hi), max(sens_b_lo, sens_b_hi),
                max(sens_c_lo, sens_c_hi)]
    sol_norms_list = [sol_a, sol_b, sol_c]

    # Combine the three criteria on a common scale.  Each criterion is divided by
    # its smallest value across methods and the three are summed; smaller is better.
    # A method that is 100x worse than the best on any single criterion can only
    # win overall if it is no more than ~100x better on the other two combined.
    def _normalize(values):
        mn = min(values) if min(values) > 0 else 1e-300
        return [v / mn for v in values]

    norm_close = _normalize(closeness)
    norm_sol   = _normalize(sol_norms_list)
    norm_sens  = _normalize(sens_max)
    norm_sum = [norm_close[i] + norm_sol[i] + norm_sens[i] for i in range(3)]

    # Also keep a rank-sum for transparency:
    criteria = list(zip(closeness, sol_norms_list, sens_max))
    ranks = []
    for i in range(3):
        r = sum(1 for j in range(3) for k in range(3)
                if criteria[i][j] <= criteria[k][j])
        ranks.append(r)
    # Winner = lowest normalized sum; break ties via lowest rank-sum
    best_score = min(norm_sum)
    tied = [i for i in range(3) if norm_sum[i] == best_score]
    if len(tied) == 1:
        winner_i = tied[0]
    else:
        winner_i = min(tied, key=lambda i: ranks[i])

    winner_x = methods[winner_i][3]
    print(f"Selected method: {methods[winner_i][0]}  "
          f"norm_sum={norm_sum[winner_i]:.3f}  rank-sum={ranks[winner_i]}  "
          f"(closeness, ||x||, sens) = {criteria[winner_i]}")

    report_path = os.path.join(RESULTS_DIR, "comparison", "comparison_report.md")
    write_comparison_report(report_path, methods, closeness, sol_norms_list,
                            sens_max, ranks, winner_i,
                            alpha_lcurve, alpha_morozov,
                            noise_norm, sigma_n, eff_rank)

    rec_path = os.path.join(RESULTS_DIR, "comparison",
                             "recommended_solution.csv")
    np.savetxt(rec_path, winner_x, fmt="%.17e", delimiter="\n", newline="\n")
    print(f"Wrote recommended solution -> {rec_path}")

    print("All artefacts written.")


if __name__ == "__main__":
    main()
