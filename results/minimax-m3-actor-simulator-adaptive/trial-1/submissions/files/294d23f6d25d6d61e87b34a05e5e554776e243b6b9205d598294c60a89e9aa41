"""
Wealth inequality analysis: white NLSY79 respondents, 1990 vs 1996, by sex.

Inputs : data/nls_incarceration_processed.csv
Outputs: /workspace/artifacts/results_primary.csv
         /workspace/artifacts/results_winsorized.csv
         /workspace/artifacts/results_changes.csv
         /workspace/artifacts/results_gaps.csv
"""
import numpy as np
import pandas as pd

DATA = "/workspace/data/nls_incarceration_processed.csv"

# ----------------------------- helpers ---------------------------------------
def gini(x):
    """Standard Gini on raw (possibly negative) values.
    Sorted-ascending closed-form; robust to ties; returns NaN for n<2."""
    x = np.asarray(x, dtype=float)
    n = len(x)
    if n < 2:
        return np.nan
    s = x.sum()
    if s == 0:
        return np.nan
    x_sorted = np.sort(x)
    # cumulative-share formulation
    cum = np.cumsum(x_sorted)
    # Lorenz curve area via the trapezoidal cumulative-sum formula
    # area under Lorenz = (1 / (n * s)) * sum( (x_i + x_{i-1})/2 ) for i=1..n,
    # but a faster closed form:
    # G = (2 * sum_i i*x_i) / (n * sum x) - (n + 1) / n   (indices 1..n, ascending)
    idx = np.arange(1, n + 1, dtype=float)
    return float((2.0 * np.sum(idx * x_sorted)) / (n * s) - (n + 1.0) / n)

def percentile_ratio(p_hi, p_lo):
    """Return p_hi/p_lo, or np.inf when p_lo == 0 and p_hi > 0."""
    if p_lo == 0:
        return np.inf if p_hi > 0 else np.nan
    return p_hi / p_lo

def top_share(x, q):
    """Share of total summed wealth held by respondents at or above quantile q."""
    x = np.asarray(x, dtype=float)
    cutoff = np.quantile(x, q)
    total = x.sum()
    if total == 0:
        return np.nan
    top = x[x >= cutoff].sum()
    return float(top / total)

def bottom_share(x, q):
    """Share of total summed wealth held by respondents at or below quantile q."""
    bottom = x[x <= np.quantile(x, q)].sum()
    return float(bottom / x.sum()) if x.sum() != 0 else np.nan

def describe(x, label=""):
    """Return a dict of all inequality measures for the 1-D array x."""
    x = np.asarray(x, dtype=float)
    n = len(x)
    out = {
        "label": label,
        "n": int(n),
        "n_zero": int((x == 0).sum()),
        "n_negative": int((x < 0).sum()),
        "min": float(np.min(x)),
        "p5": float(np.quantile(x, 0.05)),
        "p10": float(np.quantile(x, 0.10)),
        "p25": float(np.quantile(x, 0.25)),
        "median": float(np.median(x)),
        "mean": float(np.mean(x)),
        "p75": float(np.quantile(x, 0.75)),
        "p90": float(np.quantile(x, 0.90)),
        "p95": float(np.quantile(x, 0.95)),
        "p99": float(np.quantile(x, 0.99)),
        "max": float(np.max(x)),
        "std": float(np.std(x, ddof=1)),
        "iqr": float(np.quantile(x, 0.75) - np.quantile(x, 0.25)),
        "cv": float(np.std(x, ddof=1) / np.mean(x)) if np.mean(x) != 0 else np.nan,
        "p90_over_p10": percentile_ratio(np.quantile(x, 0.90), np.quantile(x, 0.10)),
        "p95_over_p5":  percentile_ratio(np.quantile(x, 0.95), np.quantile(x, 0.05)),
        "p90_minus_p10": float(np.quantile(x, 0.90) - np.quantile(x, 0.10)),
        "p95_minus_p5":  float(np.quantile(x, 0.95) - np.quantile(x, 0.05)),
        "p90_over_median": percentile_ratio(np.quantile(x, 0.90), np.median(x)),
        "p95_over_median": percentile_ratio(np.quantile(x, 0.95), np.median(x)),
        "gini":          gini(x),
        "top10_share":   top_share(x, 0.90),
        "top5_share":    top_share(x, 0.95),
        "bottom50_share": bottom_share(x, 0.50),
    }
    return out

# ----------------------------- main ------------------------------------------
df = pd.read_csv(DATA)
white = df[df["race"] == "white"].copy()
assert white["sex"].isin(["male", "female"]).all()

years = [1990, 1996]
sexes = ["male", "female"]

# Primary (unwinsorized) results
primary_rows = []
wins_rows = []
for sex in sexes:
    sub = white[white["sex"] == sex]
    for yr in years:
        col = f"composite_wealth_{yr}"
        x_full = sub[col].to_numpy()
        primary_rows.append(describe(x_full, label=f"{sex}_{yr}_primary"))
        # Winsorize at p1 / p99 (computed within this sex-year group)
        lo = float(np.quantile(x_full, 0.01))
        hi = float(np.quantile(x_full, 0.99))
        x_w = np.clip(x_full, lo, hi)
        wins_rows.append(describe(x_w, label=f"{sex}_{yr}_winsor_p1p99"))

primary = pd.DataFrame(primary_rows).set_index("label")
wins    = pd.DataFrame(wins_rows).set_index("label")

# Wide format, side-by-side per sex (1990 vs 1996)
keep = ["n","n_zero","n_negative","min","p5","p10","p25","median","mean",
        "p75","p90","p95","p99","max","std","iqr","cv",
        "p10","p25","median","mean","p75","p90","p95","p99","max","std","iqr","cv",
        "p90_over_p10","p95_over_p5","p90_minus_p10","p95_minus_p5",
        "p90_over_median","p95_over_median",
        "gini","top10_share","top5_share","bottom50_share"]

primary.to_csv("/workspace/artifacts/results_primary.csv")
wins.to_csv("/workspace/artifacts/results_winsorized.csv")

# 1990 -> 1996 change per sex, per measure, on the primary sample
def change_row(sex, measures):
    s90 = primary.loc[f"{sex}_1990_primary", measures].astype(float)
    s96 = primary.loc[f"{sex}_1996_primary", measures].astype(float)
    abs_delta = s96 - s90
    denom = s90.copy()
    pct_delta = (abs_delta / denom.replace(0, np.nan)) * 100.0
    out = pd.DataFrame({"abs_delta": abs_delta, "pct_delta_pct": pct_delta}).T
    out.columns = measures
    out.index = [f"{sex}_abs_delta_1996minus1990", f"{sex}_pct_delta_pct"]
    return out

measures = ["mean","median","iqr","std","cv","p90_over_p10","p95_over_p5",
            "p90_over_median","p95_over_median","p90_minus_p10","p95_minus_p5",
            "gini","top10_share","top5_share","bottom50_share"]

changes = pd.concat([change_row("male", measures), change_row("female", measures)])
changes.to_csv("/workspace/artifacts/results_changes.csv")

# Between-group (M vs F) gaps per year + change-in-gap
gap_rows = []
for yr in years:
    row = {"year": yr}
    male = primary.loc[f"male_{yr}_primary", measures]
    fema = primary.loc[f"female_{yr}_primary", measures]
    row.update({f"FminusM_{m}": float(fema[m] - male[m]) for m in measures})
    gap_rows.append(row)
gaps = pd.DataFrame(gap_rows).set_index("year")
gaps.to_csv("/workspace/artifacts/results_gaps.csv")

# Print summary tables to stdout for inclusion in the handoff
print("="*78); print("PRIMARY SAMPLE (full, un-winsorized)"); print("="*78)
display_cols = ["n","p5","p10","p25","median","mean","p75","p90","p95","p99",
                "std","iqr","cv","p90_over_median","gini",
                "top10_share","top5_share","bottom50_share"]
print(primary[display_cols].round(3).to_string())

print()
print("="*78); print("WINSORIZED (clipped at p1/p99 within each sex-year group)"); print("="*78)
print(wins[display_cols].round(3).to_string())

print()
print("="*78); print("CHANGE: 1996 minus 1990 (per sex)"); print("="*78)
print(changes.round(3).to_string())

print()
print("="*78); print("BETWEEN-GROUP GAP: female minus male (positive => F exceeds M)"); print("="*78)
print(gaps.round(4).to_string())

print()
print("="*78); print("WINSORIZED TOP SHARES (sensitivity)"); print("="*78)
print(wins[["top10_share","top5_share","bottom50_share","gini","cv","p90_over_median"]].round(3).to_string())
