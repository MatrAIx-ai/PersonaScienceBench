"""
Minimal Firth-penalized logistic regression for binary outcomes.

Implements Firth's correction to ML estimation for logistic regression
(Firth 1993, Bias reduction of maximum likelihood estimates, Biometrika).
Uses log-penalized likelihood:  L_pen(b) = L(b) + 0.5*log|H(b)|
where H(b) is the observed (or expected) Hessian of L(b).

For our 2-by-2 case with rare events this handles quasi-separation cleanly.
"""
from __future__ import annotations
import numpy as np
from scipy.optimize import minimize
from scipy.special import expit


def _firth_loss(beta, X, y, ridge):
    z = X @ beta
    z = np.clip(z, -30.0, 30.0)
    p = expit(z)
    p = np.clip(p, 1e-12, 1 - 1e-12)
    W = p * (1.0 - p)
    ll = float(np.sum(y * np.log(p) + (1.0 - y) * np.log(1.0 - p)))
    H = (X * W[:, None]).T @ X
    H = H + ridge * np.eye(H.shape[0])
    sign, logdet = np.linalg.slogdet(H)
    if sign <= 0 or not np.isfinite(logdet):
        return 1e10
    return -(ll + 0.5 * logdet)


def _firth_grad(beta, X, y, ridge):
    z = X @ beta
    z = np.clip(z, -30.0, 30.0)
    p = expit(z)
    p = np.clip(p, 1e-12, 1 - 1e-12)
    W = p * (1.0 - p)
    n, k = X.shape
    grad_score = X.T @ (y - p)            # gradient of log-likelihood (=U)
    H = (X * W[:, None]).T @ X + ridge * np.eye(k)
    # gradient of 0.5 log|H|: 0.5 * tr(H^{-1} * dH/dbeta_j)
    # dH/dbeta_j for expected Hessian: dH/dbeta_j = X.T @ diag((1-2p)*W) @ e_j... 
    # Easier via chain rule with residual form:
    # 0.5 log|H|  grad = 0.5 * (H^{-1} : dH)  where : is trace inner product
    # dH_j = X.T @ diag((1-2p) * w_j * ...) ...
    # Use Firth's score-corrected approach instead: 0.5 * X.T @ ((1 - 2p) * r)
    # where r = diag(X H^{-1} X.T)  (diag of projection matrix under W)
    Hinv = np.linalg.inv(H)
    Xw = X * np.sqrt(W[:, None])
    # leverage / projection diag: diag(X H^{-1} X.T) -- with weights accounted
    # because H = Xw.T @ Xw -- so H^{-1} = (Xw.T Xw)^{-1}
    # proj diag = sum_k Xw[:,k]^2 * (H^{-1})_{k,*}   but easier:
    # leverage_i = (X H^{-1} X.T)_ii  where H^{-1} has weight baked in
    # Compute via X H^{-1} X.T diag (does NOT include weights directly because we used X without W for that diag; but our H uses W. So use weighted leverage appropriately:)
    # Correct: leverage_i = e_i.T X_w H^{-1} X_w.T e_i = sum_k (sqrt(W)*X)_ik * (H^{-1} X_w.T e_i)_k
    # = || X_w.T H^{-1/2} ... actually too much. Use direct: leverage = (X H^{-1} X.T)_ii  with H = X_w.T X_w:
    # Let H_inv = (X_w.T X_w)^{-1}. Then proj diag_i = sum_j (X_w)_{i,j} (H_inv X_w.T)_{j,i}
    # = diag(X_w @ H_inv @ X_w.T)
    proj_diag = np.einsum('ij,jk,ik->i', X * np.sqrt(W)[:, None],
                           Hinv, X * np.sqrt(W)[:, None])
    # but we want H defined as X.T @ diag(W) @ X, so X_w = X * sqrt(W) (row-scaled).
    # H_inv then understood as (X_w.T X_w)^{-1}, and proj_diag under weights is:
    r = np.clip(proj_diag, 1e-12, 1.0)
    grad_pen = 0.5 * X.T @ ((1.0 - 2.0 * p) * r)
    return -(grad_score + grad_pen)


def fit_firth_logit(X, y, maxiter=200, ridge=1e-6, verbose=False):
    """Fit a Firth penalized logistic regression.

    Returns dict with: beta, se, or_ci_low, or_ci_hi, converged, n_iter, ll_pen.
    SE via standard inverse expected Hessian (pen log-lik).
    """
    X = np.asarray(X, dtype=float)
    y = np.asarray(y, dtype=float)
    n, k = X.shape

    # Initial fit: standard logit for starting values
    from statsmodels.api import Logit
    try:
        model = Logit(y, X)
        res = model.fit(disp=False, maxiter=200, method='newton', warn_convergence=False)
        beta0 = res.params
    except Exception:
        beta0 = np.zeros(k)

    res = minimize(
        _firth_loss, beta0, args=(X, y, ridge),
        jac=_firth_grad, method='L-BFGS-B',
        options={'maxiter': maxiter, 'ftol': 1e-10, 'gtol': 1e-7}
    )
    beta = res.x
    converged = bool(res.success)

    # Final info matrix (Hessian of pen ll) — observed/info
    z = np.clip(X @ beta, -30.0, 30.0)
    p = expit(z)
    W = p * (1.0 - p)
    H = (X * W[:, None]).T @ X + ridge * np.eye(k)
    try:
        Hinv = np.linalg.inv(H)
        se = np.sqrt(np.maximum(np.diag(Hinv), 0.0))
    except np.linalg.LinAlgError:
        se = np.full(k, np.nan)
    return {
        'beta': beta,
        'se': se,
        'converged': converged,
        'n_iter': int(res.nit),
        'pen_loglik': -res.fun,
        'Hinv': Hinv,
        'p_hat': p,
    }


def lr_test(full_pen_ll, full_df, red_pen_ll, red_df):
    """Likelihood ratio test penalized logliks (Firth)."""
    from scipy.stats import chi2
    stat = 2.0 * (full_pen_ll - red_pen_ll)
    df = full_df - red_df
    pval = 1.0 - chi2.cdf(stat, df)
    return float(stat), int(df), float(pval)
