{"cells": [{"cell_type": "markdown", "metadata": {}, "source": ["# PCA on forms of capital (100-year slices)", "", "This notebook corresponds to the run in `scripts/run_capital_pca.py`.", "It performs the PCA on `data/capital.csv` as specified in the approved plan.", "", "**Data summary**", "- 39 slices (BCE 4300 -> 500, step 100), 12 Z-variables.", "- Symbolic triad: `ZAxtSchwert` (HatchetSword), `ZDolch` (Dagger), `Zhausgr` (HouseSize).", "- No missing values.", "", "**Pipeline**", "1. Load with `decimal=','`; drop `group`/`color`.", "2. Re-standardize each Z-column (mean=0, std=1, ddof=1).", "3. PCA via numpy SVD (sklearn-equivalent) -> components, scores, explained variance.", "4. Sign-orientation: PC1 positive on `ZAxtSchwert`; PC2 positive on argmax-|raw PC2 loading|.", "5. Bootstrap (B=1000) of slice rows for 95% CIs on the symbolic triad's PC1/PC2 loadings.", "6. Sensitivity: (a) PCA on raw (no rescale); (b) PCA on symbolic triad only.", "7. SVG figures: biplot (slices colored by period, all 12 loading arrows, symbolic bolded),", "   loadings barplot (PC1 vs PC2, ordered by |PC1|), scree plot.", "8. CSV/JSON dumps of loadings, CIs and explained variance.", "", "**Outputs**", "- `loadings.csv`, `loadings_full.json` \u2014 full and oriented loadings.", "- `explained_variance.csv` \u2014 explained variance and cumulative.", "- `bootstrap_CIs.csv` \u2014 bootstrap mean and 2.5/97.5 percentiles.", "- `biplot.svg`, `loadings_barplot.svg`, `scree.svg` \u2014 figures.", "- `run_log.txt` \u2014 full console report."]}, {"cell_type": "code", "metadata": {}, "source": ["\"\"\"", "PCA on forms of capital, 100-year time slices (DiscoveryBench / archaeology).", "", "Implements the plan approved by the researcher:", "  1. Load capital.csv with decimal=','; drop group/color; keep BCE.", "  2. Re-standardize all 12 Z-columns and run PCA on the correlation matrix.", "  3. Report explained_variance_ratio for PC1+PC2, a scree, and the full loading matrix.", "  4. Sign-orientation: PC1 -> positive on ZAxtSchwert; PC2 -> positive on argmax-|PC2 loading|.", "  5. Bootstrap (B=1000) of slice rows: 95% CIs on loadings of ZAxtSchwert, ZDolch, Zhausgr", "     on both PC1 and PC2.", "  6. Sensitivity: (a) PCA without re-standardization (raw Z-columns);", "     (b) PCA on the three symbolic variables only (ZAxtSchwert, ZDolch, Zhausgr).", "  7. SVG biplot of slice observations coloured by group + symbolic-triad loading arrows;", "     SVG barplot of all 12 loadings ordered by |PC1 loading| with PC2 overlaid.", "  8. Save artifacts (CSV/JSON/SVG).", "", "PCA implementation: numpy SVD centred-matrix; sklearn-equivalent for", "standardized data == correlation-matrix PCA.", "\"\"\"", "from __future__ import annotations", "", "import json", "from pathlib import Path", "", "import numpy as np", "import pandas as pd", "", "DATA_PATH = Path(\"/workspace/data/capital.csv\")", "ARTIFACT_DIR = Path(\"/workspace/artifacts\")", "ARTIFACT_DIR.mkdir(parents=True, exist_ok=True)", "", "ZCOLS = [", "    \"ZAxtSchwert\",\"ZDolch\",\"Zhausgr\",", "    \"ZCU_AU\",\"Zamber\",\"ZHort\",\"ZSichel\",\"ZBeil\",", "    \"ZMonument\",\"ZMW\",\"ZKeform\",\"Zkeverz\",", "]", "SYMBOLIC = [\"ZAxtSchwert\",\"ZDolch\",\"Zhausgr\"]", "GLOBAL_COLOR = {", "    \"EN\":\"#8A2BE2\",\"MN\":\"#00FFFF\",\"SG\":\"#A52A2A\",", "    \"LN\":\"#FFFF00\",\"OBA\":\"#228B22\",\"YBA\":\"#FFE4B5\",", "}", "", "", "def load_capital() -> pd.DataFrame:", "    df = pd.read_csv(DATA_PATH, decimal=\",\")", "    df = df.drop(columns=[\"group\",\"color\"])", "    return df", "", "", "def fit_pca(X: np.ndarray, n_components: int | None = None):", "    n, p = X.shape", "    k = n_components if n_components is not None else min(n, p)", "    mean = X.mean(axis=0)", "    Xc = X - mean", "    U, S, Vt = np.linalg.svd(Xc, full_matrices=False)", "    components = Vt[:k]", "    explained_variance = (S[:k] ** 2) / (n - 1)", "    total_var = (S ** 2).sum() / (n - 1)", "    explained_variance_ratio = explained_variance / total_var", "    scores = Xc @ components.T", "    return {", "        \"components\": components,", "        \"explained_variance\": explained_variance,", "        \"explained_variance_ratio\": explained_variance_ratio,", "        \"singular_values\": S[:k],", "        \"mean\": mean,", "        \"scores\": scores,", "        \"n_samples\": n,", "        \"n_features\": p,", "    }", "", "", "def standardize(X: np.ndarray) -> np.ndarray:", "    return (X - X.mean(axis=0)) / X.std(axis=0, ddof=1)", "", "", "def orient_components(components: np.ndarray, zcols: list[str],", "                      ref_pc1: str = \"ZAxtSchwert\") -> tuple[np.ndarray, dict]:", "    oriented = components.copy()", "    info = {\"pc1_ref\": ref_pc1, \"pc1_sign\": 1, \"pc2_ref_var\": None, \"pc2_sign\": 1}", "    idx1 = zcols.index(ref_pc1)", "    s1 = np.sign(oriented[0, idx1])", "    if s1 == 0:", "        s1 = 1.0", "    oriented[0] = oriented[0] * s1", "    info[\"pc1_sign\"] = float(s1)", "    pc2_abs = np.abs(oriented[1])", "    idx2 = int(np.argmax(pc2_abs))", "    info[\"pc2_ref_var\"] = zcols[idx2]", "    s2 = np.sign(oriented[1, idx2])", "    if s2 == 0:", "        s2 = 1.0", "    oriented[1] = oriented[1] * s2", "    info[\"pc2_sign\"] = float(s2)", "    return oriented, info", "", "", "def bootstrap_loadings(X: np.ndarray, target_cols: list[str], zcols: list[str],", "                       pc2_ref_var: str, ref_pc1: str = \"ZAxtSchwert\",", "                       B: int = 1000, seed: int = 20260525):", "    rng = np.random.default_rng(seed)", "    n = X.shape[0]", "    boot = np.zeros((B, 2, len(zcols)))", "    for b in range(B):", "        idx = rng.integers(0, n, n)", "        Xb = X[idx]", "        fit = fit_pca(Xb, n_components=2)", "        c = fit[\"components\"]", "        i1 = zcols.index(ref_pc1)", "        s1 = np.sign(c[0, i1])", "        if s1 == 0:", "            s1 = 1.0", "        boot[b, 0] = c[0] * s1", "        i2 = zcols.index(pc2_ref_var)", "        s2 = np.sign(c[1, i2])", "        if s2 == 0:", "            s2 = 1.0", "        boot[b, 1] = c[1] * s2", "    out = {}", "    for c in target_cols:", "        j = zcols.index(c)", "        out[c] = {", "            \"PC1_mean\": float(boot[:, 0, j].mean()),", "            \"PC1_lo\":   float(np.percentile(boot[:, 0, j], 2.5)),", "            \"PC1_hi\":   float(np.percentile(boot[:, 0, j], 97.5)),", "            \"PC2_mean\": float(boot[:, 1, j].mean()),", "            \"PC2_lo\":   float(np.percentile(boot[:, 1, j], 2.5)),", "            \"PC2_hi\":   float(np.percentile(boot[:, 1, j], 97.5)),", "        }", "    return out, boot", "", "", "def ascii_bar(label: str, v: float, vmax: float, width: int = 36) -> str:", "    fill = int(round(abs(v) / vmax * width))", "    bar = \"#\" * fill", "    sign = \"+\" if v >= 0 else \"-\"", "    return f\"{label:14s} {sign}{abs(v):.3f} |{bar:<{width}s}|\"", "", "", "def ascii_barplot(loadings: dict, label: str) -> str:", "    vmax = max(abs(v) for v in loadings.values())", "    lines = [f\"=== {label} ===\"]", "    for name, v in sorted(loadings.items(), key=lambda kv: -abs(kv[1])):", "        lines.append(ascii_bar(name, v, vmax))", "    return \"\\n\".join(lines)", "", "", "def write_svg(path: Path, body: str, w: int, h: int, bg: str = \"white\") -> None:", "    svg = (", "        f'<?xml version=\"1.0\" encoding=\"UTF-8\"?>\\n'", "        f'<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"{w}\" height=\"{h}\" '", "        f'viewBox=\"0 0 {w} {h}\">\\n'", "        f'<rect width=\"{w}\" height=\"{h}\" fill=\"{bg}\"/>\\n'", "        f'{body}\\n'", "        f'</svg>\\n'", "    )", "    path.write_text(svg)", "", "", "def svg_biplot(scores: np.ndarray, loadings: np.ndarray, zcols: list[str],", "               groups: np.ndarray, out_path: Path,", "               title: str, xlabel: str, ylabel: str,", "               highlight_vars: list[str] | None = None) -> None:", "    W, H = 800, 640", "    pad_l, pad_r, pad_t, pad_b = 90, 130, 70, 80", "    plot_w = W - pad_l - pad_r", "    plot_h = H - pad_t - pad_b", "    xs = scores[:, 0]; ys = scores[:, 1]", "    lx = loadings[0, :]; ly = loadings[1, :]", "    all_x = np.concatenate([xs, np.zeros(1)])", "    all_y = np.concatenate([ys, np.zeros(1)])", "    xmin, xmax = all_x.min(), all_x.max()", "    ymin, ymax = all_y.min(), all_y.max()", "    xpad = (xmax - xmin) * 0.10 if xmax > xmin else 1.0", "    ypad = (ymax - ymin) * 0.10 if ymax > ymin else 1.0", "    xmin -= xpad; xmax += xpad", "    ymin -= ypad; ymax += ypad", "    xr = max(abs(xmin), abs(xmax))", "    yr = max(abs(ymin), abs(ymax))", "    xmin, xmax = -xr, xr", "    ymin, ymax = -yr, yr", "    def sx(v): return pad_l + (v - xmin) / (xmax - xmin) * plot_w", "    def sy(v): return pad_t + plot_h - (v - ymin) / (ymax - ymin) * plot_h", "    body = [f'<text x=\"{W/2}\" y=\"30\" font-size=\"18\" text-anchor=\"middle\" font-family=\"sans-serif\">{title}</text>']", "    body.append(f'<line x1=\"{sx(0)}\" y1=\"{pad_t}\" x2=\"{sx(0)}\" y2=\"{pad_t+plot_h}\" stroke=\"#cccccc\"/>')", "    body.append(f'<line x1=\"{pad_l}\" y1=\"{sy(0)}\" x2=\"{pad_l+plot_w}\" y2=\"{sy(0)}\" stroke=\"#cccccc\"/>')", "    body.append(f'<text x=\"{pad_l+plot_w/2}\" y=\"{H-30}\" font-size=\"14\" text-anchor=\"middle\" font-family=\"sans-serif\">{xlabel}</text>')", "    body.append(f'<text x=\"20\" y=\"{pad_t+plot_h/2}\" font-size=\"14\" text-anchor=\"middle\" font-family=\"sans-serif\" transform=\"rotate(-90, 20, {pad_t+plot_h/2})\">{ylabel}</text>')", "    n_ticks = 5", "    for i in range(n_ticks + 1):", "        vx = xmin + (xmax - xmin) * i / n_ticks", "        vy = ymin + (ymax - ymin) * i / n_ticks", "        body.append(f'<text x=\"{sx(vx)}\" y=\"{sy(0)+16}\" font-size=\"10\" text-anchor=\"middle\" font-family=\"sans-serif\">{vx:.2f}</text>')", "        body.append(f'<text x=\"{sx(0)-6}\" y=\"{sy(vy)+3}\" font-size=\"10\" text-anchor=\"end\" font-family=\"sans-serif\">{vy:.2f}</text>')", "    for i, (x, y) in enumerate(zip(xs, ys)):", "        c = GLOBAL_COLOR.get(str(groups[i]), \"#666666\")", "        body.append(f'<circle cx=\"{sx(x):.2f}\" cy=\"{sy(y):.2f}\" r=\"5\" fill=\"{c}\" fill-opacity=\"0.75\" stroke=\"black\" stroke-width=\"0.5\"/>')", "    sym_set = set(highlight_vars or [])", "    arrow_scale = min(plot_w / (xmax - xmin), plot_h / (ymax - ymin)) * 0.45", "    for j, name in enumerate(zcols):", "        x0, y0 = sx(0), sy(0)", "        x1 = sx(lx[j] * arrow_scale)", "        y1 = sy(ly[j] * arrow_scale)", "        col = \"#b22222\" if name in sym_set else \"#444444\"", "        sw = 2.4 if name in sym_set else 1.0", "        body.append(f'<line x1=\"{x0:.2f}\" y1=\"{y0:.2f}\" x2=\"{x1:.2f}\" y2=\"{y1:.2f}\" stroke=\"{col}\" stroke-width=\"{sw}\"/>')", "        body.append(f'<polygon points=\"{x1:.2f},{y1:.2f} {x1-6:.2f},{y1-4:.2f} {x1-6:.2f},{y1+4:.2f}\" fill=\"{col}\"/>')", "        body.append(f'<text x=\"{x1+4:.2f}\" y=\"{y1-4:.2f}\" font-size=\"{11 if name in sym_set else 9}\" font-family=\"sans-serif\" fill=\"{col}\" font-weight=\"{\"bold\" if name in sym_set else \"normal\"}\">{name}</text>')", "    legend_x = W - 120", "    legend_y = pad_t + 10", "    body.append(f'<rect x=\"{legend_x-10}\" y=\"{legend_y-15}\" width=\"115\" height=\"{20+18*len(GLOBAL_COLOR)}\" fill=\"white\" stroke=\"#888888\"/>')", "    for i, (g, col) in enumerate(GLOBAL_COLOR.items()):", "        body.append(f'<circle cx=\"{legend_x}\" cy=\"{legend_y+i*18+5}\" r=\"5\" fill=\"{col}\" stroke=\"black\" stroke-width=\"0.5\"/>')", "        body.append(f'<text x=\"{legend_x+10}\" y=\"{legend_y+i*18+9}\" font-size=\"11\" font-family=\"sans-serif\">{g}</text>')", "    write_svg(out_path, \"\\n\".join(body), W, H)", "", "", "def svg_loading_barplot(loadings_pc1: dict, loadings_pc2: dict, out_path: Path,", "                        title: str) -> None:", "    W, H = 720, 520", "    pad_l, pad_r, pad_t, pad_b = 110, 60, 60, 130", "    plot_w = W - pad_l - pad_r", "    plot_h = H - pad_t - pad_b", "    ordered = sorted(loadings_pc1.items(), key=lambda kv: -abs(kv[1]))", "    labels = [n for n, _ in ordered]", "    p1 = [loadings_pc1[n] for n in labels]", "    p2 = [loadings_pc2[n] for n in labels]", "    all_vals = p1 + p2 + [0.0]", "    vmax = max(abs(v) for v in all_vals)", "    ymin, ymax = -vmax * 1.15, vmax * 1.15", "    def sy(v): return pad_t + plot_h - (v - ymin) / (ymax - ymin) * plot_h", "    body = [f'<text x=\"{W/2}\" y=\"30\" font-size=\"16\" text-anchor=\"middle\" font-family=\"sans-serif\">{title}</text>']", "    body.append(f'<line x1=\"{pad_l}\" y1=\"{sy(0)}\" x2=\"{pad_l+plot_w}\" y2=\"{sy(0)}\" stroke=\"#888888\"/>')", "    n_ticks = 5", "    for i in range(-n_ticks, n_ticks + 1):", "        v = vmax * i / n_ticks", "        body.append(f'<text x=\"{pad_l-6}\" y=\"{sy(v)+4}\" font-size=\"10\" text-anchor=\"end\" font-family=\"sans-serif\">{v:.2f}</text>')", "        body.append(f'<line x1=\"{pad_l-3}\" y1=\"{sy(v)}\" x2=\"{pad_l+plot_w}\" y2=\"{sy(v)}\" stroke=\"#eeeeee\"/>')", "    n = len(labels)", "    bw = plot_w / n * 0.6", "    gap = plot_w / n", "    for i, name in enumerate(labels):", "        cx = pad_l + (i + 0.5) * gap", "        sym = name in SYMBOLIC", "        v1 = p1[i]", "        y_top1 = sy(v1) if v1 >= 0 else sy(0)", "        h1 = abs(sy(v1) - sy(0)) if v1 != 0 else 0.5", "        body.append(f'<rect x=\"{cx-bw/2:.2f}\" y=\"{y_top1:.2f}\" width=\"{bw/2-1:.2f}\" height=\"{h1:.2f}\" fill=\"{\"#3a6ea5\" if not sym else \"#1f4e79\"}\"/>')", "        v2 = p2[i]", "        y_top2 = sy(v2) if v2 >= 0 else sy(0)", "        h2 = abs(sy(v2) - sy(0)) if v2 != 0 else 0.5", "        body.append(f'<rect x=\"{cx-1:.2f}\" y=\"{y_top2:.2f}\" width=\"{bw/2-1:.2f}\" height=\"{h2:.2f}\" fill=\"{\"#b22222\" if not sym else \"#7a0e0e\"}\"/>')", "        body.append(f'<text x=\"{cx}\" y=\"{pad_t+plot_h+18}\" font-size=\"10\" text-anchor=\"end\" font-family=\"sans-serif\" '", "                    f'transform=\"rotate(-30, {cx}, {pad_t+plot_h+18})\" '", "                    f'font-weight=\"{\"bold\" if sym else \"normal\"}\" fill=\"{\"#7a0e0e\" if sym else \"#000\"}\">{name}</text>')", "    body.append(f'<rect x=\"{pad_l+plot_w-150}\" y=\"{pad_t-5}\" width=\"160\" height=\"42\" fill=\"white\" stroke=\"#888\"/>')", "    body.append(f'<rect x=\"{pad_l+plot_w-145}\" y=\"{pad_t+5}\" width=\"14\" height=\"10\" fill=\"#3a6ea5\"/>')", "    body.append(f'<text x=\"{pad_l+plot_w-127}\" y=\"{pad_t+13}\" font-size=\"11\" font-family=\"sans-serif\">PC1 (oriented)</text>')", "    body.append(f'<rect x=\"{pad_l+plot_w-145}\" y=\"{pad_t+22}\" width=\"14\" height=\"10\" fill=\"#b22222\"/>')", "    body.append(f'<text x=\"{pad_l+plot_w-127}\" y=\"{pad_t+30}\" font-size=\"11\" font-family=\"sans-serif\">PC2 (oriented)</text>')", "    body.append(f'<text x=\"{pad_l+plot_w/2}\" y=\"{H-10}\" font-size=\"12\" text-anchor=\"middle\" font-family=\"sans-serif\">Variables (ordered by |PC1|)</text>')", "    write_svg(out_path, \"\\n\".join(body), W, H)", "", "", "def svg_scree(ev_ratio: np.ndarray, cumulative: np.ndarray, out_path: Path) -> None:", "    W, H = 720, 460", "    pad_l, pad_r, pad_t, pad_b = 80, 50, 60, 70", "    plot_w = W - pad_l - pad_r", "    plot_h = H - pad_t - pad_b", "    K = len(ev_ratio)", "    ymax = max(ev_ratio.max() * 1.15, 0.05)", "    def sx(i): return pad_l + i / (K - 1) * plot_w", "    def sy(v): return pad_t + plot_h - v / ymax * plot_h", "    body = [f'<text x=\"{W/2}\" y=\"30\" font-size=\"16\" text-anchor=\"middle\" font-family=\"sans-serif\">Scree plot - explained variance ratio</text>']", "    body.append(f'<line x1=\"{pad_l}\" y1=\"{sy(0)}\" x2=\"{pad_l+plot_w}\" y2=\"{sy(0)}\" stroke=\"#888\"/>')", "    for i in range(6):", "        v = ymax * i / 5", "        body.append(f'<text x=\"{pad_l-6}\" y=\"{sy(v)+4}\" font-size=\"10\" text-anchor=\"end\" font-family=\"sans-serif\">{v*100:.1f}%</text>')", "        body.append(f'<line x1=\"{pad_l-3}\" y1=\"{sy(v)}\" x2=\"{pad_l+plot_w}\" y2=\"{sy(v)}\" stroke=\"#eeeeee\"/>')", "    bw = plot_w / K * 0.55", "    for i, v in enumerate(ev_ratio):", "        x = sx(i) - bw / 2", "        body.append(f'<rect x=\"{x}\" y=\"{sy(v)}\" width=\"{bw}\" height=\"{sy(0)-sy(v)}\" fill=\"{\"#1f4e79\" if i<2 else \"#9bbcd6\"}\"/>')", "        body.append(f'<text x=\"{sx(i)}\" y=\"{sy(v)-6}\" font-size=\"10\" text-anchor=\"middle\" font-family=\"sans-serif\">{v*100:.1f}%</text>')", "    pts = \" \".join(f\"{sx(i):.2f},{sy(cumulative[i]):.2f}\" for i in range(K))", "    body.append(f'<polyline points=\"{pts}\" fill=\"none\" stroke=\"#b22222\" stroke-width=\"2\"/>')", "    for i in range(K):", "        body.append(f'<text x=\"{sx(i)}\" y=\"{pad_t+plot_h+18}\" font-size=\"10\" text-anchor=\"middle\" font-family=\"sans-serif\">PC{i+1}</text>')", "    body.append(f'<rect x=\"{pad_l+plot_w-160}\" y=\"{pad_t-5}\" width=\"160\" height=\"40\" fill=\"white\" stroke=\"#888\"/>')", "    body.append(f'<rect x=\"{pad_l+plot_w-150}\" y=\"{pad_t+5}\" width=\"14\" height=\"10\" fill=\"#1f4e79\"/>')", "    body.append(f'<text x=\"{pad_l+plot_w-130}\" y=\"{pad_t+13}\" font-size=\"11\" font-family=\"sans-serif\">individual (%)</text>')", "    body.append(f'<line x1=\"{pad_l+plot_w-150}\" y1=\"{pad_t+27}\" x2=\"{pad_l+plot_w-136}\" y2=\"{pad_t+27}\" stroke=\"#b22222\" stroke-width=\"2\"/>')", "    body.append(f'<text x=\"{pad_l+plot_w-130}\" y=\"{pad_t+30}\" font-size=\"11\" font-family=\"sans-serif\">cumulative</text>')", "    write_svg(out_path, \"\\n\".join(body), W, H)", "", "", "def main():", "    raw = pd.read_csv(DATA_PATH, decimal=\",\")", "    groups = raw[\"group\"].values", "    df = raw.drop(columns=[\"group\",\"color\"])", "    print(f\"Loaded capital.csv: shape={df.shape}; BCE range {df['BCE'].min()}..{df['BCE'].max()}\")", "    print(f\"groups: {pd.Series(groups).value_counts().to_dict()}\")", "", "    X = df[ZCOLS].values.astype(float)", "    Xs = standardize(X)", "    fit = fit_pca(Xs, n_components=None)", "", "    raw_components = fit[\"components\"][:2]", "    oriented, ori_info = orient_components(raw_components, ZCOLS, ref_pc1=\"ZAxtSchwert\")", "", "    print(\"\\n=== Primary PCA (12 Z-cols, standardized) ===\")", "    print(f\"PC1 orientation: sign x {ori_info['pc1_sign']:+.1f} (positive on ZAxtSchwert)\")", "    print(f\"PC2 orientation: sign x {ori_info['pc2_sign']:+.1f} (positive on {ori_info['pc2_ref_var']})\")", "    for i, label in enumerate([\"PC1\",\"PC2\"]):", "        print(f\"  {label}: variance={fit['explained_variance'][i]:.4f}  ratio={fit['explained_variance_ratio'][i]*100:.2f}%\")", "    cum2 = fit['explained_variance_ratio'][:2].sum()", "    print(f\"  Cumulative PC1+PC2: {cum2*100:.2f}%\")", "", "    loadings_pc1 = {ZCOLS[j]: float(oriented[0, j]) for j in range(len(ZCOLS))}", "    loadings_pc2 = {ZCOLS[j]: float(oriented[1, j]) for j in range(len(ZCOLS))}", "    raw_pc1 = {ZCOLS[j]: float(raw_components[0, j]) for j in range(len(ZCOLS))}", "    raw_pc2 = {ZCOLS[j]: float(raw_components[1, j]) for j in range(len(ZCOLS))}", "", "    print(\"\\n--- Loadings (oriented) ---\")", "    print(ascii_barplot(loadings_pc1, \"PC1 loadings (oriented)\"))", "    print()", "    print(ascii_barplot(loadings_pc2, \"PC2 loadings (oriented)\"))", "", "    print(\"\\n--- Symbolic triad, raw vs oriented ---\")", "    for c in SYMBOLIC:", "        print(f\"  {c:12s}  PC1 raw={raw_pc1[c]:+.4f} -> oriented={loadings_pc1[c]:+.4f} | \"", "              f\"PC2 raw={raw_pc2[c]:+.4f} -> oriented={loadings_pc2[c]:+.4f}\")", "", "    print(\"\\n--- Bootstrap (B=1000 of slice rows, standardized) ---\")", "    cis, boot_arr = bootstrap_loadings(Xs, SYMBOLIC, ZCOLS,", "                                       pc2_ref_var=ori_info[\"pc2_ref_var\"],", "                                       ref_pc1=\"ZAxtSchwert\", B=1000, seed=20260525)", "    for c in SYMBOLIC:", "        ci = cis[c]", "        print(f\"  {c}:\")", "        print(f\"    PC1: {ci['PC1_mean']:+.4f}  95% CI [{ci['PC1_lo']:+.4f}, {ci['PC1_hi']