  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": 8,
   "source": [
    "\n",
    "chosen_BCE = int(first_05['BCE'])\n",
    "chosen_row = sub[sub['BCE'] == chosen_BCE].iloc[0]\n",
    "verify_row = ts_df[ts_df['BCE'] == chosen_BCE].iloc[0]\n",
