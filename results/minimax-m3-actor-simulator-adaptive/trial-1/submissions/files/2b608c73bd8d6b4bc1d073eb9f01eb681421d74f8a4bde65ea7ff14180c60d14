   "source": [
    "## 4 · Threshold scan: d = 0.5 (primary) and d = 1.0 (sensitivity)",
    "",
    "**Rule.** A century *c* qualifies iff `dZ_decoration(c) >= +d` AND `dZ_form(c) <= -d` (both strict, in the same century). Then scan oldest -> youngest and pick the FIRST that satisfies."
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": 4,
   "source": [
    "\n",
    "def scan(thr):\n",
    "    d = sub.dropna(subset=['delta_form', 'delta_dec']).copy()\n",
    "    d['qualifies'] = (d['delta_dec'] >= thr) & (d['delta_form'] <= -thr)\n",
    "    return d\n",
    "\n",
    "for thr in (0.5, 1.0):\n",
    "    s = scan(thr)\n",
    "    qual = s[s['qualifies']]\n",
    "    print(f'--- Scan @ delta = {thr} ---')\n",
    "    if qual.empty:\n",
    "        print('  no qualifying century')\n",
    "    else:\n",
    "        print(f'  {len(qual)} qualifying century/centuries (oldest first):')\n",
    "        print(qual[['BCE','calBP','PotteryForm','PotteryDecoration',\n",
    "                    'delta_form','delta_dec']]\n",
    "              .to_string(index=False, formatters={\n",
    "                  'PotteryForm':'{:.2f}'.format,\n",
    "                  'PotteryDecoration':'{:.2f}'.format,\n",
    "                  'delta_form': lambda v: f'{v:+.2f}',\n",
    "                  'delta_dec':  lambda v: f'{v:+.2f}',\n",
    "              }))\n",
    ""
