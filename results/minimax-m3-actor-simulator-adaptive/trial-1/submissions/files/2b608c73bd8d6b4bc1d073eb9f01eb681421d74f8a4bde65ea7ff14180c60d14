    "calbp_low  = 1950 + chosen_BCE\n",
    "calbp_high = 1950 + (chosen_BCE - 99)\n",
    "\n",
    "hypothesis = (\n",
    "    f'The first century in which Diversity in Pottery Decoration rises '\n",
    "    f'significantly while Diversity in Pottery Form declines simultaneously '\n",
