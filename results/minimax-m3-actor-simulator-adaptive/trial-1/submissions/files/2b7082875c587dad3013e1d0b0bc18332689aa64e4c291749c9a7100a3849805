import pandas as pd, numpy as np
df = pd.read_csv('/workspace/data/nls_ses_processed.csv', index_col=0)

# Quartile cut-points for the pooled population (computed once on full data)
ses = df['SES']
q = ses.quantile([0.25, 0.5, 0.75]).values
print('Pooled SES quartiles:', np.round(q,4))

# Race-specific quartile cut-points
print('\nRace-specific SES quartiles:')
print(df.groupby('SAMPLE_RACE')['SES'].quantile([0.25,0.5,0.75]).unstack().round(4))

# How many unique SES values? Tertile / quartile counts
print('\nUnique SES values:', ses.nunique())
print('min/max:', ses.min(), ses.max())

# Alternative: tertiles
print('\nTertile cut-points (pooled):', np.round(ses.quantile([1/3, 2/3]).values,4))

# Hispanic n=1323 — is this enough at the four quartile cuts?
df['SES_Q_pooled'] = pd.qcut(df['SES'], 4, labels=['Q1(Low)','Q2','Q3','Q4(High)'], duplicates='drop')
print('\n=== Pooled-SES quartile: counts by race ===')
print(pd.crosstab(df['SES_Q_pooled'], df['SAMPLE_RACE'], margins=True))

# Distribution of SES by race to think about “low/mid/high” custom cut at race-specific quantiles
print('\n=== Decade fractions by race (purely descriptive, race-specific z-scores) ===')
for r in ['Black','Hispanic','White']:
    sub = df.loc[df['SAMPLE_RACE']==r,'SES']
    print(r, 'n=', len(sub),
          'Q1=', round(sub.quantile(0.25),3),
          'Q2=', round(sub.quantile(0.50),3),
          'Q3=', round(sub.quantile(0.75),3))
