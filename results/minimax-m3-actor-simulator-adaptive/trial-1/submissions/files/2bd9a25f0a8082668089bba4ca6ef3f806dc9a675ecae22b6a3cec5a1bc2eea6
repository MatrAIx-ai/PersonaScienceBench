"""
NLSY79 — Median wealth comparison by racial/ethnic cohort, 1985/1990/1996.

Approved approach (researcher sign-off):
- Cohort mapping:  1=Black, 2=Hispanic, 3=NBNH (reported as "White (NBNH proxy)").
- Waves reported:  1985, 1990, 1996.
- Negatives RETAINED (legitimate debts), NaNs dropped within wave (listwise).
- Nominal dollars only — no hand-built CPI table.
- Headline: median + ratio-to-white-median; auxiliaries: mean, IQR, % <=0.
- Output: descriptive table .csv + .md + this script in artifacts.
"""

import pandas as pd
import numpy as np
from pathlib import Path

DATA = Path('/workspace/data/nls_raw.csv')
OUT  = Path('/workspace/artifacts/output')
OUT.mkdir(parents=True, exist_ok=True)

# --- Step 1: load ---
df = pd.read_csv(DATA)

COHORT = 'Racial/ethnic cohort, 1979'
W85    = 'Family net wealth, 1985'
W90    = 'Family net wealth, 1990'
W96    = 'Family net wealth, 1996 (key data point)'

# --- Step 2: cohort -> race label ---
label = {1: 'Black', 2: 'Hispanic', 3: 'White (NBNH proxy)'}
df['race'] = df[COHORT].map(label)
assert df['race'].notna().all(), "Unexpected cohort code present"

ORDER  = ['Hispanic', 'Black', 'White (NBNH proxy)']
WAVES  = [(1985, W85), (1990, W90), (1996, W96)]

# --- Step 3: per-wave per-cohort stats ---
rows = []
for year, col in WAVES:
    s = df[['race', col]].dropna(subset=[col]).copy()
    for r in ORDER:
        sub = s.loc[s['race'] == r, col]
        rows.append({
            'year':            year,
            'race':            r,
            'n':               int(len(sub)),
            'median':          float(sub.median()),
            'q25':             float(sub.quantile(0.25)),
            'q75':             float(sub.quantile(0.75)),
            'mean':            float(sub.mean()),
            'pct_le_zero':     float((sub <= 0).mean() * 100),
        })
panel = pd.DataFrame(rows)

# --- Step 4: ratios to white median per year + trajectory ratios ---
panel = panel.sort_values(['year', 'race']).reset_index(drop=True)
panel['ratio_to_white_median'] = np.nan
for yr, grp in panel.groupby('year'):
    white_med = grp.loc[grp['race'] == 'White (NBNH proxy)', 'median'].iloc[0]
    for idx in grp.index:
        m = panel.at[idx, 'median']
        if pd.notna(m) and white_med not in (0, np.nan):
            panel.at[idx, 'ratio_to_white_median'] = float(m / white_med)

# Trajectory: ratio of median at year_t to median at year_0 (1985)
trajectory_rows = []
for r in ORDER:
    base = panel.loc[(panel['race'] == r) & (panel['year'] == 1985), 'median'].iloc[0]
    for yr, _ in WAVES:
        cur = panel.loc[(panel['race'] == r) & (panel['year'] == yr), 'median'].iloc[0]
        trajectory_rows.append({
            'race': r,
            'year': yr,
            'median': float(cur),
            'multiple_of_1985_median': float(cur / base) if base else np.nan,
        })
traj = pd.DataFrame(trajectory_rows)

# Pairwise gap change (Black/White and Hispanic/White ratio trajectory)
gap_rows = []
for yr, _ in WAVES:
    by_year = panel[panel['year'] == yr].set_index('race')
    b = by_year.at['Black', 'median']
    h = by_year.at['Hispanic', 'median']
    w = by_year.at['White (NBNH proxy)', 'median']
    gap_rows.append({
        'year': yr,
        'B_over_W': float(b / w),
        'H_over_W': float(h / w),
    })
gap = pd.DataFrame(gap_rows)
B85, H85 = gap.loc[gap['year'] == 1985, ['B_over_W', 'H_over_W']].iloc[0]
B96, H96 = gap.loc[gap['year'] == 1996, ['B_over_W', 'H_over_W']].iloc[0]

# --- Step 5: persist machine-readable CSVs ---
panel.to_csv(OUT / 'descriptive_wealth_table.csv', index=False)
traj.to_csv(OUT / 'wealth_trajectory_multiples.csv', index=False)
gap.to_csv(OUT / 'gap_ratios_over_time.csv', index=False)

# --- Step 6: rendered markdown table ---
fmt = lambda v: f"${v:,.0f}" if pd.notna(v) else "—"
fmt_pct = lambda v: f"{v:.1f}%" if pd.notna(v) else "—"
fmt_ratio = lambda v: f"{v:.3f}" if pd.notna(v) else "—"

md_lines = []
md_lines.append("# NLSY79 — Family net wealth by racial/ethnic cohort\n")
md_lines.append("**Source file:** `data/nls_raw.csv`  \n")
md_lines.append("**Unit:** Family net wealth (assets − debts), nominal dollars of the survey wave  \n")
md_lines.append("**Cohort mapping:** 1=Black, 2=Hispanic, 3=Non-Black Non-Hispanic → reported as *White (NBNH proxy)*  \n")
md_lines.append("**Cleaning:** within-wave listwise deletion of NaN; negatives RETAINED (legitimate debts); no sentinel values present\n")
md_lines.append("\n## Per-wave descriptive statistics\n")
md_lines.append(
    "| Year | Race | N | Median | Q25 | Q75 | Mean | % with wealth ≤ 0 | Ratio to White median |"
)
md_lines.append("|------|------|--:|-------:|----:|----:|-----:|-------------------:|----------------------:|")
for _, r in panel.iterrows():
    md_lines.append(
        f"| {int(r['year'])} | {r['race']} | {int(r['n']):,} | "
        f"{fmt(r['median'])} | {fmt(r['q25'])} | {fmt(r['q75'])} | "
        f"{fmt(r['mean'])} | {fmt_pct(r['pct_le_zero'])} | "
        f"{fmt_ratio(r['ratio_to_white_median'])} |"
    )

md_lines.append("\n## Trajectory — median multiples of 1985 baseline (nominal)\n")
md_lines.append("| Race | 1985 | 1990 (×1985) | 1996 (×1985) |")
md_lines.append("|------|-----:|-------------:|-------------:|")
for r in ORDER:
    rs = traj[traj['race'] == r].sort_values('year')
    md_lines.append(
        f"| {r} | {fmt(rs.iloc[0]['median'])} | "
        f"{rs.iloc[1]['multiple_of_1985_median']:.2f}× | "
        f"{rs.iloc[2]['multiple_of_1985_median']:.2f}× |"
    )

md_lines.append("\n## Gap trajectory — Black/White and Hispanic/White median ratios per wave\n")
md_lines.append("| Year | Black / White | Hispanic / White |")
md_lines.append("|------|--------------:|-----------------:|")
for _, r in gap.iterrows():
    md_lines.append(
        f"| {int(r['year'])} | {r['B_over_W']:.3f} | {r['H_over_W']:.3f} |"
    )

md_lines.append("\n## Sample retention 1985 → 1996 (descriptive attrition)\n")
md_lines.append("| Race | 1985 N | 1990 N | 1996 N | 1985→1996 retention |")
md_lines.append("|------|------:|------:|------:|-------------------:|")
for r in ORDER:
    ns = [int(panel.loc[(panel['race']==r) & (panel['year']==y), 'n'].iloc[0]) for y, _ in WAVES]
    md_lines.append(
        f"| {r} | {ns[0]:,} | {ns[1]:,} | {ns[2]:,} | "
        f"{100*ns[2]/ns[0]:.1f}% |"
    )

md_text = "\n".join(md_lines) + "\n"
(OUT / 'descriptive_wealth_table.md').write_text(md_text)

# --- Console echo for the result handoff ---
print(md_text)
print("\n=== B/W and H/W ratio trajectory (1985 -> 1990 -> 1996) ===")
print(gap.to_string(index=False))
print(f"\nBlack/White median ratio change 1985->1996: {B85:.3f} -> {B96:.3f}  (Δ = {B96-B85:+.3f})")
print(f"Hispanic/White median ratio change 1985->1996: {H85:.3f} -> {H96:.3f}  (Δ = {H96-H85:+.3f})")
