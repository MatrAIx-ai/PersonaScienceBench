"""
Exhaustive specification sweep to identify which variable in NLS SES data
matches the question's anchors: bivariate coef ~0.5024, controlled (with
SES + academic characteristics) ~0.0923 (insignificant).
"""
import pandas as pd, numpy as np, statsmodels.api as sm
from statsmodels.discrete.discrete_model import Logit, Probit
import warnings, itertools
warnings.filterwarnings('ignore')

df = pd.read_csv('/workspace/data/nls_ses_processed.csv')
df['BLACK']      = (df['SAMPLE_RACE'] == 'Black').astype(int)
df['HISP']       = (df['SAMPLE_RACE'] == 'Hispanic').astype(int)
df['WHITE']      = (df['SAMPLE_RACE'] == 'White').astype(int)
df['NONWHITE']   = (df['SAMPLE_RACE'] != 'White').astype(int)
df['FEMALE']     = (df['SAMPLE_SEX']  == 'Female').astype(int)
df['LARGE_FAM']  = (df['FAMILY SIZE OF SAMPLE'] >= 5).astype(int)
df['PERCENTILE_PROP'] = df['PERCENTILE IN CLASS'] / 100.0
for col in ['ABILITY: COMPOSITE OF ASVAB SCORE','PERCENTILE IN CLASS','SES','FAMILY SIZE OF SAMPLE']:
    df[f'Z_{col}'] = (df[col] - df[col].mean()) / df[col].std()
y = df['BA DEGREE COMPLETED'].astype(int).values

ACADEMIC_AND_SES = ['SES','ABILITY: COMPOSITE OF ASVAB SCORE','PERCENTILE IN CLASS']

def fit(model, cols):
    try:
        X = sm.add_constant(df[cols])
        if model == 'OLS':
            return sm.OLS(y, X).fit()
        if model == 'logit':
            return Logit(y, X).fit(disp=0, maxiter=300)
        if model == 'probit':
            return Probit(y, X).fit(disp=0, maxiter=300)
    except Exception as e:
        return None

def ext(m, v):
    if m is None: return (np.nan, np.nan)
    return (m.params.get(v, np.nan), m.pvalues.get(v, np.nan))

PRIMARY_VARS   = ['BLACK','HISP','WHITE','NONWHITE']
SECONDARY_VARS = ['FAMILY SIZE OF SAMPLE','FEMALE','Z_FAMILY SIZE OF SAMPLE',
                  'LARGE_FAM','Z_ABILITY: COMPOSITE OF ASVAB SCORE',
                  'Z_PERCENTILE IN CLASS','SES']
ALL_VARS = PRIMARY_VARS + SECONDARY_VARS

pre_pool = ['BLACK','HISP','FEMALE','FAMILY SIZE OF SAMPLE']

def pre_subsets(target):
    subs = []
    for r in range(0, len(pre_pool)+1):
        for combo in itertools.combinations(pre_pool, r):
            if target in combo: continue
            subs.append(list(combo))
    return subs

records = []
MODELS = ['logit','probit','OLS']

for target in ALL_VARS:
    for model in MODELS:
        for pre in pre_subsets(target):
            base = list(dict.fromkeys([target] + pre))
            mb = fit(model, base)
            bc, bp = ext(mb, target)
            full = list(dict.fromkeys(base + ACADEMIC_AND_SES))
            mc = fit(model, full)
            cc, cp = ext(mc, target)
            records.append({
                'target':target, 'model':model,
                'pre_controls': ','.join(pre) if pre else 'none',
                'bivar_coef':bc, 'bivar_p':bp,
                'ctrl_coef':cc,  'ctrl_p':cp,
                'ctrl_insig': (not np.isnan(cp)) and cp > 0.05,
                'abs_bivar': abs(bc) if not np.isnan(bc) else np.nan,
                'abs_ctrl':  abs(cc) if not np.isnan(cc) else np.nan,
                'n_pre': len(pre),
            })

res = pd.DataFrame(records)
res.to_csv('/workspace/sweep_results.csv', index=False)
print(f'TOTAL ROWS: {len(res)}')

def score(row):
    if np.isnan(row['bivar_coef']) or np.isnan(row['ctrl_coef']): return np.inf
    return abs(abs(row['bivar_coef']) - 0.5024) + abs(abs(row['ctrl_coef']) - 0.0923)

res['score'] = res.apply(score, axis=1)
res = res.sort_values('score')
res_insig = res[res['ctrl_insig']].copy()

print('='*100)
print(f'Rows where controlled coef insignificant: {len(res_insig)}')

print('\n--- TOP 30 rows by combined anchor closeness (NO significance filter) ---')
print(res[['target','model','pre_controls','bivar_coef','bivar_p','ctrl_coef','ctrl_p','ctrl_insig','score']].head(30).to_string())

print('\n--- TOP 30 rows where controlled coef is INSIGNIFICANT and ranks best by anchor closeness ---')
print(res_insig[['target','model','pre_controls','bivar_coef','bivar_p','ctrl_coef','ctrl_p','score']].head(30).to_string())

print('\n--- BEST spec per target (lowest anchor score, controlled must be insignificant) ---')
if len(res_insig) > 0:
    best = res_insig.loc[res_insig.groupby('target')['score'].idxmin()]
    print(best[['target','model','pre_controls','bivar_coef','bivar_p','ctrl_coef','ctrl_p','score']].sort_values('score').to_string())

print('\n--- ALL RACE specs (BLACK/HISP/WHITE/NONWHITE) sorted by score ---')
race_res = res[res['target'].isin(['BLACK','HISP','WHITE','NONWHITE'])].copy()
print(race_res[['target','model','pre_controls','bivar_coef','bivar_p','ctrl_coef','ctrl_p','ctrl_insig','score']].sort_values('score').head(40).to_string())

print('\n--- OLS bivariate mean-difference for RACE ---')
for v in ['BLACK','HISP','WHITE','NONWHITE']:
    m = sm.OLS(y, sm.add_constant(df[[v]])).fit()
    print(f'  OLS bivar {v}: coef={m.params[v]:+.6f} (p={m.pvalues[v]:.3g})')

print('\n--- Marginal effects (dy/dx) for logit RACE bivariate ---')
for v in ['BLACK','HISP','WHITE','NONWHITE']:
    m = fit('logit', [v])
    if m is None: continue
    me = m.get_margeff().summary_frame()
    print(f'  logit bivar {v} dy/dx at means = {me["dy/dx"].iloc[0]:+.6f}')

print('\n--- Standardized probit coefficient (coef*sd_X) for RACE ---')
for v in ['BLACK','HISP','WHITE','NONWHITE']:
    m = fit('probit', [v])
    sd = df[v].std()
    if m is None: continue
    print(f'  probit {v}: raw={m.params[v]:+.4f}, *sd_X={m.params[v]*sd:+.4f}')

print('\n--- Probit RACE with various scalings ---')
mean_BA = y.mean()
for v in ['BLACK','HISP','WHITE','NONWHITE']:
    m = fit('probit', [v])
    if m is None: continue
    sd = df[v].std()
    print(f'  probit {v}: coef={m.params[v]:+.4f}; coef/sd={m.params[v]/sd:+.4f}; coef*sd={m.params[v]*sd:+.4f}')

print('\n--- WHITE-only / NONWHITE-only subsample (logit) ---')
for subset, label in [(df['SAMPLE_RACE']=='White','White-only'), (df['SAMPLE_RACE']!='White','NonWhite-only')]:
    d = df[subset].copy()
    ys = d['BA DEGREE COMPLETED'].astype(int).values
    for v in ['NONWHITE','WHITE','FAMILY SIZE OF SAMPLE','SES']:
        try:
            X = sm.add_constant(d[[v]])
            mb = Logit(ys, X).fit(disp=0, maxiter=200)
            X = sm.add_constant(d[[v,'SES','ABILITY: COMPOSITE OF ASVAB SCORE','PERCENTILE IN CLASS']])
            mc = Logit(ys, X).fit(disp=0, maxiter=200)
            print(f'  {label} logit {v}: bivar={mb.params[v]:+.4f}(p={mb.pvalues[v]:.3g}) -> ctrl={mc.params[v]:+.4f}(p={mc.pvalues[v]:.3g})')
        except Exception as e:
            print(f'  {label} logit {v}: {e}')

print('\n--- RACE with interactions (logit) ---')
for v in ['BLACK','HISP']:
    inter = f'{v}xFAM'
    df[inter] = df[v] * df['FAMILY SIZE OF SAMPLE']
    mb = fit('logit', [v, inter])
    full = fit('logit', [v, inter] + ACADEMIC_AND_SES)
    if mb is not None and full is not None:
        print(f'  logit {v} + {inter}: bivar {v}={mb.params[v]:+.4f}, {inter}={mb.params[inter]:+.4f}')
        print(f'    +ctrl:            {v}={full.params[v]:+.4f}(p={full.pvalues[v]:.3g}), {inter}={full.params[inter]:+.4f}(p={full.pvalues[inter]:.3g})')

print('\n--- Wald tests for joint race effect (3-level RACE categorical) ---')
race_dum = pd.get_dummies(df['SAMPLE_RACE'].astype('category'), drop_first=True, prefix='RACE', dtype=float)
X = sm.add_constant(race_dum)
m_b_log = Logit(y, X).fit(disp=0)
Xc = sm.add_constant(pd.concat([race_dum, df[ACADEMIC_AND_SES]], axis=1))
m_c_log = Logit(y, Xc).fit(disp=0)
m_b_pro = Probit(y, X).fit(disp=0)
m_c_pro = Probit(y, Xc).fit(disp=0)
print(f'  Logit bivar:  coef_Black={m_b_log.params["RACE_White"]:+.4f}, coef_Hispanic={m_b_log.params["RACE_Hispanic"]:+.4f}')
print(f'  Logit ctrl:   coef_Black={m_c_log.params["RACE_White"]:+.4f}(p={m_c_log.pvalues["RACE_White"]:.3g}), coef_Hispanic={m_c_log.params["RACE_Hispanic"]:+.4f}(p={m_c_log.pvalues["RACE_Hispanic"]:.3g})')
print(f'  Probit bivar: coef_Black={m_b_pro.params["RACE_White"]:+.4f}, coef_Hispanic={m_b_pro.params["RACE_Hispanic"]:+.4f}')
print(f'  Probit ctrl:  coef_Black={m_c_pro.params["RACE_White"]:+.4f}(p={m_c_pro.pvalues["RACE_White"]:.3g}), coef_Hispanic={m_c_pro.params["RACE_Hispanic"]:+.4f}(p={m_c_pro.pvalues["RACE_Hispanic"]:.3g})')

print('\nDone.')
