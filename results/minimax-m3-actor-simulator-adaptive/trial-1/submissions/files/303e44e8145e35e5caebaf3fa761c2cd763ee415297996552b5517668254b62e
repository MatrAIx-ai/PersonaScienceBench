import pandas as pd
import numpy as np
from scipy.stats import pearsonr, spearmanr

df = pd.read_csv('/workspace/data/nls_bmi_processed.csv')
key = ['GENDER','AGE','AGE_2','INCOME','DISSAVED','SAMESAVE','BMI','BLACK','HISPANIC']

# How does dup-status affect DISSAVED?
df['_dup'] = df.duplicated(subset=key, keep=False)
print("DISSAVED rate in dup vs non-dup rows:")
print(df.groupby('_dup')['DISSAVED'].agg(['count','mean']))
print("\nMean AGE / INCOME / BMI in dup vs non-dup:")
print(df.groupby('_dup')[['AGE','INCOME','BMI']].mean().round(3))

# But wait: the .groupby(_dup) does each row as 1; statements about count/correlation between metrics
# could simply reflect a different composition. Let me check whether the duplicates are biased to
# young+savers (DISSAVED=0).

# Compute correlation on full data
print("\n--- Full data (no dedup) ---")
print(f"n={len(df)}, DISSAVED={df['DISSAVED'].mean():.4f}, Pearson(AGE,DISSAVED)={pearsonr(df['AGE'], df['DISSAVED'])[0]:.4f}")
print(f"  DISSAVED by AGE quartile:")
q = pd.qcut(df['AGE'], 4, duplicates='drop')
print(df.groupby(q, observed=True).agg(q_low=('AGE','min'), q_high=('AGE','max'), n=('DISSAVED','size'), dissaved_rate=('DISSAVED','mean')).round(4).to_string())

# Dedup
df_u = df.drop_duplicates(subset=key).reset_index(drop=True)
print(f"\n--- After dedup of full key ---")
print(f"n={len(df_u)}, DISSAVED={df_u['DISSAVED'].mean():.4f}, Pearson(AGE,DISSAVED)={pearsonr(df_u['AGE'], df_u['DISSAVED'])[0]:.4f}")
q = pd.qcut(df_u['AGE'], 4, duplicates='drop')
print(df_u.groupby(q, observed=True).agg(q_low=('AGE','min'), q_high=('AGE','max'), n=('DISSAVED','size'), dissaved_rate=('DISSAVED','mean')).round(4).to_string())

# What if I dedup on JUST (GENDER, AGE, AGE_2, INCOME, BMI, BLACK, HISPANIC, SAMESAVE) -> only DISSAVED determines uniqueness?
key_nod = ['GENDER','AGE','AGE_2','INCOME','SAMESAVE','BMI','BLACK','HISPANIC']
df_u2 = df.drop_duplicates(subset=key_nod).reset_index(drop=True)
print(f"\n--- After dedup WITHOUT DISSAVED in key (keep first DISSAVED per demographic) ---")
print(f"n={len(df_u2)}, DISSAVED={df_u2['DISSAVED'].mean():.4f}, Pearson(AGE,DISSAVED)={pearsonr(df_u2['AGE'], df_u2['DISSAVED'])[0]:.4f}")
q = pd.qcut(df_u2['AGE'], 4, duplicates='drop')
print(df_u2.groupby(q, observed=True).agg(q_low=('AGE','min'), q_high=('AGE','max'), n=('DISSAVED','size'), dissaved_rate=('DISSAVED','mean')).round(4).to_string())

