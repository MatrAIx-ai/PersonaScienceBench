"""Main analysis for the nls_incarceration wealth question.

Design (per approved plan):
- Per wealth year (1985, 1990, 1996), compare ever_jailed=1 vs ever_jailed=0.
- Primary test: Welch's t-test on rank-transformed wealth (normalises skew).
- Sensitivity tests:
   * Mann-Whitney U
   * Welch's t-test on log1p(wealth - min + 1)
- Significance: two-sided alpha = 0.05 with Benjamini-Hochberg FDR applied across
  the THREE primary (rank-Welch) tests. Direction is gated: a year counts as
  'significantly lower' iff FDR-adjusted p < alpha AND the primary point
  estimate (rank mean difference, jailed=1 minus not) is < 0.
- Stratification (race and sex): reported as supporting evidence; cell-level
  significance is NOT a gating condition.
- Output: results/results_main.csv, results/results_sensitivity.csv,
  results/results_stratified.csv, results/results_summary.txt.
"""
import json
import numpy as np
import pandas as pd
from scipy import stats
from statsmodels.stats.multitest import multipletests

PATH = "data/nls_incarceration_processed.csv"
YEARS = ["composite_wealth_1985", "composite_wealth_1990", "composite_wealth_1996"]
YEAR_LABELS = [c.split("_")[-1] for c in YEARS]  # 1985, 1990, 1996
ALPHA = 0.05

df = pd.read_csv(PATH)
ej0 = df[df["ever_jailed"] == 0]
ej1 = df[df["ever_jailed"] == 1]
print(f"ever_jailed=1 n = {len(ej1)} ; ever_jailed=0 n = {len(ej0)}")

# ---------- Primary tests: Welch t on rank-transformed wealth ----------
primary_rows = []
for col, lab in zip(YEARS, YEAR_LABELS):
    a_full = df[col].astype(float).values
    ranks = stats.rankdata(a_full)               # average ranks over ties
    r0 = ranks[df["ever_jailed"].values == 0]
    r1 = ranks[df["ever_jailed"].values == 1]
    tstat, p_two = stats.ttest_ind(r1, r0, equal_var=False)
    point = float(r1.mean() - r0.mean())          # jailed minus not; negative => lower
    d = pd.DataFrame([{
        "wealth_year": lab, "year_col": col,
        "test": "welch_t_rank",
        "n_jailed": int(len(r1)), "n_not": int(len(r0)),
        "mean_jailed_rank": float(r1.mean()),
        "mean_not_rank": float(r0.mean()),
        "point_diff": point,
        "direction": "lower" if point < 0 else "higher_or_equal",
        "t_stat": float(tstat), "p_two_sided": float(p_two),
    }])
    primary_rows.append(d)

prim = pd.concat(primary_rows, ignore_index=True)

# FDR across the THREE primary tests (BH)
reject, p_adj, _, _ = multipletests(prim["p_two_sided"].values, alpha=ALPHA, method="fdr_bh")
prim["p_fdr_bh"] = p_adj
prim["sig_fdr"] = reject
prim["sig_fdr_AND_lower"] = (prim["sig_fdr"]) & (prim["direction"] == "lower")

# ---------- Sensitivity tests ----------
sens_rows = []
for col, lab in zip(YEARS, YEAR_LABELS):
    a0 = ej0[col].astype(float).values
    a1 = ej1[col].astype(float).values
    # Mann-Whitney U (two-sided)
    u_stat, p_mw = stats.mannwhitneyu(a1, a0, alternative="two-sided")
    # point estimate: difference in medians (jailed minus not)
    point_med = float(np.median(a1) - np.median(a0))
    sens_rows.append({"wealth_year": lab, "year_col": col, "test": "mann_whitney_u",
                      "n_jailed": int(len(a1)), "n_not": int(len(a0)),
                      "point_diff": point_med,
                      "direction": "lower" if point_med < 0 else "higher_or_equal",
                      "stat": float(u_stat), "p_two_sided": float(p_mw)})
    # Welch t on log1p(wealth - min + 1)
    x = df[col].astype(float).values
    shift = -x.min() + 1.0
    y = np.log1p(x + shift)
    y0 = y[df["ever_jailed"].values == 0]
    y1 = y[df["ever_jailed"].values == 1]
    t_log, p_log = stats.ttest_ind(y1, y0, equal_var=False)
    point_log = float(y1.mean() - y0.mean())
    sens_rows.append({"wealth_year": lab, "year_col": col, "test": "welch_t_log1p",
                      "n_jailed": int(len(y1)), "n_not": int(len(y0)),
                      "point_diff": point_log,
                      "direction": "lower" if point_log < 0 else "higher_or_equal",
                      "stat": float(t_log), "p_two_sided": float(p_log)})

sens = pd.DataFrame(sens_rows)

# ---------- Stratified descriptive: year x ever_jailed x {race, sex} ----------
strat_rows = []
for col, lab in zip(YEARS, YEAR_LABELS):
    for dim in ["race", "sex"]:
        for lev in sorted(df[dim].unique()):
            sub = df[df[dim] == lev]
            n1 = int((sub["ever_jailed"] == 1).sum())
            n0 = int((sub["ever_jailed"] == 0).sum())
            m1 = float(sub.loc[sub["ever_jailed"] == 1, col].mean())
            m0 = float(sub.loc[sub["ever_jailed"] == 0, col].mean())
            med1 = float(sub.loc[sub["ever_jailed"] == 1, col].median())
            med0 = float(sub.loc[sub["ever_jailed"] == 0, col].median())
            rankvals = stats.rankdata(sub[col].astype(float).values)
            r1 = rankvals[sub["ever_jailed"].values == 1]
            r0 = rankvals[sub["ever_jailed"].values == 0]
            # Welch t on ranks (cell-level, not FDR-controlled)
            if n1 >= 2 and n0 >= 2:
                t, p = stats.ttest_ind(r1, r0, equal_var=False)
            else:
                t, p = np.nan, np.nan
            strat_rows.append({
                "wealth_year": lab, "year_col": col, "stratifier": dim, "level": lev,
                "n_jailed": n1, "n_not": n0,
                "mean_jailed": m1, "mean_not": m0,
                "median_jailed": med1, "median_not": med0,
                "raw_mean_diff_jailed_minus_not": m1 - m0,
                "welch_t_rank_t": float(t) if not np.isnan(t) else np.nan,
                "welch_t_rank_p_two_sided": float(p) if not np.isnan(p) else np.nan,
            })
strat = pd.DataFrame(strat_rows)

# ---------- Persist tables ----------
prim.to_csv("/workspace/results/results_main.csv", index=False)
sens.to_csv("/workspace/results/results_sensitivity.csv", index=False)
strat.to_csv("/workspace/results/results_stratified.csv", index=False)

# ---------- Build plain-text summary ----------
sig_years = prim.loc[prim["sig_fdr_AND_lower"], "wealth_year"].tolist()
abs_diffs = [
    (lab, float(ej0[col].mean() - ej1[col].mean()))
    for col, lab in zip(YEARS, YEAR_LABELS)
]
secondary_yr = max(abs_diffs, key=lambda x: x[1])[0]

lines = []
lines.append("Primary test (Welch t on rank-transformed wealth), BH-FDR across 3 year-tests:")
lines.append(prim.to_string(index=False))
lines.append("")
lines.append(f"Decision rule: sig_fdr_AND_lower == True for years = {sig_years}")
lines.append(f"Secondary characterisation (largest |mean(j=0) - mean(j=1)| on raw $): {secondary_yr}")
lines.append("")
lines.append("Sensitivity tests (per-year, NOT FDR-controlled, descriptive support only):")
lines.append(sens.to_string(index=False))
lines.append("")
lines.append("Stratified descriptive + per-cell rank-Welch (NOT FDR-controlled, supporting only):")
lines.append(strat.to_string(index=False))

with open("/workspace/results/results_summary.txt", "w") as f:
    f.write("\n".join(lines))

print("\n".join(lines))
