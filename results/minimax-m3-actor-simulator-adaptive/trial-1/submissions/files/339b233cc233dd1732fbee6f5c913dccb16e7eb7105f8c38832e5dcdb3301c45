"""
DiscoveryBench analysis: How did urban land use affect the invasion of
different types of introduced plants (Catalonia/Barcelona non-native flora)?

Implements all four steps (plot-level NB-GLMs, species-level models, PGLS via
manual PIC, contingency chi-square) and saves a JSON evidence bundle plus a
plain-text summary to /workspace/artifacts/.
"""
import csv, json, math, re, os, sys, warnings
from collections import Counter, defaultdict
warnings.filterwarnings("ignore", category=UserWarning)
warnings.filterwarnings("ignore", category=FutureWarning)
import numpy as np
import pandas as pd
import scipy.stats as ss
import statsmodels.api as sm
import statsmodels.formula.api as smf

DATA = "/workspace/data"
ART  = "/workspace/artifacts"
os.makedirs(ART, exist_ok=True)

# ---- Load ----
tmp = pd.read_csv(f"{DATA}/temporal_trends_contingency_table.csv", sep="\t")
tree_str = open(f"{DATA}/phylogenetic_tree.txt").read().strip()
spc = pd.read_csv(f"{DATA}/invasion_success_pathways.csv")
plt = pd.read_csv(f"{DATA}/invaded_niche_pathways.csv", sep="\t")
print(f"Loaded: temporal {tmp.shape}, success {spc.shape}, plot {plt.shape}")
assert tmp.shape == (12, 3) and spc.shape[0] == 81 and plt.shape[0] == 632
assert (plt["n.gard"] + plt["n.unint"] + plt["n.agfo"] == plt["n.total"]).all()

# ---- Aliases (safe names for patsy) ----
plt["n_gard"]  = plt["n.gard"].astype(int)
plt["n_unint"] = plt["n.unint"].astype(int)
plt["n_agfo"]  = plt["n.agfo"].astype(int)
plt["n_total"] = plt["n.total"].astype(int)
plt["urban_2009_500m"]  = plt["urban.2009.500m"]
plt["urban_2009_1000m"] = plt["urban.2009.1000m"]
plt["cropland_2009_500m"] = plt["cropland.2009.500m"]

cont_covars = ["elevation","distance.stream","distance.road",
               "annual.temperature","annual.rainfall","annual.radiation"]
for c in cont_covars:
    plt[f"z_{c}"] = (plt[c] - plt[c].mean()) / plt[c].std()

def logit_col(s):
    return np.log((s + 1e-3) / (1 - s + 1e-3))

plt["logit_urban_2009_500m"]   = logit_col(plt["urban_2009_500m"])
plt["logit_urban_2009_1000m"]  = logit_col(plt["urban_2009_1000m"])
plt["logit_cropland_2009_500m"] = logit_col(plt["cropland_2009_500m"])

H = "logit_urban_2009_500m"
S = "logit_urban_2009_1000m"

# Alias dotted column names to safe (non-dotted) names (patsy/Q() compatibility)
plt["z_distance_stream"]  = plt["z_distance.stream"]
plt["z_distance_road"]    = plt["z_distance.road"]
plt["z_annual_temperature"] = plt["z_annual.temperature"]
plt["z_annual_rainfall"]    = plt["z_annual.rainfall"]
plt["z_annual_radiation"]   = plt["z_annual.radiation"]



def spear(x, y): return ss.spearmanr(x, y, nan_policy="omit").statistic

def nb_fit(df, formula):
    try:
        return smf.glm(formula, data=df, family=sm.families.NegativeBinomial()).fit(maxiter=200, disp=False)
    except Exception as e:
        print(f"  NB failed: {e}")
        return None

def qp_fit(df, formula):
    try:
        return smf.glm(formula, data=df, family=sm.families.Poisson()).fit(cov_type="HC1")
    except Exception as e:
        print(f"  QP failed: {e}")
        return None

out = {}

# ============================================================
# STEP 1: plot-level associations
# ============================================================
print("\n=== STEP 1: Plot-level associations ===")

# 1a) Spearman across years/radii
print("\nSpearman (pathway x urban):")
spear_table = {}
for yr in ["1956","1993","2009"]:
    for rad in ["50m","500m","1000m"]:
        u = plt[f"urban.{yr}.{rad}"]
        spear_table[f"urban.{yr}.{rad}"] = {
            "n_gard": round(spear(plt["n_gard"], u), 3),
            "n_unint": round(spear(plt["n_unint"], u), 3),
            "n_agfo": round(spear(plt["n_agfo"], u), 3),
            "n_total": round(spear(plt["n_total"], u), 3),
        }
        print(f"  urban.{yr}.{rad} | n_gard={spear_table[f'urban.{yr}.{rad}']['n_gard']:+.3f}  n_unint={spear_table[f'urban.{yr}.{rad}']['n_unint']:+.3f}  n_agfo={spear_table[f'urban.{yr}.{rad}']['n_agfo']:+.3f}")
out["spearman_pathway_x_landcover"] = spear_table

# 1b) NB-GLM per pathway at 500m
forms = {
    rv: f"{rv} ~ {H} + logit_cropland_2009_500m + C(habitat) + z_elevation + z_distance_stream + z_distance_road + z_annual_temperature + z_annual_rainfall + z_annual_radiation"
    for rv in ["n_gard","n_unint","n_agfo","n_total"]
}
print("\nNB-GLM at 500m (urban + cropland + habitat + covariates):")
nb500 = {}
for resp, f in forms.items():
    m = nb_fit(plt, f)
    if m is None:
        nb500[resp] = None; continue
    coef, se, z, p = float(m.params[H]), float(m.bse[H]), float(m.tvalues[H]), float(m.pvalues[H])
    nb500[resp] = {
        "coef_logit": coef, "se": se, "z": z, "p": p,
        "IRR_per_logit_unit": float(np.exp(coef)),
        "nobs": int(m.nobs), "aic": float(m.aic),
    }
    print(f"  {resp:8s} coef={coef:+.3f}  IRR/unit={np.exp(coef):.2f}  p={p:.4g}")
out["nb_pathway_x_urban_500m"] = nb500

forms_1000 = {k: v.replace(H, S) for k,v in forms.items()}
print("\nNB-GLM at 1000m (sensitivity):")
nb1000 = {}
for resp, f in forms_1000.items():
    m = nb_fit(plt, f)
    if m is None:
        nb1000[resp] = None; continue
    coef, p = float(m.params[S]), float(m.pvalues[S])
    nb1000[resp] = {"coef_logit": coef, "p": p,
                    "IRR_per_logit_unit": float(np.exp(coef)),
                    "nobs": int(m.nobs)}
    print(f"  {resp:8s} coef={coef:+.3f}  IRR/unit={np.exp(coef):.2f}  p={p:.4g}")
out["nb_pathway_x_urban_1000m"] = nb1000

# 1c) Stacked long-format pathway × urban interaction
print("\nStacked model pathway x urban interaction:")
long = pd.melt(plt, id_vars=[H,"logit_cropland_2009_500m","habitat","z_elevation",
                              "z_distance_stream","z_distance_road",
                              "z_annual_temperature","z_annual_rainfall",
                              "z_annual_radiation"],
               value_vars=["n_gard","n_unint","n_agfo"], var_name="pathway",
               value_name="n")
long["pathway"] = long["pathway"].map({"n_gard":"Gardening","n_unint":"Unintentional","n_agfo":"AgriForest"})
f_stack = (f"n ~ C(pathway) * {H} + logit_cropland_2009_500m + "
           f"C(habitat) + z_elevation + z_distance_stream + z_distance_road + "
           f"z_annual_temperature + z_annual_rainfall + z_annual_radiation")
m_stack = nb_fit(long, f_stack)
print(f"  AIC={m_stack.aic:.1f}, deviance={m_stack.deviance:.2f}")
idx_inter = [i for i, n in enumerate(m_stack.model.exog_names)
             if "C(pathway)[T." in n and "logit_urban_2009_500m" in n]
wt = m_stack.wald_test(np.eye(len(m_stack.params))[idx_inter])
wt_stat = float(np.asarray(wt.statistic).flat[0]); wt_df = int(wt.df_denom) if hasattr(wt, "df_denom") else len(idx_inter); wt_p = float(np.asarray(wt.pvalue).flat[0])
print(f"  Interaction Wald chi2={wt_stat:.2f}, df={wt_df}, p={wt_p:.4g}")
slopes = {}
print("  Pathway-specific urban slopes:")
col_keep = []
for term, val, p in zip(m_stack.params.index, m_stack.params.values, m_stack.pvalues.values):
    if "logit_urban_2009_500m" in term and "C(pathway)" in term:
        print(f"    {term[:80]:80s} coef={val:+.3f}  p={p:.4g}")
        slopes[term] = {"coef": float(val), "p": float(p)}
out["stacked_pathway_x_urban"] = {
    "AIC": float(m_stack.aic),
    "interaction_chi2": wt_stat,
    "interaction_df": wt_df,
    "interaction_p": wt_p,
    "pathway_urban_slopes": slopes,
}

# 1d) Landscape-change tier Spearman
print("\nLandscape-change tier Spearman:")
chg_spear = {}
for tier in ["progressive.1956.2009.50m","regressive.1956.2009.50m","no.changes.1956.2009.50m"]:
    x = plt[tier]
    chg_spear[tier] = {p: round(spear(plt[p], x), 3) for p in ["n_gard","n_unint","n_agfo","n_total"]}
    print(f"  {tier:30s} | gard={chg_spear[tier]['n_gard']:+.3f}  unint={chg_spear[tier]['n_unint']:+.3f}  agfo={chg_spear[tier]['n_agfo']:+.3f}  total={chg_spear[tier]['n_total']:+.3f}")
out["spearman_landscape_change"] = chg_spear

# ============================================================
# STEP 2: species-level responses
# ============================================================
print("\n=== STEP 2: Species-level invasion success ===")
spc["pathway"] = spc["intro.pathway"]
spc["log_height"] = np.log(spc["height"].clip(lower=0.04))
spc["z_mrt"] = (spc["mrt"] - spc["mrt"].mean()) / spc["mrt"].std()
spc["z_native_niche"] = (spc["native.niche.breadth"] - spc["native.niche.breadth"].mean()) / spc["native.niche.breadth"].std()
spc["log_aoo"]    = np.log(spc["area.of.occupancy.10km"].clip(lower=1))
spc["log_nplots"] = np.log(spc["number.of.invaded.plots"].clip(lower=1))
spc["log_hrange"] = np.log(spc["habitat.range"].clip(lower=1))

print("\nMedian species-level responses by pathway:")
sp_med = spc.groupby("pathway")[["number.of.invaded.plots","area.of.occupancy.10km",
                                  "habitat.range","invaded.niche.breadth","mrt",
                                  "height"]].median().round(3)
print(sp_med)
out["species_medians_by_pathway"] = sp_med.to_dict()

print("\nKruskal-Wallis pathway-level differences:")
kw = {}
for col in ["number.of.invaded.plots","area.of.occupancy.10km","habitat.range",
            "invaded.niche.breadth","mrt","height"]:
    gG = spc.loc[spc.pathway=="Gardening", col]
    gU = spc.loc[spc.pathway=="Unintentional", col]
    gA = spc.loc[spc.pathway=="AgriForest", col]
    H_stat, p = ss.kruskal(gG, gU, gA)
    kw[col] = {"H": float(H_stat), "p": float(p)}
    print(f"  {col:30s} H={H_stat:.2f} p={p:.4g}")
out["kruskal_pathway"] = kw

# OLS regressions (log-transformed responses)
spc["growth_form_cat"] = spc["growth.form"]
spc["dispersal_cat"]  = spc["dispersal"]
spc["vegetative_cat"] = spc["vegetative"]
print("\nOLS regressions (log-transformed) - pathway contrasts vs Gardening reference:")
ols_out = {}
for resp in ["log_aoo","log_nplots","log_hrange"]:
    spc["resp"] = spc[resp]
    f = (f"resp ~ C(pathway) + C(growth_form_cat) + C(dispersal_cat) + "
         f"C(vegetative_cat) + log_height + z_mrt + z_native_niche")
    m = smf.ols(f, data=spc).fit()
    pt = {n: (float(m.params[n]), float(m.pvalues[n])) for n in m.params.index if "C(pathway)[T." in n}
    ols_out[resp] = {"R2": float(m.rsquared), "n": int(m.nobs), "AIC": float(m.aic),
                     "pathway_terms": {n: {"coef": c, "p": p} for n,(c,p) in pt.items()}}
    print(f"  {resp:30s} R2={m.rsquared:.3f}")
    for n,(c,p) in pt.items():
        print(f"      {n:60s} coef={c:+.3f} p={p:.4g}")
out["ols_species_level"] = ols_out

# ============================================================
# PGLS via PIC (no ete3 available)
# ============================================================
print("\n=== PGLS-equivalent: phylogenetic independent contrasts ===")

def parse_newick(s):
    """Parse Newick allowing internal-node labels like 'mrcaottXottY'."""
    s = s.strip().rstrip(";")
    tokens = re.findall(r"\(|\)|,|:|[A-Za-z0-9_.\-]+", s)
    pos = [0]; nodes = []
    def parse_branch_end():
        """After a tip or internal node, consume optional (label)(:length)."""
        label = None; length = None
        # No label if next token is ),],(,,,; or EOF
        if pos[0] < len(tokens):
            tk = tokens[pos[0]]
            if tk not in (")", ",", "(", ";"):
                if tk == ":":
                    pos[0] += 1
                    length = float(tokens[pos[0]]); pos[0] += 1
                else:
                    label = tokens[pos[0]]; pos[0] += 1
                    if pos[0] < len(tokens) and tokens[pos[0]] == ":":
                        pos[0] += 1; length = float(tokens[pos[0]]); pos[0] += 1
        return label, length
    def parse():
        if tokens[pos[0]] == "(":
            pos[0] += 1
            children = [parse()]
            while tokens[pos[0]] == ",":
                pos[0] += 1
                children.append(parse())
            assert tokens[pos[0]] == ")", f"Expected ), got {tokens[pos[0]]}"
            pos[0] += 1
            label, length = parse_branch_end()
            this = len(nodes); nodes.append([children, length, label]); return this
        else:
            label, length = parse_branch_end()
            this = len(nodes); nodes.append([None, length, label]); return this
    root = parse()
    assert pos[0] == len(tokens), f"Stopped at {pos[0]} of {len(tokens)}; leftover: {tokens[pos[0]:pos[0]+5]}"
    return root, nodes

root, nodes = parse_newick(tree_str)
tip_labels = [nd[2] for nd in nodes if nd[0] is None]
n_tips = len(tip_labels)
print(f"Tree parsed: {n_tips} tips, {len(nodes)} total nodes")

depth = [0.0] * len(nodes)
def set_depth(nd):
    ch, ln, _ = nodes[nd]
    if ch is None: return
    for c in ch:
        depth[c] = depth[nd] + (ln if ln else 0.0)
        set_depth(c)
set_depth(root)

parent_map = {root: None}
def set_parent(nd):
    ch, ln, _ = nodes[nd]
    if ch is None: return
    for c in ch:
        parent_map[c] = nd
        set_parent(c)
set_parent(root)

def find_lca(a, b):
    a_anc = {a}
    while a in parent_map and parent_map[a] is not None:
        a = parent_map[a]; a_anc.add(a)
    while b not in a_anc:
        if b not in parent_map or parent_map[b] is None: break
        b = parent_map[b]
    return b

def dist_tips(i, j):
    lca = find_lca(i, j)
    return depth[i] + depth[j] - 2 * depth[lca]

def pic(trait_map):
    n = len(nodes); x = [None]*n
    # assign tip trait values via node walk
    for nd_id, nd in enumerate(nodes):
        if nd[0] is None:
            lbl = nd[2]
            if lbl in trait_map:
                x[nd_id] = trait_map[lbl]
            else:
                return None
    def mean_up(nd):
        ch, ln, _ = nodes[nd]
        if ch is None: return x[nd]
        vals = [mean_up(c) for c in ch]
        x[nd] = sum(vals) / len(vals)
        return x[nd]
    mean_up(root)
    contrasts = []
    def collect(nd):
        ch, ln, _ = nodes[nd]
        if ch is None: return
        for i, ci in enumerate(ch):
            for cj in ch[i+1:]:
                d = dist_tips(ci, cj)
                if d <= 0: continue
                contrasts.append((x[ci] - x[cj], np.sqrt(d)))
        for c in ch: collect(c)
    collect(root)
    return contrasts

assert set(tip_labels) == set(spc["phylo.tip.label"]), "tip mismatch"
trait_nplots = dict(zip(spc["phylo.tip.label"], spc["number.of.invaded.plots"].astype(float)))
trait_niche  = dict(zip(spc["phylo.tip.label"], spc["invaded.niche.breadth"].astype(float)))
trait_aoo    = dict(zip(spc["phylo.tip.label"], spc["area.of.occupancy.10km"].astype(float)))
trait_mrt    = dict(zip(spc["phylo.tip.label"], spc["mrt"].astype(float)))

# build tip-pair table
tip_pairs = []
def collect_pairs(nd):
    ch, ln, _ = nodes[nd]
    if ch is None: return
    for i, ci in enumerate(ch):
        for cj in ch[i+1:]:
            d = dist_tips(ci, cj)
            if d <= 0: continue
            tip_pairs.append((ci, cj, np.sqrt(d)))
    for c in ch: collect_pairs(c)
collect_pairs(root)
print(f"# of independent contrasts: {len(tip_pairs)}")

pathway_map = dict(zip(spc["phylo.tip.label"], spc["pathway"]))
pcdf = pd.DataFrame(tip_pairs, columns=["id_a","id_b","sqrt_dist"])
def tip_label(tid): return nodes[tid][2]

pcdf["lbl_a"] = pcdf["id_a"].apply(tip_label)
pcdf["lbl_b"] = pcdf["id_b"].apply(tip_label)
pcdf["path_a"] = pcdf["lbl_a"].map(pathway_map)
pcdf["path_b"] = pcdf["lbl_b"].map(pathway_map)
pcdf["Gardening_pair"]  = (pcdf["path_a"]=="Gardening").astype(int)  - (pcdf["path_b"]=="Gardening").astype(int)
pcdf["Unintentional_pair"] = (pcdf["path_a"]=="Unintentional").astype(int) - (pcdf["path_b"]=="Unintentional").astype(int)
pcdf["AgriForest_pair"] = (pcdf["path_a"]=="AgriForest").astype(int) - (pcdf["path_b"]=="AgriForest").astype(int)

for nm, tr in [("nplots",trait_nplots),("niche",trait_niche),
                ("aoo",trait_aoo),("mrt",trait_mrt)]:
    cont = pic(tr)
    vals = [c[0] for c in cont]
    pcdf[nm] = vals
    pcdf[f"{nm}_std"] = pcdf[nm] / pcdf["sqrt_dist"]

print("\nPGLS (forced-slope) regression: contrast/sqrt(d) ~ pair-pathway indicators")
pgls = {}
for nm in ["nplots","niche","aoo","mrt"]:
    f = f"{nm}_std ~ Gardening_pair + Unintentional_pair + AgriForest_pair"
    m = smf.ols(f, data=pcdf).fit()
    pgls[nm] = {
        "n_contrasts": len(pcdf),
        "intercept": float(m.params["Intercept"]),
        "Gardening_effect": float(m.params["Gardening_pair"]),
        "Gardening_p": float(m.pvalues["Gardening_pair"]),
        "Unintentional_effect": float(m.params["Unintentional_pair"]),
        "Unintentional_p": float(m.pvalues["Unintentional_pair"]),
        "AgriForest_effect": float(m.params["AgriForest_pair"]),
        "AgriForest_p": float(m.pvalues["AgriForest_pair"]),
        "R2": float(m.rsquared),
    }
    print(f"  {nm:8s} | n_con={len(pcdf):4d}  Gardening Δ={m.params['Gardening_pair']:+.3f} (p={m.pvalues['Gardening_pair']:.3g}); "
          f"Unint Δ={m.params['Unintentional_pair']:+.3f} (p={m.pvalues['Unintentional_pair']:.3g}); "
          f"Agri Δ={m.params['AgriForest_pair']:+.3f} (p={m.pvalues['AgriForest_pair']:.3g})")
out["pgls_contrasts"] = pgls

# Pagel's lambda rough approximation: variance of contrasts / variance of tip values
print("\nPagel's lambda rough (from contrasts):")
for nm, tr in [("nplots",trait_nplots),("niche",trait_niche),("aoo",trait_aoo)]:
    var_tip = np.var(list(tr.values())) if isinstance(tr,dict) else None
    cont_var = np.var([c for c,_ in pic(tr)])
    raw_lambda = cont_var / var_tip if var_tip and var_tip > 0 else None
    print(f"  {nm:8s} Var(tips)={var_tip:.3g}  Var(contrasts)={cont_var:.3g}  rough lambda ~ {raw_lambda:.3f}" if raw_lambda else f"  {nm}: -")

# ============================================================
# STEP 3: temporal contingency
# ============================================================
print("\n=== STEP 3: Temporal contingency ===")
ct = tmp.pivot_table(index="introduction.period", columns="pathway", values="n", aggfunc="sum")
ct = ct.loc[["Before 1500","1501-1900","1901-1984","1985-2019"],
            ["AgriForest","Gardening","Unintentional"]]
print(ct)
chi2_stat, chi2_p, dof, expected = ss.chi2_contingency(ct.values)
print(f"\nchi2 = {chi2_stat:.2f}, df={dof}, p={chi2_p:.3g}")
std_resid = (ct.values - expected) / np.sqrt(expected)
print("\nStandardised residuals:")
print(pd.DataFrame(std_resid, index=ct.index, columns=ct.columns).round(2))
pct_share = (ct.div(ct.sum(axis=1), axis=0) * 100).round(1)
print("\nPercent share per period:")
print(pct_share)
out["contingency"] = {
    "table": ct.to_dict(),
    "chi2": float(chi2_stat), "df": int(dof), "p": float(chi2_p),
    "standardised_residuals": pd.DataFrame(std_resid, index=ct.index,
                                            columns=ct.columns).round(2).to_dict(),
    "percent_share": pct_share.to_dict(),
}

# ----- save outputs -----
def clean(x):
    if isinstance(x, dict):
        return {k: clean(v) for k,v in x.items()}
    if isinstance(x, list):
        return [clean(v) for v in x]
    if isinstance(x, np.integer): return int(x)
    if isinstance(x, np.floating):
        return float(x) if np.isfinite(x) else None
    if isinstance(x, np.ndarray): return clean(x.tolist())
    try:
        if pd.isna(x): return None
    except Exception: pass
    return x

with open(f"{ART}/analysis_outputs.json", "w") as f:
    json.dump(clean(out), f, indent=2, default=str)
print(f"\nSaved /workspace/artifacts/analysis_outputs.json")
