"""
DiscoveryBench — meta_regression_raw / metadata_18 / turn 1.
Question: "What proportion of studies in Experimental Economics were conducted in a lab setting?"

Locked baseline (from approved plan):
  - sample: study_data[project=='ee'] (unique by id; n=18)
  - dedup key: id (no duplicates within ee)
  - origin side: O (columns online.o, subjects.o)
  - proxy A (primary, conservative lower-bound): lab := (online.o == 0)
  - proxy B (sensitivity, strict EE-lab per Falk & Heckman):
        lab := (online.o == 0) AND (subjects.o == "students")
  - 95% Wilson CI, z = 1.96
  - success_data used only as sanity-check of selection identity
"""
import json, math
import pandas as pd

DS1 = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
DS2 = "data/meta-regression_replication_success_data_heterogeneity_in_replication_projects.csv"

ds1 = pd.read_csv(DS1)
ds2 = pd.read_csv(DS2)

# --- 1. Sample selection ---
ee = ds1[ds1["project"] == "ee"].copy()
n = len(ee)
assert ee["id"].nunique() == n
assert ee["title"].nunique() == n
assert ee["discipline"].eq("Economics").all()

# --- 2. Proxies ---
mask_A = ee["online.o"] == 0
mask_B = mask_A & (ee["subjects.o"] == "students")
x_A, x_B = int(mask_A.sum()), int(mask_B.sum())

# --- 3. Wilson 95% CI ---
def wilson(x, n, z=1.96):
    if n == 0: return (float("nan"),) * 3
    p = x / n
    denom = 1 + z * z / n
    center = (p + z * z / (2 * n)) / denom
    half = z * math.sqrt(p * (1 - p) / n + z * z / (4 * n * n)) / denom
    lo, hi = max(0.0, center - half), min(1.0, center + half)
    return lo, hi, hi - lo

lo_A, hi_A, w_A = wilson(x_A, n)
lo_B, hi_B, w_B = wilson(x_B, n)

# --- 4. Diagnostics ---
diag = {
    "online.o_counts":      ee["online.o"].value_counts(dropna=False).to_dict(),
    "subjects.o_counts":    ee["subjects.o"].value_counts(dropna=False).to_dict(),
    "pub_year_counts":      ee["pub_year"].value_counts(dropna=False).to_dict(),
    "country_counts":       ee["experiment_country.o"].value_counts(dropna=False).to_dict(),
    "compensation.o_counts":ee["compensation.o"].value_counts(dropna=False).to_dict(),
    "online.o_na_in_ee":    int(ee["online.o"].isna().sum()),
    "subjects.o_na_in_ee":  int(ee["subjects.o"].isna().sum()),
}

# --- 5. Sanity-check identity with success_data (no setting columns there) ---
ee2 = ds2[ds2["project"] == "Experimental Economics"].copy()
ee["first_last"] = ee["authors.o"].str.split(" and ").str[0].str.split().str[-1]
matches = 0
for _, r in ee.iterrows():
    has = ee2["study"].str.contains(r["first_last"], regex=False, na=False) & \
          ee2["study"].str.contains(str(int(r["pub_year"])), regex=False, na=False)
    if has.any(): matches += 1

report = {
    "n_total": n,
    "proxy_A": {"x": x_A, "p": x_A / n,
                "wilson_lo": lo_A, "wilson_hi": hi_A, "width": w_A,
                "definition": "lab := (online.o == 0)"},
    "proxy_B": {"x": x_B, "p": x_B / n,
                "wilson_lo": lo_B, "wilson_hi": hi_B, "width": w_B,
                "definition": "lab := (online.o == 0) AND (subjects.o == 'students')"},
    "diagnostics": diag,
    "sanity_check": {
        "ds1_ee_rows": int(len(ee)),
        "ds2_ee_rows": int(len(ee2)),
        "first_author_year_matches": f"{matches}/{n}",
    },
}
print(json.dumps(report, indent=2, default=str))
