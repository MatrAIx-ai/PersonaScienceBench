#!/usr/bin/env python3
# Replica: window 3400-3000 BCE, 5 anclajes crudos.
import pandas as pd, numpy as np
ts=pd.read_csv("data/time_series_data.csv")
win=ts[(ts["CE"]>=-3400)&(ts["CE"]<=-3000)&(ts["CE"]%100==0)].sort_values("CE",ascending=False).reset_index(drop=True)
win["BCE"]=-win["CE"].astype(int)
win["Zcs"]=win[["HatchetSword","HouseSize"]].mean(axis=1)
DV=["MonumentCount","MonumentSize","AxesCelts"]; SY=["HatchetSword","Dagger","HouseSize"]
def c(m):
    r={d:{} for d in DV}
    for d in DV:
        for s in SY:
            x=win[d].values; y=win[s].values
            if np.std(y)==0 or np.std(x)==0: r[d][s]=None
            elif m=="pearson": r[d][s]=float(np.corrcoef(x,y)[0,1])
            else: r[d][s]=float(pd.Series(x).rank().corr(pd.Series(y).rank(),method="pearson"))
    return r
print(win[["BCE"]+DV+SY+["Zcs"]].to_string(index=False))
print("Pearson:\n", pd.DataFrame(c("pearson")))
print("Spearman:\n", pd.DataFrame(c("spearman")))
for a,b in [(3400,3200),(3200,3000)]:
    A=win.loc[win["BCE"]==a].iloc[0]; B=win.loc[win["BCE"]==b].iloc[0]
    print(f"Slopes {a}->{b} (per century):")
    for v in DV+["HouseSize","Zcs"]:
        print(f"  {v}: {(B[v]-A[v])/2:+.4f}")
