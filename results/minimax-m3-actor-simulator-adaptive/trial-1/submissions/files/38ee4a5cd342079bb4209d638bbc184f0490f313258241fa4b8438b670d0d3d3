"""
NLSY79 BA-completion analysis: effect of academic characteristics on SES and race gaps.
Headline outcome = dorm_sustained_81_84 (proxy for BA completion; >=2 of 4 waves 1981-84 with residence=3).

Per binding refinements:
  - SES split: parents_edu (mother+father, avg with single-parent indicator),
                log(Total net family income 1979 + 1).
    Log(Family net wealth 1985 + 1) participates ONLY in robustness.
  - Academic block: ASVAB composite (mean of 4 z-scores, mean-imputed for missing)
                    + class_rank_pct = rank/size where rank<=size.
  - Race 3-level factor, NBNH reference.
  - Models A (race+SES), B (A + academic), C (B + race x ASVAB and SES x ASVAB).
  - Listwise AND MICE (m=20, PMM continuous, logistic categorical).
  - Incarceration auxiliaries only in the imputation model.
"""
import json, numpy as np, pandas as pd, statsmodels.api as sm
from scipy import stats as sstats

RNG = np.random.default_rng(20240101)
pd.set_option('display.width', 200)
pd.set_option('display.max_columns', 60)

# Load and prep
df = pd.read_csv('data/nls_raw.csv')

DORM_WAVES_84 = ['Type of residence respondent is living in, 1981',
                 'Type of residence respondent is living in, 1982',
                 'Type of residence respondent is living in, 1983',
                 'Type of residence respondent is living in, 1984']
DORM_WAVES_86 = DORM_WAVES_84 + ['Type of residence respondent is living in, 1985',
                                  'Type of residence respondent is living in, 1986']
RES_COLS_ALL  = [c for c in df.columns if c.startswith('Type of residence respondent')]

def is_dorm(v):
    try: return np.isclose(float(v), 3.0)
    except Exception: return False
def is_jail(v):
    try: return np.isclose(float(v), 5.0)
    except Exception: return False

df['dorm_count_84'] = sum(df[w].apply(is_dorm).astype(int) for w in DORM_WAVES_84)
df['dorm_obs_84']   = sum(df[w].notna().astype(int)       for w in DORM_WAVES_84)
df['dorm_sustained_81_84'] = np.where(df['dorm_obs_84']>=2,
                                      (df['dorm_count_84']>=2).astype(int), np.nan)

df['dorm_count_86'] = sum(df[w].apply(is_dorm).astype(int) for w in DORM_WAVES_86)
df['dorm_obs_86']   = sum(df[w].notna().astype(int)       for w in DORM_WAVES_86)
df['dorm_ever_81_86'] = np.where(df['dorm_obs_86']>=2,
                                 (df['dorm_count_86']>=1).astype(int), np.nan)

# Demographics
df['age_79'] = pd.to_numeric(df['Age of respondent, 1979'], errors='coerce')
df['race']   = pd.to_numeric(df['Racial/ethnic cohort, 1979'], errors='coerce')
df['is_black']    = (df['race'] == 1).astype(int)
df['is_hispanic'] = (df['race'] == 2).astype(int)
df['is_female']   = (pd.to_numeric(df['Sex of respondent, 1979'], errors='coerce') == 2).astype(int)

# Parents education
m = pd.to_numeric(df["Highest grade completed by respondent's mother, 1979"], errors='coerce')
f = pd.to_numeric(df["Highest grade completed by respondent's father, 1979"], errors='coerce')
df['parents_edu'] = pd.concat([m, f], axis=1).mean(axis=1, skipna=True)
df['single_parent_missing'] = ((m.isna()) | (f.isna())).astype(int)
df.loc[m.isna() & f.isna(), 'parents_edu'] = np.nan

df['log_income_79'] = np.log1p(pd.to_numeric(
    df["Total net family income, previous calendar year, 1979"], errors='coerce'))
df['log_wealth_85'] = np.log1p(pd.to_numeric(df["Family net wealth, 1985"], errors='coerce'))

# ASVAB composite (per-person mean of z-scores, grand-mean fallback for fully-missing)
ASVAB = ["ASVAB - Arithmetic Reasoning Z Score (rounded), 1981",
         "ASVAB - Word Knowledge Z Score (rounded), 1981",
         "ASVAB - Paragraph Comprehension Z Score (rounded), 1981",
         "ASVAB - Mathematics Knowledge Z Score (rounded), 1981"]
asv = df[ASVAB].apply(pd.to_numeric, errors='coerce')
asv_z = (asv - asv.mean()) / asv.std()
df['asvab_composite'] = asv_z.mean(axis=1, skipna=True)
df.loc[df['asvab_composite'].isna(), 'asvab_composite'] = float(asv_z.stack().mean())
df['asvab_fully_missing'] = asv_z.isna().all(axis=1).astype(int)

# Class rank conditional on class size
rk = pd.to_numeric(df['Rank in class last year attended at this school, 1981'], errors='coerce')
sz = pd.to_numeric(df['Number of students in class last year attended at this school, 1981'], errors='coerce')
cond_rank = (rk.notna()) & (sz.notna()) & (rk > 0) & (sz > 0) & (rk <= sz)
df['class_rank_pct'] = np.where(cond_rank, (rk/sz), np.nan)

# Incarceration auxiliaries
df['ever_sentenced_pre1980'] = pd.to_numeric(
    df['Ever been sentenced in any correctional institution before 1980'], errors='coerce')
df['ever_jailed_through_1996'] = (sum(df[c].apply(is_jail).astype(int) for c in RES_COLS_ALL) > 0).astype(int)

print('='*78); print('DIAGNOSTICS'); print('='*78)
print('Total rows:', len(df))
print('N observed outcome:', int(df['dorm_sustained_81_84'].notna().sum()),
      ' prevalence=', round(float(df['dorm_sustained_81_84'].mean()),4))


diag = (df.dropna(subset=['dorm_sustained_81_84'])
          .groupby('race')
          .agg(N_obs=('dorm_sustained_81_84','count'),
               N_yes=('dorm_sustained_81_84','sum'),
               prev=('dorm_sustained_81_84','mean')))
asv_diag = df.groupby('race')['asvab_composite'].agg(['mean','std','count'])
print('\nOutcome prevalence by race:')
print(diag)
print('\nASVAB composite by race (post-imputation mean):')
print(asv_diag)

# Listwise analytic sample
LISTWISE_NEED = ['dorm_sustained_81_84', 'race', 'is_female', 'age_79',
                 'parents_edu', 'single_parent_missing', 'log_income_79',
                 'asvab_composite', 'class_rank_pct']
df_lw = df.dropna(subset=LISTWISE_NEED).copy()
print('\nListwise-analytic N:', len(df_lw))

def fit_glm(d, y, xcols):
    yv = pd.to_numeric(d[y]).values
    X = sm.add_constant(d[xcols].astype(float).values, has_constant='add')
    return sm.GLM(yv, X, family=sm.families.Binomial()).fit(cov_type='HC1'), ['const']+list(xcols)

X_A = ['is_black','is_hispanic','is_female','age_79',
       'parents_edu','single_parent_missing','log_income_79']
X_B = X_A + ['asvab_composite','class_rank_pct']

for d_ in (df_lw,):
    d_['black_x_asvab']       = d_['is_black']    * d_['asvab_composite']
    d_['hispanic_x_asvab']    = d_['is_hispanic'] * d_['asvab_composite']
    d_['parents_edu_x_asvab'] = d_['parents_edu'] * d_['asvab_composite']
    d_['income79_x_asvab']    = d_['log_income_79'] * d_['asvab_composite']
X_C = X_B + ['black_x_asvab','hispanic_x_asvab','parents_edu_x_asvab','income79_x_asvab']

# Headline listwise fits
res_A, cols_A = fit_glm(df_lw, 'dorm_sustained_81_84', X_A)
res_B, cols_B = fit_glm(df_lw, 'dorm_sustained_81_84', X_B)
res_C, cols_C = fit_glm(df_lw, 'dorm_sustained_81_84', X_C)

def coef_df(res, cols, name):
    z = res.params / res.bse
    return pd.DataFrame({'term': cols, 'coef': res.params, 'se': res.bse,
                         'z': z, 'p': 2*sstats.norm.sf(np.abs(z)), 'model': name})

tabA = coef_df(res_A, cols_A, 'A')
tabB = coef_df(res_B, cols_B, 'B')
tabC = coef_df(res_C, cols_C, 'C')
print('\n=== Model A (listwise) ==='); print(tabA.round(4).to_string(index=False))
print('\n=== Model B (listwise) ==='); print(tabB.round(4).to_string(index=False))
print('\n=== Model C (listwise) ==='); print(tabC.round(4).to_string(index=False))


# Delta-coefficient A -> B (log-odds scale)
delta_terms = ['is_black','is_hispanic','is_female','age_79',
               'parents_edu','single_parent_missing','log_income_79']
V_A = res_A.cov_params(); V_B = res_B.cov_params()
rows = []
for t in delta_terms:
    i = cols_A.index(t); j = cols_B.index(t)
    diff = float(res_A.params[i] - res_B.params[j])
    var  = float(V_A[i,i] + V_B[j,j])
    z = diff / np.sqrt(var)
    rows.append({'term': t, 'delta_A_minus_B': diff, 'se_delta': np.sqrt(var),
                 'z': z, 'p': 2*sstats.norm.sf(abs(z))})
delta_AB = pd.DataFrame(rows)
print('\n=== Delta coefficients A -> B (listwise, log-odds) ===')
print('Negative delta => coefficient moves toward zero after adding academics.')
print(delta_AB.round(4).to_string(index=False))

# AMEs at ASVAB quartiles by race from Model C
qs = df_lw['asvab_composite'].quantile([0.25,0.5,0.75]).values
means = {c: float(df_lw[c].mean()) for c in X_C
         if c not in ('is_black','is_hispanic','black_x_asvab','hispanic_x_asvab',
                      'parents_edu_x_asvab','income79_x_asvab','asvab_composite')}
races = {'NBNH': (0,0), 'Hispanic': (0,1), 'Black': (1,0)}
cols_full = ['const'] + list(X_C)
idx = {c: cols_full.index(c) for c in cols_full}

def predict_C(race_tup, q_asv):
    x = np.zeros(len(cols_full))
    x[idx['const']] = 1.0
    for c in X_C:
        x[idx[c]] = 0.0
    x[idx['is_female']]        = means['is_female']
    x[idx['age_79']]           = means['age_79']
    x[idx['parents_edu']]      = means['parents_edu']
    x[idx['single_parent_missing']] = means['single_parent_missing']
    x[idx['log_income_79']]    = means['log_income_79']
    x[idx['class_rank_pct']]   = means['class_rank_pct']
    x[idx['is_black']]         = race_tup[0]
    x[idx['is_hispanic']]      = race_tup[1]
    x[idx['asvab_composite']]  = q_asv
    x[idx['black_x_asvab']]       = race_tup[0]*q_asv
    x[idx['hispanic_x_asvab']]    = race_tup[1]*q_asv
    x[idx['parents_edu_x_asvab']] = means['parents_edu']*q_asv
    x[idx['income79_x_asvab']]    = means['log_income_79']*q_asv
    eta = float(x @ res_C.params)
    return float(1.0/(1.0+np.exp(-eta)))

quart_limits = [df_lw['asvab_composite'].quantile(q) for q in (0.25,0.5,0.75)]
rows = []
for rname, rt in races.items():
    for lbl, v in zip(['Q1','Q2','Q3'], quart_limits):
        rows.append({'race': rname, 'asvab_Q': lbl,
                     'asvab_val': round(float(v),3),
                     'pred_prob': predict_C(rt, float(v))})
    rows.append({'race': rname, 'asvab_Q':'mean',
                 'asvab_val': round(float(df_lw['asvab_composite'].mean()),3),
                 'pred_prob': predict_C(rt, float(df_lw['asvab_composite'].mean()))})
ame_C = pd.DataFrame(rows)
print('\n=== Model C AMEs at ASVAB quartiles by race ===')
print(ame_C.round(4).to_string(index=False))


# MICE
VARS_MI = ['parents_edu','log_income_79','class_rank_pct','ever_sentenced_pre1980']

def single_cycle(d, vars_, salt):
    rng = np.random.default_rng(salt)
    d = d.copy()
    order = list(vars_); rng.shuffle(order)
    others_pool = ['is_black','is_hispanic','asvab_composite','is_female','age_79']
    for v in order:
        if d[v].isna().sum() == 0:
            continue
        pred_cols = [x for x in others_pool if d[x].notna().all()]
        if not pred_cols:
            continue
        X_obs = sm.add_constant(d.loc[d[v].notna(), pred_cols].values, has_constant='add')
        X_mis = sm.add_constant(d.loc[d[v].isna(),  pred_cols].values, has_constant='add')
        y_obs = d.loc[d[v].notna(), v].values
        try:
            if v == 'ever_sentenced_pre1980':
                mdl = sm.Logit(y_obs, X_obs).fit(disp=False)
                p = mdl.predict(X_mis)
                y_imp = (rng.uniform(size=len(p)) < p).astype(float)
            else:
                mdl = sm.OLS(y_obs, X_obs).fit()
                yhat_obs = mdl.predict(X_obs)
                yhat_mis = mdl.predict(X_mis)
                k = 5
                y_imp = np.empty(len(yhat_mis))
                for i, p_ in enumerate(yhat_mis):
                    dists = np.abs(yhat_obs - p_)
                    idx = np.argsort(dists)[:k]
                    y_imp[i] = y_obs[rng.integers(0, len(idx))]
        except Exception:
            if v == 'ever_sentenced_pre1980':
                y_imp = np.full(X_mis.shape[0], 0.0)
            else:
                y_imp = np.full(X_mis.shape[0], float(np.nanmean(y_obs)))
        d.loc[d[v].isna(), v] = y_imp
    return d

def mice_impute(d, vars_, m=20, cycles=10):
    out = []
    base = d.copy()
    for rep in range(m):
        d0 = base.copy()
        for v in vars_:
            if v == 'ever_sentenced_pre1980':
                md = float(pd.Series(d0[v].dropna()).mode().iloc[0]) if d0[v].notna().any() else 0.0
                d0[v] = d0[v].fillna(md)
            else:
                d0[v] = d0[v].fillna(float(d0[v].mean()))
        for c in range(cycles):
            d0 = single_cycle(d0, vars_, salt=20000101 + rep*1000 + c)
        out.append(d0)
    return out

MI_BASE = df.dropna(subset=['dorm_sustained_81_84','race','age_79',
                            'is_female','asvab_composite']).copy()
print('\nMICE base N (outcome+demog+ASVAB complete):', len(MI_BASE))
mi_dsets = mice_impute(MI_BASE, VARS_MI, m=20, cycles=10)

def fit_with(d_):
    d_ = d_.copy()
    d_['black_x_asvab']       = d_['is_black']    * d_['asvab_composite']
    d_['hispanic_x_asvab']    = d_['is_hispanic'] * d_['asvab_composite']
    d_['parents_edu_x_asvab'] = d_['parents_edu'] * d_['asvab_composite']
    d_['income79_x_asvab']    = d_['log_income_79'] * d_['asvab_composite']
    a,_ = fit_glm(d_, 'dorm_sustained_81_84', X_A)
    b,_ = fit_glm(d_, 'dorm_sustained_81_84', X_B)
    return a, b

mi_pairs = [fit_with(d_) for d_ in mi_dsets]
mi_A = [t[0] for t in mi_pairs]
mi_B = [t[1] for t in mi_pairs]

def pool_rubin(estimates):
    B = np.mean([e.params for e in estimates], axis=0)
    Ubar = np.mean([e.bse**2 for e in estimates], axis=0)
    W  = np.var([e.params for e in estimates], axis=0, ddof=1)
    T = Ubar + (1.0 + 1.0/len(estimates))*W
    return B, np.sqrt(T)

Bbar_A, SE_A = pool_rubin(mi_A)
Bbar_B, SE_B = pool_rubin(mi_B)

def fmt_pooled(name, cols, Bbar, SE):
    z = Bbar/SE; p = 2*sstats.norm.sf(np.abs(z))
    return pd.DataFrame({'term': cols, 'coef': Bbar, 'se': SE, 'z': z, 'p': p, 'model': name})

miA_tab = fmt_pooled('A_mice', cols_A, Bbar_A, SE_A)
miB_tab = fmt_pooled('B_mice', cols_B, Bbar_B, SE_B)
print('\n=== MICE-pooled Model A ==='); print(miA_tab.round(4).to_string(index=False))
print('\n=== MICE-pooled Model B ==='); print(miB_tab.round(4).to_string(index=False))

# MICE delta: average per-imputation delta, then Rubin
def mice_delta(estimA, estimB, colsA, colsB, terms):
    deltas = []
    for a, b in zip(estimA, estimB):
        rr = {}
        for t in terms:
            i = colsA.index(t); j = colsB.index(t)
            rr[t] = (float(a.params[i] - b.params[j]),
                     float(np.sqrt(a.cov_params()[i,i] + b.cov_params()[j,j])))
        deltas.append(rr)
    df_ = pd.DataFrame(deltas)
    out = []
    for t in terms:
        coefs = df_[t].apply(lambda x: x[0]).values
        ses   = df_[t].apply(lambda x: x[1]).values
        Bbar = coefs.mean()
        Ubar = (ses**2).mean()
        W    = coefs.var(ddof=1)
        T    = Ubar + (1.0 + 1.0/len(coefs)) * W
        z = Bbar/np.sqrt(T)
        out.append({'term': t, 'delta_mice': Bbar,
                    'se_within': float(np.sqrt(Ubar)), 'se_total': float(np.sqrt(T)),
                    'z': z, 'p': 2*sstats.norm.sf(abs(z))})
    return pd.DataFrame(out)

mice_delta_tab = mice_delta(mi_A, mi_B, cols_A, cols_B, delta_terms)
print('\n=== MICE delta A - B (pooled, listwise rows as comparison) ===')
print(mice_delta_tab.round(4).to_string(index=False))


# Companion outcome (enrollment proxy): dorm_ever_81_86
COMP_NEED = ['dorm_ever_81_86','race','is_female','age_79',
