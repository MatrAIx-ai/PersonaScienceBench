def fit_logit(d,y,xcols):
    yv = pd.to_numeric(d[y]).values
    X = sm.add_constant(d[xcols].astype(float).values, has_constant='add')
    return sm.GLM(yv, X, family=sm.families.Binomial()).fit(cov_type='HC1')

cA = fit_logit(df_comp, 'dorm_ever_81_86', X_A)
cB = fit_logit(df_comp, 'dorm_ever_81_86', X_B)
def comp_delta():
    out=[]
    for nm in ['is_black','is_hispanic','log_income_79','parents_edu']:
        i = X_A.index(nm); j = X_B.index(nm)
        d_ = float(cA.params[i] - cB.params[j])
        v_ = float(cA.cov_params()[i,i] + cB.cov_params()[j,j])
        out.append({'term': nm, 'delta': d_, 'se': np.sqrt(v_),
                    'z': d_/np.sqrt(v_), 'p': 2*sstats.norm.sf(abs(d_/np.sqrt(v_)))})
    return pd.DataFrame(out)
comp_delta_tab = comp_delta()
print('\n=== Companion outcome (dorm_ever_81_86) delta A - B (listwise) ===')
print(comp_delta_tab.round(4).to_string(index=False))

# Sensitivity D: B + log_wealth_85 and its interaction with ASVAB
df_lw_w = df_lw.dropna(subset=['log_wealth_85']).copy()
df_lw_w['log_wealth_x_asvab'] = df_lw_w['log_wealth_85']*df_lw_w['asvab_composite']
X_D = X_C + ['log_wealth_85','log_wealth_x_asvab']
