# JSON dump + Excel summary
def coef_map(res):
    out = {}
    for nm, v, se in zip(list(res.model.exog_names), res.params, res.bse):
        out[nm] = {'coef': float(v), 'se': float(se),
                   'z': float(v/se), 'p': float(2*sstats.norm.sf(abs(v/se)))}
    return out

mA = coef_map(res_A); mB = coef_map(res_B); mC = coef_map(res_C); mD = coef_map(res_D)
