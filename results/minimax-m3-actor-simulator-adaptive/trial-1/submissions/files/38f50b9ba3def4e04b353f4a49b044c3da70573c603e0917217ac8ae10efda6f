    "# Forest plot\n",
    "def render_forest(W, H, rows, out_path, title='Forest of ORs (Firth 95% CI)'):\n",
    "    img = Image.new('RGB', (W, H), 'white')\n",
    "    d = ImageDraw.Draw(img)\n",
    "    margin_l, margin_r, margin_t, margin_b = 280, 220, 70, 80\n",
    "    pw, ph = W - margin_l - margin_r, H - margin_t - margin_b\n",
    "    d.text((W/2 - len(title)*5, 20), title, fill='black', font=FONT_TITLE)\n",
    "    all_or = []\n",
    "    for r_ in rows: all_or += [r_['OR_lo'], r_['OR_hi']]\n",
    "    all_or = np.array(all_or)\n",
    "    xmin = float(np.floor(np.log10(np.clip(all_or, 0.01, None)).min()))\n",
    "    xmax = float(np.ceil(np.log10(all_or).max()))\n",
    "    if xmin == xmax: xmax += 1\n",
    "    def to_px(orv):\n",
    "        return margin_l + (np.log10(orv) - xmin) / (xmax - xmin) * pw\n",
    "    for i in range(int(xmin), int(xmax)+1):\n",
    "        v = 10**i\n",
    "        px = to_px(v)\n",
    "        d.line([(px, margin_t), (px, margin_t + ph)], fill=(220,220,220), width=1)\n",
    "        d.text((px - 10, margin_t + ph + 8), f'10^{i}', fill='black', font=FONT_SMALL)\n",
    "    px1 = to_px(1.0)\n",
    "    d.line([(px1, margin_t), (px1, margin_t + ph)], fill='black', width=2)\n",
    "    n = len(rows); row_h = ph / max(n, 1)\n",
    "    for i, r_ in enumerate(rows):\n",
    "        y0 = margin_t + i*row_h; ymid = y0 + row_h/2\n",
    "        d.text((20, ymid - 8), r_['variable'], fill='black', font=FONT_MED)\n",
    "        cl = to_px(r_['OR_lo']); cc = to_px(r_['OR']); ch = to_px(r_['OR_hi'])\n",
    "        col = '#d62728' if (r_['OR_lo'] > 1 or r_['OR_hi'] < 1) else '#1f77b4'\n",
    "        d.line([(cl, ymid), (ch, ymid)], fill=col, width=3)\n",
    "        d.ellipse([cc-6, ymid-6, cc+6, ymid+6], fill=col, outline='black')\n",
    "        txt = f\"OR={r_['OR']:.3f}  [{r_['OR_lo']:.3f}, {r_['OR_hi']:.3f}]\"\n",
    "        d.text((W - margin_r + 5, ymid - 8), txt, fill='black', font=FONT_SMALL)\n",
    "    d.text((W/2 - 80, H - 30), 'Odds Ratio (log10 scale)', fill='black', font=FONT_MED)\n",
    "    img.save(out_path)\n",
