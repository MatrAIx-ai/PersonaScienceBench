    "    max_c = max(counts[r].max() for r in race_grid)\n",
    "    def to_px(xv, yv):\n",
    "        px = margin_l + (xv - lo_b) / (hi_b - lo_b) * pw\n",
    "        py = margin_t + (1 - yv / max_c) * ph\n",
    "        return px, py\n",
    "    for v in np.linspace(lo_b, hi_b, 7):\n",
    "        px, _ = to_px(v, 0)\n",
    "        d.line([(px, margin_t), (px, margin_t + ph)], fill=(230,230,230), width=1)\n",
    "    for v in np.linspace(lo_b, hi_b, 7):\n",
    "        px, py = to_px(v, 0)\n",
    "        d.line([(px, margin_t + ph), (px, margin_t + ph + 5)], fill='black', width=1)\n",
    "        d.text((px - 18, margin_t + ph + 8), f'{v:+.2f}', fill='black', font=FONT_SMALL)\n",
    "    for v in np.linspace(0, max_c, 6):\n",
    "        _, py = to_px(0, v)\n",
    "        d.line([(margin_l - 5, py), (margin_l, py)], fill='black', width=1)\n",
    "        d.text((margin_l - 60, py - 7), f'{int(v)}', fill='black', font=FONT_SMALL)\n",
