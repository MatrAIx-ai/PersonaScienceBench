    "\n",
    "def render_chart(W, H, title, xlabel, ylabel, series, out_path,\n",
    "                 xlim=None, ylim=(0,None), colors=None, legend=True,\n",
    "                 yticks=None, xticks=None, grid=True):\n",
    "    img = Image.new('RGB', (W, H), 'white')\n",
    "    d = ImageDraw.Draw(img)\n",
    "    margin_l, margin_r, margin_t, margin_b = 90, 30, 70, 80\n",
    "    pw, ph = W - margin_l - margin_r, H - margin_t - margin_b\n",
    "    all_x = np.concatenate([np.atleast_1d(series[k][0]) for k in series])\n",
    "    all_y = np.concatenate([np.atleast_1d(series[k][1]) for k in series])\n",
    "    if xlim is None:\n",
    "        xmin, xmax = float(all_x.min()), float(all_x.max())\n",
    "    else:\n",
    "        xmin, xmax = xlim\n",
    "    if ylim[0] is None:\n",
    "        ymin = float(all_y.min())\n",
    "    else:\n",
    "        ymin = ylim[0]\n",
    "    if ylim[1] is None:\n",
    "        ymax = float(all_y.max())\n",
    "    else:\n",
    "        ymax = ylim[1]\n",
    "    if ymin == ymax: ymax += 0.01\n",
    "    if xmin == xmax: xmax += 0.01\n",
    "\n",
    "    def to_px(xv, yv):\n",
    "        px = margin_l + (xv - xmin) / (xmax - xmin) * pw\n",
    "        py = margin_t + (1 - (yv - ymin) / (ymax - ymin)) * ph\n",
    "        return px, py\n",
    "\n",
    "    if grid:\n",
    "        for v in np.linspace(ymin, ymax, 6):\n",
    "            px, py = to_px(xmin, v)\n",
    "            d.line([(margin_l, py), (W - margin_r, py)], fill=(220,220,220), width=1)\n",
    "    if xticks is None:\n",
    "        xticks = np.linspace(xmin, xmax, 6)\n",
    "    for xv in xticks:\n",
    "        px, py = to_px(xv, ymin)\n",
    "        d.line([(px, margin_t + ph), (px, margin_t + ph + 5)], fill='black', width=1)\n",
    "        d.text((px - 18, margin_t + ph + 8), f'{xv:+.2f}', fill='black', font=FONT_SMALL)\n",
    "    if yticks is None:\n",
    "        yticks = np.linspace(ymin, ymax, 6)\n",
    "    for yv in yticks:\n",
    "        px, py = to_px(xmin, yv)\n",
    "        d.line([(margin_l - 5, py), (margin_l, py)], fill='black', width=1)\n",
    "        if ymax <= 0.30:\n",
    "            d.text((margin_l - 60, py - 7), f'{yv*100:.2f}%', fill='black', font=FONT_SMALL)\n",
    "        else:\n",
    "            d.text((margin_l - 60, py - 7), f'{yv:.3f}', fill='black', font=FONT_SMALL)\n",
    "    d.line([(margin_l, margin_t), (margin_l, margin_t + ph)], fill='black', width=2)\n",
    "    d.line([(margin_l, margin_t + ph), (margin_l + pw, margin_t + ph)], fill='black', width=2)\n",
    "\n",
    "    color_map = {'White':'#1f77b4','Black':'#d62728','Hispanic':'#2ca02c'}\n",
    "    if colors: color_map.update(colors)\n",
    "    for r, (xs, ys) in series.items():\n",
    "        col = color_map.get(r, 'black')\n",
    "        pts = [to_px(x, y) for x, y in zip(xs, ys)]\n",
    "        d.line(pts, fill=col, width=3)\n",
    "    d.text((W/2 - len(title)*5, 20), title, fill='black', font=FONT_TITLE)\n",
    "    d.text((W/2 - len(xlabel)*4, H - 25), xlabel, fill='black', font=FONT_MED)\n",
    "    if legend:\n",
    "        lx = margin_l + 20; ly = margin_t + 15\n",
    "        for k in series:\n",
    "            col = color_map.get(k, 'black')\n",
    "            d.line([(lx, ly+10), (lx+30, ly+10)], fill=col, width=3)\n",
    "            d.text((lx + 40, ly + 1), k, fill='black', font=FONT_MED)\n",
    "            ly += 25\n",
    "    img.save(out_path)\n",
    "\n",
    "# Predprob plot - max-aware ylim\n",
    "series_predprob = {r: (ses_grid, curve[r]) for r in race_grid}\n",
