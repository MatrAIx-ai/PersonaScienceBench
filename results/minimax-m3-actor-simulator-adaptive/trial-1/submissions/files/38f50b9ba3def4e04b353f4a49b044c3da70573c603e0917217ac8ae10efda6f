   "execution_count": null,
   "outputs": [],
   "source": [
    "\"\"\"\n",
    "Main analysis script for DiscoveryBench NLS-SES episode.\n",
    "\n",
    "Question: Is the relation between socioeconomic status and chances of degree\n",
    "completion affected by racial lines of the individual?\n",
    "\n",
    "Method (approved plan):\n",
    "  (a) Firth penalized logit of BA DEGREE COMPLETED on SES, Race (3 lvls),\n",
    "      interaction SES x Race, +ASVAB z, PERCENTILE z, sex, family size.\n",
    "  (b) Stratified-by-race logit as secondary (route b).\n",
    "  (c) Curves + AUC + forest plot (route c).\n",
    "\n",
    "Outputs (saved under /workspace/outputs/):\n",
    "  firth_coefs.csv, metrics.json, figure_predprob.png, figure_forest.png,\n",
    "  figure_common_support.png, bootstraps_OR.npz, bootstraps_AME.npz,\n",
    "  execution_log.txt\n",
    "\"\"\"\n",
    "from __future__ import annotations\n",
    "import json, os, sys, time, warnings\n",
    "from pathlib import Path\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import statsmodels.api as sm\n",
    "from scipy import stats\n",
    "from scipy.special import expit\n",
    "\n",
    "sys.path.insert(0, '/workspace')\n",
    "from firth import fit_firth_logit, lr_test\n",
    "\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "OUT = Path('/workspace/outputs'); OUT.mkdir(parents=True, exist_ok=True)\n",
    "DATA = '/workspace/data/nls_ses_processed.csv'\n",
    "RNG = np.random.default_rng(20251021)\n",
    "B_BOOT = 1000\n",
    "\n",
    "log_lines = []\n",
    "def log(msg):\n",
    "    print(msg); log_lines.append(str(msg))\n",
    "\n",
    "# 1. Load + preprocess\n",
    "log('=== Step 1. Load + preprocess ===')\n",
    "df = pd.read_csv(DATA, index_col=0)\n",
    "log(f'Shape: {df.shape}; columns: {list(df.columns)}')\n",
    "\n",
    "df['BA_DEG_INT'] = df['BA DEGREE COMPLETED'].astype(int)\n",
    "df['FEMALE'] = (df['SAMPLE_SEX'] == 'Female').astype(int)\n",
    "df['RACE_BLACK'] = (df['SAMPLE_RACE'] == 'Black').astype(int)\n",
    "df['RACE_HISP']  = (df['SAMPLE_RACE'] == 'Hispanic').astype(int)\n",
    "df['ASVAB_Z']     = (df['ABILITY: COMPOSITE OF ASVAB SCORE'] - df['ABILITY: COMPOSITE OF ASVAB SCORE'].mean()) / df['ABILITY: COMPOSITE OF ASVAB SCORE'].std()\n",
    "df['PCTILE_Z']    = (df['PERCENTILE IN CLASS'] - df['PERCENTILE IN CLASS'].mean()) / df['PERCENTILE IN CLASS'].std()\n",
    "df['SES_X_BLACK'] = df['SES'] * df['RACE_BLACK']\n",
    "df['SES_X_HISP']  = df['SES'] * df['RACE_HISP']\n",
    "\n",
    "log(f'Events: {df[\"BA_DEG_INT\"].sum()} / {len(df)} = {df[\"BA_DEG_INT\"].mean()*100:.2f}%')\n",
    "log(f'Race counts: {df[\"SAMPLE_RACE\"].value_counts().to_dict()}')\n",
    "log(f'Sex counts: {df[\"SAMPLE_SEX\"].value_counts().to_dict()}')\n",
    "\n",
    "y_col = 'BA_DEG_INT'\n",
    "X_cols = ['SES','RACE_BLACK','RACE_HISP','SES_X_BLACK','SES_X_HISP',\n",
    "          'ASVAB_Z','PCTILE_Z','FEMALE','FAMILY SIZE OF SAMPLE']\n",
    "y = df[y_col].values.astype(float)\n",
    "X = sm.add_constant(df[X_cols].values.astype(float), has_constant='add')\n",
    "col_names = ['const'] + X_cols\n",
    "race_grid = ['White','Black','Hispanic']\n",
    "\n",
    "# 2. Common support\n",
    "log('\\n=== Step 2. Common support ===')\n",
    "for r, sub in df.groupby('SAMPLE_RACE'):\n",
    "    qs = sub['SES'].quantile([0,.05,.25,.5,.75,.95,1])\n",
    "    log(f'  {r}: n={len(sub)}  min={qs[0.00]:.3f}  p05={qs[0.05]:.3f}  p25={qs[0.25]:.3f}  '\n",
    "        f'p50={qs[0.50]:.3f}  p75={qs[0.75]:.3f}  p95={qs[0.95]:.3f}  max={qs[1.00]:.3f}')\n",
    "SUP_LO = max(df.groupby('SAMPLE_RACE')['SES'].quantile(0.05).max(), -np.inf)\n",
    "SUP_HI = min(df.groupby('SAMPLE_RACE')['SES'].quantile(0.95).min(),  np.inf)\n",
    "log(f'Common support region (5%-95%): SES in [{SUP_LO:.3f}, {SUP_HI:.3f}]')\n",
    "\n",
    "# 3. Firth penalized logit - full and reduced models\n",
    "log('\\n=== Step 3. Firth penalized logit ===')\n",
    "t0 = time.time()\n",
    "res_full = fit_firth_logit(X, y)\n",
    "log(f'Full model converged: {res_full[\"converged\"]}  (iters: {res_full[\"n_iter\"]}, pen_ll={res_full[\"pen_loglik\"]:.3f})')\n",
    "log(f'Fit time: {time.time()-t0:.2f}s')\n",
    "\n",
    "keep_idx_red = [0,1,2,3,6,7,8,9]  # const, SES, RACE_BLACK, RACE_HISP, ASVAB_Z, PCTILE_Z, FEMALE, FAMILY SIZE\n",
    "X_red = X[:, keep_idx_red]\n",
    "res_red = fit_firth_logit(X_red, y)\n",
    "log(f'Reduced model converged: {res_red[\"converged\"]}  (iters: {res_red[\"n_iter\"]}, pen_ll={res_red[\"pen_loglik\"]:.3f})')\n",
    "\n",
    "lr_stat, lr_df, lr_p = lr_test(res_full['pen_loglik'], len(res_full['beta']),\n",
    "                               res_red['pen_loglik'], len(res_red['beta']))\n",
    "log(f'LRT for interaction block (df={lr_df}): chi2={lr_stat:.3f}  p={lr_p:.4g}')\n",
    "\n",
    "b_int = res_full['beta'][4:6]\n",
    "S_int = res_full['Hinv'][4:6, 4:6]\n",
    "try:\n",
    "    wald_stat = float(b_int @ np.linalg.inv(S_int) @ b_int)\n",
    "    wald_p = 1.0 - stats.chi2.cdf(wald_stat, 2)\n",
    "except Exception:\n",
    "    wald_stat, wald_p = np.nan, np.nan\n",
    "log(f'Wald joint (df=2): chi2={wald_stat:.3f}  p={wald_p:.4g}')\n",
    "\n",
    "def make_coef_table(res, names):\n",
    "    beta = res['beta']; se = res['se']\n",
    "    ci_lo = beta - 1.96 * se; ci_hi = beta + 1.96 * se\n",
    "    z = beta / np.where(se>0, se, np.nan)\n",
    "    return pd.DataFrame({\n",
    "        'variable': list(names),\n",
    "        'beta': beta, 'se': se,\n",
    "        'ci_lo': ci_lo, 'ci_hi': ci_hi,\n",
    "        'z': z, 'OR': np.exp(beta), 'OR_lo': np.exp(ci_lo), 'OR_hi': np.exp(ci_hi),\n",
    "        'p_2sided': 2*(1-stats.norm.cdf(np.abs(z)))\n",
    "    })\n",
    "\n",
    "coef_full_df = make_coef_table(res_full, col_names)\n",
    "coef_red_df  = make_coef_table(res_red,\n",
    "                                [col_names[i] for i in keep_idx_red])\n",
    "log('\\nFull model coefficients (Firth pen. logit):')\n",
    "log(coef_full_df.round(4).to_string(index=False))\n",
    "coef_full_df.to_csv(OUT / 'firth_coefs.csv', index=False)\n",
    "\n",
    "def compute_vif(X_df):\n",
    "    cols = list(X_df.columns)\n",
    "    Xv = X_df.values.astype(float)\n",
    "    vifs = {}\n",
    "    for j, c in enumerate(cols):\n",
    "        others = [i for i,cc in enumerate(cols) if cc != c]\n",
    "        Xo = sm.add_constant(Xv[:, others])\n",
    "        yj = Xv[:, j]\n",
    "        coef, *_ = np.linalg.lstsq(Xo, yj, rcond=None)\n",
    "        pred = Xo @ coef\n",
    "        ss_res = float(((yj - pred)**2).sum())\n",
    "        ss_tot = float(((yj - yj.mean())**2).sum())\n",
    "        r2 = ss_res/ss_tot if ss_tot>0 else 0.0\n",
    "        vifs[c] = 1.0 / max(1 - r2, 1e-9)\n",
    "    return vifs\n",
    "vif = compute_vif(df[X_cols])\n",
    "log('\\nVIF (per predictor):')\n",
    "for k, v in vif.items():\n",
    "    log(f'  {k:32s}  {v:.3f}')\n",
    "\n",
    "n_events = int(y.sum())\n",
    "n_predictors = len(X_cols) + 1\n",
    "epv_global = n_events / n_predictors\n",
    "log(f'\\nEvents: {n_events}  ; predictors (+int_block + const): {n_predictors}  ; EPV={epv_global:.2f}')\n",
    "\n",
    "log('\\nMean FAMILY SIZE OF SAMPLE by race:')\n",
    "log(df.groupby('SAMPLE_RACE')['FAMILY SIZE OF SAMPLE'].agg(['count','mean','std']).round(3).to_string())\n",
    "\n",
    "# 4. Predicted probabilities + AMEs\n",
    "log('\\n=== Step 4. Predicted probs + AMEs ===')\n",
    "fam_med = float(df['FAMILY SIZE OF SAMPLE'].median())\n",
    "\n",
    "def profile(ses_val, race_label):\n",
    "    out = []\n",
    "    out.append(1.0)  # intercept\n",
    "    out.append(ses_val)\n",
    "    out.append(1.0 if race_label == 'Black' else 0.0)\n",
    "    out.append(1.0 if race_label == 'Hispanic' else 0.0)\n",
    "    out.append(ses_val * (1.0 if race_label == 'Black' else 0.0))\n",
    "    out.append(ses_val * (1.0 if race_label == 'Hispanic' else 0.0))\n",
    "    out.append(0.0)  # ASVAB z = 0\n",
    "    out.append(0.0)  # Pctl z = 0\n",
    "    out.append(0.5)  # avg sex (50/50 average of dummies) -- actually let me set 0 (Female=0); options: avg\n",
    "    out.append(fam_med)\n",
    "    return np.array(out)\n",
    "\n",
    "def P_BA(ses_val, race_label, beta=res_full['beta']):\n",
    "    return expit(profile(ses_val, race_label).reshape(1,-1) @ beta)[0]\n",
    "\n",
    "ses_grid = np.linspace(SUP_LO, SUP_HI, 80)\n",
    "curve = {r: np.array([P_BA(s, r) for s in ses_grid]) for r in race_grid}\n",
    "log('Predicted P(BA=1) at SES=-0.5, 0, +0.5 (fam size median; ASVAB=0, Percentile=0, female-proportion=0.5):')\n",
    "for r in race_grid:\n",
    "    p_low = P_BA(-0.5, r); p_mid = P_BA(0.0, r); p_hi = P_BA(0.5, r)\n",
    "    log(f'  {r:8s}: -0.5 -> {p_low*100:.3f}%   0 -> {p_mid*100:.3f}%   +0.5 -> {p_hi*100:.3f}%')\n",
    "\n",
    "q1 = float(df['SES'].quantile(0.25))\n",
    "q4 = float(df['SES'].quantile(0.75))\n",
    "ame_q4_minus_q1 = {r: float(P_BA(q4, r) - P_BA(q1, r)) for r in race_grid}\n",
    "log(f'\\nDelta(BA predicted prob) for SES going from Q1={q1:.3f} to Q4={q4:.3f}:')\n",
    "for r, v in ame_q4_minus_q1.items():\n",
    "    log(f'  {r:8s}: D = {v*100:+.3f} percentage points')\n",
    "\n",
    "def ame_ses_race(race_label, beta=res_full['beta'], eps=1e-4):\n",
    "    p_plus  = P_BA(0 + eps, race_label, beta)\n",
    "    p_minus = P_BA(0 - eps, race_label, beta)\n",
    "    return float((p_plus - p_minus) / (2*eps))\n",
    "ame_per_sd = {r: ame_ses_race(r) for r in race_grid}\n",
    "log('\\nMarginal effect of +1 SES unit on P(BA), evaluated at SES=0:')\n",
    "for r, v in ame_per_sd.items():\n",
    "    log(f'  {r:8s}: dP/dSES = {v*100:+.3f} pp per +1 unit of SES (sd(SES)={df[\"SES\"].std():.3f})')\n",
    "\n",
    "# 5. AUC\n",
    "log('\\n=== Step 5. AUC by subgroup ===')\n",
    "def auc_mwu(y_true, scores):\n",
    "    y_true = np.asarray(y_true); scores = np.asarray(scores)\n",
    "    pos = scores[y_true == 1]; neg = scores[y_true == 0]\n",
    "    if len(pos) == 0 or len(neg) == 0: return np.nan\n",
    "    from scipy.stats import rankdata\n",
    "    ranks = rankdata(np.concatenate([pos, neg]), method='average')\n",
    "    R_pos = ranks[:len(pos)].sum()\n",
    "    n_pos = len(pos); n_neg = len(neg)\n",
    "    U = R_pos - n_pos*(n_pos+1)/2\n",
    "    return float(U / (n_pos * n_neg))\n",
    "\n",
    "lp = X @ res_full['beta']\n",
    "auc_global = auc_mwu(y, lp)\n",
    "log(f'  AUC (global) = {auc_global:.4f}')\n",
    "auc_by_race = {}\n",
    "for r in race_grid:\n",
    "    mask = (df['SAMPLE_RACE'] == r).values\n",
    "    auc_by_race[r] = auc_mwu(y[mask], lp[mask])\n",
    "    log(f'  AUC | {r:8s} = {auc_by_race[r]:.4f}  (n={int(mask.sum())}, events={int(y[mask].sum())})')\n",
    "\n",
    "# 6. Bootstrap (stratified by race)\n",
    "log('\\n=== Step 6. Bootstrap (B=%d, stratified by race) ===' % B_BOOT)\n",
    "race_arr = df['SAMPLE_RACE'].values\n",
    "t0 = time.time()\n",
    "boot_or = []\n",
    "boot_ame_pp = []\n",
    "n_success = 0\n",
    "idx_by_race = {r: np.where(race_arr == r)[0] for r in race_grid}\n",
    "\n",
    "for b in range(B_BOOT):\n",
    "    idx = []\n",
    "    for r in race_grid:\n",
    "        idx.append(RNG.choice(idx_by_race[r], size=len(idx_by_race[r]), replace=True))\n",
    "    idx = np.concatenate(idx)\n",
    "    Xb = X[idx]; yb = y[idx]\n",
    "    try:\n",
    "        rb = fit_firth_logit(Xb, yb)\n",
    "        if not rb['converged']:\n",
    "            continue\n",
    "        boot_or.append(rb['beta'])\n",
    "        bp = rb['beta']\n",
    "        ames_b = []\n",
    "        for r in race_grid:\n",
    "            p_plus  = expit(profile( 0 + 1e-3, r) @ bp)\n",
    "            p_minus = expit(profile( 0 - 1e-3, r) @ bp)\n",
    "            ames_b.append((p_plus - p_minus) / (2e-3))\n",
    "        boot_ame_pp.append(ames_b)\n",
    "        n_success += 1\n",
    "    except Exception:\n",
    "        continue\n",
    "\n",
    "boot_or = np.array(boot_or)\n",
    "boot_ame_pp = np.array(boot_ame_pp)\n",
    "log(f'Bootstrap finished: {n_success}/{B_BOOT} successful reps in {time.time()-t0:.1f}s')\n",
    "np.savez(OUT / 'bootstraps_OR.npz', boot_or=boot_or, beta_names=np.array(col_names))\n",
    "np.savez(OUT / 'bootstraps_AME.npz', boot_ame_pp=boot_ame_pp, races=np.array(race_grid))\n",
    "\n",
    "def ci95(arr, axis=0):\n",
    "    arr = np.asarray(arr)\n",
    "    if arr.size == 0: return (np.nan, np.nan, np.nan)\n",
    "    med = np.nanmedian(arr, axis=axis)\n",
    "    lo = np.nanpercentile(arr, 2.5, axis=axis)\n",
    "    hi = np.nanpercentile(arr, 97.5, axis=axis)\n",
    "    return med, lo, hi\n",
    "\n",
    "or_med, or_lo, or_hi = ci95(np.exp(boot_or), axis=0)\n",
    "log('\\nBootstrap OR median [95% CI] per parameter:')\n",
    "for nm, m, lo, hi in zip(col_names, or_med, or_lo, or_hi):\n",
    "    log(f'  {nm:32s}  {m:.3f}  [{lo:.3f}, {hi:.3f}]')\n",
    "\n",
    "ame_med_pp, ame_lo_pp, ame_hi_pp = ci95(boot_ame_pp * 100, axis=0)\n",
    "log('\\nBootstrap AME of +1 SES unit at SES=0 (pp) [95% CI]:')\n",
    "for r, m, lo, hi in zip(race_grid, ame_med_pp, ame_lo_pp, ame_hi_pp):\n",
    "    log(f'  {r:8s}  {m:+.3f}  [{lo:+.3f}, {hi:+.3f}]')\n",
    "\n",
    "if boot_ame_pp.shape[0] > 0:\n",
    "    diff_BW = boot_ame_pp[:, race_grid.index('Black')]  - boot_ame_pp[:, race_grid.index('White')]\n",
    "    diff_HW = boot_ame_pp[:, race_grid.index('Hispanic')]- boot_ame_pp[:, race_grid.index('White')]\n",
    "    diff_BH = boot_ame_pp[:, race_grid.index('Black')]  - boot_ame_pp[:, race_grid.index('Hispanic')]\n",
    "    log('\\nPairwise AME differences:')\n",
    "    for lbl, arr in [('Black-White', diff_BW), ('Hispanic-White', diff_HW), ('Black-Hispanic', diff_BH)]:\n",
    "        m = float(np.nanmedian(arr*100)); lo = float(np.nanpercentile(arr*100,2.5)); hi = float(np.nanpercentile(arr*100,97.5))\n",
    "        log(f'  {lbl:18s}  D AME = {m:+.3f} pp  [{lo:+.3f}, {hi:+.3f}]')\n",
    "\n",
    "# 7. Stratified models (route b)\n",
    "log('\\n=== Step 7. Stratified logit models (route b) ===')\n",
    "strat_coefs = {}\n",
    "strat_ame_q4_q1 = {}\n",
    "for r in race_grid:\n",
    "    sub = df[df['SAMPLE_RACE'] == r]\n",
    "    sub_X = sm.add_constant(sub[['SES','ASVAB_Z','PCTILE_Z','FEMALE','FAMILY SIZE OF SAMPLE']].values.astype(float))\n",
    "    sub_y = sub['BA_DEG_INT'].values.astype(float)\n",
    "    try:\n",
    "        rr = sm.Logit(sub_y, sub_X).fit(disp=False, method='newton', maxiter=200, warn_convergence=False)\n",
    "        sess = rr.params[1]; se_sess = rr.bse[1]\n",
    "        b_sess = float(np.exp(sess)); b_lo = float(np.exp(sess-1.96*se_sess)); b_hi = float(np.exp(sess+1.96*se_sess))\n",
    "        ses_q1 = float(sub['SES'].quantile(0.25)); ses_q4 = float(sub['SES'].quantile(0.75))\n",
    "        meds = sub[['ASVAB_Z','PCTILE_Z','FEMALE','FAMILY SIZE OF SAMPLE']].median().values\n",
    "        def linp(ses):\n",
    "            return float(rr.params[0] + rr.params[1]*ses + np.dot(meds, rr.params[2:]))\n",
    "        ame_pp = float((expit(linp(ses_q4)) - expit(linp(ses_q1))) * 100)\n",
    "        log(f'  {r:8s}: beta_SES={sess:.3f}  (SE={se_sess:.3f})  OR={b_sess:.3f} '\n",
    "            f'[{b_lo:.3f},{b_hi:.3f}]   AME D(Q4-Q1)={ame_pp:+.3f} pp   events={sub_y.sum()}/{len(sub_y)}')\n",
    "        strat_coefs[r] = {'beta_SES': sess, 'se_SES': se_sess,\n",
    "                          'OR': b_sess, 'OR_lo': b_lo, 'OR_hi': b_hi,\n",
    "                          'n': int(len(sub_y)), 'events': int(sub_y.sum())}\n",
    "        strat_ame_q4_q1[r] = ame_pp\n",
    "    except Exception as e:\n",
    "        log(f'  {r} failed: {e}')\n",
    "\n",
    "# 8. Plots with PIL\n",
    "log('\\n=== Step 8. Plots (PIL) ===')\n",
    "sys.path.insert(0, '/usr/lib/python3/dist-packages')\n",
    "from PIL import Image, ImageDraw, ImageFont\n",
    "\n",
    "def find_font(size=14):\n",
    "    paths = [\n",
    "        '/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf',\n",
    "        '/usr/share/fonts/truetype/liberation/LiberationSans-Bold.ttf',\n",
    "        '/usr/share/fonts/truetype/freefont/FreeSansBold.ttf',\n",
    "        '/usr/share/fonts/truetype/ubuntu/Ubuntu-Bold.ttf',\n",
    "    ]\n",
    "    for p in paths:\n",
    "        if os.path.exists(p):\n",
    "            return ImageFont.truetype(p, size)\n",
    "    # fall back to default which is small bitmap\n",
    "    return ImageFont.load_default()\n",
    "\n",
    "FONT_BIG   = find_font(18)\n",
    "FONT_MED   = find_font(14)\n",
    "FONT_SMALL = find_font(11)\n",
