{
  "preprocessing": {
    "method": "log1p(CPM) + z-score (per gene)",
    "why": "CPM (x1e4) iguala profundidad por celula; log1p estabiliza la varianza; z-score evita que PCA/KNN esten dominados por genes con recuentos altos."
  },
  "dim_reduction": {
    "method": "PCA via numpy.linalg.svd; top-30 PCs",
    "why": "SVD completo en NumPy puro. El piloto SVD mostro PC1~19% y un plateau ~1.3% en el resto, por lo que un umbral de varianza es inestable; un tope fijo de 30 PCs preserva ~85% de varianza y controla el coste del KNN."
  },
  "graph": {
    "method": "k-NN simetrico por union (k=15, coseno, kernel Gaussiano sigma=mediana)",
    "why": "cKDTree con metrica coseno sobre PCs; union (no interseccion) para garantizar conectividad; kernel exp(-d^2/sigma^2) con sigma = mediana de distancias positivas para que los pesos sean comparables sin reescalado manual."
  },
  "clustering": {
    "method": "Spectral clustering (n_clusters=4) + k-means++ sembrado RandomState(0)",
    "why": "Determinista y robusto a inicializacion aleatoria; Laplaciano normalizado simetrico sobre la afinidad Gaussiana; k-means posterior sobre el embedding (Ng-Jordan-Weiss) con seed fija asegura resultados reproducibles."
  },
  "pseudotime": {
    "method": "DPT por potencia del caminante aleatorio (t=5) desde celula de mayor grado del cluster mas denso",
    "why": "Distancia de Haghverdi estable sin libs externas (P_t via matmul repetida). Raiz = cluster mas denso + mayor grado KNN evita raices fragiles en periferia. Empates: menor distancia media KNN, luego menor indice de celula."
  },
  "de_genes": {
    "method": "Mann-Whitney U one-vs-rest por cluster -> AUROC; agregacion global por rango medio",
    "why": "Test no parametrico robusto en datos dispersos de scRNA-seq; el rango medio evita que un solo cluster monopole el ranking. Desempates: max AUROC desc, max|log2FC| desc, indice de gen ascendente."
  },
  "grn_scores": {
    "method": "Lasso L1 por coordenada descendente sobre TFs log-normalizados estandarizados, uno por TF target j",
    "why": "Convencion i->j sale directamente del coeficiente del predictor i en la regresion del target j; L1 induce dispersion util para GRNs pequenas. lambda fija (alpha=0.10 * max|cross-corr|) hace los resultados totalmente deterministas."
  }
}