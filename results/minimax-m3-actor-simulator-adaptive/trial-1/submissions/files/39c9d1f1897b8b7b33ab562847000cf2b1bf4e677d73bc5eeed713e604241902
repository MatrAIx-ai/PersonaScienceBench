#!/usr/bin/env python3
"""
analysis.py
~~~~~~~~~~~
Marcus outer-sphere electron-transfer response calculation for two
quadratic-state minima (frame A = reactant, frame B = product).

Inputs (under  data/):
    site_table.csv               : site_id, mass_amu, label_code
    frame_site_order.csv         : row permutation per frame -> ascending site_id
    frame_a_coords.npy           : (7,3) raw coords of frame A (angstrom)
    frame_b_coords.npy           : (7,3) raw coords of frame B (angstrom)
    frame_a_hessian.npy          : (21,21) state-A Hessian (eV/A^2)
    frame_b_hessian.npy          : (21,21) state-B Hessian (eV/A^2)
    system_manifest.json         : units, ranks, scale factors
    medium_response.json         : dielectric shells, coupling, T
    driving_force_grid.csv       : grid_id + axis_eV to scan

Outputs (under  results/):
    aligned_displacement_mw.npy  : (2,21)
    vibrational_basis_mw.npy     : (2,21,15)
    mode_overlap.npy             : (2,15,15)
    projected_displacement_mw.npy: (2,21)
    transported_mode_projection.npy: (2,15,2)
    mode_projection.npy          : (2,15,3)
    lambda_summary.csv           : 8 columns incl. k_self_exchange
    rate_curve.csv               : per-grid-point rate + log10
    diagnostics.json             : all scalar cross-checks
    overview.png                 : two-panel summary figure

Convention (locked with the user):
    forward direction (row 0)  : frame B aligned into frame A's frame
                                  d_mw = sqrt(m) o (X_Baligned - X_A)
    backward direction (row 1) : frame A aligned into frame B's frame
                                  d_mw = sqrt(m) o (X_Aaligned - X_B)
"""
from __future__ import annotations
import csv, json, os
from typing import Dict, List, Tuple
import numpy as np
from _minipng import (
    MicroChart, draw_box, draw_filled_rect, draw_text,
    draw_pixel, draw_line, draw_dashed_line, text_width,
)

DATA_DIR = "data"
RESULTS_DIR = "results"
AMU_TO_KG = 1.66053906660e-27
EV_PER_ANG_HARTEE = 14.3996
MARCUS_PRE_FACTOR_2SPH = EV_PER_ANG_HARTEE / 2.0
K_B_EV_PER_K = 8.617333262e-5
HBAR_EV_S = 6.582119569e-16

# --------------------------------------------------------------- utilities
def load_manifest() -> Dict:
    with open(os.path.join(DATA_DIR, "system_manifest.json"), "r") as f:
        return json.load(f)

def load_medium() -> Dict:
    with open(os.path.join(DATA_DIR, "medium_response.json"), "r") as f:
        return json.load(f)

def load_site_table():
    rows = []
    with open(os.path.join(DATA_DIR, "site_table.csv"), "r") as f:
        rdr = csv.reader(f); next(rdr)
        for row in rdr: rows.append((int(row[0]), float(row[1]), row[2]))
    rows.sort(key=lambda x: x[0])
    masses = np.array([r[1] for r in rows], dtype=float)
    labels = [r[2] for r in rows]
    return masses, labels

def load_frame_site_order():
    rows = []
    with open(os.path.join(DATA_DIR, "frame_site_order.csv"), "r") as f:
        rdr = csv.reader(f); next(rdr)
        for row in rdr:
            rows.append((row[0], int(row[1]), int(row[2]), row[3]))
    perm = {"frame_a": None, "frame_b": None}
    for fr in ("frame_a", "frame_b"):
        fr_rows = sorted([r for r in rows if r[0] == fr], key=lambda r: r[2])
        perm[fr] = np.array([r[1] for r in fr_rows], dtype=int)
    return perm

def reorder_rows(arr_2d, perm):
    return arr_2d[perm]

def reorder_hessian(H, perm):
    idx = np.empty(21, dtype=int)
    for i, p in enumerate(perm):
        idx[3*i+0] = 3*p+0; idx[3*i+1] = 3*p+1; idx[3*i+2] = 3*p+2
    return H[idx][:, idx]

def kabsch(src, tgt):
    cs = src.mean(axis=0); ct = tgt.mean(axis=0)
    s0 = src - cs; t0 = tgt - ct
    H = s0.T @ t0
    U, S, Vt = np.linalg.svd(H)
    d = np.sign(np.linalg.det(Vt.T @ U.T))
    D = np.diag([1.0, 1.0, d])
    R = Vt.T @ D @ U.T
    t = ct - R @ cs
    return R, t

def mass_weighting(masses_amu):
    m_per_dof_amu = np.repeat(masses_amu, 3)
    m_per_dof = m_per_dof_amu * AMU_TO_KG
    mw_p12 = np.sqrt(m_per_dof)
    mw_n12 = 1.0 / mw_p12
    return m_per_dof, m_per_dof_amu, mw_p12, mw_n12

# ---------------------------------------------------------------- main work
def main():
    os.makedirs(RESULTS_DIR, exist_ok=True)
    manifest = load_manifest(); medium = load_medium()
    null_rank = int(manifest["null_rank"])
    resolved_rank = int(manifest["resolved_rank"])
    assert null_rank == 6 and resolved_rank == 15

    masses_amu, labels = load_site_table()
    assert masses_amu.shape == (7,)

    perm_map = load_frame_site_order()
    perm_a = perm_map["frame_a"]; perm_b = perm_map["frame_b"]
    assert sorted(perm_a.tolist()) == list(range(7))
    assert sorted(perm_b.tolist()) == list(range(7))

    # --- load raw arrays
    coords_a_raw = np.load(os.path.join(DATA_DIR, "frame_a_coords.npy"))
    coords_b_raw = np.load(os.path.join(DATA_DIR, "frame_b_coords.npy"))
    Hess_a_raw = np.load(os.path.join(DATA_DIR, "frame_a_hessian.npy"))
    Hess_b_raw = np.load(os.path.join(DATA_DIR, "frame_b_hessian.npy"))
    assert coords_a_raw.shape == (7,3) and coords_b_raw.shape == (7,3)
    assert Hess_a_raw.shape == (21,21) and Hess_b_raw.shape == (21,21)
    assert np.allclose(Hess_a_raw, Hess_a_raw.T)
    assert np.allclose(Hess_b_raw, Hess_b_raw.T)

    # --- reorder to ascending site_id
    Xa = reorder_rows(coords_a_raw, perm_a)
    Xb = reorder_rows(coords_b_raw, perm_b)
    Ha = reorder_hessian(Hess_a_raw, perm_a)
    Hb = reorder_hessian(Hess_b_raw, perm_b)
    xa = Xa.flatten(); xb = Xb.flatten()

    # Use amu (NOT kg) for the mass-weighting operator so the mass-weighted
    # Hessian eigenvalues come out in numerically clean eV/(amu A^2).
    # Eigenvectors and projection are unchanged up to a uniform sqrt(amu_kg)
    # rescaling -- the energy identity  0.5 * d_mw^T K_mw d_mw = 0.5 * dx^T K dx
    # still holds regardless.
    m_per_dof_amu_vec = np.repeat(masses_amu, 3)          # (21,)  in amu
    mw_p12 = np.sqrt(m_per_dof_amu_vec)                   # sqrt(amu)
    mw_n12 = 1.0 / mw_p12                                 # 1/sqrt(amu)
    mw_p12_kg = mw_p12 * np.sqrt(AMU_TO_KG)               # unused, kept for orthogonality
    m_per_dof = m_per_dof_amu_vec * AMU_TO_KG             # kept for any debug

    # --- frame alignment
    R_fwd, t_fwd = kabsch(Xb, Xa)
    R_bwd, t_bwd = kabsch(Xa, Xb)
    Xb_in_A = (R_fwd @ Xb.T).T + t_fwd
    Xa_in_B = (R_bwd @ Xa.T).T + t_bwd
    dx_fwd = (Xb_in_A - Xa).flatten()
    dx_bwd = (Xa_in_B - Xb).flatten()
    d_mw_fwd = mw_p12 * dx_fwd
    d_mw_bwd = mw_p12 * dx_bwd

    rmsd_fwd = float(np.sqrt(np.mean((Xb_in_A - Xa) ** 2)))
    rmsd_bwd = float(np.sqrt(np.mean((Xa_in_B - Xb) ** 2)))

    aligned_displacement_mw = np.stack([d_mw_fwd, d_mw_bwd], axis=0)
    np.save(os.path.join(RESULTS_DIR, "aligned_displacement_mw.npy"),
            aligned_displacement_mw)

    # --- mass-weighted Hessians and retained modes
    D_n12 = mw_n12
    KwA = (D_n12[:, None] * Ha) * D_n12[None, :]
    KwB = (D_n12[:, None] * Hb) * D_n12[None, :]

    omega2_A, L_A = np.linalg.eigh(KwA)
    omega2_B, L_B = np.linalg.eigh(KwB)
    idx_A = np.argsort(omega2_A); idx_B = np.argsort(omega2_B)
    omega2_A = omega2_A[idx_A]; L_A = L_A[:, idx_A]
    omega2_B = omega2_B[idx_B]; L_B = L_B[:, idx_B]

    null_A = omega2_A[:null_rank]; null_B = omega2_B[:null_rank]
    vib_A = omega2_A[null_rank:null_rank + resolved_rank]
    vib_B = omega2_B[null_rank:null_rank + resolved_rank]
    assert np.all(np.abs(null_A) < 1.0e-8) and np.all(np.abs(null_B) < 1.0e-8)
    assert np.all(vib_A > 0.0) and np.all(vib_B > 0.0)

    basis_A = L_A[:, null_rank:null_rank + resolved_rank]
    basis_B = L_B[:, null_rank:null_rank + resolved_rank]
    vibrational_basis_mw = np.stack([basis_A, basis_B], axis=0)
    np.save(os.path.join(RESULTS_DIR, "vibrational_basis_mw.npy"),
            vibrational_basis_mw)

    # --- rigid-vs-internal decomposition
    null_basis_A = L_A[:, :null_rank]
    null_basis_B = L_B[:, :null_rank]
    proj_rigid_fwd = null_basis_A @ (null_basis_A.T @ d_mw_fwd)
    proj_intrn_fwd = basis_A @ (basis_A.T @ d_mw_fwd)
    rigid_norm_fwd = float(np.linalg.norm(proj_rigid_fwd))
    projected_norm_fwd = float(np.linalg.norm(proj_intrn_fwd))
    proj_rigid_bwd = null_basis_B @ (null_basis_B.T @ d_mw_bwd)
    proj_intrn_bwd = basis_B @ (basis_B.T @ d_mw_bwd)
    rigid_norm_bwd = float(np.linalg.norm(proj_rigid_bwd))
    projected_norm_bwd = float(np.linalg.norm(proj_intrn_bwd))

    # --- modal projection
    qA = basis_A.T @ d_mw_fwd
    qB = basis_B.T @ d_mw_bwd
    proj_disp_mw_fwd = basis_A @ qA
    proj_disp_mw_bwd = basis_B @ qB
    projected_displacement_mw = np.stack(
        [proj_disp_mw_fwd, proj_disp_mw_bwd], axis=0)
    np.save(os.path.join(RESULTS_DIR, "projected_displacement_mw.npy"),
            projected_displacement_mw)

    # mode_projection[d, mu, 0] = omega^2_source
    # mode_projection[d, mu, 1] = q_source^2
    # mode_projection[d, mu, 2] = 0.5 omega^2 q^2 (per-mode lambda)
    mode_proj = np.zeros((2, resolved_rank, 3), dtype=float)
    mode_proj[0, :, 0] = vib_A
    mode_proj[1, :, 0] = vib_B
    mode_proj[0, :, 1] = qA ** 2
    mode_proj[1, :, 1] = qB ** 2
    mode_proj[0, :, 2] = 0.5 * vib_A * qA ** 2
    mode_proj[1, :, 2] = 0.5 * vib_B * qB ** 2
    np.save(os.path.join(RESULTS_DIR, "mode_projection.npy"), mode_proj)

    # --- mode overlap (sign-invariant, symmetric magnitude)
    diag_inprod = np.sum(basis_A * basis_B, axis=0)
    phase_A = np.sign(diag_inprod); phase_A[phase_A == 0.0] = 1.0
    basis_A_pf = basis_A * phase_A[None, :]
    M_fwd = basis_B.T @ basis_A_pf
    overlap_fwd = 0.5 * (np.abs(M_fwd) + np.abs(M_fwd).T)
    overlap_bwd = 0.5 * (np.abs(M_fwd.T) + np.abs(M_fwd).T.T)
    mode_overlap = np.stack([overlap_fwd, overlap_bwd], axis=0)
    np.save(os.path.join(RESULTS_DIR, "mode_overlap.npy"), mode_overlap)

    # --- transported profile (target-frame indexed)
    q_tport_fwd = overlap_fwd @ qA
    q_tport_bwd = overlap_bwd @ qB
    transported = np.zeros((2, resolved_rank, 2), dtype=float)
    transported[0, :, 0] = vib_B
    transported[1, :, 0] = vib_A
    transported[0, :, 1] = q_tport_fwd ** 2
    transported[1, :, 1] = q_tport_bwd ** 2
    np.save(os.path.join(RESULTS_DIR, "transported_mode_projection.npy"),
            transported)

    # --- 4-point inner reorganization
    def harm_pot(K_state, dx_state):
        return 0.5 * float(dx_state @ K_state @ dx_state)
    lam_fwd_A = harm_pot(Ha, dx_fwd); lam_fwd_B = harm_pot(Hb, dx_fwd)
    lam_4_forward = 0.25 * (lam_fwd_A + lam_fwd_B)
    lam_bwd_A = harm_pot(Ha, dx_bwd); lam_bwd_B = harm_pot(Hb, dx_bwd)
    lam_4_backward = 0.25 * (lam_bwd_A + lam_bwd_B)

    # --- normal-mode inner reorganization
    lam_nm_forward = float(np.sum(0.5 * vib_A * qA ** 2))
    lam_nm_backward = float(np.sum(0.5 * vib_B * qB ** 2))
    lam_nm_forward_dmw = float(0.5 * d_mw_fwd @ KwA @ d_mw_fwd)
    lam_nm_backward_dmw = float(0.5 * d_mw_bwd @ KwB @ d_mw_bwd)
    assert abs(lam_nm_forward - lam_nm_forward_dmw) < 1.0e-8
    assert abs(lam_nm_backward - lam_nm_backward_dmw) < 1.0e-8

    lam_inner_eff = 0.5 * (lam_nm_forward + lam_nm_backward)

    # --- outer reorganization (Marcus two-sphere, span_A unused)
    r_in = float(medium["shell_0_A"])
    r_out = float(medium["shell_1_A"])
    eps_op = float(medium["eps_fast"])
    eps_s = float(medium["eps_slow"])
    geom = (1.0 / r_in) - (1.0 / r_out)
    eps_fac = (1.0 / eps_op) - (1.0 / eps_s)
    lam_outer = MARCUS_PRE_FACTOR_2SPH * geom * eps_fac
    lam_total = lam_inner_eff + lam_outer

    # --- self-exchange and rate curve (Marcus high-T prefactor)
    V_ee = float(medium["coupling_eV"]); T_K = float(medium["temp_K"])
    pre = (V_ee ** 2 / HBAR_EV_S) * np.sqrt(
        np.pi / (lam_total * K_B_EV_PER_K * T_K))
    k_self = pre * np.exp(-lam_total / (4.0 * K_B_EV_PER_K * T_K))

    dG_grid = []; gid_grid = []
    with open(os.path.join(DATA_DIR, "driving_force_grid.csv"), "r") as f:
        rdr = csv.reader(f); next(rdr)
        for row in rdr:
            gid_grid.append(int(row[0])); dG_grid.append(float(row[1]))
    dG_grid = np.array(dG_grid, dtype=float)
    gid_grid = np.array(gid_grid, dtype=int)
    rate = pre * np.exp(
        -((lam_total + dG_grid) ** 2) / (4.0 * lam_total * K_B_EV_PER_K * T_K))

    order = np.argsort(dG_grid)
    rate_sorted = rate[order]
    dG_sorted = dG_grid[order]
    gid_sorted = gid_grid[order]
    i_peak = int(np.argmax(rate_sorted))
    rate_peak_s_inv = float(rate_sorted[i_peak])
    rate_peak_axis_eV = float(dG_sorted[i_peak])
    rate_peak_grid_id = int(gid_sorted[i_peak])

    inv_mask = (dG_grid < -lam_total) & (rate < rate_peak_s_inv)
    inverted_region_detected = bool(np.any(inv_mask))
    if inverted_region_detected:
        first_inv_idx = int(np.argmax(inv_mask))
        first_inverted_grid_id = int(gid_grid[first_inv_idx])
        first_inverted_axis_eV = float(dG_grid[first_inv_idx])
    else:
        first_inverted_grid_id = -1
        first_inverted_axis_eV = float("nan")

    # --- write rate_curve.csv (preserve original ordering)
    rate_curve_path = os.path.join(RESULTS_DIR, "rate_curve.csv")
    with open(rate_curve_path, "w", newline="") as f:
        w = csv.writer(f)
        w.writerow(["grid_id", "axis_eV", "k_et_s_inv", "log10_k_et_s_inv"])
        for gid, dg, k in zip(gid_grid, dG_grid, rate):
            w.writerow([int(gid), "%r" % float(dg),
                        "%r" % float(k),
                        "%r" % float(np.log10(k))])

    # --- write lambda_summary.csv
    lambda_summary_path = os.path.join(RESULTS_DIR, "lambda_summary.csv")
    with open(lambda_summary_path, "w", newline="") as f:
        w = csv.writer(f)
        w.writerow(["lambda_4pt_forward_eV", "lambda_4pt_backward_eV",
                    "lambda_nm_forward_eV", "lambda_nm_backward_eV",
                    "lambda_inner_effective_eV", "lambda_outer_eV",
                    "lambda_total_eV", "k_self_exchange_s_inv"])
        w.writerow(["%.10g" % lam_4_forward, "%.10g" % lam_4_backward,
                    "%.10g" % lam_nm_forward, "%.10g" % lam_nm_backward,
                    "%.10g" % lam_inner_eff, "%.10g" % lam_outer,
                    "%.10g" % lam_total, "%.10g" % k_self])

    dominant_mode_forward = int(np.argmax(mode_proj[0, :, 2]))
    dominant_mode_backward = int(np.argmax(mode_proj[1, :, 2]))

    closure_error_forward = float(lam_4_forward - lam_nm_forward)
    closure_error_backward = float(lam_4_backward - lam_nm_backward)
    eff_inner_consistency = float(
        abs(lam_nm_forward - lam_nm_backward)
        + abs(lam_4_forward - lam_4_backward))

    diagnostics = {
        "alignment_rmsd_forward_A": rmsd_fwd,
        "alignment_rmsd_backward_A": rmsd_bwd,
        "closure_error_forward_eV": closure_error_forward,
        "closure_error_backward_eV": closure_error_backward,
        "effective_inner_consistency_eV": eff_inner_consistency,
        "rigid_norm_forward": rigid_norm_fwd,
        "rigid_norm_backward": rigid_norm_bwd,
        "projected_norm_forward": projected_norm_fwd,
        "projected_norm_backward": projected_norm_bwd,
        "dominant_mode_forward": dominant_mode_forward,
        "dominant_mode_backward": dominant_mode_backward,
        "rate_peak_grid_id": rate_peak_grid_id,
        "rate_peak_axis_eV": rate_peak_axis_eV,
        "rate_peak_s_inv": rate_peak_s_inv,
        "inverted_region_detected": inverted_region_detected,
        "first_inverted_grid_id": first_inverted_grid_id,
        "first_inverted_axis_eV": first_inverted_axis_eV,
    }
    with open(os.path.join(RESULTS_DIR, "diagnostics.json"), "w") as f:
        json.dump(diagnostics, f, indent=2)

    # --- self-test
    _self_test(
        aligned_displacement_mw=aligned_displacement_mw,
        vibrational_basis_mw=vibrational_basis_mw,
        mode_overlap=mode_overlap,
        projected_displacement_mw=projected_displacement_mw,
        mode_projection=mode_proj,
        lam_4_forward=lam_4_forward, lam_4_backward=lam_4_backward,
        lam_nm_forward=lam_nm_forward, lam_nm_backward=lam_nm_backward,
        lam_inner_eff=lam_inner_eff, lam_outer=lam_outer,
        lam_total=lam_total, k_self=k_self,
        rate_curve_path=rate_curve_path, diagnostics=diagnostics)

    # --- overview figure (built last so self-test fails first)
    _make_overview(mode_proj, dG_grid, rate, diagnostics, lam_inner_eff,
                   lam_outer, lam_total)

    _summary_stdout(diagnostics, lam_4_forward, lam_4_backward,
                    lam_nm_forward, lam_nm_backward, lam_inner_eff,
                    lam_outer, lam_total, k_self)


def _self_test(**kw):
    a = kw["aligned_displacement_mw"]; assert a.shape == (2, 21)
    vb = kw["vibrational_basis_mw"]; assert vb.shape == (2, 21, 15)
    mo = kw["mode_overlap"]; assert mo.shape == (2, 15, 15)
    assert np.all(mo >= 0.0), "mode_overlap must be elementwise non-negative"
    for d in range(2):
        diff = mo[d] - mo[d].T
        assert np.max(np.abs(diff)) < 1.0e-10, (
            "mode_overlap[d=%d] not symmetric: max-asym = %.3e"
            % (d, np.max(np.abs(diff))))
    pdmw = kw["projected_displacement_mw"]; assert pdmw.shape == (2, 21)
    mp = kw["mode_projection"]; assert mp.shape == (2, 15, 3)

    err1 = abs(float(np.sum(mp[0, :, 2])) - kw["lam_nm_forward"])
    err2 = abs(float(np.sum(mp[1, :, 2])) - kw["lam_nm_backward"])
    assert err1 < 1.0e-8 and err2 < 1.0e-8, (
        "mode_projection sum disagrees with lambda_nm: %.3e / %.3e"
        % (err1, err2))
    err3 = abs(kw["lam_inner_eff"]
               - 0.5 * (kw["lam_nm_forward"] + kw["lam_nm_backward"]))
    assert err3 < 1.0e-10
    err4 = abs(kw["lam_total"]
               - (kw["lam_inner_eff"] + kw["lam_outer"]))
    assert err4 < 1.0e-10

    diags = kw["diagnostics"]
    rcs = []
    with open(kw["rate_curve_path"], "r") as f:
        rdr = csv.reader(f); next(rdr)
        for row in rdr: rcs.append((int(row[0]), float(row[1]), float(row[2])))
    kmax = max(rc[2] for rc in rcs)
    gid_max = next(gid for (gid, _dG, k) in rcs if k == kmax)
    assert abs(kmax - diags["rate_peak_s_inv"]) < 1.0e-10
    assert gid_max == diags["rate_peak_grid_id"]


def _make_overview(mode_proj, dG_grid, rate, diagnostics, lam_inner_eff,
                   lam_outer, lam_total):
    import math
    chart = MicroChart(1200, 980)

    panel1_top = 50
    panel1_bot = 520
    panel1_left = 110
    panel1_right = 1170

    title1 = ("INNER REORGANIZATION BY RETAINED VIBRATIONAL MODE  "
              "LAM I=" + _format_eV(lam_inner_eff)
              + "  LAM O=" + _format_eV(lam_outer)
              + "  LAM TOT=" + _format_eV(lam_total))
    tw = text_width(title1, scale=2)
    draw_text(chart.canvas, title1,
              (panel1_left + panel1_right - tw) // 2,
              panel1_top - 32, color=(0, 0, 0), scale=2)

    draw_box(chart.canvas, panel1_left, panel1_top, panel1_right,
             panel1_bot, color=(80, 80, 80), thickness=1)
    draw_text(chart.canvas, "RETAINED MODE INDEX MU",
              (panel1_left + panel1_right -
               text_width("RETAINED MODE INDEX MU", scale=2)) // 2,
              panel1_bot + 16, color=(0, 0, 0), scale=2)
    draw_text(chart.canvas, "PER-MODE LAMBDA [EV]", 8,
              (panel1_top + panel1_bot -
               text_width("PER-MODE LAMBDA [EV]", scale=2)) // 2,
              color=(0, 0, 0), scale=2)

    n_mu = mode_proj.shape[1]
    lam_max = float(max(np.max(mode_proj[0, :, 2]),
                        np.max(mode_proj[1, :, 2])))
    if lam_max <= 0.0:
        lam_max = 1.0
    y_top = _nice_ceil(lam_max * 1.10)

    span = panel1_right - panel1_left - 40
    bar_w = max(3, span // (n_mu * 3) - 1)
    for i in range(n_mu):
        cx = panel1_left + 20 + int((i + 0.5) * (span / n_mu))
        bw = max(2, bar_w)
        x0 = cx - bar_w - 1
        x1 = x0 + bar_w
        y1 = panel1_bot - 1
        for_bar = mode_proj[0, i, 2]
        if for_bar > 0:
            y_top_h = panel1_bot - int(
                (panel1_bot - panel1_top) * (for_bar / y_top))
            draw_filled_rect(chart.canvas, x0, y_top_h, x1 + 1, y1,
                             color=(70, 110, 180))
        x0 = cx + 1
        x1 = x0 + bar_w
        bck_bar = mode_proj[1, i, 2]
        if bck_bar > 0:
            y_top_h = panel1_bot - int(
                (panel1_bot - panel1_top) * (bck_bar / y_top))
            draw_filled_rect(chart.canvas, x0, y_top_h, x1 + 1, y1,
                             color=(220, 110, 90))

    step = max(1, n_mu // 8)
    for i in range(0, n_mu, step):
        cx = panel1_left + 20 + int((i + 0.5) * (span / n_mu))
        lbl = "%d" % i
        tw = text_width(lbl, scale=1)
        draw_text(chart.canvas, lbl, cx - tw // 2, panel1_bot + 4,
                  color=(40, 40, 40), scale=1)
        for dy in range(2):
            if 0 <= panel1_bot + dy < chart.H:
                chart.canvas[panel1_bot + dy, cx] = (60, 60, 60)

    for v in np.linspace(0.0, y_top, 5):
        py = panel1_bot - int((panel1_bot - panel1_top) * (v / y_top))
        for dx in range(2):
            if 0 <= panel1_left - 1 - dx < chart.W:
                chart.canvas[py, panel1_left - 1 - dx] = (60, 60, 60)
        lbl = "%.2g" % v
        tw = text_width(lbl, scale=1)
        draw_text(chart.canvas, lbl, panel1_left - 6 - tw, py - 3,
                  color=(40, 40, 40), scale=1)

    leg_x = panel1_right - 220
    leg_y = panel1_top + 6
    draw_filled_rect(chart.canvas, leg_x, leg_y, leg_x + 16, leg_y + 12,
                     color=(70, 110, 180))
    draw_text(chart.canvas, "FORWARD B IN A", leg_x + 22, leg_y + 1,
              color=(0, 0, 0), scale=1)
    draw_filled_rect(chart.canvas, leg_x, leg_y + 16, leg_x + 16,
                     leg_y + 28, color=(220, 110, 90))
    draw_text(chart.canvas, "BACKWARD A IN B", leg_x + 22, leg_y + 17,
              color=(0, 0, 0), scale=1)

    panel2_top = 560
    panel2_bot = 940
    panel2_left = 110
    panel2_right = 1170

    rate_max = float(np.max(rate))
    rate_min = float(np.min(rate[rate > 0])) if np.any(rate > 0) else rate_max
    rate_min = max(rate_min, rate_max * 1e-12)

    order = np.argsort(dG_grid)
    dG_sorted = dG_grid[order]
    rate_sorted = rate[order]
    dG_min = float(np.min(dG_grid))
    dG_max = float(np.max(dG_grid))

    title2 = ("MARCUS RATE K(DG)  PEAK DG="
              + _format_eV(diagnostics["rate_peak_axis_eV"])
              + "  K=" + _format_k(diagnostics["rate_peak_s_inv"]))
    tw = text_width(title2, scale=2)
    draw_text(chart.canvas, title2,
              (panel2_left + panel2_right - tw) // 2, panel2_top - 32,
              color=(0, 0, 0), scale=2)

    draw_box(chart.canvas, panel2_left, panel2_top, panel2_right,
             panel2_bot, color=(80, 80, 80), thickness=1)
    draw_text(chart.canvas, "DRIVING FORCE DG [EV]",
              (panel2_left + panel2_right -
               text_width("DRIVING FORCE DG [EV]", scale=2)) // 2,
              panel2_bot + 16, color=(0, 0, 0), scale=2)
    draw_text(chart.canvas, "K_ET [S^-1]", 8,
              (panel2_top + panel2_bot -
               text_width("K_ET [S^-1]", scale=2)) // 2,
              color=(0, 0, 0), scale=2)

    def to_x(dg):
        return panel2_left + int(
            (panel2_right - panel2_left) *
            (dg - dG_min) / max(dG_max - dG_min, 1e-30))

    def to_y_log(k):
        ly = math.log10(max(k, rate_min))
        lo = math.log10(rate_min)
        hi = math.log10(max(rate_max * 1.10, rate_min * 10))
        t = (ly - lo) / max(hi - lo, 1e-30)
        return panel2_bot - int(t * (panel2_bot - panel2_top))

    n_xticks = 7
    for i in range(n_xticks):
        dg_t = dG_min + i * (dG_max - dG_min) / (n_xticks - 1)
        px = int(round(to_x(dg_t)))
        for dy in range(2):
            if 0 <= panel2_bot + dy < chart.H:
                chart.canvas[panel2_bot + dy, px] = (60, 60, 60)
        lbl = "%.2f" % dg_t
        tw = text_width(lbl, scale=1)
        draw_text(chart.canvas, lbl, px - tw // 2, panel2_bot + 5,
                  color=(40, 40, 40), scale=1)

    lo_l = math.floor(math.log10(rate_min))
    hi_l = math.ceil(math.log10(rate_max * 1.10))
    for decade in range(lo_l, hi_l + 1):
        py = int(round(to_y_log(10 ** decade)))
        if py < panel2_top - 5 or py > panel2_bot + 5:
            continue
        for dx in range(2):
            if 0 <= panel2_left - 1 - dx < chart.W:
                chart.canvas[py, panel2_left - 1 - dx] = (60, 60, 60)
        lbl = "1E%d" % decade
        tw = text_width(lbl, scale=1)
        draw_text(chart.canvas, lbl, panel2_left - 6 - tw, py - 3,
                  color=(40, 40, 40), scale=1)

    if -lam_total >= dG_min and -lam_total <= dG_max:
        px = int(round(to_x(-lam_total)))
        draw_dashed_line(chart.canvas, px, panel2_top, px, panel2_bot,
                         color=(140, 140, 140), thickness=2)

    pts = []
    for i in range(len(dG_sorted)):
        pts.append((to_x(dG_sorted[i]), to_y_log(rate_sorted[i])))
    for i in range(len(pts) - 1):
        draw_line(chart.canvas,
                  pts[i][0], pts[i][1],
                  pts[i + 1][0], pts[i + 1][1],
                  color=(0, 0, 0), thickness=2)

    px = int(round(to_x(diagnostics["rate_peak_axis_eV"])))
    py = int(round(to_y_log(diagnostics["rate_peak_s_inv"])))
    draw_pixel(chart.canvas, px, py, color=(40, 130, 60), size=10)

    if diagnostics["inverted_region_detected"]:
        inv_dg = diagnostics["first_inverted_axis_eV"]
        idx_near = int(np.argmin(np.abs(dG_sorted - inv_dg)))
        inv_k = float(rate_sorted[idx_near])
        px = int(round(to_x(inv_dg)))
        py = int(round(to_y_log(inv_k)))
        for dx in range(-5, 6):
            for dy in range(-5, 6):
                if abs(dx) <= 3 and abs(dy) <= 3:
                    if abs(dx) == 3 or abs(dy) == 3:
                        if (0 <= py + dy < chart.H and
                                0 <= px + dx < chart.W):
                            chart.canvas[py + dy, px + dx] = (180, 30, 30)

    chart.save(os.path.join(RESULTS_DIR, "overview.png"))


def _format_eV(v):
    if abs(v) < 0.001:
        return "%.2EEV" % v
    return "%.3FEV" % v


def _format_k(v):
    if v == 0:
        return "0"
    import math
    if v < 1e-3 or v > 1e6:
        return "%.2ES-1" % v
    return "%.3GS-1" % v


def _nice_ceil(v):
    import math
    if v <= 0:
        return 1.0
    expv = math.floor(math.log10(v))
    base = 10 ** expv
    frac = v / base
    if frac <= 1.0:
        nice = 1.0
    elif frac <= 1.5:
        nice = 1.5
    elif frac <= 2.0:
        nice = 2.0
    elif frac <= 3.0:
        nice = 3.0
    elif frac <= 5.0:
        nice = 5.0
    else:
        nice = 10.0
    return nice * base
