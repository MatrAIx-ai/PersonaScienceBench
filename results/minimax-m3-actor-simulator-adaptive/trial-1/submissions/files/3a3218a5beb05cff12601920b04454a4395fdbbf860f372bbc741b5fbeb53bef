"""
DiscoveryBench - NLSY79 time-preference -> BMI analysis.

Question: "Does increased time preference lead to higher BMI?"

Locked-in scope (per researcher approval):
  * Six regressions: 3 patience proxies x 2 BMI years (1981, 1992).
        Primary    : log(1 + net amount put into savings 1989)
        Secondary  : delta log family net wealth 1985 -> 1996 (0-floor before log)
        Tertiary   : respondent's own highest grade (capped at 20)
  * Patience index is Z-scored with sign convention: higher value = MORE PATIENT
    (i.e., LOWER time preference). Coefficient on the patience index is
    therefore EXPECTED to be NEGATIVE if "increased time preference -> higher BMI".
  * Controls in every regression: male, race dummies (Black, Hispanic),
    age in 1979, log(1 + family income 1979), mother's and father's grade
    (capped at 20), ASVAB arithmetic-reasoning.
  * Inference: HC1 heteroskedasticity-robust SEs, two-sided p-values.
  * Winsorize continuous predictors and income/wealth at 1st/99th pct
    BEFORE logging. Outcome (BMI) is NOT winsorized.

Unit conversions (documented at top of notebook):
  * Height 1981 stored as packed feet-inches FFCCII
        e.g. 504 = 5 feet 4 inches = 64 inches
        height_in = floor(h/100)*12 + (h mod 100)         (in inches)
  * Height 1985 already in inches.
  * For BMI 1992 prefer height 1985; fall back to converted height 1981.
  * Weight 1981/1989/1992 stored in pounds -> kg = lb / 2.20462.
  * BMI = weight_kg / (height_m)^2.
"""
import json
import numpy as np
import pandas as pd
import statsmodels.api as sm

# ---- Load ------------------------------------------------------------------
df = pd.read_csv('data/nls_raw.csv', low_memory=False)
print(f'Loaded rows: {len(df)}')

# ---- Unit conversions ------------------------------------------------------
def ffci_to_in(h):
    """Packed feet-inches FFCCII -> inches. NaN-safe."""
    if pd.isna(h):
        return np.nan
    h = float(h)
    if h < 100 or h > 900:
        return np.nan
    feet   = int(h // 100)
    inches = h - feet * 100.0
    return feet * 12.0 + inches

df['height_in_1981'] = df['Height of respondent, 1981'].apply(ffci_to_in)
df['height_in_1985'] = df['Height of respondent, 1985']

# Sanity-check the FFCCII conversion against 1985 inches
mask = df['height_in_1981'].notna() & df['height_in_1985'].notna()
chk = df.loc[mask, ['height_in_1981', 'height_in_1985']]
if len(chk) > 50:
    diff = (chk['height_in_1981'] - chk['height_in_1985']).abs()
    print(f'Height conversion sanity (N={len(chk)}): '
          f'mean |Delta in| vs 1985 = {diff.mean():.2f}; '
          f'median = {diff.median():.2f}; '
          f'% within 1 in = {(diff <= 1).mean():.3f}; '
          f'% within 2 in = {(diff <= 2).mean():.3f}')

# Weight: pounds -> kilograms (variables come in pounds despite description)
for w_in, w_out in [
        ('Weight of respondent, 1981', 'weight_kg_1981'),
        ('Weight of respondent, 1989', 'weight_kg_1989'),
        ('Weight of respondent, 1992', 'weight_kg_1992')]:
    df[w_out] = df[w_in] / 2.20462

# Choose height for BMI 1992: prefer 1985, fall back to converted 1981
df['height_in_for_BMI_92'] = df['height_in_1985'].where(
    df['height_in_1985'].notna(), df['height_in_1981'])

# ---- BMI -------------------------------------------------------------------
INCH_TO_M = 0.0254
df['bmi_1981'] = df['weight_kg_1981'] / ((df['height_in_1981'] * INCH_TO_M) ** 2)
df['bmi_1992'] = df['weight_kg_1992'] / ((df['height_in_for_BMI_92'] * INCH_TO_M) ** 2)

print(f"BMI 1981: n={df['bmi_1981'].notna().sum()}, "
      f"mean={df['bmi_1981'].mean():.2f}, "
      f"sd={df['bmi_1981'].std():.2f}, "
      f"min={df['bmi_1981'].min():.2f}, max={df['bmi_1981'].max():.2f}")
print(f"BMI 1992: n={df['bmi_1992'].notna().sum()}, "
      f"mean={df['bmi_1992'].mean():.2f}, "
      f"sd={df['bmi_1992'].std():.2f}, "
      f"min={df['bmi_1992'].min():.2f}, max={df['bmi_1992'].max():.2f}")

# ---- Demographics ---------------------------------------------------------
df['male']     = np.where(df['Sex of respondent, 1979'] == 1, 1.0,
                   np.where(df['Sex of respondent, 1979'] == 2, 0.0, np.nan))
df['black']    = (df['Racial/ethnic cohort, 1979'] == 1).astype(float)
df['hispanic'] = (df['Racial/ethnic cohort, 1979'] == 2).astype(float)
df.loc[df['Racial/ethnic cohort, 1979'].isna(), ['black', 'hispanic']] = np.nan

# ---- Education: cap at 20 -------------------------------------------------
def cap_grade(s, hi=20):
    return s.where(s <= hi, np.nan)

df['resp_grade_capped']   = cap_grade(df['Highest grade completed, 1979'])
df['mother_grade_capped'] = cap_grade(df[
    "Highest grade completed by respondent's mother, 1979"])
df['father_grade_capped'] = cap_grade(df[
    "Highest grade completed by respondent's father, 1979"])

# ---- Winsorize continuous predictors (NOT the outcome) --------------------
def winsorize(s, lower=0.01, upper=0.99):
    s = s.copy()
    n_obs = s.notna().sum()
    if n_obs < 10:
        return s
    lo, hi = s.quantile(lower), s.quantile(upper)
    return s.clip(lower=lo, upper=hi)

WINS_COLS = [
    'Family net wealth, 1985',
    'Family net wealth, 1990',
    'Family net wealth, 1996 (key data point)',
    'Total net family income, previous calendar year, 1979',
    'Total net family income, previous calendar year, 1985',
    'Total net family income, previous calendar year, 1989',
    'Net amount respondent/spouse put into savings since last interview, 1989',
    'ASVAB - Arithmetic Reasoning Z Score (rounded), 1981',
]

winsorization_log = {}
for col in WINS_COLS:
    if col not in df.columns:
        continue
    n_obs = df[col].notna().sum()
    q01, q99 = df[col].quantile(0.01), df[col].quantile(0.99)
    df[col + '_w'] = winsorize(df[col])
    extreme = ((df[col] < q01) | (df[col] > q99)).sum()
    winsorization_log[col] = {'q01': float(q01), 'q99': float(q99),
                              'n_clipped': int(extreme),
                              'n_obs': int(n_obs)}
    if extreme:
        print(f'  winsorized {col!r}: {extreme}/{n_obs} values clipped '
              f'to [{q01:.3f}, {q99:.3f}]')

# ---- Patience proxies: higher value = MORE PATIENT ------------------------
# (1) Savings proxy: log(1 + max(0, net amount put into savings 1989))
df['savings_w'] = df[
    'Net amount respondent/spouse put into savings since last interview, 1989_w'
].clip(lower=0)
df['savings_log'] = np.log1p(df['savings_w'])

# (2) Wealth-growth proxy: delta log family net wealth 1985 -> 1996
w85 = df['Family net wealth, 1985_w'].clip(lower=0)
w96 = df['Family net wealth, 1996 (key data point)_w'].clip(lower=0)
# log of 0 (clipped negatives) is -inf; replace -inf/+inf with NaN so the diff is well-defined
df['log_wealth_85'] = (np.log(w85.where(w85 > 0))
                       .replace([np.inf, -np.inf], np.nan))
df['log_wealth_96'] = (np.log(w96.where(w96 > 0))
                       .replace([np.inf, -np.inf], np.nan))
df['dlog_wealth_85_96'] = df['log_wealth_96'] - df['log_wealth_85']
print(f'  dlog_wealth_85_96 nonzero: '
      f'{df["dlog_wealth_85_96"].notna().sum()} obs; '
      f'mean={df["dlog_wealth_85_96"].mean():.3f}; '
      f'sd={df["dlog_wealth_85_96"].std():.3f}')

# (3) Education proxy: respondent's own highest grade (capped at 20)

# Z-score with sample mean/std of observed values, NaN-safe
def zscore(s):
    mu, sd = s.mean(), s.std(ddof=0)
    if pd.isna(sd) or sd == 0:
        return pd.Series(np.nan, index=s.index)
    return (s - mu) / sd

df['patience_savings']   = zscore(df['savings_log'])
df['patience_wealth']    = zscore(df['dlog_wealth_85_96'])
df['patience_education'] = zscore(df['resp_grade_capped'])

for name in ['patience_savings', 'patience_wealth', 'patience_education']:
    s = df[name]
    print(f'  {name}: n={s.notna().sum()}, mean={s.mean():.3f}, sd={s.std(ddof=0):.3f}, '
          f'min={s.min():.3f}, q25={s.quantile(.25):.3f}, '
          f'med={s.median():.3f}, q75={s.quantile(.75):.3f}, max={s.max():.3f}')

df['log_income_79'] = np.log1p(
    df['Total net family income, previous calendar year, 1979_w'])
df['asvab_ar'] = df['ASVAB - Arithmetic Reasoning Z Score (rounded), 1981_w']

# ---- Regression loop ------------------------------------------------------
CONTROLS = ['male', 'black', 'hispanic',
            'Age of respondent, 1979',
            'log_income_79',
            'mother_grade_capped', 'father_grade_capped',
            'asvab_ar']

def run_reg(model_df, y, x_patience, controls, label):
    cols = [y, x_patience] + controls
    sub = model_df[cols].dropna()
    n_total = len(model_df)
    n_used = len(sub)
    miss = {c: int(model_df[c].isna().sum()) for c in cols}
    y_vec = sub[y]
    X = sm.add_constant(sub[[x_patience] + controls])
    res = sm.OLS(y_vec, X).fit(cov_type='HC1')
    b  = res.params[x_patience]
    se = res.bse[x_patience]
    p  = res.pvalues[x_patience]
    ci_lo, ci_hi = res.conf_int().loc[x_patience].tolist()
    direction_ok = bool(b < 0)  # higher patience -> lower BMI => b<0
    # Per-model covariate list shown
    coef_table = pd.DataFrame({
        'coef':    res.params,
        'se_hc1':  res.bse,
        'pvalue':  res.pvalues,
    }).round(4)
    coef_table.loc[x_patience, 'direction_β<0_consistent_hypothesis'] = direction_ok
    return {
        'label': label,
        'outcome': y,
        'patience_index': x_patience,
        'n_total': n_total, 'n_used': n_used,
        'missing_per_covariate': miss,
        'coef_on_patience': float(b),
        'se_hc1': float(se),
        'p_two_sided': float(p),
        'ci95': [float(ci_lo), float(ci_hi)],
        'direction_consistent': direction_ok,
        'r2': float(res.rsquared),
        'r2_adj': float(res.rsquared_adj),
        'f_pvalue_joint': float(res.f_pvalue),
        'coef_table_rows': coef_table.to_dict(orient='index'),
    }

reg_specs = [
    ('bmi_1981', 'patience_savings',    'Savings (log net savings 1989)   -> BMI 1981'),
    ('bmi_1992', 'patience_savings',    'Savings (log net savings 1989)   -> BMI 1992'),
    ('bmi_1981', 'patience_wealth',     'Delta log wealth 1985->1996      -> BMI 1981'),
    ('bmi_1992', 'patience_wealth',     'Delta log wealth 1985->1996      -> BMI 1992'),
    ('bmi_1981', 'patience_education',  'Education (resp grade, capped)   -> BMI 1981'),
    ('bmi_1992', 'patience_education',  'Education (resp grade, capped)   -> BMI 1992'),
]

results = [run_reg(df, y, xp, CONTROLS, lbl) for (y, xp, lbl) in reg_specs]

# Pretty table
hdr_pat = 'Patience index'
print('\n' + '=' * 100)
print(f'{"Outcome":<11}{hdr_pat:<28}{"n":>6}{"beta":>9}{"SE":>8}{"p":>10}'
      f'{"95% CI":>21}{"beta<0?":>9}{"R^2":>7}')
print('-' * 100)
for r in results:
    ci = f'[{r["ci95"][0]:.3f},{r["ci95"][1]:.3f}]'
    print(f'{r["outcome"]:<11}{r["patience_index"]:<28}'
          f'{r["n_used"]:>6}{r["coef_on_patience"]:>9.4f}'
          f'{r["se_hc1"]:>8.4f}{r["p_two_sided"]:>10.3g}{ci:>21}'
          f'{str(r["direction_consistent"]):>9}{r["r2"]:>7.3f}')
print('=' * 100)

n_ok = sum(1 for r in results if r['direction_consistent'])
n_p05 = sum(1 for r in results if r['direction_consistent'] and r['p_two_sided'] < 0.05)
n_p10 = sum(1 for r in results if r['direction_consistent'] and r['p_two_sided'] < 0.10)
print(f'\nDirection-consistent regressions: {n_ok}/{len(results)}; '
      f'of which p<0.05: {n_p05}; p<0.10: {n_p10}')

# Save full report
report = {
    'dataset_rows_total':  int(len(df)),
    'patience_index_describe': {
        name: df[name].describe().to_dict()
        for name in ['patience_savings', 'patience_wealth', 'patience_education']
    },
    'winsorization_log': winsorization_log,
    'bmi_describe': {
        'bmi_1981': df['bmi_1981'].describe().to_dict(),
        'bmi_1992': df['bmi_1992'].describe().to_dict(),
    },
    'unit_conversions': {
        'height_1981':  'FFCCII packed: feet = floor(h/100), inches = h mod 100; convert to m',
        'height_1985':  'already inches; convert to m',
        'BMI_1992_height_rule': 'prefer 1985 inches; fall back to converted 1981 inches if 1985 missing',
        'weight_1981_1989_1992': 'stored in pounds -> kg = lb / 2.20462',
    },
    'controls': CONTROLS,
    'inference': 'HC1 (heteroskedasticity-robust) SE, two-sided p-values',
    'winsorization_rule': '1st/99th percentile on continuous predictors and income/wealth BEFORE logging; outcome (BMI) NOT winsorized',
    'regressions': results,
    'aggregate': {
        'n_consistent_with_hypothesis': n_ok,
        'n_total':                       len(results),
        'n_consistent_p_lt_0.05':        n_p05,
        'n_consistent_p_lt_0.10':        n_p10,
    },
}
with open('artifacts/analysis_results.json', 'w') as f:
    json.dump(report, f, indent=2, default=str)
print('\nWrote artifacts/analysis_results.json')
