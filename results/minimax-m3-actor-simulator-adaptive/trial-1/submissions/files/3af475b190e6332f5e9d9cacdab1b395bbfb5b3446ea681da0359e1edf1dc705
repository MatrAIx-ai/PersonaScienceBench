"""Main analysis: cohort-level median family net wealth, NLSY79, 1985/1990/1996.

Headline (within-wave available-case):
  - per-cohort N, median (P50), P25, P75, share of non-positive wealth
  - within-wave white-to-minority ratios M_NBNH / M_BLACK and M_NBNH / M_HISPANIC
  - inverted ratios 1/R reported as the minority-to-white context so direction is unambiguous

Sensitivity (complete-case across all three wealth fields, exact CC panel used as a side line only):
  - per-cohort N, median (P50), P25, P75, share of non-positive wealth, for each of 1985/1990/1996

Defaults locked by the researcher: nominal dollars of survey year; cohort fixed at 1979;
complete-case = side line; auxiliaries reported; descriptive only.

Negative and zero wealth values are retained (they are real observations,
not sentinels), and NaN indicates item nonresponse and is excluded per wave.
"""
import pandas as pd

CSV = "/workspace/data/nls_raw.csv"
COHORT = "Racial/ethnic cohort, 1979"
WEALTH = {
    "1985": "Family net wealth, 1985",
    "1990": "Family net wealth, 1990",
    "1996": "Family net wealth, 1996 (key data point)",  # 1996 column has the literal suffix
}
ID = "ID# (range 1-12686) 1979"
COHORT_NAME = {1: "BLACK", 2: "HISPANIC", 3: "NBNH (white-comparison proxy)"}


def per_cohort_stats(g: pd.DataFrame, col: str) -> pd.Series:
    """Return N, median, P25, P75, share of non-positive wealth for one cohort x wave."""
    s = g[col].dropna()
    if len(s) == 0:
        return pd.Series({"N": 0, "median": float("nan"),
                          "P25": float("nan"), "P75": float("nan"),
                          "share_non_positive": float("nan")})
    return pd.Series({
        "N": int(len(s)),
        "median": float(s.median()),
        "P25": float(s.quantile(0.25)),
        "P75": float(s.quantile(0.75)),
        "share_non_positive": float((s <= 0).mean()),
    })


def both_views(df: pd.DataFrame, view_name: str) -> None:
    print(f"\n{'='*78}\nVIEW: {view_name}\n{'='*78}")
    cc_mask = (df[WEALTH["1985"]].notna()
               & df[WEALTH["1990"]].notna()
               & df[WEALTH["1996"]].notna())
    print(f"Rows in view: {cc_mask.sum()}" if view_name.lower().startswith("complete")
          else f"Rows in view: {len(df)}")

    # Per wave x cohort stats
    rows = []
    for year, col in WEALTH.items():
        for code in [1, 2, 3]:
            sub = df[df[COHORT] == code]
            stats = per_cohort_stats(sub, col)
            stats["year"] = year
            stats["cohort_code"] = code
            stats["cohort"] = COHORT_NAME[code]
            rows.append(stats)
    tab = pd.DataFrame(rows)[["year", "cohort_code", "cohort", "N",
                              "median", "P25", "P75", "share_non_positive"]]
    # Pretty formatting for display
    disp = tab.copy()
    for c in ["median", "P25", "P75"]:
        disp[c] = disp[c].map(lambda v: f"{v:,.0f}" if pd.notna(v) else "—")
    disp["share_non_positive"] = disp["share_non_positive"].map(
        lambda v: f"{v*100:.2f}%" if pd.notna(v) else "—")
    print("\nCohort-level medians + IQR + non-positive share, by wave:")
    print(disp.to_string(index=False))

    # Within-wave ratios
    print("\nWithin-wave white-to-minority ratios  (R = M_NBNH / M_minority):")
    ratio_rows = []
    for year, col in WEALTH.items():
        med = df.groupby(COHORT)[col].median()
        m_nbnh = med.loc[3]
        m_blk  = med.loc[1]
        m_his  = med.loc[2]
        r_blk  = m_nbnh / m_blk
        r_his  = m_nbnh / m_his
        inv_blk = 1.0 / r_blk
        inv_his = 1.0 / r_his
        ratio_rows.append({
            "year": year,
            "M_NBNH": m_nbnh,
            "M_BLACK": m_blk,
            "M_HISPANIC": m_his,
            "R_black   = M_NBNH/M_BLACK":   r_blk,
            "1/R_black  = M_BLACK/M_NBNH":   inv_blk,
            "R_hispanic = M_NBNH/M_HISP":    r_his,
            "1/R_hispanic = M_HISP/M_NBNH":  inv_his,
        })
    rt = pd.DataFrame(ratio_rows)
    for c in ["M_NBNH", "M_BLACK", "M_HISPANIC"]:
        rt[c] = rt[c].map(lambda v: f"{v:,.0f}")
    for c in ["R_black   = M_NBNH/M_BLACK", "R_hispanic = M_NBNH/M_HISP",
              "1/R_black  = M_BLACK/M_NBNH", "1/R_hispanic = M_HISP/M_NBNH"]:
        rt[c] = rt[c].map(lambda v: f"{v:.2f}x")
    print(rt.to_string(index=False))

    # Trend of the gap (NBNH/minority) across waves
    print("\nTrend of the wealth gap (ratio R = M_NBNH / M_minority) across waves:")
    for label, code in [("BLACK", 1), ("HISPANIC", 2)]:
        med = df.groupby(COHORT).agg({WEALTH["1985"]: "median",
                                      WEALTH["1990"]: "median",
                                      WEALTH["1996"]: "median"}).loc[code]
        r = med.iloc[0], med.iloc[1], med.iloc[2]
        m_w = (
            df.groupby(COHORT)[WEALTH["1985"]].median().loc[3],
            df.groupby(COHORT)[WEALTH["1990"]].median().loc[3],
            df.groupby(COHORT)[WEALTH["1996"]].median().loc[3],
        )
        ratios = [a / b for a, b in zip(m_w, r)]
        direction = []
        for a, b in zip(ratios, ratios[1:]):
            direction.append("widening (R up)" if a < b else "narrowing (R down)" if a > b else "flat")
        print(f"  NBNH/{label}:  R(1985)={ratios[0]:.2f}x  "
              f"R(1990)={ratios[1]:.2f}x  R(1996)={ratios[2]:.2f}x   "
              f"1985->1990: {direction[0]:<20s} 1990->1996: {direction[1]}")


def main() -> None:
    df = pd.read_csv(CSV, low_memory=False)

    # Headline: within-wave available case (no row filter beyond cohort + per-wave non-missing)
    both_views(df, "Headline — within-wave available case")

    # Sensitivity: complete-case across all three wealth fields
    cc = df[df[WEALTH["1985"]].notna()
            & df[WEALTH["1990"]].notna()
            & df[WEALTH["1996"]].notna()].copy()
    print(f"\nComplete-case panel N = {len(cc)} "
          f"(cohort counts: {(cc[COHORT]==1).sum()} / {(cc[COHORT]==2).sum()} "
          f"/ {(cc[COHORT]==3).sum()})")
    both_views(cc, "Sensitivity — complete-case (all three waves non-missing)")

    # Counts per cohort per wave (for record)
    print("\nFor the record: per-cohort non-missing wealth counts by wave")
    for y, col in WEALTH.items():
        ctab = pd.crosstab(df[COHORT], df[col].notna())
        print(f"\n  {y}:")
        print(ctab)


if __name__ == "__main__":
    main()
