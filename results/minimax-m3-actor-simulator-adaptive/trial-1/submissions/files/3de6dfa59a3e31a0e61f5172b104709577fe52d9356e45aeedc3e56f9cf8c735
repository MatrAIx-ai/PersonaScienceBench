import re, json, csv
import numpy as np, pandas as pd
import statsmodels.api as sm
from statsmodels.regression.linear_model import GLS
from pathlib import Path
import warnings; warnings.filterwarnings("ignore")

RES = Path("results")

def parse_newick(nwk):
    nwk = nwk.strip().rstrip(";")
    pos = [0]
    def parse_subtree():
        node = {"name": None, "length": None, "children": []}
        if nwk[pos[0]] == "(":
            pos[0] += 1
            node["children"].append(parse_subtree())
            while nwk[pos[0]] == ",":
                pos[0] += 1
                node["children"].append(parse_subtree())
            assert nwk[pos[0]] == ")", f"expected ) at {pos[0]}"
            pos[0] += 1
        m = re.match(r"[A-Za-z_][A-Za-z0-9_\.\-]*", nwk[pos[0]:])
        if m:
            node["name"] = m.group(0)
            pos[0] += len(m.group(0))
        if pos[0] < len(nwk) and nwk[pos[0]] == ":":
            pos[0] += 1
            m = re.match(r"[+-]?\d+(\.\d+)?([eE][+-]?\d+)?", nwk[pos[0]:])
            assert m, f"expected number at {pos[0]}"
            node["length"] = float(m.group(0))
            pos[0] += len(m.group(0))
        return node
    return parse_subtree()

def collect_tips_paths(tree):
    tip_paths = {}
    def walk(node, cumlen_from_parent, path):
        new_path = path + [(cumlen_from_parent,)]
        if not node["children"]:
            tip_paths[node["name"]] = new_path
            return
        for c in node["children"]:
            walk(c, c["length"] or 0.0, new_path)
    walk(tree, 0.0, [])
    return tip_paths

def patristic_distance(tip_paths, tips):
    def dist(i, j):
        p1, p2 = tip_paths[i], tip_paths[j]
        k = 0
        minlen = min(len(p1), len(p2))
        while k < minlen-1 and p1[k+1] == p2[k+1]:
            k += 1
        d = 0.0
        for x in p1[k:]: d += x[0]
        for x in p2[k:]: d += x[0]
        return d
    n = len(tips)
    D = np.zeros((n, n))
    for i in range(n):
        for j in range(i+1, n):
            d = dist(tips[i], tips[j])
            D[i,j] = D[j,i] = d
    return D

# Parse tree and build matrices; tip order will be the species_with_data after alignment
with open("data/phylogenetic_tree.txt") as f:
    nwk = f.read().strip()
tree = parse_newick(nwk)

# Compute *total root-to-tip length* per tip; this requires accumulating parent path lengths along the list.
def root_to_tip_lengths(tip_paths):
    out = {}
    for nm, p in tip_paths.items():
        out[nm] = float(sum(x[0] for x in p))
    return out

tip_paths_all = collect_tips_paths(tree)
all_tips = sorted(tip_paths_all.keys())
print(f"Tree tips: {len(all_tips)} (with at least one branch)")

# Need actual root-to-tip; we stored per-step branch length only via the PARENT lengths.
# But in our recursive walk we only stored branch lengths from parent's perspective; let's recover.
# Re-walk to keep both per-step from-parent AND previous cumlength.
def collect_paths_2(tree):
    tip_paths = {}
    def walk(node, blen_from_parent, path_list_pairs):
        # path_list_pairs: list of (parent_uplength, blen_from_parent)
        cumul = 0 if not path_list_pairs else path_list_pairs[-1][0]
        cumul = cumul + blen_from_parent
        new_path = path_list_pairs + [(cumul, blen_from_parent)]
        if not node["children"]:
            tip_paths[node["name"]] = new_path
            return
        for c in node["children"]:
            walk(c, c["length"] or 0.0, new_path)
    walk(tree, 0.0, [])
    return tip_paths

tip_paths_all = collect_paths_2(tree)
root_to_tip = {nm: p[-1][0] for nm, p in tip_paths_all.items()}

def patristic(tip_paths, tips):
    def dist(i, j):
        p1, p2 = tip_paths[i], tip_paths[j]
        k = 0
        minlen = min(len(p1), len(p2))
        # Split at first index where cumulative differs
        while k < minlen-1 and abs(p1[k+1][0] - p2[k+1][0]) < 1e-9:
            k += 1
        d = 0.0
        for x in p1[k:]:
            d += x[1]
        for x in p2[k:]:
            d += x[1]
        return d
    n = len(tips); D = np.zeros((n, n))
    for i in range(n):
        for j in range(i+1, n):
            D[i,j] = D[j,i] = dist(tips[i], tips[j])
    return D

D_full = patristic(tip_paths_all, all_tips)
L_full = np.array([root_to_tip[t] for t in all_tips])
print(f"D_full shape: {D_full.shape}, max={D_full.max():.3f}, mean={D_full.mean():.3f}")
# Shared-path (Brownian-like) VCV at lambda=1
C_share_full = (L_full[None,:] + L_full[:,None] - D_full) / 2.0
print(f"C_share_full diag[:5] vs L_full[:5]: {C_share_full[0,:5]} vs {L_full[:5]}")

# Alignment: keep only tips that match phylo.tip.label in the species table.
with open("data/invasion_success_pathways.csv") as f:
    rdr = csv.DictReader(f); sp_rows = list(rdr)
labels = [r["phylo.tip.label"] for r in sp_rows]
lab_set = set(labels)
keep = [t for t in all_tips if t in lab_set]
# Ensure one-to-one: if duplicate, take first
seen = set(); ordered = []
for t in all_tips:
    if t in lab_set and t not in seen:
        ordered.append(t); seen.add(t)
print(f"Aligned tips with species table: {len(ordered)} (out of {len(all_tips)})")
assert len(ordered) == len(set(labels)), f"alignment failed: {len(ordered)} vs {len(set(labels))}"

idx_full = {t:i for i,t in enumerate(all_tips)}
ix = [idx_full[t] for t in ordered]
D = D_full[np.ix_(ix,ix)]
L = L_full[ix]
C0 = C_share_full[np.ix_(ix,ix)]

# Build species-level response
sp_df = pd.DataFrame(sp_rows).set_index("phylo.tip.label").loc[ordered].copy()
indi = pd.get_dummies(sp_df["intro.pathway"]).reindex(columns=["AgriForest","Gardening","Unintentional"], fill_value=0).astype(int)
print("Pathway indicator counts (species table, aligned):", indi.sum(axis=0).to_dict())

# Continuous predictors from species table
X_traits = sp_df[["mrt","native.niche.breadth","invaded.niche.breadth","habitat.range","height"]].astype(float).values

# ---------- PGLS core ----------
def C_lambda(C0, lam):
    return lam * C0 + (1 - lam) * np.diag(np.diag(C0))

def fit_pgls(y, X, C0):
    n = len(y)
    # Lambda grid search by maximizing ML (Gaussian) log-likelihood
    best = (-1e18, None, None, None)
    grid = np.r_[np.linspace(0, 1, 51), np.array([0.0])]  # ensure 0 in grid; will de-dup
    for lam in grid:
        V = C_lambda(C0, lam)
        Vinv = np.linalg.pinv(V)
        XtVinvX = X.T @ Vinv @ X
        XtVinvy = X.T @ Vinv @ y
        try:
            beta = np.linalg.solve(XtVinvX, XtVinvy)
            r = y - X @ beta
            rss = float(r @ Vinv @ r)
            if rss <= 0: continue
            sign, logdetV = np.linalg.slogdet(V)
            if sign <= 0: continue
            signX, logdetXVX = np.linalg.slogdet(XtVinvX)
            if signX <= 0: continue
            # Gaussian ML (proportional)
            ll = -0.5*(n*np.log(2*np.pi) + n*np.log(rss/n) + logdetV + logdetXVX)
        except np.linalg.LinAlgError:
            continue
        if ll > best[0]:
            best = (ll, float(lam), beta, V)
    ll, lam, beta, V = best
    # Wald test: cov(beta) = (X' V^{-1} X)^{-1} * sigma^2, sigma^2 = rss / n
    Vinv = np.linalg.pinv(V)
    XtVinvX = X.T @ Vinv @ X
    cov_beta = np.linalg.inv(XtVinvX) * (rss / len(y))
    se = np.sqrt(np.diag(cov_beta))
    z = beta / se
    from scipy.stats import norm
    p = 2*(1 - norm.cdf(np.abs(z)))
    return lam, beta, se, p, ll, rss

results = {}
for pw in ["Gardening","Unintentional","AgriForest"]:
    y = indi[pw].astype(float).values
    X = sm.add_constant(X_traits, has_constant="add")
    # OLS
    ols = sm.OLS(y, X).fit()
    # PGLS at lambda free
    lam, beta, se, pval, ll, rss = fit_pgls(y, X, C0)
    pgls_ll = ll
    # Compare to OLS (lambda=0)
    ols_factor_X = sm.regression.linear_model.OLS(y, X).fit()
    # compute LL for OLS as lambda=0
    V0 = C_lambda(C0, 0.0)
    Vinv = np.linalg.pinv(V0)
    XtVinvX = X.T @ Vinv @ X
    signV, logdetV = np.linalg.slogdet(V0)
    signX, logdetX = np.linalg.slogdet(XtVinvX)
    beta0 = np.linalg.solve(XtVinvX, X.T @ Vinv @ y)
    r0 = y - X @ beta0
    rss0 = float(r0 @ Vinv @ r0)
    n = len(y)
    ols_ll = -0.5*(n*np.log(2*np.pi) + n*np.log(rss0/n) + logdetV + logdetX)
    results[pw] = {
        "n_species": int(len(y)),
        "lambda_estimate": float(lam),
        "lambda_loglik": float(ll),
        "OLS_lambda0_loglik": float(ols_ll),
        "OLS_aic": float(ols.aic),
        "OLS_bic": float(ols.bic),
        "OLS": {"params": ols.params.tolist(), "bse": ols.bse.tolist(), "pvalues": ols.pvalues.tolist(),
                "rsq": float(ols.rsquared), "loglik": float(ols.llf)},
        "PGLS": {"params": beta.tolist(), "bse": se.tolist(), "pvalues": pval.tolist(),
                 "loglik": float(ll), "rss_pgls": float(rss)},
        "predictors": ["const","mrt","native.niche.breadth","invaded.niche.breadth","habitat.range","height"],
    }
    delta_ll = ll - ols_ll
    print(f"\nPathway {pw}: n={len(y)} λ*={lam:.3f}  Δloglik(λ*-λ=0)={delta_ll:+.2f}")
    print(f"  OLS r2={ols.rsquared:.3f}  loglik={ols.llf:.2f}")
    print(f"  PGLS loglik={ll:.2f}  rss={rss:.2f}")
    print(f"  OLS params: {dict(zip(['const','mrt','nb_nat','nb_inv','hab','height'], np.round(ols.params,3)))}")
    print(f"  PGLS params: {dict(zip(['const','mrt','nb_nat','nb_inv','hab','height'], np.round(beta,3)))}")

# Save
(RES/"pgls_species_traits.json").write_text(json.dumps(results, indent=2, ensure_ascii=False))
