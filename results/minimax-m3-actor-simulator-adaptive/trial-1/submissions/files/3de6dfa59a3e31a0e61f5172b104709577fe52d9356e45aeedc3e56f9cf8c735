# notebooks/02_temporal_chi2.py
# ============================================================
import numpy as np, json, csv
from collections import defaultdict
from pathlib import Path

RES = Path("results"); ART = Path("artifacts")
tt_matrix = {
    "Before 1500":  {"AgriForest": 55, "Gardening": 18, "Unintentional": 34},
    "1501-1900":    {"AgriForest": 36, "Gardening": 54, "Unintentional": 31},
    "1901-1984":    {"AgriForest": 38, "Gardening":142, "Unintentional":110},
    "1985-2019":    {"AgriForest": 32, "Gardening":397, "Unintentional": 99},
}
periods = list(tt_matrix.keys())
paths   = ["AgriForest","Gardening","Unintentional"]
O = np.array([[tt_matrix[p][w] for w in paths] for p in periods], dtype=float)

# Expected under independence
row_tot = O.sum(axis=1, keepdims=True)
col_tot = O.sum(axis=0, keepdims=True)
N       = O.sum()
E       = row_tot @ col_tot / N
chi2    = float(((O - E)**2 / E).sum())
df      = (O.shape[0]-1)*(O.shape[1]-1)
# statsmodels chi2.sf for p-value
from scipy.stats import chi2 as chi2dist
p_val = float(chi2dist.sf(chi2, df))

# standardized (Pearson) residuals: r_ij = (O - E) / sqrt(E * (1 - p_i.) * (1 - p_.j))
p_row = row_tot / N
p_col = col_tot / N
# Broadcasting: r_ij = (O - E) / sqrt(E_ij) then divide by sqrt((1-p_i.)*(1-p_.j))
pearson_resid = (O - E) / np.sqrt(E)
# Adjusted (Haberman-style) standardized residuals:
adj_resid = (O - E) / np.sqrt(E * (1 - p_row) * (1 - p_col))

print(f"Chi-square = {chi2:.2f}, df = {df}, p-value = {p_val:.3e}")
print(f"Cramér's V = {float(np.sqrt(chi2/(N*(min(O.shape)-1)))):.3f}")

print("\nObserved (O):")
print("Period            |", " | ".join(f"{w:>11}" for w in paths))
for i,p in enumerate(periods):
    print(f"{p:17s}|", " | ".join(f"{O[i,j]:>11.0f}" for j in range(3)))

print("\nExpected (E) under independence:")
for i,p in enumerate(periods):
    print(f"{p:17s}|", " | ".join(f"{E[i,j]:>11.2f}" for j in range(3)))

print("\nAdjusted standardized residuals (Haberman; |z|>~2 => driver):")
print("Period            |", " | ".join(f"{w:>13}" for w in paths))
for i,p in enumerate(periods):
    cells = " | ".join(f"{adj_resid[i,j]:>+13.2f}" for j in range(3))
    flag = " *" if np.any(np.abs(adj_resid[i])>2) else ""
    print(f"{p:17s}| {cells} {flag}")

print("\nCell-level contribution (O-E)^2/E (top contributors):")
contribs = (O - E)**2 / E
flat = sorted([(contribs[i,j], periods[i], paths[j], O[i,j], E[i,j]) for i in range(O.shape[0]) for j in range(O.shape[1])], reverse=True)
for c,p,w,o,e in flat[:6]:
    print(f"  {c:6.2f}  {p:11s} {w:13s}  O={o:.0f}  E={e:.2f}")

# Save
out = {
    "observed":O.tolist(), "expected":E.tolist(),
    "chi2":chi2,"df":df,"p_value":p_val,
    "cramers_V": float(np.sqrt(chi2/(N*(min(O.shape)-1)))),
    "periods":periods, "pathways":paths,
    "haberman_residuals": adj_resid.tolist(),
    "cell_contributions": [{"period":p,"pathway":w,"O":float(O[i,j]),"E":float(E[i,j]),"z_adj":float(adj_resid[i,j]),"chi2_contrib":float(contribs[i,j])}
                            for i,p in enumerate(periods) for j,w in enumerate(paths)],
}
(RES/"temporal_chi2.json").write_text(json.dumps(out, indent=2, ensure_ascii=False))


