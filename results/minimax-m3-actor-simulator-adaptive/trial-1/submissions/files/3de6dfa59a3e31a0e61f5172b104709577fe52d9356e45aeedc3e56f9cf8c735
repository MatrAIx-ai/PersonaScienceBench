import pickle, json
import numpy as np, pandas as pd
import statsmodels.api as sm
from statsmodels.genmod.generalized_linear_model import GLM
from statsmodels.genmod.families import Binomial
from statsmodels.genmod.families.links import Logit
from pathlib import Path
import warnings; warnings.filterwarnings("ignore")

RES = Path("results")
df_fit = pd.read_csv(RES/"long_format_fitted.csv")

def design_matrix(pathway):
    success_col = {"gard":"n.gard","unint":"n.unint","agfo":"n.agfo"}[pathway]
    work = df_fit.copy()
    work["y_events"] = work[success_col]
    X = work[["urban","cropland","elevation","annual.temperature","annual.rainfall",
              "annual.radiation","distance.road","distance.stream"]].copy()
    yd = pd.get_dummies(work["year_cat"].astype("category"), prefix="year", drop_first=True, dtype=float)
    bd = pd.get_dummies(work["buffer_cat"].astype("category"), prefix="buf", drop_first=True, dtype=float)
    X = pd.concat([X, yd, bd], axis=1)
    for col in yd.columns:
        X[f"urban_x_{col}"] = work["urban"] * yd[col]
    return X, work, yd, bd

def vif(X):
    """Compute VIF per column by regressing each on the rest."""
    rX = sm.add_constant(X).values
    out = {}
    cols = list(X.columns)
    for j, name in enumerate(cols):
        y_j = rX[:, j+1]  # excluding const
        others = np.delete(rX, j+1, axis=1)
        R2 = float(1 - sm.OLS(y_j, others).fit().ssr / ((y_j - y_j.mean())**2).sum())
        out[name] = {"VIF": 1/(1-R2) if R2<0.999 else float("inf"), "R2": R2}
    return pd.DataFrame(out).T

def fit_glm(pathway, X_full, work):
    y = work["y_events"]; trials = work["n.total"]
    X = sm.add_constant(X_full, has_constant="add")
    fit = GLM(endog=np.column_stack([y, trials-y]), exog=X,
              family=Binomial(Logit())).fit(scale="X2")
    return fit

results = {}
for pw in ["gard","unint","agfo"]:
    print(f"\n========= Pathway: {pw} =========")
    X_full, work, _yd, _bd = design_matrix(pw)
    fit = fit_glm(pw, X_full, work)
    # VIF on the linear predictor (use same X without interactions to compute gross multicollinearity among main effects)
    X_main = X_full[["urban","cropland","elevation","annual.temperature","annual.rainfall",
                     "annual.radiation","distance.road","distance.stream"]]
    v = vif(X_main).round(3)
    print("VIF (main effects only):")
    print(v)
    # Pearson dispersion
    disp = float((fit.resid_pearson**2).sum() / fit.df_resid)
    print(f"Pearson dispersion (scale): {disp:.3f} (>1.5 => over-dispersion)")
    # DFBETAS-like influential obs: top 5 absolute standardized Pearson residuals
    stdres = fit.resid_pearson / np.sqrt((1 - fit.fittedvalues)*fit.fittedvalues)  # Anscombe-ish
    # Simpler: standard residuals = sqrt(model.response) is bad; use Pearson
    pr = pd.Series(fit.resid_pearson, index=range(len(fit.resid_pearson)))
    print(f"Pearson residual stats: min={pr.min():+.3f}  max={pr.max():+.3f}  median={pr.median():+.3f}  q25={pr.quantile(.25):+.3f} q75={pr.quantile(.75):+.3f}")
    results[pw] = {
        "VIF_main":v.round(4).reset_index().rename(columns={"index":"term"}).to_dict(orient="records"),
        "pearson_dispersion": disp,
        "max_pearson_resid": float(pr.abs().max()),
        "n_outliers_3sigma": int((pr.abs()>3).sum()),
    }

(RES/"diagnostics.json").write_text(json.dumps(results, indent=2))
