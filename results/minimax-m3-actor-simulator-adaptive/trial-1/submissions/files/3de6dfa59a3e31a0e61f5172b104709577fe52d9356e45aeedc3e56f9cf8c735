import pickle, json, csv
import numpy as np, pandas as pd
from pathlib import Path
import statsmodels.api as sm
from statsmodels.genmod.generalized_linear_model import GLM
from statsmodels.genmod.families import Binomial
from statsmodels.genmod.families import Binomial as Bin
from statsmodels.genmod.families.links import Logit
import warnings
warnings.filterwarnings("ignore")

RES = Path("results"); ART = Path("artifacts")
with open(RES/"_raw.pkl","rb") as f:
    raw = pickle.load(f)
niche = raw["niche"]

YEARS = [1956, 1993, 2009]
BUFFERS = [50, 500, 1000]

# Long-format
rows = []
for r in niche:
    base = {
        "habitat": r["habitat"], "elevation": float(r["elevation"]),
        "distance.stream": float(r["distance.stream"]),
        "distance.road":   float(r["distance.road"]),
        "annual.temperature": float(r["annual.temperature"]),
        "annual.rainfall":    float(r["annual.rainfall"]),
        "annual.radiation":   float(r["annual.radiation"]),
        "longitude": float(r["longitude"]), "latitude": float(r["latitude"]),
        "n.gard": int(r["n.gard"]), "n.unint": int(r["n.unint"]),
        "n.agfo":  int(r["n.agfo"]),  "n.total": int(r["n.total"]),
    }
    for y in YEARS:
        for b in BUFFERS:
            urban    = float(r[f"urban.{y}.{b}m"])
            cropland = float(r[f"cropland.{y}.{b}m"])
            row = dict(base)
            row["year"] = y; row["buffer"] = b
            row["urban"] = urban; row["cropland"] = cropland
            row["urban_x_cropland"] = urban * cropland
            row["urban_centered"]   = urban - urban   # placeholder per y/b if needed
            rows.append(row)
df = pd.DataFrame(rows)
df["year_cat"] = pd.Categorical(df["year"], categories=YEARS, ordered=False)
df["buffer_cat"]= pd.Categorical(df["buffer"], categories=BUFFERS, ordered=False)
print(f"Long-format rows: {len(df)} (= 632 × 9 = 5688 expected)")
assert len(df) == 632*9

# Exclude rows with n.total==0 (cannot fit proportion regression on these rows)
df_fit = df[df["n.total"]>0].copy()
print(f"Rows with n.total>0 (used for modeling): {len(df_fit)} / {len(df)} = {100*len(df_fit)/len(df):.2f}%")

# Save the long files
df.to_csv(RES/"long_format_full.csv", index=False)
df_fit.to_csv(RES/"long_format_fitted.csv", index=False)

# -------- Fit per-pathway Binomial-logit GLMs (weighted by n.total) --------
def fit_pathway(pathway):
    """Fit a single Binomial-logit GLM for one pathway:
    - successes = n.<pathway>
    - failures  = n.total - n.<pathway>
    - weights   = n.total
    - predictors: urban + cropland + elevation + temperature + rainfall + radiation
                  + distance.road + distance.stream + year_cat + buffer_cat
                  + urban:year_cat (interaction)"""
    success_col = {"gard":"n.gard","unint":"n.unint","agfo":"n.agfo"}[pathway]
    work = df_fit.copy()
    work["y_events"] = work[success_col]
    work["y_trials"] = work["n.total"]
    # Full model
    formula_terms = ["urban","cropland","elevation","annual.temperature","annual.rainfall",
                     "annual.radiation","distance.road","distance.stream",
                     "C(year_cat)","C(buffer_cat)","urban:C(year_cat)"]
    # patsy-like manual design matrix
    X = work[["urban","cropland","elevation","annual.temperature","annual.rainfall",
              "annual.radiation","distance.road","distance.stream"]].copy()
    # one-hot year
    yd = pd.get_dummies(work["year_cat"], prefix="year", drop_first=True, dtype=float)
    bd = pd.get_dummies(work["buffer_cat"], prefix="buf", drop_first=True, dtype=float)
    X = pd.concat([X, yd, bd], axis=1)
    # urban × year interactions: urban * {year dummies not in reference}
    for col in yd.columns:
        X[f"urban_x_{col}"] = work["urban"] * yd[col]
    X = sm.add_constant(X, has_constant="add")
    y = work["y_events"]
    trials = work["y_trials"]
    glm = GLM(endog=np.column_stack([y, trials - y]), exog=X,
              family=Bin(link=Logit()))
    fit = glm.fit(scale="X2")  # Binomial OK
    # Per year × buffer: simple stratified refits to get main urban coefficient
    coefs_yb = {}
    for y_ in YEARS:
        for b_ in BUFFERS:
            sub = work[(work["year"]==y_)&(work["buffer"]==b_)].copy()
            if len(sub)==0: continue
            Xs = sub[["urban","cropland","elevation","annual.temperature","annual.rainfall",
                      "annual.radiation","distance.road","distance.stream"]].copy()
            Xs = sm.add_constant(Xs, has_constant="add")
            ys = sub["y_events"]; ts = sub["y_trials"]
            f = GLM(endog=np.column_stack([ys, ts-ys]), exog=Xs, family=Bin(Logit())).fit(scale="X2")
            coefs_yb[f"y{y_}_b{b_}"] = {
                "n_sites": int(len(sub)),
                "beta_urban": float(f.params["urban"]),
                "se_urban":   float(f.bse["urban"]),
                "z_urban":    float(f.tvalues["urban"]),
                "p_urban":    float(f.pvalues["urban"]),
                "ci_lo":      float(f.conf_int().loc["urban",0]),
                "ci_hi":      float(f.conf_int().loc["urban",1]),
            }
    return fit, coefs_yb

results_per_path = {}
for pw in ["gard","unint","agfo"]:
    print(f"\n========== Fitting pathway: {pw} (n_obs={len(df_fit)}) ==========")
    fit, yb = fit_pathway(pw)
    print(f"Deviance: {fit.deviance:.2f} | Pearson chi2: {fit.pearson_chi2:.2f} | df: {fit.df_resid}")
    # print urban coefficient across the full model
    full = pd.DataFrame({"beta":fit.params,"se":fit.bse,"z":fit.tvalues,"p":fit.pvalues,
                         "ci_lo":fit.conf_int()[0],"ci_hi":fit.conf_int()[1]})
    keep = [c for c in full.index if "urban" in c or c in ("const","cropland","elevation",
                "annual.temperature","annual.rainfall","annual.radiation","distance.road","distance.stream")]
    print("Full-model coefficients (urban-related + main effects):")
    print(full.loc[keep].round(4))
    results_per_path[pw] = {
        "n_obs_full": int(len(df_fit)),
        "deviance": float(fit.deviance),
        "pearson_chi2": float(fit.pearson_chi2),
        "df_resid": int(fit.df_resid),
        "aic": float(fit.aic),
        "bic": float(fit.bic),
        "coef_table": full.round(6).reset_index().rename(columns={"index":"term"}).to_dict(orient="records"),
        "coef_per_year_buffer": yb,
    }
    print("\nUrban coefficient per (year, buffer):")
    for k,v in yb.items():
        print(f"  {k}: n={v['n_sites']:3d}  b={v['beta_urban']:+.3f}  se={v['se_urban']:.3f}  z={v['z_urban']:+.2f}  p={v['p_urban']:.4f}  CI=[{v['ci_lo']:+.3f},{v['ci_hi']:+.3f}]")

(RES/"model_glm_pathways.json").write_text(json.dumps(results_per_path, indent=2))
print("\nSaved -> results/model_glm_pathways.json")


