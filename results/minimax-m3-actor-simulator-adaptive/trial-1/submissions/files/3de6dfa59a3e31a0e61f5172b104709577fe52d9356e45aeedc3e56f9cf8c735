import json, pickle
import numpy as np, pandas as pd
import statsmodels.api as sm
from statsmodels.genmod.generalized_linear_model import GLM
from statsmodels.genmod.families import Binomial
from statsmodels.genmod.families.links import Logit
from pathlib import Path
import warnings; warnings.filterwarnings("ignore")

RES = Path("results"); ART = Path("artifacts")
df_fit = pd.read_csv(RES/"long_format_fitted.csv")

def fit_glm(pathway, drop_elevation=False):
    success_col = {"gard":"n.gard","unint":"n.unint","agfo":"n.agfo"}[pathway]
    work = df_fit.copy()
    work["y_events"] = work[success_col]
    cols = ["urban","cropland","annual.temperature","annual.rainfall","annual.radiation",
            "distance.road","distance.stream"]
    if not drop_elevation:
        cols.insert(2, "elevation")
    X = work[cols].copy()
    yd = pd.get_dummies(work["year_cat"].astype("category"), prefix="year", drop_first=True, dtype=float)
    bd = pd.get_dummies(work["buffer_cat"].astype("category"), prefix="buf", drop_first=True, dtype=float)
    X = pd.concat([X, yd, bd], axis=1)
    for col in yd.columns:
        X[f"urban_x_{col}"] = work["urban"] * yd[col]
    X = sm.add_constant(X, has_constant="add")
    y = work["y_events"]; trials = work["n.total"]
    fit = GLM(endog=np.column_stack([y, trials-y]), exog=X,
              family=Binomial(Logit())).fit(scale="X2")
    return fit, X, work

def partial_eta2(fit, X_var, X_full, work_full, pathway):
    """Wald chi2 drop test for one predictor using the dispersion-corrected test.
       Equivalent to testing whether the predictor contributes to the linear predictor."""
    # We can directly use the Wald statistic already in fit (z^2) for binomial GLM,
    # but with dispersion scale=X2, the chi2 is z^2 * dispersion_to_scale.
    # Simpler: refit data without X_var, compare deviances.
    full = fit
    full_dev = full.deviance
    full_df  = full.df_resid
    # Drop X_var
    X_red = X_full.drop(columns=[X_var])
    y = work_full["y_events"]; trials = work_full["n.total"]
    red = GLM(endog=np.column_stack([y, trials-y]), exog=X_red,
              family=Binomial(Logit())).fit(scale="X2")
    chi2_drop = (red.deviance - full_dev)
    df_drop = red.df_resid - full_df
    from scipy.stats import chi2 as chi2dist
    p = float(chi2dist.sf(max(chi2_drop,0), df_drop))
    eta2 = max(0.0, (full_dev - red.deviance)) / (full_dev + (work_full["y_events"].shape[0] - full_df - 1))
    return float(eta2), p

# Refit without elevation; also fit "logit-OLS with epsilon" sensitivity per user instruction
epsilon = 1.0/(2*df_fit["n.total"].sum())  # sum of n.total is total observation mass
print(f"epsilon used for logit-OLS: {epsilon:.6g}")

results_robust = {}
for pw in ["gard","unint","agfo"]:
    print(f"\n============ Pathway: {pw} ============")
    fit_full, X_full, work = fit_glm(pw, drop_elevation=False)
    fit_noE, X_noE,    workE = fit_glm(pw, drop_elevation=True)
    # urban coefficient + SE in both
    for label, fit in [("full", fit_full), ("no_elevation", fit_noE)]:
        coef = float(fit.params["urban"]); se = float(fit.bse["urban"])
        z = float(fit.tvalues["urban"]); p = float(fit.pvalues["urban"])
        print(f"  [{label:13s}] β_urban={coef:+.3f}  SE={se:.3f}  z={z:+.2f}  p={p:.4g}")
    # partial eta^2 for urban
    eta2_u, p_u = partial_eta2(fit_full, "urban", X_full, work, pw)
    print(f"  partial-eta2(urban) = {eta2_u:.4f}, Wald p={p_u:.4g}")
    results_robust[pw] = {
        "beta_urban_full": float(fit_full.params["urban"]),
        "se_urban_full":   float(fit_full.bse["urban"]),
        "z_urban_full":    float(fit_full.tvalues["urban"]),
        "p_urban_full":    float(fit_full.pvalues["urban"]),
        "beta_urban_noE":  float(fit_noE.params["urban"]),
        "se_urban_noE":    float(fit_noE.bse["urban"]),
        "z_urban_noE":     float(fit_noE.tvalues["urban"]),
        "p_urban_noE":     float(fit_noE.pvalues["urban"]),
        "partial_eta2_urban": eta2_u,
        "p_drop_urban": p_u,
        "cropland_full": float(fit_full.params["cropland"]),
        "cropland_p_full": float(fit_full.pvalues["cropland"]),
    }

# Sensitivity: logit-OLS per (pathway, year, buffer) with epsilon to compress 0/1
print("\n=== Sensitivity: logit-OLS with epsilon =", epsilon, "===")
sens = {}
for pw in ["gard","unint","agfo"]:
    sens[pw] = {}
    for y_ in [1956,1993,2009]:
        for b in [50,500,1000]:
            sub = df_fit[(df_fit["year"]==y_)&(df_fit["buffer"]==b)].copy()
            if len(sub)==0: continue
            success_col = {"gard":"n.gard","unint":"n.unint","agfo":"n.agfo"}[pw]
            sub["p"] = sub[success_col] / sub["n.total"]
            sub["logit_p"] = np.log((sub["p"] + epsilon) / (1 - sub["p"] + epsilon))
            cols = ["urban","cropland","annual.temperature","annual.rainfall","annual.radiation",
                    "distance.road","distance.stream"]
            Xs = sm.add_constant(sub[cols], has_constant="add")
            f = sm.OLS(sub["logit_p"], Xs).fit()
            sens[pw][f"y{y_}_b{b}"] = {
                "n": int(len(sub)),
                "beta_urban": float(f.params["urban"]),
                "se_urban":   float(f.bse["urban"]),
                "t_urban":    float(f.tvalues["urban"]),
                "p_urban":    float(f.pvalues["urban"]),
                "ci_lo":      float(f.conf_int().loc["urban",0]),
                "ci_hi":      float(f.conf_int().loc["urban",1]),
            }
            print(f"  {pw} y{y_}_b{b}: b={f.params['urban']:+.3f}  SE={f.bse['urban']:.3f}  t={f.tvalues['urban']:+.2f}  p={f.pvalues['urban']:.4g}")

# Combine
robust_obj = {
    "epsilon_logit_OLS": float(epsilon),
    "robustness_vif_drop_elevation": results_robust,
    "logit_OLS_sensitivity": sens,
}
(RES/"robustness_summary.json").write_text(json.dumps(robust_obj, indent=2))
print("\nSaved -> results/robustness_summary.json")

# Also aggregate the existing model result + robustness into one master JSON
master = json.load(open(RES/"model_glm_pathways.json"))
master_sens = json.load(open(RES/"robustness_summary.json"))
m = master.copy()
m.update(master_sens)
(RES/"master_models.json").write_text(json.dumps(m, indent=2))
print("Saved -> results/master_models.json")


