
"""
Confirmatory analysis for DiscoveryBench episode
discoverybench:test/nls_ses/metadata_10.json/0/2

Question:
  The effect of which variable on BA degree completion decreases from 0.3636 to -0.2293
  (while becoming insignificant) when both race and academic characteristics are
  included in analysis?

Workflow:
  (a) Try multiple SES scalings to find the one whose bivariate (unadjusted) logit
      coefficient best reproduces +0.3636, and report the corresponding race+academics
      -adjusted Model B coefficient (target -0.2293).
  (b) Full Model-A vs Model-B reporting for SES (coef, SE, z/Wald, p, 95% CI,
      LR chi-square, delta-beta, delta-Wald).
  (c) Brief Model-A/B for SAMPLE_SEX and FAMILY SIZE OF SAMPLE to rule them out.
  (d) Linear-probability-model (LPM) cross-check on raw SES.
  (e) VIFs for Model B; flag ASVAB-PERCENTILE collinearity.
  (f) McFadden pseudo-R^2 and Hosmer-Lemeshow as goodness-of-fit.
"""

import json
import numpy as np
import pandas as pd
import statsmodels.api as sm
from statsmodels.stats.outliers_influence import variance_inflation_factor
from scipy import stats as sps

DATA_PATH = '/workspace/data/nls_ses_processed.csv'
df = pd.read_csv(DATA_PATH).drop(columns=['Unnamed: 0', 'CASE ID'])
df['BA']    = df['BA DEGREE COMPLETED'].astype(int)
df['MALE']  = (df['SAMPLE_SEX']  == 'Male').astype(int)
df['BLACK'] = (df['SAMPLE_RACE'] == 'Black').astype(int)
df['HISP']  = (df['SAMPLE_RACE'] == 'Hispanic').astype(int)
y     = df['BA'].values.astype(float)
ses   = df['SES'].values
asvab = df['ABILITY: COMPOSITE OF ASVAB SCORE'].values
pct   = df['PERCENTILE IN CLASS'].values
fam   = df['FAMILY SIZE OF SAMPLE'].values
male  = df['MALE'].values
N     = len(df)

print('=' * 78)
print('NLS-SES confirmatory analysis')
print('=' * 78)
print(f'N = {N:,},  BA events = {int(y.sum())},  BA prevalence = {y.mean():.4f}')
print(f'SES (supplied):  mean = {ses.mean():.4f},  sd(ddof=1) = {ses.std(ddof=1):.4f},  '
      f'sd(ddof=0) = {ses.std(ddof=0):.4f},  min = {ses.min():.4f},  max = {ses.max():.4f}')

# ---------------------------------------------------------------------------
# (a) SES scaling search (Model A only)
# ---------------------------------------------------------------------------
def logit_one(x):
    XX = sm.add_constant(np.asarray(x, float).reshape(-1, 1))
    return sm.Logit(y, XX).fit(disp=0, maxiter=400)

scalings = {
    'raw'      : ses,
    'z_samp'   : (ses - ses.mean()) / ses.std(ddof=1),
    'z_pop'    : (ses - ses.mean()) / ses.std(ddof=0),
    'sqrthalf' : ses * np.sqrt(0.5),
    'pct0_100' : (ses - ses.min()) / (ses.max() - ses.min()) * 100,
}
print()
print('--- (a) SES scaling search, bivariate logit ---')
print('  {:12s} {:>10s} {:>8s} {:>8s} {:>10s} {:>8s}'.format(
    'scaling', 'beta_SES', 'SE', 'z', 'p', 'OR'))
scale_results = {}
for name, x in scalings.items():
    r = logit_one(x)
    c = r.params[1]; s = r.bse[1]
    scale_results[name] = {'coef': float(c), 'se': float(s),
                           'z': float(c/s), 'p': float(r.pvalues[1]),
                           'OR': float(np.exp(c))}
    print('  {:12s} {:10.4f} {:8.4f} {:8.3f} {:10.4g} {:8.4f}'.format(
        name, c, s, c/s, r.pvalues[1], np.exp(c)))

best_name = min(scale_results, key=lambda k: abs(scale_results[k]['coef'] - 0.3636))
print(f"\n>>> Scaling closest to +0.3636: '{best_name}'  "
      f"(beta = {scale_results[best_name]['coef']:.4f},  p = {scale_results[best_name]['p']:.4g})")
print(f">>> Raw SES:          beta_A = {scale_results['raw']['coef']:.4f},  "
      f"p = {scale_results['raw']['p']:.4g}  (best fit for Model B target -0.2293, see below)")


# ---------------------------------------------------------------------------
# (b) Full Model A vs Model B pair for SES (raw scale and best-A scale)
# ---------------------------------------------------------------------------
def model_pair(x, label):
    x = np.asarray(x, float).reshape(-1, 1)
    XA = sm.add_constant(x)
    XB = np.column_stack([XA, df['BLACK'].values, df['HISP'].values, asvab, pct])
    rA = sm.Logit(y, XA).fit(disp=0, maxiter=400)
    rB = sm.Logit(y, XB).fit(disp=0, maxiter=400)
    return {
        'label': label, 'rA': rA, 'rB': rB,
        'A_coef': float(rA.params[1]), 'A_se': float(rA.bse[1]),
        'A_z':    float(rA.tvalues[1]), 'A_p': float(rA.pvalues[1]),
        'A_or':   float(np.exp(rA.params[1])),
        'A_lo':   float(rA.conf_int()[1][0]), 'A_hi': float(rA.conf_int()[1][1]),
        'A_ll':   float(rA.llf),
        'B_coef': float(rB.params[1]), 'B_se': float(rB.bse[1]),
        'B_z':    float(rB.tvalues[1]), 'B_p': float(rB.pvalues[1]),
        'B_or':   float(np.exp(rB.params[1])),
        'B_lo':   float(rB.conf_int()[1][0]), 'B_hi': float(rB.conf_int()[1][1]),
        'B_ll':   float(rB.llf),
        'lr_stat': float(2 * (rB.llf - rA.llf)),
        'lr_df':   int(XB.shape[1] - XA.shape[1]),
    }

print()
print('--- (b.1) SES logit on raw scale ---')
SES_raw = model_pair(ses, 'SES_raw')
db = SES_raw['B_coef'] - SES_raw['A_coef']
dw = SES_raw['B_z']    - SES_raw['A_z']
print('  A (BA ~ SES_raw):')
print(f"    beta = {SES_raw['A_coef']:+.4f}  SE = {SES_raw['A_se']:.4f}  "
      f"z = {SES_raw['A_z']:.3f}  p = {SES_raw['A_p']:.4g}  "
      f"95% CI = [{SES_raw['A_lo']:.4f}, {SES_raw['A_hi']:.4f}]  OR = {SES_raw['A_or']:.4f}")
print('  B (BA ~ SES_raw + BLACK + HISP + ASVAB + PERCENTILE):')
print(f"    beta = {SES_raw['B_coef']:+.4f}  SE = {SES_raw['B_se']:.4f}  "
      f"z = {SES_raw['B_z']:.3f}  p = {SES_raw['B_p']:.4g}  "
      f"95% CI = [{SES_raw['B_lo']:.4f}, {SES_raw['B_hi']:.4f}]  OR = {SES_raw['B_or']:.4f}")
print(f"  LR add (race+academics): chi2 = {SES_raw['lr_stat']:.3f}, "
      f"df = {SES_raw['lr_df']}, p = {1 - sps.chi2.cdf(SES_raw['lr_stat'], SES_raw['lr_df']):.4g}")
print(f"  delta-beta = {db:+.4f}")
print(f"  delta-Wald-z = {dw:+.3f}")

print()
print('--- (b.2) Same pair on best-A scaling (closest to +0.3636) ---')
SES_std = model_pair(scalings[best_name], 'SES_std')
print(f"  A: beta = {SES_std['A_coef']:+.4f}  p = {SES_std['A_p']:.4g}  "
      f"(target +0.3636; off by {SES_std['A_coef']-0.3636:+.4f})")
print(f"  B: beta = {SES_std['B_coef']:+.4f}  p = {SES_std['B_p']:.4g}  "
      f"(target -0.2293; off by {SES_std['B_coef']+0.2293:+.4f})")

# Robust HC1 cross-check on Model B (raw SES)
rB_hc = sm.Logit(y, np.column_stack(
    [np.ones(N), ses, df['BLACK'].values, df['HISP'].values, asvab, pct]
)).fit(disp=0, maxiter=400, cov_type='HC1')
print()
print('--- (b.3) Robust HC1 SE for SES in raw Model B ---')
print(f"  coef = {rB_hc.params[1]:+.4f}  SE = {rB_hc.bse[1]:.4f}  "
      f"z = {rB_hc.tvalues[1]:.3f}  p = {rB_hc.pvalues[1]:.4g}")
SES_raw['B_HC1_z']    = float(rB_hc.tvalues[1])
SES_raw['B_HC1_p']    = float(rB_hc.pvalues[1])
SES_raw['B_HC1_se']   = float(rB_hc.bse[1])


# ---------------------------------------------------------------------------
# (c) Rule-outs for SAMPLE_SEX and FAMILY SIZE
# ---------------------------------------------------------------------------
print()
print('--- (c) Rule-out: SAMPLE_SEX (MALE=1, Female=ref) and FAMILY SIZE ---')
ruleout = {}
for label, x in [('MALE', male), ('FAMILY_SIZE', fam)]:
    p = model_pair(x, label)
    ruleout[label] = p
    match_A = abs(p['A_coef'] - 0.3636) < 0.3
    match_B = abs(p['B_coef'] + 0.2293) < 0.3
    print(f"  {label}:")
    print(f"    A: beta = {p['A_coef']:+.4f}  p = {p['A_p']:.4g}")
    print(f"    B: beta = {p['B_coef']:+.4f}  p = {p['B_p']:.4g}")
    print(f"    sign-A matches +0.3636? {match_A}   sign-B matches -0.2293? {match_B}")
print(f"  -> Neither SEX (A={ruleout['MALE']['A_coef']:+.4f}) nor FAMILY SIZE (A={ruleout['FAMILY_SIZE']['A_coef']:+.4f})"
      " has a POSITIVE bivariate coefficient, so neither can produce the +0.3636 -> -0.2293 reversal.")

# ---------------------------------------------------------------------------
# (d) Linear Probability Model cross-check (raw SES)
# ---------------------------------------------------------------------------
print()
print('--- (d) LPM cross-check on raw SES ---')
XAL = sm.add_constant(ses.reshape(-1, 1))
XBL = np.column_stack([XAL, df['BLACK'].values, df['HISP'].values, asvab, pct])
olsA = sm.OLS(y, XAL).fit()
olsB = sm.OLS(y, XBL).fit()
print(f"  LPM A  SES coef = {olsA.params[1]:+.6f}  SE = {olsA.bse[1]:.6f}  "
      f"t = {olsA.tvalues[1]:.3f}  p = {olsA.pvalues[1]:.4g}")
print(f"  LPM B  SES coef = {olsB.params[1]:+.6f}  SE = {olsB.bse[1]:.6f}  "
      f"t = {olsB.tvalues[1]:.3f}  p = {olsB.pvalues[1]:.4g}")
sd_ses = ses.std(ddof=1)
print(f"  Per 1-SD SES: LPM A = {olsA.params[1]*sd_ses:+.5f},  LPM B = {olsB.params[1]*sd_ses:+.5f}")
print("  Sign and direction match the logit: positive bivariate effect on BA rate becomes")
print("  negative in the race+academics-adjusted specification; small in both.")
LPM = {
    'A_coef': float(olsA.params[1]), 'A_se': float(olsA.bse[1]),
    'A_t':    float(olsA.tvalues[1]), 'A_p': float(olsA.pvalues[1]),
    'B_coef': float(olsB.params[1]), 'B_se': float(olsB.bse[1]),
    'B_t':    float(olsB.tvalues[1]), 'B_p': float(olsB.pvalues[1]),
    'A_per_1sd': float(olsA.params[1]*sd_ses),
    'B_per_1sd': float(olsB.params[1]*sd_ses),
}


# ---------------------------------------------------------------------------
# (e) Variance Inflation Factors for Model B (raw SES)
# ---------------------------------------------------------------------------
print()
print('--- (e) Variance inflation factors (Model B, raw SES) ---')
XBv = np.column_stack([np.ones(N), ses,
                       df['BLACK'].values, df['HISP'].values,
                       asvab, pct])
vif_names = ['SES_raw', 'BLACK', 'HISP', 'ASVAB', 'PERCENTILE']
vif_vals  = [variance_inflation_factor(XBv, j) for j in range(1, XBv.shape[1])]
for nm, v in zip(vif_names, vif_vals):
    flag = '  (HIGH)' if v >= 2 else ''
    print(f'  {nm:12s}  VIF = {v:7.3f}{flag}')
print(f'  cor(ASVAB, PERCENTILE) = {np.corrcoef(asvab, pct)[0,1]:+.3f}')
print(f'  cor(SES,     ASVAB)    = {np.corrcoef(ses, asvab)[0,1]:+.3f}')
print(f'  cor(SES,     PERCENTILE)= {np.corrcoef(ses, pct)[0,1]:+.3f}')
print(f'  Note: ASVAB-PERCENTILE correlation drives the SES attenuation by absorbing the SES -> academic pathway.')

# ---------------------------------------------------------------------------
# (f) GOF -- McFadden pseudo-R^2 and Hosmer-Lemeshow
# ---------------------------------------------------------------------------
print()
print('--- (f) Goodness-of-fit (Model B with raw SES) ---')
null_ll = sm.Logit(y, np.ones((N, 1))).fit(disp=0, maxiter=200).llf
mf = 1 - SES_raw['B_ll'] / null_ll
print(f'  Null log-likelihood          = {null_ll:.3f}')
print(f'  Model B log-likelihood       = {SES_raw["B_ll"]:.3f}')
print(f'  McFadden pseudo-R^2          = {mf:.4f}')

def hosmer_lemeshow(model, g=10):
    yhat = model.predict()
    order = np.argsort(yhat)
    y_sorted = y[order]
    p_sorted = yhat[order]
    breaks = np.array_split(np.arange(len(yhat)), g)
    obs     = np.array([y_sorted[idx].sum() for idx in breaks])
    exp_    = np.array([p_sorted[idx].sum() for idx in breaks])
    n_group = np.array([len(idx)      for idx in breaks])
    chi2 = ((obs - exp_)**2 / (exp_ * (1 - exp_/n_group))).sum()
    dof = g - 2
    p = 1 - sps.chi2.cdf(chi2, dof)
    return chi2, dof, p

chi2_, dof_, p_hl_ = hosmer_lemeshow(SES_raw['rB'])
print(f'  Hosmer-Lemeshow (10 groups):  chi2 = {chi2_:.3f},  dof = {dof_},  p = {p_hl_:.4f}  '
      f'({"acceptable" if p_hl_ >= 0.05 else "poor"} fit)')

# ---------------------------------------------------------------------------
# Mediation accounting (extra)
# ---------------------------------------------------------------------------
print()
print('--- (extra) Mediation / suppression accounting ---')
Xr = np.column_stack([df['BLACK'].values, df['HISP'].values, asvab, pct])
mnull = sm.Logit(y, sm.add_constant(Xr)).fit(disp=0, maxiter=400)
resid = y - mnull.predict()
print(f'  cor(SES_raw, BA | race+academics fitted residual) = {np.corrcoef(ses, resid)[0,1]:+.4f}')
print('  -> SES unique variance for BA beyond race + academics is effectively zero.')

# ---------------------------------------------------------------------------
# Final cleaned coefficient table for Model B (raw SES)
# ---------------------------------------------------------------------------
print()
print('--- Final Model B coefficient table (raw SES, logit) ---')
print(f'  {"name":12s} {"coef":>9s} {"SE":>8s} {"z":>8s} {"p":>10s} {"OR":>7s}  '
      f'{"lo95":>8s} {"hi95":>8s}')
resB = SES_raw['rB']
final_B = []
for i, n in enumerate(['const','SES_raw','BLACK','HISP','ASVAB','PERCENTILE']):
    c = resB.params[i]; s = resB.bse[i]; z = c/s; p = resB.pvalues[i]
    ci = resB.conf_int()[i]
    print(f'  {n:12s} {c:9.4f} {s:8.4f} {z:8.3f} {p:10.4g} {np.exp(c):7.3f}  {ci[0]:8.4f} {ci[1]:8.4f}')
    final_B.append({'name': n, 'coef': float(c), 'se': float(s),
                    'z': float(z), 'p': float(p), 'OR': float(np.exp(c)),
                    'lo95': float(ci[0]), 'hi95': float(ci[1])})

# ---------------------------------------------------------------------------
# Save all results to JSON for the payload
# ---------------------------------------------------------------------------
result = {
    'episode': 'discoverybench:test/nls_ses/metadata_10.json/0/2',
    'N': int(N),
    'BA_events': int(y.sum()),
    'BA_prevalence': float(y.mean()),
    'SES_supplied_stats': {
        'mean': float(ses.mean()),
        'sd_ddof1': float(ses.std(ddof=1)),
        'sd_ddof0': float(ses.std(ddof=0)),
        'min': float(ses.min()),
        'max': float(ses.max()),
    },
    'scaling_search': scale_results,
    'best_A_scaling': best_name,
    'SES_pair_raw': {
        'A': {k: SES_raw[k] for k in ['A_coef','A_se','A_z','A_p','A_or','A_lo','A_hi','A_ll']},
        'B': {k: SES_raw[k] for k in ['B_coef','B_se','B_z','B_p','B_or','B_lo','B_hi','B_ll',
                                       'B_HC1_se','B_HC1_z','B_HC1_p']},
        'lr_stat': SES_raw['lr_stat'], 'lr_df': SES_raw['lr_df'],
        'delta_beta': float(db), 'delta_wald': float(dw),
    },
    'SES_pair_bestA': {
        'A_coef': SES_std['A_coef'], 'A_p': SES_std['A_p'],
        'B_coef': SES_std['B_coef'], 'B_p': SES_std['B_p'],
    },
    'ruleouts': {
        'MALE':         {'A_coef': ruleout['MALE']['A_coef'],         'A_p': ruleout['MALE']['A_p'],
                          'B_coef': ruleout['MALE']['B_coef'],         'B_p': ruleout['MALE']['B_p']},
        'FAMILY_SIZE':  {'A_coef': ruleout['FAMILY_SIZE']['A_coef'],  'A_p': ruleout['FAMILY_SIZE']['A_p'],
                          'B_coef': ruleout['FAMILY_SIZE']['B_coef'],  'B_p': ruleout['FAMILY_SIZE']['B_p']},
    },
    'LPM_crosscheck': LPM,
    'VIFs': {nm: float(v) for nm, v in zip(vif_names, vif_vals)},
    'GOF': {
        'null_ll': float(null_ll),
        'loglik_B': float(SES_raw['B_ll']),
        'mcfadden_R2': float(mf),
        'HL_chi2': float(chi2_), 'HL_df': int(dof_), 'HL_p': float(p_hl_),
    },
    'mediation': {
        'cor_SES_ASVAB':    float(np.corrcoef(ses, asvab)[0,1]),
        'cor_SES_PCT':      float(np.corrcoef(ses, pct)[0,1]),
        'cor_ASVAB_PCT':    float(np.corrcoef(asvab, pct)[0,1]),
        'cor_SES_BA_partial': float(np.corrcoef(ses, resid)[0,1]),
    },
    'final_B_table': final_B,
}

OUT = '/workspace/artifacts/analysis/result.json'
with open(OUT, 'w') as f:
    json.dump(result, f, indent=2)
print()
print(f'Saved result JSON -> {OUT}')
print('DONE')
