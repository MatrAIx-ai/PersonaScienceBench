"""
analysis.py — Q9 elicitation-technique shares across normalisations,
plus bootstrap 95% CIs (10 000 resamples, fixed seed).

Inputs : data/requirements_engineering_for_ML-enabled_systems.csv
Outputs: artifacts/q9_value_counts.csv
         artifacts/q9_shares_by_denominator.csv
         artifacts/q9_normalisation_master.csv
         artifacts/boot_*.npy
         artifacts/summary.json
"""
from pathlib import Path
import json
import numpy as np
import pandas as pd

DATA = Path("data/requirements_engineering_for_ML-enabled_systems.csv")
OUT  = Path("artifacts"); OUT.mkdir(parents=True, exist_ok=True)
SEED = 42; NBOOT = 10_000

Q9 = [
    "Q9_ML_Elicitation_Interviews",
    "Q9_ML_Elicitation_Scenarios",
    "Q9_ML_Elicitation_Prototyping",
    "Q9_ML_Elicitation_Workshops_Meetings",
    "Q9_ML_Elicitation_Observation",
    "Q9_ML_Elicitation_Others",
]
SHORT = ["Interviews","Scenarios","Prototyping","Workshops_Meetings","Observation","Others"]
OK = ["Completed (31)", "Completed after break (32)"]

def main():
    df = pd.read_csv(DATA)

    # ---------- A) Q9 value_counts (incl. hidden categories) ----------
    vc_rows = []
    for c in Q9 + ["Q9_ML_Elicitation_Others_Free"]:
        s = df[c].astype(object).where(df[c].notna(), "<<NaN>>").astype(str)
        for v, k in s.value_counts(dropna=False).items():
            vc_rows.append({"column": c, "value": v, "count": int(k)})
    pd.DataFrame(vc_rows).to_csv(OUT/"q9_value_counts.csv", index=False)

    # ---------- B) Denominator sweep ----------
    reached = (~df[Q9].astype(str).eq("-77").all(axis=1))
    masks = {
        "all_276":              df.index,
        "completed_188":        df.index[df["Status"].isin(OK)],
        "reached_Q9_194":       df.index[reached],
        "completed_or_reached_194": df.index[df["Status"].isin(OK) | reached],
    }
    tables = []
    for name, idx in masks.items():
        sub = df.loc[idx]; n = len(sub)
        rows = []
        for c in Q9:
            ss = sub[c].astype(str)
            q = (ss == "quoted").sum()
            rows.append([c.split("Q9_ML_Elicitation_")[-1], q, n, q/n*100])
        tables.append(pd.DataFrame(rows, columns=["technique",
            f"quoted_{name}", f"n_{name}", f"pct_{name}"]).set_index("technique"))
    master_den = pd.concat(tables, axis=1)
    master_den.to_csv(OUT/"q9_shares_by_denominator.csv")

    # ---------- C) Completed-only normalisations ----------
    dfc = df[df["Status"].isin(OK)].copy().reset_index(drop=True)
    quoted = (dfc[Q9].astype(str) == "quoted").astype(int)
    n_c = len(dfc)

    D7_raw = dfc["D7_Total_ML_Projects"].astype(float).values
    D7 = np.where(D7_raw == -99, np.nan, D7_raw)
    D7_mask = ~np.isnan(D7); D7_w = D7[D7_mask]
    n_d7 = int(D7_mask.sum())

    rng = np.random.default_rng(SEED)
    boot_raw = np.zeros((NBOOT, 6))
    boot_d7  = np.zeros((NBOOT, 6))
    boot_cit = np.zeros((NBOOT, 6))
    boot_eff = np.zeros((NBOOT, 6))

    cits_any = quoted.values.sum(axis=1) > 0
    quoted_eff = quoted.values[cits_any]; n_eff = int(cits_any.sum())

    for b in range(NBOOT):
        idx_c  = rng.integers(0, n_c, size=n_c)
        boot_raw[b] = quoted.values[idx_c].sum(axis=0) / n_c * 100

        idx_d = rng.integers(0, n_d7, size=n_d7)
        bw, bs = D7_w[idx_d], quoted.values[D7_mask][idx_d]
        boot_d7[b] = (bw[:, None] * bs).sum(axis=0) / bw.sum() * 100

        s = quoted.values[idx_c].sum(axis=0)
        boot_cit[b] = s / s.sum() * 100

        idx_e = rng.integers(0, n_eff, size=n_eff)
        boot_eff[b] = quoted_eff[idx_e].mean(axis=0) * 100

    # point estimates per normalisation
    pe_raw = quoted.values.sum(axis=0) / n_c * 100
    pe_d7  = (D7_w[:, None] * quoted.values[D7_mask]).sum(axis=0) / D7_w.sum() * 100
    pe_cit = quoted.values.sum(axis=0) / quoted.values.sum() * 100
    pe_eff = quoted_eff.mean(axis=0) * 100

    def ci(mat):
        return (mat.mean(0), np.percentile(mat, 2.5, axis=0), np.percentile(mat, 97.5, axis=0))
    m_raw, lo_raw, hi_raw = ci(boot_raw)
    m_d7,  lo_d7,  hi_d7  = ci(boot_d7)
    m_cit, lo_cit, hi_cit = ci(boot_cit)
    m_eff, lo_eff, hi_eff = ci(boot_eff)

    master = pd.DataFrame({
        "technique": SHORT,
        "(i) raw %": pe_raw.round(4),
        "(i) boot mean %": m_raw.round(4),
        "(i) 95% CI lo": lo_raw.round(4),
        "(i) 95% CI hi": hi_raw.round(4),
        "(ii) D7-wgt %": pe_d7.round(4),
        "(ii) boot mean %": m_d7.round(4),
        "(ii) 95% CI lo": lo_d7.round(4),
        "(ii) 95% CI hi": hi_d7.round(4),
        "(iii) cite-share %": pe_cit.round(4),
        "(iii) boot mean %": m_cit.round(4),
        "(iii) 95% CI lo": lo_cit.round(4),
        "(iii) 95% CI hi": hi_cit.round(4),
        "(iv) atleast-1 %": pe_eff.round(4),
        "(iv) boot mean %": m_eff.round(4),
        "(iv) 95% CI lo": lo_eff.round(4),
        "(iv) 95% CI hi": hi_eff.round(4),
    })
    master.to_csv(OUT/"q9_normalisation_master.csv", index=False)

    np.save(OUT/"boot_raw.npy", boot_raw)
    np.save(OUT/"boot_d7.npy",  boot_d7)
    np.save(OUT/"boot_cit.npy", boot_cit)
    np.save(OUT/"boot_eff.npy", boot_eff)

    # ---------- D) Diagnostic: implied n_eff for the target CI half-width ----------
    p  = 0.69399
    hw = (69.735 - 69.062) / 2 / 100   # convert pp → proportion
    n_eff_cip_target = 1.96**2 * p * (1-p) / hw**2

    leader = {
        "(i) raw / 188 completed": "Interviews",
        "(ii) D7-weighted": "Interviews",
        "(iii) share-of-citations": "Interviews",
        "(iv) atleast-1 quoted (n_eff=171)": "Interviews",
    }

    summary = {
        "n_total_respondents": int(len(df)),
        "n_completed": int(df["Status"].isin(OK).sum()),
        "n_reached_Q9": int(reached.sum()),
        "n_D7_nonmissing_completed": n_d7,
        "sum_D7_completed_nonmissing": float(D7_w.sum()),
        "Q9_has_ordinal_scale": False,
        "Q9_unique_non_sentinel_values": ["quoted", "not quoted", "-77"],
        "leader_per_normalisation": leader,
        "closest_normalisation_to_target_69p399pct": {
            "normalisation": "(ii) D7-weighted share",
            "technique": "Interviews",
            "point_estimate_%": float(round(pe_d7[0], 4)),
            "bootstrap_mean_%": float(round(m_d7[0], 4)),
            "ci95_lo_%": float(round(lo_d7[0], 4)),
            "ci95_hi_%": float(round(hi_d7[0], 4)),
            "half_width_pp": float(round((hi_d7[0]-lo_d7[0])/2, 4)),
            "distance_pp": float(round(pe_d7[0] - 69.399, 4)),
        },
        "n_eff_implied_by_target_CI_binomial": float(round(n_eff_cip_target, 1)),
        "target_CI_half_width_pp": float(round((69.735-69.062)/2, 4)),
        "flag": ("The question's stated 95% CI [69.062, 69.735] implies n_eff ≈ "
                 f"{n_eff_cip_target:,.0f} if it were a simple binomial-respondent bootstrap. "
                 "Our effective n ranges 171–188 — the 69.399% figure does NOT drop out of any "
                 "clean normalisation applied to this dataset."),
    }
    with open(OUT/"summary.json", "w") as f:
        json.dump(summary, f, indent=2)

    # Console summary
    print(f"Completed: {n_c}; reached Q9: {int(reached.sum())}; D7 non-missing: {n_d7}; atleast-1: {n_eff}")
    print(f"\nLeader per normalisation: {leader}")
    i_int = SHORT.index("Interviews")
    print(f"\nInterviews summary (closest to 69.399% target):")
    print(f"  (i) raw      : {pe_raw[i_int]:.4f}% [boot {m_raw[i_int]:.4f}%, 95% CI {lo_raw[i_int]:.4f}–{hi_raw[i_int]:.4f}]")
    print(f"  (ii) D7-wgt  : {pe_d7[i_int]:.4f}% [boot {m_d7[i_int]:.4f}%, 95% CI {lo_d7[i_int]:.4f}–{hi_d7[i_int]:.4f}]")
    print(f"  (iii) cite-sh: {pe_cit[i_int]:.4f}% [boot {m_cit[i_int]:.4f}%, 95% CI {lo_cit[i_int]:.4f}–{hi_cit[i_int]:.4f}]")
    print(f"  (iv) atleast1: {pe_eff[i_int]:.4f}% [boot {m_eff[i_int]:.4f}%, 95% CI {lo_eff[i_int]:.4f}–{hi_eff[i_int]:.4f}]")
    print(f"\nTarget 69.399% with CI [69.062, 69.735] (HW {(69.735-69.062)/2:.3f}pp) → implied n_eff ≈ {n_eff_cip_target:,.0f}")
    print("Saved artefacts to artifacts/")

if __name__ == "__main__":
    main()
