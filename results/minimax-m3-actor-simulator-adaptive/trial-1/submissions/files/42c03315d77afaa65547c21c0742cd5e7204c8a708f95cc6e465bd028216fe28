"""
Archaeology Symbolic Capital Analysis
======================================
Question (DiscoveryBench, episode discoverybench:test/archaeology/metadata_23.json/0/0):
"Between 3400 BCE to 3000 BCE, how does the number of monuments and axes changes
 with elements of symbolic capital?"

Design (post-approach_review):
  window      : CE in [-3400, -3000]   (BCE 3400 -> 3000)
  predictors  : HatchetSword, Dagger, HouseSize (Z values, _inter variants + _ff robustness)
  outcomes    : MonumentCount (Monuments), AxesCelts (Axes & Celts)   (Z values)
  metrics     : Pearson r, Spearman rho, OLS slope (with p + CI95)      (no first-diff)
  layers      :
      A) linearly interpolated _inter series, n = 401 yearly points
      B) forward-filled (100-year bin staircase) using century-anchors,
         n = 401 yearly points but only 5 distinct values

Cross-check on capital.csv (100-year, 5 rows) is reported numerically for the
same six cells but is NOT used as the inference layer (n=5 -> power too low).
"""
from __future__ import annotations
import json, os, math, sys
import numpy as np
import pandas as pd
from scipy import stats

ROOT   = "/workspace"
OUT    = os.path.join(ROOT, "artifacts", "analysis")
os.makedirs(OUT, exist_ok=True)

# ---------------------------------------------------------------------------
# 1. Load all three CSVs (capital.csv and pollen.csv use comma decimals)
# ---------------------------------------------------------------------------
ts  = pd.read_csv(os.path.join(ROOT, "data", "time_series_data.csv"), index_col=0)
cap = pd.read_csv(os.path.join(ROOT, "data", "capital.csv"),        decimal=",")
pol = pd.read_csv(os.path.join(ROOT, "data",
        "pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv"), decimal=",", index_col=0)

# ---------------------------------------------------------------------------
# 2. Align time axes.  time_series              uses CE (BCE x -1)
#                     capital                  uses BCE (positive)
#                     pollen_openness...       uses CE (BCE x -1)
# ---------------------------------------------------------------------------
cap = cap.rename(columns={"BCE": "CE_signed"})
cap["CE"] = -cap["CE_signed"]

# ---------------------------------------------------------------------------
# 3. Slice to the window  CE in [-3400, -3000]
# ---------------------------------------------------------------------------
WIN_LO, WIN_HI = -3400, -3000
ts_w  = ts [(ts ["CE"] >= WIN_LO) & (ts ["CE"] <= WIN_HI)].copy().sort_values("CE").reset_index(drop=True)
cap_w = cap[(cap["CE"] >= WIN_LO) & (cap["CE"] <= WIN_HI)].copy().sort_values("CE").reset_index(drop=True)
pol_w = pol[(pol["CE"] >= WIN_LO) & (pol["CE"] <= WIN_HI)].copy().sort_values("CE").reset_index(drop=True)

assert len(ts_w) == 401, len(ts_w)
assert len(cap_w) == 5, len(cap_w)
assert len(pol_w) == 401, len(pol_w)

# ---------------------------------------------------------------------------
# 4. Layer B: forward-fill (100-year bin staircase) on the _inter series
#    Within bin [CE_anchor, CE_anchor+100) every year holds the value
#    observed at CE_anchor.
# ---------------------------------------------------------------------------
ANCHORS = [-3400, -3300, -3200, -3100, -3000]    # 5 century turn points
PRED    = ["HatchetSword", "Dagger", "HouseSize"]
OUTC    = ["MonumentCount", "AxesCelts"]
COLS    = [f"{c}_inter" for c in PRED + OUTC]

def forward_fill_window(df_win: pd.DataFrame, col_inter: str, anchors: list[int]) -> np.ndarray:
    """Within the CE window, every year in [a, a+100) inherits the value at CE=a."""
    by_ce = df_win.set_index("CE")[col_inter]
    out   = np.empty(len(df_win), dtype=float)
    ces   = df_win["CE"].values
    for i, a in enumerate(anchors):
        lo = a
        hi = anchors[i + 1] if i + 1 < len(anchors) else a + 100  # final bin clipped at window edge
        mask = (ces >= lo) & (ces < hi)
        out[mask] = by_ce.loc[a]
    return out

ff = pd.DataFrame(index=range(len(ts_w)))
for c in COLS:
    ff[c] = forward_fill_window(ts_w, c, ANCHORS)

# ---------------------------------------------------------------------------
# 5. Regression cell helper
# ---------------------------------------------------------------------------
def _unpack(res):
    """Normalize scipy result -> (statistic, pvalue) for old/new APIs."""
    try:
        return float(res.statistic), float(res.pvalue)
    except AttributeError:
        return float(res[0]), float(res[1])

def cell(out: np.ndarray, pred: np.ndarray) -> dict:
    """Return Pearson r, Spearman rho, OLS slope — all with p and CI95.
    Constant predictor / outcome -> NaN stats with std_pred / std_out annotated.
    """
    n    = len(out)
    sd_p = float(np.std(pred, ddof=1))
    sd_o = float(np.std(out , ddof=1))
    rec  = dict(n=n, pearson_r=float("nan"), pearson_p=float("nan"),
                spearman_rho=float("nan"), spearman_p=float("nan"),
                ols_slope=float("nan"), ols_pvalue=float("nan"),
                ci_lo=float("nan"), ci_hi=float("nan"),
                std_pred=sd_p, std_out=sd_o, constant_input=False)
    if sd_p == 0.0 or sd_o == 0.0:
        rec["constant_input"] = True
        return rec
    try:
        pr_r, pr_p = _unpack(stats.pearsonr(pred, out))
    except Exception:
        pr_r, pr_p = float("nan"), float("nan")
    try:
        sp_r, sp_p = _unpack(stats.spearmanr(pred, out))
    except Exception:
        sp_r, sp_p = float("nan"), float("nan")
    try:
        ols      = stats.linregress(pred, out)
        beta, se = float(ols.slope), float(ols.stderr)
    except Exception:
        beta, se = float("nan"), float("nan")
    tcrit = stats.t.ppf(0.975, df=max(n - 2, 1))
    rec.update(
        pearson_r=pr_r, pearson_p=pr_p,
        spearman_rho=sp_r, spearman_p=sp_p,
        ols_slope=beta, ols_pvalue=(float(ols.pvalue) if not math.isnan(beta) else float("nan")),
        ci_lo=(beta - tcrit * se) if not math.isnan(beta) else float("nan"),
        ci_hi=(beta + tcrit * se) if not math.isnan(beta) else float("nan"),
    )
    return rec

# ---------------------------------------------------------------------------
# 6. Build the six cells on three datasets:
#       layer A: ts_w  _inter        (linearly interpolated, 401 pts)
#       layer B: ff                 (forward-filled staircase, 401 pts / 5 unique)
#       cap   : cap_w (centennial)  (5 pts, low power)
# ---------------------------------------------------------------------------
def run_layer(df: pd.DataFrame, label: str) -> pd.DataFrame:
    rows = []
    for o in OUTC:
        for p in PRED:
            d = cell(df[f"{o}_inter"].values, df[f"{p}_inter"].values)
            d.update(layer=label, outcome=o, predictor=p)
            rows.append(d)
    return pd.DataFrame(rows)

# Layer A
A = run_layer(ts_w, "A:linear_interp_n401")
# Layer B (NOTE: ff dataframe has same column names, no _inter suffix because the
# forward-fill values themselves live in ff under PRED/OUTC; we still use the
# same _inter convention for downstream symmetry by aliasing)
ff_named = ff.rename(columns={c: c for c in ff.columns})
B = run_layer(ff_named, "B:forward_fill_n401")
# capital.csv
C = run_layer(cap_w.rename(columns={
    "ZAxtSchwert": "HatchetSword_inter",
    "ZDolch"     : "Dagger_inter",
    "Zhausgr"    : "HouseSize_inter",
    "ZMonument"  : "MonumentCount_inter",
    "ZBeil"      : "AxesCelts_inter",
}), "C:capital_century_n5")

ALL = pd.concat([A, B, C], ignore_index=True)
ALL.to_csv(os.path.join(OUT, "regression_grid.csv"), index=False)

# ---------------------------------------------------------------------------
# 7. Qualitative magnitude bin
# ---------------------------------------------------------------------------
def bin_mag(x: float) -> str:
    ax = abs(x)
    if ax >= 0.50: return "strong"
    if ax >= 0.30: return "moderate"
    if ax >= 0.10: return "weak"
    return "negligible"

def synthesise(layer_name: str, sub: pd.DataFrame) -> dict:
    """Sign + magnitude; tie-break Spearman when Pearson and OLS slope disagree."""
    out = {}
    for o in OUTC:
        for p in PRED:
            r = sub[(sub.outcome == o) & (sub.predictor == p)].iloc[0]
            pr_sign      = np.sign(r.pearson_r)
            sp_sign      = np.sign(r.spearman_rho)
            ols_sign     = np.sign(r.ols_slope)
            # agreement logic: disagreement when Pearson sign != OLS slope sign
            pe_ols_agree = (pr_sign == ols_sign) or (r.pearson_r == 0) or (r.ols_slope == 0)
            if pe_ols_agree:
                final_sign = pr_sign if pr_sign != 0 else sp_sign
                tiebreak   = "n/a"
            else:
                # Pearson and OLS slope disagree -> Spearman wins
                final_sign = sp_sign
                tiebreak   = "spearman_over_pearson"
            final_mag   = bin_mag(r.spearman_rho if tiebreak == "spearman_over_pearson" else r.pearson_r)
            label = ("positive" if final_sign > 0 else
                     "negative" if final_sign < 0 else "no association")
            out[(p, o)] = dict(
                r      = r.pearson_r,
                rho    = r.spearman_rho,
                beta   = r.ols_slope,
                p_pe   = r.pearson_p,
                p_sp   = r.spearman_p,
                p_ols  = r.ols_pvalue,
                ci     = (r.ci_lo, r.ci_hi),
                sign   = label,
                mag    = final_mag,
                tiebrk = tiebreak,
            )
    return out

synA = synthesise("A", A)
synB = synthesise("B", B)
synC = synthesise("C", C)

# ---------------------------------------------------------------------------
# 8. Print the summary tables (verbatim, for the handoff)
# ---------------------------------------------------------------------------
def fmt(x, p=4):
    if x is None or (isinstance(x, float) and (math.isnan(x) or math.isinf(x))):
        return "  n/a "
    if isinstance(x, float):
        return f"{x:{p}.{p}f}"
    return str(x)

def print_layer(layer_letter: str, sub: pd.DataFrame, syn: dict):
    print(f"\n=== LAYER {layer_letter} ===")
    print(f"{'outcome':<14}{'predictor':<14}{'n':>5}{'r':>9}{'p_r':>10}{'rho':>9}{'p_rho':>10}{'beta':>9}{'p_b':>10}{'sign':>12}{'mag':>11}")
    print("-" * 110)
    for o in OUTC:
        for p in PRED:
            r = sub[(sub.outcome == o) & (sub.predictor == p)].iloc[0]
            s = syn[(p, o)]
            print(f"{o:<14}{p:<14}{r['n']:>5d}{fmt(r.pearson_r):>9}{fmt(r.pearson_p,3):>10}"
                  f"{fmt(r.spearman_rho):>9}{fmt(r.spearman_p,3):>10}"
                  f"{fmt(r.ols_slope):>9}{fmt(r.ols_pvalue,3):>10}"
                  f"{s['sign']:>12}{s['mag']:>11}")
    print("-" * 110)

print("\n############ REGRESSION GRID — six cells x three layers ############")
print("(Symbolic-capital predictors -> Monuments and Axes & Celts, 3400-3000 BCE)\n")
print_layer("A  linear-interp  time_series _inter   (n=401)", A, synA)
print_layer("B  forward-fill   100y-bin staircase   (n=401, 5 unique values)", B, synB)
print_layer("C  capital.csv    centennial anchors   (n=5,  illustrative)",  C, synC)

# ---------------------------------------------------------------------------
# 9. Sanity: verify the lookup tables at 3400 BCE match across files
# ---------------------------------------------------------------------------
print("\n--- SANITY CHECK at CE = -3400 across files ---")
print("time_series _inter :", ts_w.iloc[0][COLS].to_dict())
print("forward-fill       :", ff.iloc[0][COLS].to_dict())
CAP_MAP = {"HatchetSword":"ZAxtSchwert", "Dagger":"ZDolch",
             "HouseSize":"Zhausgr",  "MonumentCount":"ZMonument",
             "AxesCelts":"ZBeil"}
cap_print = {k+"_inter": cap_w.iloc[0][v] for k, v in CAP_MAP.items()}
print("capital.csv        :", cap_print)
print()

# ---------------------------------------------------------------------------
# 10. Capital.csv 100-year values shown (handy for the narrative)
# ---------------------------------------------------------------------------
print("--- capital.csv centennial table inside the window ---")
print(cap_w[["CE", "ZAxtSchwert", "ZDolch", "Zhausgr", "ZMonument", "ZBeil"]].to_string(index=False))
print()

# ---------------------------------------------------------------------------
# 11. Persist a machine-readable synthesis
# ---------------------------------------------------------------------------
def _to_jsonable(d):
    out = {}
    for (pred, outc), v in d.items():
        out.setdefault(outc, {})[pred] = v
    return out

synth = {"layer_A_interp": _to_jsonable(synA),
         "layer_B_ffill" : _to_jsonable(synB),
         "layer_C_capital": _to_jsonable(synC)}
with open(os.path.join(OUT, "synthesis.json"), "w") as f:
    json.dump(synth, f, indent=2, default=float)
print("Saved:", os.path.join(OUT, "regression_grid.csv"))
print("Saved:", os.path.join(OUT, "synthesis.json"))
