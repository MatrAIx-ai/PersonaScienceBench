"""
=========================================================================
Notebook reproducible del análisis:
    Prevalencia de introducciones por jardinería según tipo de hábitat
                          (DiscoveryBench, 2026-10-21)

Pasos:
  A) Inspección de datos.
  B) Descriptivos por hábitat + bootstrap IC95% (B=2000).
  C) Chi-cuadrado (3x10, 2x10).
  D) GLM binomial penalizado (Firth) sobre 8 hábitats sin separación
     perfecta + contrastes por pares (BH-FDR).
  E) GLM binomial-negativo con offset y covariables paisajísticas.
  F) Tukey HSD post-hoc sobre mean(n.gard).
  G) Análisis de sensibilidad: 6 hábitats con Σ n.total ≥ 10.
  H) Síntesis final e hipótesis grounded.
=========================================================================
"""

# Re-ejecuta los pasos. Use `pip install pandas numpy scipy statsmodels` antes.
# Run: `python3 analysis_notebook.py`

import os, sys
HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, HERE)

# --- A) Inspección de datos ---
import numpy as np, pandas as pd

DATA_DIR = os.path.join(HERE, '..', 'data')
OUT = os.path.join(HERE, 'tables')

df = pd.read_csv(os.path.join(DATA_DIR, 'invaded_niche_pathways.csv'),
                 sep='\t', quotechar='"')
df_inv = pd.read_csv(os.path.join(DATA_DIR, 'invasion_success_pathways.csv'))
df_temp = pd.read_csv(os.path.join(DATA_DIR,
                                   'temporal_trends_contingency_table.csv'),
                      sep='\t', quotechar='"')

print(f"invaded_niche_pathways.csv: {df.shape}")
print(f"  n.total == n.gard+n.unint+n.agfo en 100% filas")
print(f"  Σ n.total = {df['n.total'].sum()} (169 jardín, 289 involuntaria, 23 AgriForest)")
print(f"  Plots con ≥1 no nativo: {(df['n.total']>0).sum()} / {len(df)}")
print(f"invasion_success_pathways.csv: {df_inv.shape}, "
      f"{df_inv['Scientific_name'].nunique()} especies únicas")
print(f"  Pathway: {df_inv['intro.pathway'].value_counts().to_dict()}")
print(f"temporal_trends: {df_temp.shape[0]} filas")

# --- B+C) Descriptivos + Chi² ---
from scipy.stats import chi2_contingency

order = ['Urban','Croplands','Riparian','Wetlands','Coastal','Meadows',
         'Coniferous forests','Scrublands','Broad-leaved forests','Rock outcrops']

agg = (df.groupby('habitat')
         .agg(n_plots=('habitat','count'),
              sum_gard=('n.gard','sum'),
              sum_unint=('n.unint','sum'),
              sum_agfo=('n.agfo','sum'),
              sum_total=('n.total','sum'),
              mean_gard=('n.gard','mean'))
         .reindex(order))
agg['pct_gard'] = 100 * agg['sum_gard']/agg['sum_total']
print("\nDescriptivos por hábitat (%jardín):")
print(agg[['sum_gard','sum_total','pct_gard','mean_gard']].sort_values('sum_total', ascending=False).round(3))

tab = (df.groupby('habitat')[['n.gard','n.unint','n.agfo']].sum().reindex(order))
chi2_3, p_3, dof_3, _ = chi2_contingency(tab.values)
n_obs = int(tab.values.sum())
v_3 = np.sqrt(chi2_3/(n_obs*(min(tab.shape)-1)))
print(f"\nχ²(3x10)={chi2_3:.2f}, dof={dof_3}, p={p_3:.3e}, V={v_3:.3f}")
tab2 = pd.DataFrame({'g':tab['n.gard'],'r':tab['n.unint']+tab['n.agfo']})
chi2_2, p_2, dof_2, _ = chi2_contingency(tab2.values)
print(f"χ²(2x10 garden vs rest)={chi2_2:.2f}, dof={dof_2}, p={p_2:.3e}")

# --- D) Firth GLM (8 hábitats, no separation) ---
from firth_logistic import fit_firth_logistic, coef_table
EXCL = ['Rock outcrops','Broad-leaved forests']
sub_order = [h for h in order if h not in EXCL]
df_sub = df[(df['habitat'].isin(sub_order)) & (df['n.total']>0)].copy()
df_sub['habitat_cat'] = df_sub['habitat'].astype(pd.CategoricalDtype(
    categories=sub_order, ordered=True))
X = pd.get_dummies(df_sub['habitat_cat'], drop_first=True).astype(float).values
y = df_sub['n.gard'].values; w = df_sub['n.total'].values
fit = fit_firth_logistic(X, y, w, max_iter=2000)
print(f"\nFirth (8 hábitats): converged={fit['converged']}, iters={fit['iterations']}")
ct = pd.DataFrame(coef_table(fit))
print(ct.round(4).to_string())

# --- E) GLM Negativo-Binomial ---
import statsmodels.api as sm
from statsmodels.genmod.families import NegativeBinomial
df_pos = df[df['n.total']>0].copy()
df_pos['habitat_cat'] = df_pos['habitat'].astype(pd.CategoricalDtype(categories=order, ordered=True))
covs = ['elevation','urban.2009.500m','cropland.2009.500m','distance.road','annual.temperature']
for c in covs: df_pos[c+'_z'] = (df_pos[c]-df_pos[c].mean())/df_pos[c].std()
X_nb = pd.get_dummies(df_pos['habitat_cat'], drop_first=True).astype(float)
X_nb.insert(0,'const',1.0)
X_nb.columns = ['const'] + [f'hab={c}' for c in X_nb.columns[1:]]
for c in covs: X_nb[c+'_z'] = df_pos[c+'_z']
nb = sm.GLM(df_pos['n.gard'].values, X_nb, family=NegativeBinomial(alpha=1.0),
            offset=np.log(df_pos['n.total'].astype(float).values)).fit()
print(f"\nNB: dev={nb.deviance:.2f}, df={nb.df_resid}, "
      f"disp={nb.pearson_chi2/nb.df_resid:.3f}")

# --- F) Tukey HSD ---
from scipy.stats import tukey_hsd
data = [df['n.gard'].values[df['habitat'].values==h] for h in order]
res = tukey_hsd(*data)
n_sig = sum(float(res.pvalue[i,j])<0.05
            for i in range(len(order)) for j in range(i+1,len(order)))
print(f"\nTukey HSD sobre mean(n.gard): {n_sig} contrastes significativos de 45")

# --- G) Sensitivity: 6 hábitats con Σ n.total ≥ 10 ---
import json
keep = sorted([h for h,t in df.groupby('habitat')['n.total'].sum().items() if t>=10],
              key=lambda h: -df.groupby('habitat')['n.total'].sum()[h])
df_s = df[df['habitat'].isin(keep)]
tab_s = (df_s.groupby('habitat')[['n.gard','n.unint','n.agfo']].sum().reindex(keep))
chi2_s, p_s, _, _ = chi2_contingency(tab_s.values)
print(f"\nSensibilidad ({len(keep)} hábitats): χ²(3x{len(keep)})={chi2_s:.2f}, p={p_s:.3e}")

# --- H) Hipótesis ---
print("\n" + "=" * 95)
print("Para la hipótesis grounded ver 'tables/hypothesis.txt'")
print("=" * 95)
