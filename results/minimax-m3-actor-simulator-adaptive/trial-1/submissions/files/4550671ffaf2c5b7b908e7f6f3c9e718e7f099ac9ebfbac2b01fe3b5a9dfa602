import pandas as pd, numpy as np
import statsmodels.api as sm
from scipy import stats

df_in = pd.read_csv("/workspace/data/invaded_niche_pathways.csv", sep="\t")
df_in.columns = [c.strip().strip('"').strip() for c in df_in.columns]
for c in df_in.columns:
    if df_in[c].dtype==object:
        df_in[c]=df_in[c].astype(str).str.strip().str.strip('"').str.strip()
        try: df_in[c]=pd.to_numeric(df_in[c])
        except: pass

# Standardize predictors
def zscore(s):
    return (s-s.mean())/s.std(ddof=0)

# === Logistic regression: indicator each pathway > 0, all 632 rows ===
df_in[['urban_z','crop_z','elev_z','temp_z','road_z']] = df_in[['urban.2009.500m',
    'cropland.2009.500m','elevation','annual.temperature','distance.road']].apply(zscore)
X_full = sm.add_constant(df_in[['urban_z','crop_z','elev_z','temp_z','road_z']])

print("=== Logistic regression: logit Pr(n.pathway > 0) at plot level (n=632), standardized predictors ===")
logit_full = {}
for k in ['gard','unint','agfo']:
    y = (df_in[f'n.{k}']>0).astype(float)
    fit = sm.GLM(y, X_full, family=sm.families.Binomial()).fit()
    s = fit.params
    bse = fit.bse
    ci = fit.conf_int()
    r2 = 1 - fit.deviance/fit.null_deviance
    print(f"\n[{k}] pseudo-R2={r2:.3f}  observations={int(fit.nobs)}")
    for nm in ['urban_z','crop_z','elev_z','temp_z','road_z']:
        lo,hi = ci.loc[nm].tolist()
        print(f"  {nm:10s}  coef={s[nm]:+.3f}  SE={bse[nm]:.3f}  95%CI=[{lo:+.3f},{hi:+.3f}]")
    logit_full[k] = {nm:float(s[nm]) for nm in ['urban_z','crop_z','elev_z','temp_z','road_z']}

# === Quasibinomial on active rows for composition (fix scaling) ===
active = df_in[df_in['n.total']>0].copy().reset_index(drop=True)
active[['urban_z','crop_z','elev_z','temp_z','road_z']] = active[['urban.2009.500m',
    'cropland.2009.500m','elevation','annual.temperature','distance.road']].apply(zscore)
Xact = sm.add_constant(active[['urban_z','crop_z']])
print("\n=== Composition robustness: quasibinomial logit Pr(k|total) on active rows (n=191), standardized urban+crop ===")
qbin = {}
for k in ['gard','unint','agfo']:
    y = active[f'n.{k}'].astype(float)
    ntot = active['n.total'].astype(float)
    fit = sm.GLM(y, Xact, family=sm.families.Binomial(), freq_weights=ntot).fit()
    s = fit.params; bse = fit.bse; ci = fit.conf_int()
    print(f"\n[{k}] total species modeled={int(ntot.sum())}, deviance={fit.deviance:.2f}")
    for nm in ['urban_z','crop_z']:
        lo,hi = ci.loc[nm].tolist()
        print(f"  {nm:10s}  coef={s[nm]:+.3f}  SE={bse[nm]:.3f}  95%CI=[{lo:+.3f},{hi:+.3f}]")
    qbin[k] = {nm:float(s[nm]) for nm in ['urban_z','crop_z']}

# === Median split: high vs low urban strata, median pathway count ===
print("\n=== Median split: urban.2009.500m, pathway medians in low vs high urban strata ===")
median_u = df_in['urban.2009.500m'].median()
for label, sub in [('low', df_in[df_in['urban.2009.500m']<=median_u]),
                    ('high', df_in[df_in['urban.2009.500m']> median_u])]:
    print(f"\n  Stratum urban.2009.500m = {label}  (n_rows={len(sub)}, "
          f"mean urban={sub['urban.2009.500m'].mean():.3f})")
    for k in ['gard','unint','agfo','total']:
        s = sub[f'n.{k}']
        print(f"    median n.{k:6s}={s.median():.0f}, mean={s.mean():.2f}, "
              f"# rows with n.{k}>0: {(s>0).sum()}")
    # Mann-Whitney U
    for k in ['gard','unint','agfo']:
        low  = df_in.loc[df_in['urban.2009.500m']<=median_u, f'n.{k}']
        high = df_in.loc[df_in['urban.2009.500m']> median_u, f'n.{k}']
        u, p_ = stats.mannwhitneyu(low, high, alternative='two-sided')
        print(f"    MWU n.{k}: U={u:.0f}")

print("\nDone.")
