"""
Demographic disparities in 1985 composite wealth among NLSY79 respondents
who were ever jailed between 1985 and 1994.

Study frame:
    Population of interest : respondents with ever_jailed == 1 (n=289).
    Outcome                : composite_wealth_1985 (USD; sum of 5 NLSY79 wealth
                             components; debt-inclusive, hence negative values
                             are kept).
    Demographic cuts       : race (3 levels), sex (2 levels), race x sex (6 cells).
                             Race label "hipanic" in the source CSV is a known
                             typo and is normalised to "hispanic".
    Inference              : Wilcoxon rank-sum / Kruskal-Wallis (robust to skew
                             and ties at 0) + Quantile regression at q = 0.5
                             as corroboration.

This script is fully reproducible: `python3 analysis/nls_incarceration_disparities.py`.
"""

from __future__ import annotations

import json
import warnings
from pathlib import Path

import numpy as np
import pandas as pd
import statsmodels.api as sm
import statsmodels.formula.api as smf
from scipy import stats

warnings.simplefilter("ignore", FutureWarning)

DATA_PATH = Path("data/nls_incarceration_processed.csv")
OUT_DIR = Path("analysis/output")
OUT_DIR.mkdir(parents=True, exist_ok=True)

WEALTH = "composite_wealth_1985"

# ---------------------------------------------------------------------------
# 1. Load + clean
# ---------------------------------------------------------------------------
df = pd.read_csv(DATA_PATH)

# Document and fix the typo in race labels.
raw_race_labels = sorted(df["race"].dropna().unique().tolist())
df["race"] = df["race"].replace({"hipanic": "hispanic"})
print(f"[clean] raw race labels in source CSV : {raw_race_labels}")
print(f"[clean] renamed 'hipanic' -> 'hispanic' (typographical error in source).")
print()

print(f"[load] shape = {df.shape[0]} rows x {df.shape[1]} cols")
print(f"[load] missing values per column:\n{df.isna().sum().to_string()}\n")

# ---------------------------------------------------------------------------
# 2. Helper for cell-level summary
# ---------------------------------------------------------------------------
ORDER_RACE = ["white", "black", "hispanic"]
ORDER_SEX = ["male", "female"]


def cell_summary(d: pd.DataFrame, label: str) -> pd.DataFrame:
    out = (
        d.groupby(["race", "sex"]) if {"race", "sex"}.issubset(d.columns)
        else d.groupby(d.columns[:-1].tolist())
    )
    grp = (
        d.groupby(["race", "sex"])[WEALTH]
        .agg(
            n="count",
            median="median",
            q25=lambda x: x.quantile(0.25),
            q75=lambda x: x.quantile(0.75),
            pct_negative=lambda x: float((x < 0).mean() * 100),
        )
        .reset_index()
    )
    grp["iqr"] = grp["q75"] - grp["q25"]
    grp["small_cell"] = grp["n"].le(20)
    grp["cohort"] = label
    return grp.reindex(
        columns=[
            "cohort", "race", "sex", "n",
            "median", "q25", "q75", "iqr",
            "pct_negative", "small_cell",
        ]
    )


def one_dim_table(d: pd.DataFrame, by: str, label: str) -> pd.DataFrame:
    grp = (
        d.groupby(by)[WEALTH]
        .agg(
            n="count",
            median="median",
            q25=lambda x: x.quantile(0.25),
            q75=lambda x: x.quantile(0.75),
            pct_negative=lambda x: float((x < 0).mean() * 100),
        )
        .reset_index()
    )
    grp["iqr"] = grp["q75"] - grp["q25"]
    grp["cohort"] = label
    grp = grp.set_index(by)
    if by == "race":
        grp = grp.reindex(ORDER_RACE)
    else:
        grp = grp.reindex(ORDER_SEX)
    return grp.reset_index()


def order_table(t: pd.DataFrame, by: str) -> pd.DataFrame:
    if by == "race":
        return t.set_index("race").reindex(ORDER_RACE).reset_index()
    if by == "sex":
        return t.set_index("sex").reindex(ORDER_SEX).reset_index()
    keys = [(r, s) for r in ORDER_RACE for s in ORDER_SEX]
    return (
        t.set_index(["race", "sex"])
        .reindex(keys)
        .reset_index()
    )


# ---------------------------------------------------------------------------
# 3. Cohort selection
# ---------------------------------------------------------------------------
ever = df[df["ever_jailed"] == 1].copy()
never = df[df["ever_jailed"] == 0].copy()
print(f"[cohort] ever_jailed=1 : n = {len(ever)}")
print(f"[cohort] ever_jailed=0 : n = {len(never)}")
print(f"[cohort] race x sex within ever_jailed=1:")
print(pd.crosstab(ever["race"], ever["sex"]).reindex(index=ORDER_RACE, columns=ORDER_SEX))
print()

# ---------------------------------------------------------------------------
# 4. Headline demographics: RACE and SEX (primary), RACE x SEX (supplementary)
# ---------------------------------------------------------------------------
race_ever = one_dim_table(ever, "race", "ever_jailed=1")
sex_ever = one_dim_table(ever, "sex", "ever_jailed=1")
race_sex_ever = cell_summary(ever, "ever_jailed=1")

race_never = one_dim_table(never, "race", "ever_jailed=0")
sex_never = one_dim_table(never, "sex", "ever_jailed=0")
race_sex_never = cell_summary(never, "ever_jailed=0")

print("=" * 78)
print("TABLE A1. Median 1985 composite wealth by race (ever_jailed == 1)")
print("=" * 78)
print(race_ever.to_string(index=False))
print()
print("=" * 78)
print("TABLE A2. Median 1985 composite wealth by sex  (ever_jailed == 1)")
print("=" * 78)
print(sex_ever.to_string(index=False))
print()
print("=" * 78)
print("TABLE A3. Median 1985 composite wealth by race x sex (ever_jailed == 1)")
print("           cells with n <= 20 are flagged as exploratory.")
print("=" * 78)
print(order_table(race_sex_ever, "race x sex").to_string(index=False))
print()
print("=" * 78)
print("TABLE B1/B2/B3. Same tables for ever_jailed == 0 (reference cohort)")
print("=" * 78)
print(race_never.to_string(index=False))
print()
print(sex_never.to_string(index=False))
print()
print(order_table(race_sex_never, "race x sex").to_string(index=False))
print()

# Save to disk
race_ever.to_csv(OUT_DIR / "table_race_ever.csv", index=False)
sex_ever.to_csv(OUT_DIR / "table_sex_ever.csv", index=False)
order_table(race_sex_ever, "race x sex").to_csv(OUT_DIR / "table_raceSex_ever.csv", index=False)
race_never.to_csv(OUT_DIR / "table_race_never.csv", index=False)
sex_never.to_csv(OUT_DIR / "table_sex_never.csv", index=False)
order_table(race_sex_never, "race x sex").to_csv(OUT_DIR / "table_raceSex_never.csv", index=False)

# ---------------------------------------------------------------------------
# 5. Inferential corroboration (within ever_jailed == 1)
# ---------------------------------------------------------------------------
print("=" * 78)
print("INFERENCE within ever_jailed == 1")
print("=" * 78)

# 5a. Wilcoxon rank-sum pairwise (race), Kruskal-Wallis omnibus
races_present = [r for r in ORDER_RACE if (ever["race"] == r).sum() > 0]
print("\n-- Kruskal-Wallis omnibus test (race) on composite_wealth_1985 --")
kw_race = stats.kruskal(*[ever.loc[ever["race"] == r, WEALTH].values for r in races_present])
print(f"   H = {kw_race.statistic:.3f}   p = {kw_race.pvalue:.4g}   (n per group: "
      f"{ {r: int((ever['race']==r).sum()) for r in races_present} })")

print("\n-- Wilcoxon rank-sum pairwise by race (two-sided) --")
pairs = []
for i in range(len(races_present)):
    for j in range(i + 1, len(races_present)):
        a = ever.loc[ever["race"] == races_present[i], WEALTH].values
        b = ever.loc[ever["race"] == races_present[j], WEALTH].values
        res = stats.mannwhitneyu(a, b, alternative="two-sided")
        md = float(np.median(a) - np.median(b))
        pairs.append({
            "group_a": races_present[i],
            "group_b": races_present[j],
            "median_a_minus_b": md,
            "U": float(res.statistic),
            "p_value": float(res.pvalue),
            "n_a": int(len(a)),
            "n_b": int(len(b)),
        })
        print(f"  {races_present[i]:7s} vs {races_present[j]:7s} : "
              f"Δmedian = {md:>+9.0f}   U = {res.statistic:8.1f}   p = {res.pvalue:.4g}")

print("\n-- Wilcoxon rank-sum (sex) --")
a = ever.loc[ever["sex"] == "male", WEALTH].values
b = ever.loc[ever["sex"] == "female", WEALTH].values
res = stats.mannwhitneyu(a, b, alternative="two-sided")
print(f"   male (n={len(a)}) vs female (n={len(b)}): "
      f"Δmedian = {float(np.median(a)-np.median(b)):+.0f}   "
      f"U = {res.statistic:.1f}   p = {res.pvalue:.4g}")

# 5b. Median regression (quantile regression at q = 0.5) with interaction
print("\n-- Quantile regression at q = 0.5 of composite_wealth_1985 --")
print("   model: wealth ~ C(race) + C(sex) + C(race):C(sex)")
qr = smf.quantreg(f"{WEALTH} ~ C(race, Treatment(reference='white')) + C(sex, Treatment(reference='male')) + "
                  f"C(race, Treatment(reference='white')):C(sex, Treatment(reference='male'))",
                  data=ever).fit(q=0.5, max_iter=2000)
qreg_tbl = pd.DataFrame(qr.summary().tables[1].data[1:], columns=qr.summary().tables[1].data[0])
print(qreg_tbl.to_string(index=False))
qreg_tbl.to_csv(OUT_DIR / "qreg_summary.csv", index=False)

# 5c. Compare medians across ever_jailed status (sanity / context)
print("\n-- Median wealth contrast ever_jailed 0 vs 1 (context) --")
mw = stats.mannwhitneyu(
    ever[WEALTH].values, never[WEALTH].values, alternative="two-sided"
)
print(f"   median(never) = ${never[WEALTH].median():,.0f} ; "
      f"median(ever) = ${ever[WEALTH].median():,.0f} ; "
      f"Δ = ${never[WEALTH].median()-ever[WEALTH].median():,.0f} ; "
      f"U = {mw.statistic:.0f} ; p = {mw.pvalue:.4g}")

# ---------------------------------------------------------------------------
# 6. Persist numeric artefacts
# ---------------------------------------------------------------------------
results = {
    "headline_race": race_ever.to_dict(orient="records"),
    "headline_sex": sex_ever.to_dict(orient="records"),
    "supplementary_race_x_sex": order_table(race_sex_ever, "race x sex").to_dict(orient="records"),
    "reference_race": race_never.to_dict(orient="records"),
    "reference_sex": sex_never.to_dict(orient="records"),
    "reference_race_x_sex": order_table(race_sex_never, "race x sex").to_dict(orient="records"),
    "kruskal_wallis_race": {"H": float(kw_race.statistic), "p": float(kw_race.pvalue)},
    "wilcoxon_race_pairs": pairs,
    "wilcoxon_sex": {
        "U": float(res.statistic),
        "p": float(res.pvalue),
        "median_male": float(np.median(a)),
        "median_female": float(np.median(b)),
        "n_male": int(len(a)),
        "n_female": int(len(b)),
    },
    "mann_whitney_ever_vs_never": {
        "U": float(mw.statistic),
        "p": float(mw.pvalue),
        "median_ever": float(ever[WEALTH].median()),
        "median_never": float(never[WEALTH].median()),
    },
    "cleaning_notes": {
        "raw_race_labels": raw_race_labels,
        "renamed": {"hipanic": "hispanic"},
        "missing_values": {c: int(df[c].isna().sum()) for c in df.columns},
        "negative_wealth_share_overall_pct": float((df[WEALTH] < 0).mean() * 100),
    },
}
with open(OUT_DIR / "results.json", "w") as fh:
    json.dump(results, fh, indent=2, default=float)

print(f"\n[done] artefacts written to {OUT_DIR.resolve()}")
