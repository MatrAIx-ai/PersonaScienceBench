"""
NLSY79 1989 — DISSAVED ~ AGE/AGE^2 + controls. Outputs to artifacts/output/.
Analytical plan approved (centering on AGE mean, log(1+INCOME), winsorized BMI
[1st/99th] primary / BMI<=60 sensitivity, probit + multinomial robustness).
"""
import json
from pathlib import Path
import numpy as np
import pandas as pd
import scipy.stats as ss
import statsmodels.api as sm
from statsmodels.discrete.discrete_model import Logit, Probit, MNLogit
from statsmodels.stats.outliers_influence import variance_inflation_factor
from statsmodels.tools import add_constant

DATA = Path("/workspace/data/nls_bmi_processed.csv")
OUT = Path("/workspace/artifacts/output")
OUT.mkdir(parents=True, exist_ok=True)

def auc_score(y_true, y_score):
    y_true = np.asarray(y_true).astype(int)
    y_score = np.asarray(y_score, dtype=float)
    n_pos = int((y_true == 1).sum()); n_neg = int((y_true == 0).sum())
    order = np.argsort(-y_score, kind="mergesort")
    y_sorted = y_true[order]
    tp = np.cumsum(y_sorted == 1); fp = np.cumsum(y_sorted == 0)
    tpr = tp / max(n_pos,1); fpr = fp / max(n_neg,1)
    dfpr = np.diff(fpr)
    return float(np.sum(tpr[:-1]*dfpr) + 0.5*np.sum(np.diff(tpr)*dfpr))

def coef_table(res, names):
    p = res.params; se = res.bse; z = res.tvalues; pv = res.pvalues
    lo, hi = res.conf_int(alpha=0.05)
    return pd.DataFrame({"coef":p,"se":se,"z":z,"p":pv,"ci_lo":lo,"ci_hi":hi,
                         "odds_ratio":np.exp(p)}, index=names)

def ame_mean(res, X, idx):
    params = np.asarray(res.params, dtype=float)
    Xv = np.asarray(X, dtype=float)
    linpred = Xv @ params
    p = 1.0/(1.0+np.exp(-linpred))
    return float(np.mean(p*(1.0-p))*params[idx])

def hosmer_lemeshow(res, y, X, g=10):
    p = np.asarray(res.predict(X)); y = np.asarray(y).astype(int)
    df = pd.DataFrame({"y":y,"p":p})
    df["decile"] = pd.qcut(df["p"], g, duplicates="drop")
    grp = df.groupby("decile", observed=True)
    obs1 = grp["y"].sum(); n_grp = grp["y"].count()
    obs0 = n_grp - obs1; exp1 = grp["p"].sum(); exp0 = n_grp - exp1
    chi = float(((obs1-exp1)**2/exp1).sum() + ((obs0-exp0)**2/exp0).sum())
    k = grp.ngroups; dof = max(k-2, 1)
    pval = float(1.0 - ss.chi2.cdf(chi, df=dof))
    return chi, dof, pval, k

def vif_table(X, names):
    Xv = np.asarray(X, dtype=float); out=[]
    for i in range(Xv.shape[1]):
        try: v = float(variance_inflation_factor(Xv, i))
        except Exception: v = float("nan")
        out.append((names[i], v))
    return pd.DataFrame(out, columns=["variable","VIF"])

def turning_point(b1, b2, age_mean):
    if b2 == 0 or not np.isfinite(b2): return float("nan")
    return float(-b1/(2.0*b2) + age_mean)

# ----------------------------- load + features -----------------------------
df = pd.read_csv(DATA)
N = len(df)
print(f"Loaded {N} rows.")
np.random.seed(0)

bm = df["BMI"].to_numpy()
lo_p, hi_p = np.nanpercentile(bm, [1, 99])
df["BMI_w"] = np.clip(bm, lo_p, hi_p)
mask_bmi60 = df["BMI"] <= 60
print(f"BMI winsorize bounds: [{lo_p:.3f}, {hi_p:.3f}]  rows with BMI > 60: {(~mask_bmi60).sum()}")

AGE_MEAN = float(df["AGE"].mean())
df["AGE_C"] = df["AGE"].astype(float) - AGE_MEAN
df["AGE_C2"] = df["AGE_C"] ** 2
df["lnINCOME"] = np.log1p(df["INCOME"])
df["GENDER_MALE"] = (df["GENDER"] == "MALE").astype(int)
print(f"AGE_MEAN = {AGE_MEAN:.4f}")

def make_X(d, bmi_col="BMI_w"):
    cols = ["AGE_C","AGE_C2","lnINCOME","GENDER_MALE","BLACK","HISPANIC",bmi_col]
    X = d[cols].astype(float).copy()
    X.insert(0, "const", 1.0)
    return X, cols

# ----- PRIMARY SPEC: logit with winsorized BMI -----
X_full, used_cols = make_X(df, "BMI_w")
y = df["DISSAVED"].astype(int)
names = list(X_full.columns)
AGE_COL_IDX = names.index("AGE_C"); AGE2_COL_IDX = names.index("AGE_C2")
print("\nMatrix names:", names)

res = Logit(y, X_full).fit(disp=False, method="newton", maxiter=200)
print("\n=== Primary logistic regression (BMI winsorized) ===")
print(res.summary().tables[1])

ct_full = coef_table(res, names)
ct_full.to_csv(OUT / "primary_coef_table.csv")
print("\nPrimary coef table:")
print(ct_full.round(5).to_string())

# ----- headline fit statistics -----
llf = float(res.llf); llnull = float(res.llnull)
lr_stat = float(res.llr); lr_p = float(res.llr_pvalue)
df_model = int(res.df_model); nobs = int(res.nobs)
dev = float(-2.0 * llf); aic = float(res.aic); bic = float(res.bic)
dev_df = dev / max(nobs - df_model - 1, 1)

chi_hl, dof_hl, p_hl, k_hl = hosmer_lemeshow(res, y, X_full, g=10)
auc_val = auc_score(y, res.predict(X_full))

print(f"\nFit primary: logL={llf:.3f}, logL0={llnull:.3f}, AIC={aic:.2f}, BIC={bic:.2f}")
print(f"LR chi2={lr_stat:.3f}, df={df_model}, nobs={nobs}, LR p={lr_p:.4g}")
print(f"Deviance={dev:.3f}, dev/df={dev_df:.4f}")
print(f"H-L chi2={chi_hl:.3f}, dof={dof_hl}, p={p_hl:.4g} (groups={k_hl})")
print(f"AUC = {auc_val:.4f}")

ame_age = ame_mean(res, X_full, AGE_COL_IDX)
ame_age2 = ame_mean(res, X_full, AGE2_COL_IDX)
print(f"AME(AGE_C) per +1yr relative to mean({AGE_MEAN:.2f}) = {ame_age:+.5f}")
print(f"AME(AGE_C^2), at central values                  = {ame_age2:+.5f}")

X_no_int = X_full.drop(columns=["const"])
vif = vif_table(X_no_int, list(X_no_int.columns))
print("\nVIF (excluding intercept):")
print(vif.round(3).to_string(index=False))
vif.to_csv(OUT / "vif.csv", index=False)

# Box-Tidwell on AGE: extend linear-AGE model with AGE_C * ln|AGE_C|, test.
bt_term = df["AGE_C"].replace(0, 1e-6) * np.log(np.abs(df["AGE_C"].replace(0, 1e-6)))
X_bt_lin = X_full.drop(columns=["AGE_C2"]).copy()
X_bt_lin["AGE_C_times_ln"] = bt_term
res_bt = Logit(y, X_bt_lin).fit(disp=False, method="newton", maxiter=200)
bt_coef = res_bt.params["AGE_C_times_ln"]
bt_se   = res_bt.bse["AGE_C_times_ln"]
bt_z    = res_bt.tvalues["AGE_C_times_ln"]
bt_p    = res_bt.pvalues["AGE_C_times_ln"]
print(f"\nBox-Tidwell on AGE (linear-AGE refit): AGE*ln|AGE-C| coef={bt_coef:+.5f} "
      f"SE={bt_se:.5f} z={bt_z:.3f} p={bt_p:.4g}")
ct_lin = coef_table(res_bt, list(X_bt_lin.columns))
ct_lin.to_csv(OUT / "linear_AGE_coef_table.csv")

# ----- LRT and AIC/BIC: linear vs quadratic in AGE -----
res_lin = Logit(y, X_lin := X_full.drop(columns=["AGE_C2"])).fit(disp=False, method="newton", maxiter=200)
ll_lin = float(res_lin.llf); aic_lin = float(res_lin.aic); bic_lin = float(res_lin.bic)
lrt_stat = 2.0 * (llf - ll_lin)
lrt_p = float(1.0 - ss.chi2.cdf(lrt_stat, df=1))
print(f"\nLinear-AGE-only: AIC={aic_lin:.3f}, BIC={bic_lin:.3f}, logL={ll_lin:.3f}")
print(f"Quadratic full :  AIC={aic:.3f}, BIC={bic:.3f}, logL={llf:.3f}")
print(f"LRT(quadratic vs linear) chi2(1)={lrt_stat:.4f}, p={lrt_p:.4g}")
print(f"Delta AIC (linear - quad) = {aic_lin - aic:+.3f}; Delta BIC = {bic_lin - bic:+.3f}")

b1 = float(res.params["AGE_C"]); b2 = float(res.params["AGE_C2"])
tp = turning_point(b1, b2, AGE_MEAN)
print(f"\nImplied turning point on original AGE scale: {tp:.3f} (24<=tp<=32? {24<=tp<=32})")

# ----- Predicted vs empirical prevalence by integer age -----
profile = {"const":1.0,"AGE_C":0.0,"AGE_C2":0.0,
           "lnINCOME":float(np.log1p(df["INCOME"].median())),
           "GENDER_MALE":1,"BLACK":0,"HISPANIC":0,
           "BMI_w":float(df["BMI_w"].median())}
ages = np.sort(df["AGE"].unique())
vecs = []
for a in ages:
    ac = a - AGE_MEAN
    vecs.append([profile["const"], ac, ac**2, profile["lnINCOME"],
                 profile["GENDER_MALE"], profile["BLACK"], profile["HISPANIC"], profile["BMI_w"]])
X_prof = pd.DataFrame(vecs, columns=names)
preds = 1.0/(1.0+np.exp(-(np.asarray(X_prof) @ np.asarray(res.params))))
pred_df = pd.DataFrame({"AGE":ages, "pred_p_DISSAVED":preds})
emp = df.groupby("AGE")["DISSAVED"].agg(emp_p_DISSAVED="mean", n="count").reset_index()
overlay = pd.merge(pred_df, emp, on="AGE")
overlay.to_csv(OUT / "pred_vs_empirical_age.csv", index=False)
print("\nPredicted vs empirical DISSAVED prevalence by integer age (representative profile):")
print(overlay.round(4).to_string(index=False))

# ----- Sensitivity: BMI <= 60 excluded -----
ds = df.loc[df["BMI"] <= 60].copy()
print(f"\nSensitivity sample (BMI <= 60): n = {len(ds)}")
Xs, names_s = make_X(ds, "BMI_w")
res_s = Logit(ds["DISSAVED"].astype(int), Xs).fit(disp=False, method="newton", maxiter=200)
ct_s = coef_table(res_s, names_s)
ct_s.to_csv(OUT / "sensitivity_bmi60_coef_table.csv")
print("Sensitivity (BMI <= 60) coef table:")
print(ct_s[["coef","se","z","p","odds_ratio"]].round(5).to_string())

# ----- Probit (BMI winsorized) -----
res_probit = Probit(y, X_full).fit(disp=False, method="newton", maxiter=200)
ct_probit = coef_table(res_probit, names)
ct_probit.to_csv(OUT / "probit_coef_table.csv")
print("\nProbit (BMI winsorized):")
print(ct_probit[["coef","se","z","p"]].round(5).to_string())

# ----- Multinomial logit: 3-category savings outcome -----
def categorise(row):
    if row["DISSAVED"] == 1: return "withdrew_more"
    if row["SAMESAVE"] == 1: return "no_change"
    return "deposited_more"
df["sav3"] = df.apply(categorise, axis=1)
print("\nThree-category counts:")
print(df["sav3"].value_counts())
df["sav3"].value_counts().to_csv(OUT / "mnl_category_counts.csv")

order_ref_last = ["deposited_more","no_change","withdrew_more"]
X_mnl = df[["AGE_C","AGE_C2","lnINCOME","GENDER_MALE","BLACK","HISPANIC","BMI_w"]].astype(float).copy()
X_mnl = add_constant(X_mnl, has_constant="add")
y_mnl = pd.Categorical(df["sav3"], categories=order_ref_last)
res_mnl = MNLogit(y_mnl, X_mnl).fit(disp=False, method="newton", maxiter=400, tol=1e-6)

mnl_coef = pd.DataFrame(res_mnl.params)
mnl_se   = pd.DataFrame(res_mnl.bse)
mnl_z    = pd.DataFrame(res_mnl.tvalues)
mnl_p    = pd.DataFrame(res_mnl.pvalues)
mnl_coef.columns = [f"coef_{c}" for c in mnl_coef.columns]
mnl_se.columns   = [f"se_{c}"   for c in mnl_se.columns]
mnl_z.columns    = [f"z_{c}"    for c in mnl_z.columns]
mnl_p.columns    = [f"p_{c}"    for c in mnl_p.columns]
mnl_summary = pd.concat([mnl_coef, mnl_se, mnl_z, mnl_p], axis=1)
mnl_summary.to_csv(OUT / "mnl_coef_table.csv")
print("\nMultinomial logit (ref = deposited_more):")
print(mnl_summary.round(4).to_string())
print(f"\nMNL: logL={res_mnl.llf:.3f}, logL0={res_mnl.llnull:.3f}, "
      f"pseudoR2(McFadden)={1.0 - res_mnl.llf/res_mnl.llnull:.4f}")

# ----- Headline digest -----
digest = {
    "N": int(N),
    "AGE_mean": float(AGE_MEAN),
    "DISSAVED_prevalence": float(df["DISSAVED"].mean()),
    "primary_model": {
        "logL": llf, "logL_null": llnull, "AIC": aic, "BIC": bic,
        "LR_chi2": lr_stat, "LR_df": df_model, "LR_pvalue": lr_p,
        "deviance": dev, "dev_per_df": dev_df,
        "Hosmer_Lemeshow_chi2": chi_hl, "Hosmer_Lemeshow_df": dof_hl, "Hosmer_Lemeshow_pvalue": p_hl,
        "AUC": auc_val,
        "AME_AGE_year_relative_to_mean": ame_age,
        "AME_AGE2_central": ame_age2,
        "coef_AGE_C": float(res.params["AGE_C"]),
        "coef_AGE_C2": float(res.params["AGE_C2"]),
        "OR_AGE_C": float(np.exp(res.params["AGE_C"])),
        "OR_AGE_C2": float(np.exp(res.params["AGE_C2"])),
        "coef_lnINCOME": float(res.params["lnINCOME"]),
    },
    "linear_in_AGE_only": {
        "logL": ll_lin, "AIC": aic_lin, "BIC": bic_lin,
        "coef_AGE_C": float(res_lin.params["AGE_C"]),
        "OR_AGE_C": float(np.exp(res_lin.params["AGE_C"])),
    },
    "quadratic_vs_linear_LRT": {
        "LRT_stat": lrt_stat, "p_value": lrt_p,
        "delta_AIC_quadratic_minus_linear": aic - aic_lin,
        "delta_BIC_quadratic_minus_linear": bic - bic_lin,
    },
    "turning_point_original_AGE_scale": tp,
    "Box_Tidwell_linearity_test_for_AGE": {
        "coef_AGE_ln_AGE_centered": float(bt_coef),
        "SE": float(bt_se), "z": float(bt_z), "p": float(bt_p),
    },
    "sensitivity_bmi_excl_60": {
        "N": int(res_s.nobs),
        "coef_AGE_C": float(res_s.params["AGE_C"]),
        "coef_AGE_C2": float(res_s.params["AGE_C2"]),
        "p_AGE_C": float(res_s.pvalues["AGE_C"]),
        "p_AGE_C2": float(res_s.pvalues["AGE_C2"]),
        "LogL": float(res_s.llf),
    },
    "probit_logL": float(res_probit.llf),
    "mnl_pseudo_R2_McFadden": float(1.0 - res_mnl.llf / res_mnl.llnull),
    "mnl_logL": float(res_mnl.llf),
}
with open(OUT / "headline_metrics.json", "w") as f:
    json.dump(digest, f, indent=2, default=float)
print("\nWrote headline metrics to artifacts/output/headline_metrics.json")
print("\nDONE.")

# ------- supplementary: raw univariate (unadjusted) comparison and AME CI -------
# 1) Univariate logistic of DISSAVED on AGE (no centering, no controls).
Xu = sm.add_constant(df[['AGE']].astype(float))
res_uni = Logit(y, Xu).fit(disp=False, method="newton", maxiter=200)
print("\n=== Supplementary: univariate DISSAVED ~ AGE ===")
print(res_uni.summary().tables[1])
# AME-based formula: mean(p*(1-p)) * coef_AGE
amu = ame_mean(res_uni, Xu, list(Xu.columns).index('AGE'))
print(f"Univariate AME(AGE) = {amu:+.5f} pp per +1 year, coef = {float(res_uni.params['AGE']):+.5f}")

# 2) Predicted prevalence at the empirical covariate profile (sample averages).
# Build design matrix where covariates are fixed at empirical means/sample modes.
mean_profile = {
    "const": 1.0,
    "AGE_C": 0.0,
    "AGE_C2": 0.0,
    "lnINCOME": float(df["lnINCOME"].mean()),
    "GENDER_MALE": float(df["GENDER_MALE"].mean()),
    "BLACK": float(df["BLACK"].mean()),
    "HISPANIC": float(df["HISPANIC"].mean()),
    "BMI_w": float(df["BMI_w"].mean()),
}
emp_vecs = []
for a in ages:
    ac = a - AGE_MEAN
    emp_vecs.append([mean_profile["const"], ac, ac**2,
                     mean_profile["lnINCOME"],
                     mean_profile["GENDER_MALE"],
                     mean_profile["BLACK"],
                     mean_profile["HISPANIC"],
                     mean_profile["BMI_w"]])
X_emp = pd.DataFrame(emp_vecs, columns=names)
preds_emp = 1.0/(1.0+np.exp(-(np.asarray(X_emp) @ np.asarray(res.params))))
print("\nPredicted P(DISSAVED=1) by integer age holding covariates at empirical MEANS:")
for a,p in zip(ages, preds_emp):
    print(f"  age {a}: {p:.4f}")

# 3) AME 95% CI for AGE (delta method using AME = g*beta; SE(AME) ~= g*SE(beta))
g = float(np.mean(res.predict(X_full) * (1 - res.predict(X_full))))
ame_se = g * float(res.bse["AGE_C"])
print(f"\nDelta-method: g=mean(p(1-p))={g:.5f}, AME SE ~= {ame_se:.5f}")
print(f"AME 95% CI: [{ame_age - 1.96*ame_se:+.5f}, {ame_age + 1.96*ame_se:+.5f}]")

# 4) Save a univariate-cf table for records.
univariate_csv = pd.DataFrame({
    "model": ["univariate_logit_age_only", "primary_logit_quadratic"],
    "coef_AGE_per_year_odds_ratio": [float(np.exp(res_uni.params['AGE'])),
                                       float(np.exp(res.params['AGE_C']))],
    "coef_AGE_log_odds": [float(res_uni.params['AGE']), float(res.params['AGE_C'])],
    "AME_AGE_pp_per_year": [amu, ame_age],
    "AME_AGE_95CI_lo": [amu - 1.96*(float(res_uni.bse['AGE'])*float(np.mean(res_uni.predict(Xu)*(1-res_uni.predict(Xu))))),
                          ame_age - 1.96*ame_se],
    "AME_AGE_95CI_hi": [amu + 1.96*(float(res_uni.bse['AGE'])*float(np.mean(res_uni.predict(Xu)*(1-res_uni.predict(Xu))))),
                          ame_age + 1.96*ame_se],
    "nobs": [int(res_uni.nobs), int(res.nobs)],
})
univariate_csv.to_csv(OUT / "univariate_vs_controlled.csv", index=False)
print("Wrote univariate_vs_controlled.csv")

print("\n[supplementary done]")
