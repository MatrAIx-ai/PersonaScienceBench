import pandas as pd
import numpy as np

pd.set_option('display.width', 200)
pd.set_option('display.max_columns', 30)

df = pd.read_csv('/workspace/data/nls_ses_processed.csv', index_col=0)
print("=== SHAPE & DTYPES ===")
print(df.shape)
print(df.dtypes)
print()

print("=== HEAD (3) ===")
print(df.head(3).to_string())
print()

print("=== UNIQUE VALUES FOR CATEGORICAL COLS ===")
for c in ['SAMPLE_RACE', 'SAMPLE_SEX']:
    print(f"-- {c} --")
    print(df[c].value_counts(dropna=False))
    print()

print("=== SAMPLE_SIZE BREAKDOWN BY RACE ===")
print(df['SAMPLE_RACE'].value_counts(dropna=False))
print()

print("=== UNIQUE CASE IDs ===")
print('n rows:', len(df), ' unique CASE ID:', df['CASE ID'].nunique())
print()

print("=== MISSINGNESS PER COLUMN ===")
print(df.isna().sum())
print('frac missing:')
print((df.isna().mean()*100).round(2))
print()

print("=== SES DESCRIPTIVES ===")
ses = df['SES']
print(ses.describe(percentiles=[0.05, 0.25, 0.5, 0.75, 0.95]).round(4))
print('n missing SES:', ses.isna().sum())
print()

print("=== SES by race (SES not missing) ===")
print(df.groupby('SAMPLE_RACE', dropna=False)['SES'].describe(percentiles=[0.05,0.25,0.5,0.75,0.95]).round(4))
print()

print("=== BA OVERALL ===")
ba = df['BA DEGREE COMPLETED']
print('dtype:', ba.dtype)
print('value_counts:')
print(ba.value_counts(dropna=False))
print('overall rate (BA==True):', (ba==True).mean().round(4),
      ' mean (if numeric):', ba.mean() if pd.api.types.is_numeric_dtype(ba) else 'N/A')
print()

print("=== BA BY RACE ===")
print(df.groupby('SAMPLE_RACE', dropna=False)['BA DEGREE COMPLETED'].agg([
    ('n', 'size'),
    ('n_true', lambda s: (s==True).sum()),
    ('n_na', lambda s: s.isna().sum()),
    ('rate_true', lambda s: (s==True).mean()),
]).round(4))
print()

print("=== BA BY SEX ===")
print(df.groupby('SAMPLE_SEX', dropna=False)['BA DEGREE COMPLETED'].agg([
    ('n','size'),('n_true',lambda s:(s==True).sum()),('rate',lambda s:(s==True).mean())
]).round(4))
print()

print("=== FAMILY SIZE OF SAMPLE ===")
fs = df['FAMILY SIZE OF SAMPLE']
print(fs.describe().round(3))
print('n missing:', fs.isna().sum())
print('value_counts (top):')
print(fs.value_counts(dropna=False).head(10))
print()

print("=== ABILITY: COMPOSITE OF ASVAB SCORE ===")
ab = df['ABILITY: COMPOSITE OF ASVAB SCORE']
print(ab.describe().round(2))
print('n missing:', ab.isna().sum())
print()

print("=== PERCENTILE IN CLASS ===")
pc = df['PERCENTILE IN CLASS']
print(pc.describe().round(3))
print('n missing:', pc.isna().sum())
print('count <0:', (pc<0).sum(), ' count >100:', (pc>100).sum())
print()

print("=== CORRELATIONS (numeric) ===")
num = df[['SES','ABILITY: COMPOSITE OF ASVAB SCORE','PERCENTILE IN CLASS','FAMILY SIZE OF SAMPLE']]
print(num.corr(method='pearson').round(3))
print()
print('spearman:')
print(num.corr(method='spearman').round(3))
