import pandas as pd
df = pd.read_csv("data/meta-regression_study_data_heterogeneity_in_replication_projects.csv")
TARGET_O, TARGET_R, TOL = 0.824, 0.809, 0.010
candidates = {
    "discipline=Social": df[df["discipline"]=="Social"],
    "discipline=Cognitive": df[df["discipline"]=="Cognitive"],
    "discipline=Economics": df[df["discipline"]=="Economics"],
    "project=ml1": df[df["project"]=="ml1"],
    "project=ml3": df[df["project"]=="ml3"],
    "project=rpp": df[df["project"]=="rpp"],
    "project=ee": df[df["project"]=="ee"],
    "Cognitive_unioned_Social_eq_Psychology": df[df["discipline"].isin(["Cognitive","Social"])],
}
for k, s in candidates.items():
    o = s["subjects.o"].dropna().eq("students").mean()
    r = s["subjects.r"].dropna().eq("students").mean()
    print(f"{k:50s}  n={len(s):>4}  o={o*100:.3f}%  r={r*100:.3f}%  dev_o={o-TARGET_O:+.3%}  dev_r={r-TARGET_R:+.3%}")
