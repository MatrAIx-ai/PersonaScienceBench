"""
Analisis: proporcion de estudios del proyecto 'ee' (Experimental Economics)
realizados en un entorno de laboratorio.

Unidad de analisis: estudio original (columna online.o) dentro de filas con
project == 'ee'. Como en ee las 18 filas coinciden con 18 ids unicos, no hace
falta deduplicar filas para el analisis (la fila = el estudio original).

Definiciones operativas (sensibilidad):
  A: online.o == 0                                              (PRINCIPAL)
  B: online.r == 0
  C: subjects.o == 'students'
  D: online.o == 0 AND subjects.o == 'students'                 (conservadora)

Reglas exigidas por el investigador:
  - Descartar filas con drop == True si existiesen.
  - Documentar NaN en columnas clave dentro de ee.
  - us_lab.o NO se usa como numerador; solo caracterizacion contextual.
"""

import pandas as pd

PATH = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
df = pd.read_csv(PATH)

print("="*70)
print("Shape global:", df.shape)
print("Columnas en CSV:", len(df.columns))

# 1) Subconjunto project == 'ee'
ee_all = df[df["project"] == "ee"].copy()
print("\n-- Subconjunto project == 'ee' --")
print("Filas:", len(ee_all))
print("ids unicos:", ee_all["id"].nunique())
assert len(ee_all) == 18
assert ee_all["id"].nunique() == 18  # filas == estudios unicos

# 2) Descarte defensivo por drop == True
print("\n-- Regla de descarte: drop == True --")
print("dtype de drop:", ee_all["drop"].dtype)
print("Conteo True/False dentro de ee:")
print(ee_all["drop"].value_counts(dropna=False).to_string())
ee = ee_all[ee_all["drop"] != True].copy()  # '!=' True evita que se descarten False
print("Filas ee tras descartar drop == True:", len(ee))
assert len(ee) == 18, "No deberia descartarse ninguna fila de ee (todas drop==False)"

# 3) NaN en columnas clave dentro de ee
print("\n-- NaN en columnas clave dentro de ee --")
for c in ["online.o", "online.r", "subjects.o", "subjects.r",
          "us_lab.o", "compensation.o", "experiment_country.o"]:
    n = ee[c].isna().sum()
    flag = "OK" if n == 0 else f"WARN: {n} NaN"
    print(f"  {c:>22}: NaN = {n}  [{flag}]")

# 4) Recalculo en limpio
denom = len(ee)  # 18 estudios originales del proyecto ee
A_num = int((ee["online.o"] == 0).sum())
B_num = int((ee["online.r"] == 0).sum())
C_num = int((ee["subjects.o"] == "students").sum())
D_num = int(((ee["online.o"] == 0) & (ee["subjects.o"] == "students")).sum())

A = A_num / denom
B = B_num / denom
C = C_num / denom
D = D_num / denom

print("\n-- Conteos crudos por definicion --")
print(f"  A: online.o==0                -> {A_num}/{denom}")
print(f"  B: online.r==0                -> {B_num}/{denom}")
print(f"  C: subjects.o=='students'     -> {C_num}/{denom}")
print(f"  D: online.o==0 AND students.o -> {D_num}/{denom}")

# 5) Tabla resumen
table = pd.DataFrame({
    "Definicion": ["A: online.o == 0 (PRINCIPAL)",
                   "B: online.r == 0",
                   "C: subjects.o == 'students'",
                   "D: online.o == 0 AND subjects.o == 'students'"],
    "Variable": ["online.o", "online.r", "subjects.o",
                 "online.o + subjects.o"],
    "Numerador": [A_num, B_num, C_num, D_num],
    "Denominador": [denom, denom, denom, denom],
    "Proporcion": [round(A, 4), round(B, 4), round(C, 4), round(D, 4)],
    "Porcentaje": [f"{A*100:.1f}%", f"{B*100:.1f}%",
                   f"{C*100:.1f}%", f"{D*100:.1f}%"],
})
print("\n" + "="*70)
print("TABLA A-D: project=='ee' (n=18)")
print("="*70)
print(table.to_string(index=False))

# 6) Caracterizacion contextual (no es parte del numerador)
ctx = pd.DataFrame({
    "Variable (solo contexto)": [
        "us_lab.o == 1 (lab en EE.UU.)",
        "experiment_country.o == 'United States'",
        "compensation.o == 'cash'",
    ],
    "Conteo": [(ee["us_lab.o"] == 1).sum(),
               (ee["experiment_country.o"] == "United States").sum(),
               (ee["compensation.o"] == "cash").sum()],
    "Total": [denom, denom, denom],
    "Porcentaje": [f"{(ee['us_lab.o']==1).sum()*100/denom:.1f}%",
                   f"{(ee['experiment_country.o']=='United States').sum()*100/denom:.1f}%",
                   f"{(ee['compensation.o']=='cash').sum()*100/denom:.1f}%"],
})
print("\n" + "="*70)
print("CARACTERIZACION CONTEXTUAL (no es numerador del lab setting)")
print("="*70)
print(ctx.to_string(index=False))

# 7) Rango de sensibilidad A-D
sens_min = min(A, B, C, D) * 100
sens_max = max(A, B, C, D) * 100
print(f"\nRango sensibilidad (A-D): {sens_min:.1f}% - {sens_max:.1f}%")

# 8) Sanity asserts
assert A_num == denom == 18
assert B_num == denom == 18
assert C_num == 17
assert D_num == 17
print("\nAsserts OK: A=18/18, B=18/18, C=17/18, D=17/18")

# 9) Persistir tablas
table.to_csv("artifacts/analysis/ee_lab_sensitivity_table.csv", index=False)
ctx.to_csv("artifacts/analysis/ee_lab_context_table.csv", index=False)
pd.concat([table.assign(grupo="LAB_PROXY"),
           ctx.assign(grupo="CONTEXTO")], ignore_index=True)\
  .to_csv("artifacts/analysis/ee_lab_full_table.csv", index=False)

print("\nTablas guardadas:")
for f in ["ee_lab_sensitivity_table.csv","ee_lab_context_table.csv","ee_lab_full_table.csv"]:
    print(" - artifacts/analysis/"+f)
