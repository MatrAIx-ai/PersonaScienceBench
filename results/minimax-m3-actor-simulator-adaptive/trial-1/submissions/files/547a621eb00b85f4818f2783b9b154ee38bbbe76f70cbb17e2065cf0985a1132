"""
DiscoveryBench task: meta_regression_raw / metadata_15 / 0/2
Question: What proportion of original studies in Experimental Economics were
          conducted in the United Kingdom?
Dataset : data/meta-regression_study_data_heterogeneity_in_replication_projects.csv
"""
import json
import pandas as pd

DATA = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
df = pd.read_csv(DATA)

# 1. EE project (Experimental Economics) — operational definition
ee = df[df["project"] == "ee"].copy()
denominator = len(ee)

# 2. UK originals — exact match on canonical "United Kingdom"
uk_mask = ee["experiment_country.o"] == "United Kingdom"
numerator = int(uk_mask.sum())

# 3. Per-country breakdown within EE originals (original-study side)
country_counts = (
    ee["experiment_country.o"]
      .value_counts(dropna=False)
      .rename_axis("country")
      .reset_index(name="n_original_studies")
)

# 4. Sanity: identical set under `discipline == "Economics"`
econ_only = df[df["discipline"] == "Economics"]
identical = set(ee["id"]) == set(econ_only["id"])

# 5. Sanity: completeness of country field within EE
missing_country = int(ee["experiment_country.o"].isna().sum())

proportion = numerator / denominator

diagnostics = {
    "total_rows_in_dataset": int(len(df)),
    "ee_project_rows": denominator,
    "discipline_economics_rows": int(len(econ_only)),
    "ee_eq_discipline_economics": bool(identical),
    "missing_experiment_country_o_in_ee": missing_country,
    "uk_originals_in_ee": numerator,
    "proportion_uk_in_ee": proportion,
    "proportion_uk_in_ee_pct": proportion * 100,
    "fraction_uk_in_ee": f"{numerator}/{denominator}",
    "country_breakdown_within_ee_originals": country_counts.to_dict(orient="records"),
    "uk_study_id_in_ee": ee.loc[uk_mask, "id"].tolist(),
    "uk_study_title_in_ee": ee.loc[uk_mask, "title"].tolist(),
    "uk_study_authors_in_ee": ee.loc[uk_mask, "authors.o"].tolist(),
    "uk_study_year_in_ee": ee.loc[uk_mask, "pub_year"].tolist(),
    "uk_study_journal_in_ee": ee.loc[uk_mask, "journal"].tolist(),
}

print(json.dumps(diagnostics, indent=2, default=str))

# Persist a small JSON next to this script for downstream inspection
with open("artifacts/diagnostics.json", "w") as fh:
    json.dump(diagnostics, fh, indent=2, default=str)
