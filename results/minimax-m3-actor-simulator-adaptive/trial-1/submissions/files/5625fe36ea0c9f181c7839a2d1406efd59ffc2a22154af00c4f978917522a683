"""
DiscoveryBench - metadata_8 / Amber peak analysis.

Question:
  "In which millennium did Amber have the highest value, and in what time
   interval did it peak?"

Primary signal  : data/time_series_data.csv -> Amber_inter  (1-yr grid, fully populated)
Cross-check 1   : data/time_series_data.csv -> Amber (raw)   (100-yr anchor samples)
Cross-check 2   : data/capital.csv          -> Zamber        (100-yr steps, group-tagged)

Output: prints per-millennium Amber_inter summary, strict plateau, elevated band,
and cross-check confirmations.
"""
import json
import pandas as pd
import numpy as np

# ---------------------------------------------------------------
# 1.  Primary signal
# ---------------------------------------------------------------
df = pd.read_csv("data/time_series_data.csv", index_col=0)
assert {"CE", "calBP", "Amber", "Amber_inter"}.issubset(df.columns), "missing required cols"

# Confirm Amber_inter is step-interpolated from the 100-yr Amber anchors
non_nan = df["Amber"].dropna()
assert (non_nan.index % 100 == 0).all(), "raw Amber anchors not every 100 rows"
at_anchors = df.loc[non_nan.index, "Amber_inter"].to_numpy()
np.testing.assert_allclose(at_anchors, non_nan.to_numpy(),
                           err_msg="Amber_inter diverges from raw Amber at 100-yr anchors")
print("OK : Amber_inter matches raw Amber at all 100-yr anchors (step interpolation).")

# ---------------------------------------------------------------
# 2.  Per-millennium summary  (CE // 1000, negative = BCE)
# ---------------------------------------------------------------
df["mill_CE"] = (df["CE"] // 1000).astype(int)        # ...,-5,-4,-3,-2,-1,0
def mill_label(m):
    # convention: the N-th millennium BCE == CE bin -(N+1) if CE // -1000 in [N,...)
    # We define: bin -5 -> years -5000..-4001 = 6th millennium BCE
    #            bin -4 -> years -4000..-3001 = 5th millennium BCE
    #            bin -3 -> years -3000..-2001 = 4th millennium BCE  <-- peak plateau
    # Mirroring: the high bin of interest (CE in -4000..-3001) is the 5th millennium BCE
    # IF using the convention "N-th millennium starts at year N*1000 BCE".
    # The widely-used archaeological convention (e.g. Wikipedia) is:
    #     N-th millennium BCE = years (N*1000) .. (N*1000-999) BCE
    # So the 4th millennium BCE = 4000..3001 BCE (CE -4000..-3001) -> bin -4.
    n_bce = -m                       # N
    return f"bin m={m}  ({n_bce}th mill. BCE)"

summary = (df.groupby("mill_CE")
             .agg(max_A=("Amber_inter", "max"),
                  mean_A=("Amber_inter", "mean"),
                  n=("Amber_inter", "size")))
print("\n=== Per-millennium Amber_inter summary ===")
print(summary.to_string())
print()

bin_top = summary["max_A"].idxmax()
bin_top_label = mill_label(bin_top)
print(f"Millennium with highest Amber_inter max: {bin_top_label}  (max={summary.loc[bin_top,'max_A']:.4f})")

# ---------------------------------------------------------------
# 3.  Strict plateau  (contiguous run where Amber_inter == global max)
# ---------------------------------------------------------------
peak = float(df["Amber_inter"].max())
plateau_mask = (df["Amber_inter"] >= peak - 1e-12)
plateau_idx = df.index[plateau_mask].to_numpy()
# contiguous block:
start_idx, end_idx = int(plateau_idx[0]), int(plateau_idx[-1])
start_ce, end_ce = int(df.loc[start_idx, "CE"]), int(df.loc[end_idx, "CE"])
start_bp, end_bp = int(df.loc[start_idx, "calBP"]), int(df.loc[end_idx, "calBP"])
n_years = end_idx - start_idx + 1
print("\n=== STRICT plateau (Amber_inter == global max) ===")
print(f"global max Amber_inter = {peak}")
print(f"row indices        : {start_idx} .. {end_idx}  (n={n_years} consecutive 1-yr rows)")
print(f"CE range           : {start_ce} .. {end_ce}    (i.e. {abs(start_ce)}..{abs(end_ce)} BCE)")
print(f"calBP range        : {start_bp} .. {end_bp}")

# ---------------------------------------------------------------
# 4.  Wider elevated band  (Amber_inter > mean + 1 SD)
# ---------------------------------------------------------------
mu  = float(df["Amber_inter"].mean())
sd  = float(df["Amber_inter"].std())
thr = mu + sd
band_mask = df["Amber_inter"] > thr
band_idx = df.index[band_mask].to_numpy()
b_first_idx, b_last_idx = int(band_idx[0]), int(band_idx[-1])
# contiguous ranges inside the band:
gaps = np.where(np.diff(band_idx) > 1)[0]
print(f"\n=== ELEVATED band (Amber_inter > mean+1SD = {thr:.4f}) ===")
print(f"total rows in band : {band_mask.sum()} of {len(df)}")
def report_band(lo, hi, label):
    ce_lo = int(df.loc[lo, "CE"]); ce_hi = int(df.loc[hi, "CE"])
    bp_lo = int(df.loc[lo, "calBP"]); bp_hi = int(df.loc[hi, "calBP"])
    print(f"  {label}: rows {lo}..{hi}  |  CE {ce_lo} .. {ce_hi}  |  calBP {bp_lo} .. {bp_hi}")
lo = b_first_idx
for g in gaps:
    report_band(lo, int(band_idx[g]), "contiguous block")
    lo = int(band_idx[g + 1])
report_band(lo, b_last_idx, "contiguous block (last)")
total_elevated_ce_start = int(df.loc[b_first_idx, "CE"])
total_elevated_ce_end   = int(df.loc[b_last_idx, "CE"])
print(f"Overall elevated envelope: CE {total_elevated_ce_start} .. {total_elevated_ce_end}")

# ---------------------------------------------------------------
# 5.  Cross-check 1 : raw Amber anchors
# ---------------------------------------------------------------
hit_ce = sorted(non_nan[(non_nan >= peak - 1e-12)].index.tolist())
hit_ce_vals = [(int(df.loc[i, "CE"]), int(df.loc[i, "calBP"]),
                float(df.loc[i, "Amber"])) for i in hit_ce]
print("\n=== Cross-check 1: raw Amber anchors at peak ===")
print(f"Raw Amber == {peak} occurs at CE indices (rows): {hit_ce}")
print("CE / calBP / Amber:")
for ce, bp, am in hit_ce_vals:
    print(f"  CE={ce:>5}   calBP={bp:>5}   Amber={am}")

# ---------------------------------------------------------------
# 6.  Cross-check 2 : capital.csv / Zamber
# ---------------------------------------------------------------
cap = pd.read_csv("data/capital.csv")
# decimal commas to floats
for col in cap.columns[3:]:
    cap[col] = cap[col].astype(str).str.replace(",", ".").astype(float)
cap["CE"] = -cap["BCE"]
zmax = float(cap["Zamber"].max())
zmax_rows = cap[cap["Zamber"] >= zmax - 1e-12]
print("\n=== Cross-check 2: capital.csv / Zamber ===")
print(f"Zamber max = {zmax}")
print(zmax_rows[["BCE", "CE", "group", "Zamber"]].to_string(index=False))

# ---------------------------------------------------------------
# 7.  Final structured result
# ---------------------------------------------------------------
result = {
    "primary_signal": "Amber_inter (data/time_series_data.csv, 1-yr grid, fully populated)",
    "global_max": peak,
    "millennium_with_highest_max": {
        "mill_CE_bin": int(bin_top),
        "interpretation": "4th millennium BCE = 4000..3001 BCE (CE -4000..-3001), i.e. conventional N-th mill. BCE",
        "max_in_bin": float(summary.loc[bin_top, "max_A"]),
        "mean_in_bin": float(summary.loc[bin_top, "mean_A"]),
        "n_in_bin": int(summary.loc[bin_top, "n"]),
    },
    "strict_plateau": {
        "row_first": start_idx, "row_last": end_idx,
        "n_years": n_years,
        "CE_first": start_ce, "CE_last": end_ce,
        "calBP_first": start_bp, "calBP_last": end_bp,
    },
    "elevated_band_mu_p1sd": {
        "threshold": round(thr, 6),
        "CE_first": total_elevated_ce_start,
        "CE_last":   total_elevated_ce_end,
        "n_rows":    int(band_mask.sum()),
    },
    "cross_check_raw_Amber_anchors_at_peak": [
        {"CE": ce, "calBP": bp, "Amber": am} for (ce, bp, am) in hit_ce_vals
    ],
    "cross_check_capital_csv_Zamber_at_peak": zmax_rows[["BCE","CE","group","Zamber"]].to_dict("records"),
}
print("\n=== FINAL STRUCTURED RESULT (JSON) ===")
print(json.dumps(result, indent=2))

with open("artifacts/result.json", "w") as fh:
    json.dump(result, fh, indent=2)
