"""Main analysis for DiscoveryBench NLS metadata_8 task:
'Between which two races is the factor of BA degree completion -0.9568 when one
is compared to the other?'

Methodology (race-only, no covariates):
  (1) Coerce BA DEGREE COMPLETED to int 0/1.
  (2) Compute BA completion rate, log odds-ratio and log risk-ratio for every
      ordered direction of every unordered race pair (full precision and
      4-decimal rounded).
  (3) Fit three Bernoulli GLMs (logit link), each with a different race set as
      the treatment reference via statsmodels formulas C(...). Record the
      intercept and the two non-reference coefficients at full precision and
      rounded to 4 decimals.
  (4) Identify the unique race pair whose directional log-OR / log-RR equals
      -0.9568 at 4 decimals; if none matches exactly, report the closest match
      and quantify the discrepancy.
  (5) Print the natural-language hypothesis with both race names plus the
      supporting cell counts, probabilities, log-OR, log-RR and the matching
      GLM coefficient.
"""
import math, itertools
from collections import OrderedDict

import numpy as np
import pandas as pd
import statsmodels.api as sm
import statsmodels.formula.api as smf

# ---- (1) Load + coerce -------------------------------------------------------
df = pd.read_csv("data/nls_ses_processed.csv", index_col=0)
df["BA_DEG"] = df["BA DEGREE COMPLETED"].astype(int)
assert df["BA_DEG"].isin([0, 1]).all()
assert df["SAMPLE_RACE"].notna().all()
assert df["BA_DEG"].notna().all()

races = ["White", "Black", "Hispanic"]
counts = OrderedDict(
    (r, (int(df.loc[df.SAMPLE_RACE == r, "BA_DEG"].sum()),
         int((df.SAMPLE_RACE == r).sum())))
    for r in races
)

# ---- (2) Pairwise estimates at full + 4dp precision --------------------------
def fmt(v, nd=4):
    return f"{v:.{nd}f}"

pairs = list(itertools.combinations(races, 2))

pair_stats = {}
print("\n=== Pairwise estimates (full + 4-decimal) ===")
print(f"{'A':<10}{'B':<10}{'pA':>10}{'pB':>10}{'logRR(A>B)':>16}{'logOR(A>B)':>16}{'logRR_4dp':>14}{'logOR_4dp':>14}")
for a, b in pairs:
    ba_a, n_a = counts[a]; ba_b, n_b = counts[b]
    p_a, p_b = ba_a / n_a, ba_b / n_b
    log_rr = math.log(p_a / p_b)
    log_or = math.log((p_a / (1 - p_a)) / (p_b / (1 - p_b)))
    pair_stats[(a, b)] = dict(ba_a=ba_a, n_a=n_a, ba_b=ba_b, n_b=n_b,
                              pA=p_a, pB=p_b, logRR=log_rr, logOR=log_or)
    print(f"{a:<10}{b:<10}"
          f"{p_a:>10.7f}{p_b:>10.7f}"
          f"{log_rr:>+16.7f}{log_or:>+16.7f}"
          f"{fmt(log_rr):>14}{fmt(log_or):>14}")

# ---- (3) Three race-only GLMs, one per reference -----------------------------
print("\n=== Race-only Bernoulli GLMs (logit) ===")
glm_coeffs = {}  # key: ('comparison' vs 'reference') -> value dict with coef, names
for ref in races:
    formula = f"BA_DEG ~ C(SAMPLE_RACE, Treatment(reference='{ref}'))"
    model = smf.glm(formula, data=df, family=sm.families.Binomial()).fit()
    print(f"\n--- Reference: {ref} ---")
    print(f"Deviance={model.deviance:.6f}  Pearson chi2={model.pearson_chi2:.6f}  N={int(model.nobs)}")
    print(f"{'term':<55}{'coef (full)':>20}{'coef_4dp':>14}")
    for term, value in model.params.items():
        print(f"{term:<55}{value:>+20.10f}{fmt(value):>14}")
    # Store directional coefficients (non-reference races)
    for comp in races:
        if comp == ref:
            continue
        term = f"C(SAMPLE_RACE, Treatment(reference='{ref}'))[T.{comp}]"
        glm_coeffs[(comp, ref)] = dict(
            coef=float(model.params[term]),
            se=float(model.bse[term]),
            z=float(model.tvalues[term]),
            p=float(model.pvalues[term]),
            reference=ref,
            comparison=comp,
        )

# ---- (4) Identify match against -0.9568 at 4dp -------------------------------
TARGET = -0.9568
print("\n=== Matching directional coefficients against -0.9568 @ 4dp ===")
all_dirs = []
# From GLM (log-OR)
for key, info in glm_coeffs.items():
    all_dirs.append(("GLM_logOR", info["comparison"], info["reference"],
                     info["coef"], round(info["coef"], 4)))
# From raw 2x2 log-OR and log-RR (full directional)
for (a, b), st in pair_stats.items():
    for direction in [(a, b), (b, a)]:
        comp, ref = direction
        v_or = math.log(st["logOR"]) if False else (  # placeholder, ignore
            # log-OR(comp vs ref) = log(odds_comp) - log(odds_ref) = +/- pair_stats[(comp,ref)].logOR
            # Need sign convention: pair_stats[(a,b)].logOR = logOR(a vs b)
            None
        )
        # Simpler: derive directly
        ba_c, n_c = counts[comp]; ba_r, n_r = counts[ref]
        pc, pr = ba_c / n_c, ba_r / n_r
        log_rr_dir = math.log(pc / pr)
        log_or_dir = math.log((pc / (1 - pc)) / (pr / (1 - pr)))
        all_dirs.append(("direct_logRR_fmt", comp, ref, log_rr_dir, round(log_rr_dir, 4)))
        all_dirs.append(("direct_logOR_fmt", comp, ref, log_or_dir, round(log_or_dir, 4)))

# Print directional table
print(f"{'source':<22}{'comparison':<12}{'reference':<10}{'value_full':>16}{'value_4dp':>14}{'match?':>10}{'abs_diff':>14}")
matches_exact = []
candidates = []
for src, comp, ref, v_full, v_4dp in all_dirs:
    is_match = (v_4dp == round(TARGET, 4))
    diff = abs(v_full - TARGET)
    label = "EXACT" if is_match else f"{diff:.4f}"
    print(f"{src:<22}{comp:<12}{ref:<10}{v_full:>+16.7f}{v_4dp:>+14.4f}{label:>10}")
    if is_match:
        matches_exact.append((src, comp, ref, v_full))
    candidates.append((diff, src, comp, ref, v_full, v_4dp))

print("\n=== Exact matches at 4dp against", TARGET, "===")
if matches_exact:
    for src, comp, ref, v in matches_exact:
        print(f"  EXACT: {src}: {comp} vs {ref}: {v:+.10f}")
else:
    print("  No exact match at 4dp.")
    candidates.sort()
    print("  Top 5 closest matches (by |value - target|):")
    for diff, src, comp, ref, v_full, v_4dp in candidates[:5]:
        print(f"    {diff:.6f}  {src}  {comp} vs {ref}  full={v_full:+.7f}  4dp={v_4dp:+.4f}")

# ---- (5) Final concise summary ----------------------------------------------
print("\n=== Summary table ===")
print(f"{'comparison':<12}{'reference':<10}{'ba/n (comp)':>15}{'ba/n (ref)':>15}{'p_comp':>10}{'p_ref':>10}{'logRR':>12}{'logOR':>12}")
