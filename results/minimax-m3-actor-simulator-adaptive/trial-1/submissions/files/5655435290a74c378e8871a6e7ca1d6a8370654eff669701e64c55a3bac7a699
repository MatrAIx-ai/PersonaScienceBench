ordered = []
for ref in races:
    for comp in races:
        if comp == ref: continue
        ba_c, n_c = counts[comp]; ba_r, n_r = counts[ref]
        pc = ba_c/n_c; pr = ba_r/n_r
        log_rr = math.log(pc/pr); log_or = math.log((pc/(1-pc))/(pr/(1-pr)))
        ordered.append((comp, ref, ba_c, n_c, ba_r, n_r, pc, pr, log_rr, log_or))
ordered.sort(key=lambda t: abs(t[8] - TARGET))
for comp, ref, ba_c, n_c, ba_r, n_r, pc, pr, log_rr, log_or in ordered:
    print(f"{comp:<12}{ref:<10}{f'{ba_c}/{n_c}':>15}{f'{ba_r}/{n_r}':>15}"
          f"{pc:>10.6f}{pr:>10.6f}{log_rr:>+12.6f}{log_or:>+12.6f}")

