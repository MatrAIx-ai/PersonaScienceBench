"""
DiscoveryBench meta_regression analysis
Question: For which domains do effect-size estimates tend to be larger in
original studies compared to replication studies?

Primary domain : discipline (Cognitive / Social / Economics)
Primary outcome: paired diff  Delta = fiso - fisr  (Fisher-z scale)
Secondary out : |fiso| vs |fisr|                  (magnitude)
Tertiary descr: relative_es = rr/ro               (descriptive only)

Report per discipline: n, median(Delta), mean(Delta), 95% bootstrap CI
(10 000 resamples) of median, paired Wilcoxon signed-rank, paired-t,
% fiso>fisr, median(|fiso|), median(|fisr|), Wilcoxon on magnitudes,
median(relative_es). Plus stratification by `replicated`, and exploratory
US-vs-non-US and English-vs-non-English.
"""

import json
from pathlib import Path
import numpy as np
import pandas as pd
from scipy import stats

ROOT = Path("/workspace")
DATA = ROOT / "data" / "meta-regression_joined_data_heterogeneity_in_replication_projects.csv"
OUT  = ROOT / "artifacts"
OUT.mkdir(exist_ok=True)
RNG = np.random.default_rng(20261021)
B  = 10_000

# ----------------------------- load ---------------------------------
df = pd.read_csv(DATA)
df["delta"]      = df["fiso"] - df["fisr"]
df["abs_fiso"]   = df["fiso"].abs()
df["abs_fisr"]   = df["fisr"].abs()
df["abs_delta"]  = df["abs_fiso"] - df["abs_fisr"]
df["country_o_us"]  = (df["experiment_country.o"]  == "United States").astype(int)
df["language_o_en"] = (df["experiment_language.o"] == "English").astype(int)

# ----------------------------- helpers ------------------------------
def paired_block(y, op="fiso_minus_fisr"):
    if op == "fiso_minus_fisr":
        a, b = y["fiso"].to_numpy(), y["fisr"].to_numpy()
    elif op == "abs":
        a, b = y["abs_fiso"].to_numpy(), y["abs_fisr"].to_numpy()
    elif op == "rel":
        r = y["relative_es"].astype(float).to_numpy()
        return {"n": len(y),
                "median": float(np.nanmedian(r)),
                "mean":   float(np.nanmean(r))}
    n = len(y)
    d = a - b
    if n >= 2 and np.any(d != 0):
        try:
            w, p = stats.wilcoxon(a, b, zero_method="wilcox", alternative="two-sided")
        except ValueError:
            w, p = np.nan, np.nan
    else:
        w, p = np.nan, np.nan
    if n >= 2:
        try:
            t, pt = stats.ttest_rel(a, b)
        except Exception:
            t, pt = np.nan, np.nan
    else:
        t, pt = np.nan, np.nan
    return {
        "n": n,
        "median":   float(np.median(d)),
        "mean":     float(np.mean(d)),
        "q25":      float(np.quantile(d, 0.25)),
        "q75":      float(np.quantile(d, 0.75)),
        "pct_original_larger": float((d > 0).mean() * 100),
        "w_stat":   float(w) if w == w else None,
        "w_p":      float(p) if p == p else None,
        "t_stat":   float(t) if t == t else None,
        "t_p":      float(pt) if pt == pt else None,
        "median_a": float(np.median(a)),
        "median_b": float(np.median(b)),
        "mean_a":   float(np.mean(a)),
        "mean_b":   float(np.mean(b)),
    }

def bootstrap_ci(d, n=B, ci=(2.5, 97.5)):
    d = np.asarray(d, dtype=float)
    d = d[~np.isnan(d)]
    if len(d) == 0: return (np.nan, np.nan)
    idx = RNG.integers(0, len(d), size=(n, len(d)))
    meds = np.median(d[idx], axis=1)
    return (float(np.percentile(meds, ci[0])), float(np.percentile(meds, ci[1])))

# ----------------------------- 1. global sanity ----------------------
n_total = len(df)
print("="*78); print(f"GLOBAL (n={n_total})")
gdelta = df["delta"].to_numpy()
print(f"  median Delta = {np.median(gdelta):+.4f}  mean Delta = {np.mean(gdelta):+.4f}  "
      f"% fiso>fisr = {(gdelta>0).mean()*100:.1f}%  "
      f"replication rate = {df['replicated'].mean()*100:.1f}%")
lo, hi = bootstrap_ci(gdelta)
print(f"  bootstrap 95% CI of median Delta: [{lo:+.4f}, {hi:+.4f}]")
w, pw = stats.wilcoxon(df["fiso"], df["fisr"])
print(f"  Wilcoxon signed-rank (Delta): W={w:.1f}, p={pw:.3e}")
print(f"  |fiso| median = {df['abs_fiso'].median():.4f}   |fisr| median = {df['abs_fisr'].median():.4f}")
w2, pw2 = stats.wilcoxon(df["abs_fiso"], df["abs_fisr"])
print(f"  Wilcoxon on |.|:  W={w2:.1f}, p={pw2:.3e}")

# ----------------------------- 2. by discipline ---------------------
print("\n" + "="*78)
print("BY DISCIPLINE  (primary domain; equivalent to project here)")
print("="*78)
disc_results = {}
for disc in ["Cognitive", "Social", "Economics"]:
    sub = df[df["discipline"] == disc].copy()
    bs = paired_block(sub, "fiso_minus_fisr")
    lo, hi = bootstrap_ci(sub["delta"].to_numpy())
    bs["delta_ci_lo"] = lo; bs["delta_ci_hi"] = hi
    bm = paired_block(sub, "abs")
    br = paired_block(sub, "rel")
    disc_results[disc] = {"signed": bs, "magnitude": bm, "relative_es": br}
    print(f"\n--- {disc} (n={len(sub)}) ---")
    print(f"  Signed Delta = fiso - fisr:")
    print(f"    median={bs['median']:+.4f}  mean={bs['mean']:+.4f}  "
          f"Q25={bs['q25']:+.4f}  Q75={bs['q75']:+.4f}")
    print(f"    bootstrap 95% CI of median Delta: [{lo:+.4f}, {hi:+.4f}]")
    print(f"    % fiso>fisr: {bs['pct_original_larger']:.1f}%   "
          f"Wilcoxon p={bs['w_p']:.3e}   paired-t p={bs['t_p']:.3e}")
    print(f"  Magnitude |.|: median |fiso|={bm['median_a']:.4f}, "
          f"median |fisr|={bm['median_b']:.4f}; Wilcoxon on magnitudes p={bm['w_p']:.3e}")
    print(f"  Tertiary relative_es: median={br['median']:+.4f}  mean={br['mean']:+.4f}")

# ----------------------------- 3. replicated stratification ----------
print("\n" + "="*78)
print("STRATIFICATION BY `replicated` (1=si, 0=no) WITHIN DISCIPLINE")
print("="*78)
strat = {}
for disc in ["Cognitive", "Social", "Economics"]:
    for rep in [1, 0]:
        sub = df[(df["discipline"] == disc) & (df["replicated"] == rep)]
        if len(sub) < 2:
            print(f"  {disc} x replicated={rep}: n={len(sub)} (insufficient)")
            continue
        b = paired_block(sub, "fiso_minus_fisr")
        lo, hi = bootstrap_ci(sub["delta"].to_numpy())
        b["delta_ci_lo"] = lo; b["delta_ci_hi"] = hi
        strat[f"{disc}|rep={rep}"] = b
        print(f"  {disc:10s} x replicated={rep}  (n={len(sub):2d})  "
              f"median Delta={b['median']:+.4f}  "
              f"95%CI=[{lo:+.4f},{hi:+.4f}]  "
              f"Wilcox p={b['w_p']:.3e}  "
              f"%fiso>fisr={b['pct_original_larger']:.1f}%")

# ----------------------------- 4. exploratory -----------------------
print("\n" + "="*78); print("EXPLORATORY (low statistical power)"); print("="*78)
def report_bin(label, mask):
    sub = df[mask].copy()
    if len(sub) < 2: return None
    b = paired_block(sub, "fiso_minus_fisr")
    lo, hi = bootstrap_ci(sub["delta"].to_numpy())
    print(f"  {label:30s} n={len(sub):2d}  "
          f"median Delta={b['median']:+.4f}  "
          f"95%CI=[{lo:+.4f},{hi:+.4f}]  "
          f"Wilcox p={b['w_p']:.3e}  "
          f"%fiso>fisr={b['pct_original_larger']:.1f}%")
    return {"n": len(sub), "median": b['median'], "ci": [lo, hi],
            "wilcoxon_p": b['w_p'], "pct_orig_larger": b['pct_original_larger']}

us_yes = report_bin("country_o = United States",   df["country_o_us"] == 1)
us_no  = report_bin("country_o != United States",   df["country_o_us"] == 0)
en_yes = report_bin("language_o = English (orig)",  df["language_o_en"] == 1)
en_no  = report_bin("language_o != English (orig)",  df["language_o_en"] == 0)

# ----------------------------- 5. ASCII visuals ---------------------
print("\n" + "="*78); print("ASCII VISUALS"); print("="*78)
def strip_text(values, label, width=60, bins=20):
    print(f"\n{label}  (n={len(values)}, each vertical-bar = 1 study at that x)")
    lo, hi = np.percentile(values, [2, 98])
    if hi == lo: hi = lo + 1e-6
    borders = np.linspace(lo, hi, bins + 1)
    counts, _ = np.histogram(values, bins=borders)
    scale = (width - 18) / max(counts.max(), 1)
    for i in range(bins):
        bar = "|" * max(1, int(round(counts[i] * scale)))
        print(f"  [{borders[i]:+6.3f},{borders[i+1]:+6.3f}]  {counts[i]:3d}  {bar}")
    print(f"   min={values.min():+.3f}  max={values.max():+.3f}  median={np.median(values):+.3f}")

def bar_compare(label_left, label_right, v_left, v_right, scale=60):
    print(f"\n{label_left} vs {label_right}:")
    mx = max(v_left, v_right, 1e-9)
    L = int(round(v_left / mx * scale)); R = int(round(v_right / mx * scale))
    print(f"  {label_left:<10s} |{'#'*L}{' '*(scale-L)}| {v_left:.4f}")
    print(f"  {label_right:<10s} |{'#'*R}{' '*(scale-R)}| {v_right:.4f}")

for disc in ["Cognitive", "Social", "Economics"]:
    strip_text(df[df["discipline"]==disc]["delta"].to_numpy(),
               f"Strip of Delta = fiso - fisr   [{disc}]")

print("\nMEDIAN (|fiso|, |fisr|) BY DISCIPLINE (Fisher-z)")
for disc in ["Cognitive", "Social", "Economics"]:
    sub = df[df["discipline"] == disc]
    bar_compare("|fiso|", "|fisr|", sub["abs_fiso"].median(),
                sub["abs_fisr"].median(), scale=60)

print("\nDIRECTION SUMMARY (per discipline)")
for disc in ["Cognitive", "Social", "Economics"]:
    sub = df[df["discipline"] == disc]
    lo, hi = bootstrap_ci(sub["delta"].to_numpy())
    direction = "ORIGINAL > REPLICATION" if (lo > 0 or disc_results[disc]["signed"]["w_p"] < 0.05) \
                else "no clear directional gap"
    print(f"  {disc:10s}  median Delta={disc_results[disc]['signed']['median']:+.4f}  "
          f"CI=[{lo:+.4f},{hi:+.4f}]  -> {direction}")

# ----------------------------- 6. save results ----------------------
g = paired_block(df, "fiso_minus_fisr")
g["delta_ci_lo"], g["delta_ci_hi"] = bootstrap_ci(df["delta"])
out = {
    "n_total": int(n_total),
    "n_replicated": int(df["replicated"].sum()),
    "global": g,
    "global_magnitude": paired_block(df, "abs"),
    "by_discipline": disc_results,
    "stratified_replicated": strat,
    "exploratory": {
        "country_o_united_states":     us_yes,
        "country_o_not_united_states": us_no,
        "language_o_english":          en_yes,
        "language_o_not_english":      en_no,
    },
    "note_collinearity": ("`discipline` is perfectly collinear with `project` in this "
                          "dataset: Cognitive+Social <-> Psychology (n=68); Economics "
                          "<-> Experimental Economics (n=18). Discipline chosen because "
                          "it yields 3 cells vs 2."),
}
with open(OUT/"results.json", "w") as f:
    json.dump(out, f, indent=2, default=str)
print(f"\nWrote {OUT/'results.json'}")
