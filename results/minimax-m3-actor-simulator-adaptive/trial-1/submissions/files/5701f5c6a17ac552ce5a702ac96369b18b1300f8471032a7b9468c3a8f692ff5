def render_hist_overlay(W, H, data_by_race, title, xlabel, ylabel, out_path, bins=40):
    img = Image.new('RGB', (W, H), 'white')
    d = ImageDraw.Draw(img)
    margin_l, margin_r, margin_t, margin_b = 80, 30, 70, 80
    pw, ph = W - margin_l - margin_r, H - margin_t - margin_b
    d.text((W/2 - len(title)*5, 20), title, fill='black', font=FONT_TITLE)
    all_v = np.concatenate(list(data_by_race.values()))
    lo_b, hi_b = float(all_v.min()), float(all_v.max())
    edges = np.linspace(lo_b, hi_b, bins+1)
    counts = {r: np.histogram(data_by_race[r], bins=edges)[0] for r in race_grid}
    max_c = max(counts[r].max() for r in race_grid)
    def to_px(xv, yv):
        px = margin_l + (xv - lo_b) / (hi_b - lo_b) * pw
        py = margin_t + (1 - yv / max_c) * ph
        return px, py
    for v in np.linspace(lo_b, hi_b, 7):
        px, _ = to_px(v, 0)
        d.line([(px, margin_t), (px, margin_t + ph)], fill=(230,230,230), width=1)
    for v in np.linspace(lo_b, hi_b, 7):
        px, py = to_px(v, 0)
        d.line([(px, margin_t + ph), (px, margin_t + ph + 5)], fill='black', width=1)
        d.text((px - 18, margin_t + ph + 8), f'{v:+.2f}', fill='black', font=FONT_SMALL)
    for v in np.linspace(0, max_c, 6):
        _, py = to_px(0, v)
        d.line([(margin_l - 5, py), (margin_l, py)], fill='black', width=1)
        d.text((margin_l - 60, py - 7), f'{int(v)}', fill='black', font=FONT_SMALL)
    color_map = {'White':'#1f77b4','Black':'#d62728','Hispanic':'#2ca02c'}
    alpha_map = {'White':140,'Black':140,'Hispanic':140}
    for r in race_grid:
        c = counts[r]
        col_rgb = tuple(int(color_map[r].lstrip('#')[i:i+2],16) for i in (0,2,4))
        bimg = Image.new('RGBA', (W, H), (255,255,255,0))
        bd = ImageDraw.Draw(bimg)
        for i, n_ in enumerate(c):
            x0 = margin_l + i*pw/bins
            x1 = x0 + pw/bins*0.9
            y0 = margin_t + (1 - n_/max_c)*ph
            y1 = margin_t + ph
            bd.rectangle([x0, y0, x1, y1], fill=col_rgb + (alpha_map[r],))
        img.paste(bimg, (0,0), bimg)
    d = ImageDraw.Draw(img)
    d.line([(margin_l, margin_t), (margin_l, margin_t + ph)], fill='black', width=2)
    d.line([(margin_l, margin_t + ph), (margin_l + pw, margin_t + ph)], fill='black', width=2)
    d.text((W/2 - len(xlabel)*4, H - 25), xlabel, fill='black', font=FONT_MED)
    lx = margin_l + 20; ly = margin_t + 15
    for r in race_grid:
        col = color_map[r]
        col_rgb = tuple(int(col.lstrip('#')[i:i+2],16) for i in (0,2,4))
        d.rectangle([lx, ly+2, lx+25, ly+18], fill=col_rgb)
        d.text((lx + 32, ly + 1), r, fill='black', font=FONT_MED)
        ly += 25
    img.save(out_path)

