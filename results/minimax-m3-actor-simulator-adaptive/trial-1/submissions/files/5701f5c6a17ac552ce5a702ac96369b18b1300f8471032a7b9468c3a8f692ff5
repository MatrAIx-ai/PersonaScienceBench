"""
Main analysis script for DiscoveryBench NLS-SES episode.

Question: Is the relation between socioeconomic status and chances of degree
completion affected by racial lines of the individual?

Method (approved plan):
  (a) Firth penalized logit of BA DEGREE COMPLETED on SES, Race (3 lvls),
      interaction SES x Race, +ASVAB z, PERCENTILE z, sex, family size.
  (b) Stratified-by-race logit as secondary (route b).
  (c) Curves + AUC + forest plot (route c).

Outputs (saved under /workspace/outputs/):
  firth_coefs.csv, metrics.json, figure_predprob.png, figure_forest.png,
  figure_common_support.png, bootstraps_OR.npz, bootstraps_AME.npz,
  execution_log.txt
"""
from __future__ import annotations
import json, os, sys, time, warnings
from pathlib import Path

import numpy as np
import pandas as pd
import statsmodels.api as sm
from scipy import stats
from scipy.special import expit

sys.path.insert(0, '/workspace')
from firth import fit_firth_logit, lr_test

warnings.filterwarnings('ignore')

OUT = Path('/workspace/outputs'); OUT.mkdir(parents=True, exist_ok=True)
DATA = '/workspace/data/nls_ses_processed.csv'
RNG = np.random.default_rng(20251021)
B_BOOT = 1000

log_lines = []
def log(msg):
    print(msg); log_lines.append(str(msg))

# 1. Load + preprocess
log('=== Step 1. Load + preprocess ===')
df = pd.read_csv(DATA, index_col=0)
log(f'Shape: {df.shape}; columns: {list(df.columns)}')

df['BA_DEG_INT'] = df['BA DEGREE COMPLETED'].astype(int)
df['FEMALE'] = (df['SAMPLE_SEX'] == 'Female').astype(int)
df['RACE_BLACK'] = (df['SAMPLE_RACE'] == 'Black').astype(int)
df['RACE_HISP']  = (df['SAMPLE_RACE'] == 'Hispanic').astype(int)
df['ASVAB_Z']     = (df['ABILITY: COMPOSITE OF ASVAB SCORE'] - df['ABILITY: COMPOSITE OF ASVAB SCORE'].mean()) / df['ABILITY: COMPOSITE OF ASVAB SCORE'].std()
df['PCTILE_Z']    = (df['PERCENTILE IN CLASS'] - df['PERCENTILE IN CLASS'].mean()) / df['PERCENTILE IN CLASS'].std()
df['SES_X_BLACK'] = df['SES'] * df['RACE_BLACK']
df['SES_X_HISP']  = df['SES'] * df['RACE_HISP']

log(f'Events: {df["BA_DEG_INT"].sum()} / {len(df)} = {df["BA_DEG_INT"].mean()*100:.2f}%')
log(f'Race counts: {df["SAMPLE_RACE"].value_counts().to_dict()}')
log(f'Sex counts: {df["SAMPLE_SEX"].value_counts().to_dict()}')

y_col = 'BA_DEG_INT'
X_cols = ['SES','RACE_BLACK','RACE_HISP','SES_X_BLACK','SES_X_HISP',
          'ASVAB_Z','PCTILE_Z','FEMALE','FAMILY SIZE OF SAMPLE']
y = df[y_col].values.astype(float)
X = sm.add_constant(df[X_cols].values.astype(float), has_constant='add')
col_names = ['const'] + X_cols
race_grid = ['White','Black','Hispanic']

# 2. Common support
log('\n=== Step 2. Common support ===')
for r, sub in df.groupby('SAMPLE_RACE'):
    qs = sub['SES'].quantile([0,.05,.25,.5,.75,.95,1])
    log(f'  {r}: n={len(sub)}  min={qs[0.00]:.3f}  p05={qs[0.05]:.3f}  p25={qs[0.25]:.3f}  '
        f'p50={qs[0.50]:.3f}  p75={qs[0.75]:.3f}  p95={qs[0.95]:.3f}  max={qs[1.00]:.3f}')
SUP_LO = max(df.groupby('SAMPLE_RACE')['SES'].quantile(0.05).max(), -np.inf)
SUP_HI = min(df.groupby('SAMPLE_RACE')['SES'].quantile(0.95).min(),  np.inf)
log(f'Common support region (5%-95%): SES in [{SUP_LO:.3f}, {SUP_HI:.3f}]')

# 3. Firth penalized logit - full and reduced models
log('\n=== Step 3. Firth penalized logit ===')
t0 = time.time()
res_full = fit_firth_logit(X, y)
log(f'Full model converged: {res_full["converged"]}  (iters: {res_full["n_iter"]}, pen_ll={res_full["pen_loglik"]:.3f})')
log(f'Fit time: {time.time()-t0:.2f}s')

keep_idx_red = [0,1,2,3,6,7,8,9]  # const, SES, RACE_BLACK, RACE_HISP, ASVAB_Z, PCTILE_Z, FEMALE, FAMILY SIZE
X_red = X[:, keep_idx_red]
res_red = fit_firth_logit(X_red, y)
log(f'Reduced model converged: {res_red["converged"]}  (iters: {res_red["n_iter"]}, pen_ll={res_red["pen_loglik"]:.3f})')

lr_stat, lr_df, lr_p = lr_test(res_full['pen_loglik'], len(res_full['beta']),
                               res_red['pen_loglik'], len(res_red['beta']))
log(f'LRT for interaction block (df={lr_df}): chi2={lr_stat:.3f}  p={lr_p:.4g}')

b_int = res_full['beta'][4:6]
S_int = res_full['Hinv'][4:6, 4:6]
try:
    wald_stat = float(b_int @ np.linalg.inv(S_int) @ b_int)
    wald_p = 1.0 - stats.chi2.cdf(wald_stat, 2)
except Exception:
    wald_stat, wald_p = np.nan, np.nan
log(f'Wald joint (df=2): chi2={wald_stat:.3f}  p={wald_p:.4g}')

def make_coef_table(res, names):
    beta = res['beta']; se = res['se']
    ci_lo = beta - 1.96 * se; ci_hi = beta + 1.96 * se
    z = beta / np.where(se>0, se, np.nan)
    return pd.DataFrame({
        'variable': list(names),
        'beta': beta, 'se': se,
        'ci_lo': ci_lo, 'ci_hi': ci_hi,
        'z': z, 'OR': np.exp(beta), 'OR_lo': np.exp(ci_lo), 'OR_hi': np.exp(ci_hi),
        'p_2sided': 2*(1-stats.norm.cdf(np.abs(z)))
    })

coef_full_df = make_coef_table(res_full, col_names)
coef_red_df  = make_coef_table(res_red,
                                [col_names[i] for i in keep_idx_red])
log('\nFull model coefficients (Firth pen. logit):')
log(coef_full_df.round(4).to_string(index=False))
coef_full_df.to_csv(OUT / 'firth_coefs.csv', index=False)

def compute_vif(X_df):
    cols = list(X_df.columns)
    Xv = X_df.values.astype(float)
    vifs = {}
    for j, c in enumerate(cols):
        others = [i for i,cc in enumerate(cols) if cc != c]
        Xo = sm.add_constant(Xv[:, others])
        yj = Xv[:, j]
        coef, *_ = np.linalg.lstsq(Xo, yj, rcond=None)
        pred = Xo @ coef
        ss_res = float(((yj - pred)**2).sum())
        ss_tot = float(((yj - yj.mean())**2).sum())
        r2 = ss_res/ss_tot if ss_tot>0 else 0.0
        vifs[c] = 1.0 / max(1 - r2, 1e-9)
    return vifs
vif = compute_vif(df[X_cols])
log('\nVIF (per predictor):')
for k, v in vif.items():
    log(f'  {k:32s}  {v:.3f}')

n_events = int(y.sum())
n_predictors = len(X_cols) + 1
epv_global = n_events / n_predictors
log(f'\nEvents: {n_events}  ; predictors (+int_block + const): {n_predictors}  ; EPV={epv_global:.2f}')

log('\nMean FAMILY SIZE OF SAMPLE by race:')
log(df.groupby('SAMPLE_RACE')['FAMILY SIZE OF SAMPLE'].agg(['count','mean','std']).round(3).to_string())

# 4. Predicted probabilities + AMEs
log('\n=== Step 4. Predicted probs + AMEs ===')
fam_med = float(df['FAMILY SIZE OF SAMPLE'].median())

def profile(ses_val, race_label):
    out = []
    out.append(1.0)  # intercept
    out.append(ses_val)
    out.append(1.0 if race_label == 'Black' else 0.0)
    out.append(1.0 if race_label == 'Hispanic' else 0.0)
    out.append(ses_val * (1.0 if race_label == 'Black' else 0.0))
    out.append(ses_val * (1.0 if race_label == 'Hispanic' else 0.0))
    out.append(0.0)  # ASVAB z = 0
    out.append(0.0)  # Pctl z = 0
    out.append(0.5)  # avg sex (50/50 average of dummies) -- actually let me set 0 (Female=0); options: avg
    out.append(fam_med)
    return np.array(out)

def P_BA(ses_val, race_label, beta=res_full['beta']):
    return expit(profile(ses_val, race_label).reshape(1,-1) @ beta)[0]

ses_grid = np.linspace(SUP_LO, SUP_HI, 80)
curve = {r: np.array([P_BA(s, r) for s in ses_grid]) for r in race_grid}
log('Predicted P(BA=1) at SES=-0.5, 0, +0.5 (fam size median; ASVAB=0, Percentile=0, female-proportion=0.5):')
for r in race_grid:
    p_low = P_BA(-0.5, r); p_mid = P_BA(0.0, r); p_hi = P_BA(0.5, r)
    log(f'  {r:8s}: -0.5 -> {p_low*100:.3f}%   0 -> {p_mid*100:.3f}%   +0.5 -> {p_hi*100:.3f}%')

q1 = float(df['SES'].quantile(0.25))
q4 = float(df['SES'].quantile(0.75))
ame_q4_minus_q1 = {r: float(P_BA(q4, r) - P_BA(q1, r)) for r in race_grid}
log(f'\nDelta(BA predicted prob) for SES going from Q1={q1:.3f} to Q4={q4:.3f}:')
for r, v in ame_q4_minus_q1.items():
    log(f'  {r:8s}: D = {v*100:+.3f} percentage points')

def ame_ses_race(race_label, beta=res_full['beta'], eps=1e-4):
    p_plus  = P_BA(0 + eps, race_label, beta)
    p_minus = P_BA(0 - eps, race_label, beta)
    return float((p_plus - p_minus) / (2*eps))
ame_per_sd = {r: ame_ses_race(r) for r in race_grid}
log('\nMarginal effect of +1 SES unit on P(BA), evaluated at SES=0:')
for r, v in ame_per_sd.items():
    log(f'  {r:8s}: dP/dSES = {v*100:+.3f} pp per +1 unit of SES (sd(SES)={df["SES"].std():.3f})')

# 5. AUC
log('\n=== Step 5. AUC by subgroup ===')
def auc_mwu(y_true, scores):
    y_true = np.asarray(y_true); scores = np.asarray(scores)
    pos = scores[y_true == 1]; neg = scores[y_true == 0]
    if len(pos) == 0 or len(neg) == 0: return np.nan
    from scipy.stats import rankdata
    ranks = rankdata(np.concatenate([pos, neg]), method='average')
    R_pos = ranks[:len(pos)].sum()
    n_pos = len(pos); n_neg = len(neg)
    U = R_pos - n_pos*(n_pos+1)/2
    return float(U / (n_pos * n_neg))

lp = X @ res_full['beta']
auc_global = auc_mwu(y, lp)
log(f'  AUC (global) = {auc_global:.4f}')
auc_by_race = {}
for r in race_grid:
    mask = (df['SAMPLE_RACE'] == r).values
    auc_by_race[r] = auc_mwu(y[mask], lp[mask])
    log(f'  AUC | {r:8s} = {auc_by_race[r]:.4f}  (n={int(mask.sum())}, events={int(y[mask].sum())})')

# 6. Bootstrap (stratified by race)
log('\n=== Step 6. Bootstrap (B=%d, stratified by race) ===' % B_BOOT)
race_arr = df['SAMPLE_RACE'].values
t0 = time.time()
boot_or = []
boot_ame_pp = []
n_success = 0
idx_by_race = {r: np.where(race_arr == r)[0] for r in race_grid}

for b in range(B_BOOT):
    idx = []
    for r in race_grid:
        idx.append(RNG.choice(idx_by_race[r], size=len(idx_by_race[r]), replace=True))
    idx = np.concatenate(idx)
    Xb = X[idx]; yb = y[idx]
    try:
        rb = fit_firth_logit(Xb, yb)
        if not rb['converged']:
            continue
        boot_or.append(rb['beta'])
        bp = rb['beta']
        ames_b = []
        for r in race_grid:
            p_plus  = expit(profile( 0 + 1e-3, r) @ bp)
            p_minus = expit(profile( 0 - 1e-3, r) @ bp)
            ames_b.append((p_plus - p_minus) / (2e-3))
        boot_ame_pp.append(ames_b)
        n_success += 1
    except Exception:
        continue

boot_or = np.array(boot_or)
boot_ame_pp = np.array(boot_ame_pp)
log(f'Bootstrap finished: {n_success}/{B_BOOT} successful reps in {time.time()-t0:.1f}s')
np.savez(OUT / 'bootstraps_OR.npz', boot_or=boot_or, beta_names=np.array(col_names))
np.savez(OUT / 'bootstraps_AME.npz', boot_ame_pp=boot_ame_pp, races=np.array(race_grid))

def ci95(arr, axis=0):
    arr = np.asarray(arr)
    if arr.size == 0: return (np.nan, np.nan, np.nan)
    med = np.nanmedian(arr, axis=axis)
    lo = np.nanpercentile(arr, 2.5, axis=axis)
    hi = np.nanpercentile(arr, 97.5, axis=axis)
    return med, lo, hi

or_med, or_lo, or_hi = ci95(np.exp(boot_or), axis=0)
log('\nBootstrap OR median [95% CI] per parameter:')
for nm, m, lo, hi in zip(col_names, or_med, or_lo, or_hi):
    log(f'  {nm:32s}  {m:.3f}  [{lo:.3f}, {hi:.3f}]')

ame_med_pp, ame_lo_pp, ame_hi_pp = ci95(boot_ame_pp * 100, axis=0)
log('\nBootstrap AME of +1 SES unit at SES=0 (pp) [95% CI]:')
for r, m, lo, hi in zip(race_grid, ame_med_pp, ame_lo_pp, ame_hi_pp):
    log(f'  {r:8s}  {m:+.3f}  [{lo:+.3f}, {hi:+.3f}]')

if boot_ame_pp.shape[0] > 0:
    diff_BW = boot_ame_pp[:, race_grid.index('Black')]  - boot_ame_pp[:, race_grid.index('White')]
    diff_HW = boot_ame_pp[:, race_grid.index('Hispanic')]- boot_ame_pp[:, race_grid.index('White')]
    diff_BH = boot_ame_pp[:, race_grid.index('Black')]  - boot_ame_pp[:, race_grid.index('Hispanic')]
    log('\nPairwise AME differences:')
    for lbl, arr in [('Black-White', diff_BW), ('Hispanic-White', diff_HW), ('Black-Hispanic', diff_BH)]:
        m = float(np.nanmedian(arr*100)); lo = float(np.nanpercentile(arr*100,2.5)); hi = float(np.nanpercentile(arr*100,97.5))
        log(f'  {lbl:18s}  D AME = {m:+.3f} pp  [{lo:+.3f}, {hi:+.3f}]')

# 7. Stratified models (route b)
log('\n=== Step 7. Stratified logit models (route b) ===')
strat_coefs = {}
strat_ame_q4_q1 = {}
for r in race_grid:
    sub = df[df['SAMPLE_RACE'] == r]
    sub_X = sm.add_constant(sub[['SES','ASVAB_Z','PCTILE_Z','FEMALE','FAMILY SIZE OF SAMPLE']].values.astype(float))
    sub_y = sub['BA_DEG_INT'].values.astype(float)
    try:
        rr = sm.Logit(sub_y, sub_X).fit(disp=False, method='newton', maxiter=200, warn_convergence=False)
        sess = rr.params[1]; se_sess = rr.bse[1]
        b_sess = float(np.exp(sess)); b_lo = float(np.exp(sess-1.96*se_sess)); b_hi = float(np.exp(sess+1.96*se_sess))
        ses_q1 = float(sub['SES'].quantile(0.25)); ses_q4 = float(sub['SES'].quantile(0.75))
        meds = sub[['ASVAB_Z','PCTILE_Z','FEMALE','FAMILY SIZE OF SAMPLE']].median().values
        def linp(ses):
            return float(rr.params[0] + rr.params[1]*ses + np.dot(meds, rr.params[2:]))
        ame_pp = float((expit(linp(ses_q4)) - expit(linp(ses_q1))) * 100)
        log(f'  {r:8s}: beta_SES={sess:.3f}  (SE={se_sess:.3f})  OR={b_sess:.3f} '
            f'[{b_lo:.3f},{b_hi:.3f}]   AME D(Q4-Q1)={ame_pp:+.3f} pp   events={sub_y.sum()}/{len(sub_y)}')
        strat_coefs[r] = {'beta_SES': sess, 'se_SES': se_sess,
                          'OR': b_sess, 'OR_lo': b_lo, 'OR_hi': b_hi,
                          'n': int(len(sub_y)), 'events': int(sub_y.sum())}
        strat_ame_q4_q1[r] = ame_pp
    except Exception as e:
        log(f'  {r} failed: {e}')

# 8. Plots with PIL
log('\n=== Step 8. Plots (PIL) ===')
sys.path.insert(0, '/usr/lib/python3/dist-packages')
from PIL import Image, ImageDraw, ImageFont

def find_font(size=14):
    paths = [
        '/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf',
        '/usr/share/fonts/truetype/liberation/LiberationSans-Bold.ttf',
        '/usr/share/fonts/truetype/freefont/FreeSansBold.ttf',
        '/usr/share/fonts/truetype/ubuntu/Ubuntu-Bold.ttf',
    ]
    for p in paths:
        if os.path.exists(p):
            return ImageFont.truetype(p, size)
    # fall back to default which is small bitmap
    return ImageFont.load_default()

FONT_BIG   = find_font(18)
FONT_MED   = find_font(14)
FONT_SMALL = find_font(11)
FONT_TITLE = find_font(22)

def render_chart(W, H, title, xlabel, ylabel, series, out_path,
                 xlim=None, ylim=(0,None), colors=None, legend=True,
                 yticks=None, xticks=None, grid=True):
    img = Image.new('RGB', (W, H), 'white')
    d = ImageDraw.Draw(img)
    margin_l, margin_r, margin_t, margin_b = 90, 30, 70, 80
    pw, ph = W - margin_l - margin_r, H - margin_t - margin_b
    all_x = np.concatenate([np.atleast_1d(series[k][0]) for k in series])
    all_y = np.concatenate([np.atleast_1d(series[k][1]) for k in series])
    if xlim is None:
        xmin, xmax = float(all_x.min()), float(all_x.max())
    else:
        xmin, xmax = xlim
    if ylim[0] is None:
        ymin = float(all_y.min())
    else:
        ymin = ylim[0]
    if ylim[1] is None:
        ymax = float(all_y.max())
    else:
        ymax = ylim[1]
    if ymin == ymax: ymax += 0.01
    if xmin == xmax: xmax += 0.01

    def to_px(xv, yv):
        px = margin_l + (xv - xmin) / (xmax - xmin) * pw
        py = margin_t + (1 - (yv - ymin) / (ymax - ymin)) * ph
        return px, py

    if grid:
        for v in np.linspace(ymin, ymax, 6):
            px, py = to_px(xmin, v)
            d.line([(margin_l, py), (W - margin_r, py)], fill=(220,220,220), width=1)
    if xticks is None:
        xticks = np.linspace(xmin, xmax, 6)
    for xv in xticks:
        px, py = to_px(xv, ymin)
        d.line([(px, margin_t + ph), (px, margin_t + ph + 5)], fill='black', width=1)
        d.text((px - 18, margin_t + ph + 8), f'{xv:+.2f}', fill='black', font=FONT_SMALL)
    if yticks is None:
        yticks = np.linspace(ymin, ymax, 6)
    for yv in yticks:
        px, py = to_px(xmin, yv)
        d.line([(margin_l - 5, py), (margin_l, py)], fill='black', width=1)
        if ymax <= 0.30:
            d.text((margin_l - 60, py - 7), f'{yv*100:.2f}%', fill='black', font=FONT_SMALL)
        else:
            d.text((margin_l - 60, py - 7), f'{yv:.3f}', fill='black', font=FONT_SMALL)
    d.line([(margin_l, margin_t), (margin_l, margin_t + ph)], fill='black', width=2)
    d.line([(margin_l, margin_t + ph), (margin_l + pw, margin_t + ph)], fill='black', width=2)

    color_map = {'White':'#1f77b4','Black':'#d62728','Hispanic':'#2ca02c'}
    if colors: color_map.update(colors)
    for r, (xs, ys) in series.items():
        col = color_map.get(r, 'black')
        pts = [to_px(x, y) for x, y in zip(xs, ys)]
        d.line(pts, fill=col, width=3)
    d.text((W/2 - len(title)*5, 20), title, fill='black', font=FONT_TITLE)
    d.text((W/2 - len(xlabel)*4, H - 25), xlabel, fill='black', font=FONT_MED)
    if legend:
        lx = margin_l + 20; ly = margin_t + 15
        for k in series:
            col = color_map.get(k, 'black')
            d.line([(lx, ly+10), (lx+30, ly+10)], fill=col, width=3)
            d.text((lx + 40, ly + 1), k, fill='black', font=FONT_MED)
            ly += 25
    img.save(out_path)

# Predprob plot - max-aware ylim
series_predprob = {r: (ses_grid, curve[r]) for r in race_grid}
ymax_pp = max(curve[r].max() for r in race_grid) * 1.25
render_chart(900, 560,
             'Predicted P(BA) vs SES by race (Firth model; ASVAB/Percentile z=0, family size=median)',
             'SES',
             'P(BA=1)',
             series_predprob,
             OUT / 'figure_predprob.png',
             xlim=(ses_grid.min(), ses_grid.max()),
             ylim=(0, ymax_pp),
             )
log('  saved figure_predprob.png')

# Forest plot
def render_forest(W, H, rows, out_path, title='Forest of ORs (Firth 95% CI)'):
    img = Image.new('RGB', (W, H), 'white')
    d = ImageDraw.Draw(img)
    margin_l, margin_r, margin_t, margin_b = 280, 220, 70, 80
    pw, ph = W - margin_l - margin_r, H - margin_t - margin_b
    d.text((W/2 - len(title)*5, 20), title, fill='black', font=FONT_TITLE)
    all_or = []
    for r_ in rows: all_or += [r_['OR_lo'], r_['OR_hi']]
    all_or = np.array(all_or)
    xmin = float(np.floor(np.log10(np.clip(all_or, 0.01, None)).min()))
    xmax = float(np.ceil(np.log10(all_or).max()))
    if xmin == xmax: xmax += 1
    def to_px(orv):
        return margin_l + (np.log10(orv) - xmin) / (xmax - xmin) * pw
    for i in range(int(xmin), int(xmax)+1):
        v = 10**i
        px = to_px(v)
        d.line([(px, margin_t), (px, margin_t + ph)], fill=(220,220,220), width=1)
        d.text((px - 10, margin_t + ph + 8), f'10^{i}', fill='black', font=FONT_SMALL)
    px1 = to_px(1.0)
    d.line([(px1, margin_t), (px1, margin_t + ph)], fill='black', width=2)
    n = len(rows); row_h = ph / max(n, 1)
    for i, r_ in enumerate(rows):
        y0 = margin_t + i*row_h; ymid = y0 + row_h/2
