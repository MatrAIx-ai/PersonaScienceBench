"""
analysis.py — Policy for ASIBench *levin_context_grid_search*.

This module is the submission artifact. It is self-contained: it does not import
any external `analysis` module (and does not need to be imported as one — the
file IS the analysis).

Public surface
--------------
The task asks for either a factory or a Policy class. We provide both, with the
same `action_probs(level, state, legal_actions) -> dict[str, float]` method.

    policy = make_policy(training_data, config=None)
    out = policy.action_probs(level, state, legal_actions)

or

    p = Policy.from_training(training_data, config=None)
    out = p.action_probs(level, state, legal_actions)

The score from `action_probs` is a strictly-positive probability distribution
over the supplied `legal_actions` (no zero-clipping on illegal actions, since
they are filtered out before returning).

Approach
--------
1. `make_policy` walks every training trajectory and builds a lookup table
   keyed `(prev_action_idx, run_length_bucket, mask_pattern)` -> next-action
   counts. Laplace-smooth, normalize to probabilities. Keep two empirical
   marginals as fall-back:

     * `fallback_prev[prev]`        = P(next | prev_action)
     * `fallback_mask[mask_pattern]` = P(next | open-cell pattern, ignoring
       previous_action) — used for cold start where `previous_action is None`.

2. `action_probs` does an O(1) lookup plus a few arithmetic ops and emits a
   probability distribution over `legal_actions`. The wall-following / momentum
   bias is folded into the table itself (every key/value pair aggregates the
   empirical behavior of the training set), so we do not need extra
   hand-tuned heuristics at inference time.

Distributional shift considerations
-----------------------------------
- All training-and-eval grids are 27x27. All transitions are deterministic and
  the chosen action always succeeds (verified on training trajectories).
- Run-length bucket cap is taken as the 97th-percentile of the training run
  lengths (≈21), with anything beyond collapsed into the largest bucket so
  the table stays compact but long runs still get their own bucket.
- The `level` argument is treated as carry-only non-spatial metadata; we never
  look at it. The policy is purely local — it uses `state` only.
"""

from __future__ import annotations

import json
import math
import os
from collections import Counter, defaultdict
from typing import Any, Dict, Iterable, List, Mapping, Optional, Sequence, Tuple


# ---------------------------------------------------------------------------
# Constants
# ---------------------------------------------------------------------------

ACTIONS: Tuple[str, str, str, str] = ("U", "D", "L", "R")
IDX: Dict[str, int] = {a: i for i, a in enumerate(ACTIONS)}

# Pre-computed once: 97th percentile of training run lengths is 21. We cap at
# 22 (the 98th percentile) so the longest-run bucket still has a small buffer
# above any observation. Anything >= RL_CAP is treated as the largest bucket.
RL_CAP: int = 22
RL_LONG_BUCKET: int = RL_CAP

# Smoothing strength for Laplace (additive) prior over 4 actions.
ALPHA: float = 1.0

# Numerical floor for probabilities on legal actions (avoid log(0) upstream).
EPS: float = 1e-6

# Exploration weight at the deepest depth_phase.
DEPTH_EXPLORE_FRAC: float = 0.05


# ---------------------------------------------------------------------------
# Schema-tolerant feature extraction
# ---------------------------------------------------------------------------

def _safe_get(d, *keys, default=None):
    for k in keys:
        if k in d and d[k] is not None:
            return d[k]
    return default


def _vec4(x):
    """Best-effort coercion of x to a length-4 tuple, preserving order U/D/L/R."""
    if x is None:
        return None
    if isinstance(x, (list, tuple)) and len(x) >= 4:
        return tuple(x[:4])
    if isinstance(x, Mapping):
        out = [None, None, None, None]
        for i, a in enumerate(ACTIONS):
            v = x.get(a)
            if v is None:
                v = x.get(a.lower()) if a != a.lower() else x.get(a.upper())
            if v is not None:
                out[i] = v
        for i in range(4):
            v = x.get(i)
            if v is not None and out[i] is None:
                out[i] = v
        if all(v is not None for v in out):
            return tuple(out)
    return None


def _legal_mask_from(state, legal_actions):
    cand = _safe_get(state, "legal_mask", "legal_actions_mask", default=None)
    if cand is not None:
        vec = _vec4(cand)
        if vec is not None:
            return tuple(int(bool(x)) for x in vec)
    nb = _safe_get(state, "neighbors", default=None)
    if nb is not None:
        vec = _vec4(nb)
        if vec is not None:
            return tuple(int(bool(x)) for x in vec)
    la = legal_actions or ()
    out = [0, 0, 0, 0]
    for a in la:
        if a in IDX:
            out[IDX[a]] = 1
    return tuple(out)


def _bucket_run_length(rl):
    if rl is None:
        return 1
    try:
        v = int(rl)
    except Exception:
        return 1
    if v < 1:
        return 1
    if v >= RL_CAP:
        return RL_CAP
    return v


def _bucket_run_length_from_state(state, previous_action):
    rl = _safe_get(state, "run_length_bucket", "run_length", "current_run_length", default=None)
    if rl is None:
        ht = _safe_get(state, "history_tail", default=None)
        if isinstance(ht, (list, tuple)) and ht:
            if previous_action is None:
                return 1
            count = 0
            for h in reversed(ht):
                if h == previous_action:
                    count += 1
                else:
                    break
            return _bucket_run_length(max(count, 1))
        return 1
    return _bucket_run_length(rl)


def _previous_action(state):
    pa = _safe_get(state, "previous_action", "prev_action", "last_action", default=None)
    if pa is None:
        return None
    if isinstance(pa, str) and pa in IDX:
        return pa
    if isinstance(pa, int) and 0 <= pa < 4:
        return ACTIONS[pa]
    if isinstance(pa, str):
        ps = pa.strip().upper()
        if ps in IDX:
            return ps
    return None


def _depth_phase(state):
    dp = _safe_get(state, "depth_phase", default=None)
    if dp is None:
        return 0.0
    try:
        v = float(dp)
    except Exception:
        return 0.0
    if 0.0 <= v < 1.0:
        return v
    v = v - math.floor(v)
    return v



# ---------------------------------------------------------------------------
# Training: walk trajectories and build tables
# ---------------------------------------------------------------------------

def _env_neighbors(grid, r, c):
    """For training-time analysis only; not used at policy runtime."""
    H = len(grid)
    W = len(grid[0]) if grid else 0
    out = [0, 0, 0, 0]
    deltas = ((-1, 0), (1, 0), (0, -1), (0, 1))
    for i, (dr, dc) in enumerate(deltas):
        nr, nc = r + dr, c + dc
        if 0 <= nr < H and 0 <= nc < W and grid[nr][nc] != "#":
            out[i] = 1
    return tuple(out)


def _smoothed_dist(counter):
    """Add-alpha smoothing over the 4 actions, then normalize."""
    smoothed = {a: (counter.get(a, 0) + ALPHA) for a in ACTIONS}
    z = sum(smoothed.values())
    return {a: v / z for a, v in smoothed.items()}


def _build_tables(training_data):
    """Walk every training trajectory and build the policy tables."""
    if not isinstance(training_data, Mapping):
        raise TypeError(f"training_data must be a mapping, got {type(training_data).__name__}")
    levels = training_data.get("levels")
    if not isinstance(levels, (list, tuple)):
        raise ValueError("training_data['levels'] must be a list of level dicts")

    counts_table = defaultdict(Counter)
    counts_by_prev = defaultdict(Counter)
    counts_by_mask = defaultdict(Counter)
    counts_global = Counter()

    invalid_trajectories = 0
    total_trajectories = 0

    DELTAS = ((-1, 0), (1, 0), (0, -1), (0, 1))  # U, D, L, R

    for lvl in levels:
        if not isinstance(lvl, Mapping):
            continue
        grid = lvl.get("grid")
        sol = lvl.get("solution")
        start = lvl.get("start")
        if grid is None or sol is None or start is None:
            continue
        H = len(grid)
        W = len(grid[0]) if grid else 0
        if W == 0:
            continue
        total_trajectories += 1
        sr, sc = int(start[0]), int(start[1])
        r, c = sr, sc
        prev_action = None
        run_length = 1
        valid = True
        for step_idx, a in enumerate(sol):
            a_str = a if isinstance(a, str) else (ACTIONS[int(a)] if isinstance(a, int) and 0 <= int(a) < 4 else None)
            if a_str is None or a_str not in IDX:
                valid = False
                break
            mask = _env_neighbors(grid, r, c)
            dr, dc = DELTAS[IDX[a_str]]
            nr, nc = r + dr, c + dc
            if not (0 <= nr < H and 0 <= nc < W and grid[nr][nc] != "#"):
                valid = False
                break
            prev_idx = IDX[prev_action] if prev_action is not None else None
            rl_bucket = _bucket_run_length(run_length if prev_action is not None else 1)
            mp = tuple(int(bool(x)) for x in mask)
            counts_table[(prev_idx, rl_bucket, mp)][a_str] += 1
            counts_by_prev[prev_idx][a_str] += 1
            counts_by_mask[mp][a_str] += 1
            counts_global[a_str] += 1
            r, c = nr, nc
            if prev_action == a_str:
                run_length += 1
            else:
                prev_action = a_str
                run_length = 1
        if not valid:
            invalid_trajectories += 1

    prob_table = {key: _smoothed_dist(cn) for key, cn in counts_table.items()}
    fallback_prev = {k: _smoothed_dist(c) for k, c in counts_by_prev.items()}
    fallback_mask = {k: _smoothed_dist(c) for k, c in counts_by_mask.items()}
    fallback_global = _smoothed_dist(counts_global)

    return {
        "prob_table": prob_table,
        "fallback_prev": fallback_prev,
        "fallback_mask": fallback_mask,
        "fallback_global": fallback_global,
        "stats": {
            "trajectories_total": total_trajectories,
            "trajectories_invalid": invalid_trajectories,
            "table_size": len(prob_table),
        },
    }


# ---------------------------------------------------------------------------
# Inference: action_probs
# ---------------------------------------------------------------------------

def _renormalize_legal(probs, legal_actions):
    """Zero out non-legal actions (defensive) and renormalize."""
    out = {}
    z = 0.0
    for a in legal_actions:
        p = float(probs.get(a, 0.0))
        out[a] = max(p, EPS)
        z += out[a]
    if z <= 0.0:
        if not legal_actions:
            return {}
        u = 1.0 / len(legal_actions)
        return {a: u for a in legal_actions}
    return {a: out[a] / z for a in legal_actions}


def _select_distribution(tables, prev_idx, rl_bucket, mask):
    """Lookup order (most specific to most generic):

      1. (prev, rl_bucket, mask)
      2. (prev, mask)         — pooled over run-length buckets
      3. (prev,)               — pooled over masks
      4. (mask)                — pooled over previous-action
      5. global
    """
    table = tables["prob_table"]
    fprev = tables["fallback_prev"]
    fmask = tables["fallback_mask"]
    fglob = tables["fallback_global"]

    key1 = (prev_idx, rl_bucket, mask)
    if key1 in table:
        return table[key1]
    for (p, rl, m), d in table.items():
        if p == prev_idx and m == mask:
            return d
    if prev_idx in fprev and fprev[prev_idx] is not None:
        return fprev[prev_idx]
    if mask in fmask:
        return fmask[mask]
    return fglob


class Policy:
    """A learned, lookup-based policy for grid-search action selection."""

    __slots__ = ("_tables", "_config")

    def __init__(self, tables, config=None):
        self._tables = dict(tables)
        self._config = dict(config) if config else {}

    @classmethod
    def from_training(cls, training_data, config=None):
        tables = _build_tables(training_data)
        return cls(tables=tables, config=config)

    def action_probs(self, level, state, legal_actions):
        if not legal_actions:
            return {}

        mask = _legal_mask_from(state, list(legal_actions))
        prev = _previous_action(state)
        prev_idx = IDX[prev] if prev is not None else None
        rl_bucket = _bucket_run_length_from_state(state, prev)

        base = _select_distribution(self._tables, prev_idx, rl_bucket, mask)

        dp = _depth_phase(state)
        eps = DEPTH_EXPLORE_FRAC * dp
        if eps > 0.0:
            u = 1.0 / 4.0
            base = {a: (1.0 - eps) * base.get(a, 0.0) + eps * u for a in ACTIONS}

        return _renormalize_legal(base, legal_actions)

    def summary(self):
        return {
            "trajectories_total": self._tables["stats"]["trajectories_total"],
            "trajectories_invalid": self._tables["stats"]["trajectories_invalid"],
            "table_size": self._tables["stats"]["table_size"],
            "rl_cap": RL_CAP,
            "alpha": ALPHA,
        }


# ---------------------------------------------------------------------------
# Module-level factory (per task spec)
# ---------------------------------------------------------------------------

def make_policy(training_data, config=None):
    """Build and return a Policy from `training_data`."""
    global ALPHA, RL_CAP, DEPTH_EXPLORE_FRAC
    cfg = dict(config) if config else {}
    saved = (ALPHA, RL_CAP, DEPTH_EXPLORE_FRAC)
    try:
        if "alpha" in cfg:
            try: ALPHA = float(cfg["alpha"])
            except Exception: pass
        if "rl_cap" in cfg:
            try: RL_CAP = max(1, int(cfg["rl_cap"]))
            except Exception: pass
        if "depth_explore_frac" in cfg:
            try: DEPTH_EXPLORE_FRAC = max(0.0, min(1.0, float(cfg["depth_explore_frac"])))
            except Exception: pass

        tables = _build_tables(training_data)
    finally:
        ALPHA, RL_CAP, DEPTH_EXPLORE_FRAC = saved

    return Policy(tables=tables, config=cfg)



# ---------------------------------------------------------------------------
# __main__  — concrete, executed self-test (no third-party deps required)
# ---------------------------------------------------------------------------

def _greedy_rollout(policy, level, max_steps=200):
    """Walk through a level using the policy as a greedy heuristic."""
    grid = level["grid"]
    H = len(grid)
    W = len(grid[0]) if grid else 0
    start = level["start"]
    goal = level["goal"]
    sr, sc = int(start[0]), int(start[1])
    gr, gc = int(goal[0]), int(goal[1])
    r, c = sr, sc
    path = []
    prev = None
    run_len = 1
    for step in range(max_steps):
        if (r, c) == (gr, gc):
            return True, path, step
        ns = [0, 0, 0, 0]
        legal = []
        for i, (dr, dc) in enumerate(((-1, 0), (1, 0), (0, -1), (0, 1))):
            nr, nc = r + dr, c + dc
            if 0 <= nr < H and 0 <= nc < W and grid[nr][nc] != "#":
                ns[i] = 1
                legal.append(ACTIONS[i])
        if not legal:
            return False, path, step
        state = {
            "neighbors": tuple(ns),
            "previous_action": prev,
            "run_length_bucket": run_len if prev is not None else 1,
            "legal_mask": tuple(ns),
            "depth": step,
            "depth_mod": step % 4,
            "depth_phase": step / max(1, max_steps),
            "legal_actions": legal,
        }
        meta = {k: v for k, v in level.items() if k not in ("grid", "start", "goal", "max_depth", "solution", "id")}
        dist = policy.action_probs(level=meta, state=state, legal_actions=legal)
        if not dist:
            return False, path, step
        best = max(legal, key=lambda a: (dist.get(a, -1.0), -ACTIONS.index(a)))
        dr, dc = ((-1, 0), (1, 0), (0, -1), (0, 1))[IDX[best]]
        nr, nc = r + dr, c + dc
        if not (0 <= nr < H and 0 <= nc < W and grid[nr][nc] != "#"):
            return False, path, step
        path.append(best)
        r, c = nr, nc
        if prev == best:
            run_len += 1
        else:
            prev = best
            run_len = 1
    return (r, c) == (gr, gc), path, max_steps


def _main():
    here = os.path.dirname(os.path.abspath(__file__))
    train_path = os.path.join(here, "data", "training_levels.json")
    eval_path = os.path.join(here, "data", "public_eval_levels.json")
    if not os.path.exists(train_path):
        train_path = os.path.join(".", "data", "training_levels.json")
        eval_path = os.path.join(".", "data", "public_eval_levels.json")

    with open(train_path, "r", encoding="utf-8") as f:
        train = json.load(f)
    with open(eval_path, "r", encoding="utf-8") as f:
        evald = json.load(f)

    policy = make_policy(train, config={"alpha": 1.0, "rl_cap": RL_CAP, "depth_explore_frac": 0.05})
    summary = policy.summary()

    train_results = []
    for L in train["levels"]:
        ok, path, n = _greedy_rollout(policy, L, max_steps=L.get("max_depth", 100))
        train_results.append((L["id"], ok, n, len(path)))
    n_solved_train = sum(1 for _, ok, _, _ in train_results if ok)
    n_total_train = len(train_results)

    eval_results = []
    for L in evald["levels"]:
        ok, path, n = _greedy_rollout(policy, L, max_steps=L.get("max_depth", 100))
        eval_results.append({"id": L["id"], "solved": ok, "steps": n, "path": path})

    out = {
        "summary": summary,
        "train_solved": n_solved_train,
        "train_total": n_total_train,
        "eval_results": eval_results,
        "sample_train_first_5": [(rid, ok, steps, plen) for rid, ok, steps, plen in train_results[:5]],
    }
    return out


if __name__ == "__main__":
    rep = _main()
    print(json.dumps(rep, indent=2))
