"""
Analysis — Proportion of original Experimental Economics studies conducted in the UK.

Source: data/meta-regression_study_data_heterogeneity_in_replication_projects.csv

Contract (from approved plan):
- Subset: df["project"] == "ee"   (Experimental Economics)
- Numerator:   sum(experiment_country.o == "United Kingdom")
- Denominator: n of unique ee ids (= 18)
- Point estimate: 1/18
- 95% CI: Wilson (primary) + Wald (reference) via statsmodels
- Context: breakdown by us_lab.o
"""
import json
import pandas as pd
from statsmodels.stats.proportion import proportion_confint

CSV = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
UK = "United Kingdom"

results = {}

# Load and subset
df = pd.read_csv(CSV)
ee = df[df["project"] == "ee"].copy()
results["n_rows_total"] = int(len(df))
results["n_rows_ee"] = int(len(ee))
results["n_unique_ids_ee"] = int(ee["id"].nunique())
results["n_unique_titles_ee"] = int(ee["title"].nunique())
results["n_unique_authors_o_ee"] = int(ee["authors.o"].nunique())
results["n_missing_country_ee"] = int(ee["experiment_country.o"].isna().sum())
results["n_lab_id_missing_ee"] = int(ee["lab_id"].isna().sum())

# Country frequencies within EE
country_counts = ee["experiment_country.o"].value_counts(dropna=False)
results["country_distribution_ee"] = {str(k): int(v) for k, v in country_counts.items()}

# Numerator / denominator
mask_uk = ee["experiment_country.o"] == UK
n = int(len(ee))              # denominator (also equal to ee["experiment_country.o"].notna().sum() == 18)
k = int(mask_uk.sum())        # numerator
results["denominator_n"] = n
results["numerator_k"] = k
p_hat = k / n
results["p_hat"] = p_hat
results["p_hat_pct"] = p_hat * 100

# Wilson 95% CI (primary) and Wald (reference)
wilson_lo, wilson_hi = proportion_confint(k, n, alpha=0.05, method="wilson")
wald_lo, wald_hi     = proportion_confint(k, n, alpha=0.05, method="normal")
results["wilson_lo"] = float(wilson_lo); results["wilson_hi"] = float(wilson_hi)
results["wald_lo"]   = float(wald_lo);   results["wald_hi"]   = float(wald_hi)

# Identify the UK original(s)
uk_ee = ee.loc[mask_uk, ["id", "title", "authors.o", "experiment_country.o",
                         "experiment_country.r", "us_lab.o", "same_country"]]
results["uk_original_in_ee"] = uk_ee.to_dict(orient="records")

# Contextual breakdown by us_lab.o
break_rows = []
for flag in [0, 1]:
    sub = ee[ee["us_lab.o"] == flag]
    n_i = int(len(sub))
    k_i = int((sub["experiment_country.o"] == UK).sum())
    p_i = (k_i / n_i) if n_i else float("nan")
    if n_i > 0:
        w_lo, w_hi = proportion_confint(k_i, n_i, alpha=0.05, method="wilson")
    else:
        w_lo, w_hi = (float("nan"), float("nan"))
    break_rows.append({
        "us_lab.o": int(flag),
        "n_originals": n_i,
        "k_uk": k_i,
        "p_hat": p_i,
        "wilson_lo": float(w_lo) if w_lo == w_lo else None,
        "wilson_hi": float(w_hi) if w_hi == w_hi else None,
    })
results["breakdown_us_lab_o"] = break_rows

# Save results.json alongside this script
with open("artifacts/results.json", "w") as f:
    json.dump(results, f, indent=2, default=str)

# Pretty-print summary for stdout capture
print("=== Proportion of EE originals conducted in the UK ===")
print(f"Denominator (ee originals, n): {n}")
print(f"Numerator   (ee originals in UK, k): {k}")
print(f"Point estimate p̂ = {k}/{n} = {p_hat:.6f}  ({p_hat*100:.2f}%)")
print()
print(f"95% CI Wilson (primary): [{wilson_lo:.4f}, {wilson_hi:.4f}]  → [{wilson_lo*100:.2f}%, {wilson_hi*100:.2f}%]")
print(f"95% CI Wald   (reference): [{wald_lo:.4f}, {wald_hi:.4f}]  → [{wald_lo*100:.2f}%, {wald_hi*100:.2f}%]")
print()
print("=== Contextual breakdown by us_lab.o ===")
for row in break_rows:
    lo = row["wilson_lo"]; hi = row["wilson_hi"]
    if lo is None:
        print(f"  us_lab.o={row['us_lab.o']:>1}  n={row['n_originals']}  k_UK={row['k_uk']}  p̂={row['p_hat']:.3f}  (no CI)")
    else:
        print(f"  us_lab.o={row['us_lab.o']:>1}  n={row['n_originals']}  k_UK={row['k_uk']}  p̂={row['p_hat']*100:.2f}%  Wilson 95% CI [{lo*100:.2f}%, {hi*100:.2f}%]")
print()
print("=== EE originals in UK ===")
print(uk_ee.to_string(index=False))
print()
print("=== Quality diagnostics ===")
print(f"  ids unique:      {results['n_unique_ids_ee']}/18")
print(f"  titles unique:   {results['n_unique_titles_ee']}/18")
print(f"  authors unique:  {results['n_unique_authors_o_ee']}/18")
print(f"  country missing: {results['n_missing_country_ee']}/18")
print(f"  lab_id missing:  {results['n_lab_id_missing_ee']}/18")
