# Custom MICE (no sklearn available)
"""Replacement for sklearn IterativeImputer: stochastic regression MICE."""
import numpy as np
import pandas as pd
import statsmodels.api as sm

class MICEImputer:
    """MICE with stochastic regression imputation."""
    def __init__(self, n_iter=20, random_state=20261021):
        self.n_iter = n_iter
        self.random_state = random_state
    def fit_transform(self, X_df):
        rng = np.random.default_rng(self.random_state)
        X = X_df.copy()
        cols = list(X.columns)
        miss = X.isna()
        # Initialize: fill with column means
        for c in cols:
            mu = X[c].mean()
            X[c] = X[c].fillna(mu)
        # Iterate
        for it in range(self.n_iter):
            # Order columns by missingness (descending) — required for convergence
            order = miss.sum().sort_values(ascending=False).index.tolist()
            for c in order:
                if not miss[c].any():
                    continue
                other = [k for k in cols if k != c]
                obs_idx = ~miss[c]
                A = sm.add_constant(X.loc[obs_idx, other].values, has_constant="add")
                b = X.loc[obs_idx, c].values
                try:
                    res = sm.OLS(b, A).fit()
                except Exception:
                    X.loc[miss[c].values, c] = X[c].mean()
                    continue
                sigma = float(np.sqrt(res.mse_resid)) if res.df_resid > 0 else 1.0
                Aall = sm.add_constant(X[other].values, has_constant="add")
                yhat = Aall @ res.params
                missing_idx = np.where(miss[c].values)[0]
                noise = rng.normal(0, max(sigma, 1e-6), size=missing_idx.size)
                X.values[missing_idx, cols.index(c)] = yhat[missing_idx] + noise
        return X

