# =============================================================
# HC1 ROBUST OLS HELPER
# =============================================================
def ols_hc1(df_, y, X_cols):
    keep = df_[[y] + list(X_cols)].dropna()
    yv = keep[y].values
    Xv = sm.add_constant(keep[list(X_cols)].values, has_constant="add")
    cols = ["const"] + list(X_cols)
    res = sm.OLS(yv, Xv).fit(cov_type="HC1")
    res.columns = cols
    return res, len(keep)

def coef_row(res, var, dep, label):
    c = res.params[res.columns.index(var)] if isinstance(res.columns, list) else res.params[var]
    se = res.bse[res.columns.index(var)]   if isinstance(res.columns, list) else res.bse[var]
    pv = res.pvalues[res.columns.index(var)]if isinstance(res.columns, list) else res.pvalues[var]
    return {"dep":dep, "spec":label, "var":var, "beta":c, "se_HC1":se, "p_value":pv,
            "N":int(res.nobs), "R2":res.rsquared, "Adj_R2":res.rsquared_adj}

