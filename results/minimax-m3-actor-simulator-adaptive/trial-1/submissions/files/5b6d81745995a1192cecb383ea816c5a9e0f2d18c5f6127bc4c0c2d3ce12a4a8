def mice_pool(outcome, M=20, n_iter=15, seed=20261021):
    coefs, ses, ns = [], [], []
    cols = [outcome] + [c for c in imp_cols_full if c != outcome]
    for m in range(M):
        imp = MICEImputer(n_iter=n_iter, random_state=seed + m)
        Xdf = imp.fit_transform(df[cols].copy())
        Xdf["age79_sq"] = Xdf["age79"] ** 2
        keep = Xdf.dropna()
        if len(keep) < 1000:
            continue
        yv = keep[outcome].values
        Xv = sm.add_constant(keep[design_cols].values, has_constant="add")
        r = sm.OLS(yv, Xv).fit()
        coefs.append(r.params[1]); ses.append(r.bse[1]); ns.append(len(keep))
    c = np.array(coefs); s = np.array(ses)
    pbeta = c.mean()
    within = (s ** 2).mean()
    between = c.var(ddof=1)
    total = within + between + between / M
    pse = np.sqrt(total)
    z = pbeta / pse
    pval = 2 * (1 - norm.cdf(abs(z)))
    return {"method": f"MICE m={M} Rubin pool on {outcome}",
            "beta_log_wealth96": pbeta, "pooled_se": pse,
            "z": z, "p": pval,
            "mean_N": float(np.mean(ns)),
            "min_N": int(np.min(ns)),
            "max_N": int(np.max(ns))}

mice_92 = mice_pool("bmi92")
