# ===== LOGISTIC REGRESSION (primary, outcome >=13) =======================
print('\n' + '='*78)
print('LOGISTIC REGRESSION — primary (income-1979 SES, outcome >=13)')
print('='*78)
regdf = af_primary.copy()
regdf['ses_mid']     = (regdf['ses_inc'] == 'mid').astype(int)
regdf['ses_high']    = (regdf['ses_inc'] == 'high').astype(int)
regdf['black_x_mid']  = regdf['is_black'] * regdf['ses_mid']
regdf['black_x_high'] = regdf['is_black'] * regdf['ses_high']
regdf['age_c'] = regdf[AGE] - regdf[AGE].mean()
regdf['max_pg'] = regdf[[MOM, DAD]].max(axis=1)

X_cols = ['is_black', 'ses_mid', 'ses_high', 'black_x_mid', 'black_x_high',
          'female', 'age_c', 'max_pg']
model_df = regdf.dropna(subset=X_cols + ['any_coll_13']).copy()
print('Regression frame (full covariates):', model_df.shape)

X = sm.add_constant(model_df[X_cols].astype(float))
y = model_df['any_coll_13'].astype(int)
logit = sm.Logit(y, X).fit(disp=False, cov_type='HC1')
print(logit.summary())
with open(os.path.join(TBL, 'logit_primary.txt'), 'w') as f:
    f.write(str(logit.summary()))

# Wald test for joint significance of Black x SES interactions
import numpy as _np
R = _np.zeros((2, len(X_cols)+1))
R[0, X_cols.index('black_x_mid')  + 1] = 1
R[1, X_cols.index('black_x_high') + 1] = 1
wald = logit.wald_test(R)
print('\nWald test (joint H0: Black x SES_mid = Black x SES_high = 0):')
print(wald.summary())
with open(os.path.join(TBL, 'wald_interaction_primary.txt'), 'w') as f:
    f.write('Wald test joint H0: beta(Black x SES_mid) = beta(Black x SES_high) = 0\n')
    f.write(str(wald.summary()))

# Predicted probabilities at each SES tertile by race, covariates at sample means
phat_rows = []
for race in [1, 3]:
    for ses in ['low','mid','high']:
        m = 1 if ses=='mid' else 0
        h = 1 if ses=='high' else 0
