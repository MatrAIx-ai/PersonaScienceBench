# Average marginal effect of SES by race
def ame_ses_by_race(model, df_input, race_code):
    df2 = df_input.copy()
    df2['is_black']     = int(race_code == 1)
    df2['ses_mid']      = 0
    df2['ses_high']     = 0
    df2['black_x_mid']  = 0
    df2['black_x_high'] = 0
    X0 = sm.add_constant(df2[X_cols].astype(float), has_constant='add')
    p_low = model.predict(X0)
    out = []
    for ses in ['mid','high']:
        df3 = df2.copy()
        df3['ses_mid' if ses=='mid' else 'ses_high'] = 1
        df3['black_x_mid' if ses=='mid' else 'black_x_high'] = int(race_code==1)
        X1 = sm.add_constant(df3[X_cols].astype(float), has_constant='add')
        p_high = model.predict(X1)
        out.append((ses, float((p_high - p_low).mean())))
    return out

ame_black = ame_ses_by_race(logit, model_df, 1)
ame_nbnh  = ame_ses_by_race(logit, model_df, 3)
