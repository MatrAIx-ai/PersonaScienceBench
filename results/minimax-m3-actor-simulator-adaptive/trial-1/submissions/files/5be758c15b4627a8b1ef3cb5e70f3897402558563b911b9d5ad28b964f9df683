"""Main analysis for the NLSY79 BA / SES question.
Primary outcome: post-secondary access (grade_1979 >= 13).
Primary contrast: Black (1) vs. NBNH (3); HISPANIC (2) reported separately.
Primary SES: log(family_income_1979 + 1) tertiles.
Sensitivities: wealth_1985 tertiles; equal-weighted z-composite.
"""
import os, math, json
import numpy as np
import pandas as pd
import statsmodels.api as sm

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
DATA = os.path.join(ROOT, 'data', 'nls_raw.csv')
ART  = os.path.dirname(os.path.abspath(__file__))
TBL  = os.path.join(ART, 'tables')
os.makedirs(TBL, exist_ok=True)

RACE = 'Racial/ethnic cohort, 1979'
AGE  = 'Age of respondent, 1979'
GRADE= 'Highest grade completed, 1979'
SEX  = 'Sex of respondent, 1979'
INC79= 'Total net family income, previous calendar year, 1979'
W85  = 'Family net wealth, 1985'
MOM  = "Highest grade completed by respondent's mother, 1979"
DAD  = "Highest grade completed by respondent's father, 1979"
FSZ  = 'Family size, 1979'

# ---- Load & basic cleaning ------------------------------------------------
df = pd.read_csv(DATA)
print('Loaded shape:', df.shape)

for c in [AGE, GRADE, SEX, INC79, W85, MOM, DAD, FSZ]:
    df[c] = pd.to_numeric(df[c], errors='coerce')

# Drop NLSY skip-code 95 from the grade variable
df.loc[df[GRADE] == 95, GRADE] = np.nan
df['race_lbl'] = df[RACE].map({1:'BLACK', 2:'HISPANIC', 3:'NBNH'})
df['is_black'] = (df[RACE] == 1).astype(int)
df['is_nbnh']  = (df[RACE] == 3).astype(int)
df['is_hisp']  = (df[RACE] == 2).astype(int)
df['female']   = (df[SEX] == 2).astype(int)

# Restrict to age 18-22 window for terminal-grade plausibility
af = df[(df[AGE] >= 18) & (df[AGE] <= 22)].copy()
print('Age 18-22 frame:', af.shape)

# Outcome indicators
af['any_coll_13'] = (af[GRADE] >= 13).astype(int)
af['any_coll_15'] = (af[GRADE] >= 15).astype(int)
af['ba_16']       = (af[GRADE] >= 16).astype(int)

# SES — primary: log(income_1979+1), tertiles
af['log_inc79'] = np.log(af[INC79].fillna(0) + 1)
af['ses_inc']   = pd.qcut(af['log_inc79'], q=[0, 1/3, 2/3, 1.0],
                          labels=['low','mid','high'])

# SES — wealth 1985 tertiles (shift so min is positive, then log)
af['log_w85b'] = np.log(af[W85].fillna(0) - af[W85].min() + 1)
af['ses_w85']  = pd.qcut(af['log_w85b'], q=[0, 1/3, 2/3, 1.0],
                         labels=['low','mid','high'])

# SES — z-composite: (z(log_inc) + z(max_parent_grade) + z(-family_size)) / 3
# Treat missing parental grade as null (NaN); keep only when >=1 parent is present.
af['max_p_grade'] = np.fmax(af[MOM].fillna(-1), af[DAD].fillna(-1))
af.loc[(af[MOM].isna()) & (af[DAD].isna()), 'max_p_grade'] = np.nan

def zscore(s):
    mu, sd = s.mean(skipna=True), s.std(skipna=True)
    if sd == 0 or np.isnan(sd): return s * 0
    return (s - mu) / sd

z_inc = zscore(np.log(af[INC79].fillna(0) + 1))
z_par = zscore(af['max_p_grade'])
z_fsz = zscore(-af[FSZ])
af['z_comp'] = (z_inc + z_par + z_fsz) / 3
af['ses_z']  = pd.qcut(af['z_comp'], q=[0, 1/3, 2/3, 1.0],
                       labels=['low','mid','high'])

# Primary analytic frame
af_primary = af.dropna(subset=[GRADE, 'log_inc79']).copy()
print('Primary frame (outcome + primary SES complete):', af_primary.shape)

# ===== Helpers ============================================================
def crosstab_rate(frame, outcome_col, ses_col, races=(1, 3)):
    label_map = {1:'BLACK', 2:'HISPANIC', 3:'NBNH'}
    out = []
    for race in races:
        sub = frame[frame[RACE] == race]
        for ses in ['low','mid','high']:
            cell = sub[sub[ses_col] == ses]
            n = len(cell)
            y = int(cell[outcome_col].sum()) if n else 0
            rate = y/n if n else np.nan
            se = math.sqrt(rate*(1-rate)/n) if n else np.nan
            lo = max(0.0, rate - 1.96*se) if n else np.nan
            hi = min(1.0, rate + 1.96*se) if n else np.nan
            out.append({'race': label_map[race], 'ses': ses, 'n': n,
                        'outcome_n': y, 'rate': rate,
                        'rate_lo': lo, 'rate_hi': hi})
    return pd.DataFrame(out)

def gap_table(ct):
    """Signed Black-NBNH rate difference (pp) and rate ratio with 95% CI."""
    piv_n  = ct.pivot(index='ses', columns='race', values='n')
    piv_y  = ct.pivot(index='ses', columns='race', values='outcome_n')
    piv_r  = ct.pivot(index='ses', columns='race', values='rate')
    rows = []
    for ses in ['low','mid','high']:
        b = piv_r.loc[ses,'BLACK']; r = piv_r.loc[ses,'NBNH']
        bn = piv_n.loc[ses,'BLACK']; rn = piv_n.loc[ses,'NBNH']
        bb = piv_y.loc[ses,'BLACK']; rb = piv_y.loc[ses,'NBNH']
        diff = b - r
        var_b = b*(1-b)/bn if bn>0 else np.nan
        var_r = r*(1-r)/rn if rn>0 else np.nan
        se_d  = math.sqrt(var_b + var_r) if (bn>0 and rn>0) else np.nan
        if b>0 and r>0 and bb>0 and rb>0:
            var_log = (1-b)/bb + (1-r)/rb
            ratio = b / r
            ratio_lo = math.exp(math.log(ratio) - 1.96*math.sqrt(var_log))
            ratio_hi = math.exp(math.log(ratio) + 1.96*math.sqrt(var_log))
        else:
            ratio = np.nan; ratio_lo = np.nan; ratio_hi = np.nan
        rows.append({'ses': ses,
                     'BLACK_n': int(bn), 'BLACK_rate': b,
                     'NBNH_n':  int(rn), 'NBNH_rate':  r,
                     'gap_pp': diff*100,
                     'gap_lo_pp': (diff - 1.96*se_d)*100 if se_d==se_d else np.nan,
                     'gap_hi_pp': (diff + 1.96*se_d)*100 if se_d==se_d else np.nan,
                     'RR': ratio,
                     'RR_lo': ratio_lo,
                     'RR_hi': ratio_hi})
    return pd.DataFrame(rows)

def bootstrap_gap(frame, outcome_col, ses_col, races=(1,3), B=2000, seed=20251021):
    rng = np.random.default_rng(seed)
    ses_levels = ['low','mid','high']
    cells = {}
    for race in races:
        for ses in ses_levels:
            arr = frame[(frame[RACE]==race) & (frame[ses_col]==ses)][outcome_col].to_numpy()
            cells[(race, ses)] = arr
    diffs = []
    for _ in range(B):
        d = {}
        for ses in ses_levels:
            b_arr = cells[(1, ses)]; r_arr = cells[(3, ses)]
            if len(b_arr)==0 or len(r_arr)==0:
                d[ses] = np.nan; continue
            b_sample = rng.choice(b_arr, size=len(b_arr), replace=True)
            r_sample = rng.choice(r_arr, size=len(r_arr), replace=True)
            d[ses] = b_sample.mean() - r_sample.mean()
        diffs.append(d)
    dfb = pd.DataFrame(diffs)
    out = {}
    for ses in ses_levels:
        col = dfb[ses].dropna()
        out[ses] = (float(col.quantile(0.025)), float(col.quantile(0.975))) if len(col)>10 else (np.nan, np.nan)
    return out

def ct_hispanic(frame, outcome_col, ses_col):
    rows = []
    sub = frame[frame[RACE] == 2]
    for ses in ['low','mid','high']:
        cell = sub[sub[ses_col] == ses]
        n = len(cell); y = int(cell[outcome_col].sum()) if n else 0
        rate = y/n if n else np.nan
        se = math.sqrt(rate*(1-rate)/n) if n>0 else np.nan
        rows.append({'race':'HISPANIC', 'ses': ses, 'n': n, 'outcome_n': y,
                     'rate': rate,
                     'rate_lo': max(0, rate-1.96*se) if n else np.nan,
                     'rate_hi': min(1, rate+1.96*se) if n else np.nan})
    return pd.DataFrame(rows)

