        x[X_cols.index('is_black')+1]    = int(race==1)
        x[X_cols.index('ses_mid')+1]     = m
        x[X_cols.index('ses_high')+1]    = h
        x[X_cols.index('black_x_mid')+1] = int(race==1) * m
        x[X_cols.index('black_x_high')+1]= int(race==1) * h
        x[X_cols.index('female')+1] = model_df['female'].mean()
        x[X_cols.index('age_c')+1]  = 0
        x[X_cols.index('max_pg')+1] = model_df['max_pg'].mean()
        phat_rows.append({'race': 'BLACK' if race==1 else 'NBNH',
                          'ses': ses, 'pred_prob': np.asarray(logit.predict(x)).item()})
