"""Robust Newick parser for the I3S-style phylogenetic tree."""
import re

def tokenize(s):
    """Emit tokens: '(', ')', ',', ';', NAME, NUMBER."""
    i, n = 0, len(s)
    out = []
    while i < n:
        c = s[i]
        if c in "(),;:":
            out.append(c); i += 1
        elif c.isspace():
            i += 1
        else:
            j = i
            while j < n and s[j] not in "(),;:":
                j += 1
            tok = s[i:j].strip()
            if not tok:
                i = j; continue
            # Numeric?
            try:
                float(tok); out.append(("NUM", tok))
            except ValueError:
                out.append(("NAME", tok))
            i = j
    return out

def parse(s):
    toks = tokenize(s)
    p = [0]
    def peek():
        return toks[p[0]] if p[0] < len(toks) else None
    def take():
        t = toks[p[0]]; p[0] += 1; return t

    def parse_clade():
        t = peek()
        if t == "(":
            take()
            children = []
            children.append(parse_clade())
            while peek() == ",":
                take()
                children.append(parse_clade())
            assert take() == ")"
            # optional branch set (label, then : length)
            label = None; length = 0.0
            if peek() is not None and isinstance(peek(), tuple) and peek()[0] == "NAME":
                label = take()[1]
            if peek() == ":":
                take()
                length = float(take()[1])
            return {"kind": "internal", "children": children, "label": label, "length": length}
        else:
            # leaf: NAME
            leaf_label = take()[1]
            length = 0.0
            if peek() == ":":
                take()
                length = float(take()[1])
            return {"kind": "leaf", "label": leaf_label, "length": length, "children": []}

    root = parse_clade()
    # Final ';' may or may not be present
    return root

if __name__ == "__main__":
    import sys
    with open(sys.argv[1]) as f:
        s = f.read().strip()
    tree = parse(s)
    leaves = []
    def walk(n):
        if n["kind"] == "leaf":
            leaves.append(n["label"])
        else:
            for ch in n["children"]:
                walk(ch)
    walk(tree)
    from collections import Counter
    print("Leaves:", len(leaves))
    print("Unique:", len(set(leaves)))
    print("Sample:", leaves[:5])
