"""
DiscoveryBench analysis: proportion of junior professors in replicated studies in Psychology.

Approved approach (researcher-confirmed):
  * Source CSV: data/meta-regression_study_data_heterogeneity_in_replication_projects.csv
    (the replication-success file has no seniority columns and is not used here).
  * Seniority column: seniority.r (replication-side senior author).
    (Note: the schema's textual description of seniority.r is mis-labelled
     as "original paper"; the .o/.r naming convention is what the data follow.)
  * "Psychology" = project == 'rpp' (the only project explicitly labelled "Psychology").
  * Denominator = all rpp rows with drop == False, including replicated == 0.
  * Junior definition (primary) = 'Assistant Professor'.
  * 'Researcher' is NOT treated as junior in any variant.

Output: prints diagnostics and the requested proportions, and writes JSON+CSV summaries.
"""
import json
from pathlib import Path

import numpy as np
import pandas as pd

ROOT = Path('/workspace')
DATA = ROOT / 'data' / 'meta-regression_study_data_heterogeneity_in_replication_projects.csv'
OUT = ROOT / 'analysis'
OUT.mkdir(parents=True, exist_ok=True)

df = pd.read_csv(DATA)
print(f'Loaded {len(df)} rows × {df.shape[1]} columns from {DATA.name}')
print(f'  seniority.r dtype: {df["seniority.r"].dtype};  NaN in seniority.r: {df["seniority.r"].isna().sum()}')

# Always apply the drop filter defensively
df_keep = df[df['drop'] != True].copy()
print(f'  rows after drop == False: {len(df_keep)}')

# ---- Primary scope: project == 'rpp'
rpp = df_keep[df_keep['project'] == 'rpp'].copy()
n_rpp = len(rpp)
print(f'\nPRIMARY SCOPE (project == "rpp", drop == False): {n_rpp} rows')

# Diagnostic: do any rpp rows have drop == True?
n_rpp_dropped = ((df['project'] == 'rpp') & (df['drop'] == True)).sum()
print(f'  rpp rows excluded by drop == True: {n_rpp_dropped}')

# Category counts
sr_rpp = rpp['seniority.r'].value_counts(dropna=False)
print('  seniority.r distribution (rpp):')
print(sr_rpp.to_string())

# Primary numerator: Assistant Professor
num_primary = (rpp['seniority.r'] == 'Assistant Professor').sum()
prop_primary = num_primary / n_rpp if n_rpp else float('nan')
print(f'\nPRIMARY: junior = "Assistant Professor" only')
print(f'  numerator = {num_primary}, denominator = {n_rpp}, proportion = {prop_primary:.4f}  ({prop_primary*100:.2f}%)')

# Sensitivity A: include "Assistant" (treat as truncated Assistant Professor)
junior_inclusive = {'Assistant Professor', 'Assistant'}
num_inclusive = rpp['seniority.r'].isin(junior_inclusive).sum()
prop_inclusive = num_inclusive / n_rpp if n_rpp else float('nan')
print(f'\nSENSITIVITY A: junior = "Assistant Professor" + "Assistant"')
print(f'  numerator = {num_inclusive}, denominator = {n_rpp}, proportion = {prop_inclusive:.4f}  ({prop_inclusive*100:.2f}%)')

# Sensitivity C: success-only (replicated == 1) within rpp, using primary junior def
rpp_ok = rpp[rpp['replicated'] == 1]
n_rpp_ok = len(rpp_ok)
num_ok = (rpp_ok['seniority.r'] == 'Assistant Professor').sum()
prop_ok = num_ok / n_rpp_ok if n_rpp_ok else float('nan')
print(f'\nSENSITIVITY C: success-only, junior = "Assistant Professor" only')
print(f'  numerator = {num_ok}, denominator (replicated==1) = {n_rpp_ok}, proportion = {prop_ok:.4f}  ({prop_ok*100:.2f}%)')

# Reference: senior author of the ORIGINAL paper (seniority.o), for context only
num_orig = (rpp['seniority.o'] == 'Assistant Professor').sum()
print(f'\nREFERENCE (not part of answer): senior author of original paper = "Assistant Professor" in rpp: {num_orig}/{n_rpp}')

# ---- By-project breakdown within Psychology-relevant rows (broad Social+Cognitive scope)
broad = df_keep[df_keep['discipline'].isin(['Social', 'Cognitive'])].copy()
print(f'\nBROAD Psychology-relevant scope (discipline ∈ {{Social, Cognitive}}, drop == False): {len(broad)} rows (pre-dedup)')

# Deduplicate by (id, project) — ML1/ML3 have multiple labs per study id; count each unique study once.
broad_dedup = broad.drop_duplicates(subset=['project', 'id']).copy()
print(f'  after dedup by (project, id): {len(broad_dedup)} unique replication-study rows')

print('\nBY-PROJECT breakdown (unique replication studies; broad scope):')
by_proj = []
for proj, g in broad_dedup.groupby('project'):
    n = len(g)
    njun = (g['seniority.r'] == 'Assistant Professor').sum()
    njun_inc = g['seniority.r'].isin(junior_inclusive).sum()
    pstrict = njun / n if n else np.nan
    pinc = njun_inc / n if n else np.nan
    by_proj.append({'project': proj, 'n_unique_studies': n,
                    'n_junior_strict': njun, 'prop_junior_strict': pstrict,
                    'n_junior_inclusive': njun_inc, 'prop_junior_inclusive': pinc})
    print(f'  project={proj:>4}  n={n:>4}  junior_assistant_professor={njun}/{n} = {pstrict:.4f}  '
          f'(incl+Assistant={njun_inc}/{n} = {pinc:.4f})')

# Overall across the broad scope using primary def
n_broad = len(broad_dedup)
njun_broad = (broad_dedup['seniority.r'] == 'Assistant Professor').sum()
njuninc_broad = broad_dedup['seniority.r'].isin(junior_inclusive).sum()
prop_broad = njun_broad / n_broad if n_broad else np.nan
prop_broad_inc = njuninc_broad / n_broad if n_broad else np.nan
print(f'\nBROAD-SCOPE pooled (dedup by project,id): strict = {njun_broad}/{n_broad} = {prop_broad:.4f}; '
      f'inclusive = {njuninc_broad}/{n_broad} = {prop_broad_inc:.4f}')

# Cross-check: are there (theoretically) seniority.r values differing within the same (project, id)?
g = broad.groupby(['project', 'id'])['seniority.r'].nunique(dropna=False)
multi = g[g > 1]
print(f'\n  cross-check: number of (project,id) groups with >1 distinct seniority.r: {len(multi)}')

# ---- Save outputs
summary = {
    'data_file': str(DATA.relative_to(ROOT)),
    'seniority_column_used': 'seniority.r',
    'seniority_column_note': ("schema's textual description for seniority.r is mis-labelled; "
                              "the .o/.r naming convention is what the data follow, so "
                              "seniority.r = senior author of the replication study."),
    'drop_filter_applied': 'drop == False',
    'primary_scope': {
        'definition': 'project == "rpp" (Psychology replication project), drop == False',
        'denominator': int(n_rpp),
        'junior_definition': '"Assistant Professor" only',
        'numerator': int(num_primary),
        'proportion': float(prop_primary),
        'pct': round(prop_primary * 100, 2),
    },
    'sensitivities': {
        'A_inclusive_junior': {
            'definition': 'junior = "Assistant Professor" OR "Assistant" (Researcher excluded)',
            'denominator': int(n_rpp),
            'numerator': int(num_inclusive),
            'proportion': float(prop_inclusive),
            'pct': round(prop_inclusive * 100, 2),
        },
        'B_broad_social_cognitive_scope': {
            'definition': 'discipline ∈ {Social, Cognitive}, drop==False, dedup by (project,id)',
            'denominator': int(n_broad),
            'numerator': int(njun_broad),
            'proportion_strict': float(prop_broad),
            'pct_strict': round(prop_broad * 100, 2),
            'numerator_inclusive': int(njuninc_broad),
            'proportion_inclusive': float(prop_broad_inc),
            'pct_inclusive': round(prop_broad_inc * 100, 2),
            'by_project': by_proj,
        },
        'C_success_only_within_rpp': {
            'definition': 'project == "rpp", replicated == 1, junior = "Assistant Professor" only',
            'denominator': int(n_rpp_ok),
            'numerator': int(num_ok),
            'proportion': float(prop_ok),
            'pct': round(prop_ok * 100, 2),
        },
    },
    'reference_context': {
        'project_rpp_seniority_o_assistant_professor': f'{num_orig}/{n_rpp}',
    },
}
with (OUT / 'summary.json').open('w') as f:
    json.dump(summary, f, indent=2)
pd.DataFrame(by_proj).to_csv(OUT / 'by_project_breakdown.csv', index=False)

print('\nWrote', OUT / 'summary.json', 'and', OUT / 'by_project_breakdown.csv')
