"""
NLSY79 wealth comparison by racial/ethnic cohort (1985, 1990, 1996).
DiscoveryBench / full_workflow — question
"How does the median wealth of white individuals compare to that of black
 and Hispanic individuals from 1985 onwards?"

Cohort-code mapping (verified byte-for-byte from raw header):
  1:BLACK
  2:HISPANIC
  3:NON-BLACK NON-HISPANIC   <-- used as the '~White' proxy because the codebook
                                  does not isolate non-Hispanic Whites.
No sampling-weight column exists in nls_raw.csv (only anthropometric body weights
in kg). All medians below are unweighted and computed on per-year available cases,
using RAW nominal dollars (no CPI deflation, no winsorization, no log-transform).
"""
import pandas as pd, numpy as np, os, json

CSV = '/workspace/data/nls_raw.csv'
OUT = '/workspace/artifacts'
os.makedirs(OUT, exist_ok=True)

COHORT_COL  = 'Racial/ethnic cohort, 1979'
ID_COL      = 'ID# (range 1-12686) 1979'
W85  = 'Family net wealth, 1985'
W90  = 'Family net wealth, 1990'
W96  = 'Family net wealth, 1996 (key data point)'
RES  = {y: f'Market value of residential property respondent/spouse own, {y}' for y in [1985,1990,1996]}
FBO  = {y: f'Total market value of farm, business, and other property, {y}'     for y in [1985,1990,1996]}
VEH  = {1985: 'Market Value of vehicles respondent/spouse own, 1985',
        1990: 'Market Value of vehicles respondent/spouse own, 1990',
        1996: 'Market Value of vehicles respondent/spouse own, 96'}   # raw truncated-year column
OTH  = {y: f'Total market value of items over $500, {y}'              for y in [1985,1990,1996]}

df = pd.read_csv(CSV, low_memory=False)

# Cohort labels
cohort_label = {1: 'Black (cohort==1)', 2: 'Hispanic (cohort==2)', 3: '~White proxy (cohort==3, Non-Black Non-Hispanic)'}
df['cohort_label'] = df[COHORT_COL].map(cohort_label)

# --- (A) Headline: per-year available-case medians ----------
rows = []
for c in [1,2,3]:
    sub = df[df[COHORT_COL] == c]
    for y, col in [(1985,W85),(1990,W90),(1996,W96)]:
        s = sub[col].dropna()
        rows.append({'cohort_code': c,
                     'cohort_label': cohort_label[c],
                     'year': y,
                     'n': int(len(s)),
                     'median_family_net_wealth_$': float(s.median())})
headline = pd.DataFrame(rows)
print('=== HEADLINE: per-year available-case medians (nominal $, unweighted) ===')
print(headline.to_string(index=False))
headline.to_csv(os.path.join(OUT,'headline_medians_by_year_cohort.csv'), index=False)

# --- (B) Balanced robust: respondents with non-null wealth in 1985,1990,1996 ---
mask_all3 = df[[W85,W90,W96]].notna().all(axis=1)
bal = df[mask_all3]
print(f'\n=== BALANCED sub-sample: respondents with all three waves non-null ===')
print('total n:', len(bal))
print('cohort counts in balanced sample:')
print(bal[COHORT_COL].value_counts().sort_index().to_string())

rows_b = []
for c in [1,2,3]:
    sub = bal[bal[COHORT_COL] == c]
    for y, col in [(1985,W85),(1990,W90),(1996,W96)]:
        s = sub[col]
        rows_b.append({'cohort_code': c,
                       'cohort_label': cohort_label[c],
                       'year': y,
                       'n': int(len(s)),
                       'median_family_net_wealth_$': float(s.median())})
balanced = pd.DataFrame(rows_b)
print('\n=== ROBUSTNESS: balanced-sample medians (same n in every year by construction) ===')
print(balanced.to_string(index=False))
balanced.to_csv(os.path.join(OUT,'balanced_sample_medians.csv'), index=False)

# --- (E) Ancillary component breakdown at 1996 only ---
print('\n=== ANCILLARY component medians at 1996 (per-year available cases) ===')
rows_c = []
for c in [1,2,3]:
    sub = df[df[COHORT_COL] == c]
    for label, col in [('residential_property_$', RES[1996]),
                       ('farm_business_other_$',   FBO[1996]),
                       ('vehicles_$',              VEH[1996]),
                       ('items_over_500_$',        OTH[1996])]:
        s = sub[col].dropna()
        rows_c.append({'cohort_code': c,
                       'cohort_label': cohort_label[c],
                       'year': 1996,
                       'component': label,
                       'n': int(len(s)),
                       'median_$': float(s.median())})
components_1996 = pd.DataFrame(rows_c)
print(components_1996.to_string(index=False))
components_1996.to_csv(os.path.join(OUT,'components_1996_ancillary.csv'), index=False)

# --- Disparity ratios (1996, headline and balanced) ---
print('\n=== Disparity ratios vs ~White proxy (cohort==3) at 1996 ===')
for tag, tab in [('headline', headline), ('balanced', balanced)]:
    w = tab[(tab.cohort_code==3)&(tab.year==1996)]['median_family_net_wealth_$'].iloc[0]
    b = tab[(tab.cohort_code==1)&(tab.year==1996)]['median_family_net_wealth_$'].iloc[0]
    h = tab[(tab.cohort_code==2)&(tab.year==1996)]['median_family_net_wealth_$'].iloc[0]
    print(f'{tag:9s}  1996  Black/White-proxy = {b/w:.3f}   Hispanic/White-proxy = {h/w:.3f}')

# --- Brief dispersion note (negative wealth, max) ---
print('\n=== Dispersion note (1996, all respondents with non-null wealth) ===')
sub96 = df[df[W96].notna()]
print('negatives n=', int((sub96[W96]<0).sum()),
      'min=', float(sub96[W96].min()),
      'max=', float(sub96[W96].max()))

# --- Save a JSON snapshot for reproducibility of the final answer ---
summary = {
    'headline': headline.to_dict(orient='records'),
    'balanced': balanced.to_dict(orient='records'),
    'components_1996_ancillary': components_1996.to_dict(orient='records'),
    'note': 'All medians nominal $, unweighted. No CPI deflation, no winsorization, no log-transform. cohort==3 is a ~White proxy (Non-Black Non-Hispanic).'
}
with open(os.path.join(OUT,'summary.json'),'w') as f:
    json.dump(summary, f, indent=2)
print('\nArtifacts written to', OUT)
