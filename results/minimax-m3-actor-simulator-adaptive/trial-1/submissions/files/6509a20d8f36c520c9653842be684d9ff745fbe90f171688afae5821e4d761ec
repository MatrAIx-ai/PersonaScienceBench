"""
DiscoveryBench / nls_ses — final executed notebook.

Question: Between which two races is the factor of BA degree completion
          -0.9568 when compared to the other?

Answer:    **Hispanic vs. White** (and equivalently White vs. Hispanic) in
           a crude logistic regression of `BA DEGREE COMPLETED` on
           `SAMPLE_RACE` alone, with **White** as the reference level.
           The estimated comparator-vs-reference coefficient on Hispanic is
           **-0.9241** (95% CI -1.3997 to -0.4485, p = 1.4e-4),
           which is the value closest to the target -0.9568 among all
           six pairwise contrasts (distance 0.0327; the next-closest is
           Black-vs-White at -1.0057, distance 0.0489).

See end of file for the table of all fitted coefficients across
crude MLE, adjusted MLE, crude Firth, and adjusted Firth models.
"""
import json, warnings
import numpy as np
import pandas as pd
import statsmodels.api as sm
from scipy import stats

warnings.filterwarnings("ignore")
TARGET = -0.9568

# ---- 0. Load ---------------------------------------------------------
df = pd.read_csv("data/nls_ses_processed.csv")
df = df.rename(columns={
    "FAMILY SIZE OF SAMPLE":            "FAMILY_SIZE",
    "ABILITY: COMPOSITE OF ASVAB SCORE": "ABILITY",
    "PERCENTILE IN CLASS":              "PCT_CLASS",
    "BA DEGREE COMPLETED":              "BA",
    "SAMPLE_RACE":                      "RACE",
    "SAMPLE_SEX":                       "SEX",
})
df["BA"]      = df["BA"].astype(int)
df["SEX_MALE"]= (df["SEX"].astype(str).str.lower()=="male").astype(int)
races        = ["White","Black","Hispanic"]

print("# Cell 1 — Data loading & sanity check")
print(f"Shape: {df.shape}")
print(f"SAMPLE_RACE counts: \n{df['RACE'].value_counts().to_string()}")
print(f"\nBA counts (0=not completed, 1=completed): \n{df['BA'].value_counts().sort_index().to_string()}")
tbl = pd.crosstab(df["RACE"], df["BA"])
tbl.columns = ["BA=0","BA=1"]
tbl["n"] = tbl.sum(axis=1)
tbl["rate_completed"] = tbl["BA=1"]/tbl["n"]
print("\nCross-tab (counts & completion rates):")
print(tbl.round(4).to_string())

# ---- 1. Helpers ------------------------------------------------------
def dummies(ref):
    """Race dummy columns excluding the reference level."""
    out = pd.DataFrame({r: (df["RACE"]==r).astype(int) for r in races})
    return out.drop(columns=[ref])

def firth_fit(X_np, y_np, max_iter=200, tol=1e-9):
    """Firth's penalized-likelihood logistic regression (manual impl.).

    Heinze & Schemper (2002) algorithm: at each IRLS step the working
    response is shifted by  (y - p + h (0.5 - p)) / W  where h is the
    weighted-hat diagonal.
    """
    n,p = X_np.shape
    beta = np.zeros(p)
    for _ in range(max_iter):
        eta  = np.clip(X_np @ beta, -30, 30)
        p    = 1.0/(1.0+np.exp(-eta))
        W    = np.maximum(p*(1-p), 1e-12)
        sqrtW= np.sqrt(W)
        Xw   = X_np * sqrtW[:,None]
        XtWX = Xw.T @ Xw
        try:
            XtWX_inv = np.linalg.inv(XtWX)
        except np.linalg.LinAlgError:
            break
        h       = np.diag(Xw @ XtWX_inv @ Xw.T)
        mod     = (y_np - p) + h*(0.5 - p)
        z_new   = eta + mod/W
        XtW     = X_np.T * W
        try:
            beta_new = np.linalg.solve(XtW @ X_np, XtW @ z_new)
        except np.linalg.LinAlgError:
            break
        if np.max(np.abs(beta_new-beta)) < tol:
            beta = beta_new
            break
        beta = beta_new
    eta   = np.clip(X_np @ beta, -30, 30)
    p     = 1.0/(1.0+np.exp(-eta))
    W     = np.maximum(p*(1-p), 1e-12)
    info  = X_np.T @ (X_np * W[:,None])
    vcov  = np.linalg.inv(info)
    se    = np.sqrt(np.diag(vcov))
    zstat = beta/se
    pval  = 2*(1-stats.norm.cdf(np.abs(zstat)))
    return beta, se, zstat, pval

def run_spec(spec_name, covariates):
    rows = []
    for ref in races:
        d   = dummies(ref)
        parts = [d]
        for c in covariates:
            parts.append(df[c].astype(float).reset_index(drop=True).to_frame())
        Xdf = pd.concat(parts, axis=1)
        X   = sm.add_constant(Xdf).astype(float)
        y   = df["BA"].astype(int).values
        if spec_name.endswith("firth"):
            beta, se, z, pv = firth_fit(X.values, y)
        else:
            r = sm.Logit(y, X).fit(disp=False, method="newton", maxiter=200)
            beta, se, z, pv = r.params.values, r.bse.values, r.tvalues.values, r.pvalues.values
        for cmp in races:
            if cmp == ref: continue
            j = list(X.columns).index(cmp)
            b  = beta[j]; sj = se[j]
            rows.append({"spec":spec_name,"reference":ref,"comparator":cmp,
                         "coef":b,"se":sj,"z":z[j],"p":pv[j],
                         "ci_lo":b-1.96*sj,"ci_hi":b+1.96*sj,"OR":np.exp(b)})
    return pd.DataFrame(rows)

crude     = run_spec("crude",            [])
adjusted  = run_spec("adjusted",         ["SEX_MALE","FAMILY_SIZE","ABILITY","PCT_CLASS","SES"])
firth_cr  = run_spec("crude_firth",      [])
firth_adj = run_spec("adjusted_firth",   ["SEX_MALE","FAMILY_SIZE","ABILITY","PCT_CLASS","SES"])

all_df = pd.concat([crude,adjusted,firth_cr,firth_adj], ignore_index=True)
all_df["distance_to_target"] = (all_df["coef"] - TARGET).abs()

print("\n\n# Cell 2 — All pairwise coefficients across specifications")
for spec, g in all_df.groupby("spec"):
    print(f"\n  spec = {spec}")
    print("  ", g.round(4).to_string(index=False))

best = all_df.loc[all_df["distance_to_target"].idxmin()]
print("\n\n# Cell 3 — Closest match to target -0.9568  (GLOBAL)")
print(best.to_string())

print("\n\n# Cell 4 — Best per specification")
for spec, g in all_df.groupby("spec"):
    b = g.loc[g["distance_to_target"].idxmin()]
    print(f"  {spec:>20s}: ref={b['reference']:8s} cmp={b['comparator']:8s} "
          f"coef={b['coef']:+.4f}  dist={b['distance_to_target']:.4f}")

# ---- 2. Final chosen pair -------------------------------------------
chosen_ref, chosen_cmp = best["reference"], best["comparator"]
n_ref = int(((df["RACE"]==chosen_ref)).sum())
n_cmp = int(((df["RACE"]==chosen_cmp)).sum())
e_ref = int(((df["RACE"]==chosen_ref)&(df["BA"]==1)).sum())
e_cmp = int(((df["RACE"]==chosen_cmp)&(df["BA"]==1)).sum())
print(f"\n\n# Cell 5 — Final chosen pair report")
print(f"  Reference : {chosen_ref}  (n={n_ref}, BA-completed={e_ref}, rate={e_ref/n_ref:.4%})")
print(f"  Comparator: {chosen_cmp}  (n={n_cmp}, BA-completed={e_cmp}, rate={e_cmp/n_cmp:.4%})")
print(f"  Coefficient (log-odds change, comparator vs reference): {best['coef']:.4f}")
print(f"  Standard error : {best['se']:.4f}")
print(f"  95% CI         : [{best['ci_lo']:.4f}, {best['ci_hi']:.4f}]")
print(f"  z-statistic    : {best['z']:.4f}")
print(f"  p-value        : {best['p']:.4g}")
print(f"  Odds ratio     : {best['OR']:.4f}")
print(f"  Spec           : {best['spec']}")

# Persist JSON for the result-stage handoff payload
out = {
    "target": TARGET,
    "chosen_pair": {
        "spec":        best["spec"],
        "reference":   chosen_ref,
        "comparator":  chosen_cmp,
        "coef":        float(best["coef"]),
        "se":          float(best["se"]),
        "ci_lo":       float(best["ci_lo"]),
        "ci_hi":       float(best["ci_hi"]),
        "z":           float(best["z"]),
        "p":           float(best["p"]),
        "OR":          float(best["OR"]),
        "distance":    float(best["distance_to_target"]),
        "n_ref":       n_ref, "events_ref": e_ref, "rate_ref": e_ref/n_ref,
        "n_cmp":       n_cmp, "events_cmp": e_cmp, "rate_cmp": e_cmp/n_cmp,
    },
    "all_coefficients": all_df.assign(
        reference = all_df["reference"], comparator = all_df["comparator"]
    ).to_dict(orient="records"),
}
with open("artifacts/analysis_results.json","w") as f:
    json.dump(out, f, indent=2, default=float)
print("\nWrote artifacts/analysis_results.json")
