def boot_pdp(fit_fn, dfX, y, B=200):
    n = len(dfX); out = np.zeros((B, len(ages)))
    inc_q = ("AGE_2" in dfX.columns)
    for b in range(B):
        idx = RNG.integers(0, n, n)
        try:
            res = fit_fn(y.iloc[idx], dfX.iloc[idx])
            out[b,:] = pdp(res, dfX.iloc[idx], inc_q)
        except Exception:
            out[b,:] = np.nan
    return out
