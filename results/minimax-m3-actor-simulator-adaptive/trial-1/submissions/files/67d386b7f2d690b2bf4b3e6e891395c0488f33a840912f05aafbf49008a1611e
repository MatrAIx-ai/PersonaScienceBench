def pdp_mnl(res, dfX, names):
    """Average prediction at each AGE, using statsmodels MNLogit.predict() for correctness."""
    o0=[]; o1=[]; o2=[]
    for a in ages:
        d = dfX.copy(); d["AGE"]=a
        Xf = sm.add_constant(d, has_constant="add")
        P = res.predict(Xf).values  # (n, J)
        o0.append(P[:,0].mean()); o1.append(P[:,1].mean()); o2.append(P[:,2].mean())
    return np.array(o0), np.array(o1), np.array(o2)
