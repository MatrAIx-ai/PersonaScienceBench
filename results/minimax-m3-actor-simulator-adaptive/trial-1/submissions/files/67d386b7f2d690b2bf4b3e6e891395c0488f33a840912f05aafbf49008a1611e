def coef_table(res, names):
    return pd.DataFrame({
        "coef":res.params, "se_HC1":res.bse, "z":res.tvalues, "p":res.pvalues,
        "OR":np.exp(res.params),
        "OR_lo95":np.exp(res.params - 1.96*res.bse),
        "OR_hi95":np.exp(res.params + 1.96*res.bse),
    }, index=["const"]+names).round(4)

