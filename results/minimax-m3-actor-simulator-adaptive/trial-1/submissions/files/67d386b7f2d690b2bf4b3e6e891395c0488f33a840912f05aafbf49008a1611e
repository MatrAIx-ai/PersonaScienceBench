def ame_pp(res, dfX, names):
    p_hat = res.predict(sm.add_constant(dfX, has_constant="add")).values
    out = {}
    xlabs = ["const"]+names
    for nm in names:
        ix = xlabs.index(nm)
        out[nm] = (p_hat*(1-p_hat)*res.params.iloc[ix]).mean()
    return pd.Series(out)
