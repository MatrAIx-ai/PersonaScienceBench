mname = {0:"save more", 1:"same", 2:"save less"}
def ame_mnl(res, dfX, names, var="AGE"):
    """Multi AMEs for an MNL where res.params has shape (K_x, J-1) so xb = Xfull @ betas
    (rows = features including const, cols = J-1 non-reference categories)."""
    Xfull = sm.add_constant(dfX, has_constant="add").values  # (n, K_x)
    betas = res.params.values                                # (K_x, J-1)
    xb = Xfull @ betas                                       # (n, J-1)
    e = np.exp(xb - xb.max(axis=1, keepdims=True))
    # add reference category with utility 0 -> probability weight = 1
    e = np.column_stack([np.ones(len(dfX)), e])              # (n, J)
    P = e / e.sum(axis=1, keepdims=True)
    ix = (["const"]+names).index(var)
    # betas_for_cat[j-1, k] for non-ref j; for j=0 (reference) the coefficient is zero
    # effect of x_var on category j: dPj/dx_var = Pj * (betaj_k - sum_l Pl*beta_l_k)
    row = np.concatenate([[0.0], betas[ix, :]])              # length J (row of coefficients for var across all categories including ref=0)
    weighted = P @ row                                       # (n,)
    out = {}
    for j, name in mname.items():
        # dPj/dx_var = Pj*(beta_jk - weighted)
        col_beta_j = 0.0 if j == 0 else betas[ix, j-1]
        eff = P[:, j] * (col_beta_j - weighted)
        out[name] = float(eff.mean())
    return pd.Series(out)

