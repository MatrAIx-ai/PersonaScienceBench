"""
Main analysis: wealth inequality change, white males and white females, 1990 -> 1996.

Scope:
  - Subset: race == "white", sex in {male, female}
  - Year columns: composite_wealth_1990, composite_wealth_1996
  - Treats 1990 and 1996 as two independent cross-sections (no respondent ID in file).
  - Zeros retained in primary run; drop-zeros is a documented sensitivity.
  - Negatives retained for raw and rank-based metrics; excluded only from log-based
    percentile ratios, with the excluded tail size reported.
"""
import numpy as np
import pandas as pd

PATH = "data/nls_incarceration_processed.csv"
df = pd.read_csv(PATH)

white = df[df["race"] == "white"].copy()
print(f"White subsample n = {len(white)}")
print(f"  female = {(white.sex=='female').sum()}, male = {(white.sex=='male').sum()}")
print(f"\never_jailed distribution (white):")
print(white.ever_jailed.value_counts().to_dict())


def cell_metrics(values, drop_zeros=False):
    """Compute the inequality battery for a single (sex, year) cell."""
    w = np.asarray(values, dtype=float)
    if drop_zeros:
        w = w[w != 0]

    n = int(w.size)
    n_neg = int((w < 0).sum())
    n_zero = int((w == 0).sum())
    n_pos = int((w > 0).sum())

    mean_v = float(np.mean(w))
    median_v = float(np.median(w))
    sd_v = float(np.std(w, ddof=1))
    p10 = float(np.percentile(w, 10))
    p25 = float(np.percentile(w, 25))
    p50 = float(np.percentile(w, 50))
    p75 = float(np.percentile(w, 75))
    p90 = float(np.percentile(w, 90))
    p95 = float(np.percentile(w, 95))
    iqr = p75 - p25

    sw = np.sort(w)
    ranks = np.arange(1, n + 1)
    total_w = float(np.sum(w))
    if total_w > 0:
        gini = float((2.0 * np.sum(sw * ranks)) / (n * total_w) - (n + 1) / n)
    else:
        gini = np.nan

    pos = w[w > 0]
    if pos.size > 1 and np.mean(pos) > 0:
        ratio = pos / np.mean(pos)
        theil_T = float(np.mean(ratio * np.log(ratio)))
    else:
        theil_T = np.nan

    p90_p10_raw = p90 / p10 if p10 != 0 else np.nan

    if pos.size > 1:
        lp90 = float(np.percentile(pos, 90))
        lp10 = float(np.percentile(pos, 10))
        log_p90_p10 = float(np.log(lp90) - np.log(lp10))
    else:
        lp90, lp10, log_p90_p10 = np.nan, np.nan, np.nan
    n_excl_log = n - n_pos

    if total_w > 0:
        desc = np.sort(w)[::-1]
        k10 = int(np.ceil(0.10 * n))
        k5 = int(np.ceil(0.05 * n))
        k1 = max(1, int(np.ceil(0.01 * n)))
        top10_share = float(np.sum(desc[:k10]) / total_w)
        top5_share = float(np.sum(desc[:k5]) / total_w)
        top1_share = float(np.sum(desc[:k1]) / total_w)
    else:
        top10_share = top5_share = top1_share = np.nan

    return {
        "n": n, "n_negative": n_neg, "n_zero": n_zero, "n_positive": n_pos,
        "n_excluded_from_log": n_excl_log,
        "mean": mean_v, "median": median_v, "sd": sd_v,
        "p10": p10, "p25": p25, "p50": p50, "p75": p75, "p90": p90, "p95": p95,
        "iqr": iqr,
        "p90_p10_raw": p90_p10_raw,
        "log_p90_p10_positives": log_p90_p10,
        "gini": gini, "theil_T_positives": theil_T,
        "top10_share": top10_share, "top5_share": top5_share, "top1_share": top1_share,
    }


cells = []
for sex in ["male", "female"]:
    for yr in [1990, 1996]:
        v = white.loc[white.sex == sex, f"composite_wealth_{yr}"].values
        for dz, label in [(False, "with_zeros"), (True, "drop_zeros")]:
            r = cell_metrics(v, drop_zeros=dz)
            r["sex"] = sex
            r["year"] = yr
            r["condition"] = label
            cells.append(r)

results = pd.DataFrame(cells)

col_order = [
    "sex", "year", "condition",
    "n", "n_negative", "n_zero", "n_positive", "n_excluded_from_log",
    "mean", "median", "sd", "p10", "p25", "p50", "p75", "p90", "p95", "iqr",
    "p90_p10_raw", "log_p90_p10_positives",
    "gini", "theil_T_positives",
    "top10_share", "top5_share", "top1_share",
]
results = results[col_order]

print("\n=== Per-cell metrics (full table) ===")
pd.set_option("display.width", 240)
pd.set_option("display.max_columns", 40)
print(results.to_string(index=False))

results.to_csv("artifacts/per_cell_metrics.csv", index=False)

deltas = []
metric_cols = [
    "n", "n_negative", "n_zero", "n_positive", "n_excluded_from_log",
    "mean", "median", "sd", "p10", "p25", "p50", "p75", "p90", "p95", "iqr",
    "p90_p10_raw", "log_p90_p10_positives",
    "gini", "theil_T_positives", "top10_share", "top5_share", "top1_share",
]
for sex in ["male", "female"]:
    for cond in ["with_zeros", "drop_zeros"]:
        d = {"sex": sex, "condition": cond}
        for m in metric_cols:
            v90 = results.loc[(results.sex == sex) & (results.year == 1990) &
                              (results.condition == cond), m].iloc[0]
            v96 = results.loc[(results.sex == sex) & (results.year == 1996) &
                              (results.condition == cond), m].iloc[0]
            d[f"d_{m}"] = v96 - v90
            d[f"v1990_{m}"] = v90
            d[f"v1996_{m}"] = v96
        deltas.append(d)

delta_df = pd.DataFrame(deltas)
delta_df.to_csv("artifacts/delta_metrics.csv", index=False)

print("\n=== Delta tables (1996 - 1990) ===")
disp_cols = ["sex", "condition",
             "v1990_mean", "v1996_mean", "d_mean",
             "v1990_median", "v1996_median", "d_median",
             "v1990_p10", "v1996_p10", "d_p10",
             "v1990_p50", "v1996_p50", "d_p50",
             "v1990_p90", "v1996_p90", "d_p90",
             "v1990_sd", "v1996_sd", "d_sd",
             "v1990_gini", "v1996_gini", "d_gini",
             "v1990_theil_T_positives", "v1996_theil_T_positives", "d_theil_T_positives",
             "v1990_p90_p10_raw", "v1996_p90_p10_raw", "d_p90_p10_raw",
             "v1990_log_p90_p10_positives", "v1996_log_p90_p10_positives",
             "d_log_p90_p10_positives",
             "v1990_top10_share", "v1996_top10_share", "d_top10_share"]
print(delta_df[disp_cols].to_string(index=False))

print("\n=== Female minus Male change (1990->1996) ===")
contrast_rows = []
for cond in ["with_zeros", "drop_zeros"]:
    row = {"condition": cond}
    for m in ["mean", "median", "sd", "gini", "theil_T_positives",
              "p90_p10_raw", "log_p90_p10_positives", "top10_share"]:
        f_delta = delta_df.loc[(delta_df.sex == "female") & (delta_df.condition == cond),
                               f"d_{m}"].iloc[0]
        m_delta = delta_df.loc[(delta_df.sex == "male") & (delta_df.condition == cond),
                               f"d_{m}"].iloc[0]
        row[f"d_{m}_F_minus_M"] = f_delta - m_delta
    contrast_rows.append(row)
contrast_df = pd.DataFrame(contrast_rows)
print(contrast_df.to_string(index=False))
contrast_df.to_csv("artifacts/contrast_F-m_M.csv", index=False)


# ------------------- compact formatted evidence block (use helpers) -----------
def fmoney(x):
    if pd.isna(x):
        return "       n/a"
    return f"${x:>10,.0f}"

def fpct(x, w=6, p=3):
    if pd.isna(x):
        return " " * w
    return f"{x:>{w}.{p}f}"

def fnum(x, w=6):
    if pd.isna(x):
        return " " * w
    return f"{x:>{w},.0f}"

def fgini(x):
    if pd.isna(x):
        return "  n/a"
    return f"{x:.3f}"

print("\n\n================== COMPACT EVIDENCE BLOCK ==================\n")
print(f"{'cell':32s} {'n':>5s} {'neg':>4s} {'mean':>12s} {'median':>12s} "
      f"{'p10':>12s} {'p50':>12s} {'p90':>12s} {'sd':>12s} "
      f"{'gini':>5s} {'P90/P10':>8s} {'logP90/P10':>10s} {'top10%':>7s}")
print("-" * 155)
for _, r in results.iterrows():
    label = f"W{r['sex'][0].upper()}-{r['year']}-{r['condition']}"
    print(f"{label:32s} {r['n']:>5d} {r['n_negative']:>4d} "
          f"{fmoney(r['mean']):>12s} {fmoney(r['median']):>12s} "
          f"{fmoney(r['p10']):>12s} {fmoney(r['p50']):>12s} "
          f"{fmoney(r['p90']):>12s} {fmoney(r['sd']):>12s} "
          f"{fgini(r['gini']):>5s} "
          f"{fpct(r['p90_p10_raw'], 8, 2):>8s} "
          f"{fpct(r['log_p90_p10_positives'], 10, 4):>10s} "
          f"{fpct(r['top10_share']*100, 7, 2):>7s}")

