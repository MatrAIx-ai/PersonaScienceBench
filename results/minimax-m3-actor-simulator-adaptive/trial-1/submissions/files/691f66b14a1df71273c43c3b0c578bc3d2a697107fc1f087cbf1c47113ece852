          f"{fmoney(r['d_sd']):>12s} "
          f"{fpct(r['d_gini'], 8, 4):>8s} "
          f"{fpct(r['d_p90_p10_raw'], 10, 3):>10s} "
          f"{fpct(r['d_log_p90_p10_positives'], 12, 4):>12s} "
          f"{fpct(r['d_top10_share']*100, 10, 3):>10s}")

print("\nFemale - Male contrast on changes (with_zeros):")
male_deltas = delta_df[(delta_df.condition == "with_zeros") & (delta_df.sex == "male")].iloc[0]
female_deltas = delta_df[(delta_df.condition == "with_zeros") & (delta_df.sex == "female")].iloc[0]
contrast_metrics = ["mean", "median", "sd", "gini", "p90_p10_raw",
                    "log_p90_p10_positives", "top10_share"]
for m in contrast_metrics:
    f_d = female_deltas[f"d_{m}"]
    m_d = male_deltas[f"d_{m}"]
    print(f"  d_{m} (F - M) = {(f_d - m_d):+.4f}")
