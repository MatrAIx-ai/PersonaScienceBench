import numpy as np, pandas as pd, warnings
import statsmodels.api as sm
from scipy.special import expit
warnings.filterwarnings('ignore')

df = pd.read_csv('data/nls_ses_processed.csv', index_col=0)
df = df.rename(columns={'BA DEGREE COMPLETED':'BA'})
df['BA'] = df['BA'].astype(int)
df['is_black'] = (df['SAMPLE_RACE']=='Black').astype(int)
df['is_hisp']  = (df['SAMPLE_RACE']=='Hispanic').astype(int)
df['female']   = (df['SAMPLE_SEX']=='Female').astype(int)

# Terciles
cut = df['SES'].quantile([1/3,2/3]).values
df['ses_lo'] = ((df['SES']>cut[0]) & (df['SES']<=cut[1])).astype(int)
df['ses_hi'] = (df['SES']>cut[1]).astype(int)
df['B_lo'] = df['is_black']*df['ses_lo']
df['B_hi'] = df['is_black']*df['ses_hi']
df['H_lo'] = df['is_hisp']*df['ses_lo']
df['H_hi'] = df['is_hisp']*df['ses_hi']

df['asvab_c'] = (df['ABILITY: COMPOSITE OF ASVAB SCORE']-
                 df['ABILITY: COMPOSITE OF ASVAB SCORE'].mean())/df['ABILITY: COMPOSITE OF ASVAB SCORE'].std()
df['pct_c']   = (df['PERCENTILE IN CLASS']-df['PERCENTILE IN CLASS'].mean())/df['PERCENTILE IN CLASS'].std()
df['famsz']   = df['FAMILY SIZE OF SAMPLE']
df['_1'] = 1.0

X = df[['_1','is_black','is_hisp','ses_lo','ses_hi','B_lo','B_hi','H_lo','H_hi',
        'female','asvab_c','pct_c','famsz']]
y = df['BA']
mask = X.notna().all(axis=1) & y.notna()
X, y = X[mask], y[mask]
model = sm.Logit(y, X).fit(disp=0, maxiter=300)
print(f"N used: {len(y)}; Events: {int(y.sum())}\n")
print(model.summary().tables[1])

def me(race_val, ses):
    b = int(race_val=='Black'); h = int(race_val=='Hispanic')
    lo = int(ses in ('Mid',)); hi = int(ses=='High')
    keys = ['_1','is_black','is_hisp','ses_lo','ses_hi','B_lo','B_hi','H_lo','H_hi']
    xb = sum(model.params[k]*v for k,v in zip(keys,
            [1,b,h,lo,hi,b*lo,b*hi,h*lo,h*hi]))
    return expit(xb)

print("\nAdjusted predicted BA-completion probabilities (at population-mean covariates):")
print(f"{'SES':<6}{'Black':>10}{'Hispanic':>12}{'White':>10}")
for ses in ['Low','Mid','High']:
    print(f"{ses:<6}{me('Black',ses)*100:>9.2f}%{me('Hispanic',ses)*100:>11.2f}%{me('White',ses)*100:>9.2f}%")

with open('/workspace/artifacts/logit_results.txt','w') as f:
    f.write(model.summary().as_text())
