"""
World Bank Education x Income - SSA (SSF) vs LMC, 1975-2015.
This script executes the approved plan:
  (a) reshape to long panel + descriptive trajectories,
  (b) per-group log-log OLS of GNIpc on Educ expenditure (% GNI)
      with controls + Newey-West HAC SE,
  (c) pooled panel with D_SSA x log(EducExp) interaction + time trend,
  (d) first-differences (FD) robustness for LMC (FD for SSA infeasible),
  (e) prints a synthesis to STDOUT.
Inputs : /workspace/data/worldbank_education_gdp.csv
Outputs: console (saved by redirect)
"""
import warnings, math, sys
warnings.filterwarnings("ignore")

import numpy as np
import pandas as pd
import statsmodels.api as sm
from statsmodels.stats.diagnostic import acorr_ljungbox

CSV = "/workspace/data/worldbank_education_gdp.csv"

# 0. Load and reshape to LONG
raw = pd.read_csv(CSV)
year_cols = [c for c in raw.columns if c.startswith(("19", "20"))]
assert len(year_cols) == 41, len(year_cols)

def melt_one(df, value_name):
    out = df.melt(
        id_vars=["Country Group", "Country Code", "Series Name", "Series Code"],
        value_vars=year_cols, var_name="Year", value_name=value_name,
    )
    out["Year"] = out["Year"].str.extract(r"(\d{4})").astype(int)
    return out[["Country Group", "Country Code", "Year", value_name]]

indicators = {
    "NY.GNP.PCAP.KD": "GNIpc",
    "NY.ADJ.AEDU.GN.ZS": "EducExp",
    "NE.EXP.GNFS.KD.ZG": "Exports",
    "SE.PRM.ENRR": "PrimEnr",
    "SE.SEC.ENRR": "SecEnr",
    "SL.TLF.CACT.ZS": "LFpart",
}

panels = {}
for code, name in indicators.items():
    sub = raw[raw["Series Code"] == code].copy()
    panels[name] = melt_one(sub, name)

panel = panels["GNIpc"]
for name in ["EducExp", "Exports", "PrimEnr", "SecEnr", "LFpart"]:
    panel = panel.merge(panels[name].drop(columns=["Country Group"]),
                        on=["Country Code", "Year"], how="outer")
panel = panel.sort_values(["Country Code", "Year"]).reset_index(drop=True)

print("="*78); print("(0) PANEL STRUCTURE"); print("="*78)
print(f"Shape        : {panel.shape}")
print(f"Years        : {panel.Year.min()} - {panel.Year.max()}  (T={panel.Year.nunique()})")
print(f"Groups       : {sorted(panel['Country Code'].unique())}")
for cc in ["SSF", "LMC"]:
    sub = panel[panel["Country Code"] == cc]
    print(f"\n--- {cc} ({sub['Country Group'].iloc[0]}) ---")
    print(f"  rows         : {len(sub)}")
    for v in ["GNIpc","EducExp","Exports","PrimEnr","SecEnr","LFpart"]:
        nn = sub[v].notna().sum(); mis = sub[v].isna().sum()
        print(f"  {v:<10s} obs  : {nn} (missing {mis})")

# 1. Descriptive trajectories (key year snapshots)
print("\n" + "="*78); print("(1) TRAJECTORIES - key year snapshots"); print("="*78)
key_years = [1975, 1980, 1985, 1990, 1995, 2000, 2005, 2010, 2015]
disp = panel[panel.Year.isin(key_years)].copy()
disp["GNIpc_r"] = disp["GNIpc"].round(1)
disp["Educ_r"]  = disp["EducExp"].round(2)
disp["Exp_r"]   = disp["Exports"].round(2)
disp["Pri_r"]   = disp["PrimEnr"].round(1)
disp["Sec_r"]   = disp["SecEnr"].round(1)
disp["LF_r"]    = disp["LFpart"].round(2)
tbl = disp.pivot(index="Year", columns="Country Code",
                 values=["GNIpc_r","Educ_r","Exp_r","Pri_r","Sec_r","LF_r"])
print(tbl.to_string())

# Endpoint ratios
def gni_change(g):
    d = g.dropna(subset=["GNIpc"])
    if len(d) < 2: return None
    return float(d.GNIpc.iloc[-1] / d.GNIpc.iloc[0])
def educ_change(g):
    d = g.dropna(subset=["EducExp"])
    if len(d) < 2: return None
    return float(d.EducExp.iloc[-1] / d.EducExp.iloc[0])
print("\nEndpoint ratio (2015 / first available year):")
for cc in ["SSF", "LMC"]:
    g = panel[panel["Country Code"] == cc]
    rg = gni_change(g); re_ = educ_change(g)
    # also % change per year approx:
    gny = g.dropna(subset=["GNIpc"])
    yrs_g = gny.Year.max()-gny.Year.min()
    cagr_g = (gny.GNIpc.iloc[-1]/gny.GNIpc.iloc[0])**(1/yrs_g)-1
    print(f"  {cc}: GNIpc first->last = {gny.GNIpc.iloc[0]:.1f} -> {gny.GNIpc.iloc[-1]:.1f} "
          f"(CAGR {cagr_g*100:+.2f}%/yr over {yrs_g}y)")
    gne = g.dropna(subset=["EducExp"])
    yrs_e = gne.Year.max()-gne.Year.min()
    cagr_e = (gne.EducExp.iloc[-1]/gne.EducExp.iloc[0])**(1/yrs_e)-1
    print(f"        EducExp first->last = {gne.EducExp.iloc[0]:.2f} -> {gne.EducExp.iloc[-1]:.2f} "
          f"(CAGR {cagr_e*100:+.2f}%/yr over {yrs_e}y)")

# 2. Correlations between log(EducExp) and log(GNIpc), per group
print("\n" + "="*78); print("(2) CORRELATIONS - log(EducExp) vs log(GNIpc) per group"); print("="*78)
def corr_block(g, label):
    d = g[["Year","GNIpc","EducExp"]].dropna()
    if len(d) < 3:
        print(f"  {label}: n={len(d)} (insufficient)"); return None
    x = np.log(d["EducExp"].astype(float)); y = np.log(d["GNIpc"].astype(float))
    p = float(np.corrcoef(x, y)[0,1])
    s = float(pd.Series(x).corr(pd.Series(y), method="spearman"))
    print(f"  {label}: T={len(d)}, Pearson = {p:+.3f}, Spearman = {s:+.3f}")
    return p

for cc in ["SSF", "LMC"]:
    corr_block(panel[panel["Country Code"] == cc], f"{cc} (full available window)")

print("\n  -- on common matched window 2010-2015 --")
sub = panel[(panel.Year >= 2010) & (panel.Year <= 2015)]
for cc in ["SSF", "LMC"]:
    corr_block(sub[sub["Country Code"] == cc], cc)

# Cross-pair correlations
print("\n  -- cross-pair correlations on 2010-2015 --")
wide = sub.pivot(index="Year", columns="Country Code",
                 values=["EducExp","GNIpc"]).dropna(how="any")
e_SSF = np.log(wide[("EducExp","SSF")].astype(float))
e_LMC = np.log(wide[("EducExp","LMC")].astype(float))
g_SSF = np.log(wide[("GNIpc","SSF")].astype(float))
g_LMC = np.log(wide[("GNIpc","LMC")].astype(float))
print(f"  cor(log(Educ_SSF), log(GNIpc_LMC)) = {np.corrcoef(e_SSF, g_LMC)[0,1]:+.3f}")
print(f"  cor(log(Educ_LMC), log(GNIpc_SSF)) = {np.corrcoef(e_LMC, g_SSF)[0,1]:+.3f}")
print(f"  cor(log(GNIpc_SSF), log(GNIpc_LMC)) = {np.corrcoef(g_SSF, g_LMC)[0,1]:+.3f}")

# Per-group correlation of changes (Δ log)
def fd_corr(g, label):
    d = g.sort_values("Year")[["Year","GNIpc","EducExp"]].dropna()
    if len(d) < 4: return
    dy = np.log(d["GNIpc"].astype(float)).diff()
    de = np.log(d["EducExp"].astype(float)).diff()
    cc_ = float(np.corrcoef(de.dropna(), dy.dropna())[0,1])
    print(f"  {label}: cor(Δlog Educ, Δlog GNIpc) = {cc_:+.3f}  (T-1 = {len(d)-1})")

print("\n  -- first-difference correlations per group --")
for cc in ["SSF", "LMC"]:
    fd_corr(panel[panel["Country Code"] == cc], f"{cc} (full)")

# 3. Per-group log-log regressions with Newey-West HAC
print("\n" + "="*78); print("(3) PER-GROUP LOG-LOG REGRESSIONS"); print("="*78)

def run_ols(df, y, x_vars, hac_maxlag=None, label="", transform_log=True):
    d = df[["Year", y] + x_vars].dropna().copy()
    if d.shape[0] < len(x_vars) + 3:
        print(f"  [{label}] insufficient obs: n={d.shape[0]}, p={len(x_vars)}")
        return None
    X = sm.add_constant(d[x_vars].astype(float))
    yy = np.log(d[y].astype(float))
    Xlog = X.copy()
    for v in x_vars:
        if transform_log and v != "Exports":
            Xlog[v] = np.log(X[v].astype(float))
    if hac_maxlag is None:
        hac_maxlag = max(1, int(np.floor(d.shape[0] ** (1/3))))
    mod = sm.OLS(yy, Xlog).fit()
    res = mod.get_robustcov_results(cov_type="HAC", maxlags=hac_maxlag)
    # res.params / res.bse may be ndarray (post-robust); wrap into Series
    pnames = Xlog.columns.tolist()
    params_s = pd.Series(np.asarray(res.params).ravel(), index=pnames)
    bse_s    = pd.Series(np.asarray(res.bse).ravel(),    index=pnames)
    print(f"\n  [{label}]   n={d.shape[0]}, HAC lags={hac_maxlag}, d.f.={d.shape[0]-Xlog.shape[1]}")
    print(f"  Dependent   : log({y})")
    print(f"  Regressors  : const, " + ", ".join(x_vars) + " (log except Exports)")
    print(f"  Coeffs (HAC-SE in parens):")
    for name in pnames:
        b = params_s[name]; se = bse_s[name]
        print(f"     {name:<22s}  {b:+.4f}   ({se:.4f})")
    print(f"  R^2 (OLS)    : {res.rsquared:.3f}   Adj-R^2 : {res.rsquared_adj:.3f}")
    resid = np.asarray(res.resid)
    try:
        lb = acorr_ljungbox(resid, lags=[5], return_df=True)
        print(f"  Ljung-Box(5) : stat={float(lb['lb_stat'].iloc[0]):.3f}, p={float(lb['lb_pvalue'].iloc[0]):.3f}")
    except Exception:
        pass
    beta_E = float(params_s["EducExp"])
    sd_logE = float(np.log(d["EducExp"].astype(float)).std(ddof=1))
    print(f"  >>> elasticity GNIpc w.r.t. EducExp (log-log) = {beta_E:+.4f}")
    print(f"      sd(log(EducExp)) = {sd_logE:.3f}  =>  one-sd change in log(EducExp) -> "
          f"{beta_E*sd_logE:+.3f} change in log(GNIpc)  (units-free)")
    return {"res": res, "params": params_s, "bse": bse_s, "data": d, "hac_lag": hac_maxlag, "beta_E": beta_E}

# 3a. LMC (full 1975-2015, controls)
print("\n--- 3a. LMC (1975-2015, controls = PrimEnr, SecEnr) ---")
out_lmc = run_ols(panel[panel["Country Code"] == "LMC"], y="GNIpc",
                  x_vars=["EducExp", "PrimEnr", "SecEnr"], label="LMC levels")

# 3a'. LMC with Exports growth
print("\n--- 3a'. LMC (1975-2015, controls + Exports growth) ---")
out_lmc2 = run_ols(panel[panel["Country Code"] == "LMC"], y="GNIpc",
                   x_vars=["EducExp", "PrimEnr", "SecEnr", "Exports"],
                   label="LMC + Exports growth")

# 3b. LMC pre-GFC
print("\n--- 3b. LMC (1975-2007, robustness pre-GFC) ---")
out_lmc_pre = run_ols(
    panel[(panel["Country Code"] == "LMC") & (panel.Year <= 2007)],
    y="GNIpc",
    x_vars=["EducExp", "PrimEnr", "SecEnr"],
    label="LMC levels 1975-2007",
)

# 3c. SSA (2010-2015, exploratory)
print("\n--- 3c. SSA (2010-2015, MATCHED, exploratory) ---")
ssa_match = panel[(panel["Country Code"] == "SSF") & (panel.Year >= 2010)].copy()
out_ssa = run_ols(ssa_match, y="GNIpc", x_vars=["EducExp"], label="SSA bivariate 2010-2015")

# 3c'. SSA bivariate but only PrimEnr as control
print("\n--- 3c'. SSA (2010-2015, with PrimEnr control, exploratory) ---")
out_ssa2 = run_ols(ssa_match, y="GNIpc", x_vars=["EducExp", "PrimEnr"],
                   label="SSA + PrimEnr 2010-2015")

# Also show the SSF matched window raw data
print("\n  SSA matched data (2010-2015):")
print(ssa_match[["Year","GNIpc","EducExp","PrimEnr","SecEnr","Exports","LFpart"]].to_string(index=False))

# 4. POOLED panel with D_SSA x log(EducExp) interaction on common window 2010-2015
print("\n" + "="*78); print("(4) POOLED PANEL - D_SSA x log(EducExp), 2010-2015"); print("="*78)
pool = panel[(panel.Year >= 2010) & (panel.Year <= 2015)].copy()
pool = pool.dropna(subset=["GNIpc","EducExp","PrimEnr","SecEnr","Exports"]).copy()
print(f"  Pooled sample: T={pool.shape[0]} obs  "
      f"(Years {pool.Year.min()}-{pool.Year.max()}, "
      f"countries {sorted(pool['Country Code'].unique())})")

pool["D_SSA"]      = (pool["Country Code"] == "SSF").astype(int)
pool["lnGNIpc"]    = np.log(pool["GNIpc"].astype(float))
pool["lnEducExp"]  = np.log(pool["EducExp"].astype(float))
pool["lnPrimEnr"]  = np.log(pool["PrimEnr"].astype(float))
pool["lnSecEnr"]   = np.log(pool["SecEnr"].astype(float))
pool["D_SSA_x_E"]  = pool["D_SSA"] * pool["lnEducExp"]
pool["t"]          = pool["Year"] - 2010  # linear time trend

yvar = "lnGNIpc"
xvars = ["D_SSA", "lnEducExp", "D_SSA_x_E", "lnPrimEnr", "lnSecEnr", "t", "Exports"]
X = sm.add_constant(pool[xvars].astype(float))
Y = pool[yvar].astype(float)
mod_pool = sm.OLS(Y, X).fit()
hac_pool = max(1, int(np.floor(pool.shape[0] ** (1/3))))
res_pool = mod_pool.get_robustcov_results(cov_type="HAC", maxlags=hac_pool)
print(f"\n  [Pooled + interaction]   n={pool.shape[0]}, HAC lags={hac_pool}")
print(f"  {'':24s}  {'coef':>9s}  {'HAC-SE':>9s}")
pnames_p = X.columns.tolist()
pp_pool = pd.Series(np.asarray(res_pool.params).ravel(), index=pnames_p)
se_pool = pd.Series(np.asarray(res_pool.bse).ravel(),    index=pnames_p)
for nm in pnames_p:
    print(f"  {nm:<24s}  {pp_pool[nm]:+.4f}    ({se_pool[nm]:.4f})")
print(f"  R^2 (OLS)    : {res_pool.rsquared:.3f}   Adj-R^2 : {res_pool.rsquared_adj:.3f}")
b_int = float(pp_pool["lnEducExp"])
b_diff = float(pp_pool["D_SSA_x_E"])
print(f"  >>> log-log elasticity LMC (reference) = {b_int:+.4f}")
print(f"  >>> additional elasticity for SSA     = {b_diff:+.4f}")
print(f"  >>> implied total elasticity SSA      = {b_int + b_diff:+.4f}")

# Pooled restricted: without Exports (more obs? drop returns same T since Exports has 1 missing per group 1975-1990)
# but with truncation wins us 5 obs already. Let's also try dropping t (year FE alternative)
print("\n--- 4b. POOLED simplified (no time trend, no Exports) ---")
xvars2 = ["D_SSA", "lnEducExp", "D_SSA_x_E", "lnPrimEnr", "lnSecEnr"]
X2 = sm.add_constant(pool[xvars2].astype(float))
mod_pool2 = sm.OLS(Y, X2).fit()
hac_pool2 = max(1, int(np.floor(pool.shape[0] ** (1/3))))
res_pool2 = mod_pool2.get_robustcov_results(cov_type="HAC", maxlags=hac_pool2)
print(f"  n={pool.shape[0]}, HAC lags={hac_pool2}")
pnames_p2 = X2.columns.tolist()
pp_pool2 = pd.Series(np.asarray(res_pool2.params).ravel(), index=pnames_p2)
se_pool2 = pd.Series(np.asarray(res_pool2.bse).ravel(),    index=pnames_p2)
for nm in pnames_p2:
    print(f"  {nm:<24s}  {pp_pool2[nm]:+.4f}    ({se_pool2[nm]:.4f})")
b_int2 = float(pp_pool2["lnEducExp"])
b_diff2 = float(pp_pool2["D_SSA_x_E"])
print(f"  >>> LMC elasticity = {b_int2:+.4f} | additional SSA = {b_diff2:+.4f} | "
      f"implied SSA total = {b_int2+b_diff2:+.4f}")

# 5. FIRST DIFFERENCES  (LMC feasible; SSA infeasible due to GNIpc truncation)
print("\n" + "="*78); print("(5) FIRST DIFFERENCES - LMC only (full 1976-2015)"); print("="*78)

def make_fd(df):
    d = df.sort_values("Year").copy()
    for v in ["GNIpc","EducExp","PrimEnr","SecEnr","LFpart"]:
        d[f"dl_{v}"] = np.log(d[v].astype(float)).diff()
    d["d_Exports"] = d["Exports"].diff()
    return d

lmc_fd = make_fd(panel[panel["Country Code"] == "LMC"])

# 5a. LMC FD with primary controls
fd_y = "dl_GNIpc"
fd_x = ["dl_EducExp", "dl_PrimEnr", "dl_SecEnr"]
sample = lmc_fd[[fd_y] + fd_x].dropna()
Xfd = sm.add_constant(sample[fd_x].astype(float))
mod_fd = sm.OLS(sample[fd_y], Xfd).fit()
hac_fd = max(1, int(np.floor(sample.shape[0] ** (1/3))))
res_fd = mod_fd.get_robustcov_results(cov_type="HAC", maxlags=hac_fd)
print(f"\n  [LMC FD]   n={sample.shape[0]}, HAC lags={hac_fd}")
pnames_fd = Xfd.columns.tolist()
pp_fd = pd.Series(np.asarray(res_fd.params).ravel(), index=pnames_fd)
se_fd = pd.Series(np.asarray(res_fd.bse).ravel(),    index=pnames_fd)
for nm in pnames_fd:
    print(f"  {nm:<22s}  {pp_fd[nm]:+.5f}    ({se_fd[nm]:.5f})")
print(f"  R^2 (OLS) : {res_fd.rsquared:.3f}")
b_fdE = float(pp_fd["dl_EducExp"])
print(f"  >>> FD elasticity log(GNIpc) w.r.t. log(EducExp) = {b_fdE:+.4f}")

# 5b. LMC FD with Exports too
print("\n  [LMC FD + d Exports growth] ---")
fd_x2 = ["dl_EducExp", "dl_PrimEnr", "dl_SecEnr", "d_Exports"]
sample2 = lmc_fd[[fd_y] + fd_x2].dropna()
Xfd2 = sm.add_constant(sample2[fd_x2].astype(float))
mod_fd2 = sm.OLS(sample2[fd_y], Xfd2).fit()
hac_fd2 = max(1, int(np.floor(sample2.shape[0] ** (1/3))))
res_fd2 = mod_fd2.get_robustcov_results(cov_type="HAC", maxlags=hac_fd2)
print(f"  n={sample2.shape[0]}, HAC lags={hac_fd2}")
pnames_fd2 = Xfd2.columns.tolist()
pp_fd2 = pd.Series(np.asarray(res_fd2.params).ravel(), index=pnames_fd2)
se_fd2 = pd.Series(np.asarray(res_fd2.bse).ravel(),    index=pnames_fd2)
for nm in pnames_fd2:
    print(f"  {nm:<22s}  {pp_fd2[nm]:+.5f}    ({se_fd2[nm]:.5f})")
print(f"  R^2 (OLS) : {res_fd2.rsquared:.3f}")
b_fdE2 = float(pp_fd2["dl_EducExp"])
print(f"  >>> FD elasticity (+ Exports growth) = {b_fdE2:+.4f}")

# 5c. SSA FD infeasible - report raw data
ssf_fd = make_fd(panel[panel["Country Code"] == "SSF"])
ssa_fd_sub = ssf_fd[(ssf_fd.Year >= 2011)].copy()
print("\n  SSA FD (only differences 2011-2015 available - 4 obs max, exploratory):")
print("  Raw first differences:")
cols = ["Year","dl_GNIpc","dl_EducExp","dl_PrimEnr","dl_SecEnr"]
print(ssf_fd[(ssf_fd.Year >= 2011)][cols].to_string(index=False))
n_ssa_fd = ssf_fd[(ssf_fd.Year >= 2011)][["dl_GNIpc","dl_EducExp"]].dropna().shape[0]
print(f"  Usable SSA FD obs (with both Δlog GNIpc and Δlog EducExp): {n_ssa_fd}")
print("  -> SSA FD regression is NOT estimated (n < 5 against 2-3 parameters is degenerate).")

# 6. Synthesis: signed elasticity of GNIpc w.r.t. EducExp per group
print("\n" + "="*78); print("(6) SYNTHESIS"); print("="*78)

print("\n  LMC estimates of elasticity log(GNIpc) ~ log(EducExp):")
print(f"     3a  LMC levels 1975-2015              : beta = {out_lmc['beta_E']:+.4f}")
print(f"     3a' LMC levels + Exports 1975-2015    : beta = {out_lmc2['beta_E']:+.4f}")
print(f"     3b  LMC levels 1975-2007 (pre-GFC)    : beta = {out_lmc_pre['beta_E']:+.4f}")
print(f"     5a  LMC first differences 1976-2015   : beta = {b_fdE:+.4f}")
print(f"     5b  LMC FD + d Exports                : beta = {b_fdE2:+.4f}")

print("\n  SSA estimates (window only 2010-2015, T={0}):".format(out_ssa['data'].shape[0] if out_ssa is not None else 0))
if out_ssa is not None:
    print(f"     3c  SSA bivariate 2010-2015          : beta = {out_ssa['beta_E']:+.4f}    (T=5, exploratory)")
if out_ssa2 is not None:
    print(f"     3c' SSA + PrimEnr 2010-2015          : beta = {out_ssa2['beta_E']:+.4f}    (T=5, exploratory)")

print("\n  Pooled-panel estimates (window 2010-2015, N*T=10):")
print(f"     4   Pooled: lnEducExp (LMC ref)       : b_int   = {b_int:+.4f}")
print(f"     4   Pooled: D_SSA x lnEducExp         : b_diff  = {b_diff:+.4f}")
print(f"     4   Pooled: implied SSA total el.     : {b_int+b_diff:+.4f}")
print(f"     4b  Pooled simplified (no Exports/trend): b_int2 = {b_int2:+.4f}, "
      f"b_diff2 = {b_diff2:+.4f}, SSA total = {b_int2+b_diff2:+.4f}")

# Sign classification
def sign(x): return "positive" if x > 0 else ("negative" if x < 0 else "zero")
lmc_sign = sign(out_lmc['beta_E'])
ssf_sign = sign(out_ssa['beta_E']) if out_ssa is not None else "?"
diff_sign = sign(b_diff2)

print("\n  Sign summary:")
print(f"     LMC elasticity (full window) : {lmc_sign}")
print(f"     SSA elasticity (2010-2015)   : {ssf_sign}   (T=5)")
print(f"     Pooled interaction term      : {diff_sign}  (implies SSA effect LESS than LMC if positive)")

print("\nDONE.")
