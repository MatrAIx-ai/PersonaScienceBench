"""Headline analysis: pick the domain whose share-of-student-subjects in
originals and replications is closest to (82.4%, 80.9%)."""

import pandas as pd
import numpy as np

CSV = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
df = pd.read_csv(CSV)
TARGET_O, TARGET_R = 82.4, 80.9


def pct_students(g, col):
    n_stu = (g[col] == 'students').sum()
    n_tot = g[col].notna().sum()
    return 100.0 * n_stu / n_tot if n_tot else np.nan, n_stu, n_tot


rows = []
for level, keys in [('discipline', 'discipline'),
                   ('project', 'project'),
                   ('discipline x project', ['discipline', 'project'])]:
    for k, g in df.groupby(keys, dropna=False):
        po, no_stu, no_tot = pct_students(g, 'subjects.o')
        pr, nr_stu, nr_tot = pct_students(g, 'subjects.r')
        rows.append({
            'level': level,
            'domain': k if isinstance(k, str) else ' x '.join(map(str, k)),
            'n_total': len(g),
            'pct_O': po,
            'pct_R': pr,
            'L1_dist_pp': abs(po - TARGET_O) + abs(pr - TARGET_R),
        })

tab = pd.DataFrame(rows).sort_values('L1_dist_pp')
print(tab.to_string(index=False))
tab.to_csv('artifacts/headline_table.csv', index=False)
