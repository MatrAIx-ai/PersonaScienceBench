def draw_text(pixels, text, x, y, scale=2, color=(0,0,0), sx=1.0, sy=1.0, W=0, H=0):
    text = text.upper()
    cur = int(round(x*sx))
    y0 = int(round(y*sy))
    for ch in text:
        g = GLYPHS.get(ch, GLYPHS[' '])
        for r, row in enumerate(g):
            for c, b in enumerate(row):
                if b == '1':
                    for dy in range(scale):
                        for dx in range(scale):
                            ix = cur + c*scale + dx
                            iy = y0 + r*scale + dy
                            if 0 <= ix < W and 0 <= iy < H:
                                pixels[iy][ix] = color
        cur += 6*scale  # 5 wide + 1 spacer

def draw_rect(pixels, x, y, w, h, color, sx=1.0, sy=1.0, W=0, H=0):
    x0 = int(round(x*sx)); y0 = int(round(y*sy))
    x1 = int(round((x+w)*sx)); y1 = int(round((y+h)*sy))
    for iy in range(max(0,y0), min(H, y1)):
        for ix in range(max(0,x0), min(W, x1)):
            pixels[iy][ix] = color

def draw_circle(pixels, cx, cy, r, color, sx=1.0, sy=1.0, W=0, H=0):
    cx_pix = cx*sx; cy_pix = cy*sy
    r_pix = r*sx
    x0 = max(0,int(cx_pix-r_pix)); x1 = min(W,int(cx_pix+r_pix)+1)
    y0 = max(0,int(cy_pix-r_pix)); y1 = min(H,int(cy_pix+r_pix)+1)
    for iy in range(y0, y1):
        for ix in range(x0, x1):
            if (ix-cx_pix)**2 + (iy-cy_pix)**2 <= r_pix**2:
                pixels[iy][ix] = color

def draw_circle_outline(pixels, cx, cy, r, color, sx=1.0, sy=1.0, W=0, H=0, thickness=1):
    cx_pix = cx*sx; cy_pix = cy*sy
    r_pix = r*sx
    x0 = max(0,int(cx_pix-r_pix-thickness)); x1 = min(W,int(cx_pix+r_pix+thickness)+1)
    y0 = max(0,int(cy_pix-r_pix-thickness)); y1 = min(H,int(cy_pix+r_pix+thickness)+1)
    for iy in range(y0, y1):
        for ix in range(x0, x1):
            d2 = (ix-cx_pix)**2 + (iy-cy_pix)**2
            if (r_pix-thickness)**2 <= d2 <= r_pix**2:
                pixels[iy][ix] = color
