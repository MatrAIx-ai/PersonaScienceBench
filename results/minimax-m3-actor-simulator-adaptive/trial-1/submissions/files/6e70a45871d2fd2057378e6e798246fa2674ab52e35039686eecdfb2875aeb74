"""Minimal stdlib-only PNG writer (no matplotlib, no pillow, no PIL)."""
import struct, zlib

def _chunk(tag, data):
    crc = zlib.crc32(tag + data) & 0xffffffff
    return struct.pack(">I", len(data)) + tag + data + struct.pack(">I", crc)

def png_from_rgb_array(pixels, out_path):
    """pixels: list of rows, each a list of (r,g,b) tuples in 0-255."""
    h = len(pixels); w = len(pixels[0])
    raw = bytearray()
    for row in pixels:
        raw.append(0)  # filter byte: None
        for r, g, b in row:
            raw.append(int(r)); raw.append(int(g)); raw.append(int(b))
    sig = b"\x89PNG\r\n\x1a\n"
    ihdr = struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0)  # color type 2 = RGB
    idat = zlib.compress(bytes(raw), 9)
    with open(out_path, "wb") as f:
        f.write(sig)
        f.write(_chunk(b"IHDR", ihdr))
        f.write(_chunk(b"IDAT", idat))
        f.write(_chunk(b"IEND", b""))
    return out_path

def render_svg_via_pixels(svg_path, out_png_path, target_width=900, target_height=540):
    """Open the saved SVG, parse primitives, and rasterize them into a coarse RGB array.

    For visual-equivalent fidelity this implementation handles only lines and circles and
    text rectangles; it is a *placeholder* PNG representing the SVG content.
    """
    import re
    svg = open(svg_path).read()
    # Parse viewBox
    m = re.search(r'viewBox="0 0 (\d+(?:\.\d+)?) (\d+(?:\.\d+)?)"', svg)
    vw = float(m.group(1)) if m else 900
    vh = float(m.group(2)) if m else 540
    sx = target_width / vw
    sy = target_height / vh
    W = target_width; H = target_height

    pixels = [[(255,255,255) for _ in range(W)] for _ in range(H)]

    def put(x, y, color):
        ix = int(round(x*sx)); iy = int(round(y*sy))
        if 0 <= ix < W and 0 <= iy < H:
            pixels[iy][ix] = color

    def line(x1,y1,x2,y2,color,width=1):
        # Bresenham-ish with width
        steps = int(max(abs(x2-x1), abs(y2-y1), 1))*2
        for s in range(steps+1):
            t = s/steps
            put(x1*(1-t)+x2*t, y1*(1-t)+y2*t, color)

    def polyline_points(pts_str, color, width=2):
        nums = list(map(float, re.findall(r"-?\d+(?:\.\d+)?", pts_str)))
        pts = [(nums[i], nums[i+1]) for i in range(0, len(nums), 2)]
        for i in range(len(pts)-1):
            line(pts[i][0], pts[i][1], pts[i+1][0], pts[i+1][1], color, width)

    def fill_polygon(pts_str, color):
        nums = list(map(float, re.findall(r"-?\d+(?:\.\d+)?", pts_str)))
        pts = [(nums[i], nums[i+1]) for i in range(0, len(nums), 2)]
        # Rasterize via scanline fill
        if not pts: return
        miny = max(0, int(min(p[1] for p in pts)*sy))
        maxy = min(H-1, int(max(p[1] for p in pts)*sy))
        for y in range(miny, maxy+1):
            inv_y = y/sy
            xs = []
            for i in range(len(pts)):
                x1,y1 = pts[i]; x2,y2 = pts[(i+1)%len(pts)]
                if (y1<=inv_y<y2) or (y2<=inv_y<y1):
                    if y2 != y1:
                        t = (inv_y-y1)/(y2-y1)
                        xs.append(x1*(1-t)+x2*t)
            xs.sort()
            for i in range(0, len(xs)-1, 2):
                xa = max(0, int(xs[i]*sx)); xb = min(W-1, int(xs[i+1]*sx))
                for x in range(xa, xb+1):
                    pixels[y][x] = color

    color_map = {
        "#1f77b4":(31,119,180), "#d62728":(214,39,40), "#2ca02c":(44,160,44),
        "#ff7f0e":(255,127,14), "#000000":(0,0,0), "#888":(136,136,136),
        "#ddd":(221,221,221), "#666":(102,102,102), "#ffffff":(255,255,255),
    }

    for m in re.finditer(r'<line x1="([\d.]+)" y1="([\d.]+)" x2="([\d.]+)" y2="([\d.]+)"\s+stroke="([^"]+)"(?:\s+stroke-width="([\d.]+)")?', svg):
        x1,y1,x2,y2,col,w = m.groups()
        line(float(x1),float(y1),float(x2),float(y2), color_map.get(col,(0,0,0)),
             int(float(w) if w else 1))
    for m in re.finditer(r'<polyline points="([^"]+)"\s+fill="none"\s+stroke="([^"]+)"(?:\s+stroke-width="([\d.]+)")?(?:\s+stroke-dasharray="[^"]*")?', svg):
        pts,col,w = m.groups()
        polyline_points(pts, color_map.get(col,(0,0,0)), int(float(w) if w else 2))
    for m in re.finditer(r'<polygon points="([^"]+)"\s+fill="([^"]+)"', svg):
        pts,col = m.groups()
        fill_polygon(pts, color_map.get(col,(200,200,200)))
    # Background
    pixels = [[(255,255,255) for _ in range(W)] for _ in range(H)]
    # Re-render primitives on top of fresh background
    for m in re.finditer(r'<line x1="([\d.]+)" y1="([\d.]+)" x2="([\d.]+)" y2="([\d.]+)"\s+stroke="([^"]+)"(?:\s+stroke-width="([\d.]+)")?', svg):
        x1,y1,x2,y2,col,w = m.groups()
        line(float(x1),float(y1),float(x2),float(y2), color_map.get(col,(0,0,0)),
             int(float(w) if w else 1))
    for m in re.finditer(r'<polyline points="([^"]+)"\s+fill="none"\s+stroke="([^"]+)"(?:\s+stroke-width="([\d.]+)")?(?:\s+stroke-dasharray="[^"]*")?', svg):
        pts,col,w = m.groups()
        polyline_points(pts, color_map.get(col,(0,0,0)), int(float(w) if w else 2))
    for m in re.finditer(r'<polygon points="([^"]+)"\s+fill="([^"]+)" fill-opacity="([\d.]+)"', svg):
        pts,col,opacity = m.groups()
        r,g,b = color_map.get(col,(200,200,200))
        # Blend with white according to opacity
        a = float(opacity); r = int(r*a + 255*(1-a)); g = int(g*a + 255*(1-a)); b = int(b*a + 255*(1-a))
        fill_polygon(pts, (r,g,b))



    # Render text labels (centered)
    for m in re.finditer(r'<text x="([\d.]+)" y="([\d.]+)"[^>]*text-anchor="middle"[^>]*>([^<]+)</text>', svg):
        x,y,tx = m.groups()
        # Approximate text length: 6*scale*len(tx)
        tw = 6*2*len(tx)
        draw_text(pixels, tx, float(x)-tw/2, float(y)-10, scale=2, color=(0,0,0),
                  sx=sx*2.5, sy=sy*2.5, W=W, H=H)
    for m in re.finditer(r'<text x="([\d.]+)" y="([\d.]+)"[^>]*>([^<]+)</text>', svg):
        x,y,tx = m.groups()
        if 'transform' not in svg[max(0,m.start()-200):m.start()]:
            draw_text(pixels, tx, float(x), float(y)-7, scale=2, color=(0,0,0),
                      sx=sx*2.5, sy=sy*2.5, W=W, H=H)
    # Render circles (filled and outline)
    for m in re.finditer(r'<circle cx="([\d.]+)" cy="([\d.]+)" r="([\d.]+)" fill="(white|#[fF]{6})" stroke="([^"]+)"', svg):
        cx,cy,r,fill,stroke = m.groups()
        draw_circle_outline(pixels, float(cx), float(cy), float(r),
                            color=color_map.get(stroke,(0,0,0)),
                            sx=sx, sy=sy, W=W, H=H, thickness=2)
    for m in re.finditer(r'<circle cx="([\d.]+)" cy="([\d.]+)" r="([\d.]+)" fill="([^"]+)"', svg):
        cx,cy,r,fill = m.groups()
        if fill.lower()=="white": continue
        draw_circle(pixels, float(cx), float(cy), float(r),
                    color=color_map.get(fill,(0,0,0)), sx=sx, sy=sy, W=W, H=H)
    for m in re.finditer(r'<rect x="([\d.]+)" y="([\d.]+)" width="([\d.]+)" height="([\d.]+)" fill="white" stroke="([^"]+)"', svg):
        x,y,w,h,stroke = m.groups()
        # draw rectangle outline (4 lines)
        x0,y0,w0,h0 = float(x),float(y),float(w),float(h)
        for t in range(2):
            line(x0,y0+t,x0+w0,y0+t, color_map.get(stroke,(0,0,0)))
            line(x0,y0+h0-t,x0+w0,y0+h0-t, color_map.get(stroke,(0,0,0)))
        for t in range(2):
            line(x0+t,y0,x0+t,y0+h0, color_map.get(stroke,(0,0,0)))
            line(x0+w0-t,y0,x0+w0-t,y0+h0, color_map.get(stroke,(0,0,0)))

    return png_from_rgb_array(pixels, out_png_path)

