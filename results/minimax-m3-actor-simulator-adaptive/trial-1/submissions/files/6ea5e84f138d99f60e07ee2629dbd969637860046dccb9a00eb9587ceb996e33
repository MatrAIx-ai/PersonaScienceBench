"""Inspection of nls_ses_processed.csv for the BA-completion race-coefficient question."""
import pandas as pd, numpy as np

df = pd.read_csv('/workspace/data/nls_ses_processed.csv')

print("== Shape ==")
print(df.shape)

print("\n== Columns / dtypes ==")
for c in df.columns:
    print(f"  {c!r:50s}  dtype={df[c].dtype}")

print("\n== Missingness (no NaNs expected) ==")
print(df.isna().sum())

print("\n== Duplicate CASE IDs ==")
print("  count =", df['CASE ID'].duplicated().sum())

print("\n== SAMPLE_RACE distribution ==")
print(df['SAMPLE_RACE'].value_counts())

print("\n== BA DEGREE COMPLETED distribution & overall rate ==")
vc = df['BA DEGREE COMPLETED'].value_counts()
print(vc)
print("  Overall rate =", df['BA DEGREE COMPLETED'].mean())

print("\n== BA-completion rate by SAMPLE_RACE (raw 2x2) ==")
ct = pd.crosstab(df['SAMPLE_RACE'], df['BA DEGREE COMPLETED'], margins=True)
print(ct)
print(df.groupby('SAMPLE_RACE')['BA DEGREE COMPLETED'].agg(['count','sum','mean']))

print("\n== Pairwise unadjusted log-OR (race-only logistic) ==")
import statsmodels.api as sm
out = []
from itertools import permutations
for a, b in permutations(['White','Black','Hispanic'], 2):
    sub = df[df.SAMPLE_RACE.isin([a, b])].copy()
    D = (sub.SAMPLE_RACE == b).astype(int).values
    X = sm.add_constant(D)
    m = sm.Logit(sub['BA DEGREE COMPLETED'].astype(int).values, X).fit(disp=0)
    out.append((a, b, m.params[1]))
print(f"  {'reference':10s} {'other':10s} {'logOR':>10s}")
for a, b, l in out:
    print(f"  {a:10s} {b:10s} {l:>+10.5f}")
