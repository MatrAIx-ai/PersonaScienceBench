"""
================================================================================
BA-completion by race × SES in NLSY79 — unified executed analysis
================================================================================
Question: How is the advantage in BA degree-completion rates for Black students
          related to Socioeconomic status levels?

Dataset: data/nls_raw.csv (NLSY79 extract, 12,686 rows, schema in datasets.json).

Pipeline:
  S1. Load + sentinel handling (Highest-grade-1979 sentinel 95.0 -> NaN)
  S2. Construct BA proxy: ba = (Highest-grade-1979 >= 16)
  S3. Build SES components on 1985 vintage: log1p+win+z(net_wealth_1985),
      log1p+win+z(family_income_1985), z(avg mother + father grade).
  S4. Form row-mean SES z-score; tertiles (race-neutral, sample-wide).
  S5. Descriptive rate table: race × SES tier × sex; Fisher's exact per tier;
      Cochran-Mantel-Haenszel stratified by tier.
  S6. Penalized logistic regression (L2=1.0):
        ba ~ race(NBNH BL HS) * ses_tier(1 2 3) + sex + age1979_z
      with Wald joint-interaction test.
  S7. Sensitivities:
        S7a. Restrict to age >= 21 in 1979.
        S7b. Replace wealth_1985 with wealth_1990 (winsorized at 1/99 pct).
        S7c. Replace wealth_1985 with wealth_1996.
        S7d. Available-case with within-(race × sex) median imputation.
  S8. Save all result tables and textual summaries to artifacts.analysis/.
"""
import os, json, numpy as np, pandas as pd
from scipy import stats, optimize, special
import warnings; warnings.filterwarnings("ignore")

OUT = os.path.join(os.path.dirname(os.path.abspath(__file__)))
pd.set_option("display.width", 220); pd.set_option("display.max_columns", 80)
race_levels = ["BLACK", "HISPANIC", "NON-BLACK NON-HISPANIC"]
tier_labels = {1: "Low SES", 2: "Mid SES", 3: "High SES"}

# ============================================================
# S1. Load raw data
# ============================================================
df = pd.read_csv(os.path.normpath(os.path.join(OUT, "..", "data", "nls_raw.csv")), low_memory=False)
df["race_lbl"] = df["Racial/ethnic cohort, 1979"].map(
    {1:"BLACK", 2:"HISPANIC", 3:"NON-BLACK NON-HISPANIC"})

col_grade="Highest grade completed, 1979"
col_mg   ="Highest grade completed by respondent's mother, 1979"
col_fg   ="Highest grade completed by respondent's father, 1979"
col_w85  ="Family net wealth, 1985"
col_w90  ="Family net wealth, 1990"
col_w96  ="Family net wealth, 1996 (key data point)"
col_i85  ="Total net family income, previous calendar year, 1985"
col_age  ="Age of respondent, 1979"
col_sex  ="Sex of respondent, 1979"

# ============================================================
# S2. BA proxy (sentinel 95 -> missing)
# ============================================================
df.loc[df[col_grade]==95.0, col_grade]=np.nan
df["ba"]      = (df[col_grade]>=16).astype(float)
df.loc[df[col_grade].isna(),"ba"]=np.nan
df["age1979"] = df[col_age]

def winsorize(s, p_lo=0.01, p_hi=0.99):
    s = s.copy()
    if s.notna().any(): s = s.clip(lower=s.quantile(p_lo), upper=s.quantile(p_hi))
    return s
def zscore(s):
    s = s.astype(float); m, sd = s.mean(skipna=True), s.std(skipna=True)
    return (s-m)/sd if (sd and sd>0) else s*0
def assign_tert(s):
    sub_ = s.dropna(); q = sub_.quantile([1/3,2/3]).values
    out = pd.Series(np.nan, index=s.index)
    out[s<=q[0]] = 1; out[(s>q[0])&(s<=q[1])] = 2; out[s>q[1]] = 3
    return out
def build_ses(df_, wave):
    wcol = {"85":col_w85, "90":col_w90, "96":col_w96}[wave]
    wlog = np.log1p(df_[wcol] - df_[wcol].min() + 1)
    wlog = winsorize(wlog); zw = zscore(wlog)
    ilog = np.log1p(df_[col_i85].clip(lower=0))
    ilog = winsorize(ilog); zi = zscore(ilog)
    par = df_[[col_mg, col_fg]].mean(axis=1, skipna=True)
    par.loc[df_[[col_mg, col_fg]].isna().all(axis=1)] = np.nan
    zp = zscore(par)
    df_["z_logW"] = zw; df_["z_logI"] = zi; df_["z_par"] = zp
    return df_[["z_logW","z_logI","z_par"]].mean(axis=1, skipna=True)

def fit_pen_logit(X, y, l2=1.0):
    """Penalised (ridge-style) logit via L-BFGS-B with intercept unpenalised."""
    n,p = X.shape
    def nll(b):
        z = X @ b
        ll = np.sum(y*(-special.log1p(np.exp(-z))) + (1-y)*(-special.log1p(np.exp(z))))
        return -ll + l2*(b[1:]**2).sum()
    def grad(b):
        p_ = special.expit(zb := X @ b)
        g = -(X.T @ (y - p_))
        g[1:] += 2*l2*b[1:]
        return g
    res = optimize.minimize(nll, np.zeros(p), jac=grad, method="L-BFGS-B",
                            options={"maxiter":500, "ftol":1e-9})
    b = res.x
    H = np.zeros((p,p)); eps = 1e-5
    for i in range(p):
        for j in range(i, p):
            bp=b.copy(); bp[i]+=eps; bp[j]+=eps
            bm=b.copy(); bm[i]-=eps; bm[j]-=eps
            bpm=b.copy(); bpm[i]+=eps; bpm[j]-=eps
            bmp=b.copy(); bmp[i]-=eps; bmp[j]+=eps
            H[i,j]=H[j,i]=(nll(bp)+nll(bm)-nll(bpm)-nll(bmp))/(4*eps*eps)
    try:
        cov = np.linalg.inv(H); se = np.sqrt(np.clip(np.diag(cov), 0, None))
    except np.linalg.LinAlgError:
        cov = None; se = np.full(p, np.nan)
    zw = b/se; pw = 2*(1-stats.norm.cdf(np.abs(zw)))
    return b, se, zw, pw, cov, res.success

def pen_logit_race_ses_tier(sub_, label, fname):
    """Fit the primary specification: ba ~ race(3) * ses_tier(3) + sex + age1979_z"""
    cols = ["BLACK","HISP","T2","T3","BL_T2","BL_T3","HS_T2","HS_T3","FEMALE","age1979_z"]
    md = sub_.copy()
    md["ses_tier"] = assign_tert(md["SES"]).values
    md = md.dropna(subset=["ba","race_lbl","ses_tier",col_sex,col_age,"SES"]).copy()
    md["BLACK"]  = (md["race_lbl"]=="BLACK").astype(float)
    md["HISP"]   = (md["race_lbl"]=="HISPANIC").astype(float)
    md["T2"]     = (md["ses_tier"]==2).astype(float)
    md["T3"]     = (md["ses_tier"]==3).astype(float)
    md["BL_T2"]  = md["BLACK"]*md["T2"]
    md["BL_T3"]  = md["BLACK"]*md["T3"]
    md["HS_T2"]  = md["HISP"]*md["T2"]
    md["HS_T3"]  = md["HISP"]*md["T3"]
    md["FEMALE"] = (md[col_sex]==2).astype(float)
    mu = float(md[col_age].mean()); sd = float(md[col_age].std())
    md["age1979_z"] = (md[col_age]-mu)/sd
    X = np.column_stack([np.ones(len(md))] + [md[c].values for c in cols])
    y = md["ba"].values.astype(int)
    b, se, zw, pw, cov, ok = fit_pen_logit(X, y, l2=1.0)
    with open(os.path.normpath(os.path.join(OUT, fname)), "w") as f:
        f.write(f"Penalized logit ({label}, L2=1.0): n={len(md)}, BA events={int(y.sum())}\n\n")
        f.write(f"{'Variable':18s} {'beta':>8s} {'SE':>8s} {'z':>8s} {'p':>8s} {'OR':>8s}\n")
        for c,v,s,z,p in zip(["intercept"]+cols,b,se,zw,pw):
            f.write(f"{c:18s} {v:>8.4f} {s:>8.4f} {z:>8.4f} {p:>8.4f} {np.exp(v):>8.4f}\n")
        # Wald joint interaction
        inter_idx = [i for i,c in enumerate(["intercept"]+cols) if "_T2" in c or "_T3" in c]
        R = np.zeros((len(inter_idx), len(b)))
        for ii,i in enumerate(inter_idx): R[ii,i]=1
        if cov is not None:
            wstat = R @ b
            wcov = R @ cov @ R.T
            chi2 = float(wstat @ np.linalg.inv(wcov) @ wstat)
            chi_p = 1 - stats.chi2.cdf(chi2, df=len(inter_idx))
            f.write(f"\nWald joint race x ses interaction chi2({len(inter_idx)}) = {chi2:.4f}, p = {chi_p:.4f}\n")
    # Marginal
    marg = []
    for t in [1,2,3]:
        row={}
        for rc in race_levels:
            ps=[]
            for sx in [1,2]:
                rdk = {k:0 for k in cols}
                if rc=="BLACK": rdk["BLACK"]=1
                if rc=="HISPANIC": rdk["HISP"]=1
                if t==2: rdk["T2"]=1
                if t==3: rdk["T3"]=1
                rdk["BL_T2"]=rdk["BLACK"]*rdk["T2"]
                rdk["BL_T3"]=rdk["BLACK"]*rdk["T3"]
                rdk["HS_T2"]=rdk["HISP"]*rdk["T2"]
                rdk["HS_T3"]=rdk["HISP"]*rdk["T3"]
                rdk["FEMALE"]=1 if sx==2 else 0
                rdk["age1979_z"]=0
                v = np.array([1]+[rdk[c] for c in cols])
                ps.append(float(special.expit(v @ b)))
            row[rc] = float(np.mean(ps))
        row["tier"]=t
        nbnh = row["NON-BLACK NON-HISPANIC"]
        if 0 < nbnh < 1:
            row["OR(BL/NBNH)"] = (row["BLACK"]/(1-row["BLACK"]))/(nbnh/(1-nbnh))
            row["OR(HS/NBNH)"] = (row["HISPANIC"]/(1-row["HISPANIC"]))/(nbnh/(1-nbnh))
        else:
            row["OR(BL/NBNH)"] = np.nan; row["OR(HS/NBNH)"] = np.nan
        marg.append(row)
    return len(md), int(y.sum()), marg, ok

def ses_table(sub_, fname):
    sub = sub_.dropna(subset=["SES","ba"]).copy()
    sub["ses_tier"] = assign_tert(sub["SES"]).values
    rows=[]
    for r in race_levels:
        for t in [1,2,3]:
            m = (sub["race_lbl"]==r) & (sub["ses_tier"]==t)
            n = int(m.sum()); e = int(sub.loc[m,"ba"].sum())
            rate = e/n if n>0 else np.nan
            rows.append({"race":r,"ses_tier":tier_labels[t],"n":n,"ba_events":e,"ba_rate":rate})
    tab = pd.DataFrame(rows)
    tab.to_csv(os.path.normpath(os.path.join(OUT, fname)), index=False)
    return tab

# ============================================================
# S3-S4. Primary SES build + sample
# ============================================================
df["SES"] = build_ses(df, "85")
sub = df.dropna(subset=["SES","ba"]).copy()
sub["ses_tier"] = assign_tert(sub["SES"]).values
n_primary = len(sub); e_primary = int(sub["ba"].sum())
print("="*72)
print("PRIMARY ANALYSIS")
print("="*72)
print(f"n={n_primary:,}, BA events={e_primary} ({e_primary/n_primary*100:.3f}%)")
print(f"SES tertile cut-points: q1/3={sub['SES'].quantile(1/3):.4f}, "
      f"q2/3={sub['SES'].quantile(2/3):.4f}")

# ============================================================
# S5. Descriptive table + Fisher + CMH
# ============================================================
tab_primary = ses_table(sub, "ba_rates_primary.csv")
print("\nBA rates by race × SES tier:")
print(tab_primary.to_string(index=False))

# Race-stratified Black-vs-NBNH gap
gaps = []
for t in [1,2,3]:
    bl = sub[(sub["race_lbl"]=="BLACK") & (sub["ses_tier"]==t)]
    nw = sub[(sub["race_lbl"]=="NON-BLACK NON-HISPANIC") & (sub["ses_tier"]==t)]
    bl_r = bl["ba"].mean() if len(bl)>0 else np.nan
    nw_r = nw["ba"].mean() if len(nw)>0 else np.nan
    gaps.append({"ses_tier":tier_labels[t], "BLACK_rate":bl_r, "NBNH_rate":nw_r,
                 "BL_minus_NBNH_pct_pts":(bl_r-nw_r)*100})
gaps_df = pd.DataFrame(gaps); gaps_df.to_csv(os.path.join(OUT,"ba_gap_primary.csv"),index=False)

# Fisher's exact per tier (BL vs NBNH)
fisher_res=[]
for t in [1,2,3]:
    bl_l = sub[(sub["race_lbl"]=="BLACK") & (sub["ses_tier"]==t)]
    nb_l = sub[(sub["race_lbl"]=="NON-BLACK NON-HISPANIC") & (sub["ses_tier"]==t)]
    e1=int(bl_l["ba"].sum()); n1=len(bl_l); e2=int(nb_l["ba"].sum()); n2=len(nb_l)
    odds, p = stats.fisher_exact([[e1,max(n1-e1,0)],[e2,max(n2-e2,0)]], alternative="two-sided")
    fisher_res.append({"tier":t,"BL_e":e1,"BL_n":n1,"NBNH_e":e2,"NBNH_n":n2,
                       "BL_rate":e1/n1,"NBNH_rate":e2/n2,"odds_ratio":odds,"p_two_sided":p})
fish_df = pd.DataFrame(fisher_res); fish_df.to_csv(os.path.join(OUT,"fisher_by_tier.csv"),index=False)
print("\nFisher's exact test (BL vs NBNH, 2-sided) per SES tier:")
print(fish_df.to_string(index=False))

# CMH stratified by tier (BLACK vs NBNH)
sub_b2 = sub[sub["race_lbl"].isin(["BLACK","NON-BLACK NON-HISPANIC"])].copy()
a = np.array([(sub_b2["ses_tier"]==t) & (sub_b2["race_lbl"]=="BLACK") & (sub_b2["ba"]==1) for t in [1,2,3]]).sum(axis=1).astype(float)
b = np.array([(sub_b2["ses_tier"]==t) & (sub_b2["race_lbl"]=="BLACK") & (sub_b2["ba"]==0) for t in [1,2,3]]).sum(axis=1).astype(float)
c = np.array([(sub_b2["ses_tier"]==t) & (sub_b2["race_lbl"]=="NON-BLACK NON-HISPANIC") & (sub_b2["ba"]==1) for t in [1,2,3]]).sum(axis=1).astype(float)
d = np.array([(sub_b2["ses_tier"]==t) & (sub_b2["race_lbl"]=="NON-BLACK NON-HISPANIC") & (sub_b2["ba"]==0) for t in [1,2,3]]).sum(axis=1).astype(float)
N_k = a+b+c+d; R1=a+c; R0=b+d; C1=a+b; C0=c+d
E = (R1*C1/N_k); V = (R1*R0*C1*C0/(N_k**2*(N_k-1)))
mask = np.isfinite(V) & (V>0)
E_sum = E[mask].sum(); V_sum = V[mask].sum()
Z_cmh = (a.sum()-E_sum)/np.sqrt(V_sum); p_cmh = 2*(1-stats.norm.cdf(abs(Z_cmh)))
OR_mh = (a*d/N_k).sum()/((b*c/N_k).sum())
print(f"\nCMH stratified by SES tier (BLACK vs NBNH): Z={Z_cmh:.3f}, p={p_cmh:.4f}; "
      f"MH common OR={OR_mh:.3f}; tier-stratified table a,b,c,d (per tier):")
print(pd.DataFrame({"tier":[1,2,3],"a_BL_BA":a,"b_BL_noBA":b,"c_NB_BA":c,"d_NB_noBA":d}).to_string(index=False))
with open(os.path.join(OUT,"cmh.txt"),"w") as f:
    f.write(f"CMH Z={Z_cmh:.4f}, p={p_cmh:.4f}, MH OR_BLvsNBNH={OR_mh:.4f}\n")

# ============================================================
# S6. Penalised logistic (primary)
# ============================================================
n_, e_, marg_primary, ok_ = pen_logit_race_ses_tier(sub, "primary", "penlogit_primary.txt")
print("\nPenalised logit (primary, l2=1.0):")
print(f"n={n_}, events={e_}, success={ok_}")
margdf = pd.DataFrame(marg_primary); margdf.to_csv(os.path.join(OUT,"pen_marginal.csv"),index=False)
print("\nMarginal predicted P(BA), race x tier:")
for m in marg_primary:
    print(f"  Tier {m['tier']}: NBNH={m['NON-BLACK NON-HISPANIC']:.5f}, BLACK={m['BLACK']:.5f}, HISPANIC={m['HISPANIC']:.5f} | "
          f"OR(BL/NBNH)={m['OR(BL/NBNH)']:.2f}, OR(HS/NBNH)={m['OR(HS/NBNH)']:.2f}")
with open(os.path.join(OUT,"pen_marginal.txt"),"w") as f:
    for m in marg_primary:
        f.write(f"Tier {m['tier']}: NBNH={m['NON-BLACK NON-HISPANIC']:.5f} BLACK={m['BLACK']:.5f} "
                f"HISPANIC={m['HISPANIC']:.5f} OR(BL/NBNH)={m['OR(BL/NBNH)']:.2f}\n")

# ============================================================
# S7. Sensitivities
# ============================================================
print("\n" + "="*72); print("SENSITIVITIES"); print("="*72)
sub_old = df[df["age1979"]>=21].copy(); sub_old["SES"]=build_ses(sub_old,"85")
ses_table(sub_old, "ba_rates_age21.csv")
n_old,e_old,marg_old,ok_old = pen_logit_race_ses_tier(sub_old, "age>=21", "pen_logit_age21.txt")
print(f"  age>=21: n={n_old}, events={e_old}, success={ok_old}")

df2 = df.copy(); df2["SES"]=build_ses(df2,"90")
ses_table(df2.dropna(subset=["SES","ba"]), "ba_rates_wealth90.csv")
n90,e90,marg90,ok90 = pen_logit_race_ses_tier(df2, "wealth=1990", "pen_logit_wealth90.txt")
print(f"  wealth=1990: n={n90}, events={e90}, success={ok90}")

df3 = df.copy(); df3["SES"]=build_ses(df3,"96")
ses_table(df3.dropna(subset=["SES","ba"]), "ba_rates_wealth96.csv")
n96,e96,marg96,ok96 = pen_logit_race_ses_tier(df3, "wealth=1996", "pen_logit_wealth96.txt")
print(f"  wealth=1996: n={n96}, events={e96}, success={ok96}")

dfa = df.copy(); dfa["SES"]=build_ses(dfa,"85")
for c_ in ["z_logW","z_logI","z_par"]:
    med = dfa.groupby(["race_lbl", col_sex])[c_].transform("median")
    dfa[c_] = dfa[c_].fillna(med)
dfa["SES"] = dfa[["z_logW","z_logI","z_par"]].mean(axis=1)
ses_table(dfa.dropna(subset=["SES","ba"]), "ba_rates_available.csv")
nav,eav,margav,okav = pen_logit_race_ses_tier(dfa, "available-case", "pen_logit_available.txt")
print(f"  available-case: n={nav}, events={eav}, success={okav}")

print("\n" + "="*72); print("DONE unified analysis"); print("="*72)
