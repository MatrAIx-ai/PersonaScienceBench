"""
NLS incarceration wealth-gap analysis - per-year cross-sectional.
Headline tests (unadjusted, no covariates):
  - Welch's two-sample t-test (unequal variances, unequal n).
  - Mann-Whitney U (rank-based robustness given extreme skew).
  - Bonferroni correction across the 3 wealth years (alpha = 0.05/3).
Negative wealth values are kept. No imputation / dropping.
"""

import json
from pathlib import Path

import numpy as np
import pandas as pd
from scipy import stats

ROOT = Path(__file__).resolve().parent
DATA_PATH = ROOT / "data" / "nls_incarceration_processed.csv"
RESULTS_PATH = ROOT / "results.json"
TABLE_PATH = ROOT / "results_table.txt"

ALPHA_RAW = 0.05
ALPHA_BONF = 0.05 / 3  # ~0.01667

WEALTH_COLS = ["composite_wealth_1985", "composite_wealth_1990", "composite_wealth_1996"]


def rank_biserial(u: float, n1: int, n2: int) -> float:
    """Effect size for Mann-Whitney U; range [-1, 1]; sign matches diff(mean(g1)-mean(g2))."""
    return 1.0 - (2.0 * u) / (n1 * n2)


def cohens_d(g1: np.ndarray, g2: np.ndarray) -> float:
    """Pooled-SD Cohen's d (group1 vs group2)."""
    n1, n2 = len(g1), len(g2)
    s1, s2 = g1.std(ddof=1), g2.std(ddof=1)
    sp = np.sqrt(((n1 - 1) * s1**2 + (n2 - 1) * s2**2) / (n1 + n2 - 2))
    return (g1.mean() - g2.mean()) / sp if sp > 0 else np.nan


def analyse_year(df: pd.DataFrame, col: str) -> dict:
    g1 = df.loc[df["ever_jailed"] == 1, col].to_numpy()
    g0 = df.loc[df["ever_jailed"] == 0, col].to_numpy()

    welch = stats.ttest_ind(g1, g0, equal_var=False)
    mw = stats.mannwhitneyu(g1, g0, alternative="two-sided")

    return {
        "year_column": col,
        "n_jailed": int(len(g1)),
        "n_not_jailed": int(len(g0)),
        "mean_jailed": float(g1.mean()),
        "mean_not_jailed": float(g0.mean()),
        "median_jailed": float(np.median(g1)),
        "median_not_jailed": float(np.median(g0)),
        "sd_jailed": float(g1.std(ddof=1)),
        "sd_not_jailed": float(g0.std(ddof=1)),
        "mean_diff_jailed_minus_not": float(g1.mean() - g0.mean()),
        "n_negative_jailed": int((g1 < 0).sum()),
        "n_negative_not_jailed": int((g0 < 0).sum()),
        "welch_t": float(welch.statistic),
        "welch_df": float(welch.df),
        "p_welch": float(welch.pvalue),
        "p_welch_bonf": float(min(welch.pvalue * 3, 1.0)),
        "cohens_d": float(cohens_d(g1, g0)),
        "mw_u": float(mw.statistic),
        "p_mw": float(mw.pvalue),
        "p_mw_bonf": float(min(mw.pvalue * 3, 1.0)),
        "rank_biserial": float(rank_biserial(mw.statistic, len(g1), len(g0))),
        "sig_raw_welch": bool(welch.pvalue < ALPHA_RAW),
        "sig_bonf_welch": bool(welch.pvalue < ALPHA_BONF),
        "sig_raw_mw": bool(mw.pvalue < ALPHA_RAW),
        "sig_bonf_mw": bool(mw.pvalue < ALPHA_BONF),
    }


def fmt_money(x: float) -> str:
    return f"${x:,.0f}"


def render_table(rows: list[dict]) -> str:
    headers = [
        "year", "n1", "n0",
        "mean_1", "mean_0", "mean_diff",
        "median_1", "median_0",
        "sd_1", "sd_0",
        "Welch t", "df",
        "p_Welch", "p_Welch_BH",
        "MW U", "p_MW", "p_MW_BH",
        "rank-biserial", "Cohen d",
        "sig_raw", "sig_bonf",
    ]
    out = ["\t".join(headers)]
    for r in rows:
        line = [
            r["year_column"].replace("composite_wealth_", ""),
            str(r["n_jailed"]),
            str(r["n_not_jailed"]),
            fmt_money(r["mean_jailed"]),
            fmt_money(r["mean_not_jailed"]),
            fmt_money(r["mean_diff_jailed_minus_not"]),
            fmt_money(r["median_jailed"]),
            fmt_money(r["median_not_jailed"]),
            fmt_money(r["sd_jailed"]),
            fmt_money(r["sd_not_jailed"]),
            f"{r['welch_t']:.4f}",
            f"{r['welch_df']:.1f}",
            f"{r['p_welch']:.3e}",
            f"{r['p_welch_bonf']:.3e}",
            f"{r['mw_u']:.0f}",
            f"{r['p_mw']:.3e}",
            f"{r['p_mw_bonf']:.3e}",
            f"{r['rank_biserial']:.3f}",
            f"{r['cohens_d']:.3f}",
            str(r["sig_raw_welch"]) + "/" + str(r["sig_raw_mw"]),
            str(r["sig_bonf_welch"]) + "/" + str(r["sig_bonf_mw"]),
        ]
        out.append("\t".join(line))
    return "\n".join(out)


def main() -> None:
    df = pd.read_csv(DATA_PATH)

    # Guard rails / sanity prints.
    sanity = {
        "n_rows": int(len(df)),
        "n_cols": int(df.shape[1]),
        "missing_total": int(df.isna().sum().sum()),
        "ever_jailed_counts": {
            int(k): int(v) for k, v in df["ever_jailed"].value_counts().items()
        },
        "race_unique": sorted(df["race"].unique().tolist()),
        "sex_unique": sorted(df["sex"].unique().tolist()),
    }
    print("SANITY:", json.dumps(sanity, indent=2))

    rows = [analyse_year(df, c) for c in WEALTH_COLS]

    print()
    print("=" * 100)
    print("UNADJUSTED tests, ever_jailed = 1 vs 0; negatives kept; raw alpha = 0.05; Bonferroni alpha = 0.0167")
    print("=" * 100)
    print()
    table = render_table(rows)
    print(table)

    # Persist.
    payload = {
        "alpha_raw": ALPHA_RAW,
        "alpha_bonferroni": ALPHA_BONF,
        "tests_run": ["Welch t-test", "Mann-Whitney U"],
        "covariates": "none (unadjusted, per question wording)",
        "negative_wealth_treatment": "kept (not dropped, not winsorised)",
        "rows": rows,
    }
    RESULTS_PATH.write_text(json.dumps(payload, indent=2))
    TABLE_PATH.write_text(table + "\n")
    print(f"\nWrote {RESULTS_PATH.relative_to(ROOT)} and {TABLE_PATH.relative_to(ROOT)}")


if __name__ == "__main__":
    main()
