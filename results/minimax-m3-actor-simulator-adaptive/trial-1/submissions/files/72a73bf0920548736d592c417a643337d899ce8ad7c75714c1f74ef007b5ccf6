#!/usr/bin/env python
"""
Self-contained analysis: Prevalence of gardening-introduced non-native
plants by habitat type (Catalonia plot-level data).

Reproduces all CSVs in artifacts/. Run from /workspace.

Approach locked in plan-stage:
  STEP 0: Check n.total = n.gard + n.unint + n.agfo (row-wise)
  STEP 1: Per-habitat share_d / dominance_d with B=5000 bootstrap CIs
  STEP 2: Hurdle -- binomial (Logit) presence ~ habitat
                + zero-truncated Poisson count model (manual scipy.optimize)
                + Poisson GLM for stability
  STEP 3: VIF check, PCA collapse (urban,cropland)@2009.500m -> PC1,
                logit-LM with z-scored env predictors + BH-FDR
  STEP 4: ASCII figure-data exports (no matplotlib in env)
  STEP 5: Phylogenetic signal (Mantel-style K, manual Newick parser)
"""
import os, warnings, json, re
import numpy as np
import pandas as pd
import statsmodels.api as sm
import statsmodels.formula.api as smf
from statsmodels.stats.multitest import multipletests
from statsmodels.stats.outliers_influence import variance_inflation_factor
from scipy.special import gammaln
from scipy.optimize import minimize
from scipy.stats import chi2, mannwhitneyu
warnings.filterwarnings("ignore")
os.makedirs("artifacts", exist_ok=True)


def load_and_prep():
    inv = pd.read_csv("data/invaded_niche_pathways.csv", sep="\t")
    inv["row_sum"] = inv[["n.gard", "n.unint", "n.agfo"]].sum(axis=1)
    inv["share_d"] = inv["n.gard"] / inv["n.total"].replace({0: np.nan})
    inv["dominance_d"] = inv["n.gard"] / inv["row_sum"].replace({0: np.nan})
    inv["present_gard"] = (inv["n.gard"] > 0).astype(int)
    succ = pd.read_csv("data/invasion_success_pathways.csv", sep=",")
    return inv, succ


def step0_check(inv):
    diff = inv["n.total"] - inv["row_sum"]
    pct = (diff == 0).mean()
    print(f"STEP 0 n.total == row_sum : {(pct == 1.0)} ({pct * 100:.1f}% rows)")
    return pct == 1.0


def step1_metrics(inv, B=5000):
    rng = np.random.default_rng(123)
    rows = []
    for h in inv["habitat"].unique():
        sub = inv[inv["habitat"] == h]
        prev_arr = sub["present_gard"].values
        n = len(prev_arr)
        pb = np.empty(B)
        for i in range(B):
            pb[i] = rng.choice(prev_arr, n, replace=True).mean()
        sa = sub["share_d"].dropna().values
        sb = np.empty(B) if len(sa) else np.array([])
        for i in range(B):
            sb[i] = rng.choice(sa, len(sa), replace=True).mean()
        rows.append({"habitat": h, "n_plots": n,
                     "n_invaded_plots": int((sub["n.total"] > 0).sum()),
                     "n_gard_present": int(prev_arr.sum()),
                     "prevalence_gard": float(prev_arr.mean()),
                     "prev_CI_lo": float(np.percentile(pb, 2.5)),
                     "prev_CI_hi": float(np.percentile(pb, 97.5)),
                     "share_d_mean": float(sa.mean()) if len(sa) else np.nan,
                     "share_CI_lo": float(np.percentile(sb, 2.5)) if len(sa) else np.nan,
                     "share_CI_hi": float(np.percentile(sb, 97.5)) if len(sa) else np.nan,
                     "sum_gard": int(sub["n.gard"].sum()),
                     "sum_unint": int(sub["n.unint"].sum()),
                     "sum_agfo": int(sub["n.agfo"].sum()),
                     "sum_total": int(sub["n.total"].sum())})
    df = pd.DataFrame(rows)
    df.to_csv("artifacts/01_per_habitat_metrics.csv", index=False)
    return df


def step2_hurdle(inv, REF="Croplands"):
    inv["habitat_cat"] = pd.Categorical(
        inv["habitat"],
        categories=[REF] + sorted([h for h in inv["habitat"].unique() if h != REF]))

    # Binomial
    bm = smf.logit('present_gard ~ C(habitat_cat, Treatment(reference="Croplands"))',
                   data=inv).fit(disp=0)
    rows = []; p = bm.params; bse = bm.bse; pv = bm.pvalues; ci = bm.conf_int()
    for name in p.index:
        if "habitat_cat" not in name: continue
        lab = name.split("T.")[1].rstrip("]").strip("\"")
        rows.append({"habitat": lab, "coef_logit": p[name], "SE": bse[name],
                     "z": p[name] / bse[name], "p_raw": pv[name],
                     "OR": float(np.exp(p[name])),
                     "CIlo_OR": float(np.exp(ci.loc[name, 0])),
                     "CIhi_OR": float(np.exp(ci.loc[name, 1]))})
    df = pd.DataFrame(rows)
    _, qv, _, _ = multipletests(df["p_raw"].values, alpha=0.05, method="fdr_bh")
    df["q_BH"] = qv
    df.sort_values("coef_logit", ascending=False).reset_index(drop=True).to_csv(
        "artifacts/02_hurdle_binomial_coefs.csv", index=False)

    # Poisson GLM as a robust count-side check
    pois = smf.glm('Q("n.gard") ~ C(habitat_cat, Treatment(reference="Croplands"))',
                   data=inv, family=sm.families.Poisson()).fit(cov_type="HC1")
    rows_p = []; pp = pois.params; ps = pois.bse; ppv = pois.pvalues; pci = pois.conf_int()
    for name in pp.index:
        if "habitat_cat" not in name: continue
        lab = name.split("T.")[1].rstrip("]").strip("\"")
        rows_p.append({"habitat": lab, "coef_log_count": pp[name], "SE_HC1": ps[name],
                       "z": pp[name] / ps[name], "p_raw": ppv[name],
                       "IRR": float(np.exp(pp[name])),
                       "CIlo_IRR": float(np.exp(pci.loc[name, 0])),
                       "CIhi_IRR": float(np.exp(pci.loc[name, 1]))})
    pdf = pd.DataFrame(rows_p)
    _, qv2, _, _ = multipletests(pdf["p_raw"].values, alpha=0.05, method="fdr_bh")
    pdf["q_BH"] = qv2
    pdf.sort_values("coef_log_count", ascending=False).reset_index(drop=True).to_csv(
        "artifacts/02_poisson_habitat_coefs.csv", index=False)

    # Zero-truncated Poisson count (manual, scipy) -- conditional on n.gard > 0
    sub_pos = inv[inv["n.gard"] > 0].copy()
    sub_pos["habitat_cat"] = pd.Categorical(
        sub_pos["habitat"],
        categories=[REF] + sorted([h for h in sub_pos["habitat"].unique() if h != REF]))

    def trunc_pois_logpmf(y, mu):
        return (-mu + y * np.log(mu + 1e-300) - gammaln(y + 1)
                - np.log1p(-np.exp(-mu + 1e-300)))

    dummies = pd.get_dummies(sub_pos["habitat_cat"], prefix="hab")
    design_cols = [c for c in dummies.columns if c != f"hab_{REF}"]
    X = np.column_stack([np.ones(len(sub_pos)), dummies[design_cols].values.astype(float)])
    y = sub_pos["n.gard"].values
    p = X.shape[1]

    def neg_ll(theta):
        mu = np.exp(np.clip(X @ theta, -20, 20))
        return -trunc_pois_logpmf(y, mu).sum()

    res = minimize(neg_ll, np.zeros(p), method="BFGS",
                   options={"maxiter": 1000, "gtol": 1e-7})
    eps = 1e-5; H = np.zeros((p, p))
    for i in range(p):
        for j in range(i, p):
            xpp = res.x.copy(); xpp[i] += eps; xpp[j] += eps
            xpm = res.x.copy(); xpm[i] += eps; xpm[j] -= eps
            xmp = res.x.copy(); xmp[i] -= eps; xmp[j] += eps
            xmm = res.x.copy(); xmm[i] -= eps; xmm[j] -= eps
            H[i, j] = H[j, i] = (neg_ll(xpp) - neg_ll(xpm)
                                  - neg_ll(xmp) + neg_ll(xmm)) / (4 * eps * eps)
    try:
        se = np.sqrt(np.diag(np.linalg.inv(H)))
    except np.linalg.LinAlgError:
        se = np.full(p, np.nan)
    ztp_rows = []
    for nm, b, se_i in zip(["Intercept"] + design_cols, res.x, se):
        if nm == "Intercept": continue
        z = b / se_i if (np.isfinite(se_i) and se_i > 0) else np.nan
        pval = 2 * (1 - chi2.cdf(z * z, 1)) if np.isfinite(z) else np.nan
        ztp_rows.append({"habitat": nm.replace("hab_", ""),
                         "coef_log_count": b, "SE": se_i, "z": z, "p_raw": pval})
    ztp_df = pd.DataFrame(ztp_rows)
    mask = ztp_df["p_raw"].notna().values
    if mask.any():
        _, qv3, _, _ = multipletests(ztp_df.loc[mask, "p_raw"].values,
                                     alpha=0.05, method="fdr_bh")
        ztp_df.loc[mask, "q_BH"] = qv3
    ztp_df.sort_values("coef_log_count", ascending=False).reset_index(drop=True).to_csv(
        "artifacts/02_ztp_habitat_coefs.csv", index=False)

    return df, pdf, ztp_df




def step3_env(inv):
    env_cols = ["elevation", "urban.2009.500m", "cropland.2009.500m",
                "annual.temperature", "annual.rainfall",
                "distance.road", "distance.stream"]
    Xenv = inv[env_cols].copy()

    # VIF on raw full set
    Xzc = sm.add_constant((Xenv - Xenv.mean()) / Xenv.std(ddof=0))
    vif_rows = []
    for i, c in enumerate(env_cols):
        vif_rows.append({"predictor": c, "VIF": variance_inflation_factor(Xzc.values, i + 1)})
    pd.DataFrame(vif_rows).to_csv("artifacts/03_vif_env_predictors_raw.csv", index=False)

    # PCA collapse for urban/cropland per protocol
    pair = inv[["urban.2009.500m", "cropland.2009.500m"]].values
    pc = (pair - pair.mean(axis=0))
    C = np.cov(pc, rowvar=False)
    w, v = np.linalg.eigh(C)
    pc1 = v[:, -1]
    if pc1[0] < 0: pc1 = -pc1
    inv["PC1_urban_cropland"] = pc @ pc1

    env_cols_post = ["elevation", "PC1_urban_cropland", "annual.temperature",
                     "annual.rainfall", "distance.road", "distance.stream"]
    X2 = inv[env_cols_post].copy()
    X2z = (X2 - X2.mean()) / X2.std(ddof=0)
    X2zc = sm.add_constant(X2z)
    vif_rows2 = []
    for i, c in enumerate(env_cols_post):
        vif_rows2.append({"predictor": c, "VIF": variance_inflation_factor(X2zc.values, i + 1)})
    pd.DataFrame(vif_rows2).to_csv("artifacts/03_vif_env_predictors_post.csv", index=False)

    # Logit-LM on z-scored env predictors
    y = inv["present_gard"].values
    fit = sm.Logit(y, X2zc.values).fit(disp=0)
    ci = fit.conf_int()
    rows = []
    for i, c in enumerate(env_cols_post):
        rows.append({"predictor": c, "coef_logit": float(fit.params[i + 1]),
                     "SE": float(fit.bse[i + 1]),
                     "z": float(fit.tvalues[i + 1]),
                     "p_raw": float(fit.pvalues[i + 1]),
                     "OR_per_SD": float(np.exp(fit.params[i + 1])),
                     "CIlo_OR": float(np.exp(ci[i + 1, 0])),
                     "CIhi_OR": float(np.exp(ci[i + 1, 1]))})
    df = pd.DataFrame(rows)
    _, qv, _, _ = multipletests(df["p_raw"].values, alpha=0.05, method="fdr_bh")
    df["q_BH"] = qv
    df.sort_values("p_raw").to_csv("artifacts/03_logit_env_z_predictors.csv", index=False)
    return df


def step4_figures(metrics, inv):
    profile = metrics.sort_values("prevalence_gard", ascending=False).reset_index(drop=True)
    profile.to_csv("artifacts/04_figure1_prevalence_data.csv", index=False)

    aggs = inv.groupby("habitat")[["n.gard", "n.unint", "n.agfo"]].sum()
    aggs["total"] = aggs.sum(axis=1)
    aggs["pct_gard"] = aggs["n.gard"] / aggs["total"]
    aggs["pct_unint"] = aggs["n.unint"] / aggs["total"]
    aggs["pct_agfo"] = aggs["n.agfo"] / aggs["total"]
    aggs.sort_values("pct_gard", ascending=False).to_csv(
        "artifacts/04_figure2_stacked_composition_data.csv")

    # Mann-Whitney U for univariate env signal
    env_cols = ["elevation", "urban.2009.500m", "cropland.2009.500m",
                "annual.temperature", "annual.rainfall",
                "distance.road", "distance.stream"]
    inv["gard_present"] = (inv["n.gard"] > 0).astype(int)
    rows = []
    for c in env_cols:
        pos = inv.loc[inv["gard_present"] == 1, c].values
        neg = inv.loc[inv["gard_present"] == 0, c].values
        U, p = mannwhitneyu(pos, neg, alternative="two-sided")
        rows.append({"predictor": c, "median_pos": float(np.median(pos)),
                     "median_neg": float(np.median(neg)),
                     "direction": "+" if np.median(pos) > np.median(neg) else "-",
                     "U": float(U), "p_raw": float(p)})
    mw = pd.DataFrame(rows)
    _, qv_mw, _, _ = multipletests(mw["p_raw"].values, alpha=0.05, method="fdr_bh")
    mw["q_BH"] = qv_mw
    mw.sort_values("p_raw").to_csv("artifacts/02_env_univariate_mwU.csv", index=False)

    # Habitat-level rho
    rows = []
    for c in env_cols:
        mp = inv.groupby("habitat")["gard_present"].mean()
        me = inv.groupby("habitat")[c].median()
        r = float(np.corrcoef(mp, me)[0, 1])
        rows.append({"pred": c, "rho_hab_prevalence_vs_median_env": r})
    pd.DataFrame(rows).sort_values(
        "rho_hab_prevalence_vs_median_env", key=abs, ascending=False
    ).to_csv("artifacts/04_habitat_level_env_correlations.csv", index=False)


class _NewickParser:
    def __init__(self, s):
        self.s = s.strip().rstrip(";")
        self.i = 0
        self.nodes = []

    def read_name_length(self):
        while self.i < len(self.s) and self.s[self.i] in " \t":
            self.i += 1
        name = None
        length = None
        m = re.match(r"[A-Za-z0-9_\-\.]+", self.s[self.i:])
        if m:
            name = m.group(0)
            self.i += len(m.group(0))
        if self.i < len(self.s) and self.s[self.i] == ":":
            self.i += 1
            m = re.match(r"[0-9eE\.\-]+", self.s[self.i:])
            if m:
                length = float(m.group(0))
                self.i += len(m.group(0))
        return name, length

    def parse_subtree(self):
        children = []
        if self.i < len(self.s) and self.s[self.i] == "(":
            self.i += 1
            children.append(self.parse_subtree())
            while self.i < len(self.s) and self.s[self.i] == ",":
                self.i += 1
                children.append(self.parse_subtree())
            assert self.s[self.i] == ")"
            self.i += 1
            name, length = self.read_name_length()
        else:
            name, length = self.read_name_length()
        nid = len(self.nodes)
        self.nodes.append({"name": name, "blen": length,
                            "children": children, "parent": None})
        for c in children:
            self.nodes[c]["parent"] = nid
        return nid


def step5_phylogenetic(succ):
    with open("data/phylogenetic_tree.txt") as f:
        nw = f.read()
    p = _NewickParser(nw)
    p.parse_subtree()
    nodes = p.nodes
    tip_indices = [i for i, nd in enumerate(nodes) if not nd["children"]]
    tip_names = [nodes[i]["name"] for i in tip_indices]
    label_to_row = dict(zip(succ["phylo.tip.label"], succ.index))
    matched = [(tip_names.index(nm), nm)
               for nm in succ["phylo.tip.label"] if nm in tip_names]
    pos_keep = [m[0] for m in matched]
    # Pairwise distance matrix
    paths = []
    for ti in tip_indices:
        path = []; cur = ti
        while cur is not None:
            path.append(cur); cur = nodes[cur]["parent"]
        paths.append(path)
    na = len(tip_indices)
    D = np.zeros((na, na))
    for i in range(na):
        set_i = set(paths[i])
        for j in range(i + 1, na):
            mrca = None
            for nd in paths[j]:
                if nd in set_i: mrca = nd; break
            li = sum((nodes[k]["blen"] or 0) for k in paths[i][:paths[i].index(mrca)])
            lj = sum((nodes[k]["blen"] or 0) for k in paths[j][:paths[j].index(mrca)])
            D[i, j] = D[j, i] = li + lj
    sub_D = D[np.ix_(pos_keep, pos_keep)]
    labels = np.array([succ.loc[label_to_row[m[1]], "intro.pathway"] for m in matched])
    n_sp = sub_D.shape[0]
    triu_mask = np.triu(np.ones((n_sp, n_sp), dtype=bool), 1)
    pair_same = (labels[:, None] == labels[None, :])
    same_mask = pair_same & triu_mask
    diff_mask = (~pair_same) & triu_mask
    K_obs = float(sub_D[same_mask].mean() / sub_D[triu_mask].mean())
    rng = np.random.default_rng(11)
    ks = np.empty(5000)
    for it in range(5000):
        shuf = rng.permutation(labels)
        ks[it] = float(sub_D[(shuf[:, None] == shuf[None, :]) & triu_mask].mean()
                       / sub_D[triu_mask].mean())
    p_perm = float((ks <= K_obs).mean())
    out = {
        "tree_total_nodes": len(nodes),
        "tip_count": na,
        "matched_species_in_invasion_success": len(matched),
        "matched_coverage_of_dataset_81": len(matched) / 81,
        "K_statistic_obs": K_obs,
        "mean_dist_same_pathway": float(sub_D[same_mask].mean()),
        "mean_dist_different_pathway": float(sub_D[diff_mask].mean()),
        "permutation_p_value_one_sided_clustering": p_perm,
        "n_permutations": 5000,
        "note": ("K_obs<1 = phylogenetic clustering. Mantel-style surrogate "
                 "of Pagel lambda; biopython unavailable in env.")
    }
    with open("artifacts/05_phylogenetic_signal.json", "w") as f:
        json.dump(out, f, indent=2)
    return out


def main():
    inv, succ = load_and_prep()
    step0_check(inv)
    metrics = step1_metrics(inv)
    hab_binom, hab_pois, ztp = step2_hurdle(inv)
    env_coef = step3_env(inv)
    step4_figures(metrics, inv)
    phylo = step5_phylogenetic(succ)
    # Save a one-line summary
    print("\nDone. Headline:")
    ordered = metrics.sort_values("prevalence_gard", ascending=False)
    print(ordered[["habitat", "prevalence_gard", "prev_CI_lo", "prev_CI_hi"]]
          .to_string(index=False))
    print(f"\nPhylogenetic K={phylo['K_statistic_obs']:.4f}, "
          f"p_perm={phylo['permutation_p_value_one_sided_clustering']:.4f}")


if __name__ == "__main__":
    main()
