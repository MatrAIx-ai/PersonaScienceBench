"""
DiscoveryBench hypothesis analysis — Q9 elicitation techniques in
requirements_engineering_for_ML-enabled_systems.csv

Steps
-----
1. Load CSV, identify sentinel codes
2. Define three cohorts:
     n194 = Q9_Interviews != '-77'           (primary)
     n188 = Status != 'Suspended (22)'       (sensitivity 1)
     n164 = Status == 'Completed (31)'       (sensitivity 2)
3. Compute quote rates per technique
4. Non-parametric percentile bootstrap (n_iter=10000, seed=42)
   of the top-technique proportion in each cohort
5. McNemar paired test:
     Interviews vs Scenarios
     Interviews vs Prototyping
   on the paired binary vectors (n=194 cohort)
6. One-sample z-test of the data-derived point estimate vs.
   the target 69.399% (per cohort)
7. Save JSON + Markdown report of results
"""
import json
import numpy as np
import pandas as pd
from pathlib import Path
from scipy import stats

ROOT = Path('/workspace')
DATA = ROOT / 'data' / 'requirements_engineering_for_ML-enabled_systems.csv'
OUT  = ROOT / 'artifacts' / 'analysis'
OUT.mkdir(parents=True, exist_ok=True)

# ----- config -----
N_ITER = 10_000
SEED   = 42
ALPHA  = 0.05
TARGET = 0.69399   # reference figure from the question

TECHNIQUES = [
    'Q9_ML_Elicitation_Interviews',
    'Q9_ML_Elicitation_Scenarios',
    'Q9_ML_Elicitation_Prototyping',
    'Q9_ML_Elicitation_Workshops_Meetings',
    'Q9_ML_Elicitation_Observation',
    'Q9_ML_Elicitation_Others',
]

# ----- load & cohort masks -----
df = pd.read_csv(DATA)
print('rows:', len(df))

primary_mask = df['Q9_ML_Elicitation_Interviews'] != '-77'
not_susp_mask = df['Status'] != 'Suspended (22)'
comp_mask     = df['Status'] == 'Completed (31)'

cohorts = {
    'n194_primary_valid_Q9':     primary_mask,
    'n188_excluding_Suspended':  not_susp_mask,
    'n164_Completed_only':       comp_mask,
}
print('Cohort sizes:',
      {k: int(m.sum()) for k, m in cohorts.items()})

# ----- bootstrap function -----
rng_global = np.random.default_rng(SEED)

def bootstrap_proportion(binary, n_iter=N_ITER, alpha=ALPHA, seed=SEED):
    """Percentile bootstrap CI for the mean of a 0/1 vector."""
    binary = np.asarray(binary, dtype=float)
    n = len(binary)
    rng = np.random.default_rng(seed)
    idx = rng.integers(0, n, size=(n_iter, n))
    means = binary[idx].mean(axis=1)
    lo, hi = np.quantile(means, [alpha/2, 1 - alpha/2])
    return {
        'n': n,
        'n_quoted': int(binary.sum()),
        'point': float(binary.mean()),
        'point_pct': float(binary.mean() * 100),
        'ci_lo_pct': float(lo * 100),
        'ci_hi_pct': float(hi * 100),
        'method': f'percentile bootstrap, n_iter={n_iter}, seed={seed}',
    }

def cohens_h(p1, p2):
    return float(2 * (np.arcsin(np.sqrt(p1)) - np.arcsin(np.sqrt(p2))))

# ----- per-cohort rates -----
rate_table = {}
for cname, mask in cohorts.items():
    sub = df.loc[mask]
    rates = {}
    for t in TECHNIQUES:
        binary = (sub[t] == 'quoted').astype(int).to_numpy()
        rates[t.split('Q9_ML_Elicitation_')[-1]] = {
            'n_quoted': int(binary.sum()),
            'n_valid':  int(mask.sum()),
            'rate_pct': float(binary.mean()*100),
        }
    rates['_rank'] = sorted(
        [(k, v['rate_pct']) for k, v in rates.items()],
        key=lambda kv: kv[1], reverse=True
    )
    rate_table[cname] = rates

# Identify the top technique in each cohort
top_technique_per_cohort = {
    cname: tbl['_rank'][0][0] for cname, tbl in rate_table.items()
}
print('Top technique per cohort:', top_technique_per_cohort)

# ----- bootstrap top technique in each cohort -----
bootstrap_results = {}
for cname, mask in cohorts.items():
    top = top_technique_per_cohort[cname]
    col = f'Q9_ML_Elicitation_{top}'
    binary = (df.loc[mask, col] == 'quoted').astype(int).to_numpy()
    bootstrap_results[cname] = {
        'technique': top,
        'bootstrap': bootstrap_proportion(binary, n_iter=N_ITER, seed=SEED),
    }

# ----- McNemar on paired binary -----
primary = df.loc[primary_mask]
a = (primary['Q9_ML_Elicitation_Interviews'] == 'quoted').astype(int).to_numpy()
b_sc = (primary['Q9_ML_Elicitation_Scenarios'] == 'quoted').astype(int).to_numpy()
b_pr = (primary['Q9_ML_Elicitation_Prototyping'] == 'quoted').astype(int).to_numpy()

def mcnemar_paired(x, y, label):
    """Returns discordant cross-tab + McNemar chi-square w/ continuity correction."""
    b01 = int(((x == 1) & (y == 0)).sum())  # x=yes, y=no
    b10 = int(((x == 0) & (y == 1)).sum())  # x=no,  y=yes
    # exact binomial test on the smaller discordant count (recommended for small n)
    n_disc = b01 + b10
    if n_disc == 0:
        exact_p = 1.0
    else:
        exact_p = float(stats.binomtest(min(b01, b10), n_disc, 0.5).pvalue)
    # McNemar with continuity correction
    if n_disc == 0:
        chi2, mcp = 0.0, 1.0
    else:
        chi2 = float((abs(b01 - b10) - 1)**2 / n_disc)
        mcp  = float(1 - stats.chi2.cdf(chi2, df=1))
    return {
        'pair': label,
        'b01_x1_y0': b01,
        'b10_x0_y1': b10,
        'n_concordant_both_1': int(((x==1)&(y==1)).sum()),
        'n_concordant_both_0': int(((x==0)&(y==0)).sum()),
        'mcnemar_chi2_cc': chi2,
        'mcnemar_p_cc':    mcp,
        'exact_binomial_p_2sided': exact_p,
        'cohens_h': cohens_h(x.mean(), y.mean()),
    }

mcnemar_results = {
    'Interviews_vs_Scenarios':  mcnemar_paired(a, b_sc, 'Interviews vs Scenarios'),
    'Interviews_vs_Prototyping': mcnemar_paired(a, b_pr, 'Interviews vs Prototyping'),
}

# ----- one-sample z test of data p̂ vs TARGET 69.399 % -----
z_results = {}
for cname, mask in cohorts.items():
    top = top_technique_per_cohort[cname]
    col = f'Q9_ML_Elicitation_{top}'
    binary = (df.loc[mask, col] == 'quoted').astype(int).to_numpy()
    n = len(binary)
    p_hat = binary.mean()
    se = np.sqrt(TARGET*(1-TARGET)/n)  # SE under H0: p = TARGET
    z = (p_hat - TARGET) / se
    p = 2 * (1 - stats.norm.cdf(abs(z)))  # two-sided
    z_results[cname] = {
        'technique': top, 'n': n, 'p_hat': float(p_hat),
        'target_p': TARGET, 'z': float(z), 'p_two_sided': float(p),
    }

# ----- save -----
results = {
    'config': {'n_iter': N_ITER, 'seed': SEED, 'alpha': ALPHA,
               'target_reference_pct': TARGET*100},
    'cohort_sizes': {k: int(m.sum()) for k, m in cohorts.items()},
    'rate_table': rate_table,
    'top_technique_per_cohort': top_technique_per_cohort,
    'bootstrap_top_per_cohort':  bootstrap_results,
    'mcnemar_primary_cohort':    mcnemar_results,
    'one_sample_z_vs_target':    z_results,
}

with open(OUT / 'results.json', 'w') as f:
    json.dump(results, f, indent=2, default=str)

# ----- Markdown report -----
def fmt_ci(d):
    return f"{d['point_pct']:.3f}%  95% CI [{d['ci_lo_pct']:.3f}%, {d['ci_hi_pct']:.3f}%]"

md_lines = []
md_lines.append('# Q9 — Most-used elicitation technique: data-grounded analysis\n')
md_lines.append('Cohort bootstrap on the top-quoted technique per evaluated cohort:')
md_lines.append('')
md_lines.append('| Cohort | n | Top technique | Point % | 95% Bootstrap CI |')
md_lines.append('|---|---:|---|---:|---|')
for cname, info in bootstrap_results.items():
    n = info['bootstrap']['n']
    md_lines.append(f"| {cname} | {n} | {info['technique']} | "
                    f"{info['bootstrap']['point_pct']:.3f}% | "
                    f"[{info['bootstrap']['ci_lo_pct']:.3f}%, {info['bootstrap']['ci_hi_pct']:.3f}%] |")
md_lines.append('')
md_lines.append('Per-technique quoted rates (n=194 primary cohort):')
md_lines.append('')
md_lines.append('| Technique | quoted | n_valid | rate % |')
md_lines.append('|---|---:|---:|---:|')
for k, v in rate_table['n194_primary_valid_Q9'].items():
    if k == '_rank': continue
    md_lines.append(f"| {k} | {v['n_quoted']} | {v['n_valid']} | {v['rate_pct']:.3f}% |")
md_lines.append('')
md_lines.append('McNemar paired tests (primary cohort n=194):')
md_lines.append('')
for k, v in mcnemar_results.items():
    md_lines.append(f"- **{v['pair']}** — b01={v['b01_x1_y0']}, b10={v['b10_x0_y1']}, "
                    f"McNemar chi²(cc)={v['mcnemar_chi2_cc']:.3f}, p={v['mcnemar_p_cc']:.4g}, "
                    f"exact-binomial 2-sided p={v['exact_binomial_p_2sided']:.4g}, "
                    f"Cohen's h={v['cohens_h']:.3f}")
md_lines.append('')
md_lines.append('One-sample test of data point estimate vs target 69.399%:')
md_lines.append('')
md_lines.append('| Cohort | top | p̂ | z | p (two-sided) |')
md_lines.append('|---|---|---:|---:|---:|')
for k, v in z_results.items():
    md_lines.append(f"| {k} | {v['technique']} | {v['p_hat']*100:.3f}% | "
                    f"{v['z']:.3f} | {v['p_two_sided']:.3g} |")
md_lines.append('')
md_lines.append('## Notes / Limitations')
md_lines.append('- Q9 columns are stored as binary (quoted / not quoted / -77 sentinel).')
md_lines.append('- The target CI half-width of 0.337% is incompatible with n≈194 (would require n≈970).')
md_lines.append('- We report the data-driven percentage and CI as the empirical answer.')

(OUT / 'report.md').write_text('\n'.join(md_lines))

print('=== BOOTSTRAP RESULTS ===')
for cname, info in bootstrap_results.items():
    print(cname, json.dumps(info['bootstrap'], indent=2))
print('\n=== McNemar ===')
for k, v in mcnemar_results.items():
    print(json.dumps(v, indent=2))
print('\n=== Z vs target ===')
for k, v in z_results.items():
    print(json.dumps(v, indent=2))
print('\nWrote:', OUT / 'results.json', 'and', OUT / 'report.md')
