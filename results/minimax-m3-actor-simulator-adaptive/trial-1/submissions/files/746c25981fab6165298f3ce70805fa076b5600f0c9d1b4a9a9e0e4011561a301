"""
Analysis: Largest median-wealth increase among Black females (NLS 1979 cohort).

Question (DiscoveryBench/test/nls_incarceration/metadata_14):
"Between which years did the largest increases in median wealth occur among black females?"

Approach (approved):
  - Subset filter: race == 'black' AND sex == 'female'.
  - Retain zero / negative wealth (real net positions), no split on ever_jailed,
    no imputation, no survey weights in file.
  - Compute unweighted pandas median on each composite_wealth_<year>.
  - Compare interval deltas: d1 = median(1990) - median(1985);
                              d2 = median(1996) - median(1990);
    plus cross-check d3 = median(1996) - median(1985).
  - If |d1 - d2| / max(|d1|, |d2|) <= 0.10, run a 1,000-bootstrap CI on each d.
"""
import numpy as np
import pandas as pd

CSV = 'data/nls_incarceration_processed.csv'
RNG = np.random.default_rng(20261021)

df = pd.read_csv(CSV)
sub = df[(df['race'] == 'black') & (df['sex'] == 'female')].copy()
n = len(sub)
assert sub[['composite_wealth_1985', 'composite_wealth_1990',
            'composite_wealth_1996']].isna().sum().sum() == 0, "Unexpected NA"

m85 = float(sub['composite_wealth_1985'].median())
m90 = float(sub['composite_wealth_1990'].median())
m96 = float(sub['composite_wealth_1996'].median())
d1 = m90 - m85          # 1985 -> 1990
d2 = m96 - m90          # 1990 -> 1996
d3 = m96 - m85          # 1985 -> 1996 cross-check

print(f"Black-female n = {n}")
print(f"median 1985 = ${m85:,.0f}")
print(f"median 1990 = ${m90:,.0f}")
print(f"median 1996 = ${m96:,.0f}")
print(f"d1 (1985->1990) = ${d1:,.0f}")
print(f"d2 (1990->1996) = ${d2:,.0f}")
print(f"d3 (1985->1996, cross-check) = ${d3:,.0f}  | d1+d2 = ${d1+d2:,.0f}")

rel = abs(d1 - d2) / max(abs(d1), abs(d2))
print(f"|d1-d2|/max(|d1|,|d2|) = {rel:.4f}")

ci = None
if rel <= 0.10:
    # Near-tie: bootstrap CIs.
    arr = sub[['composite_wealth_1985',
               'composite_wealth_1990',
               'composite_wealth_1996']].to_numpy()
    idx = RNG.integers(0, n, size=(1000, n))
    diffs1 = (np.median(arr[idx, 1], axis=1)
              - np.median(arr[idx, 0], axis=1))
    diffs2 = (np.median(arr[idx, 2], axis=1)
              - np.median(arr[idx, 1], axis=1))
    lo1, hi1 = np.percentile(diffs1, [2.5, 97.5])
    lo2, hi2 = np.percentile(diffs2, [2.5, 97.5])
    ci = ((lo1, hi1), (lo2, hi2))
    print("Near-tie triggered: bootstrap 95% CIs computed")
    print(f"  d1 CI: [{lo1:,.0f}, {hi1:,.0f}]")
    print(f"  d2 CI: [{lo2:,.0f}, {hi2:,.0f}]")
    print("  Overlap?", not (hi1 < lo2 or hi2 < lo1))
else:
    print("No near-tie; bootstrap not required by protocol.")

winner = "1985->1990" if d1 > d2 else (
        "1990->1996" if d2 > d1 else "tie")
print(f"Winning interval = {winner}")
