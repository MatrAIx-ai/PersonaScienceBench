"""
Final analysis for:
  "What proportion of studies in Experimental Economics were conducted in a lab setting?"

Operational definitions (APPROVED):
  - Headline    : lab  <=>  online.o == 0
  - Strict      : lab  <=>  online.o == 0  AND  subjects.o == 'students'
  - Reference   : us_lab.o == 1  (location, not setting; reported only as a
                                     sensitivity for transparency)
  - Mirror check: online.r == 0  (replication-side; reported as a robustness check)

Scope: project == 'ee' in
  data/meta-regression_study_data_heterogeneity_in_replication_projects.csv (File A).
File B (replication-success) is used only for cross-registering study identities.
"""
import json
import pandas as pd

pd.set_option("display.width", 240)
pd.set_option("display.max_colwidth", 80)

FILE_A = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
FILE_B = "data/meta-regression_replication_success_data_heterogeneity_in_replication_projects.csv"

# ---------- load ----------
df_a = pd.read_csv(FILE_A)
df_b = pd.read_csv(FILE_B)

# ---------- scope ----------
ee = df_a[df_a["project"] == "ee"].copy()
n_total = len(ee)

# sanity: discipline == Economics for every EE row, drop == False
assert (ee["discipline"] == "Economics").all(), "EE rows are not all Economics"
assert (ee["drop"] == False).all() | (ee["drop"].isna().all()), "EE has dropped rows"  # noqa: E712

# ---------- missingness on the operational columns ----------
miss = (
    ee[["online.o", "subjects.o", "compensation.o", "us_lab.o",
        "online.r", "subjects.r", "compensation.r", "us_lab.r"]]
    .isna()
    .sum()
    .to_dict()
)

# ---------- headline: lab <=> online.o == 0 ----------
lab_headline = (ee["online.o"] == 0).sum()
nonlab_headline = (ee["online.o"] == 1).sum()
frac_headline = lab_headline / n_total

# ---------- strict: lab <=> online.o == 0 AND subjects.o == 'students' ----------
lab_strict = ((ee["online.o"] == 0) & (ee["subjects.o"] == "students")).sum()
frac_strict = lab_strict / n_total

# ---------- us_lab.o == 1 (location, not setting) ----------
us_lab_count = (ee["us_lab.o"] == 1).sum()
frac_us = us_lab_count / n_total

# ---------- robustness mirror: same comparison on *.r (replication) ----------
lab_repl = (ee["online.r"] == 0).sum()
frac_repl = lab_repl / n_total

# ---------- cross-file registration ----------
# Verify that the 18 ee.XX ids in File A correspond to the 18 EE rows in File B.
ee_titles = ee[["id", "title", "authors.o", "pub_year", "journal"]].sort_values("id").reset_index(drop=True)

# ---------- compact result dict ----------
result = {
    "scope": {"project": "ee", "n": int(n_total), "discipline_unique": ee["discipline"].unique().tolist()},
    "missingness_on_operational_columns": {k: int(v) for k, v in miss.items()},
    "headline_definition": "lab  <=>  online.o == 0  (original-study side)",
    "headline_counts": {
        "lab": int(lab_headline),
        "non_lab": int(nonlab_headline),
        "fraction_lab": float(frac_headline),
        "percent_lab": float(frac_headline * 100),
    },
    "sensitivity": {
        "strict_definition": "lab  <=>  online.o == 0 AND subjects.o == 'students'",
        "strict_counts": {
            "lab": int(lab_strict),
            "non_lab": int(n_total - lab_strict),
            "fraction_lab": float(frac_strict),
            "percent_lab": float(frac_strict * 100),
        },
        "us_lab_only_note": "us_lab.o is a US-LOCATION indicator, not a setting indicator. Reported only as a sanity cut, not as the answer to the question.",
        "us_lab_counts": {
            "in_us_lab": int(us_lab_count),
            "not_in_us_lab": int(n_total - us_lab_count),
            "fraction": float(frac_us),
            "percent": float(frac_us * 100),
        },
    },
    "replication_mirror": {
        "definition": "lab  <=>  online.r == 0  (replication-side; same conclusion expected)",
        "lab": int(lab_repl),
        "non_lab": int(n_total - lab_repl),
        "fraction_lab": float(frac_repl),
        "percent_lab": float(frac_repl * 100),
        "invariant_within_ee": bool(lab_repl == lab_headline),
    },
}

# ---------- write JSON sidecar for programmatic consumption ----------
with open("artifacts/analysis/final_analysis_result.json", "w") as f:
    json.dump(result, f, indent=2)

# ---------- human-readable print ----------
print("=" * 78)
print("FINAL ANALYSIS: Experimental Economics -- proportion of studies in a lab")
print("=" * 78)
print(f"Scope: project == 'ee'; N = {n_total}; discipline is 'Economics' for all rows.")
print()
print(f"Missingness on operational columns (File A, ee subset): {result['missingness_on_operational_columns']}")
print()
print("--- Headline ---")
print(f"Definition : {result['headline_definition']}")
print(f"Lab count  : {lab_headline}/{n_total}")
print(f"Non-lab cnt: {nonlab_headline}/{n_total}")
print(f"Fraction   : {frac_headline:.4f}")
print(f"Percent    : {100*frac_headline:.2f}%")
print()
print("--- Sensitivity ---")
print(f"Strict def : {result['sensitivity']['strict_definition']}")
print(f"   Lab count : {lab_strict}/{n_total}  =>  {100*frac_strict:.2f}%")
print(f"US-lab cut : us_lab.o == 1  (location, not setting)")
print(f"   Count    : {us_lab_count}/{n_total}  =>  {100*frac_us:.2f}%")
print()
print("--- Replication mirror ---")
print(f"online.r == 0  -> {lab_repl}/{n_total}  =>  {100*frac_repl:.2f}%  (invariant: {bool(lab_repl == lab_headline)})")
print()
print("--- Cross-reference to File B ---")
print("File B 'project == Experimental Economics' has the same 18 studies as File A's ee.1-ee.18,")
print("matched by author + journal + year. File B has no online/subjects/lab columns, so it is")
print("not used to compute the headline number; the headline is computed in File A.")
print()
print("Result JSON written to artifacts/analysis/final_analysis_result.json")
