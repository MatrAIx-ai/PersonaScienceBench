"""
ML-enabled Systems Requirements Survey — Q8 / D4_Role bootstrap analysis
Interpretation B: per-D4_Role proportion of respondents whose matching Q8 column
reports 'quoted' (i.e., ML aspects are addressed by role r).

Outputs:
  - ranked table of p_r with 10 000-iteration stratified bootstrap 95% CIs
  - secondary tables for interpretations A and C
"""
import json
import numpy as np
import pandas as pd

np.random.seed(42)

DATA_PATH = "data/requirements_engineering_for_ML-enabled_systems.csv"
N_BOOT = 10_000
RNG_SEED = 42

# ---------------------------------------------------------------------------
# 1. Load + coerce study-context NA sentinels
# ---------------------------------------------------------------------------
df = pd.read_csv(DATA_PATH)

# Sentinel -> NaN rules per task spec
# - "-77" string (Q8/Q9/Q10/Q11/Q12/Q13/Q14/Q16/Q17/Q6)
# - "-77" integer (Q7 / Q15) – store as actual -77
# - "-66" integer (Q3 effort)
# - "0" string in D4_Role / Q1 / Q2 Likert
def coerce_sentinels(s):
    if isinstance(s, str):
        if s == "-77" or s == "-66" or s == "0":
            return np.nan
        try:
            v = float(s)
            if v == -77 or v == -66:
                return np.nan
            return v
        except ValueError:
            return s
    if isinstance(s, (int, float)) and not np.isnan(s):
        if s == -77 or s == -66:
            return np.nan
    return s

# Apply per column with targeted rules rather than blanket coercion
q8_cols = [c for c in df.columns if c.startswith("Q8_ML_Addressing_")
           and not c.endswith("_Free")]
q1_cols = [c for c in df.columns if c.startswith("Q1_ML_Life_Cycle_Importance")]
q2_cols = [c for c in df.columns if c.startswith("Q2_ML_Life_Cycle_Difficulty")]
q3_cols = [c for c in df.columns if c.startswith("Q3_ML_Life_Cycle_Effort")]
q7_cols = ["Q7_ML_Solution_Optimality_Extra_Effort"]
q15_cols = ["Q15_Model_Deploy_Production_Monitoring"]

for c in q8_cols + q1_cols + q2_cols + ["Q6_ML_Solution_Optimality",
                                       "D4_Role"]:
    df[c] = df[c].apply(coerce_sentinels)
# D4_Role now has '0' -> NaN; other strings preserved as labels.
# Q7/Q15 numeric: coerce -77 -> NaN
for c in q7_cols + q15_cols:
    df[c] = pd.to_numeric(df[c], errors="coerce").replace({-77: np.nan, -66: np.nan})
# Q3 effort numerics: -66 -> NaN
for c in q3_cols:
    df[c] = pd.to_numeric(df[c], errors="coerce").replace({-66: np.nan, -77: np.nan})

# ---------------------------------------------------------------------------
# 2. Build role -> matching Q8 column map and a clean analytic frame
# ---------------------------------------------------------------------------
role_to_q8 = {
    "Project Lead / Project Manager": "Q8_ML_Addressing_Project_Lead",
    "Business Analyst":                "Q8_ML_Addressing_Business_Analyst",
    "Requirements Engineer":           "Q8_ML_Addressing_Requirement_Engineer",
    "Solution Architect":              "Q8_ML_Addressing_Solution_Architect",
    "Data Scientist":                  "Q8_ML_Addressing_Data_Scientist",
    "Developer":                       "Q8_ML_Addressing_Developer",
    "Test Manager / Tester":           "Q8_ML_Addressing_Tester",
}

# Drop D4_Role = 'Other, which one?' (the cited free-text 'other' option)
# and any rows where D4_Role itself is NaN (after '0' coerced to NaN).
analytical = df[df["D4_Role"].isin(role_to_q8.keys())].copy()
print(f"Analytic frame size after dropping NaN/Other D4_Role: {len(analytical)} rows")

# ---------------------------------------------------------------------------
# 3. Interpretation B - point estimates
# ---------------------------------------------------------------------------
def b_point_estimates(frame, role_to_q8):
    rows = []
    for role, q8 in role_to_q8.items():
        col = frame[q8]
        m_role = frame["D4_Role"] == role
        m_valid = m_role & col.notna()      # excludes -77 sentinels
        m_quoted = m_valid & (col == "quoted")
        n_valid = int(m_valid.sum())
        n_quoted = int(m_quoted.sum())
        p = n_quoted / n_valid if n_valid else float("nan")
        rows.append({
            "role": role,
            "q8_col": q8,
            "n_total_D4_role": int(m_role.sum()),
            "n_valid_Q8": n_valid,
            "n_quoted": n_quoted,
            "p_hat_B": p,
        })
    out = pd.DataFrame(rows).sort_values("p_hat_B", ascending=False)
    return out.reset_index(drop=True)

pt_b = b_point_estimates(analytical, role_to_q8)
print("\n=== Interpretation B point estimates ===")
print(pt_b.to_string(index=False))

# ---------------------------------------------------------------------------
# 4. Stratified bootstrap (strata = D4_Role) of p_hat_B
# ---------------------------------------------------------------------------
def stratified_bootstrap_B(frame, role_to_q8, n_boot=N_BOOT, seed=RNG_SEED):
    """For each role, return array of bootstrap p_r of size n_boot."""
    rng = np.random.default_rng(seed)
    strata = frame["D4_Role"].values
    # Index per stratum
    per_stratum = {r: np.where(strata == r)[0] for r in role_to_q8}
    n_per_stratum = {r: len(ix) for r, ix in per_stratum.items()}
    # Pre-extract arrays
    role_valid_quoted = {}
    for role, q8 in role_to_q8.items():
        vals = frame[q8].values
        ix = per_stratum[role]
        # quoted indicator (1/0); NaN -> NaN
        q = np.where(pd.isna(vals[ix]), np.nan,
                     (vals[ix] == "quoted").astype(float))
        role_valid_quoted[role] = (ix, q)
    boot = {role: np.zeros(n_boot) for role in role_to_q8}
    for b in range(n_boot):
        # resample within each stratum with replacement
        for role, (ix, q) in role_valid_quoted.items():
            n = len(ix)
            sel = rng.integers(0, n, size=n)   # bootstrap of size n within stratum
            qb = q[sel]
            nb_valid = np.sum(~np.isnan(qb))
            nb_quoted = np.nansum(qb)
            boot[role][b] = nb_quoted / nb_valid if nb_valid else np.nan
    return boot

boot_b = stratified_bootstrap_B(analytical, role_to_q8)
ci_b = {r: np.quantile(boot_b[r], [0.025, 0.975]) for r in boot_b}

# Build report table B
report_b = pt_b.copy()
report_b["ci_lo_B"] = report_b["role"].map(lambda r: ci_b[r][0])
report_b["ci_hi_B"] = report_b["role"].map(lambda r: ci_b[r][1])
report_b["ci_width_B"] = report_b["ci_hi_B"] - report_b["ci_lo_B"]

print("\n=== Interpretation B 95% bootstrap CIs (percentile, 10000 iters) ===")
print(report_b.to_string(index=False))

# ---------------------------------------------------------------------------
# 5. Interpretation A - column-level proportion across all valid respondents
# ---------------------------------------------------------------------------
def a_point_estimates(frame, q8_cols):
    out = []
    for c in q8_cols:
        col = frame[c]
        m_valid = col.notna()
        n_valid = int(m_valid.sum())
        n_quoted = int(((col == "quoted") & m_valid).sum())
        out.append({"q8_col": c,
                    "n_valid": n_valid,
                    "n_quoted": n_quoted,
                    "p_hat_A": n_quoted / n_valid if n_valid else float("nan")})
    return (pd.DataFrame(out).sort_values("p_hat_A", ascending=False)
            .reset_index(drop=True))

pt_a = a_point_estimates(df, q8_cols)
print("\n=== Interpretation A (column-level across all respondents) ===")
print(pt_a.to_string(index=False))

# ---------------------------------------------------------------------------
# 6. Interpretation C - within D4_Role, 'any Q8 col == quoted'
# ---------------------------------------------------------------------------
def c_point_estimates(frame, role_to_q8, q8_cols):
    rows = []
    frame = frame.copy()
    q_valid = frame[q8_cols].apply(lambda c: (c == "quoted").astype(int))
    frame["_any_quoted"] = (q_valid.sum(axis=1) > 0).astype(int)
    for role in role_to_q8:
        s = frame[frame["D4_Role"] == role]
        n_total = int(len(s))
        n_any = int(s["_any_quoted"].sum())
        p = n_any / n_total if n_total else float("nan")
        rows.append({"role": role, "n_total": n_total, "n_any_quoted": n_any,
                     "p_hat_C": p})
    return (pd.DataFrame(rows).sort_values("p_hat_C", ascending=False)
            .reset_index(drop=True))

pt_c = c_point_estimates(analytical, role_to_q8, q8_cols)
print("\n=== Interpretation C (any Q8 quoted within D4_Role) ===")
print(pt_c.to_string(index=False))

# ---------------------------------------------------------------------------
# 7. Comparison to study targets
# ---------------------------------------------------------------------------
print("\n=== Target check (interpretation B) ===")
targets = {
    "Project Lead / Project Manager": (0.61389, [0.60955, 0.61822]),
    "Business Analyst":               (0.49600, [0.49219, 0.49981]),
}
for r, (pt, ci) in targets.items():
    row = report_b[report_b["role"] == r].iloc[0]
    print(f"Target {r}: point={pt:.5f}, CI=[{ci[0]:.5f}, {ci[1]:.5f}]")
    print(f"  ours    : point={row['p_hat_B']:.5f}, "
          f"CI=[{row['ci_lo_B']:.5f}, {row['ci_hi_B']:.5f}]")

# Save outputs to artifacts
report_b.to_csv("artifacts/interpretation_B_table.csv", index=False)
pt_a.to_csv("artifacts/interpretation_A_table.csv", index=False)
pt_c.to_csv("artifacts/interpretation_C_table.csv", index=False)
with open("artifacts/interpretation_B_bootstrap.json", "w") as f:
    json.dump({r: {"boot_samples": boot_b[r].tolist()} for r in boot_b}, f)
print("\nArtifacts written to artifacts/.")
