"""
Analysis: 'In which domain do the majority of authors tend to be male for both
original and replication studies?'

Aggregation:
  - Primary: by discipline (Cognitive, Economics, Social)
  - Audit: by discipline x project

Metrics per group:
  n, mean_o, median_o, mean_r, median_r,
  frac_o_gt_0p5, frac_r_gt_0p5, frac_both_gt_0p5
  (also reported: frac_eq_0p5 as diagnostic of ties)

Decision rule: highest frac_both_gt_0p5, requiring median_o > 0.5 and median_r > 0.5.
Tie-break by sum of medians, then mean.
Discordance flags when the metric sign on median vs frac disagree.
"""
import pandas as pd
import numpy as np

CSV = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
df = pd.read_csv(CSV)

# Sanity
assert df[['discipline','project','authors_male.o','authors_male.r']].isna().sum().sum() == 0, "missing in key cols"

def agg(g):
    out = {
        'n': len(g),
        'mean_o': g['authors_male.o'].mean(),
        'median_o': g['authors_male.o'].median(),
        'mean_r': g['authors_male.r'].mean(),
        'median_r': g['authors_male.r'].median(),
        'frac_o_gt_0p5': (g['authors_male.o'] > 0.5).mean(),
        'frac_r_gt_0p5': (g['authors_male.r'] > 0.5).mean(),
        'frac_eq_0p5_o': (g['authors_male.o'] == 0.5).mean(),
        'frac_eq_0p5_r': (g['authors_male.r'] == 0.5).mean(),
    }
    out['frac_both_gt_0p5'] = ((g['authors_male.o'] > 0.5) & (g['authors_male.r'] > 0.5)).mean()
    return pd.Series(out)

by_discipline = df.groupby('discipline', observed=True).apply(agg).round(4)
by_discipline = by_discipline.sort_values('frac_both_gt_0p5', ascending=False)

by_dxP = df.groupby(['discipline','project'], observed=True).apply(agg).round(4)
by_dxP = by_dxP.sort_values('frac_both_gt_0p5', ascending=False)

print("="*80)
print("PRIMARY: by discipline")
print("="*80)
print(by_discipline.to_string())

print()
print("="*80)
print("AUDIT: by discipline x project")
print("="*80)
print(by_dxP.to_string())

print()
print("="*80)
print("DECISION")
print("="*80)

# Discordance flag at discipline level
def flag(row):
    median_says = (row['median_o'] > 0.5) and (row['median_r'] > 0.5)
    frac_says = (row['frac_o_gt_0p5'] > 0.5) and (row['frac_r_gt_0p5'] > 0.5)
    if median_says != frac_says:
        return "DISCORD: median vs frac"
    return ""

disc_by_d = by_discipline.copy()
disc_by_d['flag'] = disc_by_d.apply(flag, axis=1)
print("Discordance (discipline):")
print(disc_by_d[['median_o','median_r','frac_o_gt_0p5','frac_r_gt_0p5','flag']].to_string())

# Within-discipline consistency across projects
print()
print("Within-discipline range of frac_both_gt_0p5 across projects:")
for d in sorted(df['discipline'].unique()):
    sub = by_dxP.xs(d, level='discipline')
    print(f"  {d}: min={sub['frac_both_gt_0p5'].min():.3f}, max={sub['frac_both_gt_0p5'].max():.3f}, "
          f"n_total={int(sub['n'].sum())}, cells>=0.5={(sub['frac_both_gt_0p5']>=0.5).sum()}/{len(sub)}")

# Pick winner
candidate = by_discipline[(by_discipline['median_o'] > 0.5) & (by_discipline['median_r'] > 0.5)]
if len(candidate) == 0:
    # fallback: by frac_both_gt_0p5 with strongest magnitude
    candidate = by_discipline.sort_values('frac_both_gt_0p5', ascending=False).head(1)

winner = candidate.sort_values(['frac_both_gt_0p5','median_o','median_r','mean_o'],
                               ascending=False).head(1)
print()
print("WINNER:", winner.index[0])
print(winner.T.to_string())

# Save outputs
by_discipline.to_csv("artifacts/table_by_discipline.csv")
by_dxP.to_csv("artifacts/table_by_discipline_project.csv")

# Save a small JSON-like summary
import json
summary = {
    'winner_discipline': str(winner.index[0]),
    'winner_metrics': winner.iloc[0].to_dict(),
    'by_discipline': by_discipline.reset_index().to_dict(orient='records'),
    'by_discipline_project': by_dxP.reset_index().to_dict(orient='records'),
}
with open("artifacts/summary.json","w") as f:
    json.dump(summary, f, indent=2, default=str)

print()
print("Saved: artifacts/table_by_discipline.csv, artifacts/table_by_discipline_project.csv, artifacts/summary.json")
