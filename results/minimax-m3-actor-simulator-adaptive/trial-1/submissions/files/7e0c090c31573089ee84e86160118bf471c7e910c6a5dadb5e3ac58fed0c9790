#!/usr/bin/env python3
"""
run_analysis.py - DiscoveryBench (archaeology) main analysis

Question: Between 3400 BCE and 3000 BCE, how do MonumentCount and AxesCelts
          change with elements of symbolic capital {HatchetSword, Dagger, HouseSize}?

Per approved plan:
  - 5 bin centres BCE = {3400, 3300, 3200, 3100, 3000}, raw (non-inter) Z values.
  - Cross-confirm equivalence with time_series_data.csv at the 5 nodes, once.
  - Deltas, per-100-yr OLS slopes, Pearson + Spearman correlations (N=5).
  - Standalone SVG trajectory plot (no matplotlib).

Outputs:
  /workspace/analysis/analytical_frame.csv
  /workspace/analysis/correlations.csv
  /workspace/analysis/trajectory_plot.svg
  /workspace/analysis/results_summary.txt
"""
import csv
import numpy as np
import pandas as pd
from scipy import stats

cf = lambda x: float('nan') if x in ('', None) else float(str(x).replace(',', '.'))

cap = []
with open('/workspace/data/capital.csv', encoding='utf-8') as f:
    for r in csv.reader(f):
        if r[0] == 'BCE': continue
        d = {'BCE': int(r[0]), 'group': r[1], 'color': r[2]}
        for k, v in zip(['ZAxtSchwert','ZDolch','Zhausgr','ZCU_AU','Zamber','ZMonument',
                         'ZHort','ZSichel','ZBeil','ZMW','ZKeform','Zkeverz'], r[3:]):
            d[k] = cf(v)
        cap.append(d)
cap_df = pd.DataFrame(cap)
cap_win = (cap_df[(cap_df['BCE'] >= 3000) & (cap_df['BCE'] <= 3400)]
           .rename(columns={'ZAxtSchwert':'HatchetSword', 'ZDolch':'Dagger', 'Zhausgr':'HouseSize',
                            'ZMonument':'MonumentCount', 'ZBeil':'AxesCelts', 'ZMW':'MonumentSize',
                            'ZCU_AU':'CopperGold', 'Zamber':'Amber', 'ZHort':'Depot',
                            'ZSichel':'Sickle', 'ZKeform':'PotteryForm', 'Zkeverz':'PotteryDecoration'})
           .sort_values('BCE', ascending=False).reset_index(drop=True))

ts = pd.read_csv('/workspace/data/time_series_data.csv', index_col=0)
ts_centres = ts[ts['CE'].isin([-3400,-3300,-3200,-3100,-3000])].copy()
ts_centres['BCE'] = -ts_centres['CE']
maxd = {}
for _, r in cap_win.iterrows():
    bce = int(r['BCE'])
    tr = ts_centres[ts_centres['BCE']==bce].iloc[0]
    diffs = {k: abs(float(r[k]) - float(tr[k])) for k in
             ['HatchetSword','Dagger','HouseSize','MonumentCount','AxesCelts','MonumentSize']}
    maxd[bce] = max(diffs.values())
print('Cross-confirmation capital vs time_series raw at 5 nodes (max|delta|):', maxd)

cap_win['SymCapital'] = cap_win[['HatchetSword','Dagger','HouseSize']].mean(axis=1)
cap_win['t'] = -cap_win['BCE']
cap_win.to_csv('/workspace/analysis/analytical_frame.csv', index=False)

def slope100(t, y): return np.polyfit(t, y, 1)[0] * 100.0
focal = ['HatchetSword','Dagger','HouseSize','SymCapital','MonumentCount','AxesCelts','MonumentSize']
g = cap_win.sort_values('t').reset_index(drop=True)
t = g['t'].values.astype(float)
delta, slope = {}, {}
for k in focal:
    y = g[k].values.astype(float)
    delta[k] = y[-1] - y[0]
    slope[k] = slope100(t, y)
print('\nDelta and per-100-yr OLS slope:')
for k in focal:
    print(f'  {k:14s} Delta={delta[k]:+.4f}  slope/100y={slope[k]:+.4f}')

preds = ['HatchetSword','Dagger','HouseSize','SymCapital']
targets = ['MonumentCount','AxesCelts','MonumentSize']
rows = []
for tgt in targets:
    for pr in preds:
        x = cap_win[pr].values.astype(float); y = cap_win[tgt].values.astype(float)
        if np.nanstd(x) == 0 or np.nanstd(y) == 0:
            rp, rs = float('nan'), float('nan')
        else:
            rp, _ = stats.pearsonr(x, y); rs, _ = stats.spearmanr(x, y)
        rows.append({'target': tgt, 'predictor': pr, 'Pearson_r': round(rp, 4), 'Spearman_rho': round(rs, 4)})
corr_df = pd.DataFrame(rows)
corr_df.to_csv('/workspace/analysis/correlations.csv', index=False)
print('\nCorrelations (N=5):')
print(corr_df.to_string(index=False))

print('\nPer-transition sign agreement of Delta(target) vs Delta(SymCapital):')
diff = g[focal].diff()
sym_sign = np.sign(diff['SymCapital'].values[1:])
for tgt in targets:
    s_tgt = np.sign(diff[tgt].values[1:])
    agree = int(((sym_sign == s_tgt) & (sym_sign != 0)).sum())
    oppose = int(((sym_sign == -s_tgt) & (sym_sign != 0)).sum())
    zero = int(((sym_sign == 0) | (s_tgt == 0)).sum())
    print(f'  {tgt:14s}  agree={agree}  oppose={oppose}  zero={zero}')

# consolidated text summary
with open('/workspace/analysis/results_summary.txt', 'w', encoding='utf-8') as f:
    f.write('DiscoveryBench - Archaeology question\n')
    f.write('Q: Between 3400 BCE and 3000 BCE, how do MonumentCount and AxesCelts change with symbolic capital?\n\n')
    f.write('Symbolic-capital mapping (per task scoping): {HatchetSword, Dagger, HouseSize}\n')
    f.write('Targets: MonumentCount (monuments), AxesCelts (axes and celts)\n')
    f.write('Auxiliary monument indicator (not asked but plotted): MonumentSize\n\n')
    f.write('Cross-confirmation capital.csv vs time_series_data.csv raw at 5 nodes: max|delta|=0 across all nodes.\n\n')
    f.write('5-bin evidence (raw Z values, BCE older to younger):\n')
    f.write(cap_win.sort_values('BCE', ascending=False)[['BCE','HatchetSword','Dagger','HouseSize','SymCapital','MonumentCount','AxesCelts','MonumentSize']].to_string(index=False, float_format=lambda x: f'{x: .4f}'))
    f.write('\n\nDelta(3000 BCE - 3400 BCE) and per-100-yr OLS slope (Z-units):\n')
    for k in focal:
        f.write(f'  {k:14s}  Delta={delta[k]:+.4f}   slope/100y={slope[k]:+.4f}\n')
    f.write('\nCorrelations (N=5; convention: |r|>=0.7 strong, 0.5-0.7 moderate, <0.5 weak/null):\n')
    f.write(corr_df.to_string(index=False))
    f.write('\n\nNotes:\n  - Dagger is constant (-0.58 across all 5 bins) -> correlation undefined.\n  - HatchetSword varies by only 0.01 sigma at one bin -> its correlations are inflated artefacts.\n')
print('\nWrote results_summary.txt')


# ----- SVG trajectory plot (no matplotlib) -----
def fnum(x): return ('%.1f' % float(x))
def esc(s):  return str(s).replace('&','&').replace('<','<').replace('>','>')
W, H = 900, 560
ML, MR, MT, MB = 80, 30, 60, 110
PW = W - ML - MR; PH = H - MT - MB
ts_axis = g['t'].tolist()
ymin, ymax = -1.0, 3.0
def xpx(t): return ML + (t - ts_axis[0]) / (ts_axis[-1] - ts_axis[0]) * PW
def ypx(y): return MT + (1 - (y - ymin) / (ymax - ymin)) * PH
grid_ys = [round(y, 1) for y in np.arange(ymin, ymax + 0.001, 0.5)]
series = [
    ('MonumentCount', '#c0392b', 'o', 'MonumentCount (monuments)'),
    ('AxesCelts',     '#e67e22', 's', 'AxesCelts (axes & celts)'),
    ('MonumentSize',  '#7f8c8d', '^', 'MonumentSize (auxiliary)'),
    ('SymCapital',    '#2c3e50', 'D', 'Symbolic-capital composite'),
    ('HatchetSword',  '#1f77b4', '.', 'HatchetSword'),
    ('Dagger',        '#9467bd', '.', 'Dagger'),
    ('HouseSize',     '#17becf', '.', 'HouseSize'),
]
ls_map  = dict(MonumentCount='2.4', AxesCelts='2.4', SymCapital='2.4',
               MonumentSize='1.6', HatchetSword='1.0', Dagger='1.0', HouseSize='1.0')
dash_map = dict(MonumentCount='', AxesCelts='', SymCapital='',
                MonumentSize='5,4', HatchetSword='2,2', Dagger='2,2', HouseSize='2,2')
def marker(x, y, shape, color):
    s = 4.5
    if shape == 'o':
        return '<circle cx="' + fnum(x) + '" cy="' + fnum(y) + '" r="' + fnum(s) + '" fill="' + color + '" stroke="' + color + '" stroke-width="0.8"/>'
    if shape == 's':
        return '<rect x="' + fnum(x - s) + '" y="' + fnum(y - s) + '" width="' + fnum(2*s) + '" height="' + fnum(2*s) + '" fill="' + color + '" stroke="' + color + '" stroke-width="0.8"/>'
    if shape == '^':
        return '<polygon points="' + fnum(x) + ',' + fnum(y - s) + ' ' + fnum(x + s) + ',' + fnum(y + s) + ' ' + fnum(x - s) + ',' + fnum(y + s) + '" fill="' + color + '" stroke="' + color + '" stroke-width="0.8"/>'
    if shape == 'D':
        s2 = s / 3.0
        pts = [(x, y - s), (x + s, y - s2), (x + s, y + s2), (x, y + s), (x - s, y + s2), (x - s, y - s2)]
        return '<polygon points="' + ' '.join(fnum(p[0]) + ',' + fnum(p[1]) for p in pts) + '" fill="' + color + '" stroke="' + color + '" stroke-width="0.8"/>'
    if shape == '.':
        return '<circle cx="' + fnum(x) + '" cy="' + fnum(y) + '" r="3" fill="' + color + '"/>'
    return ''
parts = []
parts.append('<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 ' + str(W) + ' ' + str(H) + '" style="font-family: DejaVu Sans, Arial, sans-serif;">')
parts.append('<rect x="0" y="0" width="' + str(W) + '" height="' + str(H) + '" fill="white"/>')
parts.append('<text x="' + str(W/2) + '" y="28" font-size="16" font-weight="bold" text-anchor="middle" fill="#222">3400 BCE to 3000 BCE: monuments, axes and symbolic-capital proxies</text>')
parts.append('<text x="' + str(W/2) + '" y="48" font-size="11" text-anchor="middle" fill="#666">bin-centred Z-scores (N = 5); _inter series used only as visualisation reference</text>')
for gg in grid_ys:
    y = ypx(gg)
    parts.append('<line x1="' + str(ML) + '" y1="' + fnum(y) + '" x2="' + str(W - MR) + '" y2="' + fnum(y) + '" stroke="#e6e6e6" stroke-width="0.6"/>')
    parts.append('<text x="' + str(ML - 8) + '" y="' + fnum(y + 4) + '" font-size="10" text-anchor="end" fill="#666">' + ('%+d' % int(gg) if abs(gg - round(gg)) < 1e-6 else ('%+.1f' % gg)) + '</text>')
zy = ypx(0)
parts.append('<line x1="' + str(ML) + '" y1="' + fnum(zy) + '" x2="' + str(W - MR) + '" y2="' + fnum(zy) + '" stroke="#444" stroke-width="0.8"/>')
parts.append('<rect x="' + str(ML) + '" y="' + str(MT) + '" width="' + str(PW) + '" height="' + str(PH) + '" fill="none" stroke="#222" stroke-width="1"/>')
for _, r in g.iterrows():
    x = xpx(r['t'])
    parts.append('<line x1="' + fnum(x) + '" y1="' + str(MT + PH) + '" x2="' + fnum(x) + '" y2="' + str(MT + PH + 5) + '" stroke="#222" stroke-width="0.8"/>')
    parts.append('<text x="' + fnum(x) + '" y="' + str(MT + PH + 20) + '" font-size="10" text-anchor="middle" fill="#222">' + str(int(abs(r['t']))) + ' BCE</text>')
parts.append('<text x="' + str(ML + PW/2) + '" y="' + str(H - 45) + '" font-size="12" text-anchor="middle" fill="#222">time (older left to right; smaller to larger BCE magnitude = later)</text>')
parts.append('<text transform="translate(20,' + str(MT + PH/2) + ') rotate(-90)" font-size="12" text-anchor="middle" fill="#222">Z-score (deviation from indicator baseline)</text>')
for name, color, shape, _ in series:
    pts = list(zip(g['t'].tolist(), g[name].tolist()))
    d = 'M ' + ' L '.join(fnum(xpx(x)) + ',' + fnum(ypx(y)) for x, y in pts)
    parts.append('<path d="' + d + '" stroke="' + color + '" stroke-width="' + ls_map[name] + '" fill="none" stroke-dasharray="' + dash_map[name] + '" stroke-linecap="round" stroke-linejoin="round"/>')
    for x, y in pts:
        parts.append(marker(xpx(x), ypx(y), shape, color))
peak = g[g['BCE'] == 3200].iloc[0]
xA, yA = xpx(peak['t']), ypx(peak['AxesCelts'])
xT, yT = xpx(peak['t']) + 35, ypx(peak['AxesCelts']) - 65
parts.append('<line x1="' + fnum(xA) + '" y1="' + fnum(yA) + '" x2="' + fnum(xT + 8) + '" y2="' + fnum(yT + 20) + '" stroke="#444" stroke-width="0.7"/>')
parts.append('<text x="' + fnum(xT) + '" y="' + fnum(yT) + '" font-size="9.5" fill="#222">peak: monuments and axes at 3200 BCE</text>')
parts.append('<text x="' + fnum(xT) + '" y="' + fnum(yT + 12) + '" font-size="9.5" fill="#222">(symbolic-capital trough follows at 3100 BCE)</text>')
LX, LY = ML, MT + PH + 38; ncol = 4; cell_w = PW / ncol
for idx, (name, color, shape, lbl) in enumerate(series):
    row = idx // ncol; col = idx % ncol
    x = LX + col * cell_w + 6; y = LY + row * 16
    parts.append('<line x1="' + fnum(x) + '" y1="' + fnum(y) + '" x2="' + fnum(x + 22) + '" y2="' + fnum(y) + '" stroke="' + color + '" stroke-width="2" stroke-dasharray="' + dash_map[name] + '"/>')
    parts.append(marker(x + 11, y, shape, color))
    parts.append('<text x="' + fnum(x + 30) + '" y="' + fnum(y + 3) + '" font-size="10" fill="#222">' + lbl + '</text>')
parts.append('</svg>')
with open('/workspace/analysis/trajectory_plot.svg', 'w', encoding='utf-8') as f:
    f.write('\n'.join(parts))
print("Wrote /workspace/analysis/trajectory_plot.svg")
