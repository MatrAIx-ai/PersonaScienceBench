"""
CONSOLIDATED EXECUTED ANALYSIS
==============================
Question: How does incarceration affect the wealth of Black individuals
          based on their income levels?

Dataset : data/nls_incarceration_processed.csv (12,013 x 6)
   clean -> 10,114 rows (drop 1,899 dup rows, fix 'hipanic'->'hispanic')
   Black subsample n=2,465 (124 ever_jailed=1)

Pipeline:
  1. Clean
  2. Stratify within Black using TERCILES of W1985 (quintiles failed n>=30)
  3. Headline tables: medians of W1985/90/96, asinh growth, penalty by ter
  4. Secondary: sex-disaggregated medians, cross-race context

All outputs are associative / descriptive -- no causal claims.
All wealth values are USD (nominal); int64; negatives retained.
"""
import pandas as pd
import numpy as np
from pathlib import Path

DATA = Path('/workspace/data/nls_incarceration_processed.csv')
OUT  = Path('/workspace/artifacts/output')
OUT.mkdir(parents=True, exist_ok=True)

# ------------------------------ 1. CLEAN
df = pd.read_csv(DATA)
n0 = len(df)
df['race'] = df['race'].replace({'hipanic': 'hispanic'})
df = df.drop_duplicates().reset_index(drop=True)
n1 = len(df)
print(f"[clean] rows: {n0} -> {n1}  (dropped {n0-n1})")

# ------------------------------ 2. STRATA
black = df[df['race'] == 'black'].copy()
edges = np.quantile(black['composite_wealth_1985'], [1/3, 2/3])
print(f"[strata] Black-tertile cut-points on W1985 (USD): {edges}")

black['ter'] = np.where(black['composite_wealth_1985'] <= edges[0], 'T1 (lowest)',
               np.where(black['composite_wealth_1985'] <= edges[1], 'T2 (middle)', 'T3 (highest)'))

# Cell-size check (should all be >= ~30)
cells = pd.crosstab(black['ter'], black['ever_jailed'])
print(f"[cells] Black ter x ever_jailed:\n{cells}")

# asinh growth 1985->1996
for c in ['composite_wealth_1985','composite_wealth_1990','composite_wealth_1996']:
    black[f'a_{c[-4:]}'] = np.arcsinh(black[c])
black['dasinh_85_96'] = black['a_1996'] - black['a_1985']

# ------------------------------ 3. HEADLINE
g_med = black.groupby(['ter','ever_jailed'])['composite_wealth_1996'].median().unstack()
g_med.columns = ['med_j0','med_j1']
g_med['penalty_USD']  = (g_med['med_j1'] - g_med['med_j0']).round(0)
g_med['rel_penalty_%']= (100*g_med['penalty_USD']/g_med['med_j0']).round(1)
print("\n[headline 1] Median W1996 by ter x ever_jailed (Black) + penalty:")
print(g_med)

g_asinh = black.groupby(['ter','ever_jailed'])['dasinh_85_96'].mean().unstack()
g_asinh.columns = ['mean_asinh_growth_j0','mean_asinh_growth_j1']
g_asinh['penalty_asinh_units'] = (g_asinh['mean_asinh_growth_j1'] - g_asinh['mean_asinh_growth_j0']).round(3)
print("\n[headline 2] Asinh growth 1985->1996 by ter x ever_jailed (Black) + penalty:")
print(g_asinh)

# Full median trajectory (W85, W90, W96)
traj_med = black.groupby(['ter','ever_jailed'])[['composite_wealth_1985','composite_wealth_1990','composite_wealth_1996']].median().round(0)
print("\n[headline 3] Median trajectory W85/W90/W96 (Black):")
print(traj_med)

g_med.to_csv(OUT/'black_W1996_penalty_by_ter.csv')
g_asinh.to_csv(OUT/'black_asinh_growth_penalty_by_ter.csv')
traj_med.to_csv(OUT/'black_median_trajectory_by_ter_jail.csv')

# ------------------------------ 4. SECONDARY
print("\n[secondary] Sex-disaggregated medians (Black):")
sx_med = black.groupby(['sex','ter','ever_jailed'])[['composite_wealth_1985','composite_wealth_1990','composite_wealth_1996']].median().round(0)
print(sx_med)
sx_med.to_csv(OUT/'black_sex_ter_jail_median.csv')

print("\n[secondary] Cross-race context (each race uses OWN tertile breakpoints):")
mem = []
for r in ['black','hispanic','white']:
    s = df[df['race']==r].copy()
    re = np.quantile(s['composite_wealth_1985'], [1/3, 2/3])
    s['ter'] = np.where(s['composite_wealth_1985']<=re[0],'T1 (lowest)',
                np.where(s['composite_wealth_1985']<=re[1],'T2 (middle)','T3 (highest)'))
    g = s.groupby(['ter','ever_jailed'])['composite_wealth_1996'].median().unstack()
    g.columns = ['med_j0','med_j1']
    g['race'] = r
    g['penalty_USD']  = (g['med_j1'] - g['med_j0']).round(0)
    g['rel_penalty_%']= (100*g['penalty_USD']/g['med_j0']).round(1)
    mem.append(g)
ctx = pd.concat(mem)
print(ctx)
ctx.to_csv(OUT/'context_by_race_ter_jailed.csv')

print("\n[done] artifacts written to:", OUT)
