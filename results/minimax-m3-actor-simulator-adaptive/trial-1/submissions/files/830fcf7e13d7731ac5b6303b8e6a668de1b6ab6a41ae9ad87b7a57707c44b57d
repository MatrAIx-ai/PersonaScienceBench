"""
PCA on the 12 capital Z-variables from capital.csv.
PC1 used to characterise MN (3400-3000 BCE) and Younger/SG (2900-2300 BCE).
"""
import json
import numpy as np
import pandas as pd

# 1) Load (German comma decimals)
cap = pd.read_csv('/workspace/data/capital.csv', decimal=',')
cap = cap.sort_values('BCE', ascending=True).reset_index(drop=True)
zcols = ['ZAxtSchwert','ZDolch','Zhausgr','ZCU_AU','Zamber','ZMonument',
         'ZHort','ZSichel','ZBeil','ZMW','ZKeform','Zkeverz']
xlabels = {
    'ZAxtSchwert':'Hatchets+Swords',
    'ZDolch':'Daggers',
    'Zhausgr':'House size',
    'ZCU_AU':'Copper+Gold',
    'Zamber':'Amber',
    'ZMonument':'Monument count',
    'ZHort':'Depot',
    'ZSichel':'Sickle',
    'ZBeil':'Axes+Celts',
    'ZMW':'Monument size',
    'ZKeform':'Pottery form',
    'Zkeverz':'Pottery decoration'
}
X = cap[zcols].to_numpy(dtype=float)
print(f'X shape: {X.shape}, any NaN: {np.isnan(X).any()}')
mu = X.mean(axis=0); sd = X.std(axis=0, ddof=1)
Zs = (X - mu) / sd

# 2) PCA on correlation matrix
C = np.corrcoef(Zs, rowvar=False)
eigvals, eigvecs = np.linalg.eigh(C)
eigvals = eigvals[::-1]; eigvecs = eigvecs[:, ::-1]
propvar = eigvals / eigvals.sum()
cumvar = np.cumsum(propvar)
loadings_raw = eigvecs * np.sqrt(eigvals)
pc1_raw = loadings_raw[:, 0]
sign = np.sign(pc1_raw[np.argmax(np.abs(pc1_raw))])
pc1_oriented = pc1_raw * sign
scores_raw = Zs @ pc1_raw
scores_oriented = scores_raw * sign

df_scores = pd.DataFrame({
    'BCE': cap['BCE'].astype(int),
    'group': cap['group'],
    'PC1_raw': scores_raw,
    'PC1_oriented': scores_oriented,
})
df_scores.to_csv('/workspace/artifacts/per_slice_PC1.csv', index=False)

# Loadings table (sorted desc by oriented loading)
load_table = pd.DataFrame({
    'variable': zcols,
    'label': [xlabels[c] for c in zcols],
    'loading_PC1_raw': pc1_raw,
    'loading_PC1_oriented': pc1_oriented,
}).sort_values('loading_PC1_oriented', ascending=False).reset_index(drop=True)
load_table.to_csv('/workspace/artifacts/loadings_PC1.csv', index=False)

# Eigenvalues table
ev = pd.DataFrame({
    'PC': np.arange(1, 13),
    'eigenvalue': eigvals,
    'variance_explained': propvar,
    'cumulative': cumvar,
})
ev.to_csv('/workspace/artifacts/eigenvalues.csv', index=False)

# Phases — NOTE: between is inclusive [left, right]; years run BCE so higher numbers are older
MN = df_scores[(df_scores['BCE'] >= 3000) & (df_scores['BCE'] <= 3400)].copy()
YN = df_scores[(df_scores['BCE'] >= 2300) & (df_scores['BCE'] <= 2900)].copy()

def summarise(d, name):
    s = d['PC1_oriented']
    return {
        'phase': name,
        'N_slices': int(len(s)),
        'BCE_min': int(d['BCE'].min()),
        'BCE_max': int(d['BCE'].max()),
        'mean': float(s.mean()),
        'sd': float(s.std(ddof=1)),
        'median': float(s.median()),
        'q1': float(s.quantile(0.25)),
        'q3': float(s.quantile(0.75)),
        'IQR': float(s.quantile(0.75) - s.quantile(0.25)),
        'min': float(s.min()),
        'max': float(s.max()),
        'min_BCE_year': int(d.loc[s.idxmin(),'BCE']),
        'max_BCE_year': int(d.loc[s.idxmax(),'BCE']),
    }

summary = pd.DataFrame([
    summarise(MN, 'Middle Neolithic (MN, 3400-3000 BCE)'),
    summarise(YN, 'Younger Neolithic / SG (2900-2300 BCE)'),
])
summary.to_csv('/workspace/artifacts/phase_summary.csv', index=False)

# Combined MN+YN per-slice table sorted oldest -> youngest
mn_yn = pd.concat([MN, YN]).sort_values('BCE', ascending=False).reset_index(drop=True)
mn_yn.to_csv('/workspace/artifacts/per_slice_PC1_MN_YN.csv', index=False)

# Save also raw scores in a separate file for sign-transparency
raw_scores_summary = pd.DataFrame({
    'BCE': cap['BCE'].astype(int),
    'group': cap['group'],
    'PC1_raw_sign_unspecified': scores_raw,   # raw eigendecomposition sign
    'PC1_oriented_largest_abs_loading_positive': scores_oriented,
})
raw_scores_summary.to_csv('/workspace/artifacts/per_slice_PC1_signs.csv', index=False)

# Print results
print()
print('=== Eigenvalues / variance ===')
print(ev.to_string(index=False))
print(f'\nPC1 explains {propvar[0]*100:.2f}%, PC1+PC2 = {cumvar[1]*100:.2f}%')
print()
print('=== PC1 loadings (oriented) ===')
print(load_table.to_string(index=False))
print(f'\nSign convention applied: sign = {sign:+.0f} '
      f'(largest |loading| = {load_table["loading_PC1_oriented"].abs().max():.4f} on '
      f'{load_table.iloc[0]["variable"]})')
print()
print('=== Phase summary ===')
print(summary.to_string(index=False))
print()
print('=== Compact MN + SG per-slice PC1 table ===')
print(mn_yn[['BCE','group','PC1_oriented']].to_string(index=False))

# MN vs YN t-test using scipy
from scipy import stats
print()
print('=== Welch t-test (PC1_oriented): MN vs Younger/SG ===')
t, p = stats.ttest_ind(MN['PC1_oriented'].values, YN['PC1_oriented'].values, equal_var=False)
print(f't = {t:.3f}, p = {p:.4g}, mean(MN)={MN["PC1_oriented"].mean():.3f}, '
      f'mean(YN)={YN["PC1_oriented"].mean():.3f}, '
      f'delta = {MN["PC1_oriented"].mean()-YN["PC1_oriented"].mean():.3f}')

from scipy.stats import spearmanr
print('\n=== Spearman ρ of each Z-column with PC1_oriented score ===')
for v in zcols:
    rho,_ = spearmanr(cap[v], df_scores['PC1_oriented'])
    print(f'  {v:>12}  ρ={rho:+.3f}')

# Also: the bce trend / sign of PC1 in raw direction (before sign flip)
print('\n=== sanity: if we DID NOT flip sign (raw eig sign), MN mean would be ===')
print(f'   MN raw mean = {MN["PC1_raw"].mean():.3f}, YN raw mean = {YN["PC1_raw"].mean():.3f}')
print('   i.e. raw eig sign makes Younger Neolithic MORE positive than MN; '
      'largest-loading-positive flips to make MN more positive.')
