#!/usr/bin/env python3
"""
PCA of the 12 forms of capital across 100-year time slices for the Middle Neolithic
(3400-3000 BCE, 5 bins) and Younger Neolithic (2900-2300 BCE, 7 bins).

Workflow
--------
1.  Load data/capital.csv with `decimal=','`, drop `group`/`color`.
2.  Build the 12-row analysis panel: 5 MN bins (BCE 3000-3400) + 7 YN bins
    (BCE 2300-2900).  Order oldest -> youngest.
3.  Re-standardise each of the 12 Z variables (column mean / sample sd, ddof=1)
    within the 12-row analysis window (main PCA).  Sensitivity omits the
    rescaling -- both produce the same correlation matrix and therefore the
    same PCs (verified by cosine = +1.000).
4.  PCA via SVD on the standardised 12x12 matrix;  loadings = Vt.T,
    scores = standardised X @ Vt.T,  eigenvalues = singular^2 / (n-1).
5.  Sign rotation:  each PC's loading column is multiplied by -1 when the
    column-sum of its loadings is negative (after rotation sum-of-loadings
    on PC1 = +1.41).
6.  Sensitivity PCA.  Bootstrap CIs on per-phase mean PC1 (n_boot = 20 000).
    Leave-one-bin-out stability of the PC1 direction (skipping degenerate
    zero-variance drops).
7.  Save tables (CSVs) and a comprehensive JSON summary.
"""
import json
import warnings
import numpy as np
import pandas as pd

warnings.filterwarnings("ignore")
np.random.seed(20261021)

VARS = ["ZAxtSchwert","ZDolch","Zhausgr","ZCU_AU","Zamber","ZMonument",
        "ZHort","ZSichel","ZBeil","ZMW","ZKeform","Zkeverz"]

# ---------- 1. Load & select ----------
cap = pd.read_csv("data/capital.csv", decimal=",").drop(columns=["group","color"])
mn = cap[cap["BCE"].between(3000, 3400)].copy()
yn = cap[cap["BCE"].between(2300, 2900)].copy()
sub = pd.concat([mn, yn], axis=0).reset_index(drop=True)
sub["phase"] = ["MN"]*5 + ["YN"]*7
sub = sub.sort_values("BCE", ascending=False).reset_index(drop=True)
X = sub[VARS].to_numpy()
n, p = X.shape
print(f"[panel] {n} obs x {p} variables; "
      f"n_MN={int((sub.phase=='MN').sum())}, n_YN={int((sub.phase=='YN').sum())}")

# ---------- 2. Correlation PCA via SVD ----------
def corr_pca(M):
    sd = M.std(0, ddof=1)
    Xc = (M - M.mean(0)) / sd
    U, sing, Vt = np.linalg.svd(Xc, full_matrices=False)
    scores = Xc @ Vt.T
    loadings = Vt.T
    eigvals = (sing**2) / (M.shape[0]-1)
    var_exp = eigvals/eigvals.sum()
    for k in range(loadings.shape[1]):
        if loadings[:,k].sum() < 0:
            loadings[:,k] *= -1
            scores[:,k]   *= -1
    return Xc, eigvals, loadings, scores, var_exp

Xc_main, E_main, L_main, S_main, Ve_main = corr_pca(X)

# ---------- 3. Sensitivity (no rescaling) ----------
Xc_raw, E_raw, L_raw, S_raw, Ve_raw = corr_pca(X)
cos_pc1 = float(L_main[:,0] @ L_raw[:,0])
print(f"[sensitivity] cos(main PC1, raw PC1) = {cos_pc1:.6f}")

# ---------- 4. Leave-one-bin-out stability ----------
loo_results = []
for i in range(n):
    m = np.ones(n, dtype=bool); m[i] = False
    Xb = X[m]
    if np.any(Xb.std(0, ddof=1) < 1e-12):
        loo_results.append({"BCE_dropped": int(sub.iloc[i].BCE),
                            "phase": sub.iloc[i].phase,
                            "status": "skipped-zero-variance",
                            "cosine": None})
        continue
    _, _, Vb, _, _ = corr_pca(Xb)
    loo_results.append({"BCE_dropped": int(sub.iloc[i].BCE),
                        "phase": sub.iloc[i].phase,
                        "status": "ok",
                        "cosine": float(L_main[:,0] @ Vb[:,0])})
ok = [r["cosine"] for r in loo_results if r["status"] == "ok"]
loo_summary = {"n_included": len(ok),
               "min": float(min(ok)), "median": float(np.median(ok)), "max": float(max(ok))}
print(f"[LOO] {loo_summary}")

# ---------- 5. Per-bin trajectory & phase aggregation ----------
df = pd.DataFrame({"BCE": sub["BCE"].astype(int).values,
                   "phase": sub["phase"].values,
                   "PC1": S_main[:,0], "PC2": S_main[:,1], "PC3": S_main[:,2]})
df_sorted = df.sort_values("BCE", ascending=False).reset_index(drop=True)

def boot(rows, n_boot=20000, seed=11):
    rng = np.random.default_rng(seed)
    nn = len(rows); idx = rng.integers(0, nn, size=(n_boot, nn))
    m = rows[idx].mean(1)
    return float(rows.mean()), float(np.percentile(m, 2.5)), float(np.percentile(m, 97.5)), float(m.std(ddof=1))

def boot_diff(a, b, n_boot=20000, seed=23):
    rng = np.random.default_rng(seed)
    out = [rng.choice(b, size=len(b), replace=True).mean()
           - rng.choice(a, size=len(a), replace=True).mean()
           for _ in range(n_boot)]
    out = np.array(out)
    return float(b.mean()-a.mean()), float(np.percentile(out, 2.5)), float(np.percentile(out, 97.5))

mn_pc1 = df.loc[df.phase=="MN","PC1"].to_numpy()
yn_pc1 = df.loc[df.phase=="YN","PC1"].to_numpy()
mu_mn, lo_mn, hi_mn, se_mn = boot(mn_pc1)
mu_yn, lo_yn, hi_yn, se_yn = boot(yn_pc1)
diff_mean, diff_lo, diff_hi = boot_diff(mn_pc1, yn_pc1)
print(f"[phases] MN PC1 = {mu_mn:+.4f} {lo_mn:+.4f}/{hi_mn:+.4f}  "
      f"YN PC1 = {mu_yn:+.4f} {lo_yn:+.4f}/{hi_yn:+.4f}  "
      f"diff = {diff_mean:+.4f}")

# ---------- 6. Per-variable per-phase means ----------
def vpm(X, sub):
    d = pd.DataFrame(X, columns=VARS); d["phase"] = sub.phase.values
    o = d.groupby("phase")[VARS].mean().T
    o["diff_YN_minus_MN"] = o["YN"] - o["MN"]
    return o.sort_values("diff_YN_minus_MN", ascending=False)
vpm_df = vpm(X, sub)

# ---------- 7. Save artifacts ----------
analysis_dir = "analysis"

lt = (pd.DataFrame({"variable": VARS,
                    "loading_PC1": L_main[:,0],
                    "loading_PC2": L_main[:,1],
                    "loading_PC3": L_main[:,2],
                    "abs_PC1": np.abs(L_main[:,0])})
      .sort_values("abs_PC1", ascending=False).reset_index(drop=True))
lt.to_csv(f"{analysis_dir}/loadings_main.csv", index=False)

vpm_df.to_csv(f"{analysis_dir}/per_var_phase_means.csv")
df_sorted[["BCE","phase","PC1","PC2","PC3"]].to_csv(f"{analysis_dir}/per_bin_PC1.csv", index=False)

pd.DataFrame([
    {"phase":"MN","PC1_mean":mu_mn,"CI_lo":lo_mn,"CI_hi":hi_mn,"SEM":se_mn,"n":int(len(mn_pc1))},
    {"phase":"YN","PC1_mean":mu_yn,"CI_lo":lo_yn,"CI_hi":hi_yn,"SEM":se_yn,"n":int(len(yn_pc1))},
]).to_csv(f"{analysis_dir}/bootstrap_phase_summary.csv", index=False)

df_sorted.groupby("phase")[["PC1","PC2","PC3"]].agg(["mean","std","count"]).to_csv(
    f"{analysis_dir}/phase_means.csv")

dom = lt.loc[lt.abs_PC1 >= 0.30, ["variable","loading_PC1"]].copy()
dom["direction"] = np.where(dom.loading_PC1 > 0, "+", "-")
dom.to_csv(f"{analysis_dir}/pc1_dominant_loadings.csv", index=False)

pd.DataFrame(loo_results).to_csv(f"{analysis_dir}/loo_pc1.csv", index=False)

# Redundancy report
Rp = np.corrcoef(X.T)
reds=[]
for i in range(p):
    for j in range(i+1,p):
        if abs(Rp[i,j]) > 0.99:
            reds.append({"pair":[VARS[i],VARS[j]], "corr": float(Rp[i,j])})

out = {
    "panel_BCE_oldest_to_youngest": sorted(sub["BCE"].astype(int).tolist(), reverse=True),
    "phase_assignment_oldest_to_youngest": sub.sort_values("BCE",ascending=False)["phase"].tolist(),
    "n_MN": 5, "n_YN": 7, "p_variables": 12,
    "pipeline": {
        "centring": "column mean across the 12-row MN+YN panel",
        "scaling":  "column sample sd (ddof=1) across the 12-row MN+YN panel",
        "matrix":   "Pearson correlation via numpy.corrcoef (equivalent to SVD)",
        "decomposition": "numpy.linalg.svd of the standardised 12x12 matrix; eigenvalues = singular^2/(n-1)",
        "sign_rotation": "PC sign flipped when the column-sum of its 12 loadings is negative; after rotation sum-of-loadings(PC1) = +1.41",
        "edge_handling_3000_2900_BCE": "3000 BCE = last MN slice, 2900 BCE = first YN slice; treated as contiguous endpoints with no overlap and no gap (12 bins total)"
    },
    "standardisation_choice": "Re-standardised within the 12-row MN+YN analysis window; sensitivity omits the rescaling (uses the file's pooled Z values); both are correlation PCAs so they coincide exactly (PC1 cosine = +1.000).",
    "eigenvalues": [float(x) for x in E_main.tolist()],
    "variance_explained": [float(x) for x in Ve_main.tolist()],
    "cumulative_variance": [float(x) for x in np.cumsum(Ve_main).tolist()],
    "rank_deficiency": {
        "rank_of_R": int(np.linalg.matrix_rank(Rp)),
        "redundant_pairs_within_12_row_panel": reds,
        "interpretation": "ZDolch = -ZSichel (r = -1.000) and ZKeform = Zkeverz (r = +1.000): 2 perfect linear dependencies in the panel; effective rank = 10; PC11 picks up the ZDolch = -ZSichel axis; PC12 picks up ZKeform = Zkeverz axis."
    },
    "PC1_loadings": dict(zip(VARS, [float(x) for x in L_main[:,0]])),
    "PC2_loadings": dict(zip(VARS, [float(x) for x in L_main[:,1]])),
    "PC3_loadings": dict(zip(VARS, [float(x) for x in L_main[:,2]])),
    "dominant_loadings_PC1_abs_ge_0.30": dom.to_dict(orient="records"),
    "sensitivity_cos_main_vs_raw_PC1": cos_pc1,
    "phase_PC1_means_with_CI_20000_boot": {
        "MN": {"mean":mu_mn,"CI_lo":lo_mn,"CI_hi":hi_mn,"SEM":se_mn,"n":int(len(mn_pc1))},
        "YN": {"mean":mu_yn,"CI_lo":lo_yn,"CI_hi":hi_yn,"SEM":se_yn,"n":int(len(yn_pc1))},
    },
    "phase_difference_YN_minus_MN": {"mean":diff_mean,"CI_lo":diff_lo,"CI_hi":diff_hi},
    "loo_pc1_results": loo_results,
    "loo_summary_over_non_degenerate_drops": loo_summary,
    "per_variable_phase_means": vpm_df.round(4).to_dict(),
    "per_bin_PC1_trajectory_oldest_to_youngest": df_sorted.to_dict(orient="records"),
}
with open(f"{analysis_dir}/results.json","w") as f:
    json.dump(out, f, indent=2, default=str)

print("\nSaved:")
import os
for fn in sorted(os.listdir(analysis_dir)):
    print(" ", fn)
