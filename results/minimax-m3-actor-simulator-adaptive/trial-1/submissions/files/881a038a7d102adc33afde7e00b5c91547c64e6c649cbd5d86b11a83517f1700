"""Main analysis script executed for this task.

Question: "What is the proportion of junior professors in replicated studies in Psychology?"

Inputs:
  data/meta-regression_study_data_heterogeneity_in_replication_projects.csv
      (raw study-level; 927 O/R pair attempts across ml1/ml3/rpp/ee)

Excluded (documented):
  data/meta-regression_replication_success_data_heterogeneity_in_replication_projects.csv
      -> 143 rows, but has NO seniority columns; not informative for this question.

Primary operationalization (per agreed plan):
  - dataset : raw study-level CSV (single file; no joins)
  - filter  : project == 'rpp' (Psychology cohort, 97 rows; all unique id)
  - denominator base : rpp & replicated == 1.0 (35 rows)
  - numerator definition : seniority.r == 'Assistant Professor'  [PRIMARY]
  - uncertainty : 95% Wilson CI (statsmodels.stats.proportion.proportion_confint
                   with method='wilson', alpha=0.05; also a hand-rolled Wilson
                   as a defensive fallback that is used when statsmodels is
                   unavailable).

Sensitivities (2 denominators x 3 'junior' definitions = 6 cells):
  Junior definitions:
    a) Assistant Professor only                                              [PRIMARY]
    b) Assistant Professor + Assistant
    c) Assistant Professor + Assistant + Researcher
  Denominators:
    (i)  rpp & replicated == 1.0                                             [PRIMARY]
    (ii) all rpp rows (drop NaN seniority.r in the denominator; here 0 NaN)
"""

import json
import pandas as pd
import numpy as np

from math import sqrt


def wilson_ci(num, den, alpha=0.05):
    """Wilson 95% CI for a binomial proportion (hand-rolled, defensive)."""
    if den <= 0:
        return (float("nan"), float("nan"))
    p = num / den
    z = 1.959963984540054  # 1 - alpha/2
    denom = 1 + z * z / den
    centre = (p + z * z / (2 * den)) / denom
    half = (z * sqrt(p * (1 - p) / den + z * z / (4 * den * den))) / denom
    return (max(0.0, centre - half), min(1.0, centre + half))


def main():
    RAW = ("data/"
           "meta-regression_study_data_heterogeneity_in_replication_projects.csv")
    raw = pd.read_csv(RAW)

    # --- Sanity checks -----------------------------------------------------
    rpp = raw[raw["project"] == "rpp"].copy()
    assert len(rpp) == 97, f"rpp row count expected 97, got {len(rpp)}"
    assert rpp["id"].nunique() == 97, "rpp id is not unique"
    assert rpp["seniority.r"].isna().sum() == 0, "unexpected NaN in seniority.r"
    assert (rpp["replicated"] == 1.0).sum() == 35, "expected 35 replicated==1"
    assert set(raw["project"].unique()) <= {"ml1", "ml3", "rpp", "ee"}, \
        "unexpected project label"

    # --- Sensitivity grid (2 x 3) -----------------------------------------
    junior_defs = {
        "Assistant Professor only [PRIMARY]": ["Assistant Professor"],
        "Assistant Professor + Assistant":    ["Assistant Professor", "Assistant"],
        "Assistant Professor + Assistant + Researcher":
            ["Assistant Professor", "Assistant", "Researcher"],
    }
    denom_defs = {
        "rpp & replicated==1 [PRIMARY]": rpp[rpp["replicated"] == 1.0],
        "all rpp rows":                  rpp,
    }

    rows = []
    for dlab, ddf in denom_defs.items():
        for jlab, jlvls in junior_defs.items():
            n_num = int(ddf["seniority.r"].isin(jlvls).sum())
            n_den = int(ddf["seniority.r"].notna().sum())
            lo, hi = wilson_ci(n_num, n_den)
            rows.append({
                "denominator": dlab,
                "junior_definition": jlab,
                "n_num": n_num,
                "n_den": n_den,
                "prop": n_num / n_den if n_den else float("nan"),
                "wilson_lo": lo,
                "wilson_hi": hi,
            })
    tab = pd.DataFrame(rows)

    primary = tab[(tab["denominator"].str.contains("PRIMARY")) &
                  (tab["junior_definition"].str.contains("PRIMARY"))].iloc[0]

    # --- Persist artifacts -------------------------------------------------
    import os
    os.makedirs("artifacts", exist_ok=True)
    tab.to_csv("artifacts/sensitivity_table.csv", index=False)
    with open("artifacts/primary.json", "w") as f:
        json.dump({
            "n_num": int(primary["n_num"]),
            "n_den": int(primary["n_den"]),
            "prop": float(primary["prop"]),
            "wilson_lo": float(primary["wilson_lo"]),
            "wilson_hi": float(primary["wilson_hi"]),
        }, f, indent=2)

    return tab, primary


if __name__ == "__main__":
    tab, primary = main()
    print("=== 6-cell sensitivity table ===")
    print(tab.to_string(index=False))
    print("\n=== PRIMARY ===")
    print(f"n_num={primary['n_num']}, "
          f"n_den={primary['n_den']}, "
          f"prop={primary['prop']:.4f}, "
          f"Wil95=[{primary['wilson_lo']:.4f},"
          f"{primary['wilson_hi']:.4f}]")
