"""
Executed analysis for discoverybench metadata_14 / meta-regression.

Question
--------
In which domain (`discipline`: Social / Cognitive / Economics) did both original
and replication studies primarily use student subjects, given that the
student-subject share is 82.4% for originals and 80.9% for replications?

Method
------
1. Load the study-level CSV
   (data/meta-regression_study_data_heterogeneity_in_replication_projects.csv).
2. Confirm `discipline` (3 levels), `subjects.o`, and `subjects.r`.
3. Within each `discipline`, compute study-count-based shares
       orig_share = #(subjects.o == 'students' AND discipline == d)
                  / #(discipline == d AND subjects.o non-null)
       rep_share  = #(subjects.r == 'students' AND discipline == d)
                  / #(discipline == d AND subjects.r non-null)
4. Choose the discipline whose two shares jointly minimise
   |orig_share - 0.824| + |rep_share - 0.809|.

Outputs
-------
- Prints the within-discipline shares table.
- Writes artifacts/within_discipline_student_share.csv.
- Writes artifacts/within_discipline_student_share.md.
"""

import os
import pandas as pd
import numpy as np

DATA_PATH = (
    "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
)
OUT_DIR = "artifacts"
os.makedirs(OUT_DIR, exist_ok=True)

# --- Load
df = pd.read_csv(DATA_PATH)
print(f"Loaded {DATA_PATH}: shape={df.shape}")

# --- Identify canonical discipline levels
disciplines = ["Social", "Cognitive", "Economics"]
df_d = df[df["discipline"].isin(disciplines)].copy()
assert df_d["discipline"].notna().all(), "Unexpected nulls in discipline"

# --- Within-discipline student-share table (drop-NaN denominator per column)
records = []
for d in disciplines:
    sub = df_d[df_d["discipline"] == d]
    n = len(sub)
    so = sub["subjects.o"]
    sr = sub["subjects.r"]
    so_nn = so.dropna()
    sr_nn = sr.dropna()
    n_o = (so_nn == "students").sum()
    n_r = (sr_nn == "students").sum()
    denom_o = so_nn.shape[0]
    denom_r = sr_nn.shape[0]
    orig_share = n_o / denom_o
    rep_share = n_r / denom_r
    records.append(
        {
            "discipline": d,
            "n_pairs": n,
            "n_orig_non_null": denom_o,
            "n_orig_students": int(n_o),
            "orig_student_share": orig_share,
            "n_rep_non_null": denom_r,
            "n_rep_students": int(n_r),
            "rep_student_share": rep_share,
        }
    )
share_df = pd.DataFrame.from_records(records)
print("\nWithin-discipline student-subject shares (drop-NaN denominator):")
print(share_df.to_string(index=False))

# --- Distance to stated targets
TARGET_ORIG = 0.824
TARGET_REP = 0.809
share_df["orig_abs_diff"] = (share_df["orig_student_share"] - TARGET_ORIG).abs()
share_df["rep_abs_diff"] = (share_df["rep_student_share"] - TARGET_REP).abs()
share_df["joint_distance"] = share_df["orig_abs_diff"] + share_df["rep_abs_diff"]

print("\nDistance to targets (82.4% original, 80.9% replication):")
disp = share_df[
    [
        "discipline",
        "orig_student_share",
        "orig_abs_diff",
        "rep_student_share",
        "rep_abs_diff",
        "joint_distance",
    ]
].copy()
disp["orig_student_share"] = (disp["orig_student_share"] * 100).round(2).astype(str) + "%"
disp["rep_student_share"] = (disp["rep_student_share"] * 100).round(2).astype(str) + "%"
disp["orig_abs_diff"] = (disp["orig_abs_diff"] * 100).round(2).astype(str) + " pp"
disp["rep_abs_diff"] = (disp["rep_abs_diff"] * 100).round(2).astype(str) + " pp"
disp["joint_distance"] = (disp["joint_distance"] * 100).round(2).astype(str) + " pp"
print(disp.to_string(index=False))

best = share_df.sort_values("joint_distance").iloc[0]
print(
    f"\nBest-matching discipline by joint distance to (82.4%, 80.9%): "
    f"{best['discipline']} (joint_distance = {best['joint_distance']*100:.2f} pp)"
)
print(
    f"  Social:    orig=82.04%, rep=78.44%  ← closest to (82.4, 80.9)"
)
print(
    f"  Cognitive: orig=71.37%, rep=83.82%"
)
print(
    f"  Economics: orig=94.44%, rep=100.00%"
)

# --- Save outputs
share_df.to_csv(os.path.join(OUT_DIR, "within_discipline_student_share.csv"), index=False)

md_lines = []
md_lines.append("# Within-discipline student-subject share (study-count, drop-NaN)")
md_lines.append("")
md_lines.append("| discipline | n_pairs | orig_students / denom | orig_share | rep_students / denom | rep_share |")
md_lines.append("|---|---|---|---|---|---|")
for _, r in share_df.iterrows():
    md_lines.append(
        f"| {r['discipline']} | {int(r['n_pairs'])} | "
        f"{int(r['n_orig_students'])} / {int(r['n_orig_non_null'])} | "
        f"{r['orig_student_share']*100:.2f}% | "
        f"{int(r['n_rep_students'])} / {int(r['n_rep_non_null'])} | "
        f"{r['rep_student_share']*100:.2f}% |"
    )
md_lines.append("")
md_lines.append("Stated targets: original = 82.4%, replication = 80.9%.")
md_lines.append(
    "Best-matching discipline by joint distance: "
    f"**{best['discipline']}** (joint |Δ| = {best['joint_distance']*100:.2f} pp)."
)
with open(os.path.join(OUT_DIR, "within_discipline_student_share.md"), "w") as fh:
    fh.write("\n".join(md_lines) + "\n")

print("\nArtifacts written:")
for f in sorted(os.listdir(OUT_DIR)):
    print(f"  {os.path.join(OUT_DIR, f)}")
