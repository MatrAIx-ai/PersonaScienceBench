import pandas as pd
import numpy as np
from scipy.stats import pearsonr, spearmanr

df = pd.read_csv('/workspace/data/nls_bmi_processed.csv')
print("=== Shape ===")
print(df.shape)
print("\n=== Dtypes ===")
print(df.dtypes)
print("\n=== Head (first 5) ===")
print(df.head(5).to_string())
print("\n=== Tail (last 5) ===")
print(df.tail(5).to_string())
print("\n=== Missing per col ===")
print(df.isna().sum())
print("AGE n/a:", int(df['AGE'].isna().sum()), "DISSAVED n/a:", int(df['DISSAVED'].isna().sum()))

print("\n=== AGE describe ===")
print(df['AGE'].describe())
print(f"Min={df['AGE'].min()}, Median={df['AGE'].median()}, Max={df['AGE'].max()}")

bins=[14,24,34,44,54,200]
labels=['15-24','25-34','35-44','45-54','55+']
age_bin = pd.cut(df['AGE'], bins=bins, labels=labels, right=True)
print("\n=== Share in working-age bins ===")
print((age_bin.value_counts(sort=False)/len(df)*100).round(2).astype(str)+'%')

print("\n=== DISSAVED balance ===")
print(df['DISSAVED'].value_counts(dropna=False))
print(f"Share DISSAVED=1: {df['DISSAVED'].mean():.4f}")

r_age, p_age = pearsonr(df['AGE'], df['DISSAVED'])
r_age2, p_age2 = pearsonr(df['AGE_2'], df['DISSAVED'])
rs_age, _ = spearmanr(df['AGE'], df['DISSAVED'])
r_income, _ = pearsonr(df['INCOME'], df['DISSAVED'])
r_age_age2 = pearsonr(df['AGE'], df['AGE_2'])[0]
print("\n=== Correlations with DISSAVED (point-biserial = Pearson for binary y) ===")
print(f"Pearson(AGE, DISSAVED) = {r_age:.4f}  p={p_age:.3e}")
print(f"Pearson(AGE_2, DISSAVED) = {r_age2:.4f}  p={p_age2:.3e}")
print(f"Spearman(AGE, DISSAVED) = {rs_age:.4f}")
print(f"Pearson(INCOME, DISSAVED) = {r_income:.4f}")
print(f"Pearson(AGE, AGE_2) = {r_age_age2:.4f}  (collinearity sanity)")

print("\n=== DISSAVED rate by age bins ===")
out = df.groupby(age_bin, observed=True).agg(
    n=('DISSAVED','size'),
    dissaved_rate=('DISSAVED','mean'),
    median_age=('AGE','median'),
    median_income=('INCOME','median'),
    mean_income=('INCOME','mean'),
    share_female=('GENDER', lambda s: (s=='FEMALE').mean())
)
print(out.round(4).to_string())

print("\n=== DISSAVED rate by AGE quartiles ===")
q = pd.qcut(df['AGE'], 4, duplicates='drop')
out2 = df.groupby(q, observed=True).agg(
    q_low=('AGE','min'),
    q_high=('AGE','max'),
    n=('DISSAVED','size'),
    dissaved_rate=('DISSAVED','mean'),
    median_income=('INCOME','median')
)
print(out2.round(4).to_string())

print("\n=== DISSAVED by age bins × GENDER ===")
out3 = df.groupby([age_bin, 'GENDER'], observed=True).agg(
    n=('DISSAVED','size'),
    dissaved_rate=('DISSAVED','mean'),
    median_income=('INCOME','median')
)
print(out3.round(4).to_string())

print("\n=== Income tertiles: DISSAVED rate conditional on AGE quartile ===")
df['income_t'] = pd.qcut(df['INCOME'], 3, labels=['low','mid','high'])
out4 = df.groupby([q, 'income_t'], observed=True).agg(
    n=('DISSAVED','size'),
    dissaved_rate=('DISSAVED','mean')
)
print(out4.round(4).to_string())

print("\n=== SAMESAVE × DISSAVED crosstab ===")
print(pd.crosstab(df['SAMESAVE'], df['DISSAVED'], margins=True))
print("DISSAVED rate by SAMESAVE:")
print(df.groupby('SAMESAVE')['DISSAVED'].mean().round(4).to_string())

print("\n=== BMI ===")
print(df['BMI'].describe()[['min','25%','50%','75%','max']].to_string())
print(f"Pearson(BMI, DISSAVED)={pearsonr(df['BMI'], df['DISSAVED'])[0]:.4f}")
print("\nDISSAVED by BLACK/HISPANIC:")
print(df.groupby(['BLACK','HISPANIC'])['DISSAVED'].agg(['count','mean']).round(4).to_string())

print("\n=== GENDER balance ===")
print(df['GENDER'].value_counts())
print("\n=== INCOME describe ===")
print(df['INCOME'].describe()[['min','25%','50%','75%','max']].to_string())
