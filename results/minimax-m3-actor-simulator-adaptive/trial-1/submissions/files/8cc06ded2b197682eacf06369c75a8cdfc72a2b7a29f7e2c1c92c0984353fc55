"""Fix loadings.csv domain labels and produce plots."""
import json
from pathlib import Path
import numpy as np
import pandas as pd
import matplotlib
matplotlib.use("Agg")
import matplotlib.pyplot as plt

OUT = Path("/workspace/artifacts")
summary = json.loads((OUT/"analysis_summary.json").read_text())

# Canonical domain mapping (German Z-name -> domain)
DOMAIN_OF = {
    "ZAxtSchwert":"Symbolic", "ZDolch":"Symbolic", "Zhausgr":"Symbolic",
    "ZCU_AU":"Social", "Zamber":"Social", "ZMonument":"Social",
    "ZKeform":"Cultural", "Zkeverz":"Cultural",
    "ZHort":"Economic", "ZSichel":"Economic", "ZBeil":"Economic", "ZMW":"Economic",
}

loadings = pd.read_csv(OUT/"loadings.csv")
loadings["domain"] = loadings["variable"].map(DOMAIN_OF)
assert loadings["domain"].notna().all()
loadings.to_csv(OUT/"loadings.csv", index=False)

# Sync the summary JSON
summary["PC1_loadings_oriented_sum_positive"] = {
    v: float(l) for v, l in zip(loadings["variable"], loadings["PC1_loading"])
}
summary["PC1_loadings_domain_oriented"] = {
    row["variable"]: {"domain": row["domain"], "loading": float(row["PC1_loading"])}
    for _, row in loadings.iterrows()
}
(OUT/"analysis_summary.json").write_text(json.dumps(summary, indent=2))

print("loadings.csv fixed:")
print(loadings.to_string(index=False))

# Phase data
phase_summary = pd.read_csv(OUT/"phase_summary.csv")
cent = pd.read_csv(OUT/"pc1_centennial_scores.csv")

# Plot 1: PC1 score over BCE with MN/YN windows shaded
fig, ax = plt.subplots(figsize=(11, 5))
cent_sorted = cent.sort_values("BCE", ascending=False)
bce = cent_sorted["BCE"].to_numpy()
pc1 = cent_sorted["PC1_corr"].to_numpy()
groups = cent_sorted["group"].to_numpy()
ax.plot(bce, pc1, "-o", color="steelblue", lw=1.6, ms=4, label="PC1 score (correlation PCA)")
# shade MN
mn_bce = cent_sorted.loc[cent_sorted["group"]=="MN","BCE"]
ax.axvspan(mn_bce.min(), mn_bce.max(), alpha=0.20, color="aqua",    label="Middle Neolithic (3400–3000 BCE)")
yn_bce = cent_sorted.loc[cent_sorted["group"]=="SG","BCE"]
ax.axvspan(yn_bce.min(), yn_bce.max(), alpha=0.20, color="orange",  label="Younger Neolithic (2900–2300 BCE)")
ax.invert_xaxis()
ax.axhline(0, color="grey", lw=0.8, ls="--")
ax.set_xlabel("BCE (older →)")
ax.set_ylabel("PC1 score (oriented: higher = greater capital)")
ax.set_title("PC1 of the 12 Z-valued forms-of-capital, 100-year slices (capital.csv)")
ax.legend(loc="best", fontsize=8)
fig.tight_layout()
fig.savefig(OUT/"fig_pc1_timeline.png", dpi=140)
plt.close(fig)

# Plot 2: domain-mean Z values for MN vs YN
fig, ax = plt.subplots(figsize=(8,4.5))
dom = ["Symbolic","Social","Cultural","Economic"]
mn_means = [float(phase_summary.loc[phase_summary["phase"].str.startswith("Middle"), f"meanZ_{d}"].iloc[0]) for d in dom]
yn_means = [float(phase_summary.loc[phase_summary["phase"].str.startswith("Younger"), f"meanZ_{d}"].iloc[0]) for d in dom]
x = np.arange(len(dom)); w = 0.36
ax.bar(x - w/2, mn_means, width=w, color="aqua",   label="Middle Neolithic")
ax.bar(x + w/2, yn_means, width=w, color="orange", label="Younger Neolithic")
ax.set_xticks(x); ax.set_xticklabels(dom)
ax.axhline(0, color="grey", lw=0.8, ls="--")
ax.set_ylabel("mean Z across domain variables")
ax.set_title("Domain-mean Z-values: Middle vs Younger Neolithic")
ax.legend()
fig.tight_layout()
fig.savefig(OUT/"fig_domain_means.png", dpi=140)
plt.close(fig)

# Plot 3: PC1 loadings bar chart with domain-coloured bars
fig, ax = plt.subplots(figsize=(10,5))
col = {"Symbolic":"#1f77b4","Social":"#ff7f0e","Cultural":"#2ca02c","Economic":"#d62728"}
ordered = loadings.sort_values("PC1_loading", key=lambda s: s.abs(), ascending=False)
colors = [col[d] for d in ordered["domain"]]
ax.barh(ordered["variable"], ordered["PC1_loading"], color=colors)
ax.axvline(0, color="grey", lw=0.8)
ax.set_xlabel("PC1 loading (oriented sum>0)")
ax.set_title("PC1 loadings on the 12 capital variables")
from matplotlib.patches import Patch
handles = [Patch(facecolor=col[d], label=d) for d in ["Symbolic","Social","Cultural","Economic"]]
ax.legend(handles=handles, fontsize=8)
fig.tight_layout()
fig.savefig(OUT/"fig_loadings.png", dpi=140)
plt.close(fig)

# Plot 4: PC1 vs SMOOTH_MEAN_100y pollen openness (at the 12 BCE marks)
pal = pd.read_csv(OUT/"pollen_pc1_alignment.csv")
fig, ax = plt.subplots(figsize=(7,5))
ax.scatter(pal["PC1_corr"], pal["SMOOTH_MEAN_100y"], color="darkgreen")
for _, r in pal.iterrows():
    ax.annotate(f"{int(r['BCE'])}", (r["PC1_corr"], r["SMOOTH_MEAN_100y"]),
                textcoords="offset points", xytext=(5,3), fontsize=8)
ax.set_xlabel("PC1 score (centennial capital PCA)")
ax.set_ylabel("SMOOTH_MEAN_100y pollen openness")
ax.set_title("PC1 vs SMOOTH_MEAN_100y at 12 BCE marks  (supplementary)")
# overlay best fit
m, b = np.polyfit(pal["PC1_corr"], pal["SMOOTH_MEAN_100y"], 1)
xs = np.linspace(pal["PC1_corr"].min()-0.1, pal["PC1_corr"].max()+0.1, 50)
ax.plot(xs, m*xs + b, color="grey", lw=0.8, ls="--")
fig.tight_layout()
fig.savefig(OUT/"fig_pc1_vs_pollen.png", dpi=140)
plt.close(fig)

print("Plots saved:")
for f in sorted(OUT.glob("fig_*.png")):
    print(" ", f)
print("\nFinal fix_OK")
