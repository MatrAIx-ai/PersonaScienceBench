"""Inspection script for the NLSY79 wealth-by-cohort task.

Reads /workspace/data/nls_raw.csv (already placed by task harness) and reports:
  - file shape and column-presence checks
  - racial/ethnic cohort value distribution
  - sample sizes per cohort x wealth wave (1985, 1990, 1996)
  - overall missingness per wealth wave
  - sign-mix (negative / zero / positive) for each wealth column
  - complete-case panel retention per cohort across all three waves

This script is read-only with respect to the data file and produces no outputs
of its own; any downstream analysis will reuse these column names verbatim.
"""
import pandas as pd

CSV = "/workspace/data/nls_raw.csv"

COHORT = "Racial/ethnic cohort, 1979"
WEALTH = {
    "1985": "Family net wealth, 1985",
    "1990": "Family net wealth, 1990",
    "1996": "Family net wealth, 1996 (key data point)",
}
ID = "ID# (range 1-12686) 1979"


def main() -> None:
    df = pd.read_csv(CSV, low_memory=False)
    print(f"shape: {df.shape}")
    print(f"unique IDs: {df[ID].nunique()}")

    # column-presence checks
    for k in [COHORT, *WEALTH.values()]:
        assert k in df.columns, f"missing column: {k}"

    print("\nCohort distribution (1979):")
    print(df[COHORT].value_counts(dropna=False).sort_index())

    print("\nPer-wave missingness (all cohorts combined):")
    for y, col in WEALTH.items():
        n_miss = df[col].isna().sum()
        print(f"  {y}: non-null={df[col].notna().sum():>6}  "
              f"missing={n_miss:>6}  pct={n_miss/len(df)*100:.2f}%")

    print("\nPer-cohort x per-year non-null wealth counts:")
    for y, col in WEALTH.items():
        ctab = pd.crosstab(df[COHORT], df[col].notna(), margins=True)
        print(f"\n  --- {y} ({col}) ---")
        print(ctab)

    print("\nSign-mix per wealth column:")
    for y, col in WEALTH.items():
        s = df[col].dropna()
        print(f"  {y}: neg={(s<0).sum():>5}  zero={(s==0).sum():>5}  "
              f"pos={(s>0).sum():>5}  min={s.min():,.0f}  max={s.max():,.0f}")

    cc = df[WEALTH["1996"]].notna() & df[WEALTH["1990"]].notna() & df[WEALTH["1985"]].notna()
    print("\nComplete-case panel (all three waves non-null):")
    print(pd.crosstab(df[COHORT], cc, margins=True))


if __name__ == "__main__":
    main()
