"""
Identification analysis for DiscoveryBench episode
discoverybench:test/nls_ses/metadata_10.json/0/2

Question: The effect of which variable on BA degree completion decreases from
~0.3636 to ~-0.2293 (while becoming insignificant) when BOTH race and
academic characteristics are added to the analysis?

Approach (approved by researcher):
 - Outcome: BA DEGREE COMPLETED (Boolean -> 0/1).
 - Primary model: Linear Probability Model (OLS on 0/1), HC1 robust SE.
 - Parallel robustness: logistic regression with HC1 SE (log-odds, not
   expected to match the requested magnitudes -- confirmation only).
 - Reference categories: race = White; sex = Female.
 - Predictor blocks:
     social background (S)  : SES, sex_Male, FAMILY SIZE OF SAMPLE
     race (R)               : race_Black, race_Hispanic
     academic   (A)         : ABILITY: COMPOSITE OF ASVAB SCORE,
                              PERCENTILE IN CLASS
 - Models fit per candidate focal X in {SES, sex_Male, FAMILY SIZE OF SAMPLE}:
       A  : BA ~ X                                 (bivariate)
       A' : BA ~ SES + sex_Male + family_size      (social-background)
       B  : A' + race_Black + race_Hispanic
       C  : A' + ASVAB + Percentile
       D  : A' + race + academics   (FULL MODEL = baseline + BOTH blocks)
 - Iterate X across each candidate and record its coefficient/SE/p in each.

Outputs:
  artifacts/analysis/coefs_table.csv  -- the required table
  artifacts/analysis/coefs_logit.csv  -- logistic robustness
  artifacts/analysis/full_summary.txt -- readable summary
"""
import os
import warnings
import numpy as np
import pandas as pd
import statsmodels.api as sm

warnings.filterwarnings("ignore")

# ---------------------------------------------------------------------------
# 1. Load and prep
# ---------------------------------------------------------------------------
SRC = "data/nls_ses_processed.csv"
df = pd.read_csv(SRC)
if "Unnamed: 0" in df.columns:
    df = df.drop(columns=["Unnamed: 0"])

# Recode dummies (White ref, Female ref)
df["race_Black"]    = (df["SAMPLE_RACE"] == "Black").astype(int)
df["race_Hispanic"] = (df["SAMPLE_RACE"] == "Hispanic").astype(int)
df["sex_Male"]      = (df["SAMPLE_SEX"] == "Male").astype(int)
df["BA_int"]        = df["BA DEGREE COMPLETED"].astype(int)

print(f"N={len(df)}  BA rate={df['BA_int'].mean():.4f}  any NaN? {df.isna().any().any()}")

# Blocks
SOCAL_VARS = ["SES", "sex_Male", "FAMILY SIZE OF SAMPLE"]
RACE_VARS  = ["race_Black", "race_Hispanic"]
ACAD_VARS  = ["ABILITY: COMPOSITE OF ASVAB SCORE", "PERCENTILE IN CLASS"]

OUT_DIR = "artifacts/analysis"
os.makedirs(OUT_DIR, exist_ok=True)


def fit_ols(y, X):
    return sm.OLS(y, sm.add_constant(X, has_constant="add")).fit(cov_type="HC1")


def coef_row(model, var):
    return {
        "beta":   float(model.params[var]),
        "se_HC1": float(model.bse[var]),
        "p_two":  float(model.pvalues[var]),
    }


# ---------------------------------------------------------------------------
# 2. Fit models and assemble the table
# ---------------------------------------------------------------------------
y = df["BA_int"]

# Pre-fit one Model A' and one Model D (shared across focal X)
mod_A_social   = fit_ols(y, df[SOCAL_VARS])
mod_B_full_no_acad = fit_ols(y, df[SOCAL_VARS + RACE_VARS])
mod_C_full_no_race = fit_ols(y, df[SOCAL_VARS + ACAD_VARS])
mod_D_full     = fit_ols(y, df[SOCAL_VARS + RACE_VARS + ACAD_VARS])

rows = []
for X in SOCAL_VARS:
    # A: bivariate BA ~ X
    mod_A_biv = fit_ols(y, df[[X]])
    a = coef_row(mod_A_biv, X)
    rows.append({
        "focal_X": X, "model": "A_bivariate",
        "predictor_set": X,
        **{f"X_{k}": v for k, v in a.items()},
        "n_obs": int(mod_A_biv.nobs), "R2": round(mod_A_biv.rsquared, 5),
    })

    # A': social-background
    a = coef_row(mod_A_social, X)
    rows.append({
        "focal_X": X, "model": "Aprime_social_background",
        "predictor_set": "+".join(SOCAL_VARS),
        **{f"X_{k}": v for k, v in a.items()},
        "n_obs": int(mod_A_social.nobs), "R2": round(mod_A_social.rsquared, 5),
    })

    # B: A' + race
    a = coef_row(mod_B_full_no_acad, X)
    rows.append({
        "focal_X": X, "model": "B_social_plus_race",
        "predictor_set": "+".join(SOCAL_VARS + RACE_VARS),
        **{f"X_{k}": v for k, v in a.items()},
        "n_obs": int(mod_B_full_no_acad.nobs), "R2": round(mod_B_full_no_acad.rsquared, 5),
    })

    # C: A' + academic
    a = coef_row(mod_C_full_no_race, X)
    rows.append({
        "focal_X": X, "model": "C_social_plus_academic",
        "predictor_set": "+".join(SOCAL_VARS + ACAD_VARS),
        **{f"X_{k}": v for k, v in a.items()},
        "n_obs": int(mod_C_full_no_race.nobs), "R2": round(mod_C_full_no_race.rsquared, 5),
    })

    # D: full
    a = coef_row(mod_D_full, X)
    rows.append({
        "focal_X": X, "model": "D_full_social_race_academic",
        "predictor_set": "+".join(SOCAL_VARS + RACE_VARS + ACAD_VARS),
        **{f"X_{k}": v for k, v in a.items()},
        "n_obs": int(mod_D_full.nobs), "R2": round(mod_D_full.rsquared, 5),
    })

coef_df = pd.DataFrame(rows)
coef_df.to_csv(f"{OUT_DIR}/coefs_table.csv", index=False)

# Print the table
print("\n=== LPM (OLS, HC1 robust SE) coefficients for the focal X ===")
print(coef_df.to_string(index=False, float_format=lambda v: f"{v: .5f}"))

# ---------------------------------------------------------------------------
# 3. Identify the variable that matches the target signature
# ---------------------------------------------------------------------------
target_start, target_end = 0.3636, -0.2293

print("\n=== Best fit to question signature (start ~ +0.3636 sig -> end ~ -0.2293 insig) ===")
candidate_summary = []
for X in SOCAL_VARS:
    sub = coef_df[coef_df.focal_X == X].copy().reset_index(drop=True)
    a_row = sub[sub.model == "A_bivariate"].iloc[0]
    ap_row = sub[sub.model == "Aprime_social_background"].iloc[0]
    d_row = sub[sub.model == "D_full_social_race_academic"].iloc[0]

    # Two candidate start rows: A (bivariate) and A' (social)
    for start_label, start_row in [("A", a_row), ("Aprime", ap_row)]:
        start_b, start_p = start_row["X_beta"], start_row["X_p_two"]
        end_b,   end_p   = d_row["X_beta"],   d_row["X_p_two"]
        score = abs(start_b - target_start) + abs(end_b - target_end)
        # also require start significant, end insignificant
        match = (start_p < 0.05) and (end_p >= 0.05)
        candidate_summary.append({
            "X": X,
            "start_model": start_label,
            "start_beta": round(start_b, 4), "start_p": round(start_p, 4),
            "end_beta": round(end_b, 4),  "end_p": round(end_p, 4),
            "target_start": target_start, "target_end": target_end,
            "abs_dev_from_target": round(score, 4),
            "sig_at_start_AND_insig_at_end": match,
        })

cand_df = pd.DataFrame(candidate_summary).sort_values("abs_dev_from_target")
print(cand_df.to_string(index=False))

best = cand_df.iloc[0]
winner_X = best["X"]
print(
    f"\n>>> Winner by closest match: {winner_X} (start_model={best['start_model']}, "
    f"start_beta={best['start_beta']}, start_p={best['start_p']}, "
    f"end_beta={best['end_beta']}, end_p={best['end_p']})"
)

# ---------------------------------------------------------------------------
# 4. Logistic robustness (log-odds; not expected to numerically match)
# ---------------------------------------------------------------------------
fit_logit = lambda Xvars: sm.Logit(
    y, sm.add_constant(df[Xvars], has_constant="add")
).fit(disp=0, cov_type="HC1", maxiter=200)

logit_rows = []
for label, Xvars in [
    ("A_bivariate",        SOCAL_VARS[:1]),
    ("Aprime_social_background",
        SOCAL_VARS),
    ("D_full_social_race_academic",
        SOCAL_VARS + RACE_VARS + ACAD_VARS),
]:
    try:
        m = fit_logit(Xvars)
        for X in SOCAL_VARS:
            if X in m.params.index:
                logit_rows.append({
                    "model": label, "focal_X": X,
                    "logit_beta": round(float(m.params[X]), 4),
                    "se_HC1":     round(float(m.bse[X]), 4),
                    "p_two":      round(float(m.pvalues[X]), 4),
                })
    except Exception as exc:
        print(f"logit fit failed for {label}: {exc}")
logit_df = pd.DataFrame(logit_rows)
logit_df.to_csv(f"{OUT_DIR}/coefs_logit.csv", index=False)
print("\n=== Logistic-regression robustness (log-odds scale, HC1 SE) ===")
print(logit_df.to_string(index=False))

# ---------------------------------------------------------------------------
# 5. Plain-language write-up
# ---------------------------------------------------------------------------
summary = f"""
=========================================================
DiscoveryBench  discoverybench:test/nls_ses/metadata_10.json/0/2
=========================================================
Sample size : {len(df)}   BA completion rate : {df['BA_int'].mean():.4f}
Reference cats : race=White, sex=Female

LPM coefficients on focal X across model sequence
(bivariate -> social-background -> +race -> +academic -> +BOTH)
---------------------------------------------------------
{coef_df.to_string(index=False, float_format=lambda v: f'{v: .5f}')}

Best-matching focal X to the requested (-0.3636 -> -0.2293-signature):
  X            = {winner_X}
  start_model  = {best['start_model']}  (start_beta = {best['start_beta']}, p = {best['start_p']})
  end_model    = D_full   (end_beta = {best['end_beta']}, p = {best['end_p']})
  start significant AND end insignificant :
                                 {bool(best['sig_at_start_AND_insig_at_end'])}

Logit robustness (not expected to match numerically):
{logit_df.to_string(index=False)}

Conclusion
----------
The variable whose coefficient on BA-degree-completion swings from a
strongly significant +{best['start_beta']} in the {(best['start_model'])} model to a
non-significant {best['end_beta']} once BOTH race (race_Black,
race_Hispanic; reference White) AND academic characteristics
(ASVAB composite, percentile in class) are added is **{winner_X}**.
"""
print(summary)
with open(f"{OUT_DIR}/full_summary.txt", "w") as fh:
    fh.write(summary)
