"""NLS SES analysis: identify variable whose BA effect moves ~+0.3636 -> ~-0.2293."""
import json, os, warnings
import numpy as np, pandas as pd
import statsmodels.api as sm
from scipy.stats import norm
warnings.filterwarnings("ignore")

DATA_PATH = "data/nls_ses_processed.csv"
OUT_DIR = "analysis/output"
os.makedirs(OUT_DIR, exist_ok=True)


def build_design(df):
    out = pd.DataFrame(index=df.index)
    out["y"] = df["BA DEGREE COMPLETED"].astype(int)
    out["SES"] = df["SES"].astype(float)
    out["ASVAB"] = df["ABILITY: COMPOSITE OF ASVAB SCORE"].astype(float)
    out["PERCENTILE"] = df["PERCENTILE IN CLASS"].astype(float)
    out["FAMILY_SIZE"] = df["FAMILY SIZE OF SAMPLE"].astype(float)
    out["FEMALE"] = (df["SAMPLE_SEX"] == "Female").astype(int)
    for r in ["White", "Black", "Hispanic"]:
        out[f"RACE_{r}"] = (df["SAMPLE_RACE"] == r).astype(int)
    # White = ref (default), Black = ref, Hispanic = ref
    out["BLACK_w"] = out["RACE_Black"]
    out["HISPANIC_w"] = out["RACE_Hispanic"]
    out["HISPANIC_b"] = out["RACE_Hispanic"]; out["WHITE_b"] = out["RACE_White"]
    out["WHITE_h"] = out["RACE_White"]; out["BLACK_h"] = out["RACE_Black"]
    out["NONWHITE_w"] = ((df["SAMPLE_RACE"] != "White") & df["SAMPLE_RACE"].notna()).astype(int)
    return out


def fit_logit(y, X, cov_type="HC1"):
    Xc = sm.add_constant(X, has_constant="add")
    res = sm.Logit(y, Xc).fit(disp=0, cov_type=cov_type)
    z = norm.ppf(0.975)
    return pd.DataFrame({
        "term": res.params.index, "coef": res.params.values,
        "se": res.bse.values, "z": res.tvalues.values,
        "p": res.pvalues.values,
        "ci_low": res.params.values - z * res.bse.values,
        "ci_high": res.params.values + z * res.bse.values,
        "n_obs": int(res.nobs), "pseudo_r2": float(res.prsquared),
    }), res


def fit_ols(y, X, cov_type="HC1"):
    Xc = sm.add_constant(X, has_constant="add")
    res = sm.OLS(y, Xc).fit(cov_type=cov_type)
    z = norm.ppf(0.975)
    return pd.DataFrame({
        "term": res.params.index, "coef": res.params.values,
        "se": res.bse.values, "t": res.tvalues.values,
        "p": res.pvalues.values,
        "ci_low": res.params.values - z * res.bse.values,
        "ci_high": res.params.values + z * res.bse.values,
        "n_obs": int(res.nobs), "r2": float(res.rsquared),
    }), res


def ame_from_logit(res, X):
    Xc = sm.add_constant(X, has_constant="add")
    p_hat = np.asarray(res.predict(Xc))
    rows = []
    for t in res.params.index:
        if t == "const":
            continue
        b = float(res.params[t])
        rows.append({"term": t, "ame_prob": float(np.mean(b * p_hat * (1 - p_hat)))})
    return pd.DataFrame(rows)


def fit_and_store(name, y, OUT, rhs, kind="logit", cov_type="HC1"):
    X = OUT[rhs].copy()
    if kind == "logit":
        df_, res = fit_logit(y, X, cov_type=cov_type)
    else:
        df_, res = fit_ols(y, X, cov_type=cov_type)
    df_.to_csv(f"{OUT_DIR}/{kind}_{name}.csv", index=False)
    return df_, res


# ==========================================================
# MAIN
# ==========================================================
df = pd.read_csv(DATA_PATH)
print("Loaded:", df.shape)
OUT = build_design(df)
y = OUT["y"]

# ------------ STEP 2: bivariate screen ------------
candidates = {
    "SES": ["SES"],
    "ASVAB": ["ASVAB"],
    "PERCENTILE": ["PERCENTILE"],
    "FAMILY_SIZE": ["FAMILY_SIZE"],
    "is_Female": ["FEMALE"],
    "is_Black_w": ["BLACK_w"],
    "is_Hispanic_w": ["HISPANIC_w"],
    "non_White_vs_White": ["NONWHITE_w"],
}
print("\n========= STEP 2: Bivariate logistic screen =========")
rows = []
for name, rhs in candidates.items():
    X = OUT[rhs]
    fit_df, _ = fit_logit(y, X)
    coef = float(fit_df.loc[fit_df["term"] == rhs[0], "coef"].iloc[0])
    p = float(fit_df.loc[fit_df["term"] == rhs[0], "p"].iloc[0])
    rows.append({"candidate": name, "term": rhs[0], "bivariate_logit_coef": coef,
                 "bivariate_p": p, "abs_dist_to_03636": abs(coef - 0.3636)})
scr = pd.DataFrame(rows).sort_values("abs_dist_to_03636")
print(scr.to_string(index=False))
scr.to_csv(f"{OUT_DIR}/step2_bivariate_screen.csv", index=False)

# Pick v* = row closest to +0.3636 among significant rows
candidates_sig = scr[scr["bivariate_p"] < 0.05]
v_star_row = candidates_sig.iloc[0]
v_star_name = v_star_row["candidate"]
v_col = v_star_row["term"]
print(f"\n*** Identified v* = {v_star_name} (term={v_col}, "
      f"bivariate logit coef = {v_star_row['bivariate_logit_coef']:.4f}, "
      f"p = {v_star_row['bivariate_p']:.4g}) ***")


# ------------ STEP 3: sequential logit models A..E on v* ------------
print("\n========= STEP 3: Sequential logit models on v* =========")
race_block = ["BLACK_w", "HISPANIC_w"]
acad_block = ["ASVAB", "PERCENTILE"]
demo_block = ["FEMALE", "FAMILY_SIZE"]
specs = {
    "A_bivariate": [v_col],
    "B_add_academic": [v_col] + acad_block,
    "C_add_race": [v_col] + race_block,
    "D_add_academic_AND_race": [v_col] + acad_block + race_block,
    "E_full": [v_col] + acad_block + race_block + demo_block,
}
logit_tabs = {}
logit_res = {}
for name, rhs in specs.items():
    X = OUT[rhs]
    fit_df, res = fit_logit(y, X)
    logit_tabs[name] = fit_df; logit_res[name] = res
    print(f"\n--- logit_{name} (rhs={rhs}) ---")
    print(fit_df[["term","coef","se","p","ci_low","ci_high"]].to_string(index=False))

# ------------ STEP 4: OLS/LPM cross-checks ------------
print("\n========= STEP 4: OLS/LPM cross-checks =========")
ols_tabs = {}
for name in ["A_bivariate", "D_add_academic_AND_race", "E_full"]:
    rhs = specs[name]; X = OUT[rhs]
    fit_df, res = fit_ols(y, X)
    ols_tabs[name] = fit_df
    print(f"\n--- ols_{name} ---")
    print(fit_df[["term","coef","se","p","ci_low","ci_high"]].to_string(index=False))

# ------------ AME from logit -----------
print("\n========= AME from logit =========")
ame_tabs = {}
for name in ["A_bivariate", "D_add_academic_AND_race", "E_full"]:
    rhs = specs[name]; X = OUT[rhs]
    _, res = fit_logit(y, X)
    ame_df = ame_from_logit(res, X); ame_df["model"] = name
    ame_tabs[name] = ame_df
    print(f"\n--- ame_{name} ---")
    print(ame_df.to_string(index=False))
    ame_df.to_csv(f"{OUT_DIR}/ame_{name}.csv", index=False)


# ------------ STEP 6: Reference-category sensitivity for Model D ------------
print("\n========= STEP 6: Reference-category sensitivity (Model D) =========")
ref_specs = [
    ("White",    ["BLACK_w", "HISPANIC_w"]),
    ("Black",    ["HISPANIC_b", "WHITE_b"]),
    ("Hispanic", ["WHITE_h",   "BLACK_h"]),
]
sens_D = {}
for ref_label, dums in ref_specs:
    rhs = [v_col] + acad_block + dums
    X = OUT[rhs]
    fit_df, _ = fit_logit(y, X)
    sens_D[ref_label] = fit_df
    print(f"\n--- logit_D_ref_{ref_label} (dummies={dums}) ---")
    print(fit_df[["term","coef","se","p"]].to_string(index=False))
    fit_df.to_csv(f"{OUT_DIR}/logit_D_ref_{ref_label}.csv", index=False)

# ------------ STEP 7: Match-quality table for v* ------------
print("\n========= STEP 7: Match-quality table =========")
def grab(df_, term):
    r = df_.loc[df_["term"] == term].iloc[0]
    return float(r["coef"]), float(r["se"]), float(r["p"]), float(r["ci_low"]), float(r["ci_high"])
A = logit_tabs["A_bivariate"]; D = logit_tabs["D_add_academic_AND_race"]
E = logit_tabs["E_full"]
bA,sA,pA,lA,hA = grab(A,v_col); bD,sD,pD,lD,hD = grab(D,v_col); bE,sE,pE,lE,hE = grab(E,v_col)
bA_ols,sA_ols,pA_ols,lA_ols,hA_ols = grab(ols_tabs["A_bivariate"], v_col)
bD_ols,sD_ols,pD_ols,lD_ols,hD_ols = grab(ols_tabs["D_add_academic_AND_race"], v_col)
ameA = float(ame_tabs["A_bivariate"].loc[ame_tabs["A_bivariate"]["term"]==v_col,"ame_prob"].iloc[0])
ameD = float(ame_tabs["D_add_academic_AND_race"].loc[ame_tabs["D_add_academic_AND_race"]["term"]==v_col,"ame_prob"].iloc[0])

match = pd.DataFrame([
    {"scale":"logit latent",     "model":"A bivariate",            "coef":bA,"se":sA,"p":pA,"ci_low":lA,"ci_high":hA,"target":"+0.3636","delta_to_target":bA-0.3636},
    {"scale":"logit latent",     "model":"D +acad +race",          "coef":bD,"se":sD,"p":pD,"ci_low":lD,"ci_high":hD,"target":"-0.2293","delta_to_target":bD-(-0.2293)},
    {"scale":"logit latent",     "model":"E full",                 "coef":bE,"se":sE,"p":pE,"ci_low":lE,"ci_high":hE,"target":"n/a",   "delta_to_target":np.nan},
    {"scale":"OLS/LPM prob",     "model":"A bivariate",            "coef":bA_ols,"se":sA_ols,"p":pA_ols,"ci_low":lA_ols,"ci_high":hA_ols,"target":"n/a","delta_to_target":np.nan},
    {"scale":"OLS/LPM prob",     "model":"D +acad +race",          "coef":bD_ols,"se":sD_ols,"p":pD_ols,"ci_low":lD_ols,"ci_high":hD_ols,"target":"n/a","delta_to_target":np.nan},
    {"scale":"logit AME prob",   "model":"A bivariate",            "coef":ameA,"se":np.nan,"p":np.nan,"ci_low":np.nan,"ci_high":np.nan,"target":"n/a","delta_to_target":np.nan},
    {"scale":"logit AME prob",   "model":"D +acad +race",          "coef":ameD,"se":np.nan,"p":np.nan,"ci_low":np.nan,"ci_high":np.nan,"target":"n/a","delta_to_target":np.nan},
])
print(match.to_string(index=False))
match.to_csv(f"{OUT_DIR}/vstar_match_table.csv", index=False)


# ------------ Within-group SES by race × BA + correlations ------------
print("\n========= Within-group SES by race x BA =========")
ses_table = df.groupby(["SAMPLE_RACE","BA DEGREE COMPLETED"])["SES"].agg(["mean","count"])
print(ses_table)
ses_table.to_csv(f"{OUT_DIR}/ses_by_race_ba.csv")

print("\nCorrelations among SES, ASVAB, PERCENTILE, FAMILY_SIZE, FEMALE:")
corr = OUT[["SES","ASVAB","PERCENTILE","FAMILY_SIZE","FEMALE","BLACK_w","HISPANIC_w"]].corr()
print(corr.round(3))
corr.to_csv(f"{OUT_DIR}/correlation_matrix.csv")

# ------------ Save small summary JSON ------------
summary = {
    "v_star_name": v_star_name,
    "v_star_term": v_col,
    "v_star_bivariate_logit_coef": bA,
    "v_star_bivariate_logit_se": sA,
    "v_star_bivariate_p": pA,
    "v_star_D_logit_coef": bD,
    "v_star_D_logit_se": sD,
    "v_star_D_logit_p": pD,
    "v_star_E_logit_coef": bE,
    "v_star_E_logit_se": sE,
    "v_star_E_logit_p": pE,
    "v_star_A_ols_coef": bA_ols,
    "v_star_D_ols_coef": bD_ols,
    "v_star_A_ame": ameA,
    "v_star_D_ame": ameD,
    "delta_A_to_03636": bA - 0.3636,
    "delta_D_to_-02293": bD - (-0.2293),
    "n": int(len(df)),
}
with open(f"{OUT_DIR}/summary.json","w") as f:
    json.dump(summary, f, indent=2)
print("\nSummary:")
print(json.dumps(summary, indent=2))
