"""
NLS incarceration x Black-wealth analysis (Pandas 3 native: no .apply).
Follows researcher-approved checklist.
"""
import warnings
warnings.filterwarnings("ignore", category=FutureWarning)
import numpy as np
import pandas as pd
from scipy import stats
import statsmodels.api as sm

pd.set_option("display.width", 160)
pd.set_option("display.max_columns", 20)

PATH = "/workspace/data/nls_incarceration_processed.csv"
df = pd.read_csv(PATH)

# (1) Black-only filter
blk = df[df["race"] == "black"].copy()
assert len(blk) == 3013

# (2) SES tier proxies (pre-period wealth 1985, within Black)
blk["q1985"] = pd.qcut(blk["composite_wealth_1985"], 4,
                       labels=["Q1 (lowest)", "Q2", "Q3", "Q4 (highest)"])
blk["t1985"] = pd.qcut(blk["composite_wealth_1985"], 3,
                       labels=["T1 (lowest)", "T2", "T3 (highest)"])
blk["delta"] = blk["composite_wealth_1996"] - blk["composite_wealth_1985"]
blk["zero1996"] = (blk["composite_wealth_1996"] == 0).astype(int)
blk["zero1985"] = (blk["composite_wealth_1985"] == 0).astype(int)


def wins(s, p=0.01):
    lo, hi = s.quantile([p, 1 - p])
    return s.clip(lower=lo, upper=hi)


def agg_summary(g):
    """Native pandas/numpy aggregation, no .apply."""
    return pd.Series({
        "n": len(g),
        "n_jailed": int(g["ever_jailed"].sum()),
        "med_1985": g["composite_wealth_1985"].median(),
        "med_1990": g["composite_wealth_1990"].median(),
        "med_1996": g["composite_wealth_1996"].median(),
        "med_delta": g["delta"].median(),
        "mean_delta": g["delta"].mean(),
        "wins_mean_delta_1pct": wins(g["delta"]).mean(),
        "p_zero_1996": g["zero1996"].mean(),
    })


def mw_block(g):
    j = g[g["ever_jailed"] == 1]
    nj = g[g["ever_jailed"] == 0]
    out = {"n_jailed": len(j), "n_never": len(nj)}
    if len(j) >= 2 and len(nj) >= 2:
        u_d, p_d = stats.mannwhitneyu(j["delta"], nj["delta"], alternative="two-sided")
        u_y, p_y = stats.mannwhitneyu(j["composite_wealth_1996"],
                                      nj["composite_wealth_1996"],
                                      alternative="two-sided")
        out["mw_delta_U"] = u_d
        out["mw_delta_p"] = p_d
        out["mw_1996_U"] = u_y
        out["mw_1996_p"] = p_y
    else:
        out["mw_delta_U"] = np.nan
        out["mw_delta_p"] = np.nan
        out["mw_1996_U"] = np.nan
        out["mw_1996_p"] = np.nan
    return pd.Series(out)


# Manual groupby without .apply: split dict first
def group_summary(data, by_cols=None):
    rows = []
    if by_cols is None:
        return mw_block(data)
    if by_cols is None:
        return pd.DataFrame([agg_summary(data).to_dict()])
    if isinstance(by_cols, str):
        by_cols = [by_cols]
        single = True
    else:
        single = False
    for keys, g in data.groupby(by_cols, observed=True):
        if not isinstance(keys, tuple):
            keys = (keys,)
        row = dict(zip(by_cols, keys))
        row.update(agg_summary(g).to_dict())
        rows.append(row)
    return pd.DataFrame(rows)


def group_mw(data, by_cols=None):
    rows = []
    if by_cols is None:
        return mw_block(data)
    if by_cols is None:
        return pd.DataFrame([agg_summary(data).to_dict()])
    if isinstance(by_cols, str):
        by_cols = [by_cols]
    for keys, g in data.groupby(by_cols, observed=True):
        if not isinstance(keys, tuple):
            keys = (keys,)
        row = dict(zip(by_cols, keys))
        row.update(mw_block(g).to_dict())
        rows.append(row)
    return pd.DataFrame(rows)


print("=" * 80)
print("OVERALL BLACK (n=3013): by ever_jailed  (PRIMARY)")
print("=" * 80)
print(group_summary(blk, "ever_jailed").round(0).to_string(index=False))
print("\nMann-Whitney (jailed vs never) on overall Black:")
print(group_mw(blk, None).round(4).to_string(index=False))

print("\n" + "=" * 80)
print("BY 1985-WEALTH QUARTILE (PRIMARY tiering)")
print("=" * 80)
print(group_summary(blk, ["q1985", "ever_jailed"]).round(0).to_string(index=False))
print("\nMann-Whitney per quartile (jailed vs never within tier):")
print(group_mw(blk, "q1985").round(4).to_string(index=False))

print("\n" + "=" * 80)
print("ROBUSTNESS: BY 1985-WEALTH TERTILE")
print("=" * 80)
print(group_summary(blk, ["t1985", "ever_jailed"]).round(0).to_string(index=False))
print("\nMann-Whitney per tertile:")
print(group_mw(blk, "t1985").round(4).to_string(index=False))

print("\n" + "=" * 80)
print("(6) BASELINE IMBALANCE CHECK (selection caveat pre-period)")
print("=" * 80)
print("Pre-period (1985) median wealth by ever_jailed within Black:")
print(blk.groupby("ever_jailed")["composite_wealth_1985"].median())
u_b, p_b = stats.mannwhitneyu(
    blk.loc[blk.ever_jailed == 1, "composite_wealth_1985"],
    blk.loc[blk.ever_jailed == 0, "composite_wealth_1985"],
    alternative="two-sided")
print(f"Mann-Whitney on 1985 wealth (jailed vs never): U={u_b:.0f}, p={p_b:.4g}")

print("\n" + "=" * 80)
print("LOGISTIC: P(wealth_1996 == 0) ~ ever_jailed + sex + tier (PRIMARY)")
print("=" * 80)
blk["q1985_code"] = blk["q1985"].cat.codes  # 0..3; Q1 reference (lowest)
X = pd.get_dummies(blk[["ever_jailed", "sex", "q1985_code"]],
                   drop_first=True).astype(float)
X = sm.add_constant(X)
y = blk["zero1996"]
res_logit = sm.Logit(y, X).fit(disp=False)
print(res_logit.summary())
print("\nOdds ratios:")
print(np.exp(res_logit.params).round(3))
print("\nOdds ratios 95% CI:")
print(np.exp(res_logit.conf_int()).round(3))

print("\n" + "=" * 80)
print("(5) MALE-ONLY SENSITIVITY (drop the 16 jailed Black females)")
print("=" * 80)
blk_m = blk[blk["sex"] == "male"].copy()
print(f"Black male n={len(blk_m)}; jailed={int(blk_m['ever_jailed'].sum())}; "
      f"never={int((blk_m['ever_jailed']==0).sum())}")
print("\nBlack-male headline (overall):")
print(group_summary(blk_m, "ever_jailed").round(0).to_string(index=False))
print("\nMann-Whitney Black-male only:")
print(group_mw(blk_m, None).round(4).to_string(index=False))
print("\nBlack-male per quartile:")
print(group_summary(blk_m, ["q1985", "ever_jailed"]).round(0).to_string(index=False))
print("\nMann-Whitney per quartile (Black-male):")
print(group_mw(blk_m, "q1985").round(4).to_string(index=False))

print("\n" + "=" * 80)
print("SEX-ADJUSTED OLS ANCOVA: Δ ~ ever_jailed + sex + tier + log1p(wealth_1985)")
print("=" * 80)
blk["log_wealth_1985"] = np.log1p(blk["composite_wealth_1985"].clip(lower=0))
Xa = pd.get_dummies(blk[["ever_jailed", "sex", "q1985_code"]],
                    drop_first=True).astype(float)
Xa["log_wealth_1985"] = blk["log_wealth_1985"]
Xa = sm.add_constant(Xa)
ya = blk["delta"]
res_ols = sm.OLS(ya, Xa).fit()
ci = res_ols.conf_int()
print(res_ols.summary())
print("\nKey coefficient (ever_jailed=1):")
print(f"  coef = {res_ols.params['ever_jailed']:.0f}, "
      f"p = {res_ols.pvalues['ever_jailed']:.4g}, "
      f"95% CI [{ci.loc['ever_jailed',0]:.0f}, {ci.loc['ever_jailed',1]:.0f}]")

print("\n" + "=" * 80)
print("ACROSS-TIER DELTAS (jailed - never) — direct tier-by-tier comparison")
print("=" * 80)
out = []
for q in ["Q1 (lowest)", "Q2", "Q3", "Q4 (highest)"]:
    g = blk[blk["q1985"] == q]
    j = g[g["ever_jailed"] == 1]
    nj = g[g["ever_jailed"] == 0]
    out.append({
        "tier": q, "n_jailed": len(j), "n_never": len(nj),
        "med_1985_j": j["composite_wealth_1985"].median(),
        "med_1985_nj": nj["composite_wealth_1985"].median(),
        "med_1996_j": j["composite_wealth_1996"].median(),
        "med_1996_nj": nj["composite_wealth_1996"].median(),
        "med_delta_j": j["delta"].median(),
        "med_delta_nj": nj["delta"].median(),
        "delta_gap_j_minus_nj": j["delta"].median() - nj["delta"].median(),
        "p_zero_1996_j": round(j["zero1996"].mean(), 3),
        "p_zero_1996_nj": round(nj["zero1996"].mean(), 3),
        "p_zero_gap": round(j["zero1996"].mean() - nj["zero1996"].mean(), 3),
    })
cmp = pd.DataFrame(out)
print("QUARTILES:")
print(cmp.to_string(index=False))

out_t = []
for t in ["T1 (lowest)", "T2", "T3 (highest)"]:
    g = blk[blk["t1985"] == t]
    j = g[g["ever_jailed"] == 1]
    nj = g[g["ever_jailed"] == 0]
    out_t.append({
        "tier": t, "n_jailed": len(j), "n_never": len(nj),
        "med_1985_j": j["composite_wealth_1985"].median(),
        "med_1985_nj": nj["composite_wealth_1985"].median(),
        "med_1996_j": j["composite_wealth_1996"].median(),
        "med_1996_nj": nj["composite_wealth_1996"].median(),
        "med_delta_j": j["delta"].median(),
        "med_delta_nj": nj["delta"].median(),
        "delta_gap": j["delta"].median() - nj["delta"].median(),
        "p_zero_1996_j": round(j["zero1996"].mean(), 3),
        "p_zero_1996_nj": round(nj["zero1996"].mean(), 3),
        "p_zero_gap": round(j["zero1996"].mean() - nj["zero1996"].mean(), 3),
    })
cmp_t = pd.DataFrame(out_t)
print("\nTERTILES:")
print(cmp_t.to_string(index=False))

print("\nDone.")
