H_x   = col_ix["C(SAMPLE_RACE, Treatment('White'))[T.Hispanic]"]

def ame_for_race_in_b(race_str, Xb_full_arr=Xb_full_arr, Xb_full_cols=Xb_full.columns):
    # Copy the empirical matrix
    X_pos = Xb_full_arr.copy()
    X_neg = Xb_full_arr.copy()
    # Set race indicators to race_str
    if race_str == "White":
        X_pos[:, B_x] = 0; X_neg[:, B_x] = 0
        X_pos[:, H_x] = 0; X_neg[:, H_x] = 0
        # interaction columns already zero
    elif race_str == "Black":
        X_pos[:, B_x] = 1; X_neg[:, B_x] = 1
        X_pos[:, H_x] = 0; X_neg[:, H_x] = 0
        X_pos[:, INT_B] = (X_pos[:, SES_x] + ses_sd) * 1
        X_neg[:, INT_B] = (X_neg[:, SES_x] - ses_sd) * 1
        X_pos[:, INT_H] = 0; X_neg[:, INT_H] = 0
    elif race_str == "Hispanic":
        X_pos[:, B_x] = 0; X_neg[:, B_x] = 0
        X_pos[:, H_x] = 1; X_neg[:, H_x] = 1
        X_pos[:, INT_B] = 0; X_neg[:, INT_B] = 0
        X_pos[:, INT_H] = (X_pos[:, SES_x] + ses_sd) * 1
        X_neg[:, INT_H] = (X_neg[:, SES_x] - ses_sd) * 1
    # Shift SES by +/- sd (after zeroing out interaction columns for pos/neg versions)
    X_pos[:, SES_x] = X_pos[:, SES_x] + ses_sd
    X_neg[:, SES_x] = X_neg[:, SES_x] - ses_sd
    # For White: ensure interaction columns stay 0
    if race_str == "White":
        X_pos[:, INT_B] = 0; X_neg[:, INT_B] = 0
        X_pos[:, INT_H] = 0; X_neg[:, INT_H] = 0
    eta_pos = X_pos @ np.asarray(glm_b_full.params)
    eta_neg = X_neg @ np.asarray(glm_b_full.params)
    p_pos = _logistic(eta_pos)
    p_neg = _logistic(eta_neg)
    return float((p_pos - p_neg).mean())

ame_b = {r: ame_for_race_in_b(r) for r in ["White", "Black", "Hispanic"]}
print("AME (model b) of SES ±1 SD, by race (probability scale):")
