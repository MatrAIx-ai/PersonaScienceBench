# ------------------------------------------------------- Firth implementation
def _logistic(x):
    return 1.0 / (1.0 + np.exp(-x))


def fit_firth(X: np.ndarray, y: np.ndarray,
              max_iter: int = 200, tol: float = 1e-8,
              eps: float = 1e-12) -> tuple[np.ndarray, np.ndarray, float, float, int]:
    """Firth bias-reduced logistic regression.

    Implements the IRLS scheme that maximises
        ell(beta) + 0.5 * log det(X' W X)
    using the working-response adjustment
        z = eta + (y - pi + (1/2)*h) / W
    where h_i = diag(W^(1/2) X (X'WX)^-1 X' W^(1/2))_i is the i-th
    diagonal entry of the hat matrix.

    Returns (beta, vcov, penalized_loglik, unpenalized_loglik, n_iter).
    The vcov matrix is the standard inverse-Hessian (X'WX)^-1 at the
    Firth optimum -- a Wald-type approximation used in the logistf
    package for individual coefficient p-values.
    """
    n, p = X.shape

    def _unpen_loglik(pi, y):
        return float(np.sum(y * np.log(pi + eps) + (1 - y) * np.log(1 - pi + eps)))

    beta = np.linalg.lstsq(np.column_stack([np.ones(n), X[:, 1:]]),
                           y, rcond=None)[0] if False else np.zeros(p)  # initial
    # Intercept-aware init via GLM on intercept + 0 elsewhere.
    try:
        Xt = np.column_stack([np.ones(n), X[:, 1:]])
        beta = np.zeros(p)
        beta[0] = math.log(max(y.mean(), eps) / max(1 - y.mean(), eps))
    except Exception:
        beta = np.zeros(p)

    pen_loglik_prev = -np.inf
    n_iter = 0
    sX_cache = None
    XtWX_inv_cache = None
    for it in range(max_iter):
        n_iter = it + 1
        eta = np.clip(X @ beta, -30, 30)
        pi = _logistic(eta)
        W = pi * (1 - pi)
        if not np.all(W > eps):
            W = np.maximum(W, eps)
        XW = X * W[:, None]
        XtWX = X.T @ XW
        try:
            XtWX_inv = np.linalg.inv(XtWX)
        except np.linalg.LinAlgError:
            XtWX_inv = np.linalg.pinv(XtWX)
        # hat diagonal: h_i = sum_{k,l} XtWX_inv[k,l] * x_{i,k} * x_{i,l} * W_i
        # using sX_i = sqrt(W_i) * x_i, vectorised as e_{i,k}*sX_i for each k:
        sX = X * np.sqrt(W)[:, None]
        # diag( sX * (XtWX_inv @ sX.T) )  ==  (sX * (sX @ XtWX_inv)).sum(axis=1)
        # because  e_i^T sX (XtWX_inv) sX^T e_i  =  row_i(sX) XtWX_inv row_i(sX)^T
        # and row_i(sX)^T XtWX_inv row_i = ((sX @ XtWX_inv) @ row_i(sX)^T)[i] (by sym)
        # which equals ((sX @ XtWX_inv) [i]).dot(sX[i])
        h = (sX * (sX @ XtWX_inv)).sum(axis=1)
        # working residual with Firth offset (1/2)h_i
        adj = (y - pi) + 0.5 * h
        # working response
        z = eta + adj / W
        # beta update
        XtWz = X.T @ (W * z)
        beta_new = XtWX_inv @ XtWz
        # penalised log-likelihood (Firth's actual objective)
        sign, logdet = np.linalg.slogdet(XtWX)
        if sign <= 0:
            logdet = 0.0
        unpen = _unpen_loglik(pi, y)
        pen_loglik = unpen + 0.5 * logdet
        diff_b = np.max(np.abs(beta_new - beta))
        diff_ll = pen_loglik - pen_loglik_prev
        if diff_b < tol and abs(diff_ll) < tol:
            beta = beta_new
            pen_loglik_prev = pen_loglik
            break
        beta = beta_new
        pen_loglik_prev = pen_loglik

    # Final pass for variance estimate at solution.
    eta = np.clip(X @ beta, -30, 30)
    pi = _logistic(eta)
    W = np.maximum(pi * (1 - pi), eps)
    XW = X * W[:, None]
    XtWX = X.T @ XW
    try:
        XtWX_inv = np.linalg.inv(XtWX)
    except np.linalg.LinAlgError:
        XtWX_inv = np.linalg.pinv(XtWX)
    sign, logdet = np.linalg.slogdet(XtWX)
    if sign <= 0:
        logdet = 0.0
    unpen = _unpen_loglik(pi, y)
    pen_loglik = unpen + 0.5 * logdet
    return beta, XtWX_inv, pen_loglik, unpen, n_iter


def firth_wald_summary(beta, vcov, names, alpha=0.05):
    se = np.sqrt(np.maximum(np.diag(vcov), 0))
    z = beta / np.where(se == 0, np.nan, se)
    p = 2 * (1 - norm.cdf(np.abs(z)))
    out = pd.DataFrame({"coef": beta, "se": se, "z": z, "p": p,
                        f"CI_lo_{int(100*(1-alpha))}": beta - norm.ppf(1 - alpha/2) * se,
                        f"CI_hi_{int(100*(1-alpha))}": beta + norm.ppf(1 - alpha/2) * se},
                       index=names)
    return out


def fit_ridge_logit(X: np.ndarray, y: np.ndarray, lam: float = 1.0,
                    max_iter: int = 200, tol: float = 1e-8):
    """L2-penalised logistic regression via Newton-CG with analytic Hessian."""
    n, p = X.shape
    # Standardise columns (intercept-fitted on mean) to make penalty fair.
    Xc = X.copy()
    Xc[:, 1:] = Xc[:, 1:] - Xc[:, 1:].mean(axis=0, keepdims=True)
    sd = Xc[:, 1:].std(axis=0, ddof=1, keepdims=True); sd[sd == 0] = 1.0
    Xc[:, 1:] = Xc[:, 1:] / sd
    ymean = y.mean()
    beta = np.zeros(p)
    for _ in range(max_iter):
        eta = np.clip(Xc @ beta, -30, 30)
        pi = _logistic(eta)
        W = pi * (1 - pi)
        r = y - pi
        XW = Xc * W[:, None]
        XtWX = Xc.T @ XW + lam * np.eye(p)
        XtW = Xc.T @ (W * r) - lam * beta
        try:
            step = np.linalg.solve(XtWX, XtW)
        except np.linalg.LinAlgError:
            step = np.linalg.lstsq(XtWX, XtW, rcond=None)[0]
        beta = beta + step
        if np.max(np.abs(step)) < tol:
            break
    # Undo scaling of columns (intercept not scaled), keep coefficient ratio.
    coef_orig = beta.copy()
    coef_orig[1:] = coef_orig[1:] / sd.ravel()  # scaling reverses
    return beta, coef_orig, Xc, sd




