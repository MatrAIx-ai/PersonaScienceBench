        int_H_ix  = Xb_full.columns.get_loc("SES_c:C(SAMPLE_RACE, Treatment(\'White\'))[T.Hispanic]")
        p = res.params
        slopes_W.append(float(p[ses_idx]))
        slopes_B.append(float(p[ses_idx] + p[int_B_ix]))
        slopes_H.append(float(p[ses_idx] + p[int_H_ix]))
    except Exception:
        slopes_W.append(np.nan); slopes_B.append(np.nan); slopes_H.append(np.nan)
print(f"bootstrap done in {time()-t0:.1f}s  ({n_conv}/{B0} converged)")

def _ci(arr, lo=2.5, hi=97.5):
    a = np.asarray(arr, dtype=float)
    a = a[~np.isnan(a)]
    if len(a) == 0: return (np.nan, np.nan)
    return (float(np.percentile(a, lo)), float(np.percentile(a, hi)))

