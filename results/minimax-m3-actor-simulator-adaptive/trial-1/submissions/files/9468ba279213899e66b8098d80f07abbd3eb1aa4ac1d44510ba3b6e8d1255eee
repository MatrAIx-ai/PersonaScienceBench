        prt(f"   {nm:18s}: b={b:+.3f}  OR={np.exp(b):.3f}  CI=[{lo:.3f},{hi:.3f}]")
    prt(f"  predicted P(outcome=1):")
    for z in [-1, 0, 1]:
        p_f = float(np.asarray(res.predict(np.array([[1.0,1.0,z,1*z]])))[0])
        p_m = float(np.asarray(res.predict(np.array([[1.0,0.0,z,0*z]])))[0])
        prt(f"   zSES={z:+d}: P(F)={p_f:.3f}  P(M)={p_m:.3f}  diff={p_f-p_m:+.3f}")
