def mice_impute_block(arr, n_iter=10, seed=0):
    rng = np.random.default_rng(seed)
    arr = arr.astype(float).copy()
    n, p = arr.shape
    col_means = np.nanmean(arr, axis=0); col_sds = np.nanstd(arr, axis=0)
    col_sds_safe = np.where(col_sds==0, 1, col_sds)
    for j in range(p):
        mask = np.isnan(arr[:, j])
        arr[mask, j] = rng.normal(col_means[j], col_sds_safe[j], mask.sum())
    for it in range(n_iter):
        order = rng.permutation(p)
        for j in order:
            others = [k for k in range(p) if k != j]
            X = arr[:, others]; y = arr[:, j]
            Xi = np.c_[np.ones(n), X]
            mask = ~np.isnan(y)
            try:
                beta, *_ = np.linalg.lstsq(Xi[mask], y[mask], rcond=None)
            except np.linalg.LinAlgError:
                continue
            mu = Xi @ beta
            resid = y[mask] - Xi[mask] @ beta
            sigma = resid.std() if len(resid) > 1 else 1
            missing = np.isnan(y)
            if missing.sum() > 0:
                arr[missing, j] = rng.normal(mu[missing], max(sigma, 1e-6))
    return arr

def mice_fit(df_full, ses_comps, outcome, n_imps=5, seed=42):
    coefs, ses_ = [], []
    for m in range(n_imps):
        sub = df_full[ses_comps].astype(float).values.copy()
        imp = mice_impute_block(sub, n_iter=10, seed=seed+m)
        z = np.zeros_like(imp)
        for j,c in enumerate(ses_comps):
            mu = imp[:, j].mean(); sd = imp[:, j].std()
            if sd==0: sd = 1
            z[:, j] = (imp[:, j] - mu) / sd
        zses = z.mean(axis=1)
        zmu = zses.mean(); zsd = zses.std()
        if zsd==0: zsd = 1
        zses = (zses - zmu) / zsd
        y = df_full[outcome].astype(float).values
        female = df_full['female'].astype(float).values
        X = np.c_[np.ones(len(df_full)), female, zses, female*zses]
        try:
            r = Logit(y, X).fit(disp=False, maxiter=300)
            coefs.append(r.params); ses_.append(r.bse)
        except Exception:
            pass
    return np.array(coefs), np.array(ses_)

