def fit_firth(X, y, max_iter=300, tol=1e-7):
    X = np.asarray(X, dtype=float)
    y = np.asarray(y, dtype=float)
    n, p = X.shape

    def make_H(b):
        eta = np.clip(X @ b, -30, 30)
        mu = 1/(1+np.exp(-eta))
        w = mu*(1-mu)
        return (X.T * w) @ X, mu

    def make_U(b):
        eta = np.clip(X @ b, -30, 30)
        mu = 1/(1+np.exp(-eta))
        return X.T @ (y - mu)

    try:
        mle = Logit(y, X).fit(disp=False, maxiter=300)
        b = mle.params.copy()
    except Exception:
        b = np.zeros(p)

    for it in range(max_iter):
        H, mu = make_H(b)
        try: Hi = np.linalg.inv(H + 1e-10*np.eye(p))
        except np.linalg.LinAlgError: Hi = np.linalg.pinv(H)
        eps = 1e-5
        a = np.zeros(p)
        for j in range(p):
            bp = b.copy(); bp[j] += eps
            bm = b.copy(); bm[j] -= eps
            dH = (make_H(bp)[0] - make_H(bm)[0])/(2*eps)
            a[j] = 0.5 * np.trace(Hi @ dH)
        U = make_U(b)
        U_star = U + a
        try: step = np.linalg.solve(H + 1e-10*np.eye(p), U_star)
        except np.linalg.LinAlgError: step = np.linalg.lstsq(H, U_star, rcond=None)[0]
        b_new = b + step
        if np.max(np.abs(b_new - b)) < tol:
            b = b_new; break
        b = b_new

    H, mu = make_H(b)
    try: cov = np.linalg.inv(H + 1e-10*np.eye(p))
    except np.linalg.LinAlgError: cov = np.linalg.pinv(H)
    se = np.sqrt(np.clip(np.diag(cov), 0, None))
    return b, se, cov

