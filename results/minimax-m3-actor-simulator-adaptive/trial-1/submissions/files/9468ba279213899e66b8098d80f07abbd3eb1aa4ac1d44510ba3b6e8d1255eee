def make_z_and_quartile(frame):
    ses_components = ['father_ed','mother_ed','income_log','inv_family_sz','occ_prest']
    z = pd.DataFrame(index=frame.index)
    for c in ses_components:
        m = frame[c].mean(skipna=True)
        s = frame[c].std(skipna=True)
        if s == 0 or np.isnan(s):
            z[c+'_z'] = 0.0
        else:
            z[c+'_z'] = (frame[c] - m) / s
    z['zSES'] = z.mean(axis=1)
    m, s = z['zSES'].mean(), z['zSES'].std()
    if s and not np.isnan(s):
        z['zSES_cont'] = (z['zSES'] - m) / s
    else:
        z['zSES_cont'] = 0
    out = frame.copy()
    out[['father_ed_z','mother_ed_z','income_log_z','inv_family_sz_z','occ_prest_z','zSES','zSES_cont']] = z
    try:
        out['SES_quartile'] = pd.qcut(out['zSES_cont'], 4, labels=['Q1','Q2','Q3','Q4'], duplicates='drop')
    except Exception:
        out['SES_quartile'] = np.nan
    return out

