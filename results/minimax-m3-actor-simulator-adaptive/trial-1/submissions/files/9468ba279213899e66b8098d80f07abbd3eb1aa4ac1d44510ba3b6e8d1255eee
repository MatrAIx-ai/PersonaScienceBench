def coef_table(res, names):
    """Build coef/SE/OR/CI/z table by NAME (avoids positional index error)."""
    rows = []
    for n in names:
        if n in res.params.index:
            b = float(res.params[n]); se = float(res.bse[n])
            rows.append((n, b, se, np.exp(b), np.exp(b-1.96*se), np.exp(b+1.96*se), b/se if se>0 else 0))
    return pd.DataFrame(rows, columns=['name','coef','se','OR','lo','hi','z'])

