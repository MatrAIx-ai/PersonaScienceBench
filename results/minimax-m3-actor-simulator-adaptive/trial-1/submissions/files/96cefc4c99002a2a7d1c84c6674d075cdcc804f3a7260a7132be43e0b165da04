"""Tiny stdlib-only SVG line-plot writer (used because matplotlib is unavailable)."""
from xml.sax.saxutils import escape

def _palette():
    return {
        "blue":"#1f77b4","red":"#d62728","green":"#2ca02c","orange":"#ff7f0e","black":"#000000","gray":"#666666",
    }

def svg_line_plot(
    series_list,                # list of dicts: {"x":[...], "y":[...] , "label":..., "color":..., "style":..., "markers":bool, "ci":(lo,hi)}
    title, xlabel, ylabel,
    out_path, width=900, height=540,
    xtick_vals=None, xtick_labels=None,
    ymin=None, ymax=None,
    grid=True
):
    pal = _palette()
    pad_l=80; pad_r=30; pad_t=70; pad_b=70
    plot_w = width-pad_l-pad_r
    plot_h = height-pad_t-pad_b

    # X / Y ranges
    all_x = [v for s in series_list for v in s["x"]]
    all_y = [v for s in series_list for v in s["y"]]
    for s in series_list:
        if "ci" in s and s["ci"] is not None:
            lo,hi = s["ci"]
            all_y += list(lo)+list(hi)
    x_min = min(all_x); x_max = max(all_x)
    if ymin is None: y_min = min(all_y)
    else: y_min = ymin
    if ymax is None: y_max = max(all_y)
    else: y_max = ymax
    if y_min == y_max: y_min, y_max = y_min-0.01, y_max+0.01

    def X(v): return pad_l + (v-x_min)/(x_max-x_min)*plot_w
    def Y(v): return pad_t + plot_h - (v-y_min)/(y_max-y_min)*plot_h

    svg = []
    svg.append(f'<?xml version="1.0" encoding="UTF-8"?>')
    svg.append(f'<svg xmlns="http://www.w3.org/2000/svg" width="{width}" height="{height}" '
               f'viewBox="0 0 {width} {height}" font-family="Helvetica, Arial, sans-serif" font-size="13">')
    # Background
    svg.append(f'<rect x="0" y="0" width="{width}" height="{height}" fill="white"/>')
    # Title
    title_lines = title.split("\n")
    for i, ln in enumerate(title_lines):
        svg.append(f'<text x="{width/2}" y="{20+i*18}" text-anchor="middle" font-size="14" font-weight="bold">{escape(ln)}</text>')
    # Axes
    svg.append(f'<line x1="{pad_l}" y1="{pad_t}" x2="{pad_l}" y2="{pad_t+plot_h}" stroke="black" stroke-width="1"/>')
    svg.append(f'<line x1="{pad_l}" y1="{pad_t+plot_h}" x2="{pad_l+plot_w}" y2="{pad_t+plot_h}" stroke="black" stroke-width="1"/>')
    # Grid + Y ticks
    yticks = 6
    for i in range(yticks+1):
        v = y_min + (y_max-y_min)*i/yticks
        yp = Y(v)
        if grid:
            svg.append(f'<line x1="{pad_l}" y1="{yp}" x2="{pad_l+plot_w}" y2="{yp}" stroke="#ddd" stroke-width="0.5"/>')
        svg.append(f'<text x="{pad_l-8}" y="{yp+4}" text-anchor="end">{v:.3f}</text>')
    # X ticks
    if xtick_vals is None:
        xtick_vals = sorted(set(all_x))
    if xtick_labels is None:
        xtick_labels = [str(int(v)) for v in xtick_vals]
    for v, lab in zip(xtick_vals, xtick_labels):
        xp = X(v)
        svg.append(f'<line x1="{xp}" y1="{pad_t+plot_h}" x2="{xp}" y2="{pad_t+plot_h+5}" stroke="black"/>')
        svg.append(f'<text x="{xp}" y="{pad_t+plot_h+20}" text-anchor="middle">{escape(lab)}</text>')
    # Axis labels
    svg.append(f'<text x="{width/2}" y="{height-15}" text-anchor="middle">{escape(xlabel)}</text>')
    svg.append(f'<text x="{20}" y="{height/2}" text-anchor="middle" transform="rotate(-90 20 {height/2})">{escape(ylabel)}</text>')

    # Series
    legend_entries = []
    for s in series_list:
        color = s.get("color","#1f77b4")
        style = s.get("style","-")  # "-" solid, "--" dashed
        if "ci" in s and s["ci"] is not None:
            lo,hi = s["ci"]
            # polygon: top forward, bottom backward
            pts = []
            for x, y in zip(s["x"], hi):
                pts.append(f"{X(x):.1f},{Y(y):.1f}")
            for x, y in reversed(list(zip(s["x"], lo))):
                pts.append(f"{X(x):.1f},{Y(y):.1f}")
            svg.append(f'<polygon points="{" ".join(pts)}" fill="{color}" fill-opacity="0.12" stroke="none"/>')
        # line
        sw = "2.2"
        if style == "--":
            dash = ' stroke-dasharray="6,4"'
        else:
            dash = ''
        pts = " ".join(f"{X(x):.1f},{Y(y):.1f}" for x, y in zip(s["x"], s["y"]))
        svg.append(f'<polyline points="{pts}" fill="none" stroke="{color}" stroke-width="{sw}"{dash}/>')
        # markers
        if s.get("markers", False):
            for x, y in zip(s["x"], s["y"]):
                svg.append(f'<circle cx="{X(x):.1f}" cy="{Y(y):.1f}" r="3.5" fill="{color}"/>')
        legend_entries.append((color, s["label"], s.get("marker_kind","circle")))
    # Empirical-with-empty-markers series (draw last so it appears over)
    for s in series_list:
        if s.get("kind") == "emp_hollow":
            color = s["color"]
            for x, y in zip(s["x"], s["y"]):
                mk = s.get("marker_kind","circle")
                if mk == "circle":
                    svg.append(f'<circle cx="{X(x):.1f}" cy="{Y(y):.1f}" r="4.5" fill="white" stroke="{color}" stroke-width="1.6"/>')
                elif mk == "square":
                    svg.append(f'<rect x="{X(x)-4.5:.1f}" y="{Y(y)-4.5:.1f}" width="9" height="9" fill="white" stroke="{color}" stroke-width="1.6"/>')
                elif mk == "triangle":
                    px, py = X(x), Y(y); r=5
                    svg.append(f'<polygon points="{px:.1f},{py-r:.1f} {px-r:.1f},{py+r:.1f} {px+r:.1f},{py+r:.1f}" fill="white" stroke="{color}" stroke-width="1.6"/>')
            legend_entries.append((s["color"], s["label"], s.get("marker_kind","circle")))

    # Legend (top right inside plot area)
    lx = pad_l + plot_w - 260
    ly = pad_t + 10
    svg.append(f'<rect x="{lx-6}" y="{ly-6}" width="252" height="{18*len(legend_entries)+12}" fill="white" fill-opacity="0.92" stroke="#888"/>')
    for i,(color, lab, mk) in enumerate(legend_entries):
        yy = ly + 8 + i*16
        if mk == "circle":
            svg.append(f'<circle cx="{lx+6}" cy="{yy-3}" r="4" fill="{color}"/>')
        elif mk == "square":
            svg.append(f'<rect x="{lx+1}" y="{yy-7}" width="9" height="9" fill="{color}"/>')
        elif mk == "triangle":
            svg.append(f'<polygon points="{lx+6},{yy-9} {lx},{yy+3} {lx+12},{yy+3}" fill="{color}"/>')
        svg.append(f'<text x="{lx+18}" y="{yy}">{escape(lab)}</text>')

    svg.append('</svg>')
    open(out_path,"w").write("\n".join(svg))
    return out_path
