

"""Analysis: Time preference (behavioral patience) vs BMI, NLSY79.

Inputs:  data/nls_raw.csv
Outputs: /workspace/artifacts/{missingness.json, bmi_sanity.json,
          missingness_pattern.json, coeffs.json, spearman.json,
          sensitivity.json, run_log.txt, hypothesis.txt}

Verified in inspection stage:
  - Weight is in POUNDS (not kg, despite the column label).
  - Height 1981 (h81) is encoded as feet*100 + inches.
  - ASVAB "Z Score (rounded)" is the NLSY79 normed score (mean ~50*10),
    NOT a true z-score; we re-standardise within the analytic sample.
"""
from __future__ import annotations
import json, textwrap
import numpy as np
import pandas as pd
import statsmodels.api as sm
from scipy.stats import spearmanr

SRC = "data/nls_raw.csv"
df = pd.read_csv(SRC, low_memory=False, na_values=[" ", ""])
df.columns = pd.Index([c.replace("\n"," ").strip() for c in df.columns])

rename = {
    "ID# (range 1-12686) 1979": "id",
    "Age of respondent, 1979": "age79",
    "Age of respondent at interview date, 1981": "age81",
    "Age of respondent at interview date, 1989": "age89",
    "Racial/ethnic cohort, 1979": "race",
    "Sex of respondent, 1979": "sex",
    "Family size, 1979": "famsz79",
    "Total net family income, previous calendar year, 1979": "inc79",
    "Total net family income, previous calendar year, 1985": "inc85",
    "Total net family income, previous calendar year, 1989": "inc89",
    "Highest grade completed by respondent's mother, 1979": "momed",
    "Highest grade completed by respondent's father, 1979": "daded",
    "Highest grade completed, 1979": "rsed79",
    "Height of respondent, 1981": "h81",
    "Height of respondent, 1985": "h85",
    "Weight of respondent, 1981": "w81",
    "Weight of respondent, 1989": "w89",
    "Weight of respondent, 1992": "w92",
    "Family net wealth, 1985": "nw85",
    "Family net wealth, 1990": "nw90",
    "Family net wealth, 1996 (key data point)": "nw96",
    "Was more money put into or taken out of R/spouse savings since last interview, 1989": "sav_cat89",
    "Net amount respondent/spouse put into savings since last interview, 1989": "sav_in89",
    "Net amount respondent/spouse took out of savings since last interview, 1989": "sav_out89",
    "ASVAB - Arithmetic Reasoning Z Score (rounded), 1981": "asvab_ar",
    "ASVAB - Word Knowledge Z Score (rounded), 1981": "asvab_wk",
    "ASVAB - Paragraph Comprehension Z Score (rounded), 1981": "asvab_pc",
    "ASVAB - Mathematics Knowledge Z Score (rounded), 1981": "asvab_mk",
}
df = df.rename(columns={k:v for k,v in rename.items() if k in df.columns})

# --- Cast all numeric cols to plain float64 for statsmodels ---
def _to_float64(d):
    out = d.copy()
    for c in out.columns:
        s = out[c]
        if hasattr(s, "dtype") and str(s.dtype) in ("Float64","Int64","boolean"):
            out[c] = s.astype("float64")
    return out

# Decode h81: feet * 12 + inches (encoded as feet*100 + inches).
df["h81_in"] = (df["h81"] // 100).astype("Int64") * 12 + (df["h81"] - (df["h81"] // 100) * 100)
df["h81_in"] = df["h81_in"].astype("Float64")

# Restrict heights to plausible adult spans.
df.loc[(df["h81_in"] < 48) | (df["h81_in"] > 84), "h81_in"] = np.nan
df.loc[(df["h85"]    < 48) | (df["h85"]    > 84), "h85"]   = np.nan

# Winsorize weights at 50..400 lbs (this also drops the 11 crazy 700-999 records).
for c in ["w81","w89","w92"]:
    df.loc[(df[c] < 50) | (df[c] > 400), c] = np.nan

# BMI: weight in lbs -> kg by /2.205; height in inches -> m by *0.0254
def bmi(w_lbs, h_in_raw):
    return (w_lbs / 2.205) / ((h_in_raw * 0.0254) ** 2)

df["bmi81"] = bmi(df["w81"], df["h81_in"])
df["bmi89"] = bmi(df["w89"], df["h85"])
df["bmi92"] = bmi(df["w92"], df["h85"])
def _to_float64(d):
    out = d.copy()
    for c in out.columns:
        s = out[c]
        if hasattr(s, "dtype") and str(s.dtype) in ("Float64","Int64","boolean"):
            out[c] = s.astype("float64")
    return out
print("BMI built: bmi81 / bmi89 / bmi92")


# ---------- 2. Time-preference proxies ----------
# Primary: dWealthRel = (nw90 - nw85) / mean(inc85, inc89) ; mean instead of single inc89.
denom = pd.concat([df["inc85"], df["inc89"]], axis=1).mean(axis=1, skipna=True)
denom = denom.where(denom > 0)
df["dWealthRel_raw"] = (df["nw90"] - df["nw85"]) / denom

def winsorize(s, lo=0.01, hi=0.99):
    a, b = s.quantile(lo), s.quantile(hi)
    return s.clip(a, b)

df["dWealthRel"] = winsorize(df["dWealthRel_raw"], 0.01, 0.99)

# Direction: LOWER dWealthRel = MORE IMPATIENT.
# Flip sign so higher tp_proxy_impatience = HIGHER time preference = MORE IMPATIENT.
df["tp_proxy_impatience"] = -df["dWealthRel"]

# Secondary: 1989 savings behaviour dummies
df["sav_impatient"] = df["sav_cat89"].isin([2.0, 4.0]).astype("Float64")  # took out OR no savings
df["sav_patient"]    = df["sav_cat89"].isin([1.0, 3.0]).astype("Float64")  # put in OR no change

# Log wealth/income controls
df["log_nw85"]  = np.log(df["nw85"].clip(lower=1))
df["log_nw90"]  = np.log(df["nw90"].clip(lower=1))
df["log_inc89"] = np.log(df["inc89"].clip(lower=1))

# ASVAB composite raw (re-standardised in-sample later)
df["asvab_raw"] = df[["asvab_ar","asvab_wk","asvab_pc","asvab_mk"]].mean(axis=1, skipna=True)

# Age at 1981; fall back to age79+2 if 1981-age missing.
df["age_at_81"] = df["age81"].where(df["age81"].notna(), df["age79"] + 2)

df["race_black"]    = (df["race"] == 1).astype("Float64")
df["race_hispanic"] = (df["race"] == 2).astype("Float64")
df["female"]        = (df["sex"]  == 2).astype("Float64")
print("Time-preference proxies + controls ready")

# ---------- 3. Missingness funnel ----------
N = len(df)
mask_bmi81 = df["bmi81"].notna()
mask_tp    = df["tp_proxy_impatience"].notna()
mask_inc   = df["log_inc89"].notna()
mask_dem   = df[["age_at_81","female","race_black","race_hispanic","famsz79"]].notna().all(axis=1)
mask_par   = df[["momed","daded"]].notna().all(axis=1)
mask_asvab = df["asvab_raw"].notna()

gates = pd.DataFrame([{
    "N_input":                                  N,
    "has_bmi81":                                int(mask_bmi81.sum()),
    "has_tp_proxy":                             int(mask_tp.sum()),
    "has_log_inc89":                            int(mask_inc.sum()),
    "has_demographics":                         int(mask_dem.sum()),
    "has_parental_edu":                         int(mask_par.sum()),
    "has_asvab":                                int(mask_asvab.sum()),
    "has_bmi81_AND_tp":                         int((mask_bmi81 & mask_tp).sum()),
    "primary_analysis_pool (all controls)":     int((mask_bmi81 & mask_tp & mask_inc & mask_dem & mask_par & mask_asvab).sum()),
}])
gates.to_json("/workspace/artifacts/missingness_pattern.json", orient="records")
print("Missingness funnel:\n", gates.to_string(index=False))

miss_cols = ["id","age79","race","sex","famsz79","momed","daded","rsed79",
             "h81","h85","w81","w89","w92",
             "nw85","nw90","nw96","inc79","inc85","inc89",
             "sav_cat89","sav_in89","sav_out89",
             "asvab_ar","asvab_wk","asvab_pc","asvab_mk",
             "bmi81","bmi89","bmi92"]
miss = {"N": N,
        "missing_n":   {c: int(df[c].isna().sum()) for c in miss_cols if c in df.columns}}
miss["missing_pct"] = {c: round(100*miss["missing_n"][c]/N, 2) for c in miss["missing_n"]}
with open("/workspace/artifacts/missingness.json","w") as f:
    json.dump(miss, f, indent=2)

b = df["bmi81"].dropna()
san = {"n_used": int(b.shape[0]),
       "bmi_lbs_median": float(b.median()),
       "bmi_lbs_mean":   float(b.mean()),
       "bmi_lbs_p5":     float(b.quantile(0.05)),
       "bmi_lbs_p95":    float(b.quantile(0.95)),
       "bmi_lbs_min":    float(b.min()),
       "bmi_lbs_max":    float(b.max()),
       "frac_in_15_45":  float(((b>=15)&(b<=45)).mean())}
with open("/workspace/artifacts/bmi_sanity.json","w") as f:
    json.dump(san, f, indent=2)
print("inspection artefacts written")

# ---------- 4. ASVAB in-sample standardisation & primary pool ----------
PRIMARY = mask_bmi81 & mask_tp & mask_inc & mask_dem & mask_par & mask_asvab
_to_float64_helper_marker = True
ASAMP = _to_float64(df.loc[PRIMARY].copy())
print(f"\nPrimary analysis pool (listwise): N = {ASAMP.shape[0]}\n")

ASAMP["asvab_std"] = (ASAMP["asvab_raw"] - ASAMP["asvab_raw"].mean())     / ASAMP["asvab_raw"].std(ddof=1)
ASAMP["tp_std"]    = (ASAMP["tp_proxy_impatience"] - ASAMP["tp_proxy_impatience"].mean()) \
                                                                             / ASAMP["tp_proxy_impatience"].std(ddof=1)
ASAMP["bmi_std"]   = (ASAMP["bmi81"] - ASAMP["bmi81"].mean()) / ASAMP["bmi81"].std(ddof=1)

# ---------- 5. Spearman rank correlation ----------
rho, p_rho = spearmanr(ASAMP["tp_proxy_impatience"], ASAMP["bmi81"])
spearman_out = {
    "spearman_rho_BMI81_vs_tp_impatience": float(rho),
    "spearman_pvalue": float(p_rho),
    "n": int(ASAMP.shape[0]),
    "tp_proxy_direction_note": "tp_proxy_impatience = -((nw90-nw85)/mean(inc85,inc89)) winsorized [1,99]. Higher = more impatient.",
}
with open("/workspace/artifacts/spearman.json","w") as f:
    json.dump(spearman_out, f, indent=2)
print(f"Spearman BMI81 vs tp_impatience: rho={rho:+.4f}, p={p_rho:.3g}, n={ASAMP.shape[0]}")

# ---------- 6. OLS helpers ----------
def ols_fit(data, yname, xnames, label):
    y = data[yname]
    X = sm.add_constant(data[xnames])
    res = sm.OLS(y, X, missing="drop").fit(cov_type="HC1")
    out = {"label": label,
           "n": int(res.nobs),
           "r2": float(res.rsquared),
           "r2_adj": float(res.rsquared_adj),
           "const": float(res.params["const"]),
           "const_se": float(res.bse["const"]),
           "const_p":  float(res.pvalues["const"])}
    for k in xnames:
        out[f"beta_{k}"] = float(res.params[k])
        out[f"se_{k}"]   = float(res.bse[k])
        out[f"tval_{k}"] = float(res.tvalues[k])
        out[f"pval_{k}"] = float(res.pvalues[k])
    return res, out

primary_x = ["tp_proxy_impatience","log_inc89","age_at_81",
             "female","race_black","race_hispanic","famsz79","momed","daded","asvab_std"]
res1, out1 = ols_fit(ASAMP, "bmi81", primary_x, "primary: BMI_1981 ~ tp + controls")

xs_std = ["tp_std","log_inc89","age_at_81","female","race_black","race_hispanic",
          "famsz79","momed","daded","asvab_std"]
res1s, out1s = ols_fit(ASAMP, "bmi_std", xs_std, "primary_std: standardised BMI ~ standardised tp + controls")

print("\n=== Primary OLS summary ===")
print(f"  N = {out1['n']}; R^2 = {out1['r2']:.4f}")
print(f"  beta(tp_proxy_impatience) = {out1['beta_tp_proxy_impatience']:+.4f}  (SE {out1['se_tp_proxy_impatience']:.4f})  p={out1['pval_tp_proxy_impatience']:.4g}")
print(f"  standardised beta(tp_std on bmi_std) = {out1s['beta_tp_std']:+.4f}")

# ---------- 7. Sensitivities ----------
# (a) BMI wave swap to 1989
def standardise_local(d):
    d = _to_float64(d.copy())
    d["asvab_std"] = (d["asvab_raw"] - d["asvab_raw"].mean()) / d["asvab_raw"].std(ddof=1)
    d["tp_std"]    = (d["tp_proxy_impatience"] - d["tp_proxy_impatience"].mean()) / d["tp_proxy_impatience"].std(ddof=1)
    return d

A89 = df.loc[mask_tp & mask_inc & mask_dem & mask_par & mask_asvab & df["bmi89"].notna()].pipe(standardise_local)
res89, out89 = ols_fit(A89, "bmi89", primary_x, "sens_bmi89: BMI_1989 ~ tp + controls")

A92 = df.loc[mask_tp & mask_inc & mask_dem & mask_par & mask_asvab & df["bmi92"].notna()].pipe(standardise_local)
res92, out92 = ols_fit(A92, "bmi92", primary_x, "sens_bmi92: BMI_1992 ~ tp + controls")

# (b) Drop ASVAB control (larger sample)
xs_no_asv = ["tp_proxy_impatience","log_inc89","age_at_81","female",
             "race_black","race_hispanic","famsz79","momed","daded"]
A_no_asv = _to_float64(df.loc[mask_bmi81 & mask_tp & mask_inc & mask_dem & mask_par].copy())
res_na, out_na = ols_fit(A_no_asv, "bmi81", xs_no_asv, "sens_no_asvab: BMI_1981 ~ tp + controls (no asvab)")

rho_a, p_a = spearmanr(A_no_asv["tp_proxy_impatience"], A_no_asv["bmi81"])
out_na["spearman_rho"] = float(rho_a)
out_na["spearman_p"]   = float(p_a)

# (c) Substitute sav_impatient for dWealthRel proxy (1989 savings fallback)
df["sav_imp_withinc"] = df["sav_impatient"].where(df["sav_impatient"].notna() & df["log_inc89"].notna())
mask_sav = (df["bmi81"].notna() & df["sav_imp_withinc"].notna()
            & mask_inc & mask_dem & mask_par & mask_asvab)
A_sav = df.loc[mask_sav].pipe(standardise_local)
xs_sav = ["sav_imp_withinc","log_inc89","age_at_81","female","race_black","race_hispanic",
          "famsz79","momed","daded","asvab_std"]
res_sa, out_sa = ols_fit(A_sav, "bmi81", xs_sav, "sens_sav89: BMI_1981 ~ sav_impatient + controls")

# (d) Ablation: drop one control at a time
ablation = {}
for drop in [None, "log_inc89", "momed", "daded", "asvab_std", "famsz79"]:
    xs = list(primary_x)
    if drop is not None: xs.remove(drop)
    res_a, _ = ols_fit(ASAMP, "bmi81", xs, f"ablation_drop_{drop}")
    ablation[f"drop_{drop}"] = {
        "n": int(res_a.nobs),
        "beta_tp_proxy_impatience": float(res_a.params["tp_proxy_impatience"]),
        "se": float(res_a.bse["tp_proxy_impatience"]),
        "p": float(res_a.pvalues["tp_proxy_impatience"])}

# (e) Patience-direction check (Spearman with the original dWealthRel; expect sign opposite to impatience side)
rho_p, p_p = spearmanr(ASAMP["dWealthRel"], ASAMP["bmi81"])
out_patience = {"spearman_rho_BMI81_vs_dWealthRel_(patience)": float(rho_p),
                "spearman_pvalue": float(p_p),
                "note": "Higher dWealthRel = MORE PATIENT. Expect sign opposite to tp_proxy_impatience."}

# (f) Sex-stratified primary (drop sex from controls)
xs_nosex = [x for x in primary_x if x != "female"]
res_m, out_m = ols_fit(ASAMP[ASAMP["female"]==0], "bmi81", xs_nosex, "primary_MALE")
res_f, out_f = ols_fit(ASAMP[ASAMP["female"]==1], "bmi81", xs_nosex, "primary_FEMALE")

# ---------- 8. Final artefacts: coeffs.json, run_log.txt, hypothesis.txt ----------
coeffs = {
    "primary": out1,
    "primary_standardised": out1s,
    "spearman": spearman_out,
    "spearman_patience_direction_check": out_patience,
    "sensitivities": {
        "bmi1989_spec": out89,
        "bmi1992_spec": out92,
        "no_asvab_spec": out_na,
        "savings89_proxy_spec": out_sa,
        "ablation_tp_coefficient_only": ablation,
        "sex_MALE_spec": out_m,
        "sex_FEMALE_spec": out_f,
    },
    "design": {
        "y_primary": "bmi81 = (w81/2.205) / (h81_in*0.0254)^2; w81 lbs confirmed; h81 feet*100+inches decoded",
        "tp_proxy": "tp_proxy_impatience = -((nw90-nw85)/mean(inc85,inc89)), winsorized [1,99] pct. Higher = more impatient.",
        "controls": primary_x,
        "weights_yaml": "no complex survey weights applied (none provided); HC1 robust SE.",
        "missingness_strategy": "listwise deletion + missingness-pattern funnel artefact",
        "sample_size_primary_N": int(ASAMP.shape[0]),
    },
}
def jsonable(x):
    if isinstance(x, dict): return {k: jsonable(v) for k,v in x.items()}
    if isinstance(x, list): return [jsonable(v) for v in x]
    if isinstance(x, (np.floating,)): return float(x)
    if isinstance(x, (np.integer,)):  return int(x)
    if isinstance(x, (np.ndarray,)):  return x.tolist()
    return x
with open("/workspace/artifacts/coeffs.json","w") as f:
    json.dump(jsonable(coeffs), f, indent=2)

PRIMARY_BETA = out1["beta_tp_proxy_impatience"]
PRIMARY_SE   = out1["se_tp_proxy_impatience"]
PRIMARY_P    = out1["pval_tp_proxy_impatience"]
STD_TP_BETA  = out1s["beta_tp_std"]
SPEARMAN_RHO = rho
SPEARMAN_P   = p_rho
SENS89_BETA  = out89["beta_tp_proxy_impatience"]
SENS89_P     = out89["pval_tp_proxy_impatience"]
SENS92_BETA  = out92["beta_tp_proxy_impatience"]
SENS92_P     = out92["pval_tp_proxy_impatience"]

hypo = textwrap.dedent(f"""\
HYPOTHESIS (data-grounded, associational, NOT causal):

Among NLSY79 respondents with non-missing data on the analysis variables, higher
behavioral impatience — operationalised as the SIGN-FLIPPED 1985-to-1990 net
family-wealth accumulation rate ((NW_1990 - NW_1985) / mean(Income_1985, Income_1989),
winsorized at the 1st/99th percentiles, then negated so that higher values mean
more impatient) — is positively associated with self-reported BMI in 1981
(BMI computed from the lbs-resolved height-decoded self-reported weight and height).

Quantitative support (analysis N = {int(ASAMP.shape[0])}):
- Primary OLS (BMI_1981 ~ tp_proxy_impatience + log(Income_1989) + age_at_81 + female
  + race dummies + family size + parental education + standardised ASVAB composite;
  HC1 robust SE; listwise deletion): beta on tp_proxy_impatience = {PRIMARY_BETA:+.4f}
  BMI units per one-unit impatience (SE {PRIMARY_SE:.4f}); p = {PRIMARY_P:.3g}.
  On the standardised pair (BMI z-score ~ tp z-score), beta = {STD_TP_BETA:+.4f}.
- Spearman rank correlation between tp_proxy_impatience and BMI_1981 in the same
  primary analysis pool: rho = {SPEARMAN_RHO:+.4f}, p = {SPEARMAN_P:.3g}.
  This is the more defensible univariate summary because BMI is right-skewed
  and Pearson understates monotone association under skew.

Robustness across waves:
- BMI swap to 1989 (w89 x h85): beta = {SENS89_BETA:+.4f}, p = {SENS89_P:.3g}.
- BMI swap to 1992 (w92 x h85 carry): beta = {SENS92_BETA:+.4f}, p = {SENS92_P:.3g}.

Caveats: cross-sectional/observational association; no elicited beta/delta
(time preference is a behavioural proxy based on observed savings / wealth
accumulation); partial-income controls do not fully separate impatience from
other liquidity/credit-constraint channels; attrition by 1992 (BMI_1992 missing
30%) may bias sensitivity estimates; the regression is associational only —
the question stem's "leads to" is interpreted as a positive correlation between
impatience-proxy and BMI, not a causal effect.
""").strip()

print("\n=== HYPOTHESIS ===\n" + hypo + "\n")

with open("/workspace/artifacts/hypothesis.txt","w") as f:
    f.write(hypo + "\n")

with open("/workspace/artifacts/run_log.txt","w") as f:
    f.write("=== NLSY79 BMI ~ impatience-proxy — run log ===\n")
    f.write(f"N input: {N}\n")
    f.write(f"Primary N (listwise): {int(ASAMP.shape[0])}\n")
    f.write(f"Winsorize rules: weight 50..400 lbs; tp_ratio ratio clipped to [1,99] pct; log-income/wealth clipped at 1.\n")
    f.write(f"h81 decoding: feet*12 + inches (encoded feet*100+inches)\n")
    f.write(f"Sex  : {ASAMP['female'].mean():.3f} female\n")
    f.write(f"Race : black {ASAMP['race_black'].mean():.3f}; hispanic {ASAMP['race_hispanic'].mean():.3f}\n")
    f.write(f"Age_at_81 mean (sd): {ASAMP['age_at_81'].mean():.2f} ({ASAMP['age_at_81'].std():.2f})\n")
    f.write(f"BMI81 mean (sd): {ASAMP['bmi81'].mean():.3f} ({ASAMP['bmi81'].std():.3f})\n")
    f.write(f"\n=== Primary OLS ===\n")
    f.write(f"  beta(tp_proxy_impatience) = {PRIMARY_BETA:+.6f}\n")
    f.write(f"  robust SE              = {PRIMARY_SE:.6f}\n")
    f.write(f"  p-value                = {PRIMARY_P:.6g}\n")
    f.write(f"  N                      = {int(ASAMP.shape[0])}\n")
    f.write(f"  R^2                    = {out1['r2']:.4f}\n")
    f.write(f"  standardised beta(tp_std|bmi_std) = {STD_TP_BETA:+.6f}\n")
    f.write(f"\n=== Spearman rho (BMI81, tp_impatience) ===\n")
    f.write(f"  rho = {SPEARMAN_RHO:+.6f}; p = {SPEARMAN_P:.6g}\n")
    f.write(f"\n=== Sensitivity: BMI wave swap ===\n")
    f.write(f"  BMI_1989 beta = {SENS89_BETA:+.6f}; p = {SENS89_P:.6g}\n")
    f.write(f"  BMI_1992 beta = {SENS92_BETA:+.6f}; p = {SENS92_P:.6g}\n")
    f.write("\n=== HYPOTHESIS ===\n" + hypo + "\n")
print("All artefacts written to /workspace/artifacts/")
