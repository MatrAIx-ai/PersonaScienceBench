"""
Stage=result analysis for the question:
  'Between which years did the largest increases in median wealth occur among black females?'

Subgroup definition (mirrors datasets.json variable names):
  race == "black" AND sex == "female"  (n = 1548)

Variables used (exact names from datasets.json):
  composite_wealth_1985, composite_wealth_1990, composite_wealth_1996

Headline metric (per researcher sign-off):
  Cross-sectional median wealth at each wave, ranked by raw-$ absolute delta
  between consecutive intervals.
"""
import json, pandas as pd, numpy as np

CSV_PATH = "data/nls_incarceration_processed.csv"
df = pd.read_csv(CSV_PATH)

bf = df[(df["race"] == "black") & (df["sex"] == "female")].copy()
col85, col90, col96 = "composite_wealth_1985", "composite_wealth_1990", "composite_wealth_1996"
cols = [col85, col90, col96]
by_year = {1985: bf[col85], 1990: bf[col90], 1996: bf[col96]}

assert len(bf) == 1548
for y, s in by_year.items():
    assert s.notna().sum() == 1548

# ---- Wave-level expert stats ------------------------------------------------
wave_stats = {}
for y, s in by_year.items():
    nonzero = s[s != 0]
    wave_stats[str(y)] = {
        "n": int(s.notna().sum()),
        "median_raw_usd":       float(s.median()),
        "median_nonzero_raw_usd": float(nonzero.median()),
        "mean_raw_usd":         float(s.mean()),
        "iqr_raw_usd":          float(s.quantile(.75) - s.quantile(.25)),
        "p10_raw_usd":          float(s.quantile(.10)),
        "p90_raw_usd":          float(s.quantile(.90)),
        "share_zero":           float((s == 0).mean()),
        "share_negative":       float((s < 0).mean()),
        "median_winsorized_1pct_raw_usd":
            float(s.clip(lower=s.quantile(.01), upper=s.quantile(.99)).median()),
    }

# ---- Headline: cross-sectional raw-$ absolute Δmedian -----------------------
intervals = [(1985, 1990, 5), (1990, 1996, 6)]
deltas = {}
for a, b, span in intervals:
    ma, mb = wave_stats[str(a)]["median_raw_usd"], wave_stats[str(b)]["median_raw_usd"]
    deltas[f"{a}->{b}"] = {
        "median_a_raw_usd": ma,
        "median_b_raw_usd": mb,
        "abs_delta_raw_usd": mb - ma,
        "pct_delta":         (mb - ma) / ma * 100.0 if ma != 0 else None,
        "annualized_abs_delta_raw_usd_per_year": (mb - ma) / span,
        "span_years":        span,
    }

headline_winner = max(deltas.keys(), key=lambda k: deltas[k]["abs_delta_raw_usd"])
runner_up      = min(deltas.keys(), key=lambda k: deltas[k]["abs_delta_raw_usd"])

# ---- Sensitivity checks ---------------------------------------------------
# (a) % change in cross-sectional median
pct_rank = sorted(deltas.keys(),
                  key=lambda k: deltas[k]["pct_delta"] or -float("inf"),
                  reverse=True)
# (b) annualized $/yr cross-sectional
ann_rank = sorted(deltas.keys(),
                  key=lambda k: deltas[k]["annualized_abs_delta_raw_usd_per_year"],
                  reverse=True)
# (c) paired within-person median difference
sensitivity_paired = {}
for a, b, _ in intervals:
    diffs = by_year[b] - by_year[a]
    sensitivity_paired[f"{a}->{b}"] = {
        "median_paired_diff_raw_usd": float(diffs.median()),
        "mean_paired_diff_raw_usd":   float(diffs.mean()),
        "n": int(diffs.notna().sum()),
    }
paired_rank = sorted(sensitivity_paired.keys(),
                     key=lambda k: sensitivity_paired[k]["median_paired_diff_raw_usd"],
                     reverse=True)

# (d) median restricted to nonzero rows
sensitivity_nonzero = {}
for a, b, _ in intervals:
    ma = wave_stats[str(a)]["median_nonzero_raw_usd"]
    mb = wave_stats[str(b)]["median_nonzero_raw_usd"]
    sensitivity_nonzero[f"{a}->{b}"] = {
        "median_nonzero_a_raw_usd": ma,
        "median_nonzero_b_raw_usd": mb,
        "abs_delta_nonzero_raw_usd": mb - ma,
    }
nonzero_rank = sorted(sensitivity_nonzero.keys(),
                      key=lambda k: sensitivity_nonzero[k]["abs_delta_nonzero_raw_usd"],
                      reverse=True)

# ---- Ranking summary -------------------------------------------------------
rank_summary = {
    "headline_raw_$_abs_delta_in_cross_sectional_median": {
        "winner": headline_winner,
        "runner_up": runner_up,
    },
    "sensitivity_pct_change_in_cross_sectional_median": {
        "winner": pct_rank[0],
        "runner_up": pct_rank[1],
        "agrees_with_headline": pct_rank[0] == headline_winner,
    },
    "sensitivity_annualized_$_per_year_cross_sectional": {
        "winner": ann_rank[0],
        "runner_up": ann_rank[1],
        "agrees_with_headline": ann_rank[0] == headline_winner,
    },
    "sensitivity_paired_within_person_median_of_differences": {
        "winner": paired_rank[0],
        "runner_up": paired_rank[1],
        "agrees_with_headline": paired_rank[0] == headline_winner,
    },
    "sensitivity_median_on_nonzero_only_rows": {
        "winner": nonzero_rank[0],
        "runner_up": nonzero_rank[1],
        "agrees_with_headline": nonzero_rank[0] == headline_winner,
        "interpretation_note": (
            "FLIPS ranking: among BF respondents with nonzero wealth, "
            "median wealth grew faster 1990->1996 (+$11,700) than "
            "1985->1990 (+$4,268). The headline metric (all rows, "
            "including ~30-40% zeros and ~7% negatives) prefers "
            "1985->1990. This is consistent with the zero-mass "
            "shrinking in 1985->1990 (39.9%->29.4% share_zero) and "
            "staying flat in 1990->1996 (29.4%->31.7%): the early "
            "period's median gain is partially a share-zero effect, "
            "while the later period's gain accrues to the already-"
            "positive-wealth subgroup."
        ),
    },
}

result = {
    "subgroup_definition": {"race": "black", "sex": "female", "n": 1548},
    "variables_used":      cols,
    "units":               "raw U.S. dollars; no CPI adjustment applied",
    "missingness_in_subset": "0 missing on any of the 3 wealth columns; balanced panel",
    "wave_stats":          wave_stats,
    "headline_deltas":     deltas,
    "headline_winner":     headline_winner,
    "runner_up":           runner_up,
    "sensitivity_paired":  sensitivity_paired,
    "sensitivity_nonzero": sensitivity_nonzero,
    "ranking_summary":     rank_summary,
    "all_metrics_agree":   all(
        rank_summary[k]["agrees_with_headline"]
        for k in rank_summary
        if "agrees_with_headline" in rank_summary[k]
    ),
}

with open("results/analysis.json", "w") as f:
    def default(o):
        if isinstance(o, (np.integer,)):  return int(o)
        if isinstance(o, (np.floating,)): return float(o)
        if isinstance(o, (np.ndarray,)):  return o.tolist()
        raise TypeError(repr(o))
    json.dump(result, f, indent=2, default=default)

print(json.dumps(result, indent=2, default=default))
