"""BA-degree completion: nested regression sweep on NLS-SES."""
import json, warnings
import numpy as np
import pandas as pd
import statsmodels.api as sm
from statsmodels.stats.outliers_influence import variance_inflation_factor

warnings.filterwarnings("ignore")

df_raw = pd.read_csv("/workspace/data/nls_ses_processed.csv")
df = df_raw.drop(columns=[c for c in ("Unnamed: 0","CASE ID") if c in df_raw.columns]).copy()
N_TOTAL = len(df)
assert df.isna().sum().sum() == 0, "Unexpected missingness"

RACE   = "SAMPLE_RACE"
SEX    = "SAMPLE_SEX"
FAMSZ  = "FAMILY SIZE OF SAMPLE"
ABILITY = "ABILITY: COMPOSITE OF ASVAB SCORE"
PCTILE = "PERCENTILE IN CLASS"
SES    = "SES"
Y      = "BA DEGREE COMPLETED"

CONT_CANDIDATES  = [SES, ABILITY, PCTILE, FAMSZ]
ACADEMIC_BLOCK   = [ABILITY, PCTILE]
CANDIDATE_SET    = [SES, SEX, FAMSZ, ABILITY, PCTILE]

df_std = df.copy()
for c in CONT_CANDIDATES:
    df_std[c] = (df[c] - df[c].mean()) / df[c].std(ddof=0)

def race_dummies(d, ref):
    return (pd.get_dummies(d[RACE], prefix=RACE, drop_first=False)
              .drop(columns=[f"{RACE}_{ref}"])
              .astype(float))

def sex_dummy_numeric(d):
    out = (d[SEX] == "Male").astype(float).to_frame()
    out.columns = [f"{SEX}_Male"]
    return out

def target_numeric(d, target):
    if target == SEX:
        return sex_dummy_numeric(d)
    return d[[target]].astype(float)

def var_label_for_target(target):
    if target == SEX:
        return f"{SEX}_Male"
    return target

def fit_model(endog, exog, family_link):
    if family_link == "logit":
        model = sm.GLM(endog, exog, family=sm.families.Binomial(link=sm.families.links.Logit()))
    elif family_link == "probit":
        model = sm.GLM(endog, exog, family=sm.families.Binomial(link=sm.families.links.Probit()))
    elif family_link == "ols":
        model = sm.OLS(endog, exog)
    else:
        raise ValueError(family_link)
    return model.fit(cov_type="HC1")

def extract_row(result, var_label):
    coef = result.params[var_label]
    se   = result.bse[var_label]
    ci   = result.conf_int().loc[var_label]
    p    = result.pvalues[var_label]
    N    = int(result.nobs)
    return pd.Series({"coef": float(coef), "se": float(se),
                      "ci_lo": float(ci[0]), "ci_hi": float(ci[1]),
                      "p": float(p), "N": N})

def assemble_exog(d, target, model_id, race_ref):
    race = race_dummies(d, race_ref)
    sex  = sex_dummy_numeric(d)
    n = len(d)
    parts = [sm.add_constant(pd.Series(np.ones(n), index=d.index, name="const"))]
    parts.append(target_numeric(d, target))
    if model_id >= 2 and target != RACE:
        parts.append(race)
    if model_id >= 3:
        acad = [c for c in ACADEMIC_BLOCK if c != target]
        if acad:
            parts.append(d[acad].astype(float))
    if model_id == 4:
        already = {target} | set(ACADEMIC_BLOCK) | {SEX, RACE}
        for c in CANDIDATE_SET:
            if c not in already:
                if c == SEX:
                    parts.append(sex)
                else:
                    parts.append(d[[c]].astype(float))
    X = pd.concat(parts, axis=1).astype(float)
    return X

def run_sweep(race_ref, family_link="logit"):
    rows = []
    for target in CANDIDATE_SET:
        for mid in [1, 2, 3, 4]:
            X = assemble_exog(df_std, target, mid, race_ref)
            y = df_std[Y].astype(float)
            res = fit_model(y, X, family_link=family_link)
            lab = var_label_for_target(target)
            row = extract_row(res, lab)
            row["target"] = target
            row["model"]  = f"M{mid}"
            row["family"] = family_link
            row["race_ref"] = race_ref
            rows.append(row)
    return pd.DataFrame(rows)

sweep_logit_white  = run_sweep(race_ref="White", family_link="logit")
sweep_logit_black  = run_sweep(race_ref="Black", family_link="logit")
sweep_probit_white = run_sweep(race_ref="White", family_link="probit")
sweep_ols_white    = run_sweep(race_ref="White", family_link="ols")

def pretty(s):
    s = s.copy()
    for col in ["coef","se","ci_lo","ci_hi"]:
        s[col] = s[col].map(lambda v: f"{v:+.4f}")
    s["p"] = s["p"].map(lambda v: f"{v:.4g}")
    s["N"] = s["N"].astype(int)
    return s[["target","model","coef","se","ci_lo","ci_hi","p","N"]]

def identify_flip(sweep, target_pos=0.3636, target_neg=-0.2293,
                  tol_pos=0.10, tol_neg=0.10, p_sig=0.05):
    out = []
    for t in CANDIDATE_SET:
        sub = sweep[sweep.target == t].set_index("model")
        m1, m2, m3 = sub.loc["M1"], sub.loc["M2"], sub.loc["M3"]
        c = {"target": t, "M1": m1, "M2": m2, "M3": m3,
             "delta": m3.coef - m1.coef,
             "signflip": bool(m1.coef > 0 and m3.coef < 0),
             "pos_match": bool(
                 (abs(m1.coef - target_pos) < tol_pos and m1.p < p_sig) or
                 (abs(m2.coef - target_pos) < tol_pos and m2.p < p_sig)),
             "neg_match": bool(abs(m3.coef - target_neg) < tol_neg and m3.p > p_sig)}
        out.append(c)
    def score(c):
        s = 0
        if c["pos_match"]: s += 100
        if c["neg_match"]: s += 100
        if c["signflip"]:  s += 50
        s -= abs(abs(c["delta"]) - (target_pos - target_neg))
        return s
    return sorted(out, key=score, reverse=True)

ranked = identify_flip(sweep_logit_white)
TOP = ranked[0]

def vif_table(target, race_ref="White"):
    X = assemble_exog(df_std, target, model_id=4, race_ref=race_ref).drop(columns=["const"])
    rows = [(c, float(variance_inflation_factor(X.values, i))) for i, c in enumerate(X.columns)]
    return pd.DataFrame(rows, columns=["variable","VIF"]).sort_values("VIF", ascending=False)

def assemble_exog_acadsens(d, target, race_ref, subset):
    parts = [sm.add_constant(pd.Series(np.ones(len(d)), index=d.index, name="const"))]
    parts.append(target_numeric(d, target))
    parts.append(race_dummies(d, race_ref))
    parts.append(d[subset].astype(float))
    X = pd.concat(parts, axis=1).astype(float)
    return X

def sensitivity_block(target, race_ref):
    out = []
    for label, subset in [("PERCENTILE+ABILITY", [PCTILE, ABILITY]),
                          ("PERCENTILE-only",    [PCTILE])]:
        X = assemble_exog_acadsens(df_std, target, race_ref, subset)
        y = df_std[Y].astype(float)
        res = fit_model(y, X, family_link="logit")
        row = extract_row(res, target if target != SEX else f"{SEX}_Male")
        row["academic_block"] = label
        row["race_ref"] = race_ref
        out.append(row)
    return pd.DataFrame(out)

def triangulation(target, race_ref="White", model_id=3):
    X = assemble_exog(df_std, target, model_id, race_ref)
    y = df_std[Y].astype(float)
    rows = []
    for link in ["logit","probit","ols"]:
        res = fit_model(y, X, family_link=link)
        row = extract_row(res, target if target != SEX else f"{SEX}_Male")
        row["link"]   = link
        row["model"]  = f"M{model_id}"
        row["target"] = target
        rows.append(row)
    return pd.DataFrame(rows)

