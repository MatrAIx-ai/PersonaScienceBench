hr("C. RANKING - which target matches +0.3636 -> -0.2293?")
for c in ranked:
    print(f"\nTarget: {c['target']}   (design label: {var_label_for_target(c['target'])})")
    print(f"  M1: coef={c['M1'].coef:+.4f}  95%CI=({c['M1'].ci_lo:+.4f},{c['M1'].ci_hi:+.4f})  p={c['M1'].p:.4g}")
    print(f"  M2: coef={c['M2'].coef:+.4f}  95%CI=({c['M2'].ci_lo:+.4f},{c['M2'].ci_hi:+.4f})  p={c['M2'].p:.4g}")
    print(f"  M3: coef={c['M3'].coef:+.4f}  95%CI=({c['M3'].ci_lo:+.4f},{c['M3'].ci_hi:+.4f})  p={c['M3'].p:.4g}")
    print(f"  delta M1->M3 = {c['delta']:+.4f}; sign-flip M1->M3 = {c['signflip']}")
    print(f"  matches +0.3636 (M1 or M2) significant : {c['pos_match']}")
    print(f"  matches -0.2293 (M3) insignificant    : {c['neg_match']}")

focus = []
for mid in ["M1","M2","M3","M4"]:
    sub = sweep_logit_white[(sweep_logit_white.target == t) & (sweep_logit_white.model == mid)].iloc[0]
    focus.append({"model": mid, "coef (target)": sub.coef, "robust SE": sub.se,
                  "95% CI low": sub.ci_lo, "95% CI high": sub.ci_hi,
