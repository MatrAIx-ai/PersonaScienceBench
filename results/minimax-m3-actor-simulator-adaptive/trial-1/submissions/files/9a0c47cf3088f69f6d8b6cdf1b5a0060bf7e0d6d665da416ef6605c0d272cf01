import pandas as pd
import numpy as np
import json, hashlib

p1 = "/workspace/data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"

df = pd.read_csv(p1)
print("Total rows CSV1:", len(df))
print("Columns present among needed: project=", 'project' in df.columns, " length=", 'length' in df.columns,
      " title=", 'title' in df.columns, " authors.o=", 'authors.o' in df.columns, " pub_year=", 'pub_year' in df.columns)
print("dtypes subset:")
print(df[['project','length','title','authors.o','pub_year']].dtypes)
print()

# Step 2: filter
targets = {'ee':'Experimental Economics', 'rpp':'Psychology'}
df_e = df.loc[df['project']=='ee'].copy()
df_p = df.loc[df['project']=='rpp'].copy()
print(f"Rows project=='ee': {len(df_e)}")
print(f"Rows project=='rpp': {len(df_p)}")

# Step 3: missing length
def missing_report(sub, label):
    n_total = len(sub)
    n_na = sub['length'].isna().sum()
    print(f"[{label}] total rows={n_total}, missing 'length'={n_na}, kept={n_total-n_na}")
    return sub.dropna(subset=['length']).copy()

ee_clean = missing_report(df_e, 'ee')
pp_clean = missing_report(df_p, 'rpp')

# Step 4: anomalies
def anomaly_report(sub, label):
    s = sub['length']
    zero  = int((s == 0).sum())
    neg   = int((s < 0).sum())
    # quick look at extremes
    print(f"[{label}] anomaly check — zero={zero}, negative={neg}")
    print(f"[{label}] length describe:\n{s.describe().to_string()}")
    return zero, neg

print("\n--- ANOMALY CHECK ---")
ee_anom = anomaly_report(ee_clean, 'ee')
pp_anom = anomaly_report(pp_clean, 'rpp')

# Step 5: row-level stats
def stats(sub, label):
    s = sub['length']
    n  = int(s.notna().sum())
    mean = float(s.mean())
    median = float(s.median())
    mn = float(s.min())
    mx = float(s.max())
    sd = float(s.std(ddof=1)) if n > 1 else float('nan')
    print(f"\n[{label}] row-level stats:")
    print(f"  n={n}, mean={mean:.4f}, median={median:.4f}, min={mn:.4f}, max={mx:.4f}, sd={sd:.4f}")
    return dict(n=n, mean=mean, median=median, min=mn, max=mx, sd=sd)

print("\n--- ROW-LEVEL STATS ---")
ee_stats = stats(ee_clean, 'ee')
pp_stats = stats(pp_clean, 'rpp')

# Step 6: dedup by original-paper identity
def make_id(sub):
    # composite: title + authors.o + pub_year, fallback to title if composite missing
    title = sub['title'].fillna('').astype(str).str.strip()
    auth  = sub['authors.o'].fillna('').astype(str).str.strip()
    py    = sub['pub_year'].astype(str)
    composite = (title + '||' + auth + '||' + py).str.strip('|')
    # fallback when composite is empty
    use_title = composite == ''
    pid = composite.where(~use_title, title)
    return pid

ee_clean['paper_id'] = make_id(ee_clean)
pp_clean['paper_id'] = make_id(pp_clean)

def dup_report(sub, label):
    n = len(sub)
    n_unique = sub['paper_id'].nunique(dropna=True)
    dup_rows = n - n_unique
    print(f"\n[{label}] paper identity: n_rows={n}, n_unique_papers={n_unique}, duplicate-rows={dup_rows}")
    if dup_rows > 0:
        vc = sub['paper_id'].value_counts()
        print(f"  top duplicated ids:")
        print(vc[vc>1].head(10).to_string())
    return n_unique

ee_unique = dup_report(ee_clean, 'ee')
pp_unique = dup_report(pp_clean, 'rpp')

def dedup_stats(sub, label):
    s = sub.drop_duplicates(subset=['paper_id'], keep='first')['length']
    n = int(s.notna().sum())
    mean = float(s.mean()); med = float(s.median())
    mn = float(s.min());  mx = float(s.max())
    sd = float(s.std(ddof=1)) if n>1 else float('nan')
    print(f"\n[{label}] DEDUP row-level stats (n=n_unique={n}):")
    print(f"  n={n}, mean={mean:.4f}, median={med:.4f}, min={mn:.4f}, max={mx:.4f}, sd={sd:.4f}")
    return dict(n=n, mean=mean, median=med, min=mn, max=mx, sd=sd)

print("\n--- DEDUPLICATED BY ORIGINAL-PAPER STATS ---")
ee_dedup = dedup_stats(ee_clean, 'ee')
pp_dedup = dedup_stats(pp_clean, 'rpp')

# Also show individual rows for transparency
print("\n--- ROWS USED (ee) ---")
print(ee_clean[['id','title','authors.o','pub_year','length']].to_string(index=False))
print("\n--- ROWS USED (rpp) ---")
print(pp_clean[['id','title','authors.o','pub_year','length']].to_string(index=False))

# Compact summary for payload
summary = dict(
    ee_row=ee_stats, pp_row=pp_stats,
    ee_dedup=ee_dedup, pp_dedup=pp_dedup,
    ee_n_total=len(df_e), pp_n_total=len(df_p),
