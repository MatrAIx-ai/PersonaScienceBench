"""
BixBench / DiscoveryBench analysis:
'Between which years did the largest increases in median wealth occur among black females?'

Dataset: data/nls_incarceration_processed.csv (NLS 1979 cohort, processed)
Subgroup: race == 'black' AND sex == 'female'
Wealth variables: composite_wealth_1985, composite_wealth_1990, composite_wealth_1996
"""

import json
import pandas as pd

CSV = "data/nls_incarceration_processed.csv"
YEARS = [1985, 1990, 1996]
COLS = {y: f"composite_wealth_{y}" for y in YEARS}

# ---- 1. Load and subset ----
df = pd.read_csv(CSV)
bf = df[(df["race"] == "black") & (df["sex"] == "female")].copy()

print(f"[load] total rows: {len(df)}")
print(f"[subset] race=='black' AND sex=='female': n = {len(bf)}")
print(f"[missing] in BF wealth cols: " + ", ".join(
    f"{c}={bf[c].isna().sum()}" for c in COLS.values()
))
print(f"[jail] BF ever_jailed==1: {(bf['ever_jailed']==1).sum()}")

# ---- 2. Median wealth per year (BF) ----
medians = {y: float(bf[COLS[y]].median()) for y in YEARS}
print("\n[median] composite wealth, BF subgroup:")
for y in YEARS:
    print(f"  {y}: median = ${medians[y]:,.0f}  (n={bf[COLS[y]].notna().sum()})")

# ---- 3. Pairwise deltas: all three C(3,2) intervals ----
intervals = [
    ("1985->1990", 1985, 1990),
    ("1990->1996", 1990, 1996),
    ("1985->1996 (cumulative)", 1985, 1996),
]
print("\n[increases] absolute Δ median wealth (USD) and % change:")
results = []
for name, y1, y2 in intervals:
    a, b = medians[y1], medians[y2]
    d_abs = b - a
    d_pct = (d_abs / a) * 100.0 if a != 0 else float("nan")
    results.append({"interval": name, "from": y1, "to": y2,
                    "median_from": a, "median_to": b,
                    "delta_abs_usd": d_abs, "delta_pct": d_pct})
    print(f"  {name}: ${a:,.0f} -> ${b:,.0f} | Δ = ${d_abs:+,.0f} ({d_pct:+.1f}%)")

# ---- 4. Headline ranking among ADJACENT intervals (per approved plan) ----
adjacent = [r for r in results if not r["interval"].endswith("(cumulative)")]
adjacent.sort(key=lambda r: r["delta_abs_usd"], reverse=True)
print("\n[adjacent-interval ranking] by absolute Δ median wealth:")
for r in adjacent:
    print(f"  {r['interval']}: Δ=${r['delta_abs_usd']:+,.0f} ({r['delta_pct']:+.1f}%)")
largest_adj = adjacent[0]
print(f"\n[LARGEST ADJACENT INCREASE] {largest_adj['interval']}: "
      f"${largest_adj['median_from']:,.0f} -> ${largest_adj['median_to']:,.0f} "
      f"(Δ=${largest_adj['delta_abs_usd']:+,.0f}, {largest_adj['delta_pct']:+.1f}%)")

# ---- 5. Persist a small JSON next to the script for reproducibility ----
out = {
    "subgroup": {"race": "black", "sex": "female", "n": int(len(bf))},
    "ever_jailed_bf": int((bf["ever_jailed"] == 1).sum()),
    "medians_usd": medians,
    "intervals": results,
    "largest_adjacent_increase": largest_adj["interval"],
}
with open("analysis/black_female_wealth_results.json", "w") as f:
    json.dump(out, f, indent=2)
print("\n[wrote] analysis/black_female_wealth_results.json")
print("[done]")
