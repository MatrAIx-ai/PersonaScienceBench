"""
Descriptive analysis: median composite_wealth_1985 by race x sex
among individuals who were ever_jailed == 1 (jailed 1985-1994).

Per researcher scope: keep literal 'hipanic' label, no recoding, no
inferential tests, no weighting, retain negative wealth values.
"""
import pandas as pd

PATH = "data/nls_incarceration_processed.csv"
df = pd.read_csv(PATH)

# Sanity
print("Shape:", df.shape)
print("Columns:", list(df.columns))
print("ever_jailed values:", df["ever_jailed"].value_counts().to_dict())

# Filter
sub = df[df["ever_jailed"] == 1].copy()
print("\nN ever_jailed == 1:", len(sub))

# Cell counts and medians within ever_jailed subset
cell = (
    sub.groupby(["race", "sex"])["composite_wealth_1985"]
       .agg(n="size", median="median")
       .reset_index()
)
print("\n=== Per-cell (race x sex) within ever_jailed == 1 ===")
print(cell.to_string(index=False))

# Overall median within ever_jailed subset (reference)
overall_median = sub["composite_wealth_1985"].median()
overall_n = len(sub)
print(f"\nOverall median composite_wealth_1985 among ever_jailed == 1: "
      f"${overall_median:,.0f}  (n={overall_n})")

# Full-sample medians by race x sex (context)
full = (
    df.groupby(["race", "sex"])["composite_wealth_1985"]
      .agg(n="size", median="median")
      .reset_index()
      .rename(columns={"n": "n_full", "median": "median_full"})
)
print("\n=== Full-sample medians (context) ===")
print(full.to_string(index=False))

context = cell.merge(full, on=["race", "sex"], how="left")
context["delta_vs_full"] = context["median"] - context["median_full"]
print("\n=== Ever-jailed subset medians vs. full-sample medians ===")
print(context.to_string(index=False))

# Disparity ratios
# 1) white vs black within ever_jailed (margin-pooled across sex)
white_med = sub.loc[sub["race"] == "white", "composite_wealth_1985"].median()
black_med = sub.loc[sub["race"] == "black", "composite_wealth_1985"].median()
ratio_w_b = white_med / black_med if black_med not in (0, None) else float("inf")
print(f"\nWhite vs Black within ever_jailed (pooled across sex): "
      f"white_median={white_med}, black_median={black_med}, "
      f"ratio_white/black={ratio_w_b:.2f}")

# 2) male vs female within race within ever_jailed
print("\n=== Male vs Female within race among ever_jailed == 1 ===")
for r in ["white", "black", "hipanic"]:
    m = sub.loc[(sub["race"] == r) & (sub["sex"] == "male"),
                "composite_wealth_1985"].median()
    f = sub.loc[(sub["race"] == r) & (sub["sex"] == "female"),
                "composite_wealth_1985"].median()
    if f == 0:
        ratio = float("inf") if m != 0 else float("nan")
    else:
        ratio = m / f
    print(f"  {r}: male_med={m}, female_med={f}, ratio_male/female={ratio}")

# Save the cell-medians table
out = cell.copy()
out["median_full_1985"] = out.merge(full, on=["race", "sex"])["median_full"].values
out["delta_vs_full"] = out["median"] - out["median_full_1985"]
out.to_csv("artifacts/cell_medians_ever_jailed.csv", index=False)

# Append the overall row
overall_row = pd.DataFrame([{"race": "_overall", "sex": "_all",
                             "n": overall_n, "median": overall_median}])
overall_row.to_csv("artifacts/overall_ever_jailed.csv", index=False)

print("\nWrote artifacts/cell_medians_ever_jailed.csv "
      "and artifacts/overall_ever_jailed.csv")
