"""
NLS 1979 cohort — black-female median wealth change between waves.

Question: Between which years did the largest increases in median wealth occur
among black females?

Headline decisions (per researcher approval, in priority order):
  (a) Headline metric = MEDIAN (the question explicitly says 'median wealth').
  (b) Headline framing = adjacent-wave intervals (1985->1990 vs 1990->1996);
      report the 1985->1996 full span only as a secondary diagnostic.
  (c) Retain negative and zero wealth values (NLS debt convention).
  (d) No bootstrap CI, no winsorisation, no log-transform, no re-derivation.

Inputs : data/nls_incarceration_processed.csv
Outputs: printed medians, three pairwise changes, and the identifier of the
         largest adjacent change; secondary full-span diagnostic; BF-mean
         footnote (does NOT change hypothesis).
"""

import pandas as pd

PATH = "data/nls_incarceration_processed.csv"

# ---- 1. Load & subset to black females -------------------------------------
df = pd.read_csv(PATH)
print(f"Loaded {PATH}: shape={df.shape}")
print(f"Race values: {sorted(df['race'].dropna().unique().tolist())}")
print(f"Sex values : {sorted(df['sex'].dropna().unique().tolist())}")
print(f"Missingness (NaN):\n{df.isna().sum().to_dict()}")

bf = df[(df["race"] == "black") & (df["sex"] == "female")].copy()
print(f"\nBlack-female subgroup N = {len(bf)}")

# ---- 2. Per-year valid N (transparency; full N here since no NaN) ----------
cols = ["composite_wealth_1985", "composite_wealth_1990", "composite_wealth_1996"]
for c in cols:
    print(f"  {c}: valid N = {bf[c].notna().sum()}, "
          f"negative = {(bf[c] < 0).sum()}, zero = {(bf[c] == 0).sum()}")

# ---- 3. Headline: raw medians at each year ---------------------------------
medians = {c: int(bf[c].median()) for c in cols}
print("\nBlack-female MEDIAN composite wealth (raw, USD):")
for yr, m in medians.items():
    print(f"  {yr}: ${m:,}")

# ---- 4. Pairwise median changes --------------------------------------------
m85, m90, m96 = medians[cols[0]], medians[cols[1]], medians[cols[2]]
d_90_85 = m90 - m85                # adjacent
d_96_90 = m96 - m90                # adjacent
d_96_85 = m96 - m85                # full span (secondary diagnostic)

print("\nPairwise MEDIAN changes (USD):")
print(f"  Δ(1990 - 1985) = ${d_90_85:,}")
print(f"  Δ(1996 - 1990) = ${d_96_90:,}")
print(f"  Δ(1996 - 1985) = ${d_96_85:,}  [secondary: full 11-year span]")

# ---- 5. Largest adjacent change --------------------------------------------
adj = {"1985 -> 1990": d_90_85, "1990 -> 1996": d_96_90}
best = max(adj, key=adj.get)
print(f"\nLargest ADJACENT median-wealth increase: {best} = +${adj[best]:,}")

# ---- 6. Robustness footnote: BF means (does NOT change hypothesis) ---------
means = {c: float(bf[c].mean()) for c in cols}
d_90_85_mean = means[cols[1]] - means[cols[0]]
d_96_90_mean = means[cols[2]] - means[cols[1]]
print("\n[Footnote] Black-female MEAN composite wealth (raw, USD):")
for yr, m in means.items():
    print(f"  {yr}: ${m:,.2f}")
print(f"  Mean Δ(1990 - 1985) = ${d_90_85_mean:,.2f}")
print(f"  Mean Δ(1996 - 1990) = ${d_96_90_mean:,.2f}")
print("  Under MEANS the largest adjacent increase is 1990 -> 1996; "
      "this is a robustness footnote only and does NOT change the median-led hypothesis.")
