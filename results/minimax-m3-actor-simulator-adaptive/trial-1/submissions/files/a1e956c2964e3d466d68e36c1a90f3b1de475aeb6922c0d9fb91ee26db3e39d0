import pandas as pd
import numpy as np
import os

DATA = "/workspace/data"

def banner(s):
    print("\n" + "=" * 80)
    print(s)
    print("=" * 80)

# ------------------------------------------------------------------
banner("1) temporal_trends_contingency_table.csv  (TSV)")
# ------------------------------------------------------------------
df_tt = pd.read_csv(os.path.join(DATA, "temporal_trends_contingency_table.csv"),
                    sep="\t")
df_tt.columns = [c.strip().strip('"').strip() for c in df_tt.columns]
for c in df_tt.columns:
    if df_tt[c].dtype == object:
        df_tt[c] = df_tt[c].astype(str).str.strip().str.strip('"').str.strip()
print(f"shape: {df_tt.shape}")
print(f"columns: {list(df_tt.columns)}")
print(df_tt.to_string(index=False))
print(f"\nUnique intro.period: {sorted(df_tt['introduction.period'].unique().tolist())}")
print(f"Unique pathway: {sorted(df_tt['pathway'].unique().tolist())}")
print(f"na counts: {df_tt.isna().sum().to_dict()}")
print(f"n range: {df_tt['n'].min()} - {df_tt['n'].max()}, sum={df_tt['n'].sum()}")
pv = df_tt.pivot_table(index="pathway", columns="introduction.period",
                       values="n", aggfunc="sum", fill_value=0)
print("\nPivot Pathway x intro.period (sum of n):")
print(pv)

# ------------------------------------------------------------------
banner("2) phylogenetic_tree.txt")
# ------------------------------------------------------------------
with open(os.path.join(DATA, "phylogenetic_tree.txt")) as f:
    tree_str = f.read().strip()
print(f"bytes: {len(tree_str)}, ends ';': {tree_str.endswith(';')}")
# Tidy parse: split on commas and parens
import re
leaves = re.findall(r"([A-Za-z]+_[A-Za-z0-9_\\-]+):", tree_str)
# Also catch leaves that occur without branch length (root child) — but seems all leaves have length
leaves = list(dict.fromkeys(leaves))  # preserve order, dedupe
print(f"distinct tip labels parsed: {len(leaves)}")
print(f"first 10: {leaves[:10]}")
print(f"last 5:  {leaves[-5:]}")

# ------------------------------------------------------------------
banner("3) invasion_success_pathways.csv")
# ------------------------------------------------------------------
df_is = pd.read_csv(os.path.join(DATA, "invasion_success_pathways.csv"))
print(f"shape: {df_is.shape}")
print(f"columns ({len(df_is.columns)}): {list(df_is.columns)}")
print(f"\ndtypes:")
print(df_is.dtypes)
print(f"\nUnique intro.pathway: {sorted(df_is['intro.pathway'].dropna().unique().tolist())}")
print("intro.pathway counts:")
print(df_is['intro.pathway'].value_counts(dropna=False).to_string())
print(f"phylo.tip.label nulls: {df_is['phylo.tip.label'].isna().sum()}, unique: {df_is['phylo.tip.label'].nunique()}")
print(f"missing values:\n{df_is.isna().sum()[df_is.isna().sum()>0].to_string()}")
print(f"\nKey numeric ranges:")
for c in ['number.of.invaded.plots','area.of.occupancy.10km','habitat.range',
         'invaded.niche.breadth','native.niche.breadth','mrt','height']:
    s = df_is[c]
    print(f"  {c:24s} min={s.min():>8.2f}  max={s.max():>8.2f}  mean={s.mean():>8.2f}  na={s.isna().sum()}")

# Cross-check overlap between tree tips and dataset
in_tree = set(leaves)
in_ds = set(df_is['phylo.tip.label'].dropna())
print(f"\nphylo.tip.label in dataset matched against tree tips: {len(in_ds & in_tree)}/{len(in_ds)}")
print(f"in dataset but not in tree: {sorted(in_ds - in_tree)[:10]}")
print(f"in tree but not in dataset: {len(in_tree - in_ds)}")

# ------------------------------------------------------------------
banner("4) invaded_niche_pathways.csv  (TSV)")
# ------------------------------------------------------------------
df_in = pd.read_csv(os.path.join(DATA, "invaded_niche_pathways.csv"), sep="\t")
df_in.columns = [c.strip().strip('"').strip() for c in df_in.columns]
# unquote any quoted categorical values
for c in df_in.columns:
    if df_in[c].dtype == object:
        df_in[c] = df_in[c].astype(str).str.strip().str.strip('"').str.strip()
        # Convert numeric-looking fields
        try:
            df_in[c] = pd.to_numeric(df_in[c])
        except (ValueError, TypeError):
            pass

print(f"shape: {df_in.shape}")
print(f"columns ({len(df_in.columns)}): {list(df_in.columns)}")
print("\ndtypes:")
print(df_in.dtypes.to_string())

print("\nmissing counts (col -> n):")
print(df_in.isna().sum()[df_in.isna().sum()>0].sort_values(ascending=False).to_string())

# Sum-check
df_in['_sum3'] = df_in['n.gard'] + df_in['n.unint'] + df_in['n.agfo']
df_in['_diff'] = df_in['_sum3'] - df_in['n.total']
print(f"\nRow-level sum-check n.gard+n.unint+n.agfo vs n.total:")
print(df_in['_diff'].describe())
print(f"# rows where sum != total: {(df_in['_diff']!=0).sum()} of {len(df_in)}")
mis = df_in.loc[df_in['_diff']!=0, ['habitat','n.gard','n.unint','n.agfo','n.total','_diff']]
print(f"\nup to 8 mismatched rows:\n{mis.head(8).to_string()}")

print(f"\nUnique habitat values ({df_in['habitat'].nunique()}):")
for h in sorted(df_in['habitat'].dropna().unique()):
    print(f"  - {h}  (n_rows={(df_in['habitat']==h).sum()})")

urban_cols = [c for c in df_in.columns if c.startswith('urban.')]
cropland_cols = [c for c in df_in.columns if c.startswith('cropland.')]
change_cols = [c for c in df_in.columns if 'progressive' in c or 'regressive' in c or 'no.changes' in c]
print(f"\nFound {len(urban_cols)} urban cols: {urban_cols}")
print(f"Found {len(cropland_cols)} cropland cols: {cropland_cols}")
print(f"Found {len(change_cols)} change cols: {change_cols}")

print("\nUrban ranges:")
for c in urban_cols:
    s = df_in[c]
    print(f"  {c:22s}  min={s.min():6.3f}  max={s.max():6.3f}  mean={s.mean():6.3f}  med={s.median():6.3f}  na={s.isna().sum()}")
print("\nCropland ranges:")
for c in cropland_cols:
    s = df_in[c]
    print(f"  {c:22s}  min={s.min():6.3f}  max={s.max():6.3f}  mean={s.mean():6.3f}  med={s.median():6.3f}  na={s.isna().sum()}")

print("\nCategorical change columns:")
for c in change_cols:
    print(f"  {c}: {df_in[c].value_counts(dropna=False).to_dict()}")

print("\nn.* ranges:")
for c in ['n.gard','n.unint','n.agfo','n.total']:
    s = df_in[c]
    print(f"  {c:8s}  min={s.min():.0f}  max={s.max():.0f}  sum={s.sum():.0f}  mean={s.mean():.2f}  na={s.isna().sum()}")

print("\nOther numeric ranges:")
for c in ['elevation','distance.stream','distance.road',
         'annual.temperature','annual.rainfall','annual.radiation']:
    if c in df_in.columns:
        s = df_in[c]
        print(f"  {c:20s}  min={s.min():.2f} max={s.max():.2f} mean={s.mean():.2f} na={s.isna().sum()}")

# Correlation urban vs cropland
print("\nUrban vs cropland correlation across rows:")
print(df_in[urban_cols + cropland_cols].corr().iloc[:len(urban_cols), len(urban_cols):].round(2))

# Look at fractions
df_in['p_gard'] = df_in['n.gard'] / df_in['n.total'].replace(0, np.nan)
df_in['p_unint'] = df_in['n.unint'] / df_in['n.total'].replace(0, np.nan)
df_in['p_agfo'] = df_in['n.agfo'] / df_in['n.total'].replace(0, np.nan)
print("\nRow-fraction ranges (per row):")
for c in ['p_gard','p_unint','p_agfo']:
    s = df_in[c]
    print(f"  {c:8s}  mean={s.mean():.3f}  median={s.median():.3f}  na={s.isna().sum()}")

# Spearman correlations between row-fractions and urban
print("\nSpearman correlation between row-fractions and urban.2009.*:")
for buf in ['50m','500m','1000m']:
    u = df_in[f'urban.2009.{buf}']
    print(f"\n  buffer {buf}:")
    for name, frac in [('p_gard', df_in['p_gard']),
                       ('p_unint', df_in['p_unint']),
                       ('p_agfo', df_in['p_agfo']),
                       ('n.gard', df_in['n.gard']),
                       ('n.unint', df_in['n.unint']),
                       ('n.agfo', df_in['n.agfo'])]:
        rho = frac.corr(u, method='spearman')
        print(f"    {name:10s}  rho={rho:+.3f}")

# Total number of species considered per row distribution
print("\nDistribution of n.total per row:")
print(df_in['n.total'].describe())
print(f"Rows with n.total==0: {(df_in['n.total']==0).sum()}")
print(f"Rows with all 3 pathways concurrently >0: "
      f"{((df_in['n.gard']>0)&(df_in['n.unint']>0)&(df_in['n.agfo']>0)).sum()}")
print(f"Rows with exactly 1 pathway >0: "
      f"{(((df_in['n.gard']>0).astype(int)+(df_in['n.unint']>0).astype(int)+(df_in['n.agfo']>0).astype(int))==1).sum()}")

# Aggregate by habitat
banner("AGGREGATE-FOR-INSPECTION: sum n.* and mean urban.2009.500m per habitat")
print(df_in.groupby('habitat').agg(
    rows=('n.total','size'),
    sum_gard=('n.gard','sum'),
    sum_unint=('n.unint','sum'),
    sum_agfo=('n.agfo','sum'),
    sum_total=('n.total','sum'),
    mean_urban_2009_500m=('urban.2009.500m','mean'),
    mean_urban_2009_1000m=('urban.2009.1000m','mean'),
    mean_cropland_2009_500m=('cropland.2009.500m','mean'),
    mean_urban_1956_500m=('urban.1956.500m','mean'),
    mean_cropland_1956_500m=('cropland.1956.500m','mean'),
).round(3).to_string())

print("\nPer-habitat fraction pathway / total:")
ag = df_in.groupby('habitat')[['n.gard','n.unint','n.agfo','n.total']].sum()
ag['p_gard'] = (ag['n.gard']/ag['n.total']).round(3)
ag['p_unint'] = (ag['n.unint']/ag['n.total']).round(3)
ag['p_agfo'] = (ag['n.agfo']/ag['n.total']).round(3)
print(ag.to_string())
