"""
Amber peak analysis — DiscoveryBench episode.

Question: "In which millennium did amber have the highest value and in what time
interval did it peak?"

Inputs (inspected in plan stage):
- data/capital.csv                                   (39 rows, 100-yr bins; BCE 500-4300)
    → discrete per-period z-scores.  Amber = `Zamber`.
- data/time_series_data.csv                          (3601 rows, 1-yr steps; CE -4100 .. -500)
    → dense 1-year z-score series.  Amber = `Amber` (raw per-bin), `Amber_inter` (interp).
- data/pollen_openness_score_..._2019.csv            (no amber columns; out-of-scope)

Conventions used:
- No-year-zero: Nth millennium BCE = [N*1000, (N-1)*1000 + 1] BCE.
    4th millennium BCE  = 4000 - 3001 BCE.
    3rd millennium BCE  = 3000 - 2001 BCE.
- 100-year bins are labelled by their START year (e.g. bin "3300 BCE" = 3300-3201 BCE).

Output: prints a JSON report to stdout.
"""
from __future__ import annotations

import json

import numpy as np
import pandas as pd


# ---------------------------------------------------------------------------
# 1) load + clean
# ---------------------------------------------------------------------------
cap = pd.read_csv("data/capital.csv")
num_cols = [c for c in cap.columns if c not in {"BCE", "group", "color"}]
for c in num_cols:
    cap[c] = pd.to_numeric(
        cap[c].astype(str).str.replace(",", ".", regex=False), errors="coerce"
    )
cap["BCE"] = pd.to_numeric(cap["BCE"], errors="coerce")
cap = cap.sort_values("BCE").reset_index(drop=True)             # ascending BCE

ts = pd.read_csv("data/time_series_data.csv")

# ---------------------------------------------------------------------------
# 2) raw discrete series — source 1: Zamber in capital.csv
# ---------------------------------------------------------------------------
zamber = cap[["BCE", "group", "Zamber"]].copy()
zamber_max = float(zamber["Zamber"].max())
plateau_BCE = sorted(zamber.loc[zamber["Zamber"] >= zamber_max - 1e-9, "BCE"].astype(int).tolist())

# ---------------------------------------------------------------------------
# 3) raw discrete series — source 2: Amber (raw) in time_series_data.csv
# ---------------------------------------------------------------------------
amber_raw = ts[["CE", "calBP", "Amber"]].dropna(subset=["Amber"]).copy()
amber_raw_max = float(amber_raw["Amber"].max())
plateau_CE_start_years = sorted(
    amber_raw.loc[amber_raw["Amber"] >= amber_raw_max - 1e-9, "CE"].astype(int).tolist()
)

# ---------------------------------------------------------------------------
# 4) dense 1-year interpolated series — Amber_inter
# ---------------------------------------------------------------------------
amber_inter_max = float(ts["Amber_inter"].max())
plateau_CE_dense_first = int(
    ts.loc[ts["Amber_inter"] >= amber_inter_max - 1e-9, "CE"].min()
)
plateau_CE_dense_last = int(
    ts.loc[ts["Amber_inter"] >= amber_inter_max - 1e-9, "CE"].max()
)

# ---------------------------------------------------------------------------
# 5) cross-source consistency
# ---------------------------------------------------------------------------
plateau_BCE_from_ts = sorted([-c for c in plateau_CE_start_years])
consistent = plateau_BCE == plateau_BCE_from_ts and np.isclose(zamber_max, amber_raw_max)

# ---------------------------------------------------------------------------
# 6) peak time interval (union of plateau bins, expressed in BCE)
# ---------------------------------------------------------------------------
peak_start_BCE = max(plateau_BCE)                  # earliest year
peak_end_BCE   = min(plateau_BCE) - 99             # latest-plus-99 going backward
#                e.g. peak_start=3300, peak_end=3201 → bins 3300,3200 ⇒ plateau covers 3300-3001 BCE
peak_interval_text = f"{peak_start_BCE}–{peak_end_BCE} BCE"
n_peak_bins = len(plateau_BCE)

# ---------------------------------------------------------------------------
# 7) millennium with highest value (no-year-zero convention)
# ---------------------------------------------------------------------------
def millennium_label_bce(yr_start_BCE: int) -> str:
    """No-year-zero convention. Nth mill. BCE = [N*1000 .. (N-1)*1000 + 1] BCE.

    A bin [yr, yr-99] lies inside Nth mill. BCE iff yr <= N*1000 and (yr-99) >= (N-1)*1000 + 1.
    For yr-3000-bin: yr=3000 → 3000-2901 BCE → 3rd mill. BCE (= 3000-2001 BCE).
    """
    n = (abs(yr_start_BCE) + 999) // 1000
    lo = n * 1000
    hi = (n - 1) * 1000 + 1
    ord_pref = {1: "st", 2: "nd", 3: "rd"}
    suffix = ord_pref.get(n % 10 if n % 100 not in (11, 12, 13) else 0, "th")
    return f"{n}{suffix} millennium BCE ({lo}–{hi} BCE)"


# millennium-by-millennium mean Zamber to confirm which millennium dominates
cap["millennium"] = cap["BCE"].apply(millennium_label_bce)
by_mill = (
    cap.groupby("millennium")
       .agg(mean_Zamber=("Zamber", "mean"),
            max_Zamber=("Zamber", "max"),
            n_bins=("Zamber", "size"))
       .reset_index()
       .sort_values("mean_Zamber", ascending=False)
)

# how many peak bins are inside the 4th mill. BCE?
peak_mill_of_bins = [millennium_label_bce(b) for b in plateau_BCE]
peak_mill_counts = {m: peak_mill_of_bins.count(m) for m in set(peak_mill_of_bins)}

# top-line answer
top_mill_row = by_mill.iloc[0]
top_millennium = top_mill_row["millennium"]

# ---------------------------------------------------------------------------
# 8) report
# ---------------------------------------------------------------------------
report = {
    "convention": {
        "millennium_system": "No-year-zero",
        "definition": "Nth millennium BCE = [N*1000, (N-1)*1000 + 1] BCE",
        "bin_definition": "100-year bins labelled by START year (e.g. bin '3300 BCE' = 3300-3201 BCE)",
    },
    "Zamber_capital_csv": {
        "max_Zamber": zamber_max,
        "argmax_BCE_bin_start": int(cap.loc[cap["Zamber"].idxmax(), "BCE"]),
        "plateau_BCE_bin_starts": plateau_BCE,
        "n_peak_bins": n_peak_bins,
    },
    "Amber_time_series_data_raw": {
        "max_Amber": amber_raw_max,
        "plateau_CE_bin_starts": plateau_CE_start_years,
        "plateau_BCE_bin_starts_equiv": plateau_BCE_from_ts,
    },
    "Amber_inter_time_series_data": {
        "max_Amber_inter": amber_inter_max,
        "plateau_CE_first": plateau_CE_dense_first,
        "plateau_CE_last": plateau_CE_dense_last,
        "plateau_length_years": plateau_CE_dense_last - plateau_CE_dense_first + 1,
    },
    "cross_source_consistent": bool(consistent),
    "millennium_summary": by_mill.to_dict(orient="records"),
    "peak_bins_millennium_assignment": peak_mill_counts,
    "millennium_with_highest_value": top_millennium,
    "peak_time_interval_BCE": peak_interval_text,
    "peak_time_interval_description": (
        f"Contiguous plateau of {n_peak_bins} 100-year bins at the maximum "
        f"z-score ({zamber_max}); bin start years = {plateau_BCE}. "
        f"Union interval = {peak_start_BCE}-{peak_end_BCE} BCE "
        f"(spans the very end of the 4th millennium BCE; the final bin "
        f"({min(plateau_BCE)} BCE) sits at the boundary into the 3rd millennium BCE)."
    ),
}
print(json.dumps(report, indent=2, ensure_ascii=False))
