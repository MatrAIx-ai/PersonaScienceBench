"""
DiscoveryBench / archaeology / metadata_19.json/0/0
Question: In the PCA on the forms of capital analyzed in hundred-year time slices,
during the Younger Bronze Age (1100-500 BCE), how does the principal component value
of PC1 in the beginning of the period at 1100 BCE differ from the subsequent time
horizons between 1000 to 500 BCE?

This script performs PCA on the `capital.csv` dataset, restricted to the YBA period,
and compares the PC1 score at BCE = 1100 vs. BCE = 1000..500.
"""
import json
import numpy as np
import pandas as pd
from scipy.linalg import svd


# ---------------------------------------------------------------------------
# 1. Load capital.csv (European decimal commas inside quoted fields)
# ---------------------------------------------------------------------------
df = pd.read_csv("data/capital.csv", sep=",", quotechar='"')

z_cols = [c for c in df.columns if c.startswith("Z")]
for c in z_cols:
    df[c] = df[c].astype(str).str.replace(",", ".").astype(float)

# Filter to the Younger Bronze Age (YBA): BCE = 1100..500
yba = df[df["BCE"].between(500, 1100)].copy().sort_values(
    "BCE", ascending=False
).reset_index(drop=True)
print("YBA BCE order (oldest -> youngest):", yba["BCE"].tolist())
print("YBA shape:", yba.shape)

# Within-YBA constant features: drop them.
nonconst_yba = [c for c in z_cols if yba[c].std(ddof=1) > 0]
dropped = sorted(set(z_cols) - set(nonconst_yba))
print("Dropped (zero within-YBA variance):", dropped)
print("Retained features for YBA PCA:", nonconst_yba)


def fit_pca(X, feat_names, bce_index_for_sign, bce_value=1100):
    """Standardize X then run SVD-based PCA.
    Orient sign so that the score at bce_value is > 0."""
    mu = X.mean(axis=0)
    sd = X.std(axis=0, ddof=1)
    Xs = (X - mu) / sd
    U, S, Vt = svd(Xs, full_matrices=False)
    raw_scores = U * S
    # locate row for BCE=bce_value
    row = bce_index_for_sign
    if raw_scores[row, 0] < 0:
        raw_scores = -raw_scores
        loadings = -Vt[:2].T
    else:
        loadings = Vt[:2].T
    var = (S ** 2) / np.sum(S ** 2)
    loadings_df = pd.DataFrame(loadings, index=feat_names, columns=["PC1", "PC2"])
    return raw_scores, loadings_df, var, mu, sd


# ---------------------------------------------------------------------------
# 2. PCA on the YBA-only 7-row matrix
# ---------------------------------------------------------------------------
X_yba = yba[nonconst_yba].values
# In yba (sorted BCE desc), row 0 corresponds to BCE=1100
T_yba, L_yba, var_yba, _, _ = fit_pca(X_yba, nonconst_yba, bce_index_for_sign=0)

yba_scores = yba[["BCE"]].copy()
yba_scores["PC1"] = T_yba[:, 0]
yba_scores["PC2"] = T_yba[:, 1]
yba_scores = yba_scores.sort_values("BCE", ascending=False).reset_index(drop=True)
print("\n=== PCA on the 7 YBA slices (standardized within YBA) ===")
print("Variance explained (PC1, PC2):", var_yba[:2].round(4).tolist())
print("\nLoadings (PC1, PC2):")
print(L_yba.round(4))
print("\nPC scores per YBA slice:")
print(yba_scores.to_string(index=False))


# ---------------------------------------------------------------------------
# 3. PCA on the full 39-row matrix (robustness check)
# ---------------------------------------------------------------------------
df_x = df.copy()  # CSV order: BCE 4300..500 (descending)
nonconst_full = [c for c in z_cols if df_x[c].std(ddof=1) > 0]
X_all = df_x[nonconst_full].values
# row of BCE=1100 in df_x (descending order from 4300):
row_1100 = int(df_x.index[df_x["BCE"] == 1100][0])
T_all, L_all, var_all, _, _ = fit_pca(
    X_all, nonconst_full, bce_index_for_sign=row_1100
)

all_scores = df_x[["BCE", "group"]].copy()
all_scores["PC1"] = T_all[:, 0]
all_scores["PC2"] = T_all[:, 1]
yba_full = all_scores[all_scores["BCE"].between(500, 1100)].sort_values(
    "BCE", ascending=False
).reset_index(drop=True)

print("\n=== PCA on all 39 slices (standardized within full dataset) ===")
print("Variance explained (PC1, PC2):", var_all[:2].round(4).tolist())
print("\nLoadings (PC1, PC2):")
print(L_all.round(4))
print("\nPC scores for the YBA subset of the full PCA:")
print(yba_full.to_string(index=False))


# ---------------------------------------------------------------------------
# 4. Comparison: PC1 at 1100 BCE vs. PC1 across 1000..500 BCE
# ---------------------------------------------------------------------------
def summarise(scores_df, label):
    p1100 = scores_df.loc[scores_df["BCE"] == 1100, "PC1"].iloc[0]
    subsequent = scores_df.loc[scores_df["BCE"] < 1100, "PC1"]
    summary = {
        "label": label,
        "PC1_at_1100_BCE": float(p1100),
        "PC1_mean_subsequent_1000_to_500_BCE": float(subsequent.mean()),
        "PC1_min_subsequent": float(subsequent.min()),
        "PC1_max_subsequent": float(subsequent.max()),
        "PC1_std_subsequent": float(subsequent.std(ddof=1)),
        "PC1_excess_over_subsequent_mean": float(p1100 - subsequent.mean()),
        "PC1_excess_over_next_highest_subsequent": float(p1100 - subsequent.max()),
        "PC1_1100_subsequent_zscore": float(
            (p1100 - subsequent.mean()) / subsequent.std(ddof=1)
        ),
    }
    return summary


comp_yba = summarise(yba_scores, "YBA-only PCA")
comp_full = summarise(yba_full, "Full PCA (YBA subset)")
print("\n=== Comparison summaries ===")
for s in (comp_yba, comp_full):
    print(json.dumps(s, indent=2))


# ---------------------------------------------------------------------------
# 5. Persist outputs to JSON
# ---------------------------------------------------------------------------
out = {
    "yba_pca": {
        "variance_explained_PC1_PC2": var_yba[:2].tolist(),
        "loadings": L_yba.round(6).reset_index().rename(columns={"index": "feature"}).to_dict(
            orient="records"
        ),
        "scores": yba_scores.to_dict(orient="records"),
        "comparison": comp_yba,
    },
    "full_pca": {
        "variance_explained_PC1_PC2": var_all[:2].tolist(),
        "loadings": L_all.round(6).reset_index().rename(columns={"index": "feature"}).to_dict(
            orient="records"
        ),
        "scores_yba_subset": yba_full.to_dict(orient="records"),
        "comparison": comp_full,
    },
}
with open("analysis/pca_yba_results.json", "w") as f:
    json.dump(out, f, indent=2, default=float)

print("\nWrote: analysis/pca_yba_results.json")
