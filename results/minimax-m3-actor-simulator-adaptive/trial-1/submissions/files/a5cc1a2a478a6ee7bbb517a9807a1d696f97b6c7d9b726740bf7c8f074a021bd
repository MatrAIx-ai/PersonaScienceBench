"""
DiscoveryBench / NLS-Incarceration — analysis script.

Question:
    "Between which years did the largest increases in median wealth occur
     among black females?"

Method (as approved in the planning pass):
    1. Filter race == 'black' AND sex == 'female' (exact, lowercase).
    2. Treat composite_wealth_1985/1990/1996 as dollar-denominated
       net-wealth variables; no rescaling, no sign-truncation.
    3. Compute per-wave medians m_1985, m_1990, m_1996 and the two
       pair-wise deltas d_85_90 = m_1990 - m_1985 and d_90_96 = m_1996 - m_1990.
    4. The interval with the larger delta is the primary answer.
    5. Cross-checks: means, quartiles (q25/q75), 231/1548 zero-across-all-three
       years count, ever_jailed stratification (jailed stratum flagged as
       underpowered, n=16).
    6. Caveat: 1,899 exact duplicate rows and no respondent id → cross-sectional,
       not longitudinal, aggregation.

This script is the executed artifact for the public submission.
"""

import json
import os
import sys

import numpy as np
import pandas as pd

DATA_PATH = "data/nls_incarceration_processed.csv"

def fmt_int(x):
    return "n/a" if pd.isna(x) else f"{int(x):,}"

def fmt_money(x):
    return "n/a" if pd.isna(x) else f"${int(round(x)):,}"

def main() -> None:
    df = pd.read_csv(DATA_PATH)

    # --- Sanity checks -------------------------------------------------------
    assert {"race", "sex", "composite_wealth_1985", "composite_wealth_1990",
            "composite_wealth_1996"}.issubset(df.columns), \
        "Required columns missing."

    # --- (1) Filter ----------------------------------------------------------
    mask = (df["race"] == "black") & (df["sex"] == "female")
    sub = df.loc[mask].copy()
    n = len(sub)

    # --- (2)+(3) Medians and deltas -----------------------------------------
    years = [1985, 1990, 1996]
    cols  = [f"composite_wealth_{y}" for y in years]

    medians = sub[cols].median()
    means   = sub[cols].mean()
    q25     = sub[cols].quantile(0.25)
    q75     = sub[cols].quantile(0.75)
    n_per   = sub[cols].notna().sum()  # all 1548 here

    m = {y: float(medians[c]) for y, c in zip(years, cols)}
    d_85_90 = m[1990] - m[1985]
    d_90_96 = m[1996] - m[1990]

    # --- (5) Robustness -----------------------------------------------------
    zero_all_three = int(
        ((sub["composite_wealth_1985"] == 0) &
         (sub["composite_wealth_1990"] == 0) &
         (sub["composite_wealth_1996"] == 0)).sum()
    )

    # ever_jailed stratification inside black-female
    ej_counts = sub["ever_jailed"].value_counts().to_dict()
    ej_meds = sub.groupby("ever_jailed")[cols].median()

    # Overall respondents counts (for context)
    n_all = len(df)
    n_black_female = int(mask.sum())

    # Data-file diagnostic: no id, exact dup rows
    n_dups = int(df.duplicated().sum())

    # --- (4) Pick the interval ----------------------------------------------
    if d_85_90 > d_90_96:
        winning_interval = "1985 -> 1990"
        winning_delta    = d_85_90
        losing_delta     = d_90_96
        runner_up        = "1990 -> 1996"
        decision_note    = ("d_85_90 > d_90_96, strictly larger delta."
                            if abs(d_85_90 - d_90_96) > 0
                            else "Tie between intervals (kept directional winner by alphabetical order).")
    elif d_90_96 > d_85_90:
        winning_interval = "1990 -> 1996"
        winning_delta    = d_90_96
        losing_delta     = d_85_90
        runner_up        = "1985 -> 1990"
        decision_note    = "d_90_96 > d_85_90, strictly larger delta."
    else:
        winning_interval = "TIE: 1985->1990 and 1990->1996"
        winning_delta    = d_85_90  # equal
        losing_delta     = d_90_96
        runner_up        = "(both intervals tied)"
        decision_note    = "d_85_90 == d_90_96 exactly."

    # --- Console report ------------------------------------------------------
    print("=" * 72)
    print("ANALYSIS REPORT — NLS-Incarceration (Black, Female)")
    print("=" * 72)
    print(f"Path                : {DATA_PATH}")
    print(f"Rows in file        : {fmt_int(n_all)}")
    print(f"Filter              : race == 'black' AND sex == 'female'")
    print(f"n (black female)    : {fmt_int(n_black_female)}")
    print(f"respondent id col?  : None detected")
    print(f"Exact-duplicate rows: {fmt_int(n_dups)}  (caveat: cannot dedupe)")
    print()

    print("-- Per-wave aggregation (black female, n=1548 each year) --")
    header = f"{'stat':<10}" + "".join(f"{y:>16}" for y in years)
    print(header)
    for label, series in [("n", n_per), ("median", medians),
                          ("mean", means), ("q25", q25), ("q75", q75)]:
        row = f"{label:<10}" + "".join(f"{fmt_int(v):>16}" for v in series) if label == "n" else f"{label:<10}" + "".join(f"{fmt_money(v):>16}" for v in series)
        print(row)
    print()

    print("-- Medians and pair-wise deltas --")
    print(f"  m_1985 = {fmt_money(m[1985])}")
    print(f"  m_1990 = {fmt_money(m[1990])}")
    print(f"  m_1996 = {fmt_money(m[1996])}")
    print(f"  d_85_90 = m_1990 - m_1985 = {fmt_money(d_85_90)}")
    print(f"  d_90_96 = m_1996 - m_1990 = {fmt_money(d_90_96)}")
    print()

    print("-- Decision --")
    print(f"  Winning interval : {winning_interval}")
    print(f"  Delta            : {fmt_money(winning_delta)}")
    print(f"  Runner-up delta  : {fmt_money(losing_delta)}  ({runner_up})")
    print(f"  Note             : {decision_note}")
    print()

    print("-- Robustness --")
    print(f"  zero across all 3 wealth cols : {zero_all_three}"
          f" / {n} ({zero_all_three/n:.1%}) — kept as real obs per plan")
    print("  Skew check: q25=0 in all three waves and mean >> median -> "
          "heavy right tail; median is the right summary.")
    print(f"  ever_jailed distribution inside black-female: "
          f"{{0: {ej_counts.get(0,0)}, 1: {ej_counts.get(1,0)}}}")
    print("  ever_jailed-stratified medians (USD):")
    print(ej_meds.to_string())
    print("  Caveat: ever_jailed=1 stratum has n=16 — underpowered, "
          "do not over-interpret. ever_jailed=0 reflects the modal population.")
    print()

    # --- Stash JSON for the result handoff ----------------------------------
    results = {
        "data_path": DATA_PATH,
        "n_total_rows": int(n_all),
        "n_black_female": int(n_black_female),
        "filter": "race == 'black' AND sex == 'female'",
        "units": "U.S. dollars (no rescaling)",
        "n_duplicates_in_file": int(n_dups),
        "respondent_id_column": None,
        "interpretation": "cross-sectional medians per wave; not longitudinal "
                          "(no respondent ids prevent within-person change).",
        "per_year": {
            str(y): {
                "n": int(n_per[f"composite_wealth_{y}"]),
                "median": float(medians[f"composite_wealth_{y}"]),
                "mean":   float(means  [f"composite_wealth_{y}"]),
                "q25":    float(q25    [f"composite_wealth_{y}"]),
                "q75":    float(q75    [f"composite_wealth_{y}"]),
            } for y in years
        },
        "medians": {str(y): float(medians[f"composite_wealth_{y}"]) for y in years},
        "deltas": {
            "d_85_90": float(d_85_90),
            "d_90_96": float(d_90_96),
        },
        "winning_interval": winning_interval,
        "winning_delta": float(winning_delta),
        "losing_delta":  float(losing_delta),
        "decision_note": decision_note,
        "robustness": {
            "zero_across_all_three": zero_all_three,
            "share_zero_across_all_three": zero_all_three / n,
            "ever_jailed_counts": {str(k): int(v) for k, v in ej_counts.items()},
            "ever_jailed_medians": ej_meds.to_dict(),
        },
    }
    out_path = "artifacts/analysis/results.json"
    os.makedirs(os.path.dirname(out_path), exist_ok=True)
    with open(out_path, "w") as f:
        json.dump(results, f, indent=2, default=str)
    print(f"Wrote {out_path}")

    return results


if __name__ == "__main__":
    main()
