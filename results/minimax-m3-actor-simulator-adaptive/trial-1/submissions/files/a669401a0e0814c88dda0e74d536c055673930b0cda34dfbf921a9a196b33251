"""
NLSY79 analysis: How does adding academic characteristics (ASVAB) alter the
effects of SES and race on respondent's highest grade completed in 1979?

Primary outcome: continuous `R_grade_1979` (no literal BA-completion column
exists in the on-disk file).  Sensitivity binary ba_proxy (>=16) computed as
footnote (only 37 successes by 1979, n=12,532).

Method: nested OLS.
  M1: grade ~ SES_composite + race + sex + age_1979 + fam_size + mom_ed
  M2: M1 + 4 ASVAB subtests (AR, WK, PC, MK) standardized

SES composite = mean( std-log-income(1979/85/89) facet, std-(wealth+shift+1)-log
facet ) where wealth-shift = -min(wealth) + 1 = 1,011,901 to keep debts log-able.
Single-proxy SES = log(wealth_1996 + 1,011,901), standardized.

Race (ref = NBNH=3): dummies for Black(1) and Hispanic(2).

Sensitivities: mean imputation for ASVAB/MomEd/SES; attrition to income-1979
nonmissing; any income-wave nonmissing; single-proxy SES; dad-ed instead.
"""
# ---- Imports & load ----
import csv, json, math
import numpy as np

with open('data/nls_raw.csv', newline='') as f:
    rows = list(csv.reader(f))
header, data = rows[0], rows[1:]
ci = {h:i for i,h in enumerate(header)}

def col(name): return np.array([r[ci[name]] for r in data], dtype=object)
def num(a, miss=("",)):
    return np.array([float(x) if x not in miss and x not in (None,) else np.nan for x in a])
def std_with(x):
    m, s = np.nanmean(x), np.nanstd(x, ddof=1); return (x - m) / s, (m, s)

# ---- Variables ----
Rgrade = num(col("Highest grade completed, 1979"), miss=("", "95.0"))
race   = num(col("Racial/ethnic cohort, 1979"))
sex    = num(col("Sex of respondent, 1979"))
age79  = num(col("Age of respondent, 1979"))
famsz  = num(col("Family size, 1979"))
momed  = num(col("Highest grade completed by respondent's mother, 1979"))
daded  = num(col("Highest grade completed by respondent's father, 1979"))

inc = np.column_stack([num(col("Total net family income, previous calendar year, 1979")),
                       num(col("Total net family income, previous calendar year, 1985")),
                       num(col("Total net family income, previous calendar year, 1989"))])
wn  = np.column_stack([num(col("Family net wealth, 1985")),
                       num(col("Family net wealth, 1990")),
                       num(col("Family net wealth, 1996 (key data point)"))])
SHIFT = -np.nanmin(wn) + 1.0   # 1,011,901 -> keeps debts log-able

# Income facet
log_inc_z = (np.log1p(inc) - np.nanmean(np.log1p(inc), axis=0, keepdims=True)) / \
            np.nanstd(np.log1p(inc), axis=0, ddof=1, keepdims=True)
inc_facet_z, _ = std_with(np.nanmean(log_inc_z, axis=1))

# Wealth facet
log_w = np.log(wn + SHIFT)
log_w_z = (log_w - np.nanmean(log_w, axis=0, keepdims=True)) / \
          np.nanstd(log_w, axis=0, ddof=1, keepdims=True)
w_facet_z, _ = std_with(np.nanmean(log_w_z, axis=1))

# Composite SES, single-proxy SES_w96
ses_z, _ = std_with((inc_facet_z + w_facet_z) / 2.0)
ses_w96  = (np.log(wn[:,2] + SHIFT) - np.nanmean(np.log(wn[:,2] + SHIFT))) / \
           np.nanstd(np.log(wn[:,2] + SHIFT), ddof=1)

# ASVAB (standardized, NOT z-scored as the column label claims)
asvab_names = ["ASVAB - Arithmetic Reasoning Z Score (rounded), 1981",
               "ASVAB - Word Knowledge Z Score (rounded), 1981",
               "ASVAB - Paragraph Comprehension Z Score (rounded), 1981",
               "ASVAB - Mathematics Knowledge Z Score (rounded), 1981"]
ASVAB = np.column_stack([num(col(n)) for n in asvab_names])
asvab_z = np.column_stack([(ASVAB[:,j] - np.nanmean(ASVAB[:,j])) /
                            np.nanstd(ASVAB[:,j], ddof=1) for j in range(4)])

# Race dummies (ref NBNH=3)
black = (race == 1).astype(float)
hispanic = (race == 2).astype(float)

# Design matrix
D = np.column_stack([Rgrade, ses_z, black, hispanic, sex, age79, famsz, momed,
                     asvab_z[:,0], asvab_z[:,1], asvab_z[:,2], asvab_z[:,3], ses_w96])
NAMES = ["Rgrade","SES","Black","Hispanic","Sex","Age1979","FamSize","MomEd",
         "ASVAB_AR","ASVAB_WK","ASVAB_PC","ASVAB_MK","SES_w96"]
OUT,SES,BLACK,HISP,SEX,AGE,FAM,MOMED = 0,1,2,3,4,5,6,7
AR,WK,PC,MK = 8,9,10,11; SES_W96 = 12

# ---- OLS helper ----
def ols(y, X, xnames):
    keep = ~np.isnan(y) & ~np.any(np.isnan(X), axis=1)
    yy, XX = y[keep].astype(float), X[keep].astype(float)
    n, k = XX.shape
    Xi = np.hstack([np.ones((n,1)), XX])
    XtX_inv = np.linalg.pinv(Xi.T @ Xi)
    b = XtX_inv @ Xi.T @ yy
    yh = Xi @ b
    rss = float(((yy-yh)**2).sum()); tss = float(((yy-yy.mean())**2).sum())
    R2 = 1 - rss/tss
    se = np.sqrt(np.diag((rss/(n-k-1))*XtX_inv))
    return dict(b=b, se=se, n=n, R2=R2, k=k, X=XX, full=["intercept"]+xnames,
                yh=yh, yy=yy)

def fit_dual(D_use, y, idx1, idx2):
    X2 = D_use[:, idx2]
    M2 = ols(y, X2, [NAMES[i] for i in idx2])
    keep = ~np.isnan(y) & ~np.any(np.isnan(X2), axis=1)
    M1 = ols(y[keep], (D_use[keep])[:, idx1], [NAMES[i] for i in idx1])
    rss1 = float(((M1["yy"]-M1["yh"])**2).sum())
    rss2 = float(((M2["yy"]-M2["yh"])**2).sum())
    n = M2["n"]; df1 = M2["k"]-M1["k"]; df2 = n-M2["k"]-1
    F_ASVAB = ((rss1-rss2)/df1) / (rss2/df2)
    return M1, M2, float(F_ASVAB), int(df1), int(df2)

# ---- Run primary M1 / M2 ----
y = D[:,OUT]
i_m1 = [SES,BLACK,HISP,SEX,AGE,FAM,MOMED]
i_m2 = i_m1 + [AR,WK,PC,MK]
M1, M2, F_ASVAB, df1, df2 = fit_dual(D, y, i_m1, i_m2)

# ---- Print and save ----
print(f"PRIMARY: n={M2['n']}; R2_M1={M1['R2']:.4f}; R2_M2={M2['R2']:.4f}")
print(f"Partial-F (ASVAB block) = {F_ASVAB:.2f} on ({df1},{df2}) df")
for nm in ["SES","Black","Hispanic","Sex","Age1979","FamSize","MomEd"]:
    i = M2["full"].index(nm)
    i1 = M1["full"].index(nm)
    print(f"  {nm:11s}  M1={M1['b'][i1]:+.4f}({M1['se'][i1]:.4f})  M2={M2['b'][i]:+.4f}({M2['se'][i]:.4f})")

for nm in ["ASVAB_AR","ASVAB_WK","ASVAB_PC","ASVAB_MK"]:
    i = M2["full"].index(nm); print(f"  {nm:11s}  M2={M2['b'][i]:+.4f}({M2['se'][i]:.4f})")

# Dump primary results
import json as _json
primary = dict(M1_coefs={nm: float(M1["b"][i]) for i,nm in enumerate(M1["full"])},
               M1_se={nm: float(M1["se"][i]) for i,nm in enumerate(M1["full"])},
               M2_coefs={nm: float(M2["b"][i]) for i,nm in enumerate(M2["full"])},
               M2_se={nm: float(M2["se"][i]) for i,nm in enumerate(M2["full"])},
               n=int(M2["n"]), R2_M1=float(M1["R2"]), R2_M2=float(M2["R2"]),
               F_ASVAB=float(F_ASVAB), df1=int(df1), df2=int(df2),
               wealth_shift=float(SHIFT))
with open("tmp/primary.json","w") as f:
    _json.dump(primary, f, indent=2)
print("Wrote tmp/primary.json")
