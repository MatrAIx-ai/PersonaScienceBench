"""
NLS Incarceration / Wealth Analysis
Question: In which years were individuals with a criminal record found to have
significantly lower wealth compared to those without?

Plan recap (approved):
- Per-year comparisons on 1985, 1990, 1996 wealth snapshots.
- Welch's t-test on a log(wealth - min + 1) shift transform to handle negative wealth.
- Mann-Whitney U on raw wealth as non-parametric backup.
- Holm-adjusted p-values across the 3 years.
- Joint criterion for "significantly lower": Holm-adjusted p<0.05 AND a non-trivial
  effect size (Hedges' g on log scale >= 0.20 OR |rank-biserial r| >= 0.10)
  AND the direction is lower wealth for ever_jailed=1.
- HC3-robust OLS: log(1+wealth) ~ ever_jailed + C(race) + C(sex) per year, with the
  wealth variable itself shifted to make log-domain valid for negative wealth.
- 1985 is framed as a pre-period baseline check (jail window starts 1985).
"""

import json
import numpy as np
import pandas as pd
import statsmodels.api as sm
from scipy import stats

# ---------- Load ----------
df = pd.read_csv('/workspace/data/nls_incarceration_processed.csv')
print(f"Loaded {len(df):,} rows x {df.shape[1]} cols")
print(f"ever_jailed distribution: {df['ever_jailed'].value_counts().to_dict()}")

YEARS = [1985, 1990, 1996]
results = []

# ---------- Helpers ----------
def hedges_g_log(x, y):
    """Hedges' g on log-shifted wealth (Welch-pooled equivalent: use pooled SD)."""
    nx, ny = len(x), len(y)
    sx, sy = x.std(ddof=1), y.std(ddof=1)
    sp = np.sqrt(((nx - 1) * sx ** 2 + (ny - 1) * sy ** 2) / (nx + ny - 2))
    d = (x.mean() - y.mean()) / sp if sp > 0 else np.nan
    # Hedges' small-sample correction
    dfree = nx + ny - 2
    J = 1 - 3 / (4 * dfree - 1)
    return d * J

def rank_biserial(u_stat, n1, n2):
    """Rank-biserial correlation from Mann-Whitney U."""
    return 1 - (2 * u_stat) / (n1 * n2)

def holm_adjust(pvals):
    """Holm-Bonferroni step-down adjustment. pvals: list of raw p-values."""
    n = len(pvals)
    order = np.argsort(pvals)
    adj = np.empty(n, dtype=float)
    running = 0.0
    for rank, idx in enumerate(order, start=1):
        val = (n - rank + 1) * pvals[idx]
        val = min(val, 1.0)
        running = max(running, val)
        adj[idx] = running
    return adj.tolist()

# ---------- Per-year analysis ----------
LOG_COLS = {}
for y in YEARS:
    col = f"composite_wealth_{y}"
    wmin = df[col].min()
    # Shift so domain is positive; +1 avoids log(0)
    LOG_COLS[y] = f"log_shift_{y}"
    df[LOG_COLS[y]] = np.log1p(df[col] - wmin)  # = log(wealth - min + 1)
    print(f"  {col}: min={wmin}, log-shift applied; "
          f"after transform min={df[LOG_COLS[y]].min():.3f}, max={df[LOG_COLS[y]].max():.3f}")

print()
print("Log transform choice: shift by -min(wealth)+1, i.e. log(wealth - min + 1). "
      "This makes the domain strictly positive while preserving ranks and "
      "compresses extreme positive outliers.\n")

for y in YEARS:
    col = f"composite_wealth_{y}"
    logcol = LOG_COLS[y]
    g0 = df.loc[df.ever_jailed == 0, col]
    g1 = df.loc[df.ever_jailed == 1, col]
    lg0 = df.loc[df.ever_jailed == 0, logcol]
    lg1 = df.loc[df.ever_jailed == 1, logcol]

    n0, n1 = len(g0), len(g1)
    m0, m1 = g0.mean(), g1.mean()
    med0, med1 = g0.median(), g1.median()
    sd0, sd1 = g0.std(ddof=1), g1.std(ddof=1)

    # Welch's t-test on log-shift wealth
    t_res = stats.ttest_ind(lg1, lg0, equal_var=False)
    t_stat, t_p = t_res.statistic, t_res.pvalue
    # Welch-Satterthwaite df
    s1, s2 = lg1.var(ddof=1), lg0.var(ddof=1)
    welch_df = (s1 / n1 + s2 / n0) ** 2 / (
        (s1 / n1) ** 2 / (n1 - 1) + (s2 / n0) ** 2 / (n0 - 1)
    )
    # 95% CI on mean(log) diff (jailed - non-jailed)
    se = np.sqrt(s1 / n1 + s2 / n0)
    mean_log_diff = lg1.mean() - lg0.mean()
    tcrit = stats.t.ppf(0.975, welch_df)
    ci_lo = mean_log_diff - tcrit * se
    ci_hi = mean_log_diff + tcrit * se
    g = hedges_g_log(lg1, lg0)

    # Mann-Whitney U on raw wealth
    u_res = stats.mannwhitneyu(g1, g0, alternative='two-sided')
    u_stat, u_p = u_res.statistic, u_res.pvalue
    rb = rank_biserial(u_stat, n1, n0)  # convention: U for group A=g1

    # HC3-robust OLS on log-shift wealth
    sub = df[[logcol, "ever_jailed", "race", "sex"]].copy()
    sub["race"] = pd.Categorical(sub["race"], categories=["white", "black", "hipanic"])
    sub["sex"] = pd.Categorical(sub["sex"], categories=["male", "female"])
    X = pd.get_dummies(sub[["ever_jailed", "race", "sex"]], drop_first=True).astype(float)
    X = sm.add_constant(X)
    ols = sm.OLS(sub[logcol], X).fit(cov_type="HC3")
    coef = ols.params["ever_jailed"]
    ci = ols.conf_int().loc["ever_jailed"].tolist()
    ols_p = ols.pvalues["ever_jailed"]

    results.append({
        "year": y,
        "n_nojail": n0,
        "n_jailed": n1,
        "mean_nojail": m0,
        "mean_jailed": m1,
        "median_nojail": med0,
        "median_jailed": med1,
        "sd_nojail": sd0,
        "sd_jailed": sd1,
        "welch_t": t_stat,
        "welch_df": welch_df,
        "welch_p_raw": t_p,
        "welch_mean_log_diff_jail_minus_nojail": mean_log_diff,
        "welch_ci_lo": ci_lo,
        "welch_ci_hi": ci_hi,
        "hedges_g_log": g,
        "mw_u": u_stat,
        "mw_p_raw": u_p,
        "rank_biserial_r": rb,
        "ols_ever_jailed_coef": coef,
        "ols_ci_lo": ci[0],
        "ols_ci_hi": ci[1],
        "ols_p_raw": ols_p,
    })

res = pd.DataFrame(results)
raw_p_welch = res["welch_p_raw"].tolist()
raw_p_mw = res["mw_p_raw"].tolist()
raw_p_ols = res["ols_p_raw"].tolist()

res["welch_p_holm"] = holm_adjust(raw_p_welch)
res["mw_p_holm"] = holm_adjust(raw_p_mw)
res["ols_p_holm"] = holm_adjust(raw_p_ols)

# Joint criterion
def verdict(row):
    significant_tests = (row.welch_p_holm < 0.05) or (row.mw_p_holm < 0.05)
    effect_size = (abs(row.hedges_g_log) >= 0.20) or (abs(row.rank_biserial_r) >= 0.10)
    direction = row.welch_mean_log_diff_jail_minus_nojail < 0  # jailed lower
    if significant_tests and effect_size and direction:
        return "YES — significantly lower wealth for ever_jailed=1"
    if direction and (significant_tests or effect_size):
        return "SUGGESTIVE — direction correct but criterion not fully met"
    return "NO"

res["verdict"] = res.apply(verdict, axis=1)

# Pretty print & save
cols_show = [
    "year", "n_nojail", "n_jailed",
    "mean_nojail", "mean_jailed",
    "median_nojail", "median_jailed",
    "sd_nojail", "sd_jailed",
    "welch_t", "welch_df", "welch_p_raw", "welch_p_holm",
    "welch_mean_log_diff_jail_minus_nojail", "welch_ci_lo", "welch_ci_hi",
    "hedges_g_log",
    "mw_u", "mw_p_raw", "mw_p_holm", "rank_biserial_r",
    "ols_ever_jailed_coef", "ols_ci_lo", "ols_ci_hi", "ols_p_raw",
    "ols_p_holm", "verdict",
]
res_print = res[cols_show].copy()
for c in res_print.columns:
    if res_print[c].dtype.kind == "f":
        res_print[c] = res_print[c].round(4)

print("=" * 120)
print("PER-YEAR RESULTS")
print("=" * 120)
print(res_print.to_string(index=False))

# Save artifacts
res_print.to_csv("/workspace/artifacts/per_year_results.csv", index=False)
print("\nSaved: /workspace/artifacts/per_year_results.csv")

# Save a JSON summary for the payload
summary = {
    "log_transform": "log(wealth - min(wealth) + 1) per year; chosen to handle negative wealth.",
    "missing_data": "none observed; no imputation.",
    "n_total": int(len(df)),
    "n_jailed": int(df.ever_jailed.sum()),
    "alpha": 0.05,
    "multiple_comparisons": "Holm-Bonferroni across 3 year-wise tests, family alpha=0.05.",
    "joint_significance_rule": (
        "Year flagged YES if (Holm-adjusted p<0.05 on Welch OR Mann-Whitney) "
        "AND (|Hedges' g on log-shift scale|>=0.20 OR |rank-biserial r|>=0.10) "
        "AND direction is lower wealth for ever_jailed=1."
    ),
    "baseline_year_caveat": (
        "1985 is the first year of the 1985-1994 jail window and strictly precedes "
        "any subsequent jail exposure for that year; it is reported as a pre-period "
        "balance check, not as a causal effect."
    ),
    "per_year": [
        {
            "year": int(r.year),
            "n_nojail": int(r.n_nojail),
            "n_jailed": int(r.n_jailed),
            "mean_nojail": round(float(r.mean_nojail), 2),
            "mean_jailed": round(float(r.mean_jailed), 2),
            "median_nojail": round(float(r.median_nojail), 2),
            "median_jailed": round(float(r.median_jailed), 2),
            "sd_nojail": round(float(r.sd_nojail), 2),
            "sd_jailed": round(float(r.sd_jailed), 2),
            "welch_t": round(float(r.welch_t), 4),
            "welch_df": round(float(r.welch_df), 4),
            "welch_p_raw": float(r.welch_p_raw),
            "welch_p_holm": float(r.welch_p_holm),
            "welch_mean_log_diff": round(float(r.welch_mean_log_diff_jail_minus_nojail), 4),
            "welch_ci_lo": round(float(r.welch_ci_lo), 4),
            "welch_ci_hi": round(float(r.welch_ci_hi), 4),
            "hedges_g_log": round(float(r.hedges_g_log), 4),
            "mw_u": float(r.mw_u),
            "mw_p_raw": float(r.mw_p_raw),
            "mw_p_holm": float(r.mw_p_holm),
            "rank_biserial_r": round(float(r.rank_biserial_r), 4),
            "ols_ever_jailed_coef": round(float(r.ols_ever_jailed_coef), 4),
            "ols_ci_lo": round(float(r.ols_ci_lo), 4),
            "ols_ci_hi": round(float(r.ols_ci_hi), 4),
            "ols_p_raw": float(r.ols_p_raw),
            "ols_p_holm": float(r.ols_p_holm),
            "verdict": r.verdict,
        }
        for _, r in res.iterrows()
    ],
}
with open("/workspace/artifacts/results.json", "w") as f:
    json.dump(summary, f, indent=2)
print("Saved: /workspace/artifacts/results.json")

# Print verdict summary
print("\n" + "=" * 120)
print("VERDICT PER YEAR")
print("=" * 120)
for _, r in res.iterrows():
    print(f"  {int(r.year)}: {r.verdict}")
