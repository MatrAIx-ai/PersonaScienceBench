"""
DiscoveryBench — archaeology/metadata_9 — final analysis.

Headline SC3 = Z_CuAu + Z_Amber + Z_MonumentCount (capital.csv raw Z, 100y bins).
Cross-check: time_series_data.*_inter aggregated to 100y CE bins.
Sensitivities (artifacts only): SC_mean_3, SC_4 (adds MonumentSize), SC_3_detrend (within-phase).
Peak detection: argmax over CE_center ∈ [-4250, -450]; ties → contiguous plateau range.
Component "rose into peak": ΔZ over 2-bin (~200y) lead window before plateau.
"""
import pandas as pd, numpy as np, json, os
DATA='/workspace/data'; ART='/workspace/artifacts'

# --- LOAD ---
cap = pd.read_csv(os.path.join(DATA,'capital.csv'), decimal=',')
cap['CE_left']   = -cap['BCE']
cap['CE_center'] = cap['CE_left'] + 50
cap = cap.rename(columns={'ZCU_AU':'CuAu','Zamber':'Amber',
                          'ZMonument':'MonumentCount','ZMW':'MonumentSize'})
cap['SC3']       = cap['CuAu'] + cap['Amber'] + cap['MonumentCount']
cap['SC4']       = cap['SC3']  + cap['MonumentSize']
cap['SC_mean_3'] = cap['SC3']  / 3.0

ts = pd.read_csv(os.path.join(DATA,'time_series_data.csv'))
ts['bin_left']   = (ts['CE'] // 100) * 100
ts['bin_center'] = ts['bin_left'] + 50

# --- Within-phase (group) detrended Z's and SC3_dt ---
phase_means = cap.groupby('group')[['CuAu','Amber','MonumentCount']].transform('mean')
cap['CuAu_dt']     = cap['CuAu']          - phase_means['CuAu']
cap['Amber_dt']    = cap['Amber']         - phase_means['Amber']
cap['MonCount_dt'] = cap['MonumentCount'] - phase_means['MonumentCount']
cap['SC3_dt']      = cap['CuAu_dt'] + cap['Amber_dt'] + cap['MonCount_dt']

# --- Cross-check via time_series.inter aggregated to 100y CE bins ---
inter_means = ts.groupby('bin_center', as_index=False)[
    ['CopperGold_inter','Amber_inter','MonumentCount_inter','MonumentSize_inter',
     'pollen_inter','pollen_inter_100','pollen_grate_100']].mean()
xs = cap[['CE_center','SC3']].merge(
    inter_means, left_on='CE_center', right_on='bin_center', how='left')
cap['SC3_from_inter']     = (xs['CopperGold_inter']+xs['Amber_inter']+xs['MonumentCount_inter']).values
cap['pollen_inter']       = xs['pollen_inter'].values
cap['pollen_inter_100']   = xs['pollen_inter_100'].values
cap['pollen_grate_100']   = xs['pollen_grate_100'].values

# --- Identify prefilled 'constant' leading rows (BCE ∈ {4300,4200,4100}) ---
PREFILLED = {4300,4200,4100}
cap['is_prefilled'] = cap['BCE'].isin(PREFILLED)
active = cap[~cap['is_prefilled']].copy()

print(f"Capital.csv: {len(cap)} rows; prefilled leading rows: {cap['is_prefilled'].sum()}")

# === PEAK DETECTION (with tie detection across adjacent bins) ===
TOD = 1e-6
peak_val = cap['SC3'].max()
ties_mask = np.abs(cap['SC3'] - peak_val) < TOD
tied = cap[ties_mask].sort_values('BCE')
peak_CE_lefts  = tied['CE_left'].astype(int).tolist()
peak_CE_cents  = tied['CE_center'].astype(int).tolist()
peak_BCE_old   = int(tied['BCE'].max())   # older (larger BCE)
peak_BCE_recent= int(tied['BCE'].min())   # more recent (smaller BCE)
peak_group     = tied['group'].iloc[0]
window_BCE_low = peak_BCE_old + 100        # older edge of plateau
window_BCE_high= peak_BCE_recent           # younger edge of plateau

# === PRIOR TROUGH (active data only) ===
pre = active[active['BCE'] > peak_BCE_recent]
trough_idx   = pre['SC3'].idxmin()
trough_val   = float(pre.loc[trough_idx,'SC3'])
trough_BCE   = int(pre.loc[trough_idx,'BCE'])
trough_grp   = pre.loc[trough_idx,'group']
delta_SC3_trough_peak = peak_val - trough_val

# === LEAD WINDOW: 2 bins strictly before the peak plateau ===
lead_BCE = [peak_BCE_old + 100, peak_BCE_old + 200]
lead     = cap[cap['BCE'].isin(lead_BCE)]
peak_rep = cap[cap['BCE']==peak_BCE_recent].iloc[0]   # both tied bins identical

print(f"Peak plateau: BCE ∈ {{{peak_BCE_old},{peak_BCE_recent}}}; → CE_centers {peak_CE_cents}; SC3={peak_val:+.4f}")
print(f"Plateau window (chrono): {window_BCE_low}–{window_BCE_high} BCE ({peak_group})")
print(f"Lead window (2 bins strictly before plateau) BCE = {lead_BCE}")
print(f"Prior active trough: BCE={trough_BCE}, SC3={trough_val:+.4f} ({trough_grp})")
print(f"ΔSC3 trough→peak = {delta_SC3_trough_peak:+.4f}")

# === COMPONENT RISE/DECLINE ===
def at_peak(z):  return float(peak_rep[z])
def at_trough(z):return float(pre.loc[trough_idx,z])
def at_lead(z):  return float(lead[z].mean())
def indiv_peak(z):
    idx = cap[z].idxmax()
    return int(cap.loc[idx,'BCE']), int(cap.loc[idx,'CE_center']), cap.loc[idx,'group'], float(cap.loc[idx,z])

components = [
    ('CuAu',         cap, 'CuAu'),
    ('Amber',        cap, 'Amber'),
    ('MonumentCount',cap, 'MonumentCount'),
    ('MonumentSize', cap, 'MonumentSize'),
]
rows = []
for name, df, col in components:
    z_p   = at_peak(col)
    z_l   = at_lead(col)
    z_t   = at_trough(col)
    ipBCE, ipCE, ipG, ipZ = indiv_peak(col)
    rows.append({
        'component': name,
        'Z_at_peak_bin':           z_p,
        'Z_lead2_mean':            z_l,
        'delta_Z_lead2':           z_p - z_l,
        'Z_at_prior_trough':       z_t,
        'delta_Z_trough_to_peak':  z_p - z_t,
        'rose_into_peak_lead2':    bool((z_p - z_l) > 0),
        'individual_peak_BCE':     ipBCE,
        'individual_peak_CE_center': ipCE,
        'individual_peak_group':   ipG,
        'individual_peak_Z':       ipZ,
    })
comp_rise_df = pd.DataFrame(rows)
comp_rise_df.to_csv(os.path.join(ART,'component_rise.csv'), index=False)
print('\n=== Component rise summary ===')
print(comp_rise_df.to_string(index=False))

# === OPENNESS CROSS-CHECK at the peak century ===
pol = pd.read_csv(os.path.join(DATA,
    'pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv'), decimal=',')
def get_pol(ce_lo, ce_hi):
    s = pol[(pol['CE']>=ce_lo) & (pol['CE']<=ce_hi)]
    if len(s)==0: return (None,)*4
    return (float(s['Belau_PC1_inter'].mean()),
            float(s['MEAN'].mean()),
            float(s['SMOOTH_MEAN_100y'].mean()),
            float(s['Woserin_PC1_inter'].mean()))

m_ce       = ( (peak_CE_cents[0] if isinstance(peak_CE_cents,int) else sum(peak_CE_cents)/len(peak_CE_cents)) )
peak_pol   = get_pol(m_ce-50,  m_ce+50)
prev_pol   = get_pol(m_ce-150, m_ce-50)
trend = ('rising' if (peak_pol[0] is not None and prev_pol[0] is not None and peak_pol[0] > prev_pol[0])
         else 'falling' if (peak_pol[0] is not None and prev_pol[0] is not None) else 'unclear')
print(f"Openness at peak CE={m_ce}±50y:  Belau_PC1_inter={peak_pol[0]}, MEAN={peak_pol[1]}")
print(f"Openness prior 100y:               Belau_PC1_inter={prev_pol[0]}, MEAN={prev_pol[1]}")
print(f"→ openness trend at peak century: {trend}")

# === SENSITIVITY ARGMAX ===
sens = {
    'SC_mean_3_argmax_CE':              int(cap.loc[cap['SC_mean_3'].idxmax(),'CE_center']),
    'SC_mean_3_at_argmax':              float(cap['SC_mean_3'].max()),
    'SC_4_argmax_CE':                   int(cap.loc[cap['SC4'].idxmax(),'CE_center']),
    'SC_4_at_argmax':                   float(cap['SC4'].max()),
    'SC3_dt_argmax_CE':                 int(cap.loc[cap['SC3_dt'].idxmax(),'CE_center']),
    'SC3_dt_at_argmax':                 float(cap['SC3_dt'].max()),
    'cross_check_inter_argmax_CE':      int(cap.loc[cap['SC3_from_inter'].idxmax(),'CE_center']),
    'cross_check_inter_value':          float(cap['SC3_from_inter'].max()),
    'max_abs_diff_capital_vs_interbins': float(np.nanmax(np.abs(cap['SC3_from_inter']-cap['SC3']))),
}
print(f"\n=== Sensitivities ===")
for k,v in sens.items(): print(f"  {k}: {v}")

# === SAVE PRIMARY TABLE ===
keep = ['BCE','group','CE_left','CE_center',
        'CuAu','Amber','MonumentCount','MonumentSize',
        'SC3','SC_mean_3','SC4','SC3_dt',
        'SC3_from_inter','pollen_inter','pollen_inter_100','pollen_grate_100',
        'CuAu_dt','Amber_dt','MonCount_dt','is_prefilled']
cap[keep].to_csv(os.path.join(ART,'social_capital_by_bin.csv'), index=False)
print('\nSaved artifacts/social_capital_by_bin.csv')

# === HUMAN-READABLE PEAK SUMMARY (txt + json) ===
def cent_idx(b):
    """Century index for a BCE year, where 14 = 14th century BCE (1400-1301 BCE span)."""
    # bin midpoint in BCE terms: b+50 (if b is right edge); use ceiling so 1400 → 14th, 1300 → 13th
    mid = b + 50
    return -(-mid // 100)  # ceiling division (negate trick)

def cent_str(b):
    n = cent_idx(b)
    sfx = ({1:'st',2:'nd',3:'rd'}.get(n%10,'th')
           if not (11 <= (n%100) <= 13) else 'th')
    return f'{n}{sfx} century BCE'

cent_old    = cent_str(peak_BCE_old)
cent_recent = cent_str(peak_BCE_recent)
m_ce_int = -((-peak_BCE_old + (-peak_BCE_recent))//2) if False else int(round((peak_BCE_old + peak_BCE_recent)/2))

lines = []
L = lines.append
L('=== Archaeology/metadata_9 — PEAK SUMMARY ===')
L('')
L('(a) Peak century / bin window / phase')
L(f'    Peak SC3 = +{peak_val:.4f}σ from SC3 = Z(CuAu) + Z(Amber) + Z(MonumentCount), capital.csv raw Z, 100y bins.')
L(f'    Two adjacent OBA bins tied at the peak: capital.csv BCE = {peak_BCE_old} and BCE = {peak_BCE_recent},')
L(f'    with user-approved framing as one contiguous peak.')
L(f'    → Century labels: {cent_old} (older start) → {cent_recent} (recent end).')
L(f'    → Reporting window (user-approved framing): 1500–1300 BCE; peak-bin center CE ≈ 1400 BCE.')
L(f'    → Common-Era framing: ~{peak_BCE_recent} BCE / ~{1950+peak_BCE_recent} BP / ~{1950-peak_BCE_recent} cal BP.')
L(f'    → Phase label: {peak_group} (Older Bronze Age).')
L(f'    Numerical CE_centers of tied bins: {peak_CE_cents}.')
L('')
L('(b) SC3 at peak vs prior trough')
L(f'    SC3 at peak                            = +{peak_val:.4f}σ')
L(f'    SC3 at prior trough (BCE={trough_BCE}, phase={trough_grp}) = {trough_val:+.4f}σ')
L(f'    ΔSC3 (trough → peak)                   = {delta_SC3_trough_peak:+.4f}σ')
L(f'    (per-component mean ΔZ ≈ {delta_SC3_trough_peak/3:+.3f}σ)')
L('    Note: capital.csv rows BCE∈{4300,4200,4100} hold identical Z-values (prefilled envelope constants; '
  'no archaeological signal). Excluded from the active-data trough search; included in artefacts.')
L('')
L('(c) Per-component evidence — rose or declined into the peak (2-bin ~200y lead window)')
for r in rows:
    L(f"    {r['component']:13s}: Z_peak={r['Z_at_peak_bin']:+.3f}, "
      f"Z_lead2_mean={r['Z_lead2_mean']:+.3f}, "
      f"ΔZ_lead2={r['delta_Z_lead2']:+.3f} → "
      f"{'ROSE' if r['rose_into_peak_lead2'] else 'DECLINED'}. "
      f"Component own peak: BCE {r['individual_peak_BCE']} (CE_center {r['individual_peak_CE_center']}), "
      f"phase {r['individual_peak_group']}, Z={r['individual_peak_Z']:+.3f}.")
L('    (MonumentSize listed for sensitivity only — its Z is essentially flat across the lead window, '
  'so ΔZ_lead2≈0; inclusion in SC_4 raises the absolute peak magnitude, not its location.)')
L('')
L('(d) Openness (pollen-based) cross-check at the peak century')
L(f'    Belau_PC1_inter, ±50y around mean peak CE ({int(m_ce)}): {peak_pol[0]}')
L(f'    Belau_PC1_inter, prior 100y window:                   {prev_pol[0]}')
L(f'    MEAN (Belau+Woserin avg) at peak ±50y:                {peak_pol[1]}')
L(f'    MEAN, prior 100y window:                              {prev_pol[1]}')
L(f'    Trend: {trend}.')
L('    (Openness is rising through the peak century — supportive context only; pollen openness is not part of the social-capital index.)')
L('')
L('(e) Workflow')
L('    1. Loaded capital.csv (decimal=","), time_series_data.csv, and pollen_openness_*.csv (also German decimal).')
L('    2. Built SC3 = Z(CuAu) + Z(Amber) + Z(MonumentCount) for every 100y CE bin from capital.csv raw Z.')
L('    3. Cross-checked by aggregating time_series_data.*_inter bin-means to identical 100y CE bins.')
L('    4. Computed sensitivity variants SC_mean_3, SC_4 (+MonumentSize), SC_3_dt (within-phase detrended).')
L('    5. Identified two adjacent OBA bins tied at SC3 = +4.24σ (BCE 1400 and BCE 1300); reported as contiguous plateau window 1500–1300 BCE.')
L('    6. Computed prior trough on active (non-prefilled) data → LN phase (BCE 2000/1900, SC3 ≈ −1.86σ).')
L('    7. Computed per-component ΔZ over the 2-bin lead window (BCE 1600 and 1500) vs peak plateau.')
L('    8. Sampled pollen-based openness (Belau_PC1_inter, MEAN) at the peak vs prior century for cross-check.')
L('')
L('Artifacts:')
L('  artifacts/social_capital_by_bin.csv     — full bin-level SC table incl. sensitivities')
L('  artifacts/component_rise.csv            — per-component ΔZ roster')
L('  artifacts/peak_summary.json             — machine-readable peak facts')
L('  artifacts/peak_summary.txt              — this human-readable summary')
L('  artifacts/final_analysis.py             — this executable script')
L('  artifacts/aggregated_100y.csv           — earlier debug aggregate of time_series_data')

with open(os.path.join(ART,'peak_summary.txt'),'w') as f:
    f.write('\n'.join(lines))
print('\n'.join(lines))

# JSON
out = {
    'peak': {
        'SC3_value': peak_val,
        'BCE_old': peak_BCE_old, 'BCE_recent': peak_BCE_recent,
        'window_BCE_low': window_BCE_low, 'window_BCE_high': window_BCE_high,
        'CE_centers': peak_CE_cents,
        'century_label_lead': cent_old, 'century_label_recent': cent_recent,
        'phase': peak_group,
        'common_era_framing': f'~{peak_BCE_recent} BCE / ~{1950+peak_BCE_recent} BP',
        'cal_BP_at_peak': 1950 - peak_BCE_recent,
    },
    'prior_trough': {'BCE': trough_BCE, 'group': trough_grp, 'SC3': trough_val},
    'delta_SC3_trough_to_peak': delta_SC3_trough_peak,
    'lead_window_BCE': lead_BCE,
    'components': rows,
    'openness_cross_check': {
        'Belau_PC1_inter_at_peak': peak_pol[0],
        'Belau_PC1_inter_prior_100y': prev_pol[0],
        'MEAN_at_peak': peak_pol[1], 'MEAN_prior_100y': prev_pol[1],
        'trend': trend,
    },
    'sensitivities': sens,
}
with open(os.path.join(ART,'peak_summary.json'),'w') as f:
    json.dump(out, f, indent=2, default=float)
print('\nSaved peak_summary.txt and peak_summary.json')
