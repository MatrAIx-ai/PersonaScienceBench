"""
DiscoveryBench episode: nls_incarceration / metadata_11

Question: "What kind of demographic disparities exist in median wealth in 1985
among individuals who were ever incarcerated?"

Analysis plan (researcher-approved):
  - Primary hypothesis scope: WITHIN ever_jailed == 1 subset.
  - Wealth measure: composite_wealth_1985 (the only 1985 wealth column).
  - Demographic breakdowns: race (primary), sex (secondary).
  - Provide race-stratified ever_jailed vs never_jailed median comparison only
    as contextual evidence for magnitude / direction.
  - Omit race x sex joint cells from the headline hypothesis; flag as limitation.
  - Report N, median, Q1/Q3 IQR, mean for each group.
  - Raw race label is encoded as 'hipanic' in the CSV; written output uses
    'hispanic' (matches dataset description).
  - No inflation adjustment, no survey weights.
"""

import json
import pandas as pd
import numpy as np

PATH = "data/nls_incarceration_processed.csv"
df = pd.read_csv(PATH)

# --- Normalize the race label for reporting only. ---
race_label_map = {"hipanic": "hispanic"}
df["race_pretty"] = df["race"].map(lambda r: race_label_map.get(r, r))

# --- Helpers ----------------------------------------------------------
def stats_block(sub, label, wealth_col="composite_wealth_1985"):
    s = sub[wealth_col].dropna()
    return {
        "group": label,
        "n": int(len(s)),
        "median": float(s.median()),
        "q1": float(s.quantile(0.25)),
        "q3": float(s.quantile(0.75)),
        "iqr": float(s.quantile(0.75) - s.quantile(0.25)),
        "mean": float(s.mean()),
    }

# --- Ever-incarcerated vs never-incarcerated counts -------------------
ever = df[df["ever_jailed"] == 1]
never = df[df["ever_jailed"] == 0]
print(f"Total N: {len(df)}  | ever_jailed=1: {len(ever)}  | ever_jailed=0: {len(never)}")

# --- Radio label disclosure -------------------------------------------
print("\nNOTE: raw race column encodes 'hipanic'; report uses 'hispanic'.")

# --- 1) PRIMARY: Median composite_wealth_1985 by RACE (within ever) ----
race_ever = (
    ever.groupby("race_pretty")["composite_wealth_1985"]
        .agg(n="count", median="median",
             q1=lambda x: x.quantile(0.25),
             q3=lambda x: x.quantile(0.75),
             mean="mean")
        .reset_index()
        .sort_values("median")
)
race_ever["iqr"] = race_ever["q3"] - race_ever["q1"]
print("\n[PRIMARY] Median wealth_1985 by RACE among ever_jailed==1:")
print(race_ever.to_string(index=False))

# --- 2) SECONDARY: Median composite_wealth_1985 by SEX (within ever) ---
sex_ever = (
    ever.groupby("sex")["composite_wealth_1985"]
        .agg(n="count", median="median",
             q1=lambda x: x.quantile(0.25),
             q3=lambda x: x.quantile(0.75),
             mean="mean")
        .reset_index()
        .sort_values("median")
)
sex_ever["iqr"] = sex_ever["q3"] - sex_ever["q1"]
print("\n[SECONDARY] Median wealth_1985 by SEX among ever_jailed==1:")
print(sex_ever.to_string(index=False))

# --- 3) Contextual anchor: within-race ever vs never-median -----------
context = (
    df.groupby(["race_pretty", "ever_jailed"])["composite_wealth_1985"]
      .agg(n="count", median="median", mean="mean")
      .reset_index()
      .sort_values(["race_pretty", "ever_jailed"])
)
print("\n[CONTEXT ONLY] Median wealth_1985 by race x ever_jailed (full sample):")
print(context.to_string(index=False))

# --- 4) Race x sex cell sizes (limitation disclosure; medians not reported) ---
rs = ever.groupby(["race_pretty", "sex"]).size().reset_index(name="n").sort_values("n")
print("\n[LIMITATION] Race x sex cell sizes within ever_jailed==1 (medians not reported):")
print(rs.to_string(index=False))

# --- Persist summary outputs ------------------------------------------
out = {
    "n_total": int(len(df)),
    "n_ever_jailed": int(len(ever)),
    "n_never_jailed": int(len(never)),
    "primary_by_race_within_ever_jailed": race_ever.to_dict(orient="records"),
    "secondary_by_sex_within_ever_jailed": sex_ever.to_dict(orient="records"),
    "context_race_x_ever_jailed": context.to_dict(orient="records"),
    "limitation_race_x_sex_cell_sizes": rs.to_dict(orient="records"),
    "data_note": "Raw 'race' column encodes 'hipanic'; reporting uses 'hispanic'.",
}
with open("artifacts/analysis_summary.json", "w") as f:
    json.dump(out, f, indent=2, default=float)
print("\nWrote artifacts/analysis_summary.json")
