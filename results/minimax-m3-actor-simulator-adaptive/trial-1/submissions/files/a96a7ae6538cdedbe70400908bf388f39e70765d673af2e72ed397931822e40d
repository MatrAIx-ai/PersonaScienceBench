import json, numpy as np, pandas as pd, statsmodels.api as sm
import scipy.stats as ss

RAW = pd.read_csv("/workspace/data/worldbank_education_gdp.csv")
long = RAW.melt(id_vars=["Country Group","Country Code","Series Name","Series Code"],
                var_name="YearCol", value_name="Value")
long["Year"] = long["YearCol"].str.extract(r"(\d{4})").astype(int)
long["Value"] = pd.to_numeric(long["Value"], errors="coerce")
panel = long.pivot_table(index=["Country Group","Year"],
                         columns="Series Name", values="Value").reset_index()
panel.columns.name = None
panel = panel.rename(columns={
    "GNI per capita (constant 2015 USdollar)": "Y_gni_pc",
    "Adjusted savings: education expenditure (percentage of GNI)": "X_edu_pct_gni",
    "Exports of goods and services (annual percentage growth)": "W_exports_g",
    "School enrollment, primary (percentage gross)": "W_enr_primary",
    "School enrollment, secondary (percentage gross)": "W_enr_secondary",
    "Labor force participation rate, total (percentage of total population ages 15+) (modeled ILO estimate)": "W_lfp",
})
panel["lnY"]=np.log(panel["Y_gni_pc"]); panel["lnX"]=np.log(panel["X_edu_pct_gni"])
panel["lnPe"]=np.log(panel["W_enr_primary"]); panel["lnSe"]=np.log(panel["W_enr_secondary"])
panel["SSA"]=(panel["Country Group"]=="Sub-Saharan Africa").astype(int)

def ols(data, y, xcols, hac=0):
    sub = data.dropna(subset=[y]+xcols).copy()
    X = sm.add_constant(sub[xcols].astype(float))
    return sm.OLS(sub[y].astype(float), X, missing="drop").fit(
        cov_type="HAC", cov_kwds={"maxlags": int(hac)})
def grp_fd(d, cols, by="Country Group"):
    d = d.sort_values([by,"Year"]).copy()
    for c in cols:
        d["d_"+c] = d.groupby(by)[c].diff()
    return d
def add_lags(d, var, ks, by="Country Group"):
    d = d.sort_values([by,"Year"]).copy()
    for k in ks:
        d[f"{var}_L{k}"] = d.groupby(by)[var].shift(k)
    return d
def coef(res, name):
    if name in res.params.index:
        return {"estimate":float(res.params[name]),"se_hac":float(res.bse[name]),
                "t":float(res.tvalues[name]),"p":float(res.pvalues[name])}
    return None
def n_obs(res): return int(res.nobs)

# ============================================================
# TIER 1 -- 2011-2015 common panel (HEADLINE)
# ============================================================
print("="*78); print("TIER 1 -- 2011-2015 common panel (HEADLINE)"); print("="*78)
t1 = panel[(panel["Year"]>=2011)&(panel["Year"]<=2015)].copy()
t1["SSA_x_lnX"] = t1["SSA"]*t1["lnX"]
t1_lev = ols(t1, "lnY", ["lnX","SSA","SSA_x_lnX"], hac=2)
b_lmc_lev = coef(t1_lev,"lnX")
b_diff_lev = coef(t1_lev,"SSA_x_lnX")
b_ssa_e = b_lmc_lev["estimate"] + b_diff_lev["estimate"]
cov_mat = t1_lev.cov_params()
b_ssa_se = float(np.sqrt(b_lmc_lev["se_hac"]**2 + b_diff_lev["se_hac"]**2
                        + 2*cov_mat.loc["lnX","SSA_x_lnX"]))
t_ssa = b_ssa_e / b_ssa_se
df = t1_lev.df_resid if t1_lev.df_resid > 0 else 1
p_ssa = 2*(1 - ss.t.cdf(abs(t_ssa), df=df))
b_ssa_lev = {"estimate":float(b_ssa_e),"se_hac":b_ssa_se,
             "t":float(t_ssa),"p":float(p_ssa)}
print("Pooled 2011-2015 levels, lnY ~ lnX + SSA + SSA*lnX, HAC(2):")
print(t1_lev.summary().tables[1])
print("LMC-only (2011-2015) levels:")
res_lmc_t1 = ols(t1[t1["SSA"]==0], "lnY", ["lnX"], hac=2)
print(res_lmc_t1.summary().tables[1])
print("SSA-only (2011-2015) levels:")
res_ssa_t1 = ols(t1[t1["SSA"]==1], "lnY", ["lnX"], hac=0)
print(res_ssa_t1.summary().tables[1])
t1f = grp_fd(t1, ["lnY","lnX"]).copy()
t1f["SSA_x_dlnX"] = t1f["SSA"]*t1f["d_lnX"]
t1_fd_res = ols(t1f, "d_lnY", ["d_lnX","SSA","SSA_x_dlnX"], hac=0)
print("Pooled 2011-2015 FD, d_lnY ~ d_lnX + SSA + SSA*d_lnX, HAC(0):")
print(t1_fd_res.summary().tables[1])

tier1 = {
    "headline": {
        "sample_window": "2011-2015 (5 annual obs per group; pooled N=10)",
        "binding_constraint": "SSA GNI per capita available only 2011-2015 (36/41 yrs missing).",
        "spec_levels_with_interaction": {
            "equation": "ln(GNI_pc) = a + b_LMC * ln(X) + b_SSA * SSA + b_diff * (SSA*ln(X))",
            "b_LMC": b_lmc_lev,
            "b_interaction_SSA_minus_LMC": b_diff_lev,
            "b_SSA_implied": b_ssa_lev,
            "n_obs": n_obs(t1_lev), "R2": float(t1_lev.rsquared),
        },
        "spec_first_diff_with_interaction": {
            "equation": "d_ln(GNI_pc) = a + b*d_ln(X) + b_SSA*SSA + b_diff*(SSA*d_ln(X))",
            "b_d_lnX_LMC": coef(t1_fd_res,"d_lnX"),
            "b_diff_SSA_minus_LMC": coef(t1_fd_res,"SSA_x_dlnX"),
            "n_obs": n_obs(t1_fd_res),
        },
        "group_specific_levels_n5_each": {
            "LMC": coef(res_lmc_t1,"lnX"),
            "SSA": coef(res_ssa_t1,"lnX"),
        }
    }
}

# ============================================================
# TIER 2 -- LMC anchor (1975-2015)
# ============================================================
print(); print("="*78); print("TIER 2 -- LMC anchor 1975-2015"); print("="*78)
LAGS = [0,1,3,5,10]
LMC = panel[panel["Country Group"]=="Lower middle income"].copy().sort_values("Year")
LMC = add_lags(LMC, "lnX", LAGS)
t2_lag = {}
for k in LAGS:
    res = ols(LMC, "lnY", [f"lnX_L{k}"], hac=4)
    t2_lag[k] = coef(res, f"lnX_L{k}")
    print(f"LMC ln-ln level lag{k:2d}: b={t2_lag[k]['estimate']:+.3f} t={t2_lag[k]['t']:+.3f} n={n_obs(res)}")

LMC_fd = grp_fd(LMC, ["lnY","lnX"]+[f"lnX_L{k}" for k in LAGS])
LMC_fd["d_lnX_now"] = LMC_fd["d_lnX"]
AR_LAGS = [1,3,5,10]
for k in AR_LAGS:
    LMC_fd[f"d_lnX_L{k}"] = LMC_fd.groupby("Country Group")["d_lnX"].shift(k)
res_t2_ardl = ols(LMC_fd, "d_lnY", ["d_lnX_now"]+[f"d_lnX_L{k}" for k in AR_LAGS], hac=4)
print("\nLMC FD-ARDL:")
print(res_t2_ardl.summary().tables[1])
fd_lag_coefs = {"0": float(res_t2_ardl.params["d_lnX_now"])}
for k in AR_LAGS:
    fd_lag_coefs[str(k)] = float(res_t2_ardl.params[f"d_lnX_L{k}"])

ctrl_full = ["lnX","W_enr_primary","W_enr_secondary","W_exports_g","W_lfp"]
res_t2_ctrl = ols(LMC, "lnY", ctrl_full, hac=4)
print("\nLMC ln-ln level + controls:")
print(res_t2_ctrl.summary().tables[1])
t2_ctrl = {c: coef(res_t2_ctrl,c) for c in ctrl_full}

LMC_nc = LMC[~LMC["Year"].isin([2008,2009,2010])]
res_t2_nc = ols(LMC_nc, "lnY", ["lnX","W_enr_primary","W_exports_g"], hac=4)
print("\nLMC robustness - drop 2008-2010:")
print(res_t2_nc.summary().tables[1])

LMC_blk = LMC.copy()
LMC_blk["YearBlock"] = (LMC_blk["Year"]//5)*5
LMC_blk = LMC_blk.groupby("YearBlock").agg(
    lnY=("lnY","mean"), lnX=("lnX","mean"),
    W_enr_primary=("W_enr_primary","mean"),
    W_exports_g=("W_exports_g","mean")).dropna().reset_index()
res_t2_blk = ols(LMC_blk, "lnY", ["lnX","W_enr_primary"], hac=2)
print("\nLMC 5-year block averages (HAC 2):")
print(res_t2_blk.summary().tables[1])

tier2 = {
    "spec_levels_lag": {str(k): t2_lag[k] for k in LAGS},
    "spec_fd_ardl": {"lag_coefs": fd_lag_coefs,
                     "n_obs": n_obs(res_t2_ardl),
                     "R2": float(res_t2_ardl.rsquared)},
    "spec_with_controls": t2_ctrl,
    "robustness_drop_2008_2010": coef(res_t2_nc,"lnX"),
    "robustness_5y_block": coef(res_t2_blk,"lnX"),
}

# ============================================================
# TIER 3 -- SSA triangulation via enrollment channel
# ============================================================
print(); print("="*78); print("TIER 3 -- SSA triangulation via enrollment channel"); print("="*78)
tri = grp_fd(panel, ["lnX","lnPe","lnSe"]).copy()
scope1 = tri.dropna(subset=["d_lnX","d_lnPe"]).copy()
scope1["SSA_x_dlnX"] = scope1["SSA"]*scope1["d_lnX"]
res_t3_pe = ols(scope1, "d_lnPe", ["d_lnX","SSA","SSA_x_dlnX"], hac=4)
print("Pooled FD d_ln(Primary Enroll) ~ d_lnX + SSA + SSA*d_lnX:")
print(res_t3_pe.summary().tables[1])

scope2 = tri.dropna(subset=["d_lnX","d_lnSe"]).copy()
scope2["SSA_x_dlnX"] = scope2["SSA"]*scope2["d_lnX"]
res_t3_se = ols(scope2, "d_lnSe", ["d_lnX","SSA","SSA_x_dlnX"], hac=4)
print("Pooled FD d_ln(Secondary Enroll) ~ d_lnX + SSA + SSA*d_lnX:")
print(res_t3_se.summary().tables[1])

b_pe_lmc = ols(scope1[scope1["SSA"]==0],"d_lnPe",["d_lnX"],hac=4)
b_pe_ssa = ols(scope1[scope1["SSA"]==1],"d_lnPe",["d_lnX"],hac=4)
b_se_lmc = ols(scope2[scope2["SSA"]==0],"d_lnSe",["d_lnX"],hac=4)
b_se_ssa = ols(scope2[scope2["SSA"]==1],"d_lnSe",["d_lnX"],hac=4)
print(f"\nPrim enr: LMC b={coef(b_pe_lmc,'d_lnX')['estimate']:+.3f} ({coef(b_pe_lmc,'d_lnX')['t']:+.2f})  "
      f"SSA b={coef(b_pe_ssa,'d_lnX')['estimate']:+.3f} ({coef(b_pe_ssa,'d_lnX')['t']:+.2f})")
print(f"Sec  enr: LMC b={coef(b_se_lmc,'d_lnX')['estimate']:+.3f} ({coef(b_se_lmc,'d_lnX')['t']:+.2f})  "
      f"SSA b={coef(b_se_ssa,'d_lnX')['estimate']:+.3f} ({coef(b_se_ssa,'d_lnX')['t']:+.2f})")

tri_l5 = grp_fd(panel, ["lnX","lnPe","lnSe"])
tri_l5["d_lnX_L5"] = tri_l5.groupby("Country Group")["d_lnX"].shift(5)
tri_l5["SSA_x_dlnX5"] = tri_l5["SSA"]*tri_l5["d_lnX_L5"]
lag_pe = tri_l5.dropna(subset=["d_lnPe","d_lnX_L5"])
res_t3_pe_l5 = ols(lag_pe, "d_lnPe", ["d_lnX_L5","SSA","SSA_x_dlnX5"], hac=4)
print("\n[T3] 5y lag primary enroll channel:")
print(res_t3_pe_l5.summary().tables[1])

tier3 = {
    "primary_enrollment": {
        "beta_LMC": coef(b_pe_lmc,"d_lnX"),
        "beta_SSA": coef(b_pe_ssa,"d_lnX"),
        "pooled_main_diff": coef(res_t3_pe,"d_lnX"),
        "pooled_interaction": coef(res_t3_pe,"SSA_x_dlnX"),
        "pooled_n_obs": n_obs(res_t3_pe),
    },
    "secondary_enrollment": {
        "beta_LMC": coef(b_se_lmc,"d_lnX"),
        "beta_SSA": coef(b_se_ssa,"d_lnX"),
        "pooled_main_diff": coef(res_t3_se,"d_lnX"),
        "pooled_interaction": coef(res_t3_se,"SSA_x_dlnX"),
        "pooled_n_obs": n_obs(res_t3_se),
    },
    "primary_enrollment_lag5": {
        "pooled_main_diff": coef(res_t3_pe_l5,"d_lnX_L5"),
        "pooled_interaction": coef(res_t3_pe_l5,"SSA_x_dlnX5"),
        "pooled_n_obs": n_obs(res_t3_pe_l5),
    },
}

print(); print("="*78); print("SAVING RESULTS"); print("="*78)
results = {"tier1_headline": tier1, "tier2_lmc_anchor": tier2,
           "tier3_ssa_triangulation": tier3}
with open("results.json","w") as f:
    json.dump(results, f, indent=2)
print("Wrote results.json")
