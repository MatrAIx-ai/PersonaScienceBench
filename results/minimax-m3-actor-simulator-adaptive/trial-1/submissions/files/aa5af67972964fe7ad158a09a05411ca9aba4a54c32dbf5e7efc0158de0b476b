            kw_change_rows.append({"period":period_short,"pathway":path,"H":H,"p":p,"eps2":eps2,
                                    "n_progressive":len(groups[0]),"n_regressive":len(groups[1]),"n_no_changes":len(groups[2]),
                                    "mean_prog":float(groups[0].mean()),"mean_reg":float(groups[1].mean()),"mean_noch":float(groups[2].mean())})
        except Exception: pass
pd.DataFrame(kw_change_rows).to_csv(filepath, index=False)
log(f"  Saved {filepath}: {pd.DataFrame(kw_change_rows).shape}")

