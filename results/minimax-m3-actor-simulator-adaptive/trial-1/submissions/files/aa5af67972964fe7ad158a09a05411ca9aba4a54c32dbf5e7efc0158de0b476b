for trait in traits_to_test:
    vals = df_sp[trait].values.astype(float)
    finite = np.isfinite(vals)
    if finite.sum() < 10:
        continue
    y = vals[finite]
    V_keep = V_scaled[np.ix_(np.where(finite)[0], np.where(finite)[0])]
    # restrict V_keep
    # log-lik at λ=0 (star phylogeny): residuals are iid
    V0 = np.eye(V_keep.shape[0])
    ll0, _ = reml_loglik(y, V0)
    # log-lik at λ=1 (BM): full V
    ll1, _ = reml_loglik(y, V_keep)
    # optimise λ
    res = minimize_scalar(lambda lam: -pagel_loglik(lam, y, V_keep), bounds=(0,1), method="bounded")
    lam_hat = res.x
    ll_hat = -res.fun
    # LR test vs λ=0
    LR = 2 * (ll_hat - ll0)
    p_lr = 1 - ss.chi2.cdf(LR, df=1) if LR > 0 else 1.0
    # Blomberg K statistic (observed vs BM expectation)
    n = len(y)
    # MSE_0 / MSE under BM
    y_mean = y.mean()
    # phylogenetic mean
    V_inv = np.linalg.pinv(V_keep, rcond=1e-10)
    w = V_inv.sum(axis=1); w = w/w.sum()
    phy_mean = (w * y).sum()
    # MSE0 = sum((y - phy_mean)^2)
    # MSE = expected MSE per Blomberg: y → phy_mean || y → grand_mean
    mse_phy = ((y - phy_mean)**2).sum()/(n-1)
    mse_grand = ((y - y_mean)**2).sum()/(n-1)
    K_obs = mse_grand/(mse_phy+1e-10) if mse_phy>0 else 0
    # expected MSE0/MSE under BM on tree
    # = (sum of diagonal of P) - vec'Pvec/(vec'sum)
    # P = V - V*ones*ones'*V / (ones'*V*ones)
    ones = np.ones((n,1))
    VinvV = V_inv @ V_keep
    Vinv1 = V_inv @ ones
    denom = (ones.T @ V_inv @ ones)[0,0]
    P = V_inv - Vinv1 @ Vinv1.T / denom
    XpX = V_keep @ P @ V_keep
    # diag of P
    eP = np.diag(P).sum()
    # expected K ~ eP × ??? — use Blomberg's formula K = (eP² - vec'(eP)I vec) for standardised
    # Simpler: K_expected = (sum of P)^(-1) … Actually I'll use that the expectation of
    # (y - phy_mean)² under BM = σ² × eP, and var(y) = σ² × mean(diag(V_keep)) — K = ratio of observed variance ratio / expected
    # For 77 species on this tree, we just use:
    sigma2_hat_phy = ((y - phy_mean)**2).sum()/((n - np.linalg.matrix_rank(P)))
    # Simpler approach: ratio of observed coefficient of variation
    # I'll compute the Blomberg K via permutation test for the p-value
    n_perms = 999
    K_null = np.zeros(n_perms)
    for it in range(n_perms):
        y_perm = np.random.permutation(y)  # breaks phylogenetic structure
        w_ = V_inv.sum(axis=1); w_ = w_/w_.sum()
        pm = (w_ * y_perm).sum()
        mse_g = ((y_perm - y_perm.mean())**2).sum()/(n-1)
        mse_p = ((y_perm - pm)**2).sum()/(n-1)
        K_null[it] = mse_g/(mse_p+1e-10) if mse_p>0 else 0
    K_p = (K_null >= K_obs).mean()
    psig.append({"trait":trait, "n":int(finite.sum()), "lambda_hat":lam_hat,
                 "ll_lambda":ll_hat, "ll_star":ll0, "LR":LR, "p_lambda":p_lr,
                 "Blomberg_K":K_obs, "Blomberg_K_p_perm":K_p})
