"""
=============================================================
DiscoveryBench — full_workflow
Episode: introduction_pathways_non-native_plants/metadata_5.json/0/2
Question: "How did urban land use affect the invasion of
           different types of introduced plants?"
=============================================================

Pipeline (per researcher-approved plan):
  (a) Deduplicate and normalise labels
  (b) Plot-level Kruskal-Wallis (+ Dunn) for urban.YYYY.buffer x pathway
  (c) GLM (Poisson/NB) of n.pathway ~ urban.YYYY.500m + habitat +
      elevation + climate + distances (FDR BH)
  (d) Composition pathway x urban via Additive Log-Ratio transform
      (LM on alr(n.gard, n.unint, n.agfo))
  (e) Chi-square historical change x dominant pathway
  (f) PGLS species-level for area.of.occupancy.10km and
      invaded.niche.breadth with traits + species-mean urban cover
  (g) Integrate temporal_trends_contingency_table.csv as intro narrative.
"""
import os, json, re, warnings, sys
sys.path.insert(0, '/workspace/code')
import numpy as np, pandas as pd, scipy.stats as ss
from scipy.spatial.distance import squareform, pdist
from scipy.optimize import minimize_scalar
import statsmodels.api as sm
import statsmodels.formula.api as smf
from statsmodels.genmod.families import NegativeBinomial, Poisson
from statsmodels.stats.multitest import multipletests
warnings.filterwarnings("ignore")
np.random.seed(42)

from newick import parse as newick_parse

DATA = "/workspace/data"
OUT  = "/workspace/artifacts"
os.makedirs(OUT, exist_ok=True)

ARTIFACT_LOG = []
def log(msg):
    print(msg, flush=True)
    ARTIFACT_LOG.append(str(msg))

# ===============================================================
# 0. Load
# ===============================================================
log("="*72)
log("STEP 0: Loading data")
log("="*72)
df_trends = pd.read_csv(f"{DATA}/temporal_trends_contingency_table.csv", sep="\t")
df_sp     = pd.read_csv(f"{DATA}/invasion_success_pathways.csv")
df_niche  = pd.read_csv(f"{DATA}/invaded_niche_pathways.csv", sep="\t")
with open(f"{DATA}/phylogenetic_tree.txt") as f:
    newick_raw = f.read().strip()
log(f"  temporal_trends   : {df_trends.shape}")
log(f"  invasion_success  : {df_sp.shape}  (raw, before dedup)")
log(f"  invaded_niche     : {df_niche.shape}")
log(f"  phylogenetic tree : single-line Newick, {len(newick_raw)} chars")

# ===============================================================
# (a) Deduplicate species rows & normalise labels
# ===============================================================
log("\n"+"="*72); log("STEP (a): Deduplication and label normalisation"); log("="*72)
n_raw = len(df_sp)
df_sp = df_sp[df_sp["duplicated"]==False].reset_index(drop=True).copy()
log(f"  Duplicate rows dropped: {n_raw - len(df_sp)}")
log(f"  Species-level dataset now: {df_sp.shape}")

# Parse Newick to get all leaves exactly as they appear
tree_dict = newick_parse(newick_raw)
all_leaves = []
def _walk(n):
    if n["kind"] == "leaf":
        all_leaves.append(n["label"])
    else:
        for ch in n["children"]: _walk(ch)
_walk(tree_dict)
tree_tips = set(all_leaves)
log(f"  Tree contains {len(all_leaves)} unique leaves (incl. `_2` duplicates and hyphenated Opuntia)")
log(f"  All 77 species labels match a tree tip: {set(df_sp['phylo.tip.label']).issubset(tree_tips)}")

df_sp["phylo_tip_norm"] = df_sp["phylo.tip.label"]
df_sp["has_tree_tip"] = df_sp["phylo_tip_norm"].isin(tree_tips)
log(f"  Of {len(df_sp)} species, {df_sp['has_tree_tip'].sum()} have a tree-tip match.")
df_sp.to_csv(f"{OUT}/invasion_success_clean.csv", index=False)
log(f"  Pathway counts after dedup: {df_sp['intro.pathway'].value_counts().to_dict()}")
df_sp = df_sp.rename(columns={"growth.form":"growth_form_cat"})

# Save tree_dict for downstream
with open(f"{OUT}/tree_dict.json","w") as f:
    json.dump(tree_dict, f)

# ===============================================================
# 1. Tree → VCV matrix (for phylogenetic signal & PGLS)
# ===============================================================
log("\n"+"="*72); log("STEP 1: Phylogenetic VCV matrix from Newick"); log("="*72)

# Convert list of leaves (in traversal order) → dict for tree, and build a node index.
# Pre-order traversal to collect ALL nodes (leaves + internals) with stable IDs.
nodes = []  # list of dicts with id, kind, label, parent_id, length, depth
def _index(n, parent_id, cum_len):
    my_id = len(nodes)
    nodes.append({"id": my_id, "kind": n["kind"], "label": n["label"],
                  "parent_id": parent_id, "length": n["length"], "cum_len": cum_len,
                  "children": []})
    if parent_id is not None:
        nodes[parent_id]["children"].append(my_id)
    for ch in n["children"]:
        _index(ch, my_id, cum_len + ch["length"])
_index(tree_dict, None, 0.0)
leaves_idx = [n["id"] for n in nodes if n["kind"]=="leaf"]
tip_labels = [nodes[i]["label"] for i in leaves_idx]
tip_index_in_nodes = {lab: nid for lab, nid in zip(tip_labels, leaves_idx)}
log(f"  Total nodes indexed: {len(nodes)}; leaves: {len(leaves_idx)}")

# For each pair of leaves compute shared path length (= branch length from root to MRCA)
def root_to_tip(lab):
    return nodes[tip_index_in_nodes[lab]]["cum_len"]

def mrca_distance(a, b):
    """Distance (branch length) from root to MRCA of two leaves."""
    pa = tip_index_in_nodes[a]; pb = tip_index_in_nodes[b]
    # walk up both paths until they meet
    ancestors_a = []
    cur = pa
    while cur is not None:
        ancestors_a.append(cur); cur = nodes[cur]["parent_id"]
    ancestors_b = set()
    cur = pb
    while cur is not None:
        ancestors_b.add(cur); cur = nodes[cur]["parent_id"]
    # find first common
    mrca = None
    for a_id in ancestors_a:
        if a_id in ancestors_b:
            mrca = a_id; break
    return nodes[mrca]["cum_len"]

V = np.zeros((len(leaves_idx), len(leaves_idx)))
for i, la in enumerate(tip_labels):
    for j, lb in enumerate(tip_labels):
        V[i,j] = (root_to_tip(la) + root_to_tip(lb))/2.0 - mrca_distance(la, lb)/2.0
# Numerical safety: V should be symmetric PSD (it's a covariance)
V = (V + V.T) / 2.0
# Make PD
w, v = np.linalg.eigh(V)
w_pos = np.maximum(w, 1e-8)
V_psd = v @ np.diag(w_pos) @ v.T

np.save(f"{OUT}/vcv_matrix.npy", V_psd)
log(f"  VCV shape: {V_psd.shape}")
log(f"  V diagonal mean: {np.diag(V_psd).mean():.3f}")
log(f"  V sample off-diagonal (median): {np.median(V_psd[np.triu_indices_from(V_psd,1)]):.3f}")
log(f"  Min diag: {np.diag(V_psd).min():.3f}, max diag: {np.diag(V_psd).max():.3f}")

# ===============================================================
# (b) Plot-level urban footprint by pathway (Kruskal-Wallis + Dunn)
# ===============================================================
log("\n"+"="*72); log("STEP (b): Plot-level urban footprint x pathway"); log("="*72)

# Per plot, the "urban exposure" of each pathway is the urban cover at the plot,
# repeated n.pathway times across that pathway's species. We use the
# mean urban cover over all plots as pathway-level exposure.
buffers = [50, 500, 1000]
years = [1956, 1993, 2009]
primary_buf = 500  # primary per researcher decision

# Mean per-plot urban per year×buffer
urban_means = {y: {b: df_niche[f"urban.{y}.{b}m"].mean() for b in buffers} for y in years}
log("  Mean urban cover (across 632 plots):")
for y in years:
    row = "    " + ", ".join([f"urban.{y}.{b}m={urban_means[y][b]:.3f}" for b in buffers])
    log(row)

# Pathway "exposure" at plot level: replicate plot's urban cover n.pathway times
# Compute summary stats per pathway-year-buffer
exposure_rows = []
for y in years:
    for b in buffers:
        col = f"urban.{y}.{b}m"
        for path in ["Gardening","AgriForest","Unintentional"]:
            nc = f"n.{ {'Gardening':'gard','AgriForest':'agfo','Unintentional':'unint'}[path]}"
            # expand plot list: each plot contributes its urban[col] value n.pathway times
            vals = np.repeat(df_niche[col].values, df_niche[nc].values.astype(int))
            if len(vals)==0:
                mean=v=0
            else:
                mean = vals.mean(); v = np.median(vals)
            exposure_rows.append({"year":y, "buffer_m":b, "pathway":path,
                                   "n_obs":len(vals), "mean":mean, "median":v})
df_exp = pd.DataFrame(exposure_rows)
log("\n  Pathway × year × buffer urban exposure (mean across plot×species incidences):")
log(df_exp.pivot_table(index=["year","buffer_m"], columns="pathway", values="mean").round(3).to_string())

# Kruskal-Wallis across pathways for each (year, buffer)
kw_results = []
for y in years:
    for b in buffers:
        col = f"urban.{y}.{b}m"
        groups = []
        for path in ["Gardening","AgriForest","Unintentional"]:
            nc = f"n.{ {'Gardening':'gard','AgriForest':'agfo','Unintentional':'unint'}[path]}"
            vals = np.repeat(df_niche[col].values, df_niche[nc].values.astype(int))
            groups.append(vals)
        H, p = ss.kruskal(*groups)
        # Epsilon-squared effect size
        n_total = sum(len(g) for g in groups)
        eps2 = H / (n_total - 1) if n_total > 1 else np.nan
        kw_results.append({"year":y, "buffer_m":b, "H":H, "p":p, "epsilon2":eps2, "n":n_total})
df_kw = pd.DataFrame(kw_results)
# Bonferroni
df_kw["p_bonf"] = np.minimum(df_kw["p"]*len(df_kw), 1.0)
log("\n  Kruskal-Wallis (urban ~ pathway), incidence-weighted at plot level:")
log(df_kw.round(4).to_string(index=False))

# Pairwise Mann–Whitney U with BH adjustment
mw_rows = []
for y in years:
    for b in buffers:
        col = f"urban.{y}.{b}m"
        groups = {}
        for path in ["Gardening","AgriForest","Unintentional"]:
            nc = f"n.{ {'Gardening':'gard','AgriForest':'agfo','Unintentional':'unint'}[path]}"
            groups[path] = np.repeat(df_niche[col].values, df_niche[nc].values.astype(int))
        pairs = [("Gardening","AgriForest"),("Gardening","Unintentional"),("AgriForest","Unintentional")]
        for p1,p2 in pairs:
            u,p = ss.mannwhitneyu(groups[p1], groups[p2], alternative="two-sided")
            # rank-biserial r
            n1,n2 = len(groups[p1]), len(groups[p2])
            r = 1 - 2*u/(n1*n2)
            mw_rows.append({"year":y,"buffer_m":b,"pair":f"{p1} vs {p2}","U":u,"p":p,"rank_biserial":r,"n1":n1,"n2":n2})
df_mw = pd.DataFrame(mw_rows)
# BH adjustment across all pairwise tests
df_mw["p_bh"] = multipletests(df_mw["p"], method="fdr_bh")[1]
log("\n  Pairwise Mann-Whitney (BH-adjusted) at primary buffer 500 m:")
log(df_mw[df_mw.buffer_m==primary_buf].round(4).to_string(index=False))
df_mw.to_csv(f"{OUT}/mw_pairwise.csv", index=False)
df_kw.to_csv(f"{OUT}/kw_results.csv", index=False)

# ===============================================================
# (c) GLM Poisson / NB: n.pathway ~ urban + covariates
# ===============================================================
log("\n"+"="*72)
log("STEP (c): Plot-level GLM of pathway counts ~ urban + covariates (primary buffer 500m)")
log("="*72)

# Build design
df = df_niche.copy()
df["log_dist_stream"] = np.log1p(df["distance.stream"])
df["log_dist_road"]   = np.log1p(df["distance.road"])
# habitat dummies (reference = Urban)
habitat_dummies = pd.get_dummies(df["habitat"], prefix="hab", drop_first=False)
habitat_ref = "hab_Urban"
df_glm = pd.concat([df, habitat_dummies], axis=1)
# Standardise continuous predictors for stable β estimates
for col in [f"urban.{y}.{primary_buf}m" for y in years] + \
           ["cropland.2009.500m","elevation","annual.temperature",
            "annual.rainfall","annual.rainfall",  # n.b.
            ] + ["log_dist_stream","log_dist_road"]:
    pass

# Important: prepare predictors as z-scored continuous
cont_cols = []
for y in years:
    for col in [f"urban.{y}.{primary_buf}m", f"cropland.{y}.{primary_buf}m"]:
        zcol = f"{col}_z"
        df_glm[zcol] = (df_glm[col] - df_glm[col].mean())/df_glm[col].std()
        cont_cols.append(zcol)
for col in ["elevation","annual.temperature","annual.rainfall","annual.radiation",
            "log_dist_stream","log_dist_road"]:
    zcol = f"{col}_z"
    df_glm[zcol] = (df_glm[col] - df_glm[col].mean())/df_glm[col].std()
    cont_cols.append(zcol)

# Habitat + year dummies
hab_dummies = [c for c in df_glm.columns if c.startswith("hab_") and c != habitat_ref]
predictors = ["urban.2009.500m_z","urban.1993.500m_z","urban.1956.500m_z",
              "cropland.2009.500m_z","cropland.1993.500m_z","cropland.1956.500m_z",
              "elevation_z","annual.temperature_z","annual.rainfall_z",
              "annual.radiation_z","log_dist_stream_z","log_dist_road_z"] + hab_dummies

# Model each pathway
glm_results = []
for path, nc in [("Gardening","n.gard"), ("Unintentional","n.unint"), ("AgriForest","n.agfo")]:
    log(f"\n  --- Pathway: {path} (response: {nc}) ---")
    y = df_glm[nc].astype(int).values
    X = sm.add_constant(df_glm[predictors].astype(float))
    # Try Poisson first
    try:
        mod_p = sm.GLM(y, X, family=sm.families.Poisson()).fit(maxiter=200)
        # Check overdispersion
        pearson_chi2 = mod_p.pearson_chi2
        df_resid = mod_p.df_resid
        overdispersion = pearson_chi2/df_resid if df_resid>0 else np.nan
        log(f"    Poisson Pearson chi2/df = {overdispersion:.3f} ({'OK' if overdispersion<1.5 else 'overdispersed -> NB'})")
        if overdispersion > 1.5 or overdispersion < 0.4:
            # Use NB2 via statsmodels NegativeBinomial
            try:
                mod_nb = sm.GLM(y, X, family=sm.families.NegativeBinomial(alpha=max(overdispersion-1,0.1))).fit(maxiter=200)
                used = "NB"; mod = mod_nb
            except Exception as e:
                used="Poisson"; mod = mod_p; log(f"    NB failed ({e}); kept Poisson")
        else:
            used = "Poisson"; mod = mod_p
        # Coefs of main interest: urban terms
        main = [c for c in predictors if c.startswith("urban.")]
        for c in main:
            glm_results.append({"pathway":path, "predictor":c, "estimate":mod.params[c],
                                 "stderr":mod.bse[c], "z":mod.params[c]/mod.bse[c] if mod.bse[c]>0 else np.nan,
                                 "p":mod.pvalues[c], "model":used,
                                 "pseudoR2":1-mod.deviance/mod.null_deviance,
                                 "AIC":mod.aic, "n":int(mod.nobs),
                                 "overdispersion":overdispersion})
        # save full
        with open(f"{OUT}/glm_full_{path}.txt","w") as f:
            f.write(mod.summary().as_text())
    except Exception as e:
        log(f"    GLM failed for {path}: {e}")

df_glm_res = pd.DataFrame(glm_results)
# BH adjustment within pathway
df_glm_res["p_bh"] = np.nan
for path in df_glm_res.pathway.unique():
    mask = df_glm_res.pathway==path
    df_glm_res.loc[mask, "p_bh"] = multipletests(df_glm_res.loc[mask,"p"], method="fdr_bh")[1]
log("\n  GLM coefficients on urban (z-scored) for primary buffer 500m:")
log(df_glm_res.round(4).to_string(index=False))
df_glm_res.to_csv(f"{OUT}/glm_results.csv", index=False)

# ===============================================================
# (c') Per-year GLM models to avoid collinearity across years
# ===============================================================
log("\n"+"="*72)
log("STEP (c'): Per-year GLM (avoid year-collinearity) at primary 500m buffer")
log("="*72)

per_year_results = []
for path, nc in [("Gardening","n.gard"),("Unintentional","n.unint"),("AgriForest","n.agfo")]:
    for y in years:
        urban_col = f"urban.{y}.{primary_buf}m"
        crop_col  = f"cropland.{y}.{primary_buf}m"
        # Single-year predictor set
        pred_set = [f"{urban_col}_z", f"{crop_col}_z",
                    "elevation_z","annual.temperature_z","annual.rainfall_z",
                    "annual.radiation_z","log_dist_stream_z","log_dist_road_z"] + hab_dummies
        y_vec = df_glm[nc].astype(int).values
        X = sm.add_constant(df_glm[pred_set].astype(float))
        try:
            mod = sm.GLM(y_vec, X, family=sm.families.Poisson()).fit(maxiter=200)
            used = "Poisson"; disp = mod.pearson_chi2/mod.df_resid
            if disp > 1.5:
                try:
                    mod = sm.GLM(y_vec, X, family=sm.families.NegativeBinomial(alpha=max(disp-1,0.1))).fit(maxiter=200)
                    used="NB"
                except: pass
            uc = f"{urban_col}_z"
            cc = f"{crop_col}_z"
            per_year_results.append({"pathway":path,"year":y,"model":used,"n":int(mod.nobs),
                "urban_beta":mod.params[uc], "urban_se":mod.bse[uc],
                "urban_z":mod.params[uc]/mod.bse[uc] if mod.bse[uc]>0 else np.nan,
                "urban_p":mod.pvalues[uc],
                "crop_beta":mod.params[cc], "crop_p":mod.pvalues[cc],
                "pseudoR2":1-mod.deviance/mod.null_deviance, "AIC":mod.aic,
                "overdispersion":disp})
        except Exception as e:
            log(f"    Failed {path}/{y}: {e}")

df_py = pd.DataFrame(per_year_results)
# BH within pathway across years
df_py["urban_p_bh"] = np.nan
for path in df_py.pathway.unique():
    mask = df_py.pathway==path
    df_py.loc[mask,"urban_p_bh"] = multipletests(df_py.loc[mask,"urban_p"], method="fdr_bh")[1]
log(df_py[["pathway","year","urban_beta","urban_se","urban_z","urban_p","urban_p_bh",
           "pseudoR2","AIC"]].round(4).to_string(index=False))
df_py.to_csv(f"{OUT}/glm_per_year.csv", index=False)

# ===============================================================
# (c'') Buffer-sensitivity: rerun per-year GLM at all 3 buffers
# ===============================================================
log("\n"+"="*72)
log("STEP (c''): Buffer sensitivity (re-do per-year GLM at each buffer)")
log("="*72)
buf_sens = []
for b in buffers:
    for path, nc in [("Gardening","n.gard"),("Unintentional","n.unint"),("AgriForest","n.agfo")]:
        for y in years:
            ucol = f"urban.{y}.{b}m"
            ccol = f"cropland.{y}.{b}m"
            # z-score urban and cropland
            df_glm[f"{ucol}_z"] = (df_glm[ucol] - df_glm[ucol].mean())/df_glm[ucol].std()
            df_glm[f"{ccol}_z"] = (df_glm[ccol] - df_glm[ccol].mean())/df_glm[ccol].std()
            pred_set = [f"{ucol}_z", f"{ccol}_z",
                        "elevation_z","annual.temperature_z","annual.rainfall_z",
                        "annual.radiation_z","log_dist_stream_z","log_dist_road_z"] + hab_dummies
            yvec = df_glm[nc].astype(int).values
            X = sm.add_constant(df_glm[pred_set].astype(float))
            try:
                mod = sm.GLM(yvec, X, family=sm.families.Poisson()).fit(maxiter=200)
                used="Poisson"; disp = mod.pearson_chi2/mod.df_resid
                if disp > 1.5:
                    try:
                        mod = sm.GLM(yvec, X, family=sm.families.NegativeBinomial(alpha=max(disp-1,0.1))).fit(maxiter=200)
                        used="NB"
                    except: pass
                buf_sens.append({"pathway":path,"buffer_m":b,"year":y,"model":used,
                                 "n":int(mod.nobs),
                                 "urban_beta":mod.params[f"{ucol}_z"],
                                 "urban_se":mod.bse[f"{ucol}_z"],
                                 "urban_z":mod.params[f"{ucol}_z"]/mod.bse[f"{ucol}_z"] if mod.bse[f"{ucol}_z"]>0 else np.nan,
                                 "urban_p":mod.pvalues[f"{ucol}_z"],
                                 "pseudoR2":1-mod.deviance/mod.null_deviance})
            except Exception as e:
                log(f"    Failed {path}/{y}/{b}: {e}")
df_bs = pd.DataFrame(buf_sens)
df_bs["urban_p_bh"] = np.nan
for (path, y) in df_bs.groupby(["pathway","year"]).groups.items():
    mask = (df_bs.pathway==path[0]) & (df_bs.year==path[1])
    df_bs.loc[mask,"urban_p_bh"] = multipletests(df_bs.loc[mask,"urban_p"],method="fdr_bh")[1]
log("  Buffer-sensitivity of urban β (Bh-adjusted across buffers):")
log(df_bs[["pathway","buffer_m","year","urban_beta","urban_p","urban_p_bh","pseudoR2"]]
    .round(4).to_string(index=False))
df_bs.to_csv(f"{OUT}/glm_buffer_sensitivity.csv", index=False)

# ===============================================================
# (d) Composition: ALR on (n.gard, n.unint, n.agfo) per plot
# ===============================================================
log("\n"+"="*72); log("STEP (d): Pathway composition: ALR transform + LM"); log("="*72)

# ALR with den = n.unint (reference):  log(n.gard/n.unint), log(n.agfo/n.unint)
df_niche2 = df_niche.copy()
df_niche2["alr_gard"] = np.log(np.maximum(df_niche2["n.gard"],1) / np.maximum(df_niche2["n.unint"],1))
df_niche2["alr_agfo"] = np.log(np.maximum(df_niche2["n.agfo"],1) / np.maximum(df_niche2["n.unint"],1))
# Z-score predictors
df_niche2["ur09_z"] = (df_niche2[f"urban.2009.500m"] - df_niche2[f"urban.2009.500m"].mean())/df_niche2[f"urban.2009.500m"].std()
df_niche2["ur93_z"] = (df_niche2[f"urban.1993.500m"] - df_niche2[f"urban.1993.500m"].mean())/df_niche2[f"urban.1993.500m"].std()
df_niche2["ur56_z"] = (df_niche2[f"urban.1956.500m"] - df_niche2[f"urban.1956.500m"].mean())/df_niche2[f"urban.1956.500m"].std()

alr_results = []
for resp in ["alr_gard","alr_agfo"]:
    pred = ["ur09_z","ur93_z","ur56_z",
            "elevation","annual.temperature","annual.rainfall","annual.radiation",
            "distance.stream","distance.road"]
    # Standardise non-urban
    for c in pred:
        if c not in ("ur09_z","ur93_z","ur56_z"):
            df_niche2[f"{c}_z"] = (df_niche2[c]-df_niche2[c].mean())/df_niche2[c].std()
    ps = [p if p.endswith("_z") else f"{p}_z" for p in pred]
    # filter to rows where dn.unint > 0 to avoid infinite ratios (we used max(.,1) which makes ratio = n.gard for unint=0)
    # Drop rows where all three are zero for cleaner ALR interpretation: handled via max(.,1) trick
    yvec = df_niche2[resp].values
