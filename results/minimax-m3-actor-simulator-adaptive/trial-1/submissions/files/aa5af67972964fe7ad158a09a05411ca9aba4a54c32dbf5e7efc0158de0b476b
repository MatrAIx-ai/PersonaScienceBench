def reml_loglik(y, V, X=None):
    """REML log-likelihood of y under MVN with cov σ²*V.
       Returns (loglik, sigma2_hat)."""
    n = len(y)
    if X is None:
        X = np.ones((n,1))
    k = X.shape[1]
    V_inv = np.linalg.pinv(V, rcond=1e-10)
    XtVinvX = X.T @ V_inv @ X
    XtVinvy = X.T @ V_inv @ y
    try:
        beta = np.linalg.solve(XtVinvX, XtVinvy)
    except np.linalg.LinAlgError:
        return -1e10, 1.0
    resid = y - X @ beta
    quad = resid.T @ V_inv @ resid
    # Variance components
    sigma2 = quad / (n - k)
    # REML log-likelihood (concentrated)
    sign, logdet = np.linalg.slogdet(V)
    if sign <= 0: return -1e10, sigma2
    # log-likelihood (full): -n/2 log(2π) - 0.5 log|V| - n/2 log(sigma2) - 0.5 * resid'V^{-1}resid / sigma2
    ll = -n/2 * np.log(2*np.pi) - 0.5*logdet - (n/2)*np.log(sigma2) - 0.5*(quad/sigma2)
    return ll, sigma2

def pagel_loglik(lam, y, V_unscaled, X=None):
    """Pagel's λ log-likelihood: V_λ[j,k] = V[j,k]^λ for off-diagonals; diagonal unchanged."""
    V = V_unscaled.copy()
    # Standardise so root-to-tip mean = 1 first (Pagel-style)
    d = np.sqrt(np.diag(V))
    V = V / np.sqrt(np.outer(d,d))  # correlation matrix
    np.fill_diagonal(V, 1.0)
    # Apply λ transformation
    V_lam = V.copy()
    mask = ~np.eye(V.shape[0], dtype=bool)
    # Off-diagonal: ρ^λ (where ρ is correlation)
    V_lam[mask] = np.sign(V[mask]) * np.abs(V[mask])**lam
    # rescale to original variance
    V_lam = V_lam * np.outer(d, d)
    np.fill_diagonal(V_lam, d**2)
    return reml_loglik(y, V_lam, X)[0]

