   "source": [
    "## Bootstrap 95% CIs (B=1,000, percentile method)"
   ]
  },
  {
   "cell_type": "code",
   "metadata": {},
   "execution_count": 4,
   "source": [
    "boot = {}\n",
    "for sex in ['female','male']:\n",
    "    for year in [1990,1996]:\n",
    "        col = f'composite_wealth_{year}'\n",
    "        x = white.loc[white.sex==sex, col].to_numpy()\n",
