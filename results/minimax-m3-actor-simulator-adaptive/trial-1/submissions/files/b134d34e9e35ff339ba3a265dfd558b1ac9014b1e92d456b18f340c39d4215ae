"""Result-stage analysis: plurality ranking + bootstrap 95% CIs for Q9 elicitation.

Reproduces: %quoted for each of the 5 core elicitation techniques at three
denominators (n=188 / n=164 / n=194), plus nonparametric bootstrap (B=10000,
percentile method, fixed seed) of the Interviews %quoted.

Run: python3 artifacts/result_analysis.py
"""
import numpy as np
import pandas as pd

RNG_SEED = 20261021
B = 10_000
ALPHA = 0.05

df = pd.read_csv("data/requirements_engineering_for_ML-enabled_systems.csv")

TECHNIQUES = [
    ("Interviews", "Q9_ML_Elicitation_Interviews"),
    ("Scenarios", "Q9_ML_Elicitation_Scenarios"),
    ("Prototyping", "Q9_ML_Elicitation_Prototyping"),
    ("Workshops_Meetings", "Q9_ML_Elicitation_Workshops_Meetings"),
    ("Observation", "Q9_ML_Elicitation_Observation"),
]

def pct_quoted(series):
    s = series[series != "-77"]
    n = len(s)
    q = int((s == "quoted").sum())
    return q, n, 100.0 * q / n if n else float("nan")

def bootstrap_ci(indicator, B=B, alpha=ALPHA, seed=RNG_SEED):
    """Nonparametric percentile bootstrap CI for proportion of 1s.
    indicator is a 1-D numpy array of {0,1}."""
    rng = np.random.default_rng(seed)
    n = len(indicator)
    x = indicator.astype(np.float64)
    boot = rng.choice(x, size=(B, n), replace=True).mean(axis=1)
    lo, hi = np.percentile(boot, [100 * alpha / 2, 100 * (1 - alpha / 2)])
    point = x.mean()
    return point, lo, hi, boot

denoms = {
    "n=188 Status filter (Completedgroups)": df["Status"].isin(["Completed (31)", "Completed after break (32)"]),
    "n=164 Completed (31) only": df["Status"] == "Completed (31)",
    "n=194 drop -77 only": df["Q9_ML_Elicitation_Interviews"] != "-77",
}

print("=" * 72)
print("DATA-SUPPORTED PROPORTIONS OF RESPONDENTS USING EACH TECHNIQUE")
print("=" * 72)
summary_rows = []
for label, mask in denoms.items():
    sub = df[mask]
    print(f"\n[{label}]  N={len(sub)}")
    for name, col in TECHNIQUES:
        q, n, p = pct_quoted(sub[col])
        print(f"  {name:18s}  quoted={q:3d}/{n:3d} = {p:7.3f}%")
        summary_rows.append({"denom": label, "n": n, "technique": name,
                             "quoted": q, "pct": p})

print("\n" + "=" * 72)
print("BOOTSTRAP 95% CI FOR INTERVIEWS %quoted  (B=10,000, percentile, seed-fixed)")
print("=" * 72)
boot_rows = []
for label, mask in denoms.items():
    sub = df[mask]
    ind = (sub["Q9_ML_Elicitation_Interviews"] == "quoted").to_numpy().astype(np.int8)
    point, lo, hi, _ = bootstrap_ci(ind, B=B, alpha=ALPHA, seed=RNG_SEED)
    print(f"[{label}]  N={len(sub)}")
    print(f"   point(%)    : {100*point:7.3f}")
    print(f"   95% CI  (%) : [{100*lo:7.3f}, {100*hi:7.3f}]   width = {100*(hi-lo):.3f} pp")
    boot_rows.append({"denom": label, "N": len(sub),
                      "point_pct": 100*point, "ci_lo_pct": 100*lo, "ci_hi_pct": 100*hi})

# gap to runner-up
print("\n" + "=" * 72)
print("LEAD (Interviews minus next-most-used technique)")
print("=" * 72)
for label, mask in denoms.items():
    sub = df[mask]
    pct = {n: pct_quoted(sub[c])[2] for n, c in TECHNIQUES}
    sorted_p = sorted(pct.values(), reverse=True)
    lead = sorted_p[0] - sorted_p[1]
    leader = [n for n, p in pct.items() if p == sorted_p[0]][0]
    runner = [n for n, p in pct.items() if p == sorted_p[1]][0]
    print(f"[{label}]  Leader={leader} ({sorted_p[0]:.3f}%),  #2={runner} ({sorted_p[1]:.3f}%), gap={lead:.3f} pp")

# write summary CSV
pd.DataFrame(summary_rows).to_csv("artifacts/bootstrap_summary.csv", index=False)

import json
with open("artifacts/bootstrap_ci.json", "w") as f:
    json.dump(boot_rows, f, indent=2)
print("\nWrote artifacts/bootstrap_summary.csv and artifacts/bootstrap_ci.json")
