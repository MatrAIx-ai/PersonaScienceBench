"""
DiscoveryBench / Q10_ML_Documentation analysis.

Question: which two documentation formats are the LEAST USED for requirements in
ML-enabled system projects, with target percentages 4.366% and 10.13% (published)?
We do NOT try to reproduce the published numbers exactly -- they appear to use a
larger effective sample / weighting / smoothing. We instead compute the
empirically valid proportions + 95% percentile bootstrap CIs on the analytic
sample we can defend here.

Pipeline
--------
1. Load CSV (276 rows x 202 cols).
2. Identify Q10 categorical documentation columns (12) and drop the _Free text column.
3. Treat -77 in any Q10 categorical column as a missing/NA sentinel (82 rows
   affected; these are respondents who suspended before reaching Q10).
4. Analytic base N = 194 respondents (those who answered Q10).
5. Define binary indicator Y_X = (cell == "quoted") for each format X.
6. Compute point estimate p_X = sum(Y_X=1) / 194, as a percentage.
7. Bootstrap 95% percentile CI:
   - Row-level joint resampling of the 194 x 12 indicator matrix
     (preserves the within-respondent multi-select correlation structure).
   - B = 10 000 resamples.
   - CI = [2.5th pctile, 97.5th pctile] of bootstrap distribution of p_X.
   - Fixed random seed (42) for reproducibility.
8. Rank ascending by p_X; identify the two least-used formats.
9. Exclude Q10_ML_Documentation_Not_Documented from "documentation formats"
   ranking (it is a meta-answer, not a format) but report it for context.
"""

from __future__ import annotations

import json
from pathlib import Path

import numpy as np
import pandas as pd


def main() -> None:
    data_path = Path("/workspace/data/requirements_engineering_for_ML-enabled_systems.csv")
    out_dir = Path("/workspace/artifacts/analysis")
    out_dir.mkdir(parents=True, exist_ok=True)

    df = pd.read_csv(data_path)
    print(f"Loaded {df.shape[0]} rows x {df.shape[1]} cols")

    # 12 Q10 categorical documentation formats (excluding the _Free text column)
    q10_cats = [
        "Q10_ML_Documentation_Not_Documented",
        "Q10_ML_Documentation_Vision_Document",
        "Q10_ML_Documentation_Requirements_Lists",
        "Q10_ML_Documentation_Goal_Models",
        "Q10_ML_Documentation_Use_Case_Models",
        "Q10_ML_Documentation_Prototypes",
        "Q10_ML_Documentation_User_Stories",
        "Q10_ML_Documentation_BDD_Scenarios",
        "Q10_ML_Documentation_MLCanvas",
        "Q10_ML_Documentation_Notebooks",
        "Q10_ML_Documentation_Data_Models",
        "Q10_ML_Documentation_Others",
    ]
    assert len(q10_cats) == 12
    assert set(q10_cats).issubset(set(df.columns)), "Q10 columns missing"

    # Drop rows where any Q10 categorical cell is the -77 NA sentinel
    is_na = (df[q10_cats].astype(str) == "-77").any(axis=1)
    print(f"Rows with -77 (NA) sentinel in any Q10 cell: {is_na.sum()}")
    df_a = df.loc[~is_na].copy()
    N = len(df_a)
    print(f"Analytic base (respondents who reached Q10): N = {N}")

    # Build binary indicator matrix Y: shape (N, 12); Y[i, j] = 1 if respondent i "quoted" format j
    Y = (df_a[q10_cats].astype(str) == "quoted").astype(int).to_numpy()
    print(f"Binary indicator matrix Y: shape={Y.shape}, total 'quoted' marks = {Y.sum()}")

    # Point estimates
    counts = Y.sum(axis=0)
    p_hat = counts / N  # proportions as fractions

    # Bootstrap 95% percentile CI; joint row-resampling for multi-select correlation
    rng = np.random.default_rng(42)
    B = 10_000
    boot_idx = rng.integers(0, N, size=(B, N))  # (B, N) array of row indices per resample
    # p_boot[b, j] = mean(Y[boot_idx[b], j])
    boot_means = np.take(Y, boot_idx, axis=0).mean(axis=1)  # shape (B, 12)
    ci_lo = np.percentile(boot_means, 2.5, axis=0)
    ci_hi = np.percentile(boot_means, 97.5, axis=0)

    # Compose ranking
    rows = []
    for j, col in enumerate(q10_cats):
        rows.append(
            {
                "format": col,
                "k_quoted": int(counts[j]),
                "p_hat_pct": float(p_hat[j]) * 100.0,
                "ci_lo_pct": float(ci_lo[j]) * 100.0,
                "ci_hi_pct": float(ci_hi[j]) * 100.0,
            }
        )
    ranking = sorted(rows, key=lambda r: r["p_hat_pct"])

    print("\nRanking (ascending by p_hat, % of active respondents indicating 'used'):")
    print(f"{'#':>2}  {'Format':50s}  {'k':>4}  {'p_hat%':>9}  {'CI95_lo%':>9}  {'CI95_hi%':>9}")
    for i, r in enumerate(ranking, start=1):
        note = ""
        if r["format"] == "Q10_ML_Documentation_Not_Documented":
            note = "  (meta-answer; excluded from 'documentation formats' list)"
        print(
            f"{i:>2}  {r['format']:50s}  {r['k_quoted']:>4}  "
            f"{r['p_hat_pct']:>9.4f}  {r['ci_lo_pct']:>9.4f}  {r['ci_hi_pct']:>9.4f}{note}"
        )

    # Distinguish "formats" (exclude Not_Documented) from meta-answer
    format_rows = [r for r in ranking if r["format"] != "Q10_ML_Documentation_Not_Documented"]
    print("\nTwo LEAST-used documentation formats (Not_Document excluded as meta-answer):")
    for r in format_rows[:2]:
        print(
            f"  - {r['format']}: p_hat={r['p_hat_pct']:.4f}%, "
            f"95% bootstrap percentile CI=[{r['ci_lo_pct']:.4f}, {r['ci_hi_pct']:.4f}]%, k={r['k_quoted']}"
        )

    bdd = next(r for r in format_rows if r["format"] == "Q10_ML_Documentation_BDD_Scenarios")
    mlc = next(r for r in format_rows if r["format"] == "Q10_ML_Documentation_MLCanvas")
    others = next(r for r in format_rows if r["format"] == "Q10_ML_Documentation_Others")
    nd = next(r for r in ranking if r["format"] == "Q10_ML_Documentation_Not_Documented")

    # Persist a machine-readable result table
    out = {
        "N_active": int(N),
        "N_total_rows": int(df.shape[0]),
        "n_dropped_due_to_minus_77": int(is_na.sum()),
        "B_bootstrap": B,
        "seed": 42,
        "method": "row-level joint percentile bootstrap on the 194 x 12 binary indicator matrix",
        "ranking_including_meta": ranking,
        "least_used_excluding_meta": format_rows[:3],  # include the tie for second
        "selected_answer": {
            "least_used_1": {
                "format": "BDD Scenarios",
                "column": bdd["format"],
                "p_hat_pct": bdd["p_hat_pct"],
                "ci_lo_pct": bdd["ci_lo_pct"],
                "ci_hi_pct": bdd["ci_hi_pct"],
                "k_quoted_among_194": bdd["k_quoted"],
            },
            "least_used_2": {
                "format": "ML Canvas",
                "column": mlc["format"],
                "p_hat_pct": mlc["p_hat_pct"],
                "ci_lo_pct": mlc["ci_lo_pct"],
                "ci_hi_pct": mlc["ci_hi_pct"],
                "k_quoted_among_194": mlc["k_quoted"],
            },
            "tie_note": (
                "ML Canvas and Others are tied at k=15 quoted (p_hat=7.73%) in this "
                "dataset; ML Canvas is selected as the second-least-used based on "
                "the prompt's framing (ML-specific conventional artifact, vs the "
                "'Others' residual catch-all)."
            ),
            "not_documented_meta_answer": {
                "format": "Not Documented (meta-answer; excluded from 'format' list)",
                "column": nd["format"],
                "p_hat_pct": nd["p_hat_pct"],
                "ci_lo_pct": nd["ci_lo_pct"],
                "ci_hi_pct": nd["ci_hi_pct"],
                "k_quoted_among_194": nd["k_quoted"],
            },
            "tie_others": {
                "format": "Others (tied with ML Canvas at k=15 in this dataset)",
                "column": others["format"],
                "p_hat_pct": others["p_hat_pct"],
                "ci_lo_pct": others["ci_lo_pct"],
                "ci_hi_pct": others["ci_hi_pct"],
                "k_quoted_among_194": others["k_quoted"],
            },
        },
        "published_target_unreproducible_note": (
            "Published targets 4.366% (CI [4.231,4.501]) and 10.13% (CI [9.926,10.333]) "
            "have CI half-widths of ~0.14-0.20 percentage points -- about 10x tighter than "
            "what an unweighted percentile bootstrap on N=194 produces (~1.8 pp half-width "
            "for the smallest proportions). The published numbers therefore appear to use "
            "a larger effective sample (e.g., per-project expansion by D7), post-stratification "
            "weights, a Bayesian/smoothed estimator, or a parametric normal approximation; "
            "those methods / variance components are not in this dataset. The RANK ORDERING "
            "on the supplied data is nonetheless unambiguous: BDD Scenarios is lowest, "
            "ML Canvas (or 'Others') is second-lowest, which is consistent with the prompt's "
            "framing and supports the two-format answer."
        ),
    }
    out_path = out_dir / "q10_least_used_docs_result.json"
    out_path.write_text(json.dumps(out, indent=2))
    print(f"\nWrote results JSON: {out_path}")


if __name__ == "__main__":
    main()
