"""
DiscoveryBench / archaeology / metadata_16.json
Question: How were the Middle Neolithic (3400-3000 BCE) and Younger Neolithic
(2900-2300 BCE) phases characterised by PC1 in a PCA on the forms of
capital in 100-year time slices?
"""
import os, json, sys
import numpy as np
import pandas as pd
from scipy import stats

def parse_num(s):
    if pd.isna(s): return np.nan
    if isinstance(s, (int, float)): return float(s)
    s = str(s).strip().replace(',', '.')
    if s == '' : return np.nan
    return float(s)

CAPITAL_COLS = ['ZAxtSchwert','ZDolch','Zhausgr','ZCU_AU','Zamber','ZMonument',
                'ZHort','ZSichel','ZBeil','ZMW','ZKeform','Zkeverz']
COL2CAT = {
    'ZAxtSchwert':'symbolic','ZDolch':'symbolic','Zhausgr':'symbolic',
    'ZCU_AU':'social','Zamber':'social','ZMonument':'social',
    'ZHort':'economic','ZSichel':'economic','ZBeil':'economic','ZMW':'economic',
    'ZKeform':'cultural','Zkeverz':'cultural'}

cap = pd.read_csv('data/capital.csv')
for col in cap.columns:
    if col not in ('BCE','group','color'):
        cap[col] = cap[col].apply(parse_num)
cap = cap.sort_values('BCE', ascending=False).reset_index(drop=True)
bce    = cap['BCE'].astype(int).values
groups = cap['group'].values

X_raw = cap[CAPITAL_COLS].values
mu    = X_raw.mean(0)
sd    = X_raw.std(0, ddof=1)
X_std = (X_raw - mu) / sd

C = np.corrcoef(X_std.T)
ev, evec = np.linalg.eigh(C)
order = np.argsort(ev)[::-1]
ev, evec = ev[order], evec[:, order]
explained = ev / ev.sum()
PC1_loadings = evec[:, 0].copy()
PC1_scores_full = X_std @ PC1_loadings

mean_z_slice = X_std.mean(axis=1)
c = float(np.corrcoef(PC1_scores_full, mean_z_slice)[0, 1])
ori_rule = "PC1 aligned to cross-sectional mean (positive=integrated intensification)"
if c < 0:
    PC1_loadings = -PC1_loadings
    PC1_scores_full = -PC1_scores_full
    c = -float(c)
    ori_rule += "; flipped"

def phase_stats(scores, bce, bce_window, mask_groups):
    mask = mask_groups
    s  = scores[mask]
    bb = bce[mask]
    g  = groups[mask]
    mean_s = float(s.mean())
    std_s  = float(s.std(ddof=1))
    lr = stats.linregress(bb, s)
    slope_per_BCE = float(lr.slope)
    slope_per_100yr_forward = -100.0 * slope_per_BCE
    p = float(lr.pvalue)
    r2 = float(lr.rvalue**2)
    return dict(phase=g[0], BCE=f"{bce_window[0]}-{bce_window[1]}",
                n=int(mask.sum()), scores=s, BCE_arr=bb, groups=g,
                mean_PC1=mean_s, std_PC1=std_s,
                raw_slope_per_BCE=slope_per_BCE,
                slope_per_100yr_forward=slope_per_100yr_forward,
                p_value_trend=p, r2_trend=r2)

mn_mask = (bce >= 3000) & (bce <= 3400)
sg_mask = (bce >= 2300) & (bce <= 2900)
MN = phase_stats(PC1_scores_full, bce, (3400, 3000), mn_mask)
SG = phase_stats(PC1_scores_full, bce, (2900, 2300), sg_mask)

t_w, p_w  = stats.ttest_ind(SG['scores'], MN['scores'], equal_var=False)
u_mw, p_mw = stats.mannwhitneyu(SG['scores'], MN['scores'], alternative='two-sided')

# Truncated window sensitivity: re-standardize and re-PCA on 3400..2300
mask_trunc = (bce >= 2300) & (bce <= 3400)
X_trunc = cap.loc[mask_trunc, CAPITAL_COLS].values
mu2, sd2 = X_trunc.mean(0), X_trunc.std(0, ddof=1)
Z_trunc = (X_trunc - mu2) / sd2
C2 = np.corrcoef(Z_trunc.T)
ev2, evec2 = np.linalg.eigh(C2)
order2 = np.argsort(ev2)[::-1]
ev2, evec2 = ev2[order2], evec2[:, order2]
PC1_loadings_trunc = evec2[:, 0].copy()
PC1_scores_trunc_raw = Z_trunc @ PC1_loadings_trunc
mean_z_trunc = Z_trunc.mean(axis=1)
c2 = float(np.corrcoef(PC1_scores_trunc_raw, mean_z_trunc)[0, 1])
if c2 < 0:
    PC1_loadings_trunc *= -1
    PC1_scores_trunc_raw *= -1
    c2 = -float(c2)

sign_match = {col: int(np.sign(PC1_loadings[i]) == np.sign(PC1_loadings_trunc[i]))
              for i, col in enumerate(CAPITAL_COLS)}
sp_cor, _ = stats.spearmanr(np.abs(PC1_loadings), np.abs(PC1_loadings_trunc))
s_f_trunc = stats.zscore(PC1_scores_full[mask_trunc])
s_t_trunc = stats.zscore(PC1_scores_trunc_raw)
sign_cross = float(np.sign(np.corrcoef(s_f_trunc, s_t_trunc)[0,1] + 1e-12))

bce_trunc = bce[mask_trunc]
mn_t_scores = PC1_scores_trunc_raw[(bce_trunc >= 3000) & (bce_trunc <= 3400)]
sg_t_scores = PC1_scores_trunc_raw[(bce_trunc >= 2300) & (bce_trunc <= 2900)]
diff_sign_change = bool(np.sign(sg_t_scores.mean() - mn_t_scores.mean()) !=
                         np.sign(SG['mean_PC1'] - MN['mean_PC1']))

# Pollen overlays
ts = pd.read_csv('data/time_series_data.csv')
pl = pd.read_csv('data/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv').rename(columns={'Unnamed: 0':'idx'})
for col in pl.columns:
    if col not in ('idx','calBP','CE'):
        pl[col] = pl[col].apply(parse_num)
ts_idx = ts.set_index('CE')
pl_idx = pl.set_index('CE')

pollen_open_raw  = np.array([ts_idx.at[-b,'pollen_inter_100']  if -b in ts_idx.index else np.nan for b in bce])
pollen_rate_raw  = np.array([ts_idx.at[-b,'pollen_grate_100']  if -b in ts_idx.index else np.nan for b in bce])
belau_open_raw   = np.array([pl_idx.at[-b,'SMOOTH_MEAN_100y']  if -b in pl_idx.index else np.nan for b in bce])

def safe_corr(a, b):
    mask = ~np.isnan(a) & ~np.isnan(b)
    if mask.sum() < 3: return (np.nan, np.nan, int(mask.sum()))
    r, p = stats.pearsonr(a[mask], b[mask])
    return (float(r), float(p), int(mask.sum()))

c_open, p_open, n_open = safe_corr(PC1_scores_full, pollen_open_raw)
c_rate, p_rate, n_rate = safe_corr(PC1_scores_full, pollen_rate_raw)
c_belau, p_belau, n_belau = safe_corr(PC1_scores_full, belau_open_raw)

def mask_corr(scores, y, mask):
    return safe_corr(scores[mask], y[mask])
mn_open_corr = mask_corr(PC1_scores_full, pollen_open_raw, mn_mask)
sg_open_corr = mask_corr(PC1_scores_full, pollen_open_raw, sg_mask)
mn_belau_corr = mask_corr(PC1_scores_full, belau_open_raw, mn_mask)
sg_belau_corr = mask_corr(PC1_scores_full, belau_open_raw, sg_mask)

# Print summary
print("\n=== GLOBAL PCA (full window 4300..500 BCE) ===")
print(f"Eigenvalues: {[round(x,3) for x in ev]}")
print(f"Explained variance: {[round(x,3) for x in explained]}")
print(f"Rule: {ori_rule}; |corr(PC1, mean Z)| = {float(c):.4f}")

df_load_full = pd.DataFrame({
    'variable': CAPITAL_COLS,
    'bourdieu': [COL2CAT[c] for c in CAPITAL_COLS],
    'PC1_loading_full': PC1_loadings,
    'PC1_loading_truncated': PC1_loadings_trunc,
    'sign_match': list(sign_match.values()),
})
mask_mn_sg = (bce >= 2300) & (bce <= 3400)
df_load_full['raw_mean_window_3400_2300'] = [float(X_raw[mask_mn_sg, CAPITAL_COLS.index(col)].mean()) for col in CAPITAL_COLS]
df_load_full = df_load_full.sort_values('PC1_loading_full', key=lambda s: s.abs(), ascending=False)
with pd.option_context('display.float_format','{:.4f}'.format,'display.width',200):
    print(df_load_full.to_string(index=False))

print("\n=== PHASE STATS ===")
for ph in [MN, SG]:
    print(f"  {ph['phase']} (BCE {ph['BCE']}): n={ph['n']}, "
          f"mean PC1={ph['mean_PC1']:+.3f} (SD {ph['std_PC1']:.3f}); "
          f"slope/100yr_forward={ph['slope_per_100yr_forward']:+.3f} "
          f"(raw slope/BCE={ph['raw_slope_per_BCE']:+.4f}, p={ph['p_value_trend']:.3f}, R^2={ph['r2_trend']:.3f})")
diff_full = SG['mean_PC1']-MN['mean_PC1']
diff_trunc = sg_t_scores.mean()-mn_t_scores.mean()
print(f"  SG mean - MN mean (full) = {diff_full:+.3f}; Welch t={t_w:+.3f}, p={p_w:.4f}; MW U={u_mw}, p={p_mw:.4f}")
print(f"  SG mean - MN mean (truncated 3400-2300) = {diff_trunc:+.3f}; sign changed = {diff_sign_change}")

print("\n=== POLLEN OVERLAY ===")
print(f"r(PC1, pollen_inter_100)   = {c_open:+.3f} (p={p_open:.3f}, n={n_open})")
print(f"r(PC1, pollen_grate_100)   = {c_rate:+.3f} (p={p_rate:.3f}, n={n_rate})")
print(f"r(PC1, Belau SMOOTH_100y)  = {c_belau:+.3f} (p={p_belau:.3f}, n={n_belau})")
print(f"r PC1 vs pollen_inter_100 within MN = {mn_open_corr[0]:+.3f} (n={mn_open_corr[2]}); within SG = {sg_open_corr[0]:+.3f} (n={sg_open_corr[2]})")
print(f"r PC1 vs Belau SMOOTH_100y within MN = {mn_belau_corr[0]:+.3f} (n={mn_belau_corr[2]}); within SG = {sg_belau_corr[0]:+.3f} (n={sg_belau_corr[2]})")

print("\n=== NEAR-CONSTANT VARIABLES ===")
print(f"ZSichel unique values in MN: {sorted(cap.loc[mn_mask,'ZSichel'].unique().tolist())}")
print(f"ZDolch  unique values in SG: {sorted(cap.loc[sg_mask,'ZDolch'].unique().tolist())}")
print(f"ZSichel unique values in SG: {sorted(cap.loc[sg_mask,'ZSichel'].unique().tolist())}")

# Save artifacts
metrics = {
    'orientation_rule': ori_rule,
    'PC1_explained_var_full': float(explained[0]),
    'PC1_explained_var_truncated_3400_2300': float(ev2[0]/ev2.sum()),
    'loadings_PC1_full': {c: float(v) for c, v in zip(CAPITAL_COLS, PC1_loadings)},
    'loadings_PC1_truncated': {c: float(v) for c, v in zip(CAPITAL_COLS, PC1_loadings_trunc)},
    'loadings_sign_match_full_vs_truncated': sign_match,
    'MN': {k: MN[k] for k in MN if not isinstance(MN[k], np.ndarray)},
    'SG': {k: SG[k] for k in SG if not isinstance(SG[k], np.ndarray)},
    'phase_diff': {
        'SG_mean_minus_MN_mean_full': float(diff_full),
        'Welch_t': float(t_w), 'p_Welch': float(p_w),
        'MannWhitney_U': float(u_mw), 'p_MW': float(p_mw),
        'SG_mean_minus_MN_mean_truncated': float(diff_trunc),
        'sign_changed_by_truncation': diff_sign_change,
    },
    'pollen_overlay': {
        'corr_PC1_pollen_inter_100': c_open, 'p_pollen_inter_100': p_open, 'n_pollen_inter_100': n_open,
        'corr_PC1_pollen_grate_100': c_rate, 'p_pollen_grate_100': p_rate, 'n_pollen_grate_100': n_rate,
        'corr_PC1_Belau_SMOOTH_100y': c_belau, 'p_Belau_SMOOTH_100y': p_belau, 'n_Belau_SMOOTH_100y': n_belau,
        'corr_PC1_openness_MN_only': mn_open_corr[0], 'corr_PC1_openness_SG_only': sg_open_corr[0],
        'corr_PC1_Belau_MN_only': mn_belau_corr[0], 'corr_PC1_Belau_SG_only': sg_belau_corr[0],
    },
    'transition_gap_3000_2900': 'no slice in capital.csv; transition zone (Brasskamp/Endneolithikum) is not represented in the PCA'
}
with open('artifacts/pca_metrics.json','w') as f:
    json.dump(metrics, f, indent=2, default=str)

df_phase = pd.DataFrame({
    'BCE': bce, 'group': groups,
    'PC1_score': PC1_scores_full,
    'Belau_SMOOTH_100y': belau_open_raw,
    'pollen_inter_100': pollen_open_raw,
    'pollen_grate_100': pollen_rate_raw,
})
df_phase.to_csv('artifacts/per_slice_PC1.csv', index=False)
df_load_full.to_csv('artifacts/loadings.csv', index=False)
print("\nWrote: artifacts/pca_metrics.json, artifacts/per_slice_PC1.csv, artifacts/loadings.csv")
