"""Remediated fits: address the ρ=0.93 multicollinearity between urban_level_500
and urban_change_500 in the original specification, and the complete-separation
issues for n.unint and n.agfo where some habitats have zero events.

Strategy:
  * Orth-version: regress urban_change_500 on urban_level_500, take residuals.
    Fit:  y ~ urban_level_500 * habitat + urban_change_500_resid * habitat
              + elevation + cropland + distance.road
  * Single-version (for habitats where the bivariate design is unidentifiable):
        y ~ urban_level_500 * habitat + elevation + cropland + distance.road
        y ~ urban_change_500 * habitat + elevation + cropland + distance.road
  * For n.unint and n.agfo we additionally drop zero-event habitats from the
    model (those reporting it as a limitation in the report).
"""
import warnings, json
warnings.filterwarnings("ignore")
import numpy as np
import pandas as pd
import statsmodels.api as sm
from patsy import dmatrices
from scipy import stats

df = pd.read_csv("data/invaded_niche_pathways.csv", sep="\t")
for buf in (50, 500, 1000):
    df[f"urban_change_{buf}"] = df[f"urban.2009.{buf}m"] - df[f"urban.1956.{buf}m"]
df["urban_level_500"] = df["urban.2009.500m"]

# ----- Orthogonalize urban_change w.r.t. urban_level -----
# Residualize at the *whole-dataset* level so that the two urban predictors are
# uncorrelated by construction. Coefficients then have a clean interpretation:
#   urban_level_500 : "current urban cover given its baseline"
#   urban_change_500r : "urban trajectory, holding current level constant"
for buf in (50, 500, 1000):
    lev = df[f"urban.2009.{buf}m"]
    chg = df[f"urban_change_{buf}"]
    # OLS: chg = a + b*lev + e
    b_lev = np.cov(chg, lev, ddof=1)[0,1] / np.var(lev, ddof=1)
    a_lev = chg.mean() - b_lev*lev.mean()
    df[f"urban_change_{buf}r"] = chg - (a_lev + b_lev*lev)

print("Orth-version Spearman ρ between urban_level_500 and urban_change_500r:")
print(f"  ρ = {df[['urban_level_500','urban_change_500r']].corr(method='spearman').iloc[0,1]:.4f}")

# Spearman ρ unchanged for non-orth versions, but we keep them anyway
df["urban_change_500r_lv"] = df["urban_change_500"]  # keep same name

# Define identification-friendly subset for n.unint and n.agfo (drop habitats
# with 0 events of that pathway)
def drop_zero_habitats(df_in, response):
    keep = df_in.groupby("habitat")[response].sum()
    keep = keep[keep > 0].index.tolist()
    return df_in[df_in["habitat"].isin(keep)].reset_index(drop=True)

df_u = drop_zero_habitats(df, "n.unint")
df_a = drop_zero_habitats(df, "n.agfo")
print("\nHabitats removed for n.unint fit:", sorted(set(df['habitat'])-set(df_u['habitat'])))
print("Habitats removed for n.agfo fit:  ", sorted(set(df['habitat'])-set(df_a['habitat'])))
print(f"  df_n.unint n={len(df_u)}  |  df_n.agfo n={len(df_a)}")


def fit_qp(df_in, response, change_var="urban_change_500"):
    """Clean fit: single urban-change predictor (or pre-residualized) × habitat
       plus urban_level_500 × habitat and confounders."""
    formula = (
        f"Q('{response}') ~ urban_level_500 * C(habitat, Treatment) + "
        f"{change_var} * C(habitat, Treatment) + "
        f"elevation + Q('cropland.2009.500m') + Q('distance.road')"
    )
    y, X = dmatrices(formula, data=df_in, return_type="dataframe")
    yv = y.values.ravel().astype(float)
    res = sm.GLM(yv, X.values, family=sm.families.Poisson()).fit(scale="X2")
    mu = res.predict(X.values)
    pears = ((yv - mu) ** 2 / mu).sum()
    disp = pears / res.df_resid
    return {"fit": res, "y": yv, "X": X, "mu": mu,
            "params_names": X.columns.tolist(),
            "response": response, "change_var": change_var,
            "n": int(res.nobs), "dfr": int(res.df_resid),
            "aic": res.aic, "dev": res.deviance,
            "pearson": pears, "disp": disp,
            "habitats_used": sorted(df_in["habitat"].unique().tolist())}


def per_habitat_marginal_clean(out, change_var):
    """With Treatment coding and reference = first alphabetical habitat."""
    names = out["params_names"]
    res = out["fit"]; b = res.params; V = res.cov_params()
    habitats = out["habitats_used"]
    ref = sorted(habitats)[0]
    rows = []
    for h in habitats:
        def eff(var_main):
            L = np.zeros(len(b))
            L[names.index(var_main)] = 1.0
            if h != ref:
                key = f"{var_main}:C(habitat, Treatment)[T.{h}]"
                if key in names:
                    L[names.index(key)] = 1.0
            e = L @ b
            s = np.sqrt(L @ V @ L)
            return e, s
        e1, s1 = eff("urban_level_500")
        e2, s2 = eff(change_var)
        rows.append({
            "habitat": h,
            "lev_b": e1, "lev_se": s1,
            "lev_z": e1/s1, "lev_p": 2*(1-stats.norm.cdf(abs(e1/s1))),
            "lev_lo": e1-1.96*s1, "lev_hi": e1+1.96*s1,
            "chg_b": e2, "chg_se": s2,
            "chg_z": e2/s2, "chg_p": 2*(1-stats.norm.cdf(abs(e2/s2))),
            "chg_lo": e2-1.96*s2, "chg_hi": e2+1.96*s2,
        })
    return pd.DataFrame(rows), ref


def coef_table(out):
    return pd.DataFrame({
        "coef": out["params_names"],
        "beta": out["fit"].params,
        "SE": out["fit"].bse,
        "z": out["fit"].tvalues,
        "p": out["fit"].pvalues,
    }).round(5)

# =========================================================================
# MAIN FITS (ORTH-version) — one urban predictor at a time using residuals
# =========================================================================
print("="*78); print("MAIN FITS — y ~ urban_level_500*habitat + urban_change_500r*habitat + ..."); print("="*78)

results = {}
for r, d in [("n.gard", df), ("n.unint", df_u), ("n.agfo", df_a), ("n.total", df)]:
    out = fit_qp(d, r, change_var="urban_change_500r")
    results[r] = out
    print(f"\n--- {r}  n={out['n']}  df_resid={out['dfr']}  "
          f"dispersion={out['disp']:.3f}  AIC={out['aic']:.2f}  "
          f"deviance={out['dev']:.3f}  habitats={out['habitats_used']}")
    ct = coef_table(out)
    keep = [n for n in ct["coef"] if (
        n.startswith("urban_level_500") or n.startswith("urban_change_500r")
        or n in ("elevation","Q('cropland.2009.500m')","Q('distance.road')","Intercept")
    )]
    print(ct[ct["coef"].isin(keep)].round(4).to_string(index=False))

print("\n" + "="*78)
print("PER-HABITAT MARGINAL EFFECTS (treatment reference = first alphabetical habitat)")
print("="*78)
marg = {}
for r in ["n.gard","n.unint","n.agfo","n.total"]:
    m, ref = per_habitat_marginal_clean(results[r], "urban_change_500r")
    marg[r] = (m, ref)
    print(f"\n--- {r}  ref='{ref}'")
    cols = ["habitat","lev_b","lev_lo","lev_hi","lev_p","chg_b","chg_lo","chg_hi","chg_p"]
    print(m[cols].round(4).to_string(index=False))
    top = m.sort_values("lev_b", ascending=False).head(3)
    print(f"  > TOP 3 habitats by lev_b:\n"
          + top[["habitat","lev_b","lev_p","chg_b","chg_p"]].round(4).to_string(index=False))

# Identify leading habitat
lead_g = marg["n.gard"][0].sort_values("lev_b", ascending=False).iloc[0]
lead_u = marg["n.unint"][0].sort_values("lev_b", ascending=False).iloc[0]
print(f"\nGardening leading habitat (orth-version): {lead_g['habitat']} "
      f"(beta={lead_g['lev_b']:.3f}, p={lead_g['lev_p']:.4f})")
print(f"Unintentional leading habitat: {lead_u['habitat']} "
      f"(beta={lead_u['lev_b']:.3f}, p={lead_u['lev_p']:.4f})")

# =========================================================================
# ROBUSTNESS
# =========================================================================
print("\n" + "="*78); print("ROBUSTNESS"); print("="*78)
print("(d1) Re-fit n.gard with urban_change_50r and urban_change_1000r (orth-version):")
rob = {}
for label, chg in [("chg50r","urban_change_50r"), ("chg1000r","urban_change_1000r")]:
    out = fit_qp(df, "n.gard", change_var=chg)
    m, ref = per_habitat_marginal_clean(out, chg)
    top = m.sort_values("lev_b", ascending=False).iloc[0]
    rob[label] = (top["habitat"], float(top["lev_b"]), float(top["lev_p"]),
                  float(top["chg_b"]), float(top["chg_p"]),
                  float(out["disp"]), float(out["aic"]), ref,
                  m.round(5))
    print(f"\n  n.gard refit with {chg}  disp={out['disp']:.3f}  AIC={out['aic']:.2f}  ref='{ref}'")
    cols = ["habitat","lev_b","lev_lo","lev_hi","lev_p","chg_b","chg_lo","chg_hi","chg_p"]
    print("  " + m[cols].round(4).to_string(index=False).replace("\n","\n  "))
    print(f"  > Top: {top['habitat']}  (lev_b={top['lev_b']:.3f}, p={top['lev_p']:.4f})")

# (d2) Drop Urban
df_noU = df[df["habitat"] != "Urban"].reset_index(drop=True)
out_noU = fit_qp(df_noU, "n.gard", change_var="urban_change_500r")
m_noU, ref_noU = per_habitat_marginal_clean(out_noU, "urban_change_500r")
top_noU = m_noU.sort_values("lev_b", ascending=False).iloc[0]
print(f"\n(d2) n.gard refit dropping 'Urban' habitat  "
      f"n={out_noU['n']}  disp={out_noU['disp']:.3f}  AIC={out_noU['aic']:.2f}  ref='{ref_noU}'")
cols = ["habitat","lev_b","lev_lo","lev_hi","lev_p","chg_b","chg_lo","chg_hi","chg_p"]
print(m_noU[cols].round(4).to_string(index=False))
print(f"  > Top: {top_noU['habitat']}  (lev_b={top_noU['lev_b']:.3f}, p={top_noU['lev_p']:.4f})")

# =========================================================================
# (e) CELL-LEVEL TABLE — urban tertiles × leading habitats
# =========================================================================
print("\n" + "="*78); print("(e) CELL-LEVEL TABLE"); print("="*78)
cuts = df["urban_level_500"].quantile([0, 1/3, 2/3, 1]).values
print(f"Urban_level_500 cut-points: {cuts.round(4).tolist()}")
df["urban_tertile"] = pd.cut(df["urban_level_500"],
                              bins=[-0.001, cuts[1], cuts[2], 1.001],
                              labels=["low","mid","high"])

def celltab(hab):
    sub = df[df["habitat"]==hab]
    return (sub.groupby("urban_tertile", observed=False)
              .agg(n_plots=("n.gard","size"),
                   n_gard_sum=("n.gard","sum"),
                   n_unint_sum=("n.unint","sum"),
                   n_total_sum=("n.total","sum"),
                   n_gard_mean=("n.gard","mean"),
                   n_unint_mean=("n.unint","mean"),
                   n_agfo_mean=("n.agfo","mean"),
                   n_total_mean=("n.total","mean"),
                   n_gard_pres=("n.gard", lambda x: int((x>0).sum())),
                   n_unint_pres=("n.unint", lambda x: int((x>0).sum())),
                   urban_change_mean=("urban_change_500","mean"),
                   urban_2009_500_mean=("urban_level_500","mean"))
              .round(4))

for h in [lead_g["habitat"], lead_u["habitat"]]:
    print(f"\n--- habitat = {h}  ---")
    print(celltab(h).to_string())

# Save outputs
import os
for fn in ["marginal_n_gard","marginal_n_unint","marginal_n_total","marginal_n_agfo"]:
    if fn.split("_")[-1] in ("agfo","unint","gard","total"):
        r = "n." + fn.split("_")[-1]
        if r in marg:
            marg[r][0].round(5).to_csv(f"artifacts/{fn}.csv", index=False)
m_noU.round(5).to_csv("artifacts/marginal_n_gard_dropUrban.csv", index=False)

# Summary json
summary = {
    "main": {
        "n_gard_top_habitat": lead_g["habitat"],
        "n_gard_top_beta": float(lead_g["lev_b"]),
        "n_gard_top_p": float(lead_g["lev_p"]),
        "n_unint_top_habitat": lead_u["habitat"],
        "n_unint_top_beta": float(lead_u["lev_b"]),
        "n_unint_top_p": float(lead_u["lev_p"]),
    },
    "robustness": {
        "n_gard_chg50r": {"top": rob["chg50r"][0], "beta": rob["chg50r"][1],
                          "p": rob["chg50r"][2],
                          "chg_beta": rob["chg50r"][3], "chg_p": rob["chg50r"][4],
                          "disp": rob["chg50r"][5], "AIC": rob["chg50r"][6],
                          "ref": rob["chg50r"][7]},
        "n_gard_chg1000r": {"top": rob["chg1000r"][0], "beta": rob["chg1000r"][1],
                            "p": rob["chg1000r"][2],
                            "chg_beta": rob["chg1000r"][3], "chg_p": rob["chg1000r"][4],
                            "disp": rob["chg1000r"][5], "AIC": rob["chg1000r"][6],
                            "ref": rob["chg1000r"][7]},
        "n_gard_dropUrban": {
            "top": top_noU["habitat"],
            "beta": float(top_noU["lev_b"]), "p": float(top_noU["lev_p"]),
            "chg_beta": float(top_noU["chg_b"]), "chg_p": float(top_noU["chg_p"]),
            "disp": float(out_noU["disp"]), "AIC": float(out_noU["aic"]),
            "ref": ref_noU,
        },
    },
    "fit_diagnostics": {
        r: {"n": results[r]["n"], "disp": float(results[r]["disp"]),
            "AIC": float(results[r]["aic"]), "dev": float(results[r]["dev"]),
            "habitats": results[r]["habitats_used"]}
        for r in results
    }
}
with open("artifacts/_results_summary.json","w") as f:
    json.dump(summary, f, indent=2, default=str)
print("\nArtifacts saved:")
for fn in sorted(os.listdir("artifacts")):
    print(" ", fn)
