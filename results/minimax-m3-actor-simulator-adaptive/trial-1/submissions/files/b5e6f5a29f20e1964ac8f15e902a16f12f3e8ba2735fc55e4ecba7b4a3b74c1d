"""DiscoveryBench — pottery form/decoration opposite-trend century (BCE 4300 → 500)."""

import pandas as pd
import numpy as np
import json

# ───────── Load ─────────
cap = pd.read_csv('/workspace/data/capital.csv')
ts  = pd.read_csv('/workspace/data/time_series_data.csv')

def _num(x):
    if isinstance(x, str): return float(x.replace(',', '.'))
    return float(x)
for c in ['ZAxtSchwert','ZDolch','Zhausgr','ZCU_AU','Zamber','ZMonument',
          'ZHort','ZSichel','ZBeil','ZMW','ZKeform','Zkeverz']:
    cap[c] = cap[c].apply(_num)
cap = cap.drop(columns=['group','color'])

# ───────── 100-year Δz table ─────────
# Δz(BCE_t) = z(BCE_t) − z(BCE_{t+100}); old → new growth.

cap = cap.sort_values('BCE').reset_index(drop=True)            # BCE 500..4300
cap['z_form_prev']   = cap['ZKeform'].shift(-1)
cap['z_decor_prev']  = cap['Zkeverz'].shift(-1)
cap['dZ_form']       = cap['ZKeform'] - cap['z_form_prev']
cap['dZ_decor']      = cap['Zkeverz'] - cap['z_decor_prev']

EPS = 1e-6
cap['rel_dZ_form']  = np.where(np.abs(cap['z_form_prev'])>EPS,
                                cap['dZ_form']  / np.abs(cap['z_form_prev']), np.nan)
cap['rel_dZ_decor'] = np.where(np.abs(cap['z_decor_prev'])>EPS,
                                cap['dZ_decor'] / np.abs(cap['z_decor_prev']), np.nan)

# Exclude padding rows (BCE 4300, 4200): Δ = 0 by construction.
df = cap.loc[cap['BCE'] <= 4100, ['BCE','ZKeform','Zkeverz',
                                   'z_form_prev','z_decor_prev',
                                   'dZ_form','dZ_decor',
                                   'rel_dZ_form','rel_dZ_decor']].copy().reset_index(drop=True)
df['sign_form']       = np.sign(df['dZ_form'])
df['sign_decor']      = np.sign(df['dZ_decor'])
df['sign_form_prev']  = df['sign_form'].shift(-1)
df['sign_decor_prev'] = df['sign_decor'].shift(-1)

THRESHOLDS = [0.10, 0.20, 0.30, 0.50, 1.00]

def find_joint_abs(thr, continuity=True):
    cond = (df['dZ_form']  < -thr) & (df['dZ_decor'] >  thr)
    if continuity:
        cond = cond & (df['sign_form_prev']  < 0) & (df['sign_decor_prev'] > 0)
    return df.loc[cond, 'BCE'].astype(int).tolist()

def find_joint_rel(thr_rel, continuity=True):
    cond = (df['rel_dZ_form'] < -thr_rel) & (df['rel_dZ_decor'] >  thr_rel)
    cond = cond & df['rel_dZ_form'].notna() & df['rel_dZ_decor'].notna()
    if continuity:
        prev_form  = df['rel_dZ_form'].shift(-1)
        prev_decor = df['rel_dZ_decor'].shift(-1)
        cond = cond & (prev_form  < -thr_rel) & (prev_decor >  thr_rel)
        cond = cond & prev_form.notna() & prev_decor.notna()
    return df.loc[cond, 'BCE'].astype(int).tolist()

print('=== Threshold sweep on absolute Δz (z-units) ===')
print('Threshold | strict-earliest | strict-all       | loose-earliest | loose-all')
sweep = {}
for t in THRESHOLDS:
    s_strict = find_joint_abs(t, continuity=True)
    s_loose  = find_joint_abs(t, continuity=False)
    sweep[t] = {'strict_earliest': (s_strict[0] if s_strict else None),
                'strict_all':      s_strict,
                'loose_earliest':  (s_loose[0] if s_loose else None),
                'loose_latest':    (s_loose[-1] if s_loose else None),
                'loose_all':       s_loose}
    print(f'  {t:5.2f}   |   {(s_strict[0] if s_strict else "—"):>10} | {s_strict!s:<15} |   {(s_loose[0] if s_loose else "—"):>10} | {s_loose}')

print('\n=== Relative-growth sensitivity (Δz/|z_prev|) ===')
for tr in [0.30, 0.50, 1.00, 2.00]:
    s_strict = find_joint_rel(tr, continuity=True)
    s_loose  = find_joint_rel(tr, continuity=False)
    print(f' thr_rel={tr:.2f}  strict={s_strict}  loose={s_loose}')

# ───────── Diagnostic: detail table ─────────
print('\n=== Bins where form < 0 AND decor > 0 (raw sign, no threshold) ===')
df_disp = df[['BCE','ZKeform','Zkeverz','dZ_form','dZ_decor',
              'sign_form','sign_decor','sign_form_prev','sign_decor_prev',
              'rel_dZ_form','rel_dZ_decor']].copy()
df_disp['opp_loose'] = (df_disp['sign_form']<0) & (df_disp['sign_decor']>0)
# show only rows with explanatory value (anchor changes) — print all for completeness
with pd.option_context('display.width', 200, 'display.max_rows', 50):
    print(df_disp.to_string(index=False))

# ───────── Save diagnostics ─────────
df.to_csv('/workspace/artifacts/pottery_trend_diagnostics.csv', index=False)
print('\nSaved → /workspace/artifacts/pottery_trend_diagnostics.csv')

# ───────── Cross-validate against time_series_data Pottery*_inter ─────────
# At a BCE anchor year, time_series has CE = -BCE valid; older anchor needs
# CE = -(BCE+100); this is only valid for BCE ≤ 4000 because time_series
# stops at CE = -4100 (so BCE = 4100 -> older = -4200 not in time_series).
ts_form = dict(zip(ts['CE'], ts['PotteryForm_inter']))
ts_decor= dict(zip(ts['CE'], ts['PotteryDecoration_inter']))
disagreements = 0
checks = []
for _, r in df.iterrows():
    bce = int(r['BCE'])
    if bce == 4100:           # older anchor outside time_series range
        continue
    ce_now = -bce
    ce_old = -(bce + 100)
    ts_df = ts_form[ce_now]  - ts_form[ce_old]
    ts_dd = ts_decor[ce_now] - ts_decor[ce_old]
    cap_df = r['dZ_form']
    cap_dd = r['dZ_decor']
    agree = np.isclose(ts_df, cap_df, atol=1e-6) and np.isclose(ts_dd, cap_dd, atol=1e-6)
    if not agree: disagreements += 1
    checks.append((bce, cap_df, ts_df, cap_dd, ts_dd, agree))
print(f'\n=== Cross-validation at century anchors (Pottery*_inter vs capital.csv) ===')
print(f' {"BCE":>5} {"cap_ΔForm":>10} {"ts_ΔForm":>10} {"cap_ΔDecor":>11} {"ts_ΔDecor":>11} {"agree":>6}')
for c in checks:
    print(f' {c[0]:5d} {c[1]:10.4f} {c[2]:10.4f} {c[3]:11.4f} {c[4]:11.4f} {str(c[5]):>6}')
print(f'\nTotal disagreements: {disagreements} / {len(checks)}')

# ───────── Saved JSON sweep ─────────
with open('/workspace/artifacts/sweep.json','w') as f:
    json.dump({
        'thresholds': THRESHOLDS,
        'sweep_abs': {str(k): v for k,v in sweep.items()},
        'crossval_disagreements': disagreements,
        'crossval_checks':        len(checks),
    }, f, indent=2)
print('Saved → /workspace/artifacts/sweep.json')
