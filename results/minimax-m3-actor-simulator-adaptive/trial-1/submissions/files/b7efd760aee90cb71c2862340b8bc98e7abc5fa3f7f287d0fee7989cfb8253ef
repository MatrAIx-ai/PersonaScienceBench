"""PCA on the 12 forms-of-capital Z columns from data/capital.csv.

Approved approach (option b): global PCA on the full 39x12 Z matrix.
PC1 sign anchored so loading on ZMonument is positive.
Time_series_data and pollen_openness files are out of scope.
"""
from __future__ import annotations

from pathlib import Path
import io
import re
import numpy as np
import pandas as pd

DATA = Path("/workspace/data")
OUT = Path("/workspace/analysis")
OUT.mkdir(parents=True, exist_ok=True)

# Domain knowledge (archaeology.domain_knowledge.1, approved)
DOMAIN_MAP = {
    "ZAxtSchwert": "Symbolic",
    "ZDolch":      "Symbolic",
    "Zhausgr":     "Symbolic",
    "ZCU_AU":      "Social",
    "Zamber":      "Social",
    "ZMonument":   "Social",
    "ZKeform":     "Cultural",
    "Zkeverz":     "Cultural",
    "ZHort":       "Economic",
    "ZSichel":     "Economic",
    "ZBeil":       "Economic",
    "ZMW":         "Economic",
}
Z_COLS = list(DOMAIN_MAP.keys())


def load_capital() -> pd.DataFrame:
    """Read capital.csv. The file uses European decimal commas inside quoted
    cells; we substitute those with dots, then parse with the standard CSV
    reader. Lines end with CRLF; pandas handles that."""
    text = (DATA / "capital.csv").read_text(encoding="utf-8")
    # Replace decimal comma in any quoted numeric field.
    text = re.sub(
        r'"(-?\d+),(\d+)"',
        lambda m: '"' + m.group(1) + "." + m.group(2) + '"',
        text,
    )
    df = pd.read_csv(io.StringIO(text))
    return df.sort_values("BCE").reset_index(drop=True)


def pca_fit(X):
    """PCA via eigendecomposition of the (n-1)-normalized covariance matrix.
    No re-standardization (caller passes already-Z columns)."""
    n, p = X.shape
    Xc = X - X.mean(axis=0)
    cov = (Xc.T @ Xc) / (n - 1)
    eigvals, eigvecs = np.linalg.eigh(cov)
    order = np.argsort(eigvals)[::-1]
    eigvals = np.clip(eigvals[order], a_min=0.0, a_max=None)
    eigvecs = eigvecs[:, order]
    ev_ratio = eigvals / eigvals.sum()
    scores = Xc @ eigvecs
    return scores, eigvecs, ev_ratio


def anchor_sign(scores, loadings, anchor_idx):
    """Flip PC scores and loadings so that the PC1 loading on the chosen
    anchor variable is positive."""
    if loadings[anchor_idx, 0] < 0:
        scores[:, 0]   = -scores[:, 0]
        loadings[:, 0] = -loadings[:, 0]
        return scores, loadings, -1.0
    return scores, loadings, +1.0


def main():
    cap = load_capital()
    print(f"capital.csv loaded: shape={cap.shape}, "
          f"BCE range [{cap['BCE'].min()}, {cap['BCE'].max()}], "
          f"unique BCE={cap['BCE'].nunique()}")
    print(f"Z-cols total NaNs: {int(cap[Z_COLS].isna().sum().sum())}")

    print("\n[No-op documentation] capital Z columns are *already* Z-scored.")
    raw_mean = float(cap[Z_COLS].mean().mean())
    raw_sd   = float(cap[Z_COLS].to_numpy().std(ddof=1))
    print(f"  pooled mean of 12 Z cols = {raw_mean:+.6f}")
    print(f"  pooled sd   of 12 Z cols = {raw_sd:.6f}")
    print("  -> no further standardization applied to PCA input.\n")

    X = cap[Z_COLS].to_numpy()
    scores, loadings, ev_ratio = pca_fit(X)
    idx_anchor = Z_COLS.index("ZMonument")
    scores, loadings, sign_flip = anchor_sign(scores, loadings, idx_anchor)
    print(f"[Sign] PC1 sign flipped by {-sign_flip:+.1f}; "
          f"loading on ZMonument now = {loadings[idx_anchor, 0]:+.4f}\n")

    print("Explained variance ratio:")
    for i in range(min(5, len(ev_ratio))):
        print(f"  PC{i+1}: {ev_ratio[i]:.4f}   cum: {ev_ratio[:i+1].sum():.4f}")

    loadings_df = pd.DataFrame(
        loadings[:, :2], index=Z_COLS,
        columns=["PC1_loading", "PC2_loading"])
    loadings_df["domain"] = [DOMAIN_MAP[c] for c in Z_COLS]
    loadings_df["abs_PC1"] = loadings_df["PC1_loading"].abs()
    loadings_df_sorted = loadings_df.sort_values("abs_PC1", ascending=False)
    loadings_df_sorted.to_csv(OUT / "loadings.csv", float_format="%.6f")
    print("\nPC1 loadings (sorted by |PC1|):")
    print(loadings_df_sorted.drop(columns="abs_PC1").round(4).to_string())

    scores_df = pd.DataFrame({"BCE": cap["BCE"], "group": cap["group"]})
    scores_df["PC1"] = scores[:, 0]
    scores_df["PC2"] = scores[:, 1]
    scores_df.to_csv(OUT / "per_slice_scores.csv", index=False,
                     float_format="%.6f")
    print("\nPer-slice scores (chronological):")
    print(scores_df.to_string(index=False))

    MN_mask = cap["BCE"].isin([3400, 3300, 3200, 3100, 3000])
    YN_mask = cap["BCE"].isin([2900, 2800, 2700, 2600, 2500, 2400, 2300])

    def phase_summary(label, mask):
        d = scores_df.loc[mask, ["BCE", "PC1", "PC2"]].sort_values("BCE")
        bce  = d["BCE"].to_numpy()
        pc1  = d["PC1"].to_numpy()
        pc2  = d["PC2"].to_numpy()
        slope_step = float(np.polyfit(np.arange(len(pc1)), pc1, 1)[0])
        slope_bce  = float(np.polyfit(bce, pc1, 1)[0])
        return dict(
            phase=label, n=len(d),
            bce_min=int(bce.min()), bce_max=int(bce.max()),
            pc1_mean=float(pc1.mean()), pc1_sd=float(pc1.std(ddof=1)),
            pc1_min=float(pc1.min()), pc1_max=float(pc1.max()),
            pc1_range=float(pc1.max() - pc1.min()),
            pc1_first=float(pc1[0]), pc1_last=float(pc1[-1]),
            slope_pc1_per_slice_step=slope_step,
            slope_pc1_per_plus1_bce=slope_bce,
            pc2_mean=float(pc2.mean()),
        )

    summary_df = pd.DataFrame([
        phase_summary("MN_3400_3000_BCE", MN_mask),
        phase_summary("YN_2900_2300_BCE", YN_mask),
    ])
    summary_df.to_csv(OUT / "phase_summary.csv", index=False,
                      float_format="%.6f")
    print("\nPhase summary table:")
    print(summary_df.round(4).to_string(index=False))

    def dominant_cluster(mask, k=4):
        """Slice-mean Z (within phase) multiplied by PC1 loading, ranked
        by absolute contribution."""
        d = cap.loc[mask, Z_COLS]
        z_center = d.mean(axis=0).to_numpy()
        contrib = pd.Series(z_center * loadings[:, 0], index=Z_COLS)
        contrib = contrib.sort_values(key=lambda s: s.abs(),
                                      ascending=False)
        return [(c, DOMAIN_MAP[c], float(contrib[c]))
                for c in contrib.index[:k]]

    print("\nDominant-loading contribution per phase "
          "(slice-mean Z x PC1 loading, top |.|):")
    for name, m in [("MN 3400-3000 BCE", MN_mask),
                    ("YN 2900-2300 BCE", YN_mask)]:
        print(f"  {name}:")
        for col, dom, val in dominant_cluster(m, k=4):
            print(f"    {col:<14s} ({dom:<8s})  contrib = {val:+.4f}")

    # ----------------- Robustness check -------------------------
    print("\n[Robustness] winsorize ZMonument at BCE=2700 ...")
    cap_w = cap.copy()
    zmon = cap_w["ZMonument"]
    zmu, zsd = float(zmon.mean()), float(zmon.std(ddof=1))
    cap_w.loc[cap_w["BCE"] == 2700, "ZMonument"] = zmu + 3 * zsd
    sw, lw, evw = pca_fit(cap_w[Z_COLS].to_numpy())
    sw, lw, _ = anchor_sign(sw, lw, idx_anchor)
    print(f"  original   PC1 EVR={ev_ratio[0]:.4f}, "
          f"PC2 EVR={ev_ratio[1]:.4f}, "
          f"PC1+PC2={ev_ratio[:2].sum():.4f}")
    print(f"  winsorized PC1 EVR={evw[0]:.4f}, "
          f"PC2 EVR={evw[1]:.4f}, "
          f"PC1+PC2={evw[:2].sum():.4f}")
    lw_df = pd.DataFrame(lw[:, :2], index=Z_COLS,
                         columns=["PC1_w", "PC2_w"])
    lw_df["abs_PC1_w"] = lw_df["PC1_w"].abs()
    print("  Winsorized PC1 loadings (sorted by |.|):")
    print("  " + (lw_df.sort_values("abs_PC1_w", ascending=False).round(4)
                   .drop(columns="abs_PC1_w").to_string()
                   .replace("\n", "\n  ")))
    sw_df = pd.DataFrame({"BCE": cap["BCE"], "group": cap["group"],
                          "PC1_win": sw[:, 0]})
    print("  Winsorized per-slice PC1 (MN and YN only):")
    sub = sw_df[MN_mask | YN_mask].sort_values("BCE")
    print("  " + sub.round(4).to_string(index=False).replace("\n", "\n  "))

    # PC1+PC2 context
    print(f"\n[PC1+PC2 context]")
    print(f"  PC1 EVR        = {ev_ratio[0]:.4f}")
    print(f"  PC2 EVR        = {ev_ratio[1]:.4f}")
    print(f"  PC1+PC2 cumEVR = {ev_ratio[:2].sum():.4f}")

    # Cross-phase delta
    pc1_mn_to_yn = float(scores_df.loc[YN_mask, "PC1"].mean()
                       - scores_df.loc[MN_mask, "PC1"].mean())
    print(f"\n[Cross-phase] mean PC1(YN) - mean PC1(MN) = {pc1_mn_to_yn:+.4f}")

    # Plain-text artefact
    rob_txt = (
        "Robustness check on BCE=2700 ZMonument outlier\n"
        "================================================\n\n"
        f"ZMonument at BCE=2700 BCE = "
        f"{float(cap.loc[cap['BCE']==2700,'ZMonument'].iloc[0]):+.6f}\n"
        f"column mean = {zmu:+.6f}, column sd = {zsd:+.6f}\n"
        f"winsorized value (mean+3sd cap) = {zmu + 3*zsd:+.6f}\n\n"
        "Variance explained\n"
        f"  original   PC1={ev_ratio[0]:.4f}, PC2={ev_ratio[1]:.4f}, "
        f"PC1+PC2={ev_ratio[:2].sum():.4f}\n"
        f"  winsorized PC1={evw[0]:.4f}, PC2={evw[1]:.4f}, "
        f"PC1+PC2={evw[:2].sum():.4f}\n"
    )
    (OUT / "robustness.txt").write_text(rob_txt)

    print("\nArtefacts written:")
    for f in sorted(OUT.iterdir()):
        print(f"  {f}  ({f.stat().st_size} bytes)")


if __name__ == "__main__":
    main()
