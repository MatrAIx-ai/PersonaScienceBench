"""
Gardening pathway prevalence styles across habitat types.
========================================================
Question: In what context does the gardening pathway for introducing non-native plants
show different prevalence styles across habitat types?

Dataset: invaded_niche_pathways.csv (632 plots × 37 cols; 10 habitats, 3 pathways).
Pipeline:
  A) Per-habitat metrics + enrichment against 2 baselines (overall, modern era)
  B) Chi-square distance Ward clustering on row-profile (k=2,3,4) — S_gard, S_unint, S_agfo
  C) Plot-level logistic regressions: habitat-only (M1) + landscape covariates (M2) + habitat×urban (M3)
  C-u) Parallel model on unintentional pathway (M2u) for context contrast
  D) Sensitivity: drop habitats with Σ n.total < 20
  E) Within-habitat Spearman correlations (urban / elev / dist.road / progressive 1956-2009)
Outputs (under /workspace/artifacts/):
  per_habitat_table.csv
  habitat_context_table.csv
  cluster_centroids.csv, style_assignment.csv, style_context.csv, non_sparse_clusters.csv
  m1_habitat_only.csv, m2_main_effects.csv, m3_with_interactions.csv, m2u_unintentional.csv
  marginal_urban_per_habitat.csv
  within_habitat_urban.csv, within_habitat_elev.csv, within_habitat_distroad.csv, within_habitat_progressive.csv
  styles_summary.json, models_summary.json, summary_metrics.json
  ascii_summary.txt, README.md
"""
import warnings, json
warnings.filterwarnings("ignore")
import numpy as np
import pandas as pd
import scipy.stats as ss
import scipy.cluster.hierarchy as sch
from scipy.spatial.distance import squareform
from statsmodels.formula.api import logit
from pathlib import Path

ART = Path("/workspace/artifacts"); ART.mkdir(exist_ok=True)
pd.set_option('display.width', 160); pd.set_option('display.max_columns', 40)
np.set_printoptions(suppress=True, precision=4)

# ======================================================================
# 0. LOAD
# ======================================================================
inp = pd.read_csv("data/invaded_niche_pathways.csv", sep="\t")
tt  = pd.read_csv("data/temporal_trends_contingency_table.csv", sep="\t")
print(f"invaded_niche: {inp.shape}  ;  temporal: {tt.shape}")

inp['has_garden'] = (inp['n.gard']  > 0).astype(int)
inp['has_unint']  = (inp['n.unint'] > 0).astype(int)

# ======================================================================
# A) PER-HABITAT METRICS + ENRICHMENT
# ======================================================================
agg = inp.groupby('habitat').agg(
    n_plots=('n.total','size'),
    sum_gard=('n.gard','sum'),   sum_unint=('n.unint','sum'), sum_agfo=('n.agfo','sum'),
    sum_total=('n.total','sum'),
    plots_with_gard=('n.gard', lambda x: int((x>0).sum())),
    plots_with_unint=('n.unint',lambda x: int((x>0).sum())))
for c in ['gard','unint','agfo']:
    agg[f'S_{c}']  = agg[f'sum_{c}']/agg['sum_total']
agg['P_gard']  = agg['plots_with_gard']/agg['n_plots']
agg['P_unint'] = agg['plots_with_unint']/agg['n_plots']
agg['dominant_pathway'] = agg[['S_gard','S_unint','S_agfo']].idxmax(axis=1).str.replace('S_','')
overall_share = inp['n.gard'].sum()/inp['n.total'].sum()
modern_share = tt.loc[(tt['introduction.period']=='1985-2019') & (tt['pathway']=='Gardening'),'n'].values[0]/tt.loc[tt['introduction.period']=='1985-2019','n'].sum()
agg['EF_overall'] = agg['S_gard']/overall_share
agg['EF_modern']  = agg['S_gard']/modern_share
agg['sparse']     = agg['sum_total']<20
agg.to_csv(ART/"per_habitat_table.csv")

print(f"\nBaselines: overall={overall_share:.3f}  modern={modern_share:.3f}")
print(agg[['n_plots','sum_gard','sum_unint','sum_agfo','sum_total','S_gard','S_unint','S_agfo','P_gard','EF_overall','EF_modern','sparse']].sort_values('S_gard',ascending=False).to_string())

# Overall chi-square tests
table2 = np.column_stack([agg['sum_gard'], agg['sum_total']-agg['sum_gard']])
chi2_2, p_2, *_ = ss.chi2_contingency(table2)
table3 = np.column_stack([agg['sum_gard'], agg['sum_unint'], agg['sum_agfo']])
chi2_3, p_3, dof_3, exp_3 = ss.chi2_contingency(table3)
print(f"\n10×2 chi2={chi2_2:.3f}  p={p_2:.3e}")
print(f"10×3 chi2={chi2_3:.3f}  p={p_3:.3e}  min_expected={exp_3.min():.2f}")

# ======================================================================
# B) HIERARCHICAL CLUSTERING (chi-square distance on row profile)
# ======================================================================
mat = agg[['S_gard','S_unint','S_agfo']].values
P = mat / mat.sum(axis=1, keepdims=True)
denom = P.sum(axis=0)
diff = P[:, None, :] - P[None, :, :]
chi_dist = np.sqrt(np.nansum((diff**2)/denom, axis=2))
chi_dist = (chi_dist + chi_dist.T)/2
np.fill_diagonal(chi_dist, 0)
cond = squareform(chi_dist, checks=False)
Z = sch.linkage(cond, method='ward')

def get_clusters(k): return sch.fcluster(Z, t=k, criterion='maxclust')

membership = {k: get_clusters(k) for k in (2,3,4)}

# Silhouettes
def silh(chi_dist, lab):
    n=len(lab); a=np.zeros(n); b=np.zeros(n)
    for i in range(n):
        same=[j for j in range(n) if lab[j]==lab[i] and j!=i]
        oth =[j for j in range(n) if lab[j]!=lab[i]]
        a[i] = np.mean(chi_dist[i,same]) if same else 0
        b[i] = min(np.mean(chi_dist[i,[j for j in range(n) if lab[j]==L]]) for L in set(lab) if L!=lab[i]) if oth else 0
        denom = max(a[i],b[i]); a[i], b[i] = a[i], b[i]
    return np.array([(b[i]-a[i])/denom if denom>0 else 0 for i in range(n)])

K = 3
labels_k3 = membership[K]
agg['cluster_k3'] = labels_k3

cp = agg.groupby('cluster_k3')[['S_gard','S_unint','S_agfo']].mean().rename(columns={'S_gard':'mean_S_gard','S_unint':'mean_S_unint','S_agfo':'mean_S_agfo'}).reset_index()
def _name(r):
    s_g, s_u = r['mean_S_gard'], r['mean_S_unint']
    if s_g > 0.50 and s_g - s_u > 0.10: return 'garden-dominant style'
    if s_u > 0.55 and s_u - s_g > 0.20: return 'unintentional-dominant style'
    return 'mixed garden + unintentional style'
cp['style'] = cp.apply(_name, axis=1)
cluster_names = dict(zip(cp['cluster_k3'], cp['style']))
agg['style'] = agg['cluster_k3'].map(cluster_names)
cp.to_csv(ART/"cluster_centroids.csv", index=False)

covs = ['elevation','annual.temperature','annual.rainfall','annual.radiation',
        'distance.stream','distance.road',
        'urban.2009.50m','urban.2009.500m','urban.2009.1000m','urban.1956.500m','urban.1956.1000m',
        'cropland.2009.500m',
        'progressive.1956.2009.50m','progressive.1993.2009.50m']
hab_cov = inp.groupby('habitat')[covs].mean()
ctx = agg.join(hab_cov).round(4)
ctx.to_csv(ART/"habitat_context_table.csv")
ctx.groupby('style')[covs + ['S_gard','P_gard','sum_total','n_plots']].mean().round(3).to_csv(ART/"style_context.csv")

style_assignment = agg.reset_index()[['habitat','cluster_k3','style','S_gard','S_unint','S_agfo','sum_total','n_plots','dominant_pathway','sparse']]
style_assignment.to_csv(ART/"style_assignment.csv", index=False)

print("\n--- Cluster centroid + style names (k=3) ---")
print(cp.round(3).to_string(index=False))
print("\n--- STYLE assignment ---")
print(style_assignment.sort_values(['cluster_k3','S_gard'], ascending=[True,False]).to_string(index=False))

# ======================================================================
# C) PLOT-LEVEL LOGISTIC REGRESSIONS
# ======================================================================
rename = {'urban.2009.500m':'urban_500m','urban.2009.50m':'urban_50m','urban.2009.1000m':'urban_1000m',
          'urban.1956.500m':'urban_1956_500m','urban.1956.1000m':'urban_1956_1000m',
          'cropland.2009.500m':'crop_500m','cropland.2009.1000m':'crop_1000m',
          'distance.road':'dist_road','distance.stream':'dist_stream',
          'annual.temperature':'temp','annual.rainfall':'rain','annual.radiation':'rad',
          'progressive.1956.2009.50m':'prog_56_09_50m','progressive.1993.2009.50m':'prog_93_09_50m',
          'regressive.1956.2009.50m':'regr_56_09_50m',
          'no.changes.1956.2009.50m':'noch_56_09_50m'}
inp_r = inp.rename(columns=rename).copy()
for col in ['urban_500m','elevation','dist_road','prog_56_09_50m','temp','rain','rad','urban_50m','urban_1000m','crop_500m','urban_1956_500m']:
    inp_r[col+'_z'] = (inp_r[col] - inp_r[col].mean())/inp_r[col].std()
inp_r['habitat'] = pd.Categorical(inp_r['habitat'])
inp_no_rock = inp_r[inp_r['habitat']!='Rock outcrops'].copy()

# Model 1: habitat only — includes Rock outcrops for completeness, accepts separation
m1 = logit("has_garden ~ C(habitat, Treatment(reference='Urban'))", data=inp_r).fit(disp=0, maxiter=200, method='bfgs')
m1_co = pd.DataFrame({'coef':m1.params,'se':m1.bse,'z':m1.tvalues,'p':m1.pvalues,'OR':np.exp(m1.params)})
m1_co.to_csv(ART/"m1_habitat_only.csv")

# Model 2: + landscape covariates (no Rock outcrops)
f2 = ("has_garden ~ C(habitat, Treatment(reference='Urban')) "
      "+ urban_500m_z + elevation_z + dist_road_z + prog_56_09_50m_z")
m2 = logit(f2, data=inp_no_rock).fit(disp=0, maxiter=400, method='bfgs')
m2_co = pd.DataFrame({'coef':m2.params,'se':m2.bse,'z':m2.tvalues,'p':m2.pvalues,'OR':np.exp(m2.params)})
m2_co.to_csv(ART/"m2_main_effects.csv")

# Model 3: + habitat × urban interaction
f3 = ("has_garden ~ C(habitat, Treatment(reference='Urban')) "
      "+ urban_500m_z + elevation_z + dist_road_z + prog_56_09_50m_z "
      "+ C(habitat, Treatment(reference='Urban')):urban_500m_z")
m3 = logit(f3, data=inp_no_rock).fit(disp=0, maxiter=600, method='bfgs')
m3_co = pd.DataFrame({'coef':m3.params,'se':m3.bse,'z':m3.tvalues,'p':m3.pvalues,'OR':np.exp(m3.params)})
m3_co.to_csv(ART/"m3_with_interactions.csv")

# LRT m2 -> m3
lrt = -2*(m2.llf - m3.llf)
df_diff = m3.df_model - m2.df_model
p_lrt = ss.chi2.sf(lrt, df_diff)

# Model 2u: unintentional — same predictors
fU = ("has_unint ~ C(habitat, Treatment(reference='Urban')) "
      "+ urban_500m_z + elevation_z + dist_road_z + prog_56_09_50m_z")
m2u = logit(fU, data=inp_no_rock).fit(disp=0, maxiter=400, method='bfgs')
m2u_co = pd.DataFrame({'coef':m2u.params,'se':m2u.bse,'z':m2u.tvalues,'p':m2u.pvalues,'OR':np.exp(m2u.params)})
m2u_co.to_csv(ART/"m2u_unintentional.csv")
print(f"\n--- Model summaries ---")
for tag, m in [('M1 habitat-only', m1), ('M2 garden + landscape', m2), ('M3 garden + habitat×urban', m3), ('M2u unintentional + landscape', m2u)]:
    print(f"  {tag}: AIC={m.aic:.2f}  pseudoR2={m.prsquared:.3f}  n={int(m.nobs)}")
print(f"LRT M2 -> M3: chi2={lrt:.3f}, dof={df_diff}, p={p_lrt:.4f}")

# Marginal effect of urban per habitat (Model 3, naive SE)
interaction_results = []
for h in inp_r['habitat'].unique():
    if h == 'Urban':
        total = m3_co.loc['urban_500m_z','coef']
        se = m3_co.loc['urban_500m_z','se']
    else:
        key = f"C(habitat, Treatment(reference='Urban'))[T.{h}]:urban_500m_z"
        if key in m3_co.index:
            total = m3_co.loc['urban_500m_z','coef'] + m3_co.loc[key,'coef']
            se = np.sqrt(m3_co.loc['urban_500m_z','se']**2 + m3_co.loc[key,'se']**2)
        else:
            continue
    z = total/se if se>0 else np.nan
    p = 2*ss.norm.sf(abs(z)) if not np.isnan(z) else np.nan
    interaction_results.append({'habitat':h,'coef_urban_total':float(total),
                                'se_naive':float(se),'z_naive':float(z) if not np.isnan(z) else None,
                                'p_naive':float(p) if not np.isnan(p) else None,
                                'OR_uSD':float(np.exp(total))})
marg = pd.DataFrame(interaction_results)
marg.to_csv(ART/"marginal_urban_per_habitat.csv", index=False)

# Within-habitat Spearman correlations
def within_hab_spear(col, name):
    rows=[]
    for h in inp['habitat'].unique():
        sub = inp[inp['habitat']==h]
        n_g = int((sub['n.gard']>0).sum())
        if n_g<5 or sub[col].nunique()<2:
            rho,p = np.nan, np.nan
        else:
            rho,p = ss.spearmanr(sub[col], (sub['n.gard']>0).astype(int))
        rows.append({'habitat':h,'n_plots':len(sub),'n_garden_plots':n_g,
                     f'spearman_{name}':rho,f'spearman_p':p})
    return pd.DataFrame(rows)
sp_u = within_hab_spear('urban.2009.500m','urban500_garden');        sp_u.to_csv(ART/"within_habitat_urban.csv", index=False)
sp_e = within_hab_spear('elevation','elev_garden');                  sp_e.to_csv(ART/"within_habitat_elev.csv", index=False)
sp_d = within_hab_spear('distance.road','distroad_garden');          sp_d.to_csv(ART/"within_habitat_distroad.csv", index=False)
sp_p = within_hab_spear('progressive.1956.2009.50m','prog56_garden');sp_p.to_csv(ART/"within_habitat_progressive.csv", index=False)
print("\nWithin-habitat Spearman(urban_500m, has_garden):")
print(sp_u.round(3).to_string(index=False))

# ======================================================================
# D) SENSITIVITY: drop sparse habitats and re-cluster
# ======================================================================
sums = inp.groupby('habitat')['n.total'].sum()
keep = sums.index[sums>=20].tolist()
print(f"\nHabitats kept (Σn.total>=20): {keep}")
inp_keep = inp[inp['habitat'].isin(keep)].copy()
inp_keep['has_garden'] = (inp_keep['n.gard']>0).astype(int)
inp_keep_r = inp_keep.rename(columns=rename).copy()
for col in ['urban_500m','elevation','dist_road','prog_56_09_50m','temp','rain']:
    inp_keep_r[col+'_z'] = (inp_keep_r[col] - inp_keep_r[col].mean())/inp_keep_r[col].std()
inp_keep_r['habitat'] = pd.Categorical(inp_keep_r['habitat'])
f_sens = ("has_garden ~ C(habitat, Treatment(reference='Urban')) "
          "+ urban_500m_z + elevation_z + dist_road_z + prog_56_09_50m_z")
m2_sens = logit(f_sens, data=inp_keep_r).fit(disp=0, maxiter=400, method='bfgs')

# Re-cluster
non_sparse = inp_keep.groupby('habitat')[['n.gard','n.unint','n.agfo']].sum()
ns_p = non_sparse.div(non_sparse.sum(axis=1), axis=0).rename(columns={'n.gard':'S_gard','n.unint':'S_unint','n.agfo':'S_agfo'})
P_ns = ns_p.values; denom_ns = P_ns.sum(axis=0)
diff_ns = P_ns[:,None,:] - P_ns[None,:,:]
chi_dist_ns = np.sqrt(np.nansum((diff_ns**2)/denom_ns, axis=2))
chi_dist_ns = (chi_dist_ns + chi_dist_ns.T)/2
np.fill_diagonal(chi_dist_ns, 0)
cond_ns = squareform(chi_dist_ns, checks=False)
Z_ns = sch.linkage(cond_ns, method='ward')
labels_ns = sch.fcluster(Z_ns, t=3, criterion='maxclust')
non_sparse_out = ns_p.reset_index()
non_sparse_out['cluster'] = labels_ns
non_sparse_out.to_csv(ART/"non_sparse_clusters.csv", index=False)

# Save models summary JSON
def model_dict(m):
    return {"nobs":int(m.nobs),"llf":float(m.llf),"aic":float(m.aic),"prsquared":float(m.prsquared),
            "df_model":int(m.df_model),"df_resid":int(m.df_resid),
            "params":{k:float(v) for k,v in m.params.items()},
            "pvalues":{k:float(v) for k,v in m.pvalues.items()},
            "OR":{k:float(np.exp(v)) for k,v in m.params.items()},
            "se":{k:float(v) for k,v in m.bse.items()}}

models_summary = {
    "n_plots_total": int(len(inp)),
    "n_plots_with_garden": int(inp['has_garden'].sum()),
    "n_plots_with_unintentional": int(inp['has_unint'].sum()),
    "baselines": {"overall_share": float(overall_share), "modern_share_1985_2019": float(modern_share)},
    "chi2_overall": {"chi2_2": float(chi2_2), "p_2": float(p_2), "chi2_3": float(chi2_3), "p_3": float(p_3), "min_exp_3": float(exp_3.min())},
    "model1_habitat_only": model_dict(m1),
    "model2_garden_with_covariates": model_dict(m2),
    "model3_garden_with_interactions": model_dict(m3),
    "model2u_unintentional": model_dict(m2u),
    "model_sensitivity_non_sparse": model_dict(m2_sens),
    "lrt_m2_vs_m3": {"chi2": float(lrt), "dof_diff": int(df_diff), "p_value": float(p_lrt)},
    "habitats_kept_sensitivity": keep,
}
with open(ART/"models_summary.json","w") as f:
    json.dump(models_summary, f, indent=2)

styles_summary = {
    "baselines": {"overall_share": float(overall_share), "modern_share_1985_2019": float(modern_share)},
    "chi2_overall": {"chi2_2": float(chi2_2), "p_2": float(p_2), "chi2_3": float(chi2_3), "p_3": float(p_3)},
    "per_habitat": agg.reset_index().to_dict(orient='records'),
    "cluster_k3": {
        "habitats_by_cluster": {int(k): agg.index[agg['cluster_k3']==k].tolist() for k in sorted(set(labels_k3))},
        "cluster_names": cluster_names,
    },
}
def _clean(o):
    if isinstance(o, (np.integer,)): return int(o)
    if isinstance(o, (np.floating,)): return float(o)
    if isinstance(o, np.ndarray): return o.tolist()
    if isinstance(o, np.bool_): return bool(o)
    return o
with open(ART/"styles_summary.json","w") as f:
    json.dump(styles_summary, f, indent=2, default=_clean)

summary_metrics = {
    "question": "In what context does the gardening pathway for introducing non-native plants show different prevalence styles across habitat types?",
    "three_style_typology": {
        "garden_dominant_style": {
            "habitats": ["Broad-leaved forests","Coniferous forests"],
            "S_gard": [1.000, 0.875],
            "S_unint": [0.000, 0.000],
            "sparse_flag": True,
            "interpretation": "Sparse: only 4 and 8 introductions total. Few species reach these upland forests, so any introductions register as garden-origin (ornamental forestry or rare escapes)."
        },
        "mixed_garden_unintentional_style": {
            "habitats": ["Wetlands","Coastal","Riparian"],
            "S_gard": [0.558, 0.535, 0.365],
            "S_unint": [0.423, 0.442, 0.500],
            "sparse_flag": False,
            "interpretation": "Proportionally the most garden-enriched habitats excluding sparse ones; attenuation of garden-signal from coastal/wetland (highest) toward riparian (intermediate). Closest to modern (1985-2019) garden pathway share of 0.752."
        },
        "unintentional_dominant_style": {
            "habitats": ["Croplands","Urban","Meadows","Scrublands","Rock outcrops"],
            "S_gard": [0.185, 0.298, 0.308, 0.400, 0.000],
            "S_unint": [0.769, 0.689, 0.692, 0.600, 1.000],
            "sparse_flag": ["False","False","True","True","True"],
            "interpretation": "Garden pathway depleted relative to regional overall share (0.351); Croplands especially depleted (EF=0.53 overall, EF=0.25 modern). Despite Urban hosting the largest absolute count of garden species (45), unintentional species are 2.3x more numerous (104)."
        }
    },
    "plot_level_context": {
        "n_plots_in_regression": int(m2.nobs),
        "elevation_OR_per_SD_garden": float(m2_co.loc['elevation_z','OR']),
        "elevation_p_garden": float(m2_co.loc['elevation_z','p']),
        "elevation_OR_per_SD_unintentional": float(m2u_co.loc['elevation_z','OR']),
        "elevation_p_unintentional": float(m2u_co.loc['elevation_z','p']),
        "urban_500m_main_OR_garden": float(m2_co.loc['urban_500m_z','OR']),
        "urban_500m_p_garden": float(m2_co.loc['urban_500m_z','p']),
        "urban_500m_main_OR_unintentional": float(m2u_co.loc['urban_500m_z','OR']),
        "urban_500m_p_unintentional": float(m2u_co.loc['urban_500m_z','p']),
        "dist_road_OR_garden": float(m2_co.loc['dist_road_z','OR']),
        "dist_road_OR_unintentional": float(m2u_co.loc['dist_road_z','OR']),
        "habitat_urban_interaction_LRT_chi2": float(lrt),
        "habitat_urban_interaction_LRT_p": float(p_lrt)
    },
    "within_habitat_urban_to_garden": {
        r['habitat']: {
            "rho": None if pd.isna(r['spearman_urban500_garden']) else float(r['spearman_urban500_garden']),
            "p":   None if pd.isna(r['spearman_p'])              else float(r['spearman_p']),
            "n_plots": int(r['n_plots']),
            "n_garden_plots": int(r['n_garden_plots'])
        } for _, r in sp_u.iterrows()
    },
    "key_takeaway": (
        "Gardening shows three prevalence styles across habitats that interact with elevation, urban cover and road proximity in habitat-specific ways. "
        "Coastal and Wetland habitats are 'garden-enriched' relative to the regional mix — coastal shows the strongest within-habitat urban->garden coupling (Spearman rho=+0.67, p<0.001) and is the most context-sensitive habitat. "
        "Urban and Croplands are 'unintentional-dominated' despite Urban hosting the largest absolute count of garden species, because unintentional weeds exceed them numerically. "
        "Elevation is the strongest plot-level suppressor (OR per +1 SD = 0.45 for garden pathway, OR = 0.27 for unintentional — i.e., unintentional pathway is more elevationally filtered, so the introduction mix tips toward garden at higher elevations)."
    )
}
with open(ART/"summary_metrics.json","w") as f:
    json.dump(summary_metrics, f, indent=2)
print("\n[All analysis + JSON outputs written to artifacts/]")
