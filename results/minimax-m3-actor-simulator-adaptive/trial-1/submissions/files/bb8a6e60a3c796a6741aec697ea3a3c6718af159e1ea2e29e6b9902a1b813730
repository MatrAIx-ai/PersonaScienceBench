"""
NLS Incarceration — Annual wealth gap by ever_jailed (cross-sectional, 1985/1990/1996).

Scope (locked with researcher, plan approved):
  (A) 3 independent cross-sectional comparisons per year (NOT longitudinal).
  (B) Primary: Mann-Whitney U (two-sided). Complementary: Welch t on log1p(wealth -
      MIN_TOTAL + 1), where MIN_TOTAL is a *single constant* across years so the
      transformation is comparable across years.
  (C) Effect sizes: r rank-biserial from U, and Cohen's d on the log-transformed wealth.
  (D) BH-FDR on the 3 Mann-Whitney p-values (primary). BH-FDR also on the 3 Welch
      p-values as sensitivity.
  (E) Winsorization at 1st/99th percentile per year, rerun Mann-Whitney as sensitivity.
  (F) Final per-year report: n0, n1, median0, Q1_0, Q3_0, median1, Q1_1, Q3_1,
      U, raw p, BH p, r, d, binary conclusion.
      "Significantly lower" ⇔ p_mw_BH < 0.05 AND median1 < median0 AND |r| ≥ 0.05.
  (G) ANNEX OLS with HC3: log_wealth_y ~ ever_jailed * C(race) + ever_jailed * C(sex).
      Per year. Reported as annex only, NOT the primary test for the brief.
  (H) No longitudinal, no permutations, no logit on wealth>0, no imputation.
  (I) Typo fix: 'hipanic' → 'hispanic' (documented in README).

Outputs:
  - /workspace/artifacts/results_summary.csv       (primary per-year table)
  - /workspace/artifacts/sensitivity_winsor.csv    (winsorized sensitivity)
  - /workspace/artifacts/ols_annex.csv             (OLS with HC3, per-year)
  - stdout with full per-year metrics
"""
import os
import sys
import numpy as np
import pandas as pd
from scipy import stats
from statsmodels.stats.multitest import multipletests
import statsmodels.formula.api as smf

DATA = "/workspace/data/nls_incarceration_processed.csv"
OUT  = "/workspace/artifacts"
os.makedirs(OUT, exist_ok=True)

# ------- 1. Load, clean, fix typo -------
df = pd.read_csv(DATA)
n_typo = int((df["race"] == "hipanic").sum())
df["race"] = df["race"].replace({"hipanic": "hispanic"})
print(f"[load] shape={df.shape}; typo 'hipanic' renamed to 'hispanic' on {n_typo} rows")

WEALTH = ["composite_wealth_1985", "composite_wealth_1990", "composite_wealth_1996"]
years  = [1985, 1990, 1996]

# ------- 2. Single shared min for cross-year-comparable log transform -------
MIN_TOTAL = int(df[WEALTH].min().min())   # = -866400 across all columns / rows
print(f"[transform] MIN_TOTAL over all three wealth columns = {MIN_TOTAL}")
print(f"             log1p(wealth - {MIN_TOTAL} + 1) used for t-test and OLS annex")

for y in years:
    df[f"log_wealth_{y}"] = np.log1p(df[f"composite_wealth_{y}"] - MIN_TOTAL + 1)

# ------- 3. Per-year primary + complementary analysis -------
rows = []
for y in years:
    wc = f"composite_wealth_{y}"
    lc = f"log_wealth_{y}"
    g0 = df.loc[df["ever_jailed"] == 0, wc]
    g1 = df.loc[df["ever_jailed"] == 1, wc]
    g0l = df.loc[df["ever_jailed"] == 0, lc]
    g1l = df.loc[df["ever_jailed"] == 1, lc]

    n0, n1 = len(g0), len(g1)

    # Mann-Whitney U (two-sided) — PRIMARY
    U, p_mw = stats.mannwhitneyu(g0, g1, alternative="two-sided")

    # Rank-biserial correlation from U: r = 1 - 2U/(n0*n1); range [-1, 1]
    r_rb = 1.0 - (2.0 * U) / (n0 * n1)

    # Welch t-test on log-transformed wealth — COMPLEMENTARY
    t_welch, p_welch = stats.ttest_ind(g0l, g1l, equal_var=False)

    # Cohen's d on log-transformed wealth (pooled SD over both groups)
    m0l, m1l = float(g0l.mean()), float(g1l.mean())
    s0l, s1l = float(g0l.std(ddof=1)), float(g1l.std(ddof=1))
    s_pooled = np.sqrt(((n0 - 1) * s0l**2 + (n1 - 1) * s1l**2) / (n0 + n1 - 2))
    d_log = (m1l - m0l) / s_pooled if s_pooled > 0 else np.nan

    rows.append(dict(
        year=y,
        n0=n0, n1=n1,
        median0=float(g0.median()), q1_0=float(g0.quantile(0.25)), q3_0=float(g0.quantile(0.75)),
        median1=float(g1.median()), q1_1=float(g1.quantile(0.25)), q3_1=float(g1.quantile(0.75)),
        U=float(U), p_mw_raw=float(p_mw), r_rb=float(r_rb),
        t_welch=float(t_welch), p_welch_raw=float(p_welch), d_log=float(d_log),
    ))

df_res = pd.DataFrame(rows)

# ------- 4. BH FDR on the 3 Mann-Whitney p-values (PRIMARY) and on Welch (sensitivity) -------
_, p_mw_bh,   _, _ = multipletests(df_res["p_mw_raw"],   method="fdr_bh", alpha=0.05)
_, p_welch_bh, _, _ = multipletests(df_res["p_welch_raw"], method="fdr_bh", alpha=0.05)
df_res["p_mw_BH"]    = p_mw_bh
df_res["p_welch_BH"] = p_welch_bh

# ------- 5. Binary conclusion per the locked rule -------
df_res["median1_lt_median0"] = df_res["median1"] < df_res["median0"]
df_res["conclusion_sig_lower"] = (
    (df_res["p_mw_BH"] < 0.05) &
    df_res["median1_lt_median0"] &
    (df_res["r_rb"].abs() >= 0.05)
)

# ------- 6. Sensitivity: winsorize 1-99 per year, rerun Mann-Whitney -------
sens_rows = []
for y in years:
    wc = f"composite_wealth_{y}"
    vals = df[wc].values
    p01, p99 = np.percentile(vals, [1, 99])
    g0 = np.clip(df.loc[df["ever_jailed"] == 0, wc].values, p01, p99)
    g1 = np.clip(df.loc[df["ever_jailed"] == 1, wc].values, p01, p99)
    n0, n1 = len(g0), len(g1)
    U_w, p_w = stats.mannwhitneyu(g0, g1, alternative="two-sided")
    r_w = 1.0 - (2.0 * U_w) / (n0 * n1)
    sens_rows.append(dict(
        year=y, winsor_lo=float(p01), winsor_hi=float(p99),
        U=float(U_w), p_mw_winsor_raw=float(p_w), r_rb_winsor=float(r_w),
        median1=float(np.median(g1)), median0=float(np.median(g0)),
    ))
df_sens = pd.DataFrame(sens_rows)
_, p_w_bh, _, _ = multipletests(df_sens["p_mw_winsor_raw"], method="fdr_bh", alpha=0.05)
df_sens["p_mw_winsor_BH"] = p_w_bh

# ------- 7. ANNEX: OLS per year with HC3 robust SE -------
# log_wealth_y ~ ever_jailed * C(race) + ever_jailed * C(sex)
# Reported as annex only; NOT the primary test for the brief.
ols_dfs = []
for y in years:
    lc = f"log_wealth_{y}"
    sub = df[[lc, "ever_jailed", "race", "sex"]].dropna().copy()
    formula = (f"{lc} ~ ever_jailed * C(race) + ever_jailed * C(sex)")
    model = smf.ols(formula, data=sub).fit(cov_type="HC3")
    ci = model.conf_int()
    summ = pd.DataFrame({
        "year":      y,
        "term":      model.params.index,
        "coef":      model.params.values,
        "std_err_HC3": model.bse.values,
        "t":         model.tvalues.values,
        "p":         model.pvalues.values,
        "ci_lo":     ci.iloc[:, 0].values,
        "ci_hi":     ci.iloc[:, 1].values,
        "n":         int(model.nobs),
        "r2":        float(model.rsquared),
        "r2_adj":    float(model.rsquared_adj),
    })
    ols_dfs.append(summ)
df_ols = pd.concat(ols_dfs, ignore_index=True)

# ------- 8. Save outputs -------
df_res.to_csv(os.path.join(OUT, "results_summary.csv"), index=False)
df_sens.to_csv(os.path.join(OUT, "sensitivity_winsor.csv"), index=False)
df_ols.to_csv(os.path.join(OUT, "ols_annex.csv"), index=False)

# ------- 9. Print human-readable summary -------
def _fmt_p(p):  # compact p-value
    if pd.isna(p): return "NA"
    return "%.3e" % p if p < 1e-3 else "%.4f" % p

print("\n" + "=" * 84)
print("PRIMARY — Mann-Whitney U (raw wealth) + Cohen's d (log wealth) per year")
print("=" * 84)
print(f"{'year':>6} {'n0':>6} {'n1':>5} "
      f"{'med0':>10} {'Q1_0':>9} {'Q3_0':>9} "
      f"{'med1':>10} {'Q1_1':>9} {'Q3_1':>9} "
      f"{'U':>14} {'p_mw_raw':>11} {'p_mw_BH':>11} {'r_rb':>7} {'d_log':>7}")
for _, r in df_res.iterrows():
    print(f"{int(r['year']):>6} {int(r['n0']):>6} {int(r['n1']):>5} "
          f"{r['median0']:>10.0f} {r['q1_0']:>9.0f} {r['q3_0']:>9.0f} "
          f"{r['median1']:>10.0f} {r['q1_1']:>9.0f} {r['q3_1']:>9.0f} "
          f"{r['U']:>14.0f} {_fmt_p(r['p_mw_raw']):>11} {_fmt_p(r['p_mw_BH']):>11} "
          f"{r['r_rb']:>7.4f} {r['d_log']:>7.4f}")

print("\n--- Welch t-test (log wealth) ---")
print(f"{'year':>6} {'t':>9} {'p_welch_raw':>13} {'p_welch_BH':>13}")
for _, r in df_res.iterrows():
    print(f"{int(r['year']):>6} {r['t_welch']:>9.3f} "
          f"{_fmt_p(r['p_welch_raw']):>13} {_fmt_p(r['p_welch_BH']):>13}")

print("\n--- Binary conclusion (locked rule: p_mw_BH<0.05 & med1<med0 & |r|>=0.05) ---")
for _, r in df_res.iterrows():
    flag = "YES (wealth significantly lower in ever_jailed=1)" if r["conclusion_sig_lower"] else "NO"
    print(f"  {int(r['year'])}: {flag}  "
          f"(p_mw_BH={_fmt_p(r['p_mw_BH'])}, med1<med0={bool(r['median1_lt_median0'])}, "
          f"|r|={abs(float(r['r_rb'])):.4f})")

print("\n" + "=" * 84)
print("SENSITIVITY — Mann-Whitney after winsorization at [p1, p99]")
print("=" * 84)
print(f"{'year':>6} {'p1':>10} {'p99':>10} {'U_w':>14} {'p_w_raw':>11} {'p_w_BH':>11} {'r_w':>7}")
for _, r in df_sens.iterrows():
    print(f"{int(r['year']):>6} {r['winsor_lo']:>10.0f} {r['winsor_hi']:>10.0f} "
          f"{r['U']:>14.0f} {_fmt_p(r['p_mw_winsor_raw']):>11} "
          f"{_fmt_p(r['p_mw_winsor_BH']):>11} {r['r_rb_winsor']:>7.4f}")

print("\n" + "=" * 84)
print("ANNEX — OLS (HC3) on log_wealth_y per year  [informational only]")
print("=" * 84)
for y in years:
    sub = df_ols[df_ols["year"] == y]
    print(f"\n  Year {y}  n={int(sub['n'].iloc[0])}  R2={float(sub['r2'].iloc[0]):.4f}  R2_adj={float(sub['r2_adj'].iloc[0]):.4f}")
    print(f"  {'term':<38} {'coef':>12} {'se_HC3':>10} {'t':>8} {'p':>11}")
    for _, row in sub.iterrows():
        print(f"  {str(row['term']):<38} {row['coef']:>12.4f} {row['std_err_HC3']:>10.4f} "
              f"{row['t']:>8.3f} {_fmt_p(row['p']):>11}")

print("\n[done] Wrote:",
      os.path.join(OUT, "results_summary.csv"), ",",
      os.path.join(OUT, "sensitivity_winsor.csv"), ",",
      os.path.join(OUT, "ols_annex.csv"))
