"""
Capital PCA — Younger Bronze Age (1100-500 BCE).
Option A (primary):  PCA on 7 YBA rows, center=True, scale=False, sign convention on max-|loading|.
Option B (sensitivity): PCA on all 39 rows, project YBA rows.
Bootstrap: 400 row-bootstrap replicates; compute Delta-bar = mean Delta vs 1100 BCE per replicate.
"""
import json, os
import numpy as np
import pandas as pd
from numpy.linalg import svd

Z_COLS = ['ZAxtSchwert','ZDolch','Zhausgr','ZCU_AU','Zamber','ZMonument',
          'ZHort','ZSichel','ZBeil','ZMW','ZKeform','Zkeverz']

# Capital-domain mapping (for narrative): economic=ZCU_AU/ZBeil/ZAxtSchwert; cultural=ZMonument/Zkeverz/ZKeform/ZDolch; social=Zhausgr/ZHort/ZAmber; symbolic=ZMW/ZSichel (dispersion indicators).
MAPPING = {
    'ZCU_AU':'economic','ZBeil':'economic','ZAxtSchwert':'economic',
    'ZMonument':'cultural','Zkeverz':'cultural','ZKeform':'cultural','ZDolch':'cultural',
    'Zhausgr':'social','ZHort':'social','Zamber':'social',
    'ZMW':'symbolic','ZSichel':'symbolic',
}

def fix_sign(w):
    j = int(np.argmax(np.abs(w)))
    return w if w[j] >= 0 else -w

def pca1(X):
    mu = X.mean(axis=0)
    Xc = X - mu
    U, S, Vt = svd(Xc, full_matrices=False)
    return Vt[0], U[:,0]*S[0], (S[0]**2)/(S**2).sum(), mu

def main():
    rng = np.random.default_rng(42)
    df = pd.read_csv('data/capital.csv', decimal=',')
    yba = df[(df['BCE']>=500)&(df['BCE']<=1100)].sort_values('BCE', ascending=False).reset_index(drop=True)
    X_yba = yba[Z_COLS].to_numpy().astype(float)
    bce = yba['BCE'].to_numpy()
    X_all = df[Z_COLS].to_numpy().astype(float)
    n,_ = X_yba.shape

    # Option A
    wA_raw, _, varA, muA = pca1(X_yba)
    wA = fix_sign(wA_raw)
    sA = (X_yba - muA) @ wA

    # Option B
    wB_raw, _, varB, muB = pca1(X_all)
    wB = fix_sign(wB_raw)
    sB = (X_yba - muB) @ wB

    sdA, sdB = sA.std(ddof=1), sB.std(ddof=1)
    dA, dB = sA - sA[0], sB - sB[0]

    # Bootstrap (Option A)
    boot = np.empty(400)
    for r in range(400):
        idx = rng.integers(0, n, n)
        Xb = X_yba[idx]
        wb_raw, _, _, mb = pca1(Xb)
        wb = fix_sign(wb_raw)
        proj = (X_yba - mb) @ wb
        boot[r] = (proj[1:] - proj[0]).mean()

    out = {
        "bce_order_desc": bce.tolist(),
        "A_var_exp_pct": round(varA*100,3),
        "B_var_exp_pct": round(varB*100,3),
        "PC1_A": {int(b):round(float(s),4) for b,s in zip(bce,sA)},
        "PC1_B": {int(b):round(float(s),4) for b,s in zip(bce,sB)},
        "Delta_A": {int(b):round(float(d),4) for b,d in zip(bce,dA)},
        "Delta_B": {int(b):round(float(d),4) for b,d in zip(bce,dB)},
        "mean_Delta_A": round(float(dA[1:].mean()),4),
        "mean_Delta_B": round(float(dB[1:].mean()),4),
        "std_PC1_A": round(float(sdA),4),
        "std_PC1_B": round(float(sdB),4),
        "loadings_A_post_convention": {n: round(float(v),4) for n,v in zip(Z_COLS, wA)},
        "loadings_B_post_convention": {n: round(float(v),4) for n,v in zip(Z_COLS, wB)},
        "bootstrap": {
            "n_reps": 400,
            "mean_Delta_bar": round(float(boot.mean()),4),
            "median_Delta_bar": round(float(np.median(boot)),4),
            "ci95_low": round(float(np.percentile(boot,2.5)),4),
            "ci95_high": round(float(np.percentile(boot,97.5)),4),
            "ci_excludes_zero": bool((np.percentile(boot,2.5)>0) or (np.percentile(boot,97.5)<0)),
        }
    }
    os.makedirs('artifacts/analysis', exist_ok=True)
    with open('artifacts/analysis/results.json','w') as f:
        json.dump(out, f, indent=2, ensure_ascii=False)
    print(json.dumps(out, indent=2, ensure_ascii=False))

if __name__ == '__main__':
    main()
