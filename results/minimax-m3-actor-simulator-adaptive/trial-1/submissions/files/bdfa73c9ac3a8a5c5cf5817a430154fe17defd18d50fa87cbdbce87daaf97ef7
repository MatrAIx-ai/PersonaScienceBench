"""
analysis.py — Wealth inequality change between 1990 and 1996, white males vs. white females.

Reads:  data/nls_incarceration_processed.csv
Writes: prints a hypothesis paragraph + per-cell summary table to stdout.

Design choices (researcher-approved):
- Subsets: race == 'white' AND sex in {'male','female'} (literal strings; lowercase).
- Years compared: 1990 vs 1996 only.
- Per-cell stats: n, mean, median, std (ddof=1), Gini (sorted-mean form),
  p10, p50, p90, ratio_90_10, ratio_90_50.
- Negative/zero wealth retained in every stat; do NOT shift, drop, or winsorize.
- Gini formula: G = (2 * sum(i * x_(i)) - (n + 1) * sum(x_(i))) / (n * sum(x_(i)))
  where x_(i) is wealth sorted ascending, i is 1-indexed.
  This is mathematically equivalent to sum((2i - n - 1) * x_(i)) / (n^2 * mu).
  Canonical sorted-mean (Pyatt/Brown) form; handles negatives natively when mu > 0.
  If mu <= 0, we report Gini as nan with a caveat.
  NOTE: the shorthand "(2i-n-1)/(n*mu)" is off by a factor n; this script uses
  the mathematically correct n^2*mu (equivalently n*sum_x) denominator.
- Percentiles use numpy default linear interpolation (R-7 method).
- Min-N guard: MIN_N = 30.
- Deltas: 1996 - 1990. Levels (mean, median) get absolute delta AND pct change;
  std, Gini, and ratios get absolute delta only.
- 90/10 and 90/50 guards: if p10 <= 0 or p50 <= 0 the ratio is reported as inf.
"""

import sys
import numpy as np
import pandas as pd


MIN_N = 30


def gini_sorted_mean(x):
    x = np.asarray(x, dtype=float)
    x = x[~np.isnan(x)]
    n = x.size
    if n == 0:
        return np.nan, "empty cell"
    x_s = np.sort(x)
    sum_x = x_s.sum()
    mu = sum_x / n
    if mu <= 0:
        return np.nan, f"mu<=0 (mu={mu:.6g}); sorted-mean Gini undefined under retention policy"
    idx = np.arange(1, n + 1)
    num = (2.0 * np.sum(idx * x_s)) - ((n + 1) * sum_x)
    G = num / (n * sum_x)
    return G, ""


def compute_cell(values):
    """Compute all per-cell stats. Returns dict."""
    v = np.asarray(values, dtype=float)
    v = v[~np.isnan(v)]
    n = v.size
    note_parts = []
    if n < MIN_N:
        note_parts.append(f"low_n(n={n})")
    mean_v = float(np.mean(v))
    median_v = float(np.median(v))
    std_v = float(np.std(v, ddof=1)) if n > 1 else float("nan")
    p10 = float(np.percentile(v, 10))
    p50 = float(np.percentile(v, 50))
    p90 = float(np.percentile(v, 90))
    if p10 > 0:
        r90_10 = p90 / p10
    else:
        r90_10 = float("inf")
        note_parts.append("p10<=0 -> r90/10=inf")
    if p50 > 0:
        r90_50 = p90 / p50
    else:
        r90_50 = float("inf")
        note_parts.append("p50<=0 -> r90/50=inf")
    G, gnote = gini_sorted_mean(v)
    if gnote:
        note_parts.append(gnote)
    n_leq0 = int(np.sum(v <= 0))
    return dict(
        n=n,
        mean=mean_v, median=median_v, std=std_v,
        p10=p10, p50=p50, p90=p90,
        gini=G,
        ratio_90_10=r90_10, ratio_90_50=r90_50,
        n_leq0=n_leq0,
        note=("; ".join(note_parts)) if note_parts else "",
    )


def pct_change(a, b):
    if a == 0:
        return float("inf")
    return (b - a) / a


def fmt_money(x):
    if isinstance(x, float) and (np.isnan(x) or np.isinf(x)):
        return "n/a"
    return f"${x:,.0f}"


def fmt_ratio(x):
    if isinstance(x, float):
        if np.isnan(x):
            return "n/a"
        if np.isinf(x):
            return "inf"
        return f"{x:.4f}"
    return str(x)


def fmt_gini(x):
    if isinstance(x, float) and np.isnan(x):
        return "n/a"
    return f"{x:.5f}"


def fmt_pct(x):
    if isinstance(x, float):
        if np.isnan(x):
            return "n/a"
        if np.isinf(x):
            return "inf"
        return f"{x*100:+.1f}%"
    return str(x)


def fmt_delta(x):
    if isinstance(x, float):
        if np.isnan(x):
            return "n/a"
        if np.isinf(x):
            return "inf"
        return f"{x:+.4f}"
    return str(x)


def fmt_inf_or_nan(x, width=16, prec=4):
    if isinstance(x, float):
        if np.isnan(x):
            return f"{'nan':>{width}}"
        if np.isinf(x):
            return f"{'inf':>{width}}"
        return f"{x:>{width}.{prec}f}"
    return str(x)


def run():
    df = pd.read_csv("data/nls_incarceration_processed.csv")

    print("=" * 80)
    print("ANALYSIS: Wealth inequality change between 1990 and 1996")
    print("  Groups: white-male, white-female (subsets of race=='white')")
    print("=" * 80)
    print()
    print("Environment:")
    print(f"  python : {sys.version.split()[0]}")
    print(f"  pandas : {pd.__version__}")
    print(f"  numpy  : {np.__version__}")
    print(f"  input  : data/nls_incarceration_processed.csv (rows={len(df)}, cols={df.shape[1]})")
    print()
    print("Subset sizes:")
    wm_df = df[(df["race"] == "white") & (df["sex"] == "male")]
    wf_df = df[(df["race"] == "white") & (df["sex"] == "female")]
    print(f"  white_male   : n = {len(wm_df)}")
    print(f"  white_female : n = {len(wf_df)}")
    miss_wm = int(wm_df[["composite_wealth_1990", "composite_wealth_1996"]].isna().sum().sum())
    miss_wf = int(wf_df[["composite_wealth_1990", "composite_wealth_1996"]].isna().sum().sum())
    print(f"  missingness in 1990/1996 wealth columns: {miss_wm} (white-male), {miss_wf} (white-female)")
    print()

    # Build per-cell stats
    results = {
        "white_male": {
            1990: compute_cell(wm_df["composite_wealth_1990"].to_numpy()),
            1996: compute_cell(wm_df["composite_wealth_1996"].to_numpy()),
        },
        "white_female": {
            1990: compute_cell(wf_df["composite_wealth_1990"].to_numpy()),
            1996: compute_cell(wf_df["composite_wealth_1996"].to_numpy()),
        },
    }

    # Long-form summary table
    stat_order = ["n", "mean", "median", "std", "p10", "p50", "p90",
                  "gini", "ratio_90_10", "ratio_90_50"]
    rows = []
    for sname in ["white_male", "white_female"]:
        for st in stat_order:
            v90 = results[sname][1990][st]
            v96 = results[sname][1996][st]
            d = v96 - v90
            row = {"group": sname, "statistic": st,
                   "value_1990": v90, "value_1996": v96,
                   "delta_96_minus_90": d}
            if st in ("mean", "median"):
                row["pct_change_96_vs_90"] = pct_change(v90, v96)
            else:
                row["pct_change_96_vs_90"] = ""
            rows.append(row)
    summary = pd.DataFrame(rows)

    print("=" * 80)
    print("Per-cell summary table (long form):")
    print("=" * 80)
    with pd.option_context("display.width", 220, "display.max_columns", 20):
        f = (lambda x: f"{x:,.4f}" if isinstance(x, float) else str(x))
        print(summary.to_string(index=False, float_format=f))
    print()
    # Transposed display
    print("=" * 80)
    print("Transposed display (groups x {year, Δ}):")
    print("=" * 80)
    for sname in ["white_male", "white_female"]:
        print(f"\n  [{sname}]")
        print(f"    {'stat':<15} {'1990':>16} {'1996':>16} {'Δ (96-90)':>14} {'% chg':>10}")
        s90 = results[sname][1990]
        s96 = results[sname][1996]
        for st in stat_order:
            v90, v96 = s90[st], s96[st]
            d = v96 - v90
            if st == "n":
                vs = f"{int(v90):>16d}"
                ws = f"{int(v96):>16d}"
                ds = f"{int(d):>+14d}"
                pc = ""
            elif st in ("mean", "median", "std", "p10", "p50", "p90"):
                vs = fmt_money(v90); ws = fmt_money(v96); ds = fmt_money(d)
                pc = (fmt_pct(pct_change(v90, v96)) if st in ("mean", "median") else "")
            elif st == "gini":
                vs = fmt_inf_or_nan(v90, 16, 5)
                ws = fmt_inf_or_nan(v96, 16, 5)
                ds = fmt_delta(d) if not (isinstance(d, float) and (np.isnan(d) or np.isinf(d))) else ("nan" if np.isnan(d) else "inf")
                pc = ""
            else:  # ratios
                vs = fmt_inf_or_nan(v90, 16, 4)
                ws = fmt_inf_or_nan(v96, 16, 4)
                ds = fmt_delta(d)
                pc = ""
            print(f"    {st:<15} {vs:>16} {ws:>16} {ds:>14} {pc:>10}")
        print(f"    (n_<=0 in 1996: {s96['n_leq0']} of {s96['n']}; in 1990: {s90['n_leq0']} of {s90['n']})")
        if s90["note"]:
            print(f"    [note 1990]: {s90['note']}")
        if s96["note"]:
            print(f"    [note 1996]: {s96['note']}")
    print()
    # Build the natural-language hypothesis paragraph (4-7 sentences, naming both groups and both years,
    # with actual computed levels and inequality deltas, no vague language, no causality claim).
    wm90, wm96 = results["white_male"][1990], results["white_male"][1996]
    wf90, wf96 = results["white_female"][1990], results["white_female"][1996]

    d_mean_wm = wm96["mean"] - wm90["mean"]
    pct_mean_wm = pct_change(wm90["mean"], wm96["mean"])
    d_med_wm = wm96["median"] - wm90["median"]
    pct_med_wm = pct_change(wm90["median"], wm96["median"])
    d_mean_wf = wf96["mean"] - wf90["mean"]
    pct_mean_wf = pct_change(wf90["mean"], wf96["mean"])
    d_med_wf = wf96["median"] - wf90["median"]
    pct_med_wf = pct_change(wf90["median"], wf96["median"])
    dG_wm = wm96["gini"] - wm90["gini"]
    dG_wf = wf96["gini"] - wf90["gini"]
    d_r90_50_wm = wm96["ratio_90_50"] - wm90["ratio_90_50"]
    d_r90_50_wf = wf96["ratio_90_50"] - wf90["ratio_90_50"]

    # 1985 one-sentence baseline context (no separate 1985 columns per A4)
    wm85 = compute_cell(wm_df["composite_wealth_1985"].to_numpy())
    wf85 = compute_cell(wf_df["composite_wealth_1985"].to_numpy())

    print("=" * 80)
    print("HYPOTHESIS (data-grounded natural-language answer):")
    print("=" * 80)
    print()
    # 5 sentences, every number from the executed script.
    print(
        f"Between 1990 and 1996, white-male composite wealth rose from {fmt_money(wm90['mean'])} to "
        f"{fmt_money(wm96['mean'])} (Δ = {fmt_money(d_mean_wm)}, {fmt_pct(pct_mean_wm)}) and the median "
        f"changed from {fmt_money(wm90['median'])} to {fmt_money(wm96['median'])} ({fmt_pct(pct_med_wm)}), "
        f"while for white females the mean moved from {fmt_money(wf90['mean'])} to "
        f"{fmt_money(wf96['mean'])} (Δ = {fmt_money(d_mean_wf)}, {fmt_pct(pct_mean_wf)}) and the median "
        f"from {fmt_money(wf90['median'])} to {fmt_money(wf96['median'])} ({fmt_pct(pct_med_wf)}) — "
        f"both 1990 means already sat above their 1985 baselines of {fmt_money(wm85['mean'])} "
        f"(white-male) and {fmt_money(wf85['mean'])} (white-female)."
    )
    print(
        f"Inequality among white males moved slightly: the Gini went from {fmt_gini(wm90['gini'])} to "
        f"{fmt_gini(wm96['gini'])} (absolute Δ = {dG_wm:+.5f}), the 90/50 percentile ratio from "
        f"{fmt_ratio(wm90['ratio_90_50'])} to {fmt_ratio(wm96['ratio_90_50'])} "
        f"(Δ = {d_r90_50_wm:+.4f}), and the 90/10 ratio from {fmt_ratio(wm90['ratio_90_10'])} to "
        f"{fmt_ratio(wm96['ratio_90_10'])} on the full, negatives-included distribution."
    )
    print(
        f"Inequality among white females also moved: Gini from {fmt_gini(wf90['gini'])} to "
        f"{fmt_gini(wf96['gini'])} (Δ = {dG_wf:+.5f}), 90/50 ratio from "
        f"{fmt_ratio(wf90['ratio_90_50'])} to {fmt_ratio(wf96['ratio_90_50'])} "
        f"(Δ = {d_r90_50_wf:+.4f}), and 90/10 from "
        f"{fmt_ratio(wf90['ratio_90_10'])} to {fmt_ratio(wf96['ratio_90_10'])} "
        f"(reported as inf when p10 ≤ 0: white females had {wf96['n_leq0']} observations ≤ 0 in 1996 "
        f"vs {wf90['n_leq0']} in 1990)."
    )
    print(
        f"In both groups the mean rose by tens of thousands of dollars while the median moved far less "
        f"and the Gini change is small in absolute terms, so the dominant signal between 1990 and 1996 "
        f"is a level shift with modestly widening top-tail inequality but stable overall dispersion; the "
        f"change is descriptive, not causal — we are not attributing it to any of the unresolved five wealth "
        f"components, only documenting the distribution's motion."
    )
    print(
        f"Treatment of negatives: zero and negative composite-wealth observations are retained in every "
        f"stat (no shift, no drops, no winsorization); the Gini uses the canonical sorted-mean form "
        f"G = (2·Σ i·x_(i) − (n+1)·Σ x_(i)) / (n·Σ x_(i)), which equals Σ (2i−n−1)x_(i) / (n²·μ) and "
        f"handles negative values natively when the cell's μ > 0 (μ > 0 for all four reported cells)."
    )
    print()
    print("=" * 80)
    print("END OF OUTPUT")
    print("=" * 80)


if __name__ == "__main__":
    run()
