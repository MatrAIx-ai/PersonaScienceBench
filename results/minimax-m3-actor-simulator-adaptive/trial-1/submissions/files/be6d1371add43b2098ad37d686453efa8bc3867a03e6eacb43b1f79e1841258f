"""Initial inspection of the three datasets.

Captures: file shape, key column dtypes, null coverage, CE/BCE range,
and per-century Pottery Form / Decoration Z-values.
"""
import pandas as pd, numpy as np, os, json

DATA = "/workspace/data"
out = {}

# -------- 1. pollen ----------
pol = pd.read_csv(f"{DATA}/pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv")
out["pollen"] = {
    "rows": len(pol), "cols": list(pol.columns),
    "CE_min": int(pol["CE"].min()), "CE_max": int(pol["CE"].max()),
    "calBP_min": int(pol["calBP"].min()), "calBP_max": int(pol["calBP"].max()),
    "CE_nulls": int(pol["CE"].isna().sum()),
    # NB numeric columns are comma-decimal STRINGS (German format); range not reported here
}

# -------- 2. time_series ----------
ts = pd.read_csv(f"{DATA}/time_series_data.csv").sort_values("CE").reset_index(drop=True)
ts_ir = ts[ts["PotteryForm"].notna()][["CE","calBP","PotteryForm","PotteryDecoration"]].copy()
out["time_series"] = {
    "rows": len(ts), "cols": list(ts.columns),
    "CE_min": int(ts["CE"].min()), "CE_max": int(ts["CE"].max()),
    "calBP_min": int(ts["calBP"].min()), "calBP_max": int(ts["calBP"].max()),
    "PotteryForm_raw_non_null": int(ts["PotteryForm"].notna().sum()),
    "PotteryForm_inter_non_null": int(ts["PotteryForm_inter"].notna().sum()),
    "PotteryDecoration_raw_non_null": int(ts["PotteryDecoration"].notna().sum()),
    "PotteryDecoration_inter_non_null": int(ts["PotteryDecoration_inter"].notna().sum()),
    "PotteryForm_min": float(ts["PotteryForm"].min()),
    "PotteryForm_max": float(ts["PotteryForm"].max()),
    "PotteryDecoration_min": float(ts["PotteryDecoration"].min()),
    "PotteryDecoration_max": float(ts["PotteryDecoration"].max()),
    "raw_century_anchors_first5": ts_ir["CE"].drop_duplicates().sort_values().head(5).tolist(),
    "raw_century_anchors_last5":  ts_ir["CE"].drop_duplicates().sort_values().tail(5).tolist(),
    "unique_CE_count": int(ts["CE"].nunique()),
}

# -------- 3. capital ----------
cap = pd.read_csv(f"{DATA}/capital.csv", decimal=",")
out["capital"] = {
    "rows": len(cap), "cols": list(cap.columns),
    "BCE_min": int(cap["BCE"].min()), "BCE_max": int(cap["BCE"].max()),
    "ZKeform_min": float(cap["ZKeform"].min()),
    "ZKeform_max": float(cap["ZKeform"].max()),
    "Zkeverz_min": float(cap["Zkeverz"].min()),
    "Zkeverz_max": float(cap["Zkeverz"].max()),
    "n_100yr_bins": int(len(cap)),
}

print(json.dumps(out, indent=2))
