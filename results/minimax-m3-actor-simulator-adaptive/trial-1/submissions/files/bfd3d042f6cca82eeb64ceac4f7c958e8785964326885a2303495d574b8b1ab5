# ------------------- Per-habitat metrics -------------------
def agg_habitat(g):
    out = {
        "n_plots"      : len(g),
        "n_plots_inv"  : int((g["n.total"] >= 1).sum()),
        "n_plots_gard" : int((g["n.gard"]  >= 1).sum()),
        "n_plots_unint": int((g["n.unint"] >= 1).sum()),
        "n_plots_agfo" : int((g["n.agfo"]  >= 1).sum()),
        "sum_gard"     : int(g["n.gard"].sum()),
        "sum_unint"    : int(g["n.unint"].sum()),
        "sum_agfo"     : int(g["n.agfo"].sum()),
        "sum_total"    : int(g["n.total"].sum()),
    }
    n = out["n_plots"]; ni = max(out["sum_total"], 1)
    out["plot_prev_gard"]   = out["n_plots_gard"]/n
    out["plot_prev_unint"]  = out["n_plots_unint"]/n
    out["plot_prev_agfo"]   = out["n_plots_agfo"]/n
    out["share_gard_count"] = out["sum_gard"]/ni
    out["share_unint_count"]= out["sum_unint"]/ni
    out["share_agfo_count"] = out["sum_agfo"]/ni
    out["mean_n_gard_per_plot"]  = out["sum_gard"]/n
    out["mean_n_unint_per_plot"] = out["sum_unint"]/n
    out["mean_n_agfo_per_plot"]  = out["sum_agfo"]/n
    return pd.Series(out)

