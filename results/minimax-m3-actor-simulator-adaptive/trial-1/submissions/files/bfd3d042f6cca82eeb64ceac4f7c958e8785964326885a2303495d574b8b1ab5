# ------------------- Bootstrap 95% CIs (stratified by habitat) -------------------
def boot_ci(dfin, B=2000, seed=11):
    rng = np.random.default_rng(seed)
    out = {}
    for h,g in dfin.groupby("habitat"):
        n = len(g); idx = np.arange(n)
        share = np.empty(B); prev = np.empty(B)
        for b in range(B):
            sel = rng.choice(idx, size=n, replace=True)
            c = g.iloc[sel]
            t = c["n.total"].sum(); s = c["n.gard"].sum()
            share[b] = s/t if t>0 else 0
            prev[b]  = (c["n.gard"]>0).mean()
        out[h] = {
            "share_ci":[float(np.percentile(share,2.5)), float(np.percentile(share,97.5))],
            "prev_ci":[float(np.percentile(prev,2.5)), float(np.percentile(prev,97.5))],
            "share_mean":float(share.mean()),"prev_mean":float(prev.mean()),
        }
    return out

