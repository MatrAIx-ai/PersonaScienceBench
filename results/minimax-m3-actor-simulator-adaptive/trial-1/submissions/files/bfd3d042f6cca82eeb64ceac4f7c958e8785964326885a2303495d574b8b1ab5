def mc_chi2(df_in, B=5000, seed=42):
    rng = np.random.default_rng(seed)
    cols = ["n.gard","n.unint","n.agfo"]
    arr = df_in[cols].to_numpy()
    H    = df_in["habitat"].to_numpy()
    habitats = np.unique(H)
    obs, _, _, _ = st.chi2_contingency(
        np.vstack([arr[H==h].sum(axis=0) for h in habitats]))
    stats_ = np.empty(B, dtype=float)
    for b in range(B):
        perm = rng.permutation(len(arr))
        tabs = np.vstack([arr[perm][H==h].sum(axis=0) for h in habitats])
        tabs = tabs[tabs.sum(axis=1) > 0]
        try:
            s, _, _, _ = st.chi2_contingency(tabs)
            stats_[b] = s
        except Exception:
            stats_[b] = np.nan
    p = (np.nan_to_num(stats_, nan=np.inf) >= obs).mean()
    return p, obs

