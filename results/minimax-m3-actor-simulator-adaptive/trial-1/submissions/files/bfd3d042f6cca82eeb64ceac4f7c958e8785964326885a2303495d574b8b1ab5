# ------------------- Pairwise 2x3 Fisher (Monte-Carlo, Bonferroni) -------------------
def fisher_2x3_mc(a, b, B=2000, seed=0):
    rng = np.random.default_rng(seed)
    tab0 = np.vstack([a, b])
    def chi2(tab):
        tr = tab.sum(axis=1, keepdims=True); tc = tab.sum(axis=0, keepdims=True)
        ex = tr @ tc / tab.sum()
        return ((tab - ex)**2 / ex).sum()
    obs = chi2(tab0)
    # Row totals fixed by adding pathway totals
    n_g = tab0[:,0].sum(); n_u = tab0[:,1].sum(); n_a = tab0[:,2].sum()
    ge = 0
    for _ in range(B):
        a_ = rng.multinomial(int(a.sum()), [n_g,n_u,n_a]/tab0.sum())
        b_ = rng.multinomial(int(b.sum()), [n_g,n_u,n_a]/tab0.sum())
        s_ = chi2(np.vstack([a_, b_]))
        if s_ >= obs - 1e-12:
            ge += 1
    return (ge + 1) / (B + 1)

