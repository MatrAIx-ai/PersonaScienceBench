# ------------------- SVG forest plots -------------------
def svg_forest(records, label, vkey, cikey, out_path, xlim=(0,1)):
    cell_w, cell_h, left = 60, 22, 200
    n = len(records); W = left + 360 + 60; H = 70 + n*cell_h
    parts = [f'<svg xmlns="http://www.w3.org/2000/svg" width="{W}" height="{H}" font-family="sans-serif" font-size="11">']
    parts.append(f'<text x="{W/2}" y="22" text-anchor="middle" font-size="13">{label}</text>')
    parts.append(f'<line x1="{left}" y1="44" x2="{left+360}" y2="44" stroke="black"/>')
    for t in [0.0,0.25,0.5,0.75,1.0]:
        x = left + 360*t
        parts.append(f'<line x1="{x}" y1="44" x2="{x}" y2="48" stroke="black"/>')
        parts.append(f'<text x="{x}" y="58" text-anchor="middle">{t:.2f}</text>')
    y = 78
    for r in records:
        v = r[vkey]; lo,hi = r[cikey]
        lo_p = max(min(lo,xlim[1]),xlim[0]); hi_p = max(min(hi,xlim[1]),xlim[0])
        x = left + 360*v; xlo = left + 360*lo_p; xhi = left + 360*hi_p
        nt = r["sum_total"]
        flag = "" if nt>4 else f' (n={nt}*)'
        parts.append(f'<text x="{left-8}" y="{y+4}" text-anchor="end">{r["habitat"]}{flag}</text>')
        parts.append(f'<line x1="{xlo}" y1="{y+4}" x2="{xhi}" y2="{y+4}" stroke="#2271b3" stroke-width="2"/>')
        parts.append(f'<line x1="{xlo}" y1="{y}" x2="{xlo}" y2="{y+8}" stroke="#2271b3" stroke-width="2"/>')
        parts.append(f'<line x1="{xhi}" y1="{y}" x2="{xhi}" y2="{y+8}" stroke="#2271b3" stroke-width="2"/>')
        parts.append(f'<circle cx="{x}" cy="{y+4}" r="3" fill="#d62728"/>')
        parts.append(f'<text x="{left+365}" y="{y+4}">{v:.3f}</text>')
        y += cell_h
    parts.append('</svg>')
    open(out_path,"w").write("\n".join(parts))

