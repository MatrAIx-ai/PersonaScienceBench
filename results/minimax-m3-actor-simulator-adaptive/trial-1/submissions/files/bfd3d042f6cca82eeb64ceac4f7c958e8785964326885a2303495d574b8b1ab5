def inferred_habitat(row):
    hr=row["habitat.range"]; nb=row["invaded.niche.breadth"]
    gf=row["growth.form"]; dis=row["dispersal"]
    if hr>=3 and nb>=0.9:
        return "wide-niche (consistent with the high-prev Urban/Riparian plot pattern)"
    if gf=="Shrub/tree" and dis=="Wind":
        return "tree/wind-dispersed (Urban/Riparian/Croplands consistent)"
    if gf=="Perennial fg" and dis in ("Wind","Unspecific"):
        return "perennial forb (Riparian/Meadows consistent)"
    return "moderate-niche"
