    b = per_hab.drop(h)[["sum_gard","sum_unint","sum_agfo"]].values.sum(axis=0)
    focal = a[0]/a.sum() if a.sum() else float("nan")
    rest  = b[0]/b.sum() if b.sum() else float("nan")
    direction = "higher" if focal>rest+1e-9 else ("lower" if focal<rest-1e-9 else "equal")
    p = fisher_2x3_mc(a, b, B=2000, seed=1000+i)
    pairwise.append({"habitat":h,"focal_share_gard":focal,"rest_share_gard":rest,
                     "n_total_focal":int(a.sum()),"direction":direction,"p_mc":p})
