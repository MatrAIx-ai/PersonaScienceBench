# ============================================================
# Barcelona non-native plants vs urban land use
# Data-grounded hypothesis, workflow executed end-to-end
# ============================================================
import pandas as pd
import numpy as np
from scipy import stats
import statsmodels.api as sm
import json, os

DATA = "/workspace/data"

def strip_quoted(s):
    return s.strip().strip('"').strip()

# ---------- load all four assets ----------
df_tt_raw = pd.read_csv(f"{DATA}/temporal_trends_contingency_table.csv", sep="\t")
df_tt_raw.columns = [strip_quoted(c) for c in df_tt_raw.columns]
df_tt = df_tt_raw.copy()
for c in df_tt.columns:
    if df_tt[c].dtype == object:
        df_tt[c] = df_tt[c].astype(str).map(strip_quoted)
df_tt['n'] = pd.to_numeric(df_tt['n'], errors='coerce')

with open(f"{DATA}/phylogenetic_tree.txt") as f:
    tree_str = f.read().strip()

df_is = pd.read_csv(f"{DATA}/invasion_success_pathways.csv")

df_in = pd.read_csv(f"{DATA}/invaded_niche_pathways.csv", sep="\t")
df_in.columns = [strip_quoted(c) for c in df_in.columns]
for c in df_in.columns:
    if df_in[c].dtype == object:
        df_in[c] = df_in[c].astype(str).map(strip_quoted)
        try: df_in[c] = pd.to_numeric(df_in[c])
        except: pass

print(f"shapes   tt={df_tt.shape}  is={df_is.shape}  in={df_in.shape}  tree_bytes={len(tree_str)}")

# ============================================================
# (1) Per-row Spearman correlations
# ============================================================
urban_cols  = sorted([c for c in df_in.columns if c.startswith('urban.')])
crop_cols   = sorted([c for c in df_in.columns if c.startswith('cropland.')])
change_cols = ['progressive.1956.2009.50m','regressive.1956.2009.50m',
               'no.changes.1956.2009.50m','progressive.1993.2009.50m',
               'regressive.1993.2009.50m','no.changes.1993.2009.50m']
ycols_count = ['n.gard','n.unint','n.agfo','n.total']

def corr_table(df, xcols, ycols):
    rows=[]
    for y in ycols:
        for x in xcols:
            sub = df[[x,y]].dropna()
            if len(sub)<3:
                continue
            r, _ = stats.spearmanr(sub[x], sub[y])
            rows.append({"y":y,"x":x,"rho":round(float(r),3),"n":len(sub)})
    return pd.DataFrame(rows)

ct_urban_full = corr_table(df_in,    urban_cols,  ycols_count)
ct_crop_full  = corr_table(df_in,    crop_cols,   ycols_count)
ct_change     = corr_table(df_in,    change_cols, ycols_count)

# Active rows (n.total > 0)
active = df_in[df_in['n.total']>0].copy().reset_index(drop=True)
for k in ['gard','unint','agfo']:
    active[f'p_{k}'] = active[f'n.{k}']/active['n.total']
ycols_frac = ['p_gard','p_unint','p_agfo']

ct_urban_act  = corr_table(active, urban_cols, ycols_count)
ct_crop_act   = corr_table(active, crop_cols,  ycols_count)
ct_urban_frac = corr_table(active, urban_cols, ycols_frac)
ct_crop_frac  = corr_table(active, crop_cols,  ycols_frac)

# ---- wide pivots for readability ----
def pivot_corr(ct, yname):
    sub = ct[ct['y']==yname].copy()
    sub['year']   = sub['x'].str.extract(r'\.(\d{4})\.').astype(int)
    sub['buffer'] = sub['x'].str.extract(r'\.(\d+)m$').astype(int)
    return sub.pivot(index='buffer', columns='year', values='rho').round(3)

print("\n############ CORRELATIONS WITH urban.* ############")
for yname in ['n.gard','n.unint','n.agfo']:
    print(f"\n[{yname}]  rows buffer x year")
    print(pivot_corr(ct_urban_full, yname))

print("\n############ CORRELATIONS WITH cropland.* ############")
for yname in ['n.gard','n.unint','n.agfo']:
    print(f"\n[{yname}]")
    print(pivot_corr(ct_crop_full, yname))

print("\n############ DIFFERENCE (urban - cropland) ρ ############")
for yname in ['n.gard','n.unint','n.agfo']:
    diff = (pivot_corr(ct_urban_full, yname) - pivot_corr(ct_crop_full, yname)).round(3)
    print(f"\n[{yname}] Δ = ρ(urban) − ρ(cropland)")
    print(diff)

print("\n############ CHANGE-VARIABLE ρ (all 632 rows) ############")
print(ct_change.pivot_table(index='x', columns='y', values='rho').round(3))

print("\n############ ROBUSTNESS - ACTIVE ROWS (n.total>0, n=191) ############")
print("Active vs urban.2009.500m:")
for y in ycols_count + ycols_frac:
    sub = active[['urban.2009.500m', y]].dropna()
    r,_ = stats.spearmanr(sub['urban.2009.500m'], sub[y])
    print(f"  urban.2009.500m ~ {y:8s} rho={r:+.3f}  N={len(sub)}")
print("\nActive vs urban & cropland rho at 3 buffers (n.gard, n.unint, n.agfo):")
buf = '500m'
for y in ['n.gard','n.unint','n.agfo']:
    for x in ['urban','cropland']:
        r,_ = stats.spearmanr(active[f'{x}.2009.{buf}'], active[y])
        print(f"  {x}.2009.{buf} ~ {y:8s} rho={r:+.3f}")

print("\n############ FRACTION BASELINE - ACTIVE ROWS ############")
print(ct_urban_frac.pivot(columns="y", index="x", values="rho").round(3))
print(ct_crop_frac.pivot(columns="y", index="x", values="rho").round(3))

# ============================================================
# (2) Habitat-level summary
# ============================================================
hab = df_in.groupby('habitat').agg(
    rows          = ('n.total','size'),
    sum_gard      = ('n.gard','sum'),
    sum_unint     = ('n.unint','sum'),
    sum_agfo      = ('n.agfo','sum'),
    sum_total     = ('n.total','sum'),
    mean_urban2009_500m=('urban.2009.500m','mean'),
    mean_urban1956_500m=('urban.1956.500m','mean'),
    mean_crp2009_500m=('cropland.2009.500m','mean'),
    mean_progressive_1956_2009=('progressive.1956.2009.50m','mean'),
).round(3)
hab['p_gard']  = (hab['sum_gard']/hab['sum_total']).round(3)
hab['p_unint'] = (hab['sum_unint']/hab['sum_total']).round(3)
hab['p_agfo']  = (hab['sum_agfo']/hab['sum_total']).round(3)
print("\n############ HABITAT-LEVEL ############")
print(hab.to_string())

# Urban-specific row
u = hab.loc['Urban']
print(f"\nUrban class: n_rows={int(u['rows'])}, sum_total={int(u['sum_total'])}, "
      f"mean urban.2009.500m={u['mean_urban2009_500m']:.3f}, "
      f"gard={int(u['sum_gard'])} ({u['p_gard']*100:.0f}%), "
      f"unint={int(u['sum_unint'])} ({u['p_unint']*100:.0f}%), "
      f"agfo={int(u['sum_agfo'])} ({u['p_agfo']*100:.0f}%)")

# Croplands class
cr = hab.loc['Croplands']
print(f"Croplands class: n_rows={int(cr['rows'])}, sum_total={int(cr['sum_total'])}, "
      f"mean urban.2009.500m={cr['mean_urban2009_500m']:.3f}, "
      f"mean cropland.2009.500m={cr['mean_crp2009_500m']:.3f}, "
      f"gard={int(cr['sum_gard'])} ({cr['p_gard']*100:.0f}%), "
      f"unint={int(cr['sum_unint'])} ({cr['p_unint']*100:.0f}%), "
      f"agfo={int(cr['sum_agfo'])} ({cr['p_agfo']*100:.0f}%)")

# ============================================================
# (3) Temporal dynamics
# ============================================================
tt_pivot = df_tt.pivot_table(index='pathway', columns='introduction.period',
                             values='n', aggfunc='sum', fill_value=0)
tt_pivot = tt_pivot[['Before 1500','1501-1900','1901-1984','1985-2019']]
print("\n############ TEMPORAL_TRENDS CONTINGENCY ############")
print(tt_pivot.to_string())
print("\nGrowth ratio 1985-2019 / Before 1500:")
print(((tt_pivot['1985-2019']/tt_pivot['Before 1500']).round(2)).to_string())

# ============================================================
# (4) Composition robustness - quasibinomial logistic GLM (separating composition vs level)
# ============================================================
# Active rows only; per pathway k: n.k ~ Binomial(n.total, p_k),
# logit(p_k) = const + β_urban * urban.2009.500m + β_crp * cropland.2009.500m +
#              β_elev * elevation + β_temp * annual.temperature + β_road * distance.road
# freq_weights = n.total
print("\n############ COMPOSITION - QUASIBINOMIAL GLM (active rows) ############")
X = active[['urban.2009.500m','cropland.2009.500m','elevation',
            'annual.temperature','distance.road']].astype(float)
X = sm.add_constant(X)
glm_out = {}
for k in ['gard','unint','agfo']:
    y = active[f'n.{k}'].astype(float)
    ntot = active['n.total'].astype(float)
    fit = sm.GLM(y, X, family=sm.families.Binomial(), freq_weights=ntot).fit()
    coef = fit.params['urban.2009.500m']
    se   = fit.bse['urban.2009.500m']
    ci_l, ci_u = fit.conf_int().loc['urban.2009.500m'].tolist()
    crp_coef   = fit.params['cropland.2009.500m']
    crp_se     = fit.bse['cropland.2009.500m']
    print(f"\n[{k}] pseudo-R^2={fit.deviance/fit.null_deviance:.3f}, "
          f"n_obs={int(ntot.sum())}")
    print(f"  coef urban.2009.500m = {coef:+.3f} (SE {se:.3f}), 95% CI [{ci_l:+.3f}, {ci_u:+.3f}]")
    print(f"  coef cropland.2009.500m = {crp_coef:+.3f} (SE {crp_se:.3f})")
    glm_out[k] = {'urban_coef':float(coef),'urban_se':float(se),
                  'urban_ci':[float(ci_l),float(ci_u)],
                  'crp_coef':float(crp_coef),'crp_se':float(crp_se)}

# ALSO: at plot level (all 632 rows)
print("\n-- Same on all 632 rows (binomial: indicator n.k > 0) --")
Xfull = df_in[['urban.2009.500m','cropland.2009.500m','elevation',
               'annual.temperature','distance.road']].astype(float)
Xfull = sm.add_constant(Xfull)
for k in ['gard','unint','agfo']:
    y = (df_in[f'n.{k}']>0).astype(float)
    fit = sm.GLM(y, Xfull, family=sm.families.Binomial()).fit()
    coef = fit.params['urban.2009.500m']
    se   = fit.bse['urban.2009.500m']
    print(f"  Pr(n.{k}>0) ~ urban.2009.500m: coeff={coef:+.3f}  SE={se:.3f}")

# Save numeric outputs for the writeup
results = {
    "rho_urban_full": ct_urban_full.to_dict('records'),
    "rho_crop_full":  ct_crop_full.to_dict('records'),
    "rho_urban_active_counts": ct_urban_act.to_dict('records'),
    "rho_urban_active_fractions": ct_urban_frac.to_dict('records'),
    "rho_change": ct_change.to_dict('records'),
    "habitat_summary": hab.reset_index().to_dict('records'),
    "temporal_pivot": tt_pivot.to_dict(),
    "glm_active": glm_out,
    "key": {
        "gard_urban09_500m_rho":   ct_urban_full.query("y=='n.gard'  and x=='urban.2009.500m'")['rho'].iloc[0],
        "unint_urban09_500m_rho":  ct_urban_full.query("y=='n.unint' and x=='urban.2009.500m'")['rho'].iloc[0],
        "agfo_urban09_500m_rho":   ct_urban_full.query("y=='n.agfo'  and x=='urban.2009.500m'")['rho'].iloc[0],
        "gard_crop09_500m_rho":    ct_crop_full.query("y=='n.gard'  and x=='cropland.2009.500m'")['rho'].iloc[0],
        "unint_crop09_500m_rho":   ct_crop_full.query("y=='n.unint' and x=='cropland.2009.500m'")['rho'].iloc[0],
        "agfo_crop09_500m_rho":    ct_crop_full.query("y=='n.agfo'  and x=='cropland.2009.500m'")['rho'].iloc[0],
    }
}
with open("/workspace/analysis_results.json","w") as f:
    json.dump(results,f,default=str,indent=2)
print("\nSaved /workspace/analysis_results.json")
