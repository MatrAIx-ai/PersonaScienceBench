"""
Main analysis: proportion of original Experimental Economics studies conducted in a lab setting.
Inputs:
  data/meta-regression_study_data_heterogeneity_in_replication_projects.csv  (wide)
  data/meta-regression_replication_success_data_heterogeneity_in_replication_projects.csv  (aggregated)
Outputs:
  artifacts/ee_lab_breakdown.csv     — per-EE-study breakdown with proxy flags
  printed summary used for the result handoff
"""
import pandas as pd
from pathlib import Path

WS = Path('/workspace')
WIDE = WS / 'data' / 'meta-regression_study_data_heterogeneity_in_replication_projects.csv'
AGG  = WS / 'data' / 'meta-regression_replication_success_data_heterogeneity_in_replication_projects.csv'
OUT  = WS / 'artifacts' / 'ee_lab_breakdown.csv'

df = pd.read_csv(WIDE)
df2 = pd.read_csv(AGG)

# ---------- 1) Denominator ----------
ee = df[df['project'] == 'ee'].copy()
ee_uniq = ee.drop_duplicates(subset=['id']).copy()
print('[1] EE subset before any filtering: rows =', len(ee), ' unique id =', ee['id'].nunique())

# Apply: id dedupe (already unique), effect_size.o non-null, drop == False
mask = ee_uniq['effect_size.o'].notna() & (ee_uniq['drop'] == False)
ee_den = ee_uniq[mask].copy()
N = len(ee_den)
print(f'[1] After dedupe by id + effect_size.o non-null + drop==False : N = {N}')
print('    effect_size.o non-null in EE:', ee_uniq['effect_size.o'].notna().sum(),
      ' drop==False in EE:', (ee_uniq['drop'] == False).sum())

# ---------- 2) Proxy A: lab = subjects.o == students AND online.o == 0 ----------
proxy_A = (ee_den['subjects.o'] == 'students') & (ee_den['online.o'] == 0)
kA = int(proxy_A.sum())
print(f'[2] Proxy A (students ∧ offline): k = {kA}, proportion = {kA}/{N} = {kA/N:.6f} = {100*kA/N:.1f}%')

# ---------- 3) Sensitivities ----------
proxy_B = (ee_den['online.o'] == 0)                              # offline only
proxy_C = (ee_den['us_lab.o'] == 1)                              # US-lab only
proxy_D = proxy_A & proxy_C                                       # students ∧ offline ∧ US-lab
proxy_E = (ee_den['subjects.o'] == 'community')                   # community-sample (anti-lab)

print(f'[3] Proxy B (offline only):               k = {int(proxy_B.sum())}, prop = {int(proxy_B.sum())/N:.6f} = {100*proxy_B.sum()/N:.1f}%')
print(f'[3] Proxy C (us_lab.o == 1):              k = {int(proxy_C.sum())}, prop = {int(proxy_C.sum())/N:.6f} = {100*proxy_C.sum()/N:.1f}%')
print(f'[3] Proxy D (A ∧ us_lab.o == 1):          k = {int(proxy_D.sum())}, prop = {int(proxy_D.sum())/N:.6f} = {100*proxy_D.sum()/N:.1f}%')
print(f'[3] Proxy E (subjects.o == community):    k = {int(proxy_E.sum())} (anti-lab sanity check; the 1 case is ee.4 Participation)')

# Cross-tab: country × us_lab.o
print()
print('[3-F] experiment_country.o × us_lab.o cross-tab (EE, post-dedupe):')
ct = pd.crosstab(ee_den['experiment_country.o'], ee_den['us_lab.o'], margins=True)
print(ct.to_string())
print()
# us_lab.o == 0 cases: what country / subjects.o / online.o / compensation.o do they have?
no_us_lab = ee_den[ee_den['us_lab.o'] == 0]
print(f'[3-F] us_lab.o == 0 cases (n = {len(no_us_lab)}):')
print(no_us_lab[['id','title','subjects.o','online.o','experiment_country.o','experiment_language.o','compensation.o']].to_string(index=False))

# ---------- 4) Cross-check with aggregated table ----------
print()
print('[4] Aggregated table EE rows =', (df2['project'] == 'Experimental Economics').sum())
print('    Both files report EE = 18: consistent.')
print('    Aggregated columns =', list(df2.columns))
print('    -> no online.o / subjects.o / us_lab.o -> not used for the lab proportion calculation.')

# ---------- 5) Build and save per-study descriptive table ----------
breakdown = ee_den[['id','title','subjects.o','online.o','us_lab.o','experiment_country.o',
                    'experiment_language.o','compensation.o','effect_size.o']].copy()
breakdown['proxy_A_lab_students_offline'] = proxy_A.astype(int)
breakdown['proxy_B_offline_only']         = proxy_B.astype(int)
breakdown['proxy_C_us_lab_only']          = proxy_C.astype(int)
breakdown['proxy_D_A_and_US_lab']         = proxy_D.astype(int)
breakdown = breakdown.sort_values('id').reset_index(drop=True)
breakdown.to_csv(OUT, index=False)
print()
print(f'[5] Wrote per-EE-study breakdown with proxy flags to {OUT}')
print('    rows =', len(breakdown))
print()
print('--- EE breakdown (full table) ---')
print(breakdown.to_string(index=False))

# ---------- 6) Final headline ----------
print()
print('=' * 60)
print(f'HEADLINE: lab proportion in Experimental Economics = {kA}/{N} = {100*kA/N:.1f}%')
print('=' * 60)
