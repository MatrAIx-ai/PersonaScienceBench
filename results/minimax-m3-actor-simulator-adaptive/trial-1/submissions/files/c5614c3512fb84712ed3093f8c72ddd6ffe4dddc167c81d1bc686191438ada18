# ---------- (G) PGLS sanity check ----------
print('\n=== (G) PGLS sanity check ===')
# Drop the 4 '2'-suffix duplicate taxa from the tree and from sp_df before species-level analysis
def base_label(t):
    if t.endswith('ficus-indica2'):
        return 'Opuntia_ficus-indica'  # canonical name
    if t.endswith('2') and any(t.startswith(p) for p in ['Eucalyptus_camaldulensis','Oxalis_debilis','Populus_deltoides']):
        return t[:-1]
    return t
sp_df['phylo_base'] = sp_df['phylo.tip.label'].apply(base_label)
