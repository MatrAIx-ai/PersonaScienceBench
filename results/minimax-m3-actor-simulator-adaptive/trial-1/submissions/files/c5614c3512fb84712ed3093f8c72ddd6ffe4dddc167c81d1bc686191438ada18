            try:
                fit = sm.GLM(y, X, family=sm.families.NegativeBinomial(alpha=0.5)).fit(
                    cov_type='cluster', cov_kwds={'groups': plot_full['habitat']}, maxiter=200)
                ck = f'z_logit_urban_{yyyy}_{buf}'
                res_clust.append({'year':yyyy,'buffer_m':buf,'response':resp,
                                  'urban_coef':fit.params[ck],'urban_se':fit.bse[ck],
                                  'urban_z':fit.tvalues[ck],'urban_p':fit.pvalues[ck],
                                  'cropland_coef':fit.params[f'z_logit_cropland_{yyyy}_{buf}'],
                                  'cropland_p':fit.pvalues[f'z_logit_cropland_{yyyy}_{buf}']})
            except Exception as e:
                res_clust.append({'year':yyyy,'buffer_m':buf,'response':resp,'error':str(e)})
res_clust_df = pd.DataFrame(res_clust)
print(res_clust_df.round(4).to_string())
res_clust_df.to_csv(f'{OUT}/table_per_pathway_nbs_cluster.csv', index=False)

# ---------- (C) Habitat pattern ----------
print('\n=== (C) Habitat-level pattern across pathways + urban exposure ===')
def frac_gard_of_pathway_sum(g):
    sub = g[g['n.total']>0]
    total_sum = sub[['n.gard','n.unint','n.agfo']].sum().sum()
    return 0.0 if total_sum==0 else sub['n.gard'].sum()/total_sum

hab_summary = plot_full.groupby('habitat').agg(
    n=('n.total','size'),
    mean_gard=('n.gard','mean'),
    mean_unint=('n.unint','mean'),
    mean_agfo=('n.agfo','mean'),
    mean_total=('n.total','mean'),
    mean_urban_2009_50m=('urban.2009.50m','mean'),
    mean_urban_2009_500m=('urban.2009.500m','mean'),
    mean_urban_2009_1000m=('urban.2009.1000m','mean'),
)
hab_summary['gard_share_in_nonzero_mix'] = plot_full.groupby('habitat').apply(frac_gard_of_pathway_sum)
print(hab_summary.round(3).to_string())
hab_summary.reset_index().to_csv(f'{OUT}/table_hab_summary.csv', index=False)

