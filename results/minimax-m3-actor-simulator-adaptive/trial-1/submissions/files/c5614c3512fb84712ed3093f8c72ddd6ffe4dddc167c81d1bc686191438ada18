def logit(p, eps=1e-4):
    p = np.clip(p, eps, 1-eps)
    return np.log(p/(1-p))

# Apply logit to urban and cropland
years = [1956, 1993, 2009]
buffers = [50, 500, 1000]
for y in years:
    for b in buffers:
        for kind in ('urban', 'cropland'):
            col = f'{kind}.{y}.{b}m'
            plot_df[f'logit_{kind}_{y}_{b}'] = logit(plot_df[col].values)

# Standardize covariates
zcov = ['elevation','distance.stream','distance.road','annual.temperature','annual.rainfall','annual.radiation']
zcov += [f'logit_urban_{y}_{b}'  for y in years for b in buffers]
zcov += [f'logit_cropland_{y}_{b}' for y in years for b in buffers]
zcov += ['progressive.1956.2009.50m','regressive.1956.2009.50m','progressive.1993.2009.50m','regressive.1993.2009.50m']
mu = plot_df[zcov].mean(); sd = plot_df[zcov].std().replace(0,1)
for c in zcov:
    plot_df[f'z_{c}'] = (plot_df[c] - mu[c]) / sd[c]

# Habitat dummies (reference=Urban)
hab_dummies = pd.get_dummies(plot_df['habitat'], prefix='hab', drop_first=False).astype(float)
ref_hab = 'hab_Urban'
hab_cols_X = sorted([c for c in hab_dummies.columns if c != ref_hab])
plot_full = pd.concat([plot_df, hab_dummies[hab_cols_X]], axis=1)

def get_design(yyyy, buf):
    cols = [f'z_logit_urban_{yyyy}_{buf}', f'z_logit_cropland_{yyyy}_{buf}',
            'z_elevation','z_distance.stream','z_distance.road',
            'z_annual.temperature','z_annual.rainfall','z_annual.radiation'] + hab_cols_X
    X = sm.add_constant(plot_full[cols], has_constant='add')
    return X, cols

print('=== ZERO PROFILE ===')
for c in ['n.gard','n.unint','n.agfo','n.total']:
    zr = (plot_full[c]==0).mean()*100
    print(f"{c}: zero%={zr:.1f} mean={plot_full[c].mean():.3f} max={plot_full[c].max()}")
assert (plot_full['n.total']-plot_full['n.gard']-plot_full['n.unint']-plot_full['n.agfo']).abs().max()==0
print('n.total == n.gard+n.unint+n.agfo verified')

# ---------- (A) NB-GLM per pathway × year × buffer ----------
print('\n=== (A) NB-GLM per pathway × year × buffer ===')
results_table = []
for yyyy in years:
    for buf in buffers:
        X, cols = get_design(yyyy, buf)
        for resp in ['n.gard','n.unint','n.agfo']:
            y = plot_full[resp].astype(int)
            try:
                fit = sm.GLM(y, X, family=sm.families.NegativeBinomial(alpha=0.5)).fit(maxiter=200)
                ck = f'z_logit_urban_{yyyy}_{buf}'
                results_table.append({'year':yyyy,'buffer_m':buf,'response':resp,
                                      'urban_coef':fit.params[ck],'urban_se':fit.bse[ck],
                                      'urban_z':fit.tvalues[ck],'urban_p':fit.pvalues[ck],
                                      'cropland_coef':fit.params[f'z_logit_cropland_{yyyy}_{buf}'],
                                      'cropland_p':fit.pvalues[f'z_logit_cropland_{yyyy}_{buf}'],
                                      'aic':fit.aic})
            except Exception as e:
                results_table.append({'year':yyyy,'buffer_m':buf,'response':resp,'error':str(e)})

res_df = pd.DataFrame(results_table)
pd.set_option('display.width', 160); pd.set_option('display.max_columns', 30)
print(res_df.round(4).to_string())
res_df.to_csv(f'{OUT}/table_per_pathway_nbs.csv', index=False)

# ---------- (B) Partial Spearman correlations ----------
print('\n=== (B) Spearman partial-correlation (urban | cropland → response) ===')
def partial_spearman(u, c, y):
    ru = pd.Series(u).rank(); rc = pd.Series(c).rank(); ry = pd.Series(y).rank()
    bu = np.polyfit(rc, ru, 1)[0]; ru_res = ru - (bu*rc + (ru.mean()-bu*rc.mean()))
    by = np.polyfit(rc, ry, 1)[0]; ry_res = ry - (by*rc + (ry.mean()-by*rc.mean()))
    return stats.spearmanr(ru_res, ry_res)

pcorr_rows = []
for yyyy in [1956,1993,2009]:
    for buf in [50,500,1000]:
        for resp in ['n.gard','n.unint','n.agfo']:
            pc = partial_spearman(plot_full[f'urban.{yyyy}.{buf}m'],
                                  plot_full[f'cropland.{yyyy}.{buf}m'],
                                  plot_full[resp])
            pcorr_rows.append({'year':yyyy,'buffer_m':buf,'response':resp,
                               'partial_spearman':pc[0],'p':pc[1]})
pcorr_df = pd.DataFrame(pcorr_rows)
print(pcorr_df.round(4).to_string())
pcorr_df.to_csv(f'{OUT}/table_partial_spearman.csv', index=False)

# Clustering-robust NB
