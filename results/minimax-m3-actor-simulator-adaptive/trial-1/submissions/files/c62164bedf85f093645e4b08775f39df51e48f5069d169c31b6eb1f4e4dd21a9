"""
Formal analysis: simultaneous collapse of Pottery Form diversity and rise of Pottery
Decoration diversity.

Convention (fixed by researcher instruction):
- Master temporal axis is BCE. Row labelled BCE=L holds the level at the start
  of the century covering BCE L to BCE L-99 inclusive. By upper-edge /
  start-inclusive convention a bin whose lower edge is BCE=1700 is reported as
  the "17th century BCE" (covering 1700-1601 BCE).

Selection criterion (max-S with simultaneous-sign constraint, applied to both
tables):
  DeltaPF_c = ZKeform[c] - ZKeform[c+100]
  DeltaPD_c = Zkeverz[c] - Zkeverz[c+100]
  S(c)      = DeltaPD_c - DeltaPF_c
  Pick the century c in {c : DeltaPF_c < 0 AND DeltaPD_c > 0} maximising S(c).
"""
import pandas as pd
import numpy as np
# (matplotlib removed - using stdlib SVG)
# matplotlib.use("Agg")
# (matplotlib.pyplot removed - using stdlib SVG)
import os, shutil

ART = "/workspace/artifacts/analysis"
PUB = os.path.join(ART, "public")
os.makedirs(ART, exist_ok=True)
os.makedirs(PUB, exist_ok=True)

# Load + convention check
ts = pd.read_csv("/workspace/data/time_series_data.csv")
cap = pd.read_csv("/workspace/data/capital.csv", decimal=",", thousands=".")
ts["BCE"] = -ts["CE"]
ck = ts.set_index("BCE")[["PotteryForm_inter", "PotteryDecoration_inter"]].rename(
        columns={"PotteryForm_inter": "PF_ts", "PotteryDecoration_inter": "PD_ts"})
cap_aligned = cap.merge(ck, left_on="BCE", right_index=True, how="left")
# Only the BCE 500..4100 overlap is shared between the two tables; BCE 4200/4300 sit outside TS.
ovl = cap_aligned[cap_aligned["BCE"] <= 4100]
mismatch = ((ovl["ZKeform"].round(3) != ovl["PF_ts"].round(3)).sum() +
            (ovl["Zkeverz"].round(3) != ovl["PD_ts"].round(3)).sum())
assert mismatch == 0, f"Tables disagree: {mismatch} mismatches"
print("OK: capital.csv levels match ts.interp at every shared year (3-decimal precision)")

# Build century grid on capital.csv
cap_asc = cap.sort_values("BCE").reset_index(drop=True)
bce_seq = cap_asc["BCE"].values
bce_to_idx = {b: i for i, b in enumerate(bce_seq)}

rows = []
for c in bce_seq:
    older_c = c + 100
    if older_c in bce_to_idx and c in bce_to_idx:
        ic   = bce_to_idx[c]
        iold = bce_to_idx[older_c]
        PFc   = cap_asc.loc[ic, "ZKeform"]
        PFold = cap_asc.loc[iold, "ZKeform"]
        PDc   = cap_asc.loc[ic, "Zkeverz"]
        PDold = cap_asc.loc[iold, "Zkeverz"]
        deltaPF = PFc - PFold
        deltaPD = PDc - PDold
        S = deltaPD - deltaPF
        century_label = c // 100
        rows.append({
            "century_label": f"{century_label}th century BCE",
            "century_lower_edge_BCE": int(c),
            "century_upper_edge_BCE": int(c - 100),
            "calendar_range": f"{c}-{c-100+1} BCE",
            "group": cap_asc.loc[ic, "group"],
            "PF_level_at_start": float(PFc),
            "PF_level_at_start_prev_century": float(PFold),
            "PD_level_at_start": float(PDc),
            "PD_level_at_start_prev_century": float(PDold),
            "DeltaPF": float(deltaPF),
            "DeltaPD": float(deltaPD),
            "S_score": float(S),
        })
cent = pd.DataFrame(rows).sort_values("century_lower_edge_BCE").reset_index(drop=True)
cent.to_csv(os.path.join(ART, "century_grid_table.csv"), index=False)

# Select best century on capital.csv
signal = cent[(cent["DeltaPF"] < 0) & (cent["DeltaPD"] > 0)].copy()
signal_sorted = signal.sort_values("S_score", ascending=False)
signal_sorted.to_csv(os.path.join(ART, "s_score_summary.csv"), index=False)

best_row = signal_sorted.iloc[0]
best_century_capital = best_row["century_label"]
best_century_lower  = int(best_row["century_lower_edge_BCE"])

print("=== capital.csv result ===")
print(f"Best century = {best_century_capital}")
print(f"Calendar range = {best_row['calendar_range']}")
print(f"Group = {best_row['group']}")
print(f"DeltaPF = {best_row['DeltaPF']:+.4f}")
print(f"DeltaPD = {best_row['DeltaPD']:+.4f}")
print(f"S = {best_row['S_score']:+.4f}")
print()
print("All bins satisfying DeltaPF<0 AND DeltaPD>0 (sorted by S desc):")
print(signal_sorted[["century_label","group","DeltaPF","DeltaPD","S_score"]].to_string(index=False))

# Independent cross-check on time_series interpolated curves
def value_at_year(col, year):
    row = ts.loc[ts["BCE"] == year, col]
    return row.iloc[0] if len(row) else np.nan

grid = cent[["century_lower_edge_BCE"]].copy()
grid["century_label"] = grid["century_lower_edge_BCE"].apply(lambda c: f"{c//100}th century BCE")
grid["BCE_older"] = grid["century_lower_edge_BCE"] + 100
grid["PF_this"]   = grid["century_lower_edge_BCE"].apply(lambda y: value_at_year("PotteryForm_inter", y))
grid["PF_older"]  = grid["BCE_older"].apply(lambda y: value_at_year("PotteryForm_inter", y))
grid["PD_this"]   = grid["century_lower_edge_BCE"].apply(lambda y: value_at_year("PotteryDecoration_inter", y))
grid["PD_older"]  = grid["BCE_older"].apply(lambda y: value_at_year("PotteryDecoration_inter", y))
grid["DeltaPF_ts"] = grid["PF_this"] - grid["PF_older"]
grid["DeltaPD_ts"] = grid["PD_this"] - grid["PD_older"]
grid["S_score_ts"] = grid["DeltaPD_ts"] - grid["DeltaPF_ts"]
sig_ts = grid[(grid["DeltaPF_ts"] < 0) & (grid["DeltaPD_ts"] > 0)].sort_values("S_score_ts", ascending=False)
sig_ts.to_csv(os.path.join(ART, "ts_signal_summary.csv"), index=False)

print()
print("=== time_series interpolated curve result ===")
print(sig_ts[["century_label","DeltaPF_ts","DeltaPD_ts","S_score_ts"]].to_string(index=False))
best_ts = sig_ts.iloc[0]

# Robustness: 200-year centered
grid2 = cent[["century_lower_edge_BCE"]].copy()
grid2["BCE_older"] = grid2["century_lower_edge_BCE"] + 200
grid2["PF_this"]    = grid2["century_lower_edge_BCE"].apply(lambda y: value_at_year("PotteryForm_inter", y))
grid2["PF_older"]   = grid2["BCE_older"].apply(lambda y: value_at_year("PotteryForm_inter", y))
grid2["PD_this"]    = grid2["century_lower_edge_BCE"].apply(lambda y: value_at_year("PotteryDecoration_inter", y))
grid2["PD_older"]   = grid2["BCE_older"].apply(lambda y: value_at_year("PotteryDecoration_inter", y))
grid2["DeltaPF_200"] = grid2["PF_this"] - grid2["PF_older"]
grid2["DeltaPD_200"] = grid2["PD_this"] - grid2["PD_older"]
grid2["S_200"] = grid2["DeltaPD_200"] - grid2["DeltaPF_200"]
sig_200 = grid2[(grid2["DeltaPF_200"] < 0) & (grid2["DeltaPD_200"] > 0)].sort_values("S_200", ascending=False)
sig_200.to_csv(os.path.join(ART, "robust_200yr.tsv"), sep="\t", index=False)

# Robustness: raw anchors only
ts2 = ts.dropna(subset=["PotteryForm", "PotteryDecoration"]).copy()
ts2["BCE"] = -ts2["CE"]
# Sort DESCENDING in BCE (oldest first) so .diff() reads (newer century level) - (older century level)
# i.e. the Delta associated with the LATER-century row, matching the criterion on capital.csv.
ts2 = ts2.sort_values("BCE", ascending=False).reset_index(drop=True)
ts2["DeltaPF_anchor"] = ts2["PotteryForm"].diff()
ts2["DeltaPD_anchor"] = ts2["PotteryDecoration"].diff()
ts2["S_anchor"] = ts2["DeltaPD_anchor"] - ts2["DeltaPF_anchor"]
sig_raw = ts2[(ts2["DeltaPF_anchor"] < 0) & (ts2["DeltaPD_anchor"] > 0)].sort_values("S_anchor", ascending=False)
sig_raw.to_csv(os.path.join(ART, "robust_raw_anchors.csv"), index=False)

# Aggregate robustness summary
def fmt_anchor_label(row):
    if pd.isna(row["BCE"]):
        return "(none)"
    return f"anchor BCE={int(row['BCE'])} -> next newer anchor BCE={int(row['BCE'])+100}"

best_raw_label = "(none)"
best_S_raw = float("nan")
best_DP_raw = float("nan")
best_DD_raw = float("nan")
if len(sig_raw):
    best_raw_label = fmt_anchor_label(sig_raw.iloc[0])
    best_S_raw = float(sig_raw.iloc[0]["S_anchor"])
    best_DP_raw = float(sig_raw.iloc[0]["DeltaPF_anchor"])
    best_DD_raw = float(sig_raw.iloc[0]["DeltaPD_anchor"])

robustness = pd.DataFrame([
    {"method": "capital.csv level (100y)",
     "criterion": "DeltaPF<0 & DeltaPD>0",
     "best_century_label": str(best_century_capital),
     "S": float(best_row["S_score"]),
     "DeltaPF": float(best_row["DeltaPF"]),
     "DeltaPD": float(best_row["DeltaPD"])},
    {"method": "ts.inter century diff (100y)",
     "criterion": "DeltaPF<0 & DeltaPD>0",
     "best_century_label": str(best_ts["century_label"]),
     "S": float(best_ts["S_score_ts"]),
     "DeltaPF": float(best_ts["DeltaPF_ts"]),
     "DeltaPD": float(best_ts["DeltaPD_ts"])},
    {"method": "ts.inter 200y centered",
     "criterion": "DeltaPF<0 & DeltaPD>0",
     "best_century_label": f"{(int(sig_200.iloc[0]['century_lower_edge_BCE']) // 100)}th century BCE",
     "S": float(sig_200.iloc[0]["S_200"]),
     "DeltaPF": float(sig_200.iloc[0]["DeltaPF_200"]),
     "DeltaPD": float(sig_200.iloc[0]["DeltaPD_200"])},
    {"method": "raw anchors only (~37)",
     "criterion": "DeltaPF<0 & DeltaPD>0",
     "best_century_label": best_raw_label,
     "S": best_S_raw,
     "DeltaPF": best_DP_raw,
     "DeltaPD": best_DD_raw},
])
robustness.to_csv(os.path.join(ART, "robustness_summary.csv"), index=False)
print()
print("Robustness summary:")
print(robustness.to_string(index=False))

# === SVG diagnostic figure (no matplotlib needed) =========================
def panel_curves_svg(ts, cap, c_best_label, c_best_BCE):
    W, H = 720, 360; pad_l, pad_r, pad_t, pad_b = 60, 20, 30, 50
    pw, ph = W-pad_l-pad_r, H-pad_t-pad_b
    x_lo, x_hi = int(ts.BCE.max()), int(ts.BCE.min())
    y_min, y_max = -3.0, 3.0
    def x2px(bce): return pad_l + (bce - x_lo)/(x_hi-x_lo) * pw
    def y2px(z):   return pad_t + (1 - (z-y_min)/(y_max-y_min)) * ph
    out = [f'<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 {W} {H}" width="{W}" height="{H}">']
    out.append(f'<rect width="{W}" height="{H}" fill="white"/>')
    out.append(f'<text x="{W/2}" y="18" text-anchor="middle" font-family="sans-serif" font-size="13" font-weight="bold">(a) Pottery indicators over BCE</text>')
    out.append(f'<line x1="{pad_l}" y1="{H-pad_b}" x2="{W-pad_r}" y2="{H-pad_b}" stroke="black"/>')
    out.append(f'<line x1="{pad_l}" y1="{pad_t}" x2="{pad_l}" y2="{H-pad_b}" stroke="black"/>')
    for y in [-3,-2,-1,0,1,2,3]:
        out.append(f'<line x1="{pad_l-4}" y1="{y2px(y):.1f}" x2="{pad_l}" y2="{y2px(y):.1f}" stroke="black"/>')
        out.append(f'<text x="{pad_l-6}" y="{y2px(y)+3:.1f}" text-anchor="end" font-family="sans-serif" font-size="10">{y:+d}</text>')
    for bce in range(500, 4101, 500):
        out.append(f'<line x1="{x2px(bce):.1f}" y1="{H-pad_b}" x2="{x2px(bce):.1f}" y2="{H-pad_b+4}" stroke="black"/>')
        out.append(f'<text x="{x2px(bce):.1f}" y="{H-pad_b+16:.1f}" text-anchor="middle" font-family="sans-serif" font-size="10">{bce} BCE</text>')
    out.append(f'<text x="{W/2:.1f}" y="{H-6}" text-anchor="middle" font-family="sans-serif" font-size="11">BCE year</text>')
    out.append(f'<text x="14" y="{H/2:.1f}" text-anchor="middle" font-family="sans-serif" font-size="11" transform="rotate(-90, 14, {H/2:.1f})">Z score</text>')
    pts = " ".join([f"{x2px(b):.1f},{y2px(v):.1f}" for b,v in zip(ts.BCE.values, ts.PotteryForm_inter.values)])
    out.append(f'<polyline points="{pts}" fill="none" stroke="steelblue" stroke-width="1.5"/>')
    pts = " ".join([f"{x2px(b):.1f},{y2px(v):.1f}" for b,v in zip(ts.BCE.values, ts.PotteryDecoration_inter.values)])
    out.append(f'<polyline points="{pts}" fill="none" stroke="indianred" stroke-width="1.5"/>')
    for _, r in cap.iterrows():
        out.append(f'<rect x="{x2px(r.BCE)-4:.1f}" y="{y2px(r.ZKeform)-4:.1f}" width="8" height="8" fill="steelblue"/>')
        out.append(f'<polygon points="{x2px(r.BCE):.1f},{y2px(r.Zkeverz)-5:.1f} {x2px(r.BCE)-5:.1f},{y2px(r.Zkeverz)+4:.1f} {x2px(r.BCE)+5:.1f},{y2px(r.Zkeverz)+4:.1f}" fill="indianred"/>')
    out.append(f'<line x1="{x2px(c_best_BCE):.1f}" y1="{pad_t}" x2="{x2px(c_best_BCE):.1f}" y2="{H-pad_b}" stroke="black" stroke-dasharray="4,3"/>')
    out.append('<rect x="450" y="40" width="260" height="70" fill="white" stroke="black" opacity="0.9"/>')
    out.append('<text x="460" y="55" font-family="sans-serif" font-size="11">Pottery Form (interp.)  --</text>')
    out.append('<text x="460" y="73" font-family="sans-serif" font-size="11">Pottery Decoration (interp.)  --</text>')
    out.append('<text x="460" y="91" font-family="sans-serif" font-size="11">Capital PF [] PD /\u25b2</text>')
    out.append(f'<text x="460" y="105" font-family="sans-serif" font-size="11" fill="black">BEST century = {c_best_label}</text>')
    out.append('</svg>')
    return "".join(out)

def panel_s_score_svg(cent, c_best_BCE):
    W, H = 720, 360; pad_l, pad_r, pad_t, pad_b = 60, 20, 30, 50
    pw, ph = W-pad_l-pad_r, H-pad_t-pad_b
    x_lo, x_hi = int(cent.century_lower_edge_BCE.max()), int(cent.century_lower_edge_BCE.min())
    y_min = float(min(0, cent.S_score.min() - 0.5)); y_max = float(cent.S_score.max() + 0.5)
    def x2px(bce): return pad_l + (bce - x_lo)/(x_hi-x_lo)*pw
    def y2px(z):   return pad_t + (1 - (z-y_min)/(y_max-y_min))*ph
    out = [f'<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 {W} {H}" width="{W}" height="{H}">']
    out.append(f'<rect width="{W}" height="{H}" fill="white"/>')
    out.append(f'<text x="{W/2}" y="18" text-anchor="middle" font-family="sans-serif" font-size="13" font-weight="bold">(b) Cross-metric score S(c) per 100-year bin</text>')
    out.append(f'<line x1="{pad_l}" y1="{H-pad_b}" x2="{W-pad_r}" y2="{H-pad_b}" stroke="black"/>')
    out.append(f'<line x1="{pad_l}" y1="{pad_t}" x2="{pad_l}" y2="{H-pad_b}" stroke="black"/>')
    for y in [round(y_min + i*(y_max-y_min)/5, 1) for i in range(6)]:
        out.append(f'<line x1="{pad_l-4}" y1="{y2px(y):.1f}" x2="{pad_l}" y2="{y2px(y):.1f}" stroke="black"/>')
        out.append(f'<text x="{pad_l-6}" y="{y2px(y)+3:.1f}" text-anchor="end" font-family="sans-serif" font-size="10">{y:+.1f}</text>')
    for bce in range(500, 4101, 500):
        out.append(f'<line x1="{x2px(bce):.1f}" y1="{H-pad_b}" x2="{x2px(bce):.1f}" y2="{H-pad_b+4}" stroke="black"/>')
        out.append(f'<text x="{x2px(bce):.1f}" y="{H-pad_b+16:.1f}" text-anchor="middle" font-family="sans-serif" font-size="10">{bce} BCE</text>')
    out.append(f'<text x="{W/2:.1f}" y="{H-6}" text-anchor="middle" font-family="sans-serif" font-size="11">BCE year (start of century)</text>')
    out.append(f'<text x="14" y="{H/2:.1f}" text-anchor="middle" font-family="sans-serif" font-size="11" transform="rotate(-90, 14, {H/2:.1f})">S = \u0394PD - \u0394PF</text>')
    out.append(f'<line x1="{pad_l}" y1="{y2px(0):.1f}" x2="{W-pad_r}" y2="{y2px(0):.1f}" stroke="grey" stroke-dasharray="2,2"/>')
    cs = cent.century_lower_edge_BCE.values; ss = cent.S_score.values
    pts = " ".join([f"{x2px(b):.1f},{y2px(s):.1f}" for b,s in zip(cs,ss)])
    out.append(f'<polyline points="{pts}" fill="none" stroke="seagreen" stroke-width="1.6"/>')
    for b,s in zip(cs,ss):
        out.append(f'<circle cx="{x2px(b):.1f}" cy="{y2px(s):.1f}" r="3" fill="seagreen"/>')
    out.append(f'<line x1="{x2px(c_best_BCE):.1f}" y1="{pad_t}" x2="{x2px(c_best_BCE):.1f}" y2="{H-pad_b}" stroke="black" stroke-dasharray="4,3"/>')
    out.append('</svg>')
    return "".join(out)

