        out.append(f'<text x="{x2px(x):.1f}" y="{H-pad_b+16:.1f}" text-anchor="middle" font-family="sans-serif" font-size="10">{x:+.1f}</text>')
    out.append(f'<text x="{W/2:.1f}" y="{H-6}" text-anchor="middle" font-family="sans-serif" font-size="11">\u0394PF (Z)</text>')
    out.append(f'<text x="14" y="{H/2:.1f}" text-anchor="middle" font-family="sans-serif" font-size="11" transform="rotate(-90, 14, {H/2:.1f})">\u0394PD (Z)</text>')
    out.append(f'<line x1="{pad_l}" y1="{y2px(0):.1f}" x2="{W-pad_r}" y2="{y2px(0):.1f}" stroke="grey" stroke-dasharray="2,2"/>')
    out.append(f'<line x1="{x2px(0):.1f}" y1="{pad_t}" x2="{x2px(0):.1f}" y2="{H-pad_b}" stroke="grey" stroke-dasharray="2,2"/>')
    out.append(f'<rect x="{pad_l}" y="{pad_t}" width="{x2px(0)-pad_l:.1f}" height="{y2px(0)-pad_t:.1f}" fill="lightgreen" opacity="0.25"/>')
    mask = (cent.DeltaPF < 0) & (cent.DeltaPD > 0)
    for _, r in cent[mask].iterrows():
        out.append(f'<circle cx="{x2px(r.DeltaPF):.1f}" cy="{y2px(r.DeltaPD):.1f}" r="5" fill="seagreen"/>')
    for _, r in cent[~mask].iterrows():
        out.append(f'<circle cx="{x2px(r.DeltaPF):.1f}" cy="{y2px(r.DeltaPD):.1f}" r="3" fill="grey" opacity="0.5"/>')
    out.append(f'<circle cx="{x2px(best_row.DeltaPF):.1f}" cy="{y2px(best_row.DeltaPD):.1f}" r="10" fill="red" stroke="black" stroke-width="1"/>')
    out.append(f'<text x="{x2px(best_row.DeltaPF)+12:.1f}" y="{y2px(best_row.DeltaPD)-5:.1f}" font-family="sans-serif" font-size="11" font-weight="bold" fill="red">BEST: {c_best_label}</text>')
    out.append('</svg>')
    return "".join(out)

def composite_svg(panels, out_path):
    W = 720*2 + 30
    H = 360*2 + 60
    o = [f'<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 {W} {H}" width="{W}" height="{H}">']
    o.append(f'<rect width="{W}" height="{H}" fill="white"/>')
    o.append(f'<text x="{W/2:.1f}" y="24" text-anchor="middle" font-family="sans-serif" font-size="16" font-weight="bold">Pottery Form vs Pottery Decoration diagnostics -- collapse-and-rise century</text>')
    positions = [(15, 40), (15+720+10, 40), (15, 40+360+15), (15+720+10, 40+360+15)]
    for svg_text, (x, y) in zip(panels, positions):
        inner_start = svg_text.find('>', svg_text.find('<svg')) + 1
        inner_end = svg_text.rfind('</svg>')
        o.append(f'<g transform="translate({x},{y})">{svg_text[inner_start:inner_end]}</g>')
    o.append('</svg>')
    with open(out_path, "w") as f:
        f.write("".join(o))

