    out.append(f'<rect x="500" y="40" width="200" height="46" fill="white" stroke="black"/>')
    out.append(f'<rect x="510" y="50" width="14" height="10" fill="steelblue" opacity="0.6"/>')
    out.append(f'<text x="530" y="60" font-family="sans-serif" font-size="11">\u0394PF</text>')
    out.append(f'<rect x="510" y="68" width="14" height="10" fill="indianred" opacity="0.6"/>')
    out.append(f'<text x="530" y="78" font-family="sans-serif" font-size="11">\u0394PD</text>')
    out.append(f'<line x1="{x2px(c_best_BCE):.1f}" y1="{pad_t}" x2="{x2px(c_best_BCE):.1f}" y2="{H-pad_b}" stroke="black" stroke-dasharray="4,3"/>')
    out.append('</svg>')
    return "".join(out)

def panel_scatter_svg(cent, best_row, c_best_label):
    W, H = 720, 360; pad_l, pad_r, pad_t, pad_b = 60, 20, 30, 50
    pw, ph = W-pad_l-pad_r, H-pad_t-pad_b
    vals = pd.concat([cent.DeltaPF, cent.DeltaPD])
    span = float(max(abs(vals.min()), abs(vals.max())))*1.1
    y_min, y_max = -span, span
    def x2px(z): return pad_l + (z-y_min)/(y_max-y_min)*pw
    def y2px(z): return pad_t + (1 - (z-y_min)/(y_max-y_min))*ph
    out = [f'<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 {W} {H}" width="{W}" height="{H}">']
    out.append(f'<rect width="{W}" height="{H}" fill="white"/>')
