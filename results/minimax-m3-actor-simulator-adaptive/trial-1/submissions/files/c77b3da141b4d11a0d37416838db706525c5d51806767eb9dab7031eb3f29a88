import pandas as pd
import numpy as np

pd.set_option('display.width', 200)
df = pd.read_csv('/workspace/data/nls_bmi_processed.csv')

print("="*80)
print("AGE distribution and cohort check")
print("="*80)
print("AGE unique values count:", df['AGE'].nunique())
print("AGE value_counts (sorted by age):")
print(df['AGE'].value_counts().sort_index())
print("\nIf AGE measured in 1989, implied birth-year range:")
print(f"  min -> born {1989-df['AGE'].max()} = age {df['AGE'].max()} in 1989")
print(f"  max -> born {1989-df['AGE'].min()} = age {df['AGE'].min()} in 1989")

print("\n" + "="*80)
print("AGE_2 == AGE**2 verification")
print("="*80)
mismatch_mask = df['AGE_2'] != df['AGE']**2
print(f"Rows where AGE_2 != AGE**2: {int(mismatch_mask.sum())}")
diff = (df['AGE_2'].astype('int64') - (df['AGE'].astype('int64')**2))
print(f"max abs diff: {diff.abs().max()}")
print(f"min/max of AGE_2: {df['AGE_2'].min()}, {df['AGE_2'].max()}")

print("\n" + "="*80)
print("DISSAVED distribution")
print("="*80)
print(df['DISSAVED'].value_counts())
print(df['DISSAVED'].value_counts(normalize=True).round(4))

print("\n" + "="*80)
print("SAMESAVE distribution")
print("="*80)
print(df['SAMESAVE'].value_counts())
print(df['SAMESAVE'].value_counts(normalize=True).round(4))

print("\n" + "="*80)
print("Cross-tab DISSAVED x SAMESAVE (are these mutually exclusive?)")
print("="*80)
print(pd.crosstab(df['DISSAVED'], df['SAMESAVE'], margins=True))
# Note: DISSAVED==1 means withdrew more; DISSAVED==0 + SAMESAVE==1 means no change / no savings;
# DISSAVED==0 + SAMESAVE==0 means positive saver
print("\nCombined 3-category savings behaviour (counts):")
cond = (df['DISSAVED']==0) & (df['SAMESAVE']==0)
print(f"  Net saver (DISSAVED=0, SAMESAVE=0): {int(cond.sum())}")
print(f"  Net withdrawer (DISSAVED=1): {int((df['DISSAVED']==1).sum())}")
print(f"  Unchanged / no savings (SAMESAVE=1): {int((df['SAMESAVE']==1).sum())}")

print("\n" + "="*80)
print("INCOME distributions and quirks")
print("="*80)
inc = df['INCOME'].dropna()
print(f"min: {inc.min():.4f}, p1={inc.quantile(.01):.3f}, p5={inc.quantile(.05):.3f}, "
      f"p25={inc.quantile(.25):.3f}, p50={inc.quantile(.50):.3f}, "
      f"p75={inc.quantile(.75):.3f}, p95={inc.quantile(.95):.3f}, "
      f"p99={inc.quantile(.99):.3f}, max={inc.max():.3f}")
print(f"skew={inc.skew():.3f}, kurtosis={inc.kurtosis():.3f}")
print(f"INCOME <= 0 rows: {(df['INCOME']<=0).sum()}, INCOME == 0 rows: {(df['INCOME']==0).sum()}")
print("INCOME sorted smallest 10 unique values:")
print(sorted(inc.unique())[:10])
print("INCOME sorted largest 10 unique values:")
print(sorted(inc.unique())[-10:])

# Check if INCOME has exact ties / heaping -> winsorization
print("\nINCOME rounded to 0 decimals: top 10 most-frequent values:")
print(df['INCOME'].round(0).value_counts().head(10))

# Check ties at the upper tail
print("\nCount of INCOME values >= mean+3sd:")
hi = df['INCOME'].mean() + 3*df['INCOME'].std()
print(f"  threshold (mean+3sd): {hi:.2f}, count above: {(df['INCOME']>hi).sum()}")

print("\n" + "="*80)
print("BODY-MASS-INDEX (BMI) quirks")
print("="*80)
bmi = df['BMI']
print(f"min={bmi.min():.3f}, max={bmi.max():.3f}, p99={bmi.quantile(.99):.3f}, p1={bmi.quantile(.01):.3f}")
print(f"BMI >= 60 rows (implausible outliers): {(bmi>=60).sum()}")
print(f"BMI >= 50: {(bmi>=50).sum()}; >= 40: {(bmi>=40).sum()}; < 12: {(bmi<12).sum()}")

print("\n" + "="*80)
print("GENDER x DISSAVED means  /  BLACK x DISSAVED / HISPANIC x DISSAVED")
print("="*80)
print("GENDER x DISSAVED mean:")
print(df.groupby('GENDER')['DISSAVED'].agg(['mean','count']).round(4))
print("BLACK x DISSAVED mean:")
print(df.groupby('BLACK')['DISSAVED'].agg(['mean','count']).round(4))
print("HISPANIC x DISSAVED mean:")
print(df.groupby('HISPANIC')['DISSAVED'].agg(['mean','count']).round(4))

print("\n" + "="*80)
print("DISSAVED by AGE (means and counts)")
print("="*80)
print(df.groupby('AGE')['DISSAVED'].agg(['mean','count']).round(4))

print("\n" + "="*80)
print("DUMMY summary")
print("="*80)
print(f"GENDER unique: {sorted(df['GENDER'].dropna().unique().tolist())}")
print(f"BLACK unique: {sorted(df['BLACK'].dropna().unique().tolist())}")
print(f"HISPANIC unique: {sorted(df['HISPANIC'].dropna().unique().tolist())}")
print(f"MALE count: {(df['GENDER']=='MALE').sum()} ({(df['GENDER']=='MALE').mean():.4f})")
print(f"BLACK==1: {(df['BLACK']==1).sum()} ({(df['BLACK']==1).mean():.4f})")
print(f"HISPANIC==1: {(df['HISPANIC']==1).sum()} ({(df['HISPANIC']==1).mean():.4f})")
print(f"Both BLACK==1 and HISPANIC==1: {((df['BLACK']==1)&(df['HISPANIC']==1)).sum()}")
