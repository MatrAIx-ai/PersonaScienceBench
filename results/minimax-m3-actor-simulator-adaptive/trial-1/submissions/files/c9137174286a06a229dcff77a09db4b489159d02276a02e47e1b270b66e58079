        "feat_used": z_cols_de,
        "explained_var": {f"PC{i+1}": float(v) for i, v in enumerate(var_std)},
        "cumulative_var_PC1": float(cum_var_std[0]),
        "yba": {
            "bce":  [int(b) for b in yba["BCE"].tolist()],
            "PC1":  [float(v) for v in yba["PC1"].tolist()],
            "PC2":  [float(v) for v in yba["PC2"].tolist()],
            "PC1_1100": v1100,
            "PC1_1000_500_mean": float(others.mean()),
            "PC1_1000_500_min":  float(others.min()),
            "PC1_1000_500_max":  float(others.max()),
            "PC1_1000_500_std":  float(spreads),
            "diff_1100_minus_mean": float(gap),
            "diff_in_sigmas": float(gap/spreads) if spreads > 0 else None,
            "overlap": overlap,
        },
        "PC1_loadings_ordered_by_abs": [
            {"de": n_, "en": english.get(n_, n_), "category": category.get(n_, ""),
             "loading": float(L)}
            for n_, L in sorted(zip(z_cols_de, load_std[:, 0]),
                                 key=lambda t: -abs(t[1]))
        ],
    },
    "robustness": {
        "a_raw": {
            "explained_var": {f"PC{i+1}": float(v) for i, v in enumerate(var_raw)},
            "PC1_1100": v1100_raw,
            "PC1_1000_500_mean": float(others_raw.mean()),
            "PC1_1000_500_range": [float(others_raw.min()), float(others_raw.max())],
            "diff_1100_minus_mean": float(v1100_raw - others_raw.mean()),
            "PC1_loadings_ordered_by_abs": [
                {"de": n_, "en": english.get(n_, n_), "loading": float(L)}
                for n_, L in sorted(zip(z_cols_de, load_raw[:, 0]),
                                    key=lambda t: -abs(t[1]))
            ],
        },
        "b_drop_constant_in_YBA": {
            "cols_kept": yba_feats_dropvar,
            "explained_var": {f"PC{i+1}": float(v) for i, v in enumerate(var2)},
            "PC1_1100": v1100_b,
            "PC1_1000_500_mean": float(others_b.mean()),
            "PC1_1000_500_range": [float(others_b.min()), float(others_b.max())],
            "diff_1100_minus_mean": float(v1100_b - others_b.mean()),
            "diff_in_sigmas": float((v1100_b - others_b.mean())/spread_b) if spread_b > 0 else None,
            "overlap": overlap_b,
        },
        "c_YBA_only_fit": {
            "PC1_1100": float(pc1_y[idx_1100]),
            "PC1_1000_500_mean": float(rest_y.mean()),
            "PC1_1000_500_range": [float(rest_y.min()), float(rest_y.max())],
            "diff_1100_minus_mean": float(pc1_y[idx_1100] - rest_y.mean()),
            "diff_in_sigmas": float((pc1_y[idx_1100] - rest_y.mean())/spread_y) if spread_y > 0 else None,
        },
    },
}
(ART / "results_summary.json").write_text(json.dumps(summary, indent=2, ensure_ascii=False))
print("\nResults summary written to artifacts/results_summary.json")
