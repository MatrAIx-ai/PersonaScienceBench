"""
DiscoveryBench task: PCA on forms of capital during the Younger Bronze Age.
Ep: metadata_19.json - question 0/0.

Pipeline:
  1) Load data/capital.csv; parse European-comma decimals; cast Z-cols to float.
  2) Standardise (mean 0, std 1); fit PCA via numpy eigh on covariance matrix.
  3) Project all 39 rows onto PC space; report eigenvalues & explained variance.
  4) Extract YBA (BCE 1100..500) PC1/PC2 scores; compare 1100 with the rest.
  5) Compute loadings (eigenvectors x sqrt-eigenvalues) for interpretation.
  6) Save CSV at artifacts/yba_pc1.csv.
  7) Robustness:
        (a) PCA on raw (un-standardised) Z-values.
        (b) PCA on standardised matrix after dropping ZSichel & ZKeform
            (constant within YBA).
        (c) PCA fit on YBA-only (with constant columns dropped) projected onto
            same axes - for stability of the 1100 vs. later claim.
  8) Write a results summary at artifacts/results_summary.json.
"""
from __future__ import annotations

import json
import numpy as np
import pandas as pd
from pathlib import Path

ROOT = Path("/workspace")
DATA = ROOT / "data" / "capital.csv"
ART  = ROOT / "artifacts"
ART.mkdir(parents=True, exist_ok=True)

# --- 1. Load & clean --------------------------------------------------------
raw = pd.read_csv(DATA)
print("== raw shape:", raw.shape)
print("== raw columns:", list(raw.columns))

# Drop meta columns that datasets.json says are dropped after data loading.
meta_cols = [c for c in ["group", "color"] if c in raw.columns]
df = raw.drop(columns=meta_cols).copy()

# Z-columns provided in datasets.json for capital.csv.
z_cols_de = ["ZAxtSchwert", "ZDolch", "Zhausgr", "ZCU_AU", "Zamber",
             "ZMonument", "ZHort", "ZSichel", "ZBeil", "ZMW",
             "ZKeform", "Zkeverz"]

# English names mapped to study context (Symbolic/Social/Cultural/Economic).
english = {
    "ZAxtSchwert": "HatchetSword",
    "ZDolch":      "Dagger",
    "Zhausgr":     "HouseSize",
    "ZCU_AU":      "CopperGold",
    "Zamber":      "Amber",
    "ZMonument":   "MonumentCount",
    "ZHort":       "Depot",
    "ZSichel":     "Sickle",
    "ZBeil":       "AxesCelts",
    "ZMW":         "MonumentSize",
    "ZKeform":     "PotteryForm",
    "Zkeverz":     "PotteryDecoration",
}
category = {
    "ZAxtSchwert": "Symbolic",
    "ZDolch":      "Symbolic",
    "Zhausgr":     "Symbolic",
    "ZCU_AU":      "Social",
    "Zamber":      "Social",
    "ZMonument":   "Social",
    "ZHort":       "Economic",
    "ZSichel":     "Economic",
    "ZBeil":       "Economic",
    "ZMW":         "Economic",
    "ZKeform":     "Cultural",
    "Zkeverz":     "Cultural",
}

for c in z_cols_de:
    s = df[c].astype(str).str.replace(",", ".", regex=False).str.strip()
    df[c] = pd.to_numeric(s, errors="coerce")

print("\n== dtypes after cast ==")
print(df[z_cols_de].dtypes)
print("\n== NaN counts per Z-col ==")
print(df[z_cols_de].isna().sum())
assert df[z_cols_de].isna().sum().sum() == 0, "Unexpected NaNs after parse."


# --- 2. PCA helper ----------------------------------------------------------
def fit_pca(X, names):
    """Fit PCA via np.linalg.eigh on covariance; return scores, V, w, var, loadings."""
    Xc = X - X.mean(axis=0, keepdims=True)
    n = X.shape[0]
    cov = (Xc.T @ Xc) / (n - 1)
    w, V = np.linalg.eigh(cov)
    order = np.argsort(w)[::-1]
    w = w[order]
    V = V[:, order]
    var = w / w.sum()
    scores = Xc @ V
    loadings = V * np.sqrt(w)
    return scores, V, w, var, loadings

def summarise_pca(scores, w, var, loadings, names, title):
    print(f"\n---- {title} ----")
    print(f"components: {len(var)}, n_samples: {scores.shape[0]}")
    for i, (wi, vi) in enumerate(zip(w, var)):
        print(f"  PC{i+1}: eigenvalue={wi:.4f}, explained={vi*100:.2f}%")
    cumul = 0.0
    cum_var = []
    for v in var:
        cumul += v
        cum_var.append(cumul)
    print("  cumulative explained variance:")
    for i, c in enumerate(cum_var, start=1):
        print(f"    PC1..PC{i}: {c*100:.2f}%")
    print("  loadings (V * sqrt(eigval)) on PC1:")
    rows = []
    for n_, L in zip(names, loadings[:, 0]):
        rows.append((n_, L, english.get(n_, n_), category.get(n_, "")))
    rows.sort(key=lambda r: -abs(r[1]))
    for n_, L, en, cat in rows:
        print(f"    {n_:12s} ({cat:9s} | {en:18s}) : {L:+.4f}")
    return cum_var

# --- 3. Standardised PCA on full matrix -------------------------------------
X_raw_mat = df[z_cols_de].values.astype(float)
mu = X_raw_mat.mean(axis=0)
sd = X_raw_mat.std(axis=0, ddof=1)
X_std = (X_raw_mat - mu) / sd

print("\n== standardised matrix shape:", X_std.shape)
print("== sanity check (means/std per col):")
print("   means:", np.round(X_std.mean(axis=0), 6))
print("   stds :", np.round(X_std.std(axis=0, ddof=1), 6))

scores_std, V_std, w_std, var_std, load_std = fit_pca(X_std, z_cols_de)
cum_var_std = summarise_pca(scores_std, w_std, var_std, load_std, z_cols_de,
                            "PCA on standardised (mean 0, std 1) - all 39 rows")

# --- 4. YBA projection & comparison -----------------------------------------
df["PC1"] = scores_std[:, 0]
df["PC2"] = scores_std[:, 1]

yba_mask = df["BCE"].between(500, 1100)
yba = df.loc[yba_mask].sort_values("BCE", ascending=False).reset_index(drop=True)
print("\n== YBA rows (BCE 1100 -> 500) ==")
print(yba[["BCE", "PC1", "PC2"]].to_string(index=False))

v1100  = float(yba.loc[yba["BCE"] == 1100, "PC1"].iloc[0])
others = yba.loc[yba["BCE"] != 1100, "PC1"].astype(float).values
print(f"\n  PC1 at BCE 1100  : {v1100:+.4f}")
print(f"  PC1 mean 1000-500: {others.mean():+.4f}")
print(f"  PC1 range        : [{others.min():+.4f}, {others.max():+.4f}]")
print(f"  Difference 1100 - mean(1000-500): {v1100 - others.mean():+.4f}")
gap = v1100 - others.mean()
spreads = (others - others.mean()).std(ddof=1)
print(f"  Sample std of 1000-500 PC1 (n={len(others)}): {spreads:.4f}")
if spreads > 0:
    print(f"  Standardised distance: {(gap/spreads):+.3f} sigma relative to spread of 1000-500 BCE")
overlap = bool(others.min() <= v1100 <= others.max())
print(f"  1100 inside [min,max] of 1000-500?: {overlap}")

# --- 5. Save YBA PC1/PC2 CSV ------------------------------------------------
yba_out = yba[["BCE", "PC1", "PC2"]].copy()
yba_out.to_csv(ART / "yba_pc1.csv", index=False)
print(f"\nYBA PC1/PC2 CSV saved at {ART/'yba_pc1.csv'}")


# --- 6. Robustness (a): raw covariance -------------------------------------
print("\n" + "="*72)
print("ROBUSTNESS (a): PCA on raw (un-standardised) Z-values")
print("="*72)
scores_raw, V_raw, w_raw, var_raw, load_raw = fit_pca(X_raw_mat, z_cols_de)
cum_var_raw = summarise_pca(scores_raw, w_raw, var_raw, load_raw, z_cols_de,
                            "PCA on raw covariance - all 39 rows")
df["PC1_raw"] = scores_raw[:, 0]
v1100_raw   = float(df.loc[df["BCE"] == 1100, "PC1_raw"].iloc[0])
others_raw  = df.loc[df["BCE"].between(500, 1000), "PC1_raw"].astype(float).values
print(f"\n  PC1_raw at BCE 1100  : {v1100_raw:+.4f}")
print(f"  PC1_raw mean 1000-500: {others_raw.mean():+.4f}")
print(f"  PC1_raw range        : [{others_raw.min():+.4f}, {others_raw.max():+.4f}]")
print(f"  Diff 1100 - mean(1000-500): {v1100_raw - others_raw.mean():+.4f}")

# --- 7. Robustness (b): drop constant-in-YBA columns -----------------------
print("\n" + "="*72)
print("ROBUSTNESS (b): PCA after dropping ZSichel and ZKeform (constant in YBA)")
print("="*72)
yba_feats_dropvar = [c for c in z_cols_de
                     if df.loc[df["BCE"].between(500, 1100), c].nunique() > 1]
print("Columns kept (non-constant inside YBA):", yba_feats_dropvar)
df_kept = df[yba_feats_dropvar]
X_std2 = (df_kept.values - df_kept.values.mean(axis=0)) / df_kept.values.std(axis=0, ddof=1)
scores2, V2, w2, var2, load2 = fit_pca(X_std2, yba_feats_dropvar)
cum_var2 = summarise_pca(scores2, w2, var2, load2, yba_feats_dropvar,
                         "PCA on standardised after dropping ZSichel & ZKeform")

df["PC1_dropvar"] = scores2[:, 0]
v1100_b   = float(df.loc[df["BCE"] == 1100, "PC1_dropvar"].iloc[0])
others_b  = df.loc[df["BCE"].between(500, 1000), "PC1_dropvar"].astype(float).values
print(f"\n  PC1_dropvar at BCE 1100  : {v1100_b:+.4f}")
print(f"  PC1_dropvar mean 1000-500: {others_b.mean():+.4f}")
print(f"  PC1_dropvar range        : [{others_b.min():+.4f}, {others_b.max():+.4f}]")
print(f"  Diff 1100 - mean(1000-500): {v1100_b - others_b.mean():+.4f}")
spread_b = others_b.std(ddof=1)
if spread_b > 0:
    print(f"  Standardised distance: {(v1100_b - others_b.mean())/spread_b:+.3f} sigma")
overlap_b = bool(others_b.min() <= v1100_b <= others_b.max())
print(f"  1100 inside [min,max] of 1000-500?: {overlap_b}")

# --- 8. Robustness (c): PCA fit on YBA-only ---------------------------------
print("\n" + "="*72)
print("ROBUSTNESS (c): PCA fit on YBA-only (constant cols dropped) for stability")
print("="*72)
yba_only = df.loc[df["BCE"].between(500, 1100), yba_feats_dropvar].values
X_ystd = (yba_only - yba_only.mean(axis=0)) / yba_only.std(axis=0, ddof=1)
sy, Vy, wy, vary, loady = fit_pca(X_ystd, yba_feats_dropvar)
cum_vary = summarise_pca(sy, wy, vary, loady, yba_feats_dropvar,
                         "PCA on standardised - YBA-only (7 x 10)")
yba_order = df.loc[df["BCE"].between(500, 1100)].sort_values("BCE", ascending=False)["BCE"].values
idx_1100 = int(np.where(yba_order == 1100)[0][0]); idx_1100 = idx_1100  # force int
pc1_y = sy[:, 0].astype(float)
print(f"\n  PC1 (YBA-only fit) at BCE 1100 : {pc1_y[idx_1100]:+.4f}")
rest_y = np.delete(pc1_y, idx_1100)
print(f"  PC1 (YBA-only fit) mean 1000-500: {rest_y.mean():+.4f}")
print(f"  PC1 (YBA-only fit) range        : [{rest_y.min():+.4f}, {rest_y.max():+.4f}]")
print(f"  Diff 1100 - mean(1000-500): {pc1_y[idx_1100] - rest_y.mean():+.4f}")
spread_y = rest_y.std(ddof=1)
if spread_y > 0:
    print(f"  Standardised distance: {(pc1_y[idx_1100] - rest_y.mean())/spread_y:+.3f} sigma")


# --- 9. Results summary JSON ------------------------------------------------
summary = {
    "primary": {
