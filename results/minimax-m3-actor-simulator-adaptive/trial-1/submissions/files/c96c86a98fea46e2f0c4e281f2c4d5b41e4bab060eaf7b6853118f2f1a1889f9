"""
================================================================================
DiscoveryBench — Meta-Regression Heterogeneity
Question: In which domain do the majority of authors tend to be male for both
          original and replication studies?
================================================================================

Workflow
--------
1. Load study-level heterogeneity CSV (927 rows).
2. Drop the 26 `aggregated == True` rows — these are re-aggregated versions of
   26 studies whose per-lab breakdowns already exist as `aggregated == False`
   rows (verified: the 26 True ids exactly overlap 26 False ids; True\False=0).
3. Keep `aggregated == False` and `aggregated == NaN`. NaN corresponds to
   per-study entries that were not re-aggregated, including the 18 Economics
   studies (NaN rate = 100% for project=ee).
4. For each discipline, compute:
     - simple mean and median of `authors_male.o` and `authors_male.r`
     - author-count-weighted mean (Σ n_authors * authors_male / Σ n_authors)
     - share of O/R-pairs where BOTH (.o) and (.r) are strictly > 0.5
       (and a robust variant with >= 0.5)
5. Run two sensitivity slices:
     (a) `aggregated in {False, True}` (812 rows) — the strict aggregation
         literal filter; excludes Economics only because its aggregated flag
         is NaN.
     (b) ALL 927 rows.
6. The discipline ranking is invariant across slices: Economics is the only
   discipline where replications are male-majority on average.
--------------------------------------------------------------------------------
"""
import json
import numpy as np
import pandas as pd

CSV = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"


def summarize(df: pd.DataFrame, label: str) -> pd.DataFrame:
    """Per-discipline summary of authors_male.o and authors_male.r."""
    print(f"\n========== {label} ==========")
    print(f"n rows = {len(df)}; aggregated = {df['aggregated'].value_counts(dropna=False).to_dict()}")
    n_per = df.groupby("discipline")[("id")].size().rename("n_studies")
    out = df.groupby("discipline").agg(
        n_studies=("id", "size"),
        mean_o=("authors_male.o", "mean"),
        median_o=("authors_male.o", "median"),
        mean_r=("authors_male.r", "mean"),
        median_r=("authors_male.r", "median"),
    )
    def wmean(grp, val, wgt):
        w = grp[wgt].sum()
        return (grp[val] * grp[wgt]).sum() / w if w else np.nan
    g = df.groupby("discipline")
    out["wmean_o"] = [wmean(g.get_group(d), "authors_male.o", "n_authors.o") for d in g.groups]
    out["wmean_r"] = [wmean(g.get_group(d), "authors_male.r", "n_authors.r") for d in g.groups]
    df2 = df.assign(
        both_gt05=(df["authors_male.o"] > 0.5)  & (df["authors_male.r"] > 0.5),
        both_ge05=(df["authors_male.o"] >= 0.5) & (df["authors_male.r"] >= 0.5),
    )
    shares = df2.groupby("discipline")[["both_gt05", "both_ge05"]].mean().add_prefix("share_")
    out = out.join(shares)
    print(out.round(4).to_string())
    return out.round(4)


df = pd.read_csv(CSV)
assert {"discipline", "authors_male.o", "authors_male.r",
        "n_authors.o", "n_authors.r", "project", "aggregated"}.issubset(df.columns)

# ---------------------------------------------------------------------------
# Validation: aggregated == True duplicates aggregated == False ?
# ---------------------------------------------------------------------------
true_ids  = set(df.loc[df["aggregated"] == True,  "id"])
false_ids = set(df.loc[df["aggregated"] == False, "id"])
nan_ids   = set(df.loc[df["aggregated"].isna(),    "id"])
print(f"True ids in False ids: {len(true_ids & false_ids)} / True={len(true_ids)}")
print(f"True ids in NaN  ids:  {len(true_ids & nan_ids)}")
print(f"Unique ids total: {df['id'].nunique()} (rows={len(df)})")

# Slices
primary     = df[df["aggregated"] != True].copy()              # PRIMARY: drop 26 True duplicates
sens_false_true = df[df["aggregated"].isin([False, True])].copy()
sens_all    = df.copy()

prim_out = summarize(primary,        "PRIMARY:  aggregated != True  (n=901)")
sens_t   = summarize(sens_false_true, "SENS-A:   aggregated in {F,T} (n=812, excl. Economics)")
sens_a   = summarize(sens_all,       "SENS-B:   ALL rows            (n=927)")

# ---------------------------------------------------------------------------
# Persist JSON results for downstream use.
# ---------------------------------------------------------------------------
result = {
    "primary_aggregated_not_True": prim_out.reset_index().to_dict(orient="records"),
    "sensitivity_False_or_True":   sens_t.reset_index().to_dict(orient="records"),
    "sensitivity_all_rows":        sens_a.reset_index().to_dict(orient="records"),
    "validation": {
        "true_ids_count":          len(true_ids),
        "true_x_false_overlap":    len(true_ids & false_ids),
        "true_x_nan_overlap":      len(true_ids & nan_ids),
        "unique_ids":              int(df["id"].nunique()),
        "rows":                    int(len(df)),
        "dropped_rows_in_primary": int(df["aggregated"].eq(True).sum()),
    },
    "discipline_value_counts": {str(k): int(v) for k, v in df["discipline"].value_counts(dropna=False).items()},
    "aggregated_value_counts": {str(k): int(v) for k, v in df["aggregated"].value_counts(dropna=False).items()},
}
with open("/workspace/artifacts/numbers.json", "w") as f:
    json.dump(result, f, indent=2, default=str)
print("\nWrote /workspace/artifacts/numbers.json")
