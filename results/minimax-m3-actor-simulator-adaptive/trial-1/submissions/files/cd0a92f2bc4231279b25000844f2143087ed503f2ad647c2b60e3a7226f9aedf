"""
Analysis: prevalence of non-native plants introduced via gardening varies by habitat.

Primary table  : data/invaded_niche_pathways.csv  (plot-level)
Secondary table: data/invasion_success_pathways.csv (species-level corroboration only)

Outputs:
  - artifacts.analysis/habitat_gardening_summary.csv
  - artifacts.analysis/species_level_by_pathway.csv
  - artifacts.analysis/diagnostics.txt
"""
import numpy as np
import pandas as pd
from scipy.stats import chi2_contingency

RNG = np.random.default_rng(20261022)
N_PERM = 9999

# ---------- PRIMARY: plot-level ----------
df = pd.read_csv("data/invaded_niche_pathways.csv", sep="\t")
habitats = sorted(df["habitat"].unique())

records = []
for h in habitats:
    sub = df[df["habitat"] == h]
    n_plots = len(sub)
    sum_gard = int(sub["n.gard"].sum())
    sum_unint = int(sub["n.unint"].sum())
    sum_agfo = int(sub["n.agfo"].sum())
    sum_total = int(sub["n.total"].sum())
    plots_with_gard = int((sub["n.gard"] > 0).sum())
    # per-plot proportions, excluding plots with n.total == 0
    mask_nonzero = sub["n.total"] > 0
    excluded_zero = int((~mask_nonzero).sum())
    r = (sub.loc[mask_nonzero, "n.gard"] / sub.loc[mask_nonzero, "n.total"]).to_numpy()
    median_r = float(np.median(r)) if r.size else float("nan")
    q25 = float(np.quantile(r, 0.25)) if r.size else float("nan")
    q75 = float(np.quantile(r, 0.75)) if r.size else float("nan")
    p_gard = sum_gard / sum_total if sum_total else float("nan")
    records.append({"habitat": h, "n_plots": n_plots,
                    "excluded_plots_n_total_eq_0": excluded_zero,
                    "sum_n_gard": sum_gard, "sum_n_unint": sum_unint,
                    "sum_n_agfo": sum_agfo, "sum_n_total": sum_total,
                    "p_gard_pooled": p_gard,
                    "plots_with_gardening_gt_0": plots_with_gard,
                    "per_plot_median_r": median_r,
                    "per_plot_IQR25_r": q25, "per_plot_IQR75_r": q75})

summary = pd.DataFrame(records)
summary["low_n_flag"] = np.where(summary["sum_n_total"] < 10, "low_n(<10)", "")
summary["rank_p_gard"] = summary["p_gard_pooled"].rank(method="min", ascending=False).astype(int)
summary = summary.sort_values("p_gard_pooled", ascending=False).reset_index(drop=True)
summary.to_csv("artifacts.analysis/habitat_gardening_summary.csv", index=False)
print("--- Per-habitat summary (sorted by pooled p_gard) ---")
print(summary.to_string(index=False))

# ---------- χ² independence test: pathway × habitat (pooled counts) ----------
pooled = (df.groupby("habitat")[["n.gard", "n.unint", "n.agfo"]]
            .sum().reindex(habitats))
contingency = pooled.to_numpy().T
chi2, p_chi2, dof, _ = chi2_contingency(contingency)
grand_total = int(contingency.sum())

# ---------- Permutation test on pooled p_gard spread ----------
n_total_col = df["n.total"].to_numpy(dtype=float)
n_gard_col  = df["n.gard"].to_numpy(dtype=float)
hab_idx = pd.Categorical(df["habitat"], categories=habitats).codes

def pooled_stat(labels):
    p = np.zeros(len(habitats))
    for i in range(len(habitats)):
        m = labels == i
        tg = n_gard_col[m].sum(); tt = n_total_col[m].sum()
        p[i] = tg / tt if tt > 0 else 0.0
    return p.max() - p.min(), p

obs_range, obs_p = pooled_stat(hab_idx)
obs_var = float(np.var(obs_p, ddof=1))

count_ge_range = 0
count_ge_var = 0
for _ in range(N_PERM):
    shuf = RNG.permutation(hab_idx)
    r, p_s = pooled_stat(shuf)
    if r >= obs_range - 1e-15: count_ge_range += 1
    if float(np.var(p_s, ddof=1)) >= obs_var - 1e-15: count_ge_var += 1
p_perm_range = (count_ge_range + 1) / (N_PERM + 1)
p_perm_var   = (count_ge_var + 1) / (N_PERM + 1)

# ---------- SECONDARY: species-level ----------
sp = pd.read_csv("data/invasion_success_pathways.csv")
sp_uniq = sp.drop_duplicates(subset=["Scientific_name"], keep="first")
rows = []
for p, sub in sp_uniq.groupby("intro.pathway"):
    hr = sub["habitat.range"].to_numpy(dtype=float)
    nip = sub["number.of.invaded.plots"].to_numpy(dtype=float)
    rows.append({"intro.pathway": p,
                 "n_species": len(sub),
                 "median_habitat.range": float(np.median(hr)),
                 "IQR25_habitat.range": float(np.quantile(hr, 0.25)),
                 "IQR75_habitat.range": float(np.quantile(hr, 0.75)),
                 "median_number.of.invaded.plots": float(np.median(nip)),
                 "IQR25_inv.plots": float(np.quantile(nip, 0.25)),
                 "IQR75_inv.plots": float(np.quantile(nip, 0.75))})
secondary = pd.DataFrame(rows).sort_values("intro.pathway").reset_index(drop=True)
secondary.to_csv("artifacts.analysis/species_level_by_pathway.csv", index=False)
print("\n--- Species-level summary ---")
print(secondary.to_string(index=False))

# ---------- Persist diagnostics ----------
with open("artifacts.analysis/diagnostics.txt", "w") as f:
    f.write(f"n_plots_total={len(df)}\n")
    f.write(f"n_habitats={len(habitats)}\n")
    f.write(f"grand_total_non_native_occurrences={grand_total}\n")
    f.write(f"chi2_statistic={chi2:.4f}\n")
    f.write(f"chi2_dof={dof}\n")
    f.write(f"chi2_p={p_chi2:.6g}\n")
    f.write(f"permutation_range_statistic={obs_range:.6f}\n")
    f.write(f"permutation_range_p={p_perm_range:.6g}\n")
    f.write(f"permutation_var_statistic={obs_var:.6f}\n")
    f.write(f"permutation_var_p={p_perm_var:.6g}\n")
    f.write(f"n_permutations={N_PERM}\n")
    f.write(f"species_unique_after_dedup={len(sp_uniq)}\n")
    f.write(f"species_duplicated_TRUE_count={int((sp['duplicated']==True).sum())}\n")

print("\n--- Diagnostics ---")
print(f"χ² = {chi2:.3f}, dof = {dof}, p = {p_chi2:.4g}")
print(f"Permutation range p   = {p_perm_range:.4g}  (statistic = {obs_range:.4f})")
print(f"Permutation var   p   = {p_perm_var:.4g}    (statistic = {obs_var:.4f})")
print(f"n_plots={len(df)}, n_habitats={len(habitats)}, grand_total={grand_total}")

# Print summary lines for hypothesis construction
reliable = summary[summary["low_n_flag"] == ""].copy()
print("\n--- Headline ranking (habitats with Σn.total ≥ 10) ---")
print(reliable.to_string(index=False))
top = reliable.iloc[0]
bot = reliable.iloc[-1]
print(f"\nTop (reliable): {top['habitat']} p_gard={top['p_gard_pooled']:.3f} Σgard/total={top['sum_n_gard']}/{top['sum_n_total']}")
print(f"Bot (reliable): {bot['habitat']} p_gard={bot['p_gard_pooled']:.3f} Σgard/total={bot['sum_n_gard']}/{bot['sum_n_total']}")
print(f"Low-n flagged habitats: {summary.loc[summary['low_n_flag']!='', 'habitat'].tolist()}")
