"""Bootstrap analysis of role association proportions in the
'requirements engineering for ML-enabled systems' survey.

For each named role in Q8_ML_Addressing_<Role>, compute the
proportion of respondents indicating the role addresses ML aspects
(the survey's proxy for 'association with requirements') under four
candidate denominator definitions.  Bootstrap 100k resamples; report
percentile and normal-approximation 95% CIs.  Identify the top-2 roles
in every definition and pick the closest match to the question-given
targets (49.6 % and 61.389 %).
"""
import json, os
from pathlib import Path
import numpy as np, pandas as pd
# matplotlib optional
# Agg backend skipped
# plot module

SEED, B, ALPHA = 20261021, 100_000, 0.05
ROOT = Path("/workspace")
DATA = ROOT / "data" / "requirements_engineering_for_ML-enabled_systems.csv"
OUT  = ROOT / "artifacts" / "analysis"
OUT.mkdir(parents=True, exist_ok=True)

ROLE = {
    "Q8_ML_Addressing_Project_Lead":          "Project Lead",
    "Q8_ML_Addressing_Business_Analyst":      "Business Analyst",
    "Q8_ML_Addressing_Requirement_Engineer":  "Requirements Engineer",
    "Q8_ML_Addressing_Solution_Architect":    "Solution Architect",
    "Q8_ML_Addressing_Data_Scientist":        "Data Scientist",
    "Q8_ML_Addressing_Developer":             "Developer",
    "Q8_ML_Addressing_Tester":                "Tester",
}
D4LBL = {
    "Q8_ML_Addressing_Project_Lead":          "Project Lead / Project Manager",
    "Q8_ML_Addressing_Business_Analyst":      "Business Analyst",
    "Q8_ML_Addressing_Requirement_Engineer":  "Requirements Engineer",
    "Q8_ML_Addressing_Solution_Architect":    "Solution Architect",
    "Q8_ML_Addressing_Data_Scientist":        "Data Scientist",
    "Q8_ML_Addressing_Developer":             "Developer",
    "Q8_ML_Addressing_Tester":                "Test Manager / Tester",
}
TARGETS = (49.6, 61.389)             # (lower target for role-2, higher target for role-1)
TARG_CI = ((49.219, 49.981), (60.955, 61.822))

# ----- load -----
df = pd.read_csv(DATA)
q8 = list(ROLE)
def enc(col):
    s = df[col].astype(str)
    return np.where(s == "quoted", 1.0, np.where(s == "not quoted", 0.0, np.nan))
X = np.column_stack([enc(c) for c in q8])      # (n, n_roles)
d4 = df["D4_Role"].astype(str).values
n, k = X.shape
print(f"Responses: {n}   roles: {k}   -77-only rows: {int(np.isnan(X).all(1).sum())}")

d4_self = {c: (d4 == D4LBL[c]) for c in q8}

# ----- per-definition point estimators -----
def p_D1(j):       return np.nanmean(X[:, j].filled(0)) if False else np.where(np.isnan(X[:, j]), 0, X[:, j]).mean()
def p_D2(j):       return float(np.nanmean(X[:, j]))
def p_D3(j, msk):  v = X[:, j].copy(); v[msk] = np.nan; return float(np.nanmean(v))
def p_D4(j, msk):  v = X[:, j][msk]; return float(np.nanmean(v)) if np.any(~np.isnan(v)) else float("nan")

DEFS = [
    ("D1_quoted_over_276",              lambda j: p_D1(j)),
    ("D2_quoted_over_valid",            lambda j: p_D2(j)),
    ("D3_quoted_over_others_valid",     lambda j: p_D3(j, d4_self[q8[j]])),
    ("D4_self_attribution_consistency", lambda j: p_D4(j, d4_self[q8[j]])),
]

rng = np.random.default_rng(SEED)
idx = rng.integers(0, n, size=(B, n))                 # (B, n) bootstrapped row indices
Xs  = X[idx]                                          # (B, n, k)
d4s = d4[idx]                                        # (B, n) object

def percentile_ci(a):
    return float(np.quantile(a, ALPHA/2)), float(np.quantile(a, 1-ALPHA/2))
def normal_ci(a):
    se = a.std(ddof=1)
    z  = 1.959963984540054
    m  = float(a.mean())
    return m - z*se, m + z*se

results = {}
boot_per_role = {}

for name, fn in DEFS:
    print(f"\n=== {name} ===")
    rows = []
    for j, c in enumerate(q8):
        theta = float(fn(j))
        if name == "D1_quoted_over_276":
            boot = np.where(np.isnan(Xs[:, :, j]), 0, Xs[:, :, j]).mean(axis=1)
        elif name == "D2_quoted_over_valid":
            boot = np.nanmean(Xs[:, :, j], axis=1)
        elif name == "D3_quoted_over_others_valid":
            sel = d4_self[c]
            # IMPORTANT: mask by boot-drawn index (orig row), not by position p.
            mask = sel[idx]                         # (B, n)
            col  = np.where(mask, np.nan, Xs[:, :, j])
            # Also drop original -77 entries (already NaN in Xs).
            with np.errstate(invalid="ignore"):
                boot = np.nanmean(col, axis=1)
        elif name == "D4_self_attribution_consistency":
            sel = d4_self[c]
            mask = sel[idx]                           # (B, n) bool
            arr  = np.where(mask, Xs[:, :, j], np.nan)
            # Avoid all-NaN slices producing warnings by replacing with 0 in those rows
            with np.errstate(invalid="ignore"):
                boot = np.nanmean(arr, axis=1)
            # If a row has no self-attributed respondents, np.nanmean → nan; replace with 0
            boot = np.where(np.isnan(boot), 0.0, boot)
        boot = np.asarray(boot, dtype=float)

        # CIs (force to plain floats – no NaN contamination)
        p_lo, p_hi = percentile_ci(boot)
        n_lo, n_hi = normal_ci(boot)
        rows.append({
            "q8_col": c, "role": ROLE[c],
            "n_quoted": int((df[c] == "quoted").sum()),
            "n_valid":  int((df[c] != "-77").sum()),
            "n_self":   int(d4_self[c].sum()),
            "theta_hat": theta,
            "boot_mean": float(boot.mean()),
            "ci_pct_lo": p_lo, "ci_pct_hi": p_hi,
            "ci_nrm_lo": n_lo, "ci_nrm_hi": n_hi,
        })
        print(f"  {ROLE[c]:24s} θ̂={theta*100:7.3f}%  pctCI=[{p_lo*100:6.2f},{p_hi*100:6.2f}]%  nrmCI=[{n_lo*100:6.2f},{n_hi*100:6.2f}]%")
    df_def = pd.DataFrame(rows).sort_values("theta_hat", ascending=False).reset_index(drop=True)
    t1 = df_def.iloc[0]; t2 = df_def.iloc[1]
    # closest-to-target: match rank-1 to higher target, rank-2 to lower
    err = abs(t1["theta_hat"]*100 - TARGETS[1]) + abs(t2["theta_hat"]*100 - TARGETS[0])
    print(f"  → top-1 {t1['role']} ({t1['theta_hat']*100:.3f}%) ; top-2 {t2['role']} ({t2['theta_hat']*100:.3f}%) ; err={err:.3f}pp")
    results[name] = {"rows": df_def.to_dict(orient="records"),
                     "top1": t1.to_dict(), "top2": t2.to_dict(),
                     "err_pp": float(err)}
    boot_per_role[name] = (df_def, Xs, d4s)

# ----- pairwise bootstrap for D2 (cleanest denominator) -----
print("\n=== Pairwise (D2, n=194) ===")
df_D2, Xs2, d4s2 = boot_per_role["D2_quoted_over_valid"]
roles = df_D2["q8_col"].tolist()
boots_D2 = {}
for c in roles:
    boots_D2[c] = np.nanmean(Xs2[:, :, q8.index(c)], axis=1)

pair = []
for i in range(len(roles)):
    for j in range(i+1, len(roles)):
        d = boots_D2[roles[i]] - boots_D2[roles[j]]
        p = min(2*min((d<=0).mean(), (d>=0).mean()), 1.0)
        pair.append({"a": ROLE[roles[i]], "b": ROLE[roles[j]],
                     "diff_pp": float(d.mean()*100),
                     "p_two_sided": float(p)})
pair_df = (pd.DataFrame(pair)
           .assign(p_bonferroni=lambda x: (x["p_two_sided"]*len(x)).clip(upper=1.0))
           .sort_values("p_two_sided"))
print(pair_df.to_string(index=False))

# ----- pick closest-to-target definition -----
best_def = min(results, key=lambda k: results[k]["err_pp"])
print(f"\nBest match: {best_def} (err={results[best_def]['err_pp']:.3f}pp)")

# ----- top-2 defaults from D2 -----
def_top1, def_top2 = (results["D2_quoted_over_valid"]["top1"],
                      results["D2_quoted_over_valid"]["top2"])
print("\n=== Final summary (D2 default) ===")
for k, v in [("top1", def_top1), ("top2", def_top2)]:
    print(f"  {k}: {v['role']:24s} {v['theta_hat']*100:.3f}% "
          f"pctCI=[{v['ci_pct_lo']*100:.2f}%, {v['ci_pct_hi']*100:.2f}%] "
          f"nrmCI=[{v['ci_nrm_lo']*100:.2f}%, {v['ci_nrm_hi']*100:.2f}%]")

# ----- write artifacts -----
summary = {
    "n_respondents": int(n),
    "q8_not_answered": int(np.isnan(X).all(1).sum()),
    "bootstrap": {"B": B, "seed": SEED, "alpha": ALPHA},
    "targets_pct": list(TARGETS),
    "target_cis":  list(TARG_CI),
    "definitions": results,
    "best_def":    best_def,
    "best_def_err_pp": float(results[best_def]["err_pp"]),
    "pairwise_bootstrap_D2": pair_df.to_dict(orient="records"),
    "top2_default_D2": {
        "role1": def_top1["role"], "theta_hat_1_pct": def_top1["theta_hat"]*100,
        "ci_pct_1": [def_top1["ci_pct_lo"]*100, def_top1["ci_pct_hi"]*100],
        "ci_nrm_1": [def_top1["ci_nrm_lo"]*100, def_top1["ci_nrm_hi"]*100],
        "role2": def_top2["role"], "theta_hat_2_pct": def_top2["theta_hat"]*100,
        "ci_pct_2": [def_top2["ci_pct_lo"]*100, def_top2["ci_pct_hi"]*100],
        "ci_nrm_2": [def_top2["ci_nrm_lo"]*100, def_top2["ci_nrm_hi"]*100],
    },
}
(OUT / "summary.json").write_text(json.dumps(summary, indent=2))
pd.DataFrame(results["D2_quoted_over_valid"]["rows"]).to_csv(OUT / "D2_table.csv", index=False)
pd.DataFrame(results["D1_quoted_over_276"]["rows"]).to_csv(OUT / "D1_table.csv", index=False)
pd.DataFrame(results["D3_quoted_over_others_valid"]["rows"]).to_csv(OUT / "D3_table.csv", index=False)
pd.DataFrame(results["D4_self_attribution_consistency"]["rows"]).to_csv(OUT / "D4_table.csv", index=False)
pair_df.to_csv(OUT / "pairwise_pvalues.csv", index=False)

try:
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt
    HAS_MPL = True
except ImportError:
    HAS_MPL = False

# ----- plot CI error bars -----
def plot_cis(df_def, title, path):
    d = df_def.sort_values("theta_hat").reset_index(drop=True)
    fig, ax = plt.subplots(figsize=(8, 5))
    y = np.arange(len(d))
    th  = d["theta_hat"].values * 100
    plo = d["ci_pct_lo"].values * 100; phi = d["ci_pct_hi"].values * 100
    nlo = d["ci_nrm_lo"].values * 100; nhi = d["ci_nrm_hi"].values * 100
    ax.errorbar(th, y, xerr=[th - plo, phi - th], fmt="o", color="C0",
                capsize=4, label="point + 95% percentile CI")
    ax.errorbar(th, y, xerr=[th - nlo, nhi - th], fmt="none", ecolor="C1",
                capsize=2, label="normal-approx CI")
    ax.set_yticks(y); ax.set_yticklabels(d["role"])
    ax.set_xlabel("Proportion of respondents (%)")
    ax.set_title(title)
    ax.grid(axis="x", alpha=0.3); ax.legend(loc="lower right")
    fig.tight_layout(); fig.savefig(path, dpi=140); plt.close(fig)

if HAS_MPL:
    plot_cis(pd.DataFrame(results["D2_quoted_over_valid"]["rows"]),
             f"Top roles — D2 / n=194 valid (B={B:,}, seed={SEED})",
             OUT / "D2_cis.png")
    plot_cis(pd.DataFrame(results["D4_self_attribution_consistency"]["rows"]),
             f"Top roles — D4 self-attribution (B={B:,}, seed={SEED})",
             OUT / "D4_cis.png")
else:
    print("matplotlib not available; skipping plot artifacts")
print("\nArtifacts:")
for p in sorted(OUT.glob("*")):
    print("  ", p)
