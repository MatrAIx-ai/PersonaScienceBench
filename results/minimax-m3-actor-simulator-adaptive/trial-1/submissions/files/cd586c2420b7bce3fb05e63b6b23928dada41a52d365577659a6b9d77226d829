"""
PCA on forms of capital across 100-year time slices
— Younger Bronze Age (1100-500 BCE) sub-analysis.

Two parallel runs:
  (a) PCA-full     : fit on full 39x12 standardized matrix; project 7 YBA rows.
  (b) PCA-YBA-only : fit on 7x10 YBA-resident matrix (ZSichel,ZKeform dropped
                     as zero-variance).

Sign-flip rule (identical for both runs):
  Pick sign so that loadings of PC1 on {ZCU_AU, Zamber, ZHort, Zhausgr}
  are all of the same sign AND positive; otherwise flip PC1 vector.
"""
import json, os
import numpy as np
import pandas as pd
from numpy.linalg import svd

ROOT  = '/workspace'
DATA  = os.path.join(ROOT, 'data')
OUT   = os.path.join(ROOT, 'artifacts')
os.makedirs(OUT, exist_ok=True)

# ---------- load ----------
cap = pd.read_csv(os.path.join(DATA, 'capital.csv'), decimal=',')
pol = pd.read_csv(os.path.join(DATA,
          'pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv'),
          decimal=',')

YBA_BCE = [1100, 1000, 900, 800, 700, 600, 500]
FEAT12  = ['ZAxtSchwert','ZDolch','Zhausgr','ZCU_AU','Zamber',
           'ZMonument','ZHort','ZSichel','ZBeil','ZMW','ZKeform','Zkeverz']
EC_COLS = ['ZCU_AU','Zamber','ZHort','Zhausgr']   # economic-capital sign-rule keys
ZERO_VAR_IN_YBA  = ['ZSichel','ZKeform']

# ---------- helper: PCA via SVD ----------
def pca_fit(X, feat_names):
    n, p = X.shape
    U, S, Vt = svd(X, full_matrices=False)
    ev = S**2
    evr = ev / ev.sum()
    scores = U * S
    loadings = Vt.T
    k = min(n, p)
    load_tab = pd.DataFrame(loadings, index=feat_names,
                            columns=[f'PC{i+1}' for i in range(k)])
    return scores, load_tab, evr

def sign_flip(load_pc1, key_cols):
    s = np.sign(load_pc1.loc[key_cols].values)
    s[s == 0] = 1
    same_sign = (s == s[0]).all()
    already_pos = (s[0] > 0)
    return -1 if not (same_sign and already_pos) else 1

# ---------- PCA-full : n=39, all 12 features ----------
X_full = cap[FEAT12].values.astype(float)
mu_full  = X_full.mean(axis=0)
sd_full  = X_full.std(axis=0, ddof=0)
X_full_z = (X_full - mu_full) / sd_full
scores_full, loadings_full, evr_full = pca_fit(X_full_z, FEAT12)

# index of YBA rows oldest-first
yba_idx = cap[cap['group']=='YBA'].sort_values('BCE', ascending=False).index
yba_rows = cap.loc[yba_idx, FEAT12].values.astype(float)
yba_rows_z = (yba_rows - mu_full) / sd_full
yba_scores_full = yba_rows_z @ loadings_full.values

flip_full = sign_flip(loadings_full['PC1'], EC_COLS)
pc1_yba_full_raw  = yba_scores_full[:, 0].copy()
pc1_yba_full_flip = flip_full * pc1_yba_full_raw
loadings_full_flip = loadings_full.copy()
loadings_full_flip['PC1'] = flip_full * loadings_full_flip['PC1']

# ---------- PCA-YBA-only : n=7, drop ZSichel+ZKeform ----------
feat10 = [f for f in FEAT12 if f not in ZERO_VAR_IN_YBA]
X_yba  = cap.loc[yba_idx, feat10].values.astype(float)
mu_yba = X_yba.mean(axis=0)
sd_yba = X_yba.std(axis=0, ddof=0)
near_zero = np.isclose(sd_yba, 0.0)
if near_zero.any():
    drop_more = [feat10[i] for i,v in enumerate(near_zero) if v]
    feat10 = [f for f in feat10 if f not in drop_more]
    X_yba  = cap.loc[yba_idx, feat10].values.astype(float)
    mu_yba = X_yba.mean(axis=0); sd_yba = X_yba.std(axis=0, ddof=0)
X_yba_z = (X_yba - mu_yba) / sd_yba
scores_yba, loadings_yba, evr_yba = pca_fit(X_yba_z, feat10)

flip_yba = sign_flip(loadings_yba['PC1'], EC_COLS)
pc1_ybaonly_raw  = scores_yba[:, 0].copy()
pc1_ybaonly_flip = flip_yba * pc1_ybaonly_raw
loadings_yba_flip = loadings_yba.copy()
loadings_yba_flip['PC1'] = flip_yba * loadings_yba_flip['PC1']

# ---------- score table across 7 YBA horizons ----------
BCE_ordered = cap.loc[yba_idx, 'BCE'].astype(int).tolist()    # 1100,1000,...,500
score_tab = pd.DataFrame({
    'BCE'                 : BCE_ordered,
    'PC1_full_raw'        : pc1_yba_full_raw,
    'PC1_full_flipped'    : pc1_yba_full_flip,
    'PC1_ybaonly_raw'     : pc1_ybaonly_raw,
    'PC1_ybaonly_flipped' : pc1_ybaonly_flip,
})

# ---------- diff table PC1(1100) − PC1(t) ----------
pc1_1100_full    = score_tab.loc[score_tab['BCE']==1100, 'PC1_full_flipped'].iloc[0]
pc1_1100_ybaonly = score_tab.loc[score_tab['BCE']==1100, 'PC1_ybaonly_flipped'].iloc[0]
diff_full    = pc1_1100_full    - score_tab['PC1_full_flipped']
diff_ybaonly = pc1_1100_ybaonly - score_tab['PC1_ybaonly_flipped']
diff_tab = pd.DataFrame({
    'BCE'                                 : score_tab['BCE'],
    'PC1_full_flipped'                    : score_tab['PC1_full_flipped'],
    'diff_full_PC1_1100_minus_t'          : diff_full,
    'PC1_ybaonly_flipped'                 : score_tab['PC1_ybaonly_flipped'],
    'diff_ybaonly_PC1_1100_minus_t'       : diff_ybaonly,
})

# ---------- verdict : PC1(1100) vs [min, max] of {PC1(1000..500)} ----------
def verdict_clean(pc1_arr, bce_arr, anchor_bce=1100):
    mask = (bce_arr != anchor_bce)
    rest = pc1_arr[mask]; val = pc1_arr[bce_arr == anchor_bce][0]
    lo, hi = rest.min(), rest.max()
    if val > hi:   return ('OUTSIDE','ABOVE', lo, hi)
    elif val < lo: return ('OUTSIDE','BELOW', lo, hi)
    else:          return ('INSIDE','INSIDE', lo, hi)

verdict_full    = verdict_clean(score_tab['PC1_full_flipped'].values,
                                score_tab['BCE'].values)
verdict_ybaonly = verdict_clean(score_tab['PC1_ybaonly_flipped'].values,
                                score_tab['BCE'].values)

# ---------- Belau openness Pearson r across 5 overlapping horizons (BCE 1100..700) ----------
# bin: BCE=1100 -> CE[-1150,-1050); ... ; 700 -> CE[-750,-650)
bce_to_belau = {}
for b in [1100, 1000, 900, 800, 700]:
    lo, hi = -(b + 50), -(b - 50)
    sub = pol[(pol['CE'] >= lo) & (pol['CE'] < hi)]
    bce_to_belau[b] = float(sub['Belau_PC1_inter'].mean()) if len(sub) else np.nan
    print(f'Belau_PC1_inter mean BCE {b} (CE[{lo},{hi}), n={len(sub)}): '
          f'{bce_to_belau[b]:+.4f}')

bce_overlap  = [b for b in [1100,1000,900,800,700]
                if not np.isnan(bce_to_belau.get(b, np.nan))]
belau_series = np.array([bce_to_belau[b] for b in bce_overlap])
si_full = score_tab.set_index('BCE').loc[bce_overlap, 'PC1_full_flipped']
si_yba  = score_tab.set_index('BCE').loc[bce_overlap, 'PC1_ybaonly_flipped']
r_full    = float(pd.Series(si_full.values).corr(pd.Series(belau_series)))
r_ybaonly = float(pd.Series(si_yba .values).corr(pd.Series(belau_series)))
print(f'Pearson r (Belau, PC1_full_flipped)    = {r_full:+.4f}')
print(f'Pearson r (Belau, PC1_ybaonly_flipped) = {r_ybaonly:+.4f}')

# ---------- save tables ----------
score_tab.round(4).to_csv(os.path.join(OUT, 'yba_pc1_scores.csv'), index=False)
diff_tab.round(4).to_csv(os.path.join(OUT, 'pc1_diffs_1100_vs_rest.csv'), index=False)
loadings_full_flip.iloc[:, :5].round(4).to_csv(
    os.path.join(OUT, 'loadings_full_flipped.csv'))
loadings_yba_flip.iloc[:, :5].round(4).to_csv(
    os.path.join(OUT, 'loadings_yba_only_flipped.csv'))

scree_full = pd.DataFrame({
    'PC':[f'PC{i+1}' for i in range(len(evr_full))],
    'explained_variance_ratio':[round(float(x),4) for x in evr_full]})
scree_yba  = pd.DataFrame({
    'PC':[f'PC{i+1}' for i in range(len(evr_yba))],
    'explained_variance_ratio':[round(float(x),4) for x in evr_yba]})
scree_full.to_csv(os.path.join(OUT,'scree_full.csv'), index=False)
scree_yba .to_csv(os.path.join(OUT,'scree_ybaonly.csv'), index=False)

# ---------- prints for the deliverable ----------
print('\n========== SCREE — PCA-full (n=39) ==========')
print(scree_full.to_string(index=False))
print('\n========== SCREE — PCA-YBA-only (n=7, p=10) ==========')
print(scree_yba.to_string(index=False))

print('\n========== LOADINGS (flipped PC1) ==========')
print('PCA-full  PC1,PC2:')
print(loadings_full_flip[['PC1','PC2']].round(4))
print('\nPCA-YBA-only PC1,PC2:')
print(loadings_yba_flip[['PC1','PC2']].round(4))

print('\n========== PC1 AT 7 YBA HORIZONS ==========')
print(score_tab.round(4).to_string(index=False))

print('\n========== DIFFS  PC1(1100) − PC1(t) ==========')
print(diff_tab.round(4).to_string(index=False))

print('\n========== VERDICTS ==========')
print('PCA-full  : side', verdict_full[1],
      'inside_outside:', verdict_full[0],
      'rest_min', round(float(verdict_full[2]),4),
      'rest_max', round(float(verdict_full[3]),4),
      'pc1@1100', round(float(pc1_1100_full),4))
print('PCA-YBA   : side', verdict_ybaonly[1],
      'inside_outside:', verdict_ybaonly[0],
      'rest_min', round(float(verdict_ybaonly[2]),4),
      'rest_max', round(float(verdict_ybaonly[3]),4),
      'pc1@1100', round(float(pc1_1100_ybaonly),4))

print('\n========== POLLEN CONTEXT ==========')
print('horizons_covered_BCE      :', bce_overlap)
print('Belau_PC1_inter           :', [round(float(v),4) for v in belau_series])
print('PC1_full_flipped (5)      :', [round(float(v),4) for v in si_full.values])
print('PC1_ybaonly_flipped (5)   :', [round(float(v),4) for v in si_yba.values])
print(f'r_full vs Belau           : {r_full:+.4f}')
print(f'r_ybaonly vs Belau        : {r_ybaonly:+.4f}')
print('Note: BCE 600 and 500 have NO pollen coverage (pollen file ends at CE=-702).')

print('\nOutputs saved to', OUT)

# ---------- consolidated JSON for the submission payload ----------
result_json = {
    'yba_horizons_BCE'        : BCE_ordered,
    'pca_full': {
        'n_obs_full_fit'       : int(X_full.shape[0]),
        'features_used'        : FEAT12,
        'explained_variance_ratio' : [round(float(x),4) for x in evr_full[:5]],
        'loadings_PC1_PC2_raw' : {
            col: {f: round(float(loadings_full.iloc[i, j]),4)
                  for i,f in enumerate(FEAT12)}
            for j,col in enumerate(['PC1','PC2'])
        },
        'loadings_PC1_PC2_flipped' : {
            col: {f: round(float(loadings_full_flip.iloc[i, j]),4)
                  for i,f in enumerate(FEAT12)}
            for j,col in enumerate(['PC1','PC2'])
        },
        'pc1_sign_flip_applied' : int(flip_full),
        'pc1_at_each_yba_horizon_raw'    : [round(float(v),4) for v in pc1_yba_full_raw],
        'pc1_at_each_yba_horizon_flipped': [round(float(v),4) for v in pc1_yba_full_flip],
    },
    'pca_yba_only': {
        'n_obs_fit'             : int(X_yba.shape[0]),
        'features_used'         : feat10,
        'dropped_zero_var'      : ZERO_VAR_IN_YBA,
        'explained_variance_ratio' : [round(float(x),4) for x in evr_yba[:5]],
        'loadings_PC1_PC2_raw'  : {
            col: {f: round(float(loadings_yba.iloc[i, j]),4)
                  for i,f in enumerate(feat10)}
            for j,col in enumerate(['PC1','PC2'])
        },
        'loadings_PC1_PC2_flipped' : {
            col: {f: round(float(loadings_yba_flip.iloc[i, j]),4)
                  for i,f in enumerate(feat10)}
            for j,col in enumerate(['PC1','PC2'])
        },
        'pc1_sign_flip_applied' : int(flip_yba),
        'pc1_at_each_yba_horizon_raw'    : [round(float(v),4) for v in pc1_ybaonly_raw],
        'pc1_at_each_yba_horizon_flipped': [round(float(v),4) for v in pc1_ybaonly_flip],
    },
    'diff_pc1_1100_minus_t_full_flipped'    : [round(float(v),4) for v in diff_full],
    'diff_pc1_1100_minus_t_ybaonly_flipped' : [round(float(v),4) for v in diff_ybaonly],
    'verdict_full'    : {'inside_outside': verdict_full[0],
                         'which_side'    : verdict_full[1],
                         'rest_min'      : round(float(verdict_full[2]),4),
                         'rest_max'      : round(float(verdict_full[3]),4),
                         'pc1_at_1100'   : round(float(pc1_1100_full),4)},
    'verdict_ybaonly' : {'inside_outside': verdict_ybaonly[0],
                         'which_side'    : verdict_ybaonly[1],
                         'rest_min'      : round(float(verdict_ybaonly[2]),4),
                         'rest_max'      : round(float(verdict_ybaonly[3]),4),
                         'pc1_at_1100'   : round(float(pc1_1100_ybaonly),4)},
    'belau_openness_overlap' : {
        'horizons_covered_BCE'  : bce_overlap,
        'pc1_full_overlap'      : [round(float(v),4) for v in si_full.values],
        'pc1_ybaonly_overlap'   : [round(float(v),4) for v in si_yba.values],
        'belau_openness_pc1'    : [round(float(v),4) for v in belau_series],
        'pearson_r_full_vs_belau' : round(r_full,4),
        'pearson_r_ybaonly_vs_belau' : round(r_ybaonly,4),
        'missing_horizons_BCE'  : [600, 500],
        'reason'                : 'pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv CE range is -4785..-702 BCE; CE >= -650 has 0 coverage.'
    },
}
with open(os.path.join(OUT,'pca_results.json'),'w') as f:
    json.dump(result_json, f, indent=2)

print('\nJSON saved to', os.path.join(OUT,'pca_results.json'))
