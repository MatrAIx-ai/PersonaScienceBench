"""PCA on forms of capital, 100-year time slices - symbolic submatrix analysis.

NumPy-only implementation (no sklearn available in environment):
  Covariance of pre-standardised Z columns equals the correlation matrix.
  Eigen-decomposition of the covariance matrix gives loadings and PC scores.
"""
from __future__ import annotations
import json, pathlib
import numpy as np
import pandas as pd

DATA = pathlib.Path("/workspace/data/capital.csv")
OUT  = pathlib.Path("/workspace/artifacts"); OUT.mkdir(parents=True, exist_ok=True)

# -------- 1. Detect delimiter / decimal and parse 12 Z columns to float ----
raw_preview = DATA.read_text(encoding="utf-8")
delimiter = ";" if raw_preview.splitlines()[0].count(";") > \
                   raw_preview.splitlines()[0].count(",") else ","
print("Detected delimiter:", repr(delimiter))
df = pd.read_csv(DATA, delimiter=delimiter)
print("Loaded shape:", df.shape, "columns:", list(df.columns))

z_cols_all = ["ZAxtSchwert","ZDolch","Zhausgr","ZCU_AU","Zamber","ZMonument",
              "ZHort","ZSichel","ZBeil","ZMW","ZKeform","Zkeverz"]
def _to_float(col):
    if df[col].dtype == "O" or str(df[col].dtype) == "str":
        s = df[col].astype(str).str.strip().str.replace(".", "", regex=False)\
                                            .str.replace(",", ".", regex=False)
        return pd.to_numeric(s, errors="coerce")
    return pd.to_numeric(df[col], errors="coerce")
for c in z_cols_all:
    df[c] = _to_float(c)
print("Missing per Z-column (post-coerce):")
print(df[z_cols_all].isna().sum())

meta_keep = ["BCE","group","color"]
df = df[meta_keep + z_cols_all].sort_values("BCE", ascending=False).reset_index(drop=True)
print(f"BCE range: {df['BCE'].min()}..{df['BCE'].max()}; n={len(df)}")
assert len(df) == 39 and df["BCE"].is_monotonic_decreasing

# Helper for the eigen-PCA (replicates sklearn's PCA on the covariance matrix)
def fit_pca(X):
    n = X.shape[0]
    Xc = X - X.mean(axis=0, keepdims=True)
    C = (Xc.T @ Xc) / (n - 1)            # covariance = correlation for Z-columns
    eigvals, eigvecs = np.linalg.eigh(C)
    order = np.argsort(eigvals)[::-1]    # descending
    eigvals = eigvals[order]
    eigvecs = eigvecs[:, order]
    scores = Xc @ eigvecs
    total = eigvals.sum()
    return eigvals, eigvecs, scores, eigvals / total

# -------- 2. Symbolic submatrix descriptives -------------------------------
sym_vars = ["Zhausgr","ZDolch","ZAxtSchwert"]
S = df[sym_vars].to_numpy()
print("\n=== Symbolic submatrix descriptive stats (39 slices) ===")
desc = df[sym_vars].describe().T
desc["skew"] = df[sym_vars].skew()
desc["kurtosis"] = df[sym_vars].kurt()
print(desc.round(3).to_string())
near_zero = desc[desc["std"].abs() < 1e-6]
print("Near-zero symbolic vars:", list(near_zero.index) if len(near_zero) else "none")
corr = df[sym_vars].corr().round(3)
print("\nCorrelation matrix (symbolic triad):")
print(corr.to_string())

# -------- 3. Pooled PCA on symbolic 39x3 matrix ----------------------------
eig_vals, eig_vecs, scores, exp_var = fit_pca(S)
loadings_raw = eig_vecs[:, :2]                       # (3, 2)
explained = exp_var[:2]
print("\n=== PCA on symbolic submatrix (raw) ===")
print(f"eigenvalues (PC1, PC2) = {eig_vals[0]:.4f}, {eig_vals[1]:.4f}")
print(f"explained_variance_ratio_ PC1={explained[0]:.4f} PC2={explained[1]:.4f} "
      f"sum={explained.sum():.4f}")
load_raw = pd.DataFrame(loadings_raw, index=sym_vars, columns=["PC1","PC2"]).round(4)
print("Raw loadings:")
print(load_raw.to_string())

# -------- 4. Sign-normalise both axes --------------------------------------
def sign_normalise(loadings, scores, names):
    L = loadings.copy(); Z = scores.copy(); info = {}
    for k in range(L.shape[1]):
        j = int(np.argmax(np.abs(L[:, k])))
        sgn = 1.0 if L[j, k] >= 0 else -1.0
        L[:, k] *= sgn
        Z[:, k] *= sgn
        info[f"PC{k+1}"] = {"anchor_var": names[j],
                            "raw_loading": float(loadings[j, k]),
                            "factor": float(sgn)}
    return L, Z, info

L, Z, sign_info = sign_normalise(loadings_raw, scores, sym_vars)
print("\n=== Sign-normalisation info (symbolic PCA) ===")
print(json.dumps(sign_info, indent=2))
load_norm = pd.DataFrame(L, index=sym_vars, columns=["PC1","PC2"]).round(4)
print("Normalised loadings:")
print(load_norm.to_string())

scores_df = pd.DataFrame(Z[:, :2], columns=["PC1","PC2"])
scores_df.insert(0, "BCE", df["BCE"].values)
scores_df.insert(1, "group", df["group"].values)

# -------- 5. Per-variable synthesis ----------------------------------------
print("\n=== Per-variable synthesis (symbolic) ===")
rows = []
for v in sym_vars:
    pc1_load = float(L[sym_vars.index(v), 0])
    pc2_load = float(L[sym_vars.index(v), 1])
    q = scores_df["PC2"].quantile([0.0, 0.25, 0.5, 0.75, 1.0]).round(3)
    rows.append({"variable": v, "PC1_loading": round(pc1_load, 3),
                 "PC2_loading": round(pc2_load, 3),
                 "PC2_min": float(q.loc[0.0]), "PC2_q1": float(q.loc[0.25]),
                 "PC2_med": float(q.loc[0.5]), "PC2_q3": float(q.loc[0.75]),
                 "PC2_max": float(q.loc[1.0])})
print(pd.DataFrame(rows).to_string(index=False))

print("\n=== Per-slice PC1/PC2 summaries (39 slices) ===")
for c in ["PC1","PC2"]:
    q = scores_df[c].quantile([0, .25, .5, .75, 1]).round(3)
    sk = round(float(scores_df[c].skew()), 3)
    print(f"{c}: min={q.loc[0]} q1={q.loc[0.25]} med={q.loc[0.5]} "
          f"q3={q.loc[0.75]} max={q.loc[1]} skew={sk}")

print("\n=== Mean PC1/PC2 by cultural group ===")
print(scores_df.groupby("group")[["PC1","PC2"]].mean().round(3).to_string())

print("\nSlices with highest PC1:")
print(scores_df.nlargest(5, "PC1")[["BCE","group","PC1","PC2"]].to_string(index=False))
print("\nSlices with lowest PC1:")
print(scores_df.nsmallest(5, "PC1")[["BCE","group","PC1","PC2"]].to_string(index=False))
print("\nSlices with highest PC2:")
print(scores_df.nlargest(3, "PC2")[["BCE","group","PC1","PC2"]].to_string(index=False))
print("\nSlices with lowest PC2:")
print(scores_df.nsmallest(3, "PC2")[["BCE","group","PC1","PC2"]].to_string(index=False))

# -------- 6. Context PCA on full 12-capital matrix -------------------------
Sfull = df[z_cols_all].to_numpy()
ev_f, evc_f, sc_f, exp_f = fit_pca(Sfull)
expl_full = exp_f[:2]
print("\n=== PCA on full 12-capital matrix (context) ===")
print(f"eigenvalues PC1={ev_f[0]:.4f}, PC2={ev_f[1]:.4f}")
print(f"explained_variance_ratio_ PC1={expl_full[0]:.4f} PC2={expl_full[1]:.4f}")
load_full_raw = pd.DataFrame(evc_f[:, :2], index=z_cols_all,
                              columns=["PC1","PC2"]).round(3)
print(load_full_raw.to_string())

def sign_norm_full(Lin):
    L2 = Lin.copy(); info = {}
    sym_idxs = [z_cols_all.index(v) for v in sym_vars]
    for k in range(L2.shape[1]):
        sym_loads = np.abs(L2[sym_idxs, k])
        if sym_loads.max() >= 0.9 * np.abs(L2[:, k]).max():
            j = sym_idxs[int(np.argmax(sym_loads))]
            anchor = "symbolic"
        else:
            j = int(np.argmax(np.abs(L2[:, k])))
            anchor = "global"
        sgn = 1.0 if L2[j, k] >= 0 else -1.0
        L2[:, k] *= sgn
        info[f"PC{k+1}"] = {"anchor": anchor, "var": z_cols_all[j],
                            "factor": float(sgn)}
    return L2, info

Lf, info_f = sign_norm_full(evc_f[:, :2])
print("\nSign-normalisation (full PCA):")
print(json.dumps(info_f, indent=2))
print("\nNormalised full-PC loadings:")
print(pd.DataFrame(Lf, index=z_cols_all, columns=["PC1","PC2"]).round(3).to_string())

# -------- 7. Persist artefacts ---------------------------------------------
desc.round(4).to_csv(OUT/"symbolic_descriptives.csv")
corr.to_csv(OUT/"symbolic_correlation.csv")
load_norm.to_csv(OUT/"symbolic_loadings.csv")
pd.DataFrame(rows).to_csv(OUT/"symbolic_pc1_pc2_summary.csv", index=False)
scores_df.to_csv(OUT/"symbolic_slice_scores.csv", index=False)
load_full_raw.to_csv(OUT/"full_loadings_raw.csv")
pd.DataFrame(Lf, index=z_cols_all, columns=["PC1","PC2"]).round(4)\
    .to_csv(OUT/"full_loadings_normalised.csv")
ev_csv = pd.DataFrame({"PC":[f"PC{i+1}" for i in range(len(ev_f))],
                       "eigenvalue": ev_f, "explained_ratio": exp_f})
ev_csv.to_csv(OUT/"symbolic_pca_eigenvalues.csv", index=False)
print("\nWrote artefacts to", OUT)

# Compute group-mean scores on PC2 for context
gmean = scores_df.groupby("group")["PC2"].mean().round(3).to_dict()
print("\nGroup-mean PC2:", gmean)

