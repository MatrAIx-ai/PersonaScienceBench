pc1_h = L[sym_vars.index("Zhausgr"), 0]; pc1_d = L[sym_vars.index("ZDolch"),    0]; pc1_a = L[sym_vars.index("ZAxtSchwert"), 0]
pc2_h = L[sym_vars.index("Zhausgr"), 1]; pc2_d = L[sym_vars.index("ZDolch"),    1]; pc2_a = L[sym_vars.index("ZAxtSchwert"), 1]
