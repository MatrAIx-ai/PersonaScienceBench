# ---- 2. FIT HELPERS ------------------------------------------------------
def tidy(mod, label, family):
    ci = mod.conf_int(); rows = []
    for name in mod.params.index:
        rows.append({"model":label,"family":family,"term":name,
                     "coef":float(mod.params[name]),"se":float(mod.bse[name]),
                     "z":float(mod.params[name]/mod.bse[name]),
                     "p":float(mod.pvalues[name]),
                     "ci_lo":float(ci.loc[name,0]),"ci_hi":float(ci.loc[name,1]),
                     "n":int(mod.nobs)})
    return pd.DataFrame(rows)

def fit_logit(formula, label):
    mod = smf.logit(formula, data=df).fit(disp=0, maxiter=200)
    return mod, tidy(mod, label, "logit")

def fit_ols(formula, label):
    mod = smf.ols(formula, data=df).fit()
    return mod, tidy(mod, label, "ols_lpm")

