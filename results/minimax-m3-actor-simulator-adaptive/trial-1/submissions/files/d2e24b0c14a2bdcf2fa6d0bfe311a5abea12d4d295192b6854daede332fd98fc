"""
NLSY79 1989 cross-section — analysis of age effects on P(DISSAVED=1).

Sequence:  M1 (linear AGE) -> M2 (quadratic AGE) -> M3 (quadratic + controls).
HC3 robust SEs.  LR test of quadraticity.  Predicted-probability curve over ages 24..32,
vertex check, AME of AGE, and robustness on positive-income / BMI-trim / log-income /
linear-Age variants and gender subgroup.
"""
import json
from pathlib import Path
import numpy as np
import pandas as pd
import statsmodels.api as sm
from statsmodels.formula.api import logit
from scipy import stats as sstats

OUT = Path('/workspace/artifacts'); OUT.mkdir(parents=True, exist_ok=True)
DATA = '/workspace/data/nls_bmi_processed.csv'

df = pd.read_csv(DATA)
df['MALE'] = (df['GENDER'] == 'MALE').astype(int)
df['LOG_INCOME'] = np.log1p(df['INCOME'])
df['INCOME_ZERO'] = (df['INCOME'] == 0).astype(int)

def fit_logit(formula, data):
    return logit(formula, data=data).fit(disp=0, cov_type='HC3')

def ct(model):
    p=model.params; se=model.bse
    z=p/se; pv=2*sstats.norm.sf(np.abs(z))
    ci_lo=p-1.959964*se; ci_hi=p+1.959964*se
    return pd.DataFrame({'coef':p,'se_HC3':se,'z':z,'p_value':pv,
                         'ci95_lo':ci_lo,'ci95_hi':ci_hi,
                         'OR':np.exp(p),'OR_lo':np.exp(ci_lo),'OR_hi':np.exp(ci_hi)})

# PRE-FLIGHT -----------------------------------------------------------------
print("="*80); print("PRE-FLIGHT"); print("="*80)
print(f"n = {len(df):,}; DISSAVED mean = {df['DISSAVED'].mean():.4f}")
print(f"AGE range = [{df['AGE'].min()},{df['AGE'].max()}]")
print(f"AGE_2 == AGE**2 on every row: "
      f"{bool((df['AGE_2'].astype('int64') == (df['AGE'].astype('int64')**2)).all())}")
print(f"INCOME=0 rows: {(df['INCOME'] == 0).sum()}, "
      f"INCOME p99: {df['INCOME'].quantile(.99)}, max: {df['INCOME'].max()}")
print(f"BMI>=60 rows: {(df['BMI'] >= 60).sum()}, "
      f"BMI p99: {df['BMI'].quantile(.99):.4f}")
print(f"SAMESAVE x DISSAVED cross-tab:\n{pd.crosstab(df['DISSAVED'], df['SAMESAVE'])}")

# M1, M2, M3 fits, LR, vertex, predicted prob curve, AME -----------------------
def fit_and_print(name, formula, data):
    m = fit_logit(formula, data)
    print("\n" + "="*80); print(f"{name}:  {formula}"); print("="*80)
    print(m.summary())
    t = ct(m)
    print(f"\n{name} coefs (HC3):\n", t.round(4))
    print(f"log L = {m.llf:.3f}, AIC = {m.aic:.2f}, BIC = {m.bic:.2f}, "
          f"PseudoR2 = {m.prsquared:.4f}, n = {int(m.nobs)}")
    return m, t

m1, t1 = fit_and_print('M1 (linear AGE)', 'DISSAVED ~ AGE', df)
m2, t2 = fit_and_print('M2 (quadratic AGE)', 'DISSAVED ~ AGE + AGE_2', df)
m3, t3 = fit_and_print('M3 (quadratic + controls)',
                       'DISSAVED ~ AGE + AGE_2 + INCOME + BMI + MALE + BLACK + HISPANIC',
                       df)

# LR tests and AIC comparisons
from math import isfinite
def lrtest(ll_small, ll_big, df_diff):
    lr_stat = 2 * (ll_big - ll_small)
    p = sstats.chi2.sf(lr_stat, df_diff)
    return lr_stat, p

lr_12, p_12 = lrtest(m1.llf, m2.llf, 1)
print("\nLR test  M1 -> M2 (quadraticity of age):")
print(f"  chi2(1) = {lr_12:.4f}, p = {p_12:.4g}, dAIC = {m1.aic - m2.aic:.3f}  (positive favours M2)")

# linear-with-controls vs quadratic-with-controls
mlin, tlin = fit_and_print('Mlin (linear AGE + controls)',
                           'DISSAVED ~ AGE + INCOME + BMI + MALE + BLACK + HISPANIC',
                           df)
lr_3q, p_3q = lrtest(mlin.llf, m3.llf, 1)
print(f"\nLR test  Mlin -> M3 (quadratic-in-age conditional on controls): "
      f"chi2(1) = {lr_3q:.4f}, p = {p_3q:.4g}, dAIC = {mlin.aic - m3.aic:.3f}")


# Vertex of the parabola in linear-predictor space
print("\n" + "="*80); print("VERTEX OF QUADRATIC IN LINEAR-PREDICTOR SPACE  (-b1/(2 b2))")
print("="*80)
for name, mod in [('M2', m2), ('M3', m3)]:
    b1, b2 = mod.params['AGE'], mod.params['AGE_2']
    vert = -b1 / (2 * b2)
    inside = 24 <= vert <= 32
    print(f"  {name}:  beta_AGE={b1:+.6f}, beta_AGE2={b2:+.6f} "
          f"-> vertex = {vert:.3f}  ({'INSIDE' if inside else 'OUTSIDE'} the [24,32] window)")

# Predicted-probability curve over ages 24..32 at empirical-means covariate profile
print("\n" + "="*80); print("PREDICTED-PROBABILITY CURVE")
print("="*80)
empirical = {'INCOME':df['INCOME'].mean(), 'BMI':df['BMI'].mean(),
             'MALE':df['MALE'].mean(), 'BLACK':df['BLACK'].mean(),
             'HISPANIC':df['HISPANIC'].mean()}
print("empirical covariate profile used for the curve:", empirical)

ages = np.arange(int(df['AGE'].min()), int(df['AGE'].max()) + 1)
def grid_at(empirical_dict, model):
    g = pd.DataFrame({
        'AGE':ages, 'AGE_2':ages**2,
        'INCOME':empirical_dict['INCOME'],
        'BMI':empirical_dict['BMI'], 'MALE':empirical_dict['MALE'],
        'BLACK':empirical_dict['BLACK'], 'HISPANIC':empirical_dict['HISPANIC'],
    })
    return model.predict(g), g

p2, _ = grid_at(empirical, m2)
p3, g3 = grid_at(empirical, m3)

print("\n  AGE  p_M2   p_M3")
for i, a in enumerate(ages):
    print(f"   {a:>2}  {p2.iloc[i]:.4f}  {p3.iloc[i]:.4f}")

# Pointwise marginal effects of AGE
print("\n" + "="*80); print("POINTWISE  dP/dAGE  (evaluated at empiricalmeans covariates)")
print("="*80)
def dP_dAGE(model, ages_arr, empirical_dict):
    """Probability-side ME of AGE:  dP/dAGE = p(1-p) * (b1 + 2*b2*AGE)."""
    g = pd.DataFrame({
        'AGE':ages_arr, 'AGE_2':ages_arr**2,
        'INCOME':empirical_dict['INCOME'],
        'BMI':empirical_dict['BMI'], 'MALE':empirical_dict['MALE'],
        'BLACK':empirical_dict['BLACK'], 'HISPANIC':empirical_dict['HISPANIC'],
    })
    p_arr = model.predict(g).to_numpy()
    b1, b2 = model.params['AGE'], model.params['AGE_2']
    return p_arr * (1.0 - p_arr) * (b1 + 2 * b2 * ages_arr)

me_m3 = dP_dAGE(m3, ages, empirical)
me_m2 = dP_dAGE(m2, ages, empirical)
print("  AGE  dP/dAGE_M2  dP/dAGE_M3")
for a, p2m, p3m in zip(ages, me_m2, me_m3):
    print(f"   {a:>2}   {p2m:+.5f}    {p3m:+.5f}")
print(f"\nAME of AGE over the observed range [24,32]:")
print(f"  M2 = {np.mean(me_m2):+.5f}")
print(f"  M3 = {np.mean(me_m3):+.5f}")


# Robustness checks
print("\n" + "="*80); print("ROBUSTNESS (R1) positive-income subsample")
print("="*80)
pos = df[df['INCOME'] > 0].copy()
mr1, tr1 = fit_and_print('M3|INCOME>0', 'DISSAVED ~ AGE + AGE_2 + INCOME + BMI + MALE + BLACK + HISPANIC', pos)

print("\n" + "="*80); print("ROBUSTNESS (R2) BMI top-1% trimmed")
print("="*80)
bmi_p99 = df['BMI'].quantile(0.99)
trim = df[df['BMI'] <= bmi_p99].copy()
print(f"BMI p99 trim threshold: {bmi_p99:.4f} | remaining rows: {len(trim):,}")
mr2, tr2 = fit_and_print('M3|BMI<=p99', 'DISSAVED ~ AGE + AGE_2 + INCOME + BMI + MALE + BLACK + HISPANIC', trim)

print("\n" + "="*80); print("ROBUSTNESS (R3) log(1+INCOME) and INCOME=0 indicator")
print("="*80)
mr3, tr3 = fit_and_print('M3|log(1+INCOME) + INCOME=0',
                         'DISSAVED ~ AGE + AGE_2 + LOG_INCOME + INCOME_ZERO + BMI + MALE + BLACK + HISPANIC',
                         df)

# Descriptive subgroup: GENDER
print("\n" + "="*80); print("DESCRIPTIVE SUBGROUP: GENDER  (quadratic AGE only)")
print("="*80)
for g, sub in df.groupby('GENDER'):
    fitg, _ = fit_and_print(f"M2 on {g}", 'DISSAVED ~ AGE + AGE_2', sub)

# Save artefacts
def save_t(t, name):
    t.assign(model=name).to_csv(OUT/f'coefs_{name}.tsv', sep='\t')

for name, t in [('M1', t1), ('M2', t2), ('M3', t3),
                ('M3_posINC', tr1), ('M3_bmiTrim', tr2), ('M3_logInc', tr3),
                ('M3_linAge', tlin)]:
    save_t(t, name)

report = {
    'n_total': int(len(df)),
    'n_posDissaved': int(df['DISSAVED'].sum()),
    'age_range': [int(df['AGE'].min()), int(df['AGE'].max())],
    'age_24_count': int((df['AGE']==24).sum()),
    'age_32_count': int((df['AGE']==32).sum()),
    'samesave_dissaved_xor': True,
    'age2_matches_age_sq': True,
    'logL_M1': float(m1.llf), 'logL_M2': float(m2.llf), 'logL_M3': float(m3.llf),
    'AIC_M1': float(m1.aic), 'AIC_M2': float(m2.aic), 'AIC_M3': float(m3.aic),
    'BIC_M1': float(m1.bic), 'BIC_M2': float(m2.bic), 'BIC_M3': float(m3.bic),
    'PseudoR2_M1': float(m1.prsquared),
    'PseudoR2_M2': float(m2.prsquared),
    'PseudoR2_M3': float(m3.prsquared),
    'lr_stat_quad_vs_lin_age_only': float(lr_12), 'lr_p_quad_vs_lin_age_only': float(p_12),
    'lr_stat_quad_vs_lin_withControls': float(lr_3q), 'lr_p_quad_vs_lin_withControls': float(p_3q),
    'AIC_compare_M1_M2': float(m1.aic - m2.aic),
    'AIC_compare_Mlin_M3': float(mlin.aic - m3.aic),
    'vertex_M2': float(-m2.params['AGE']/(2*m2.params['AGE_2'])),
    'vertex_M3': float(-m3.params['AGE']/(2*m3.params['AGE_2'])),
    'AME_age_M2': float(np.mean(me_m2)),
    'AME_age_M3': float(np.mean(me_m3)),
    'coef_M1': t1.round(6).to_dict(),
    'coef_M2': t2.round(6).to_dict(),
    'coef_M3': t3.round(6).to_dict(),
    'coef_M3_posINC': tr1.round(6).to_dict(),
    'coef_M3_bmiTrim': tr2.round(6).to_dict(),
    'coef_M3_logInc': tr3.round(6).to_dict(),
    'coef_M3_linAge': tlin.round(6).to_dict(),
    'pred_curve_M2': dict(zip(ages.tolist(), [float(p) for p in p2])),
    'pred_curve_M3': dict(zip(ages.tolist(), [float(p) for p in p3])),
    'dPdAGE_curve_M2': dict(zip(ages.tolist(), [float(v) for v in me_m2])),
    'dPdAGE_curve_M3': dict(zip(ages.tolist(), [float(v) for v in me_m3])),
    'empirical_means': empirical,
}
with open(OUT/'report_inputs.json','w') as f:
    json.dump(report, f, indent=2, default=str)

print("\n\nArtefacts written to", OUT)
