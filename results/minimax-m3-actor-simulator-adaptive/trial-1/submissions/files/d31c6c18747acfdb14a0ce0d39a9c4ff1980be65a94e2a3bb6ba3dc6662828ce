"""
Inspection script for the replication-heterogeneity dataset.
Read-only; produces row counts, missing-values, and duplicate diagnostics
for project == 'ee' (Experimental Economics) and project == 'rpp' (Psychology).
"""
import pandas as pd
pd.set_option('display.width', 200)

df = pd.read_csv('/workspace/data/meta-regression_study_data_heterogeneity_in_replication_projects.csv')
ee  = df[df['project'] == 'ee'].copy()
rpp = df[df['project'] == 'rpp'].copy()

print("Total rows:", len(df))
print("Project counts:", df['project'].value_counts().to_dict())

# Per-subset diagnostics
for name, sub in [('ee',  ee), ('rpp', rpp)]:
    n_na = sub['length'].isna().sum()
    n_unique = sub['id'].nunique()
    n_unique_titles = sub.drop_duplicates(
        subset=['title','authors.o','journal']).shape[0]
    print(f"\n[{name}] rows={len(sub)}, unique id={n_unique}, "
          f"unique (title+authors.o+journal)={n_unique_titles}, "
          f"missing length={n_na}, drop==True: "
          f"{(sub['drop']==True).sum()}")
    print(f"[{name}] length mean={sub['length'].mean():.3f}, "
          f"median={sub['length'].median():.3f}, "
          f"std={sub['length'].std():.3f}, "
          f"min={sub['length'].min()}, max={sub['length'].max()}")

