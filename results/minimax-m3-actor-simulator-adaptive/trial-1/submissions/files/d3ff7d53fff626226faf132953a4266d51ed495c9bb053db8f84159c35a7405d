"""
DiscoveryBench analysis: effect of education expenditure on per-capita GDP,
LMC (developing) vs SSA (Sub-Saharan Africa). Source CSV is wide-format
panel of 2 country groups x 6 indicators x 41 years (1975-2015).
"""
import json, warnings
from pathlib import Path
import numpy as np
import pandas as pd
import statsmodels.api as sm
import statsmodels.formula.api as smf

warnings.filterwarnings("ignore")
pd.options.display.width = 200
pd.options.display.max_columns = 40

DATA = Path("/workspace/data/worldbank_education_gdp.csv")
OUT_DIR = Path("/workspace/artifacts")
OUT_DIR.mkdir(exist_ok=True)

# ===== 0. Load & reshape wide -> long =====
df = pd.read_csv(DATA)
non_year = ["Country Group","Country Code","Series Name","Series Code"]
year_cols = [c for c in df.columns if "YR" in c]
assert len(year_cols)==41

long = df.melt(id_vars=non_year, value_vars=year_cols,
               var_name="YearCol", value_name="Value")
long["Year"] = long["YearCol"].str.extract(r"(\d{4})").astype(int)
long["ValueNum"] = pd.to_numeric(long["Value"], errors="coerce")

def pivot_series(code):
    sub = long[long["Series Code"]==code]
    return sub.pivot_table(index=["Country Group","Year"],
                           values="ValueNum", aggfunc="first")

# OUTER join so we keep all rows even where gni_pc is NaN
panel = pivot_series("NY.GNP.PCAP.KD").rename(columns={"ValueNum":"gni_pc"})
for code, name in [("NY.ADJ.AEDU.GN.ZS","edu_exp"),
                   ("NE.EXP.GNFS.KD.ZG","exports_g"),
                   ("SE.PRM.ENRR","prim_enr"),
                   ("SE.SEC.ENRR","sec_enr"),
                   ("SL.TLF.CACT.ZS","lab_force")]:
    panel = panel.join(pivot_series(code).rename(columns={"ValueNum":name}),
                       how="outer")
panel = panel.reset_index().sort_values(["Country Group","Year"]).reset_index(drop=True)

# log transforms
panel["log_gni_pc"]   = np.log(panel["gni_pc"])
panel["log_prim_enr"] = np.log(panel["prim_enr"])
panel["log_sec_enr"]  = np.log(panel["sec_enr"])
panel["is_ssa"]       = (panel["Country Group"]=="Sub-Saharan Africa").astype(int)
panel.to_csv(OUT_DIR/"panel_long.csv", index=False)

print(f"panel: {panel.shape[0]} rows ({int((panel['is_ssa']==1).sum())} SSA, {int((panel['is_ssa']==0).sum())} LMC)")
print("non-null counts by group:")
counts = (panel.groupby("Country Group")
                [["gni_pc","edu_exp","exports_g","prim_enr","sec_enr","lab_force"]]
                .agg(lambda s: f"{int(s.notna().sum())}/{len(s)}"))
print(counts.to_string())

# ===== 1. Descriptive by group =====
desc = (panel.groupby("Country Group")
             .agg(mean_gni=("gni_pc","mean"), sd_gni=("gni_pc","std"),
                  mean_edu=("edu_exp","mean"), sd_edu=("edu_exp","std"),
                  mean_prim=("prim_enr","mean"), mean_sec=("sec_enr","mean"),
                  mean_lf=("lab_force","mean"), mean_exp=("exports_g","mean"),
                  yrs_gni=("gni_pc", lambda s: f"{int(s.dropna().min())}-{int(s.dropna().max())} ({s.notna().sum()})"))
             .round(3))
print("\n=== Group means (using only non-null obs per series) ===")
print(desc)

# ===== 2. Per-group simple within-group slopes =====
def per_group_slope(sub):
    out = {}
    for g, d in sub.groupby("is_ssa"):
        d = d.dropna(subset=["log_gni_pc","edu_exp"])
        gname = {0:"LMC", 1:"SSA"}.get(g, str(g))
        if len(d) < 3:
            out[gname] = dict(n=len(d), slope=float("nan"), se=float("nan"), p=float("nan"))
            continue
        m = smf.ols("log_gni_pc ~ edu_exp", data=d).fit(cov_type="HC1")
        out[gname] = dict(n=int(len(d)),
                          slope=float(m.params["edu_exp"]),
                          se=float(m.bse["edu_exp"]),
                          p=float(m.pvalues["edu_exp"]))
    return out

pg_full = per_group_slope(panel.dropna(subset=["gni_pc","edu_exp","prim_enr","sec_enr","exports_g"]))
pg_9115 = per_group_slope(panel[(panel["Year"]>=1991)].dropna(
        subset=["gni_pc","edu_exp","prim_enr","sec_enr","exports_g","lab_force"]))
pg_1115 = per_group_slope(panel[(panel["Year"]>=2011)].dropna(
        subset=["gni_pc","edu_exp","prim_enr","sec_enr","exports_g","lab_force"]))

print("\n=== Per-group simple OLS: log(GNIpc) ~ EduExp (HC1) ===")
for lbl, pg in [("Full 1975-2015 (no LF ctrl)", pg_full),
                ("1991-2015 (with LF)", pg_9115),
                ("2011-2015 (with LF)", pg_1115)]:
    print(f"  {lbl}: {pg}")

# ===== 3. Pooled interaction models =====
def fit_model(data, controls, cov="HC1", maxlags=None):
    rhs = ["edu_exp","is_ssa","edu_exp:is_ssa"] + list(controls)
    formula = "log_gni_pc ~ " + " + ".join(rhs)
    mod = smf.ols(formula, data=data)
    if cov == "HC1":
        return mod.fit(cov_type="HC1"), formula
    elif cov == "HAC":
        return mod.fit(cov_type="HAC",
                       cov_kwds={"maxlags": maxlags if maxlags is not None else 4}), formula
    else:
        return mod.fit(), formula

results = {}

# M1: Full 1975-2015, no labor force control
sub1 = panel.dropna(subset=["gni_pc","edu_exp","prim_enr","sec_enr","exports_g",
                            "log_gni_pc","log_prim_enr","log_sec_enr"]).copy()
res1, f1 = fit_model(sub1, ["log_prim_enr","log_sec_enr","exports_g"], "HC1")
res1h, _   = fit_model(sub1, ["log_prim_enr","log_sec_enr","exports_g"], "HAC", maxlags=4)
f1t = ("log_gni_pc ~ edu_exp + is_ssa + edu_exp:is_ssa "
       "+ log_prim_enr + log_sec_enr + exports_g + Year")
results["M1_trend"] = smf.ols(f1t, data=sub1).fit(cov_type="HC1"), f1t, sub1
results["M1_HC1"] = (res1, f1, sub1)
results["M1_HAC"] = (res1h, f1, sub1)

# M2: 1991-2015, full controls
sub2 = panel[panel["Year"]>=1991].dropna(
    subset=["gni_pc","edu_exp","prim_enr","sec_enr","exports_g","lab_force",
            "log_gni_pc","log_prim_enr","log_sec_enr"]).copy()
res2, f2 = fit_model(sub2, ["log_prim_enr","log_sec_enr","exports_g","lab_force"], "HC1")
res2h, _   = fit_model(sub2, ["log_prim_enr","log_sec_enr","exports_g","lab_force"], "HAC", maxlags=4)
results["M2_HC1"] = (res2, f2, sub2)
results["M2_HAC"] = (res2h, f2, sub2)

# M3: 2011-2015, full controls
sub3 = panel[panel["Year"]>=2011].dropna(
    subset=["gni_pc","edu_exp","prim_enr","sec_enr","exports_g","lab_force",
            "log_gni_pc","log_prim_enr","log_sec_enr"]).copy()
res3, f3 = fit_model(sub3, ["log_prim_enr","log_sec_enr","exports_g","lab_force"], "HC1")
res3h, _   = fit_model(sub3, ["log_prim_enr","log_sec_enr","exports_g","lab_force"], "HAC", maxlags=2)
results["M3_HC1"] = (res3, f3, sub3)
results["M3_HAC"] = (res3h, f3, sub3)

# M4: First-differences on 1991-2015 subset (with all controls)
sub4 = sub2.sort_values(["Country Group","Year"]).copy()
for var in ["gni_pc","edu_exp","exports_g","prim_enr","sec_enr","lab_force",
            "log_gni_pc","log_prim_enr","log_sec_enr"]:
    sub4[f"d_{var}"] = sub4.groupby("Country Group")[var].diff()
sub4 = sub4.dropna(subset=[f"d_{c}" for c in
    ["gni_pc","edu_exp","exports_g","prim_enr","sec_enr","lab_force",
     "log_gni_pc","log_prim_enr","log_sec_enr"]])
f4 = ("d_log_gni_pc ~ d_edu_exp + is_ssa + d_edu_exp:is_ssa "
      "+ d_log_prim_enr + d_log_sec_enr + d_exports_g + d_lab_force")
results["M4_FD"] = smf.ols(f4, data=sub4).fit(cov_type="HC1"), f4, sub4
print("\n[models fit]")

# ===== 4. Display models =====
key_terms = ["edu_exp","d_edu_exp","is_ssa","edu_exp:is_ssa","d_edu_exp:is_ssa",
             "log_prim_enr","log_sec_enr","exports_g","lab_force","Year"]
def show(label, res, sub):
    n = int(sub.shape[0])
    n_ssa = int((sub["is_ssa"]==1).sum())
    n_lmc = n - n_ssa
    yrs = f"{int(sub['Year'].min())}-{int(sub['Year'].max())}"
    rows = []
    for t in key_terms:
        if t in res.params.index:
            ci = res.conf_int().loc[t]
            rows.append((t, float(res.params[t]), float(res.bse[t]),
                         float(res.pvalues[t]), float(ci[0]), float(ci[1])))
    df_out = pd.DataFrame(rows, columns=["term","coef","se","p","ci_low","ci_high"]).round(4)
    print(f"\n----- {label} -----  N={n}  (SSA={n_ssa}, LMC={n_lmc})  yrs={yrs}")
    print(df_out.to_string(index=False))
    def g(k):
        return float(res.params[k]) if k in res.params.index else float("nan")
    def gp(k):
        return float(res.pvalues[k]) if k in res.params.index else float("nan")
    b1 = g("edu_exp") if "edu_exp" in res.params.index else g("d_edu_exp")
    b3 = g("edu_exp:is_ssa") if "edu_exp:is_ssa" in res.params.index else g("d_edu_exp:is_ssa")
    p1 = gp("edu_exp") if "edu_exp" in res.params.index else gp("d_edu_exp")
    p3 = gp("edu_exp:is_ssa") if "edu_exp:is_ssa" in res.params.index else gp("d_edu_exp:is_ssa")
    pssa = float(res.params.get("is_ssa", np.nan))
    pssa_p = float(res.pvalues.get("is_ssa", np.nan))
    print(f"  -> LMC slope (b1)              = {b1:+.4f}  (p={p1:.4f})")
    print(f"  -> SSA slope (b1+b3)           = {b1+b3:+.4f}")
    print(f"  -> SSA-vs-LMC diff (b3)        = {b3:+.4f}  (p={p3:.4f})")
    print(f"  -> Group shift (is_ssa)        = {pssa:+.4f}  (p={pssa_p:.4f})")
    print(f"  -> R^2={res.rsquared:.3f} Adj R^2={res.rsquared_adj:.3f}")
    return dict(n=n, n_ssa=n_ssa, n_lmc=n_lmc, yrs=yrs,
                b1=b1, b3=b3, p1=p1, p3=p3, ssa_shift=pssa,
                lmc_slope=b1, ssa_slope=b1+b3,
                r2=float(res.rsquared), r2_adj=float(res.rsquared_adj))

labels = {"M1_HC1":"M1: 1975-2015, ctrls=prim+sec+exports, NO labor force",
          "M1_HAC":"M1: 1975-2015, ctrls=prim+sec+exports, NO labor force, HAC(lag=4)",
          "M1_trend":"M1: 1975-2015, +linear time trend, ctrls as M1",
          "M2_HC1":"M2: 1991-2015, full controls incl. labor force",
          "M2_HAC":"M2: 1991-2015, full controls, HAC(lag=4)",
          "M3_HC1":"M3: 2011-2015, full controls (SSA outcome only present 2011-2015)",
          "M3_HAC":"M3: 2011-2015, full controls, HAC(lag=2)",
          "M4_FD":"M4: First-differences, 1991-2015, full controls"}

meta = {}
for k in ["M1_HC1","M1_HAC","M1_trend","M2_HC1","M2_HAC","M3_HC1","M3_HAC","M4_FD"]:
    res, _, sub = results[k]
    meta[k] = show(labels[k], res, sub)

# Save long regression summary
rows = []
for k in ["M1_HC1","M1_HAC","M1_trend","M2_HC1","M2_HAC","M3_HC1","M3_HAC","M4_FD"]:
    res, _, sub = results[k]
    n=int(sub.shape[0]); n_ssa=int((sub['is_ssa']==1).sum()); n_lmc=n-n_ssa
    yrs=f"{int(sub['Year'].min())}-{int(sub['Year'].max())}"
    for term in key_terms:
        if term in res.params.index:
            ci = res.conf_int().loc[term]
            rows.append({
                "model":k, "label":labels[k], "term":term,
                "period":yrs, "N":n, "N_SSA":n_ssa, "N_LMC":n_lmc,
                "coef":float(res.params[term]),
                "se":float(res.bse[term]),
                "p":float(res.pvalues[term]),
                "ci_low":float(ci[0]), "ci_high":float(ci[1]),
                "R2":float(res.rsquared), "R2_adj":float(res.rsquared_adj),
            })
pd.DataFrame(rows).round(4).to_csv(OUT_DIR/"regression_summary.csv", index=False)

# Headline model JSON (M2)
res_h, _, sub_h = results["M2_HC1"]
hd = {
    "model":"M2: Pooled 1991-2015 (all controls), HC1",
    "formula":"log_gni_pc ~ edu_exp + is_ssa + edu_exp:is_ssa + log_prim_enr + log_sec_enr + exports_g + lab_force",
    "period":meta["M2_HC1"]["yrs"], "N":meta["M2_HC1"]["n"],
    "N_SSA":meta["M2_HC1"]["n_ssa"], "N_LMC":meta["M2_HC1"]["n_lmc"],
    "coef":{"edu_exp_LMC_beta1":meta["M2_HC1"]["lmc_slope"],
            "edu_exp_SSA_beta1+beta3":meta["M2_HC1"]["ssa_slope"],
            "interaction_beta3":meta["M2_HC1"]["b3"]},
    "p":{"edu_exp":float(res_h.pvalues["edu_exp"]),
         "is_ssa":float(res_h.pvalues["is_ssa"]),
         "interaction":float(res_h.pvalues["edu_exp:is_ssa"])},
    "R2":meta["M2_HC1"]["r2"],
    "per_group_simple_slopes":{
        "1975_2015_no_LF":pg_full,
        "1991_2015_with_LF":pg_9115,
        "2011_2015_with_LF":pg_1115
    },
    "limitations":[
        "Only 2 country groups (SSA, LMC); cluster-by-group SE infeasible. HC1 + Newey-West HAC.",
        "SSA GNI p.c. observed only for 2011-2015 (N=5); SSA slope essentially trend on 5 points.",
        "Reverse causation (high GNI -> more edu savings), omitted variables, autocorrelation.",
        "Results are associational, not causal."
    ]
}
with open(OUT_DIR/"headline_model.json","w") as f:
    json.dump(hd, f, indent=2)
with open(OUT_DIR/"per_group_slopes.json","w") as f:
    json.dump({"lg1975_2015":pg_full, "lg1991_2015":pg_9115, "lg2011_2015":pg_1115}, f, indent=2)

print("\n=== Saved artifacts ===")
for p in sorted(OUT_DIR.glob("*")):
    print(" ", p, "|", p.stat().st_size, "bytes")
print("DONE.")
