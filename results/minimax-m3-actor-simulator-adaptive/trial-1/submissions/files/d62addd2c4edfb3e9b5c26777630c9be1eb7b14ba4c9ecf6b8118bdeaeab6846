"""
DiscoveryBench — Archaeology / metadata_13 — workflow script.

Question: "In what centuries did we see the highest growth phase of the period between
2000 BCE and 1100 BCE?"

Operationalization
------------------
Headline growth-phase proxy:  g_all_mean  (Mean of KDE growth rates)
Independent corroboration:    pollen_grate_100 (Percentage change of 100y-smoothed pollen)
Supporting evidence:          capital.csv Z-variables (12 forms of capital)
Magnitude/level corroborators: kde_all_mean, kde_all_detrend, pollen_inter_100,
                               openness_SMOOTH_100y (PCA1 openness score smoothed 100y)

Century convention
------------------
1900–1801 BCE = 19th century BCE; century N BCE = years 100·N .. 100·(N-1)+1 BCE.
For time_series_data and pollen openness: CE=-bce_year → century = ceil(-CE/100).
For capital.csv directly: BCE label b → century = ceil(b/100).
"""

import os, json
import numpy as np
import pandas as pd

DATA = '/workspace/data'
ART  = '/workspace/artifacts'

# ----------------------- load -----------------------
ts = pd.read_csv(os.path.join(DATA, 'time_series_data.csv'), index_col=0)
cap = pd.read_csv(os.path.join(DATA, 'capital.csv'), decimal=',')
pol = pd.read_csv(os.path.join(DATA,
    'pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv'),
    index_col=0, decimal=',')

print(f"time_series_data.csv : {ts.shape}, CE [{ts.CE.min()}, {ts.CE.max()}]")
print(f"capital.csv          : {cap.shape}, BCE [{cap.BCE.min()}, {cap.BCE.max()}]")
print(f"pollen_openness      : {pol.shape}, CE [{pol.CE.min()}, {pol.CE.max()}]")

# ----------------------- slice to 2000-1100 BCE -----------------------
ts  = ts[(ts.CE  >= -2000) & (ts.CE  <= -1100)].copy()
cap = cap[(cap.BCE >= 1100) & (cap.BCE <= 2000)].copy()
pol = pol[(pol.CE  >= -2000) & (pol.CE  <= -1100)].copy()
print(f"\nIn window 2000-1100 BCE: ts={ts.shape}, cap={cap.shape}, pol={pol.shape}")

# ----------------------- century labelling -----------------------
def century_label_ce(ce):
    """For files that carry CE: ce=-2000 → '20th century BCE'."""
    return f"{int(np.ceil(-ce / 100))}th century BCE"

def century_label_bce(b):
    """For files that carry BCE: b=2000 → '20th century BCE'."""
    return f"{int(np.ceil(b / 100))}th century BCE"

ts['century_bce']  = ts.CE.apply(century_label_ce)
pol['century_bce'] = pol.CE.apply(century_label_ce)
cap['century_bce'] = cap.BCE.apply(century_label_bce)

# 20th … 11th century BCE in canonical order
century_order = [f"{n}th century BCE" for n in range(20, 10, -1)]

# ----------------------- per-century aggregates -----------------------
GROWTH_PROXIES = ['g_all_mean', 'pollen_grate_100']
LEVEL_PROXIES  = ['kde_all_mean', 'kde_all_detrend', 'pollen_inter_100']

agg_ts = (ts.groupby('century_bce')[GROWTH_PROXIES + LEVEL_PROXIES]
            .mean()
            .reindex(century_order))

# cross-check with pollen openness CSV (decadal scale PCA1 openness smoothed 100y)
pol_open = pol.groupby('century_bce')['SMOOTH_MEAN_100y'].mean().reindex(century_order)

# capital.csv — already centennial. Build aggregate per century.
cap_zcols = [c for c in cap.columns if c.startswith('Z')]
agg_cap = cap.groupby('century_bce')[cap_zcols].mean().reindex(century_order)
agg_cap['mean_abs_Z'] = agg_cap[cap_zcols].abs().mean(axis=1)

print("\n=== Per-century row counts ===")
print(pd.DataFrame({
    'ts_rows':        ts.century_bce.value_counts().reindex(century_order),
    'capital_rows':   cap.century_bce.value_counts().reindex(century_order),
}).to_string())

print("\n=== Per-century aggregate (means) ===")
summary = (pd.concat(
        [agg_ts, pol_open.rename('openness_SMOOTH_100y'),
         agg_cap[['mean_abs_Z']]],
        axis=1)
    .round(6))
print(summary.to_string())

# ----------------------- ranking: top-2 per metric -----------------------
print("\n=== Top-2 centuries per metric (mean over the century) ===")
def top_n(s, n=2, exclude_partial=True):
    s = s.dropna()
    if exclude_partial:
        s = s.drop('11th century BCE', errors='ignore')
    return list(zip(s.sort_values(ascending=False).head(n).index.tolist(),
                    s.sort_values(ascending=False).head(n).round(6).tolist()))
metrics = GROWTH_PROXIES + LEVEL_PROXIES + ['openness_SMOOTH_100y', 'mean_abs_Z']
ranking = {m: top_n(summary[m]) for m in metrics}
for k, v in ranking.items():
    print(f"  {k:22s}: {v}")

# ----------------------- sustained-peak criterion -----------------------
print("\n=== Sustained peak (within 1 SD of max) for primary growth proxies ===")
def within_1sd(s, exclude_partial=True):
    s = s.dropna()
    if exclude_partial:
        s = s.drop('11th century BCE', errors='ignore')
    sd = s.std()
    thr = s.max() - sd
    return s[s >= thr].sort_values(ascending=False)

sustained = {}
for col in GROWTH_PROXIES:
    s_full = summary[col].dropna().drop('11th century BCE', errors='ignore')
    sd = float(s_full.std())
    in_band = within_1sd(summary[col])
    sustained[col] = {
        'max_century': s_full.idxmax(),
        'max_value'  : round(float(s_full.max()), 6),
        'sd_full'    : round(sd, 6),
        'within_1sd' : in_band.round(6).to_dict(),
    }
    print(f"  {col}: max={s_full.idxmax()}, value={round(s_full.max(),6)}, sd={round(sd,6)}")
    print(f"      within 1 SD: {in_band.round(6).to_dict()}")

# ----------------------- capital Z peaks per indicator -----------------------
print("\n=== Capital Z indicator peaks (excluding 11th BCE partial bin) ===")
peak_indicators = {}
for z in cap_zcols:
    s = agg_cap[z].dropna()
    s_full = s.drop('11th century BCE', errors='ignore')
    if s_full.empty:
        s_full = s
    peak_indicators[z] = {'top_century': s_full.idxmax(),
                          'top_value'  : round(float(s_full.max()), 3)}
    print(f"  {z:14s} peak {s_full.idxmax():>18s} ({round(s_full.max(),3)})")

# which Z indicators peak in the headlined 15th/14th/13th century BCE
headlined = ['15th century BCE', '14th century BCE', '13th century BCE']
def peak_at(z, target):
    s = agg_cap[z].dropna().drop('11th century BCE', errors='ignore')
    return s.idxmax() == target

print("\n=== Which capital Z indicators peak in our headlined centuries? ===")
matching = {h: [] for h in headlined}
for z in cap_zcols:
    top = agg_cap[z].dropna().drop('11th century BCE', errors='ignore').idxmax()
    if top in matching:
        matching[top].append((z, round(float(agg_cap[z][top]), 3)))
for h in headlined:
    print(f"  {h}: {matching[h]}")

# ----------------------- evidence table for headline centuries -----------------------
print("\n=== Evidence summary (full centuries only, 20th..12th BCE) ===")
full_labels = [f"{n}th century BCE" for n in range(20, 11, -1)]  # 20..12
evidence = pd.DataFrame({
    'g_all_mean':        summary['g_all_mean'].reindex(full_labels).round(6),
    'pollen_grate_100':  summary['pollen_grate_100'].reindex(full_labels).round(6),
    'kde_all_mean':      summary['kde_all_mean'].reindex(full_labels).round(6),
    'kde_all_detrend':   summary['kde_all_detrend'].reindex(full_labels).round(6),
    'pollen_inter_100':  summary['pollen_inter_100'].reindex(full_labels).round(6),
    'openness_SMOOTH_100y': summary['openness_SMOOTH_100y'].reindex(full_labels).round(4),
    'capital_meanAbsZ':  summary['mean_abs_Z'].reindex(full_labels).round(3),
})
print(evidence.to_string())

# Also percentile rank of each century within the in-window distribution (Z-rank across full centuries)
print("\n=== Percentile rank of each full century for each metric ===")
ranks = evidence.rank(pct=True).round(2)
print(ranks.to_string())

# ----------------------- save artifacts -----------------------
os.makedirs(ART, exist_ok=True)
summary.to_csv(os.path.join(ART, 'century_aggregates.csv'))
evidence.to_csv(os.path.join(ART, 'evidence_full_centuries.csv'))
with open(os.path.join(ART, 'ranking.json'), 'w') as f:
    json.dump({'ranking_top2': ranking, 'sustained_within_1sd': sustained,
               'capital_peaks_by_indicator': peak_indicators,
               'capital_Z_peaks_in_headlined': matching},
              f, indent=2, default=str)

# Also save the partial-century flag
with open(os.path.join(ART, 'metadata.json'), 'w') as f:
    json.dump({
        'window_bce': [2000, 1100],
        'centuries_in_window_full': full_labels,
        'partial_century_flag': {
            'label': '11th century BCE',
            'ts_annual_rows': int(ts.century_bce.value_counts().get('11th century BCE', 0)),
            'capital_rows':   int(cap.century_bce.value_counts().get('11th century BCE', 0)),
            'note': ('Partial century: single year 1100 BCE; only 1 capital bin. '                     'Excluded from ranking/tops to avoid edge-effect pull.')},
      }, f, indent=2)

print("\nArtifacts saved:")
for fn in sorted(os.listdir(ART)):
    print(" ", fn)
