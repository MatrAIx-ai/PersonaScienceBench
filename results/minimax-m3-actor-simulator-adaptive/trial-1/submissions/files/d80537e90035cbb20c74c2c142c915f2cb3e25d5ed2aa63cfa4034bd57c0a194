def torsion_rad(p, i, j, k, l):
    a = p[j] - p[i]
    b = p[k] - p[j]
    c = p[l] - p[k]
    n1 = np.cross(a, b)
    n2 = np.cross(b, c)
    nn1, nn2 = np.linalg.norm(n1), np.linalg.norm(n2)
    if nn1 < 1e-10 or nn2 < 1e-10:
        return 0.0
    cos_phi = float(np.dot(n1, n2) / (nn1 * nn2))
    cos_phi = max(-1.0, min(1.0, cos_phi))
    sign = float(np.sign(np.dot(np.cross(n1, n2), b)))
    if sign == 0.0:
        sign = 1.0
    return sign * math.acos(cos_phi)


def get_cv(p):
    return (torsion_rad(p, *PHI_ATOMS_0B),
            torsion_rad(p, *PSI_ATOMS_0B))




def reconstruct_fes(hill_log, grid_centers_deg, sigma_rad, gamma):
    """Reconstruct FES(s) on the cell-centered grid using the order-1 WT estimator.

    Parameters
    ----------
    hill_log : ndarray of shape (M, 3) holding (phi_rad, psi_rad, h_kJmol)
    grid_centers_deg : ndarray shape (N,) cell-center angles in deg
    sigma_rad : per-CV Gaussian width in radians
    gamma : bias factor

    Returns
    -------
    FES : ndarray shape (N, N), kJ/mol, global minimum set to 0.
    """
    n = grid_centers_deg.size
    g_rad = np.deg2rad(grid_centers_deg)
    phi_grid, psi_grid = np.meshgrid(g_rad, g_rad, indexing="ij")
    if hill_log.shape[0] == 0:
        return np.full((n, n), np.nan, dtype=np.float64)
    phi_h = hill_log[:, 0]
    psi_h = hill_log[:, 1]
    h_h = hill_log[:, 2]
    inv2s2 = 1.0 / (2.0 * sigma_rad * sigma_rad)
    v_bias = np.zeros((n, n), dtype=np.float64)
    for i in range(hill_log.shape[0]):
        dphi = np.deg2rad(phi_psi_periodic_diff_deg(np.rad2deg(phi_grid),
                                                    np.rad2deg(phi_h[i])))
        dpsi = np.deg2rad(phi_psi_periodic_diff_deg(np.rad2deg(psi_grid),
                                                    np.rad2deg(psi_h[i])))
        v_bias -= h_h[i] * np.exp(-(dphi ** 2 + dpsi ** 2) * inv2s2)
    fes = float(gamma - 1.0) / float(gamma) * v_bias
    fes -= fes.min()
    return fes


def detect_minima(fes, grid_centers_deg, max_minima=5, min_separation_deg=12.0):
    if np.all(np.isnan(fes)):
        return [], []
    f2 = fes.copy()
    f2[np.isnan(f2)] = np.inf
    filt = ndi.minimum_filter(f2, size=5)
    is_local_min = (f2 == filt) & np.isfinite(f2)
    is_local_min[0, :] = is_local_min[-1, :] = False
    is_local_min[:, 0] = is_local_min[:, -1] = False
    mins = np.argwhere(is_local_min)
    if mins.shape[0] == 0:
        return [], []
    vals = f2[is_local_min]
    order = np.argsort(vals)
    mins = mins[order]
    vals = vals[order]
    kept = []
    for r in range(mins.shape[0]):
        i, j = mins[r]
        cv1 = float(grid_centers_deg[i])
        cv2 = float(grid_centers_deg[j])
        ok = True
        for (cv1k, cv2k, _) in kept:
            d1 = abs(phi_psi_periodic_diff_deg(np.array([cv1]),
                                               np.array([cv1k]))[0])
            d2 = abs(phi_psi_periodic_diff_deg(np.array([cv2]),
                                               np.array([cv2k]))[0])
            if d1 < min_separation_deg and d2 < min_separation_deg:
                ok = False
                break
        if ok:
            kept.append((cv1, cv2, float(vals[r] - vals.min())))
        if len(kept) >= max_minima:
            break
    cvs = [(a, b) for a, b, _ in kept]
    dgs = [v for _, _, v in kept]
    return cvs, dgs


