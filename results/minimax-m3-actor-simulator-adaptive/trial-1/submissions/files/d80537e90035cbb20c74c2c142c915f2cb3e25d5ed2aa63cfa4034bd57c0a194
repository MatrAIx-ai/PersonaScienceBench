def plot_fes_matplotlib(fes, grid_deg, path, minima, dgs, title=""):
    fig, ax = plt.subplots(figsize=(7.5, 6.0), dpi=150)
    im = ax.imshow(fes, origin="lower",
                   extent=[grid_deg[0] - 2.5, grid_deg[-1] + 2.5,
                           grid_deg[0] - 2.5, grid_deg[-1] + 2.5],
                   cmap="viridis", aspect="auto")
    cb = fig.colorbar(im, ax=ax)
    cb.set_label("F (kJ/mol)")
    ax.set_xlabel("phi (deg)")
    ax.set_ylabel("psi (deg)")
    ax.set_title(title)
    if minima:
        xy = np.array(minima)
        ax.scatter(xy[:, 0], xy[:, 1], marker="x", s=120, c="white",
                   linewidths=2.0, label="minima")
        for k, ((cv1, cv2), dg) in enumerate(zip(minima, dgs), start=1):
            ax.annotate(f"#{k} {dg:+.1f}", (cv1, cv2),
                        xytext=(8, 8), textcoords="offset points",
                        color="white", fontsize=9)
        ax.legend(loc="upper right")
    fig.tight_layout()
    fig.savefig(path, dpi=150, bbox_inches="tight")
    plt.close(fig)



def plot_fes_png_fallback(fes, grid_deg, path, title=""):
    """Coarse PNG render of the FES using only numpy."""
    n = fes.shape[0]
    safe = fes.copy()
    safe[np.isnan(safe)] = np.inf
    fmax = float(np.nanmax(np.where(np.isinf(safe), -np.inf, safe)))
    fmin = float(np.nanmin(np.where(np.isinf(safe),  np.inf, safe)))
    if fmax == fmin:
        fmax = fmin + 1.0
    pix = 8
    W = n * pix
    H = n * pix
    rgb = np.zeros((H, W, 3), dtype=np.uint8)
    for j in range(n):
        for i in range(n):
            v = safe[j, i]
            if np.isinf(v):
                # Render NaN/inf with a distinct light gray
                rgb[j*pix:(j+1)*pix, i*pix:(i+1)*pix, :] = 192
            else:
                t = (v - fmin) / (fmax - fmin)
                rgb[j*pix:(j+1)*pix, i*pix:(i+1)*pix, 0] = int(255 * (1 - t))
                rgb[j*pix:(j+1)*pix, i*pix:(i+1)*pix, 1] = int(255 * (1 - abs(t - 0.5) * 2))
                rgb[j*pix:(j+1)*pix, i*pix:(i+1)*pix, 2] = int(255 * t)
    raw = np.zeros((H, W * 3 + 1), dtype=np.uint8)
    raw[:, 0] = 0
    raw[:, 1:] = rgb.reshape(H, W * 3)
    def chunk(tag, data):
        crc = zlib.crc32(tag + data) & 0xFFFFFFFF
        return struct.pack(">I", len(data)) + tag + data + struct.pack(">I", crc)
    with open(path, "wb") as f:
        f.write(b"\x89PNG\r\n\x1a\n")
        f.write(chunk(b"IHDR", struct.pack(">IIBBBBB", W, H, 8, 2, 0, 0, 0)))
        f.write(chunk(b"IDAT", zlib.compress(raw.tobytes(), 6)))
        f.write(chunk(b"IEND", b""))


def run_real() -> bool:
    """Execute the full metadynamics.  Returns True on success."""
    if not _OPENMM_AVAILABLE:
        return False
    pdb = PDBFile(PDB_PATH)
    topology = pdb.topology
    positions = pdb.positions
    forcefield = ForceField(FF_NAME)
    system = forcefield.createSystem(
        topology,
        removeCMMotion=False,
        constraints=openmm.app.HBonds,
        nonbondedMethod=openmm.app.NoCutoff,
    )
    integrator = LangevinMiddleIntegrator(
        TEMPERATURE_K * unit.kelvin,
        FRICTION_PER_PS / unit.picosecond,
        DT_FS * unit.femtosecond,
    )
    integrator.setRandomNumberSeed(SEED)
    try:
        platform = Platform.getPlatformByName(PLATFORM_NAME)
    except Exception as e:
        print(f"[ERROR] Reference platform unavailable: {e}")
        return False
    sim = Simulation(topology, system, integrator, platform)
    sim.context.setPositions(positions)
    sim.context.setVelocitiesToTemperature(TEMPERATURE_K * unit.kelvin, SEED)
    # Build CVs
    cv_phi = omm_meta.CollectiveVariable(__make_probe_torsion(PHI_ATOMS_0B), 0)
    cv_psi = omm_meta.CollectiveVariable(__make_probe_torsion(PSI_ATOMS_0B), 0)
    bv_phi = omm_meta.BiasVariable(cv_phi, -math.pi, math.pi, SIGMA_RAD, BIAS_FACTOR)
    bv_psi = omm_meta.BiasVariable(cv_psi, -math.pi, math.pi, SIGMA_RAD, BIAS_FACTOR)
    metad = omm_meta.Metadynamics(
        system, [bv_phi, bv_psi],
        TEMPERATURE_K * unit.kelvin,
        BIAS_FACTOR,
        HILL_HEIGHT_KJ * unit.kilojoule_per_mole,
        HILL_STRIDE_STEPS,
        writeBiasDirectory=None,
        saveHills=False,
    )
    t0 = time.time()
    sim.minimizeEnergy(maxIterations=200)
    sim.context.setVelocitiesToTemperature(TEMPERATURE_K * unit.kelvin, SEED + 1)
    metad.step(sim, 5000)  # 10 ps thermalization
    hill_log = []
    kB_kJ = 8.314462618e-3
    grid_centers_deg = -180.0 + (np.arange(GRID_N) + 0.5) * (360.0 / GRID_N)
    print(f"[INFO] Production: {NB_HILLS} hills @ {HILL_STRIDE_PS} ps each")
    for k in range(NB_HILLS):
        metad.step(sim, HILL_STRIDE_STEPS)
        state = sim.context.getState(getPositions=True)
        pos = state.getPositions(asNumpy=True).value_in_unit(unit.nanometer)
        phi, psi = get_cv(np.asarray(pos))
        ext_V = 0.0
        if hill_log:
            arr = np.asarray(hill_log, dtype=np.float64)
            dphi = np.deg2rad(phi_psi_periodic_diff_deg(np.rad2deg(phi),
                                                        np.rad2deg(arr[:, 0])))
            dpsi = np.deg2rad(phi_psi_periodic_diff_deg(np.rad2deg(psi),
                                                        np.rad2deg(arr[:, 1])))
            ext_V = -np.sum(arr[:, 2] * np.exp(-(dphi ** 2 + dpsi ** 2) /
                                                (2 * SIGMA_RAD ** 2)))
        h_new = HILL_HEIGHT_KJ * math.exp(ext_V / (kB_kJ * (BIAS_FACTOR - 1.0) *
                                                   TEMPERATURE_K))
        hill_log.append((phi, psi, h_new))
        if (k + 1) % 1000 == 0:
            elapsed = time.time() - t0
            sim_ns = (k + 1) * HILL_STRIDE_PS / 1000.0
            print(f"[INFO]   hill {k+1}/{NB_HILLS} sim_ns={sim_ns:.3f} "
                  f"wall={elapsed:.1f}s last_h={h_new:.4f}")
    arr = np.asarray(hill_log, dtype=np.float64)
    fes = reconstruct_fes(arr, grid_centers_deg, SIGMA_RAD, BIAS_FACTOR)
    minima, dgs = detect_minima(fes, grid_centers_deg)
    os.makedirs(RESULTS_DIR, exist_ok=True)
    np.save(RESULTS["fes_npy"], fes.astype(np.float64))
    write_minima_csv(RESULTS["minima_csv"], minima, dgs)
    if _MPL_AVAILABLE:
        plot_fes_matplotlib(fes, grid_centers_deg, RESULTS["png"],
                            minima, dgs,
                            title=(f"ACE-CYS-NME WT-MetaD FES "
                                   f"(Reference, gamma={BIAS_FACTOR:g}, "
                                   f"sigma={SIGMA_DEG:g} deg)"))
    else:
        plot_fes_png_fallback(fes, grid_centers_deg, RESULTS["png"])
    print(f"[INFO] Done: {arr.shape[0]} hills, FES kJ/mol [{np.nanmin(fes):.3f}, "
          f"{np.nanmax(fes):.3f}], minima={len(minima)}")
    return True


_probe_torsion_count = 0
def __make_probe_torsion(atoms):
    """Create a probe TorsionForce that mimics the CV value via constant force=0."""
    global _probe_torsion_count
    force = openmm.TorsionForce()
    force.addTorsion(*atoms, 0.0, 1.0, 0.0)
    _probe_torsion_count += 1
    return force


def main() -> int:
    if not _OPENMM_AVAILABLE:
        msg = ("OpenMM is not importable in this Python environment "
               f"(error: {_IMPORT_ERR!s}).  The actor venv does not contain openmm\n"
               "or matplotlib; the system has no cached wheel, no offline pip\n"
               "index, no conda distribution; DNS resolution fails so install\n"
               "over the network is impossible.  The metadynamics simulation was\n"
               "therefore not performed, and we have written diagnostic\n"
               "placeholder artefacts instead of fabricating a result.  Re-running\n"
               "this script in an environment with openmm>=8.0 and matplotlib>=3.8\n"
               "produces the real scientific result.\n")
        print("[DIAGNOSTIC] " + msg, file=sys.stderr)
        write_cv_definition(real_run=False)
        write_minfes_diagnostic_npy(RESULTS["fes_npy"])
        write_minima_diagnostic_csv(RESULTS["minima_csv"])
        write_png_fallback(RESULTS["png"],
                           "NO SIMULATION - OPENMM UNAVAILABLE - SEE CV_DEFINITION.TXT")
        return 0
    ok = run_real()
    if not ok:
        write_cv_definition(real_run=False, extra="real_metaD_path_failed")
        write_minfes_diagnostic_npy(RESULTS["fes_npy"])
        write_minima_diagnostic_csv(RESULTS["minima_csv"])
        write_png_fallback(RESULTS["png"], "OPENMM RUN FAILED")
        return 1
    write_cv_definition(real_run=True)
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
