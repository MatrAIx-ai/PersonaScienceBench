   "source": [
    "# Average length of original papers: Experimental Economics vs Psychology\n",
    "\n",
    "**Question.** What is the average length, in pages, of original papers in\n",
    "Experimental Economics (project=`ee`) and in Psychology (project=`rpp`)?\n",
    "\n",
    "**Source.** `data/meta-regression_study_data_heterogeneity_in_replication_projects.csv`\n",
    "(927 rows x 57 cols). `length` is integer-typed pages of the original paper;\n",
    "`project` carries the replication-project code.\n",
    "\n",
    "**Decisions (approved).**\n",
    "- Primary unit = unique original papers (collapse on title+authors+journal+pub_year).\n",
    "- `drop==True` rows excluded by default; sensitivity row included alongside.\n",
    "- No year filter; year range reported as descriptive context only.\n",
    "- Headline = project-level mean, with parallel breakdown of Psychology by\n",
    "  discipline (Social vs Cognitive).\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 1,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "\n"
     ]
    }
   ],
   "source": [
    "import json\n",
    "from pathlib import Path\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "\n",
    "pd.set_option('display.width', 200)\n",
    "pd.set_option('display.max_columns', 60)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 2,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Shape: (927, 57)\n",
      "project counts: {'ml1': 592, 'ml3': 220, 'rpp': 97, 'ee': 18}\n",
      "ee rows: 18 | rpp rows: 97\n",
      "ee drop==True: 0 | rpp drop==True: 7\n",
      "after drop filter -> ee_k: 18 rpp_k: 90\n"
     ]
    }
   ],
   "source": [
    "ROOT = Path('/workspace')\n",
    "DATA = ROOT / 'data' / 'meta-regression_study_data_heterogeneity_in_replication_projects.csv'\n",
    "df = pd.read_csv(DATA)\n",
    "print('Shape:', df.shape)\n",
    "print('project counts:', df['project'].value_counts().to_dict())\n",
    "\n",
    "ee_all  = df[df['project'] == 'ee'].copy()\n",
    "rpp_all = df[df['project'] == 'rpp'].copy()\n",
    "print('ee rows:', len(ee_all), '| rpp rows:', len(rpp_all))\n",
    "print('ee drop==True:', int((ee_all['drop']==True).sum()),\n",
    "      '| rpp drop==True:', int((rpp_all['drop']==True).sum()))\n",
    "\n",
    "ee_k  = ee_all[ee_all['drop'] != True]\n",
    "rpp_k = rpp_all[rpp_all['drop'] != True]\n",
    "print('after drop filter -> ee_k:', len(ee_k), 'rpp_k:', len(rpp_k))\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 3,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "                              label  n_rows  n_originals  year_min  year_max  unique_mean  row_level_mean\n",
      "          ee_unique_orig (headline)      18           18      2011      2014    28.000000       28.000000\n",
      "         rpp_unique_orig (headline)      90           88      2008      2015    11.011364       11.000000\n",
      " ee_unique_orig +drop (sensitivity)      18           18      2011      2014    28.000000       28.000000\n",
      "rpp_unique_orig +drop (sensitivity)      97           95      2008      2015    11.231579       11.216495\n",
      "             rpp_Social_unique_orig      48           46      2008      2008    11.695652       11.645833\n",
      "          rpp_Cognitive_unique_orig      42           42      2008      2015    10.261905       10.261905\n"
     ]
    }
   ],
   "source": [
    "ORIG_KEY = ['title','authors.o','journal','pub_year']\n",
    "\n",
    "def stats(s):\n",
    "    s = pd.to_numeric(s, errors='coerce').dropna()\n",
    "    q1, q3 = s.quantile([0.25, 0.75])\n",
    "    return pd.Series({'n': len(s), 'mean': s.mean(), 'median': s.median(),\n",
    "                      'std': s.std(ddof=1) if len(s)>1 else 0.0,\n",
    "                      'min': s.min(), 'max': s.max(), 'iqr': q3-q1})\n",
    "\n",
    "def pack(df_, label):\n",
    "    u = df_.drop_duplicates(subset=ORIG_KEY)\n",
    "    return {\n",
    "        'label': label, 'n_rows': len(df_),\n",
    "        'n_originals': df_.drop_duplicates(subset=ORIG_KEY).shape[0],\n",
    "        'year_min': int(df_['pub_year'].min()), 'year_max': int(df_['pub_year'].max()),\n",
    "        'unique_mean':  u['length'].mean(),\n",
    "        'row_level_mean': df_['length'].mean(),\n",
    "    }\n",
    "\n",
    "rpp_soc = rpp_k[rpp_k['discipline'] == 'Social']\n",
    "rpp_cog = rpp_k[rpp_k['discipline'] == 'Cognitive']\n",
    "\n",
    "rows = [\n",
    "    pack(ee_k,        'ee_unique_orig (headline)'),\n",
    "    pack(rpp_k,       'rpp_unique_orig (headline)'),\n",
    "    pack(ee_all,      'ee_unique_orig +drop (sensitivity)'),\n",
    "    pack(rpp_all,     'rpp_unique_orig +drop (sensitivity)'),\n",
    "    pack(rpp_soc,     'rpp_Social_unique_orig'),\n",
    "    pack(rpp_cog,     'rpp_Cognitive_unique_orig'),\n",
    "]\n",
    "summary = pd.DataFrame(rows)\n",
    "print(summary.to_string(index=False))\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 4,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "EE length: {'n': 18.0, 'mean': 28.0, 'median': 27.5, 'std': 7.3724447218321405, 'min': 16.0, 'max': 45.0, 'iqr': 6.5}\n",
      "RPP length: {'n': 88.0, 'mean': 11.011363636363637, 'median': 9.0, 'std': 6.206215494389509, 'min': 1.0, 'max': 31.0, 'iqr': 9.0}\n",
      "RPP Social: {'n': 46.0, 'mean': 11.695652173913043, 'median': 9.5, 'std': 6.969360133923954, 'min': 1.0, 'max': 31.0, 'iqr': 9.75}\n",
      "RPP Cognitive: {'n': 42.0, 'mean': 10.261904761904763, 'median': 8.0, 'std': 5.226851516084639, 'min': 3.0, 'max': 21.0, 'iqr': 8.0}\n"
     ]
    }
   ],
   "source": [
    "ee_stats   = stats(ee_k['length'])\n",
    "rpp_stats  = stats(rpp_k.drop_duplicates(subset=ORIG_KEY)['length'])\n",
    "print('EE length:',  ee_stats.to_dict())\n",
    "print('RPP length:', rpp_stats.to_dict())\n",
    "\n",
    "soc_stats = stats(rpp_soc.drop_duplicates(subset=ORIG_KEY)['length'])\n",
    "cog_stats = stats(rpp_cog.drop_duplicates(subset=ORIG_KEY)['length'])\n",
    "print('RPP Social:',    soc_stats.to_dict())\n",
    "print('RPP Cognitive:', cog_stats.to_dict())\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 5,
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Original papers in Experimental Economics (project=='ee') average 28.00 pages (median 27.5, sd 7.37, n=18 unique originals from 2011-2014); Psychology (project=='rpp') average 11.01 pages (median 9.0, sd 6.21, n=88 unique originals from 2008-2015). Social originals (n=46) average 11.70 pages and Cognitive originals (n=42) average 10.26 pages; both remain below the Experimental Economics mean. Sensitivity: including drop==True rows raises the rpp mean to 11.23 (n=95); row-level analysis gives 11.00 (n rows=90).\n"
     ]
    }
   ],
   "source": [
    "hypothesis = (\n",
    "    'Original papers in Experimental Economics (project==\\'ee\\') average '\n",
    "    '28.00 pages (median 27.5, sd 7.37, n=18 unique originals from 2011-2014); '\n",
    "    'Psychology (project==\\'rpp\\') average 11.01 pages (median 9.0, sd 6.21, '\n",
    "    'n=88 unique originals from 2008-2015). Social originals (n=46) average '\n",
    "    '11.70 pages and Cognitive originals (n=42) average 10.26 pages; both remain '\n",
    "    'below the Experimental Economics mean. Sensitivity: including drop==True rows '\n",
    "    'raises the rpp mean to 11.23 (n=95); row-level analysis gives 11.00 (n rows=90).'\n",
    ")\n",
    "print(hypothesis)\n"
   ]
  },
  {
