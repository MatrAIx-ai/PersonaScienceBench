"""
DiscoveryBench-style analysis:
"What proportion of original studies in Experimental Economics
 were conducted in the United Kingdom?"

Source of truth: data/meta-regression_study_data_heterogeneity_in_replication_projects.csv
Filter: project == 'ee' (Experimental Economics)
Location column: experiment_country.o (original-study country)
"""
import math
import pandas as pd
import numpy as np

DATA_PATH = "data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
EE_PATH   = "data/meta-regression_replication_success_data_heterogeneity_in_replication_projects.csv"

# ---------- 1. Load ----------
df1 = pd.read_csv(DATA_PATH)
df2 = pd.read_csv(EE_PATH)

# ---------- 2. Subset to Experimental Economics ----------
ee = df1[df1["project"] == "ee"].copy()
n_ee_total_rows = len(ee)
n_ee_unique_ids = ee["id"].nunique()
n_ee_unique_titles = ee["title"].nunique()
n_ee_missing_country = ee["experiment_country.o"].isna().sum()

country_counts = ee["experiment_country.o"].value_counts(dropna=False)

# ---------- 3. UK normalization ----------
UK_ALIASES = {
    "united kingdom", "uk", "u.k.", "u.k", "britain",
    "great britain", "england", "scotland", "wales",
    "northern ireland",
}

def is_uk(val):
    if pd.isna(val):
        return False
    return str(val).strip().lower() in UK_ALIASES

ee["is_uk_raw"] = ee["experiment_country.o"].apply(is_uk)

# ---------- 4. Counts and proportion ----------
numerator = int(ee["is_uk_raw"].sum())
denominator = n_ee_unique_ids   # equal to n_ee_total_rows == 18
proportion = numerator / denominator
percent = proportion * 100

# ---------- 5. Wilson 95% CI ----------
def wilson_ci(k, n, z=1.959963984540054):
    if n == 0:
        return (float("nan"), float("nan"))
    p_hat = k / n
    denom = 1 + z**2 / n
    center = (p_hat + z**2 / (2 * n)) / denom
    margin = (z / denom) * math.sqrt(p_hat * (1 - p_hat) / n + z**2 / (4 * n**2))
    return (center - margin, center + margin)

ci_low, ci_high = wilson_ci(numerator, denominator)

# ---------- 6. Cross-check vs File 2 ----------
file2_ee_rows = int((df2["project"] == "Experimental Economics").sum())

# ---------- 7. Report ----------
print("=" * 60)
print("EE subset (File 1) basic checks")
print("=" * 60)
print(f"Rows where project == 'ee'              : {n_ee_total_rows}")
print(f"Distinct ids in ee                      : {n_ee_unique_ids}")
print(f"Distinct titles in ee                   : {n_ee_unique_titles}")
print(f"NaN in experiment_country.o (ee)        : {n_ee_missing_country}")
print()
print("experiment_country.o distribution (ee):")
print(country_counts.to_string())
print()
print("US-flag alignment (ee):")
print(pd.crosstab(ee["experiment_country.o"].fillna("MISSING"),
                  ee["us_lab.o"].fillna(-1)))
print()
print("=" * 60)
print("Headline result")
print("=" * 60)
print(f"Numerator   (EE studies in UK)          : {numerator}")
print(f"Denominator (distinct EE original studies): {denominator}")
print(f"Proportion                              : {proportion:.6f}")
print(f"Percentage                              : {percent:.4f}%")
print(f"Wilson 95% CI                           : "
      f"({ci_low:.6f}, {ci_high:.6f})  "
      f"-> ({ci_low*100:.3f}%, {ci_high*100:.3f}%)")
print()
print("=" * 60)
print("Cross-check vs File 2")
print("=" * 60)
print(f"File 2 rows where project == 'Experimental Economics': "
      f"{file2_ee_rows}")
print(f"File 1 rows where project == 'ee'                    : "
      f"{n_ee_total_rows}")
print(f"Match: {file2_ee_rows == n_ee_total_rows}")

# Persist a small CSV summary for the artifact bundle
summary = pd.DataFrame([{
    "numerator_uk": numerator,
    "denominator_ee_studies": denominator,
    "proportion": proportion,
    "percent": percent,
    "wilson95_low": ci_low,
    "wilson95_high": ci_high,
    "file2_ee_rows": file2_ee_rows,
}])
summary.to_csv("artifacts/summary.csv", index=False)

with open("artifacts/numerator_denominator.txt", "w") as fh:
    fh.write(f"numerator={numerator}\ndenominator={denominator}\n"
             f"proportion={proportion:.6f}\npercent={percent:.4f}\n")
