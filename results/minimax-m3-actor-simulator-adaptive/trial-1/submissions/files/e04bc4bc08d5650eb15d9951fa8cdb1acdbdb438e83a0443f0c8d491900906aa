"""
DiscoveryBench — Archaeology (pottery)
Question: In which century do Diversity in Pottery Decoration and Diversity in
Pottery Form show OPPOSITE growth trends for the first time — Pottery Decoration
INCREASING significantly and Pottery Form DECLINING simultaneously?

Method
------
1. Load `time_series_data.csv`. Use RAW centennial samples (column `PotteryForm`
   and `PotteryDecoration`); ignore the `*_inter` linear-interpolation smear.
2. Sort oldest -> newest. Compute per-century first-differences (ΔForm, ΔDecor).
3. Identify the EARLIEST century (smallest absolute BCE) where
   ΔForm < 0  AND  ΔDecor > 0.
4. Cross-validate against `capital.csv` (`ZKeform` = Pottery Form,
   `Zkeverz` = Pottery Decoration; comma-decimal numerics; period = LN).
5. Verify uniqueness of the match.

Output
------
- Per-century diff table for both files.
- The single sign-divergent row displayed row-form.
- Saved CSV of the BCE 1700 diagnostic row.
"""

import pandas as pd
import numpy as np
from pathlib import Path

DATA = Path("/workspace/data")
ART  = Path("/workspace/artifacts")
ART.mkdir(parents=True, exist_ok=True)


# ---------------------------------------------------------------------------
# Primary series: time_series_data.csv
# ---------------------------------------------------------------------------
ts = pd.read_csv(DATA / "time_series_data.csv", index_col=0)

# Keep only centennial sample points (where PotteryForm was actually observed).
raw = (
    ts.loc[ts["PotteryForm"].notna(), ["CE", "calBP",
                                       "PotteryForm", "PotteryDecoration"]]
    .copy()
    .reset_index(drop=True)
)

# CE is signed Common Era where CE < 0 means BCE. Convert to a positive BCE year
# so the chronologic ordering is unambiguous (larger = older).
raw["BCE"] = (-raw["CE"]).astype(int)

raw = raw.sort_values("BCE", ascending=False).reset_index(drop=True)  # oldest first
raw["dForm"]  = raw["PotteryForm"].diff()
raw["dDecor"] = raw["PotteryDecoration"].diff()

# Sign-divergence: form falls, decoration rises.
opp = (raw["dForm"] < 0) & (raw["dDecor"] > 0)

# ---------------------------------------------------------------------------
# Cross-validation: capital.csv
# ---------------------------------------------------------------------------
cap = pd.read_csv(DATA / "capital.csv")
num_cols = ["ZAxtSchwert","ZDolch","Zhausgr","ZCU_AU","Zamber",
            "ZMonument","ZHort","ZSichel","ZBeil","ZMW","ZKeform","Zkeverz"]
for c in num_cols:
    cap[c] = pd.to_numeric(cap[c].astype(str).str.replace(",", ".", regex=False),
                           errors="coerce")

cap = cap.sort_values("BCE", ascending=False).reset_index(drop=True)
cap["dForm"]  = cap["ZKeform"].diff()    # ΔPottery Form
cap["dDecor"] = cap["Zkeverz"].diff()    # ΔPottery Decoration
cap_opp = (cap["dForm"] < 0) & (cap["dDecor"] > 0)


# ---------------------------------------------------------------------------
# Reporting
# ---------------------------------------------------------------------------
def banner(s):
    print("\n" + "=" * 78)
    print(s)
    print("=" * 78)

banner("PRIMARY: time_series_data.csv — centennial raw pottery samples → Δ per century")
pd.set_option("display.width", 160)
pd.set_option("display.max_rows", None)
out_cols = ["BCE","PotteryForm","PotteryDecoration","dForm","dDecor"]
print(raw[out_cols].to_string(index=False))

banner("CROSS-VALIDATION: capital.csv (ZKeform, Zkeverz) → Δ per century")
print(cap[["BCE","group","ZKeform","Zkeverz","dForm","dDecor"]]
      .rename(columns={"ZKeform":"PotteryForm","Zkeverz":"PotteryDecoration"})
      .to_string(index=False))

banner("Sign-divergent transitions (ΔForm < 0 AND ΔDecor > 0)")
print("time_series_data.csv:")
print(raw.loc[opp, out_cols].to_string(index=False))
print("\ncapital.csv:")
print(cap.loc[cap_opp, ["BCE","group","ZKeform","Zkeverz","dForm","dDecor"]]
      .rename(columns={"ZKeform":"PotteryForm","Zkeverz":"PotteryDecoration"})
      .to_string(index=False))

first_match_ts  = raw.loc[opp].sort_values("BCE").iloc[0]   # smallest BCE = most recent
first_match_cap = cap.loc[cap_opp].sort_values("BCE").iloc[0]

banner("Unique first match")
print(f"time_series_data.csv  →  BCE = {first_match_ts['BCE']:>4}  "
      f"(Form: {first_match_ts['PotteryForm']:.2f}, "
      f"ΔForm = {first_match_ts['dForm']:+.2f}; "
      f"Decor: {first_match_ts['PotteryDecoration']:+.2f}, "
      f"ΔDecor = {first_match_ts['dDecor']:+.2f})")
print(f"capital.csv           →  BCE = {first_match_cap['BCE']:>4}  "
      f"period = {first_match_cap['group']}  "
      f"(ZKeform: {first_match_cap['ZKeform']:+.2f}, "
      f"ΔForm = {first_match_cap['dForm']:+.2f}; "
      f"Zkeverz: {first_match_cap['Zkeverz']:+.2f}, "
      f"ΔDecor = {first_match_cap['dDecor']:+.2f})")

# Persist the diagnostic row(s).
diag = pd.DataFrame([{
    "BCE": int(first_match_ts["BCE"]),
    "PotteryForm_pre":  float(first_match_ts["PotteryForm"] - first_match_ts["dForm"]),
    "PotteryForm":      float(first_match_ts["PotteryForm"]),
    "dForm":            float(first_match_ts["dForm"]),
    "PotteryDecor_pre": float(first_match_ts["PotteryDecoration"] - first_match_ts["dDecor"]),
    "PotteryDecoration":float(first_match_ts["PotteryDecoration"]),
    "dDecor":           float(first_match_ts["dDecor"]),
    "cross_val_period_capital": str(first_match_cap["group"]),
    "match_count_ts":  int(opp.sum()),
    "match_count_cap": int(cap_opp.sum()),
}])
diag_path = ART / "pottery_diff_diagnostic.csv"
diag.to_csv(diag_path, index=False)
print(f"\nDiagnostic row saved → {diag_path}")
print(f"Unique sign-divergent transitions — "
      f"ts={int(opp.sum())}, capital={int(cap_opp.sum())}")
