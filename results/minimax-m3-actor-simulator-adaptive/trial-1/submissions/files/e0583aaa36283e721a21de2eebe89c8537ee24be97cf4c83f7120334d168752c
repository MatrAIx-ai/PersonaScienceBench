z90_f, z96_f = (F_c[W90]==0).mean()*100, (F_c[W96]==0).mean()*100
med90_w, med96_w = float(W_c[W90].median()), float(W_c[W96].median())
med90_f, med96_f = float(F_c[W90].median()), float(F_c[W96].median())
