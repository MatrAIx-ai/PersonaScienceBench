"""NLS wealth-inequality 1990 -> 1996: white males vs white females.
DiscoveryBench: discoverybench/test/nls_incarceration/metadata_15.json/0/0
Question: "What changes occurred in the wealth inequality for white males
and females between 1990 and 1996?"
"""
from __future__ import annotations
import json
import numpy as np
import pandas as pd
from pathlib import Path

DATA = Path("data/nls_incarceration_processed.csv")

# 1. Load + filter ----------------------------------------------------------
df = pd.read_csv(DATA)
df["race_norm"] = df["race"].replace({"hipanic": "hispanic"})
assert set(df["race_norm"].unique()) == {"white", "black", "hispanic"}

white = df[df["race_norm"] == "white"].copy()
WM = white[white["sex"] == "male"].copy()
WF = white[white["sex"] == "female"].copy()
W90 = "composite_wealth_1990"
W96 = "composite_wealth_1996"

def cell_(group, year_col):
    return group[year_col].astype(float)

# 2. Inequality helpers -----------------------------------------------------
def pct_ratio(s, hi, lo, *, on="positive"):
    if on == "positive":
        s_pos = s[s > 0]
        drop = 1.0 - len(s_pos) / len(s) if len(s) else 0.0
        t = s_pos
    else:
        drop = 0.0
        t = s
    if len(t) == 0:
        return (float("nan"), drop)
    return (float(t.quantile(hi) / t.quantile(lo)), drop)

def gini_davidson(s):
    x = s.dropna().to_numpy(dtype=float)
    n = len(x)
    if n < 2:
        return float("nan")
    xs = np.sort(x)
    abs_diff_sum = np.sum(np.abs(xs[:, None] - xs[None, :]))
    mu = float(np.mean(x))
    if mu == 0:
        return float("nan")
    return float(abs_diff_sum / (2.0 * n * n * mu))

def top10_share(s, *, pool="positive"):
    target = s[s > 0] if pool == "positive" else s
    pool_sum = float(target.sum())
    info = {"pool": pool, "pool_n": int(len(target)), "pool_sum": pool_sum,
            "threshold": float("nan"), "top_n": 0, "top_sum": 0.0,
            "share_dropped_full": (float(1.0 - len(target) / len(s))
                                   if pool == "positive" else 0.0)}
    if pool_sum == 0 or len(target) == 0:
        return float("nan"), info
    thr = float(target.quantile(0.90))
    top = target[target >= thr]
    info.update({"threshold": thr, "top_n": int(len(top)),
                 "top_sum": float(top.sum())})
    return float(top.sum() / pool_sum), info

def cv(s):
    if s.std() is None or s.mean() == 0:
        return float("nan")
    return float(s.std() / s.mean())

def iqr(s):
    return float(s.quantile(0.75) - s.quantile(0.25))

# 3. Per-cell inequality bundle -------------------------------------------
def inequality_table(grp, year_col, label, *, winsor_p=None):
    s = cell_(grp, year_col)
    sw = s.copy()
    if winsor_p is not None:
        lo = float(s.quantile(winsor_p))
        hi = float(s.quantile(1 - winsor_p))
        sw = s.clip(lower=lo, upper=hi)
    r_9010, d_9010 = pct_ratio(sw, 0.90, 0.10, on="positive")
    r_9050, d_9050 = pct_ratio(sw, 0.90, 0.50, on="positive")
    r_5010, d_5010 = pct_ratio(sw, 0.50, 0.10, on="positive")
    g = gini_davidson(sw)
    t10p, dbg_p = top10_share(sw, pool="positive")
    t10f, dbg_f = top10_share(sw, pool="full")
    return {
        "label": label, "n": int(len(s)),
        "n_pos": int((s > 0).sum()), "n_zero": int((s == 0).sum()),
        "n_neg": int((s < 0).sum()),
        "p90_p10_pos": r_9010, "drop_90_10": d_9010,
        "p90_p50_pos": r_9050, "drop_90_50": d_9050,
        "p50_p10_pos": r_5010, "drop_50_10": d_5010,
        "gini": g,
        "top10_share_pos": t10p, "top10_share_full": t10f,
        "top10_threshold_pos": dbg_p["threshold"],
        "cv": cv(sw), "iqr": iqr(sw), "winsor_p": winsor_p,
    }

cells = {
    "WM_1990": inequality_table(WM, W90, "WM 1990"),
    "WM_1996": inequality_table(WM, W96, "WM 1996"),
    "WF_1990": inequality_table(WF, W90, "WF 1990"),
    "WF_1996": inequality_table(WF, W96, "WF 1996"),
}

print("=" * 88)
print("HEADLINE: WEALTH INEQUALITY, WHITE MALES vs WHITE FEMALES, 1990 vs 1996")
print("=" * 88)
df_cells = pd.DataFrame(cells).T
df_cells.index.name = "cell"
print(df_cells.to_string(float_format=lambda x: f"{x:,.3f}"))

# 4. Delta rows & WM-WF gaps ----------------------------------------------
print()
print("=" * 88)
print("DELTA 1990 -> 1996 (per subgroup, signed: 1996 minus 1990)")
print("=" * 88)
delta_rows = []
for label in ["WM", "WF"]:
    for key, fmt in [
        ("p90_p10_pos", "p90/p10 (positive subset)"),
        ("p90_p50_pos", "p90/p50 (positive subset)"),
        ("p50_p10_pos", "p50/p10 (positive subset)"),
        ("gini",        "Gini (Davidson, full incl. zero+neg)"),
        ("top10_share_pos", "top-10% share (positive pool)"),
        ("cv",          "CV (std/mean) auxiliary"),
        ("iqr",         "IQR (p75-p25) auxiliary"),
    ]:
        v90 = cells[f"{label}_1990"][key]
        v96 = cells[f"{label}_1996"][key]
        delta_rows.append({
            "subgroup": label, "measure": fmt,
            "v_1990": v90, "v_1996": v96,
            "delta_1996_minus_1990": v96 - v90,
            "abs_pct_change": (v96 - v90) / v90
                if v90 not in (0, None) and not (isinstance(v90, float) and np.isnan(v90))
                else float("nan"),
        })
df_delta = pd.DataFrame(delta_rows)
print(df_delta.to_string(index=False, float_format=lambda x: f"{x:,.3f}"))

print()
print("=" * 88)
print("GAP: white males MINUS white females at each year")
print("=" * 88)
gap_rows = []
for yr in ["1990", "1996"]:
    for key, fmt in [
        ("p90_p10_pos", "p90/p10 (positive subset)"),
        ("p90_p50_pos", "p90/p50 (positive subset)"),
        ("p50_p10_pos", "p50/p10 (positive subset)"),
        ("gini",        "Gini (Davidson, full incl. zero+neg)"),
        ("top10_share_pos", "top-10% share (positive pool)"),
        ("cv",          "CV (std/mean) auxiliary"),
        ("iqr",         "IQR (p75-p25) auxiliary"),
    ]:
        vw = cells[f"WM_{yr}"][key]
        vf = cells[f"WF_{yr}"][key]
        gap_rows.append({"year": yr, "measure": fmt,
                         "WM": vw, "WF": vf, "WM_minus_WF": vw - vf})
df_gap = pd.DataFrame(gap_rows)
print(df_gap.to_string(index=False, float_format=lambda x: f"{x:,.3f}"))

# 5. Sensitivity #1: zero-drift robustness --------------------------------
print()
print("=" * 88)
print("SENSITIVITY #1: zero-drift robustness")
print("    (a) all rows            -> identical to headline (no nulls exist)")
print("    (b) both-years-nonmissing -> identical to (a) since no nulls")
print("    (c) both-years-nonzero (1990!=0 AND 1996!=0)")
print("=" * 88)
for label, grp in [("WM", WM), ("WF", WF)]:
    sub_b = grp[(grp[W90] != 0) & (grp[W96] != 0)]
    for slice_name, sub in [("(a) all", grp),
                            ("(b) both-nonmissing", grp),
                            ("(c) both-nonzero", sub_b)]:
        c_sub = {
            f"{label}_1990": inequality_table(sub, W90, f"{label} {slice_name} 1990"),
            f"{label}_1996": inequality_table(sub, W96, f"{label} {slice_name} 1996"),
        }
        print(f"\n-- {label} {slice_name}  n(1990)={c_sub[f'{label}_1990']['n']:>4d}  "
              f"n(1996)={c_sub[f'{label}_1996']['n']:>4d}")
        for key, fmt in [("p90_p10_pos", "p90/p10_pos"),
                         ("p90_p50_pos", "p90/p50_pos"),
                         ("p50_p10_pos", "p50/p10_pos"),
                         ("gini", "Gini"),
                         ("top10_share_pos", "top10%_share_pos"),
                         ("cv", "CV"),
                         ("iqr", "IQR")]:
            v90 = c_sub[f"{label}_1990"][key]
            v96 = c_sub[f"{label}_1996"][key]
            print(f"   {fmt:<18s} 1990={v90:>9.3f}   1996={v96:>9.3f}   "
                  f"D={v96 - v90:>+9.3f}")

# 6. Sensitivity #2: 99th-pct winsorization -------------------------------
print()
print("=" * 88)
print("SENSITIVITY #2: 99th-percentile winsorization (mirror-floor at p01)")
print("=" * 88)
win_cells = {}
for label, grp in [("WM", WM), ("WF", WF)]:
    win_cells[f"{label}_1990"] = inequality_table(grp, W90, f"{label} 1990 w",
                                                  winsor_p=0.01)
    win_cells[f"{label}_1996"] = inequality_table(grp, W96, f"{label} 1996 w",
                                                  winsor_p=0.01)
    print(f"\n-- {label} winsorized (cap=99th pct, floor=1st pct) --")
    for key, fmt in [("p90_p10_pos", "p90/p10_pos"),
                     ("p90_p50_pos", "p90/p50_pos"),
                     ("p50_p10_pos", "p50/p10_pos"),
                     ("gini", "Gini"),
                     ("top10_share_pos", "top10%_share_pos"),
                     ("cv", "CV"),
                     ("iqr", "IQR")]:
        v90 = win_cells[f"{label}_1990"][key]
        v96 = win_cells[f"{label}_1996"][key]
        head_diff = cells[f"{label}_1996"][key] - cells[f"{label}_1990"][key]
        print(f"   {fmt:<18s} 1990={v90:>9.3f}   1996={v96:>9.3f}   "
              f"D(wins)={v96 - v90:>+9.3f}   D(headline)={head_diff:>+9.3f}")

# 7. Persist machine-readable output --------------------------------------
out_all = {
    "cells": cells,
    "delta_1996_minus_1990": df_delta.to_dict(orient="records"),
    "gap_WM_minus_WF": df_gap.to_dict(orient="records"),
    "sens_winsor": win_cells,
}
Path("artifacts").mkdir(exist_ok=True)
with open("artifacts/results.json", "w") as f:
    json.dump(out_all, f, indent=2, default=str)


