"""
DiscoveryBench — archaeology/metadata_11
Question: "In which century did the Diversity in Pottery Form collapses
and Diversity in Pottery Decoration increases simultaneously?"

Approach (approved by researcher):
 1. Primary source: capital.csv (39 centennial anchors, CE -4300..-500),
    columns ZKeform (Pottery Form diversity, z) and Zkeverz (Pottery
    Decoration diversity, z). Fully populated.
 2. Compute ΔForm_i = Form(i+1)-Form(i) and ΔDeco_i = Deco(i+1)-Deco(i)
    for each consecutive-century transition (38 transitions).
 3. z-normalize ΔForm and ΔDeco separately over the 38 transitions.
    Score S_i = z(-ΔForm_i) + z(ΔDeco_i).
 4. Winner = argmax S_i subject to ΔForm_i < 0 AND ΔDeco_i > 0
    (simultaneous collapse+rise within the same 100y bin).
 5. Cross-validation: rolling-100y window on time_series._inter to verify.
 6. Report top-3 candidates with raw Δs, z's, score and archaeological
    period (EN/MN/SG/LN/OBA/YBA) from capital.csv.
"""
import csv, math, json, os

HERE = os.path.dirname(os.path.abspath(__file__))
DATA = os.path.join(os.path.dirname(HERE), 'data')


def parse_num(s):
    """Parse numbers from CSV with optional German decimal commas and quoting."""
    s = (s or '').strip().replace('"', '')
    if s == '' or s.lower() in ('nan', 'none'):
        return None
    if ',' in s and '.' in s:
        s = s.replace('.', '').replace(',', '.')
    elif ',' in s:
        s = s.replace(',', '.')
    try:
        return float(s)
    except Exception:
        return None


def load_capital():
    with open(os.path.join(DATA, 'capital.csv'), 'r', encoding='utf-8') as f:
        rows = list(csv.reader(f))
    hdr = rows[0]
    idx = {n: hdr.index(n) for n in hdr}
    out = []
    for r in rows[1:]:
        out.append({
            'BCE': int(r[idx['BCE']]),
            'CE': -int(r[idx['BCE']]),
            'group': r[idx['group']],
            'ZKeform': parse_num(r[idx['ZKeform']]),
            'Zkeverz': parse_num(r[idx['Zkeverz']]),
        })
    out.sort(key=lambda d: d['CE'])
    return out


def load_time_series():
    """Read PotteryForm_inter / PotteryDecoration_inter at 1-year resolution."""
    with open(os.path.join(DATA, 'time_series_data.csv'), 'r', encoding='utf-8') as f:
        rows = list(csv.reader(f))
    hdr = rows[0]
    iCE = hdr.index('CE')
    iPF = hdr.index('PotteryForm_inter')
    iPD = hdr.index('PotteryDecoration_inter')
    out = []
    for r in rows[1:]:
        out.append((int(r[iCE]), parse_num(r[iPF]), parse_num(r[iPD])))
    out.sort()
    return out


def zscore(vals):
    n = len(vals)
    mu = sum(vals) / n
    var = sum((v - mu) ** 2 for v in vals) / n
    sd = math.sqrt(var) if var > 0 else 1.0
    return mu, sd, [(v - mu) / sd for v in vals]


def century_transitions(cap):
    """Compute ΔForm, ΔDeco per century transition in capital.csv.

    Each transition goes from row at CE=X_old to row at CE=X_new=X_old+100.
    The covered century is [X_old, X_new) in CE, i.e. (BCE X_new, BCE X_old].
    Label: '<BCE_start>–<BCE_end> BCE' (start=X_old, end=X_new — older to younger).
    """
    transitions = []
    for i in range(len(cap) - 1):
        a, b = cap[i], cap[i + 1]
        assert b['CE'] - a['CE'] == 100, "non centennial step in capital.csv"
        transitions.append({
            'ce_old': a['CE'],
            'ce_new': b['CE'],
            'bce_start': a['BCE'],
            'bce_end': b['BCE'],
            'label_bce': f"{a['BCE']}–{b['BCE']} BCE",
            'period': a['group'],
            'Form_start': a['ZKeform'],
            'Form_end': b['ZKeform'],
            'Deco_start': a['Zkeverz'],
            'Deco_end': b['Zkeverz'],
            'dF': b['ZKeform'] - a['ZKeform'],
            'dD': b['Zkeverz'] - a['Zkeverz'],
        })
    return transitions


def annual_rolling(ts):
    """100-year forward rolling window on time_series._inter.

    For each starting CE=y, return value at y+100 minus value at y.
    Bin label is '(-y-100)–(-y) BCE'.
    """
    ce0 = ts[0][0]
    N = len(ts)
    out = []
    for j in range(N - 100):
        y = ts[j][0]
        p0, d0 = ts[j][1], ts[j][2]
        p1, d1 = ts[j + 100][1], ts[j + 100][2]
        out.append({
            'y': y,
            'label_bce': f"{-y-100}–{-y} BCE",
            'dF': p1 - p0,
            'dD': d1 - d0,
        })
    return out


def main():
    cap = load_capital()
    ts = load_time_series()

    # ---- 1) Century transitions on capital.csv ----
    trans = century_transitions(cap)
    dFs = [t['dF'] for t in trans]
    dDs = [t['dD'] for t in trans]
    mu_dF, sd_dF, z_dF = zscore(dFs)
    mu_dD, sd_dD, z_dD = zscore(dDs)
    for t, zf, zd in zip(trans, z_dF, z_dD):
        t['z_dF'] = zf
        t['z_dD'] = zd
        t['S'] = (-zf) + zd
        t['simul'] = (t['dF'] < 0) and (t['dD'] > 0)

    # Top-1 simultaneous winner
    simul = [t for t in trans if t['simul']]
    simul.sort(key=lambda t: -t['S'])
    winner = simul[0] if simul else None

    # Top-3 by score regardless of simult (for robustness context)
    top3 = sorted(trans, key=lambda t: -t['S'])[:3]

    # ---- 2) Cross-validation: rolling 100y window on time_series._inter ----
    roll = annual_rolling(ts)
    z_dF_r, z_dD_r = zscore([r['dF'] for r in roll]), zscore([r['dD'] for r in roll])
    for r, zf, zd in zip(roll, z_dF_r[2], z_dD_r[2]):
        r['z_dF'] = zf
        r['z_dD'] = zd
        r['S'] = (-zf) + zd
        r['simul'] = (r['dF'] < 0) and (r['dD'] > 0)
    sim_roll = [r for r in roll if r['simul']]
    sim_roll.sort(key=lambda r: -r['S'])
    cross_top3 = sim_roll[:3]

    # ---- 3) Persist results ----
    out = {
        'n_transitions_capital': len(trans),
        'mu_dF_capital': mu_dF, 'sd_dF_capital': sd_dF,
        'mu_dD_capital': mu_dD, 'sd_dD_capital': sd_dD,
        'winner': winner,
        'top3_overall_by_score': top3,
        'cross_validation_top3': cross_top3,
        'all_transitions': trans,
    }
    with open(os.path.join(HERE, 'results.json'), 'w') as f:
        json.dump(out, f, indent=2, default=str)

    # ---- 4) Console report ----
    print(f"# centuries analysed: {len(trans)}")
    print(f"# rolling windows on time_series._inter: {len(roll)}")
    print()
    print("=== Winner (ΔForm<0 AND ΔDeco>0, maximising S) ===")
    if winner:
        print(f"  Century : {winner['label_bce']}  (period={winner['period']})")
        print(f"  ΔForm   : {winner['dF']:+.2f}    (z(−ΔForm)={-winner['z_dF']:.2f})")
        print(f"  ΔDeco   : {winner['dD']:+.2f}    (z(ΔDeco) ={winner['z_dD']:.2f})")
        print(f"  Score S : {winner['S']:+.2f}")
        print(f"  ZKeform : {winner['Form_start']:+.2f} → {winner['Form_end']:+.2f}")
        print(f"  Zkeverz : {winner['Deco_start']:+.2f} → {winner['Deco_end']:+.2f}")
    print()
    print("=== Top-3 by S (for robustness context) ===")
    for t in top3:
        print(f"  {t['label_bce']:>12}  ΔForm={t['dF']:+.2f}  ΔDeco={t['dD']:+.2f}  "
              f"z(−ΔForm)={-t['z_dF']:.2f}  z(ΔDeco)={t['z_dD']:.2f}  S={t['S']:+.2f}  "
              f"simul={'Y' if t['simul'] else 'n'}  period={t['period']}")
    print()
    print("=== Cross-validation: top-3 from rolling 100y window on time_series._inter ===")
    for r in cross_top3:
        print(f"  {r['label_bce']:>12}  ΔForm={r['dF']:+.2f}  ΔDeco={r['dD']:+.2f}  S={r['S']:+.2f}")


if __name__ == '__main__':
    main()
