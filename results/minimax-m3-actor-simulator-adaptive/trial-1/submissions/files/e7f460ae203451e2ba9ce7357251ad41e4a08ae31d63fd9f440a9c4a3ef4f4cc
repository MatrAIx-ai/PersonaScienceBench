def _text_width(text, scale=1):
    return (len(text) * 6 - 1) * scale


def _draw_text(canvas, x0, y0, text, color=255, scale=1):
    H, W = canvas.shape
    xcur = x0
    for ch in text:
        glyph = _FONT_5x7.get(ch)
        if glyph is None:
            xcur += 6 * scale
            continue
        for r, bits in enumerate(glyph):
            for c in range(5):
                if bits & (1 << (4 - c)):
                    for dy in range(scale):
                        for dx in range(scale):
                            yy = y0 + r * scale + dy
                            xx = xcur + c * scale + dx
                            if 0 <= yy < H and 0 <= xx < W:
                                canvas[yy, xx] = color
        xcur += 6 * scale


def _draw_text_centered(canvas, x_center, y0, text, color=255, scale=1):
    w = _text_width(text, scale)
    _draw_text(canvas, x_center - w // 2, y0, text, color, scale)


def _draw_rect(canvas, x0, y0, w, h, color):
    canvas[y0:y0 + h, x0:x0 + w] = color


def _draw_rect_outline(canvas, x0, y0, w, h, color):
    canvas[y0:y0 + h, x0] = color
    canvas[y0:y0 + h, x0 + w - 1] = color
    canvas[y0, x0:x0 + w] = color
    canvas[y0 + h - 1, x0:x0 + w] = color


def _draw_line(canvas, x0, y0, x1, y1, color):
    H, W = canvas.shape
    dx = abs(x1 - x0); dy = -abs(y1 - y0)
    sx = 1 if x0 < x1 else -1
    sy = 1 if y0 < y1 else -1
    err = dx + dy
    x, y = x0, y0
    while True:
        if 0 <= y < H and 0 <= x < W:
            canvas[y, x] = color
        if x == x1 and y == y1:
            break
        e2 = 2 * err
        if e2 >= dy:
            err += dy; x += sx
        if e2 <= dx:
            err += dx; y += sy


def _draw_dashed_line(canvas, x0, y0, x1, y1, color, dash=4):
    H, W = canvas.shape
    dx = abs(x1 - x0); dy = -abs(y1 - y0)
    sx = 1 if x0 < x1 else -1
    sy = 1 if y0 < y1 else -1
    err = dx + dy
    x, y = x0, y0
    i = 0
    while True:
        if 0 <= y < H and 0 <= x < W:
            if (i // dash) % 2 == 0:
                canvas[y, x] = color
        i += 1
        if x == x1 and y == y1:
            break
        e2 = 2 * err
        if e2 >= dy:
            err += dy; x += sx
        if e2 <= dx:
            err += dx; y += sy


def _spin_map_panel(s_arr, panel_w, panel_h, up_color=250, dn_color=60, pad_color=0):
    """Render a spin configuration into a panel as a zoomed-in image with +/- 1 colour."""
    panel = np.full((panel_h, panel_w), pad_color, dtype=np.uint8)
    N = s_arr.shape[0]
    img = np.empty((N, N), dtype=np.uint8)
    img[s_arr > 0] = up_color
    img[s_arr < 0] = dn_color
    # tile exact: pick block size such that N*py ~ panel_h, N*px ~ panel_w
    py = max(1, panel_h // N)
    px = max(1, panel_w // N)
    big = np.kron(img, np.ones((py, px), dtype=np.uint8))
    h_clip = min(big.shape[0], panel_h)
    w_clip = min(big.shape[1], panel_w)
    panel[:h_clip, :w_clip] = big[:h_clip, :w_clip]
    return panel


def _line_plot_panel(x, ys, x_log, y_log, xlabel, ylabel, title, panel_w=480, panel_h=320):
    """Compose a small line plot with axes, ticks and labels.

    ``ys`` is a list of (data, name, color) for each curve.
    """
    panel = np.full((panel_h, panel_w), 16, dtype=np.uint8)
    fx, fy, fw, fh = 60, 12, panel_w - 80, panel_h - 50
    _draw_rect_outline(panel, fx, fy, fw, fh, 200)

    x_use = np.log10(x) if x_log else x.astype(np.float64)
    x_min, x_max = float(x_use.min()), float(x_use.max())
    if x_log:
        x_min = math.floor(x_min); x_max = math.ceil(x_max)
        x_min = math.floor(x_min); x_max = math.ceil(x_max)

    y_min = np.inf; y_max = -np.inf
    for d, _, _ in ys:
        ly = np.log10(np.clip(d, 1e-12, None)) if y_log else d.astype(np.float64)
        if ly.size:
            y_min = min(y_min, float(ly.min()))
            y_max = max(y_max, float(ly.max()))
    if y_log:
        y_lo = math.floor(y_min); y_hi = math.ceil(y_max)
        if y_hi == y_lo:
            y_hi += 1
        y_min, y_max = float(y_lo), float(y_hi)
    else:
        if y_max == y_min:
            y_max = y_min + 1

    def to_px(xu, yu):
        if x_log:
            xu = math.log10(max(xu, 1e-12))
        if y_log:
            yu = math.log10(max(yu, 1e-12))
        x_n = (xu - x_min) / max(x_max - x_min, 1e-9)
        y_n = (yu - y_min) / max(y_max - y_min, 1e-9)
        return (int(round(fx + x_n * (fw - 1))),
                int(round(fy + fh - 1 - y_n * (fh - 1))))

    if x_log:
        lo_d = int(math.ceil(x_min)); hi_d = int(math.floor(x_max))
        for k in range(lo_d, hi_d + 1):
            xp, _ = to_px(float(10 ** k), y_min)
            _draw_line(panel, xp, fy + fh, xp, fy + fh + 4, 200)
            _draw_text_centered(panel, xp, fy + fh + 7, ('1' if k == 0 else '10e' + str(k)),
                                color=200, scale=1)
    if y_log:
        lo_d = int(math.ceil(y_min)); hi_d = int(math.floor(y_max))
        for k in range(lo_d, hi_d + 1):
            _, yp = to_px(0.0, float(10 ** k))
            _draw_line(panel, fx - 4, yp, fx, yp, 200)
            _draw_text(panel, 8, yp - 3, ('1' if k == 0 else '10e' + str(k)),
                       color=200, scale=1)
    else:
        n_ticks = 5
        for i in range(n_ticks + 1):
            v = y_min + (y_max - y_min) * i / n_ticks
            _, yp = to_px(0.0, v)
            _draw_line(panel, fx - 4, yp, fx, yp, 200)
            lbl = f"{v:+.2f}"
            _draw_text(panel, 8, yp - 3, lbl, color=200, scale=1)

    for d, _, c in ys:
        d_local = np.clip(d, 1e-12, None) if y_log else d
        prev = None
        for xi, yi in zip(x_use, d_local):
            xxp, yyp = to_px(xi, yi if not y_log else math.log10(max(yi, 1e-12)))
            if prev is not None:
                _draw_line(panel, prev[0], prev[1], xxp, yyp, c)
            prev = (xxp, yyp)

    _draw_text_centered(panel, fx + fw // 2, panel_h - 14, xlabel, color=220, scale=1)
    if title:
        _draw_text(panel, fx, 4, title, color=255, scale=1)
    return panel


def _collapse_panel(stackC, L_arr, max_r, panel_w=480, panel_h=320):
    """Render the rescaled radial correlations C(r/L(t), t) overlaid."""
    panel = np.full((panel_h, panel_w), 16, dtype=np.uint8)
    fx, fy, fw, fh = 60, 12, panel_w - 80, panel_h - 50
    _draw_rect_outline(panel, fx, fy, fw, fh, 200)
    rs = np.arange(1, max_r, dtype=np.float64)
    L_min = max(L_arr.min(), 1.0)
    x_max = float(max_r - 1) / L_min
    y_min = -0.30; y_max = 1.05

    def to_px(xu, yu):
        x_n = xu / max(x_max, 1e-9)
        y_n = (yu - y_min) / max(y_max - y_min, 1e-9)
        return (int(round(fx + x_n * (fw - 1))),
                int(round(fy + fh - 1 - y_n * (fh - 1))))

    xp_z, yp_z = to_px(0.0, 0.0)
    xp_ze, yp_ze = to_px(x_max, 0.0)
    _draw_line(panel, xp_z, yp_z, xp_ze, yp_ze, 80)
    xp_o, yp_o = to_px(0.0, 1.0)
    xp_oe, yp_oe = to_px(x_max, 1.0)
    _draw_dashed_line(panel, xp_o, yp_o, xp_oe, yp_oe, 80)

    cols = [255, 200, 170, 130, 100, 210]
    n_snap, R = stackC.shape
    for i in range(n_snap):
        L_i = max(L_arr[i], 1.0)
        x_i = rs / L_i
        y_i = stackC[i, 1:]
        prev = None
        for xi, yi in zip(x_i, y_i):
            if xi > x_max:
                break
            xxp, yyp = to_px(xi, yi)
            if prev is not None:
                _draw_line(panel, prev[0], prev[1], xxp, yyp, cols[i % len(cols)])
            prev = (xxp, yyp)

    for k in [1, 2, 3, 4]:
        if k <= x_max + 0.01:
            xp, _ = to_px(float(k), y_min)
            _draw_line(panel, xp, fy + fh, xp, fy + fh + 4, 200)
            _draw_text_centered(panel, xp, fy + fh + 7, str(k), color=200, scale=1)

    for vy in [-0.2, 0.0, 0.5, 1.0]:
        if vy < y_min or vy > y_max:
            continue
        _, yp = to_px(0.0, vy)
        _draw_line(panel, fx - 4, yp, fx, yp, 200)
        lbl = f"{vy:+.2f}"
        _draw_text(panel, 12, yp - 3, lbl, color=200, scale=1)

    _draw_text_centered(panel, fx + fw // 2, panel_h - 15, 'r/L', color=220, scale=1)
    _draw_text(panel, fx, 4, 'C(r/L)  self-similar collapse', color=255, scale=1)
    return panel


def build_figure(snapshots_for_figure, snap_times, seriesA, seriesB, stackC,
                 L_arr, output_path, max_r):
    """Compose figure.png: spin-map snapshots + time-series + L(t) + collapse overlay."""
    W, H = 1000, 760
    canvas = np.full((H, W), 0, dtype=np.uint8)

    # Final snapshot (top-left, 200x200)
    spin_panel = _spin_map_panel(snapshots_for_figure[-1], 200, 200, up_color=250, dn_color=60)
    canvas[20:220, 20:220] = spin_panel
    _draw_text(canvas, 20, 4, 'snapshot t=' + str(int(snap_times[-1])), color=255, scale=1)

    # Penultimate snapshot (top-mid)
    spin_panel = _spin_map_panel(snapshots_for_figure[-2], 200, 200, up_color=250, dn_color=60)
    canvas[20:220, 240:440] = spin_panel
    _draw_text(canvas, 240, 4, 'snapshot t=' + str(int(snap_times[-2])), color=255, scale=1)

    # Mid snapshot
    spin_panel = _spin_map_panel(snapshots_for_figure[2], 200, 200, up_color=250, dn_color=60)
    canvas[20:220, 460:660] = spin_panel
    _draw_text(canvas, 460, 4, 'snapshot t=' + str(int(snap_times[2])), color=255, scale=1)

    # Early snapshot
    spin_panel = _spin_map_panel(snapshots_for_figure[0], 100, 100, up_color=250, dn_color=60)
    canvas[40:140, 720:820] = spin_panel
    _draw_text(canvas, 720, 28, 'snapshot t=' + str(int(snap_times[0])), color=255, scale=1)

    _draw_text(canvas, 720, 170, 'channel defs:', color=220, scale=1)
    _draw_text(canvas, 720, 180, '  seriesA: e, |m|', color=220, scale=1)
    _draw_text(canvas, 720, 190, '  seriesB: |S(k,0)|^2, |S(0,k)|^2', color=220, scale=1)
    _draw_text(canvas, 720, 200, '  stackD: col-mean', color=220, scale=1)
    _draw_text(canvas, 720, 210, '  stackE: row, col-means', color=220, scale=1)
    _draw_text(canvas, 720, 220, '  stackC: C(r,t) for collapse', color=220, scale=1)

    meas_t_float = np.arange(5.0, 5.0 + seriesA.shape[1])
    p1 = _line_plot_panel(meas_t_float,
                          [(seriesA[0], 'energy', 255), (seriesA[1], '|m|', 180)],
                          x_log=True, y_log=False,
                          xlabel='t (MCS)', ylabel='e |m|',
                          title='energy (white)  |m| (grey)',
                          panel_w=480, panel_h=280)
    canvas[260:540, 20:500] = p1

    L_t = np.asarray(L_arr, dtype=np.float64)
    t_snap = np.asarray(snap_times, dtype=np.float64)
    ld_log = np.log(L_t); lt_log = np.log(t_snap)
    p = np.polyfit(lt_log, ld_log, 1)
    fit_curve = np.exp(p[1]) * t_snap ** p[0]
    p2 = _line_plot_panel(t_snap,
                          [(L_t, 'L', 255), (fit_curve, 'fit', 130)],
                          x_log=True, y_log=True,
                          xlabel='t (MCS)', ylabel='L',
                          title=f'L(t) (white)  fit a={p[0]:.2f} b=10e{p[1]:.1f}',
                          panel_w=480, panel_h=280)
    canvas[260:540, 510:990] = p2

    p3 = _collapse_panel(stackC, L_arr, max_r, panel_w=970, panel_h=200)
    canvas[550:750, 20:990] = p3

    write_png_grayscale(output_path, canvas)


# ===========================================================================
# 5. Execution
# ===========================================================================
def run():
    with open(PARAM_PATH) as f:
        P = json.load(f)

    grid_size = int(P['grid_size'])
    T = float(P['control'])
    n_steps = int(P['n_steps'])
    n_snapshots = int(P['n_snapshots'])
    n_measurements = int(P['n_measurements'])
    snap_times = [float(t) for t in P['snapshot_times']]
    meas_times = [float(t) for t in P['measurement_times']]
    max_r = int(P['max_r'])
    seed = int(P['dynamics_seed'])

    s = np.load(STATE_PATH).copy()
    assert s.shape == (grid_size, grid_size), f"bad initial_state shape {s.shape}"
    assert set(np.unique(s).tolist()).issubset({-1, 1})

    rng = np.random.default_rng(seed)

    meas_idx_map = {}
    for mt_idx, t in enumerate(meas_times):
        meas_idx_map.setdefault(int(t), []).append(mt_idx)
    snap_idx_map = {}
    for st_idx, t in enumerate(snap_times):
        snap_idx_map.setdefault(int(t), []).append(st_idx)

    seriesA = np.zeros((2, n_measurements), dtype=np.float64)
    seriesB = np.zeros((2, n_measurements), dtype=np.float64)
    stackC = np.zeros((n_snapshots, max_r), dtype=np.float64)
    stackD = np.zeros((n_snapshots, grid_size), dtype=np.float64)
    stackE = np.zeros((n_snapshots, 2, grid_size), dtype=np.float64)

    snapshots_for_figure = [None] * n_snapshots

    t0 = time.time()
    last_report = t0
    for step in range(1, n_steps + 1):
        metropolis_sweep(s, T, rng)

        on_meas = step in meas_idx_map
        on_snap = step in snap_idx_map

        if on_meas or on_snap:
            e_val = measure_energy(s)
            m_val = measure_magnetization(s)
            if on_meas:
                k1, k2 = measure_lowk_modes(s)
            if on_snap:
                rc = radial_correlation(s, max_r)
                cm = column_mean(s)
                rm = row_mean(s)

        if on_meas:
            for mi in meas_idx_map[step]:
                seriesA[0, mi] = e_val
                seriesA[1, mi] = m_val
                seriesB[0, mi] = k1
                seriesB[1, mi] = k2

        if on_snap:
            for si in snap_idx_map[step]:
                stackC[si, :] = rc
                stackD[si, :] = cm
                stackE[si, 0, :] = rm
                stackE[si, 1, :] = cm
                snapshots_for_figure[si] = s.copy()

        if step % 2000 == 0 or step == n_steps:
            now = time.time()
            print(f"  step {step:6d}/{n_steps}  "
                  f"e={e_val:+.4f} |m|={m_val:.4f}  "
                  f"({(step / n_steps) * 100:5.1f}% | {(now - last_report):.1f}s)",
                  flush=True)
            last_report = now

    total_time = time.time() - t0

    L_arr, zc_mask = domain_length_from_correlation(stackC, max_r)
    metaA = compute_collapse_metadata(stackC, snap_times, max_r, zc_mask)
    metaB = fit_growth_exponent(snap_times, L_arr, zc_mask)

    assert np.isfinite(seriesA).all()
    assert np.isfinite(seriesB).all()
    assert np.isfinite(stackC).all()
    assert np.isfinite(stackD).all()
    assert np.isfinite(stackE).all()

    np.save(OUT_SERIESA, seriesA)
    np.save(OUT_SERIESB, seriesB)
    np.save(OUT_STACKC, stackC)
    np.save(OUT_STACKD, stackD)
    np.save(OUT_STACKE, stackE)
    with open(OUT_METAA, 'w') as f:
        json.dump(metaA, f, indent=2)
    with open(OUT_METAB, 'w') as f:
        json.dump(metaB, f, indent=2)

    build_figure(snapshots_for_figure, snap_times, seriesA, seriesB, stackC,
                 L_arr, OUT_FIGURE, max_r)

    return {
        'seriesA': OUT_SERIESA,
        'seriesB': OUT_SERIESB,
        'stackC': OUT_STACKC,
        'stackD': OUT_STACKD,
        'stackE': OUT_STACKE,
        'metadataA': OUT_METAA,
        'metadataB': OUT_METAB,
        'figure': OUT_FIGURE,
        'total_time_s': f'{total_time:.2f}',
        'L_arr': L_arr.tolist(),
        'seriesA_final_e': float(seriesA[0, -1]),
        'seriesA_final_m': float(seriesA[1, -1]),
        'seriesB_final_k1': float(seriesB[0, -1]),
        'seriesB_final_k2': float(seriesB[1, -1]),
        'exponent': metaB['exponent'],
        'r_squared': metaB['r_squared'],
        'collapse_quality': metaA['collapse_quality'],
    }


if __name__ == '__main__':
    out = run()
    print('\n=== Simulation complete ===')
    for k, v in out.items():
        print(f'  {k}: {v}')
