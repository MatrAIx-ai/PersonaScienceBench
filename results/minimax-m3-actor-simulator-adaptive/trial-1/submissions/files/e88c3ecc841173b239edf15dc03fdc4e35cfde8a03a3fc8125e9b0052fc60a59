"""Refine p-values (which underflowed to 0.0) and write the final artifacts."""
import json, numpy as np, pandas as pd
from scipy import stats

df = pd.read_csv('/workspace/data/nls_incarceration_processed.csv')
YEARS = [1985, 1990, 1996]
LOG_COLS = {y: "log_shift_" + str(y) for y in YEARS}
for y in YEARS:
    col = "composite_wealth_" + str(y)
    wmin = df[col].min()
    df[LOG_COLS[y]] = np.log1p(df[col] - wmin)

def precise_welch(x, y):
    nx, ny = len(x), len(y)
    mx, my = x.mean(), y.mean()
    sx2, sy2 = x.var(ddof=1), y.var(ddof=1)
    se = float(np.sqrt(sx2/nx + sy2/ny))
    t = (mx - my) / se
    df_w = (sx2/nx + sy2/ny)**2 / ((sx2/nx)**2/(nx-1) + (sy2/ny)**2/(ny-1))
    p = 2.0 * stats.t.sf(abs(t), df_w)
    return float(t), float(df_w), float(p)

def holm(ps):
    n = len(ps); order = sorted(range(n), key=lambda i: ps[i])
    adj = [0.0]*n; running = 0.0
    for rank, idx in enumerate(order, start=1):
        v = min(1.0, (n - rank + 1) * ps[idx])
        running = max(running, v)
        adj[idx] = running
    return adj

out = []
for y in YEARS:
    col = "composite_wealth_" + str(y)
    logcol = LOG_COLS[y]
    g0 = df.loc[df.ever_jailed == 0, logcol]
    g1 = df.loc[df.ever_jailed == 1, logcol]
    raw0 = df.loc[df.ever_jailed == 0, col]
    raw1 = df.loc[df.ever_jailed == 1, col]
    t, df_w, p_t = precise_welch(g1, g0)
    u_res = stats.mannwhitneyu(raw1, raw0, alternative='two-sided')
    u = float(u_res.statistic)
    n1, n2 = len(raw1), len(raw0)
    mu = n1 * n2 / 2
    sigma = np.sqrt(n1 * n2 * (n1 + n2 + 1) / 12)
    z = (u - mu) / sigma
    p_mw = 2.0 * stats.norm.sf(abs(z))
    out.append({'year': y, 'welch_t': t, 'welch_df': df_w, 'welch_p_exact': p_t,
                'mw_u': u, 'mw_z': float(z), 'mw_p_approx': float(p_mw)})

# Update results.json
res = json.load(open('/workspace/artifacts/results.json'))
welch_ps = [o['welch_p_exact'] for o in out]
mw_ps = [o['mw_p_approx'] for o in out]
welch_holm = holm(welch_ps)
mw_holm = holm(mw_ps)

def fmt_p(p):
    if p < 1e-300: return "<1e-300"
    return f"{p:.3e}"

print("\nPRECISE Welch t-test results:")
for o, hp in zip(out, welch_holm):
    print("  year=" + str(o['year']) + "  t=" + f"{o['welch_t']:.4f}" +
          "  df=" + f"{o['welch_df']:.2f}" +
          "  p=" + fmt_p(o['welch_p_exact']) +
          "  Holm-p=" + fmt_p(hp))

print("\nPRECISE Mann-Whitney results (normal approx w/ continuity correction skipped):")
for o, hp in zip(out, mw_holm):
    print("  year=" + str(o['year']) + "  U=" + f"{o['mw_u']:.1f}" +
          "  z=" + f"{o['mw_z']:.3f}" +
          "  p=" + fmt_p(o['mw_p_approx']) +
          "  Holm-p=" + fmt_p(hp))

for i, r in enumerate(res['per_year']):
    r['welch_p_raw'] = welch_ps[i]
    r['welch_p_holm'] = welch_holm[i]
    r['mw_p_raw']     = mw_ps[i]
    r['mw_p_holm']    = mw_holm[i]

with open('/workspace/artifacts/results.json','w') as f:
    json.dump(res, f, indent=2)

# Rewrite per_year_results.csv as a clean per-year table
table = pd.DataFrame(res['per_year'])
# Round float columns for display
for c in table.columns:
    if table[c].dtype.kind == 'f':
        table[c] = table[c].round(6)
table.to_csv('/workspace/artifacts/per_year_results.csv', index=False)

pd.DataFrame(out).to_csv('/workspace/artifacts/exact_pvalues.csv', index=False)
print("\nArtifacts updated: per_year_results.csv, results.json, exact_pvalues.csv")
