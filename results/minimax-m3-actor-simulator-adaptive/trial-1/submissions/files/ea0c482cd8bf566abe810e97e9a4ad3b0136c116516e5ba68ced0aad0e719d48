"""
analysis.py — discoverybench/test/archaeology/metadata_9.json/0/0

Q: "In which century did summed social capital peak, what individual
    social capital components (e.g. gold, monument, etc.) increase?"

Social capital = ZCU_AU + Zamber + ZMonument (= CopperGold + Amber +
                                              MonumentCount).

Primary dataset: data/capital.csv (39 per-century rows, BCE 4300..500).
Sensitivity    : block-mean of *_inter in data/time_series_data.csv.
"""
import pandas as pd
import numpy as np
import json

cap = pd.read_csv('/workspace/data/capital.csv')
for c in ['ZAxtSchwert','ZDolch','Zhausgr','ZCU_AU','Zamber','ZMonument',
         'ZHort','ZSichel','ZBeil','ZMW','ZKeform','Zkeverz']:
    cap[c] = pd.to_numeric(cap[c].astype(str).str.replace(',','.',regex=False),
                           errors='coerce')

# Working frame, CHRONOLOGICAL order (earliest BCE first / largest BCE first).
# In BCE chronology, *larger* BCE = *earlier* in time.
cap = cap.sort_values('BCE', ascending=False).reset_index(drop=True)

prim = cap[['BCE','group','ZCU_AU','Zamber','ZMonument']].copy().rename(
    columns={'ZCU_AU':'CopperGold','Zamber':'Amber','ZMonument':'MonumentCount'})
prim['SocCap'] = prim['CopperGold'] + prim['Amber'] + prim['MonumentCount']
# rank largest SocCap first
prim['rank']    = prim['SocCap'].rank(ascending=False, method='min').astype(int)

# ---- peak (ties reported; canonical = earliest in BCE chronology = max BCE)
peak_val       = prim['SocCap'].max()
peak_rows      = prim[prim['SocCap'] == peak_val]
canon_bce      = int(peak_rows['BCE'].max())  # largest BCE = earliest in time
canon_idx      = prim.index[prim['BCE'] == canon_bce][0]
print('=== PRIMARY (raw anchor values, capital.csv) ===')
print(f'Shape: {prim.shape} ; BCE span {prim["BCE"].min()}..{prim["BCE"].max()}\n')
print('Peak: SocCap =', peak_val)
print('Peak centuries (raw anchor): BCE',
      sorted(peak_rows['BCE'].tolist(), reverse=True))
print(f'Canonical = earliest in BCE chronology = BCE {canon_bce}\n')

print('Top 10 centuries:')
print(prim.sort_values('rank').head(10)[['rank','BCE','group','CopperGold',
       'Amber','MonumentCount','SocCap']].to_string(index=False))

# ---- neighborhood of the canonical (earliest-in-time) peak BCE 1400
prev_bce = int(prim.loc[canon_idx+1, 'BCE'])   # chronologically *later*
next_bce = int(prim.loc[canon_idx-1, 'BCE'])   # chronologically *earlier*
prev = prim.loc[canon_idx+1]
cur  = prim.loc[canon_idx]
nxt  = prim.loc[canon_idx-1]
print(f"\nNeighborhood of canonical BCE {canon_bce} (chronological "
      f"order: BCE {next_bce} -> BCE {canon_bce} (next: {next_bce}, prev: {prev_bce})):")
nb = pd.DataFrame({
    'BCE'         : [next_bce, canon_bce, prev_bce],
    'phase'       : [nxt['group'], cur['group'], prev['group']],
    'CopperGold'  : [nxt['CopperGold'],   cur['CopperGold'],   prev['CopperGold']],
    'Amber'       : [nxt['Amber'],        cur['Amber'],        prev['Amber']],
    'MonumentCount':[nxt['MonumentCount'],cur['MonumentCount'],prev['MonumentCount']],
    'SocCap'      : [nxt['SocCap'],       cur['SocCap'],       prev['SocCap']]
})
print(nb.to_string(index=False))

# enter-peak: nxt -> canon  (chronologically *earlier* into *later*)
# exit-peak : canon -> prev (chronologically *later* into *earlier*)
delta_enter = {  # previous century -> peak
    'CopperGold'  : cur['CopperGold']  - nxt['CopperGold'],
    'Amber'       : cur['Amber']       - nxt['Amber'],
    'MonumentCount': cur['MonumentCount'] - nxt['MonumentCount'],
    'SocCap'      : cur['SocCap']      - nxt['SocCap'],
}
delta_exit = {  # peak -> next century
    'CopperGold'  : prev['CopperGold']  - cur['CopperGold'],
    'Amber'       : prev['Amber']       - cur['Amber'],
    'MonumentCount': prev['MonumentCount'] - cur['MonumentCount'],
    'SocCap'      : prev['SocCap']      - cur['SocCap'],
}
print(f"\nENTER peak  (BCE {next_bce} -> {canon_bce}): "
      f"{ {k: round(v,4) for k,v in delta_enter.items()} }")
print(f"EXIT peak   (BCE {canon_bce} -> {prev_bce}): "
      f"{ {k: round(v,4) for k,v in delta_exit.items()} }")

# ---- comparison vs. longer baseline (MN/SG/LN, BCE 3200..1700)
baseline = prim[(prim['BCE'] >= 1700) & (prim['BCE'] <= 3200)]
bl_mean = {
    'CopperGold'  : baseline['CopperGold'].mean(),
    'Amber'       : baseline['Amber'].mean(),
    'MonumentCount': baseline['MonumentCount'].mean(),
    'SocCap'      : baseline['SocCap'].mean(),
}
peak_vs_bl = {k: cur[k] - bl_mean[k] for k in bl_mean}
print(f"\nBaseline BCE 3200..1700 (n={len(baseline)} centuries) means:")
for k,v in bl_mean.items(): print(f"  {k:14s} = {v:+.4f}")
print(f"Peak (BCE {canon_bce}) − baseline:")
for k,v in peak_vs_bl.items(): print(f"  {k:14s} = {v:+.4f}")

# ---- which components rise vs. the LONG baseline?
print("\nComponents that show a *positive* excess above the long baseline "
      "at the peak (canonical BCE 1400):")
for k in ['CopperGold','Amber','MonumentCount']:
    flag = '↑ INCREASES' if peak_vs_bl[k] > 0 else '↓ decreases'
    print(f"  {k:14s}: {peak_vs_bl[k]:+.4f}  {flag}")

# Component-wise ranking: who is highest at the peak?
print("\nComponent-wise maxima of each series:")
for k in ['CopperGold','Amber','MonumentCount']:
    mx = prim[k].max(); idx = prim[k].idxmax()
    print(f"  {k:14s}: max = {mx:+.4f} at BCE "
          f"{int(prim.loc[idx,'BCE'])} ({prim.loc[idx,'group']})")

# ================== Sensitivity: block-mean of *_inter ==============
ts = pd.read_csv('/workspace/data/time_series_data.csv', index_col=0)
ts = ts.sort_values('CE').reset_index(drop=True)
ts['bin']        = (ts.index.values // 100).astype(int)
ts['bce_repr']   = -ts['CE']
agg = ts.groupby('bin').agg(
    CopperGold_inter    = ('CopperGold_inter','mean'),
    Amber_inter         = ('Amber_inter','mean'),
    MonumentCount_inter = ('MonumentCount_inter','mean'),
    BCE                 = ('bce_repr','first'),
).reset_index(drop=True)
agg = agg.rename(columns={'CopperGold_inter':'CopperGold',
                          'Amber_inter'     :'Amber',
                          'MonumentCount_inter':'MonumentCount'})
agg['SocCap'] = agg['CopperGold'] + agg['Amber'] + agg['MonumentCount']
agg = agg.sort_values('BCE', ascending=False).reset_index(drop=True)
print('\n=== SENSITIVITY (block-mean of *_inter, 100-yr bins) ===')
print(f'Rows: {len(agg)}  BCE range {agg["BCE"].min()}..{agg["BCE"].max()}')
print(f'Sensitivity peak: SocCap = {agg["SocCap"].max():.6f}, '
      f'centuries = '
      f'{sorted(agg[agg["SocCap"]==agg["SocCap"].max()]["BCE"].tolist(),reverse=True)}')
print(agg.nlargest(8,'SocCap')[['BCE','CopperGold','Amber',
                                 'MonumentCount','SocCap']].to_string(index=False))

merged = prim[['BCE','SocCap','CopperGold','Amber','MonumentCount']].merge(
    agg[['BCE','SocCap','CopperGold','Amber','MonumentCount']],
    on='BCE', suffixes=('_raw','_bmean'))
print("\nΔ per century (raw anchor − block-mean of *_inter):")
for k in ['CopperGold','Amber','MonumentCount','SocCap']:
    d = (merged[k+'_raw'] - merged[k+'_bmean']).abs()
    print(f"  {k:14s}: max abs diff = {d.max():+.4f} ; "
          f"median abs diff = {d.median():+.4f}")

# --------- artifacts ------------------------------------------------------------
out = prim.sort_values('BCE', ascending=True).reset_index(drop=True)
out['rank'] = out['SocCap'].rank(ascending=False, method='min').astype(int)
out = out[['rank','BCE','group','CopperGold','Amber','MonumentCount','SocCap']]
out.to_csv('/workspace/artifacts/per_century_social_capital.csv', index=False)
print('\nWrote /workspace/artifacts/per_century_social_capital.csv '
      f'({len(out)} rows).')

# JSON summary
summary = {
  'benchmark'      : 'discoverybench',
  'episode_id'     : 'discoverybench:test/archaeology/metadata_9.json/0/0',
  'definition'     : 'Social capital = CopperGold + Amber + MonumentCount '
                      '(Z-scores), i.e. ZCU_AU + Zamber + ZMonument in '
                      'capital.csv',
  'primary_method' : 'raw per-century anchor Z-values from data/capital.csv',
  'sensitivity_method': 'block-mean of *_inter series in '
                        'data/time_series_data.csv (100-yr bins)',
  'primary_peak'  : {
     'value'             : float(round(peak_val, 6)),
     'centuries_bce'     : sorted([int(b) for b in peak_rows['BCE']], reverse=True),
     'canonical_bce'     : canon_bce,
     'tie_explanation'   : ('Both BCE 1400 and BCE 1300 carry identical '
                            'components (CopperGold=2.54, Amber=−0.01, '
                            'MonumentCount=1.708082), so SocCap ties at '
                            '4.238082. In BCE chronology the '
                            'earlier-in-time occurrence = largest BCE = 1400. '
                            'We adopt BCE 1400 as the canonical first '
                            'occurrence; BCE 1300 is an equally valid tie.'),
     'phase'             : 'OBA (Late Únětice / Old Bronze Age)'
  },
  'enter_peak_delta_bce1500_to_1400' : {
     'CopperGold'   : float(round(delta_enter['CopperGold'], 4)),
     'Amber'        : float(round(delta_enter['Amber'], 4)),
     'MonumentCount': float(round(delta_enter['MonumentCount'], 4)),
     'SocCap'       : float(round(delta_enter['SocCap'], 4))
  },
  'exit_peak_delta_bce1400_to_1300'  : {
     'CopperGold'   : float(round(delta_exit['CopperGold'], 4)),
     'Amber'        : float(round(delta_exit['Amber'], 4)),
     'MonumentCount': float(round(delta_exit['MonumentCount'], 4)),
     'SocCap'       : float(round(delta_exit['SocCap'], 4))
  },
  'baseline_bce_3200_to_1700_mean': {
     'CopperGold'   : float(round(bl_mean['CopperGold'], 4)),
     'Amber'        : float(round(bl_mean['Amber'], 4)),
     'MonumentCount': float(round(bl_mean['MonumentCount'], 4)),
     'SocCap'       : float(round(bl_mean['SocCap'], 4))
  },
  'peak_minus_long_baseline_canonical_bce_1400' : {
     'CopperGold'   : float(round(peak_vs_bl['CopperGold'], 4)),
     'Amber'        : float(round(peak_vs_bl['Amber'], 4)),
     'MonumentCount': float(round(peak_vs_bl['MonumentCount'], 4)),
     'SocCap'       : float(round(peak_vs_bl['SocCap'], 4))
  },
  'components_whose_z_is_above_baseline_at_peak_and_how_much' : {
     'CopperGold'   : f"+{round(peak_vs_bl['CopperGold'],3)} (strong increase)",
     'MonumentCount': f"+{round(peak_vs_bl['MonumentCount'],3)} (strong increase)",
     'Amber'        : f"+{round(peak_vs_bl['Amber'],3)} (weak / marginal increase)"
  },
  'sensitivity'  : {
     'peak_value'           : float(round(agg['SocCap'].max(), 6)),
     'peak_centuries_bce'   : sorted([int(b) for b in
                                agg[agg['SocCap']==agg['SocCap'].max()]
                                ['BCE'].tolist()], reverse=True),
     'agrees_with_primary'  : (canon_bce in agg[agg['SocCap']==agg['SocCap']
                                .max()]['BCE'].tolist())
  }
}
with open('/workspace/artifacts/summary.json', 'w') as f:
    json.dump(summary, f, indent=2)
print('\nWrote /workspace/artifacts/summary.json')
