"""
DiscoveryBench task: meta_regression_raw / metadata_10 / item 0
Question: "What is the proportion of junior professors in replicated studies in Psychology?"

Decisiones (aprobadas por el investigador):
  - Psicología   = project == 'rpp'
  - Pre-filtro  = drop == False
  - Júnior      = {Assistant, Assistant Professor}
  - Senioridad definida excluye 'Researcher' (categoría aparte) en el cómputo principal
  - Sensibilidad = 'Researcher' también contado como júnior
  - Datos       = columna seniority.r del equipo de replicación
"""
import pandas as pd, json, os

df = pd.read_csv("data/meta-regression_study_data_heterogeneity_in_replication_projects.csv")
sub = df[(df["project"] == "rpp") & (df["drop"] == False)].copy()

JUNIOR  = {"Assistant", "Assistant Professor"}
SENIOR  = {"Professor", "Associate Professor"}
DEFINED = JUNIOR | SENIOR

n_post    = len(sub)
n_def     = int(sub["seniority.r"].isin(DEFINED).sum())
n_junior  = int(sub["seniority.r"].isin(JUNIOR).sum())
n_researcher = int((sub["seniority.r"] == "Researcher").sum())
prop_primary = n_junior / n_def

n_junior_inc = int(sub["seniority.r"].isin(JUNIOR | {"Researcher"}).sum())
prop_inclusive = n_junior_inc / n_post

rep1 = sub[sub["replicated"] == 1]
pj1 = (int(rep1["seniority.r"].isin(JUNIOR).sum())
       / int(rep1["seniority.r"].isin(DEFINED).sum())) if len(rep1) else None

out = {
    "filter": {"project": "rpp", "drop": False},
    "n_post_filtro": n_post,
    "seniority_r_counts": sub["seniority.r"].value_counts().to_dict(),
    "primary": {
        "definition_junior": sorted(JUNIOR),
        "definition_senior": sorted(SENIOR),
        "researcher_excluded_from_denominator": True,
        "n_junior": n_junior, "n_senior": n_def - n_junior,
        "n_researcher_excluded": n_researcher,
        "n_defined_seniority": n_def,
        "proportion_junior": prop_primary,
    },
    "sensitivity_researcher_as_junior": {
        "n_junior_inclusive": n_junior_inc,
        "n_post_filtro": n_post,
        "proportion_junior_inclusive": prop_inclusive,
    },
    "informational_replicated_eq_1": {
        "n": len(rep1),
        "n_junior": int(rep1["seniority.r"].isin(JUNIOR).sum()),
        "n_defined": int(rep1["seniority.r"].isin(DEFINED).sum()),
        "proportion": pj1,
    },
}
os.makedirs("artifacts", exist_ok=True)
with open("artifacts/result_summary.json", "w") as f:
    json.dump(out, f, indent=2)
print(json.dumps(out, indent=2))
