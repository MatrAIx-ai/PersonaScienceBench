"""
DiscBench — SSA vs LMC education-expenditure on GNI per capita.
Pipeline:
  1. Load wide CSV (2 country groups x 6 indicators x 1975..2015).
  2. Reshape to long panel (group, year, variable).
  3. Restrict to 1991-2015 (balanced window for all 6 series on both groups).
  4. Run ADF stationarity tests on log GNI per capita and Educ for each group.
  5. Headline: pooled OLS, change in log GNI on group FE + Educ + D_LMC*Educ
     + controls, Newey-West HAC SE.
  6. Robustness 1: separate-by-group OLS regressions.
  7. Robustness 2: pooled OLS in LEVELS with lagged DV (ARDL flavor).
  8. Robustness 3: same as headline but with winsorized exports growth.
  9. Print coefficients and dump a JSON with all numbers for the final handoff.
"""
import json
import warnings
warnings.filterwarnings("ignore")

import numpy as np
import pandas as pd
import statsmodels.api as sm
from statsmodels.tsa.stattools import adfuller

CSV_PATH = "/workspace/data/worldbank_education_gdp.csv"
OUT_JSON = "/workspace/analyses/results.json"

# ---------- 1. Load ----------
raw = pd.read_csv(CSV_PATH)

year_cols = [c for c in raw.columns if c.startswith("19") or c.startswith("20")]
year_cols = [c for c in raw.columns if "[YR" in c]
years = np.array([int(c.split("[")[0]) for c in year_cols])

# Long-format skeleton per (group, year, series)
rows = []
for _, r in raw.iterrows():
    grp = r["Country Group"]; code = r["Country Code"]
    for c, y in zip(year_cols, years):
        v = r[c]
        if pd.isna(v) or v == "" or v == "..":
            val = np.nan
        else:
            try:
                val = float(v)
            except Exception:
                val = np.nan
        rows.append({"group": grp, "code": code, "year": int(y),
                     "series": r["Series Name"], "value": val})
long = pd.DataFrame(rows)

# Quick mapping of series to a short variable name
SERIES_MAP = {
    "GNI per capita (constant 2015 USdollar)": "gni_pc",
    "Adjusted savings: education expenditure (percentage of GNI)": "educ",
    "Exports of goods and services (annual percentage growth)": "exp_g",
    "School enrollment, primary (percentage gross)": "prim_enr",
    "School enrollment, secondary (percentage gross)": "sec_enr",
    "Labor force participation rate, total (percentage of total population ages 15+) (modeled ILO estimate)": "lfp",
}
long["var"] = long["series"].map(SERIES_MAP)
assert long["var"].notna().all(), "Unmapped series detected"

panel = long.pivot_table(index=["group", "year"], columns="var",
                         values="value").reset_index()
panel = panel.sort_values(["group", "year"]).reset_index(drop=True)

# Drop the model-ILO labor rate series' completely-missing pre-1991 obs
# already; they are NaN. Restrict window.
WINDOW = (panel["year"] >= 1991) & (panel["year"] <= 2015)
pw = panel[WINDOW].copy().reset_index(drop=True)

# ---------- 2. Construct dependent / regressor variables ----------
pw["ln_gni"] = np.log(pw["gni_pc"])
pw["d_ln_gni"] = pw.groupby("group")["ln_gni"].diff()
pw["educ_lag1"] = pw.groupby("group")["educ"].shift(1)
pw["ln_gni_lag1"] = pw.groupby("group")["ln_gni"].shift(1)

# Group dummy (LMC=1, SSA=0)
pw["D_LMC"] = (pw["group"] == "Lower middle income").astype(float)
pw["D_LMC_x_educ"] = pw["D_LMC"] * pw["educ"]

# ---------- 3. ADF stationarity on log GNI and Educ per group ----------
adf_rows = []
for grp_name, df in pw.groupby("group"):
    for v in ["ln_gni", "educ"]:
        s = df[v].dropna().values
        if len(s) >= 10:
            stat, p, *_ = adfuller(s, autolag="AIC", regression="c")
            adf_rows.append({"group": grp_name, "variable": v,
                             "n": len(s), "adf_stat": float(stat),
                             "pvalue": float(p)})
        else:
            adf_rows.append({"group": grp_name, "variable": v,
                             "n": int(len(s)), "adf_stat": None,
                             "pvalue": None})

# ---------- 4. Headline model: Δln GNI on group FE + Educ + D_LMC*Educ + controls ----------
def fit_nw(y, X, maxlags=None):
    """OLS + Newey-West HAC SE (Bartlett kernel). Returns dict of stats."""
    n_total = int(len(y))
    valid = y.notna() & X.notna().all(axis=1)
    yv = y[valid]; Xv = X[valid]
    n = int(len(yv))
    if maxlags is None:
        # Andrews automatic bandwidth ~ int(4*(n/100)^(2/9))
        maxlags = max(1, int(4 * (n / 100.0) ** (2 / 9)))
    res = sm.OLS(yv, sm.add_constant(Xv)).fit(
        cov_type="HAC", cov_kwds={"maxlags": maxlags}
    )
    out = {"nobs": n,
           "r2": float(res.rsquared),
           "adj_r2": float(res.rsquared_adj),
           "params": {}, "bse": {}, "tvals": {}, "pvalues": {},
           "maxlags": int(maxlags)}
    for name in res.params.index:
        out["params"][name] = float(res.params[name])
        out["bse"][name] = float(res.bse[name])
        out["tvals"][name] = float(res.tvalues[name])
        out["pvalues"][name] = float(res.pvalues[name])
    return out

# Headline regression on dropout-missing rows
X_cols_head = ["D_LMC", "educ", "D_LMC_x_educ",
               "exp_g", "lfp", "prim_enr", "sec_enr"]
y = pw["d_ln_gni"]
X = pw[X_cols_head]
head = fit_nw(y, X, maxlags=2)

# ---------- 5. Separate-by-group regressions ----------
sep = {}
for grp_name, df in pw.groupby("group"):
    yg = df["d_ln_gni"]
    Xg = df[["educ", "exp_g", "lfp", "prim_enr", "sec_enr"]]
    sep[grp_name] = fit_nw(yg, Xg, maxlags=2)

# ---------- 6. Robustness: levels model with lagged DV ----------
X_cols_lvl = ["D_LMC", "ln_gni_lag1", "educ", "D_LMC_x_educ",
              "exp_g", "lfp", "prim_enr", "sec_enr"]
y_lvl = pw["ln_gni"]
X_lvl = pw[X_cols_lvl]
lvl = fit_nw(y_lvl, X_lvl, maxlags=2)

# ---------- 7. Robustness: winsorized exports growth (only the headline) ----------
# Winsorize at 5%/95% within the 1991-2015 window per group
def winsorize(s, p=0.05):
    lo, hi = s.quantile(p), s.quantile(1 - p)
    return s.clip(lo, hi)

pw["exp_g_w"] = pw.groupby("group")["exp_g"].transform(lambda s: winsorize(s, 0.05))
X_cols_head_w = ["D_LMC", "educ", "D_LMC_x_educ",
                 "exp_g_w", "lfp", "prim_enr", "sec_enr"]
head_w = fit_nw(pw["d_ln_gni"], pw[X_cols_head_w], maxlags=2)

# ---------- 8. Descriptive: change in log GNI per year averages ----------
desc_rows = []
for grp_name, df in pw.groupby("group"):
    d = df["d_ln_gni"].dropna()
    desc_rows.append({"group": grp_name, "n": int(len(d)),
                      "mean_d_ln_gni": float(d.mean()),
                      "std_d_ln_gni": float(d.std()),
                      "min": float(d.min()),
                      "max": float(d.max())})
desc = desc_rows

# ---------- 9. Means of regressors per group on the regression sample ----------
reg_sample_mask = pw["d_ln_gni"].notna() & pw[X_cols_head].notna().all(axis=1)
means_rows = []
for grp_name, df in pw[reg_sample_mask].groupby("group"):
    means_rows.append({"group": grp_name,
                       "n_used": int(len(df)),
                       "mean_educ": float(df["educ"].mean()),
                       "mean_d_ln_gni": float(df["d_ln_gni"].mean())})
means = means_rows

# ---------- 10. Persist all numbers ----------
out = {
    "sample_window": [1991, 2015],
    "adf_tests": adf_rows,
    "descriptives_d_ln_gni": desc,
    "regression_sample_means": means,
    "headline": {
        "dep_var": "delta ln(GNI per capita)",
        "rhs": X_cols_head,
        "result": head,
    },
    "headline_winsor_exp": {
        "dep_var": "delta ln(GNI per capita)",
        "rhs": X_cols_head_w,
        "result": head_w,
    },
    "separate_by_group": sep,
    "levels_lagged_dv": {
        "dep_var": "ln(GNI per capita)",
        "rhs": X_cols_lvl,
        "result": lvl,
    },
}
with open(OUT_JSON, "w") as f:
    json.dump(out, f, indent=2, default=float)
print("WROTE", OUT_JSON)

# ---------- 11. Console printout ----------
def dump(label, res):
    print(f"\n=== {label} ===")
    print(f"  N = {res['nobs']}, R^2 = {res['r2']:.4f}, adj R^2 = {res['adj_r2']:.4f}")
    print(f"  {'var':28} {'coef':>12} {'nw_se':>10} {'t':>8} {'p':>10}")
    for k in res["params"]:
        print(f"  {k:28} {res['params'][k]:12.6f} {res['bse'][k]:10.4f} "
              f"{res['tvals'][k]:8.3f} {res['pvalues'][k]:10.4f}")

dump("HEADLINE (Δln GNI on group FE + Educ + D_LMC*Educ + controls, NW SE)",
     head["__dict__"] if "__dict__" in head else head)
# easier: rebuild labels
def dump_res(label, params, bse, tvals, pvalues, nobs, r2, adj_r2):
    print(f"\n=== {label} ===")
    print(f"  N = {nobs}, R^2 = {r2:.4f}, adj R^2 = {adj_r2:.4f}")
    print(f"  {'var':28} {'coef':>12} {'nw_se':>10} {'t':>8} {'p':>10}")
    for k in params:
        print(f"  {k:28} {params[k]:12.6f} {bse[k]:10.4f} "
              f"{tvals[k]:8.3f} {pvalues[k]:10.4f}")

print("\n################ HEADLINE RESULTS ################")
dump_res("Headline: Δ ln(GNI per capita), pooled, group FE, group×Educ, NW",
         head["params"], head["bse"], head["tvals"], head["pvalues"],
         head["nobs"], head["r2"], head["adj_r2"])
print("\n--- Implied semi-elasticities (per +1 pp of education-expenditure share) ---")
b1 = head["params"]["educ"]; b2 = head["params"]["D_LMC_x_educ"]
se_b1 = head["bse"]["educ"]; se_b2 = head["bse"]["D_LMC_x_educ"]
print(f"  SSA  (beta1)                = {b1:.4f} (NW SE {se_b1:.4f})")
print(f"  LMC  (beta1 + beta2)        = {b1+b2:.4f}")
print(f"  Diff (beta2, interaction)   = {b2:.4f} (NW SE {se_b2:.4f})")

print("\n################ ADF TESTS ################")
for r in adf_rows:
    print(f"  group={r['group']:22}  var={r['variable']:10}  n={r['n']:2}  "
          f"ADF={r['adf_stat']}  p={r['pvalue']}")

print("\n################ SEPARATE-BY-GROUP ################")
for grp_name, res in sep.items():
    dump_res(f"Group: {grp_name}",
             res["params"], res["bse"], res["tvals"], res["pvalues"],
             res["nobs"], res["r2"], res["adj_r2"])

print("\n################ LEVELS + LAGGED DV ################")
dump_res("Levels: ln(GNI per capita) on lag-ln(GNI) + group + Educ + group*Educ + controls, NW",
         lvl["params"], lvl["bse"], lvl["tvals"], lvl["pvalues"],
         lvl["nobs"], lvl["r2"], lvl["adj_r2"])

print("\n################ HEADLINE WITH WINSORIZED EXPORTS ################")
dump_res("Headline (Δ ln GNI) with exports winsorized at 5%/95%, NW",
         head_w["params"], head_w["bse"], head_w["tvals"], head_w["pvalues"],
         head_w["nobs"], head_w["r2"], head_w["adj_r2"])

print("\n################ DESCRIPTIVES ################")
for d in desc:
    print(f"  {d}")
print("\n################ REGRESSION-SAMPLE GROUP MEANS ################")
for d in means:
    print(f"  {d}")
