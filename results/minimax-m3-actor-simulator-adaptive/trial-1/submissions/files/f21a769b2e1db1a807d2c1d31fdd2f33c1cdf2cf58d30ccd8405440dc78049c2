
"""analysis.py - Tabular prior + corridor-continuation policy for the
Levin-context grid search benchmark.

Public interface
----------------
make_policy(training_data: dict, config: dict | None = None) -> Policy
Policy.action_probs(level: dict, state: dict, legal_actions: list[str]) -> dict[str, float]
"""

from __future__ import annotations

import collections
from typing import Any, Iterable, Optional


ACTION_ORDER = ("U", "D", "L", "R")
OPPOSITE = {"U": "D", "D": "U", "L": "R", "R": "L"}


LOWERCASE = set("abcdefghijklmnopqrstuvwxyz")
PASS_THROUGH_LETTERS = LOWERCASE | {"G"}


def _normalize_neighbor(value: Any) -> str:
    """Treat any non-letter / non-G neighbor (including WALL, hash, None, digits,
    lists) as a wall sentinel X. Robust to whichever encoding the scorer uses."""
    if isinstance(value, str) and len(value) == 1 and value in PASS_THROUGH_LETTERS:
        return value
    return "X"


def _neighbor_signature(neighbors):
    if neighbors is None:
        return ("X", "X", "X", "X")
    if isinstance(neighbors, dict):
        ordered = (
            neighbors.get("U", neighbors.get("up")),
            neighbors.get("D", neighbors.get("down")),
            neighbors.get("L", neighbors.get("left")),
            neighbors.get("R", neighbors.get("right")),
        )
    else:
        try:
            ordered = tuple(neighbors)
        except TypeError:
            return ("X", "X", "X", "X")
    padded = list(ordered) + ["X"] * (4 - len(ordered))
    return tuple(_normalize_neighbor(v) for v in padded[:4])


def _legal_mask_tuple(legal_mask, legal_actions):
    actions = list(legal_actions) if legal_actions is not None else []
    if legal_mask is not None:
        try:
            raw = list(legal_mask)
        except TypeError:
            raw = []
        padded = raw + [False] * (4 - len(raw))
        mask = tuple(bool(x) for x in padded[:4])
    else:
        mask = tuple(a in actions for a in ACTION_ORDER)
    actions_set = set(actions)
    return tuple(bool(mask[i]) and ACTION_ORDER[i] in actions_set for i in range(4))


def _bucket_run_length(value):
    """Bucket: 1, 2, 3-5, 6-10, 11+. Pass through string tokens unchanged."""
    if isinstance(value, str):
        return value
    if value is None:
        return "0"
    try:
        n = int(value)
    except (TypeError, ValueError):
        return "?"
    if n <= 1:
        return "1"
    if n == 2:
        return "2"
    if n <= 5:
        return "3-5"
    if n <= 10:
        return "6-10"
    return "11+"


def _step(action):
    return {"U": (-1, 0), "D": (1, 0), "L": (0, -1), "R": (0, 1)}.get(action, (0, 0))


def _peek(grid, H, W, r, c, action):
    dr, dc = _step(action)
    nr, nc = r + dr, c + dc
    if not (0 <= nr < H and 0 <= nc < W):
        return "X"
    return _normalize_neighbor(grid[nr][nc])


def _is_open(grid, H, W, r, c, action):
    dr, dc = _step(action)
    nr, nc = r + dr, c + dc
    return 0 <= nr < H and 0 <= nc < W and grid[nr][nc] != "#"


def _extract_features(cell, neighbors, legal_mask, legal_actions,
                      previous_action, run_length_bucket):
    cell_token = cell if (isinstance(cell, str) and len(cell) == 1
                          and cell in PASS_THROUGH_LETTERS) else "?"
    return {
        "cell": cell_token,
        "neighbors": _neighbor_signature(neighbors),
        "legal_mask": _legal_mask_tuple(legal_mask, legal_actions),
        "prev": previous_action if previous_action in ACTION_ORDER else "NONE",
        "run_bucket": _bucket_run_length(run_length_bucket),
    }



class Policy:
    """Tabular prior over (cell, neighbor pattern, legal mask, prev action,
    run-length bucket) -> action distribution, trained from solved
    trajectories. Five-level fallback chain drives robust inference when the
    full key has no entry."""

    ANTI_OSCILLATION_FACTOR = 0.1
    CONTINUE_BIAS = 0.85

    def __init__(self, training_data=None, config=None):
        self.config = config or {}
        self._table = collections.defaultdict(collections.Counter)
        self._no_run = collections.defaultdict(collections.Counter)
        self._no_cell = collections.defaultdict(collections.Counter)
        self._no_neighbors = collections.defaultdict(collections.Counter)
        self._mask_only = collections.defaultdict(collections.Counter)
        self._train_levels = 0
        self._train_steps = 0
        if training_data:
            self._train(training_data)

    def _train(self, training_data):
        levels = training_data.get("levels", []) if training_data else []
        for lvl in levels:
            self._add_level(lvl)

    def _add_level(self, lvl):
        sol = lvl.get("solution") or []
        grid = lvl.get("grid") or []
        start = lvl.get("start")
        if not sol or not grid or not start:
            return
        self._train_levels += 1
        sr, sc = int(start[0]), int(start[1])
        prev_action = None
        run_len = 0
        r, c = sr, sc
        H = len(grid)
        W = len(grid[0]) if grid else 0
        self._record_step(r, c, grid, H, W, prev_action, run_len, sol[0])
        prev_action = sol[0]
        run_len = 1
        for a in sol[1:]:
            dr, dc = _step(a)
            nr, nc = r + dr, c + dc
            if not (0 <= nr < H and 0 <= nc < W and grid[nr][nc] != "#"):
                break
            r, c = nr, nc
            if a == prev_action:
                run_len += 1
            else:
                run_len = 1
            self._record_step(r, c, grid, H, W, prev_action, run_len, a)
            prev_action = a

    def _record_step(self, r, c, grid, H, W, prev_action, run_len, target):
        cell = grid[r][c]
        neighbors = tuple(_normalize_neighbor(_peek(grid, H, W, r, c, a))
                          for a in ACTION_ORDER)
        legal_mask = tuple(_is_open(grid, H, W, r, c, a) for a in ACTION_ORDER)
        run_bucket = _bucket_run_length(run_len)
        prev_token = prev_action if prev_action in ACTION_ORDER else "NONE"

        full = (cell, neighbors, legal_mask, prev_token, run_bucket)
        no_run = (cell, neighbors, legal_mask, prev_token)
        no_cell = (neighbors, legal_mask, prev_token, run_bucket)
        no_neighbors = (cell, legal_mask, prev_token, run_bucket)
        mask_only = (legal_mask, prev_token)

        self._table[full][target] += 1
        self._no_run[no_run][target] += 1
        self._no_cell[no_cell][target] += 1
        self._no_neighbors[no_neighbors][target] += 1
        self._mask_only[mask_only][target] += 1
        self._train_steps += 1


    def action_probs(self, level, state, legal_actions):
        legal_actions = list(legal_actions) if legal_actions else []
        if not isinstance(state, dict):
            state = {}

        cell = state.get("cell")
        neighbors = state.get("neighbors")
        legal_mask = state.get("legal_mask")
        previous_action = state.get("previous_action")
        run_length_bucket = state.get("run_length_bucket")
        _ = state.get("history")
        _ = state.get("history_tail")
        _ = state.get("depth")
        _ = state.get("depth_mod")
        _ = state.get("depth_phase")

        if not legal_actions:
            return {}

        legal_set = set(legal_actions)
        candidates = [a for a in ACTION_ORDER if a in legal_set]
        if not candidates:
            candidates = list(legal_actions)

        feats = _extract_features(cell, neighbors, legal_mask, legal_actions,
                                  previous_action, run_length_bucket)

        mask_tuple = tuple(feats["legal_mask"][i] and ACTION_ORDER[i] in legal_set
                           for i in range(4))

        counter = self._lookup(
            full=(feats["cell"], feats["neighbors"], mask_tuple,
                  feats["prev"], feats["run_bucket"]),
            no_run=(feats["cell"], feats["neighbors"], mask_tuple,
                    feats["prev"]),
            no_cell=(feats["neighbors"], mask_tuple, feats["prev"],
                     feats["run_bucket"]),
            no_neighbors=(feats["cell"], mask_tuple, feats["prev"],
                          feats["run_bucket"]),
            mask_only=(mask_tuple, feats["prev"]),
        )

        scores = self._counter_to_scores(counter, candidates)
        if not scores or sum(scores.values()) == 0.0:
            scores = self._continue_bias(feats["prev"], candidates)
        scores = self._apply_anti_oscillation(scores, feats["prev"], candidates)
        return self._normalize(scores, candidates)

    def _lookup(self, full, no_run, no_cell, no_neighbors, mask_only):
        if full in self._table:
            return self._table[full]
        if no_run in self._no_run:
            return self._no_run[no_run]
        if no_cell in self._no_cell:
            return self._no_cell[no_cell]
        if no_neighbors in self._no_neighbors:
            return self._no_neighbors[no_neighbors]
        if mask_only in self._mask_only:
            return self._mask_only[mask_only]
        return collections.Counter()

    @staticmethod
    def _counter_to_scores(counter, candidates):
        scores = {}
        for a in candidates:
            v = counter.get(a, 0)
            if v > 0:
                scores[a] = float(v)
        return scores

    @staticmethod
    def _continue_bias(prev_token, candidates):
        if prev_token in candidates and prev_token != "NONE":
            n = len(candidates)
            other = (1.0 - Policy.CONTINUE_BIAS) / max(1, n - 1) if n > 1 else 0.0
            return {a: (Policy.CONTINUE_BIAS if a == prev_token else other)
                    for a in candidates}
        n = max(1, len(candidates))
        return {a: 1.0 / n for a in candidates}

    @staticmethod
    def _apply_anti_oscillation(scores, prev_token, candidates):
        if prev_token not in OPPOSITE:
            return scores
        opp = OPPOSITE[prev_token]
        if opp not in candidates:
            return scores
        factor = Policy.ANTI_OSCILLATION_FACTOR
        out = {}
        for a in candidates:
            v = scores.get(a, 0.0)
            if a == opp:
                v = v * factor
            out[a] = v
        if sum(out.values()) <= 0.0:
            n = max(1, len(candidates))
            return {a: 1.0 / n for a in candidates}
        return out

    @staticmethod
    def _normalize(scores, candidates):
        total = sum(max(0.0, v) for v in scores.values())
        if total <= 0.0:
            n = max(1, len(candidates))
            return {a: round(1.0 / n, 8) for a in candidates}
        out = {}
        for a in candidates:
            v = max(0.0, scores.get(a, 0.0)) / total
            out[a] = float(v)
        return out


def make_policy(training_data=None, config=None):
    """Build a Policy trained on training_data (parsed JSON dict).
    config is accepted for forward compatibility and currently ignored."""
    return Policy(training_data=training_data, config=config)
