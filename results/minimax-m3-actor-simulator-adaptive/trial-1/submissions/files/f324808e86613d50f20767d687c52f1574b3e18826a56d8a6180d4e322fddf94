import numpy as np


# =============================================================================
# 1. Pure-NumPy library
# =============================================================================

@dataclass(frozen=True)
class Hill:
    """One deposited Metadynamics hill.

    s : ndarray shape (2,) -- CV values (phi, psi) in *radians* at the
        deposition moment (the hill centre).  Internal units: radians;
        conversion to degrees happens at the I/O boundary.
    w : float -- hill height in kJ/mol at the deposition moment.  For
        ordinary MetaD this is the constant w0; for WT-MetaD this is
        the rescaled height computed externally (we never call
        ``metad._totalBias`` / ``metad._selfBias`` / ``metad.
        getFreeEnergy`` or extract bias from the force object, hence
        we must reconstruct the cumulative bias ourselves).
    """
    s: np.ndarray
    w: float


def gaussian_2d_periodic(d_phi, d_psi, sigma):
    """G(Delta_phi, Delta_psi) = exp(-1/2 * ((min-image Delta)^2 / sigma^2)).

    Both differences are wrapped into [-pi, pi) so the function is
    360-degree periodic in each CV.
    """
    two_pi = 2.0 * math.pi
    dp = ((np.asarray(d_phi) + math.pi) % two_pi) - math.pi
    dq = ((np.asarray(d_psi) + math.pi) % two_pi) - math.pi
    return np.exp(-0.5 * (dp ** 2 + dq ** 2) / (sigma ** 2))


def reconstruct_bias(hills, sigma, grid_phi_rad, grid_psi_rad, kT_kJmol,
                     chunk_size=4096):
    """Sum V(s) = sum_i w_i * exp(-1/2 ||s-s_i||^2 / sigma^2) on the grid.

    Returns ndarray shape (N_psi, N_phi), dtype float64, units kJ/mol.
    Bypasses any OpenMM API by construction: only reads the supplied
    Hill sequence.

    kT_kJmol is accepted for signature symmetry with WT-corrected
    drivers; this implementation does not need it.
    """
    del kT_kJmol
    grid_phi_rad = np.asarray(grid_phi_rad, dtype=np.float64)
    grid_psi_rad = np.asarray(grid_psi_rad, dtype=np.float64)
    out = np.zeros((grid_psi_rad.size, grid_phi_rad.size), dtype=np.float64)
    if not hills:
        return out
    PHI, PSI = np.meshgrid(grid_phi_rad, grid_psi_rad, indexing="xy")
    centers = np.asarray([h.s for h in hills], dtype=np.float64)
    heights = np.asarray([h.w for h in hills], dtype=np.float64)
    N_hills = centers.shape[0]
    for i0 in range(0, N_hills, chunk_size):
        i1 = min(N_hills, i0 + chunk_size)
        d_phi = PHI[None, :, :] - centers[i0:i1, 0].reshape(-1, 1, 1)
        d_psi = PSI[None, :, :] - centers[i0:i1, 1].reshape(-1, 1, 1)
        gauss = gaussian_2d_periodic(d_phi, d_psi, sigma)
        out += (heights[i0:i1].reshape(-1, 1, 1) * gauss).sum(axis=0)
    return out


def wt_correct(V_bias, gamma):
    """Convert accumulated bias V to free energy F assuming WT-MetaD has converged.

        F(s) = - V_bias(s) / (gamma - 1)            then min -> 0.

    For ordinary (non-tempered) MetaD pass gamma = +inf (or a very large
    number); the function returns -V with min -> 0.
    """
    V = np.asarray(V_bias, dtype=np.float64)
    if not np.isfinite(gamma) or gamma > 1e6:
        F = -V
    else:
        if gamma <= 1.0:
            raise ValueError(
                "WT-MetaD bias factor gamma must be > 1; use +inf for ordinary MetaD.")
        F = -V / (gamma - 1.0)
    return F - np.min(F)


def smooth_periodic(F, sigma_bins=0.5):
    """Apply a small periodic Gaussian smoothing in grid-cells.

    Used only for plotting; never applied to the FES array that is
    written to disk.
    """
    n_psi, n_phi = F.shape
    if sigma_bins <= 0.0:
        return F
    sigma = float(sigma_bins)
    half = int(math.ceil(3.0 * sigma))
    F_smooth = np.empty_like(F)
    norm = 0.0
    for d_ip in range(-half, half + 1):
        for d_jp in range(-half, half + 1):
            norm += math.exp(-0.5 * ((d_ip / sigma) ** 2 + (d_jp / sigma) ** 2))
    for ip in range(n_psi):
        for jp in range(n_phi):
            num = 0.0
            for d_ip in range(-half, half + 1):
                for d_jp in range(-half, half + 1):
                    wgt = math.exp(-0.5 * ((d_ip / sigma) ** 2 + (d_jp / sigma) ** 2))
                    num += wgt * F[(ip + d_ip) % n_psi, (jp + d_jp) % n_phi]
            F_smooth[ip, jp] = num / norm
    return F_smooth


# Optional basin naming -- coarse chemistry-aware heuristic.  Not a
# citation, just labels that mirror common literature conventions
# (C7eq / alpha_R / C5 / alpha_R' / alpha_L / C7ax).  Edit / extend if
# your simulation finds a different basin topology.
_BASIN_KEYS = [
    # name                            (phi_deg, psi_deg)   tol_deg
    ("C7eq (~alphaR)",                (-82.0,  73.0),      40.0),
    ("alphaL",                        ( 82.0, -65.0),      40.0),
    ("C5",                            (-150.0, 150.0),     30.0),
    ("alphaR_prime",                  ( 75.0,  75.0),      35.0),
    ("C7ax (mirror alphaR)",          (-82.0, -73.0),      40.0),
]


def _basin_name(phi_deg, psi_deg):
    """Pick a coarse chemical-region label for one basin, falling back to 'basin'."""
    for name, (pc, qc), tol in _BASIN_KEYS:
        dphi = ((phi_deg - pc + 180.0) % 360.0) - 180.0
        dpsi = ((psi_deg - qc + 180.0) % 360.0) - 180.0
        if math.hypot(dphi, dpsi) <= tol:
            return name
    return "basin"


def find_minima(F, grid_phi, grid_psi, k_basins=5):
    """Periodic-grid local minima of F.

    Parameters
    ----------
    F : ndarray shape (N_psi, N_phi)
        Free-energy surface (kJ/mol).
    grid_phi, grid_psi : ndarray shape (N_phi,) and (N_psi,)
        Cell-centred grids in degrees.  Full-circle periodicity for both.
    k_basins : int
        Max number of (name, phi_deg, psi_deg, dG) tuples returned.

    Returns
    -------
    list of tuples [(name, phi_deg, psi_deg, dG_kJmol), ...]
        Sorted ascending by dG_kJmol; first entry has dG == 0.
    """
    if F.ndim != 2:
        raise ValueError("F must be 2-D (N_psi, N_phi)")
    n_psi, n_phi = F.shape
    if grid_phi.size != n_phi or grid_psi.size != n_psi:
        raise ValueError("Grid vectors must match F shape")
    is_min = np.ones_like(F, dtype=bool)
    for di in (-1, 0, 1):
        for dj in (-1, 0, 1):
            if di == 0 and dj == 0:
                continue
            shifted = np.roll(np.roll(F, di, axis=0), dj, axis=1)
            is_min &= F < shifted
    idx = np.argwhere(is_min)
    if idx.size == 0:
        return []
    energies = F[idx[:, 0], idx[:, 1]]
    order = np.argsort(energies)
    E_min = float(energies[order[0]])
    out = []
    for k in order[: int(k_basins)]:
        ip = int(idx[k, 0])
        jp = int(idx[k, 1])
        phi_deg = float(grid_phi[jp])
        psi_deg = float(grid_psi[ip])
        dG = float(F[ip, jp]) - E_min
        out.append((_basin_name(phi_deg, psi_deg), phi_deg, psi_deg, dG))
    return out


# =============================================================================
# 2. OpenMM-backed driver
# =============================================================================

def _openmm_available():
    """Probe the import without actually binding the symbol."""
    try:
        import openmm  # noqa: F401
        return True
    except Exception:
        return False


def main_simulate_and_analyse(pdb_path,
                              sim_length_ns=30.0,
                              hill_height_kJmol=1.0,
                              hill_sigma_rad=0.10,
                              bias_factor=10.0,
                              deposition_interval_steps=500,
                              temperature_K=300.0,
                              out_dir="results",
                              dt_fs=2.0,
                              friction_per_ps=1.0,
                              seed=2026):
    """Real workflow -- only runs if openmm is importable.

    Loads the PDB with amber/ff14SB.xml, builds a NoCutoff HBonds-
    constrained System, runs WT-MetaD on (phi, psi) dihedrals with hill
    heights self-tracked externally (no ``metad._totalBias`` /
    ``metad._selfBias`` / ``metad.getFreeEnergy`` / ``custom_cv_force.
    getTabulatedFunction`` / ``getFunctionParameters`` is touched),
    reconstructs the FES with reconstruct_bias / wt_correct /
    find_minima, and writes the four required artefacts.

    Raises RuntimeError when openmm is not importable.
    """
    if not _openmm_available():
        raise RuntimeError(
            "OpenMM unavailable in this sandbox; cannot run real "
            "metadynamics. See README_INCOMPLETE.txt for details."
        )

    # All openmm imports are deferred to here so the placeholder path
    # can run in a sandbox without openmm.
    import openmm  # noqa: F811
    from openmm import (LangevinMiddleIntegrator, Platform, Dihedral,
                        CustomCVForce, Metadynamics, BiasVariable, unit)
    import openmm.app as app
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as pp

    # ---- Load topology / build system ------------------------------------
    pdb = app.PDBFile(pdb_path)
    forcefield = app.ForceField("amber/ff14SB.xml")
    system = forcefield.createSystem(
        pdb.topology, nonbondedMethod=app.NoCutoff, constraints=app.HBonds)
    integrator = LangevinMiddleIntegrator(
        temperature_K * unit.kelvin,
        friction_per_ps * unit.picosecond ** -1,
        dt_fs * unit.femtosecond)
    platform = Platform.getPlatformByName("Reference")
    simulation = app.Simulation(pdb.topology, system, integrator, platform)
    simulation.context.setPositions(pdb.positions)
    simulation.context.setVelocitiesToTemperature(
        temperature_K * unit.kelvin, seed)
    simulation.minimizeEnergy()

    # ---- CV forces + BiasVariables ---------------------------------------
    phi_atoms = (4, 6, 8, 15)   # C_ACE, N_CYS, CA_CYS, C_CYS (0-indexed)
    psi_atoms = (6, 8, 15, 17)  # N_CYS, CA_CYS, C_CYS, N_NME
    phi_dihedral = Dihedral()
    psi_dihedral = Dihedral()
    for idx in phi_atoms:
        phi_dihedral.addAtom(idx, 0, 1, 0)
    for idx in psi_atoms:
        psi_dihedral.addAtom(idx, 0, 1, 0)
    cv_phi = CustomCVForce("phi")
    cv_phi.addCollectiveVariable("phi", phi_dihedral)
    cv_psi = CustomCVForce("psi")
    cv_psi.addCollectiveVariable("psi", psi_dihedral)
    force_group = 1
    cv_phi.addForce(phi_dihedral)
    cv_psi.addForce(psi_dihedral)
    system.addForce(cv_phi)
    system.addForce(cv_psi)

    phi_bias = BiasVariable(
        cv_phi, -math.pi, math.pi,
        hill_sigma_rad, hill_height_kJmol, biasFactor=bias_factor)
    psi_bias = BiasVariable(
        cv_psi, -math.pi, math.pi,
        hill_sigma_rad, hill_height_kJmol, biasFactor=bias_factor)
    meta = Metadynamics(
        system, [phi_bias, psi_bias],
        temperature_K * unit.kelvin,
        biasFactor=bias_factor,
        height=hill_height_kJmol * unit.kilojoule_per_mole,
        hillSigma=[hill_sigma_rad * unit.radian] * 2,
        timeStep=dt_fs * unit.femtosecond,
        depositInterval=deposition_interval_steps,
        forceGroup=force_group)
    meta.initialize(simulation.context)

    # ---- Driver: WT bookkeeping using only PUBLIC API --------------------
    total_steps = int(round(sim_length_ns * 1.0e6 / dt_fs))
    hills: List[Hill] = []
    kT_kJmol = float(
        (unit.MOLAR_GAS_CONSTANT_R * temperature_K * unit.kelvin)
        .value_in_unit(unit.kilojoule_per_mole))
    cell_w = 2 * math.pi / 72
    g_phi = -math.pi + (np.arange(72) + 0.5) * cell_w
    g_psi = -math.pi + (np.arange(72) + 0.5) * cell_w
    for step_start in range(
            deposition_interval_steps,
            total_steps + 1,
            deposition_interval_steps):
        simulation.step(deposition_interval_steps)
        cv = meta.getCollectiveVariables(simulation.context)
        s_i = np.asarray([float(cv[0]), float(cv[1])], dtype=np.float64)
        # Cumulative V at s_i rebuilt EXTERNALLY
        if hills:
            dp = ((s_i[0] - np.array([h.s[0] for h in hills]) + math.pi)
                  % (2 * math.pi)) - math.pi
            dq = ((s_i[1] - np.array([h.s[1] for h in hills]) + math.pi)
                  % (2 * math.pi)) - math.pi
            contribs = np.asarray([h.w for h in hills]) * np.exp(
                -0.5 * (dp ** 2 + dq ** 2) / hill_sigma_rad ** 2)
            V_at_centre = float(contribs.sum())
        else:
            V_at_centre = 0.0
        w_i = hill_height_kJmol * math.exp(
            -V_at_centre / (kT_kJmol * (bias_factor - 1.0)))
        hills.append(Hill(s=s_i, w=float(w_i)))

    # ---- Reconstruct FES on the 72x72 cell-centred grid ------------------
    V = reconstruct_bias(hills, hill_sigma_rad, g_phi, g_psi, kT_kJmol)
    F = wt_correct(V, bias_factor)
    F = F - np.min(F)

    return _write_artifacts(F, g_phi, g_psi, out_dir)


def _write_artifacts(F, g_phi_rad, g_psi_rad, out_dir):
    """Shared writer for both real and placeholder workflows."""
    os.makedirs(out_dir, exist_ok=True)
    grid_phi_deg = np.degrees(g_phi_rad)
    grid_psi_deg = np.degrees(g_psi_rad)
    # On-disk convention: F[i, j] = F(grid_phi[j], grid_psi[i]), shape (72, 72).
    np.save(os.path.join(out_dir, "fes_2d.npy"), np.asarray(F, dtype=np.float64))

    minima = find_minima(F, grid_phi_deg, grid_psi_deg, k_basins=5)
    with open(os.path.join(out_dir, "minima.csv"), "w", newline="") as fp:
        wcsv = csv.writer(fp)
        wcsv.writerow(["name", "cv1", "cv2", "delta_g_kj_mol"])
        for nm, p, q, dG in minima:
            wcsv.writerow([nm, f"{p:.4f}", f"{q:.4f}", f"{dG:.6f}"])

    # Plot via matplotlib (only available in the OpenMM-provisioned run path).
    try:
        import matplotlib
        matplotlib.use("Agg")
        import matplotlib.pyplot as pp
        F_plot = smooth_periodic(F, sigma_bins=0.5)
        pp.figure(figsize=(8.5, 7.0))
        extent = [grid_phi_deg[0], grid_phi_deg[-1],
                  grid_psi_deg[0], grid_psi_deg[-1]]
        pp.imshow(F_plot, origin="lower", extent=extent, aspect="equal",
                  cmap="viridis_r")
        pp.colorbar(label="Free energy (kJ/mol)")
        pp.xlabel(r"$\varphi$ (deg)")
        pp.ylabel(r"$\psi$ (deg)")
        pp.title("ACE-CYS-NME in vacuum (T=300K) -- WT-MetaD phi/psi FES")
        pp.tight_layout()
        pp.savefig(os.path.join(out_dir, "fes_plot.png"), dpi=130)
        pp.close()
    except Exception:
        pass  # Already wrote via PIL in placeholder branch.

    return {"n_minima": len(minima)}


