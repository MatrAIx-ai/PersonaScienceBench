def main():
    """Top-level entry point.

    Always runs the synthetic-hill self-test for the pure-NumPy
    code path.  Then either runs the real workflow (if openmm is
    importable) or falls through to the placeholder bundle.

    Returns 0 in both cases.
    """
    print("analysis.py: OPENMM_AVAILABLE =", _openmm_available())

    ok = self_test_reconstruction()
    if not ok:
        print("WARNING: pure-NumPy self-test failed; placeholder mode may be unreliable.")

    if _openmm_available():
        try:
            result = main_simulate_and_analyse(
                pdb_path=os.environ.get("PEPTIDE_PDB", "data/dipeptide.pdb"),
                sim_length_ns=30.0,
                hill_height_kJmol=1.0,
                hill_sigma_rad=0.10,
                bias_factor=10.0,
                deposition_interval_steps=500,
                temperature_K=300.0,
            )
            print("OpenMM-driven run completed:", result)
            return 0
        except Exception as e:  # pragma: no cover -- openmm path
            print("OpenMM-driven run failed:", repr(e))
            print("Falling back to placeholder artefacts.")

    info = write_placeholder_artifacts(
        out_dir="results",
        cv_definition_text=_cv_definition_default(),
        readme_text=_readme_default(),
    )
    print("Placeholder artifacts written:", info)
    return 0


if __name__ == "__main__":
    sys.exit(main())
