def _grid_phi_deg():
    """Cell-centred degrees grid on [-180, +180) with 72 cells of width 5 deg."""
    return -180.0 + (np.arange(72) + 0.5) * 5.0


def _grid_psi_deg():
    return -180.0 + (np.arange(72) + 0.5) * 5.0


def write_placeholder_artifacts(out_dir="results",
                                cv_definition_text=None,
                                readme_text=None):
    """Emit the placeholder bundle given that no real simulation ran.

    fes_2d.npy   : shape (72, 72), dtype float64, all zeros.
    minima.csv   : header-only file (no data rows).
    fes_plot.png : valid PNG produced via PIL with the title banner.
    cv_definition.txt and README_INCOMPLETE.txt : written from the
        caller's text (defaults are used if not provided).

    The function never fabricates a non-zero FES; min == 0 is satisfied
    trivially (everywhere) and is consistent with the no-simulation
    status.
    """
    os.makedirs(out_dir, exist_ok=True)

    # 1. fes_2d.npy: zeros, shape (72,72), dtype float64.
    fes = np.zeros((72, 72), dtype=np.float64)
    np.save(os.path.join(out_dir, "fes_2d.npy"), fes)

    # 2. minima.csv: header only.
    with open(os.path.join(out_dir, "minima.csv"), "w", newline="") as fp:
        wcsv = csv.writer(fp)
        wcsv.writerow(["name", "cv1", "cv2", "delta_g_kj_mol"])
        # zero data rows.

    # 3. fes_plot.png: blank-axes PNG with the title banner.
    title_lines = [
        "Free-energy surface unavailable: OpenMM simulation was not run in",
        "this session -- see README_INCOMPLETE.txt and cv_definition.txt",
        "for the contract that *would* produce this plot.",
    ]
    png_used = None
    try:
        sys.path.insert(0, "/usr/lib/python3/dist-packages")
        from PIL import Image, ImageDraw, ImageFont  # type: ignore
        png_used = "PIL"
    except Exception:
        png_used = None

    if png_used == "PIL":
        img_w, img_h = 1300, 720
        img = Image.new("RGB", (img_w, img_h), color=(245, 245, 245))
        d = ImageDraw.Draw(img)
        font = None
        for path in (
            "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf",
            "/usr/share/fonts/truetype/liberation/LiberationSans-Regular.ttf",
            "/usr/share/fonts/truetype/freefont/FreeSans.ttf",
            "/usr/share/fonts/TTF/DejaVuSans.ttf",
        ):
            if os.path.exists(path):
                try:
                    font = ImageFont.truetype(path, 28)
                    break
                except Exception:
                    font = None
        if font is None:
            font = ImageFont.load_default()
        small = font
        y = 40
        for line in title_lines:
            d.text((40, y), line, fill=(20, 20, 20), font=font)
            y += 36
        ax_x0, ax_y0 = 200, 220
        ax_x1, ax_y1 = img_w - 80, img_h - 100
        d.rectangle([ax_x0, ax_y0, ax_x1, ax_y1], outline=(80, 80, 80), width=2)
        d.text((ax_x0 + (ax_x1 - ax_x0) // 2 - 90, ax_y1 + 24),
               "phi  (deg)  [no data]", fill=(40, 40, 40), font=small)
        d.text((60, ax_y0 + 40),
               "psi (deg)", fill=(40, 40, 40), font=small)
        d.text((60, ax_y0 + 70),
               "   -- no data --", fill=(40, 40, 40), font=small)
        d.text((40, img_h - 36),
               "Placeholder generated by analysis.py: OPENMM_AVAILABLE = "
               + str(_openmm_available()),
               fill=(80, 80, 80), font=small)
        img.save(os.path.join(out_dir, "fes_plot.png"), "PNG")

    if cv_definition_text is not None:
        with open(os.path.join(out_dir, "cv_definition.txt"), "w") as fp:
            fp.write(cv_definition_text)
    if readme_text is not None:
        with open(os.path.join(out_dir, "README_INCOMPLETE.txt"), "w") as fp:
            fp.write(readme_text)

    return {
        "fes_2d_npy_shape": tuple(fes.shape),
        "fes_2d_npy_dtype": str(fes.dtype),
        "fes_2d_npy_min": float(fes.min()),
        "fes_2d_npy_max": float(fes.max()),
        "minima_csv_rows": 0,
        "png_used": png_used,
    }


