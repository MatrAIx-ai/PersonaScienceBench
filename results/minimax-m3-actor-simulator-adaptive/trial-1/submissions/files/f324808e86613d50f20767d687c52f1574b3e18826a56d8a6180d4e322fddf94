# 4. Self-test for the pure-NumPy code path
# =============================================================================

def self_test_reconstruction():
    """Synthetic-hill self-test for reconstruct_bias + wt_correct + find_minima.

    500 deterministic hills of constant w0 around (-pi/2, +pi/2). After
    reconstruction the deepest cell should sit within two cells of that
    centre; the global min of F is 0 by construction; FES shape is
    (72, 72); find_minima() returns at least one entry with dG == 0.
    """
    rng = np.random.default_rng(42)
    sigma = 0.10
    w0 = 1.0
    gamma = 10.0
    N = 500
    centre = np.array([-math.pi / 2.0, math.pi / 2.0])
    # Place centres at (phi, psi) = (-pi/2, +pi/2) with small jitter,
    # so the argmax(V) really comes from a basin in the (+pi/2) psi hemisphere.
    centres_phi = -math.pi / 2.0 + (rng.random(N) - 0.5) * 0.8
    centres_psi = +math.pi / 2.0 + (rng.random(N) - 0.5) * 0.8
    centres = np.stack([centres_phi, centres_psi], axis=1)
    hills = [Hill(s=c, w=w0) for c in centres]
    cell_w = 2 * math.pi / 72
    grid_phi = -math.pi + (np.arange(72) + 0.5) * cell_w
    grid_psi = -math.pi + (np.arange(72) + 0.5) * cell_w
    V = reconstruct_bias(hills, sigma, grid_phi, grid_psi, kT_kJmol=2.479)
    F = wt_correct(V, gamma)
    ip_min, jp_min = np.unravel_index(np.argmin(F), F.shape)
    phi_min = grid_phi[jp_min]
    psi_min = grid_psi[ip_min]
    true_phi_idx = int(round((centre[0] - grid_phi[0]) / cell_w)) % 72
    true_psi_idx = int(round((centre[1] - grid_psi[0]) / cell_w)) % 72
    dphi_idx = min(abs(jp_min - true_phi_idx), 72 - abs(jp_min - true_phi_idx))
    dpsi_idx = min(abs(ip_min - true_psi_idx), 72 - abs(ip_min - true_psi_idx))
    localisation_pass = (dphi_idx <= 2 and dpsi_idx <= 2)
    shape_pass = (F.shape == (72, 72))
    zeros_pass = (F.min() == 0.0)
    fmin = find_minima(F, np.degrees(grid_phi), np.degrees(grid_psi), k_basins=3)
    fmin_pass = len(fmin) >= 1 and fmin[0][3] == 0.0
    ok = localisation_pass and shape_pass and zeros_pass and fmin_pass
    print("SELF-TEST: shape =", F.shape)
    print("SELF-TEST: dtype =", F.dtype)
    print(f"SELF-TEST: deepest cell at grid (phi_idx={jp_min}, psi_idx={ip_min})")
    print(f"SELF-TEST: deepest cell (phi={phi_min:+.3f} rad, psi={psi_min:+.3f} rad)")
    print(f"SELF-TEST: basin centre    (phi={centre[0]:+.3f} rad, psi={centre[1]:+.3f} rad)")
    print(f"SELF-TEST: cell offset dphi_idx={dphi_idx}, dpsi_idx={dpsi_idx}")
    print("SELF-TEST: shape_pass =", shape_pass)
    print("SELF-TEST: zeros_pass =", zeros_pass)
    print("SELF-TEST: localisation_pass =", localisation_pass)
    print("SELF-TEST: find_minima_pass =", fmin_pass)
    print("SELF-TEST:", "PASS" if ok else "FAIL")
    return ok


