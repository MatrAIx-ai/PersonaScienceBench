"""
EE vs Psychology — average original-paper length analysis.

Question: What is the average length (pages) of original papers in
          Experimental Economics vs Psychology?

Data: `data/meta-regression_study_data_heterogeneity_in_replication_projects.csv`
      (file 1; provides `project ∈ {ee, ml1, ml3, rpp}` and `length` =
       page count of the original paper).

Method (per approved plan):
  1. Read file 1.
  2. Filter rows where `project ∈ {ee, rpp}`.
  3. Drop missing `length` (none expected).
  4. Collapse on `id` (`drop_duplicates(subset='id')`) — future-proof step;
     in this snapshot ee/rpp each row maps to a unique id so it is
     numerically equivalent to the row-level aggregation.
  5. Compute per-project: n_studies, n_rows (pre-collapse), mean, median,
     sd (ddof=1), min, max of `length`.
  6. Welch's t and Mann-Whitney U for ee vs rpp on per-study lengths
     (descriptive, optional).
  7. Difference = mean(ee) − mean(rpp).

Outputs: prints a markdown report to stdout and writes
         `reports/result.md` for the public submission artifact.
"""
from __future__ import annotations

import numpy as np
import pandas as pd
from scipy import stats

SRC = "/workspace/data/meta-regression_study_data_heterogeneity_in_replication_projects.csv"
OUT_MD = "/workspace/reports/result.md"
TARGET_PROJECTS = ["ee", "rpp"]   # ee = Experimental Economics; rpp = Psychology
PROJECT_LABEL = {"ee": "Experimental Economics", "rpp": "Psychology"}


def main() -> None:
    df = pd.read_csv(SRC)

    # Sanity checks confirming the inspection round.
    assert set(TARGET_PROJECTS) <= set(df["project"].unique()), \
        f"Expected project codes missing: {set(TARGET_PROJECTS) - set(df['project'].unique())}"
    assert df["length"].isna().sum() == 0, "Unexpected NA in `length`"

    # Filter and drop missing (none expected, but keep defensive).
    sub = df[df["project"].isin(TARGET_PROJECTS)].copy()
    sub = sub.dropna(subset=["length"])

    # Collapse to one row per id (length is the original-paper attribute and
    # is constant within each id even in the multi-row ml1/ml3 cases;
    # collapse is future-proof and yields the per-study mean).
    rows_per_project = sub.groupby("project").size().rename("n_rows")
    sub_study = sub.drop_duplicates(subset="id")

    # Per-id length aggregation (each id → exactly one length value, so this
    # equals `length` itself — but written robustly via first()).
    study_lengths = (
        sub_study.groupby("project")["length"]
        .apply(lambda s: s.to_numpy())
        .to_dict()
    )

    rows = []
    for p in TARGET_PROJECTS:
        x = study_lengths[p]
        rows.append(
            {
                "project": p,
                "label": PROJECT_LABEL[p],
                "n_studies": int(len(x)),
                "n_rows": int(rows_per_project.loc[p]),
                "mean_length": float(np.mean(x)),
                "median": float(np.median(x)),
                "sd": float(np.std(x, ddof=1)),
                "min": int(np.min(x)),
                "max": int(np.max(x)),
            }
        )
    table = pd.DataFrame(rows)

    difference = float(
        table.loc[table["project"] == "ee", "mean_length"].iloc[0]
        - table.loc[table["project"] == "rpp", "mean_length"].iloc[0]
    )

    ee_x, rpp_x = study_lengths["ee"], study_lengths["rpp"]
    t_stat, t_p = stats.ttest_ind(ee_x, rpp_x, equal_var=False)
    u_stat, u_p = stats.mannwhitneyu(ee_x, rpp_x, alternative="two-sided")

    # Pretty print
    pd.set_option("display.float_format", lambda v: f"{v:.4f}")
    print("\n=== Per-project length summary (per-study; dropped duplicates on id) ===")
    print(
        table.to_string(
            index=False,
            formatters={
                "mean_length": "{:.4f}".format,
                "median": "{:.1f}".format,
                "sd": "{:.4f}".format,
            },
        )
    )
    print(f"\nDifference (mean ee - mean rpp): {difference:.4f}")
    print(f"Welch's t: stat={t_stat:.4f}, p={t_p:.3e}, df≈{len(ee_x)+len(rpp_x)-2}")
    print(f"Mann-Whitney U: stat={u_stat:.1f}, p={u_p:.3e}")

    # Build markdown with the same numbers
    md_lines = []
    md_lines.append("# EE vs Psychology — Original-paper Length\n")
    md_lines.append("## Methods\n")
    md_lines.append(
        "Using the study-level meta-regression dataset "
        "(`data/meta-regression_study_data_heterogeneity_in_replication_projects.csv`), "
        "we filtered rows where `project.isin(['ee', 'rpp'])`, removed any rows with "
        "missing `length`, and collapsed to one row per `id` "
        "(`drop_duplicates(subset='id')`) so the per-study mean is correctly defined "
        "(the schema describes `length` as the page count of the original paper; no "
        ".o/.r suffix; we additionally verified `length` is constant within every id). "
        "We then computed per-project mean, median, SD (ddof=1), min, and max, plus "
        "Welch's t and the Mann–Whitney U as descriptive inferential checks.\n"
    )
    md_lines.append("## Results table (per original paper = per `id`)\n")
    md_lines.append("| project | label | n_studies | n_rows | mean_length | median | sd (ddof=1) | min | max |")
    md_lines.append("|---|---|---:|---:|---:|---:|---:|---:|---:|")
    for _, r in table.iterrows():
        md_lines.append(
            f"| {r['project']} | {r['label']} | {r['n_studies']} | {r['n_rows']} | "
            f"{r['mean_length']:.2f} | {r['median']:.1f} | {r['sd']:.2f} | "
            f"{r['min']} | {r['max']} |"
        )
    md_lines.append("")
    md_lines.append(f"**Difference (mean ee − mean rpp): {difference:.2f} pages**\n")
    md_lines.append("## Inferential checks (ee vs rpp)\n")
    md_lines.append(
        f"- Welch's t (unequal variances): t = {t_stat:.4f}, p = {t_p:.3e}, "
        f"n_ee = {len(ee_x)}, n_rpp = {len(rpp_x)}.\n"
        f"- Mann–Whitney U (two-sided): U = {u_stat:.1f}, p = {u_p:.3e}.\n"
    )
    md_lines.append("## Hypothesis (natural-language answer)\n")
    md_lines.append(
        f"Original papers in Experimental Economics are on average "
        f"{table.set_index('project').loc['ee','mean_length']:.1f} pages long "
        f"(n = {len(ee_x)}), which is roughly "
        f"{difference:.1f} pages longer than the average original paper in the "
        f"Psychology replication project, which is "
        f"{table.set_index('project').loc['rpp','mean_length']:.1f} pages "
        f"(n = {len(rpp_x)}).\n"
    )
    md_lines.append("## Notes on file 2 cross-check\n")
    md_lines.append(
        "File 2 (`meta-regression_replication_success_data_…csv`) does carry a "
        "`project` column but uses full English names rather than file 1's codes; "
        "its \"Psychology\" label is narrower than file 1's `rpp` because file 2 "
        "separates out a 31-row `Experimental Philosophy` bucket that does not "
        "appear in file 1, so the two files' psychology cohorts are not "
        "1:1 — file 2 is therefore not used to verify the length statistics and "
        "the comparison is computed on file 1 alone.\n"
    )

    with open(OUT_MD, "w", encoding="utf-8") as fh:
        fh.write("\n".join(md_lines))

    print(f"\nWrote {OUT_MD}")


if __name__ == "__main__":
    main()
