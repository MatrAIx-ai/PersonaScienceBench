class _Node:
    __slots__ = ("name", "length", "children", "parent")
    def __init__(self, name=None, length=0.0):
        self.name = name
        self.length = float(length)
        self.children = []
        self.parent = None
    def add(self, child): child.parent = self; self.children.append(child); return child

def parse_newick(s: str):
    """Tokenizer + recursive-descent Newick parser. Length-bearing and
    unweighted formats both handled. Returns the root node."""
    # Tokens: parens, comma, semicolon, colon, name (alpha-num + _ . -)
    import re
    tokens = re.findall(r"\(|,|\)|:|[A-Za-z0-9_.\-]+", s)
    i = 0
    def tok():
        nonlocal i
        t = tokens[i]; i += 1; return t
    def parse_subtree():
        node = _Node()
        if tokens[i] == "(":
            tok()  # consume "("
            child = parse_subtree()
            node.add(child)
            while tokens[i] == ",":
                tok()
                node.add(parse_subtree())
            assert tokens[i] == ")"
            tok()  # consume ")"
        if i < len(tokens) and re.match(r"[A-Za-z]", tokens[i] or ""):
            node.name = tok()
        if i < len(tokens) and tokens[i] == ":":
            tok()  # consume ":"
            node.length = float(tok())
        return node
    root = parse_subtree()
    # assert tokens[i] == ";"
    return root

def linearize(root):
    """Yield all terminal nodes in deterministic order."""
    order = []
    def rec(n):
        if not n.children:
            order.append(n)
        else:
            for c in n.children: rec(c)
    rec(root)
    return order

def patristic_matrix(root):
    """Return (names, D) where D[i,j] is the cumulative branch length between
    leaves i and j. Two-pass: 1) get root-to-tip distance and parent chain,
    2) pairwise sum split at LCA. O(N^2) without tree traversal per query."""
    terminals = linearize(root)
    names = [n.name for n in terminals]
    # Root-to-tip distance
    r2t = {}
    parent = {}
    def walk(n, acc):
        r2t[n] = acc + n.length
        for c in n.children:
            parent[c] = n
            walk(c, acc + n.length)
    walk(root, 0.0)
    N = len(terminals)
    D = np.zeros((N, N))
    for i in range(N):
        for j in range(i + 1, N):
            ni_, nj_ = terminals[i], terminals[j]
            di = r2t[ni_]; dj = r2t[nj_]
            # climb both until LCA
            a, b = ni_, nj_
            seen = set()
            while a is not b:
                if r2t[a] >= r2t[b]:
                    if a in seen: break
                    seen.add(a); a = parent.get(a, a)
                else:
                    if b in seen: break
                    seen.add(b); b = parent.get(b, b)
            lca = a
            d = (r2t[ni_] - r2t[lca]) + (r2t[nj_] - r2t[lca])
            D[i, j] = d; D[j, i] = d
    return names, D

