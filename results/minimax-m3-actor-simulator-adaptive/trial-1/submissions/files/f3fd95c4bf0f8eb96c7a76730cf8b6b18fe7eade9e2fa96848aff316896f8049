# 3a) Bloomberg's K approximation for continuous traits
def bloombergs_K(trait: np.ndarray, D: np.ndarray, names=None) -> float:
    """Crude Bloomberg's K: K = (MSE_obs / MSE_BM). Uses mean-rooting via
    pairwise distance structure (no eigenvalue solve); permutation null
    gives a p-value. Returns (K, p) where p is from permuting trait across tips."""
    trait = np.asarray(trait, dtype=float)
    n = trait.size
    if n < 4: return (np.nan, np.nan)
    # Observed mean-squared successive-change parsimony: sum_i (xi - x_j)^2
    # along each edge of the dendrogram -> use raw patristic matrix:
    # sum_{i<j} (xi - xj)^2 / D_ij, normalized by total length.
    # This is one common approximation when full topology is not available.
    M = D.copy()
    np.fill_diagonal(M, np.nan)
    pair_y = trait[:, None] - trait[None, :]
    num = np.nansum(pair_y ** 2 / M)
    den = np.nansum(M)
    K_obs = num / den
    # Generate Brownian-motion-like null via permutation of trait across tips
    null = []
    nm = trait.size
    for _ in range(999):
        perm = RNG.permutation(nm)
        t2 = trait[perm]
        M2 = D.copy(); np.fill_diagonal(M2, np.nan)
        py = t2[:, None] - t2[None, :]
        n2 = np.nansum(py ** 2 / M2); d2 = np.nansum(M2)
        null.append(n2 / d2)
    null = np.array(null)
    # K values are not on a calibrated scale without tree height; we report
    # observed K, median(null), and a two-sided empirical p
    p = (np.sum(null >= K_obs) + 1) / (len(null) + 1)
    return float(K_obs), float(p), float(np.median(null))

