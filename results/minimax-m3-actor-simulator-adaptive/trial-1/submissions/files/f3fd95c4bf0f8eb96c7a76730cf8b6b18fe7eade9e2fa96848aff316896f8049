# Mean patristic distance within-pathway vs between-pathway
def mean_within_between(P, D):
    np.fill_diagonal(D, np.nan)
    within = np.nansum(P * D) / max(np.sum(P) - np.trace(P).sum(), 1)
    between_denom = (~P.astype(bool))[np.triu_indices_from(P, 1)].sum()
    D_bt = D.copy(); np.fill_diagonal(D_bt, np.nan)
    between = np.nansum((~P.astype(bool)) * D_bt) / max(between_denom, 1)
    return within, between
