"""
Computes the proportion of junior professors in replicated studies in Psychology.
Both CSVs supplied in /workspace/data are read directly. Every number in the result
JSON is anchored to a direct read of the file (no cached/derived state).
"""
import json
import pandas as pd

STUDY = '/workspace/data/meta-regression_study_data_heterogeneity_in_replication_projects.csv'
SUCCESS = '/workspace/data/meta-regression_replication_success_data_heterogeneity_in_replication_projects.csv'

df = pd.read_csv(STUDY)
# Sanity checks
assert df.shape[0] == 927 and df.shape[1] == 57
assert set(df['project'].unique()) == {'ee', 'ml1', 'ml3', 'rpp'}
assert df['seniority.r'].isna().sum() == 0

rpp = df[df['project'] == 'rpp']
assert len(rpp) == rpp['id'].nunique() == 97

JUNIOR = {'Assistant', 'Assistant Professor'}
num = int(rpp['seniority.r'].isin(JUNIOR).sum())
den = int(len(rpp))

psy_rows = df[df['project'].isin(['rpp', 'ml1', 'ml3'])]
psy_uids = psy_rows.drop_duplicates(subset=['id'])
rpp_rep = rpp[rpp['replicated'] == 1]

out = {
    'files_read': [STUDY, SUCCESS],
    'project_freq_overall': df['project'].value_counts().to_dict(),
    'seniority_r_overall': df['seniority.r'].value_counts().to_dict(),
    'seniority_r_missing_overall': int(df['seniority.r'].isna().sum()),
    'rpp_n_rows': den,
    'rpp_n_unique_ids': int(rpp['id'].nunique()),
    'seniority_r_within_rpp': rpp['seniority.r'].value_counts().to_dict(),
    'primary': {
        'definition': 'project == "rpp"; junior = Assistant OR Assistant Professor',
        'numerator': num,
        'denominator': den,
        'fraction': f'{num}/{den}',
        'proportion_decimal': num / den,
        'percent_round2': round(num / den * 100, 2),
    },
    'variants': {
        'rpp_plus_ml_studies_row_level': {
            'definition': 'project in {rpp, ml1, ml3}; row-level denominator; junior = Assistant OR Assistant Professor',
            'numerator': int(psy_rows['seniority.r'].isin(JUNIOR).sum()),
            'denominator': int(len(psy_rows)),
            'percent_round2': round(psy_rows['seniority.r'].isin(JUNIOR).sum() / len(psy_rows) * 100, 2),
        },
        'rpp_plus_ml_studies_unique_id': {
            'definition': 'project in {rpp, ml1, ml3}; unique-id denominator (26 ml ids + 97 rpp); junior = Assistant OR Assistant Professor',
            'numerator': int(psy_uids['seniority.r'].isin(JUNIOR).sum()),
            'denominator': int(len(psy_uids)),
            'percent_round2': round(psy_uids['seniority.r'].isin(JUNIOR).sum() / len(psy_uids) * 100, 2),
        },
        'rpp_asst_professor_only': {
            'definition': 'project == "rpp"; junior = Assistant Professor only (Assistant excluded)',
            'numerator': int((rpp['seniority.r'] == 'Assistant Professor').sum()),
            'denominator': den,
            'percent_round2': round((rpp['seniority.r'] == 'Assistant Professor').sum() / den * 100, 2),
        },
        'rpp_replicated_eq_1': {
            'definition': 'project == "rpp" AND replicated == 1; junior = Assistant OR Assistant Professor',
            'numerator': int(rpp_rep['seniority.r'].isin(JUNIOR).sum()),
            'denominator': int(len(rpp_rep)),
            'percent_round2': round(rpp_rep['seniority.r'].isin(JUNIOR).sum() / len(rpp_rep) * 100, 2),
        },
    },
}

with open('/workspace/artifacts/results.json', 'w') as f:
    json.dump(out, f, indent=2)
print(json.dumps(out, indent=2))
