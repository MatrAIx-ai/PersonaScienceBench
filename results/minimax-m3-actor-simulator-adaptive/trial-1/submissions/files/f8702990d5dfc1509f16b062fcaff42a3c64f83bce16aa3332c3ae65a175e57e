"""
Habitats where the 'Gardening' introduction pathway shows distinct
prevalence styles for non-native plants (Barcelona/Catalonia dataset).
"""
import os, json, math
import numpy as np
import pandas as pd
import statsmodels.api as sm
from statsmodels.genmod.families import Binomial, Gaussian
from statsmodels.genmod.families.links import Logit

ROOT = "/workspace"
DATA = os.path.join(ROOT, "data")
ART  = os.path.join(ROOT, "artifacts")
TBL  = os.path.join(ART, "tables")
os.makedirs(TBL, exist_ok=True)

df   = pd.read_csv(os.path.join(DATA, "invaded_niche_pathways.csv"), sep="\t")
spp  = pd.read_csv(os.path.join(DATA, "invasion_success_pathways.csv"))
temp = pd.read_csv(os.path.join(DATA, "temporal_trends_contingency_table.csv"), sep="\t")
with open(os.path.join(DATA, "phylogenetic_tree.txt")) as f:
    nwk = f.read().strip()

HABITATS = sorted(df["habitat"].unique().tolist())
print("Habitats:", HABITATS, "| rows:", len(df))

# ---------- Section 1: three prevalence metrics ----------------------------
def wilson_ci(k, n, z=1.96):
    if n == 0:
        return (np.nan, np.nan)
    p = k / n
    denom = 1 + z**2 / n
    centre = (p + z**2 / (2 * n)) / denom
    half = (z * np.sqrt(p * (1 - p) / n + z**2 / (4 * n**2))) / denom
    return (max(0.0, centre - half), min(1.0, centre + half))

records = []
for hab in HABITATS + ["ALL"]:
    sub_all = df if hab == "ALL" else df[df["habitat"] == hab]
    sub_p   = sub_all[sub_all["n.total"] > 0]
    n_plots, n_present = len(sub_all), len(sub_p)
    n_anygard  = int((sub_p["n.gard"] > 0).sum())
    sum_gard   = int(sub_p["n.gard"].sum())
    sum_total  = int(sub_p["n.total"].sum())
    sum_unint  = int(sub_p["n.unint"].sum())
    sum_agfo   = int(sub_p["n.agfo"].sum())
    lo, hi     = wilson_ci(n_anygard, n_present) if n_present else (np.nan, np.nan)
    metrics = {
        "habitat"               : hab,
        "n_plots"               : n_plots,
        "n_plots_w_presence"    : n_present,
        "comp_gard_over_g_u_a"  : (sum_gard/sum_total) if sum_total else np.nan,
        "pres_anygard_freq"     : (n_anygard/n_present) if n_present else np.nan,
        "pres_ci_lo"            : lo,
        "pres_ci_hi"            : hi,
        "sum_gard"              : sum_gard,
        "sum_unint"             : sum_unint,
        "sum_agfo"              : sum_agfo,
        "sum_total"             : sum_total,
        "abund_share_gard_per_plot": (sum_gard/n_plots) if n_plots else np.nan,
        "style_dom_pathway": (max([("Gardening",sum_gard),
                                   ("Unintentional",sum_unint),
                                   ("AgriForest",sum_agfo)], key=lambda x:x[1])[0]
                              if sum_total else "n/a"),
    }
    records.append(metrics)
metrics_df = pd.DataFrame(records)
metrics_df.to_csv(os.path.join(TBL, "metrics_by_habitat.csv"), index=False)
print("\n[Metric table]")
print(metrics_df[["habitat","n_plots","n_plots_w_presence",
                  "comp_gard_over_g_u_a","pres_anygard_freq",
                  "abund_share_gard_per_plot","style_dom_pathway"]]
      .round(3).to_string(index=False))

# ---------- Section 2: PCA on coverage + climate + elevation + distances ---
coverage_cols = []
for buf in [50, 500, 1000]:
    for yr in [1956, 1993, 2009]:
        coverage_cols += [f"urban.{yr}.{buf}m", f"cropland.{yr}.{buf}m"]
extra = ["elevation","distance.stream","distance.road",
         "annual.temperature","annual.rainfall","annual.radiation"]
pca_features = coverage_cols + extra
X = df[pca_features].astype(float)
mu = X.mean(); sd = X.std(ddof=0).replace(0,1.0)
Z = ((X - mu)/sd).to_numpy()
C = np.cov(Z, rowvar=False, ddof=0)
w, V = np.linalg.eigh(C)
order = np.argsort(w)[::-1]
w = w[order]; V = V[:, order]
scores = Z @ V
expl_var = w/w.sum()

loadings = pd.DataFrame(V[:, :5], index=pca_features,
                        columns=[f"PC{i+1}" for i in range(5)])
# Save explained variance as a separate small frame
expl_var_df = pd.DataFrame({"PC": [f"PC{i+1}" for i in range(len(expl_var))],
                            "expl_var_ratio": expl_var,
                            "expl_var_pct": expl_var*100}).round(4)
expl_var_df.to_csv(os.path.join(TBL, "pca_explained_variance.csv"), index=False)
loadings.to_csv(os.path.join(TBL, "pca_loadings.csv"))
scdf = pd.DataFrame(scores[:, :5], columns=[f"PC{i+1}" for i in range(5)],
                    index=df.index)
scdf["habitat"] = df["habitat"].values
scdf["lon"] = df["longitude"].values
scdf["lat"]  = df["latitude"].values
scdf.to_csv(os.path.join(TBL, "pca_scores.csv"))
print("\n[PCA explained variance first 5]", np.round(expl_var[:5],3))
for k in range(3):
    top = loadings[f"PC{k+1}"].abs().sort_values(ascending=False).head(5)
    print(f"  PC{k+1}: " + ", ".join([f"{i}={loadings.loc[i,f'PC{k+1}']:+.2f}" for i in top.index]))

# ---------- Section 3: buffer-scale sensitivity ---------------------------
sens_rows = []
df2_full = df.copy()
df2_full["any_gard"] = (df2_full["n.gard"]>0).astype(int)
for buf in [50, 500, 1000]:
    sub = df2_full.copy()
    sub["urban_net"] = sub[f"urban.2009.{buf}m"]     - sub[f"urban.1956.{buf}m"]
    sub["crop_net"]  = sub[f"cropland.2009.{buf}m"]  - sub[f"cropland.1956.{buf}m"]
    sub_p = sub[sub["n.total"]>0]
    hab_stats = (sub_p.groupby("habitat")
                 .apply(lambda g: pd.Series({
                     "n": len(g),
                     "pearson_urban_vs_anygard": (g["urban_net"].corr(g["any_gard"]) if len(g)>2 else np.nan),
                     "pearson_crop_vs_anygard":  (g["crop_net"].corr(g["any_gard"])  if len(g)>2 else np.nan),
                     "prop_anygard": g["any_gard"].mean()})))
    print(f"\n[Buffer {buf} m] habitat-level correlations with any_gard:")
    print(hab_stats.round(3).to_string())
    hab_stats.round(4).to_csv(os.path.join(TBL, f"sens_buffer_{buf}m_habstats.csv"))
    sens_rows.append({"buffer_m": buf})
pd.DataFrame(sens_rows).to_csv(os.path.join(TBL, "sensitivity_buffer_scales.csv"), index=False)

# ---------- Section 4: Binomial GLM on any_gard & logit-proportion OLS ----
df2 = df[df["n.total"]>0].copy()
df2["any_gard"] = (df2["n.gard"]>0).astype(int)

# Re-attach PCA scores by row index
scores_full = pd.read_csv(os.path.join(TBL, "pca_scores.csv"))
for i in range(5):
    df2[f"PC{i+1}"] = scores_full[f"PC{i+1}"].iloc[df2.index].values

baseline_hab = "Urban"
predictors = ["elevation","distance.stream","distance.road",
              "annual.temperature","annual.rainfall",
              "PC1","PC2","PC3","PC4",
              "progressive.1956.2009.50m","regressive.1956.2009.50m",
              "no.changes.1956.2009.50m"]
mu_p = df2[predictors].mean()
sd_p = df2[predictors].std(ddof=0).replace(0,1.0)
Zs   = (df2[predictors] - mu_p)/sd_p
hab_d = pd.get_dummies(df2["habitat"], prefix="hab", drop_first=False)
hab_cols = [c for c in hab_d.columns if c != f"hab_{baseline_hab}"]
X_hab = pd.concat([Zs, hab_d[hab_cols].astype(float)], axis=1)
y_any = df2["any_gard"].astype(int)

glm_any = sm.GLM(y_any, sm.add_constant(X_hab),
                 family=Binomial(link=Logit())).fit()
coefs = pd.DataFrame({
    "coef": glm_any.params, "std_err": glm_any.bse,
    "z": glm_any.tvalues, "pvalue": glm_any.pvalues,
    "OR": np.exp(glm_any.params),
    "OR_lo": np.exp(glm_any.params-1.96*glm_any.bse),
    "OR_hi": np.exp(glm_any.params+1.96*glm_any.bse)})
coefs.to_csv(os.path.join(TBL, "glm_anygard_binomial.csv"))
print("\n[Binomial GLM any_gard – top 10 |z|]")
print(coefs.iloc[1:].assign(absz=coefs.iloc[1:]["z"].abs())
      .sort_values("absz", ascending=False).head(10).round(3)
      [["coef","z","pvalue","OR","OR_lo","OR_hi"]].to_string())

# Logit-proportion OLS with robust (HC0) SE, weighted by n.total
EPS = 0.5/df2["n.total"].astype(float)
p_g = (df2["n.gard"]/df2["n.total"]).clip(EPS, 1-EPS)
y_logit = np.log(p_g/(1-p_g))
w = df2["n.total"].astype(float)
glm_p = sm.GLM(y_logit, sm.add_constant(X_hab), family=Gaussian(),
               freq_weights=w).fit(cov_type="HC0")
coefs_p = pd.DataFrame({"coef": glm_p.params, "SE_HC0": glm_p.bse,
                        "z": glm_p.tvalues, "pvalue": glm_p.pvalues})
coefs_p.to_csv(os.path.join(TBL, "glm_logitprop_robust.csv"))
print("\n[Logit-proportion OLS w/ HC0 SE – significant at p<0.1]")
print(coefs_p[coefs_p["pvalue"]<0.1].round(3).to_string())

# ---------- Section 5: Mean residual Moran's I (k-NN weights) and spatial-
# trend refit --------------------------------------------------------------
from scipy.spatial import cKDTree

def knn_weights(lon, lat, k=8):
    coords = np.column_stack([lon, lat])
    tree = cKDTree(coords)
    n = len(coords)
    W = np.zeros((n,n))
    for i in range(n):
        d, idx = tree.query(coords[i], k=k+1)
        for j in idx[1:]:
            W[i,j] = 1.0
    return W

def morans_I(resid, W):
    z = resid - resid.mean()
    n = len(z); S0 = W.sum()
    return (n/S0) * (z @ W @ z) / (z @ z)

def moran_perm_test(resid, W, n_perm=499):
    rng = np.random.default_rng(11)
    z = resid - resid.mean()
    n = len(z); S0 = W.sum()
    I_obs = (n/S0) * (z @ W @ z) / (z @ z)
    null = np.empty(n_perm)
    for p in range(n_perm):
        rp = rng.permutation(z)
        null[p] = (n/S0) * (rp @ W @ rp) / (rp @ rp)
    pval = (1 + (null >= I_obs).sum())/(1 + n_perm)
    return I_obs, float(null.mean()), float(null.std()), pval

W = knn_weights(df2["longitude"].values, df2["latitude"].values, k=8)
I_obs, mu_I, sd_I, pval = moran_perm_test(glm_any.resid_deviance, W, n_perm=499)
print(f"\n[Moran's I deviance resid any_gard]: I={I_obs:.3f}, perm mean={mu_I:.3f} ±{sd_I:.3f}, p={pval:.3f}")
pd.DataFrame({"stat":["I","perm_mean","perm_sd","p_perm"],
              "value":[I_obs,mu_I,sd_I,pval]}).to_csv(os.path.join(TBL,"morans_i.csv"), index=False)

glm_any_sp = None
glm_any_sp_params = None
if pval < 0.10:
    extra = pd.DataFrame({"lon": df2["longitude"].values,
                          "lat":  df2["latitude"].values})
    extra["lon2"] = extra["lon"]**2; extra["lat2"] = extra["lat"]**2
    extra["lonlat"] = extra["lon"]*extra["lat"]
    extra_z = (extra - extra.mean())/extra.std(ddof=0)
    X_hab_sp = pd.concat([X_hab.reset_index(drop=True), extra_z], axis=1)
    glm_any_sp = sm.GLM(y_any.reset_index(drop=True),
                        sm.add_constant(X_hab_sp),
                        family=Binomial(link=Logit())).fit()
    glm_any_sp_params = pd.DataFrame({
        "coef": glm_any_sp.params, "std_err": glm_any_sp.bse,
        "z": glm_any_sp.tvalues, "pvalue": glm_any_sp.pvalues})
    glm_any_sp_params.to_csv(os.path.join(TBL,"glm_anygard_binomial_spatial.csv"))
    I2, mu2, sd2, p2 = moran_perm_test(glm_any_sp.resid_deviance, W, n_perm=499)
    print(f"  spatial trend added: I={I2:.3f}, p={p2:.3f}")

