"""PC1 characterization of Middle Neolithic (3400-3000 BCE) and Younger
Neolithic (2900-2300 BCE) via joint PCA over 12 capital Z-variables at 100-year
resolution (capital.csv). Pollen openness as supplementary cross-correlation; 
time_series_data.csv used for sanity check only.
"""
from __future__ import annotations
import json, os
from pathlib import Path
import numpy as np
import pandas as pd

ROOT = Path("/workspace")
DATA = ROOT / "data"
OUT  = ROOT / "artifacts"
OUT.mkdir(parents=True, exist_ok=True)

cap = pd.read_csv(DATA / "capital.csv", decimal=",")
cap = cap.sort_values("BCE", ascending=False).reset_index(drop=True)
ts  = pd.read_csv(DATA / "time_series_data.csv")
pol = pd.read_csv(DATA / "pollen_openness_score_Belau_Woserin_Feeser_et_al_2019.csv", decimal=",")

ZCOLS = ["ZAxtSchwert","ZDolch","Zhausgr","ZCU_AU","Zamber","ZMonument",
         "ZHort","ZSichel","ZBeil","ZMW","ZKeform","Zkeverz"]
DOMAIN = {
    "Symbolic":  ["ZAxtSchwert",  "ZDolch",         "Zhausgr"],
    "Social":    ["ZCU_AU",       "Zamber",         "ZMonument"],
    "Cultural":  ["ZKeform",      "Zkeverz"],
    "Economic":  ["ZHort",        "ZSichel",        "ZBeil",     "ZMW"],
}

X_raw = cap[ZCOLS].to_numpy(dtype=float)
mu0   = X_raw.mean(axis=0)
sd0   = X_raw.std(axis=0, ddof=1)
X_std = (X_raw - mu0) / sd0
COV   = np.cov(X_std, rowvar=False, ddof=1)

eigvals, eigvecs = np.linalg.eigh(COV)
order = np.argsort(eigvals)[::-1]
eigvals = eigvals[order]
eigvecs = eigvecs[:, order]
evr  = eigvals / eigvals.sum()
cumv = np.cumsum(evr)

loadings = eigvecs.copy()
s = np.sign(loadings[:, 0].sum())
loadings[:, 0] *= s
scores = X_std @ loadings

COV2 = np.cov(X_raw, rowvar=False, ddof=1)
ev2, vc2 = np.linalg.eigh(COV2)
o2 = np.argsort(ev2)[::-1]
ev2 = ev2[o2]; vc2 = vc2[:, o2]
evr2 = ev2 / ev2.sum()
loadings_cov = vc2.copy()
s2 = np.sign(loadings_cov[:, 0].sum())
loadings_cov[:, 0] *= s2
scores_cov = X_raw @ loadings_cov

cent = cap[["BCE","group"]].copy()
cent["phase"] = np.where(cent["group"].eq("MN"), "Middle Neolithic (MN)",
                  np.where(cent["group"].eq("SG"), "Younger Neolithic (YN/SG)", cent["group"]))
cent["PC1_corr"] = scores[:, 0]
cent["PC2_corr"] = scores[:, 1]
cent["PC1_cov"]  = scores_cov[:, 0]
cent = cent.sort_values("BCE", ascending=False).reset_index(drop=True)
for dom, cols in DOMAIN.items():
    cent[f"meanZ_{dom}"] = cap[cols].mean(axis=1).to_numpy()

def phase_stats(df, label):
    sub = df[df["phase"].str.startswith(label.split(' ')[0])].copy()
    pc1 = sub["PC1_corr"].to_numpy()
    t = (-sub["BCE"].to_numpy())/100.0
    if len(t) >= 2:
        slope, intercept = np.polyfit(t, pc1, 1)
    else:
        slope, intercept = float("nan"), float("nan")
    return {"phase": label, "n_slices":int(len(sub)),
            "BCE_min":int(sub["BCE"].max()), "BCE_max":int(sub["BCE"].min()),
            "PC1_mean":float(np.mean(pc1)), "PC1_median":float(np.median(pc1)),
            "PC1_std":float(np.std(pc1, ddof=1)) if len(pc1)>1 else 0.0,
            "PC1_min":float(np.min(pc1)), "PC1_max":float(np.max(pc1)),
            "PC1_range":float(np.max(pc1)-np.min(pc1)),
            "trend_slope_per_century":float(slope),
            "domain_means":{dom:float(np.mean(sub[f"meanZ_{dom}"])) for dom in DOMAIN}}

stats_MN = phase_stats(cent, "Middle Neolithic (MN)")
stats_YN = phase_stats(cent, "Younger Neolithic (YN/SG)")
delta_PC1 = stats_YN["PC1_mean"] - stats_MN["PC1_mean"]

# Pollen openness supplementary cross-correlation at the 12 BCE marks
pol["CE_int"] = pol["CE"].astype(int)
bce_marks = [3400,3300,3200,3100,3000,2900,2800,2700,2600,2500,2400,2300]
ce_marks  = [-b for b in bce_marks]
pollen_aligned = pol.set_index("CE_int").loc[ce_marks,
    ["Belau_PC1_inter","Woserin_PC1_inter","MEAN","SMOOTH_MEAN_50y",
     "SMOOTH_MEAN_100y","SMOOTH_MEAN_150y","SMOOTH_MEAN_200y","SMOOTH_MEAN_250y"]].copy()
pollen_aligned["BCE"] = bce_marks
pc1_by_bce = cent.set_index("BCE")["PC1_corr"]
pollen_aligned["PC1_corr"] = [pc1_by_bce[b] for b in bce_marks]

corr = {}
for col in ["Belau_PC1_inter","Woserin_PC1_inter","MEAN",
            "SMOOTH_MEAN_50y","SMOOTH_MEAN_100y","SMOOTH_MEAN_150y",
            "SMOOTH_MEAN_200y","SMOOTH_MEAN_250y"]:
    s_ = pollen_aligned[col]
    pearson = float(np.corrcoef(pollen_aligned["PC1_corr"], s_)[0,1])
    pr = pd.Series(pollen_aligned["PC1_corr"]).rank()
    sr = s_.rank()
    spearman = float(np.corrcoef(pr, sr)[0,1])
    corr[col] = {"pearson":pearson, "spearman":spearman}

# Sanity: project time_series *_inter onto PC1 loadings and compare at BCE marks
# map ZCOLS (German) to time_series (English)
ZCOLS_TS = ["HatchetSword_inter","Dagger_inter","HouseSize_inter","CopperGold_inter","Amber_inter","MonumentCount_inter","Depot_inter","Sickle_inter","AxesCelts_inter","MonumentSize_inter","PotteryForm_inter","PotteryDecoration_inter"]
ts_cap_cols = ZCOLS_TS
ts_X = ts[ts_cap_cols].to_numpy(dtype=float)
ts_Z = (ts_X - mu0) / sd0
W    = loadings[:, 0]
ts["PC1_proj"] = ts_Z @ W
ts_check = ts[ts["CE"].isin(ce_marks)].copy()
ts_check["PC1_cent"]  = [pc1_by_bce[-c] for c in ts_check["CE"]]
ts_check["PC1_diff"]  = ts_check["PC1_proj"] - ts_check["PC1_cent"]
sanity = ts_check[["CE","PC1_proj","PC1_cent","PC1_diff"]].sort_values("CE", ascending=False)

# Save artifacts
def to_jsonable(o):
    if isinstance(o, (np.integer,)): return int(o)
    if isinstance(o, (np.floating,)): return float(o)
    if isinstance(o, np.ndarray): return o.tolist()
    if isinstance(o, dict): return {k: to_jsonable(v) for k,v in o.items()}
    if isinstance(o, list): return [to_jsonable(v) for v in o]
    return o

dom_for = []
for d, vs in DOMAIN.items():
    for v in vs: dom_for.append((v, d))

loadings_tbl = pd.DataFrame({
    "variable": ZCOLS,
    "domain":   [d for v, d in dom_for],
    "PC1_loading": loadings[:, 0],
    "PC2_loading": loadings[:, 1],
    "PC3_loading": loadings[:, 2],
})
loadings_tbl.to_csv(OUT/"loadings.csv", index=False)

explained_tbl = pd.DataFrame({"component":[f"PC{i+1}" for i in range(12)],
                              "eigenvalue":eigvals,
                              "explained_var_ratio":evr,
                              "cumulative_ratio":cumv})
explained_tbl.to_csv(OUT/"explained_variance.csv", index=False)

cent.to_csv(OUT/"pc1_centennial_scores.csv", index=False)

domain_rows = []
for s_ in (stats_MN, stats_YN):
    row = {"phase": s_["phase"], "PC1_mean": s_["PC1_mean"], "PC1_median": s_["PC1_median"],
           "PC1_std": s_["PC1_std"], "trend_slope_per_century": s_["trend_slope_per_century"]}
    for k, v in s_["domain_means"].items():
        row[f"meanZ_{k}"] = v
    domain_rows.append(row)
phase_tbl = pd.DataFrame(domain_rows)
phase_tbl.to_csv(OUT/"phase_summary.csv", index=False)

pollen_aligned.to_csv(OUT/"pollen_pc1_alignment.csv", index=False)
corr_df = pd.DataFrame(corr).T.reset_index().rename(columns={"index":"pollen_series"})
corr_df.to_csv(OUT/"pollen_pc1_correlations.csv", index=False)
sanity.to_csv(OUT/"sanity_ts_pc1.csv", index=False)

summary = {
    "primary_spec":"correlation_matrix_pca",
    "n_slices":int(len(cap)), "n_variables":len(ZCOLS),
    "PC1_explained_var":float(evr[0]),
    "PC1_to_PC3_cumvar":float(cumv[2]),
    "PC1_loadings_raw_unoriented":dict(zip(ZCOLS,[float(v) for v in eigvecs[:, 0]])),
    "PC1_loadings_oriented_sum_positive":dict(zip(ZCOLS,[float(v) for v in loadings[:, 0]])),
    "PC2_loadings":dict(zip(ZCOLS,[float(v) for v in loadings[:, 1]])),
    "PC3_loadings":dict(zip(ZCOLS,[float(v) for v in loadings[:, 2]])),
    "phase_MN":to_jsonable(stats_MN),
    "phase_YN":to_jsonable(stats_YN),
    "delta_PC1_YN_minus_MN":float(delta_PC1),
    "pollen_pc1_corr":to_jsonable(corr),
    "sensitivity_cov_PC1_explained_var":float(evr2[0]),
    "sensitivity_cov_PC1_loadings":dict(zip(ZCOLS,[float(v) for v in loadings_cov[:, 0]])),
    "ZSichel_SD_input":float(sd0[ZCOLS.index("ZSichel")]),
}
with open(OUT/"analysis_summary.json","w") as fh:
    json.dump(summary, fh, indent=2)

print("===== PC1 (correlation) explained var:", f"{evr[0]:.3f}", "=====")
print("Cumulative var PC1-PC3:", f"{cumv[2]:.3f}")
print("\nPC1 loadings (oriented sum>0):")
for v,l in zip(ZCOLS, loadings[:,0]): print(f"  {v:>13s} {l:+.3f}")
print("\nPC2 loadings:")
for v,l in zip(ZCOLS, loadings[:,1]): print(f"  {v:>13s} {l:+.3f}")
print("\n===== Phase stats =====")
for s_ in (stats_MN, stats_YN):
    print(f"  {s_['phase']}: n={s_['n_slices']} BCE {s_['BCE_max']}..{s_['BCE_min']} "
          f"PC1 mean={s_['PC1_mean']:+.3f} sd={s_['PC1_std']:.3f} "
          f"range={s_['PC1_range']:.3f} trend/century={s_['trend_slope_per_century']:+.3f}")
    print("    domain means:", ", ".join(f"{k}={v:+.3f}" for k,v in s_['domain_means'].items()))
print(f"\nDelta PC1 (YN - MN): {delta_PC1:+.3f}")
print("\n===== Pollen x PC1 (12 BCE marks) =====")
for col, c in corr.items():
    print(f"  {col:>22s} pearson={c['pearson']:+.3f} spearman={c['spearman']:+.3f}")
print("\n===== Sensitivity (covariance PCA) =====")
print(f"PC1 explained var: {evr2[0]:.3f}")
print("\nSensitivity PC1 loadings:")
for v,l in zip(ZCOLS, loadings_cov[:,0]): print(f"  {v:>13s} {l:+.4f}")
print("\n===== Sanity: ts *_inter projections vs centennial PC1 =====")
print(sanity.to_string(index=False))
print("\nArtifacts written to:", OUT)
