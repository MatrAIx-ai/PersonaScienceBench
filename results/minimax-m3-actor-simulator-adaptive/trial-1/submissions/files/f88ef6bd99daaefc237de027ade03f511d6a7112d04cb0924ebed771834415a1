"""
NLSY79 (1989 cross-section): how does AGE influence P(DISSAVED = 1)?
=====================================================================

Nested logistic regressions on the deduplicated primary sample, with a
full-sample sensitivity refit of the controlled model.

Outputs (in /workspace/artifacts/):
  - analysis.py         (this script; re-executable)
  - results.json        (serialised estimates, LR test, AME, turning point)
  - binned_rates.csv    (DISSAVED rate by single-year age bin)
  - fitted_curve.csv    (M3 fitted probability across ages 24..32)
  - predicted_probability.svg  (M3 fitted curve + binned-rate overlay)
  - predicted_probability.txt  (ASCII fallback plot)
  - model_summary.txt   (human-readable summary text)

Run from /workspace: python3 artifacts/analysis.py
"""

from __future__ import annotations

import json
import warnings
from pathlib import Path

import numpy as np
import pandas as pd
import statsmodels.api as sm
from scipy import stats

warnings.filterwarnings("ignore")

ART = Path("artifacts")
ART.mkdir(parents=True, exist_ok=True)
DATA = Path("data/nls_bmi_processed.csv")


def build_design(df: pd.DataFrame, model: str) -> pd.DataFrame:
    """Return the predictor matrix (no constant) for the requested model."""
    out = pd.DataFrame(index=df.index)
    out["AGE"] = df["AGE"].astype(float)
    if model in ("M2_Spec", "M3_Spec"):
        out["AGE_2"] = df["AGE_2"].astype(float)
    if model == "M3_Spec":
        out["logINCOME"] = np.log1p(df["INCOME"].astype(float))
        out["GENDER_MALE"] = (df["GENDER"].astype(str).str.upper() == "MALE").astype(int)
        out["BLACK"] = df["BLACK"].astype(int)
        out["HISPANIC"] = df["HISPANIC"].astype(int)
    return out


def fit_logit(df: pd.DataFrame, model_name: str):
    X = build_design(df, model_name)
    Xc = sm.add_constant(X, has_constant="add")
    y = df["DISSAVED"].astype(int)
    res = sm.Logit(y, Xc).fit(disp=0, method="newton", maxiter=200)
    return res


def coef_table(res) -> pd.DataFrame:
    summ = res.summary2().tables[1].copy()
    summ = summ.rename(columns={"Coef.": "coef", "Std.Err.": "se",
                                "z": "z", "P>|z|": "pvalue",
                                "[0.025": "ci_lo", "0.975]": "ci_hi"})
    return summ[["coef", "se", "z", "pvalue", "ci_lo", "ci_hi"]]


def gof(res) -> dict:
    n = int(res.nobs)
    k = int(res.df_model) + 1
    ll = float(res.llf)
    lln = float(res.llnull)
    p_lr = float(res.llr_pvalue)
    return {
        "n": n,
        "k_incl_intercept": k,
        "log_likelihood": ll,
        "log_likelihood_null": lln,
        "LR_chi2": float(-2 * (res.llnull - res.llf)),
        "LR_chi2_p": p_lr,
        "AIC": float(res.aic),
        "BIC": float(res.bic),
        "mcfadden_R2": 1 - ll / lln,
        "mcfadden_adj_R2": 1 - (ll - k) / lln,
    }



# ---------------------------------------------------------------- 1. data
df_full = pd.read_csv(DATA)
print(f"Loaded {DATA}: full N = {len(df_full):,}")

df = df_full.drop_duplicates().reset_index(drop=True)
print(f"After dropping exact-row duplicates: N = {len(df):,}")

assert (df["AGE_2"] == df["AGE"] ** 2).all(), "AGE_2 != AGE**2"
assert df.isna().sum().sum() == 0, "Unexpected missingness"

print(f"DISSAVED = 1 count: {int(df['DISSAVED'].sum())} of {len(df)} "
      f"({df['DISSAVED'].mean():.4f})")


# ---------------------------------------------------------------- 2. fit
res1 = fit_logit(df, "M1_Spec")
res2 = fit_logit(df, "M2_Spec")
res3 = fit_logit(df, "M3_Spec")
res3_full_dup = fit_logit(df_full, "M3_Spec")

print("\n=== M1 ===")
print(coef_table(res1))
print(gof(res1))
print("\n=== M2 ===")
print(coef_table(res2))
print(gof(res2))
print("\n=== M3 (deduplicated) ===")
print(coef_table(res3))
print(gof(res3))
print("\n=== M3 refit on full sample ===")
print(coef_table(res3_full_dup))
print(gof(res3_full_dup))


# ---------------------------------------------------------------- 3. LR test M1 vs M2
lr_stat = -2 * (res1.llf - res2.llf)
lr_p_sci = float(stats.chi2.sf(lr_stat, df=1))
print(f"\nLR test M1 vs M2: chi2 = {lr_stat:.4f}, df = 1, p = {lr_p_sci:.5g}")


# ---------------------------------------------------------------- 4. turning point on the logit (M3)
b_age = float(res3.params["AGE"])
b_age2 = float(res3.params["AGE_2"])
if b_age2 < 0:
    tp = -b_age / (2 * b_age2)
    in_band = bool(24 <= tp <= 32)
    turning = {"age_star": float(tp), "in_observed_band": in_band,
               "extrapolation_flag": not in_band,
               "conditional_on_beta_age2_negative": True}
else:
    turning = {"age_star": None,
               "in_observed_band": False,
               "extrapolation_flag": False,
               "conditional_on_beta_age2_negative": False,
               "note": "beta_AGE_2 >= 0 -> no interior logit maximum."}
print(f"\nTurning-point check (M3): {turning}")


# ---------------------------------------------------------------- 5. Average marginal effect of AGE in M3
margeff = res3.get_margeff(at="overall", method="dydx")
me_df = margeff.summary_frame()[["dy/dx", "Std. Err."]].copy()
me_df.columns = ["dy_dx", "se_dy_dx"]

X3_mat = sm.add_constant(build_design(df, "M3_Spec"),
                         has_constant="add").values
linpred = X3_mat @ res3.params.values
prob = 1.0 / (1.0 + np.exp(-linpred))
xpct = prob * (1 - prob) * (b_age + 2 * b_age2 * df["AGE"].values)
ame_age_check = float(xpct.mean())
print(f"\nAME of AGE in M3 (statsmodels): {me_df.loc['AGE','dy_dx']:.5f} "
      f"(SE {me_df.loc['AGE','se_dy_dx']:.5f})")
print(f"Cross-check (manual AME):          {ame_age_check:.5f}")


# ---------------------------------------------------------------- 6. binned empirical DISSAVED rate
bins = [(24, 25), (25, 26), (26, 27), (27, 28), (28, 29),
        (29, 30), (30, 31), (31, 32)]
rows = []
for lo, hi in bins:
    sub = df[(df["AGE"] >= lo) & (df["AGE"] < hi)]
    rows.append({
        "age_lo": lo, "age_hi_excl": hi, "n": int(len(sub)),
        "rate_mean_DISSAVED": float(sub["DISSAVED"].mean()) if len(sub) else None,
        "rate_se": float(sub["DISSAVED"].std(ddof=1) / np.sqrt(len(sub)))
                    if len(sub) > 1 else None,
    })
bin_tbl = pd.DataFrame(rows)
bin_tbl.to_csv(ART / "binned_rates.csv", index=False)
print("\nBinned DISSAVED rate by AGE (deduplicated):")
print(bin_tbl.to_string(index=False))


# ---------------------------------------------------------------- 7. predicted probability curve from M3
means = {
    "const": 1.0,
    "AGE": float(df["AGE"].mean()),
    "AGE_2": float(df["AGE_2"].mean()),
    "logINCOME": float(np.log1p(df["INCOME"]).mean()),
    "GENDER_MALE": float((df["GENDER"].str.upper() == "MALE").mean()),
    "BLACK": float(df["BLACK"].mean()),
    "HISPANIC": float(df["HISPANIC"].mean()),
}
order = ["const", "AGE", "AGE_2", "logINCOME",
         "GENDER_MALE", "BLACK", "HISPANIC"]
b_vec = res3.params[order].values

ages = np.arange(24, 33)
preds = []
for a in ages:
    x = np.array([1.0, a, a * a, means["logINCOME"],
                  means["GENDER_MALE"], means["BLACK"], means["HISPANIC"]])
    eta = float(x @ b_vec)
    p = 1.0 / (1.0 + np.exp(-eta))
    preds.append({"AGE": int(a), "fitted_prob_DISSAVED": p})
pred_df = pd.DataFrame(preds)
pred_df.to_csv(ART / "fitted_curve.csv", index=False)
print("\nM3 fitted curve (sample-mean controls):")
print(pred_df.to_string(index=False))



# ---------------------------------------------------------------- 8. plot
try:
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt

    fig, ax = plt.subplots(figsize=(7.5, 4.8))
    ax.plot(ages, pred_df["fitted_prob_DISSAVED"].values,
            color="#1f4e79", lw=2.0, label="M3 fitted P(DISSAVED=1)")
    cov = res3.cov_params().loc[order, order].values
    grads = []
    for a in ages:
        age_2 = a * a
        g = np.array([1.0, a, age_2,
                      means["logINCOME"], means["GENDER_MALE"],
                      means["BLACK"], means["HISPANIC"]])
        grads.append(g)
    grads = np.vstack(grads)
    var_eta = np.einsum("ij,jk,ik->i", grads, cov, grads)
    se_eta = np.sqrt(np.maximum(var_eta, 0.0))
    p_lo = 1.0 / (1.0 + np.exp(-(grads @ b_vec + 1.96 * se_eta)))
    p_hi = 1.0 / (1.0 + np.exp(-(grads @ b_vec - 1.96 * se_eta)))
    ax.fill_between(ages, p_lo, p_hi, color="#1f4e79", alpha=0.15,
                    label="M3 95% CI of fitted prob.")

    age_mid = (bin_tbl["age_lo"] + bin_tbl["age_hi_excl"]) / 2.0
    bin_se = bin_tbl["rate_se"].fillna(0.0)
    ax.errorbar(age_mid, bin_tbl["rate_mean_DISSAVED"],
                yerr=1.96 * bin_se,
                fmt="o", color="#c0504d", ms=5, lw=1.0,
                label="Empirical DISSAVED rate (binned) +/- 95% CI")

    ax.set_xlabel("AGE in 1989")
    ax.set_ylabel("P(DISSAVED = 1)  [withdrew more than deposited]")
    ax.set_title("Predicted probability vs observed DISSAVED rate by age\n"
                 "(NLSY79 1989 cross-section, M3 logistic regression)")
    ax.set_xticks(np.arange(24, 33))
    ax.grid(alpha=0.25)
    ax.legend(loc="upper right", framealpha=0.9)
    fig.tight_layout()
    fig.savefig(ART / "predicted_probability.png", dpi=150)
    plt.close(fig)
    print(f"\nPlot written: {ART/'predicted_probability.png'}")
except Exception as e:
    print(f"(Plot step failed: {e})")


# ---------------------------------------------------------------- 9. serialise results JSON
def coef_to_dict(ctbl, gof_dict):
    d = {}
    for name, row in ctbl.iterrows():
        d[name] = {k: (None if pd.isna(v) else float(v))
                   for k, v in row.to_dict().items()}
    d["__gof__"] = gof_dict
    return d


results = {
    "data": {
        "n_full": int(len(df_full)),
        "n_deduplicated": int(len(df)),
        "n_duplicates_dropped": int(len(df_full) - len(df)),
        "miss_per_col": {c: int(df_full[c].isna().sum()) for c in df_full.columns},
        "DISSAVED_rate_full": float(df_full["DISSAVED"].mean()),
        "DISSAVED_rate_dedupe": float(df["DISSAVED"].mean()),
    },
    "M1_DISSAVED_AGE": {"coef_table": coef_to_dict(coef_table(res1), gof(res1))},
    "M2_DISSAVED_AGE_AGE2": {"coef_table": coef_to_dict(coef_table(res2), gof(res2))},
    "M3_DISSAVED_AGE_AGE2_logINCOME_GENDER_BLACK_HISPANIC": {
        "coef_table": coef_to_dict(coef_table(res3), gof(res3))},
    "M3_full_sample_sensitivity": {
        "note": "Refit of M3 on the full (un-deduplicated) sample for robustness.",
        "coef_table": coef_to_dict(coef_table(res3_full_dup), gof(res3_full_dup))},
    "LR_test_M1_vs_M2": {
        "chi2": float(lr_stat),
        "df": 1,
        "p_value": lr_p_sci,
        "decision_at_alpha_005": (
            "Reject M1 in favour of M2: AGE_2 adds significant curvature"
            if lr_p_sci < 0.05
            else "Fail to reject M1: AGE_2 does NOT significantly improve the model"
        ),
    },
    "turning_point_M3": turning,
    "avg_marginal_effect_M3": {
        "variable": "AGE",
        "dy_dx": float(me_df.loc["AGE", "dy_dx"]),
        "se_dy_dx": float(me_df.loc["AGE", "se_dy_dx"]),
        "cross_check_manual": ame_age_check,
        "interpretation": (
            "Average change in P(DISSAVED=1) per one-year increase in AGE, "
            "evaluated at observed covariate values."
        ),
    },
    "predicted_curve_M3": preds,
    "binned_rates": bin_tbl.to_dict(orient="records"),
}

with open(ART / "results.json", "w") as f:
    json.dump(results, f, indent=2, default=str)
print(f"\nWrote results: {ART/'results.json'}")


# ---------------------------------------------------------------- 10. textual summary
def fmt_p(p):
    if p is None or (isinstance(p, float) and (np.isnan(p) or np.isinf(p))):
        return "NA"
    if p < 1e-4:
        return f"{p:.2e}"
    return f"{p:.4f}"


lines = []
lines.append("NLSY79 (1989) cross-section -- DISSAVED vs AGE")
lines.append("=" * 50)
lines.append(f"Sample (deduplicated):  N = {len(df):,}")
lines.append(f"DISSAVED = 1 rate:      {df['DISSAVED'].mean():.4f}")
lines.append("")


def cmp_block(name, res):
    lines.append(name)
    ct = coef_table(res)
    g = gof(res)
    for v, row in ct.iterrows():
        lines.append(
            f"  {v:<14s}  b={row['coef']:>10.5f}  SE={row['se']:.5f}"
            f"  z={row['z']:>8.3f}  p={fmt_p(row['pvalue'])}"
            f"  95% CI=[{row['ci_lo']:.5f}, {row['ci_hi']:.5f}]")
    lines.append(
        f"  N={g['n']}  logL={g['log_likelihood']:.3f}"
        f"  AIC={g['AIC']:.2f}  BIC={g['BIC']:.2f}"
        f"  McFadden_R2={g['mcfadden_R2']:.4f}")
    lines.append("")


cmp_block("M1: DISSAVED ~ AGE", res1)
cmp_block("M2: DISSAVED ~ AGE + AGE_2", res2)
cmp_block("M3 (primary): DISSAVED ~ AGE + AGE_2 + log(INCOME+1) "
          "+ GENDER_MALE + BLACK + HISPANIC", res3)

lines.append("LR test M1 vs M2 on quadratic AGE:")
lines.append(f"   chi2 = {lr_stat:.4f}, df=1, p = {fmt_p(lr_p_sci)}")
if lr_p_sci < 0.05:
    lines.append("   -> M2 improves over M1; AGE_2 has significant curvature")
else:
    lines.append("   -> AGE_2 does NOT significantly improve over linear in this band.")
lines.append("")

lines.append("Turning-point check (logit polynomial, M3):")
if turning["age_star"] is not None:
    lines.append(
        f"   age* = {turning['age_star']:.3f}; "
        f"in 24-32 band = {turning['in_observed_band']}; "
        f"extrapolation_flag = {turning['extrapolation_flag']}")
else:
    lines.append(f"   {turning.get('note','')}")
lines.append("")

lines.append("Average marginal effect of AGE on P(DISSAVED=1), M3 (AME):")
lines.append(f"   dy/dx = {me_df.loc['AGE','dy_dx']:+.5f}  "
             f"(SE {me_df.loc['AGE','se_dy_dx']:.5f})")
lines.append(f"   Cross-check (manual AME): {ame_age_check:+.5f}")
lines.append("")

lines.append("M3 refit on FULL (un-deduplicated) sample -- sensitivity check:")
ct_full = coef_table(res3_full_dup)
for v, row in ct_full.iterrows():
    lines.append(
        f"  {v:<14s}  b={row['coef']:>10.5f}  SE={row['se']:.5f}"
        f"  z={row['z']:>8.3f}  p={fmt_p(row['pvalue'])}"
        f"  95% CI=[{row['ci_lo']:.5f}, {row['ci_hi']:.5f}]")

with open(ART / "model_summary.txt", "w") as f:
    f.write("\n".join(lines))
print("\n".join(lines))



# ---------------------------------------------------------------- (alt) Pure-Python SVG plot (no matplotlib needed)
def write_svg_plot(path, ages, fitted, ci_lo, ci_hi, bin_tbl):
    W, H = 760, 480
    M = dict(l=70, r=30, t=50, b=60)
    plot_w = W - M["l"] - M["r"]
    plot_h = H - M["t"] - M["b"]
    xmin, xmax = 23.5, 32.5
    ymin, ymax = 0.20, 0.34
    ages_l = list(ages)

    def x_to_px(x):
        return M["l"] + (x - xmin) / (xmax - xmin) * plot_w
    def y_to_px(y):
        return M["t"] + (1 - (y - ymin) / (ymax - ymin)) * plot_h

    parts = []
    parts.append(f'<svg xmlns="http://www.w3.org/2000/svg" width="{W}" height="{H}" '
                 f'viewBox="0 0 {W} {H}" font-family="DejaVu Sans, Helvetica, Arial, sans-serif" font-size="12">')
    parts.append(f'<rect x="0" y="0" width="{W}" height="{H}" fill="#ffffff"/>')
    parts.append(f'<rect x="{M["l"]}" y="{M["t"]}" width="{plot_w}" height="{plot_h}" '
                 f'fill="#fafafa" stroke="#888" stroke-width="1"/>')
    # 95% CI band
    ages_list = [int(a) for a in ages_l]
    ci_lo_l = [float(x) for x in ci_lo]
    ci_hi_l = [float(x) for x in ci_hi]
    band = " ".join([f"L{x_to_px(ages_list[i]):.1f},{y_to_px(ci_lo_l[i]):.1f}" for i in range(len(ages_list))])
    band += " " + " ".join([f"L{x_to_px(ages_list[i]):.1f},{y_to_px(ci_hi_l[i]):.1f}" for i in range(len(ages_list)-1, -1, -1)]) + " Z"
    parts.append(f'<path d="M{x_to_px(ages_l[0]):.1f},{y_to_px(ci_lo[0]):.1f} {band}" '
                 f'fill="#1f4e79" opacity="0.18" stroke="none"/>')
    # Fitted curve
    curve = " ".join([f"{x_to_px(a):.1f},{y_to_px(p):.1f}" for a, p in zip(ages, fitted)])
    parts.append(f'<polyline points="{curve}" fill="none" stroke="#1f4e79" stroke-width="2.2"/>')
    # Binned empirical points with 95% CI error bars
    for _, r in bin_tbl.iterrows():
        cx = x_to_px((r["age_lo"] + r["age_hi_excl"]) / 2.0)
        cy = y_to_px(r["rate_mean_DISSAVED"])
        se = r["rate_se"] if r["rate_se"] else 0.0
        ylo = y_to_px(r["rate_mean_DISSAVED"] - 1.96 * se)
        yhi = y_to_px(r["rate_mean_DISSAVED"] + 1.96 * se)
        parts.append(f'<line x1="{cx:.1f}" y1="{yhi:.1f}" x2="{cx:.1f}" y2="{ylo:.1f}" '
                     f'stroke="#c0504d" stroke-width="1.4"/>')
        parts.append(f'<rect x="{cx-3:.1f}" y="{cy-3:.1f}" width="6" height="6" '
                     f'fill="#c0504d" stroke="#7a2e2c" stroke-width="1"/>')
    # Axes ticks
    for a in range(24, 33):
        x = x_to_px(a)
        parts.append(f'<line x1="{x:.1f}" y1="{M["t"]+plot_h}" x2="{x:.1f}" y2="{M["t"]+plot_h+4}" stroke="#444"/>')
        parts.append(f'<text x="{x:.1f}" y="{M["t"]+plot_h+18}" text-anchor="middle" fill="#222">{a}</text>')
    yticks = [0.20, 0.22, 0.24, 0.26, 0.28, 0.30, 0.32, 0.34]
    for y in yticks:
        yp = y_to_px(y)
        parts.append(f'<line x1="{M["l"]-4}" y1="{yp:.1f}" x2="{M["l"]}" y2="{yp:.1f}" stroke="#444"/>')
        parts.append(f'<text x="{M["l"]-8}" y="{yp+4:.1f}" text-anchor="end" fill="#222">{y:.2f}</text>')
    # Title and axis labels
    parts.append(f'<text x="{W/2:.0f}" y="28" text-anchor="middle" font-size="14" fill="#222">'
                 f'Predicted probability vs observed DISSAVED rate by age (NLSY79 1989, M3)'
                 f'</text>')
    parts.append(f'<text x="{W/2:.0f}" y="{H-18}" text-anchor="middle" fill="#222">AGE in 1989</text>')
    parts.append(f'<text x="18" y="{H/2:.0f}" text-anchor="middle" fill="#222" '
                 f'transform="rotate(-90 18 {H/2:.0f})">P(DISSAVED = 1)</text>')
    # Legend
    lx, ly = M["l"] + 12, M["t"] + 12
    parts.append(f'<rect x="{lx-4}" y="{ly-4}" width="240" height="58" fill="#ffffff" opacity="0.92" stroke="#bbb"/>')
    parts.append(f'<line x1="{lx}" y1="{ly+8}" x2="{lx+30}" y2="{ly+8}" stroke="#1f4e79" stroke-width="2.2"/>')
    parts.append(f'<text x="{lx+38}" y="{ly+12}" fill="#222">M3 fitted P(DISSAVED=1)</text>')
    parts.append(f'<rect x="{lx}" y="{ly+18}" width="30" height="10" fill="#1f4e79" opacity="0.25"/>')
    parts.append(f'<text x="{lx+38}" y="{ly+28}" fill="#222">M3 95% CI of fitted prob.</text>')
    parts.append(f'<rect x="{lx}" y="{ly+34}" width="6" height="6" fill="#c0504d" stroke="#7a2e2c"/>')
    parts.append(f'<line x1="{lx-2}" y1="{ly+37}" x2="{lx+14}" y2="{ly+37}" stroke="#c0504d"/>')
    parts.append(f'<text x="{lx+38}" y="{ly+44}" fill="#222">Empirical DISSAVED rate (binned) +-95% CI</text>')
    parts.append('</svg>')
    Path(path).write_text("\n".join(parts))


# Compute CI along curve for plotting
cov = res3.cov_params().loc[order, order].values
grads = []
for a in ages:
    g = np.array([1.0, a, a * a, means["logINCOME"], means["GENDER_MALE"],
                  means["BLACK"], means["HISPANIC"]])
    grads.append(g)
grads = np.vstack(grads)
var_eta = np.einsum("ij,jk,ik->i", grads, cov, grads)
se_eta = np.sqrt(np.maximum(var_eta, 0.0))
p_lo_arr = 1.0 / (1.0 + np.exp(-(grads @ b_vec + 1.96 * se_eta)))
p_hi_arr = 1.0 / (1.0 + np.exp(-(grads @ b_vec - 1.96 * se_eta)))
fitted_arr = pred_df["fitted_prob_DISSAVED"].values
write_svg_plot(ART / "predicted_probability.svg",
               ages, fitted_arr, p_lo_arr, p_hi_arr, bin_tbl)
print(f"\nSVG plot written: {ART/'predicted_probability.svg'}")

# Plain-text ASCII plot for transparency
def ascii_plot(ages_v, fitted_v, bin_tbl):
    rows = []
    rows.append("      ASCII plot: P(DISSAVED=1) vs AGE (P=probability)")
    rows.append("      y axis: 0.25 - 0.32  (each '*' = ~0.0025)")
    rows.append("")
    ymin, ymax = 0.20, 0.35
    HEIGHT = 30
    WIDTH = 60
    grid = [[" "] * WIDTH for _ in range(HEIGHT)]
    ages_v = [int(x) for x in ages_v]
    fitted_v = [float(x) for x in fitted_v]
    # Axis labels
    for i in range(HEIGHT):
        y = ymax - i * (ymax - ymin) / (HEIGHT - 1)
        rows.append("")
        # prepare grid row
    # draw fitted curve
    for a, p in zip(ages_v, fitted_v):
        xi = int(round((a - 23.5) / (32.5 - 23.5) * (WIDTH - 1)))
        yi = int(round((ymax - p) / (ymax - ymin) * (HEIGHT - 1)))
        yi = max(0, min(HEIGHT - 1, yi))
        grid[yi][xi] = "*"
    # draw binned points as 'o'
    for _, r in bin_tbl.iterrows():
        x = (r["age_lo"] + r["age_hi_excl"]) / 2.0
        xi = int(round((x - 23.5) / (32.5 - 23.5) * (WIDTH - 1)))
        yi = int(round((ymax - r["rate_mean_DISSAVED"]) / (ymax - ymin) * (HEIGHT - 1)))
        yi = max(0, min(HEIGHT - 1, yi))
        if grid[yi][xi] == " ":
            grid[yi][xi] = "o"
        else:
            grid[yi][xi] = "+"
    # render with y labels
    for i in range(HEIGHT):
        y = ymax - i * (ymax - ymin) / (HEIGHT - 1)
        line = f" {y:.2f} | " + "".join(grid[i])
        rows.append(line)
    x_axis = "        +" + "-" * WIDTH
    x_lab = "         " + "".join(["24", "   ", "26", "   ", "28", "   ", "30", "   ", "32"])
    rows.append(x_axis)
    rows.append(x_lab + " (AGE)")
    rows.append("Legend: '*' = M3 fitted curve, 'o' = binned empirical, '+' = overlap")
    return "\n".join(rows)


