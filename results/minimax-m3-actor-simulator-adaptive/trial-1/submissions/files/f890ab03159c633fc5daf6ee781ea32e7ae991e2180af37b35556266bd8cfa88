
"""
End-to-end analysis for:
    'How does incarceration affect the wealth of black individuals based on their income levels?'

Dataset: data/nls_incarceration_processed.csv (NLSY79-based)

Plan (approved):
    Step 0 — Black-only terciles of composite_wealth_1985 as pre-incarceration income-proxy.
    Step 1 — Within-stratum descriptive comparison of ever_jailed vs never_jailed;
             medians/q25/q75; Mann-Whitney U + 95% percentile-bootstrap CI on median gap.
    Step 2 — Per-stratum trajectory of median wealth 1985->1990->1996.
    Step 3 — OLS and median-quantile (Q=0.5) regression with ever_jailed x stratum
             interaction; sex covariate; HC1 robust SE; primary = 1996; sensitivity = 1990.
    Robustness   — quartiles and <0 / 0 / >0 bucket of 1985 Black wealth.
    Cross-race   — compact Black/White/Hipanic reference table (descriptive only).
"""
import json
from pathlib import Path
import numpy as np
import pandas as pd
import statsmodels.api as sm
from scipy.stats import mannwhitneyu
from statsmodels.regression.quantile_regression import QuantReg

RNG = np.random.default_rng(20261021)
DATA_PATH = Path("/workspace/data/nls_incarceration_processed.csv")
RESULTS = {}

# ----------------------------- Load & restrict -----------------------------
df = pd.read_csv(DATA_PATH)
black = df[df["race"] == "black"].copy().reset_index(drop=True)
assert black.shape[0] == 3013, f"Unexpected Black N: {black.shape[0]}"
assert black["ever_jailed"].isin([0, 1]).all()
assert black[["composite_wealth_1985","composite_wealth_1990","composite_wealth_1996"]].isna().sum().sum() == 0

# ----------------------------- Step 0: terciles ----------------------------
black["w85_t"] = pd.qcut(
    black["composite_wealth_1985"], q=3,
    labels=["T1_lowest", "T2_mid", "T3_highest"],
)
print("Tercile cut points (Black w1985):")
for q in [0, 1/3, 2/3, 1]:
    print(f"  q={q:.4f}  ->  ${black['composite_wealth_1985'].quantile(q):,.2f}")

# ----------------------------- Step 1: descriptive ------------------------
def qblock(s):
    s = np.asarray(s, dtype=float)
    s = s[~np.isnan(s)]
    if len(s) == 0:
        return dict(N=0, mean=np.nan, median=np.nan, q25=np.nan, q75=np.nan)
    return dict(N=int(len(s)),
                mean=float(np.mean(s)),
                median=float(np.median(s)),
                q25=float(np.quantile(s, 0.25)),
                q75=float(np.quantile(s, 0.75)))

black["dw90"] = black["composite_wealth_1990"] - black["composite_wealth_1985"]
black["dw96"] = black["composite_wealth_1996"] - black["composite_wealth_1985"]

print("\n=== STEP 1: Within-stratum descriptives (Black, terciles of w1985) ===")
desc_rows = []
for t in ["T1_lowest", "T2_mid", "T3_highest"]:
    for j in [0, 1]:
        sub = black[(black["w85_t"] == t) & (black["ever_jailed"] == j)]
        for yname in ["composite_wealth_1985", "composite_wealth_1990",
                      "composite_wealth_1996", "dw90", "dw96"]:
            d = qblock(sub[yname])
            desc_rows.append(dict(stratum=t, ever_jailed=j, outcome=yname, **d))
desc_df = pd.DataFrame(desc_rows)
print(desc_df.to_string(index=False))
RESULTS["step1_descriptives_terciles"] = desc_df

# ----------------------------- Step 1b: gaps + tests + bootstrap -----------
def median_gap_with_ci(a_vals, b_vals, B=2000, seed=20261021):
    a = np.asarray(a_vals, dtype=float); b = np.asarray(b_vals, dtype=float)
    a = a[~np.isnan(a)]; b = b[~np.isnan(b)]
    if len(a) == 0 or len(b) == 0:
        return dict(gap=np.nan, ci_lo=np.nan, ci_hi=np.nan,
                    p_mannwhit_two=np.nan, p_mannwhit_one=np.nan,
                    n_a=len(a), n_b=len(b))
    point = float(np.median(b) - np.median(a))
    rng = np.random.default_rng(seed)
    idx_a = rng.integers(0, len(a), size=(B, len(a)))
    idx_b = rng.integers(0, len(b), size=(B, len(b)))
    boot = np.median(b[idx_b], axis=1) - np.median(a[idx_a], axis=1)
    ci_lo, ci_hi = float(np.percentile(boot, 2.5)), float(np.percentile(boot, 97.5))
    try: u2, p2 = mannwhitneyu(b, a, alternative="two-sided")
    except Exception: p2 = np.nan
    try: u1, p1 = mannwhitneyu(b, a, alternative="greater")
    except Exception: p1 = np.nan
    return dict(gap=point, ci_lo=ci_lo, ci_hi=ci_hi,
                p_mannwhit_two=p2, p_mannwhit_one=p1,
                n_a=len(a), n_b=len(b))

print("\n=== STEP 1b: Ever_jailed vs Never_jailed gaps within Black strata ===")
gap_rows = []
for t in ["T1_lowest", "T2_mid", "T3_highest"]:
    for outcome in ["composite_wealth_1990", "composite_wealth_1996", "dw96"]:
        nj = black[(black["w85_t"] == t) & (black["ever_jailed"] == 0)][outcome].dropna()
        ej = black[(black["w85_t"] == t) & (black["ever_jailed"] == 1)][outcome].dropna()
        g = median_gap_with_ci(nj, ej)
        gap_rows.append(dict(
            stratum=t, outcome=outcome,
            median_never_jailed=float(np.median(nj)) if len(nj) else np.nan,
            median_ever_jailed=float(np.median(ej))  if len(ej) else np.nan,
            gap_ej_minus_nj=g["gap"], ci95_lo=g["ci_lo"], ci95_hi=g["ci_hi"],
            p_mw_greater_one_sided=g["p_mannwhit_one"],
            p_mw_two_sided=g["p_mannwhit_two"],
            n_never_jailed=g["n_a"], n_ever_jailed=g["n_b"]))
gaps_df = pd.DataFrame(gap_rows)
print(gaps_df.to_string(index=False))
RESULTS["step1_gaps_terciles"] = gaps_df

# ----------------------------- Step 2: trajectory medians ------------------
print("\n=== STEP 2: Median wealth trajectory by stratum x ever_jailed (Black) ===")
trj_rows = []
for t in ["T1_lowest", "T2_mid", "T3_highest"]:
    for j in [0, 1]:
        sub = black[(black["w85_t"] == t) & (black["ever_jailed"] == j)]
        for y in [1985, 1990, 1996]:
            trj_rows.append(dict(
                stratum=t, ever_jailed=j, year=y, N=sub.shape[0],
                median=float(np.median(sub[f"composite_wealth_{y}"])),
                q25=float(np.quantile(sub[f"composite_wealth_{y}"], 0.25)),
                q75=float(np.quantile(sub[f"composite_wealth_{y}"], 0.75))))
trj_df = pd.DataFrame(trj_rows)
print(trj_df.to_string(index=False))
RESULTS["step2_trajectory_terciles"] = trj_df

# ----------------------------- Step 3: regression ------------------------
def build_design(sub_df, ref, levels):
    X = pd.DataFrame(index=sub_df.index)
    X["intercept"] = 1.0
    X["ever_jailed"] = sub_df["ever_jailed"].astype(float)
    X["male"] = (sub_df["sex"] == "male").astype(float)
    for lvl in levels:
        if lvl == ref: continue
        X[f"stratum_{lvl}"] = (sub_df["custom_stratum"] == lvl).astype(float)
        X[f"ej_x_{lvl}"]    = X["ever_jailed"] * X[f"stratum_{lvl}"]
    return X

black["custom_stratum"] = black["w85_t"].astype(str)
levels_t = ["T1_lowest", "T2_mid", "T3_highest"]

print("\n=== STEP 3a: OLS on composite_wealth_1996 (Black) ===")
sub6 = black.dropna(subset=["composite_wealth_1996"]).copy()
X6 = build_design(sub6, "T1_lowest", levels_t)
y6 = sub6["composite_wealth_1996"].astype(float)
ols6 = sm.OLS(y6, X6).fit(cov_type="HC1")
print(ols6.summary().tables[1])
RESULTS["step3_ols_1996"] = ols6.summary().as_text()

# Winsorize at 99th pct
w96_w = np.clip(sub6["composite_wealth_1996"], None,
                sub6["composite_wealth_1996"].quantile(0.99))
ols6w = sm.OLS(w96_w, X6).fit(cov_type="HC1")
print("\nOLS on WINSORIZED w1996 (99th pct cap):")
print(ols6w.summary().tables[1])
RESULTS["step3_ols_1996_winsor"] = ols6w.summary().as_text()

print("\n=== STEP 3b: Median (Q=0.5) regression on composite_wealth_1996 ===")
qr6 = QuantReg(y6, X6).fit(q=0.5, cov_type="HC1")
print(qr6.summary().tables[1])
RESULTS["step3_qreg_1996"] = qr6.summary().as_text()

print("\n=== STEP 3c: OLS sensitivity on composite_wealth_1990 ===")
sub0 = black.dropna(subset=["composite_wealth_1990"]).copy()
X0 = build_design(sub0, "T1_lowest", levels_t)
y0 = sub0["composite_wealth_1990"].astype(float)
ols0 = sm.OLS(y0, X0).fit(cov_type="HC1")
print(ols0.summary().tables[1])
RESULTS["step3_ols_1990"] = ols0.summary().as_text()

print("\n=== STEP 3d: Median (Q=0.5) regression sensitivity on composite_wealth_1990 ===")
qr0 = QuantReg(y0, X0).fit(q=0.5, cov_type="HC1")
print(qr0.summary().tables[1])
RESULTS["step3_qreg_1990"] = qr0.summary().as_text()

# ----------------------------- Robustness: quartiles ---------------------
print("\n=== ROBUSTNESS: Quartiles of Black w1985 ===")
black["w85_q"] = pd.qcut(
    black["composite_wealth_1985"], q=4,
    labels=["Q1_lowest", "Q2", "Q3", "Q4_highest"],
)
quart_levels = ["Q1_lowest", "Q2", "Q3", "Q4_highest"]
print("Black 1985 wealth quartile sizes:")
print(black["w85_q"].value_counts(dropna=False))

black["custom_stratum"] = black["w85_q"].astype(str)
sub6q = black.dropna(subset=["composite_wealth_1996"]).copy()
X6q = build_design(sub6q, "Q1_lowest", quart_levels)
ols6q = sm.OLS(sub6q["composite_wealth_1996"].astype(float), X6q).fit(cov_type="HC1")
print("OLS on w1996 by quartiles (Black):")
print(ols6q.summary().tables[1])
RESULTS["robust_ols_1996_quart"] = ols6q.summary().as_text()

qr6q = QuantReg(sub6q["composite_wealth_1996"].astype(float), X6q).fit(q=0.5, cov_type="HC1")
print("Median QReg on w1996 by quartiles (Black):")
print(qr6q.summary().tables[1])
RESULTS["robust_qreg_1996_quart"] = qr6q.summary().as_text()

# ----------------------------- Robustness: <0/0/>0 bucket ---------------
print("\n=== ROBUSTNESS: <0 / 0 / >0 bucket of Black w1985 ===")
black["w85_b"] = pd.cut(
    black["composite_wealth_1985"], bins=[-1e18, -0.5, 0.5, 1e18],
    labels=["neg_debt", "zero", "positive"]
)
print("Black 1985 bucket sizes:")
print(black["w85_b"].value_counts(dropna=False))

black["custom_stratum"] = black["w85_b"].astype(str)
sub6b = black.dropna(subset=["composite_wealth_1996"]).copy()
X6b = build_design(sub6b, "neg_debt", ["neg_debt", "zero", "positive"])
ols6b = sm.OLS(sub6b["composite_wealth_1996"].astype(float), X6b).fit(cov_type="HC1")
print("OLS on w1996 with <0/0/>0 buckets (Black):")
print(ols6b.summary().tables[1])
RESULTS["robust_ols_1996_bucket"] = ols6b.summary().as_text()

qr6b = QuantReg(sub6b["composite_wealth_1996"].astype(float), X6b).fit(q=0.5, cov_type="HC1")
print("Median QReg on w1996 with <0/0/>0 buckets (Black):")
print(qr6b.summary().tables[1])
RESULTS["robust_qreg_1996_bucket"] = qr6b.summary().as_text()

# ----------------------------- Cross-race reference ----------------------
print("\n=== CROSS-RACE REFERENCE (descriptive only) ===")
cr_rows = []
for r in ["black", "white", "hipanic"]:
    sub = df[df["race"] == r].copy()
    sub["dw96"] = sub["composite_wealth_1996"] - sub["composite_wealth_1985"]
    for j in [0, 1]:
        s2 = sub[sub["ever_jailed"] == j]
        cr_rows.append(dict(
            race=r, ever_jailed=j,
            N=s2.shape[0],
            jailed_share=float(s2.shape[0] / sub.shape[0]) if sub.shape[0] else np.nan,
            median_w1985=float(np.median(s2["composite_wealth_1985"])) if len(s2) else np.nan,
            median_w1996=float(np.median(s2["composite_wealth_1996"])) if len(s2) else np.nan,
            median_dw96=float(np.median(s2["dw96"])) if len(s2) else np.nan))
cr_df = pd.DataFrame(cr_rows)
print(cr_df.to_string(index=False))
RESULTS["crossrace_table"] = cr_df

# ----------------------------- Persist artefacts --------------------------
out_path = Path("/workspace/analysis_outputs.json")
out_path.write_text(json.dumps(
    {k: (v.to_dict(orient="records") if isinstance(v, pd.DataFrame) else v)
     for k, v in RESULTS.items()},
    indent=2, default=str))
print(f"\nWrote /workspace/analysis_outputs.json ({out_path.stat().st_size} bytes)")
print("\nDONE.")
