      "source": [
        "# Proportion of EE originals conducted in the UK\n\nSource: `data/meta-regression_study_data_heterogeneity_in_replication_projects.csv`.\n\nSubset: `project == 'ee'` (Experimental Economics). Numerator: rows with `experiment_country.o == 'United Kingdom'`. Denominator: rows in the EE subset (18 unique ids)."
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 1,
      "metadata": {},
      "source": [
        "import pandas as pd\n",
        "from statsmodels.stats.proportion import proportion_confint\n",
        "\n",
        "CSV = 'data/meta-regression_study_data_heterogeneity_in_replication_projects.csv'\n",
        "UK = 'United Kingdom'\n",
        "\n",
        "df = pd.read_csv(CSV)\n",
        "ee = df[df['project'] == 'ee'].copy()\n",
        "print('Total rows:', len(df))\n",
        "print('EE rows:', len(ee))\n",
        "print('Unique ids in EE:', ee['id'].nunique())\n",
        "print('Unique titles in EE:', ee['title'].nunique())\n",
        "print('Missing country in EE:', ee['experiment_country.o'].isna().sum())\n",
        "print('lab_id NaN in EE:', ee['lab_id'].isna().sum())\n"
      ],
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "Total rows: 927\n",
            "EE rows: 18\n",
            "Unique ids in EE: 18\n",
            "Unique titles in EE: 18\n",
            "Missing country in EE: 0\n",
            "lab_id NaN in EE: 18\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 2,
      "metadata": {},
      "source": [
        "print(ee['experiment_country.o'].value_counts(dropna=False).to_string())\n"
      ],
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "United States     11\n",
            "Germany            2\n",
            "Switzerland        2\n",
            "United Kingdom     1\n",
            "Australia          1\n",
            "Austria            1\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 3,
      "metadata": {},
      "source": [
        "n = len(ee)\n",
        "k = int((ee['experiment_country.o'] == UK).sum())\n",
        "p_hat = k / n\n",
        "wilson_lo, wilson_hi = proportion_confint(k, n, alpha=0.05, method='wilson')\n",
        "wald_lo,   wald_hi   = proportion_confint(k, n, alpha=0.05, method='normal')\n",
        "print(f'k = {k}, n = {n}, p_hat = {p_hat:.6f}  ({p_hat*100:.2f}%)')\n",
        "print(f'Wilson 95% CI: [{wilson_lo:.4f}, {wilson_hi:.4f}]  \u2192 [{wilson_lo*100:.2f}%, {wilson_hi*100:.2f}%]')\n",
        "print(f'Wald   95% CI: [{wald_lo:.4f}, {wald_hi:.4f}]  \u2192 [{wald_lo*100:.2f}%, {wald_hi*100:.2f}%]')\n"
      ],
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "k = 1, n = 18, p_hat = 0.055556  (5.56%)\n",
            "Wilson 95% CI: [0.0099, 0.2576]  \u2192 [0.99%, 25.76%]\n",
            "Wald   95% CI: [0.0000, 0.1614]  \u2192 [0.00%, 16.14%]\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 4,
      "metadata": {},
      "source": [
        "print('us_lab.o cross-tab in EE:')\n",
        "print(pd.crosstab(ee['experiment_country.o'], ee['us_lab.o'], margins=True, dropna=False).to_string())\n",
        "rows = []\n",
        "for flag in [0, 1]:\n",
        "    sub = ee[ee['us_lab.o'] == flag]\n",
        "    n_i = len(sub); k_i = int((sub['experiment_country.o'] == UK).sum())\n",
        "    p_i = k_i / n_i if n_i else float('nan')\n",
        "    w_lo, w_hi = proportion_confint(k_i, n_i, alpha=0.05, method='wilson') if n_i else (float('nan'), float('nan'))\n",
        "    rows.append((flag, n_i, k_i, p_i, w_lo, w_hi))\n",
        "for flag, n_i, k_i, p_i, w_lo, w_hi in rows:\n",
        "    print(f'us_lab.o={flag}  n={n_i}  k_UK={k_i}  p_hat={p_i*100:.2f}%  Wilson 95% CI [{w_lo*100:.2f}%, {w_hi*100:.2f}%]')\n"
      ],
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "us_lab.o cross-tab in EE:\n",
            "us_lab.o              0   1  All\n",
            "experiment_country.o            \n",
            "Australia             1   0    1\n",
            "Austria               1   0    1\n",
            "Germany               2   0    2\n",
            "Switzerland           2   0    2\n",
            "United Kingdom        1   0    1\n",
            "United States         0  11   11\n",
            "All                   7  11   18\n",
            "us_lab.o=0  n=7  k_UK=1  p_hat=14.29%  Wilson 95% CI [2.57%, 51.31%]\n",
            "us_lab.o=1  n=11  k_UK=0  p_hat=0.00%  Wilson 95% CI [0.00%, 25.88%]\n"
          ]
        }
      ]
    },
    {
      "cell_type": "code",
      "execution_count": 5,
      "metadata": {},
      "source": [
        "uk_ee = ee.loc[ee['experiment_country.o'] == UK, ['id','title','authors.o','experiment_country.o','experiment_country.r','us_lab.o','same_country']]\n",
        "print(uk_ee.to_string(index=False))\n"
      ],
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "   id                                                                                        title                                            authors.o experiment_country.o experiment_country.r  us_lab.o  same_country\n",
            "ee.13 Deferred compensation in multiperiod labor contracts: an experimental test of Lazear's model Steffen Huck and Andrew J. Seltzer and Brian Wallace       United Kingdom       United Kingdom         0             1\n"
          ]
        }
      ]
    },
    {
      "cell_type": "markdown",
      "metadata": {},
      "source": [
        "## Numerical summary\n\n- **Point estimate:** 1/18 = **0.0556 (5.56 %)**\n- **Wilson 95 % CI:** **[0.99 %, 25.76 %]**  (primary, robust in n peque\u00f1o)\n- **Wald 95 % CI:** **[0.00 %, 16.14 %]**  (reference only \u2014 Wald can bottom at 0 here)\n- **Desglose por us_lab.o (correcci\u00f3n al plan):**\n  - us_lab.o == 0 (no-US originals, n=7): **14.29 %**  Wilson 95 % CI [2.57 %, 51.31 %]\n  - us_lab.o == 1 (US originals, n=11): **0.00 %**  Wilson 95 % CI [0.00 %, 25.88 %]\n- **\u00danico original EE en UK:** `ee.13` (Huck, Seltzer & Wallace, 2013, *AER*; `same_country == 1`, replication tambi\u00e9n en UK).\n\n**Nota de cautela:** con n = 18 y k = 1, el IC Wilson es ancho (\u224825 pp). El estimador puntual es estable \u2014 exactamente el 5.56 % del EE sample \u2014 pero la inferencia de la *tasa poblacional* es necesariamente imprecisa.\n"
      ]
    }
