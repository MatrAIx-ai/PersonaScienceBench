"""Main analysis: per-domain Fisher-z paired comparison of original vs replication.

Inputs : data/meta-regression_joined_data_heterogeneity_in_replication_projects.csv
Outputs (in artifacts/):
  domain_summary.csv                per-domain paired diff summary (incl./excl. sign flips)
  raw_corr_crosscheck.csv           cross-check on raw ro, rr
  fiso_vs_fisr_scatter.svg          scatter with y=x reference, domain colors (stdlib SVG)
  headline.json                     structured numbers used by the handoff

Effect-size scale : Fisher-z (fiso, fisr), primary.
Sign handling     : main analysis KEEPS signed fiso/fisr; sign flips reported
                    both included and excluded.
relative_es       : ignored for headline (column is signed rr/ro, magnitude-unsafe
                    across sign-flip cases); discrepancy noted in the writeup.
"""
import json
import textwrap
import numpy as np
import pandas as pd
from pathlib import Path
from scipy.stats import wilcoxon

ROOT = Path(".")
DATA = ROOT / "data/meta-regression_joined_data_heterogeneity_in_replication_projects.csv"
ART = ROOT / "artifacts"
ART.mkdir(exist_ok=True)

RNG = np.random.default_rng(20251020)
NBOOT = 10_000
ALPHA = 0.05

df = pd.read_csv(DATA)
print(f"loaded {df.shape}")

df["delta_fis"] = df["fiso"] - df["fisr"]           # signed
df["sign_flip"] = (df["fisr"] < 0)                  # replication went opposite to original
print(f"sign-flip cases (fisr<0): {int(df['sign_flip'].sum())}")

def summarize(delta: np.ndarray, label: str) -> dict:
    n = len(delta)
    mean_ = float(np.mean(delta))
    median_ = float(np.median(delta))
    pct_pos = float((delta > 0).mean() * 100.0)
    if n > 1:
        idx = RNG.integers(0, n, size=(NBOOT, n))
        boot_means = delta[idx].mean(axis=1)
        lo, hi = np.percentile(boot_means, [100 * ALPHA / 2, 100 * (1 - ALPHA / 2)])
    else:
        lo = hi = mean_
    if n > 1 and np.any(delta != 0):
        w_stat, w_p = wilcoxon(delta, zero_method="wilcox", alternative="two-sided",
                               correction=False)
    else:
        w_stat = w_p = np.nan
    return dict(
        scope=label, n=n, mean_delta=mean_, mean_delta_ci_lo=float(lo),
        mean_delta_ci_hi=float(hi), median_delta=median_, pct_fiso_gt_fisr=pct_pos,
        wilcoxon_stat=float(w_stat) if not np.isnan(w_stat) else np.nan,
        wilcoxon_p=float(w_p) if not np.isnan(w_p) else np.nan,
    )

rows = []
for var_name, levels in [
    ("project.x", ["Psychology", "Experimental Economics"]),
    ("discipline", ["Cognitive", "Social", "Economics"]),
]:
    for lvl in levels:
        sub = df[df[var_name] == lvl]
        rows.append(summarize(sub["delta_fis"].to_numpy(), f"{var_name}={lvl} (incl. flips)"))
        sub2 = sub[~sub["sign_flip"]]
        rows.append(summarize(sub2["delta_fis"].to_numpy(), f"{var_name}={lvl} (excl. flips)"))
rows.append(summarize(df["delta_fis"].to_numpy(), "ALL (incl. flips)"))
rows.append(summarize(df.loc[~df["sign_flip"], "delta_fis"].to_numpy(), "ALL (excl. flips)"))

summary = pd.DataFrame(rows)
for c in ["mean_delta", "mean_delta_ci_lo", "mean_delta_ci_hi", "median_delta"]:
    summary[c] = summary[c].round(3)
summary["pct_fiso_gt_fisr"] = summary["pct_fiso_gt_fisr"].round(1)
summary[["wilcoxon_stat", "wilcoxon_p"]] = summary[["wilcoxon_stat", "wilcoxon_p"]].round(4)
summary.to_csv(ART / "domain_summary.csv", index=False)
print("\n--- per-domain paired Fisher-z diff summary ---")
print(summary.to_string(index=False))

# raw cross-check (ro - rr), signed; small table
df["delta_r"] = df["ro"] - df["rr"]
xc_rows = []
for var_name, level in [("project.x", "Psychology"), ("project.x", "Experimental Economics"),
                         ("discipline", "Cognitive"), ("discipline", "Social"),
                         ("discipline", "Economics")]:
    sub = df[df[var_name] == level]
    xc_rows.append({"group": f"{var_name}={level}", "n": len(sub),
                    "mean_ro": round(sub["ro"].mean(), 3),
                    "mean_rr": round(sub["rr"].mean(), 3),
                    "mean_ro_minus_rr": round(sub["delta_r"].mean(), 3)})
xc = pd.DataFrame(xc_rows)
xc.to_csv(ART / "raw_corr_crosscheck.csv", index=False)
print("\n--- raw correlation cross-check (ro - rr, signed) ---")
print(xc.to_string(index=False))

# ---------- stdlib SVG scatter: fiso (x) vs fisr (y) ----------
color_map = {"Cognitive": "#1f77b4", "Social": "#d62728", "Economics": "#2ca02c"}
W = H = 560
pad_l, pad_r, pad_t, pad_b = 70, 30, 60, 60
xmin, xmax = -0.06, float(max(df["fiso"].max(), df["fisr"].max())) + 0.10
def sx(v): return pad_l + (v - xmin) / (xmax - xmin) * (W - pad_l - pad_r)
def sy(v): return H - pad_b - (v - xmin) / (xmax - xmin) * (H - pad_t - pad_b)

svg = []
svg.append(f'<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 {W} {H}" '
           f'font-family="sans-serif" font-size="11">')
svg.append(f'<rect width="{W}" height="{H}" fill="white"/>')
svg.append(f'<text x="{W/2}" y="22" text-anchor="middle" font-size="14" '
           f'font-weight="bold">Original vs replication effect sizes (Fisher-z)</text>')
svg.append(f'<text x="{W/2}" y="40" text-anchor="middle" fill="#444">'
           f'points above y=x imply larger original; marker color = discipline</text>')
# axes
svg.append(f'<line x1="{pad_l}" y1="{H-pad_b}" x2="{W-pad_r}" y2="{H-pad_b}" stroke="black"/>')
svg.append(f'<line x1="{pad_l}" y1="{pad_t}"     x2="{pad_l}"    y2="{H-pad_b}" stroke="black"/>')
# gridlines & ticks
for v in np.arange(0.0, xmax + 1e-9, 0.2):
    x, y = sx(v), sy(v)
    svg.append(f'<line x1="{x}" y1="{H-pad_b}" x2="{x}" y2="{H-pad_b+4}" stroke="black"/>')
    svg.append(f'<line x1="{pad_l-4}" y1="{y}" x2="{pad_l}" y2="{y}" stroke="black"/>')
    svg.append(f'<text x="{x}" y="{H-pad_b+16}" text-anchor="middle">{v:.1f}</text>')
    svg.append(f'<text x="{pad_l-8}" y="{y+3}" text-anchor="end">{v:.1f}</text>')
# y=x reference line
svg.append(f'<line x1="{sx(xmin)}" y1="{sy(xmin)}" x2="{sx(xmax)}" y2="{sy(xmax)}" '
           f'stroke="#888" stroke-dasharray="5,4" stroke-width="1.4"/>')
# zero lines
svg.append(f'<line x1="{sx(0)}" y1="{H-pad_b}" x2="{sx(0)}" y2="{pad_t}" stroke="#ddd"/>')
svg.append(f'<line x1="{pad_l}" y1="{sy(0)}" x2="{W-pad_r}" y2="{sy(0)}" stroke="#ddd"/>')
# points
for d in ["Cognitive", "Social", "Economics"]:
    sub = df[df["discipline"] == d]
    for _, r in sub.iterrows():
        cx, cy = sx(r["fiso"]), sy(r["fisr"])
        svg.append(f'<circle cx="{cx:.1f}" cy="{cy:.1f}" r="5" fill="{color_map[d]}" '
                   f'fill-opacity="0.78" stroke="black" stroke-width="0.4"/>')
# axis labels
svg.append(f'<text x="{W/2}" y="{H-15}" text-anchor="middle">Original Fisher-z (fiso)</text>')
svg.append(f'<text x="18" y="{H/2}" text-anchor="middle" transform="rotate(-90 18 {H/2})">'
           f'Replication Fisher-z (fisr)</text>')
# legend
lx0 = pad_l + 10; ly0 = pad_t + 8
svg.append(f'<rect x="{lx0-6}" y="{ly0-6}" width="170" height="{20*3+10}" fill="white" '
           f'fill-opacity="0.9" stroke="#bbb"/>')
for i, d in enumerate(["Cognitive", "Social", "Economics"]):
    n = int((df["discipline"] == d).sum())
    yy = ly0 + 8 + i*20
    svg.append(f'<circle cx="{lx0+4}" cy="{yy}" r="5" fill="{color_map[d]}" '
               f'stroke="black" stroke-width="0.4"/>')
    svg.append(f'<text x="{lx0+16}" y="{yy+4}">{d} (n={n})</text>')
svg.append(f'<line x1="{lx0+4}" y1="{ly0+8+3*20}" x2="{lx0+24}" y2="{ly0+8+3*20}" '
           f'stroke="#888" stroke-dasharray="5,4"/>')
svg.append(f'<text x="{lx0+30}" y="{ly0+12+3*20}">y = x reference</text>')

svg.append('</svg>')
(ART / "fiso_vs_fisr_scatter.svg").write_text("\n".join(svg))
print("\nSVG scatter saved to artifacts/fiso_vs_fisr_scatter.svg")

# ---------- headline numbers for the handoff ----------
def get(scope):
    return summary[summary["scope"] == scope].iloc[0]

sfb = {**df[df["sign_flip"]].groupby("discipline").size().to_dict(),
       **{"_all": int(df["sign_flip"].sum())}}

headline = dict(
    Psychology=dict(
        n=int(get("project.x=Psychology (incl. flips)")["n"]),
        mean_delta=float(get("project.x=Psychology (incl. flips)")["mean_delta"]),
        mean_ci=(float(get("project.x=Psychology (incl. flaps)" if False else
                           "project.x=Psychology (incl. flips)")["mean_delta_ci_lo"]),
                 float(get("project.x=Psychology (incl. flips)")["mean_delta_ci_hi"])),
        median=float(get("project.x=Psychology (incl. flips)")["median_delta"]),
        pct_fiso_gt_fisr=float(get("project.x=Psychology (incl. flips)")["pct_fiso_gt_fisr"]),
        wilcoxon_p=float(get("project.x=Psychology (incl. flips)")["wilcoxon_p"]),
        n_excl_flips=int(get("project.x=Psychology (excl. flips)")["n"]),
        mean_delta_excl_flips=float(get("project.x=Psychology (excl. flips)")["mean_delta"]),
    ),
    ExperimentalEconomics=dict(
        n=int(get("project.x=Experimental Economics (incl. flips)")["n"]),
        mean_delta=float(get("project.x=Experimental Economics (incl. flips)")["mean_delta"]),
        mean_ci=(float(get("project.x=Experimental Economics (incl. flips)")["mean_delta_ci_lo"]),
                 float(get("project.x=Experimental Economics (incl. flips)")["mean_delta_ci_hi"])),
        median=float(get("project.x=Experimental Economics (incl. flips)")["median_delta"]),
        pct_fiso_gt_fisr=float(get("project.x=Experimental Economics (incl. flips)")["pct_fiso_gt_fisr"]),
        wilcoxon_p=float(get("project.x=Experimental Economics (incl. flips)")["wilcoxon_p"]),
    ),
    Cognitive=dict(
        n=int(get("discipline=Cognitive (incl. flips)")["n"]),
        mean_delta=float(get("discipline=Cognitive (incl. flips)")["mean_delta"]),
        median=float(get("discipline=Cognitive (incl. flips)")["median_delta"]),
        pct_fiso_gt_fisr=float(get("discipline=Cognitive (incl. flips)")["pct_fiso_gt_fisr"]),
        wilcoxon_p=float(get("discipline=Cognitive (incl. flips)")["wilcoxon_p"]),
    ),
    Social=dict(
        n=int(get("discipline=Social (incl. flips)")["n"]),
        mean_delta=float(get("discipline=Social (incl. flips)")["mean_delta"]),
        median=float(get("discipline=Social (incl. flips)")["median_delta"]),
        pct_fiso_gt_fisr=float(get("discipline=Social (incl. flips)")["pct_fiso_gt_fisr"]),
        wilcoxon_p=float(get("discipline=Social (incl. flips)")["wilcoxon_p"]),
    ),
    EconomicsDomain=dict(
        n=int(get("discipline=Economics (incl. flips)")["n"]),
        mean_delta=float(get("discipline=Economics (incl. flips)")["mean_delta"]),
        pct_fiso_gt_fisr=float(get("discipline=Economics (incl. flips)")["pct_fiso_gt_fisr"]),
        wilcoxon_p=float(get("discipline=Economics (incl. flips)")["wilcoxon_p"]),
    ),
    sign_flips_total=int(df["sign_flip"].sum()),
    sign_flips_by_project=json.loads(df[df["sign_flip"]].groupby("project.x").size().to_json()),
    sign_flips_by_discipline=json.loads(df[df["sign_flip"]].groupby("discipline").size().to_json()),
