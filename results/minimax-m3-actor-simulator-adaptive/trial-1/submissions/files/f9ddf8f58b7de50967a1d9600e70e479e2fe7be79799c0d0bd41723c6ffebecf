#!/usr/bin/env python3
"""
analysis.py — Marcus / electron-transfer reorganization-energy workflow.

Conventions (per the brief and the approved clarifications):
* All mass-weighted 21-DOF vectors and bases are reported in ascending
  ``site_id`` order.
* Forward  = B mapped into A's Cartesian frame; backward = A mapped into B.
* Signed displacements use source minus reference-target.
* Cross-frame overlap and transported-profile outputs are magnitude-based.
* 15 retained modes = drop the 6-dim rigid-body null space
  (eigenvalue tolerance 1e-6 eV/Ang^2).
* Rate prefactor = non-adiabatic Marcus-Dogonadze with
  hbar = 6.582119569e-16 eV*s, no tunnelling correction.
* lambda_total = lambda_inner_effective + lambda_outer,
  lambda_inner_effective = 0.5 * (lambda_nm_fwd + lambda_nm_bwd).
"""

import json
import os

import sys  # unused but kept for path manipulation in PIL imports
import numpy as np
import pandas as pd

# ───────────────────────── constants ─────────────────────────────
HBAR_EVS = 6.582119569e-16           # hbar  (eV*s)
KB_EV_PER_K = 8.617333262145e-5      # k_B (eV/K)
COULOMB_EV_A = 14.39964475           # e^2 / (4 pi eps_0)  (eV*Ang)
NULL_TOL_EV_A2 = 1.0e-6              # eigenvalue cutoff for null modes (eV/Ang^2)

DATA = "data"
RESULTS = "results"


def kabsch(P, Q):
    """Unweighted SVD Kabsch — find R, t so that R @ P.T + t ~= Q.T."""
    cP, cQ = P.mean(axis=0), Q.mean(axis=0)
    Pc, Qc = P - cP, Q - cQ
    H = Pc.T @ Qc
    U, _, Vt = np.linalg.svd(H)
    d = np.sign(np.linalg.det(Vt.T @ U.T))
    D = np.diag([1.0, 1.0, d])
    R = Vt.T @ D @ U.T
    t = cQ - R @ cP
    return R, t


def reorder_coords(X, order):
    """Permute (N, 3) coords from raw frame order into ascending site_id."""
    return X[order]


def reorder_hessian(H, order):
    """Permute the atom-block structure of a (3N, 3N) Hessian."""
    N = H.shape[0] // 3
    Hout = np.zeros_like(H)
    for si in range(N):
        for sj in range(N):
            Hout[3 * si:3 * si + 3, 3 * sj:3 * sj + 3] = (
                H[3 * order[si]:3 * order[si] + 3, 3 * order[sj]:3 * order[sj] + 3]
            )
    return Hout


def mw_transport(R, mu_sqrt, mu_inv_sqrt):
    """Build the mass-weighted transport operator T = M^{1/2} R M^{-1/2}.

    In our block-diagonal mass layout per atom (all 3 Cartesian DOFs of
    a given atom share the same mass), the per-atom block reduces to the
    Cartesian rotation itself; the 21x21 transport matrix is therefore
    block-diagonal with the 3x3 rotation R on each atom block.
    """
    N = mu_sqrt.size // 3
    T = np.zeros((3 * N, 3 * N))
    for i in range(N):
        # per-block: sqrt(m_i) I_3 * R * (1/sqrt(m_i)) I_3 = R
        T[3 * i:3 * i + 3, 3 * i:3 * i + 3] = R
    return T


def main():
    os.makedirs(RESULTS, exist_ok=True)

    st = pd.read_csv(os.path.join(DATA, "site_table.csv"))
    fso = pd.read_csv(os.path.join(DATA, "frame_site_order.csv"))
    manifest = json.load(open(os.path.join(DATA, "system_manifest.json")))
    medium = json.load(open(os.path.join(DATA, "medium_response.json")))
    grid_df = pd.read_csv(os.path.join(DATA, "driving_force_grid.csv"))

    xA_raw = np.load(os.path.join(DATA, "frame_a_coords.npy"))
    xB_raw = np.load(os.path.join(DATA, "frame_b_coords.npy"))
    HA_raw = np.load(os.path.join(DATA, "frame_a_hessian.npy"))
    HB_raw = np.load(os.path.join(DATA, "frame_b_hessian.npy"))

    assert xA_raw.shape == (7, 3) and xB_raw.shape == (7, 3)
    assert HA_raw.shape == (21, 21) and HB_raw.shape == (21, 21)

    site_ids = np.arange(7)
    order_a = (
        fso[fso.frame_id == "frame_a"].set_index("site_id").loc[site_ids, "row_index"].astype(int).values
    )
    order_b = (
        fso[fso.frame_id == "frame_b"].set_index("site_id").loc[site_ids, "row_index"].astype(int).values
    )

    xA = reorder_coords(xA_raw, order_a)
    xB = reorder_coords(xB_raw, order_b)
    HA = reorder_hessian(HA_raw, order_a)
    HB = reorder_hessian(HB_raw, order_b)
    assert np.allclose(HA, HA.T)
    assert np.allclose(HB, HB.T)
    assert int(manifest["null_rank"]) == 6 and int(manifest["resolved_rank"]) == 15

    masses = st.set_index("site_id").loc[site_ids, "mass_amu"].values.astype(float)
    mu = np.repeat(np.sqrt(masses), 3)
    mu_inv = 1.0 / mu
    M_imhalf = np.diag(mu_inv)

    R_b_in_a, t_b_in_a = kabsch(xB, xA)
    R_a_in_b, t_a_in_b = kabsch(xA, xB)
    xB_in_A = (R_b_in_a @ xB.T).T + t_b_in_a
    xA_in_B = (R_a_in_b @ xA.T).T + t_a_in_b
    rmsd_fwd = float(np.sqrt(np.mean(np.sum((xB_in_A - xA) ** 2, axis=1))))
    rmsd_bwd = float(np.sqrt(np.mean(np.sum((xA_in_B - xB) ** 2, axis=1))))

    delta_fwd = (xB_in_A - xA).flatten()
    delta_bwd = (xA_in_B - xB).flatten()
    delta_aligned = np.stack([delta_fwd, delta_bwd], axis=0)
    delta_mw = delta_aligned * mu[None, :]
    rigid_norm = np.linalg.norm(delta_mw, axis=1)

    HA_mw = M_imhalf @ HA @ M_imhalf
    HB_mw = M_imhalf @ HB @ M_imhalf
    eA, vecA = np.linalg.eigh(HA_mw)
    eB, vecB = np.linalg.eigh(HB_mw)

    def select_retained(evals, evecs, tol=NULL_TOL_EV_A2, want=15):
        keep = np.where(evals > tol)[0]
        if keep.size != want:
            keep = np.argsort(evals)[-want:]
        keep = np.sort(keep)
        return keep, evals[keep], evecs[:, keep]

    keepA, eigA, LA_mw = select_retained(eA, vecA)
    keepB, eigB, LB_mw = select_retained(eB, vecB)
    assert eigA.size == 15 and eigB.size == 15

    vibrational_basis_mw = np.stack([LA_mw, LB_mw], axis=0)

    T_fwd = mw_transport(R_b_in_a, mu, mu_inv)
    T_bwd = mw_transport(R_a_in_b, mu, mu_inv)
    assert np.isclose(np.linalg.det(T_fwd), 1.0, atol=1e-6)
    assert np.isclose(np.linalg.det(T_bwd), 1.0, atol=1e-6)

    raw_ov_fwd = LA_mw.T @ T_fwd @ LB_mw
    raw_ov_bwd = LB_mw.T @ T_bwd @ LA_mw
    mode_overlap = np.stack([np.abs(raw_ov_fwd), np.abs(raw_ov_bwd)], axis=0)

    proj_fwd = LA_mw @ (LA_mw.T @ delta_mw[0])
    proj_bwd = LB_mw @ (LB_mw.T @ delta_mw[1])
    proj_mw = np.stack([proj_fwd, proj_bwd], axis=0)
    proj_norm = np.linalg.norm(proj_mw, axis=1)

    ts00 = np.abs(LA_mw.T @ T_fwd @ LB_mw).sum(axis=1)
    ts01 = np.abs(LB_mw.T @ T_bwd @ LA_mw).sum(axis=1)
    ts10 = np.abs(LA_mw.T @ (T_fwd @ delta_mw[0]))
    ts11 = np.abs(LB_mw.T @ (T_bwd @ delta_mw[1]))
    transported_mode_projection = np.stack(
        [np.stack([ts00, ts10], axis=-1), np.stack([ts01, ts11], axis=-1)],
        axis=0,
    )

    amp_fwd = LA_mw.T @ delta_mw[0]
    amp_bwd = LB_mw.T @ delta_mw[1]
    energy_fwd = 0.5 * eigA * amp_fwd ** 2
    energy_bwd = 0.5 * eigB * amp_bwd ** 2

    def cumfrac(e):
        s = e.sum()
        return np.zeros_like(e) if s <= 0 else np.cumsum(e) / s

    mode_projection = np.stack(
        [
            np.stack([amp_fwd, energy_fwd, cumfrac(energy_fwd)], axis=-1),
            np.stack([amp_bwd, energy_bwd, cumfrac(energy_bwd)], axis=-1),
        ],
        axis=0,
    )

    lambda_4pt_fwd = 0.5 * float(delta_fwd @ HA @ delta_fwd)
    lambda_4pt_bwd = 0.5 * float(delta_bwd @ HB @ delta_bwd)
    lambda_nm_fwd = float(energy_fwd.sum())
    lambda_nm_backward = float(energy_bwd.sum())

    R_cav = float(medium["shell_0_A"])
    eps_op = float(medium["eps_fast"])
    eps_st = float(medium["eps_slow"])
    lambda_outer = float(COULOMB_EV_A / (2.0 * R_cav) * (1.0 / eps_op - 1.0 / eps_st))
    lambda_inner_eff = 0.5 * (lambda_nm_fwd + lambda_nm_backward)
    lambda_total = lambda_inner_eff + lambda_outer

    T = float(medium["temp_K"])
    H_DA = float(medium["coupling_eV"])
    kT_eV = KB_EV_PER_K * T
    prefactor = (2.0 * np.pi / HBAR_EVS) * (H_DA ** 2) / np.sqrt(4.0 * np.pi * lambda_total * kT_eV)
    k_self = float(prefactor * np.exp(-lambda_total / (4.0 * kT_eV)))

    axis_eV = grid_df["axis_eV"].to_numpy(dtype=float)
    grid_id = grid_df["grid_id"].to_numpy()
    barrier = (lambda_total + axis_eV) ** 2 / (4.0 * lambda_total * kT_eV)
    k_et = prefactor * np.exp(-np.minimum(barrier, 700.0))
    log10_k_et = np.log10(np.maximum(k_et, 1e-300))

    peak_idx = int(np.argmax(k_et))
    rate_peak_grid_id = int(grid_id[peak_idx])
    rate_peak_axis_eV = float(axis_eV[peak_idx])
    rate_peak_s_inv = float(k_et[peak_idx])
    ax_min, ax_max = float(axis_eV.min()), float(axis_eV.max())
    inverted_region_detected = bool(ax_min < rate_peak_axis_eV < ax_max)
    if inverted_region_detected:
        above = np.where(axis_eV > rate_peak_axis_eV)[0]
        first_idx = above[np.argmin(axis_eV[above])] if above.size else peak_idx
        first_inverted_grid_id = int(grid_id[first_idx])
        first_inverted_axis_eV = float(axis_eV[first_idx])
    else:
        first_inverted_grid_id = -1
        first_inverted_axis_eV = 0.0

    dom_fwd = int(np.argmax(np.abs(amp_fwd)))
    dom_bwd = int(np.argmax(np.abs(amp_bwd)))

    diagnostics = {
        "alignment_rmsd_forward_A": rmsd_fwd,
        "alignment_rmsd_backward_A": rmsd_bwd,
        "closure_error_forward_eV": abs(lambda_4pt_fwd - lambda_nm_fwd),
        "closure_error_backward_eV": abs(lambda_4pt_bwd - lambda_nm_backward),
        "effective_inner_consistency_eV": abs(lambda_nm_fwd - lambda_nm_backward),
        "rigid_norm_forward": float(rigid_norm[0]),
        "rigid_norm_backward": float(rigid_norm[1]),
        "projected_norm_forward": float(proj_norm[0]),
        "projected_norm_backward": float(proj_norm[1]),
        "dominant_mode_forward": dom_fwd,
        "dominant_mode_backward": dom_bwd,
        "rate_peak_grid_id": rate_peak_grid_id,
        "rate_peak_axis_eV": rate_peak_axis_eV,
        "rate_peak_s_inv": rate_peak_s_inv,
        "inverted_region_detected": inverted_region_detected,
        "first_inverted_grid_id": first_inverted_grid_id,
        "first_inverted_axis_eV": first_inverted_axis_eV,
    }

    lambda_summary = pd.DataFrame(
        [
            {
                "lambda_4pt_forward_eV": lambda_4pt_fwd,
                "lambda_4pt_backward_eV": lambda_4pt_bwd,
                "lambda_nm_forward_eV": lambda_nm_fwd,
                "lambda_nm_backward_eV": lambda_nm_backward,
                "lambda_inner_effective_eV": lambda_inner_eff,
                "lambda_outer_eV": lambda_outer,
                "lambda_total_eV": lambda_total,
                "k_self_exchange_s_inv": k_self,
            }
        ]
    )

    rate_curve = pd.DataFrame(
        {
            "grid_id": grid_id,
            "axis_eV": axis_eV,
            "k_et_s_inv": k_et,
            "log10_k_et_s_inv": log10_k_et,
        }
    )

    np.save(os.path.join(RESULTS, "aligned_displacement_mw.npy"), delta_mw)
    np.save(os.path.join(RESULTS, "vibrational_basis_mw.npy"), vibrational_basis_mw)
    np.save(os.path.join(RESULTS, "mode_overlap.npy"), mode_overlap)
    np.save(os.path.join(RESULTS, "projected_displacement_mw.npy"), proj_mw)
    np.save(os.path.join(RESULTS, "transported_mode_projection.npy"), transported_mode_projection)
    np.save(os.path.join(RESULTS, "mode_projection.npy"), mode_projection)
    lambda_summary.to_csv(os.path.join(RESULTS, "lambda_summary.csv"), index=False)
    rate_curve.to_csv(os.path.join(RESULTS, "rate_curve.csv"), index=False)
    with open(os.path.join(RESULTS, "diagnostics.json"), "w") as f:
        json.dump(diagnostics, f, indent=2, default=float)

    freqs_A = float(manifest["freq_scale_factor"]) * np.sqrt(np.clip(eigA, 0.0, None))
    freqs_B = float(manifest["freq_scale_factor"]) * np.sqrt(np.clip(eigB, 0.0, None))

    render_overview_png(
        os.path.join(RESULTS, 'overview.png'),
        freqs_A, freqs_B, mode_overlap, energy_fwd, energy_bwd,
        lambda_4pt_fwd, lambda_4pt_bwd, lambda_nm_fwd, lambda_nm_backward,
        lambda_inner_eff, lambda_outer, lambda_total,
        k_et, axis_eV, rate_peak_axis_eV, inverted_region_detected,
    )

    print("=== Marcus / ET reorganization analysis ===")
    print("aligned_displacement_mw.npy       :", delta_mw.shape)
    print("vibrational_basis_mw.npy          :", vibrational_basis_mw.shape)
    print("mode_overlap.npy                  :", mode_overlap.shape)
    print("projected_displacement_mw.npy     :", proj_mw.shape)
    print("transported_mode_projection.npy   :", transported_mode_projection.shape)
    print("mode_projection.npy               :", mode_projection.shape)
    print("lambda_summary.csv  cols          :", list(lambda_summary.columns))
    print("rate_curve.csv      rows          :", rate_curve.shape)
    print("diagnostics.json    keys          :", len(diagnostics))
    print("Kabsch RMSD fwd / bwd (A)         : %.6f / %.6f" % (rmsd_fwd, rmsd_bwd))
    print("lambda 4pt fwd / bwd (eV)         : %.6f / %.6f" % (lambda_4pt_fwd, lambda_4pt_bwd))
    print("lambda nm  fwd / bwd (eV)         : %.6f / %.6f" % (lambda_nm_fwd, lambda_nm_backward))
    print("lambda inner_eff (eV)             : %.6f" % lambda_inner_eff)
    print("lambda outer (Born, eV)           : %.6f" % lambda_outer)
    print("lambda total (eV)                 : %.6f" % lambda_total)
    print("k_self_exchange (s^-1)            : %.6e" % k_self)
    print("dominant mode fwd / bwd (0-14)    : %d / %d" % (dom_fwd, dom_bwd))
    print("rate peak DG (eV)                 : %.6f" % rate_peak_axis_eV)
    print("inverted_region_detected          :", inverted_region_detected)
    print("first_inverted_grid_id            :", first_inverted_grid_id)
    print("=== done ===")




def render_overview_png(path, freqs_A, freqs_B, mode_overlap, energy_fwd, energy_bwd,
                       lambda_4pt_fwd, lambda_4pt_bwd, lambda_nm_fwd, lambda_nm_bwd,
                       lambda_inner_eff, lambda_outer, lambda_total,
                       k_et, axis_eV, rate_peak_axis_eV, inverted_region_detected):
    """Hand-drawn 6-panel overview figure using PIL only (no matplotlib)."""
    sys.path.insert(0, "/usr/lib/python3/dist-packages")
    from PIL import Image, ImageDraw, ImageFont

    W, H = 1600, 1000
    margin, panel_h, panel_w = 40, 440, W // 3 - 25
    img = Image.new("RGB", (W, H + 60), "white")
    draw = ImageDraw.Draw(img)
    try:
        font = ImageFont.truetype("/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf", 13)
        title_font = ImageFont.truetype("/usr/share/fonts/truetype/dejavu/DejaVuSans-Bold.ttf", 14)
    except Exception:
        font = ImageFont.load_default()
        title_font = font

    def panel(x, y, w, h, title):
        draw.rectangle([x, y, x + w, y + h], outline="black", width=1)
        draw.text((x + 6, y + 4), title, fill="black", font=title_font)
        return x + 40, y + 36, w - 50, h - 50

    # ── panel 0: retained-mode frequencies (cm⁻¹) ─────────────────
    px, py, pw, ph = panel(margin, margin, panel_w, panel_h,
                            f"(a) Retained-mode frequencies (cm^-1)")
    ax = np.arange(15)
    fmax = max(freqs_A.max(), freqs_B.max(), 1.0)
    barw = pw / (15 * 2.5)
    for i, fa, fb in zip(ax, freqs_A, freqs_B):
        x0a = px + (i + 0.05) * (pw / 15)
        x0b = x0a + barw
        ha = py + ph - ph * fa / fmax
        hb = py + ph - ph * fb / fmax
        draw.rectangle([x0a, ha, x0a + barw, py + ph], fill="#3a78d8", outline="#3a78d8")
        draw.rectangle([x0b, hb, x0b + barw, py + ph], fill="#e07a36", outline="#e07a36")
    draw.line([px, py + ph, px + pw, py + ph], fill="black")
    draw.text((px, py + ph + 4), "mode", fill="black", font=font)
    draw.text((px - 32, py - 4), "A", fill="#3a78d8", font=title_font)
    draw.text((px - 32, py + 13), "B", fill="#e07a36", font=title_font)
    ticks_y = np.linspace(0, fmax, 4)
    for t in ticks_y:
        y = py + ph - ph * t / fmax
        draw.line([px - 4, y, px, y], fill="black")
    draw.text((4, py - 4), f"{fmax:.0f}", fill="black", font=font)

    # ── panels 1, 2: overlap heatmaps ───────────────────────────────
    for d in range(2):
        x0 = margin + (d + 1) * (panel_w + 25)
        label = "(b)" if d == 0 else "(c)"
        px, py, pw, ph = panel(x0, margin, panel_w, panel_h,
                                f"{label} |S|: {'A->A^T_fwd B' if d==0 else 'B->B^T_bwd A'}")
        cell = min(pw, ph) / 15.0
        for i in range(15):
            for j in range(15):
                v = float(mode_overlap[d, i, j])
                grey = int(255 * (1 - v))
                fill = (grey, grey, 255)
                x0c = px + j * cell
                y0c = py + i * cell
                draw.rectangle([x0c, y0c, x0c + cell, y0c + cell], fill=fill, outline=(180, 180, 220))
        draw.text((px, py + ph + 4),
                  "target row idx vs source col idx" if d == 1 else "source col idx 0-14",
                  fill="black", font=font)
        draw.text((px - 28, py + ph // 2 - 20), "target", fill="black", font=font)

    # ── panel 3: modal energy bar ──────────────────────────────────
    px, py, pw, ph = panel(margin, margin + panel_h + 30, panel_w, panel_h,
                            "(d) Modal reorg energy 0.5 lambda_k a_k^2 (eV)")
    emax = max(energy_fwd.max(), energy_bwd.max(), 1e-12)
    bw = pw / (15 * 2.5)
    for i, ef, eb in zip(ax, energy_fwd, energy_bwd):
        x0a = px + (i + 0.05) * (pw / 15)
        x0b = x0a + bw
        ha = py + ph - ph * ef / emax
        hb = py + ph - ph * eb / emax
        draw.rectangle([x0a, ha, x0a + bw, py + ph], fill="#3a78d8")
        draw.rectangle([x0b, hb, x0b + bw, py + ph], fill="#e07a36")
    draw.line([px, py + ph, px + pw, py + ph], fill="black")
    draw.text((px, py + ph + 4), "mode", fill="black", font=font)
    draw.text((px - 32, py - 4), "fwd", fill="#3a78d8", font=title_font)
    draw.text((px - 32, py + 13), "bwd", fill="#e07a36", font=title_font)

    # ── panel 4: rate curve (log axis) ─────────────────────────────
    x0 = margin + (panel_w + 25)
    px, py, pw, ph = panel(x0, margin + panel_h + 30, panel_w, panel_h,
                            "(e) k_et(ΔG°) at λ_total=%.3f eV" % lambda_total)
    order = np.argsort(axis_eV)
    a_s = axis_eV[order]
    k_s = k_et[order]
    if k_s.max() <= 0:
        return
    logk = np.log10(np.maximum(k_s, 1e-300))
    lmin, lmax = logk.min(), logk.max()
    if lmax - lmin < 1:
        lmax = lmin + 1.0
    xmin, xmax = a_s.min(), a_s.max()
    def to_px(a, k):
        return (px + (a - xmin) / (xmax - xmin) * pw, py + ph - (k - lmin) / (lmax - lmin) * ph)
    last = a_s[0], logk[0]
    for a, k in zip(a_s[1:], logk[1:]):
        x1, y1 = to_px(*last)
        x2, y2 = to_px(a, k)
        draw.line([x1, y1, x2, y2], fill="#1f77b4", width=2)
        last = a, k
    draw.text((px - 44, py - 4), f"10^{lmax:.0f}", fill="black", font=font)
    draw.text((px - 44, py + ph - 16), f"10^{lmin:.0f}", fill="black", font=font)
    # peak marker
    pkx, pky = to_px(rate_peak_axis_eV, np.log10(max(rate_peak_axis_eV ** 0 + 1.0, k_s.max())))
    pky = py + ph - (np.log10(max(k_s.max(), 1e-300)) - lmin) / (lmax - lmin) * ph
    draw.line([pkx, py, pkx, py + ph], fill="red", width=1)
    # axes
    draw.line([px, py + ph, px + pw, py + ph], fill="black")
    draw.line([px, py, px, py + ph], fill="black")
    for nt in np.linspace(lmin, lmax, 4):
        ty = py + ph - (nt - lmin) / (lmax - lmin) * ph
        draw.line([px - 4, ty, px, ty], fill="black")
    for t in np.linspace(xmin, xmax, 4):
        tx = px + (t - xmin) / (xmax - xmin) * pw
        draw.line([tx, py + ph, tx, py + ph + 4], fill="black")
        draw.text((tx - 16, py + ph + 6), f"{t:+.2f}", fill="black", font=font)
    draw.text((px + 4, py + 4), f"peak ΔG°={rate_peak_axis_eV:+.3f} eV",
              fill="red", font=title_font)
    draw.text((px, py + ph + 22), "ΔG° (eV)", fill="black", font=font)
    draw.text((px - 38, py - 12), "k_et (s^-1, log10)", fill="black", font=font)

    # ── panel 5: lambda summary bars ───────────────────────────────
    x0 = margin + 2 * (panel_w + 25)
    px, py, pw, ph = panel(x0, margin + panel_h + 30, panel_w, panel_h,
                            "(f) Reorganization energies (eV)")
    labels = ["4pt_fwd", "4pt_bwd", "nm_fwd", "nm_bwd", "inner", "outer", "total"]
    vals = [lambda_4pt_fwd, lambda_4pt_bwd, lambda_nm_fwd, lambda_nm_bwd,
            lambda_inner_eff, lambda_outer, lambda_total]
    colors = ["#1f77b4", "#ff7f0e", "#2ca02c", "#d62728", "#9467bd", "#8c564b", "#17becf"]
    vmax = max(vals + [1e-6])
    bw = pw / (len(vals) * 1.4)
    for i, (v, c) in enumerate(zip(vals, colors)):
        x0c = px + (i + 0.2) * (pw / len(vals))
        hgt = ph * v / vmax if vmax > 0 else 0
        draw.rectangle([x0c, py + ph - hgt, x0c + bw, py + ph], fill=c)
        draw.text((x0c, py + ph - hgt - 14), f"{v:.3f}", fill="black", font=font)
        draw.text((x0c - 4, py + ph + 5), labels[i], fill="black", font=font)
    draw.line([px, py + ph, px + pw, py + ph], fill="black")

    # footer
    draw.text((margin, H + 8),
              "Marcus / ET analysis -- λ_total = λ_inner_eff + λ_outer; "
              f"inverted_region_detected = {inverted_region_detected}",
              fill="black", font=font)
    img.save(path, "PNG", dpi=(130, 130))


if __name__ == "__main__":
