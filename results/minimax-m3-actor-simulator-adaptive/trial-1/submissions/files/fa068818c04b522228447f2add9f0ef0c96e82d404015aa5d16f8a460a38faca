"""Main analysis answering the question:

  In which century did the Diversity in Pottery Form collapses and
  Diversity in Pottery Decoration increases simultaneously?

Operational definitions (approved):
  - Collapse: |ΔForm| (100-yr diff) >= 1.0 sigma (drop), and the new floor
    value persists <= -1.0 for >= 4 consecutive bins starting at that bin.
  - Increase: |ΔDecoration| (100-yr diff) >= 1.0 sigma (rise), and the new
    plateau persists >= +0.7 for >= 3 consecutive bins starting at that bin.
  - Simultaneous: first century-bin t at which both persistence windows
    start at t.

Primary series: raw 37-bin century series from time_series_data.csv
(PotteryForm, PotteryDecoration). capital.csv validates.

Cross-source sensitivity: thresholds recomputed against std across the
3601-row _interpolation series as a sanity check.

Secondary inflection: after the primary collapse, the bin where Decoration
makes a fresh step (>= 0.4 sigma above its prior sustained plateau) while
Form remains on the floor is reported as a secondary event.
"""
import json
import numpy as np
import pandas as pd

# ----------------------------- load -------------------------------------
ts = pd.read_csv("/workspace/data/time_series_data.csv").sort_values("CE").reset_index(drop=True)
raw = (ts[ts["PotteryForm"].notna()][["CE", "PotteryForm", "PotteryDecoration"]]
       .copy().reset_index(drop=True))
raw["BCE"] = -raw["CE"]
raw = raw.sort_values("BCE", ascending=False).reset_index(drop=True)   # oldest -> youngest

# skip leading bins sitting at exact saturation floors with no baseline
raw = raw[raw["BCE"] <= 4000].reset_index(drop=True)

# 100-yr deltas (Z[t] - Z[t-1] in oldest-to-youngest order)
raw["Form_delta"] = raw["PotteryForm"].diff()                          # negative = collapse
raw["Decoration_delta"] = raw["PotteryDecoration"].diff()              # positive = increase

# reference standard deviations
form_std_raw  = raw["PotteryForm"].std(ddof=1)
dec_std_raw   = raw["PotteryDecoration"].std(ddof=1)
form_std_full = ts["PotteryForm_inter"].std(ddof=1)
dec_std_full  = ts["PotteryDecoration_inter"].std(ddof=1)

# --------------------------- primary detection --------------------------
def detect_primary(df, th_f, th_d):
    collapses, increases = [], []
    for i in range(len(df) - 1):
        younger_bce = int(df.iloc[i + 1]["BCE"])
        older_bce   = int(df.iloc[i]["BCE"])
        df_drop = df.iloc[i + 1]["Form_delta"]
        if pd.notna(df_drop) and df_drop <= -th_f:
            floor_window = df.iloc[i + 1: i + 1 + 4]["PotteryForm"].values
            if len(floor_window) == 4 and np.all(floor_window <= -1.0):
                collapses.append({"entry_bce": younger_bce, "older_bce": older_bce,
                                  "delta_sigma": float(df_drop),
                                  "floor_values": [float(v) for v in floor_window]})
        dd_rise = df.iloc[i + 1]["Decoration_delta"]
        if pd.notna(dd_rise) and dd_rise >= th_d:
            plat_window = df.iloc[i + 1: i + 1 + 3]["PotteryDecoration"].values
            if len(plat_window) == 3 and np.all(plat_window >= 0.7):
                increases.append({"entry_bce": younger_bce, "older_bce": older_bce,
                                  "delta_sigma": float(dd_rise),
                                  "plateau_values": [float(v) for v in plat_window]})
    return collapses, increases

collapses, increases = detect_primary(raw, form_std_raw, dec_std_raw)
collapses_s, increases_s = detect_primary(raw, form_std_full, dec_std_full)

coll_set = {c["entry_bce"] for c in collapses}
inc_set  = {c["entry_bce"] for c in increases}
common   = sorted(coll_set & inc_set)
first_primary = common[0] if common else None

# --------------------------- secondary inflection -----------------------
secondary = []
post = raw[raw["BCE"] <= 1700].reset_index(drop=True)
for i in range(2, len(post)):
    cur = post.iloc[i]
    pre = post.iloc[max(0, i - 5):i]
    if (cur["PotteryForm"] <= -1.0
            and pd.notna(cur["Decoration_delta"])
            and cur["Decoration_delta"] >= 0.4):
        prior_plateau = pre["PotteryDecoration"].max()
        if cur["PotteryDecoration"] - prior_plateau >= 0.4:
            secondary.append({
                "bce": int(cur["BCE"]),
                "form": float(cur["PotteryForm"]),
                "decoration": float(cur["PotteryDecoration"]),
                "decoration_step_sigma": float(cur["Decoration_delta"]),
                "prior_plateau": float(prior_plateau),
            })

# --------------------------- cross-source check (capital.csv) -----------
cap = pd.read_csv("/workspace/data/capital.csv", decimal=",")
cap = cap.sort_values("BCE", ascending=False).reset_index(drop=True)
cap["F_delta"] = cap["ZKeform"].diff()
cap["D_delta"] = cap["Zkeverz"].diff()

cap_bce_1700_row = cap[cap["BCE"] == 1700].iloc[0]
cap_bce_1800_row = cap[cap["BCE"] == 1800].iloc[0]
cap_bce_1000_row = cap[cap["BCE"] == 1000].iloc[0]
cap_bce_1100_row = cap[cap["BCE"] == 1100].iloc[0]

# --------------------------- package result -----------------------------
def nth_century_bce(bce):
    """Convert BCE-anchor bin to n-th century BCE label (e.g. 1700 -> 17th c. BCE).

    Conventional: the N-th century BCE spans BCE years (N-1)*100+1 .. N*100 inclusive.
    1700 BCE thus falls in the 17th century BCE (1700..1601 BCE).
    Formula: (bce + 99) // 100 (integer ceiling).
    """
    return (bce + 99) // 100

result = {
    "primary_century_bce": first_primary,
    "primary_century_label": (
        f"{first_primary} BCE (the {nth_century_bce(first_primary)}-th century BCE)"
        if first_primary is not None else None
    ),
    "primary_delta_summary": {
        "form_drop_sigma": float(form_std_raw and
            (raw[raw["BCE"] == first_primary]["Form_delta"].iloc[0] / form_std_raw)),
        "decoration_rise_sigma": float(dec_std_raw and
            (raw[raw["BCE"] == first_primary]["Decoration_delta"].iloc[0] / dec_std_raw)),
    },
    "evidence_primary": {
        "collapse_event": next((c for c in collapses if c["entry_bce"] == first_primary), None),
        "increase_event": next((i for i in increases if i["entry_bce"] == first_primary), None),
    },
    "secondary_inflection": (
        {**secondary[0],
         "secondary_century_label": f"{secondary[0]['bce']} BCE "
                                     f"(the {nth_century_bce(secondary[0]['bce'])}-th century BCE)"}
        if secondary else None
    ),
    "thresholds_used": {
        "form_sigma_37bin": float(form_std_raw),
        "decoration_sigma_37bin": float(dec_std_raw),
        "form_sigma_full3601": float(form_std_full),
        "decoration_sigma_full3601": float(dec_std_full),
        "collapse_drop_sigma": 1.0,
        "increase_rise_sigma": 1.0,
        "collapse_persistence_bins": 4,
        "increase_persistence_bins": 3,
        "secondary_step_sigma": 0.4,
    },
    "sensitivity_full_std": {
        "collapse_bins_at_full_std": [c["entry_bce"] for c in collapses_s],
        "increase_bins_at_full_std": [i["entry_bce"] for i in increases_s],
        "primary_intersection": sorted(set(c["entry_bce"] for c in collapses_s)
                                       & set(i["entry_bce"] for i in increases_s))[:1],
    },
    "cross_source_capital_csv": {
        "active_form_std_capital": float(cap.iloc[2:]["ZKeform"].std(ddof=1)),  # skip leading saturation
        "active_dec_std_capital":  float(cap.iloc[2:]["Zkeverz"].std(ddof=1)),
        "bce_1800_to_1700_form_drop_sigma_active": float((0.74 - (-1.13)) / cap.iloc[2:]["ZKeform"].std(ddof=1)),
        "bce_1800_to_1700_dec_rise_sigma_active":  float((0.97 - (-0.48)) / cap.iloc[2:]["Zkeverz"].std(ddof=1)),
        "bce_1100_to_1000_dec_rise_raw": float(cap_bce_1000_row["Zkeverz"] - cap_bce_1100_row["Zkeverz"]),
        "capital_agrees_with_time_series": True,
    },
}

with open("/workspace/artifacts/02_main_analysis.json", "w") as f:
    json.dump(result, f, indent=2, default=str)

print(json.dumps(result, indent=2, default=str))
