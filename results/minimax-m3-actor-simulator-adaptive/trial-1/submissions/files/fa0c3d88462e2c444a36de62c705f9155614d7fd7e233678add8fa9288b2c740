#!/usr/bin/env python3
"""B3 task: Go-model interacting-bead stochastic dynamics.

Independent BAOAB Langevin runs at each temperature in
parameters.json:temperature_list, re-initialized from the reference
configuration at every T. Order parameter Q is the deterministic
fraction of reference-derived native contacts preserved.

Outputs (11 files) next to this script. A side JSON payload lets
viz_render.py (PIL under /usr/bin/python3) build visualization.png.

Defaults (not in parameters.json; researcher-approved):
    EPS_NAT=1.0, K_BOND=100.0, EPS_REP=1.0, SIGMA_REP=1.0, SEED=0.
"""
import json, os, subprocess, sys
import numpy as np
from scipy.signal import find_peaks

# ----------------------- Load inputs --------------------------------------
data = np.load('data/target_coords.npy')
with open('data/parameters.json') as f:
    params = json.load(f)

N         = int(params['n_beads'])
friction  = float(params['friction'])
dt        = float(params['dt_reduced'])
temperatures = np.array(params['temperature_list'], dtype=float)
n_steps   = int(params['n_steps_per_T'])
cut       = float(params['contact_cutoff'])
minsep    = int(params['min_seq_separation'])
savint    = int(params['save_interval'])
K         = int(len(temperatures))

EPS_NAT, K_BOND, EPS_REP, SIGMA_REP, SEED = 1.0, 100.0, 1.0, 1.0, 0

# ----------------------- Pair classification ------------------------------
idx_i, idx_j, dist0 = [], [], []
for i in range(N):
    for j in range(i + 1, N):
        idx_i.append(i); idx_j.append(j)
        dist0.append(np.linalg.norm(data[i] - data[j]))
idx_i   = np.array(idx_i); idx_j = np.array(idx_j); dist0 = np.array(dist0)
is_bb   = (idx_j - idx_i) == 1
sep     = idx_j - idx_i
is_nat  = (~is_bb) & (sep >= minsep) & (dist0 < cut)
is_rep  = (~is_bb) & (~is_nat)
M_nat   = int(is_nat.sum())

nat_pairs = np.stack([idx_i[is_nat], idx_j[is_nat]], axis=1)
d0_nat    = dist0[is_nat]
ref_pairs_set = set((int(i), int(j)) for i, j in nat_pairs)

# ----------------------- Force + energy (Go model) -------------------------
D_FLOOR = 1e-2

def forces(x):
    r = x[idx_j] - x[idx_i]
    d = np.linalg.norm(r, axis=1)
    d_safe = np.maximum(d, D_FLOOR)
    ru = r / d_safe[:, None]
    fmag = np.zeros_like(d)
    if is_bb.any():
        fmag[is_bb] = -K_BOND * (d[is_bb] - dist0[is_bb])
    if is_nat.any():
        dn  = d[is_nat]
        sig = d0_nat / (2.0 ** (1.0 / 6.0))
        dUdd = 4.0 * EPS_NAT * (
            -12.0 * sig ** 12 / dn ** 13
            +  6.0 * sig ** 6  / dn ** 7
        )
        fmag[is_nat] = -dUdd
    if is_rep.any():
        dr = d[is_rep]
        fmag[is_rep] = 12.0 * EPS_REP * SIGMA_REP ** 12 / dr ** 13
    f = np.zeros_like(x)
    np.add.at(f, idx_j, fmag[:, None] * ru)
    np.add.at(f, idx_i, -fmag[:, None] * ru)
    return f

def potential(x):
    r = x[idx_j] - x[idx_i]; d = np.linalg.norm(r, axis=1)
    d_safe = np.maximum(d, D_FLOOR)
    E = 0.0
    if is_bb.any():
        E += 0.5 * K_BOND * np.sum((d[is_bb] - dist0[is_bb]) ** 2)
    if is_nat.any():
        dn = d[is_nat]; sig = d0_nat / (2.0 ** (1.0/6.0))
        ratio6 = (sig/dn)**6; ratio12 = ratio6**2
        E += 4.0 * EPS_NAT * np.sum(ratio12 - ratio6)
    if is_rep.any():
        E += EPS_REP * np.sum((SIGMA_REP / d[is_rep]) ** 12)
    return float(E)

def compute_Q(x):
    if M_nat == 0: return 0.0
    d = np.linalg.norm(x[nat_pairs[:,0]] - x[nat_pairs[:,1]], axis=1)
    return float(np.mean(d < cut))

# ----------------------- BAOAB --------------------------------------------
EXP_GDT = np.exp(-friction * dt)
SIG_OU  = np.sqrt(1.0 - EXP_GDT**2)

def baoab_step(x, v, T, rng):
    f = forces(x)
    v = v + 0.5 * dt * (f - friction * v)
    x = x + 0.5 * dt * v
    v = EXP_GDT * v + np.sqrt(T) * SIG_OU * rng.standard_normal(v.shape)
    x = x + 0.5 * dt * v
    f = forces(x)
    v = v + 0.5 * dt * (f - friction * v)
    return x, v

# ----------------------- Run all T ----------------------------------------
rng    = np.random.default_rng(SEED)
n_ckpt = n_steps // savint + 1   # 57505//250 + 1 = 231

Q_traj = np.zeros((K, n_ckpt))
E_traj = np.zeros((K, n_ckpt))
X_traj = np.zeros((K, n_ckpt, N, 3))

for k, T in enumerate(temperatures):
    x = data.copy()
    v = np.sqrt(T) * rng.standard_normal((N, 3))
    Q_traj[k, 0] = compute_Q(x)
    E_traj[k, 0] = potential(x)
    X_traj[k, 0] = x
    ck = 0
    for step in range(1, n_steps + 1):
        x, v = baoab_step(x, v, T, rng)
        if step % savint == 0:
            ck = step // savint
            Q_traj[k, ck] = compute_Q(x)
            E_traj[k, ck] = potential(x)
            X_traj[k, ck] = x
    print(f'[T={T:.4f}] ckpts={ck+1}, <Q>={Q_traj[k].mean():.4f}, '
          f'finalQ={Q_traj[k,-1]:.4f}, <E>={E_traj[k].mean():.4f}', flush=True)

# ----------------------- Output #1: final_coords.npy ----------------------
final_low = X_traj[0, -1]
np.save('final_coords.npy', final_low)

# ----------------------- Output #2: order_parameter_trajectory.npy --------
np.save('order_parameter_trajectory.npy', Q_traj)

# ----------------------- Output #3: order_parameter_histograms.npy --------
q_edges = np.linspace(0.0, 1.0, 51)
hist_q  = np.zeros((K, 50))
for k in range(K):
    h, _ = np.histogram(Q_traj[k], bins=q_edges)
    if h.sum() > 0:
        hist_q[k] = h / h.sum()
np.save('order_parameter_histograms.npy', hist_q)

# ----------------------- Output #5: temperature_observables.json -----------
mean_Q = Q_traj.mean(axis=1)
var_Q  = Q_traj.var(axis=1)
mean_E = E_traj.mean(axis=1)
var_E  = E_traj.var(axis=1)
C_direct = var_E / (temperatures ** 2)
q_e_corr = np.array(
    [float(np.corrcoef(Q_traj[k], E_traj[k])[0, 1]) for k in range(K)]
)
with open('temperature_observables.json', 'w') as fp:
    json.dump({
        'temperatures':             temperatures.tolist(),
        'mean_order_parameter_by_T': mean_Q.tolist(),
        'var_order_parameter_by_T':  var_Q.tolist(),
        'mean_energy_by_T':          mean_E.tolist(),
        'var_energy_by_T':           var_E.tolist(),
        'heat_capacity_direct_by_T': C_direct.tolist(),
        'q_energy_correlation_by_T': q_e_corr.tolist(),
    }, fp, indent=2)

# ----------------------- Output #4: heat_capacity_curve.npy ---------------
n_fine = 200
T_fine = np.linspace(float(temperatures.min()) * 0.7,
                      float(temperatures.max()) * 1.3, n_fine)
C_fine = np.interp(T_fine, temperatures, C_direct)
np.save('heat_capacity_curve.npy', np.vstack([T_fine, C_fine]))

# ----------------------- T* via linear interp -----------------------------
order_T  = np.argsort(temperatures)
T_sorted  = temperatures[order_T]
mQ_sorted = mean_Q[order_T]
# Linear interp on <Q>(T)=0.5; if bracketing T's don't enclose 0.5,
# extrapolate with the slope between the two closest adjacent points.
mQ_desc_full = mQ_sorted[::-1]
T_desc_full  = T_sorted[::-1]
T_star = float(np.interp(0.5, mQ_desc_full, T_desc_full))
extrapolated_T_star = False
if len(mQ_desc_full) >= 2:
    if (0.5 < min(mQ_desc_full)) or (0.5 > max(mQ_desc_full)):
        # Clamped: extrapolate with the slope of the closest two points on the side of extrapolation
        if 0.5 < min(mQ_desc_full):
            # need a T lower than min of T_desc — slope dT/d<Q> from upper two points
            i0, i1 = 0, 1
        else:
            i0, i1 = -2, -1
        dT_dQ = (T_desc_full[i1] - T_desc_full[i0]) / (mQ_desc_full[i1] - mQ_desc_full[i0])
        T_star = float(T_desc_full[i0] + dT_dQ * (0.5 - mQ_desc_full[i0]))
        extrapolated_T_star = True

# ----------------------- Output #6: free-energy profile at T* -------------
T_close_idx = int(np.argmin(np.abs(T_sorted - T_star)))
k_close     = int(order_T[T_close_idx])
T_close     = float(temperatures[k_close])
Q_close     = Q_traj[k_close]

hist_F, F_edges = np.histogram(Q_close, bins=np.linspace(0.0, 1.0, 51))
hist_F = hist_F.astype(float)
if hist_F.sum() > 0:
    hist_F /= hist_F.sum()
F_centers = 0.5 * (F_edges[:-1] + F_edges[1:])
mask = hist_F > 0
F_q = np.full_like(hist_F, fill_value=np.nan, dtype=float)
F_q[mask] = -T_star * np.log(hist_F[mask] / hist_F[mask].max())

peaks, _ = find_peaks(-F_q)
if len(peaks) >= 1:
    modes_q = F_centers[peaks]
else:
    modes_q = np.array([F_centers[int(np.argmax(hist_F))]])
if len(peaks) >= 3:
    top2 = sorted(peaks, key=lambda i: -hist_F[i])[:2]
    top2.sort()
    modes_q = F_centers[top2]

# Reuse the same extrapolation rule: mQ(T) at T_star
if T_star < T_sorted.min() or T_star > T_sorted.max():
    # extrapolate using last 2 points on relevant side
    if T_star < T_sorted.min():
        i0, i1 = 0, 1
    else:
        i0, i1 = -2, -1
    dmQ_dT = (mQ_sorted[i1] - mQ_sorted[i0]) / (T_sorted[i1] - T_sorted[i0])
    mean_Q_at_Tstar = float(mQ_sorted[i0] + dmQ_dT * (T_star - T_sorted[i0]))
else:
    mean_Q_at_Tstar = float(np.interp(T_star, T_sorted, mQ_sorted))
peak_hc = float(C_direct.max())

if len(modes_q) >= 2:
    mode_sep = float(abs(modes_q[-1] - modes_q[0]))
    i1 = int(np.argmin(np.abs(F_centers - modes_q[0])))
    i2 = int(np.argmin(np.abs(F_centers - modes_q[-1])))
    lo, hi = min(i1, i2), max(i1, i2)
    saddle = float(np.nanmax(F_q[lo:hi+1]))
    valleys, _ = find_peaks(F_q)
    fmodes = []
    for m in [modes_q[0], modes_q[-1]]:
        ic = int(np.argmin(np.abs(F_centers - m)))
        lo2, hi2 = max(0, ic-4), min(len(F_q), ic+5)
        cand = valleys[(valleys >= lo2) & (valleys <= hi2)]
        if len(cand):
            fmodes.append(float(F_q[cand[int(np.argmin(np.abs(F_centers[cand]-m)))]]))
        else:
            fmodes.append(float(F_q[ic]))
    barrier = max(0.0, (saddle - float(np.mean(fmodes))) / T_star)
    modes_out = [float(modes_q[0]), float(modes_q[-1])]
elif len(modes_q) == 1:
    mode_sep, barrier, modes_out = 0.0, 0.0, [float(modes_q[0])]
else:
    mode_sep, barrier, modes_out = 0.0, 0.0, [float(F_centers[int(np.argmax(hist_F))])]

F_save = F_q.copy(); F_save[np.isnan(F_save)] = 0.0
np.save('transition_free_energy_profile.npy', np.vstack([F_centers, F_save]))

# ----------------------- Reference vs final native-contact Jaccard --------
final_pairs_set = set()
for ii, jj in zip(idx_i, idx_j):
    if (jj - ii) >= minsep and not (jj - ii == 1):
        d = np.linalg.norm(final_low[ii] - final_low[jj])
        if d < cut:
            final_pairs_set.add((int(ii), int(jj)))
jaccard = float(len(ref_pairs_set & final_pairs_set) /
                max(len(ref_pairs_set | final_pairs_set), 1))

# ----------------------- Output #7: joint Q-z histograms (K,20,20) --------
hist_joint = np.zeros((K, 20, 20))
qbins = np.linspace(0.0, 1.0, 21); zbins = np.linspace(-3.0, 3.0, 21)
for k in range(K):
    Ek = E_traj[k]; mu, sd = Ek.mean(), Ek.std()
    if sd <= 0: sd = 1.0
    zk = (Ek - mu) / sd
    H, _, _ = np.histogram2d(Q_traj[k], zk, bins=[qbins, zbins])
    if H.sum() > 0: H = H / H.sum()
    hist_joint[k] = H
np.save('q_energy_joint_histograms.npy', hist_joint)

# ----------------------- Output #8: per-pair native p(K, M_nat) -----------
p_native = np.zeros((K, M_nat))
for k in range(K):
    X = X_traj[k]
    di = X[:, nat_pairs[:, 0], :]; dj = X[:, nat_pairs[:, 1], :]
    d = np.linalg.norm(di - dj, axis=2)
    p_native[k] = (d < cut).mean(axis=0)
np.save('native_contact_probability.npy', p_native)

# ----------------------- Output #9: transition_analysis.json -------------
warnings = [
    "Native well depth eps_nat=1.0, backbone spring k_backbone=100, "
    "non-native r^-12 prefactor=1.0 are researcher-approved DEFAULTS "
    "(not present in parameters.json).",
    "matplotlib unavailable in active venv and no network reach; "
    "visualization.png rendered through system /usr/bin/python3 "
    "(Pillow only) via subprocess.",
    "n_steps_per_T (57505) is not exactly divisible by save_interval "
    "(250); convention = drop remainder-5 tail. Trajectory shape "
    "(K, n_ckpt)=(6,231).",
    ("Independent re-initialization from reference at each T; "
     "T* via linear %s of <Q>(T)=0.5.") % (
        'extrapolation (boundary bracketing missed)' if extrapolated_T_star
        else 'interpolation',),
]
ta = {
    'transition_temperature':            float(T_star),
    'peak_heat_capacity':                float(peak_hc),
    'order_parameter_at_transition_mean': mean_Q_at_Tstar,
    'order_parameter_at_transition_modes': [float(m) for m in modes_out],
    'mode_separation':                   float(mode_sep),
    'free_energy_barrier_kT':            float(barrier),
    'reference_contact_jaccard':         float(jaccard),
    'warnings':                          warnings,
}
with open('transition_analysis.json', 'w') as fp:
    json.dump(ta, fp, indent=2)

# ----------------------- visualization.png via subprocess -----------------
viz_payload = {
    'final_coords_low':  final_low.tolist(),
    'ref_coords':        data.tolist(),
    'nat_pairs':         nat_pairs.tolist(),
    'backbone':          [[i, i + 1] for i in range(N - 1)],
    'temperatures':      temperatures.tolist(),
    'mean_Q':            mean_Q.tolist(),
    'var_Q':             var_Q.tolist(),
    'C_direct':          C_direct.tolist(),
    'T_fine':            T_fine.tolist(),
    'C_fine':            C_fine.tolist(),
    'hist_q':            hist_q.tolist(),
    'q_bin_centers':     (0.5 * (q_edges[:-1] + q_edges[1:])).tolist(),
    'F_centers':         F_centers.tolist(),
    'F_q':               F_save.tolist(),
    'T_star':            T_star,
    'T_close':           T_close,
    'transition_modes':  [float(m) for m in modes_out],
    'mode_separation':   float(mode_sep),
    'barrier_kT':        float(barrier),
    'jaccard':           float(jaccard),
    'p_native_mean':     p_native.mean(axis=0).tolist(),
    'p_native_low':      p_native[0].tolist(),
    'min_seq_separation': int(minsep),
}
with open('viz_data.json', 'w') as fp:
    json.dump(viz_payload, fp)

viz_script = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'viz_render.py')
print('Invoking viz_render.py under /usr/bin/python3 ...', flush=True)
res = subprocess.run(['/usr/bin/python3', viz_script, 'viz_data.json',
                      'visualization.png'], capture_output=True, text=True)
if res.returncode != 0:
    print('viz_render STDOUT:', res.stdout)
    print('viz_render STDERR:', res.stderr)
    raise RuntimeError('visualization.png build failed')
print('All artefacts written.')
