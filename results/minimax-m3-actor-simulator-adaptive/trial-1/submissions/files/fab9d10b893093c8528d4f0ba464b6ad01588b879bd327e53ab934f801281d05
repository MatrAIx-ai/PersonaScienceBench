import pandas as pd, numpy as np
df = pd.read_csv('/workspace/data/nls_ses_processed.csv', index_col=0)
df['BA_int'] = df['BA DEGREE COMPLETED'].astype(int)

# Two candidate cuts for the plan: pooled quartiles and pooled tertiles
df['SES_Q_pooled'] = pd.qcut(df['SES'], 4, labels=['Q1(Low)','Q2','Q3','Q4(High)'])
df['SES_T_pooled'] = pd.qcut(df['SES'], 3, labels=['T1(Low)','T2','T3(High)'])

def cell_table(strata):
    print(f"=== BA rate by SAMPLE_RACE × {strata} (cell n already shown; small-cell safeguard: cells n<30 marked) ===")
    g = df.groupby([strata,'SAMPLE_RACE'], observed=False)['BA_int'].agg(['size','sum','mean']).round(4)
    print(g)
    print()
    # Also print as wide pivot of rates
    wide_n = df.groupby([strata,'SAMPLE_RACE'], observed=False).size().unstack(fill_value=0)
    wide_r = df.groupby([strata,'SAMPLE_RACE'], observed=False)['BA_int'].mean().unstack().round(4)
    print('Pivot N (rows=SES bucket, cols=race):')
    print(wide_n)
    print('Pivot BA rate:')
    print(wide_r)

cell_table('SES_Q_pooled')
print()
cell_table('SES_T_pooled')
