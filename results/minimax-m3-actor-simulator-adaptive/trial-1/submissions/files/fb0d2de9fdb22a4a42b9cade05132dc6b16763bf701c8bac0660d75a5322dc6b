"""
DiscoveryBench episode test/nls_ses/metadata_8.json/0/0
Question: Between which two races is the factor of BA degree completion -0.9568
          when compared to the other?

Approach (per approved plan):
  1. Compute crude BA-completion rates + crude log-odds ratios per ordered pair.
  2. Fit an *unadjusted* logistic regression of BA on race with White=reference.
  3. Fit a *fully-adjusted* logistic regression adding SAMPLE_SEX, SES,
     FAMILY SIZE (centered), ABILITY (z-scored), PERCENTILE IN CLASS (z-scored).
  4. Pick the pair whose coefficient is closest to -0.9568; primary answer is the
     unadjusted model (study-level headline statistic).
"""
import numpy as np
import pandas as pd
import statsmodels.api as sm
from scipy import stats

df = pd.read_csv('/workspace/data/nls_ses_processed.csv')
df['BA_int'] = df['BA DEGREE COMPLETED'].astype(int)
print(f"Rows: {len(df)}; NaNs across columns: {df.isna().sum().sum()}")

# ----------------------- CRUDE TABLES ------------------------------------
print('\n========== CRUDE COUNTS ==========')
counts = df.groupby('SAMPLE_RACE')['BA_int'].agg(['sum', 'count', 'mean'])
counts.columns = ['k (BA=1)', 'n', 'p_hat']
counts['odds p/(1-p)'] = counts['p_hat'] / (1 - counts['p_hat'])
counts['SE(p)'] = np.sqrt(counts['p_hat']*(1-counts['p_hat'])/counts['n'])
print(counts.to_string())

print('\n========== CRUDE PAIRWISE = WHITE = REFERENCE ==========')
races = ['White', 'Black', 'Hispanic']
p = counts['p_hat']
k = counts['k (BA=1)']
n = counts['n']

def stand_log_or(k1,n1,k2,n2):
    # Standring 1996 2x2 log-OR with 0.5 continuity if needed
    if k1==0 or k2==0 or k1==n1 or k2==n2:
        k1,n1,k2,n2 = k1+0.5,n1+1,k2+0.5,n2+1
    return np.log((k1/(n1-k1))/(k2/(n2-k2)))

print(f"{'pair':35s} {'p_A':>9s} {'p_B':>9s} {'log OR (A vs B)':>18s}")
for A in races:
    for B in races:
        if A == B: continue
        lor = stand_log_or(k[A], n[A], k[B], n[B])
        print(f"{A+' vs '+B:35s} {p[A]:9.6f} {p[B]:9.6f} {lor:18.6f}")

# ----------------------- REGRESSION MODELS -------------------------------
# Reference = White. Dummies: Black, Hispanic (drop White).
df['is_Black']    = (df['SAMPLE_RACE'] == 'Black').astype(int)
df['is_Hispanic'] = (df['SAMPLE_RACE'] == 'Hispanic').astype(int)
df['is_Female']   = (df['SAMPLE_SEX']  == 'Female').astype(int)

# Centred / standardised versions of continuous controls
df['FAM_CTR']     = df['FAMILY SIZE OF SAMPLE']    - df['FAMILY SIZE OF SAMPLE'].mean()
df['ABILITY_Z']   = df['ABILITY: COMPOSITE OF ASVAB SCORE'].copy()
df['ABILITY_Z']   = (df['ABILITY_Z'] - df['ABILITY_Z'].mean()) / df['ABILITY_Z'].std(ddof=1)
df['PCTILE_Z']    = df['PERCENTILE IN CLASS'].copy()
df['PCTILE_Z']    = (df['PCTILE_Z'] - df['PCTILE_Z'].mean()) / df['PCTILE_Z'].std(ddof=1)

def fit_and_print(X, y, label):
    model = sm.GLM(y, sm.add_constant(X), family=sm.families.Binomial())
    res = model.fit()
    print(f"\n========== {label} ==========")
    print(f"N = {int(res.nobs)}, events = {int(y.sum())}, "
          f"deviance = {res.deviance:.3f}, Pearson chi2 = {res.pearson_chi2:.3f}")
    summary = pd.DataFrame({
        'coef'    : res.params,
        'std err' : res.bse,
        'z'       : res.params / res.bse,
        'p>|z|'   : 2*stats.norm.sf(np.abs(res.params / res.bse)),
        'CI2.5%'  : res.params - 1.959963984540054*res.bse,
        'CI97.5%' : res.params + 1.959963984540054*res.bse,
    })
    print(summary.to_string(float_format=lambda v: f'{v: .6f}'))
    return res

# (1) Unadjusted, race only
X_una = df[['is_Black', 'is_Hispanic']]
y = df['BA_int'].values
res_una = fit_and_print(X_una, y, '(1) UNADJUSTED — logit(P(BA=1)) ~ Black + Hispanic, ref = White')

# (2) Fully adjusted
X_adj = df[['is_Black', 'is_Hispanic', 'is_Female',
            'SES', 'FAM_CTR', 'ABILITY_Z', 'PCTILE_Z']]
res_adj = fit_and_print(X_adj, y, '(2) FULLY ADJUSTED — add female, SES, family size(ctr), ability(z), percentile(z), ref = White')

# ----------------------- MATCH TO -0.9568 -------------------------------
target = -0.9568
def dist(a, b): return abs(a - b)

cands = {
    'Unadjusted  beta_Black (Black vs White)'    : res_una.params['is_Black'],
    'Unadjusted  beta_Hispanic (Hispanic vs W.)' : res_una.params['is_Hispanic'],
    'Adjusted    beta_Black (Black vs White)'    : res_adj.params['is_Black'],
    'Adjusted    beta_Hispanic (Hispanic vs W.)' : res_adj.params['is_Hispanic'],
}
print(f"\n========== DISTANCES FROM TARGET {target} ==========")
for k,v in sorted(cands.items(), key=lambda kv: dist(kv[1], target)):
    print(f"  {k:50s} = {v: .6f}    |Δ| = {dist(v,target):.6f}")

# Resolve the pair
bB_u = res_una.params['is_Black'];    bH_u = res_una.params['is_Hispanic']
bB_a = res_adj.params['is_Black'];    bH_a = res_adj.params['is_Hispanic']
un_min = min([(bB_u,'Black','unadj'), (bH_u,'Hispanic','unadj')], key=lambda t: dist(t[0], target))
print(f"\nClosest unadjusted: {un_min[1]} vs White, coef = {un_min[0]:.6f}")
adj_min = min([(bB_a,'Black','adj'), (bH_a,'Hispanic','adj')], key=lambda t: dist(t[0], target))
print(f"Closest adjusted  : {adj_min[1]} vs White, coef = {adj_min[0]:.6f}")

# Final: prefer the unadjusted value (per researcher directive)
import json
final = {
    'pair'           : f"{un_min[1]} vs White",
    'model'          : 'unadjusted logistic regression of BA on race, White-reference',
    'coefficient'    : float(un_min[0]),
    'std_err'        : float(res_una.bse[f"is_{un_min[1]}"]),
    'p_value'        : float(res_una.pvalues[f"is_{un_min[1]}"]),
    'CI95'           : [float(res_una.conf_int().loc[f"is_{un_min[1]}",0]),
                         float(res_una.conf_int().loc[f"is_{un_min[1]}",1])],
    'n_White'        : int(n['White']),  'k_White' : int(k['White']),
    'n_'+un_min[1]   : int(n[un_min[1]]),
    'k_'+un_min[1]   : int(k[un_min[1]]),
    'p_White'        : float(p['White']),
    'p_'+un_min[1]   : float(p[un_min[1]]),
    'target'         : target,
}
print("\n========== FINAL CANDIDATE (PRIMARY = UNADJUSTED) ==========")
print(json.dumps(final, indent=2))
