"""
Black-subsample analysis: how does incarceration (ever_jailed, 1985-94)
affect Black NLS79 respondents' wealth (1985 -> 1996), stratified by a
proxy for 'income level' (tertiles of 1985 composite wealth within the
Black subsample). Descriptive — not causal — given selection into
incarceration and the binary, window-bounded ever_jailed measure.

Inputs:  /workspace/data/nls_incarceration_processed.csv
Outputs: /workspace/artifacts/cell_stats.csv
         /workspace/artifacts/ols_full_summary.txt
         /workspace/artifacts/ols_windorized_summary.txt
"""
import os, numpy as np, pandas as pd, statsmodels.api as sm
from statsmodels.formula.api import ols

df = pd.read_csv('data/nls_incarceration_processed.csv')
blk = df[df['race'] == 'black'].copy()

# Within-Black tertiles of baseline wealth. File's "hipanic" -> "hispanic"
# is a doc spelling drift treated as a typo in the write-up.
q33 = blk['composite_wealth_1985'].quantile(1/3)
q67 = blk['composite_wealth_1985'].quantile(2/3)
blk['tertile_1985'] = pd.cut(
    blk['composite_wealth_1985'],
    bins=[-np.inf, q33, q67, np.inf],
    labels=['T1_low', 'T2_mid', 'T3_high'],
    include_lowest=True)

blk['d_wealth_96_85'] = blk['composite_wealth_1996'] - blk['composite_wealth_1985']
blk['sex_male']       = (blk['sex'] == 'male').astype(int)
blk['zero_1985']      = (blk['composite_wealth_1985'] == 0).astype(int)
blk['zero_1996']      = (blk['composite_wealth_1996'] == 0).astype(int)

# Cell-size check: collapse rule if any cell < 30
ct = pd.crosstab(blk['tertile_1985'], blk['ever_jailed'])
min_cell = int(ct.values.min())
print(f"Cells (Black × tertile_1985 × ever_jailed): minimum n = {min_cell}")
# 39 -> no collapse applied.

def cell_stats(g):
    return pd.Series({
        'n'           : len(g),
        'med_1985'    : g['composite_wealth_1985'].median(),
        'med_1996'    : g['composite_wealth_1996'].median(),
        'mean_1985'   : g['composite_wealth_1985'].mean(),
        'mean_1996'   : g['composite_wealth_1996'].mean(),
        'zero_1985'   : g['zero_1985'].mean(),
        'zero_1996'   : g['zero_1996'].mean(),
        'delta_mean'  : g['d_wealth_96_85'].mean(),
    })

tbl = (blk.groupby(['tertile_1985', 'ever_jailed'], observed=True)
          .apply(cell_stats, include_groups=False).round(2))
tbl.to_csv('artifacts/cell_stats.csv')

# OLS: change in wealth 85 -> 96 on jail x tertile + sex
m = ols('d_wealth_96_85 ~ C(ever_jailed) * C(tertile_1985) + sex_male',
        data=blk).fit()

# Windorized robustness
p01_85, p99_85 = blk['composite_wealth_1985'].quantile([0.01, 0.99])
p01_96, p99_96 = blk['composite_wealth_1996'].quantile([0.01, 0.99])
blk['w_1985'] = blk['composite_wealth_1985'].clip(p01_85, p99_85)
blk['w_1996'] = blk['composite_wealth_1996'].clip(p01_96, p99_96)
blk['d_wealth_w'] = blk['w_1996'] - blk['w_1985']
m_w = ols('d_wealth_w ~ C(ever_jailed) * C(tertile_1985) + sex_male',
          data=blk).fit()

with open('artifacts/ols_full_summary.txt', 'w') as f:
    f.write("Model : d_wealth_1996_1985  ~  C(ever_jailed) * C(tertile_1985) + sex_male\n")
    f.write(f"Sample: race='black' (n={len(blk)}; ever_jailed 0/1 = "
            f"{(blk['ever_jailed']==0).sum()}/{(blk['ever_jailed']==1).sum()})\n")
    f.write(f"Tertile cutpoints (within-Black 1985 composite wealth): "
            f"{q33:.0f} / {q67:.0f}\n\n")
    f.write(m.summary().as_text())
    f.write("\n\nANOVA (Type II)\n")
    f.write(sm.stats.anova_lm(m, typ=2).round(4).to_string())

with open('artifacts/ols_windorized_summary.txt', 'w') as f:
    f.write("Robustness: same model, Δwealth windorized at 1st and 99th "
            "percentiles of each snapshot.\n\n")
    f.write(m_w.summary().as_text())
    f.write("\n\nANOVA (Type II)\n")
    f.write(sm.stats.anova_lm(m_w, typ=2).round(4).to_string())

print("Done — artifacts written.")
