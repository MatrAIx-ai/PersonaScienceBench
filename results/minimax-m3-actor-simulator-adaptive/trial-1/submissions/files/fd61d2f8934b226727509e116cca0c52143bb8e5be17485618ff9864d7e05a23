"""
DiscoveryBench task — average length of original papers in
Experimental Economics (project == 'ee') vs Psychology (project == 'rpp').

Decisions approved by the researcher:
  (a) Primary unit: unique original papers (collapse on title+authors.o+
      journal+pub_year — two rpp pairs rpp.148/.149 and rpp.49/.50 belong to
      the same original paper). Row-level (no-collapse) reported as a
      sensitivity row.
  (c) Default: exclude rows where drop == True; include them as a
      sensitivity row.
  (e) Headline answer is the project-level mean with a parallel discipline
      breakdown of Psychology (Social vs Cognitive).
  (f) No year filter; publish year range as descriptive context only.

Outputs:
  artifacts/results.json
  artifacts/length_summary.csv
  artifacts/hypothesis.txt
  artifacts/analysis.ipynb  (executed notebook, BixBench public contract)
"""

from __future__ import annotations
import json
from pathlib import Path
import numpy as np
import pandas as pd

ROOT = Path("/workspace")
DATA = ROOT / "data" / "meta-regression_study_data_heterogeneity_in_replication_projects.csv"
ART  = ROOT / "artifacts"
ART.mkdir(parents=True, exist_ok=True)

ORIG_KEY = ["title", "authors.o", "journal", "pub_year"]


def _length_stats(s: pd.Series) -> dict:
    s = pd.to_numeric(s, errors="coerce").dropna()
    if s.empty:
        return {"n": 0, "mean": None, "median": None,
                "std": None, "min": None, "max": None, "iqr": None}
    q1, q3 = s.quantile([0.25, 0.75])
    return {
        "n":      int(s.shape[0]),
        "mean":   float(s.mean()),
        "median": float(s.median()),
        "std":    float(s.std(ddof=1)) if len(s) > 1 else 0.0,
        "min":    float(s.min()),
        "max":    float(s.max()),
        "iqr":    float(q3 - q1),
    }


def _pack(name: str, df: pd.DataFrame, label: str,
          unique: bool) -> dict:
    """Compute per-segment summary.

    `unique` collapses on the original-paper key (title+authors+journal+pub_year)
    so each unique original paper contributes one length, regardless of how
    many replication pairs it spawned.
    """
    if unique:
        segment = df.drop_duplicates(subset=ORIG_KEY)
    else:
        segment = df
    stats = _length_stats(segment["length"])
    return {
        "scenario":      label,
        "group":         name,
        "n_rows":        int(segment.shape[0]),
        "n_unique":      int(df["id"].nunique()),
        "n_originals":   int(df.drop_duplicates(subset=ORIG_KEY).shape[0]),
        "year_min":      int(df["pub_year"].min()) if df["pub_year"].notna().any() else None,
        "year_max":      int(df["pub_year"].max()) if df["pub_year"].notna().any() else None,
        **stats,
    }


def main() -> None:
    df = pd.read_csv(DATA)
    print("Loaded:", df.shape)

    ee_all  = df[df["project"] == "ee"].copy()
    rpp_all = df[df["project"] == "rpp"].copy()

    # Drop==False filters (default)
    ee_k  = ee_all[ee_all["drop"] != True]
    rpp_k = rpp_all[rpp_all["drop"] != True]

    # Psychology discipline split (drop==False)
    rpp_soc = rpp_k[rpp_k["discipline"] == "Social"]
    rpp_cog = rpp_k[rpp_k["discipline"] == "Cognitive"]

    rows = [
        # ---- HEADLINE (unique originals, drop excluded) ----
        _pack("ee",  ee_k,  "headline_unique_Originals", unique=True),
        _pack("rpp", rpp_k, "headline_unique_Originals", unique=True),

        # ---- SENSITIVITY A: include-dropped rows ----
        _pack("ee",  ee_all,  "sensitivity_unique_includeDrops", unique=True),
        _pack("rpp", rpp_all, "sensitivity_unique_includeDrops", unique=True),

        # ---- SENSITIVITY B: row-level (no collapse) drop excluded ----
        _pack("ee",  ee_k,  "sensitivity_rowLevel_dropExcluded", unique=False),
        _pack("rpp", rpp_k, "sensitivity_rowLevel_dropExcluded", unique=False),

        # ---- PSYCHOLOGY DISCIPLINE BREAKDOWN ----
        _pack("rpp_Social",    rpp_soc, "psychology_discipline_unique", unique=True),
        _pack("rpp_Cognitive", rpp_cog, "psychology_discipline_unique", unique=True),

        # ---- context (other projects, not the question) ----
        _pack("ml1", df[df["project"] == "ml1"], "context_other_projects", unique=False),
        _pack("ml3", df[df["project"] == "ml3"], "context_other_projects", unique=False),
    ]

    summary = pd.DataFrame(rows)
    summary_path = ART / "length_summary.csv"
    summary.to_csv(summary_path, index=False)
    print("\n== length_summary.csv ==\n")
    print(summary.to_string(index=False))

    # Build headline payload
    headline = {
        "Experimental Economics": _pack("ee",  ee_k,  "headline", unique=True),
        "Psychology (all)":       _pack("rpp", rpp_k, "headline", unique=True),
    }
    psych_disp = {
        "Social":    _pack("rpp_Social",    rpp_soc, "psychology_discipline", unique=True),
        "Cognitive": _pack("rpp_Cognitive", rpp_cog, "psychology_discipline", unique=True),
    }
    sensitivity = {
        "includeDrops_unique_ee":  _pack("ee",  ee_all,  "sensitivity", unique=True),
        "includeDrops_unique_rpp": _pack("rpp", rpp_all, "sensitivity", unique=True),
        "rowLevel_dropExcluded_ee":  _pack("ee",  ee_k,  "sensitivity", unique=False),
        "rowLevel_dropExcluded_rpp": _pack("rpp", rpp_k, "sensitivity", unique=False),
    }

    payload = {
        "task":       "Average length of original papers: Experimental Economics vs Psychology",
        "decisions": {
            "unit":        "unique original papers (title+authors.o+journal+pub_year)",
            "drop_flag":   "excluded by default (drop==True); include-all reported as sensitivity",
            "year_window": "none applied",
            "breakdown":   "Plan A: project-level headline + Psychology discipline split",
        },
        "headline":                  headline,
        "psychology_by_discipline":  psych_disp,
        "sensitivity":               sensitivity,
        "table":                     rows,
    }
    (ART / "results.json").write_text(json.dumps(payload, indent=2, default=str))

    H = payload["headline"]
    P = payload["psychology_by_discipline"]
    S = payload["sensitivity"]
    ee_h  = H["Experimental Economics"]
    pp_h  = H["Psychology (all)"]
    pps   = P["Social"]
    ppc   = P["Cognitive"]

    hypothesis = (
        f"Original papers in Experimental Economics (project=='ee') average "
        f"{ee_h['mean']:.2f} pages (median {ee_h['median']:.1f}, sd {ee_h['std']:.2f}, "
        f"n={ee_h['n_originals']} unique originals from {ee_h['year_min']}-{ee_h['year_max']}). "
        f"Original papers in Psychology (project=='rpp') average "
        f"{pp_h['mean']:.2f} pages (median {pp_h['median']:.1f}, sd {pp_h['std']:.2f}, "
        f"n={pp_h['n_originals']} unique originals from {pp_h['year_min']}-{pp_h['year_max']}). "
        f"Within Psychology, Social originals (n={pps['n_originals']}) average "
        f"{pps['mean']:.2f} pages (median {pps['median']:.1f}) and Cognitive originals "
        f"(n={ppc['n_originals']}) average {ppc['mean']:.2f} pages (median {ppc['median']:.1f}); "
        f"both sub-disciplines remain below the Experimental Economics mean. "
        f"Sensitivity checks confirm the gap: including rows with the drop quality flag raises "
        f"the rpp mean to {S['includeDrops_unique_rpp']['mean']:.2f} "
        f"(n={S['includeDrops_unique_rpp']['n_originals']} unique originals), and using the "
        f"row-level sample (no de-duplication of repeat replication pairs) gives "
        f"{S['rowLevel_dropExcluded_rpp']['mean']:.2f} pages for rpp "
        f"(n rows={S['rowLevel_dropExcluded_rpp']['n_rows']}); ee is unchanged across "
        f"all scenarios because no ee row carries the drop flag and no ee original is repeated."
    )
    (ART / "hypothesis.txt").write_text(hypothesis)
    print("\n== hypothesis ==\n" + hypothesis)


if __name__ == "__main__":
    main()
