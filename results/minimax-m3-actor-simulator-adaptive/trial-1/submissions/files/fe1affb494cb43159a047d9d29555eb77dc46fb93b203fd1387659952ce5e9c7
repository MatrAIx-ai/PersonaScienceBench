"""analysis.py — NLSY79 incarceration x wealth (Black subsample) primary analysis."""
import json, numpy as np, pandas as pd
from pathlib import Path
RNG = np.random.default_rng(20261021)
ART = Path("/workspace/artifacts"); ART.mkdir(parents=True, exist_ok=True)
df = pd.read_csv("/workspace/data/nls_incarceration_processed.csv")
blk = df[df["race"]=="black"].copy().reset_index(drop=True)
print(f"[load] N total={len(df):,}; N black={len(blk):,}")
print(f"[load] black ever_jailed=1: {(blk['ever_jailed']==1).sum()} ({(blk['ever_jailed']==1).mean()*100:.2f}%)")
def assign_tier(w):
    if w <= 0: return "Tier1_low_or_debt"
    if w <= 10000: return "Tier2_modest"
    return "Tier3_higher"
blk["tier"] = blk["composite_wealth_1985"].apply(assign_tier)
blk["male"] = (blk["sex"]=="male").astype(int)
blk["dW_90"] = blk["composite_wealth_1990"] - blk["composite_wealth_1985"]
blk["dW_96"] = blk["composite_wealth_1996"] - blk["composite_wealth_1985"]
print("\n[tier] tier counts:\n", blk["tier"].value_counts().sort_index())
print("\n[tier x jail]:\n", pd.crosstab(blk["tier"], blk["ever_jailed"], margins=True))

# ---- 3. cell statistics ----
def cell_stats(sub, label):
    return {
        "cell": label,
        "n": int(len(sub)),
        "median_1985": float(sub["composite_wealth_1985"].median()),
        "median_1990": float(sub["composite_wealth_1990"].median()),
        "median_1996": float(sub["composite_wealth_1996"].median()),
        "mean_1985": float(sub["composite_wealth_1985"].mean()),
        "mean_1990": float(sub["composite_wealth_1990"].mean()),
        "mean_1996": float(sub["composite_wealth_1996"].mean()),
        "median_dW_85_90": float(sub["dW_90"].median()),
        "median_dW_85_96": float(sub["dW_96"].median()),
        "mean_dW_85_90": float(sub["dW_90"].mean()),
        "mean_dW_85_96": float(sub["dW_96"].mean()),
        "pct_female": float((sub["sex"]=="female").mean()*100),
    }
