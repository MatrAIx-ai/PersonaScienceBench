# ---- 10. Final corrected hypothesis (data-grounded) ----
# The data direction is: jail-penalty WIDENS with pre-existing wealth tier.
# This differs from a plausible "no effect at top" prior. We report honestly.
def G(t,col): return float(boot_df.loc[boot_df.tier==t,col].iloc[0])
H_final = (
