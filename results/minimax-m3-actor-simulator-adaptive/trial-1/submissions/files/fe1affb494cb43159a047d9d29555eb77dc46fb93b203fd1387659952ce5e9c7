    boot_hi = "boot_hi95_dW_85_90" if is_90 else "boot_hi95_dW_85_96"
    gap_mean = "gap_mean_dW_85_90" if is_90 else "gap_mean_dW_85_96"
    L = [f"# Within-Black cell statistics — {endpoint_label}\n\n"]
    L.append("Cells: `tier` (1985 wealth PROXY for income stratum) × `ever_jailed` (1985-1994).  \n")
    L.append("Income is NOT in the dataset; the tier is a labelled proxy.  \n\n")
    L.append("| tier | ever_jailed | n | median W_1985 | median W_1990 | median W_1996 | median Δwealth | mean Δwealth | pct_female |\n")
    L.append("|---|---|---|---|---|---|---|---|---|\n")
    for _, r in stats_df.iterrows():
        tier_lbl = r["cell"].split(" | ")[0]
        jlbl = r["cell"].split("=")[-1]
