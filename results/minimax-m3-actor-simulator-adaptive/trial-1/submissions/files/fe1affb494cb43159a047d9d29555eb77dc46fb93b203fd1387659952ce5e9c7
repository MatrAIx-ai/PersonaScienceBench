                 f"${r['median_1985']:,.0f} | ${r['median_1990']:,.0f} | ${r['median_1996']:,.0f} | "
                 f"${r[delta_med_col]:,.0f} | ${r[delta_mean_col]:,.0f} | {r['pct_female']:.1f}% |\n")
    L.append("\n## Within-tier jail − no-jail gap (Δwealth)\n\n")
    L.append("| tier | n_jailed ⚠n<30 flagged | n_notjailed | gap med Δ | boot 95% CI median | gap mean Δ |\n")
    L.append("|---|---|---|---|---|---|\n")
    for i, row in boot_df.iterrows():
        flag = " ⚠n<30" if row["n_jailed"] < 30 else ""
        L.append(f"| {row['tier']}{flag} | {int(row['n_jailed'])} | {int(row['n_notjailed'])} | "
                 f"${row[boot_med]:,.0f} | [${row[boot_lo]:,.0f}, ${row[boot_hi]:,.0f}] | "
                 f"${gaps_df.iloc[i][gap_mean]:,.0f} |\n")
    return "".join(L)

md_90 = md_table_cell(stats_df, gaps_df, boot_df,
