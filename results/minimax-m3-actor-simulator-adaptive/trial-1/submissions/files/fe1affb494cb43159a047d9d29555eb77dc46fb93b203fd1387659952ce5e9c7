for tier in ["Tier1_low_or_debt","Tier2_modest","Tier3_higher"]:
    for j in [0,1]:
        sub = blk[(blk["tier"]==tier) & (blk["ever_jailed"]==j)]
        rows.append(cell_stats(sub, f"{tier} | ever_jailed={j}"))
stats_df = pd.DataFrame(rows)

# ---- 4. within-tier jail-no-jail gap (no bootstrap yet) ----
def gap_stats(sub_j, sub_n):
    return {
        "n_jailed": len(sub_j), "n_notjailed": len(sub_n),
        "gap_mean_dW_85_90": float(sub_j["dW_90"].mean()-sub_n["dW_90"].mean()) if len(sub_j) and len(sub_n) else np.nan,
        "gap_mean_dW_85_96": float(sub_j["dW_96"].mean()-sub_n["dW_96"].mean()) if len(sub_j) and len(sub_n) else np.nan,
        "gap_med_dW_85_90": float(sub_j["dW_90"].median()-sub_n["dW_90"].median()) if len(sub_j) and len(sub_n) else np.nan,
        "gap_med_dW_85_96": float(sub_j["dW_96"].median()-sub_n["dW_96"].median()) if len(sub_j) and len(sub_n) else np.nan,
    }
gaps = []
for tier in ["Tier1_low_or_debt","Tier2_modest","Tier3_higher"]:
    sj = blk[(blk["tier"]==tier) & (blk["ever_jailed"]==1)]
    sn = blk[(blk["tier"]==tier) & (blk["ever_jailed"]==0)]
    g = gap_stats(sj, sn); g["tier"] = tier; gaps.append(g)
gaps_df = pd.DataFrame(gaps)

# ---- 5. bootstrap CIs for median gap ----
B = 1000
def boot_med_diff(j_pool, n_pool, B=B, rng=RNG):
    if len(j_pool)==0 or len(n_pool)==0: return (np.nan,np.nan,np.nan)
    diffs = np.empty(B)
    for b in range(B):
        bj = rng.choice(j_pool, size=len(j_pool), replace=True)
        bn = rng.choice(n_pool, size=len(n_pool), replace=True)
        diffs[b] = np.median(bj) - np.median(bn)
    return float(np.median(diffs)), float(np.percentile(diffs,2.5)), float(np.percentile(diffs,97.5))
boot_rows = []
for tier in ["Tier1_low_or_debt","Tier2_modest","Tier3_higher"]:
    sj = blk[(blk["tier"]==tier) & (blk["ever_jailed"]==1)]
    sn = blk[(blk["tier"]==tier) & (blk["ever_jailed"]==0)]
    m96, lo96, hi96 = boot_med_diff(sj["dW_96"].to_numpy(), sn["dW_96"].to_numpy())
    m90, lo90, hi90 = boot_med_diff(sj["dW_90"].to_numpy(), sn["dW_90"].to_numpy())
    boot_rows.append({
        "tier": tier, "n_jailed": len(sj), "n_notjailed": len(sn),
        "boot_med_dW_85_96": m96, "boot_lo95_dW_85_96": lo96, "boot_hi95_dW_85_96": hi96,
        "boot_med_dW_85_90": m90, "boot_lo95_dW_85_90": lo90, "boot_hi95_dW_85_90": hi90,
    })
boot_df = pd.DataFrame(boot_rows)

# ---- 6. Within-Black OLS: dW_1985->1996 ~ ever_jailed * tier + male ----
def fit_ols_with_bs(data, B=500, rng=RNG):
    y = data["dW_96"].to_numpy(dtype=float)
    X = np.column_stack([
        np.ones(len(data)),
        data["ever_jailed"].to_numpy(dtype=float),
        (data["tier"]=="Tier2_modest").astype(float).to_numpy(),
        (data["tier"]=="Tier3_higher").astype(float).to_numpy(),
        data["male"].to_numpy(dtype=float),
        (data["ever_jailed"]*(data["tier"]=="Tier2_modest")).astype(float).to_numpy(),
        (data["ever_jailed"]*(data["tier"]=="Tier3_higher")).astype(float).to_numpy(),
    ])
    coef_names = ["intercept","ever_jailed","Tier2_modest","Tier3_higher","male",
                  "ever_jailed_x_Tier2","ever_jailed_x_Tier3"]
    beta, *_ = np.linalg.lstsq(X, y, rcond=None)
    n = len(y)
    coefs = np.empty((B, X.shape[1]))
    for b in range(B):
        idx = rng.integers(0, n, size=n)
        coefs[b], *_ = np.linalg.lstsq(X[idx], y[idx], rcond=None)
    se = coefs.std(axis=0, ddof=1)
    lo = np.percentile(coefs, 2.5, axis=0)
    hi = np.percentile(coefs, 97.5, axis=0)
    return coef_names, beta, se, lo, hi
model_df = blk.dropna(subset=["dW_96","ever_jailed","tier","male"]).copy()
coef_names, beta, se, lo, hi = fit_ols_with_bs(model_df)
ols_df = pd.DataFrame({"term": coef_names, "coef": beta, "boot_SE": se,
                       "boot_lo95": lo, "boot_hi95": hi})
implied = {
    "Tier1_low_or_debt_ref": float(beta[1]),
    "Tier2_modest": float(beta[1] + beta[5]),
    "Tier3_higher": float(beta[1] + beta[6]),
}

