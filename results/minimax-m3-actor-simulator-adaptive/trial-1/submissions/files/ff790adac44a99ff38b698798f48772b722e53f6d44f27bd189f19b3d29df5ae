"""Initial inspection of nls_incarceration_processed.csv (descriptive only —
no hypothesis tests, no final answer). Used to brief the researcher before
the main analysis."""
import pandas as pd

PATH = "data/nls_incarceration_processed.csv"
df = pd.read_csv(PATH)

WEALTH = ["composite_wealth_1985", "composite_wealth_1990", "composite_wealth_1996"]

print("rows, cols :", df.shape)
print("dtypes     :\n", df.dtypes)
print("missing    :\n", df.isna().sum())

print("\nrace counts:\n", df["race"].value_counts(dropna=False))
print("\nsex counts :\n", df["sex"].value_counts(dropna=False))
print("\never_jailed counts:\n", df["ever_jailed"].value_counts(dropna=False))

print("\noverall wealth describe:\n", df[WEALTH].describe().T)

for c in WEALTH:
    g = df.groupby("ever_jailed")[c].agg(["count", "mean", "median", "std", "min", "max"])
    print(f"\n-- {c} by ever_jailed --\n{g}")

print("\nsex x ever_jailed:\n", pd.crosstab(df["sex"], df["ever_jailed"]))
print("\nrace x ever_jailed:\n", pd.crosstab(df["race"], df["ever_jailed"]))
print("\nrace x sex x ever_jailed:\n",
      pd.crosstab([df["race"], df["sex"]], df["ever_jailed"]))

print("\nDelta (jailed=0 minus jailed=1):")
ej0, ej1 = df[df["ever_jailed"] == 0], df[df["ever_jailed"] == 1]
for c in WEALTH:
    print(f"  {c}:  dmean={ej0[c].mean()-ej1[c].mean():,.0f}  "
          f"dmedian={ej0[c].median()-ej1[c].median():,.0f}")
