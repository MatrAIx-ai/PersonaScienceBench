def fit_logit(df_, bucket_col, drop_pctile=False):
    d = df_.copy()
    d['Black'] = (d['SAMPLE_RACE']=='Black').astype(int)
    d['Hispanic'] = (d['SAMPLE_RACE']=='Hispanic').astype(int)
    d['Female'] = (d['SAMPLE_SEX']=='Female').astype(int)
    d['Ability_z'] = (d['ABILITY: COMPOSITE OF ASVAB SCORE']-d['ABILITY: COMPOSITE OF ASVAB SCORE'].mean())/d['ABILITY: COMPOSITE OF ASVAB SCORE'].std()
    d['Pctile_z'] = (d['PERCENTILE IN CLASS']-d['PERCENTILE IN CLASS'].mean())/d['PERCENTILE IN CLASS'].std()
    d['FAM'] = d['FAMILY SIZE OF SAMPLE']
    buckets = sorted(d[bucket_col].dropna().unique())
    ref = buckets[0]
    for b in buckets:
        d[f'b_{b}'] = (d[bucket_col]==b).astype(int)
    ints=[]; main_b=[]
    for b in buckets:
        if b==ref: continue
        d[f'Black_x_{b}'] = d['Black']*d[f'b_{b}']
        d[f'Hisp_x_{b}'] = d['Hispanic']*d[f'b_{b}']
        ints += [f'Black_x_{b}', f'Hisp_x_{b}']
        main_b += [f'b_{b}']
    cols = ['Black','Hispanic','Female','Ability_z','Pctile_z','FAM'] + main_b + ints
    X = d[cols].astype(float)
    X = sm.add_constant(X)
    y = d['BA']
    if drop_pctile: X = X.drop(columns=['Pctile_z'])
    res = sm.Logit(y, X).fit(disp=False, maxiter=200)
    return res, X, y, buckets

