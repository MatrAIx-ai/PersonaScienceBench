def conditional_or(res, buckets):
    p = res.params; se = res.bse
    rows=[]
    for b in buckets:
        r = {'bucket': b}
        for race in ['Black','Hispanic']:
            col_main = race
            col_int = f'{race}_x_{b}' if b!=buckets[0] else None
            log_or = p.get(col_main, 0.0) + (p.get(col_int, 0.0) if col_int else 0.0)
            var_log_or = (se.get(col_main, 0.0))**2 + (se.get(col_int, 0.0))**2*(1.0 if col_int else 0.0)
            se_log_or = np.sqrt(var_log_or) if var_log_or>0 else np.nan
            OR = np.exp(log_or)
            lo = np.exp(log_or - 1.96*se_log_or) if not np.isnan(se_log_or) else np.nan
            hi = np.exp(log_or + 1.96*se_log_or) if not np.isnan(se_log_or) else np.nan
            r[f'OR_{race}'] = OR
            r[f'OR_{race}_lo'] = lo
            r[f'OR_{race}_hi'] = hi
            r[f'logit_{race}'] = log_or
            r[f'se_logit_{race}'] = se_log_or
            r[f'p_int_{race}'] = res.pvalues.get(col_int if col_int else col_main, np.nan)
        rows.append(r)
    return pd.DataFrame(rows)

