def wilson_ci(k, n, alpha=0.05):
    if n == 0: return (np.nan, np.nan)
    lo, hi = proportion_confint(k, n, alpha=alpha, method='wilson')
    return lo, hi

def fisher_pairwise(sub, a, bname):
    nA = int((sub['SAMPLE_RACE']==a).sum()); nB = int((sub['SAMPLE_RACE']==bname).sum())
    kA = int(sub.loc[sub['SAMPLE_RACE']==a,'BA'].sum()); kB = int(sub.loc[sub['SAMPLE_RACE']==bname,'BA'].sum())
    if min(nA, nB) == 0: return dict(a=a, b=bname, nA=nA, kA=kA, nB=nB, kB=kB, p=np.nan)
    table = [[kA, nA-kA], [kB, nB-kB]]
    _, p = stats.fisher_exact(table, alternative='two-sided')
    return dict(a=a, b=bname, nA=nA, kA=kA, nB=nB, kB=kB, p=p)

def bucket_table(df_, bucket_col):
    out = []
    for b in sorted(df_[bucket_col].dropna().unique()):
        sub = df_[df_[bucket_col]==b]
        for r in ['Black','Hispanic','White']:
            rsub = sub[sub['SAMPLE_RACE']==r]
            k = int(rsub['BA'].sum()); n = int(len(rsub))
            rate = k/n if n>0 else np.nan
            lo, hi = wilson_ci(k, n)
            out.append({'bucket': b, 'race': r, 'n': n, 'k_BA': k,
                        'rate': rate, 'wilson_lo': lo, 'wilson_hi': hi})
        ps = {}
        for a,bname in [('Black','White'),('Black','Hispanic'),('White','Hispanic')]:
            res = fisher_pairwise(sub, a, bname)
            ps[(a,bname)] = res['p']
        ps_bonf = {k: min(v*3, 1.0) for k, v in ps.items()}
        for (a,bname), pv in ps_bonf.items():
            out.append({'bucket': b, 'race': f'p_Bonf_{a}_vs_{bname}',
                        'n': np.nan, 'k_BA': np.nan, 'rate': np.nan,
                        'wilson_lo': np.nan, 'wilson_hi': np.nan, 'p_bonf': pv})
        for a,bname in [('Black','White'),('Black','Hispanic'),('White','Hispanic')]:
            nA = int((sub['SAMPLE_RACE']==a).sum()); nB=int((sub['SAMPLE_RACE']==bname).sum())
            df_bucket_b = sub[['SAMPLE_RACE','BA']].copy()
            boots_delta=[]; boots_rr=[]
            if nA>0 and nB>0:
                idx_a = df_bucket_b.index[df_bucket_b['SAMPLE_RACE']==a].to_numpy()
                idx_b = df_bucket_b.index[df_bucket_b['SAMPLE_RACE']==bname].to_numpy()
                for _ in range(2000):
                    sA = RNG.choice(idx_a, size=nA, replace=True)
                    sB = RNG.choice(idx_b, size=nB, replace=True)
                    pA = df_bucket_b.loc[sA,'BA'].mean()
                    pB = df_bucket_b.loc[sB,'BA'].mean()
                    boots_delta.append(pA - pB)
                    rr = (pA+1e-12)/(pB+1e-12); boots_rr.append(rr)
            d_lo, d_hi = np.nanpercentile(boots_delta, [2.5,97.5]) if boots_delta else (np.nan,np.nan)
            rr_lo, rr_hi = np.nanpercentile(boots_rr, [2.5,97.5]) if boots_rr else (np.nan,np.nan)
            kA = int(df_bucket_b.loc[df_bucket_b['SAMPLE_RACE']==a,'BA'].sum())
            kB = int(df_bucket_b.loc[df_bucket_b['SAMPLE_RACE']==bname,'BA'].sum())
            pA = kA/nA if nA else np.nan; pB = kB/nB if nB else np.nan
            d_obs = pA - pB; rr_obs = (pA+1e-12)/(pB+1e-12)
            out.append({'bucket': b, 'race': f'bootstrap_{a}_vs_{bname}',
                        'n': np.nan, 'k_BA': np.nan, 'rate': np.nan,
                        'wilson_lo': np.nan, 'wilson_hi': np.nan,
                        'delta_obs': d_obs, 'delta_lo': d_lo, 'delta_hi': d_hi,
                        'RR_obs': rr_obs, 'RR_lo': rr_lo, 'RR_hi': rr_hi})
    return pd.DataFrame(out)

