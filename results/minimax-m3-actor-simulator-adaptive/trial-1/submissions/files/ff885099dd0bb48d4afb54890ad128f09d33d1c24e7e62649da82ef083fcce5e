# SES elasticity (def B)
def ses_elasticity_q(race):
    sub = df[df['SAMPLE_RACE']==race]
    p_low = sub.loc[sub['SES_Q']=='Q1(Low)','BA'].mean()
    p_high = sub.loc[sub['SES_Q']=='Q4(High)','BA'].mean()
    return float(np.log((p_high+1e-12)/(p_low+1e-12))), float(p_low), float(p_high)

