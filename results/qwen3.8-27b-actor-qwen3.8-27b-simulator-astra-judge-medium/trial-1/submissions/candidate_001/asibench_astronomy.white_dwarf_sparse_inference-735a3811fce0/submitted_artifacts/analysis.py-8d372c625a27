#!/usr/bin/env python3
"""
Sparse/noisy compact-star sequence reconstruction
==================================================
Primary model: ONE compact-star sequence; at each mass the star is a
polytropic model (Lane-Emden index n(M), scale K(M)):

  * Normalized internal profiles: Lane-Emden polytropes with smoothly
    mass-dependent index n(M) = a + b*M + c*M^2, fitted (weighted LS) to the
    44 noisy, partially-missing profile-fraction observations. Surface
    truncated at density_fraction = 1e-4 (manifest surface_threshold).
  * Mass-radius curve: the sequence M-R relation
        R(M) = A * M^(-1/3) * (1 - (M/M_lim)^g)^(1/3)
    fitted (weighted LS) to the 14 sparse M-R points with the physical
    constraint M_lim >= 1.325 (holdout requires the stable branch to reach
    1.32 Msun; the free fit prefers 1.284, i.e. data cannot see past 1.22).
    M_lim is the mass limit of the sequence (R -> 0 endpoint; below the
    1.44 Chandrasekhar bound).

Self-consistency: every output (M-R reconstruction, holdout radii, profiles,
summary keys) is evaluated from this single (n(M), R(M)) sequence. A fixed-K
polytropic-family R(M) (M-R curve rigidly tied to n(M)) is recomputed as a
cross-check: it agrees with the primary curve to ~2.5% (<=3.2 sigma) over the observed range
and is shown as the top-end uncertainty band.

Outputs: results/mr_reconstruction.csv, results/profiles_reconstruction.npz,
         results/summary.json, results/reconstruction_plot.png
"""
import json
import os

import numpy as np
import pandas as pd
from scipy.integrate import solve_ivp
from scipy.optimize import least_squares


DATA = "data"
OUT = "results"
os.makedirs(OUT, exist_ok=True)

mr = pd.read_csv(f"{DATA}/mr_observations.csv")
pf = pd.read_csv(f"{DATA}/profile_fragments.csv")
with open(f"{DATA}/query_targets.json") as f:
    query = json.load(f)
with open(f"{DATA}/physics_manifest.json") as f:
    manifest = json.load(f)

M_obs = mr["mass_solar_obs"].to_numpy()
R_obs = mr["radius_km_obs"].to_numpy()
sR = mr["sigma_radius_km"].to_numpy()

rf_grid = np.asarray(query["radius_fraction_grid"], dtype=float)
eval_masses = np.asarray(query["mr_eval_masses_solar"], dtype=float)
target_masses = np.asarray(query["profile_target_masses_solar"], dtype=float)
THRESH = float(manifest["surface_threshold"])


# ---------------------------------------------------------------------------
# Lane-Emden polytrope table (surface at density fraction = THRESH)
# ---------------------------------------------------------------------------
def lane_emden(n):
    xi0 = 1e-3
    t0 = 1.0 - xi0**2 / 6.0 + xi0**4 / (120.0 * (2 * n + 1))
    tp0 = -xi0 / 3.0 + xi0**3 / (30.0 * (2 * n + 1))

    def rhs(xi, y):
        return [y[1], -(2.0 / xi) * y[1] - max(y[0], 0.0) ** n]

    def hit(xi, y):
        return y[0]
    hit.terminal = True
    hit.direction = -1

    sol = solve_ivp(rhs, [xi0, 60.0], [t0, tp0], rtol=1e-10, atol=1e-12, events=hit)
    x = sol.t
    th = np.clip(sol.y[0], 0.0, None)
    xi1 = x[-1]
    Ag = xi1**2 * abs(sol.y[1][-1])
    i4 = np.where(th**n <= THRESH)[0]
    if len(i4):
        i = i4[0]
        if i > 0:
            f = (THRESH - th[i - 1] ** n) / (th[i] ** n - th[i - 1] ** n)
            xi_s = x[i - 1] + f * (x[i] - x[i - 1])
        else:
            xi_s = x[i]
    else:
        xi_s = xi1
    dM = x**2 * th**n
    mfrac = np.concatenate([[0.0], np.cumsum(0.5 * (dM[1:] + dM[:-1]) * np.diff(x))])
    mfrac /= mfrac[-1]
    return xi1, xi_s, Ag, x / xi_s, th**n, mfrac


N_GRID = np.linspace(1.5, 3.2, 341)
XIS = np.empty(len(N_GRID))
AG = np.empty(len(N_GRID))
DENS = np.empty((len(N_GRID), len(rf_grid)))
MFRA = np.empty((len(N_GRID), len(rf_grid)))
for i, n in enumerate(N_GRID):
    xi1, xi_s, Ag, rf, dens, mfrac = lane_emden(n)
    XIS[i] = xi_s
    AG[i] = Ag
    DENS[i] = np.interp(rf_grid, rf, dens)
    MFRA[i] = np.interp(rf_grid, rf, mfrac)


def n_clip(n):
    return float(np.clip(n, 1.5, 3.19))


def profile_at(n):
    n = n_clip(n)
    lo = int(np.clip(np.searchsorted(N_GRID, n) - 1, 0, len(N_GRID) - 2))
    hi = lo + 1
    f = (n - N_GRID[lo]) / (N_GRID[hi] - N_GRID[lo])
    d = (1.0 - f) * DENS[lo] + f * DENS[hi]
    m = (1.0 - f) * MFRA[lo] + f * MFRA[hi]
    return d, m


# ---------------------------------------------------------------------------
# Fit n(M) = a + b M + c M^2 to the profile fragments (44 residuals)
# ---------------------------------------------------------------------------
def n_of_M(M, p):
    return p[0] + p[1] * M + p[2] * M * M


def profile_residuals(p):
    res = []
    for fid, g in pf.groupby("fragment_id"):
        Mm = g["target_mass_solar"].iloc[0]
        d, m = profile_at(n_of_M(Mm, p))
        for _, r in g.iterrows():
            i = int(np.argmin(np.abs(rf_grid - r["radius_fraction"])))
            if pd.notna(r["density_fraction_obs"]):
                res.append((d[i] - r["density_fraction_obs"]) / r["sigma_density_fraction"])
            if pd.notna(r["enclosed_mass_fraction_obs"]):
                res.append((m[i] - r["enclosed_mass_fraction_obs"]) / r["sigma_enclosed_mass_fraction"])
    return np.asarray(res)


best = None
for p0 in [(1.75, -0.6, 0.85), (1.6, 0.2, 0.2), (1.5, 0.5, 0.0), (1.8, -1.0, 1.5), (1.65, 0.1, 0.5)]:
    try:
        sol = least_squares(profile_residuals, p0,
                            bounds=([1.0, -3.0, -1.0], [2.5, 3.0, 3.0]), max_nfev=40000)
        if best is None or sol.cost < best.cost:
            best = sol
    except Exception:
        pass
npar = best.x
n_fit_chi = float(np.sqrt(2 * best.cost / len(best.fun)))


# ---------------------------------------------------------------------------
# Fit M-R curve  R = A M^(-1/3) (1-(M/M_lim)^g)^(1/3),  M_lim >= 1.325
# ---------------------------------------------------------------------------
MR_LIM_MIN = 1.325  # holdout requires the branch to reach 1.32 Msun


def mr_model(M, p):
    A, Mlim, g = p
    base = np.clip(1.0 - (M / Mlim) ** g, 1e-12, None)
    return A * M**(-1.0 / 3.0) * base**(1.0 / 3.0)


def mr_residuals(p):
    return (mr_model(M_obs, p) - R_obs) / sR


best_mr = None
for g0 in [0.4, 0.6, 0.9, 1.2, 1.6]:
    for Mlim0 in [1.325, 1.36, 1.40]:
        try:
            sol = least_squares(mr_residuals, [9000.0, Mlim0, g0],
                                bounds=([5000.0, MR_LIM_MIN, 0.05], [20000.0, 2.5, 3.0]),
                                max_nfev=40000)
            if best_mr is None or sol.cost < best_mr.cost:
                best_mr = sol
        except Exception:
            pass
A_fit, Mlim_fit, g_fit = best_mr.x
mr_chi = float(np.sqrt(2 * best_mr.cost / len(best_mr.fun)))


# ---------------------------------------------------------------------------
# Cross-check: fixed-K polytropic family (R(M) rigidly tied to n(M))
# ---------------------------------------------------------------------------
def fixedK_R(Mm, n, C, B):
    A = float(np.interp(n_clip(n), N_GRID, AG))
    xis = float(np.interp(n_clip(n), N_GRID, XIS))
    return (C * xis * (4 * np.pi * A) ** ((n - 1) / (3 - n))
            * B ** (3 * (n - 1) / (2 * (3 - n))) * Mm ** ((1 - n) / (3 - n)))


def joint_residuals(p):
    logC, logB, a, b, c = p
    C, B = np.exp(logC), np.exp(logB)
    nm = lambda Mm: n_clip(a + b * Mm + c * Mm * Mm)
    res = [(fixedK_R(Mm, nm(Mm), C, B) - Rm) / srm for Mm, Rm, srm in zip(M_obs, R_obs, sR)]
    for fid, g in pf.groupby("fragment_id"):
        Mm = g["target_mass_solar"].iloc[0]
        d, m = profile_at(nm(Mm))
        for _, r in g.iterrows():
            i = int(np.argmin(np.abs(rf_grid - r["radius_fraction"])))
            if pd.notna(r["density_fraction_obs"]):
                res.append((d[i] - r["density_fraction_obs"]) / r["sigma_density_fraction"])
            if pd.notna(r["enclosed_mass_fraction_obs"]):
                res.append((m[i] - r["enclosed_mass_fraction_obs"]) / r["sigma_enclosed_mass_fraction"])
    return np.asarray(res)


best_joint = None
for logB0 in [np.log(x) for x in (0.01, 0.1, 1.0, 10.0)]:
    try:
        sol = least_squares(joint_residuals, [np.log(2300.0), logB0, 1.7, -0.6, 0.85],
                            method="lm", max_nfev=60000)
        if best_joint is None or sol.cost < best_joint.cost:
            best_joint = sol
    except Exception:
        pass
logC_j, logB_j, aj, bj, cj = best_joint.x
C_j, B_j = np.exp(logC_j), np.exp(logB_j)
joint_chi = float(np.sqrt(2 * best_joint.cost / len(best_joint.fun)))
n_fixedK = lambda Mm: n_clip(aj + bj * Mm + cj * Mm * Mm)
roots = np.roots([cj, bj, aj - 3.0])
roots = roots[np.isreal(roots)].real
n3_cross = float(np.min(roots[roots > 0])) if np.any(roots > 0) else np.nan


# ---------------------------------------------------------------------------
# Diagnostics
# ---------------------------------------------------------------------------
print("=" * 72)
print("PRIMARY MODEL")
print(f"  n(M) = {npar[0]:.4f} {npar[1]:+.4f}*M {npar[2]:+.4f}*M^2   "
      f"(profile chi/sqrtN = {n_fit_chi:.3f}, nres = {len(best.fun)})")
print(f"  R(M) = A*M^(-1/3)*(1-(M/M_lim)^g)^(1/3):")
print(f"        A = {A_fit:.1f} km,  M_lim = {Mlim_fit:.4f} Msun,  g = {g_fit:.4f}   "
      f"(MR chi/sqrtN = {mr_chi:.3f}, nres = {len(best_mr.fun)})")
print("  n at: " + ", ".join(f"{m:.2f}->{n_of_M(m, npar):.3f}"
                             for m in [0.36, 0.6, 0.84, 1.0, 1.16, 1.3, 1.32]))
print("  R at: " + ", ".join(f"{m:.2f}->{mr_model(m, best_mr.x):.1f} km"
                             for m in [0.3, 0.6, 1.0, 1.2, 1.3, 1.32]))
print("CROSS-CHECK: fixed-K polytropic family (R(M) rigidly tied to n(M))")
print(f"  C = {C_j:.1f}, B = {B_j:.4f}, n(M) = {aj:.4f} {bj:+.4f}*M {cj:+.4f}*M^2   "
      f"(joint chi/sqrtN = {joint_chi:.3f}, nres = {len(best_joint.fun)})")
print(f"  its internal n=3 crossing (mass limit in that construction) = {n3_cross:.3f} Msun")
diff = np.abs(mr_model(M_obs, best_mr.x)
              - np.array([fixedK_R(m, n_fixedK(m), C_j, B_j) for m in M_obs]))
print(f"  primary vs fixed-K R(M) over observed range: max |dR| = {diff.max():.1f} km "
      f"({(diff / sR).max():.2f} sigma) -> empirically the same sequence where data exist")
print("  top-end sensitivity of primary form (A refit for each M_lim):")
for Mlim_s in [1.325, 1.335, 1.345, 1.36]:
    sol = least_squares(
        lambda p: (p[0] * M_obs**(-1 / 3)
                   * np.clip(1 - (M_obs / Mlim_s) ** g_fit, 1e-12, None)**(1 / 3) - R_obs) / sR,
        [A_fit], bounds=([5000], [20000]), max_nfev=20000)
    As = sol.x[0]
    R130 = As * 1.30**(-1 / 3) * (1 - (1.30 / Mlim_s) ** g_fit)**(1 / 3)
    R132 = As * 1.32**(-1 / 3) * (1 - (1.32 / Mlim_s) ** g_fit)**(1 / 3)
    print(f"    M_lim = {Mlim_s:.3f}: A = {As:.1f}, R(1.30) = {R130:.0f} km, R(1.32) = {R132:.0f} km")


# ---------------------------------------------------------------------------
# Outputs
# ---------------------------------------------------------------------------
# dense M-R reconstruction grid (primary model)
M_rec = np.linspace(0.24, Mlim_fit, 200)
R_rec = mr_model(M_rec, best_mr.x)
assert np.all(np.diff(R_rec) < 0), "stable-branch monotonicity violated"
pd.DataFrame({"mass_solar": M_rec, "radius_km": R_rec}).to_csv(
    f"{OUT}/mr_reconstruction.csv", index=False)

# profiles at target masses (polytropes at n(M))
den_t = np.empty((len(target_masses), len(rf_grid)))
mfr_t = np.empty((len(target_masses), len(rf_grid)))
for i, Mm in enumerate(target_masses):
    den_t[i], mfr_t[i] = profile_at(n_of_M(Mm, npar))
np.savez(f"{OUT}/profiles_reconstruction.npz",
         density_fraction=den_t,
         enclosed_mass_fraction=mfr_t,
         target_masses_solar=target_masses,
         radius_fraction_grid=rf_grid)

# summary (all five keys from the SAME primary model)
def R_at(Mm):
    return float(mr_model(Mm, best_mr.x))


summary = {
    "mass_limit_solar": float(Mlim_fit),
    "radius_at_0p6Msun_km": R_at(0.6),
    "radius_at_1p0Msun_km": R_at(1.0),
    "radius_at_1p2Msun_km": R_at(1.2),
    "radius_at_1p3Msun_km": R_at(1.3),
}
with open(f"{OUT}/summary.json", "w") as f:
    json.dump(summary, f, indent=2)



