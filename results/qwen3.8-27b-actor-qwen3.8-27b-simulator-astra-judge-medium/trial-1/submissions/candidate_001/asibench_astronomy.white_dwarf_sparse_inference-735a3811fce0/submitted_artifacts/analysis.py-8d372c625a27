class Canvas:
    def __init__(self, w, h, bg=(255, 255, 255)):
        self.w, self.h = w, h
        self.img = np.zeros((h, w, 3), np.uint8)
        self.img[:] = bg

    def px(self, x, y, color):
        x, y = int(round(x)), int(round(y))
        if 0 <= x < self.w and 0 <= y < self.h:
            self.img[y, x] = color

    def blend(self, x, y, color, alpha):
        x, y = int(round(x)), int(round(y))
        if 0 <= x < self.w and 0 <= y < self.h:
            self.img[y, x] = (alpha * np.asarray(color)
                              + (1 - alpha) * self.img[y, x].astype(float)).astype(np.uint8)

    def disk(self, x, y, r, color):
        for dy in range(-r, r + 1):
            for dx in range(-r, r + 1):
                if dx * dx + dy * dy <= r * r:
                    self.px(x + dx, y + dy, color)

    def line(self, x0, y0, x1, y1, color, width=1):
        x0, y0, x1, y1 = int(x0), int(y0), int(x1), int(y1)
        dx, dy = abs(x1 - x0), -abs(y1 - y0)
        sx = 1 if x0 < x1 else -1
        sy = 1 if y0 < y1 else -1
        err = dx + dy
        while True:
            for ox in range(-width // 2, width // 2 + 1):
                for oy in range(-width // 2, width // 2 + 1):
                    self.px(x0 + ox, y0 + oy, color)
            if x0 == x1 and y0 == y1:
                break
            e2 = 2 * err
            if e2 >= dy:
                err += dy
                x0 += sx
            if e2 <= dx:
                err += dx
                y0 += sy

    def text(self, x, y, s, color, scale=1):
        cx = int(x)
        for ch in s:
            g = FONT.get(ch, FONT[' '])
            for row in range(7):
                for col in range(5):
                    if g[row * 5 + col] == '1':
                        for sy_ in range(scale):
                            for sx_ in range(scale):
                                self.px(cx + col * scale + sx_, y + row * scale + sy_, color)
            cx += 6 * scale
        return cx


def text_width(s, scale=1):
    return len(s) * 6 * scale - scale


def save_png(path, cv):
    def chunk(tag, data):
        c = struct.pack(">I", len(data)) + tag + data
        return c + struct.pack(">I", zlib.crc32(tag + data) & 0xFFFFFFFF)
    raw = b"".join(b"\x00" + cv.img[y].tobytes() for y in range(cv.h))
    png = (b"\x89PNG\r\n\x1a\n"
           + chunk(b"IHDR", struct.pack(">IIBBBBB", cv.w, cv.h, 8, 2, 0, 0, 0))
           + chunk(b"IDAT", zlib.compress(raw, 9))
           + chunk(b"IEND", b""))
    with open(path, "wb") as f:
        f.write(png)


class Panel:
    """Axes panel with data->pixel mapping."""

    def __init__(self, cv, x0, y0, x1, y1, xmin, xmax, ymin, ymax,
                 xticks=None, yticks=None, xlabel="", ylabel="", title=""):
        self.cv = cv
        self.x0, self.y0, self.x1, self.y1 = x0, y0, x1, y1
        self.xmin, self.xmax, self.ymin, self.ymax = xmin, xmax, ymin, ymax

    def X(self, x):
        return self.x0 + (x - self.xmin) / (self.xmax - self.xmin) * (self.x1 - self.x0)

    def Y(self, y):
        return self.y1 - (y - self.ymin) / (self.ymax - self.ymin) * (self.y1 - self.y0)

    def axes(self, xticks, yticks, xlabel, ylabel, title, grid=True):
        c = self.cv
        c.line(self.x0, self.y0, self.x1, self.y0, (60, 60, 60), 2)
        c.line(self.x0, self.y1, self.x1, self.y1, (60, 60, 60), 2)
        c.line(self.x0, self.y0, self.x0, self.y1, (60, 60, 60), 2)
        c.line(self.x1, self.y0, self.x1, self.y1, (60, 60, 60), 2)
        for xt in xticks:
            px = self.X(xt)
            c.line(px, self.y1, px, self.y1 + 5, (60, 60, 60), 1)
            if grid:
                c.line(px, self.y0, px, self.y1, (225, 225, 225), 1)
            c.text(px - text_width(f"{xt:g}", 1) // 2, self.y1 + 8, f"{xt:g}", (90, 90, 90))
        for yt in yticks:
            py = self.Y(yt)
            c.line(self.x0 - 5, py, self.x0, py, (60, 60, 60), 1)
            if grid:
                c.line(self.x0, py, self.x1, py, (225, 225, 225), 1)
            c.text(self.x0 - 8 - text_width(f"{yt:g}", 1), py - 4, f"{yt:g}", (90, 90, 90))
        c.text((self.x0 + self.x1) // 2 - text_width(xlabel, 1) // 2, self.y1 + 24, xlabel, (40, 40, 40))
        ty = (self.y0 + self.y1) // 2 - text_width(ylabel, 1) // 2
        for i, ch in enumerate(ylabel):
            c.text(self.x0 - 34, ty + i * 7, ch, (40, 40, 40))
        if title:
            c.text((self.x0 + self.x1) // 2 - text_width(title, 1) // 2, self.y0 - 18, title, (20, 20, 20))

    def curve(self, xs, ys, color, width=2):
        for i in range(len(xs) - 1):
            self.cv.line(self.X(xs[i]), self.Y(ys[i]), self.X(xs[i + 1]), self.Y(ys[i + 1]), color, width)

    def scatter(self, xs, ys, color, r=3):
        for x, y in zip(xs, ys):
            self.cv.disk(self.X(x), self.Y(y), r, color)

    def errorbar(self, x, y, dy, color, r=3):
        px, py = self.X(x), self.Y(y)
        self.cv.line(px, self.Y(y - dy), px, self.Y(y + dy), color, 1)
        self.cv.line(px - 4, self.Y(y + dy), px + 4, self.Y(y + dy), color, 1)
        self.cv.line(px - 4, self.Y(y - dy), px + 4, self.Y(y - dy), color, 1)
        self.cv.disk(px, py, r, color)

    def fill_between(self, xs, ya, yb, color, alpha=0.25):
        for i in range(len(xs) - 1):
            x = xs[i]
            a = self.Y(min(ya[i], yb[i]))
            b = self.Y(max(ya[i], yb[i]))
            for yy in range(int(min(a, b)), int(max(a, b)) + 1):
                self.cv.blend(self.X(x), yy, color, alpha)

    def legend(self, x, y, items, scale=1):
        c = self.cv
        yy = y
        for label, color, style in items:
            if style == 'line':
                c.line(x, yy + 3, x + 22, yy + 3, color, 2)
            elif style == 'dash':
                for xx in range(x, x + 22, 6):
                    c.line(xx, yy + 3, min(xx + 3, x + 22), yy + 3, color, 2)
            elif style == 'dot':
                c.disk(x + 11, yy + 3, 3, color)
            c.text(x + 28, yy, label, (30, 30, 30), scale)
            yy += 14 * scale


