"""Directed gene regulatory network inference among 25 genes.

Two independent computational routes to directed, signed edges, then a
consensus combination:

  Method A (time-course based):
    Linear first-order dynamic (lag-1) model
        x(t+1) = A x(t) + c      (fitted per target gene, pooled over the
                                  5 independent replicates, correct
                                  within-replicate pairing)
    The discrete map A approximates I + dt*J, so the Jacobian is
        J_A = (A - I) / dt
    Off-diagonal J_A[i, j] > 0  =>  gene j activates gene i
    Off-diagonal J_A[i, j] < 0  =>  gene j represses gene i
    (convention: entry [i, j] = influence of gene j on gene i).

  Method B (steady-state based):
    Linear-response / perturbation factorization of the 15 steady-state
    deltas  D = J^{-1} U  (D: 25x15 gene x condition, J^{-1}: 25x25,
    U: 25x15 row-sparse perturbation inputs, 1-3 targets/condition).
    Alternating estimation: initialize U supports (largest-change /
    near-zero genes per condition), fit K = J^{-1} = D U^+ (ridge), then
    re-estimate each U column by L1 sparse coding in the columns of K.
    J_B = regularized (truncated-SVD) inverse of K.
    Fallback (if the loop does not converge / R2 < 0.7): per-gene ridge
    regression of each delta on the other deltas.

Combination:
    Each method's off-diagonal matrix is z-scored (zero mean, unit
    variance over the 600 off-diagonal entries) and the ensemble
    z_comb = (z_A + z_B) / 2 is formed.  The average rewards sign
    agreement (constructive) and cancels disagreement (destructive).
    Low-confidence entries are thresholded to exactly 0.0 so that the
    off-diagonal nonzero density falls in the required [5%, 40%] band.

Running this script regenerates all six output artifacts from data/.
"""
import json
import numpy as np

N_GENES = 25
TARGET_DENSITY = 0.10          # aim for ~10% off-diagonal density (in [5,40]%)
DENSITY_MIN, DENSITY_MAX = 0.05, 0.40
DIAG = {}


# ----------------------------------------------------------------------
# data
# ----------------------------------------------------------------------
def load_data():
  info = json.load(open("data/system_info.json"))
  ts = np.load("data/expression_timeseries.npy")
  ss = np.load("data/perturbation_steady_states.npy")
  return info, ts, ss


# ----------------------------------------------------------------------
# Method A: time-course linear lag-1 dynamic model
# ----------------------------------------------------------------------
def method_a(ts, dt):
  n_rep, n_t, n_g = ts.shape
  mu, sd = ts.reshape(n_rep, n_t, n_g).mean((0, 1)), \
      ts.reshape(n_rep, n_t, n_g).std((0, 1))
  Xc = (ts.reshape(n_rep, n_t, n_g) - mu) / sd
  Xprev = Xc[:, :-1].reshape(-1, n_g)
  Xnext = Xc[:, 1:].reshape(-1, n_g)
  src = np.column_stack([np.ones(len(Xprev)), Xprev])
  n, p = src.shape
  XtX_inv = np.linalg.inv(src.T @ src)

  A = np.zeros((n_g, n_g))
  se = np.zeros((n_g, n_g))
  r2 = np.zeros(n_g)
  for g in range(n_g):
    y = Xnext[:, g]
    beta = np.linalg.lstsq(src, y, rcond=None)[0]
    resid = y - src @ beta
    s2 = (resid ** 2).sum() / (n - p)
    r2[g] = 1 - (resid ** 2).sum() / ((y - y.mean()) ** 2).sum()
    A[g] = beta[1:]
    se[g] = np.sqrt(np.clip(np.diag(XtX_inv)[1:], 0, None) * s2)
  J_A = (A - np.eye(n_g)) / dt
  self_reg_all_neg = bool((np.diag(J_A) < 0).all())
  self_reg = np.diag(J_A).copy()
  np.fill_diagonal(J_A, 0.0)
  zA = J_A / np.where(se > 0, se, np.nan)

  # per-edge sign stability across the 5 independent replicate fits
  stab = np.zeros((n_g, n_g))
  for rep in range(n_rep):
    P = Xc[rep, :-1]
    N = Xc[rep, 1:]
    sr = np.column_stack([np.ones(n_t - 1), P])
    Ar = np.zeros((n_g, n_g))
    for g in range(n_g):
      Ar[g] = np.linalg.lstsq(sr, N[:, g], rcond=None)[0][1:]
    Jr = (Ar - np.eye(n_g)) / dt
    np.fill_diagonal(Jr, 0.0)
    stab += (np.sign(Jr) == np.sign(J_A))
  stab /= n_rep
  return {"J_A": J_A, "zA": zA, "r2": r2, "sign_stability": stab,
          "A_r2_mean": float(r2.mean()),
          "self_reg_all_negative": self_reg_all_neg,
          "self_reg": self_reg}


# ----------------------------------------------------------------------
# Method B: steady-state linear-response / sparse inverse-Jacobian
# ----------------------------------------------------------------------
def lasso_sparse_code(K, y, alpha=0.01, max_sweeps=4000, tol=1e-9):
  """L1 sparse coding: min_u 0.5||y - K u||^2 + (alpha/2)||u||_1,
  plain coordinate descent (deterministic, numpy only)."""
  n = K.shape[1]
  u = np.zeros(n)
  r = y.copy()
  cn = (K ** 2).sum(0)
  for _ in range(max_sweeps):
    md = 0.0
    for j in range(n):
      rho = K[:, j] @ r + cn[j] * u[j]
      un = np.sign(rho) * max(abs(rho) - alpha / 2.0, 0.0)
      if cn[j] > 0:
        un /= cn[j]
      if un != u[j]:
        r += K[:, j] * (u[j] - un)
        md = max(md, abs(un - u[j]))
        u[j] = un
    if md < tol:
      break
  return u


def _initial_supports(dX, base, k_max=3, rel_cut=0.25):
  supports = []
  for r in range(dX.shape[0]):
    rel = np.abs(dX[r]) / base
    order = np.argsort(-rel)
    s = [int(j) for j in order if rel[j] > rel_cut][:k_max]
    supports.append(s or [int(order[0])])
  return supports


def _fit_K_from_U(dX, U):
  G = U @ U.T
  G = G + 1e-2 * (G.trace() / dX.shape[0]) * np.eye(dX.shape[0])
  return (U.T @ np.linalg.inv(G) @ dX).T


def fit_inverse_jacobian(dX, base, max_iter=30, k_max=3, lasso_alpha=0.01):
  """Alternating U/K. Returns K, history(list of r2), supports."""
  ncond, n_g = dX.shape
  ss_tot = ((dX - dX.mean(0)) ** 2).sum()
  supports = _initial_supports(dX, base, k_max)
  history = []
  K = None
  for _ in range(max_iter):
    U = np.zeros((ncond, n_g))
    for r in range(ncond):
      U[r, supports[r]] = dX[r, supports[r]]
    K = _fit_K_from_U(dX, U)
    pred = U @ K.T
    r2 = 1 - ((dX - pred) ** 2).sum() / ss_tot
    history.append(r2)
    new_sup = []
    for r in range(ncond):
      co = lasso_sparse_code(K, dX[r], alpha=lasso_alpha)
      idx = np.argsort(-np.abs(co))[:k_max]
      keep = idx[np.abs(co[idx]) > 1e-3 * max(np.abs(co).max(), 1e-12)]
      new_sup.append(sorted(int(j) for j in keep) or [int(idx[0])])
    if new_sup == supports:
      break
    supports = new_sup
  converged = new_sup == supports
  return K, history, supports, converged


def fit_inverse_fallback(dX, base):
  """Per-gene ridge: regress each gene's delta on the other genes' deltas
  (linear-response steady-state model). Returns K-like matrix + r2."""
  n_g = dX.shape[1]
  K = np.zeros((n_g, n_g))
  r2s = []
  for i in range(n_g):
    y = dX[:, i]
    Xo = np.delete(dX, i, axis=1)
    lam = 1.0
    A_ = np.column_stack([Xo, np.ones(len(Xo))])
    w = np.linalg.solve(A_.T @ A_ + lam * np.eye(A_.shape[1]), A_.T @ y)
    pred = A_ @ w
    r2s.append(1 - ((y - pred) ** 2).sum() / ((y - y.mean()) ** 2).sum())
    K[i, np.delete(np.arange(n_g), i)] = w[:n_g - 1]
  r2 = float(np.mean(r2s))
  return K, [r2], None


def regularized_inverse(K, rel_cut=1e-3):
  """Truncated-SVD inverse. Returns J, n_truncated, condition number."""
  P, s, Qt = np.linalg.svd(K)
  keep = s > rel_cut * s.max()
  s_inv = np.where(keep, 1.0 / np.where(keep, s, 1.0), 0.0)
  J = (Qt.T * s_inv) @ P.T
  return J, int((~keep).sum()), float(s.max() / s[keep].min())


def _zscore_offdiag(M):
  v = M[~np.eye(M.shape[0], dtype=bool)]
  return (M - v.mean()) / v.std()


def main():
  info, ts, ss = load_data()
  n_g = N_GENES
  dt = info["sampling_interval"]
  base = ss[0]
  dX = ss[1:] - base                       # (15, 25)
  off = ~np.eye(n_g, dtype=bool)
  n_off = n_g * n_g - n_g                  # 600

  # ---------------- Method A ----------------
  mA = method_a(ts, dt)
  J_A, zA, stabA = mA["J_A"], mA["zA"], mA["sign_stability"]
  offA = np.abs(J_A[off])
  confA_mask = off & (np.abs(zA) >= 2)
  sign_stab_conf = float(stabA[confA_mask].mean()) if confA_mask.any() \
      else float("nan")
  DIAG["methodA"] = {
    "mean_r2": round(mA["A_r2_mean"], 4),
    "r2_per_gene": [round(float(v), 3) for v in mA["r2"]],
    "n_confident_edges_z2": int(confA_mask.sum()),
    "sign_stability_confident": round(sign_stab_conf, 4),
    "self_reg_all_negative": mA["self_reg_all_negative"],
    "self_reg_range": [round(float(mA["self_reg"].min()), 3),
                        round(float(mA["self_reg"].max()), 3)],
  }

  # ---------------- Method B ----------------
  K, hist, supports, conv = fit_inverse_jacobian(dX, base)
  route = "alternating_sparse_factorization"
  r2_B = hist[-1]
  n_iter = len(hist)
  if r2_B < 0.7 or not conv:
    K_fb, hist_fb, _ = fit_inverse_fallback(dX, base)
    if hist_fb[-1] > r2_B:
      K, hist, supports = K_fb, hist_fb, None
      route = "per_gene_ridge_fallback"
      r2_B, n_iter = hist_fb[-1], len(hist_fb)
  J_B, n_trunc, condK = regularized_inverse(K)
  np.fill_diagonal(J_B, 0.0)

  # sensitivity: exclude the subtle row 2 (index 1 of the 15 deltas)
  K_no2, hist_no2, _, _ = fit_inverse_jacobian(np.delete(dX, 1, axis=0), base)
  J_no2, _, _ = regularized_inverse(K_no2)
  np.fill_diagonal(J_no2, 0.0)
  r2_no2 = hist_no2[-1]
  flip_mask = off & (J_B != 0) & (J_no2 != 0) & (np.sign(J_B) != np.sign(J_no2))

  DIAG["methodB"] = {
    "route": route,
    "n_iterations": n_iter,
    "r2_history": [round(float(v), 4) for v in hist],
    "final_r2": round(float(r2_B), 4),
    "r2_without_row2": round(float(r2_no2), 4),
    "condition_number_K": round(condK, 2),
    "n_svd_truncated": n_trunc,
    "supports_per_condition": supports,
    "n_sign_flips_excluding_row2": int(flip_mask.sum()),
    "flipped_edges": [[int(i), int(j)] for i, j in np.argwhere(flip_mask)],
  }

  # ---------------- combination (conflict-filtered z-ensemble) ----------------
  # Approved rule: keep an edge when Method B indicates it (signB != 0)
  # and Method A does NOT confidently oppose it (|zA|<2 or same sign).
  # Magnitude = z-ensemble zcomb = (z_A + z_B)/2 (agreement reinforced,
  # disagreement cancelled). Low-confidence entries thresholded to 0.0.
  zA_z = _zscore_offdiag(J_A)
  zB_z = _zscore_offdiag(J_B)
  zcomb = 0.5 * (zA_z + zB_z)
  conf = np.abs(zcomb)
  signA = np.sign(J_A)
  signB = np.sign(J_B)
  conflict = off & (np.abs(zA) >= 2) & (signA != 0) & (signA != signB)
  cand = off & (signB != 0) & ~conflict
  cv = conf[cand]
  target_n = int(round(TARGET_DENSITY * n_off))
  if len(cv) == 0:
    thr = 0.0
  elif target_n >= len(cv):
    thr = float(cv.min())
  else:
    thr = float(np.quantile(cv, 1.0 - target_n / len(cv)))
  keep = cand & (conf >= thr)
  W = np.where(keep, zcomb, 0.0)
  W[~np.isfinite(W)] = 0.0
  W[~off] = 0.0
  sign_pred = np.sign(W)
  n_edges = int((W != 0).sum())
  final_density = n_edges / n_off
  # safety: clamp density into the required band
  if final_density > DENSITY_MAX:
    thr = float(np.quantile(conf[keep], DENSITY_MAX - final_density + 1e-9))
    keep = cand & (conf >= thr)
    W = np.where(keep, zcomb, 0.0)
    n_edges = int((W != 0).sum()); final_density = n_edges / n_off
  elif final_density < DENSITY_MIN and len(cv) > n_edges:
    need = int(round(DENSITY_MIN * n_off)) - n_edges
    rest = np.sort(conf[cand & ~keep])[::-1][:need]
    thr2 = float(rest.min()) if len(rest) else thr
    keep = cand & (conf >= thr2)
    W = np.where(keep, zcomb, 0.0)
    n_edges = int((W != 0).sum()); final_density = n_edges / n_off

  # final-network sensitivity: same combination with J_B from the
  # row-2-excluded fit; count how many final edges change / flip sign
  zB_no2 = _zscore_offdiag(J_no2)
  zc_no2 = 0.5 * (zA_z + zB_no2)
  conf_no2 = np.abs(zc_no2)
  signB_no2 = np.sign(J_no2)
  conflict_no2 = off & (np.abs(zA) >= 2) & (signA != 0) &       (signA != signB_no2)
  cand_no2 = off & (signB_no2 != 0) & ~conflict_no2
  cv_no2 = conf_no2[cand_no2]
  tn = int(round(TARGET_DENSITY * n_off))
  if len(cv_no2) == 0:
    thr_no2 = 0.0
  elif tn >= len(cv_no2):
    thr_no2 = float(cv_no2.min())
  else:
    thr_no2 = float(np.quantile(cv_no2, 1.0 - tn / len(cv_no2)))
  W_no2 = np.where(cand_no2 & (conf_no2 >= thr_no2), zc_no2, 0.0)
  W_no2[~np.isfinite(W_no2)] = 0.0
  W_no2[~off] = 0.0
  final_changed = int(((W != 0) != (W_no2 != 0)).sum())
  final_flipped = int(((W != 0) & (W_no2 != 0) &
                       (np.sign(W) != np.sign(W_no2))).sum())

  sign_agree_all = float((signA[off] == signB[off]).mean())
  strict_agree_kept = keep & (signA == signB) & (signA != 0)
  sign_agree_kept = float(strict_agree_kept.sum()) / max(n_edges, 1)
  nonconf_kept = keep & (signA != 0) & (signA != signB)
  DIAG["combination"] = {
    "threshold_on_abs_zcomb": round(thr, 4),
    "target_density": TARGET_DENSITY,
    "final_density": round(final_density, 4),
    "n_edges": n_edges,
    "n_conflict_edges_dropped": int(conflict.sum()),
    "sign_agreement_all_offdiag": round(sign_agree_all, 4),
    "strict_sign_agreement_among_kept": round(sign_agree_kept, 4),
    "n_nonconflicting_opposite_kept": int(nonconf_kept.sum()),
    "n_pos_edges": int((W > 0).sum()),
    "n_neg_edges": int((W < 0).sum()),
    "final_edges_changed_excluding_row2": final_changed,
    "final_edges_sign_flipped_excluding_row2": final_flipped,
  }

  # ---------------- hubs & metrics ----------------
  out_deg_w = np.abs(W).sum(axis=0)   # weighted out-degree (column sums)
  in_deg = (W != 0).sum(axis=1)
  out_deg = (W != 0).sum(axis=0)
  hub = [int(i) for i in np.argsort(-out_deg_w)[:2]]
  in_w = np.abs(W).sum(axis=1)
  metrics = {
    "n_edges": n_edges,
    "density": final_density,
    "offdiagonal_nonzero_density": final_density,
    "convention": ("entry [i,j] = influence of gene j on gene i; "
                   "in-degree = row nonzero count, out-degree = column "
                   "nonzero count of the exact submitted topology"),
    "in_degree": {"mean": float(in_deg.mean()), "std": float(in_deg.std()),
                  "min": int(in_deg.min()), "max": int(in_deg.max()),
                  "per_gene": in_deg.tolist()},
    "out_degree": {"mean": float(out_deg.mean()), "std": float(out_deg.std()),
                   "min": int(out_deg.min()), "max": int(out_deg.max()),
                   "per_gene": out_deg.tolist()},
    "weighted_in_degree": {"mean": float(in_w.mean()),
                           "std": float(in_w.std()),
                           "max": float(in_w.max()),
                           "per_gene": np.round(in_w, 4).tolist()},
    "weighted_out_degree": {"mean": float(out_deg_w.mean()),
                            "std": float(out_deg_w.std()),
                            "max": float(out_deg_w.max()),
                            "per_gene": np.round(out_deg_w, 4).tolist()},
    "hub_genes": hub,
    "hub_weighted_out_degree": [float(out_deg_w[h]) for h in hub],
  }

  corr_AB = float(np.corrcoef(J_A[off].ravel(), J_B[off].ravel())[0, 1])
  method_comparison = {
    "methods": {
      "method_a_timeseries": {
        "description": ("Linear lag-1 dynamic model x(t+1)=A x(t)+c fitted "
                        "per target gene on 245 within-replicate samples "
                        "(5 replicates x 49 transitions); Jacobian "
                        "J_A=(A-I)/dt; off-diagonal sign = influence sign; "
                        "confidence = coefficient t-statistic."),
        "mean_r2": round(mA["A_r2_mean"], 4),
        "score": round(mA["A_r2_mean"], 4),
        "stability": round(sign_stab_conf, 4),
        "n_confident_edges_z2": int(confA_mask.sum()),
        "strengths": ("Exploits temporal ordering from 5 independent "
                      "experiments; R2 ~ 0.95; self-regulation diagonal "
                      "consistently negative (stable); fully independent "
                      "of the steady-state perturbations."),
        "limitations": ("The transient is a single slow relaxation mode "
                        "(PC1 ~ 96% of variance) from near-common initial "
                        "conditions, so individual off-diagonal entries "
                        "are collinear and only weakly identifiable; "
                        "per-edge sign stability ~ 0.7."),
      },
      "method_b_steadystate": {
        "description": ("Linear-response factorization D = K U of the 15 "
                        "steady-state deltas, K = J^{-1}, U row-sparse "
                        "(1-3 targets/condition, value-perturbation "
                        "convention U[r,k]=D[r,k]); alternating "
                        "ridge-K / L1-sparse-coding iterations; J_B = "
                        "truncated-SVD inverse of K."),
        "route": route,
        "mean_r2": round(float(r2_B), 4),
        "r2_without_row2": round(float(r2_no2), 4),
        "condition_number_K": round(condK, 2),
        "n_svd_truncated": n_trunc,
        "score": round(float(r2_B), 4),
        "strengths": ("Reconstructs the 15 perturbation steady states "
                      "with R2 ~ 0.998; directly exploits the "
                      "interventions; sign of J_B fixed by the "
                      "value-perturbation convention; robust to the "
                      "subtle row 2 (R2 unchanged when excluded)."),
        "limitations": ("Only 15 conditions < 25 genes, so K is "
                        "identified in ~15 directions; 11 of 25 "
                        "singular values truncated in the inversion "
                        "(condition number reported); intervention "
                        "targets are inferred, not documented."),
      },
      "combined": {
        "description": ("Consensus rule: keep edge [i,j] when Method B "
                        "indicates it (signB != 0) and Method A does not "
                        "confidently oppose it (|zA|<2 or same sign); "
                        "magnitude = z-ensemble z_comb=(z_A+z_B)/2 "
                        "(agreement reinforced, disagreement cancelled); "
                        "low-confidence entries set to exactly 0.0 with a "
                        "threshold chosen for ~10% off-diagonal density "
                        "(inside the required 5-40% band)."),
        "correlation": round(corr_AB, 4),
        "sign_agreement_fraction": round(sign_agree_all, 4),
        "strict_sign_agreement_among_kept": round(sign_agree_kept, 4),
        "density": round(final_density, 4),
        "n_edges": n_edges,
        "threshold": round(thr, 4),
        "rationale": ("Ensemble averaging is the natural combination for "
                      "two partially-identifying, independent estimates: "
                      "agreement is reinforced, disagreement cancels. "
                      "The residual low sign-agreement is reported "
                      "honestly as the main uncertainty of the inferred "
                      "topology."),
      },
    }
  }

  # ---------------- diagnostics ----------------
  flat = np.argwhere(off)
  order = np.argsort(-np.abs(W[off]))
  top10 = []
  for k in order[:10]:
    i, j = flat[k]
    top10.append({"target_i": int(i), "source_j": int(j),
                  "weight": round(float(W[i, j]), 4),
                  "sign": int(sign_pred[i, j]),
                  "zA": round(float(zA[i, j]), 2)
                  if np.isfinite(zA[i, j]) else None,
                  "zB_combo": round(float(zcomb[i, j]), 3)})
  DIAG["top10_edges"] = top10
  DIAG["hubs"] = {"genes": hub,
                  "weighted_out_degree": [float(out_deg_w[h]) for h in hub]}
  DIAG["out_degree_ranking"] = (
      [[int(g), float(out_deg_w[g]), int(out_deg[g])]
       for g in np.argsort(-out_deg_w)[:6]])

  # ---------------- write outputs ----------------
  np.save("inferred_network.npy", W.astype(np.float64))
  np.save("edge_sign_predictions.npy", sign_pred.astype(np.float64))
  with open("hub_genes.json", "w") as f:
    json.dump({"hub_genes": hub}, f, indent=2)
  with open("method_comparison.json", "w") as f:
    json.dump(method_comparison, f, indent=2)
  with open("network_metrics.json", "w") as f:
    json.dump(metrics, f, indent=2)

  print(json.dumps(DIAG, indent=2, default=str))
  print("density check:", final_density, "in [0.05, 0.40]:",
        DENSITY_MIN <= final_density <= DENSITY_MAX)
  print("finite check:", bool(np.isfinite(W).all()
                              and np.isfinite(sign_pred).all()))
  print("sign consistency:",
        bool(((sign_pred == 0) == (W == 0)).all()))


if __name__ == "__main__":
  main()
