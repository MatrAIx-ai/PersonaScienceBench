        "E": ["11111", "10000", "10000", "11100", "10000", "10000", "11111"],
        "0": ["01110", "10001", "10011", "10101", "11001", "10001", "01110"],
        "1": ["00100", "01100", "00100", "00100", "00100", "00100", "01110"],
        "2": ["01110", "10001", "00001", "00110", "01000", "10000", "11111"],
        "3": ["11111", "00010", "00100", "00010", "00001", "10001", "01110"],
        "4": ["00010", "00110", "01010", "10010", "11111", "00010", "00010"],
        "5": ["11111", "10000", "11110", "00001", "00001", "10001", "01110"],
        "6": ["00110", "01000", "10000", "11110", "10001", "10001", "01110"],
        "7": ["11111", "00001", "00010", "00100", "01000", "01000", "01000"],
        "8": ["01110", "10001", "10001", "01110", "10001", "10001", "01110"],
        "9": ["01110", "10001", "10001", "01111", "00001", "00010", "01100"],
        ".": ["00000", "00000", "00000", "00000", "00000", "00110", "00110"],
        "-": ["00000", "00000", "00000", "11111", "00000", "00000", "00000"],
        "/": ["00001", "00010", "00010", "00100", "01000", "01000", "10000"],
    }

    def text(x, y, s, color=BLACK, scale=2):
        cx = x
        for ch in s:
            g = FONT.get(ch)
            if g is None:
                cx += 6 * scale
                continue
            for ry in range(7):
                for rx in range(5):
                    if g[ry][rx] == "1":
                        canvas[y + ry * scale: y + (ry + 1) * scale,
                               cx + rx * scale: cx + (rx + 1) * scale] = color
            cx += 6 * scale

    def seg(x0, y0, x1, y1, color, dash=False):
        n = max(abs(x1 - x0), abs(y1 - y0), 1)
        for t in range(n + 1):
            if dash and (t // 4) % 2 == 1:
                continue
            x = int(round(x0 + (x1 - x0) * t / n))
            y = int(round(y0 + (y1 - y0) * t / n))
            if 0 <= x < W and 0 <= y < H:
                canvas[y, x] = color

    def line(box, xs, ys, xr, yr, color, dash=False):
        bx0, by0, bx1, by1 = box
        px = bx0 + (np.asarray(xs) - xr[0]) / (xr[1] - xr[0]) * (bx1 - bx0)
        py = by1 - (np.asarray(ys) - yr[0]) / (yr[1] - yr[0]) * (by1 - by0)
        for i in range(len(px) - 1):
            seg(int(px[i]), int(py[i]), int(px[i + 1]), int(py[i + 1]),
                color, dash=dash)

    MARG = 10
    boxes = [
        (MARG + 10, MARG + 10, W // 2 - 10, H // 2 - 10),
        (W // 2 + 10, MARG + 10, W - MARG - 10, H // 2 - 10),
        (MARG + 10, H // 2 + 10, W // 2 - 10, H - MARG - 10),
        (W // 2 + 10, H // 2 + 10, W - MARG - 10, H - MARG - 10),
    ]
    for b in boxes:
        seg(b[0], b[1], b[2], b[1], BLACK)
        seg(b[0], b[3], b[2], b[3], BLACK)
        seg(b[0], b[1], b[0], b[3], BLACK)
    text(20, 16, "a")
    text(W // 2 + 20, 16, "b")
    text(20, H // 2 + 16, "c")
    text(W // 2 + 20, H // 2 + 16, "d")

    # panel a: 3D configs via oblique projection (gray = ref, red = final)
    def proj(p):
        X = p[:, 0] - 0.5 * p[:, 1]
        Y = p[:, 2] - 0.22 * (p[:, 0] + p[:, 1])
        return X, Y

    Xr, Yr = proj(REF)
    Xf, Yf = proj(final_coords)
    xr = (Xr.min() - 1, Xr.max() + 1)
    yr = (Yr.min() - 1, Yr.max() + 1)
    b = boxes[0]

    def px_x(x):
        return int(b[0] + (x - xr[0]) / (xr[1] - xr[0]) * (b[2] - b[0]))

    def px_y(y):
        return int(b[3] - (y - yr[0]) / (yr[1] - yr[0]) * (b[3] - b[1]))

    for i in range(N - 1):
        seg(px_x(Xf[i]), px_y(Yf[i]), px_x(Xf[i + 1]), px_y(Yf[i + 1]),
            COLORS[0])
    for X, Y, col in ((Xr, Yr, (150, 150, 150)), (Xf, Yf, COLORS[0])):
        for x, y in zip(X, Y):
            seg(px_x(x), px_y(y), px_x(x) + 3, px_y(y) + 3, col)
    text(b[0] + 10, b[3] - 20, "ref: gray  final: red")

    # panel b: per-T Q histograms
    b = boxes[1]
    hmax = max(H50.max(), 1e-12)
    for k in range(K):
        line(b, np.linspace(0, 1, 50, endpoint=False) + 0.01, H50[k],
             (0, 1), (0, hmax * 1.05), COLORS[k])
    seg(int(b[0] + 0.5 * (b[2] - b[0])), b[1],
        int(b[0] + 0.5 * (b[2] - b[0])), b[3], (120, 120, 120), dash=True)
    text(b[0] + 10, b[3] - 20, "Q")

    # panel c: C(T) curve
    b = boxes[2]
    cmax = max(C_fine.max(), 1e-12) * 1.05
    line(b, T_fine, C_fine, (T_fine[0], T_fine[-1]), (0, cmax), COLORS[1])
    if C_mbar is not None:
        line(b, T_fine, C_mbar, (T_fine[0], T_fine[-1]), (0, cmax),
             COLORS[2], dash=True)
    for k in range(K):
        tx = int(b[0] + (T_LIST[k] - T_fine[0]) / (T_fine[-1] - T_fine[0])
                * (b[2] - b[0]))
        ty = int(b[3] - C_direct[k] / cmax * (b[3] - b[1]))
        seg(tx - 3, ty - 3, tx + 3, ty + 3, (20, 20, 20))
    tx = int(b[0] + (T_star - T_fine[0]) / (T_fine[-1] - T_fine[0])
             * (b[2] - b[0]))
    seg(tx, b[1], tx, b[3], COLORS[0], dash=True)
    text(b[0] + 10, b[3] - 20, "T")
    text(b[0] - 24, b[1] + 4, "C")

    # panel d: F(Q) at T_star + P(Q)
    b = boxes[3]
    fmax = max(F_prof.max(), 1e-12) * 1.05
    line(b, q_centers, F_prof, (0, 1), (0, fmax), COLORS[2])
    line(b, q_centers, P40 * fmax / max(P40.max(), 1e-12), (0, 1),
         (0, fmax), COLORS[1], dash=True)
    for m in mode_locs:
        tx = int(b[0] + m * (b[2] - b[0]))
        seg(tx, b[1], tx, b[3], COLORS[0], dash=True)
    text(b[0] + 10, b[3] - 20, "Q")
    text(b[0] - 24, b[1] + 4, "F")

    def chunk(tag, data):
        c = struct.pack(">I", len(data)) + tag + data
        return c + struct.pack(">I", zlib.crc32(tag + data) & 0xFFFFFFFF)

    raw = b"".join(b"\x00" + canvas[y].tobytes() for y in range(H))
    png = b"\x89PNG\r\n\x1a\n"
    png += chunk(b"IHDR", struct.pack(">IIBBBBB", W, H, 8, 2, 0, 0, 0))
    png += chunk(b"IDAT", zlib.compress(raw, 9))
    png += chunk(b"IEND", b"")
    with open("visualization.png", "wb") as fh:
        fh.write(png)


