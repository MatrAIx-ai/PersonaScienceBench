    ax.set_xlabel("Q"); ax.set_ylabel("F(Q) / kBT*")
    ax2.set_ylabel("P(Q)")
    ax.legend(fontsize=8, loc="upper right")
    fig.tight_layout()
    fig.savefig("visualization.png", dpi=110)
