def make_figure_fallback():
    """Minimal multi-panel PNG using only the Python stdlib (no matplotlib)."""
    import struct
    import zlib

    W, H = 1400, 1000
    canvas = np.full((H, W, 3), 255, dtype=np.uint8)
    BLACK = (40, 40, 40)
    COLORS = [(200, 30, 30), (30, 100, 200), (30, 150, 60),
              (150, 80, 200), (220, 140, 0), (0, 140, 140)]

    FONT = {
        "a": ["00000", "00110", "01001", "01111", "11001", "11001", "01111"],
        "b": ["10000", "11010", "10100", "11010", "10100", "11010", "10000"],
