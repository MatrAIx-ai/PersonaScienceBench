"""
Single-cell RNA-seq integrated analysis (NumPy + SciPy only).
Outputs: clusters.npy, pseudotime.npy, de_genes.json, grn_scores.npy, method_choices.json
"""
import json
import numpy as np
from scipy.sparse import csr_matrix
from scipy.sparse.linalg import eigsh
from scipy.sparse.csgraph import laplacian, shortest_path
from scipy.spatial import cKDTree
from scipy.spatial.distance import cdist
from scipy.stats import f_oneway

RNG_SEED = 0

# ---------------------------- Load inputs ----------------------------
with open("data/system_info.json") as f:
    info = json.load(f)
X = np.load("data/counts.npy")
n_cells, n_genes = X.shape
n_clusters = int(info["n_clusters"])
n_tf = int(info["n_tf_genes"])
tf_idx = list(info.get("tf_gene_indices", list(range(n_tf))))
assert X.shape == (info["n_cells"], info["n_genes"]), "shape mismatch"
print(f"[load] counts {X.shape} dtype={X.dtype} n_clusters={n_clusters} n_tf={n_tf}")

# ---------------------------- 1. Normalization ----------------------------
lib = X.sum(axis=1)
N = np.log1p(X / lib[:, None] * 1e4)   # CPM to 1e4 + log1p
print(f"[norm] CPM->log1p; libsize min/mean/max={lib.min():.0f}/{lib.mean():.0f}/{lib.max():.0f}")

# ---------------------------- 2a. HVG selection ----------------------------
Nvar = N.var(axis=0)
n_hvg = min(100, n_genes)
hvg = np.sort(np.argsort(Nvar)[::-1][:n_hvg])
tf_in_hvg = sorted(set(hvg.tolist()) & set(tf_idx))
print(f"[hvg] {len(hvg)} HVGs; TF indices in HVG set: {tf_in_hvg if tf_in_hvg else 'none'}")

# ---------------------------- 2b. PCA ----------------------------
Z = N[:, hvg]
Z = (Z - Z.mean(axis=0)) / (Z.std(axis=0) + 1e-8)
U, S, Vt = np.linalg.svd(Z, full_matrices=False)
n_comps = 10
E = U[:, :n_comps]
evr = (S ** 2) / (S ** 2).sum()
print(f"[pca] n_comps={n_comps} PC1var={evr[0]:.3f} cumvar={evr[:n_comps].sum():.3f}")

# ---------------------------- 3. KNN graph ----------------------------
knn_k = 15
tree = cKDTree(E)
_, idx = tree.query(E, k=knn_k + 1)
nbr = idx[:, 1:]
rows = np.repeat(np.arange(n_cells), knn_k)
cols = nbr.ravel()
W = csr_matrix((np.ones(rows.size), (rows, cols)), shape=(n_cells, n_cells))
W = W + W.T
W.data = np.clip(W.data, 0, 1)
print(f"[graph] KNN k={knn_k} edges={int(W.nnz // 2)}")

# ---------------------------- 3b. Spectral clustering ----------------------------
def kmeans(Xd, k, n_init=10, iters=300, seed=RNG_SEED):
    rng = np.random.default_rng(seed)
    n = Xd.shape[0]
    best_lab, best_inertia = None, np.inf
    for _ in range(n_init):
        C = Xd[rng.integers(n)].reshape(1, -1)
        for _ in range(1, k):
            d2 = ((Xd[:, None, :] - C[None, :, :]) ** 2).sum(-1).min(1)
            d2 = d2 / d2.sum()
            C = np.vstack([C, Xd[rng.choice(n, p=d2)]])
        for _ in range(iters):
            d = ((Xd[:, None, :] - C[None, :, :]) ** 2).sum(-1)
            lab = d.argmin(1)
            newC = np.array([Xd[lab == j].mean(0) if (lab == j).any() else C[j] for j in range(k)])
            if np.allclose(newC, C):
                C = newC
                break
            C = newC
        d = ((Xd[:, None, :] - C[None, :, :]) ** 2).sum(-1)
        lab = d.argmin(1)
        inertia = d.min(1).sum()
        if inertia < best_inertia:
            best_inertia, best_lab = inertia, lab
    return best_lab

L = laplacian(W, normed=True)
k_eig = n_clusters + 1
vals, vecs = eigsh(L, k=k_eig, which="SA", maxiter=20000, tol=1e-8)
order = np.argsort(vals)
vals, vecs = vals[order], vecs[:, order]
embedding = vecs[:, 1:1 + n_clusters]      # skip trivial eigenvector
clusters = kmeans(embedding, n_clusters).astype(np.int32)
sizes = np.bincount(clusters, minlength=n_clusters)
order_lab = np.argsort(sizes)[::-1]
remap = {old: new for new, old in enumerate(order_lab)}
clusters = np.array([remap[c] for c in clusters], dtype=np.int32)
print(f"[cluster] eigvals={np.round(vals[:k_eig], 4).tolist()}")
print(f"[cluster] sizes={np.bincount(clusters, minlength=n_clusters).tolist()}")

def silhouette(Xd, lab):
    d = cdist(Xd, Xd)
    n = len(lab); s = np.zeros(n)
    for i in range(n):
        same = lab == lab[i]; same[i] = False
        a = d[i, same].mean() if same.any() else 0.0
        b = min(d[i, lab == l].mean() for l in set(lab) if l != lab[i])
        s[i] = (b - a) / max(a, b) if max(a, b) > 0 else 0.0
    return s.mean()
sil = silhouette(E, clusters)
print(f"[cluster] silhouette(10-PC)={sil:.4f}")

# ---------------------------- 4. Pseudotime ----------------------------
D = shortest_path(W, directed=False)
finite = np.isfinite(D)
print(f"[pseudotime] connected={bool(finite.all())} inf={int((~finite).sum())}")
Dsym = np.where(finite, D, -1.0)
ia, ib = np.unravel_index(np.argmax(Dsym), Dsym.shape)
root = int(ia)
root_dist = int(Dsym[ia, ib])
pseudotime = D[root, :].astype(np.float64) - D[root, :].min()
print(f"[pseudotime] root={root} (diameter endpoint, farthest {root_dist} from cell {int(ib)}) range=[{pseudotime.min():.3f},{pseudotime.max():.3f}] root_cluster={int(clusters[root])}")

# ---------------------------- 5. DE / marker genes ----------------------------
groups = [N[clusters == c] for c in range(n_clusters)]
Fstat = np.full(n_genes, np.nan)
for g in range(n_genes):
    try:
        Fstat[g], _ = f_oneway(*[grp[:, g] for grp in groups])
    except Exception:
        Fstat[g] = np.nan
valid = np.where(np.isfinite(Fstat))[0]
ranked = valid[np.argsort(Fstat[valid])[::-1]]
top_de = ranked[:20].astype(int).tolist()
print(f"[de] top20={top_de}")
print(f"[de] F={np.round(Fstat[top_de], 1).tolist()}")
print(f"[de] TF(0-19) in top20? {sorted(set(top_de) & set(tf_idx))}")

# ---------------------------- 6. GRN (directed) ----------------------------
Tf = N[:, tf_idx]
Tf_s = (Tf - Tf.mean(axis=0)) / (Tf.std(axis=0) + 1e-8)   # standardize all TF cols
grn = np.zeros((n_tf, n_tf), dtype=np.float64)
for j in range(n_tf):
    pred = [i for i in range(n_tf) if i != j]             # EXCLUDE target
    A = np.column_stack([Tf_s[:, pred], np.ones(n_cells)])
    beta = np.linalg.lstsq(A, Tf_s[:, j], rcond=None)[0]
    for k_i, i in enumerate(pred):
        grn[i, j] = beta[k_i]
np.fill_diagonal(grn, 0.0)
_flat = np.argsort(np.abs(grn).ravel())[::-1][:5]
top_edges = [(int(i), int(j), round(float(grn[i, j]), 3))
             for i, j in zip(*np.unravel_index(_flat, grn.shape))]
print(f"[grn] shape={grn.shape} finite={bool(np.isfinite(grn).all())} max|val|={np.abs(grn).max():.4f} asym|G-G.T|max={np.abs(grn - grn.T).max():.4f}")
print(f"[grn] top|edges|={top_edges}")

# ---------------------------- Write outputs ----------------------------
np.save("clusters.npy", clusters.astype(np.int32))
np.save("pseudotime.npy", pseudotime.astype(np.float64))
np.save("grn_scores.npy", grn.astype(np.float64))
with open("de_genes.json", "w") as f:
    json.dump({"gene_indices": top_de}, f, indent=2)

method = {
    "normalization": {"method": "CPM (library-size scale to 1e4) + log1p",
        "justification": "Standard droplet normalization; removes the observed 901-3992 library-size variation before log-compressing the zero-inflated counts."},
    "hvg_selection": {"method": f"Top {n_hvg} genes by variance of the normalized matrix",
        "n_hvg": int(n_hvg), "tf_indices_in_hvg": tf_in_hvg if tf_in_hvg else "none",
        "justification": "Marker genes (high variance) carry cluster identity; TF columns are low-variance and not expected to be selected. Any TF that slipped in is harmless but noted."},
    "pca": {"method": "SVD on standardized HVG expression", "n_comps": int(n_comps),
        "pc1_variance": round(float(evr[0]), 4), "cumvar_top_comps": round(float(evr[:n_comps].sum()), 4),
        "justification": "Spectrum is flat (typical of log-normalized scRNA-seq); a fixed small number of components (10) is appropriate for 800 cells."},
    "clustering": {"method": "KNN graph (k=15, PC space, mutual/symmetric) -> normalized graph Laplacian -> first 4 eigenvectors (eigsh, trivial eigenvector skipped) -> k-means (k=4, kmeans++ 10 restarts)",
        "knn_k": int(knn_k), "k": int(n_clusters), "k_source": "system_info.json n_clusters=4 (given, not inferred)",
        "cluster_sizes": np.bincount(clusters, minlength=n_clusters).tolist(),
        "silhouette_10pc": round(float(sil), 4),
        "fallback": "Agglomerative clustering (scipy.cluster.hierarchy, average linkage) on KNN-graph geodesic distance with fcluster(k=4)",
        "justification": "Louvain/Leiden are not in scipy; spectral clustering on the KNN graph is the cleanest graph-based community detection doable with scipy and handles non-linear manifolds via the graph."},
    "pseudotime": {"method": "Graph-based: root = endpoint of the KNN-graph geodesic diameter; pseudotime = shortest-path (Dijkstra) distance from the root along the graph",
        "root_cell_index": int(root),
        "root_reason": f"Cell {int(root)} is an endpoint of the graph's geodesic diameter (its farthest graph distance {int(root_dist)} is to cell {int(ib)}); choosing a diameter endpoint as the trajectory start is a data-driven, reproducible root heuristic.",
        "root_cluster": int(clusters[root]),
        "pseudotime_range": [round(float(pseudotime.min()), 3), round(float(pseudotime.max()), 3)],
        "alternative": "Diffusion pseudotime (eigsh of the symmetric diffusion/transition matrix) - no single root cell, but requires choosing diffusion time t.",
        "justification": "No metadata specifies a start/end state, so the root is inferred from manifold geometry; following the KNN graph handles non-linear trajectories."},
    "de_marker_genes": {"method": "Per-gene one-way ANOVA F-statistic across the 4 clusters (scipy.stats.f_oneway) on normalized expression",
        "n_reported": 20, "gene_indices": top_de,
        "justification": "A single scalar per gene ranking how strongly it distinguishes the clusters; no gene names exist so indices are integers into the gene axis (0-249)."},
    "grn": {"method": "GENIE-style directed regression: for each target TF j, OLS-regress its standardized expression on the OTHER 19 standardized TFs (target EXCLUDED from its own predictor set); grn_scores[i,j] = standardized coefficient of regulator i in the model for target j; diagonal set to 0.",
        "convention": "grn_scores[i,j] = edge i -> j (i regulates j)",
        "standardization": "Both regulator columns and the target standardized to zero-mean/unit-variance before OLS so coefficients are comparable across TFs of different total expression (302-555).",
        "shape": [n_tf, n_tf],
        "justification": "Directed (not symmetric correlation): each column is a separate regression with a different response, so grn_scores[i,j] (effect of i on j) differs from grn_scores[j,i] (effect of j on i). It captures i's unique regulatory contribution to j after controlling for co-expressed TFs (GENIE/SCENIC-PR). Excluding the target from its own predictors is mandatory; otherwise OLS degenerates to the identity matrix."},
    "caveats": [
        "PSEUDOTIME ORIENTATION: no natural root exists in the metadata, so the root is inferred (graph-diameter endpoint). Pseudotime is therefore defined only up to an arbitrary root and orientation; the true trajectory direction is unknown.",
        "DIRECTED GRN SIGNAL IS WEAK / NEAR-SYMMETRIC: the TF columns are lowly expressed and weakly correlated (max |corr| ~0.20, full R2 to predict one TF from the other 19 ~0.04). Direction from a single cross-sectional snapshot is only weakly identifiable without extra assumptions, so the resulting grn_scores is small and near-symmetric. This is a property of the data, not a flaw in the directed-regression method (which is asymmetric by construction)."
    ]
}
with open("method_choices.json", "w") as f:
    json.dump(method, f, indent=2)
print("\n[done] wrote clusters.npy, pseudotime.npy, de_genes.json, grn_scores.npy, method_choices.json")
