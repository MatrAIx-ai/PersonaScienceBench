def _draw_text(rgb, x, y, text, scale, color):
    cx = x
    for ch in text.upper():
        g = _FONT.get(ch, (0,) * 7)
        for r in range(7):
            bits = g[r]
            for c in range(5):
                if bits & (16 >> c):
                    rgb[y + r * scale: y + (r + 1) * scale,
                        cx + c * scale: cx + (c + 1) * scale] = color
        cx += 6 * scale


def _diverging_rgb(t):
    """t in [-1,1] -> (H,W,3) uint8, blue(-) white(0) red(+) diverging map."""
    t = np.clip(np.asarray(t, float), -1.0, 1.0)
    a = np.abs(t)
    r = np.where(t > 0, 255 - t * 77, 255 - a * 222)
    g = np.where(t > 0, 255 - t * 231, 255 - a * 153)
    b = np.where(t > 0, 255 - t * 212, 255)
    return np.stack([r, g, b], axis=-1).clip(0, 255).astype(np.uint8)


def _write_png(path, rgb):
    import zlib, struct
    def chunk(tag, data):
        return (struct.pack(">I", len(data)) + tag + data
                + struct.pack(">I", zlib.crc32(tag + data) & 0xFFFFFFFF))
    h, w = rgb.shape[:2]
    raw = b"".join(b"\x00" + rgb[y].tobytes() for y in range(h))
    png = (b"\x89PNG\r\n\x1a\n"
           + chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0))
           + chunk(b"IDAT", zlib.compress(raw, 9))
           + chunk(b"IEND", b""))
    with open(path, "wb") as f:
        f.write(png)


def _overview_pure(field_slice, df, order, path):
    W, H = 1900, 860
    rgb = np.full((H, W, 3), 255, np.uint8)
    lim = np.percentile(np.abs(field_slice), 99.5)
    _draw_text(rgb, W // 2 - 330, 12,
               "PB BINDING RESPONSE: REACTION-FIELD SLICES AND METRICS", 2, (0, 0, 0))
    # top row: 8 field slices + shared colorbar
    pw, ph = 200, 200
    x0, y0, gap = 25, 60, 25
    for i in range(len(order)):
        x = x0 + i * (pw + gap)
        z = field_slice[i] / lim
        img = _diverging_rgb(z)
        up = np.repeat(np.repeat(img, 6, axis=0), 6, axis=1)[:ph, :pw]
        rgb[y0:y0 + ph, x:x + pw] = up
        _draw_text(rgb, x + pw // 2 - 24, y0 + ph + 8, order[i], 1, (0, 0, 0))
    cbx = x0 + 8 * (pw + gap) + 5
    for r in range(ph):
        t = 1 - 2 * r / (ph - 1)
        rgb[y0 + r:y0 + r + 1, cbx:cbx + 18] = _diverging_rgb(np.array([t]))[0]
    for val, yy in ((lim, y0), (0, y0 + ph // 2), (-lim, y0 + ph - 1)):
        rgb[yy, cbx - 4:cbx] = (0, 0, 0)
        lab = ("+%d" % int(round(val))) if val > 0 else ("%d" % int(round(val)))
        _draw_text(rgb, cbx + 22, yy - 3, lab, 1, (0, 0, 0))
    # bottom row: grouped bars
    prim = df["metric_primary_kcal_mol"].to_numpy()
    sec = df["metric_secondary_kcal_mol"].to_numpy()
    gapv = df["metric_gap_kcal_mol"].to_numpy()
    ax_l, ax_r, ax_b, ax_t = 70, W - 40, 800, 430
    vmax = max(np.abs(prim).max(), np.abs(sec).max(), np.abs(gapv).max()) * 1.15
    yz = int(ax_t + (ax_b - ax_t) / 2)
    rgb[yz, ax_l:ax_r] = (80, 80, 80)
    for val in (vmax, -vmax):
        yy = int(ax_t + (ax_b - ax_t) * (1 - (val + vmax) / (2 * vmax)))
        rgb[yy, ax_l:ax_r] = (220, 220, 220)
        _draw_text(rgb, 8, yy - 3, ("%d" % int(round(val))), 1, (60, 60, 60))
    _draw_text(rgb, ax_l, ax_t - 22, "KCAL/MOL", 1, (60, 60, 60))
    gw = (ax_r - ax_l) / len(order)
    bw = gw * 0.24
    colors = ((31, 119, 180), (255, 127, 14), (44, 160, 44))
    for i in range(len(order)):
        cx = ax_l + gw * i + gw / 2
        for k, (val, col) in enumerate(zip((prim[i], sec[i], gapv[i]), colors)):
            xx = cx + (k - 1) * bw - bw / 2
            yy = int(ax_t + (ax_b - ax_t) * (1 - (val + vmax) / (2 * vmax)))
            top, bot = (min(yy, yz), max(yy, yz))
            if bot - top < 1:
                bot = top + 1
            rgb[top:bot, int(xx):int(xx + bw)] = col
        _draw_text(rgb, int(cx) - 24, ax_b + 8, order[i], 1, (0, 0, 0))
    # legend
    lx = ax_l + 20
    for k, (lab, col) in enumerate((("PRIMARY (PB)", colors[0]),
                                    ("SECONDARY (BORN CROSS-TERM)", colors[1]),
                                    ("GAP (PRIMARY - SECONDARY)", colors[2]))):
        yy = 396 + k * 18
        rgb[yy:yy + 12, lx:lx + 12] = col
        _draw_text(rgb, lx + 18, yy, lab, 1, (0, 0, 0))
        lx += 18 + len(lab) * 6 + 40
    _write_png(path, rgb)


def make_overview(field_slice, df, order, path):
    """2-row overview figure: 8 reaction-field slices + metric bars."""
    try:
        import matplotlib
        matplotlib.use("Agg")
        import matplotlib.pyplot as plt
        lim = np.percentile(np.abs(field_slice), 99.5)
        fig = plt.figure(figsize=(18, 8.5))
        gs = fig.add_gridspec(2, 8, height_ratios=[1.25, 1.0],
                              left=0.04, right=0.97, top=0.90, bottom=0.10,
                              hspace=0.42, wspace=0.45)
        for i in range(len(order)):
            ax = fig.add_subplot(gs[0, i])
            im = ax.imshow(field_slice[i], origin="lower", aspect="equal",
                           cmap="RdBu_r", vmin=-lim, vmax=lim)
            ax.set_title(order[i], fontsize=9)
            ax.set_xticks([]); ax.set_yticks([])
            cb = fig.colorbar(im, ax=ax, fraction=0.35, pad=0.02)
            cb.ax.tick_params(labelsize=6)
        axb = fig.add_subplot(gs[1, :])
        prim = df["metric_primary_kcal_mol"].to_numpy()
        sec = df["metric_secondary_kcal_mol"].to_numpy()
        gapv = df["metric_gap_kcal_mol"].to_numpy()
        x = np.arange(len(order))
        w = 0.26
        axb.bar(x - w, prim, width=w, label="primary (PB)", color="#1f77b4")
        axb.bar(x, sec, width=w, label="secondary (Born cross-term)", color="#ff7f0e")
        axb.bar(x + w, gapv, width=w, label="gap (primary - secondary)", color="#2ca02c")
        axb.axhline(0, color="k", lw=0.6)
        axb.set_xticks(x)
        axb.set_xticklabels(order, fontsize=8)
        axb.set_ylabel("kcal/mol")
        axb.set_title("Binding-response metrics per case", fontsize=10)
        axb.legend(fontsize=8, loc="best")
        axb.grid(axis="y", alpha=0.3)
        fig.suptitle("Implicit-solvent PB binding response: reaction-field slices and metrics",
                     fontsize=12)
        fig.savefig(path, dpi=150)
        plt.close(fig)
    except Exception:
        _overview_pure(field_slice, df, order, path)


