"""Solution-phase electron-transfer (Marcus) reorganization-energy analysis.
Reads data/ and writes required outputs under results/.
Conventions (locked): 7 sites -> 21 Cartesian components (site-major xyz),
ascending site_id order; forward = B in A (ref A), backward = A in B (ref B);
signed displacement = aligned source - reference; rigid Kabsch (no scaling);
mass-weight by sqrt(atomic mass amu); retain 15 resolved modes (drop 6 rigid);
lambda_inner_effective = mean(fwd,bwd nm); lambda_outer = two-cavity Marcus with
L=span_A center-to-center; dominant_mode = argmax 0.5*lambda_k*q_k^2 (0-based);
driving-force grid preserved in supplied (unsorted) order.
"""
import os, json
import numpy as np
import pandas as pd
try:
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt
    HAVE_MPL = True
except Exception:
    HAVE_MPL = False

DATA, OUT = "data", "results"
os.makedirs(OUT, exist_ok=True)
HBAR = 6.582119569e-16      # eV*s
KB   = 8.617333262e-5       # eV/K
E2   = 14.399645478425505   # e^2/(4 pi eps0) eV*Angstrom

st   = pd.read_csv(f"{DATA}/site_table.csv")
fo   = pd.read_csv(f"{DATA}/frame_site_order.csv")
man  = json.load(open(f"{DATA}/system_manifest.json"))
med  = json.load(open(f"{DATA}/medium_response.json"))
Ca   = np.load(f"{DATA}/frame_a_coords.npy")
Cb   = np.load(f"{DATA}/frame_b_coords.npy")
Ha   = np.load(f"{DATA}/frame_a_hessian.npy")
Hb   = np.load(f"{DATA}/frame_b_hessian.npy")
grid = pd.read_csv(f"{DATA}/driving_force_grid.csv")

n_sites = len(st)
NC = n_sites*3
NRET = int(man["resolved_rank"])
NNULL = int(man["null_rank"])
m  = st.set_index("site_id")["mass_amu"].sort_index().to_numpy()
mc = np.repeat(m, 3)
D_sqrt     = np.diag(np.sqrt(mc))
D_inv_sqrt = np.diag(1.0/np.sqrt(mc))

def site_order(frame):
    sub = fo[fo.frame_id == frame]
    return sub.set_index("site_id")["row_index"].sort_index().to_numpy()

def perm21(frame):
    raw = site_order(frame)
    return np.array([raw[s]*3+dx for s in range(n_sites) for dx in range(3)])

A = Ca[site_order("frame_a")]
B = Cb[site_order("frame_b")]
pa, pb = perm21("frame_a"), perm21("frame_b")
Haa = Ha[np.ix_(pa, pa)]
Hbb = Hb[np.ix_(pb, pb)]

def kabsch(ref, mob):
    rc = ref-ref.mean(0); mc = mob-mob.mean(0)
    U, s, Vt = np.linalg.svd(rc.T @ mc)
    d = np.linalg.det(U @ Vt)
    R = U @ np.diag([1.0, 1.0, d]) @ Vt
    t = ref.mean(0) - mob.mean(0) @ R.T
    return R, t

def blockR(R):
    return np.kron(np.eye(n_sites), R)

def fix_sign(V):
    V = V.copy()
    for k in range(V.shape[1]):
        i = np.argmax(np.abs(V[:, k]))
        if V[i, k] < 0:
            V[:, k] *= -1.0
    return V

def resolved_modes(H):
    Hmw = D_inv_sqrt @ H @ D_inv_sqrt
    w, v = np.linalg.eigh(Hmw)
    return w[NNULL:], fix_sign(v[:, NNULL:])

def _write_fallback_png(path, rate, k, pk, fwd, bwd, lam4_f, lam4_b,
                        lamnm_f, lamnm_b, lam_inner, lam_outer, lam_total,
                        k_self, NRET, inv_mask, rmsd_f, rmsd_b, dom_f, dom_b):
    """Minimal pure-Python PNG (no matplotlib): 4 informative panels."""
    import zlib, struct
    W, H = 1000, 750
    img = np.full((H, W, 3), 255, dtype=np.uint8)
    def panel(x0,y0,x1,y1):
        img[y0:y1,x0]=[0,0,0]; img[y0:y1,x1]=[0,0,0]
        img[y0,x0:x1]=[0,0,0]; img[y1,x0:x1]=[0,0,0]
    def hline(y,x0,x1,c): img[y,x0:x1]=c
    def rect(x0,y0,x1,y1,c): img[y0:y1,x0:x1]=c
    def dot(x,y,r,c):
        for dy in range(-r,r+1):
            for dx in range(-r,r+1):
                if dx*dx+dy*dy<=r*r:
                    yy,xx=y+dy,x+dx
                    if 0<=yy<H and 0<=xx<W: img[yy,xx]=c
    def poly(xs,ys,c):
        for i in range(len(xs)-1):
            x0,y0=xs[i],ys[i]; x1,y1=xs[i+1],ys[i+1]
            n=int(max(abs(x1-x0),abs(y1-y0)))+1
            for j in range(n+1):
                t=j/n; x=int(round(x0+(x1-x0)*t)); y=int(round(y0+(y1-y0)*t))
                if 0<=y<H and 0<=x<W: img[y,x]=c
    px0,px1,py0,py1=40,480,40,340
    qx0,qx1,qy0,qy1=520,960,40,340
    rx0,rx1,ry0,ry1=40,480,400,700
    sx0,sx1,sy0,sy1=520,960,400,700
    panel(px0,py0,px1,py1)
    dG=rate["axis_eV"].to_numpy(); lg=np.log10(np.clip(k,1e-300,None))
    xmn,xmx=dG.min(),dG.max(); ymn,ymx=lg.min(),lg.max()
    X=lambda v:int(px0+10+(v-xmn)/(xmx-xmn)*(px1-px0-20))
    Y=lambda v:int(py1-10-(v-ymn)/(ymx-ymn)*(py1-py0-20))
    xs=[X(v) for v in dG]; ys=[Y(v) for v in lg]
    poly(xs,ys,[0,0,200]); dot(xs[pk],ys[pk],4,[220,0,0])
    panel(qx0,qy0,qx1,qy1)
    mf=fwd["mproj"][:,2]; mb=bwd["mproj"][:,2]; mxv=max(mf.max(),mb.max())
    bw=(qx1-qx0-20)//(NRET*2)
    for i in range(NRET):
        bx=qx0+10+i*2*bw
        hf=int((py1-qy0-20)*mf[i]/mxv); hb=int((py1-qy0-20)*mb[i]/mxv)
        rect(bx,py1-10-hf,bx+max(bw-2,1),py1-10,[0,0,200])
        rect(bx+bw,py1-10-hb,bx+bw+max(bw-2,1),py1-10,[240,140,0])
    panel(rx0,ry0,rx1,ry1)
    ov=fwd["overlap"]; ovmx=ov.max() if ov.max()>0 else 1
    cw=(rx1-rx0-20)//15; chh=(ry1-ry0-20)//15
    for i in range(15):
        for j in range(15):
            t=ov[i,j]/ovmx
            rect(rx0+10+j*cw,ry0+10+i*chh,rx0+10+(j+1)*cw,ry0+10+(i+1)*chh,
                 [int(68+160*t),int(1+200*t),int(84+70*t)])
    panel(sx0,sy0,sx1,sy1)
    vals=[lam4_f,lam4_b,lamnm_f,lamnm_b,lam_inner,lam_outer,lam_total]
    vmax=np.log10(max(vals)); vmin=np.log10(min(v for v in vals if v>0))
    for i,v in enumerate(vals):
        yy=sy0+25+i*40
        hline(yy,sx0+10,sx1-10,[210,210,210])
        wv=int((sx1-sx0-30)*(np.log10(max(v,1e-9))-vmin)/(vmax-vmin)) if vmax>vmin else 0
        rect(sx0+10,yy-6,sx0+10+max(wv,1),yy+6,[0,120,0])
    raw=b''.join(b'\x00'+img[y].tobytes() for y in range(H))
    def chunk(t,d):
        c=t+d
        return struct.pack('>I',len(d))+c+struct.pack('>I',zlib.crc32(c)&0xffffffff)
    data=(b'\x89PNG\r\n\x1a\n'+chunk(b'IHDR',struct.pack('>IIBBBBB',W,H,8,2,0,0,0))
          +chunk(b'IDAT',zlib.compress(raw))+chunk(b'IEND',b''))
    open(path,'wb').write(data)

def analyze(refC, srcC, Href, Hsrc):
    R, t = kabsch(refC, srcC)
    srcA = srcC @ R.T + t
    dvec = srcA.reshape(NC) - refC.reshape(NC)      # source - reference (signed)
    dmw  = D_sqrt @ dvec                             # mass-weighted displacement
    wr, vr = resolved_modes(Href)                    # reference modes (21,15)
    q      = vr.T @ dmw                              # signed modal coordinates
    lam4   = 0.5 * dvec @ Href @ dvec                # 4-point quadratic energy
    lam_nm = 0.5 * np.sum(wr * q**2)                 # normal-mode sum (15 modes)
    P    = vr @ vr.T
    proj = P @ dmw                                   # projected displacement (signed)
    pnorm = float(np.linalg.norm(proj))
    rigid = float(np.linalg.norm(dmw - proj))
    rmsd  = float(np.sqrt(((refC - srcA)**2).sum(1).mean()))
    dom   = int(np.argmax(0.5 * wr * q**2))
    wsr, vsr = resolved_modes(Hsrc)
    M      = D_sqrt @ blockR(R) @ D_inv_sqrt
    Qsrc_t = M @ vsr                                 # transported source modes
    overlap = np.abs(vr.T @ Qsrc_t)                  # (15,15) magnitude-based
    tproj   = np.stack([np.abs(vr.T @ dmw),
                        np.abs(Qsrc_t.T @ dmw)], axis=1)
    mproj   = np.stack([q, wr, 0.5*wr*q**2], axis=1) # [q, lam_k, 0.5 lam q^2]
    return dict(R=R, t=t, dvec=dvec, dmw=dmw, wr=wr, vr=vr, q=q, lam4=lam4,
                lam_nm=lam_nm, proj=proj, pnorm=pnorm, rigid=rigid, rmsd=rmsd,
                dom=dom, overlap=overlap, tproj=tproj, mproj=mproj)

fwd = analyze(A, B, Haa, Hbb)     # forward: B in A (reference A)
bwd = analyze(B, A, Hbb, Haa)     # backward: A in B (reference B)

np.save(f"{OUT}/aligned_displacement_mw.npy",   np.stack([fwd["dmw"], bwd["dmw"]]))
np.save(f"{OUT}/vibrational_basis_mw.npy",      np.stack([fwd["vr"], bwd["vr"]]))
np.save(f"{OUT}/mode_overlap.npy",              np.stack([fwd["overlap"], bwd["overlap"]]))
np.save(f"{OUT}/projected_displacement_mw.npy", np.stack([fwd["proj"], bwd["proj"]]))
np.save(f"{OUT}/transported_mode_projection.npy",np.stack([fwd["tproj"], bwd["tproj"]]))
np.save(f"{OUT}/mode_projection.npy",           np.stack([fwd["mproj"], bwd["mproj"]]))

lam4_f,  lam4_b  = fwd["lam4"], bwd["lam4"]
lamnm_f, lamnm_b = fwd["lam_nm"], bwd["lam_nm"]
lam_inner = 0.5 * (lamnm_f + lamnm_b)
rD, rA = med["shell_0_A"], med["shell_1_A"]
L      = med["span_A"]
eps_f, eps_s = med["eps_fast"], med["eps_slow"]
lam_outer = E2 * (1.0/rD + 1.0/rA - 1.0/L) * (1.0/eps_f - 1.0/eps_s)
L_ss = rD + rA + L
lam_outer_ss = E2 * (1.0/rD + 1.0/rA - 1.0/L_ss) * (1.0/eps_f - 1.0/eps_s)
lam_total = lam_inner + lam_outer
T  = med["temp_K"]; kT = KB * T; Vab = med["coupling_eV"]
pref = (2.0*np.pi/HBAR) * Vab**2 / np.sqrt(4.0*np.pi*lam_total*kT)
k_self = pref * np.exp(-lam_total/(4.0*kT))

with open(f"{OUT}/lambda_summary.csv", "w") as fh:
    fh.write("lambda_4pt_forward_eV,lambda_4pt_backward_eV,lambda_nm_forward_eV,"
             "lambda_nm_backward_eV,lambda_inner_effective_eV,lambda_outer_eV,"
             "lambda_total_eV,k_self_exchange_s_inv\n")
    fh.write(f"{lam4_f:.8f},{lam4_b:.8f},{lamnm_f:.8f},{lamnm_b:.8f},"
             f"{lam_inner:.8f},{lam_outer:.8f},{lam_total:.8f},{k_self:.8e}\n")

dG = grid["axis_eV"].to_numpy()
k  = pref * np.exp(-((dG + lam_total)**2)/(4.0*lam_total*kT))
rate = pd.DataFrame({"grid_id": grid["grid_id"].to_numpy(), "axis_eV": dG,
                     "k_et_s_inv": k, "log10_k_et_s_inv": np.log10(k)})
rate.to_csv(f"{OUT}/rate_curve.csv", index=False)
pk = int(np.argmax(k))
inv_mask = dG < -lam_total
inv_idx  = np.where(inv_mask)[0]

diag = {
    "alignment_rmsd_forward_A":  fwd["rmsd"],
    "alignment_rmsd_backward_A": bwd["rmsd"],
    "closure_error_forward_eV":  abs(lam4_f - lamnm_f),
    "closure_error_backward_eV": abs(lam4_b - lamnm_b),
    "effective_inner_consistency_eV": 0.5*abs(lamnm_f - lamnm_b),
    "rigid_norm_forward":  fwd["rigid"],
    "rigid_norm_backward": bwd["rigid"],
    "projected_norm_forward":  fwd["pnorm"],
    "projected_norm_backward": bwd["pnorm"],
    "dominant_mode_forward":  fwd["dom"],
    "dominant_mode_backward": bwd["dom"],
    "rate_peak_grid_id":  int(grid["grid_id"].iloc[pk]),
    "rate_peak_axis_eV":  float(dG[pk]),
    "rate_peak_s_inv":  float(k[pk]),
    "inverted_region_detected": bool(inv_mask.any()),
    "first_inverted_grid_id":  int(grid["grid_id"].iloc[int(inv_idx[0])]) if inv_mask.any() else -1,
    "first_inverted_axis_eV":  float(dG[int(inv_idx[0])]) if inv_mask.any() else None,
    "outer_lambda_note": (
        "lambda_outer uses center-to-center L=span_A=%.4f A (rD=shell_0_A,rA=shell_1_A): "
        "lambda_outer=%.4f eV. Surface-to-surface alternative L=rD+rA+span=%.4f A gives "
        "lambda_outer=%.4f eV (not used)." % (L, lam_outer, L_ss, lam_outer_ss)),
}
json.dump(diag, open(f"{OUT}/diagnostics.json", "w"), indent=2)

if HAVE_MPL:
    fig, ax = plt.subplots(2, 2, figsize=(13, 9))
    ax[0,0].semilogy(rate["axis_eV"], rate["k_et_s_inv"], "b-", lw=2)
    ax[0,0].plot(rate["axis_eV"].iloc[pk], k[pk], "ro", ms=8, label="peak")
    ax[0,0].axvline(-lam_total, color="gray", ls="--", lw=1, label=f"-lam={-lam_total:.2f} eV")
    ax[0,0].set_xlabel("driving force (eV)"); ax[0,0].set_ylabel("k_ET (s$^{-1}$)")
    ax[0,0].set_title(f"Marcus rate (lam_total={lam_total:.3f} eV)"); ax[0,0].legend()
    x = np.arange(NRET); wbar = 0.4
    ax[0,1].bar(x-wbar/2, fwd["mproj"][:,2], wbar, label="forward (A ref)")
    ax[0,1].bar(x+wbar/2, bwd["mproj"][:,2], wbar, label="backward (B ref)")
    ax[0,1].axvline(fwd["dom"],  color="red",   ls=":", lw=1)
    ax[0,1].axvline(bwd["dom"],  color="green", ls=":", lw=1)
    ax[0,1].set_xlabel("retained mode (0-based)"); ax[0,1].set_ylabel(r"$\tfrac{1}{2}\lambda_k q_k^2$ (eV)")
    ax[0,1].set_title("Per-mode reorganization"); ax[0,1].legend()
    im = ax[1,0].imshow(fwd["overlap"], cmap="viridis", aspect="auto")
    ax[1,0].set_xlabel("source (B) mode"); ax[1,0].set_ylabel("reference (A) mode")
    ax[1,0].set_title("Forward mode-overlap |<A|B>|"); fig.colorbar(im, ax=ax[1,0])
    txt = (f"RMSD  fwd={fwd['rmsd']:.4f} A  bwd={bwd['rmsd']:.4f} A\n"
           f"lam4pt  fwd={lam4_f:.4f}  bwd={lam4_b:.4f} eV\n"
           f"lamnm   fwd={lamnm_f:.4f}  bwd={lamnm_b:.4f} eV\n"
           f"lam_inner_eff={lam_inner:.4f}  lam_outer={lam_outer:.4f} eV\n"
           f"lam_total={lam_total:.4f} eV\n"
           f"k_self={k_self:.3e} 1/s   peak={k[pk]:.3e} 1/s\n"
           f"dominant  fwd={fwd['dom']}  bwd={bwd['dom']}\n"
           f"inverted region: {bool(inv_mask.any())}")
    ax[1,1].axis("off"); ax[1,1].text(0.02, 0.95, txt, family="monospace", fontsize=10, va="top")
    fig.suptitle("Solution-phase ET Marcus reorganization-energy analysis")
    fig.tight_layout(rect=[0, 0, 1, 0.97])
    fig.savefig(f"{OUT}/overview.png", dpi=130)
    plt.close(fig)
else:
    _write_fallback_png(f"{OUT}/overview.png", rate, k, pk, fwd, bwd,
                        lam4_f, lam4_b, lamnm_f, lamnm_b, lam_inner,
                        lam_outer, lam_total, k_self, NRET, inv_mask,
                        fwd['rmsd'], bwd['rmsd'], fwd['dom'], bwd['dom'])

print("=== lambda_summary ==="); print(open(f"{OUT}/lambda_summary.csv").read())
print("=== diagnostics ==="); print(json.dumps(diag, indent=2))
print("rate_curve rows:", len(rate))
print("shapes:", {f: np.load(f"{OUT}/{f}.npy").shape for f in
      ["aligned_displacement_mw","vibrational_basis_mw","mode_overlap",
       "projected_displacement_mw","transported_mode_projection","mode_projection"]})
print("DONE")
