def _png_write(path, px, w, h):
    import zlib, struct
    def chunk(tag, data):
        return (struct.pack(">I", len(data)) + tag + data
                + struct.pack(">I", zlib.crc32(tag + data) & 0xffffffff))
    raw = b"".join(b"\x00" + bytes(px[y * w * 3:(y + 1) * w * 3]) for y in range(h))
    png = (b"\x89PNG\r\n\x1a\n"
           + chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0))
           + chunk(b"IDAT", zlib.compress(raw, 9)) + chunk(b"IEND", b""))
    with open(path, "wb") as fh:
        fh.write(png)

def _plot_fallback(path, rates_df, Tc):
    """Minimal labeled line plot without matplotlib (pure stdlib PNG writer)."""
    W, H = 1000, 640
    px = bytearray([255] * (W * H * 3))
    def put(x, y, col):
        if 0 <= x < W and 0 <= y < H:
            o = (y * W + x) * 3
            px[o:o+3] = bytes(col)
    def line(x1, y1, x2, y2, col, wdt=1):
        n = max(abs(x2 - x1), abs(y2 - y1), 1)
        for k in range(n + 1):
            x = round(x1 + (x2 - x1) * k / n); y = round(y1 + (y2 - y1) * k / n)
            for dx in range(wdt):
                for dy in range(wdt):
                    put(x + dx, y + dy, col)
    def rect(x1, y1, x2, y2, col, fill=False):
        if fill:
            for y in range(y1, y2 + 1):
                for x in range(x1, x2 + 1):
                    put(x, y, col)
        else:
            line(x1, y1, x2, y1, col); line(x1, y2, x2, y2, col)
            line(x1, y1, x1, y2, col); line(x2, y1, x2, y2, col)
    def dashed(x1, y1, x2, y2, col, dash=8):
        n = max(abs(x2 - x1), abs(y2 - y1), 1)
        k = 0
        while k <= n:
            k2 = min(k + dash, n)
            xa = x1 + (x2 - x1) * k / n; ya = y1 + (y2 - y1) * k / n
            xb = x1 + (x2 - x1) * k2 / n; yb = y1 + (y2 - y1) * k2 / n
            line(round(xa), round(ya), round(xb), round(yb), col)
            k += 2 * dash
    def text(x, y, string, col, scale=2):
        for ch in string:
            g = _FONT.get(ch, _FONT[' '])
            for ry, row in enumerate(g):
                for rx, bit in enumerate(row):
                    if bit != '.':
                        rect(x + (rx * scale), y + (ry * scale),
                             x + (rx * scale) + scale - 1,
                             y + (ry * scale) + scale - 1, col)
            x += 6 * scale
    # axes: x log T in [150, 1000], y log10 k in [-2, 9], right axis enh in [0.9, 1.1]
    x0p, x1p, y0p, y1p = 80, 920, 60, 560
    import math as _m
    lx0, lx1 = _m.log10(150.0), _m.log10(1000.0)
    ly0, ly1 = 9.0, -2.0
    ry0, ry1 = 1.10, 0.90
    def PT(T, val):
        return (x0p + (x1p - x0p) * (_m.log10(T) - lx0) / (lx1 - lx0),
                y0p + (y1p - y0p) * (val - ly0) / (ly1 - ly0))
    def RT(val):
        return y0p + (y1p - y0p) * (val - ry0) / (ry1 - ry0)
    rect(x0p, y0p, x1p, y1p, (60, 60, 60))
    for T in (200, 300, 500, 700, 1000):
        gx = round(x0p + (x1p - x0p) * (_m.log10(T) - lx0) / (lx1 - lx0))
        line(gx, y0p, gx, y1p, (225, 225, 225))
        text(gx - 15, y1p + 8, str(T), (0, 0, 0))
    for v in (-2, 0, 2, 4, 6, 8):
        gy = round(y0p + (y1p - y0p) * (v - ly0) / (ly1 - ly0))
        line(x0p, gy, x1p, gy, (225, 225, 225))
        text(x0p - 30, gy - 7, str(v), (0, 0, 0))
    for v in (0.90, 0.95, 1.00, 1.05, 1.10):
        gy = round(RT(v))
        text(x1p + 8, gy - 7, f"{v:.2f}", (0, 0, 0))
    # crossover line
    cx = round(x0p + (x1p - x0p) * (_m.log10(Tc) - lx0) / (lx1 - lx0))
    dashed(cx, y0p, cx, y1p, (120, 120, 120), dash=6)
    # series
    Ts = rates_df["T_K"].to_numpy()
    series = [("log10_k_local_s_inv", (200, 0, 0), True),
              ("log10_k_optimized_s_inv", (0, 0, 200), True),
              ("log10_k_enhanced_s_inv", (0, 140, 0), True)]
    for colname, col, mk in series:
        pts = [PT(T, v) for T, v in zip(Ts, rates_df[colname])]
        for (xa, ya), (xb, yb) in zip(pts, pts[1:]):
            line(round(xa), round(ya), round(xb), round(yb), col, 2)
        for (xa, ya) in pts:
            rect(round(xa) - 3, round(ya) - 3, round(xa) + 3, round(ya) + 3, col, fill=True)
    epts = [(x0p + (x1p - x0p) * (_m.log10(T) - lx0) / (lx1 - lx0), RT(v))
            for T, v in zip(Ts, rates_df["enhancement_factor"])]
    for (xa, ya), (xb, yb) in zip(epts, epts[1:]):
        dashed(round(xa), round(ya), round(xb), round(yb), (0, 0, 0), dash=7)
    # legend
    lx, ly = x0p + 15, y1p - 130
    rect(lx - 8, ly - 10, lx + 150, ly + 88, (255, 255, 255), fill=True)
    rect(lx - 8, ly - 10, lx + 150, ly + 88, (60, 60, 60))
    for k, (label, col) in enumerate([("k_local", (200, 0, 0)), ("k_optimized", (0, 0, 200)),
                                      ("k_enhanced", (0, 140, 0)), ("enh. factor", (0, 0, 0))]):
        yy = ly + k * 24
        if k < 3:
            line(lx, yy + 5, lx + 28, yy + 5, col, 2)
            rect(lx + 11, yy + 2, lx + 17, yy + 8, col, fill=True)
        else:
            dashed(lx, yy + 5, lx + 28, yy + 5, col, dash=5)
        text(lx + 36, yy, label, (0, 0, 0), scale=1)
    text(lx + 36, ly + 96, f"cross-over T = {Tc:.0f} K", (120, 120, 120), scale=1)
    # titles / labels
    text(330, 18, "Rate estimates vs T (light isotope)", (0, 0, 0), scale=2)
    text(470, y1p + 42, "T (K)", (0, 0, 0), scale=2)
    text(14, 280, "log10 k (s^-1)", (0, 0, 0), scale=2)
    text(930, 300, "enh. factor", (0, 0, 0), scale=1)
    _png_write(path, px, W, H)

def make_rate_plot(path):
    Tc = crossover_T(1.0)
    if _HAS_MPL:
        fig, ax1 = plt.subplots(figsize=(8, 5))
        ax1.semilogx(rates_df["T_K"], rates_df["log10_k_local_s_inv"], "o-", label=r"$\log_{10} k_{local}$")
        ax1.semilogx(rates_df["T_K"], rates_df["log10_k_optimized_s_inv"], "s-", label=r"$\log_{10} k_{optimized}$")
        ax1.semilogx(rates_df["T_K"], rates_df["log10_k_enhanced_s_inv"], "^-", label=r"$\log_{10} k_{enhanced}$ (2D action)")
        ax1.axvline(Tc, color="gray", ls=":", label=f"cross-over T = {Tc:.0f} K")
        ax1.set_xlabel("T (K)"); ax1.set_ylabel(r"$\log_{10} k$ (s$^{-1})$"); ax1.grid(alpha=0.3)
        ax2 = ax1.twinx()
        ax2.semilogx(rates_df["T_K"], rates_df["enhancement_factor"], "k--",
                     label=r"enhancement factor $k_{enh}/k_{opt}$")
        ax2.set_ylabel("enhancement factor")
        h1, l1 = ax1.get_legend_handles_labels(); h2, l2 = ax2.get_legend_handles_labels()
        ax1.legend(h1 + h2, l1 + l2, loc="lower left", fontsize=9)
        ax1.set_title("Temperature-dependent rate estimates (light isotope)")
        fig.tight_layout(); fig.savefig(path, dpi=150)
    else:
        _plot_fallback(path, rates_df, Tc)

