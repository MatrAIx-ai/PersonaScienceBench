#!/usr/bin/env python3
"""Deterministic confidence-interval engine forensics.

Reads only data/*, writes analysis artifacts under results/.
No random resampling is generated; all evidence comes from the supplied
deterministic panels.
"""
import json
import os

import numpy as np
import pandas as pd

DATA = "data"
OUT = "results"
os.makedirs(OUT, exist_ok=True)

# ------------------------------------------------------------------ load
man = json.load(open(os.path.join(DATA, "study_manifest.json")))
probe_man = json.load(open(os.path.join(DATA, "probe_manifest.json")))
NOM = float(man["confidence_level"])
alpha = 1.0 - NOM
QLO, QHI = alpha / 2.0, 1.0 - alpha / 2.0

cases = man["cases"]
case_ids = [c["case_id"] for c in cases]
eng_ids = list(man["engine_ids"])
E, C = len(eng_ids), len(case_ids)
families = list(probe_man["probe_families"])
assert len(families) == 5

obs = pd.read_csv(os.path.join(DATA, "observed_samples.csv"))
rp = np.load(os.path.join(DATA, "resample_panels.npz"))
cal_s = np.load(os.path.join(DATA, "calibration_samples.npz"))
cal_p = np.load(os.path.join(DATA, "calibration_resample_panels.npz"))
d = np.load(os.path.join(DATA, "engine_interval_panels.npz"))

assert list(d["case_ids"]) == case_ids
assert [str(x) for x in d["engine_ids"]] == eng_ids

obs_vals = {}
for c in case_ids:
    sub = obs[obs.case_id == c].sort_values("observation_id")
    obs_vals[c] = sub["value"].to_numpy(dtype=float)

OL, OH = d["observed_low"], d["observed_high"]          # (E, C)
CL, CH = d["calibration_low"], d["calibration_high"]    # (E, C, 108)
P2L, P2H = d["probe_panel_02_low"], d["probe_panel_02_high"]   # (E, C)
P3L, P3H = d["probe_panel_03_low"], d["probe_panel_03_high"]   # (E, C, 6)
BL, BH = d["baseline_low"], d["baseline_high"]          # (C,)
OST = d["observed_stat"]                                # (C,)

# ------------------------------------------------------------- statistics
def stat_of(v, name, params):
    v = np.asarray(v, dtype=float)
    if name == "mean":
        return float(np.mean(v))
    if name == "median":
        return float(np.median(v))
    if name == "coefficient_of_variation":
        return float(np.std(v, ddof=int(params.get("std_ddof", 1))) / np.mean(v))
    if name == "upper_tail_rate":
        thr = float(params["threshold"])
        if params.get("comparison", ">=") == ">=":
            return float(np.mean(v >= thr))
        return float(np.mean(v > thr))
    raise ValueError(name)

# sanity: public observed_stat must match recomputation
for i, c in enumerate(cases):
    s = stat_of(obs_vals[c["case_id"]], c["statistic_name"], c["statistic_parameters"])
    assert abs(s - OST[i]) < 1e-9, (c["case_id"], s, OST[i])

# per-case population target: plug-in statistic on pooled calibration values
target = np.array([
    stat_of(cal_s[c["case_id"]].ravel(), c["statistic_name"], c["statistic_parameters"])
    for c in cases
])

# ------------------------------------------------- percentile reference
R = 108
rows = np.arange(R)[:, None, None]

def boot_stat(samp, panel, name, params):
    vals = samp[rows, panel]  # (R, B, 74)
    if name == "mean":
        return vals.mean(axis=2)
    if name == "median":
        return np.median(vals, axis=2)
    if name == "coefficient_of_variation":
        return vals.std(axis=2, ddof=1) / vals.mean(axis=2)
    if name == "upper_tail_rate":
        return np.mean(vals >= float(params["threshold"]), axis=2)
    raise ValueError(name)

ref_lo = np.zeros((C, R))
ref_hi = np.zeros((C, R))
rep_stat = np.zeros((C, R))
for i, c in enumerate(cases):
    samp, panel = cal_s[c["case_id"]], cal_p[c["case_id"]]
    boots = boot_stat(samp, panel, c["statistic_name"], c["statistic_parameters"])
    ref_lo[i] = np.quantile(boots, QLO, axis=1)
    ref_hi[i] = np.quantile(boots, QHI, axis=1)
    rep_stat[i] = np.array([
        stat_of(samp[r], c["statistic_name"], c["statistic_parameters"]) for r in range(R)
    ])

# ------------------------------------------------------- coverage audit
t3 = target[None, :, None]  # (1, C, 1)
covered = (CL <= t3) & (t3 <= CH)          # (E, C, R)
miss_lo = (t3 < CL).mean(axis=2)
miss_hi = (t3 > CH).mean(axis=2)
emp_cov = covered.mean(axis=2)
cal_width = (CH - CL).mean(axis=2)
cal_center = ((CL + CH) / 2.0) - target[None, :, None]

cov_rows = []
for e in range(E):
    for i in range(C):
        cov_rows.append({
            "case_id": case_ids[i],
            "regime": cases[i]["regime"],
            "engine_id": eng_ids[e],
            "nominal_coverage": round(NOM, 6),
            "empirical_coverage": round(emp_cov[e, i], 6),
            "mean_width": round(cal_width[e, i], 6),
            "miss_low_rate": round(miss_lo[e, i], 6),
            "miss_high_rate": round(miss_hi[e, i], 6),
            "n_replications": R,
            "coverage_score": round(1.0 - abs(emp_cov[e, i] - NOM), 6),
        })
pd.DataFrame(cov_rows).to_csv(os.path.join(OUT, "coverage_audit.csv"), index=False)

# ------------------------------------------------------- alias evidence
DC = 3  # discrete case index
deficit3 = np.maximum(0.0, NOM - emp_cov[:, DC])
dev3 = np.abs(OL[:, DC] - BL[DC]) + np.abs(OH[:, DC] - BH[DC])
exact_rate = np.zeros(E)
refl_rate = np.zeros(E)
nondisc = [i for i in range(C) if i != DC]
for e in range(E):
    ex = rf = 0
    for i in range(C):
        elo, ehi = CL[e, i], CH[e, i]
        rl, rh, s = ref_lo[i], ref_hi[i], rep_stat[i]
        m = (np.abs(elo - rl) < 1e-9) & (np.abs(ehi - rh) < 1e-9)
        ex += int(m.sum())
        if i in nondisc:
            rf += int(((np.abs(elo - (2 * s - rh)) < 1e-6)
                       & (np.abs(ehi - (2 * s - rl)) < 1e-6)).sum())
    exact_rate[e] = ex / (C * R)
    refl_rate[e] = rf / (len(nondisc) * R)

obs_refl_dev = (np.abs(OL - (2 * OST[None, :] - BH[None, :]))
                + np.abs(OH - (2 * OST[None, :] - BL[None, :]))).mean(axis=1)

grid = 1.0 / 74.0  # case_03 statistic = k/74
def offgrid(x):
    return np.abs(x - np.round(x / grid) * grid)
offgrid3 = (
    offgrid(CL[:, DC]).mean() + offgrid(CH[:, DC]).mean()
    + offgrid(OL[:, DC]) + offgrid(OH[:, DC])
)

# ------------------------------------------------------- probe diagnostics
# probe_00 (neutral, observed-case panel): distance from pooled target to the
# engine's observed interval (0 when covered) -- finite, 0 for covering engines.
d00 = np.where(OL <= target[None, :],
               np.where(target[None, :] <= OH, 0.0, target[None, :] - OH),
               OL - target[None, :])
# probe_01 (calibration panel): per-case coverage gap
d01 = np.abs(emp_cov - NOM)
# probe_02 (scale-response panel): deviation of width response from the
# cross-engine consensus median; the scale-invariant CV case is anchored at 1.
p2w, obs_w = P2H - P2L, OH - OL
ratios2 = p2w / obs_w
ref2 = np.median(ratios2, axis=0)
for i, c in enumerate(cases):
    if c["statistic_name"] == "coefficient_of_variation":
        ref2[i] = 1.0
d02 = np.abs(ratios2 - ref2[None, :])
# probe_03 (perturbation subpanels): deviation from cross-engine median
# consensus, averaged over the 6 subpanels
med3l, med3h = np.median(P3L, axis=0), np.median(P3H, axis=0)
d03 = np.mean(np.abs(P3L - med3l[None]) + np.abs(P3H - med3h[None]), axis=2)
p3w = P3H - P3L
p3c = (P3H + P3L) / 2.0
p3_var = (p3w.std(axis=2) + p3c.std(axis=2)).mean(axis=1)  # (E,)
# probe_04 (public-baseline deviation): distance from baseline percentile CIs
d04 = np.abs(OL - BL[None, :]) + np.abs(OH - BH[None, :])

D = {"probe_00": d00, "probe_01": d01, "probe_02": d02, "probe_03": d03, "probe_04": d04}

probe_rows = []
prof_rows = []
score_table = np.zeros((C, 5, E))
for i in range(C):
    for k, fam in enumerate(families):
        v = D[fam][:, i]
        lo, hi = v.min(), v.max()
        sc = (v - lo) / (hi - lo) if hi > lo else np.zeros(E)
        score_table[i, k] = sc
        for e in range(E):
            probe_rows.append({
                "case_id": case_ids[i],
                "probe_family": fam,
                "engine_id": eng_ids[e],
                "diagnostic_value": round(float(v[e]), 6),
                "diagnostic_score": round(float(sc[e]), 6),
            })
    for e in range(E):
        row = {"case_id": case_ids[i], "engine_id": eng_ids[e]}
        for k, fam in enumerate(families):
            row["probe_signal_%02d" % k] = round(float(D[fam][e, i]), 6)
        row["profile_score"] = round(float(score_table[i].mean(axis=0)[e]), 6)
        prof_rows.append(row)
pd.DataFrame(probe_rows).to_csv(os.path.join(OUT, "probe_audit.csv"), index=False)
pd.DataFrame(prof_rows).to_csv(os.path.join(OUT, "case_probe_profile.csv"), index=False)

# ------------------------------------------------------- engine audit
def nm(x):
    x = np.asarray(x, dtype=float)
    r = x.max() - x.min()
    return (x - x.min()) / r if r > 0 else np.zeros_like(x)

cov_gap = d01.mean(axis=1)
tail_imb = np.abs(miss_lo - miss_hi).mean(axis=1)
w_ratio = (obs_w / (BH - BL)[None, :]).mean(axis=1)
w_deficit = np.maximum(0.0, 1.0 - obs_w / (BH - BL)[None, :]).mean(axis=1)
dispersion = d01.std(axis=1, ddof=0)
pm = np.array([D[f].mean(axis=1) for f in families])  # (5, E)

components = {
    "coverage_gap": cov_gap,
    "tail_imbalance": tail_imb,
    "width_deficit": w_deficit,
    "case_dispersion": dispersion,
    **{"probe_%02d" % k: pm[k] for k in range(5)},
}

def combined_score(exclude=None):
    keys = [k for k in components if k != exclude]
    return np.mean([nm(components[k]) for k in keys], axis=0)

full_score = combined_score()

audit_rows = []
for e in range(E):
    row = {
        "engine_id": eng_ids[e],
        "coverage_gap": round(cov_gap[e], 6),
        "tail_imbalance": round(tail_imb[e], 6),
        "width_ratio": round(w_ratio[e], 6),
        "case_dispersion": round(dispersion[e], 6),
    }
    for k in range(5):
        row["probe_metric_%02d" % k] = round(pm[k, e], 6)
    row["engine_score"] = round(float(full_score[e]), 6)
    audit_rows.append(row)
pd.DataFrame(audit_rows).to_csv(os.path.join(OUT, "engine_audit.csv"), index=False)

ranking = np.argsort(full_score, kind="stable")
selected = eng_ids[int(ranking[0])]
sel_e = int(ranking[0])

# ------------------------------------------------------- failure labels
shape_gap = d01[:, [1, 5]].mean(axis=1)
shape_center = np.abs(cal_center[:, [1, 5]]).mean(axis=(1, 2))
ev = {
    "reliable_engine": 1.0 - (0.45 * nm(cov_gap) + 0.15 * nm(tail_imb)
                              + 0.40 * nm(pm.mean(axis=0))),
    "baseline_quantile_alias": 0.5 * nm(exact_rate) + 0.3 * (1.0 - nm(dev3))
                               + 0.2 * nm(w_deficit),
    "reflection_alias": 0.6 * nm(refl_rate) + 0.4 * nm(obs_refl_dev),
    "discrete_boundary_mismatch": 0.5 * nm(deficit3) + 0.5 * nm(offgrid3),
    "shape_correction_mismatch": 0.4 * nm(shape_gap) + 0.6 * nm(shape_center),
    "scale_response_mismatch": nm(pm[2]),
    "noise_amplifying_engine": 0.6 * nm(p3_var) + 0.4 * nm(pm[3]),
}
vocab = man["failure_label_vocabulary"]
predicted = {}
for e in range(E):
    order = sorted(range(len(vocab)), key=lambda j: (-ev[vocab[j]][e], j))
    predicted[e] = vocab[order[0]]

fe_rows = []
for e in range(E):
    order = sorted(range(len(vocab)), key=lambda j: (-ev[vocab[j]][e], j))
    for rank, j in enumerate(order, start=1):
        fe_rows.append({
            "engine_id": eng_ids[e],
            "failure_label": vocab[j],
            "evidence_score": round(float(ev[vocab[j]][e]), 6),
            "label_rank": rank,
            "is_predicted_label": 1 if vocab[j] == predicted[e] else 0,
        })
pd.DataFrame(fe_rows).to_csv(os.path.join(OUT, "failure_evidence.csv"), index=False)

json.dump({
    "selected_engine_id": selected,
    "failure_modes": {eng_ids[e]: predicted[e] for e in range(E)},
}, open(os.path.join(OUT, "failure_modes.json"), "w"), indent=2)

# ------------------------------------------------------- interval summary
ist_rows = []
for i in range(C):
    sw = OH[sel_e, i] - OL[sel_e, i]
    bw = BH[i] - BL[i]
    ist_rows.append({
        "case_id": case_ids[i],
        "statistic_name": cases[i]["statistic_name"],
        "observed_stat": round(float(OST[i]), 6),
        "selected_engine_id": selected,
        "selected_low": round(float(OL[sel_e, i]), 6),
        "selected_high": round(float(OH[sel_e, i]), 6),
        "baseline_low": round(float(BL[i]), 6),
        "baseline_high": round(float(BH[i]), 6),
        "selected_width": round(float(sw), 6),
        "baseline_width_ratio": round(float(sw / bw), 6),
    })
pd.DataFrame(ist_rows).to_csv(os.path.join(OUT, "interval_summary.csv"), index=False)

# ------------------------------------------------------- family ablation
abl_rows = []
abl = {}
for excl in ["none"] + families:
    key = None if excl == "none" else "probe_%02d" % families.index(excl)
    sc = combined_score(exclude=key)
    order = np.argsort(sc, kind="stable")
    abl[excl] = (order, sc)
    abl_rows.append({
        "excluded_probe_family": excl,
        "top_engine_id": eng_ids[int(order[0])],
        "selected_engine_rank": int(np.where(order == sel_e)[0][0]) + 1,
        "runner_up_engine_id": eng_ids[int(order[1])],
        "score_margin": round(float(max(0.0, sc[order[1]] - sc[order[0]])), 6),
    })
pd.DataFrame(abl_rows).to_csv(os.path.join(OUT, "family_ablation.csv"), index=False)

# ------------------------------------------------------- reliability report
case_warnings = {}
for i in range(C):
    miss_eng = [eng_ids[e] for e in range(E) if d00[e, i] > 0]
    low_cov = [eng_ids[e] for e in range(E) if emp_cov[e, i] < NOM - 0.03]
    note = []
    if miss_eng:
        note.append("%d/9 engines miss the pooled calibration target in the observed interval: %s"
                    % (len(miss_eng), ", ".join(miss_eng)))
    if low_cov:
        note.append("calibration coverage below nominal-0.03 for: %s" % ", ".join(low_cov))
    if i == DC:
        note.append("discrete statistic with point-mass ties; endpoints sit on the k/74 grid")
    case_warnings[case_ids[i]] = "; ".join(note) if note else "no warning"

json.dump({
    "selected_engine_id": selected,
    "aggregate_coverage_gap": round(float(cov_gap[sel_e]), 6),
    "aggregate_tail_imbalance": round(float(tail_imb[sel_e]), 6),
    "aggregate_probe_score": round(float(pm[:, sel_e].mean()), 6),
    "engine_ranking": [eng_ids[int(r)] for r in ranking],
    "case_warnings": case_warnings,
}, open(os.path.join(OUT, "reliability_report.json"), "w"), indent=2)

# ------------------------------------------------------- selected engine
json.dump({
    "selected_engine_id": selected,
    "selected_failure_mode": predicted[sel_e],
    "selected_engine_score": round(float(full_score[sel_e]), 6),
}, open(os.path.join(OUT, "selected_engine.json"), "w"), indent=2)


# ------------------------------------------------------- figure
def _write_png(path, w, h, rgb):
    import zlib, struct
    def chunk(tag, data):
        c = struct.pack(">I", len(data)) + tag + data
        return c + struct.pack(">I", zlib.crc32(tag + data) & 0xFFFFFFFF)
    raw = b"".join(b"\x00" + rgb[y * w * 3:(y + 1) * w * 3] for y in range(h))
    png = b"\x89PNG\r\n\x1a\n"
    png += chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0))
    png += chunk(b"IDAT", zlib.compress(raw, 9))
    png += chunk(b"IEND", b"")
    with open(path, "wb") as f:
        f.write(png)

def _bar_panel(rgb, x0, y0, pw, ph, bars, vmax, ref=None, color=(31, 119, 180)):
    w, h = len(rgb) // 3, None
    # frame
    for x in range(x0, x0 + pw):
        for y in (y0, y0 + ph - 1):
            rgb[(y0 + (ph - 1 - y) * w * 3 + x * 3): (y0 + (ph - 1 - y) * w * 3 + x * 3 + 3)] = bytes((17, 17, 17))
    for y in range(y0, y0 + ph):
        rgb[(y * w * 3 + x0 * 3): (y * w * 3 + x0 * 3 + 3)] = bytes((17, 17, 17))
        rgb[(y * w * 3 + (x0 + pw - 1) * 3): (y * w * 3 + (x0 + pw - 1) * 3 + 3)] = bytes((17, 17, 17))
    n = len(bars)
    bw = pw // (2 * n + 1)
    for i, b in enumerate(bars):
        bh = int(min(1.0, max(0.0, b / vmax)) * (ph - 8))
        bx = x0 + bw * (2 * i + 1)
        for y in range(y0 + ph - 1 - bh, y0 + ph - 1):
            for x in range(bx, bx + bw):
                rgb[(y * w * 3 + x * 3): (y * w * 3 + x * 3 + 3)] = bytes(color)
    if ref is not None:
        ry = y0 + ph - 1 - int(min(1.0, ref / vmax) * (ph - 8))
        for x in range(x0, x0 + pw):
            rgb[(ry * w * 3 + x * 3): (ry * w * 3 + x * 3 + 3)] = bytes((214, 39, 40))

def _fallback_figure(path, cov_mean, scores, nom):
    W, H = 1200, 560
    rgb = bytearray(b"\xff" * (W * H * 3))
    pw, ph = 540, 440
    _bar_panel(rgb, 30, 60, pw, ph, list(cov_mean), 1.0, ref=nom, color=(31, 119, 180))
    _bar_panel(rgb, 630, 60, pw, ph, list(scores), max(scores.max(), 1e-9), color=(255, 127, 14))
    # header stripe
    for x in range(W):
        for y in range(0, 24):
            rgb[(y * W + x) * 3: (y * W + x) * 3 + 3] = bytes((250, 250, 250))
    _write_png(path, W, H, bytes(rgb))

try:
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt
    fig, axes = plt.subplots(2, 3, figsize=(16, 9))
    fig.suptitle("Anonymous CI engine audit (nominal coverage %.4f)" % NOM)
    ax = axes[0, 0]
    ax.bar(range(E), emp_cov.mean(axis=1), tick_label=["e%02d" % e for e in range(E)])
    ax.axhline(NOM, color="r", ls="--", lw=1, label="nominal %.4f" % NOM)
    ax.set_title("Mean calibration coverage"); ax.legend()
    ax = axes[0, 1]
    ax.bar(range(E), w_ratio, tick_label=["e%02d" % e for e in range(E)])
    ax.axhline(1.0, color="r", ls="--", lw=1)
    ax.set_title("Width ratio vs baseline percentile")
    ax = axes[0, 2]
    im = ax.imshow(pm.T, aspect="auto", cmap="viridis")
    ax.set_xticks(range(5), ["p%02d" % k for k in range(5)])
    ax.set_yticks(range(E), ["e%02d" % e for e in range(E)])
    ax.set_title("Probe metrics (engine x family)"); fig.colorbar(im, ax=ax)
    ax = axes[1, 0]
    ax.bar(range(E), tail_imb, tick_label=["e%02d" % e for e in range(E)])
    ax.set_title("Tail imbalance")
    ax = axes[1, 1]
    xw = np.arange(len(vocab))
    for e in range(E):
        ax.bar(xw + (e - E / 2) * 0.1, [ev[v][e] for v in vocab], width=0.1,
               label="e%02d" % e)
    ax.set_xticks(xw, [v.replace("_", "\n", 1) for v in vocab], fontsize=6, rotation=30)
    ax.set_title("Failure-label evidence"); ax.legend(fontsize=6, ncol=3)
    ax = axes[1, 2]
    names = ["none"] + families
    margins = [abl[n][1][abl[n][0][1]] - abl[n][1][abl[n][0][0]] for n in names]
    ax.bar(range(len(names)), margins, tick_label=names)
    ax.set_title("Ablation top-2 score margin")
    fig.tight_layout()
    fig.savefig(os.path.join(OUT, "engine_overview.png"), dpi=110)
except ImportError:
    _fallback_figure(os.path.join(OUT, "engine_overview.png"),
                     emp_cov.mean(axis=1), full_score, NOM)


# ------------------------------------------------------- console summary
print("selected:", selected, "score %.6f" % full_score[sel_e])
print("ranking:", [eng_ids[int(r)] for r in ranking])
print("scores:", np.round(full_score, 5).tolist())
print("predicted labels:", {eng_ids[e]: predicted[e] for e in range(E)})
print("ablation selected ranks:", {r["excluded_probe_family"]: r["selected_engine_rank"]
                                   for r in abl_rows})
print("coverage gaps:", np.round(cov_gap, 4).tolist())
print("probe metrics:\n", np.round(pm, 5))
print("exact_rate:", np.round(exact_rate, 4).tolist())
print("refl_rate:", np.round(refl_rate, 4).tolist())
