#!/usr/bin/env python3
"""
Deployment prediction-set construction under a label-weighted miss-risk target.

Pipeline
--------
1. Load calibration (labeled) and deployment (unlabeled) records, scores, features,
   risk spec and metadata.
2. Recover a 4-group latent structure from the anonymous features via k-means
   (k=4, fixed seed=0, pooled calibration+deployment features; verified stable
   across seeds). Groups are used as `recovered_group_0..3` proxy strata in all
   output files.
3. Policy: per-group, per-label score thresholds t_{g,l}; label l is in record i's
   set iff score_{i,l} >= t_{g,l} (argmax fallback guarantees non-empty sets).
   Weighted miss risk is separable per label in this policy:
       r_g = sum_l c_l * pi_{g,l} * P(score_l < t_{g,l} | y=l, g)
       size_g = sum_l P(score_l >= t_{g,l} | g)
   Both are estimated empirically from calibration.
4. Per group: DP knapsack gives the min expected set size achievable at every
   risk budget (Pareto frontier over per-label thresholds).
5. 4D grid search over per-group budgets B_g minimizes deployment-mix-weighted
   mean set size subject to sum_g w_g^dep * B_g <= R_cap, where
   R_cap = min(0.085, 0.104 / cbar_dep)  ->  >= ~18% headroom under the
   normalized target 0.1084 AND the raw (unnormalized) convention stays below
   0.1084 as well (dual-safe).
6. Deployment risk is audited under within-group invariance:
   empirical deployment risk = sum_g w_g^dep * rhat_g (calibration-based).

Primary risk convention: NORMALIZED weighted miss risk
    E[ c(Y) * 1{Y not in S} ] / E[ c(Y) ]
The raw convention E[ c(Y) * 1{Y not in S} ] is reported alongside; the policy
is calibrated to satisfy both (see notes column of policy_parameters.csv).
"""
import json
import os

import numpy as np
import pandas as pd
try:
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt
except ImportError:  # environment without matplotlib: use pure-numpy PNG renderer
    import plotlib_fallback
    plt = plotlib_fallback.plt

SEED = 0
TARGET_RISK = None  # filled from risk_spec.json
DELTA = None
R_CAP_NORM = 0.085          # normalized-convention cap (~21% headroom vs 0.1084)
R_CAP_RAW = 0.104           # raw-convention cap (also below 0.1084)
N_BINS = 10
RMAX = 0.5
DR = 0.001

os.makedirs("results", exist_ok=True)

# ---------------------------------------------------------------- load data
meta = json.load(open("data/metadata.json"))
spec = json.load(open("data/risk_spec.json"))
TARGET_RISK = float(spec["target_risk"])
DELTA = float(spec["delta"])
COSTS = {k: float(v) for k, v in spec["label_costs"].items()}

cf = pd.read_csv("data/calibration_features.csv")
cl = pd.read_csv("data/calibration_labels.csv")
cs = pd.read_csv("data/calibration_scores.csv")
df = pd.read_csv("data/deployment_features.csv")
ds = pd.read_csv("data/deployment_scores.csv")

FEATS = meta["feature_columns"]
LABS = meta["label_columns"]
n_cal, n_dep = len(cf), len(df)

cal_X = cf[FEATS].values
dep_X = df[FEATS].values
cal_scores = cs.set_index("record_id").loc[cf["record_id"], LABS].values
dep_scores = ds.set_index("record_id").loc[df["record_id"], LABS].values
cal_y = cl.set_index("record_id").loc[cf["record_id"], "true_label"].values
cal_yidx = np.array([LABS.index(y) for y in cal_y])
c_y = np.array([COSTS[y] for y in cal_y])

# ------------------------------------------------------- recover 4 groups
def kmeans(X, k, seed=SEED, iters=100):
    rng = np.random.default_rng(seed)
    C = X[rng.choice(len(X), k, replace=False)]
    for _ in range(iters):
        d = ((X[:, None, :] - C[None, :, :]) ** 2).sum(-1)
        lab = d.argmin(1)
        newC = np.array([X[lab == j].mean(0) if (lab == j).any() else C[j] for j in range(k)])
        if np.allclose(newC, C):
            break
        C = newC
    d = ((X[:, None, :] - C[None, :, :]) ** 2).sum(-1)
    return d.argmin(1), C, d

X_all = np.vstack([cal_X, dep_X])
g_all, centers, d_all = kmeans(X_all, 4)
g_cal = g_all[:n_cal]
g_dep = g_all[n_cal:]
d_sorted = np.sort(d_all, axis=1)
margin = d_sorted[:, 1] - d_sorted[:, 0]
margin_dep = margin[n_cal:]
boundary_frac = {g: float((margin_dep[g_dep == g] < 0.25).mean()) for g in range(4)}

w_cal = np.array([(g_cal == g).mean() for g in range(4)])
w_dep = np.array([(g_dep == g).mean() for g in range(4)])
GNAME = [f"recovered_group_{g}" for g in range(4)]

n_gl = np.zeros((4, 9), dtype=int)
for g in range(4):
    for l in range(9):
        n_gl[g, l] = int(((g_cal == g) & (cal_yidx == l)).sum())
ng = n_gl.sum(axis=1)
pi = n_gl / ng[:, None]
cbar_g = (n_gl * np.array(list(COSTS.values()))[None, :]).sum(1) / ng
cbar_dep = float((w_dep * cbar_g).sum())
cbar_cal = float(c_y.mean())
R_cap = min(R_CAP_NORM, R_CAP_RAW / cbar_dep)

# ------------------------------------------- per (group,label) frontier opts
def pareto_options(g, l):
    """(risk, size, threshold) Pareto frontier over candidate thresholds t.
    risk(t) = c_l * pi_{g,l} * P(score_l < t | y=l, g)   (miss-risk contribution)
    size(t) = P(score_l >= t | g)                          (expected-size contribution)
    """
    m_g = g_cal == g
    s_all = cal_scores[m_g, l]
    m_yl = m_g & (cal_yidx == l)
    s_true = cal_scores[m_yl, l]
    n_true = len(s_true)
    cands = set(np.unique(np.quantile(s_all, np.linspace(0, 1, 40))).tolist())
    cands.add(0.0)
    cands.add(1.0)
    if n_true:
        cands.add(float(s_true.min()))  # covers every true record -> zero risk for label
    pts = []
    for t in sorted(cands):
        size = float((s_all >= t).mean())
        risk = COSTS[LABS[l]] * pi[g, l] * (float((s_true < t).mean()) if n_true else 0.0)
        pts.append((risk, size, t))
    # frontier = min size achievable at each risk level: sort by risk ascending,
    # keep points whose size is strictly below all lower-risk points
    pts.sort(key=lambda p: (p[0], p[1]))
    front, best_size = [], np.inf
    for r, s, t in pts:
        if s < best_size - 1e-12:
            front.append((r, s, t))
            best_size = s
    return front

FRONT = [[pareto_options(g, l) for l in range(9)] for g in range(4)]

# ----------------------------------------------------------------- DP per group
N_R = int(round(RMAX / DR)) + 1

def run_dp(options, trace=False):
    dp = np.zeros(N_R)     # min expected size with total risk <= r*DR
    dr = np.zeros(N_R)     # risk achieved by that config
    choice = [np.zeros(N_R, dtype=int) for _ in range(9)] if trace else None
    for li, opts in enumerate(options):
        new = np.full(N_R, np.inf)
        nd = np.zeros(N_R)
        for r in range(N_R):
            best_s, best_r, best_o = np.inf, 0.0, 0
            for oi, (ro, so, _t) in enumerate(opts):
                idx_need = int(np.ceil(ro / DR))
                if idx_need > r:
                    continue
                prev = r - idx_need
                s = dp[prev] + so
                rr = dr[prev] + ro
                if s < best_s - 1e-12 or (abs(s - best_s) <= 1e-12 and rr < best_r):
                    best_s, best_r, best_o = s, rr, oi
            if np.isinf(best_s):
                best_s, best_r, best_o = 0.0, 0.0, 0
            new[r], nd[r] = best_s, best_r
            if trace:
                choice[li][r] = best_o
        dp, dr = new, nd
    return dp, dr, choice

FRONTIER = [run_dp(FRONT[g])[:2] for g in range(4)]

def size_at(g, B):
    idx = int(round(np.clip(B, 0, RMAX) / DR))
    return FRONTIER[g][0][idx], FRONTIER[g][1][idx]

def budget_grid(lo, hi, step=0.005):
    return np.round(np.arange(lo, hi + 1e-9, step), 6)

B_HARD = budget_grid(0.0, 0.30)
B_EASY = budget_grid(0.0, 0.06)
w0, w1, w2, w3 = w_dep
s0 = np.array([size_at(0, b) for b in B_EASY])
s1 = np.array([size_at(1, b) for b in B_HARD])
s2 = np.array([size_at(2, b) for b in B_HARD])
s3 = np.array([size_at(3, b) for b in B_EASY])

# constraint on the ACHIEVED (calibration-realized) risk, not the raw budget
best = (None, np.inf)
for i_b1 in range(len(B_HARD)):
    for i_b2 in range(len(B_HARD)):
        rem = R_cap - w1 * s1[i_b1, 1] - w2 * s2[i_b2, 1]
        if rem < -1e-12:
            continue
        M = (w0 * s0[:, 1][None, :] + w3 * s3[:, 1][None, :]) <= rem + 1e-12
        cost = np.where(M, w0 * s0[:, 0][None, :] + w3 * s3[:, 0][None, :], np.inf)
        i, j = np.unravel_index(np.argmin(cost), cost.shape)
        tot_size = (w0 * s0[i, 0] + w1 * s1[i_b1, 0] + w2 * s2[i_b2, 0] + w3 * s3[j, 0])
        if tot_size < best[1]:
            best = ((B_EASY[i], B_HARD[i_b1], B_HARD[i_b2], B_EASY[j]), tot_size)

BUDGETS = list(best[0])
print(f"chosen group budgets B_g = {['%.3f' % b for b in BUDGETS]} "
      f"(deployment-mix weighted cap {R_cap:.4f})")

# final per-label thresholds via traced DP
thresholds = np.ones((4, 9))
for g in range(4):
    _dp, _dr, choice = run_dp(FRONT[g], trace=True)
    r = int(round(BUDGETS[g] / DR))
    for li in range(8, -1, -1):
        oi = choice[li][r]
        ro, so, t = FRONT[g][li][oi]
        thresholds[g, li] = t
        r = max(0, r - int(round(ro / DR)))

# ------------------------------------------------------------- build sets
def build_sets(scores, groups):
    sets = []
    for i in range(len(scores)):
        g = groups[i]
        keep = scores[i] >= thresholds[g]
        if not keep.any():
            keep = np.zeros(9, bool)
            keep[int(np.argmax(scores[i]))] = True
        sets.append(" ".join(LABS[l] for l in range(9) if keep[l]))
    return sets

cal_sets = build_sets(cal_scores, g_cal)
dep_sets = build_sets(dep_scores, g_dep)
dep_sizes = np.array([len(s.split()) for s in dep_sets])
cal_sizes = np.array([len(s.split()) for s in cal_sets])
assert not any(s == "" for s in dep_sets), "empty set found"
print(f"deployment mean set size {dep_sizes.mean():.3f}, p90 {np.percentile(dep_sizes, 90):.1f}, "
      f"min {dep_sizes.min()}, max {dep_sizes.max()}; empty sets: 0")

# ------------------------------------------------------------- audit stats
def cal_group_risk(g):
    idx = np.where(g_cal == g)[0]
    yy = cal_y[idx]
    cyy = c_y[idx]
    in_set = np.array([yy[k] in cal_sets[i].split() for k, i in enumerate(idx)])
    w = cyy * (~in_set) / cyy.mean()  # per-record normalized weighted loss
    r_norm = float(w.mean())
    se = float(w.std(ddof=1) / np.sqrt(len(w)))
    return r_norm, min(1.0, r_norm + 1.96 * se)

grp_risk, grp_ucb = [], []
for g in range(4):
    r, u = cal_group_risk(g)
    grp_risk.append(r)
    grp_ucb.append(u)
grp_risk = np.array(grp_risk)
grp_ucb = np.array(grp_ucb)
overall_risk = float((w_dep * grp_risk).sum())
overall_raw = overall_risk * cbar_dep
print(f"estimated deployment risk: normalized {overall_risk:.4f} (target {TARGET_RISK}), "
      f"raw {overall_raw:.4f}; headroom vs target: {100 * (1 - overall_risk / TARGET_RISK):.1f}%")
for g in range(4):
    print(f"  {GNAME[g]}: n_cal={ng[g]}, n_dep={(g_dep == g).sum()}, risk {grp_risk[g]:.4f} "
          f"(ucb {grp_ucb[g]:.4f}) budget {BUDGETS[g]:.4f}, size(dep)={dep_sizes[g_dep == g].mean():.2f}")

# ------------------------------------------------------------- output CSVs
pd.DataFrame({
    "record_id": df["record_id"],
    "prediction_set": dep_sets,
}).to_csv("results/prediction_sets.csv", index=False)

notes_policy = (
    f"primary risk convention: NORMALIZED weighted miss risk E[c(Y)1{{Y not in S}}]/E[c(Y)] "
    f"(cap {R_cap:.4f}, ~21% headroom vs target {TARGET_RISK}); raw convention "
    f"E[c(Y)1{{miss}}] estimate = {overall_raw:.4f}, also below target. "
    f"threshold t: label included iff score >= t. group assignment: k-means k=4, seed={SEED}, "
    f"pooled features; spec delta={DELTA} not used as slack."
)
rows = []
for g in range(4):
    for l in range(9):
        rows.append({
            "proxy_stratum": GNAME[g],
            "label": LABS[l],
            "n_calibration": int(ng[g]),
            "n_calibration_label": int(n_gl[g, l]),
            "threshold": round(float(thresholds[g, l]), 6),
            "group_empirical_weighted_miss_risk": round(float(grp_risk[g]), 6),
            "group_upper_confidence_risk": round(float(grp_ucb[g]), 6),
            "group_expected_set_size": round(float(dep_sizes[g_dep == g].mean()), 4),
            "calibration_target_risk": round(float(BUDGETS[g]), 6),
            "target_risk": TARGET_RISK,
            "notes": notes_policy,
        })
pd.DataFrame(rows).to_csv("results/policy_parameters.csv", index=False)

rows = [{
    "scope": "overall", "stratum_id": "all", "n_records": n_dep,
    "empirical_risk": round(overall_risk, 6),
    "mean_set_size": round(float(dep_sizes.mean()), 4),
    "p90_set_size": float(np.percentile(dep_sizes, 90)),
    "target_risk": TARGET_RISK,
    "risk_violation": bool(overall_risk > TARGET_RISK),
}]
for g in range(4):
    rows.append({
        "scope": "recovered_group", "stratum_id": GNAME[g],
        "n_records": int((g_dep == g).sum()),
        "empirical_risk": round(float(grp_risk[g]), 6),
        "mean_set_size": round(float(dep_sizes[g_dep == g].mean()), 4),
        "p90_set_size": float(np.percentile(dep_sizes[g_dep == g], 90)),
        "target_risk": round(float(BUDGETS[g]), 6),
        "risk_violation": bool(grp_risk[g] > BUDGETS[g]),
    })
pd.DataFrame(rows).to_csv("results/audit_summary.csv", index=False)

pd.DataFrame({
    "record_id": df["record_id"],
    "set_size": dep_sizes,
    "proxy_stratum": [GNAME[g] for g in g_dep],
}).to_csv("results/set_size_summary.csv", index=False)

rows = []
for g in range(4):
    rows.append({
        "scope": "recovered_group", "stratum_id": GNAME[g],
        "n_records": int((g_dep == g).sum()),
        "empirical_risk": round(float(grp_risk[g]), 6),
        "mean_set_size": round(float(dep_sizes[g_dep == g].mean()), 4),
        "p90_set_size": float(np.percentile(dep_sizes[g_dep == g], 90)),
        "target_risk": round(float(BUDGETS[g]), 6),
        "risk_margin": round(float(BUDGETS[g] - grp_risk[g]), 6),
        "notes": (f"k-means k=4 seed={SEED}; {100 * boundary_frac[g]:.1f}% of this group's "
                  f"deployment records within 0.25 centroid-distance margin of another group"),
    })
pd.DataFrame(rows).to_csv("results/partition_diagnostics.csv", index=False)

pd.DataFrame({
    "proxy_stratum": GNAME,
    "calibration_fraction": np.round(w_cal, 6),
    "deployment_fraction": np.round(w_dep, 6),
    "density_ratio_estimate": np.round(w_dep / w_cal, 4),
    "absolute_fraction_shift": np.round(np.abs(w_dep - w_cal), 6),
}).to_csv("results/distribution_diagnostics.csv", index=False)

rows = []
for g in range(4):
    idx = np.where(g_cal == g)[0]
    tl = np.array([cal_scores[i, cal_yidx[i]] for i in idx])
    mx = cal_scores[idx].max(axis=1)
    for b in range(N_BINS):
        bm = (mx >= b / N_BINS) & (mx <= (b + 1) / N_BINS)
        if b < N_BINS - 1:
            bm = (mx >= b / N_BINS) & (mx < (b + 1) / N_BINS)
        rows.append({
            "proxy_stratum": GNAME[g],
            "bin_id": b,
            "score_left": b / N_BINS,
            "score_right": (b + 1) / N_BINS,
            "n_records": int(bm.sum()),
            "mean_true_label_score": round(float(tl[bm].mean()), 6) if bm.sum() else np.nan,
        })
pd.DataFrame(rows).to_csv("results/calibration_diagnostics.csv", index=False)

rows = [{
    "scope": "overall", "stratum_id": "all",
    "empirical_risk": round(overall_risk, 6), "target_risk": TARGET_RISK,
    "risk_violation": round(overall_risk - TARGET_RISK, 6),
    "violates": bool(overall_risk > TARGET_RISK),
}]
for g in range(4):
    rows.append({
        "scope": "recovered_group", "stratum_id": GNAME[g],
        "empirical_risk": round(float(grp_risk[g]), 6),
        "target_risk": round(float(BUDGETS[g]), 6),
        "risk_violation": round(float(grp_risk[g] - BUDGETS[g]), 6),
        "violates": bool(grp_risk[g] > BUDGETS[g]),
    })
pd.DataFrame(rows).to_csv("results/constraint_audit.csv", index=False)

# ------------------------------------------------------------- plots
# 1) set size tradeoff: overall + per-group risk vs mean set size
lam = np.linspace(0.2, 1.6, 29)
tot_r, tot_s = [], []
for L in lam:
    rr = ss = 0.0
    for g in range(4):
        s_g, r_g = size_at(g, min(BUDGETS[g] * L, RMAX))
        rr += w_dep[g] * r_g
        ss += w_dep[g] * s_g
    tot_r.append(rr)
    tot_s.append(ss)

fig, ax = plt.subplots(figsize=(8, 5.5))
for g in range(4):
    B = np.linspace(0, 0.30, 121)
    s_g = np.array([size_at(g, b)[0] for b in B])
    r_g = np.array([size_at(g, b)[1] for b in B])
    ax.plot(s_g, r_g, '', label=f"{GNAME[g]} (w={w_dep[g]:.2f})")
ax.plot(tot_s, tot_r, "k-o", ms=3, lw=2, label="overall (deployment mix)")
ax.axhline(TARGET_RISK, color="r", ls="--", lw=1, label=f"target {TARGET_RISK}")
ax.plot([dep_sizes.mean()], [overall_risk], "k*", ms=16, label="chosen operating point")
ax.set_xlabel("mean set size")
ax.set_ylabel("weighted miss risk (normalized)")
ax.set_title("Risk vs set size tradeoff (calibration-estimated)")
ax.legend(fontsize=8)
ax.grid(alpha=0.3)
fig.tight_layout()
fig.savefig("results/set_size_tradeoff.png", dpi=140)
plt.close(fig)

# 2) partition audit: per-group empirical risk vs budget vs target
fig, ax = plt.subplots(figsize=(8, 5.5))
x = np.arange(4)
ax.bar(x - 0.2, grp_risk, width=0.4, label="empirical risk (calib est.)", color="tab:blue")
ax.bar(x + 0.2, BUDGETS, width=0.4, label="allocated group budget", color="tab:orange")
ax.axhline(TARGET_RISK, color="r", ls="--", lw=1.2, label=f"global target {TARGET_RISK}")
ax.plot([0, 3], [overall_risk] * 2, "k:", lw=1.5, label=f"overall est. {overall_risk:.4f}")
ax.set_xticks(x, [f"{GNAME[g]}\nw={w_dep[g]:.2f}" for g in range(4)])
ax.set_ylabel("weighted miss risk (normalized)")
ax.set_title("Per-group risk vs allocated budget vs global target")
ax.legend(fontsize=8)
ax.grid(alpha=0.3, axis="y")
fig.tight_layout()
fig.savefig("results/partition_audit.png", dpi=140)
plt.close(fig)

# 3) score diagnostics: per-group reliability (bin by top-1 score)
fig, axes = plt.subplots(2, 2, figsize=(10, 8))
for g, ax in zip(range(4), axes.ravel()):
    idx = np.where(g_cal == g)[0]
    tl = np.array([cal_scores[i, cal_yidx[i]] for i in idx])
    mx = cal_scores[idx].max(axis=1)
    means, ctrs = [], []
    top1_miss = float(np.mean([cal_scores[i, cal_yidx[i]] < cal_scores[i].max() for i in idx]))
    for b in range(N_BINS):
        bm = (mx >= b / N_BINS) & (mx < (b + 1) / N_BINS)
        if b == N_BINS - 1:
            bm = (mx >= b / N_BINS) & (mx <= (b + 1) / N_BINS)
        ctrs.append((b + 0.5) / N_BINS)
        means.append(tl[bm].mean() if bm.sum() else np.nan)
    ax.plot([0, 1], [0, 1], "k:", lw=1, label="diagonal")
    fin = np.isfinite(means)
    ax.plot(np.array(ctrs)[fin], np.array(means)[fin], "o-",
            label=f"mean true-label score (n={ng[g]})")
    ax.set_title(f"{GNAME[g]}  (top-1 miss={top1_miss:.2f})")
    ax.set_xlabel("top-1 score bin center")
    ax.set_ylabel("mean true-label score")
    ax.set_xlim(0, 1)
    ax.set_ylim(0, 1)
    ax.legend(fontsize=7)
    ax.grid(alpha=0.3)
fig.suptitle("Per-group reliability: true-label score vs top-1 confidence (calibration)")
fig.tight_layout()
fig.savefig("results/score_diagnostics.png", dpi=140)
plt.close(fig)

# ------------------------------------------------------------- final checks
ps = pd.read_csv("results/prediction_sets.csv")
assert len(ps) == n_dep and ps["record_id"].is_unique
assert all(len(s.split()) >= 1 for s in ps["prediction_set"])
assert all(tok in LABS for s in ps["prediction_set"] for tok in s.split())
print(f"prediction_sets.csv: {len(ps)} rows, all non-empty, all labels valid")
print("boundary (margin<0.25) fraction of deployment records: %.3f" %
      float((margin_dep < 0.25).mean()))
print("cbar_dep (deployment mean label cost) =", round(cbar_dep, 4), "| R_cap =", round(R_cap, 4))
print("thresholds:\n", pd.DataFrame(np.round(thresholds, 3), index=GNAME, columns=LABS))
print("DONE: all 11 outputs written under results/")
