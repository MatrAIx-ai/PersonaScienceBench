NAMED = {'tab:blue': (31, 119, 180), 'tab:orange': (255, 127, 14),
         'tab:green': (44, 160, 44), 'tab:red': (214, 39, 40),
         'black': (0, 0, 0), 'white': (255, 255, 255), 'gray': (128, 128, 128)}
SHORT = {'k': (0, 0, 0), 'r': (214, 39, 40), 'b': (31, 119, 180),
         'g': (44, 160, 44), 'c': (23, 190, 207), 'm': (148, 103, 189),
         'y': (255, 255, 0)}
CYCLE = [(31, 119, 180), (255, 127, 14), (44, 160, 44), (214, 39, 40),
         (148, 103, 189), (140, 86, 75), (227, 119, 194), (127, 127, 127)]

def text_bitmap(s, scale=2):
    rows = []
    for r in range(7):
        row = []
        for ch in s:
            g = FONT.get(ch, FONT[' '])
            row.extend([c == '#' for c in g[r]])
        if r < 6:
            row.append(False)
    rows = np.array(rows)
    if scale != 1:
        rows = np.kron(rows, np.ones((scale, scale), bool))
    return rows

def write_png(path, arr):
    h, w, _ = arr.shape
    raw = b''.join(b'\x00' + arr[i].tobytes() for i in range(h))
    def chunk(t, d):
        return struct.pack('>I', len(d)) + t + d + struct.pack('>I', zlib.crc32(t + d) & 0xffffffff)
    with open(path, 'wb') as f:
        f.write(b'\x89PNG\r\n\x1a\n')
        f.write(chunk(b'IHDR', struct.pack('>IIBBBBB', w, h, 8, 2, 0, 0, 0)))
        f.write(chunk(b'IDAT', zlib.compress(raw, 9)))
        f.write(chunk(b'IEND', b''))

def _line(img, x0, y0, x1, y1, color, width=1, dash=None):
    x0, y0, x1, y1 = int(x0), int(y0), int(x1), int(y1)
    n = max(abs(x1 - x0), abs(y1 - y0), 1)
    for t in range(n + 1):
        x = int(round(x0 + (x1 - x0) * t / n))
        y = int(round(y0 + (y1 - y0) * t / n))
        if dash == 'dotted' and t % 4 != 0:
            continue
        if dash == 'dashed' and (t % 10) >= 6:
            continue
        for dx in range(width):
            for dy in range(width):
                xx, yy = x + dx, y + dy
                if 0 <= xx < img.shape[1] and 0 <= yy < img.shape[0]:
                    img[yy, xx] = color

def _rect(img, x0, y0, x1, y1, color):
    x0, y0, x1, y1 = int(x0), int(y0), int(x1), int(y1)
    x0, x1 = min(x0, x1), max(x0, x1)
    y0, y1 = min(y0, y1), max(y0, y1)
    x0, y0 = max(0, x0), max(0, y0)
    x1, y1 = min(img.shape[1] - 1, x1), min(img.shape[0] - 1, y1)
    if x1 >= x0 and y1 >= y0:
        img[y0:y1 + 1, x0:x1 + 1] = color

def _draw_text(img, x, y, s, scale=2, color=(0, 0, 0), align='left', rotate=False):
    bm = text_bitmap(s, scale)
    if rotate:
        bm = np.rot90(bm, 1)
    h, w = bm.shape
    if align == 'center':
        x = x - w // 2
    elif align == 'right':
        x = x - w
    x, y = int(x), int(y)
    for r in range(h):
        for c in range(w):
            if bm[r, c]:
                xx, yy = x + c, y + r
                if 0 <= xx < img.shape[1] and 0 <= yy < img.shape[0]:
                    img[yy, xx] = color

def _marker(img, x, y, kind, size, color):
    if size < 2:
        return
    if kind == 'o':
        for a in range(0, 360, 20):
            xx = x + size * np.cos(np.radians(a))
            yy = y + size * np.sin(np.radians(a))
            _line(img, x, y, xx, yy, color, 1)
    elif kind == '*':
        for a in range(0, 360, 36):
            xx = x + size * np.cos(np.radians(a))
            yy = y + size * np.sin(np.radians(a))
            _line(img, x, y, xx, yy, color, 1)

def nice_ticks(lo, hi, n=6):
    if hi <= lo:
        hi = lo + 1
    span = hi - lo
    step0 = span / n
    mag = 10 ** np.floor(np.log10(step0))
    step = mag
    for m in (1, 2, 5, 10):
        if step0 <= m * mag:
            step = m * mag
            break
    t0 = np.ceil(lo / step) * step
    return np.round(np.arange(t0, hi + 1e-9, step), 10)

class Ax:
    def __init__(self, img, region):
        self.img = img
        self.x0, self.y0, self.x1, self.y1 = region
        self.xlim = None
        self.ylim = None
        self.data = []
        self.items = []
        self.xticks = None
        self.xtick_labels = None
        self._nc = 0

    def _transform(self):
        if self.xlim is None:
            xs = np.concatenate([d[0] for d in self.data]) if self.data else np.array([0, 1])
            ys = np.concatenate([d[1] for d in self.data]) if self.data else np.array([0, 1])
            pad_x = 0.08 * (xs.max() - xs.min() + 1e-9)
            self.xlim = (xs.min() - pad_x, xs.max() + pad_x)
            pad_y = 0.08 * (ys.max() - ys.min() + 1e-9)
            self.ylim = (max(0.0, ys.min() - pad_y), ys.max() + pad_y)
        (xlo, xhi), (ylo, yhi) = self.xlim, self.ylim
        W = self.x1 - self.x0
        H = self.y1 - self.y0
        def X(x):
            return self.x0 + (x - xlo) / (xhi - xlo) * W
        def Y(y):
            return self.y1 - (y - ylo) / (yhi - ylo) * H
        return X, Y

    def plot(self, x, y, fmt='b-', lw=1.5, ms=6, label=None, color=None, ls=None, marker=None):
        x = np.atleast_1d(np.asarray(x, float))
        y = np.atleast_1d(np.asarray(y, float))
        self.data.append((x, y))
        fc = color
        if fc is None:
            fc = CYCLE[self._nc % len(CYCLE)]
            self._nc += 1
        elif fc in SHORT:
            fc = SHORT[fc]
        elif fc in NAMED:
            fc = NAMED[fc]
        lsf, mkf = ls, marker
        if fmt:
            i = 0
            if i < len(fmt) and fmt[i] in SHORT:
                fc = SHORT[fmt[i]]
                i += 1
            while i < len(fmt) and fmt[i] in '-:.':
                lsf = fmt[i]
                i += 1
            if i < len(fmt) and fmt[i] in 'o*':
                mkf = fmt[i]
                i += 1
        width = max(1, int(round(lw * 1.3)))
        dash = 'dotted' if lsf == ':' else ('dashed' if lsf == '--' else None)
        X, Y = self._transform()
        px = X(x)
        py = Y(y)
        if len(x) > 1:
            for i in range(len(x) - 1):
                _line(self.img, px[i], py[i], px[i + 1], py[i + 1], fc, width, dash)
        if mkf:
            step = max(1, len(x) // 25)
            for i in range(0, len(x), step):
                _marker(self.img, px[i], py[i], mkf, max(2, int(ms * 0.6)), fc)
        if label:
            self.items.append((fc, lsf or '-', mkf, label))
        return []

    def bar(self, x, h, width=0.8, color='tab:blue', label=None):
        x = np.atleast_1d(np.asarray(x, float))
        h = np.atleast_1d(np.asarray(h, float))
        self.data.append((x, np.maximum(h, np.zeros_like(h))))
        fc = NAMED.get(color, color if isinstance(color, tuple) else CYCLE[0])
        X, Y = self._transform()
        base = Y(0)
        for xi, hi in zip(x, h):
            _rect(self.img, X(xi - width / 2), Y(hi), X(xi + width / 2), base, fc)
        if label:
            self.items.append((fc, '-', None, label))

    def axhline(self, y, color='k', ls='-', lw=1, label=None):
        fc = SHORT.get(color, NAMED.get(color, (0, 0, 0)))
        X, Y = self._transform()
        dash = 'dotted' if ls == ':' else ('dashed' if ls == '--' else None)
        _line(self.img, self.x0, Y(y), self.x1, Y(y), fc, max(1, int(lw * 1.3)), dash)
        self.data.append((np.array([0, 1]), np.array([y, y])))
        if label:
            self.items.append((fc, ls, None, label))

    def set_xlim(self, a, b):
        self.xlim = (a, b)

    def set_ylim(self, a, b):
        self.ylim = (a, b)

    def set_xlabel(self, s, scale=2):
        _draw_text(self.img, (self.x0 + self.x1) // 2, self.y1 + 30, s, scale, align='center')

    def set_ylabel(self, s, scale=2):
        _draw_text(self.img, self.x0 - 16, (self.y0 + self.y1) // 2, s, scale, align='center', rotate=True)

    def set_title(self, s, scale=2):
        _draw_text(self.img, (self.x0 + self.x1) // 2, self.y0 - 24, s, scale, align='center')

    def set_xticks(self, vals, labels=None):
        self.xticks = np.atleast_1d(np.asarray(vals, float))
        self.xtick_labels = labels

    def grid(self, alpha=None, axis=None):
        X, Y = self._transform()
        gray = (225, 225, 225)
        xt = self.xticks if self.xticks is not None else nice_ticks(*self.xlim)
        yt = nice_ticks(*self.ylim)
        if axis in (None, 'x'):
            for t in xt:
                _line(self.img, X(t), self.y0, X(t), self.y1, gray, 1)
        if axis in (None, 'y'):
            for t in yt:
                _line(self.img, self.x0, Y(t), self.x1, Y(t), gray, 1)

    def _draw_frame(self):
        X, Y = self._transform()
        black = (0, 0, 0)
        _rect(self.img, self.x0, self.y0, self.x0, self.y1, black)
        _rect(self.img, self.x0, self.y1, self.x1, self.y1, black)
        xt = self.xticks if self.xticks is not None else nice_ticks(*self.xlim)
        yt = nice_ticks(*self.ylim)
        for t in xt:
            _line(self.img, X(t), self.y1, X(t), self.y1 + 4, black, 1)
            lab = None
            if self.xtick_labels is not None and len(self.xtick_labels) == len(xt):
                k = int(round(float(t)))
                if abs(t - k) < 1e-9:
                    lab = str(self.xtick_labels[k])
            if lab is None:
                lab = '%g' % t
            for k2, line in enumerate(str(lab).split('\n')):
                _draw_text(self.img, X(t), self.y1 + 8 + 14 * k2, line, 2, align='center')
        for t in yt:
            _line(self.img, self.x0 - 4, Y(t), self.x0, Y(t), black, 1)
            _draw_text(self.img, self.x0 - 8, Y(t) - 7, '%g' % t, 2, align='right')

    def legend(self, fontsize=8, loc='upper right'):
        if not self.items:
            return
        scale = 2
        items = self.items
        maxw = max(text_bitmap(i[3], scale).shape[1] for i in items)
        bw = maxw + 44
        bh = len(items) * 18 + 8
        cx = self.x1 - bw - 6 if loc == 'upper right' else self.x0 + 6
        cy = self.y0 + 6
        _rect(self.img, cx, cy, cx + bw, cy + bh, (255, 255, 255))
        _rect(self.img, cx, cy, cx + bw, cy, (150, 150, 150))
        _rect(self.img, cx, cy + bh, cx + bw, cy + bh, (150, 150, 150))
        _rect(self.img, cx, cy, cx, cy + bh, (150, 150, 150))
        _rect(self.img, cx + bw, cy, cx + bw, cy + bh, (150, 150, 150))
        for k, (fc, lsf, mkf, lab) in enumerate(items):
            yy = cy + 10 + k * 18
            dash = 'dotted' if lsf == ':' else ('dashed' if lsf == '--' else None)
            _line(self.img, cx + 6, yy, cx + 30, yy, fc, 2, dash)
            if mkf:
                _marker(self.img, cx + 18, yy, mkf, 4, fc)
            _draw_text(self.img, cx + 38, yy - 7, lab, scale)

class Fig:
    def __init__(self, figsize, nrows, ncols, dpi=140):
        self.W = int(figsize[0] * dpi)
        self.H = int(figsize[1] * dpi)
        self.img = np.ones((self.H, self.W, 3), np.uint8) * 255
        self.axes = []
        pad = 8
        top = 20 if nrows > 1 else 4
        cw = (self.W - pad * (ncols + 1)) // ncols
        ch = (self.H - pad * (nrows + 1) - top) // nrows
        for r in range(nrows):
            for c in range(ncols):
                x0 = pad + c * (cw + pad) + 56
                y0 = self.H - pad - (r + 1) * (ch + pad) - top + 44
                x1 = x0 + cw - 12
                y1 = y0 + ch - 10
                self.axes.append(Ax(self.img, (x0, y0, x1, y1)))

    def suptitle(self, s):
        _draw_text(self.img, self.W // 2, 4, s, 3, align='center')

    def tight_layout(self):
        pass

    def savefig(self, path, dpi=140):
        for ax in self.axes:
            ax._draw_frame()
            ax.legend()
        write_png(path, self.img)

class _PLT:
    def subplots(self, nrows=1, ncols=1, figsize=(8, 5.5), **kw):
        fig = Fig(figsize, nrows, ncols)
        if nrows == 1 and ncols == 1:
            return fig, fig.axes[0]
        return fig, np.array(fig.axes).reshape(nrows, ncols)

    def close(self, fig=None):
        pass

plt = _PLT()
