"""
Stable latent-state (HMM) fitting for repeated categorical streams.
Hand-built with NumPy/SciPy only: log-space Baum-Welch (EM) + Viterbi.
No black-box sequence/HMM/probabilistic-programming packages imported.
"""
import json, os
import numpy as np
import pandas as pd
from scipy.special import logsumexp

RNG_SEED_BASE = 1000        # restart seeds: 1000 + 7*R + run
SELF_SEEDS = (90001, 90002) # two extra independent runs for reproducibility self-check
EPS = 1e-12                 # positivity floor applied before renormalization
MAX_ITER = 300
TOL = 1e-8
GRID = [2, 3, 4, 5, 6, 8, 10]
N_RESTARTS = 10

meta = json.load(open("data/metadata.json"))
K = len(meta["alphabet"])
SYM_LABEL = {int(a["symbol"]): a["label"] for a in meta["alphabet"]}
df = pd.read_csv("data/sequences.csv").sort_values("global_index").reset_index(drop=True)
assert list(df.columns) == ["global_index", "sequence_id", "position", "symbol", "symbol_label"]
assert (df["global_index"].to_numpy() == np.arange(len(df))).all()
seq_order = list(dict.fromkeys(df["sequence_id"].tolist()))
seqs, seq_onehot = [], []
for sid in seq_order:
    x = df.loc[df["sequence_id"] == sid, "symbol"].to_numpy(dtype=np.int64)
    seqs.append(x)
    oh = np.zeros((len(x), K), dtype=np.float64)
    oh[np.arange(len(x)), x] = 1.0
    seq_onehot.append(oh)
N = len(df)

def floor_norm(M, axis):
    M = np.maximum(M, EPS)
    return M / M.sum(axis=axis, keepdims=True)

def e_step(logpi, logA, logB):
    R = logA.shape[0]
    ll_total, ll_seq, gammas, pis = 0.0, [], [], []
    xi_sum = np.zeros((R, R)); bcnt = np.zeros((R, K))
    E_logA = np.exp(logA)
    lre = np.logaddexp.reduce
    for x, oh in zip(seqs, seq_onehot):
        T = len(x); lBx = logB.T[x]
        alpha = np.empty((T, R)); alpha[0] = logpi + lBx[0]
        for t in range(1, T):
            alpha[t] = lre(alpha[t-1][:, None] + logA, axis=0) + lBx[t]
        beta = np.zeros((T, R))
        for t in range(T-2, -1, -1):
            beta[t] = lre(logA + (lBx[t+1] + beta[t+1])[None, :], axis=1)
        ll = lre(alpha[-1]); ll_total += ll; ll_seq.append(ll)
        gamma = np.exp(alpha + beta - ll)
        gammas.append(gamma); pis.append(gamma[0])
        bcnt += gamma.T @ oh
        # xi sums vectorized with max-shift:
        # xi_sum(i,j) = sum_t exp(alpha_t(i) + logA(i,j) + lBx_{t+1}(j) + beta_{t+1}(j) - ll)
        A_ = alpha[:-1]; B_ = lBx[1:] + beta[1:]
        at = A_.max(axis=1); bt = B_.max(axis=1)
        Mt = at + bt                            # per-t joint max of A_t(i)+B_t(j)
        m = Mt.max()
        E = np.exp(A_ - at[:, None])
        C = np.exp(B_ - bt[:, None]) * np.exp(Mt - m)[:, None]
        xi_sum += (E.T @ C) * np.exp(logA + m - ll)
    return ll_total, np.array(ll_seq), gammas, xi_sum, bcnt, pis

def m_step(xi_sum, bcnt, pis):
    pi = floor_norm(np.mean(pis, axis=0), 0)
    A = xi_sum / np.maximum(xi_sum.sum(1, keepdims=True), 1e-300)
    A[xi_sum.sum(1) < 1e-12] = 1.0 / A.shape[0]
    A = floor_norm(A, 1)
    B = bcnt / np.maximum(bcnt.sum(1, keepdims=True), 1e-300)
    B[bcnt.sum(1) < 1e-12] = 1.0 / K
    B = floor_norm(B, 1)
    return pi, A, B

def fit_hmm(R, seed, record_trace=True):
    rng = np.random.default_rng(seed)
    logpi = np.log(floor_norm(rng.dirichlet(np.ones(R)), 0))
    logA = np.log(floor_norm(rng.dirichlet(np.ones(R), size=R), 1))
    logB = np.log(floor_norm(rng.dirichlet(np.ones(K), size=R), 1))
    trace, prev, first = [], None, None
    for it in range(MAX_ITER):
        ll, ll_seq, gammas, xi_sum, bcnt, pis = e_step(logpi, logA, logB)
        rel = 0.0 if prev is None else (ll - prev) / abs(first)
        if record_trace:
            trace.append((it, ll, rel))
        if prev is not None and abs(ll - prev) < TOL * max(1.0, abs(prev)):
            break
        if prev is None:
            first = ll
        prev = ll
        pi, A, B = m_step(xi_sum, bcnt, pis)
        logpi, logA, logB = np.log(pi), np.log(A), np.log(B)
    ll, ll_seq, gammas, xi_sum, bcnt, pis = e_step(logpi, logA, logB)
    return {"ll": ll, "ll_seq": ll_seq, "gammas": gammas,
            "pi": np.exp(logpi), "A": np.exp(logA), "B": np.exp(logB),
            "trace": trace, "iters": len(trace)}

def relabel(f, total_mass):
    keys = [f["B"][:, k] for k in range(K)] + [-total_mass]
    order = np.lexsort(keys)
    f["A"] = f["A"][order][:, order]
    f["B"] = f["B"][order]
    f["pi"] = f["pi"][order]
    f["gammas"] = [g[:, order] for g in f["gammas"]]
    return f

def viterbi(f, x):
    logpi, logA, logB = np.log(f["pi"]), np.log(f["A"]), np.log(f["B"])
    R = logA.shape[0]; T = len(x); lBx = logB.T[x]
    delta = logpi + lBx[0]; psi = np.zeros((T, R), dtype=np.int64)
    for t in range(1, T):
        m = delta[:, None] + logA
        psi[t] = np.argmax(m, axis=0)
        mx = m.max(axis=0)
        delta = mx + np.log(np.exp(m - mx[None, :]).sum(axis=0)) + lBx[t]
    path = np.zeros(T, dtype=np.int64); path[-1] = int(np.argmax(delta))
    for t in range(T-2, -1, -1):
        path[t] = psi[t+1, path[t+1]]
    return path

def tv(a, b):
    return 0.5 * np.abs(a - b).sum()

def candidate_metrics(f, R):
    gamma = np.vstack(f["gammas"])
    mass = gamma.sum(0) / gamma.shape[0]
    maxg = gamma.max(1)
    ent = -np.where(gamma > 0, gamma * np.log2(np.maximum(gamma, 1e-300)), 0.0).sum(1)
    ohK = np.eye(K)
    prof = np.zeros((R, K))
    for x, g in zip(seqs, f["gammas"]):
        prof += g[:-1].T @ ohK[x[1:]]
    prof = prof / np.maximum(prof.sum(1, keepdims=True), 1e-300)
    min_em = min(tv(f["B"][i], f["B"][j]) for i in range(R) for j in range(R) if i < j)
    min_nt = min(tv(prof[i], prof[j]) for i in range(R) for j in range(R) if i < j)
    occ = np.array([(gamma.argmax(1) == i).mean() for i in range(R)])
    return {"min_row_mass": float(mass.min()), "mean_max_gamma": float(maxg.mean()),
            "mean_post_entropy_bits": float(ent.mean()),
            "frac_confident": float((maxg >= 0.5).mean()),
            "min_emission_tv": float(min_em), "min_next_symbol_tv": float(min_nt),
            "min_row_occupancy": float(occ.min()), "row_mass": mass,
            "gamma": gamma, "maxg": maxg, "ent": ent, "prof": prof}

def free_vals(R):
    return (R - 1) + R * (R - 1) + R * (K - 1)

# ---------------- per-fit cache (transparent; keeps repeated runs fast) ----------------
import hashlib
def _cache_key():
    h = hashlib.md5()
    h.update(open("data/sequences.csv", "rb").read())
    h.update(repr((GRID, N_RESTARTS, RNG_SEED_BASE, SELF_SEEDS, MAX_ITER, TOL, EPS, K)).encode())
    return h.hexdigest()[:12]
CK = _cache_key()
CACHE_DIR = os.path.join(".fit_cache", CK)

def fit_hmm_cached(R, seed, record_trace=True):
    path = os.path.join(CACHE_DIR, f"fit_R{R}_s{seed}.npz")
    if os.path.exists(path):
        z = np.load(path)
        return {"ll": float(z["ll"]), "ll_seq": z["ll_seq"],
                "gammas": [z[f"g{i}"] for i in range(len(z["ll_seq"]))],
                "pi": z["pi"], "A": z["A"], "B": z["B"],
                "trace": z["trace"], "iters": int(z["iters"])}
    f = fit_hmm(R, seed, record_trace=record_trace)
    os.makedirs(CACHE_DIR, exist_ok=True)
    z = {"ll": np.float64(f["ll"]), "ll_seq": f["ll_seq"],
         "pi": f["pi"], "A": f["A"], "B": f["B"],
         "trace": np.array(f["trace"], dtype=np.float64), "iters": np.int64(f["iters"])}
    for i in range(len(f["gammas"])):
        z[f"g{i}"] = f["gammas"][i]
    np.savez(path, **z)
    return f

# ---------------- candidate fits ----------------
print("Fitting candidates ...")
fits, mets = {}, {}
for R in GRID:
    best = None
    for run in range(N_RESTARTS):
        f = fit_hmm_cached(R, RNG_SEED_BASE + 7 * R + run)
        if best is None or f["ll"] > best["ll"] + 1e-12:
            best = f
    total_mass = np.sum([g.sum(axis=0) for g in best["gammas"]], axis=0)
    fits[R] = relabel(best, total_mass)
    mets[R] = candidate_metrics(best, R)
    print(f"  R={R:2d}  ll={best['ll']:14.3f}  iters={best['iters']:3d}  "
          f"min_row_mass={mets[R]['min_row_mass']:.4f}  min_emTV={mets[R]['min_emission_tv']:.3f} "
          f"mean_max_gamma={mets[R]['mean_max_gamma']:.3f}")

rows = []
for R in GRID:
    m = mets[R]; ll = fits[R]["ll"]; fv = free_vals(R)
    rows.append((R, "log_likelihood", ll, fv))
    rows.append((R, "bic", ll - 0.5 * fv * np.log(N), fv))
    rows.append((R, "aic", ll - 2.0 * fv, fv))
    rows.append((R, "min_row_mass", m["min_row_mass"], fv))
    rows.append((R, "mean_max_gamma", m["mean_max_gamma"], fv))
    rows.append((R, "mean_post_entropy_bits", m["mean_post_entropy_bits"], fv))
    rows.append((R, "frac_confident", m["frac_confident"], fv))
    rows.append((R, "min_emission_tv", m["min_emission_tv"], fv))
    rows.append((R, "min_next_symbol_tv", m["min_next_symbol_tv"], fv))
    rows.append((R, "min_row_occupancy", m["min_row_occupancy"], fv))
for i in range(1, len(GRID)):
    R, Rp = GRID[i], GRID[i-1]
    dll = fits[R]["ll"] - fits[Rp]["ll"]; dfv = free_vals(R) - free_vals(Rp)
    rows.append((R, "delta_ll", dll, free_vals(R)))
    rows.append((R, "delta_ll_per_free_value", dll / dfv, free_vals(R)))
    if i < len(GRID) - 1:
        Rn = GRID[i+1]
        rows.append((R, "delta_ll_out_per_free_value",
                     (fits[Rn]["ll"] - fits[R]["ll"]) / (free_vals(Rn) - free_vals(R)), free_vals(R)))

def quality(R):
    m = mets[R]
    return (m["min_row_mass"] >= 0.02 and m["min_emission_tv"] >= 0.1
            and m["min_next_symbol_tv"] >= 0.02 and m["mean_max_gamma"] >= 0.5)

def flattens(R):
    i = GRID.index(R)
    if i == 0:
        return False
    gin = (fits[R]["ll"] - fits[GRID[i-1]]["ll"]) / (free_vals(R) - free_vals(GRID[i-1]))
    if i == len(GRID) - 1:
        return True
    gout = (fits[GRID[i+1]]["ll"] - fits[R]["ll"]) / (free_vals(GRID[i+1]) - free_vals(R))
    return gout < 0.5 * gin

chosen = next((R for R in GRID if quality(R) and flattens(R)), None)
if chosen is None:
    scores = {R: min(mets[R]["min_row_mass"]/0.02, mets[R]["min_emission_tv"]/0.1,
                     mets[R]["min_next_symbol_tv"]/0.02,
                     mets[R]["mean_max_gamma"]/0.5, 1.0) for R in GRID}
    chosen = max(GRID, key=lambda R: (scores[R], -R))
    print("NOTE: no candidate met all quality+flattening gates; fallback quality-score selection used.")
print(f"Chosen R = {chosen}")

cs = pd.DataFrame([(R, fv, v, c, R == chosen) for (R, c, v, fv) in rows],
                  columns=["candidate", "n_free_values", "objective", "criterion", "chosen"])
os.makedirs("results", exist_ok=True)
cs.to_csv("results/candidate_summary.csv", index=False)

# ---------------- final model outputs ----------------
f = fits[chosen]; R = chosen
A, B, pi = f["A"], f["B"], f["pi"]
gammas = f["gammas"]

pd.DataFrame([(int(i), int(j), float(A[i, j])) for i in range(R) for j in range(R)],
             columns=["row", "column", "value"]).to_csv("results/matrix_a.csv", index=False)
pd.DataFrame([(int(i), int(k), SYM_LABEL[k], float(B[i, k])) for i in range(R) for k in range(K)],
             columns=["row", "symbol", "symbol_label", "value"]).to_csv("results/matrix_b.csv", index=False)
pd.DataFrame([(int(i), float(pi[i])) for i in range(R)],
             columns=["row", "value"]).to_csv("results/vector_a.csv", index=False)

# fit_trace: chosen R only, all 10 independent restarts, one row per EM iteration
tr = []
for run in range(N_RESTARTS):
    ft = fit_hmm_cached(R, RNG_SEED_BASE + 7 * R + run, record_trace=True)
    tr0 = float(ft["trace"][0][1])
    for row in ft["trace"]:
        step, ll = int(row[0]), float(row[1])
        tr.append((run, step, ll, 0.0 if step == 0 else (ll - float(ft["trace"][step-1][1])) / abs(tr0)))
pd.DataFrame(tr, columns=["run", "step", "objective", "relative_change"]).to_csv("results/fit_trace.csv", index=False)

gamma_all = np.vstack(gammas)
np.save("results/local_weights.npy", gamma_all.astype(np.float64))
out = df[["sequence_id", "position", "global_index"]].copy()
out["label"] = gamma_all.argmax(1).astype(int)
out.to_csv("results/local_assignments.csv", index=False)

v = np.ones(R) / R
for _ in range(20000):
    vn = v @ A; vn /= vn.sum()
    if np.abs(vn - v).max() < 1e-13:
        v = vn; break
    v = vn
joint = v[:, None] * A
pd.DataFrame([(int(i), int(j), float(A[i, j]), float(joint[i, j]), float(A[i, j]))
              for i in range(R) for j in range(R)],
             columns=["row", "column", "weight", "joint_fraction", "conditional_value"]) \
    .to_csv("results/neighbor_summary.csv", index=False)

sd = []
for sid, x, g, ll in zip(seq_order, seqs, gammas, f["ll_seq"]):
    ent = -np.where(g > 0, g * np.log2(np.maximum(g, 1e-300)), 0.0).sum(1)
    sd.append((sid, len(x), float(ll / len(x)), float(ent.mean()),
               float((g.max(1) >= 0.5).mean())))
pd.DataFrame(sd, columns=["sequence_id", "n_positions", "mean_objective",
                          "weight_entropy_mean", "dominant_label_fraction"]) \
    .to_csv("results/stream_diagnostics.csv", index=False)

# ---------------- self-checks (visible evidence) ----------------
# reproducibility: two independent executions of the winning restart (fresh fits)
restart_lls = [fit_hmm_cached(R, RNG_SEED_BASE + 7 * R + run, record_trace=False)["ll"]
               for run in range(N_RESTARTS)]
best_run = int(np.argmax(restart_lls))
best_seed = RNG_SEED_BASE + 7 * R + best_run
r1 = fit_hmm(R, best_seed, record_trace=False)
r2 = fit_hmm(R, best_seed, record_trace=False)
self_delta = abs(r1["ll"] - r2["ll"])
self_ok = self_delta < 1e-6
restart_spread = max(restart_lls) - min(restart_lls)
# landscape: best-of-5 from two disjoint seed groups
g1 = max(fit_hmm_cached(R, 90001 + i, record_trace=False)["ll"] for i in range(5))
g2 = max(fit_hmm_cached(R, 91001 + i, record_trace=False)["ll"] for i in range(5))
group_delta = abs(g1 - g2)
norm_dev = max(np.abs(A.sum(1) - 1).max(), np.abs(B.sum(1) - 1).max(),
               abs(pi.sum() - 1), np.abs(gamma_all.sum(1) - 1).max())
finite_ok = bool(np.isfinite(A).all() and np.isfinite(B).all() and np.isfinite(pi).all()
                 and np.isfinite(gamma_all).all())
agree = 0; tot = 0
for x, g in zip(seqs, gammas):
    p = viterbi(f, x)
    agree += int((p == g.argmax(1)).sum()); tot += len(x)
vit_agree = agree / tot

