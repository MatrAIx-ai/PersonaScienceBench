class Canvas:
    def __init__(self, W, H, bg=(255,255,255)):
        self.W, self.H = W, H
        self.img = np.zeros((H, W, 3), dtype=np.uint8)
        self.img[:] = bg
    def rect(self, x0, y0, x1, y1, color, fill=False):
        x0, y0, x1, y1 = int(x0), int(y0), int(x1), int(y1)
        if x1 < x0: x0, x1 = x1, x0
        if y1 < y0: y0, y1 = y1, y0
        if fill:
            self.img[y0:y1+1, x0:x1+1] = color
        else:
            self.img[y0, x0:x1+1] = color; self.img[y1, x0:x1+1] = color
            self.img[y0:y1+1, x0] = color; self.img[y0:y1+1, x1] = color
    def line(self, x0, y0, x1, y1, color, w=1):
        x0, y0, x1, y1 = int(x0), int(y0), int(x1), int(y1)
        dx, dy = abs(x1-x0), -abs(y1-y0)
        sx = 1 if x0 < x1 else -1; sy = 1 if y0 < y1 else -1
        err = dx + dy
        while True:
            for a in range(w):
                for b in range(w):
                    xx, yy = x0+a, y0+b
                    if 0 <= xx < self.W and 0 <= yy < self.H:
                        self.img[yy, xx] = color
            if x0 == x1 and y0 == y1: break
            e2 = 2*err
            if e2 >= dy: err += dy; x0 += sx
            if e2 <= dx: err += dx; y0 += sy
    def text(self, x, y, s, scale=2, color=(0,0,0)):
        for ch in s:
            g = glyph(ch)
            for r in range(7):
                for c in range(5):
                    if g[r] & (1 << (4-c)):
                        self.rect(x + c*scale, y + r*scale, x + c*scale, y + r*scale, color, fill=True)
            x += 6*scale
    def save(self, path):
        img = self.img
        raw = b"".join(b"\x00" + img[y].tobytes() for y in range(img.shape[0]))
        def chunk(tag, data):
            c = tag + data
            return struct.pack(">I", len(data)) + c + struct.pack(">I", zlib.crc32(c) & 0xFFFFFFFF)
        ihdr = struct.pack(">IIBBBBB", img.shape[1], img.shape[0], 8, 2, 0, 0, 0)
        with open(path, "wb") as fh:
            fh.write(b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", ihdr)
                     + chunk(b"IDAT", zlib.compress(raw, 6)) + chunk(b"IEND", b""))

