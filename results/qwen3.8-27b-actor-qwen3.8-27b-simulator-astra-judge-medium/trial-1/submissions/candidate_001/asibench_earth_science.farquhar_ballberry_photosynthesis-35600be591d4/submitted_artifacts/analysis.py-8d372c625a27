"""
Leaf Physiological Response Reconstruction
==========================================
Process-based coupled Farquhar(C3)/Collatz(C4) photosynthesis + Ball-Berry
stomatal conductance in the land-surface (CLM/Noah-MP) convention.

Reads:
  data/leaf_params.json  - leaf physiological parameters
  data/forcing.csv       - diurnal forcing time series
  data/test_cases.json   - single-point evaluation cases

Writes (under results/):
  leaf_fluxes.csv        - one row per forcing row (sun & shaded)
  case_convergence.csv   - one row per test case
  diurnal.png            - 2-panel diurnal figure (A top, rs bottom)

Conventions implemented exactly as specified in the task brief:
  * Hard-minimum limitation.
      C3: Wc=Vcmax*(Ci-Gs)/(Ci+Kc*(1+O2/Ko))
          Wj=J*(Ci-Gs)/(4*Ci+8*Gs),  J=alpha_q*APAR  (linear)
          We=0.5*Vcmax
      C4: Wc=Vcmax
          Wj=alpha_q*APAR
          We=4000*Vcmax*Ci/p_atm
      A = min(Wc,Wj,We) - Rd
      APAR = 4.6*PAR  (no additional absorptance factor)
  * CLM/Noah-MP Q10 Vcmax with high-T inhibition:
      Vcmax(T)=Vcmax25*2.4^((Tc-25)/10)/(1+exp((-2.2e5+710*(Tc+273.16))/(R*(Tc+273.16))))
      Kc25=30 Pa, Ko25=30000 Pa, Q10=(2.1,1.2,2.4)
      Gamma_star=0.5*(Kc/Ko)*O2*0.21,  Rd=0.015*Vcmax
  * n_factor and btran scale photosynthetic capacity (Vcmax); the Ball-Berry
    intercept (b0) is NOT scaled by btran.
  * T_leaf = T_air; surface RH h_s = max(1-vpd/esat(T),0.25), bounded above by 1.
    esat uses the CLM/Antoine form (see esat_Pa()).
  * Gas-diffusion chain (units as stated, A_mol in mol m-2 s-1):
      cf = p_atm/(R*T)
      cs = ca - 1.37*rb*A_mol/cf*p_atm
      gs = m*A_mol*h_s/cs*p_atm + b0
      rs = cf/gs
      Ci = cs - 1.65*rs*A_mol/cf*p_atm
  * Night (PAR==0): respiratory assimilation A=-Rd and intercept conductance
    gs=b0; cs and Ci are still evaluated through the full diffusion chain.
"""
import json
import os
import numpy as np
import pandas as pd
try:
    import matplotlib
    matplotlib.use("Agg")
    import matplotlib.pyplot as plt
    _HAS_MPL = True
except Exception:  # matplotlib unavailable -> pure-stdlib PNG fallback
    _HAS_MPL = False

# ----------------------------------------------------------------------------
# Physical constants and convention constants
# ----------------------------------------------------------------------------
R_GAS = 8.314462618          # J mol-1 K-1
Kc25 = 30.0                  # Pa
Ko25 = 30000.0               # Pa
Q10_Kc, Q10_Ko, Q10_Vcmax = 2.1, 1.2, 2.4
RD_FRAC = 0.015              # Rd = 0.015*Vcmax
APAR_COEFF = 4.6             # APAR = 4.6*PAR

# Solver settings
TOL_CI = 1e-6                # Pa, fixed-point tolerance on Ci
MAX_ITER = 200               # max iterations
DAMP = 0.5                   # damping factor applied if iteration oscillates


def esat_Pa(T_K):
    """Saturation vapour pressure (Pa) - CLM/Antoine form (assumption A1)."""
    Tc = T_K - 273.15
    return 611.21 * np.exp((18.678 - Tc / 234.5) * (Tc / (257.14 + Tc)))


def vcmax_T(vcmax25, T_K):
    """CLM/Noah-MP Q10 Vcmax with high-temperature inhibition (273.16 literal)."""
    Tc = T_K - 273.15
    TK = Tc + 273.16
    q10 = 2.4 ** ((Tc - 25.0) / 10.0)
    inhib = 1.0 + np.exp((-2.2e5 + 710.0 * TK) / (R_GAS * TK))
    return vcmax25 * q10 / inhib


def Kc_Ko_Gamma(T_K, O2):
    """Temperature-scaled Kc, Ko and Gamma_star (Pa / Pa / Pa)."""
    Tc = T_K - 273.15
    Kc = Kc25 * Q10_Kc ** ((Tc - 25.0) / 10.0)
    Ko = Ko25 * Q10_Ko ** ((Tc - 25.0) / 10.0)
    Gamma = 0.5 * (Kc / Ko) * O2 * 0.21
    return Kc, Ko, Gamma


def net_A(Ci, PAR, T_K, O2, pathway, Vcmax_eff, Rd, alpha_q, p_atm):
    """Net assimilation A (umol m-2 s-1) for a given Ci and PAR (light only)."""
    APAR = APAR_COEFF * PAR
    if pathway == "C4":
        Wc = Vcmax_eff
        Wj = alpha_q * APAR
        We = 4000.0 * Vcmax_eff * Ci / p_atm
    else:  # C3
        Kc, Ko, Gs = Kc_Ko_Gamma(T_K, O2)
        Wc = Vcmax_eff * (Ci - Gs) / (Ci + Kc * (1.0 + O2 / Ko))
        Wj = alpha_q * APAR * (Ci - Gs) / (4.0 * Ci + 8.0 * Gs)
        We = 0.5 * Vcmax_eff
    return min(Wc, Wj, We) - Rd


def diffusion(Ci, A, ca, rb, cf, p_atm, m, h_s, b0):
    """Gas-diffusion chain: return (cs, gs, rs, Ci_new)."""
    A_mol = A / 1e6                                   # umol -> mol m-2 s-1
    cs = ca - 1.37 * rb * A_mol / cf * p_atm
    gs = m * A_mol * h_s / cs * p_atm + b0
    rs = cf / gs
    Ci_new = cs - 1.65 * rs * A_mol / cf * p_atm
    return cs, gs, rs, Ci_new


def solve_leaf(PAR, T_K, ca, O2, rb, p_atm, vpd, btran,
               pathway, vcmax25, alpha_q, m, b0, n_factor, Ci0):
    """
    Solve the coupled photosynthesis / stomatal fixed point for one leaf.

    Returns dict with A (umol m-2 s-1), gs (mol m-2 s-1), rs (s m-1),
    Ci (Pa) and n_iterations.
    """
    cf = p_atm / (R_GAS * T_K)
    h_s = min(max(1.0 - vpd / esat_Pa(T_K), 0.25), 1.0)

    # Photosynthetic capacity scaled by n_factor and btran (A5: Rd also scaled)
    Vcmax_eff = vcmax_T(vcmax25, T_K) * n_factor * btran
    Rd = RD_FRAC * Vcmax_eff

    # ---- Night: respiratory assimilation + intercept conductance ----
    if PAR <= 0.0:
        A = -Rd
        A_mol = A / 1e6
        cs = ca - 1.37 * rb * A_mol / cf * p_atm
        gs = b0                       # intercept conductance only
        rs = cf / gs
        Ci = cs - 1.65 * rs * A_mol / cf * p_atm
        return {"A": A, "gs": gs, "rs": rs, "Ci": Ci, "n_iterations": 0}

    # ---- Day: coupled 1-D fixed point Ci_{k+1} = f(Ci_k) ----
    Ci = float(np.clip(Ci0, 1e-3, None))
    prev = None
    it = 0
    for it in range(1, MAX_ITER + 1):
        A = net_A(Ci, PAR, T_K, O2, pathway, Vcmax_eff, Rd, alpha_q, p_atm)
        _, gs, rs, Ci_new = diffusion(Ci, A, ca, rb, cf, p_atm, m, h_s, b0)
        # damping guard against oscillation
        if prev is not None and abs(Ci_new - Ci) > abs(Ci - prev):
            Ci_new = Ci + DAMP * (Ci_new - Ci)
        prev = Ci
        if abs(Ci_new - Ci) <= TOL_CI:
            Ci = Ci_new
            break
        Ci = Ci_new

    A = net_A(Ci, PAR, T_K, O2, pathway, Vcmax_eff, Rd, alpha_q, p_atm)
    _, gs, rs, _ = diffusion(Ci, A, ca, rb, cf, p_atm, m, h_s, b0)
    return {"A": A, "gs": gs, "rs": rs, "Ci": Ci, "n_iterations": it}


# ----------------------------------------------------------------------------
# Pure-stdlib PNG fallback (used only when matplotlib is unavailable)
# ----------------------------------------------------------------------------
