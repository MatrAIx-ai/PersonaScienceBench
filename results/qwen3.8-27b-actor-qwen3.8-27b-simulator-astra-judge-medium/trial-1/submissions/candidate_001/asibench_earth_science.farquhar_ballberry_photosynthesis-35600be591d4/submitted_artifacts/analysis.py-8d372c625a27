def _draw_text(buf, x, y, text, color, scale=2):
    cx = x
    for ch in text:
        glyph = _FONT.get(ch.lower())
        if glyph is None:
            cx += 6 * scale
            continue
        rows = glyph.split()
        for r in range(7):
            for c in range(5):
                if rows[r][c] == "1":
                    for sy in range(scale):
                        for sx in range(scale):
                            py, px = y + r * scale + sy, cx + c * scale + sx
                            if 0 <= py < buf.shape[0] and 0 <= px < buf.shape[1]:
                                buf[py, px] = color
        cx += 6 * scale


def _draw_line(buf, x0, y0, x1, y1, color):
    """Bresenham line on the pixel buffer."""
    dx, dy = abs(x1 - x0), -abs(y1 - y0)
    sx = 1 if x0 < x1 else -1
    sy = 1 if y0 < y1 else -1
    err = dx + dy
    while True:
        if 0 <= y0 < buf.shape[0] and 0 <= x0 < buf.shape[1]:
            buf[y0, x0] = color
        if x0 == x1 and y0 == y1:
            break
        e2 = 2 * err
        if e2 >= dy:
            err += dy; x0 += sx
        if e2 <= dx:
            err += dx; y0 += sy


def _draw_polyline(buf, xs, ys, color):
    for i in range(len(xs) - 1):
        _draw_line(buf, int(xs[i]), int(ys[i]), int(xs[i + 1]), int(ys[i + 1]), color)


def _render_diurnal_fallback(path, time_hr, A_sun, A_shade, rs_sun, rs_shade):
    """Render the 2-panel diurnal figure with only the Python stdlib."""
    import struct, zlib
    W, H = 1000, 700
    buf = np.full((H, W, 3), 255, dtype=np.uint8)
    black = np.array([0, 0, 0], dtype=np.uint8)
    red = np.array([214, 39, 40], dtype=np.uint8)
    orange = np.array([255, 127, 14], dtype=np.uint8)
    gray = np.array([120, 120, 120], dtype=np.uint8)

    def panel(ytop, ybot, ymin, ymax, curves, ylabel):
        x0, x1 = 90, W - 40
        # frame
        _draw_line(buf, x0, ytop, x1, ytop, black)
        _draw_line(buf, x0, ybot, x1, ybot, black)
        _draw_line(buf, x0, ytop, x0, ybot, black)
        _draw_line(buf, x1, ytop, x1, ybot, black)
        tx = time_hr - time_hr.min()
        tmax = time_hr.max() - time_hr.min()
        for name, color, arr in curves:
            xs = x0 + (tx / tmax) * (x1 - x0)
            ys = ybot - (np.clip(arr, ymin, ymax) - ymin) / (ymax - ymin) * (ybot - ytop)
            _draw_polyline(buf, xs, ys, color)
        # x ticks
        for tv in (0, 30, 60, 90, 119):
            px = x0 + (tv / tmax) * (x1 - x0)
            _draw_line(buf, int(px), ybot, int(px), ybot + 6, black)
            _draw_text(buf, int(px) - 12, ybot + 8, str(tv), black, 2)
        # y ticks
        for k in (0, 0.5, 1.0):
            val = ymin + k * (ymax - ymin)
            py = ybot - k * (ybot - ytop)
            _draw_line(buf, x0 - 6, int(py), x0, int(py), black)
            _draw_text(buf, x0 - 60, int(py) - 7, f"{val:.0f}", black, 2)
        _draw_text(buf, 10, int((ytop + ybot) / 2) - 20, ylabel, black, 3)
        # legend
        lx = x1 - 150
        for j, (name, color, _) in enumerate(curves):
            ly = ytop + 20 + j * 22
            _draw_line(buf, lx, ly, lx + 30, ly, color)
            _draw_text(buf, lx + 40, ly - 7, name, black, 2)

    _draw_text(buf, 300, 10, "Diurnal leaf fluxes (A top, rs bottom)", black, 3)
    panel(60, 330, -10, 45,
          [("sun", red, A_sun), ("shade", orange, A_shade)], "A")
    panel(390, 640, 0, 160,
          [("sun", red, rs_sun), ("shade", orange, rs_shade)], "rs")
    _draw_text(buf, 460, 660, "time_hr", black, 3)

    h, w, _ = buf.shape
    raw = b"".join(b"\x00" + buf[y].tobytes() for y in range(h))

    def chunk(typ, data):
        c = typ + data
        return struct.pack(">I", len(data)) + c + struct.pack(">I", zlib.crc32(c) & 0xFFFFFFFF)

    png = (b"\x89PNG\r\n\x1a\n"
           + chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0))
           + chunk(b"IDAT", zlib.compress(raw, 9))
           + chunk(b"IEND", b""))
    with open(path, "wb") as f:
        f.write(png)


def main():
    base = os.path.dirname(os.path.abspath(__file__))
    with open(os.path.join(base, "data", "leaf_params.json")) as f:
        P = json.load(f)
    forcing = pd.read_csv(os.path.join(base, "data", "forcing.csv"))
    with open(os.path.join(base, "data", "test_cases.json")) as f:
        cases = json.load(f)

    pathway = P["pathway"]
    vcmax25 = P["vcmax25"]
    alpha_q = P["alpha_q"]
    m = P["bb_slope"]
    b0 = P["bb_intercept"]
    n_factor = P["n_factor"]

    out = os.path.join(base, "results")
    os.makedirs(out, exist_ok=True)

    # ------------------------------------------------------------------
    # 1) Diurnal time series: solve sun and shaded leaf for every row
    # ------------------------------------------------------------------
    rows = []
    for _, r in forcing.iterrows():
        T_K = r.t_air_K
        p_atm = r.p_atm_Pa
        ca = r.co2_pa
        O2 = r.o2_pa
        vpd = r.vpd_Pa
        rb = r.rb_sm
        btran = r.btran
        Ci0 = 50.0  # default internal-CO2 guess for the time series
        sun = solve_leaf(r.par_sun_wm2, T_K, ca, O2, rb, p_atm, vpd, btran,
                         pathway, vcmax25, alpha_q, m, b0, n_factor, Ci0)
        shd = solve_leaf(r.par_shade_wm2, T_K, ca, O2, rb, p_atm, vpd, btran,
                         pathway, vcmax25, alpha_q, m, b0, n_factor, Ci0)
        rows.append({
            "time_hr": r.time_hr,
            "A_sun": sun["A"], "A_shade": shd["A"],
            "rs_sun": sun["rs"], "rs_shade": shd["rs"],
            "ci_sun": sun["Ci"], "ci_shade": shd["Ci"],
            "gs_sun": sun["gs"], "gs_shade": shd["gs"],
        })
    flux = pd.DataFrame(rows, columns=["time_hr", "A_sun", "A_shade",
                                       "rs_sun", "rs_shade", "ci_sun",
                                       "ci_shade", "gs_sun", "gs_shade"])
    flux.to_csv(os.path.join(out, "leaf_fluxes.csv"), index=False)

    # ------------------------------------------------------------------
    # 2) Single-point test cases: iterative solve from each ci_init
    # ------------------------------------------------------------------
    case_rows = []
    for c in cases:
        r = forcing.iloc[c["forcing_index"]]
        T_K = r.t_air_K
        res = solve_leaf(r.par_sun_wm2, T_K, r.co2_pa, r.o2_pa, r.rb_sm,
                         r.p_atm_Pa, r.vpd_Pa, r.btran, pathway, vcmax25,
                         alpha_q, m, b0, n_factor, c["ci_init_pa"])
        case_rows.append({
            "case_id": c["case_id"],
            "ci_init_pa": c["ci_init_pa"],
            "ci_final_pa": res["Ci"],
            "A_final": res["A"],
            "rs_final": res["rs"],
            "n_iterations": res["n_iterations"],
        })
    cases_df = pd.DataFrame(case_rows, columns=["case_id", "ci_init_pa",
                                                "ci_final_pa", "A_final",
                                                "rs_final", "n_iterations"])
    cases_df.to_csv(os.path.join(out, "case_convergence.csv"), index=False)

    # ------------------------------------------------------------------
    # 3) Diurnal figure: 2 panels (A top, rs bottom), sun & shade curves
    if _HAS_MPL:
        fig, (ax1, ax2) = plt.subplots(2, 1, figsize=(10, 7), sharex=True)
        ax1.plot(flux.time_hr, flux.A_sun, label="A sunlit", color="tab:red")
        ax1.plot(flux.time_hr, flux.A_shade, label="A shaded", color="tab:orange")
        ax1.set_ylabel("A (umol CO2 m$^{-2}$ s$^{-1}$)")
        ax1.set_title("Diurnal leaf assimilation and boundary-layer resistance")
        ax1.legend(); ax1.grid(alpha=0.3)
        ax2.plot(flux.time_hr, flux.rs_sun, label="rs sunlit", color="tab:red")
        ax2.plot(flux.time_hr, flux.rs_shade, label="rs shaded", color="tab:orange")
        ax2.set_ylabel("rs (s m$^{-1}$)")
        ax2.set_xlabel("time_hr")
        ax2.legend(); ax2.grid(alpha=0.3)
        fig.tight_layout()
        fig.savefig(os.path.join(out, "diurnal.png"), dpi=120)
        plt.close(fig)
    else:
        _render_diurnal_fallback(os.path.join(out, "diurnal.png"),
                                 flux.time_hr.to_numpy(), flux.A_sun.to_numpy(),
                                 flux.A_shade.to_numpy(), flux.rs_sun.to_numpy(),
                                 flux.rs_shade.to_numpy())

    # ------------------------------------------------------------------
    # Console summary
    # ------------------------------------------------------------------
    print("leaf_fluxes.csv rows:", len(flux))
    print("Any NaN/inf in flux:", bool(np.isinf(flux.to_numpy()).any()
                                       or np.isnan(flux.to_numpy()).any()))
    print("Daytime A_sun range:", flux.A_sun[flux.A_sun > 0].min().round(3),
          flux.A_sun[flux.A_sun > 0].max().round(3))
    print("Night A_sun (should be -Rd):",
          flux.A_sun[flux.time_hr < 7].iloc[0].round(4))
    print("\ncase_convergence.csv:")
    print(cases_df.to_string(index=False))


if __name__ == "__main__":
    main()
