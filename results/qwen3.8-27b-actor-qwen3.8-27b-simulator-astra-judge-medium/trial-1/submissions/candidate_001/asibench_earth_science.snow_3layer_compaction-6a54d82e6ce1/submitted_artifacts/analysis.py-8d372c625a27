    def _text(buf, x, y, s, color, sc=2):
        for ch in s:
            g = FONT.get(ch, FONT[" "])
            for r in range(7):
                row = g[r]
                for c in range(5):
                    if (row >> (4 - c)) & 1:
                        buf[y + r * sc: y + (r + 1) * sc,
                            x + c * sc: x + (c + 1) * sc] = color
            x += 6 * sc
        return x

    def _textw(s, sc=2):
        return len(s) * 6 * sc

    def _fill(buf, x0, y0, x1, y1, color):
        x0, y0 = max(0, x0), max(0, y0)
        x1, y1 = min(buf.shape[1], x1), min(buf.shape[0], y1)
        if x1 > x0 and y1 > y0:
            buf[y0:y1, x0:x1] = color

    def _polyline(buf, pts, color, th=2):
        for (x0, y0), (x1, y1) in zip(pts[:-1], pts[1:]):
            n = max(1, int(max(abs(x1 - x0), abs(y1 - y0))))
            for i in range(n + 1):
                x = int(round(x0 + (x1 - x0) * i / n))
                y = int(round(y0 + (y1 - y0) * i / n))
                _fill(buf, x - th, y - th, x + th + 1, y + th + 1, color)

    def _nice_ticks(vmin, vmax, n=5):
        if vmax <= vmin:
            vmax = vmin + 1.0
        step = (vmax - vmin) / (n - 1)
        mag = 10 ** np.floor(np.log10(step))
        for m in (1, 2, 2.5, 5, 10):
            if step / mag <= m:
                step = m * mag
                break
        t0 = np.ceil(vmin / step) * step
        return np.arange(t0, vmax + 1e-9, step)

    def _panel(buf, px, py, pw, ph, title, xlabel, ylabel, series,
               bars=None, second=None, hline=None):
        """Draw one panel. series: list of (xs, ys, color, label).
        second: (xs, ys, color, label) on a right axis. bars: bars from 0."""
        BLACK = (0, 0, 0)
        ML, MR, MT, MB = 64, 56, 34, 46
        ax0, ay0 = px + ML, py + MT
        ax1, ay1 = px + pw - MR, py + ph - MB
        all_ys = [y for (_, y, _, _) in series]
        if second:
            all_ys.append(second[1])
        if bars:
            all_ys.append(bars[1])
        ymin = min(float(np.min(y)) for y in all_ys)
        ymax = max(float(np.max(y)) for y in all_ys)
        if ymax - ymin < 1e-9:
            ymax = ymin + 1.0
        pad = 0.08 * (ymax - ymin)
        if ymin < 0:
            ymin -= pad
        ymax += pad
        xmax = max(float(np.max(s[0])) for s in series)
        _fill(buf, ax0, ay0, ax1 + 1, ay1 + 1, (255, 255, 255))
        _fill(buf, ax0, ay0, ax1 + 1, ay0 + 2, (200, 200, 200))
        _fill(buf, ax1 - 1, ay0, ax1 + 1, ay1 + 1, (200, 200, 200))
        _fill(buf, ax0, ay1, ax1 + 1, ay1 + 2, BLACK)
        _fill(buf, ax0, ay0, ax0 + 2, ay1 + 1, BLACK)

        def X(x):
            return ax0 + (x / xmax) * (ax1 - ax0)

        def Y(y):
            return ay1 - (y - ymin) / (ymax - ymin) * (ay1 - ay0)

        for xt in _nice_ticks(0, xmax):
            xx = int(X(xt))
            _fill(buf, xx, ay1, xx + 1, ay1 + 5, BLACK)
            lab = f"{xt:.0f}"
            _text(buf, xx - _textw(lab) // 2, ay1 + 8, lab, BLACK)
        for yt in _nice_ticks(ymin, ymax):
            yy = int(Y(yt))
            _fill(buf, ax0 - 5, yy, ax0, yy + 1, BLACK)
            _fill(buf, ax0, yy, ax1, yy + 1, (232, 232, 232))
            lab = f"{yt:.0f}"
            _text(buf, ax0 - 8 - _textw(lab), yy - 7, lab, BLACK)
        if second:
            smin = float(np.min(second[1])); smax = float(np.max(second[1]))
            if smax > smin:
                for yt in _nice_ticks(smin, smax):
                    yy = int(ay1 - (yt - smin) / (smax - smin) * (ay1 - ay0))
                    _fill(buf, ax1, yy, ax1 + 5, yy + 1, (140, 80, 20))
                    lab = f"{yt:.0f}"
                    _text(buf, ax1 + 8, yy - 7, lab, (140, 80, 20))
        if bars:
            xs, ys, col, _ = bars
            wbar = max(1, int((ax1 - ax0) / max(1, len(xs)) * 0.7))
            for x, y in zip(xs, ys):
                xx = int(X(x))
                _fill(buf, xx - wbar // 2, int(Y(y)), xx + wbar // 2 + 1, ay1, col)
        for xs, ys, col, _ in series:
            _polyline(buf, [(int(X(x)), int(Y(y))) for x, y in zip(xs, ys)], col)
        if second:
            _polyline(buf, [(int(X(x)), int(Y(y)))
                            for x, y in zip(second[0], second[1])], second[2], th=1)
        if hline is not None:
            yy = int(Y(hline))
            _fill(buf, ax0, yy, ax1, yy + 1, (200, 0, 0))
        ly = ay0 + 6
        for xs, ys, col, lab in (list(series) + ([second] if second else [])
                                + ([bars] if bars else [])):
            _fill(buf, ax1 - _textw(lab) - 16, ly + 6, ax1 - _textw(lab) - 2, ly + 9, col)
            _text(buf, ax1 - _textw(lab), ly, lab, BLACK)
            ly += 16
        _text(buf, px + (pw - _textw(title)) // 2, py + 4, title, BLACK)
        _text(buf, px + (pw - _textw(xlabel)) // 2, py + ph - 18, xlabel, BLACK)
        for r, ch in enumerate(ylabel):
            _text(buf, 14, py + MT + (ay1 - ay0) // 2 - 56 + r * 14, ch, BLACK)

