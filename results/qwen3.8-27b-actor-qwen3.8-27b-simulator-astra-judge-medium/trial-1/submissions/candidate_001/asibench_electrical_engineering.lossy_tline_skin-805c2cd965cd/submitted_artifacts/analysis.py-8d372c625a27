#!/usr/bin/env python3
"""
Transmission-Line Target Prediction
====================================
Use the 8 calibration lossy transmission lines to predict the intrinsic
frequency-domain transfer functions, received pulse waveforms and pulse
metrics for the 3 target lines.

PHYSICAL MODEL
--------------
Each line is a single-mode lossy transmission line. Its (full-line) transfer
function is modelled as a pure delay offset (shared by the measurement
pipeline) times the per-meter propagation constant integrated over the line
length:

    H(w; line) = exp(-j*w*tau0) * exp(-gamma(w; line) * L)
    gamma      = alpha + j*beta          (per-meter propagation constant)

  * beta(w; line) = D(w; line) * w * sqrt(L_ind * C)
      - the dominant term w*sqrt(L*C) uses the GIVEN per-meter inductance /
        capacitance (verified: after removing tau0 the velocity is 1/sqrt(LC));
      - D(w) is a smooth GLOBAL dispersion factor (~0.994) fitted from the
        calibration data, plus a small per-line correction delta-D that
        depends on the line's loss / geometry (fitted, reduces the ~0.17 %
        per-line spread).
  * alpha(w; line) = (R_ac(w; line)/2)*sqrt(C/L_ind) + (G/2)*sqrt(L_ind/C)
      - R_ac = Rdc * S(w; W, rough) is the frequency-dependent AC resistance
        (skin effect + roughness).
      - S(w; W, rough) = A(w) * W**p * rough**q  (fitted: p~0.56, q~0.035,
        A(w) ~ sqrt(w) skin factor).
  * tau0 is a global, length-independent pure-delay offset (~0.46 ns). It is
    INCLUDED in the target response (decision locked by the researcher: the
    calibration pipeline embeds it, so the predicted target carries it too).

The phasor convention is exp(+j*w*t), so a delay tau gives H = exp(-j*w*tau).
The reported phase_rad is therefore negative and monotonically decreasing
(no 2*pi jumps); group_delay_s is computed as -d(phase_rad)/d(w) NUMERICALLY
from the same reported phase array so the two columns are exactly consistent.

WAVEFORMS
---------
The 2049-point frequency grid is exactly the positive-frequency half of the
FFT grid of the 4096-sample input pulse (dt = 8 ps, fs = 125 GHz). We build
the full 4096-point transfer function by conjugate symmetry
H[-k] = conj(H[k]) (real LTI system), multiply FFT(input) * H and inverse
FFT to obtain the real output waveform.

PULSE METRICS
-------------
tail_asymmetry  = (integral of v_out^2 AFTER the output peak time)
                  / (integral of v_out^2 BEFORE the output peak time)
                on the output waveform (post-peak energy / pre-peak energy).
"""
import os
import numpy as np
import pandas as pd
from scipy.signal import savgol_filter

# ----------------------------------------------------------------------
# 0. Load data
# ----------------------------------------------------------------------
cal_lines = pd.read_csv('data/calibration_lines.csv').set_index('line_id')
cal_trans = pd.read_csv('data/calibration_transfer.csv')
tgt_lines = pd.read_csv('data/target_lines.csv').set_index('line_id')
freq      = pd.read_csv('data/frequency_grid.csv')['frequency_hz'].values
pulse     = pd.read_csv('data/input_pulse.csv')

t     = pulse['time_s'].values
vin   = pulse['input_v'].values
w     = 2.0 * np.pi * freq
ln10  = np.log(10.0)
N     = len(vin)          # 4096 time samples
Nf    = len(freq)         # 2049 frequency points
dt    = t[1] - t[0]
ids   = cal_lines.index.tolist()

assert np.allclose(cal_trans.groupby('line_id')['frequency_hz'].first().values[0],
                   freq[0])

# ----------------------------------------------------------------------
# 1. Per-meter quantities for the calibration lines
# ----------------------------------------------------------------------
alpha    = {}   # Np/m      : -(mag_db/20)*ln10 / L
betaraw  = {}   # rad/m     : -phase_rad / L   (still contains the tau0 offset)
for lid in ids:
    d = cal_trans[cal_trans.line_id == lid].reset_index(drop=True)
    L = cal_lines.loc[lid, 'length_m']
    assert np.allclose(d.frequency_hz.values, freq)
    alpha[lid]   = -(d.magnitude_db.values / 20.0) * ln10 / L
    betaraw[lid] = -d.phase_rad.values / L

# ----------------------------------------------------------------------
# 2. LOSS MODEL  (from the magnitude)
#    S(w; line) = 2*alpha*sqrt(L/C)/Rdc  = R_ac/Rdc
#    fit  ln S = ln A(w) + p*ln(W) + q*ln(rough)
# ----------------------------------------------------------------------
lnW = np.array([np.log(cal_lines.loc[l, 'trace_width_um'])  for l in ids])
lnR = np.array([np.log(cal_lines.loc[l, 'roughness_index']) for l in ids])
lnS = np.zeros((len(ids), Nf))
for i, lid in enumerate(ids):
    r = cal_lines.loc[lid]
    S = 2.0 * alpha[lid] * np.sqrt(r.inductance_h_per_m / r.capacitance_f_per_m) \
        / r.dc_resistance_ohm_per_m
    lnS[i] = np.log(np.maximum(S, 1e-300))

# centre by the per-frequency line-mean so the per-frequency intercept lnA(w)
# drops out; then a single pooled least-squares gives (p, q).
lnS_c = lnS - lnS.mean(axis=0, keepdims=True)
lnW_c = lnW[:, None] - lnW.mean()
lnR_c = lnR[:, None] - lnR.mean()
mask = w > 0
Y = lnS_c[:, mask].ravel()
X = np.stack([np.repeat(lnW_c.ravel(), int(mask.sum())),
              np.repeat(lnR_c.ravel(), int(mask.sum()))], axis=1)
coef, _, _, _ = np.linalg.lstsq(X, Y, rcond=None)
p, q = coef

# A(w) = exp( mean_lines[ lnS - p lnW - q lnR ] )  at each frequency
lnA = (lnS - p * lnW[:, None] - q * lnR[:, None]).mean(axis=0)
A = np.exp(lnA)
# smooth only the nonzero-frequency part (the DC sample is anomalous) and
# extend it continuously to DC
A_full = np.zeros(Nf)
A_full[mask] = savgol_filter(A[mask], window_length=51, polyorder=3)
A_full[0] = A_full[1]
A = A_full

def loss_alpha(r, wv):
    """per-meter attenuation (Np/m) for a line with per-meter params r."""
    S = A * (r.trace_width_um ** p) * (r.roughness_index ** q)
    ac = (r.dc_resistance_ohm_per_m * S / 2.0) * np.sqrt(
        r.capacitance_f_per_m / r.inductance_h_per_m)
    di = (r.conductance_s_per_m / 2.0) * np.sqrt(
        r.inductance_h_per_m / r.capacitance_f_per_m)
    return ac + di

# ----------------------------------------------------------------------
# 3. PHASE / DISPERSION MODEL  (from the phase)
#    beta(w; line) = betaraw - w*tau0/L ;  D = beta / (w*sqrt(L*C))
# ----------------------------------------------------------------------
def D_matrix(tau0):
    D = np.zeros((len(ids), Nf))
    for i, lid in enumerate(ids):
        r = cal_lines.loc[lid]
        L = r.length_m
        beta = betaraw[lid] - w * tau0 / L
        D[i, w > 0] = beta[w > 0] / (w[w > 0] * np.sqrt(r.inductance_h_per_m *
                                                          r.capacitance_f_per_m))
    return D

# per-meter geometry / loss parameters of the calibration lines (used by the
# per-line dispersion correction)
rough = np.array([cal_lines.loc[l, 'roughness_index']         for l in ids])
Rdc   = np.array([cal_lines.loc[l, 'dc_resistance_ohm_per_m'] for l in ids])
Wum   = np.array([cal_lines.loc[l, 'trace_width_um']          for l in ids])
def _centered(v):
    return v - v.mean()
Z = np.stack([_centered(rough), _centered(Rdc), _centered(Wum)], axis=1)  # (8,3)
Zp = np.repeat(Z, int(mask.sum()), axis=0)                                # (8*nf,3)

def fit_phase_model(tau0):
    """Given tau0, fit the global dispersion D0(w) and the per-line correction
    cd (linear in roughness, Rdc, width). Returns (D0_full, cd)."""
    Dm = D_matrix(tau0)
    D0f = np.zeros(Nf)
    D0f[mask] = savgol_filter(Dm[:, mask].mean(axis=0),
                              window_length=51, polyorder=3)
    D0f[0] = D0f[1]                       # continuous extension to DC
    cdd, _, _, _ = np.linalg.lstsq(Zp, (Dm - D0f[None, :])[:, mask].ravel(),
                                   rcond=None)
    return D0f, cdd

def _phase_residual(tau0):
    D0f, cdd = fit_phase_model(tau0)
    tot = 0.0
    for i, lid in enumerate(ids):
        r = cal_lines.loc[lid]
        Dv = (D0f + cdd[0] * (r.roughness_index - rough.mean()) +
              cdd[1] * (r.dc_resistance_ohm_per_m - Rdc.mean()) +
              cdd[2] * (r.trace_width_um - Wum.mean()))
        ph = -w * tau0 - Dv * w * np.sqrt(r.inductance_h_per_m *
                                          r.capacitance_f_per_m) * r.length_m
        d = cal_trans[cal_trans.line_id == lid].reset_index(drop=True)
        tot += np.sum((ph - d.phase_rad.values) ** 2)
    return tot

# fit tau0 to minimise the TOTAL phase residual of the full model
best = None
for tau0 in np.linspace(4.3e-10, 4.9e-10, 601):
    r = _phase_residual(tau0)
    if best is None or r < best[1]:
        best = (tau0, r)
tau0 = best[0]

# final phase-model fit at the chosen tau0
D0_full, cd = fit_phase_model(tau0)

def dispersion(r, wv):
    """full per-line dispersion factor D(w; line)."""
    corr = (cd[0] * (r.roughness_index - rough.mean()) +
            cd[1] * (r.dc_resistance_ohm_per_m - Rdc.mean()) +
            cd[2] * (r.trace_width_um - Wum.mean()))
    return D0_full + corr

# ----------------------------------------------------------------------
# 4. Build the target transfer functions
# ----------------------------------------------------------------------
def target_transfer(r):
    """Return (magnitude_db, phase_rad, alpha) on the frequency grid for line r."""
    L  = r.length_m
    a  = loss_alpha(r, w)                       # Np/m
    Dv = dispersion(r, w)
    beta = Dv * w * np.sqrt(r.inductance_h_per_m * r.capacitance_f_per_m)
    phase = -w * tau0 - beta * L                # unwrapped, monotonic, ~0 at DC
    mag_db = -(a * L) * (20.0 / ln10)          # = -8.686*alpha*L
    return mag_db, phase, a

# ----------------------------------------------------------------------
# 5. Waveforms (conjugate-symmetric 4096-pt FFT)
# ----------------------------------------------------------------------
def make_full_H(mag_db, phase):
    """2049-pt positive grid -> full 4096-pt complex H via conjugate symmetry."""
    Hpos = np.exp(mag_db * ln10 / 20.0 + 1j * phase)   # Nf points
    Hfull = np.zeros(N, dtype=complex)
    Hfull[:Nf] = Hpos
    Hfull[Nf:] = Hpos[-2:0:-1].conj()                  # H[-k]=conj(H[k])
    return Hfull

def output_waveform(mag_db, phase):
    Hfull = make_full_H(mag_db, phase)
    vo = np.fft.ifft(np.fft.fft(vin) * Hfull).real
    return vo

# ----------------------------------------------------------------------
# 6. Pulse metrics
# ----------------------------------------------------------------------
def fwhm(t, v):
    pk = np.argmax(np.abs(v))
    half = np.abs(v[pk]) / 2.0
    above = np.where(np.abs(v) >= half)[0]
    return t[above[-1]] - t[above[0]], pk

def pulse_metrics(vo):
    t_in_pk  = np.argmax(np.abs(vin))
    t_out_pk = np.argmax(np.abs(vo))
    fi, _ = fwhm(t, vin)
    fo, _ = fwhm(t, vo)
    energy_in  = np.sum(vin ** 2) * dt
    energy_out = np.sum(vo ** 2) * dt
    # tail_asymmetry = post-peak energy / pre-peak energy on the OUTPUT
    post = np.sum(vo[t_out_pk:] ** 2)
    pre  = np.sum(vo[:t_out_pk] ** 2)
    tail_asym = post / pre if pre > 0 else np.inf
    return dict(
        input_fwhm_s=fi,
        output_fwhm_s=fo,
        fwhm_broadening_ratio=fo / fi,
        peak_delay_s=t[t_out_pk] - t[t_in_pk],
        output_peak_time_s=t[t_out_pk],
        energy_ratio=energy_out / energy_in,
        tail_asymmetry=tail_asym,
    )

# ----------------------------------------------------------------------
# 7. Write outputs
# ----------------------------------------------------------------------
os.makedirs('results', exist_ok=True)

rows = []
tf_cache = {}
for lid in tgt_lines.index:
    mag_db, phase, a = target_transfer(tgt_lines.loc[lid])
    tf_cache[lid] = (mag_db, phase)
    # group delay = -d(phase)/d(w) computed NUMERICALLY from the reported phase
    gd = -np.gradient(phase, w, edge_order=2)
    for f, m, ph, g, am in zip(freq, mag_db, phase, gd, a):
        rows.append(dict(target_id=lid, frequency_hz=f, magnitude_db=m,
                         phase_rad=ph, group_delay_s=g,
                         attenuation_np_per_m=am))
pd.DataFrame(rows, columns=['target_id', 'frequency_hz', 'magnitude_db',
                            'phase_rad', 'group_delay_s',
                            'attenuation_np_per_m']).to_csv(
    'results/target_transfer.csv', index=False)

wrows = []
for lid in tgt_lines.index:
    mag_db, phase = tf_cache[lid]
    vo = output_waveform(mag_db, phase)
    for ti, vi, oi in zip(t, vin, vo):
        wrows.append(dict(target_id=lid, time_s=ti, input_v=vi, output_v=oi))
pd.DataFrame(wrows, columns=['target_id', 'time_s', 'input_v', 'output_v']).to_csv(
    'results/target_waveforms.csv', index=False)

mrows = []
for lid in tgt_lines.index:
    mag_db, phase = tf_cache[lid]
    vo = output_waveform(mag_db, phase)
    mrows.append(dict(target_id=lid, **pulse_metrics(vo)))
pd.DataFrame(mrows, columns=['target_id', 'input_fwhm_s', 'output_fwhm_s',
                             'fwhm_broadening_ratio', 'peak_delay_s',
                             'output_peak_time_s', 'energy_ratio',
                             'tail_asymmetry']).to_csv(
    'results/pulse_metrics.csv', index=False)

# ----------------------------------------------------------------------
# 8. Diagnostics
# ----------------------------------------------------------------------
print("=" * 68)
print("FIT SUMMARY")
print("=" * 68)
print("loss model : S(w) = A(w) * W**%.4f * rough**%.4f  (A~sqrt(w))" % (p, q))
print("dispersion : D0(w) in [%.5f, %.5f]  (global, smooth)" %
      (D0_full[mask].min(), D0_full[mask].max()))
print("delta-D correction coeffs (rough, Rdc, W) = [%.3e, %.3e, %.3e]" %
      tuple(cd))
print("tau0       = %.4e s  (%.3f ns)  [INCLUDED in target]" % (tau0, tau0 * 1e9))
print()
print("TELEGRAPHER DIAGNOSTIC  (does gamma^2=(R+jwL)*(G+jwC) close?)")
print("  real part: alpha^2-beta^2  vs  R*G-w^2*L*C  (R*G is negligible)")
print("  -> fractional mismatch |LHS-RHS|/|w^2 L C| over f>5 GHz:")
rel = []
for lid in ids:
    r = cal_lines.loc[lid]
    L = r.length_m
    a = alpha[lid]
    betac = (betaraw[lid] - w * tau0 / L)
    lhs = a ** 2 - betac ** 2
    rhs = (r.dc_resistance_ohm_per_m * r.conductance_s_per_m
           - w ** 2 * r.inductance_h_per_m * r.capacitance_f_per_m)
    m = w > 2 * np.pi * 5e9
    rel.append(np.mean(np.abs(lhs[m] - rhs[m]) / np.abs(rhs[m])))
print("  mean fractional real-part mismatch = %.4f  (i.e. ~%.2f %%)" %
      (np.mean(rel), 100 * np.mean(rel)))
print()
print("PREDICTED TARGETS")
print("=" * 68)
print("%-10s %8s %8s %12s %14s %14s" %
      ("target", "L(m)", "Rdc", "gd@DC(s)", "mag@62.5G(dB)", "phase@62.5G(rad)"))
for lid in tgt_lines.index:
    r = tgt_lines.loc[lid]
    mag_db, phase, a = target_transfer(r)
    gd = -np.gradient(phase, w, edge_order=2)
    i62 = np.argmin(np.abs(freq - 62.5e9))
    print("%-10s %8.3f %8.4f %12.4e %14.4f %14.2f" %
          (lid, r.length_m, r.dc_resistance_ohm_per_m, gd[0],
           mag_db[i62], phase[i62]))
print()
print("PULSE METRICS")
print(pd.DataFrame(mrows).to_string(index=False))
print()
print("Wrote: results/target_transfer.csv, results/target_waveforms.csv,")
print("       results/pulse_metrics.csv")
