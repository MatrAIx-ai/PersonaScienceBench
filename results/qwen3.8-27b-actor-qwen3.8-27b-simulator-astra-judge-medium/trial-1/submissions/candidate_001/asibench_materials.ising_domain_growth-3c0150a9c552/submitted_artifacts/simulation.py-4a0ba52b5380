class Canvas:
    def __init__(self, W, H, bg=(255, 255, 255)):
        self.W, self.H = W, H
        self.px = np.empty((H, W, 3), np.uint8)
        self.px[:] = bg

    def _put(self, x, y, c):
        if 0 <= x < self.W and 0 <= y < self.H:
            self.px[y, x] = c

    def line(self, x0, y0, x1, y1, c, dash=0):
        x0, y0, x1, y1 = int(x0), int(y0), int(x1), int(y1)
        dx, dy = abs(x1 - x0), -abs(y1 - y0)
        sx = 1 if x0 < x1 else -1
        sy = 1 if y0 < y1 else -1
        err = dx + dy
        step = 0
        while True:
            if dash == 0 or (step // dash) % 2 == 0:
                self._put(x0, y0, c)
            step += 1
            if x0 == x1 and y0 == y1:
                break
            e2 = 2 * err
            if e2 >= dy:
                err += dy
                x0 += sx
            if e2 <= dx:
                err += dx
                y0 += sy

    def hline(self, x0, x1, y, c, dash=0):
        self.line(x0, y, x1, y, c, dash)

    def vline(self, x, y0, y1, c, dash=0):
        self.line(x, y0, x, y1, c, dash)

    def rect(self, x0, y0, x1, y1, c, fill=None):
        if fill is not None:
            self.px[y0:y1 + 1, x0:x1 + 1] = fill
        self.line(x0, y0, x1, y0, c)
        self.line(x0, y1, x1, y1, c)
        self.line(x0, y0, x0, y1, c)
        self.line(x1, y0, x1, y1, c)

    def text(self, x, y, s, c=(0, 0, 0), scale=2, align="left"):
        x, y = int(x), int(y)
        if align == "center":
            x -= len(s) * 4 * scale // 2
        elif align == "right":
            x -= (len(s) - 1) * 4 * scale
        for ch in s:
            g = _FONT.get(ch, _FONT[' '])
            for r in range(5):
                for col in range(3):
                    if g[r][col] == '#':
                        y0 = y + r * scale
                        x0 = x + col * scale
                        self.px[y0:y0 + scale, x0:x0 + scale] = c
            x += 4 * scale

    def image(self, x, y, img, w, h, vmin=-1.0, vmax=1.0, cmap="bwr"):
        idx = np.clip((img - vmin) / (vmax - vmin), 0, 1)
        idx = np.round(np.clip(idx, 0, 1) * (h - 1)).astype(int)
        big = img[np.arange(h)[:, None] * (img.shape[0] - 1) // (h - 1),
                  np.arange(w)[None, :] * (img.shape[1] - 1) // (w - 1)]
        if cmap == "bwr":
            rgb = np.zeros((h, w, 3), np.uint8)
            v = (big - vmin) / (vmax - vmin)
            rgb[:, :, 0] = np.round(255 * (1 - v)).astype(np.uint8)
            rgb[:, :, 2] = np.round(255 * v).astype(np.uint8)
        self.px[y:y + h, x:x + w] = rgb


def _save_png(path, px):
    import struct
    import zlib
    H, W = px.shape[:2]
    raw = b"".join(b"\x00" + px[y].tobytes() for y in range(H))

    def chunk(tag, data):
        c = tag + data
        return struct.pack(">I", len(data)) + c + struct.pack(">I", zlib.crc32(c) & 0xffffffff)

    png = b"\x89PNG\r\n\x1a\n"
    png += chunk(b"IHDR", struct.pack(">IIBBBBB", W, H, 8, 2, 0, 0, 0))
    png += chunk(b"IDAT", zlib.compress(raw, 6))
    png += chunk(b"IEND", b"")
    with open(path, "wb") as fh:
        fh.write(png)

