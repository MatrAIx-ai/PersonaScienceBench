def _panel(cv, x, y, w, h, title, xlabel, ylabel_l, ylabel_r, series,
           xticks, yticks_l, yticks_r, legend, xlog=False, ylog=False,
           legend_pos="right", annot=None):
    ml = 80
    mr = 78 if ylabel_r else 18
    mt, mb = 32, 58
    px0, py0 = x + ml, y + mt
    pw, ph = w - ml - mr, h - mt - mb
    xmin, xmax = xticks[0], xticks[-1]

    def X(v):
        if xlog:
            return px0 + (np.log10(v / xmin) / np.log10(xmax / xmin)) * pw
        return px0 + (v - xmin) / (xmax - xmin) * pw

    def Y(v, side="left"):
        t, b = (yticks_r[0], yticks_r[-1]) if side == "right" else (yticks_l[0], yticks_l[-1])
        q = (np.log10(v / t) / np.log10(b / t)) if ylog else (v - t) / (b - t)
        return py0 + ph - q * ph

    cv.rect(px0, py0, px0 + pw, py0 + ph, (60, 60, 60))
    for tv in xticks:
        Xp = X(tv)
        cv.vline(Xp, py0 + ph, py0 + ph + 6, (60, 60, 60))
        cv.text(Xp, py0 + ph + 10, str(tv), scale=2, align="center")
    for tv in yticks_l:
        Yp = Y(tv, "left")
        cv.hline(px0 - 6, px0, Yp, (60, 60, 60))
        cv.text(px0 - 10, Yp - 5, str(tv), scale=2, align="right")
    if ylabel_r:
        for tv in yticks_r:
            Yp = Y(tv, "right")
            cv.hline(px0 + pw, px0 + pw + 6, Yp, (60, 60, 60))
            cv.text(px0 + pw + 10, Yp - 5, str(tv), scale=2, align="left")
    cv.text(px0 + pw // 2, py0 + ph + 40, xlabel, scale=2, align="center")
    cv.text(px0, y + 10, ylabel_l, scale=2)
    if ylabel_r:
        cv.text(px0 + pw - 2, y + 10, ylabel_r, scale=2, align="right")
    cv.text(x + w // 2, y + 2, title, scale=3, align="center")
    for xs, ys, col, dash, side in series:
        xs = np.asarray(xs, float)
        ys = np.asarray(ys, float)
        Xp = np.clip(X(xs), px0, px0 + pw)
        Yp = np.clip(Y(ys, side), py0, py0 + ph)
        okm = (xs >= xmin) & (xs <= xmax) & (ys > 0)
        prev = None
        for i in np.where(okm)[0]:
            if prev is not None:
                for ox, oy in ((0, 0), (1, 0), (0, 1)):
                    cv.line(Xp[prev] + ox, Yp[prev] + oy,
                            Xp[i] + ox, Yp[i] + oy, col, dash)
            prev = i
    lx = px0 + 10 if legend_pos == "left" else px0 + pw - 130
    ly = py0 + 8
    for col, lab in legend:
        for oy in (0, 1):
            cv.line(lx, ly + 5 + oy, lx + 24, ly + 5 + oy, col)
        cv.text(lx + 32, ly, lab, scale=2)
        ly += 17
    if annot:
        cv.text(px0 + 8, py0 + ph - 20, annot, scale=2)


def _snap_panel(cv, x, y, w, h):
    cv.text(x + w // 2, y + 2, "snapshots (6)", scale=3, align="center")
    cw, ch = 200, 170
    gx = (w - 3 * cw) // 4
    for k in range(6):
        xx = x + gx + (k % 3) * (cw + gx)
        yy = y + 36 + (k // 3) * (ch + 16)
        cv.image(xx, yy, snapshots[k], cw, ch)
        cv.rect(xx, yy, xx + cw - 1, yy + ch - 1, (90, 90, 90))
        cv.text(xx + cw // 2, yy + ch + 3, f"t={int(t_snap[k])}", scale=2,
                align="center")


