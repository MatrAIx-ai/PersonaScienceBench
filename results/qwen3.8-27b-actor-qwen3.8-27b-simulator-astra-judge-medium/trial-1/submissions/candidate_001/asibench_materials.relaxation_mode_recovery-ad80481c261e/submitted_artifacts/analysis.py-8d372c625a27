#!/usr/bin/env python3
"""Shared-mode recovery from complex response curves.
Model: R(x) = a0 + sum_{k=1..K} a_k / (1 + (i*x*tau_k)^{phi_k})
  shared: K, tau_k>0, phi_k in (0,1];  per-curve: a0 (free), a_k>=0.
Variable projection: inner per-curve LSQ (a0,a_k>=0); outer bounded L-BFGS-B
over (u=log10 tau, v=phi) with analytic reduced gradient. Multistart.
Model order K=1..K_max via BIC (primary), AICc + block-CV (cross-check).
Outputs: results/modes.csv (tau, a_0..a_4) and results/baselines.csv (bonus).
"""
import json, os, time
import numpy as np
from scipy.optimize import lsq_linear, minimize
import warnings
warnings.filterwarnings("ignore")
T0 = time.time()

# 1. LOAD --------------------------------------------------------------------
data = np.genfromtxt("data/curves.csv", delimiter=",", names=True)
curve = data["curve"].astype(int)
x_all = data["x"]; re_all = data["re"]; im_all = data["im"]
meta = json.load(open("data/meta.json"))
curves = np.unique(curve)
M = len(curves)
X = np.unique(x_all)
Npts = len(X)
reM = np.zeros((M, Npts)); imM = np.zeros((M, Npts))
for i, c in enumerate(curves):
    m = curve == c
    reM[i] = re_all[m]; imM[i] = im_all[m]
Y = reM + 1j * imM
Nres = M * Npts * 2
print(f"[load] M={M} Npts={Npts} x in [{X.min():.4e},{X.max():.4e}] Nreal={Nres}")

# 2. BASIS + DERIVATIVES ------------------------------------------------------
def basis(x, tau, phi):
    w = (1j * x * tau) ** phi
    return 1.0 / (1.0 + w)
def db_dtau(x, tau, phi):
    w = (1j * x * tau) ** phi
    b = 1.0 / (1.0 + w)
    return -b * b * (phi * w / tau)
def db_dphi(x, tau, phi):
    w = (1j * x * tau) ** phi
    b = 1.0 / (1.0 + w)
    return -b * b * (w * (np.log(x * tau) + 1j * np.pi / 2))
def design(x, taus, phis, K):
    n = len(x)
    A = np.zeros((2 * n, K + 1))
    A[:n, 0] = 1.0
    for k in range(K):
        b = basis(x, taus[k], phis[k])
        A[:n, k + 1] = b.real
        A[n:, k + 1] = b.imag
    return A
def lsq_solve(A, y, K):
    lower = np.full(K + 1, 0.0); lower[0] = -np.inf   # a0 free, a_k >= 0
    upper = np.full(K + 1, np.inf)
    return lsq_linear(A, y, bounds=(lower, upper)).x

# 3. REDUCED OBJECTIVE + GRADIENT --------------------------------------------
LAM = 1e-3
def reduced(u, v, K, idx=None):
    if idx is None:
        idx = np.arange(Npts)
    x = X[idx]; taus = 10.0 ** u; phis = v
    A = design(x, taus, phis, K)
    ssq = 0.0; thetas = np.zeros((M, K + 1))
    for m in range(M):
        y = np.concatenate([reM[m, idx], imM[m, idx]])
        th = lsq_solve(A, y, K)
        thetas[m] = th
        r = A @ th - y
        ssq += r @ r
    return ssq, thetas
def reduced_grad(u, v, K, idx=None):
    if idx is None:
        idx = np.arange(Npts)
    x = X[idx]; n = len(x); taus = 10.0 ** u; phis = v
    A = design(x, taus, phis, K)
    gu = np.zeros(K); gv = np.zeros(K)
    for m in range(M):
        y = np.concatenate([reM[m, idx], imM[m, idx]])
        th = lsq_solve(A, y, K)
        r = A @ th - y
        for k in range(K):
            dbt = db_dtau(x, taus[k], phis[k])
            dbp = db_dphi(x, taus[k], phis[k])
            dA_du = np.empty(2 * n); dA_du[:n] = dbt.real; dA_du[n:] = dbt.imag
            dA_du *= taus[k] * np.log(10.0)
            dA_dv = np.empty(2 * n); dA_dv[:n] = dbp.real; dA_dv[n:] = dbp.imag
            gu[k] += 2.0 * (r @ dA_du) * th[k + 1]
            gv[k] += 2.0 * (r @ dA_dv) * th[k + 1]
    return np.concatenate([gu, gv])
def make_funcs(K):
    def obj(z):
        u, v = z[:K], z[K:]
        val, _ = reduced(u, v, K)
        return val + LAM * (np.sum((u/3.0)**2) + np.sum(((v-0.5)/0.5)**2))
    def grad(z):
        u, v = z[:K], z[K:]
        g = reduced_grad(u, v, K)
        gp = LAM * np.concatenate([2.0*(u/3.0)/3.0, 2.0*((v-0.5)/0.5)/0.5])
        return g + gp
    return obj, grad

# one-time analytic-vs-FD gradient self-test
def selftest():
    K = 2
    z = np.concatenate([np.array([0.3, -1.2]), np.array([0.9, 0.6])])
    obj, grad = make_funcs(K)
    h = 1e-6
    gf = np.zeros_like(z)
    for i in range(z.size):
        zp = z.copy(); zp[i] += h
        zm = z.copy(); zm[i] -= h
        gf[i] = (obj(zp) - obj(zm)) / (2 * h)
    err = np.max(np.abs(grad(z) - gf) / (np.abs(gf) + 1e-8))
    print(f"[selftest] max rel grad err (analytic vs FD) = {err:.3e}")
    return err < 1e-4
USE_ANALYTIC = selftest()
print(f"[selftest] using {'analytic' if USE_ANALYTIC else 'finite-difference'} outer gradient")

# 4. SEEDS + OUTER MULTISTART -------------------------------------------------
U_LO, U_HI = -3.0, 3.0
V_LO, V_HI = 0.05, 1.0
FEAT_TAUS = [3.3, 0.033, 0.33, 33.0, 0.0033, 330.0]

def make_seeds(K, prev_best, idx=None):
    seeds = [(np.log10(FEAT_TAUS[:K]), np.ones(K))]
    if prev_best is not None:
        up = np.log10(prev_best["taus"]); vp = prev_best["phis"]
        if len(up) == K:                      # in-sample restart (same K)
            seeds.append((up.copy(), vp.copy()))
        elif len(up) == K - 1:                # sequential: extend (K-1) -> K
            th = prev_best["thetas"]
            x = X[idx] if idx is not None else X
            R = th[:, 0][:, None]
            for k in range(len(up)):
                R = R + th[:, k + 1][:, None] * basis(x, 10**up[k], vp[k])[None, :]
            resid = (np.abs(Y[:, idx] - R) if idx is not None else np.abs(Y - R))
            peak = np.argmax(resid.mean(axis=0))
            x_peak = x[peak] if idx is not None else X[peak]
            u = np.concatenate([up, [np.log10(1.0 / x_peak)]])
            v = np.concatenate([vp, [1.0]])
            o = np.argsort(-u)
            seeds.append((u[o], v[o]))
    rng = np.random.default_rng(12345 + K)
    tau_grid = np.log10(np.logspace(-2.5, 2.5, 11))
    phi_grid = np.array([0.5, 0.7, 1.0, 0.3]); seen = set()
    for _ in range(22):
        idxs = rng.choice(len(tau_grid), size=K, replace=False)
        u = np.sort(tau_grid[idxs])[::-1]
        v = rng.choice(phi_grid, size=K, replace=True)
        key = tuple(np.round(u, 3)) + tuple(np.round(v, 3))
        if key in seen:
            continue
        seen.add(key); seeds.append((u, v))
    return seeds

def is_degenerate(taus, phis, thetas, K):
    lt = np.log10(taus)
    for i in range(K):
        for j in range(i + 1, K):
            if abs(lt[i] - lt[j]) < 0.15:
                return "tau-collapse"
    for k in range(K):
        if thetas[:, k + 1].max() < 0.01:
            return "zero-amplitude"
    return None

def fit_K(K, prev_best, idx=None, n_seeds=None, maxiter=250):
    obj, grad = make_funcs(K)
    bounds = [(U_LO, U_HI)] * K + [(V_LO, V_HI)] * K
    seeds = make_seeds(K, prev_best, idx)
    if n_seeds is not None:
        seeds = seeds[:n_seeds]
    results = []
    for (u0, v0) in seeds:
        z0 = np.clip(np.concatenate([u0, v0]), [b[0] for b in bounds], [b[1] for b in bounds])
        try:
            res = minimize(obj, z0, jac=(grad if USE_ANALYTIC else None),
                           method="L-BFGS-B", bounds=bounds,
                           options={"maxiter": maxiter, "ftol": 1e-14, "gtol": 1e-10,
                                    "maxls": 50, "finite_diff_rel_step": 1e-6})
            z = res.x
            ssq, thetas = reduced(z[:K], z[K:], K, idx)
            taus = 10.0 ** z[:K]; phis = z[K:]
            results.append(dict(ssq=ssq, taus=taus, phis=phis, thetas=thetas,
                                conv=bool(res.success), deg=is_degenerate(taus, phis, thetas, K),
                                msg=res.message, nfev=int(res.nfev)))
        except Exception:
            pass
    results.sort(key=lambda r: r["ssq"])
    return results

def pick_best(results, K):
    cands = [r for r in results if r["deg"] is None] or results
    return cands[0]

# 5. MODEL-ORDER SEARCH -------------------------------------------------------
K_MAX = 6
def bic(ssq, K):
    p = 7 * K + 5
    return Nres * np.log(ssq / Nres) + p * np.log(Nres), p
def aicc(ssq, K):
    p = 7 * K + 5
    return Nres * np.log(ssq / Nres) + 2 * p + 2 * p * (p + 1) / (Nres - p - 1), p

best_by_K = {}; prev = None
for K in range(1, K_MAX + 1):
    tk = time.time()
    results = fit_K(K, prev)
    best = pick_best(results, K)
    best_by_K[K] = (best, results); prev = best
    b, p = bic(best["ssq"], K)
    print(f"[K={K}] t={time.time()-tk:5.1f}s ssq={best['ssq']:.4f} BIC={b:.2f} p={p} "
          f"taus={np.round(best['taus'],4)} phis={np.round(best['phis'],3)} n={len(results)}")

def cv_rmse(K, n_folds=5, n_seeds=8, maxiter=150):
    folds = np.array_split(np.arange(Npts), n_folds)
    full_best = best_by_K[K][0]; rmses = []
    for f in range(n_folds):
        te = folds[f]
        tr = np.concatenate([folds[i] for i in range(n_folds) if i != f])
        b = pick_best(fit_K(K, full_best, idx=tr, n_seeds=n_seeds, maxiter=maxiter), K)
        x_te = X[te]; R = b["thetas"][:, 0][:, None]
        for k in range(K):
            R = R + b["thetas"][:, k + 1][:, None] * basis(x_te, b["taus"][k], b["phis"][k])[None, :]
        rmses.append(np.sqrt(np.mean(np.abs(Y[:, te] - R) ** 2)))
    return float(np.mean(rmses))

print("\n[cv] 5-fold block CV RMSE ...")
cv = {K: cv_rmse(K) for K in range(1, K_MAX + 1)}
print(f"{'K':>2} {'BIC':>9} {'AICc':>9} {'CV-RMSE':>9} {'p':>4}")
for K in range(1, K_MAX + 1):
    b, p = bic(best_by_K[K][0]["ssq"], K)
    a, _ = aicc(best_by_K[K][0]["ssq"], K)
    print(f"{K:>2} {b:>9.2f} {a:>9.2f} {cv[K]:>9.4f} {p:>4}")

K_sel = min(range(1, K_MAX + 1), key=lambda K: bic(best_by_K[K][0]["ssq"], K)[0])
print(f"\n[select] K* = {K_sel} (min BIC)")

# 6. FINAL SOLUTION + ROBUSTNESS ---------------------------------------------
best, results = best_by_K[K_sel]; K = K_sel
order = np.argsort(-best["taus"])
taus = best["taus"][order]; phis = best["phis"][order]
thetas = best["thetas"][:, order + 1]
a0 = best["thetas"][:, 0]

print(f"\n===== FINAL RECOVERED MODES (K={K}) =====")
print(f"{'k':>2} {'tau':>12} {'log10(tau)':>12} {'phi':>8}")
for k in range(K):
    print(f"{k+1:>2} {taus[k]:>12.5f} {np.log10(taus[k]):>12.4f} {phis[k]:>8.4f}")
print("\nPer-curve amplitudes a_k (rows=curves, cols=modes):")
print("     " + "".join(f"{'a_'+str(k+1):>12}" for k in range(K)))
for m in range(M):
    print(f"c{m}:  " + "".join(f"{thetas[m,k]:>12.5f}" for k in range(K)))
print("\nPer-curve baseline a0:")
for m in range(M):
    print(f"  curve {m}: a0 = {a0[m]:.5f}")

ssq, _ = reduced(np.log10(taus), phis, K)
print(f"\n[fit] SSQ={ssq:.4f}  RMSE={np.sqrt(ssq/Nres):.5f} (noise est ~0.05)")
for m in range(M):
    R = a0[m]
    for k in range(K):
        R = R + thetas[m, k] * basis(X, taus[k], phis[k])
    r2 = 1 - np.sum((reM[m] - R.real)**2) / np.sum((reM[m] - reM[m].mean())**2)
    print(f"  curve {m}: R2(re)={r2:.4f}")

print(f"\n[robustness] top-3 restarts (K={K}):")
for r in results[:3]:
    print(f"   ssq={r['ssq']:.4f} conv={r['conv']} deg={r['deg']} "
          f"taus={np.round(r['taus'],3)} phis={np.round(r['phis'],3)}")

# 7. WRITE OUTPUTS ------------------------------------------------------------
os.makedirs("results", exist_ok=True)
with open("results/modes.csv", "w") as f:
    f.write("tau," + ",".join(f"a_{m}" for m in range(M)) + "\n")
    for k in range(K):
        f.write(f"{taus[k]:.6f}," + ",".join(f"{thetas[m,k]:.6f}" for m in range(M)) + "\n")
with open("results/baselines.csv", "w") as f:
    f.write("curve,a0\n")
    for m in range(M):
        f.write(f"{m},{a0[m]:.6f}\n")
# supplementary: full shared-mode set incl. shapes phi_k (bonus)
with open("results/modes_full.csv", "w") as f:
    f.write("tau,log10_tau,phi," + ",".join(f"a_{m}" for m in range(M)) + "\n")
    for k in range(K):
        f.write(f"{taus[k]:.6f},{np.log10(taus[k]):.6f},{phis[k]:.6f},"
                + ",".join(f"{thetas[m,k]:.6f}" for m in range(M)) + "\n")
print(f"\n[write] results/modes.csv + results/baselines.csv  | total {time.time()-T0:.1f}s")
