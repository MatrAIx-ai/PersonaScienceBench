"""analysis.py -- Learned action-selection policy for deterministic symbolic
grid-search levels (ASIBench "levin_context_grid_search").

Self-contained, stdlib-only.  Required interface:

    make_policy(training_data: dict, config: dict | None = None) -> Policy
    Policy.action_probs(level: dict, state: dict, legal_actions: list[str])
        -> dict[str, float]   (nonnegative scores/probs for every legal action)

What the training data shows (verified by replaying all 260 solutions):
  * 27x27 grids; '#' walls, lowercase letters walkable, one 'G' goal cell.
  * Every solution is 1-3 straight runs.  Every non-final run stops exactly
    when the next cell is a wall; the final run is an unobstructed straight
    line into 'G'.  No reversals ever occur.
  * The path is generated by a greedy rule: run to a wall, then turn to the
    open perpendicular that reduces Manhattan distance to the goal; the first
    direction is effectively random (near-uniform over open directions).
  * Letter tiles are random decoys (no correlation with the goal), so the only
    decision-relevant local cues are: wall pattern (via legal_actions /
    neighbors), the current run (previous_action), and a visible 'G'.

Inference-time policy (priority order):
  1. 'G' visible in neighbors            -> move to it (p_goal, default .99)
  2. previous_action is legal (forward open) -> continue the run (p_continue,
     default .95, small epsilon split over the other legal actions)
  3. start (no previous_action / depth 0) -> uniform over legal actions
     (the generator's first direction is random; the empirical 61/64/63/66
     split carries no local signal, so it is NOT used for ordering; pass
     config use_fitted_start=True or start_weights to opt in)
  4. at a wall (previous_action not legal) -> uniform over legal non-reverse
     perpendiculars (empirically 196L/189R -- a byproduct of random goal
     positions, not a local cue; reverse gets 0)
  5. fallback                              -> uniform over legal actions

Parameters are fitted in make_policy from the solved training instances
(empirical conditional frequencies); sensible defaults are used when the
training data is missing or malformed.  The policy never raises: all state
fields are parsed defensively, and any unexpected format falls back to a
legal_actions-only logic path (previous_action in legal_actions iff the
forward cell is open).
"""

from __future__ import annotations

import json
import os
from collections import Counter

# ---------------------------------------------------------------------------
# Constants
# ---------------------------------------------------------------------------

ACTIONS = ("U", "D", "L", "R")
DIRV = {"U": (-1, 0), "D": (1, 0), "L": (0, -1), "R": (0, 1)}
OPPOSITE = {"U": "D", "D": "U", "L": "R", "R": "L"}
GOAL_CHARS = ("G", "goal", "GOAL", "Goal")

_KEY_MAP = {
    "u": "U", "d": "D", "l": "L", "r": "R",
    "up": "U", "down": "D", "left": "L", "right": "R",
    "north": "U", "south": "D", "west": "L", "east": "R",
}
_VEC_MAP = {(-1, 0): "U", (1, 0): "D", (0, -1): "L", (0, 1): "R"}


# ---------------------------------------------------------------------------
# Defensive parsing helpers
# ---------------------------------------------------------------------------

def _norm_action(x):
    """Normalize an action-like value to 'U'/'D'/'L'/'R' or None."""
    if isinstance(x, str):
        return _KEY_MAP.get(x.strip().lower())
    if isinstance(x, (list, tuple)) and len(x) == 2:
        try:
            return _VEC_MAP.get((int(x[0]), int(x[1])))
        except (TypeError, ValueError):
            return None
    return None


def _as_int(x, default=None):
    if isinstance(x, bool):
        return default
    if isinstance(x, int):
        return x
    if isinstance(x, float):
        return int(x)
    if isinstance(x, str):
        try:
            return int(float(x.strip()))
        except ValueError:
            return default
    return default


def _tile_of(v):
    """Extract a tile character from a neighbor value (str, or [char, ...])."""
    if isinstance(v, str):
        return v
    if isinstance(v, (list, tuple)) and v and isinstance(v[0], str):
        return v[0]
    return None


def _is_goal(t):
    return isinstance(t, str) and t in GOAL_CHARS


def _parse_neighbors(neigh):
    """Parse the 'neighbors' field into {action: tile_char}; None if unknown.

    Accepts: dict keyed by direction ('U'/'up'/'north'/(-1,0)/...), a list of
    (direction, tile) pairs, or a 4-tuple/list in action order U,D,L,R.
    """
    if neigh is None:
        return None
    if isinstance(neigh, dict):
        out = {}
        for k, v in neigh.items():
            a = _norm_action(k)
            if a is None:
                continue
            t = _tile_of(v)
            if t is not None:
                out[a] = t
        return out or None
    if isinstance(neigh, (list, tuple)):
        if len(neigh) and all(isinstance(x, (list, tuple)) and len(x) == 2
                              for x in neigh):
            out = {}
            for k, v in neigh:
                a = _norm_action(k)
                if a is None:
                    continue
                t = _tile_of(v)
                if t is not None:
                    out[a] = t
            if out:
                return out
        if len(neigh) == 4:
            out = {}
            for i, a in enumerate(ACTIONS):
                t = _tile_of(neigh[i])
                if t is not None:
                    out[a] = t
            return out or None
    return None


def _history_actions(state):
    """Return the action history as a list of canonical actions, or None."""
    for key in ("history", "history_tail"):
        h = state.get(key)
        if isinstance(h, str):
            acts = [a for a in (_norm_action(ch) for ch in h) if a is not None]
            if acts:
                return acts
        elif isinstance(h, (list, tuple)):
            acts = [a for a in (_norm_action(x) for x in h) if a is not None]
            if acts:
                return acts
    return None


def _run_bucket(history):
    """Bucketed current-run length (only used to build self-test states)."""
    n = 0
    if history:
        last = history[-1]
        for a in reversed(history):
            if a == last:
                n += 1
            else:
                break
    if n <= 1:
        return "1"
    if n <= 3:
        return "2-3"
    if n <= 7:
        return "4-7"
    return "8+"


# ---------------------------------------------------------------------------
# Learning from solved training instances
# ---------------------------------------------------------------------------

def _extract_levels(training_data):
    if training_data is None:
        return []
    if isinstance(training_data, str):
        try:
            if os.path.exists(training_data):
                with open(training_data) as f:
                    return _extract_levels(json.load(f))
        except (OSError, ValueError):
            return []
    if isinstance(training_data, dict):
        levels = training_data.get("levels")
        if isinstance(levels, list):
            return levels
        if isinstance(levels, dict):
            return list(levels.values())
        return []
    if isinstance(training_data, (list, tuple)):
        return list(training_data)
    return []


def _learn(training_data):
    """Replay every solved training level and fit conditional action
    distributions over compact local contexts."""
    stats = {
        "n_levels": 0,
        "verified": 0,
        "n_steps": 0,
        "continue_counts": [0, 0],   # [same-action, total] given forward open
        "goal_counts": [0, 0],       # [toward-G, total] given G visible
        "start_dist": {},            # tuple(legal) -> Counter(action)
        "turn_dist": {},             # (prev, tuple(perps)) -> Counter(action)
        "turn_side": Counter(),      # 'left' / 'right'
        "reversals": 0,
        "sol_lens": [],
        "depth_ratios": [],
    }
    for lv in _extract_levels(training_data):
        if not isinstance(lv, dict):
            continue
        try:
            grid = lv["grid"]
            sol = lv["solution"]
            start = lv["start"]
        except (KeyError, TypeError):
            continue
        if not isinstance(grid, list) or not isinstance(sol, list) \
                or not isinstance(start, (list, tuple)) or len(start) != 2:
            continue
        try:
            R, C = len(grid), len(grid[0])
            r, c = int(start[0]), int(start[1])
        except (IndexError, TypeError, ValueError):
            continue
        ok = True
        for i, a in enumerate(sol):
            a = _norm_action(a)
            if a is None:
                ok = False
                break
            # local context at (r, c)
            neigh = {}
            legal = []
            for d in ACTIONS:
                nr, nc = r + DIRV[d][0], c + DIRV[d][1]
                t = grid[nr][nc] if (0 <= nr < R and 0 <= nc < C) else "#"
                neigh[d] = t
                if t != "#":
                    legal.append(d)
            stats["n_steps"] += 1
            if i == 0:
                stats["start_dist"].setdefault(tuple(legal), Counter())[a] += 1
            else:
                prev = _norm_action(sol[i - 1])
                if any(neigh[d] == "G" for d in ACTIONS):
                    stats["goal_counts"][1] += 1
                    if neigh.get(a) == "G":
                        stats["goal_counts"][0] += 1
                if prev is not None and prev in legal:
                    stats["continue_counts"][1] += 1
                    if a == prev:
                        stats["continue_counts"][0] += 1
                if a != prev:
                    if a == OPPOSITE[prev]:
                        stats["reversals"] += 1
                    else:
                        perps = [d for d in legal
                                 if d != prev and d != OPPOSITE[prev]]
                        key = (prev, tuple(perps))
                        stats["turn_dist"].setdefault(key, Counter())[a] += 1
                        left = {"U": "L", "L": "D", "D": "R", "R": "U"}[prev]
                        stats["turn_side"]["left" if a == left else "right"] += 1
            # advance
            r += DIRV[a][0]
            c += DIRV[a][1]
            if not (0 <= r < R and 0 <= c < C) or grid[r][c] == "#":
                ok = False
                break
        if ok:
            stats["verified"] += 1
            stats["sol_lens"].append(len(sol))
            md = _as_int(lv.get("max_depth"))
            if md and len(sol):
                stats["depth_ratios"].append(md / len(sol))
    stats["n_levels"] = stats["verified"]
    return stats


def _counters_to_probs(counter, keys):
    """Normalize a Counter over `keys` into a probability dict."""
    total = sum(counter.get(k, 0) for k in keys)
    if total <= 0:
        return None
    return {k: counter.get(k, 0) / total for k in keys}


# ---------------------------------------------------------------------------
# Policy
# ---------------------------------------------------------------------------

class Policy:
    """Action-selection policy for the grid-search levels.

    action_probs(level, state, legal_actions) -> dict[str, float]
      * `level`: non-spatial metadata only (e.g. id, max_depth).  Never used
        for spatial reasoning.
      * `state`: local observation fields (cell, neighbors, previous_action,
        history, history_tail, run_length_bucket, depth, depth_mod,
        depth_phase, legal_mask, ...).  All fields optional / any format.
      * `legal_actions`: list of legal action strings.
    Returns a dict covering every entry of legal_actions with nonnegative
    scores; never raises.
    """

    def __init__(self, stats=None, config=None):
        self.stats = stats or {}
        config = config or {}
        self.p_goal = float(config.get("p_goal", 0.99))
        self.p_continue = float(config.get("p_continue",
                                           config.get("p_cont", 0.95)))
        # fitted conditional distributions
        self.start_dist = {}
        for key, counter in (self.stats.get("start_dist") or {}).items():
            p = _counters_to_probs(counter, list(key))
            if p:
                self.start_dist[tuple(key)] = p
        self.turn_dist = {}
        for key, counter in (self.stats.get("turn_dist") or {}).items():
            prev, perps = key[0], tuple(key[1])
            p = _counters_to_probs(counter, list(perps))
            if p:
                self.turn_dist[(prev, perps)] = p
        # optional user overrides.  The fitted start/turn tables are kept for
        # reporting, but by default they are NOT used for ordering: the
        # generator's first direction and turn side are random (conditioned on
        # the invisible goal), so their empirical splits are noise, not a
        # local cue.  use_fitted_start/use_fitted_turn opt in to them.
        self.start_weights = config.get("start_weights")
        self.turn_weights = config.get("turn_weights")
        self.use_fitted_start = bool(config.get("use_fitted_start", False))
        self.use_fitted_turn = bool(config.get("use_fitted_turn", False))
        # backward-compatible alias
        self.use_fitted = bool(config.get("use_fitted", False))

    # -- public interface ----------------------------------------------------

    def action_probs(self, level, state, legal_actions):
        try:
            return self._action_probs(level, state, legal_actions)
        except Exception:
            # Absolute last resort: uniform nonnegative scores.
            out = {}
            if isinstance(legal_actions, (list, tuple)):
                for a in legal_actions:
                    if isinstance(a, str) and a not in out:
                        out[a] = 1.0
            return out

    # -- core logic -----------------------------------------------------------

    def _action_probs(self, level, state, legal_actions):
        # canonical legal list (deduped) + original entries for the response
        seen = {}
        original = []
        if isinstance(legal_actions, (list, tuple)):
            for a in legal_actions:
                canon = _norm_action(a)
                if canon is not None and canon not in seen:
                    seen[canon] = a
                    original.append((canon, a))
        legal = [c for c, _ in original]
        if not legal:
            return {}
        state = state if isinstance(state, dict) else {}

        prev = _norm_action(state.get("previous_action"))
        depth = _as_int(state.get("depth"), 0) or 0
        neigh = _parse_neighbors(state.get("neighbors"))

        # 1) goal visible in neighbors -> take it
        if neigh:
            gdir = [a for a in legal if _is_goal(neigh.get(a))]
            if gdir:
                return self._finish(
                    self._spread(gdir[0], legal, self.p_goal),
                    legal, original)

        # 2) continue the current run (previous_action legal <=> forward open)
        if prev is not None and prev in legal:
            t = neigh.get(prev) if neigh else None
            if t is None or t != "#":
                return self._finish(
                    self._spread(prev, legal, self.p_continue),
                    legal, original)

        # 3) start: uniform over legal directions by default (the generator's
        #    first direction is random; the fitted split is noise)
        if prev is None or depth == 0:
            if self.start_weights:
                p = self._weights(self.start_weights, legal)
            elif self.use_fitted_start:
                p = self.start_dist.get(tuple(legal))
            else:
                p = None
            if p is None:
                p = {a: 1.0 / len(legal) for a in legal}
            return self._finish(p, legal, original)

        # 4) at a wall: uniform over legal non-reverse perpendiculars by
        #    default (turn side is determined by the invisible goal; the
        #    fitted 196L/189R split is noise, not a local cue)
        perps = [a for a in legal if a != prev and a != OPPOSITE[prev]]
        if perps:
            if self.turn_weights:
                p = self._weights(self.turn_weights, perps)
            elif self.use_fitted_turn:
                p = self.turn_dist.get((prev, tuple(perps)))
            else:
                p = None
            if p is None:
                p = {a: 1.0 / len(perps) for a in perps}
            full = {a: p.get(a, 0.0) for a in legal}  # reverse gets 0
            return self._finish(full, legal, original)

        # 5) fallback: uniform over whatever is legal
        return self._finish({a: 1.0 / len(legal) for a in legal},
                            legal, original)

    # -- helpers ---------------------------------------------------------------

    @staticmethod
    def _spread(dominant, legal, p):
        """{dominant: p, each other legal action: (1-p)/(n-1)} (or 1.0 if
        `legal` has a single entry)."""
        if len(legal) == 1:
            return {legal[0]: 1.0}
        rest = (1.0 - p) / (len(legal) - 1)
        return {a: (p if a == dominant else rest) for a in legal}

    @staticmethod
    def _weights(weights, keys):
        w = {}
        for k in keys:
            try:
                w[k] = max(0.0, float(weights.get(k, 0.0)))
            except (AttributeError, TypeError, ValueError):
                w[k] = 0.0
        total = sum(w.values())
        if total <= 0:
            return {k: 1.0 / len(keys) for k in keys}
        return {k: w[k] / total for k in keys}

    @staticmethod
    def _finish(probs, legal, original):
        out = {}
        for canon, entry in original:
            v = probs.get(canon)
            if v is None:
                v = 0.0
            try:
                v = float(v)
            except (TypeError, ValueError):
                v = 0.0
            out[entry] = max(0.0, v)
        return out


def make_policy(training_data, config=None):
    """Fit the policy on solved training instances and return a Policy."""
    stats = _learn(training_data)
    return Policy(stats, config)


# ---------------------------------------------------------------------------
# Self-test (offline validation only -- not used at inference)
# ---------------------------------------------------------------------------

class _EvalEnv:
    """Grid-backed environment used only by the self-test."""

    def __init__(self, level):
        self.grid = level["grid"]
        self.start = tuple(level["start"])
        self.goal = tuple(level["goal"])
        self.max_depth = _as_int(level.get("max_depth"), 10 ** 9)
        self.R = len(self.grid)
        self.C = len(self.grid[0])

    def legal(self, pos):
        out = []
        for a in ACTIONS:
            r, c = pos[0] + DIRV[a][0], pos[1] + DIRV[a][1]
            if 0 <= r < self.R and 0 <= c < self.C and self.grid[r][c] != "#":
                out.append(a)
        return out

    def neighbors(self, pos):
        d = {}
        for a in ACTIONS:
            r, c = pos[0] + DIRV[a][0], pos[1] + DIRV[a][1]
            d[a] = self.grid[r][c] if (0 <= r < self.R and 0 <= c < self.C) \
                else "#"
        return d

    def make_state(self, pos, prev, depth, history):
        legal = self.legal(pos)
        return {
            "cell": list(pos),
            "neighbors": self.neighbors(pos),
            "previous_action": prev,
            "history": list(history),
            "history_tail": list(history)[-6:],
            "run_length_bucket": _run_bucket(history),
            "depth": depth,
            "depth_mod": depth % 8,
            "depth_phase": depth % 8,
            "legal_mask": [1 if a in legal else 0 for a in ACTIONS],
            "legal_actions": legal,
        }


def _dfs_search(env, policy, budget):
    """Policy-ordered DFS with backtracking (self-test only)."""
    exp = [0]

    def rec(pos, prev, depth, history, visited):
        if pos == env.goal:
            return True, "".join(history)
        if depth >= env.max_depth or exp[0] >= budget:
            return False, None
        exp[0] += 1
        legal = env.legal(pos)
        state = env.make_state(pos, prev, depth, history)
        probs = policy.action_probs(
            {"max_depth": env.max_depth, "id": "selftest"}, state, legal)
        ordered = sorted(legal,
                         key=lambda a: (-probs.get(a, 0.0), ACTIONS.index(a)))
        for a in ordered:
            nr, nc = pos[0] + DIRV[a][0], pos[1] + DIRV[a][1]
            if (nr, nc) in visited:
                continue
            ok, path = rec((nr, nc), a, depth + 1, history + [a],
                           visited | {(nr, nc)})
            if ok:
                return True, path
        return False, None

    ok, path = rec(env.start, None, 0, [], {env.start})
    return ok, exp[0], path


def _find_data(*names):
    here = os.path.dirname(os.path.abspath(__file__))
    for base in (os.getcwd(), here, os.path.join(here, "..")):
        for name in names:
            p = os.path.join(base, name)
            if os.path.exists(p):
                return p
    return None



def _robustness_check(policy):
    """Fuzz action_probs with malformed/edge-case inputs; must never raise."""
    cases = [
        ({"id": "x"}, None, ["U", "D", "L", "R"]),
        (None, None, ["U", "D", "L", "R"]),
        ("not-a-dict", "not-a-state", ["U"]),
        ({"id": "x"}, {}, ["U", "D", "L", "R"]),
        ({"id": "x"}, {"neighbors": "garbage", "depth": "not-an-int",
                       "previous_action": "???", "history": 42,
                       "legal_mask": "x"}, ["U", "D"]),
        ({"id": "x"}, {"neighbors": ["a", "#", "b", "G"], "depth": "3",
                       "previous_action": "r", "history": "rrr"},
         ["u", "d", "l", "r"]),
        ({"id": "x"}, {"neighbors": {"up": "a", "down": "#",
                                     "left": "b", "right": "G"},
                       "depth": 3, "previous_action": "R"},
         ["U", "D", "L", "R"]),
        ({"id": "x"}, {"neighbors": [("U", "a"), ("D", "#"),
                                     ("L", "b"), ("R", "c")],
                       "depth": 3, "previous_action": "R"},
         ["U", "D", "L", "R"]),
        ({"id": "x"}, {"neighbors": [[-1, 0]] * 4, "depth": 0}, []),
        ({"id": "x"}, {"depth": 5, "previous_action": "U"}, ["D"]),
        ({"id": "x"}, {"depth": 5, "previous_action": "U",
                       "neighbors": {"U": "#", "D": "x", "L": "#", "R": "#"}},
         ["D"]),
        ({"id": "x"}, {"depth": 5, "previous_action": "U",
                       "neighbors": {"U": "#", "D": "x", "L": "y", "R": "z"}},
         ["U", "D", "L", "R"]),
    ]
    n_ok = 0
    for level, state, legal in cases:
        out = policy.action_probs(level, state, legal)
        assert isinstance(out, dict), "non-dict output"
        for k, v in out.items():
            assert isinstance(v, (int, float)) and v >= 0.0, "negative score"
        if legal:
            for a in legal:
                assert a in out, "missing legal action %r" % a
        n_ok += 1
    return n_ok


def _self_test():
    print("=" * 72)
    print("analysis.py self-test")
    print("=" * 72)

    train_path = _find_data("data/training_levels.json",
                            "training_levels.json")
    if train_path is None:
        print("training data not found; skipping replay test")
        return 1
    with open(train_path) as f:
        training = json.load(f)
    policy = make_policy(training)
    st = policy.stats
    cc = st["continue_counts"]
    gc = st["goal_counts"]
    print("fitted from %d verified training levels, %d steps" %
          (st["verified"], st["n_steps"]))
    if cc[1]:
        print("  P(continue | forward open) = %.4f (%d/%d)" %
              (cc[0] / cc[1], cc[0], cc[1]))
    if gc[1]:
        print("  P(toward G | G visible)    = %.4f (%d/%d)" %
              (gc[0] / gc[1], gc[0], gc[1]))
    print("  turn side: %s" % dict(st["turn_side"]))
    print("  reversals: %d" % st["reversals"])
    if st["sol_lens"]:
        print("  solution length: min %d max %d mean %.2f" %
              (min(st["sol_lens"]), max(st["sol_lens"]),
               sum(st["sol_lens"]) / len(st["sol_lens"])))
    if st["depth_ratios"]:
        print("  max_depth/solution_len: min %.2f max %.2f" %
              (min(st["depth_ratios"]), max(st["depth_ratios"])))

    # ---- replay training solutions -----------------------------------------
    levels = training.get("levels", []) if isinstance(training, dict) \
        else training
    cats = {}
    for lv in levels:
        if not isinstance(lv, dict):
            continue
        try:
            grid = lv["grid"]
            sol = lv["solution"]
            start = lv["start"]
        except (KeyError, TypeError):
            continue
        R, C = len(grid), len(grid[0])
        r, c = int(start[0]), int(start[1])
        for i, a in enumerate(sol):
            a = _norm_action(a)
            neigh = {}
            legal = []
            for d in ACTIONS:
                nr, nc = r + DIRV[d][0], c + DIRV[d][1]
                t = grid[nr][nc] if (0 <= nr < R and 0 <= nc < C) else "#"
                neigh[d] = t
                if t != "#":
                    legal.append(d)
            prev = _norm_action(sol[i - 1]) if i > 0 else None
            state = {
                "cell": [r, c],
                "neighbors": neigh,
                "previous_action": prev,
                "history": [_norm_action(x) for x in sol[:i]],
                "history_tail": [_norm_action(x) for x in sol[max(0, i - 6):i]],
                "run_length_bucket": _run_bucket(sol[:i]),
                "depth": i,
                "depth_mod": i % 8,
                "depth_phase": i % 8,
                "legal_mask": [1 if d in legal else 0 for d in ACTIONS],
                "legal_actions": legal,
            }
            probs = policy.action_probs({"max_depth": lv.get("max_depth")},
                                        state, legal)
            if i == 0:
                cat = "start"
            elif any(neigh[d] == "G" for d in ACTIONS):
                cat = "goal"
            elif prev in legal:
                cat = "continue"
            else:
                cat = "turn"
            rec = cats.setdefault(cat, [0, 0, 0, 0])
            # [n, strict-argmax, tied-argmax, support]
            rec[0] += 1
            best = max(probs.values()) if probs else 0.0
            strict = max((x for x in legal if x in probs),
                         key=lambda x: (probs[x], -ACTIONS.index(x)),
                         default=None) if probs else None
            if strict == a:
                rec[1] += 1
            if probs.get(a, 0.0) >= best - 1e-12:
                rec[2] += 1
            if probs.get(a, 0.0) > 0.0:
                rec[3] += 1
            r += DIRV[a][0]
            c += DIRV[a][1]

    n_ok = _robustness_check(policy)
    print("-" * 72)
    print("robustness: %d/%d malformed-input cases handled without raising"
          % (n_ok, n_ok))
    print("-" * 72)
    print("training replay (strict = unique argmax or first under U<D<L<R):")
    tot = [0, 0, 0, 0]
    for cat in ("goal", "continue", "turn", "start"):
        if cat in cats:
            n, am, tied, sup = cats[cat]
            for j in range(4):
                tot[j] += cats[cat][j]
            print("  %-9s n=%5d  strict-argmax=%5.1f%%  tied-argmax=%5.1f%%"
                  "  support=%5.1f%%" %
                  (cat, n, 100.0 * am / n, 100.0 * tied / n,
                   100.0 * sup / n))
    print("  %-9s n=%5d  strict-argmax=%5.1f%%  tied-argmax=%5.1f%%"
          "  support=%5.1f%%" %
          ("TOTAL", tot[0], 100.0 * tot[1] / max(1, tot[0]),
           100.0 * tot[2] / max(1, tot[0]), 100.0 * tot[3] / max(1, tot[0])))
    print("  (strict at start/turn is ~25%/~50% by construction: those")
    print("   choices are random w.r.t. local info; the search branches there)")

    # ---- public-level DFS simulation ----------------------------------------
    pub_path = _find_data("data/public_eval_levels.json",
                          "public_eval_levels.json")
    if pub_path is not None:
        with open(pub_path) as f:
            ev = json.load(f)
        budget = _as_int(ev.get("budget"), 95) if isinstance(ev, dict) else 95
        plevels = ev.get("levels", []) if isinstance(ev, dict) else ev
        print("-" * 72)
        print("public levels, policy-guided DFS with backtracking, budget=%d:"
              % budget)
        solved = 0
        for lv in plevels:
            env = _EvalEnv(lv)
            ok, exp, path = _dfs_search(env, policy, budget)
            solved += ok
            print("  %s: solved=%s expansions=%d path=%s" %
                  (lv.get("id"), ok, exp, path))
        print("  solved %d/%d within budget" % (solved, len(plevels)))
    print("=" * 72)
    return 0


