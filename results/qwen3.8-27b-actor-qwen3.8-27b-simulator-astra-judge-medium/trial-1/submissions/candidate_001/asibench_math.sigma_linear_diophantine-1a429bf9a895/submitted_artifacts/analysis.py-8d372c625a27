"""Bounded search for integer solutions of  a * sigma(n) = b * n + c,  1 <= n <= U.

Method (structure-aware canonical factorization tree)
------------------------------------------------------
Every n <= U has a unique prime factorization n = p_1^e_1 ... p_k^e_k with
p_1 < ... < p_k.  We DFS over that canonical tree, carrying the partial product
n0 and the partial divisor sum s0 = sigma(n0) (sigma is multiplicative and
coprime factors multiply).  A node is a candidate solution iff the exact
terminal equation  a*s0 == b*n0 + c  holds (the final authority).

Three pruning layers (all necessary conditions, exact integer arithmetic):

  1. Divisibility:  a*sigma(n) = b*n + c  =>  n | (a*sigma(n) - c)
     =>  gcd(n0, a*s0) | c  for every prefix of a solution.
  2. Ratio window on the remaining factor m (gcd(m, n0) = 1, primes of m >=
     next prime):  sigma(m)/m = R0 + c/(a*s0*m),  R0 = b*n0/(a*s0).
     Using  sigma(m)/m >= 1  and  sigma(m)/m >= 1 + 1/m  (m >= 2)  yields
     exact integer bounds mmin/mmax on m; an empty window prunes the branch.
  3. Mod-2 type constraint:  sigma(m) is odd  <=>  m = 2^k * s^2 (s odd).
     The equation mod 2,  A*sigma(m) == B*m + C (A = a*s0, B = b*n0, C = c),
     restricts the (parity, squareform) type of the remaining m to a small
     allowed set; infeasible types prune, and the forced types implement
     special-descendant shortcuts (force/forbid the prime 2, force even
     exponents on odd primes, or a "must break squareform" obligation that
     is carried in the search state).

Degenerate cases: a == 0 (linear equation in n) and b == 0 (fixed sigma,
handled by the same tree) are exact.  a < 0 (not observed in the data) uses a
defensive direct scan.

Self-contained; no third-party dependencies.
"""

from math import gcd

# --------------------------------------------------------------------------
# Prime list (lazy, cached, extendable)
# --------------------------------------------------------------------------

_PRIME_CACHE = []      # primes up to _PRIME_LIMIT
_PRIME_LIMIT = 1


def _primes_upto(n):
    """Sieve primes <= n (bytearray sieve)."""
    if n < 2:
        return []
    bs = bytearray(b"\x01") * (n + 1)
    bs[0:2] = b"\x00\x00"
    for i in range(2, int(n ** 0.5) + 1):
        if bs[i]:
            bs[i * i::i] = b"\x00" * len(bs[i * i::i])
    return [i for i in range(n + 1) if bs[i]]


def _ensure_primes(n):
    """Make sure the global cache contains all primes <= n."""
    global _PRIME_CACHE, _PRIME_LIMIT
    if n <= _PRIME_LIMIT:
        return
    if n <= 2_000_003:
        _PRIME_CACHE = _primes_upto(n)
        _PRIME_LIMIT = n
    else:
        # rare path: rebuild up to n (keeps the common case fast)
        _PRIME_CACHE = _primes_upto(n)
        _PRIME_LIMIT = n


# --------------------------------------------------------------------------
# Mod-2 allowed-type table
# type of remaining m: (o, q) with o = m & 1 (1 = odd), q = 1 iff m is
# "squareform" (m = 2^k * s^2, s odd); sigma(m) odd iff q == 1.
# S2[(A, B, C)] = {(o, q) : (A*q) mod 2 == (B*o + C) mod 2}
# --------------------------------------------------------------------------

_S2 = {
    (A, B, C): {(o, q) for o in (0, 1) for q in (0, 1)
                if (A * q) % 2 == (B * o + C) % 2}
    for A in (0, 1) for B in (0, 1) for C in (0, 1)
}

# lightweight stats (does not affect results)
_STATS = {"nodes": 0}


# --------------------------------------------------------------------------
# Core tree search (requires a > 0)
# --------------------------------------------------------------------------

def _solve_tree(a, b, c, U):
    """All n in [1, U] with a*sigma(n) = b*n + c, a > 0.  Returns sorted list."""
    _ensure_primes(U)
    P = _PRIME_CACHE
    npr = 0
    # binary search: number of primes <= U
    lo, hi = 0, len(P)
    while lo < hi:
        mid = (lo + hi) // 2
        if P[mid] <= U:
            lo = mid + 1
        else:
            hi = mid
    npr = lo

    sols = []
    nodes = _STATS

    def dfs(n0, s0, pi, must_break):
        nodes["nodes"] += 1
        # terminal: remaining m = 1 (squareform; invalid if must_break)
        if a * s0 == b * n0 + c and not must_break:
            sols.append(n0)
        # layer 1: divisibility  gcd(n0, a*s0) | c
        if c % gcd(n0, a * s0) != 0:
            return
        # layer 3: mod-2 type constraint on the remaining m
        st = _S2[(a * s0 & 1, b * n0 & 1, c & 1)]
        if not st:
            return
        mmax = U // n0
        two_avail = (pi == 0)
        oset = (0, 1) if two_avail else (1,)
        qset = (0, 1) if mmax >= 3 else (1,)
        if must_break and 0 not in qset:
            return
        feas = [(o, q) for o in oset for q in qset if (o, q) in st]
        if must_break:
            feas = [(o, q) for (o, q) in feas if q == 0]
        if not feas:
            return
        forbid2 = (two_avail and 0 not in [o for (o, q) in feas])
        force_even = all(q == 1 for (o, q) in feas)
        # layer 2: ratio window on remaining m
        #   sigma(m)/m = R0 + c/(a*s0*m),  R0 = b*n0/(a*s0)
        #   C1: sigma(m)/m >= 1              <=>  m*d1 + c >= 0
        #   C2: sigma(m)/m >= 1 + 1/m (m>=2) <=>  m*d1 >= K
        #   with d1 = b*n0 - a*s0,  K = a*s0 - c
        d1 = b * n0 - a * s0
        K = a * s0 - c
        mmin = 1
        if d1 > 0:
            if c < 0:
                mmin = max(mmin, (-c + d1 - 1) // d1)      # ceil(-c/d1)
            if K > 0:
                mmin = max(mmin, (K + d1 - 1) // d1)       # ceil(K/d1)
        elif d1 < 0:
            if c <= 0:
                return                                     # m <= c/(-d1) <= 0
            mmax = min(mmax, c // (-d1))                   # floor(c/(-d1))
            if K > 0:
                mmax = min(mmax, K // (-d1))               # floor(K/(-d1))
        else:  # d1 == 0
            if K > 0 or c < 0:
                return
        if mmin > mmax:
            return
        # extend with prime powers (canonical increasing order)
        for i in range(pi, npr):
            p = P[i]
            if n0 * p > U:
                break
            if p == 2 and forbid2:
                continue
            pe = p
            se = 1 + p
            e = 1
            while n0 * pe <= U:
                nmb = must_break
                if p != 2 and e % 2 == 1:
                    nmb = False
                if not (p != 2 and e % 2 == 1 and force_even):
                    dfs(n0 * pe, s0 * se, i + 1, nmb)
                pe *= p
                se = se + pe
                e += 1

    dfs(1, 1, 0, False)
    return sorted(sols)


# --------------------------------------------------------------------------
# Defensive direct scan (for unobserved a < 0)
# --------------------------------------------------------------------------

def _sigma_trial(n):
    """sigma(n) by trial division using the cached prime list."""
    _ensure_primes(int(n ** 0.5) + 1)
    s = 1
    m = n
    for p in _PRIME_CACHE:
        if p * p > m:
            break
        if m % p == 0:
            term = 1
            pw = 1
            while m % p == 0:
                m //= p
                pw *= p
                term += pw
            s *= term
    if m > 1:
        s *= (1 + m)
    return s


def _solve_direct(a, b, c, U):
    sols = []
    for n in range(1, U + 1):
        if a * _sigma_trial(n) == b * n + c:
            sols.append(n)
    return sols


# --------------------------------------------------------------------------
# Public API
# --------------------------------------------------------------------------

def solve(a: int, b: int, c: int, U: int) -> list[int]:
    """Return all n with 1 <= n <= U satisfying  a*sigma(n) = b*n + c, sorted."""
    a = int(a)
    b = int(b)
    c = int(c)
    U = int(U)
    if U < 1:
        return []
    if a == 0:
        # 0 = b*n + c
        if b == 0:
            return list(range(1, U + 1)) if c == 0 else []
        if (-c) % b == 0:
            n = -c // b
            if 1 <= n <= U:
                return [n]
        return []
    if a > 0:
        return _solve_tree(a, b, c, U)
    # a < 0: not observed in the data; defensive exact scan
    return _solve_direct(a, b, c, U)


# --------------------------------------------------------------------------
# Batch driver: reads data/problem_instances.json, writes results/*.csv
# --------------------------------------------------------------------------

def _main():
    import json
    import os

    with open("data/problem_instances.json", "r") as fh:
        data = json.load(fh)
    instances = data["instances"]

    os.makedirs("results", exist_ok=True)

    sol_rows = []
    sum_rows = []
    for inst in instances:
        iid = inst["instance_id"]
        sols = solve(inst["a"], inst["b"], inst["c"], inst["U"])
        for n in sols:
            sol_rows.append((iid, n))
        sum_rows.append((iid, len(sols), sols[-1] if sols else 0))

    sol_rows.sort(key=lambda t: (t[0], t[1]))
    sum_rows.sort(key=lambda t: t[0])

    with open("results/solutions.csv", "w") as fh:
        fh.write("instance_id,n\n")
        for iid, n in sol_rows:
            fh.write(f"{iid},{n}\n")
    with open("results/instance_summary.csv", "w") as fh:
        fh.write("instance_id,solution_count,largest_solution\n")
        for iid, cnt, lg in sum_rows:
            fh.write(f"{iid},{cnt},{lg}\n")

    print(f"wrote results/solutions.csv ({len(sol_rows)} rows) and "
          f"results/instance_summary.csv ({len(sum_rows)} rows)")


if __name__ == "__main__":
    _main()
