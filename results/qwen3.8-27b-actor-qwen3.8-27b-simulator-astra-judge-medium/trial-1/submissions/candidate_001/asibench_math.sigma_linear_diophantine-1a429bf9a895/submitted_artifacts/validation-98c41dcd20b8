import json, time
import analysis

def sigma_sieve(N):
    sigma = [0]*(N+1)
    for d in range(1, N+1):
        for m in range(d, N+1, d):
            sigma[m] += d
    return sigma

def ref_solve(a, b, c, U):
    if a == 0:
        if b == 0:
            return list(range(1, U+1)) if c == 0 else []
        if (-c) % b == 0:
            n = -c//b
            if 1 <= n <= U:
                return [n]
        return []
    s = sigma_sieve(U)
    return [n for n in range(1, U+1) if a*s[n] == b*n + c]

d = json.load(open('data/problem_instances.json'))
print(f"{'instance':16s} {'a':>2s} {'b':>2s} {'c':>5s} {'U':>9s} {'nodes':>9s} {'wall':>7s}  status")
total_wall = 0.0
allok = True
t_all = time.time()
for i in d['instances']:
    a,b,c,U = i['a'],i['b'],i['c'],i['U']
    analysis._STATS['nodes'] = 0
    t = time.time()
    got = analysis.solve(a,b,c,U)
    wall = time.time()-t
    total_wall += wall
    ref = ref_solve(a,b,c,U)
    ok = got == ref
    allok = allok and ok
    print(f"{i['instance_id']:16s} {a:>2d} {b:>2d} {c:>5d} {U:>9d} {analysis._STATS['nodes']:>9d} {wall:>6.2f}s  {'OK' if ok else 'MISMATCH: ref='+str(ref[:8])}")
print(f"all-14 wall total: {total_wall:.2f}s (incl. sieve refs) ; tree-only total: {time.time()-t_all - 0:.2f}s")
print("ALL 14 MATCH INDEPENDENT SIEVE" if allok else "FAILURES PRESENT")
