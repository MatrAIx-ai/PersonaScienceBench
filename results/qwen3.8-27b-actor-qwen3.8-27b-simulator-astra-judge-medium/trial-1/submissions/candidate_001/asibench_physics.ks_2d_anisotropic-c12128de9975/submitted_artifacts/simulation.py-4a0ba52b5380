def _text_w(s, scale):
    return len(s) * 6 * scale - scale

def _draw_text(cv, x, y, s, color, scale=2):
    for ch in s.upper():
        g = FONT.get(ch, FONT[' ']).split()
        for r in range(7):
            for c in range(5):
                if g[r][c] == '1':
                    cv[y + r * scale: y + (r + 1) * scale,
                       x + c * scale: x + (c + 1) * scale] = color
        x += 6 * scale

def _center_text(cv, cx, y, s, color, scale=2):
    _draw_text(cv, int(cx - _text_w(s, scale) / 2), y, s, color, scale)

def _upscale(field, h, w):
    idx_y = np.clip((np.arange(h) + 0.5) * field.shape[0] / h, 0, field.shape[0] - 1).astype(int)
    idx_x = np.clip((np.arange(w) + 0.5) * field.shape[1] / w, 0, field.shape[1] - 1).astype(int)
    return field[idx_y][:, idx_x]

def _frame(cv, x, y, w, h, color=(0, 0, 0)):
    cv[y:y+2, x:x+w] = color; cv[y+h-2:y+h, x:x+w] = color
    cv[y:y+h, x:x+2] = color; cv[y:y+h, x+w-2:x+w] = color

def _line(cv, x0, y0, x1, y1, color, th=2):
    n = max(int(abs(x1 - x0) + abs(y1 - y0)), 1)
    for i in range(n + 1):
        xx = int(round(x0 + (x1 - x0) * i / n)); yy = int(round(y0 + (y1 - y0) * i / n))
        cv[max(yy - th//2, 0):yy + th//2 + 1, max(xx - th//2, 0):xx + th//2 + 1] = color

def _plot_data(cv, x, y, w, h, xs, ys, xlo, xhi, ylo, yhi, color, logx=False, logy=False):
    xt = np.log10(xs) if logx else xs
    yt = np.log10(np.maximum(ys, 1e-300)) if logy else ys
    px = x + (xt - xlo) / (xhi - xlo) * w
    py = y + h - (yt - ylo) / (yhi - ylo) * h
    for i in range(len(px) - 1):
        _line(cv, px[i], py[i], px[i + 1], py[i + 1], color)

def _write_png(path, rgb):
    import zlib, struct
    h, w, _ = rgb.shape
    def chunk(tag, data):
        return (struct.pack(">I", len(data)) + tag + data +
                struct.pack(">I", zlib.crc32(tag + data) & 0xffffffff))
    raw = b"".join(b"\x00" + rgb[y].tobytes() for y in range(h))
    png = b"\x89PNG\r\n\x1a\n"
    png += chunk(b"IHDR", struct.pack(">IIBBBBB", w, h, 8, 2, 0, 0, 0))
    png += chunk(b"IDAT", zlib.compress(raw, 9))
    png += chunk(b"IEND", b"")
    with open(path, "wb") as fh:
        fh.write(png)

def _spectrum_image(P):
    t = np.clip((np.log10(P / P.max() + 1e-30) + 30.0) / 30.0, 0, 1)
    return _upscale(t, 340, 340)

def _ticks(lo, hi, n=5):
    return np.linspace(lo, hi, n)

def _fmt(v):
    a = abs(v)
    if a >= 100: return f"{v:.0f}"
    if a >= 10: return f"{v:.1f}"
    if a >= 1: return f"{v:.2f}"
    if a == 0: return "0"
    return f"{v:.3g}"

def _axes(cv, x, y, w, h, xlo, xhi, ylo, yhi, xlab, ylab,
          xticks=None, yticks=None, logy=False):
    _frame(cv, x, y, w, h)
    if xticks is None: xticks = _ticks(xlo, xhi, 5)
    if yticks is None: yticks = _ticks(ylo, yhi, 4)
    for tv in xticks:
        px = x + (tv - xlo) / (xhi - xlo) * w
        _line(cv, px, y + h, px, y + h + 8, (0, 0, 0))
        s = _fmt(tv)
        _draw_text(cv, int(px - _text_w(s, 1) / 2), y + h + 12, s, (0, 0, 0), 1)
    for tv in yticks:
        py = y + h - (tv - ylo) / (yhi - ylo) * h
        _line(cv, x - 8, py, x, py, (0, 0, 0))
        s = _fmt(tv)
        _draw_text(cv, x - 12 - _text_w(s, 1), int(py - 4), s, (0, 0, 0), 1)
    _center_text(cv, x + w / 2, y + h + 40, xlab, (0, 0, 0), 2)
    _draw_text(cv, x - 12 - _text_w(ylab, 2), int(y + h / 2 - 7 * 2 / 2), ylab, (0, 0, 0), 2)

