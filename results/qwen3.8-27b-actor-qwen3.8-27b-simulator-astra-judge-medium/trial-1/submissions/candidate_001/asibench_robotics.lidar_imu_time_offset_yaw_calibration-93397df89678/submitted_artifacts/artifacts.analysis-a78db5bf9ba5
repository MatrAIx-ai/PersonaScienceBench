#!/usr/bin/env python3
"""
Multi-Sensor Motion Record Audit
================================
Calibrates three parameters relating a high-rate gyro z-axis stream to a
lower-rate LiDAR scan-matching relative-motion sequence:

  * gyro_bias_rad_s   : constant additive bias in the gyro reading
  * time_offset_s     : clock offset between gyro timestamps and LiDAR/true
                        time.  Convention: POSITIVE = the gyro clock reads
                        AHEAD of LiDAR time, i.e.
                        omega_g(t_g) = theta_dot(t_g - tau) + b + noise
  * yaw_extrinsic_rad : yaw extrinsic between body and LiDAR frame under the
                        body->LiDAR R_z(e) convention (the LiDAR frame is the
                        body frame rotated by +e about the z axis).

Physical model (planar robot run):
  LiDAR scan i over [t0, t1] (relative transform in the LiDAR-odometry frame):
      dyaw_i    = theta(t1) - theta(t0) + N(0, sigma_yaw^2)
      (dx,dy)_i = v(t) * (cos e, sin e) * (t1 - t0) + N(0, sigma_trans^2 I)
  where the LiDAR-frame motion direction is constant (the robot translates in
  a fixed LiDAR-frame direction while its body yaw rotates independently) and
  v(t) is a free smooth speed signal.
  Gyro:
      omega_g(t_g) = theta_dot(t_g - tau) + b + N(0, sigma_gyro^2)

Fitting uses only rows with split == 'train'; heldout rows are used only for
diagnostics.  Outputs: calibration.csv, observability.csv, residuals.csv,
calibration_diagnostics.png, metrics.json (workspace root).
"""
import json

import numpy as np
import pandas as pd
from scipy.interpolate import CubicSpline
