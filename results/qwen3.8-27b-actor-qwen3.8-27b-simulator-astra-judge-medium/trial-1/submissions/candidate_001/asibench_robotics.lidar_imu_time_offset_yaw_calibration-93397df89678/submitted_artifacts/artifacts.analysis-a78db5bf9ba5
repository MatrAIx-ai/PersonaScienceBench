class MiniPNG:
    """Tiny RGB canvas with line/dot/text drawing and PNG output."""

    def __init__(self, w, h, bg=(255, 255, 255)):
        self.w, self.h = w, h
        self.buf = bytearray()
        self.buf += bytes(bg) * (w * h)

    def px(self, x, y, c):
        x, y = int(x), int(y)
        if 0 <= x < self.w and 0 <= y < self.h:
            i = (y * self.w + x) * 3
            self.buf[i:i + 3] = bytes(c)

    def line(self, x0, y0, x1, y1, c, width=1):
        x0, y0, x1, y1 = int(x0), int(y0), int(x1), int(y1)
        dx, dy = abs(x1 - x0), -abs(y1 - y0)
        sx = 1 if x0 < x1 else -1
        sy = 1 if y0 < y1 else -1
        err = dx + dy
        while True:
            for ox in range(width):
                for oy in range(width):
                    self.px(x0 + ox, y0 + oy, c)
            if x0 == x1 and y0 == y1:
                break
            e2 = 2 * err
            if e2 >= dy:
                err += dy
                x0 += sx
            if e2 <= dx:
                err += dx
                y0 += sy

    def hline(self, x0, x1, y, c, width=1):
        self.line(x0, y, x1, y, c, width)

    def vline(self, x, y0, y1, c, width=1):
        self.line(x, y0, x, y1, c, width)

    def text(self, x, y, s, c, scale=1):
        for ch in s:
            g = FONT.get(ch, FONT.get(ch.lower(), []))
            for (ax, ay, bx, by) in g:
                self.line(x + ax * scale, y + ay * scale,
                          x + bx * scale, y + by * scale, c, scale)
            x += 6 * scale

    def save(self, path):
        import struct
        import zlib
        raw = bytearray()
        for y in range(self.h):
            raw.append(0)
            raw += self.buf[y * self.w * 3:(y + 1) * self.w * 3]

        def chunk(tag, data):
            out = struct.pack(">I", len(data)) + tag + data
            out += struct.pack(">I", zlib.crc32(tag + data) & 0xFFFFFFFF)
            return out

        ihdr = struct.pack(">IIBBBBB", self.w, self.h, 8, 2, 0, 0, 0)
        png = (b"\x89PNG\r\n\x1a\n" + chunk(b"IHDR", ihdr)
               + chunk(b"IDAT", zlib.compress(bytes(raw), 6)) + chunk(b"IEND", b""))
        with open(path, "wb") as fh:
            fh.write(png)


def _tick_fmt(v, rng):
    if rng >= 10:
        return f"{v:.0f}"
    if rng >= 1:
        return f"{v:.1f}"
    if rng >= 0.1:
        return f"{v:.2f}"
    return f"{v:.3f}"


def draw_panel(img, X, Y, W, H, p):
    ml, mr, mt, mb = 62, 14, 36, 40
    ax, ay = X + ml, Y + mt
    aw, ah = W - ml - mr, H - mt - mb
    img.line(ax, ay, ax + aw, ay, (0, 0, 0), 1)
    img.line(ax, ay, ax, ay + ah, (0, 0, 0), 1)
    img.line(ax, ay + ah, ax + aw, ay + ah, (0, 0, 0), 1)
    img.line(ax + aw, ay, ax + aw, ay + ah, (0, 0, 0), 1)
    img.text(X + 4, Y + 8, p["title"], (0, 0, 0), 2)

    ys = [s[2] for s in p["series"] if s[0] in ("line", "dot")]
    xlim = p["xlim"]
    if p["ylim"] is None:
        ymin = min(float(np.min(y)) for y in ys)
        ymax = float(max(float(np.max(y)) for y in ys))
        pad = 0.08 * (ymax - ymin) if ymax > ymin else 1.0
        ylim = (ymin - pad, ymax + pad)
    else:
        ylim = p["ylim"]
    xr = xlim[1] - xlim[0]
    yr = ylim[1] - ylim[0]

    def Xpx(x):
        return ax + (x - xlim[0]) / xr * aw

    def Ypx(y):
        return ay + ah - (y - ylim[0]) / yr * ah

    for xv in np.linspace(xlim[0], xlim[1], 5):
        xp = Xpx(xv)
        img.line(xp, ay + ah, xp, ay + ah + 4, (0, 0, 0), 1)
        lab = _tick_fmt(xv, xr)
        img.text(int(xp) - 3 * len(lab), ay + ah + 7, lab, (0, 0, 0), 1)
    for yv in np.linspace(ylim[0], ylim[1], 5):
        yp = Ypx(yv)
        img.line(ax - 4, yp, ax, yp, (0, 0, 0), 1)
        lab = _tick_fmt(yv, yr)
        img.text(ax - 8 - 6 * len(lab), int(yp) - 4, lab, (0, 0, 0), 1)
    img.text(ax + aw // 2 - 3 * len(p["xlab"]), Y + H - 12, p["xlab"], (0, 0, 0), 1)
    img.text(X + 2, ay + ah // 2 - 3 * len(p["ylab"]), p["ylab"], (0, 0, 0), 1)
    if p.get("note"):
        img.text(ax + aw - 6 * len(p["note"]) - 8, ay + 6, p["note"], (100, 100, 100), 1)

    for s in p["series"]:
        kind = s[0]
        if kind in ("line", "dot"):
            _, xs_, ys_, col, lw = s
            if kind == "line":
                pxs = np.array([Xpx(x) for x in xs_])
                pys = np.array([Ypx(y) for y in ys_])
                for i in range(len(pxs) - 1):
                    img.line(pxs[i], pys[i], pxs[i + 1], pys[i + 1], col, lw)
            else:
                for x_, y_ in zip(xs_, ys_):
                    xp, yp = int(Xpx(x_)), int(Ypx(y_))
                    for ox in (0, 1):
                        for oy in (0, 1):
                            img.px(xp + ox, yp + oy, col)
        elif kind == "hline":
            _, val, col, lw = s
            img.line(ax, Ypx(val), ax + aw, Ypx(val), col, lw)
        elif kind == "vline":
            _, val, col, lw = s
            img.line(Xpx(val), ay, Xpx(val), ay + ah, col, lw)


def main():
    # ------------------------------------------------------------------ load
    imu = pd.read_csv(f"{DATA}/imu_gyro.csv")
    lid = pd.read_csv(f"{DATA}/lidar_scan_matches.csv")
    seg = pd.read_csv(f"{DATA}/segment_windows.csv")
    with open(f"{DATA}/task_info.json") as fh:
        info = json.load(fh)

    it = imu["imu_time_s"].to_numpy(dtype=float)
    iw = imu["omega_z_rad_s"].to_numpy(dtype=float)
    scan_id = lid["scan_id"].to_numpy()
    t0 = lid["t0_lidar_s"].to_numpy(dtype=float)
    t1 = lid["t1_lidar_s"].to_numpy(dtype=float)
    dyaw = lid["dyaw_lidar_rad"].to_numpy(dtype=float)
    dx = lid["dx_lidar_m"].to_numpy(dtype=float)
    dy = lid["dy_lidar_m"].to_numpy(dtype=float)
    sigma_trans = float(np.unique(lid["sigma_trans_m"])[0])
    sigma_yaw = float(np.unique(lid["sigma_yaw_rad"])[0])
    dur = t1 - t0
    mid = 0.5 * (t0 + t1)
    tr = (lid["split"] == "train").to_numpy()
    ho = (lid["split"] == "heldout").to_numpy()
    idx_tr = np.where(tr)[0]
    idx_ho = np.where(ho)[0]
    dt_imu = it[1] - it[0]

    # Piecewise-linear gyro integral F(t) = int_{it[0]}^{t} omega dt
    P = np.concatenate([[0.0], np.cumsum(0.5 * (iw[1:] + iw[:-1]) * (it[1:] - it[:-1]))])

    def F(t):
        t = np.asarray(t, dtype=float)
        k = np.clip(np.searchsorted(it, t, "right") - 1, 0, len(it) - 2)
        a, b = it[k], it[k + 1]
        wt = iw[k] + (iw[k + 1] - iw[k]) * (t - a) / (b - a)
        return P[k] + 0.5 * (iw[k] + wt) * (t - a)

    def integrals(tau, idx):
        """Gyro yaw integral over each scan interval, shifted by tau."""
        return F(t1[idx] - tau) - F(t0[idx] - tau)

    # ------------------------------------------------- fit (b, tau) on train
    # Per-scan WLS objective with bias profiled out:
    #   r_i(tau) = I_i(tau) - b(tau)*dur_i - dyaw_i
    #   I(tau)   = sum_i r_i(tau)^2
    taus_grid = np.arange(-0.05, 0.05 + 1e-9, 0.001)
    prof = np.empty(len(taus_grid))
    for j, tau in enumerate(taus_grid):
        I = integrals(tau, idx_tr)
        b = np.mean((I - dyaw[idx_tr]) / dur[idx_tr])
        r = I - b * dur[idx_tr] - dyaw[idx_tr]
        prof[j] = np.sum(r * r)
    i0 = int(np.argmin(prof))

    # fine local grid + parabolic refinement of the raw profile minimum
    fine = taus_grid[i0] + np.arange(-0.002, 0.002 + 1e-9, 2e-5)
    pf_fine = np.empty(len(fine))
    for j, tau in enumerate(fine):
        I = integrals(tau, idx_tr)
        b = np.mean((I - dyaw[idx_tr]) / dur[idx_tr])
        r = I - b * dur[idx_tr] - dyaw[idx_tr]
        pf_fine[j] = np.sum(r * r)
    j0 = int(np.argmin(pf_fine))
    y0, y1, y2 = pf_fine[j0 - 1], pf_fine[j0], pf_fine[j0 + 1]
    dpar = 0.5 * (y0 - y2) / (y0 - 2.0 * y1 + y2)
    tau_naive = float(fine[j0] + dpar * (fine[1] - fine[0]))

    # unbiased estimator: one Gauss-Newton step from tau=0 (equivalent to the
    # Fisher/quadratic approximation of the profile)
    I0 = integrals(0.0, idx_tr)
    s0 = np.interp(t0[idx_tr], it, iw) - np.interp(t1[idx_tr], it, iw)  # dI/dtau at 0
    A = np.column_stack([dur[idx_tr], -s0])
    r0 = I0 - dyaw[idx_tr]
    coef, *_ = np.linalg.lstsq(A, r0, rcond=None)
    tau_ols = float(coef[1])

    # quadratic (Fisher) fit of the profile, cross-check
    c2, c1, c0 = np.polyfit(taus_grid, prof, 2)
    tau_quad = float(-c1 / (2.0 * c2)) if c2 > 0 else tau_naive

    # primary estimate: the unbiased OLS/quadratic value
    tau_hat = tau_ols

    # final bias at tau_hat (profiled mean)
    I = integrals(tau_hat, idx_tr)
    b_hat = float(np.mean((I - dyaw[idx_tr]) / dur[idx_tr]))
    r_tr = I - b_hat * dur[idx_tr] - dyaw[idx_tr]
    sig_hat = float(np.std(r_tr))
    std_b = float(sig_hat / np.sqrt(np.sum(dur[idx_tr] ** 2)))

    # CRLB for tau and profile 1-sigma (dI = 1, 1 dof after profiling b)
    s_at = np.interp(t0[idx_tr] - tau_hat, it, iw) - np.interp(t1[idx_tr] - tau_hat, it, iw)
    I_tau = float(np.sum(s_at ** 2) / sig_hat ** 2)
    std_tau_crlb = float(1.0 / np.sqrt(I_tau))
    dI = prof - prof.min()
    tau_lo = tau_hi = None
    if (dI > 1.0).any():
        lo_m = dI[: i0 + 1][::-1] > 1.0
        hi_m = dI[i0:] > 1.0
        if lo_m.any():
            tau_lo = float(taus_grid[i0 - int(np.argmax(lo_m))])
        if hi_m.any():
            tau_hi = float(taus_grid[i0 + int(np.argmax(hi_m))])

    # ------------------------------------------------- yaw extrinsic (train)
    bearing = np.arctan2(dy, dx)
    w = dx * dx + dy * dy
    e_hat = float(np.sum(w[tr] * bearing[tr]) / np.sum(w[tr]))
    std_e = float(sigma_trans / np.sqrt(np.sum(w[tr])))
    slope_b, intercept_b = np.polyfit(t0[tr], bearing[tr], 1, w=w[tr])

    # ------------------------------------------------- heldout diagnostics
    Iho = integrals(tau_hat, idx_ho)
    ryaw_ho = wrap_pi(Iho - b_hat * dur[idx_ho] - dyaw[idx_ho])

    # free smooth speed model: cubic spline through train per-scan speeds
    speed = np.hypot(dx, dy) / dur
    cs = CubicSpline(mid[tr], speed[tr], bc_type="natural")
    v_ho = cs(np.clip(mid[idx_ho], mid[tr].min(), mid[tr].max())) * dur[idx_ho]
    dxp = v_ho * np.cos(e_hat)
    dyp = v_ho * np.sin(e_hat)
    rtrans_ho = np.hypot(dx[idx_ho] - dxp, dy[idx_ho] - dyp)

    # ------------------------------------------------- observability per segment
    seg_t0 = seg["t0_lidar_s"].to_numpy(dtype=float)
    seg_t1 = seg["t1_lidar_s"].to_numpy(dtype=float)
    seg_of_scan = np.searchsorted(seg_t1, mid, "left")
    raw = np.empty(len(seg))
    for s in range(len(seg)):
        m = seg_of_scan == s
        I_b = float(np.sum(dur[m] ** 2) / sigma_yaw ** 2)
        s_i = np.interp(t0[m] - tau_hat, it, iw) - np.interp(t1[m] - tau_hat, it, iw)
        I_t = float(np.sum(s_i ** 2) / sigma_yaw ** 2)
        I_e = float(np.sum(w[m]) / sigma_trans ** 2)
        raw[s] = 0.25 * I_b + 0.40 * I_t + 0.35 * I_e
    obs_score = raw / raw.max()

    # ------------------------------------------------- write outputs
    pd.DataFrame(
        {
            "gyro_bias_rad_s": [b_hat],
            "time_offset_s": [tau_hat],
            "yaw_extrinsic_rad": [e_hat],
        }
    ).to_csv("calibration.csv", index=False)

    pd.DataFrame(
        {
            "segment_id": seg["segment_id"].astype(int),
            "observability_score": obs_score,
        }
    ).to_csv("observability.csv", index=False)

    pd.DataFrame(
        {
            "scan_id": scan_id[idx_ho].astype(int),
            "residual_yaw_rad": ryaw_ho,
            "residual_trans_m": rtrans_ho,
        }
    ).to_csv("residuals.csv", index=False)

    # ------------------------------------------------- diagnostics figure
    # LiDAR-derived yaw rate (smoothed cumulative dyaw)
    cum = np.concatenate([[0.0], np.cumsum(dyaw)])
    T = np.concatenate([[0.0], t1])
    Lg = np.interp(it, T, cum)
    wlen = int(2.0 / dt_imu) | 1
    Lrate = np.gradient(savgol_filter(Lg, wlen, 3), it)

    if HAVE_MPL:
        fig, axes = plt.subplots(3, 2, figsize=(13, 11))
        fig.suptitle("LiDAR-IMU calibration diagnostics (fit on train; heldout for diagnostics only)",
                     fontsize=12)

        ax = axes[0, 0]
        ax.plot(it, iw - b_hat, color="tab:blue", lw=0.4, alpha=0.45,
                label="gyro rate - fitted bias")
        ax.plot(it, Lrate, color="tab:red", lw=1.4, label="LiDAR-derived yaw rate (smoothed)")
        ax.set_xlabel("time (s)")
        ax.set_ylabel("rad/s")
        ax.set_title(f"Gyro vs LiDAR yaw rate  (tau_hat = {tau_hat*1e3:+.2f} ms)")
        ax.legend(fontsize=8)

        ax = axes[0, 1]
        ax.plot(mid[tr], r_tr, ".", ms=3, color="tab:blue", alpha=0.6, label="train")
        ax.plot(mid[idx_ho], ryaw_ho, ".", ms=4, color="tab:red", alpha=0.8, label="heldout")
        ax.axhline(0.0, color="k", lw=0.7)
        ax.set_xlabel("scan mid time (s)")
        ax.set_ylabel("yaw residual (rad)")
        ax.set_title(f"Per-scan yaw residual  (train std {sig_hat:.5f}, heldout std {np.std(ryaw_ho):.5f})")
        ax.legend(fontsize=8)

        ax = axes[1, 0]
        ax.plot(taus_grid * 1e3, prof - prof.min(), color="tab:blue", lw=1.0)
        ax.axvline(tau_naive * 1e3, color="tab:red", ls="--", lw=1.0,
                   label=f"raw profile min {tau_naive*1e3:+.2f} ms")
        ax.axvline(tau_hat * 1e3, color="tab:green", ls=":", lw=1.5,
                   label=f"reported (OLS/quadratic) {tau_hat*1e3:+.2f} ms")
        ax.set_xlabel("time offset tau (ms)")
        ax.set_ylabel("WLS objective - min")
        ax.set_title(f"Tau profile (flat: CRLB ~{std_tau_crlb*1e3:.1f} ms, 1-sigma not bounded in +/-50 ms)")
