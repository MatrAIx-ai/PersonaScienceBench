except Exception:  # pragma: no cover - environment without matplotlib
    HAVE_MPL = False

DATA = "data"
TWO_PI = 2.0 * np.pi


def wrap_pi(x):
    """Wrap angle(s) to [-pi, pi)."""
    return (np.asarray(x, dtype=float) + np.pi) % TWO_PI - np.pi


