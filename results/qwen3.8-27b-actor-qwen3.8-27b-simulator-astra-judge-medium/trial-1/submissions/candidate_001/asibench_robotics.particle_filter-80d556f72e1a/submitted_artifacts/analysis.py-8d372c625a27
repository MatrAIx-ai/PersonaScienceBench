def _build_font():
    font = {}
    lines = FONT_RAW.strip("\n").split("\n")
    i = 0
    while i < len(lines):
        line = lines[i]
        if "|" in line:
            ch = line.replace("|", "").strip()
            rows = lines[i + 1:i + 8]
            assert len(rows) == 7 and all(len(r) == 5 for r in rows), (ch, rows)
            font[ch] = tuple(int(r.replace("#", "1").replace(".", "0"), 2) for r in rows)
            i += 8
        else:
            i += 1
    return font

_FONT = _build_font()

def _draw_text(img, x, y, s, color=(0, 0, 0)):
    cx = x
    for ch in s:
        g = _FONT.get(ch, _FONT.get(ch.lower(), _FONT["?"]))
        for r in range(7):
            bits = g[r]
            for c in range(5):
                if (bits >> (4 - c)) & 1:
                    yy, xx = y + r, cx + c
                    if 0 <= yy < img.shape[0] and 0 <= xx < img.shape[1]:
                        img[yy, xx] = color
        cx += 6

class _Panel:
    def __init__(self, img, x0, y0, w, h, title):
        self.img, self.x0, self.y0, self.w, self.h = img, x0, y0, w, h
        img[y0:y0 + h, x0:x0 + w] = (255, 255, 255)
        for c in (x0, x0 + w - 1):
            img[y0:y0 + h, c] = (0, 0, 0)
        for r in (y0, y0 + h - 1):
            img[r, x0:x0 + w] = (0, 0, 0)
        _draw_text(img, x0 + max(0, (w - len(title) * 6) // 2), y0 - 14, title)

    def px(self, v, vmin, vmax):
        return self.x0 + 1 + (v - vmin) / (vmax - vmin) * (self.w - 3)

    def py(self, v, vmin, vmax):
        return self.y0 + self.h - 1 - (v - vmin) / (vmax - vmin) * (self.h - 3)

    def line(self, xs, ys, color, xmin, xmax, ymin, ymax):
        for i in range(len(xs) - 1):
            seg = _clip_seg(self.px(xs[i], xmin, xmax), self.py(ys[i], ymin, ymax),
                            self.px(xs[i + 1], xmin, xmax), self.py(ys[i + 1], ymin, ymax),
                            self.x0 + 1, self.y0 + 1,
                            self.x0 + self.w - 2, self.y0 + self.h - 2)
            if seg is not None:
                _bres(self.img, *seg[:2], *seg[2:], color)

    def points(self, xs, ys, color, size=3, xmin=None, xmax=None, ymin=None, ymax=None):
        for x, y in zip(xs, ys):
            if xmin is not None and not (xmin <= x <= xmax):
                continue
            if ymin is not None and not (ymin <= y <= ymax):
                continue
            cx, cy = int(self.px(x, xmin, xmax)), int(self.py(y, ymin, ymax))
            for dy in range(-size // 2, size - size // 2):
                for dx in range(-size // 2, size - size // 2):
                    xx, yy = cx + dx, cy + dy
                    if self.x0 < xx < self.x0 + self.w - 1 and self.y0 < yy < self.y0 + self.h - 1:
                        self.img[yy, xx] = color

    def vspan(self, x1, x2, color, xmin, xmax):
        c1 = int(self.px(x1, xmin, xmax)); c2 = int(self.px(x2, xmin, xmax))
        self.img[self.y0 + 1:self.y0 + self.h - 1, c1:c2 + 1] = color

    def vline(self, x, color, xmin, xmax):
        c = int(self.px(x, xmin, xmax))
        self.img[self.y0 + 1:self.y0 + self.h - 1, c] = color

    def legend(self, entries, x, y):
        for color, label in entries:
            _bres(self.img, x, y + 3, x + 18, y + 3, color)
            self.img[y + 1:y + 6, x + 7:x + 11] = color
            _draw_text(self.img, x + 24, y, label)
            y += 11

    def xticks(self, vals, xmin, xmax):
        for v in vals:
            c = int(self.px(v, xmin, xmax))
            self.img[self.y0 + self.h - 1:self.y0 + self.h + 3, c] = (0, 0, 0)
            s = str(int(round(v)))
            _draw_text(self.img, c - (len(s) * 6) // 2, self.y0 + self.h + 4, s)


def _overview_pure(t, est, r_est, th_est, Y, avail, gap0, gap1,
                   wrap_events, ess_arr, resampled_arr, br_mean, br_std,
                   outlier_flags):
    W, H = 1280, 880
    img = np.full((H, W, 3), 255, dtype=np.uint8)
    BLACK = (0, 0, 0); BLUE = (0, 100, 255); GRAY = (120, 120, 120)
    RED = (220, 30, 30); ORANGE = (255, 200, 120); GREEN = (60, 160, 60)
    supt = "Particle-filter tracking audit (N=1000, log weights, Huber-robust)"
    _draw_text(img, (W - len(supt) * 6) // 2, 8, supt)

    # --- panel 1: trajectory ---
    p = _Panel(img, 60, 60, 560, 330, "Estimated 2-D trajectory (origin = sensor)")
    both = avail[:, 0] & avail[:, 1]
    mx = Y[both, 0] * np.cos(Y[both, 1]); my = Y[both, 0] * np.sin(Y[both, 1])
    lo = min(float(est[:, 0].min()), float(est[:, 1].min()),
             float(mx.min()), float(my.min()), 0.0) - 0.5
    hi = max(float(est[:, 0].max()), float(est[:, 1].max()),
             float(mx.max()), float(my.max()), 0.0) + 0.5
    p.line(est[:, 0], est[:, 1], BLUE, lo, hi, lo, hi)
    p.points(mx, my, GRAY, 3, lo, hi, lo, hi)
    out_t = sorted(set(tt for tt, _ in outlier_flags))
    for tt in out_t:
        cx, cy = int(p.px(est[tt, 0], lo, hi)), int(p.py(est[tt, 1], lo, hi))
        for dy in range(-3, 3):
            for dx in range(-3, 3):
                img[cy + dy, cx + dx] = RED
    c0x, c0y = int(p.px(0, lo, hi)), int(p.py(0, lo, hi))
    _bres(img, c0x - 5, c0y, c0x + 5, c0y, BLACK)
    _bres(img, c0x, c0y - 5, c0x, c0y + 5, BLACK)
    p.legend([(BLUE, "PF trajectory"), (GRAY, "implied points"), (RED, "flagged t")],
             p.x0 + 8, p.y0 + 8)
    _draw_text(img, p.x0 + p.w - 24, p.y0 + p.h + 4, "px")
    _draw_text(img, p.x0 - 26, p.y0 + 2, "py")

    # --- panel 2: range track ---
    p = _Panel(img, 640, 60, 560, 330, "Channel 0: range-like track")
    tmin, tmax = float(t[0]), float(t[-1])
    rmin = float(min(Y[avail[:, 0], 0].min(), r_est.min())) * 0.9
    rmax = float(max(Y[avail[:, 0], 0].max(), r_est.max())) * 1.05
    for (a, b) in gap0:
        p.vspan(a - 0.5, b + 0.5, ORANGE, tmin, tmax)
    p.line(t, r_est, BLUE, tmin, tmax, rmin, rmax)
    p.points(t[avail[:, 0]], Y[avail[:, 0], 0], BLACK, 3, tmin, tmax, rmin, rmax)
    p.legend([(BLUE, "range est"), (BLACK, "range meas"), (ORANGE, "range gap")],
             p.x0 + 8, p.y0 + 8)
    p.xticks([0, 20, 40, 60, 80], tmin, tmax)

    # --- panel 3: bearing track ---
    p = _Panel(img, 60, 460, 560, 330, "Channel 1: bearing track (rad)")
    bmin, bmax = -3.35, 3.35
    for (a, b) in gap1:
        p.vspan(a - 0.5, b + 0.5, ORANGE, tmin, tmax)
    for wt in wrap_events:
        p.vline(wt - 0.5, RED, tmin, tmax)
    p.line(t, th_est, BLUE, tmin, tmax, bmin, bmax)
    p.points(t[avail[:, 1]], Y[avail[:, 1], 1], BLACK, 3, tmin, tmax, bmin, bmax)
    p.legend([(BLUE, "bearing est"), (BLACK, "bearing meas"),
              (ORANGE, "bearing gap"), (RED, "2pi wrap")], p.x0 + 8, p.y0 + 8)
    p.xticks([0, 20, 40, 60, 80], tmin, tmax)

    # --- panel 4: ESS / resampling / bearing residual ---
    p = _Panel(img, 640, 460, 560, 330, "Resampling behavior & bearing residual")
    nmax = float(N)
    r_half = int(p.py(N / 2, 0, nmax))
    img[r_half, p.x0 + 1:p.x0 + p.w - 1] = GRAY
    for tt in t[resampled_arr == 1]:
        p.vline(float(tt), RED, tmin, tmax)
    br_scale = 0.25 * nmax / max(0.2, float(np.abs(br_mean).max()))
    p.line(t, br_mean * br_scale, GREEN, tmin, tmax, 0, nmax)
    p.line(t, ess_arr, BLUE, tmin, tmax, 0, nmax)
    p.legend([(BLUE, "ESS"), (GRAY, "N/2 threshold"), (RED, "resampled"),
              (GREEN, "bearing resid (scaled)")], p.x0 + 8, p.y0 + 8)
    p.xticks([0, 20, 40, 60, 80], tmin, tmax)

    _save_png("results/overview.png", img)

